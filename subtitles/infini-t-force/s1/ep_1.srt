177
00:15:23,740 --> 00:15:26,000
!إنَّهم غيْر موجودِينَ، فكُفّ عَن السؤال

178
00:15:26,720 --> 00:15:28,100
...لا أَعلَم ما حَدَثَ، ولكنْ

179
00:15:28,260 --> 00:15:30,140
!أشكركَ أيُّها الهَرِمُ

180
00:15:32,160 --> 00:15:33,100
وَداعًا

181
00:15:37,820 --> 00:15:38,950
!أيُّها الهَرِمُ؟

182
00:15:40,610 --> 00:15:41,730
!لقَدْ قَصَدتكَ أنتَ

183
00:15:42,110 --> 00:15:42,940
مِن هنا

184
00:15:47,870 --> 00:15:50,790
أنتَ، أَعِدني إلى عالَمي

185
00:15:51,330 --> 00:15:53,290
نحن بِلا مكانٍ لنعود إليه

186
00:15:53,520 --> 00:15:54,260
ماذا؟

187
00:15:55,080 --> 00:15:56,780
،كما تَوقَّعتُ بالضَّبط

188
00:15:57,440 --> 00:16:00,310
ذات الشَّيء حَصَلَ مَعي مُنْذُ عامٍ

189
00:16:00,770 --> 00:16:01,960
!لا تُلقِ الدُّعابات

190
00:16:02,090 --> 00:16:04,740
!فرفاقي يَنتظرونَني، وفي رَقَبتي قومٌ لأحميهُم

191
00:16:04,760 --> 00:16:06,380
!لا فَرق بَيْنَنا

192
00:16:07,600 --> 00:16:08,690
نحن نَطلب مساعدتكَ

193
00:16:09,750 --> 00:16:10,730
ماذا يُمكنني أنْ أَفعَلَ؟

194
00:16:11,200 --> 00:16:12,010
...بادئ ذي بدء

195
00:16:12,490 --> 00:16:14,450
علينا تحديد مكان وُجودها

196
00:16:14,770 --> 00:16:16,800
اُترُك هذا الأمر لِيَّ

197
00:16:17,100 --> 00:16:19,020
ولماذا تلك الشّابة؟

198
00:16:19,770 --> 00:16:22,780
...لأنَّه قَدْ وَقَعَتْ بيْن يديها

199
00:16:24,100 --> 00:16:24,900
!القضيّة...

200
00:16:26,850 --> 00:16:28,750
...(زِ) أَيَا

201
00:16:28,870 --> 00:16:31,030
...حَتّامَ سأنتظر أكثَر مِن هذا لأجْل

202
00:16:31,330 --> 00:16:32,310
كما تَعرِف؟...

203
00:16:33,110 --> 00:16:34,930
!سأُفكِّر في ذلك

204
00:16:35,410 --> 00:16:38,120
أنتَ دائمًا تقول ذلك

205
00:16:38,930 --> 00:16:41,250
أُريدهم جميعًا في التَّوِّ واللّحظة

206
00:16:41,670 --> 00:16:44,290
،أولئك الأشاوِسُ، ذوي الجينات العنيدة الأبيّة

207
00:16:44,550 --> 00:16:46,590
الّذِينَ يُنَاوِئُونَ نهاية العالَم

208
00:16:46,960 --> 00:16:48,830
!سأسمحُ لكِ بحَمْلِ طفلي

209
00:16:49,930 --> 00:16:51,890
لكنْ، أَلَمْ تَسمَعني؟

210
00:16:51,890 --> 00:16:58,390
،أَشتهي لجيناتٍ عنيدةٍ أَبيّةٍ
ليسَ لمُتَضَعْضَعٍ مُنطوٍ مِثْلكَ

211
00:17:09,160 --> 00:17:11,280
!كُفَّا عَن التَّناحرِ عديم الجدوى حالًا

212
00:17:11,830 --> 00:17:15,080
أَلا تتقاسمان الأمنيّة نَفْسها؟

213
00:17:15,710 --> 00:17:19,530
،مَحْقَ العوالِم كُلّها إلّا وَاحدًا

214
00:17:20,040 --> 00:17:22,420
!بُغية جَعْله العالَم المِثاليّ

215
00:17:23,420 --> 00:17:26,130
أَليست هذه أُمنيّتكَ أيضًا؟

216
00:17:26,840 --> 00:17:31,600
ماذا تَتمنَّى حرفيًّا إنشاءه في العالَم الوحيد الّذي تُريد إنقاذه؟

217
00:17:31,810 --> 00:17:33,720
وماذا لوْ أخبَرتكَ؟

218
00:17:34,880 --> 00:17:38,730
لو كانت أُمنيّتكَ جَليلة؛ ستكسبُ مُعاضَدَتي

219
00:17:38,900 --> 00:17:41,730
...أمّا لوْ كانت أُمنيّةً غَثَّةً

220
00:17:42,270 --> 00:17:45,360
!أَخشى بحَتميّة ألّا أَسمَحَ بتحقيقها أبدًا...

221
00:17:48,240 --> 00:17:52,410
تَحدِّيكَ الصّارخ لِيَّ؛ سيَجعَلُ وُصولكَ بَعِيدَ المنالِ

222
00:18:01,570 --> 00:18:02,420
لِمَ؟

223
00:18:04,820 --> 00:18:05,690
...أَيًّا كانَ

224
00:18:19,850 --> 00:18:22,310
...مُوقِنةٌ أنَّ قَلَمَ الرُّصاص هذا ليسَ بعاديٍّ، إنَّما

225
00:18:24,960 --> 00:18:25,740
!مهلًا

226
00:18:31,950 --> 00:18:32,950
شَكْلُ هِلالٍ؟

227
00:18:50,700 --> 00:18:55,600
أُوقِنُ بحَتميّة خروجي للنِّضال مِن البدايةِ

228
00:18:55,700 --> 00:19:00,040
على يَقينٍ أنَّ طريقي غيْر مُمهَّدٍ للاِنتصارِ

229
00:19:00,260 --> 00:19:05,400
فأنا أَعيشُ في عالَمِ رغباتٍ لا تُحصى

230
00:19:05,630 --> 00:19:10,080
فيه الضَّروراتُ تَهرُبُ بَعيدًا عَنِّي

231
00:19:10,290 --> 00:19:15,220
كسفينةٍ غارقةٍ في بحرِ مشاعرٍ لا تُطاق

232
00:19:15,220 --> 00:19:22,550
لِنبتعِد بها إلى مُنتصف هذا العالَم

233
00:19:22,950 --> 00:19:27,600
لا يطيب لِيَّ غَضّ الطَّرف عمّا يُمليه عليَّ قلبي

234
00:19:27,640 --> 00:19:32,800
فتَشَبُّثي بحُلمي؛ هوَ طَوْق نجاتي

235
00:19:33,040 --> 00:19:37,900
وليسَ هذا هروبًا مِن الواقع؛ بَلْ هوَ خيْر الإجاباتِ كُلّها

236
00:19:38,000 --> 00:19:46,350
لأَعِدَّنَّ قلبي لموجةِ انفعالاتٍ عاصفةٍ؛ فلنْ يَتزَعْزَعَ

237
00:20:09,830 --> 00:20:12,170
!أيُّها الهَرِمُ -
!لستُ هَرِمًا يا هذا -

238
00:20:12,250 --> 00:20:15,090
ستستخدمه كثيرًا؛ فيَتعيَّن عليكَ أنْ تَعتادَ عليه

239
00:20:15,120 --> 00:20:17,720
!فهمتُ، اللّعنة

240
00:20:18,490 --> 00:20:21,030
أنتَ! هاتفكَ مُختَلِف

241
00:20:21,370 --> 00:20:23,510
فخاصّتكَ به أزرارٌ، وهذا ما أُريده

242
00:20:23,520 --> 00:20:25,380
اُعذُرني، فهوَ لِيَّ وَحدي

243
00:20:25,410 --> 00:20:26,240
!حَسبكُما

244
00:20:27,000 --> 00:20:28,500
الفتاة غادرتِ المَنْزِل

245
00:20:35,880 --> 00:20:38,430
!وَاْ! أَجِئتُ إلى مكانٍ خاطئٍ؟

246
00:20:42,730 --> 00:20:44,390
...والقمرُ بَدرٌ لا هِلالٌ

247
00:20:48,110 --> 00:20:49,270
!هذا هوَ

248
00:20:50,900 --> 00:20:52,670
أَلستَ ببَطلٍ آخرٍ؟

249
00:20:53,360 --> 00:20:56,560
إذنْ، أَليسَ هذا مَطمع الأشرار؟

250
00:20:56,860 --> 00:20:59,410
...لا أَهتَم حقًّا بشأنه، إنَّما

251
00:21:00,030 --> 00:21:02,080
به شيءٌ لا مَثيل له...

252
00:21:02,170 --> 00:21:03,340
!أَعْطِينيه

253
00:21:13,600 --> 00:21:15,500
سَيْرُ الطّائر

254
00:21:13,700 --> 00:21:14,750
سَيْرُ

255
00:21:14,300 --> 00:21:15,100
الطّائر

256
00:21:15,510 --> 00:21:17,700
پوليمر تَحوُّل

257
00:21:15,860 --> 00:21:17,000
تَحوُّل

258
00:21:16,200 --> 00:21:17,350
پوليمر

259
00:21:18,550 --> 00:21:20,170
!أنتم مرّة أخرى؟

260
00:21:21,930 --> 00:21:24,160
!أنتَ "الإنسان الآليّ الجديد" إذًا

261
00:21:24,290 --> 00:21:26,110
!مَنْ أنتَ؟ هيّا عَرِّف نَفسك

262
00:21:27,130 --> 00:21:28,120
...اسمي هوَ

263
00:21:37,640 --> 00:21:38,430
!(كاشّان)

264
00:21:55,880 --> 00:21:58,570
ليسَ بأمرٍ خاصٍّ بأحَدٍ

265
00:21:58,590 --> 00:22:02,460
فهوَ يُولَد مَعكَ

266
00:22:03,410 --> 00:22:06,360
مهما كانَ الخَوَاءُ سرمديًّا

267
00:22:06,370 --> 00:22:10,180
وَحدي مَنْ سيَتَذَكَّره

268
00:22:11,110 --> 00:22:12,750
قليلٌ مِن العاطفةِ

269
00:22:12,770 --> 00:22:14,870
وضَحكٌ مُنضبِطٌ بِلا استهزاءٍ

270
00:22:14,880 --> 00:22:16,880
فستبقى الأمور على ما يُرام

271
00:22:18,800 --> 00:22:22,300
رَسْمي صارَ وَاقعًا

272
00:22:22,310 --> 00:22:26,130
ومَع اهتزاز اِلتقاط انفاسي؛ تَتجسَّد بوضوحٍ

273
00:22:26,300 --> 00:22:29,790
للرَّغباتِ حدودٌ لا تَتخطّاها

274
00:22:29,980 --> 00:22:33,900
فلنْ أَكونَ خائفةً بَعدَ الآن

275
00:22:34,290 --> 00:22:37,740
نَسْجُ مُخَيِّلتي أَتعَبني

276
00:22:38,000 --> 00:22:41,640
فتَعلو نَبَضاتُ قلبي بِلا هَوادَةٍ

277
00:22:41,760 --> 00:22:45,270
ولا يَهدأ حتّى نَبضةٍ

278
00:22:45,440 --> 00:22:51,100
كرَنينِ أجراسٍ تُودِّعني قائلةً، مَع السَّلامة

279
00:22:53,190 --> 00:22:54,970
مَع السَّلامة