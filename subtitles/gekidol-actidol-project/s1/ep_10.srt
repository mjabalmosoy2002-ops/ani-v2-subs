...الحقيقية

187
00:11:58,090 --> 00:12:00,060
...ميكي الحقيقية

188
00:12:03,140 --> 00:12:04,310
!لك ذلك

189
00:12:05,020 --> 00:12:06,060
"هورومون"

190
00:12:06,060 --> 00:12:08,020
"هورومون"
،نظرًا للخطوات التالية بالنسبة لنا

191
00:12:08,520 --> 00:12:11,780
أعتقد أن إعطاء إيزومي دور البطولة
.هو القرار الصحيح

192
00:12:13,110 --> 00:12:16,400
.لا يمكننا الاستفادة من المدرسة إلى الأبد

193
00:12:16,400 --> 00:12:18,490
،ومن أجل الأداء في المكان المناسب

194
00:12:18,490 --> 00:12:22,330
.نحن بحاجة إلى زيادة جمهورنا والإيرادات

195
00:12:22,330 --> 00:12:23,660
.هذا صحيح تماما

196
00:12:25,410 --> 00:12:30,000
ظننت أنني فهمت ما مرت به كاورون
...كمخرجة، لكن

197
00:12:30,000 --> 00:12:33,000
إذاً ستعملين في نادي للمضيفات قريبًا؟

198
00:12:33,000 --> 00:12:35,130
أن يكون نادي ضيافة؟

199
00:12:41,300 --> 00:12:45,020
أشعر بالسوء تجاه سيريا، لكني لن
!أتخلى عن هذا الجزء

200
00:12:45,020 --> 00:12:47,940
.لكن سيريا أصبحت قوية الآن

201
00:12:47,940 --> 00:12:49,940
.أنا أعرف

202
00:12:49,940 --> 00:12:52,320
!لكنني لن أسمح لها أن تهزمني

203
00:12:52,320 --> 00:12:54,360
.أنا لن أخسر بالتأكيد

204
00:12:55,900 --> 00:12:57,570
...وأيضا

205
00:12:57,570 --> 00:12:59,780
!أريد أن ألعب دور ميكي...

206
00:12:59,780 --> 00:13:02,870
!أريد أن أعرفها بشكل أفضل من خلال الدور

207
00:13:02,870 --> 00:13:04,450
.إيزومي

208
00:13:04,450 --> 00:13:05,790
!هذا صحيح

209
00:13:05,790 --> 00:13:10,880
الدور الرئيسي في فريق آليس إن سيكون
!"لإيزومي هيناساكي، النجمة السابقة في شركة "م.م.خ

210
00:13:10,880 --> 00:13:13,630
،وهذا سوف يجذب المزيد من العملاء

211
00:13:13,630 --> 00:13:20,840
ثم سنعود إلى مسرح أليس إن ونصبح
!"فرقة أكبر من فرقة "م.م.خ

212
00:13:20,840 --> 00:13:21,890
...أنت نوعا ما

213
00:13:21,890 --> 00:13:23,970
.تبدو وكأنها كاورون الآن...

214
00:13:23,970 --> 00:13:27,180
.تولي منصب الإدارة يؤثر في الناس حقاً

215
00:13:27,180 --> 00:13:29,890
--لا، أنا فقط أناقش آفاقنا

216
00:13:29,890 --> 00:13:31,440
".التطلعات"

217
00:13:31,440 --> 00:13:31,730
"هورومون"
".التطلعات"--

218
00:13:31,730 --> 00:13:35,150
"هورومون"
.الجشع في أبهى تجلياته --
!مـ-مهلاً --

219
00:13:36,780 --> 00:13:38,740
"راصدو الزمن (عنوان مؤقت)"

220
00:13:39,110 --> 00:13:41,700
!والآن، يبدأ الاختبار

221
00:13:46,040 --> 00:13:49,000
!أزوسا ليست مبتكرة

222
00:13:49,000 --> 00:13:53,840
لهذه كيوكو أندرسون. على وشك
.احتجاز المبتكرة إنري فيانو

223
00:13:53,840 --> 00:13:54,880
!أوقفي هذا

224
00:13:54,880 --> 00:13:58,170
--أزوسا لا يمكن أن تكون إنري فيانو --
!ميكي --

225
00:13:58,170 --> 00:14:02,430
هذا جنون! ألا تتذكرين أننا ضحكنا
جميعاً معاً؟

226
00:14:02,430 --> 00:14:06,350
هل حقا يمكنك توجيه مسدس إلى
صديق فقط لأن هناك مهمة؟

227
00:14:08,430 --> 00:14:10,560
...أنا

228
00:14:10,560 --> 00:14:11,690
...أنا فقط

229
00:14:12,940 --> 00:14:14,020
!لا أستطيع فعلها...

230
00:14:16,440 --> 00:14:18,280
!حسناً! لنتوقف هنا

231
00:14:18,280 --> 00:14:20,490
.إيزومي مذهلة حقا

232
00:14:20,490 --> 00:14:22,280
.قد يكون هذا قد انتهى

233
00:14:22,280 --> 00:14:24,120
.حسنًا. أنت التالية يا سيريا

234
00:14:24,120 --> 00:14:25,450
.مستعدة

235
00:14:26,870 --> 00:14:28,870
"راصدو الزمن (عنوان مؤقت)"

236
00:14:29,290 --> 00:14:30,750
...ميكي الحقيقية

237
00:14:31,370 --> 00:14:32,210
"راصدو الزمن (عنوان مؤقت)"

238
00:14:32,210 --> 00:14:33,880
"راصدو الزمن (عنوان مؤقت)"
...الحقيقية

239
00:14:34,540 --> 00:14:36,500
سيريا؟

240
00:14:38,050 --> 00:14:42,260
هل يمكنني إضافة أسطر حول فعاليات
مهرجان الصيف التي ليست في النص؟

241
00:14:43,590 --> 00:14:45,350
مانامي، كيف تشعرين؟

242
00:14:45,350 --> 00:14:49,100
.السيناريو غير مكتمل، لذلك لا يزعجني ذلك

243
00:14:49,100 --> 00:14:50,310
إيزومي؟

244
00:14:50,310 --> 00:14:51,890
.أنا لا أمانع في ذلك

245
00:14:51,890 --> 00:14:53,190
.حسنا

246
00:14:53,190 --> 00:14:54,560
.ابدئي إذاً

247
00:14:54,560 --> 00:14:55,900
.حسناً

248
00:15:02,240 --> 00:15:05,200
!أزوسا ليست مبتكرة

249
00:15:05,200 --> 00:15:09,990
هذه كيوكو أندرسون. على وشك
.احتجاز المبتكرة إنري فيانو

250
00:15:09,990 --> 00:15:14,750
توقفي عن هذا! أزوسا لا يمكن أن
...تكون إنري فيانو

251
00:15:14,750 --> 00:15:19,840
مهلا، هل تتذكرين عندما ذهبنا نحن
الثلاثة إلى مهرجان الصيف؟

252
00:15:19,840 --> 00:15:22,170
نظرت أزوسا إلى السمكة
الذهبية التي اصطدتها

253
00:15:22,170 --> 00:15:24,720
"وقالت: "هل تعتقدين أن طعمها جيد؟

254
00:15:26,760 --> 00:15:30,850
.ثم قلّدتها وأدخلتها في فمي

255
00:15:32,730 --> 00:15:34,350
،وعندها

256
00:15:34,350 --> 00:15:37,440
،لقد ضربتِنا على رأسينا

257
00:15:37,440 --> 00:15:39,320
.وبصقنا السمكة الذهبية

258
00:15:40,400 --> 00:15:42,320
...شخص كهذا

259
00:15:42,320 --> 00:15:44,860
!من المستحيل أن يكون مجرمًا

260
00:15:44,860 --> 00:15:46,610
!ميكي --
!هذا جنون --

261
00:15:46,610 --> 00:15:49,450
ألا تتذكرين أننا ضحكنا جميعاً معاً؟

262
00:15:49,450 --> 00:15:53,080
فقط لأن هناك مهمة، هل يمكنك حقًا
توجيه مسدسك نحو صديق؟

263
00:15:54,000 --> 00:15:56,710
!هذا خطأ

264
00:15:59,540 --> 00:16:00,710
!توقفا هنا

265
00:16:01,960 --> 00:16:04,470
.لم يخطر في ذهني

266
00:16:04,470 --> 00:16:08,140
.لقد قمت بدور ميكي من وجهة نظر كيوكو

267
00:16:09,300 --> 00:16:12,850
لقد افترضت للتو أن صاحبة اليوميات
.هي مؤلفتها

268
00:16:14,350 --> 00:16:16,230
،لكن أنت يا سيريا

269
00:16:16,230 --> 00:16:18,980
.وبدلاً من ذلك لقد ربطت كاورون مع ميكي

270
00:16:19,940 --> 00:16:21,900
،وعندما بدأت العمل على الدور

271
00:16:21,900 --> 00:16:25,450
.كان لدي هذا الشعور بأن هذه كاورو

272
00:16:25,450 --> 00:16:27,740
.لهذا السبب قمت بالإعلان

273
00:16:27,740 --> 00:16:31,830
لقد شعرت أن جوانب من كاورون كانت في
.الجزء المفقود من النص

274
00:16:32,950 --> 00:16:34,500
.نعم

275
00:16:34,500 --> 00:16:36,120
.كاورو كانت ميكي

276
00:16:37,500 --> 00:16:38,920
.نعم

277
00:16:38,920 --> 00:16:44,380
ميكي التي قدمتها كانت بلا شك ميكي
!التي أردت أن أعرفها بشكل أفضل

278
00:16:44,380 --> 00:16:46,260
.إيزومي

279
00:16:46,260 --> 00:16:48,640
!دور ميكي سيذهب إلى سيريا

280
00:16:48,640 --> 00:16:50,510
!رائع! تهانينا

281
00:16:50,510 --> 00:16:51,890
!شكراً جزيلاً

282
00:16:53,390 --> 00:16:59,020
يبدو أن لوفيمين كانت على حق في
!اقتراح سيريا لدور ميكي

283
00:16:59,020 --> 00:17:01,820
أليس هذا صحيحا يا آيري؟

284
00:17:01,820 --> 00:17:03,020
وكازوهارو؟

285
00:17:03,020 --> 00:17:05,360
.نعم. لا يوجد شيء يمكنني قوله

286
00:17:06,570 --> 00:17:09,410
.أنتما بالتأكيد قد ألهمتماني هذه المرة

287
00:17:11,660 --> 00:17:13,450
ماذا يحدث؟

288
00:17:27,880 --> 00:17:29,590
ماذا حدث للتو؟

289
00:17:31,890 --> 00:17:35,010
!كيوكو

290
00:17:35,010 --> 00:17:36,850
!تماسكي يا كيوكو

291
00:17:36,850 --> 00:17:38,140
!كيوكو

292
00:17:39,190 --> 00:17:41,520
!كيوكو؟ كيوكو

293
00:17:43,480 --> 00:17:45,280
!توقف هناك يا إنري فيانو

294
00:17:50,740 --> 00:17:53,830
لن تناديني بأزوسا بعد الآن، أليس كذلك؟

295
00:17:58,710 --> 00:18:00,830
.اذهبي... خلف إنري

296
00:18:00,830 --> 00:18:02,460
...لكن

297
00:18:02,460 --> 00:18:03,840
!لا أستطيع أن أتركك

298
00:18:03,840 --> 00:18:06,630
.لا يمكن تراجع الماضي

299
00:18:06,630 --> 00:18:11,260
،حقيقة وفاة كيوكو أندرسون هنا
،والآن، وفي هذا الوقت

300
00:18:11,260 --> 00:18:12,970
.هو جزء مستقر من التاريخ

301
00:18:14,470 --> 00:18:18,180
!لكن... لا يمكنكِ أن تموتي

302
00:18:18,180 --> 00:18:23,190
ولن يُسمح لك بالتخلي عن المهمة
.والعودة إلى زمنك

303
00:18:23,190 --> 00:18:25,020
!كيوكو

304
00:18:25,020 --> 00:18:26,900
...أنت

305
00:18:26,900 --> 00:18:29,110
...مازال لدي...

306
00:18:29,110 --> 00:18:30,900
.دور يجب أن أقوم به...

307
00:18:34,910 --> 00:18:36,410
!تاكيزاكي

308
00:18:39,290 --> 00:18:40,370
...كا

309
00:18:42,370 --> 00:18:43,790
...كاورو

310
00:18:54,050 --> 00:18:56,680
هل هناك شخص يعجبك؟

311
00:18:56,680 --> 00:18:57,680
.نعم

312
00:18:57,680 --> 00:19:00,850
ما هو الشعور عندما تحبين شخصًا؟

313
00:19:00,850 --> 00:19:02,140
ماذا؟

314
00:19:02,140 --> 00:19:04,520
هل هي الرغبة في أن تكوني بالقرب
من ذلك الشخص؟

315
00:19:04,520 --> 00:19:07,320
هل هي الرغبة في أن تكوني
سعيدةً معهم؟

316
00:19:07,320 --> 00:19:10,070
...أنا

317
00:19:10,070 --> 00:19:11,490
...أنا وهو

318
00:19:11,490 --> 00:19:13,320
هل تعتقدين

319
00:19:13,320 --> 00:19:16,070
أنه في إمكانك أن تجعليه سعيدًا؟

320
00:19:19,450 --> 00:19:22,250
.أجيبي عن سؤالي

321
00:19:22,250 --> 00:19:24,500
حول ماذا يدور كل هذا؟

322
00:19:24,500 --> 00:19:27,420
لماذا واصلت الهروب من هيرو؟

323
00:19:28,130 --> 00:19:29,710
.أجيبني

324
00:19:34,970 --> 00:19:41,390
.على الرغم من حقيقة أنك تحبينه

325
00:19:41,390 --> 00:19:42,890
.تريدين أن تكوني متزوجة منه

326
00:19:42,890 --> 00:19:44,770
.ترغبين في احتضانه

327
00:19:44,770 --> 00:19:45,900
!توقفي عن ذلك

328
00:19:45,900 --> 00:19:47,940
!الآلة لا يمكن أن تفهم أبدا

329
00:19:47,940 --> 00:19:49,070
.ولكنني أفهم

330
00:19:50,440 --> 00:19:52,320
.لأنك أنا

331
00:19:52,320 --> 00:19:54,070
!دورو، توقفي عن هذا

332
00:19:54,070 --> 00:19:55,990
!ألغِ نظام الرعاية

333
00:19:55,990 --> 00:19:58,910
.لماذا؟ هذا هو ما أردت

334
00:19:58,910 --> 00:20:00,040
!لا ليس هذا

335
00:20:00,040 --> 00:20:02,580
.هذا هو حلمك

336
00:20:02,580 --> 00:20:04,660
.الذي حلمت به مرارا وتكرارا

337
00:20:04,660 --> 00:20:05,750
!لا

338
00:20:05,750 --> 00:20:08,040
...هذا ليس حلمي

339
00:20:08,040 --> 00:20:10,250
.سأساعدك على تذكر كل شيء

340
00:20:10,250 --> 00:20:12,460
!توقفي عن ذلك

341
00:20:12,460 --> 00:20:14,630
ثم سوف تستمرين في الهرب
بعد كل شيء؟

342
00:20:16,260 --> 00:20:18,090
...الهرب من الشخص الذي تحبينه

343
00:20:18,090 --> 00:20:22,560
.ومصيرك هو قتله...

344
00:20:22,560 --> 00:20:25,350
.كان مصير هيرو أن يموت في تلك اللحظة

345
00:20:26,350 --> 00:20:33,280
لكنك تخليت عن واجبك كمراقبة
.واخترت أن تقعي ضحية بدلاً منه

346
00:20:34,490 --> 00:20:37,070
،سواء كان حبك لهيرو

347
00:20:37,070 --> 00:20:39,450
،أو مصيرك كراصدة

348
00:20:39,450 --> 00:20:40,780
.أنت فقط تستمرين في الهرب

349
00:20:42,410 --> 00:20:44,200
،وفي ذلك اليوم

350
00:20:44,200 --> 00:20:45,620
!لقد قتلت ميكي

351
00:20:47,040 --> 00:20:50,290
،سواء في دور ميكي أو كاورو ساكاكيبارا

352
00:20:50,290 --> 00:20:52,590
.لقد واصلت الهرب من هيرو

353
00:20:52,590 --> 00:20:54,010
.لا يمكنك الاختيار

354
00:20:54,010 --> 00:20:56,720
إذا لم تستطيعي أن تفهمي
،مدى الخطيئة في ذلك

355
00:20:56,720 --> 00:20:59,760
.لا فائدة من وجودك بعد الآن

356
00:20:59,760 --> 00:21:06,640
!سوف أصلحها

357
00:21:00,970 --> 00:21:02,180
!توقفي

358
00:21:06,640 --> 00:21:09,350
!هـ-هيرو

359
00:21:09,350 --> 00:21:10,940
ماذا تفعلين؟

360
00:21:12,190 --> 00:21:13,820
...ميكي! ما الذي

361
00:21:16,190 --> 00:21:18,910
.أنا دورو. مجرد دمية

362
00:21:18,910 --> 00:21:21,070
ما - ماذا؟

363
00:21:21,070 --> 00:21:24,580
.إنها ميكي الحقيقية

364
00:21:24,580 --> 00:21:27,120
.ميكي شتينبرج

365
00:21:27,120 --> 00:21:29,210
ماذا تقولين؟

366
00:23:02,260 --> 00:23:04,010
".أحبك"

367
00:23:04,010 --> 00:23:06,390
.كل هذا الوقت، هذا ما كنت أتوق لسماعه

368
00:23:07,310 --> 00:23:10,310
.بدأ كل شيء بما فعلته

369
00:23:10,310 --> 00:23:12,310
.وسأكون أنا أيضًا من سينهي الأمر

370
00:23:13,440 --> 00:23:15,060
".أحبك"

371
00:23:15,060 --> 00:23:17,320
،طوال هذا الوقت
.هذا ما كنت أتوق إلى قوله

372
00:23:18,270 --> 00:23:21,190
.عبر مئات المليارات من الأزمنة والعوالم

373
00:23:22,360 --> 00:23:24,490
:غيكيدول الحلقة 11
".عندما نستيقظ نحن الموتى"

374
00:23:24,490 --> 00:23:27,160
".عندما نستيقظ نحن الموتى"
:غيكيدول الحلقة 11
".عندما نستيقظ نحن الموتى"

375
00:23:27,160 --> 00:23:29,450
".عندما نستيقظ نحن الموتى"
!حان وقت إسدال الستار على النهاية