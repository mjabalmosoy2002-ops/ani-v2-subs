1
00:00:02,770 --> 00:00:05,120
انتهت "خذن فرصة أيّتها المغنّيات"؟

2
00:00:05,120 --> 00:00:07,690
!لمَ؟ كانت هنالك مباريات متبقّية

3
00:00:07,690 --> 00:00:11,080
يُقال أنّ الفجوة في القوّة كانت واسعة

4
00:00:11,080 --> 00:00:14,300
بين "ديوس إكس ماكينا" والفرق منخفضة المستوى

5
00:00:14,300 --> 00:00:15,990
فلن تكون المشاهدة مسلّية

6
00:00:15,990 --> 00:00:22,000
رأت المغنّيات اللواتي أردن المشاركة
معركنا وبدأن بالانسحاب

7
00:00:22,000 --> 00:00:25,340
ألم يكن معروفاً منذ البداية أنّ
هنالك فارقاً في القوّة؟

8
00:00:25,340 --> 00:00:28,420
!كان المغزى بأسره هو إعطاءنا فرصة بأيّ حال

9
00:00:28,420 --> 00:00:30,960
لا يمكنهم أن ينهوها هكذا وحسب

10
00:00:30,960 --> 00:00:32,420
...لا يُعقل

11
00:00:32,420 --> 00:00:33,630
!أرفض هذا

12
00:00:33,630 --> 00:00:35,410
!أريد فعلها الآن

13
00:00:35,410 --> 00:00:38,850
!أريد قتالهنّ بكلّ قوّتنا

14
00:00:38,850 --> 00:00:41,780
لكن إذا كانت قد انتهت، فلن نحصل على فرصتنا

15
00:02:17,930 --> 00:02:20,820
هذا تخطيطٌ بيانيّ لعدد المغنّيات الكليّ

16
00:02:20,820 --> 00:02:24,450
انظرن، إنّه في انخفاض حاد
في غضون الأيام الفائتة

17
00:02:24,450 --> 00:02:26,120
ما معنى هذا؟

18
00:02:26,120 --> 00:02:30,010
تدرك المزيد من المغنّيات أنّهن
لا يستطعن المنافسة

19
00:02:30,010 --> 00:02:34,000
بعد مشاهدتهنّ لإبادتكنّ
للفرق منخفضة المستوى

20
00:02:36,070 --> 00:02:39,160
كان هذا الهدفّ الحقيقيّ من هذه العمليّة؟

21
00:02:39,740 --> 00:02:42,530
أبليتنّ حسناً

22
00:02:43,910 --> 00:02:46,070
كما خطّطتُ له

23
00:02:46,070 --> 00:02:47,340
صدقاً؟

24
00:02:47,340 --> 00:02:48,980
لمَ تقومين بهذا؟

25
00:02:49,310 --> 00:02:54,300
بمساعدتكنّ، وصلت معارك المغنّيات لأوجّ الحماس

26
00:02:54,300 --> 00:02:57,720
لكنّ كان عدّد المغنّيات كبيراً نوعاً ما

27
00:02:57,720 --> 00:03:00,610
لذا أردتُ تقليص العدد قليلاً

28
00:03:01,360 --> 00:03:03,640
واستغلّيتِنا لذلك؟

29
00:03:03,640 --> 00:03:06,200
لا أحتاج مغنّيات ينسحبن بعد
!مجرّد شيءٍ كهذا

30
00:03:07,860 --> 00:03:10,340
ترتفع قيمة وجودة معارك المغنّيات

31
00:03:10,340 --> 00:03:13,570
!عندما تقاتل اللاعبات القويّات بعضهنّ

32
00:03:13,570 --> 00:03:16,920
يمكن صقل الألماسة من قِبل
أ!لماسة أخرى فحسب

33
00:03:19,090 --> 00:03:21,870
انتهت "خذن فرصة أيّتها المغنّيات" الآن

34
00:03:21,870 --> 00:03:27,680
ولم تتبقّ أيّ مغنّيات قادرات
على تحدّيكن بأيّ حال، صحيح؟

35
00:03:29,790 --> 00:03:33,450
!هذا يغضبني! لا أستطيع ترك الأمر ينتهي هكذا

36
00:03:33,450 --> 00:03:35,550
لكنّهم نشروا إعلان الانتهاء

37
00:03:35,550 --> 00:03:36,940
لا مرجع الآن

38
00:03:36,940 --> 00:03:41,070
!أفهم ذلك، أفهم لكنّي لا أريد أن أفهم

39
00:03:41,500 --> 00:03:43,940
أريد القتال أيضاً

40
00:03:43,940 --> 00:03:46,630
،لا أدري لو بإمكاننا الفوز

41
00:03:46,630 --> 00:03:49,790
!لكن إذا لم نقاتل، فلن نفوز أبداً

42
00:03:50,960 --> 00:03:53,920
!مُذهل! يبهرني قولك لذلك يا أكينو-تشان

43
00:03:53,920 --> 00:03:57,320
!أنا جزءٌ من "بلا حدود" أيضاً! أريد الفوز

44
00:03:57,320 --> 00:03:59,260
لا أريد ترك الأمر ينتهي بخسارة

45
00:03:59,260 --> 00:04:01,970
يبدو أنّه تأثير أحدهم السيّئ

46
00:04:01,970 --> 00:04:03,760
!لا أريد الاستسلام

47
00:04:03,760 --> 00:04:06,220
!حسناً، أعرف ماذا أفعل

48
00:04:09,800 --> 00:04:11,600
ماذا؟

49
00:04:11,600 --> 00:04:13,190
أ-أأنتِ جادة؟

50
00:04:13,190 --> 00:04:16,060
لا أصدّق أنّ ري قد توافق
!على خطّة كهذه

51
00:04:16,060 --> 00:04:19,530
إذا خسرتنّ، فستصبحن محطّ سخرية الجميع

52
00:04:19,530 --> 00:04:23,580
لكنّ أولويّتنا الآن ليس التفكير بما سيحصل
!عند خسارتنا، بل القتال

53
00:04:23,580 --> 00:04:26,410
لذا هلّا ساعدتننا جميعاً؟

54
00:04:44,980 --> 00:04:46,130
تمنّي دخول

55
00:04:54,170 --> 00:04:55,520
كم عاماً مضى؟

56
00:04:55,520 --> 00:04:58,270
لم يخطر لي أن تتواصلي معي

57
00:04:58,880 --> 00:05:00,710
مضى وقتٌ طويل يا أزايلا

58
00:05:00,710 --> 00:05:04,150
هل قرّرتِ العودة للفتاة الأبديّة خيراً؟

59
00:05:04,530 --> 00:05:07,170
آسفة، لكنّ ذلك ليس سبب قدومي

60
00:05:07,170 --> 00:05:11,100
،"خذن فرصة أيّتها المغنّيات"
كانت تلك فكرتك، أليس كذلك؟

61
00:05:11,550 --> 00:05:13,080
وما في ذلك؟

62
00:05:13,400 --> 00:05:17,050
كفّي عن محاولة التخلّص من المغنّيات بخططٍ كهذه

63
00:05:17,050 --> 00:05:21,880
يوجد شيء واحد فحسب تحتاجه في معارك
المغنّيات، وهو ضمّ رفيقين لك

64
00:05:21,880 --> 00:05:23,320
هكذا يجب أن يكون الأمر

65
00:05:23,320 --> 00:05:27,480
وبسبب تلك القاعدة الواهنة، يوجد الآن
الكثير من المغنّيات

66
00:05:27,480 --> 00:05:28,790
مغنّيات ضعيفات بلا أهداف

67
00:05:28,790 --> 00:05:32,430
دخلن المجال كهواية، كما لو كان كالموضة لهنّ

68
00:05:32,430 --> 00:05:33,750
لم تتغيّري

69
00:05:33,750 --> 00:05:37,060
تسعين للقوّة ممن حولك لجعل نفسك أقوى

70
00:05:37,060 --> 00:05:42,980
أنت كذلك يا أزايلا، تساعدين المغنّيات الضعيفات
بالرغم من القوّة التي تمتلكينها

71
00:05:42,980 --> 00:05:46,990
دون ذلك، لربما استطعتِ الوصول له

72
00:05:46,990 --> 00:05:49,910
لا تزالين تبحثين عنه؟

73
00:05:49,910 --> 00:05:54,330
لا تزال "ديوس إكس ماكينا" تفتقر لشيء
يمنعهنّ من الوصول له

74
00:05:54,330 --> 00:05:57,830
قتال المغنّيات الضعيفات الآن لن يساعدهنّ

75
00:05:58,280 --> 00:06:02,340
لن أنكر أنّ هنالك فتيات غير جادات
في معارك المغنّيات

76
00:06:02,340 --> 00:06:04,290
لكن لسن جميعاً هكذا

77
00:06:04,290 --> 00:06:07,340
بعضهنّ يمتلكن إيماناً قويّاً يحفّزهن للقتال

78
00:06:07,340 --> 00:06:08,720
!سخيف

79
00:06:08,720 --> 00:06:12,590
أعطيتهنّ فرصة قتال الفريق الأقوى، وانسحبن جميعاً

80
00:06:12,590 --> 00:06:16,310
لم تتبقّ أيّ مغنّيات قد يتحدّين
فريقاً يعلو رتبتهنّ

81
00:06:16,310 --> 00:06:18,020
هذا الواقع

82
00:06:18,530 --> 00:06:22,020
لا تزال هنالك فتيات لم يستسلمن

83
00:06:25,440 --> 00:06:27,900
أنتنّ... يمكننا الكلام لاحقاً

84
00:06:27,900 --> 00:06:30,990
!انظري لـ "أرض ويكروس"! هنالك خطبٌ كبير

85
00:06:31,760 --> 00:06:33,450
ما قصدك؟

86
00:06:34,450 --> 00:06:36,160
!نتحدّاكن
!!ديوس إكس ماكينا العزيزات
لن نسمح لكنّ بالهرب
بسلسلة !انتصاراتكنّ! قاتلننا
من
بلا حدود

87
00:06:50,430 --> 00:06:53,180
!الآن وقت كشف قوّة الظلام

88
00:06:54,430 --> 00:06:57,720
الأمر سهلٌ فورما أستطيع الولوج للنظام

89
00:07:02,310 --> 00:07:05,470
يا إلهي، لمَ أساعد في هذا؟

90
00:07:05,470 --> 00:07:08,080
لا تلمنني إذا غضب المشرفون

91
00:07:08,080 --> 00:07:13,320
نحن نلفت الانتباه بالفعل، لكن هل سيفلح هذا؟

92
00:07:13,320 --> 00:07:15,280
!أنتنّ! رافقنني

93
00:07:16,840 --> 00:07:21,210
!"انتشر تحدّي "بلا حدود" في أرجاء "أرض ويكروس

94
00:07:21,210 --> 00:07:24,860
"لكنّ "خذن فرصة أيّتها المغنّيات
قد أُلغيت بالفعل

95
00:07:24,860 --> 00:07:27,380
!"لم تستجب "ديوس إكس ماكينا

96
00:07:27,380 --> 00:07:29,930
!إكس! لا تهربي

97
00:07:29,930 --> 00:07:35,500
!قاتلينا! هذه المرّة سنفوز حتماً

98
00:07:36,000 --> 00:07:41,750
تـ-تنضمّ بقيّة المغنّيات لهذه الحركة
!"التي بدأتها "بلا حدود

99
00:07:41,750 --> 00:07:44,740
ما الذي سيحصل الآن؟

100
00:07:45,190 --> 00:07:49,400
علينا إجابتهنّ الآن، أليس كذلك يا ميكا بي؟

101
00:07:51,400 --> 00:07:53,830
الـ-الهرب بسلسلة انتصاراتكنّ؟

102
00:07:53,830 --> 00:07:58,490
لا أصدّق أنّها قد تكتب تحدّياً مخزياً كهذا
!بعد هزيمتها النكراء

103
00:07:58,490 --> 00:08:00,070
أهي حمقاء؟

104
00:08:00,070 --> 00:08:04,120
ربما ذلك، لكنّها صريحة أكثر من أيّ أحد

105
00:08:05,120 --> 00:08:06,800
أتعرفينها؟

106
00:08:06,800 --> 00:08:10,440
إنّها تحاول جعل شيءٍ يحصل
"في "أرض ويكروس

107
00:08:10,440 --> 00:08:13,340
وتجذب بقيّة المغنّيات للمساعدة

108
00:08:13,340 --> 00:08:15,250
ما الذي ستفعلينه يا ميكايلا؟

109
00:08:15,250 --> 00:08:19,390
إذا لم تقبلي هذا التحدّي، ستكونين قد هربتِ فعلاً

110
00:08:21,350 --> 00:08:22,810
خذن فرصة أيّتها المغنّيات

111
00:08:21,350 --> 00:08:22,810
المعركة النهائيّة

112
00:08:21,350 --> 00:08:22,810
ديوس إكس ماكينا

113
00:08:21,350 --> 00:08:22,810
بلا حدود

114
00:08:22,400 --> 00:08:24,310
!فعلناها! فزنا

115
00:08:24,310 --> 00:08:26,270
لم نربح بعد

116
00:08:26,270 --> 00:08:29,810
"تمكّنتِ من دفع "ديوس إكس ماكينا
للموافقة حقّاً

117
00:08:29,810 --> 00:08:33,610
قد تكون الآنسة هيرانا هي أكبر لغز

118
00:08:33,930 --> 00:08:37,330
!شكراً لكنّ جميعاً! سنفوز مهما تطلّب الأمر

119
00:08:37,330 --> 00:08:39,240
!هذا ما كنتُ أريد سماعه

120
00:08:39,240 --> 00:08:43,040
!لكن لا يمكنك هزيمتهنّ بمجرد المعنويات

121
00:08:43,040 --> 00:08:47,460
هذه من بيانات تحليليّ الأخير، يُفترض أن تساعدكنّ

122
00:08:51,430 --> 00:08:53,270
لـ-لمَ تقلّداني؟

123
00:08:53,270 --> 00:08:54,290
!أنتِ من تقلّد

124
00:08:54,290 --> 00:08:57,510
لا يمكنكما أن تجلبا بطاقات غريبة هنا

125
00:08:57,510 --> 00:08:58,890
!ليست غريبة

126
00:08:58,890 --> 00:09:01,810
!اختيارك للثياب دوماً هو الغريب

127
00:09:01,810 --> 00:09:03,070
!ماذا؟

128
00:09:03,070 --> 00:09:04,520
!شكراً لكنّ

129
00:09:04,520 --> 00:09:06,730
!سأستعملها كلّها

130
00:09:06,730 --> 00:09:08,270
ما-ماذا؟

131
00:09:08,270 --> 00:09:10,190
!ا-اتركيني

132
00:09:10,190 --> 00:09:13,780
سأضيف كلّ البطاقات التي اخترتنّها لمجموعتنا إذاً

133
00:09:13,780 --> 00:09:14,820
!شكراً

134
00:09:14,820 --> 00:09:17,200
سأعطيكنّ هذه منّي

135
00:09:20,010 --> 00:09:21,300
حقّاً؟

136
00:09:21,300 --> 00:09:24,240
!رائع! شكراً لك أيّتها المالكة

137
00:09:25,440 --> 00:09:27,650
ماذا؟ يوجد شيءٌ بالداخل

138
00:09:29,450 --> 00:09:32,090
الأميرة الملاكيّة القرمزيّة زيوسياس؟

139
00:09:32,090 --> 00:09:33,810
إنّها بطاقة حظّكن لليوم

140
00:09:33,810 --> 00:09:37,050
أضفنها لمجموعتكنّ وقد تحصل أشياء حسنة

141
00:09:44,290 --> 00:09:47,190
!بالتوفيق! أنتنّ لها

142
00:09:48,650 --> 00:09:52,060
!كيورو كيورون" تهتف لكنّ"

143
00:09:55,530 --> 00:09:59,240
يُستحسن أنّكن مستعدات
بعدما حصل

144
00:09:59,240 --> 00:09:59,950
!بالطبع

145
00:09:59,950 --> 00:10:05,000
إذا خيّبتِ أملي مُجدداً، فستكون هذه
!آخر مرّة أقاتلكِ فيها

146
00:10:05,000 --> 00:10:07,160
!ستختفين من مجال نظري

147
00:10:07,160 --> 00:10:09,570
!لن أهرب! لن أستسلم

148
00:10:09,570 --> 00:10:13,130
!أتيتُ هنا للقتال! للفوز

149
00:10:15,790 --> 00:10:16,840
!فتح

150
00:10:24,110 --> 00:10:28,600
افتتحت "ديوس إكس ماكينا" هذا الدور
بهجوم شرس آخر

151
00:10:28,600 --> 00:10:31,230
هل ستستطيع "بلا حدود" الصمود؟

152
00:10:32,810 --> 00:10:35,980
سنواصل إعطاءك أفضل ما لدينا يا هيرانا

153
00:10:52,670 --> 00:10:57,370
تهاجم "ديوس إكس ماكينا" بشدّة
!من البداية كالمعتاد

154
00:10:57,370 --> 00:11:02,010
إذا سمحن لهذا بأن يبتلعهنّ، فلن يختلف
أداء "بلا حدود" عن المرّة الفائتة

155
00:11:02,010 --> 00:11:04,360
!دوري! سحب

156
00:11:10,560 --> 00:11:11,620
!نمو

157
00:11:19,260 --> 00:11:20,110
!نمو

158
00:11:27,160 --> 00:11:29,480
!يعيد تأثيري الـ "سيغني" إلى يدك

159
00:11:30,580 --> 00:11:32,550
..."ألعب "سيغني

160
00:11:32,550 --> 00:11:36,040
!و... موتّشان، سأستعمل البطاقة التي أعطيتِني إيّاها

161
00:11:36,040 --> 00:11:37,550
!هيرانا-سان

162
00:11:37,550 --> 00:11:38,630
إيليس؟

163
00:11:38,630 --> 00:11:41,840
!محفّز الهجوم! أطرد الـ "سيغني" خاصّتكن

164
00:11:44,070 --> 00:11:45,890
!انطلقي

165
00:11:52,960 --> 00:11:57,050
!قضت "بلا حدود" على مجموعة ثياب حياة

166
00:11:59,310 --> 00:12:02,110
...ملاك؟ هذه المجموعة

167
00:12:02,110 --> 00:12:05,950
!أحسنتِ! كما يُتوقع من البطاقة التي اخترتُها

168
00:12:05,950 --> 00:12:08,430
رائعٌ لك

169
00:12:08,430 --> 00:12:10,120
لمَ تعبثين؟

170
00:12:10,640 --> 00:12:11,500
!نمو

171
00:12:20,540 --> 00:12:22,260
!"ألعب ثلاثة "سيغني

172
00:12:23,710 --> 00:12:24,860
...و

173
00:12:24,860 --> 00:12:26,920
!تخطّي

174
00:12:32,390 --> 00:12:34,100
!ها هي

175
00:12:34,100 --> 00:12:37,360
!حصلن على "اغتيال" حتّى نهاية الدور

176
00:12:37,360 --> 00:12:40,110
أيمكنكنّ إيقاف هذا الهجوم؟

177
00:12:40,110 --> 00:12:42,450
إنّه الهجوم الذي أوقفنا المرّة الفائتة

178
00:12:42,450 --> 00:12:44,510
أجل، لكن ليس اليوم

179
00:12:44,510 --> 00:12:47,280
نؤمن بالمجموعة التي تحمل القوّة
ا!لتي حصلنا عليها من الجميع

180
00:12:56,960 --> 00:12:58,640
!انفجار حياة

181
00:12:59,340 --> 00:13:01,370
!آيس كريم الوافل" خاصّتنا"

182
00:13:01,370 --> 00:13:03,210
كما أظهرت بياناتنا تماماً

183
00:13:03,210 --> 00:13:06,430
!فلتنطلقن يا متحدّيات الإله

184
00:13:06,860 --> 00:13:09,390
!يُهبط تأثير "آيس كريم الوافل" أوبليسك

185
00:13:10,680 --> 00:13:11,930
!تجميد

186
00:13:19,360 --> 00:13:20,900
