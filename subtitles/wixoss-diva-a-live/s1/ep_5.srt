1
00:00:00,680 --> 00:00:07,630
"يستمرّ "مغنّيات المستقبل" بينما تنال "بلا حدود
!هزيمتها الأولى وتواصل السقوط

2
00:00:07,630 --> 00:00:10,370
!خرجن من سباق الفوز

3
00:00:10,370 --> 00:00:15,760
"بينما تقدّم "كيورو كيورون" و"بداية الكون
أداءً قويّاً على الطرف الآخر

4
00:00:15,760 --> 00:00:18,500
!وضع الفريقين في أحسن حال

5
00:00:18,500 --> 00:00:20,730
...كم أتوق لرؤية

6
00:00:27,140 --> 00:00:30,090
أمن الأفضل إذا لم أكن موجودة؟

7
00:02:26,410 --> 00:02:31,380
!أكينو-تشان، أنا آسفة
!سأتغيّب عن التمرين اليوم
لديّ اختبار تعويضيّ آخر
وري-تشان تساعدني في الدراسة

8
00:02:26,410 --> 00:02:31,380
المعذرة يا أكينو، أيمكننا الانتظار
إلى الغد للتمرين؟

9
00:02:27,290 --> 00:02:31,380
أكينو، لا تزالين تفكّرين
بأمر تلك المباراة؟

10
00:02:31,380 --> 00:02:34,250
آسفة

11
00:02:32,960 --> 00:02:34,250
!لا تقلقي حيال ذلك

12
00:02:37,050 --> 00:02:41,550
،صحيح، فقدنا فرصتنا في الفوز
لكن أمامنا المزيد من المباريات
لنعد خطّةً لمعركتنا القادمة

13
00:02:41,550 --> 00:02:46,180
أجل! علينا التماسك حتّى النهاية
لأجل معجبينا المُنتقين! سأتواصل معك مُجدداً بعدما
أنتهي من الدراسة، اتّفقنا؟

14
00:02:56,000 --> 00:03:00,790
حتّى في وقتٍ كهذا، لا تزالان تتطلّعان للمستقبل

15
00:03:00,790 --> 00:03:02,780
وتفكّران بالفريق

16
00:03:19,380 --> 00:03:22,600
لم تردّ أكينو-تشان

17
00:03:22,600 --> 00:03:24,930
لعلّها تشعر بالمسؤولية

18
00:03:24,930 --> 00:03:29,520
إنّها غلطتي لاقتراحي مشاركتنا
"في "وقت المغنّيات

19
00:03:29,950 --> 00:03:32,820
لم نفهم حقيقة مشاعر أكينو

20
00:03:32,820 --> 00:03:34,520
أتحمّل مسؤوليةً بدوري

21
00:03:35,950 --> 00:03:37,480
...على هذا النحو، أكينو

22
00:03:37,480 --> 00:03:38,750
لا تقلقي

23
00:03:39,520 --> 00:03:42,570
لن تهرب أكينو-تشان بسبب شيءٍ كهذا

24
00:03:42,820 --> 00:03:45,220
أريد الاعتقاد بأنّ لا حاجة
للقلق أيضاً

25
00:03:45,220 --> 00:03:48,530
لكن، هناك أشياء لا تريد
فقدانها لأنّك تحبّها

26
00:03:48,530 --> 00:03:52,460
لذا هنالك منهج تفكير بالانسحاب
قبل كرهك للشيء

27
00:03:52,770 --> 00:03:56,960
ربما ذلك، لكنّي أريد تقدير مشاعرها

28
00:03:57,730 --> 00:04:02,360
...صحيح، ما عليها فعله الآن

29
00:04:02,360 --> 00:04:05,050
هو معرفة ما الذي تريد فعله بنفسها

30
00:04:05,310 --> 00:04:06,260
بنفسها؟

31
00:04:06,580 --> 00:04:08,720
أجل، عليها التفكير بنفسها

32
00:04:11,090 --> 00:04:16,060
عليها تجاوز صدمتها من الماضي
من تلقاء نفسها برأيي

33
00:04:23,250 --> 00:04:26,080
أكينو، يمكنك التجهّز للخروج

34
00:04:26,720 --> 00:04:28,490
حسناً، شكراً

35
00:04:37,890 --> 00:04:41,580
"أسفةٌ بشأن ما حصل في "مغنّيات المستقبل

36
00:04:43,000 --> 00:04:43,850
أجل

37
00:04:51,390 --> 00:04:53,800
من الصعب كونك فرداً في فريق

38
00:04:54,610 --> 00:04:57,860
يمكن لأفعال عضو واحد
التأثير على الفريق بأسره

39
00:04:57,860 --> 00:04:59,520
لذا يقلق الجميع

40
00:05:00,180 --> 00:05:01,860
رغم أنّ النقيض صحيحٌ أيضاً

41
00:05:03,250 --> 00:05:07,590
أكينو، لمَ لا تصارحيني
بما في داخلك إذا أردتِ؟

42
00:05:10,850 --> 00:05:15,490
حتّى بعد خسارتنا للمعركة، لم تلوماني

43
00:05:15,490 --> 00:05:18,710
كانتا تتطلّعان للأمام وتفكّران بالفريق

44
00:05:19,020 --> 00:05:23,060
في المقابل، كنتُ أفكر في نفسي فحسب

45
00:05:23,490 --> 00:05:24,400
...لذا

46
00:05:25,300 --> 00:05:29,820
لذا إذا بقيت، فسأسبّب المتاعب لهما لا أكثر

47
00:05:30,560 --> 00:05:33,000
...لأجلهما، عليّ

48
00:05:34,210 --> 00:05:36,440
هذا ما تفكّرين به إذاً

49
00:05:40,330 --> 00:05:44,940
،إذا كان هذا شعورك الحقيقيّ
فأعتقد أنّهما ستحترمان ذلك

50
00:05:45,490 --> 00:05:50,450
بأيّ حال، عليكِ اتّخاذ خيار
لن تندمي عليه برأيي

51
00:05:51,580 --> 00:05:52,660
أندم عليه؟

52
00:05:53,090 --> 00:05:56,650
،أجل، مهما قرّرتِ في النهاية

53
00:05:56,650 --> 00:06:00,960
إذا واجهتِ ما بداخل قلبك مباشرةً، فلن تندمي

54
00:06:10,970 --> 00:06:12,930
!آسفة، انتهيت للتو
أأنتِ بخير؟ أكينو-تشان

55
00:06:31,860 --> 00:06:33,000
تمنّي دخول

56
00:06:36,000 --> 00:06:36,770
أجل

57
00:06:37,210 --> 00:06:38,800
تصطدم بحائط

58
00:06:38,800 --> 00:06:43,200
تقلق، وتفكّر بنفسك

59
00:06:47,920 --> 00:06:51,550
ستكمل هذه الوثيقة محي المغنّية خاصتك

60
00:06:51,840 --> 00:06:53,300
أأنتِ متأكّدة؟

61
00:06:53,300 --> 00:06:55,680
أكينو

62
00:07:02,280 --> 00:07:03,650
...أنتِ كنتِ

63
00:07:03,950 --> 00:07:06,400
"الآنسة أكينو من "بلا حدود

64
00:07:06,400 --> 00:07:08,500
من النادر رؤيتك بمفردك

65
00:07:08,500 --> 00:07:10,110
أين بقية رفيقاتك؟

66
00:07:10,760 --> 00:07:12,270
...حسناً، ذلك

67
00:07:12,270 --> 00:07:13,120
سأعيد

68
00:07:13,460 --> 00:07:16,870
ستكمل هذه الوثيقة محي المغنّية خاصتك

69
00:07:19,950 --> 00:07:22,420
!ماذا؟

70
00:07:24,660 --> 00:07:26,130
فهمت

71
00:07:26,550 --> 00:07:30,510
كنتُ أعرف أنّ هنالك
خطباً ما بـ"بلا حدود" مؤخراً

72
00:07:30,930 --> 00:07:32,380
هذا ما كان يحصل إذاً

73
00:07:33,860 --> 00:07:37,120
للجميع أشياء لا يبرعون فيها

74
00:07:37,120 --> 00:07:41,450
...لكن إذا حلّلتها علمياً وتجاوزتها

75
00:07:41,450 --> 00:07:43,600
لا تزال الدكتورة تخاف الظلام

76
00:07:43,880 --> 00:07:45,690
ولا تستطيع الذهاب للحمّام بمفردها ليلاً

77
00:07:45,910 --> 00:07:47,690
!لا تخبريها بذلك

78
00:07:48,000 --> 00:07:51,700
عليكِ إصلاح ذلك إذا أردتِ مواصلة
كونك طبيبة الظلام الجحيمية

79
00:07:51,890 --> 00:07:52,980
كلا، كلا، كلا

80
00:07:52,980 --> 00:07:56,240
حتّى طبيبة الظلام الجحيمية تخاف
من الأشياء المخيفة

81
00:07:56,240 --> 00:07:58,240
!وليس ذلك اسمي حتّى

82
00:08:00,580 --> 00:08:03,750
...آ-آسفة، لكن هذا نوعاً ما

83
00:08:04,150 --> 00:08:07,670
صحيح، لا نخفي أسراراً سخيفة

84
00:08:07,670 --> 00:08:11,470
هذا ما يجعل "بداية الكون" منيعةً
وغير قابلة للانفصال

85
00:08:11,980 --> 00:08:18,980
بالمناسبة، تأكل نوفا كميّات كبيرة من الحلويات
لتفعيل خلاياها الدماغية وفقما تدّعي

86
00:08:18,980 --> 00:08:20,940
لكنّها تحبّها لا أكثر في الواقع

87
00:08:21,660 --> 00:08:24,480
بانغ، كشف المزيد من المعلومات

88
00:08:24,480 --> 00:08:26,980
سيكون سلوكاً محظوراً بأعلى تصنيف
حتّى في العالم السفليّ

89
00:08:27,310 --> 00:08:28,770
توقّفي رجاءً

90
00:08:30,420 --> 00:08:33,240
أظنّني فهمت قليلاً

91
00:08:33,890 --> 00:08:35,340
ما الذي فهمتِه؟

92
00:08:35,340 --> 00:08:38,080
،عندما تقاتلنا في "مغنّيات المستقبل" سابقاً

93
00:08:38,640 --> 00:08:43,790
تساءلت "لمَ لا تزلن متفائلات
"رغم أنّهن يخسرن؟

94
00:08:45,400 --> 00:08:50,270
لكن كان ذلك لامتلاككن علاقة تمكّنكن

95
00:08:50,770 --> 00:08:54,470
،من التسلّي بالتسبّب بالمتاعب لبعضكن
ومساعدة بعضكن بعضاً

96
00:08:54,670 --> 00:08:55,940
!فهمت الأمر

97
00:08:55,940 --> 00:08:58,270
!أنتِ تفكّرين بالغير كثيراً

98
00:08:58,270 --> 00:09:00,810
!عليكِ التفكير بنفسك

99
00:09:01,120 --> 00:09:03,520
أفكّر بنفسي؟

100
00:09:03,700 --> 00:09:07,170
أنتِ من عليها التفكير بالآخرين
أكثر يا نوفا

101
00:09:07,170 --> 00:09:07,850
ماذا؟

102
00:09:08,220 --> 00:09:11,860
ذلك ما أودّ قوله، لكن قد تكونين محقّة

103
00:09:12,230 --> 00:09:15,300
،إذا اخترتِ إجابتك حقّاً

104
00:09:15,300 --> 00:09:17,820
فأظنّ تلكما الاثنتان ستتقبّلانه

105
00:09:18,240 --> 00:09:19,950
،في البرمجة والحياة

106
00:09:19,950 --> 00:09:23,790
عليك العودة لنقطة بدايتك
إذا كنت تواجه مشاكلاً

107
00:09:24,130 --> 00:09:26,540
العودة لنقطة البداية؟

108
00:09:26,850 --> 00:09:29,630
أجل، أي لنفسك

109
00:09:30,150 --> 00:09:33,260
ما الذي حقّقتِه حتّى الآن؟

110
00:09:34,980 --> 00:09:36,720
...حتّى الآن

111
00:09:41,760 --> 00:09:42,730
صحيح

112
00:09:42,730 --> 00:09:45,970
لم أقرّر أيّ شيء بنفسي حقّاً

113
00:09:46,450 --> 00:09:48,570
جعلت الآخرين يختارون وحسب

114
00:09:49,030 --> 00:09:52,770
واستغلّ الآن ما أعتقد أنّهما
تشعران بشأني كعذر للانسحاب

115
00:09:53,860 --> 00:09:56,240
أدركتِ حقيقة هذا العالم أخيراً إذاً؟

116
00:09:56,410 --> 00:09:59,440
أجل، ما يهمّ هو شعورك في النهاية

117
00:09:59,440 --> 00:10:00,980
حبّك للأمر من عدمه

118
00:10:00,980 --> 00:10:02,580
أليس ذلك كافياً؟

119
00:10:07,950 --> 00:10:09,960
"أحبّ "ويكروس

120
00:10:11,410 --> 00:10:13,880
أحبّ هيرانا-تشان وري-تشان

121
00:10:15,420 --> 00:10:18,710
أحبّ معارك المغنّيات التي أخوضها معهما

122
00:10:18,710 --> 00:10:20,050
!"أحبّ "بلا حدود

123
00:10:21,660 --> 00:10:22,660
...لذا

124
00:10:23,870 --> 00:10:29,600
!لذا... لا أريد الانسحاب

125
00:10:39,760 --> 00:10:44,410
!حسناً، تقترب "مغنّيات المستقبل" من ذروتها

126
00:10:45,170 --> 00:10:51,040
!"معركة اليوم بين "بلا حدود" و"كارد جوكي

127
00:10:51,760 --> 00:10:55,800
عجباً! ما الذي يجري هنا؟

128
00:10:56,460 --> 00:11:02,090
!مركز "بلا حدود" ليس هيرانا كالمعتاد، بل أكينو

129
00:11:04,720 --> 00:11:07,890
،خرجت "بلا حدود" من سباق الفوز

130
00:11:07,890 --> 00:11:12,040
!لكن انظروا لهذا! غيّرن مركزهن

131
00:11:12,420 --> 00:11:16,110
لمعارك المغنّيات أدوار محدّدة في العادة

132
00:11:16,110 --> 00:11:19,420
من النادر تغيير المركز

133
00:11:19,420 --> 00:11:22,360
ربما سنرى حقيقة ما يجري في المعركة

134
00:11:22,770 --> 00:11:24,740
أتوق لمعرفة ذلك

135
00:11:26,270 --> 00:11:29,160
لم يسبق أن رأيتك تلعبين المركز

136
00:11:30,190 --> 00:11:32,080
أنا... أجل

137
00:11:32,080 --> 00:11:34,330
لا تستطعن الفوز، لذلك ستختبرن هذا

138
00:11:34,580 --> 00:11:36,960
لن تحوزي إعجاب الجمهور
إذا أبدت مهاراتك الافتقار

139
00:11:37,480 --> 00:11:38,460
!ليس صحيحاً

140
00:11:38,460 --> 00:11:40,780
!أكينو-تشان مذهلة

141
00:11:40,780 --> 00:11:43,890
!راقبي وحسب! ستندمين تماماً

142
00:11:45,280 --> 00:11:46,890
صحيح

143
00:11:46,890 --> 00:11:50,270
سنبذل قصارى جهدنا، لذا لتكن مباراةً شريفة

144
00:11:50,560 --> 00:11:53,230
لتكن مباراةً شريفة

145
00:11:57,150 --> 00:11:58,300
!فتح

146
00:11:59,280 --> 00:12:03,320
!"حسناً، بدأت المعركة بين "بلا حدود" و"كارد جوكي

147
00:12:03,320 --> 00:12:04,110
...أكينو

148
00:12:03,320 --> 00:12:06,410
أي دراما سنراها هذه المرّة؟

149
00:12:08,670 --> 00:12:12,370
اسمحا لي بأن أكون المركز في
"المعركة الأخيرة لـ"مغنّيات المستقبل

150
00:12:12,580 --> 00:12:14,990
ما-ما حلّ بك فجأةً يا أكينو-تشان؟

151
00:12:15,830 --> 00:12:20,150
أنا أحبّ "ويكروس"، وأحبّكما أيضاً

152
00:12:20,150 --> 00:12:22,700
!أريد خوض معارك المغنّيات معكما

153
00:12:22,700 --> 00:12:26,050
!لذا عليّ تغيير ذاتي الضعيفة

154
00:12:26,330 --> 00:12:28,680
!لذا أرجوكما، دعاني أكون المركز

155
00:12:28,950 --> 00:12:31,040
أأنتِ متأكّدة يا أكينو؟

156
00:12:31,410 --> 00:12:32,730
...لعبك للمركز يعني

157
00:12:33,010 --> 00:12:33,790
أجل

158
00:12:33,790 --> 00:12:37,710
،أفكّر بما سيحصل إذا خسرنا

159
00:12:37,710 --> 00:12:40,070
أو إذا فشلت أمام الجميع

160
00:12:40,510 --> 00:12:42,820
بصراحة، أخاف ذلك

161
00:12:44,390 --> 00:12:46,490
لكن ما أخافه أكثر من ذلك

162
00:12:46,690 --> 00:12:49,170
هو ذعري الدائم

163
00:12:49,170 --> 00:12:50,990
لذا عليّ تخطّي الأمر

164
00:12:50,990 --> 00:12:52,260
!أكينو-تشان

165
00:12:52,260 --> 00:12:54,360
هذه المعركة الأخيرة في المسابقة

166
00:12:54,360 --> 00:12:56,080
فلنتأكّد من ألّا نحمل أيّ ندم

167
00:12:56,360 --> 00:12:59,440
!شكراً لكما، هيرانا-تشان وري-تشان

168
00:13:07,090 --> 00:13:08,660
أجل، دعي الأمر لي

169
00:13:08,660 --> 00:13:13,060
أيمكنكنّ مواكبة إيقاعنا وسجعنا؟

170
00:13:13,440 --> 00:13:19,020
،ألعب "كود آرت كي إيتشودي"، الوحش الشبح موسوزاكو
!والنجم الطبيعيّ آلفارد

171
00:13:16,560 --> 00:13:19,020
الوحش الشبح موسوزاكو

172
00:13:19,020 --> 00:13:22,290
تفعيل هجوم شامل، يفتح باب القتال كامل

173
00:13:27,930 --> 00:13:29,450
ننهي دورنا

174
00:13:29,450 --> 00:13:32,200
"حسناً، وقت دور "بلا حدود

175
00:13:32,410 --> 00:13:33,160
!سحب

176
00:13:39,060 --> 00:13:42,590
ألعب هانيل، وأضيف "سيغني" بمستوى
!اثنان أو أقل ليدي

177
00:13:42,590 --> 00:13:45,380
!ألعبها وأنهي دوري

178
00:13:45,580 --> 00:13:47,080
لا هجوم؟

179
00:13:47,080 --> 00:13:48,720
استراتيجيّة دفاعية إذاً

180
00:13:49,410 --> 00:13:55,560
هنالك قاعدة التزمتُ بها
دون التفكير بإمعان فيها

181
00:13:56,220 --> 00:13:58,900
إذا فعلتُ شيئاً في الماضي، فعليّ الاستمرار عليه

182
00:13:59,090 --> 00:14:00,900
إنّها تخلّ بإيقاعاتنا لكلّ دقيقة

183
00:14:00,900 --> 00:14:02,290
من الصعب مواجهة هذا

184
00:14:02,290 --> 00:14:05,030
ستكون معركةً طويلة إذاً، لندّخر الـ "إينر" خاصتنا

185
00:14:05,710 --> 00:14:08,270
حسناً، عليكِ بهنّ يا ولف

186
00:14:10,370 --> 00:14:11,180
نمو

187
00:14:18,320 --> 00:14:22,540
لكن، ربما كان ذلك ما أخبر
نفسي به فحسب

188
00:14:22,820 --> 00:14:26,260
!فهنالك طرق لا متناهية للقتال

189
00:14:29,430 --> 00:14:35,970
وضع أكينو في المركز يغيّر أسلوب
بلا حدود" الهجوميّ كثيراً"

190
00:14:36,220 --> 00:14:39,640
تعثّرت خطط "كارد جوكي" هكذا كثيراً

191
00:14:40,060 --> 00:14:43,520
ما الذي سيحصل الآن؟

192
00:14:47,730 --> 00:14:51,010
ستهاجمننا في النصف الثاني
من المعركة غالباً

193
00:14:51,010 --> 00:14:52,950
أيمكننا تغيير استراتيجيتنا قليلاً؟

194
00:14:52,950 --> 00:14:54,450
أجل، لا بأس

195
00:14:54,990 --> 00:14:56,930
هيرانا-تشان، أيمكنك النمو؟

196
00:14:56,930 --> 00:14:59,210
!حسناً! نمو

197
00:14:59,840 --> 00:15:01,880
!يطرد تأثير نموي موسوزاكو

198
00:15:04,770 --> 00:15:08,970
!ثمّ ألعب عقاباً... وهجوم

199
00:15:13,080 --> 00:15:17,490
عجباً! لديها توازن ممتاز
!بين الدفاع والهجوم

200
00:15:17,490 --> 00:15:19,600
!ستكون مواجهة هذا صعبة

201
00:15:19,800 --> 00:15:22,190
!يا للتبديل الاستراتيجيّ المبهر

202
00:15:22,650 --> 00:15:27,030
على الناس والاستراتيجيات التغيّر باستمرار

203
00:15:27,430 --> 00:15:32,860
لذا أنا ممتنة لكما كثيراً لمنحي هذه الفرصة

204
00:15:33,100 --> 00:15:34,320
...أكينو-تشان

205
00:15:34,560 --> 00:15:35,660
أكينو

206
00:15:39,430 --> 00:15:42,400
تبدو كمحترفة حقيقيّة

207
00:15:45,600 --> 00:15:46,460
!نمو

208
00:15:55,750 --> 00:15:56,930
!نمو

209
00:16:01,460 --> 00:16:05,370
!سأحطّم ثوب حياتك مباشرةً

210
00:16:10,130 --> 00:16:11,150
!أكينو-تشان

211
00:16:11,890 --> 00:16:14,020
لا أزال بخير

212
00:16:14,020 --> 00:16:17,540
أكينو، وقت الانتقال للذروة

213
00:16:17,540 --> 00:16:21,250
أجل، عليّ حسم النزال

214
00:16:22,100 --> 00:16:24,980
لا بأس بأدائها في المركز

215
00:16:24,980 --> 00:16:26,460
!كما يُتوقع من أ-تشان

216
00:16:27,480 --> 00:16:29,750
اصطنعتِ لها لقباً الآن؟

217
00:16:29,750 --> 00:16:32,220
هذه ظاهرة مثيرة للاهتمام

218
00:16:32,850 --> 00:16:36,470
دكتورة، أردتِ صديقات إذاً؟

219
00:16:36,470 --> 00:16:40,930
!ما-ما بكما؟ دعاني وشأني

220
00:16:41,170 --> 00:16:44,850
هذه معركة ممتازة من الطرفين

221
00:16:44,850 --> 00:16:46,560
،كارد جوكي" مبهرات"

222
00:16:46,870 --> 00:16:52,990
لكنّ معرفة أكينو الاستراتيجية
تؤتي بثمارها حقّاً

223
00:16:54,970 --> 00:16:58,180
!حسناً، وقت الذروة

224
00:17:33,170 --> 00:17:34,560
لا بأس

225
00:17:35,160 --> 00:17:39,570
مجموعتك هي الأفضل في العالم

226
00:17:39,810 --> 00:17:40,780
إنّها محقّة

227
00:17:41,250 --> 00:17:42,790
آمني بنا

228
00:17:43,140 --> 00:17:45,370
وآمني بنفسك

229
00:17:45,580 --> 00:17:46,630
!أجل

230
00:17:46,630 --> 00:17:48,580
نحن معك

231
00:17:55,690 --> 00:17:57,840
شكراً لكما

232
00:17:58,130 --> 00:18:00,920
!لم أعد خائفة

233
00:18:01,930 --> 00:18:04,400
!سأريكما قوّتي

234
00:18:05,110 --> 00:18:05,980
!نمو

235
00:18:13,700 --> 00:18:15,150
!تفعيل القطعة

236
00:18:20,180 --> 00:18:21,810
!يتفعّل تأثير نموي

237
00:18:21,810 --> 00:18:26,660
!ألقي خادمة من يدي، وأرجع اثنان "سيغني" ليد خصمي

238
00:18:28,020 --> 00:18:30,120
!هيرانا-تشان! ري-تشان

239
00:18:32,020 --> 00:18:33,560
!عجباً

240
00:18:33,730 --> 00:18:37,470
!ألقت بطاقة دفاعها لتفعيل تأثير

241
00:18:38,360 --> 00:18:39,290
!هذا سيّئ

242
00:18:39,290 --> 00:18:41,550
تهاجم كليّاً الآن؟

243
00:18:43,620 --> 00:18:45,420
!انطلاق للقمّة

244
00:19:05,010 --> 00:19:06,330
بلاءٌ حسن أيّها السراب

245
00:19:07,950 --> 00:19:10,160
عجباً! ما هذا؟

246
00:19:10,160 --> 00:19:13,290
لم تستطع "بلا حدود" إنهاء خصمهنّ

247
00:19:13,290 --> 00:19:14,710
لا يمكن

248
00:19:15,050 --> 00:19:17,590
حسناً، لم يعد لديكِ شيء، صحيح؟

249
00:19:17,590 --> 00:19:23,390
!دوري! ألعب ثلاثة "سيغني"، وأهاجم بكلّها

250
00:19:23,570 --> 00:19:25,380
!هذا سيّئ

251
00:19:25,380 --> 00:19:28,850
!اندفعت "بلا حدود" لهجوم كليّ

252
00:19:31,810 --> 00:19:32,810
!أكينو

253
00:19:31,810 --> 00:19:32,810
!أكينو-تشان

254
00:19:44,340 --> 00:19:48,080
!تنتهي المباراة بختامٍ مذهل

255
00:19:48,360 --> 00:19:51,990
!"الفائزات هنّ "كارد جوكي

256
00:19:57,510 --> 00:19:58,730
لا بأس

257
00:20:03,090 --> 00:20:04,270
...أكينو-تشان

258
00:20:05,200 --> 00:20:06,470
...أنا

259
00:20:07,440 --> 00:20:12,310
استمتعت كثيراً ببذل كلّ ما لديّ

260
00:20:13,530 --> 00:20:19,900
...لكن الخسارة... حقّاً... حقّاً

261
00:20:20,970 --> 00:20:23,860
...لطالما ظننت

262
00:20:24,700 --> 00:20:28,330
أنّ الفشل والخسارة محرجان

263
00:20:28,980 --> 00:20:30,220
لكنّي كنت مخطئة

264
00:20:33,380 --> 00:20:35,170
إنّهما محبطان

265
00:20:42,850 --> 00:20:47,930
!"الفائزات بـ"مغنّيات المستقبل"... "كارد جوكي

266
00:20:47,930 --> 00:20:53,760
وسيعرضن أغنيتهنّ الجديدة
!"في "وقت المغنّيات

267
00:20:53,760 --> 00:20:56,520
!لنستمع لها الآن

268
00:20:56,520 --> 00:20:58,400
"إيندليس بانشلاين"

269
00:21:01,720 --> 00:21:05,360
مرّت المسابقة بلمح البصر، أليس كذلك؟

270
00:21:05,600 --> 00:21:09,580
أجل، حدثت أمور كثيرة، لكنّها كانت ممتعة كثيراً

271
00:21:10,480 --> 00:21:13,090
صحيح، رغم أنّه كانت هناك متاعب

272
00:21:13,090 --> 00:21:15,350
...أجل، حقّاً

273
00:21:17,130 --> 00:21:19,820
!أنتِ من سبّبت المتاعب

274
00:21:19,820 --> 00:21:23,940
حسناً، لا بدّ من التكسير لإقامة الأشياء كما يُقال

275
00:21:23,940 --> 00:21:26,660
"تقصدين "التركيب لإقامة الأشياء

276
00:21:26,660 --> 00:21:28,120
ما خطبك؟

277
00:21:28,120 --> 00:21:31,370
وجّهتِ إصبعك نحوي! حتّى أبي
!لم يوجّه إصبعه نحوي قط

278
00:21:31,370 --> 00:21:32,370
ما معنى ذلك؟

279
00:21:32,370 --> 00:21:34,470
اسمعا، أيمكنني قول شيء؟

280
00:21:35,630 --> 00:21:38,560
أعتذر على كلّ المتاعب التي تسبّبت بها

281
00:21:40,650 --> 00:21:44,180
أنا أريد مواصلة القتال معكما

282
00:21:44,180 --> 00:21:48,220
!كما... سأبذل قصارى جهدي في عرضنا

283
00:21:50,500 --> 00:21:51,390
!أجل

284
00:22:01,250 --> 00:22:05,010
الحلقة 5