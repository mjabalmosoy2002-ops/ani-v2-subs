1
00:00:27,360 --> 00:00:32,940
...عشرون دقيقة إضافيّة
...عشرون دقيقة إضافيّة

2
00:00:32,940 --> 00:00:34,010
...عشرون دقيقة إضافيّة

3
00:02:11,010 --> 00:02:12,820
...في الأمس، قالت نيجيكا-تشان

4
00:02:13,220 --> 00:02:16,600
!لنتحدّث عن مستقبلنا كفرقة

5
00:02:16,600 --> 00:02:18,320
لنلتقِ في ستاري غداً، اتّفقنا؟

6
00:02:18,650 --> 00:02:23,660
أوصلَتْني بهجة تلقّي رسائل عبر "لوين" من
...شخص ليس من أقربائي إلى هذه الدّرجة، لكن

7
00:02:24,530 --> 00:02:26,690
،إذا دخلتُ إلى هناك بنفس مظهري المعتاد

8
00:02:26,690 --> 00:02:30,170
سيحدّق بي الجميع كما لو أنّني
...لا أنتمي إلى ذلك المكان

9
00:02:30,170 --> 00:02:34,170
نجوتُ في المرّة السّابقة لأنّني
...كنتُ رفقة نيجيكا-تشان، لكن

10
00:02:36,060 --> 00:02:38,050
أتساءل ما إن كان يوجد أحد هناك؟

11
00:02:41,070 --> 00:02:43,350
ليت يوجد شخص أدخل معه

12
00:02:44,720 --> 00:02:45,740
خمس دقائق

13
00:02:46,360 --> 00:02:48,890
سأنتظر خمس دقائق ثمّ أدخل

14
00:02:49,470 --> 00:02:51,570
...لا، عشرة

15
00:02:51,570 --> 00:02:52,590
خمسة عشر دقيقة

16
00:02:52,590 --> 00:02:54,320
سأدخل بعد خمسة عشر دقيقة حتماً

17
00:02:56,920 --> 00:02:58,680
ماذا تفعل؟

18
00:02:58,680 --> 00:02:59,130
—بو

19
00:02:59,130 --> 00:02:59,990
انتظري

20
00:03:00,480 --> 00:03:02,030
أريد المُراقبة فترة أطول

21
00:03:02,030 --> 00:03:04,120
هلّا توقّفتِ عن الاستمتاع بهذا رجاء؟

22
00:03:06,150 --> 00:03:06,700
!حسناً

23
00:03:06,700 --> 00:03:11,570
أعلن هنا عن أوّل اجتماع لأعضاء
!فرقة كيسّوكو... افتح

24
00:03:11,570 --> 00:03:12,400
!تصفيق حارّ

25
00:03:12,400 --> 00:03:14,980
!صفقة صفقة صفقة صفقة

26
00:03:14,980 --> 00:03:16,710
...حسناً، لنرَ

27
00:03:17,940 --> 00:03:21,830
لحظة. بالكاد نعرف بعضنا الآخر، لذا
!لا أعرف عمّاذا أتحدّث

28
00:03:21,830 --> 00:03:23,470
!اعترفَتْ بذلك للتو

29
00:03:23,790 --> 00:03:26,650
أحضرتُ هذه لمثل هذه المُناسبة

30
00:03:26,650 --> 00:03:27,980
!جميلة

31
00:03:27,980 --> 00:03:30,980
...لا أظنّ أنّ مظهرها يروقني

32
00:03:31,210 --> 00:03:31,840
!مهلاً

33
00:03:31,840 --> 00:03:34,910
ماذا سيظهر عندما تتدحرج؟
ماذا سيظهر عندما تتدحرج؟

34
00:03:37,850 --> 00:03:39,320
!الحديث عن المدرسة

35
00:03:39,600 --> 00:03:41,380
!ح.ع.م كاختصار

36
00:03:41,380 --> 00:03:42,320
واصِلي

37
00:03:44,160 --> 00:03:49,000
...المعذرة... لحظة، ألا ترتادان نفس المدرسة

38
00:03:49,000 --> 00:03:50,800
!أجل، ثانويّة شيما

39
00:03:50,800 --> 00:03:52,960
اخترناها لأنّها قريبة من المنزل

40
00:03:52,960 --> 00:03:55,590
...إذاً تقيمين في شيمو-كيتازاوا

41
00:03:55,590 --> 00:03:58,250
ماذا؟ بوتشي-تشان، ألا ترتادين ثانويّة شوكا؟

42
00:03:58,250 --> 00:04:00,210
ألا ينبغي أن تقيمي في الأرجاء هنا أيضاً؟

43
00:04:00,210 --> 00:04:03,910
لا، أعيش خارج المُحافظة. سفر لمدّة
ساعتين ذهاباً فقط

44
00:04:03,910 --> 00:04:04,680
!ساعتان؟

45
00:04:04,680 --> 00:04:05,430
لماذا؟

46
00:04:05,840 --> 00:04:09,840
أردتُ مدرسة ثانويّة حيث لا يعرف أحد ماضيّي

47
00:04:09,840 --> 00:04:11,600
!حسناً يكفي ح.ع.م

48
00:04:11,600 --> 00:04:13,490
...آ-آسفة

49
00:04:13,490 --> 00:04:16,550
،قضيتُ معظم وقتي في المدرسة وحيدة

50
00:04:16,550 --> 00:04:20,520
...لذا لا أملك أ-أيّ روايات طريفة أحكيها

51
00:04:20,520 --> 00:04:21,610
!لا عليكِ

52
00:04:21,610 --> 00:04:24,150
ريو لا تملك صديقات كُثُر أيضاً

53
00:04:24,150 --> 00:04:26,170
أجل، نيجيكا فقط

54
00:04:26,170 --> 00:04:27,490
!يا للمفاجأة

55
00:04:28,310 --> 00:04:32,180
...ريو-سان مثلي تماماً

56
00:04:32,680 --> 00:04:35,790
في أيّام العطلة، تُمارس الاستكشاف الحضَريّ

57
00:04:35,790 --> 00:04:37,960
...وتزور متاجر الملابس المُستعملة

58
00:04:37,960 --> 00:04:39,040
...لا، إنّها ليست

59
00:04:39,720 --> 00:04:42,550
!تحبّ ريو-سان الوحدة

60
00:04:44,720 --> 00:04:47,430
مُحال لشخص يُعاني من قلق اجتماعي
!أن يدخل متجر ملابس بمفرده

61
00:04:47,860 --> 00:04:53,740
الفجوة بين "لوحدها" و "وحيدة" عميق جدّاً
!وواسع لا يمكن تجاوزه

62
00:04:55,470 --> 00:04:58,030
كدتُ أسقط في الفخّ

63
00:04:58,030 --> 00:04:58,730
،بوتشي-تشان

64
00:04:58,730 --> 00:05:00,070
!لنستمتع بالمحادثة

65
00:05:02,940 --> 00:05:05,570
!فيما يلي، سوف نتحدّث عن موسيقانا المُفضّلة

66
00:05:05,570 --> 00:05:07,030
...كاختصار

67
00:05:07,030 --> 00:05:08,240
!ح.ع.م.م

68
00:05:08,240 --> 00:05:09,660
...حـ-ح.ع.م.م

69
00:05:10,030 --> 00:05:14,200
أحبّ البانك اليابانيّ مثل ميلّو كور

70
00:05:14,200 --> 00:05:16,540
،أحبّ تيكنو كايو

71
00:05:16,540 --> 00:05:19,710
ومؤخّراً كنتُ أتفقّد أعلى مبيعات
—أغاني السّعوديّة العربيّة

72
00:05:18,260 --> 00:05:19,710
!أشياء حقيقيّة فقط من فضلك

73
00:05:19,710 --> 00:05:20,800
ما أقوله حقيقيّ

74
00:05:20,800 --> 00:05:21,840
بوتشي-تشان؟

75
00:05:21,840 --> 00:05:23,960
...المعذرة

76
00:05:23,960 --> 00:05:28,940
أحبّ أيّ أغنية لا تحفّز عقدة سيشون خاصّتي

77
00:05:28,940 --> 00:05:31,540
عقدة سيشون"؟"

78
00:05:31,540 --> 00:05:33,100
!اسمحي لي بالشّرح

79
00:05:33,350 --> 00:05:36,480
الأغاني التي تحفّز عقدة سيشون لدى هيتوري

80
00:05:36,480 --> 00:05:38,960
هي أغانٍ تفاؤليّة برّاقة تشمل كلمات مثل

81
00:05:38,960 --> 00:05:44,020
"صيف"، "بحر أزرق"، "ألعاب ناريّة"، "حبّ مُراهَقة"

82
00:05:44,020 --> 00:05:47,860
!وأشياء أخرى لا علاقة لها بتجربتها المدرسيّة الشخصيّة

83
00:05:48,990 --> 00:05:51,970
تُغرِقُني مثل هذه الكلمات في بحر من الكآبة

84
00:05:49,800 --> 00:05:51,300
بوتشي-تشان؟

85
00:05:51,970 --> 00:05:52,680
،بشكل مُماثل

86
00:05:52,680 --> 00:05:56,950
تحبّين الفِرق الّتي تتحدّث عن كآبة وسوداويّة
سنواتهم في المدرسة الثانويّة، صحيح؟

87
00:05:55,530 --> 00:05:56,950
...أنت

88
00:05:56,950 --> 00:05:58,320
!أجل

89
00:05:58,320 --> 00:06:03,360
لكن أحياناً أكتشف بأنّ الفِرقة التي أحبّها
،مشهورة جدّاً في المدرسة

90
00:06:03,360 --> 00:06:07,470
...فيُصبِح أعضاؤها غُرباء فجأة بالنسبة لي

91
00:06:06,130 --> 00:06:10,450
!من فضلك! عودي إلى كوكبنا من فضلك

92
00:06:10,450 --> 00:06:13,830
الرّوك هو موسيقى تُلائم المُستضعفين دوماً

93
00:06:13,830 --> 00:06:16,080
هل تكون روك حقّاً إذا أدّاها النّاجحون في الحياة؟

94
00:06:16,080 --> 00:06:18,180
!أحاول تشكيل بعض الرّوابط هنا

95
00:06:18,180 --> 00:06:19,760
"بما أنّنا سُمِّينا تيمُّناً بـ"ربطة السحَّاب

96
00:06:20,640 --> 00:06:21,730
...المعذرة

97
00:06:22,220 --> 00:06:24,240
،كان حفلنا الأوّل عِبارة عن آلات موسيقيّة فقط

98
00:06:24,240 --> 00:06:26,200
لكن أحبّذ إضافة الغِناء في المرّة المقبلة

99
00:06:26,200 --> 00:06:27,900
حقّاً؟

100
00:06:27,900 --> 00:06:31,410
عازِفة القيثارة التي هربَتْ كانت
...ستكون مُغنّيتنا، لكن

101
00:06:31,780 --> 00:06:33,880
إلى أين ذهبتْ على أيّ حال؟

102
00:06:35,320 --> 00:06:37,410
...عازِفة القيثارة الهاربة

103
00:06:38,480 --> 00:06:41,340
ربّما تُعاني من قلق اجتماعي مثلي

104
00:06:42,420 --> 00:06:43,860
!لا، هذا غير ممكن

105
00:06:43,860 --> 00:06:46,920
،إن كنتِ تُعانين من قلق اجتماعيّ حقّاً
!لا يمكنك الهرب حتّى

106
00:06:46,920 --> 00:06:49,860
علينا إيجاد مُغنّية جديدة

107
00:06:49,860 --> 00:06:52,080
لا أجيد الغِناء بالمُطلَق

108
00:06:52,080 --> 00:06:53,470
—بوتشي-تشان، هل يمكنك

109
00:06:55,280 --> 00:06:56,720
أجل... توقّعت

110
00:06:56,720 --> 00:06:59,060
المعذرة... ما-ماذا عن ريو-سان؟

111
00:07:00,730 --> 00:07:02,260
،إذا أدّيتُ وظيفة المُغنِّية الرّئيسيّة

112
00:07:02,260 --> 00:07:05,300
فسوف أهيمن على الفِرقة وأسحقها

113
00:07:05,300 --> 00:07:07,440
من أين تستمدّين هذه الثّقة التي لا تنضب؟

114
00:07:07,730 --> 00:07:09,040
أغار كثيراً

115
00:07:09,040 --> 00:07:11,130
...ليتني أتمتّع بقليل من هذه الثّقة

116
00:07:11,130 --> 00:07:12,210
!وجدتُها

117
00:07:12,210 --> 00:07:14,720
!لنبحث عن مُغنّية ونؤلّف أغنية

118
00:07:14,720 --> 00:07:16,150
،تستطيع ريو تأليف اللّحن

119
00:07:16,150 --> 00:07:19,500
وإذا كان لديكِ كلمات خارج المألوف
!يا بوتشي-تشان، ينبغي أن تؤلّفي الكلمات

120
00:07:20,500 --> 00:07:21,330
!أنا؟

121
00:07:21,330 --> 00:07:23,040
ما رأيكِ؟ فكرة ممتازة، صحيح؟

122
00:07:23,040 --> 00:07:27,240
السّنوات التّسعة من استراحات الغداء
...الّتي قضيتُها في مكتبات المدرسة

123
00:07:27,240 --> 00:07:29,300
كانت كلّها تحضيراً لهذه اللّحظة؟

124
00:07:29,300 --> 00:07:30,860
حسناً، ماذا ستفعلين يا نيجيكا؟

125
00:07:33,170 --> 00:07:33,860
!هيّا

126
00:07:35,630 --> 00:07:38,100
!فيما يلي، الحديث عن الحصص

127
00:07:38,100 --> 00:07:39,600
تحاشَتْ ذلك بشكل فاضح

128
00:07:40,020 --> 00:07:43,090
المعذرة... ما هي الحصص؟

129
00:07:43,090 --> 00:07:46,150
الحفل الّذي أدّيناه في الأمس يُدعى
"بـ"الحفل الموسيقي المحجوز

130
00:07:46,430 --> 00:07:49,440
إنّه حيث يخصّص النّادي حصّة تذاكر للفِرقة

131
00:07:49,440 --> 00:07:51,650
للحرص على مجيء ما يكفي من أشخاص

132
00:07:51,650 --> 00:07:52,850
!حصّتك هي عشر تذاكر

133
00:07:59,310 --> 00:08:03,620
أيّ تذكرة تُباع زيادة عن الحصّة يتمّ
...تقاسمها بين النّادي والفِرقة

134
00:08:08,400 --> 00:08:10,560
،لكن إن لم تستطع الفِرقة تأمين ما يكفي لاستيفاء الحصّة

135
00:08:10,560 --> 00:08:13,760
يجب عليها تسديد الباقي من جيبها

136
00:08:13,760 --> 00:08:16,180
لذا سيكون الأمر بمثابة بالوعة
مال إذا لم تكن الفِرقة مشهورة

137
00:08:16,180 --> 00:08:17,720
!هذا مُقتضَب جدّاً

138
00:08:17,720 --> 00:08:21,490
،أتت مجموعة من صديقاتي إلى حفل الأمس

139
00:08:21,490 --> 00:08:23,580
...لذا تمكنّا من استيفاء حصّتنا، لكن

140
00:08:23,580 --> 00:08:25,910
بعد ذلك الأداء، لن يعُدنَ غالباً

141
00:08:25,910 --> 00:08:27,730
!معكِ حقّ

142
00:08:27,730 --> 00:08:31,110
...وريو ليس لديها أصدقاء، لذا لن تكون مُفيدة

143
00:08:31,110 --> 00:08:32,850
—بوتشي-تشان، هل

144
00:08:33,300 --> 00:08:35,360
آسفة! انسي ما قلتُه

145
00:08:35,360 --> 00:08:37,120
!فقط تخلّصي من هذه النّظرة الميّتة رجاء

146
00:08:37,720 --> 00:08:40,840
...لديّ كثير من الأصدقاء التخيّليّين، لكن

147
00:08:40,840 --> 00:08:42,480
!أنتِ مذهلة يا هيتوري-تشان

148
00:08:42,480 --> 00:08:44,370
!كنز وطنيّ حيّ

149
00:08:44,370 --> 00:08:48,600
على أيّ حال، بما أنّنا سنحتاج لعشرات
،الآلاف من الأموال لحفلنا المُقبل

150
00:08:48,600 --> 00:08:52,120
!لنحصل على أعمال لتغطية الحصّة ونفقات التّجهيزات

151
00:08:53,720 --> 00:08:54,380
حسناً

152
00:08:54,910 --> 00:08:55,880
!أعمال؟

153
00:08:56,310 --> 00:08:57,760
هذه أوّل مرّة أسمع صوتكِ بهذا العلوّ

154
00:08:58,050 --> 00:08:59,700
لا

155
00:08:59,700 --> 00:09:01,280
!لا أريد أن أعمل. هذا مُخيف جدّاً

156
00:09:01,280 --> 00:09:02,770
!المُجتمع مُخيف جدّاً

157
00:09:06,340 --> 00:09:07,230
حصّالة خنزير؟

158
00:09:08,040 --> 00:09:12,900
...كـ-كانت أمّي تدّخر المال لأجل زفافي

159
00:09:12,900 --> 00:09:14,400
لكن يمكنكما الحصول عليه

160
00:09:14,400 --> 00:09:16,100
...فقط... أرجوكما، إلّا العمل

161
00:09:16,100 --> 00:09:18,670
!لا تعاملينا وكأنّنا سيّئتان

162
00:09:16,520 --> 00:09:19,390
—شكراً، سوف نتولّى الأمر

163
00:09:18,670 --> 00:09:19,960
!لن نأخذه

164
00:09:19,960 --> 00:09:22,540
!لا يمكننا أخذ مال يعني لكِ الكثير

165
00:09:24,510 --> 00:09:25,200
...لكن

166
00:09:25,200 --> 00:09:26,720
!لا أريد العمل

167
00:09:26,720 --> 00:09:28,040
...لأنّ

168
00:09:29,860 --> 00:09:33,550
عـ-على الرّحب... هـ-هل ينبغي أن أسـ... ـخّنه؟

169
00:09:31,730 --> 00:09:33,550
...سيكون الأمر بهذا الشّكل حرفيّاً

170
00:09:35,360 --> 00:09:38,930
عـ-على الرّحب... هـ-هل ينبغي أن أسـ... ـخّنه؟

171
00:09:37,620 --> 00:09:38,930
...ثمّ

172
00:09:39,430 --> 00:09:42,190
،لارتكابها جريمة إخافة الزبائن

173
00:09:42,190 --> 00:09:43,770
!نُطالب بعقوبة الإعدام

174
00:09:44,000 --> 00:09:46,280
...حسناً، سأنطق الآن بالحكم

175
00:09:46,280 --> 00:09:47,290
!إعدام

176
00:09:47,690 --> 00:09:50,190
!ثمّ هذا

177
00:09:50,720 --> 00:09:52,770
بوتشي-تشان

178
00:09:52,770 --> 00:09:53,960
!بوتشي-تشان

179
00:09:55,240 --> 00:09:58,040
لم تكوني تسمعين، أليس كذلك؟

180
00:09:58,040 --> 00:09:59,300
!آ-آسفة

181
00:09:59,300 --> 00:10:01,070
ما-ماذا كنتِ تقولين؟

182
00:10:01,800 --> 00:10:04,030
ينبغي أن تعملي هنا معنا

183
00:10:04,030 --> 00:10:05,110
هنا؟

184
00:10:05,880 --> 00:10:07,080
!ماذا؟

185
00:10:07,080 --> 00:10:09,840
!لن يكون عليكِ الخوف إذا كنتِ معي ومع ريو

186
00:10:09,840 --> 00:10:12,750
إنّه مكان ملائم للعمل وجوّه عائلي

187
00:10:13,700 --> 00:10:17,760
يمكننا تقديم المشروب والتّنظيف ورؤية
!مُختلف أشكال الفِرق الغنائيّة

188
00:10:15,320 --> 00:10:17,760
...لا أريد العمل... لا أريد العمل

189
00:10:17,760 --> 00:10:19,760
حسناً؟ ما رأيكِ؟

190
00:10:22,630 --> 00:10:24,350
!قولي لا يا فتاة

191
00:10:24,350 --> 00:10:25,100
!قولي لا

192
00:10:25,320 --> 00:10:27,980
!عليكِ أن تقولي لا

193
00:10:29,090 --> 00:10:30,270
...سأفعل ما بوسعي

194
00:10:30,270 --> 00:10:31,810
!حقّاً؟ شكراً جزيلاً لكِ

195
00:10:32,070 --> 00:10:33,310
...آسفة يا فتاة

196
00:10:32,070 --> 00:10:35,170
!سيكون العمل أمتع إذا كنّا جميعنا معاً

197
00:10:33,310 --> 00:10:36,070
لن يكون قلقاً اجتماعيّاً إذا تحلّينا
بالشّجاعة وقلنا لا

198
00:10:36,680 --> 00:10:39,630
سأدير أموال الفِرقة إذاً

199
00:10:40,150 --> 00:10:43,400
المعذرة... ألن يكون من الأفضل جعل
ريو-سان تفعل ذلك؟

200
00:10:43,400 --> 00:10:44,580
!ما معنى هذا؟

201
00:10:45,270 --> 00:10:47,000
اسمعي يا بوتشي-تشان

202
00:10:47,000 --> 00:10:50,140
صدّقي أو لا تصدّقي، ريو مُنفِقة مُسرِفة جدّاً

203
00:10:51,040 --> 00:10:54,100
،عائلتها ثريّة وتحصل على مصروف جيب كبير

204
00:10:54,100 --> 00:10:56,710
،لكن تُنفقه كلّه على الآلات الموسيقيّة
لذا تجدينها مُفلِسة دوماً

205
00:10:57,880 --> 00:10:58,650
خجلانة

206
00:10:58,650 --> 00:11:00,680
ما الجزئيّة في كلامي اعتبرتِها مديحاً؟

207
00:11:01,660 --> 00:11:05,240
على أيّ حال، لنعمل بجدّ كي نتمكّن
!من الأداء على الهواء ثانية عمّا قريب

208
00:11:05,240 --> 00:11:08,230
!إذاً ستكون إطلالتنا الرئيسيّة الأولى في المدرسة الثّانويّة

209
00:11:08,740 --> 00:11:10,360
!سنبدأ العمل في الأسبوع المقبل

210
00:11:10,360 --> 00:11:12,560
!تعالي إلى هنا مباشرة بعد دوام المدرسة

211
00:11:12,560 --> 00:11:14,440
بوتشي. وداعاً

212
00:11:14,440 --> 00:11:15,800
...حـ-حسناً

213
00:11:17,270 --> 00:11:21,440
واليوم الأوّل من العمل يبدأ غداً

214
00:11:22,850 --> 00:11:25,090
مضى على وجودي هنا ثلاثون دقيقة الآن

215
00:11:25,090 --> 00:11:27,470
غالباً سأُصاب بنزلة برد، صحيح؟

216
00:11:27,470 --> 00:11:29,320
...أنا آسفة... أنا آسفة

217
00:11:29,320 --> 00:11:31,670
سأعمل بجدّ في كلّ شيء باستثناء العمل

218
00:11:32,730 --> 00:11:36,090
!أمّي! أختي تغرق

219
00:11:40,200 --> 00:11:43,360
!سأُصابُ بنزلة برد! سأُصابُ بنزلة برد
!سأُصابُ بنزلة برد! سأُصابُ بنزلة برد

220
00:11:43,360 --> 00:11:47,260
!سأُصابُ بنزلة برد

221
00:11:54,420 --> 00:11:56,610
...اللّعنة على صحّتي السّليمة هذه

222
00:11:57,280 --> 00:12:00,020
—إذاً سأضطرّ للتظاهر بأنّني

223
00:12:04,270 --> 00:12:05,490
نيجيكا-تشان؟

224
00:12:05,490 --> 00:12:06,510
!صباح الخير

225
00:12:06,510 --> 00:12:08,210
اليوم الأوّل من العمل، صحيح؟

226
00:12:08,210 --> 00:12:10,350
!أعلم بأنّكِ متوتّرة، لكن سننتظركِ هناك

227
00:12:10,350 --> 00:12:11,410
!لنعمل بجدّ معاً

228
00:12:12,610 --> 00:12:17,790
ليس عدلاً أن تكون لطيفة بينما
...أحاول النّفور من العمل

229
00:12:23,510 --> 00:12:26,800
جعلتِني أدرك أسلوبي الخاطئ الأخرق

230
00:12:26,800 --> 00:12:31,730
أنا ممتنّة لكِ بلا حدود لأنّكِ جعلتِني امرأة صادقة

231
00:12:33,640 --> 00:12:35,080
عمّاذا تتكلّم؟

232
00:12:38,490 --> 00:12:39,780
أنا هنا

233
00:12:42,020 --> 00:12:46,500
!افعليها يا بوتشي

234
00:12:46,500 --> 00:12:48,740
لا تُطرَح التّذاكر للبيع قبل السّاعة الخامسة

235
00:12:50,390 --> 00:12:51,910
ما زلنا نتجهّز هنا

236
00:12:51,910 --> 00:12:53,620
!تعمل هنا؟

237
00:12:53,620 --> 00:12:54,940
...تعتقد بأنّني أنوي شرّاً

238
00:12:54,940 --> 00:12:56,650
!يجب عليّ تبرئة نفسي

239
00:12:58,820 --> 00:13:02,170
...ا-ا-ا-ا-اهدئي

240
00:13:02,170 --> 00:13:04,130
أنتِ من عليه أن يهدأ

241
00:13:04,730 --> 00:13:06,530
أنتِ العامِلة الجديدة بدوام جزئي إذاً؟

242
00:13:06,530 --> 00:13:08,150
كان ينبغي أن تقولي ذلك

243
00:13:08,150 --> 00:13:09,600
!آ-آ-آ-آ-آسفة

244
00:13:09,820 --> 00:13:12,600
أنا المُديرة هنا. سررتُ بلقائكِ

245
00:13:12,960 --> 00:13:15,200
...سـ-سررتُ جدّاً بلقائكِ

246
00:13:15,200 --> 00:13:17,350
المُديرة مُخيفة

247
00:13:17,350 --> 00:13:18,940
لا أستطيع التّعامل مع أمثالها

248
00:13:18,940 --> 00:13:20,250
!نيجيكا-تشان، تعالي إلى هنا بسرعة

249
00:13:20,250 --> 00:13:24,800
مهلاً، أنتِ عازفة القيثارة الّتي عزفتِ داخل الصّندوق

250
00:13:24,800 --> 00:13:28,070
هل كان... منجا كامِن؟

251
00:13:28,070 --> 00:13:29,700
لقب جديد؟

252
00:13:30,210 --> 00:13:31,880
!أحبّكِ يا مُديرة

253
00:13:31,880 --> 00:13:34,540
!أ-أنا منجا كامِن

254
00:13:34,540 --> 00:13:36,920
!هذا ليس اسمها

255
00:13:36,920 --> 00:13:40,120
!لا تمنحيها ألقاباً غريبة يا أختي

256
00:13:40,120 --> 00:13:41,200
!أختي؟

257
00:13:41,200 --> 00:13:42,880
أنتِ أخت نيجيكا-تشان؟

258
00:13:42,880 --> 00:13:44,520
أخبرتُكِ سابقاً

259
00:13:44,520 --> 00:13:46,490
عندما أتيتِ أوّل مرّة إلى ستاري، أنسيتِ؟

260
00:13:47,350 --> 00:13:51,080
النّادي الّذي سنعزف فيه يدعى ستاري

261
00:13:51,080 --> 00:13:54,100
أختي الكبرى هي المديرة هناك

262
00:13:54,100 --> 00:13:57,600
في الواقع، تقطن عائلتنا في الشّقق فوق

263
00:13:58,150 --> 00:14:00,610
كان قلبي بنبض بشكل صاخب لدرجة
أنّني لم أسمعها

264
00:14:00,610 --> 00:14:02,570
حـ-حـ-حـ-حقّاً؟

265
00:14:02,570 --> 00:14:06,210
هذا يعني أنّه ليس عليكِ أن تكوني متوتّرة

266
00:14:06,210 --> 00:14:07,690
أليس كذلك يا أختي؟

267
00:14:07,690 --> 00:14:09,280
ناديني "المديرة" هنا

268
00:14:09,760 --> 00:14:12,180
واحرصي على الفصل بين عملنا وعلاقاتنا الشخصيّة

269
00:14:12,640 --> 00:14:15,480
!لا تُخيفيها هكذا

270
00:14:16,140 --> 00:14:19,290
حسناً، لننظّف الطاولات أوّلاً

271
00:14:19,290 --> 00:14:21,810
...عندما ننتهي، سنمسح الأرض

272
00:14:22,340 --> 00:14:24,240
ماذا؟ اين بوتشي-تشان؟

273
00:14:26,090 --> 00:14:30,450
آسفة. احتجتُ مُتنفَّساً في مكان مُظلم وضيّق

274
00:14:30,450 --> 00:14:31,720
!تحتاجين مُتنفَّساً من الآن؟

275
00:14:32,650 --> 00:14:36,490
هيّا يا بوتشي-تشان، تعالي وتعرّفي على المشروبات

276
00:14:37,440 --> 00:14:39,680
،ماء التونيك يُوضع هنا

277
00:14:39,680 --> 00:14:42,000
وتخرج البيرة من هذه الآلة

278
00:14:42,000 --> 00:14:43,940
...والكوكتيل في الرفّ الخلفيّ

279
00:14:44,560 --> 00:14:45,910
!لـ-لن أتذكّر كلّ ذلك

280
00:14:45,910 --> 00:14:46,590
!سريعة للغاية

281
00:14:46,590 --> 00:14:49,650
...أنا فقط... مـ

282
00:14:51,210 --> 00:14:54,360
!يجب أن أدمج المعرفة مع نفسي من خلال أغنية

283
00:14:54,360 --> 00:14:55,990
!ماذا تفعلين فجأة؟

284
00:14:55,990 --> 00:14:59,130
!الكوكتيل في الرفّ أقصى اليمين

285
00:14:58,300 --> 00:14:59,560
!أنتِ تُخيفينني

286
00:14:59,130 --> 00:15:01,010
!تيكيلا

287
00:14:59,130 --> 00:15:01,010
يبدو أنّهما مُستمتعتان

288
00:14:59,560 --> 00:15:01,840
،يسرّني أنّكِ تتعلّمين المشروبات

289
00:15:01,010 --> 00:15:02,500
!فودكا

290
00:15:01,840 --> 00:15:04,000
لكن لمَ لا تضعين القيثارة جانباً؟

291
00:15:02,500 --> 00:15:03,400
!كاهلو

292
00:15:03,400 --> 00:15:04,500
!روم

293
00:15:04,850 --> 00:15:07,300
أنتِ، هل تسمعينني؟

294
00:15:04,850 --> 00:15:09,220
...غريب... بدَتْ سيّئة بعض الشيء في الحفل، لكن

295
00:15:07,300 --> 00:15:09,220
!لا تسمعينني، صحيح؟

296
00:15:09,220 --> 00:15:10,940
إنّها ماهرة

297
00:15:09,220 --> 00:15:12,880
!أنتِ تُخيفينني بجدّية

298
00:15:11,960 --> 00:15:15,630
...تحاول نيجيكا جهدها لإيقافها، لكن لا أظنّها تشعر بذلك

299
00:15:12,880 --> 00:15:15,630
!أ-أرجوك! عودي إلينا

300
00:15:15,630 --> 00:15:18,220
!هيتوري-تشان

301
00:15:15,630 --> 00:15:18,220
لكن كأنّني سمعتُ هذا الصّوت في مكان ما

302
00:15:19,350 --> 00:15:20,810
!ابدئي بالعمل

303
00:15:20,810 --> 00:15:21,960
!لماذا أنا؟

304
00:15:22,520 --> 00:15:26,940
لخدمة المشروب، فقط اسكبي المشروب
الّذي يطلبونه وسلّميه

305
00:15:26,940 --> 00:15:27,920
...حـ-حاضرة

306
00:15:27,920 --> 00:15:30,860
يمكنهم تسديد 500 ين فوق سعر التّذكرة

307
00:15:30,860 --> 00:15:32,950
للحصول على تذكرة مشروب

308
00:15:32,950 --> 00:15:35,380
‏500 ين مقابل كلّ مشروب؟

309
00:15:35,380 --> 00:15:38,220
لماذا نظام التّذاكر للحصول على مشروب؟

310
00:15:38,220 --> 00:15:41,080
كفّي عن التّحديق كما لو أنّ الأمر غريب عليكِ تماماً

311
00:15:41,560 --> 00:15:45,080
إنّ مثل هذه النّوادي يمكن اعتبارها مطاعم في الواقع

312
00:15:45,530 --> 00:15:47,350
،لا أعرف كلّ التفاصيل

313
00:15:51,840 --> 00:15:53,640
!هـ... هكذا إذاً

314
00:15:53,640 --> 00:15:58,760
لذا نقدّم المشروب ونعمل كمطعم

315
00:15:59,520 --> 00:16:01,220
هل تسمعينني؟

316
00:16:01,220 --> 00:16:04,120
!ا-العمل في مطعم هو شيء مُتقدّم

317
00:16:04,120 --> 00:16:06,900
!لا أصدّق بأنّني تجاوزتُ هذا المعيار بهذه السّرعة

318
00:16:06,900 --> 00:16:10,300
!هل هذا... نموّ شخصيّ؟

319
00:16:11,120 --> 00:16:14,820
!زبائن من الآن

320
00:16:14,820 --> 00:16:17,280
!نحن على وشك أن ننشغل يا بوتشي-تشان

321
00:16:17,280 --> 00:16:17,940
ماذا؟

322
00:16:19,330 --> 00:16:22,040
!لحظة... خدمة زبائن من الآن؟

323
00:16:22,040 --> 00:16:23,650
!ماذا أقول؟

324
00:16:23,650 --> 00:16:26,290
"...شكراً لك على نسبِك الملَكيّ"

325
00:16:26,290 --> 00:16:27,280
!كلّا

326
00:16:27,280 --> 00:16:29,680
!فـ-فقط درّبيني تدريباً عمليّاً أرجوكِ

327
00:16:29,680 --> 00:16:31,800
!لـ-لا، لحظة! يكفي

328
00:16:33,370 --> 00:16:34,800
!أغلقَت المكان

329
00:16:35,570 --> 00:16:37,300
!المعذرة! كولا واحدة من فضلك

330
00:16:37,300 --> 00:16:40,820
!في الحال

331
00:16:38,490 --> 00:16:39,600
!بوتشي-تشان، كولا

332
00:16:42,280 --> 00:16:43,650
أريد جعّة زنجبيل

333
00:16:43,650 --> 00:16:44,310
!في الحال

334
00:16:45,810 --> 00:16:48,280
!بوتشي-تشان، أظهري بعض الاحترام للزبائن

335
00:16:48,280 --> 00:16:50,450
!لـ-لـ-لكن لستُ جاهزة

336
00:16:50,450 --> 00:16:53,980
بدأنا نفقدُ الظّلام الأصيل الّذي يتمتّع به النّادي

337
00:16:54,620 --> 00:16:57,000
واحد أولونغ وواحد خمر مع مياه غازيّة

338
00:16:57,000 --> 00:16:58,160
أين دورة المياه؟

339
00:16:58,760 --> 00:17:00,790
!في آخر القاعة على يمينك، الباب في النّاحية اليسرى

340
00:17:00,790 --> 00:17:03,720
لم أخضع لأيّ نموّ شخصيّ

341
00:17:03,720 --> 00:17:05,290
!بوتشي-تشان، انظري

342
00:17:06,040 --> 00:17:07,760
!ها هُم

343
00:17:08,790 --> 00:17:11,740
!مرحباً! نحن أليكسانديزم

344
00:17:12,300 --> 00:17:15,360
،طُرِحَ ألبومنا الثّاني في الأسواق اليوم

345
00:17:12,720 --> 00:17:15,360
إنّهم رائعون جدّاً

346
00:17:15,360 --> 00:17:17,640
،لذا عدنا لأداء الحفلات الموسيقيّة

347
00:17:16,500 --> 00:17:18,600
إنّه وقت مناسب للاسترخاء

348
00:17:17,640 --> 00:17:19,400
!لكن آمل أن تشتروا الألبوم

349
00:17:18,600 --> 00:17:20,760
حالما يبدأ الأداء، سيكون لدينا وقت فراغ

350
00:17:19,400 --> 00:17:22,310
!شكراً

351
00:17:20,760 --> 00:17:21,400
...أجل

352
00:17:21,400 --> 00:17:22,310
!أحسنتُما عملاً

353
00:17:22,310 --> 00:17:23,250
!أحسنتِ عملاً

354
00:17:22,310 --> 00:17:26,880
،حاولنا جعل كلّ أغنية أفضل من أغاني ألبومنا الأوّل

355
00:17:23,250 --> 00:17:24,600
أليس عليكِ بيع التّذاكر؟

356
00:17:24,600 --> 00:17:26,880
تولّت المُديرة العمل عنّي

357
00:17:26,880 --> 00:17:29,120
،كلّ فِرق اليوم مشهورة حقّاً

358
00:17:26,880 --> 00:17:31,020
وإن لم تشتروا الألبوم بعد، فنحن على
،وشك عزف بعض من تلك الأغاني

359
00:17:29,120 --> 00:17:31,020
لذا طلبَتْ منّي أن أراقب وأتعلّم

360
00:17:31,020 --> 00:17:33,110
هذا هو طبع أختي المُعتاد

361
00:17:31,020 --> 00:17:34,250
!لذا إذا حازت على إعجابكم، اشتروا الألبوم رجاء

362
00:17:33,110 --> 00:17:36,360
...إنّها تسون-تسون-تسون-تسون-تسون

363
00:17:34,250 --> 00:17:38,230
وثمّة أمر أودّ أن أخبركم به أوّلاً

364
00:17:36,360 --> 00:17:38,230
ديري. أليس كذلك؟

365
00:17:38,230 --> 00:17:39,300
فائض من تسون

366
00:17:38,230 --> 00:17:41,440
!هزّ الجمهور المكان في حفلنا السّابق

367
00:17:39,880 --> 00:17:41,440
...آ-آ-آسفة

368
00:17:41,440 --> 00:17:43,430
،لم أفشل في مُساعدتكن فحسب

369
00:17:41,440 --> 00:17:45,710
لذا بعد أن انتهى الحفل، تقدّم شخص وأبرز بطاقته

370
00:17:43,430 --> 00:17:45,710
بل لم أستطع النّظر في وجه الزبائن أيضاً

371
00:17:45,710 --> 00:17:47,070
أتريدين هذا؟

372
00:17:45,710 --> 00:17:50,590
وكنّا متوتّرين جدّاً. وقلنا لأنفسنا "هل حان
"الوقت لإطلالتنا الرئيسيّة الأولى؟

373
00:17:47,730 --> 00:17:49,230
آسفة لأنّه ليس للمنجا

374
00:17:49,230 --> 00:17:50,590
لا، شكراً لكِ

375
00:17:50,590 --> 00:17:52,620
،لكن سنبدو سخيفين إذا أظهرنا ذلك في تعابيرنا

376
00:17:52,620 --> 00:17:53,670
!أنتِ تبلين حسناً

377
00:17:52,620 --> 00:17:56,510
"لذا قلنا فقط "أهلاً، على الرّحب

378
00:17:53,910 --> 00:17:56,510
!فهو يومكِ الأوّل. ستعتادين على ذلك

379
00:17:56,510 --> 00:17:57,930
"على الرّحب؟"

380
00:17:57,930 --> 00:18:01,230
العادات مُخيفة أحياناً

381
00:17:57,930 --> 00:18:03,850
لـ-لماذا أنتِ لطيفة جدّاً مع برغوث ماء ثانوي مثلي؟

382
00:18:01,230 --> 00:18:03,850
الكلمات التي تصدر من فمي

383
00:18:03,850 --> 00:18:08,140
كانت الكلمات التي قلتُها مليون مرّة
في عملي الّذي كان بدوام جزئي

384
00:18:06,740 --> 00:18:07,770
...في الواقع

385
00:18:08,430 --> 00:18:10,880
أحبّ هذا النّادي حقّاً

386
00:18:08,430 --> 00:18:10,880
،وفقاً للرجل الّذي أبرز لنا بطاقته

387
00:18:10,880 --> 00:18:16,440
لكن هنا ومكتب الاستقبال هما المكانان الوحيدان
،الّذين يستطيع طاقم النّادي التّفاعل فيه مع الزبائن

388
00:18:10,880 --> 00:18:16,440
،أراد الاستماع إلى الفِرقة التي بعدنا اليوم، تيدامان

389
00:18:17,400 --> 00:18:21,830
لذا أريد أن أبذل قصارى جهدي لأجعل الآخرين يحبّونه أيضاً

390
00:18:17,400 --> 00:18:21,830
،لكنّنا لا ننسجم معهم، ونريد حقّاً أن نتفوّق عليهم

391
00:18:21,830 --> 00:18:24,800
!لذا نأمل أن تستمعوا إلى أليكسانديزم أيضاً

392
00:18:22,290 --> 00:18:24,210
أ-أ-أنا آسفة جدّاً

393
00:18:24,210 --> 00:18:26,360
عـ-عملتُ بشكل سيّئ في مكان يعني لكِ الكثير

394
00:18:26,360 --> 00:18:27,750
لا، لا

395
00:18:26,360 --> 00:18:29,560
!والآن لنقدّم الفرقة

396
00:18:27,750 --> 00:18:29,560
ليس هذا ما قصدت

397
00:18:29,560 --> 00:18:33,750
قصدتُ بأنّني أريدكِ أن تحبّي هذا
النّادي أيضاً يا بوتشي-تشان

398
00:18:29,560 --> 00:18:33,750
الّذي يأكل الكاري دوماً قبل كلّ حفل وبطريقته
الخاصّة في فعل الأمور، على آلة البيس، ماتسودا

399
00:18:33,750 --> 00:18:37,620
!والشّخص الطبيعيّ الّذي يدعمنا دوماً... على الطبل، ري

400
00:18:35,740 --> 00:18:37,620
،اريدنا أن نستمتع ونحن نعمل

401
00:18:37,620 --> 00:18:39,450
وأن نستمتع ونحن نلعب

402
00:18:37,620 --> 00:18:43,360
لديه الكثير من دوّاسات المؤثّرات الّتي بالكاد يتّسع
المسرح لها... على القيثارة، كويتشي

403
00:18:39,890 --> 00:18:40,680
سوية

404
00:18:44,870 --> 00:18:49,170
وبالطبع آمل أيضاً أن تتمكّني من التكلّم مع
لزبائن بابتسامة يوماً ما أيضاً

405
00:18:44,870 --> 00:18:49,170
!وعلى القيثارة والغناء، والغنيّ عن التّعريف... أنا

406
00:18:49,170 --> 00:18:50,300
!تسويوشي

407
00:18:50,300 --> 00:18:51,190
!لنفعل هذا

408
00:18:51,760 --> 00:18:53,110
!بدأت يا بوتشي-تشان

409
00:19:02,140 --> 00:19:04,440
المكان كلّه مُوحَّد

410
00:19:04,440 --> 00:19:07,120
الزبائن والمُؤدّون كلّهم يستمتعون معاً

411
00:19:08,070 --> 00:19:10,840
...بينما في حفلي الموسيقي

412
00:19:11,880 --> 00:19:15,460
سدّدَ الزبائن 2000 ين لرؤية هذا، أليس كذلك؟

413
00:19:16,460 --> 00:19:18,370
،إذا بقيتُ كما أنا

414
00:19:18,370 --> 00:19:23,640
فسوف أقدّم لهم نفس الحفل البارد
في المرّة المقبلة أيضاً، أليس كذلك؟

415
00:19:25,810 --> 00:19:29,010
،أريد بذل جهد للتغيّر حتّى ولو كان ذلك تدريجيّاً

416
00:19:29,010 --> 00:19:31,100
وأستمتع بذلك مع بقيّتهم

417
00:19:31,100 --> 00:19:32,400
!المعذرة

418
00:19:32,400 --> 00:19:33,740
عصير برتقال

419
00:19:33,740 --> 00:19:34,930
...فـ-في الحال

420
00:19:47,500 --> 00:19:51,710
انظري إلى عينَي الزبونة. تفاعلي

421
00:19:53,270 --> 00:19:54,460
!ابتسمي

422
00:19:55,440 --> 00:19:57,780
!انظري في عينيها

423
00:19:57,780 --> 00:19:58,960
!تفاعلي

424
00:20:00,160 --> 00:20:01,970
تـ-تفضّلي

425
00:20:02,280 --> 00:20:04,600
!بوتشي-تشان! عيناكِ! عيناكِ

426
00:20:04,600 --> 00:20:05,700
!شكراً

427
00:20:07,800 --> 00:20:10,440
!كان ذلك مُتلِفاً للأعصاب

428
00:20:10,440 --> 00:20:11,550
!لكن أحسنتِ صنعاً

429
00:20:11,550 --> 00:20:14,460
!أبقيتِ رأسكِ مرفوعاً فوق الطاولة وتكلّمتِ معها

430
00:20:15,330 --> 00:20:16,500
!بذلتُ قصارى جهدي

431
00:20:16,500 --> 00:20:17,070
!أجل

432
00:20:17,410 --> 00:20:22,450
وجودكِ هنا سيجعل ذكرياتي عن
حفل اليوم أكثر متعة حتّى

433
00:20:22,450 --> 00:20:25,450
وقد خطوتِ خطوة للأمام

434
00:20:27,170 --> 00:20:28,310
...خطوة

435
00:20:32,200 --> 00:20:33,250
خطوة

436
00:20:37,160 --> 00:20:38,840
!خطوة؟

437
00:20:38,840 --> 00:20:42,220
!لكن أشعر وكأنّني خطوتُ ألف خطوة

438
00:20:47,350 --> 00:20:48,990
أحسنتِ صنعاً اليوم

439
00:20:48,990 --> 00:20:50,210
رافقتكِ السّلامة إلى المنزل

440
00:20:50,210 --> 00:20:50,930
وداعاً

441
00:20:50,930 --> 00:20:52,630
شـ-شكراً على استضافتي

442
00:20:52,630 --> 00:20:54,620
لن تغادري يا ريو؟

443
00:20:54,620 --> 00:20:56,370
سأبقى قليلاً

444
00:20:56,370 --> 00:20:57,360
!بوتشي-تشان

445
00:20:57,360 --> 00:20:58,440
!نـ-نعم؟

446
00:20:58,900 --> 00:20:59,890
!إلى اللّقاء

447
00:20:59,890 --> 00:21:03,440
!أ-أجل، أ-أ-أراكُنّ غداً

448
00:21:06,200 --> 00:21:08,240
!انتهى

449
00:21:08,240 --> 00:21:10,480
!قضيتُ يوماً كاملاً بشكل ما

450
00:21:10,480 --> 00:21:13,410
!هذا العمل ليس صعباً كنتُ أظنّه أن يكون

451
00:21:13,410 --> 00:21:15,460
!سأبذل قصارى جهدي ثانية غداً

452
00:21:16,060 --> 00:21:17,080
!هاتشو

453
00:21:19,610 --> 00:21:21,860
عمِلَتْ بوتشي بجدّ، صحيح؟

454
00:21:22,350 --> 00:21:23,380
أجل

455
00:21:23,600 --> 00:21:27,120
"!وتمكّنَتْ من قول "أراكُن غداً

456
00:21:27,120 --> 00:21:27,770
أجل

457
00:21:28,660 --> 00:21:31,260
أنا مسرورة لأنّنا أسّسنا هذه الفرقة

458
00:21:32,010 --> 00:21:33,000
!على ذكر الأمر

459
00:21:33,000 --> 00:21:34,520
لنُرسِل رسالة "لوين" إلى بوتشي-تشان

460
00:21:34,520 --> 00:21:36,500
"!سأقول، "لنثابِر على ذلك غداً

461
00:21:40,250 --> 00:21:41,960
أصيبَتْ بحمّى شديدة

462
00:21:41,960 --> 00:21:44,340
عزيزي، حضّر لها كمّادة باردة

463
00:21:44,340 --> 00:21:45,880
هل نحن بحاجة لنقلها إلى المشفى؟

464
00:21:45,880 --> 00:21:48,540
...أصِبتُ بحُمّى الآن

465
00:21:49,880 --> 00:21:53,250
...الآن ضممنا بوتشي-تشان إلى فرقتنا

466
00:21:53,250 --> 00:21:54,870
...كلّ ما بقي

467
00:21:54,870 --> 00:21:57,430
!هو البحث عن مُغنِّية جديدة

468
00:21:59,290 --> 00:22:00,560
لِمَن هذا؟

469
00:22:00,560 --> 00:22:03,540
!أنا، أنا! إنّها أنا، إنّها أنا

470
00:23:38,550 --> 00:23:39,780
!شاهدوها