1
00:00:12,850 --> 00:00:16,050
!بيكّوري-مان

2
00:00:16,500 --> 00:00:18,030
!لا تقتربوا

3
00:00:18,400 --> 00:00:24,990
!بيكّوري-مان

4
00:00:44,000 --> 00:00:47,330
(بيكّوري-مان)

5
00:01:56,880 --> 00:01:58,380
(الحلقة 4: لا بيكّوري، لا حياة)

6
00:01:58,550 --> 00:02:00,720
.انظر، إنّها جزرة

7
00:02:01,260 --> 00:02:03,100
هل أنتَ جائع؟

8
00:02:03,770 --> 00:02:04,600
ماذا؟

9
00:02:04,720 --> 00:02:06,600
.قطّةٌ وسُلحفاة

10
00:02:06,930 --> 00:02:08,850
هل تحبّ الحيوانات لهذه الدرجة؟

11
00:02:09,060 --> 00:02:11,060
.وجدتُها في ملابسي

12
00:02:12,020 --> 00:02:13,480
.قد تكون ضائعة

13
00:02:14,230 --> 00:02:15,740
.لا يمكنني تركها وشأنها

14
00:02:17,780 --> 00:02:19,240
،لا بأس في ذلك

15
00:02:19,570 --> 00:02:22,490
.لكن احرص ألا ينقضّ عليها أسود

16
00:02:22,580 --> 00:02:23,530
.حسناً

17
00:02:31,040 --> 00:02:32,920
(متجر الملاك)

18
00:02:33,880 --> 00:02:35,630
!حصلتُ عليها أخيراً

19
00:02:35,630 --> 00:02:37,420
.أوّل إصدارٍ من النسخة المُعاد نشرها

20
00:02:38,260 --> 00:02:41,390
.بعد أن قرأتُ الخبر على الإنترنت، ذهبتُ إلى الكثير من المتاجر

21
00:02:41,680 --> 00:02:42,970
،بعد كلّ هذا التعب

22
00:02:43,010 --> 00:02:45,390
.أشعر أنّي سأحصل على مُلصقٍ نادر

23
00:02:45,850 --> 00:02:47,680
.أفهم شعورك

24
00:02:47,890 --> 00:02:49,810
لهذا أتيتُ بمجرّد ما أخبرني ياماتو

25
00:02:49,810 --> 00:02:51,850
.بخصوص فتح التغليف

26
00:02:52,150 --> 00:02:54,480
!هيّا، افتحها بسرعة

27
00:02:55,360 --> 00:02:56,440
.افتحها في المنزل

28
00:02:56,570 --> 00:02:59,110
لا تقل ذلك. تريد رؤيتها أنتَ أيضاً، أليس كذلك؟

29
00:02:59,200 --> 00:03:01,910
.لحظة حصولي على زيوس الخارق

30
00:03:02,070 --> 00:03:03,370
.أجل. أريد رؤيتها

31
00:03:03,530 --> 00:03:06,540
.أريد رؤية اللحظة التي ستحصل فيها على مُلصقٍ مُكرّر

32
00:03:06,540 --> 00:03:07,830
!ابتعد

33
00:03:08,330 --> 00:03:09,830
.أسرع وافتحها

34
00:03:12,000 --> 00:03:14,750
!تعال يا زيوس الخارق

35
00:03:17,590 --> 00:03:18,800
(صلاة الكاهن)

36
00:03:19,050 --> 00:03:20,840
.إنّه مكرّر

37
00:03:20,880 --> 00:03:23,300
هل البسكويت المُبلّل بالدموع لذيذ؟

38
00:03:25,640 --> 00:03:26,640
.تبّاً

39
00:03:27,220 --> 00:03:28,180
...ألا يوجد

40
00:03:28,470 --> 00:03:31,390
ألا يوجد مكانٌ آخر لأشتريها منه؟

41
00:03:32,350 --> 00:03:33,980
.أعرف مكاناً

42
00:03:34,730 --> 00:03:37,900
.حصلتُ على هذه المعلومات من أخي

43
00:03:38,780 --> 00:03:41,530
هل تعرف شارع التسوّق الرئيسي في مدينة فوكّورو؟

44
00:03:41,860 --> 00:03:45,200
إنّه الشارع الذي يرتاده الأجانب، أليس كذلك؟

45
00:03:46,410 --> 00:03:48,740
.يوجد متجر ملابسٍ هناك

46
00:03:48,740 --> 00:03:50,580
.سمعتُ أنّكَ تستطيع شراء شوكولا بيكّوري-مان من عنده

47
00:03:50,710 --> 00:03:51,660
حقّاً؟

48
00:03:51,750 --> 00:03:53,710
.مدينة فوكّورو ليست بعيدة

49
00:03:54,210 --> 00:03:55,000
،ولكن

50
00:03:55,170 --> 00:03:56,880
،حتّى هذه اللحظة

51
00:03:56,880 --> 00:03:59,260
.لم يستطع أحدٌ شراء شوكولا بيكّوري-مان من هناك

52
00:04:00,800 --> 00:04:01,880
ما معنى ذلك؟

53
00:04:02,220 --> 00:04:04,510
.لا أعرف التفاصيل أنا أيضاً

54
00:04:04,720 --> 00:04:07,510
لكن قال أخي

55
00:04:07,510 --> 00:04:09,770
.إنّه أخطر مكانٍ لشراء الشوكولا

56
00:04:10,310 --> 00:04:12,690
،لم أسمع نصيحة أخي آخر مرّة

57
00:04:12,690 --> 00:04:15,270
.لذا يؤسفني القول إنّي لا أستطيع الذهاب معكم

58
00:04:15,610 --> 00:04:17,110
.رغم أنّي أريد الذهاب حقّاً

59
00:04:17,690 --> 00:04:18,650
.فهمت

60
00:04:18,980 --> 00:04:21,900
.يوجد كنوزٌ مُخبّئةٌ هناك

61
00:04:22,070 --> 00:04:23,820
...جاك... مُستحيل

62
00:04:24,360 --> 00:04:25,820
.يجب عليّ الذهاب

63
00:04:26,030 --> 00:04:28,740
.طالما كانت توجد شوكولا بيكّوري-مان هناك

64
00:04:29,540 --> 00:04:32,620
.أنتَ عظيمٌ مثل جاك ابن السماء

65
00:04:32,620 --> 00:04:33,540
.نوعاً ما

66
00:04:33,620 --> 00:04:35,960
!أتمنّى لكَ حظّاً موفّقاً يا صديقي

67
00:04:36,080 --> 00:04:37,630
.بيكّوري-مان

68
00:04:40,420 --> 00:04:41,260
.تفضّل

69
00:04:41,840 --> 00:04:43,260
!سأذهب

70
00:04:45,550 --> 00:04:48,430
محطّة فوكّورو

71
00:04:49,010 --> 00:04:50,100
.جاك

72
00:04:52,140 --> 00:04:54,270
تريد الحصول عليها أنتَ أيضاً، صحيح؟

73
00:04:54,270 --> 00:04:55,350
.بيكّوري-مان

74
00:04:56,230 --> 00:04:57,310
ما الذي كنتَ تنظر إليه؟

75
00:04:57,560 --> 00:04:58,310
.ذلك

76
00:05:00,730 --> 00:05:02,940
.يمتلك ذلك الشخص غيتاراً جميلاً

77
00:05:03,280 --> 00:05:04,150
غيتار؟

78
00:05:05,030 --> 00:05:07,070
هل تعزف الغيتار أيضاً يا جاك؟

79
00:05:08,530 --> 00:05:10,950
.إنّها هوايةٌ مُحبّبةٌ إلي بقدر جمع مُلصقات بيكّوري-مان

80
00:05:12,160 --> 00:05:13,790
هل أنتَ عضوٌ في فرقة؟

81
00:05:13,830 --> 00:05:14,910
.كلا

82
00:05:15,290 --> 00:05:17,580
.أردتُ أن أصبح مشهوراً، لذا حاولتُ الانضمام لفرقة

83
00:05:17,750 --> 00:05:20,960
.لكن كان الأعضاء الآخرون أكثر وسامةً منّي، لذا تركتُها

84
00:05:22,630 --> 00:05:24,300
كيف شكل المتجر الذين سنذهب إليه؟

85
00:05:24,510 --> 00:05:26,880
.يقولون إنّه متجر ملابس يبيع بيكّوري-مان

86
00:05:27,510 --> 00:05:30,510
.من يدري؟ لنذهب ونتفقّده على أيّ حال

87
00:05:37,190 --> 00:05:38,690
هيب هوب فوكّورو

88
00:05:38,900 --> 00:05:40,480
.مـ-مخيف

89
00:05:40,520 --> 00:05:42,650
أ-أهذا المكان الذي ذكره تاكايان؟

90
00:05:43,190 --> 00:05:45,820
مرحباً يا أخي، كيف الحال؟

91
00:05:46,530 --> 00:05:47,990
.إنجليزيّة! تولّى الأمر يا جاك

92
00:05:48,030 --> 00:05:49,660
،وُلِدتُ في إنجلترا

93
00:05:49,700 --> 00:05:52,660
.لكنّي نشأتُ في مدينة بيكّوري، لذا لا أتحدّث الإنجليزيّة

94
00:05:52,830 --> 00:05:54,120
حقّاً؟

95
00:05:54,500 --> 00:05:55,500
كيف الحال؟

96
00:05:55,500 --> 00:05:56,660
تريد شراء ملابس؟

97
00:05:56,710 --> 00:05:57,870
.تعال واشترِ بعضها

98
00:05:58,000 --> 00:05:59,380
.لا

99
00:05:59,500 --> 00:06:01,420
.أتينا لشراء بيكّوري-مان

100
00:06:01,500 --> 00:06:03,840
!هذه مدينة فوكّورو

101
00:06:03,880 --> 00:06:06,550
.لنشترِ الملابس اليوم

102
00:06:06,550 --> 00:06:10,510
.لا، لا. بيكّوري-مان! مُلصقٌ لامع

103
00:06:10,550 --> 00:06:11,760
.انظر يا جاك

104
00:06:14,100 --> 00:06:15,980
!ذاك! ذاك! من فضلك

105
00:06:16,020 --> 00:06:17,100
،حسناً، على أيّ حال

106
00:06:17,180 --> 00:06:19,020
.لدينا الكثير من الأشياء الجيّدة هنا

107
00:06:19,020 --> 00:06:20,190
هل تريد رؤيتها؟

108
00:06:20,400 --> 00:06:21,520
.تعال، ألقِ نظرة

109
00:06:21,610 --> 00:06:23,900
.دعني أختر الملابس التي تناسبُك

110
00:06:24,280 --> 00:06:26,070
.أجل

111
00:06:26,280 --> 00:06:27,360
!حسناً

112
00:06:27,400 --> 00:06:30,240
هل فهمتَ ما يقصدانه يا جاك؟

113
00:06:30,240 --> 00:06:31,820
.حسناً يا أخي

114
00:06:31,820 --> 00:06:33,660
.لدينا أحذيةٌ رائعة

115
00:06:33,700 --> 00:06:35,660
.وملابسٌ مميّزة

116
00:06:35,660 --> 00:06:37,710
.عندما تشتري ملابس، نُصبح أخوة

117
00:06:37,750 --> 00:06:40,040
.أهلاً، أهلاً

118
00:06:40,040 --> 00:06:43,460
!لدينا زبائن

119
00:06:47,380 --> 00:06:49,220
هيب هوب فوكّورو

120
00:06:49,550 --> 00:06:50,890
.غبيّان

121
00:06:54,140 --> 00:06:55,060
.لا فائدة

122
00:06:55,140 --> 00:06:56,810
.لا يمكننا التواصل معهما

123
00:06:56,930 --> 00:06:59,060
.كدتُ أشتري بعض الملابس

124
00:07:00,520 --> 00:07:03,310
كانوا سيأخذون جميع مدّخراتي من العمل

125
00:07:03,400 --> 00:07:05,520
.من أجل شراء بيكّوري-مان

126
00:07:05,980 --> 00:07:07,070
،بالنظر إلى وضعك

127
00:07:07,070 --> 00:07:09,450
.يبدو أنّكَ لم تشترِ بيكّوري-مان

128
00:07:09,900 --> 00:07:11,990
يوشيواكا؟ ما الذي تفعله هنا؟

129
00:07:12,410 --> 00:07:14,870
.أتيتُ لشراء كعكة الأرزّ اللزجة الشهيرة في مدينة فوكّورو

130
00:07:15,080 --> 00:07:17,040
هل تقصد إنّكَ التقيتَ بنا صُدفةً؟

131
00:07:17,540 --> 00:07:19,750
وهل هناك أيّ سببٍ آخر برأيك؟

132
00:07:20,040 --> 00:07:22,330
...الأهمّ من ذلك، بخصوص بيكّوري-مان

133
00:07:23,960 --> 00:07:24,920
تاكايان

134
00:07:25,630 --> 00:07:27,920
ما الخطب؟-
هل جاك بخير؟-

135
00:07:30,050 --> 00:07:32,800
.كاد أن يشتري بعض الملابس

136
00:07:32,890 --> 00:07:34,220
هل تأخّر الوقت؟

137
00:07:34,680 --> 00:07:38,020
.وصلتني معلوماتٌ جديدةٌ من أخي للتو

138
00:07:38,680 --> 00:07:40,270
تاكايان

139
00:07:38,680 --> 00:07:40,270
على ما يبدو

140
00:07:40,270 --> 00:07:43,730
صاحب المتجر العجوز هو الوحيد الذي يعرف بشأن شعبيّة بيكّوري-مان

141
00:07:43,810 --> 00:07:46,230
.واشترى بعضاً منها لكي يجذب الزبائن

142
00:07:46,650 --> 00:07:48,570
المعجبون الذين سمعوا بهذه الأخبار

143
00:07:48,570 --> 00:07:51,860
،توافدوا على المتجر بالطبع

144
00:07:52,110 --> 00:07:54,820
.لكن يبدو أنّ البائعين الشباب لا يعرفون هذا

145
00:07:55,160 --> 00:07:55,990
،ونتيجةً لذلك

146
00:07:56,080 --> 00:07:59,660
انجرف الجميع وراء حماس البائعين، أليس كذلك؟

147
00:07:59,750 --> 00:08:00,830
.تماماً

148
00:08:00,870 --> 00:08:03,290
سمعتُ أنّ بعض الناس

149
00:08:03,290 --> 00:08:05,500
.قد اشتروا طقماً كاملاً من السلسلة بي

150
00:08:06,000 --> 00:08:07,090
.مُستحيل

151
00:08:07,750 --> 00:08:08,670
،جاك

152
00:08:09,090 --> 00:08:12,550
.بصفتي مُحبّاً لبيكّوري-مان مثلك، دعني أسدي نصيحةً لك

153
00:08:13,050 --> 00:08:15,680
.لا تفكّر حتّى في شراء بيكّوري-مان من ذلك المتجر

154
00:08:16,140 --> 00:08:17,810
ماذا سنفعل؟

155
00:08:18,220 --> 00:08:20,470
.ما سنفعله واضحٌ جدّاً

156
00:08:21,270 --> 00:08:23,390
.الكنز أمام أعيننا

157
00:08:24,150 --> 00:08:26,900
.ونحن نحبّ بيكّوري-مان كثيراً

158
00:08:27,270 --> 00:08:29,280
.كلّ ما علينا فعله هو التعبير عن ذلك الحبّ لهم

159
00:08:30,570 --> 00:08:34,070
،إذا كنتَ مُحبّاً لبيكّوري-مان مثلي يا تاكايان

160
00:08:34,320 --> 00:08:35,320
.تمنّى نجاحي

161
00:08:35,780 --> 00:08:39,370
.وحصولي على زيوس الخارق

162
00:08:39,580 --> 00:08:40,540
.جاك

163
00:08:41,080 --> 00:08:43,830
.أنتَ عظيمٌ مثل جاك ابن السماء

164
00:08:44,750 --> 00:08:46,290
.لن أوقفكَ بعد الآن إذاً

165
00:08:46,500 --> 00:08:48,290
.سأترك الباقي لكَ يا ياماتو

166
00:08:48,290 --> 00:08:51,710
ماذا؟ انتظر! ما الذي ستتركه لي؟

167
00:08:51,710 --> 00:08:52,800
.حظّاً موفّقاً

168
00:08:54,340 --> 00:08:55,760
ما الذي تركه لي؟

169
00:08:58,970 --> 00:09:00,390
.بيكّوري-مان

170
00:09:00,770 --> 00:09:01,680
!ذهب

171
00:09:02,220 --> 00:09:04,020
هـ-هل سيكون بخير؟

172
00:09:04,350 --> 00:09:05,140
.لا أعرف

173
00:09:08,230 --> 00:09:09,650
!لا فائدة

174
00:09:09,650 --> 00:09:11,570
.اشترى ملابساً من المتجر

175
00:09:14,700 --> 00:09:17,320
.مُدخّراتي لشراء بيكّوري-مان

176
00:09:17,780 --> 00:09:20,490
إنّها تناسبكَ تماماً، أليس كذلك يا يوشيواكا؟

177
00:09:22,700 --> 00:09:24,370
هل تحاول مواساتي؟

178
00:09:24,830 --> 00:09:27,290
.كعكة الأرزّ اللزجة المُبلّلة بالدموع لذيذة

179
00:09:28,630 --> 00:09:30,000
.يوشيواكا

180
00:09:30,040 --> 00:09:32,800
!لذيذة! أعطِني المزيد-
.في أحلامك-

181
00:09:35,260 --> 00:09:37,090
ماذا سنفعل تالياً؟

182
00:09:38,260 --> 00:09:41,680
سيستمعون إليّ إذا أصبحتُ زبوناً دائماً، أليس كذلك؟

183
00:09:41,930 --> 00:09:45,230
.ستنفد مُدخراتُكَ قبل تحقيق ذلك

184
00:09:46,600 --> 00:09:47,600
.هذا صحيح

185
00:09:48,020 --> 00:09:50,820
.حاجز اللغة مرتفعٌ جدّاً

186
00:09:57,240 --> 00:09:58,660
حفلة؟

187
00:09:58,780 --> 00:10:00,240
.رائعٌ جدّاً

188
00:10:00,490 --> 00:10:01,410
!وجدتُها

189
00:10:02,540 --> 00:10:04,290
...إذا لم نستطع التواصل بالكلمات

190
00:10:04,580 --> 00:10:06,370
(متجر الملاك)

191
00:10:07,710 --> 00:10:08,710
!سنستخدم الموسيقى

192
00:10:08,750 --> 00:10:11,840
هل عُدتَ إلى المنزل لقول ذلك فقط؟

193
00:10:11,960 --> 00:10:12,670
.بالطبع

194
00:10:12,750 --> 00:10:14,550
!يا له من مُغفّلٍ أحمق

195
00:10:16,760 --> 00:10:18,970
(الإلهة أواشيس)

196
00:10:19,590 --> 00:10:22,010
(جاك ابن السماء)

197
00:10:24,600 --> 00:10:25,680
.فهمت

198
00:10:26,230 --> 00:10:28,270
سيستخدم الموسيقى للتواصل مع البائعين

199
00:10:28,270 --> 00:10:31,860
.من أجل شراء بيكّوري-مان

200
00:10:32,230 --> 00:10:33,820
ما معنى ذلك؟

201
00:10:34,190 --> 00:10:35,480
.من الصعب فهم ذلك حقّاً

202
00:10:36,440 --> 00:10:38,820
.لكنّ جاك جادٌّ في ذلك

203
00:10:39,450 --> 00:10:42,070
،قال إنّه سيعود إلى المتجر في الأسبوع القادم

204
00:10:42,780 --> 00:10:44,580
.وبدأ بالتجهّز من أجل ذلك بالفعل

205
00:10:45,830 --> 00:10:49,000
.حبّ جاك لبيكّوري-مان استثنائيٌّ للغاية

206
00:10:49,420 --> 00:10:51,580
.هذا ينطبق عليّ أيضاً

207
00:10:53,790 --> 00:10:55,630
(متجر الملاك)

208
00:10:56,050 --> 00:10:57,840
.لا يوجد شيءٌ كما توقعت

209
00:10:58,420 --> 00:11:01,220
.نفدت البضاعة في جميع المتاجر الآن

210
00:11:01,720 --> 00:11:04,350
.طلبتُ كميّاتٍ إضافيّةٍ بالفعل. لذا تحلّى بالصبر

211
00:11:04,510 --> 00:11:06,140
أتحلّى بالصبر؟

212
00:11:06,560 --> 00:11:09,270
.يبدو أنّ جاك-كن يعاني من وقتٍ عصيب

213
00:11:09,690 --> 00:11:11,480
كنتُ أحاول الحصول على المزيد منها

214
00:11:11,480 --> 00:11:13,060
.لأجله

215
00:11:14,230 --> 00:11:15,730
هل جاك مُتغيّبٌ اليوم؟

216
00:11:16,280 --> 00:11:17,610
،إنّه في استراحةٍ الآن

217
00:11:17,940 --> 00:11:19,280
.يمكنكَ إيجاده عند الباب الخلفي

218
00:11:29,370 --> 00:11:30,160
.جاك

219
00:11:31,290 --> 00:11:32,830
.تفضل

220
00:11:33,040 --> 00:11:34,340
حقّاً؟

221
00:11:38,420 --> 00:11:39,760
.لذيذة

222
00:11:39,920 --> 00:11:41,220
.كثيرة العصير

223
00:11:41,510 --> 00:11:42,510
.هلا سمحتَ لي بسؤال

224
00:11:44,180 --> 00:11:45,640
قال المدير إنّنا سنحصل عليها

225
00:11:46,310 --> 00:11:48,470
.لذا يجب علينا التحلّي بالصبر

226
00:11:48,970 --> 00:11:51,810
.لا داعي لكي تشتريها من ذلك المتجر

227
00:11:52,390 --> 00:11:55,440
.لم يعد هدفي شراء الشوكولا فحسب

228
00:11:57,270 --> 00:12:00,780
.لقد وُلِدتُ في إنجلترا ولكنّي نشأتُ في مدينة بيكّوري

229
00:12:01,570 --> 00:12:04,160
أبدو رائعاً للوهلة الأولى، أليس كذلك؟

230
00:12:04,280 --> 00:12:05,740
.أ-أجل

231
00:12:06,120 --> 00:12:07,410
،لهذا

232
00:12:07,990 --> 00:12:09,450
،عندما كنتُ في المرحلة الابتدائيّة

233
00:12:09,580 --> 00:12:13,250
،لم يرغب الآخرون بالاقتراب منّي

234
00:12:14,330 --> 00:12:16,210
.ولم أملك أيّ أصدقاء

235
00:12:16,630 --> 00:12:18,880
.هذا ما أنقذني آنذاك

236
00:12:20,050 --> 00:12:21,050
ما هذا؟

237
00:12:21,970 --> 00:12:23,760
.بـ-بيكّوري-مان

238
00:12:24,180 --> 00:12:26,640
!مذهل! إنّه يلمع

239
00:12:26,850 --> 00:12:28,140
!رائعٌ جدّاً

240
00:12:28,140 --> 00:12:29,600
.دعنا نرى

241
00:12:31,100 --> 00:12:32,180
!بالتأكيد

242
00:12:41,110 --> 00:12:43,860
ألا تعتقد أنّه من الجميل

243
00:12:44,240 --> 00:12:46,030
فهم الآخرين لما تحبّه؟

244
00:12:47,160 --> 00:12:47,950
أرأيت؟

245
00:12:48,370 --> 00:12:52,080
.لذا أعتقد أنّ أولئك البائعين يفكّرون بنفس الطريقة

246
00:12:52,370 --> 00:12:53,120
نفس الطريقة؟

247
00:12:54,000 --> 00:12:56,460
هم أيضاً يريدون أن يُحِبَّ الآخرون

248
00:12:56,750 --> 00:12:58,290
.الملابس والأحذية التي يحبّونها

249
00:12:59,590 --> 00:13:01,880
لذا أريد منهم

250
00:13:02,760 --> 00:13:03,840
.فهم مُبتغاي

251
00:13:06,760 --> 00:13:07,470
.فهمت

252
00:13:14,560 --> 00:13:16,650
.أتساءل إذا كان لا يحبّ الملفوف

253
00:13:18,110 --> 00:13:18,980
.حان الوقت

254
00:13:19,730 --> 00:13:21,780
.أريد قطعةً واحدةً من دجاج الملاك رجاءً

255
00:13:22,070 --> 00:13:24,450
.سأعطيكِ واحدةً أخرى لأنّكِ لطيفةٌ جدّاً

256
00:13:24,570 --> 00:13:26,110
هل تريدين الأكل معي يا أختي؟

257
00:13:27,030 --> 00:13:28,620
.سأخصم ثمنها من مُرتّبكِ

258
00:13:27,030 --> 00:13:28,620
(دجاج الملاك)

259
00:13:34,960 --> 00:13:35,870
.حسناً

260
00:13:41,380 --> 00:13:42,880
هل ستذهب أيضاً يا يوشيواكا؟

261
00:13:43,630 --> 00:13:45,880
.ستحتاجان شخصاً لتنظيف الفوضى التي ستُحدثانها

262
00:13:46,680 --> 00:13:47,510
.فهمت

263
00:13:48,140 --> 00:13:49,550
.انتهى دوامي

264
00:13:49,550 --> 00:13:51,220
!أحسنتَ عملاً-
!أحسنتَ عملاً-

265
00:13:51,560 --> 00:13:52,720
.آسفٌ على التأخّر

266
00:13:56,230 --> 00:13:57,190
!لننطلق

267
00:13:57,480 --> 00:13:59,230
.أخرجها فحسب

268
00:14:00,190 --> 00:14:02,110
.لا بدّ أنّكَ تملك بيكّوري-مان

269
00:14:02,270 --> 00:14:04,320
.سلّمنا جميع المُلصقات اللامعة

270
00:14:04,400 --> 00:14:06,030
.مزعجون

271
00:14:06,450 --> 00:14:07,450
!ذلك الشخص

272
00:14:10,120 --> 00:14:11,530
.تمتلك الكثير من الشجاعة

273
00:14:11,530 --> 00:14:12,870
.علينا إيقافهم

274
00:14:12,990 --> 00:14:14,080
.دعهم وشأنهم

275
00:14:42,060 --> 00:14:43,770
.أكره الجانحين للغاية

276
00:14:43,820 --> 00:14:45,730
.يُقاتلون مهما كانت الظروف

277
00:14:46,490 --> 00:14:47,240
من أنت؟

278
00:14:49,660 --> 00:14:50,990
.سُرِرتُ بلقائك

279
00:14:51,370 --> 00:14:52,570
.أنا بيتر

280
00:14:52,700 --> 00:14:55,200
.إنّه مُجرمٌ يستهدف المُلصقات أيضاً

281
00:14:55,240 --> 00:14:55,870
ماذا؟

282
00:14:56,790 --> 00:14:58,250
أهو صديقه؟

283
00:15:02,330 --> 00:15:03,590
.لنذهب

284
00:15:03,880 --> 00:15:05,130
...ولكن

285
00:15:07,170 --> 00:15:08,090
ماذا؟

286
00:15:08,670 --> 00:15:10,180
ألا تريد القتال؟

287
00:15:10,550 --> 00:15:12,760
لا أريد إهدار مُلصقاتي الثمينة

288
00:15:12,760 --> 00:15:14,180
.على قتالاتٍ مُمِلّة

289
00:15:14,300 --> 00:15:15,600
.فـ-فهمت

290
00:15:16,060 --> 00:15:17,850
تذكّر. يجب استعمال الدمج

291
00:15:17,980 --> 00:15:20,310
.في اللحظات الحرجة فقط

292
00:15:20,640 --> 00:15:21,770
!يا لكَ من مُدّعٍ

293
00:15:22,560 --> 00:15:24,940
ما خطب ملابسهم تلك؟

294
00:15:25,320 --> 00:15:26,780
أليست رائعة؟

295
00:15:27,320 --> 00:15:28,990
(هيب هوب فوكّورو)

296
00:15:30,150 --> 00:15:31,200
.إنّهم هنا

297
00:15:31,820 --> 00:15:32,700
.حسناً

298
00:15:38,040 --> 00:15:38,830
.سأذهب

299
00:15:39,450 --> 00:15:41,540
!ابذل جهدكَ يا جاك

300
00:15:46,000 --> 00:15:48,880
.سأعبّر عمّا أفكّر فيه لكم اليوم

301
00:15:53,930 --> 00:15:54,890
.اسمعوا

302
00:15:53,930 --> 00:15:54,890
.ملاحظة: الأغنية عبارة عن كلمات لا معنى لها

303
00:16:02,350 --> 00:16:04,440
♪أحتاج كلّ المُلصقات يا حبّي، ودعني أخبرك بقاعدة♪

304
00:16:04,440 --> 00:16:06,360
♪حتّى تعرف القصّة باستخدام موسيقى الروك♪

305
00:16:06,360 --> 00:16:09,820
♪"عِش! ماذا يمكنني إخبارك؟ أجل "كن رائعاً يا رجل♪

306
00:16:09,820 --> 00:16:11,650
♪،لا تبكِ الآن، يمكنني إخبار الجميع♪

307
00:16:11,650 --> 00:16:13,070
♪بأيّام وأغاني المدينة والحديث♪

308
00:16:13,070 --> 00:16:18,410
♪يا إلهي! سآخذكَ إلى اللحن الباكي، والعالم الرائع! أجل♪

309
00:16:18,660 --> 00:16:20,540
♪أيقظ قلبكَ يا حبيبي! القلوب مثل الفخر♪

310
00:16:20,540 --> 00:16:22,330
♪لا ليل بل احتفالاتٌ دائمة، أمسك نفسكَ وغُص♪

311
00:16:22,500 --> 00:16:25,960
♪"عِش! ماذا يمكنني إخبارك؟ أجل "كن رائعاً يا رجل♪

312
00:16:26,040 --> 00:16:27,630
♪!أجل. خذني الآن إلى منطقة الاحتفالات♪

313
00:16:27,710 --> 00:16:29,380
♪!يمكن أن تعرف جميع نغمات الحماس! أجل♪

314
00:16:29,380 --> 00:16:33,510
♪!يا إلهي! سآخذكَ إلى اللحن الباكي، والعالم الرائع♪

315
00:16:33,510 --> 00:16:36,890
♪!"هذا رائع! قُل! "كن رائعاً يا رجل♪

316
00:16:39,600 --> 00:16:43,270
!مذهل! استطاع جاك تعلّم أغنيةٍ إنجليزيّةٍ خلال وقتٍ قصير

317
00:16:43,480 --> 00:16:45,400
.استمع جيّداً أيّها الغبي

318
00:16:54,820 --> 00:16:55,950
...تلك الكلمات

319
00:16:56,820 --> 00:16:58,030
.إنّها يابانيّة

320
00:16:59,030 --> 00:17:02,120
هـ-هل يمكن استعمالها في اللغة اليابانيّة؟

321
00:17:06,710 --> 00:17:07,960
.كن رائعاً يا رجل

322
00:17:13,670 --> 00:17:14,840
.ظهر شيءٌ ما

323
00:18:08,980 --> 00:18:11,020
.هذه قوّة الموسيقى

324
00:18:11,230 --> 00:18:12,110
.لا

325
00:18:12,400 --> 00:18:14,780
.هذه قوّة بيكّوري-مان

326
00:18:17,570 --> 00:18:19,950
توقّف. هل تملك تصريحاً لهذا؟

327
00:18:20,120 --> 00:18:21,830
!استعراضات الشوارع ممنوعة

328
00:18:22,030 --> 00:18:23,620
!أوقفوا الموسيقى

329
00:18:24,620 --> 00:18:26,540
...إذا كان الشارع غير متاح

330
00:18:28,710 --> 00:18:31,880
!دمج الآلهة المُقدّسة

331
00:18:35,590 --> 00:18:37,380
(جاك ابن السماء)

332
00:18:37,630 --> 00:18:39,510
دمج؟ الآن؟

333
00:18:39,800 --> 00:18:43,560
.هذه هي اللحظة الحرجة

334
00:18:45,600 --> 00:19:01,990
!بيكّوري-مان

335
00:19:06,660 --> 00:19:07,540
،بعد ذلك

336
00:19:08,000 --> 00:19:11,210
.وبّخت الشرطة جاك بشدّة

337
00:19:14,290 --> 00:19:18,050
.لكن يبدو أنّه أصبح صديقاً مقرّباً من البائعين في المتجر

338
00:19:19,930 --> 00:19:22,470
!كن رائعاً يا رجل. كان ذلك مُذهلاً يا رجل

339
00:19:22,760 --> 00:19:24,930
.لم أنظر إلى هذا عن كثبٍ من قبل

340
00:19:25,260 --> 00:19:28,430
!لكن بجديّة، هذا فنٌّ حقيقي! يا له من أمرٍ جنوني

341
00:19:28,930 --> 00:19:32,190
!ستنال هذه الرسمة شعبيّةً في شارع التسوّق الرئيسي بالتأكيد

342
00:19:32,560 --> 00:19:33,440
!رائع

343
00:19:33,520 --> 00:19:34,940
!زيوس الخارق

344
00:19:35,020 --> 00:19:37,610
!نادرٌ جدّاً، إنّه مذهل

345
00:19:37,690 --> 00:19:39,740
!شكراً لكَ يا أخي

346
00:19:40,530 --> 00:19:41,530
.لا بأس

347
00:19:41,860 --> 00:19:44,240
.سأعطيكم إيّاها كهديّة

348
00:19:45,450 --> 00:19:46,910
.هذا دليلٌ على أخوّتِنا

349
00:19:50,540 --> 00:19:52,790
!شكراً لكَ يا أخي

350
00:19:54,170 --> 00:19:56,130
ألا بأس بمنحهم إيّاها كلّها؟

351
00:19:57,420 --> 00:19:59,970
إذا كان هذا سيضيف شخصاً، لا بل ثلاثة أشخاصٍ

352
00:20:00,220 --> 00:20:02,260
،إلى قاعدة مُحبّي بيكّوري-مان

353
00:20:02,340 --> 00:20:03,300
.فلا بأس بذلك

354
00:20:04,930 --> 00:20:07,850
.يمكنني جمع المُلصقات في المُستقبل

355
00:20:08,270 --> 00:20:09,140
.جاك

356
00:20:09,680 --> 00:20:11,690
!مستحيل

357
00:20:12,520 --> 00:20:14,560
.حصلتُ على مُلصقٍ مُذهل

358
00:20:14,690 --> 00:20:16,310
!زيوس الخارق

359
00:20:20,900 --> 00:20:22,820
!زيوس الخارق، رائع

360
00:20:25,620 --> 00:20:27,780
!يا له من إهدار! بادلوه معي

361
00:20:27,910 --> 00:20:28,870
.جاك

362
00:20:28,950 --> 00:20:30,370
.إنّه غبيٌّ بالفعل

363
00:20:30,660 --> 00:20:32,250
!بادلوا معي رجاءً

364
00:20:32,250 --> 00:20:35,460
!كن رائعاً يا رجل

365
00:22:07,380 --> 00:22:09,260
مراسم فتح غلاف بيكّوري-مان

366
00:22:10,640 --> 00:22:13,060
.مذهلٌ يا ياماتو، اشتريتَها أخيراً

367
00:22:13,350 --> 00:22:15,140
.اشتريناها بفضل جهودنا جميعاً

368
00:22:15,230 --> 00:22:16,770
.هذه بيكّوري-مان تخصّنا كلّنا

369
00:22:17,020 --> 00:22:18,310
.ياماتو

370
00:22:19,150 --> 00:22:21,900
مهلاً، من سيحصل على المُلصق إذاً؟

371
00:22:23,480 --> 00:22:25,320
،يمكن تقسيم البسكويت إلى ثلاث قطع

372
00:22:25,690 --> 00:22:27,570
.أمّا المُلصق فلا

373
00:22:29,240 --> 00:22:31,280
.حجر، ورق، مقص

374
00:22:33,030 --> 00:22:34,330
.لا تفعل هذا فجأةً

375
00:22:34,330 --> 00:22:35,620
.جاك

376
00:22:35,700 --> 00:22:36,960
.سأختار المقص

377
00:22:37,040 --> 00:22:38,500
.اختر المقص فحسب

378
00:22:38,580 --> 00:22:40,790
...مقص، مقص، مقص

379
00:22:44,250 --> 00:22:45,710
.فلنفتحها الآن على أيّ حال

380
00:22:46,050 --> 00:22:46,800
.أجل

381
00:22:47,170 --> 00:22:48,340
.افعلها أنتَ يا ياماتو

382
00:22:48,800 --> 00:22:50,010
هل يمكنني؟

383
00:22:50,720 --> 00:22:53,220
.ستكون هذه أوّل بيكّوري-مان تفتحها

384
00:22:53,890 --> 00:22:54,970
.افتحها بحذر

385
00:22:55,430 --> 00:22:57,640
.يمكنكَ الاعتماد على حظّ المُبتدئين

386
00:23:01,100 --> 00:23:01,810
.انتظر، انتظر

387
00:23:01,810 --> 00:23:03,360
ألم أقل لكَ كن حذراً؟

388
00:23:03,610 --> 00:23:06,740
!صلِّ للإله

389
00:23:06,820 --> 00:23:07,860
.هذا يكفي

390
00:23:07,990 --> 00:23:09,360
...إذاً-
.لا بأس-

391
00:23:10,110 --> 00:23:10,820
.حسناً

392
00:23:15,660 --> 00:23:16,870
(ووكونغ المُساعد)

393
00:23:17,080 --> 00:23:19,540
.هذه تميمةٌ مُرتبطةٌ بقصّة الرحلة نحو الغرب

394
00:23:21,080 --> 00:23:23,420
.إنّه لطيفٌ مثل قطّة الحظ

395
00:23:23,840 --> 00:23:25,170
.درعه هو لُفافة السمك

396
00:23:26,500 --> 00:23:28,300
.يبدو أنّه يشعر بالجوع

397
00:23:28,670 --> 00:23:30,050
.لقد أحببتَه حقّاً

398
00:23:32,550 --> 00:23:34,140
.من الصعب تقسيمها لثلاث قطع

399
00:23:34,140 --> 00:23:35,720
إلى كم قطعةٍ تريد كسرها؟