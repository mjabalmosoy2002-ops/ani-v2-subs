192
00:12:45,330 --> 00:12:48,650
.يبدو أنّي بالغتُ باستخدام قوّتي

193
00:12:48,780 --> 00:12:50,120
!عليكَ الذهاب إلى المُستشفى حالاً

194
00:12:50,780 --> 00:12:52,440
.لا تقلق بشأني

195
00:12:53,530 --> 00:12:58,390
.الأهمّ من ذلك، عليكم جميعاً ركوب ذلك الآلي

196
00:12:58,600 --> 00:12:59,430
ماذا؟

197
00:12:59,800 --> 00:13:02,620
،من أجل تفعيل هرقل

198
00:13:02,870 --> 00:13:06,520
.يجب إمداده بكميّةٍ كبيرةٍ من الطاقة

199
00:13:07,300 --> 00:13:13,060
.ولا يقدر على فعل هذا سواكم أنتم أيّها الآلهة الصغار

200
00:13:19,900 --> 00:13:20,920
.لنفعلها

201
00:13:24,580 --> 00:13:26,370
ما هذا الشعور؟

202
00:13:26,650 --> 00:13:28,770
.أشعر وكأنّي منشفةٌ جُفِّفت تماماً من الماء

203
00:13:28,770 --> 00:13:29,790
.اصمت وافعلها

204
00:13:35,350 --> 00:13:37,650
أهو هرقل بالفعل؟

205
00:13:42,550 --> 00:13:43,250
...أخبرني

206
00:13:44,210 --> 00:13:47,090
هل كنتَ تحاول نشر الفوضى في هذا العالم يا ماريس؟

207
00:13:48,030 --> 00:13:49,820
.لستُ مُضطرّاً لإخبارك

208
00:13:51,180 --> 00:13:52,070
.أعلم ذلك

209
00:13:53,350 --> 00:13:54,760
...بالمناسبة

210
00:13:55,190 --> 00:13:57,190
،تعلّمتُ كيفيّة أخذ الحساب من الزبائن مؤخّراً

211
00:13:57,730 --> 00:14:00,860
.ولكنّي ما زلتُ بطيئاً وأتعرّض للصراخ كثيراً

212
00:14:02,580 --> 00:14:04,370
...كما أنّي تعلّمتُ من ياماتو

213
00:14:04,880 --> 00:14:07,180
.كيفيّة استخدام المِكواة

214
00:14:08,730 --> 00:14:10,450
.ولكنّي ما زلتُ أحرق الملابس من حينٍ لآخر

215
00:14:15,000 --> 00:14:15,900
علي بابا؟

216
00:14:17,050 --> 00:14:21,130
.أتعلّم شيئاً فشيئاً ما يمكنني فعله في هذا العالم

217
00:14:22,150 --> 00:14:24,580
.ما زلتُ أريد تعلّم المزيد

218
00:14:25,600 --> 00:14:28,540
.أريد العثور على ما أريد فعله

219
00:14:30,050 --> 00:14:32,160
.لا أريد أن يختفي هذا العالم

220
00:14:33,480 --> 00:14:34,310
...لذا

221
00:14:35,030 --> 00:14:37,070
!دمج الآلهة المُقدّسة

222
00:14:44,030 --> 00:14:45,500
(كيجين علي بابا)

223
00:14:47,850 --> 00:14:50,090
.تولّي أمره يا ماريا

224
00:14:53,380 --> 00:14:54,660
!الدمج الشرّير

225
00:14:57,250 --> 00:14:59,030
الشيطانة ماريا

226
00:15:03,030 --> 00:15:04,880
.أنتَ بارعٌ في القتال أكثر ممّا توقّعت

227
00:15:09,400 --> 00:15:10,170
هود؟

228
00:15:10,360 --> 00:15:13,020
!أتيتُ لاسترداد ديني أيّها السارق

229
00:15:13,250 --> 00:15:15,760
أم يجب عليّ قول أيّتها السارقة؟

230
00:15:16,980 --> 00:15:18,260
ألن يجهز بعد؟

231
00:15:18,300 --> 00:15:20,350
.لم يصل لكامل قوّته إلى الآن

232
00:15:22,100 --> 00:15:23,120
!علي بابا

233
00:15:24,400 --> 00:15:25,700
!تحرّك

234
00:15:30,250 --> 00:15:31,200
!إنّه يتحرّك

235
00:15:31,250 --> 00:15:32,170
أهو يعمل؟

236
00:15:33,330 --> 00:15:35,180
.لا تكونوا مُتطلّبين للغاية

237
00:15:35,630 --> 00:15:37,670
!أنا قادمٌ يا علي بابا

238
00:15:40,600 --> 00:15:42,330
.انتهى وقت اللعب

239
00:15:51,230 --> 00:15:52,760
هل تُظهر لهم الرحمة؟

240
00:15:53,210 --> 00:15:55,450
.كان عليكَ استخدام هذا المُلصق منذ وقتٍ طويل

241
00:15:59,080 --> 00:16:01,380
.فأنتَ شيطانٌ في الحقيقة

242
00:16:02,950 --> 00:16:05,190
.عليكَ العودة إلى طبيعتك

243
00:16:05,330 --> 00:16:06,570
.يا تابعي

244
00:16:08,780 --> 00:16:11,640
...كلا، كلا! أنا

245
00:16:18,030 --> 00:16:19,440
(كيشين علي بابا)

246
00:16:19,650 --> 00:16:22,380
أهذا كيشين علي بابا؟

247
00:16:22,550 --> 00:16:24,530
هل ذلك هو علي بابا؟

248
00:16:26,230 --> 00:16:27,120
!إنّه قادم

249
00:16:29,630 --> 00:16:30,650
!تبّاً

250
00:16:30,680 --> 00:16:32,850
!هذا مُحال! لا يمكننا قتال علي بابا

251
00:16:42,630 --> 00:16:44,270
!كلّا يا علي بابا

252
00:16:44,290 --> 00:16:45,310
!توقّف

253
00:16:46,780 --> 00:16:49,400
...متجر... الملاك

254
00:16:51,900 --> 00:16:52,920
.علي بابا

255
00:16:57,750 --> 00:17:01,750
!لا

256
00:17:17,780 --> 00:17:18,540
!كلا

257
00:17:32,030 --> 00:17:34,970
...تبّاً. إنّ هرقل

258
00:17:40,280 --> 00:17:42,960
.كنتُ بانتظار هذه اللحظة

259
00:17:44,030 --> 00:17:47,550
!يُسعدني قبول هذه القوّة

260
00:17:48,300 --> 00:17:49,770
يمكنه تحويل القوّة إلى سحر؟

261
00:17:50,030 --> 00:17:52,970
ألهذا تركنا نستخدم هرقل؟

262
00:17:54,000 --> 00:17:55,540
!امتلأ السحر

263
00:17:56,200 --> 00:17:58,250
!حان وقت النزول

264
00:18:04,130 --> 00:18:05,730
!زيوس الأسود

265
00:18:10,780 --> 00:18:13,850
،الآن وقد ظهرنا أنا وزيوس الأسود

266
00:18:14,300 --> 00:18:17,760
.سيُبتلع العالم من قبل السحر

267
00:18:30,630 --> 00:18:31,910
.حان الوقت أخيراً

268
00:18:32,290 --> 00:18:35,750
!سيصبح العالم مقصوراً على الشياطين أخيراً

269
00:18:39,080 --> 00:18:40,420
.لن أسمح لكَ بفعل ما تريده

270
00:18:43,040 --> 00:18:44,520
،لقد وضعتُ مُلصقاً

271
00:18:45,150 --> 00:18:47,010
.يمنعكَ من الحركة مؤقّتاً

272
00:18:47,530 --> 00:18:48,680
!أنت

273
00:18:52,100 --> 00:18:53,700
ما الذي يحاول فعله؟

274
00:18:53,750 --> 00:18:54,900
...أيُعقل

275
00:18:55,380 --> 00:18:58,770
.زيوس الخارق وزيوس الأسود نقيضان لبعضهما

276
00:18:59,150 --> 00:19:00,750
.إنّهما يمثّلان ذروة القدّيسين والشياطين

277
00:19:01,520 --> 00:19:03,690
(زيوس الأسود)

278
00:19:01,520 --> 00:19:03,690
(زيوس الخارق)

279
00:19:01,520 --> 00:19:03,690
.سوف أقوم بدمجهما الآن

280
00:19:04,430 --> 00:19:06,470
زيوس الخارق وزيوس الأسود؟

281
00:19:07,350 --> 00:19:09,140
.لا يمكن دمجهما مع بعض

282
00:19:09,350 --> 00:19:11,780
،صحيح، لأنّ هذا مُستحيل

283
00:19:12,330 --> 00:19:16,800
.فلن يتحمّل العالم هذا التناقض، مِمّا سيؤدّي إلى تفاعل دمارٍ مُتبادل

284
00:19:17,250 --> 00:19:19,990
،الشياطين والملائكة والعوامل

285
00:19:20,930 --> 00:19:22,650
،وحتّى المُلصقات

286
00:19:24,080 --> 00:19:26,150
.سيختفي كلّ ما له علاقةٌ بـبيكّوري-مان

287
00:19:26,960 --> 00:19:28,020
...هذا ما يُسمّى

288
00:19:29,380 --> 00:19:30,980
!انفجار بيكّوري

289
00:19:35,680 --> 00:19:37,530
.إنّه يحاول تفعيل انفجار بيكّوري بالفعل

290
00:19:38,850 --> 00:19:40,390
،إذا اختفت العوامل

291
00:19:40,580 --> 00:19:42,250
ما الذي سيحدث لنا؟

292
00:19:42,300 --> 00:19:44,250
،إذا حدث ما يقوله حقّاً

293
00:19:44,510 --> 00:19:46,330
!فسنختفي نحن أيضاً

294
00:19:46,530 --> 00:19:47,490
!مستحيل

295
00:19:47,530 --> 00:19:49,890
!أأنتَ جاد؟ توقّف

296
00:19:51,780 --> 00:19:52,860
.إيبّون تسوري-سان

297
00:19:54,200 --> 00:19:56,280
،من أجل استدعاء زيوس الأسود

298
00:19:56,750 --> 00:19:59,690
.كان عليّ إيقاظ الشيطان الخارق أوّلاً

299
00:20:00,800 --> 00:20:03,550
.فعلتُ كلّ شيءٍ للوصول إلى هنا

300
00:20:03,630 --> 00:20:07,300
لماذا تفعل شيئاً كهذا يا ماريس-سان؟

301
00:20:07,700 --> 00:20:09,490
،في تاريخ بيكّوري-مان

302
00:20:09,780 --> 00:20:12,400
.ماتت الشياطين والملائكة معاً مرّاتٍ لا تُحصى

303
00:20:12,800 --> 00:20:17,020
لماذا نسمح للقدر بالتحكّم بنا ونكرّر دورة البعث والموت؟

304
00:20:17,330 --> 00:20:19,440
.تكرّرت هذه المآسي مرّاتٍ لا حصر لها

305
00:20:20,650 --> 00:20:21,610
...حتّى أنا

306
00:20:22,180 --> 00:20:24,860
.لا أستطيع عيش حياتي بشكلٍ عاديّ بسبب امتلاكي للعامل

307
00:20:25,140 --> 00:20:26,980
.لا يمكنني الهرب حتّى

308
00:20:27,200 --> 00:20:30,340
...القتال والقدر والحب

309
00:20:30,650 --> 00:20:33,210
!سئمتُ من هذا كلّه

310
00:20:34,150 --> 00:20:35,110
...لهذا

311
00:20:35,750 --> 00:20:37,860
!أريد إنهاء هذا كلّه

312
00:20:47,230 --> 00:20:48,310
لماذا؟

313
00:20:49,550 --> 00:20:50,450
.ماريا

314
00:20:51,020 --> 00:20:52,880
.انظري إلى ذلك المُلصق جيّداً

315
00:20:58,600 --> 00:21:01,350
ألم تفكّري في الأمر يا ماريا؟

316
00:21:02,250 --> 00:21:08,070
لماذا لم أقيّدكِ بالوصيّة السوداء منذ البداية؟

317
00:21:09,890 --> 00:21:11,490
.لأنّه لا يمُكن تقييدكِ

318
00:21:12,450 --> 00:21:16,090
.يوجد شيءٌ مُقدّسٌ داخل قلبكِ يمنعني من تقييدكِ

319
00:21:16,400 --> 00:21:19,040
.وهو الزعيم روكوكو

320
00:21:19,850 --> 00:21:20,680
ماذا تقول؟

321
00:21:21,130 --> 00:21:25,800
.لا يمكن لشخصٍ مثلكِ تقديم كلّ ما لديها من أجل الشياطين

322
00:21:26,480 --> 00:21:29,290
.كنتُ أعرف هذا منذ البداية

323
00:21:29,780 --> 00:21:33,570
!أيّتها العاشقة البائسة ماريا

324
00:21:34,400 --> 00:21:35,650
!لا تناديني بذلك الاسم

325
00:21:39,080 --> 00:21:40,040
،إذاً

326
00:21:41,230 --> 00:21:43,270
.حان وقت النهاية أخيراً

327
00:21:44,300 --> 00:21:47,690
!كلّ هذا من أجل الشيطان

328
00:21:50,530 --> 00:21:53,600
!كلا! توقّف

329
00:22:00,880 --> 00:22:04,140
...هذا فقط... مهما كان الثمن