1
00:00:01,120 --> 00:00:05,890
(مشفى بيكّوري-مان العمومي)

2
00:00:06,330 --> 00:00:07,480
.هذا مُحرج

3
00:00:08,200 --> 00:00:09,720
.آسفٌ على التسبّب بالمتاعب

4
00:00:10,170 --> 00:00:12,020
.من الجيّد أنّكَ بخير أيّها المُعلّم

5
00:00:12,180 --> 00:00:14,350
.أجل، بجديّة

6
00:00:14,860 --> 00:00:17,040
(.كعكة أرزّ فوكّورو المشهورة)

7
00:00:14,860 --> 00:00:17,040
.اقبل هذه الهديّة رجاءً

8
00:00:18,510 --> 00:00:19,540
.شكراً لك

9
00:00:20,390 --> 00:00:22,550
.دعني أقدّم نفسي مجدّداً، أنا يوشيواكا

10
00:00:23,030 --> 00:00:27,300
.لم أتوقّع الالتقاء بكَ أيّها المُعلّم كان، هذا شرفٌ كبير

11
00:00:28,230 --> 00:00:30,080
،أنتَ الرسّام الأصلي لمُلصقات بيكّوري-مان

12
00:00:30,280 --> 00:00:34,880
،مُلصقاتٌ مثل توفو كانون التي تشعّ قوّةً وشموخ في آنٍ واحد

13
00:00:30,630 --> 00:00:37,390
توفو كانون

14
00:00:35,300 --> 00:00:37,030
.هي أعمالٌ فنيّةٌ سيخلّدها التاريخ

15
00:00:37,730 --> 00:00:39,330
.هكذا إذاً

16
00:00:39,550 --> 00:00:40,960
.أنتَ مُعجبٌ كبيرٌ به

17
00:00:41,100 --> 00:00:42,700
.يمكنكَ طلب توقيعه لاحقاً

18
00:00:43,180 --> 00:00:46,380
أين المُلصقات التي قايضتها مُقابل السِلع المُزيّفة يا كان-سان؟

19
00:00:48,580 --> 00:00:49,860
.بداخله

20
00:00:52,950 --> 00:00:54,290
تقصد تمثال الزعيم روكوكو؟

21
00:00:54,430 --> 00:00:56,220
.كنتُ أشعر بشيءٍ ما بداخله

22
00:00:56,350 --> 00:00:58,390
ألم يكن هذا التمثال في غرفة الفنون؟

23
00:01:00,550 --> 00:01:03,970
.بداخله الكثير من مُلصقات بيكّوري-مان

24
00:01:04,010 --> 00:01:06,170
.لا تلمسه، ستُصيب المُلصقات بغبائك

25
00:01:06,180 --> 00:01:07,400
!لن أُصيبها بشيء

26
00:01:07,450 --> 00:01:09,690
ألا تعرف أيّ كلمةٍ غير غباء؟

27
00:01:09,690 --> 00:01:10,520
.أجل، أحمق

28
00:01:10,550 --> 00:01:12,090
أحمق؟

29
00:01:12,230 --> 00:01:13,510
...بيكّوري-مان

30
00:01:13,830 --> 00:01:14,910
!اخرس أيّها الفاشل

31
00:01:15,300 --> 00:01:17,670
هل يكرّر التاريخ نفسه؟

32
00:01:18,230 --> 00:01:19,130
!قلتُ فاشل أيّها الغبي

33
00:01:19,180 --> 00:01:20,260
.فهمت، تقصد فاضل

34
00:01:20,380 --> 00:01:22,620
.كلا! ليس فاضل، بل فاشل

35
00:01:25,930 --> 00:01:26,950
.اعتنِ بنفسك

36
00:01:28,630 --> 00:01:29,970
متى تحين مناوبتُكَ؟

37
00:01:30,250 --> 00:01:31,080
.عند الظهر

38
00:01:31,950 --> 00:01:33,550
.لديّ عطلةٌ اليوم

39
00:01:48,500 --> 00:01:50,040
.لم أركَ منذ وقتٍ طويل

40
00:01:58,750 --> 00:02:00,670
.زيوس الخارق

41
00:02:22,970 --> 00:02:25,770
(بيكّوري-مان)

42
00:03:37,190 --> 00:03:38,990
.كنتُ مفتوناً

43
00:03:39,690 --> 00:03:43,030
مصرف بيكّوري

44
00:03:43,160 --> 00:03:45,700
هل سأتناول الفاصولياء المقليّة مُجدّداً هذا الشهر؟

45
00:03:46,240 --> 00:03:48,410
.لن أكسب الكثير من المال بهذا الحضور غير المُنتظم

46
00:03:49,370 --> 00:03:51,500
.كان الماضي أفضل بكثير

47
00:03:52,540 --> 00:03:53,750
.ابتعد أيّها العجوز

48
00:03:58,380 --> 00:04:00,840
.ستتأذّى إذا لم تأخذ حذركَ أيّها العجوز

49
00:04:01,090 --> 00:04:03,590
أتعرف كم هي هشّةٌ عظام كِبار السن؟

50
00:04:04,180 --> 00:04:06,930
.دخلت جارتي العجوز المُستشفى لشهرٍ بسبب كسرٍ فقط

51
00:04:07,140 --> 00:04:10,390
.رغم كونها مالكة عقاراتٍ كبيرة، إلا أنّها لا تستطيع شراء الصِحّة

52
00:04:17,440 --> 00:04:18,860
أنت، هل تسمعني؟

53
00:04:19,110 --> 00:04:20,780
وما خطب هذه القميص الملوّن الذي ترتديه؟

54
00:04:22,780 --> 00:04:24,860
،سقطّتُ في الظلام

55
00:04:25,110 --> 00:04:27,490
،وتلاعبت قوّةٌ مُخيفةٌ بي

56
00:04:27,740 --> 00:04:30,830
.وأجبرتني على صناعة الكثير من سِلع بيكّوري-مان المُزيّفة

57
00:04:31,500 --> 00:04:34,370
:ردّدت الأصوات بداخل رأسي على مسامعي

58
00:04:34,870 --> 00:04:37,250
."اجمع المُلصقات"

59
00:04:38,710 --> 00:04:41,420
...القوّة التي قيّدتني هي

60
00:04:41,920 --> 00:04:43,720
.الوصيّة السوداء

61
00:04:44,590 --> 00:04:45,760
...كما توقّعت

62
00:04:46,220 --> 00:04:48,180
.تلاعب بي ذلك الشخص

63
00:04:48,640 --> 00:04:50,680
.هذه هي المرّة الثانية

64
00:04:55,390 --> 00:04:57,480
.استرِح الآن

65
00:05:04,570 --> 00:05:06,990
(بيكّوري-مان)

66
00:05:05,450 --> 00:05:07,450
!إنّها مُلصقاتٌ لامعة

67
00:05:07,490 --> 00:05:09,740
،أعطاني إيّاها شوكوشي البارحة

68
00:05:09,910 --> 00:05:11,370
.قال إنّها هديّة شكرٍ منه

69
00:05:11,450 --> 00:05:14,870
.لقد بذلتُ جهدي في جمع السِلع المُزيّفة

70
00:05:15,830 --> 00:05:18,960
.أنتَ أيضاً بذلتَ جهدكَ يا علي بابا-كن

71
00:05:20,960 --> 00:05:22,670
علي بابا

72
00:05:20,960 --> 00:05:22,670
مُتدرّب

73
00:05:21,880 --> 00:05:23,460
،بالإضافة إلى جمع المُلصقات

74
00:05:23,840 --> 00:05:27,680
.دافعتَ عن المتجر بينما كنّا نُقاتل

75
00:05:27,930 --> 00:05:30,760
...المعذرة، بالنسبة للدفع

76
00:05:31,180 --> 00:05:32,390
.الدفع ذاتيٌّ هنا

77
00:05:33,020 --> 00:05:35,520
.لقد ساعدتّنا، شكراً لك

78
00:05:37,310 --> 00:05:41,980
.علّمني كيف أُحاسب الزبائن وبقيّة الأمور رجاءً

79
00:05:42,280 --> 00:05:43,150
...علي بابا

80
00:05:43,480 --> 00:05:46,570
.حسناً، سأُعلِّمُكَ كيف تُرتّب البضائع وتقلي الطعام

81
00:05:46,740 --> 00:05:49,370
.ستُساعدنا كثيراً إذا استطعتَ العمل خلال النهار

82
00:05:49,870 --> 00:05:50,870
.لا تتراخوا كثيراً

83
00:05:51,580 --> 00:05:54,080
.لا أعتقد أنّهم تخلّوا عن جمع المُلصقات

84
00:06:02,920 --> 00:06:05,010
.استخدم الماسح هكذا

85
00:06:06,340 --> 00:06:10,340
.ذلك الشخص أسوأ ممّا ظننت

86
00:06:10,800 --> 00:06:11,890
.ماريس

87
00:06:12,350 --> 00:06:13,890
...حتّى تاكايان الذي ليس له علاقة

88
00:06:14,680 --> 00:06:18,230
ما المغزى من التلاعب بأشخاصٍ لا دخل لهم بالمسارات؟

89
00:06:19,060 --> 00:06:20,060
التلاعب؟

90
00:06:20,810 --> 00:06:23,070
أليس هذا من فعل الشيطانة ماريا؟

91
00:06:23,440 --> 00:06:24,400
الشيطانة ماريا؟

92
00:06:24,860 --> 00:06:27,820
.أوّل زعيمةٍ شيطانيّةٍ أُنثى في تاريخ بيكّوري-مان

93
00:06:27,820 --> 00:06:33,530
الشيطانة ماريا

94
00:06:28,400 --> 00:06:30,990
،اعترضت طريقنا إلى العالم التالي

95
00:06:31,200 --> 00:06:32,950
.وهي شخصيّةٌ شرسةٌ للغاية

96
00:06:32,660 --> 00:06:38,620
الشيطان الخارق

97
00:06:33,330 --> 00:06:36,910
يمكنها التلاعب بالشياطين بقدرة الشيطان
.الخارق، وهي التي حوّلت علي بابا إلى شيطان

98
00:06:35,910 --> 00:06:38,620
شيطنة

99
00:06:37,080 --> 00:06:38,710
.إنّها خطِرةٌ للغاية

100
00:06:39,040 --> 00:06:42,960
.إنّها قويّة واستثنائيّةٌ من جميع النواحي

101
00:06:43,210 --> 00:06:44,880
.يبدو أنّكَ تحبّها يا يوشيواكا

102
00:06:45,380 --> 00:06:48,380
.وهي ترتبط بالزعيم روكوكو على وجه الخصوص

103
00:06:48,760 --> 00:06:51,300
.وُلِدت لقتال العنقاء المُقدّس قبل تطوّره

104
00:06:51,550 --> 00:06:54,010
.يمكنكَ اعتبارهما منافسين أبديين

105
00:06:57,270 --> 00:06:58,980
ماذا تفعل؟

106
00:06:59,980 --> 00:07:01,600
.سأتفقّد المُلصقات بداخله

107
00:07:21,420 --> 00:07:23,330
!يا له من غبيٍّ عنيد

108
00:07:26,500 --> 00:07:27,670
.تبّاً

109
00:07:27,760 --> 00:07:29,420
!لا أستطيع فتحه على الإطلاق

110
00:07:29,760 --> 00:07:31,590
.سأضطرّ لاستعمال الدمج إذاً

111
00:07:31,760 --> 00:07:33,760
هل ستستخدم مُلصقاً يا جاك؟

112
00:07:33,800 --> 00:07:35,100
!هذا كلّه من أجل الكنز

113
00:07:37,310 --> 00:07:39,770
.لم أتوقّع أنّ المُلصقات مُخبّئة هنا

114
00:07:42,140 --> 00:07:42,980
!هود

115
00:07:43,150 --> 00:07:44,310
!أيّها الوغد

116
00:07:44,360 --> 00:07:45,820
.سأغادر

117
00:07:50,820 --> 00:07:51,900
.وداعاً

118
00:07:56,200 --> 00:07:57,240
...هذا

119
00:08:05,040 --> 00:08:05,960
...ماريس

120
00:08:10,670 --> 00:08:12,760
،لنغادر المكان أوّلاً لتجنّب المشاكل

121
00:08:13,260 --> 00:08:14,680
.ومن ثمّ نستخرج المُلصقات

122
00:08:15,260 --> 00:08:16,220
!حاضر

123
00:08:16,550 --> 00:08:18,260
.لا بدّ أنّكَ تُدركُ ذلك يا ماريس

124
00:08:19,220 --> 00:08:22,480
.ولكن كنّا سننال مُرادنا لو لم تكن مهملاً

125
00:08:23,100 --> 00:08:25,810
.أنا لا أكترث أبداً بمبادئكَ اللعينة

126
00:08:26,310 --> 00:08:28,360
.ستكون هذه المرّة الأخيرة إذا لم تكن جادّاً

127
00:08:28,860 --> 00:08:32,700
من سمح لكَ بالحديث مع ماريس-سان بهذه الطريقة أيّها الغبي؟

128
00:08:32,990 --> 00:08:34,700
.توقّف عن النُباح أيّها الكلب

129
00:08:35,950 --> 00:08:36,740
!توقّفوا

130
00:08:41,040 --> 00:08:42,080
!ماريس-سان

131
00:08:50,760 --> 00:08:51,550
طائر؟

132
00:08:51,630 --> 00:08:52,420
!لاحقوه

133
00:08:53,130 --> 00:08:54,130
.لن نسمح لكم

134
00:08:54,300 --> 00:08:55,590
.وصلتم في الوقت المُناسب

135
00:08:55,760 --> 00:08:58,930
.أنا غاضبٌ للغاية الآن

136
00:08:59,180 --> 00:09:00,100
أتعلمون هذا؟

137
00:09:02,730 --> 00:09:03,930
...تمثال روكوكو

138
00:09:06,600 --> 00:09:07,650
.انتظر

139
00:09:08,610 --> 00:09:10,150
ما الذي تخطّط له؟

140
00:09:10,520 --> 00:09:12,360
لماذا تجمع المُلصقات؟

141
00:09:14,070 --> 00:09:15,820
.أريد الحديث معك

142
00:09:28,710 --> 00:09:29,960
تُهاجمني الطيور؟

143
00:09:32,920 --> 00:09:34,130
!تمثال روكوكو

144
00:09:41,100 --> 00:09:43,220
تبّاً! إلى أين سقط؟

145
00:09:46,310 --> 00:09:48,270
!يظنّه أحد فِرَاخِه

146
00:09:51,570 --> 00:09:52,360
هل تريد القتال؟

147
00:09:54,190 --> 00:09:55,690
.يحميه بكلّ طاقته

148
00:09:57,070 --> 00:09:58,160
.لا داعي للقلق

149
00:09:58,490 --> 00:10:01,740
ألا نعرف بالفعل كيف نتواصل بالأفكار؟

150
00:10:02,910 --> 00:10:07,540
!استمعوا إلى أفكارنا يا حيوانات الأدغال

151
00:10:25,060 --> 00:10:26,850
!جاك

152
00:10:28,480 --> 00:10:30,150
.من حُسن حظّكَ أنّكَ غبي

153
00:10:30,150 --> 00:10:32,020
.لن تقلق من الإصابة بالزُكام وأنتَ في الماء

154
00:10:33,820 --> 00:10:35,150
.دعوا الأمر لي هنا

155
00:10:35,320 --> 00:10:37,950
!اسبقوني إلى هناك

156
00:10:41,410 --> 00:10:43,080
أُطيحَ بِه

157
00:10:46,620 --> 00:10:48,160
.علي بابا

158
00:10:48,580 --> 00:10:50,040
هل بدأتَ العمل عندنا؟

159
00:10:51,080 --> 00:10:52,380
.حسناً، سُرِرتُ بلقائك

160
00:10:53,130 --> 00:10:54,590
إلى أين ذهب الجميع؟

161
00:10:55,250 --> 00:10:57,050
.إنّهم يقاتلون ماريس وأعوانه

162
00:10:57,920 --> 00:10:59,300
.ماريس مُخيف

163
00:10:59,720 --> 00:11:01,050
.ارتكب الكثير من الأمور الفظيعة

164
00:11:02,090 --> 00:11:02,720
...ولكن

165
00:11:03,800 --> 00:11:04,560
...أشعر

166
00:11:05,350 --> 00:11:06,810
.أنّه يائس

167
00:11:14,730 --> 00:11:16,150
أُطيحَ بِه

168
00:11:20,990 --> 00:11:22,660
أُطيحَ بِه

169
00:11:27,830 --> 00:11:29,370
!سأتذكّر هذا

170
00:11:29,410 --> 00:11:31,000
أُطيحَ بِه

171
00:11:34,840 --> 00:11:37,090
أما زلتَ تريد المواصلة يا هود-كن؟

172
00:11:39,800 --> 00:11:41,010
!أنتَ مُزعج

173
00:11:56,570 --> 00:11:57,520
.أعِده

174
00:12:05,990 --> 00:12:06,950
.دعني

175
00:12:07,410 --> 00:12:09,080
ألن تتوقّف؟

176
00:12:09,450 --> 00:12:11,120
لماذا تفعل شيئاً كهذا؟

177
00:12:12,040 --> 00:12:15,790
.لا أعتقد أنّ هناك سبباً لنقاتل بعضنا بعد الآن

178
00:12:17,290 --> 00:12:19,550
...إذا استطعتُ المساعدة بطريقةٍ ما

179
00:12:21,340 --> 00:12:23,720
من تكون حتّى تقلق علي؟

180
00:12:24,760 --> 00:12:25,720
...ماريس

181
00:12:26,800 --> 00:12:28,260
إلى متى ستعبث هكذا؟

182
00:12:31,600 --> 00:12:32,560
ألم أقل لك؟

183
00:12:32,850 --> 00:12:34,980
.سنفترق إذا لم تكن جادّاً

184
00:12:36,230 --> 00:12:36,980
...هود

185
00:12:37,940 --> 00:12:39,480
.سآخذ هذا

186
00:12:42,070 --> 00:12:43,570
.لن أعطيكَ إيّاه

187
00:12:49,580 --> 00:12:50,910
!تبّاً

188
00:12:51,000 --> 00:12:52,710
!سأقضي عليك

189
00:12:55,750 --> 00:12:57,290
أتستهين بي أيّها اللعين؟

190
00:13:10,930 --> 00:13:11,970
...تبّاً

191
00:13:12,220 --> 00:13:13,770
.روكو...كو

192
00:13:27,700 --> 00:13:28,700
...ماريس

193
00:13:29,580 --> 00:13:30,990
(متجر الشيطان المُفتتح حديثاً)

194
00:13:35,330 --> 00:13:36,250
.مرحباً

195
00:13:36,750 --> 00:13:38,420
.أنا مُدير المتجر المُقابل

196
00:13:38,580 --> 00:13:39,710
.اسمي هو العنقاء

197
00:13:40,170 --> 00:13:41,840
...أتيتُ لإلقاء التحيّة

198
00:13:44,340 --> 00:13:45,420
...أنت

199
00:13:46,380 --> 00:13:48,260
.أنا المدير العام ماريس

200
00:13:48,470 --> 00:13:49,470
.سُرِرتُ بلقائك

201
00:13:52,180 --> 00:13:54,100
.أجل، سُرِرتُ بلقائك

