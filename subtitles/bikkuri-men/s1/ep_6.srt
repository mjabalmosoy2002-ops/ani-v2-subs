1
00:00:00,000 --> 00:00:03,480
متجر الملاك

2
00:00:01,880 --> 00:00:03,410
حدث تبادلٍ كبير؟

3
00:00:03,950 --> 00:00:04,650
.أجل

4
00:00:04,850 --> 00:00:07,150
حدث تبادلٍ كبير

5
00:00:07,150 --> 00:00:09,460
.لعشّاق بيكّوري-مان

6
00:00:09,750 --> 00:00:12,100
.يبدو أنّه سيُقام نهاية الأسبوع في منتزه بيكّوري الترفيهي

7
00:00:12,530 --> 00:00:14,350
.أريد الذهاب

8
00:00:13,510 --> 00:00:14,350
.هذا مستحيل

9
00:00:14,650 --> 00:00:17,850
.لأنّ هذا الحدث للفتيات فقط

10
00:00:18,130 --> 00:00:19,790
حدث تبادل مُلصقات بيكّوري-مان
ألا يمكن للفتيان المشاركة؟

11
00:00:19,900 --> 00:00:23,040
،ما تزال الفتيات أقليّةً بين عشّاق بيكّوري-مان

12
00:00:23,080 --> 00:00:26,300
.لذا يتواصلن مع بعضهن بواسطة وسائل التواصل الاجتماعي

13
00:00:26,300 --> 00:00:29,860
.سمعتُ أنّه توجد الكثير من الأحداث الخاصّة بالفتيات كهذا

14
00:00:30,530 --> 00:00:32,890
.هكذا إذاً، ما باليد حيلة

15
00:00:33,150 --> 00:00:35,870
...سنستسلم هذه المرّة

16
00:00:34,160 --> 00:00:35,870
!لا تستسلم بسرعة

17
00:00:35,930 --> 00:00:37,820
!طالما كان لدينا هذا

18
00:00:37,000 --> 00:00:37,820
!جاك

19
00:00:38,330 --> 00:00:40,960
الخادمة يوشي

20
00:00:59,200 --> 00:01:01,790
(بيكّوري-مان)

21
00:02:14,610 --> 00:02:16,150
!دمج الآلهة المُقدّسة

22
00:02:19,280 --> 00:02:20,620
.الخادمة يوشي

23
00:02:20,110 --> 00:02:20,660
الخادمة يوشي

24
00:02:21,160 --> 00:02:22,330
.الخادمة ريشي

25
00:02:21,160 --> 00:02:22,620
الخادمة ريشي

26
00:02:24,490 --> 00:02:25,620
!مذهل

27
00:02:25,790 --> 00:02:27,660
.تحوّلنا لفتياتٍ حقّاً

28
00:02:28,250 --> 00:02:30,000
أأنا جميلة؟ جميلة؟

29
00:02:30,040 --> 00:02:31,580
.قريبٌ جدّاً! ابتعد عنّي

30
00:02:31,710 --> 00:02:35,170
أرواحهن التي اختفت بعد إكمالهن لمهامهن

31
00:02:35,380 --> 00:02:37,800
تُبعث مجدّداً بعد اكتسابهن لحياةٍ جديدة

32
00:02:38,260 --> 00:02:43,850
.هذا هو زيّ الملاك الخادمة من شوكولا بيكّوري-مان 18

33
00:02:44,180 --> 00:02:45,850
...اكتساب حياةٍ جديدة

34
00:02:46,270 --> 00:02:47,850
...ربّما يمكنني أنا أيضاً

35
00:02:48,600 --> 00:02:51,770
لكن ما العمل؟

36
00:02:51,900 --> 00:02:54,150
.من المحرج التحوّل لفتاة

37
00:02:54,230 --> 00:02:55,320
،لسوء الحظ

38
00:02:55,400 --> 00:02:56,940
ليس لدى الأمير ياماتو أو علي بابا

39
00:02:56,940 --> 00:02:58,780
.نسخ مُلصقاتٍ بزيّ الملاك الخادمة

40
00:02:59,490 --> 00:03:00,950
لا يوجد؟

41
00:03:01,360 --> 00:03:02,530
لماذا تبدو مُحبطاً؟

42
00:03:02,700 --> 00:03:05,080
.هذه الهيئة مثاليّة

43
00:03:05,450 --> 00:03:07,830
.لنذهب مباشرةً إلى حدث تبادل الفتيات

44
00:03:08,040 --> 00:03:09,250
أليس كذلك يا يوشيواكا؟

45
00:03:09,370 --> 00:03:10,670
.لستُ مهتمّاً

46
00:03:10,920 --> 00:03:12,130
لماذا؟

47
00:03:12,420 --> 00:03:15,290
.يوجد هناك الكثير من ملصقات الفتيات على الأرجح

48
00:03:15,380 --> 00:03:17,050
.أريد الذهاب حقّاً

49
00:03:17,090 --> 00:03:18,880
.هذا ما قلتَه من قبل

50
00:03:18,880 --> 00:03:20,760
.لم أقل شيئاً كهذا أبداً

51
00:03:22,140 --> 00:03:23,220
،لسوء الحظ

52
00:03:23,390 --> 00:03:26,310
.لن أسمح لكما بالذهاب إلى الحدث

53
00:03:26,310 --> 00:03:27,810
لماذا؟

54
00:03:28,100 --> 00:03:31,440
.تبحث الفتيات عن الطمأنينة

55
00:03:32,020 --> 00:03:33,940
،مهما كنتما تبدوان كفتاتين

56
00:03:34,150 --> 00:03:37,440
.ستثيران الريبة إذا ظللتما تفكّران كالفتيان

57
00:03:39,650 --> 00:03:41,530
.استسلما هذا المرّة فحسب

58
00:03:42,110 --> 00:03:45,410
.استدعاني المقرّ الرئيسي، لذا سأترك أمر المتجر لكما

59
00:03:48,370 --> 00:03:49,950
.الذهاب مُستحيل كما توقعت

60
00:03:50,460 --> 00:03:51,620
.كلا، لن أستسلم بعد

61
00:03:51,790 --> 00:03:55,040
.لا بأس طالما كنّا نفكّر كالفتيات

62
00:03:55,420 --> 00:03:58,670
.تكمن المشكلة في تعلّم التصرّف والتحدّث كالفتيات

63
00:03:58,800 --> 00:04:00,720
.سمعتُ حديثكما

64
00:04:02,260 --> 00:04:03,220
!الأخت الكبيرة

65
00:04:03,840 --> 00:04:05,890
،إذا أردتما فهم الفتيات

66
00:04:06,350 --> 00:04:07,810
.اتركا الأمر لي

67
00:04:10,680 --> 00:04:12,770
،حتّى بعد أن ذقتُ مرارة النبيذ

68
00:04:13,270 --> 00:04:15,520
.ما زلتُ لم أعتد على مرارة العلاقات العاطفيّة

69
00:04:16,520 --> 00:04:19,070
،على مدار حياتي كفتاةٍ لعشرين عاماً

70
00:04:19,570 --> 00:04:22,900
.مرّت الكثير من الليالي التي بلّلتُ فيها وسادتي بدموع الانفصال

71
00:04:24,360 --> 00:04:26,160
،وفي وضعٍ كهذا

72
00:04:26,370 --> 00:04:28,330
.لا يواسيني سوى النبيذ

73
00:04:29,080 --> 00:04:30,620
.لذا جرّبوه أنتم أيضاً

74
00:04:31,160 --> 00:04:34,500
.حتّى ولو هرب الرجل، فالنبيذ لن يهرب أبداً

75
00:04:37,170 --> 00:04:38,670
.هذا هو شعور الفتيات

76
00:04:39,460 --> 00:04:41,170
!هذه أمور بالغين

77
00:04:41,260 --> 00:04:42,090
.مذهل

78
00:04:42,220 --> 00:04:45,260
.تبدو وكأنّها تشرب النبيذ حقّاً مع أنّها تشرب ماءً فحسب

79
00:04:45,300 --> 00:04:47,260
أهذا ما لفتَ انتباهك؟

80
00:04:47,640 --> 00:04:49,560
ألا توجد معلّماتٌ أخريات؟

81
00:04:51,850 --> 00:04:54,560
.مرحباً، أريد شراء دجاج الملاك

82
00:04:58,860 --> 00:05:01,730
أنتما جاك-كن ويوشيواكا-كن؟ حقّاً؟

83
00:05:02,400 --> 00:05:04,030
ألستُ جميلة؟

84
00:05:05,030 --> 00:05:06,700
.مظهركُ أجمل من السابق

85
00:05:07,530 --> 00:05:09,200
.يا لها من صدمة

86
00:05:09,740 --> 00:05:13,200
الأهمّ من ذلك، أين الكتاب المرجعي الذي تحدّثتِ عنه؟

87
00:05:13,290 --> 00:05:14,830
.أجل، ها هو

88
00:05:13,830 --> 00:05:15,330
ليس مجرّد شيطان

89
00:05:15,960 --> 00:05:17,500
مانغا فتيات؟

90
00:05:17,830 --> 00:05:21,550
.أعتقد أنّ مانغا الفتيات مليئةٌ بالأشياء الأنثويّة

91
00:05:22,260 --> 00:05:23,630
هل قرأتها أوشيس-سان من قبل؟

92
00:05:24,260 --> 00:05:25,340
،اعتدتُ قراءتها في الماضي

93
00:05:25,930 --> 00:05:28,140
.لكن أصبحت شخصيّاتُها مُبهرجةً كثيراً هذه الأيّام

94
00:05:28,140 --> 00:05:29,930
.ولا تصلح لتكون طبقاً جانبيّاً مع النبيذ

95
00:05:32,180 --> 00:05:34,180
ما خطب بطلة القصّة؟

96
00:05:34,520 --> 00:05:35,310
،مع أنّها تحبّه

97
00:05:35,310 --> 00:05:36,480
.إلا أنّها خائفةٌ من الاعتراف له

98
00:05:36,480 --> 00:05:38,400
ماذا سأفعل، أنا متردّدةٌ جدّاً
.وقد مرّت خمس مجلّداتٍ بالفعل

99
00:05:38,730 --> 00:05:40,230
لكن آمل أن تتفهّمني
.لا تضيّعي حياتكِ

100
00:05:40,360 --> 00:05:41,520
حشرها عند الجدار؟

101
00:05:41,770 --> 00:05:43,480
ألن يكون من الممتع أكثر دفعها إلى الجدار رغماً عنها

102
00:05:43,480 --> 00:05:45,780
مثل المانغات القتاليّة؟

103
00:05:46,030 --> 00:05:47,660
أأنتما بخير؟

104
00:05:47,700 --> 00:05:49,990
.هذا هو النضوج

105
00:05:52,740 --> 00:05:53,950
.الجوّ حار

106
00:05:55,040 --> 00:05:56,370
.الجوّ مناسبٌ للذهاب إلى المسبح

107
00:05:56,620 --> 00:05:57,960
.المعذرة أيّها المدير

108
00:05:58,170 --> 00:06:00,630
.نريد الذهاب إلى المنتزه

109
00:06:00,840 --> 00:06:03,000
أيمكنكَ الذهاب إلى المسبح لوحدك؟

110
00:06:03,460 --> 00:06:05,510
.لا مانع لدي

111
00:06:04,590 --> 00:06:05,510
.عظيم

112
00:06:05,880 --> 00:06:06,590
عظيم؟

113
00:06:06,720 --> 00:06:09,680
!أ-أنا أريد اللعب على الزحليقة المائيّة

114
00:06:10,140 --> 00:06:10,970
،لسوء الحظ

115
00:06:11,220 --> 00:06:13,470
.لا يبدو أنّ الزحليقة المائيّة ستُفتح اليوم

116
00:06:12,640 --> 00:06:14,100
الزحليقة المائيّة مُغلقة

117
00:06:15,100 --> 00:06:16,230
.يمكنني رؤيته

118
00:06:16,350 --> 00:06:18,100
.منتزه بيكّوري الترفيهي

119
00:06:20,440 --> 00:06:22,020
حدث تبادل مُلصقات بيكّوري-مان

120
00:06:27,400 --> 00:06:30,360
.دعنا نريهن ما تعلّمناه

121
00:06:30,950 --> 00:06:32,780
...لكَ ذلك، أوّلاً

122
00:06:32,910 --> 00:06:34,040
.فهمت

123
00:06:37,660 --> 00:06:39,710
،بعد تدريبٍ طويل

124
00:06:39,830 --> 00:06:42,460
.استطعنا فهم الفتيات تماماً

125
00:06:42,750 --> 00:06:44,920
،نبدو كفتياتٍ مهما نظرتَ إلينا

126
00:06:45,130 --> 00:06:46,510
.ونأكل الفطائر المُحلّاة

127
00:06:47,010 --> 00:06:48,630
حدث تبادل مُلصقات بيكّوري-مان

128
00:06:49,220 --> 00:06:50,590
هاتان الفتاتان

129
00:06:50,840 --> 00:06:53,010
.من الصعب التقرّب إليهما

130
00:06:54,760 --> 00:06:56,850
!غير معقول! لقد أثرنا شكوكهن

131
00:06:57,100 --> 00:06:59,140
مع أنّنا نأكل الفطائر المُحلاة، لمَ هذا؟

132
00:06:59,350 --> 00:07:02,690
!لا تُذعر! ما زال لدينا خطّة بديلة

133
00:07:03,650 --> 00:07:05,780
.انظري كم هو جميل

134
00:07:05,940 --> 00:07:08,780
جميلٌ جدّاً، أليس كذلك؟

135
00:07:08,820 --> 00:07:11,240
.بالفعل، إ-إنّه جميل

136
00:07:11,280 --> 00:07:12,620
.جميل

137
00:07:13,740 --> 00:07:15,870
!علّمتنا هذا أوشيس-سان

138
00:07:16,120 --> 00:07:17,410
!كرّرا كلمة "جميلٍ" فحسب

139
00:07:17,580 --> 00:07:19,750
.قولا "جميل" عندما تقعان في ورطة

140
00:07:20,000 --> 00:07:21,670
.هذا الأساس الأهمّ في تقليد الفتيات

141
00:07:24,340 --> 00:07:27,340
!كأسان من عصير بيكّوري الصيفي. آسفٌ على التأخّر

142
00:07:27,460 --> 00:07:30,930
.سريع! مع أنّي طلبتُ للتوّ فقط

143
00:07:31,510 --> 00:07:32,760
.آسفٌ على التأخّر

144
00:07:32,970 --> 00:07:34,300
.دعيني آخذ طلبكِ

145
00:07:34,850 --> 00:07:36,680
ثلاثة كؤوسٍ من عصير بيكّوري الصيفي؟

146
00:07:37,560 --> 00:07:41,100
.شكراً لك! اعتذر العامل المؤقّت عن المجيء فجأةً

147
00:07:41,560 --> 00:07:43,230
.توصيل الطلبات من اختصاصي

148
00:07:45,480 --> 00:07:47,020
هل أنتما بخير؟

149
00:07:47,230 --> 00:07:48,570
ألا ترى بنفسك؟

150
00:07:48,650 --> 00:07:50,780
.كنّا مُستعدّان بشكلٍ مثالي

151
00:07:51,200 --> 00:07:53,700
.لم أعد أعرف ما يجدر بي فعله

152
00:07:53,910 --> 00:07:56,160
أتريدان رؤية ما يفعله الأشخاص الآخرون؟

153
00:07:56,490 --> 00:07:57,660
...مثل

154
00:07:58,450 --> 00:07:59,830
لماذا يتجمّعن هناك؟

155
00:08:00,080 --> 00:08:02,160
!تبّاً، يا له من مجتمعٍ ظالم

156
00:08:02,290 --> 00:08:03,960
...مهلاً، أليست تلك

157
00:08:04,420 --> 00:08:07,380
.مذهل، توجد الكثير من الملصقات الرائعة

158
00:08:07,800 --> 00:08:10,170
.رائع، هذا مذهل

159
00:08:10,260 --> 00:08:12,090
.جميلةٌ جدّاً

160
00:08:12,170 --> 00:08:14,090
.المعذرة، يمكنكِ التبادل معي إذا أردتِ

161
00:08:14,090 --> 00:08:17,300
!حقّاً؟ شكراً لكِ، أنا أحبّكِ

162
00:08:17,760 --> 00:08:19,680
أيمكنكِ التبادل معي أيضاً؟

163
00:08:20,220 --> 00:08:23,310
!يا لسعادتي! أنا أحبّ الجميع

164
00:08:21,890 --> 00:08:23,560
الخادمة جينشي

165
00:08:23,890 --> 00:08:26,150
.لا شكّ في ذلك، إنّه بيتر

166
00:08:30,230 --> 00:08:31,570
ماذا؟

167
00:08:30,230 --> 00:08:31,940
(الخادمة هوشي)

168
00:08:32,450 --> 00:08:34,990
ما الأمر؟ أتحاولين افتعال مشكلةٍ معي؟

169
00:08:35,200 --> 00:08:36,820
.لا، على الإطلاق

170
00:08:37,450 --> 00:08:39,450
لا بأس لديكِ بهذا إذاً؟

171
00:08:39,790 --> 00:08:41,370
.أجل، بالطبع

172
00:08:41,790 --> 00:08:43,540
ما الذي تحدّقن فيه؟

173
00:08:43,870 --> 00:08:46,290
.اصطففن إذا أردتنّ تبادل المُلصقات معي

174
00:08:46,500 --> 00:08:48,040
!حاضر

175
00:08:49,500 --> 00:08:52,050
تبّاً. لمَ يجب عليّ فعل هذا؟

176
00:08:52,550 --> 00:08:53,510
ماذا؟

177
00:08:53,760 --> 00:08:55,380
ألم تكن تريد المُلصقات يا هود-شان؟

178
00:08:55,380 --> 00:08:57,640
ألا يمكنكَ تحمّل فعل أمرٍ بهذه البساطة؟

179
00:08:58,180 --> 00:08:59,890
.لا تتمتّع بتصميمٍ كافٍ

180
00:09:00,600 --> 00:09:01,890
مع من تتحدّث؟

181
00:09:02,350 --> 00:09:03,850
هل يسعيان وراء المُلصقات؟

182
00:09:05,190 --> 00:09:09,770
كيف يجرؤان على التسلّل لحدث تبادل المُلصقات المخصّص للفتيات؟

183
00:09:12,990 --> 00:09:15,360
غيورٌ جدّا

184
00:09:12,990 --> 00:09:15,400
.اسمعن جميعاً

185
00:09:15,650 --> 00:09:17,910
إنّهما في الحقيقة

186
00:09:18,660 --> 00:09:20,620
.فتيان

187
00:09:21,870 --> 00:09:25,750
!من المستحيل أن تكون بيتر-شان وهود-ساما فتيان

188
00:09:28,960 --> 00:09:31,420
!لا ترمين حبّات الشاي بالحليب كحبّات الفول

189
00:09:33,380 --> 00:09:34,470
.لذيذة

190
00:09:36,470 --> 00:09:37,800
.ظننتُ أنّ أمرنا قد انتهى

191
00:09:38,930 --> 00:09:40,930
.لن نموت بسبب حبّات الشاي بالحليب

192
00:09:41,260 --> 00:09:43,640
،إذا كنتما تريدان تبادل المُلصقات

193
00:09:43,720 --> 00:09:46,140
لمَ لا تطلبان مساعدة بيتر وهود؟

194
00:09:46,230 --> 00:09:47,310
.مُستحيل

195
00:09:47,390 --> 00:09:49,810
لا بدّ أنّهما يخطّطان لشيءٍ شرّير

196
00:09:50,060 --> 00:09:51,730
.حتّى يتسلّلا إلى حدث تبادل المُلصقات

197
00:09:51,900 --> 00:09:53,400
.نحن فعلنا هذا أيضاً

198
00:09:53,690 --> 00:09:55,490
.إنّهما مخادعان للغاية

199
00:09:55,820 --> 00:09:57,530
.يستمتعان بوقتهما بالحديث مع الفتيات

200
00:09:57,610 --> 00:09:59,030
أهذا ما يُغيظك؟

201
00:09:59,950 --> 00:10:01,620
المدير

202
00:10:01,620 --> 00:10:02,450
مرحباً؟

203
00:10:02,740 --> 00:10:05,620
المعذرة. هل رأيتم علي بابا؟

204
00:10:05,960 --> 00:10:08,540
.اختفى بعدما ذهبتُ لشراء تذكرة

205
00:10:08,710 --> 00:10:09,710
علي بابا؟

206
00:10:11,880 --> 00:10:12,960
.جميل

207
00:10:13,090 --> 00:10:14,300
أتريد تناول المثلّجات؟

208
00:10:14,510 --> 00:10:15,460
ما رأيكَ بالفشار؟

209
00:10:16,630 --> 00:10:17,970
.لا داعي للخجل

210
00:10:18,180 --> 00:10:20,850
.سنحرص على إطعامكَ كثيراً

211
00:10:24,430 --> 00:10:26,020
.لقد أُخِذَ مِنّا

212
00:10:27,310 --> 00:10:31,190
حتّى أنتَ يا علي بابا؟

213
00:10:32,060 --> 00:10:33,860
المنزل المسكون

214
00:10:34,610 --> 00:10:37,070
.سأعطيكَ جميع مُلصقات الشياطين كما اتّفقنا

215
00:10:38,070 --> 00:10:38,990
...في المقابل

216
00:10:40,490 --> 00:10:42,320
.يمكنكَ أخذ بقيّة المُلصقات

217
00:10:43,580 --> 00:10:45,950
.ليست كافيةً بعد

218
00:10:47,540 --> 00:10:49,000
لمَ لا نستولي عليها فحسب؟

219
00:10:49,460 --> 00:10:51,630
.هذا أسرع من التبادل

220
00:10:52,000 --> 00:10:52,790
.مرفوض

221
00:10:53,210 --> 00:10:55,250
.هود

222
00:10:53,210 --> 00:10:55,250
.يتوجّب علينا سرقة المصنع فحسب

223
00:10:56,340 --> 00:10:58,470
.لن أخالف مبادئي

224
00:10:59,510 --> 00:11:02,340
هل انتهينا اليوم يا ماريس-سان؟

225
00:11:02,430 --> 00:11:03,970
.ليس بعد

226
00:11:02,430 --> 00:11:03,970
.أريد الذهاب إلى المنتزه الترفيهي

227
00:11:04,760 --> 00:11:07,600
.أريد منكما المشاركة في هذا

228
00:11:12,100 --> 00:11:14,190
.لا تتبع الغرباء في المُستقبل

229
00:11:14,900 --> 00:11:15,730
لماذا؟

230
00:11:15,770 --> 00:11:17,320
!لأنّي أحسدك

231
00:11:17,480 --> 00:11:19,650
.لا تكذب عليه. سيصبح غبيّاً مثلك

232
00:11:19,780 --> 00:11:22,360
ما هو المُلصق النادر للغاية برأيكِ؟

233
00:11:22,410 --> 00:11:23,910
.أشعر بالفضول حياله

234
00:11:27,240 --> 00:11:29,500
(مسابقة الكرة الطائرة المائيّة)

235
00:11:28,540 --> 00:11:30,210
مسابقة الكرة الطائرة المائيّة؟

236
00:11:30,410 --> 00:11:32,710
!انظرا إلى جائزة الفائز

237
00:11:33,330 --> 00:11:36,880
سيحصل الفائز على مجموعة بيكّوري-مان الفاخرة

238
00:11:37,130 --> 00:11:38,800
.ومُلصقٍ نادرٍ للغاية

239
00:11:39,760 --> 00:11:40,220
الخادمة يوشي

240
00:11:39,760 --> 00:11:40,220
الخادمة ريشي

241
00:11:40,420 --> 00:11:42,010
الخادمة يوشي مع الخادمة ريشي

242
00:11:42,720 --> 00:11:43,220
الخادمة هوشي

243
00:11:42,720 --> 00:11:43,220
الخادمة جينشي

244
00:11:43,430 --> 00:11:45,010
الخادمة جينشي مع الخادمة هوشي

245
00:11:46,310 --> 00:11:47,720
.لقد وصلنا

246
00:11:48,100 --> 00:11:49,560
.حسناء الصيف

247
00:11:50,390 --> 00:11:51,520
!جاكي-شان

248
00:11:51,980 --> 00:11:53,100
ما الذي تفعله؟

249
00:11:53,020 --> 00:11:55,770
الصيف

250
00:11:53,230 --> 00:11:56,070
!الصيف! المسبح! والفتيات أيضاً

251
00:11:53,770 --> 00:11:55,770
المسبح

252
00:11:54,770 --> 00:11:55,770
الفتيات

253
00:11:55,770 --> 00:11:57,650
ملابس

254
00:11:55,770 --> 00:11:57,650
سباحة

255
00:11:56,360 --> 00:11:59,440
.يتوجّب عليّ ارتداء ملابس سباحةٍ إذاً

256
00:12:00,740 --> 00:12:02,200
.آسفة

257
00:12:06,160 --> 00:12:08,490
!المُلصقات ليست مضادّةً للماء

258
00:12:08,950 --> 00:12:10,450
.يا لها من مُصيبة

259
00:12:10,450 --> 00:12:14,040
.ذهب حلمي بارتداء ملابس السباحة الأنثوية أدراج الرياح

260
00:12:15,290 --> 00:12:18,250
...لو كان المُلصق أكثر ثباتاً

261
00:12:18,750 --> 00:12:19,840
.لا تبكِ

262
00:12:20,130 --> 00:12:22,300
.هذه أغبى دموعٍ في العالم

263
00:12:22,420 --> 00:12:23,970
.اهدأ يا جاك

264
00:12:24,220 --> 00:12:26,930
.لستَ مُضطرّاً لترتدي ملابس السباحة في المسبح فحسب

265
00:12:26,930 --> 00:12:28,810
!أنتَ لا تفهم شيئاً

266
00:12:29,060 --> 00:12:31,430
.أريد ارتداء ملابس السباحة لأنّي في المسبح

267
00:12:31,640 --> 00:12:34,770
.انظر إلى هذه الصور لحسناءٍ تجلس على غطاء السيّارة

268
00:12:34,980 --> 00:12:37,650
.توجد الكثير من الأشياء التي تشتّت تركيزي عن الحسناء

269
00:12:37,900 --> 00:12:40,480
.أعتقد أنّ مثالكَ ليس مناسباً جدّاً

270
00:12:40,650 --> 00:12:43,030
.المكان الوحيد المناسب لملابس السباحة هو المسبح أو البحر

271
00:12:43,070 --> 00:12:44,700
!هذا هو نظام الكون

272
00:12:44,860 --> 00:12:46,200
،في هذه الحالة

273
00:12:46,490 --> 00:12:48,370
.يمكنكَ الجلوس على جانب المسبح

274
00:12:48,740 --> 00:12:51,040
.لن تُزال المُلصقات إذا لم تتبلّل بالمياه

275
00:12:51,410 --> 00:12:54,870
.لن أعرف متى سأُرشُّ بالماء حتّى ولو جلستُ على جانب المسبح

276
00:12:55,120 --> 00:12:57,540
،إذا كُشف أمري وأنا أرتدي ملابس سباحةٍ للفتيات

277
00:12:57,790 --> 00:13:01,010
.سأفقد كرامتي كفتى

278
00:13:01,340 --> 00:13:03,010
!يا لكَ من غبيٍّ مُزعج

279
00:13:03,340 --> 00:13:06,090
،إذا كنتَ تفكّر بهذه الطريقة بالفعل

280
00:13:06,340 --> 00:13:08,720
.فاركض عارياً لا يكسوكَ شيءٌ سوى المُلصق

281
00:13:09,010 --> 00:13:10,470
.لا يمكنني فعل ذلك

282
00:13:10,810 --> 00:13:13,230
.عفّتي كفتاةٍ لا تسمح لي بذلك

283
00:13:13,350 --> 00:13:15,020
.لم أعد أفهم عليك

284
00:13:16,730 --> 00:13:20,070
.ماذا؟ جميعكم هنا بالفعل

285
00:13:20,520 --> 00:13:21,730
!جوجيكا-شان

286
00:13:21,780 --> 00:13:23,690
لماذا ترتدين سُترة؟

287
00:13:23,780 --> 00:13:26,070
.اسحب دموعكَ القذرة تلك

288
00:13:26,530 --> 00:13:27,820
.حسمتُ أمري

289
00:13:28,030 --> 00:13:30,740
،سأستخدم الشغف الذي اكتسبتُه جرّاء فُقداني لملابس السباحة

290
00:13:31,160 --> 00:13:33,250
.لإشعال نيران روحي وحياتي

291
00:13:33,580 --> 00:13:35,870
،سيلمع نجمي في الكرة الطائرة المائيّة

292
00:13:36,250 --> 00:13:39,000
،وأحصل على المُلصق النادر للغاية

293
00:13:39,420 --> 00:13:42,710
.وأُظهر لمعاني أمام جوجيكا-شان

294
00:13:42,800 --> 00:13:44,720
.حارٌّ جدّاً

295
00:13:42,800 --> 00:13:44,720
.إنّه يحترق

296
00:13:45,760 --> 00:13:47,510
.هيّا، فلنبدأ

297
00:13:47,550 --> 00:13:50,800
.ستنطلق أخيراً مسابقة الكرة الطائرة المائيّة في مسبح بيكّوري

298
00:13:51,260 --> 00:13:58,480
من الفريق الذي سيفوز في هذه المنافسة المُحتدمة؟

299
00:13:59,900 --> 00:14:02,480
.مرحى! فُزنا في المباراة الأولى

300
00:14:02,820 --> 00:14:08,740
.جائزة الفائز اليوم هي مجموعة بيكّوري-مان الفاخرة ومُلصقٌ نادرٌ للغاية

301
00:14:09,910 --> 00:14:12,240
!ابذل جهدكَ يا صاحب تسريحة الكعكة

302
00:14:13,870 --> 00:14:15,290
!شعورٌ رائع

303
00:14:17,080 --> 00:14:19,210
...هذا حقّاً

304
00:14:21,590 --> 00:14:23,800
!فُزنا! رائع

305
00:14:24,300 --> 00:14:27,300
!من سيفوز بالجائزة؟ ابقوا معنا

306
00:14:28,800 --> 00:14:30,260
.يا لسعادتي

307
00:14:30,470 --> 00:14:31,930
!ابتعدوا عن طريقي أيّها المُبتدئون

308
00:14:35,600 --> 00:14:36,810
!يا له من أمرٍ مؤسف

309
00:14:38,020 --> 00:14:38,980
.تفضّلا

310
00:14:41,060 --> 00:14:42,690
.شكراً جزيلاً

311
00:14:49,490 --> 00:14:50,700
أتريد عبوةً أخرى؟

312
00:14:51,910 --> 00:14:54,490
!وصلنا إلى النهائيّ أخيراً

313
00:14:54,790 --> 00:14:57,200
الفريقان اللذان وصلا إلى النهائي هما

314
00:14:57,330 --> 00:14:59,710
فريق يوشيواكا وجاك

315
00:15:00,120 --> 00:15:00,960
ضد

316
00:15:01,000 --> 00:15:02,790
الفريق صاحب سلسلة الانتصارات المتتالية

317
00:15:02,790 --> 00:15:05,170
والذي حطّم خصومه في المباريات السابقة

318
00:15:05,250 --> 00:15:07,800
.فريق هود وبيتر

319
00:15:08,220 --> 00:15:10,840
.نحن محظوظان! يبدو خصمنا ضعيفاً

320
00:15:11,220 --> 00:15:13,890
!سأنتقم ممّا حدث في حدث التبادل! سأفوز حتماً

321
00:15:14,050 --> 00:15:15,390
!ابذلا جهدكما

322
00:15:18,230 --> 00:15:20,020
.سأفوز في هذه المباراة

323
00:15:20,190 --> 00:15:21,230
!خذا هذا

324
00:15:21,560 --> 00:15:23,360
.لا تستهِن بنا

325
00:15:24,480 --> 00:15:25,650
!لكَ ذلك

326
00:15:26,320 --> 00:15:28,320
دورة
إيبّون
تسوري
لصيد
السمك

327
00:15:26,320 --> 00:15:28,320
.أتيتَ أنتَ أيضاً يا إيبّون تسوري

328
00:15:28,690 --> 00:15:29,530
.أجل

329
00:15:29,990 --> 00:15:32,910
.فكّرتُ في تدريب بعض الصيّادين الواعدين

330
00:15:33,200 --> 00:15:34,030
.فهمت

331
00:15:34,410 --> 00:15:36,450
...اسمع، طريقة تعليق الطعم هي

332
00:15:36,620 --> 00:15:39,160
.كلا، يجب أن ترمي الصنّارة هكذا

333
00:15:39,580 --> 00:15:41,500
.حسناً، سأريكَ كيف تفعلها

334
00:15:50,050 --> 00:15:51,840
ما كان ذلك؟

335
00:15:56,220 --> 00:15:57,060
.اختفى

336
00:15:57,430 --> 00:15:59,310
!اختفى سروالي

337
00:15:59,680 --> 00:16:01,600
!نحتاج وقتاً مُستقطعاً أيّها الحكم

338
00:16:01,890 --> 00:16:04,270
.يبدو أنّ شيئاً ما قد حدث في المسبح

339
00:16:04,610 --> 00:16:06,150
،ولكن، بسبب اقتراب موعد إغلاق المسبح

340
00:16:06,360 --> 00:16:09,480
!لا يمكن إيقاف المسابقة لأيّ سبب

341
00:16:09,780 --> 00:16:10,860
ماذا تقول؟

342
00:16:10,900 --> 00:16:11,820
.اهدأ

343
00:16:12,030 --> 00:16:13,280
لن تُكشف مناطقنا الحسّاسة

344
00:16:13,410 --> 00:16:15,620
.طالما بقيت تحت الماء

345
00:16:17,240 --> 00:16:19,750
ماذا ستفعلان إذا قمتُ بهذا إذاً؟

346
00:16:24,960 --> 00:16:26,210
...ماذا؟ إنّ الماء

347
00:16:27,590 --> 00:16:31,090
اخترقتُ نظام الصرف في وقتٍ سابق

348
00:16:31,470 --> 00:16:34,380
.للتدخّل في المباريات في اللحظات الحاسمة

349
00:16:34,640 --> 00:16:36,010
.يا لها من حيلةٍ رخيصة

350
00:16:36,350 --> 00:16:37,680
...في هذه الحالة

351
00:16:37,720 --> 00:16:41,310
.يجب علينا الفوز بالمباراة قبل نفاد المياه

352
00:16:41,430 --> 00:16:44,980
...إذا استمرّ الوضع هكذا، فإنّ المناطق الحسّاسة ليوشيواكا وجاك

353
00:16:45,100 --> 00:16:46,650
ما العمل يا علي بابا؟

354
00:16:47,190 --> 00:16:47,980
ماذا؟

355
00:16:47,980 --> 00:16:49,400
منتزه بيكّوري الترفيهي

356
00:16:49,400 --> 00:16:50,230
.المعذرة

357
00:16:50,730 --> 00:16:55,070
.أريد مناقشة شيءٍ بخصوص المرطّبات الخاصة بجائزة المشاركة في المسابقة

358
00:16:55,530 --> 00:16:58,030
جائزة المشاركة؟

359
00:16:56,450 --> 00:16:58,030
أكان لدينا مثل هذه الجائزة؟

360
00:17:08,590 --> 00:17:11,420
.يبدو أنّكَ نفّذتَ ما طلبتُه منكَ في الرسالة

361
00:17:12,050 --> 00:17:14,010
.هيّا، أعطِني إيّاها

362
00:17:16,300 --> 00:17:17,090
ما الخطب؟

363
00:17:17,800 --> 00:17:20,140
.أريد التحدّث معكَ يا ماريس

364
00:17:20,560 --> 00:17:23,020
لماذا تفعل هذا؟

365
00:17:23,390 --> 00:17:25,600
.هود وبيتر يُقاتلان بالفعل

366
00:17:26,100 --> 00:17:28,860
.فوزهما ليس مضموناً

367
00:17:29,230 --> 00:17:31,070
.من الضروريّ وجود تأمينٍ إضافي

368
00:17:31,530 --> 00:17:33,570
لماذا تريد المُلصقات لهذه الدرجة؟

369
00:17:35,860 --> 00:17:39,530
هل تعتبر هود وبيتر صديقين لكَ يا ماريس؟

370
00:17:40,780 --> 00:17:43,000
هل أنا صديقك؟

371
00:17:44,370 --> 00:17:47,000
.وصلت المسابقة إلى ذروتها أخيراً

372
00:17:47,250 --> 00:17:49,210
!سيفوز من يحصل على النقطة التالية

373
00:17:49,380 --> 00:17:50,590
،ولكن

374
00:17:50,840 --> 00:17:52,880
،بالمقارنة مع فريق هود وبيتر المُفعم بالحيويّة

375
00:17:53,260 --> 00:17:55,760
.يلعب فريق يوشيواكا وجاك وكأنّه مُقيّدٌ بشيءٍ ما

376
00:17:55,920 --> 00:17:57,470
ما الذي يحدث معهما؟

377
00:17:57,680 --> 00:18:00,180
.تبّاً، سأموت من الحرج إذا وقفت

378
00:18:00,390 --> 00:18:02,180
.يا له من إذلال

379
00:18:07,480 --> 00:18:10,110
.أنتم جميعاً رفاقي

380
00:18:11,730 --> 00:18:12,690
.فهمت

381
00:18:13,320 --> 00:18:17,030
.لكنّي لا أريد أن أكون عدوّاً لياماتو والآخرين

382
00:18:18,110 --> 00:18:19,950
.لقد تغيّرتَ يا علي بابا

383
00:18:20,910 --> 00:18:24,040
.كنتُ أحاول زرع بيدقٍ مُطيعٍ في فريق العدو

384
00:18:24,450 --> 00:18:27,160
.لكن يبدو أنّ البيدق يمتلك مشاعراً تعترض طريقه

385
00:18:27,660 --> 00:18:31,290
.سأجعلكَ تنسى كلّ شيءٍ مجدّداً

386
00:18:33,250 --> 00:18:34,920
.كلا، لا تقترب

387
00:18:36,050 --> 00:18:36,880
لماذا؟

388
00:18:37,090 --> 00:18:38,430
.لنركّز على الهرب الآن

389
00:18:41,430 --> 00:18:43,970
إلى متى ستستمرّ باللعب؟

390
00:18:44,930 --> 00:18:45,930
ما الخطب؟

391
00:18:46,100 --> 00:18:48,770
!من النادر رؤية رقصةٍ مُحزنةٍ ومُمتعةٍ كهذه

392
00:18:51,310 --> 00:18:54,270
،لو كان بوسعنا تشتيت انتباه المُتفرّجين

393
00:18:54,650 --> 00:18:56,230
.سنكون بخير

394
00:18:59,740 --> 00:19:00,700
!من هنا

395
00:19:01,620 --> 00:19:07,370
الزحليقة
المائيّة
مُغلقةٌ
الآن

396
00:19:02,070 --> 00:19:03,660
ألا يمكن إصلاحها؟

397
00:19:03,990 --> 00:19:06,700
.لا فائدة، ضغط الماء قويٌّ جدّاً

398
00:19:06,830 --> 00:19:08,790
!لا يمكنكما الذهاب إلى هناك

399
00:19:20,300 --> 00:19:22,930
.التفكير مُتعبٌ لعقلكَ يا علي بابا

400
00:19:23,470 --> 00:19:25,430
.دع ذلك الأمر لي

401
00:19:25,850 --> 00:19:28,730
.هذا أفضل وضعٍ لك

402
00:19:29,180 --> 00:19:30,270
.هذا خاطئ

403
00:19:30,810 --> 00:19:32,940
.قال لكَ علي بابا إنّه لا يريد ذلك

404
00:19:34,610 --> 00:19:36,360
.دعه يختر طريقه بنفسه

405
00:19:36,980 --> 00:19:40,110
.لا يحقّ لأحدٍ تقرير حياة علي بابا سواه هو

406
00:19:41,070 --> 00:19:41,950
...ياماتو

407
00:19:43,160 --> 00:19:44,160
.لننطلق

408
00:19:47,410 --> 00:19:49,830
.سريعةٌ جدّاً

409
00:19:54,500 --> 00:19:57,000
.استسلما واكشفا عن نفسيكما

410
00:19:57,340 --> 00:19:59,970
.أظهِرا للجميع ما تُخفيانه

411
00:20:00,720 --> 00:20:01,880
ما الذي تفعله؟

412
00:20:04,390 --> 00:20:05,850
.لا أحبّ إذلال خصمي

413
00:20:06,260 --> 00:20:07,850
.فلننتهِ من هذه المسابقة في الحال

414
00:20:16,820 --> 00:20:17,900
مُلصق؟

415
00:20:18,480 --> 00:20:19,650
!مُلصقات بيكّوري-مان

416
00:20:19,690 --> 00:20:21,190
!إنّها تسقط من السماء

417
00:20:21,490 --> 00:20:22,110
!الآن

418
00:20:23,910 --> 00:20:26,160
...الآن فقط

419
00:20:27,490 --> 00:20:29,200
.سيلمع نجمي

420
00:20:29,700 --> 00:20:31,790
ما هذا الضوء؟

421
00:20:31,250 --> 00:20:32,620
يلمع
مثل

422
00:20:31,250 --> 00:20:32,620
الملصق
اللامع

423
00:20:35,580 --> 00:20:37,040
!حُسم الأمر

424
00:20:37,250 --> 00:20:39,050
الفائز في مسابقة الكرة الطائرة المائيّة

425
00:20:39,130 --> 00:20:41,550
.هو الثنائيّ يوشيواكا وجاك

426
00:20:41,720 --> 00:20:42,590
!تبّاً

427
00:20:42,920 --> 00:20:43,880
.مؤلم

428
00:20:48,640 --> 00:20:50,470
ماذا؟ انتهت المسابقة؟

429
00:21:10,990 --> 00:21:12,040
.إنّهم نائمون

430
00:21:14,830 --> 00:21:17,000
.كان يجب أن أفعل هذا من البداية

431
00:21:18,210 --> 00:21:19,500
.سلّمني المُلصقات

432
00:21:19,590 --> 00:21:21,090
لماذا تفعل هذا؟

433
00:21:21,210 --> 00:21:22,510
.هذه هي النهاية

434
00:21:25,550 --> 00:21:26,840
أنتَ مُجدّداً؟

435
00:21:28,350 --> 00:21:29,010
.ماريس

436
00:21:40,440 --> 00:21:41,190
.لننسحب

437
00:21:41,980 --> 00:21:43,070
لماذا؟

438
00:21:43,360 --> 00:21:45,070
ألا تريد قتالهم؟

439
00:21:45,400 --> 00:21:46,780
.المُلصقات أمام أعيننا

440
00:21:47,030 --> 00:21:48,950
.هذا يتعارض مع مبادئي

441
00:21:50,530 --> 00:21:51,280
.تبّاً

442
00:21:58,710 --> 00:22:00,250
الشيطان الخارق

443
00:22:00,250 --> 00:22:01,750
متجر الشيطان

444
00:22:01,750 --> 00:22:03,760
ماريس الإبليس