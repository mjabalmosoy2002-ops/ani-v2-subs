1
00:00:02,400 --> 00:00:05,340
.هيّا أيّها السُلحفاة، حان وقت الطعام

2
00:00:05,680 --> 00:00:07,790
.إنّها بندورة من تاناكا-سان

3
00:00:08,300 --> 00:00:09,900
.لا يستجيب على الإطلاق

4
00:00:10,030 --> 00:00:11,690
.مزاجه جيّدٌ حقّاً

5
00:00:12,000 --> 00:00:14,500
.لا يغضب حتّى ولو ضايقه أسود

6
00:00:15,480 --> 00:00:18,040
.يبدو أنّه مُدرِكٌ لما حوله

7
00:00:19,380 --> 00:00:21,790
هل عثرتَ على مالكه؟-
.كلا-

8
00:00:21,900 --> 00:00:25,290
.سألتُ في جميع أرجاء الإنترنت ولم أتلقَّ أيّ جواب

9
00:00:25,630 --> 00:00:27,700
هل جلبتُه معي من النهر يا تُرى؟

10
00:00:27,980 --> 00:00:29,640
هل نطلقه إلى البريّة؟

11
00:00:30,180 --> 00:00:32,670
يمكن أن نُعطّل النظام البيئي

12
00:00:33,180 --> 00:00:35,050
.إذا لم نعرف نوعه بالضبط

13
00:00:37,950 --> 00:00:39,170
.لا تُلصقها في مكانٍ عشوائي

14
00:00:39,350 --> 00:00:41,210
.استُخدِمت تلك المُلصقات من أجل الدمج

15
00:00:41,480 --> 00:00:43,770
.هذه هي المُلصقات التي حمت شوكولا بيكّوري-مان

16
00:00:43,780 --> 00:00:45,610
.سمح لنا المدير بفعل هذا

17
00:00:46,880 --> 00:00:48,990
.كلّ ما فعلتَه كان عزف أغنيةٍ غبيّة

18
00:00:48,990 --> 00:00:50,180
غبيّة؟

19
00:00:50,180 --> 00:00:52,640
ماذا قلتَ أيّها الوغد؟-
.جاك-كن، يوشيواكا-كن-

20
00:00:54,550 --> 00:00:55,450
.حاضر

21
00:01:02,780 --> 00:01:04,750
أتريد رؤية السلحفاة أيّها المدير؟

22
00:01:04,800 --> 00:01:05,950
.أجل، رجاءً

23
00:01:11,630 --> 00:01:13,420
.مرحباً، سآخذ مكانكِ

24
00:01:13,900 --> 00:01:15,370
.لا داعي لذلك

25
00:01:16,230 --> 00:01:17,830
.انتهى عملكِ الآن

26
00:01:18,280 --> 00:01:20,640
.لا داعي لذلك اليوم

27
00:01:21,200 --> 00:01:22,290
ماذا تقصدين؟

28
00:01:22,350 --> 00:01:24,210
!قلتُ لا داعي لذلك

29
00:01:24,280 --> 00:01:26,450
.اذهبا لمسح الأرض وإعادة تعبئة البضائع

30
00:01:28,080 --> 00:01:31,150
!مرحباً! إنّه العم

31
00:01:31,350 --> 00:01:32,890
.لا تنادِني بالعم

32
00:01:34,930 --> 00:01:36,330
.اسمي إيبّون تسوري

33
00:01:37,280 --> 00:01:38,890
إيبّون تسوري

34
00:01:58,230 --> 00:02:00,710
(بيكّوري-مان)

35
00:03:10,460 --> 00:03:11,750
!الكثير من السمك

36
00:03:12,330 --> 00:03:14,130
.اصطدتُها هذا الصباح

37
00:03:14,340 --> 00:03:15,500
.إنّها طازجةٌ جدّاً

38
00:03:15,590 --> 00:03:16,920
.العمّ صيّاد

39
00:03:18,210 --> 00:03:20,300
.شكراً جزيلاً على عملكَ الدؤوب

40
00:03:20,470 --> 00:03:22,050
هل ستتّسع الثلّاجة لكلّ هذا؟

41
00:03:22,300 --> 00:03:25,760
.استخدم آلتَكَ لقليها وتناولها فحسب

42
00:03:25,890 --> 00:03:28,060
.لكن هذه ليست بضاعةً تخصّ المتجر

43
00:03:28,560 --> 00:03:30,640
ماذا؟ أليس هذا متجرك؟

44
00:03:31,190 --> 00:03:32,690
.يمكنكَ فعل ما تشاء

45
00:03:32,770 --> 00:03:34,610
.أنا مديرٌ بالوكالة فقط

46
00:03:35,610 --> 00:03:36,690
أهو زبونٌ دائم؟

47
00:03:37,070 --> 00:03:39,570
.إنّه من الآلهة الصغار مثلنا

48
00:03:40,860 --> 00:03:43,660
،إيبّون تسوري هو آخر المُنضمّين

49
00:03:43,740 --> 00:03:45,370
لكنّه وُلِد للقتال ضدّ

50
00:03:45,370 --> 00:03:47,160
زيوس الأسود، أقوى زعيمٍ لدى الشياطين

51
00:03:47,160 --> 00:03:48,540
.وتوأم زيوس الخارق

52
00:03:48,540 --> 00:03:51,250
،حُقِنَ بالسحر من قبل الآليّ القدّيس هرقل

53
00:03:51,290 --> 00:03:53,500
.أحد الملائكة الاثني عشر-
!مذهل-

54
00:03:53,790 --> 00:03:56,460
.على أيّ حال، إنّه يمتلك صنّارة صيدٍ تُدعى الخطّاف المُقدّس

55
00:03:56,460 --> 00:03:59,260
.يمكنه اصطياد الشياطين بصنّارة صيده

56
00:03:59,260 --> 00:04:00,510
.تذكّر هذا فحسب

57
00:04:00,970 --> 00:04:04,300
.يصطاد الشياطين بالخطّاف المُقدّس. فهمت

58
00:04:04,510 --> 00:04:06,890
.حسناً، سأغادر الآن

59
00:04:07,010 --> 00:04:07,850
بهذه السرعة؟

60
00:04:08,140 --> 00:04:09,680
،لم تطأ قدماي الأرض منذ وقتٍ طويل

61
00:04:10,060 --> 00:04:12,940
لذا سأستنشق هواءً نقيّاً في الجبال. أتريدين المجيء معي؟

62
00:04:14,100 --> 00:04:15,810
أتريدين المجيء معي؟

63
00:04:19,360 --> 00:04:21,030
.كلا، لا يجب عليّ الذهاب

64
00:04:21,690 --> 00:04:24,570
.لديّ أختٌ وزوجٌ وطفل

65
00:04:25,200 --> 00:04:25,990
...لكن

66
00:04:26,410 --> 00:04:29,200
...إذا كنتَ مصرّاً على اصطحابي

67
00:04:31,290 --> 00:04:33,330
.غادر العمّ بالفعل

68
00:04:36,040 --> 00:04:38,500
،كلّما يأتي إيبّون تسوري

69
00:04:38,500 --> 00:04:40,920
.تتصرّف بغرابةٍ لسببٍ ما

70
00:04:41,050 --> 00:04:43,170
.بغرابة؟ أعتقد أنّها تصبح صامتةً تماماً

71
00:04:43,340 --> 00:04:44,630
أليس هذا واضح؟

72
00:04:46,470 --> 00:04:47,260
ما الأمر؟

73
00:04:47,390 --> 00:04:49,260
هل تعرف السبب يا يوشيواكا؟

74
00:04:51,100 --> 00:04:51,970
.إنّها تحبّه

75
00:04:55,310 --> 00:04:58,150
...لكنّها متزوّجةٌ بالفعل! هذا يعني

76
00:05:01,980 --> 00:05:04,780
،أنّ العمّ إيبون تسوري لا يصطاد الشياطين فحسب

77
00:05:05,150 --> 00:05:08,490
.بل يصطاد النساء أيضاً

78
00:05:10,740 --> 00:05:13,000
مرحباً، كيف كان حالك؟

79
00:05:14,000 --> 00:05:15,540
.كنتُ أتدرّب في البحر

80
00:05:15,830 --> 00:05:18,460
.أنا واثقٌ أنّ سحري قد تحسّن

81
00:05:21,750 --> 00:05:23,090
!هناك

82
00:05:30,300 --> 00:05:31,720
هل أفلتَ من الخطّاف؟

83
00:05:36,190 --> 00:05:38,730
.لقد عُدت. أحضرتُ الكثير من السمك

84
00:05:40,110 --> 00:05:42,020
.حتّى الأحشاء مُنظّفة

85
00:05:42,780 --> 00:05:45,150
أتوجد لدينا أيّ أصائص زهورٍ فارغةٍ يا أمّي؟

86
00:05:45,400 --> 00:05:46,530
أصائص زهور؟

87
00:05:48,410 --> 00:05:49,160
!يكفي

88
00:05:49,620 --> 00:05:51,490
لماذا تحتاج إصّيص زهور؟

89
00:05:52,950 --> 00:05:55,040
.رأي المدير فيديو السُلحفاة الذي صوّرته

90
00:05:55,580 --> 00:05:58,290
ربّما يحتاج لمكانٍ يختبئ فيه

91
00:05:59,460 --> 00:06:01,380
.حتّى يشعر بالاطمئنان

92
00:06:02,340 --> 00:06:04,710
هل السُلحفاة ذكر؟

93
00:06:06,010 --> 00:06:06,970
.لا أعرف

94
00:06:10,260 --> 00:06:11,720
.إنّه لا يتحرّك حقّاً

95
00:06:12,390 --> 00:06:13,720
أما زلتَ على قيد الحياة؟

96
00:06:17,310 --> 00:06:19,480
!تحرّك! هذا رائع

97
00:06:20,730 --> 00:06:23,270
.هل يُدغدغكَ هذا؟ تحمّل قليلاً

98
00:06:25,690 --> 00:06:26,860
أأنتَ بخير؟

99
00:06:29,780 --> 00:06:31,280
مـ-ماذا يجب أن أفعل؟

100
00:06:31,870 --> 00:06:32,620
ماذا؟

101
00:06:33,200 --> 00:06:36,500
لماذا يوجد مُلصق بيكّوري-مان هنا؟

102
00:06:51,590 --> 00:06:53,390
.لا تهتم

103
00:06:53,600 --> 00:06:55,060
!لا

104
00:06:59,850 --> 00:07:00,980
ياماتو؟

105
00:07:02,690 --> 00:07:05,940
!مـ-ماذا؟ السُلحفاة

106
00:07:06,690 --> 00:07:08,150
.كفاكَ مُزاحاً

107
00:07:08,360 --> 00:07:09,450
.هذه هي الحقيقة

108
00:07:09,860 --> 00:07:11,490
...بمجرّد ما أزلتُ المُلصق

109
00:07:12,280 --> 00:07:13,370
!كيغيكي

110
00:07:14,080 --> 00:07:14,780
كيغيكي؟

111
00:07:14,910 --> 00:07:16,330
.إنّه مُلصقٌ شيطاني

112
00:07:16,830 --> 00:07:18,080
مع أنّه بهذه اللطافة؟

113
00:07:18,120 --> 00:07:19,040
.انظر جيّداً

114
00:07:19,290 --> 00:07:21,620
.ليس مشابهاً لتصاميم الملائكة والتمائم

115
00:07:22,040 --> 00:07:24,170
السُلحفاة كيغيكي
.لا تُخدع بعينيه المُدوّرتين

116
00:07:24,540 --> 00:07:26,550
.يمكنه القيام بخدع وهمٍ سحريّة

117
00:07:27,090 --> 00:07:28,340
...وهمٍ سحري

118
00:07:28,630 --> 00:07:29,840
أين السُلحفاة البشريّة؟

119
00:07:31,880 --> 00:07:32,890
.إنّه يستحم

120
00:07:32,970 --> 00:07:35,390
.يا ويلي، نسيتُ تنظيف حوض الاستحمام-
ماذا؟-

121
00:07:35,430 --> 00:07:37,600
.ستقتلني أمّي! يجب عليّ الذهاب

122
00:07:37,600 --> 00:07:38,520
!انتظر

123
00:07:38,930 --> 00:07:40,690
.سأنام-
ماذا؟-

124
00:07:41,810 --> 00:07:43,270
.هذا مُبكّرٌ جدّاً

125
00:07:49,820 --> 00:07:50,860
.ساخن

126
00:07:59,370 --> 00:08:01,330
!أسود

127
00:08:02,330 --> 00:08:04,250
ما الخطب يا ياماتو؟

128
00:08:08,090 --> 00:08:08,880
ماذا؟

129
00:08:10,800 --> 00:08:13,550
.تبوّل أسود هنا يا ياماتو

130
00:08:13,720 --> 00:08:14,890
!سآتي في الحال

131
00:08:15,390 --> 00:08:16,260
.مؤلم

132
00:08:19,680 --> 00:08:20,520
!آسف

133
00:08:21,640 --> 00:08:22,810
...أنت

134
00:08:30,360 --> 00:08:32,150
كعك الأرزّ من مدينة فوكّورو
.هذه هديّةٌ لكِ

135
00:08:32,990 --> 00:08:34,740
.أنتَ لطيفٌ جدّاً

136
00:08:35,530 --> 00:08:36,490
.فطائر مدينة فوكّورو

137
00:08:36,740 --> 00:08:38,200
.بل كعك أرزّ مدينة فوكّورو

138
00:08:40,040 --> 00:08:40,830
أهذا هو؟

139
00:08:41,250 --> 00:08:43,500
لماذا يختبئ هنا؟

140
00:08:45,960 --> 00:08:48,420
.إنّه يشبه الروح المنزليّة أكثر من السُلحفاة

141
00:08:48,840 --> 00:08:51,050
هل وضعتَ هذا بنفسك؟

142
00:08:53,260 --> 00:08:54,800
أتعرف ما هو الدمج؟

143
00:08:58,430 --> 00:09:01,430
!أنا أحبّ بيكّوري-مان

144
00:09:01,890 --> 00:09:05,640
هل تحبّ بيكّوري-مان؟

145
00:09:09,230 --> 00:09:10,780
.يا ويلي، لا نستطيع التواصل معه

146
00:09:10,900 --> 00:09:11,980
.غبي

147
00:09:12,320 --> 00:09:14,650
هل ورّطه أحدٌ في هذا مثل جوجيكا-شان؟

148
00:09:14,700 --> 00:09:17,110
شان؟ كيف تجرؤ على مناداتها بذلك؟

149
00:09:17,740 --> 00:09:19,160
...إذا كانت حالته مثل جوجيكا

150
00:09:19,200 --> 00:09:21,040
!لا تذكر اسمها بشكلٍ عرضي

151
00:09:21,660 --> 00:09:22,750
.لا نستطيع النقاش هكذا

152
00:09:23,250 --> 00:09:24,620
هل وضعه شخصٌ ما عليه؟

153
00:09:27,000 --> 00:09:28,460
.لا يمكننا أن نعرف

154
00:09:30,710 --> 00:09:32,710
أيمكنكَ فعل شيءٍ بالناي؟

155
00:09:33,010 --> 00:09:35,630
ألا يُفترض أنّكَ قادرٌ على إخراج الشياطين؟

156
00:09:35,930 --> 00:09:37,050
هل عليّ التجريب؟

157
00:09:50,190 --> 00:09:51,520
!أنتما

158
00:09:54,570 --> 00:09:55,360
ماذا حدث؟

159
00:09:56,070 --> 00:09:57,280
ماذا هناك؟

160
00:10:09,040 --> 00:10:10,000
أأنتَ بخير؟

161
00:10:10,210 --> 00:10:11,670
.أنتَ شيطانٌ حقّاً

162
00:10:12,290 --> 00:10:14,050
...كلا، في الحقيقة

163
00:10:14,460 --> 00:10:15,710
.أنا علي بابا

164
00:10:15,880 --> 00:10:16,720
حقّاً؟

165
00:10:17,010 --> 00:10:17,930
أتعرف من يكون؟

166
00:10:18,880 --> 00:10:20,220
.إنّه إلهٌ صغيرٌ أيضاً

167
00:10:20,640 --> 00:10:23,350
.كيجين علي بابا، عدوّنا

168
00:10:25,560 --> 00:10:26,890
(كيجين علي بابا)

169
00:10:28,940 --> 00:10:30,350
(إيبّون تسوري)

170
00:10:32,150 --> 00:10:33,820
(كيجين علي بابا)

171
00:10:34,860 --> 00:10:35,690
عدو؟

172
00:10:36,360 --> 00:10:38,860
علي بابا وهود وبيتر

173
00:10:38,900 --> 00:10:42,160
.هم آلهةٌ صغار أصبحوا شياطين بعد أن تمّت شيطنتهم

174
00:10:42,950 --> 00:10:45,490
:الآلهة الصغار الثمانية الذين يخدمون العنقاء هم

175
00:10:45,870 --> 00:10:46,700
.الأمير ياماتو

176
00:10:46,950 --> 00:10:47,910
،يوشيواكا السماوي

177
00:10:48,080 --> 00:10:49,040
،جاك ابن السماء

178
00:10:49,160 --> 00:10:50,040
،روجين هود

179
00:10:50,250 --> 00:10:51,080
،بيتر جينشي

180
00:10:51,420 --> 00:10:52,420
،إيبّون تسوري

181
00:10:52,630 --> 00:10:53,540
شوكوشي

182
00:10:53,710 --> 00:10:55,050
.وكيجين علي بابا

183
00:10:55,590 --> 00:10:58,380
.كانت الرحلة إلى العالم السُفلي صعبةً جدّاً

184
00:10:58,840 --> 00:11:02,180
.أوّلاً ترك العمّ شوكوشي الفريق قبل الوصول إلى العالم السُفلي

185
00:11:02,300 --> 00:11:04,470
.نِلتُ كفايتي، اسبقوني إلى هناك

186
00:11:05,180 --> 00:11:08,230
،بعد ذلك، ازدادت قوّة الجميع

187
00:11:08,560 --> 00:11:10,560
لكن قبض الشيطان على علي بابا

188
00:11:11,190 --> 00:11:15,270
.ومن ثمّ تحوّل إلى زعيم الشياطين الضخم، شبح علي بابا

189
00:11:16,730 --> 00:11:19,030
.وبعد ذلك أصبح عدوّاً لنا

190
00:11:19,400 --> 00:11:21,320
.أنا الذي أشرح له

191
00:11:23,370 --> 00:11:26,240
.أمتلك مُلصق شبح علي بابا

192
00:11:26,410 --> 00:11:28,120
أتريد رؤيته؟-
.كلا-

193
00:11:28,540 --> 00:11:29,750
.لا أريد رؤيته

194
00:11:29,910 --> 00:11:30,790
.علي بابا

195
00:11:31,250 --> 00:11:32,500
.لكن يوجد شيءٌ لا أفهمه

196
00:11:32,920 --> 00:11:35,920
إذا كنتَ علي بابا، لماذا تحوّلتَ إلى سُلحفاة؟

197
00:11:36,380 --> 00:11:40,260
.بالفعل، سُلحفاة كيغيكي ليست على مسار مُلصق علي بابا

198
00:11:40,590 --> 00:11:43,340
ألا يمكننا الدمج باستخدام مُلصقاتٍ لا توجد على مسار المُلصقات الأخرى؟

199
00:11:43,590 --> 00:11:44,680
