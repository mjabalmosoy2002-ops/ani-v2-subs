1
00:00:06,250 --> 00:00:07,930
!ومن بعدها خرجت معه

2
00:00:07,930 --> 00:00:10,070
!حقًّا؟ مذهل

3
00:00:10,070 --> 00:00:11,440
هل لي بلحظة؟

4
00:00:12,270 --> 00:00:14,560
.لا بُدَّ أنَّكِ أوغينومي رينغو-سان

5
00:00:18,050 --> 00:00:19,740
صحيفة محليّة؟

6
00:00:20,230 --> 00:00:25,120
.أنا أجري لقائات مع عوائل ضحايا ذلك الحادث

7
00:00:25,120 --> 00:00:29,090
...لقد اكتشفتُ أنَّ الأطفال يعيشون في منزل تاكاكورا كينزان

8
00:00:29,090 --> 00:00:32,550
.بأنهم مُدّعين الإخوّة فيما بينهم

9
00:00:33,080 --> 00:00:35,770
إنَّهُ سبقُ صحفيّ. ما رأيكِ فيه؟

10
00:00:35,770 --> 00:00:37,180
...ومن بعدها، تاكيشي قالَ

11
00:00:37,180 --> 00:00:39,010
!أنت لا تعرف شيئًا

12
00:00:39,010 --> 00:00:41,430
!لا تختلق القصص من جيبك

13
00:02:13,700 --> 00:02:14,730
...حقًّا

14
00:02:15,450 --> 00:02:17,370
.لقد كنتِ تعرفين يا رينغو-تشان

15
00:02:18,990 --> 00:02:23,280
...أجل، قد ذكر شوما-كن شيء عن هذا

16
00:02:23,830 --> 00:02:26,280
.عندما كنتِ مريضة

17
00:02:26,280 --> 00:02:29,500
...لكن، ليس كأنّني أعرف التفاصيل

18
00:02:30,040 --> 00:02:31,250
.لا أمانع

19
00:02:31,250 --> 00:02:33,500
.لا أُريدُ أن أكذّبَ عليكِ يا رينغو-تشان

20
00:02:35,500 --> 00:02:39,960
!مع ذلكَ، إن قابلتُ ذاك الصحفيّ من جديد فسوف أنال منه

21
00:02:39,960 --> 00:02:42,930
!ويرتدي تلك الساعة المبتذلة أيضًا

22
00:02:43,580 --> 00:02:45,000
...ساعة

23
00:02:45,000 --> 00:02:47,470
.أنتِ أيضًا، من الأفضلِ أن تحترسي منه

24
00:02:47,950 --> 00:02:50,290
.حسنًا، شكرًا لكِ

25
00:02:52,980 --> 00:02:55,230
...قولي لي يا رينغو-تشان

26
00:02:55,580 --> 00:02:58,000
.بيتنا هو بيت ميكا-تشان

27
00:02:58,000 --> 00:03:01,200
أتقصدين بميكا-تشان هي تلك الدمية؟

28
00:03:01,320 --> 00:03:05,020
!متعة وإثارة

29
00:03:05,020 --> 00:03:07,220
!بيتٌ مُبهر

30
00:03:07,580 --> 00:03:10,660
!بيت ميكا-تشان

31
00:03:11,710 --> 00:03:14,420
.تمنيت أن أحظى بواحدٍ حقًّا عندما كنت صغيرة

32
00:03:14,420 --> 00:03:16,940
.رغمَ إن أبواي لم يشتريا لي منه أبدًا

33
00:03:16,940 --> 00:03:20,460
.فقام كان-تشان وشو-تشان بصبغ الجدران

34
00:03:32,370 --> 00:03:37,440
.كلّ يومٍ أبكي وأبكي بعدما رحل أبي وأمي

35
00:03:39,040 --> 00:03:39,900
.كنتُ خائفةً

36
00:03:40,890 --> 00:03:47,330
كلّ يومٍ جديد يُخال لي أنَّهُ سيكون اليوم الذي يرحل
.فيه كان-تشان وشو-تشان كما رحل أبواي من قبل

37
00:03:48,580 --> 00:03:50,040
...وبالتالي

38
00:04:04,740 --> 00:04:09,680
!حتّى إنّهم قاموا بصناعة فراش يشبه فراش ميكا-تشان أيضًا

39
00:04:09,680 --> 00:04:11,380
!هكذا إذن

40
00:04:11,380 --> 00:04:13,930
!لطالما ظننت أنَّني قد رأيتُه من قبل

41
00:04:14,290 --> 00:04:15,890
.كنتُ بغاية السعادة

42
00:04:16,540 --> 00:04:18,320
.إنَّهما أخوان جيّدان

43
00:04:19,020 --> 00:04:20,430
...لكن

44
00:04:25,180 --> 00:04:28,780
.إذًا، هما من خيّطا بطن دمية الدب

45
00:04:28,780 --> 00:04:30,140
.أجل

46
00:04:30,140 --> 00:04:32,000
.كان عزيزًا عليّ جدًّا

47
00:04:32,000 --> 00:04:35,720
.كما هي عادتهما، يفسدان الأمور في نهايتها

48
00:04:35,720 --> 00:04:37,540
أوليس كذلك؟

49
00:04:38,150 --> 00:04:39,630
.لكن، لا بأس

50
00:04:39,630 --> 00:04:43,550
.بطن هذه الدمية برهانٌ على إنَّنا نعيش معًا كعائلة

51
00:05:16,930 --> 00:05:17,580
!كان-تشان

52
00:05:19,230 --> 00:05:23,090
.تاكاكورا كانبا، أنا أعرف بشأن سرّك

53
00:05:23,090 --> 00:05:27,460
.أعرف طريقة جلبك للأموال لإنقاذ حياة أختك

54
00:05:28,330 --> 00:05:29,010
...هيماري

55
00:05:29,610 --> 00:05:31,020
.سوف تُشفين

56
00:05:31,020 --> 00:05:32,720
!وسأجعل ذلك يحدث

57
00:05:59,010 --> 00:06:00,370
كان-تشان؟

58
00:06:09,000 --> 00:06:12,930
هل تعلمين أنَّ علاجكِ يُكلّف ثروة؟

59
00:06:12,930 --> 00:06:15,640
لمَ تطرح عليّ هذا السؤال؟

60
00:06:15,640 --> 00:06:19,600
.ثروة، لا يمكن لطالبٍ أن يوفرها

61
00:06:20,150 --> 00:06:23,110
ما... الذي ترمي إليه؟

62
00:06:23,110 --> 00:06:28,170
.قمت بتتبع مصدر أموال أخيكِ

63
00:06:28,170 --> 00:06:29,630
.إنَّهُ سبقٌ صحفيّ

64
00:06:29,630 --> 00:06:31,880
.هؤلاء الرجال من مجموعة كيغا

65
00:06:31,880 --> 00:06:34,990
.بقايا المجموعة المتسببة بذلك الحادث

66
00:06:35,320 --> 00:06:40,180
.بمعنًى آخر، أموالهم تُدفع ثمنًا لحياتك

67
00:06:46,400 --> 00:06:47,590
.غير مجدي

68
00:06:48,150 --> 00:06:50,550
.لم تُشفَ هيماري بعد

69
00:06:50,880 --> 00:06:53,450
هل أحتاج مالًا أكثر؟

70
00:06:53,450 --> 00:06:55,970
...لكنني قد

71
00:07:11,040 --> 00:07:16,830
.الرجال الجشعونَ هم من يصوغون القوانين التي تحكم العالم

72
00:07:17,290 --> 00:07:19,530
.هذا ليسَ عدلًا

73
00:07:20,260 --> 00:07:22,790
.لم ترتكب هيماري إثمًا

74
00:07:22,790 --> 00:07:25,900
.كانبا، شوما، هيماري

75
00:07:25,900 --> 00:07:28,530
.إنَّكم جميعًا أطفالي الأعزاء

76
00:07:28,530 --> 00:07:31,120
.ومستقبلنا العزيز

77
00:07:31,120 --> 00:07:35,070
.ما زلت فخورًا بذلك القرار الذي اتخذتُه في ذلك اليوم الذي تبنيتك فيه

78
00:07:56,260 --> 00:07:58,190
.مساءُ الخير

79
00:08:02,500 --> 00:08:03,690
...هل يوجد

80
00:08:06,600 --> 00:08:09,090
هل يوجد أحد؟

81
00:08:27,330 --> 00:08:28,550
!كان-تشان

82
00:08:33,860 --> 00:08:37,290
.أهلًا في غرفة فحصي

83
00:08:37,290 --> 00:08:42,940
.ضيف اليوم هو الطبيب واشيزكا، طبيب تاكاكاورا هيماري السابق

84
00:08:42,940 --> 00:08:45,250
.مساءُ الخير

85
00:08:45,250 --> 00:08:50,060
لندخل لصلب الموضوع مباشرةً. هل تؤمن بالأشباح؟

86
00:08:50,060 --> 00:08:52,040
...أنا طبيب

87
00:08:52,040 --> 00:08:54,210
.لا أؤمن بأي شيء لم يثبته العلم

88
00:08:54,210 --> 00:08:58,670
.على ما يبدو أنَّ هنالك شخصٌ يرى الموتى

89
00:08:58,670 --> 00:09:00,430
.حتّى إنَّهُ يُحدّثهم

90
00:09:00,430 --> 00:09:03,830
.لربّما هذه آثار الهلوسة البصريّة والسمعيّة

91
00:09:03,830 --> 00:09:07,080
.وهمٌ يتكوّن من الرغبة الشديدة لرؤية شخصٍ ما مجدّدًا

92
00:09:07,780 --> 00:09:13,420
.بالمناسبة، غرفة الفحص هذه تشبه غرفتي بشكلٍ مخيفٍ

93
00:09:13,420 --> 00:09:15,680
.أو بصحيح العبارة، هي غرفتي

94
00:09:15,680 --> 00:09:16,960
.أجل

95
00:09:16,960 --> 00:09:21,490
.كنتُ أستعملها بينما كنتَ في ألمانيا

96
00:09:21,490 --> 00:09:24,120
.ماذا؟ هذه وقاحة

97
00:09:25,370 --> 00:09:27,450
ما هذه الصورة؟

98
00:09:29,090 --> 00:09:31,540
.انظر هنا

99
00:09:33,320 --> 00:09:34,680
.كلا، ليس هنا

100
00:09:34,680 --> 00:09:35,840
.نحو اليسار قليلًا

101
00:09:36,630 --> 00:09:39,210
.ليس هنا، بل للأعلى قليلًا

102
00:09:39,830 --> 00:09:40,880
.هنا

103
00:09:40,880 --> 00:09:41,970
.هذا الرجل

104
00:09:44,130 --> 00:09:47,090
.هذه منذ زمنٍ طويل

105
00:09:47,090 --> 00:09:49,940
.كان أحد مساعديي الموهوبين

106
00:09:50,270 --> 00:09:53,630
،للأسف، أصبح زعيمًا لمنظمة إجراميّة

107
00:09:53,630 --> 00:09:57,170
.ومات بعدما قام بحادثة فظيعة

108
00:09:58,180 --> 00:10:01,460
.كنت قاب قوسين أو أدنى من النجاح

109
00:10:01,460 --> 00:10:06,120
.لكن تلك الفتاة الصغيرة اللطيفة، موموكا، وقفت عقبةً في طريقي

110
00:10:06,330 --> 00:10:09,710
.عجبًا، أنت تشبهه

111
00:10:09,710 --> 00:10:12,360
في الواقع، أنت سانيتوشي-كن، أليس كذلك؟

112
00:10:12,360 --> 00:10:14,140
.أنا شبح

113
00:10:14,910 --> 00:10:18,590
.إن كانت الأشباح لم تُثبت علميًّا، فيمكنك نعتي باللعنة

114
00:10:19,130 --> 00:10:23,320
.أيُّها الطبيب، سوف أحاول مجدّدًا

115
00:10:23,920 --> 00:10:29,270
.أتباعي السابقين سيُورّثون إرادتي إلى أطفالهم

116
00:10:29,660 --> 00:10:31,320
ما رأيك؟

117
00:10:31,320 --> 00:10:32,520
أليس مثيرًا؟

118
00:10:33,910 --> 00:10:36,030
.لقد جعلتني أرتجف

119
00:10:50,060 --> 00:10:53,510
يا هذا... أنت تاكاكورا شوما-كن، أليس كذلك؟

120
00:10:59,750 --> 00:11:01,520
لم كذّبتَ علينا؟

121
00:11:02,010 --> 00:11:04,050
عمَّ تتحدّث؟

122
00:11:04,050 --> 00:11:06,230
.بشأن علاج هيماري

123
00:11:07,010 --> 00:11:09,190
من أين تأتي بالأموال؟

124
00:11:09,190 --> 00:11:11,840
ومن يأبه بالمصدر؟

125
00:11:12,830 --> 00:11:14,910
.نحن نحتاج للمال فحسب

126
00:11:14,910 --> 00:11:15,980
.وهذا فقط

127
00:11:17,090 --> 00:11:18,420
.انتظر

128
00:11:22,710 --> 00:11:25,670
.أنت تجلب المال من بقاياهم

129
00:11:26,290 --> 00:11:27,420
أليس هذا صحيحًا؟

130
00:11:29,700 --> 00:11:32,220
.تحدّثت مع أحد الصحفيّين الشعبيّين اليوم

131
00:11:32,220 --> 00:11:33,750
.كان يعرف كلّ شيء

132
00:11:33,750 --> 00:11:35,340
.عنا

133
00:11:36,390 --> 00:11:38,700
.وعن مصدر جلبك للأموال

134
00:11:38,700 --> 00:11:40,810
وماذا في ذلك؟

135
00:11:41,710 --> 00:11:47,060
.ليس كأنّك قمت بنسيان أنَّ أبوينا اقترفا أمورًا فظيعة

136
00:11:47,460 --> 00:11:50,730
...وأنت تجلب الأموال من شركائهم

137
00:11:50,730 --> 00:11:51,780
.كُفَّ عن الهراء

138
00:11:51,780 --> 00:11:56,110
.إذن، أخبرني بطريقةٍ أخرى نجلب فيها مالًا لعلاج هيماري

139
00:11:56,110 --> 00:11:58,240
.ليس بيدنا سوى هذا الخيار

140
00:12:00,340 --> 00:12:02,200
.لا تتورّط معهم

141
00:12:02,970 --> 00:12:04,260
.ها قد حُلَّت المشكلة

142
00:12:06,600 --> 00:12:08,590
.لن أُسامحك أبدًا

143
00:12:09,850 --> 00:12:11,080
إذن، ماذا ستفعل؟

144
00:12:14,870 --> 00:12:16,630
!هذا ما سأفعله

145
00:12:16,740 --> 00:12:18,930
!كانبا

146
00:12:41,060 --> 00:12:44,130
.تبًّا، عليّ أنّ أسحقهُ بأقربِ فرصةٍ

147
00:12:46,970 --> 00:12:49,370
.يبدو أنَّكِ قد تذكّرتِ كلّ شيء

148
00:12:50,030 --> 00:12:54,700
.هذا صحيح. أنا وكانبا أخوان بالدم

149
00:12:54,700 --> 00:13:03,140
.حرصًا عليّ وعلى ماريو-سان، قام كانبا بالتخلّي عن كلّ شيء وبقيَ إلى جانب أبي

150
00:13:07,870 --> 00:13:11,820
.آمل أنَّكِ قد أدركتِ أخيرًا كم كانت مدى وقاحتكِ

151
00:13:11,820 --> 00:13:17,400
.اصغي، كانبا حاليًا في وضعٍ خطيرٍ جدًّا بسببكِ

152
00:13:17,770 --> 00:13:18,610
خطير؟

153
00:13:18,610 --> 00:13:24,610
.إنَّهُ متورّطٌ مع بقايا المنظمة المسؤولة عن الحادث قبل ست عشرة سنة

154
00:13:25,290 --> 00:13:28,250
من أجل... تكاليف علاجي؟

155
00:13:28,250 --> 00:13:30,430
أليس واضحًا؟

156
00:13:30,430 --> 00:13:33,970
.كانبا يفعلُ أيَّ شيءٍ من أجلكِ

157
00:13:33,970 --> 00:13:36,500
ماذا يجب أن أفعل؟

158
00:13:37,030 --> 00:13:38,930
.علينا أن نوقف كانبا سويةً

159
00:13:38,930 --> 00:13:42,510
.بخلاف ذلك، سيقومون بقتله

160
00:13:50,760 --> 00:13:52,100
...كان-تشان

161
00:14:29,190 --> 00:14:31,230
.نحتاج إلى المال

162
00:14:31,230 --> 00:14:34,480
.هذه هي الطريقة الوحيدة لإنقاذ هيماري

163
00:14:39,800 --> 00:14:41,390
.وهنا نكتفي

164
00:14:42,000 --> 00:14:44,670
.علاقتنا تنتهي عند هذا الحدّ

165
00:14:45,140 --> 00:14:46,370
.لقد مرّت فترة طويلة

166
00:14:46,940 --> 00:14:48,750
...كلّ شيءٍ كان

167
00:14:48,750 --> 00:14:49,920
...كانبا

168
00:14:50,700 --> 00:14:51,870
ماذا تقول؟

169
00:14:55,350 --> 00:14:57,200
أولسنا إخوةً؟

170
00:14:58,000 --> 00:15:01,760
.هذا الشيء لا يفترض أن يكون له نهاية

171
00:15:02,190 --> 00:15:03,500
.كُفَّ عن هذا

172
00:15:03,500 --> 00:15:06,180
.إن الأمر هو محض صدفة ولادتنا بنفس اليوم

173
00:15:06,180 --> 00:15:07,340
.نحن غرباء

174
00:15:08,190 --> 00:15:11,490
...كنّا مختلفين منذ البداية

175
00:15:11,490 --> 00:15:14,130
.أنا وأنت وهيماري أيضًا

176
00:15:14,570 --> 00:15:17,610
.شوما، أنت لا يمكنك إنقاذ هيماري

177
00:15:19,130 --> 00:15:20,570
...كانبا

178
00:15:20,570 --> 00:15:23,530
.يمكنك الاعتماد عليّ في إنقاذ هيماري

179
00:15:24,230 --> 00:15:26,490
.فقط قف جانبًا وتفرّج

180
00:15:27,280 --> 00:15:28,890
...انتظر

181
00:15:42,870 --> 00:15:44,470
.حسنًا، هذا هوَ

182
00:15:45,410 --> 00:15:46,000
.افعلها

183
00:16:10,410 --> 00:16:12,580
!كانبا

184
00:16:15,270 --> 00:16:17,140
.قمتُ بتتبعه أخيرًا

185
00:16:17,140 --> 00:16:19,380
...هنا حيث تاكاكورا كينزان

186
00:16:36,510 --> 00:16:39,690
...هل هو حقًّا يعيش في هذه الخرابة

187
00:16:46,190 --> 00:16:48,330
مستحيل... غير معقول؟

188
00:16:48,330 --> 00:16:51,160
.إذن، تاكاكورا كينزان كان ميّتًا

189
00:16:52,000 --> 00:16:53,990
.يا للسخرية

190
00:16:53,990 --> 00:16:57,300
.انتقامنا قد انتهى منذ وقتٍ طويل

191
00:16:57,940 --> 00:16:59,790
.يا لك من رجل مثير للمتاعب

192
00:16:59,790 --> 00:17:01,250
.لقد بحثتُ عنك في كلّ مكان

193
00:17:01,670 --> 00:17:03,910
...تعال، فلنذهب

194
00:17:03,910 --> 00:17:05,210
.إلى منزلنا

195
00:17:06,150 --> 00:17:08,930
منزلنا؟

196
00:17:17,670 --> 00:17:20,060
.كانبا... قد غادر المنزل

197
00:17:21,430 --> 00:17:24,830
...لذا... فلنتوقف

198
00:17:24,830 --> 00:17:25,980
نتوقف؟

199
00:17:26,320 --> 00:17:28,980
.انتهينا من لعب لعبة العائلة

200
00:17:31,720 --> 00:17:34,100
.هذا كلّه خطئي

201
00:17:34,100 --> 00:17:36,700
.عائلتنا ما كانت لتوجد من الأساس

202
00:17:37,270 --> 00:17:40,380
.لا يمكننا أن نتظاهر بأنَّنا عائلة بعد الآن

203
00:17:41,740 --> 00:17:42,790
...شو-تشان

204
00:17:43,510 --> 00:17:46,230
.على هذا المنوال سنغدو تعساء

205
00:17:46,230 --> 00:17:48,260
.وأنتِ متضمنة أيضًا يا هيماري

206
00:17:48,640 --> 00:17:52,020
.أنا لستُ تعيسةً على الإطلاق

207
00:17:52,020 --> 00:17:52,700
...لذا

208
00:17:52,700 --> 00:17:53,600
.كلا

209
00:17:54,490 --> 00:17:56,800
.اذهبي لتعيشي مع عمي

210
00:18:01,240 --> 00:18:02,590
.فهمت

211
00:18:02,590 --> 00:18:05,190
.سأذهبُ إلى بيتِ عمي

212
00:18:11,000 --> 00:18:12,660
.حسنًا، أنا ذاهبة

213
00:18:14,190 --> 00:18:15,630
...شو-تشان

214
00:18:15,880 --> 00:18:18,620
.تفضّل. شكرًا لك على كلّ شيء

215
00:18:20,570 --> 00:18:22,660
أما زلتِ تحتفظين بها؟

216
00:18:23,250 --> 00:18:27,660
.لقد كان الوثاق الذي يربطنا فيما بيننا

217
00:18:30,820 --> 00:18:32,930
.لكنني سأُرجعه لك

218
00:18:32,930 --> 00:18:36,390
.لقد عدنا لنكون غرباء

219
00:18:37,540 --> 00:18:38,350
.أنا آسف

220
00:18:39,470 --> 00:18:45,310
...بالحقيقة، إنَّني لطالما كنت واقعةً في

221
00:18:46,260 --> 00:18:47,350
.أنا آسف

222
00:18:48,130 --> 00:18:51,270
.إنَّ أختك لا تملك وقتًا طويلًا لتعيشه

223
00:18:59,240 --> 00:19:03,120
مستحيل... لكن، أولن يُشفيَها ذلك الدواء؟

224
00:19:03,120 --> 00:19:07,340
.يفقد الدواء فعّاليّته إن استمررت في شربه

225
00:19:07,340 --> 00:19:10,550
ألم تسمع عن هذا من قبل؟

226
00:19:12,270 --> 00:19:14,730
...إذن، هيماري

227
00:19:17,780 --> 00:19:18,820
.أجل

228
00:19:19,680 --> 00:19:21,390
.إنَّها ستموت عمَّا قريب

229
00:19:46,380 --> 00:19:48,290
...وداعًا

230
00:19:52,050 --> 00:19:54,830
.يا شخصي المُقدَّر

231
00:20:29,740 --> 00:20:32,380
.أنا سأُنقذُكِ بلا أدنى شك

232
00:20:34,290 --> 00:20:35,840
.أنا معك

233
00:20:40,020 --> 00:20:42,050
.عليّ أن أوقف كان-تشان

234
00:20:42,510 --> 00:20:45,050
!حتّى لو كلّفني هذا حياتي

235
00:22:28,870 --> 00:22:31,730
.لقد كان صديقًا عزيزًا علينا

236
00:22:31,730 --> 00:22:34,330
.لا داعي لأن تقلق يا كانبا

237
00:22:34,330 --> 00:22:36,210
.أنت فردٌ من أفراد عائلتنا الآن

238
00:22:36,210 --> 00:22:38,090
.كلّ شيء على ما يرام

239
00:22:38,090 --> 00:22:43,180
.أصبح شوما-كن وكانبا-كن صديقان مُقرّبان قبل أن نُدرك ذلك

240
00:22:43,180 --> 00:22:46,200
.ستكونان أخوين حقيقيان في رمشة عين

241
00:22:48,390 --> 00:22:49,750
...كانبا

242
00:22:49,750 --> 00:22:52,130
.كما توقعت أنَّك لا تنفع

243
00:22:52,130 --> 00:22:53,850
.لم يكن عليّ اختيارك

244
00:22:54,900 --> 00:22:57,600
.لقد فشلت في العائلة

245
00:23:02,650 --> 00:23:03,820
...أبي

246
00:23:14,530 --> 00:23:16,510
.والآن لن يؤذي

247
00:23:19,120 --> 00:23:21,060
،في تلك اللحظة

248
00:23:22,440 --> 00:23:24,040
...لقد أقسمت أن

249
00:23:26,240 --> 00:23:30,410
.أرجوك أحضني كما كنت تفعل سابقًا

250
00:23:30,410 --> 00:23:33,880
.لا أمانع أن أُلعن إلى الأبد

251
00:23:35,930 --> 00:23:39,520
.استراتيجية البقاء، ليس هناك تراجع