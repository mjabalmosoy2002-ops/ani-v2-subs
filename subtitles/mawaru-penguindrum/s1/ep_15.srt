1
00:00:05,540 --> 00:00:10,640
.طالما ذلك البرج ما يزال قائمًا فلن أكون حرّة

2
00:01:43,920 --> 00:01:49,180
.لقد ربحت اليانصيب في شارع سونزوران

3
00:01:49,180 --> 00:01:52,110
!لم أتوقع أن أحرز حزمة منتجع الينابيع الحارّة

4
00:01:54,080 --> 00:01:55,720
ما خطبك؟

5
00:01:55,720 --> 00:01:58,090
قمت بدعوتك، لمَ وجهكَ مكتئب هكذا؟

6
00:01:58,730 --> 00:02:01,500
!لا تكن مكتئبًا كلّ هذا القدر فقط لأنّ فتاةً رفضتك

7
00:02:03,530 --> 00:02:06,020
!إنّه دوري

8
00:02:06,530 --> 00:02:07,850
.تبًا

9
00:02:12,020 --> 00:02:16,070
.بالمناسبة، لقد رأيت امرأةً حسناء في الممر

10
00:02:16,070 --> 00:02:18,360
!وستبات في الغرفة المجاورة

11
00:02:18,360 --> 00:02:19,410
.أنا مُتأكد من أنها مشهورة

12
00:02:19,410 --> 00:02:21,780
!لا بُدَّ أنَّها تسافر بإسمٍ مُستعار

13
00:02:22,890 --> 00:02:26,530
!ولا بُدَّ أنَّها تتضاجع مع صديقها خلف الجدار الآن

14
00:02:34,500 --> 00:02:35,460
!توقفي عن فعل هذا

15
00:02:47,680 --> 00:02:49,360
.لقد كُنت قاسيًا معها

16
00:02:50,700 --> 00:02:52,380
.سأُصغي لما ستقوله

17
00:02:55,600 --> 00:02:59,300
.شوما-كن، سوف أفقد عنان نفسي

18
00:02:59,300 --> 00:03:01,650
!فكلّ ذلك خطؤك

19
00:03:01,650 --> 00:03:05,000
.نهاية الرسالة

20
00:03:05,000 --> 00:03:07,680
-إن كنت ترغب بسماعها مجد

21
00:03:06,220 --> 00:03:07,390
ماذا؟

22
00:03:08,640 --> 00:03:10,440
ما كان هذا؟

23
00:03:15,740 --> 00:03:18,310
مرحبًا؟ أوغينومي-سان؟

24
00:03:18,310 --> 00:03:19,660
ماذا؟

25
00:03:19,660 --> 00:03:21,390
.الوقت متأخر

26
00:03:21,390 --> 00:03:26,020
.سأرحل لعالمٍ يستحيل على طفلٍ مثلك إدراكه

27
00:03:26,020 --> 00:03:28,680
ما الذي تعنينه؟

28
00:03:28,680 --> 00:03:29,640
إلى أين ستذهبين؟

29
00:03:29,910 --> 00:03:34,320
.أُوشك على تجربة أمورٍ لا يمكنك حتّى تخيّلها

30
00:03:34,320 --> 00:03:39,330
...سأنقلب رأسًا على عقب في أماكنٍ مثيرة

31
00:03:39,330 --> 00:03:41,570
!أماكن، حتّى أنا لم أرها من قبل

32
00:03:41,570 --> 00:03:42,790
!انتظري

33
00:03:42,790 --> 00:03:43,530
!لا تتهوري

34
00:03:43,930 --> 00:03:46,470
!يجب أن تراعي نفسكِ أكثر

35
00:03:46,470 --> 00:03:48,750
!لا تفعلي شيئًا غبيًا تندمين عليه لاحقًا

36
00:03:49,000 --> 00:03:53,130
.سوف أخرج من شرنقتي لأغدو فراشةً جميلة

37
00:03:53,130 --> 00:03:54,460
!إلى اللقاء

38
00:03:54,460 --> 00:03:55,450
!انتظري

39
00:03:55,450 --> 00:03:56,870
!أمامكِ حياةٌ طويلة لتعيشيها

40
00:03:56,870 --> 00:03:59,170
!للحشرات حياةٌ قصيرة

41
00:03:59,680 --> 00:04:05,340
مرحبًا؟ مرحبًا؟

42
00:04:00,880 --> 00:04:02,150
!أحمق

43
00:04:05,830 --> 00:04:07,220
!أوغينومي-سان، تماسكي

44
00:04:07,220 --> 00:04:08,590
!سآتي إليكِ

45
00:04:12,150 --> 00:04:15,980
!تبًا! أنا لستُ في طوكيو

46
00:04:19,480 --> 00:04:23,360
!يبدو أنَّ جيراننا مشغولين

47
00:04:23,360 --> 00:04:25,320
!أوغينومي-سان، أجيبي على هاتفك

48
00:04:25,320 --> 00:04:26,870
.لا تكوني خائفة

49
00:04:25,730 --> 00:04:26,870
مرحبًا؟

50
00:04:29,840 --> 00:04:32,220
أهي سادية؟

51
00:04:32,220 --> 00:04:34,260
.إنّك قاسية

52
00:04:34,260 --> 00:04:35,940
.اهدئي

53
00:04:35,940 --> 00:04:38,870
.لا تقلقي، إنّها مؤلمة بالبداية فقط

54
00:04:38,870 --> 00:04:39,980
"قاسية؟"

55
00:04:39,980 --> 00:04:41,390
"اهدئي؟"

56
00:04:41,390 --> 00:04:43,070
"!مؤلمة بالبداية فقط؟"

57
00:04:43,820 --> 00:04:48,510
.سآخذك إلى جنة الحبّ، إلدرادو المتعة

58
00:04:48,510 --> 00:04:50,430
"!جنة الحبّ؟"

59
00:04:50,430 --> 00:04:52,530
"...إلدرادو المتعة"

60
00:04:55,630 --> 00:04:56,810
!إنّهما في الغرفة المجاورة؟

61
00:05:00,560 --> 00:05:01,900
!انتظري لحظة

62
00:05:02,760 --> 00:05:05,450
يوري-سان؟

63
00:05:05,450 --> 00:05:08,530
.عجبًا! على المُهذّب أن يطرق الباب على الأقل

64
00:05:08,700 --> 00:05:10,110
...إنّكِ

65
00:05:10,320 --> 00:05:15,120
من قال أنَّ النساء يحتجن الرجال ليتمتعن؟

66
00:05:15,750 --> 00:05:19,160
.سأسلب من رينغو-تشان كنزها الثمين

67
00:05:21,080 --> 00:05:22,460
!توقّفي

68
00:05:27,670 --> 00:05:30,380
...من الرائع أن تكون شابًا

69
00:05:31,080 --> 00:05:33,660
،كفارسٍ مُدرّع يُنقذ الأميرة

70
00:05:33,660 --> 00:05:34,720
أليس لطيفًا؟

71
00:05:35,620 --> 00:05:38,380
.لو كنت أملك بعضًا من هذه العاطفة

72
00:05:38,880 --> 00:05:41,150
،لا آبه ما إن كان الآخرين يحتاجونني

73
00:05:41,150 --> 00:05:43,680
.ولا ما إن كانوا يرونني كما أنا أم لا

74
00:05:57,530 --> 00:06:02,040
.طالما ذلك البرج ما يزال قائمًا فلن أكون حرّة

75
00:06:11,640 --> 00:06:14,600
.أبي فنّانٌ مشهور

76
00:06:21,350 --> 00:06:23,770
هل تحبين الأشياء الجميلة يا يوري؟

77
00:06:24,030 --> 00:06:25,740
.نعم يا أبي

78
00:06:27,480 --> 00:06:31,160
إذن، هل تحبين أباكِ الذي يصنع أشياءً جميلة؟

79
00:06:31,620 --> 00:06:33,340
!بالطبع أحبّك

80
00:06:34,020 --> 00:06:35,790
.وأنا أيضًا

81
00:06:35,790 --> 00:06:38,670
.أو لا، يمكنني أن أحبّ الأشياء الجميلة فحسب

82
00:06:39,240 --> 00:06:40,760
.فأنا فنّان

83
00:06:41,540 --> 00:06:42,650
...يوري

84
00:06:42,650 --> 00:06:45,750
لمَ أنتِ... قبيحة؟

85
00:06:44,810 --> 00:06:45,750
قبيحة؟

86
00:06:58,020 --> 00:07:01,330
.القبيحات لا يُحبّهن أحد

87
00:07:01,330 --> 00:07:02,880
.اُنظري إلى أُمّكِ

88
00:07:03,470 --> 00:07:07,600
.أُمّكِ أصبحت أقبح حالما ولدتكِ

89
00:07:07,600 --> 00:07:12,320
.ولهذا لم يعد بإمكانها العيش هنا وانتهى بها الحال هكذا

90
00:07:12,890 --> 00:07:13,950
...أُمّي

91
00:07:14,820 --> 00:07:18,060
.كانت أُمّكِ قبيحةً وغبيةً أيضًا

92
00:07:18,060 --> 00:07:20,960
.لم يسعها فهم فنّ أبيكِ

93
00:07:22,130 --> 00:07:24,010
.اضغي جيّدًا يا يوري

94
00:07:24,010 --> 00:07:26,930
.لا أحد يُحبُّ الطفل القبيح

95
00:07:26,930 --> 00:07:28,460
.ليس لديهم حقٌّ ليُحبّهم الآخرون

96
00:07:29,540 --> 00:07:32,240
.أنتِ قبيحةٌ يا يوري

97
00:07:32,240 --> 00:07:34,460
.لن يحبَّكِ أحدٌ على هذه الوتيرة

98
00:07:34,460 --> 00:07:37,220
.وأنا مشمول طبعًا

99
00:07:37,520 --> 00:07:39,880
هل أنا شديدةُ القُبح؟

100
00:07:40,470 --> 00:07:42,000
.إنّكِ إبنةُ أُمّكِ

101
00:07:42,640 --> 00:07:46,350
،ولكن أبوكِ يمكنه قضم النجاسة منكِ

102
00:07:46,350 --> 00:07:48,930
.وسيبقى فقط ما هو جميل

103
00:07:49,760 --> 00:07:55,540
.كما نحت مايكل أنجلو تمثال ديفيد الرائع من كتلة رخام

104
00:07:55,540 --> 00:07:57,700
حقًّا؟

105
00:07:57,700 --> 00:07:58,630
.أجل

106
00:07:59,260 --> 00:08:01,410
.لذا، عندي معروفٌ لأطلبه منك

107
00:08:02,080 --> 00:08:05,830
.دعي أباكِ يحولكِ إلى جميلةٍ حقيقيّة

108
00:08:05,830 --> 00:08:08,380
.دعي أباك يُحبُّكِ

109
00:08:09,470 --> 00:08:12,630
.فأبوكِ لا يمكنه أن يحبَّ إلّا ما هو جميل

110
00:08:13,560 --> 00:08:14,520
...أبي

111
00:08:15,370 --> 00:08:17,760
.أبوكِ يريد أن يُحبَّكِ يا يوري

112
00:08:18,260 --> 00:08:19,690
!أبي

113
00:08:19,690 --> 00:08:21,430
!سأفعل أيَّ شيء

114
00:08:21,430 --> 00:08:22,970
!أي شيء

115
00:08:23,470 --> 00:08:24,960
!لذا أحببني أرجوك

116
00:08:26,310 --> 00:08:27,710
.أنتِ فتاةٌ جيدة يا يوري

117
00:08:28,690 --> 00:08:29,810
.إنّكِ فتاةٌ جيدة

118
00:08:30,520 --> 00:08:32,380
.أبوكِ سعيد

119
00:08:43,960 --> 00:08:48,980
.كان ذلك التمثال واضحًا دائمًا من نافذة ورشة عمل والدي

120
00:08:50,520 --> 00:08:55,200
.فليتشارك إثنان إثنان ويرسمان بعضيهما

121
00:08:55,200 --> 00:08:57,010
!حسنًا

122
00:08:57,620 --> 00:08:59,400
أتريدين أن ترسمي معي؟

123
00:08:59,400 --> 00:09:00,300
.أكيد

124
00:09:00,300 --> 00:09:01,800
...معلّمتي، أنَّ تاناكا-كن

125
00:09:06,810 --> 00:09:08,860
.كان مُحقًّا

126
00:09:08,860 --> 00:09:11,680
.لن يختار أحدٌ القبيح

127
00:09:11,680 --> 00:09:13,140
.أبي كان مُحقًّا

128
00:09:13,140 --> 00:09:15,500
...لذا عليَّ أن أستمرّ

129
00:09:15,500 --> 00:09:16,710
!توكيكاغو-سان

130
00:09:17,230 --> 00:09:20,280
أتريدين أن أرسمَك؟

131
00:09:21,430 --> 00:09:22,750
لمَ أنا؟

132
00:09:22,750 --> 00:09:26,110
!لأنَّكِ جميلةٌ حقًّا

133
00:09:26,110 --> 00:09:27,160
ماذا؟

134
00:09:29,120 --> 00:09:33,160
!مذهل! هذه أوّل مرّة أربح فيها ميدالية ذهبية

135
00:09:33,160 --> 00:09:36,070
!أعتقد أن من رسمتُها كانت رائعة

136
00:09:36,070 --> 00:09:37,430
.أوغينومي-سان

137
00:09:37,430 --> 00:09:38,720
.لا بأس بـ موموكا

138
00:09:39,300 --> 00:09:41,220
.هيّا، فلنرجع سويًا

139
00:09:46,490 --> 00:09:49,700
.دائمًا أُطعِمهم في طريق العودة

140
00:09:49,700 --> 00:09:51,250
أتريدين التجريب؟

141
00:09:51,850 --> 00:09:53,110
.كلا

142
00:09:53,110 --> 00:09:55,030
.لمَ؟ إنَّهما لطيفان

143
00:09:56,120 --> 00:09:57,320
.أكرهُهما

144
00:09:59,240 --> 00:10:02,110
"هل مرَّ على مسامعكِ "البطة القبيحة؟

145
00:10:02,110 --> 00:10:03,270
.نعم

146
00:10:03,270 --> 00:10:05,190
.أكرهُ هذه القصّة

147
00:10:05,190 --> 00:10:06,080
لمَ؟

148
00:10:06,610 --> 00:10:08,760
.لأنَّها مليئة بالأكاذيب

149
00:10:08,760 --> 00:10:14,530
كيفَ لبطةٍ قبيحة أن تغدو إوزةً جميلة بين ليلةٍ وضحاها؟

150
00:10:15,460 --> 00:10:17,490
.أنتِ مُحقّة

151
00:10:18,090 --> 00:10:24,940
.يجب على الشيء القبيح أن يعاني جميع الآلام ليغدو جميلًا

152
00:10:24,940 --> 00:10:28,760
...يعاني ويعاني، ثمَّ بعدها يغدو جميلًا

153
00:10:28,760 --> 00:10:30,850
.ومن بعدها، يُمكِن أن يُحبّوا

154
00:10:31,630 --> 00:10:36,170
لكن... أهنالك حقًّا بطةً قبيحة؟

155
00:10:36,760 --> 00:10:40,640
،رأيتُ إوزة صغيرة في حديقة الحيوانات

156
00:10:40,640 --> 00:10:43,450
.لكنني لم أخلها قبيحةً على الإطلاق

157
00:10:45,810 --> 00:10:48,990
.أعتقد أنَّ كلَّ ما في الدنيا جميل

158
00:10:48,990 --> 00:10:53,130
.السماء، الطيور، الحشرات، الضفادع، الأزهار وحتّى الصخور

159
00:10:53,130 --> 00:10:56,650
،إن كان الرب هو من خلق هذه الدنيا

160
00:10:56,650 --> 00:11:00,420
فهل سيكون هناك شيئًا قذرًا وقبيحًا من بين كلّ هذا؟

161
00:11:03,900 --> 00:11:05,450
.سيكون هناك

162
00:11:05,450 --> 00:11:06,770
...أبي قال لي

163
00:11:06,940 --> 00:11:08,750
أبوكِ يا توكيكاغو-سان؟

164
00:11:09,360 --> 00:11:10,690
.لا بأس بـ يوري

165
00:11:10,690 --> 00:11:11,550
!وداعًا

166
00:11:15,810 --> 00:11:17,880
.لقد رجعتِ متأخّرة

167
00:11:17,880 --> 00:11:19,480
هل تجولتِ في المدينة؟

168
00:11:19,830 --> 00:11:21,700
.نعم... بعض الشيء

169
00:11:21,700 --> 00:11:23,950
هل حصلتِ على صديقة؟

170
00:11:26,170 --> 00:11:27,100
.نعم

171
00:11:27,100 --> 00:11:30,120
هذا جيّد. هل هي جميلة؟

172
00:11:32,610 --> 00:11:33,830
.نعم

173
00:11:34,030 --> 00:11:36,290
.إذن، لا يمكنكِ الوثوق بها

174
00:11:38,250 --> 00:11:39,000
ماذا؟

175
00:11:39,000 --> 00:11:43,510
.الجميلات لطيفات نحو أيٍّ كان

176
00:11:43,510 --> 00:11:47,900
.ليُظهرن مدى جمالهن ولطافتهن

177
00:11:47,900 --> 00:11:52,170
.يقولن لكِ أنّكِ جميلة، بعدها يطعننكِ في ظهركِ

178
00:11:52,170 --> 00:11:54,270
.لا تثقي بالغرباء

179
00:11:57,430 --> 00:12:00,690
.فقط من يمكنكِ الوثوق بهم هم عائلتكِ المرتبطين بالدم

180
00:12:01,190 --> 00:12:03,000
.العائلة لا يكذبون على بعضهم

181
00:12:03,000 --> 00:12:05,990
.الحُبّ النقي والجميل موجودٌ فقط في العائلة

182
00:12:07,240 --> 00:12:09,870
.الغرباء جميعهم كأُمكِ

183
00:12:10,110 --> 00:12:11,830
.لا يوجد في حياتكِ سواي

184
00:12:11,830 --> 00:12:13,490
.ولا يوجد في حياتي سواكِ

185
00:12:13,490 --> 00:12:14,290
،ما أقصد

186
00:12:15,000 --> 00:12:18,900
.وحدي من يمكنه أن يحبّكِ حقًّا

187
00:12:21,200 --> 00:12:22,210
!أبي

188
00:12:22,940 --> 00:12:25,670
.أسرعي إلى هنا إن فهمتِ

189
00:12:25,670 --> 00:12:27,370
.حسنًا يا أبي

190
00:12:41,120 --> 00:12:43,490
!فلنذهب لمنزل تاناكا-كن بعد المدرسة

191
00:12:43,490 --> 00:12:45,200
هل أنجزتِ واجبكِ؟

192
00:12:45,990 --> 00:12:47,600
!صباح الخير يا يوري

193
00:12:48,940 --> 00:12:50,990
.لا تتحدثي إليّ مجدّدًا

194
00:12:52,100 --> 00:12:53,370
ما الخطب؟

195
00:12:54,300 --> 00:12:56,500
جرحٌ آخر؟

196
00:12:57,370 --> 00:12:59,170
.لن أثقَ بكِ

197
00:13:10,240 --> 00:13:12,810
لمَ دعوتِني إلى هنا؟

198
00:13:12,970 --> 00:13:15,990
.أريد منكِ أن تثقي بي

199
00:13:15,990 --> 00:13:17,590
!اتركيني وشأني

200
00:13:17,590 --> 00:13:22,150
.لقد رفقتِ عليّ وحدثتِني فقط لكوني قبيحة

201
00:13:22,150 --> 00:13:23,620
.هذا ليس صحيحًا

202
00:13:23,620 --> 00:13:26,060
.أُحبُّكِ كثيرًا يا يوري

203
00:13:26,060 --> 00:13:28,700
.كذّابة. أنتِ تحبين نفسكِ لأنَّكِ لطيفة

204
00:13:29,300 --> 00:13:32,910
هل ستثقين بي إن أطلعتُكِ على سرِّي؟

205
00:13:38,590 --> 00:13:39,840
أيُّ سرّ؟

206
00:13:40,280 --> 00:13:43,290
...يمكنني تغيير القدر

207
00:13:43,730 --> 00:13:47,760
.بترديد تعويذة في هذه المذكرة ودعوة الرب

208
00:13:47,960 --> 00:13:53,430
.فبذلك يمكنني تغيير القدر، كتغيير مسار القطار

209
00:13:53,430 --> 00:13:54,720
.لا يمكنني فهمكِ

210
00:13:55,190 --> 00:13:57,310
هذا سرّنا، حسنًا؟

211
00:13:57,310 --> 00:14:01,060
.غيّرتُ قدر أرنب حديقة المدرسة

212
00:14:02,030 --> 00:14:05,260
.كان المفترض لذلك الأرنب أن يموت

213
00:14:05,260 --> 00:14:09,470
.لكنّني استعملتُ التعويذة وغيّرتُ قدره

214
00:14:09,470 --> 00:14:10,290
.مستحيل

215
00:14:10,290 --> 00:14:12,990
.كان ذلك الأرنب يتمتع بالصحة التامة طوال الوقت

216
00:14:12,990 --> 00:14:17,760
.بتغيّر القدر، يتغيّر منظور العالم كذلك

217
00:14:17,760 --> 00:14:20,580
.لكن لا أحد يُلاحظ التغيير

218
00:14:21,530 --> 00:14:24,310
.لكن فقط جسدي من يتذكّر

219
00:14:25,500 --> 00:14:26,610
ما هذا؟

220
00:14:26,610 --> 00:14:28,110
.هذا الثمن

221
00:14:28,110 --> 00:14:32,020
.بتغيير القدر عليكِ أن تُعاقبي

222
00:14:34,920 --> 00:14:36,280
أتريدين التجريب؟

223
00:14:37,120 --> 00:14:39,720
أتريدين تغيير القدر يا يوري؟

224
00:14:42,910 --> 00:14:46,010
.لأنَّكِ ستموتين على هذه الوتيرة

225
00:14:46,010 --> 00:14:49,650
.لذا سأُحرّركِ بواسطة التعويذة

226
00:14:50,160 --> 00:14:53,110
-لا أُمانع وضع ضمادة أخرى لأجلكِ

227
00:14:53,420 --> 00:14:54,970
!لا تتحامقي

228
00:14:54,970 --> 00:14:57,450
أنّى لي أن أتحرّر؟

229
00:14:57,450 --> 00:14:59,220
.هذا البرج هو والدي

230
00:14:59,220 --> 00:15:00,870
.يُراقبُني دائمًا

231
00:15:00,870 --> 00:15:03,100
.طالما ذلك البرج ما يزال قائمًا فلن أكون حرّة

232
00:15:10,990 --> 00:15:12,900
.عليّ فقط إخفاء هذا البرج

233
00:15:12,900 --> 00:15:13,900
.هذا صحيح

234
00:15:13,900 --> 00:15:15,420
لا يمكنكِ فعلها؟

235
00:15:15,420 --> 00:15:17,110
.بل يمكنني

236
00:15:17,110 --> 00:15:17,930
.مستحيل

237
00:15:17,930 --> 00:15:19,310
.ليس مستحيلًا

238
00:15:20,810 --> 00:15:23,320
هل العبث مع الآخرين ممتع حقًّا؟

239
00:15:23,320 --> 00:15:25,260
لأنّني قبيحة؟

240
00:15:25,260 --> 00:15:27,110
.لكن هذا سينتهي اليوم

241
00:15:27,110 --> 00:15:28,900
،لكن أبي أخبرني

242
00:15:28,900 --> 00:15:30,280
".كلّ شيء سينتهي اليوم"

243
00:15:30,800 --> 00:15:32,110
...غدًا سوف

244
00:15:32,110 --> 00:15:32,860
!كلا

245
00:15:32,860 --> 00:15:34,310
!ستموتين قبل هذا

246
00:15:34,310 --> 00:15:36,240
!أرجوكِ توقفي

247
00:15:36,240 --> 00:15:40,350
،كلا! إن توجب عليّ العيش بلا أن أُحبّ

248
00:15:40,350 --> 00:15:42,460
!فأُفضّلُ الموت وأتحوّل إلى إوزة

249
00:15:43,150 --> 00:15:43,930
!يوري

250
00:15:43,930 --> 00:15:45,630
!كذّابة! أكرهكِ

251
00:15:50,640 --> 00:15:51,420
.يوري

252
00:15:52,320 --> 00:15:56,000
.لقد وصل الإزميل من "فلورنسا" أخيرًا

253
00:15:57,450 --> 00:15:59,350
هل أنتِ مستعدة؟

254
00:16:00,580 --> 00:16:02,940
.اليوم سننتهي

255
00:16:02,940 --> 00:16:07,520
.ستغدين شيئًا يحبُّهُ والدكِ إلى الأبد

256
00:16:07,520 --> 00:16:09,440
.تحفتي الأفضل

257
00:16:10,240 --> 00:16:12,730
هل أنتِ مستعدة؟

258
00:16:13,140 --> 00:16:15,160
.نعم يا أبي

259
00:16:22,200 --> 00:16:24,920
.ضيفاتنا القادمتان هما الثنائي أتش

260
00:16:25,150 --> 00:16:27,310
.هيباري-تشان وهيكاري-تشان

261
00:16:27,960 --> 00:16:30,630
هل هذا زيٌّ جديد؟

262
00:16:30,630 --> 00:16:33,880
!طُلبَ منا أن نُطابق أزيائنا بهذه الأوشحة

263
00:16:34,750 --> 00:16:37,600
هل هي هدية من شخصٍ مهم؟

264
00:16:37,980 --> 00:16:40,560
.إحدى صديقاتنا العزيزات أحاكتهما لنا

265
00:16:40,560 --> 00:16:43,030
!جعلتنا بغاية السعادة

266
00:16:43,030 --> 00:16:44,520
صحيح؟

267
00:16:45,420 --> 00:16:46,980
.تفضّل الثمن كاملًا

268
00:16:47,260 --> 00:16:48,860
.كم هذا مثير

269
00:16:49,210 --> 00:16:50,320
هل ارتحت الآن؟

270
00:16:50,320 --> 00:16:51,820
.اسرع بمعالجة هيماري

271
00:16:53,320 --> 00:16:54,400
.أنت ممل

272
00:16:55,720 --> 00:16:56,700
!أيها الطبيب

273
00:16:57,270 --> 00:16:59,490
هيماري... ماذا هناك؟

274
00:16:59,490 --> 00:17:02,700
...أيها الطبيب، تلك الأوشحة... الثنائي أتش

275
00:17:04,020 --> 00:17:07,230
!إنّهما ترتديان الأوشحة على التلفاز

276
00:17:07,230 --> 00:17:08,320
كيف؟

277
00:17:08,320 --> 00:17:09,100
أنت من فعلها؟

278
00:17:09,100 --> 00:17:11,550
!كم هذا مثير أيها الطبيب سانيتوشي

279
00:17:11,850 --> 00:17:14,010
.لم أفعل الكثير

280
00:17:14,230 --> 00:17:15,720
.كان-تشان، إنّه مذهل

281
00:17:15,720 --> 00:17:21,470
!لم أطلب منه، وقام بإرسال الوشاحين إلى هيباري-تشان وهيكاري-تشان

282
00:17:22,600 --> 00:17:23,930
!شكرًا لك يا أيها الطبيب

283
00:17:24,260 --> 00:17:26,900
.مع الأسف، لقد كشفتِني

284
00:17:30,280 --> 00:17:32,590
هل أنت منزعج مما فعلته؟

285
00:17:32,590 --> 00:17:34,670
.كلا، أُقدّر ذلك

286
00:17:34,670 --> 00:17:36,860
لكن كيف عرفت بشأن النجمتين؟

287
00:17:37,290 --> 00:17:41,060
.واجب الطبيب هو معرفة كلّ ما يخصُّ مرضاه

288
00:17:42,710 --> 00:17:45,750
هل أنت تشكك في حبّ أختك لك حقًّا؟

289
00:17:46,730 --> 00:17:49,800
،ألا تعتقد أنَّ العائلة نوعٌ من أنواع الخيال

290
00:17:49,800 --> 00:17:52,000
نوعٌ من أنواع اللعنات؟

291
00:17:52,890 --> 00:17:54,710
.فكّر في ذلك

292
00:17:54,710 --> 00:17:58,340
كم من طفل يعاني لمجرّد كونه مقيّد بأهله؟

293
00:17:58,960 --> 00:18:03,050
.الأهالي الذين يعاملون أطفالهم كأدوات بداعي الحبّ ينتهكونهم

294
00:18:04,020 --> 00:18:07,470
،لا يُحبون سوى أنفسهم

295
00:18:07,470 --> 00:18:11,010
،وعلى الأطفال حبّ أهاليهم فقط لكونهم عائلة

296
00:18:11,010 --> 00:18:13,040
.وحبّ أخوانهم أيضًا

297
00:18:19,960 --> 00:18:21,320
إلامَ تحاول أن ترمي؟

298
00:18:21,320 --> 00:18:22,200
.أتساءل

299
00:18:22,200 --> 00:18:25,290
.اعتقدت أنَّ ذلك ما كان يدور في بالك

300
00:18:26,200 --> 00:18:30,290
أولن تكون حياتك أسهل لو لم يكونوا أولئك هم عائلتك؟

301
00:18:30,290 --> 00:18:31,660
علامَ تتحدّث؟

302
00:18:31,660 --> 00:18:33,250
.لم تدخل فكرتك في بالي

303
00:18:33,250 --> 00:18:34,230
حقًّا؟

304
00:18:34,230 --> 00:18:35,260
.هذا جيّد إذن

305
00:18:39,710 --> 00:18:43,260
.موموكا. غيرك لا ينفع

306
00:18:44,300 --> 00:18:45,390
...لذا

307
00:18:45,390 --> 00:18:47,980
.تبًا، يجب أن أسحقها بأقرب فرصة

308
00:18:48,740 --> 00:18:50,530
هل أنهيتِ طعامكِ؟

309
00:18:51,900 --> 00:18:53,860
.عذرًا، لكن أسرعي

310
00:18:53,860 --> 00:18:54,440
.حسنًا

311
00:18:55,430 --> 00:18:58,700
بالمناسبة، هل تقابلتِ مع زبونتنا بعد؟

312
00:18:58,700 --> 00:19:02,620
.سمعتُ أنَّ ممثلةً مشهورة ستبات هنا الليلة

313
00:19:03,560 --> 00:19:07,470
.هذا كلّ ما يتحدّثون عنه في النزل

314
00:19:07,470 --> 00:19:11,290
.حتّى الطهاة يريدون الحصول على توقيعها كي يعرضونه في الرواق

315
00:19:12,390 --> 00:19:13,370
...لكن

316
00:19:13,370 --> 00:19:17,800
.لا يمكنني أن أحبّ المشاهير

317
00:19:17,800 --> 00:19:19,080
عجبًا، لمَ؟

318
00:19:19,080 --> 00:19:22,890
.دائمًا يكونون يائسين في الحب

319
00:19:22,890 --> 00:19:27,200
.لم يكن لهم حاجة عندما كانوا صغارًا

320
00:19:27,200 --> 00:19:31,350
.ولذلك بعدما كبروا، يريدون تعويض طفولتهم البائسة

321
00:19:31,640 --> 00:19:33,720
".غيرك لا ينفع"

322
00:19:33,720 --> 00:19:36,090
.دائمًا ما كانوا يسعون لسماع هذه الكلمات

323
00:19:37,200 --> 00:19:39,570
إلامَ تلمحين يا مدبرة النزل؟

324
00:19:39,900 --> 00:19:43,410
!سآخذ نصف المذكرة الآخر

325
00:20:00,370 --> 00:20:01,740
.ليس سيئًا

326
00:20:01,740 --> 00:20:04,050
.لا تتساهلي مع الممثلات

327
00:20:04,560 --> 00:20:08,850
.فهمت، أنتِ من تملكين نصف المذكرة الآخر

328
00:20:09,180 --> 00:20:10,680
وماذا إذن؟

329
00:20:10,680 --> 00:20:12,680
.لن يكون نصفًا بعد قليل

330
00:20:12,680 --> 00:20:13,810
.هذا كلّ شيء

331
00:20:14,550 --> 00:20:17,020
.لا يبدو أنّ إحدانا ستستسلم

332
00:20:17,320 --> 00:20:18,480
!إيسميرالدا

333
00:20:27,940 --> 00:20:30,890
،لا يهم كم يدللونكِ

334
00:20:30,890 --> 00:20:34,240
!فستظلين وحدكِ تستيقظين من كابوسٍ كلّ ليلة

335
00:20:34,240 --> 00:20:39,520
.امرأة مثيرة للشفقة تريد أن تكون محتاجة من قبل الآخرين لترتاح

336
00:20:39,520 --> 00:20:42,470
.تتحدّثين كما لو أنّكِ رأيتِ كلّ شيء

337
00:20:42,470 --> 00:20:47,350
.أجل، فقد أجريت أبحاثًا عنكِ

338
00:20:53,680 --> 00:20:54,870
!تبًا

339
00:20:57,040 --> 00:20:58,110
!أمسكته

340
00:21:13,450 --> 00:21:14,470
!بارد

341
00:21:16,430 --> 00:21:17,420
أوغينومي-سان؟

342
00:21:19,980 --> 00:21:22,540
...لم يحدث أي شيء

343
00:21:22,540 --> 00:21:24,470
لمَ لا تستفاد منها؟

344
00:21:24,470 --> 00:21:25,810
...يوري-سان

345
00:21:26,520 --> 00:21:31,860
.جاء أحدهم ليسرق المذكرات بينما كنت فاقدًا للوعي

346
00:21:31,860 --> 00:21:32,930
.لا تقلق

347
00:21:33,630 --> 00:21:36,890
.التقط الفأر الطعم وفرّ نحو البحر

348
00:21:37,500 --> 00:21:40,240
!يجب أن تبقي أشياءك الثمينة في مأمن

349
00:21:40,240 --> 00:21:41,360
...هذه

350
00:21:41,360 --> 00:21:44,860
.أجل، أنا من سرق النصف من رينغو-تشان

351
00:21:45,380 --> 00:21:48,820
.يجب أن أحظى بالمذكرات مهما تتطلّب الأمر

352
00:22:03,110 --> 00:22:04,170
أبي؟

353
00:22:09,020 --> 00:22:09,980
...كلا

354
00:22:09,980 --> 00:22:11,800
!لقد تغيّر برج أبي

355
00:22:16,060 --> 00:22:19,050
todokanai omoi

356
00:22:16,060 --> 00:22:19,050
مشاعرٌ لا تصلك

357
00:22:17,180 --> 00:22:19,900
!منظور العالم تغيّر حقًّا

358
00:22:19,420 --> 00:22:23,000
hikisakareteku kizuna

359
00:22:19,420 --> 00:22:23,000
وروابطٌ ممزقة

360
00:22:19,900 --> 00:22:22,320
أحقًّا كان بسبب تعويذة موموكا؟

361
00:22:22,320 --> 00:22:24,090
!اشتعلت النيران فجأةً في الفتاة

362
00:22:23,000 --> 00:22:26,640
nani mo nakatta you ni

363
00:22:23,000 --> 00:22:26,640
مهما فعلتُ لها

364
00:22:24,090 --> 00:22:25,320
كيف؟

365
00:22:25,320 --> 00:22:26,360
.ليس لديّ فكرة

366
00:22:26,640 --> 00:22:29,470
kumo wa nagarete iku sa

367
00:22:26,640 --> 00:22:29,470
فأنّها تغادر الغيوم

368
00:22:28,780 --> 00:22:29,860
!موموكا

369
00:22:29,470 --> 00:22:35,900
haiiro no suiyoubi yo

370
00:22:29,470 --> 00:22:35,900
الأربعاء ذو اللون الرمادي

371
00:22:31,230 --> 00:22:33,170
.أبي لن يعود

372
00:22:33,170 --> 00:22:35,290
.لن يعود أبدًا

373
00:22:35,290 --> 00:22:38,000
.لقد اختفى مع ذلك البرج

374
00:22:35,900 --> 00:22:43,610
saa omoidashite kagayaiteta koro wo

375
00:22:35,900 --> 00:22:43,610
والآن، تذكّر الماضي المتلألئ

376
00:22:38,440 --> 00:22:40,300
لقد استعملتِ تعويذتك؟

377
00:22:40,300 --> 00:22:41,190
.أجل

378
00:22:41,190 --> 00:22:44,590
هذا كان ثمن تحريركِ إيّاي؟

379
00:22:43,610 --> 00:22:49,740
nani mo kamo mabushikute koi ni ochiteta koro wo

380
00:22:43,610 --> 00:22:49,740
عندما كان كلَّ شيءٍ مشرق، وعندما وقعت بالحب

381
00:22:45,200 --> 00:22:46,920
لمَ أقدمتِ على فعل شيءٍ كهذا؟

382
00:22:47,170 --> 00:22:47,880
!كلا

383
00:22:48,460 --> 00:22:50,360
.لا يمكنكِ التقرّب من التغييرات

384
00:22:49,740 --> 00:22:57,060
saa omoidashite aishiatteta koro wo

385
00:22:49,740 --> 00:22:57,060
والآن، تذكّر الماضي عندما أحببنا بعضنا

386
00:22:50,360 --> 00:22:53,600
.ستفقدين أشياءً مهمّة لكِ كثمن لها

387
00:22:53,600 --> 00:22:55,890
...إذن، لمَ

388
00:22:56,630 --> 00:23:00,710
.لأنَّني أُحبُّكِ كثيرًا يا يوري

389
00:22:57,060 --> 00:23:03,900
shinken na manazashi de mitsumeatteta koro wo

390
00:22:57,060 --> 00:23:03,900
عندما نطالع عيني بعضنا

391
00:23:01,560 --> 00:23:05,410
.أنتِ جميلةٌ جدًّا في وضعكِ الحالي

392
00:23:03,910 --> 00:23:11,160
saa omoidashite kagayaiteta koro wo

393
00:23:03,910 --> 00:23:11,160
والآن، تذكّر الماضي المتلألئ

394
00:23:06,280 --> 00:23:10,190
.اختفت موموكا من بعد هذا الحادث

395
00:23:10,760 --> 00:23:12,620
.موموكا قامت بتغييرٍ آخر

396
00:23:11,160 --> 00:23:14,680
yume ni ikiteta koro wo

397
00:23:11,160 --> 00:23:14,680
عندما كُنّا نعيشُ حلمًا

398
00:23:12,620 --> 00:23:15,080
.منظور العالم تغيّر

399
00:23:14,720 --> 00:23:18,050
aishiatteta koro wo

400
00:23:14,720 --> 00:23:18,050
عندما أحببنا بعضنا

401
00:23:15,080 --> 00:23:19,490
.هذه المرّة سأستعمل تعويذات المذكرات كي أُغيّر القدر

402
00:23:19,490 --> 00:23:22,060
.سأُعيدُ موموكا إلى هذا العالم

403
