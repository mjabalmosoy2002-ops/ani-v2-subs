1
00:00:12,080 --> 00:00:13,830
...أنت كاناي هيديهكو-سان

2
00:00:15,210 --> 00:00:16,330
صحيح؟

3
00:00:17,170 --> 00:00:18,200
.أنت منتقٍ

4
00:00:21,540 --> 00:00:22,740
أأنت أيضًا؟

5
00:00:22,740 --> 00:00:24,270
—كيف تعرفين اسمي

6
00:00:24,270 --> 00:00:26,790
هل سمعتَ بـ"منظّم المعارك"؟

7
00:00:27,640 --> 00:00:30,080
.نعم، سمعت بعض الإشاعات

8
00:00:30,910 --> 00:00:36,280
يحجز "منظّم المعارك" معارك بين منتقين
.من مستويات متشابهة

9
00:00:36,950 --> 00:00:38,220
،إن قمت بعقد معه

10
00:00:38,220 --> 00:00:43,170
لن يكون عليك أن تستعجل للعثور على منافس
.عندما يدنو الوقت المحدد من الانتهاء

11
00:00:43,960 --> 00:00:46,140
.سأعرّفك عليه إن أردت

12
00:00:46,140 --> 00:00:48,310
من أنت؟

13
00:00:48,310 --> 00:00:50,160
لماذا تخبريني بهذا؟

14
00:00:52,800 --> 00:00:54,400
.لا أريد

15
00:00:54,400 --> 00:00:56,180
.تبدين وكأنّك تخطّطين لشيء ما

16
00:00:56,180 --> 00:00:57,160
.يا للأسف

17
00:00:57,970 --> 00:00:59,120
إذًا ما رأيك في هذا؟

18
00:01:02,510 --> 00:01:04,960
أتريد قتالي؟

19
00:02:39,200 --> 00:02:40,590
!هجوم

20
00:02:42,940 --> 00:02:43,390
.تصدّي

21
00:02:47,100 --> 00:02:47,730
!سُحقًا

22
00:02:48,050 --> 00:02:49,980
!هجوم! هجوم! هجوم

23
00:02:53,100 --> 00:02:55,260
!سُحقًا! إنهاء الدّور

24
00:02:55,260 --> 00:02:56,500
.ميرو، اكبري

25
00:02:56,500 --> 00:02:58,090
."استدعي ورقة "سيغني

26
00:03:00,430 --> 00:03:02,190
.وسأراهن بعُملة في نفس الوقت

27
00:03:06,940 --> 00:03:08,160
."هيجان"

28
00:03:11,360 --> 00:03:12,560
.هجوم شامل

29
00:03:17,720 --> 00:03:18,690
.إنهاء الدّور

30
00:03:18,690 --> 00:03:21,300
!حسنًا، هاجمي بكلّ ما لدينا

31
00:03:21,300 --> 00:03:22,570
!اهدأ

32
00:03:22,570 --> 00:03:25,600
!إنّها تسيطر عليك بقدرتها

33
00:03:25,600 --> 00:03:26,820
—إن استعملنا عُملتنا

34
00:03:26,820 --> 00:03:27,810
!اخرسي

35
00:03:28,090 --> 00:03:30,750
!أستطيع الفوز إن أصبتها مرة أخرى

36
00:03:31,050 --> 00:03:34,160
!استدعي ثلاثة أوراق "سيغني" وقومي بهجوم شامل

37
00:03:35,590 --> 00:03:37,970
."ورقة "فنون": "نهاية القلب

38
00:03:51,740 --> 00:03:54,250
.لم يتبقّ لديك إلاّ عُملة واحدة الآن

39
00:03:54,840 --> 00:03:58,560
إن دنا منك الموعد المحدد
...ولم تستطع العثور على خصم

40
00:04:00,340 --> 00:04:04,580
فهل تريدني أن أعرّفك إلى "منظّم المعارك"؟

41
00:04:06,270 --> 00:04:08,790
!أحسنت

42
00:04:09,600 --> 00:04:11,230
.لقد تأثّرت يا تشيناتسو-سان

43
00:04:11,600 --> 00:04:14,100
.لقد أحضرت لي عقدًا بالفعل

44
00:04:14,710 --> 00:04:16,690
.قد تكونين مناسبة لهذه المهمّة

45
00:04:17,610 --> 00:04:21,070
.ربّما أكون قد عثرتُ على شخص بموهبة لا مثيل لها

46
00:04:21,070 --> 00:04:23,330
.لم أفعل إلاّ ما أمرتني به

47
00:04:23,330 --> 00:04:25,780
!وذلك هو المذهل في الأمر

48
00:04:26,850 --> 00:04:30,500
.لا أستطيع أن أطلب من أيّ كان القيام بهذه المهمّة

49
00:04:31,240 --> 00:04:35,360
،تحتاجين أن تكوني قويّة في المعارك
.وقويّة هنا أيضًا

50
00:04:35,710 --> 00:04:37,680
،من باب الفضول فحسب

51
00:04:37,680 --> 00:04:40,630
لماذا قرّرتِ أن تقبلي؟

52
00:04:42,420 --> 00:04:44,600
.أردت الحصول على عمل بسرعة

53
00:04:45,370 --> 00:04:46,550
عمل؟

54
00:04:46,940 --> 00:04:50,590
.سأدفع لك المبلغ المتّفق عليه بالطّبع

55
00:04:51,310 --> 00:04:53,020
...حسنًا يا تشيناتسو-تشان

56
00:04:53,850 --> 00:04:56,240
.هذا هو الشّخص التّالي الّذي أريدك أن تجنّديه

57
00:05:00,280 --> 00:05:02,300
.ريو-تشان، أراك غدًا

58
00:05:02,300 --> 00:05:03,930
!حسنًا، إلى اللّقاء

59
00:05:07,460 --> 00:05:08,640
.مرحبًا

60
00:05:10,680 --> 00:05:12,430
...الآنسة المنتقية

61
00:05:13,470 --> 00:05:15,270
أتريدين القتال ثانية؟

62
00:05:15,270 --> 00:05:16,540
.لا

63
00:05:16,540 --> 00:05:18,960
.أردت اللّعب معك اليوم

64
00:05:20,240 --> 00:05:21,300
اللّعب معي؟

65
00:05:35,600 --> 00:05:37,560
فهمت... أمّك؟

66
00:05:39,600 --> 00:05:42,150
.نعم، عندما كنتُ في الصّفّ الثّالث

67
00:05:44,780 --> 00:05:46,500
.أريد رؤيتها ثانية

68
00:05:46,500 --> 00:05:50,740
.لقد واصلت الدّعاء من الرّبّ أن أتمكن من ذلك

69
00:05:51,800 --> 00:05:55,650
!ثمّ تمكّنت من أن أصبح منتقية

70
00:05:57,000 --> 00:05:59,500
.أطلقت اسم "ماما" على "لريغ" خاصّتي

71
00:05:59,500 --> 00:06:01,480
!لأنّها تشبه أمّي نوعًا ما

72
00:06:01,480 --> 00:06:03,300
.ماذا؟ هذا يسعدني

73
00:06:03,880 --> 00:06:06,290
.إنّها تصرخ في وجهي أحيانًا

74
00:06:06,290 --> 00:06:08,120
"هل قمت بواجبك؟"

75
00:06:08,120 --> 00:06:09,930
"!عليك أن تأكلي الفلفل الأخضر"

76
00:06:10,360 --> 00:06:13,090
.لا يسعني إلاّ قول تلك الأشياء عندما أراك

77
00:06:14,280 --> 00:06:16,930
!ولا يسعني إلاّ أن أصغي عندما تقولينها

78
00:06:19,400 --> 00:06:20,670
...لكن

79
00:06:20,670 --> 00:06:22,800
.إنّها ليست أمّي الحقيقيّة

80
00:06:23,610 --> 00:06:26,740
!لذلك سأستعمل المعارك لإعادة أمّي الحقيقيّة

81
00:06:27,820 --> 00:06:29,790
ألا تعرفين؟

82
00:06:29,790 --> 00:06:33,870
،بمجرّد أن نحصل على العُملات الخمسة
!يمكننا تغيير ذكرى ما إلى أيّ شيء نريده

83
00:06:34,360 --> 00:06:38,920
!سأفوز بالمعارك وأمحو ذكرى موت أمّي

84
00:06:38,920 --> 00:06:42,060
ثمّ لن تعود ميتة بعد ذلك، صحيح؟

85
00:06:45,560 --> 00:06:47,940
.أنت ذكيّة للغاية يا ريو-تشان

86
00:06:47,940 --> 00:06:49,170
أليس كذلك؟

87
00:06:53,820 --> 00:06:55,700
.اسمعي يا ريو-تشان

88
00:06:55,700 --> 00:06:59,480
عليك الفوز بالعديد من المعارك للقيام بذلك، صحيح؟

89
00:07:00,040 --> 00:07:04,740
وللقيام بذلك، عليك أن تعثري
على منتقين لقتالهم، صحيح؟

90
00:07:04,740 --> 00:07:06,190
.نعم، معك حقّ

91
00:07:06,190 --> 00:07:10,400
."أعرف شخصًا يُدعى "منظّم المعارك

92
00:07:10,400 --> 00:07:14,400
يمكنك أن تطلبي منه أن يعثر لك
.على الشّخص التّالي الّذي ستقاتلينه

93
00:07:14,400 --> 00:07:17,080
ألن يكون من المفيد معرفة شخص مثله؟

94
00:07:17,440 --> 00:07:18,910
!نعم، سيكون مفيدًا

95
00:07:18,910 --> 00:07:20,680
أين هو؟

96
00:07:43,250 --> 00:07:44,480
...أخبريني يا ريرو

97
00:07:45,100 --> 00:07:45,860
ماذا؟

98
00:07:46,080 --> 00:07:48,820
هل أنا معتمدة عليك؟

99
00:07:49,650 --> 00:07:54,070
هل كنتُ أعتمد على الآخرين كما قالت هانّا-تشان؟

100
00:07:54,720 --> 00:07:58,330
كنتُ أتساءل إن كان ذلك هو سبب
.توقّف تشي-تشان عن حبّي

101
00:07:59,240 --> 00:08:03,540
ريرو، لقد أُنشئتِ من ذكرياتي
عن تشي-تشان، صحيح؟

102
00:08:03,950 --> 00:08:04,830
.نعم

103
00:08:05,380 --> 00:08:07,980
هل تساعدينني لأنّك صديقتي؟

104
00:08:08,710 --> 00:08:10,050
...أم أنّك

105
00:08:13,350 --> 00:08:14,340
...آسفة

106
00:08:14,990 --> 00:08:16,900
ما الّذي أقوله؟

107
00:08:20,220 --> 00:08:21,420
.أنا آسفة

108
00:08:23,390 --> 00:08:25,560
.حسنًا، تفضّلي أجرك

109
00:08:26,520 --> 00:08:28,190
.لقد أضفت مبلغًا إضافيًّا

110
00:08:28,690 --> 00:08:30,660
.سعيد لعملك معي

111
00:08:30,660 --> 00:08:32,740
هل وافقت تلك الفتاة على العقد؟

112
00:08:32,960 --> 00:08:34,110
تلك الفتاة؟

113
00:08:34,110 --> 00:08:35,980
تقصدين ريو-تشان؟

114
00:08:35,980 --> 00:08:39,200
!لقد وافقت، والفضل لك

115
00:08:41,810 --> 00:08:43,660
.تبدين وكأنّك ترغبين بقول شيء ما

116
00:08:44,340 --> 00:08:47,540
هل هنالك حاجة من إقحام شخص
صغير مثلها في هذا؟

117
00:08:47,540 --> 00:08:50,170
.لا أفهم سؤالك

118
00:08:50,770 --> 00:08:52,930
،تريد دفع النّاس للقتال إلى أن ييأسوا

119
00:08:52,930 --> 00:08:55,220
ثمّ تستمتع بمشاهدتهم يعانون، صحيح؟

120
00:08:55,580 --> 00:08:57,390
تريد الفوز بالمعارك

121
00:08:57,390 --> 00:09:01,270
.فقط للهرب من حقيقة موت أمّها

122
00:09:01,270 --> 00:09:02,980
أليس المرء منّا حرًّا

123
00:09:03,920 --> 00:09:07,090
ليتمنّى أيّ مكافأة يرغب بها بعد النّصر؟

124
00:09:07,090 --> 00:09:10,700
.كما لا يمكن الهرب من المعارك

125
00:09:11,840 --> 00:09:15,230
.نحن نساعدهم قليلاً فحسب

126
00:09:15,230 --> 00:09:16,120
ماذا؟

127
00:09:16,450 --> 00:09:18,200
!مهلاً... ماذا؟

128
00:09:18,200 --> 00:09:21,880
هل تشعرين بالتّعاطف بالفعل يا تشيناتسو-تشان؟

129
00:09:22,720 --> 00:09:24,460
لأنّها تشبهك؟

130
00:09:24,460 --> 00:09:25,570
—كلاّ. أنا

131
00:09:25,570 --> 00:09:27,790
ستتخلّصين منها، صحيح؟

132
00:09:28,730 --> 00:09:30,460
أقصد ذكرياتك عن سوزوكو-تشان؟

133
00:09:30,860 --> 00:09:32,000
ماذا تحاول القول؟

134
00:09:32,270 --> 00:09:35,020
...هذا صحيح

135
00:09:35,020 --> 00:09:37,130
ماذا قلت؟

136
00:09:37,130 --> 00:09:38,230
!لقد تذكّرت

137
00:09:38,230 --> 00:09:40,960
سوف تعيشين بالطّريقة الّتي تريدينها، صحيح؟

138
00:09:41,640 --> 00:09:44,130
".سأبتّ كلّ القيود الّتي تكتّفني"

139
00:09:44,130 --> 00:09:46,200
".سأعيش بحرّيّة كما أشاء"

140
00:09:46,200 --> 00:09:51,820
سأصبح أقوى. وسأفوز بمعارك"
".المنتقين وأتخلّص منك

141
00:09:51,820 --> 00:09:52,440
صحيح؟

142
00:09:53,950 --> 00:09:57,070
.سوف تتخلّصين من القيود الّتي كتّفتك

143
00:09:57,070 --> 00:09:59,830
لكن هل تستطيعين التّخلّي عنها بالفعل؟

144
00:09:59,830 --> 00:10:00,820
ماذا تقصد؟

145
00:10:01,320 --> 00:10:06,080
لا أدري إن كان شخص تعاطف مع فتاة
.هكذا يستطيع التّخلّص منها

146
00:10:06,550 --> 00:10:08,670
.أقصد سوزوكو-تشان بهذه الأخيرة

147
00:10:08,670 --> 00:10:09,330
...تشي-تشان

148
00:10:09,840 --> 00:10:11,330
.طبعًا أستطيع

149
00:10:11,330 --> 00:10:14,000
.سوف أتخلّص من سوزوكو من أجل صالحي

150
00:10:14,000 --> 00:10:16,200
.لهذا السّبب أنا هنا

151
00:10:16,200 --> 00:10:20,600
أتطلّع قدُمًا للّحظة الّتي أراك فيها تطرحين جلدك القديم

152
00:10:20,600 --> 00:10:25,770
.وتصبحي كائنًا جميلاً وقويًّا بالفعل

153
00:10:26,090 --> 00:10:27,770
.ذلك لا يهمّ

154
00:10:27,770 --> 00:10:30,680
.سأتخلّص من سوزوكو لأسبابي الخاصّة

155
00:10:30,680 --> 00:10:32,230
.فتاة مطيعة

156
00:10:32,230 --> 00:10:35,070
.لديّ أخبار جيّدة لك

157
00:10:35,740 --> 00:10:40,030
خسرت سوزوكو-تشان معركة
!ولم يتبقّ لديها إلاّ عملة واحدة

158
00:10:42,690 --> 00:10:46,410
.لا تخذلي توقّعاتي يا تشي-تشان

159
00:11:00,400 --> 00:11:01,200
نعم؟

160
00:11:01,200 --> 00:11:01,970
.مرحبًا

161
00:11:01,970 --> 00:11:03,260
.هذا ساتومي

162
00:11:04,890 --> 00:11:07,000
.شكرًا على تلك المعركة الأخيرة

163
00:11:07,000 --> 00:11:09,780
.من المؤسف أنّ الأمر لم ينجح يا سوزوكو-تشان

164
00:11:09,780 --> 00:11:12,150
.حسنًا، أخشى أنّ لديّ معركة أخرى لك

165
00:11:20,600 --> 00:11:22,160
.لقد طلبت مقاتلتك

166
00:11:31,270 --> 00:11:34,000
...اسمعي يا تشي-تشان، أنا

167
00:11:35,870 --> 00:11:38,920
.هنالك أشياء كثيرة أردتُ قولها

168
00:11:38,920 --> 00:11:41,220
،أحيانًا، كلّ ما استطعتُ فعله هو إرسال الرّسائل

169
00:11:41,820 --> 00:11:44,260
.لكنّها عادت جميعها

170
00:11:44,730 --> 00:11:47,890
.لقد أتيت إلى منزلك مباشرة عندما عدتُ إلى هنا

171
00:11:48,280 --> 00:11:49,720
لقد انتقلتم، صحيح؟

172
00:11:49,720 --> 00:11:52,140
.ظننتُ أنّك لم تعودي تعيشين في هذه المدينة

173
00:11:52,380 --> 00:11:55,280
.لذلك كنتُ سعيدة للغاية عندما التقينا

174
00:11:55,280 --> 00:11:59,000
،سوزو، هل تعتقدين أنّ كلّ ما قلتُه كان كذبًا

175
00:11:59,000 --> 00:12:01,570
وأنّنا نستطيع أن نعود صديقتين كما كنّا؟

176
00:12:03,320 --> 00:12:04,950
.أنت لا تتغيّرين

177
00:12:05,600 --> 00:12:08,200
.لم تتغيّري حتّى الآن ولن تتغيّري

178
00:12:08,660 --> 00:12:10,620
.أنت قيدٌ يكتّفني

179
00:12:11,000 --> 00:12:13,430
.حسنًا، لنتقاتل

180
00:12:13,430 --> 00:12:14,500
.لا يمكنك الهرب

181
00:12:18,440 --> 00:12:19,610
.فتح

182
00:12:30,040 --> 00:12:32,280
.سنبدأ أوّلاً يا سوزوكو

183
00:12:33,920 --> 00:12:35,010
.اكبري

184
00:12:40,830 --> 00:12:41,940
سوزوكو؟

185
00:12:43,100 --> 00:12:46,730
.لقد انتظرتُ رسالة منك كلّ يوم

186
00:12:46,730 --> 00:12:48,910
كنتِ في فريق كرة السّلّة في الإعداديّة، صحيح؟

187
00:12:49,270 --> 00:12:51,910
.ظننتُ أنّي كنتُ مثلك

188
00:12:52,280 --> 00:12:54,660
!سوزوكو، لقد بدأت المعركة

189
00:12:55,050 --> 00:12:58,160
.قرأتُ أنّك تأملين الدّخول إلى مدرسة تحضيريّة خاصّة

190
00:12:58,160 --> 00:12:59,290
.ظننتُ أنّ ذلك من شيمك بالفعل

191
00:13:00,540 --> 00:13:04,550
،اسمعي، يتساقط الكثير من الثّلج في هوكّايدو

192
00:13:04,550 --> 00:13:07,680
