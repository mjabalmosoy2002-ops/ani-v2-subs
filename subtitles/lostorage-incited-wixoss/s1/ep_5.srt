.قالت أنّي بلا قائدة الآن

205
00:13:16,020 --> 00:13:18,270
ماذا عليّ أن أفعل؟

206
00:13:19,020 --> 00:13:20,610
.قاتلي في معارك

207
00:13:27,240 --> 00:13:28,660
سوزوكو-سان؟

208
00:13:31,080 --> 00:13:33,290
.أردتُ أن أتحدّث معك بشأن أمر ما

209
00:13:34,120 --> 00:13:35,250
.عُلم

210
00:13:38,420 --> 00:13:40,500
.هيّا، تفضّلي

211
00:13:40,500 --> 00:13:42,420
...حسنًا

212
00:13:42,420 --> 00:13:45,760
.أردتُ رأيك يا هانّا-تشان

213
00:13:47,630 --> 00:13:51,720
يبدو لي الأمر وكأنّ ذلك ليس ما كانت
.تشي-تشان تفكّر به بالفعل

214
00:13:52,760 --> 00:13:53,600
.شكّ

215
00:13:54,850 --> 00:13:57,690
ماذا قصدتِ عندما قلتِ "بالفعل"؟

216
00:13:59,150 --> 00:14:03,650
وهل الإجابة الّتي قدّمتها لك سيّئة لذلك الحدّ؟

217
00:14:04,690 --> 00:14:05,740
.تعاطف

218
00:14:06,530 --> 00:14:10,950
أليس من الجيّد إدراك من يكون المرء بالفعل؟

219
00:14:11,830 --> 00:14:14,490
،إن قرّر أحدهم أنّه لا يحتاج للصّداقة

220
00:14:14,490 --> 00:14:17,790
.علينا احترام قراره

221
00:14:18,620 --> 00:14:19,670
...لكن

222
00:14:20,290 --> 00:14:23,750
.لا أستطيع تجاهلها فحسب. نحن صديقتان

223
00:14:25,050 --> 00:14:26,340
...صديقتان

224
00:14:27,340 --> 00:14:29,260
.تأكيد. تفضّلي

225
00:14:32,100 --> 00:14:34,510
...هذا من أجل معركة

226
00:14:35,310 --> 00:14:37,520
لا بدّ أنّه خطأ ما، صحيح؟

227
00:14:37,520 --> 00:14:40,020
تتذكّرين العقد، صحيح؟

228
00:14:40,730 --> 00:14:43,860
.لا يمكنك رفض أيّ معركة بمجرّد انضمامك

229
00:14:43,860 --> 00:14:45,230
...مستحيل

230
00:15:01,500 --> 00:15:02,630
.لقد عدت

231
00:15:03,330 --> 00:15:04,710
.مرحبًا بك

232
00:15:04,710 --> 00:15:06,210
.أتيت باكرًا

233
00:15:06,210 --> 00:15:07,840
هل أنهيت عملك؟

234
00:15:07,840 --> 00:15:08,760
.نعم

235
00:15:08,760 --> 00:15:11,340
أبي، أتيت للمنزل باكرًا أيضًا؟

236
00:15:11,340 --> 00:15:12,470
.نعم

237
00:15:12,470 --> 00:15:15,600
.تشيناتسو، نريد التّحدّث معك

238
00:15:16,220 --> 00:15:17,140
ما الأمر؟

239
00:15:17,140 --> 00:15:18,270
...عزيزي

240
00:15:18,890 --> 00:15:20,770
.نـ-نعم

241
00:15:21,640 --> 00:15:24,810
...تشيناتسو، بشأن ذهابك للجامعة

242
00:15:24,810 --> 00:15:26,190
...أكره أن أخبرك بهذا، لكن

243
00:15:26,190 --> 00:15:27,400
.لن أستسلم

244
00:15:27,730 --> 00:15:31,490
.تشيناتسو، نحن لا نقول أنّه ليس بإمكانك الذّهاب

245
00:15:31,490 --> 00:15:32,320
—اختاري جامعة مختلفة فقط

246
00:15:32,320 --> 00:15:33,820
.لن أستسلم

247
00:15:34,990 --> 00:15:36,080
.أبدًا

248
00:15:36,330 --> 00:15:38,620
!تشيناتسو؟ مهلاً يا تشيناتسو

249
00:15:51,630 --> 00:15:53,010
...هانّا-تشان

250
00:15:53,010 --> 00:15:54,220
.طلب

251
00:15:54,220 --> 00:15:56,550
،إن كان هنالك شيء تريدين استعادته

252
00:15:56,550 --> 00:15:58,430
.فقاتلي بجدّ رجاءً

253
00:15:58,430 --> 00:16:00,850
!لا أستطيع قتالك

254
00:16:00,850 --> 00:16:01,810
.معقول

255
00:16:01,810 --> 00:16:04,020
.أنت وأنا منتقيتان

256
00:16:04,400 --> 00:16:08,150
.علينا استعمال المعارك للحصول على ما نريد

257
00:16:10,400 --> 00:16:11,440
.إضافة

258
00:16:11,440 --> 00:16:16,030
.السّبب الآخر هو اهتمامي البسيط بقتالك

259
00:16:16,320 --> 00:16:17,740
...هانّا-تشان

260
00:16:17,740 --> 00:16:18,700
،سوزوكو

261
00:16:19,870 --> 00:16:21,830
لماذا تقاتلين؟

262
00:16:22,540 --> 00:16:24,120
لماذا؟

263
00:16:24,120 --> 00:16:25,880
—من أجل تشي-تشان

264
00:16:25,880 --> 00:16:27,040
.تحذير

265
00:16:27,670 --> 00:16:29,710
.لا تستخفّي بالأمر

266
00:16:30,550 --> 00:16:33,170
.لا تُقاتل هذه المعارك من أجل الآخرين

267
00:16:34,260 --> 00:16:36,220
.بل تُقاتل من أجل أصحابها

268
00:16:51,530 --> 00:16:52,740
...لن أخسر

269
00:16:53,610 --> 00:16:56,610
.لن أسمح لهذا أن يهزمني

270
00:16:58,200 --> 00:17:03,120
.سأقاتل وسأحصل على ما أريد بنفسي

271
00:17:06,580 --> 00:17:07,670
."نشر الموت"

272
00:17:13,420 --> 00:17:14,670
!ريرو، اكبري

273
00:17:15,630 --> 00:17:17,550
!"استدعاء "نجم غارنيت

274
00:17:18,640 --> 00:17:20,810
...انفي مركزها

275
00:17:20,810 --> 00:17:22,390
!وهاجمي

276
00:17:36,200 --> 00:17:37,410
.غير متوقّع

277
00:17:37,820 --> 00:17:40,200
استعملت ورقة كهذه من مجموعة "الشّجاعة"؟

278
00:17:40,200 --> 00:17:43,830
.لكنّ القوّة مجرّد وعاء

279
00:17:43,830 --> 00:17:45,960
.لا معنى لها دون وجود إرادة قويّة

280
00:17:47,210 --> 00:17:48,710
!أنا مختلفة

281
00:17:50,330 --> 00:17:53,050
!اكبُري، ورهان العُملة

282
00:17:53,800 --> 00:17:54,800
."عمى"

283
00:17:57,970 --> 00:18:00,340
.لا أستطيع الرّؤية

284
00:18:00,340 --> 00:18:01,640
.إنهاء الدّور

285
00:18:02,970 --> 00:18:05,640
والآن، ماذا ستفعلين؟

286
00:18:06,020 --> 00:18:08,390
أهاجم؟ أدافع؟

287
00:18:08,390 --> 00:18:09,400
أيّهما؟

288
00:18:09,400 --> 00:18:10,350
...سوزوكو

289
00:18:11,110 --> 00:18:11,730
.عُملتك

290
00:18:13,650 --> 00:18:14,440
.نعم

291
00:18:21,410 --> 00:18:22,740
!رهان العُملة

292
00:18:25,830 --> 00:18:26,580
!"صراحة"

293
00:18:29,250 --> 00:18:30,170
ما هذا؟

294
00:18:31,130 --> 00:18:32,630
!إنّها تلمع

295
00:18:32,630 --> 00:18:35,250
.يبدو أنّها استعملت عُملتها

296
00:18:35,250 --> 00:18:36,590
!هانّا-تشان

297
00:18:36,840 --> 00:18:40,130
هل هنالك أيّ أفخاخ مخبّأة في أوراقك؟

298
00:18:40,760 --> 00:18:46,770
،ماذا؟ لن تخبريها ببساطة هكذا
أليس كذلك يا هانّا-ساما؟

299
00:18:48,430 --> 00:18:49,480
.فهم

300
00:18:50,020 --> 00:18:52,150
،الإجابة بين طيّات الكلمات المنطوقة

301
00:18:52,520 --> 00:18:54,900
.ولا يمكن تجنّب الإجابة

302
00:18:57,740 --> 00:18:58,780
.صحيح

303
00:18:59,450 --> 00:19:01,820
.أنا أخفي فخاخًا

304
00:19:01,820 --> 00:19:04,120
.لديّ طريقة لهجوم مضادّ

305
00:19:04,530 --> 00:19:05,450
!سوزوكو

306
00:19:05,450 --> 00:19:07,660
.نعم، لن أهاجم

307
00:19:07,660 --> 00:19:08,830
.إنهاء الدّور

308
00:19:15,960 --> 00:19:17,920
لا فخاخ؟

309
00:19:18,760 --> 00:19:20,840
كان الهجوم هو الحركة المناسبة؟

310
00:19:20,840 --> 00:19:22,180
.ضحك

311
00:19:22,180 --> 00:19:24,300
.أنا لم أكذب

312
00:19:25,510 --> 00:19:26,810
.فكرة ناقصة

313
00:19:27,180 --> 00:19:30,060
.لم تسألي أبدًا أين هي فخاخي

314
00:19:30,430 --> 00:19:31,480
...مستحيل

315
00:19:31,730 --> 00:19:32,900
.أكيد

316
00:19:32,900 --> 00:19:34,360
!لقد فُزت

317
00:19:34,360 --> 00:19:36,150
!"هاجمي بورقتَيْ "أويغونا

318
00:19:44,740 --> 00:19:46,080
!ريرو

319
00:19:51,870 --> 00:19:52,920
...ريرو

320
00:19:54,830 --> 00:19:58,130
ماذا فعلتُ يا ريرو؟

321
00:19:58,130 --> 00:19:59,130
.ضعف

322
00:19:59,800 --> 00:20:01,840
أوّلاً تشيناتسو-سان، والآن ريرو-سان؟

323
00:20:03,300 --> 00:20:04,140
.نصيحة

324
00:20:04,680 --> 00:20:08,010
.أنت بصفتك منتقية، من تُقاتلين

325
00:20:08,970 --> 00:20:13,020
هل تنوين الاستمرار في إشاحة
عينيك عن هذه الحقيقة؟

326
00:20:15,270 --> 00:20:18,230
...سوزوكو، ما أمرك التّالي

327
00:20:18,860 --> 00:20:20,190
.إنهاء الدّور

328
00:20:20,190 --> 00:20:21,360
!سوزوكو

329
00:20:21,820 --> 00:20:22,740
.خلاصة

330
00:20:23,360 --> 00:20:25,070
.نحن منتقين

331
00:20:25,570 --> 00:20:29,080
.هنالك فائزون وخاسرون في كلّ الأوقات

332
00:20:30,490 --> 00:20:32,330
!"البوّابة القديمة"

333
00:20:38,630 --> 00:20:41,010
.لم تتغيّري أبدًا

334
00:20:42,010 --> 00:20:45,340
.لا تستعمليني من أجل أهدافك بعد الآن

335
00:20:48,010 --> 00:20:49,310
.مع السّلامة

336
00:20:55,140 --> 00:20:56,350
.واحدة أخرى فحسب

337
00:21:10,450 --> 00:21:11,370
لماذا؟

338
00:21:13,830 --> 00:21:16,790
لماذا عليّ القتال في هذه المعارك؟

339
00:21:22,510 --> 00:21:23,710
لماذا؟

340
00:21:24,470 --> 00:21:26,180
.أثبتي الأمر فحسب

341
00:21:27,130 --> 00:21:29,390
...إن كنتِ تعتقدين أنّك على صواب

342
00:21:30,510 --> 00:21:33,390
...إن كنتِ تريدي ألاّ تخسري بالفعل

343
00:21:34,140 --> 00:21:35,940
.استعمليني إذًا

344
00:21:36,310 --> 00:21:37,270
ريرو؟

345
00:21:39,900 --> 00:21:40,730
مرحبًا؟

346
00:21:41,650 --> 00:21:44,990
.نعم، دعني أتولّى تلك المهمّة

347
00:21:52,660 --> 00:21:55,410
.لن أخسر

348
00:23:26,380 --> 00:23:28,960
هل يمكنني أن أعرفّك إلى "منظّم المعارك"؟

349
00:23:28,510 --> 00:23:29,720
أيمكنك التّخلّي عن الأمر بالفعل؟

350
00:23:29,720 --> 00:23:30,880
.والآن، لنتقاتل

351
00:23:30,470 --> 00:23:31,550
.لا يمكنك الهرب

352
00:23:31,340 --> 00:23:33,640
.سوف تختفين إن خسرت هذا الفتال

353
00:23:33,510 --> 00:23:34,470
!هجوم

354
00:23:34,260 --> 00:23:36,350
!اختفي! لا أريد أن أراك ثانية

355
00:23:36,220 --> 00:23:37,560
...إن اختفيت

356
00:23:38,100 --> 00:23:41,020
."في الحلقة القادمة: "معركة / ماضٍ وحاضر