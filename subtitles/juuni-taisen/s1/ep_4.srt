1
00:00:29,190 --> 00:00:31,040
رائع يا شاريو

2
00:00:31,040 --> 00:00:36,930
شَطْرُ صخرة كبيرة كهذه من دون جهد
بتحويل مُستوٍ بداخلها إلى رمل

3
00:00:36,930 --> 00:00:39,870
دلالةٌ على أنّكِ بلغتِ المرحلة التي

4
00:00:39,870 --> 00:00:43,310
يمكنكِ فيها تغيير حالة أي مادّة
إلى حالةٍ أخرى

5
00:00:43,310 --> 00:00:46,170
،لقد ربّينا كثيراً من التّلاميذ في عصرِنا

6
00:00:46,170 --> 00:00:49,580
لكن إتقانكِ للمهاراتِ لم يسبق له مثيل

7
00:00:49,580 --> 00:00:52,180
تشرّفني كلماتكم يا أسيادي

8
00:00:52,450 --> 00:00:56,050
لم يعُد هناك ما نعلّمكِ إيّاه

9
00:00:56,050 --> 00:00:59,090
غادري هذا المكان وافعلي ما تشائين

10
00:00:59,090 --> 00:01:02,620
طريقةُ استخدامكِ لهذه القوّة عائدة إليكِ

11
00:01:02,620 --> 00:01:03,950
لن نتدخّل

12
00:01:04,180 --> 00:01:05,070
حاضرة

13
00:01:05,070 --> 00:01:10,580
آمل أن أستخدم القوّة لتحويلِ كلّ شيء
لمنفعة كلّ شيء

14
00:01:10,930 --> 00:01:16,460
أريد تكريس حياتي لاستئصالِ جنون
القتلِ عن هذا العالم

15
00:01:16,730 --> 00:01:20,000
أخبرتَها أن تفعل ما تشاء، لكن... أصحيح
يا حجر لا يتكلّم؟

16
00:01:20,000 --> 00:01:23,930
أعتقد أنّ بُخار لا يسمع هو من قال ذلك

17
00:01:23,930 --> 00:01:28,600
لستُ متيقّناً، مع أنّه يبدو كلاماً قد أقوله بالفعل

18
00:01:28,600 --> 00:01:36,400
لا يوجدُ أي تعارض بين معرفتِنا وسماتنا الشخصيّة
أو حالاتنا النفسيّة نحن الثّلاثة

19
00:01:36,400 --> 00:01:40,170
لا يوجد سببٌ يمنعنا من أن نكون مُتوحّدين

20
00:01:40,170 --> 00:01:42,670
لا نتجادل أبداً

21
00:01:42,670 --> 00:01:47,250
لو أصبح العالمُ مثلنا، لما كان هُناك
...مزيد من القِتال على الأرجح، لكن

22
00:01:47,250 --> 00:01:50,070
العالمُ قاسي الفُؤاد يا شاريو

23
00:01:50,070 --> 00:01:53,260
أتفهّم أنّ العالم ليس لطيفاً

24
00:01:53,260 --> 00:01:53,990
...ومع ذلك

25
00:01:54,780 --> 00:01:57,310
لن أعرف ما لم أحاول، أليس كذلك؟

26
00:03:34,310 --> 00:03:36,260
...تِلك المُخطِّطة

27
00:03:36,260 --> 00:03:38,610
أو بالأحرى، تِلك الفتاة الجبانة

28
00:03:39,020 --> 00:03:41,730
على الأرجح قد ماتت الآن

29
00:03:42,940 --> 00:03:45,490
ما الذي يجعلك تعتقد ذلك يا نيزومي-كن؟

30
00:03:45,490 --> 00:03:49,380
أهذه إحدى مواهبك كمُحارب؟

31
00:03:49,380 --> 00:03:51,620
ليسَت موهبة على وجه الدقّة

32
00:03:51,970 --> 00:03:54,130
...كلّ ما في الأمر

33
00:03:54,130 --> 00:03:59,280
تعلم الجرذان دوماً متى تهرب
من سفينةٍ غارِقة

34
00:03:59,280 --> 00:04:02,750
ربّما يمكننا أن نقرأ علامةَ الموت
على وجهِ شخص أيضاً

35
00:04:03,320 --> 00:04:09,250
لكن إن ماتَتْ، فستكون غلطتكِ أنتِ
يا آنسة شاريو

36
00:04:09,840 --> 00:04:12,640
ما الذي يجعلك تعتقد ذلك؟

37
00:04:13,180 --> 00:04:17,560
لعلّها لم تبدُ ماهرة، لكنّها تبقى محاربة

38
00:04:17,560 --> 00:04:21,140
لا بدَّ وأنّها كانت تمتلِك مُقوّمات
النجاة في جوني تايسِن

39
00:04:21,780 --> 00:04:27,420
،لكن بينما كانَتْ تتكلّم معكِ
بدأتْ تضعف شيئاً فشيئاً

40
00:04:27,870 --> 00:04:31,830
المُحارِبة التي كانت مجرّد جبانة
غدَتْ ضعيفة جدّاً

41
00:04:31,830 --> 00:04:34,580
تفاؤلكِ أصلحها

42
00:04:35,250 --> 00:04:36,910
،بالنسبةِ لمُحتالة مثلها

43
00:04:36,910 --> 00:04:38,930
طبيعتكِ غير السامّة قد تكون سامّة

44
00:04:39,750 --> 00:04:42,260
...المعذرة يا نيزومي-كن

45
00:04:42,260 --> 00:04:46,770
لا أملك إلّا أن أشعر بأنّك تحاول
افتعال شِجار معي الآن

46
00:04:46,770 --> 00:04:50,150
آسفة، لكن أنا بليدةٌ في استيعاب
أشياء كهذه

47
00:04:50,720 --> 00:04:53,510
سألغي الحديث عن الموضوع إذاً

48
00:04:53,960 --> 00:04:58,060
يمكنني قِراءة علامة الموت على وجهِ شخص
لكن لا يمكنني قراءة عقله

49
00:04:58,610 --> 00:05:01,570
،لن تتمكّني من إصلاحي مهما حدث

50
00:05:01,570 --> 00:05:03,510
لذا لا داعي للقلقِ حيال ذلك

51
00:05:04,160 --> 00:05:07,020
لكن كيف سيسير هذا الأمر؟

52
00:05:07,030 --> 00:05:11,040
،إذا تكلّمنا بواقعيّة، إن ماتَتْ تلك الفتاة

53
00:05:11,040 --> 00:05:15,820
،فهذا يعني أنّ أربعة مُحاربين قد ماتوا
وهذا ممّا نعرفه فقط

54
00:05:15,820 --> 00:05:17,480
أي ثُلث عددنا

55
00:05:17,870 --> 00:05:20,680
هل ما زالت خطّتكِ للفوزِ ستنجح؟

56
00:05:20,680 --> 00:05:21,920
أجل

57
00:05:22,630 --> 00:05:26,050
،من المؤسف أن يقلّ عددُ الذين سننقذهم
هذا ما في الأمر

58
00:05:26,050 --> 00:05:29,600
لكن يبدو أنّك تسيئ الفهم، لذا
دعني أقول لك

59
00:05:29,600 --> 00:05:32,360
لديّ أكثر من خطّة واحدة للفوز

60
00:05:32,720 --> 00:05:33,860
حقّاً؟

61
00:05:35,100 --> 00:05:40,040
لستُ متفائلة يائسة لأعتقد أنّ بمقدوري
إنهاء جوني تايسِن

62
00:05:40,040 --> 00:05:41,350
بخطّةٍ واحدةٍ فقط

63
00:05:42,650 --> 00:05:47,030
حسناً، لم أفكّر بكيفيّة إنهاء حرب من قبل

64
00:05:47,030 --> 00:05:48,990
لذا سأترك هذا الأمر لكِ على ما أعتقد

65
00:05:49,500 --> 00:05:50,920
...يا نيزومي-كن

66
00:05:50,920 --> 00:05:51,620
ماذا؟

67
00:05:52,050 --> 00:05:55,960
أنت لا تريد إيقاف الحرب فعليّاً، أليس كذلك؟

68
00:05:55,960 --> 00:05:59,070
وقلتَ أيضاً أنّك لن تُصلَح

69
00:05:59,080 --> 00:06:03,000
،في هذه الحالة، لماذا وافقتَ، ولو بغير حماس

70
00:06:03,000 --> 00:06:04,510
على اتّفاقية السّلام خاصّتي؟

71
00:06:04,930 --> 00:06:09,180
اتّفاقية السّلام هي شيء آخر، لكنّي أكره
السّلام بحدّ ذاته

72
00:06:09,670 --> 00:06:13,660
عندما لا أكون في ساحةِ المعركة، أذهب
إلى المدرسة الثانويّة

73
00:06:13,980 --> 00:06:16,900
إنّها مليئة بالناس الحُثالة المُخدّرين بالسّلام

74
00:06:17,230 --> 00:06:21,900
عندما أفكّر في المخاطرةِ بحياتي
لحمايةِ نمط حياة حُثالة مثلهم

75
00:06:21,900 --> 00:06:23,400
أشعر بالاشمئزاز الحقيقيّ

76
00:06:23,770 --> 00:06:25,590
ألم تقرفي من ذلك يوماً؟

77
00:06:25,900 --> 00:06:29,880
لم ينقذ أحدٌ في العالمِ أناساً مثلما أنقذتِ

78
00:06:30,220 --> 00:06:34,550
لكن في قانونِ النسب الحسابيّة فقد أنقذتِ
كثيراً من الحُثالة أيضاً

79
00:06:34,950 --> 00:06:38,400
يُمكن للمرء أن يقول أنّ إنقاذهم
هو ما يحوّلهم إلى حُثالة

80
00:06:38,400 --> 00:06:42,310
يبدؤون بالاعتقادِ أنّ القتال والقتل
هما عملُ شخصٍ آخر

81
00:06:42,310 --> 00:06:44,420
...لا أحبّذ قول هذا، لكن حقّاً

82
00:06:44,420 --> 00:06:47,220
كلّما حميتُهم أكثر، شعرتُ
برغبةٍ أكبر في قتلهم

83
00:06:47,590 --> 00:06:49,480
أخبريني أيتها المُسالمة

84
00:06:49,480 --> 00:06:52,550
كيف تقنعين نفسك بذلك؟

85
00:07:02,300 --> 00:07:04,760
مخاوفه تشير إلى حساسيّة صبيانيّة

86
00:07:04,760 --> 00:07:07,350
من السّهل التّمييز بأنه مُراهق

87
00:07:08,490 --> 00:07:11,390
لكن أعتقد أنّه سيكون من
المبالغةِ في التبسيط أن أردّه

88
00:07:11,390 --> 00:07:13,640
"بجملة "ستفهم عندما تكبر

89
00:07:16,440 --> 00:07:20,080
اسمعي، كم مرّة يجب أن أكرّر كلامي؟

90
00:07:20,080 --> 00:07:22,370
المشكلة غير موجودة

91
00:07:22,370 --> 00:07:26,260
تِلك الأرض تنتمي لبلدِنا منذ قرون

92
00:07:26,260 --> 00:07:31,960
إذا كانت المُشكلة غير موجودة فلماذا
ما زال بلدانا ما يزالان يتحاربان؟

93
00:07:32,190 --> 00:07:35,460
لأنّ بلدكم لا يتقبّل الحقائق

94
00:07:35,460 --> 00:07:37,510
بلدكم هو الذي لا يتقبّل الحقائق

95
00:07:37,510 --> 00:07:39,640
—أقول لكِ لأنّ بلدكم

96
00:07:39,640 --> 00:07:41,110
لنُوقف هذه المُشاحنة

97
00:07:41,110 --> 00:07:42,430
هلّا سمحتما لي؟

98
00:07:43,280 --> 00:07:47,900
أنا أيضاً أعتقد أنّ هذه المعركة لا يمكن إنهاؤها

99
00:07:48,310 --> 00:07:51,650
هدفي ليس الإنهاء، إنّما وقف إطلاق النّار

100
00:07:51,650 --> 00:07:53,070
وقف إطلاق النّار؟

101
00:07:53,070 --> 00:07:54,820
يا له من هُراء

102
00:07:54,820 --> 00:07:58,980
لقد تخطّينا المرحلة التي يمكننا فيها
تأجيل حلّ المشكلة لوقتٍ آخر

103
00:07:58,980 --> 00:08:02,790
كمُفاوضة، لديكِ تاريخٌ
حافل بالحصول على نتائج

104
00:08:03,360 --> 00:08:08,780
سمعتُ أنّكِ أنهيتِ 300 صِراع دوليّ
وأكثر من 200 حرب أهليّة

105
00:08:09,190 --> 00:08:12,800
فيما يخصُّ تلك النقطة، لا تنتابنا أي شكوك

106
00:08:13,110 --> 00:08:14,430
شكراً لكِ

107
00:08:14,760 --> 00:08:18,730
لكن سبب اقتتالنا مُعقّد

108
00:08:19,080 --> 00:08:20,990
ينبغي أن تكوني قد علمتِ ذلك الآن

109
00:08:21,790 --> 00:08:23,450
انظرا هناك

110
00:08:24,360 --> 00:08:26,810
المنطِقة بين بلديكما

111
00:08:26,810 --> 00:08:32,060
النّزاع المُحيط بتلك المنطقة كان يستعرّ
لأكثر من سبعين عاماً

112
00:08:32,560 --> 00:08:35,390
،هذه المعركة المستمرّة، والتي لا تفسح مجالاً للمُساومة

113
00:08:35,390 --> 00:08:37,450
قد غدت غير مُثمرة بالمطلق

114
00:08:37,760 --> 00:08:40,610
بالفعل. "غير مثُمرة" هو تعبير مُخفَّف

115
00:08:40,610 --> 00:08:43,690
أليس هذا لأنّكم تتظاهرون بتجاهلِ القضايا؟

116
00:08:43,690 --> 00:08:44,490
—أقول لكِ

117
00:08:44,490 --> 00:08:47,090
كفّ عن قول المزيد لي

118
00:08:47,090 --> 00:08:48,500
أمسى الأمر مُضجِراً للغاية

119
00:08:48,500 --> 00:08:49,990
!دعيني أقول هذا إذاً

120
00:08:49,990 --> 00:08:52,260
!بلدي هو المُحقّ قانونياً هنا

121
00:08:52,260 --> 00:08:57,330
أقول أنّ مفاوضتكما أصبحت غير مُثمِرة

122
00:08:57,830 --> 00:09:00,810
،على ضوءِ المُعاهدة التي أبرمناها منذ قرن

123
00:09:00,810 --> 00:09:03,970
اعترفَ بلدكم بأنّ تِلك الأرض تنتمي لنا

124
00:09:03,980 --> 00:09:07,400
هل أصيبُ إذا قلتُ أنّ سبب استمرار

125
00:09:07,400 --> 00:09:11,360
حربكما كلّ هذه المدّة الطويلة
هو لأجلِ هيبة بلدكما

126
00:09:11,360 --> 00:09:12,870
أكثر من أن يكون لأجلِ شعبكما؟

127
00:09:13,150 --> 00:09:16,970
أقول لكِ أنّهم هُم من هاجمونا

128
00:09:16,970 --> 00:09:18,610
لم تكن رغبتنا القِتال

129
00:09:19,000 --> 00:09:22,230
إذاً لمَ لا ترموا أسلحتكم أوّلاً؟

130
00:09:22,230 --> 00:09:25,680
لا يمكننا أن نرمي أسلحتنا الدفاعيّة
!ونحن نتعرّض لهجوم

131
00:09:25,680 --> 00:09:26,700
توقّفا من فضلكما

132
00:09:27,960 --> 00:09:31,450
هذه الأرض لم تكن لأي من بلدكما في الأساس

133
00:09:31,970 --> 00:09:33,370
كان ذلك منذ زمنٍ بعيد

134
00:09:33,870 --> 00:09:36,630
البلد التي كانت عليها كانت قد
تفكّكت وفقدَتْ استقلاليّتها

135
00:09:37,470 --> 00:09:39,380
فتبنّى بلدنا حكمها

136
00:09:39,380 --> 00:09:41,080
تقصدين أنّكم غزوتموها

137
00:09:41,080 --> 00:09:44,100
لهذا خطرت على بالي فِكرة

138
00:09:44,590 --> 00:09:45,530
فكرة؟

139
00:09:47,370 --> 00:09:48,450
ادخل

140
00:09:49,230 --> 00:09:50,890
أعتذر عن مُقاطعة المؤتمر

141
00:09:53,040 --> 00:09:55,630
فرّ عددٌ كبيرٌ من الجيش

142
00:09:55,630 --> 00:09:56,490
ماذا؟

143
00:09:56,910 --> 00:10:00,570
سلّحوا أنفسهم وأعلنوا أنّهم لن يُشاركوا في الحرب

144
00:10:00,790 --> 00:10:03,440
ويتبعهم عددٌ آخر لا يُحصى

145
00:10:03,440 --> 00:10:06,100
ويطالبون بوقفِ إطلاق النار

146
00:10:06,100 --> 00:10:07,340
ماذا؟

147
00:10:08,290 --> 00:10:10,650
أريد التفاصيل حالما ينتهي هذا الحوار

148
00:10:09,580 --> 00:10:10,330
ماذا؟

149
00:10:10,650 --> 00:10:11,900
اجمع الرّجال

150
00:10:11,900 --> 00:10:12,400
حاضر

151
00:10:12,400 --> 00:10:13,960
...هذا مستحيل

152
00:10:12,810 --> 00:10:14,640
سأنصرف إذاً

153
00:10:14,640 --> 00:10:17,380
حسناً. أكِّد المسألة بسرعة

154
00:10:17,930 --> 00:10:19,300
ما الذي يجري؟

155
00:10:19,680 --> 00:10:22,060
المعذرة، لكن ثمّة أمر قد استرعى

156
00:10:22,060 --> 00:10:25,520
انتباهي ويجب أن أذهب لمعالجته حالاً

157
00:10:24,440 --> 00:10:26,490
جنود خطّ الجبهة ينسحبون

158
00:10:26,490 --> 00:10:28,600
ويطلبون وقفاً لإطلاق النار، صحيح؟

159
00:10:28,900 --> 00:10:31,610
هل يُعقَل أن تكوني... أنتِ وراء هذا؟

160
00:10:32,050 --> 00:10:35,850
إنّهم من سلالة سكّان تلك البلد السّابقة

161
00:10:36,500 --> 00:10:41,530
ينسحِبون من حربكم باسمِ الاستقلال

162
00:10:42,670 --> 00:10:44,980
هل ستنجح تلك الطريقة حقّاً؟

163
00:10:45,610 --> 00:10:48,440
كلا البلدين مُنهكان بالفعل

164
00:10:48,830 --> 00:10:52,980
إن أنقصتُم عدد قوّاتهم أكثر واكتسبتم الرأي العامّ

165
00:10:52,980 --> 00:10:55,250
سيصبح وقف إطلاق النّار أمراً محتوماً

166
00:10:55,730 --> 00:10:59,950
لا أنكر أنّ الجنود في خطوط الجبهة
قد وصلوا لمرحلةِ الإحباط

167
00:10:59,950 --> 00:11:05,510
لكن لستُ متيقّناً من قدرتنا على التوحّد
بعد كلّ هذا القتل من كلا الطرفين

168
00:11:05,800 --> 00:11:07,440
أنا متأكّدة أنّه ستكون هُناك أحقاد

169
00:11:07,970 --> 00:11:12,320
لكن أعتقد أنّهم سئموا من هذه الحرب
مثلما سئمت أنت

170
00:11:12,320 --> 00:11:15,710
فرض وقف إطلاق النّار تحت ذريعة
...استعادة وطننا

171
00:11:15,710 --> 00:11:20,090
ليس في حيلتي الكثير لأفعله، لكن
سأدعمكم بقدر استطاعتي

172
00:11:21,080 --> 00:11:25,410
لكن في كلّ الحالات والظروف، لن تعرف ما لم تحاول

173
00:11:26,700 --> 00:11:30,410
،في حين أنّكما مهووسان بهذه النقاشات غير المُثمرة

174
00:11:30,410 --> 00:11:35,210
إلّا أنّكما لا تعرفان شيئاً عن معاناة
الجنود وهلاكهم في خطوط الجبهة

175
00:11:36,130 --> 00:11:39,870
حماقتكما وجهلكما هما ما أدّيا إلى هذا الوضع

176
00:11:40,490 --> 00:11:44,300
لم تعد هذه مُشكلة مقتصرة على بلديكما

177
00:11:44,750 --> 00:11:47,210
سأنشر الرّسالة في كلّ أنحاء المعمورة

178
00:11:47,830 --> 00:11:51,330
"إن كنتم لا تريدون القتال، فتعالوا إلى هذه الأرض"

179
00:11:52,450 --> 00:11:54,400
!وقف إطلاق النّار

180
00:12:02,940 --> 00:12:05,170
أجل، عمَّ السّلام

181
00:12:05,900 --> 00:12:09,680
لكن لم يكن السّلام الذي تمنّيتُه

182
00:12:12,330 --> 00:12:16,420
في وجه المنطِقة المُتنازَع عليها
لإخضاعِ الجيش المتمرّد

183
00:12:17,460 --> 00:12:22,560
إنّ تشكيل قوّة ثالثة، الجيش المتمرّد، قد
اعتُبِرَ خطراً جسيماً

184
00:12:22,560 --> 00:12:25,140
بواسطة قادة قوّات الحلف، الذين أمروا بتنفيذ

185
00:12:25,140 --> 00:12:27,760
عمليّة بحث وتدمير واسعة النطاق

186
00:12:28,100 --> 00:12:31,520
،انتهى القتال في مُعظم أجزاء المنطقة

187
00:12:31,520 --> 00:12:33,020
يحدث هذا كثيراً

188
00:12:31,520 --> 00:12:34,230
لكن يبدو أنّ بعض المتمرّدين ما زالوا يُقاومون

189
00:12:33,400 --> 00:12:37,330
أجل، يحدث هذا الأمر كثيراً

190
00:12:38,430 --> 00:12:41,470
عاطفيّتي لا تساعد أحداً

191
00:12:54,740 --> 00:12:58,450
كلّ ما يمكنني فعله هو الردّ بالانفتاح والصّراحة

192
00:12:58,450 --> 00:13:04,450
استناداً إلى الأشياء التي رأيتُها وعشتُها

193
00:13:06,760 --> 00:13:10,290
لا أصنع السّلام بها. بل أحمله معي

194
00:13:10,880 --> 00:13:14,680
هكذا إذاً. استجابة ورعة مُمتازة

195
00:13:15,240 --> 00:13:17,200
لكنّها لن تصل للجماهير

196
00:13:17,630 --> 00:13:20,810
تبذلين جهداً كبيراً ووقتاً طويلاً
في مُفاوضات السّلام

197
00:13:20,810 --> 00:13:23,440
،وتقترحين وقف إطلاق النّار

198
00:13:23,660 --> 00:13:29,870
لكن لو استخدمتِ قوّتكِ لإنهاء
القتال بشكلٍ فوريّ

199
00:13:29,870 --> 00:13:33,320
ألن ينقذ ذلك مزيداً من الأرواح
وعلى نحوٍ أسرع حتّى؟

200
00:13:34,050 --> 00:13:35,320
ماذا تقصد؟

201
00:13:35,630 --> 00:13:36,450
...ما أقوله هو

202
00:13:36,780 --> 00:13:40,070
،قد تكونين مُستثناة، لكن غير ذلك

203
00:13:40,070 --> 00:13:43,890
بحكمِ طبيعة الناس المُشاركين في جوني تايسِن
...بمن فيهم أنا

204
00:13:44,210 --> 00:13:49,470
ما السبب الذي يدفعكِ لتعريض نفسكِ
لهذه المُعاناة الشّديدة في مُحاولةٍ لإنقاذنا؟

205
00:13:50,180 --> 00:13:55,790
سيكون العالم أفضل إذا مات كلّ واحد
منّا في أسرع وقتٍ مُمكن

206
00:13:56,280 --> 00:13:59,640
نحن المُحارِبون الوحيدون الذين
،لمسنا معنى في هذه الحرب

207
00:13:59,640 --> 00:14:02,780
والتي لأجلِها فُرِّغَتْ مدينة كاملة

208
00:14:03,500 --> 00:14:06,210
لا أحد تقريباً يعلم بشأن جوني تايسِن

209
00:14:06,640 --> 00:14:12,790
فلو علموا، فسيقولون على الأرجح
"آمل أن يموتوا جميعاً وينهوا الأمر بسرعة"

210
00:14:14,150 --> 00:14:17,610
"وتنتابهم أفكار مثل "كلّ الأرواح ثمينة

211
00:14:17,910 --> 00:14:20,900
"و "لا أحد شرّير بالمُطلَق

212
00:14:21,250 --> 00:14:24,550
ومجرّد ملاحظات تافِهة يلقيها أناس
لا يرون الحقيقة

213
00:14:25,360 --> 00:14:30,920
إذا كانت هذه هي النتيجة التي توصّلتَ
إليها يا نيزومي-كن

214
00:14:30,920 --> 00:14:33,970
فينبغي إذاً أن تكفّ عن كونِك
محارباً حالاً

215
00:14:34,560 --> 00:14:37,380
لستَ مؤهّلاً لتكون في ساحة معركة

216
00:14:39,740 --> 00:14:40,990
،نيزومي-كن

217
00:14:40,990 --> 00:14:45,590
في وقتٍ مضى، قلتَ أنّه لم ينقذ أحدٌ أناساً
مثلما أنقذتُ أنا

218
00:14:45,920 --> 00:14:50,100
فإذاً بالتالي لم يفشل أحدٌ في إنقاذ
أناس مثلما فشلتُ أنا

219
00:14:50,590 --> 00:14:53,930
هناك كثيرٌ من الناس حاولتُ إنقاذهم وفشلت

220
00:14:55,390 --> 00:14:57,280
أكثر ممّا أستطيع أن أحصي

221
00:14:57,750 --> 00:15:00,330
لكن أكثر ممّا يُمكِن أن أنسى

222
00:15:01,020 --> 00:15:03,490
شهدتُ سقوط بلد تلو الآخر

223
00:15:03,930 --> 00:15:06,690
رأيتُ ذبحاً على ذبحٍ غير مُبرّر

224
00:15:06,690 --> 00:15:10,020
جرائم ضدّ البشريّة محفورة في عقلي

225
00:15:10,640 --> 00:15:14,750
اصطياد البشر وعبوديّة مؤسّساتيّة

226
00:15:14,750 --> 00:15:17,980
وحرب أهليّة وأسلحة لا أخلاقيّة
وإتجار بالبشر

227
00:15:17,980 --> 00:15:21,180
...وقتل عجائز وآباء وأطفال

228
00:15:21,560 --> 00:15:26,750
،إبادة ثقافيّة وتدمير واسع النطاق للتراث الثقافيّ
واستنزاف الموارد

229
00:15:26,750 --> 00:15:30,010
تمييز وعنصريّة، انتقام وقصاص

230
00:15:30,010 --> 00:15:32,880
إخضاع النّساء للرجال، وتجويع وأوبئة

231
00:15:32,880 --> 00:15:36,370
رأيتُ هذا مراراً وتكراراً، مراراً وتكراراً
مراراً وتكراراً، مراراً وتكراراً

232
00:15:36,370 --> 00:15:39,630
مراراً وتكراراً، مراراً وتكراراً، مراراً وتكراراً
مراراً وتكراراً، مراراً وتكراراً

233
00:15:39,630 --> 00:15:41,060
رأيتهم كلّهم

234
00:15:41,060 --> 00:15:42,440
رأيتهم عين اليقين

235
00:15:43,340 --> 00:15:45,380
لقد رأيتُ الحقيقة

236
00:15:45,770 --> 00:15:48,560
وبالرغمِ من رؤيتي ذلك، ما زلتُ
ألقي ملاحظات تافهة

237
00:15:48,970 --> 00:15:50,960
أختار القيام بما أقوم به

238
00:15:51,520 --> 00:15:54,840
أختار إيقاف الحروب باستخدام قوّة الكلمات

239
00:15:55,230 --> 00:15:58,310
،حتّى أنا عشتُ تجارب فظيعة كذلك

240
00:15:58,310 --> 00:16:01,970
لكن ما زلتُ أرغب بالانسجامِ مع الجميع

241
00:16:01,970 --> 00:16:04,820
أريد أن أجد السّعادة مع الجميع

242
00:16:06,520 --> 00:16:09,110
لا تستهن بالملاحظات التّافهة يا صغير

243
00:16:16,870 --> 00:16:18,080
أتحتاجين لبعض المُساعدة؟

244
00:16:19,330 --> 00:16:22,700
لا، شكراً. لن يعني هذا شيئاً
إذا لم أعدّه بنفسي

245
00:16:22,700 --> 00:16:24,580
حسناً. لكِ ذلك

246
00:16:34,010 --> 00:16:34,910
...المعذرة

247
00:16:36,320 --> 00:16:38,390
لا شيء

248
00:16:39,610 --> 00:16:40,770
ما الأمر؟

249
00:16:41,410 --> 00:16:44,420
...كنتُ أقول لنفسي أنّكِ ستغادرين مجدّداً قريباً

250
00:16:47,040 --> 00:16:50,930
ميساكي... بالنسبة لي، لستِ مُحاربة

251
00:16:50,930 --> 00:16:52,990
أنتِ يوكي ميساكي

252
00:16:53,390 --> 00:16:56,780
الفتاة التي تعدُّ الحلويّات هنا هي التي أحبّها

253
00:16:57,560 --> 00:17:00,110
أريد أن أحمي هذه الحياة التي نعيشها معاً

254
00:17:00,770 --> 00:17:03,260
ألا يكفيكِ هذا؟

255
00:17:04,310 --> 00:17:07,430
ينتابني نفس شعورك

256
00:17:07,800 --> 00:17:10,460
أريد حِماية هذه الحياة التي نعيشها

257
00:17:10,850 --> 00:17:13,160
لهذا أخرج إلى ساحاتِ المعارك

258
00:17:14,840 --> 00:17:17,170
أنا آسف. أفهمكِ

259
00:17:17,830 --> 00:17:19,460
...أفهمكِ، لكن

260
00:17:21,460 --> 00:17:25,330
إن كنت تحبّني، فأريدك أن تكون أقوى

261
00:17:25,660 --> 00:17:30,010
لأنّني سأعود إليك

262
00:17:44,740 --> 00:17:47,120
هذه معركةٌ بحدّ ذاتها

263
00:17:58,460 --> 00:18:00,880
...ربّما بالغتُ قليلاً

264
00:18:02,230 --> 00:18:04,060
ماذا ينبغي أن أفعل الآن؟

265
00:18:04,380 --> 00:18:07,890
على الأقلّ الخنزير والكلب حسب معلوماتي

266
00:18:08,200 --> 00:18:10,860
،إضافة إلى الأفعى الذي ماتَ باكراً

267
00:18:10,860 --> 00:18:13,900
ممّا يجعلهم ثلاثة من
أصل النشِطين الآن على الأقلّ

268
00:18:14,280 --> 00:18:16,320
،إذا ماتت الدّجاجة

269
00:18:16,320 --> 00:18:19,410
فيُصبحوا ستّة على الأكثر باستثنائي
أنا ونيزومي-كن

270
00:18:20,470 --> 00:18:23,530
...قد يقول البعض أنّها سذاجة منّي، لكن

271
00:18:24,040 --> 00:18:26,330
يبدو من الغريب قليلاً

272
00:18:26,330 --> 00:18:30,830
وجود كلّ هذا العدد الكبير من المُحاربين
العدائيّين في معركةٍ جماعيّة كهذه

273
00:18:31,270 --> 00:18:34,040
،الجائزة هي تحقيق أي أمنية

274
00:18:34,440 --> 00:18:40,120
لكن أتصوّر أنّ أي منهم بإمكانه أن يحقّق
مُعظم أمانيه بنفسه

275
00:18:41,340 --> 00:18:44,750
الأخطر الآن هو المُحارِب الأرنب

276
00:18:44,750 --> 00:18:49,300
قدرتُه على استحضارِ الأرواح تُتيحُ له

277
00:18:49,300 --> 00:18:52,060
استعباد الآخرين كجثثٍ سائرة

278
00:18:52,650 --> 00:18:56,670
إذا كان يمتلك قوّةً كهذه فلمَ يُتعب
نفسه بهذه المعركة؟

279
00:18:57,670 --> 00:19:01,320
حسناً، المُشاركة إلزاميّة، لذا أعتقد
أنّه لم يستطع الرّفض

280
00:19:03,640 --> 00:19:05,810
عليّ أن أتّخذ قراري

281
00:19:05,810 --> 00:19:10,200
هل أبقى على وضعي فترة أطول
أم أصعد إلى السّطح؟

282
00:19:10,200 --> 00:19:11,810
...ما زلتُ محتارة، لكن

283
00:19:28,410 --> 00:19:29,960
!نيزومي-كن، استيقظ

284
00:19:31,800 --> 00:19:34,160
خلتُكِ ضدّ العنف

285
00:19:41,170 --> 00:19:42,480
ما هذا؟

286
00:19:43,300 --> 00:19:45,550
طائر ميّت؟

287
00:19:46,010 --> 00:19:48,790
!ميّت؟ مُستحضر الأرواح

288
00:19:57,040 --> 00:19:58,730
هذا سيّئ يا شاريو

289
00:19:58,730 --> 00:20:00,400
أعدادهم كثيرة

290
00:20:00,400 --> 00:20:05,400
في مكانٍ غير صحّي كهذا، حتّى الخدش
سيؤدّي إلى كُزاز

291
00:20:05,400 --> 00:20:06,030
!سنهرب

292
00:20:06,030 --> 00:20:06,660
!مـ-مهلاً

293
00:20:10,140 --> 00:20:13,020
!أفلتيني! أستطيع الركض بمفردي

294
00:20:27,710 --> 00:20:29,080
إنّه ميّت أيضاً؟

295
00:20:29,080 --> 00:20:30,400
المُحارب الأرنب؟

296
00:20:30,400 --> 00:20:32,100
—لكن السّلاح الذي يستخدمه

297
00:20:55,770 --> 00:21:00,110
،أوساغي: المُحارب الأرنب
يقتلُ نفسيّاً

298
00:21:00,860 --> 00:21:02,010
لا أملك خياراً

299
00:21:02,430 --> 00:21:05,360
نيزومي-كن، هل يمكنك تولّي الأفعى؟

300
00:21:05,800 --> 00:21:08,570
ماذا؟ ستقاتلين؟

301
00:21:08,570 --> 00:21:12,410
قد أكون مُسالمة، لكن هذا لا يعني ألّا أقاوم

302
00:21:12,810 --> 00:21:16,630
سأكبح جماحهما بسلامٍ ومن ثمّ نتحاور

303
00:21:17,100 --> 00:21:19,970
تكبحين جماحهما بسلام؟

304
00:21:20,420 --> 00:21:23,860
سيكون هذا أصعب بكثير من قتلِهما

305
00:21:24,190 --> 00:21:27,970
تبّاً... أنتِ هكذا دوماً

306
00:21:28,490 --> 00:21:29,880
دوماً؟

307
00:21:29,880 --> 00:21:33,000
"دوماً" بمعنى "في كلّ الأوقات"

308
00:21:33,390 --> 00:21:34,700
موافق

309
00:21:35,730 --> 00:21:39,450
،شاريو: المحاربة القرد
تقتلُ بسلام

310
00:21:36,600 --> 00:21:39,110
تقتلُ بسلام

311
00:21:36,600 --> 00:21:39,150
القرد

312
00:21:39,640 --> 00:21:43,070
نيزومي: المُحارب الجرذ، يقتلُ الجميع

313
00:21:40,820 --> 00:21:43,190
يقتلُ الجميع

314
00:23:26,160 --> 00:23:29,130
هنالك مقولةٌ قديمةٌ وهي "روِّج للحمِ ضأن
"وبِع لحمَ كلب

315
00:23:29,130 --> 00:23:33,150
لكلّ بضاعة قيمتها الخاصّة

316
00:23:33,140 --> 00:23:35,890
الحلقة القادمة: ذئب في ثوبِ خروف

317
00:23:35,890 --> 00:23:38,220
!جميعُكم، صفِّقوا