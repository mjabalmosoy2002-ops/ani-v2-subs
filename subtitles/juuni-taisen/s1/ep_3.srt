1
00:00:07,280 --> 00:00:10,510
إنّها أقدم ذِكرى لديّ

2
00:00:10,850 --> 00:00:13,540
غرفة في مُجمَّعٍ سكنيّ كائنٍ في مكانٍ ما

3
00:00:14,410 --> 00:00:17,000
،غرفة مليئة بعلاماتِ الحياة

4
00:00:17,000 --> 00:00:19,860
ممّا يُشير إلى أنّ شخصاً قد عاشَ
هُناك لفترةٍ طويلة

5
00:00:20,110 --> 00:00:22,440
،قمامة مُتناثِرة ومُتكوِّمة

6
00:00:22,440 --> 00:00:24,090
،ورائحة العفونة

7
00:00:24,090 --> 00:00:25,820
والألم يعتري كلّ جسدي

8
00:00:26,270 --> 00:00:30,930
،وسائل مسكوبٌ على الأرضِ كانَ قد برَد

9
00:00:30,930 --> 00:00:33,130
وكسّارة بيض بيدي

10
00:00:33,430 --> 00:00:36,140
،لم يكُن من المُمكنِ تمييزهما في ذلك الوقت

11
00:00:36,140 --> 00:00:39,640
لكن أعتقد أنّهما كانا والديّ على الأرجح

12
00:00:40,160 --> 00:00:42,730
لم أستطع تذكُّر كيف وصلتُ إلى هناك

13
00:00:42,730 --> 00:00:46,990
في الواقع، لم أستطع تذكُّر أي شيء على الإطلاق

14
00:00:50,970 --> 00:00:54,770
يا إلهي! استغرقَ ذلك وقتاً طويلاً

15
00:00:54,770 --> 00:00:56,350
!لكنّني سعيدة حقّاً

16
00:00:56,350 --> 00:00:58,150
دفعتُه لإعطائي العقار

17
00:01:01,570 --> 00:01:02,590
!لننهض

18
00:01:03,190 --> 00:01:07,240
،دوتسكو-سان، قلتُ لك لا أعرف شيئاً عن أحد

19
00:01:07,240 --> 00:01:09,620
لكنّني أعرف عنك

20
00:01:09,910 --> 00:01:12,300
،كنتُ أعلم أنّك مُسمِّم

21
00:01:12,300 --> 00:01:15,380
،وأعرف عقار تعزيز القوّة السرّي الخاص بك
جيش الشّخص الواحد

22
00:01:15,770 --> 00:01:19,990
لا يُمكِنُك إخفاء أي شيء عن عيني، عين الغاق

23
00:01:33,910 --> 00:01:37,610
هذا أشبه بتعزيز كلّ إمكانياتك لأقصى حدّ
!في لعبةِ فيديو

24
00:01:38,930 --> 00:01:41,460
شكراً جزيلاً لك يا دوتسكو-سان

25
00:01:41,460 --> 00:01:45,740
!بفضلِك، قد أتمكّن من الفوزِ في هذه

26
00:01:46,110 --> 00:01:49,620
عندما أفوز، أعدُك أنّني سأطلبُ
منهم صنع تمثال لك

27
00:01:52,000 --> 00:01:52,870
ماذا؟

28
00:01:53,230 --> 00:01:54,870
ماذا كان شكله؟

29
00:01:55,420 --> 00:01:58,030
حسناً، يُقال أنّ الرّجل ليس بمظهرِه

30
00:01:58,030 --> 00:02:00,280
ما دامَ يملكُ أنياباً فهذا جيّدٌ بما يكفي

31
00:02:10,620 --> 00:02:12,470
!حسناً! حانَ دورُ التّالي

32
00:02:12,750 --> 00:02:14,470
!لنقُم بهذا

33
00:03:56,490 --> 00:04:00,710
بالكاد أتذكّر مشفى وكثيراً من الفحوصِ تُجرى عليّ

34
00:04:01,050 --> 00:04:02,490
لا تتذكّر؟

35
00:04:02,490 --> 00:04:04,890
لا. لا تتذكّر الحادِثة بحدِّ ذاتها، وعلى الأرجح

36
00:04:04,890 --> 00:04:08,220
لا تتذكّر شيئاً من الإذلال الذي عانَتْه
على يدي والديها عن عمرٍ صغير

37
00:04:08,670 --> 00:04:10,700
فقدان ذاكِرة شديد على ما أعتقد

38
00:04:17,730 --> 00:04:18,940
كيف حالُ ذاكرتها؟

39
00:04:19,240 --> 00:04:20,640
لم تستعدها بعد

40
00:04:20,640 --> 00:04:24,280
يبدو أنَّ الإجهاد النفسيّ قد أعاق
قدرتها على التذكُّر

41
00:04:25,640 --> 00:04:27,850
بل لعلَّ هذا يصبُّ في صالحِنا

42
00:04:27,850 --> 00:04:29,320
هل من تغيير في قدراتِها؟

43
00:04:29,320 --> 00:04:30,830
على الإطلاق

44
00:04:30,830 --> 00:04:33,260
،علاوة على قدرتِها في التحكُّمِ بكُل ما له علاقة بالطيور

45
00:04:33,260 --> 00:04:37,210
تبدو أيضاً قادِرة على مُشاركتهم
المعلومات البصريّة

46
00:04:38,010 --> 00:04:40,220
أعتقد أنَّ الوقت قد حان

47
00:04:40,760 --> 00:04:43,200
ستتبنّاها عائلةُ نيوا

48
00:04:43,700 --> 00:04:45,050
حضِّر المُعاملات الورقيّة

49
00:04:45,330 --> 00:04:46,170
حاضر

50
00:04:53,560 --> 00:04:57,730
أتذكّر بوضوحٍ كلّ ما حدثَ بعد
أن تبنّتني عائلةُ نيوا

51
00:04:58,440 --> 00:05:00,090
،أصبحتُ ابنتهم المُتبنّاة

52
00:05:00,090 --> 00:05:01,440
،وكمُحارِبة

53
00:05:01,440 --> 00:05:05,200
علَّموني كافّة أشكال القتل وتقنيّات التجسُّس

54
00:05:06,350 --> 00:05:10,820
عائلةُ نيوا متورِّطةٌ بشكلٍ سرِّي في النِّزاعات
والثّورات حولَ العالم

55
00:05:11,610 --> 00:05:13,580
،بعد أن تبنّوني

56
00:05:14,020 --> 00:05:18,580
خضتُ معاركَ كثيرة بأمرٍ من عائلةِ نيوا

57
00:05:25,310 --> 00:05:30,880
بصِفتي شخص بلا ماضٍ، لم تكن لديّ
أهداف أو طموحات أو مُثُل مُحدَّدة

58
00:05:31,540 --> 00:05:34,260
كنتُ ببساطة أُقاتلُ متى طُلِبَ منِّي ذلك

59
00:05:34,800 --> 00:05:36,520
أقتلُ متى طُلِبَ منِّي ذلك

60
00:05:52,420 --> 00:05:54,240
ماذا؟ هنا؟

61
00:05:57,240 --> 00:05:59,360
ريوكا، أرسلي سيّارة إلى الخلف

62
00:05:59,360 --> 00:06:00,990
!حاضِرة

63
00:06:07,170 --> 00:06:10,360
يبدو أنّ السرَّ قد انكشف

64
00:06:10,360 --> 00:06:11,790
عُلِم. سندخلُ حالاً

65
00:06:16,340 --> 00:06:18,390
تبّاً. كيف علِموا؟

66
00:06:18,390 --> 00:06:20,440
اجتمعَ حلفاؤنا في المكانِ المُعتاد

67
00:06:20,440 --> 00:06:21,220
ينبغي أن نُسرِع

68
00:06:27,350 --> 00:06:28,980
!هيّا، هيّا، هيّا، هيّا

69
00:06:31,440 --> 00:06:33,620
ألا تستطيع هذه السيّارة أن تُسرِع أكثر؟

70
00:06:41,010 --> 00:06:42,410
لا جدوى. لقد أفلتوا

71
00:06:42,760 --> 00:06:44,720
لديهم مخرجٌ سرِّي في القبو

72
00:06:44,720 --> 00:06:47,480
،بعد أشهُر من الإعدادِ لهذه المصيدة
فشِلنا فشلاً ذريعاً

73
00:06:47,480 --> 00:06:48,290
!اللّعنة

74
00:06:48,590 --> 00:06:51,190
ألم تكتشفي هذا في تحرّياتكِ مُسبَقاً يا ريوكا؟

75
00:06:51,190 --> 00:06:52,930
!آسفة

76
00:06:53,910 --> 00:06:55,430
ماذا تفعلين يا ريوكا؟

77
00:06:56,110 --> 00:06:57,430
!حسناً، انتهيت

78
00:06:57,700 --> 00:07:01,430
في الواقع، كانَتْ مهمّتي هي الحصول على هذه

79
00:07:01,730 --> 00:07:02,880
ما هذه؟

80
00:07:02,880 --> 00:07:06,500
قائمة عُملائهم وحِسابات مشبوهة
!وأشياء أخرى كثيرة

81
00:07:06,500 --> 00:07:07,160
ماذا؟

82
00:07:07,160 --> 00:07:08,220
حقّاً؟

83
00:07:08,220 --> 00:07:10,690
إن صحَّ ذلك فهذا أفضل ممّا تخيّلنا

84
00:07:10,690 --> 00:07:12,190
!بالفعل

85
00:07:12,460 --> 00:07:13,450
...لذا

86
00:07:16,930 --> 00:07:19,480
!أعتقد أنّني سآخذها

87
00:07:19,480 --> 00:07:20,660
!ماذا؟

88
00:07:22,340 --> 00:07:23,700
ماذا حدثَ هنا بالضبط؟

89
00:07:24,220 --> 00:07:26,670
...كان هُناك ناجٍ و

90
00:07:26,670 --> 00:07:28,080
...قائد الفرقة و

91
00:07:32,580 --> 00:07:34,180
!لننهض

92
00:07:38,150 --> 00:07:39,160
!اللّعنة

93
00:07:39,160 --> 00:07:42,760
!كيف؟ كيف علِموا بعمليّة تبادُل اليوم؟

94
00:07:43,750 --> 00:07:45,570
سنكتشفُ ذلك قريباً

95
00:07:50,180 --> 00:07:51,390
من؟

96
00:07:51,390 --> 00:07:53,990
نجوتَ بسلام؟

97
00:07:54,360 --> 00:07:57,470
...تبّاً، أظنُّك كذلك. هكذا إذاً

98
00:07:57,830 --> 00:07:59,040
...هل يُعقَل

99
00:07:59,620 --> 00:08:01,080
...أنتِ

100
00:08:01,080 --> 00:08:04,710
إن كنتَ قد نجوتَ من هذا فسيُتعبني ذلك حقّاً

101
00:08:05,480 --> 00:08:06,810
...ريوكا

102
00:08:07,330 --> 00:08:11,930
!إيّاكِ والظنّ أنّني سأمنحُكِ موتاً سريعاً

103
00:08:12,140 --> 00:08:16,290
!أخفتَني كثيراً! لا تهدّدني بهذا الشّكل

104
00:08:16,290 --> 00:08:18,550
فنحن لن نرى بعضنا الآخر ثانية

105
00:08:18,950 --> 00:08:21,100
ماذا تقصدين بذلك بالضبط؟

106
00:08:29,860 --> 00:08:33,530
الآخرون هُم مجرَّد مُكوِّنات ظرفيّة

107
00:08:33,530 --> 00:08:35,860
يُمكِنُ للناسِ الأخيار أن يغرقوا في الظلام

108
00:08:35,860 --> 00:08:37,440
وللأشرارِ أن يُقوِّموا أنفُسَهم

109
00:08:38,060 --> 00:08:42,300
لقد خدعتُ كثيراً من النّاسِ
وخنتُ كثيراً من النّاس

110
00:08:42,300 --> 00:08:44,650
لم أعُد أعلمُ فعلاً

111
00:08:44,650 --> 00:08:49,000
من يكون عدوّي ومن يكون صديقي

112
00:08:52,520 --> 00:08:56,130
أفكِّرُ بزيارةِ نبعٍ ساخِن حالما ينتهي هذا العمل

113
00:09:09,730 --> 00:09:14,240
،حتّى أقوى المُحاربين قد يمرّوا بانتكاسة

114
00:09:14,450 --> 00:09:18,350
بينما قد يحظى أضعف المُحاربين بيوم سَعْد

115
00:09:18,350 --> 00:09:21,490
كلّ ما يهمّ هو أنَّ آخر شخص يبقى

116
00:09:21,760 --> 00:09:22,610
يربح

117
00:09:36,760 --> 00:09:38,430
!حسناً أيّتها الطيور

118
00:09:39,390 --> 00:09:40,800
!فليبدأ العرض

119
00:10:09,950 --> 00:10:11,410
القتلُ نقراً

120
00:10:13,460 --> 00:10:14,700
!دفن السَّماء

121
00:10:30,410 --> 00:10:33,890
...خسرتُ الكثير

122
00:10:33,890 --> 00:10:37,130
تِلك القدرة الخاصّة... بِلا تلقيم، صحيح؟

123
00:10:37,130 --> 00:10:39,530
!ما زال بمقدورِها استخدامها إذاً حتّى كجثّة

124
00:10:40,640 --> 00:10:45,500
يسرّني أنَّني لم أحاول تجرِبة قوّة
دوتسكو-سان كالبلهاء

125
00:10:47,710 --> 00:10:50,570
يبدو أنّها شبِعَتْ تماماً

126
00:10:50,860 --> 00:10:53,860
جوِّعوا أنفُسَكم وساعدوني مجدّداً
في وقتٍ قريب، اتّفقنا؟

127
00:11:12,580 --> 00:11:14,350
هكذا إذاً... مُصفَّح

128
00:11:14,350 --> 00:11:16,490
أهذه هي قدرتُك؟

129
00:11:18,070 --> 00:11:21,790
إذاً قد أجرِّب وأرى إلى أي مدى
ستصِلُ قدراتك الدفاعيّة هذه

130
00:11:31,680 --> 00:11:33,840
،لو لم نكن في المدينة

131
00:11:33,840 --> 00:11:36,580
لتمكّنتُ من جمعِ عددٍ أكبر بكثير
...من الطيور لمُساعدتي

132
00:11:38,580 --> 00:11:40,220
مرحباً يا آنسة

133
00:11:40,750 --> 00:11:44,390
لا أنوي مُقاتلتكِ، لذا هلّا وضعتِ هذا جانباً؟

134
00:11:44,650 --> 00:11:48,810
كـ-كيف عرفتَ بأنّني هنا؟

135
00:11:49,810 --> 00:11:51,840
لم أعرف بصراحة

136
00:11:52,460 --> 00:11:56,510
أتيتُ إلى هنا بحثاً عن الطعامِ مثلكِ فحسب

137
00:11:57,500 --> 00:12:00,520
لكن بما أنّنا صادَفنا بعضَنا الآخر، سأعرِّف عن نفسي

138
00:12:01,200 --> 00:12:04,650
نيزومي: المُحارِب الجرذ، يقتلُ الجميع

139
00:12:06,980 --> 00:12:08,140
وأنتِ؟

140
00:12:08,400 --> 00:12:11,470
نـ-نيواتوري: المُحارِبة الدّجاجة

141
00:12:19,670 --> 00:12:21,220
آنذاك؟

142
00:12:21,750 --> 00:12:24,430
أجل! رفَعْت

143
00:12:24,850 --> 00:12:28,310
رُغمَ أنّ خطّتي كانت التّماشي معكم
وخيانتكم لاحقاً

144
00:12:28,580 --> 00:12:30,280
وماذا في ذلك؟

145
00:12:34,650 --> 00:12:36,690
تعالي معي يا آنسة

146
00:12:37,750 --> 00:12:40,410
سآخذكِ إلى القرد

147
00:12:49,830 --> 00:12:52,110
ماذا ينبغي أن أفعل؟ أقتله؟

148
00:12:55,250 --> 00:12:58,840
لا تستطيع الطيور الدّخول إلى هنا
لذا لستُ مُتيقِّنة من ذلك

149
00:12:59,420 --> 00:13:01,310
مخبأ حقيقيّ

150
00:13:05,800 --> 00:13:06,840
!أهلاً بعودتِك

151
00:13:07,120 --> 00:13:08,970
من هي؟

152
00:13:09,970 --> 00:13:11,850
صادفتُها فأحضرتُها

153
00:13:12,150 --> 00:13:15,600
ظهر مكشوف تماماً. لا أثَر للاحتراس

154
00:13:17,650 --> 00:13:19,360
هيّا يا نيزومي-كن

155
00:13:19,360 --> 00:13:22,690
أنا مُتعَبٌ من المشي. تُصبحين على خير

156
00:13:22,690 --> 00:13:24,110
يمكنكِ تولّي الأمر من هنا

157
00:13:24,860 --> 00:13:27,390
...يا لك من فتى يائس

158
00:13:27,390 --> 00:13:28,720
أنا آسفةٌ حقّاً

159
00:13:28,720 --> 00:13:30,800
أظنُّه فتى جيّد من حيثُ المضمون

160
00:13:30,800 --> 00:13:35,170
لا بأس... لا مُشكلة

161
00:13:35,650 --> 00:13:40,240
...خلتُ لوهلةٍ أنّي سبقَ والتقيتُ به في مكانٍ ما

162
00:13:40,680 --> 00:13:42,950
لكن أعتقد أنّي كنتُ أتوهّم فحسب

163
00:13:45,580 --> 00:13:49,230
المعذِرة... هل تعرفين الكثير عنّي؟

164
00:13:49,640 --> 00:13:52,130
أ-أعرف فقط أنّكِ المُحارِبة القرد

165
00:13:52,130 --> 00:13:54,640
سأعرِّف عن نفسي إذاً

166
00:13:55,010 --> 00:13:58,270
،شاريو: المُحارِبة القرد
تقتلُ بسلام

167
00:13:58,530 --> 00:14:01,990
،نيواتوري: المُحارِبة الدّجاجة
تقتلُ نقراً

168
00:14:01,990 --> 00:14:03,620
قلتُها كما ينبغي هذه المرّة

169
00:14:02,780 --> 00:14:05,150
!نيواتوري-سان؟ هكذا إذاً

170
00:14:05,150 --> 00:14:06,360
سُرِرتُ بلقائكِ

171
00:14:06,360 --> 00:14:08,910
شكراً جزيلاً لكِ على قبولكِ مُقترَحي آنذاك

172
00:14:08,910 --> 00:14:11,780
يسرُّني أنّنا نستطيع التّحاوُر جيّداً الآن

173
00:14:11,790 --> 00:14:13,540
...أ-أجل

174
00:14:13,810 --> 00:14:16,500
لحظة، هل كان مُقترحها لوقفِ النّار جادّاً؟

175
00:14:16,500 --> 00:14:21,040
ليس مُجرَّد ذريعة لتشكيلِ فريق؟

176
00:14:21,050 --> 00:14:23,300
مستحيل. غير معقول

177
00:14:23,570 --> 00:14:26,410
،انفصَلْنا جميعاً عقب ذلك

178
00:14:23,570 --> 00:14:27,610
لن يُفكِّر أحدٌ بشيء كهذا على الإطلاق

179
00:14:26,410 --> 00:14:28,360
لكن تمكّنتُ من اللِّقاءِ بنيزومي-كن

180
00:14:28,360 --> 00:14:32,050
الاختباءُ هُنا كانَتْ فكرته

181
00:14:32,050 --> 00:14:35,910
كنتُ أقولُ لنفسي أنّنا علينا التقاط
أنفاسنا قبل أن نبدأ بالتحرُّك

182
00:14:33,430 --> 00:14:37,060
صحيح، مثل هذه المجارير هي ما يتجوّل
فيها الجرذان

183
00:14:37,060 --> 00:14:39,650
كنتُ أخشى ألّا أتمكَّن من اللِّقاء

184
00:14:42,690 --> 00:14:45,440
لكن أنا سعيدةٌ لأنّني تمكّنتُ
من اللِّقاءِ بكِ على الأقلّ

185
00:14:45,440 --> 00:14:47,100
!أ-أجل

186
00:14:47,100 --> 00:14:49,700
أنا سعيدةٌ أيضاً... نعم

187
00:14:54,710 --> 00:14:56,020
الآخرون؟

188
00:14:59,470 --> 00:15:01,970
،بالإضافةِ إليّ أنا والجرذ الحاضِرَين هُنا

189
00:15:01,970 --> 00:15:05,000
هنالك الثّور والحصان... والأرنب

190
00:15:05,000 --> 00:15:08,600
كان من الواضحِ أنّ هدف الأرنب هو
عرقلة قِيادتها

191
00:15:08,600 --> 00:15:10,630
من المُحال أن تقصده هو، صحيح؟

192
00:15:10,630 --> 00:15:14,250
لم أكُن مُوافِقة على مُقترحِ القرد أيضاً في الحقيقة

193
00:15:14,250 --> 00:15:16,640
كانت تنتابُني شكوك حولَ الثّور والحصان كذلك

194
00:15:16,870 --> 00:15:19,350
...حتّى الجرذ المُستلقي هُناك

195
00:15:23,070 --> 00:15:26,150
بمقدوري قتلها متى شئت

196
00:15:27,430 --> 00:15:28,650
...لكن

197
00:15:30,010 --> 00:15:33,350
نيواتوري-سان، ألم تلتقي بأحدٍ بعد؟

198
00:15:33,760 --> 00:15:36,340
ما هي الأخبار في الأعلى الآن؟

199
00:15:36,340 --> 00:15:39,200
في الواقع... قُـ-قُتِلَ بعضهم

200
00:15:39,200 --> 00:15:42,540
على الأقلّ الخنزير والكلب حسب معلوماتي

201
00:15:42,800 --> 00:15:45,520
،إضافة إلى الأفعى الذي ماتَ باكراً

202
00:15:45,520 --> 00:15:48,420
ممّا يجعلهم ثلاثة من أصل النشِطين الآن
على الأقلّ

203
00:15:45,950 --> 00:15:48,420
لماذا أُجيبها بصدق؟

204
00:15:48,420 --> 00:15:49,820
...هكذا إذاً

205
00:15:49,820 --> 00:15:52,330
مات آخران بعدها إذاً

206
00:15:52,840 --> 00:15:54,180
هذا مُؤسِف

207
00:15:54,180 --> 00:15:56,440
مُؤسِف؟ أأنتِ جادّة؟

208
00:15:54,830 --> 00:15:58,450
الأخطر الآن هو المُحارِبُ الأرنب

209
00:15:56,440 --> 00:15:58,600
هذا يتجاوزُ حدَّ الثِّقة

210
00:15:58,450 --> 00:16:01,780
قدرتُه على استحضارِ الأرواح تُتيحُ له

211
00:15:58,600 --> 00:16:00,430
!حتّى أنا أرى أنّها حمقاء

212
00:16:00,430 --> 00:16:04,690
حتّى لو كانت القرد تُريد حسمَ هذا الأمر
،بِلا قِتال أو قتل

213
00:16:01,780 --> 00:16:05,350
استعباد الآخرين كجثثٍ سائرة

214
00:16:04,690 --> 00:16:07,860
!يبقى هذا خيالاً بعيد المنال

215
00:16:05,990 --> 00:16:08,930
فهمت. يبدو هذا إشكالاً بالفعل

216
00:16:09,890 --> 00:16:10,760
اشربي

217
00:16:11,500 --> 00:16:12,330
شكراً

218
00:16:12,330 --> 00:16:14,130
احذري، إنّها ساخنة

219
00:16:16,900 --> 00:16:20,580
ثلاثة مُحاربين من أصل اثني عشر
أي ربع العدد منذ الآن

220
00:16:20,910 --> 00:16:25,100
أما زال باستطاعتكِ تنفيذ خطّتكِ للفوز؟

221
00:16:25,540 --> 00:16:26,960
أستطيع

222
00:16:26,960 --> 00:16:30,910
...لا يُمكنني إخباركِ بالتفاصيل بعد، لكن

223
00:16:34,470 --> 00:16:35,720
إنّه حلو

224
00:16:35,980 --> 00:16:37,970
سكّر زيادة عن اللّزوم؟

225
00:16:37,970 --> 00:16:39,940
ارتأيتُ أنّه قد يكون نافعاً لجسدٍ مُنهَك

226
00:16:49,860 --> 00:16:51,940
!غبيّة، غبيّة، غبيّة، غبيّة

227
00:16:52,940 --> 00:16:54,700
...أرزّ وبيض يابانيّ

228
00:16:55,120 --> 00:16:57,120
أرزّ وبيض يابانيّ؟

229
00:16:57,450 --> 00:16:59,610
...لكن فائض من الكربوهايدرات

230
00:17:06,990 --> 00:17:11,090
آسفة، لكن لا أستطيع تلبية طلبكِ

231
00:17:12,190 --> 00:17:14,710
هكذا إذاً... مع الأسف الشّديد

232
00:17:15,140 --> 00:17:17,970
لكن إن غيّرتِ رأيكِ، يمكنكِ العودة في أي وقت

233
00:17:18,590 --> 00:17:20,970
سأكون هُنا دوماً في الانتظار

234
00:17:21,710 --> 00:17:24,230
لا تفقدي الأمل حتّى آخر لحظة، اتّفقنا؟

235
00:17:28,270 --> 00:17:30,730
ألن تأكلي معنا على الأقلّ؟

236
00:17:32,630 --> 00:17:34,740
لا... لكن أنا مُمتنّةٌ لعرضكِ

237
00:17:35,650 --> 00:17:38,410
!إلى أي درجةٍ أنا غبيّة؟

238
00:17:38,710 --> 00:17:41,880
!كان ينبغي أن أتماشى معها

239
00:17:41,880 --> 00:17:46,220
أين ذهبَتْ كلّ صلابتي ودهائي؟

240
00:17:49,800 --> 00:17:52,670
لا بدَّ وأنَّ السّبب هو جيش الشّخص الواحد

241
00:17:54,050 --> 00:17:57,650
لم يعزِّز ذلك العقار قدراتي الجسديّة فحسب

242
00:17:57,650 --> 00:17:59,920
بل عزّزَ حالتي العقليّة أيضاً

243
00:18:00,910 --> 00:18:04,960
،لهذا السّبب ذلك اللّطف، ذلك الصّدق

244
00:18:04,960 --> 00:18:08,240
!ذلك الخيال، يمزّقونني إرباً

245
00:18:09,810 --> 00:18:11,470
أنا غبيّةٌ جدّاً

246
00:18:11,470 --> 00:18:15,290
ما الفائدة من القوّةِ إذا كانَتْ تجعلني
!بهذا التوتُّر؟

247
00:18:16,380 --> 00:18:17,200
لوحدكِ؟

248
00:18:18,740 --> 00:18:19,650
!الثّور

249
00:18:20,150 --> 00:18:22,280
!يا إلهي، لماذا؟

250
00:18:22,540 --> 00:18:24,980
سألتُ ما إن كنتِ لوحدكِ

251
00:18:24,980 --> 00:18:28,920
إن كان لديكِ أي حليف قريب، فأودُّ رؤيته

252
00:18:29,230 --> 00:18:33,920
وبذلك أعني أنّني لا أُبالي لأعدادكم مهما كانت

253
00:18:33,920 --> 00:18:35,960
...خاض قِتالاً بالفعل

254
00:18:36,480 --> 00:18:39,430
لا، إن صحّت الإشاعة، قتل بالفعل

255
00:18:40,640 --> 00:18:43,680
خـ... خلتُك مُسالِماً

256
00:18:44,060 --> 00:18:47,180
أعتقد أنّكِ خلطتِ بيني وبين القرد

257
00:18:54,830 --> 00:18:57,480
،لكن عندما تمَّ تفريقنا بالقوّة

258
00:18:57,480 --> 00:19:00,210
اعتُبِرَ مقترح السلام في موضع جدل

259
00:19:00,700 --> 00:19:01,870
ماذا يجدرُ بي أن أفعل؟

260
00:19:02,270 --> 00:19:03,820
،حتّى في أحسن الظروف

261
00:19:03,820 --> 00:19:07,600
سيكون من الحماقةِ مُواجهة النابِغة
الجزّار في معركةٍ عادِلة

262
00:19:07,600 --> 00:19:10,840
ينبغي أن تجوع الطيور عمّا قريب مجدّداً

263
00:19:10,840 --> 00:19:12,930
...أستطيع الانسحاب وإعادة ترتيب أوراقي حالياً

264
00:19:13,500 --> 00:19:16,920
أو ماذا إذا استطعتُ كسب ثِقة الثّور
...ودفعه للكشفِ عن ظهرِه لي

265
00:19:16,920 --> 00:19:22,680
لكن حاليّاً، وهبَني عقار
جيش الشّخص الواحد قوّةً قاهِرة

266
00:19:22,970 --> 00:19:25,100
إنّه لا يعلم ذلك

267
00:19:26,580 --> 00:19:30,120
...بما أنّكِ ذكرتِ ذلك الأمر فوراً

268
00:19:31,080 --> 00:19:35,370
هل هذا يعني أنّ القرد قريبة؟

269
00:19:37,080 --> 00:19:39,570
...ماذا؟ ما الذي

270
00:19:39,570 --> 00:19:45,170
مهلاً! هل هذا السُّلوك دلالة على أنّكِ
ستُقاتلين لحمايةِ القرد؟

271
00:19:45,170 --> 00:19:49,470
المقولة القديمة، "إن أردت المرور
فعليك أن تقتلني أوّلاً"؟

272
00:19:50,440 --> 00:19:52,960
لم أظنّكِ من هذا النّوع

273
00:19:53,410 --> 00:19:57,170
معه حقّ. لستُ من هذا النّوع

274
00:19:57,170 --> 00:20:00,760
...لكن ربّما تأثير جيش الشّخص الواحد هذا أيضاً

275
00:20:01,620 --> 00:20:03,300
لا أنصحكِ بهذا

276
00:20:03,300 --> 00:20:06,470
إنّ حافزاً كهذا لن يزيدكِ قوّة

277
00:20:06,770 --> 00:20:09,160
هذا ليس صلاحكِ

278
00:20:09,160 --> 00:20:11,500
بل هو صلاح شخصٍ آخر

279
00:20:11,790 --> 00:20:14,730
ينبغي أن تُقاتِلي لأجلِ نفسكِ فقط

280
00:20:15,630 --> 00:20:19,680
!أعي هذا. أعي هذا أكثر منك

281
00:20:19,680 --> 00:20:21,340
عليّ الخروج من هنا

282
00:20:21,690 --> 00:20:25,480
يجب أن أُخفِضَ عُرف الدِّيك وأهرب
!في أسرع وقتٍ مُمكن

283
00:20:26,850 --> 00:20:30,290
،نيواتوري: المُحارِبة الدّجاجة
!تقتلُ نقراً

284
00:20:27,330 --> 00:20:30,450
تقتلُ
نقراً

285
00:20:27,330 --> 00:20:30,450
دجاجة

286
00:20:30,540 --> 00:20:33,540
،أوشي: المُحارِب الثّور
يقتلُ بانتظام

287
00:20:31,080 --> 00:20:33,540
يقتلُ
بانتظام

288
00:20:43,060 --> 00:20:44,040
يمكنني الفوز

289
00:20:50,190 --> 00:20:56,610
...التّخطيط والخِداع والمُساومة والتّحسينات

290
00:20:57,360 --> 00:21:01,440
...والعبقريّ الذي لا يحتاج لأي منها

291
00:22:54,520 --> 00:22:57,600
حسناً، أعتقد أنَّه قد جاء أجلي

292
00:22:58,610 --> 00:23:03,420
تمكّنتُ من الموت ميتةً عاديّةً كشخصٍ جيِّد

293
00:23:04,600 --> 00:23:07,870
أيّتها الطيور. شكراً على كلّ شيء

294
00:23:08,180 --> 00:23:10,410
لا بدَّ وأنّكم جوعى الآن، صحيح؟

295
00:23:11,420 --> 00:23:12,840
تعالوا

296
00:23:14,280 --> 00:23:15,680
يمكنكم أن تأكلوني

297
00:23:26,180 --> 00:23:28,950
".يُقال، "حتّى القِرد قد يسقُط من أعلى شجرة

298
00:23:28,950 --> 00:23:33,230
لنقل أيضاً أنّ فرط الموهِبة قد يهوي
بالحكيمِ إلى الأرض

299
00:23:33,530 --> 00:23:36,500
الحلقة القادمة: العدوّ، رئيسيّة نَبيلة

300
00:23:36,500 --> 00:23:38,590
!جميعُكم، صفِّقوا