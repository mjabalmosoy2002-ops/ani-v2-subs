1
00:01:16,550 --> 00:01:18,690
أعتمد عليك يا أخي الصّغير

2
00:01:18,690 --> 00:01:21,410
استمرّ في إلهائهما فحسب

3
00:01:21,410 --> 00:01:25,540
سأتولّى أمر تخليد ذكراك

4
00:01:43,290 --> 00:01:44,960
:أوساغي

5
00:01:45,580 --> 00:01:48,840
!المُحارِب الأرنب، يقتلُ نفسيّاً

6
00:01:50,880 --> 00:01:53,630
ألم تكن تعلم يا تنّين-كن؟

7
00:01:53,630 --> 00:01:57,170
تستطيع الأرانب الوصول إلى القمر بقفزاتها

8
00:01:58,260 --> 00:02:01,900
ساعد أخاك الصّغير جيّداً، اتّفقنا؟

9
00:02:02,910 --> 00:02:06,150
...جرذ وثور ونمر

10
00:02:06,810 --> 00:02:09,260
بقي ثلاثة

11
00:03:59,780 --> 00:04:01,650
أصبحت الآن اثنين ضدّ اثنين

12
00:04:01,650 --> 00:04:02,290
...أو بالأحرى

13
00:04:06,180 --> 00:04:09,240
،أمامنا أفعى مبتور الرأس وجذع بلا ذراعين

14
00:04:09,240 --> 00:04:11,790
،ونصفا التنّين العلوي والسفلي

15
00:04:11,790 --> 00:04:13,810
ورأس الأفعى

16
00:04:13,810 --> 00:04:16,110
أربعة ضدّ اثنين إذا تحرّينا الدقّة

17
00:04:23,220 --> 00:04:24,410
!إلى اللّقاء

18
00:04:24,410 --> 00:04:25,200
!وداعاً

19
00:04:25,200 --> 00:04:26,120
!نراكِ لاحقاً

20
00:04:26,520 --> 00:04:27,840
هل تعلمين؟

21
00:04:27,840 --> 00:04:29,440
...عائلة آيرا-سان

22
00:04:29,440 --> 00:04:30,450
أجل، أعلم

23
00:04:30,450 --> 00:04:32,470
تدير ذلك النادي القتالي الكبير، صحيح؟

24
00:04:45,050 --> 00:04:46,830
!شكراً لاستضافتي مجدّداً اليوم

25
00:04:47,120 --> 00:04:48,810
!على الرّحب

26
00:04:48,810 --> 00:04:49,490
حسناً

27
00:05:09,410 --> 00:05:10,450
!هذا يكفي

28
00:05:11,070 --> 00:05:13,330
مُصارعة 100 شخص بأسلوب آيرا

29
00:05:13,330 --> 00:05:15,240
قد تمّت الآن

30
00:05:16,960 --> 00:05:17,910
!عُلِم

31
00:05:19,830 --> 00:05:21,980
أبليتِ حسناً يا كاناي

32
00:05:22,180 --> 00:05:24,120
،على ضوء قدرتكِ

33
00:05:24,120 --> 00:05:28,000
أوصي بكِ كمُرشَّحة لرئاسة فنّ آيرا القتالي

34
00:05:28,000 --> 00:05:28,790
عُلِم

35
00:05:28,790 --> 00:05:33,510
لم يبقَ أحدٌ في نادي آيرا
القتالي يستطيع هزيمتكِ

36
00:05:33,840 --> 00:05:36,950
وسيُسكِتُ هذا نقّادكِ على الأرجح كذلك

37
00:05:36,950 --> 00:05:37,610
عُلِم

38
00:05:38,270 --> 00:05:41,570
كاناي، اسمحي لي أن أسألكِ مجدّداً

39
00:05:41,570 --> 00:05:44,750
ماذا يعني "بو" وماذا يعني "ميتشي"؟

40
00:05:45,350 --> 00:05:46,470
ميتشي"؟"

41
00:05:47,190 --> 00:05:50,720
بو" هي القوّة التي نمرنّها ونصقلها"

42
00:05:50,720 --> 00:05:53,480
ميتشي" هي التّنفيذ القويم"

43
00:05:55,230 --> 00:05:59,600
كاناي، هل ستستمرّين في السّعي وراء "ميتشي"؟

44
00:06:01,810 --> 00:06:02,870
سأفعل

45
00:06:03,480 --> 00:06:04,740
أحسنت القول

46
00:06:05,150 --> 00:06:10,680
كاناي، أولئك الذين يتبنّون اسم "آيرا" عليهم
الظهور في ساحاتِ المعارك كمُحاربين

47
00:06:11,050 --> 00:06:13,040
ساحات المعارك؟

48
00:06:13,320 --> 00:06:14,440
أجل

49
00:06:14,940 --> 00:06:17,850
هناك أمور لا يمكن تعلّمها إلّا من خلال
القتال الفعليّ

50
00:06:17,850 --> 00:06:19,860
يجب أن تذهبي وتتعلّميها

51
00:06:20,420 --> 00:06:21,640
عُلِم

52
00:06:21,640 --> 00:06:25,740
!باستخدام قوّة آيرا، سأقوم بأعمال خير عظيمة

53
00:06:45,770 --> 00:06:48,970
هذه... ساحة معركة؟

54
00:06:51,880 --> 00:06:52,970
...كيف

55
00:06:53,950 --> 00:06:56,790
...كيف لشيء غير معقول كهذا

56
00:06:56,790 --> 00:06:58,510
أن يكون جزءاً من "ميتشي"؟

57
00:07:15,730 --> 00:07:17,220
لماذا؟

58
00:07:17,220 --> 00:07:21,080
بأي منطق يقتل النّاس بعضهم بعضاً بإسراف؟

59
00:07:23,490 --> 00:07:26,640
كم تساوي قيمة الحياة؟

60
00:07:40,310 --> 00:07:44,210
هل لدى "بو" و "ميتشي" أي مكان
في الحرب حقّاً؟

61
00:07:52,240 --> 00:07:54,860
،إذا انقرضت البشريّة

62
00:07:54,860 --> 00:07:57,400
فهل سيكون هذا لصالح الأرض؟

63
00:08:34,050 --> 00:08:36,270
سيّدتي، ألم تكتفي؟

64
00:08:36,990 --> 00:08:38,360
اصمت

65
00:08:39,740 --> 00:08:42,660
العالم متناقض لعين

66
00:08:43,230 --> 00:08:45,110
مليء بالمنافقين

67
00:08:45,620 --> 00:08:48,410
وكلمة "خير" هي مجرّد شِعار

68
00:08:48,900 --> 00:08:52,910
الشرّ هو الذي يسيّر العالم

69
00:08:53,870 --> 00:08:56,740
،حتّى لو قاتلت لأجل السّلام

70
00:08:56,740 --> 00:08:59,620
ما يمكنك فعله محدود

71
00:09:00,940 --> 00:09:03,090
البلاد التي نسعى جاهدين لإنقاذها

72
00:09:03,090 --> 00:09:06,060
تتدمّر بواسطةِ عدم أمانة الحكومة الجديدة

73
00:09:06,490 --> 00:09:13,510
أعتقد أنّني أُرسِلتُ إلى هناك فقط لأزيد
...وضع القتال سوءاً

74
00:09:37,080 --> 00:09:41,330
لا أسماك في ماءٍ نقيّ جدّاً" صحيح؟"

75
00:09:41,330 --> 00:09:42,560
بالفعل

76
00:09:42,560 --> 00:09:46,380
أي أنّ السمك لا يستطيع العيش
في ماءٍ نظيفٍ للغاية

77
00:09:46,380 --> 00:09:50,920
لا بدَّ وأنّ الأمينين جدّاً يواجهون صعوبةَ
العيش في عالمنا

78
00:09:55,010 --> 00:09:57,570
!الخمر رائع

79
00:09:58,090 --> 00:10:05,050
ما دمتُ ثملة، لا أفكّر في أي شيء

80
00:10:09,680 --> 00:10:11,360
...لكن

81
00:10:11,360 --> 00:10:14,040
...ربّما أفرطتُ في الشرب

82
00:10:23,770 --> 00:10:25,590
!أنا سريعة! أنا سريعة

83
00:10:31,470 --> 00:10:33,240
!هذا رائع

84
00:10:35,830 --> 00:10:37,870
،إن كنت لا تستطيع السّير على ساقين

85
00:10:37,870 --> 00:10:39,800
!فافعل ذلك بأربعة

86
00:10:51,730 --> 00:10:53,230
...هذا مؤلم

87
00:11:05,010 --> 00:11:09,470
كنتُ فقط عندما أغمر نفسي بالخمرِ والدّماء

88
00:11:09,470 --> 00:11:11,890
أستطيع نسيان كلّ شيء

89
00:11:53,490 --> 00:11:55,470
،لكن في ساحةِ المعركة

90
00:11:55,490 --> 00:11:57,460
بدا أنّني أتلقّى إطراءً أكبر

91
00:11:57,460 --> 00:12:00,290
مقارنة بما تلقّيتُه عندما اتّخذتُ الأمر بجدّية

92
00:12:03,750 --> 00:12:05,420
...هذا مؤلم

93
00:12:05,780 --> 00:12:09,650
هذه هي "ميتشي" التي تعلّمتِها
في ساحة المعركة إذاً؟

94
00:12:09,650 --> 00:12:11,470
ميتشي"؟"

95
00:12:11,470 --> 00:12:14,570
ذكّرني ماذا كانت تعني "ميتشي"؟

96
00:12:15,420 --> 00:12:19,070
قرّرتُ ألّا أفكّر في أي شيء

97
00:12:19,600 --> 00:12:23,410
تفريغ ذهني جعل كلّ الأمور أسهل

98
00:12:23,410 --> 00:12:26,160
!وأسعدَ الجميع أكثر

99
00:12:26,480 --> 00:12:29,520
"ما تفعلينه الآن لم يعُد "بو

100
00:12:29,520 --> 00:12:32,020
لستِ أكثر من مجرّد وحش هائج

101
00:12:32,790 --> 00:12:35,370
لا فرق بين البشر والوحوش

102
00:12:36,490 --> 00:12:37,580
غادري

103
00:12:41,570 --> 00:12:44,110
لا تطئي عتبة بابي مجدداً

104
00:12:48,370 --> 00:12:52,910
!حسناً! لن أعود أبداً

105
00:13:09,630 --> 00:13:12,060
!اسكب مجدّداً يا خادم الحانة

106
00:13:25,130 --> 00:13:28,710
سيّدتي، تغيّرتِ كثيراً

107
00:13:29,780 --> 00:13:31,700
...أجل تغيّرت

108
00:13:31,700 --> 00:13:34,490
فالتغيّر هو ما يفعله البشر

109
00:13:45,910 --> 00:13:47,950
هل لديك اعتراض على ذلك؟

110
00:14:15,160 --> 00:14:18,030
ما هو الجهد مجدّداً؟

111
00:14:18,640 --> 00:14:20,500
ما هي المثابرة؟

112
00:14:21,210 --> 00:14:22,240
ماذا؟

113
00:14:23,090 --> 00:14:26,730
كيف تهجي كلمة "الاجتهاد" مجدّداً؟

114
00:14:28,690 --> 00:14:30,340
...حسناً، غير مهمّ

115
00:14:30,690 --> 00:14:33,970
لم يستطع أي شيء إيقافي. لم يوقفني أي شيء

116
00:14:45,950 --> 00:14:50,060
لم يستطع أي شيء إيقافي. لم يوقفني أي شيء

117
00:14:59,230 --> 00:15:02,010
،لم أعد أقدر على قراءةِ التعابير

118
00:15:02,010 --> 00:15:04,460
لهذا توقّفتُ عن النظر إلى وجوه أعدائي

119
00:15:05,550 --> 00:15:08,530
،لم أستطع تذكّر أسماء حلفائي

120
00:15:08,530 --> 00:15:10,810
لهذا بدأتُ بالقتالِ بمفردي

121
00:15:11,850 --> 00:15:13,610
صرتُ عاجزة عن قراءةِ الخرائط

122
00:15:14,370 --> 00:15:17,480
لكن لم يستطع أي شيء إيقافي. لم يوقفني أي شيء

123
00:15:18,430 --> 00:15:21,630
صرتُ عاجزة عن قراءة الكلمات المعقّدة

124
00:15:21,630 --> 00:15:25,360
كنتُ أستطيع القيام بعمليّة الضرب، لكن فقدتُ
القدرة على القيامِ بعمليّة القسمة

125
00:15:25,700 --> 00:15:29,040
لم يستطع أي شيء إيقافي. لم يوقفني أي شيء

126
00:15:29,810 --> 00:15:32,040
لم أكن أستطيع تذكّر التاريخ الحالي

127
00:15:32,630 --> 00:15:35,670
كان من الصّعب تذكّر يوم ميلادي

128
00:15:36,490 --> 00:15:39,260
انحدرتُ إلى شخص يسير للأمام على نحوٍ أعمى

129
00:15:39,780 --> 00:15:40,890
...لكن

130
00:15:41,720 --> 00:15:43,500
لم يوقفني أي شيء

131
00:15:49,820 --> 00:15:52,290
لم أعد قادرة على التّمييز

132
00:15:52,290 --> 00:15:56,150
ما إن كنتُ حيّة أو إن كنتُ ميّتة

133
00:15:57,770 --> 00:16:01,130
...لم يستطع أي شيء... أي شيء

134
00:16:03,210 --> 00:16:05,210
أي شيء إيقافي

135
00:16:10,330 --> 00:16:14,050
،إذا استغلّ مُستحضر الأرواح قدرات جنوده

136
00:16:14,050 --> 00:16:17,680
فقد تنتهي حرب جوني تايسِن

137
00:16:18,590 --> 00:16:21,260
،في هذه الحالة، إن أهدرنا الوقت

138
00:16:21,260 --> 00:16:24,420
فقد تأتي تعزيزات أخرى

139
00:16:24,800 --> 00:16:27,720
يا محاربة النمر، هل من أفكار ابتكاريّة؟

140
00:16:28,730 --> 00:16:29,870
،وإن افتقرتِ لذلك

141
00:16:29,870 --> 00:16:34,070
فسأقبل بقدرةٍ خاصّة قد تخلّصنا من هذا

142
00:16:34,700 --> 00:16:39,110
،التّحليق أو دخول نفق في الأرض
كلا الخيارين مقبولان

143
00:16:39,110 --> 00:16:42,720
آسفة، لكن كلّ ما لديّ هو قبضة السّكران

144
00:16:42,720 --> 00:16:48,060
لم أتوقّع مواجهة أشخاص يستطيعون الحركة
حتّى بعد أن تقطّعهم

145
00:16:49,070 --> 00:16:50,300
هكذا إذاً

146
00:16:50,300 --> 00:16:52,570
حسناً، لا يمكنني لومكِ

147
00:16:52,570 --> 00:16:54,290
فموقفي مشابه

148
00:16:54,890 --> 00:16:59,640
إذاً رغم أنّ هذا ليس اختصاصي، سنحتاج إلى خطّة

149
00:16:59,640 --> 00:17:02,760
مضَتْ فترة طويلة منذ اتّبعتُ استراتيجيّة

150
00:17:03,270 --> 00:17:06,730
انظري إلى ذلك الجذع الذي يحوم في الهواء

151
00:17:07,100 --> 00:17:10,250
هل تعلمين ما الذي يحمله على ظهره؟

152
00:17:11,290 --> 00:17:12,700
لا أدري

153
00:17:12,700 --> 00:17:14,870
هل تعني أنّه ليس نفس

154
00:17:14,870 --> 00:17:17,210
قاذف اللّهب الذي حمله أخوه الصّغير؟

155
00:17:17,210 --> 00:17:21,730
لديّ حدس بأنه العكس، جهاز لبخّ
غاز مبرِّد

156
00:17:22,070 --> 00:17:25,240
إنّه على الأرجح مليء بهيدروجين سائل

157
00:17:26,100 --> 00:17:28,170
ما هو الهيدروجين السائل بالضبط؟

158
00:17:28,470 --> 00:17:30,730
—ألا تعلمين؟ إنّه

159
00:17:32,300 --> 00:17:35,650
!يُقال أنّه حتّى أصغر أفعى يمكنها أن تأكل إنساناً

160
00:17:40,580 --> 00:17:46,220
تاتسومي الأخ الأكبر: المُحارب
!التنّين، يقتل لأجل المال

161
00:17:46,540 --> 00:17:52,270
تاتسومي الأخ الأصغر: المُحارب
!الأفعى، يقتل لأجل المال

162
00:17:47,920 --> 00:17:52,260
يقتل
لأجل المال

163
00:17:50,300 --> 00:17:52,260
أفعى

164
00:17:53,040 --> 00:17:55,670
هكذا كان ليكون الأمر لو بقيا حيّين

165
00:17:56,810 --> 00:18:00,020
،أوشي: المُحارب الثّور
يقتل بانتظام

166
00:18:02,930 --> 00:18:07,170
،تورا: المُحاربة النمر
تقتل بغضب سكران

167
00:18:22,330 --> 00:18:23,740
لا أدري

168
00:18:23,740 --> 00:18:25,920
هل تعني أنّه ليس نفس

169
00:18:25,920 --> 00:18:28,170
قاذف اللّهب الذي حمله أخوه الصّغير؟

170
00:18:28,610 --> 00:18:32,930
لديّ حدس بأنه العكس، جهاز لبخّ
غاز مبرِّد

171
00:18:33,310 --> 00:18:36,120
إنّه على الأرجح مليء بهيدروجين سائل

172
00:18:36,380 --> 00:18:39,240
هيدروجين سائل إذاً؟

173
00:18:45,800 --> 00:18:48,440
...عندما يكون لديك سلاح لا تستخدمه

174
00:18:48,440 --> 00:18:50,230
فالسّبب ليس هو أنّك لا تستطيع

175
00:18:50,230 --> 00:18:52,970
!إنّما هو أنّ لديك سبب يمنعك من استخدامه

176
00:19:18,870 --> 00:19:21,160
يسرّني أنّكِ فهمتِ مقصدي

177
00:19:21,640 --> 00:19:25,390
لكن حبّذا لو حذّرتِني قبل أن تتصرّفي

178
00:19:26,480 --> 00:19:29,000
أنا من ينبغي أن أقول لك ذلك

179
00:19:29,380 --> 00:19:32,560
كيف لي أن أعرف وأنت لم توضّح لي؟

180
00:19:33,060 --> 00:19:37,150
رغم أنّهما جثّتان، إلّا أنّ العيون ما زالت
تعمل على ما يبدو

181
00:19:37,530 --> 00:19:42,160
وبالتالي، لو شرحتُ بوضوح، لكانا ربّما قد سمعا

182
00:19:42,910 --> 00:19:45,220
لستُ معتاداً على التخطيط

183
00:19:45,220 --> 00:19:47,550
من السيّئ أن أقوم بأعمال غير مألوفة لي

184
00:19:48,060 --> 00:19:49,580
رغم أنّ الأمر انتهى على ما يُرام

185
00:19:49,580 --> 00:19:52,910
كانت النهاية الفضلى بالنسبة إليّ

186
00:19:52,910 --> 00:19:56,760
هي أن تتجمّد أيضاً

187
00:19:56,760 --> 00:19:59,590
هل أنتِ متأكّدة من ذلك؟

188
00:19:59,790 --> 00:20:02,080
كما وعدت، ما زلتُ أنوي

189
00:20:02,080 --> 00:20:04,840
أن أتحدّاكِ في نزال كما أردتِ

190
00:20:07,260 --> 00:20:08,500
،لكن

191
00:20:08,500 --> 00:20:13,330
أعتقد أنّ على حلفنا أن يدوم وقتاً أطول قليلاً

192
00:20:13,600 --> 00:20:15,140
وقد أدركتِ هذا، أليس كذلك؟

193
00:20:15,140 --> 00:20:17,160
بالطبع

194
00:20:17,160 --> 00:20:20,720
العجوز الخروف قد اختبأ بشكلٍ أفضل

195
00:20:21,020 --> 00:20:25,000
!اخرج من مكانك أيّها الأحمق

196
00:20:32,460 --> 00:20:35,630
ستكون اثنين ضدّ واحد، لكن أشكّ بأنّك ستشتكي

197
00:20:35,630 --> 00:20:39,740
كونك كنتَ تقاتل بفريقٍ لفترةٍ طويلة

198
00:20:40,260 --> 00:20:44,800
،أوساغي: المُحارب الأرنب
يقتلُ نفسيّاً

199
00:20:44,800 --> 00:20:48,410
،أوشي: المُحارب الثّور
يقتلُ بانتظام

200
00:20:48,410 --> 00:20:52,640
،تورا: المُحاربة النمر
تقتل بغضب سكران

201
00:21:21,470 --> 00:21:22,580
...حسنٌ إذاً

202
00:21:23,450 --> 00:21:27,040
هل نرتاح قليلاً أوّلاً أيّتها المحاربة النمر؟

203
00:21:27,530 --> 00:21:31,100
هوّن عليك أيّها المُحارب الثّور

204
00:21:31,410 --> 00:21:34,840
فقد بدأتُ للتو أشعر بثمالةٍ ممتعة
من الدّماء التي كنتُ أشربها

205
00:21:36,070 --> 00:21:37,390
...والآن

206
00:21:38,690 --> 00:21:41,310
!لنستمتع بهذا

207
00:21:41,650 --> 00:21:44,420
اجعل هذا مسلّياً لي

208
00:21:46,030 --> 00:21:49,930
عظيم. ينتهي حلفنا في هذه اللّحظة

209
00:21:50,810 --> 00:21:53,010
لنتبارز

210
00:23:25,630 --> 00:23:28,890
يُقال "لا يستطيع المرء اصطياد نمر
"دون أن يدخل إلى عرينه

211
00:23:29,160 --> 00:23:33,550
قد ينتهي المطاف بك لقمة سائغة للنمر
لكن لن تعرف ما لم تدخل

212
00:23:33,540 --> 00:23:36,530
،الحلقة القادمة: قد يموت النّمر
لكنّه يخلّف جلدَه

213
00:23:36,530 --> 00:23:39,040
!جميعكم، صفِّقوا