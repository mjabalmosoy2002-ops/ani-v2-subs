1
00:00:12,350 --> 00:00:15,450
،اجتمعت الشخصيّات الهامّة الموقّرة هنا اللّيلة

2
00:00:15,450 --> 00:00:18,860
جوني تايسِن هي حربٌ لأجلِ الحرب

3
00:00:19,250 --> 00:00:24,020
تِلك الحروب المُكلِفة اقتصاديّاً وبشريّاً وبيئيّاً

4
00:00:24,020 --> 00:00:25,890
،والتي تُقامُ مرّة في كلّ اثني عشر عاماً

5
00:00:25,890 --> 00:00:29,180
تركّز على معركةٍ يخوضُها اثنا عشر محارباً فقط

6
00:00:29,180 --> 00:00:31,320
حرب بالوكالة

7
00:00:31,900 --> 00:00:35,640
صِراع إقليمي عادل وسلمي على البِلاد
التي تمتلكونها أنتم

8
00:00:35,640 --> 00:00:37,630
يا ضيوفنا الموقّرين

9
00:00:37,630 --> 00:00:40,690
إنّه رِهان رفيع للسيطرةِ على العالم

10
00:00:41,650 --> 00:00:46,140
عندما نصلُ للمرحلةِ التي يُقضى فيها
،على نصفِ الاثني عشر مُقاتِلاً

11
00:00:46,140 --> 00:00:48,480
سنشرع بالمُراهنة الرسميّة

12
00:00:48,890 --> 00:00:53,340
والآن دعونا نتفقّد الأداء الحالي لكلِّ مُحارب

13
00:00:54,720 --> 00:00:59,660
،الحائز على صدارةٍ باكِرة، المُحارب الثّور
بثلاثة من جوسيكي

14
00:01:00,030 --> 00:01:04,290
،ويأتي ثانياً مُحارِبا الأرنب والتنّين
إذ يمتلك كلّ منهما اثنتين

15
00:01:04,290 --> 00:01:09,170
والآخرون هم في المركزِ الرّابع والذين
يمتلكون واحدة في أجسادهم فقط

16
00:01:09,410 --> 00:01:10,680
،في ظلّ هذه القواعد

17
00:01:10,680 --> 00:01:14,360
اعتقدتُ أنّ المنطق سيقودهم لتشكيلِ
فِرق في وقتٍ مُبكّر

18
00:01:14,360 --> 00:01:16,800
لكن الأرنب هو الوحيد من فعل ذلك

19
00:01:16,800 --> 00:01:20,250
،قلتَ أنّنا سنضع رِهاننا عندما يبقى نصفُهم

20
00:01:20,250 --> 00:01:22,930
لكن يمكننا أن نفترض بأنّ الجثّة غير محسوبة، صحيح؟

21
00:01:22,930 --> 00:01:25,180
بالفعل، معكِ حقّ

22
00:01:25,510 --> 00:01:30,250
لكن بالنسبةِ للمُحاربين القادرين على مُواجهة
...ذلك الفريق بمُفردِهم

23
00:01:30,250 --> 00:01:31,430
الثّور

24
00:01:31,430 --> 00:01:35,490
بمعرفتي لذلك النّابِغة، لن يتمكّن فريقٌ من فعل
شيء سوى كبح جِماحه

25
00:01:35,490 --> 00:01:38,950
قد يذبحهم جميعاً بمفردِه

26
00:01:38,950 --> 00:01:42,740
القرد والجرذ هُما فريقٌ أيضاً، أليس كذلك؟

27
00:01:42,740 --> 00:01:45,940
نعلمُ أمرَ القرد، لكن ماذا عن الجرذ؟

28
00:01:45,940 --> 00:01:49,830
معلوماتنا عنه قليلة جدّاً، لا أملك
أدنى فكرة عن براعتِه في القتال

29
00:01:50,100 --> 00:01:52,590
،وفي هذه المعركة

30
00:01:52,590 --> 00:01:56,620
ستعودُ عليها سلميّتُها بالضرر من نواحٍ عديدة

31
00:01:56,620 --> 00:02:01,460
لكن هنالك احتمال كبير أن يكون هؤلاء الثّلاثة
هم آخر من يبقى على قيد الحياة

32
00:02:02,220 --> 00:02:03,710
ثلاثة خيارات فقط؟

33
00:02:03,710 --> 00:02:07,410
هذا مُتوقَّعٌ جدّاً، أشكّ بأنّ الرّهانات على أي من هؤلاء
سيُكسبنا الكثير من العائدات

34
00:02:07,410 --> 00:02:09,810
أما من شيء يغيّر مسار الأمور؟

35
00:02:10,260 --> 00:02:12,440
على سبيلِ المثال... الخروف

36
00:02:13,810 --> 00:02:18,320
أظنّه كان الفائز في الدّورة التّاسعة

37
00:02:19,010 --> 00:02:22,020
كان الفائز الوحيد آنذاك

38
00:02:22,020 --> 00:02:25,080
لكن لم يعُد بمُستواه المعهود

39
00:02:25,960 --> 00:02:29,780
من المُحال أن يُشارك ذلك العجوزٌ
في تايسِن من دون خطّة ما

40
00:02:29,780 --> 00:02:33,010
ناهيك عن أنّه الأكثر خبرة بينهم جميعاً

41
00:02:33,010 --> 00:02:35,240
لا يجوز تجاهله

42
00:02:35,740 --> 00:02:41,810
أفعال الخروف قد تغيّر نتيجة
هذه الدّورة كذلك

43
00:02:41,810 --> 00:02:46,100
هل هو حصان أسود هذه المرّة أم من المفضّلين للفوز؟

44
00:02:49,950 --> 00:02:51,180
...لنتابع

45
00:02:51,400 --> 00:02:55,930
!والآن حان وقتُ العرض يا جماعة
!لا تفوّتوا أي لحظة

46
00:02:55,930 --> 00:03:02,020
جوني تايسِن هي حربٌ عظيمةٌ ستُعيد
نتائجها رسمَ خريطة العالم

47
00:03:02,020 --> 00:03:05,230
بعد موت ثلاثة مُحاربين آخرين، سنبدأ بالمُراهنة

48
00:03:05,230 --> 00:03:09,450
فكِّروا مليّاً بالمُحارب الذي تعتقدون
بأنّه سيبقى حتّى النّهاية

49
00:03:09,450 --> 00:03:13,460
إلى ذلك الحين، راقِبوا بعنايةٍ لتروا
كيف يُقاتل هؤلاء المُحاربون

50
00:03:13,810 --> 00:03:18,960
سوف أنتظر رِهاناتكم يا حضرة البارزين الموقّرين

51
00:04:54,560 --> 00:04:59,040
،والآن من بين المُشاركين الحاليّين

52
00:04:59,040 --> 00:05:03,900
هناك ثلاثة مُحاربين أقوياء يمكنني وصفهم
بالقادة الحقيقيّين

53
00:05:04,140 --> 00:05:06,660
شاريو، المُحاربة القرد

54
00:05:06,660 --> 00:05:09,110
أوساغي، المُحارب الأرنب

55
00:05:09,350 --> 00:05:12,460
وأوشي، المُحارب الثّور

56
00:05:12,750 --> 00:05:15,370
،عندما تجمع اثني عشر شخصاً معاً

57
00:05:15,370 --> 00:05:18,440
فمن الطبيعي أن يكون بعضهم
أكثر موهِبة من آخرين

58
00:05:20,220 --> 00:05:25,050
لكن اختلال التّوازُن في تفضيلاتِهم كبير جدّاً

59
00:05:25,350 --> 00:05:30,430
في كلّ الأحوال، يجدرُ بي تجنُّب المُواجهة
المُباشَرة مع أولئك الثّلاثة

60
00:05:30,430 --> 00:05:33,060
،عجوز مثلي شديد الهزال

61
00:05:33,060 --> 00:05:35,630
سيسقطُ بضربةٍ واحدةٍ دون شكّ

62
00:05:36,190 --> 00:05:39,190
،لكن إذا سلكتُ مساراً مختلفاً

63
00:05:39,190 --> 00:05:45,820
وتحكّمتُ بالوضع بحيث يسحقُ أولئك
،الثّلاثة بعضهم الآخر

64
00:05:45,820 --> 00:05:49,070
فحتّى مُحارب عجوز ضعيف
مثلي قد يملك فرصة

65
00:06:00,190 --> 00:06:01,340
المعذرة

66
00:06:54,520 --> 00:06:57,370
!لماذا... لماذا؟

67
00:06:59,380 --> 00:07:05,170
ربحتُ في جوني تايسِن من قبل بالفعل

68
00:07:05,170 --> 00:07:08,380
لكن ما مضى قد مضى

69
00:07:08,380 --> 00:07:11,360
،لو أراد أحدهم أن يقيّم المُشاركين في تايسِن هذه

70
00:07:11,360 --> 00:07:15,530
فسوف يصنّفني عاشراً أو أقلّ في أحسن الاحتمالات

71
00:07:15,530 --> 00:07:19,710
الفُتُوّة بحدِّ ذاتها تُجلب قوّةً عظيمة

72
00:07:20,710 --> 00:07:24,570
...في هذه الأثناء، كان تارو

73
00:07:26,270 --> 00:07:28,510
ألن تنام لأجلي بعد؟

74
00:07:28,510 --> 00:07:30,220
...بينما أنا مُنهَك

75
00:07:30,620 --> 00:07:32,640
يا لك من مُشاغب

76
00:07:32,640 --> 00:07:36,540
هل أروي لك حكاية من أيّامي الخوالي؟

77
00:07:36,960 --> 00:07:41,690
منذ زمنٍ بعيد، عندما لم تكن الأمور
،هادئة كما هي الآن

78
00:07:41,690 --> 00:07:45,860
عاشَ تاجر أسلحة حيويّ في أرض بعيدة

79
00:07:45,860 --> 00:07:50,610
إنّه مُنتَجٌ جيّد، لكن أودّ أن أضيف
هذا إلى حسابي

80
00:07:50,610 --> 00:07:53,450
أستميحك عذراً، لكن لم يكن هذا اتّفاقنا

81
00:07:53,730 --> 00:07:57,460
لقد وضّحتُ مُسبقاً أنّني لا أتاجر إلّا نقداً

82
00:07:57,460 --> 00:08:01,080
كنّا في ضائقة ماليّة بحدِّ ذاتنا مؤخّراً

83
00:08:01,080 --> 00:08:03,840
لن نقبل بكلمةِ الرّفض منك

84
00:08:04,660 --> 00:08:07,710
تريدون أن تسدّدوا لي بالرّصاص إذاً؟

85
00:08:07,710 --> 00:08:10,990
هكذا إذاً. يبدو أنّكم لم تتركوا خياراً لي

86
00:08:10,990 --> 00:08:13,720
يسرّني التّعامل معكم

87
00:08:22,480 --> 00:08:25,270
أحسنتَ صنعاً في القضاءِ على أولئك القراصنة

88
00:08:25,270 --> 00:08:28,480
في الواقع، كنتُ أشعر بأنّ الأمور
قد جرَتْ مجراها الطبيعي

89
00:08:28,480 --> 00:08:32,240
...لكن أن تحاول بيعنا نفس البِضاعة

90
00:08:32,470 --> 00:08:35,430
أبيع المُنتجات لأولئك الذين يفهمون قيمتَها

91
00:08:35,430 --> 00:08:37,570
إنّه أمر طبيعي

92
00:08:38,440 --> 00:08:43,210
ففي نهايةِ المطاف، الزبائن الجدُد
قد يكونون بوّابة لزبائن أحدث

93
00:08:43,210 --> 00:08:46,210
كلّه مجّاناً هذه المرّة

94
00:08:46,510 --> 00:08:48,280
أتطلّع قُدماً لدعمِك المُستقبلي

95
00:09:00,770 --> 00:09:04,520
ومع كِفاح الشابّ في ساحاتِ المعارك
،الغارِقة بالموتِ والدّماء

96
00:09:04,520 --> 00:09:08,480
صنع لنفسه اسماً لامعاً كمحارب

97
00:09:36,430 --> 00:09:44,930
ثمّ سرعان ما قبِلَت به عائلة تسوجي، والتي هي
من زبائنه المقرّبين، زوجاً لابنتهم

98
00:09:45,320 --> 00:09:47,730
،ثمّ في دورة من دورات جوني تايسِن

99
00:09:47,730 --> 00:09:51,820
شارك كمحارب خروف

100
00:10:09,540 --> 00:10:16,130
وهكذا ربح في جوني تايسِن وتحقّقت أمنيته

101
00:10:16,130 --> 00:10:19,370
وتمكّن من رؤية وجه حفيده

102
00:10:20,160 --> 00:10:22,810
جدّي، ما هذا؟

103
00:10:22,810 --> 00:10:26,430
هذه هديّة عيد ميلاد منّي لك

104
00:10:26,910 --> 00:10:32,510
عشتُ في ساحة المعركة. ظننتُ أنّني سأموتُ هناك

105
00:10:27,710 --> 00:10:29,120
جرّب واضغط الزرّ

106
00:10:32,510 --> 00:10:37,700
لم أتوقّع أبداً أن أعيش حياةً مديدة
مع حفيد كما يعيش الأشخاص العاديّون

107
00:10:38,160 --> 00:10:41,120
أغلب خطط الفئران والرّجال غالباً
ما تنحرف في الحياة

108
00:10:41,120 --> 00:10:44,270
أو خطط خروف ربّما

109
00:10:41,360 --> 00:10:43,390
!جدّي! شكراً لك

110
00:10:46,520 --> 00:10:49,540
!ربِحت! جدّي، أنت فظيع

111
00:10:49,540 --> 00:10:51,300
أنا تائهٌ جدّاً

112
00:10:51,300 --> 00:10:54,880
هذا يختلفُ تماماً عن المعارك التي خضتُها

113
00:10:55,300 --> 00:10:59,560
ما كنتَ لتتمكّن على الأرجح من مُجاراة
المعارك في هذه الأيّام يا جدّي

114
00:10:59,560 --> 00:11:02,340
...ما الذي تقولينه! أنا بالتأكيد

115
00:11:08,490 --> 00:11:12,270
أبي، هل أنت متأكّد من هذا؟

116
00:11:12,270 --> 00:11:16,280
سأشارك في جوني تايسِن التالية بدلاً من حفيدي

117
00:11:16,750 --> 00:11:18,720
لقد اتّخذتُ قراري

118
00:11:25,000 --> 00:11:29,300
نلتُ فائضاً من السّعادةِ في الحياة

119
00:11:29,300 --> 00:11:34,030
لن أدع العائلة والأطفال الذين منحوني
تِلك السّعادة

120
00:11:34,030 --> 00:11:36,630
أن يتحمّلوا شيئاً من العبء

121
00:11:37,120 --> 00:11:40,820
ربّما سأحمل ذلك العبء معي
،إلى السّعادةِ القصوى

122
00:11:40,820 --> 00:11:44,510
...وآخذ معي مُحاربي تايسِن الآخرين

123
00:11:59,170 --> 00:12:01,490
إلى متى سيركض؟

124
00:12:05,940 --> 00:12:07,200
!فعل هذا فجأة

125
00:12:10,640 --> 00:12:11,830
ما الذي حدثَ بالضبط؟

126
00:12:22,740 --> 00:12:26,140
لم يفت الأوانُ بعد. ما زال بمقدورِك التّعاون معنا

127
00:12:27,060 --> 00:12:30,680
أتذكر ما قلتُه؟ لديّ طريقة تجعلُنا
ننجو جميعاً

128
00:12:30,680 --> 00:12:34,120
...إن أخفضتَ سلاحيك واستمعتَ إليّ

129
00:12:34,490 --> 00:12:37,860
،إن كانت لديك أمنية تُقاتل لأجلِها

130
00:12:37,860 --> 00:12:41,360
!فأنا مستعدّة للتعاون معك على تحقيقِها

131
00:12:44,260 --> 00:12:46,810
أوساغي-سان، ما هي أمنيتك؟

132
00:12:53,400 --> 00:12:58,870
السّؤال هو كيف أقلّص الفارِق بيني
وبين المُحاربين الرّفيعين

133
00:12:58,870 --> 00:13:02,460
ما الذي أمتلكه ولا يمتلكونه هم؟

134
00:13:02,720 --> 00:13:05,300
الخبرة والمعرِفة النّاجمة عنها

135
00:13:05,300 --> 00:13:10,140
...وإذا كانت لديّ أفضليّة واحدة أخرى

136
00:13:10,560 --> 00:13:12,720
فأظنّها هذه

137
00:13:13,390 --> 00:13:17,660
الحياة تعني التّعامل مع كلّ شيء
بحذرٍ مناسب

138
00:13:17,660 --> 00:13:21,900
البقاء يعني عدم المُخاطرة بلا ضرورة

139
00:13:22,400 --> 00:13:27,240
لا بدَّ من القول أنّني وجدتُ طريقةَ قصّ
الحجر الكريم غير طبيعيّة إطلاقاً

140
00:13:27,240 --> 00:13:32,490
ورغم أنّ لونه الدّاكن كان جميلاً، إلّا
أنني لم أشعر بأي جمالية في طريقةِ قصّه

141
00:13:32,490 --> 00:13:37,430
لكن عليّ أن أطلب منك أن تبتلع
واحدة منهما فقط

142
00:13:37,430 --> 00:13:42,120
حالما سمعتُ ذلك الكلام، عرفتُ
أنّ الجوهرة كانت خطيرة

143
00:13:38,830 --> 00:13:40,560
ماذا؟ أبتلِع؟

144
00:13:40,560 --> 00:13:41,650
أجل

145
00:13:41,650 --> 00:13:46,510
وهذا ينطبقُ على بقيّتِكم أيضاً
ابتلِعوا جواهركم بالكامل لو سمحتُم

146
00:13:47,040 --> 00:13:51,230
والآن من هو المُحارب الذي سأخدعه
باستخدام هذه الجوهرة؟

147
00:13:54,920 --> 00:13:59,840
فكرة أنّ بمقدوري بسط نفوذي
...على تايسِن بواسطة التّعاون معه

148
00:14:01,070 --> 00:14:02,420
!أنا خجلٌ جدّاً من نفسي

149
00:14:13,690 --> 00:14:14,910
لماذا؟

150
00:14:15,180 --> 00:14:16,580
،أنا آسف

151
00:14:16,580 --> 00:14:21,040
لكن نظراً للوضعِ الحالي للمعركة، وقت
التعاون كفريق قد ولّى

152
00:14:21,040 --> 00:14:26,420
مع ذلك، لم يسبق أن عجزتُ عن هزيمةِ خصم
بعد شنّ كلّ هذا العدد من الهجمات

153
00:14:26,420 --> 00:14:30,680
لا بدَّ وأنّ هذا الدّفاع المُصفّح
هو موهبتك كمُحارب

154
00:14:48,550 --> 00:14:50,130
...ذلك النّابِغة

155
00:14:50,130 --> 00:14:54,180
لم يأخذني على حين غرّة
أو استغلّ لحظة التهاء

156
00:14:54,470 --> 00:14:57,260
أوصلَني إلى هذا الوضع في نِزالِ رجُل لرجُل

157
00:15:02,840 --> 00:15:07,030
والرّابع سيكون الخنزير البرّي، من عائلة
الرّابح في تايسِن السّابقة

158
00:15:07,600 --> 00:15:11,480
لنضع الحِصان والكلب خامساً وسادساً

159
00:15:11,480 --> 00:15:14,210
كلاهما يبدوان مُقاتِلين صريحين

160
00:15:14,210 --> 00:15:17,560
ولا يستطيع المرءُ أن يستخفّ
بقوّةِ الحصان الدفاعيّة

161
00:15:17,560 --> 00:15:21,620
وسابعاً وثامناً... التوأمان، التنّين والأفعى

162
00:15:21,620 --> 00:15:24,910
لكن هذا إذا افترضنا فقط أنّهما معاً

163
00:15:24,910 --> 00:15:30,270
الإقصاء المبكّر للأفعى يُنقِص
من مرتبةِ التنّين حتماً

164
00:15:30,270 --> 00:15:33,240
وفي المركزِ التّاسع، لنضع الدّجاجة

165
00:15:33,830 --> 00:15:37,900
عليّ أن أستهدف الأشخاص الذين
في وسط التّرتيب

166
00:15:37,900 --> 00:15:42,420
الثّلاثة الأوائل أقوياء جدّاً عليهم
ليحلموا حتّى بمُواجهتهم

167
00:15:42,420 --> 00:15:45,710
،لا شكّ، أنا متأكّدٌ أنّهم يرسمون خططَهم الخاصّة

168
00:15:45,710 --> 00:15:50,000
لكنّهم يرغبون على الأرجح أن يُساعدهم
شيء ما في المضيّ قدماً

169
00:15:50,000 --> 00:15:53,510
وأنا سأقدّم ذلك الشيء

170
00:16:02,770 --> 00:16:06,410
علاوةً على ضغطِ المعركة، هناك ضغط السمّ

171
00:16:06,710 --> 00:16:11,910
هذا يكفي لتهتزّ قلوب أكثر المُحاربين رزانة

172
00:16:12,810 --> 00:16:15,680
أستطيع استغلال هذا القلق

173
00:16:16,440 --> 00:16:19,790
...أستغلّه بكلّ رفق

174
00:16:43,090 --> 00:16:45,510
!كان ذلك وشيكاً

175
00:16:45,510 --> 00:16:48,430
أشكّ بأن يستطيع ذلك الجهاز الصّغير
،القضاء على الثّور

176
00:16:48,430 --> 00:16:50,580
لكنّه سيؤدّي وظيفة إلهاء على الأقلّ

177
00:16:50,580 --> 00:16:51,820
...والآن

178
00:16:52,230 --> 00:16:54,210
تباً. إنّه لا يترك لي خياراً

179
00:16:54,560 --> 00:16:58,010
ادّعى بأنّه يصغي إليّ كي يكسبَ الوقت

180
00:16:58,010 --> 00:17:01,290
حتّى تصل تعزيزاته من تحت الأرض

181
00:17:03,610 --> 00:17:09,130
أشعر بالاشمئزازِ قليلاً. أهاجم حيوانات
...حتّى ولو كانت ميّتة بالفعل

182
00:17:21,110 --> 00:17:23,730
كما ترى، قدرتي كمُحارب"

183
00:17:23,730 --> 00:17:30,020
هي استخدام نفق ميكانيكا الكمّ
"لتمرير الأشياء عبر أي شيء

184
00:17:30,370 --> 00:17:33,730
هذا ما سأقوله. كذبة صريحة مخلوطة
بشيء من الواقع

185
00:17:33,730 --> 00:17:41,660
سيكون من دواعي سروري إزالة تلك"
"الجوهرة السامّة منك بطريقةٍ غير نافذة

186
00:17:42,130 --> 00:17:45,540
لن أزيلها فعليّاً بالطبع

187
00:17:45,540 --> 00:17:49,290
أشكّ بأنّهم سيطلبون منّي إزالتها فوراً أيضاً

188
00:17:49,670 --> 00:17:53,310
سيعتقدون أنّه من الآمن أكثر إبقاؤها
،في بطونهم في الوقتِ الرّاهن

189
00:17:53,310 --> 00:17:55,850
عوضاً عن المُخاطرةِ بوقوعِها
في يدِ شخصٍ ليهرب بها

190
00:17:55,850 --> 00:17:57,180
...في تلك الحالة

191
00:17:57,180 --> 00:18:01,680
حسناً، إن شكّلت حلفاً معي"
"فسأكون مَديناً للغاية

192
00:18:01,680 --> 00:18:07,690
فهذه العِظام المُهترئة لن تصمد
"إلى نهايةِ جوني تايسِن على أي حال

193
00:18:07,900 --> 00:18:11,640
،إذا قدّمتُ ببساطةٍ شروطاً من الصّعب أن يرفضوها

194
00:18:11,640 --> 00:18:17,180
فيُمكن أن يكون عرض إزالة جوهرتهم
هو ضمانتي الأخيرة

195
00:18:17,180 --> 00:18:20,200
،فأساساً، قد يتذاكى أحدهم ويقول

196
00:18:20,200 --> 00:18:25,910
لمَ لا تستخدم قدرتَك لتسرق الجواهر"
"من المُحاربين الآخرين؟

197
00:18:26,420 --> 00:18:30,460
هكذا سأشكّل فريقاً نافعاً لنفسي

198
00:18:30,720 --> 00:18:33,280
وبالطبع لن أعرض نفسي على عددٍ منهم
بما يكفي

199
00:18:33,280 --> 00:18:37,410
ليشكّلوا فريقاً حقيقيّاً حتّى لو كان
ذلك سيصبُّ في مصلحتي

200
00:18:37,880 --> 00:18:40,820
لن أطرح عرضي إلّا على واحد منهم

201
00:18:40,820 --> 00:18:44,270
فأساساً البشر قد لا يميّزون
أنّهم ينخدِعون

202
00:18:44,270 --> 00:18:48,480
بينما تراهم حسّاسين جدّاً عندما
يحدث ذلك لغيرهم

203
00:18:48,810 --> 00:18:52,070
قد يبقى فريق من اثنين طرفاً ضعيفاً

204
00:18:52,070 --> 00:18:56,740
لكن مع تفرّق ثنائي التنّين والأفعى
،في وقتٍ مبكّر

205
00:18:56,740 --> 00:19:01,920
فالمتبقّي الوحيد في جوني تايسِن
والذي قد يُشكّل فريقاً هو القرد

206
00:19:01,920 --> 00:19:05,410
وفريق القرد سيتألّف من سلميّين

207
00:19:09,660 --> 00:19:14,930
لستُ بحاجةٍ للخوف من مجرّد أعداد

208
00:19:15,460 --> 00:19:16,920
،إن لزِمَ الأمر

209
00:19:18,800 --> 00:19:21,250
...بمقدوري استخدام صنيعتي، السّلاح المُطلَق

210
00:19:21,250 --> 00:19:23,990
أو بالأحرى، ينبغي أن أسمّيه بالفنّ

211
00:19:23,990 --> 00:19:27,930
"القنبلة المعروفة باسم "شوكايوكوري

212
00:19:28,680 --> 00:19:31,220
،لو لم يتمّ اعتراضي آنذاك

213
00:19:31,220 --> 00:19:33,780
...لأنهيتُ الأمر برمّتِه بانفجارٍ واحد

214
00:19:34,870 --> 00:19:39,060
أعتقد أنّ ثلاث ساعات قد مضَتْ منذ
بدء جوني تايسِن

215
00:19:39,560 --> 00:19:43,910
ينبغي أن تكون الأمور قد استقرّت الآن

216
00:19:50,530 --> 00:19:54,460
كيف استطاعت تِلك الجثّة مقطوعة الرأس
اللّحاق بي كلّ هذه المسافة؟

217
00:19:55,790 --> 00:19:58,050
كيف ينظر أمامه؟

218
00:19:59,690 --> 00:20:01,500
لا، إنّه لا ينظر

219
00:20:02,350 --> 00:20:03,780
...في تلك الحالة

220
00:20:37,870 --> 00:20:42,590
اللِّقاء بمُحاربٍ أضعف منّي لن يفيدني إطلاقاً

221
00:20:42,940 --> 00:20:48,860
أحتاج لشخصٍ في المراتب الوسطى، رابعاً
...أو خامساً أو سادساً

222
00:20:49,210 --> 00:20:54,100
المُحاربون الذين يمكنني القول وبيقين
أنّهم أضعف منّي هما الجرذ والنّمر

223
00:20:54,510 --> 00:20:59,270
النّمر ضعيفةٌ للغاية ولا أدري حتّى
لماذا هي هنا

224
00:20:59,270 --> 00:21:03,280
وبالطبع إن اعتُبِرَتْ جديرة بما يكفي
للمُشاركةِ في جوني تايسِن

225
00:21:03,280 --> 00:21:07,520
فلا بدّ وأنّها تمتلك شيئاً ما يجعلها مُوصى بها

226
00:21:12,780 --> 00:21:14,960
...المُحارِبة النّمر

227
00:21:14,960 --> 00:21:18,130
تقبعُ في ذيلِ ترتيب المُحاربين

228
00:21:18,130 --> 00:21:22,290
من الصّعب أن أقول أنّها قيّمة بما يكفي
لتكون شريكتي

229
00:21:22,680 --> 00:21:23,600
وها هي ذي

230
00:21:23,600 --> 00:21:26,740
إنّها لا تستهدف المحاربين الآخرين حتّى

231
00:21:26,740 --> 00:21:29,470
...تشرب حتّى الثّمالة فحسب

232
00:21:29,830 --> 00:21:32,730
لا تشكّل أدنى خطورة

233
00:21:33,020 --> 00:21:38,900
وبعيداً عن تشكيلِ أي خطورة، إنّها لا تحفّز
لديّ سوى الاحتقار

234
00:21:39,290 --> 00:21:42,220
...كنتُ لأفضّل الادّعاء بأنّني لم أرها، لكن

235
00:21:42,220 --> 00:21:44,880
أسمعك أيّها العجوز

236
00:21:44,880 --> 00:21:50,040
كفّ عن استراقِ النّظر واكشف عن نفسك

237
00:23:25,860 --> 00:23:29,840
لا يمكنك أن تحكم على حصانٍ لم تمتطِه"
"أو على شخصٍ لم تعش معه

238
00:23:29,840 --> 00:23:31,900
إنّ امتطاء حِصان يتطلّبُ شجاعة

239
00:23:31,900 --> 00:23:34,030
وأن تعيش مع آخر، يتطلّب شجاعةً أكبر حتّى

240
00:23:34,030 --> 00:23:36,640
الحلقة القادمة: حتّى فرس بطل
في السّباق قد يتعثّر

241
00:23:36,640 --> 00:23:39,070
!جميعكم، صفّقوا