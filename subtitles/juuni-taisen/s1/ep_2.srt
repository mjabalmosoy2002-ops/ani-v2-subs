1
00:00:01,970 --> 00:00:04,840
يسرّني انضمام مُسالمَين آخرين إليّ

2
00:00:04,840 --> 00:00:07,980
وأمّا عن البقيّةِ فإن غيّرتُم
رأيكم فيمكنكم إبلاغي في أي وقت

3
00:00:08,180 --> 00:00:10,580
...حسناً يا سيّد نعسان الذي هُناك و

4
00:00:10,580 --> 00:00:13,980
—أنت! سيّد أُذنَي أرنب، تعال

5
00:00:22,280 --> 00:00:23,130
!أنت

6
00:00:24,440 --> 00:00:25,410
!من هنا

7
00:01:04,820 --> 00:01:06,170
حسناً، لنذهب

8
00:01:08,430 --> 00:01:09,400
هيّا بنا

9
00:02:52,830 --> 00:02:57,460
أبادوا سكّانَ مدينةٍ يبلغُ عددهم 500.000
نسمة في ليلةٍ واحدةٍ فعلاً

10
00:02:58,700 --> 00:03:01,680
...أظنّ أنّه بقي بعض الأشخاص في الدّاخل

11
00:03:02,610 --> 00:03:03,930
أتعتقد أنّهم بخير؟

12
00:03:04,500 --> 00:03:05,530
هل هذا الوقت

13
00:03:06,890 --> 00:03:08,640
مُناسبٌ حقّاً للقلقِ على الآخرين؟

14
00:03:09,540 --> 00:03:10,410
معك حقّ

15
00:03:10,850 --> 00:03:13,720
لنبحث عن مكانٍ يمكننا الاختباء فيه حالياً

16
00:03:20,420 --> 00:03:21,920
...هكذا إذاً

17
00:03:24,400 --> 00:03:28,050
مُذهِل، باعتقادي سيكون
هذا بمثابةِ بقعة عمياء

18
00:03:28,430 --> 00:03:32,080
بالمُناسبة، شكراً لك للمُوافقةِ على مُقترح
السّلام الذي طرحتُه

19
00:03:32,550 --> 00:03:36,310
لا مُشكلة. لهذا أنقذتِني في نهايةِ المطاف

20
00:03:36,610 --> 00:03:37,620
أجل

21
00:03:38,630 --> 00:03:41,430
أدركتُ للتو. لم نتعرّف
على بعضِنا الآخر، أليس كذلك؟

22
00:03:42,080 --> 00:03:45,750
،شاريو: المُحارِبة القرد
تقتلُ بسلام

23
00:03:42,450 --> 00:03:45,990
تقتلُ
بسلام

24
00:03:42,450 --> 00:03:45,990
قرد

25
00:03:45,990 --> 00:03:49,480
نيزومي: المُحارِب الجرذ، يقتلُ الجميع

26
00:03:46,620 --> 00:03:50,160
يقتلُ الجميع

27
00:03:46,620 --> 00:03:50,160
جرذ

28
00:03:51,710 --> 00:03:54,520
أنت صغيرٌ جدّاً، أليس كذلك؟

29
00:03:54,520 --> 00:03:57,000
لكن ليتمّ اختيارك للمُشاركةِ في جوني تايسِن

30
00:03:57,000 --> 00:04:00,090
لا بدّ أن تكون بارعاً بما فيه الكفاية كمُحارِب

31
00:04:00,110 --> 00:04:04,010
حسناً، عندما يتعلّقُ الأمرُ بالقِتال، لكلّ
شخصٍ معاييره الخاصّة

32
00:04:04,010 --> 00:04:05,740
"حول حجمِ كلِمة "كفاية

33
00:04:06,020 --> 00:04:08,890
...قد يكون التّعامل مع أطفال مُتعِباً

34
00:04:08,890 --> 00:04:10,850
أنتِ قويّةٌ للغاية، أليس كذلك؟

35
00:04:12,420 --> 00:04:15,550
حسناً، آمل أن أكون قويّة بما يكفي
للدفاعِ عن نفسي

36
00:04:15,550 --> 00:04:17,330
لا تكوني مُتواضِعة

37
00:04:17,330 --> 00:04:20,470
كنتِ أنتِ من أسقطَ الطّابق، أليس كذلك؟

38
00:04:21,620 --> 00:04:23,360
آنسة شاريو؟

39
00:04:23,830 --> 00:04:26,480
استطاع أن يعرف؟

40
00:04:27,120 --> 00:04:31,790
أعتقد شخصاً ما قد كشفَ أنّ حلفكِ
،على وشك أن يتأسّس

41
00:04:31,790 --> 00:04:35,460
وكان يستعدُّ لشنِّ هجمة أولى لمنعِ ذلك

42
00:04:35,750 --> 00:04:37,790
لكنّكِ أحسستِ بذلك وحميتِنا بواسطة

43
00:04:37,790 --> 00:04:40,340
إسقاط الطّابق وإعادتنا للمربّع الأوّل

44
00:04:40,340 --> 00:04:41,130
أليس هذا صحيحاً؟

45
00:04:41,680 --> 00:04:44,520
أجل، هذا دقيقٌ إلى حدٍّ ما

46
00:04:45,040 --> 00:04:49,150
لكن لم يكن "إحساسي" فقط أو
أي شيء مُبهَم من هذا القبيل

47
00:04:49,600 --> 00:04:52,760
كان يصدرُ عن شخصٍ رغبة شديدة واضحة للقتل

48
00:04:53,150 --> 00:04:57,390
معنى هذا أنّ محارباً آخر كان حاضراً أراد

49
00:04:57,390 --> 00:05:02,000
أن يُنهي جوني تايسِن بنهجٍ مُعاكِس
تماماً لنهجي

50
00:05:11,960 --> 00:05:14,450
...فلنجلس

51
00:05:16,910 --> 00:05:23,250
يبدو أنّ أغلبهم قرّروا استغلال الفوضى
للاختباءِ في الوقتِ الرّاهن

52
00:05:23,760 --> 00:05:28,490
لا حدود صارِمة في حقلِ اللّعِب الخاصّ
بجوني تايسِن

53
00:05:28,490 --> 00:05:33,020
سمعتُ أنّ المرءَ يستطيعُ الابتعاد كثيراً
لدرجةِ مُغادرة البلد لو أراد

54
00:05:33,020 --> 00:05:36,920
،في الحقيقة، الفائز في الدّورةِ السّابقة، خنزير برّي

55
00:05:36,920 --> 00:05:39,440
حوّلَ مسارَ المعركة لصالحِه

56
00:05:39,440 --> 00:05:44,110
عندما اختارَ الرّحيل إلى مكانٍ
ذي كثافة سكّانية عالية

57
00:05:44,110 --> 00:05:50,700
لكن بحدٍّ زمنيٍّ واضحٍ فرضَه
،هذا السمّ في بطونِنا

58
00:05:50,700 --> 00:05:54,420
أشكُّ بأنّ أي شخص سيبتعد كثيراً عن هذه البلدة

59
00:05:54,420 --> 00:06:01,540
ما يعني أنّني عاجلاً أم آجلاً، سأحظى
بفُرصةٍ أخرى

60
00:06:01,540 --> 00:06:05,340
لاستخدامِ هذه "الشوكايوكوري" التي صنعتُها

61
00:06:12,790 --> 00:06:15,690
إلى أين ذهبَ بالضبط؟

62
00:06:15,690 --> 00:06:16,850
!مهلاً

63
00:06:17,210 --> 00:06:19,510
!يا مرحباً! يا مرحباً

64
00:06:34,520 --> 00:06:39,490
...قتل شخصٍ منذ البداية وجعله دُمية له

65
00:06:40,970 --> 00:06:41,990
مسكينة

66
00:06:58,490 --> 00:07:02,460
أجل، عرفتُ أنّ لا أحد سيأتي إلى هنا

67
00:07:06,190 --> 00:07:08,080
تنصُّ قواعد تايسِن لهذا العام

68
00:07:08,080 --> 00:07:12,190
أنّ علينا سرِقة جواهرَ السمّ
التي ابتلعَها الآخرون

69
00:07:12,200 --> 00:07:14,580
قنبلة الاثني عشر ساعة تلك ستُصعِّب

70
00:07:14,580 --> 00:07:19,290
استخدام الاستراتيجيّة الاعتياديّة والتي هي
الاختباء مبكّراً

71
00:07:19,910 --> 00:07:22,000
لكن هذا لا ينطبِق عليّ

72
00:07:23,360 --> 00:07:27,450
إن كانَتْ هُناك نظريّة، فإنّني
أسير بعكسِها. هذا هو أسلوبي

73
00:07:29,240 --> 00:07:35,820
أدع العالمَ يعتقد أنّ أسلوبي القتاليّ
هو عضّة "مِلزَمة الكلب المسعور" الهمجيّة

74
00:07:36,050 --> 00:07:41,890
لكن ما يعرّف المحاربَ الكلب فعليّاً
هو السمّ الذي تفرزه الأنياب

75
00:07:42,630 --> 00:07:47,670
وبالطبع أي شخص يتذوّقه ينتهي بالموت

76
00:07:43,920 --> 00:07:46,030
مرحباً

77
00:07:46,030 --> 00:07:48,910
من الحماقةِ أن تأتي إلى هنا بمفردِك

78
00:07:47,670 --> 00:07:53,550
أُنتِجُ السمَّ في جسدي، وبحقنِ عدوّي به

79
00:07:53,550 --> 00:07:58,320
...أستطيع القتل والقتل وأحياناً حتّى القتل

80
00:07:58,320 --> 00:08:00,690
،بالطبع، تبقى العضّة عضّة

81
00:08:00,690 --> 00:08:05,610
لذا عندما يكون العضّ هو أسلوبي
...فلا أكذِب عمليّاً

82
00:08:08,010 --> 00:08:13,560
عرفتُ من النظرةِ الأولى أنّ الجوهرة
شديدة السّواد كانت نوعاً من السّموم

83
00:08:14,000 --> 00:08:20,180
ولدى عِلمي بذلك، جعلتُ جسدي يحضِّرُ ترياقاً
لتحييدِ مفعولها مُسبَقاً

84
00:08:20,970 --> 00:08:25,200
غشّ؟ ربّما، لكن لا أشعر بتأنيب
الضمير البتّة

85
00:08:25,200 --> 00:08:29,200
عندما أحظى بأفضليّة فسوف أستغلّها
على أكمل وجه

86
00:08:29,200 --> 00:08:33,350
يبدو أنّ أمامنا مجموعة متعطِّشة جدّاً
للدماءِ هذه المرّة أيضاً

87
00:08:33,860 --> 00:08:36,460
،سيُقلِّصون أعدادهم على الأرجح في البداية

88
00:08:36,460 --> 00:08:37,810
لذا سأنتظر حاليّاً

89
00:08:37,810 --> 00:08:39,190
سأنتظر وبكلِّ سرور

90
00:08:39,190 --> 00:08:41,360
الانتظار هو أكثر ما يبرع فيه الكلب

91
00:08:50,040 --> 00:08:51,050
طائر؟

92
00:09:05,910 --> 00:09:07,190
!وجدتُك

93
00:09:09,300 --> 00:09:11,390
مـ-مرحباً

94
00:09:14,150 --> 00:09:15,460
ها نحن ذا

95
00:09:16,390 --> 00:09:23,050
بخصوصِ ما سبق... لم أكن أحاول إخفاء
حقيقة أنّني حطّمتُ الطّابق

96
00:09:23,050 --> 00:09:24,160
...لكن

97
00:09:24,960 --> 00:09:27,430
في الواقع، ربّما كنتُ كذلك

98
00:09:27,430 --> 00:09:29,890
عرفتُ أنّك ستحدّق بي بتلك
الطريقة لو علِمت

99
00:09:29,890 --> 00:09:32,070
أنا لا أحاول أن أبدو اتّهاميّاً

100
00:09:32,070 --> 00:09:34,540
أنا ذو عينين خادِعتَين بحكمِ طبيعتي

101
00:09:35,790 --> 00:09:39,560
الأهمّ... هل تمكّنتِ من تحديد هويّة الشّخص المُعتدي؟

102
00:09:40,150 --> 00:09:41,630
لم أستطع

103
00:09:41,630 --> 00:09:44,120
بصراحة لم أحظَ بالوقتِ الكافي لمتابعةِ التحرّي

104
00:09:44,450 --> 00:09:46,960
بذلت كلّ جهدي للسماح
للجميعِ بالهرب

105
00:09:47,220 --> 00:09:49,280
قلتُ لكِ لا تكوني مُتواضِعة

106
00:09:49,610 --> 00:09:52,730
،كان بمقدوركِ تحديد هويّته لو أردتِ

107
00:09:52,730 --> 00:09:56,280
بل حتّى قتله فوراً، أليس كذلك؟

108
00:09:58,150 --> 00:10:00,220
كان بمقدوري، صحيح

109
00:10:00,500 --> 00:10:05,090
لكن لا أستخدم قوّتي بهذا الشّكل

110
00:10:05,330 --> 00:10:09,470
هنالك طرق مُلائمة وقيّمة أكثر لاستخدام
،القوّة العظيمة

111
00:10:09,470 --> 00:10:10,710
يا نيزومي-كن

112
00:10:11,380 --> 00:10:13,240
ملائمة؟

113
00:10:15,080 --> 00:10:20,530
لكن ينتابني إحساسٌ بأنّ المُعتدي
...كان يتصرّف بشكلٍ لائق أكثر

114
00:10:31,300 --> 00:10:32,850
!لا تسئ الفهم من فضلِك

115
00:10:32,850 --> 00:10:35,360
!أعِدُك أنّني لن أؤذيك

116
00:10:35,360 --> 00:10:38,310
ما الذي تفكّر فيه هذه بالضبط؟

117
00:10:40,980 --> 00:10:44,860
أ-أنا الدّجاجة! نيواتوري، الدّجاجة

118
00:10:45,280 --> 00:10:50,120
...أتيتُ إلى هنا لأنّني... كنتُ
...آمل أن نتحالف

119
00:10:50,320 --> 00:10:51,250
نتحالف؟

120
00:10:51,760 --> 00:10:56,510
هذا صحيح... حاولَتْ قبول عرض القرد أيضاً

121
00:10:56,840 --> 00:11:02,220
هذا لِباسٌ كاشِفٌ وصارِخٌ جدّاً
بالنسبةِ لمتشرِّدة خجولة

122
00:11:02,220 --> 00:11:04,800
وكأنّه لِباس اختاره شخصٌ لها

123
00:11:05,060 --> 00:11:08,690
وأرغمها على المُشاركةِ في جوني تايسِن، ربّما؟

124
00:11:09,420 --> 00:11:11,540
أتقولين نتحالف؟

125
00:11:11,540 --> 00:11:13,130
...أ-أجل

126
00:11:13,130 --> 00:11:16,570
قد تغدو الأمور أكثر فوضويّة قليلاً، لكن
في المعركةِ الجماعيّة

127
00:11:16,780 --> 00:11:21,160
يـ-ينبغي أن تتحالف مع أحدٍ في البداية
دون أدنى شكّ، صحيح؟

128
00:11:21,070 --> 00:11:23,740
،لو كان دون شكّ فعلاً

129
00:11:21,160 --> 00:11:25,030
ثـ-ثمّ عندما لا يبقى غيرنا نحن الاثنان

130
00:11:23,740 --> 00:11:27,620
لما كانت القِرد الوحيدة
الّتي أقدمت على تِلك المُحاولة

131
00:11:25,030 --> 00:11:29,040
يمكننا تسوية الأمر بمعركةٍ مُنصِفة، واحد ضدّ واحد

132
00:11:27,900 --> 00:11:30,470
الجميع يعلمُ بأنّ هُناك فائز واحد في النّهاية

133
00:11:29,650 --> 00:11:34,790
!لذا تعاون معي من فضلِك! من فضلِك

134
00:11:30,700 --> 00:11:35,320
ألا تعلم بأنّ التعاون الجماعي والخيانة
يتجاوران جنباً إلى جنبٍ هنا؟

135
00:11:35,620 --> 00:11:41,410
لا أعلم ما الذي سأجنيه من التّعاون
...مع غبيّةٍ مثلها

136
00:11:41,410 --> 00:11:46,170
لكن إن تقاتلنا الآن وأُصِبتُ بجروح
فهذا ليس جيّداً لي أيضاً

137
00:11:46,170 --> 00:11:49,930
لا أرغب بأن تسنح أدنى فُرصة لإقصائي مبكّراً

138
00:11:49,930 --> 00:11:54,810
قد تكون أفضل فُرصة لي هي الادّعاء
،بالتّحالُفِ معها

139
00:11:54,810 --> 00:11:57,570
ومن ثمّ قتلها قبل مُواجهة أي شخص آخر

140
00:11:55,990 --> 00:11:58,680
!ناهيك عن أنّنا علينا الإسراع

141
00:11:58,950 --> 00:12:01,310
!نحن في ورطة! ورطة كبيرة

142
00:12:01,310 --> 00:12:04,380
...المُحارِب المُخيف الذي يحملُ فأسين

143
00:12:04,380 --> 00:12:07,940
!لا تنصدِم، إنّه مُستحضِر أرواح

144
00:12:07,940 --> 00:12:09,440
مُستحضِر أرواح؟

145
00:12:09,440 --> 00:12:13,990
قتلَ المُحارِبة الخنزير البرّي، وشكّل فريقاً
من ثلاثة أشخاص منذ الآن

146
00:12:13,990 --> 00:12:14,940
ماذا قلتِ؟

147
00:12:14,940 --> 00:12:18,850
لديّ... لديّ قدرةٌ تُدعى عين الغاق

148
00:12:18,850 --> 00:12:24,300
أستطيع التّواصُل مع الطيور التي تحلِّق
في السّماء وأرى ما يرونه

149
00:12:24,300 --> 00:12:27,570
هكذا وجدتُك أيضاً

150
00:12:27,570 --> 00:12:30,720
تِلك الحمامة... هكذا فعلَتْها إذاً

151
00:12:30,720 --> 00:12:33,850
،عـ-على أي حال، بعد أن سقط الطّابق

152
00:12:31,080 --> 00:12:33,980
!هذه الفتاة خرقاء جدّاً

153
00:12:33,850 --> 00:12:38,320
ذلك المُحارِب الأرنب المُخيف استخدمَ المُحاربَ
الأفعى الذي قتلَه قبل أن نبدأ

154
00:12:34,320 --> 00:12:38,940
...تكشف عن قدرتِها لشخصٍ التقَتْ به للتو

155
00:12:38,320 --> 00:12:40,380
وقتلَ المُحاربةَ الخنزير البرّي
بسهولة بالِغة

156
00:12:39,280 --> 00:12:42,650
لكن المُشكلة الحقيقيّة هي ذلك المُحارب
الأرنب الآن

157
00:12:40,380 --> 00:12:46,320
وها هو الآن قد حصلَ على جثّتيهما
ويتمشّى معهما

158
00:12:42,650 --> 00:12:46,320
مُستحضِرو الأرواح... خلتُهم أسطورة

159
00:12:46,750 --> 00:12:49,440
كلّما قتلوا أكثر، توسّعَتْ صفوفهم أكثر

160
00:12:49,440 --> 00:12:54,370
قاتِل يخلق... قاتل يمزِّق

161
00:12:54,830 --> 00:12:58,250
أعتقد أنّنا الوحيدان اللّذان على درايةٍ بهذا الأمر

162
00:12:54,830 --> 00:12:58,670
يمكنني هزيمتها بسهولة، لذا أستطيع
قتلها على راحتي

163
00:12:58,250 --> 00:13:01,970
أعني، على الأرجح... لكن إن لم نفعل شيئاً
فسيستمرُّ في توسيع فريقه

164
00:12:58,670 --> 00:13:02,050
سأنتفِعُ منها قدر ما أستطيع ومن ثمّ
أقتلها في أسرع وقتٍ مُمكن

165
00:13:01,970 --> 00:13:05,300
!إلى أن يعجز أي شخص عن مُواجهته
—لذا ينبغي أن نشكّل حلـ

166
00:13:02,050 --> 00:13:03,640
...لذا أوّلاً

167
00:13:04,670 --> 00:13:05,470
نيواتوري

168
00:13:05,470 --> 00:13:06,170
نـ-نعم؟

169
00:13:06,410 --> 00:13:09,270
هل تعرفين أين هو الأرنب الآن؟

170
00:13:09,270 --> 00:13:12,170
بـ-بالطبع أعرف. لقد كنتُ أتعقّبه

171
00:13:12,490 --> 00:13:15,410
لقد جعلتُ الطيورَ تُحافِظ على مسافة
بينها وبينه كي لا يُلاحظ

172
00:13:15,410 --> 00:13:18,310
لكن الأولويّة هي لتعقّبه

173
00:13:19,080 --> 00:13:23,470
حسناً. نظراً للظروف، سأقبل بعرضكِ

174
00:13:24,070 --> 00:13:28,030
لكن حريّ بكِ أن تؤمني بأنّني المسؤول
هنا يا عزيزتي

175
00:13:28,030 --> 00:13:30,480
...تـ... تعني

176
00:13:30,480 --> 00:13:32,560
لنصطد الأرنب. فلنبدأ بالقتل

177
00:13:32,560 --> 00:13:37,340
مرحى! مُذهِل! لنعمل بجدٍّ معاً
!ونربح في هذا

178
00:13:37,590 --> 00:13:38,850
!شكراً لك على قبولي

179
00:13:38,850 --> 00:13:41,610
لكن لن نبقى معاً لفترةٍ طويلة

180
00:13:41,610 --> 00:13:45,420
تنتهي شراكتُنا في اللّحظةِ التي يُسحَق
فيها فريقُ الأرنب

181
00:13:45,420 --> 00:13:47,790
!اسمح لي أن أعرِّف عن نفسي رسميّاً

182
00:13:47,790 --> 00:13:51,290
،نيواتوري: المُحارِبة الدّجاجة
!تقتلُ نقراً

183
00:13:48,510 --> 00:13:51,510
تقتلُ
نقراً

184
00:13:48,510 --> 00:13:51,510
دجاجة

185
00:13:51,680 --> 00:13:55,430
،دوتسكو: المُحارِب الكلب
يقتلُ عضّاً

186
00:13:52,770 --> 00:13:55,680
يقتلُ
عضّاً

187
00:13:52,770 --> 00:13:55,680
كلب

188
00:13:58,560 --> 00:14:03,390
حسناً إذاً... ما أفضل طريقة لاستغلالِ الفتاة؟

189
00:14:11,280 --> 00:14:13,150
أتعرف الأغنية

190
00:14:13,150 --> 00:14:16,120
،عبرنا تلك الجِبال المليئة بالأرانب"

191
00:14:16,120 --> 00:14:19,040
"واصطدنا في تِلك الأنهار المليئة بالشبّوط
والدّعابة كيف

192
00:14:19,040 --> 00:14:22,470
أنّ النّاس يبدون هم المليئين بالأرانب
لا الجبال؟

193
00:14:22,470 --> 00:14:26,580
لكن كنتُ أقول لنفسي، بما أنّ السّطر الثّاني
يحكي عن اصطيادِ السّمك

194
00:14:26,580 --> 00:14:29,650
—فقد أكلوا كثيراً من الأرانب على الأرجح

195
00:14:29,650 --> 00:14:34,800
إن أردتِ أن نتحادث فما رأيكِ أن نتبادل
المعلومات عن المُحاربين الآخرين؟

196
00:14:34,800 --> 00:14:35,940
!بالطبع

197
00:14:36,520 --> 00:14:38,850
المُحارِبون الوحيدون الذين أعرف عنهم

198
00:14:38,850 --> 00:14:42,430
هُم الثّور والتنّين والأفعى والقرد
والخنزير البرّي. أولئك الخمسة

199
00:14:42,900 --> 00:14:45,930
الأخطر بينهم هو الثّور دونما شكّ

200
00:14:47,420 --> 00:14:49,090
...لا أعلم كيف أعبِّر عن هذا

201
00:14:49,090 --> 00:14:53,650
ببسيطِ العبارة، إنّه أقوى ممّا يمكنكِ أن تتخيّلي

202
00:14:54,070 --> 00:14:57,380
يسحقُ كلّ خطوط العدوّ في ساحة
المعركة بلا استثناء

203
00:14:57,380 --> 00:15:00,200
يُعرَفُ بالنابِغة الجزّار

204
00:15:00,200 --> 00:15:01,920
النابِغة الجزّار؟

205
00:15:02,180 --> 00:15:05,970
أجل. إنه أحد المُرشّحين للفوز حتماً

206
00:15:05,970 --> 00:15:10,460
إن واجهتِه بمستواكِ، ما ينبغي أن تفعليه هو الهرب

207
00:15:11,170 --> 00:15:12,920
هذا لا يهمّ

208
00:15:12,920 --> 00:15:17,430
سواء قُتِلتِ بواسطة الثّور أو بواسطتي
سينتهي المطافُ بموتكِ على أي حال

209
00:15:17,810 --> 00:15:22,000
بخصوص الأخوَين تاتسومي، التنّين والأفعى
فليسَ لديّ ما أقوله

210
00:15:22,310 --> 00:15:25,790
إنّهما توأمان يشكّلان فريقاً مُرعِباً

211
00:15:25,790 --> 00:15:30,820
لكن بما أنّه مات أحدهما منذ البِداية
فإنّ خطرهما قد تقلّص لأكثر من النصف

212
00:15:30,820 --> 00:15:32,840
نعم، هكذا إذاً

213
00:15:32,840 --> 00:15:36,580
والقرد كما رأيتِ سلميّة ومُحِبّة للخير

214
00:15:36,790 --> 00:15:40,430
إنّها وصمةُ عار لاسمِ المُحارب
!امرأة بغيضة حرفيّاً

215
00:15:40,430 --> 00:15:44,870
،تقتاتُ عيشَ يومها من ساحاتِ المعارك
مُحاولة عقد قرارات سلام بالممالقة

216
00:15:44,870 --> 00:15:49,830
نجمَ عن وساطتِها اتّفاقيات وقف إطلاق
نار في حروب كثيرة

217
00:15:49,830 --> 00:15:55,020
قد تكون مُحارِبة مثلنا، لكنّها
تشكّل خطراً على عملِنا أيضاً

218
00:15:55,020 --> 00:15:59,760
أنا واثقٌ أنّ سبب وجودها في جوني تايسِن
هو لإنهاءِ هذه الحرب أيضاً

219
00:16:00,010 --> 00:16:02,400
هـ-هل هذا مُمكن أصلاً؟

220
00:16:02,670 --> 00:16:07,480
لا أعتقد ذلك، لكن أعرف تِلك المرأة
قد تفعلها فحسب

221
00:16:07,790 --> 00:16:09,040
دوتسكو-سان؟

222
00:16:09,670 --> 00:16:12,280
لا حاجة للحديثِ عن الخنزير البرّي
في هذه المرحلة على ما أعتقد

223
00:16:12,490 --> 00:16:17,030
كانَتْ تمتلك قُدرةً قويّةً جدّاً
...تُدعى "بلا تلقيم،" لكن

224
00:16:17,030 --> 00:16:22,910
حسناً، قد نكون محظوظين لأنّها ماتَتْ
في وقتٍ مُبكِّر جدّاً

225
00:16:23,580 --> 00:16:26,620
حسناً يا نيواتوري، من لديكِ معلومات عنه؟

226
00:16:27,480 --> 00:16:30,130
معلوماتي مُتواضِعة عن الجميع

227
00:16:30,130 --> 00:16:33,480
مجرّد إشاعات مُبهَمة وما شابه

228
00:16:33,480 --> 00:16:35,920
أنا آسفة. عشتُ حياتي معزولة

229
00:16:36,400 --> 00:16:37,720
هكذا إذاً

230
00:16:37,720 --> 00:16:41,760
حسناً، لم أكن أتأمّل منها الكثير على أي حال

231
00:16:41,760 --> 00:16:43,990
...لكن يا دوتسكو-سان

232
00:16:43,990 --> 00:16:46,070
ألا ينتابك فضولٌ حيال ذلك الفتى؟

233
00:16:46,720 --> 00:16:47,600
من؟

234
00:16:47,880 --> 00:16:51,690
الشّخص الذي بقي دائخاً. النّعسان

235
00:16:52,260 --> 00:16:54,730
لم يبدُ مُحارِباً لي على ما أعتقد

236
00:16:55,160 --> 00:16:58,400
...أنتِ تحديداً لا يحقّ لكِ الكلام

237
00:17:00,260 --> 00:17:03,490
،لا أنكر أنّه بدا مميّزاً عن الآخرين

238
00:17:03,490 --> 00:17:06,540
لكن ليس بنفس تميّز الأرنب المجنون

239
00:17:07,590 --> 00:17:09,630
أتعتقدين بأنّه جدير بأن نتوخّى حذرنا منه؟

240
00:17:09,630 --> 00:17:13,830
لا... لا أقول أنّه يبدو قويّاً تماماً

241
00:17:14,490 --> 00:17:19,310
كلّ ما في الأمر... أشعر أنّني سبقَ
ورأيتُه في مكانٍ ما

242
00:17:20,520 --> 00:17:22,660
ماذا عنك يا دوتسكو-سان؟

243
00:17:25,640 --> 00:17:27,020
ماذا؟ دوتسكو-سان؟

244
00:17:27,210 --> 00:17:30,560
معها حقّ، انتابَني إحساسٌ غامضٌ
بمشهدٍ مُكرَّر

245
00:17:30,560 --> 00:17:32,900
لكن لا أعلم أين رأيتُه

246
00:17:32,900 --> 00:17:36,690
هل قاتلتُ معه أم ضدّه في ساحةِ
معركةٍ في مكانٍ ما؟

247
00:17:37,710 --> 00:17:38,480
ما الأمر؟

248
00:17:38,480 --> 00:17:39,860
!نبأ سيّئ يا دوتسكو-سان

249
00:17:39,860 --> 00:17:42,980
!انفصل فريقُ الأرنب إلى مجموعتين

250
00:17:54,130 --> 00:17:55,890
جثّة سائرة؟

251
00:17:56,300 --> 00:17:59,400
إن كان يوجدُ هنا من يستطيع
،صنع هذه الأشياء

252
00:17:59,400 --> 00:18:01,260
...فأوّل شيء يجب أن أفعله هو

253
00:18:16,260 --> 00:18:21,240
"الأخطر بينهم هو الثّور، ذائع الصّيت "النابِغة الجزّار

254
00:18:27,630 --> 00:18:28,570
!تبّاً

255
00:18:29,060 --> 00:18:31,990
فُضَّ التّحالف حينها

256
00:18:31,990 --> 00:18:36,520
لكن ربّما بمقدورنا التّكاتُف معاً
...كمُعتدلين زُملاء

257
00:18:41,260 --> 00:18:42,760
أنا آسفة جدّاً يا دوتسكو-سان

258
00:18:43,300 --> 00:18:45,370
لم أعُد أرى الأرنب والأفعى

259
00:18:45,800 --> 00:18:49,140
ربّما أدركا أنّني كنتُ أراقبهما

260
00:18:49,710 --> 00:18:53,940
حسناً، نظراً لسذاجتها، فحدوث ذلك
محتوم في النّهاية

261
00:18:54,350 --> 00:18:55,520
...لكن

262
00:18:56,310 --> 00:18:58,650
هل سيكون هذا فخّاً إذاً؟

263
00:18:58,910 --> 00:19:01,660
،يُرسِلان الخنزير البرّي التي تتحرّك بصعوبة

264
00:19:01,660 --> 00:19:04,280
ومن ثمّ ينصب الأرنب والأفعى كميناً لك

265
00:19:04,880 --> 00:19:11,280
أعتقد أنّ الأرنب ليس مجنوناً بقدرِ
ما يوحي مظهره

266
00:19:11,760 --> 00:19:17,800
لا، إنّه يستخدم أحد حلفائه كطعم
...إنّه مجنونٌ للغاية

267
00:19:20,070 --> 00:19:24,430
لكن في تلك الحالة، عليّ أن أهزمه
في لعبتِه الخاصّة

268
00:19:24,430 --> 00:19:26,420
التفوّق على المجنونِ بالجنون

269
00:19:26,420 --> 00:19:28,500
...أن أكون كلباً مسعوراً

270
00:19:28,500 --> 00:19:29,310
نيواتوري

271
00:19:29,310 --> 00:19:31,430
نـ-نعم؟ ما الأمر؟

272
00:19:31,430 --> 00:19:32,430
مدّي يدكِ

273
00:19:33,540 --> 00:19:34,760
هكذا؟

274
00:19:37,510 --> 00:19:38,650
!لا تتحرّكي

275
00:19:43,690 --> 00:19:44,630
كيف تشعرين؟

276
00:19:45,030 --> 00:19:47,700
ما-ماذا... ماذا تعني؟

277
00:19:48,050 --> 00:19:50,550
ماذا فعلتَ بي؟

278
00:19:50,550 --> 00:19:51,960
خدّرتُكِ

279
00:19:51,960 --> 00:19:56,150
ارتعدي خوفاً. هذا هو العقار الأعجوبة
جيش الشّخص الواحد

280
00:19:56,150 --> 00:19:59,330
إنّه يستخرجُ قدراتكِ القتاليّة إلى أقصى حدّ

281
00:19:59,640 --> 00:20:02,650
يستطيع المُسمِّم فعل أكثر من مجرّد القتل

282
00:20:02,650 --> 00:20:04,840
هُنالك ما يُدعى بالسمِّ غير الفتّاك

283
00:20:05,710 --> 00:20:08,300
،سأعزّزُ قوّتَها مؤقّتاً بهذا السمّ

284
00:20:08,300 --> 00:20:11,230
ومن ثمّ أزجُّ بها في وجهِ تلك الخنزير الطعم

285
00:20:11,230 --> 00:20:14,730
كلّ ما عليها فعله هو تقديم
أداء جيّد في القتال

286
00:20:14,730 --> 00:20:17,980
...ممّا سيستدرج الأرنب والأفعى من مخبئهما

287
00:20:14,920 --> 00:20:17,370
ما الذي يجري؟

288
00:20:18,270 --> 00:20:22,280
ومن ثمّ سأقترب منهما من الخلف وأجهِز على الأرنب

289
00:20:22,280 --> 00:20:27,360
وبالطبع، حتّى بجرعة القوّة، سيتمكّن
الأرنب أو الأفعى من قتلِها

290
00:20:27,360 --> 00:20:28,950
لكن ذلك كلّه سيصبُّ في صالحي حينها

291
00:20:28,950 --> 00:20:31,630
حالما ينتهي ذلك، سأشقُّ طريقي
إلى تحت الأرضِ مجدّداً

292
00:20:31,630 --> 00:20:35,120
كلب مسعور وكلب صيد... هذا هو
المُحارِب الكلب، دوتسكو

293
00:20:36,150 --> 00:20:41,640
اهدئي! أعطيتُكِ دفعة بسيطة
لكنّها تبقى قوّتكِ أنتِ

294
00:20:41,640 --> 00:20:44,490
هدّئي من روعكِ وتحكّمي بها

295
00:20:45,770 --> 00:20:46,760
...حسناً

296
00:20:49,110 --> 00:20:51,450
...تـ-تحكّم

297
00:20:52,320 --> 00:20:54,440
هـ... هكذا؟

298
00:20:54,770 --> 00:20:55,520
—تبّاً لكِ

299
00:21:00,800 --> 00:21:05,100
لا بدّ من وجود طريقة ما ليلتقي المُعتدلون

300
00:21:19,660 --> 00:21:23,050
،أوشي: المُحارب الثّور
يقتلُ بانتظام

301
00:21:23,730 --> 00:21:27,600
،أوما: المُحارب الحِصان
يقتلُ بصمت

302
00:23:26,370 --> 00:23:29,500
يُقال "أن تكون منقار دجاجة خير لك
"من أن تكون ذيل ثور

303
00:23:29,500 --> 00:23:31,910
،قد تتمكّن الدجاجة من النّقرِ بعمق

304
00:23:31,910 --> 00:23:34,520
لكن قد لا يكون ما تجده طعاماً

305
00:23:34,510 --> 00:23:37,100
الحلقة القادمة: تقطيع دجاجة
بساطور لحم عجل

306
00:23:37,100 --> 00:23:39,240
!جميعكم، صفِّقوا