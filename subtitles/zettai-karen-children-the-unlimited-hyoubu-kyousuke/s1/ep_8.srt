.غواصة مجهولة الهوية شوهدت قي المياه القريبة

188
00:13:24,090 --> 00:13:26,910
!حول إلى الذخيرة الشخصية، و اذهب إلى هناك

189
00:13:29,390 --> 00:13:30,900
!هذا ليس تمرينًا

190
00:13:30,900 --> 00:13:32,000
!إنها معركةٌ حقيقية

191
00:13:37,060 --> 00:13:38,880
.إنهم يطلقونَ على شيءٍ ما

192
00:13:38,880 --> 00:13:39,880
ما هذا؟

193
00:13:39,880 --> 00:13:41,420
هل لدينا الإذنَ للإطلاق؟

194
00:13:41,420 --> 00:13:43,550
".لقد قالوا للتو، "انتظر التعزيزات

195
00:13:43,790 --> 00:13:46,010
.نحن تقريبًا نَفِذ منّا الوقود

196
00:13:47,820 --> 00:13:49,640
هـ-هل هم من لحمٍ و دم؟

197
00:13:47,820 --> 00:13:49,640
يقصد هل هم بشر

198
00:13:50,350 --> 00:13:53,310
.نحن وحدة الـ"إي إس بي" من الجيش
.سنتولى الأمرَ من هنا

199
00:13:59,550 --> 00:14:02,220
".إنهم وحدة الـ"إي إس بي

200
00:14:06,920 --> 00:14:09,220
!عرف عن سفينتك و جنسيتك

201
00:14:09,220 --> 00:14:10,780
.إن لم تفعل، فسيتم ترحيلك

202
00:14:13,660 --> 00:14:14,820
...هذا كانَ وشيكًا

203
00:14:14,820 --> 00:14:16,750
.لا يبدو أنهم سيمتثلونَ للأوامر

204
00:14:16,750 --> 00:14:18,420
.لندمر المحرك و نقبض عليهم

205
00:14:18,420 --> 00:14:19,520
.لا، انتظروا

206
00:14:19,520 --> 00:14:21,070
...تلك الغواصة

207
00:14:21,070 --> 00:14:23,380
.على ما يبدو أنهم في مهمةٍ خاصة

208
00:14:23,690 --> 00:14:26,180
.إن قبضنا عليهم بالقوة من الممكن أن يستعملوا التدمير الذاتي

209
00:14:26,180 --> 00:14:28,130
.عندها لن نستخرج أي معلومة

210
00:14:28,980 --> 00:14:30,390
!إنهم يغطسون

211
00:14:34,170 --> 00:14:39,480
،نعم، من المؤكدِ أنها غواصةٌ أمريكية
ماذا يجب أن نفعل؟

212
00:14:40,160 --> 00:14:41,970
هل يجبُ أن نستعملَ القوة؟

213
00:14:42,400 --> 00:14:46,540
لا، علاقتنا معهم متوترةٌ
.خصوصًا الآن

214
00:14:46,950 --> 00:14:49,240
.يجب أن نتفادى النزاع الغير ضروري مهما كلف الأمر

215
00:14:49,730 --> 00:14:50,820
.دعهم يذهبون

216
00:14:51,610 --> 00:14:54,430
الأكثر أهميّة، هل تعرف
ماذا كانوا يسعونَ له؟

217
00:14:54,430 --> 00:14:55,540
...هذا

218
00:14:56,450 --> 00:14:57,410
!انظروا إلى هناك

219
00:15:01,680 --> 00:15:02,640
دلافين؟

220
00:15:02,990 --> 00:15:03,960
عائلة؟

221
00:15:05,240 --> 00:15:06,880
.زعانفهم الظهريّة مرقّمه

222
00:15:11,440 --> 00:15:13,800
.نحن نريد المساعدة

223
00:15:14,880 --> 00:15:19,180
.نريد اللجوء السياسي

224
00:15:19,540 --> 00:15:22,150
تخاطر؟ من تلكَ الدلافين؟

225
00:15:22,420 --> 00:15:24,130
!إنهم إسبير

226
00:15:29,470 --> 00:15:30,210
طوربيدات؟

227
00:15:29,470 --> 00:15:33,210
الطربيد: صاروخ يُستعمل لمحاربة السفن و يمكن إطلاقه من غواصة أو طائرة

228
00:15:30,760 --> 00:15:32,200
!جميعكم، التشكيلة الدفاعية

229
00:15:35,400 --> 00:15:36,540
هل الجميع بخير؟

230
00:15:37,620 --> 00:15:39,330
!شيقا-سان، الدلافين

231
00:15:45,290 --> 00:15:46,610
!تأذى واحد منهم

232
00:15:47,480 --> 00:15:48,920
!الموجة الثانية آتية

233
00:15:48,920 --> 00:15:49,970
.سأوقفها

234
00:15:54,940 --> 00:15:56,240
!لقد عبر واحد

235
00:15:56,240 --> 00:15:57,350
!سأذهب

236
00:15:57,990 --> 00:15:59,290
!لا تفعل يا كيوسكي

237
00:15:59,290 --> 00:16:00,930
...من المحتمل أن لديها مهلة لكي تنفجر

238
00:16:00,930 --> 00:16:01,850
!لا يوجد هنالك وقتٌ كافي

239
00:16:02,100 --> 00:16:03,600
!لا تفعل يا كيوسكي

240
00:16:03,600 --> 00:16:04,630
!أوقفه يا أكيتا

241
00:16:04,630 --> 00:16:05,190
.مفهوم

242
00:16:09,150 --> 00:16:10,480
!تمسّك أيها الولد

243
00:16:22,390 --> 00:16:24,330
!يجب عليك تقع... أفلت يدك

244
00:16:24,840 --> 00:16:26,840
.أولًا، المروحة

245
00:16:38,290 --> 00:16:40,200
.سأستخدم التحرك النفسي كدرع

246
00:16:40,200 --> 00:16:41,730
!يجب أن أقمع موجة الاهتزاز

247
00:17:03,560 --> 00:17:05,310
.غواصة العدو تراجعت

248
00:17:05,310 --> 00:17:08,390
.لا يردون الصوت و لا يشير بصري إلى مسعاهم

249
00:17:08,780 --> 00:17:10,050
كيف حال كيوسكي و البقيّة؟

250
00:17:19,090 --> 00:17:21,020
!أيّها القائد

251
00:17:23,180 --> 00:17:25,520
...كلهم بمأمن...أحسـ

252
00:17:30,260 --> 00:17:30,820
،أبي

253
00:17:31,600 --> 00:17:35,320
.لقد قررت أن أتبع الطريق الذي أؤمن به

254
00:17:36,100 --> 00:17:38,820
.سأتخذ هذا القرار بدونِ ندم

255
00:17:39,520 --> 00:17:43,750
،حتى لو استطعت فعلها مرةً أخرى
.أنا مُتأكدٌ أني سأختار نفس الطريق

256
00:17:45,040 --> 00:17:47,630
،ما دمت على سجيتي

257
00:17:47,630 --> 00:17:50,190
...في هذا المكان، مع الجميع

258
00:17:53,350 --> 00:17:57,470
.نحن يُمكننا أن ننال مستقبلنا بقوانا الخاصة

259
00:17:57,980 --> 00:18:02,540
.يجبُ عليّ أن أستمر بالحركة إلى الأمام مثلكَ يا كيوسكي

260
00:18:05,640 --> 00:18:08,090
.إنّه أمرٌ مؤسف ما حصل لرفيقكما

261
00:18:08,090 --> 00:18:09,360
.نحن آسفون فلم نستطع حمياته

262
00:18:09,820 --> 00:18:10,940
.شكرًا لك

263
00:18:10,940 --> 00:18:12,820
.نقدّر لكَ بأنكَ أنقذتنا

264
00:18:13,440 --> 00:18:14,160
...ولكن

265
00:18:14,650 --> 00:18:16,020
...كن حذرًا

266
00:18:16,020 --> 00:18:22,200
.مقارنةً بنا، أنتم على وشكِ الموت

267
00:18:24,140 --> 00:18:25,540
...استعد

268
00:18:58,840 --> 00:18:59,490
!أيّها القائد

269
00:18:59,960 --> 00:19:02,790
هل سمعتَ عن قصفِ هيروشيما بالأمس؟

270
00:19:03,270 --> 00:19:06,080
.نعم، على ما يبدو أنه نوعٌ جديدٌ من القنابل

271
00:19:06,930 --> 00:19:11,510
.لقد أبليتم بشكلٍ حسن، ولكن هذه الحرب انتهت

272
00:19:11,510 --> 00:19:14,090
.الاستسلام الغير مشروط هو الطريق الوحيد المُتبقيّ

273
00:19:14,090 --> 00:19:15,490
...محال

274
00:19:15,490 --> 00:19:18,450
.هذه البلاد ليس لديها قوة قتالٍ كبيرة

275
00:19:19,300 --> 00:19:22,430
.كل من في وحدة ال"إي إس بي" مصابٌ عداكَ أنت

276
00:19:22,710 --> 00:19:24,450
!أستطيع القتال لوحدي

277
00:19:24,450 --> 00:19:27,760
...على الأقل، أستطيع الذهاب و إيقاف القنبلة الثانية

278
00:19:27,760 --> 00:19:28,810
.يكفي

279
00:19:33,270 --> 00:19:35,690
إيتاشي

280
00:19:37,680 --> 00:19:40,430
.لقد تم تحديد مصيرنا

281
00:19:40,760 --> 00:19:42,640
،الهزيمة، إعادة البناء

282
00:19:43,040 --> 00:19:45,640
.ودمارنا القادم

283
00:19:46,220 --> 00:19:47,230
ما هذا؟

284
00:19:47,610 --> 00:19:49,580
.عقل الدلفين الميت

285
00:19:50,730 --> 00:19:54,510
التحليل كشفَ بأنهم

286
00:19:54,510 --> 00:19:57,360
.كانوا يخبؤون جزءًا من استبصارهم

287
00:19:57,360 --> 00:19:57,920
هاه؟

288
00:19:58,970 --> 00:20:02,000
.بعدَ الحرب، عدد الإسبير سيستمر بالزيادة

289
00:20:02,570 --> 00:20:03,590
...و

290
00:20:05,750 --> 00:20:09,860
.و أنتَ ستقودهم و تحطم العالم

291
00:20:11,510 --> 00:20:13,770
مـ-ماذا تقول؟

292
00:20:15,410 --> 00:20:17,590
...أيّها القائد

293
00:20:17,590 --> 00:20:19,290
.أنا ممتنٌ لك

294
00:20:19,920 --> 00:20:23,910
ولكن لا يمكن أن نسمح للجيش المحتل أن يعرف

295
00:20:23,910 --> 00:20:26,660
.بأننا صنعنا وحشًا مثلك

296
00:20:27,860 --> 00:20:28,990
وحش؟

297
00:20:29,860 --> 00:20:31,700
أنتَ تمزح، أليس كذلك؟

298
00:20:32,110 --> 00:20:32,760
...أيّها القائد

299
00:20:35,680 --> 00:20:37,260
أنا لا أستطيع

300
00:20:37,970 --> 00:20:40,710
أن أسلمها لأحدٍ غيرك

301
00:20:49,490 --> 00:20:50,650
.كيوسكي

302
00:20:51,130 --> 00:20:53,650
.أنا لن أحولك إلى عدوٍ للبشريّة

303
00:20:54,080 --> 00:20:55,380
.هذه القوة

304
00:20:56,410 --> 00:20:57,730
.هي لي وحدي

305
00:21:02,060 --> 00:21:04,610
عدو البشريّة؟

306
00:21:05,580 --> 00:21:06,660
وحش؟

307
00:21:11,560 --> 00:21:14,290
...في النهاية، نحن

308
00:21:24,070 --> 00:21:25,230
.تهانينا

309
00:21:25,640 --> 00:21:28,640
.لقد تلقيّتَ الآن ترقيتان خاصتان

310
00:21:37,800 --> 00:21:41,220
...انضم إلى زملائكَ بشكلٍ مشرّف

311
00:21:52,890 --> 00:21:53,720
!مستحيل

312
00:22:00,570 --> 00:22:01,660
...هل أنت

313
00:22:03,290 --> 00:22:04,760
وحش؟

314
00:22:17,000 --> 00:22:18,710
.أنا لن أغفرَ لهم

315
00:22:19,990 --> 00:22:22,440
...الطبيعيون الذين خانونا

316
00:22:22,820 --> 00:22:25,490
...كلَّ واحدٍ منهم دونَ استثناء

317
00:24:13,730 --> 00:24:16,060
.في الحلقةِ القادمة، كاتاستروفي

318
00:24:17,190 --> 00:24:20,220
هذا العمل من وحي الخيال
.و لا يُقصد به أي شخصٍ أو مجموعة