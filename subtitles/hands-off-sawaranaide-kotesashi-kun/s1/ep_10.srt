1
00:00:01,720 --> 00:00:03,870
أرجو ألّا تكون إصابة أروما-سان بالغةً

2
00:00:03,870 --> 00:00:06,610
سقوطها من دراجةٍ أمرٌ أخرقٌ على غير العادة

3
00:00:07,220 --> 00:00:09,920
قالت أوبا-سان إنّها رافقتها إلى المستشفى

4
00:00:09,920 --> 00:00:12,600
أظنّ أنّهما ستعودان في أيّ لحظةٍ الآن

5
00:00:12,600 --> 00:00:18,620
أجل، أمامها بطولةٌ بعد شهرٍ، لذا أرجو ألّا تكون إصابتها بالغة

6
00:00:18,620 --> 00:00:20,620
هل أنتِ بخير يا أروما-سان؟

7
00:00:21,100 --> 00:00:23,120
أفسدتُ الأمر حقًّا

8
00:00:23,560 --> 00:00:27,000
أُصبتُ بالتواءٍ في الكاحل، وسيحتاج إلى أسبوعين ليتعافى تمامًا

9
00:00:27,000 --> 00:00:30,640
أسبوعان كاملان؟ يا لها من إصابةٍ بالغة

10
00:00:30,640 --> 00:00:32,510
ولكن هذا يبعث على الارتياح

11
00:00:32,510 --> 00:00:35,630
هذا يعني أنّكِ ستتمكّنين من المشاركة في البطولة

12
00:00:35,630 --> 00:00:37,850
إنّها مصيبةٌ فيها رحمةٌ بلا شكّ

13
00:00:37,850 --> 00:00:40,260
لكن يجب عليها أن تلزم الفراش

14
00:00:40,260 --> 00:00:41,930
هذا صحيح

15
00:00:41,930 --> 00:00:46,780
هل أنتِ قادرةٌ على البقاء ساكنةً والتعافي لأسبوعين أصلًا؟

16
00:00:46,780 --> 00:00:48,900
اصمتي، يسعني تدبّر الأمر

17
00:00:49,190 --> 00:00:51,900
ها هما تتشاجران مجددًا

18
00:00:52,820 --> 00:00:55,330
رغم ذلك، من المطمئن أنّها لم تفقد طاقاتها على الأقلّ

19
00:00:55,330 --> 00:01:00,220
كنتِ قلقةً عليها بشدّة حين تحدّثنا عبر الهاتف يا أوبا-سان

20
00:01:00,220 --> 00:01:01,450
مهلًا يا كويو

21
00:01:01,450 --> 00:01:04,040
تُبدين بعض الظرافة أحيانًا

22
00:01:04,440 --> 00:01:05,540
اصمتي

23
00:01:05,540 --> 00:01:09,390
،أعلم أنّنا انتهينا للتوّ من مخيّم التدريب يا كويو-كن

24
00:01:09,390 --> 00:01:12,550
ولكن هل يمكنكَ مراقبة أروما ابتداءً من الغد؟

25
00:01:12,920 --> 00:01:14,010
أراقبها؟

26
00:01:14,010 --> 00:01:17,540
تدرك أنّها ستُغرى بالتدريب ما لم يراقبها أحد

27
00:01:18,300 --> 00:01:19,740
فهمت

28
00:01:20,860 --> 00:01:24,180
حسنٌ، سأحرص على أن ترتاح وتتعافى تمامًا

29
00:01:31,530 --> 00:01:34,030
Rise-KuN :مراجعة

30
00:01:33,620 --> 00:01:36,660
Rise-KuN :محاكاة

31
00:01:48,920 --> 00:01:51,420
Rise-KuN :كارا

32
00:02:27,090 --> 00:02:30,000
حسنٌ، أتممتُ مهامّ اليوم

33
00:02:30,750 --> 00:02:34,750
والآن إلى مهمّتي الحقيقيّة لهذا اليوم؛ الحرص على بقاء أروما-سان في الفراش

34
00:02:35,150 --> 00:02:39,440
يجدر بي مراقبتها عن كثبٍ لئلّا تتسلّل للتدرّب

35
00:02:40,010 --> 00:02:44,510
مع ذلك، هل ستُصغي إلى أيّ كلمةٍ أقولها يا ترى؟

36
00:02:45,410 --> 00:02:46,600
تفضّل بالدخول

37
00:02:47,550 --> 00:02:49,520
كيف حالكِ يا أروما-سان؟

38
00:02:49,520 --> 00:02:52,150
اطلبي ما تشائين إن احتجتِ إلى أيّ شيءٍ

39
00:02:52,440 --> 00:02:53,840
شكرًا لكَ

40
00:02:53,840 --> 00:02:58,210
لكن لا داعي لمراقبتي كالصقر، فلن أبرح مكاني

41
00:02:58,210 --> 00:02:59,910
حقًّا؟

42
00:03:00,550 --> 00:03:02,300
ثقْ بي

43
00:03:02,300 --> 00:03:06,290
حتّى أنّني خفّفتُ من تدريباتي كما أخبرتني

44
00:03:06,710 --> 00:03:08,880
يمكنكَ تدليكي إن شئتَ

45
00:03:08,880 --> 00:03:11,900
سيكون ذلك خير برهانٍ على صدق كلماتي

46
00:03:12,540 --> 00:03:15,090
يُفترض بي أن أتعافى، أليس كذلك؟

47
00:03:15,090 --> 00:03:17,800
لذا قد ينفعني بعض العلاج الطبيعيّ

48
00:03:18,420 --> 00:03:20,730
أيُعقل أن يصدر هذا الكلام عن أروما-سان؟

49
00:03:20,730 --> 00:03:23,430
لا بُدَّ أنّها غيّرتْ طريقة تفكيرها حقًّا

50
00:03:23,430 --> 00:03:26,810
أظنّ أنّها لن تتسلّل للخارج ما دام هذا موقفها

51
00:03:27,470 --> 00:03:29,030
عُلم

52
00:03:29,030 --> 00:03:30,240
مرحى

53
00:03:32,700 --> 00:03:37,320
قبل أن أبدأ التدليك، هل يزعجكِ أيّ موضعٍ محدّدٍ؟

54
00:03:38,730 --> 00:03:40,630
لا أظنّ ذلك

55
00:03:40,630 --> 00:03:42,820
كنتُ أشعر بحيويّةٍ في كافّة أنحاء جسدي

56
00:03:43,440 --> 00:03:47,330
لذا دلّكْ جسدي بأكمله فحسب، واجعله مريحًا

57
00:03:47,590 --> 00:03:53,000
إن كانت تشعر بحيويّةٍ، فهذا يؤكّد أنّها خفّفتْ من تدريبها بالفعل

58
00:03:53,000 --> 00:03:54,960
حسنٌ، سأتبيّن من ذلك بمجرّد أن ألمسها

59
00:03:55,530 --> 00:03:57,960
كما تشائين، سأبدأ العلاج الآن

60
00:03:58,680 --> 00:04:00,680
سأبدأ بتدليك الكتفين

61
00:04:02,290 --> 00:04:03,840
كتفاها ليسا متيبّسين؟

62
00:04:04,380 --> 00:04:05,700
وماذا عن المواضع الأخرى؟

63
00:04:06,530 --> 00:04:09,720
لا يوجد أيّ تشنّجٍ في خصرها أو أردافها أيضًا

64
00:04:10,320 --> 00:04:13,980
أروما-سان مُحقّةٌ، كانت تعتني بجسدها

65
00:04:14,390 --> 00:04:17,480
هذا مذهلٌ يا أروما-سان، أنتِ في أفضل حالاتكِ حقًّا

66
00:04:17,790 --> 00:04:21,610
ألم أُخبركَ؟ كنتُ أتّبع نصائحكَ

67
00:04:21,920 --> 00:04:23,930
آسفٌ لأنّني شككتُ بكِ

68
00:04:23,930 --> 00:04:27,870
في هذه الحالة، سيكون التدليك المريح أجدى من التدليك العلاجيّ

69
00:04:28,190 --> 00:04:32,250
بما أنَّ تلك الإصابة كانت مزعجةً حتمًا، فسأساعدكِ على الاسترخاء

70
00:04:32,250 --> 00:04:34,380
أجل، لنفعل ذلك

71
00:04:34,380 --> 00:04:37,550
حسنٌ، سأحتاج إلى سلاحي السرّي، لذا انتظري هنا

72
00:04:43,870 --> 00:04:46,330
سلاحكَ السرّي هو البخور؟

73
00:04:46,330 --> 00:04:49,010
أجل، سيساعدكِ على الاسترخاء حتمًا

74
00:04:49,500 --> 00:04:51,420
له رائحةٌ زكيّةٌ فعلًا

75
00:04:51,970 --> 00:04:55,390
تبدو كرائحةِ شجرةٍ، لكن أيّ نوعٍ هي؟

76
00:04:55,710 --> 00:04:57,390
إنّها رائحة شجر السرو

77
00:04:57,390 --> 00:05:00,770
ستجعلكِ تشعرين وكأنّكِ وسط غابةٍ هادئةٍ

78
00:05:02,030 --> 00:05:03,980
أظنّ أنّها تُهدّئ أعصابي بالفعل

79
00:05:04,530 --> 00:05:07,200
حسنٌ، سأواصل التدليك

80
00:05:07,200 --> 00:05:07,910
حسنٌ

81
00:05:08,340 --> 00:05:12,350
،اكتفى كويو بتمطيط ساقي في المرّة السابقة

82
00:05:12,350 --> 00:05:14,790
لذا سيكون هذا أوّل تدليكٍ حقيقيٍّ أحصل عليه

83
00:05:14,790 --> 00:05:17,170
سيكون شعوره مذهلًا بالمقدار ذاته حتمًا

84
00:05:18,950 --> 00:05:23,120
لطالما تساءلتُ عمّا يميّز يديه

85
00:05:23,120 --> 00:05:27,740
خضعتُ للعلاج الطبيعيّ من قبل، لكنّه لم يجعلني أرتجف بهذا القدر أبدًا

86
00:05:28,430 --> 00:05:34,850
يبدو الأمر وكأنَّ كويو يدسّ أصابعه داخل جسدي

87
00:05:35,430 --> 00:05:40,640
تأثير هذا البخور جنونيّ، أشعر بدوارٍ خفيف

88
00:05:40,640 --> 00:05:45,190
يجعلني هذا أشعر بغرابةٍ أكثر من تلك التمارين

89
00:05:45,490 --> 00:05:48,900
أوشكُ على التأوّه

90
00:05:48,900 --> 00:05:50,200
عليَّ كبح نفسي

91
00:05:52,890 --> 00:05:56,080
سأُجنُّ من شدّة النشوة

92
00:05:56,650 --> 00:05:57,480
طائر؟

93
00:05:58,000 --> 00:06:00,290
بدأتُ أرى هلوساتٍ حتّى

94
00:06:00,290 --> 00:06:04,000
كأنَّ جسدي يتطهّر في غابةٍ وادعةٍ

95
00:06:04,760 --> 00:06:08,470
أوشكتُ على الانتهاء، استلقي على ظهركِ رجاءً

96
00:06:08,470 --> 00:06:09,970
حـ-حسنٌ

97
00:06:10,720 --> 00:06:15,690
هل أصبح تدليك كويو أشدَّ قسوةً؟

98
00:06:19,090 --> 00:06:22,570
هذا سيئ، لا يسعني تمالك نفسي

99
00:06:28,420 --> 00:06:30,610
خـ-خرير غدير؟

100
00:06:31,350 --> 00:06:33,980
...مياهٌ تتدفّق برفقٍ

101
00:06:33,980 --> 00:06:35,620
كلّا، ليس كذلك

102
00:06:36,170 --> 00:06:39,040
هذا ليس جدولًا

103
00:06:41,420 --> 00:06:42,000
...إنّه

104
00:06:44,270 --> 00:06:46,520
سيلٌ جارفٌ من النشوة

105
00:06:57,070 --> 00:06:58,860
هذا كلّ شيءٍ بالنسبة للتدليك

106
00:06:59,680 --> 00:07:03,400
حسنٌ إذن، سأتخلّص من الرماد وأعود

107
00:07:05,440 --> 00:07:06,780
رجاءً

108
00:07:08,410 --> 00:07:12,410
كانت عضلات أروما-سان مرنةً بشكلٍ لا يُصدّق

109
00:07:12,760 --> 00:07:16,310
لا بُدَّ أنَّ أداءها في كرة السلة قد تحسّن حتمًا

110
00:07:16,310 --> 00:07:18,170
،وبما أنّها تعتني بنفسها الآن

111
00:07:18,170 --> 00:07:21,820
أرجو أن تكون قد بلغتْ مستوى جديدًا كرياضيّة

112
00:07:23,000 --> 00:07:26,280
...أروما-سان، آسفٌ على التأخيـ

113
00:07:27,540 --> 00:07:29,300
أروما-سان ليست هنا

114
00:07:29,680 --> 00:07:33,050
خدعتني، ظننتُ أنّه انصلح حالها

115
00:07:35,680 --> 00:07:37,350
أين ذهبت يا ترى؟

116
00:07:38,480 --> 00:07:39,560
هذا خطئي

117
00:07:40,140 --> 00:07:43,100
وعدتُ ميوكي-سان بمراقبتها عن كثبٍ

118
00:07:43,850 --> 00:07:47,440
ستزيد الأمور سوءًا إن حاولتِ التدرّب بذلك الكاحل

119
00:07:47,770 --> 00:07:51,950
قد تتأخّر في التعافي لأكثر من شهرٍ وتُفوّت بطولتها

120
00:07:52,320 --> 00:07:54,000
عليَّ العثور عليها سريعًا

121
00:07:54,000 --> 00:07:57,770
إن كانت تتدرّب في الخارج، فاحتمالٌ كبيرٌ أن تكون في المدرسة

122
00:07:58,570 --> 00:08:01,330
استراحةٌ لعشر دقائق، احرصنَ على شرب الماء

123
00:08:01,650 --> 00:08:02,640
حاضر

124
00:08:05,020 --> 00:08:08,790
فريق كرة السلة للفتيات، لعلَّ أروما-سان هنا

125
00:08:08,790 --> 00:08:10,300
معذرةً

126
00:08:11,410 --> 00:08:13,840
هل أروما-سان حاضرةٌ في التدريب؟

127
00:08:14,240 --> 00:08:15,960
كلّا، ليست هنا

128
00:08:16,630 --> 00:08:18,600
يُفترض بها أن ترتاح

129
00:08:18,870 --> 00:08:20,290
ليست في المدرسة؟

130
00:08:20,540 --> 00:08:21,730
إذن، أين قد تكون؟

131
00:08:21,730 --> 00:08:24,330
بالمناسبة، من أنت؟

132
00:08:24,330 --> 00:08:25,850
حبيب أروما؟

133
00:08:26,240 --> 00:08:27,620
كلّا، لستُ كذلك

134
00:08:27,620 --> 00:08:30,360
أعمل كمشرفٍ في سكنها الطلابيّ

135
00:08:30,770 --> 00:08:32,490
هكذا إذن، يا للخسارة

136
00:08:32,880 --> 00:08:34,610
لستَ حبيبها إذن

137
00:08:35,420 --> 00:08:38,000
يُفترض أن تكون في السكن بما أنّك المشرف

138
00:08:38,000 --> 00:08:41,950
في الواقع، تسلّلتْ للخارج رغم حاجتها إلى ملازمة الفراش

139
00:08:41,950 --> 00:08:44,670
خمّنتُ أنّها قد تأتي إلى هنا للتدرّب

140
00:08:45,250 --> 00:08:47,090
هربتْ أروما؟

141
00:08:47,090 --> 00:08:48,700
أ-أجل

142
00:08:50,480 --> 00:08:53,070
،لم تكن تتدرب كالمجنونة مؤخّرًا

143
00:08:53,070 --> 00:08:57,890
وكانت تهتمّ بحالتها البدنيّة، لذا ظننتُ أنّها سترتاح

144
00:08:58,480 --> 00:09:02,620
أهذا يعني أنَّ كلّ ما قالته أروما-سان كان صدقًا؟

145
00:09:02,620 --> 00:09:06,770
لكن إن لم تكن تكذب عليَّ، فما الّذي دفعها للاختفاء؟

146
00:09:07,490 --> 00:09:09,080
هذا سيّئ

147
00:09:09,080 --> 00:09:14,030
اخترناها البارحة لتكون طالبة السنة الأولى الوحيدة كأساسيّةٍ في البطولة

148
00:09:14,610 --> 00:09:18,070
لعلَّ هذا شكّل ضغطًا كبيرًا عليها

149
00:09:18,170 --> 00:09:19,770
أساسيّةٌ من السنة الأولى؟

150
00:09:20,150 --> 00:09:20,910
هذا مذهلٌ

151
00:09:21,480 --> 00:09:24,020
إنّها كفؤةٌ لتكون لاعبةً أساسيّةً بلا ريب

152
00:09:24,020 --> 00:09:26,160
وكانت تتحسّن بسرعةٍ فائقةٍ

153
00:09:26,680 --> 00:09:29,040
،صحيح أنَّ قوّتها البدنيّة غير مكتملةٍ

154
00:09:29,720 --> 00:09:33,000
لكنّها تمتلك أفضل المهارات والغرائز بيننا جميعًا

155
00:09:36,630 --> 00:09:42,140
سمعتُ طالباتٍ أخرياتٍ من السنة الأولى يقلنَ إنّهنّ تدرّبنَ مع أروما في الملاعب أسفل الجسر

156
00:09:42,480 --> 00:09:45,270
حقًّا؟ سأذهب للبحث عنها هناك

157
00:09:45,270 --> 00:09:47,200
شكرًا على المعلومات

158
00:09:48,500 --> 00:09:50,650
هذا الفتى هو مُشرف سكنها إذن

159
00:09:51,350 --> 00:09:55,440
تبلين حسنًا مؤخّرًا يا أروما، حتّى أنّكِ تخصّصين وقتًا للقيام بتمارين الإطالة

160
00:09:56,640 --> 00:10:01,530
أخبرني مٌشرف سكني أنّني سأؤدّي بشكلٍ أفضل إن اعتنيتُ بجسدي

161
00:10:02,010 --> 00:10:03,340
مُشرف سكنكِ؟

162
00:10:04,560 --> 00:10:06,800
ما زلتُ قلقةً على أروما

163
00:10:07,390 --> 00:10:11,170
لكن إن كان ذلك الشابّ مُشرف سكنها، فستسير الأمور على ما يرام

164
00:10:11,800 --> 00:10:16,170
لم يكن لديَّ أدنى فكرةٍ عن اختيارها كلاعبةٍ أساسيّةٍ

165
00:10:16,540 --> 00:10:20,860
التعرّض لإصابةٍ مباشرةً بعد تحقيق هذا الإنجاز سيُثقل كاهلها حتمًا

166
00:10:21,680 --> 00:10:24,500
،بدلًا من فحصها فحسب والقول إنّها بخير

167
00:10:24,500 --> 00:10:26,930
كان يجدر بي خوض محادثةٍ لائقةٍ معها

168
00:10:28,690 --> 00:10:30,760
،أطمحُ لأن أكون طبيبًا رياضيًّا

169
00:10:30,890 --> 00:10:33,010
لكنَّ هذه الوظيفة لا تقتصر على فحص الأشخاص فحسب

