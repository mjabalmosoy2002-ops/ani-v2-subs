1
00:00:02,470 --> 00:00:05,980
حطمتْ إيزومي رقمها القياسيّ في تدريب السباحة أمس

2
00:00:05,980 --> 00:00:08,290
واثقٌ من أنّها ستبلي حسنًا اليوم

3
00:00:08,290 --> 00:00:09,480
المدرب ساكاموتو

4
00:00:10,620 --> 00:00:11,520
نائبة المدير

5
00:00:11,520 --> 00:00:13,420
كيف حال إيزومي-سان؟

6
00:00:13,420 --> 00:00:15,560
بأفضل حالٍ بالطبع

7
00:00:15,560 --> 00:00:18,260
لا شكَّ في أنّها ستفوز بسباقها

8
00:00:18,260 --> 00:00:21,870
هذا مطمئن، فهي جوهرة هذه المدرسة كما تعلم

9
00:00:22,430 --> 00:00:24,870
إذن، أين هي الآن؟

10
00:00:26,100 --> 00:00:29,750
أتى مشرف سكنها وذهبتْ برفقته

11
00:00:30,360 --> 00:00:33,980
قالوا إنَّ المدير كلّفه بالاعتناء بحالتها النفسيّة

12
00:00:35,600 --> 00:00:38,790
كنتُ أتوق لرؤيتكَ يا كوتيساشي كويو

13
00:00:38,790 --> 00:00:41,060
لن تفلتَ منّي

14
00:00:46,570 --> 00:00:49,070
Rise-KuN :مراجعة

15
00:00:48,660 --> 00:00:51,700
Rise-KuN :محاكاة

16
00:01:03,960 --> 00:01:06,460
Rise-KuN :كارا

17
00:01:42,850 --> 00:01:45,730
،حين بدأتُ ممارسة السباحة التنافسيّة لأول مرّة

18
00:01:45,730 --> 00:01:48,290
عشقتُ ارتياد التدريبات والمنافسات

19
00:01:48,640 --> 00:01:51,720
،كان تواجدي في الماء ممتعًا للغاية

20
00:01:51,720 --> 00:01:55,300
واعتدتُ السباحة في المسبح كلّ يومٍ حتّى مغيب الشمس

21
00:01:55,980 --> 00:01:57,810
،تحسّنتْ أرقامي باستمرار

22
00:01:57,810 --> 00:01:59,780
،وحين بلغتُ الصفّ الرابع

23
00:01:59,780 --> 00:02:02,060
فزتُ بأول بطولةٍ لي

24
00:02:02,560 --> 00:02:06,260
،غمرتني السعادة بمديح أمّي ومدربي

25
00:02:06,260 --> 00:02:09,090
فازداد شغفي بالسباحة أكثر

26
00:02:09,090 --> 00:02:11,200
ولكن في مرحلةٍ ما

27
00:02:12,460 --> 00:02:15,820
بدأتْ توقّعاتهم تثقل كاهلي

28
00:02:18,010 --> 00:02:20,960
واثقةٌ من أنّكِ ستفوزين في البطولة القادمة

29
00:02:20,960 --> 00:02:23,330
قد تغدين بطلة العالم حتّى

30
00:02:24,510 --> 00:02:29,920
وتوقّفتُ عن الفوز في السباقات تمامًا في النهاية

31
00:02:31,140 --> 00:02:34,910
كبّلتني كلماتهم كأنّها لعنة

32
00:02:34,910 --> 00:02:37,520
فقدتُ قدرتي على التحرّك بحريّةٍ في الماء

33
00:02:38,490 --> 00:02:41,520
،بما أنّي أعجز عن تلبية توقّعاتهم

34
00:02:41,520 --> 00:02:44,330
فلا أستحقّ الاستمرار في السباحة

35
00:02:45,210 --> 00:02:47,260
لهذا قرّرتُ الاعتزال

36
00:02:50,080 --> 00:02:54,060
لكن في قرارة نفسي، لا أريد الاعتزال

37
00:02:54,500 --> 00:02:57,360
فما زلتُ أحبّ السباحة رغم كلّ شيءٍ

38
00:02:57,950 --> 00:03:02,090
ولا أريد لشابٍ التقيته للتوّ أن يلمس صدري

39
00:03:02,090 --> 00:03:05,370
...لكن إن كان هذا سيعيد لي قدرتي على السباحة كما في السابق

40
00:03:06,480 --> 00:03:09,120
دلّك نقطة الشانزونغ رجاءً

41
00:03:09,420 --> 00:03:10,240
حاضر

42
00:03:11,870 --> 00:03:16,140
لا بُدَّ أنَّ هذا مزعجٌ لها، لكنّها لا تزال مستعدّةً للمحاولة

43
00:03:16,910 --> 00:03:21,880
عليَّ بذل قصارى جهدي لتحريرها من قلقها

44
00:03:22,220 --> 00:03:23,640
سأبدأ بتدليك نقطة الشانزونغ

45
00:03:26,800 --> 00:03:30,640
تقع نقطة الشانزونغ في منتصف الخطّ الوهميّ الّذي يصل بين الحلمتين

46
00:03:31,470 --> 00:03:34,650
،إن حفّزتُ نقطة الضغط هذه نحو عنقكِ

47
00:03:34,650 --> 00:03:37,620
فسيؤدّي ذلك إلى تخفيف مستويات التوتّر لديكِ

48
00:03:39,050 --> 00:03:40,650
فهمت

49
00:03:41,330 --> 00:03:43,830
،سمحتْ لي بلمس نقطة الشانزونغ

50
00:03:43,830 --> 00:03:46,310
لكنّها لن ترغب في أن ألمس ثدييها حتمًا

51
00:03:46,310 --> 00:03:48,160
سأحرص على ألّا ألمسهما

52
00:03:49,860 --> 00:03:51,640
حسنٌ، تسير الأمور على ما يرام

53
00:03:51,640 --> 00:03:55,540
كان هذا العلاج التقنيّة الخاصّة لأمّي؛ المعالجة بالتدليك

54
00:03:58,240 --> 00:04:02,550
ساعدتْ العديد من الرياضيين على تخطّي كبواتهم بهذه الحيلة وحدها

55
00:04:03,310 --> 00:04:08,560
سأستخدم هذه التقنيّة الّتي علّمتني إيّاها أمّي لتصفية ذهن إيزومي-سان

56
00:04:09,760 --> 00:04:13,440
هل هذا تدليككَ الحقيقيّ يا كوتيساشي-كن؟

57
00:04:14,720 --> 00:04:18,790
أتتراجع لأنّكَ قلقٌ عليَّ أكثر من اللازم؟

58
00:04:19,730 --> 00:04:24,950
أنا مستعدّةٌ لفعل أيّ شيءٍ للفوز بمسابقة السباحة هذه، وقد هيّأتُ نفسي للأسوأ

59
00:04:25,370 --> 00:04:30,030
لا تقلق عليَّ رجاءً، امنحني تدليككَ الحقيقيّ بكامل قوّتك

60
00:04:32,240 --> 00:04:37,460
تذكّر يا كويو، لا يسعكَ الاكتفاء بتحفيز نقطة الضغط بتدليك الشانزونغ فحسب

61
00:04:38,010 --> 00:04:40,960
دلّك هذه النقطة وكأنّكَ تدلّك الجزء العلويّ من الجسد بأكمله

62
00:04:41,280 --> 00:04:44,720
احرص على ألّا يفلت زبائنكَ من نشوة المتعة

63
00:04:46,000 --> 00:04:47,530
هذا هو السرّ

64
00:04:49,390 --> 00:04:50,580
أرجو المعذرة

65
00:04:51,870 --> 00:04:53,860
نسيتُ درسًا بالغ الأهميّة

66
00:04:54,510 --> 00:04:57,270
لن أتهاون هذه المرّة يا إيزومي-سان

67
00:04:57,270 --> 00:04:59,820
سأستخدم كامل قوّتي الآن، لذا تحمّلي

68
00:05:00,470 --> 00:05:02,190
هذا ما أبتغيه

69
00:05:05,200 --> 00:05:08,640
هـ-هذا كمٌّ هائلٌ من الزيت

70
00:05:08,640 --> 00:05:10,950
أيمسك بهما هكذا مباشرةً؟

71
00:05:11,390 --> 00:05:12,960
هذا محرجٌ للغاية

72
00:05:12,960 --> 00:05:17,510
لكنّي قرّرتُ وضع ثقتي بكوتيساشي-كن

73
00:05:25,890 --> 00:05:27,410
ما الّذي يحدث؟

74
00:05:29,830 --> 00:05:34,590
أشعر وكأنّي في المحيط بسبب الزيت

75
00:05:38,460 --> 00:05:41,980
شعورٌ رائعٌ لدرجة أنّي قد أغرق

76
00:05:43,200 --> 00:05:46,240
هذا مثيرٌ للغاية

77
00:05:47,030 --> 00:05:49,180
عليَّ المقاومة

78
00:05:50,710 --> 00:05:52,480
كلّا، ليس عليَّ ذلك

79
00:05:52,480 --> 00:05:54,330
لا داعي لمقاومة ذلك

80
00:05:54,330 --> 00:05:57,450
قرّرتُ وضع نفسي بين يدي كوتيساشي-كن

81
00:05:58,700 --> 00:06:03,600
يجدر بي التوقّف عن مقاومة المتعة وتسليم جسدي بالكامل له

82
00:06:03,600 --> 00:06:07,140
لن أصل لنتيجةٍ بالتفكير في أمورٍ تافهة

83
00:06:07,140 --> 00:06:08,900
لتذهب توقّعات الناس إلى الجحيم

84
00:06:08,900 --> 00:06:12,550
لا أحتاج سوى لفعل ما يريحني فحسب

85
00:06:18,100 --> 00:06:23,270
يبدو أنّه لم تكن هناك أيّ قيودٍ تكبّلني من الأساس

86
00:06:33,410 --> 00:06:35,410
كيف كان يا إيزومي-سان؟

87
00:06:39,750 --> 00:06:41,380
كان ذلك مذهلًا

88
00:06:41,380 --> 00:06:44,420
صفا ذهني تمامًا من أجل السباق الآن

89
00:06:44,690 --> 00:06:46,570
هذا يسرّني

90
00:06:47,200 --> 00:06:50,600
عفوًا، لديَّ طلبٌ آخر أودّ سؤالكَ إيّاه

91
00:06:51,480 --> 00:06:52,550
ما هو؟

92
00:06:52,550 --> 00:06:58,340
إن فزتُ اليوم، فهلّا دلّكتَ نقطة الشانزونغ مجدّدًا؟

93
00:06:58,340 --> 00:06:59,560
بالطبع

94
00:06:59,560 --> 00:07:02,600
حقًّا؟ أتعِدني؟

95
00:07:02,600 --> 00:07:03,190
أجل

96
00:07:06,250 --> 00:07:10,480
حسنٌ، عليَّ الاستحمام الآن، فهلّا خرجتَ رجاءً؟

97
00:07:11,080 --> 00:07:12,570
حـ-حاضر

98
00:07:14,000 --> 00:07:17,840
حسنٌ، يبدو أنَّ تدليك الشانزونغ قد آتى ثماره

99
00:07:17,840 --> 00:07:21,760
تبدو مستمتعًا بوقتكَ يا كوتيساشي كويو-كن

100
00:07:24,620 --> 00:07:26,280
من أنتِ؟

101
00:07:26,280 --> 00:07:28,210
...أعمل في ثانوية سيوا الجامعيّة

102
00:07:28,600 --> 00:07:30,000
بصفتي نائبة المدير

103
00:07:30,000 --> 00:07:31,470
نـ-نائبة المدير؟

104
00:07:32,030 --> 00:07:34,400
سمعتُ أصواتًا صاخبةً تصدر من تلك الغرفة

105
00:07:34,400 --> 00:07:36,690
هل لي أن أسأل عمّا كنتَ تفعله هناك؟

106
00:07:37,790 --> 00:07:41,850
...حسنٌ، كنتُ أقدّم تدليكًا لشخصٍ ما لمساعدته على الاسترخاء

107
00:07:43,570 --> 00:07:46,730
فهمت، تدليك إذن

108
00:07:46,730 --> 00:07:49,670
ظننتُ أنّكَ تمارس علاقة غير مشروعة

109
00:07:49,670 --> 00:07:51,800
،إن كان تدليكًا حقًّا

110
00:07:51,800 --> 00:07:54,740
فستتمكّن من تدليكي، أليس كذلك؟

111
00:07:55,380 --> 00:07:58,740
بالطبع، فهو مجرّد تدليكٍ في النهاية

112
00:07:59,430 --> 00:08:02,250
هكذا إذن، ما زلتَ تتظاهر بالبراءة

113
00:08:02,560 --> 00:08:04,310
حسنٌ لا علينا

114
00:08:04,310 --> 00:08:07,180
مهلًا، ما الّذي يحدث؟

115
00:08:08,240 --> 00:08:10,470
سباق إيزومي على وشك البدء

116
00:08:10,470 --> 00:08:14,510
أدرك ذلك، ولن أفوّت هذا السباق المهمّ مهما حدث

117
00:08:15,000 --> 00:08:17,810
سنؤجّل ذلك "التدليك" لوقتٍ لاحقٍ

118
00:08:19,840 --> 00:08:22,270
لكنّي سأوضّح لكَ أمرًا واحدًا

119
00:08:22,670 --> 00:08:26,810
أظنّ أنَّ مديرنا قد منحكَ بعض الصلاحيّات المشكوك فيها

120
00:08:26,810 --> 00:08:28,340
لكنّي أعارض ذلك تمامًا

121
00:08:29,200 --> 00:08:32,030
...إن تجرّأتَ على لمس أيٍّ من طالباتي العزيزات

122
00:08:32,770 --> 00:08:34,150
فلن أغفر لك

123
00:08:34,910 --> 00:08:37,260
فتياتنا في مرحلةٍ حاسمةٍ من مسيرتهنَّ

124
00:08:37,260 --> 00:08:39,790
والعلاقات العاطفيّة مرفوضةٌ تمامًا

125
00:08:40,670 --> 00:08:42,290
لنغادر أيّها المدرب ساكاموتو

126
00:08:42,570 --> 00:08:44,000
حـ-حاضر

127
00:08:47,040 --> 00:08:49,540
ها قد أصبحتُ محطّ أنظار نائبة المدير الآن

128
00:08:50,030 --> 00:08:52,740
،لكن، أعلم أنّه لن تكون هناك أيّ علاقاتٍ عاطفيّة

129
00:08:53,460 --> 00:08:54,580
لذا أظنّ أنّي في أمان

130
00:09:00,540 --> 00:09:02,860
مرحبًا يا إيزومي

131
00:09:02,860 --> 00:09:05,560
أبليتِ بلاءً حسنًا بفوزكِ البارحة

132
00:09:06,030 --> 00:09:10,090
أخبريني، كيف تغلّبتِ على كبوتكِ؟

133
00:09:10,090 --> 00:09:12,320
...حـ-حسنٌ

134
00:09:15,570 --> 00:09:17,570
إ-إنّه سرٌّ

135
00:09:18,890 --> 00:09:20,830
ما الضير في إخباري بذلك؟

136
00:09:20,830 --> 00:09:22,080
بخيلة

137
00:09:23,830 --> 00:09:27,750
كوتيساشي-كن يدلّك نقطة شانزونغ لفتاةٍ أخرى؟

138
00:09:30,060 --> 00:09:31,320
لا يعجبني ذلك

139
00:09:32,830 --> 00:09:35,020
لا يسعني إخباركِ كما توقعت

140
00:09:35,660 --> 00:09:36,840
هذا ليس عدلًا

141
00:09:40,000 --> 00:09:42,090
أنا منهكة

142
00:09:43,090 --> 00:09:46,900
،لكنّي حطّمتُ رقمي القياسيّ في المسابقة

143
00:09:46,920 --> 00:09:48,390
لذا أنا في قمّة سعادتي

144
00:09:49,330 --> 00:09:52,030
يجدر بي استغلال هذا الزخم للتدريب على الرسم

145
00:09:52,610 --> 00:09:58,360
ومع ذلك، لا شكّ أنّي مدينةٌ بأدائي لكوتيساشي-كن

146
00:10:00,790 --> 00:10:03,870
أبليتِ بلاءً حسنًا البارحة يا إيزومي-سان

147
00:10:05,410 --> 00:10:06,970
كوتيساشي-كن؟

148
00:10:06,970 --> 00:10:12,880
كما وعدتكِ، سأمنحكِ تدليكًا آخر بما أنّكِ فزتِ

149
00:10:14,390 --> 00:10:15,130
توقف

150
00:10:15,600 --> 00:10:18,450
سأبدأ بنقطة الشانزونغ خاصّتكِ

151
00:10:21,960 --> 00:10:23,760
مهلًا يا كوتيساشي-كن

152
00:10:23,760 --> 00:10:26,090
...هذه ليست نقطة الشانزونغ

153
00:10:33,600 --> 00:10:35,030
كوتيساشي-كن

154
00:10:36,570 --> 00:10:39,530
لا

155
00:10:41,250 --> 00:10:43,410
أكان حلمًا؟

156
00:10:43,670 --> 00:10:46,620
يبدو أنّي غفوتُ

157
00:10:48,240 --> 00:10:50,790
كانت لمسته رائعةً، حتّى في الحلم

158
00:10:51,710 --> 00:10:54,040
...حين تسنح لي الفرصة، لعلّي أستطيع طلب

159
00:10:54,800 --> 00:10:59,160
من كوتيساشي-كن أن يمنحني تدليك شانزونغ آخر كما وعدني