1
00:00:01,430 --> 00:00:02,480
.أنصِتن

2
00:00:02,480 --> 00:00:05,980
.ثمّة ستّ فرقٍ ستؤدّي في عرض اللّيلة

3
00:00:05,980 --> 00:00:08,610
.ودورنا سيكون الأوّل من بينها

4
00:00:09,900 --> 00:00:11,990
!لكن هذا يجعلنا عرض إحماءٍ فحسب

5
00:00:11,990 --> 00:00:18,660
.بالطّبع. فهذا أوّل عرضٍ لأيسي تيل
.ليس لنا شعبيّة ولا إنجازات ولا معجبون

6
00:00:22,210 --> 00:00:26,380
.بعبارةٍ أخرى، لم يأتِ أحدٌ إلى هنا لرؤيتنا تحديدًا

7
00:00:26,380 --> 00:00:31,170
لكن موافقتي على تلك الشّروط هو ما مكنكنّ
.من بداية مسيرتكنّ بهذه السّرعة

8
00:00:31,170 --> 00:00:34,010
.بدءًا من الآن مهارتكنّ هي ما سيأخذكنّ إلى القمّة

9
00:00:37,640 --> 00:00:39,560
هل غيّرتنّ رأيكنّ؟

10
00:00:39,560 --> 00:00:42,020
.لم يفت الأوان بعد على التّراجع

11
00:00:42,390 --> 00:00:43,390
نغيّر رأينا؟

12
00:00:43,810 --> 00:00:44,770
من تحسبنا؟

13
00:00:45,100 --> 00:00:49,730
!اليوم سنكسب الشّعبيّة والإنجازات والمعجبين

14
00:00:56,490 --> 00:00:59,910
!أنصِتن؟ لقد قمت بكلّ ما في وسعي لأوصلكنّ إلى هنا

15
00:00:59,910 --> 00:01:03,290
!حالما تلبسن أزياء المنصّة فلا مجال للعودة بعدها

16
00:01:04,330 --> 00:01:05,920
!كلّ شيءٍ بين أيديكنّ الآن

17
00:01:06,250 --> 00:01:07,420
!أظهرن للجمهور كلّ ما تملكن

18
00:01:07,920 --> 00:01:08,840
!اسطعن

19
00:01:09,250 --> 00:01:10,590
!أنشئن أسطورتكنّ

20
00:01:11,210 --> 00:01:13,210
حسنًا، هل الجميع مستعدّون؟

21
00:01:13,760 --> 00:01:16,380
!أيسي تيل، ها نحن ذا

22
00:01:16,380 --> 00:01:17,890
!أجل

23
00:02:51,850 --> 00:02:53,940
.هذا هو المكان، موغارا

24
00:02:54,820 --> 00:02:57,440
.إذًا فهنا ستؤدّي تلك المرأة

25
00:02:57,440 --> 00:02:59,490
لحظة، أين ساوامورا-سان؟

26
00:02:59,490 --> 00:03:01,950
.كنتُ أغيظها قبل قليل حتّى أوشكت على البكاء

27
00:03:02,280 --> 00:03:05,830
.قالت، "أنا لن أذهب" وهربت إلى مقهى خادمات

28
00:03:05,830 --> 00:03:08,120
ماذا؟ متى حدث ذلك؟

29
00:03:08,120 --> 00:03:12,330
.أرجوكما لا تفعلا كلّ ما يحلو لكما

30
00:03:12,330 --> 00:03:13,710
أين ذلك المقهى على أيّ حال؟

31
00:03:13,710 --> 00:03:17,340
.أتساءل أيّ منّا تفعل ما يحلو لها يا كاتو-سان

32
00:03:17,340 --> 00:03:19,630
ماذا؟ ما قصدكِ؟

33
00:03:19,970 --> 00:03:22,810
ألستِ تتّخذين بعض القرارات الاعتباطيّة؟

34
00:03:23,720 --> 00:03:26,220
.أخلاقيّ-كُن يُصبح مدير أعمال ابنة عمّه

35
00:03:26,760 --> 00:03:29,180
.تفضيله لفرقتها على مجموعتنا

36
00:03:29,180 --> 00:03:32,980
.وحتّى التّخطيط لعرض اليوم. تمّ كلّ ذلك دون استشارتنا

37
00:03:33,440 --> 00:03:36,230
.أكي-كُن هو من اتّخذ تلك القرارات

38
00:03:36,230 --> 00:03:38,650
.لكنّكِ كنتِ تعلمين ولم تمنعيه

39
00:03:38,650 --> 00:03:40,490
.بل ودعمته أيضًا

40
00:03:40,490 --> 00:03:43,450
.لقد فكّر في كلّ هذا

41
00:03:43,450 --> 00:03:45,950
.أرجوكِ ثقي بأكي-كُن أكثر قليلاً

42
00:03:45,950 --> 00:03:46,800
ما هذا؟

43
00:03:46,800 --> 00:03:49,040
أنا الوحيدة الّتي تفهمه،" أهذا ما تحاولين قوله؟"

44
00:03:49,040 --> 00:03:51,080
.أنا حقًّا، حقًّا، حقًّا لا أهتمّ لذلك

45
00:03:51,080 --> 00:03:52,540
...حسنٌ

46
00:03:54,630 --> 00:03:57,420
.آسفة، كنتُ أتحدّث مع نفسي

47
00:03:57,420 --> 00:03:59,550
.انسي كلّ ما قلته

48
00:04:02,590 --> 00:04:05,970
لعلّ كاسوميغاوكا-سينباي مزعجة كثيرًا؟

49
00:04:05,970 --> 00:04:07,560
.لا تقلقي

50
00:04:07,970 --> 00:04:10,560
.ساوامورا-سان أكثر إزعاجًا

51
00:04:10,560 --> 00:04:12,940
،توطّدت علاقتكما مؤخّرًا

52
00:04:12,940 --> 00:04:15,810
.لكن قد تغدو حياتكِ جحيمًا إذا اقتربتِ منها كثيرًا

53
00:04:15,810 --> 00:04:19,820
.أرجو أن تنسي أيضًا ما قلته للتّو

54
00:04:21,280 --> 00:04:22,860
!أهلاً وسهلاً

55
00:04:23,530 --> 00:04:24,450
.ها هي ذي

56
00:04:27,830 --> 00:04:31,540
!هيّا يا ساوامورا-سان، العرض على وشك البدء

57
00:04:31,540 --> 00:04:33,040
.أنا حقًّا لن أدخل

58
00:04:33,040 --> 00:04:36,040
.لا تتصرّفي بصبيانيّة بعد أن وصلتِ إلى هنا

59
00:04:36,040 --> 00:04:36,960
!دعيني وشأني

60
00:04:36,960 --> 00:04:39,250
!قلت أنّي لن أدخل إذًا لن أدخل

61
00:04:40,130 --> 00:04:43,720
...إنّكِ تسيئين الفهم! أكي-كُن

62
00:04:43,720 --> 00:04:46,340
.لا شيء تقولينه سيبلغ مسامعها وهي في هذه الحالة

63
00:04:46,340 --> 00:04:48,100
كاسوميغاوكا-سينباي؟

64
00:04:48,100 --> 00:04:52,980
إلى الآن، الاعتقاد بأنّها كانت صديقة طفولته الأقدم

65
00:04:53,270 --> 00:04:58,940
.كان عزاء ساوامورا-سان المثير للشّفقة الواحد والوحيد

66
00:04:58,940 --> 00:05:03,110
.والآن اندثر كلّ ذلك بعد ظهور هيودو-سان

67
00:05:03,110 --> 00:05:05,820
.لم تعد تملك أيّ شيءٍ تثبت به هويّتها

68
00:05:06,490 --> 00:05:09,780
.إنّها في وضعٍ مخزٍ ومثيرٍ للشّفقة، مثل محاربٍ فرّ من ساحة المعركة

69
00:05:13,410 --> 00:05:15,920
.إذًا فهكذا كنتِ تنكّدين عليها سابقًا

70
00:05:15,920 --> 00:05:17,250
ماذا تقصدين يا ترى؟

71
00:05:17,250 --> 00:05:20,340
.على كلّ، أتمنّى أن توقِفا هذا النّزاع الدّاخليّ

72
00:05:20,710 --> 00:05:23,090
.سيكون كلّ شيءٍ على ما يرام. ثِقا بأكي-كُن

73
00:05:23,090 --> 00:05:27,010
ما الشّيء الّذي رأيناه في أخلاقيّ-كُن حتّى الآن ليحفّز ثقتنا؟

74
00:05:27,010 --> 00:05:31,890
.مع الأسف، أنا أشاطر كاسوميغاوكا أوتاها الرّأي، هذا ليس مضحكًا

75
00:05:31,890 --> 00:05:34,930
.وأيضًا توقّفا عن التّوافق هكذا فجأةً

76
00:05:37,100 --> 00:05:38,400
...المعذرة

77
00:05:38,400 --> 00:05:40,860
!تومو

78
00:05:40,860 --> 00:05:43,070
!سوف أقتلك

79
00:05:41,360 --> 00:05:43,860
!مـ-ميتشيرو، توقّفي

80
00:05:43,070 --> 00:05:45,860
!وأنتحر بعدها

81
00:05:45,860 --> 00:05:48,360
إذًا، بمن يجب أن نثق؟

82
00:05:46,150 --> 00:05:48,700
!فسّر لي ما يحدث يا تومو

83
00:05:48,360 --> 00:05:49,120
...بالفعل

84
00:05:49,620 --> 00:05:52,080
ما هذه الأزياء؟

85
00:05:52,950 --> 00:05:55,250
.توقّعت حدوث هذا

86
00:05:55,250 --> 00:05:56,870
...لا مانع لديّ، لكن

87
00:05:57,160 --> 00:06:02,250
.أجزاء معيّنة تلامس أجزاء معيّنة هناك

88
00:06:04,800 --> 00:06:08,630
.حان الوقت أخيرًا لأكشف لكِ حقيقة فرقتكِ

89
00:06:14,390 --> 00:06:17,890
،في أوّل لقاءٍ لكِ بالأخريات في الفرقة

90
00:06:18,230 --> 00:06:20,400
...الأغنية الّتي كنّ يعزفنها

91
00:06:20,400 --> 00:06:23,650
...لا، حتّى الأغاني الّتي عزفتِها معهنّ بعد انضمامكِ

92
00:06:24,190 --> 00:06:26,820
!جميعها كانت تقليدًا لأغاني الأنمي

93
00:06:26,820 --> 00:06:27,240
ماذا؟

94
00:06:27,240 --> 00:06:36,120
أجل! قبل انضمامكِ، جميع من في فرقة أغاني الأنمي
!الحقيقيّة هذه كنّ يتشاركن اهتمامات الأوتاكو

95
00:06:37,160 --> 00:06:42,920
.جعلنكِ تظنّين أنّكِ تغنّين آخر صيحات أغاني البوب على ما يبدو

96
00:06:42,920 --> 00:06:45,420
!لكنّه لم يكن سوى فخًّا ماكرًا

97
00:06:46,010 --> 00:06:48,130
،بسبب انعدام اهتمامكِ بأغاني الأنمي

98
00:06:48,130 --> 00:06:52,050
.لم تدركي أنّ كلّ الأغاني الّتي أدّيتها كانت أغاني أنمي

99
00:06:52,390 --> 00:06:57,310
.ولهذا السّبب بالذّات حتّى الأغاني الّتي تلحّنينها تحتوي ألحان أنمي

100
00:06:57,310 --> 00:07:01,520
!فرقتكِ غسلت دماغكِ دون أن تدركي ذلك

101
00:07:02,610 --> 00:07:08,190
.كنتَ تنصت لموسيقاها طوال الوقت لكنّك لم تدرك ذلك أيضًا

102
00:07:08,190 --> 00:07:11,660
.بالفعل، لم أدرك ذلك لأنّني على النّقيض أُنصت إلى أغاني الأنمي فقط

103
00:07:11,660 --> 00:07:13,910
!يا لها من حيلةٍ ماكرة

104
00:07:17,830 --> 00:07:18,750
إنّه يكذب، صحيح؟

105
00:07:19,330 --> 00:07:20,370
!أخبرنني أنّه يكذب

106
00:07:20,370 --> 00:07:22,330
!توكي! إتشكا! رانكو

107
00:07:22,790 --> 00:07:26,210
.لا إطلاقًا. إنّها الحقيقة الصّادمة يا ميتشي

108
00:07:26,210 --> 00:07:31,840
.لم نستطع إخباركِ لأنّكِ تصبحين في مزاجٍ سيّئ كلّما تحدّثنا عن الأنمي

109
00:07:33,090 --> 00:07:34,140
.آسفة

110
00:07:34,600 --> 00:07:37,350
!لقد فات أوان الاعتذار

111
00:07:37,350 --> 00:07:37,850
،ميتشيرو

112
00:07:38,850 --> 00:07:42,940
.العالم من حولكِ أكثر أوتاكوويّة بقليل ممّا تظنّين

113
00:07:42,940 --> 00:07:45,110
!هذا ليس قليلًا إطلاقًا

114
00:07:45,110 --> 00:07:47,360
.يا له من تطوّرٍ قسريّ

115
00:07:47,360 --> 00:07:49,570
.هذه قمّة الانتهازيّة

116
00:07:49,570 --> 00:07:51,860
.لا تتحدّثا هكذا أنتما الاثنتان

117
00:07:51,860 --> 00:07:55,780
.وهكذا، أنا وتوكي وإتشكا ورانكو عقدنا اتّفاقًا

118
00:07:55,780 --> 00:07:59,250
،في مقابل أن أدير أيسي تيل كفرقة تؤدّي أغاني الأنمي

119
00:07:59,250 --> 00:08:02,420
.وافقن على السّماح لكِ بالعمل مع بليسينغ سوفتوير

120
00:08:02,420 --> 00:08:05,250
!إنّه مكسبٌ للطّرفين

121
00:08:05,250 --> 00:08:06,590
!انتظر لحظة

122
00:08:06,590 --> 00:08:09,590
!لا أرى أيّ مكسبٍ لي في هذا

123
00:08:10,260 --> 00:08:12,340
.إن كنتِ معارضةً بشدّة فلكِ حريّة الانسحاب

124
00:08:12,340 --> 00:08:15,220
.اخلعي زيّكِ وغادري هذه الصّالة فورًا

125
00:08:16,050 --> 00:08:17,600
،لكن أتعلمين يا ميتشيرو

126
00:08:17,600 --> 00:08:20,680
.صديقاتكِ الحميمات ينتظرنكِ

127
00:08:21,100 --> 00:08:22,890
.نحن آسفاتٌ يا ميتشي

128
00:08:22,890 --> 00:08:24,850
.آسفاتٌ على إخفاء الأمر عنكِ

129
00:08:24,850 --> 00:08:28,070
.لكن لا نستطيع مواصلة الكذب على أنفسنا

130
00:08:28,070 --> 00:08:30,690
.نحن حقًّا نريد تأدية أغاني الأنمي

131
00:08:31,650 --> 00:08:33,820
...توكي... إتشكا... رانكو

132
00:08:33,820 --> 00:08:36,120
!أرجوكِ يا ميتشي

133
00:08:33,820 --> 00:08:36,120
!لنفعلها يا ميتشي

134
00:08:33,820 --> 00:08:36,120
!نحتاجكِ يا ميتشي

135
00:08:36,120 --> 00:08:39,620
.إنّه يحاول تسوية الأمور قسرًا

136
00:08:39,620 --> 00:08:42,460
.يمكنك التفوّه بكلامٍ مؤثّر في وضعيّة راعية البقر، لكنّنا نعلم كيف ستبدو

137
00:08:42,460 --> 00:08:45,080
.اصمتي رجاءً يا كاسوميغاوكا-سينباي

138
00:08:46,630 --> 00:08:49,750
.لكن أنا... أنا لستُ أوتاكو

139
00:08:49,750 --> 00:08:51,550
.لا داعي لأن تكوني أوتاكو

140
00:08:51,550 --> 00:08:54,630
.عليكِ أن تغنّي من أجلنا فحسب

141
00:08:54,630 --> 00:08:55,760
.لا أملك الثّقة

142
00:08:56,470 --> 00:09:00,010
أيمكن لغناء من ليست أوتاكو أن يكون مقبولًا من طرف الأوتاكو؟

143
00:09:00,350 --> 00:09:04,810
.لا تقلقي يا ميتشيرو. واثقٌ أنّكِ ستصبحين يومًا ما أوتاكو حقيقيّة

144
00:09:04,810 --> 00:09:06,980
.لا أظنّ أنّ ذلك ضروريّ

145
00:09:06,980 --> 00:09:10,270
،أنتِ بالفعل اعترفتِ بأنّ أغاني الأنمي رائعة

146
00:09:10,270 --> 00:09:12,780
.لِذا فأنتِ على الأقلّ تملكين الحسّ لاحترامها

147
00:09:13,320 --> 00:09:15,030
.وأنا واثقٌ أنّ ذلك سيبلغهم

148
00:09:15,030 --> 00:09:18,280
!غناؤكِ حتمًا سيبلغ مسامع الأوتاكو

149
00:09:18,280 --> 00:09:19,280
...تومو

150
00:09:19,780 --> 00:09:21,040
...ميتشيرو

151
00:09:21,330 --> 00:09:23,370
!فلنصبح سعداء معًا

152
00:09:27,580 --> 00:09:31,300
—يمكنك التفوّه بكلامٍ مؤثّر في وضعيّة زهرة اللّوتس، لكن

153
00:09:49,020 --> 00:09:49,860
.حسنًا

154
00:11:25,490 --> 00:11:28,370
.والآن، سنختم بالأغنية التالية

155
00:11:30,790 --> 00:11:33,000
.هذه الأغنية الأخيرة اختيارٌ أنانيٌّ قليلًا

156
00:11:33,330 --> 00:11:35,250
.إنّها أغنيةٌ أصليّة من تأليفنا

157
00:11:35,250 --> 00:11:36,590
.استمعوا لها رجاءً

158
00:11:38,840 --> 00:11:39,920
".أُعزّك"

159
00:13:08,890 --> 00:13:09,930
.شكرًا لكم

160
00:13:12,180 --> 00:13:14,060
!شكرًا لكم

161
00:13:20,020 --> 00:13:21,820
!أحبّك

162
00:13:27,740 --> 00:13:30,660
!"إنّه اسم الفرقة! تلك طريقة نطق "أيسي تيل

163
00:13:31,080 --> 00:13:33,320
هل تمازحينني؟

164
00:13:33,320 --> 00:13:34,370
!أحبّك،" سحقًا لها"

165
00:13:34,370 --> 00:13:35,710
!أفلتاني

166
00:13:36,670 --> 00:13:39,590
إذًا، ما انطباعكِ عن أوّل عرضٍ لكِ؟

167
00:13:41,210 --> 00:13:42,550
.كان ملتهبًا

168
00:13:42,550 --> 00:13:43,710
.فهمت

169
00:13:43,710 --> 00:13:47,720
.لم أتخيّل أنّهم سيتحمّسون إلى هذا الحدّ

170
00:13:47,720 --> 00:13:48,970
.كان مذهلًا

171
00:13:48,970 --> 00:13:52,470
.بالطّبع. هكذا هم المعجبون الّذين يحضرون الحفلات

172
00:13:52,470 --> 00:13:55,930
.مهما كان الصّنف، فإنّهم مذهلون ومتحمّسون وغريبو الأطوار

173
00:13:55,930 --> 00:13:57,230
غريبو أطوار؟

174
00:13:57,230 --> 00:14:01,230
.هذا فظّ يا تومو. أنت تتحدّث عن معجبيّ

175
00:14:01,230 --> 00:14:05,150
.لقد حقّقتُ حلمكِ يا ميتشيرو

176
00:14:05,150 --> 00:14:07,950
.رغم أنّه مغايرٌ تمامًا لما تخيّلته

177
00:14:08,490 --> 00:14:12,080
.لِذا الآن حان دوركِ لتحقّقي حلمي

178
00:14:13,240 --> 00:14:16,250
.حتمًا سأجعلكِ تلحّنين موسيقى لعبتنا

179
00:14:17,210 --> 00:14:19,960
أتساءل كيف سأردّ على ذلك؟

180
00:14:19,960 --> 00:14:22,250
.لا يمكنكِ الرّفض بعد الآن

181
00:14:22,250 --> 00:14:25,880
.سمعتِ أولئك الأوتاكو يهتفون لكِ اليوم

182
00:14:26,760 --> 00:14:30,840
.وهذه المرّة موسيقاكِ ستدفعهم للبكاء

183
00:14:30,840 --> 00:14:33,260
موسيقاي ستدفعهم للبكاء؟

184
00:14:33,640 --> 00:14:39,730
.سأجمع سيناريو أوتاها-سينباي ورسم إريري وموسيقاكِ لخلق معجزة

185
00:14:39,730 --> 00:14:41,900
.أنت تبالغ يا تومو

186
00:14:41,900 --> 00:14:44,360
أحقًّا تظنّين ذلك؟

187
00:14:44,360 --> 00:14:47,530
هل من الغباء أن تسيل دموع شخصٍ على لعبة؟

188
00:14:50,490 --> 00:14:54,990
.ربّما الآن يمكنني أن أثق بك قليلًا

189
00:14:54,990 --> 00:14:57,540
.إذًا فقد عُقد الاتّفاق

190
00:14:59,040 --> 00:15:00,040
!مرحى

191
00:15:05,050 --> 00:15:07,510
...في هذه الحالة يا تومو

192
00:15:07,510 --> 00:15:10,090
.فلنبرم الصّفقة

193
00:15:10,090 --> 00:15:12,050
مـ-ميتشيرو؟

194
00:15:12,680 --> 00:15:13,850
...تومو

195
00:15:13,850 --> 00:15:15,060
...مـ-مهلًا

196
00:15:15,640 --> 00:15:18,350
...تعلمين، نحن

197
00:15:18,350 --> 00:15:19,560
...حسنٌ

198
00:15:22,310 --> 00:15:23,190
!مهلًا

199
00:15:25,900 --> 00:15:30,400
!كما لو أنّي سأسامحك بهذه السّهولة

200
00:15:31,360 --> 00:15:35,450
!تومو

201
00:15:31,700 --> 00:15:35,450
!أستسلم، أستسلم! ميتشان

202
00:15:39,080 --> 00:15:42,460
.من الرّائع أنّ هيودو -سان انضمّت إلى المجموعة

203
00:15:42,460 --> 00:15:43,960
.من يأبه

204
00:15:43,960 --> 00:15:48,340
.أنا متشوّقة. ستلحّن لنا أغاني في غاية الرّوعة

205
00:15:48,800 --> 00:15:53,220
.حتّى بدون موسيقى، الرّسم والسّيناريو كفيلان بدفع النّاس للبكاء

206
00:16:00,520 --> 00:16:03,230
ما الأمر؟ هل قلتُ شيئًا غريبًا؟

207
00:16:03,230 --> 00:16:07,440
.لا، شيءٌ أسعدني فحسب. هما شيئان في الواقع

208
00:16:07,440 --> 00:16:08,690
ما قصدكِ؟

209
00:16:08,690 --> 00:16:14,450
.أوّلًا، أظهرتِ لي أنّكِ تعترفين بمهارة كاسوميغاوكا-سينباي

210
00:16:14,450 --> 00:16:17,490
.الشّخصيّة والموهبة شيئان منفصلان

211
00:16:17,490 --> 00:16:22,290
.وثانيًا، هذا يعني أنّكِ عازمةٌ على صناعة اللّعبة

212
00:16:22,290 --> 00:16:24,500
الأمر نفسه ينطبق عليكِ، أليس كذلك؟

213
00:16:27,460 --> 00:16:29,380
.أتحرّق شوقًا لكوميكت الصّيف

214
00:16:30,050 --> 00:16:32,170
.أتساءل كيف ستكون لعبتنا

215
00:16:37,930 --> 00:16:39,390
.أخبريني يا ميجومي

216
00:16:40,560 --> 00:16:41,480
نعم؟

217
00:16:45,600 --> 00:16:47,230
ميجومي"؟"

218
00:16:47,230 --> 00:16:49,610
.لا-لا شيء! زلّة لسان

219
00:16:51,860 --> 00:16:55,200
.كلّا، ليست زلّة لسان

220
00:16:55,200 --> 00:16:56,450
ساوامورا-سان؟

221
00:16:56,870 --> 00:17:02,330
من الغريب أنّ زميلتان أوتاكو سهرتا طوال اللّيل
.للعمل على لعبةٍ معًا تناديان بعضهما برسميّة

222
00:17:09,420 --> 00:17:11,460
ألا تشاطرينني الرّأي؟

223
00:17:13,590 --> 00:17:16,590
.قد تغدو حياتكِ جحيمًا إذا اقتربتِ منها كثيرًا

224
00:17:17,640 --> 00:17:19,300
مـ-ماذا؟

225
00:17:19,300 --> 00:17:20,220
...حسنٌ

226
00:17:20,220 --> 00:17:23,230
...حـ-حسنٌ

227
00:17:27,020 --> 00:17:28,690
.أجل، معكِ حقّ

228
00:17:29,650 --> 00:17:30,570
.يا إريري

229
00:17:47,670 --> 00:17:51,550
.حسنًا، لقد أنقذت العالم بشقّ الأنفس من أجلك

230
00:18:09,770 --> 00:18:11,900
.قرارك هو كلّ ما تبقّى

231
00:18:14,650 --> 00:18:19,160
إذًا، من ستختار يا بطل-كُن؟

232
00:18:26,290 --> 00:18:27,540
...لقد عدت

233
00:18:28,370 --> 00:18:30,460
.إلى هذا العالم من جديد

234
00:18:30,460 --> 00:18:32,170
.إلى هذا العصر من جديد

235
00:18:32,920 --> 00:18:33,840
...مع ذلك

236
00:18:35,590 --> 00:18:37,920
هل تمكّنت من تغيير شيء؟

237
00:18:39,220 --> 00:18:41,140
هل تمكّنت من إنقاذ أحد؟

238
00:18:42,430 --> 00:18:46,140
.في تلك اللّحظة، عصفت رياحٌ عاتية من على التّل

239
00:18:48,060 --> 00:18:53,230
.أملت بنظري على عجلٍ تجاه مهبّ الرّيح

240
00:19:02,870 --> 00:19:07,790
،وفي طرفة عين، بدأت بالتحرّك
.وكنتُ أهرع مسرعًا نحو قمّة التلّ قبل أن أدرك

241
00:19:07,790 --> 00:19:10,290
.وفي لمح البصر، هرعت نحو أسفل التلّ أيضًا

242
00:19:11,210 --> 00:19:13,540
.رويدكِ، لا تتعثّري الآن

243
00:19:13,540 --> 00:19:16,590
.تعلمين أنّكِ خرقاء قليلًا

244
00:19:16,590 --> 00:19:22,180
...على كلّ حال، لم تمر ثلاث ثوانٍ وإذا بنا في منتصف التلّ

245
00:19:26,520 --> 00:19:31,190
.اجتمع شملنا بعد فراقنا لعدّة ساعات. لكنّها كانت عقودًا عديدةً أيضًا

246
00:19:32,440 --> 00:19:34,860
.أتساءل بما عليّ أن أناديك

247
00:19:34,860 --> 00:19:36,020
سيجي-كُن؟

248
00:19:36,020 --> 00:19:37,280
...أم ربّما

249
00:19:37,280 --> 00:19:38,690
أوني-ساما؟

250
00:19:39,490 --> 00:19:41,150
،أيّما تشائين

251
00:19:42,280 --> 00:19:44,530
يا ميجوري. أم عليّ القول روري؟

252
00:21:17,170 --> 00:21:18,170
.اكتملت

253
00:21:19,630 --> 00:21:20,710
.بالفعل

254
00:21:20,710 --> 00:21:23,010
.لا يبدو بها أيّ أخطاء

255
00:21:26,130 --> 00:21:28,260
!إذًا فقد نجحنا! إنّها مثاليّة

256
00:21:41,820 --> 00:21:43,200
.شكرًا لكنّ

257
00:21:43,200 --> 00:21:45,490
.شكرًا لكنّ جميعًا

258
00:21:45,490 --> 00:21:47,990
...لعبتنا الآن

259
00:21:47,990 --> 00:21:50,240
!لديها مسارٌ واحدٌ مكتمل

260
00:21:50,240 --> 00:21:53,830
.حسنًا إذًا، يجدر بي بدء العمل على سيناريو المسار التّالي

261
00:21:54,120 --> 00:21:56,000
.ثلاثون رسمةً متبقية

262
00:21:56,290 --> 00:21:59,130
اثنتا عشرة خلفيّة وكم من الرّسومات المتحرّكة؟

263
00:21:56,710 --> 00:22:00,790
.لكنّي آسفة، دعني أوّلًا أنام لساعة

264
00:22:02,710 --> 00:22:04,630
!تماسكوا يا رفاق

265
00:22:08,430 --> 00:22:09,760
!الزمي الصّمت

266
00:22:09,760 --> 00:22:12,010
.لا أستطيع النّوم مع كلّ هذه الجلبة

267
00:22:14,980 --> 00:22:18,440
.شِئنا أم أبينا، تبقّى لنا شهران على موعد كوميكت الشّتاء

268
00:22:19,520 --> 00:22:21,860
،هذه قصّتنا عن اجتماع الأوتاكو وغير الأوتاكو

269
00:22:21,860 --> 00:22:24,360
،عن المشاكسة، والإحباط والضّحك

270
00:22:25,030 --> 00:22:27,990
،عن الخلافات والتّعاون والشّجار

271
00:22:29,200 --> 00:22:33,290
.وعن شتّى الأمور الأخرى

272
00:22:33,740 --> 00:22:36,790
،تلك القصّة الّتي تسرد طريقنا نحو تحقيق حلمنا

273
00:22:36,790 --> 00:22:38,870
.تقترب أخيرًا من اندفاعتها الأخيرة

274
00:22:42,840 --> 00:22:44,550
.لا، هذا ليس صحيحًا

275
00:22:45,590 --> 00:22:48,800
—معركتنا بدأت للتّو

276
00:22:46,800 --> 00:22:48,800
!توقّف عن اتّخاذ قرارات سلبيّة