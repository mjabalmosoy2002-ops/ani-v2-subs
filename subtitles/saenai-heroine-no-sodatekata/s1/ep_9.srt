1
00:00:28,130 --> 00:00:30,380
!لم تجبني عن شيء

2
00:00:30,380 --> 00:00:33,720
!لم تقدّم لي أيّ إجابةٍ مباشرة إلى الآن

3
00:00:44,480 --> 00:00:46,230
.صباح الخير يا أخلاقيّ-كُن

4
00:00:46,230 --> 00:00:47,230
ماذا؟

5
00:00:54,150 --> 00:00:55,320
.هدّئ من روعك

6
00:00:55,320 --> 00:00:56,410
.كلّ شيءٍ على ما يرام الآن

7
00:00:56,410 --> 00:00:59,740
.لا شيء على ما يرام في هذا الوضع

8
00:00:59,740 --> 00:01:01,620
لمٙ أنتِ هنا يا أوتاها-سينباي؟

9
00:01:01,620 --> 00:01:05,540
.بالطّبع لأنه لم يكن لي أيّ حضورٍ في الحلقة السّابقة

10
00:01:05,540 --> 00:01:07,580
هذا ليس السّبب إطلاقًا، أليس كذلك؟

11
00:01:07,580 --> 00:01:08,790
وماذا تقصدين بـ"حضور"؟

12
00:01:08,790 --> 00:01:10,090
ماذا تقصدين بـ"الحلقة السّابقة"؟

13
00:01:10,090 --> 00:01:12,090
!استيقظت يا أكي-كُن

14
00:01:12,090 --> 00:01:13,260
—سينباي، ما الّذي

15
00:01:14,670 --> 00:01:16,880
!لا تقفي متفرّجة! أوقفيها يا كاتو

16
00:01:16,880 --> 00:01:18,970
.أجل. صحيح

17
00:02:51,020 --> 00:02:52,230
.هكذا إذن

18
00:02:52,230 --> 00:02:54,440
.إذًا فقد استدعيتِ أوتاها-سينباي إلى هنا يا كاتو

19
00:02:54,440 --> 00:02:56,030
.بغضّ النّظر عن ذلك

20
00:02:56,030 --> 00:03:01,410
أليس دخولكِ إلى منزله بعفويّة سببًا يدعو إلى النّقاش يا كاتو-سان؟

21
00:03:01,410 --> 00:03:03,200
.الأمر نفسه ينطبق عليكِ

22
00:03:03,200 --> 00:03:09,790
أليس هرعكِ للوصول إلى هنا في غضون خمس عشرة دقيقة من قولي "أكي-كُن في مأزق" أكثر مدعاةً للنّقاش؟

23
00:03:10,620 --> 00:03:12,630
إذًا، ما الّذي حدث؟

24
00:03:12,630 --> 00:03:14,090
ما قصدكِ؟

25
00:03:14,090 --> 00:03:17,710
،سمعت خلاصة ما حدث من كاتو-سان

26
00:03:17,710 --> 00:03:23,090
لكنّي لن أعرف كيف آل بكِ الحال وساوامورا-سان
.إلى هذا الوضع ما لم أسمع ذلك منك

27
00:03:24,430 --> 00:03:26,560
.هيّا، أفصح بما لديك

28
00:03:26,560 --> 00:03:29,430
.وبعدها سنفكّر في حلٍّ معًا

29
00:03:29,430 --> 00:03:32,150
.لكن هذه مشكلةٌ بيني وبين إريري

30
00:03:32,150 --> 00:03:34,230
.لا أريد أن أقحمكِ أيضًا

31
00:03:34,690 --> 00:03:36,190
أترين يا كاتو-سان؟

32
00:03:36,190 --> 00:03:39,990
هذا مثالٌ حيّ لشخصيّةٍ رئيسيّة لا نفع منها
.في عالم ألعاب محاكاة المواعدة

33
00:03:39,990 --> 00:03:43,030
،عندما يواجه أدنى مشكلة، يُظهر ملامح القلق والتردّد

34
00:03:43,030 --> 00:03:45,160
.ويُزعج من حوله بإقحامهم في ذلك

35
00:03:45,160 --> 00:03:50,000
،إن كنتِ ستصبحين بطلةً رئيسيّة
،فسيكون عليكِ التّعامل مع أمثاله في المستقبل

36
00:03:50,000 --> 00:03:51,790
.لِذا تمعّني في تصرّفاته

37
00:03:51,790 --> 00:03:54,080
.يبدو ذلك متعبًا

38
00:03:54,080 --> 00:03:57,210
.المعذرة، لكن هذا يؤرقني حقًّا

39
00:03:59,010 --> 00:04:00,210
.فهمت

40
00:04:00,210 --> 00:04:03,220
،إذًا، عندما امتدحت كتاب هاشيما-سان

41
00:04:03,220 --> 00:04:06,970
،فقدت ساوامورا-سان صوابها لسببٍ ما وعنّفتها

42
00:04:06,970 --> 00:04:09,180
،وبعد أن مزّقت كتابها إربًا إربًا

43
00:04:09,180 --> 00:04:12,980
.دفعتها إلى بركة طين، وهي تضحك مع أتباعها

44
00:04:13,480 --> 00:04:14,150
صحيح؟

45
00:04:14,150 --> 00:04:17,150
،رغم أنّ معظم ذلك من نسج مخيّلة أحدهم

46
00:04:17,150 --> 00:04:19,110
.لكنّ البداية كانت صحيحةً على الأقل

47
00:04:19,110 --> 00:04:20,820
.ذلك ليس نُضجًا إلى حدٍّ ما

48
00:04:20,820 --> 00:04:22,450
.أجل. بالفعل

49
00:04:22,450 --> 00:04:26,240
.تصرّفاتها لا توحي بأنّها مؤلّفة دوجين شهيرة

50
00:04:26,660 --> 00:04:28,780
أنت من لست ناضجًا، أليس كذلك؟

51
00:04:28,780 --> 00:04:29,740
!أ-أنا؟

52
00:04:29,740 --> 00:04:34,960
أكان من الضّروريّ أن تمتدح كتاب شخصٍ آخر أمام ساوامورا-سان؟

53
00:04:35,710 --> 00:04:43,010
بغضّ النّظر عن ما سألتْ عنه، ألم يكن من الأفضل أن تراوغ السّؤال وتبقي مشاعرك الحقيقيّة طيّ الكتمان؟

54
00:04:43,010 --> 00:04:44,590
...أنا

55
00:04:44,590 --> 00:04:45,970
.لا أستطيع فعل ذلك

56
00:04:46,430 --> 00:04:49,970
.لا أستطيع القول عن شيءٍ رائع أنّه ليس رائعًا

57
00:04:50,470 --> 00:04:57,020
أُفضّل أن أتخّلى عن كوني أوتاكو على أن أقول
.عن دوجينشي إيزومي-تشان أو رواياتكِ أنّها مملّة

58
00:04:57,730 --> 00:05:00,400
...لـ-لكن

59
00:05:00,400 --> 00:05:04,820
.لكن كلماتك لساوامورا-سان كانت ضربةً قاتلةً لها

60
00:05:05,240 --> 00:05:10,540
.مهما كان ما أقوله، فإنّه لن يحزّ في شعبيّة أو قدرات إريري

61
00:05:10,540 --> 00:05:12,580
.لكنّه سيحزّ في قلبها

62
00:05:13,200 --> 00:05:16,670
.ربّما يجعلها هذا غير قادرةٍ على الرّسم

63
00:05:16,670 --> 00:05:18,500
!يستحيل حدوث ذلك

64
00:05:18,500 --> 00:05:22,760
.واثقةٌ أنّ ساوامورا-سان شعرت كما لو أنّ كلّ شيءٍ قد سُلب منها

65
00:05:22,760 --> 00:05:24,550
ماذا تقصدين بـ "كلّ شيء"؟

66
00:05:24,550 --> 00:05:28,340
.كرامتها كمبدعة ومكانتها كصديقة طفولتك

67
00:05:29,890 --> 00:05:33,220
.ففي النّهاية، هاشيما-سان متعلّقةٌ بك كثيرًا

68
00:05:33,220 --> 00:05:37,190
.إنّها مثل بطلةٍ رغم تأخّر ظهورها في القصّة إلّا أنّ بدايتها كانت قويّة

69
00:05:37,190 --> 00:05:41,480
.النّوع الّذي تعترف بمشاعرها للبطل بعد فشله بالظّفر بفتاة أحلامه

70
00:05:42,320 --> 00:05:43,820
!هذا يثير حنقي

71
00:05:43,820 --> 00:05:46,990
البطلة الاحتياطيّة الخفيّة ينبغي أن تعرف
!مكانتها وتظلّ خفيّةً حتّى النّهاية

72
00:05:44,900 --> 00:05:45,860
!سينباي

73
00:05:48,950 --> 00:05:50,410
،عل أيّ حال

74
00:05:50,410 --> 00:05:53,040
،من أجل التصدّي للخطر الّذي يتهدّد هذه المجموعة

75
00:05:53,040 --> 00:05:55,370
.عليك أن تبذل قصارى جهدك يا أخلاقيّ-كُن

76
00:05:55,370 --> 00:05:57,330
.أتساءل ماذا عليّ أن أفعل

77
00:05:57,830 --> 00:06:00,500
.اظفر بالبطلة صديقة الطّفولة

78
00:06:00,500 --> 00:06:03,050
.أيّها البطل الجبان-كُن، أقصد يا أخلاقيّ-كُن

79
00:06:03,050 --> 00:06:06,670
.كان هذا ليكون مشهدًا مؤثّرًا لو لم تفسديه

80
00:06:07,300 --> 00:06:11,260
...ذكرياتٌ غابرة، حنينٌ إلى الماضي، وعودٌ من الطّفولة

81
00:06:11,260 --> 00:06:14,270
،سخّر كلّ ما لديك من مزايا كصديق طفولة

82
00:06:16,180 --> 00:06:19,900
أتظنّين أنّ تلك الحيّل الجليّة ستجدي معها؟

83
00:06:19,900 --> 00:06:22,060
.أظنّ أنّ ذلك سيجدي كما ينبغي

84
00:06:22,060 --> 00:06:26,360
.بدل أن تلعب دور البطل، عليك أن تلعب دور البطلة

85
00:06:42,840 --> 00:06:46,090
!إريري، أنا وأبوكِ سنغادر الآن

86
00:06:46,800 --> 00:06:48,720
!اليوم الثّالث والأخير من كوميكت الصّيف

87
00:06:48,720 --> 00:06:50,380
!يوم المعركة المقدّسة

88
00:06:50,380 --> 00:06:53,350
!أجل، للانغماس في الصّنف الموجّه للذّكور

89
00:06:54,310 --> 00:06:55,770
.رافقتما السّلامة

90
00:06:55,770 --> 00:06:56,810
.تذكّرت

91
00:06:56,810 --> 00:06:58,230
...بشأن حفلة اللّيلة

92
00:06:58,230 --> 00:06:59,850
.أعلم

93
00:06:59,850 --> 00:07:02,860
.لا يمكنني إحراج أبي

94
00:07:17,450 --> 00:07:18,700
هل ستغادر في هذا الوقت المبكّر؟

95
00:07:19,210 --> 00:07:20,870
.أجل، أنا ذاهب

96
00:07:22,750 --> 00:07:24,090
،إلى اليوم الثّالث من كوميكت الصّيف

97
00:07:24,090 --> 00:07:25,880
،A276 الشّرق

98
00:07:25,880 --> 00:07:27,670
.ليلي الأنانيّة

99
00:07:27,670 --> 00:07:30,590
.أتساءل إن كانت ساوامورا-سان ستتواجد هناك

100
00:07:30,590 --> 00:07:32,430
.على الأرجح لا

101
00:07:32,430 --> 00:07:34,220
.لكن يتوجّب عليّ الذّهاب

102
00:07:34,220 --> 00:07:36,220
.أجل، بالتّوفيق

103
00:07:36,220 --> 00:07:38,100
.شكرًا لكِ يا كاتو

104
00:07:38,100 --> 00:07:38,680
ماذا؟

105
00:07:38,680 --> 00:07:40,640
.لم أفعل شيئًا يستحقّ الشّكر

106
00:07:40,640 --> 00:07:43,230
.كاسوميغاوكا-سينباي هي من عملت بجدٍّ ليلة أمس

107
00:07:44,610 --> 00:07:46,480
.ومع ذلك أشكركِ

108
00:07:51,070 --> 00:07:52,570
،تذكّرت

109
00:07:52,570 --> 00:07:55,450
.يجب أن نفكّر باسمٍ لمجموعتنا في أقرب وقت

110
00:07:55,450 --> 00:07:56,740
.معكِ حقّ

111
00:07:58,040 --> 00:08:00,250
.حسنًا، أنا ذاهب

112
00:08:00,660 --> 00:08:02,710
.أجل، رافقتك السّلامة

113
00:08:23,520 --> 00:08:24,020
!يوري

114
00:08:24,020 --> 00:08:27,520
!عجبًا، لقد أتيت يا تومويا-كُن

115
00:08:27,520 --> 00:08:30,440
كنت تراقبني منذ وصولي إلى هنا، أليس كذلك؟

116
00:08:30,440 --> 00:08:32,820
...أن تعرج على ركننا

117
00:08:32,820 --> 00:08:34,490
أيّ رِياحٍ ألقت بك إلى هنا؟

118
00:08:34,490 --> 00:08:38,370
.ليكن في علمك أنّي لا أنوي التّنازل عن ضمّ كاشيواجي إيري

119
00:08:38,370 --> 00:08:40,790
.لستُ هنا لأسألك التّنازل

120
00:08:40,790 --> 00:08:43,000
.أحتاج مساعدتك فحسب

121
00:08:43,000 --> 00:08:44,210
المساعدة؟

122
00:08:44,210 --> 00:08:45,120
لأجل ماذا؟

123
00:08:45,500 --> 00:08:47,040
أليس واضحًا؟

124
00:08:47,040 --> 00:08:49,380
!لأعيد إريري إلى مجموعتي

125
00:08:49,840 --> 00:08:50,710
ماذا؟

126
00:10:14,840 --> 00:10:16,340
!من هنا يا إريري

127
00:10:23,560 --> 00:10:25,930
ما الّذي تفعله يا تومويا؟

128
00:10:25,930 --> 00:10:28,190
هلّا تسلّلتِ معي خارجًا لبعض الوقت يا إريري؟

129
00:10:28,190 --> 00:10:29,100
ماذا؟

130
00:10:29,100 --> 00:10:30,600
ماذا دهاك؟

131
00:10:30,600 --> 00:10:32,860
!فلنذهب إلى البلدة معًا كما اعتدنا أن نفعل

132
00:10:38,860 --> 00:10:41,120
!هيّا لنذهب يا إريري

133
00:10:41,120 --> 00:10:42,780
ألست مُحرجًا من فعل هذا؟

134
00:10:42,780 --> 00:10:44,240
!في غاية الإحراج

135
00:10:44,240 --> 00:10:46,040
!أكاد أموت من الخجل

136
00:10:46,040 --> 00:10:48,370
!مع ذلك، لا يمكنني أن أموت الآن

137
00:10:48,830 --> 00:10:52,210
!أرفض الموت قبل أن أتصالح معكِ

138
00:11:11,060 --> 00:11:13,110
.حسنًا، سننفّذ الخطّة مساء غد

139
00:11:16,480 --> 00:11:20,280
.تُقيم عائلتها حفلةً كلّ سنة في ليلة عرض الألعاب النّاريّة

140
00:11:20,280 --> 00:11:22,410
.تلك هي فرصتي الوحيدة لإقناعها

141
00:11:22,410 --> 00:11:23,530
.فهمت

142
00:11:23,530 --> 00:11:27,830
".أسّستُ الوضع على حدث الألعاب النّاريّة في "ليتل لاف رابسودي

143
00:11:27,830 --> 00:11:31,040
كاتو-سان، أيمكنكِ تمثيل ذلك المشهد الآن؟

144
00:11:31,040 --> 00:11:32,120
!حسنًا

145
00:11:32,120 --> 00:11:37,300
هذه الخطّة تهدف لتحفيز ذكرياتها القديمة
.والحنين إلى الماضي لدفعها إلى التّصالح معك

146
00:11:37,300 --> 00:11:38,670
.أتساءل إن كانت ستجدي

147
00:11:38,670 --> 00:11:39,840
.لا تقلق

148
00:11:39,840 --> 00:11:42,640
...لأنّ طبيعة ساوامورا-سان الحقيقيّة

149
00:11:42,640 --> 00:11:44,260
!أجل، عذراء

150
00:11:44,260 --> 00:11:50,430
إنّها فتاةٌ تتألّم، منتظرةً أن يأتي فارسها الأوتاكو على
!سيّارته البيضاء المطليّة برسومات الأنمي ليأخذها

151
00:11:51,940 --> 00:11:52,900
أتصدّق ذلك؟

152
00:11:52,900 --> 00:11:55,440
أليس ذلك رومنسيًّا جدًا لرسّامة دوجين إباحيّ؟

153
00:11:55,440 --> 00:11:56,610
أتظنّين ذلك؟

154
00:11:56,610 --> 00:11:59,740
.ربّما كونها رسّامة دوجين إباحيّ هو بالذّات سبب أنّها رومنسيّة

155
00:11:59,740 --> 00:12:01,990
!ليس فقط أوتاها-سينباي، بل وأنتِ أيضًا يا كاتو؟

156
00:12:01,990 --> 00:12:03,240
!هذا لئيم

157
00:12:11,460 --> 00:12:12,290
...مبنى المدرسة

158
00:12:13,210 --> 00:12:15,830
.يبدو أنّهم قاموا بتجديده في مرحلةٍ ما

159
00:12:15,830 --> 00:12:17,380
.قبل سنتين على ما أظنّ

160
00:12:17,380 --> 00:12:18,590
.قاموا بتجديده

161
00:12:19,710 --> 00:12:20,300
.فهمت

162
00:12:23,970 --> 00:12:25,760
.أخبريني يا إريري

163
00:12:27,010 --> 00:12:28,970
لماذا تحاول التّصالح معي الآن؟

164
00:12:28,970 --> 00:12:32,560
ألم تكن "ليتراب" أوّل لعبةٍ هديتُك إليها؟

165
00:12:32,560 --> 00:12:33,980
.هذا صحيح

166
00:12:33,980 --> 00:12:36,730
.قبل ذلك، لم أكن أكترث لألعاب محاكاة المواعدة

167
00:12:36,730 --> 00:12:38,940
.لكن حين جرّبتها، فاقت متعتها تصوّري

168
00:12:38,940 --> 00:12:42,400
.ومن ثمّ هديتٙ إليها فتاةً أخرى

169
00:12:42,400 --> 00:12:44,360
ألا تسمّي ذلك خيانة؟

170
00:12:45,160 --> 00:12:46,490
...إريري

171
00:12:46,990 --> 00:12:49,200
!طوبى لك لعثورك على كتابٍ جيّد

172
00:12:49,200 --> 00:12:54,040
!كما أنّ ذلك الكتاب من تأليف صديقة طفولتك وتلميذتك الأولى

173
00:12:54,040 --> 00:12:55,370
.هذا رائع

174
00:12:56,040 --> 00:12:58,040
.لست بحاجتي بعد الآن

175
00:12:58,040 --> 00:13:00,920
.ضمّها إلى المجموعة فحسب

176
00:13:00,920 --> 00:13:02,260
.ودعني وشأني

177
00:13:08,890 --> 00:13:11,100
.آسفٌ يا أوتاها-سينباي

178
00:13:11,100 --> 00:13:12,810
.آسفٌ يا كاتو

179
00:13:14,480 --> 00:13:16,020
!أصغي يا إريري

180
00:13:20,570 --> 00:13:22,780
.ثمّة شيءٌ لم أستطع أن أخبركِ به قبلًا

181
00:13:22,780 --> 00:13:26,280
.لقد فات الأوان على الاعتذار

182
00:13:28,200 --> 00:13:29,740
...أتعلمين، أنا

183
00:13:29,740 --> 00:13:31,870
...منذ وقتٍ طويل وأنا

184
00:13:31,870 --> 00:13:33,580
!قول هذا الآن ليس عدلًا

185
00:13:33,580 --> 00:13:36,290
!لقد كنتُ مستاءً منكِ للغاية

186
00:13:38,880 --> 00:13:40,540
!من يأبه للتّصالح معكِ

187
00:13:40,540 --> 00:13:42,000
!وكيف لي أن أفعل؟

188
00:13:42,000 --> 00:13:44,880
!يستحيل أن أسامحكِ بعد فعلتكِ

189
00:13:44,880 --> 00:13:46,590
بمٙ تهذي؟

190
00:13:46,590 --> 00:13:47,800
ما الّذي تقصده؟

191
00:13:47,800 --> 00:13:50,100
!أنا المظلومة هنا

192
00:13:50,100 --> 00:13:52,010
ما هذا الهراء الّذي تتفوّه به؟

193
00:13:52,010 --> 00:13:55,310
!ألستِ من أدارت ظهرها لي أوّلًا؟

194
00:14:38,640 --> 00:14:39,770
...قبل ثمان سنوات

195
00:14:40,600 --> 00:14:45,730
ألستِ من تظاهرت بالتوقّف عن كونها أوتاكو
!واتّخذت أصدقاء جدد وتخلّت عنّي؟

196
00:14:46,530 --> 00:14:48,280
...أنت

197
00:14:48,900 --> 00:14:51,280
ما زلت تحمل ضغينةً تُجاه شيءٍ كهذا؟

198
00:14:51,280 --> 00:14:54,160
ما قصدكِ بـ"شيءٌ كهذا"؟

199
00:14:54,160 --> 00:14:55,790
!لم أكن أملك أيّ خيار

200
00:14:55,790 --> 00:14:57,960
!وقتها كان ذلك الخيار الوحيد أمامي

201
00:14:57,960 --> 00:14:59,540
أتظنّين أنّ ذلك يصفح عنكِ؟

202
00:14:59,540 --> 00:15:03,210
أكان اتّخاذ أصدقاء جدد أمرًا بتك الأهميّة لكِ؟

203
00:15:03,210 --> 00:15:06,050
أكان ذلك أكثر أهميّةً من الحديث معي حول الأنمي؟

204
00:15:06,050 --> 00:15:07,130
...تومويا

205
00:15:07,130 --> 00:15:11,300
ألديكِ أدنى فكرةٍ عن معزّتكِ عندي وقتها؟

206
00:15:11,890 --> 00:15:14,470
!جعلت من كلّ الصّبيان أعداءً لي

207
00:15:14,470 --> 00:15:18,350
!فعلت كلّ ذلك في سبيل حماية ما ملكناه معًا

208
00:15:18,350 --> 00:15:20,140
،في نظري وقتها

209
00:15:20,140 --> 00:15:22,310
!لم يكن لي غيركِ

210
00:15:24,730 --> 00:15:29,490
.مرّت سنوات، واستطعت الحديث معكِ كما اعتدنا أن نفعل

211
00:15:29,490 --> 00:15:33,570
!لكن رغم ذلك، لن أنسى أبدًا معاملتكِ لي بجفاءٍ وقتها

212
00:15:33,570 --> 00:15:34,990
...هذا

213
00:15:34,990 --> 00:15:37,450
!أنت تنفّس عن غضبك عليّ فحسب

214
00:15:37,450 --> 00:15:39,120
!اعتذري

215
00:15:40,500 --> 00:15:41,830
.لن أفعل

216
00:15:41,830 --> 00:15:43,080
،مهما حدث

217
00:15:43,540 --> 00:15:45,590
!لن أعتذر لك أبدًا

218
00:15:45,590 --> 00:15:49,340
!لأنّك لا تدري كم ذرفت من دموع

219
00:15:49,340 --> 00:15:49,970
...إريري

220
00:15:49,970 --> 00:15:51,470
.قطعت روابطي معك

221
00:15:51,470 --> 00:15:55,100
!ولم أستطِع الحديث معك في المدرسة بعدها وتحتّم عليّ تجاهلك

222
00:15:55,100 --> 00:15:58,350
.لكم سالت دموعي وِحدةً وإحباطًا وحزنًا

223
00:15:58,350 --> 00:16:00,810
!لقد قاسيت أكثر منك

224
00:16:00,810 --> 00:16:04,020
!طوال تلك السّنوات كان اللّوم يرتدّ على قلبي

225
00:16:04,020 --> 00:16:05,730
!لِذا لا سبب يدعوني للاعتذار

226
00:16:05,730 --> 00:16:07,150
!رغم أنّها غلطتكِ؟

227
00:16:07,150 --> 00:16:08,110
!أجل، هل هذا خطأ؟

228
00:16:08,110 --> 00:16:09,070
!أجل، هو كذلك

229
00:16:09,070 --> 00:16:10,400
!لا أكترث

230
00:16:10,400 --> 00:16:12,360
!أنت من عليه الاعتذار

231
00:16:12,360 --> 00:16:13,200
!لماذا؟

232
00:16:13,200 --> 00:16:16,160
!لماذا فضّلت كتابها على كتابي؟

233
00:16:16,160 --> 00:16:16,700
!ماذا؟

234
00:16:16,700 --> 00:16:21,460
!أنا أكثر شعبيّة ومهارة، وأقدم معرفةً بك

235
00:16:21,460 --> 00:16:23,960
!لماذا لم تخترني؟

236
00:16:28,090 --> 00:16:30,130
!أحبّ ما أحبّ

237
00:16:30,130 --> 00:16:31,470
!لا أهتمّ لمسيرة المؤلّف

238
00:16:31,970 --> 00:16:34,130
!كتاب إيزومي-تشان حمّسني أكثر

239
00:16:34,130 --> 00:16:35,890
أتريد القول أنّي أقلّ شأنًا من تلك الفتاة؟

240
00:16:35,890 --> 00:16:36,720
!هذا صحيح

241
00:16:36,720 --> 00:16:38,470
!أنتِ أدنى منها

242
00:16:38,470 --> 00:16:39,310
!أقلّ شأنًا

243
00:16:39,310 --> 00:16:40,060
!لستِ جيّدةً كفاية

244
00:16:40,060 --> 00:16:41,980
رغم كلّ عملي المضني؟

245
00:16:41,980 --> 00:16:43,890
رغم أنّي بذلت فيه كلّ ما أوتيت؟

246
00:16:43,890 --> 00:16:46,150
.لا علاقة للأمر بقدراتكِ ومجهودكِ

247
00:16:46,150 --> 00:16:48,860
!الكتاب الّذي عرضتِه اليوم في كوميكت الصّيف كان رديئًا

248
00:16:48,860 --> 00:16:50,360
!إنّه لا يملك ما يلزم

249
00:16:50,360 --> 00:16:51,610
!ليس مذهلًا إطلاقًا

250
00:16:51,610 --> 00:16:53,650
...بذلت جهدي

251
00:16:54,780 --> 00:16:56,160
،أُخفي الأمر عندما أكون في الخارج

252
00:16:56,160 --> 00:16:57,910
!لكن في البيت أُجهد نفسي حتّى الموت

253
00:16:57,910 --> 00:17:01,500
!أردت أن أقتصّ ممّن فرّق بيننا

254
00:17:01,500 --> 00:17:03,460
.أردت أن نعود إلى سابق عهدنا

255
00:17:03,460 --> 00:17:05,500
...وأخيرًا وصلت إلى هذا الحدّ، مع ذلك

256
00:17:06,380 --> 00:17:07,750
.هذا صحيح

257
00:17:07,750 --> 00:17:09,710
!لقد قطعتِ شوطًا طويلًا

258
00:17:09,710 --> 00:17:11,960
!وصلتِ إلى هنا بسرعة ومهارة وثبات

259
00:17:12,510 --> 00:17:14,590
!لِذا فليكن هدفكِ التّالي بلوغ العظمة

260
00:17:14,590 --> 00:17:17,800
!أظهري للجميع أنّ بإمكانكِ أن تصبحي سريعة، ماهرة، ثابتة، وعظيمة

261
00:17:17,800 --> 00:17:19,350
!أنى لي؟

262
00:17:19,350 --> 00:17:21,810
!هذه حدود جهدي ومهارتي

263
00:17:21,810 --> 00:17:22,980
!وكيف لي أن أعرف؟

264
00:17:22,980 --> 00:17:23,980
!إنّه رسمكِ

265
00:17:23,980 --> 00:17:25,020
!جِدي الحلّ بنفسكِ

266
00:17:25,020 --> 00:17:26,770
!أنت تطلب منّي المحال

267
00:17:26,770 --> 00:17:28,310
!أجل إنّه محال

268
00:17:28,310 --> 00:17:30,570
!لِذا إن لم ترغبي بذلك، فلن يجبركِ أحد

269
00:17:31,020 --> 00:17:34,070
!أنتِ لا تكترثين بأن تصبحي الأولى في نظري

270
00:18:08,350 --> 00:18:09,520
.سأفعلها

271
00:18:10,650 --> 00:18:14,860
.سأصبح الأولى في نظرك

272
00:18:14,860 --> 00:18:17,820
.وإلى حينها لن أعتذر أبدًا

273
00:18:33,920 --> 00:18:35,260
.افعلي ما يلزم

274
00:18:50,560 --> 00:18:52,360
.أ-أخبريني يا إريري

275
00:18:52,360 --> 00:18:53,150
ماذا؟

276
00:18:53,650 --> 00:18:57,150
أنتِ تكذبين بشأن التواء كاحلكِ، صحيح؟

277
00:18:57,150 --> 00:18:58,860
تستطعين المشي، صحيح؟

278
00:18:58,860 --> 00:19:03,240
.الفارس الّذي أخرج الأميرة من قصرها قسرًا لا يحقّ له التّذمّر

279
00:19:06,240 --> 00:19:09,660
.لكنّنا لم نتصالح بعد على ما يبدو

280
00:19:11,080 --> 00:19:12,920
.هذا صحيح

281
00:19:13,630 --> 00:19:16,960
ما زلنا متخاصمين، أليس كذلك؟

282
00:19:26,720 --> 00:19:27,770
!انتهيت

283
00:19:27,770 --> 00:19:30,060
!رسمة لافتة المجموعة اكتملت

284
00:19:30,060 --> 00:19:31,770
!دعينا نرى

285
00:19:32,310 --> 00:19:35,770
.هذا لطفٌ منكِ يا ساوامورا-سان

286
00:19:35,770 --> 00:19:37,400
!مهلًا لحظة

287
00:19:37,400 --> 00:19:40,280
!هل أتخيّل، أم أنّ تلك الفتاة لا تلبس شيئًا؟

288
00:19:40,280 --> 00:19:42,280
.لا تقلقي يا كاتو-سان

289
00:19:42,280 --> 00:19:46,120
.بذلت جهدي في اقتباس قوام النّموذج بإتقان، عن قوامكِ أتحدّث

290
00:19:46,120 --> 00:19:48,750
!القيام بذلك بإتقان لا يبيح فعلها

291
00:19:48,750 --> 00:19:50,000
عمّ تتحدّثين؟

292
00:19:50,000 --> 00:19:51,370
،تتعرّى عندما يُطلب منها أن تتعرّى

293
00:19:51,370 --> 00:19:53,080
.تلهث عندما يُطلب منها أن تلهث

294
00:19:53,080 --> 00:19:54,790
تلك هي البطلة الحقيقيّة، أليس كذلك؟

295
00:19:55,670 --> 00:19:57,550
أ-أهذا صحيح؟

296
00:19:57,550 --> 00:19:59,300
.اطمئنّي، هذه اللّعبة لجميع الأعمار

297
00:19:59,300 --> 00:20:01,510
.الأهمّ من هذا يا تومويا

298
00:20:01,510 --> 00:20:05,010
.ضع عليها اللّمسة الأخيرة أيّها المنتج

299
00:20:05,010 --> 00:20:05,800
.أكيد

300
00:20:10,480 --> 00:20:13,310
بليسينغ سوفتوير إذًا؟

301
00:20:13,730 --> 00:20:15,520
اسمٌ جيّد، أليس كذلك؟

302
00:20:15,520 --> 00:20:17,570
.بالنّسبة لك، أفترض ذلك

303
00:20:17,570 --> 00:20:21,070
.رغم أنّ ترجمتها تُقرأ "ميجومي سوفتوير" باليابانيّة

304
00:20:21,570 --> 00:20:22,320
—ما

305
00:20:23,320 --> 00:20:24,820
ماذا؟

306
00:20:24,820 --> 00:20:26,320
...لـ-لا، حسنٌ

307
00:20:26,320 --> 00:20:27,740
...تعلمين

308
00:22:02,840 --> 00:22:06,130
!أوني-تشان، هل أنت على معرفةٍ بكاشيواجي إري-سينسي؟

309
00:22:06,630 --> 00:22:09,640
.أنتِ تعرفينها أيضًا لكنّكِ لم تدركي ذلك

310
00:22:09,640 --> 00:22:11,350
!انتظر لحظة

311
00:22:11,350 --> 00:22:15,560
!لماذا سترسم رسّامةٌ من مجموعةٍ شهيرة شيئًا لي؟

312
00:22:15,560 --> 00:22:17,890
،"في الواقع، تقول أنّها معجبةٌ قديمة بـ"ليتراب

313
00:22:17,890 --> 00:22:20,150
.وقد تأثّرت بالدّوجينشي الخاصّ بكِ على ما يبدو

314
00:22:21,360 --> 00:22:25,190
أوني-تشان، أيعقل أنّك أعطيت نسخةً من كتابي إلى كاشيواجي إري-سينسي؟

315
00:22:25,190 --> 00:22:27,990
.لا، يبدو أنّها اصطفّت في الطّابور واشترته بنفسها

316
00:22:27,990 --> 00:22:28,950
!لماذا؟

317
00:22:28,950 --> 00:22:31,370
!كان عليها أن تعرّف عن نفسها

318
00:22:35,830 --> 00:22:37,370
!مذهل