1
00:01:46,330 --> 00:01:47,750
،وبهذا

2
00:01:47,750 --> 00:01:52,170
.أودّ شيئًا كهذا لحدث اللّقاء الثّاني مع البطلة الرّئيسيّة

3
00:01:52,170 --> 00:01:55,550
أليس الانحراف العرضيّ مبتذلًا نوعًا ما؟

4
00:01:55,550 --> 00:01:57,720
.سيجعلها تبدو كتصنيف هاريم

5
00:01:57,720 --> 00:01:59,390
!ما العيب في ما هو مبتذل؟

6
00:01:59,390 --> 00:02:01,430
!عروض الهاريم رائعةٌ يا أوتاها-سينباي

7
00:02:01,430 --> 00:02:05,270
.أشعر أنّها لا تلائم أسلوبي الأدبيّ

8
00:02:05,270 --> 00:02:09,980
.أكره قول هذا، لكن تومويا لديه وجهة نظرٍ سديدة في هذه القضيّة

9
00:02:09,980 --> 00:02:10,480
ماذا؟

10
00:02:10,480 --> 00:02:13,400
.قد يختلف الأمر في الرّوايات، لكن هذه لعبة محاكاة مواعدة

11
00:02:13,400 --> 00:02:15,610
!ليست عملًا أدبيًّا، بل ترفيه

12
00:02:15,610 --> 00:02:20,160
،مهما كانت جدّية اللّعبة، إن لم تكن الفتيات ظريفات مع القليل من الإغواء

13
00:02:20,160 --> 00:02:22,870
.سيفقد اللّاعبون اهتمامهم بها،كما أنّها لن تكون ممتعة

14
00:02:22,870 --> 00:02:26,000
بالإضافة، ما سبب وجودي هنا برأيكِ؟

15
00:02:26,000 --> 00:02:28,540
،إن لم يكن هناك مشاهد فتياتٍ ظريفات

16
00:02:28,540 --> 00:02:30,880
فسيكون ذلك إهدارًا لموهبتي، أليس كذلك؟

17
00:02:30,880 --> 00:02:32,130
...إريري

18
00:02:32,540 --> 00:02:33,750
،ساوامورا-سان

19
00:02:33,750 --> 00:02:37,420
.منذ نهاية كوميكت الصّيف وأنتِ متحفّزةٌ بغرابة

20
00:02:37,420 --> 00:02:39,380
.أتساءل عمّا حدث بحقّ

21
00:02:41,260 --> 00:02:44,260
!وأنتِ كنتِ متحمّسةً حتّى قبل العطلة الصّيفيّة

22
00:02:44,260 --> 00:02:46,600
.أنا كاتبةٌ محترفة

23
00:02:46,600 --> 00:02:50,230
.نحن نبذل قصارى جهدنا بغضّ النّظر عن ما نعمل عليه

24
00:02:50,230 --> 00:02:53,730
.سمعت أنّ روايتكِ الجديدة متخلّفةٌ عن الجدول الزّمنيّ

25
00:02:53,730 --> 00:02:56,230
من أفشى لكِ بذلك؟

26
00:02:56,230 --> 00:03:00,660
.اعتمادًا على الملابسات، قد أضطرّ لمحو المخبر من الوجود

27
00:03:00,660 --> 00:03:02,370
،على كلّ حال

28
00:03:02,370 --> 00:03:06,790
هلّا ألقيتِ نظرةً أخرى على فعاليّات الافتتاح يا أوتاها-سينباي؟

29
00:03:06,790 --> 00:03:09,580
لم يكن أنت، أليس كذلك يا أخلاقيّ-كُن؟

30
00:03:09,580 --> 00:03:11,000
!انتهينا من ذلك الموضوع

31
00:03:11,000 --> 00:03:12,920
!فلننظر إلى ما هو قادم

32
00:03:12,920 --> 00:03:14,340
.فهمت

33
00:03:14,340 --> 00:03:16,130
.سألقي نظرةً أخرى على السّيناريو

34
00:03:16,130 --> 00:03:19,420
!على كلّ، لا بدّ أن تتواجد به صرخة البطلة الظّريفة

35
00:03:19,420 --> 00:03:21,340
!هيّا أيّتها البطلة الرّئيسيّة، أريها مثالًا

36
00:03:21,340 --> 00:03:22,180
ماذا؟

37
00:03:22,180 --> 00:03:23,930
.أجل، أكيد

38
00:03:23,930 --> 00:03:25,640
!كـ-كيــاااا

39
00:03:25,640 --> 00:03:28,390
!إ-إلى ما تنظر أيّها المنحرف

40
00:03:29,270 --> 00:03:32,020
.حسنٌ، كان ذلك مثالًا سيّئًا

41
00:03:32,020 --> 00:03:33,690
،على كلّ حال

42
00:03:33,690 --> 00:03:35,770
.نسيت أنّكِ هنا يا كاتو-سان

43
00:03:40,780 --> 00:03:42,160
.لقد تأخّر الوقت

44
00:03:42,950 --> 00:03:44,660
.يجب أن أستحمّ وأخلد إلى النّوم

45
00:03:54,540 --> 00:03:55,500
!هذا أنت يا تومو

46
00:03:55,500 --> 00:03:56,920
!لم أرك منذ وقتٍ طويل

47
00:03:56,920 --> 00:03:58,300
الحمّام؟

48
00:03:58,300 --> 00:04:01,670
.انتهيت للتّو، يمكنك الدّخول الآن

49
00:04:13,600 --> 00:04:15,020
!آسفةٌ على ذلك

50
00:04:15,020 --> 00:04:17,730
.كان عليّ إعلامك بوجودي هنا قبل الدّخول إلى الحمّام

51
00:04:17,730 --> 00:04:18,820
!الأمر برمّته خاطئ

52
00:04:18,820 --> 00:04:20,570
!لستِ من عليها الاعتذار

53
00:04:20,570 --> 00:04:21,610
،يفترض بكِ الصّراخ قائلة

54
00:04:21,610 --> 00:04:23,860
"!إ-إلى ما تنظر أيّها المنحرف؟"

55
00:04:23,860 --> 00:04:25,450
!ثمّ تنفجرين عليّ غضبًا

56
00:04:25,450 --> 00:04:27,490
.هذا ليس صحيحًا إطلاقًا

57
00:04:27,490 --> 00:04:31,950
سأمكث هنا لبعض الوقت، لِذا فأنا الملامة
.على عدم إلقاء التّحيّة فور دخولي

58
00:04:31,950 --> 00:04:34,500
،أقدّر مراعاتكِ

59
00:04:34,500 --> 00:04:38,460
.لكن تجاهلكِ لما قلته للتّو ليس أقلّ جفاءً

60
00:04:38,460 --> 00:04:41,880
.هكذا تكون غرفة الأوتاكو وإلّا فلا

61
00:04:41,880 --> 00:04:44,970
ألم تكبر بعد على لعب ألعاب الفيديو يا تومو؟

62
00:04:46,510 --> 00:04:48,350
إذًا، ماذا جاء بكِ إلى هنا يا ميتشيرو؟

63
00:04:48,350 --> 00:04:51,140
!صحيح. لن تصدّق هذا يا تومو

64
00:04:51,140 --> 00:04:53,310
!أبي عديم الرّحمة

65
00:04:53,310 --> 00:04:56,270
.العديم الرّحمة هي ملابسك ووضعيّتكِ تلك

66
00:04:57,730 --> 00:05:00,900
إذًا فقد تشاجرتِ مع عمّي مجدّدًا وهربتِ؟

67
00:05:00,900 --> 00:05:02,570
.أنتِ لا تتعلّمين أبدًا

68
00:05:02,570 --> 00:05:06,820
!ليس عليك جعل الأمر يبدو كأنّه مصدر إزعاج

69
00:05:06,820 --> 00:05:08,570
!نحن نتشارك صلة العمومة

70
00:05:08,570 --> 00:05:09,700
.كما أنّنا في نفس العمر

71
00:05:09,700 --> 00:05:11,240
،ليس فقط نفس العمر

72
00:05:11,240 --> 00:05:13,830
.بل ووُلدنا في نفس المستشفى ونفس اليوم

73
00:05:13,830 --> 00:05:18,710
!بالنّظر إلى الأمر من تلك النّاحية، نحن حقًّا نتشارك صلة مصيريّة

74
00:05:20,670 --> 00:05:23,090
إذًا، ما القضيّة هذه المرّة؟

75
00:05:23,090 --> 00:05:25,130
أتذكر ما أخبرتك به في رأس السّنة؟

76
00:05:25,130 --> 00:05:27,550
.عندما دخلت إلى الثّانويّة، أنشأت فرقة

77
00:05:27,550 --> 00:05:28,840
.تضمّ الفتيات فقط

78
00:05:29,430 --> 00:05:31,970
.أجل، أذكر أنّكِ قلتِ شيئًا عن ذلك

79
00:05:31,970 --> 00:05:33,850
.مندهشٌ أنّكِ ما زلتِ تواصلين ذلك

80
00:05:33,850 --> 00:05:35,890
!يا للوقاحة

81
00:05:35,890 --> 00:05:38,480
!لن أنسحب منها وأنا لم أُمضِ فيها سنةً كاملةً حتّى

82
00:05:38,480 --> 00:05:43,230
.انسحبتِ من نادي الكرة الطّائرة والدراما وكرة السلّة بعد نصف سنةٍ فقط

83
00:05:43,230 --> 00:05:45,530
.كما أنّكِ أبليتِ حسنًا في بطولاتها المحليّة

84
00:05:45,530 --> 00:05:49,200
.بالتّفكير في الأمر، لا شكّ أنّي عبقريّة

85
00:05:49,200 --> 00:05:53,370
!امتلاككِ لكلّ تلك المواهب ومع ذلك تملّين من كلّ ما تقومين به يغيظني

86
00:05:53,370 --> 00:05:55,660
لماذا نحن مختلفان كثيرًا رغم أنّنا مرتبطان بالدّم؟

87
00:05:55,660 --> 00:05:57,000
.بالفعل

88
00:05:57,000 --> 00:05:59,080
.أنت تتعلّق بالأشياء يا تومو

89
00:05:59,080 --> 00:06:01,670
.كنت مدمنًا على الأنمي والألعاب منذ طفولتنا

90
00:06:02,920 --> 00:06:05,550
.لا أظنّنا على نفس الخطّ

91
00:06:05,550 --> 00:06:07,800
على كلّ، كنّا نتحدّث عن الفرقة، صحيح؟

92
00:06:07,800 --> 00:06:09,010
.صحيح

93
00:06:09,010 --> 00:06:12,050
.عرضنا في المهرجان المدرسيّ أصبح حديث السّاعة

94
00:06:12,050 --> 00:06:14,100
،ثمّ جاء إلينا مستكشف مواهب من صالة موسيقى

95
00:06:14,100 --> 00:06:16,100
... وعندما طلبت من أبي بعض المال للتّأمين

96
00:06:16,100 --> 00:06:19,940
.أجل، أستطيع تخيّل ما حدث بعدها

97
00:06:19,940 --> 00:06:24,530
"!فجّر غضبه عليّ قائلًا، "لم أسمع شيئًا عن هذا

98
00:06:24,530 --> 00:06:26,940
!بالطّبع لن يوافق فقد أخبرته اليوم فحسب

99
00:06:26,940 --> 00:06:29,110
،حسنًا، سمعت ما يكفي

100
00:06:29,110 --> 00:06:30,700
.أيّتها الكائنة الخالية من الهمّ

101
00:06:30,700 --> 00:06:35,290
!لِذا، سأمكث هنا لفترة يا تومو

102
00:06:35,950 --> 00:06:38,710
إذًا، ما قول والديّ عن هذا؟

103
00:06:39,080 --> 00:06:43,340
.قالا أنّه يمكنني البقاء هنا إلى أن تهدأ أعصابنا

104
00:06:43,340 --> 00:06:46,380
!أنتما متساهلان كثيرًا يا أبي ويا أمّي

105
00:06:46,380 --> 00:06:48,340
.رغم أنّهما لم يظهرا من قبل

106
00:06:48,340 --> 00:06:51,720
!كما هو متوقّعٌ من أقربائي

107
00:06:52,390 --> 00:06:54,470
لكن هذا ليس صائبًا، أليس كذلك؟

108
00:06:56,850 --> 00:06:57,980
لماذا؟

109
00:06:57,980 --> 00:07:01,730
.أوّلًا، ملابسكِ الفاضحة غير معقولة

110
00:07:01,730 --> 00:07:05,230
ليس وكأنّ أحدًا سيراني هنا، فما المانع؟

111
00:07:05,230 --> 00:07:07,280
!أنا أراكِ

112
00:07:07,280 --> 00:07:09,650
.أنا فتى في الثّانويّة كما تعلمين

113
00:07:09,650 --> 00:07:11,610
.هذا صحيح

114
00:07:11,610 --> 00:07:15,160
.وحدك يا تومو قادرٌ على رؤيتي هكذا

115
00:07:15,160 --> 00:07:18,040
!هذه أفضليّةٌ لك

116
00:07:18,540 --> 00:07:22,920
!إلهي، أرجوك افعل شيئًا بشأن شعورها المفرط بالقرابة

117
00:07:22,920 --> 00:07:25,710
بماذا تتمتم؟

118
00:07:25,710 --> 00:07:29,670
.إن كان لديك ما تقول، فاستدر وقله بكلّ وضوح

119
00:07:31,680 --> 00:07:33,470
.يستحيل أن أستدير

120
00:07:33,470 --> 00:07:35,890
!ينبغي عليكِ ارتداء ملابس أكثر احتشامًا

121
00:07:39,180 --> 00:07:41,440
،أنصت الآن

122
00:07:41,440 --> 00:07:45,690
إلى متى سأظلّ أقول لك أن تنظر إلى هذه النّاحية؟

123
00:07:47,690 --> 00:07:49,940
—مـ-مهلًا! هـ-هذا

124
00:07:49,940 --> 00:07:52,950
!هيّا، انظر إلى وجهي

125
00:07:52,950 --> 00:07:54,910
!تعلمين أنّي لا أستطيع

126
00:07:54,910 --> 00:07:57,870
!حتّى لو استدرت الآن، فإنّي لا أستطيع

127
00:07:57,870 --> 00:07:59,620
هل استسلمت؟

128
00:08:01,080 --> 00:08:03,790
!كُفّي عن هذا يا ميتشان

129
00:08:11,840 --> 00:08:14,300
.تبدو نعسانًا يا أكي-كُن

130
00:08:14,300 --> 00:08:15,850
.قليلًا

131
00:08:15,850 --> 00:08:19,350
هل تشنّج رقبتك جعلك تعجز عن النّوم؟

132
00:08:19,350 --> 00:08:22,480
.لا، لقد لويتها قبل أن أخلد للنّوم

133
00:08:23,600 --> 00:08:25,060
.ذلك يتطلّب مهارة

134
00:08:25,060 --> 00:08:26,610
.أعتقد ذلك

135
00:08:34,450 --> 00:08:36,870
.لا ترهق نفسك يا أخلاقيّ-كُن

136
00:08:36,870 --> 00:08:37,910
ماذا؟

137
00:08:37,910 --> 00:08:42,160
.شغفك بصناعة هذه اللّعبة بلغنا بالفعل

138
00:08:42,160 --> 00:08:46,540
.لكن إن أضررت بصحّتك، فستخسر كلّ شيء

139
00:08:47,380 --> 00:08:50,500
ما هذا التّبديل العرضيّ المثاليّ للأماكن؟

140
00:08:50,500 --> 00:08:51,760
.تبادل معي

141
00:08:51,760 --> 00:08:55,130
.سأنجز عنك عملك اليوم

142
00:08:55,840 --> 00:08:57,890
.لا، لا أستطيع

143
00:08:57,890 --> 00:09:00,970
.لقد أنهيتِ السّيناريو يا سينباي

144
00:09:00,970 --> 00:09:02,640
.دعي الباقي عليّ

145
00:09:02,640 --> 00:09:05,640
...لكن يا أخلاقيّ-كُن، إن واصلت على هذا الحال

146
00:09:06,060 --> 00:09:11,480
لكنّكِ يا سينباي قضيتِ وقتًا طويلًا في
.كتابة السّيناريو لدرجة أنّكِ أجلّتِ روايتكِ

147
00:09:12,320 --> 00:09:14,650
.لا يمكنني إزعاجكِ أكثر من هذا

148
00:09:14,650 --> 00:09:19,160
.على هذا المعدّل، سأخرّب مسيرتكِ ككاتبة

149
00:09:19,160 --> 00:09:20,530
أ-أخلاقيّ-كُن؟

150
00:09:20,530 --> 00:09:24,330
.لن أستطيع التّكفير عن ذلك أبدًا

151
00:09:25,790 --> 00:09:28,420
.كرّر ما قلته يا تومويا-كُن

152
00:09:27,830 --> 00:09:31,670
.آسف، لا أتذكّر حتّى ما كنت أقوله

153
00:09:28,420 --> 00:09:30,130
!كـ-كاتو-سان

154
00:09:30,130 --> 00:09:31,670
كيف أسجّل بهذا الشّيء؟

155
00:09:31,670 --> 00:09:32,590
!أسرعي

156
00:09:36,840 --> 00:09:41,510
لقد تجاهلتِ كلّيًّا وجودي هنا، أليس كذلك يا كاسوميغاوكا أوتاها؟

157
00:09:42,010 --> 00:09:44,430
،كنتُ أتجاهلكِ في البداية

158
00:09:44,430 --> 00:09:47,350
.لكن بعدها نسيت أمركِ كليًّا

159
00:09:47,350 --> 00:09:51,110
هل ستكون هذه الملامح مناسبةً أكثر هنا؟

160
00:09:51,110 --> 00:09:55,360
.لكن في هذا المشهد يذهب البطل لمقابلة بطلةٍ أخرى

161
00:09:55,360 --> 00:09:58,950
.حسنًا، ذلك ما يبدو من منظور كاتبة السّيناريو

162
00:09:58,950 --> 00:10:01,990
!مهلًا، أنتِ قريبةٌ جدًا يا ساوامورا-سان

163
00:10:01,990 --> 00:10:03,490
!أُصمتي

164
00:10:03,490 --> 00:10:06,290
!الزمي الصّمت هناك أيّتها الغاوية المتآمرة

165
00:10:08,290 --> 00:10:10,500
،كـ-ما كنتُ أقول

166
00:10:10,500 --> 00:10:14,550
ألا يجدر أن تكون ملامحها هنا أكثر حزنًا بقليل؟

167
00:10:14,960 --> 00:10:16,420
.ربّما

168
00:10:16,420 --> 00:10:19,550
بالمناسبة، ما الّذي تفعلانه؟

169
00:10:19,550 --> 00:10:21,550
.إنّها تسمّى البرمجة

170
00:10:21,550 --> 00:10:24,930
.إنّها صيغة برمجةٍ بسيطة  تعمل عليها الألعاب

171
00:10:24,930 --> 00:10:30,060
.تقول أنّها بسيطة، لكنّك تدرسها من مثل هذا الكتاب السّميك

172
00:10:30,860 --> 00:10:33,070
.لأنّي مبتدئ

173
00:10:35,900 --> 00:10:40,070
،حسنٌ، أعلم القليل عن البرمجة
.لِذا يمكنني مساعدتك إذا احتجت لذلك

174
00:10:40,070 --> 00:10:42,740
،لم تكملي رسوماتكِ حتّى

175
00:10:42,740 --> 00:10:44,990
وتنوين مساعدة أخلاقيّ-كُن؟

176
00:10:44,990 --> 00:10:49,710
.أظنّ أنكِ تكنّين له الكثير من الحبّ—أقصد التّقدير

177
00:10:49,710 --> 00:10:56,840
لا أريد سماع هذا من روائيّةٍ أهملت أعمالها الأخرى
.لاهتمامها برجل—أقصد سيناريو

178
00:10:56,840 --> 00:11:00,050
!كفاكما من هذا العداء الأشبه بالمصارعة المحترفة

179
00:11:03,050 --> 00:11:04,260
،إذًا

180
00:11:04,260 --> 00:11:06,930
.يبدو أنّ الموسيقى هي كلّ ما تبقّى الآن

181
00:11:07,350 --> 00:11:10,440
.وهذه أكبر مشكلة

182
00:11:10,440 --> 00:11:12,900
ستضاف إليها الموسيقى؟

183
00:11:12,900 --> 00:11:13,940
!هذا مذهل

184
00:11:14,440 --> 00:11:18,150
.لا وجود لألعابٍ تخلوا من الموسيقى التصويريّة في يومنا الحاضر

185
00:11:18,150 --> 00:11:22,320
مرّت عقودٌ على الوقت الّذي كانت فيه أصوات
.الطّنين والرّنين كافيةً لإسعاد النّاس

186
00:11:22,320 --> 00:11:26,790
.كما أنّ قوّة الموسيقى لا غنى عنها في بناء الذّروة

187
00:11:26,790 --> 00:11:28,080
!هذا صحيح

188
00:11:28,080 --> 00:11:29,870
،مع موسيقى تصويريّة جيّدة

189
00:11:29,870 --> 00:11:33,250
.يمكنكِ تخيّل المشهد بمجرّد سماع الموسيقى

190
00:11:33,250 --> 00:11:37,050
.لكنّك لم تجد بعد ذلك العضو المهمّ الّذي سيعمل على الموسيقى

191
00:11:37,050 --> 00:11:39,880
.نحن بالفعل نملك منتجًا عديم الكفاءة

192
00:11:54,270 --> 00:11:57,400
.آسفة، لم أستطع منع نفسي من النّظر

193
00:11:57,400 --> 00:11:59,400
كـ-كاتو؟

194
00:11:59,400 --> 00:12:01,700
.لكن لا تقلق

195
00:12:01,700 --> 00:12:08,620
.لن أخبر أحدًا عن من أرسل البريد أو عن محتواه

196
00:12:08,620 --> 00:12:10,120
.سيكون ذلك تصرّفًا مشينًا

197
00:12:10,960 --> 00:12:13,170
هل رأيتِ كلّ شيء؟

198
00:12:14,330 --> 00:12:15,250
.أجل

199
00:12:15,250 --> 00:12:16,790
رأيتِ ماذا؟

200
00:12:26,550 --> 00:12:29,770
.إذًا فهي ابنة عمّك يا أخلاقيّ-كُن

201
00:12:29,770 --> 00:12:32,180
هذه المسمّاة ميتشيرو-سان؟

202
00:12:32,180 --> 00:12:33,940
.أ-أجل

203
00:12:33,940 --> 00:12:36,940
وهي في منزلك الآن؟

204
00:12:36,940 --> 00:12:40,820
.بيدو أنّها تشاجرت مع عائلتها وهربت من المنزل

205
00:12:40,820 --> 00:12:42,190
.فهمت

206
00:12:42,190 --> 00:12:43,950
،بعبارةٍ أخرى يا أخلاقيّ-كُن

207
00:12:43,950 --> 00:12:48,030
أنت الآن تعيش مع ابنة عمّك الّتي هي بنفس عمرك؟

208
00:12:48,030 --> 00:12:49,330
...يعيشان معًا

209
00:12:49,330 --> 00:12:50,660
!تحت السّقف نفسه

210
00:12:50,660 --> 00:12:52,410
!يصادفان بعضهما في الحمّام

211
00:12:52,410 --> 00:12:55,040
أيعقل أنّ ذلك الحدث المنحرف العرضيّ كان عن تجربةٍ حقيقيّة؟

212
00:12:55,040 --> 00:12:56,750
!كلّا، إنّها محض مصادفة

213
00:12:57,670 --> 00:12:59,800
...إلى أن حدث ذلك

214
00:13:01,050 --> 00:13:02,550
إلى أن حدث ذلك؟

215
00:13:02,550 --> 00:13:04,720
...حـ-حسنٌ

216
00:13:04,720 --> 00:13:07,800
.يبدو أنّك ما زلت تخفي عنّا الكثير

217
00:13:07,800 --> 00:13:11,770
على كلّ، هلّا أخبرتنا بكلّ ما حدث ولم يحدث؟

218
00:13:11,770 --> 00:13:14,810
.لا أعتقد أنّ بإمكاني إخباركِ بما لم يحدث

219
00:13:17,100 --> 00:13:18,690
ماذا قلت؟

220
00:13:18,690 --> 00:13:22,650
أنت وابنة عمّك تلك ولدتما في نفس اليوم ونفس المكان؟

221
00:13:22,650 --> 00:13:26,490
.كانت هناك مصحّة توليد بالقرب من منزل عائلتنا في ناغانو

222
00:13:26,490 --> 00:13:28,740
،جميع أفراد عائلتنا ولدوا هناك

223
00:13:28,740 --> 00:13:31,580
.ومن ثمّ يُعتنى بهم في منزل العائلة لبعض الوقت

224
00:13:31,580 --> 00:13:36,420
.إذًا فأنتما صديقا طفولة ليس فقط منذ نعومة أظافركما بل منذ الولادة

225
00:13:39,000 --> 00:13:42,800
،ومن حينها في كلّ عطلةٍ صيفيّة وشتويّة

226
00:13:42,800 --> 00:13:45,470
.تُمضيان الوقت معًا في ذلك المنزل

227
00:13:45,470 --> 00:13:47,970
!أقرباؤنا الآخرون كانوا هناك أيضًا

228
00:13:47,970 --> 00:13:50,550
،تجوبان التّلال والجبال معًا

229
00:13:50,550 --> 00:13:54,480
...تمضيان الوقت وحدكما في كهفٍ سرّيّ اكتشفتماه

230
00:13:54,480 --> 00:13:58,350
.حسنٌ، ليس هناك أحدٌ غيرها في عائلتي يقربني في العمر

231
00:13:59,310 --> 00:14:01,320
إذًا فقد فعلتماها، أليس كذلك؟

232
00:14:03,820 --> 00:14:06,110
،في اللّيل، تدخلان إلى الحمّام معًا

233
00:14:06,110 --> 00:14:09,700
...وتعاينان الاختلافات بين جسد الذّكر والأنثى

234
00:14:09,700 --> 00:14:10,450
!مهلًا

235
00:14:10,450 --> 00:14:12,740
!تلك الصّورة حيّةٌ بشكلٍ مبالغ

236
00:14:14,500 --> 00:14:18,330
هذا يجعلها صديقة طفولة أخلاقيّ-كُن الأصليّة

237
00:14:18,330 --> 00:14:21,040
.الّتي تعلوا على جميع أصدقاء الطّفولة الآخرين

238
00:14:21,040 --> 00:14:25,510
.هذه العلاقة المميّزة تجعل أصدقاء الطّفولة الآخرين يبدون كتقليدٍ رخيص

239
00:14:25,510 --> 00:14:28,630
!لـ-لحظة، أنتِ تبالغين في الأمر

240
00:14:32,850 --> 00:14:35,350
هل أنتِ بخيرٍ يا ساوامورا-سان؟

241
00:14:36,270 --> 00:14:38,850
...تقليد رخيص

242
00:14:38,850 --> 00:14:42,060
.يبدو أنّها نالت كفايتها لهذا اليوم

243
00:14:53,370 --> 00:14:55,870
!هيّا استيقظي يا ميتشيرو

244
00:15:00,370 --> 00:15:04,380
.لقد تأخّرت يا تومو

245
00:15:04,380 --> 00:15:06,760
.كان لديّ اجتماعٌ للمجموعة

246
00:15:09,420 --> 00:15:11,340
!انظر إلى هذا

247
00:15:11,340 --> 00:15:14,180
!وصل غيتاري أخيرًا

248
00:15:14,180 --> 00:15:18,180
!عدت إلى المنزل البارحة وأرسلت مجموعةً من الأغراض إلى هنا

249
00:15:18,180 --> 00:15:20,230
.بشأن ذلك يا ميتشيرو

250
00:15:20,230 --> 00:15:22,190
—إلى متى تنوين البقاء هنا

251
00:15:28,990 --> 00:15:31,660
انتظري لحظة، ما الّذي يعينه هذا؟

252
00:15:32,160 --> 00:15:35,780
.حسنًا، هذه الغرفة كانت في فوضى عارمة

253
00:15:35,780 --> 00:15:39,790
.ولم تكن تتّسع لأغراضي، لِذا قمت ببعض التّنظيف

254
00:15:39,790 --> 00:15:41,040
!ماذا عن كنوزي؟

255
00:15:41,040 --> 00:15:42,620
!لا تقلق حيالها

256
00:15:42,620 --> 00:15:45,170
وضعتها في أكياس قمامة وتركتها في غرفة المعيشة

257
00:15:45,170 --> 00:15:48,170
.لتكون جاهزةً لتأخذها شاحنات النّفايات نهاية الأسبوع

258
00:15:54,340 --> 00:15:55,300
!أنا آسف

259
00:15:55,300 --> 00:15:57,810
!سامحنني يا بطلاتي

260
00:15:57,810 --> 00:15:58,970
!لا شكّ أنّكنّ تألّمتنّ

261
00:15:58,970 --> 00:16:00,310
!لا شكّ أنكنّ عانيتنّ

262
00:16:00,310 --> 00:16:02,390
.آسفة، آسفة

263
00:16:02,390 --> 00:16:05,110
.لم أكن أدري أنّهنّ يعنين لك الكثير

264
00:16:05,110 --> 00:16:06,060
!اخرجي من هنا

265
00:16:06,060 --> 00:16:07,940
!عودي إلى منزلكِ فورًا

266
00:16:07,940 --> 00:16:11,530
.لا داعي لأن تكون قاسيًا معي

267
00:16:11,530 --> 00:16:13,200
!ظننت أنّنا رفيقان

268
00:16:13,200 --> 00:16:17,030
أتلقين بممتلكات رفيقكِ في القمامة؟

269
00:16:17,030 --> 00:16:20,660
.لكن هذا يحدث دائمًا بين الأزواج أيضًا

270
00:16:20,660 --> 00:16:24,420
.تلقي الزّوجة أشياء متعلّقة بهواية زوجها وما إلى ذلك

271
00:16:24,420 --> 00:16:27,040
!كما لو أنّي سأكون طرفًا في مثل ذلك الزّواج التّعيس

272
00:16:27,040 --> 00:16:30,170
.لكن هذه فرصةٌ جيّدةٌ لك

273
00:16:30,170 --> 00:16:32,840
ألا تظنّ أنّ الوقت حان لتتخلّى عن أغراض الأوتاكو التّافهة هذه؟

274
00:16:32,840 --> 00:16:33,800
ماذا تنعتين بـ"التّافه"؟

275
00:16:34,180 --> 00:16:37,180
ما رأيك أن أعرّفك بفتاة؟

276
00:16:37,180 --> 00:16:40,680
!أنا أرتاد مدرسة فتيات، لِذا لديك الكثير لتختار من بينهنّ

277
00:16:40,680 --> 00:16:42,350
.كفاكِ من هذا الهراء

278
00:16:42,350 --> 00:16:45,810
!كما لو أنّ فتاةً حقيقيّة وليست أوتاكو ستقبل بمصاحبتي

279
00:16:46,940 --> 00:16:48,730
.أتساءل

280
00:16:48,730 --> 00:16:51,820
.أظنّك ستكون حتمًا شعبيًّا إن تصرّفت بشكلٍ طبيعيّ

281
00:16:52,490 --> 00:16:54,820
.أنتِ منحازةٌ لي لكونكِ من أقاربي فحسب

282
00:16:54,820 --> 00:16:58,830
...كما أنّ المعدّلات في مدرستنا نوعًا ما، حسنٌ

283
00:16:58,830 --> 00:17:02,660
.لِذا مجرّد ذكر فتيان ثانويّة تويوغاساكي يجذب انتباه العديد من الفتيات

284
00:17:03,830 --> 00:17:04,750
حقًّا؟

285
00:17:04,750 --> 00:17:05,960
!أجل

286
00:17:05,960 --> 00:17:08,750
!حسنًا، سأعدّ لموعدٍ جماعيّ في الحال

287
00:17:08,750 --> 00:17:10,380
!لا يمكنكِ خداعي

288
00:17:10,380 --> 00:17:13,340
!تحتاجين لأكثر من ذلك لجعي أتخلّى عن كوني أوتاكو

289
00:17:13,340 --> 00:17:15,470
لماذا؟

290
00:17:15,470 --> 00:17:19,220
.التسكّع مع الفتيات أكثر متعة

291
00:17:19,640 --> 00:17:23,600
تقولين هذا، لكنّكِ في الواقع لا تملكين خليلًا، صحيح؟

292
00:17:23,600 --> 00:17:25,270
...حـ-حسنًا، هذا بسبب

293
00:17:25,270 --> 00:17:29,860
كلّ ما في الأمر أنّ تركيزي منصبّ على فرقتي
.والرّومنسيّة شيءٌ ثانويّ بالنّسبة لي حاليًا

294
00:17:30,520 --> 00:17:32,110
.الأمر نفسه بالنّسبة لي

295
00:17:32,990 --> 00:17:35,780
.لديّ حلمٌ كبيرٌ أيضًا

296
00:17:35,780 --> 00:17:37,110
،وإلى أن أجعل من حلمي حقيقة

297
00:17:37,530 --> 00:17:39,910
.لا أستطيع التخلّي عن حياة الأوتاكو

298
00:17:40,490 --> 00:17:42,370
أيّ حلمٍ يكون؟

299
00:17:42,910 --> 00:17:44,750
.سؤالٌ وجيه

300
00:17:44,750 --> 00:17:48,380
حلمي أن أصنع أفضل لعبة محاكاة مواعدة تصوّرتها

301
00:17:48,380 --> 00:17:53,380
!رفقة أفضل طاقم عملٍ جمعته

302
00:17:54,460 --> 00:17:57,550
.سمعت أنّه لا مستقبل لصناعة ألعاب محاكاة المواعدة

303
00:17:57,550 --> 00:17:59,050
أين سمعتِ ذلك؟

304
00:17:59,050 --> 00:18:00,800
!أعني، هذا ليس صحيحًا

305
00:18:00,800 --> 00:18:03,270
أنت لا تنوي امتهان ذلك، صحيح؟

306
00:18:03,270 --> 00:18:05,890
.عليك التّفكير بمستقبلك

307
00:18:05,890 --> 00:18:08,150
.لا يمكنك كسب لقمة العيش بهواياتك وحدها

308
00:18:08,150 --> 00:18:10,770
!وهل أنتِ أمّي؟

309
00:18:10,770 --> 00:18:13,110
ألم تقل لك عمّتي شيئًا؟

310
00:18:13,110 --> 00:18:15,570
.لديك سنةٌ واحدةٌ فحسب لتقرّر ما ستفعله

311
00:18:15,570 --> 00:18:18,030
أتريد حقًّا أن تكون بهذا الاستهتار؟

312
00:18:18,030 --> 00:18:22,080
!لا يحقّ لابنةٍ هاربة قول ذلك لي

313
00:18:23,040 --> 00:18:24,790
.وهذه هنا

314
00:18:26,750 --> 00:18:28,170
!بوركت جهودك

315
00:18:28,170 --> 00:18:30,750
ومن دفعني لفعل هذا برأيكِ؟

316
00:18:29,290 --> 00:18:30,750
!إنّك تتصبّب عرقًا

317
00:18:30,750 --> 00:18:32,040
.اذهب للاستحمام

318
00:18:32,040 --> 00:18:34,050
!لا حاجة لأن تخبريني لأفعلها

319
00:18:34,050 --> 00:18:35,880
!وهذا منزلي لعلمكِ

320
00:18:35,880 --> 00:18:37,420
!استمتع

321
00:18:37,420 --> 00:18:38,220
.أنصتي

322
00:18:38,220 --> 00:18:39,630
،لا أمانع إن عزفتِ على غيتاركِ

323
00:18:39,630 --> 00:18:41,600
.لكن إيّاكِ أن تصليه بمضخّم الصّوت

324
00:18:41,600 --> 00:18:43,140
.لأنّكِ ستزعجين الجيران

325
00:18:43,140 --> 00:18:45,640
!أعلم ذلك

326
00:18:52,310 --> 00:18:53,650
!لقد اكتفيت من هذا

327
00:18:54,320 --> 00:18:57,900
!مهما تطلّب الأمر، سأتّصل بعمّي وأطلب منه المجيء واصطحابها

328
00:18:57,900 --> 00:19:00,820
.لا ضغائن بيننا يا ميتشيرو

329
00:19:13,040 --> 00:19:14,090
!حسنًا

330
00:19:21,260 --> 00:19:22,340
!تلك الفتاة

331
00:19:22,340 --> 00:19:24,510
!أخبرتها أن لا توصله بمضخّم الصّوت

332
00:19:26,970 --> 00:19:30,100
!أوقفي تلك الضجّة يا ميتشيرو

333
00:19:30,480 --> 00:19:32,100
عن أيّ فرقةٍ تتحدّثين؟

334
00:19:32,100 --> 00:19:33,400
عن أيّ حفلاتٍ موسيقيّة تتحدّثين؟

335
00:19:33,980 --> 00:19:36,360
!هذا محض ضجيج

336
00:20:49,510 --> 00:20:50,850
تومو؟

337
00:20:54,310 --> 00:20:55,690
...حسنٌ

338
00:20:56,270 --> 00:20:57,810
...كنتُ فقط

339
00:20:59,650 --> 00:21:01,110
.آسفة

340
00:21:03,070 --> 00:21:03,860
.ميتشيرو

341
00:21:04,320 --> 00:21:07,490
هلّا انضممتِ إليّ لصنع لعبة محاكاة المواعدة المثاليّة؟

342
00:21:09,160 --> 00:21:09,990
ماذا؟