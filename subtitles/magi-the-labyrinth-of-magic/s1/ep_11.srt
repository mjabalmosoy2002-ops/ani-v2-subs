1
00:00:19,750 --> 00:00:21,750
!يا لها من قوة هائلة

2
00:00:24,240 --> 00:00:25,600
!أوغو

3
00:00:30,550 --> 00:00:32,720
!كلّا يا أوغو

4
00:00:32,720 --> 00:00:34,940
!هذا نذير سوء، ليتراجع الجميع في الحال

5
00:00:51,760 --> 00:00:53,280
هل أنت على ما يرام؟

6
00:00:53,800 --> 00:00:55,380
!مور

7
00:00:55,380 --> 00:00:57,290
.شكرًا لإنقاذي

8
00:00:58,280 --> 00:00:59,870
ماذا عن حزب الضباب؟

9
00:00:59,870 --> 00:01:01,080
.إنّهم بخير

10
00:01:02,050 --> 00:01:05,790
.لم يتعرض أيّ شخص لمكروه بفضل السيّد سندباد

11
00:01:05,790 --> 00:01:10,220
.فالجميع قد نجا بفضل تحذيره السريع

12
00:01:12,910 --> 00:01:15,550
...ولكن ذلك الشاب هناك

13
00:01:24,520 --> 00:01:28,030
ماذا دهى أوغو يا علاء الدين؟

14
00:01:28,030 --> 00:01:30,920
.إنّه يتصرّف وفق إرادته

15
00:01:31,600 --> 00:01:36,310
.لا أعلم، لم أره في هذه الحالة قطّ

16
00:01:40,630 --> 00:01:44,370
عجبًا، ما خطب ذلك المسخ؟

17
00:03:23,490 --> 00:03:28,350
.لقد تنمّر على جودل اللطيف

18
00:03:28,350 --> 00:03:31,440
.ولكنّنا وصلنا في الوقت المناسب

19
00:03:31,440 --> 00:03:33,610
.لا سيّما وأنّه يعاني من إصاباتٍ بليغة

20
00:03:33,610 --> 00:03:37,320
.ينبغي عليك إجادة معالجته يا كا كوبون

21
00:03:37,320 --> 00:03:39,360
.فسلامته ليست موضع جدل

22
00:03:39,360 --> 00:03:42,140
.أعلم هذا يا صاحبة السموّ

23
00:03:42,140 --> 00:03:46,700
.إنّ حياة سيّدنا الكاهن مهمة جدًا

24
00:03:46,700 --> 00:03:47,710
!سن

25
00:03:47,710 --> 00:03:50,920
.أجل، إنّهم من إمبراطورية كو

26
00:03:50,920 --> 00:03:52,420
إمبراطورية كو؟

27
00:03:53,050 --> 00:03:56,920
.ومن الظاهر أنّهم يتمتَّعون بكفاءةٍ عاليةٍ في استغلال المعدّات السحريّة

28
00:03:56,920 --> 00:03:58,930
.إنّهم على قدرٍ من التَّمرُّس

29
00:03:58,930 --> 00:04:01,260
ولكن إلى أيّ حدّ؟

30
00:04:02,930 --> 00:04:06,860
ماذا الآن؟ ألا زال ذلك المسخ عازمًا على العراك؟

31
00:04:06,860 --> 00:04:08,180
.يبدو ذلك مشوِّقًا

32
00:04:08,180 --> 00:04:10,690
.في هذه الحالة سأتصدى له بنفسي

33
00:04:10,690 --> 00:04:13,420
.رجاءً توخّي الحذر سموّكِ

34
00:04:13,420 --> 00:04:15,450
.لا تقلق أنا لها

35
00:04:15,450 --> 00:04:17,400
.حريٌ بكَ أنْ تبدأ في معالجته

36
00:04:17,400 --> 00:04:18,150
.أمركِ

37
00:04:19,710 --> 00:04:22,080
.يا روح الشّجن والعزلة

38
00:04:22,080 --> 00:04:24,490
.أنا آمرك بصفتي سيّدتك

39
00:04:25,260 --> 00:04:27,010
.سخِّر بقوّتك ما أمتلك من الماغوي

40
00:04:27,010 --> 00:04:30,250
.واتخذه وسيلة لتحقيق رغبتي

41
00:04:30,720 --> 00:04:32,370
!تجلَّ بقوّتك يا ڤنيا

42
00:04:37,320 --> 00:04:39,300
!لقد تسلّحت بالحاوية

43
00:04:39,300 --> 00:04:40,770
!ها أنا ذا

44
00:04:45,430 --> 00:04:46,470
.الحرارة

45
00:04:46,470 --> 00:04:49,930
.إنّه يبخّر الماء من حولي بهذه الحرارة

46
00:04:49,930 --> 00:04:51,850
!لن تنجو بفعلتك

47
00:05:01,020 --> 00:05:01,990
ما هذا الشيء؟

48
00:05:16,450 --> 00:05:17,390
!أوغو

49
00:05:26,390 --> 00:05:28,160
ما رأيك يا كا كوبون؟

50
00:05:28,160 --> 00:05:30,800
.إنّك مذهلة كما المعتاد سموّكِ

51
00:05:30,800 --> 00:05:32,640
كيف حال عزيزي جودل؟

52
00:05:32,640 --> 00:05:35,380
.إنّي أُخضعه للتداوي الطارئ بأقصى ما أستطيع

53
00:05:35,380 --> 00:05:38,650
.ولكنّي بحاجة معدّاتٍ مساندة حتّى يتسنَّى لي معالجته تمامًا

54
00:05:38,650 --> 00:05:40,690
.إذن علينا أن نسرع

55
00:05:45,260 --> 00:05:46,940
ما خطبك يا هذا؟

56
00:05:46,940 --> 00:05:51,000
.كلّ ما فعلنا هو إنقاذ أحد رفاقنا الّذي كان يتعرض لأذية ذلك المسخ

57
00:05:51,000 --> 00:05:56,250
.ليس صحيحًا، اوغو كان يحاول حمايتي والجميع هنا

58
00:05:56,250 --> 00:05:58,840
!رفيقكم هو الّذي تعرض لنا بالأذية

59
00:05:58,840 --> 00:06:00,170
حقًا؟

60
00:06:00,560 --> 00:06:01,030
...إذن

61
00:06:01,680 --> 00:06:04,010
أَهذا يعني أنّك سيّد ذلك المسخ؟

62
00:06:05,340 --> 00:06:08,200
وهل جميع من بالأسفل هناك هم رفاقه؟

63
00:06:08,850 --> 00:06:12,510
.عليكم بهم يا انشين وانتاي وانغي

64
00:06:21,750 --> 00:06:23,440
من يكون هؤلاء؟

65
00:06:23,440 --> 00:06:26,200
.أنا سأتولّى أمر هذا الصبيّ

66
00:06:26,200 --> 00:06:28,950
.أما ثلاثتكم فاقضوا على جميع أولئك الحثالة

67
00:06:30,620 --> 00:06:31,850
ما الّذي يحدث؟

68
00:06:31,850 --> 00:06:32,910
!النجدة

69
00:06:33,370 --> 00:06:35,040
!تصدّ له يا مسرور

70
00:06:38,530 --> 00:06:40,750
إنّه ندُّ لمسرور؟

71
00:06:40,750 --> 00:06:43,000
...لابدّ وأنّ هؤلاء الثلاثة هم

72
00:06:45,790 --> 00:06:47,630
!لا يسعني ردعه، إنّه سريعٌ للغاية

73
00:06:48,930 --> 00:06:50,170
!مرجانة

74
00:06:50,170 --> 00:06:52,300
.ساعدي في إخلاء النَّاس

75
00:06:52,300 --> 00:06:52,930
!حسنٌ

76
00:06:52,930 --> 00:06:54,870
!ليتراجع الجميع

77
00:06:59,940 --> 00:07:02,820
.لا بأس بمهارتك في المبارزة

78
00:07:03,230 --> 00:07:04,980
.دعنا نتبارى

79
00:07:04,980 --> 00:07:07,740
!إنّه خبير

80
00:07:09,860 --> 00:07:11,740
.إنّهم يستمتعون

81
00:07:11,740 --> 00:07:14,770
.والآن سأحظى بحصّتي من المرح

82
00:07:15,580 --> 00:07:18,130
.يا روح الشّجن والعزلة

83
00:07:18,130 --> 00:07:19,760
.أنا آمرك

84
00:07:19,760 --> 00:07:23,240
.أنْ تدخل جسدي، أنْ تتلبس جسدي

85
00:07:23,900 --> 00:07:25,260
ما الّذي يحدث لها؟

86
00:07:25,260 --> 00:07:28,750
!حوّل جسدي بقوّتك العظيمة يا ڤنيا

87
00:07:32,550 --> 00:07:34,850
.لا تفعلي هذا يا آنسة

88
00:07:34,850 --> 00:07:36,810
ماذا تحسب نفسك فاعلًا؟

89
00:07:36,810 --> 00:07:39,270
!لقد انفسخ تحوّلي

90
00:07:41,060 --> 00:07:44,760
.لابدّ وأنّكِ من أميرات الإمبراطورية بالحكم من مظهركِ

91
00:07:44,760 --> 00:07:46,440
من تكون؟

92
00:07:47,400 --> 00:07:53,240
.أنا سندباد ملك سندريا

93
00:07:55,920 --> 00:07:59,580
أنت السندباد؟

94
00:08:00,970 --> 00:08:03,280
لمتى ستظلّ قابضًا يدي؟

95
00:08:04,210 --> 00:08:06,150
.أرجو المعذرة يا صاحبة السموّ

96
00:08:06,150 --> 00:08:11,100
ولكن أَلا تعتقدين أنّ الانخراط في شِجار غير لائقٍ بالّذين في منزلتنا؟

97
00:08:11,100 --> 00:08:12,730
...ولكن ذلك الصبيّ قد

98
00:08:13,140 --> 00:08:16,720
هلّا تنازلت عن موقفك يا علاء الدين؟

99
00:08:17,250 --> 00:08:20,640
.لا تقلق، فالجنّ لا يموتون بسهولة

100
00:08:20,640 --> 00:08:22,720
.لا زال صديقك على قيد الحياة

101
00:08:22,720 --> 00:08:26,140
.لا تدع الغضب يُعْمِي بصيرتك

102
00:08:29,580 --> 00:08:34,700
.إنّي موجودٌ في هذه البلاد لأسبابٍ معيّنة يا حضرة الأميرة

103
00:08:34,700 --> 00:08:38,780
.إنْ كنتِ كذلك أيضًا، فحبّذا لو نجتمع في مقرٍّ ملائم

104
00:08:38,780 --> 00:08:40,040
.فهمت

105
00:08:40,040 --> 00:08:40,750
.أيّها الجميع

106
00:08:40,750 --> 00:08:42,000
نعم؟

107
00:08:42,000 --> 00:08:43,400
.نحن مغادرون

108
00:08:43,400 --> 00:08:44,500
...ولكن سموّكِ

109
00:08:44,500 --> 00:08:46,880
!هيّا تحضّروا للمغادرة

110
00:08:49,510 --> 00:08:54,130
.اسمع، اِعلم أنّني لستُ مغادرة بناءً على طلبك

111
00:08:59,590 --> 00:09:01,380
.لقد رحلوا

112
00:09:02,230 --> 00:09:03,880
.حمدًا لله

113
00:09:04,840 --> 00:09:06,270
هل من أحدٍ مصاب؟

114
00:09:10,410 --> 00:09:13,530
.لقد اختفى أثر أوغو

115
00:09:15,340 --> 00:09:18,120
!عليّ إمداده بمزيدٍ من القوة

116
00:09:31,920 --> 00:09:32,780
.سن

117
00:09:32,780 --> 00:09:34,840
ما الأوضاع يا جعفر؟

118
00:09:34,840 --> 00:09:37,640
.لا وجود لأيّة حالاتٍ حرجة

119
00:09:37,640 --> 00:09:40,680
.هذا جيّد، لنباشر بمداوة الجرحى الآن

120
00:09:40,680 --> 00:09:41,880
.ثمّ نستجمع شملنا

121
00:09:41,880 --> 00:09:43,020
.المعذرة

122
00:09:43,020 --> 00:09:45,240
.جمعت بعضًا من المحارم القماشية

123
00:09:45,240 --> 00:09:47,900
.ووفرت المياه للمحتاجين

124
00:09:47,900 --> 00:09:50,700
.أشكركِ، حبّذا لو تستريحين الآن

125
00:09:50,700 --> 00:09:51,550
.كلّا

126
00:09:53,550 --> 00:09:55,920
.سأذهب لمداوة الجرحى الآن

127
00:09:57,870 --> 00:10:00,000
.إنّ مرجانة صبيّة رقيقة القلب

128
00:10:00,000 --> 00:10:01,620
.إنّها حازمة ولكنها حنونة

129
00:10:01,620 --> 00:10:06,710
.أجل، كما أنّها صبيّة يقظة ومجدّة

130
00:10:06,710 --> 00:10:08,300
هل أنت بخير؟

131
00:10:08,300 --> 00:10:10,080
.نعم، أشكركِ

132
00:10:11,180 --> 00:10:12,380
.يا للخيبة

133
00:10:13,500 --> 00:10:16,070
...كم أرغب في ردّ جميلهما

134
00:10:17,740 --> 00:10:19,770
.قبل رحيلي لموطني

135
00:10:19,770 --> 00:10:22,090
.ولكن لا يسعني فعل أيّ شيء

136
00:10:24,950 --> 00:10:28,400
تبًا، ما خطبي؟

137
00:10:32,400 --> 00:10:35,560
!لقد تعرضوا للأذية ولم يكن بوسعي حمايتهم

138
00:10:35,560 --> 00:10:40,930
ما الجدوى من اِمتلاك حاوية إنْ كنتُ لا أُحسن استخدامها؟

139
00:10:40,930 --> 00:10:43,830
!إنّي حقًا بائس الحال وهذا يثير حنقي

140
00:10:43,830 --> 00:10:46,520
!لا أمتلك وقتًا للتماثل للشفاء

141
00:10:46,520 --> 00:10:48,790
تبًا، كيف أُصبت بهذا الجرح؟

142
00:10:48,790 --> 00:10:50,440
وهذا؟

143
00:10:50,440 --> 00:10:51,680
وهذا أيضًا؟

144
00:10:51,680 --> 00:10:52,860
.علي بابا

145
00:10:52,860 --> 00:10:54,800
كيف حالك الآن؟

146
00:11:00,570 --> 00:11:02,220
ماذا تفعل؟

147
00:11:02,220 --> 00:11:05,100
.إنّي أتفقّد جراحي

148
00:11:06,550 --> 00:11:07,850
...جديًا

149
00:11:07,850 --> 00:11:10,920
.لا بأس في طلب المساعدة لمداواة جراحك

150
00:11:10,920 --> 00:11:12,970
.إنّها جراحٌ بسيطة

151
00:11:12,970 --> 00:11:16,600
.أريد تضميدها على عجلٍ حتّى أستطيع المساعدة مع الآخرين

152
00:11:16,600 --> 00:11:18,860
هذا صحيح، كيف حال علاء الدين؟

153
00:11:19,920 --> 00:11:22,360
.لقد طلب أنْ يكون بمفرده

154
00:11:22,360 --> 00:11:24,500
.يبدو عليه الاستياء

155
00:11:24,500 --> 00:11:26,920
.أظنّ أنّه قلقٌ حيال اِختفاء أوغو

156
00:11:26,920 --> 00:11:29,820
.لا أعتقد أنّ هذا ما يشغل باله فحسب

157
00:11:29,820 --> 00:11:34,970
إنْ أسرف علاء الدين في استخدام تلك القوة الغامضة
.فسيكون ذلك على حساب قواه البدنية

158
00:11:34,970 --> 00:11:39,000
.فذلك ما جرى له حينما كنّا في البرج السابع

159
00:11:39,800 --> 00:11:42,350
!إنّه لا يتنفَّس

160
00:11:42,590 --> 00:11:43,560
.هذا سيئ

161
00:11:43,560 --> 00:11:44,290
ألا زال على قيد الحياة؟

162
00:11:47,420 --> 00:11:48,640
!علاء الدين

163
00:11:48,640 --> 00:11:50,360
!تماسك يا علاء الدين

164
00:11:50,360 --> 00:11:51,190
!علاء الدين

165
00:11:51,190 --> 00:11:52,520
.أبعِدوا المزمار

166
00:11:52,520 --> 00:11:54,000
!أزيحوا المزمار حالًا

167
00:12:03,180 --> 00:12:05,030
.إنّه يعاني من إجهاد بدني

168
00:12:05,820 --> 00:12:10,030
.إنّه يثابر على التماسك ولكن حالته الصحيّة حرجة جدًا

169
00:12:10,030 --> 00:12:11,670
!لا يمكن

170
00:12:11,670 --> 00:12:13,810
.إنّه يفتقر إلى كمٍ غزيرٍ من طاقة الماغوي

171
00:12:14,970 --> 00:12:18,780
.صحيحٌ أنّ الماغي بوسعهم استغلال الماغوي من حولهم دونما قيود

172
00:12:18,780 --> 00:12:22,320
.ولكنّ ذلك مرتبط بقواهم الجسدية

173
00:12:25,680 --> 00:12:29,420
!ولكنّه بات أوهن ممّا كان عليه مسبقًا

174
00:12:29,420 --> 00:12:34,840
.على ما يبدو أنّ ضعف بدنه قد حال دون قدرته على استمداد الماغوي اللازم من الرخ

175
00:12:34,840 --> 00:12:37,400
.ولهذا استمد الماغوي من جسده عوضًا عن ذلك

176
00:12:38,610 --> 00:12:41,990
.بذل ماغوي الشخص يعادل بذل حياته

177
00:12:42,640 --> 00:12:45,290
...حتّى وإنْ كان ماغي، نفاد الماغوي يعني

178
00:12:45,290 --> 00:12:50,080
!ببساطة هذا هو مدى أهميّة أوغو لعلاء الدين

179
00:12:50,080 --> 00:12:51,120
.علي بابا

180
00:12:57,200 --> 00:13:00,940
...ولكن رغم ذلك، لم يظهر رمز النجمة الثمانية

181
00:13:04,020 --> 00:13:06,440
.على العموم، إنّه يحتاج قسطًا من الراحة حاليًا

182
00:13:06,440 --> 00:13:09,540
.ولا يبدو أنّه سيستعيد عافيته في غضون هذه الفترة

183
00:13:18,780 --> 00:13:20,230
!أيّها الزعيم

184
00:13:20,230 --> 00:13:21,870
!أيّها الزعيم علي بابا

185
00:13:21,870 --> 00:13:24,030
ما عسانا نفعل الآن؟

186
00:13:24,030 --> 00:13:26,740
ما مصير حزب الضباب الآن؟ والأحياء الفقيرة؟

187
00:13:26,740 --> 00:13:27,860
!أيّها الزعيم

188
00:13:27,860 --> 00:13:29,480
!أخبرنا بما نفعل أيّها الزعيم

189
00:13:29,480 --> 00:13:30,490
!أيّها الزعيم

190
00:13:30,490 --> 00:13:32,220
!من فضلك

191
00:13:32,220 --> 00:13:34,150
.اهدأوا، سنكون بخير

192
00:13:35,250 --> 00:13:39,840
لا تقلقوا، أَلم أخبركم مسبقًا أنّي سأتخطّى العقبات؟

193
00:13:39,840 --> 00:13:42,000
.إنّ قوات الدعم في طريقها إلينا من سندريا

194
00:13:42,480 --> 00:13:45,640
.ما عليكم سوى استجماع قوّتكم والاستعداد للقيام بدوركم وقت الحاجة

195
00:13:45,640 --> 00:13:46,490
.اطمئنوا

196
00:13:46,490 --> 00:13:48,760
أحقًا سنحظى بقوات دعم؟

197
00:13:49,760 --> 00:13:50,940
.نعم

198
00:13:52,190 --> 00:13:55,990
.أما الآن يجدر بكم مساعدة الآخرين في إسعاف الجرحى

199
00:13:55,990 --> 00:13:56,870
.حسنُ

200
00:13:56,870 --> 00:13:58,530
.هيّا بنا يا رفاق

201
00:13:58,530 --> 00:13:59,400
!أجل

202
00:13:59,400 --> 00:14:02,250
.لنذهب لإحضار المعدّات

203
00:14:02,250 --> 00:14:04,360
.قد يوجد معدّاتٌ قابلة للاستعمال في المرفأ

204
00:14:04,360 --> 00:14:06,590
.هذا صحيح، هيّا بنا

205
00:14:07,320 --> 00:14:11,550
تبًا، لماذا لا أحسن فعل شيء؟

206
00:14:11,550 --> 00:14:15,710
.لا أستطيع حماية الآخرين ولا حتّى التهدئة من روعهم

207
00:14:17,190 --> 00:14:21,730
...لو كان قاسم مكاني لأبلى بلاءً حسنًا

208
00:14:21,730 --> 00:14:25,720
مهلًا، أين قاسم؟

209
00:14:25,720 --> 00:14:27,220
!لدينا مشكلة

210
00:14:27,220 --> 00:14:28,330
ما الأمر؟

211
00:14:28,330 --> 00:14:30,960
.إنّها مشكلة أيّها الزعيم، هنالك وحدة عسكريّة قادمٌة نحونا

212
00:14:30,960 --> 00:14:31,960
ماذا؟

213
00:14:37,750 --> 00:14:39,590
!باركاك

214
00:14:40,220 --> 00:14:41,410
.سيّدي

215
00:14:41,410 --> 00:14:42,800
.القائد باركاك

216
00:14:42,800 --> 00:14:45,590
.لقد تغيِّرت كثيرًا يا سيّدي

217
00:14:45,590 --> 00:14:50,500
.لا أصدق أنّك في حينٍ مضى كنت الصبيّ الّذي عكفتُ على تعليمه المبارزة الملكيّة

218
00:14:50,500 --> 00:14:52,750
ما الّذي أتى بك هنا؟

219
00:14:54,240 --> 00:14:56,170
أخي سبمد؟

220
00:14:58,420 --> 00:15:00,910
.أنت مذهل يا علي بابا

221
00:15:00,910 --> 00:15:05,510
.إنّك تقود جماعة من اللصوص

222
00:15:05,950 --> 00:15:08,140
.كم هذا مذهل

223
00:15:08,940 --> 00:15:10,830
.لن أستطيع فعل أمرٍ كهذا أبدًا

224
00:15:10,830 --> 00:15:18,270
.إنْ تواجدتُ مع جماعة من الغرباء، رِجلاي لا تقوى سوى على الارتجاف

225
00:15:19,440 --> 00:15:21,660
...أخي سبمد

226
00:15:21,660 --> 00:15:27,780
.لقد قطع نائب الملك هذه المسافة لإخباركَ بأمرٍ هامٍ يا سيّدي

227
00:15:28,650 --> 00:15:31,270
.إنّما هذه تعدّ منطقة عدو في اعتبارنا

228
00:15:31,270 --> 00:15:35,180
.رجاءً تفهّم مخاطرة نائب الملك بقدومه إلى هنا

229
00:15:37,860 --> 00:15:39,900
!هذا أنت يا سبمد

230
00:15:40,630 --> 00:15:41,850
!الملك سندباد

231
00:15:41,850 --> 00:15:45,170
.لقد أظهرت شجاعةً فائقةً بوجودك هنا بين الغرباء

232
00:15:45,880 --> 00:15:49,170
لم تأتِ هنا امتثالًا لأمر أخيك أبمد، أليس كذلك؟

233
00:15:49,710 --> 00:15:51,590
.أجل

234
00:15:51,590 --> 00:15:54,400
.عليّ الاعتذار

235
00:15:54,400 --> 00:15:57,610
.لقد عرّضتُ حياتك للخطر

236
00:15:58,920 --> 00:16:00,920
.فهمت، إذن فهو أنت

237
00:16:00,920 --> 00:16:01,690
ماذا؟

238
00:16:02,320 --> 00:16:07,810
مُخبر حزب الضباب شخصٌ واسع الأفاق
.ولن يكون كذلك إلا إنْ كان من المقام العالي

239
00:16:07,810 --> 00:16:11,020
.فهو الّذي قام بتشويش تحرّكات الدوريات العكسريّة

240
00:16:11,020 --> 00:16:14,320
.وهو الّذي أبلغهم بشأن اعتزامي للقبض عليهم

241
00:16:14,320 --> 00:16:16,140
.أنت المُخبر المتواطئ إذن

242
00:16:16,140 --> 00:16:17,080
ماذا؟

243
00:16:19,320 --> 00:16:21,630
كلّ ذلك كان من فعل أخي سبمد؟

244
00:16:21,630 --> 00:16:23,340
أَلم تكن تعلم بهذا؟

245
00:16:27,770 --> 00:16:30,090
...لم أكن على علمٍ بأيّ شيء

246
00:16:32,800 --> 00:16:34,720
.فعلت هذا لمؤازرة علي بابا

247
00:16:35,470 --> 00:16:38,300
...مقدرة علي بابا على قيادة حزب الضباب

248
00:16:38,940 --> 00:16:42,020
.جعلتني أرى فيه المقدرة على إنجاد بلادنا

249
00:16:42,020 --> 00:16:44,230
!أخي سبمد

250
00:16:45,850 --> 00:16:51,240
.لطالما كنتَ قادرًا على فعل ما لا أستطيع يا علي بابا

251
00:16:53,210 --> 00:16:57,590
.ولهذا جئت إليك أملًا في ردع أبمد

252
00:16:57,590 --> 00:16:57,990
ماذا؟

253
00:16:57,990 --> 00:17:00,230
ردع أبمد؟

254
00:17:00,230 --> 00:17:05,880
ما السوء الّذي سيدفع نائب الملك لمؤازرة اللصوص أملًا في ردع الملك؟

255
00:17:06,800 --> 00:17:09,880
...لا أنكر إنّي أخاف أخي

256
00:17:09,880 --> 00:17:15,440
.ولكنّي متخوّفٌ أكثر من الأمور الّتي يعتزم فعلها

257
00:17:16,490 --> 00:17:25,020
.وحقيقة الأوضاع الّتي ستؤول إليه بلادنا هو أكبر مخاوفي على الإطلاق

258
00:17:35,580 --> 00:17:38,290
.أنا سأتكفّل بالشرح من هنا

259
00:17:38,970 --> 00:17:44,430
.لقد بدأ التزعزع بعد مرض الملك الراحل

260
00:17:44,430 --> 00:17:45,680
ماذا؟

261
00:17:47,110 --> 00:17:49,670
.تشرفت بلقائك أيّها الأمير أبمد

262
00:17:49,670 --> 00:17:52,040
.أنا أمين صندوق

263
00:17:52,040 --> 00:17:54,520
ما رأيك في هذا يا ملك المستقبل؟

264
00:17:54,520 --> 00:17:58,180
هل ترغب في توكيلنا بزمام أمور بلادك؟

265
00:17:58,180 --> 00:18:03,680
.لقد دعا نفسه مستشارًا ماليًا

266
00:18:04,080 --> 00:18:07,690
.في تلك الأثناء كانت العلاقات التجارية على المحك مع بارتڤيا

267
00:18:07,690 --> 00:18:11,610
.وعليه كانت الأوضاع الاقتصادية في انحدارٍ يومًا تلو الآخر

268
00:18:11,610 --> 00:18:15,360
.أخبرنا أنّه سبق أنْ نجح في إصلاح الأوضاع المالية في العديد من البلدان

269
00:18:15,360 --> 00:18:18,530
.ولهذا رأينا الأخذ بمشورته

270
00:18:19,190 --> 00:18:21,430
ما شأن هذه القصاصات الورقية؟

271
00:18:21,430 --> 00:18:25,490
.هذه ليست قصاصات وإنّما أوراقٌ نقدية اسمها فن

272
00:18:25,490 --> 00:18:26,390
فن؟

273
00:18:26,390 --> 00:18:29,880
.إنّها عُملة ذات قيمة ثابتة يتم تداولها في إمبراطورية كو

274
00:18:29,880 --> 00:18:33,770
.جرِّب استخدامها في المعاملة التجارية المقبلة

275
00:18:35,300 --> 00:18:44,060
.لا أنكر أنّ تلك العُملة ساهمت بشكل كبير في تبادل السلع بمختلف الأنواع والأسعار

276
00:18:44,950 --> 00:18:48,280
.ولم يتوانَ أمين الصندوق في تزويدنا بها كلما رغبنا

277
00:18:48,280 --> 00:18:54,570
.ولكنّنا لم ندرك أنّ اقتصاد بالباد صار مرهونًا بقيمة الفن

278
00:18:51,610 --> 00:18:54,570
10000

279
00:18:55,960 --> 00:19:00,840
.ولم نتنبأ بالفخ الذي وقعنا فيه

280
00:19:00,840 --> 00:19:01,780
ماذا؟

281
00:19:02,420 --> 00:19:05,250
.الحصول على الفن يقتضي دفع بعض الفوائد

282
00:19:05,250 --> 00:19:08,910
.ولكن قيمته بدأت تتغير شيئًا فشيئًا

283
00:19:09,270 --> 00:19:13,920
.فما كان يباع بواحد فن بالأمس يضحي ضعف السعر صباح اليوم التالي

284
00:19:13,920 --> 00:19:17,680
.تقلُّب المعاملات التجارية لم يصبّ في مصالح بلادنا

285
00:19:18,670 --> 00:19:21,620
.قيمة النقود المعدنية تكمن في المعادن المصنوعة منها

286
00:19:21,620 --> 00:19:23,540
.بينما قيمة النقود الورقية ليست كذلك

287
00:19:23,540 --> 00:19:25,740
.إنّها تستمد قيمتها من الجهة المصدّرة لها

288
00:19:25,740 --> 00:19:29,560
.فهي مجرد قصاصات ورقية في نهاية المطاف

289
00:19:29,560 --> 00:19:32,690
.لا أصدق أنّهم لجأوا لاستخدام عملة أجنبية كأداة لتحسين الاقتصاد

290
00:19:32,690 --> 00:19:36,960
.في بلادنا يجاز استخدام سندات إذنية عوضًا عن العملات المعدنية

291
00:19:36,960 --> 00:19:40,700
.ولكنها قصيرة الأجل وأيضًا لا يصرّح التداول بها خارج الحدود

292
00:19:40,700 --> 00:19:46,050
.لقد تراكمت علينا الديون بشكلٍ هائل

293
00:19:46,050 --> 00:19:49,280
.ووقعنا في دوامة الاقتراض لدفع ما علينا من ديونٍ سابقة

294
00:19:49,280 --> 00:19:52,340
.ورغم ذلك لم يوافق أمين الصندوق على توفير النقود بلا مقابل

295
00:19:52,940 --> 00:19:56,910
...حقوقنا التجارية في النطاق الإقليمي والبحري

296
00:19:56,910 --> 00:20:00,300
.أصبحت مقابل تأمين قرض

297
00:20:00,300 --> 00:20:01,800
!مستحيل

298
00:20:01,800 --> 00:20:05,310
.ومن هنا بدأت معاناة النّاس

299
00:20:05,310 --> 00:20:08,540
.ما بين ازدياد الضرائب وعدم الإيفاء بمستحقّاتهم من المتطلبات

300
00:20:08,540 --> 00:20:11,030
...وكمحاولة لقمع المستائين

301
00:20:11,030 --> 00:20:15,320
.أمر الملك بحجز الضواحي الفقيرة والتخلّي عن الّذين يعيشون فيها

302
00:20:17,540 --> 00:20:21,450
.فيما مضى كانت هذه مدينة ساحلية عظيمة

303
00:20:25,100 --> 00:20:29,680
.تفشى وباءٌ في الضواحي الفقيرة بعد عامٍ من رحيلك إلى القصر

304
00:20:29,680 --> 00:20:31,960
...لم تكتفِ السُّلطة الحكومية بتجاهلنا فحسب

305
00:20:31,960 --> 00:20:35,620
.بل وقاموا بنبذ الضواحي كمحاولة للتستر على الأمر

306
00:20:37,200 --> 00:20:42,940
.ومع ذلك، لم يتضرر الأشراف والنبلاء من خطورة المسألة

307
00:20:42,940 --> 00:20:46,210
.فمعيشتهم أصبحت على مستوى أفضل

308
00:20:46,210 --> 00:20:50,180
!علينا الحصول على المزيد من الفن، علينا استعارة المزيد

309
00:20:50,180 --> 00:20:55,760
.ولكن لم يعد يوجد في البلاد ما يصلح للعرض مقابل قرض

310
00:20:56,950 --> 00:20:59,980
.ماذا تعني؟ إنّي أرى الكثير هنا

311
00:21:00,690 --> 00:21:03,570
إلى ماذا تنظر جلالتك؟

312
00:21:03,570 --> 00:21:04,290
.هناك

313
00:21:04,290 --> 00:21:04,960
ماذا؟

314
00:21:07,260 --> 00:21:09,710
.لنستغل حق مواطنينا في المرة المقبلة

315
00:21:10,790 --> 00:21:15,460
!إنّ البلاد تعجُّ بالسُكّان

316
00:21:15,460 --> 00:21:18,940
.ولهذا سوف ننتفع من حق المواطنين في التأمين

317
00:21:18,940 --> 00:21:21,470
!فما من حدٍّ للتناسل البشر

318
00:21:21,470 --> 00:21:24,020
.وبذلك سنحصل على الفن إلى آخر الدَّهر

319
00:21:25,600 --> 00:21:26,260
!أخبرني

320
00:21:26,610 --> 00:21:29,870
كيف سينتفع من حق المواطنين في التأمين؟

321
00:21:31,280 --> 00:21:33,680
.إنّه يعتزم المتاجرة بهم

322
00:21:34,890 --> 00:21:39,930
.سوف يتاجر بمواطني بالباد لإمبراطورية كو وإمبراطورية ريّم وبارتڤيا

323
00:21:39,930 --> 00:21:44,520
!إنّ أخي يخطط لتحويل بالباد إلى منشأة رقيق

324
00:21:48,210 --> 00:21:51,790
.إنّ حاجة أخي للنقود صارت مثل حاجته للماء

325
00:21:52,260 --> 00:21:54,570
.إنّه لا يأبه لشيءٍ سوى النقود

326
00:21:54,570 --> 00:22:00,310
.والنبلاء والأشراف يساندونه حفاظًا على معيشتهم المريحة فحسب

327
00:22:00,310 --> 00:22:04,530
!يا نائب الملك

328
00:22:02,220 --> 00:22:03,190
مرجانة؟

329
00:22:04,530 --> 00:22:08,060
لقد أتيت إلينا أملًا في إحباط مخطَّطات الملك، أليس كذلك؟

330
00:22:08,880 --> 00:22:11,120
.هذا صحيح

331
00:22:14,280 --> 00:22:16,770
.لنسعَ في ذلك يا علي بابا

332
00:22:16,770 --> 00:22:19,900
!لنضع حدًا لهذا الجنون

333
00:22:21,390 --> 00:22:23,280
.أيّها الزعيم

334
00:22:23,280 --> 00:22:24,250
.سيّدي

335
00:22:24,250 --> 00:22:25,280
.علي بابا

336
00:22:25,280 --> 00:22:26,810
!علي بابا

337
00:24:14,610 --> 00:24:16,740
.كلًّ منّا وُلد ليؤدي رسالته في الحياة

338
00:24:16,740 --> 00:24:18,390
هل ستنضم إليّ يا علي بابا؟

339
00:24:18,390 --> 00:24:22,650
.أنا على يقين بأنّه الّذي سينقذ هذه البلاد

340
00:24:22,650 --> 00:24:25,270
.الحلقة القادمة بعنوان: العزيمة والفراق

341
00:24:25,270 --> 00:24:28,370
ما عساي أفعل يا علاء الدين؟