1
00:00:06,100 --> 00:00:11,060
.هكذا إذن، إنّي متفهّمٌ لموقفك من إمبراطورية كو

2
00:00:11,060 --> 00:00:15,320
!إنّي على استعدادٍ للمخاطرة بحياتي لاكتساب ثقتك

3
00:00:15,320 --> 00:00:18,830
!فليس لديّ ما أخفيه عنك بعد الآن

4
00:00:19,650 --> 00:00:24,960
أيّها الملك سندباد، هلّا تكرمت بمؤازرتي في الانقلاب على إمبراطورية كو؟

5
00:00:26,450 --> 00:00:28,830
أَلم تأتِ هنا لاكتساب العلم؟

6
00:00:28,830 --> 00:00:31,880
.في هذه الحالة أريد منك التأني والتعرُّف على أحوال بلادي أولًا

7
00:00:31,880 --> 00:00:33,750
.ليس لديّ متسعٌ من الوقت لذلك

8
00:00:33,750 --> 00:00:35,550
...فضلًا أريد سماع إجابتك

9
00:00:41,000 --> 00:00:43,940
.يستحسن أن تكون على إلمامٍ بالأمر إنْ أردت الخوض في مناقشة جديّة

10
00:00:43,940 --> 00:00:49,030
.اطَّلع أولًا على أحوال هذا العالم من حولك، وعلى أوضاع النّاس المختلفة

11
00:00:50,000 --> 00:00:54,030
.كما أريد منك ملاقاة شخصٍ ما

12
00:00:54,030 --> 00:00:56,240
.علي بابا سالوجا

13
00:00:56,680 --> 00:01:01,950
.إنّه الأمير الثالث للبلاد الّتي تسعى بلادكم لاحتلالها

14
00:02:33,920 --> 00:02:37,510
هل تصدّقون أن هذا الفتى أمير؟

15
00:02:37,510 --> 00:02:39,830
أَحقًا ما تقول؟

16
00:02:39,830 --> 00:02:43,560
.لا أصدق، ولكنّه ظريفٌ برغم ذلك

17
00:02:43,560 --> 00:02:46,320
أّلا تعتقد أنك انغمست في الشرب يا معلِّمي؟

18
00:02:46,320 --> 00:02:50,190
!نادني شرّ عندما نخرج لاحتساء الشراب يا ولد

19
00:02:51,650 --> 00:02:54,890
أيًا كان، ما رأيك فيه بصفتك أميرًا سابقًا؟

20
00:02:54,890 --> 00:02:55,730
ماذا؟

21
00:02:55,730 --> 00:02:57,380
.لا تستغرب

22
00:02:57,380 --> 00:03:01,560
.إنّي أسألك عن رأيك في أمير إمبراطورية كو

23
00:03:01,560 --> 00:03:04,370
.بصراحة أمره لا يشغل تفكيري

24
00:03:04,370 --> 00:03:07,620
.كم أريد خوض نزالٍ ضده

25
00:03:07,620 --> 00:03:11,380
.ولكن على ما يبدو أني أفوقه مهارة بالسيف

26
00:03:14,340 --> 00:03:17,850
!ولا شكّ في أني حظيتُ برفقة أجمل النساء بخلافه

27
00:03:17,850 --> 00:03:18,850
!لا تقلُ هذا

28
00:03:18,850 --> 00:03:20,430
!كف عن هذا عزيزي شرّ

29
00:03:20,430 --> 00:03:23,130
هلّا اقتربتِ منّي يا حلوة؟

30
00:03:24,770 --> 00:03:25,880
.لا تؤاخذني

31
00:03:25,880 --> 00:03:27,510
!هذا ما تاقت نفسي إليه

32
00:03:27,510 --> 00:03:30,350
هل المقعد متاح؟

33
00:03:32,290 --> 00:03:35,320
هل تؤلمك ذراعك؟

34
00:03:35,320 --> 00:03:38,680
.كلّا، إنّه ليس شيئًا يذكر

35
00:03:38,680 --> 00:03:42,070
.هذا جرحٌ بسيطٌ من مقاتلة رجال

36
00:03:43,820 --> 00:03:46,330
.اسمي أكاترينا

37
00:03:48,660 --> 00:03:51,160
!كف عن هذا

38
00:03:53,700 --> 00:03:55,340
.شرّار برق

39
00:04:01,050 --> 00:04:04,680
ما رأيكِ فيما سخَّرتُ من سحر المدافعة يا آنسة يام؟

40
00:04:04,680 --> 00:04:09,680
!لقد ركّبت التعويذة من أمرين: تجميع النَّار، وثمّ نصبها أمامي كحاجز

41
00:04:09,680 --> 00:04:11,520
.لا بأس به

42
00:04:11,520 --> 00:04:16,800
.ولكن بإضافة أمرٍ ثالث للتركيبة فسيتحوّل التسخير إلى تعويذة مباغتة

43
00:04:26,490 --> 00:04:27,280
ما رأيك؟

44
00:04:27,280 --> 00:04:29,210
!هذا رائع يا آنسة يام

45
00:04:29,210 --> 00:04:32,080
!كم أودُّ تجربة هذا التسخير بالنَّار

46
00:04:33,920 --> 00:04:36,040
ماذا دهاك؟

47
00:04:36,040 --> 00:04:37,880
ما لك لا تبارزني؟

48
00:04:38,520 --> 00:04:42,510
!إنّه يتغير تمامًا عندما يحمل سيفًا

49
00:04:44,410 --> 00:04:45,740
.تبًا

50
00:04:45,740 --> 00:04:47,640
!كم أنت سيئ

51
00:04:48,230 --> 00:04:51,850
.إنّ سيفك من التسلُّح بالحاوية لا يتماشى مع أسلوبك في المبارزة

52
00:04:55,340 --> 00:04:57,160
.ولكن لا تقلق

53
00:04:57,160 --> 00:05:00,650
.بوسعك استخدامه على نحوٍ أفضل

54
00:05:00,650 --> 00:05:03,080
.هلّا وضَّحت الأمر من فضلك

55
00:05:03,080 --> 00:05:06,280
.لن تحصل دائمًا على الإجابة بمجرّد سؤالك عنها

56
00:05:06,280 --> 00:05:07,990
ماذا؟

57
00:05:07,990 --> 00:05:10,060
.انتهى التدريب لهذا اليوم

58
00:05:10,060 --> 00:05:13,520
.يا حبَّذا لو تفكر مليًا لتتوصّل إلى الإجابة

59
00:05:17,220 --> 00:05:19,520
.تفاءل يا علي بابا

60
00:05:19,520 --> 00:05:23,210
.أنا أيضًا تستضعفني الآنسة يام طوال فترة التدريب

61
00:05:23,210 --> 00:05:25,260
.لا بدَّ وأن الأمر صعبٌ عليك إذن

62
00:05:25,260 --> 00:05:28,950
.ولكنّي تعلَّمتُ الكثير

63
00:05:28,950 --> 00:05:33,490
!إنّها مور، لقد عادت من مصنع الحدادة

64
00:05:37,480 --> 00:05:40,170
هل هذه ستكون حاويتكِ التابعة يا مرجانة؟

65
00:05:40,170 --> 00:05:41,230
.أجل

66
00:05:41,720 --> 00:05:44,120
.طلبت إعادة تصنيعها كخلخال

67
00:05:44,120 --> 00:05:50,270
إنّه منقوشٌ برسمةٍ لطائر العنقاء
.حيث أنه يرمز للشمس بحسب معتقدنا نحن سكّان القارة السوداء

68
00:05:50,270 --> 00:05:51,520
!إنّها بديعة

69
00:05:51,520 --> 00:05:53,750
!هيّا ارتديها

70
00:05:59,750 --> 00:06:02,320
.كم هي جملية تلك السلاسل

71
00:06:02,320 --> 00:06:06,820
.إنها تبدو كالخلاخيل الّتي تتزين بها الرَّاقصات

72
00:06:06,820 --> 00:06:08,680
!هيّا استعرضي إمكانياتها يا مور

73
00:06:23,600 --> 00:06:25,780
!أرجو المعذرة، أرجو المعذرة

74
00:06:26,360 --> 00:06:29,390
أَلا تعتقدين أنها أفضل بدون السلاسل؟

75
00:06:29,390 --> 00:06:32,000
ماذا لو غيرتِ موضع ارتدائها؟

76
00:06:34,080 --> 00:06:38,300
.إنّها ليست سوى زينة أينما ارتديها

77
00:06:38,300 --> 00:06:41,670
.لا أعرف كيفية استغلالها في القتال

78
00:06:42,650 --> 00:06:45,140
ما غايتكِ من استخدامها يا مور؟

79
00:06:45,990 --> 00:06:47,050
أنا؟

80
00:06:47,050 --> 00:06:55,640
تقول الآنسة يام إنّ تحديد الغاية من تركيب أيّ
.تعويذة جديدة هي الخطوة الأولى لتسخير السحر

81
00:06:55,640 --> 00:06:59,720
.أظنّ أن الأمر مماثلٌ لاتخاذ الحاويات التابعة

82
00:06:59,720 --> 00:07:02,490
غايتي من استخدامها؟

83
00:07:07,860 --> 00:07:12,660
.أريد اتخاذها سبيلًا لمساندتكما

84
00:07:12,660 --> 00:07:15,000
.إنّكِ بالفعل تساندينا بقوّتكِ المجرّدة

85
00:07:17,110 --> 00:07:21,200
.ولكن أفضل المرّات كانت عندما قذفتني آنذاك

86
00:07:21,200 --> 00:07:25,600
.لولاكِ يا مرجانة لما استطعت الوصول إليهم

87
00:07:25,600 --> 00:07:27,800
.وعندما أنقذتني أيضًا

88
00:07:28,580 --> 00:07:30,980
.لقد قفزتِ نحوي بسرعة لحمايتي من الخطر

89
00:07:32,470 --> 00:07:34,200
.كم أنتِ رائعة

90
00:07:34,580 --> 00:07:38,470
.أشعر بامتلاك أجنحةٍ كلما تواجدتِ معنا يا مور

91
00:07:38,470 --> 00:07:42,400
أنا... كالأجنحة بالنسبة لكما؟

92
00:07:45,410 --> 00:07:46,490
!إنّها رائعة

93
00:07:46,490 --> 00:07:48,230
!إنّها قوية

94
00:07:48,230 --> 00:07:49,540
.فهمت

95
00:07:49,540 --> 00:07:52,240
على رسلكِ، ماذا طرأ على مخيّلتكِ للتّو؟

96
00:07:52,240 --> 00:07:54,620
.أرجو المعذرة على مقاطعتكم

97
00:07:55,540 --> 00:07:59,900
.كنتُ أبحث عنكم امتثالًا لطلب الملك سندباد

98
00:07:59,900 --> 00:08:02,330
.إنّي أرافقه فحسب

99
00:08:02,330 --> 00:08:05,000
ماذا طلب منك سندباد؟

100
00:08:05,000 --> 00:08:10,400
.طلب منّي مصاحبتكم لأتعلَّم منكم

101
00:08:10,400 --> 00:08:12,970
.أرجو أنْ ننسجم معًا

102
00:08:14,210 --> 00:08:15,970
أنت الماغي، أليس كذلك؟

103
00:08:15,970 --> 00:08:20,150
.أشكرك لمساعدة أختي هاكوي عندما كنتَ في سهول الكوغا

104
00:08:21,720 --> 00:08:24,980
.إنّي لشاكرٌ لك معروفك

105
00:08:24,980 --> 00:08:26,830
هل الآنسة على ما يرام؟

106
00:08:26,830 --> 00:08:29,980
.أجل، إنّها حاليًا تقود حملة عسكريّة نحو المنطقة الغربيّة من هضاب تينجان

107
00:08:29,980 --> 00:08:34,190
.وستتَّبع نهج التسوية الودّية مع بقيّة القبائل كما فعلَت مع عشيرة كوغا

108
00:08:34,190 --> 00:08:35,450
.يا لها من نظراتٍ مرعبة

109
00:08:37,580 --> 00:08:40,000
...كلّا، في الواقع

110
00:08:40,000 --> 00:08:42,660
.أنا على إدراكٍ بما تشعر نظرًا للأحداث الّتي وقعت في بالباد

111
00:08:42,960 --> 00:08:45,500
.ولكن لا طائل من إظهار العداوة بعد الآن

112
00:08:45,500 --> 00:08:49,000
.معها حق، إظهار العداوة لن يفضي لنتيجة

113
00:08:49,000 --> 00:08:53,590
.هذا صحيح، لننسى الماضي ونبدأ صفحة جديدة

114
00:08:56,050 --> 00:08:57,520
!إنّكِ تؤلميني

115
00:08:57,520 --> 00:08:59,170
!أنت الّذي يشدَّ قبضته عليّ

116
00:08:59,170 --> 00:09:00,820
!هذا موجع

117
00:09:00,820 --> 00:09:02,060
!أفلت يدي

118
00:09:02,060 --> 00:09:03,830
.فضلًا لا تؤاخذهم يا هاكوريو

119
00:09:03,830 --> 00:09:06,590
.فقد كانا على عداوة سابقة في بالباد

120
00:09:06,590 --> 00:09:08,490
أَوليس هذا حالك أيضًا؟

121
00:09:09,870 --> 00:09:14,800
.سيّد علي بابا سالوجا، لا شكّ في أنّك تكنّ البغضاء لي

122
00:09:14,800 --> 00:09:17,760
.بما أني أميرٌ من البلاد الّتي تسعى لاستعمار بلادك

123
00:09:17,760 --> 00:09:20,070
...كلّا، في الحقيقة أنا

124
00:09:22,930 --> 00:09:24,700
.لا تضغط على نفسك بالتظاهر

125
00:09:24,700 --> 00:09:27,870
.ولا أخفيك سرًا أنّ إمبراطوريتنا تحاول استعمار بالباد

126
00:09:27,870 --> 00:09:29,920
.وأنّها تسعى حاليًا لتحقيق ذلك

127
00:09:31,150 --> 00:09:32,420
...أنا

128
00:09:34,340 --> 00:09:35,640
.اكرهه

129
00:09:39,780 --> 00:09:41,220
علي بابا؟

130
00:09:41,220 --> 00:09:45,010
...اسم القائد الموكل بقيادة الحملة العسكريّة الثانية إلى بالباد

131
00:09:45,010 --> 00:09:48,730
.هو كوّين رين، الأمير الأول لإمبراطورية كو، والملقّب بإمبراطور النّار

132
00:09:48,730 --> 00:09:52,720
!اكرهه، اقتله

133
00:09:49,450 --> 00:09:56,940
.وسيستغل ثورة بالباد كذريعة ليجعلها تحت قبضته

134
00:09:56,940 --> 00:09:57,740
علي بابا؟

135
00:09:57,740 --> 00:10:04,250
أّلم تفقد صديقًا عزيزًا لك أثناء الثّورة؟

136
00:09:58,680 --> 00:10:02,210
!أجل، لتتملكك الكراهية، لتتملكك رغبة القتل

137
00:10:04,250 --> 00:10:08,300
.لهذا لا تضغط على نفسك بإخفاء مشاعر العداوة

138
00:10:08,300 --> 00:10:09,290
سيّد علي بابا؟

139
00:10:35,890 --> 00:10:37,280
ماذا حدث؟

140
00:10:38,400 --> 00:10:40,030
!سندباد

141
00:10:40,030 --> 00:10:42,760
...لا تقلق، ثمّة وخزٌ خفيفٌ في

142
00:10:43,530 --> 00:10:46,330
.ما زلت تكابر برغم وصولك إلى هذه المرحلة

143
00:10:51,400 --> 00:10:54,300
.يا لك من جبان

144
00:10:54,300 --> 00:10:55,800
...أنت

145
00:10:55,800 --> 00:11:00,090
.ولكن ما كنتُ لأتجاوز حدود سندريا لولاك

146
00:11:12,980 --> 00:11:14,770
.يبدو أن الماغي فقط من كان سريع البديهة

147
00:11:15,480 --> 00:11:17,650
ما هذه الدماء؟

148
00:11:18,030 --> 00:11:19,410
.لقد فات الآوان

149
00:11:19,410 --> 00:11:23,170
.لقد ألقيت عليكما لعنة تحقيقًا لرغبة والدنا

150
00:11:23,170 --> 00:11:29,540
.اعتبرها دعوة منّا يا سندباد، يا أيّها الملك الخارج عن المألوف

151
00:11:29,540 --> 00:11:34,610
.والأمر سيّانٌ لك يا علي بابا، يا أيّها الملك الّذي وقع عليه اختيار سليمان المتغطرس

152
00:11:34,610 --> 00:11:37,560
.عليكما الخضوع لرغبة والدنا والتحوّل لملوكٍ من صبغة الظلمات

153
00:11:38,310 --> 00:11:43,310
.اللعنة قد تدخَّلت في تدفق الماغوي وعمّا قريب ستصطبغ جسيمات الرخ بالأسود

154
00:11:43,310 --> 00:11:47,340
.ممّا سيجعلكما تنسلخان تمامًا عمّا أنتما عليه

155
00:11:47,340 --> 00:11:49,650
.أنتما بالأحرى ستنحدران نحو الظلمات

156
00:11:49,650 --> 00:11:50,980
انحدار نحو الظلمات؟

157
00:11:50,980 --> 00:11:53,130
.لا مهرب من هذا

158
00:11:53,130 --> 00:11:57,670
.مقاومة اللعنة ستؤدي إلى تهالك جسديكما نتيجة التّنافر بين رخ سليمان والرخ السوداء

159
00:11:58,010 --> 00:11:59,990
.ستؤدي لمقتلكما إنْ جاز التّعبير

160
00:12:03,160 --> 00:12:06,050
.سأكون بانتظاركما في أعماق الظلمات

161
00:12:14,950 --> 00:12:18,720
.ما عسانا نفعل؟ فحتّى سندباد قد أصيب بها

162
00:12:21,630 --> 00:12:23,240
.لا تُقلقوا بالكم

163
00:12:23,420 --> 00:12:25,370
.فلا وجود للعنات

164
00:12:26,040 --> 00:12:27,790
.إنّ هذا من أشكال السحر

165
00:12:27,790 --> 00:12:28,760
أَليس كذلك؟

166
00:12:28,760 --> 00:12:33,270
.أجل، فالسحر ما يعمل على تفاقم هذه البقع السوداء

167
00:12:33,270 --> 00:12:36,850
.إنْ كان كذلك، فلا بدّ من طريقة لحلّه

168
00:12:37,390 --> 00:12:40,060
.ولكن لم يكن لي سابقة في هذا الشكل من السحر

169
00:12:40,060 --> 00:12:43,360
أتساءل ما سمات الأوامر الّتي تؤثر على فعاليّته؟

170
00:12:43,360 --> 00:12:47,490
.أخشى أن صاحب التعويذة فقط هو القادر على حلّ هذه التركيبة المعقدة

171
00:12:47,490 --> 00:12:49,170
.لا أصدق

172
00:12:52,730 --> 00:12:55,350
.توجد طريقةٌ أخرى

173
00:12:55,350 --> 00:12:56,700
ما هي؟

174
00:12:56,700 --> 00:13:01,530
.في أقصى الجنوب من هنا يوجد برج محصّن على جزيرة سكّانها من قبائل طرًا

175
00:13:02,600 --> 00:13:07,490
.إنْ فتحت البرج فقد نستغل قدرة الجانّ الشّفائية لمدواتنا

176
00:13:07,490 --> 00:13:10,010
.ذلك الجانّ هو زاغن، سيّد المتاهة الواحد وستون

177
00:13:10,010 --> 00:13:15,360
.قدرته تلك هي السبيل الوحيد لنجاتنا

178
00:13:15,360 --> 00:13:19,010
هل أنت أهلٌ لهذه المهمة يا علي بابا؟

179
00:13:20,080 --> 00:13:21,030
.نعم

180
00:13:21,030 --> 00:13:25,800
.وددت لو أرافقكم ولكنّي لا أستطيع

181
00:13:25,800 --> 00:13:27,660
هل بوسعكم تدبر الأمر بمفردكم؟

182
00:13:29,280 --> 00:13:30,780
ما المانع من مرافقتك لنا؟

183
00:13:30,780 --> 00:13:37,310
.لن أدخل المتاهة حتّى وإنْ عبرتُ بوابة البرج، والأمر سيّانٌ لأنصاري

184
00:13:38,300 --> 00:13:41,700
.أصبح هذا حالنا بعدما تعاقدت مع الجانّ السابع

185
00:13:41,700 --> 00:13:45,930
.أخبرني أنّي قد بلغتُ حدّي

186
00:13:45,930 --> 00:13:52,180
.ثمّة حدٌ لاكتساب القوة حتّى بالنسبة لأصحاب الحاويات

187
00:13:52,830 --> 00:13:55,690
.فهمت، إذن فسوف نعتمد على أنفسنا

188
00:13:55,690 --> 00:13:59,100
!وسوف نكسر هذه اللعنة بكل تأكيد

189
00:13:59,100 --> 00:14:01,440
.أودّ مرافقتهم إنْ سمحت لي

190
00:14:02,690 --> 00:14:08,960
.أعلم أني طلبتُ منك التعلَّم منهم ولكن هذه المسألة لا تشمل طلبي

191
00:14:08,960 --> 00:14:10,700
.ستكون رحلة محفوفة بالمخاطر

192
00:14:10,700 --> 00:14:12,520
.إنّي متأهبٌ لذلك

193
00:14:12,520 --> 00:14:16,620
.لطالما بحثتُ عن ماغي ليساعدني في تحقيق رغبتي بفتح برجٍ محصّن

194
00:14:16,620 --> 00:14:23,500
.سمعت أن جودل ماغي إمبراطوريتكم يرحب بإرشاد قادة كو عند فتح الأبراج

195
00:14:24,390 --> 00:14:29,470
.كلّا، الاستعانة بقوّته هي آخر ما أرغب به

196
00:14:30,440 --> 00:14:31,840
.فهمت

197
00:14:31,840 --> 00:14:34,400
.بوسعك مرافقتهم إذن

198
00:14:34,400 --> 00:14:35,770
!شكرًا جزيلًا

199
00:14:51,450 --> 00:14:58,290
.يا حبّذا لو تقضي الوقت في استجماع قواك عوضًا عن السرحان والعبوس

200
00:14:58,290 --> 00:15:00,610
.ولكنّها غلطتي

201
00:15:00,610 --> 00:15:02,390
.لا تقلق بشأن سن

202
00:15:02,390 --> 00:15:08,470
.تعويذة يام السحريّة ستحدُّ من تفاقم اللعنة لحوالي عشرة أيام تقريبًا

203
00:15:09,260 --> 00:15:10,800
.أجل

204
00:15:10,800 --> 00:15:12,500
.انتبه لهذا

205
00:15:12,500 --> 00:15:16,300
.إنّك تمتلك من الماغوي ما يؤهلكَ لإلقاء هذه التعويذه يا علي بابا

206
00:15:16,300 --> 00:15:20,880
.ولكن استغلال قوة الحاوية بإفراط سوف يكسر التعويذة

207
00:15:20,880 --> 00:15:22,410
قلتِ يؤهلني؟

208
00:15:22,410 --> 00:15:24,440
ماذا عن سندباد؟

209
00:15:25,590 --> 00:15:29,430
.لا يسعه استغلال الماغوي على الإطلاق خلال هذه الفترة

210
00:15:53,000 --> 00:15:54,930
!دعوه لي

211
00:16:04,730 --> 00:16:07,950
.لا بأس عليك، كم أنت وديع

212
00:16:07,950 --> 00:16:10,250
.هيّا ارجع إلى المحيط الآن

213
00:16:17,740 --> 00:16:19,500
!أحسنتِ صنعًا يا سيّدة پستي

214
00:16:21,450 --> 00:16:28,290
بوسعي تسخير الرخ لمخاطبة الحيوانات
.بواسطة التّلاعب بموجات صوتي والصوت الصادر من مزماري

215
00:16:28,290 --> 00:16:31,450
شكرًا يا...  پستي؟

216
00:16:32,150 --> 00:16:37,080
أَلن تدعوني بآنسة كما تدعو يام؟

217
00:16:38,080 --> 00:16:39,790
.أتساءل إنْ كنتِ أكبر سنًّا منّا

218
00:16:39,790 --> 00:16:43,230
.أجل، فأنا أكبر من علي بابا

219
00:16:45,160 --> 00:16:47,150
.يا لقلة التهذِّيب

220
00:16:47,150 --> 00:16:50,180
.إنّي أكبر منك بغض النظر عن مظهري

221
00:16:50,180 --> 00:16:54,150
.كما أنّي متمرّسة في العديد من المجالات بخلافكم يا رفاق

222
00:16:59,960 --> 00:17:01,910
آنسة؟

223
00:17:01,910 --> 00:17:03,750
!كم هذا لئيمٌ يا علاء الدين

224
00:17:06,380 --> 00:17:13,660
برأيكِ لماذا يفضِّل الشبّان الفتيات وثيرات الصدور؟

225
00:17:13,660 --> 00:17:16,040
هل الأمر حقًا كذلك؟

226
00:17:16,040 --> 00:17:19,310
!نعم، الصدور الممتلئة والوثّابة

227
00:17:17,130 --> 00:17:19,310
.إنّ الطعام جاهز

228
00:17:21,890 --> 00:17:24,350
!كم هذا مدهش

229
00:17:24,880 --> 00:17:29,370
.فكرت في طهو هذه الوجبة لكم تعبيرًا عن امتناني لحُسن تعاملكم

230
00:17:29,370 --> 00:17:31,900
هل أعددت كلّ هذه الأطباق؟

231
00:17:31,900 --> 00:17:37,490
.حرِصت أختي على تعويدي القيام بجميع مهامي اليومية بنفسي

232
00:17:37,490 --> 00:17:41,190
.هكذا إذن، ستكون زوجًا صالحًا يومًا ما

233
00:17:41,190 --> 00:17:45,500
.طبيعته ليست كما تخيّلت من أمير إمبراطورية كو

234
00:17:45,500 --> 00:17:48,000
.أجل، معكِ حق

235
00:17:48,820 --> 00:17:51,600
.اكرهه، اقتله

236
00:17:53,400 --> 00:17:57,760
.مؤخرًا أصبحت أسمع صوتًا في ذهني

237
00:17:58,130 --> 00:18:02,390
.لا بدّ وأنّه صوت ذلك الرجل يحاول استمالتك

238
00:18:02,390 --> 00:18:07,390
.وقد يكون صوت ضميري يهمس لي بحقيقة ما أشعر

239
00:18:07,390 --> 00:18:11,650
.لهذا لستُ مرتاحًا لفكرة السفر معه

240
00:18:12,480 --> 00:18:14,100
.ستكون الأمور على ما يرام

241
00:18:14,100 --> 00:18:15,640
...ولكن

242
00:18:16,240 --> 00:18:20,560
.قد تحمل في أعماقك مشاعر الكراهية نحوه ممّا يحفِّزك لقتله

243
00:18:20,560 --> 00:18:22,810
.ولكن ينبغي عليك تعلُّم كبحها والصفح عنه

244
00:18:23,350 --> 00:18:25,460
.ستكون هذه مهمتك الأخرى

245
00:18:33,150 --> 00:18:36,420
أما كان من الأفضل لك تفادي الإصابة باللعنة؟

246
00:18:37,050 --> 00:18:40,480
.إصابتي ستحُثَّهم على السّعي في مهمتهم

247
00:18:40,480 --> 00:18:41,900
!سن

248
00:18:41,900 --> 00:18:48,790
.وإنْ كانت منظمة الثامن تتعقّبهم، فسيكونون بمأمنٍ في البرج المحصّن

249
00:19:09,980 --> 00:19:12,580
.لم أتوقع أن يكون المكان مفعمًا بالنَّشاط

250
00:19:13,160 --> 00:19:18,590
.قد سبق وأن قرأتُ عن قبائل توران خلال دراستي، ولكن لأول مرّة أراهم فعليًّا

251
00:19:21,410 --> 00:19:22,160
.أرجو المعذرة

252
00:19:22,160 --> 00:19:24,430
.لهذا أخبرتك أن تمشي على مهل

253
00:19:38,380 --> 00:19:39,510
ما الأمر؟

254
00:19:39,510 --> 00:19:40,980
.لا شيء

255
00:19:40,980 --> 00:19:42,200
.عفوًا

256
00:19:42,200 --> 00:19:45,810
هل ستدخلون البرج المحصّن؟

257
00:19:45,810 --> 00:19:47,200
.نعم

258
00:19:47,200 --> 00:19:49,010
.إذن لديّ طلب

259
00:19:49,010 --> 00:19:51,330
.رجاءً اصطحبوني معكم

260
00:19:51,330 --> 00:19:53,840
.أريد إنقاذ والديّ

261
00:19:56,660 --> 00:19:58,920
...هل والديكِ قد

262
00:19:58,920 --> 00:20:00,710
عن ماذا تتحدثين؟

263
00:20:00,710 --> 00:20:04,760
.متاهة زاغن تتغذى على النَّاس بخلاف المتاهات الأخرى

264
00:20:04,760 --> 00:20:06,100
تتغذى عليهم؟

265
00:20:06,100 --> 00:20:11,100
.أجل، يشاع أنّ زاغن يسحب ويلتهم كل من يقترب من البرج

266
00:20:11,970 --> 00:20:16,360
.وسمعت أن عددًا من سكّان الجزيرة قد وقعوا فريسة له

267
00:20:17,040 --> 00:20:20,320
.لم يجرؤ شخص على الاقتراب منه منذ ذلك الحين

268
00:20:20,320 --> 00:20:23,820
.والجميع قد سلّم أن كلّ من سُحب مات

269
00:20:23,820 --> 00:20:27,360
.ولكنّي لا زلتُ عازمة على إنقاذ أبي وأمي

270
00:20:27,360 --> 00:20:30,830
!رجاءً اسمحوا لي بمرافقتكم

271
00:20:31,910 --> 00:20:35,360
.لن تكوني سوى حجر عثرة لنا

272
00:20:35,360 --> 00:20:37,090
.لهذا لا طائل من اصطحابكِ

273
00:20:37,090 --> 00:20:39,150
!ولكنّي أريد إنقاذهما

274
00:20:45,030 --> 00:20:45,890
...ولكنّكِ

275
00:20:45,890 --> 00:20:49,680
.فهمت، سأحرص على إنقاذهما

276
00:20:49,680 --> 00:20:50,640
!مهلًا

277
00:20:53,070 --> 00:20:55,720
.سوف أبحث عن والديكِ بكل تأكيد

278
00:20:55,720 --> 00:20:59,570
.وفي حال وجدتهما ميتين، فسأقضي على كلّ حيّ في ذلك البرج

279
00:20:59,570 --> 00:21:01,570
ما رأيكِ؟

280
00:21:08,770 --> 00:21:10,360
.هاكوريو

281
00:21:26,860 --> 00:21:30,140
.أرى أنكِ قررتِ ارتدائها كأساور يا مور

282
00:21:30,140 --> 00:21:33,280
.أجل، وإنْ كنتُ لم أتوصّل بعد لكيفية استخدامها

283
00:21:35,930 --> 00:21:39,270
.الصفح عنه هي مهمتي الأخرى

284
00:21:43,280 --> 00:21:46,570
أرى شيئًا، أَهو برج زاغن؟

285
00:21:49,960 --> 00:21:51,410
ما ذلك الوميض يا ترى؟

286
00:21:51,410 --> 00:21:54,070
.لا بدَّ وأنّه المدخل

287
00:21:55,250 --> 00:21:56,370
ما هذا؟

288
00:22:01,590 --> 00:22:03,000
!علاء الدين

289
00:22:12,880 --> 00:22:15,350
.هذا الإحساس مألوفٌ لديّ

290
00:22:33,840 --> 00:22:36,460
.لقد عدت

291
00:22:38,910 --> 00:22:42,260
!وسوف أنجح في هذه المهمة بالتأكيد

292
00:24:14,380 --> 00:24:17,720
.أهلًا بكم في متاهتي الحيّة

293
00:24:17,720 --> 00:24:21,060
!في الواقع، أنت تكرهني أيضًا

294
00:24:21,060 --> 00:24:24,390
لمَ أنت عنيدٌ لهذه الدّرجة؟

295
00:24:24,390 --> 00:24:26,810
.الحلقة القادمة بعنوان: متاهة زاغن

296
00:24:26,810 --> 00:24:28,940
.أنت لستَ وحيدًا