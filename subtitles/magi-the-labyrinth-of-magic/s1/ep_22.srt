1
00:00:02,020 --> 00:00:03,730
!إيّاك وتحمُّل الأعباء وحدك

2
00:00:04,280 --> 00:00:07,980
.لا أنكر أنّي ضعيف الحيلة

3
00:00:08,380 --> 00:00:12,220
.لطالما خلَّصتني أختي وبقيّة أفراد أسرتي من المخاطر

4
00:00:12,220 --> 00:00:15,460
.ولهذا لا أحبّذ البقاء مستضعفًا بعد الآن

5
00:00:15,460 --> 00:00:16,600
...ولكن برغم ذلك

6
00:00:19,680 --> 00:00:23,040
.رجاءً اسمح لي بالمقاتلة في صفك

7
00:00:23,040 --> 00:00:24,900
.هاكوريو

8
00:00:25,910 --> 00:00:29,350
.أجل، دعني أساندك أيضًا

9
00:00:29,350 --> 00:00:31,550
!لنفتح هذا البرج معًا

10
00:00:32,890 --> 00:00:33,710
!أجل

11
00:02:32,590 --> 00:02:35,550
.أستشعر حضورًا قويًا في أرجاء المكان

12
00:02:35,550 --> 00:02:38,470
.أجل، يوجد العديد من الكائنات بالأسفل

13
00:02:38,470 --> 00:02:40,830
.إنّي أشعر بوجودهم بطريقة ما

14
00:02:54,530 --> 00:02:58,320
.على ما يبدو أن زاغن يريد التخلّص منّا

15
00:02:58,320 --> 00:03:01,320
.بل هو يسعى جاهدًا لتحقيق ذلك

16
00:03:02,270 --> 00:03:04,620
!فلنجعل الأمر عسيرًا عليه

17
00:03:19,580 --> 00:03:21,820
كيف تسير عملية فتح البرج؟

18
00:03:21,820 --> 00:03:22,750
.على خير ما يرام

19
00:03:23,620 --> 00:03:26,640
.لقد انقسموا إلى فريقين في مرحلة ما

20
00:03:26,640 --> 00:03:29,720
.ولكنهم عادوا ليكملوا مسيرتهم كفريقٍ واحد

21
00:03:29,720 --> 00:03:30,770
.هكذا إذن

22
00:03:31,550 --> 00:03:37,780
كنتُ قلقًا حيال علي بابا وهاكوريو
.ولكن يبدو أنّهما على وفاقٍ تامّ

23
00:03:37,780 --> 00:03:40,050
.كم أرجو ذلك

24
00:03:40,050 --> 00:03:42,540
هل يسعكِ توضيح المزيد عن أوضاعهم؟

25
00:03:43,140 --> 00:03:44,710
.هذا أقصى ما أستطيع

26
00:03:45,490 --> 00:03:50,290
.ولكن إنْ مات أحدهم فسوف يتلاشى الطيف المائيّ الّذي يمثّله

27
00:03:50,290 --> 00:03:53,900
.كلّ ما نعرفه هو أنّهم على قيد الحياة

28
00:03:56,160 --> 00:03:57,670
ما الأمر يا ياموريها؟

29
00:03:57,670 --> 00:03:59,040
هل أصابهم مكروه؟

30
00:03:59,530 --> 00:04:00,770
!كلّا

31
00:04:03,340 --> 00:04:04,770
!لا أستطيع الإبقاء على تماسكه

32
00:04:12,040 --> 00:04:12,940
!هذا مستحيل

33
00:04:12,940 --> 00:04:15,940
.أحدهم فسخ حاجز ياموريها

34
00:04:24,910 --> 00:04:26,200
!جودل

35
00:04:26,830 --> 00:04:28,800
!لتقرع صفّارة الإنذار حالًا

36
00:04:28,800 --> 00:04:29,450
.عُلم

37
00:04:29,450 --> 00:04:32,460
!ليتوزع الحرس الملكيّ في ميدان القصر

38
00:04:44,560 --> 00:04:47,390
ما الأمر؟ علام التجهُّم؟

39
00:04:47,830 --> 00:04:48,770
.تبًا لك

40
00:04:50,520 --> 00:04:53,520
.الحاوية التابعة: سيّ برّاق

41
00:05:02,890 --> 00:05:04,760
.تنحّ عن الطريق أيّها الهزيل

42
00:05:04,760 --> 00:05:07,450
.أنا هنا لملاقاة سندباد

43
00:05:14,520 --> 00:05:16,280
ماذا قلت؟

44
00:05:16,280 --> 00:05:18,080
.كفى يا جعفر

45
00:05:21,400 --> 00:05:23,460
لمَ أنت هنا يا جودل؟

46
00:05:24,860 --> 00:05:27,970
.تبدو مريعًا يا سندباد

47
00:05:27,970 --> 00:05:30,580
ما تلك البقعة الّتي تلطخ وجهك؟

48
00:05:31,620 --> 00:05:34,850
.لا أعتقد أنّك هنا لتستفسر عن حالي

49
00:05:36,320 --> 00:05:38,610
.إنّك تعاملني بجفاء كما المعتاد

50
00:05:49,120 --> 00:05:49,850
!هيّا

51
00:06:00,440 --> 00:06:01,860
.أشكرك يا هاكوريو

52
00:06:01,860 --> 00:06:03,680
.فضلًا دعني أتولى حمايتك

53
00:06:03,680 --> 00:06:05,430
.سأبذل قصارى جهدي لتأمين الحماية لك

54
00:06:09,160 --> 00:06:13,730
.كنتُ قلقةٌ حيال تنافرهما، ولكنهما على انسجامٍ الآن

55
00:06:14,480 --> 00:06:15,560
.عليّ أداء واجبي أيضًا

56
00:06:25,840 --> 00:06:27,320
!لا تنفعلي يا مرجانة

57
00:06:28,380 --> 00:06:30,580
!ولكنّي سعيدة

58
00:06:32,190 --> 00:06:36,180
!لأننا نتقاتل جنبًا إلى جنب

59
00:06:42,060 --> 00:06:44,220
.أخبرني يا سندباد

60
00:06:44,220 --> 00:06:47,090
ما رأيك به؟

61
00:06:48,610 --> 00:06:49,890
إلى من تشير؟

62
00:06:51,330 --> 00:06:52,830
.علاء الدين

63
00:06:53,650 --> 00:06:58,100
أَليس من الغريب وجود ماغي إضافي في هذا العالم؟

64
00:07:00,100 --> 00:07:04,430
.لأول مرّة يتواجد أكثر من ثلاثة ماغي في زمنٍ واحد

65
00:07:04,430 --> 00:07:06,110
.تعلم ما أتحدث عنه

66
00:07:06,840 --> 00:07:09,900
.فقد ورَد ذكره في التاريخ

67
00:07:09,900 --> 00:07:16,120
.أن ثلاثة من الماغي يختاروا الملوك ويساهموا في إعادة تأسيس العالم وبنائه

68
00:07:16,760 --> 00:07:19,120
.زمننا قائمٌ على ذلك النهج

69
00:07:19,780 --> 00:07:21,750
.أنا الأول

70
00:07:21,750 --> 00:07:23,820
.ومن ثمّ تلك العجوز في ريّم

71
00:07:23,820 --> 00:07:30,130
.ومن ثمّ ذلك الرحّال الذّي يجوب العالم لإظهار الأبراج وبعدها يختفي دون أثر

72
00:07:31,200 --> 00:07:33,420
.نحن سنقوم مقام أولئك الثلاثة

73
00:07:33,420 --> 00:07:38,140
.وإنْ ظهر ماغي جديد فهذا يعني أن أحدنا قد مات

74
00:07:38,140 --> 00:07:40,900
!ولكن لم يرد على مسامعي نبأ موت الآخرين

75
00:07:40,900 --> 00:07:43,640
إذن ما الغاية من وجوده؟

76
00:07:44,600 --> 00:07:48,470
.لم يسبق وأن ظهر ماغي رابع إضافي بجانب الثلاثة الآخرين

77
00:07:48,920 --> 00:07:50,150
.ذلك هو علاء الدين

78
00:07:50,660 --> 00:07:56,660
.علاوة على أنّه في آخر لقاءٍ لنا، استخدم قوة غامضة أجهل ماهيّتها

79
00:07:56,660 --> 00:08:01,710
.ومنذ ذلك الحين أصبح كبار المنظمة يتلهّفون إلى الاستحواذ عليها

80
00:08:01,710 --> 00:08:05,410
.وعلى ما أظنّ أنك تسلك نفس سبيلهم

81
00:08:06,120 --> 00:08:07,170
إلَام ترمي بقولك؟

82
00:08:07,170 --> 00:08:09,180
.لا تتحامق

83
00:08:09,180 --> 00:08:11,170
علَام تخطّط؟

84
00:08:11,800 --> 00:08:16,430
ما مبتغاك من ذلك الضئيل؟

85
00:08:17,900 --> 00:08:19,680
.ذلك ليس من شأنك

86
00:08:20,900 --> 00:08:22,790
.كم هذا فظّ

87
00:08:22,790 --> 00:08:25,420
.لا زلتُ وحيدًا كما تعلم

88
00:08:25,420 --> 00:08:27,690
.ولا زلتُ أطمح إلى الاتحاد معك

89
00:08:27,690 --> 00:08:30,610
.إنّك من أفراد تلك المنظمة

90
00:08:31,320 --> 00:08:35,950
هل نسيت ما فعلت لنا في بارتڤيا؟

91
00:08:44,200 --> 00:08:47,290
.لا تكن غليظًا يا سندباد

92
00:08:48,180 --> 00:08:50,210
...أنا

93
00:08:53,930 --> 00:08:58,220
.أنا أيضًا أحد ضحايا الثامن

94
00:09:00,750 --> 00:09:06,440
.ذلك الماغي الضئيل أطْلعني على صورٍ من الماضي

95
00:09:08,760 --> 00:09:11,360
.الرخ قد اختارتني

96
00:09:11,360 --> 00:09:14,630
.منذ لحظة ولادتي في قرية صغيرة في الشرق

97
00:09:14,630 --> 00:09:19,290
.ولكن المنظمة اختطفني وقتلت والديّ

98
00:09:19,490 --> 00:09:24,900
.وقد استغلوني ودفعوني لخدمة مصالحم بزعمهم أني ماغي تابعٌ لهم

99
00:09:25,680 --> 00:09:27,880
.هذا حالي منذ أن كنتُ طفلًا

100
00:09:29,920 --> 00:09:34,010
هل أنا الملام فيما حصل؟

101
00:09:34,010 --> 00:09:37,340
!لكم أرغب في استعادة حياتي الطبيعية

102
00:09:37,340 --> 00:09:41,260
هل ستؤاخذني على ذنبٍ خارج عن إرادتي يا سندباد؟

103
00:09:46,490 --> 00:09:47,750
.جودل

104
00:09:55,260 --> 00:09:56,760
!لا أستطيع الاستمرار

105
00:10:00,360 --> 00:10:02,410
أَحقًا شعرت بالأسى عليّ؟

106
00:10:03,040 --> 00:10:06,440
.كم أنت رقيق القلب

107
00:10:09,290 --> 00:10:10,290
!جودل

108
00:10:10,290 --> 00:10:12,340
.لا تسئ فهمي

109
00:10:12,340 --> 00:10:17,270
.ما سمعته منذ قليل كانت الحقيقة، ولكنّي لا أكترث لمآل الأمور

110
00:10:17,270 --> 00:10:20,050
.وسأستمر في فعل كلّ ما يحلو لي

111
00:10:20,660 --> 00:10:23,870
إذن فقد قطعت هذه المسافة لتهزأ بي؟

112
00:10:23,870 --> 00:10:26,060
.بوركت جهودك

113
00:10:26,660 --> 00:10:32,050
.وبما أنك فرغت من حديثك، فنحن بدورنا نريد الترفيه عنك

114
00:10:45,090 --> 00:10:47,800
.هذا صحيح، لا زال بجعبتي ما أخبرك به

115
00:10:47,800 --> 00:10:51,040
.إنّ كبار المنظمة يسعون الآن للقضاء عليك

116
00:10:52,540 --> 00:10:55,050
.إنها غلطتك يا سندباد

117
00:10:55,050 --> 00:11:00,550
.إنّك تحاول استمالة ذلك الضئيل ورفاقه إلى صفك ممّا أثار حنقهم

118
00:11:00,550 --> 00:11:04,780
.ولن يتسلّلوا إليك في الخفاء بل سوف يتحرّكون نحوك بشكلٍ مباشر

119
00:11:05,480 --> 00:11:06,440
...إنْ جاز القول

120
00:11:07,280 --> 00:11:08,440
.إنّهم قادمون لمحاربتك

121
00:11:15,710 --> 00:11:17,690
.وعلاوة على ذلك

122
00:11:17,690 --> 00:11:22,700
.لا أعتقد أن ذلك الضئيل ورفاقه بمأمنٍ في متاهة زاغن

123
00:11:22,700 --> 00:11:23,490
ماذا؟

124
00:11:23,490 --> 00:11:25,720
.كم يؤسفني إعلامك بهذا

125
00:11:25,720 --> 00:11:30,200
ما تقوله غير معقول، هل بعثت المنظمة من يتعقّبهم إلى متاهة زاعن؟

126
00:11:30,800 --> 00:11:35,230
.أَلم تكن مصغيًا إليّ؟ إنّهم عازمون على تحقيق مرادهم

127
00:11:38,650 --> 00:11:41,080
.وأخيرًا وصلنا إلى حيزٍ فسيح

128
00:11:42,970 --> 00:11:45,990
.لا بأس بكم

129
00:11:48,980 --> 00:11:50,680
!زاغن

130
00:11:50,680 --> 00:11:53,100
!أطلق سراح القرويّين في الحال

131
00:11:53,100 --> 00:11:55,070
.لا أريد

132
00:11:55,070 --> 00:11:55,730
ماذا؟

133
00:11:55,730 --> 00:11:57,970
ما العمل في هذه الحالة؟

134
00:11:57,970 --> 00:11:59,960
القضاء عليّ؟

135
00:11:59,960 --> 00:12:04,680
ولكن أَلستم هنا رغبة في خدمة منّي؟

136
00:12:04,680 --> 00:12:06,240
.رصاص حار حار

137
00:12:11,350 --> 00:12:15,290
.أرى أنكم في غنى عن مساعدتي إذن

138
00:12:15,910 --> 00:12:17,380
من أنت؟

139
00:12:18,540 --> 00:12:19,380
علاء الدين؟

140
00:12:20,380 --> 00:12:25,520
.إنّ كنتَ جانًّا لكنت َحصينًا ضد الضربات السحريّة الضعيفة

141
00:12:26,470 --> 00:12:30,560
.ولكن أجزاءً منك قد احترقت

142
00:12:32,620 --> 00:12:35,030
!عرّف عن نفسك

143
00:12:35,030 --> 00:12:36,390
من أنت؟

144
00:12:36,390 --> 00:12:37,570
من تكون؟

145
00:12:38,800 --> 00:12:41,320
.يا إلهي، لقد أفسدت استمتاعي

146
00:12:41,320 --> 00:12:44,320
.أردتُ بثّ المزيد من الفزع فيكم

147
00:12:45,400 --> 00:12:48,960
.أنا لستُ من الجنّ كما قال الماغي

148
00:12:48,960 --> 00:12:52,580
.أنا من كائنات البرج ولكن اصطنعني زاغن لأكون شبيهًا له

149
00:12:55,560 --> 00:12:57,170
!أيّها المخادع

150
00:12:57,170 --> 00:13:03,550
كيف سوّلت لك نفسك اختطاف القرويّين وتعريضهم لتلك الهوائل؟

151
00:13:03,550 --> 00:13:07,330
يا إلهي، علَام الغضب؟

152
00:13:07,330 --> 00:13:09,560
.كان ذلك من باب اللّهو فحسب

153
00:13:10,630 --> 00:13:11,930
لهو؟

154
00:13:16,800 --> 00:13:18,400
!لا تعبث معي

155
00:13:19,210 --> 00:13:22,840
!لن أكبح نفسي بعد الآن بما أنك لست زاغن

156
00:13:22,840 --> 00:13:26,400
!حلّ السحر فورًا عن القرويّين ليعودوا إلى هيئتهم الطبيعية

157
00:13:26,400 --> 00:13:29,620
.إنّ ذلك من امكانيات السيّد الحقيقي فقط

158
00:13:29,620 --> 00:13:32,410
.إنْ أردت لقائه فلتّتجه إلى غرفة الكنز

159
00:13:32,410 --> 00:13:34,040
!حسم الأمر

160
00:13:34,040 --> 00:13:34,870
!سوف أقصدها

161
00:13:41,620 --> 00:13:42,940
.قضى عليه بسهولة

162
00:13:42,940 --> 00:13:44,960
.كلّا للأسف

163
00:13:47,120 --> 00:13:49,470
بما أن سيّدي زاغن هو جانّ مسخّرٌ لقوة الأرض

164
00:13:52,310 --> 00:13:57,300
.بوسعي إنعاش نفسي مرارًا وتكرارًا من خلال تربة البرج

165
00:14:11,160 --> 00:14:12,500
!سيّد علي بابا

166
00:14:14,080 --> 00:14:15,330
!هاكوريو

167
00:14:19,730 --> 00:14:22,090
ما السبيل لمجابهة هذا المسخ؟

168
00:14:22,470 --> 00:14:24,460
!لننسحب في الحال يا مور

169
00:14:24,460 --> 00:14:24,970
!حسنٌ

170
00:14:25,500 --> 00:14:27,540
ستهربون؟

171
00:14:27,540 --> 00:14:31,720
.للأسف لا مهرب لكم من هنا

172
00:14:43,200 --> 00:14:44,190
.إنّها عميقة

173
00:14:48,000 --> 00:14:49,220
!هنالك شيءٌ ما

174
00:14:49,220 --> 00:14:51,840
.تلك هيئتي الحقيقية

175
00:14:51,840 --> 00:14:55,450
.ولسوف أبتلعكم تمامًا فور ما تصلون إلى القاع

176
00:14:56,810 --> 00:14:57,830
!مور

177
00:14:57,830 --> 00:14:59,340
!اصعدي بالجميع على البساط

178
00:14:59,340 --> 00:14:59,960
!لن تفعلوا

179
00:15:04,930 --> 00:15:08,530
!كلّا، سوف يُقضى على كلّ شيء

180
00:15:09,090 --> 00:15:11,460
.على أعزائي

181
00:15:11,460 --> 00:15:13,350
.وعلى ما نصبو إليه سويًا

182
00:15:16,690 --> 00:15:18,020
.لا أستطيع الوصول إليهم

183
00:15:18,800 --> 00:15:22,520
ولا أستطيع الوصول إلى الجدار

184
00:15:23,450 --> 00:15:24,790
!لأطير نحوهم

185
00:15:26,150 --> 00:15:28,780
.أنتِ كالطير يا مور

186
00:15:29,920 --> 00:15:31,660
...لو أني

187
00:15:32,200 --> 00:15:36,520
!لو أني أمتلكُ أجنحة لاستطعتُ الوصول إليهم

188
00:15:55,140 --> 00:15:57,600
...هل هذا يا مور من فعل

189
00:16:07,090 --> 00:16:08,680
ما هذا الصوت؟

190
00:16:11,040 --> 00:16:12,070
ماذا؟

191
00:16:14,830 --> 00:16:17,950
كيف استطاعوا الخروج من هناك؟

192
00:16:17,950 --> 00:16:20,230
.فضلًا ابقوا هنا

193
00:16:20,230 --> 00:16:21,240
مور؟

194
00:16:22,360 --> 00:16:24,130
.سوف أهبط إلى الأسفل لأقضي عليه

195
00:16:27,370 --> 00:16:29,100
هل جننتِ؟

196
00:16:29,100 --> 00:16:34,550
ستقفزين إلى فمي مباشرة بعدما نجوتِ بنفسكِ؟

197
00:16:34,550 --> 00:16:37,310
!لسوف أتلذذ بالتهامكِ

198
00:16:50,560 --> 00:16:53,450
.إنّها تستغل السلاسل لتتنقّل بواسطتها

199
00:16:54,790 --> 00:16:58,160
.إنّي أبعث بالسلاسل على التّوالي كما لو أنها ذراعيّ

200
00:17:01,130 --> 00:17:04,040
!إذن هذه هي منفعة حاويتي التابعة

201
00:17:04,860 --> 00:17:06,490
.لا تغتري بنفسكِ

202
00:17:06,490 --> 00:17:10,800
ما الجدوى الآن من تلك السلاسل البغيضة؟

203
00:17:19,560 --> 00:17:22,850
ما عساي أن أفعل؟

204
00:17:28,720 --> 00:17:29,820
.إنّها ساخنة

205
00:17:38,160 --> 00:17:40,660
.تجلِّي بقوّتكِ

206
00:17:40,660 --> 00:17:42,640
.أنا القوة التابعة

207
00:17:42,640 --> 00:17:47,260
.اصطنعني آمون جانّ اللهب لأكون قوة حاويتكِ

208
00:17:58,860 --> 00:18:02,760
.الحاوية التابعة: سلسلة الأمل

209
00:18:08,680 --> 00:18:10,250
ماذا؟

210
00:18:12,400 --> 00:18:15,530
!مستحيل

211
00:18:23,160 --> 00:18:24,820
!لقد نجحت

212
00:18:24,820 --> 00:18:27,680
.ها قد عرفتُ كيفية استغلال قوة حاويتي

213
00:18:27,680 --> 00:18:30,320
.بوسعي الآن تقديم المزيد من المساعدة لهم

214
00:18:34,200 --> 00:18:37,010
...لقد...لقد

215
00:18:38,090 --> 00:18:41,260
.لقد نجحت يا رفاق

216
00:18:42,680 --> 00:18:45,110
!كم أنتِ رائعة يا مرجانة

217
00:18:45,110 --> 00:18:47,100
!أحسنتِ يا مور

218
00:18:47,100 --> 00:18:48,770
.كنتِ مذهلة

219
00:18:57,850 --> 00:18:59,870
مرجانة؟

220
00:18:59,870 --> 00:19:01,560
مور؟

221
00:19:01,560 --> 00:19:03,240
آنسة مرجانة؟

222
00:19:03,240 --> 00:19:06,940
ماذا حصل يا مرجانة؟

223
00:19:18,960 --> 00:19:19,850
.مرجانة

224
00:19:19,850 --> 00:19:22,030
!تماسكي يا مرجانة

225
00:19:22,030 --> 00:19:23,370
!مور

226
00:19:23,370 --> 00:19:24,470
!آنسة مرجانة

227
00:19:24,470 --> 00:19:26,970
ماذا حدث يا مرجانة؟

228
00:19:28,240 --> 00:19:30,730
.لقد استهلكت مور كامل الماغوي

229
00:19:30,730 --> 00:19:31,600
ماذا؟

230
00:19:31,600 --> 00:19:35,500
.لا بدّ وأنّ تلك الضربة الساحقة قد استنفذت أوج طاقتها

231
00:19:35,960 --> 00:19:39,990
.لا سيّما وأن حصيلة الماغوي لدى مور ضئيلةٌ في الأساس

232
00:19:40,550 --> 00:19:45,490
.ولكن بذل الماغوي دفعة واحدة قد جعل حياتها عرضة للخطر

233
00:19:46,940 --> 00:19:50,700
.إنّها منهكةٌ ولن يسعها استعادة عافيتها على هذا النحو

234
00:19:51,390 --> 00:19:53,390
.علينا نقلها إلى الخارج لتلقّي العلاج

235
00:19:58,460 --> 00:20:00,720
...ما زال بوسعي

236
00:20:00,720 --> 00:20:02,920
!لا تجهدي نفسكِ

237
00:20:04,280 --> 00:20:09,750
...وأخيرًا تمكّنت من مساعدتكم

238
00:20:14,800 --> 00:20:15,980
!مرجانة

239
00:20:17,150 --> 00:20:19,990
.أنا آسفة يا علي بابا

240
00:20:28,800 --> 00:20:33,020
لقد بذلتِ ما بوسعكِ
أنتِ الآن بحاجةٍ للخضوع إلى العلاج

241
00:20:40,770 --> 00:20:41,510
!أنتم هنا

242
00:20:42,520 --> 00:20:43,800
!تيارا

243
00:20:50,280 --> 00:20:51,660
.كم أنا سعيدٌ لرؤيتكِ سالمة

244
00:20:55,680 --> 00:20:56,980
.لنسرع إلى غرفة الكنز

245
00:20:57,680 --> 00:20:58,980
.وننقذ الجميع

246
00:21:09,160 --> 00:21:11,160
!افتح يا سمسم

247
00:21:42,480 --> 00:21:45,450
.ها قد التقينا مجدّدا أيّها الماغي

248
00:21:48,550 --> 00:21:50,640
.والملك علي بابا أيضًا

249
00:21:53,820 --> 00:21:55,910
كيف حال جرحك؟

250
00:21:55,910 --> 00:21:57,560
!تبًا لك

251
00:21:57,560 --> 00:22:03,670
.استطعت الولوج لأعمق نقطة في متاهة زاغن برغم تلك الإصابة

252
00:22:03,670 --> 00:22:08,390
.بوركت جهودك أيّها الماغي وأيّها الملك المرشّح أيضًا

253
00:22:08,390 --> 00:22:11,030
.ولكن أخشى أنكم بلغتم نهاية الطريق

254
00:22:11,030 --> 00:22:12,320
!اخرس

255
00:22:12,320 --> 00:22:14,560
!لن تستولي على زاغن

256
00:22:14,560 --> 00:22:18,240
.ولكن زاغن مكسب إضافي

257
00:22:18,240 --> 00:22:21,440
.إنّه ليس هدفي الأساسي

258
00:22:21,440 --> 00:22:22,680
ماذا؟

259
00:22:23,370 --> 00:22:25,820
.بل أنتم جميعًا

260
00:22:26,450 --> 00:22:33,450
.سوف أُكرم والدنا بتقديم حكمة سليمان وحياة الملك علي بابا إليه

261
00:22:35,450 --> 00:22:39,710
!إنّ كلّ الأمور تسير وفق أجندة الثامن

262
00:24:14,930 --> 00:24:17,850
.لقد كنتُ في الحقيقة أودّ التّشارك معك يا سندباد

263
00:24:17,850 --> 00:24:20,140
.سوف أقتلكم

264
00:24:20,140 --> 00:24:22,850
.نحن سنقاتل، وأنا سأشقّ الطّريق بنفسي

265
00:24:22,850 --> 00:24:24,850
.الحلقة القادمة بعنوان: صرخة معركة

266
00:24:24,850 --> 00:24:25,810
حرب؟

267
00:24:25,810 --> 00:24:28,940
!سحقًا! لن أسمح لكم بفعلها