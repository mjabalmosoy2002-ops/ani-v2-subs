203
00:12:48,510 --> 00:12:51,320
هل تظنّ أنّك تستطيع إيقافي بذلك الخنجر؟

204
00:12:51,940 --> 00:12:54,660
.ثرثر كما تريد بينما تستطيع

205
00:12:57,460 --> 00:12:59,500
.تبًّا، لم تأكل الطعم

206
00:12:59,500 --> 00:13:01,720
!لستُ رجلًا متهاونًا

207
00:13:03,880 --> 00:13:05,160
!رصاصة الماء المشتّتة

208
00:13:14,480 --> 00:13:15,600
!تايتشي

209
00:13:16,580 --> 00:13:18,360
.يا للأحمق

210
00:13:36,440 --> 00:13:38,630
.أنت عنيد للغاية أيضًا

211
00:13:38,630 --> 00:13:40,810
.لقد أُنهكنا نحن الاثنان

212
00:13:41,860 --> 00:13:45,260
.لم أُجهَد هكذا مذ ذلك اليوم

213
00:13:45,260 --> 00:13:46,520
ماذا الآن؟

214
00:13:46,520 --> 00:13:48,010
هل نتابع؟

215
00:13:48,010 --> 00:13:49,800
.أجل

216
00:13:49,800 --> 00:13:52,380
.فلننهِ هذا بالهجوم التالي

217
00:13:56,890 --> 00:14:01,460
إذًا، سأفوز إن استطعتُ فعل شيء بشأن ذلك؟

218
00:14:02,870 --> 00:14:05,250
.لا أملك قوّة كافية حقًّا

219
00:14:05,250 --> 00:14:06,570
...على هذا الحال

220
00:14:08,770 --> 00:14:09,740
!هلمّ إليّ

221
00:14:10,950 --> 00:14:12,150
!فكّر

222
00:14:12,150 --> 00:14:15,160
كيف يمكنني أن أهزمه بالقوّة التي أملك الآن؟

223
00:14:16,820 --> 00:14:18,120
!استذكر

224
00:14:18,120 --> 00:14:20,560
!تذكّر ما تعلّمت

225
00:14:20,560 --> 00:14:22,460
!تايتشي، ركّز

226
00:14:24,590 --> 00:14:27,510
.تخيّل قوّتك السحرية تظهر بترسّخ قدر الإمكان

227
00:14:30,660 --> 00:14:32,510
!يجب أن أتخيّل سحري

228
00:14:39,770 --> 00:14:40,560
!ماذا؟

229
00:14:46,600 --> 00:14:47,930
إذًا؟

230
00:14:47,930 --> 00:14:50,610
عملي الجاد جيّد للغاية أيضًا، أليس كذلك؟

231
00:14:55,330 --> 00:14:57,300
.لم تترك لي خيارًا

232
00:14:58,020 --> 00:14:59,600
.يجب أن أعترف

233
00:15:00,310 --> 00:15:02,170
.لقد خسرت

234
00:15:03,490 --> 00:15:07,930
.لا، ربّما كانت لي الأفضلية لأنّ لديك ذراع واحدة

235
00:15:08,450 --> 00:15:12,760
.ذاك بالكاد يُحتسب سببًا

236
00:15:13,600 --> 00:15:18,100
.المعارك تتطلّبك دائمًا أن تقاتل بالبطاقات المتوفرة لديك

237
00:15:18,980 --> 00:15:20,440
!تبًّا

238
00:15:20,440 --> 00:15:23,400
!والآن أسرع وأعد قوّة تايتشي

239
00:15:23,400 --> 00:15:25,570
هل تريد أن تعرف كيف تُلغيها؟

240
00:15:26,280 --> 00:15:27,790
.هذا بسيط

241
00:15:27,790 --> 00:15:29,990
.فقط دمّر تلك الأداة السحرية

242
00:15:30,780 --> 00:15:32,720
.أنت متوافق بشكلٍ كبير

243
00:15:32,720 --> 00:15:35,500
.تحدّيتك في نزالٍ وخسرت

244
00:15:35,500 --> 00:15:39,560
،إن كتمتُ تلك المعلومة
.سأكون مثيرًا للشفقة فحسب

245
00:15:39,560 --> 00:15:40,620
!تايتشي

246
00:15:41,120 --> 00:15:42,650
!هنالك خطب بها

247
00:15:49,200 --> 00:15:50,470
!ما هذا بالضبط؟

248
00:15:55,510 --> 00:15:59,310
.تبًّا! لم يخبرني أيّ أحد عن جولة ثانية

249
00:16:05,920 --> 00:16:06,940
!سحقًا

250
00:16:06,940 --> 00:16:08,780
!ما هذا بالضبط؟

251
00:16:10,610 --> 00:16:11,530
!تايتشي

252
00:16:14,880 --> 00:16:16,950
غرامي، هل كنت هنا؟

253
00:16:20,820 --> 00:16:22,370
!دمّري تلك الأداة السحرية

254
00:16:23,160 --> 00:16:24,580
!الجسد الرئيسي هناك

255
00:16:28,920 --> 00:16:29,920
!بسرعة

256
00:16:41,060 --> 00:16:42,490
لمَ يحدث هذا؟

257
00:16:42,980 --> 00:16:46,900
هل خطّط سيادته لهذا طوال الوقت؟

258
00:16:46,900 --> 00:16:49,420
!لقد كسرنا الجسد الرئيسي، لكنه لا يختفي

259
00:16:49,420 --> 00:16:50,070
ماذا الآن؟

260
00:16:50,070 --> 00:16:53,400
.يجب أن أعصف به في آن واحد

261
00:16:53,400 --> 00:16:55,290
!أيمكنك ذلك؟

262
00:16:55,290 --> 00:16:58,620
!أجل، بما أنّي أستطيع استخدام غشّي مجدّدًا

263
00:16:59,990 --> 00:17:03,000
!إيري، اضغطي الهواء المحيط

264
00:17:03,000 --> 00:17:03,830
!عُلم

265
00:17:10,420 --> 00:17:11,820
.انتهى أمرك

266
00:17:11,820 --> 00:17:14,550
!فلتختف

267
00:17:23,030 --> 00:17:24,650
عادت كلّها، صحيح؟

268
00:17:24,650 --> 00:17:26,520
.أجل، عدت إلى طبيعتك

269
00:17:26,520 --> 00:17:29,130
.كنت قلقة للحظة

270
00:17:30,130 --> 00:17:31,870
.أنقذتني في آخر لحظة

271
00:17:37,640 --> 00:17:39,240
.استخدمه

272
00:17:39,240 --> 00:17:42,560
.أيها الشقي، لا تعذبه أكثر

273
00:17:42,560 --> 00:17:43,840
لمَ تقولين هذا؟

274
00:17:43,840 --> 00:17:44,780
—أنا أساعد

275
00:17:44,780 --> 00:17:47,550
.كبرياؤه محطّم يالفعل

276
00:17:48,750 --> 00:17:52,030
.ذاك الرّجل نادم كما تعلم

277
00:17:52,030 --> 00:17:53,130
نادم؟

278
00:17:53,130 --> 00:17:54,090
.أجل

279
00:17:54,090 --> 00:17:56,800
.لقد خسر أمامك

280
00:17:56,800 --> 00:17:59,690
،ما يعني مهما عملت بجهد

281
00:17:59,690 --> 00:18:01,680
.كانت الجودة خالصة

282
00:18:02,790 --> 00:18:07,600
لكنّه كان مقتنعًا أنّ الاختلاف بين
.قوتيكما كان عائدًا إلى الموهبة فقط

283
00:18:07,920 --> 00:18:10,200
.لم يتقبّل عملك الجاد

284
00:18:10,200 --> 00:18:12,180
.لذا، هذا ما هو نادم عليه

285
00:18:12,180 --> 00:18:13,930
.أنت تثرثرين كثيرًا

286
00:18:13,930 --> 00:18:17,030
.شيءٌ آخر بينما أقول أشياء لا يجب عليّ قولها

287
00:18:17,400 --> 00:18:21,130
.يعلم كم هو صعب أن تبذل مجهودًا كبيرًا

288
00:18:21,130 --> 00:18:24,200
.لذا يبدو أنه يحبّ الناس الذين يعملون بجد

289
00:18:24,200 --> 00:18:25,460
!غرامي

290
00:18:26,000 --> 00:18:27,750
العمل الجاد؟

291
00:18:28,980 --> 00:18:33,080
.الشخص الذي علّمني كان صارمًا للغاية

292
00:18:35,090 --> 00:18:37,930
لقد انهزمتَ بشكلٍ تام لدرجة أنّ ذلك
يبعث بشعور جيّد، أليس كذلك يا كاشيم؟

293
00:18:38,470 --> 00:18:39,880
.اخرسي

294
00:18:47,320 --> 00:18:49,660
كانت لديك معلّمة جيدة، أليس كذلك؟

295
00:19:02,160 --> 00:19:04,040
!ما الذي حدث هنا؟

296
00:19:04,040 --> 00:19:05,440
!ألم تسمع؟

297
00:19:05,440 --> 00:19:07,500
!لقد أعلن جيش الثوار الحرب

298
00:19:07,500 --> 00:19:10,420
!لقد بدأت الحرب أخيرًا

299
00:19:17,970 --> 00:19:21,780
قسم الوحش الذي بداخل تلك الأداة
السحرية شطرين بواسطة الضوء؟

300
00:19:21,780 --> 00:19:22,640
.أجل

301
00:19:22,890 --> 00:19:26,230
أنت لئيمٌ حقًّا، أليس كذلك؟

302
00:19:26,230 --> 00:19:28,060
ماذا تقصدين؟

303
00:19:28,430 --> 00:19:32,640
هل تقول أنّك لم تتنبّأ بحدوث هذا؟

304
00:19:32,640 --> 00:19:39,240
.لقد أعطيته تلك الأداة السحرية فقط كما طُلب منّي

305
00:19:39,240 --> 00:19:41,520
كما طُلب منك؟

306
00:19:41,520 --> 00:19:45,400
.من الصّعب رفض طلبِ تابعٍ ثمين

307
00:19:45,400 --> 00:19:48,250
أليس كذلك؟

308
00:19:48,250 --> 00:19:49,410
.فعلًا

309
00:19:50,120 --> 00:19:52,760
،إن كان ذلك ما يريده حقًّا

310
00:19:52,760 --> 00:19:57,590
.فمن الصّعب إيقافه، مهما كان يخبّئه القدر له

311
00:19:58,530 --> 00:20:01,450
.لقد اكتملت الاستعدادات لتوجيهك

312
00:20:02,120 --> 00:20:03,260
...تبقّى فقط

313
00:20:03,260 --> 00:20:03,970
.أجل

314
00:20:04,770 --> 00:20:08,580
.اذهب وحقّق رغبتك الحقيقية

315
00:20:32,180 --> 00:20:33,770
.حان الوقت أخيرًا

316
00:20:33,770 --> 00:20:34,540
.أجل

317
00:20:35,250 --> 00:20:37,980
.رين، سأحميك مهما كان

318
00:20:39,680 --> 00:20:41,550
.لا يمكنك ذلك يا تايتشي

319
00:20:42,320 --> 00:20:44,080
.سأقاتل أيضًا

320
00:20:44,080 --> 00:20:46,720
!لذا سوف أحميك أيضًا

321
00:20:47,520 --> 00:20:48,640
...رين

322
00:20:52,790 --> 00:20:56,170
.فلنبذل قصارى جهدنا معًا إذًا

323
00:20:56,170 --> 00:20:56,880
!أجل

324
00:22:45,890 --> 00:22:47,640
.انتهت التحضيرات

325
00:22:47,640 --> 00:22:50,000
.الجيش جاهز للتقدّم في أيّة لحظة

326
00:22:50,000 --> 00:22:50,800
.جيد

327
00:22:51,320 --> 00:22:52,970
...الدوق دورتيسهايم

328
00:22:52,970 --> 00:22:55,170
المركيز؟

329
00:22:55,170 --> 00:22:57,510
.هنالك مسألة أريد أن ألتمس معروفك فيها

330
00:22:57,910 --> 00:23:03,720
،هلّا تركتني أتكفّل رجاءً بساحرة الأوراق المتساقطة

331
00:23:03,720 --> 00:23:06,620
وذلكما الشاب والشابة من الأرض الأجنبية؟

332
00:23:07,650 --> 00:23:10,410
.لقد جهّزتُ لهم بالفعل

333
00:23:12,630 --> 00:23:16,450
لن أسمح بأيّ إخفاقات شنيعة
.كما التي ارتكبها المركيز نيلغان

334
00:23:16,450 --> 00:23:22,380
.أعدك أنّي سأجلب لك رؤوس أولئك السحرة الوقحين

335
00:23:36,450 --> 00:23:39,160
".في الحلقة القادمة: "معركة ماروالت