1
00:00:02,390 --> 00:00:04,200
".ترتيل دموي"

2
00:00:04,640 --> 00:00:07,060
.كانت هنالك معركة تُعرف بهذا الاسم

3
00:00:07,780 --> 00:00:11,280
كانت هنالك مناوشات في الحدود بين إمبراطورية غارغين

4
00:00:11,280 --> 00:00:13,700
.وإمبراطورية سكاتوليث المقدّسة قبل 200 سنة

5
00:00:14,240 --> 00:00:15,910
.هناك بدأ كل شيء

6
00:00:17,220 --> 00:00:20,240
،بينما اعتقدوا أنّ المعركة ستنتهي بسرعة

7
00:00:20,240 --> 00:00:24,810
.سرعان ما بدأت، بعثت الذعر في كلتا الدولتين

8
00:00:25,880 --> 00:00:29,130
،فقدتا السيطرة على جنودهما فجأةً

9
00:00:29,130 --> 00:00:31,610
،الذين بدؤوا يقتلون بعضهم وأعداءهم في آن واحد

10
00:00:31,610 --> 00:00:34,130
.ثمّ انتقلوا لقتل النّاس الأبرياء

11
00:00:34,130 --> 00:00:37,260
.أصبحوا محاربين هائجين وبدؤوا ثورتهم

12
00:00:37,970 --> 00:00:40,020
.كانت المعركة الأسوأ التي عرفها التاريخ

13
00:00:40,660 --> 00:00:43,290
،وحينما انتهت موجة القتل تلك أخيرًا

14
00:00:43,290 --> 00:00:47,690
.كانت قد خلّفت 700,000 قتيلًا في كلا الجانبين

15
00:00:57,570 --> 00:01:01,390
ما تسبّب في هيجان أولئك
،الجنود كان مجهولًا في ذلك الوقت

16
00:01:01,390 --> 00:01:03,660
.لكن بدا أنّه من صنيع التحكّم في العقل

17
00:01:03,660 --> 00:01:05,280
!التحكّم في العقل؟

18
00:01:05,280 --> 00:01:06,540
...لكن ذلك

19
00:01:06,540 --> 00:01:11,290
.أجل. التّحكم في العقل لا يندرج تحت أي عنصر سحريّ

20
00:01:11,290 --> 00:01:12,000
...ما يعني

21
00:01:12,960 --> 00:01:18,480
،هذا من صنيع سحرٍ أسود
.القوّة التي يحملها كيانٌ ظلاميّ

22
00:01:18,480 --> 00:01:19,680
...إذًا

23
00:01:19,680 --> 00:01:24,640
ما لم نقضِ على المنشئ الذي
.يُفعّل التعويذة، لا يمكننا إبطالها

24
00:01:24,640 --> 00:01:28,140
إلى حين ذلك، سيظلّ أولئك الرّجال
،بدون مشاعر أو إحساس بالألم

25
00:01:28,140 --> 00:01:31,940
.بل فقط بتعطّشهم لسفك الدماء والقتل

26
00:01:45,720 --> 00:01:48,080
،إلّم نوقفهم هنا

27
00:01:48,080 --> 00:01:52,630
،سيزحفون إلى العاصمة الملكية، وينيفيكس، وما بعدها

28
00:01:53,220 --> 00:01:56,550
.حتّى يُزهقوا حياة المئات بل مئات الآلاف من النّاس

29
00:02:04,870 --> 00:02:08,540
.أتطلّع لهذا الآن

30
00:02:16,660 --> 00:02:18,150
!لا يعرفون متى يستسلمون

31
00:02:18,510 --> 00:02:19,840
!كيف حالك؟

32
00:02:19,840 --> 00:02:21,630
هل تحتاجين أن تسألي؟

33
00:02:21,630 --> 00:02:23,450
!يستمرّون في القدوم مهما هزمتُ منهم

34
00:02:24,460 --> 00:02:27,330
أنت تتصرّفين بلينٍ وترفضين قتلهم، أليس كذلك؟

35
00:02:28,210 --> 00:02:29,960
...أنا

36
00:02:30,480 --> 00:02:32,250
.أعلم أنّ هذا ساذج

37
00:02:33,180 --> 00:02:35,740
لكنّني أريد استخدام هذه القوة

38
00:02:37,200 --> 00:02:39,290
!لإنقاذ الناس

39
00:02:42,850 --> 00:02:44,880
.أنت ليّنة

40
00:02:44,880 --> 00:02:45,630
...سوسورا

41
00:02:46,270 --> 00:02:49,150
قلتِ أنّك مأجورة، صحيح؟

42
00:02:49,150 --> 00:02:50,030
.أجل

43
00:02:50,030 --> 00:02:52,780
هل تودّين تغيير موكّلك وتعملين لأجلي؟

44
00:02:52,780 --> 00:02:53,980
ماذا؟

45
00:02:53,980 --> 00:02:56,940
.عملك هو القتال إلى جانبي

46
00:02:56,940 --> 00:02:59,490
.وسينتهي فور أن ننجو من هذا

47
00:03:00,210 --> 00:03:01,240
إذًا؟

48
00:03:01,240 --> 00:03:02,540
ليس عرضًا سيّئًا، أليس كذلك؟

49
00:03:05,580 --> 00:03:07,420
.أنا معجبة بك لذا سأقبل

50
00:03:07,420 --> 00:03:10,190
.سأعقد اتّفاقًا وأحدّد ثمنًا كبقائي

51
00:03:10,190 --> 00:03:11,710
!اتفقنا إذًا

52
00:03:11,710 --> 00:03:14,430
أجل، ما العمل الآن؟

53
00:03:14,430 --> 00:03:16,000
...صحيح. أولًا

54
00:03:19,280 --> 00:03:21,030
.فلنجتمع مع حلفائنا

55
00:03:32,710 --> 00:03:34,440
.ألقيتُ نظرة يا تايتشي

56
00:03:35,060 --> 00:03:35,980
كيف وضعهم؟

57
00:03:35,980 --> 00:03:38,190
.ليس جيّدًا. إنّهم يُدفعون إلى الخلف

58
00:03:38,190 --> 00:03:40,780
.الجنود الواقعون تحت تلك التعويذة أقوياء جدًّا

59
00:03:42,310 --> 00:03:43,110
.لا عجب

60
00:03:43,860 --> 00:03:46,540
.لا يهتمّون حتّى إن أصيبوا بالأذى

61
00:03:46,540 --> 00:03:48,300
.ما يضعنا في وضعٍ غير مؤات

62
00:03:48,300 --> 00:03:49,380
.أجل

63
00:03:49,380 --> 00:03:51,250
!لمَ تتردّد؟

64
00:03:51,960 --> 00:03:55,380
!يجب أن نمنع تكرار تلك الفاجعة مهما كان

65
00:03:58,240 --> 00:04:00,590
.قد يكون هذا قاسيًا، لكن لا مفر منه

66
00:04:01,090 --> 00:04:03,300
...تلك التعويذة التي ألقاها إينيميكس

67
00:04:03,300 --> 00:04:06,760
.ليس بالشيء الذي يمكن للإنسان التعامل معه عادةً

68
00:04:08,570 --> 00:04:11,200
!أملك سيّدًا واحدًا

69
00:04:11,200 --> 00:04:13,940
!وهو تلك المرأة لا غير

70
00:04:13,940 --> 00:04:18,480
!الكيان الأسمى الذي يحرس هذا العالم

71
00:04:19,950 --> 00:04:23,480
أتقصد أنّ "تلك المرأة" كانت تعيره القوة؟

72
00:04:23,480 --> 00:04:25,360
.لا أجد أيّ احتمال آخر

73
00:04:26,120 --> 00:04:29,930
تايتشي، لقد افتعلت هذه الحرب

74
00:04:29,930 --> 00:04:32,620
.لأجل تطويقك ووضعك في هذا المأزق

75
00:04:33,920 --> 00:04:35,540
!كلّ هذا لأجل ذلك؟

76
00:04:36,320 --> 00:04:37,510
...تايتشي

77
00:04:41,860 --> 00:04:43,720
.هذا ساخر

78
00:04:44,850 --> 00:04:51,050
.يمكنني أن أعرف ما يفكّر فيه أخي جيلمار بالضّبط الآن

79
00:04:55,160 --> 00:04:59,770
أخي... لا، ملكنا سيأمر بهذا

80
00:05:00,090 --> 00:05:04,700
".أوقفوهم ولو كلّفنا ذلك جيشنا بكامله"

81
00:05:05,570 --> 00:05:08,980
.حتّى إن عنى ذلك التضحية بكلّ مواطن في إيليستين

82
00:05:12,770 --> 00:05:16,500
.لقد دمّرت دولتنا في محاولتي لحمايتها

83
00:05:17,750 --> 00:05:21,530
.سيتذكّرني التّاريخ كشرّير لا محالة

84
00:05:23,640 --> 00:05:26,150
.في تلك الحالة، علينا إيقافهم هنا فحسب

85
00:05:29,840 --> 00:05:30,940
تايتشي؟

86
00:05:34,490 --> 00:05:39,170
،إن وهبني غشٌّ ما هذه القوّة

87
00:05:39,170 --> 00:05:42,020
.فأريد أن أسخّرها لأحمي

88
00:05:44,360 --> 00:05:46,070
.لأحمي النّاس الأعزّاء عليّ

89
00:05:57,730 --> 00:05:59,750
.لأحمي أصدقائي

90
00:06:00,160 --> 00:06:02,090
!تقدّموا

91
00:06:02,410 --> 00:06:05,460
،إن كنتُ أملك القوّة لتدمير دولة

92
00:06:05,860 --> 00:06:08,380
.أريد أن أحوّلها إلى قوّة تُنقذ دولة

93
00:06:10,960 --> 00:06:15,290
،هنالك أوقات حيث على أصحاب السلطة أن يحقّقوا شيئًا"

94
00:06:15,290 --> 00:06:17,390
".حتى إن تطلّب ذلك تضحية كبيرة

95
00:06:18,500 --> 00:06:19,960
...أنت

96
00:06:19,960 --> 00:06:21,060
قلتَ ذلك، صحيح؟

97
00:06:22,630 --> 00:06:23,690
.سأفعلها

98
00:06:26,210 --> 00:06:27,570
تايتشي؟

99
00:06:28,630 --> 00:06:29,830
.إيري

100
00:06:31,320 --> 00:06:36,410
.بتّ أفهم أخيرًا ما يعنيه أن تقبل قوّةً كبيرةً جدًّا عليك

101
00:06:38,770 --> 00:06:40,710
.أنا آسف يا رين

102
00:06:40,710 --> 00:06:43,670
...لكن إن كان هذا لحمايتك

103
00:06:48,800 --> 00:06:51,050
!لا

104
00:06:53,680 --> 00:06:54,930
ماذا؟

105
00:06:57,410 --> 00:06:59,050
.تحرّكي رجاءً يا إيري

106
00:06:59,600 --> 00:07:02,790
.أنا السّبب في حدوث كلّ هذا

107
00:07:02,790 --> 00:07:04,020
...لذا عليّ أن

108
00:07:06,320 --> 00:07:08,280
.كلّا، لن أتزحزح

109
00:07:08,680 --> 00:07:11,950
.ولستَ المذنب يا تايتشي، بل أنا

110
00:07:14,900 --> 00:07:16,790
.أنا آسفة حقًّا

111
00:07:17,130 --> 00:07:19,330
لمَ تعتذرين؟

112
00:07:19,330 --> 00:07:21,300
.أنا آسفة يا تايتشي

113
00:07:21,300 --> 00:07:23,620
.كنتُ أكذب عليك

114
00:07:24,040 --> 00:07:24,950
تكذبين؟

115
00:07:25,330 --> 00:07:28,190
.هيئتي هذه مؤقتة فحسب

116
00:07:28,190 --> 00:07:30,380
.ليست هيئتي الحقيقية

117
00:07:32,280 --> 00:07:34,890
.قوّتك مذهلة

118
00:07:34,890 --> 00:07:37,720
.مذهلة لدرجة أنها أخافتني

119
00:07:37,720 --> 00:07:41,640
.لا أعلم ما سيحلّ بك إن أعرتك قوّتي الحقيقية

120
00:07:42,880 --> 00:07:46,170
.إن فشلت في التحكم بها، قد تسبّب في كارثة

121
00:07:46,630 --> 00:07:49,270
.وقد تقتلك حتّى

122
00:07:50,220 --> 00:07:51,520
...إيري

123
00:07:51,520 --> 00:07:53,280
إذًا، ماذا تقولين؟

124
00:07:53,580 --> 00:07:57,090
.لذا، إنه الوداع الآن يا تايتشي

125
00:07:58,260 --> 00:08:01,620
.حان الوقت لأودّع نفسي كإيري

126
00:08:02,000 --> 00:08:03,500
وداع؟

127
00:08:03,500 --> 00:08:05,290
.لا تنظر إليّ هكذا

128
00:08:06,040 --> 00:08:08,080
.لطالما عرفتُ في النهاية

129
00:08:08,080 --> 00:08:10,410
...رغبتك في حماية ما هو عزيز عليك

130
00:08:10,410 --> 00:08:13,720
.عزيمتك وتلك المشاعر القوية صادقة

131
00:08:14,200 --> 00:08:17,950
.تقبّلتني بالكامل

132
00:08:17,950 --> 00:08:19,500
.لذا حان دوري الآن

133
00:08:22,680 --> 00:08:24,380
.لا تقلق

134
00:08:24,380 --> 00:08:26,730
.سأصبح نفسي الحقيقية فحسب

135
00:08:27,520 --> 00:08:31,880
.وذلك هو الشيء الأسعد لنا نحن الأرواح جميعًا

136
00:08:35,190 --> 00:08:37,410
.شكرًا لك يا تايتشي

137
00:08:38,280 --> 00:08:39,680
.شكرًا لك

138
00:08:39,680 --> 00:08:40,960
!إيري؟

139
00:08:40,960 --> 00:08:43,270
.استدعيني مجدّدًا رجاءً يا سيدي

140
00:08:43,620 --> 00:08:46,300
...اسمي الحقيقي هو

141
00:08:56,720 --> 00:08:57,560
!تايتشي

142
00:08:57,560 --> 00:08:58,350
!رين؟

143
00:08:58,920 --> 00:09:01,770
!تايتشي، حمدًا لله لأنك بخير

144
00:09:07,800 --> 00:09:09,450
!تمهل! ماذا؟

145
00:09:09,450 --> 00:09:10,360
.أنا آسف

146
00:09:11,730 --> 00:09:15,740
.تركتك تُصابين بسبب تأخري

147
00:09:16,470 --> 00:09:18,240
هل ساقك يؤلمك؟

148
00:09:18,240 --> 00:09:20,540
ماذا؟ تقصد هذا؟

149
00:09:20,540 --> 00:09:22,980
.لا بأس. ليس بالأمر الجلل

150
00:09:26,790 --> 00:09:28,120
!مع ذلك

151
00:09:30,710 --> 00:09:34,420
.سأنهي هذه المعركة مهما كان

152
00:09:35,100 --> 00:09:36,170
،سأنهي هذا

153
00:09:36,640 --> 00:09:39,930
.وسأحمي جميع وكلّ ما نعتزّ به

154
00:09:50,160 --> 00:09:53,070
.حان الوقت لأرتقي من كوني إنسانًا

155
00:09:57,900 --> 00:10:01,830
.شرّفي عهدنا وأجيبي على ندائي

156
00:10:01,830 --> 00:10:05,540
!استدعاء العنصر: شيلفيد

157
00:10:11,390 --> 00:10:14,380
!استدعاء العنصر: شيلفيد

158
00:10:39,580 --> 00:10:41,200
ماذا؟

159
00:10:42,260 --> 00:10:43,530
...ماذا كنتُ

160
00:10:43,980 --> 00:10:45,180
.هذا صادم

161
00:10:45,590 --> 00:10:49,770
.عشتُ سنين عديدة، لكن هذه أوّل مرّة أرى شيئًا كهذا

162
00:10:49,770 --> 00:10:51,210
...ماذا بالضبط

163
00:10:51,590 --> 00:10:54,960
...راقبي جيدًا يا ميورا. هذه

164
00:10:55,260 --> 00:10:58,180
.لحظة ولادة مُستدعيٍ حقيقي

165
00:11:00,930 --> 00:11:03,240
.هذا مفاجئ

166
00:11:10,120 --> 00:11:13,810
.هذه أول مرّة ألتقي بك في هذه الهيئة يا تايتشي

167
00:11:15,840 --> 00:11:16,760
...إيري

168
00:11:17,360 --> 00:11:20,820
.لا، أنت شيلفيد الآن

169
00:11:20,820 --> 00:11:24,490
.نادني "شيلفي" من الآن فصاعدًا رجاءً يا سيدي

170
00:11:24,490 --> 00:11:26,780
إيري أصبحت شيلفيد؟

171
00:11:26,780 --> 00:11:30,670
،مهلًا! شيلفيد هي ملكة الأرواح

172
00:11:30,670 --> 00:11:32,920
!إحدى الأرواح العظيمة الأربعة

173
00:11:33,400 --> 00:11:34,640
...هل إيري

174
00:11:34,640 --> 00:11:36,590
هل اختفت؟

175
00:11:36,590 --> 00:11:38,080
.لا

176
00:11:38,080 --> 00:11:42,150
.ذكرياتي ومشاعري عندما كنتُ إيري لا تزال هنا

177
00:11:42,150 --> 00:11:43,010
...إذًا

178
00:11:43,360 --> 00:11:45,130
!هذا صحيح يا تايتشي

179
00:11:45,130 --> 00:11:48,680
!أنا وإيري لا نزال نفس الشخص

180
00:11:48,680 --> 00:11:49,940
.فهمت

181
00:11:51,350 --> 00:11:52,190
...رين

182
00:11:52,850 --> 00:11:56,780
،واثقٌ أنّك تملكين الكثير من الأسئلة
.لكن سأشرح الأمر لاحقًا

183
00:11:56,780 --> 00:11:57,610
.أجل

184
00:11:58,980 --> 00:12:00,200
.أنا مسرور

185
00:12:00,200 --> 00:12:02,900
.يبدو أنّني استطعتُ كسر التعويذة بذلك

186
00:12:02,900 --> 00:12:03,820
—مع إيـ

187
00:12:03,820 --> 00:12:05,400
بقوّة شيلفيد؟

188
00:12:05,400 --> 00:12:06,330
.أجل

189
00:12:06,960 --> 00:12:09,840
.لكنّ الأمر لم ينته بعد

190
00:12:09,840 --> 00:12:13,460
.لن تنتهي المعركة حتّى أوسع المتسبّب في هذا ضربًا

191
00:12:13,760 --> 00:12:15,630
.على إلقائه هذه التعويذة

192
00:12:17,420 --> 00:12:19,520
!أجل، أشعر به

193
00:12:19,520 --> 00:12:21,720
!حبّ تلك المرأة الكبير

194
00:12:22,240 --> 00:12:26,170
!أنت تمنحينه لي، إينيميكس

195
00:12:27,660 --> 00:12:30,390
!حبّك الأسمى

196
00:12:32,080 --> 00:12:33,000
.رين

197
00:12:36,710 --> 00:12:40,180
ستظلّين إلى جانبي مهما حدث، صحيح؟

198
00:12:46,880 --> 00:12:48,540
.بالطبع

199
00:12:48,540 --> 00:12:50,460
،أنا إلى جانبك

200
00:12:50,460 --> 00:12:52,540
.في أيّ وقت ومكان

201
00:12:54,920 --> 00:12:56,170
.شكرًا

202
00:13:00,050 --> 00:13:02,260
،إن كنتما ستتغازلان

203
00:13:02,260 --> 00:13:05,240
هلّا أجّلت ذلك حتّى تهزم ذلك الوحش؟

204
00:13:07,050 --> 00:13:09,660
فور أن تفعل ذلك، لا آبه إن قبّلتها

205
00:13:09,660 --> 00:13:12,100
.أو دفعتها على الأرض واتّخذتها ها هنا

206
00:13:12,820 --> 00:13:14,140
...إ-إذًا

207
00:13:14,140 --> 00:13:16,440
.أ-أجل، دعي الأمر لي

208
00:13:18,900 --> 00:13:20,040
!شيلفيد

209
00:13:20,040 --> 00:13:20,860
.أجل

210
00:13:22,690 --> 00:13:23,580
.هيا بنا

211
00:13:23,580 --> 00:13:24,650
.بالطبع

212
00:13:29,660 --> 00:13:32,270
.عجبًا! لقد فعلتها يا إينيميكس

213
00:13:32,270 --> 00:13:34,580
.لقد ارتقيت من كونك إنسانًا أيضًا

214
00:13:35,000 --> 00:13:36,320
!مذهل

215
00:13:36,320 --> 00:13:40,480
!هذا كما تنبّأت به تلك المرأة تمامًا

216
00:13:40,480 --> 00:13:44,170
!مذهل! مذهل يا فتى

217
00:13:44,170 --> 00:13:46,030
ما هو هدفك؟

218
00:13:46,030 --> 00:13:48,590
ومن تكون هذه المرأة بالضبط؟

219
00:13:49,000 --> 00:13:53,390
!إنّها ذات الرّحمة العظيمة التي تحكم هذا العالم

220
00:13:53,390 --> 00:13:54,680
...اسمع، أنا أسألك

221
00:13:59,150 --> 00:14:01,690
!ماذا يعني كلّ ذلك بالضّبط؟

222
00:14:03,020 --> 00:14:04,410
.أيها الأحمق

223
00:14:04,920 --> 00:14:08,910
.يجب أن تُدرك من تكون أوّلًا

224
00:14:08,910 --> 00:14:12,830
.سمعتَ الأرواح منذ ولادتك أيها الفتى الصغير

225
00:14:14,100 --> 00:14:17,600
لمَ استُدعيت إلى هذا العالم بظنّك؟

226
00:14:17,600 --> 00:14:19,000
...لأن

227
00:14:19,380 --> 00:14:21,670
!لأنّ تلك المرأة اختارتك

228
00:14:24,500 --> 00:14:27,240
كلّ ما قادك إلى هذه اللحظة

229
00:14:27,240 --> 00:14:29,900
.كان مدبّرًا له من قبل تلك المرأة

230
00:14:29,900 --> 00:14:33,850
حتّى الأميرة التي استدعتك لم تكن
.إلّا بيدق سُخّر لذلك الغرض

231
00:14:34,600 --> 00:14:38,270
،في الوقت المناسب، ستبدأ المعركة العظمى
.وسينقلب هذا العالم رأسًا على عقب

232
00:14:38,840 --> 00:14:41,930
،حينما يحدث ذلك، سينقلب الضوء والظلام

233
00:14:41,930 --> 00:14:44,980
!وستظهر تلك المرأة كخلاصنا

234
00:14:45,860 --> 00:14:48,150
.لهذا وقع الاختيار عليك

235
00:14:48,530 --> 00:14:53,920
هذا العالم، ألتيا، يحتاج السلاح
.المُطلق ليستمرّ في وجوده كألتيا

236
00:14:53,920 --> 00:14:58,490
لذا تمّ اختيارك من هذا العالم لتُصبح

237
00:14:58,490 --> 00:15:00,330
!درع وسيف تلك المرأة

238
00:15:02,610 --> 00:15:06,140
إذًا في الأخير، من هذا الشّخص الذي تستمرّ في ذكره؟

239
00:15:06,140 --> 00:15:10,010
.لم يحن الوقت بعد لتعرف اسمها

240
00:15:10,430 --> 00:15:12,590
وما قصّة السلاح المطلق؟

241
00:15:12,590 --> 00:15:13,930
.كفّ عن هذا الهراء

242
00:15:13,930 --> 00:15:16,220
من تخالني بالضبط؟

243
00:15:16,220 --> 00:15:17,600
ماذا تقول؟

244
00:15:17,600 --> 00:15:19,770
.إنه الشرف الأعظم

245
00:15:21,140 --> 00:15:23,020
!لن أقبل ذلك

246
00:15:26,520 --> 00:15:27,500
...تايتشي

247
00:15:28,110 --> 00:15:30,200
!ما هراء الخلاص هذا؟

248
00:15:33,400 --> 00:15:35,440
!هذا كما أملنا بالضبط

249
00:15:35,440 --> 00:15:37,830
!كفّ عن التفوّه بأيّ هراء

250
00:15:38,950 --> 00:15:41,250
!ألا تهمّك أرواح الآخرين؟

251
00:15:44,240 --> 00:15:48,220
...تسلب حياة الآخرين بسهولة دون تأنيب

252
00:15:48,220 --> 00:15:51,300
!لا يوجد أيّ شيء ليخلّصه حثالة مثلك

253
00:15:51,300 --> 00:15:54,110
!وكأنّني آبه لكلّ هذا الحديث عن هذا العالم

254
00:15:54,110 --> 00:15:57,060
!فقط أريد أن أحمي الأشخاص العزيزين عليّ

255
00:15:57,060 --> 00:16:00,640
...الأصدقاء الذين أحدّثهم وأمضي أيّامي معهم

256
00:16:01,080 --> 00:16:05,160
...النّاس الذين يتوقون للسّعادة البسيطة والمألوفة

257
00:16:05,560 --> 00:16:07,150
...أريد أن أحمي

258
00:16:08,440 --> 00:16:11,990
!أمثالهم

259
00:16:22,710 --> 00:16:25,030
...بالفعل، أنت بالفعل

260
00:16:25,750 --> 00:16:27,500
.أنا ممتن

261
00:16:27,500 --> 00:16:32,090
.يمكنني أن أتمم واجبي الآن

262
00:16:32,530 --> 00:16:34,480
...فقط القليل بعد

263
00:16:34,970 --> 00:16:40,140
.هيّا يا فتى. سدّد الضربة القاضية

264
00:16:43,240 --> 00:16:44,920
.عرفتها

265
00:16:44,920 --> 00:16:47,450
.لا يمكنك قتل أحد

266
00:16:47,450 --> 00:16:51,620
.تلك نقطة ضعفك الأخيرة

267
00:16:52,150 --> 00:16:53,820
أتظن ذلك؟

268
00:16:56,360 --> 00:16:59,000
.تأتي القوة بثمن

269
00:16:59,000 --> 00:17:02,890
ذلك هو المبدأ خلف السحر في هذا العالم، أليس كذلك؟

270
00:17:05,130 --> 00:17:10,520
أخبرني التّنين أن أصبح أقوى بالفعل
.إن كنتُ أريد حماية ما هو عزيز عليّ

271
00:17:11,220 --> 00:17:12,710
.لذا اتّخذتُ قراري

272
00:17:12,710 --> 00:17:17,550
.سأصبح أقوى، وليس لأجل أيّ أحد بل لأجلي

273
00:17:19,100 --> 00:17:21,940
...آسف، أنا فقط

274
00:17:23,990 --> 00:17:26,940
.ارتقيتُ من كوني إنسانًا

275
00:17:27,590 --> 00:17:29,900
...أجل، شيد-ساما

276
00:17:29,900 --> 00:17:32,480
.فعلتها أخيرًا

277
00:17:32,750 --> 00:17:37,410
...أنا، إينيميكس، أتممتُ بنجاح

278
00:18:09,410 --> 00:18:10,300
تايتشي؟

279
00:18:10,300 --> 00:18:11,230
هل أفقت؟

280
00:18:17,900 --> 00:18:19,530
.انتهت المعركة

281
00:18:20,050 --> 00:18:23,160
.بفضلك يا تايتشي

282
00:18:26,200 --> 00:18:29,030
هل كنت نائمًا مجدّدًا؟

283
00:18:30,000 --> 00:18:32,380
تذكّرت! ماذا عن ساقك الجريحة يا رين؟

284
00:18:32,380 --> 00:18:36,320
.لا تقلق. استخدمت ليميا سحر العلاج خاصتها عليّ

285
00:18:36,320 --> 00:18:37,930
.لن يخلّف ندبةً حتّى

286
00:18:37,930 --> 00:18:39,300
.فهمت

287
00:18:39,800 --> 00:18:41,840
.شكرًا لك يا ليميا

288
00:18:41,840 --> 00:18:45,970
.لا يمكنني أن أدع تلميذتي العزيزة بندبة

289
00:18:48,710 --> 00:18:49,440
!تايتشي

290
00:18:49,440 --> 00:18:52,440
.جلالتك، من سوء الخُلق أن تدخلي دون إذن

291
00:18:52,920 --> 00:18:56,150
.أنا مسرورة حقًّا لأنّك استيقظت أخيرًا

292
00:18:56,150 --> 00:18:58,270
.أكيد

293
00:18:58,270 --> 00:19:01,580
أخبرتهما أنّك تعاني من استنزاف
.في القوّة السحرية فقط وأنّ لا داعي للقلق

294
00:19:01,580 --> 00:19:03,830
.إلّا أنهما أتيا لزيارتك كلّ يوم

295
00:19:04,340 --> 00:19:07,520
حينما عُدت من ساحة المعركة ذلك
...اليوم فاقدًا لوعيك، هي بالضّبط كانت

296
00:19:07,520 --> 00:19:10,000
!ليميا، لا داعي لقول المزيد رجاءً

297
00:19:10,000 --> 00:19:12,470
.رين وميورا شعرتا بنفس المعاناة

298
00:19:12,470 --> 00:19:15,720
،كنتَ ستتعافى في الوقت
.لكنّهما حاولتا بكلّ شيء

299
00:19:16,170 --> 00:19:19,090
.أشعر بالغيرة منك يا سيّد بطل

300
00:19:20,880 --> 00:19:21,980
!عجبًا

301
00:19:25,430 --> 00:19:28,410
،بينما كانت هنالك الكثير من الخسائر في كلا الجانبين

302
00:19:28,410 --> 00:19:33,190
المعركة التي دارت في سهول
.ماروالت انتهت بانتصار الملك جيلمار

303
00:19:34,440 --> 00:19:37,090
،استعادت البلدة حياتها السابقة

304
00:19:37,090 --> 00:19:41,590
.وعادت العاصمة الملكية وينيفيكس إلى حالتها الطبيعية

305
00:19:42,470 --> 00:19:43,460
،أيضًا

306
00:19:44,410 --> 00:19:45,960
،بموجب اتّفاقنا

307
00:19:45,960 --> 00:19:50,710
كوفئنا بجوائز سخيّة وحتّى أنّنا
،اكتسبنا لقب مستشار الجيش الملكيّ

308
00:19:50,710 --> 00:19:55,750
ما يضعنا في صفوف الجيش الملكيّ كقوّات خاصّة تُستدعى

309
00:19:55,750 --> 00:19:58,170
.فقط حينما تكون المملكة في خطر

310
00:20:00,930 --> 00:20:05,430
.عاد السّلام من جديد إلى مملكة إيليستين السحرية

311
00:20:06,950 --> 00:20:08,080
...لكن

312
00:20:09,730 --> 00:20:14,350
هل تملك أيّ كلماتٍ أخيرة يا أخي؟

313
00:20:14,800 --> 00:20:17,720
.فعلتُ ما يجب أن أفعل

314
00:20:17,720 --> 00:20:19,370
.لستُ نادمًا على شيء

315
00:20:19,370 --> 00:20:20,530
.فهمت

316
00:20:22,200 --> 00:20:24,200
...والآن، دعوتك الأخيرة

317
00:20:24,200 --> 00:20:25,660
.لا داعي لذلك

318
00:20:28,540 --> 00:20:31,580
!فليعش وطننا

319
00:20:40,530 --> 00:20:41,760
ما الخطب؟

320
00:20:41,760 --> 00:20:43,530
.لا شيء

321
00:20:43,530 --> 00:20:48,600
لستَ تُفكّر أنّك كان يجب أن تتعامل
مع الأمر بشكلٍ أفضل، صحيح؟

322
00:20:48,600 --> 00:20:49,680
...في الواقع

323
00:20:50,760 --> 00:20:52,600
.كفّ عن التصرّف كطفل

324
00:20:54,710 --> 00:20:56,580
.البشر ليسوا مثاليين

325
00:20:57,280 --> 00:21:00,140
لكن من يمتلك قوّةً أكثر من الإنسان الطبيعي

326
00:21:00,140 --> 00:21:03,150
.سيُرغم على اتخاذ قرارات صعبة من حين لآخر

327
00:21:04,450 --> 00:21:07,500
...ما اخترت وما تختاره في تلك اللحظات

328
00:21:07,500 --> 00:21:09,240
،سوف تقترف أخطاء

329
00:21:09,240 --> 00:21:13,330
.لكنّ ذلك هو الألم الذي عليك تقبّله

330
00:21:13,330 --> 00:21:14,520
ألم؟

331
00:21:14,520 --> 00:21:15,290
.أجل

332
00:21:17,330 --> 00:21:19,400
،ما دمتَ لا تفقد ذلك أبدًا

333
00:21:19,400 --> 00:21:22,750
.ستظلّ إنسانًا مهما كانت القوّة التي تحملها

334
00:21:22,750 --> 00:21:26,460
.كن صادقًا مع قلبك يا تايتشي

335
00:21:26,460 --> 00:21:29,100
.شكّ واقلق وواجه معضلاتك

336
00:21:30,120 --> 00:21:33,270
.ذلك هو امتياز الشباب

337
00:21:33,990 --> 00:21:36,940
.كفّ عن إضاعة الوقت الآن
.سنعود إلى أزباير

338
00:21:39,300 --> 00:21:40,140
...تايتشي

339
00:21:40,140 --> 00:21:40,860
.هيا بنا

340
00:21:41,640 --> 00:21:42,830
!أجل

341
00:21:47,820 --> 00:21:49,520
.رحلة سعيدة

342
00:21:49,520 --> 00:21:52,230
.أجل. شكرًا على توديعنا

343
00:21:52,230 --> 00:21:54,500
...تايتشي، رين

344
00:21:57,000 --> 00:21:58,720
.أعدكما

345
00:21:58,720 --> 00:22:03,140
.سأعيدكما يومًا ما إلى عالمكما

346
00:22:03,140 --> 00:22:04,860
.أجل، نعتمد على ذلك

347
00:22:04,860 --> 00:22:07,720
.لكن لا تجهدي نفسك كثيرًا رجاءً

348
00:22:08,900 --> 00:22:11,390
.أحبّ حياتي هنا أيضًا

349
00:22:11,390 --> 00:22:13,390
!كما نملك أصدقاء أعزاء هنا

350
00:22:14,100 --> 00:22:17,020
.أجل، شكرًا جزيلًا

351
00:22:20,310 --> 00:22:23,210
...بطل من عالم آخر سينقذ البلاد

352
00:22:23,210 --> 00:22:25,880
.لم أتخيّل قط أن تتحقّق تلك الأسطورة

353
00:22:25,880 --> 00:22:26,980
.أجل

354
00:22:26,980 --> 00:22:31,600
...لا يمكن أن يُغفر لي أبدًا على ما فعلت

355
00:22:31,600 --> 00:22:32,740
...لكن

356
00:22:33,570 --> 00:22:36,840
في الوقت الراهن، يجب أن
.أكون ممتنّة على لقائنا فحسب

357
00:22:39,000 --> 00:22:40,200
!مذهل

358
00:22:40,200 --> 00:22:42,670
.يمكنك أن تصبحي أصغر حتّى وأنت شيلفي

359
00:22:42,670 --> 00:22:46,460
.أجل. هذه الهيئة مريحة أكثر برأيي

360
00:22:47,960 --> 00:22:48,880
.أحببتها أيضًا

361
00:22:48,880 --> 00:22:52,890
ما زلت لا أصدّق أنّك تحكّمت في
.إحدى الأرواح الأربعة العظيمة فجأةً

362
00:22:52,890 --> 00:22:55,810
.صدقًا. تايتشي يغشّ كثيرًا

363
00:22:56,310 --> 00:22:57,610
...بالمناسبة يا رين

364
00:22:57,610 --> 00:22:59,500
،تساءلت عن هذا طويلًا

365
00:22:59,500 --> 00:23:02,430
لكن ما يعنيه "غش"؟

366
00:23:01,280 --> 00:23:03,230
.انتهت أزمة الحرب الأهلية

367
00:23:02,430 --> 00:23:05,940
صحيح، ليست كلمة في هذا العالم، صحيح؟

368
00:23:03,230 --> 00:23:05,940
.لكن، ظلّ القلق يساورني بصراحة

369
00:23:06,530 --> 00:23:08,610
من تلك المرأة بالضبط؟

370
00:23:09,140 --> 00:23:13,030
ماذا كان يقصد بالمعركة العظمى
وأنّ العالم سينقلب رأسًا على عقب؟

371
00:23:09,140 --> 00:23:13,030
.لكمة "غش" تعني في الأصل خداع أو احتيال أو مكر

372
00:23:13,570 --> 00:23:14,350
نعم؟

373
00:23:13,650 --> 00:23:15,110
.ما زلتُ لا أعلم لحدّ السّاعة

374
00:23:14,350 --> 00:23:17,620
.لكن الطريقة التي نستخدمها الآن مختلفة قليلًا

375
00:23:15,540 --> 00:23:19,160
.لكن هنالك شيء واحد واضح

376
00:23:18,520 --> 00:23:22,550
...من الصعب شرح الأمر في الواقع

377
00:23:19,670 --> 00:23:23,510
.سأستخدم هذه القوة لحماية الأشخاص العزيزين علي

378
00:23:24,020 --> 00:23:25,840
.ولا آبه إن كان غشًّا

379
00:23:30,680 --> 00:23:35,050
أنا ورين سنفعل ما يقع
.علينا فعله للعيش في هذا العالم

380
00:23:35,640 --> 00:23:37,290
.هذا كل شيء