1
00:00:07,190 --> 00:00:11,530
يبدو أن أوهوشي ستحقِّق رييتشي مزدوجة أخرى

2
00:00:12,340 --> 00:00:13,530
...لمنع ذلك

3
00:00:14,190 --> 00:00:16,530
يجبُ أن يحصل شخصٌ على تشي أو بون أولاً

4
00:00:18,600 --> 00:00:19,490
هذا؟

5
00:00:21,190 --> 00:00:22,090
...هذا سيئ

6
00:00:28,530 --> 00:00:29,670
لم تستطع أي لاعبة استدعائه

7
00:00:29,670 --> 00:00:31,010
...إذاً أوهوشي

8
00:00:35,260 --> 00:00:36,260
رييتشي

9
00:00:37,740 --> 00:00:39,310
!طرح مُباشَر نحو رييتشي مُزدوجة؟

10
00:00:39,310 --> 00:00:41,260
كانَتْ في حالة تينباي منذُ البداية

11
00:00:41,260 --> 00:00:43,620
ما يعني بأنها كانت الشخص الوحيد الذي يبعد
!قرميداً واحداً عن تشيهو؟

12
00:00:52,410 --> 00:00:53,150
كان

13
00:00:55,150 --> 00:00:55,910
هذه هي

14
00:01:16,490 --> 00:01:17,220
رون

15
00:01:18,850 --> 00:01:21,850
رييتشي مُزدوجة، أربعة أورا دورا

16
00:01:23,250 --> 00:01:24,730
‏‏12.000

17
00:01:25,140 --> 00:01:27,980
كان كاملة أخرى من أورا دورا

18
00:01:28,460 --> 00:01:31,180
رييتشي مزدوجة أخرى بـ"كان" تؤدّي
إلى أربعة أورا دورا

19
00:01:31,180 --> 00:01:33,480
أهذه قوّة أوهوشي أواي؟

20
00:01:34,050 --> 00:01:36,800
يبدو أنني لا أزالُ قادرة على الفوز إذاً

21
00:01:36,800 --> 00:01:39,590
كنتُ فاقدة للتركيز بعض الشيء قبل قليل

22
00:01:40,170 --> 00:01:43,750
هل رييتشي المزدوجة هي أسلوبُ أوهوشي
أواي في الهجوم إذاً؟

23
00:01:44,130 --> 00:01:46,280
"لا تنسي الأورا دورا في الـ"كان

24
00:01:46,280 --> 00:01:49,880
في تصفيات طوكيو الغربية، كانَتْ أياديها الرابحة
تحتوي على ذلك أيضاً

25
00:01:49,880 --> 00:01:52,380
لولاها، ستغدو مجرَّد رييتشي مزدوجة فقط

26
00:01:52,790 --> 00:01:56,620
ما يعني أن الوضع آمن ما لم تُعلِن عن كان

27
00:01:56,620 --> 00:02:01,760
الإيبّاتسو هي حوادِث عفويّة معروفة لِذا ينبغي أن نضغط عليها
بقوّة ونسحقها أولاً

28
00:02:02,160 --> 00:02:04,840
،أظنُّها استراتيحية سليمة

29
00:02:04,840 --> 00:02:08,100
لكن الجميع عدا أوهوشي لديهن يد ابتدائيّة
تبعُد خمسة قراميد عن تينباي على الأقلّ

30
00:02:08,910 --> 00:02:10,790
...نحنُ عالقات هنا

31
00:02:10,790 --> 00:02:14,280
لكن أوهوشي لم تكن قادرة على ربح
اليد الأخيرة من النصف الأول

32
00:02:14,630 --> 00:02:16,000
أجل

33
00:02:16,000 --> 00:02:18,020
ما الشيء المختلِف آنذاك يا تُرى؟

34
00:02:18,020 --> 00:02:18,880
اسمعي

35
00:02:19,630 --> 00:02:22,640
هل أخبرتِ ريوكا عن ما اكتشفتِه حتى الآن؟

36
00:02:22,640 --> 00:02:25,060
نعم، أثناء الاستراحة القصيرة

37
00:02:25,060 --> 00:02:29,670
في هذه الحالة، لنستمرّ في البحث
سنتركُ هذه المُباراة لريوكا

38
00:02:30,370 --> 00:02:33,370
أنا الموزِّعة، لهذا أريدُ أن أستدعي قراميدَ توكي

39
00:02:33,370 --> 00:02:37,170
لكن ربِحَتْ شيروزو مايرو هذه اليد
في مباراة اللاعب الرابع

40
00:02:37,750 --> 00:02:39,800
لِذا قد تفوز تسوروتا هيميكو

41
00:02:40,250 --> 00:02:44,310
في تِلك الحالة، سألعبُ كما ألعب دائماً
بكامِل قوّتي الخاصّة

42
00:02:48,950 --> 00:02:50,310
هذه اليد الأيضاً؟

43
00:02:52,910 --> 00:02:53,940
رييتشي

44
00:02:56,710 --> 00:03:00,450
أنتِ لا تهتمِّين إذاً ما إن ربِحَتْ
قائدتنا هذه اليد يا أوهوشي

45
00:03:01,050 --> 00:03:03,700
...لم أجرِّب الإعلان عن رييتشي مُزدوجة ضدّكن بعد

46
00:03:04,380 --> 00:03:06,200
هل تُمانِعن أن أجرِّب ذلك؟

47
00:03:07,370 --> 00:03:11,330
ربِحَتْ قائدتنا هذه اليد بثلاثة هان
...والحجز كان لاثنين فقط

48
00:03:12,960 --> 00:03:15,340
سأحصل على مانغان

49
00:03:23,270 --> 00:03:25,050
رون، 8.000

50
00:03:29,030 --> 00:03:32,060
مذهلة حقاً يا شيندوجي

51
00:03:32,710 --> 00:03:34,060
هذا مفاجئ

52
00:03:34,060 --> 00:03:38,500
إذاً هنالِك لاعبات في المدرسة الثانوية غير تيرو
تستطِعن هزيمة الرييتشي المُزدوجة الخاصّة بآواي

53
00:03:38,500 --> 00:03:40,760
أعتقدُ أنه ينبغي أن يكون هنالِك حوالي عشرة

54
00:03:40,760 --> 00:03:44,380
أظنُّ أن ثنائي شيندوجي سيتفوّقُ على ذلك

55
00:03:44,380 --> 00:03:46,450
حتّى في المباريات الاحترافية

56
00:03:47,560 --> 00:03:50,290
لقد هزمتُ رييتشي أوهوشي المزدوجة في السابق

57
00:03:50,930 --> 00:03:53,340
حقّاً؟ هزمتِ رييتشي آواي؟

58
00:03:53,340 --> 00:03:55,420
...نعم... وأرى أنّكِ لا تصدّقينني

59
00:03:55,790 --> 00:03:56,960
كيف فعلتِ ذلك؟

60
00:03:56,960 --> 00:04:01,380
في الواقع، بعدما رُميَ النرد
وانشطرَ السور الميِّت

61
00:04:01,380 --> 00:04:03,440
ربطتُ الأسوارَ على نحو دائري

62
00:04:04,870 --> 00:04:06,100
يا لكِ من شرِّيرة

63
00:04:06,850 --> 00:04:09,460
كانَتْ تبكي لأنها لم تربح

64
00:04:09,460 --> 00:04:14,500
بمناسبةِ الحديث عن عدم الربح، لماذا خسِرَت
اليد الأخيرة يا تُرى؟

65
00:04:14,500 --> 00:04:17,100
ألم تتعمّد آواي فعل ذلك؟

66
00:04:18,890 --> 00:04:21,070
أشعرُ وكأنها كانَتْ تلعبُ بجدّية

67
00:04:22,290 --> 00:04:23,190
رييتشي

68
00:04:24,870 --> 00:04:26,810
،أوهوشي هي الموزِّعة

69
00:04:26,810 --> 00:04:29,510
لِذا فالاستدعاء لمنع وقوع رييتشي مُزدوجة
ليس خياراً متاحاً حتّى

70
00:04:29,510 --> 00:04:33,120
ربِحَتْ قائدتنا في هذه اليد دون حتّى
أن تفرض حجزاً

71
00:04:33,120 --> 00:04:34,960
لِذا من الواضح بأنه لا يتوفّر أي مفتاح

72
00:04:35,350 --> 00:04:38,210
سأفعلُ ما بوسعي دون الاستعانة بأحد

73
00:04:38,210 --> 00:04:42,470
هيميكو، لا تضغطي على نفسكِ كثيراً
إنها الموزِّعة الآن

74
00:04:45,190 --> 00:04:46,040
كان

75
00:04:47,570 --> 00:04:48,430
هذه هي

76
00:04:48,750 --> 00:04:50,470
أعلنَتْ أوهوشي عن كان مجدداً

77
00:04:50,470 --> 00:04:53,180
حسناً، لن أتراجع بعدما قطعتُ
كل هذه المسافة

78
00:04:54,420 --> 00:04:55,560
!سأمضي قدماً

79
00:04:56,990 --> 00:04:57,940
لقد مرَّتْ

80
00:05:06,490 --> 00:05:08,200
...هذا قرميد مُجازِف

81
00:05:09,070 --> 00:05:10,160
رون

82
00:05:14,350 --> 00:05:17,790
أظنُّ أن تعاونهما لم يكن فعّالاً

83
00:05:18,230 --> 00:05:19,540
‏‏18.000

84
00:05:21,660 --> 00:05:23,380
"كما هو متوقَّع، أورا دورا من الـ"كان

85
00:05:23,810 --> 00:05:25,940
رييتشي مزدوجة أخرى بأربعة دورا

86
00:05:26,870 --> 00:05:28,260
اليد الإضافية 1

87
00:05:28,260 --> 00:05:29,640
هل تعلمن؟

88
00:05:29,990 --> 00:05:34,140
ما دمتُ موزِّعة، لا مجال لإيقاف الرييتشي
المزدوجة الخاصّة بي

89
00:05:34,140 --> 00:05:37,400
وثنائي شنيدوجي الغريب لن يكشف عن نفسه

90
00:05:37,400 --> 00:05:39,400
فهمت، إنها الزوايا

91
00:05:39,400 --> 00:05:40,480
الزوايا؟

92
00:05:40,480 --> 00:05:42,200
زوايا سور القرميد

93
00:05:42,200 --> 00:05:43,220
تماماً

94
00:05:44,190 --> 00:05:47,200
،سور القراميد الذي ينشأ في البداية في الماجونغ

95
00:05:47,200 --> 00:05:49,920
المدعو أيضاً سور القرميد، لديه زوايا

96
00:05:49,920 --> 00:05:51,880
زاوية السور إذاً؟

97
00:05:51,880 --> 00:05:55,770
تعلن أوهوشي آواي عن "كان" خاصّتها
قبل الزاوية الأخيرة

98
00:05:55,770 --> 00:05:58,260
ومن ثمّ تربد بعد الاستدارة

99
00:05:59,890 --> 00:06:01,420
ملاحظة دقيقة

100
00:06:01,420 --> 00:06:05,000
ليس من السَّهل اكتشاف ذلك فقط من مقاطع
الفيديو المعتادة والبيانات المطبوعة

101
00:06:05,000 --> 00:06:08,050
سُجِّلَتْ رميات النرد أيضاً، لهذا حدّدتُ فترات الاستراحة

102
00:06:08,460 --> 00:06:10,550
هل أخبرتِ ريوكا بالأمر؟

103
00:06:10,550 --> 00:06:12,890
لا، اكتشفتُ هذا للتو

104
00:06:12,890 --> 00:06:16,060
أوهوشي لم تربح إلا يداً واحدة برييتشي
مزدوجة في النصف الأول

105
00:06:16,800 --> 00:06:20,020
هنالِك شيء واحد في تِلك اليد السابقة مُشترَك
مع الرييتشي المزدوجة في تصفيات طوكيو الغربية

106
00:06:20,020 --> 00:06:21,960
لقد اكتشفته للتو

107
00:06:21,960 --> 00:06:23,800
في كلتا المناسبتَين، اليد التي لا تحتوي إلّا على "هان" من الرييتشي
المزدوجة تحقِّق "كان" مليئة بأورا دورا

108
00:06:23,800 --> 00:06:25,940
وتربح بعدَ تِلك الـ"كان" مباشرة

109
00:06:26,550 --> 00:06:27,950
...لكن تِلك اليد الأخيرة من النصف الأول

110
00:06:28,270 --> 00:06:31,660
اليد التي لم تربح بها أوهوشي؟

111
00:06:31,990 --> 00:06:35,160
لم أعرف سببَ عدم حدوث ذات الشيء
في تِلك اليد

112
00:06:35,160 --> 00:06:38,410
لهذا لم أستطع الجزم بأنها ستربحُ
بعد الـ"كان" خاصّتها

113
00:06:38,410 --> 00:06:41,720
أنا نادمة الآن لأنني أخبرتُ ريوكا

114
00:06:42,370 --> 00:06:44,380
"أن تتوخّى الحذر فقط بعد الـ"كان

115
00:06:45,470 --> 00:06:48,420
رون، 18.300

116
00:06:50,330 --> 00:06:53,220
هل كانَتْ تعلمُ كم عددَ النقاط
!التي ستستدعيها قبل النظر إلى الأورا دورا؟

117
00:06:54,390 --> 00:06:55,100
والآن

118
00:06:56,630 --> 00:06:58,100
اليد الإضافية الثانية

119
00:06:58,510 --> 00:07:00,850
لن أدعكِ تبقين الموزِّعة فترة أطول

120
00:07:02,870 --> 00:07:04,770
...أردتُ ادِّخار هذه لوقت لاحق

121
00:07:05,330 --> 00:07:06,520
توكي

122
00:07:21,310 --> 00:07:22,360
أستطيعُ رؤيتها

123
00:07:22,360 --> 00:07:24,040
إنها كبيرة

124
00:07:25,110 --> 00:07:27,020
...توكي

125
00:07:30,070 --> 00:07:32,100
من جديد، الحدّ الأقصى

126
00:07:32,100 --> 00:07:33,260
من ماذا؟

127
00:07:33,260 --> 00:07:35,240
،لو لم يتم إسعافي

128
00:07:35,240 --> 00:07:38,020
لاستطعتُ تخزين المزيد في فخذَيّ ريوكا

129
00:07:38,020 --> 00:07:40,220
عمّاذا تتحدثين؟

130
00:07:40,220 --> 00:07:41,770
...آسفة يا ريوكا

131
00:07:42,370 --> 00:07:44,400
على عجزي عن الاستلقاء على حضنكِ أكثر من ذلك

132
00:07:44,400 --> 00:07:45,770
!أهذا ما أنتِ نادمة عليه؟

133
00:07:49,110 --> 00:07:49,820
رون

134
00:07:51,220 --> 00:07:53,120
‏‏16.600

135
00:07:56,200 --> 00:07:58,120
ألن تذهبي لتفقُّد الأورا دورا؟

136
00:07:58,430 --> 00:08:01,120
سأفعل، لكن لا أظنُّ أن شيئاً سيتغيَّر

137
00:08:05,320 --> 00:08:07,630
ليسَ شيندوجي فقط

138
00:08:08,510 --> 00:08:13,620
شيزو، هل يمكنُكِ أن تتجاوزي تِلكم
الفتيات الثلاثة... تِلكم الجبال الثلاثة؟

139
00:08:15,010 --> 00:08:17,640
هل تمكّنتِ من شقِّ طريقكِ إلى أعماقهن؟

140
00:08:19,190 --> 00:08:22,270
قالَتْ نودوكا ذات مرَّة في مقابلة

141
00:08:22,630 --> 00:08:26,030
بأنها لعِبَتْ بمفردها عبرَ الإنترنت
لمدّة سنة ونصف تقريباً

142
00:08:26,580 --> 00:08:29,120
الفترة التي قضَتْها نودوكا
لم تذهب سُدى

143
00:08:29,120 --> 00:08:31,340
ساهمَتْ في تشكيلِ شخصيّتها الآن

144
00:08:32,550 --> 00:08:36,280
كلّ ما فعلتُه كان التجوُّل في الجبالِ بمفردي
لمدّة عامَين ونصف

145
00:08:38,830 --> 00:08:41,250
مُقارنة بنودوكا، كنتُ مكتئبة في البداية

146
00:08:43,490 --> 00:08:45,000
لكن اختلف الأمر الآن

147
00:08:46,470 --> 00:08:49,620
لأن ذلك يمدُّني بالقوة الآن

148
00:08:53,630 --> 00:08:55,380
هذا المشهدُ رائع

149
00:08:56,670 --> 00:08:59,390
أتعرفين الطرقات التي يسلكُها زاهدو
الجبال بغية التدريب؟

150
00:08:59,910 --> 00:09:01,550
سلكَتْ تِلك الطرق لا كجزء من التدريب

151
00:09:01,550 --> 00:09:03,820
إنّما فعلَتْ ذلك وكأنها في باحة منزلها

152
00:09:03,820 --> 00:09:06,020
فتاة... في الجبال؟

153
00:09:06,390 --> 00:09:10,980
ما الذي عثرَتْ عليه شيزونو
في تِلك الأماكن المعزولة يا تُرى؟

154
00:09:12,310 --> 00:09:14,780
لطالما أحبَّتْ شيزو الجبال، أليس كذلك؟

155
00:09:15,130 --> 00:09:16,800
،بدأت بالركض فجأة

156
00:09:16,800 --> 00:09:20,120
ورغم أنّ إحساسها بالاتجاهات سيئ
لم تتُه على الإطلاق

157
00:09:20,120 --> 00:09:22,910
...حتّى عندما علّمناها الماجونغ

158
00:09:23,690 --> 00:09:24,540
جبل؟

159
00:09:24,950 --> 00:09:26,540
!تُدعى هذه الجدران بالجبال أيضاً؟

160
00:09:27,030 --> 00:09:28,280
هذا صحيح

161
00:09:28,280 --> 00:09:30,780
ما يعني بأن الجبال

162
00:09:30,780 --> 00:09:33,480
!التي سأجوبها ستكونُ مختلفة في كل مرة؟

163
00:09:33,480 --> 00:09:34,270
أجل

164
00:09:34,270 --> 00:09:36,160
أنتِ تتحمَّسين زيادة عن اللزوم

165
00:09:36,820 --> 00:09:40,140
نعم، هذا ما حدث، صحيح؟

166
00:09:40,140 --> 00:09:41,260
نعم

167
00:09:41,260 --> 00:09:43,810
يو، ما الذي جاء في النرد؟

168
00:09:44,510 --> 00:09:46,810
لنرَ... يمين عشرة

169
00:09:47,170 --> 00:09:51,400
عشرة؟ قد تنجح هذه اليد أيضاً إذاً

170
00:09:55,040 --> 00:09:55,610
رون

171
00:09:57,470 --> 00:09:58,490
‏‏2.600

172
00:10:01,250 --> 00:10:02,030
!آتشيغا؟

173
00:10:02,650 --> 00:10:04,160
!يد بهذا الرخص؟

174
00:10:07,060 --> 00:10:08,920
هل يُعقَلُ أن يكون هذا...؟

175
00:10:09,820 --> 00:10:11,750
ها هي إحدى إلهامات هيروكو

176
00:10:12,110 --> 00:10:16,000
إنه مجرَّد تخمين، لكن أظنُّ أن أوهوشي
آواي قد انتقلَتْ

177
00:10:16,000 --> 00:10:18,440
إلى نمطها الهجومي في اليد
الأخيرة من النصف الأول

178
00:10:18,440 --> 00:10:19,550
بتِلك الرييتشي المزدوجة؟

179
00:10:19,820 --> 00:10:22,900
منذُ ذلك الحين، أعلنَتْ عن رييتشي
مزدوجة في كل يد

180
00:10:22,900 --> 00:10:25,770
وأيادي الجميع الابتدائية كانَتْ ضعيفة تماماً

181
00:10:25,770 --> 00:10:28,520
عادة ما يكون من المُستحيل الفوز على شيء كهذا

182
00:10:28,520 --> 00:10:33,160
لكن ثنائي شيندوجي سحقَه كلّياً

183
00:10:33,160 --> 00:10:35,440
يبدو أن اليد الابتدائيّة لديهما لم تتأثَّر أيضاً

184
00:10:35,750 --> 00:10:38,650
يقولون أن حتى المحترفين لا يستطيعون
مواجهة ذلك الثنائي

185
00:10:38,990 --> 00:10:43,080
من المؤكَّد تقريباً أنّهما ستحقّقان ياكومان معدودة
في الهان الجنوبية الثالثة

186
00:10:43,080 --> 00:10:45,350
لا يبدو هذا أمراً حميداً

187
00:10:45,350 --> 00:10:48,920
مضَتْ ثلاثة أيدٍ أعلنَتْ فيها
أوهوشي عن رييتشي مزدوجة

188
00:10:48,920 --> 00:10:51,520
دون أن تربح، باستثناء أيادي ثنائي شيندوجي

189
00:10:51,520 --> 00:10:54,300
كانَتْ إحداها بايمان شيميزوداني

190
00:10:54,650 --> 00:10:57,120
حلّقَتْ نحو تينباي وحقّقَتْ فوزاً مباشرةً

191
00:10:57,630 --> 00:10:59,200
ثمّة شيء هناك

192
00:10:59,200 --> 00:11:01,310
المُشكلة هي الأُخرَتان

193
00:11:01,310 --> 00:11:05,520
نعم، في كلتاهما ربِحَتْ طالبة
السنة الأولى تِلك من آتشيغا

194
00:11:05,520 --> 00:11:06,310
تماماً

195
00:11:07,010 --> 00:11:09,380
ما لاحظتُه للتو هو عيون النرد

196
00:11:09,380 --> 00:11:10,620
ماذا تقصدين؟

197
00:11:10,620 --> 00:11:13,020
تربحُ أوهوشي أيادي الرييتشي المُزدوجة الخاصّة بها

198
00:11:13,020 --> 00:11:14,580
بالسور الأخير

199
00:11:14,580 --> 00:11:17,500
النردُ هو ما يحدِّد أين ستكونُ الزاوية

200
00:11:18,910 --> 00:11:20,540
فهمتُها أخيراً

201
00:11:20,540 --> 00:11:21,480
نعم

202
00:11:21,480 --> 00:11:25,420
عندما ربِحَتْ أوهوشي أيادي الرييتشي الخاصّة
بها، ظهرَ في النرد من ثلاثة إلى سبعة

203
00:11:26,010 --> 00:11:29,120
وبالعكس، عندما ربِحَتْ تاكاكامو
ظهرَ في النرد اثنان أو عشرة

204
00:11:30,130 --> 00:11:34,240
كانَتْ الزوايا في أعماق السور

205
00:11:36,110 --> 00:11:38,710
...كنتُ على وشك قول ذلك

206
00:11:40,650 --> 00:11:43,340
في اليد الأخيرة من النصف الأوّل
ظهرَ اثنان في النرد

207
00:11:43,340 --> 00:11:45,760
،لا يبدو ذلك عميقاً إلى هذا الحد

208
00:11:45,760 --> 00:11:47,980
لكن أعتقدُ أنه كان أعمق من الأيادي الأخرى

209
00:11:47,980 --> 00:11:50,310
،كانَتْ أوهوشي قادرة على إنشاء "كان" خاصّة بها

210
00:11:50,310 --> 00:11:52,100
لهذا أظنُّ أن منطقتها تبدأ من هناك

211
00:11:52,530 --> 00:11:54,770
منطقة؟ منطقة من؟

212
00:11:55,540 --> 00:11:56,150
...منطِقة

213
00:11:57,510 --> 00:11:59,580
سيِّدة الجبال العميقة

214
00:12:02,280 --> 00:12:03,780
،لنفكِّر بالأمر

215
00:12:03,780 --> 00:12:06,430
...منذُ الجولة الجنوبية من النصف الأوَّل

216
00:12:06,430 --> 00:12:10,580
كلّما تشكّلَتْ تِلكم الأيادي
وكلّما تعمّقنا أكثر في السور

217
00:12:10,580 --> 00:12:13,510
يسوءُ مجالُ رؤيتي كما لو أنني وسطَ ضباب

218
00:12:14,210 --> 00:12:17,590
...علاوة على ذلك، أرى شيئاً هناك

219
00:12:18,380 --> 00:12:19,510
!تبّاً

220
00:12:19,920 --> 00:12:23,630
لن أخسر أمام شيء مملّ إلى هذا الحد

221
00:12:24,350 --> 00:12:25,090
رييتشي

222
00:12:25,510 --> 00:12:26,850
رييتشي مزدوجة مجدداً

223
00:12:28,270 --> 00:12:30,850
...الزاوية الأخيرة عميقة جداً

224
00:12:31,230 --> 00:12:36,360
يبدو أن الحال سينتهي بهذه اليد في أعماق
...السور "الجبل"، لكن أتساءل

225
00:12:38,330 --> 00:12:39,400
,آنذاك

226
00:12:40,670 --> 00:12:43,480
عشتُ في الجبال بمُفردي كثيراً

227
00:12:44,040 --> 00:12:49,160
ولذلك السبب، أشعرُ أنني كنتُ قادرة على فهم
الصورة بوضوح عن ماهيّتي

228
00:12:49,160 --> 00:12:51,700
وحظيتُ بوقتٍ طويلٍ للتفكير

229
00:12:52,990 --> 00:12:56,000
في لحظة ما، ذابَ وعيي في الطبيعة

230
00:12:56,000 --> 00:13:01,200
وشعرتُ وكأنني قد أصبحتُ جزءاً واحداً
مع الجبال العميقة

231
00:13:02,770 --> 00:13:05,970
الآن، السُّور "جبل" وخصومي

232
00:13:05,970 --> 00:13:07,970
يمثِّلون الجبالَ التي كنتُ فيها آنذاك

233
00:13:09,320 --> 00:13:10,470
..."والآن الـ"كان

234
00:13:13,310 --> 00:13:16,180
لا أستطيع؟! مجدداً؟

235
00:13:16,180 --> 00:13:17,060
!لماذا؟

236
00:13:17,800 --> 00:13:18,690
هكذا إذاً

237
00:13:19,340 --> 00:13:24,440
إنَّ هايتي الخاصّة بكورومو الصغيرة وقراميد
رينشان الخاصّة بي عميقة في السُّور أيضاً

238
00:13:24,440 --> 00:13:25,820
لا تعامليني كطفلة

239
00:13:26,200 --> 00:13:30,420
...إذاً بحسبِ رمية النرد، اللاعبة الخامسة في فريق أختي

240
00:13:30,420 --> 00:13:32,330
...إنها هي إذاً

241
00:13:48,430 --> 00:13:49,220
رون

242
00:13:51,380 --> 00:13:52,850
‏‏11.600

243
00:13:52,850 --> 00:13:55,350
آتشيغا للإناث تهاجم مجدداً

244
00:13:55,350 --> 00:13:57,730
إصابة بحقّ شيرايتوداي

245
00:13:57,730 --> 00:14:01,230
للمرة الأولى، آتشيغا للإناث في المركز الأول

246
00:14:02,540 --> 00:14:04,040
إنها المرة الأولى، صحيح؟

247
00:14:04,490 --> 00:14:06,370
!ألم تكوني متأكِّدة؟

248
00:14:06,370 --> 00:14:07,700
...آتشيغا

249
00:14:07,700 --> 00:14:09,490
،ما وراء الطريق الجبلي بغية التدريب

250
00:14:09,850 --> 00:14:12,240
،ووراء فجوات التغيُّر المُستديم

251
00:14:13,050 --> 00:14:17,250
تنتظرُ تجسيدُ أعمق وديان الجبال، شيزونو

252
00:14:17,250 --> 00:14:19,640
هل تستطيعُ الزهرة أن تتفتّح أمامها في سلسلة
الجبال تلك؟

253
00:14:26,010 --> 00:14:31,320
آتشيغا... تستطيعُ إذاً تعطيل قِوى اللاعبين
إن بلغَ ذلك عمقَ السور

254
00:14:31,320 --> 00:14:34,060
ولكن بما أنني أتحكّمُ بالافتتاحيات

255
00:14:34,060 --> 00:14:37,160
لا يُمكِن تشييد المناطق العميقة من السُّور
إلَّا بالقراميد المتبقّية

256
00:14:37,160 --> 00:14:39,770
هذا يعني أنها لا تستطيع التحكُّم بكل شيء

257
00:14:46,690 --> 00:14:47,950
لا رييتشي مزدوجة؟

258
00:14:50,020 --> 00:14:53,420
يدي الابتدائيّة لم تعُد تبعد
خمسة قراميد عن تينباي

259
00:14:53,420 --> 00:14:54,240
...هذه

260
00:14:57,290 --> 00:14:58,590
رييتشي

261
00:14:58,590 --> 00:14:59,720
هل هو العكس؟

262
00:15:00,230 --> 00:15:02,810
هل سيطرة آتشيغا على المناطق العميقة

263
00:15:02,810 --> 00:15:05,130
تؤثِّر على الأدوار الافتتاحية أيضاً؟

264
00:15:05,690 --> 00:15:08,130
لم يحدث ذلك حتّى عندما تبنّتْني تيرو آنذاك

265
00:15:08,590 --> 00:15:10,130
!ما هذا؟

266
00:15:12,670 --> 00:15:15,600
هل سيطرة أوهوشي آواي تنحسر؟

267
00:15:15,930 --> 00:15:17,720
...يجدرُ بي إذاً

268
00:15:22,390 --> 00:15:23,410
درجة حرارة الجسم

269
00:15:24,210 --> 00:15:25,180
معدَّل نبضات القلب

270
00:15:26,120 --> 00:15:27,190
التنفُّس

271
00:15:28,460 --> 00:15:30,360
تعميق حواسي الخمسة إلى الحدِّ الأقصى

272
00:15:35,890 --> 00:15:37,740
تبدو "تينباي" في يساري

273
00:15:43,460 --> 00:15:44,460
...هذه

274
00:15:45,170 --> 00:15:47,210
لا تضغطي على نفسكِ كثيراً يا ريوكا

275
00:15:47,210 --> 00:15:48,920
لقد دخلَتِ المنطِقة

276
00:15:48,920 --> 00:15:51,340
نعم، يجدرُ بنا أن نكون بخير الآن

277
00:15:52,680 --> 00:15:53,550
كان

278
00:16:01,030 --> 00:16:03,480
رون، 4.200

279
00:16:06,900 --> 00:16:10,150
تخلّصَتْ من الزوج الجنوبي لتنتظر مُضاعفة
إحدى قراميد الرياح الخالية من الياكو ثلاثة أضعاف

280
00:16:11,330 --> 00:16:13,720
ادّخرَتْ قراميدي الرابحة

281
00:16:14,510 --> 00:16:16,180
أنا الموزِّعة أخيراً

282
00:16:17,370 --> 00:16:18,930
!المرّة السابقة

283
00:16:20,440 --> 00:16:21,400
توكي

284
00:16:23,850 --> 00:16:24,980
!ماذا؟

285
00:16:29,710 --> 00:16:31,380
،إن كانت عاجزة عن رؤية الطريق

286
00:16:31,910 --> 00:16:34,920
فهذا يعني إمَّا ستكونُ تعادلاً أو يفوز شخص آخر

287
00:16:34,920 --> 00:16:38,890
لكن الدِراية بذلك أمر مفيد

288
00:16:49,750 --> 00:16:51,070
!تجاهلَتْه؟

289
00:16:51,830 --> 00:16:54,280
تسومو، 300، 500

290
00:16:55,590 --> 00:16:58,030
تجاهلَتْ فوزَ الـ 1.300 لتستهدف فوز
تسومو قمامة؟

291
00:16:58,370 --> 00:17:00,540
!ماذا كان ذلك الفوز؟

292
00:17:00,540 --> 00:17:02,100
...تِلك الفتاة

293
00:17:02,100 --> 00:17:05,170
تلعبُ شيزو أحياناً بشكل غريزي تماماً

294
00:17:06,160 --> 00:17:08,790
...دائماً ما يبدو كخطأ للوهلة الأولى، لكن

295
00:17:09,210 --> 00:17:11,550
يمكنها أن ترى شيئاً، صحيح؟

296
00:17:11,900 --> 00:17:12,920
نعم

297
00:17:13,350 --> 00:17:16,050
لم تبقَ إلّا يدَين في نصف النهائي هذا

298
00:17:16,050 --> 00:17:18,800
اليد ما قبل الأخيرة: اليد الجنوبية 3

299
00:17:26,030 --> 00:17:28,310
إنها اليد الجنوبية الثالثة من النصف الثاني

300
00:17:28,810 --> 00:17:32,420
ربِحَتْ شيروزو مايرو يدَ بايمان في المباراة السابقة

301
00:17:32,420 --> 00:17:36,320
لا أريدُ الاستسلام، لكن لا أريدُ أن أكون
مطيّة ذلك أيضاً

302
00:17:36,730 --> 00:17:39,320
قد يكون أي شيء ابتداء من سانبايمان
وصولاً إلى ياكومان معدودة

303
00:17:44,250 --> 00:17:47,040
،يمكنكِ الحصول على ياكومان

304
00:17:47,040 --> 00:17:49,420
،لكن بما أنني موزِّعة

305
00:17:49,420 --> 00:17:51,420
عليّ أن أبقى كمُهاجِمة

306
00:17:52,150 --> 00:17:53,170
رييتشي

307
00:17:53,610 --> 00:17:54,670
فلتُقصي نفسكِ

308
00:17:55,220 --> 00:17:57,660
ولكن من جديد، لم أستطع تحقيق
رييتشي مُزدوجة

309
00:17:58,610 --> 00:17:59,930
!ما الذي يجري؟

310
00:18:00,500 --> 00:18:02,740
ما هذا؟

311
00:18:03,430 --> 00:18:04,960
من الطبيعي أنه كلّما أحرزَتْ
يدُكِ تقدُّماً

312
00:18:04,960 --> 00:18:07,840
ينقصُ عددُ القراميد التي تقرّبُكِ من الفوز

313
00:18:08,440 --> 00:18:11,480
لكن لم أشعر بذلك عندما يكونُ تعاوننا
الثنائي نشِطاً

314
00:18:11,480 --> 00:18:13,180
لكن ولفترة وجيزة

315
00:18:13,180 --> 00:18:15,690
كلّما تعمَّقنا أكثر نحو "الجبل"، يقلُّ إحساسي
بقائدتنا أكثر فأكثر

316
00:18:16,490 --> 00:18:19,450
لم يحدث هذا أبداً منذُ تشكيلنا للثنائي

317
00:18:20,370 --> 00:18:21,380
أين أنتِ؟

318
00:18:21,910 --> 00:18:22,950
...هيميكو

319
00:18:35,760 --> 00:18:37,240
كابتن

320
00:18:40,230 --> 00:18:40,640
تسومو

321
00:18:41,070 --> 00:18:43,240
‏‏8.000، 16.000

322
00:18:44,690 --> 00:18:47,140
ياكومان معدودة

323
00:18:47,470 --> 00:18:49,040
...جزاء الموزِّعة

324
00:18:49,040 --> 00:18:51,310
أما من طريقة لإيقاف هذا حقاً؟

325
00:18:51,870 --> 00:18:55,300
يسرُّني أنني استطعتُ الفوز، لكن ما زلتُ مستغربة

326
00:18:55,300 --> 00:18:58,650
حتّى الآن، الرابط الذي بيننا لم يتزعزع قيد أنملة

327
00:18:59,090 --> 00:19:02,910
شيء ما في عمق "الجبل" كان يتطفَّل

328
00:19:03,440 --> 00:19:05,910
إنها اليد الأخيرة أخيراً

329
00:19:06,810 --> 00:19:07,660
الفارق في النقاط

330
00:19:08,930 --> 00:19:11,670
القرميد الذي تجاهلَتْه آتشيغا في اليد
...الجنوبية الثانية... لا يمكن أن يكون

331
00:19:12,830 --> 00:19:16,580
ما كان يجب على آواي أن تعلن
عن رييتشي في تلك اليد

332
00:19:19,890 --> 00:19:22,180
هذا الفارق في النقاط

333
00:19:22,180 --> 00:19:25,600
حتّى لو حقّقتُ إصابة هانيمان مباشرة
بحقِّ آتشيغا التي في المركز الأول، سنتعادلُ فحسب

334
00:19:25,600 --> 00:19:27,520
،بسببِ أسبقيّة ترتيب الموزِّعة

335
00:19:27,520 --> 00:19:30,560
ستكونُ آتشيغا في المركز الثاني
وسنكونُ نحنُ في المركز الثالث

336
00:19:31,190 --> 00:19:35,580
،لو حقّقَتْ آتشيغا فوزَ الـ1.300 نقطة بدلاً من ذلك

337
00:19:35,580 --> 00:19:38,440
لوضعَتْنا إصابة هانيمان مُباشرة في المركز الثاني

338
00:19:39,480 --> 00:19:45,320
أريدُ أن أزيح آتشيغا عن المركز الأول
لكن هذا مستحيل الآن

339
00:19:50,200 --> 00:19:51,520
ما هذا؟

340
00:19:51,520 --> 00:19:53,710
لا أستطيع حتّى أن أحرز رييتشي مزدوجة
في اليد الأخيرة

341
00:19:53,710 --> 00:19:55,160
!هذا سيئ

342
00:19:56,030 --> 00:19:58,960
فوز القمامة بعدَ تجاهُل ذلك القرميد
...في اليد الجنوبية الثانية

343
00:19:59,720 --> 00:20:02,160
هل هذا يعني أنّها لا يُقلقها إلّا أوهوشي؟

344
00:20:02,160 --> 00:20:06,470
لا، لعلَّها تظنُّ أن شيندوجي وأنا
لن نستهدفَ أيادٍ كبيرة؟

345
00:20:06,870 --> 00:20:09,480
،الحقيقة هي أنني لم أعد قادرة على استدعاء توكي

346
00:20:09,480 --> 00:20:12,640
لذا أفضل ما يمكنني فعله هو تحقيق
فوز رخيص لكن سريع

347
00:20:12,640 --> 00:20:15,110
سيكونُ ذلك كافياً للتأهُّل إلى النهائي

348
00:20:15,110 --> 00:20:17,880
وإقصاء شيرايتوداي من البطولة

349
00:20:17,880 --> 00:20:19,900
سأحافظُ على خطوطي الدفاعية

350
00:20:20,750 --> 00:20:22,280
وأُهاجم بسرعة بالاستدعاء

351
00:20:22,770 --> 00:20:24,120
أنا الموزِّعة الأخيرة

352
00:20:24,120 --> 00:20:26,260
بما أنني الموزِّعة، بسلسلة الموزِّعة

353
00:20:26,260 --> 00:20:28,800
لستُ بحاجة لتسوية هذا الأمر بهجمة واحدة

354
00:20:28,800 --> 00:20:30,540
لحسن الحظّ، لديّ اثنتان من الدورا أيضاً

355
00:20:31,990 --> 00:20:35,040
لهذا سأربحُ في كلتا الحالتين
وأتأهَّل للنهائي

356
00:21:03,110 --> 00:21:06,870
جيّد، لقد فعلتُها! إذا سحبتُ القرميد الأخير
سأصبحُ في المركز الثاني

357
00:21:06,870 --> 00:21:09,420
لحظة، هل طموحي هو المركز الثاني؟

358
00:21:10,520 --> 00:21:11,870
هذا مُهين

359
00:21:12,660 --> 00:21:14,370
هل أعلن عن رييتشي؟

360
00:21:14,930 --> 00:21:18,010
عليّ أن أسحبه بنفسي على أي حال
،لكن بالرييتشي

361
00:21:18,010 --> 00:21:20,460
بمقدوري أن أحظى بإيبّاتسو
أو فوز من سينرياما

362
00:21:22,700 --> 00:21:24,090
فاتَتْني الفرصة

363
00:21:24,090 --> 00:21:24,900
تشي

364
00:21:27,190 --> 00:21:29,800
حسناً، أنا في حالة تينباي
إذا فزت، سنتأهّلُ للنهائي

365
00:21:30,850 --> 00:21:32,450
كما توقَّعت

366
00:21:32,450 --> 00:21:34,720
،حتّى بالمركز الأول الآمن نسبياً

367
00:21:34,720 --> 00:21:36,440
لا أحد يعلم ما قد يحدث

368
00:21:36,910 --> 00:21:40,350
الماجونغ، الطقس في الجبال، وسماء الخريف

369
00:21:40,350 --> 00:21:41,520
رغم أننا في الصيف

370
00:21:41,520 --> 00:21:42,400
تشي

371
00:21:45,240 --> 00:21:46,740
...ما زلتُ أبتعد واحداً عن تينباي

372
00:21:47,260 --> 00:21:49,320
هؤلاء الفتيات يلجأن للهجوم

373
00:21:50,620 --> 00:21:51,580
!هذه

374
00:21:51,580 --> 00:21:52,290
كان

375
00:21:53,000 --> 00:21:54,330
ما زلتُ قادرة على فعلها

376
00:21:55,310 --> 00:21:56,250
رييتشي

377
00:21:57,640 --> 00:22:01,500
بما أنني سأحصلُ على الأورا دورا من الـ"كان"، فإنّ الكسب
من آتشيغا أو سحب القرميد بنفسي سيقودني إلى المركز الأول

378
00:22:01,810 --> 00:22:04,380
الانتهاء في المركز الثاني سيئ للغاية

379
00:22:05,470 --> 00:22:06,760
لقد قمتِ بتحرّكاتكِ إذاً يا أوهوشي

380
00:22:07,240 --> 00:22:09,010
...لكنّني في المركز الثالث كموزِّعة أخيراً

381
00:22:09,590 --> 00:22:10,760
،حتّى لو اضطررتُ لكسرِ تينباي خاصّتي

382
00:22:12,100 --> 00:22:13,390
لن أنسحب الآن

383
00:22:13,950 --> 00:22:16,700
هذا هو واقعُ الأمر

384
00:22:16,700 --> 00:22:20,600
لكن إن كسِبتُ من ذلك، فلن أحصل
إلّا على سانبايمان

385
00:22:20,600 --> 00:22:22,660
أو سأتعادل مع آتشيغا

386
00:22:23,400 --> 00:22:27,480
ستكونُ آتشيغا في المركز الأوّل بسبب أسبقية
ترتيب الموزِّعة، وسأكون في المركز الثاني

387
00:22:28,370 --> 00:22:30,410
لن أسمح بذلك أبداً

388
00:22:32,790 --> 00:22:33,580
تشي

389
00:22:34,780 --> 00:22:35,950
تينباي

390
00:22:37,210 --> 00:22:39,060
،اختفَتْ إيبّاتسو

391
00:22:39,710 --> 00:22:41,130
...لكنّني مع ذلك

392
00:22:45,250 --> 00:22:46,300
سأفوز...

393
00:22:50,810 --> 00:22:51,850
تسومو

394
00:22:55,040 --> 00:22:55,700
‏‏6.000

395
00:22:55,700 --> 00:22:56,930
أوهوشي

396
00:22:57,530 --> 00:23:00,190
ينبغي أن تتنبّهي من تحقيق أورا دورا
نتيجة الإعلان عن كان

397
00:23:02,120 --> 00:23:04,650
نعم، تِلك هي القاعدة على ما أظن

398
00:23:04,650 --> 00:23:06,360
أما زلتِ لا تتقبّلين هزيمتكِ؟

399
00:23:07,320 --> 00:23:08,860
مسكينة

400
00:23:12,610 --> 00:23:14,660
أنا آسفة يا أوهوشي

401
00:23:15,580 --> 00:23:16,870
...لم تعُد تلك

402
00:23:17,770 --> 00:23:19,660
منطقتكِ

403
00:23:21,950 --> 00:23:24,040
انتهت اللعبة

404
00:23:24,450 --> 00:23:28,050
أعلنُ ها هنا عن نهاية المباراة الأولى
من نصف النهائي

405
00:23:24,900 --> 00:23:26,050
...لكن

406
00:23:28,050 --> 00:23:34,300
تحلُّ في المركز الأوَّل الحصان الأسود
لأكاديمية آتشيغا للإناث، تاكاكامو شيزونو

407
00:23:34,820 --> 00:23:36,480
شكراً لكم

408
00:23:52,500 --> 00:23:53,640
...هارو

409
00:23:56,400 --> 00:23:57,950
هارو

410
00:23:57,950 --> 00:23:58,770
...نعم

411
00:23:59,180 --> 00:24:01,760
...السور الذي لم أستطع التغلُّب عليه في زمني

412
00:24:02,590 --> 00:24:06,340
بما أنني أنتمي لمجموعة من الناس
الذين تكبّدوا هزيمة هنا

413
00:24:06,890 --> 00:24:09,840
كنتُ أخشى من عدم قدرتي

414
00:24:10,220 --> 00:24:12,580
على السعادةِ بصدق إن ربِحنا

415
00:24:15,600 --> 00:24:16,850
،لكن الآن

416
00:24:18,060 --> 00:24:19,660
كلّ ما أشعر به هو السعادة

417
00:24:20,250 --> 00:24:21,850
حتّى أكثر من السعادة التي أشعرُها لنفسي

418
00:24:24,510 --> 00:24:26,860
مبروك للجميع

419
00:24:27,750 --> 00:24:29,360
شكراً لكُن

420
00:24:31,750 --> 00:24:32,940
هارامورا

421
00:24:34,130 --> 00:24:38,940
عادَتْ هارامورا أثناء إجراءكِ لمقابلة البطل

422
00:24:38,940 --> 00:24:40,120
!عجباً

423
00:24:40,120 --> 00:24:43,500
طلبَتْ منِّي أن أبلغكِ تحياتها

424
00:24:43,500 --> 00:24:46,790
آه بدَتْ مستمتعة كثيراً

425
00:24:47,830 --> 00:24:50,830
هل تريدين بعضاً من هذه؟

426
00:24:50,830 --> 00:24:51,800
ما هذه؟

427
00:24:52,380 --> 00:24:56,550
هديّة من صديقاتي القديمات
في المدرسة الإعدادية، تاكو

428
00:24:56,550 --> 00:24:57,810
تاكو؟

429
00:24:57,810 --> 00:24:59,420
ولماذا هذه؟

430
00:25:02,390 --> 00:25:03,580
شكراً لك

431
00:25:04,890 --> 00:25:06,560
...المعذرة

432
00:25:07,860 --> 00:25:09,910
...لا أعرف ماذا أقول

433
00:25:18,890 --> 00:25:19,830
أنا حزينةٌ جداً

434
00:25:20,790 --> 00:25:22,580
أريدُ الذهاب إلى ريوكا

435
00:25:23,300 --> 00:25:27,580
لا أدري ما إن كانَتْ ستُمطِرُ على فخذيها الآن

436
00:25:30,090 --> 00:25:33,210
...أنا آسفة يا تيرو، حللتُ في المركز الثاني

437
00:25:34,580 --> 00:25:37,220
لقد اجتزنا نصفَ النهائي، لِذا اربحي فحسب
في المرّة المقبلة

438
00:25:37,810 --> 00:25:40,970
سأصلحُ عاداتي السيّئة في غضون يومين
وأقلب الطاولة

439
00:25:40,970 --> 00:25:43,420
...أنا أيضاً، في المرّة القادمة، سوف

440
00:25:44,350 --> 00:25:49,020
بعد غد، سأهزمكِ مرّة مرَّة يا تاكاكامو شيزونو

441
00:25:52,130 --> 00:25:54,240
إنه دافئ بعدما ارتديتِه يا آكو

442
00:25:54,520 --> 00:25:55,860
عمّاذا تتكلمين؟

443
00:25:55,860 --> 00:25:57,060
هل قلتِ "دافئ"؟

444
00:26:04,070 --> 00:26:08,200
لا يُسمَح بزيارته إلّا للفرق التي تأهّلَتْ للنهائي

445
00:26:08,200 --> 00:26:10,750
لِذا خذيني إلى هناك من فضلكِ

446
00:26:11,310 --> 00:26:12,520
كابتن

447
00:26:15,090 --> 00:26:16,420
،في وضعكِ الراهن

448
00:26:16,420 --> 00:26:19,110
ربّما بمقدوركِ حتّى أن تتغلَّبي على هيمنة
الدورا الخاصّة بكورو

449
00:26:20,440 --> 00:26:22,010
أظنُّه هنا

450
00:26:28,390 --> 00:26:31,520
لقد استُبدِلَ الزجاجُ بجدران أيضاً

451
00:26:31,520 --> 00:26:33,150
آملُ أن تكون دافئة

452
00:26:34,340 --> 00:26:36,150
هيّا بنا يا هارو

453
00:26:54,730 --> 00:26:55,920
...آكادو

454
00:26:56,410 --> 00:26:57,800
...اللاعبة المحترفة، كوكاجي

455
00:26:59,710 --> 00:27:01,420
لم أرك منذُ وقت

456
00:27:01,420 --> 00:27:02,640
اشتقتُ إليكِ

457
00:27:03,310 --> 00:27:05,400
لماذا أنتِ هنا اليوم؟

458
00:27:05,400 --> 00:27:08,390
ماذا؟ لستُ خائفة بعكسِ ما توقَّعت

459
00:27:08,790 --> 00:27:12,710
حجزوا لي غرفةً في فندق قريب حتّى النِّهائي

460
00:27:12,710 --> 00:27:16,040
ولكن عندما لا أكون في المنزل
ببدلتي الرياضية، لا أستطيع الاسترخاء

461
00:27:16,040 --> 00:27:18,150
لهذا فكّرتُ في أن أتمشَّى لتصفية ذهني

462
00:27:18,590 --> 00:27:20,320
إنها مثل شيزو

463
00:27:19,170 --> 00:27:21,840
...أتيتُ إلى هنا مع تلاميذي لرؤية الـ

464
00:27:20,320 --> 00:27:21,710
!يا لها من مفاجأة

465
00:27:23,840 --> 00:27:24,780
آه فهمت

466
00:27:25,390 --> 00:27:29,540
هؤلاء الفتيات اللَّاتي يقِفنَ خلفي هُنَّ ثِقتي

467
00:27:30,410 --> 00:27:31,680
،بالمناسبة

468
00:27:33,310 --> 00:27:35,800
لقد قرّرتُ أن أجرِّبَ حظِّي كلاعبة
محترِفة كذلك

469
00:27:38,340 --> 00:27:41,680
حالما رأيتهنّ يربحنَ بالطبع

470
00:27:54,310 --> 00:27:56,020
حسناً، هيّا بنا نعود

471
00:27:56,020 --> 00:27:57,040
حسناً

472
00:27:57,530 --> 00:27:59,760
أنا أتضوّر جوعاً

473
00:28:01,990 --> 00:28:02,910
شيزو؟

474
00:28:11,830 --> 00:28:12,920
نودوكا

475
00:28:15,370 --> 00:28:17,920
لنلعب هنا بعد غدّ

476
00:28:27,410 --> 00:28:29,060
!كما كنّا نفعل

477
00:28:42,790 --> 00:28:44,740
هيّا بنا

478
00:28:53,320 --> 00:28:56,210
حسناً، لننطلق

479
00:28:58,750 --> 00:29:00,320
لنسحقهن

480
00:29:00,320 --> 00:29:02,480
سأُريهن

481
00:29:11,560 --> 00:29:13,260
نودوكا، أنتِ بطيئة للغاية

482
00:29:14,430 --> 00:29:16,810
أنا واثقة أنكِ لا تمارسين الرياضة

483
00:29:19,390 --> 00:29:21,260
أنا قادمة

484
00:29:23,800 --> 00:29:25,820
،في القرن 21

485
00:29:25,820 --> 00:29:29,500
،بلغَ عددُ لاعبي الماجونغ في العالم مئات الملايين

486
00:29:29,500 --> 00:29:33,700
وحتّى اللاعبين المحترفين لديهم شرَه للعبة

487
00:29:34,250 --> 00:29:38,840
حتّى على مُستوى المدارس الثانوية
تُقامُ بطولة وطنيّة واسعة سنوياً

488
00:29:38,840 --> 00:29:43,300
حيثُ تتنافسُ لاعبات المدارس الثانوية فيما بينهن

489
00:29:43,300 --> 00:29:47,020
للوصول إلى دوري المحترفين

490
00:29:47,510 --> 00:29:52,720
هذا هو دربُ الفتيات اللّاتي كُنَّ يطمحن للقمّة