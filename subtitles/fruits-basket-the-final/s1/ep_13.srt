1
00:00:01,020 --> 00:00:02,770
!كيو-كن، كيو-كن

2
00:00:02,770 --> 00:00:05,690
!انظر! إنها إيسوزو-سان صغيرة

3
00:00:05,690 --> 00:00:08,270
.إنه مهر، صغير جدًا

4
00:00:08,270 --> 00:00:09,940
!إنه جميل

5
00:00:09,940 --> 00:00:13,110
كيو-كن، أي حيوان سنذهب لرؤيته الآن؟

6
00:00:13,110 --> 00:00:15,110
.سنجعل الأولوية لمن تريدين رؤيته أكثر

7
00:00:15,620 --> 00:00:18,530
.حقًا؟ إذن لنذهب لرؤية الفيلة

8
00:00:18,530 --> 00:00:20,040
...لا يوجد زراف

9
00:00:20,040 --> 00:00:22,370
.لم يسألكما أحد أيتها المرافقتان

10
00:00:22,370 --> 00:00:25,420
ما الأهم من الفيلة يا غبي؟

11
00:00:25,420 --> 00:00:26,960
.لا يوجد زراف

12
00:00:26,960 --> 00:00:30,750
.ويفترض أن تختار مكانًا أفضل لأول موعد، مثل حديقة الملاهي

13
00:00:30,750 --> 00:00:32,670
....مكانًا أكثر إثارة و

14
00:00:32,670 --> 00:00:34,930
.ما الأمر؟ وكفى صراخًا

15
00:00:34,930 --> 00:00:38,800
!......لا بد أنك تخشى المرتفعات، و..... ستصبح

16
00:00:39,600 --> 00:00:42,100
!لا تصرخي بهذه الكلمات على الملأ

17
00:00:42,100 --> 00:00:43,270
...الزراف

18
00:00:43,270 --> 00:00:47,770
!مكتوب على اللافتة أن بإمكاننا مداعبة الكثير من القطط في تلك المنطقة

19
00:00:47,770 --> 00:00:50,270
.الفيلة رائعة، لكن القطط رائعة أيضًا

20
00:00:50,270 --> 00:00:54,610
رغم خطورة انزلاق سروالك
.ليس بإمكانك منع نفسك من الانحناء لمداعبة... القطط

21
00:00:54,610 --> 00:00:56,070
.هذا مرهق

22
00:00:56,070 --> 00:01:01,870
.أو-تشان، هانا-تشان، أنا التي طلبت منه أخذي إلى هنا

23
00:01:01,870 --> 00:01:06,540
.أخطأت الفهم، كنا نتنمر عليه فحسب

24
00:01:06,540 --> 00:01:11,090
.أنا أحب هذا المكان، إنه مريح، لنتناول المثلجات الآن

25
00:01:11,090 --> 00:01:14,420
.الأماكن التي توجد فيها الزراف رائعة أيضًا، أحبها

26
00:01:15,470 --> 00:01:18,930
.إنها قطط! كم هي رائعة

27
00:01:18,930 --> 00:01:20,510
!إنها ظريفة

28
00:01:21,370 --> 00:01:22,220
.كيون، كيون

29
00:01:23,310 --> 00:01:24,520
.انظر

30
00:01:26,140 --> 00:01:27,730
.القط الأسود يناسبها

31
00:01:27,730 --> 00:01:29,610
.كأنه فرد من أسرتها

32
00:01:46,250 --> 00:01:53,590
في ذلك اليوم راقبت تورو بصمت
.وهي تلتقط الخرز الذي نزعته

33
00:01:54,960 --> 00:02:00,220
لا أعلم... ربما كان التقاطه محاولة منها

34
00:02:00,220 --> 00:02:02,890
.لحماية حاضري ومستقبلي

35
00:02:04,060 --> 00:02:08,480
ما أعلمه هو أنه ربما يكون حب أحدهم

36
00:02:08,480 --> 00:02:13,320
يعني الاعتزاز بماضيه ومستقبله أيضًا

37
00:02:13,320 --> 00:02:16,820
.وليس أن تحب ما تراه منه الآن فقط

38
00:02:18,380 --> 00:02:22,320
حقًا؟ هل تقدمت إلى تلك الكلية البعيدة؟

39
00:02:22,320 --> 00:02:23,330
.نعم

40
00:02:23,330 --> 00:02:27,000
.لديهم برنامج أثار اهتمامي، سأعيش وحدي في الربيع

41
00:02:27,000 --> 00:02:31,790
.هل تستطيع فعل هذا؟ لا أريد أن أجد جثتك عند زيارتك

42
00:02:32,170 --> 00:02:34,380
!التجربة هي أفضل معلم

43
00:02:34,380 --> 00:02:37,420
هل تعلم ماتشي بهذا؟

44
00:02:37,420 --> 00:02:39,590
.إنها تعلم، لا تقلق

45
00:02:41,320 --> 00:02:44,350
!تسلقت سلم البالغين

46
00:02:44,350 --> 00:02:47,730
.إذا قلت هذا لـ ماتشي ستضربك بالتأكيد

47
00:02:47,730 --> 00:02:51,310
بالمناسبة، ماذا قررت يا كاكيرو بخصوص الكلية؟

48
00:02:51,310 --> 00:02:53,400
.سأذهب

49
00:02:53,400 --> 00:02:58,030
،لم أكن متحمسًا للفكرة، لكن الجميع يحثني على الذهاب

50
00:02:58,030 --> 00:03:00,780
.لهذا لم أجد أمامي خيارًا آخر

51
00:03:04,160 --> 00:03:07,700
.يسعدني هذا، كنت أخشى ألا تأتي

52
00:03:07,700 --> 00:03:09,500
كنت مترددة، أليس كذلك؟

53
00:03:09,500 --> 00:03:11,670
"!لأنني أفضل أن أكون وحدي معك"

54
00:03:11,670 --> 00:03:15,170
!لا، لأنني أردت أن أتجنب صدور مثل هذا الكلام منك

55
00:03:15,170 --> 00:03:18,550
.أرى أنك تسلقت سلم البالغين

56
00:03:19,840 --> 00:03:21,590
.أخبرتك

57
00:03:23,430 --> 00:03:25,220
!مشينا كثيرًا

58
00:03:25,220 --> 00:03:26,930
.لكن كان الأمر ممتعًا

59
00:03:26,930 --> 00:03:28,970
!نعم، للغاية

60
00:03:29,980 --> 00:03:33,350
هل بإمكاني دخول الحمام قبل المغادرة؟

61
00:03:33,350 --> 00:03:34,730
هل بإمكانك الذهاب وحدك؟

62
00:03:34,730 --> 00:03:37,270
!نعم! سأعود في الحال

63
00:03:38,030 --> 00:03:39,940
...أنا مرهق

64
00:03:39,940 --> 00:03:46,160
لكن لماذا لم أرها تتعرق رغم أنها ترتدي السواد دائمًا هكذا؟

65
00:03:46,160 --> 00:03:48,290
.هذا غريب بالنسبة لبشر

66
00:03:48,290 --> 00:03:49,660
.إنها قوة الإرادة

67
00:03:49,660 --> 00:03:52,790
!قلت لك لا تقرئي أفكاري

68
00:03:54,330 --> 00:03:56,290
ما الأمر؟

69
00:03:56,290 --> 00:03:59,670
ستأخذها بعيدًا، أليس كذلك؟

70
00:04:00,760 --> 00:04:04,720
...نعم... يومًا ما

71
00:04:04,720 --> 00:04:10,520
.أجل، كنت أعلم أن هذا الوقت سيحين

72
00:04:11,850 --> 00:04:13,230
...لكن

73
00:04:14,270 --> 00:04:15,940
.هذه أنانية

74
00:04:17,770 --> 00:04:18,900
...آسـ

75
00:04:19,530 --> 00:04:20,730
...رغم هذا

76
00:04:20,730 --> 00:04:25,610
."سأسامحك إذا ناديتني "ماما

77
00:04:25,610 --> 00:04:27,570
هل تطلبين مني أن أموت أم...؟

78
00:04:27,570 --> 00:04:31,410
.هاناجيما، لنتوقف عن التنمر عليه

79
00:04:31,410 --> 00:04:33,250
.حسنًا... سحقًا

80
00:04:33,250 --> 00:04:34,960
.قالت سحقًا

81
00:04:34,960 --> 00:04:36,580
.اسمع يا كيون

82
00:04:36,580 --> 00:04:40,170
.قد لا يبدو هذا، لكننا نحبك

83
00:04:40,170 --> 00:04:43,090
.أنت غبي لكنك شخص طيب، ويصعب كرهك

84
00:04:43,090 --> 00:04:46,390
.لكنك غبي

85
00:04:47,850 --> 00:04:49,300
...تورو

86
00:04:50,560 --> 00:04:55,810
.واحدة منا وهي صديقتنا وفرد من أسرتنا

87
00:04:55,810 --> 00:04:59,190
.وبجدية... نحن نعتمد عليك

88
00:05:03,900 --> 00:05:09,120
.كان يوم التخرج مشمسًا كما يرغب الجميع

89
00:05:09,120 --> 00:05:12,790
.كانت الرياح الصافية والسحب المتراكمة رائعة

90
00:05:13,540 --> 00:05:17,330
بدا العالم وكأنه يمنحنا البركة

91
00:05:17,330 --> 00:05:19,630
.أثناء تخرجنا واستعدادنا لمغادرة المنزل

92
00:05:20,790 --> 00:05:24,550
...أجل، أنا أيضًا و كيو-كن سنغادر

93
00:05:25,880 --> 00:05:27,590
!هذا جيد

94
00:05:27,590 --> 00:05:30,680
!أعتقد أنني انتهيت من تنظيف غرفتي

95
00:05:30,680 --> 00:05:33,310
.تبدو فارغة للغاية

96
00:05:33,310 --> 00:05:34,390
!أجل

97
00:05:34,390 --> 00:05:37,230
.وكذلك غرفتك يا كيو-كن

98
00:05:37,230 --> 00:05:39,520
،نعم، لا شيء أتركه خلفي

99
00:05:39,520 --> 00:05:42,270
.وسنبيت في منزل شيشو الليلة

100
00:05:44,360 --> 00:05:50,740
.لا يسعني إلا أن أتذكر أول يوم أدخل فيه هذه الغرفة

101
00:05:50,740 --> 00:05:54,500
...كان يوكي-كن وشيغوري-سان في غاية اللطف

102
00:05:54,500 --> 00:05:57,160
...كنت متوترة للغاية

103
00:05:57,160 --> 00:06:00,040
!ثم حطمت السقف يا كيو-كن

104
00:06:00,990 --> 00:06:04,000
...ربما حدث هذا

105
00:06:04,000 --> 00:06:08,180
،نعم! كنت متفاجئة للغاية

106
00:06:08,180 --> 00:06:11,930
.ثم تحولتم جميعًا، لذا تفاجأت أكثر

107
00:06:11,930 --> 00:06:13,600
...لكن كان هذا

108
00:06:14,640 --> 00:06:16,980
.ممتعًا للغاية

109
00:06:16,980 --> 00:06:19,940
.حظيت بوقت ممتع

110
00:06:19,940 --> 00:06:26,690
...استمتعت بتلك الأيام معكم جميعًا، كانت كالجواهر

111
00:06:26,690 --> 00:06:30,740
...إنها غالية جدًا بالنسبة لي

112
00:06:30,740 --> 00:06:33,740
.أشعر بالوحدة بعد انتهائها

113
00:06:36,000 --> 00:06:37,370
.أشعر بالوحدة

114
00:06:38,540 --> 00:06:43,460
هل هذا لأنني أحببت الحياة هنا؟

115
00:06:44,290 --> 00:06:48,920
...مع ازدياد الحب يزداد الوداع وحشة

116
00:06:50,130 --> 00:06:52,760
.يبدو أنكِ لا تدركين الأمر

117
00:06:54,140 --> 00:07:00,480
.اسمعي، الجميع يحبونك أكثر مما تخالين

118
00:07:01,350 --> 00:07:06,650
.لذا ستكون الأمور على ما يرام، لن تكون آخر مرة ترينهم فيها

119
00:07:08,070 --> 00:07:11,570
إنها بداية مأدبة جديدة، صحيح؟

120
00:07:13,950 --> 00:07:15,120
!أجل

121
00:07:18,080 --> 00:07:20,620
!الـ-الـ-الـ-المعذرة

122
00:07:20,620 --> 00:07:24,250
.أنت تخجلين من أغرب الأشياء

123
00:07:25,420 --> 00:07:28,050
.تذكرت، هذا لك

124
00:07:28,050 --> 00:07:32,760
.إنه مفتاح منزلي الجديد، تعالي لزيارتي متى شئت

125
00:07:32,760 --> 00:07:36,100
.لا أريد أن تقلقي من أن أخونك في الكلية

126
00:07:36,100 --> 00:07:40,640
...لـ-لن أقلق... من شيء كهذا

127
00:07:41,690 --> 00:07:42,900
!أنا أكذب

128
00:07:42,900 --> 00:07:46,270
.الصراحة هي الحل الأمثل

129
00:07:46,270 --> 00:07:49,610
.أنت فظيع، أنت شخص فظيع

130
00:07:50,570 --> 00:07:56,410
عذرًا... لكنك لن تغادر في الحال، صحيح؟

131
00:07:56,410 --> 00:07:59,120
نعم، أتعلمين؟

132
00:07:59,120 --> 00:08:01,460
...اللذان سيغادران غدًا

133
00:08:04,250 --> 00:08:06,540
هل ستشعر بالوحدة؟

134
00:08:08,500 --> 00:08:12,510
.أجل، هذا مؤكد

135
00:08:13,510 --> 00:08:15,800
...أنا... أيضًا

136
00:08:17,100 --> 00:08:19,720
.أنا أيضًا أشعر بالوحدة

137
00:08:19,720 --> 00:08:26,520
.سأشتاق إلى رؤيتك بسهولة يا يوكي-سينباي

138
00:08:26,520 --> 00:08:30,480
.لذا... سألحق بك

139
00:08:30,480 --> 00:08:33,490
.سأحرص على اللحاق بك

140
00:08:35,700 --> 00:08:37,120
.سأكون في انتظارك

141
00:08:41,040 --> 00:08:43,790
.صحيح يا كاغورا-تشان

142
00:08:43,790 --> 00:08:47,540
هل عرفت أن شيغوري ني-سان سيتوقف عن كتابة الروايات؟

143
00:08:48,270 --> 00:08:50,590
!حقًا؟ لم أكن أعلم

144
00:08:50,590 --> 00:08:53,300
...سمعت هذا من ميتسورو-سان

145
00:08:53,300 --> 00:08:55,340
...كان يجب أن تريها

146
00:08:55,340 --> 00:08:57,850
!انتهى الأمر! سقط الشرير

147
00:08:57,850 --> 00:09:01,430
!هذا رائع! هذا رائع

148
00:09:01,430 --> 00:09:03,600
.كانت سعيدة

149
00:09:03,600 --> 00:09:08,270
تُرى هل توقف ليكون إلى جوار أكيتو؟

150
00:09:08,270 --> 00:09:10,610
هل سيتزوجان يا تُرى؟

151
00:09:10,610 --> 00:09:11,820
.لا أعلم

152
00:09:11,820 --> 00:09:15,610
المهم، متى ستتزوج ميتسورو-سان يا ريتسو؟

153
00:09:16,610 --> 00:09:19,120
!أ-أ-أتزوجها؟

154
00:09:19,120 --> 00:09:24,910
...لـ-لـ-لا أستطيع، ما زلت... لكن أنا

155
00:09:20,870 --> 00:09:24,910
!لا تمزق الكيمونو! ألن تعطيني إياه؟

156
00:09:24,910 --> 00:09:27,040
.تبًا، افعل ما شئت

157
00:09:27,040 --> 00:09:30,500
!لماذا أصبح الجميع يعيش قصة حب مؤخرًا؟ تبًا

158
00:09:31,060 --> 00:09:34,630
لكن ستذهبين للوداع غدًا، صحيح؟

159
00:09:34,630 --> 00:09:41,060
.سأذهب طبعًا ! ليس من أجل تورو-كن، بل من أجل عزيزي كيو-كن

160
00:09:42,600 --> 00:09:46,230
أنت تأملين لهما السعادة، صحيح؟

161
00:09:46,230 --> 00:09:49,690
.لا! لا! الأمر مختلف

162
00:09:49,690 --> 00:09:54,530
.سيكونان سعيدين بالتأكيد

163
00:09:57,780 --> 00:10:01,580
لن يعيش أحد في ذلك المنزل بعد الآن، صحيح؟

164
00:10:01,580 --> 00:10:06,660
ماذا سيحدث له؟ هل سيهدمونه؟

165
00:10:06,660 --> 00:10:09,710
.سمعت أنه سيُترك لبعض الوقت على الأقل

166
00:10:09,710 --> 00:10:13,090
.حقًا؟ يسعدني هذا

167
00:10:13,090 --> 00:10:17,220
.أرجو أن ينتقل إليه أحدهم قبل أن يهدموه

168
00:10:18,180 --> 00:10:19,300
.أجل

169
00:10:22,230 --> 00:10:23,160
!ما الأمر؟

170
00:10:24,060 --> 00:10:29,940
...آ-آسفة! الأمر ليس كما تعتقد، كنت أفكر في يوم غد

171
00:10:29,940 --> 00:10:34,400
.لا تقلق، سأودعها غدًا بابتسامة

172
00:10:35,110 --> 00:10:36,440
.لا بأس

173
00:10:37,530 --> 00:10:41,700
.ابكي بكاءً شديدًا غدًا

174
00:10:41,700 --> 00:10:44,660
.لأنك تحبينها

175
00:10:46,330 --> 00:10:54,960
.سينسي كان يضحك لأنه لم يتعرض للضرب من أحدهم كما أخبره توري-ني

176
00:10:54,960 --> 00:11:00,430
.هذا صحيح، لكن لأن الجميع أنضج من شي-تشان

177
00:11:00,430 --> 00:11:03,100
.نعم، الجميع ناضجون

178
00:11:03,100 --> 00:11:07,810
المهم الآن، كيف يجرؤ كيو على أخذ تورو معه؟

179
00:11:07,810 --> 00:11:10,600
.أنا واثق من أنه يريد أن يستأثر بها لنفسه

180
00:11:10,600 --> 00:11:14,400
!أريد أن أقرصه بقوة

181
00:11:14,400 --> 00:11:16,070
ماذا لو قرصته غدًا؟

182
00:11:17,050 --> 00:11:19,700
.لا أستطيع فعل هذا أمام تورو

183
00:11:20,410 --> 00:11:25,530
.صحيح، لكن بفضله حظيت بحلم جديد

184
00:11:25,530 --> 00:11:29,160
سأجد شخصًا رائعًا آخر

185
00:11:29,160 --> 00:11:32,920
.وسنذهب لزيارتهما للتباهي فقط

186
00:11:32,920 --> 00:11:38,800
.لذا من الأفضل أن تظل تورو سعيدة

187
00:11:38,800 --> 00:11:44,930
.يجب أن تظل مبتسمة، وإلا أصبت بخيبة أمل

188
00:11:44,930 --> 00:11:50,100
كيف تتصرفان وكأن شيئًا لم يكن؟

189
00:11:50,100 --> 00:11:55,980
،لقد أساءت إليكما

190
00:11:55,980 --> 00:11:58,570
...وقد تأذيتما كثيرًا

191
00:11:58,570 --> 00:12:02,450
!تورو أيضًا ستظل الندوب عليها مدى الحياة

192
00:12:02,450 --> 00:12:08,490
!لن أسامحها، لن أسامحها

193
00:12:08,490 --> 00:12:10,950
هل أنا مخطئة؟

194
00:12:10,950 --> 00:12:16,460
كيف استطعتم جميعًا تجاوز الأمر؟ لماذا...؟

195
00:12:16,460 --> 00:12:20,420
.الفوضى التي تعم قلبي لا تزول مهما حاولت

196
00:12:20,420 --> 00:12:23,760
هارو، هل خيبت ظنك؟

197
00:12:23,760 --> 00:12:27,970
...أخشى أن تكرهني لأنني أقول هذا الكلام دائمًا

198
00:12:27,970 --> 00:12:32,430
.لن يخيب ظني فيك، ولن أكرهك

199
00:12:34,520 --> 00:12:38,770
ما حدث جعلهم يعانون من اضطراب عاطفي

200
00:12:38,770 --> 00:12:42,240
.رغم تفاوت التأثير بينهم

201
00:12:42,240 --> 00:12:46,910
.نعم، لكنني واثقة من أنهم سيتجاوزون هذا

202
00:12:46,910 --> 00:12:49,830
...غدًا هو اليوم الموعود

203
00:12:49,830 --> 00:12:55,670
.نعم، لكن رغم شعوري بالوحدة إلا أنني لستُ قلقة

204
00:12:55,670 --> 00:12:57,920
.يراودني نفس الشعور

205
00:12:57,920 --> 00:13:00,300
...لا

206
00:13:01,380 --> 00:13:05,720
.أجل، غدًا. سأبلغها تحياتك

207
00:13:07,300 --> 00:13:14,230
.نعم، سيكون الأمر موحشًا، لكنني سعيدة

208
00:13:14,230 --> 00:13:16,350
أنا أيضًا أشعر بالحماس

209
00:13:17,860 --> 00:13:19,520
.لرحلتي

210
00:13:21,730 --> 00:13:24,490
اسمع، هل تفتحت أزهار الكرز عندك؟

211
00:13:24,490 --> 00:13:25,950
.قريبًا ستتفتح

212
00:13:25,950 --> 00:13:31,040
.إذن سأبدأ رحلتي قريبًا

213
00:13:31,040 --> 00:13:33,790
.كن مستعدًا لإطعامي

214
00:13:33,790 --> 00:13:35,210
التورورو سوبا؟

215
00:13:39,420 --> 00:13:41,300
!آيا-كن، آيا-كن

216
00:13:41,300 --> 00:13:44,970
ما رأيك بإضافة هذا إلى الهدايا المقدمة إلى تورو-كن ورفيقها؟

217
00:13:44,970 --> 00:13:47,760
عمل جيد يا ميني! كل ما تشعرين به، وما تفكرين فيه

218
00:13:47,760 --> 00:13:50,300
!ضعيه في الصندوق

219
00:13:50,300 --> 00:13:55,060
!هذا سيمكنهما من عيش حياة براقة، مهمتنا بالغة الأهمية

220
00:13:55,060 --> 00:13:56,640
!أجل

221
00:13:58,020 --> 00:14:00,310
...لكن آيا-كن

222
00:14:00,310 --> 00:14:03,070
،من خلال خبرتي

223
00:14:03,070 --> 00:14:07,200
.مشاهدة الأطفال يغادرون سيمنح شعورًا بالوحدة

224
00:14:07,200 --> 00:14:08,860
!سنشعر بالوحدة طبعًا

225
00:14:08,860 --> 00:14:11,490
لهذا يجب علينا نحن البالغين تضمين حبنا وكآبتنا في الصندوق

226
00:14:11,490 --> 00:14:15,160
مع الرامن والجوارب وأزياء الخادمات وما إلى ذلك

227
00:14:15,160 --> 00:14:17,580
!وأن نرسلها كرمز لمشاعرنا

228
00:14:18,540 --> 00:14:24,130
...ونرسلها للأطفال، أينما ذهبوا

229
00:14:24,130 --> 00:14:31,050
!لهذا يجب علينا إرسال سلع أكثر وأفضل لـ يوكي

230
00:14:31,050 --> 00:14:33,810
!ما رأيك بهذا من أجل شقيقك؟

231
00:14:34,430 --> 00:14:35,890
أوكيناوا؟

232
00:14:35,890 --> 00:14:38,730
!في عطلة الصيف؟ أنا ذاهبة! لنذهب

233
00:14:38,730 --> 00:14:41,440
لكن هل بإمكانك الذهاب؟

234
00:14:41,440 --> 00:14:43,730
.نعم، لهذا دعوتك

235
00:14:43,730 --> 00:14:47,150
.لم أذهب إلى رحلة من قبل

236
00:14:47,150 --> 00:14:51,320
.لم أذهب إلى الكثير من الأماكن في اليابان

237
00:14:51,320 --> 00:14:53,530
...أفكر في أن أبدأ من الجنوب وأشق طريقي نحو

238
00:14:52,620 --> 00:14:54,490
!هذا رائع، رائع

239
00:14:54,490 --> 00:14:56,910
.يروق لي أن تفعل ما لم تعتد عليه

240
00:14:56,910 --> 00:15:00,920
!جزيرة جنوبية مع هاتوري-كن! أكمام قصيرة مع هاتوري-كن

241
00:15:00,920 --> 00:15:03,000
.يبدو أنك مستمتعة يا مايو

242
00:15:03,000 --> 00:15:07,090
...أعني أنني لا أستطيع تخيلك بزي السباحة

243
00:15:08,420 --> 00:15:12,680
.آسفة، أنا لا أطيق مظهري بزي السباحة

244
00:15:12,680 --> 00:15:13,640
لماذا؟

245
00:15:13,640 --> 00:15:19,390
...في الحقيقة... لأن جسدي

246
00:15:19,390 --> 00:15:25,070
...لا أملك ثديين، وأنا طويلة

247
00:15:25,070 --> 00:15:26,230
...تقولين هذا الآن

248
00:15:26,230 --> 00:15:32,450
!أعلم هذا، لا يحق لي أن أقول هذا بعد أن ضحكت، لكن لا تضحك

249
00:15:32,450 --> 00:15:36,870
.على أي حال، لنذهب ونلقي نظرة على وكالات السفر اليوم

250
00:15:36,870 --> 00:15:38,660
ستذهب للوداع غدًا، صحيح؟

251
00:15:38,660 --> 00:15:39,710
.نعم

252
00:15:44,130 --> 00:15:46,000
.أرجو أن يكون الطقس جيدًا

253
00:15:50,010 --> 00:15:51,300
.أجل

254
00:15:52,930 --> 00:15:58,020
حسنًا، انتهينا من مهامنا، هل نقضي وقتًا ممتعًا؟

255
00:15:58,020 --> 00:15:59,640
.سنذهب إلى المنزل للعمل

256
00:15:59,640 --> 00:16:01,770
.أنتِ جادة للغاية

257
00:16:01,770 --> 00:16:04,560
...ستذهب للوداع غدًا

258
00:16:04,560 --> 00:16:08,570
.لذا يجب علينا أن نفعل ما نستطيع اليوم

259
00:16:08,570 --> 00:16:10,860
أحقًا لن تذهبي؟

260
00:16:10,860 --> 00:16:12,400
.لن أذهب

261
00:16:12,400 --> 00:16:18,950
.لا بأس، سأزورها متى ما أردت رؤيتها على أي حال

262
00:16:19,500 --> 00:16:23,920
بالمناسبة، هل سأكون مضطرًا إلى الذهاب معك؟

263
00:16:31,010 --> 00:16:33,090
.أنتِ أنانية

264
00:16:41,930 --> 00:16:43,140
.مرحبًا

265
00:16:43,140 --> 00:16:45,770
هل انتهيت من حزم حقائبك؟

266
00:16:45,770 --> 00:16:51,400
.نعم، يوجد طعام في المطبخ، كل إذا كنت ترغب

267
00:16:51,400 --> 00:16:52,530
.كيو

268
00:16:55,450 --> 00:17:00,620
أريد أن أتحدث إلى هوندا-سان على انفراد، هل أستطيع؟

269
00:17:02,660 --> 00:17:04,040
.غرفة المعيشة

270
00:17:06,330 --> 00:17:07,420
.اسمع

271
00:17:08,540 --> 00:17:11,550
.قم بعمل جيد أيها القط الغبي

272
00:17:14,800 --> 00:17:18,760
.لا أحتاج إلى نصيحتك أيها الفأر الغبي

273
00:17:28,190 --> 00:17:32,150
!يوكي-كن، أهلاً بعودتك

274
00:17:32,150 --> 00:17:33,570
.عدت

275
00:17:33,900 --> 00:17:36,820
.ستغادران غدًا إذن

276
00:17:36,820 --> 00:17:38,120
!نعم

277
00:17:39,490 --> 00:17:43,750
.لن أسمع "أهلاً بعودتك" منك بعد الآن

278
00:17:49,380 --> 00:17:51,130
...لكن

279
00:17:51,130 --> 00:17:54,380
.لكنني أشعر بالسعادة

280
00:17:56,590 --> 00:18:02,560
.أشعر بالوحدة، لكنني سعيد أيضًا لأنني وصلت إلى ما أنا عليه الآن

281
00:18:04,390 --> 00:18:08,940
...كنت ضعيفًا دائمًا

282
00:18:08,940 --> 00:18:16,030
.كنت لا أجيد التعامل مع الناس، لكنني أردت أن يحبني ويحتاجني الآخرون

283
00:18:16,030 --> 00:18:19,160
.كنت أتمنى هذا فحسب

284
00:18:19,160 --> 00:18:24,500
...ثم ظهرتِ أنتِ

285
00:18:24,500 --> 00:18:28,000
.وجعلت هذا الأمر يتحقق

286
00:18:29,170 --> 00:18:33,170
.علمتني بسخاء ما أردت تعلمه

287
00:18:34,460 --> 00:18:36,170
.منحتني إياه

288
00:18:38,130 --> 00:18:43,720
.وهذا ما مكنني من الوقوف هنا الآن

289
00:18:43,720 --> 00:18:48,060
.جعلتِ مني إنسانًا

290
00:18:48,060 --> 00:18:51,900
.ربيتني لأكون إنسانًا

291
00:18:53,980 --> 00:18:56,440
...كنتِ

292
00:18:58,200 --> 00:19:01,410
.كالأم بالنسبة لي

293
00:19:04,870 --> 00:19:09,120
!تمكنت أخيرًا من إخبارك بحقيقة مشاعري

294
00:19:10,710 --> 00:19:12,670
...هذا ليس رائعًا، لكن

295
00:19:12,670 --> 00:19:13,480
...هذا

296
00:19:12,940 --> 00:19:15,340
لكن أتعلمين؟

297
00:19:15,340 --> 00:19:19,470
.أعتقد أن هذا ينطبق على الجميع أيضًا

298
00:19:19,470 --> 00:19:25,470
.وجودك كان دافئًا ولطيفًا

299
00:19:25,470 --> 00:19:33,520
لذا وعلى الرغم من أننا سنعيش في بيئات جديدة من الآن فصاعدًا

300
00:19:33,520 --> 00:19:37,280
.لكن سنفكر فيك

301
00:19:38,570 --> 00:19:42,160
هل أنتِ على ما يرام"؟"

302
00:19:42,160 --> 00:19:45,620
"أنت لا تبكين، صحيح؟"

303
00:19:45,620 --> 00:19:49,330
"أما زلتِ تبتسمين؟"

304
00:19:49,330 --> 00:19:53,830
"هل أنتِ سعيدة اليوم؟"

305
00:19:55,090 --> 00:20:01,510
.سنواصل التفكير فيك بهذه الطريقة من الآن فصاعدًا

306
00:20:04,090 --> 00:20:08,350
.الجميع يحبك

307
00:20:14,400 --> 00:20:15,560
.شكرًا لك

308
00:20:16,570 --> 00:20:20,070
.أنا سعيد بلقائك

309
00:20:22,280 --> 00:20:25,780
.أنا سعيد لأنكِ كنتِ هنا

310
00:20:27,120 --> 00:20:30,790
.شكرًا لك

311
00:20:32,670 --> 00:20:35,330
...شكرًا لك

312
00:20:35,330 --> 00:20:36,590
.تورو

313
00:20:41,380 --> 00:20:45,140
.شكرًا لك، أنا ذاهبة

314
00:21:12,040 --> 00:21:13,370
ماذا؟

315
00:21:13,580 --> 00:21:16,710
!ماما

316
00:21:17,630 --> 00:21:19,750
أين تورو-كن و كيو-كن؟

317
00:21:19,750 --> 00:21:24,050
."يا فتاة! قولي "جدتي وجدي

318
00:21:26,090 --> 00:21:31,720
!لكن تورو-كن قالت إنه لا بأس بأن أناديها باسمها

319
00:21:31,720 --> 00:21:35,100
.الجدة والجد خرجا للتنزه

320
00:21:36,260 --> 00:21:38,730
!تركاني وحدي مجددًا

321
00:21:38,810 --> 00:21:43,070
.يجب ألا تزعجيهما في لحظات حبهما

322
00:21:43,070 --> 00:21:46,160
!أنا أحسدهما! إنهما متحابان دائمًا

323
00:21:48,740 --> 00:21:53,830
...معًا، يدًا بيد

324
00:21:55,500 --> 00:22:01,170
،نحظى بالكثير من اللحظات السعيدة والحزينة

325
00:22:01,170 --> 00:22:06,630
.ونتقدم في العمر على هذا النحو

326
00:22:20,210 --> 00:22:24,900
شكرًا لكم على طيب المتابعة

327
00:22:29,220 --> 00:22:33,580
الدرب الذي سلكناه

328
00:22:33,580 --> 00:22:37,410
ليس دربًا خاطئًا

329
00:22:37,410 --> 00:22:45,280
وآثار الأقدام التي تركناها بعد السير مسافة طويلة

330
00:22:46,670 --> 00:22:54,860
عندما ألتفت أرى أنكِ كنتِ تبتسمين إلى جواري

331
00:22:54,860 --> 00:23:03,000
دائمًا بابتسامتك اللطيفة

332
00:23:03,000 --> 00:23:07,380
عندما توقفت وفكرت

333
00:23:07,380 --> 00:23:11,770
وجدت أن الأيام التي قضيتها في هذا المكان

334
00:23:11,770 --> 00:23:16,160
تجعل قلبي أقوى

335
00:23:16,160 --> 00:23:21,290
كتلك الأيام

336
00:23:21,290 --> 00:23:25,670
أرجو أن تطير الأزهار إليك

337
00:23:25,670 --> 00:23:30,050
التي يحملها نسيم الربيع في الهواء

338
00:23:30,050 --> 00:23:34,350
وتبحث عنك كأشعة الشمس التي تتخلل الأشجار

339
00:23:34,350 --> 00:23:38,780
تُرى هل سأتمكن من رؤيتك مجددًا

340
00:23:38,780 --> 00:23:43,700
شكرًا لك ووداعًا