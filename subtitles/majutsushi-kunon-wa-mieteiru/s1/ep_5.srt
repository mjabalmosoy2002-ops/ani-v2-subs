1
00:00:14,370 --> 00:00:16,860
.اهدئي رجاءً يا ميريكا-ساما

2
00:00:19,910 --> 00:00:23,010
.هذا أول موعد لها خارج القلعة

3
00:00:23,010 --> 00:00:24,500
.لا ألومها

4
00:00:27,240 --> 00:00:29,320
.وصل غوريون-ساما

5
00:00:29,320 --> 00:00:30,580
.حسنًا

6
00:00:30,930 --> 00:00:31,880
.يا ميريكا-ساما

7
00:00:33,550 --> 00:00:35,210
نعم يا لورا؟

8
00:00:35,210 --> 00:00:37,140
لِم التظاهر؟

9
00:00:37,460 --> 00:00:39,890
...وصل كونون غوريون-ساما إلى

10
00:00:41,430 --> 00:00:42,980
!أيتها الأميرة

11
00:00:45,150 --> 00:00:46,270
.مساء الخير

12
00:00:47,110 --> 00:00:49,090
.القمر جميل الليلة

13
00:00:49,530 --> 00:00:52,240
.لا أستطيع رؤيته لكن آمل أنّي أصبت

14
00:00:52,240 --> 00:00:55,380
.بما أنه أول موعد ليليّ لنا

15
00:00:56,020 --> 00:00:57,600
!كونون

16
00:00:57,600 --> 00:01:02,250
،لعبتُ دور الأميرة في المدرسة
.لكنني سأكون مرافقك اليوم

17
00:01:03,400 --> 00:01:05,920
هل لي بيدك أيتها الأميرة؟

18
00:01:07,180 --> 00:01:07,920
.أجل

19
00:01:13,910 --> 00:01:17,650
.هذا هو كونون غوريون-ساما إذًا

20
00:02:51,300 --> 00:02:53,770
.أهلًا بك في مطعمي يا غوريون-ساما

21
00:02:56,510 --> 00:03:00,650
نخب اللون الأزرق الجميل
.الذي يزيّن عينيك وثوبك

22
00:03:03,030 --> 00:03:05,430
.وقار وسلوكٌ نبيلين

23
00:03:05,430 --> 00:03:08,660
.لا عجب أن الأميرة ميريكا أُغرمت به

24
00:03:09,000 --> 00:03:11,740
زرتَ البرج الأسود اليوم إذًا؟

25
00:03:11,740 --> 00:03:15,340
نعم. كانوا جميعًا مبهرين

26
00:03:15,340 --> 00:03:17,170
.فيما في ذلك أختك رايشا-ساما

27
00:03:17,530 --> 00:03:20,030
القوة السحرية لكبير السحرة
،الجبن الأزرق" على وجه الخصوص"

28
00:03:20,030 --> 00:03:22,550
.كانت كأناقتك الكاملة

29
00:03:22,550 --> 00:03:23,490
.عجبًا

30
00:03:23,490 --> 00:03:25,550
أهذا مجاز مناسب؟

31
00:03:25,850 --> 00:03:27,740
.نجحت في الاختبار

32
00:03:28,060 --> 00:03:31,560
،لم يخبروني من سيكون معلمي بعد

33
00:03:31,850 --> 00:03:35,060
،لكنني متأكد أنهم سيرتّبون ذلك بحكمة

34
00:03:35,060 --> 00:03:38,950
مثل أظافرك الحادّة ذات الشكل
.واللون الجميلين

35
00:03:41,090 --> 00:03:43,840
.سمعتُ العديد من القصص المثيرة

36
00:03:43,840 --> 00:03:45,640
،بالطبع قصصك

37
00:03:45,640 --> 00:03:50,020
التي تتلألأ كالتعاويذ الطاردة للطيور
،التي تؤرجحها الرياح على حقول القمح

38
00:03:50,020 --> 00:03:51,330
.هي أكثر إثارة

39
00:03:54,830 --> 00:03:58,340
!هذا اللحم منعش جدًا

40
00:03:58,580 --> 00:04:01,220
ماذا يعني باللحم المنعش؟

41
00:04:04,470 --> 00:04:09,470
،إنه غريب نوعًا ما
.لكن الأميرة ميريكا تبدو سعيدة

42
00:04:12,360 --> 00:04:13,230
.أيتها الأميرة

43
00:04:13,230 --> 00:04:14,250
نعم؟

44
00:04:14,730 --> 00:04:17,730
مثل هذا العشاء هو أقصى
.ما يسعني تقديمه حاليًا

45
00:04:20,860 --> 00:04:27,130
،لكن بعد زواجنا
.سنمضي وقتًا كهذا معًا كل يوم

46
00:04:28,670 --> 00:04:34,020
لا أطيق انتظار المستقبل
.الذي سنسير فيه معًا

47
00:04:34,020 --> 00:04:35,730
!أتراجع عمّا قلته

48
00:04:37,190 --> 00:04:40,710
.كونون غوريون... هو فتى مميّز

49
00:04:41,100 --> 00:04:41,970
!أنا أيضًا

50
00:04:55,210 --> 00:04:58,150
.عليك أن تخلدي للنوم أيتها الأميرة

51
00:05:06,860 --> 00:05:08,770
!كونون-ساما

52
00:05:10,790 --> 00:05:13,410
هلا تساعدني؟

53
00:05:15,390 --> 00:05:16,670
."أ-روبو"

54
00:05:21,640 --> 00:05:22,690
!هذا هو

55
00:05:22,690 --> 00:05:25,090
.إنه فعّال في إزالة الأوساخ

56
00:05:25,090 --> 00:05:27,990
.كنتُ أكتب تقريرًا

57
00:05:27,990 --> 00:05:29,810
.لا يصلح هذا يا كونون-ساما

58
00:05:29,810 --> 00:05:34,230
تحبس نفسك في غرفتك
.منذ عودتك من القلعة

59
00:05:34,230 --> 00:05:36,440
.أريد كتابة ذلك قبل أن أنساه

60
00:05:37,690 --> 00:05:40,160
الخروج وقضاء الوقت تحت أشعة الشمس

61
00:05:40,160 --> 00:05:44,090
.هو أحد أهم واجبات الأطفال
.قد يؤثر ذلك على نموّك

62
00:05:44,730 --> 00:05:48,970
تفضّل النساء الرجال طوال القامة إذًا؟

63
00:05:48,970 --> 00:05:51,410
.هذا صحيح، بالنسبة لبعضهنّ

64
00:05:51,690 --> 00:05:56,410
لكنني أحبك يا كونون-ساما
.سواء كنتَ طويلًا أو قصيرًا

65
00:05:56,410 --> 00:05:57,750
.شكرًا لك

66
00:05:57,750 --> 00:05:59,010
...أنا أيضًا

67
00:05:59,010 --> 00:06:02,670
،لا يجب أن أقول هذا
.بما أنّي لا أريد أن أسيئ للأميرة ميريكا

68
00:06:02,670 --> 00:06:04,440
!هذا غير منصف

69
00:06:04,440 --> 00:06:07,390
!أنت زير نساء بما أنك جعلتني أقول ذلك

70
00:06:15,420 --> 00:06:18,550
بالمناسبة، هل وصلتني رسالة؟

71
00:06:19,020 --> 00:06:20,090
.لا

72
00:06:20,510 --> 00:06:22,490
.لم يقرروا بعد إذًا

73
00:06:22,490 --> 00:06:23,570
ماذا سيقررون؟

74
00:06:24,520 --> 00:06:25,860
.معلمي

75
00:06:26,420 --> 00:06:28,660
!سينباي

76
00:06:28,660 --> 00:06:30,530
سينباي؟

77
00:06:32,860 --> 00:06:34,580
...أفضّل ألا أذهب

78
00:06:44,470 --> 00:06:46,590
.آمل أن أعود سالمًا

79
00:06:51,340 --> 00:06:52,850
زيون-سينباي؟

80
00:06:57,830 --> 00:06:59,620
!عجبًا

81
00:07:05,080 --> 00:07:10,150
.لا تجرؤ على مقاطعة وقت نومي الثمين يا فيكتو

82
00:07:10,150 --> 00:07:12,680
.لهذا لم أرغب في المجيء

83
00:07:12,680 --> 00:07:15,280
.لم أطلب منك أن تأتي

84
00:07:15,280 --> 00:07:17,160
!كبير المعلمين يستدعيك

85
00:07:18,530 --> 00:07:19,720
العجوز؟

86
00:07:20,900 --> 00:07:22,290
!أجل

87
00:07:22,290 --> 00:07:25,290
!تحدّد معلمي الجديد يا إكو

88
00:07:25,510 --> 00:07:26,770
.هذا ممتاز

89
00:07:26,770 --> 00:07:28,390
من يكون؟

90
00:07:28,390 --> 00:07:32,610
...زي-أو-ن-لي

91
00:07:32,950 --> 00:07:35,220
.زيونلي فينرول

92
00:07:36,250 --> 00:07:38,680
!الرجل الذي كان أخي وأمي يتحدثان عنه

93
00:07:38,680 --> 00:07:42,370
زيونلي-ساما الذي يُقال أنه ساحر
في غاية الوسامة؟

94
00:07:42,370 --> 00:07:43,460
أتعرفينه أيضًا؟

95
00:07:43,460 --> 00:07:44,610
!بالطبع

96
00:07:44,610 --> 00:07:47,320
!تعرفه كل نساء هيوغليا

97
00:07:47,320 --> 00:07:48,890
ما العمل؟

98
00:07:48,890 --> 00:07:52,420
!يجب أن أطلب زيّ خادمات جديد من والدك

99
00:07:52,420 --> 00:07:53,950
!عليّ وضع مساحيق تجميل

100
00:07:54,170 --> 00:07:56,100
ما العمل؟

101
00:07:54,170 --> 00:07:56,900
عرض جميلتي إكو أمام رجل آخر؟

102
00:07:56,900 --> 00:07:58,060
...ستقودني الغيرة للجنـ

103
00:07:58,060 --> 00:08:00,340
!أعتذر يا كونون-ساما، لا وقت لديّ لهذا الآن

104
00:08:00,340 --> 00:08:02,420
!عليّ تزيين أظافري

105
00:08:02,420 --> 00:08:03,930
!وتصفيف شعري أيضًا

106
00:08:03,930 --> 00:08:05,220
!وتخفيف وزني

107
00:08:07,050 --> 00:08:07,850
.حسنًا

108
00:08:16,420 --> 00:08:19,000
،أعتذر على طلبي المفاجئ

109
00:08:19,000 --> 00:08:21,980
لكن أعتقد أن لا داعي للاعتذار، صحيح؟

110
00:08:22,400 --> 00:08:24,520
.صحيح يا أختي الكبرى رايشا

111
00:08:26,750 --> 00:08:28,110
هذا غير ملائم، صحيح؟

112
00:08:28,390 --> 00:08:33,460
يحتاج الساحر الملكيّ إلى أمر مباشر
.من الملك للخروج من القلعة

113
00:08:33,460 --> 00:08:37,290
ستكون حراستي سببًا كافيًا، صحيح؟

114
00:08:37,290 --> 00:08:40,120
...نعم. لكن

115
00:08:40,120 --> 00:08:42,300
لماذا وقع الاختيار على ذلك الرجل؟

116
00:08:42,300 --> 00:08:46,180
!أردتُ أن أكون معلمة كونون أيضًا

117
00:08:47,910 --> 00:08:51,210
...أختي إفريل وأختي ليداليا

118
00:08:51,210 --> 00:08:53,380
ذكّريني من تكونين؟

119
00:08:53,790 --> 00:08:57,390
.سمعتُ أن لخطيبك سمعة لافتة

120
00:08:57,390 --> 00:08:59,630
.خطيبك فقط

121
00:08:59,950 --> 00:09:03,150
،نعم. إنه ساحر ممتاز

122
00:09:03,150 --> 00:09:06,440
.لكن لا علاقة لكما بذلك

123
00:09:08,270 --> 00:09:10,020
.تنحيا عن طريقي

124
00:09:13,480 --> 00:09:16,260
.لا تغتري بنفسك أيتها الأميرة الثانية

125
00:09:16,850 --> 00:09:19,660
.لقد وبّخكِ الفارس ثلاث مرات

126
00:09:19,660 --> 00:09:20,910
كيف...؟

127
00:09:25,310 --> 00:09:27,290
.لا تكثرتي لهما

128
00:09:27,290 --> 00:09:29,820
.حسنًا. شكرًا جزيلًا لك

129
00:09:30,140 --> 00:09:31,790
!يا إلهي

130
00:09:31,790 --> 00:09:35,050
لماذا وقع الاختيار على ذلك الرجل؟

131
00:09:46,150 --> 00:09:48,060
.أتساءل كيف هي طبيعة معلمي

132
00:09:57,990 --> 00:09:59,200
!كونون

133
00:09:59,810 --> 00:10:00,700
الأميرة؟

134
00:10:02,710 --> 00:10:04,160
هل فاجأتك؟

135
00:10:04,160 --> 00:10:09,360
.نعم. أستعدّ ذهنيًا في كل مرة قبل لقائك

136
00:10:09,360 --> 00:10:13,670
لذا عجزتُ عن الكلام من شدّة التوتر
بعد لقائك فجأة

137
00:10:13,670 --> 00:10:15,960
.بما أنك في غاية الجمال

138
00:10:16,250 --> 00:10:19,090
كضفدع وقع في مرمى نظر ثعبان؟

139
00:10:19,090 --> 00:10:23,220
،لكن بما أنّي أعمى
.فأنا لا أدري ما شعور أن يُحدّق بي بتلك الطريقة

140
00:10:24,180 --> 00:10:25,720
.هذا الشقيّ إذًا

141
00:10:26,450 --> 00:10:28,870
هل غيّرتِ عطرك؟

142
00:10:28,870 --> 00:10:31,480
.رائحته زكية ويوحي بالنضج

143
00:10:31,850 --> 00:10:35,600
يُقال لي أنّي ما زلت صغيرة على وضع العطر
.لذا أنا لا أضع أيّ عطر

144
00:10:35,600 --> 00:10:37,490
.لكنني غيّرت الصابون الذي أستخدمه

145
00:10:37,490 --> 00:10:38,780
.لا شكّ أنها رائحته

146
00:10:38,780 --> 00:10:41,510
،بها عبق الزهور لكنها توحي بالنضج

147
00:10:41,510 --> 00:10:45,490
.لذا أنا فراشة منجذبة لزهرة الآن

148
00:10:52,810 --> 00:10:54,760
...أنت زيونلي إذًا

149
00:10:59,050 --> 00:11:00,220
.مذهل

150
00:11:00,780 --> 00:11:02,850
.قوته السحرية كثيفة جدًا

151
00:11:03,540 --> 00:11:06,330
.ليست كثيفة فحسب، بل لزجة كذلك

152
00:11:06,910 --> 00:11:08,870
.إنها أشبه بالعسل

153
00:11:08,870 --> 00:11:11,850
قوة سحرية مختلفة تمامًا
."عن قوة كبير المعلمين "الجبن الأزرق

154
00:11:12,270 --> 00:11:15,300
هو أكثر تمكّنًا من السحر

155
00:11:15,300 --> 00:11:17,030
.من أيّ ساحر ملكي في القلعة

156
00:11:17,790 --> 00:11:21,150
كونون؟ هل كل شيء على ما يرام؟

157
00:11:21,660 --> 00:11:23,860
.أريد اتخاذه قدوة بصفته معلمي

158
00:11:26,660 --> 00:11:28,580
.أعتذر. سعيد بلقائك

159
00:11:28,580 --> 00:11:29,910
.أنا كونون غوريون

160
00:11:30,220 --> 00:11:32,740
،أعلم أن هذا مفاجئ
لكن هل أستطيع مناداتك المعلم "عسل"؟

161
00:11:32,740 --> 00:11:34,670
.كفاك هراءً

162
00:11:35,080 --> 00:11:36,880
بما أناديك إذًا؟

163
00:11:36,880 --> 00:11:38,570
.زيونلي-ساما

164
00:11:38,570 --> 00:11:39,880
."احرص على إضافة "ساما

165
00:11:40,310 --> 00:11:42,950
.أنصت. أنا أكره الأشقياء

166
00:11:42,950 --> 00:11:45,430
!إنه وقح! لكنه وسيم جدًا

167
00:11:45,850 --> 00:11:49,680
.ولم أقبل بعد تعليمك السحر

168
00:11:50,190 --> 00:11:52,370
.ليس كأنّي أردتُ المجيء إلى هنا

169
00:11:52,370 --> 00:11:55,350
.أنت هنا بسبب علاقات التسلسل الهرميّ الصارم

170
00:11:55,350 --> 00:11:57,440
هذه هي الحياة، صحيح؟

171
00:11:57,690 --> 00:12:02,580
أخبرني العجوز لونديموند أن هناك
.شقيًا مثيرًا للاهتمام يجب أن ألتقيه

172
00:12:02,580 --> 00:12:05,560
"أرسل كبير المعلمين "الجبن الأزرق
.المعلم "عسل" إليّ

173
00:12:05,560 --> 00:12:07,950
ما هذه الأسماء؟

174
00:12:08,170 --> 00:12:09,450
.عذرًا

175
00:12:09,910 --> 00:12:15,580
،أنا داريو سانز، فارس الفرقة الثالثة
.أتيتُ لحراسة الأميرة وزيون

176
00:12:15,580 --> 00:12:18,960
.شكرًا لك على كل ما فعلته ذلك اليوم

177
00:12:18,960 --> 00:12:20,780
أتعرفه؟

178
00:12:20,780 --> 00:12:23,700
،نعم. لا أعرفه شخصيًا

179
00:12:23,700 --> 00:12:27,530
لكنني عشتُ معه تجربة الضفدع
.الذي يحدّق به الثعبان ثلاث مرات

180
00:12:27,530 --> 00:12:29,600
.ذلك واجبي

181
00:12:30,020 --> 00:12:31,600
.يا له من طفل غريب

182
00:12:32,270 --> 00:12:36,860
بالمناسبة، زيونلي-ساما هو الساحر الوسيم، صحيح؟

183
00:12:36,860 --> 00:12:38,130
!هذا صحيح

184
00:12:38,130 --> 00:12:39,780
!إنه بهيّ الطلعة

185
00:12:39,780 --> 00:12:41,340
.هذا جليّ

186
00:12:41,340 --> 00:12:42,840
حقًا؟

187
00:12:42,840 --> 00:12:47,490
،بما أنّي أعمى فلا أستوعب روعة الأشخاص
.لكن لا شكّ أنك مذهل

188
00:12:47,800 --> 00:12:52,120
أنت تسخر منّي، أليس كذلك؟

189
00:12:52,360 --> 00:12:54,270
.لا، على الإطلاق

190
00:12:54,990 --> 00:12:56,590
.يا له من طفل غريب

191
00:13:00,890 --> 00:13:04,470
.أحضرتِ زيونلي-ساما إلى هنا من أجلي إذًا

192
00:13:04,470 --> 00:13:06,510
.شكرًا جزيلًا لك أيتها الأميرة

193
00:13:06,510 --> 00:13:10,260
.لا. أردتُ رؤيتك أيضًا

194
00:13:10,260 --> 00:13:13,680
.أردتُ رؤيتك أيضًا أيها الأميرة الجميلة

195
00:13:14,430 --> 00:13:15,870
.توقف

196
00:13:15,870 --> 00:13:17,190
.أنا موجود أيضًا

197
00:13:17,560 --> 00:13:21,690
.توقف عن المغازلة ولنخض حديثًا عن السحر

198
00:13:21,960 --> 00:13:22,690
!حاضر

199
00:13:24,280 --> 00:13:26,620
تُشير تعابيره إلى أنه يريد
.الاستمتاع بإغاضة الطفل

200
00:13:26,620 --> 00:13:28,650
!ويبدو هذا الوجه فاتنًا

201
00:13:29,030 --> 00:13:32,740
.لكنه سيُغيض سيدك

202
00:13:33,650 --> 00:13:35,610
أتعرف التعاويذ المركّبة؟

203
00:13:35,930 --> 00:13:39,580
تُلقى التعاويذ من دائرة سحرية
.مرسومة بالقوة السحرية

204
00:13:39,900 --> 00:13:44,230
تنشأ التعاويذ المركّبة بتقسيم
.الدوائر السحرية وإعادة ترتيبها

205
00:13:44,710 --> 00:13:46,220
كم قسمًا تستطيع التعامل معه؟

206
00:13:46,750 --> 00:13:49,340
.حوالي... 31 قسمًا

207
00:13:49,340 --> 00:13:50,100
ماذا؟

208
00:13:55,570 --> 00:13:57,220
.هذا ليس سيئًا

209
00:13:57,730 --> 00:14:00,310
.أستطيع التعامل مع 50 قسمًا

210
00:14:00,310 --> 00:14:02,380
‫50 قسمًا؟ هذا العدد الكبير؟

211
00:14:02,380 --> 00:14:03,480
كيف تقوم...؟

212
00:14:03,480 --> 00:14:07,740
،ما أريد معرفته هو
كيف تتجاوز عقبة الـ20 قسمًا؟

213
00:14:08,070 --> 00:14:09,990
.كدّستُ الرموز السحرية

214
00:14:10,260 --> 00:14:12,920
وتوصلتَ لذلك بنفسك؟

215
00:14:12,920 --> 00:14:15,970
.نعم. واستخدمتُ عدّة حيل بسيطة

216
00:14:16,410 --> 00:14:21,880
وصفها بالحيل البسيطة يعطي انطباعًا سيئًا
.على ما يبدو لذا أسميها تعديلات

217
00:14:22,300 --> 00:14:23,630
هل هو جاد؟

218
00:14:25,420 --> 00:14:27,540
لماذا أنت يا زيون-سينباي؟

219
00:14:27,540 --> 00:14:30,290
!أردتُ أن أكون معلمه أيضًا

220
00:14:30,760 --> 00:14:35,380
.لم تتكبّد عناء لقائه عندما أتى
!هذا غير منصف

221
00:14:35,380 --> 00:14:38,160
.ليس كأنّي ذاهب لأنّي أريد ذلك -

222
00:14:35,380 --> 00:14:39,130
!ليس منصفًا! أريده، أريده، أريده -

223
00:14:38,160 --> 00:14:40,470
.يقول العجوز أنه مثير للاهتمام -

224
00:14:40,470 --> 00:14:41,930
!ليس مثيرًا للاهتمام فحسب

225
00:14:41,930 --> 00:14:44,510
.من النادر رؤية طالب ممتاز مثله

226
00:14:44,510 --> 00:14:49,310
!ينطلق بسرعة! ثم يقفز ويقفز

227
00:14:49,310 --> 00:14:50,450
ماذا؟

228
00:14:51,020 --> 00:14:55,290
.أرى سبب رغبتهما الشديدة في تعليمه

229
00:14:55,580 --> 00:14:58,870
.يمتلك موهبة استثنائية

230
00:14:59,660 --> 00:15:03,040
.حسنًا، أرني ما تستطيع فعله

231
00:15:03,040 --> 00:15:05,490
!لكن علمني كيف أتعامل مع 50 قسمًا أولًا

232
00:15:05,490 --> 00:15:08,360
لا فائدة من تعليم ذلك لشخص
.لا يستطيع القيام به

233
00:15:08,360 --> 00:15:10,680
.لن أضيّع وقتي

234
00:15:11,070 --> 00:15:15,030
،برهن على قدراتك ثم اطلب التوجيه بعدل

235
00:15:15,030 --> 00:15:17,020
.بتملّقي

236
00:15:18,450 --> 00:15:21,270
.لن يفعل كونون ذلك

237
00:15:21,270 --> 00:15:24,990
.أنت رائع جدًا أيها المعلم زيونلي
.علّمني رجاءً

238
00:15:24,990 --> 00:15:27,650
.أودّ رؤية مدى روعتك

239
00:15:27,880 --> 00:15:29,150
...لقد فعل ذلك

240
00:15:29,150 --> 00:15:33,190
وأودّ رؤية كرمك وطيبتك ورقّتك

241
00:15:33,190 --> 00:15:37,060
!ووضعك المالي الذي تظهره بين الفينة والأخرى

242
00:15:37,060 --> 00:15:38,890
.لا أستطيع رؤية أيٍ من هذا

243
00:15:38,890 --> 00:15:42,200
لا مشكلة لديّ في تملّقك
!إن كان هذا يعني أنّي سأتعلّم التعامل مع 50 قسمًا

244
00:15:42,200 --> 00:15:43,670
!دعني أتملّقك

245
00:15:43,990 --> 00:15:48,020
،لديّ الكثير من الأمور لأقولها لك
.لكن أولًا، لا تنادني بالمعلم

246
00:15:48,020 --> 00:15:50,370
،لم أعترف بك بعد

247
00:15:50,370 --> 00:15:53,430
.وسأريك مدى روعتي

248
00:15:53,780 --> 00:15:56,680
.شعاري الأرضي ذو الثلاث نجوم

249
00:15:57,560 --> 00:15:58,770
!مذهل

250
00:16:00,200 --> 00:16:03,000
.حاول تدمير هذا الجدار بالسحر

251
00:16:03,000 --> 00:16:04,940
.وإلا انتهى أمرك

252
00:16:05,550 --> 00:16:07,690
بالسحر؟

253
00:16:10,810 --> 00:16:14,980
.وسمعتُ أن سريرك المائي يحظى بشعبية

254
00:16:14,980 --> 00:16:15,950
.أرني إيّاه

255
00:16:16,690 --> 00:16:19,200
."حاضر، "أ-أوري

256
00:16:25,720 --> 00:16:27,770
.سأراقب من هنا

257
00:16:27,770 --> 00:16:29,210
...ابذل جهدك

258
00:16:32,360 --> 00:16:34,950
ما هذه الليونة؟

259
00:16:35,470 --> 00:16:37,870
.كأنها كومة من ريش النعام

260
00:16:38,710 --> 00:16:40,470
.ليست الليونة فقط

261
00:16:40,470 --> 00:16:45,900
.إنه دافئ ورائحته طيّبة

262
00:16:46,390 --> 00:16:47,800
...هذا

263
00:16:51,470 --> 00:16:52,510
غطّ في النوم؟

264
00:16:52,510 --> 00:16:54,740
.إنه لا يُقاوم

265
00:17:00,120 --> 00:17:04,360
.إنه صلب، ومع ذلك ملمسه ناعم

266
00:17:05,290 --> 00:17:07,060
،يبدو بسيطًا من الوهلة الأولى

267
00:17:07,060 --> 00:17:10,370
.لكن كثافة القوة السحرية مذهلة

268
00:17:10,780 --> 00:17:14,260
.إنه قوي بما يكفي لتحمّل الصلابة مع مرور الوقت

269
00:17:15,400 --> 00:17:17,010
.السحر هو رمز

270
00:17:17,010 --> 00:17:19,270
.الرمز يعني دائرة سحرية

271
00:17:19,660 --> 00:17:24,670
يُنشئ المستخدم عدّة تعاويذ
،بإعادة ترتيب دوائر سحرية مختلفة

272
00:17:24,670 --> 00:17:28,940
.وتصبح الدائرة السحرية أساس كل تعويذة

273
00:17:29,770 --> 00:17:31,150
يُشير السحر المركّب

274
00:17:31,150 --> 00:17:35,330
إلى عدد مرات تقسيم
،الدائرة السحرية الأساسية وإعادة إنشائها

275
00:17:35,330 --> 00:17:37,280
.وذلك هو جوهر السحر

276
00:17:37,660 --> 00:17:43,450
.يُظهر هذا الرقم مستوى السحر والتعديلات

277
00:17:44,970 --> 00:17:48,550
إنها بلورة سحرٍ مركّب
.بها أكثر من 40 قسمًا

278
00:17:53,800 --> 00:17:55,140
.كونون

279
00:17:55,690 --> 00:17:58,060
.لندردش أيتها الأميرة

280
00:17:58,060 --> 00:17:58,910
ماذا؟

281
00:18:01,330 --> 00:18:02,670
هل أنت متأكد؟

282
00:18:02,670 --> 00:18:06,040
.نعم. لننتظر استيقاظ زيونلي-ساما

283
00:18:06,040 --> 00:18:07,400
.من الأفضل انتظاره

284
00:18:07,400 --> 00:18:08,570
...لكن

285
00:18:08,570 --> 00:18:11,470
.لا تقلقي، أستطيع تدميره في رمشة عين

286
00:18:22,820 --> 00:18:24,340
هل نمتَ جيدًا؟

287
00:18:24,650 --> 00:18:25,870
منذ متى وأنا نائم؟

288
00:18:26,390 --> 00:18:28,010
.حوالي ساعتين

289
00:18:28,010 --> 00:18:30,130
.كنتُ غارقًا في النوم

290
00:18:32,010 --> 00:18:35,380
.أيها الفتى. تبدو مرتاحًا

291
00:18:35,650 --> 00:18:37,000
هل استسلمت؟

292
00:18:37,000 --> 00:18:40,060
لا. هل أنت مستعد لتدميري الجدار؟

293
00:18:40,060 --> 00:18:44,140
.أجل، إن استطعت

294
00:18:45,590 --> 00:18:46,890
".أ-روبو"

295
00:18:52,730 --> 00:18:55,290
.هذا ما استخدمه في غسيل الثياب

296
00:18:57,880 --> 00:19:00,340
إنه جدار من تراب، ما يجعله هشًا جدًا

297
00:19:00,340 --> 00:19:02,790
.عند امتصاصه ماءً يفوق قدرته

298
00:19:03,170 --> 00:19:05,210
عرفتُ ذلك على الفور، لأن ملمسه

299
00:19:05,210 --> 00:19:07,390
كان مشابهًا للخبز الصلب

300
00:19:07,390 --> 00:19:09,160
.المصمّم لكسر الأسنان

301
00:19:09,160 --> 00:19:12,870
لقد أصبت إلى حد ما
.لكنك مخطئ في الغاية من الخبز الصلب

302
00:19:12,870 --> 00:19:15,130
لكن لماذا استخدمتَ "أ-روبو"؟

303
00:19:15,130 --> 00:19:18,420
اختصاصك هو "أ-أوري"، صحيح؟

304
00:19:18,420 --> 00:19:20,180
...لأنّي

305
00:19:23,860 --> 00:19:26,450
.اعتقدتَ أن هذا سيكون أسهل

306
00:19:27,060 --> 00:19:32,220
،بدل استخدام القوة
.رأيتَ أن الجدار من تراب وقررت إذابته

307
00:19:32,710 --> 00:19:33,720
.فهمت

308
00:19:34,250 --> 00:19:36,940
هناك تعاويذ متوافقة
.مع حالات وظواهر معيّنة

309
00:19:37,580 --> 00:19:41,100
.من واجب الساحر إدراك ذلك

310
00:19:41,100 --> 00:19:42,330
!لقد مدحتني

311
00:19:42,330 --> 00:19:44,200
أيعني هذا أنك ستتخذني تلميذًا؟

312
00:19:44,430 --> 00:19:45,990
!لا يحقّ لك اتخاذ هذا القرار

313
00:19:46,710 --> 00:19:51,800
،كونون غوريون. ابتداءً من اليوم
.صرتَ تلميذًا لزيونلي فينرول

314
00:19:52,340 --> 00:19:54,630
،أنت الطفل الأعظم حظًا في العالم

315
00:19:54,630 --> 00:19:57,710
.لأنّي سأصبح معلمك

316
00:19:58,890 --> 00:20:00,740
.هذا صحيح

317
00:20:00,740 --> 00:20:04,550
.عثرتُ على معلمي والأميرة ميريكا بجانبي

318
00:20:04,550 --> 00:20:07,160
،لو تمنيتُ أكثر من هذا
.سألقى عقابًا إلهيًا

319
00:20:07,160 --> 00:20:09,600
...كونون

320
00:20:09,600 --> 00:20:11,170
.توقف

321
00:20:11,170 --> 00:20:14,570
ليكن في علمك أن معلمك
.في مرتبة أعلى من خطيبتك

322
00:20:14,570 --> 00:20:15,310
ماذا؟

323
00:20:15,710 --> 00:20:19,150
،بما أنك صرت تلميذي
.فهناك العديد من الأمور لتفعلها

324
00:20:19,470 --> 00:20:23,450
،لديّ الكثير من الأمور لأعلمك إيّاها
.وستساعدني في تجاربي

325
00:20:23,450 --> 00:20:25,420
...لكن، مع ذلك

326
00:20:25,420 --> 00:20:28,450
ماذا ستفعلين أيتها الخطيبة؟

327
00:20:28,780 --> 00:20:29,540
ماذا؟

328
00:20:29,540 --> 00:20:31,630
.صار تلميذي الآن

329
00:20:31,630 --> 00:20:34,330
.سيتحسّن كثيرًا ويرتقي في العالم

330
00:20:34,980 --> 00:20:38,550
وقريبًا، ستحوم النساء من حوله
.وتقاتل من أجله

331
00:20:38,990 --> 00:20:43,090
أتفهمين قصدي أيتها الأميرة التاسعة؟

332
00:20:44,520 --> 00:20:46,340
.إنه محقّ

333
00:20:46,990 --> 00:20:51,850
لقد نضج كونون كثيرًا
،وصار تلميذًا لساحر ملكيّ

334
00:20:52,770 --> 00:20:57,380
.لكنني ما زلت أميرة متدنية المكانة

335
00:21:00,140 --> 00:21:05,590
،إن لم أقم بأمر ما
!فلن يكون هناك مستقبل يجمعنا

336
00:21:06,860 --> 00:21:10,070
.لا تعامل الأميرة بلؤم يا معلمي

337
00:21:10,070 --> 00:21:11,620
.كونون

338
00:21:11,910 --> 00:21:14,020
.بل أنا أشجعك

339
00:21:14,020 --> 00:21:18,110
تقول هذا، لكنك تحب إغاضة الفتيات، صحيح؟

340
00:21:18,750 --> 00:21:21,630
.وأنت من النوع الذي يدرك ذلك متأخرًا

341
00:21:22,630 --> 00:21:24,840
أنت من النوع الذي يعامل
الفتاة التي تروقه بلؤم

342
00:21:24,840 --> 00:21:27,000
.فتُسلب منك أمام عينيك

343
00:21:27,510 --> 00:21:32,020
أنت صعب المراس وتشعر بالإحراج
!لذا لا تستطيع معاملة الفتيات بلطف

344
00:21:33,020 --> 00:21:35,140
!يشعر بالإحراج لكنه رائع

345
00:21:35,720 --> 00:21:37,690
.أيها الشقيّ

346
00:21:37,690 --> 00:21:39,530
!"نعم أيها المعلم "عسل

347
00:21:39,530 --> 00:21:41,620
.لا تنادني بذلك

348
00:21:41,620 --> 00:21:42,650
!حاضر

349
00:21:49,330 --> 00:21:51,260
.عليّ القيام بأمر ما

350
00:21:51,860 --> 00:21:53,010
.يجب أن أتغيّر

351
00:23:35,890 --> 00:23:39,470
:الحلقة القادمة
".تدريب مذهل ونتائج مبهرة"