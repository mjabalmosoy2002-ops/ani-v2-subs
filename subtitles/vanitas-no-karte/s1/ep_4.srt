1
00:00:07,380 --> 00:00:10,010
نظريّة صياغة العالم"

2
00:00:10,010 --> 00:00:15,090
طُرِحت هذه النظريّة أوّل مرّة بواسطة
الخيميائي العظيم باراكلسوس

3
00:00:15,090 --> 00:00:18,220
تنصّ على وجود عالم خلف عالم الجنس البشريّ

4
00:00:18,220 --> 00:00:24,440
"حيث استُبدِل العالم الفاني بأكمله بصِيَغ"

5
00:00:25,850 --> 00:00:31,400
يعتقد باراكلسوس أنّه إذا استطاع المرء"
،تعديل الصِّيَغ الإنشائيّة

6
00:00:31,400 --> 00:00:33,700
فذلك سيُزيل كافّة الأمراض

7
00:00:33,700 --> 00:00:38,620
ويهدي الجنس البشريّ نحو السّعادة

8
00:00:38,620 --> 00:00:40,790
،غمسَ نفسه في عمله

9
00:00:40,790 --> 00:00:46,580
وسرعان ما قام بتجربة عبثتْ بصيغة العالم

10
00:00:46,580 --> 00:00:52,510
"لكن أدّت التجربة إلى حادثة تُعرَف بحادثة بابل

11
00:00:56,680 --> 00:01:00,760
أنزلت بابل كافّة أشكال الكوارث على الجنس البشريّ"

12
00:01:00,760 --> 00:01:04,930
وجلبت لهذا العالم أشياء لم تكن موجودة من قبل

13
00:01:04,930 --> 00:01:08,690
،زهور تتوهّج بنورها الخاصّ

14
00:01:08,690 --> 00:01:11,150
،ومعادن ذات بريق أزرق

15
00:01:11,150 --> 00:01:16,610
وظهور شبيهين بالإنسان ذوي عيون حمراء لأوّل مرّة

16
00:01:16,610 --> 00:01:21,530
نتجَ كلّ واحد منهم من خلال تعديل
صيغته الإنشائيّة الأصليّة

17
00:01:21,530 --> 00:01:24,540
بعد التّلاعب بصيغة العالم

18
00:01:29,960 --> 00:01:33,380
وقطارات بخاريّة، وإشارات مرور، واختراعات أخرى

19
00:01:33,380 --> 00:01:35,510
،مُزوّدة بالطاقة بواسطة أستيرمايت

20
00:01:35,510 --> 00:01:40,800
معدن صُنِع بتعديل الصّيغة الإنشائيّة للفحم

21
00:01:40,800 --> 00:01:42,430
ظهرَ مصّاصو الدّماء

22
00:01:42,430 --> 00:01:46,520
عندما سبّبت حادثةُ بابل تعديلَ الصّيغة الإنشائيّة للبشر

23
00:01:46,520 --> 00:01:49,230
"إنّهم أنواع جديدة كلّياً

24
00:01:49,230 --> 00:01:51,270
ونحن أيضاً يا مُعلّم؟

25
00:01:51,270 --> 00:01:53,400
هذا صحيح

26
00:01:55,740 --> 00:02:01,620
لكن أشكّ في أنّ عدداً قليلاً من الأطفال
البشر يعرفون حقيقة الأمر

27
00:02:01,620 --> 00:02:04,910
لكن يجب علينا ألّا ننسى أبداً

28
00:02:04,910 --> 00:02:08,620
يا معلّم، يبدو وكأنّك مُستمتع

29
00:02:08,620 --> 00:02:12,090
أجل، أنا كذلك. هذا مُمتع حقّاً

30
00:02:12,090 --> 00:02:16,670
وأنا متأكّد أنّه سيصبح أكثر متعة حتّى مع مضيّ الوقت

31
00:02:16,670 --> 00:02:20,390
،وكلّ هذا لأنّك رافقتني

32
00:02:20,390 --> 00:02:25,640
يا هرّي العزيز، مون تشاتون

33
00:02:31,560 --> 00:02:37,570
"دراسة حالة فانيتاس"

34
00:04:02,450 --> 00:04:04,950
أليست هذه العربة كبيرة زيادة عن اللّزوم؟

35
00:04:04,950 --> 00:04:07,660
قلتُ لك أنّنا سنذهب إلى حفل راقص

36
00:04:07,660 --> 00:04:11,330
أنت لا تنوي الذّهاب بهذا اللّباس، أليس كذلك؟

37
00:04:11,330 --> 00:04:15,130
من فضلكِ أزيلي هذه الياقة إن كنتِ
ستبدّلين ملابسكِ

38
00:04:15,130 --> 00:04:17,960
سأذهب وأنتظر مع فانيتاس

39
00:04:20,800 --> 00:04:24,470
دومي، هل أنتِ مستاءة من شيء؟

40
00:04:25,430 --> 00:04:29,350
هل كان إحضار فانيتاس معنا فكرة سيّئة؟

41
00:04:29,350 --> 00:04:32,020
ارتأيتُ أنّه ينبغي أن يرافقنا

42
00:04:32,020 --> 00:04:36,060
إذا أردنا معرفة المزيد عن حاملي اللّعنة

43
00:04:36,060 --> 00:04:39,360
لكن عجزتُ عن فهم الأمور من منظوركِ

44
00:04:39,360 --> 00:04:41,690
سامحيني يا دومي

45
00:04:44,860 --> 00:04:47,660
أنا قلقة فحسب

46
00:04:47,660 --> 00:04:49,740
كانت دعوة جدّي

47
00:04:49,740 --> 00:04:53,830
هي ما قادتك للتّحالف مع حامل الكتاب

48
00:04:55,040 --> 00:04:59,500
لكن ماذا عن تورّطك مع حاملي اللّعنة؟

49
00:05:01,170 --> 00:05:08,220
أظنّك أقنعت نفسك بأنّ ما حدث آنذاك كان غلطتك

50
00:05:11,810 --> 00:05:16,440
دومي، رائحتكِ طيّبة

51
00:05:17,980 --> 00:05:21,820
لم تعطِ تلميحاً كهذا منذ زمن طويل

52
00:05:25,650 --> 00:05:29,990
لكن هذا لن ينفع. يجب أن تخبرني عمّا تريده

53
00:05:29,990 --> 00:05:33,790
حسناً يا نوي؟ هل تريد أن تمتصّ دمائي؟

54
00:05:39,080 --> 00:05:43,250
أجل يا دومي. أريد أن أمتصّ دماءك

55
00:05:43,250 --> 00:05:44,920
حسناً

56
00:05:44,920 --> 00:05:48,260
...دمي كلّه لك

57
00:05:48,260 --> 00:05:50,600
يا حبيبي...

58
00:06:34,390 --> 00:06:37,640
ما الأمر؟ ألا تشعر بحال جيّدة؟

59
00:06:37,640 --> 00:06:39,440
لا

60
00:06:41,810 --> 00:06:44,860
...أقنعة... مُهرِّجو بلاط

61
00:06:44,860 --> 00:06:48,320
لا يسعني سوى تذكّر ما رأيتُه

62
00:06:49,530 --> 00:06:52,370
زهرة لكِ

63
00:06:52,370 --> 00:06:53,740
!شكراً لك

64
00:06:53,740 --> 00:06:55,410
!أمّي، انظري، انظري

65
00:06:55,410 --> 00:06:57,410
أليست رائعة يا كاترين؟

66
00:06:57,410 --> 00:06:59,790
!أنتِ محظوظة جداً يا أختي

67
00:07:02,830 --> 00:07:05,050
!ماذا تظنّ أنّك تفعل؟

68
00:07:05,050 --> 00:07:10,050
أنا؟ ماذا عن مُداعبتك بينما كنتُ
في الخارج أمام الباب؟

69
00:07:10,050 --> 00:07:13,220
مُداعبة؟ عمّاذا تتكلّم؟

70
00:07:13,220 --> 00:07:15,680
دومي صديقة عزيمة

71
00:07:15,680 --> 00:07:20,100
.لا تقل كلاماً ناتج عن سوء تفسير
قد يسبّب المشاكل لها

72
00:07:20,100 --> 00:07:24,690
منظوركم للصداقة أنتم مصّاصو الدّماء غريب

73
00:07:24,690 --> 00:07:28,570
تتحدّث عن ذلك التّبادل البسيط الّذي
قمنا به قبل قليل

74
00:07:28,570 --> 00:07:33,990
لم تكن المرّة الأولى التي يمتصّ فيها
نوي دمي فقط لأنّه كان مُتعطّشاً

75
00:07:33,990 --> 00:07:37,240
يُرغَم الأرشيفيست على رؤية ذكريات الشخص

76
00:07:37,240 --> 00:07:39,620
الّذي يمتصّ دمه لأوّل مرّة

77
00:07:39,620 --> 00:07:44,000
لكن لا يحبّذ نوي استراق النّظر إلى
ذكريات شخص آخر دون موافقته

78
00:07:44,000 --> 00:07:45,750
--لهذا السّبب

79
00:07:45,750 --> 00:07:47,170
إلى أين ذهب نوي؟

80
00:07:47,170 --> 00:07:50,550
يبدو أنّه ما كان ينبغي أن تزيلي ياقته

81
00:07:52,300 --> 00:07:55,760
لا يهمّ. ادخل

82
00:08:00,230 --> 00:08:05,770
لمعلوماتك، قد تبكي وتصرخ، لكن
سيذهب كلّ ذلك سُدى

83
00:08:05,770 --> 00:08:09,110
لم أتوقّع إيجاد أوتوماتون هنا

84
00:08:09,110 --> 00:08:13,700
كنتُ قد سمعتُ بأنّ مصّاصي الدّماء
يكروه التكنولوجيا البشريّة عموماً

85
00:08:13,700 --> 00:08:16,830
--دومي، من المُضيف اللّيلة

86
00:08:18,740 --> 00:08:22,500
!غادرا؟ يا لهما من مُزعجين

87
00:08:22,500 --> 00:08:25,710
لم يصل عمّي بعد؟

88
00:08:25,710 --> 00:08:28,090
لم يرد أيّ نبأ عنه؟

89
00:08:28,090 --> 00:08:30,050
أاجل

90
00:08:30,050 --> 00:08:32,720
آمل ألّا يكون قد وقع مكروه

91
00:08:32,720 --> 00:08:36,930
من باب الحيطة، أبلغوا الماركيز ماكينا عن عمّي

92
00:08:36,930 --> 00:08:39,760
سأستمرّ في البحث عنها

93
00:08:43,560 --> 00:08:47,020
!ماذا تفعل هنا؟! لا تقل لي بأنّك لحقت بنا؟

94
00:08:47,020 --> 00:08:49,440
...لا! أنا

95
00:08:49,440 --> 00:08:52,240
فخامتك لوكيوس، من هذا الشّخص؟

96
00:08:52,240 --> 00:08:53,650
لوكيوس؟

97
00:08:53,650 --> 00:08:55,820
...إنّه

98
00:08:55,820 --> 00:08:57,820
!إنّه صديق لي

99
00:08:57,820 --> 00:08:58,490
!تعال معي

100
00:08:58,490 --> 00:08:59,370
!ماذا؟

101
00:08:59,370 --> 00:09:03,160
ثمّة مسألة هامّة يجب أن نتحدّث
!عنها! تـ-تعال من هنا

102
00:09:10,250 --> 00:09:15,510
لـ-لستُ أفهم. لـ-لماذا الآن؟

103
00:09:19,470 --> 00:09:21,510
أجبني أيّها البشريّ

104
00:09:21,510 --> 00:09:25,390
لماذا نوي؟ ما هي نواياك؟

105
00:09:25,390 --> 00:09:26,940
...لا أدري

106
00:09:26,940 --> 00:09:31,730
لن أمنع نوي من العمل معك

107
00:09:31,730 --> 00:09:36,490
بل وسأعرض حتّى المساعدة ضمن
إمكانيّاتي إذا ما أراد ذلك

108
00:09:36,490 --> 00:09:42,620
...لكن إذا كنت تحاول استغلال قوّته لصالحك

109
00:09:49,540 --> 00:09:53,510
أتقولين "صديقان"؟ لا تُثيريني على الضّحك

110
00:09:53,510 --> 00:09:58,760
الرّجال لا يستمعون لنساء أمثالكِ إلّا
عندما يكون الأمر ملائماً لهم

111
00:10:03,060 --> 00:10:09,600
لا أنكر وجود مصّاص دماء القمر الأزرق

112
00:10:09,600 --> 00:10:11,440
،إذا كان نوي يؤمن بذلك

113
00:10:11,440 --> 00:10:15,280
فسأمضي بافتراض أنّ قوّتك

114
00:10:15,280 --> 00:10:17,950
وقوّة كتاب فانيتاس حقيقيّان

115
00:10:17,950 --> 00:10:22,870
،لكن لا أفهم لماذا أنت، حامل قوّة القمر الأزرق

116
00:10:22,870 --> 00:10:27,290
تظلّ تثرثر حول إنقاذ مصّاصي دماء القمر القرمزيّ

117
00:10:27,290 --> 00:10:30,040
يصعب تصديق ذلك

118
00:10:30,040 --> 00:10:33,800
ينبغي لفانيتاس أن يُخفي حقداً دفيناً ضدّنا

119
00:10:33,800 --> 00:10:38,840
هل يمكنك أن تقسم بأنّك لستَ قاتلاً
مُغتالاً أُرسِلَ بواسطته؟

120
00:10:38,840 --> 00:10:43,220
ألا تثبت حقيقة أنّك تبنّيتَ اسم فانيتاس

121
00:10:43,220 --> 00:10:47,560
بأنّك تعبد مصّاص دماء القمر الأزرق؟

122
00:10:51,230 --> 00:10:52,980
أعبد؟

123
00:10:52,980 --> 00:10:56,570
مصّاص دماء القمر الأزرق؟

124
00:11:03,950 --> 00:11:07,410
فهمت. معكِ حقّ في هذه النقطة

125
00:11:07,410 --> 00:11:10,120
كلّ مصّاصي الدّماء الّذين التقيتُهم إلى الآن

126
00:11:10,120 --> 00:11:15,710
لم يفكّروا سوى باحتماليّة أن يكون
كتاب فانيتاس حقيقيّاً من عدمها

127
00:11:15,710 --> 00:11:17,840
جميعكم حمقى

128
00:11:19,510 --> 00:11:24,390
لكن الآن قد فهمت. كنتُ أقوم بالأمر بشكل عكسيّ

129
00:11:24,390 --> 00:11:31,520
كان ينبغي أن أبدأ بحفر وجودي عينه في عقولكم

130
00:11:47,120 --> 00:11:50,000
!اسمعوني الآن يا مصّاصو الدّماء

131
00:11:50,000 --> 00:11:51,870
اسمي فانيتاس

132
00:11:51,870 --> 00:11:53,250
الكتاب واسمي قد وُرِّثا لي بواسطة -
مصّاص دماء القمر الأزرق

133
00:11:53,250 --> 00:11:55,380
ما هذا؟ -
الكتاب واسمي قد وُرِّثا لي بواسطة -
مصّاص دماء القمر الأزرق

134
00:11:55,380 --> 00:11:56,540
هل هذا استعراض ما؟ -
الكتاب واسمي قد وُرِّثا لي بواسطة -
مصّاص دماء القمر الأزرق

135
00:11:56,540 --> 00:11:57,920
هل هذا استعراض ما؟ -
!مع ذلك لستُ سوى مجرّد بشريّ -

136
00:11:57,920 --> 00:11:59,960
!ماذا يفعل بالتحديد؟

137
00:11:59,960 --> 00:12:03,890
أوّلاً، سوف أثبت لكم هنا والآن

138
00:12:03,890 --> 00:12:08,260
بأنّني أُعَدُّ من عشيرة القمر الأزرق

139
00:12:08,260 --> 00:12:09,770
...وهذا الّذي هنا

140
00:12:09,770 --> 00:12:12,020
يُثبت ادّعائي...

141
00:12:13,100 --> 00:12:14,730
!يحمل العلامة

142
00:12:14,730 --> 00:12:20,570
أنا على يقين بأنّ الجميع هنا يعرفون
من كان الّذي شكّلَ هذه العلامة

143
00:12:21,900 --> 00:12:24,240
يجب أن تشعروا بالفطرة

144
00:12:24,240 --> 00:12:28,030
بنوع القوّة التي مُنِحت لي

145
00:12:28,030 --> 00:12:32,500
!اذبحوه! قطِّعوا أوصاله

146
00:12:40,050 --> 00:12:43,880
متّعوا أنظاركم. هذا هو كتاب فانيتاس

147
00:12:43,880 --> 00:12:46,850
،يمتلك قوّة إفساد أسمائكم الحقيقيّة بأريحيّة

148
00:12:46,850 --> 00:12:50,060
ليُغرقكم في يأس أسوأ من الموت

149
00:12:50,060 --> 00:12:52,810
إنّه الكتاب السحريّ الملعون

150
00:12:52,810 --> 00:12:57,150
!لكن أطمئنكم، لا شيء يدعو للخوف

151
00:12:57,150 --> 00:13:00,110
بالفعل، فأنتم محظوظون جدّاً

152
00:13:00,110 --> 00:13:04,150
،فأنا، فانيتاس من عشيرة القمر الأزرق

153
00:13:04,150 --> 00:13:09,080
!لن أستخدم كتاب فانيتاس لإبادتكم، بل لإنقاذكم

154
00:13:09,080 --> 00:13:11,490
هل تسمعونني؟

155
00:13:11,490 --> 00:13:17,880
ليس عليكم سوى أن ترتجفوا إذلالاً
!بينما يتمّ إنقاذكم على يدي

156
00:13:17,880 --> 00:13:21,300
،شئتم أم أبيتم

157
00:13:21,300 --> 00:13:24,220
!سأنقذكم يا مصّاصو الدّماء

158
00:13:24,220 --> 00:13:25,550
هذا العمل بحدّ ذاته

159
00:13:25,550 --> 00:13:27,510
سيكون نهجي المُطلَق

160
00:13:27,510 --> 00:13:31,390
!للثأر من فانيتاس

161
00:13:36,060 --> 00:13:39,520
سوف أنقذ مصّاصي الدّماء

162
00:13:39,520 --> 00:13:41,570
الآن قد فهمت

163
00:13:41,570 --> 00:13:44,440
...لهذا أنت

164
00:13:47,820 --> 00:13:49,870
فانيتاس

165
00:13:56,540 --> 00:13:58,170
!هذا مُختصر الأمر

166
00:13:58,170 --> 00:14:03,710
،إن كان أيّ شخص بينكم حاملاً للعنة
!فعليه ألّا يتردّد بالمجيء إليّ

167
00:14:06,050 --> 00:14:12,010
أنا، فانيتاس، طبيب ومختصّ بمصّاصي
!الدّماء، سأنقذكم دونما فشل

168
00:14:12,010 --> 00:14:13,430
!كفّ عن هذا

169
00:14:13,430 --> 00:14:14,310
!اقتلوه فحسب

170
00:14:14,850 --> 00:14:17,560
!عشيرة القمر الأزرق سوف تنقذنا؟

171
00:14:17,560 --> 00:14:21,270
مصّاص دماء القمر الأزرق هو السّبب
!الرئيسيّ وراء حاملي اللّعنة

172
00:14:21,270 --> 00:14:22,940
!اقتلوا هذا البشريّ

173
00:14:22,940 --> 00:14:24,190
!مخلوق كريه

174
00:14:24,190 --> 00:14:26,400
!ماذا يعتقد نفسه يفعل؟

175
00:14:26,400 --> 00:14:27,450
لا أملك فكرة

176
00:14:27,450 --> 00:14:29,990
!لمَ يفتعل ضجيجاً هنا بالتحديد؟

177
00:14:29,990 --> 00:14:31,660
لا أملك فكرة

178
00:14:35,620 --> 00:14:40,040
يا عجبي! هذا كلّ ما تدور حوله الجلبة إذاً

179
00:14:41,330 --> 00:14:45,260
ما الّذي جاء بإنسان فانٍ إلى هنا؟

180
00:14:45,260 --> 00:14:50,050
رائحته نتنة. أخشى أن يسقط أنفي
من رائحته البشريّة الكريهة

181
00:14:50,050 --> 00:14:52,390
!يا للهول! هل هذه أختي فيرونيكا؟

182
00:14:52,390 --> 00:14:55,180
!قالت أنّها لن تأتي

183
00:14:55,180 --> 00:14:59,350
لنستأصل القذارة بلا تأخّر

184
00:15:10,240 --> 00:15:11,160
!أين هو؟

185
00:15:11,160 --> 00:15:13,700
!اختفى البشريّ

186
00:15:16,540 --> 00:15:21,830
اختطفَ أحدهم ذلك البشريّ في رمشة عين

187
00:15:21,830 --> 00:15:24,170
أمسى هذا مثيراً للاهتمام

188
00:15:24,170 --> 00:15:27,710
حسناً أيّها الطيّبون! سوف نصطاد الفاني

189
00:15:27,710 --> 00:15:29,260
،مثلما فعلَ أسلافنا

190
00:15:29,260 --> 00:15:35,060
لنبحث عن الوحش القذر ونقتله، فكلّ
!من على شاكلته هو مصدر تعاسة جنسنا

191
00:15:37,470 --> 00:15:44,110
ألم تكن جان من حملت فانيتاس بعيداً؟

192
00:15:44,110 --> 00:15:46,020
ماذا؟ أ-أجل

193
00:15:46,020 --> 00:15:49,570
ما الّذي يدفعها لمساعدته؟

194
00:15:49,570 --> 00:15:55,870
أخبرتُها بأنّني تمنّيتُ رؤيتكما مرّة أخرى

195
00:15:55,870 --> 00:16:00,000
هلّا عفوت عن فظاظتي في ذلك اليوم يا سيّد نوي؟

196
00:16:00,000 --> 00:16:01,920
...في ذلك اليوم

197
00:16:04,080 --> 00:16:08,920
لم أكن أفكّر بشكل سليم. خرجتُ عن السّيطرة

198
00:16:08,920 --> 00:16:11,930
قلّة نضجي لا تسبّب لي سوى الخزيّ

199
00:16:13,640 --> 00:16:16,970
من فضلك يا لوكا. يكفي أن تناديني نوي

200
00:16:17,970 --> 00:16:21,020
لنشارك في البحث عن فانيتاس

201
00:16:21,020 --> 00:16:26,230
فأنت وأنا لا نريد أن يموت فانيتاس هنا في هذا اليوم

202
00:16:26,230 --> 00:16:27,860
!حسناً

203
00:16:30,650 --> 00:16:33,320
!شياطين محظوظة! أولئك الشّياطين المحظوظة

204
00:16:33,320 --> 00:16:36,160
!يبدو هذا مُسلّياً

205
00:16:40,830 --> 00:16:42,620
هذا لا يُصدّق

206
00:16:42,620 --> 00:16:47,130
لم أتوقّع أن يأتي اليوم الّذي تحملني
فيه امرأة وتأخذني بعيداً

207
00:16:47,130 --> 00:16:50,630
--بالفعل، هذا أكثر حدث غير مُتوقّـ

208
00:16:52,170 --> 00:16:57,550
لم أتوقّع أن نلتقي ثانية بهذه السّرعة يا جان

209
00:17:05,940 --> 00:17:07,860
جان؟

210
00:17:10,610 --> 00:17:11,690
أغنية؟

211
00:17:11,690 --> 00:17:15,530
ما هذا النّشاز؟

212
00:17:20,620 --> 00:17:22,790
!حاملو لعنة؟

213
00:17:29,840 --> 00:17:31,340
ما هذا؟

214
00:17:31,340 --> 00:17:34,920
العديد من حاملي اللّعنة هنا فجأة؟

215
00:17:39,430 --> 00:17:43,930
هل يُعقَل أن يكون صوت حاملي اللّعنة وراء هذا؟

216
00:17:44,810 --> 00:17:47,310
هذا مأزق بحقّ

217
00:17:47,310 --> 00:17:48,560
!أختي؟

218
00:17:48,560 --> 00:17:50,070
!كاترين؟

219
00:17:57,530 --> 00:17:59,620
!فخامتك لوكيوس

220
00:17:59,620 --> 00:18:02,660
طمأنتَني، لم تتعرّض لأذى

221
00:18:10,380 --> 00:18:14,170
فخامتك لوكا

222
00:18:14,170 --> 00:18:17,180
لديكِ دافع امتصاص دماء

223
00:18:17,180 --> 00:18:21,260
جان، هل أنتِ حاملة لعنة؟

224
00:18:26,430 --> 00:18:29,270
!من أنتم أيّها الأشرار؟

225
00:18:29,270 --> 00:18:30,810
!نوي

226
00:18:30,810 --> 00:18:33,190
!تراجع من فضلك

227
00:18:40,160 --> 00:18:42,160
...أنا

228
00:18:42,160 --> 00:18:45,250
حسناً، لا يهمّ في الحالتين

229
00:18:51,420 --> 00:18:53,840
ينبغي أن تمتصّي دمي

230
00:18:53,840 --> 00:18:55,550
ماذا؟

231
00:19:01,510 --> 00:19:04,720
أقدّم لكِ دمائي

232
00:19:04,720 --> 00:19:09,850
أنت تمزح بالتأكيد. من ذا الّذي يريد
دماء بشريّ مثلك؟

233
00:19:09,850 --> 00:19:12,900
تتأمّلين إنقاذ الفتى، أليس كذلك؟

234
00:19:14,320 --> 00:19:18,070
لا وقت للتحيُّر

235
00:19:18,070 --> 00:19:22,370
...رائحة الدّماء الحلوة

236
00:19:22,370 --> 00:19:26,370
ماذا أصابك؟

237
00:19:26,370 --> 00:19:31,710
قد تُلقيك أنيابي حتفك

238
00:19:31,710 --> 00:19:34,000
لماذا تفعل هذا؟

239
00:19:36,420 --> 00:19:39,300
لا أعلم

240
00:19:39,300 --> 00:19:44,050
في هذه اللّحظة، أعتقد لا أبالي لما يحدث

241
00:19:44,050 --> 00:19:47,060
لا، لحظة. ربّما أنا مخطئ

242
00:20:00,740 --> 00:20:02,910
أنا مفتون

243
00:20:02,910 --> 00:20:07,990
كيف سيكون الشّعور إذا امتصصتِ دمائي؟

244
00:20:07,990 --> 00:20:14,630
هذا صحيح. بعد وضع جميع الحقائق
بعين الاعتبار، وقعتُ في حبّكِ

245
00:20:14,630 --> 00:20:17,800
حسناً إذاً يا جان

246
00:20:17,800 --> 00:20:22,800
لـ-لا، ليس دمك

247
00:20:22,800 --> 00:20:26,010
تفضّلي يا جان

248
00:21:36,080 --> 00:21:39,170
الآن قد فهمت

249
00:21:39,170 --> 00:21:44,920
هذا ليس... سيّئاً

250
00:21:44,920 --> 00:21:46,970
سأسألك مرّة أخرى

251
00:21:46,970 --> 00:21:50,680
من أنتم أيّها الأشرار؟

252
00:21:50,680 --> 00:21:53,390
تشارلاتان

253
00:21:55,690 --> 00:22:02,480
هذا صحيح. نُعرَف باسم تشارلاتان

254
00:22:06,820 --> 00:22:11,080
"ليلة الأقنعة السّاخرة"

255
00:23:42,790 --> 00:23:46,000
"أصدقاء"