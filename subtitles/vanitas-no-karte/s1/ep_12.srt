1
00:00:07,630 --> 00:00:11,050
ماذا؟ تريدين العودة لأجل قبّعتكِ ومظلّتكِ؟

2
00:00:11,050 --> 00:00:15,890
اختارتهما الآنسة دومينيك خصّيصاً لي

3
00:00:17,140 --> 00:00:19,100
لا، لا تكوني حمقاء

4
00:00:19,100 --> 00:00:23,600
في أسوأ السّيناريوهات، تمّ استدعاء صيّادي الكنيسة

5
00:00:25,440 --> 00:00:28,270
...آنسة دومينيك

6
00:00:28,270 --> 00:00:30,570
هيّا بنا. سأرافقكِ إلى الحاجز

7
00:00:30,570 --> 00:00:31,990
ماذا؟

8
00:00:34,450 --> 00:00:39,660
ربّما نويتِ البقاء معي حتّى الصّباح؟

9
00:00:39,660 --> 00:00:44,580
!لا! لا يمكنني المغادرة من دون تحقيق هدفي الأصليّ

10
00:00:44,580 --> 00:00:47,130
هدفكِ الأصليّ؟

11
00:00:47,130 --> 00:00:50,840
تقصدين لتحديد فيما إذا كان حبّكِ لي صادقاً؟

12
00:00:50,840 --> 00:00:52,800
أُنجِزت المهمّة، أليس كذلك؟

13
00:00:52,800 --> 00:00:54,340
!مُحال، ولا بأحلامك

14
00:00:54,340 --> 00:00:57,760
!فعلتُ كلّ هذا وذلك كي لا أراك ثانية

15
00:00:57,760 --> 00:01:00,390
!عملتُ جاهدة لتحقيق ذلك

16
00:01:00,390 --> 00:01:03,140
تكبّدتُ إهانة لا تُحتمَل

17
00:01:03,140 --> 00:01:07,020
--فقط لأدّعي بأنّني واقعة في حبّـ

18
00:01:07,020 --> 00:01:09,020
بئساً

19
00:01:14,690 --> 00:01:19,530
أجل، وجدتُ هذا الجانب فيك ظريفاً جدّاً اليوم

20
00:01:21,280 --> 00:01:25,080
عرفتُ أنّ هذا ما أعجبني فيكِ

21
00:01:30,380 --> 00:01:35,880
مع ذلك، أنا متفاجئ من أنّ لوكا سمح
لكِ بالمجيء لرؤيتي بمفردكِ

22
00:01:35,880 --> 00:01:37,550
هل أنتِ متأكّدة من سلامة ذلك؟

23
00:01:38,800 --> 00:01:42,060
لم تخبريه؟

24
00:01:42,060 --> 00:01:46,060
مولايّ لوكا مع أخيه الأكبر

25
00:01:46,060 --> 00:01:48,190
أخو الدّوق العظيم

26
00:01:48,190 --> 00:01:53,020
تقصد أنياب الملكة لوكي

27
00:01:53,020 --> 00:01:56,610
لهذا طُلِب منّي أن آخذ إجازة

28
00:01:56,610 --> 00:01:59,110
وتلقّيتُ الإذن بالمجيء لرؤيتك

29
00:01:59,110 --> 00:02:01,740
إذن؟ مِمّن؟

30
00:02:02,910 --> 00:02:05,330
السيّد روثفين؟

31
00:02:07,250 --> 00:02:10,500
أجل. كيف...؟

32
00:02:17,880 --> 00:02:19,760
!فانيتاس؟

33
00:02:26,060 --> 00:02:27,680
!نوي

34
00:02:29,520 --> 00:02:33,110
ما الأمر يا فانيتاس؟

35
00:02:42,530 --> 00:02:48,580
"دراسة حالة فانيتاس"

36
00:04:30,430 --> 00:04:32,480
أقسِم لي

37
00:04:34,230 --> 00:04:38,060
،أنّ في الوقت الّذي أشاء

38
00:04:38,060 --> 00:04:42,490
سوف تطيع أمري مهما كان هذا الأمر

39
00:04:42,490 --> 00:04:44,110
أقسِم بذلك

40
00:04:45,610 --> 00:04:47,660
!أقسِم بذلك

41
00:04:54,620 --> 00:04:58,630
...أقسِم أنّ

42
00:04:58,630 --> 00:05:03,260
،في الوقت الّذي تشاء

43
00:05:03,260 --> 00:05:10,350
سوف أطيع أمرك مهما كان هذا الأمر

44
00:05:10,350 --> 00:05:13,220
أُقسِم بذلك

45
00:05:13,220 --> 00:05:15,190
ممتاز

46
00:05:25,150 --> 00:05:28,490
ماذا؟ لماذا لم تقتله؟

47
00:05:28,490 --> 00:05:30,660
غيّرتُ رأيي

48
00:05:30,660 --> 00:05:32,740
عديم الشّكل يهمّني

49
00:05:32,740 --> 00:05:38,540
يجب أن نكتشف لماذا يُبقي ذلك الوحشُ
أرشافيست قريباً في متناول اليد

50
00:05:38,540 --> 00:05:42,630
إلى ذلك الحين، قد يكون من الأكثر
حكمة استخدام الفتى كبيدق

51
00:05:45,170 --> 00:05:47,260
إنّه ليس سوى مجرّد طفل

52
00:05:47,260 --> 00:05:50,350
سوف نقتله متى شئنا

53
00:05:51,510 --> 00:05:55,140
أعلّق آمالاً كبيرة عليك يا فتايّ

54
00:05:55,140 --> 00:05:59,850
عندما يحين الوقت، لا تنسَ قسَمك

55
00:06:05,820 --> 00:06:07,450
!خيّم الظّلام في الخارج

56
00:06:07,450 --> 00:06:10,570
!هل نمتُ كلّ هذه المدّة الطويلة؟

57
00:06:12,530 --> 00:06:16,540
فانيتاس، لماذا تلتقط أنفاسك بصعوبة؟

58
00:06:17,750 --> 00:06:20,290
ماذا؟ هل تعرّضت لجروح؟

59
00:06:20,290 --> 00:06:22,090
انسَ ذلك

60
00:06:23,500 --> 00:06:27,590
لماذا هرعَ فانيتاس هكذا؟

61
00:06:27,590 --> 00:06:31,260
،إن لم يعُد الآن

62
00:06:31,260 --> 00:06:33,890
فأظنّني أستطيع المغادرة

63
00:06:33,890 --> 00:06:35,470
جان

64
00:06:38,100 --> 00:06:41,190
المعلّم روثفين، ماذا تفعل هنا؟

65
00:06:41,190 --> 00:06:45,030
كانت هناك مسألة لا تحتمل مُعالجتها التأجيل

66
00:06:45,030 --> 00:06:48,490
لدى سماعي بتسبّب مصّاص دماء
،بفوضى في مونماري

67
00:06:48,490 --> 00:06:51,200
ارتأيتُ أن آتي لإلقاء نظرة

68
00:06:51,200 --> 00:06:53,950
كان ذلك من صنيعكِ يا جان؟

69
00:06:53,950 --> 00:06:55,990
!أ-أرجوك، سامحني

70
00:06:55,990 --> 00:07:00,210
!أقسم بأنّني لم أؤذِ أيّ بشريّ

71
00:07:00,210 --> 00:07:04,090
،في الواقع، عضضتُ هذا البشريّ

72
00:07:04,090 --> 00:07:07,550
!لكن كان ذلك بالتّراضي! حصلتُ على موافقته

73
00:07:07,550 --> 00:07:10,180
إذاً لن تكون هناك مشكلة

74
00:07:14,600 --> 00:07:16,510
كم تبدين جميلة

75
00:07:16,510 --> 00:07:23,150
لا شكّ أنّ أيريك ولوي كانا ليتمنّيان
رؤيتكِ بهذا الشّكل

76
00:07:24,150 --> 00:07:26,230
مُعلّم

77
00:07:30,320 --> 00:07:34,700
يشتدّ البرد اللّيلة. تعالي الآن يا جان. لنذهب إلى المنزل

78
00:07:37,450 --> 00:07:39,120
وبعد؟ هل كانا هناك؟

79
00:07:39,120 --> 00:07:41,460
لا، لا أثر لهما

80
00:07:41,460 --> 00:07:43,580
ما رأيكِ بإلغاء البحث؟

81
00:07:43,580 --> 00:07:47,300
هربا دون أن يتركا أثراً

82
00:07:47,300 --> 00:07:51,720
رغم ذلك، من الواضح أنّ جان كانت تتصرّف بغرابة

83
00:07:51,720 --> 00:07:54,510
سأستمرّ في البحث قليلاً

84
00:08:02,140 --> 00:08:04,310
!رولاند

85
00:08:04,310 --> 00:08:08,110
تحيّاتي يا أوليفيير! لا أصدّق بأنّك وجدتني

86
00:08:09,360 --> 00:08:12,570
سمعتُ أنّك كنتَ تتسلّل في الأرجاء بحثاً عن شيء

87
00:08:12,570 --> 00:08:14,700
أتسلّل في الأرجاء؟ هذا ليس لبِقاً

88
00:08:14,700 --> 00:08:18,620
أنمّي معرفتي بتاريخي ببساطة

89
00:08:18,620 --> 00:08:19,740
تاريخ؟

90
00:08:19,740 --> 00:08:21,120
هذا صحيح

91
00:08:21,120 --> 00:08:24,460
بعبارة أدقّ، تاريخ البشر ومصّاصي الدّماء

92
00:08:25,580 --> 00:08:28,040
لا داعي للغضب

93
00:08:28,040 --> 00:08:31,010
لم أمسّ أيّ من المُجلّدات المُحرّمة

94
00:08:31,010 --> 00:08:34,880
لماذا تفعل هذا الآن؟

95
00:08:34,880 --> 00:08:39,310
ارتأيتُ بأنّني قد أجد شيئاً مختلفاً عمّا سبق

96
00:08:41,020 --> 00:08:46,310
لطالما اعتبرتُ مصّاصي الدّماء شرّاً مُطلَقاً

97
00:08:46,310 --> 00:08:51,900
ولم ينتابني أيّ شكوك حول ذلك، وليست
لديّ أي أساسات للتشكيك في الأمر

98
00:08:51,900 --> 00:08:54,360
!لكن تعلّمتُ بأنّ ذلك غير صحيح

99
00:08:54,360 --> 00:08:56,160
!تفتّحت عينايّ

100
00:08:57,570 --> 00:09:00,450
لا يوجد سبب يدعو للقلق

101
00:09:00,450 --> 00:09:07,380
شخص شديد الإيمان كالقائد رولاند
مُحال أن يضرّ بالكنيسة

102
00:09:07,380 --> 00:09:09,750
أنت لا تفهم الأمر يا جورجي

103
00:09:09,750 --> 00:09:14,470
بصريح العبارة، ليس الإله مَن يُؤمن به

104
00:09:14,470 --> 00:09:18,470
بل يؤمن بنفسه بكونه أحد المُخلصين للربّ

105
00:09:22,930 --> 00:09:25,350
!اسمعني يا رولاند

106
00:09:25,350 --> 00:09:30,150
!أنت صيّاد كنيسة، صيّاد مصّاصي دماء باسم ربّنا

107
00:09:30,150 --> 00:09:34,190
إذا سَمِعَ رؤساؤنا أقوالك هذه، سيعتبرونك خطيراً

108
00:09:34,190 --> 00:09:39,660
!وفي أسوأ الحالات، قد يتضرّر والداك وأشقّاؤك

109
00:09:46,830 --> 00:09:49,330
أخبرني يا أوليفيير

110
00:09:49,330 --> 00:09:53,460
كم بالادين أستطيع أن أقاتل بمفردي برأيك؟

111
00:09:53,460 --> 00:09:54,510
ماذا؟

112
00:09:54,510 --> 00:09:56,340
ثلاثة؟ أربعة؟

113
00:09:56,340 --> 00:09:59,180
وربّما أكثر حتّى إذا أردتُ المُجازفة؟

114
00:09:59,180 --> 00:10:00,600
!ما هذا الهراء؟

115
00:10:00,600 --> 00:10:02,180
...لكن

116
00:10:02,180 --> 00:10:06,270
أتخيّل بأنّني سأواجه صعوبة إذا قاتلتُك

117
00:10:09,850 --> 00:10:13,650
بعد كلّ ذلك، لديه الجرأة ليهدّدني؟

118
00:10:15,320 --> 00:10:17,740
أتفهم يا أوليفيير؟

119
00:10:17,740 --> 00:10:20,370
تعرف طبيعتي كرجل

120
00:10:22,280 --> 00:10:27,580
لا أؤمن إلّا بما أعتقد بأنّه صحيح

121
00:10:31,080 --> 00:10:32,880
اللّعنة

122
00:10:35,170 --> 00:10:36,550
ما هذا؟

123
00:10:36,550 --> 00:10:37,380
!أيّها الدجّال

124
00:10:37,380 --> 00:10:38,590
دانتي

125
00:10:38,590 --> 00:10:40,680
دومينيك ليست معك؟

126
00:10:40,680 --> 00:10:41,890
ماذا؟ دومي؟

127
00:10:41,890 --> 00:10:44,600
تبّاً. عرفتُ بأنّك كشفتَ أمرنا

128
00:10:44,600 --> 00:10:47,890
أيّ شخص لم يلحظ ذلك عليه أن يفحص عقله

129
00:10:47,890 --> 00:10:50,230
لن أجادلك

130
00:10:50,230 --> 00:10:54,400
!لكن انسَ ذلك الآن أيّها الدجّال
!وردت بعض المعلومات الفّظيعة للتو

131
00:10:54,400 --> 00:10:56,440
!الوحش حيّ

132
00:10:56,440 --> 00:10:58,650
وحش جيفودان

133
00:10:58,650 --> 00:11:02,030
!قد كشّر عن أنيابه

134
00:11:02,030 --> 00:11:06,160
جيفو... ماذا؟

135
00:11:06,160 --> 00:11:08,080
هذا مثير للاهتمام

136
00:11:09,160 --> 00:11:12,130
تطرّق للتفاصيل يا دانتي

137
00:11:14,670 --> 00:11:19,550
قيل بأنّه يشبه ذئباً عملاقاً

138
00:11:19,550 --> 00:11:22,510
فمه الكبير مُشوّه وأذناه مُدبّبتان

139
00:11:22,510 --> 00:11:26,560
لديه مخالب حادّة ويملأ جسده فراء أحمر

140
00:11:26,560 --> 00:11:31,900
وشرائط سوداء عديدة على ظهره

141
00:11:31,900 --> 00:11:34,940
منطِقتا أوفرن وجيفودان

142
00:11:34,940 --> 00:11:40,360
كانتا المكان الّذي مُزِّقت فيه 100 امرأة وطفل بوحشيّة

143
00:11:42,910 --> 00:11:47,700
المعروف بوحش جيفودان الّذي أدخلَ
الرّعب إلى قلوب النّاس

144
00:11:54,290 --> 00:11:59,510
حتّى الآن، تُروى نظريّات كثيرة حول
أصل الوحش وماهيّته

145
00:11:59,510 --> 00:12:03,890
لكن آنذاك، اتّفقت الكنيسة ومصّاصو
الدّماء على شيء واحد

146
00:12:05,100 --> 00:12:10,350
وهو أنّ وحش جيفودان ليس إلّا مصّاص دماء حامل للّعنة

147
00:12:16,270 --> 00:12:20,030
وما قصّة وحش جيفودان الّذي يكشّر عن أنيابه إذاً؟

148
00:12:20,030 --> 00:12:24,030
هل هو حقّاً نفس الوحش القاتل
في القرن الثّامن عشر؟

149
00:12:24,030 --> 00:12:27,280
بصراحة، لا أستطيع الجزم بعد

150
00:12:27,280 --> 00:12:31,250
لكن تمّ العثور على خمس جثث في هذا الشّهر

151
00:12:31,250 --> 00:12:36,210
واختلفتْ أشكال القتل. فمنهم مَن التُهِمَت
أحشاؤهم أو بُتِرَتْ رؤوسهم

152
00:12:36,210 --> 00:12:39,380
كما في القرن الثّامن عشر؟

153
00:12:39,380 --> 00:12:43,680
أجل، وحتّى أنّ هناك شهود عيان يدّعون
بأنّهم رأوا الوحش بأمّ عينهم

154
00:12:43,680 --> 00:12:46,510
حسناً؟ ما العمل يا دجّال؟

155
00:12:48,560 --> 00:12:53,140
سأذهب لأتحقّق بنفسي ما إن كان حامل لعنة حقّاً

156
00:12:54,560 --> 00:12:58,150
ماذا ستفعل يا نوي؟

157
00:12:58,150 --> 00:13:01,820
من؟ أنا؟

158
00:13:01,820 --> 00:13:04,110
دعني أفكّر

159
00:13:04,110 --> 00:13:08,280
...أنا... في الواقع

160
00:13:08,280 --> 00:13:12,750
أعتقد يبدو هذا لذيذاً حقّاً

161
00:13:14,960 --> 00:13:18,170
لذيذ؟ لا تقصد الوحش، صحيح؟

162
00:13:18,170 --> 00:13:22,170
لم أتوقّع قولك هذا

163
00:13:22,170 --> 00:13:27,840
لا تقلْ لي بأنّ لديك نوع عجيب من الهوَس بالطعام

164
00:13:27,840 --> 00:13:30,720
هذا سيّئ، سيّئ حقّاً

165
00:13:30,720 --> 00:13:35,390
رائحة دماء فانيتاس زكيّة. لا أستطيع
التّركيز على المحادثة

166
00:13:35,390 --> 00:13:40,860
هذا غير منطقيّ. أعرف سلفاً
كم هو شهيّ وطيّب

167
00:13:40,860 --> 00:13:43,740
لماذا يراودني هذا الشّعور؟

168
00:13:43,740 --> 00:13:45,110
!أتضوّر جوعاً

169
00:13:45,110 --> 00:13:47,740
نمتُ طوال اليوم بعيداً

170
00:13:47,740 --> 00:13:50,280
!معنى هذا بأنّني لم آكل شيئاً

171
00:13:50,280 --> 00:13:53,160
!ما يعني بأنّني أتضوّر جوعاً

172
00:13:53,160 --> 00:13:55,250
!أجل، لا بدّ أنّ هذا هو السّبب

173
00:13:55,250 --> 00:13:58,750
!عندما أكون جائعاً، أعطش دوماً أيضاً

174
00:13:58,750 --> 00:14:02,590
لذا لأنّني أسهبتُ في النّوم. أشعر بالخمول حقّاً

175
00:14:07,130 --> 00:14:11,550
اللّعنة. يبدو وكأنّ حاسّة شمّي تزداد قوّة فحسب

176
00:14:11,550 --> 00:14:15,180
رائحة دمه مُغرية لأبعد الحدود. يجب أن أتذوّق

177
00:14:15,180 --> 00:14:18,230
لا، لحظة! ينبغي أن أحصل على
بعض الخبز أو ما شابه أوّلاً

178
00:14:18,230 --> 00:14:19,270
أريد دماً

179
00:14:19,270 --> 00:14:23,690
أعلم، لكنّنا وسط محادثة مهمّة

180
00:14:23,690 --> 00:14:28,860
لحظة. هل من المناسب مصّ دم
بشريّ محكوم عليه بالموت؟

181
00:14:28,860 --> 00:14:30,320
رائحتها حلوة جدّاً

182
00:14:30,320 --> 00:14:34,830
يكفيني أن أتذوّق. سيدعني أحاول بالتأكيد

183
00:14:34,830 --> 00:14:35,950
ما خطبه؟

184
00:14:35,950 --> 00:14:38,120
لا أدري

185
00:14:38,120 --> 00:14:43,550
هذا أشبه بالمرّة التي امتصصتُ فيه دم
ذلك الطفل القرويّ من باب التسلية فقط

186
00:14:44,920 --> 00:14:47,420
أصغِ جيّداً يا مون تشاتون

187
00:14:47,420 --> 00:14:53,050
لديك قوّة رؤية ذكريات النّاس بواسطة امتصاص دمائهم

188
00:14:53,050 --> 00:14:57,350
معنى هذا أنّ عليك أن تكون حذراً
أكثر من بقيّة مصّاصي الدّماء

189
00:14:57,350 --> 00:14:58,940
...إذاً

190
00:14:58,940 --> 00:15:03,650
بصيغة أخرى، يقصد بأنّ امتصاص الدّماء
هو شكل من أشكال التّواصل

191
00:15:03,650 --> 00:15:05,900
،لذا إذا تعطّشت لدماء أحد

192
00:15:05,900 --> 00:15:09,450
يجب أن تقنعه بالسّماح لك بفعل ذلك

193
00:15:10,530 --> 00:15:12,570
!أقنعه؟

194
00:15:12,570 --> 00:15:15,790
!ماذا؟ كيف يُفترض بي أن أفعل ذلك؟

195
00:15:19,120 --> 00:15:20,250
--نوي، ما الّذي أصابـ

196
00:15:20,250 --> 00:15:25,710
فانيتاس! لدى دمك رائحة إلهيّة لا يتخيّلها أحد

197
00:15:25,710 --> 00:15:29,920
بالمقارنة بسلوكك وشخصيّتك الّتي لا تُطاق

198
00:15:29,920 --> 00:15:32,180
ماذا؟ هل تبحث عن شِجار؟

199
00:15:32,180 --> 00:15:34,430
!هذا إطراء

200
00:15:35,810 --> 00:15:38,100
،لذا، بعبارة أخرى

201
00:15:38,100 --> 00:15:40,810
...ما أحاول قوله هو

202
00:15:40,810 --> 00:15:42,810
--فانيتاس! أريد أن أتذوّق

203
00:15:42,810 --> 00:15:44,360
!أرشيفيست

204
00:15:46,650 --> 00:15:49,690
سأقولها لمرّة واحدة فقط، لذا أصغِ جيّداً

205
00:15:52,450 --> 00:15:58,580
إذا حاولت أن تمتصّ دمي وبالتالي
،اقتحمت ذكرياتي

206
00:15:58,580 --> 00:16:00,120
فسوف أقتلك

207
00:16:01,120 --> 00:16:03,170
هل هذا واضح؟

208
00:16:06,880 --> 00:16:08,840
أجل

209
00:16:08,840 --> 00:16:11,970
سامحني من فضلك

210
00:16:36,700 --> 00:16:39,290
أخفقتُ في ذلك

211
00:16:42,790 --> 00:16:44,750
أسأتَ الفهم

212
00:16:44,750 --> 00:16:49,340
لم أرد اقتحام ذكرياتك

213
00:16:52,340 --> 00:16:56,340
رغم ذلك، هل ذلك صحيح حقّاً؟

214
00:17:00,020 --> 00:17:02,390
ربّما أكون مخطئاً

215
00:17:07,310 --> 00:17:09,230
...أنا

216
00:18:20,010 --> 00:18:21,930
توقّف عن ذلك فحسب

217
00:18:21,930 --> 00:18:23,720
أنت تُوتّرني

218
00:18:23,720 --> 00:18:26,980
!إذا كنت ممتعضاً منّي، فتكلّم

219
00:18:28,230 --> 00:18:31,480
لا، الأمر ليس كذلك

220
00:18:31,480 --> 00:18:36,530
أردتُ القول بأنّ ما حدث في الأمس
لم يكن غلطتي

221
00:18:37,570 --> 00:18:44,040
لأصدقك القول، يريد جزء منّي أن يلومك

222
00:18:44,040 --> 00:18:46,790
على بعث رائحة حلوة للغاية أمام مصّاص دماء

223
00:18:46,790 --> 00:18:47,660
!أنت

224
00:18:47,660 --> 00:18:51,790
لكن إذا توجّب عليّ القول، لا أجزم
بأنّ امتصاص دمك

225
00:18:51,790 --> 00:18:56,720
لم يكن ذريعة نشأت عن رغبة للحصول
على لمحة من ماضيك

226
00:18:58,840 --> 00:19:02,220
لمَ يهمّك النّظر في ماضيّي؟

227
00:19:02,220 --> 00:19:05,770
ما الّذي تكسبه من ذلك؟

228
00:19:05,770 --> 00:19:10,850
،لا أعرف ما الّذي أكسبه أو لن أكسبه
،لكن قلتُ لك ذات مرّة

229
00:19:10,850 --> 00:19:14,520
"أراك فاتناً"

230
00:19:18,780 --> 00:19:23,370
هل القوّة الأرشيفيستيّة الّتي فيك تتيح
،لك رؤية الذّكريات في دماء الآخرين

231
00:19:23,370 --> 00:19:25,790
مهما كان المصدر؟

232
00:19:25,790 --> 00:19:29,750
لا، هذا أشبه بامتصاص طاقة الحياة

233
00:19:29,750 --> 00:19:36,550
يجب امتصاص الدّماء من العروق إذا
أردت التعمّق في ذكريات الشّخص

234
00:19:38,420 --> 00:19:45,100
مع المصادر الأخرى، فقد أرى أجزاء
من المشاعر في حالات نادرة

235
00:19:45,100 --> 00:19:46,680
هكذا إذاً

236
00:19:46,680 --> 00:19:52,480
في هذه الحالة، في المرّة المقبلة التي أكون
فيها جريحاً، يمكنك لعق الدّماء من ملابسي

237
00:19:52,480 --> 00:19:54,610
لكن هذا عرض لمرّة واحدة فقط

238
00:19:54,610 --> 00:19:56,440
!ماذا؟! حقّاً؟

239
00:19:56,440 --> 00:19:57,280
أمزح فحسب

240
00:19:57,280 --> 00:19:59,190
!ماذا؟

241
00:20:09,040 --> 00:20:12,290
حسناً، هيّا بنا يا نوي

242
00:20:14,250 --> 00:20:15,920
!حسناً

243
00:20:23,300 --> 00:20:26,300
سنستقلّ هذا إلى جيفودان

244
00:20:27,310 --> 00:20:28,770
!هذا؟

245
00:20:37,440 --> 00:20:38,860
المعذرة

246
00:20:38,860 --> 00:20:40,150
لا داعي

247
00:20:40,150 --> 00:20:44,910
كانت غلطتي تماماً يا سيّد

248
00:20:44,910 --> 00:20:46,700
نوي، هنا

249
00:20:48,080 --> 00:20:50,790
!انتظرني يا فانيتاس

250
00:20:54,620 --> 00:20:57,000
أ-أنا نعسان للغاية

251
00:20:57,000 --> 00:20:59,630
ألم ترمش لك عين؟

252
00:20:59,630 --> 00:21:07,050
كنتُ متأكّداً بأنّن ستعادر وتتركني في غفلة منّي

253
00:21:07,050 --> 00:21:12,560
الطريق أمامنا طويل. حريّ بك أن تنام ما دمتَ تستطيع

254
00:21:12,560 --> 00:21:16,520
...إذا نمتُ

255
00:21:16,520 --> 00:21:21,030
فلن تتركني؟...

256
00:21:21,030 --> 00:21:24,070
سأوقظك عندما نصل إلى هناك

257
00:21:24,070 --> 00:21:25,680
نَم لبعض الوقت الآن

258
00:21:24,780 --> 00:21:27,030
"نقطة المغادرة"

259
00:23:25,570 --> 00:23:29,030
أخيراً، حان الوقت

260
00:23:29,030 --> 00:23:31,870
،هنا في جيفودان

261
00:23:31,870 --> 00:23:36,410
سأدع أغنية الثأر خاصّتي تصدح
في كلّ أرجاء البلاد

262
00:23:42,880 --> 00:23:45,960
"...يتبع"