1
00:00:36,010 --> 00:00:39,930
لماذا... لماذا لا أستطيع قتلك؟

2
00:00:39,930 --> 00:00:42,100
!لماذا؟

3
00:00:43,260 --> 00:00:45,850
لماذا؟

4
00:00:55,650 --> 00:00:57,440
اللّعنة

5
00:00:57,440 --> 00:00:59,570
!اللّعنة

6
00:01:03,240 --> 00:01:07,120
أنا آسف يا فانيتاس

7
00:01:10,330 --> 00:01:12,540
سامحني

8
00:01:16,210 --> 00:01:20,050
"أُمنيته"

9
00:01:35,690 --> 00:01:39,150
!فانيتاس! تمالك نفسك

10
00:01:39,150 --> 00:01:41,570
لستُ أفهم

11
00:01:41,570 --> 00:01:43,280
!لماذا؟

12
00:01:43,280 --> 00:01:45,280
!لمَ لا تستطيع قتله؟

13
00:01:45,280 --> 00:01:50,290
!حاولَ امتصاص دم! كان بمقدورك قتله

14
00:01:50,290 --> 00:01:53,960
!فلماذا لم تفعل؟! أنا الوحيد الّذي تحتاجه

15
00:01:53,960 --> 00:01:57,300
!من يأبه إذا مات؟

16
00:01:57,300 --> 00:01:58,880
...أنت

17
00:01:58,880 --> 00:02:05,350
حاولتَ دفعي لامتصاصِ دم فانيتاس كي يقتلني؟

18
00:02:05,350 --> 00:02:09,600
ليتَ يلتمّ شملي مع أبي وأخي الكبير فقط

19
00:02:09,600 --> 00:02:13,060
!هذا كلّ ما أردتُه

20
00:02:13,060 --> 00:02:16,730
لكنّك لن تفعل ما طلبتُه يا نوي

21
00:02:16,730 --> 00:02:20,190
لذا يجب أن تموت الآنسة دومي

22
00:02:32,160 --> 00:02:33,460
دعيني

23
00:02:33,460 --> 00:02:34,330
لا

24
00:02:34,330 --> 00:02:40,460
لكن قال ميشا بأنّ عليّ القفز. يجب أن أموت

25
00:02:40,460 --> 00:02:42,090
لا

26
00:02:42,090 --> 00:02:46,300
لماذا؟ وافقتِ، أليس كذلك؟

27
00:02:46,300 --> 00:02:48,010
--سيكون نوي أفضل من دون

28
00:02:48,010 --> 00:02:50,890
!قلتُ لكِ "لا" سلفاً

29
00:02:50,890 --> 00:02:54,690
أ... أكره نفسي

30
00:02:54,690 --> 00:02:58,980
!أنا متردّدة ومثيرة للشفقة. أكره نفسي حقّاً

31
00:02:58,980 --> 00:03:02,990
رغم ذلك، رسمتُ خطّاً أحمر واحداً فقط

32
00:03:02,990 --> 00:03:06,490
لن أسامح أيّ شخص يؤذي نوي

33
00:03:06,490 --> 00:03:11,790
،إذا كان قتل نفسي يُغضِب نوي

34
00:03:11,790 --> 00:03:15,750
فلن أسمح بحدوث ذلك أبداً

35
00:03:15,750 --> 00:03:19,960
لـ-لكن، أخبرني ميشا بأنّني يجب أن أقفز

36
00:03:19,960 --> 00:03:23,880
يجب أن أفعل ما يُملى عليّ

37
00:03:25,470 --> 00:03:27,390
لا بدّ أنّكِ أدركتِ ذلك الآن

38
00:03:27,390 --> 00:03:32,060
"إنّها أنتِ، أو على الأقلّ نفسكِ "الحقيقيّة
التي لطالما حاولتِ تجاهلها

39
00:03:32,060 --> 00:03:32,680
لا جدوى -

40
00:03:32,680 --> 00:03:33,480
أنا آسفة -
لا جدوى -

41
00:03:33,480 --> 00:03:33,930
أنا آسفة -
قطعتُ وعداً -

42
00:03:33,930 --> 00:03:34,560
جان -
قطعتُ وعداً -

43
00:03:34,560 --> 00:03:35,230
جان -
أكرهها -

44
00:03:35,230 --> 00:03:37,060
لا تكرهي نوي -
أكرهها -

45
00:03:37,060 --> 00:03:37,440
لا -

46
00:03:37,440 --> 00:03:37,940
أنا خائفة -
لا -

47
00:03:37,940 --> 00:03:38,520
أنا خائفة -
لماذا؟ -

48
00:03:38,520 --> 00:03:38,940
لوي، أنا آسفة -
لماذا؟ -

49
00:03:38,940 --> 00:03:40,230
لوي، أنا آسفة -
...أنا -

50
00:03:40,230 --> 00:03:41,780
أرجو مُسامحتي

51
00:03:41,780 --> 00:03:48,780
استخدمَ ميهايرو ذلك الكتاب لاستهداف الجزء
الأضعف والأكثر هشاشة فيك

52
00:03:53,870 --> 00:03:58,580
أسماؤنا الحقيقيّة لا تُدنّس البتّة

53
00:04:01,500 --> 00:04:03,550
!يا آنسة

54
00:04:03,550 --> 00:04:07,470
!لماذا لا تصغين إليّ؟

55
00:04:12,640 --> 00:04:15,850
سأتدبّر أمري معكم فحسب

56
00:04:15,850 --> 00:04:19,400
اقتلوا الجميع هنا

57
00:04:19,400 --> 00:04:20,900
اقتلوا

58
00:04:20,900 --> 00:04:23,820
!اقتلوا

59
00:04:32,740 --> 00:04:36,250
!ما الّذي يجري؟! لا

60
00:04:43,710 --> 00:04:48,090
أخي

61
00:04:48,090 --> 00:04:50,010
!ما هذا؟

62
00:04:50,010 --> 00:04:54,180
وكأنّ كتاب فانيتاس يلتهم ميهايرو

63
00:04:59,940 --> 00:05:04,360
!نوي. انسَ أمري. اخرج من هنا حالاً

64
00:05:05,280 --> 00:05:08,700
أخرجَ ميهايرو الكتابَ عن السّيطرة

65
00:05:08,700 --> 00:05:12,030
عبثَ بالأستيرمايت في مدينة الملاهي عبثاً شديداً

66
00:05:12,030 --> 00:05:12,950
لا

67
00:05:12,950 --> 00:05:16,080
...إذا انفجر كلّ شيء في آن واحد

68
00:05:16,080 --> 00:05:17,750
!قلتُ لا

69
00:05:26,760 --> 00:05:28,920
!فانيتاس! نوي

70
00:05:44,770 --> 00:05:46,900
جليد؟

71
00:05:50,280 --> 00:05:53,410
فخامتكِ دومينيك؟

72
00:05:53,410 --> 00:05:54,990
لا داعي للقلق

73
00:05:54,990 --> 00:06:00,250
اعتنيا بي، وسأفعل المثل معكما

74
00:06:06,750 --> 00:06:12,340
والآن لنُشهر سيوفنا معاً لحماية ما نحبّ

75
00:06:13,970 --> 00:06:20,520
يا آنسة، اقتليهم. اقتليهم أجمعين

76
00:06:20,520 --> 00:06:24,940
!اقتليهم

77
00:06:43,040 --> 00:06:47,090
إنّها... حسناء

78
00:06:58,560 --> 00:07:01,060
!دومي. دومي

79
00:07:01,060 --> 00:07:02,480
نوي

80
00:07:15,490 --> 00:07:18,620
أخي

81
00:07:21,910 --> 00:07:24,910
أنقذني

82
00:07:26,290 --> 00:07:29,210
أخي

83
00:07:31,840 --> 00:07:39,050
أخي

84
00:07:56,990 --> 00:07:58,870
هذا مؤلم

85
00:07:58,870 --> 00:08:00,990
!مؤلم جدّاً

86
00:08:00,990 --> 00:08:04,290
...مؤلم، مؤلم، مؤلم

87
00:08:04,290 --> 00:08:09,330
!هذا مؤلم حقّاً يا أخي

88
00:08:17,220 --> 00:08:18,340
!أنت

89
00:08:18,340 --> 00:08:20,550
!فانيتاس؟! ما الأمر؟

90
00:08:20,550 --> 00:08:23,600
كم هذا مُدهش

91
00:08:26,310 --> 00:08:30,400
،كنتُ قلقاً من أن أضطرّ لإيقافِك عاجلاً

92
00:08:30,400 --> 00:08:33,860
لكن يسرّني أنّني لم أفعل

93
00:08:33,860 --> 00:08:40,570
كان ذلك مُدهشاً حقّاً. وبفضلِك رأيتُ ذلك

94
00:08:40,570 --> 00:08:47,080
مضى وقت طويل يا هِرري العزيزة، ميس تشاتون

95
00:08:54,500 --> 00:08:58,260
!جـ-جدّي؟ ماذا تفعل هنا؟

96
00:09:08,270 --> 00:09:10,980
،يسرّني لقاؤكِ يا ساحرة نار الجحيم

97
00:09:10,980 --> 00:09:15,530
وأنت يا من يُعدّ من عشيرة القمر الأزرق

98
00:09:15,530 --> 00:09:19,110
لعلّكم لم تروني بهذه الهيئة من قبل؟

99
00:09:20,530 --> 00:09:24,780
الماركيز دو سادو السّابق، عديم الشّكل

100
00:09:24,780 --> 00:09:29,790
يبدو أنّ هِرري العزيزة مدينون لك

101
00:09:29,790 --> 00:09:33,460
صوت جميل وابتسامة رقيقة

102
00:09:33,460 --> 00:09:37,840
عجيب أن يسبّب عدم الخوف خوفاً

103
00:09:37,840 --> 00:09:40,260
مُعلّم

104
00:09:40,260 --> 00:09:43,680
مُعلّم، لماذا أنت مع  ميهايرو؟

105
00:09:43,680 --> 00:09:47,180
حضرة الكونت، هذا مؤلم

106
00:09:47,180 --> 00:09:50,850
هذا مؤلم للغاية. ساعدني

107
00:09:52,850 --> 00:09:57,320
أنقذني شخص لطيف

108
00:09:57,320 --> 00:10:02,780
"مُعلّم، هل أنت ذلك "الشّخص اللّطيف
الّذي ذكره ميهايرو؟

109
00:10:04,700 --> 00:10:06,780
...هل أنت يا مُعلّم

110
00:10:06,780 --> 00:10:14,670
من أخبره بأنّ هناك طريقة لإعادة مصّاص
دماء القمر الأزرق إلى الحياة؟

111
00:10:16,000 --> 00:10:18,500
هذا صحيح

112
00:10:18,500 --> 00:10:19,800
...أيُّها

113
00:10:19,800 --> 00:10:23,470
قلتَ بأنّنا ربّما لم نرك بهيئتك الحاليّة من قبل

114
00:10:23,470 --> 00:10:26,970
!رغم ذلك، أين التقينا من قبل؟

115
00:10:29,600 --> 00:10:32,730
هل الكونت سان جيرمان اسم مألوف؟

116
00:10:32,730 --> 00:10:38,940
إنّه اسمي في هذه الأيّام. احرصوا
على حفظه جيّداً في المرّة المقبلة

117
00:10:40,320 --> 00:10:43,110
تقع مملكةُ الأحلام بين الأطلال

118
00:10:43,110 --> 00:10:47,200
سواء كان حلماً جميلاً يشبه سرير الأرجوحة اللّطيف

119
00:10:47,200 --> 00:10:52,500
أو كابوساً يقضم روحك، يبقى الحلم حلماً ببساطة

120
00:10:52,500 --> 00:10:58,590
على المرء أن يستيقظ دوماً ليواجه الحقيقة

121
00:10:58,590 --> 00:11:05,550
لنلتقِ ثانية عندما يحين الوقت يا هِرري
العزيزة، مون تشاتون

122
00:11:05,550 --> 00:11:12,430
،وأنت كذلك أيّها البشريّ وريث الأزرق
الكائن الأجمل في العالم

123
00:11:15,900 --> 00:11:16,150
انتظر -

124
00:11:16,150 --> 00:11:17,900
!مُعلّم -
انتظر -

125
00:11:24,070 --> 00:11:24,900
!نوي

126
00:11:24,900 --> 00:11:26,820
!فانيتاس

127
00:11:26,820 --> 00:11:30,580
طاب مساؤك أيّها الصّغير

128
00:12:11,870 --> 00:12:15,330
صباح الخير يا سيّد نوي

129
00:12:16,410 --> 00:12:18,080
آنسة أميليا؟

130
00:12:18,080 --> 00:12:20,540
أجل، هذه أنا

131
00:12:20,540 --> 00:12:21,710
ماذا حدث؟

132
00:12:21,710 --> 00:12:24,300
الجميع سالمون

133
00:12:27,010 --> 00:12:32,850
كانوا قلقين جدّاً عليك أيضاً

134
00:12:35,310 --> 00:12:37,350
سامحيني

135
00:12:37,350 --> 00:12:40,480
أنا ممتنّ لمساعدتكِ يا آنسة أميليا

136
00:12:40,480 --> 00:12:45,400
حسناً، هل أحضر لك ماء وطعاماً خفيفاً؟

137
00:12:45,400 --> 00:12:48,820
لا، يمكنني فعل ذلك بنفسي

138
00:12:50,490 --> 00:12:56,250
فخامتها دومينيك والآنسة جان تتحادثان في قاعة الطعام

139
00:12:56,250 --> 00:13:00,000
امنحهما بعض الخصوصيّة ريثما تنتهيان رجاء

140
00:13:04,090 --> 00:13:06,590
إنّه في الأعلى

141
00:13:06,590 --> 00:13:10,590
سأعدّ الطعام لكما

142
00:13:47,460 --> 00:13:49,420
...المعذرة

143
00:13:50,420 --> 00:13:53,850
هل إصابتك بليغة؟

144
00:13:55,640 --> 00:14:00,140
أنا آسف. واضح أنّها كذلك

145
00:14:04,020 --> 00:14:08,400
فانيتاس، ألن تدخل؟

146
00:14:08,400 --> 00:14:13,450
لكن إن كنتُ أزعجك، فسأدعك بمفردك

147
00:14:13,450 --> 00:14:15,200
...كنتُ أنتظر

148
00:14:17,540 --> 00:14:19,830
قدومه...

149
00:14:24,670 --> 00:14:25,330
...ميـ -

150
00:14:25,330 --> 00:14:26,000
نوي -
...ميـ -

151
00:14:26,000 --> 00:14:26,630
نوي -

152
00:14:28,170 --> 00:14:33,050
لا داعي لتفعل شيئاً. ابقَ مكانك فحسب

153
00:14:46,440 --> 00:14:48,820
...في الأمس

154
00:14:48,820 --> 00:14:53,860
في الأمس، أردتُ طرح سؤال لكن لم أستطع

155
00:14:53,860 --> 00:14:58,740
لذا أردتُ أن أسألك الآن

156
00:15:05,670 --> 00:15:09,500
هل أنا سبب وفاة أبي؟

157
00:15:10,800 --> 00:15:16,470
لا أستطيع تذكّر ذلك اليوم، اليوم الّذي
مات فيه وفقدتُ ذراعي

158
00:15:16,470 --> 00:15:20,350
...كـ-كلّ ذلك... كان غلطتي

159
00:15:20,350 --> 00:15:21,770
لا

160
00:15:23,890 --> 00:15:26,270
أنا القاتل

161
00:15:28,730 --> 00:15:34,070
كان ذلك اليوم الّذي سرق فيه أحدُهم
اسمَ لونا الحقيقيّ

162
00:15:34,070 --> 00:15:37,990
كان لونا على وشك أن يتحوّل إلى وحش مختلّ

163
00:15:37,990 --> 00:15:42,450
لهذا انضممتُ لعشيرة القمر الأزرق

164
00:15:42,450 --> 00:15:47,000
وقتلتُ لونا بقوّتهم

165
00:15:48,420 --> 00:15:50,710
هذه هي الحقيقة

166
00:15:52,460 --> 00:15:55,220
أنا أعالج حاملي اللّعنة

167
00:15:55,220 --> 00:16:01,140
بحثاً عن أدلّة تقودني إلى هويّة مَن
سرقَ اسم لونا الحقيقيّ

168
00:16:01,140 --> 00:16:05,100
لن أسامح مصّاص دماء القمر الأزرق أبداً

169
00:16:05,100 --> 00:16:09,980
سأمسح وجوده عن وجه الأرض

170
00:16:09,980 --> 00:16:14,110
سأدمّر وأدفن كلّ أثر له

171
00:16:15,530 --> 00:16:19,240
ذلك سيكون ثأري

172
00:16:24,660 --> 00:16:27,210
لهذا لا أستطيع الذّهاب معك

173
00:16:29,460 --> 00:16:32,300
كـ-كيف أمكنك قول ذلك؟

174
00:16:32,300 --> 00:16:35,800
إذا أعدنا أبانا، فستكون الأمور
...كما كانت آنذاك

175
00:16:35,800 --> 00:16:38,800
الموتى لا يعودون

176
00:16:38,800 --> 00:16:43,060
حتّى لو عادوا، سيكون مجرّد شيء يشبههم

177
00:16:43,060 --> 00:16:46,600
!لكنّك تعلم جيّداً مثلما أعلم

178
00:16:46,600 --> 00:16:49,810
،كلّما استخدمنا كتُبَنا أكثر

179
00:16:49,810 --> 00:16:52,320
ابتعدنا أكثر عن بشريّتنا

180
00:16:52,320 --> 00:16:55,070
إنّها تُعيد صياغة كياننا بحدّ ذاته

181
00:16:55,070 --> 00:16:57,240
رأيتني في الأمس، أليس كذلك؟

182
00:16:57,240 --> 00:16:58,490
هذا واقع

183
00:16:58,490 --> 00:17:01,530
نتحوّل تدريجيّاً إلى شيء مختلف عن أنفسنا

184
00:17:01,530 --> 00:17:05,790
أنا الوحيد الّذي يتفهّم الألم الّذي تمرّ به

185
00:17:05,790 --> 00:17:07,870
قلتَها بنفسك

186
00:17:07,870 --> 00:17:10,120
،حتّى لو كان ذلك يعني الموت غداً"

187
00:17:10,120 --> 00:17:12,880
"أريد الاستمرار في كوني بشريّاً حتّى النّهاية

188
00:17:12,880 --> 00:17:16,840
!سأمنحك هديّة الموت إذا أصبحتَ وحشاً

189
00:17:16,840 --> 00:17:19,840
!فأساساً، نحن متشابهان

190
00:17:19,840 --> 00:17:22,800
!لذا... أرجوك

191
00:17:24,850 --> 00:17:27,350
لستُ بحاجتك

192
00:17:27,350 --> 00:17:31,770
...إذا كنتُ أستطيع اختيار طريقة موتي

193
00:17:33,440 --> 00:17:36,530
...إذا كنتُ أستطيع تحقيق أمنية

194
00:17:44,490 --> 00:17:48,080
إذا كنتُ سأُقتَل، فإنّي أختاره هو

195
00:18:34,580 --> 00:18:37,630
حسناً، لا مشكلة

196
00:18:37,630 --> 00:18:41,170
سأعيد أبي بنفسي

197
00:18:41,170 --> 00:18:46,760
ما الّذي يخطّط له عديم الشّكل، الكونت سان جيرمان؟

198
00:18:46,760 --> 00:18:49,890
لا أعلم. ولا يهمّني

199
00:18:49,890 --> 00:18:54,310
كدتُ أنسى. ثمّة أمر ينبغي أن أخبرك به

200
00:18:54,310 --> 00:18:57,860
الآنسة دومي لم تقتل أحداً

201
00:18:57,860 --> 00:19:01,110
تقلقلَ توازن مصّاصي الدّماء عندما
،استخدمتُ الكتابَ للعبث بهم

202
00:19:01,110 --> 00:19:06,200
لكنّها منعتهم من مهاجمة البشر عدّة مرّات

203
00:19:06,200 --> 00:19:11,370
احرص على إخبار المسؤولين الكبار ألّا يسيئوا إليها

204
00:19:11,370 --> 00:19:14,580
لماذا تخبرني بذلك؟

205
00:19:14,580 --> 00:19:18,500
لأنّها كانت لطيفة معي

206
00:19:18,500 --> 00:19:22,510
أحبّ الأشخاص اللّطيفين

207
00:19:32,730 --> 00:19:34,230
أنت ثقيل جدّاً

208
00:19:34,230 --> 00:19:36,850
دعني قليلاً فقط

209
00:19:36,850 --> 00:19:39,940
هل كانت فكرة سديدة أن ندع ميهايرو يفلت؟

210
00:19:39,940 --> 00:19:43,150
لا بدّ أنّ في جُعبتك الكثير من الأسئلة لتطرحها عليه

211
00:19:43,150 --> 00:19:48,070
...معك حقّ، لكن حاليّاً

212
00:19:48,070 --> 00:19:50,870
أريد أن أتكلّم معك

213
00:19:56,000 --> 00:19:58,040
آسف

214
00:20:01,250 --> 00:20:05,260
كنتُ عجولاً في أكثر من ناحية. أو ربّما العكس تماماً

215
00:20:05,260 --> 00:20:10,300
ماطلتُ كثيراً أو لم أفعل ما يكفي

216
00:20:10,300 --> 00:20:13,890
أقلق عندما تتصرّف بتواضع

217
00:20:13,890 --> 00:20:16,060
هل تبحث عن شِجار؟

218
00:20:19,150 --> 00:20:20,690
أستسلم

219
00:20:20,690 --> 00:20:21,900
ماذا؟

220
00:20:21,900 --> 00:20:27,110
قلتُ أستسلم من مُحاولة جعلك تفعل ما أريد

221
00:20:32,450 --> 00:20:34,330
ثقيل جدّاً

222
00:20:37,370 --> 00:20:40,380
وماذا الآن؟

223
00:20:40,380 --> 00:20:43,840
أوّلاً، سأتحرّى عن الكونت سان جيرمان

224
00:20:43,840 --> 00:20:44,920
حسناً

225
00:20:44,920 --> 00:20:49,050
غير ذلك، لم يتغيّر شيء

226
00:20:49,050 --> 00:20:53,390
أنا طبيب. وسأستمرّ في مُعالجة حاملي اللّعنة

227
00:20:53,390 --> 00:20:58,980
سأفعل ما أشاء، أي الأخذ بثأري بواسطة
إنقاذ مصّاصي الدّماء

228
00:21:01,190 --> 00:21:04,320
صحيح. لم يتغيّر شيء بالنسبة لي أيضاً

229
00:21:06,280 --> 00:21:07,820
!أيّها الدجّال

230
00:21:07,820 --> 00:21:10,910
!هل استيقظت أخيراً؟! ما الّذي أخّرك؟

231
00:21:10,910 --> 00:21:14,540
هل تعي ما الّذي تكبّدناه من معاناة في الأمس؟

232
00:21:14,540 --> 00:21:17,910
!استشاطَ الكونت أورلوك غضباً

233
00:21:17,910 --> 00:21:21,380
!يريد رؤيتكما على الفور

234
00:21:21,380 --> 00:21:22,710
أنا خائف

235
00:21:22,710 --> 00:21:23,840
كم هذا مُزعج

236
00:21:23,840 --> 00:21:26,590
!وأنت مَدين لي باعتذار على الضرب الّذي تلقّيتُه

237
00:21:26,590 --> 00:21:28,300
آسف

238
00:21:29,340 --> 00:21:33,350
!سيّد فانيتاس، سيّد نوي! طلعت الشّمس

239
00:21:40,060 --> 00:21:41,690
فانيتاس

240
00:21:41,690 --> 00:21:43,610
هيّا بنا