1
00:00:01,510 --> 00:00:03,890
وجود مُستديم

2
00:00:14,610 --> 00:00:17,030
ما-ما هذا؟

3
00:00:28,670 --> 00:00:33,380
!دفعَتْ ناينيا لاتّخاذ شكل جسديّ

4
00:00:33,380 --> 00:00:37,510
فكّرتُ في هذا منذ مدّة طويلة

5
00:00:37,510 --> 00:00:42,180
كيف أنهي هذا الكابوس الدّائم؟

6
00:00:42,180 --> 00:00:46,770
كيف يمكنني الاستحواذ على شيء روحيّ كهذا؟

7
00:00:51,440 --> 00:00:53,190
أخيراً

8
00:00:53,190 --> 00:00:57,150
الآن حتّى أنا أستطيع قتلك

9
00:00:57,150 --> 00:00:59,610
ثمّة أمر أريد منك معرفته

10
00:00:59,610 --> 00:01:01,530
،أخبرني أبي

11
00:01:01,530 --> 00:01:05,790
أولئك الّذين وُلِدوا في كنف طبقة نبيلة"
يجب أن يحموا شعبهم الإقطاعيّ

12
00:01:05,790 --> 00:01:09,330
"تفتخر عائلة دابشير في القيام بذلك

13
00:01:09,330 --> 00:01:14,130
،لذلك مهما فعلوا بي أو قدرما رغبتُ في قتلهم

14
00:01:14,130 --> 00:01:17,670
!مُحال أن أكره شعب إقطاعيّة دابشير

15
00:01:17,670 --> 00:01:19,170
!أحبّهم

16
00:01:19,170 --> 00:01:22,300
إنّه واجب أولئك الّذين وُلِدوا في كنف عائلة دابشير

17
00:01:22,300 --> 00:01:24,550
،لكن أنتِ تحديداً لا أستطيع مسامحتك

18
00:01:24,550 --> 00:01:28,100
لأنّكِ أخذتِ الشيء الوحيد الّذي أملكه

19
00:01:28,100 --> 00:01:30,640
واستحوذتِ عليه

20
00:01:30,640 --> 00:01:34,230
دنّستِ اسم جان-جاكو الحقيقيّ

21
00:01:34,230 --> 00:01:36,860
لن أغفر لهذا إطلاقاً

22
00:01:36,860 --> 00:01:38,780
،كما أخبرتُك

23
00:01:38,780 --> 00:01:43,280
أنا امرأة غيّورة جدّاً

24
00:03:06,200 --> 00:03:11,370
"دراسة حالة فانيتاس"

25
00:03:18,040 --> 00:03:20,550
!ما هذا الصّوت؟

26
00:03:20,550 --> 00:03:22,670
!لـ-لدينا مشكلة يا قائد

27
00:03:22,670 --> 00:03:26,340
ألتقط موجات هائلة من الطاقة من تلك القلعة

28
00:03:26,340 --> 00:03:29,850
!أعتقد بأنّ المحرّك قد تفعّل

29
00:03:32,680 --> 00:03:34,640
!إلى القلعة

30
00:03:34,640 --> 00:03:36,980
!مهلاً يا أستولفو

31
00:03:36,980 --> 00:03:38,980
هذا سيّئ

32
00:03:38,980 --> 00:03:41,360
ثمّة شيء يجري هناك

33
00:03:44,150 --> 00:03:45,780
!فانيتاس

34
00:03:45,780 --> 00:03:48,530
!هل أنت بخير؟! فانيتاس

35
00:03:56,000 --> 00:03:58,380
!الآنسة كلوي! ناينيا؟

36
00:03:58,380 --> 00:04:01,550
قتلك أصعب ممّا توقّعت

37
00:04:08,130 --> 00:04:10,760
هل هذا مؤلم؟ هل تتألّمين؟

38
00:04:10,760 --> 00:04:14,390
هل تشعرين بغضبي؟

39
00:04:14,390 --> 00:04:16,100
لا... تفعلي هذا

40
00:04:16,100 --> 00:04:17,480
فانيتاس

41
00:04:17,480 --> 00:04:22,070
لا تستفزّي ناينيا أكثر من هذا

42
00:04:41,960 --> 00:04:45,260
!الألم

43
00:04:45,260 --> 00:04:46,550
!هذا مؤلم للغاية

44
00:04:46,550 --> 00:04:52,100
!هذا مؤلم

45
00:04:58,230 --> 00:05:01,610
!كلوي! حرّريها من هيئتها الجسديّة

46
00:05:01,610 --> 00:05:04,940
!لا تدعيها تتذكّر من تكون

47
00:05:04,940 --> 00:05:07,280
!لن تتمكّني من قتلها

48
00:05:22,040 --> 00:05:26,340
أ-أخي... ماذا كان ذلك؟

49
00:05:26,340 --> 00:05:28,970
هدّئ من روعك يا لوكا

50
00:05:30,510 --> 00:05:35,810
حاولنا جاهدين تدمير جسدها

51
00:05:35,810 --> 00:05:39,850
يبدو أنّ هناك بعض البقايا الّتي ما زالت مُبعثرة

52
00:05:39,850 --> 00:05:43,690
أليس كذلك يا جلالة الملكة؟

53
00:05:56,830 --> 00:06:00,040
!هذه القوّة الاضطّهاديّة، إنّها تقلب معِدتي

54
00:06:03,580 --> 00:06:05,380
ما الّذي يحدث؟

55
00:06:10,630 --> 00:06:14,550
جسدي لا ينفك يرتجف

56
00:06:14,550 --> 00:06:19,680
إنّه لا يدعني أعصي الوجود الّذي أمامي

57
00:06:33,530 --> 00:06:34,780
!آنسة كلوي

58
00:06:34,780 --> 00:06:37,530
!توقّف! سوف تستهدفك أيضاً

59
00:06:37,530 --> 00:06:40,580
فانيتاس، ما الّذي يجري؟

60
00:06:40,580 --> 00:06:43,870
ذلك الشّيء المدعو ناينيا، ما يكون بالضبط؟

61
00:06:43,870 --> 00:06:48,250
إنّها ناينيا، راعية الموت

62
00:06:53,550 --> 00:07:00,060
،إنّه الماغاتسونا الخاص بالملكة فاوستينا
أوّل مصّاصة دماء من القمر القرمزيّ

63
00:07:00,060 --> 00:07:03,520
جلالة الملكة؟

64
00:07:07,690 --> 00:07:08,770
!هذه مُصيبة

65
00:07:08,770 --> 00:07:12,780
!تجسّدتْ جلالتها قسراً! سوف تخرج عن السّيطرة

66
00:07:22,120 --> 00:07:23,750
!جان-جاكو

67
00:07:36,130 --> 00:07:37,760
كلوي؟

68
00:08:06,750 --> 00:08:09,880
!أ-أيّها القائد! نحن نعوم في هواء رقيق

69
00:08:09,880 --> 00:08:12,090
!المكان بأكمله يعوم

70
00:08:14,090 --> 00:08:15,880
!توقّفَ المحرّك

71
00:08:15,880 --> 00:08:18,590
!سوف يتبدّد جسد ناينيا من جديد

72
00:08:30,860 --> 00:08:32,400
كدتُ أنسى

73
00:08:32,400 --> 00:08:36,110
يجب أن أبحث عن مزيد من الأسماء

74
00:08:51,670 --> 00:08:53,290
!فانيتاس

75
00:08:57,170 --> 00:08:58,970
ستفشل

76
00:08:59,970 --> 00:09:03,100
لن تصل إليه أبداً

77
00:09:03,100 --> 00:09:04,890
لا يستطيع أحد إنقاذه

78
00:09:04,890 --> 00:09:06,890
ضاع كلّ شيء

79
00:09:06,890 --> 00:09:12,400
فلماذا إذاً تستمرّ في مدّ يدك؟

80
00:09:12,400 --> 00:09:15,690
انضمّ إلينا بسرعة

81
00:09:23,070 --> 00:09:26,080
ماذا كان ذلك بالتحديد؟

82
00:09:27,450 --> 00:09:28,870
ماذا حدث؟

83
00:09:28,870 --> 00:09:30,290
أين نحن؟

84
00:09:30,290 --> 00:09:32,080
اختفت قريتنا؟

85
00:09:32,080 --> 00:09:33,210
البرد قارس

86
00:09:33,210 --> 00:09:34,500
!انظر

87
00:09:34,500 --> 00:09:36,420
أهل قرية سوغ بلا شكّ

88
00:09:36,420 --> 00:09:37,840
فانيتاس

89
00:09:37,840 --> 00:09:39,840
اللّعنة على ناينيا الحقيرة تلك

90
00:09:39,840 --> 00:09:42,760
لمَ لا تختفي بهدوء فحسب؟

91
00:09:42,760 --> 00:09:45,350
إنّها حقّاً فاسدة حتّى النّخاع

92
00:09:45,350 --> 00:09:46,890
اسمعني يا نوي

93
00:09:46,890 --> 00:09:51,480
الماغاتسونا الخاصّة بكلوي دابشير تخلق
فضاء يحميها

94
00:09:51,480 --> 00:09:55,150
وبينما تخرج عن السّيطرة، يتوسّع المجال
،الّذي تُفسِده شيئاً فشيئاً

95
00:09:55,150 --> 00:09:58,400
لتجذب كلّ كائن حيّ يقف في دربها

96
00:09:58,400 --> 00:10:02,490
ستلتهم الجميع في جيفودان إن لم نفعل شيئاً

97
00:10:09,160 --> 00:10:10,330
!كنت تعلم؟

98
00:10:10,330 --> 00:10:13,920
!كان ينبغي أن تخبرني بما أنّك تعرف كلّ هذا

99
00:10:13,920 --> 00:10:14,750
!ماذا؟

100
00:10:14,750 --> 00:10:18,250
!ليس عن كلوي فحسب! بل ناينيا أيضاً

101
00:10:18,250 --> 00:10:21,010
!لم أكن متأكّداً من هويّتها الحقيقيّة حتّى الآن

102
00:10:21,010 --> 00:10:23,380
!وأنا لا أحبّ الافتراضات العشوائيّة

103
00:10:23,380 --> 00:10:24,470
!هل لديك اعتراض على ذلك؟

104
00:10:24,470 --> 00:10:26,680
!لديّ

105
00:10:26,680 --> 00:10:30,220
!لو أخبرتني لاختلفت الأمور

106
00:10:30,220 --> 00:10:32,850
!أو لا. من المُحال أن نجزم

107
00:10:32,850 --> 00:10:35,810
!لكن لعلّنا استطعنا فعل شيء ما

108
00:10:35,810 --> 00:10:36,360
--كان بمقدوري -

109
00:10:36,360 --> 00:10:38,270
!ما كنت لتصدّقني -
--كان بمقدوري -

110
00:10:38,270 --> 00:10:40,860
!أنتم مصّاصو الدّماء لا تصغون للبشر أبداً

111
00:10:42,400 --> 00:10:47,200
!هل تعي حتّى كم مرّة كاد بَني جنسك يقتلني؟

112
00:10:47,200 --> 00:10:49,620
!ونحن نتكلّم عن ملكتكم هذه المرّة

113
00:10:49,620 --> 00:10:51,330
--أجل، لكنّني

114
00:10:51,330 --> 00:10:54,710
!هل نسيتَ كيف كاد السيّد روثفين يقضي عليّ؟

115
00:10:54,710 --> 00:10:56,630
!أيّها الأحمق

116
00:10:59,800 --> 00:11:02,550
!أنا أؤمن بك

117
00:11:08,680 --> 00:11:10,060
!هذا مؤلم! توقّف

118
00:11:10,060 --> 00:11:11,310
!أنت تثير اشمئزازي

119
00:11:11,310 --> 00:11:12,430
لمَ تفعل هذا؟

120
00:11:12,430 --> 00:11:13,690
!أنت حقّاً تثير اشمئزازي

121
00:11:13,690 --> 00:11:15,310
هذا مؤلم

122
00:11:17,270 --> 00:11:19,610
وبعد؟ ماذا الآن؟

123
00:11:19,610 --> 00:11:21,320
...في الواقع

124
00:11:21,320 --> 00:11:24,700
لم تفقد الأمل من كلوي دابشير، أليس كذلك؟

125
00:11:26,200 --> 00:11:27,870
!بالطبع لا

126
00:11:32,790 --> 00:11:34,960
!ذئاب؟

127
00:11:43,170 --> 00:11:45,840
...سأدع فانيتاس يتولّى هذا الأمر بينما أنا

128
00:11:45,840 --> 00:11:47,590
لا، حريّ بي ألّا أفعل

129
00:11:47,590 --> 00:11:50,720
هذه ليست ذئاباً عاديّة

130
00:11:51,810 --> 00:11:53,470
!الوقت يداهمنا

131
00:11:54,560 --> 00:11:56,100
!ماذا أفعل؟

132
00:11:56,100 --> 00:11:58,900
لننقضّ عليهم يا دوراندال

133
00:12:04,070 --> 00:12:05,860
توقّعتُ أن تكونا أنتما

134
00:12:05,860 --> 00:12:10,120
لطالما عرفتُ بأنّنا سنلتقي ثانية

135
00:12:10,120 --> 00:12:14,580
أنا مُمتنّ دوماً لنور الهِداية الّذي يبعثه الربّ

136
00:12:14,580 --> 00:12:16,750
!شكراً لك يا إلهي

137
00:12:28,220 --> 00:12:29,760
!رولاند

138
00:12:34,390 --> 00:12:35,890
!أوركا؟

139
00:12:35,890 --> 00:12:38,640
سامحاني، لكن هذه وسائل نقل تابعة لصيّادي الكنيسة

140
00:12:38,640 --> 00:12:42,110
قد تسوء الأمور إذا رأوكما

141
00:12:42,110 --> 00:12:44,280
كانت صدمة حقيقيّة

142
00:12:44,280 --> 00:12:47,900
هبّتْ علينا عاصفة ثلجيّة فجأة بينما
نحن في طريقنا إلى ساغ

143
00:12:47,900 --> 00:12:51,620
ثمّ بدأت الجبال تنهار وشنّت الذّئاب هجوماً

144
00:12:51,620 --> 00:12:56,200
لا بدّ أنّ وحش جيفودان من يقف وراء كلّ هذا

145
00:12:56,200 --> 00:12:59,750
هل يُعقل أنّ رولاند قد أتى لقتل الوحش أيضاً؟

146
00:12:59,750 --> 00:13:01,130
...في الواقع

147
00:13:01,130 --> 00:13:03,920
ما العمل إذاً؟

148
00:13:03,920 --> 00:13:06,300
،بما أنّكما هنا

149
00:13:06,300 --> 00:13:11,180
فلا بدّ من وجود مصّاص دماء حامل
للّعنة في وسط كلّ هذا

150
00:13:11,180 --> 00:13:15,890
ماذا عساني أفعل لاقتياد الأمور إلى قرار أكثر سلميّة؟

151
00:13:21,190 --> 00:13:22,900
!رولاند

152
00:13:22,900 --> 00:13:24,270
!ذلك الأحمق

153
00:13:24,270 --> 00:13:27,650
اختفى ليتركنا في هذه الفوضى

154
00:13:27,650 --> 00:13:31,610
تريد مساعدتنا؟ لكن لماذا؟

155
00:13:31,610 --> 00:13:33,280
كيف أمكنك قول ذلك؟

156
00:13:33,280 --> 00:13:37,700
ظننتُ أنّ ولعي بكما كان واضحاً تماماً

157
00:13:39,330 --> 00:13:44,040
!أنا أيضاً! أنا مولع جدّاً... بك

158
00:13:44,040 --> 00:13:45,340
!أشكركما

159
00:13:45,340 --> 00:13:47,510
!لا تُقحمني في هذا

160
00:13:49,050 --> 00:13:52,220
لا تدع شعب جيفودان يموت يا رولاند

161
00:13:52,220 --> 00:13:58,390
أداء واجبها كعضو في دابشير يعطي
معنى لحياة كلوي

162
00:13:58,390 --> 00:14:03,980
لذا لو فقدت السّيطرة وقتلتْ حتّى
،مُقيم واحد من مُقيمي هذه المنطقة

163
00:14:03,980 --> 00:14:06,610
فلن يكون هناك ما ينقذها

164
00:14:06,610 --> 00:14:12,030
وحتّى لو أنقذناها، لن يكون هناك خلاصاً لروحها

165
00:14:12,030 --> 00:14:14,240
هل يمكنك فعل ذلك؟

166
00:14:14,240 --> 00:14:16,160
اعتمد عليّ

167
00:14:17,660 --> 00:14:21,790
لكن أنا هنا كبالادِن من صيّادي الكنيسة

168
00:14:21,790 --> 00:14:23,960
،إذا ساءت الأمور أكثر

169
00:14:23,960 --> 00:14:27,090
فلن أتردّد عن قطع رؤوس مصّاصي الدماء

170
00:14:29,090 --> 00:14:32,220
لا تدفعاني لقتل الوحش

171
00:14:36,470 --> 00:14:39,470
!الآن بعد أن استقرّت الأمور، حان وقت البدء بالعمل

172
00:14:39,470 --> 00:14:43,020
!تولّيا أنتما ما يمكنكما تولّيه فحسب

173
00:14:48,480 --> 00:14:50,280
هوتكلير

174
00:14:50,280 --> 00:14:54,200
ستكسره ثانية إذا ظللت تعامله بخشونة

175
00:14:54,200 --> 00:14:55,700
ماذا؟

176
00:14:57,120 --> 00:15:00,330
دائماً ما تقاتل بأٌقلّ طريقة حضاريّة ممكنة

177
00:15:00,330 --> 00:15:01,750
!صُن لسانك

178
00:15:01,750 --> 00:15:03,080
!أين كنت؟

179
00:15:03,080 --> 00:15:07,080
أجل، بخصوص ذلك يا أوليفيير

180
00:15:07,080 --> 00:15:09,590
هلّا طلبتُ منك أن تسدي لي معروفاً؟

181
00:15:09,590 --> 00:15:11,130
لا، لا يمكنك

182
00:15:11,130 --> 00:15:12,260
،في هذه الحالة

183
00:15:12,260 --> 00:15:15,970
أحتاج، دعني أرى... حوالي 30 دقيقة من وقتك

184
00:15:15,970 --> 00:15:18,760
!سنذهب لأداء مهمّة إنقاذ

185
00:15:18,760 --> 00:15:20,220
!قلتُ لا سلفاً

186
00:15:20,220 --> 00:15:22,810
لكنّك لا تتّفق مع الأمر، أليس كذلك؟

187
00:15:23,730 --> 00:15:29,020
الأمر الّذي هو "اقتل كلّ مصّاص دماء
"تلتقي به في جيفودان

188
00:15:29,020 --> 00:15:30,820
لسنا في حرب هنا

189
00:15:30,820 --> 00:15:36,450
إنّ قتل مصّاصي الدّماء لن يؤدّي إلّا
لمزيد من المشاكل

190
00:15:36,450 --> 00:15:41,410
يبدو وكأنّ الكنيسة تحاول التستّر على شيء ما

191
00:15:41,410 --> 00:15:43,540
هذا لا يلائمني إطلاقاً

192
00:15:48,830 --> 00:15:54,220
لهذا أريد التكلّم مع حاملة اللّعنة هناك
دون أن أضطرّ لقتلها

193
00:15:54,220 --> 00:15:58,010
!...تتكلّم مع حاملة لعنة؟ لا تقل لي أنّ

194
00:15:58,010 --> 00:16:01,220
!ذلكما الاثنان يفعلانها من جديد؟

195
00:16:03,600 --> 00:16:06,060
ماذا لدينا هنا؟

196
00:16:06,060 --> 00:16:07,730
!جورجي! ماريا

197
00:16:07,730 --> 00:16:10,310
!أنا وأوليفيير سندمّر هذا المخلوق البغيض

198
00:16:10,310 --> 00:16:12,530
!الإنقاذ هو أولويّتكما

199
00:16:12,530 --> 00:16:14,320
!لا أريد وقوع أي ضحيّة

200
00:16:14,320 --> 00:16:15,650
!حاضر

201
00:16:15,650 --> 00:16:19,370
مضى وقت طويل منذ قاتلتُ بجانبك

202
00:16:19,370 --> 00:16:21,780
!لنسرع في ذلك إذاً

203
00:16:38,470 --> 00:16:41,550
أين أنا؟

204
00:16:41,550 --> 00:16:43,680
من أنا؟

205
00:16:43,680 --> 00:16:48,190
لست سوى مجرّد دُمية لا أكثر

206
00:16:48,190 --> 00:16:50,610
عليك أن تكوني أداة ليس إلّا

207
00:16:50,610 --> 00:16:53,900
والأداة لا تحتاج لإرادة قائمة بذاتها

208
00:16:53,900 --> 00:16:56,110
لا تفكّري

209
00:16:56,110 --> 00:16:59,110
لا رغبة ولا أماني

210
00:16:59,110 --> 00:17:03,280
أيّ فشل في هذا وسأقطع رأسك

211
00:17:03,280 --> 00:17:06,080
أنا دُمية

212
00:17:06,080 --> 00:17:08,460
لستُ إلّا أداة

213
00:17:12,790 --> 00:17:16,420
يا صغيرة، هل أنتِ وحيدة؟

214
00:17:16,420 --> 00:17:18,130
هل أنتِ بخير؟

215
00:17:22,470 --> 00:17:29,060
أجل، قرّرنا رعاية الطفلة بأنفسنا

216
00:17:29,060 --> 00:17:31,310
سررتُ بلقائك يا جان

217
00:17:31,310 --> 00:17:33,150
اسمي روثفين

218
00:17:33,150 --> 00:17:37,650
من الآن فصاعداً، أريدك أن ترى وتتعلّمي
كلّ ما يمكنك تعلّمه تحت وصايتي

219
00:17:37,650 --> 00:17:40,280
يجب أن تتعلّمي المزيد عن هذا العالم

220
00:17:43,820 --> 00:17:48,120
!أمّي. أبي. سأراكما ثانية قريباً

221
00:17:58,460 --> 00:18:02,220
أمّك وأبوك خانا مصّاصي الدّماء

222
00:18:02,220 --> 00:18:06,470
أدّت خيانتهما إلى موت بَني جلدتنا بأعداد غير محصيّة

223
00:18:06,470 --> 00:18:09,270
يجب على الأبناء أن يكفّروا عن خطايا آبائهم

224
00:18:09,270 --> 00:18:12,350
لم تعودي مصّاصة دماء

225
00:18:12,350 --> 00:18:15,110
أنتِ أداة أيتها الجلّادة

226
00:18:17,530 --> 00:18:19,780
لا تفكّري

227
00:18:19,780 --> 00:18:22,910
لا رغبات ولا أماني

228
00:18:22,910 --> 00:18:26,280
...أيّ فشل في هذا و

229
00:18:26,280 --> 00:18:28,080
هذا هو السّبب إذاً

230
00:18:28,080 --> 00:18:30,960
لم أفعل ما قيلَ لي

231
00:18:30,960 --> 00:18:35,630
لكن قطعوا رأس والدَيّ بدلاً من رأسي

232
00:18:39,050 --> 00:18:41,090
أنا جلّادة

233
00:18:41,090 --> 00:18:45,140
لستُ إلّا أداة. يجب أن أتّبع أوامري فحسب

234
00:18:46,510 --> 00:18:50,930
إذاً أنتِ... ساحرة نار الجحيم؟

235
00:18:50,930 --> 00:18:54,480
هيّا، بسرعة

236
00:18:54,480 --> 00:18:59,570
...استخدمي أنيابكِ ومخالبكِ ونيرانكِ و

237
00:19:00,730 --> 00:19:02,700
جان

238
00:19:10,410 --> 00:19:12,660
لا تفكّري

239
00:19:12,660 --> 00:19:15,750
لا رغبة ولا أماني

240
00:19:15,750 --> 00:19:17,670
...أيّ فشل في هذا و

241
00:19:17,670 --> 00:19:19,340
لا. أرجوك

242
00:19:19,340 --> 00:19:22,170
!سوف أقتلها. أرجوك

243
00:20:09,470 --> 00:20:11,140
جان؟

244
00:20:11,140 --> 00:20:12,520
!جان

245
00:20:19,770 --> 00:20:23,530
المُعلّم روثفين

246
00:20:25,740 --> 00:20:30,530
جان، لا تنسي القسَم الّذي أقسمتِه

247
00:20:34,540 --> 00:20:39,500
ستدخلين الآن في نوم عميق

248
00:20:39,500 --> 00:20:45,090
ستنامين حتّى تنتهي الحرب ويستطيع
الجميع أن يعيشوا بسلام

249
00:20:45,090 --> 00:20:48,220
سخّري هذا الوقت لشفاء الجسد والعقل

250
00:20:53,680 --> 00:20:56,730
أجل، كنتُ قد نسيت

251
00:20:56,730 --> 00:21:00,310
فذلك الحلم كان طويلاً جدّاً

252
00:21:00,310 --> 00:21:03,110
جعلَني ذلك أنسى بأنّني دُمية

253
00:21:03,110 --> 00:21:07,030
وأنّني يجب ألّا أمتلك إرادة خاصّة بي

254
00:21:08,070 --> 00:21:13,580
يجب أن أقتل كلوي هذه المرّة. يجب ألّا أفشل

255
00:21:13,580 --> 00:21:16,540
كلوي دابشير ليست الوحش

256
00:21:16,540 --> 00:21:18,830
رأيت ذلك بأمّ عينك

257
00:21:18,830 --> 00:21:20,370
هذا غير مهمّ

258
00:21:20,370 --> 00:21:25,500
أمرني السيّد روثفين بوضع حدّ للأزمة في جيفودان

259
00:21:25,500 --> 00:21:28,340
لكن لم يطلب منك قتلها إطلاقاً

260
00:21:28,340 --> 00:21:32,640
هل تدرك كم روحاً أزهق وحش جيفودان؟

261
00:21:32,640 --> 00:21:35,350
لا أملك خياراً سوى قتله

262
00:21:37,100 --> 00:21:40,020
وكلوي هي حاملة لعنة

263
00:21:40,020 --> 00:21:44,360
يجب على الجلّادين أن يعدموا حاملي
اللّعنة الّذين فقدوا السّيطرة

264
00:21:46,940 --> 00:21:49,320
فات الأوان الآن

265
00:21:49,320 --> 00:21:51,240
وضعها ميؤوس منه

266
00:21:51,240 --> 00:21:52,910
--لهذا يجب عليّ

267
00:21:52,910 --> 00:21:54,910
!لم يفت الأوان

268
00:22:02,880 --> 00:22:05,130
"الاستحواذ على كابوس"

269
00:23:36,890 --> 00:23:40,060
"نحن الاثنان فقط"