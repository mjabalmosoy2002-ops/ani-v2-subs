1
00:00:02,810 --> 00:00:03,970
!ناينيا

2
00:00:03,970 --> 00:00:07,810
!ابتعدي عنها حالاً

3
00:00:07,810 --> 00:00:09,440
ناينيا؟

4
00:00:09,440 --> 00:00:12,320
عجباً، أهذا هو اسمك؟

5
00:00:12,320 --> 00:00:15,490
هذا ما يطلقونه عليّ ببساطة

6
00:00:16,450 --> 00:00:18,200
أهو كذلك الآن؟

7
00:00:19,910 --> 00:00:21,950
لا تهتمّ بذلك. اجلس

8
00:00:21,950 --> 00:00:24,620
وصلَ الطّعام يا نوي

9
00:00:32,960 --> 00:00:35,710
ما هذا؟

10
00:00:35,710 --> 00:00:37,470
...إنّها

11
00:00:37,470 --> 00:00:39,550
...لا، هذا الشيء

12
00:00:40,680 --> 00:00:44,060
!أخذَ لوي منّي

13
00:00:44,060 --> 00:00:45,810
آنسة كلوي

14
00:00:45,810 --> 00:00:49,900
هل أنتِ وحش جيفودان؟

15
00:00:49,900 --> 00:00:54,900
تفيد الإشاعة بأن الوحش هو مصّاص
دماء حامل للّعنة

16
00:00:54,900 --> 00:01:00,280
إن كان كذلك، فذلك الشيء، ناينيا، قد
جرّدك من اسمك الحقيقي

17
00:01:00,280 --> 00:01:05,290
كيف تستطيعين الجلوس بجانبها بابتسامة؟

18
00:01:05,290 --> 00:01:08,000
لأنّ هذا ما أردتُه

19
00:01:09,210 --> 00:01:10,620
ماذا؟

20
00:01:11,580 --> 00:01:14,340
كان ثمن أمنيتي

21
00:01:14,340 --> 00:01:18,260
أصبحتُ حاملة لعنة بمحض إرادتي

22
00:01:18,260 --> 00:01:21,470
لأجل أمنية؟

23
00:01:21,470 --> 00:01:23,720
هذا صحيح

24
00:01:23,720 --> 00:01:26,600
هناك بعض الأسماء الّتي أستميتُ للحصول عليها

25
00:01:26,600 --> 00:01:30,640
،لكن مع مصّاصي دماء أقوياء مثل كلوي

26
00:01:30,640 --> 00:01:34,480
لا أستطيع أخذ أسمائهم بالقوّة

27
00:01:34,480 --> 00:01:37,190
،لذا طلبتُ بأدب

28
00:01:37,190 --> 00:01:43,530
هل ستعطينني اسمكِ الحقيقيّ"
"إذا منحتُكِ أمنية؟

29
00:01:43,530 --> 00:01:46,330
نفس الأمر ينطبق عليك يا نوي

30
00:01:46,330 --> 00:01:51,670
جرّبتُ أشياء كثيرة لكن فشلتُ في
الحصول على اسمك الحقيقيّ

31
00:01:51,670 --> 00:01:53,790
أنت صعب المراس

32
00:01:54,960 --> 00:01:58,760
لهذا يجب أن أسألك أيضاً

33
00:01:58,760 --> 00:02:00,550
أخبرني يا نوي

34
00:02:00,550 --> 00:02:06,850
ما الأمنية التي تستحقُّ ثمن إعطائي
اسمك الحقيقيّ؟

35
00:02:06,850 --> 00:02:09,520
هل...؟

36
00:02:09,520 --> 00:02:13,400
هل قلت نفس الكلام لِلوي أيضاً؟

37
00:02:13,400 --> 00:02:16,940
لوي، هل من شيء يمكنني فعله؟

38
00:02:16,940 --> 00:02:19,900
!ماذا يمكنني أن أفعل لمساعدتك؟

39
00:02:21,320 --> 00:02:23,280
...نوي

40
00:02:23,280 --> 00:02:25,870
...أ... أنا

41
00:02:33,870 --> 00:02:35,420
!ما أنت بالتحديد؟

42
00:02:35,420 --> 00:02:37,380
!ماذا تريد؟

43
00:02:39,250 --> 00:02:41,470
!لماذا تفعل هذا؟

44
00:02:41,470 --> 00:02:43,340
!لماذا تسرق أسماء حقيقيّة؟

45
00:02:43,340 --> 00:02:44,510
كُفّ عن هذا

46
00:02:44,510 --> 00:02:47,350
!كفّ عن سرقتها

47
00:02:47,350 --> 00:02:50,470
!أعده في الحال

48
00:02:51,520 --> 00:02:55,480
!أعِد لوي إليّ وإلى دومي

49
00:03:04,990 --> 00:03:06,490
اسمعني

50
00:03:06,490 --> 00:03:10,160
لا أكترث للأطفال الّذين يسرفون الطّعام

51
00:04:35,160 --> 00:04:40,330
"دراسة حالة فانيتاس"

52
00:04:45,760 --> 00:04:48,130
لمَ فعلتَ ذلك؟

53
00:04:48,130 --> 00:04:49,590
سامحني

54
00:04:49,590 --> 00:04:51,760
تخاف كلوي عندما تغضب

55
00:04:51,760 --> 00:04:52,760
تذكّر ذلك

56
00:04:52,760 --> 00:04:55,180
أين الآنسة كلوي الآن؟

57
00:04:55,180 --> 00:04:57,430
إنّها مع ذلك الظلّ الأسود

58
00:04:57,430 --> 00:05:00,100
ينبغي أن تبقى بعيداً حاليّاً

59
00:05:00,100 --> 00:05:01,440
...أعلم، لكن

60
00:05:01,440 --> 00:05:05,230
--لا يجوز أن نسمح لها بالبقاء مع ذلك الشيء الخطير

61
00:05:07,070 --> 00:05:11,570
رميتَ طعاماً على الأرض ومع ذلك معدتك تُقرقر؟

62
00:05:11,570 --> 00:05:14,160
أنا حقّاً آسف

63
00:05:16,330 --> 00:05:17,790
هذه بقايا طعام

64
00:05:17,790 --> 00:05:19,830
يمكنك المساعدة في التّنظيف

65
00:05:30,260 --> 00:05:33,090
هل أنت من أعدّ هذا؟

66
00:05:33,090 --> 00:05:34,220
أجل

67
00:05:34,220 --> 00:05:37,430
!ورتّقت ملابسي كذلك؟

68
00:05:37,430 --> 00:05:38,270
هذا صحيح

69
00:05:38,270 --> 00:05:39,810
!كم هذا مذهل

70
00:05:39,810 --> 00:05:41,850
!أنت استثنائيّ يا جان-جاكو

71
00:05:41,850 --> 00:05:43,980
هل من شيء لا تستطيع فعله؟

72
00:05:43,980 --> 00:05:47,480
!هذا شهيّ جدّاً! إنّه كذلك بالفعل

73
00:05:47,480 --> 00:05:49,860
!حـ-حقّاً؟

74
00:05:49,860 --> 00:05:52,280
لا شيء استثنائيّ في ذلك

75
00:05:52,280 --> 00:05:56,030
كنتُ ألبّي حاجات كلوي طوال هذا الوقت فحسب

76
00:05:56,030 --> 00:05:58,750
لا أجيد الطّبخ أو الحياكة

77
00:05:58,750 --> 00:06:00,870
!تُرفَع القبّعة لك

78
00:06:02,500 --> 00:06:05,710
اسمع، أرغب أن أشكرك يا جان-جاكو

79
00:06:05,710 --> 00:06:10,050
أنقذتني أنا ومورو، لكن لم أعبّر عن امتناني إلى الآن

80
00:06:10,050 --> 00:06:12,220
أتوسّل غفرانك مرّة أخرى

81
00:06:12,220 --> 00:06:15,100
أودّ أن أعرّف عن نفسي بشكل ملائم

82
00:06:16,140 --> 00:06:18,770
اسمي نوي

83
00:06:18,770 --> 00:06:20,230
لمَ تمدّ يدك؟

84
00:06:21,230 --> 00:06:24,480
إذا أردت مزيداً من الحساء، فأحضره بنفسك

85
00:06:24,480 --> 00:06:27,570
أردتُ مصافحتك

86
00:06:31,280 --> 00:06:35,990
لم يطلب أحدٌ يوماً أن يصافحني

87
00:06:43,040 --> 00:06:46,250
كم لديك من معلومات عن عائلة دابشير؟

88
00:06:46,250 --> 00:06:50,000
فقط ما كان في الملفّ الّذي أعطيتني إيّاه

89
00:06:50,000 --> 00:06:54,590
انقرضتْ عائلتهم عقب هيَجان الوحش

90
00:06:54,590 --> 00:06:57,640
أجل، لكن هناك المزيد

91
00:06:57,640 --> 00:07:01,430
،كانت عائلة دابشير تجري بحثاً حول صياغة العالم

92
00:07:01,430 --> 00:07:03,940
رغم أنّ الكنيسة حرّمت ذلك

93
00:07:03,940 --> 00:07:08,230
أنتجَ عملُهم محرّكَ التّعديل، جهاز لتعديل صياغة العالم

94
00:07:08,230 --> 00:07:13,070
هذا ما خلقَ وحش جيفودان

95
00:07:13,070 --> 00:07:16,160
إذاً السّؤال هو ماذا ينبغي أو ماذا يمكن أن نفعل؟

96
00:07:16,160 --> 00:07:20,030
ألهذا كلّ من مصّاصي الدماء والبشر مهتمّين بهذا؟

97
00:07:20,030 --> 00:07:21,750
على الأرجح

98
00:07:21,750 --> 00:07:25,000
حسناً، أين سمعت كلّ هذا؟

99
00:07:25,000 --> 00:07:28,040
تحت أوامر مَن تتصرّف؟

100
00:07:29,880 --> 00:07:32,170
،السيّد فرانسيس فارني

101
00:07:32,170 --> 00:07:35,880
المُلقّب بمهووس السّاعات الماركيز ماكينا

102
00:07:35,880 --> 00:07:37,680
هكذا إذاً

103
00:07:37,680 --> 00:07:41,680
،كلّفني الماركيز ماكينا بإقحامك في هذا

104
00:07:41,680 --> 00:07:46,440
وبلا شكّ لأنّك عضو في عشيرة القمر الأزرق

105
00:07:46,440 --> 00:07:51,520
يريد أن يعرف أيضاً فيما إذا كان محرّك
التّعديل موجوداً حقّاً

106
00:07:51,520 --> 00:07:55,610
وإن أمكن، عليّ إيجاده وإحضاره له

107
00:08:01,160 --> 00:08:05,370
،هيرمان دابشير، آخر رئيس للعائلة

108
00:08:05,370 --> 00:08:09,290
...وزوجته وأطفالهما وأشقّائه

109
00:08:09,290 --> 00:08:12,090
جميعهم ماتوا

110
00:08:12,090 --> 00:08:17,470
الفرد الوحيد المُتبقّي من عائلة دابشير هي كلوي

111
00:08:17,470 --> 00:08:22,640
جان-جاكو، كم مضى على وجود الآنسة كلوي هنا؟

112
00:08:22,640 --> 00:08:24,560
كانت موجودة دوماً هنا

113
00:08:24,560 --> 00:08:27,640
،قبل فترة طويلة من ظهور وحش جيفودان

114
00:08:27,640 --> 00:08:33,530
كانت كلوي هنا تُراقب كلّ جيل من
أجيال عائلة دابشير

115
00:08:33,530 --> 00:08:37,070
لماذا أنت وجماعتك هنا؟

116
00:08:37,070 --> 00:08:39,910
هل أتيتم لتلحقوا ضرراً بكلوي؟

117
00:08:39,910 --> 00:08:43,280
عدوّي هو ناينيا، لا كلوي

118
00:08:43,280 --> 00:08:47,790
مع ذلك تريد أن تنتزع ذلك الظلّ الأسود منها

119
00:08:47,790 --> 00:08:49,580
!بالطبع

120
00:08:49,580 --> 00:08:53,800
لا أحد يعلم ما قد يحدث للآنسة كلوي
إذا لم نفعل شيئاً

121
00:08:53,800 --> 00:08:57,170
فان-- أعني، شريك سفَري قد يمتلك القوّة

122
00:08:57,170 --> 00:09:00,180
لاستعادة الاسم الحقيقيّ لكلوي

123
00:09:00,180 --> 00:09:01,590
--سوف أحضره إلى هنا و

124
00:09:01,590 --> 00:09:03,260
لتفعل ماذا؟

125
00:09:04,310 --> 00:09:09,390
هل أنتِ متأكّدة من أنّه لا مانع من ترك
نوي وذلك الفتى معاً؟

126
00:09:09,390 --> 00:09:12,860
أجل، إنّها فُرصة نادرة

127
00:09:12,860 --> 00:09:17,110
ينبغي لجان-جاكو أن يحصل على بعض الأصدقاء

128
00:09:19,070 --> 00:09:23,950
قالت كلوي أنّ خيارها هو أن يؤخذ اسمها الحقيقيّ منها

129
00:09:23,950 --> 00:09:28,330
كانت تبكي كلّ يوم إلى أن ظهر ذلك الظلّ

130
00:09:28,330 --> 00:09:31,920
لم يكن بوسعي فعل شيء

131
00:09:31,920 --> 00:09:38,420
لا أتحمّل أن يلمس شخصٌ ما هو لي بلا استئذان

132
00:09:38,420 --> 00:09:41,930
أنتِ ناضجة جدّاً، أليس كذلك؟

133
00:09:41,930 --> 00:09:44,470
إطلاقاً

134
00:09:44,470 --> 00:09:47,640
،إذا كان هذا ما تريده كلوي

135
00:09:47,640 --> 00:09:53,100
ويمنعها من البُكاء، فسوف أتصالح معه

136
00:09:53,100 --> 00:09:58,480
،سأبقى إلى جانب كلوي حتّى النّهاية
ولو عنى ذلك النّسيان

137
00:09:59,690 --> 00:10:05,120
قد لا ترى ذلك، لكنّني امرأة غيّورة جدّاً

138
00:10:11,370 --> 00:10:15,130
النُّدَب الّتي خُلِّفَتْ بواسطة بابل
بدأت تتلاشى أخيراً

139
00:10:15,130 --> 00:10:18,710
في النصف الثّاني من القرن السّادس عشر

140
00:10:18,710 --> 00:10:20,920
اسمعيني يا كلوي

141
00:10:20,920 --> 00:10:27,180
لا يجب على أحد خارج هذه الجدران أن
يعلم بأنّكِ مصّاصة دماء

142
00:10:27,180 --> 00:10:29,100
حاضرة يا أبي

143
00:10:29,100 --> 00:10:32,560
استيقظتُ ذات يوم لأجد نفسي مصّاصة دماء

144
00:10:32,560 --> 00:10:35,940
حالما زعزعَتْ بابل صياغةَ العالم

145
00:10:35,940 --> 00:10:39,730
بدأ ذلك يؤثّر على هذا العالم أيضاً

146
00:10:41,110 --> 00:10:44,360
لا تقلقي. سيكون كلّ شيء على ما يُرام

147
00:10:44,360 --> 00:10:49,450
سأجعلكِ بشريّة ثانية

148
00:10:49,450 --> 00:10:52,790
حاضرة يا أبي

149
00:10:52,790 --> 00:10:57,590
توقّف جسدي عن التقدّم في السنّ
بعد أن بلغتُ الحادية عشر

150
00:10:57,590 --> 00:11:01,550
قيل للناس بأنّ كلوي دابشير قد مرِضَتْ وماتت

151
00:11:01,550 --> 00:11:06,090
منذ ذلك اليوم، مصّاصة الدّماء دابشير قد أخفيَتْ

152
00:11:06,090 --> 00:11:10,180
،في قلعتنا الكائنة في أعماق الجبال

153
00:11:10,180 --> 00:11:17,150
جمعَ أبي سحَرة مشهورين وخيميائيّين لدراسة صياغة العالم

154
00:11:17,150 --> 00:11:23,360
لا تقلقي. ستكون الأمور بخير يا كلوي

155
00:11:23,360 --> 00:11:28,700
سأجعلكِ بشريّة ثانية

156
00:11:34,580 --> 00:11:37,880
...اجعلوا كلوي دابشير بشريّة ثانية

157
00:11:37,880 --> 00:11:45,010
تحوّلت وصيّة أبي الأخيرة تدريجيّاً مع مرور الوقت

158
00:11:45,010 --> 00:11:47,640
فكّ ألغاز صياغة العالم

159
00:11:47,640 --> 00:11:51,760
والعبث بالأشياء الّتي كانت بقدرة الربّ فقط

160
00:11:51,760 --> 00:11:55,440
أصبحَتْ أمنية عائلة دابشير المُلحّة

161
00:11:55,440 --> 00:11:58,100
كنتُ شاهدة على كلّ ذلك

162
00:11:58,100 --> 00:12:00,570
راقبتُهم

163
00:12:00,570 --> 00:12:03,740
عايشتُ أجيال دابشير جيلاً بعد جيل

164
00:12:05,360 --> 00:12:10,120
أنتِ كلوي دابشير الأسطوريّة إذاً

165
00:12:10,120 --> 00:12:12,830
أنت مصّاص دماء، أليس كذلك؟

166
00:12:14,120 --> 00:12:15,290
،في عصرنا هذا

167
00:12:15,290 --> 00:12:20,630
ينبغي ألّا تدعي هذه الكلمة تخرج من
فمكِ بهذه السّهولة أيّتها الآنسة الصّغيرة

168
00:12:20,630 --> 00:12:21,790
سامحيني

169
00:12:21,790 --> 00:12:28,130
لم تعودي في السنّ الّذي تلائمكِ
فيه كلمة "آنسة"... يا سيّدة

170
00:12:29,640 --> 00:12:31,850
عرّف عن نفسه باسم أوغاست

171
00:12:31,850 --> 00:12:36,730
لم ألتقِ مصّاص دماء آخر من قبل

172
00:12:36,730 --> 00:12:39,900
العنصر الأساسي في البحث حول صياغة العالم

173
00:12:39,900 --> 00:12:43,610
هو ما يجب استعماله كوسيط للعبث بها

174
00:12:43,610 --> 00:12:47,110
اختارت عائلة دابشير الصّوت كوسيط

175
00:12:47,110 --> 00:12:48,200
هكذا إذاً

176
00:12:48,200 --> 00:12:50,530
أتيت من دون معرفة ذلك حتّى؟

177
00:12:50,530 --> 00:12:54,580
ألا يعرف جهلك حدوداً يا فتى؟

178
00:12:56,410 --> 00:13:01,420
سامحني. هل كان من الوقاحة ألّا أناديك بـ"سيّد"؟

179
00:13:03,880 --> 00:13:05,380
!أحسنتِ يا كلوي

180
00:13:05,380 --> 00:13:08,050
!أعتقد سنكون صديقين حميمين

181
00:13:08,050 --> 00:13:09,050
صديقان؟

182
00:13:09,050 --> 00:13:14,510
إذا كان مُحرّك التّعديل الّذي يُعيد
،صياغة العالم مُمكناً حقّاً

183
00:13:14,510 --> 00:13:18,640
بمقدورنا تحويل هذا العالم إلى مستقبل مشرق

184
00:13:18,640 --> 00:13:20,600
العالم؟

185
00:13:22,650 --> 00:13:27,440
هذه القلعة وجبال جيفودان المُحيطة بها
كانت عالمي

186
00:13:27,440 --> 00:13:33,450
لم أعرف عالماً وراء ذلك ولم أفكّر في الأمر

187
00:13:34,950 --> 00:13:36,620
،خارج هذه الجدران

188
00:13:36,620 --> 00:13:41,830
مصّاصو الدّماء حبيسون في صراع عنيف
مع البشر، أو ينبغي أن أقول، الكنيسة

189
00:13:41,830 --> 00:13:44,960
في كلّ أنحاء الأرض، يتمّ اصطياد مصّاصي الدّماء

190
00:13:44,960 --> 00:13:50,380
حتّى البشر يُعذَّبون حتّى الموت بمجرّد شكوك

191
00:13:50,380 --> 00:13:55,720
في نظر الكنيسة، مصّاصو الدّماء هم مخلوقات
مقيتة لا تستحقّ سوى الموت

192
00:13:55,720 --> 00:14:00,810
في أيّ صفّ أنت، مصّاصي الدّماء أم البشر؟

193
00:14:00,810 --> 00:14:03,650
لستُ في صفّ أحد

194
00:14:03,650 --> 00:14:05,730
اسمعيني يا كلوي

195
00:14:05,730 --> 00:14:10,150
أنا مولع بمصّاصي الدّماء مثلما مولع بالبشر

196
00:14:10,150 --> 00:14:14,450
لهذا أسعى لإنهاء الصّراع بينهما مهما كلّف الأمر

197
00:14:14,450 --> 00:14:16,950
هذه هي جُلّ أمنيتي

198
00:14:20,040 --> 00:14:23,000
أفصح عن مشاعره بأسلوبه الخاصّ

199
00:14:23,000 --> 00:14:25,710
أحسده على ذلك

200
00:14:25,710 --> 00:14:27,750
،مع الوقت، رحلَ صديقي

201
00:14:27,750 --> 00:14:32,470
ووجدتُ نفسي أنتظر عودته بلهفة

202
00:14:32,470 --> 00:14:35,970
!اسمي جان! سررتُ بلقائك

203
00:14:35,970 --> 00:14:40,060
ثمّة اجتماع أودّ حضوره مع والدَي هذه الطفلة

204
00:14:40,060 --> 00:14:42,980
حبّذا لو ترعينها في الوقت الحالي

205
00:14:46,810 --> 00:14:48,480
!توقّفي عن ذلك يا جان

206
00:14:48,480 --> 00:14:50,940
عودي. يجب ألّا نكون في الخارج

207
00:14:50,940 --> 00:14:54,490
رصدتُ أروع مكان من نافذتي

208
00:14:54,490 --> 00:14:57,030
!لنذهب معاً يا كلوي

209
00:15:01,250 --> 00:15:04,120
لا، انتظري

210
00:15:19,640 --> 00:15:22,230
!جان؟! أين أنتِ؟

211
00:15:26,600 --> 00:15:28,310
!أمسكتُ بكِ

212
00:15:51,880 --> 00:15:54,840
كانت أوّل مرّة أتجاهل فيها أمر أبي

213
00:15:54,840 --> 00:15:58,590
وعانقتني روائح الأرض والرّياح والزهور

214
00:15:58,590 --> 00:16:03,390
كانت أوّل مرّة أرى فيها السّماء الواسعة
الزرقاء الجميلة

215
00:16:03,390 --> 00:16:07,690
كان كلّ شيء في ذلك اليوم جديداً كلّياً

216
00:16:13,280 --> 00:16:18,200
سأتطلّع قدماً لليوم الّذي أراكِ فيه ناضجة يا جان

217
00:16:26,790 --> 00:16:32,000
كان أوغاست من أعاد جان إلى والديها

218
00:16:32,000 --> 00:16:34,670
لم أسمع عنها شيئاً منذ ذلك الحين

219
00:16:38,800 --> 00:16:42,140
،قلقتُ من أن يكون مكروه قد أصابها

220
00:16:42,140 --> 00:16:45,600
لكن لم أستطع الذّهاب لرؤيتها

221
00:16:47,600 --> 00:16:50,860
لا أستطيع التخلّي عن عائلتي

222
00:16:50,860 --> 00:16:55,110
رغم أنّ الجنس البشريّ قد يتخلّى عنكِ؟

223
00:16:58,950 --> 00:17:00,570
كلوي

224
00:17:03,490 --> 00:17:05,160
!أوغاست

225
00:17:08,870 --> 00:17:11,750
كلوي، ما أخبار بحثكِ؟

226
00:17:11,750 --> 00:17:12,710
ماذا؟

227
00:17:12,710 --> 00:17:16,130
هل اكتمل مُحرّك التّعديل؟

228
00:17:18,220 --> 00:17:21,140
كنتُ مخطئاً

229
00:17:21,140 --> 00:17:24,140
اعتقدتُ أنّه يمكن التّفاهم معهم

230
00:17:24,140 --> 00:17:29,100
لكن اتّضح عكس ذلك. كنتُ مخطئاً من البداية

231
00:17:29,100 --> 00:17:32,690
لذلك، يجب أن أصحّح الأمور

232
00:17:32,690 --> 00:17:37,530
!لكن لكي أفعل ذلك يا كلوي، سأحتاج لبحث دابشير

233
00:17:39,200 --> 00:17:40,820
لا

234
00:17:40,820 --> 00:17:43,910
لا يمكنك الحصول عليه يا أوغاست

235
00:17:54,040 --> 00:17:56,670
!لـ-لا، توقّف

236
00:17:56,670 --> 00:17:59,800
!لا تفعل هذا يا أوغاست

237
00:18:03,430 --> 00:18:05,260
أقسمي لي

238
00:18:05,260 --> 00:18:13,400
،أقسمي بأنّكِ ستستخدمين قوّتكِ هذه
معرفة دابشير، كما آمركِ

239
00:18:17,650 --> 00:18:20,280
!ارحل من هنا يا أوغاست

240
00:18:20,280 --> 00:18:24,700
علّق كلّ كبير من كبار عائلة دابشير
أمله على هذا البحث

241
00:18:24,700 --> 00:18:28,240
!إنّه سبب بقائي هنا حرفيّاً

242
00:18:40,420 --> 00:18:43,880
...كلوي، أنا

243
00:18:48,510 --> 00:18:55,060
كان ذلك عندما خسرتُ أوّل صديق لي للأبد

244
00:18:56,110 --> 00:19:01,030
لأتلقّى لاحقاً رسالة من شخص يدّعي
بأنّه صديق أوغاست

245
00:19:01,030 --> 00:19:06,450
كان ذلك عندما علمتُ أنّ الحرب بين
البشر ومصّاصي الدّماء قد انتهت

246
00:19:06,450 --> 00:19:10,540
جاء في الرّسالة أنّ العقل المُدبّر
للسلام كان أوغاست

247
00:19:10,540 --> 00:19:14,580
كان قد فعل المستحيل ليشقّ طريقه
ويصعد إلى مجلس الشّيوخ

248
00:19:14,580 --> 00:19:19,000
يبدو أنّك حقّقت أمنيتك الأسمى يا أوغاست

249
00:19:19,000 --> 00:19:25,180
ثمّ استمررتُ في بحثي وحيداً، عقداً تلو العقد

250
00:19:31,220 --> 00:19:34,230
أتساءل ما إن كانت جان بخير

251
00:19:35,480 --> 00:19:38,440
لن ينفع هذا. يجب ألّا أبقى مستلقية هنا

252
00:19:38,440 --> 00:19:41,940
يجب أن أستكمل محرّك التّعديل قريباً

253
00:19:41,940 --> 00:19:44,820
رغم ذلك، ما الغاية؟

254
00:19:44,820 --> 00:19:46,240
لماذا أفعل هذا؟

255
00:19:46,240 --> 00:19:48,740
أنتِ وحيدة، أليس كذلك؟

256
00:19:48,740 --> 00:19:50,950
أنتِ وحيدة لدرجة لا يسعكِ فعل شيء

257
00:19:50,950 --> 00:19:53,660
ومستعدّة لفعل أيّ شيء لتجنّب ذلك

258
00:19:53,660 --> 00:19:58,420
كان سيكون أفضل لو لم تعرفي العالم الخارجيّ

259
00:19:58,420 --> 00:20:00,670
أو السّماء الزرقاء الجميلة

260
00:20:00,670 --> 00:20:05,880
بهذا الشّكل، ما كنتِ لتعرفي كم أنتِ وحيدة حقّاً

261
00:20:05,880 --> 00:20:08,180
لا بدّ أنّكِ أدركتِ ذلك الآن

262
00:20:08,180 --> 00:20:11,810
جيفودان هو قفص يحبسكِ بعيداً

263
00:20:11,810 --> 00:20:14,810
يجب أن تدمّريه إذا كنتِ ترجين إنهاء عزلتكِ

264
00:20:14,810 --> 00:20:15,640
توقّف

265
00:20:15,640 --> 00:20:17,900
كشّري عن أنيابكِ، لا أجنحتكِ -

266
00:20:17,900 --> 00:20:18,560
توقّف -
كشّري عن أنيابكِ، لا أجنحتكِ -

267
00:20:18,560 --> 00:20:20,980
توقّف -
لا تكوني طائرة صغيرة -

268
00:20:20,980 --> 00:20:22,820
كوني وحشاً

269
00:20:22,820 --> 00:20:24,490
!يكفي

270
00:20:28,410 --> 00:20:30,160
جان؟

271
00:20:36,540 --> 00:20:39,790
"أجل، هذا صحيح. بالقرب من "ليس هوباكس

272
00:20:39,790 --> 00:20:42,420
سمعتُ أنّ عذراء صغيرة قد قُتِلَت

273
00:20:42,420 --> 00:20:45,920
قالوا أنّ اسمها جان

274
00:20:45,920 --> 00:20:51,640
التُهِمَتْ أحشاؤها، ربّما بواسطة ذئب أو وحش ما

275
00:20:54,600 --> 00:20:58,940
لا، كان ذلك مجرّد كابوس

276
00:20:59,980 --> 00:21:02,060
أيُّهما هو الكابوس؟

277
00:21:02,060 --> 00:21:05,610
أنا أم العالم الّذي تعيشين فيه؟

278
00:21:08,530 --> 00:21:13,450
كلوي الصّغيرة المسكينة، ما هي أمنيتكِ؟

279
00:21:13,450 --> 00:21:16,910
كلوي الصّغيرة المسكينة، ماذا تريدين أن تفعلي؟

280
00:21:16,910 --> 00:21:17,580
يكفي -

281
00:21:17,580 --> 00:21:18,960
أخبريني -
يكفي -

282
00:21:18,960 --> 00:21:20,670
يكفي

283
00:21:20,670 --> 00:21:22,710
ما هي أمنيتكِ الحقيقيّة؟

284
00:21:22,710 --> 00:21:24,800
!يكفي

285
00:21:26,590 --> 00:21:29,630
أخيراً، حان الوقت

286
00:21:29,630 --> 00:21:33,390
ستتحقّق أمنيتي أخيراً

287
00:21:44,940 --> 00:21:50,570
هكذا إذاً، ستخضعين لهذا فعلاً إذاً يا كلوي؟

288
00:21:52,870 --> 00:21:55,370
!ما هذا الضّوء بالتّحديد؟

289
00:21:55,370 --> 00:21:59,040
أصبحتِ معي الآن يا كلوي دابشير

290
00:22:00,830 --> 00:22:05,130
"مصّاصة دماء عائلة دابشير"

291
00:23:36,840 --> 00:23:40,060
"الوحش