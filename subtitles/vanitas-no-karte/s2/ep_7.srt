1
00:00:02,220 --> 00:00:05,850
لا تعتقدي بأنّني سأكون سعيداً من دونكِ

2
00:00:05,850 --> 00:00:08,650
لا ترحلي. لا تتركيني

3
00:00:08,650 --> 00:00:10,230
أرجوكِ

4
00:00:11,230 --> 00:00:14,740
أتوسّل إليكِ يا كلوي

5
00:00:18,110 --> 00:00:21,830
!لا تتركيني وحيداً

6
00:00:47,310 --> 00:00:52,400
الماغاتسونا... مسرح الجليد والثّلج، ميلّي

7
00:00:58,570 --> 00:01:01,070
أولئك المُصابون بهذه العلّة

8
00:01:01,070 --> 00:01:07,620
يُحبَسون في عالم مُغلق، سجن متجمّد من ذكرياتهم

9
00:01:07,620 --> 00:01:11,790
العرض المتكرّر اللّانهائي الّذي يُؤدَّى هناك

10
00:01:11,790 --> 00:01:16,090
بصورة بطيئة لكن يدمّر روحهم

11
00:01:16,090 --> 00:01:19,720
هذا الماغاتسونا صعب المراس

12
00:01:19,720 --> 00:01:25,260
لأنّك لا تستطيع التّعامل معه بمجرّد أداء عمليّة عكسيّة

13
00:01:25,260 --> 00:01:29,230
،ما لم يرفض حامل اللّعنة بذاته عالمه المُتجمّد

14
00:01:29,230 --> 00:01:32,770
،سيبقى مرتبطاً بشكل وثيق به حتّى يزول هذا العالم

15
00:01:32,770 --> 00:01:36,650
بالتالي يمحوه من الوجود

16
00:01:36,650 --> 00:01:38,240
!كلوي دابشير

17
00:01:38,240 --> 00:01:42,570
يمكنكِ أن تختفي مع هذا العالم أو أن
تستمرّي في عيش حياتكِ الكئيبة

18
00:01:42,570 --> 00:01:44,990
!الخيار خياركِ

19
00:01:44,990 --> 00:01:49,250
حتّى لو نجوتِ من هذا، لن تستعيدي سمعتكِ الحسنة

20
00:01:49,250 --> 00:01:52,330
لن تعترف الكنيسة بحقيقة الماضي

21
00:01:52,330 --> 00:01:54,750
وستظلّ تلاحقكِ وتصطادكِ بصفتكِ الوحش

22
00:01:54,750 --> 00:01:55,590
!هذا يكفي

23
00:01:55,590 --> 00:01:57,460
!سيكون جحيماً في كلتا الحالتين

24
00:01:57,460 --> 00:02:00,420
!لكن يجب أن تختاري

25
00:02:04,180 --> 00:02:06,680
جان-جاكو؟

26
00:02:11,100 --> 00:02:12,600
...ما الّذي

27
00:02:12,600 --> 00:02:15,860
ما الّذي اقترفتْه يدايّ؟

28
00:02:24,610 --> 00:02:26,740
!جان، اذهب

29
00:02:28,200 --> 00:02:31,830
ليتني أستطيع الرّجوع بالوقت

30
00:02:33,500 --> 00:02:38,590
ليتني لم أتردّد ومددتُ يدي لك لإنقاذكِ

31
00:04:02,210 --> 00:04:07,380
"دراسة حالة فانيتاس"

32
00:04:18,480 --> 00:04:25,150
رولاند، قد ألحق الضرر قريباً بأحد إخوانك

33
00:04:25,150 --> 00:04:29,110
أتقصد الشّخص المعروف أستولفو؟

34
00:04:30,990 --> 00:04:32,620
هكذا إذاً

35
00:04:32,620 --> 00:04:35,080
إنّه هناك في الأعلى الآن

36
00:04:36,200 --> 00:04:39,170
ذُبِحت عائلة أستولفو بأكملها بواسطة مصّاصي دماء

37
00:04:39,170 --> 00:04:40,580
!يكفي

38
00:04:41,960 --> 00:04:43,170
أنا آسف

39
00:04:43,170 --> 00:04:46,800
لن أطلب منك عدم مقاتلته

40
00:04:46,800 --> 00:04:49,630
لا أعرف لماذا أخبرتُك بهذا

41
00:04:49,630 --> 00:04:54,470
أفترض أنّني أردتُك أن تعرف فحسب

42
00:04:54,470 --> 00:04:58,690
كان ذلك الفتى اليافع لطيفاً جدّاً

43
00:05:00,650 --> 00:05:02,270
!فلتمُت

44
00:05:02,270 --> 00:05:05,730
!يجب على كافّة مصّاصي الدّماء أن يموتوا

45
00:05:08,570 --> 00:05:11,320
!حقنَ نفسه زيادة عن اللّزوم

46
00:05:11,320 --> 00:05:13,490
!توقّف عن هذا من فضلك يا قائد

47
00:05:13,490 --> 00:05:16,370
!لا يستطيع جسدك تحمّل المزيد

48
00:05:16,370 --> 00:05:19,120
!يا للهول! نالَ منّي هذه المرّة

49
00:05:25,960 --> 00:05:27,880
والآن ماذا؟! هل ينبغي أن أتراجع؟

50
00:05:27,880 --> 00:05:29,720
لا تتردّد يا نوي

51
00:05:29,720 --> 00:05:34,140
لا تفكّر فيما إذا كان حقد أستولفو مُبرَّراً أم لا

52
00:05:34,140 --> 00:05:39,180
فالبشر ومصّاصو الدّماء على حدّ سواء يتصرّفون
بناء على ما يشعرون بأنّه الحقّ

53
00:05:39,180 --> 00:05:42,770
فعدالة شخص قد تكون ظلماً بالنسبة لآخر

54
00:05:42,770 --> 00:05:45,730
في حالتك، الحقّ هو ما يصنع القوّة

55
00:05:45,730 --> 00:05:51,740
لكن مثل هذه القوّة قد تتحوّل بسهولة
إلى عنف أكثر إزعاجاً من الكراهية

56
00:05:51,740 --> 00:05:54,780
لا تحملها وأنت غاضب. أبقِها في أعماقك

57
00:05:54,780 --> 00:06:01,330
فليكُن حسّ العدالة النّور السّاطع
الّذي يهديك إلى الطريق الصّحيح

58
00:06:07,500 --> 00:06:10,470
!معنى هذا لا تنهمك كثيراً في التفكير

59
00:06:10,470 --> 00:06:15,220
تصرّف وفقاً لما ترغبه نفسك، ليس
بما تشعر بأنّه الصّواب

60
00:06:18,010 --> 00:06:21,810
سينفعك هذا جيّداً على الأقلّ

61
00:06:23,440 --> 00:06:26,190
!لن أتراجع مهما حدث

62
00:06:26,190 --> 00:06:28,690
!سأمزّقك إرباً

63
00:06:41,410 --> 00:06:44,120
أريد إنقاذ كلوي وجان-جاكو

64
00:06:44,120 --> 00:06:47,540
!هذا كلّ ما أريد، كائناً من كان خصمي

65
00:06:47,540 --> 00:06:49,800
!لن أستسلم أبداً

66
00:06:57,970 --> 00:07:00,640
!مرحى

67
00:07:04,600 --> 00:07:07,980
!مولايّ الصّغير

68
00:07:11,820 --> 00:07:16,950
،أردتُ أن أكون بشريّة من جديد

69
00:07:16,950 --> 00:07:21,620
فهذا ما تمنّاه أبي

70
00:07:21,620 --> 00:07:25,250
كرّس أبي حياته

71
00:07:25,250 --> 00:07:30,170
في البحث حول كيفيّة إعادتي إلى شكل بشريّ

72
00:07:30,170 --> 00:07:33,010
كان ذلك مُبهِجاً بالنسبة لي

73
00:07:33,010 --> 00:07:38,550
...كان كلّ ذلك تعبيراً عن حبّه لي، و

74
00:07:38,550 --> 00:07:41,390
كان كذبة...

75
00:07:41,390 --> 00:07:44,890
الحقيقة هي أنّني كنتُ وحيدة دوماً

76
00:07:44,890 --> 00:07:52,690
فأساساً، بما أنّني لم أكن بشريّة، فهذا
يعني أنّني لم أكن أنا فعليّاً

77
00:07:52,690 --> 00:07:57,320
!المُحرّك مُنهك تماماً! لا يستطيع الحفاظ على وجودها

78
00:07:59,950 --> 00:08:02,950
!لا وقت لعمليّة عكسيّة

79
00:08:02,950 --> 00:08:05,330
أردتُ أن يتمّ قبولي

80
00:08:05,330 --> 00:08:07,500
،كابنة لأبيها

81
00:08:07,500 --> 00:08:10,540
،كفرد من عائلة دابشير

82
00:08:10,540 --> 00:08:12,960
كما أنا فعليّاً

83
00:08:17,760 --> 00:08:19,680
!كلوي

84
00:08:19,680 --> 00:08:22,060
أردتُ أن أكون محبوبة

85
00:08:22,060 --> 00:08:25,350
على ماهيّتي الحقيقيّة

86
00:08:25,350 --> 00:08:27,270
!يجب أن تختاري

87
00:08:38,280 --> 00:08:39,530
!اللّعنة

88
00:08:39,530 --> 00:08:42,700
مدّني بقوّتك يا لونا

89
00:09:13,650 --> 00:09:17,690
يبدو أنّ السّماوات زرقاء ومُرصّعة بالنجوم

90
00:09:20,740 --> 00:09:24,830
الآن قد فهمت. هذا هو اسمك الحقيقيّ

91
00:09:25,910 --> 00:09:31,000
من تصنع الموسيقى بزهور الثلج"، كانوراس"

92
00:09:50,690 --> 00:09:53,860
ماذا حدث؟ لم يعد هناك برد

93
00:09:53,860 --> 00:09:55,610
ثلج؟

94
00:09:55,610 --> 00:09:59,110
لا، إنّها بتلات زهرة

95
00:10:02,110 --> 00:10:05,830
هل هذا يعني أنّ الأمر انتهى؟

96
00:10:05,830 --> 00:10:09,290
أحسنتما صنعاً

97
00:10:36,560 --> 00:10:38,940
!هذا... مؤلم

98
00:10:38,940 --> 00:10:42,400
!الألم أسوأ بكثير ممّا ظننت! أسوأ بـ 15 مرّة

99
00:10:42,400 --> 00:10:46,280
!وجدتُها! وجدتُ يدك

100
00:10:46,280 --> 00:10:47,950
هل أنت بخير؟

101
00:10:47,950 --> 00:10:50,660
لا. أظنّني سأبكي

102
00:10:50,660 --> 00:10:54,080
أتظنّ أنّنا نستطيع إعادة وصلها؟

103
00:10:54,080 --> 00:10:57,960
ربّما، فهي لم تحترق وتصبح رماداً

104
00:10:57,960 --> 00:11:01,460
قد يفلح ذلك... وقد لا يفلح. لا أدري

105
00:11:02,720 --> 00:11:07,220
من أين أتت كلّ تلك الزهور النجميّة؟

106
00:11:07,220 --> 00:11:08,890
ألم تسمع؟

107
00:11:08,890 --> 00:11:11,390
قيل بأنّها تتفتّح في المناطق

108
00:11:11,390 --> 00:11:14,190
التي عُبِثَ فيها بصياغة العالم

109
00:11:14,190 --> 00:11:16,900
لكن لستُ متأكّداً من صحّة ذلك

110
00:11:18,190 --> 00:11:21,070
!لا بدّ أنك تمازحني

111
00:11:24,400 --> 00:11:27,660
...أقتل

112
00:11:27,660 --> 00:11:33,410
يجب أن أقتل كلّ مصّاص دماء

113
00:11:33,410 --> 00:11:35,290
يجب أن أقتلهم

114
00:11:35,290 --> 00:11:37,130
أستولفو

115
00:12:15,460 --> 00:12:17,330
أ-أنجدني

116
00:12:17,330 --> 00:12:22,710
أرجوك... يا سيّدي

117
00:12:22,710 --> 00:12:24,710
أتوسّل إليك

118
00:12:24,710 --> 00:12:29,220
أنقذ أختي أرجوك

119
00:12:29,220 --> 00:12:33,850
لا أكترث لما يحدث لي

120
00:12:35,350 --> 00:12:39,850
...أنا المُلام. كلّ هذا

121
00:12:39,850 --> 00:12:42,360
غلطتي...

122
00:12:45,570 --> 00:12:50,240
انتهى الأمر الآن يا أستولفو

123
00:12:50,240 --> 00:12:52,330
تعال معي

124
00:12:53,950 --> 00:12:58,540
القائد. مولايّ الصّغير أستولفو

125
00:13:10,050 --> 00:13:12,930
!كلوي! هل أنتِ بخير؟

126
00:13:12,930 --> 00:13:16,520
كيف تشعرين؟ هل هناك مشكلة؟

127
00:13:18,060 --> 00:13:19,940
!كلوي

128
00:13:24,110 --> 00:13:28,400
أحمق! لم أسمح لك أن تُضرَب ويمتلئ
وجهك بالكدمات هكذا

129
00:13:28,400 --> 00:13:31,070
!ماذا لو تعرّضت للقتل؟

130
00:13:31,070 --> 00:13:33,830
!ماذا؟! أوجّه نفس الكلام إليكِ

131
00:13:33,830 --> 00:13:36,740
!خطّطتِ للموت دون إخباري حتّى

132
00:13:36,740 --> 00:13:39,830
!ألم تفكّري بمشاعري كيف ستكون إذا تُرِكتُ وحيداً؟

133
00:13:39,830 --> 00:13:43,630
!هذا يكفي! كيف تجرؤ على الردّ في وجهي؟

134
00:13:43,630 --> 00:13:45,550
!أكرهك يا جان-جاكو

135
00:13:45,550 --> 00:13:46,460
كلوي

136
00:13:46,460 --> 00:13:47,840
!أحمق. أحمق

137
00:13:47,840 --> 00:13:49,920
!أيّها الأحمق

138
00:14:37,850 --> 00:14:39,180
!كلوي؟

139
00:14:39,180 --> 00:14:41,180
أقسمتُ ألّا أبكي

140
00:14:41,180 --> 00:14:44,400
،عندما قرّرتُ الثأر من ذلك الكابوس

141
00:14:44,400 --> 00:14:47,940
...أقسمتُ ألّا أبكي بعدها، لكن

142
00:14:47,940 --> 00:14:50,030
يا لي من حمقاء، ألستُ كذلك؟

143
00:14:50,030 --> 00:14:53,610
...جان، ذلك اليوم الّذي حدّقتُ فيه للسماء معك

144
00:14:53,610 --> 00:14:58,910
،فكّرتُ حقّاً بأنّني إذا كنتُ سأموت
فحبّذا أن يكون في ذلك اليوم

145
00:14:58,910 --> 00:15:01,040
...لكن الآن

146
00:15:03,160 --> 00:15:05,960
أريد أن أعيش

147
00:15:05,960 --> 00:15:09,420
هذا ما أتمنّاه الآن

148
00:15:11,510 --> 00:15:16,840
هل كنتُ ظالمة؟ هل كنتُ فظيعة؟

149
00:15:19,680 --> 00:15:25,230
ما المانع؟ لا أمانع أن تكون ظالمة

150
00:15:25,230 --> 00:15:29,610
لنعش كِلانا معاً يا كلوي

151
00:15:29,610 --> 00:15:36,610
لا أحتاج شيئاً غير وجودكِ معي

152
00:15:44,250 --> 00:15:45,710
فانيتاس

153
00:15:45,710 --> 00:15:47,460
!أين هو؟

154
00:15:59,680 --> 00:16:02,350
إنّه ينتشر بشكل واسع

155
00:16:11,860 --> 00:16:14,360
البرد قارس

156
00:16:15,570 --> 00:16:16,820
!فانيتاس

157
00:16:16,820 --> 00:16:18,110
!جان

158
00:16:18,110 --> 00:16:19,820
هل أنتِ بخير؟

159
00:16:20,910 --> 00:16:24,250
!شكراً لك يا فانيتاس! شكراً لك

160
00:16:24,250 --> 00:16:27,210
!نجت كلوي! أنقذتَها حقّاً

161
00:16:27,210 --> 00:16:28,580
!شكراً لك

162
00:16:28,580 --> 00:16:32,130
ما زال الوقت مبكّراً على عِناق الانتصار

163
00:16:32,130 --> 00:16:34,630
لا أعرف ما الّذي يخطّط له السيّد روثفين

164
00:16:34,630 --> 00:16:38,760
لكن أشكّ في أن يدع مجلسُ الشّيوخ
كلوي دابشير وشأنها

165
00:16:38,760 --> 00:16:42,390
وستتلقّين غالباً عقوبة ما

166
00:16:42,390 --> 00:16:44,140
!أعي ذلك تماماً

167
00:16:44,140 --> 00:16:47,310
!لكن ما زلتُ سعيدة! لدرجة يائسة

168
00:16:47,310 --> 00:16:48,190
...حسناً

169
00:16:48,190 --> 00:16:49,650
!هل بيدي حيلة؟

170
00:16:49,650 --> 00:16:51,110
آسف

171
00:16:51,110 --> 00:16:54,690
...فانيتاس، بفضلك

172
00:16:54,690 --> 00:16:57,320
...لأنّك كنت معي

173
00:16:57,320 --> 00:16:58,860
...أنا

174
00:17:15,670 --> 00:17:19,550
لحظة يا جان! ماذا أصابكِ؟

175
00:17:39,530 --> 00:17:43,950
و-وهبتُ دمي لك

176
00:17:43,950 --> 00:17:48,330
لكن هناك زمان ومكان لكلّ شيء

177
00:18:07,470 --> 00:18:11,350
لا تنسَ وعدك يا فانيتاس

178
00:18:11,350 --> 00:18:13,810
إذا أتى اليوم الّذي

179
00:18:13,810 --> 00:18:17,610
...لا أكون فيه نفسي

180
00:18:23,860 --> 00:18:26,490
،إذا حدث ذلك

181
00:18:26,490 --> 00:18:29,500
يجب أن تقتلني، مفهوم؟

182
00:18:39,510 --> 00:18:41,260
!جان

183
00:19:04,820 --> 00:19:07,320
اسمعني

184
00:19:07,320 --> 00:19:10,200
الجميع وحيدون

185
00:19:10,200 --> 00:19:15,170
هذا لا يغيّر من كونك بشريّاً أو مصّاص دماء

186
00:19:15,170 --> 00:19:19,170
لن تتمكّن من فهم شخص بشكل كامل أبداً

187
00:19:19,170 --> 00:19:25,760
يعيش معظم الناس ويموتون دون فهم أنفسهم حتّى

188
00:19:25,760 --> 00:19:29,180
برغم ذلك، هذا هو السّبب عينه الّذي

189
00:19:29,180 --> 00:19:33,930
يجعل النّاس يتقاربون من بعضهم الآخر
لمشاركة دفء رابط عاطفيّ

190
00:19:37,230 --> 00:19:42,570
،يوماً ما، عندما لا أعود أمشي في هذه الأرض

191
00:19:42,570 --> 00:19:48,280
عسى أن تجد شخصاً تحضنه كما نحن الآن

192
00:19:48,280 --> 00:19:53,410
...أو بالأحرى، أن على يقين بأنّك ستجد شخصاً كهذا

193
00:19:53,410 --> 00:19:58,330
ما دمت لا توصد قلبك...

194
00:20:03,050 --> 00:20:08,430
،افتح قلبك، ولن تشعر بالوحشة أبداً حتّى لو كنت بمفردك

195
00:20:08,430 --> 00:20:14,140
مثلما أنتما هنا لأجلي

196
00:20:14,140 --> 00:20:16,980
!فانيتاس

197
00:20:16,980 --> 00:20:20,400
المعذرة، هل أنت بخير؟

198
00:20:23,570 --> 00:20:25,400
،لطالما اشتكيتَ من البرد

199
00:20:25,400 --> 00:20:31,700
لكن يوماً ما وبكلّ تأكيد، سوف تلتقي
بشخص يُبقيك دافئاً

200
00:20:37,080 --> 00:20:38,960
هل أنت متأكّد من هذا؟

201
00:20:38,960 --> 00:20:45,420
أجل. لطالما أردتُ القوّة لحماية كلوي

202
00:20:45,420 --> 00:20:50,470
،لكن إذا كان هذا سيؤذيها

203
00:20:50,470 --> 00:20:53,140
فلم أعد بحاجة هذه القوّة

204
00:20:53,140 --> 00:20:56,560
أنا بحدّ ذاتي يجب أن أكون كافياً

205
00:20:56,560 --> 00:21:01,610
!أنا، جان-جاكو تشاستيل، سوف أحميها

206
00:21:09,990 --> 00:21:12,070
حسناً إذاً

207
00:21:20,750 --> 00:21:25,300
هكذا إذاً، اسمك الحقيقيّ يلائمك كثيراً

208
00:21:28,090 --> 00:21:33,470
ذلك الّذي يستكين للثلج الأخير"، أبريكس"

209
00:21:38,930 --> 00:21:44,570
إذاً تحرّرت جيفودان من لعنة الوحش أخيراً

210
00:21:45,820 --> 00:21:47,860
نجا البعض

211
00:21:47,860 --> 00:21:50,200
بينما لم ينجُ البعض الآخر

212
00:21:50,200 --> 00:21:52,280
!هذه هي

213
00:21:52,280 --> 00:21:56,660
لكن ستبقى النُّدَب في كلّ واحد منّا

214
00:22:00,870 --> 00:22:05,130
"زهرة الثلج"

215
00:23:36,930 --> 00:23:40,060
"المرض المُزمِن"