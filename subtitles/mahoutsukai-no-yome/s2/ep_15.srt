1
00:00:04,390 --> 00:00:06,780
!تهانينا على استعادة عافيتك

2
00:00:07,990 --> 00:00:09,450
.شكرًا على المساعدة

3
00:00:09,450 --> 00:00:11,090
كيف تشعر؟

4
00:00:11,090 --> 00:00:13,910
.أنا مسرور فقط لتمكّني من مغادرة الفراش أخيرًا

5
00:00:14,340 --> 00:00:17,510
.الجزء الأفضل هو سهولة الذّهاب للحمّام

6
00:00:17,510 --> 00:00:20,330
كيف تستعمل الحمّام؟

7
00:00:20,330 --> 00:00:21,650
.إنّه سرّ

8
00:00:21,650 --> 00:00:22,800
وأنت؟

9
00:00:22,800 --> 00:00:23,920
!إنّه سرّ

10
00:00:25,160 --> 00:00:26,560
وأنت؟

11
00:00:26,560 --> 00:00:29,080
ما هذه المحادثة بالضّبط؟

12
00:00:30,070 --> 00:00:32,330
لماذا تنظران لي؟

13
00:00:32,970 --> 00:00:34,620
...حسنًا

14
00:00:34,620 --> 00:00:35,920
هل ستعود للمنزل؟

15
00:00:35,920 --> 00:00:38,260
.الكلّيّة مغلفة حتّى وإن أردت ذلك

16
00:00:39,620 --> 00:00:43,110
لا أستطيع حتّى القيام بعملي
...في هذا الوضع، لذلك سوف

17
00:00:44,530 --> 00:00:46,670
.لديك مريضة يا ألكساندرا

18
00:00:47,680 --> 00:00:48,580
.يا إلهي

19
00:00:48,580 --> 00:00:49,980
هل أنت بخير؟

20
00:00:49,980 --> 00:00:52,740
.إنّها ليست في حالة جيّدة

21
00:00:53,070 --> 00:00:55,240
.سألقي نظرة عليها

22
00:00:55,980 --> 00:00:57,560
.سأرافقك لغرفتك

23
00:00:58,940 --> 00:01:00,930
.حسنًا، شكرًا

24
00:02:34,930 --> 00:02:37,590
.أنا متعبة من الدّراسة

25
00:02:37,590 --> 00:02:39,230
.الامتحانات الأسبوع القادم

26
00:02:40,170 --> 00:02:44,630
لازاروس، هل يمكنك القيام بحسابات التّغذية
لدرس الطّبخ وتحقّق من خياطتي؟

27
00:02:44,630 --> 00:02:45,560
.حسنًا

28
00:02:45,560 --> 00:02:47,590
!وأنا أيضًا

29
00:02:47,590 --> 00:02:48,440
!وأنا

30
00:02:48,710 --> 00:02:50,280
.وأنا كذلك عندما تنتهي

31
00:02:50,800 --> 00:02:52,310
.هذا كثير

32
00:02:52,970 --> 00:02:55,610
هل يستطيع أحد التّحقّق من
نطاق موادّ امتحان المشعوذين؟

33
00:02:55,610 --> 00:02:56,970
.لا أستطيع

34
00:02:56,970 --> 00:02:59,420
.لا أريد التّفكير بالتّاريخ الآن

35
00:02:59,420 --> 00:03:01,240
.ولا أنا

36
00:03:01,240 --> 00:03:03,690
.أنا ضائع تمامًا

37
00:03:03,690 --> 00:03:04,500
...يا لكم

38
00:03:04,870 --> 00:03:06,770
.يمكنني إلقاء نظرة إن لم تمانع

39
00:03:06,770 --> 00:03:08,170
.سيكون ذلك ممتازًا

40
00:03:08,170 --> 00:03:10,730
هل يمكنك التّحقّق من عملي أيضًا يا إسحاق؟

41
00:03:10,730 --> 00:03:11,330
.أكيد

42
00:03:12,150 --> 00:03:14,460
.لا أستطيع تذكّر أيّ شيء أقرأه

43
00:03:14,460 --> 00:03:16,250
.أعرف ما تقصد

44
00:03:16,670 --> 00:03:20,260
.إذًا فهكذا هي المجموعات الدّراسيّة

45
00:03:20,260 --> 00:03:22,630
.لا ألومك إن شعرت بالملل

46
00:03:22,630 --> 00:03:26,900
.عادة ما نذهب لنتناول الطّعام في البلدة

47
00:03:26,900 --> 00:03:28,520
.لم لا نستطيع ذلك الآن

48
00:03:28,520 --> 00:03:32,500
.صحيح، أريد الذّهاب لرؤية المتاجر الجديدة

49
00:03:32,500 --> 00:03:33,400
!أريد ملابس

50
00:03:33,730 --> 00:03:37,150
!لا بدّ أنّ القصص المصوّرة الجديدة قد صدرت

51
00:03:37,150 --> 00:03:38,940
!نسيت أنّه لا توجد تغطية

52
00:03:39,330 --> 00:03:42,200
.يبدو أنّ الجميع متوتّر

53
00:03:42,200 --> 00:03:44,170
...لسبب واضح

54
00:03:44,170 --> 00:03:46,400
.لا يوجد ما نفعله سوى الدّراسة

55
00:03:48,370 --> 00:03:51,160
...عرفتُ أنّ الجميع سيقولون هذا، لذلك

56
00:03:51,540 --> 00:03:53,780
!هل أحضرت شيئًا ما معك؟

57
00:03:55,310 --> 00:03:57,070
.نعم، تفضّلوا

58
00:03:57,070 --> 00:03:58,540
ما هذه؟

59
00:03:58,540 --> 00:03:59,800
أحاجي؟

60
00:04:00,960 --> 00:04:02,340
ألا تعرفان؟

61
00:04:02,860 --> 00:04:05,840
.إنّها لعبة لتدريب المشعوذين

62
00:04:06,750 --> 00:04:09,430
،توضع تعويذة بسيطة على الأحجية

63
00:04:09,870 --> 00:04:13,280
.ثمّ نتسابق لرؤية من يحلّها أوّلاً

64
00:04:14,470 --> 00:04:17,910
إنّها تختبر مهاراتنا التّحليليّة
.والقدرة على التّلاعب بالقوّة السّحريّة

65
00:04:18,260 --> 00:04:20,270
.يبدو هذا ممتعًا

66
00:04:20,270 --> 00:04:21,740
القوّة السّحريّة؟

67
00:04:21,740 --> 00:04:23,790
.لا أعتقد أنّ بإمكاني القيام بهذا

68
00:04:23,790 --> 00:04:26,490
أليس لديك تعاويذ لفتح الأقفال؟

69
00:04:26,490 --> 00:04:28,030
...لديّ ولكن

70
00:04:28,450 --> 00:04:31,040
.ربّما عليك المحاولة

71
00:04:31,040 --> 00:04:33,360
.أعتقد أنّ بإمكاننا تجربتها إن أردت

72
00:04:33,360 --> 00:04:36,290
.كما أنّي أريد رؤية سحرك ثانية

73
00:04:36,290 --> 00:04:37,830
.صحيح، أودّ رؤيته أنا أيضًا

74
00:04:39,600 --> 00:04:40,960
.حـ-حسنًا

75
00:04:41,830 --> 00:04:43,770
.لتبدأ الجولة الأولى إذًا

76
00:04:43,770 --> 00:04:45,350
من يريد إغلاقها؟

77
00:04:45,600 --> 00:04:46,780
.سأقوم أنا بذلك

78
00:04:46,780 --> 00:04:47,800
.وأنا أيضًا

79
00:04:48,310 --> 00:04:51,900
.حسنًا، روي وصوفيا... وأنا أيضًا على ما أظنّ

80
00:04:52,360 --> 00:04:54,180
.لتكن تعويذة ثلاثيّة هذه المرّة

81
00:04:57,630 --> 00:04:59,110
من يريد أن يجرّب؟

82
00:04:59,110 --> 00:04:59,940
!أنا

83
00:04:59,940 --> 00:05:00,430
.وأنا

84
00:05:00,430 --> 00:05:00,980
.أنا أيضًا

85
00:05:00,980 --> 00:05:01,850
.لا أجد مانعًا

86
00:05:02,420 --> 00:05:03,650
...حسنًا

87
00:05:05,990 --> 00:05:08,510
لم تجرّبا هذا من قبل، صحيح يا زوي وتشيسي؟

88
00:05:08,770 --> 00:05:10,300
.عليكما المحاولة أيضًا

89
00:05:11,090 --> 00:05:11,900
.حسنًا

90
00:05:12,360 --> 00:05:13,910
.شكرًا

91
00:05:17,600 --> 00:05:18,840
.حسنًا، لنبدأ

92
00:05:19,150 --> 00:05:21,800
.ثلاثة، اثنان، واحد

93
00:05:22,180 --> 00:05:23,050
!ابدؤوا

94
00:05:24,860 --> 00:05:26,590
.شكرًا على مرافقتي

95
00:05:26,980 --> 00:05:29,660
.يمكنك استدعائي إن احتجت لأيّ شيء

96
00:05:32,440 --> 00:05:35,630
هل أخبرك آخرون من قبل أنّك تبالغ في الحماية؟

97
00:05:36,570 --> 00:05:39,200
.لكنّ البشر ضعفاء جدًّا

98
00:05:40,080 --> 00:05:41,690
.لستَ مخطئًا

99
00:05:42,250 --> 00:05:47,430
سيصل إشعار إلى ألكساندرا إن كان
.هنالك أي خطب في مؤشراتي الحيويّة

100
00:05:47,430 --> 00:05:49,460
.لذلك سأكون بخير

101
00:05:50,450 --> 00:05:53,260
.خاصّة بوجود كلّ هذه الإجراءات الأمنيّة

102
00:05:54,370 --> 00:05:56,900
.لنأمل فقط ألاّ يعرف التّلاميذ الكثير

103
00:05:57,390 --> 00:05:58,370
.نعم

104
00:05:58,920 --> 00:06:01,300
.أنت على حقّ، هناك دوريّات أكثر مؤخّرًا

105
00:06:01,660 --> 00:06:03,060
.إلى اللّقاء

106
00:06:03,060 --> 00:06:03,740
.نعم

107
00:06:06,230 --> 00:06:08,330
هل تحبّ الموسيقى؟

108
00:06:08,860 --> 00:06:10,350
الموسيقى؟

109
00:06:10,350 --> 00:06:12,150
.لم أفكّر في الأمر أبدًا

110
00:06:12,150 --> 00:06:13,730
.ولم أسمع الكثير أيضًا

111
00:06:14,920 --> 00:06:16,140
.حسنًا

112
00:06:16,140 --> 00:06:20,320
.سأحاول إيجاد شيء ما من أجلك في المرّة القادمة

113
00:06:21,040 --> 00:06:22,160
.مفهوم

114
00:06:22,780 --> 00:06:23,730
.شكرًا لك

115
00:06:28,880 --> 00:06:30,910
الموسيقى؟

116
00:06:31,470 --> 00:06:35,090
أعتقد أنّني أذكر أنّ أنجليكا كانت
.تشغّل أسطوانة في الماضي

117
00:06:36,540 --> 00:06:39,730
.لا يبدو أنّ تشيسي تستمع للموسيقى

118
00:06:40,340 --> 00:06:43,280
.أتساءل أيّ نوع كم الموسيقى قد تستمع إليه

119
00:06:44,010 --> 00:06:47,320
.إنّها تحبّ معظم الأطعمة

120
00:06:47,320 --> 00:06:49,960
.لا تشتكي من أيّ شيء

121
00:06:50,300 --> 00:06:53,220
.لكنّي لا أعرف الكثير عمّا تفضّل

122
00:06:54,440 --> 00:06:57,940
.أتساءل كيف كانت قبل أن تلتقي بي

123
00:06:58,390 --> 00:06:59,940
...ربّما عليّ أن أسألها

124
00:07:02,310 --> 00:07:03,360
.ها هي ذي

125
00:07:06,080 --> 00:07:07,560
.حظًّا سعيدًا يا زوي

126
00:07:07,560 --> 00:07:09,410
.حاول الرّجوع للخلف

127
00:07:09,410 --> 00:07:10,990
.هيّا أسرع

128
00:07:14,870 --> 00:07:16,600
!انتهيت

129
00:07:17,080 --> 00:07:18,560
من الأوّل؟

130
00:07:18,560 --> 00:07:22,180
.مارتن هو الأوّل ثمّ ياسمين فبياتريس وبعدها ريان

131
00:07:22,180 --> 00:07:23,790
.أنت الأخير يا زوي

132
00:07:23,790 --> 00:07:25,430
!سُحقًا

133
00:07:25,430 --> 00:07:27,550
.هذه أوّل محاولة لك
.فلا تضغط على نفسك كثيرًا

134
00:07:27,850 --> 00:07:30,530
.لم تكوني جيّدة في أللعاب يومًا

135
00:07:30,530 --> 00:07:32,250
.رغم أنّك كنت الأولى من النّاحية التّقنيّة

136
00:07:32,540 --> 00:07:35,330
...لا أصدّق أنّ الأحجية فُتحت من تلقاء نفسها

137
00:07:35,720 --> 00:07:37,750
.السّحر مذهل

138
00:07:37,750 --> 00:07:40,310
.لكنّك وقعت في الفخ

139
00:07:42,420 --> 00:07:45,930
.وضعتُ فخًّا يتفعّل إن حاولت فتحها بالقوّة

140
00:07:45,930 --> 00:07:48,490
إلى متى سيستمرّ هذا؟

141
00:07:48,490 --> 00:07:49,440
.ليس لوقت طويل

142
00:07:49,440 --> 00:07:50,070
.شاهدي

143
00:07:52,810 --> 00:07:53,780
أرأيت؟

144
00:07:53,780 --> 00:07:55,870
ما الّذي تفعلونه جميعًا؟

145
00:07:56,960 --> 00:07:58,420
!فيرونيكا

146
00:07:59,160 --> 00:08:01,280
.نلعب ألعاب من سنتنا الأولى فحسب

147
00:08:01,280 --> 00:08:02,390
أتريدين الانضمام لنا؟

148
00:08:02,390 --> 00:08:03,540
.ربّما

149
00:08:06,430 --> 00:08:07,120
.فيلوميلا

150
00:08:11,360 --> 00:08:13,050
.لنلعب ضدّ بعضنا. فلم نفعل منذ مدّة

151
00:08:15,250 --> 00:08:16,600
...أنا

152
00:08:17,570 --> 00:08:19,030
—عفوًا، ليس عليك أن

153
00:08:19,030 --> 00:08:20,070
.لا بأس بذلك

154
00:08:20,540 --> 00:08:22,900
.أنت بارعة في هذه الأشياء

155
00:08:23,770 --> 00:08:25,600
.أودّ رؤيتك تلعبين

156
00:08:27,710 --> 00:08:30,370
...مفهوم

157
00:08:32,230 --> 00:08:33,330
.حظًّا سعيدًا

158
00:08:34,440 --> 00:08:36,680
.يا لها من مواجهة مثيرة للاهتمام

159
00:08:37,260 --> 00:08:39,370
.حسنًا، القواعد هي نفسها

160
00:08:39,370 --> 00:08:40,920
.الفائز من يحلّها أوّلاً

161
00:08:41,440 --> 00:08:42,400
...ريان

162
00:08:45,240 --> 00:08:46,920
هل سيكون هذا على ما يُرام؟

163
00:08:48,650 --> 00:08:50,680
أمستعدّان؟

164
00:08:50,680 --> 00:08:52,260
...استعداد

165
00:08:52,260 --> 00:08:53,270
!انطلاق

166
00:09:09,680 --> 00:09:11,100
!ألكيوني

167
00:09:12,310 --> 00:09:13,640
ألكيوني؟

168
00:09:14,170 --> 00:09:15,520
هل أنت متعبة؟

169
00:09:15,520 --> 00:09:16,670
.لا

170
00:09:17,180 --> 00:09:20,450
.يبدو أنّي احتجت لوقت طويل لتخزين ذكرياتي

171
00:09:20,450 --> 00:09:21,620
فعلاً؟

172
00:09:24,060 --> 00:09:25,140
ألكيوني؟

173
00:09:25,970 --> 00:09:28,340
هلاّ ساعدت في إعداد الغداء؟

174
00:09:29,090 --> 00:09:31,460
.سأعتني أنا بفيلوميلا

175
00:09:31,460 --> 00:09:33,460
.حاضر يا سيّدي

176
00:09:40,300 --> 00:09:42,970
.يا لك من وحش لا كلّ ولا يملّ

177
00:09:43,260 --> 00:09:44,720
.لا بدّ أنّ متعبة

178
00:09:45,190 --> 00:09:46,810
.لا يا سيّدتي

179
00:09:46,810 --> 00:09:48,140
كيف يمكنني المساعدة؟

180
00:09:48,140 --> 00:09:50,740
حسنًا... هلاّ قشّرت البرتقال؟

181
00:09:50,740 --> 00:09:52,220
.من دواعي سروري

182
00:09:53,210 --> 00:09:56,480
.لم نخرج في نزهة منذ مدّة
.أنا سعيدة لأنّ الجوّ مناسب

183
00:09:56,480 --> 00:09:57,260
.نعم

184
00:09:59,400 --> 00:10:01,270
...أخبريني يا ألكيوني

185
00:10:02,210 --> 00:10:06,650
.لا يمكننا حمل كاميرات أو ألبومات أو صور لنا

186
00:10:07,130 --> 00:10:10,700
.لذلك خزّني هذا المشهد لأجلنا

187
00:10:28,790 --> 00:10:29,940
.مرحبًا

188
00:10:30,590 --> 00:10:31,610
.أهلاً

189
00:10:33,110 --> 00:10:35,190
.إنّها تلك الأليفة

190
00:10:37,170 --> 00:10:39,760
.لقد تقابلنا من قبل

191
00:10:40,390 --> 00:10:42,990
...اعذرني على فظاظتي

192
00:10:44,500 --> 00:10:47,990
لكن هل أنت من نفس النّوع مثلي؟

193
00:10:50,950 --> 00:10:52,460
مثلك؟

194
00:10:52,460 --> 00:10:54,000
ما الّذي جعلك تعتقدين ذلك؟

195
00:10:54,320 --> 00:10:58,530
أضع حولي مادّة ملموسة لأتمكّن
.من تنفيذ المهام الموكلة إليّ

196
00:10:59,750 --> 00:11:02,470
.شعرت أنّك ربّما تقوم بالمثل

197
00:11:04,740 --> 00:11:05,950
.إلياس

198
00:11:06,860 --> 00:11:08,670
.أتساءل ما الّذي يتحدّثان عنه

199
00:11:09,360 --> 00:11:13,150
.نادتك إحدى التّلاميذ الجدد باسمك

200
00:11:13,670 --> 00:11:15,140
هل أنت من يعتني بها؟

201
00:11:15,720 --> 00:11:16,740
.لا

202
00:11:17,800 --> 00:11:21,500
.أعتقد أنّ الأمر أشبه بأنّها هي من تعتني بي

203
00:11:21,500 --> 00:11:23,240
.أعتقد أنّ الأمران صحيحان

204
00:11:23,720 --> 00:11:26,540
.أمر عجيب بالفعل

205
00:11:26,540 --> 00:11:27,570
عجيب؟

206
00:11:27,570 --> 00:11:33,220
.صُنعنا لخدمة من استدعونا

207
00:11:34,540 --> 00:11:36,870
.لكنّك تبدو مستقلاًّ

208
00:11:37,710 --> 00:11:40,600
.أنا لستُ من الجنّيات الاصطناعيّة

209
00:11:40,600 --> 00:11:42,800
.اعذرني لأنّي افترضت ذلك

210
00:11:43,300 --> 00:11:45,000
ما الّذي جاء بك إلى هنا اليوم؟

211
00:11:45,460 --> 00:11:47,300
.الملاحظة

212
00:11:48,010 --> 00:11:49,090
ماذا؟

213
00:11:49,090 --> 00:11:54,800
.قدرتي على تحليل الملاحظات متطوّرة للغاية

214
00:11:54,800 --> 00:11:56,010
.أنا أحسدك

215
00:11:56,280 --> 00:11:57,210
...لا

216
00:11:58,670 --> 00:12:02,820
.بإمكاني تجاهلها، لكنّي أواصل الرّدّ عليها

217
00:12:04,430 --> 00:12:07,860
.أجهل الكثير من الأشياء ممّا قد يبدو لك

218
00:12:08,610 --> 00:12:09,990
هكذا إذًا؟

219
00:12:14,550 --> 00:12:18,270
.أعتذر على عجزي عن مواصلة الحديث

220
00:12:18,940 --> 00:12:22,970
ما زلت أجهل

221
00:12:25,640 --> 00:12:27,730
.كيف أتفاعل مع الآخرين

222
00:12:31,110 --> 00:12:33,030
!كلاكما في المرحلة الأخيرة

223
00:12:41,150 --> 00:12:42,830
!خسرت ثانية

224
00:12:43,280 --> 00:12:48,120
أعتقد أنّ عليك التّفكير أكثر
.بشأن الأشياء والأشخاص

225
00:12:48,120 --> 00:12:49,540
.ذلك صعب

226
00:12:52,320 --> 00:12:55,420
...جدّتي، أنا وريان

227
00:12:56,810 --> 00:12:58,170
.يا لها من مضيعة للوقت

228
00:12:58,580 --> 00:13:01,280
.لست بحاجة للفوز بأيّة ألعاب

229
00:13:01,920 --> 00:13:05,820
.استعملي ذلك الوقت في قراءة كتبك

230
00:13:05,820 --> 00:13:08,260
.أنت متخلّفة عن الجميع سلفًا

231
00:13:18,520 --> 00:13:21,190
!فاز ريان

232
00:13:21,940 --> 00:13:22,810
.لقد فاز

233
00:13:27,910 --> 00:13:29,350
لماذا تهاونتِ؟

234
00:13:30,100 --> 00:13:30,820
!ريان

235
00:13:30,820 --> 00:13:33,600
.أنا لا أجيد هذه الألعاب أبدًا

236
00:13:33,600 --> 00:13:36,380
!من المستحيل أن تأخذي وقتًا أطول منّي

237
00:13:36,380 --> 00:13:37,380
!توقّف

238
00:13:37,380 --> 00:13:38,860
!لقد بالغت كثيرًا أيّها الغبيّ

239
00:13:41,730 --> 00:13:44,210
.لستُ كما عهدتني في السّابق

240
00:13:44,860 --> 00:13:48,730
.لا تحمّلني توقّعاتك فقط لينتهي الأمر بك خائب الظّنّ

241
00:13:50,750 --> 00:13:52,060
!تمهّل يا ريان

242
00:13:53,580 --> 00:13:54,510
!انتظر

243
00:13:54,760 --> 00:13:56,620
فيلوميلا، هل أنت بخير؟

244
00:13:57,700 --> 00:13:58,950
.أنا آسفة

245
00:14:02,660 --> 00:14:04,560
.أعتذر، سأعود في الحال

246
00:14:04,560 --> 00:14:05,540
!تشيسي

247
00:14:06,340 --> 00:14:07,070
!تبًّا

248
00:14:08,020 --> 00:14:10,720
هل لدى هذين الاثنين تاريخ مشترك؟

249
00:14:10,720 --> 00:14:13,000
...أعلم أنّهم أقارب، ولكن

250
00:14:13,720 --> 00:14:15,710
.أراهن أنّ الوضع معقّد

251
00:14:16,180 --> 00:14:17,350
ياسمين؟

252
00:14:17,350 --> 00:14:18,360
...أنا

253
00:14:23,300 --> 00:14:24,390
!ريان

254
00:14:28,380 --> 00:14:31,320
!لماذا لم تحاول الفوز؟

255
00:14:31,960 --> 00:14:35,460
!إنّها أذكى بكثير منّي وأفضل في الشّعوذة

256
00:14:35,860 --> 00:14:37,880
لماذا تتظاهر بالضّعف؟

257
00:14:38,950 --> 00:14:43,240
.ربّما لأنّها الطّريقة الوحيدة لتواصل العيش

258
00:14:43,490 --> 00:14:45,090
.لا أفهم

259
00:14:45,090 --> 00:14:48,830
،صحيح أنّها لم تكن يومًا من النّوع الحازم

260
00:14:49,310 --> 00:14:51,030
!لكنّ الوضع زاد سوءًا فحسب

261
00:14:51,030 --> 00:14:52,370
—لماذا

262
00:14:53,630 --> 00:14:55,920
!هل تعتقد أنّها بحاجة لتكون كذلك؟

263
00:14:56,260 --> 00:14:59,380
!حاول استعمال دماغك قليلاً أيّها المتذمّر

264
00:15:02,160 --> 00:15:04,540
!إنّك تفكّر حيال الآخرين كثيرًا

265
00:15:05,230 --> 00:15:07,350
.على الأقلّ لستُ متعجرفًا

266
00:15:16,200 --> 00:15:22,440
لم يكن لي أصدقاء أبدًا قبل مجيئي
...إلى هنا، لذلك أجهل ما أقول

267
00:15:23,130 --> 00:15:26,170
هل من الطّبيعيّ قول وفعل أشياء كهذه؟

268
00:15:28,310 --> 00:15:30,760
.إليك كيف أرى الوضع

269
00:15:30,760 --> 00:15:35,380
لا أعتقد أنّه من الجيّد التّصرّف بتلك
.الطّريقة مع الفتيات، أو الأصدقاء عامّة

270
00:15:39,400 --> 00:15:40,120
!فيلوميلا

271
00:15:42,260 --> 00:15:44,790
هل أنت بخير؟

272
00:15:45,170 --> 00:15:46,330
هل تبكي؟

273
00:15:52,740 --> 00:15:53,720
.هذا صحيح

274
00:15:56,360 --> 00:15:58,270
.هذه العيون لا تبكي

275
00:15:59,860 --> 00:16:01,830
.سبق ورأيتها من قبل

276
00:16:04,910 --> 00:16:13,600
.لطالما تنافسنا أنا وريان ولعبنا معًا

277
00:16:14,060 --> 00:16:16,030
.إنّه صريح بشأن مشاعره

278
00:16:16,860 --> 00:16:18,240
.لذلك فهو ينزعج هكذا

279
00:16:18,840 --> 00:16:22,370
.لكنّه كان يقول دائمًا أمورًا جيّدة عنّي

280
00:16:25,380 --> 00:16:28,790
...ولكن الآن، لا يُسمح لي بالفوز

281
00:16:29,630 --> 00:16:31,800
...ولا يسمح لي بالخسارة أيضًا

282
00:16:32,410 --> 00:16:34,140
.أنا مصدر إحراج

283
00:16:34,890 --> 00:16:36,500
.أنا عديمة القيمة

284
00:16:37,320 --> 00:16:39,610
...لا يهمّ ما أفعله، فأنا

285
00:16:43,370 --> 00:16:44,560
...هل السّبب

286
00:16:46,160 --> 00:16:49,210
هو أنّ هذا ما قالته جدّتك لك؟

287
00:16:51,740 --> 00:16:54,970
ماذا أردتِ أن تفعلي؟

288
00:16:54,970 --> 00:16:58,150
.هناك في الماضي، وهنا الآن

289
00:17:06,210 --> 00:17:12,880
.لا يُسمح لي بفعل أيّ شيء

290
00:17:16,700 --> 00:17:18,200
.هذا غير اعتياديّ

291
00:17:18,830 --> 00:17:21,100
.لم أرك عاجزة عن الكلام من قبل

292
00:17:22,060 --> 00:17:24,320
ماذا كان يُفترض بي قوله؟

293
00:17:25,430 --> 00:17:30,880
أصولنا وظروفنا وشخصيّاتنا والعبء
.الّذي نحمله... كلّهما مختلفة

294
00:17:32,130 --> 00:17:34,800
.وها أنا ذي، أشعر أنّي أقرب إليها

295
00:17:36,230 --> 00:17:38,980
.أريد أن أقول لها أنّ بإمكانها فعل شيء ما

296
00:17:41,370 --> 00:17:46,740
بنفس لطّريقة الّتي أخبرني بها
.من حولي أنّي حرّة

297
00:17:47,400 --> 00:17:48,480
.قادمة

298
00:17:49,150 --> 00:17:50,500
.معكم مكتب الممرّضة

299
00:17:50,740 --> 00:17:52,840
.ألكساندرا، لقد اجتمعنا

300
00:17:54,140 --> 00:17:56,930
.أنا مشغولة في الوقت الحاليّ

301
00:17:58,650 --> 00:18:02,540
.تقول أختي أنّها ليست في حالة جيّدة أيّتها الممرّضة

302
00:18:08,090 --> 00:18:09,780
...أ-أرجوك

303
00:18:11,030 --> 00:18:12,070
.أعيدوهم إليّ

304
00:18:12,510 --> 00:18:14,650
.ها قد عدت أخيرًا

305
00:18:14,650 --> 00:18:18,230
.ظننتُ أنّ متّ جوعًا في مكان ما

306
00:18:18,490 --> 00:18:19,940
.أعيدوهم لي رجاءً

307
00:18:20,830 --> 00:18:24,250
!ما عدت أتحمّل

308
00:18:24,960 --> 00:18:29,260
...أعيدوا لي أطفالي... أطفالي

309
00:18:32,400 --> 00:18:36,280
.يُشفى الوحوش بسرعة

310
00:18:36,280 --> 00:18:39,180
.استعدت عافتيك حتّى بعد أن تلاعبت بجسدك

311
00:18:40,090 --> 00:18:44,190
تركت أقلّ ما يمكن من إدراكك لنفسك
.حتّى لا تتورّطي في المشاكل

312
00:18:44,970 --> 00:18:46,190
.لا بأس

313
00:18:46,190 --> 00:18:47,940
.سأعيدهم لك

314
00:18:48,320 --> 00:18:53,300
.حان الوقت لذلك

315
00:18:59,280 --> 00:19:01,230
.ريان. حلّ الصّباح

316
00:19:03,820 --> 00:19:05,650
.إنّه يوم السبت

317
00:19:08,770 --> 00:19:12,750
.لم نعتد على الشّجار أبدًا

318
00:19:17,740 --> 00:19:19,310
.إنّها تُمطر كالمتوقّع

319
00:19:24,650 --> 00:19:27,350
.أتساءل إن كانت تمطر خارج الكلّيّة أيضًا

320
00:19:30,420 --> 00:19:32,040
هل تحبّين الأمطار؟

321
00:19:32,040 --> 00:19:33,600
.أظنّ ذلك

322
00:19:33,950 --> 00:19:36,490
.أنا قلقة حيال مزروعاتنا في المنزل

323
00:19:36,490 --> 00:19:38,810
.لم نحصن اليقطين بعد

324
00:19:39,490 --> 00:19:42,090
.سنكون بخير قبيل حلول عيد الميلاد

325
00:19:42,810 --> 00:19:44,480
.لا أدري إن كان بإمكاننا أكلها كلّها

326
00:19:44,810 --> 00:19:48,210
.ربّما يكون هنالك من حصدها سلفًا

327
00:19:48,210 --> 00:19:50,730
.أراهن على ذلك

328
00:19:51,490 --> 00:19:53,540
ماذا نعدّ باليقطين؟

329
00:19:54,160 --> 00:19:55,740
.ربّما حساء

330
00:19:56,330 --> 00:19:59,540
.أو نطبخها مع العسل والخردل

331
00:19:59,540 --> 00:20:03,060
.أو نطلب من الفضّيّة خبزها في كعكة

332
00:20:03,690 --> 00:20:04,730
...أنا وتشيسي

333
00:20:05,800 --> 00:20:07,300
...أنا وإلياس

334
00:20:07,910 --> 00:20:11,080
.لم نجلس ونتحدّث معًا منذ مدّة

335
00:20:16,910 --> 00:20:18,380
.إلياس

336
00:20:18,380 --> 00:20:21,690
هل أتخيّل أم أرى أشياء أكثر من العادة؟

337
00:20:22,240 --> 00:20:24,470
.لقد حلّ الشّتاء

338
00:20:24,470 --> 00:20:25,830
أهذا بسبب الشّتاء؟

339
00:20:25,830 --> 00:20:27,350
أشياء أكثر ممّاذا؟

340
00:20:28,340 --> 00:20:29,500
.فيوليت

341
00:20:29,500 --> 00:20:30,990
هل قاطعتكما؟

342
00:20:30,990 --> 00:20:32,550
...قاطعتنا

343
00:20:32,550 --> 00:20:34,160
.لا بأس

344
00:20:34,760 --> 00:20:38,590
.أستاذ إينزوورث، حالة ياسمين ليست بخير

345
00:20:38,590 --> 00:20:41,870
.على الأرجح أنّها ستغيب عن الفصل التّالي

346
00:20:42,460 --> 00:20:44,700
.أنوي الاعتناء بها

347
00:20:45,350 --> 00:20:47,990
.أي أنّ كلاكما سيكون غائبًا

348
00:20:47,990 --> 00:20:52,770
،صحيح، إن كنت جادًّا حيال تعلّم السّحر

349
00:20:52,770 --> 00:20:55,350
.فعليك العثور على معلّم آخر

350
00:20:55,890 --> 00:20:59,060
.فالسّحر والشّعوذة طريقان مختلفان

351
00:20:59,060 --> 00:21:01,320
.توقّعت ذلك

352
00:21:01,970 --> 00:21:03,690
.سأفكّر في الأمر مليًّا

353
00:21:04,200 --> 00:21:06,390
حسنًا، ما الّذي كنت ترين الكثير منه؟

354
00:21:07,610 --> 00:21:09,220
أهي أشباح أو ما شابه؟

355
00:21:09,220 --> 00:21:10,700
.هناك الكثير مؤخّرًا

356
00:21:10,700 --> 00:21:12,960
أيمكنك رؤيتها أيضًا يا فيوليت؟

357
00:21:13,250 --> 00:21:14,480
.أحيانًا

358
00:21:14,910 --> 00:21:18,990
الأشباح والأطياف جزء من الحياة
.في الشّتاء في هذه البلاد

359
00:21:18,990 --> 00:21:21,410
.إنّه موسم عودة الأموات

360
00:21:21,410 --> 00:21:25,380
.يحدث ذلك في الصّيف من حيث أتيت

361
00:21:25,920 --> 00:21:29,190
."حتّى أنّ لدينا لعبة لذلك تُدعى "كيمودامشي

362
00:21:29,190 --> 00:21:30,380
كيمودامشي؟

363
00:21:30,720 --> 00:21:33,740
.أعتقد أنّها مثل جولة رعب

364
00:21:33,740 --> 00:21:37,060
يتجوّل التّلاميذ حول المدرسة ليلاً
.بدون إشراف على سبيل المثال

365
00:21:38,530 --> 00:21:39,840
هل فعلتِ ذلك من قبل؟

366
00:21:39,840 --> 00:21:41,650
.أظنّني فعلت

367
00:21:41,650 --> 00:21:43,470
هلاّ أخبرتني بالمزيد؟

368
00:21:43,990 --> 00:21:44,870
.أكيد

369
00:21:50,550 --> 00:21:52,910
.فهمت. هكذا إذًا

370
00:21:53,520 --> 00:21:57,460
.بالمناسبة، أشعر بممل كبير الآن

371
00:21:57,460 --> 00:22:00,350
أتريدين القيام بأمر ممتع؟

372
00:22:06,270 --> 00:22:09,010
.يأتيني الكثير من المرضى مؤخّرًا

373
00:22:09,940 --> 00:22:12,340
...أعلم انّه موسم الإنفلونزا، ولكن

374
00:22:13,160 --> 00:22:13,970
ماذا؟