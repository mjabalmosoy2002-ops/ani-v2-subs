1
00:00:06,980 --> 00:00:09,410
هل رأيت توم مؤخّرًا؟

2
00:00:09,410 --> 00:00:11,250
.لا، لم أره

3
00:00:12,980 --> 00:00:15,440
.جيمي ونورتن مفقودان أيضًا

4
00:00:15,950 --> 00:00:18,450
.آمل ألاّ يكونوا قد تعرّضوا لضرب في مكان ما

5
00:00:18,450 --> 00:00:19,230
.فكرة مخيفة

6
00:00:21,170 --> 00:00:24,610
.ربّما يكونون قد استسلموا للبرد وماتوا

7
00:00:46,320 --> 00:00:47,560
...فيلوميلا

8
00:00:51,150 --> 00:00:54,030
عيد ميلاد مجيد
القاعة الكبيرة

9
00:02:30,120 --> 00:02:36,090
.شدّة الإنسان هي فرصة الإله

10
00:02:30,150 --> 00:02:33,210
ترحّبين بوالدك ووالدتك؟

11
00:02:33,570 --> 00:02:34,900
.فهمت

12
00:02:34,900 --> 00:02:40,290
خطيئتك أعظم من أورفيوس الّذي
.سافر للعالم السّفليّ سعيًا وراء زوجته

13
00:02:43,660 --> 00:02:48,970
فعلت هذا بنفسك فقط لإعادة الأموات؟

14
00:02:49,470 --> 00:02:50,340
.نعم

15
00:02:50,340 --> 00:02:52,150
.هذا صحيح

16
00:02:52,150 --> 00:02:56,750
.لذلك أودّ منك أن تفتحي الكلّيّة

17
00:02:57,520 --> 00:03:00,200
.هذه رغبتي الوحيدة

18
00:03:00,800 --> 00:03:05,190
لا تريدين أن تتحمّلي مسؤوليّة أشخاص جافّين

19
00:03:05,580 --> 00:03:11,010
وبلا حياة ككيس لأعشاب عطريّة منسيّ، صحيح؟

20
00:03:14,200 --> 00:03:15,010
!فيلوميلا

21
00:03:17,150 --> 00:03:18,680
!لا تقتربوا

22
00:03:29,140 --> 00:03:30,920
!التّميمة

23
00:03:33,830 --> 00:03:36,450
.مع أنّ شكلها قد تغيّر، إلاّ أنّ الأمر واضح لي

24
00:03:37,320 --> 00:03:38,580
.إنّها فيلوميلا

25
00:03:39,270 --> 00:03:41,760
.فيلوميلا سيرجنت

26
00:03:41,760 --> 00:03:42,810
هذه هي؟

27
00:03:47,720 --> 00:03:51,120
.بدأت تفسد المدرّسين أيضًا

28
00:03:51,120 --> 00:03:53,700
.إنّها تتجاوز حتّى الدّفاعات الذّهنيّة

29
00:03:54,500 --> 00:03:56,970
.لا بدّ من وجود إله في ذلك الشّيء

30
00:03:57,770 --> 00:04:00,760
...أيّتها المديرة، أتوسّل إليك

31
00:04:01,150 --> 00:04:04,960
افتحي الكلّيّة. رجاءً؟

32
00:04:08,980 --> 00:04:10,270
.فلورنس

33
00:04:31,480 --> 00:04:33,400
.شكرًا جزيلاً لك

34
00:04:34,140 --> 00:04:37,330
...والآن، أظنّني سوف

35
00:04:41,420 --> 00:04:43,280
،يا تابع القمر

36
00:04:43,920 --> 00:04:49,920
يا تجسيد القمر وحامل الشّفقة
...غير المرغوب بها

37
00:04:50,640 --> 00:04:54,760
!أنشد بغضبك! أنشد بكراهيتك

38
00:04:55,090 --> 00:04:56,150
—فيلوميـ

39
00:04:56,930 --> 00:04:57,850
.كلاّ

40
00:05:16,330 --> 00:05:19,160
ألكيوني...؟

41
00:05:20,210 --> 00:05:23,040
...سيّدتي فيلوميلا

42
00:05:34,930 --> 00:05:36,570
!مستذئب

43
00:06:14,640 --> 00:06:16,630
!قدّموا لنا المساعدة إن كنتم غير مصابين

44
00:06:18,840 --> 00:06:20,380
هل تعرفين أيّ شيء؟

45
00:06:23,720 --> 00:06:25,160
هل أنت بخير؟

46
00:06:33,260 --> 00:06:34,960
.لا أعتقد أنّ بإمكانك النّهوض بعد

47
00:06:35,440 --> 00:06:37,780
.الزم مكانك حتّى تستعيد قوّتك السّحريّة

48
00:06:37,780 --> 00:06:40,340
.سأذهب لتقديم يد المساعدة

49
00:06:44,690 --> 00:06:45,620
.تبًّا

50
00:06:46,540 --> 00:06:48,640
.أظنّ أنّه لم يمت أيّ أحد

51
00:06:49,360 --> 00:06:51,950
.أحضروا المساعدة من مكتب الممرّضة

52
00:06:52,460 --> 00:06:53,500
.أيّتها المديرة

53
00:06:54,650 --> 00:06:58,030
.أرى أنّكم بخير

54
00:06:58,030 --> 00:06:58,770
.حمدًا على هذا

55
00:06:59,130 --> 00:07:01,100
.سنذهب خلفهم

56
00:07:01,100 --> 00:07:03,320
.أوافقها الرّأي. علينا السّعي خلفهم

57
00:07:03,320 --> 00:07:05,190
.لن يحدث ذلك

58
00:07:05,810 --> 00:07:11,510
.لقد أفسدها أيَّا كان من يقبع في ذلك الكتاب كثيرًا

59
00:07:13,150 --> 00:07:16,560
.بدأت تفقد إنسانيّتها

60
00:07:18,950 --> 00:07:23,590
.جسدها وعقلها سيفشلان قريبًا، وسينتهي أمرها

61
00:07:24,570 --> 00:07:27,990
وهذا يعني أنّ لا مانع من قتلها؟

62
00:07:28,720 --> 00:07:31,570
.أفهم أنّك لم تنوين أبدًا أن تحاولي صدّها

63
00:07:33,720 --> 00:07:36,970
.أنا مسؤولة عن هذه الكلّيّة

64
00:07:37,460 --> 00:07:42,730
عليّ وضع صحّة وأمان التّلاميذ
.والمدرّسين فوق كلّ شيء آخر

65
00:07:44,240 --> 00:07:46,730
ليس من الحكمة تكريس الوقت لشخص

66
00:07:47,190 --> 00:07:50,360
.يدرك تمامًا أنّه يدمّر نفسه

67
00:07:51,010 --> 00:07:52,660
...إلاّ إذا

68
00:07:52,660 --> 00:07:59,400
كنت تقترحين أنّه كان عليّ وضع حياة
الجميع على المحكّ لإنقاذ حياتها فقط؟

69
00:08:01,570 --> 00:08:02,920
...ذلك ليس

70
00:08:02,920 --> 00:08:06,310
أم تعتقدين أنّه كان بإمكانك القيام بشيء ما؟

71
00:08:06,810 --> 00:08:11,580
.صحيح أنّ شجاعتك ساعدتك على تجاوز الكثير من المحن

72
00:08:12,110 --> 00:08:17,270
،إن كانت نتيجة ذلك هي تلك الذّراع
.فاستنتاجي الوحيد هو أنّك حمقاء

73
00:08:19,940 --> 00:08:24,450
تشيسي هاتوري، إن كنت تريدين
،فعلاً حماية أصدقائك

74
00:08:26,140 --> 00:08:32,500
فعليك التّخلّص من إحساسك بالتّعاطف
.المثير للشّفقة والمليء بالمديح الذّاتيّ

75
00:08:41,680 --> 00:08:42,500
...أعلم

76
00:08:44,580 --> 00:08:47,090
.أعلم أنّ عليّ التّراجع

77
00:08:48,470 --> 00:08:51,210
.أعلم أنّي أقوم بذلك فقط لإرضاء نفسي

78
00:08:53,370 --> 00:08:54,570
...لكن

79
00:08:57,000 --> 00:09:01,320
!إن تراجعت الآن، فستموت

80
00:09:11,410 --> 00:09:12,390
.أحسنت

81
00:09:16,460 --> 00:09:18,450
إ-إلياس؟

82
00:09:19,390 --> 00:09:22,830
.كنتِ في العادة لتغادري مندفعة إليها

83
00:09:23,700 --> 00:09:29,170
سمعتُ أنّه عندما يتعلّم الجرو
.أن "يلزم مكانه"، فإنّه يستحقّ مكافأة

84
00:09:30,200 --> 00:09:31,940
...صـ-صحيح

85
00:09:32,780 --> 00:09:34,500
أينزوورث؟

86
00:09:36,050 --> 00:09:40,230
.إنّ الكلّيّة مكان ينمّي المشعوذين الواعدين

87
00:09:40,690 --> 00:09:44,030
لكنّ ماذا عنّا يا تشيسي؟

88
00:09:45,600 --> 00:09:48,020
ما نحن؟

89
00:09:51,040 --> 00:09:53,380
.نحن سحرة

90
00:09:54,160 --> 00:09:55,190
.هذا صحيح

91
00:09:56,220 --> 00:09:59,610
هل شكّلت معها أيّ عقد مهما كان نوعه؟

92
00:10:00,700 --> 00:10:02,120
...عقد

93
00:10:06,410 --> 00:10:08,740
.قطعنا وعدًا

94
00:10:09,460 --> 00:10:12,140
.تواعدنا أن نصنع الأعشاب العطريّة معًا يومًا ما

95
00:10:13,020 --> 00:10:17,320
.إذًا بصفتك ساحرة، فعليك احترام ذلك العقد

96
00:10:19,660 --> 00:10:21,670
.أينزوورث

97
00:10:21,670 --> 00:10:23,140
...إيّاك أن تجرؤ على إخباري

98
00:10:23,860 --> 00:10:29,500
،ما دمنا مرتبطين بعقد ما
.فعلى السّاحر أن يتصرّف كساحر

99
00:10:30,220 --> 00:10:32,150
.سنغيب ببعض الوقت

100
00:10:32,560 --> 00:10:36,260
.لا خير قد تجنيه من تدليل تلاميذك

101
00:10:37,510 --> 00:10:40,870
.إنّنا نتّبع القواعد فحسب

102
00:10:48,260 --> 00:10:49,300
تشيسي؟

103
00:10:49,300 --> 00:10:50,850
.أستاذ أينزوورث

104
00:10:51,820 --> 00:10:53,870
!خذني معك أيضًا رجاءً

105
00:10:53,870 --> 00:10:55,300
!و-وأنا أيضًا

106
00:10:55,300 --> 00:10:55,960
.وأنا

107
00:10:56,400 --> 00:10:58,030
.لا يمكنني أخذكم

108
00:10:58,960 --> 00:11:03,050
.إنّ من قتل عائلتي هرب مع زميلتي

109
00:11:03,050 --> 00:11:06,800
!لن أكون راضية حتّى أحصل على جواب منهم

110
00:11:07,710 --> 00:11:10,130
.وأنا لن أسمح بموتها ببساطة

111
00:11:10,680 --> 00:11:13,900
كنّا قد بدأنا نصير صديقين ينفّس
.كلّ منّا للآخر عن همومه

112
00:11:13,900 --> 00:11:16,770
...أمّا أنا

113
00:11:16,770 --> 00:11:18,310
.فقلق على الجميع

114
00:11:18,310 --> 00:11:22,020
—إ-إضافة إلى أنّ الشّيء الوحيد الّذي قد أساعد

115
00:11:22,830 --> 00:11:24,860
تخطّطون لانقلاب؟

116
00:11:25,560 --> 00:11:27,360
!أستاذ زاكّروني

117
00:11:27,360 --> 00:11:28,890
!سرّني سماع هذا

118
00:11:28,890 --> 00:11:32,610
لماذا لا تعارضون أوامر الكبار ولو لمرّة؟

119
00:11:33,290 --> 00:11:36,000
.سأرافقكم في حال احتجتم للمساعدة

120
00:11:36,870 --> 00:11:38,640
ما هدفك؟

121
00:11:39,100 --> 00:11:42,150
.نحصل على مكافآت إضافية بالقيام بعمل خيّر

122
00:11:42,150 --> 00:11:46,500
هذا جدير بالثّقة أكثر من خدمة غير مدفوعة، صحيح؟

123
00:11:48,700 --> 00:11:50,200
.معك حقّ

124
00:11:50,820 --> 00:11:54,600
في تلك الحالة، لستُ مسؤولاً عمّا
.سيحدث لأيّ أحد منكم

125
00:11:56,290 --> 00:12:00,440
أسمعتم؟ هذا السّيّد السّاحر لن يحمي
.أيّ أحد منكم ليس تلميذته

126
00:12:00,440 --> 00:12:05,860
أيّها المشعوذون الواعدون، سيكون
.عليكم الدّفاع عن أنفسكم بقدر الإمكان

127
00:12:05,860 --> 00:12:09,820
.ولكنّي سأحميكم إن اقتضى الأمر لذلك

128
00:12:13,450 --> 00:12:14,570
تشيسي؟

129
00:12:26,550 --> 00:12:27,860
فلورنس؟

130
00:12:34,950 --> 00:12:35,770
...يا أطفال

131
00:12:36,790 --> 00:12:39,940
...يا إخوتي المحترقون بالغضب الملعون

132
00:12:42,670 --> 00:12:44,940
.ازحفوا في الأرض إن رفضتكم السّماء

133
00:12:45,890 --> 00:12:47,850
.اسلكوا أسف ما فيها

134
00:12:49,070 --> 00:12:52,340
.اذهبوا بالتهام طريقي الدّمويّ

135
00:12:55,430 --> 00:12:56,440
.هذا سيّئ

136
00:13:00,970 --> 00:13:02,110
!لوسي

137
00:13:05,670 --> 00:13:07,000
.لقد اختفوا

138
00:13:07,560 --> 00:13:09,810
تلك ساحرة؟

139
00:13:09,810 --> 00:13:14,660
.مستحيل أن يكون شيء كهذا مجرّد ساحرة

140
00:13:25,490 --> 00:13:28,540
.يول عند المنعطف فحسب

141
00:13:28,540 --> 00:13:31,070
.أتمنّى لم تحقّق أيّ تقدّم بسرعة

142
00:13:32,900 --> 00:13:35,250
.أخبرتك عدّة مرّات

143
00:13:35,690 --> 00:13:37,040
—لا أدري متى

144
00:13:48,500 --> 00:13:49,980
هل رأيت ذلك؟

145
00:13:49,980 --> 00:13:51,170
.بالطّبع

146
00:13:51,810 --> 00:13:54,200
.أتمنّى لو أستطيع التّظاهر أنّي لم أره

147
00:13:54,200 --> 00:13:55,540
ما العمل؟

148
00:13:55,540 --> 00:13:56,300
.غبيّ

149
00:13:56,630 --> 00:13:59,160
...تنّين أحمر على هذه الجزيرة

150
00:13:59,940 --> 00:14:01,710
.سيكون هذا كابوسًا حقيقيًّا

151
00:14:04,110 --> 00:14:06,600
...اتبع... اتبع

152
00:14:07,530 --> 00:14:09,210
.اتبع الرّائحة

153
00:14:12,370 --> 00:14:16,010
.اسع خلف قلبها

154
00:14:42,880 --> 00:14:44,840
.أري أنّك قد عدت

155
00:14:44,840 --> 00:14:47,610
.وصار منظرك لا يصرّ النّاظر إليه

156
00:14:48,510 --> 00:14:49,710
.فيلوميلا

157
00:14:57,640 --> 00:15:02,440
.يبدو أنّك قد قمت بعملك كما يجب لأوّل مرّة

158
00:15:03,220 --> 00:15:04,890
...جدّتي

159
00:15:05,620 --> 00:15:10,730
أبي وأمّي سيعودان الآن، صحيح؟

160
00:15:11,320 --> 00:15:13,360
...سيعودان أخيرًا

161
00:15:17,420 --> 00:15:19,070
...ما فعلت

162
00:15:19,070 --> 00:15:24,060
ما فعلت يستحقّ الثّناء، صحيح؟

163
00:15:30,880 --> 00:15:35,590
.ألكيوني، خذيها تحت الأرض عند الغروب

164
00:15:35,590 --> 00:15:36,650
...حاضرة

165
00:15:37,210 --> 00:15:39,740
.وأنت عليك الانتظار في الخارج

166
00:15:39,740 --> 00:15:43,080
.مهمّتك هي التّعامل مع أيّ أحد يتدخّل في الطّقوس

167
00:15:56,580 --> 00:15:58,420
أين أنا؟

168
00:16:04,270 --> 00:16:07,040
.لوسي

169
00:16:08,190 --> 00:16:09,160
.زوي

170
00:16:09,730 --> 00:16:10,990
هل أنت بخير؟

171
00:16:11,760 --> 00:16:13,330
.أنا هنا أيضًا

172
00:16:13,330 --> 00:16:14,440
!إسحاق

173
00:16:14,720 --> 00:16:19,650
...آخر ما أذكره هو سائل أسود يبتلعنا

174
00:16:21,490 --> 00:16:23,540
.ذلك ما أذكره أيضًا

175
00:16:23,540 --> 00:16:25,190
أين نحن؟

176
00:16:25,710 --> 00:16:26,870
.في الدّاخل

177
00:16:29,560 --> 00:16:35,820
الطّريقة الوحيدة الّتي كان بإمكاني إحضاركما
.بها معي هي بوضعكم داخلي

178
00:16:36,350 --> 00:16:38,590
.أنت أيّها السّاحر

179
00:16:38,980 --> 00:16:41,130
هلاّ منحتني مساحة أكبر؟

180
00:16:41,130 --> 00:16:42,710
.أنا عالق

181
00:16:42,710 --> 00:16:44,950
.كان حجمك كبيرًا لا غير

182
00:16:46,610 --> 00:16:51,370
...إذًا فنحن داخلك الآن

183
00:16:51,370 --> 00:16:52,310
لماذا؟

184
00:16:53,020 --> 00:16:55,080
.لأنّها تتحرّك

185
00:16:55,800 --> 00:16:57,600
.هي من تقوم بنقلنا

186
00:16:57,600 --> 00:17:00,730
.يبدو أنّها تتبع رائحتها عبر العروق تحت الأرض

187
00:17:01,280 --> 00:17:02,740
رائحتها؟

188
00:17:03,040 --> 00:17:04,650
.رائحة مشاعرها

189
00:17:04,650 --> 00:17:06,340
.رائحة روحها

190
00:17:06,740 --> 00:17:10,010
.إنّنا نميل للاعتماد على أشياء كهذه

191
00:17:10,010 --> 00:17:12,160
.تبدون مثل الحيوانات

192
00:17:12,160 --> 00:17:14,200
.البشر حيوانات أيضًا

193
00:17:14,820 --> 00:17:19,400
.لكن ما كنتم لتستطيعوا الغوص مثلنا وحدكم

194
00:17:19,400 --> 00:17:22,640
.لذلك اضطررت لأخذكم بداخلي

195
00:17:22,640 --> 00:17:24,150
عروق تحت الأرض؟

196
00:17:24,150 --> 00:17:27,080
.مستحيل أن يستطيع البشر العبور فيها

197
00:17:27,080 --> 00:17:29,680
.ذلك لا يختلف عن الغوص مباشرة في الأرض

198
00:17:29,680 --> 00:17:32,400
.هذه قاعدة للمشعوذين فقط

199
00:17:32,400 --> 00:17:35,030
.لا وجد لقاعدة كهذه بالنّسبة للسّحرة

200
00:17:35,670 --> 00:17:40,340
مع أنّه لا يوجد الكثير ممّن يستطيعون
.فعل مثل هذه الأمور

201
00:17:41,390 --> 00:17:43,260
ما هي العروق تحت الأرض؟

202
00:17:43,260 --> 00:17:46,160
.ممرّات قوّة تحأرضيّة

203
00:17:46,510 --> 00:17:48,490
.بعضها أحاديّ المسار

204
00:17:48,490 --> 00:17:50,320
.وآخر مزدوج

205
00:17:50,320 --> 00:17:52,670
.بعضها مضطرب كالعواصف

206
00:17:53,070 --> 00:17:56,500
.وآخر عبارة عن حيويّة وقوّة سحريّة خالصين

207
00:17:56,500 --> 00:18:00,440
.ويرى آخرون أنّها كتلة من الكائنات الحيّة

208
00:18:00,440 --> 00:18:04,500
غالبًا ما تتشكّل المدن الكبرى حيث
.تمرّ هذه العروق تحت الأرض

209
00:18:06,980 --> 00:18:08,270
!ظهر الأم

210
00:18:08,560 --> 00:18:10,290
ماذا تقصد؟

211
00:18:10,290 --> 00:18:12,900
.إنّها جملة من لغة شعبي

212
00:18:12,900 --> 00:18:17,440
خيوط في الأرض حيث تجتمع المياه
.والأشجار والحيوانات والنّاس

213
00:18:17,440 --> 00:18:20,740
لديكم نفس المفهوم حتّى في لغة أخرى؟

214
00:18:21,090 --> 00:18:25,190
وتلك الفتاة السّخيفة تسبح عبر
تلك الأجزاء من الأرض؟

215
00:18:25,840 --> 00:18:26,770
.نعم

216
00:18:27,460 --> 00:18:35,200
أيّها السّيّد السّاحر، إنّكم تنشئون السّحر
بمساعدة من الجنّيّات والأرواح، صحيح؟

217
00:18:35,570 --> 00:18:41,560
مساعدة من تلقّت حتّى تصير تنّينًا لعينًا كهذا؟

218
00:18:42,350 --> 00:18:43,980
تنّين؟

219
00:18:45,880 --> 00:18:47,050
.إنّنا نصعد

220
00:18:48,270 --> 00:18:50,760
.السّحر لا ينقلب أبدًا

221
00:18:51,430 --> 00:18:54,730
.لذلك علينا التّفكير في الأمر لاحقًا

222
00:19:27,990 --> 00:19:30,510
.انتظروا هنا جميعًا

223
00:19:30,970 --> 00:19:33,030
.أعد أن أعود إليكم لاحقًا

224
00:19:34,070 --> 00:19:34,960
—مهلاً لحـ

225
00:19:34,960 --> 00:19:37,290
...اخرجوا وألقوا نظرة بعيونكم على ما هناك

226
00:19:39,010 --> 00:19:41,610
.وستبتلعكم غرائز أمومة قديمة

227
00:19:50,270 --> 00:19:51,790
.ها أنت ذي

228
00:19:52,720 --> 00:19:57,260
هل حضّرت عطيّة أيّتها العذراء؟

229
00:19:58,380 --> 00:20:00,710
.كانت السّيّدة ليزبث على حقّ

230
00:20:00,710 --> 00:20:01,880
.هناك دخلاء

231
00:20:02,360 --> 00:20:04,910
.قوّتهم السّحريّة كبيرة

232
00:20:04,910 --> 00:20:05,960
أهم مشعوذون؟

233
00:20:06,360 --> 00:20:09,000
.يبدو أنّهم كثيرون، لكن لا يمكنني تحديد ذلك

234
00:20:09,000 --> 00:20:12,360
.كلّ ما يمكنني رؤيته هو شخص واحد

235
00:20:12,360 --> 00:20:14,170
.طفلة بشعر أحمر

236
00:20:14,470 --> 00:20:16,430
...لا، هناك شخص آخر

237
00:20:17,160 --> 00:20:18,240
امرأة؟

238
00:20:18,770 --> 00:20:20,140
...لا، الأمر ليس كذلك

239
00:20:20,140 --> 00:20:21,400
...إنّها

240
00:20:21,790 --> 00:20:22,990
...هذه

241
00:20:32,050 --> 00:20:32,750
!مهلاً

242
00:20:33,050 --> 00:20:33,950
ما الخطب؟

243
00:20:33,950 --> 00:20:34,770
!أجبني

244
00:20:35,480 --> 00:20:37,710
!غـ-غراب

245
00:20:42,320 --> 00:20:44,220
...سيّدتي فيلوميلا

246
00:20:44,760 --> 00:20:46,290
...هل فعلاً

247
00:20:46,750 --> 00:20:51,850
هل ستعيدهما جدّتي للحياة بالفعل؟

248
00:20:54,260 --> 00:20:55,880
...ألكيوني

249
00:20:55,880 --> 00:21:00,010
لماذا أريد أن يعودا؟

250
00:21:00,800 --> 00:21:02,170
...أنا

251
00:21:02,670 --> 00:21:08,980
.أنا لا أذكر حتّى كيف يبدو أمّي وأبي

252
00:21:10,570 --> 00:21:11,700
...لكن

253
00:21:12,820 --> 00:21:17,370
...لكن إن عادا، فأنا واثقة

254
00:21:17,370 --> 00:21:21,630
.واثقة أنّهم سيثنيان عليّ كيفما كنت

255
00:21:25,610 --> 00:21:26,750
ماذا أفعل؟

256
00:21:27,910 --> 00:21:29,860
ماذا يمكنني فعله في وقت كهذا؟

257
00:21:31,170 --> 00:21:35,760
ماذا بإمكاني فعله من الأساس؟

258
00:21:36,270 --> 00:21:38,110
...ظننتُ أنّي أعرف

259
00:21:39,330 --> 00:21:40,370
.ثمّة خطب ما

260
00:21:40,930 --> 00:21:42,410
...لا يعقل أنّ هذا

261
00:21:50,340 --> 00:21:55,940
.كنتُ واثقة أنّي سجّلت الأمر

262
00:21:56,890 --> 00:21:58,450
...مذّاك الحين

263
00:22:05,290 --> 00:22:06,080
.مرحبًا

264
00:22:06,510 --> 00:22:08,410
.أنا آدم سيرجنت

265
00:22:09,000 --> 00:22:12,440
.أنا سيّدك يا ألكيوني

266
00:22:13,270 --> 00:22:16,860
.سأترك لك مسؤوليّة أكثر شيء مهمّ في العالم

267
00:22:17,320 --> 00:22:19,240
صحيح يا إيريس؟

268
00:24:07,090 --> 00:24:10,960
.للصّبر حدود