1
00:00:03,090 --> 00:00:04,720
...أنا

2
00:00:10,040 --> 00:00:13,900
...سا... ساعدوني

3
00:00:15,770 --> 00:00:16,660
!فيلوميلا

4
00:00:35,750 --> 00:00:40,100
ألا تريدين لقاء أبيك وأمّك؟

5
00:01:11,400 --> 00:01:12,880
...ماذا

6
00:01:16,600 --> 00:01:19,720
.لقد نما ثانية

7
00:01:19,720 --> 00:01:21,300
.كلّ شيء عدا أصابعي

8
00:01:40,610 --> 00:01:42,050
أستغادرين؟

9
00:01:43,370 --> 00:01:46,450
.مع أنّي لا أهتمّ لما قد يحدث لك

10
00:01:47,400 --> 00:01:49,600
.لكنّي أعتقد أنّك ستواجهين وقتًا عصيبًا

11
00:02:12,050 --> 00:02:14,270
...ستعود للمنزل قريبًا

12
00:02:15,730 --> 00:02:16,900
.يا آدم

13
00:03:48,790 --> 00:03:54,790
.أعط اللّصّ ما يكفي من الحبل وسيشنق نفسه

14
00:03:52,860 --> 00:03:53,980
.ها أنا ذا

15
00:04:00,030 --> 00:04:02,190
...لم أعلم أبدًا

16
00:04:03,210 --> 00:04:06,270
.لماذا أنا بلا حول ولا قوّة

17
00:04:09,790 --> 00:04:15,630
لماذا أنا عاجزة عن الإمساك بكتفَيْ
.السّيّدة فيلوميلا رغم معاناتها

18
00:04:31,140 --> 00:04:35,330
.أنت إذًا الجنّيّة الاصطناعيّة الّتي صنعها آدم

19
00:04:36,470 --> 00:04:40,190
.أعيديني رجاءً للسّيّدة فيلوميلا

20
00:04:40,660 --> 00:04:43,130
هل ذلك هو واجبك؟

21
00:04:43,130 --> 00:04:45,460
.لهذا السّبب تمّت صناعتي

22
00:04:45,460 --> 00:04:49,040
.سأمنحك واجبًا مختلفًا

23
00:04:49,040 --> 00:04:50,000
!كلاّ

24
00:04:50,000 --> 00:04:55,180
،حتّى إن مُنحتُ واجبًا مختلفًا
.فأنا أنتمي إليها

25
00:04:55,180 --> 00:04:56,770
.أنا موجودة لأجلها فحسب

26
00:04:56,770 --> 00:04:59,040
.وسأدمّر من أجلها

27
00:04:59,850 --> 00:05:00,880
هكذا إذًا؟

28
00:05:09,240 --> 00:05:13,050
.لا بدّ أنه لم يمتلك الموادّ ولا المعدّات المناسبة

29
00:05:13,050 --> 00:05:14,900
.ذلك الفتى موهوب للغاية

30
00:05:15,850 --> 00:05:20,050
لكنّك لا تزالين مجرّد جنّيّة صُنعت
.من قطع وأجزاء مختلفة

31
00:05:22,750 --> 00:05:26,020
.يمكنني إصلاحك مع بعض التّعديل

32
00:05:36,270 --> 00:05:38,930
.وعيي يختفي

33
00:05:40,030 --> 00:05:43,280
،بسبب تلك التّعويذة

34
00:05:45,040 --> 00:05:46,890
.فشلت في حمايتها

35
00:05:50,790 --> 00:05:53,120
.هناك واحدة أخرى داخلك

36
00:05:53,950 --> 00:05:55,030
ما هذا؟

37
00:05:55,790 --> 00:05:58,110
.لم يحن أوان ذلك بعد

38
00:06:03,930 --> 00:06:05,100
...أنت

39
00:06:05,920 --> 00:06:09,710
.عاد أخيرًا ما علمتُ أنّه حقيقيّ

40
00:06:10,250 --> 00:06:12,170
...حقيقتي

41
00:06:13,080 --> 00:06:15,090
.سبب وجودي

42
00:06:15,640 --> 00:06:18,020
.رجاءً يا سيّدي السّاحر

43
00:06:19,120 --> 00:06:22,430
.خذني إليها

44
00:06:33,020 --> 00:06:35,570
.رُزقت بطفل أخيرًا

45
00:06:36,770 --> 00:06:40,220
.كنتُ مؤهّلة أكثر من غيري في العائلة

46
00:06:42,300 --> 00:06:45,230
.اختارني أبي كوريثة له

47
00:06:45,230 --> 00:06:51,680
حصلت على شرف الخدمة كريكنباكّر
.كما هم أسلافي من قبل

48
00:06:52,260 --> 00:06:55,820
.أظنّ أنّ الوقت حان لتتبنَّيْ طفلاً ما

49
00:06:57,340 --> 00:06:59,580
.أنت ناجحة

50
00:06:59,580 --> 00:07:02,390
.ستحتاجين شخصًا لأخذ مكانك يومًا ما

51
00:07:02,390 --> 00:07:03,420
.لا بأس

52
00:07:03,420 --> 00:07:06,860
لا أحد في هذا العصر والأوان
.سيطلب أن يكون الطّفل من رحمك

53
00:07:08,160 --> 00:07:09,080
.حاضرة

54
00:07:10,380 --> 00:07:14,570
،لأوّل مرّة في حياتي
.تردّدت في الرّدّ على سيّدي

55
00:07:16,430 --> 00:07:18,840
...لا أصدّق أنّها عاجزة عن إنجاب وريث

56
00:07:18,840 --> 00:07:20,870
.سيخيب ظنّ الأسلاف

57
00:07:20,870 --> 00:07:23,630
،إنّها تملك الموهبة والكفاءة لتكون السّيّدة

58
00:07:23,630 --> 00:07:25,200
.ومع ذلك هي فاشلة

59
00:07:28,110 --> 00:07:31,340
.ليس الأمر وكأنّي أردتُ إنجاب طفل

60
00:07:31,990 --> 00:07:36,430
،لكن إن عجزت عن إنجاب واحد
.فلن أحصل على موافقة أقراني

61
00:07:36,430 --> 00:07:38,230
.سيقولون أنّي أقلّ منزلة

62
00:07:38,230 --> 00:07:41,130
.سيقولون أنّي معيبة بسبب عجز رحمي

63
00:07:42,110 --> 00:07:45,160
.لستُ أقلّ منزلة من أحد

64
00:07:45,160 --> 00:07:47,600
.لستُ فاشلة

65
00:08:00,020 --> 00:08:03,540
.سمّيت ابني آدم

66
00:08:03,790 --> 00:08:04,950
هل سمعت؟

67
00:08:04,950 --> 00:08:06,960
.يبدو أنّ الزّوج مات فجأة

68
00:08:07,430 --> 00:08:08,710
هل كان مريضًا؟

69
00:08:09,080 --> 00:08:11,010
.سمعتُ أنّه عاني الكثير

70
00:08:11,010 --> 00:08:13,450
.لا يهمّ، لديهم طفل الآن

71
00:08:13,450 --> 00:08:15,490
.لا سبب يدعو للقلق

72
00:08:18,520 --> 00:08:21,010
.ربّت المُرضعة ابني

73
00:08:21,010 --> 00:08:25,180
.لكنّه سرعان ما بدأ يتبع خطاي

74
00:08:54,220 --> 00:08:58,900
أمّي، عفوًا... إلى أين أنت ذاهبة؟

75
00:08:59,830 --> 00:09:01,830
هل تودّ مرافقتي؟

76
00:09:02,680 --> 00:09:03,730
.نعم

77
00:09:06,320 --> 00:09:07,540
ماذا تريد؟

78
00:09:07,540 --> 00:09:09,310
.لا... لا شيء

79
00:09:12,240 --> 00:09:16,860
،عندما رأيت كم كان صغيرًا ويائسًا
لم يسعني إلاّ أن أجده

80
00:09:16,860 --> 00:09:21,680
.ظريفًا بشكل لا يقاوم ومثيرًا للاشمئزاز بشدّة

81
00:09:31,910 --> 00:09:37,080
.نشأ هذا المخلوق اليائس بالطّريقة الّتي تمنّيتها

82
00:09:55,470 --> 00:09:59,540
أفكّر في استخدام موضوع التّجارب
.ذاك في تجربة طويلة الأمد

83
00:10:00,010 --> 00:10:03,030
يمكنك الاعتماد عليّ للتّخلّص منه عندما أنتهي

84
00:10:03,790 --> 00:10:04,870
.يا أمّي

85
00:10:06,320 --> 00:10:09,010
.لذلك لم أعر الأمر اهتمامًا كبيرًا

86
00:10:10,980 --> 00:10:11,980
.أمّي

87
00:10:13,010 --> 00:10:14,240
!آدم

88
00:10:18,210 --> 00:10:20,140
ما هذا الهراء؟

89
00:10:20,140 --> 00:10:22,820
!من أقنعك بهذا؟

90
00:10:22,820 --> 00:10:23,800
من يدري؟

91
00:10:24,940 --> 00:10:26,860
!إنّها تلك الفتاة

92
00:10:30,070 --> 00:10:32,080
.بحثتُ وبحثتُ عنه

93
00:10:32,080 --> 00:10:34,590
.إنّه مِلكي

94
00:10:38,040 --> 00:10:42,430
.قيل لي أنّه لم يظلّ منه ولو ذرّة واحدة

95
00:10:42,430 --> 00:10:46,920
،وأنّه بعد أن أطلق النّار على نفسه
.انهار وكأنّه عمود من الملح

96
00:10:46,920 --> 00:10:48,410
.سيّدتي ليزبث

97
00:10:52,400 --> 00:10:54,680
.كان وجهها يشبه ذلك المخلوق كثيرًا

98
00:10:54,900 --> 00:10:57,750
.لكنّها ورثت لونًا غير معهود

99
00:10:58,990 --> 00:11:00,230
هل أنت خائفة؟

100
00:11:00,690 --> 00:11:01,770
...إذًا

101
00:11:03,350 --> 00:11:08,960
!انسي أيّ ذكريات قد تجعلك تفتقدينهما

102
00:11:10,430 --> 00:11:12,090
.كرهتُها

103
00:11:12,800 --> 00:11:14,640
...عـ-عفوًا

104
00:11:15,920 --> 00:11:17,020
.جدّتي

105
00:11:17,020 --> 00:11:19,490
.أنهيت الأحجية

106
00:11:19,490 --> 00:11:20,580
.بمفردي

107
00:11:22,580 --> 00:11:25,090
.لا شيء مذهل في إنجازك هذا

108
00:11:25,090 --> 00:11:27,620
.لا تضيّعي وقتي بأنباء تافهة كهذه

109
00:11:28,610 --> 00:11:29,910
.آسفة

110
00:11:33,530 --> 00:11:37,000
.كان كلّ شيء حيالها يبدو أقلّ منزلة من آدم

111
00:11:44,160 --> 00:11:45,510
.نفس الشّعر

112
00:11:45,840 --> 00:11:47,900
.نفس الأطراف الواهية

113
00:11:48,160 --> 00:11:50,010
.نفس الصّوت المتردّد

114
00:11:51,150 --> 00:11:53,320
.إنّها تشبهه كثيرًا

115
00:11:59,260 --> 00:12:00,710
.ومع ذلك، لا

116
00:12:00,710 --> 00:12:01,940
...لا

117
00:12:02,340 --> 00:12:06,030
!هذا ليس ما أريده

118
00:12:19,430 --> 00:12:20,840
...فيلوميلا

119
00:12:35,600 --> 00:12:37,440
.إنّه ليس أمرًا

120
00:12:37,440 --> 00:12:38,880
.إنّه طلب على ما أظنّ

121
00:12:38,880 --> 00:12:40,880
أتريدين مزجه معًا لاحقًا؟

122
00:12:40,880 --> 00:12:42,620
!أنا أسألك عمّا تريدينه أنت

123
00:12:43,500 --> 00:12:44,460
!يكفي

124
00:12:44,460 --> 00:12:45,900
.أنت مذهلة يا فيلوميلا

125
00:12:45,900 --> 00:12:49,640
،ولكن حتّى إن اقترفت خطأ أو فشلت
.يمكنك المحاولة ثانية دائمًا

126
00:12:49,640 --> 00:12:52,860
!افعلي شيئًا وقولي ما تريدين

127
00:12:53,270 --> 00:12:54,360
!يكفي

128
00:12:55,040 --> 00:12:56,200
!رجاءً

129
00:12:59,320 --> 00:13:00,750
.طفلة جشعة

130
00:13:11,740 --> 00:13:18,720
عليّ التّضحية بالقوّة السّحريّة الّتي جُمعت
.لاستدعاء الكيان الإلهيّ المصوّر هنا

131
00:13:18,720 --> 00:13:20,600
...ولتحقيق تلك الغاية

132
00:13:23,940 --> 00:13:27,840
.أحتاجك يا فيلوميلا

133
00:13:35,490 --> 00:13:37,060
.يا له من شعور مقرف

134
00:13:38,380 --> 00:13:41,160
.إنّه شيء لزج

135
00:13:41,790 --> 00:13:42,760
هل أنتما بخير؟

136
00:13:43,590 --> 00:13:44,770
.تشيسي

137
00:13:44,770 --> 00:13:46,620
بل هل أنت بخير؟

138
00:13:46,620 --> 00:13:47,380
.نعم

139
00:13:48,590 --> 00:13:50,020
ما هذا؟

140
00:13:50,020 --> 00:13:51,800
ماذا حدث هنا؟

141
00:13:51,800 --> 00:13:54,300
.أعتقد أنّها كانت تمتصّ القوّة السّحريّة

142
00:13:55,030 --> 00:13:59,200
.فقدت فيلوميلا السّيطرة والتهمت أجسادنا بالكامل

143
00:13:59,200 --> 00:14:01,400
.فُصلنا لأشلاء لوهلة

144
00:14:01,650 --> 00:14:03,030
...لأشلاء

145
00:14:03,030 --> 00:14:09,220
.لـ-لكنّنا استطعنا العثور على كلّ أجزائنا بأنفسنا

146
00:14:09,220 --> 00:14:10,530
.وهكذا استطعنا العودة

147
00:14:10,930 --> 00:14:13,310
تمّت إعادة تجسيدنا؟

148
00:14:13,310 --> 00:14:14,210
.أظنّ ذلك

149
00:14:14,210 --> 00:14:16,540
.أريد تجفيف نفسي، لكنّي أشعر أنّي جافّة سلفًا

150
00:14:17,210 --> 00:14:19,950
.سأذهب للبحث عن فيلوميلا

151
00:14:19,950 --> 00:14:20,980
...وأنتما

152
00:14:20,980 --> 00:14:23,120
لا تتحرّكا لأنّ الوضع خطير"؟"

153
00:14:23,570 --> 00:14:27,390
.ما زلت لم أحصل على جواب منها

154
00:14:27,660 --> 00:14:29,260
.معك حقّ

155
00:14:29,260 --> 00:14:31,620
.تمّت مقاطعتنا في آخر مرّة

156
00:14:33,220 --> 00:14:34,460
.حسنًا

157
00:14:34,460 --> 00:14:36,340
.لنذهب ونسألها بشكل لائق إذًا

158
00:14:38,830 --> 00:14:44,480
.سيعود ابني، والدك، للمنزل اليوم

159
00:14:44,840 --> 00:14:47,230
.بالقوّة السّحريّة الّتي جمعتِها

160
00:14:47,230 --> 00:14:49,990
.بالدّماء الّتي تجري في عروقك

161
00:14:50,440 --> 00:14:52,800
.سيعود للمنزل

162
00:14:52,800 --> 00:14:57,510
.أستطيع إعادة والدتك أيضًا

163
00:14:58,050 --> 00:15:00,370
.والآن، لقد جهّزتُ كلّ شيء

164
00:15:01,020 --> 00:15:02,200
.تعالي

165
00:15:02,530 --> 00:15:05,780
.تعالي يا فيلوميلا

166
00:15:10,790 --> 00:15:14,270
.لستُ حرّة

167
00:15:14,710 --> 00:15:16,690
.لا أحتاج لإرادة خاصّة بي

168
00:15:17,140 --> 00:15:20,620
.لا شيء ممّا أفعله يهمّ

169
00:15:21,510 --> 00:15:25,440
.لا يُسمح لي بأيّ شيء

170
00:15:29,340 --> 00:15:30,310
...لكن

171
00:15:33,600 --> 00:15:36,280
...لكن... لكن

172
00:15:36,280 --> 00:15:39,430
ماذا أردتِ أن تفعلي؟

173
00:15:41,130 --> 00:15:44,020
هل كلّ ذلك صحيح بالفعل؟

174
00:15:52,860 --> 00:16:00,150
هل ستحقّقين أمنيتي فعلاً
وتعيدين أبي وأمّي للحياة؟

175
00:16:04,170 --> 00:16:07,350
أخبريني، أتعرفين أين هي؟

176
00:16:07,350 --> 00:16:07,990
.نعم

177
00:16:08,610 --> 00:16:10,140
.أستطيع أن أتبعها الآن

178
00:16:10,960 --> 00:16:13,240
.أستطيع أن أتبع رائحة روحها

179
00:16:19,270 --> 00:16:20,320
.أيّها الحرّاس

180
00:16:24,360 --> 00:16:27,000
.أمنياتك لا تهمّني

181
00:16:28,420 --> 00:16:31,840
.أحتاج دليلاً على أنّه كان موجودًا

182
00:16:32,320 --> 00:16:34,330
.لستُ كافية وحدي

183
00:16:34,830 --> 00:16:38,090
.أحتاج لقيد حديدي لإبقائه هنا

184
00:16:39,880 --> 00:16:44,860
.وأنت ستكونين القربان لذلك بصفتك ابنته

185
00:16:45,980 --> 00:16:47,020
...قربان

186
00:16:47,620 --> 00:16:50,220
.كنتِ فتاة مطيعة

187
00:16:50,220 --> 00:16:53,090
.امتثلتِ لكلّ الأوامر

188
00:16:53,090 --> 00:16:57,610
.ركّزت على جمع القوّة السّحريّة من عدّة أشخاص

189
00:16:57,890 --> 00:17:03,530
.لم تحاولي حتّى اكتشاف كيف سأستعمل تلك القوّة

190
00:17:05,600 --> 00:17:10,870
.أدّيت مهمّتك بكلّ إخلاص وبغباء تقريبًا

191
00:17:11,240 --> 00:17:13,740
.كنتِ بالفعل فتاة مطيعة جدًّا

192
00:17:22,650 --> 00:17:25,490
...لم أرغب حتّى في التّفكير

193
00:17:26,700 --> 00:17:33,110
.لماذا لا أستطيع تذكّر أبي وأمّي

194
00:17:33,750 --> 00:17:39,420
.لا بدّ أنّها اعتبرت ذلك غير ضروريّ من أجلي

195
00:17:40,960 --> 00:17:44,050
.هذا من شيمها بالفعل

196
00:17:53,130 --> 00:17:57,280
.هذا ها هنا هو يتطلّبه الأمر لاستدعاء السّيّد

197
00:18:01,050 --> 00:18:02,430
.كلّ هذا بلا فائدة

198
00:18:02,920 --> 00:18:04,450
.كلّه

199
00:18:15,590 --> 00:18:21,370
.كلّ ما فعلتُه حتّى الآن كان لأستطيع الموت

200
00:18:22,340 --> 00:18:26,870
.رغم أنّي الوحيدة الّتي تحمل دماءها

201
00:18:29,410 --> 00:18:31,120
.أردتُ أن أُحَبّ

202
00:18:31,940 --> 00:18:33,620
.أردت موافقتها

203
00:18:35,630 --> 00:18:38,640
.ذلك كلّ ما أردته

204
00:18:40,750 --> 00:18:47,060
.تشبّثت بالأمل، خاب ظنّي واستسلمت وخضعت

205
00:18:47,680 --> 00:18:49,740
.ثمّ تشبّث جزء منّي بالأمل ثانية

206
00:18:50,150 --> 00:18:52,530
.لكن كان لأجل لا شيء

207
00:18:52,950 --> 00:18:55,960
.ليس لديّ أيّ أحد

208
00:18:58,190 --> 00:18:59,640
أتريدين الذّهاب؟

209
00:18:59,640 --> 00:19:00,890
أم لا تريدين؟

210
00:19:01,870 --> 00:19:03,700
.سأساعدك حتّى تقرّرين

211
00:19:07,810 --> 00:19:08,820
!فيلوميلا

212
00:19:13,340 --> 00:19:14,370
.أيّها الحرّاس

213
00:19:15,790 --> 00:19:17,420
!إلياس! روث

214
00:19:20,540 --> 00:19:22,590
.لا يمكنكم إيقافي

215
00:19:22,590 --> 00:19:24,980
.دُفع الثّمن مُسبقًا

216
00:19:24,980 --> 00:19:25,750
!فيلوميلا

217
00:19:26,110 --> 00:19:29,930
.لا يمكنني إيقافك إن كانت هذه رغبتك

218
00:19:30,260 --> 00:19:31,890
ما الّذي تريدين أن يحدث لك؟

219
00:19:33,450 --> 00:19:34,270
!أيّ شيء

220
00:19:34,270 --> 00:19:37,390
!أكملي ما كنت ستقولينه فحسب

221
00:19:38,750 --> 00:19:42,410
.لهذا السّبب نحن هنا يا فيلوميلا

222
00:19:45,710 --> 00:19:47,720
من هي؟

223
00:19:46,710 --> 00:19:48,660
.أنت بارعة في مثل هذه الأشياء

224
00:19:47,880 --> 00:19:51,380
.لا رغبات لها

225
00:19:53,070 --> 00:19:55,520
.ليس لديّ أحد

226
00:19:57,840 --> 00:20:00,180
.يا لك من معلّمة جيّدة

227
00:20:00,180 --> 00:20:01,600
.لا تبد بخير على الإطلاق

228
00:20:01,600 --> 00:20:03,410
.لكن يُمكنك الحديث الآن

229
00:20:03,410 --> 00:20:04,250
.قولي ما تريدين

230
00:20:04,250 --> 00:20:06,940
،يمشي الأصدقاء والأعداء جبنًا إلى جنب

231
00:20:04,370 --> 00:20:07,730
.وما تريدين أن يفعله الآخرون لأجلك

232
00:20:06,940 --> 00:20:09,800
.وكلّ ما يمكنك فعله هو الصّراخ بما تريدين

233
00:20:08,040 --> 00:20:09,890
ما الّذي تريدينه بالضّبط؟

234
00:20:09,890 --> 00:20:11,050
ما أمنيتك؟

235
00:20:13,180 --> 00:20:18,210
...لو كان باستطاعتي أن أتمنّى

236
00:20:24,830 --> 00:20:26,260
!فساعدوني

237
00:20:32,080 --> 00:20:34,760
.لا تتسرّعي في لمس ذلك الشّيء

238
00:20:35,200 --> 00:20:37,690
.إنّه يمتصّ كلّ شيء

239
00:20:37,690 --> 00:20:39,160
!ماذا نفعل إذًا؟

240
00:20:39,160 --> 00:20:42,770
.تشيسي، استعملتِ سحرك لحلّ تلك الأحجية

241
00:20:42,770 --> 00:20:45,390
.كانت تحمل تلك الأحجية أنواعًا عدّة من الشّعوذة

242
00:20:45,390 --> 00:20:46,830
!حللتها بتعويذة سحريّة واحدة

243
00:20:47,730 --> 00:20:51,460
إسحاق، هل يمكنني استعمال تلك الأداة؟

244
00:20:51,460 --> 00:20:52,890
!ماذا؟ نعم

245
00:20:53,750 --> 00:20:56,290
!تصوّري ما تريدين تجسيده في ذهنك

246
00:20:57,040 --> 00:20:58,590
.لن تكون العصا كافية

247
00:20:59,030 --> 00:21:01,640
...أحتاج لشيء أقوى وأكثر حدّة

248
00:21:05,720 --> 00:21:07,190
.باشري

249
00:21:08,580 --> 00:21:12,420
.يا قفل التّابوت، أنا وتدك الحديديّ

250
00:21:13,030 --> 00:21:15,560
،بعويل وحوش العالم السّفليّ

251
00:21:15,560 --> 00:21:21,420
،احترق في السّهول
!وسأضع أنا يدي على التّابوت

252
00:21:41,640 --> 00:21:44,700
...كان يُفترض لتلك الدّائرة استدعاء كيان إلهيّ

253
00:21:44,700 --> 00:21:46,740
كيف يُعقل أنّ يتمّ إيقافها بمجرّد سحر؟

254
00:21:57,430 --> 00:22:01,770
.آسفة على التّأخير يا فيلوميلا

255
00:22:02,620 --> 00:22:07,530
.أنتم من ساعدوني على جمع أشلائي

256
00:22:11,000 --> 00:22:12,130
...تشيسي

257
00:22:14,590 --> 00:22:22,750
.لم أدرك أبدًا أنّي أردتُ دائمًا شخصًا ليساعدني

258
00:24:07,790 --> 00:24:10,960
.اختيار أهون الضّررَيْن