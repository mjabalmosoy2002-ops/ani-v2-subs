1
00:00:03,000 --> 00:00:04,270
.أعيدوهم

2
00:00:16,850 --> 00:00:18,020
.أعيدوهم

3
00:00:19,790 --> 00:00:21,150
!أعيدوهم

4
00:00:21,150 --> 00:00:22,630
!أعيدوا لنا أطفالنا

5
00:00:23,990 --> 00:00:29,600
!أعيدوا أطفالنا إلى قريتنا

6
00:00:30,240 --> 00:00:31,520
!أعيدوهم

7
00:01:11,860 --> 00:01:14,330
لا. ما الّذي دهاك؟

8
00:01:14,570 --> 00:01:15,580
...لا شيء

9
00:01:16,520 --> 00:01:19,670
.هناك شخص ما يبكي في مكان ما

10
00:01:20,720 --> 00:01:22,010
ماذا قلت؟

11
00:01:22,760 --> 00:01:26,700
.أتساءل ما سبب حزن ذلك الشّخص

12
00:03:04,920 --> 00:03:06,770
!مهلاً

13
00:03:05,250 --> 00:03:06,590
!هيّا

14
00:03:06,770 --> 00:03:08,420
ماذا تريد؟

15
00:03:08,420 --> 00:03:09,670
!كلاّ

16
00:03:10,580 --> 00:03:12,030
.حسنًا

17
00:03:14,720 --> 00:03:16,380
لماذا نحرث الأرض

18
00:03:16,380 --> 00:03:20,220
بعد وقت قصير من تعرّضنا لضرب
مبرح على يد تلك الوحوش؟

19
00:03:20,220 --> 00:03:24,760
سيكون علينا زرع طعامنا بأنفسنا الآن
بعد أن تمّ إغلاق الكلّيّة؟

20
00:03:33,110 --> 00:03:34,000
.اسمع

21
00:03:34,490 --> 00:03:37,860
.كنّا نتحدّث للتّوّ عن كم كنت رائعًا قبل قليل

22
00:03:37,860 --> 00:03:38,980
فعلاً؟

23
00:03:39,600 --> 00:03:42,730
.على عائلتي أن تكون سريعة لتتمكّن من الرّدّ

24
00:03:43,220 --> 00:03:47,210
.لم تبدُ بنفس البراعة في السّابق

25
00:03:47,570 --> 00:03:49,750
.لم تكن حتّى بارعًا في تسلّق الأشجار

26
00:03:52,760 --> 00:03:54,340
.كرهت الخسارة

27
00:03:56,740 --> 00:03:57,780
ماذا؟

28
00:03:57,780 --> 00:03:59,030
الخسارة أمام من؟

29
00:03:59,030 --> 00:04:00,700
.لا أريد إخباركما

30
00:04:01,460 --> 00:04:02,510
.هكذا إذًا

31
00:04:03,540 --> 00:04:06,020
فـ-في الماضي؟

32
00:04:06,890 --> 00:04:10,570
هل أنتما صديقان منذ الطّفولة؟

33
00:04:10,570 --> 00:04:13,020
.لعائلتينا الكثير من الأعمال معًا

34
00:04:13,020 --> 00:04:14,390
!أنتم هناك

35
00:04:14,390 --> 00:04:16,670
!أريد أن أراكم تعملون

36
00:04:16,670 --> 00:04:18,040
.حالاً

37
00:04:26,880 --> 00:04:28,310
.سيّدة فيلوميلا

38
00:04:28,310 --> 00:04:31,010
أنت ألكيوني، صحيح؟

39
00:04:31,010 --> 00:04:34,010
.يبدو أنّ فيلوميلا قد أُصيبت بتوعّك

40
00:04:36,150 --> 00:04:37,310
.سأضعها على الفراش

41
00:04:41,230 --> 00:04:41,920
من تكون؟

42
00:04:42,230 --> 00:04:46,250
.إنّها أشبه بأليفة فيلوميلا نوعًا ما

43
00:04:46,600 --> 00:04:49,170
ما هذا الجواب المبهم؟

44
00:04:51,540 --> 00:04:52,420
هل أنت بخير؟

45
00:04:53,280 --> 00:04:54,820
.سأذهب لإحضار بعض الماء

46
00:04:54,820 --> 00:04:56,940
.شكرًا لك. اذهبي رجاءً

47
00:05:03,750 --> 00:05:06,150
.غرفتها خالية تقريبًا

48
00:05:07,400 --> 00:05:09,010
ما كان الدّرس؟

49
00:05:09,880 --> 00:05:12,680
.كان علينا تدمير بعض الأليفين

50
00:05:12,680 --> 00:05:17,460
.هذه الفتاة لا تحبّذ أبدًا تدمير الأشياء

51
00:05:17,870 --> 00:05:20,390
.إنّها تمرض دائمًا

52
00:05:20,810 --> 00:05:21,870
دائمًا؟

53
00:05:22,990 --> 00:05:25,950
.فقدت وعيها في أوّل لقاء لنا أيضًا

54
00:05:25,950 --> 00:05:27,090
فعلاً؟

55
00:05:29,470 --> 00:05:30,690
...عفوًا

56
00:05:30,690 --> 00:05:32,010
...ألكيوني

57
00:05:32,010 --> 00:05:32,980
ماذا؟

58
00:05:33,440 --> 00:05:36,270
...هل فيلوميلا

59
00:05:41,130 --> 00:05:46,480
لماذا تقلقين كثيرًا عليّ؟

60
00:05:48,620 --> 00:05:52,420
.أنا أتجسّس دائمًا عليك وعلى زوي

61
00:05:53,160 --> 00:05:55,820
.لا أحاول التّحدّث أمام الآخرين

62
00:05:56,240 --> 00:06:01,130
.يجب أن تساورك الشّكوك حيالي

63
00:06:04,600 --> 00:06:06,120
.معك حقّ

64
00:06:06,900 --> 00:06:12,370
،كنتِ مريضة جدًّا في أوّل لقاء لنا

65
00:06:12,370 --> 00:06:15,160
.لكنّك تجاوبت معي فقط من باب اللّطف

66
00:06:15,570 --> 00:06:17,460
.حتّى أنّك شكرتني

67
00:06:18,070 --> 00:06:25,190
.وبالنّسبة لي، تبدين وكأنّك تعانين الكثير من الألم

68
00:06:27,180 --> 00:06:29,710
.كنتُ هكذا لوقت ليس ببعيد أيضًا

69
00:06:30,830 --> 00:06:35,640
.لذلك ظننتُ أنّي قد أستطيع الاستماع لك

70
00:06:36,680 --> 00:06:41,970
لكن إن كان هنالك شيء لا تريدين
.إخباري به، فلا بأس بذلك أيضًا

71
00:06:41,970 --> 00:06:44,330
وإن كان هنالك أمر تريدين
.إخباري به، فبإمكانك ذلك

72
00:06:44,900 --> 00:06:47,230
.أنت حرّة للقيام بما يحلو لك

73
00:06:48,170 --> 00:06:50,500
،كون المرء حرًّا صعب للغاية

74
00:06:51,400 --> 00:06:56,080
،ولكن حتّى إن اقترفت خطأ أو فشلت
.يمكنك المحاولة ثانية دائمًا

75
00:06:56,950 --> 00:06:58,170
.سيكون كلّ شيء بخير

76
00:07:01,590 --> 00:07:04,940
.لا أفهمك أبدًا

77
00:07:05,330 --> 00:07:07,000
تتحدّثين عن الحرّيّة؟

78
00:07:07,560 --> 00:07:09,500
لا بأس بالفشل؟

79
00:07:10,190 --> 00:07:13,040
.لم يخبرني أيّ أحد بذلك من قبل

80
00:07:15,270 --> 00:07:16,840
.أحضرت الماء

81
00:07:17,340 --> 00:07:18,990
.شكرًا يا لوسي

82
00:07:21,120 --> 00:07:25,470
.لا أفهم أيضًا ما تفكير فاعلي الخير هذا أيضًا

83
00:07:25,820 --> 00:07:28,730
.واثقة أنّها مجرّد أنانيّة فحسب

84
00:07:29,060 --> 00:07:30,370
ما الخطب؟

85
00:07:30,370 --> 00:07:31,860
.اشربي

86
00:07:31,860 --> 00:07:33,450
.ستشعرين بتحسّن ولو قليلاً

87
00:07:36,680 --> 00:07:37,800
.لا بأس

88
00:07:38,480 --> 00:07:39,950
.لنذهب يا تشيسي

89
00:07:40,410 --> 00:07:42,520
.نعم، معك حقّ

90
00:07:42,520 --> 00:07:44,740
.لا أريد لزيارتي أن تكون طويلة

91
00:07:44,740 --> 00:07:46,610
.لا تضغطي على نفسك كثيرًا
.حاولي أن ترتاحي

92
00:07:48,350 --> 00:07:49,860
.شكرًا لك

93
00:07:55,930 --> 00:07:57,930
.راح ذلك الماء خسارة

94
00:07:59,250 --> 00:08:06,160
لا يجب علينا شرب أو أكل أو استعمال
.أيّ شيء يعطيه لنا شخص آخر

95
00:08:06,820 --> 00:08:09,320
.لا يمكن الجزم بما فيها

96
00:08:09,970 --> 00:08:12,600
.هذا ما تلقّنه بعض العائلات لأبنائها

97
00:08:13,160 --> 00:08:15,080
.يبدو أنّ ذلك هو الحال بالنّسبة لها أيضًا

98
00:08:15,760 --> 00:08:17,550
...ما يعني

99
00:08:18,100 --> 00:08:20,670
هل يمكنك إبلاغي بنتائج هذا لاحقًا؟

100
00:08:21,640 --> 00:08:24,020
.شـ-شكرًا لك

101
00:08:25,090 --> 00:08:26,360
ماذا؟

102
00:08:26,360 --> 00:08:29,650
.أنا أنانيّة بالفعل

103
00:08:30,130 --> 00:08:33,240
.كما أنّ فيلوميلا لطيفة للغاية

104
00:08:34,580 --> 00:08:36,990
.بتصرّف الجميع بأنانيّة بعض الشّيء

105
00:08:37,300 --> 00:08:42,120
ما كنت لأثق بأيّ شخص يلبّي
.رغبات الآخرين على حسابه نفسه

106
00:08:42,790 --> 00:08:45,680
.لا يمكن الجزم بما قد يفعله يومًا ما

107
00:08:48,060 --> 00:08:50,170
.أنت طيّبة أيضًا

108
00:08:51,090 --> 00:08:54,920
.لا أعرف ما الّذي قد تفعلينه أنت أيضًا
.أنا لا أثق بك

109
00:08:54,920 --> 00:08:56,730
ماذا؟ ما سبب قولك لهذا؟

110
00:09:01,440 --> 00:09:04,090
...هناك أمور كثيرة أردت أن أسأل عنها

111
00:09:04,090 --> 00:09:08,630
لكنّي لم أستطع فعل ذلك نظرًا
.للحالة الّتي هي فيها

112
00:09:12,670 --> 00:09:14,620
...ذاك الطّفل حينها

113
00:09:16,030 --> 00:09:21,550
مستحيل أن يكونوا قد قتلوا أيّ أحد
.إن كانوا يواجهون صعوبة هكذا في قتل أليف

114
00:09:24,050 --> 00:09:26,030
.أحتاج دلائل أكثر

115
00:09:47,010 --> 00:09:48,270
لماذا؟

116
00:09:50,210 --> 00:09:51,600
...لماذا لا أستطيع

117
00:09:52,870 --> 00:09:59,520
لماذا لا أستطيع شرب ماء أو شاي
قدّمه لي آخرون؟

118
00:10:03,090 --> 00:10:04,820
...في الماضي

119
00:10:06,110 --> 00:10:07,630
.ألكيوني

120
00:10:07,630 --> 00:10:11,610
،قبلتِ بكلّ شيء طُلب منك
.مهما كان مزعجًا

121
00:10:11,610 --> 00:10:13,140
.كنت تنصاعين فحسب

122
00:10:13,900 --> 00:10:15,850
.أمّا الآن فلا

123
00:10:16,540 --> 00:10:17,830
لماذا؟

124
00:10:20,280 --> 00:10:21,890
.لا أدري

125
00:10:21,890 --> 00:10:23,380
...لأنّها

126
00:10:30,830 --> 00:10:32,100
.لا أدري

127
00:10:32,640 --> 00:10:34,070
...لكن

128
00:10:34,070 --> 00:10:37,700
.لكّني ما عدت أتحمّل هذا

129
00:10:40,150 --> 00:10:43,360
تمّ الكشف عن تسجيل مجموعة
.من المفردات الجديدة

130
00:10:43,890 --> 00:10:46,010
.جار إبلاغ الرّسالة

131
00:10:46,470 --> 00:10:47,420
ألكيوني؟

132
00:10:48,760 --> 00:10:56,440
فيلوميلا، لن أتساهل بعد الآن بشأن
.إضاعة الفرص الّتي أمنحك إيّاها

133
00:10:57,430 --> 00:11:00,040
...صوت جدّتي

134
00:11:00,500 --> 00:11:05,540
من المستحيل أن تتمكّن من التّواصل
.أو إرسال طيور بهذه السّهولة والكلّيّة مغلقة

135
00:11:05,540 --> 00:11:06,840
رسالة؟

136
00:11:06,840 --> 00:11:10,020
سُجّلت في رأس ألكيوني مسبقًا؟

137
00:11:10,020 --> 00:11:13,230
.ليس لديّ منزل لفاشلة مثلك

138
00:11:11,930 --> 00:11:14,380
أنا؟

139
00:11:14,380 --> 00:11:18,250
،إن كان ما اكتسبته هو شيء سخيف مثل الصّداقة

140
00:11:18,250 --> 00:11:22,180
.سأضطرّ للتّفكير في طريقة للتّعامل معك

141
00:11:19,400 --> 00:11:20,920
.لا يمكنني الهرب

142
00:11:22,960 --> 00:11:25,780
.وإلاّ، افعلي ما تُؤمرين به

143
00:11:25,780 --> 00:11:28,120
.أدّي دورك

144
00:11:28,760 --> 00:11:32,520
،إن كنت ترغبين برؤية والدك ووالدتك

145
00:11:32,520 --> 00:11:36,630
.لا يجب أن يكون لديك وقت حتّى للتّذمّر

146
00:11:37,050 --> 00:11:38,530
.انتهت الرّسالة

147
00:11:38,530 --> 00:11:40,540
.ستُمحى الرّسالة

148
00:11:41,700 --> 00:11:42,750
سيّدتي فيلوميلا؟

149
00:11:43,280 --> 00:11:44,960
هل من خطب ما؟

150
00:11:53,880 --> 00:11:55,300
كيف لي أن أساعدك؟

151
00:11:57,930 --> 00:12:02,020
لا بدّ أنّك كنت على علم كم
.أنّ معاملات الكلّيّة الورقيّة مزعجة

152
00:12:02,020 --> 00:12:04,960
.مرّ وقت طويل وقد نسيت ذلك تمامًا

153
00:12:04,960 --> 00:12:08,580
.إنّها مجرّد تواقيع، لذلك سأتدبّر أمري

154
00:12:09,280 --> 00:12:13,410
هل وصلت أيّ طلبات مذّاك الحين من
عائلة سيرجنت بشأن مغادرتها المدرسة؟

155
00:12:13,850 --> 00:12:15,330
.لا شيء حتّى الآن

156
00:12:15,810 --> 00:12:19,570
،إنّنا نراقب تلك الأليفة، ولكن حسب ما نرى

157
00:12:19,570 --> 00:12:21,700
.فإنّ قدراتها محدودة

158
00:12:22,340 --> 00:12:27,650
لا أعتقد أنّها صُنعت لتقبل بأوامر
.معقّدة جدًّا، ناهيك عن تنفيذها

159
00:12:28,050 --> 00:12:30,590
.أشكّ إن كان بمقدورها فعل أيّ شيء سوى مجالسة سيّدتها

160
00:12:31,240 --> 00:12:33,380
.كلّ ما بوسعنا فعله هو الانتظار

161
00:12:33,810 --> 00:12:36,400
هل هناك أيّ شيء يستحقّ الذّكر منذ الإغلاق؟

162
00:12:36,870 --> 00:12:37,890
.ليس تمامًا

163
00:12:37,890 --> 00:12:40,320
.لم يتعرّض أحد للهجوم أيضًا

164
00:12:40,990 --> 00:12:45,690
.أفترض أنّ الكتاب السّحريّ في الخارج سلفًا

165
00:12:46,170 --> 00:12:50,610
لا أصدّق أنّ هنالك شخصًا يدور
.هنا في الأرجاء ومعه ذلك الشّيء

166
00:12:51,720 --> 00:12:55,580
.سيمسك به السّاحران إن كان الحظّ لصالحنا

167
00:13:04,440 --> 00:13:05,440
.صباح الخير

168
00:13:05,440 --> 00:13:06,100
.تأخّرت

169
00:13:06,100 --> 00:13:07,540
.آسف

170
00:13:07,540 --> 00:13:12,150
حسنًا، هل نبدأ بالبحث عن الكتاب السّحريّ؟

171
00:13:46,390 --> 00:13:47,580
!هذا مقرف

172
00:13:47,580 --> 00:13:48,960
هذا كلّ شيء؟

173
00:13:48,960 --> 00:13:52,400
.أنت أكبر منّي بمئات السّنوات بالفعل

174
00:13:52,400 --> 00:13:54,210
!أنت اليافعون قذرون

175
00:13:54,210 --> 00:13:57,800
.وأحضرت معك عملاً غريبًا بالفعل

176
00:13:57,800 --> 00:14:00,640
!كنتُ لأعضّك لو لم تكوني من رفاقي

177
00:14:17,080 --> 00:14:21,340
.الرّائحة خافتة، لكن هذا هو الطّريق

178
00:14:21,950 --> 00:14:23,080
.هيّا بنا

179
00:14:37,380 --> 00:14:42,350
كيف استطعتِ قراءة ذلك الكتاب
السّحريّ على أيّ حال؟

180
00:14:42,930 --> 00:14:45,230
.ما زال دماغي يرتجف

181
00:14:45,230 --> 00:14:49,360
.كان الأمر قبل عشر سنوات... أو ربّما خمسة

182
00:14:49,970 --> 00:14:58,780
،بعد إجبار بيليس على الانعزال
.كنت أبحث عن حلّ باستماتة

183
00:14:59,630 --> 00:15:05,050
.وهناك وجدت منزلاً يبيع كتبًا وأدوات سحريّة

184
00:15:05,790 --> 00:15:07,600
.هذا غير اعتياديّ

185
00:15:07,600 --> 00:15:11,290
ألا يعتبر هذا كبيع المشعوذ لروحه؟

186
00:15:11,760 --> 00:15:14,490
.ربّما كانوا يواجهون ضائقة ماليّة

187
00:15:14,490 --> 00:15:16,300
واشتريته؟

188
00:15:17,180 --> 00:15:21,640
،لكانت خسارة كبيرة إن أشتريه
.ولم يضمّ المعلومات الّتي أردت

189
00:15:21,640 --> 00:15:24,830
.لذلك توسّلت إليهم أن يدعوني أقرؤه

190
00:15:24,830 --> 00:15:27,600
.مع أنّهم طلبوا منّي مقابلاً ضخمًا على ذلك

191
00:15:28,170 --> 00:15:34,360
لكن في النّهايّة، لم أردت تحمّل
.المسؤوليّة ورفضت شراءه

192
00:15:34,840 --> 00:15:36,810
.هكذا إذًا

193
00:15:36,810 --> 00:15:37,920
...مهلاً

194
00:15:39,270 --> 00:15:42,150
.صارت الرّائحة أضعف بكلّ تأكيد

195
00:15:42,770 --> 00:15:46,460
...لا يبدو أنّهم يتربّصون لنا

196
00:15:47,090 --> 00:15:50,460
.بل يبدو أشبه بأنّهم يجولون المكان لتضليلنا

197
00:15:51,250 --> 00:15:53,670
.أفترض أنّ وقت الزّيارة قد حان

198
00:16:18,120 --> 00:16:19,860
ماذا لدينا هنا؟

199
00:16:20,520 --> 00:16:23,630
كيف لي أن أساعد ساحرة مثلك؟

200
00:16:23,630 --> 00:16:26,350
.حتّى أنّك أحضرت مستذئبًا معك أيضًا

201
00:16:26,350 --> 00:16:28,950
.أنا من السّاحرات أيضًا

202
00:16:29,210 --> 00:16:32,880
هل رأيت شخصًا يجول المنطقة
حاملاً كتابًا مثيرًا للشّبهات؟

203
00:16:32,880 --> 00:16:34,290
كتاب مثير للشّبهات؟

204
00:16:34,680 --> 00:16:36,080
.لا تهتمّي لذلك

205
00:16:36,080 --> 00:16:37,000
!انظري

206
00:16:37,810 --> 00:16:41,100
.إنّها صناديق خادعة لإبعاد العفاريت الصّغيرة

207
00:16:41,100 --> 00:16:43,070
.سأعرضها عليك بثمن بخس

208
00:16:43,070 --> 00:16:45,190
.اثنان بعملة واحدة

209
00:16:45,650 --> 00:16:46,570
ما قولك؟

210
00:16:52,750 --> 00:16:54,320
.سآخذ خمسة

211
00:16:56,140 --> 00:16:59,650
.أريد المزيد من السّكّر

212
00:16:59,930 --> 00:17:02,550
!جيّد، جيّد

213
00:17:02,550 --> 00:17:06,750
.أحبّ السّاحرات اللاّتي لسن بخيلات

214
00:17:07,360 --> 00:17:11,840
.كنت جاهزًا لأكلك لو أنّك أحجمت

215
00:17:12,470 --> 00:17:14,160
.المعذرة

216
00:17:20,370 --> 00:17:22,390
.يا له من كتاب فظيع

217
00:17:23,300 --> 00:17:29,500
لكان أيّ غبيّ ليلاحظ إن كان هنالك
.شخص يحمل شيئًا مثله

218
00:17:31,160 --> 00:17:35,900
.الكثير ممّا يصنعه البشر غير كامل

219
00:17:36,480 --> 00:17:40,440
.سأعلمك بمجرّد أن أجد ما تبحثين عنه

220
00:17:40,880 --> 00:17:46,630
.احرصي على إحضار المزيد من العملات معك

221
00:17:54,140 --> 00:17:58,210
.حسنًا، أخبريني أين ذلك الفتى الشّقيّ

222
00:18:15,680 --> 00:18:16,650
...هل أتخيّل فحسب أم

223
00:18:16,910 --> 00:18:18,190
.هناك الكثير منها

224
00:18:18,190 --> 00:18:19,240
.ذلك ما ظننت

225
00:18:19,240 --> 00:18:26,080
التّمرين

226
00:18:19,240 --> 00:18:26,080
ترجموا التّالي إلى الإنجليزيّة

227
00:18:19,870 --> 00:18:26,070
ما زالت الامتحانات جزءًا من الدّراسة
.وإن كانت الكلّيّة مغلقة

228
00:18:26,070 --> 00:18:29,580
عفوًا، ما معنى هذه؟

229
00:18:29,580 --> 00:18:33,310
.لا أستطيع معرفة المقصود، مهما قرأتها

230
00:18:33,310 --> 00:18:34,550
أيّ واحدة؟

231
00:18:37,860 --> 00:18:40,160
...تقصد هذه

232
00:18:40,160 --> 00:18:45,180
.آسفة، تخطّيتها أنا أيضًا. لم أفهمها

233
00:18:45,180 --> 00:18:48,690
ألم يكن المعنى مكتوبًا في دفتر آخر؟

234
00:18:48,690 --> 00:18:50,370
ماذا؟! أين هو؟

235
00:18:50,730 --> 00:18:51,580
.هناك

236
00:18:51,580 --> 00:18:54,430
.إنّ هذا ليس شعوذة أو ما شابه
.إنّها مجرّد لغة أخرى

237
00:18:54,430 --> 00:18:55,790
.استعمل القاموس

238
00:18:55,790 --> 00:18:59,430
.افخري بي فقط لأنّي أتكلّم الإنجليزيّة

239
00:18:59,730 --> 00:19:04,290
.إنجليزيّة الكلّيّة صعبة للغاية

240
00:19:05,070 --> 00:19:08,510
.هذه مشكلة أكبر حتّى من الشّعوذة

241
00:19:09,220 --> 00:19:11,400
أنت ساحرة، صحيح؟

242
00:19:11,400 --> 00:19:13,340
ألهذا أيّ أهمّيّة عندك من الأساس؟

243
00:19:13,340 --> 00:19:19,720
،أنا معفيّة من القيام بالأمور السّحريّة
.لكن ما زال عليّ جمع نقاط كافية

244
00:19:19,720 --> 00:19:22,210
إذًا ما الّذي يوجد "الكثير منها"؟

245
00:19:22,470 --> 00:19:23,600
.الغولم

246
00:19:24,080 --> 00:19:26,550
،إنّها دائمًا ما تجول السّاحة وطوابق الحديقة

247
00:19:27,150 --> 00:19:30,050
.لكنّها في الطّوابق العاديّة الأخرى أيضًا

248
00:19:30,050 --> 00:19:31,590
.وكأنّها حرّاس

249
00:19:32,830 --> 00:19:35,180
.هُوجمنا من الخارج

250
00:19:35,180 --> 00:19:37,180
.بالطّبع هنالك حرس في الجوار

251
00:19:37,180 --> 00:19:38,910
.هذا صحيح

252
00:19:39,390 --> 00:19:40,980
.سأذهب للبحث عن مَراجع

253
00:19:41,480 --> 00:19:42,330
.حسنًا

254
00:19:46,160 --> 00:19:50,660
.لا تنوي لوسي إخبار أحد أنّها من هُوجمت

255
00:20:03,840 --> 00:20:05,420
.لقد غادرت

256
00:20:06,490 --> 00:20:07,090
ماذا؟

257
00:20:12,130 --> 00:20:14,920
...ألكيوني تشبه نوعًا ما

258
00:20:16,060 --> 00:20:19,780
.إلياس إن كان طفلاً

259
00:20:23,320 --> 00:20:27,670
.تشيسي، زوي، وجدت كتابًا مفيدًا

260
00:20:27,670 --> 00:20:28,700
.تعاليا لقراءته

261
00:20:28,700 --> 00:20:30,360
فـ-فعلاً؟

262
00:20:30,360 --> 00:20:31,630
وجدته لأجلنا؟

263
00:20:31,840 --> 00:20:33,280
!شكرًا

264
00:20:33,280 --> 00:20:34,510
.وجدته بالصّدفة

265
00:20:36,720 --> 00:20:39,760
هل أنت معجب بفيلوميلا يا ريان؟

266
00:20:39,760 --> 00:20:40,540
!ماذا؟

267
00:20:42,140 --> 00:20:44,340
.إنّك حادّ الطّباع معها

268
00:20:44,340 --> 00:20:49,170
قلت في نفسي أنّه يمكن أن يكون ذلك
.النّوع من الحبّ المزعج والتّقليديّ

269
00:20:50,130 --> 00:20:52,340
.تمّ اختيار الشّخص الّذي سأتقاسم معه حياتي سلفًا

270
00:20:53,070 --> 00:20:55,150
.وهي ليست ذلك الشّخص

271
00:20:55,660 --> 00:20:59,650
أجد أنّ جهل النّاس بقيمتهم الخاصّة
.أمرًا محبطًا للغاية فحسب

272
00:21:00,460 --> 00:21:01,930
ماذا عنك؟

273
00:21:01,930 --> 00:21:02,730
أنا؟

274
00:21:03,300 --> 00:21:05,730
.يبدو لي أنّك تحميها كثيرًا منّي

275
00:21:06,330 --> 00:21:07,820
ما الغاية من ذلك؟

276
00:21:10,890 --> 00:21:12,420
ما رأيك أنت؟

277
00:21:13,280 --> 00:21:15,590
!هذا مؤلم! مؤلم! مؤلم

278
00:21:15,590 --> 00:21:16,930
!توقّف أيّها الغبيّ

279
00:21:16,930 --> 00:21:18,420
!كفّ عن قرصي

280
00:21:17,050 --> 00:21:20,040
.أكره امتناع النّاس عن إعطائي إجابة مباشرة

281
00:21:19,300 --> 00:21:20,980
!هذا مؤلم! مؤلم! مؤلم

282
00:21:20,980 --> 00:21:22,010
.أكره ذلك

283
00:21:21,340 --> 00:21:22,630
ماذا يفعلانه؟

284
00:21:27,020 --> 00:21:28,120
.سيّدتي المديرة

285
00:21:30,810 --> 00:21:32,080
نعم؟

286
00:21:32,080 --> 00:21:35,020
.انتهى السّاحران من المهمّة

287
00:21:35,600 --> 00:21:38,060
.أحسنت يا حارس البوّابة

288
00:21:54,910 --> 00:21:57,160
داخل الكلّيّة

289
00:21:58,440 --> 00:22:02,890
.إذًا فذلك الكتاب المشؤوم ما زال في الكلّيّة

290
00:22:21,410 --> 00:22:24,970
.ربّما أنا عطشانة أو ما شابه