1
00:00:09,770 --> 00:00:11,070
.هذا متعب

2
00:00:12,390 --> 00:00:16,190
.لم أعلم أبدًا أنّ استعمال العين سيكون متعبًا جدًّا

3
00:00:17,020 --> 00:00:20,880
لطالما تعرّضت لسخرية الآخرين لأنّي
.لم أستطع استعمال العين كما يجب

4
00:00:23,300 --> 00:00:28,580
ولكن هذه المرّة، سيكون الأمر أسوأ
.بكثير من التّعرّض للسّخرية فحسب

5
00:02:00,010 --> 00:02:06,020
.من لدغته الأفعى يخاف من الحبل

6
00:02:08,660 --> 00:02:09,880
...لا فائدة

7
00:02:09,880 --> 00:02:11,580
.إنّها تقترب

8
00:02:14,110 --> 00:02:15,110
ماذا؟

9
00:02:15,520 --> 00:02:17,380
.هناك شيء فوضويّ يحدث

10
00:02:17,380 --> 00:02:18,400
...هذا مريب

11
00:02:19,070 --> 00:02:22,030
.لا أظنّ أنّ هذا... يحتاج ليكون كذلك

12
00:02:31,560 --> 00:02:33,580
.نلت منك

13
00:02:34,320 --> 00:02:42,250
كان لا بدّ من تحويل شيء لا حاجة له
.إلى حجارة وكسره لقطع صغيرة

14
00:03:18,090 --> 00:03:19,700
...قطيعي

15
00:03:20,260 --> 00:03:22,130
...زوجي

16
00:03:22,130 --> 00:03:24,760
...أطفالي

17
00:03:29,400 --> 00:03:31,840
...ما الّذي

18
00:03:34,890 --> 00:03:36,250
...طفلي

19
00:03:36,250 --> 00:03:39,820
.لستُ طفلك

20
00:03:40,310 --> 00:03:42,690
إذًا فأنت... إلهي؟

21
00:03:42,690 --> 00:03:43,700
ماذا؟

22
00:03:43,700 --> 00:03:48,840
لقد أبطلتَ اللّعنة الخبيثة
.الّتي أُلقيت عليّ

23
00:03:49,680 --> 00:03:53,290
.لذلك فأنا أذكر كلّ شيء الآن

24
00:03:54,820 --> 00:03:56,420
.سأغادر

25
00:03:57,330 --> 00:03:59,700
.شكرًا يا إلهي

26
00:04:12,340 --> 00:04:14,350
.عليها أن ترتاح

27
00:04:17,590 --> 00:04:18,850
!سيّدتي فيلوميلا

28
00:04:19,520 --> 00:04:22,600
.بدأ جسدها يتفتّت

29
00:04:27,270 --> 00:04:31,220
.سأعيد ما عُهد به لي

30
00:04:36,310 --> 00:04:39,370
فصل الرّوح عن الجسد؟

31
00:04:39,680 --> 00:04:46,030
نعم. أفترض أنّه بفصل روحك عن
،جسدك وتخزينها في مكان آخر

32
00:04:46,030 --> 00:04:50,540
.فلن يتمكّن ذلك السّاحر من ملاحظتك

33
00:04:51,150 --> 00:04:51,860
.فهمت

34
00:05:13,370 --> 00:05:16,820
،حتّى بعودة روحها إليها
.يواصل جسدها في التّفتّت

35
00:05:19,740 --> 00:05:21,330
لماذا إذًا؟

36
00:05:22,410 --> 00:05:26,630
.صُنعتُ خصّيصًا لأجل هذه الطّفلة

37
00:05:27,400 --> 00:05:28,730
فلماذا...؟

38
00:05:31,710 --> 00:05:34,700
.إنّها نفس رائحتي

39
00:05:42,080 --> 00:05:43,810
.هذه هي بالفعل

40
00:05:43,810 --> 00:05:45,280
.إنّها رائحة فيلوميلا

41
00:05:46,080 --> 00:05:48,040
.لا يوجد أحد هنا

42
00:05:48,280 --> 00:05:52,570
يفترض أن يكون مثل هذا القصر
.الكبير مليئًا بالنّاس

43
00:05:52,570 --> 00:05:53,980
...صحيح

44
00:05:54,540 --> 00:06:00,490
.لربّما تكون قد جذبت كلّ البشر لساحة المعركة

45
00:06:01,190 --> 00:06:04,670
.إنّها سيّدة فوضى الحرب

46
00:06:05,080 --> 00:06:06,730
من تكون؟

47
00:06:06,730 --> 00:06:09,510
.ذاك ما يحدث لإلهة قديمة عندما تُنسى

48
00:06:10,280 --> 00:06:11,260
...إلهة

49
00:06:11,960 --> 00:06:14,800
—مهلاً، ما الّذي تتحدّثان

50
00:06:18,530 --> 00:06:21,140
.إنّها ألكيوني

51
00:06:21,140 --> 00:06:22,430
أين هي؟

52
00:06:22,430 --> 00:06:25,500
هل تبحثون عن السّيّدة فيلوميلا؟

53
00:06:25,500 --> 00:06:27,610
وهل هناك سبب آخر لتواجدنا هنا؟

54
00:06:28,020 --> 00:06:30,470
ليس مكان الكتاب السّحريّ؟

55
00:06:31,320 --> 00:06:33,140
.ذلك ليس أولويّة عندنا

56
00:06:33,620 --> 00:06:36,540
.نحن هنا لأنّنا لا نريد أن تموت فيلوميلا

57
00:06:38,390 --> 00:06:40,770
.تعالوا لغرفة المكتب في الطّابق الثّاني

58
00:06:40,770 --> 00:06:42,750
.ولكن الأطفال وحدهم

59
00:06:43,150 --> 00:06:45,440
.أطلب منك البقاء هنا

60
00:06:46,160 --> 00:06:47,940
لماذا أنا فقط؟

61
00:06:47,940 --> 00:06:52,400
أنت لا تفكّر في مصلحتها، صحيح؟

62
00:06:56,180 --> 00:06:58,710
.تشيسي، اسبقيني أنت

63
00:07:00,020 --> 00:07:01,890
.سأوافيك قريبًا

64
00:07:10,380 --> 00:07:11,470
!تلك هي الغرفة

65
00:07:15,210 --> 00:07:16,250
!فيلوميلا

66
00:07:21,630 --> 00:07:24,780
.التّميمة الواقية تعمل بالفعل

67
00:07:24,780 --> 00:07:25,980
...المزيد

68
00:07:26,700 --> 00:07:27,860
!فيلوميلا

69
00:07:30,800 --> 00:07:31,550
!تشيسي

70
00:07:37,760 --> 00:07:40,380
!لا تلمسي وجهي

71
00:07:40,380 --> 00:07:41,920
.شكرًا يا إسحاق

72
00:07:42,890 --> 00:07:43,930
...لوسي

73
00:07:44,280 --> 00:07:45,290
لوسي؟

74
00:07:46,660 --> 00:07:49,160
ما هذا؟

75
00:07:49,160 --> 00:07:50,190
!لوسي

76
00:07:58,270 --> 00:07:59,870
!أريد تفسيرًا

77
00:08:01,830 --> 00:08:02,910
...أنا

78
00:08:03,340 --> 00:08:06,200
.أنا آسفة

79
00:08:07,720 --> 00:08:09,520
!لا أريد أسفك

80
00:08:09,520 --> 00:08:11,470
!بل أريد تفسيرًا لهذا

81
00:08:12,360 --> 00:08:15,190
،أخذت كلّ شيء منّي

82
00:08:15,190 --> 00:08:18,430
.ومع ذلك تتظاهرين وكأنّك ضحيّة غافلة

83
00:08:18,430 --> 00:08:21,220
!لا يحقّ لك أن تشعري بالخوف

84
00:08:25,280 --> 00:08:26,580
...لكن

85
00:08:26,580 --> 00:08:31,190
!ولكنّ ذلك هو كلّ ما سُمح لي بفعله

86
00:08:31,450 --> 00:08:33,850
!لا شيء فعلته كان كافيًا

87
00:08:34,270 --> 00:08:36,600
!كلّ ما فعلته كان بلا قيمة

88
00:08:36,600 --> 00:08:38,370
!كنت فاشلة

89
00:08:38,810 --> 00:08:43,780
...كنتُ أوبَّخ وأُضرب وأُحبس

90
00:08:45,150 --> 00:08:48,920
.كنتُ قلقة من أن تعبث برأسي

91
00:08:49,370 --> 00:08:50,550
.كنتُ خائفة

92
00:08:50,950 --> 00:08:52,100
.خائفة جدًّا

93
00:08:52,570 --> 00:08:54,810
.كلّ ما بوسعي هو الاعتذار

94
00:08:55,520 --> 00:08:59,040
،لكن إن لم يعد ذلك كافيًا

95
00:09:00,350 --> 00:09:03,770
!ماذا يفترض بي فعله؟

96
00:09:05,640 --> 00:09:08,080
...أرجوك... أخبريني

97
00:09:09,320 --> 00:09:13,370
أخبريني إن كنت تعتقدين
!أنّي مذنبة لذلك الحدّ

98
00:09:15,910 --> 00:09:16,530
!تشيسي

99
00:09:20,000 --> 00:09:20,930
.حسنًا

100
00:09:33,010 --> 00:09:34,350
...قوّة سحريّة

101
00:09:34,350 --> 00:09:35,420
...تتدفّق

102
00:09:36,520 --> 00:09:39,750
لماذا؟

103
00:09:54,220 --> 00:09:55,210
.تشيسي

104
00:09:58,060 --> 00:10:00,620
ما هذا المكان؟

105
00:10:07,770 --> 00:10:09,070
هل أنت بخير؟

106
00:10:09,940 --> 00:10:12,250
.يبدو أنّك صرتِ قطعًا متناثرة

107
00:10:12,750 --> 00:10:16,210
.لنجمع قِطعك بينما نبحث أن الآخرَيْن

108
00:10:16,760 --> 00:10:17,950
من أنت؟

109
00:10:18,860 --> 00:10:20,370
.أنا تشيسي

110
00:10:20,980 --> 00:10:24,010
.أنت فيلوميلا

111
00:10:29,080 --> 00:10:30,710
.وجدتُ إحدى القطع

112
00:10:31,260 --> 00:10:33,090
.لنواصل

113
00:10:35,530 --> 00:10:38,980
هل نحن في المدرسة؟

114
00:10:51,630 --> 00:10:53,540
ما هذه؟

115
00:10:59,810 --> 00:11:03,120
.اعتدنا أن نلعب بها أنا وريان

116
00:11:04,510 --> 00:11:06,670
.كنّا جارَيْن

117
00:11:06,670 --> 00:11:08,380
.اعتدنا اللّعب معًا أحيانًا

118
00:11:08,980 --> 00:11:11,710
.لم يكن بارعًا في أيّ شيء

119
00:11:12,700 --> 00:11:14,370
.أعلم ذلك

120
00:11:15,600 --> 00:11:17,620
.كنتُ بارعة في هذه

121
00:11:18,730 --> 00:11:22,610
.لكنّ جدّتي لم تُثني عليّ أبدًا

122
00:11:32,480 --> 00:11:34,250
ماذا عن هذا المكان؟

123
00:11:39,800 --> 00:11:44,280
.كنتُ أُحبس هنا لوقت طويل إن عصيت الأوامر

124
00:11:44,820 --> 00:11:53,080
أعتقد أنّ هذا حدث عندما لم أستطع حفظ الكتاب
.الّذي كان يفترض بي حفظه في الوقت المناسب

125
00:11:53,960 --> 00:11:55,080
فعلاً؟

126
00:11:55,560 --> 00:11:59,070
.المكان هنا بارد ومظلم ورطب

127
00:11:59,070 --> 00:12:00,740
.يا له من مكان فظيع

128
00:12:02,000 --> 00:12:07,150
.لكنّها كانت تتركني وشأني بعد هذا

129
00:12:07,150 --> 00:12:09,670
.ما كانت تقول لي أيّ شيء فظيع

130
00:12:09,670 --> 00:12:10,670
...لذلك

131
00:12:11,520 --> 00:12:13,910
لكنّك ظللتِ خائفة، صحيح؟

132
00:12:16,210 --> 00:12:16,980
.نعم

133
00:12:17,430 --> 00:12:18,710
.كنت خائفة

134
00:12:24,910 --> 00:12:27,230
ماذا عن هذا المكان؟

135
00:12:29,930 --> 00:12:32,340
.إنّها مريبة للغاية

136
00:12:32,340 --> 00:12:33,430
.وكئيبة

137
00:12:33,430 --> 00:12:36,630
لقد تحدّثت هاتوري مع
.شخص ما من الفصل ب

138
00:12:36,630 --> 00:12:38,620
.ماذا؟ مستحيل

139
00:12:38,620 --> 00:12:39,630
.هذا مخيف

140
00:12:39,630 --> 00:12:41,140
.أراهن أنّها ملعونة

141
00:12:46,090 --> 00:12:47,280
.المكان الخاطئ

142
00:12:47,280 --> 00:12:49,100
.كانت ذلك قطعة منّي

143
00:12:49,100 --> 00:12:51,060
.أعتقد أنّ الأمور اختلطت علينا

144
00:12:52,780 --> 00:12:54,050
اختلطت؟

145
00:12:55,010 --> 00:12:59,420
ينتهي بي الأمر في أحلام النّاس
.وذكرياتهم وما شابه

146
00:12:59,420 --> 00:13:01,740
.يحدث هذا طوال الوقت

147
00:13:03,590 --> 00:13:05,120
فعلاً؟

148
00:13:13,150 --> 00:13:14,570
.هذه الصّورة

149
00:13:19,510 --> 00:13:24,820
.لا أعرف كيف يبدو وجه أبي أو وجه أمّي

150
00:13:25,310 --> 00:13:28,320
.ترفض جدّتي أن تريني أيّ صور لهما

151
00:13:28,320 --> 00:13:31,290
.لا أدري حتّى إن كان لها صور

152
00:13:31,730 --> 00:13:33,030
فعلاً؟

153
00:13:34,280 --> 00:13:39,600
.لم أرَ أبدًا صورًا لأبي أو أمّي أيضًا

154
00:13:39,600 --> 00:13:41,660
.أمّي ماتت

155
00:13:50,970 --> 00:13:51,950
.لنذهب

156
00:13:55,820 --> 00:13:59,400
.السّيّدة في مزاج سيّئ دائمًا بسببها

157
00:14:00,240 --> 00:14:02,900
.يا لها من مصدر إزعاج

158
00:14:02,900 --> 00:14:04,910
.أتمنّى لو تختفي فحسب

159
00:14:06,530 --> 00:14:09,230
.تنتظرك السّيّدة ليزبث في مكتبها

160
00:14:09,910 --> 00:14:12,880
.واضح أنّها لا تعتبرها حفيدة لها

161
00:14:13,790 --> 00:14:15,570
.إنّها جبانة كالعادة

162
00:14:14,530 --> 00:14:16,970
تشبه من على أيّ حال؟

163
00:14:18,550 --> 00:14:21,510
.لا أصدّق أنّ ليزبث لم تتخلّى عنها بعد

164
00:14:21,510 --> 00:14:24,860
كيف تفشلين في شيء بهذه البساطة؟

165
00:14:32,330 --> 00:14:35,450
.حصلنا على كلّ القطع الّتي أضعتِها

166
00:14:36,750 --> 00:14:37,550
.نعم

167
00:14:41,040 --> 00:14:44,820
هل كانت هناك أمور كثيرة تخيفك أيضًا؟

168
00:14:44,820 --> 00:14:46,830
.نعم، أمور كثيرة

169
00:14:47,320 --> 00:14:49,360
.كنتُ خائفة ووحيدة

170
00:14:49,670 --> 00:14:51,690
.فكّرتُ في الطّيران فحسب

171
00:14:56,430 --> 00:14:59,500
لماذا جمعتِ قِطعي؟

172
00:15:00,120 --> 00:15:03,250
.لم أفعل أيّ شيء من أجلك

173
00:15:03,750 --> 00:15:07,230
.بل وحاولتُ قتلك

174
00:15:08,510 --> 00:15:13,160
.حملني الكثير من النّاس أيضًا

175
00:15:14,180 --> 00:15:17,220
.قطعةً قطعة

176
00:15:18,530 --> 00:15:24,770
.ولكن في الحقيقة، لديك نفس عيناي في السّابق

177
00:15:25,650 --> 00:15:28,720
لذلك أظنّني كنت أرغب في مساعدة
.نفسي في الماضي بمساعدتك

178
00:15:30,880 --> 00:15:36,580
آسفة لأنّي لا أستطيع إخبارك
.أنّي أردتُ مساعدتك بالتّحديد

179
00:15:37,250 --> 00:15:42,370
حتّى إن كنتِ قد قلتِ أنّ ذلك
.لأجلي، فما كنتُ لأصدّقك

180
00:15:43,190 --> 00:15:49,110
لو أنّي سمعتُ ذلك، لرغبتُ
.في الذّهاب لمكان بعيد جدًّا

181
00:15:51,300 --> 00:15:52,480
.يمكنك ذلك

182
00:15:53,080 --> 00:15:54,240
.بل لا يمكنني

183
00:15:54,630 --> 00:15:57,740
.ليس مسموحًا لي بذلك

184
00:15:58,450 --> 00:15:59,300
أتريدين الذّهاب؟

185
00:16:00,090 --> 00:16:02,080
أم تريدين البقاء؟

186
00:16:02,850 --> 00:16:04,390
.لا أعرف

187
00:16:04,390 --> 00:16:06,300
.سأساعدك حتّى تعرفين

188
00:16:06,810 --> 00:16:09,750
.لنواصل جمع القِطع

189
00:16:14,920 --> 00:16:16,320
.ثمّة شخص ما هنا

190
00:16:17,610 --> 00:16:19,300
.ما عدت أتحمّل

191
00:16:19,300 --> 00:16:22,050
.يقارنني الجميع بأختي وريان

192
00:16:22,050 --> 00:16:25,060
.لا يتوقّع أيّ أحد شيئًا منّي

193
00:16:27,380 --> 00:16:31,260
لماذا وُلدتُ في هذه العائلة؟

194
00:16:39,060 --> 00:16:40,260
.إسحاق

195
00:16:41,710 --> 00:16:43,350
.فيلوميلا

196
00:16:44,710 --> 00:16:46,360
أتذكُر الآن؟

197
00:16:46,360 --> 00:16:48,230
.نـ-نعم

198
00:16:48,230 --> 00:16:50,710
.كان ذلك محرجًا

199
00:16:50,710 --> 00:16:51,520
فعلاً؟

200
00:16:51,520 --> 00:16:54,910
.أقصد أنّه ليس على الرّجال البكاء

201
00:16:54,910 --> 00:16:57,190
.لا... لا أدري

202
00:16:57,190 --> 00:16:58,810
.لم أفكّر أبدًا في ذلك

203
00:17:01,510 --> 00:17:03,280
.بقي أن نجد لوسي فحسب

204
00:17:03,280 --> 00:17:05,150
لماذا في المكتبة؟

205
00:17:05,150 --> 00:17:07,640
.تحبّ لوسي الدّراسة

206
00:17:12,240 --> 00:17:14,170
.خذي يا فيلوميلا

207
00:17:14,170 --> 00:17:15,140
.أظنّه لك

208
00:17:17,500 --> 00:17:19,230
.حسنًا، هيّا بنا

209
00:17:21,770 --> 00:17:23,930
.خيوط العنكبوت في كلّ مكان

210
00:17:23,930 --> 00:17:25,430
أما زال يمكننا التّقدّم؟

211
00:17:25,430 --> 00:17:26,690
.لا أدري

212
00:17:29,930 --> 00:17:31,280
!هذا مؤلم

213
00:17:31,690 --> 00:17:32,740
ماذا؟

214
00:17:32,740 --> 00:17:33,780
لوسي؟

215
00:17:33,780 --> 00:17:36,010
أكنت تبحثين عنّا؟

216
00:17:36,010 --> 00:17:37,480
!بالطّبع

217
00:17:38,140 --> 00:17:42,960
لماذا قد أجلس هنا فقط وأواصل البكاء؟

218
00:17:43,260 --> 00:17:44,610
كنت تبكين؟

219
00:17:44,610 --> 00:17:45,990
.كنت تبكين

220
00:17:45,990 --> 00:17:46,990
!اخرسا

221
00:17:47,310 --> 00:17:50,660
بكيت كثيرًا لدرجة أنّه لا يمكنني
.النّسيان وإن رغبت في ذلك

222
00:17:50,660 --> 00:17:53,610
جعلُ المرءِ نفسه حزينًا على الماضي
.أمر بائس فحسب

223
00:17:54,230 --> 00:17:56,770
!لذلك أريد أن أغضب

224
00:17:56,770 --> 00:17:59,210
.أريد أن يتغيّر شيء ما

225
00:17:59,210 --> 00:18:00,310
...بتلك الطّريقة

226
00:18:04,290 --> 00:18:06,530
.لن يكون عليّ البقاء ساكنة

227
00:18:10,700 --> 00:18:13,240
.رأيتك تغضبين قبل قليل أيضًا

228
00:18:13,760 --> 00:18:16,520
،لذلك لماذا لا تكفّين عن النّواح

229
00:18:16,520 --> 00:18:20,320
!وتهربين، أو تفعلي وتقولي أيّ شيء تريدينه؟

230
00:18:20,320 --> 00:18:21,250
!غبيّة

231
00:18:23,880 --> 00:18:24,710
.خذي

232
00:18:27,780 --> 00:18:31,710
.حان الوقت لتعتادي على الأمر أيضًا

233
00:18:32,150 --> 00:18:36,810
.اتبعي هاذين وراقبي جيّدًا

234
00:18:38,120 --> 00:18:39,040
.كلاّ

235
00:18:40,470 --> 00:18:45,580
.عسى أن يحميك اللّيل دائمًا

236
00:18:46,060 --> 00:18:47,050
!كلاّ

237
00:18:47,050 --> 00:18:48,150
!توقّف

238
00:18:48,150 --> 00:18:49,400
!توقّف في الحال

239
00:18:50,490 --> 00:18:53,410
لم يقتلا الابنة؟

240
00:18:53,990 --> 00:18:57,170
.ربّما كانا يفكّران في أطفالهما

241
00:18:57,640 --> 00:18:59,140
.حسنًا، لا يهمّ

242
00:18:59,140 --> 00:19:00,990
.حصلنا على العناكب

243
00:19:01,440 --> 00:19:03,260
عناكب...؟

244
00:19:03,860 --> 00:19:09,030
.فيلوميلا، الاغتيال هو أحد واجبات هذه العائلة

245
00:19:07,660 --> 00:19:09,030
!لا تشاهدي

246
00:19:09,790 --> 00:19:12,110
.لديّ هديّة لك

247
00:19:12,110 --> 00:19:15,730
إن نجحت في استعمال هذا الكتاب

248
00:19:15,730 --> 00:19:18,870
،لجمع القوّة السّحريّة من عدّة مشعوذين

249
00:19:18,870 --> 00:19:25,970
فسأكون قادرة على إعادة والدك
.آدم ووالدتك للحياة ثانية

250
00:19:25,970 --> 00:19:29,020
.لقد طال الانتظار

251
00:19:29,020 --> 00:19:31,800
.اعثري على ضحايا داخل الكلّيّة

252
00:19:34,230 --> 00:19:36,570
.يمكنك ذلك

253
00:19:37,230 --> 00:19:40,070
،أعلم أنّي كنت صارمة معك

254
00:19:40,070 --> 00:19:43,490
.لكنّ ذلك كان دائمًا من أجل صالحك

255
00:19:44,060 --> 00:19:48,480
.أنت فتاة جيّدةٌ وكفؤٌ يا فيلوميلا

256
00:19:49,340 --> 00:19:52,530
أثق أنّك ستنجحين في هذا، صحيح؟

257
00:19:52,530 --> 00:19:53,950
!يكفي

258
00:19:57,400 --> 00:19:58,850
.كنتِ أنت

259
00:19:59,630 --> 00:20:01,570
.كنتِ أنت هناك في ذلك اليوم

260
00:20:03,800 --> 00:20:06,610
!لماذا قتلتم عائلتي؟

261
00:20:07,130 --> 00:20:08,190
!لا أعرف

262
00:20:08,190 --> 00:20:09,510
!بل تعرفين

263
00:20:08,950 --> 00:20:12,530
!لم أُمنح الحقّ لأعرف أبدًا

264
00:20:12,530 --> 00:20:17,640
وإلاّ هل كان عليّ فقط إخبارك
!أنّي كنتُ هناك حينها؟

265
00:20:17,640 --> 00:20:21,570
!هل كان عليّ الاعتذار لك لأنّي لم أستطع إيقافهما؟

266
00:20:21,570 --> 00:20:22,760
...ما كنتُ

267
00:20:23,020 --> 00:20:25,620
!ما كنتُ أبدًا لأقوم بشيء كهذا

268
00:20:27,440 --> 00:20:30,750
.أخبريني ماذا كان عساي أن أفعل

269
00:20:31,270 --> 00:20:34,360
ماذا كان بإمكاني فعله وقتها؟

270
00:20:38,700 --> 00:20:41,580
.لا يستطيع أحد إعطاءك جوابًا على ذلك

271
00:20:42,730 --> 00:20:45,820
.يمكنك قول أيّ شيء

272
00:20:46,570 --> 00:20:50,190
.لا يستطيع أحد مساعدة الآخر في الماضي

273
00:20:50,800 --> 00:20:54,250
.لكن يُمكنك الحديث الآن

274
00:20:54,760 --> 00:20:56,120
.قولي ما تريدين

275
00:20:56,120 --> 00:20:57,630
.وما لا تريدين أن يُفعل بك

276
00:20:58,070 --> 00:21:00,060
.وما تريدين أن يفعله الآخرون لأجلك

277
00:21:01,500 --> 00:21:02,750
...وهكذا

278
00:21:04,120 --> 00:21:08,780
.يمكن لأحد ما يودّ مساعدتك أن يمدّ يده لك

279
00:21:11,930 --> 00:21:12,860
!ليس لديّ أيّ أحد

280
00:21:13,490 --> 00:21:14,950
!لا أملك أيّ أحد هكذا

281
00:21:14,950 --> 00:21:19,400
.حتّى إن لم يكن لديك، أريدك أن تصرخي بذلك

282
00:21:19,400 --> 00:21:21,370
.إن أردت أن يتغيّر شيء ما

283
00:21:21,770 --> 00:21:27,860
آمل أن تحصلي على المساعدة حتّى
.وإن لم تضطرّي للصّراخ أو البكاء

284
00:21:30,250 --> 00:21:34,530
.لكنّ العالم لا يسير هكذا

285
00:21:35,350 --> 00:21:38,000
،يمشي الأصدقاء والأعداء جبنًا إلى جنب

286
00:21:38,530 --> 00:21:41,390
.وكلّ ما يمكنك فعله هو الصّراخ بما تريدين

287
00:21:43,310 --> 00:21:45,470
ما الّذي تريدينه بالضّبط؟

288
00:21:46,240 --> 00:21:47,510
ماذا تتمنّين؟

289
00:21:50,740 --> 00:21:52,510
...أنا

290
00:22:02,690 --> 00:22:03,420
...سا

291
00:22:04,590 --> 00:22:06,360
.ساعدوني

292
00:22:10,900 --> 00:22:13,060
أهذا فعلاً ما تريدينه؟

293
00:22:16,320 --> 00:22:17,220
!فيلوميلا

294
00:24:07,710 --> 00:24:11,050
.أعط اللّصّ ما يكفي من الحبل وسيشنق نفسه