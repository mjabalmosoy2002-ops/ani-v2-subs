1
00:00:06,470 --> 00:00:07,750
...تبًّا

2
00:00:10,380 --> 00:00:14,430
.من الجيّد أنّي طلبتُ تعويذة حماية

3
00:00:14,990 --> 00:00:15,900
ماذا؟

4
00:00:17,170 --> 00:00:19,590
.ظننتُ أنّي وجدت جثّة مثاليّة

5
00:00:21,030 --> 00:00:22,790
.لكنّك لا تزال حيًّا

6
00:02:00,270 --> 00:02:01,400
هل استيقظت؟

7
00:02:03,940 --> 00:02:05,450
.لا تتحرّك

8
00:02:07,630 --> 00:02:11,800
لماذا استيقظت باكرًا هكذا؟

9
00:02:14,550 --> 00:02:17,750
.أرى أنّك تعلّمت كيف تمشطين شعر الآخرين

10
00:02:17,750 --> 00:02:19,780
.أقوم بهذا لتغادر بسرعة

11
00:02:20,710 --> 00:02:21,740
!هذا مؤلم

12
00:02:21,740 --> 00:02:23,500
.كوني أكثر لطفًا

13
00:02:25,930 --> 00:02:27,040
.لوسي

14
00:02:27,040 --> 00:02:27,950
تشيسي؟

15
00:02:29,280 --> 00:02:30,880
...مهلاً، أليس هذا

16
00:02:32,790 --> 00:02:34,640
.أنا طلبته

17
00:02:35,110 --> 00:02:36,580
.لا تهتمّي لذلك يا لوسي

18
00:02:36,580 --> 00:02:40,270
لم تلقي نظرة على وثائقك البنكيّة على الإطلاق، صحيح؟

19
00:02:41,510 --> 00:02:44,010
!أخبرتك أنّني لن أستعمل مالك

20
00:02:44,010 --> 00:02:46,100
.تحقّقي منها على الأقلّ

21
00:02:52,010 --> 00:02:54,370
!مـ-مليون جنيه؟

22
00:02:54,680 --> 00:02:56,420
!ما هذا المال؟

23
00:02:56,420 --> 00:02:59,330
!لم تتورّط في أعمال إجراميّة من نوع ما، صحيح؟

24
00:03:00,270 --> 00:03:05,170
أعتقد أنّ ما فعلتُه يمكن اعتباره
.إنسانيًّا للغاية في عالم المشعوذين

25
00:03:10,360 --> 00:03:13,350
بالمناسبة، هل تعرفان بعضكما؟

26
00:03:13,350 --> 00:03:14,640
...عفوًا

27
00:03:14,640 --> 00:03:17,400
.أنقذ السّيّد سِث حياتي

28
00:03:17,400 --> 00:03:18,490
كيف؟

29
00:03:18,490 --> 00:03:19,560
...ذلك

30
00:03:20,410 --> 00:03:21,460
.سرّ

31
00:03:21,460 --> 00:03:26,240
سئمت من عادتك هذه حيث تتوقّفين
!عن الكلام قبل أن قولي ما يجب قوله

32
00:03:26,240 --> 00:03:28,000
!سأمزّق وجهك

33
00:03:33,800 --> 00:03:35,320
.غادر فحسب

34
00:03:35,320 --> 00:03:36,510
.سأودّعك

35
00:03:36,510 --> 00:03:37,930
.سأذهب لتغيير ملابسي الآن

36
00:03:41,810 --> 00:03:45,210
أهي أختك بالفعل؟

37
00:03:45,880 --> 00:03:48,210
.كنتُ أعتني بها بدلاً من والدينا

38
00:03:48,920 --> 00:03:52,120
.أنا أقرب لوالد لها من كوني أخوها الآن

39
00:03:55,340 --> 00:04:02,550
ياسوود وهود ونيتساح وتيفيريت
...وحوخما وكيتير

40
00:04:03,620 --> 00:04:05,180
.جارٍ النّقل

41
00:04:22,080 --> 00:04:23,960
.يبدو أنّك استيقظت

42
00:04:24,400 --> 00:04:25,570
أيمكنك التّنفّس؟

43
00:04:26,100 --> 00:04:27,320
.بالكاد

44
00:04:28,320 --> 00:04:29,450
أين أنا؟

45
00:04:30,200 --> 00:04:31,460
مكتب الممرّضة؟

46
00:04:31,460 --> 00:04:32,260
.نعم

47
00:04:32,260 --> 00:04:33,460
.المكتب الآخر

48
00:04:34,040 --> 00:04:38,710
لكنتَ في ورطة كبيرة لو لم يتشارك معك
.إينزوورث قوّته السّحريّة

49
00:04:38,710 --> 00:04:39,650
!القوّة السّحريّة؟

50
00:04:39,650 --> 00:04:40,640
.لا تتحرّك

51
00:04:41,140 --> 00:04:43,220
.سأضح لك حقنة وريديّة

52
00:04:43,220 --> 00:04:44,380
.لا تتحرّك من مكانك

53
00:04:48,840 --> 00:04:50,060
ماذا حدث؟

54
00:04:50,540 --> 00:04:54,070
.كنتَ مطروحًا أرضًا عند الأشجار في الحديقة

55
00:04:54,070 --> 00:04:56,230
.كنتُ مارًّا من هناك بالصّدفة

56
00:04:56,230 --> 00:04:57,450
الحديقة؟

57
00:04:57,450 --> 00:04:59,540
...لا أذكر أنّني ذهبت إليها

58
00:05:04,260 --> 00:05:05,780
أكان هنالك شخص ما؟

59
00:05:05,780 --> 00:05:06,850
...لا

60
00:05:06,850 --> 00:05:08,520
.لا أستطيع التّذكّر

61
00:05:10,370 --> 00:05:14,460
تشاركت قوّتك السّحريّة معي؟

62
00:05:14,460 --> 00:05:16,710
.شكرًا لك. أعلم أنّ ذلك نفيس

63
00:05:17,270 --> 00:05:20,470
.لا أتشاركها كثيرًا، لكنّها ليست نفيسة أيضًا

64
00:05:20,470 --> 00:05:21,750
هكذا إذًا؟

65
00:05:22,400 --> 00:05:25,500
.شكرًا لك يا سيّد إينزوورث

66
00:05:31,460 --> 00:05:36,300
.اقترح توري أن أجعلك صديقًا لي

67
00:05:36,850 --> 00:05:38,770
ما معنى ذلك؟

68
00:05:52,590 --> 00:05:55,050
هل أنت واثقة فعلاً أنّك لست بحاجة للنّوم أكثر؟

69
00:05:55,050 --> 00:05:58,740
.قلتُ أنّني بخير، لذلك أنا بخير

70
00:05:59,030 --> 00:06:00,980
.أرأيت؟ إنّها عنيدة

71
00:06:09,060 --> 00:06:09,950
ماذا؟

72
00:06:09,950 --> 00:06:11,270
.إنّه ليس هنا

73
00:06:11,270 --> 00:06:12,720
تقصد حارسك؟

74
00:06:18,310 --> 00:06:21,250
.وأخيرًا، أتيتما أنتما الاثنين إلى هنا

75
00:06:26,720 --> 00:06:27,730
!أخي

76
00:06:30,950 --> 00:06:33,160
.تعويذة حماية

77
00:06:33,160 --> 00:06:36,050
ماذا تقصد بنحن الاثنان؟

78
00:06:36,050 --> 00:06:38,530
.يبدو أنّ لديك شأنا ما مع آل وبستر

79
00:06:43,170 --> 00:06:44,200
!أنت

80
00:06:48,000 --> 00:06:50,500
.تراجعي أيّتها السّاحرة

81
00:06:50,500 --> 00:06:52,760
.هذا لا يخصّك

82
00:06:52,760 --> 00:06:54,090
.لا يمكنني فعل ذلك

83
00:06:54,090 --> 00:06:55,150
!تشيسي

84
00:06:55,150 --> 00:06:57,180
!خذي أختي واهربي

85
00:06:57,180 --> 00:06:58,610
.لن أسمح بحدوث أيّ شيء لك

86
00:07:03,870 --> 00:07:04,770
!روث

87
00:07:24,220 --> 00:07:26,880
.اذهبا للمكتبة يا سيّد سِث ولوسي

88
00:07:29,460 --> 00:07:30,740
!أرجوك يا روث

89
00:07:38,270 --> 00:07:40,150
من يكونان يا سيّد سِث؟

90
00:07:40,150 --> 00:07:42,260
.آسف لأنّني ورّطتك في الأمر

91
00:07:42,560 --> 00:07:45,780
.كنتُ آمل أن يكونا قد استسلما الآن

92
00:07:48,020 --> 00:07:49,540
...هذان الوغدان

93
00:07:53,660 --> 00:07:54,900
!إلياس

94
00:07:55,410 --> 00:07:56,590
...الظّلّ

95
00:07:57,450 --> 00:07:59,270
هل تأذّيت يا تشيسي؟

96
00:07:59,270 --> 00:08:00,450
.قليلاً فحسب

97
00:08:01,870 --> 00:08:02,930
.فهمت

98
00:08:18,420 --> 00:08:19,430
!أخي

99
00:08:27,400 --> 00:08:29,200
!لا أستطيع استعمال شعوذتي

100
00:08:34,100 --> 00:08:35,020
!لوسي

101
00:08:35,370 --> 00:08:36,660
هل أنت بخير؟

102
00:08:37,310 --> 00:08:38,890
...سُحقًا

103
00:08:39,800 --> 00:08:41,610
كنتما أنتما، صحيح؟

104
00:08:41,610 --> 00:08:43,500
!أنتما من قتل عائلتي

105
00:08:52,290 --> 00:08:54,800
.فشلنا في إنهاء المهمّة

106
00:08:54,800 --> 00:08:57,870
.سننهيها اليوم

107
00:08:58,880 --> 00:09:00,680
.علينا الهرب لمكان ما

108
00:09:02,250 --> 00:09:06,220
تعلمين أين عليك الذّهاب، صحيح؟

109
00:09:17,370 --> 00:09:18,390
.تشيسي

110
00:09:26,260 --> 00:09:27,260
!مهلاً

111
00:09:27,260 --> 00:09:28,320
...إلى أين

112
00:09:28,660 --> 00:09:30,380
.سأشرح لاحقًا

113
00:09:30,380 --> 00:09:31,370
.أغلقي عينيك

114
00:09:31,370 --> 00:09:32,680
.لا تقولي أيّ شيء

115
00:09:33,190 --> 00:09:34,590
.مهما حدث

116
00:09:39,440 --> 00:09:40,790
.فهمت

117
00:09:42,500 --> 00:09:43,630
.اذهبا

118
00:09:44,630 --> 00:09:48,380
.لا أهتمّ ما قد يحصل لذلكما الشّقيقين

119
00:10:02,460 --> 00:10:03,530
.إنّهم هنا

120
00:10:19,060 --> 00:10:21,230
.هذا متاعي فحسب

121
00:10:21,230 --> 00:10:22,650
.أنا أحمله معي لا غير

122
00:10:22,650 --> 00:10:24,280
ماذا عن رسم المرور؟

123
00:10:25,050 --> 00:10:26,490
.لا أحمله الآن

124
00:10:26,490 --> 00:10:27,950
.هذا خرق للعقد

125
00:10:27,950 --> 00:10:29,070
.كلاّ

126
00:10:29,070 --> 00:10:32,180
.نحن نمرّ من هنا ببعض المتاع

127
00:10:32,180 --> 00:10:35,370
،أعد أن أحضر اللّحم في المرّة القادمة
.إن كان هذا ما تريدونه

128
00:10:35,800 --> 00:10:38,320
.احترموا العقد ودعونا نمرّ

129
00:10:44,650 --> 00:10:47,650
.ذراع غريبة... إنّها لا تنتمي لك

130
00:10:47,650 --> 00:10:48,800
!أعطني إيّاها

131
00:10:49,900 --> 00:10:51,040
.لا

132
00:10:51,720 --> 00:10:52,790
.مفقود

133
00:10:52,790 --> 00:10:53,710
.خاطئ

134
00:10:53,710 --> 00:10:57,130
.ليس في العقد

135
00:10:55,330 --> 00:10:56,030
.أشتمّه

136
00:10:57,440 --> 00:10:59,420
...إن لم يكن في العقد

137
00:11:00,080 --> 00:11:01,750
!فإنّه فريسة

138
00:11:11,720 --> 00:11:12,910
!لحم

139
00:11:12,910 --> 00:11:14,740
!لحم طازج

140
00:11:14,740 --> 00:11:17,020
!لحم! لحم

141
00:11:17,460 --> 00:11:19,650
!ابتعدوا عن زوجتي

142
00:11:19,650 --> 00:11:20,850
ذئاب؟

143
00:11:34,180 --> 00:11:35,050
!كلاّ

144
00:11:35,050 --> 00:11:36,940
!زوجي

145
00:11:36,940 --> 00:11:38,020
!كلاّ

146
00:11:38,470 --> 00:11:39,920
.عليّ الذّهاب

147
00:11:39,920 --> 00:11:41,060
!عليّ المساعدة

148
00:11:41,470 --> 00:11:44,520
!علي الذّهاب للمساعدة

149
00:11:46,960 --> 00:11:49,480
!ابننا

150
00:11:54,470 --> 00:11:55,720
!توقّفوا

151
00:11:57,980 --> 00:12:00,980
.سأدفع مقابل مرورهما

152
00:12:00,980 --> 00:12:02,520
.هذه المرّة فقط

153
00:12:02,520 --> 00:12:04,520
.لذلك، دعوهما يذهبان

154
00:12:06,330 --> 00:12:07,710
.أحتاج بشريًّا

155
00:12:08,960 --> 00:12:10,510
.لا يمكنني ذلك

156
00:12:10,510 --> 00:12:14,300
.أستطيع تأمين خروف أو بقرة على الأرجح

157
00:12:14,820 --> 00:12:16,710
.خروف أو كلب

158
00:12:16,710 --> 00:12:19,790
.بقدر عدد الأشخاص الّذين ليسوا في العقد

159
00:12:21,860 --> 00:12:22,750
.حسنًا

160
00:12:23,030 --> 00:12:24,840
.سأحضرها بمجرّد أن تجهز

161
00:13:24,110 --> 00:13:25,560
هل أنت بخير؟

162
00:13:25,560 --> 00:13:26,940
.نعم، أنا بخير

163
00:13:26,940 --> 00:13:28,370
.يا لك من غبيّ

164
00:13:28,370 --> 00:13:30,310
.لا يمكنك حتّى استعمال الشّعوذة

165
00:13:30,310 --> 00:13:31,250
...لماذا

166
00:13:36,850 --> 00:13:39,950
.أنا مسرور لأنّك لم تتأذّي

167
00:13:44,820 --> 00:13:45,790
!أنت

168
00:13:46,210 --> 00:13:48,590
!أرى أنّك آمن أيّها المغفّل

169
00:13:48,590 --> 00:13:51,080
أنت على قيد الحياة؟

170
00:13:51,080 --> 00:13:52,050
.سيّدة مارييل

171
00:13:53,220 --> 00:13:56,320
.أقدّر أنّ كلانا شخص واسع الحيلة

172
00:13:56,320 --> 00:13:57,750
.شكرًا كثيرًا

173
00:13:57,750 --> 00:14:01,210
.كادت هذه الجشعة أن تسلبني كلّ ما أملك

174
00:14:01,210 --> 00:14:02,100
ماذا؟

175
00:14:02,100 --> 00:14:03,790
.لقد أنقذتك

176
00:14:03,790 --> 00:14:06,520
.بالطّبع سآخذ مقابلاً لذلك

177
00:14:06,520 --> 00:14:07,440
.مارييل

178
00:14:08,150 --> 00:14:09,640
.أنا مسرور برؤيتك

179
00:14:10,310 --> 00:14:12,690
.هناك أمر أريدك أن تتحرّي عنه

180
00:14:12,690 --> 00:14:13,600
ماذا؟

181
00:14:18,180 --> 00:14:19,270
.تفضّل

182
00:14:19,610 --> 00:14:21,190
.شكرًا جزيلاً لك

183
00:14:26,440 --> 00:14:34,530
سيّد سِث، هل ما حدث اليوم
له علاقة بعائلتك بشكل ما؟

184
00:14:38,550 --> 00:14:40,260
.نحن عائلة من المشعوذين

185
00:14:40,260 --> 00:14:42,000
.هذا وارد الحدوث

186
00:14:45,070 --> 00:14:46,850
!أخي

187
00:14:49,080 --> 00:14:50,940
!هل ستغادر المنزل فعلاً؟

188
00:14:52,590 --> 00:14:53,980
.لوسي

189
00:14:53,980 --> 00:14:55,420
.ما باليد حيلة

190
00:14:55,420 --> 00:14:56,660
لماذا...؟

191
00:14:57,650 --> 00:14:58,670
.سِث

192
00:14:59,030 --> 00:15:01,030
هل انتهيت من جمع حقائبك؟

193
00:15:01,030 --> 00:15:06,050
.سأذكّرك بألاّ تذكر أنّه تجمعنا قرابة على الإطلاق

194
00:15:06,420 --> 00:15:11,200
ستتضرّر سمعتنا إن عرف النّاس أنّ لديّ
ابنًا لا يستطيع استعمال الشّعوذة

195
00:15:11,200 --> 00:15:13,550
.ولا يمكنه استعمال العناكب

196
00:15:16,130 --> 00:15:17,310
...سُحقًا

197
00:15:18,250 --> 00:15:23,700
نحن محظوظون لأنّه ما زال
.لدينا لوسي للتّعويض عن فشلك

198
00:15:27,180 --> 00:15:29,670
أهذا صحيح؟

199
00:15:29,670 --> 00:15:31,350
إنّها غلطتي؟

200
00:15:31,350 --> 00:15:33,870
لأنّني الخليفة؟

201
00:15:52,510 --> 00:15:54,930
.إنّها منغلقة على نفسها لأسبوع الآن

202
00:15:54,930 --> 00:15:56,970
.ستخرج من هذا الوضع قريبًا

203
00:15:58,460 --> 00:15:59,580
...أخي

204
00:16:00,350 --> 00:16:04,400
كيف تراني؟

205
00:16:12,350 --> 00:16:14,120
!نداء العناكب

206
00:16:31,240 --> 00:16:32,550
طفل؟

207
00:16:45,440 --> 00:16:47,020
...لقد طردوني

208
00:16:47,580 --> 00:16:50,860
وها قد أمروني الآن أن أقنع أختي قبل المغادرة؟

209
00:17:04,040 --> 00:17:06,750
...إذًا فذلك ما رأيتُه

210
00:17:07,150 --> 00:17:11,710
باحثون منافسون لنا ونتائج بحث أرادوا
...سرقتها منا وإسكاتنا

211
00:17:11,710 --> 00:17:14,480
.هناك عدّة أسباب لمهاجمة أشخاص مثلنا

212
00:17:14,480 --> 00:17:20,850
.ما زال الدّافع غير واضحًا في حالتنا

213
00:17:22,040 --> 00:17:26,140
.ونجاة لوسي من الأمر ما زال لغزًا

214
00:17:26,950 --> 00:17:28,940
الشّيء الوحيد الّذي أعرفه

215
00:17:28,940 --> 00:17:33,990
هو أنّ كلّ عنكبوت كنّا بحاجته
.لجمع الكتب وطباعتها قد سُرق

216
00:17:36,190 --> 00:17:43,180
ولاحقًا، انتشرت إشاعات أنّني عيّنت قتلة
.مأجورين للقضاء على عائلتي

217
00:17:43,920 --> 00:17:44,900
ما الحقيقة؟

218
00:17:44,900 --> 00:17:50,770
.لو أنّني فعلتُ ذلك حقًّا، لأخذت لوسي معي

219
00:17:51,660 --> 00:17:56,420
.لكنّها تشتّت انتباهي للأسف

220
00:17:56,420 --> 00:17:57,520
فعلاً؟

221
00:17:58,180 --> 00:18:01,390
إنّها تشكّ أنّني أكرهها لأنّها ورثت
.عمل العائلة بدلاً منّي

222
00:18:01,390 --> 00:18:06,090
.وأنّي أرسلت تلك الذّئاب لمهاجمة عائلتنا

223
00:18:06,090 --> 00:18:10,840
لم تنكر الأمر أو بحثت عن المهاجمين؟

224
00:18:11,280 --> 00:18:18,080
كان من الخطير جدًّا لشابّ لا يملك
.أسلحة أو دعمًا فعل هذا

225
00:18:18,470 --> 00:18:20,580
،ولكن بفضل ذلك

226
00:18:20,580 --> 00:18:26,090
وجدتُ عملاً أجيده وأستطيع دفع
.تكاليف ارتيادها للكلّيّة

227
00:18:34,370 --> 00:18:37,980
.هناك شيء يواصل امتصاص قوّته السّحريّة

228
00:18:37,980 --> 00:18:38,990
.حتّى الآن

229
00:18:38,990 --> 00:18:40,030
حتّى الآن؟

230
00:18:40,470 --> 00:18:42,690
.لكنّي لا أدري أين المصدر

231
00:18:43,000 --> 00:18:44,440
ماذا أيضًا؟

232
00:18:45,120 --> 00:18:49,390
هناك شخصان آخران في الكلّيّة
.فقدا وعيهما بنفس الأعراض

233
00:18:49,910 --> 00:18:54,430
هل لديك أيّ معرفة بمرض أو لعنة قد يسبّبان هذا؟

234
00:18:54,430 --> 00:18:57,100
ما مكافأتي لمنحك إجابة؟

235
00:18:57,100 --> 00:18:59,660
.واثق أنّ الكلّيّة ستجهّز لك شيئًا ما

236
00:19:02,050 --> 00:19:03,730
.أنت تدين لي

237
00:19:07,010 --> 00:19:12,880
،يا إلهة الأراضي البرّاقة
...يا إله العواصف القاتل للأفاعي

238
00:19:12,880 --> 00:19:19,720
.أعيراني يد العون وعيونكما رجاءً لألقي نظرة

239
00:19:36,140 --> 00:19:37,130
.مارييل

240
00:19:38,060 --> 00:19:40,500
هلّي ببعض الماء؟

241
00:19:40,500 --> 00:19:42,360
.سـ-سأذهب لإحضاره

242
00:19:46,970 --> 00:19:49,150
.نفس المشهد الّذي رأيتُ آخر مرّة

243
00:19:50,870 --> 00:19:54,980
.حاولت مساعدة بيليس قبل مدّة

244
00:19:56,030 --> 00:19:58,910
.وقرأت الكتاب

245
00:20:01,920 --> 00:20:05,640
.بالكاد أستطيع التّشبّث بسلامة عقلي

246
00:20:06,140 --> 00:20:10,640
.الكتاب الّذي ظننتُ أنّ بإمكانك تحمّله

247
00:20:11,420 --> 00:20:12,630
...لا يعقل

248
00:20:14,700 --> 00:20:16,640
".وصيّة كارناماغوس"

249
00:20:17,120 --> 00:20:21,230
هناك من يستعمل ذلك الكتاب
.لسرقة القوّة السّحريّة للآخرين

250
00:20:21,230 --> 00:20:23,570
.إنّهم يدبّرون لأمر ما

251
00:20:26,440 --> 00:20:28,000
...ما يعني

252
00:20:29,290 --> 00:20:30,630
.الشّخص الآخر أيضًا

253
00:20:41,520 --> 00:20:44,800
لماذا ساعدتنا؟

254
00:20:45,740 --> 00:20:49,270
وهل كنت تتوقّعين منّي التّخلّي عنكما؟

255
00:20:50,900 --> 00:20:53,550
.أنقذت الذّئبين أيضًا

256
00:20:53,550 --> 00:20:54,620
لماذا؟

257
00:20:55,730 --> 00:21:00,680
كنت تنوين جعل تلك الكلاب تهاجمهما، صحيح؟

258
00:21:02,060 --> 00:21:06,470
.بدا أنّ لديهما طفلاً

259
00:21:06,470 --> 00:21:07,400
...لذلك

260
00:21:08,860 --> 00:21:12,670
!إن من أنقذتهما هما من كانا يحاولان قتلنا

261
00:21:12,670 --> 00:21:13,880
...إنّهما

262
00:21:15,480 --> 00:21:18,410
.قتلا عائلتي بالكامل

263
00:21:24,240 --> 00:21:28,350
.أعتقد أنّ عليّ التّفكير في الأمور أكثر

264
00:21:29,660 --> 00:21:31,820
إنّك لا تفكّرين أبدًا، صحيح؟

265
00:21:34,200 --> 00:21:41,630
لكن بفضلك، قد أكون قادرة
.على اكتشاف من هاجمنا ولماذا

266
00:21:42,230 --> 00:21:44,900
.لذلك أنا مدينة لك

267
00:21:54,680 --> 00:22:02,390
!لوسي

268
00:21:59,050 --> 00:22:00,160
لوسي؟

269
00:22:07,230 --> 00:22:08,180
.نعم

270
00:22:08,180 --> 00:22:09,630
.مفهوم

271
00:22:10,340 --> 00:22:12,000
.ليكن ذلك

272
00:22:17,840 --> 00:22:20,740
.يبدو أن بيننا آفة

273
00:22:20,740 --> 00:22:23,520
ذلك هو كلّ المرح الّذي يمكنني
.السّماح لها بالحصول عليه