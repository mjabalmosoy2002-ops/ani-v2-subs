1
00:00:18,700 --> 00:00:20,500
،إلى جميع التّلاميذ"

2
00:00:21,110 --> 00:00:28,140
حدثت سلسلة هجمات راح ضحيّتها
.بعض تلاميذنا وأوصياؤهم

3
00:00:29,390 --> 00:00:36,290
إضافة لذلك، نال المرض من العديد نتيجة
.لحالة فقدان قوّة سحريّة لا تفسير لها

4
00:00:37,610 --> 00:00:46,240
التّحقيقات جارية لمعرفة الأسباب

5
00:00:46,240 --> 00:00:53,440
.خلف كلّ حادثة وعلاقاتها الممكنة ببعضهما

6
00:00:53,830 --> 00:00:59,440
،وفي هذا الوقت، قرّرن أنّ الكلّيّة في خطر داهم

7
00:00:59,440 --> 00:01:05,350
وللحفاظ على سلامة التّلاميذ
وهيئة التّدريس، قرٍّنا

8
00:01:05,970 --> 00:01:10,910
إغلاق مرافقها بشكل فعليّ وبالشّعوذة
".أيضًا حتّى يُعثر على حلّ ما

9
00:01:25,510 --> 00:01:28,850
تشيسي في لندن الآن، صحيح؟

10
00:01:32,520 --> 00:01:34,670
!هذا مؤلم

11
00:01:34,670 --> 00:01:35,890
!مهلاً

12
00:01:35,890 --> 00:01:37,720
!ماذا يجري هنا؟

13
00:03:19,160 --> 00:03:21,090
هل ستغادرين المدرسة بالفعل؟

14
00:03:22,490 --> 00:03:26,140
.إن كانت تلك هي رغبة جدّتي

15
00:03:26,530 --> 00:03:27,920
...لكن

16
00:03:28,370 --> 00:03:32,860
.لم يكن يفترض بي القدوم إلى هنا من الأساس

17
00:03:32,860 --> 00:03:38,510
.لا تولي عائلة سيرجنت أهمّيّة كبيرة للكلّيّة

18
00:03:38,510 --> 00:03:45,340
لكنّ جدّتك قالت أنّك هنا
.لأنّ آل ريكنباكّر طلبوا ذلك

19
00:03:45,340 --> 00:03:48,530
آل ريكنباكّر هم عائلة فيرونيكا، صحيح؟

20
00:03:51,170 --> 00:03:52,590
.لا تقلقي

21
00:03:53,930 --> 00:03:56,370
.ليس عليك إخبارنا إن لم تريدي ذلك

22
00:03:56,370 --> 00:03:59,360
.واضح أنّ هذا الأمر يُثقل كاهلك

23
00:03:59,360 --> 00:04:00,560
.معه حقّ

24
00:04:01,750 --> 00:04:04,600
.لن تتكلّم في كلّ الأحوال

25
00:04:04,600 --> 00:04:08,590
اسمع أنت، لماذا تعاملها بلؤم هكذا؟

26
00:04:09,240 --> 00:04:12,100
بل لماذا تعاملها أنت بهذا اللّطف؟

27
00:04:14,860 --> 00:04:16,580
.أفضّل ألاّ أخبرك يا ريان

28
00:04:16,580 --> 00:04:17,100
—ما

29
00:04:17,640 --> 00:04:19,790
.هذا لا يحدث عادة

30
00:04:20,480 --> 00:04:25,600
.خدمت عائلة سيرجنت عائلة ريكنباكّر لوقت طويل

31
00:04:26,490 --> 00:04:30,240
.وأنا خدمت الآنسة فيرونيكا مذ كنّا أطفالاً أيضًا

32
00:04:30,630 --> 00:04:33,390
.ولهذا السّبب أتيت إلى الكلّيّة معها

33
00:04:34,250 --> 00:04:39,630
،"مـ-مهلاً، عندما قلتِ "تخدمين
أقصدت أنّها سيّدتك؟

34
00:04:39,630 --> 00:04:43,720
لماذا إذًا ستغادرين فجأة بينما
طلبت منك سيّدتك البقاء هناك؟

35
00:04:45,360 --> 00:04:50,200
.لا أدري لماذا قيل لي أن آتي

36
00:04:51,230 --> 00:04:53,560
.الأمر تمامًا كما قالت جدّتي

37
00:04:53,560 --> 00:04:56,220
لا يمكنني القيام بأيّ شيء
.بشكل جيّد في كلّ الأحوال

38
00:04:59,500 --> 00:05:00,900
.سيّدتي فيلوميلا

39
00:05:02,540 --> 00:05:04,530
.كنتُ أبحث عنك

40
00:05:04,530 --> 00:05:05,690
.ألكيوني

41
00:05:05,690 --> 00:05:07,420
.هذه أنت

42
00:05:07,420 --> 00:05:08,800
.لا بأس

43
00:05:08,800 --> 00:05:12,030
.إنّها أشبه بمشرفتي إن صحّ التّعبير

44
00:05:12,570 --> 00:05:18,490
أنا جنّيّة اصطناعيّة صُنعت لخدمة عائلة
.سيرجنت، بمن فيهم السّيّدة فيلوميلا

45
00:05:18,930 --> 00:05:20,660
جنّيّة اصطناعيّة؟

46
00:05:21,280 --> 00:05:25,280
.كيان بلا جسد صُنع ليكون خادم مشعوذ

47
00:05:25,780 --> 00:05:29,620
يمكن صناعة الجنّيّات؟

48
00:05:29,620 --> 00:05:32,270
.يفترض أن تكون هذه شعوذة عالية المستوى

49
00:05:32,750 --> 00:05:34,260
.هذا صحيح

50
00:05:35,210 --> 00:05:40,280
.كان الرّجل الّذي صنعني مشعوذًا موهوبًا

51
00:05:42,600 --> 00:05:46,770
.إنّها تذكّرني بإلياس نوعًا ما

52
00:05:47,170 --> 00:05:49,920
لكن لماذا هي هنا؟

53
00:05:49,920 --> 00:05:53,590
هل أنت هنا لتأخذيها إلى المنزل؟

54
00:05:53,590 --> 00:05:55,240
.أنا محاصرة في الدّاخل

55
00:05:56,150 --> 00:05:57,500
محاصرة؟

56
00:05:57,780 --> 00:05:59,170
.في الدّاخل

57
00:05:59,960 --> 00:06:03,870
.تمّ إغلاق الكلّيّة فعليًّا وبالشّعوذة أيضًا

58
00:06:04,390 --> 00:06:09,630
لا يمكنني المغادرة لأنّه تمّ منحي
.شكلاً لإنجاز بعض المهام الاعتياديّة

59
00:06:10,120 --> 00:06:14,430
.بالتّالي، سأكون تحت رعايتك لبعض الوقت

60
00:06:14,820 --> 00:06:16,080
ماذا؟

61
00:06:23,510 --> 00:06:24,410
صباح الخير

62
00:06:25,300 --> 00:06:28,110
.صباح الخير يا سيّد إينزوورث

63
00:06:28,990 --> 00:06:30,580
هل مسموح لك بالنّهوض؟

64
00:06:31,170 --> 00:06:32,440
.نعم، شكرًا لك

65
00:06:32,440 --> 00:06:33,360
.أنا في حالة أفضل

66
00:06:33,830 --> 00:06:36,190
.تمّ إغلاق الكلّيّة

67
00:06:36,190 --> 00:06:37,290
أغلقت؟

68
00:06:37,790 --> 00:06:40,920
هل نعلم الآن أنّ المهاجم في الخارج الآن؟

69
00:06:41,430 --> 00:06:44,890
أفترض أنّ هذا هو السّؤال
.الّذي سيجيب عنه كلّ هذا

70
00:06:44,890 --> 00:06:46,180
.فهمت

71
00:06:47,480 --> 00:06:48,540
.شكرًا لك

72
00:06:50,320 --> 00:06:52,880
أتيت إلى هنا لتطمئنّ عليّ، صحيح؟

73
00:06:52,880 --> 00:06:54,590
.أرى أنّي حصلت على صديقي جيّد

74
00:06:55,930 --> 00:06:56,770
ماذا؟

75
00:06:58,760 --> 00:07:02,720
،لا أعرف الكثير عن الصّداقة

76
00:07:02,720 --> 00:07:06,210
ولكن هل يمكن أن يوصف المرء
بصديق فقط لأنّه أتى لعيادة مريض؟

77
00:07:07,090 --> 00:07:09,310
القلق حيال شخص ما والاهتمام لأمره

78
00:07:09,310 --> 00:07:11,760
...وكذا التّفكير فيه لسبب غير محدّد

79
00:07:11,760 --> 00:07:14,920
.أعتقد أنّ هذا يكفي ليوصَف المرء بصديق

80
00:07:15,570 --> 00:07:18,480
.لو كنتَ تكرهني، لفرحتَ لما أصابني

81
00:07:19,090 --> 00:07:20,390
.فهمت

82
00:07:20,950 --> 00:07:24,860
في تلك الحالة، قد يكون لي عدّة
.أصدقاء آخرين بمن فيهم أنت

83
00:07:24,860 --> 00:07:25,940
.حوالي اثنين آخرين

84
00:07:26,420 --> 00:07:27,990
.هذا جيّد

85
00:07:28,500 --> 00:07:29,820
لا، ربّما ثلاثة؟

86
00:07:29,820 --> 00:07:31,250
أربعة؟

87
00:07:31,590 --> 00:07:34,760
.إذًا فلم يكونوا مجرّد معارف

88
00:07:36,270 --> 00:07:38,740
.إنّ صديقي الجديد ممتع للغاية

89
00:07:49,140 --> 00:07:52,020
.مسموح لنا مغادرة الغرفة الآن

90
00:07:53,120 --> 00:07:53,940
.نعم

91
00:07:54,470 --> 00:07:55,630
.هذا جيّد

92
00:08:54,550 --> 00:08:55,580
.صباح الخير

93
00:08:55,580 --> 00:08:56,340
هل سمعتم؟

94
00:08:56,340 --> 00:08:58,750
يفترض بنا التّجمّع في الحديقة ونحن
.نرتدي ملابسنا الرّياضيّة في السّاعة الأولى

95
00:08:58,750 --> 00:09:00,400
.فصلي في السّاحة

96
00:09:00,400 --> 00:09:01,720
ما كلّ هذا عن الإغلاق؟

97
00:09:01,720 --> 00:09:04,150
لماذا علينا التّعامل مع هذا الأمر
في أوّل الصّباح هكذا؟

98
00:09:06,220 --> 00:09:09,290
يبدو أنّه يفترض بنا التّجمّع
.في مناطق التّدريب

99
00:09:11,120 --> 00:09:13,230
الكلّيّة مغلقة؟ معقول؟

100
00:09:13,230 --> 00:09:15,370
متى سيدعوننا نخرج؟

101
00:09:15,370 --> 00:09:18,290
.عـ-على الأرجح قبل عيد الميلاد

102
00:09:18,290 --> 00:09:20,250
.ما زال هناك شهران كاملان على ذلك

103
00:09:20,250 --> 00:09:22,770
هل نحن في أمان فعلاً ونحن محاصرون هنا؟

104
00:09:22,770 --> 00:09:23,960
.لا أحد يدري

105
00:09:26,510 --> 00:09:29,370
.لم أنم جيّدًا البارحة

106
00:09:29,370 --> 00:09:31,580
.كان بالي مشغولاً كثيرًا

107
00:09:31,910 --> 00:09:33,120
تشعرين بالنّعاس؟

108
00:09:33,120 --> 00:09:34,180
.لا

109
00:09:34,180 --> 00:09:35,350
.أنا بخير

110
00:09:35,350 --> 00:09:36,480
.لا بأس

111
00:09:37,700 --> 00:09:40,920
.تبد ولوسي منتعشة بشكل غريب

112
00:09:40,920 --> 00:09:43,220
!لوسي! أرى أنّك عدت

113
00:09:43,220 --> 00:09:44,380
!سرّني هذا

114
00:09:44,380 --> 00:09:45,310
.نعم

115
00:09:46,060 --> 00:09:48,760
!لا توجد تغطية حتّى

116
00:09:48,760 --> 00:09:50,820
!مكافأة دخولي اليوميّ

117
00:09:51,260 --> 00:09:54,070
تغيّر المنهاج بسبب الإغلاق أيضًا، صحيح؟

118
00:09:54,070 --> 00:09:55,570
.أتساءل ماذا نفعل

119
00:09:55,570 --> 00:09:58,390
.يتكلّم الجميع عن الإغلاق

120
00:09:58,820 --> 00:10:01,940
.يبدو أنّ الإغلاق يحدث من حين لآخر

121
00:10:01,940 --> 00:10:03,280
فعلاً؟

122
00:10:03,280 --> 00:10:05,630
.للكلّيّة الكثير من الأعداء

123
00:10:05,630 --> 00:10:08,700
.إنّها تضمّ الكثير من الوثائق والأدوات المهمّة

124
00:10:11,230 --> 00:10:15,660
.يستطيع أيّ أحد الخروج بالسّحر أو الشّعوذة

125
00:10:16,510 --> 00:10:19,490
لماذا سرقوا الكتاب السّحريّة؟

126
00:10:20,610 --> 00:10:23,610
ما الّذي يحاولون فعله بالقوّة
السّحريّة الّتي سلبوها؟

127
00:10:25,250 --> 00:10:27,470
.الإغلاق. أحبّ هذا

128
00:10:28,470 --> 00:10:31,600
.في رأيي، إنّها فرصة مثيرة للاهتمام

129
00:10:32,810 --> 00:10:34,240
.زاكّروني

130
00:10:34,930 --> 00:10:36,820
لماذا أنت هنا؟

131
00:10:37,330 --> 00:10:40,100
.أبحث عن أشخاص للمساعدة خلال الإغلاق

132
00:10:41,850 --> 00:10:45,920
ربّما عليك التّوقّف عن النّظر إليّ
.بنظرة الموت الوحشيّة تلك

133
00:10:48,120 --> 00:10:49,420
!زاكّروني

134
00:10:51,710 --> 00:10:53,950
.لا تغادر من تلقاء نفسك رجاءً

135
00:10:54,510 --> 00:10:56,010
.إنّها الأستاذة فاخمان

136
00:10:56,360 --> 00:11:00,000
المعذرة، ماذا سيكون درسنا الأوّل؟

137
00:11:00,700 --> 00:11:03,810
تعرفون أنّ المدرسة مغلقة منذ البارحة، صحيح؟

138
00:11:03,810 --> 00:11:07,300
.في أوقات كهذه، تحصلون على دروس إلزاميّة أكثر

139
00:11:07,300 --> 00:11:08,970
دروس إلزاميّة؟

140
00:11:26,030 --> 00:11:30,750
.زاكّروني، احرص إبقائها في حدود الفصل

141
00:11:30,750 --> 00:11:33,030
.أعلم يا فاخمان

142
00:11:48,980 --> 00:11:53,820
.دمّروا هؤلاء الأليفين خاصّتي، وستنجحون

143
00:11:56,230 --> 00:11:58,950
.أنا فابيو زاكّروني

144
00:11:59,350 --> 00:12:02,120
.وهذه مشرفتي سيغريد فاخمان

145
00:12:02,930 --> 00:12:06,460
.سنقدّم لكم درسًا إلزاميًّا مهمًّا اليوم

146
00:12:12,750 --> 00:12:17,110
في البداية، سأوزّع عليكم هذه
.واحرصوا ألاّ تضيّعوها

147
00:12:19,400 --> 00:12:21,120
.تميمة حماية رونيّة

148
00:12:22,130 --> 00:12:24,590
.إضافة لطين وحجر

149
00:12:25,450 --> 00:12:28,430
.ستجعلكم هذه التّمائم أقلّ عرضة لتلقّي الضّرر

150
00:12:29,070 --> 00:12:31,230
تعرفون كيف تستعملونها، صحيح؟

151
00:12:32,160 --> 00:12:34,440
هل أغذّيها بالقوّة السّحريّة فحسب؟

152
00:12:39,740 --> 00:12:44,490
إنّ حقيقة إغلاق الكلّيّة
.تعني أنّ هنالك أعداءً في الخارج

153
00:12:45,040 --> 00:12:48,800
.لهذا السّبب قمنا بإضافة هذه الدّروس

154
00:12:49,290 --> 00:12:53,900
الغاية هنا هي تجهيزكم للقتال دفاعًا
.عن أنفسكم إن اقتضى الأمر لذلك

155
00:12:54,880 --> 00:12:59,780
تخيّلوا سلاحًا أو أداة قد تجدونها
.مفيدة في ذلك الطّين

156
00:12:59,780 --> 00:13:01,090
سلاح؟

157
00:13:09,630 --> 00:13:11,460
ماذا أصنع؟

158
00:13:11,460 --> 00:13:13,910
.لا يمكنني تقرير شكل معيّن

159
00:13:13,910 --> 00:13:16,630
.تخيّلوا شيئًا بوضوح ودقّة

160
00:13:16,630 --> 00:13:17,820
.قد يكون أيّ شيء

161
00:13:17,820 --> 00:13:20,750
...سكّين أو عصا

162
00:13:20,750 --> 00:13:21,950
.لكن لا مسدّسات رجاءً

163
00:13:21,950 --> 00:13:22,940
.هناك خدعة خاصّة لتلك

164
00:13:23,380 --> 00:13:24,400
...عفوًا

165
00:13:25,180 --> 00:13:28,150
لماذا سنستعمل أسلحة للقتال؟

166
00:13:28,850 --> 00:13:31,030
ألا يفترض بنا استعمال الشّعوذة؟

167
00:13:36,890 --> 00:13:40,540
هل تعتقد فعلاً أنّك جاهز لذلك؟

168
00:13:41,220 --> 00:13:46,000
.من السّهل جدًّا أن تُقتل طعنًا أو ضربًا أو بالرّصاص

169
00:13:46,440 --> 00:13:49,600
.أو ربّما سَحقًا أيضًا

170
00:13:53,310 --> 00:13:54,550
!زاكّروني

171
00:13:57,740 --> 00:13:58,770
!مارتين

172
00:13:59,140 --> 00:14:00,040
هل أنت بخير؟

173
00:14:00,040 --> 00:14:02,270
.يبدو أنّ التّمائم تعمل

174
00:14:03,070 --> 00:14:04,600
هل أنت جادّ؟

175
00:14:12,220 --> 00:14:16,120
.حسنًا، تجهّزوا وخذوا أماكنكم

176
00:14:16,510 --> 00:14:21,070
لمعلوماتكم فحسب، خذوا هذا الأمر
.على محمل الجدّ وإلاّ تأذّيتم بشدّة

177
00:14:29,990 --> 00:14:31,340
.نحن محاصرون في الدّاخل

178
00:14:32,440 --> 00:14:34,500
إضافة... لسلاح؟

179
00:14:34,500 --> 00:14:36,870
!لم أستعمل سلاحًا من قبل

180
00:14:46,000 --> 00:14:47,310
...إنّ جسدي

181
00:14:49,960 --> 00:14:51,500
.يتحرّك من تلقاء نفسه

182
00:15:04,450 --> 00:15:06,300
.لم أتعلّم يومًا كيف أفعل ذلك

183
00:15:11,240 --> 00:15:14,790
كيف استطعت التّصرّف بحسم هذا؟

184
00:15:40,750 --> 00:15:42,060
.انكسر

185
00:15:43,710 --> 00:15:46,290
.ماذا؟ أنتما سريعان

186
00:15:46,830 --> 00:15:49,100
.أعتقد أنّه ليس عليّ أن أتفاجأ

187
00:15:49,100 --> 00:15:50,350
.لديكما الخبرة

188
00:15:51,940 --> 00:15:54,060
أتريدان الاستمتاع أكثر؟

189
00:16:00,480 --> 00:16:03,540
.لكنتُ الآن ميتًا لولا تلك التّميمة

190
00:16:04,770 --> 00:16:09,370
!أنا أفضّل صناعتها أكثر من استعمالها

191
00:16:22,440 --> 00:16:25,540
.لستُ مناسبًا للقتال

192
00:16:54,780 --> 00:16:56,120
هل أنت بخير؟

193
00:17:00,730 --> 00:17:02,170
.نـ-نعم

194
00:17:02,170 --> 00:17:03,210
.أنا بخير

195
00:17:03,210 --> 00:17:04,360
.شكرًا لك

196
00:17:05,940 --> 00:17:08,530
.لم تتّسخ ملابسك على الإطلاق

197
00:17:09,430 --> 00:17:11,340
.أنت مذهلة يا فيلوميلا

198
00:17:15,740 --> 00:17:16,940
!فيلوميلا

199
00:17:18,000 --> 00:17:22,080
.عليّ أن أكون قادرة على فعل هذا من الآن فصاعدًا

200
00:17:23,050 --> 00:17:25,240
هل أخبرك شخص ما بهذا؟

201
00:17:27,770 --> 00:17:30,800
.لكنّي أظنّك مذهلة

202
00:17:49,050 --> 00:17:50,230
!سُحقًا

203
00:17:50,760 --> 00:17:53,880
كان عليّ تعلّم القتال بالرّماح
.أكثر من هذا من أمّي

204
00:17:58,620 --> 00:18:00,980
—عليّ فعل ما أستطيع فـ

205
00:18:04,660 --> 00:18:06,740
...انتهيت

206
00:18:07,400 --> 00:18:09,600
.أنفك ينزف يا ياسمين

207
00:18:09,600 --> 00:18:11,470
.كان ذلك صعبًا

208
00:18:12,020 --> 00:18:14,300
.أتساءل إن انتهى الجميع

209
00:18:18,230 --> 00:18:19,540
ما هذا الصّوت؟

210
00:18:25,030 --> 00:18:29,130
يتحرّك جسدي كما يجب، لكن لا يسعني
.فعل الكثير بهذه العصا سوى التّلويح بها

211
00:18:39,900 --> 00:18:40,540
!تشيسي

212
00:18:40,830 --> 00:18:42,670
!لوّحي بها كمضرب بكلّ ما لديك

213
00:18:59,680 --> 00:19:02,740
.هذا يكفي أنتما الاثنين

214
00:19:04,250 --> 00:19:06,320
.أحسنتم عملاً

215
00:19:06,320 --> 00:19:08,460
.نجح الجميع

216
00:19:08,780 --> 00:19:12,000
كيف أفسدتِ عليّ ذلك يا فاخمان؟

217
00:19:12,350 --> 00:19:15,690
.أخبرتك أن تبقي الأمر في نطاق الدّرس

218
00:19:15,690 --> 00:19:19,990
.إن لم تكن راضيًا، فسأضيف لك ثقوبًا أخرى  لاحقًا

219
00:19:23,970 --> 00:19:27,630
.كان ذلك جيّدًا بما يكفي للمرّة الأولى

220
00:19:28,400 --> 00:19:29,760
من منكم كان خائفًا؟

221
00:19:35,090 --> 00:19:37,600
.أنتما، لا تكذبا

222
00:19:38,050 --> 00:19:41,190
.يبدو أنّ بعضكم عانى الأمرّين أيضًا

223
00:19:41,950 --> 00:19:45,610
لم يكن لديك وقت حتّى للتّفكير
في استعمال الشّعوذة، صحيح؟

224
00:19:46,090 --> 00:19:48,610
هل تعتقدون أنّك كبار كفاية لذلك؟

225
00:19:48,960 --> 00:19:51,250
هل تعتقدون أنّكم تملكون السّعة لذلك؟

226
00:19:52,470 --> 00:19:56,960
،سواء استعملتم الشّعوذة أو سلاحًا ما
...وسواء هربتم أم قاتلتم

227
00:19:57,420 --> 00:20:00,550
.الأمر منوط بكم في النّهاية للاعتناء بأنفسكم

228
00:20:01,080 --> 00:20:03,720
.فكّروا كيف تخطّطون للنّحاة

229
00:20:03,720 --> 00:20:04,630
...وأيضًا

230
00:20:06,010 --> 00:20:08,020
.إيّاكم أن تجرؤوا على التّردّد

231
00:20:09,440 --> 00:20:13,350
مفهوم يا صغاري المشعوذين المتدرّبين؟

232
00:20:15,620 --> 00:20:17,710
.انتهى الدّرس

233
00:20:17,710 --> 00:20:21,110
.لنتحدّث عن أسلوبك في التّدريس

234
00:20:21,110 --> 00:20:23,080
.إنّ ذلك يؤلم كثيرًا

235
00:20:23,080 --> 00:20:25,700
كيف لك أن تكونين قويّة هكذا؟

236
00:20:26,280 --> 00:20:27,540
فيلوميلا؟

237
00:20:31,260 --> 00:20:32,590
ما الخطب؟

238
00:20:32,590 --> 00:20:34,460
.يبدو أنّها مريضة

239
00:20:34,860 --> 00:20:36,840
.لنذهب إلى مكتب الممرّضة

240
00:20:36,840 --> 00:20:37,990
...لا

241
00:20:37,990 --> 00:20:38,990
.أنا بخير

242
00:20:39,410 --> 00:20:41,590
.لا تبدين لي بخير

243
00:20:49,490 --> 00:20:52,150
.سآخذها إلى مكتب الممرّضة

244
00:20:52,150 --> 00:20:55,230
هلاّ أعلمت المدرّس التّالي بالوضع؟

245
00:20:55,230 --> 00:20:56,240
.بالطّبع

246
00:20:56,240 --> 00:20:57,310
.كوني حذرة

247
00:20:58,090 --> 00:21:00,170
...لاحظتُ هذا لفترة

248
00:21:00,170 --> 00:21:02,410
لكنّ تشيسي قويّة جدًّا، صحيح؟

249
00:21:02,410 --> 00:21:03,170
.نعم

250
00:21:04,340 --> 00:21:06,440
.اعتني بفيلوميلا رجاءً

251
00:21:06,720 --> 00:21:10,240
.لطالما كانت حالة سيّئة

252
00:21:11,140 --> 00:21:12,050
.حسنًا

253
00:21:17,380 --> 00:21:19,840
تعرف فيرونيكا بأمر عائلة فيلوميلا

254
00:21:19,840 --> 00:21:23,750
وكيف أنّها أُجبرت على مغادرة الكلّيّة، صحيح؟

255
00:21:24,760 --> 00:21:26,490
...أتساءل ما الّذي تفكّر فيه

256
00:21:34,490 --> 00:21:35,850
أنت أيضًا يا لوسي؟

257
00:21:35,850 --> 00:21:38,600
.استعملت كلّ طاقتي  هناك

258
00:21:38,600 --> 00:21:41,520
.سأفقد وعيي ثانية إن لم اكن قريبة منك

259
00:21:41,520 --> 00:21:42,620
.صحيح

260
00:21:43,200 --> 00:21:45,610
.لا تأخذيني لمكتب الممرّضة

261
00:21:47,920 --> 00:21:51,270
.لا تتصرّفي بغباء. انظري لحالك

262
00:21:51,270 --> 00:21:54,490
.خذيني إلى غرفتي على الأقلّ

263
00:22:04,630 --> 00:22:07,360
ما هذا المهمّة الخطيرة؟

264
00:22:07,360 --> 00:22:09,480
.بل قلتُ إنّها مهمّة جيّدة

265
00:22:11,670 --> 00:22:13,040
!ما هذا؟

266
00:22:14,110 --> 00:22:16,200
مبلغ محترم جدًّا، صحيح؟

267
00:22:16,200 --> 00:22:18,010
.العثور على كنز ضائع

268
00:22:18,010 --> 00:22:22,930
وبالتّحديد، كتاب سحريّ استُعمل
.بطرق مريبة للغاية