1
00:00:02,890 --> 00:00:04,100
...آدم

2
00:00:04,550 --> 00:00:06,260
.ما عاد بإمكاني التّحمّل

3
00:00:06,260 --> 00:00:08,610
.نعم، أعلم

4
00:00:08,610 --> 00:00:10,500
.لا بأس. اذهبي لترتاحي

5
00:00:12,600 --> 00:00:14,810
سيّدي... ما هذا؟

6
00:00:16,030 --> 00:00:17,130
.إنّها طفلة

7
00:00:17,130 --> 00:00:18,410
.حديثة الولادة

8
00:00:18,410 --> 00:00:19,440
.رضيعة

9
00:00:20,980 --> 00:00:22,480
...عفوًا

10
00:00:22,480 --> 00:00:26,530
.على أيّ حال، سنطلب منك دعمنا في تربيتها

11
00:00:27,560 --> 00:00:32,070
.لا يمكنني أن نطلب مساعدة أيّ أحد بسبب وضعنا

12
00:00:32,760 --> 00:00:34,590
.اسمها فيلوميلا

13
00:00:35,270 --> 00:00:36,380
.تفضّلي أرجوك

14
00:00:40,400 --> 00:00:42,950
.أنا وإيريس نحتاج للنّوم بشدّة

15
00:00:43,510 --> 00:00:45,070
.سأنام أنا أيضًا

16
00:00:59,980 --> 00:01:03,000
.سيّدتي فيلوميلا

17
00:01:40,950 --> 00:01:42,570
هل نعود الآن؟

18
00:01:43,020 --> 00:01:45,080
.نعم يا سيّدي

19
00:03:39,720 --> 00:03:43,330
.يا عناكب سطح الماء، اغزلي خيطًا من فضّة

20
00:03:41,490 --> 00:03:47,530
.للصّبر حدود

21
00:03:43,760 --> 00:03:47,000
.يا خرفان الزّجاج، انسجي الشّعر الفضّيّ

22
00:03:47,520 --> 00:03:52,030
.يا مرآة الفضّة، أظهري الخطر

23
00:03:52,380 --> 00:03:55,240
.اختمي الأخطار الّتي قد تقع على هذه الطّفلة

24
00:03:57,020 --> 00:03:59,070
.سيخفّف هذا من الحمّى

25
00:03:59,070 --> 00:04:00,630
.أريد اللّعب

26
00:03:59,930 --> 00:04:02,230
.لنترك بعضه في الثّلاّجة

27
00:04:01,170 --> 00:04:02,390
.ليس اليوم

28
00:04:02,230 --> 00:04:02,910
.نعم

29
00:04:09,780 --> 00:04:13,140
.لم أرك تستعمل الشّعوذة منذ مدّة

30
00:04:13,520 --> 00:04:17,670
.كانت تلك تعويذة بدائيّة لنقل الأعراض للدّمية

31
00:04:18,570 --> 00:04:22,010
.التّعاويذ هي نوع الشّعوذة المفضّل لديّ

32
00:04:22,550 --> 00:04:25,040
.مع أنّها ما كانت لتُستعمل على الأطفال

33
00:04:25,470 --> 00:04:29,020
.مهلاً، صرتِ بارعة بهذا

34
00:04:29,830 --> 00:04:34,650
ليس شائعًا أن تتغيّر الجنّيّات الاصطناعيّة
.عن إعداداتها الأصليّة في العادة

35
00:04:35,040 --> 00:04:36,330
.أظنّني أحسنتُ عملاً

36
00:04:37,330 --> 00:04:40,080
هل أنا أتطوّر؟

37
00:04:40,570 --> 00:04:42,230
.بكلّ تأكيد

38
00:04:42,230 --> 00:04:43,900
.جميع من في هذه العائلة كذلك

39
00:04:44,640 --> 00:04:47,420
،إنّنا نسعى جاهدين لإصلاح الأمور عندما نفشل

40
00:04:48,000 --> 00:04:50,670
.وبعد أن ننجح، نفشل ثانية

41
00:04:52,220 --> 00:04:55,580
.لم يكن الفشل مسموحًا به في منزلي الآخر

42
00:04:56,130 --> 00:04:58,250
عن أيّ منزل تتحدّث؟

43
00:04:58,250 --> 00:05:02,100
.صحيح، لم أخبرك عن ذلك بعد

44
00:05:02,920 --> 00:05:06,580
.كان لآل سيرجنت شخص ما يخدمونه دائمًا

45
00:05:07,070 --> 00:05:09,190
.اختصاصنا هو القيام بالأعمال القذرة للآخرين

46
00:05:09,710 --> 00:05:12,870
.التّخلّص من الأشخاص الّذين لا يحبّونهم أسيادنا

47
00:05:13,390 --> 00:05:16,400
.تعذيب النّاس للحصول على معلومات

48
00:05:16,930 --> 00:05:20,290
.وفي أحد الأيّام، تمّ بيع إيريس لنا

49
00:05:21,350 --> 00:05:23,910
.كموضوع تجارب لأجل شعوذتي

50
00:05:26,900 --> 00:05:32,700
.استعملها للتّدرّب على كبح نفسك كي لا تقتل الآخرين

51
00:05:33,950 --> 00:05:34,850
.حاضر

52
00:05:48,880 --> 00:05:51,150
!مهلاً، اللّعنة عليك

53
00:05:51,150 --> 00:05:56,920
!لن أنحني لك أبدًا ما حييت

54
00:06:05,460 --> 00:06:10,830
.على أيّ حال، انضبطتُ بفضل إيريس

55
00:06:11,270 --> 00:06:16,080
.تخلّى الوريث المستقبليّ عن والدته ونسبه وعائلته

56
00:06:16,080 --> 00:06:17,630
.وها هو الآن أمامك

57
00:06:18,750 --> 00:06:20,020
...والدتك

58
00:06:21,140 --> 00:06:25,050
.إنّها تعتبرني امتدادًا لها

59
00:06:25,500 --> 00:06:26,870
.فهمت

60
00:06:27,410 --> 00:06:28,900
...بالمناسبة يا سيّدي

61
00:06:29,870 --> 00:06:31,330
.الطّعام يحترق

62
00:06:38,910 --> 00:06:40,170
هل هدأت؟

63
00:06:40,660 --> 00:06:41,500
.نعم

64
00:06:41,830 --> 00:06:45,970
يبدو أنّ الوجبة الخفيفة الّتي قدّمتُها
.لها اليوم لم تُعجبها

65
00:06:45,970 --> 00:06:48,190
.شكرًا يا ألكيوني

66
00:06:48,190 --> 00:06:49,350
.أقدّر لك هذا

67
00:06:50,760 --> 00:06:54,490
.أخبرني السّيّد أنّ هذه أهمّ مهمّة في العالم

68
00:06:54,490 --> 00:06:56,840
.لا يوجد ما له الأولويّة عليها

69
00:07:00,660 --> 00:07:01,760
.أحسنتِ

70
00:07:03,190 --> 00:07:06,920
.أتمنّى لو كانت لديّ كاميرا

71
00:07:07,930 --> 00:07:10,930
...كلّ الابتسامات والبكاء والتّصرّفات السّخيفة

72
00:07:10,930 --> 00:07:13,040
.تختفي بسرعة في لمح البصر

73
00:07:13,040 --> 00:07:15,110
كاميرا؟

74
00:07:15,110 --> 00:07:18,460
لا نلتقط أيّ صور لأنفسنا
.لأنّنا لا نريد أن تُستعمل ضدّنا

75
00:07:19,040 --> 00:07:22,150
.إنّنا هاربون من مشعوذة مخيفة قبل كلّ شيء

76
00:07:22,580 --> 00:07:26,650
.اعتاد والداي التقاط صور كثيرة

77
00:07:26,650 --> 00:07:28,780
.كانت تغطّي كلّ جدران المنزل

78
00:07:28,780 --> 00:07:32,670
.قال السّيّد أنّ والدتك باعتك أيضًا

79
00:07:34,630 --> 00:07:37,260
.صار وضعنا الماليّ سيّئًا في لمح البصر

80
00:07:37,940 --> 00:07:40,900
ومع ذلك، من كان يظنّ أنّي سأهرب مع رجل

81
00:07:40,900 --> 00:07:43,850
نطحتُه بدافع الإحباط عندما تمّ بيعي؟

82
00:07:43,850 --> 00:07:47,040
.لا يمكن توقّع ما تخفيه لنا الحياة

83
00:07:47,040 --> 00:07:48,270
إحباط؟

84
00:07:48,600 --> 00:07:52,160
.كان ولدًا أنيقًا لم يوجد في هذا العالم شيء يُقلقه

85
00:07:52,440 --> 00:07:56,470
.قيل لي أنّه سيُجري عليّ تجارب
.لذلك بالطّبع كنت غاضبة

86
00:07:59,740 --> 00:08:01,830
هل تكرهين السّيّد؟

87
00:08:05,840 --> 00:08:07,190
.لستُ واثقة

88
00:08:07,910 --> 00:08:11,880
.لكن انتهى بنا المطاف بهذه الصّغيرة الظّريفة

89
00:08:17,290 --> 00:08:18,780
.لكنّي خائفة

90
00:08:19,400 --> 00:08:25,260
لا أدري إن كنتُ سأعطيها الأولويّة
.إن حدث أمر ما بالفعل

91
00:08:26,600 --> 00:08:33,120
فقبل كلّ شيء، أنا ابنة امرأة باعت
.فلذة كبدها بنفسها

92
00:08:40,590 --> 00:08:41,680
،إنّ واجبي

93
00:08:43,130 --> 00:08:50,130
حتّى إن فعلتما أنت أو السّيّد شيئًا
.كهذا، هو حماية سيّدتي فيلوميلا

94
00:08:53,800 --> 00:08:59,400
.يا ألكيوني، تذكّري اليوم أيضًا رجاءً

95
00:09:00,090 --> 00:09:02,950
لذلك إن حلّ يوم ما لا نستطيع فيه
،لا أنا ولا آدم إخبارها بأنفسنا

96
00:09:03,370 --> 00:09:11,460
فستكونين إلى جانبها لإخبارها عن الأيّام
.الصّعبة والأوقات المرحة مثل هذا اليوم

97
00:09:18,460 --> 00:09:22,980
.لحم فخذ وجبن ولحم مقدّد وبطاطس وجزر

98
00:09:23,750 --> 00:09:26,090
.هذه هي كلّ المشتريات الّتي عليّ شراؤها

99
00:09:29,650 --> 00:09:32,070
.كم هذا مثير للقلق

100
00:09:32,070 --> 00:09:33,220
.وفي وسط المدينة أيضًا

101
00:09:33,220 --> 00:09:38,040
.طلبت منّي السّيّدة إخبارك أنّ وقت اللّعب قد انتهى

102
00:09:39,390 --> 00:09:40,920
وقت اللّعب؟

103
00:09:41,670 --> 00:09:43,920
.يبدو هذا كشيء قد تقوله بالفعل

104
00:09:44,910 --> 00:09:46,990
.هناك حاجز لإبعاد النّاس

105
00:09:46,990 --> 00:09:50,060
.حسنًا، لم ترسل أيّ شخص خلفنا

106
00:09:50,060 --> 00:09:52,400
.لذلك ظننتُ أنّها تتلاعب معنا

107
00:09:52,400 --> 00:09:54,760
.لعبة العائلة خاصّتك قد انتهت

108
00:09:54,760 --> 00:09:57,310
،بعد أن كبرت ابنتك

109
00:09:57,310 --> 00:09:59,490
.ما عدنا نستطيع السّماح لها بالتّصرّف على هواها

110
00:09:59,720 --> 00:10:03,200
.نطلب منك العودة للقصر يا سيّد آدم

111
00:10:03,640 --> 00:10:07,590
إذًا فقد كانت تنتظر حتّى تكبر
.حفيدتها بما يكفي لاستعمالها كرهينة

112
00:10:14,010 --> 00:10:16,000
!سُحقًا! إنّها تُطلق علينا

113
00:10:16,930 --> 00:10:18,710
!افتحي الباب

114
00:10:19,210 --> 00:10:20,750
.أطلق على مقبض الباب

115
00:10:20,750 --> 00:10:22,760
!سنقتحم المكان

116
00:10:22,760 --> 00:10:23,720
...السّيّد

117
00:10:24,140 --> 00:10:24,890
.سيّدي

118
00:10:24,890 --> 00:10:25,760
!ألكيوني

119
00:10:26,140 --> 00:10:27,760
.سنلحق بك لاحقًا

120
00:10:27,760 --> 00:10:30,220
!لا تسلّميها لهم أبدًا

121
00:10:30,550 --> 00:10:32,500
!أمّي، كلاّ

122
00:10:32,500 --> 00:10:33,770
!لا تريد فيلوميلا الذّهاب

123
00:10:35,080 --> 00:10:36,770
!أمّي

124
00:10:38,250 --> 00:10:40,250
.انتظري قدومنا

125
00:10:42,020 --> 00:10:43,040
!اذهبا

126
00:10:43,040 --> 00:10:44,210
!سأكون خلفكما مباشرة

127
00:10:44,210 --> 00:10:45,390
!أمّي

128
00:10:44,550 --> 00:10:45,420
!لا تطلق النّار

129
00:10:45,420 --> 00:10:46,410
!ستصيب الفتاة

130
00:10:55,550 --> 00:10:58,230
.ما كان علينا فقدان الفتاة

131
00:10:58,660 --> 00:11:00,680
.لم نتوقّع أن تتخلّي عن حياتك

132
00:11:03,570 --> 00:11:04,780
...ماذا

133
00:11:09,580 --> 00:11:14,720
أكانت تعويذة ما لنسخ إصابة مهاجمك؟

134
00:11:19,050 --> 00:11:21,450
.لـ-لكنّك ضحّيت بنفسك

135
00:11:22,000 --> 00:11:23,290
وبعد؟

136
00:11:24,200 --> 00:11:26,520
...بعد أن عرفت كيف هو العالم الخارجيّ الآن

137
00:11:26,520 --> 00:11:27,890
...فلن أعود أبدًا

138
00:11:29,590 --> 00:11:31,190
.لذلك المكان اللّعين

139
00:11:32,360 --> 00:11:35,740
.أنا واثق من ذلك أكثر من أيّ شيء آخر

140
00:11:36,800 --> 00:11:38,820
.أفضّل الموت على العودة

141
00:11:38,820 --> 00:11:39,980
...مستحيل

142
00:11:39,980 --> 00:11:40,710
!توقّف

143
00:11:43,440 --> 00:11:48,280
أمّي، ما رأيك أن نقوم برهان واحد أخير؟

144
00:11:50,640 --> 00:11:54,770
.لنحرص على ألاّ أراك ثانية أبدًا

145
00:11:59,950 --> 00:12:03,820
.حياتي عفنة حتّى النّهاية

146
00:12:04,870 --> 00:12:10,680
أيّها الأوغاد، أتدرون كم عشت مع ذلك الرّجل؟

147
00:12:11,150 --> 00:12:13,360
،إنّه يتظاهر باللّطف

148
00:12:13,360 --> 00:12:17,370
لكنّه مجرّد شقيّ مغرور لا يسعه
.إلاّ أن يردّ الدّين دائمًا

149
00:12:23,410 --> 00:12:28,610
.لن تحميك هذه التّعويذة، لكنّها ستنتقم لك

150
00:12:30,830 --> 00:12:32,750
تريدني أن أثق بك؟

151
00:12:33,090 --> 00:12:34,260
.أنا آسف

152
00:12:34,260 --> 00:12:36,580
.واثق أنّك لا تريدين التّعرّض للأذى من الأساس

153
00:12:38,580 --> 00:12:40,060
.لا أهتمّ

154
00:12:40,060 --> 00:12:44,390
ستساعدني على تذكّر غضبي
.وقراري بمغادرة هذا المكان

155
00:12:45,710 --> 00:12:49,320
،إن كنت تشعر بالذّنب حقًّا
فصر مشعوذًا جيّدًا جدًّا

156
00:12:50,030 --> 00:12:52,320
!وأخرجني من هنا يومًا ما

157
00:13:30,810 --> 00:13:35,140
.لم أرد أن أموت بعد

158
00:13:39,920 --> 00:13:46,650
،سيّدي، سيّدتي إيريس
.اطمئنّا لأنّي سأكون دائمًا معها

159
00:13:46,650 --> 00:13:51,340
...حتّى إن دُمّرت، فإنّ سيّدتي فيلوميلا

160
00:13:56,100 --> 00:13:59,730
،جنّيّة اصطناعيّة لعينة
...جعلتنا نطاردك كلّ هذا الوقت

161
00:14:11,320 --> 00:14:14,630
.مُنحت مُهمّة

162
00:14:23,190 --> 00:14:26,270
...فلماذا أنا

163
00:14:38,060 --> 00:14:40,830
...كلب ذكيّ عثر على سيّد جديد

164
00:14:42,460 --> 00:14:45,120
.انتبه على من تنبح

165
00:14:45,480 --> 00:14:46,790
من أنت؟

166
00:14:47,240 --> 00:14:51,490
.كلّ ما أطلبه من العذراء أمامي هو شيء واحد الآن

167
00:14:51,930 --> 00:14:54,210
.أحضري لي الغصن الذّهبيّ

168
00:14:54,210 --> 00:14:58,680
.ذاك الّذي يفيض بثمار القوّة البيضاء

169
00:14:59,610 --> 00:15:01,510
غصن ذهبيّ؟

170
00:15:02,160 --> 00:15:08,090
.يا له من صوت غريب
.إنّه حلو ودبق كالعسل

171
00:15:08,090 --> 00:15:09,830
.إنّها تقصد نبات الهدال

172
00:15:10,350 --> 00:15:11,670
.إلياس

173
00:15:12,040 --> 00:15:13,510
.تحلّي بالقوّة

174
00:15:13,510 --> 00:15:15,030
.لا تبعدي نظرك

175
00:15:15,480 --> 00:15:17,130
.لكن لا تنظري إلى عينيها

176
00:15:17,560 --> 00:15:18,950
.هذا سيّئ

177
00:15:19,870 --> 00:15:23,930
.لم أتوقّع ظهور إلهة مثلها في هذا الوقت بالتّحديد

178
00:15:23,930 --> 00:15:25,810
.أيّها الكائن المرقّع

179
00:15:25,810 --> 00:15:27,920
.يا بقايا ظلال الغابة

180
00:15:28,570 --> 00:15:32,090
،يا كومة الأغصان والأوراق الذّابلة
.والموت والشّتاء

181
00:15:32,830 --> 00:15:35,360
.يا ابن نطاقي

182
00:15:35,360 --> 00:15:39,370
،ما رائحة العفن الّتي تشمّها في أحلامك

183
00:15:39,370 --> 00:15:41,500
مغطّى بأجزاء لا تحصى من اللّحم والجلد؟

184
00:15:44,300 --> 00:15:48,970
.أعتذر على مظهري القبيح يا سيّدة الشّتاء واللّيل

185
00:15:49,320 --> 00:15:52,680
...واثقة أنّ ابنتي قد أخبرتك

186
00:15:52,680 --> 00:15:56,460
.أنّه في السّنة القادمة، ستقدّم ثمرتك إلى الأمّ

187
00:15:57,920 --> 00:15:58,830
ماذا؟

188
00:16:00,780 --> 00:16:03,600
.لا بدّ أنّك خاطئة

189
00:16:05,810 --> 00:16:08,480
.هذه العذراء ما زالت يافعة

190
00:16:09,040 --> 00:16:13,160
.سيكون من الصّعب تقديم قربان لك هنا والآن

191
00:16:14,530 --> 00:16:17,500
.سأعود قريبًا وأنا مستعدّ

192
00:16:18,200 --> 00:16:20,550
.أتمنّى أن تغفري لي الآن

193
00:16:22,810 --> 00:16:23,960
ألم ينفع هذا؟

194
00:16:24,610 --> 00:16:26,970
.لكنّه خياري الوحيد

195
00:16:26,970 --> 00:16:28,080
...أشمّ

196
00:16:31,360 --> 00:16:34,270
.أشمّ رائحة الحرب القادمة

197
00:16:35,540 --> 00:16:40,810
مع أنّه لن تُحمل فيها رماح أو سيوف
...أو دروع أو أبوق حرب

198
00:16:44,110 --> 00:16:45,930
.نعم، نعم

199
00:16:46,270 --> 00:16:51,010
،عندما يكون المرء محاصرًا
.فلا وقت له للبحث عن ثمرة الحبّ

200
00:16:51,010 --> 00:16:52,280
...تبًّا

201
00:16:52,280 --> 00:16:54,830
.لا أريد التّعامل مع أيّ منهم

202
00:16:54,830 --> 00:16:55,860
...في تلك الحالة

203
00:16:55,860 --> 00:16:57,780
ما الّذي ترغبين به

204
00:16:57,780 --> 00:17:04,680
أيّتها العصفورة الصّغيرة الّتي ستأخذ شكل
وحش يرمز للغرابة والعداء فقط للطّيران؟

205
00:17:06,210 --> 00:17:07,240
...ماذا

206
00:17:07,660 --> 00:17:09,440
ماذا أريد؟

207
00:17:09,440 --> 00:17:10,690
ماذا أفعل؟

208
00:17:11,440 --> 00:17:12,280
—أنا

209
00:17:12,280 --> 00:17:12,840
.تشيسي

210
00:17:13,590 --> 00:17:17,360
،إن كنت لا تريدين التّخلّي عن شيء عزيز عليك

211
00:17:17,360 --> 00:17:19,330
.فلا يجب عليك طلب أمنية من الآلهة

212
00:17:21,670 --> 00:17:23,940
.شقيّ ماكر

213
00:17:23,940 --> 00:17:28,360
،سأمنحك مساعدتي في الوقت الرّاهن

214
00:17:28,980 --> 00:17:32,360
.بشرط أن أحصل على الغصن الذّهبيّ لاحقًا

215
00:17:32,360 --> 00:17:34,420
ماذا؟ عمّ يتحدّثون؟

216
00:17:34,420 --> 00:17:36,200
ما الّذي يفعلونه هنا؟

217
00:17:36,560 --> 00:17:39,040
.اسعي خلف شكلي

218
00:17:39,040 --> 00:17:41,160
.شكّلي حدود كياني

219
00:17:41,160 --> 00:17:44,030
.قيّديني بنفسي

220
00:17:44,030 --> 00:17:45,550
.تكلّمي

221
00:17:50,270 --> 00:17:56,170
تشيسي، لا يستطيع لا أنا ولا أنت رفض
.طلب أحد الآلهة القدامى

222
00:17:56,790 --> 00:18:01,040
لا أعرف إن كان هذا سيجعل وضعنا
...يتحسّن أم يسوء، ولكن

223
00:18:01,040 --> 00:18:04,710
،إن كان عليّ القيام بهذا الآن
.فسأقوم به وثمّ سأقرّر

224
00:18:05,430 --> 00:18:07,870
.هكذا أعرفك

225
00:18:08,730 --> 00:18:10,190
.اتبعيني

226
00:18:11,540 --> 00:18:14,780
.بما أنّه تمّ استدعاؤك الآن، عليك معرفة اسمها

227
00:18:18,080 --> 00:18:20,050
،على أرض المعركة

228
00:18:20,050 --> 00:18:22,360
.تحت السّماء ذات الغيوم الدّمويّة

229
00:18:22,360 --> 00:18:23,500
!أوقفوا التّرانيم

230
00:18:23,790 --> 00:18:25,780
!إنّها إلهة ضامرة منسيّة

231
00:18:26,670 --> 00:18:28,900
!اقتلوا الوسيط قبل أن يُنطق باسمها

232
00:18:31,600 --> 00:18:33,370
لماذا قد أسمح بذلك؟

233
00:18:33,730 --> 00:18:35,570
.غنّي عن حزنك

234
00:18:35,570 --> 00:18:37,500
.اغسلي الدّم بدرعك

235
00:18:37,860 --> 00:18:40,610
،يا ملكة الكوابيس الضّاحكة في اللّيل

236
00:18:40,610 --> 00:18:44,360
...يا عشيقة الأبطال وأمّ المحاربين

237
00:18:44,860 --> 00:18:46,810
.ضعي تاج الأشواك على رأسك

238
00:18:47,250 --> 00:18:49,140
.انطقي باسمك

239
00:18:50,440 --> 00:18:53,810
.اسم الإلهة موريغان

240
00:18:58,760 --> 00:19:04,330
،قبل ألفيّة من الزّمن، فقدت شعبي ولغتي

241
00:19:04,860 --> 00:19:07,010
.وسُلبت منّي أرضي

242
00:19:08,270 --> 00:19:14,200
وبعد ألفيّة من الزّمن، استُدعيت
.من طرف عذراء من بعيد

243
00:19:15,950 --> 00:19:17,220
!ما هذه الأشياء؟

244
00:19:17,570 --> 00:19:22,720
،والآن يا خيرة رجالي الأقوياء
.هذه المعركة الّتي لطالما انتظرتموها

245
00:19:23,030 --> 00:19:24,410
.مزّقوهم لأشلاء

246
00:19:24,960 --> 00:19:29,210
.اطعنوا أجسادهم وحطّموا عظامهم واقطعوهم

247
00:19:29,210 --> 00:19:32,900
.عيشوا ببسالة وانهبوا بشراهة

248
00:19:33,320 --> 00:19:36,400
.اهربوا بكلّ شفقة وموتوا في ألسنة اللّهب

249
00:19:36,820 --> 00:19:46,250
اعلموا أنّ لا أحد على ساحة معركة
.الإلهة موريغان يمكنه الهرب

250
00:19:55,770 --> 00:19:58,250
.يا مسكين

251
00:19:58,830 --> 00:20:01,910
لم تتوقّع أبدًا أن تكون معركتك الأولى هكذا، صحيح؟

252
00:20:06,670 --> 00:20:10,770
يبدو أنّنا سنتمكّن من الوصول للقصر
.دون أن نُهاجَم بفضلها

253
00:20:11,300 --> 00:20:17,280
انتهى الأمر على خير، لكنّ أفعال
.الآلهة لا يُمكن توقّعها بالفعل

254
00:20:17,680 --> 00:20:19,450
.وكذلك أفعالك

255
00:20:19,890 --> 00:20:21,020
تشيسي؟

256
00:20:21,020 --> 00:20:22,120
.لا شيء

257
00:20:22,120 --> 00:20:23,230
.لنذهب

258
00:20:24,700 --> 00:20:26,880
.لم أظنّ أنّ لديّ خيارًا آخر

259
00:20:26,880 --> 00:20:30,110
.أنا مسرورة فقط أنّي لا أعرف أيًّا منهم

260
00:20:30,500 --> 00:20:35,530
هل أعرف فعلاً كيف أميّز بين النّاس والخرفان؟

261
00:20:40,090 --> 00:20:41,610
هـ-هل خرجنا؟

262
00:20:41,610 --> 00:20:43,110
أين نحن؟

263
00:20:43,110 --> 00:20:45,510
.ساحة قصر عائلة سيرجنت

264
00:20:45,980 --> 00:20:49,780
ما الّذي حدث؟

265
00:20:49,780 --> 00:20:51,170
.أشياء كثيرة

266
00:20:51,170 --> 00:20:52,360
.تبدين شاحبة

267
00:20:53,060 --> 00:20:55,560
.استمعوا لي يا رفاق

268
00:20:55,560 --> 00:20:57,390
.علينا أن نرتّب أهدافنا

269
00:20:57,760 --> 00:20:58,690
أهدافنا؟

270
00:20:59,000 --> 00:21:00,790
ما الشّيء الّذي سنمنحه الأولويّة؟

271
00:21:00,790 --> 00:21:04,480
.علينا أن نقرّر ذلك، وإلاّ حلّ خلاف بيننا لاحقًا

272
00:21:05,480 --> 00:21:08,970
.سنعيد أنا وتشيسي فيلوميلا حيّة

273
00:21:08,970 --> 00:21:09,950
موافقة؟

274
00:21:09,950 --> 00:21:10,770
.نعم

275
00:21:11,140 --> 00:21:12,420
لوسي؟

276
00:21:12,420 --> 00:21:16,550
.لديّ عدّة أسئلة لها ولعائلتها

277
00:21:16,550 --> 00:21:17,660
زوي؟

278
00:21:17,660 --> 00:21:22,750
.أريد من لو— الجميع أن يعودوا سالمين

279
00:21:22,750 --> 00:21:23,890
.لذلك سأقدّم المساعدة

280
00:21:24,410 --> 00:21:26,460
ماذا عنك يا أستاذ إينزوورث؟

281
00:21:26,460 --> 00:21:29,740
.سأراقب لأحرص ألاّ تبالغ تلميذتي في القيام بالأمور

282
00:21:29,740 --> 00:21:31,540
.ودعونا لا نبالي بالأستاذ زاكّروني

283
00:21:31,540 --> 00:21:32,390
!أنت

284
00:21:33,030 --> 00:21:36,050
.أعتقد أنّ كلّ اهتماماتنا قد حُدّدت

285
00:21:36,050 --> 00:21:37,700
...لذلك أوّلاً، فيلوميلا

286
00:21:42,420 --> 00:21:43,560
!مستذئبة؟

287
00:21:44,710 --> 00:21:45,870
!إنّها هي

288
00:21:45,870 --> 00:21:48,280
!سنلحق بكم لاحقًا يا رفاق

289
00:21:48,280 --> 00:21:50,350
...زوي؟ لماذا

290
00:21:51,390 --> 00:21:55,270
.هذه المهمّة لي أنا

291
00:21:55,270 --> 00:21:56,490
!اذهبوا بدوني

292
00:21:59,890 --> 00:22:03,050
...إنّه محقّ بكونها أفضل طريقة لتوفير الوقت

293
00:22:03,050 --> 00:22:04,100
...لكن

294
00:22:12,700 --> 00:22:14,110
...يا إلهي

295
00:22:14,110 --> 00:22:17,610
كنتُ آمل استعمال هذا بينما
...لوسي في ورطة، لكن

296
00:22:19,310 --> 00:22:21,730
تجري الرّياح بما لا تشتهي السّفن، صحيح؟

297
00:24:07,250 --> 00:24:10,960
.من لدغته الأفعى يخاف من الحبل