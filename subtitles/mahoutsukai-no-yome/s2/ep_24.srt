1
00:01:32,020 --> 00:01:37,990
على العرض أن يستمرّ. 1

2
00:01:33,120 --> 00:01:35,060
...حسنًا

3
00:01:35,060 --> 00:01:38,100
هل ننهي هذا الأمر؟

4
00:01:56,580 --> 00:01:59,800
...أيّها الخاطي على حطام الزّمن

5
00:02:02,390 --> 00:02:04,850
...السّائر عبر الرّماد

6
00:02:07,270 --> 00:02:11,210
...سيّد حطام الزّمن

7
00:02:12,140 --> 00:02:15,580
.لا يشبه هذا أيّ شيء ممّا قرأته سرًّا

8
00:02:16,700 --> 00:02:20,480
.ربّما كان الغرض منه أن يُستعمل من طرف البشر

9
00:02:36,190 --> 00:02:37,820
!لقد أظهر ردّة فعل

10
00:02:39,800 --> 00:02:40,970
فيلوميلا؟

11
00:02:41,540 --> 00:02:42,590
!فيلوميلا

12
00:02:47,890 --> 00:02:52,340
.يا لك من فتاة غبيّة معدومة الفائدة

13
00:02:53,290 --> 00:02:55,910
،لو لم تولدي قطّ

14
00:02:55,910 --> 00:03:02,080
.لكان آدم وليليث قد استطاعا الهرب

15
00:03:04,390 --> 00:03:05,370
!فيلوميلا

16
00:03:06,010 --> 00:03:07,780
هل أنت بخير يا فيلوميلا؟

17
00:03:07,780 --> 00:03:09,710
!هناك شيء ما يتدخّل في الأمر

18
00:03:14,410 --> 00:03:20,720
.لو كنتِ مؤهّلة أكثر، ما كنتُ لأضطرّ لضربك

19
00:03:21,120 --> 00:03:23,530
.لكن لا بأس بذلك

20
00:03:23,530 --> 00:03:28,140
.أنا مسرورة لأنّك وُلدت غير مؤهّلة

21
00:03:28,460 --> 00:03:32,560
.ستُثبتين أنّك ذات نفع لي في النّهاية قبل كلّ شيء

22
00:03:43,680 --> 00:03:47,390
.كنتِ أنتِ من أردتني على تلك الحالة يا جدّتي

23
00:03:48,940 --> 00:03:51,510
.كلّ ذلك لكي أصغي إليك

24
00:03:51,510 --> 00:03:55,530
.لكي لا أتمكّن من التّفكير بنفسي

25
00:03:55,530 --> 00:03:56,330
.لعنتني

26
00:03:57,500 --> 00:04:00,430
...ولكنّي تعلّمت

27
00:04:01,540 --> 00:04:02,760
.أنّه مسموح لي تجاهلك

28
00:04:03,220 --> 00:04:04,050
.وأن أغضب

29
00:04:04,670 --> 00:04:06,310
.وأن أصرخ أيضًا

30
00:04:06,710 --> 00:04:10,320
.يمكنني الاختيار لنفسي وامتلاك أمنياتي الخاصّة

31
00:04:11,870 --> 00:04:14,810
.لذلك فهذا ما آمل فعله

32
00:04:14,810 --> 00:04:16,140
...ذلك الشّيء

33
00:04:16,560 --> 00:04:19,700
.أعطتني تشيسي حرف ثوريساز الرّونيّ

34
00:04:19,700 --> 00:04:24,240
إنّ الحرف الواحد من الحروف الرّونيّة
.الّذي له أكثر من معنى واحد

35
00:04:29,580 --> 00:04:30,670
".بوّابة"

36
00:04:32,770 --> 00:04:33,450
".عملاق"

37
00:04:35,210 --> 00:04:36,120
".روح"

38
00:04:38,540 --> 00:04:39,240
".شوكة"

39
00:04:41,260 --> 00:04:45,170
!"وأيضًا... "مطرقة ثور

40
00:04:47,290 --> 00:04:48,660
!فيلوميلا

41
00:04:47,750 --> 00:04:53,290
جدّتي، أنا واثقة أنّ هنالك الكثير
.ممّا أريد القيام به

42
00:04:53,700 --> 00:04:57,340
.لذلك سأبطل اللّعنة الّتي وضعتِ عليّ

43
00:05:11,190 --> 00:05:12,300
...مهلاً، هل أنت

44
00:05:12,300 --> 00:05:15,920
!تشبّثوا بي جميعًا

45
00:05:17,210 --> 00:05:18,240
.حسنًا

46
00:05:18,240 --> 00:05:19,960
.لا حاجة لإخباري بذلك

47
00:05:20,840 --> 00:05:21,950
.يمكنك الاعتماد علينا

48
00:05:27,320 --> 00:05:31,820
.ها أنا الآن، أغلق بوّابة تؤدّي للفراغ مرتعشة

49
00:05:32,400 --> 00:05:35,850
.أصابع تذبل مفارقة عالمنا هذا

50
00:05:35,850 --> 00:05:38,260
.لتنقطع أنظارنا عن النّجوم المنعكسة في السّماء

51
00:05:38,260 --> 00:05:43,220
.حيّي من مسافات بعيدةً الأذرعَ المرّحبة

52
00:05:44,030 --> 00:05:46,220
!إنّها تأخذ قوّتي السّحريّة

53
00:05:50,260 --> 00:05:51,570
.يوجد شيء ما هناك

54
00:05:51,940 --> 00:05:53,170
.شيء آخر

55
00:05:55,230 --> 00:05:59,600
أرى أنّك أتيت منجذبًا لرائحة لمساعدة
.أمّ من أرض غريبة

56
00:06:00,050 --> 00:06:03,300
.إنّ عذرائي غايةٌ للكثيرين بالفعل

57
00:06:03,910 --> 00:06:08,040
!أعرض عليك أغنية العودة لمكان بعيد

58
00:06:26,650 --> 00:06:27,850
.لا تنظري

59
00:06:55,230 --> 00:06:56,940
.أرى أنّك استيقظت

60
00:06:57,520 --> 00:06:59,370
...هذا مؤلم

61
00:06:58,570 --> 00:07:00,600
ماذا كنت أفعل؟

62
00:07:02,690 --> 00:07:04,320
!آنسة فيرونيكا

63
00:07:04,320 --> 00:07:06,190
.حمدًا على هذا

64
00:07:11,700 --> 00:07:13,270
هل اختفى؟

65
00:07:19,850 --> 00:07:22,170
.يا لها من أغنية رائعة

66
00:07:22,170 --> 00:07:25,260
...أيّتها العذراء المقيّدة بإلهة غريبة

67
00:07:25,260 --> 00:07:27,500
.أحسنت بتحرير نفسك

68
00:07:27,500 --> 00:07:29,850
.وهكذا تنتهي الاحتفالات

69
00:07:30,410 --> 00:07:33,410
.لم أقاتل في معركة مثمرة منذ وقت بعيد

70
00:07:33,960 --> 00:07:39,310
،وتقديرًا منّي لهذه المتعة
.لن أطالب بأيّ تعويض آخر

71
00:07:39,690 --> 00:07:45,310
.يا عذرائي، لا تنسي أبدًا التّضحية

72
00:07:49,790 --> 00:07:50,870
.نعم

73
00:08:10,380 --> 00:08:11,430
.آهٍ

74
00:08:11,430 --> 00:08:13,090
.يا له من منظر مثير للشّفقة

75
00:08:13,090 --> 00:08:16,630
.ما عاد وجود لولدك بعد الآن

76
00:08:17,220 --> 00:08:18,860
.أنا لستُ آدم

77
00:08:22,670 --> 00:08:27,150
لماذا لم تأتِ لقتلي؟

78
00:08:28,190 --> 00:08:30,280
.كان بإمكانك فعل ذلك

79
00:08:30,280 --> 00:08:32,840
.أنت ابني قبل كلّ شيء

80
00:08:33,970 --> 00:08:36,260
.كنتِ قادرة على ذلك أيضًا

81
00:08:36,260 --> 00:08:37,940
.ليزبث سارجنت

82
00:08:39,040 --> 00:08:41,570
.لقد أنجبَتها امرأة كرهتِها كلّ الكره

83
00:08:41,570 --> 00:08:44,230
.كان بمقدورك قتلها

84
00:08:45,610 --> 00:08:47,660
.لكنّك لم تفعلي

85
00:08:56,170 --> 00:08:59,930
.قلتُ لنفسي أنّها قد تكون ذات فائدة لي يومًا ما

86
00:09:01,310 --> 00:09:03,180
.يا لك من امرأة مثيرة للشّفقة

87
00:09:04,310 --> 00:09:07,860
.قويّة جدًّا لدرجة أنّك عجزت عن التّقرّب من أيّ أحد

88
00:09:07,860 --> 00:09:09,550
.كما لم تحاولي من الأساس

89
00:09:10,070 --> 00:09:13,190
.لم يتواجد أيّ أحد إلى جانبك حتّى النّهاية

90
00:09:14,370 --> 00:09:16,540
.يبدو أنّ مهمّتي قد اكتملت أيضًا

91
00:09:20,640 --> 00:09:24,820
.الوداع يا ابنة آدم

92
00:09:37,130 --> 00:09:39,130
...جدّتي، أنت

93
00:09:39,130 --> 00:09:40,510
!اعفيني من شفقتك

94
00:09:40,510 --> 00:09:44,350
!لا حاجة لي بأيّ كلمة ممّا لديك لتقولينه

95
00:09:45,110 --> 00:09:46,940
.هناك أمر أريد أن أسألك عنه

96
00:09:47,290 --> 00:09:51,050
لماذا هاجمت عائلة وبستر؟

97
00:09:52,430 --> 00:09:54,190
.يجب أن أعرف

98
00:09:54,580 --> 00:09:58,660
.عليّ تقديم شرح للوسي

99
00:10:00,770 --> 00:10:04,420
...كلّما قلّ من عرفوا، كان أفضل

100
00:10:14,670 --> 00:10:16,340
!يا لرشاقتك

101
00:10:16,680 --> 00:10:18,080
!زاكّروني

102
00:10:19,940 --> 00:10:22,670
.أرى أنّكم جميعًا أحياء

103
00:10:23,200 --> 00:10:26,260
.اتّضح أنّك جليس أطفال ممتاز

104
00:10:26,260 --> 00:10:27,490
.وكذلك أنت

105
00:10:31,400 --> 00:10:32,980
.فهمت

106
00:10:32,980 --> 00:10:36,890
،لا أعرف أليفَ من يكون ذاك
.لكنّه صار هدفي الآن

107
00:10:38,870 --> 00:10:39,690
!روث

108
00:10:39,690 --> 00:10:40,670
!حاضر

109
00:10:54,270 --> 00:10:55,050
!تشيسي

110
00:10:57,220 --> 00:10:58,260
...إنّه

111
00:10:58,910 --> 00:11:00,570
...إنّه طفلي

112
00:11:01,080 --> 00:11:02,260
!ما زال حيًّا

113
00:11:07,130 --> 00:11:09,180
تشيسي، هل أنت بخير؟

114
00:11:09,180 --> 00:11:10,130
.نعم

115
00:11:10,730 --> 00:11:12,120
...الكتاب

116
00:11:13,120 --> 00:11:14,350
.فيلوميلا

117
00:11:15,710 --> 00:11:18,010
.هذا مثلما يحدث مع تشيسي طوال الوقت

118
00:11:18,010 --> 00:11:19,640
.لقد أتعبت نفسك

119
00:11:19,640 --> 00:11:21,980
إلياس، ما العمل؟

120
00:11:21,980 --> 00:11:23,140
...الكتاب

121
00:11:23,140 --> 00:11:25,270
.لقد سُرق. ليس بوسعنا فعل أيّ شيء

122
00:11:25,790 --> 00:11:28,040
.لكن يبدو أنّ زاكّروني يسعى خلفه

123
00:11:28,480 --> 00:11:31,000
.أنت لا تهتمّ بالفعل

124
00:11:33,250 --> 00:11:34,210
تشيسي؟

125
00:11:35,520 --> 00:11:41,510
هل أبليتُ حسنًا هذه المرّة؟

126
00:11:46,170 --> 00:11:48,840
.هكذا هو الحال على الدّوام

127
00:11:49,380 --> 00:11:50,650
.يا إلهي منك

128
00:11:52,170 --> 00:11:53,340
.لنعد للمنزل

129
00:13:09,050 --> 00:13:10,190
.لقد استيقظتِ

130
00:13:10,490 --> 00:13:11,560
!صباح الخير

131
00:13:14,630 --> 00:13:16,360
أين كنتِ؟

132
00:13:16,930 --> 00:13:18,330
وأين أنا؟

133
00:13:18,330 --> 00:13:20,560
.ذهبتُ لأحضر هذه فحسب

134
00:13:21,290 --> 00:13:22,460
نبات الهدال؟

135
00:13:22,920 --> 00:13:23,950
.نعم

136
00:13:23,950 --> 00:13:26,100
.سنحتاجه قريبًا

137
00:13:26,100 --> 00:13:27,810
سنحتاجه؟

138
00:13:27,810 --> 00:13:28,480
...عفوًا

139
00:13:29,310 --> 00:13:31,710
.هذا هو منزل إلياس

140
00:13:32,260 --> 00:13:36,240
فكّرنا أنّه سيكون من المزعج
...العودة للكلّيّة، لذا

141
00:13:36,970 --> 00:13:40,470
مسموح لنا بأخذ بعض الوقت
.حتّى بداية التّحقيق في الأمر

142
00:13:40,960 --> 00:13:44,790
وستبدأ العطلة الشّتويّة اليوم
.بالنّسبة للبقيّة في الكلّيّة

143
00:13:45,380 --> 00:13:47,640
...العطلة الشّتويّة

144
00:13:48,420 --> 00:13:50,620
.لا أعرف كيف أستجمع أفكاري

145
00:13:51,130 --> 00:13:54,120
ما الّذي عليّ أن أقلق عليه أوّلاً؟

146
00:13:54,690 --> 00:13:59,480
هل هنالك شيء ما تريدين القيام به خلال العطلة؟

147
00:14:00,700 --> 00:14:01,890
ماذا عنك؟

148
00:14:05,850 --> 00:14:08,060
.سأزيّن الشّجرة

149
00:14:08,060 --> 00:14:10,740
...وأتسوّق لنهاية السّنة و

150
00:14:12,390 --> 00:14:15,000
.أريد تجربة بعض مفرقعات الحفلات هذه السّنة

151
00:14:16,140 --> 00:14:20,120
،كما سأخصّص وقتًا للفضّيّة أيضًا
.فقد ابتعدنا عنها طويلاً

152
00:14:23,480 --> 00:14:24,750
...أنا

153
00:14:27,540 --> 00:14:29,660
.أريد صناعة كيس أعشاب عطرة

154
00:14:29,660 --> 00:14:30,790
.معك

155
00:14:35,850 --> 00:14:37,030
!بالطّبع

156
00:14:38,050 --> 00:14:40,270
!مهلاً! أنت سريع جدًّا

157
00:14:40,500 --> 00:14:42,320
هل جرّبت أن تركض؟

158
00:14:44,890 --> 00:14:45,640
!ريان

159
00:14:48,570 --> 00:14:49,920
.والسّيّد توري

160
00:14:50,390 --> 00:14:51,480
.مرحبًا

161
00:14:57,480 --> 00:14:58,580
...أنت

162
00:15:05,500 --> 00:15:06,800
.كم أنا مسرور لأنّك بخير

163
00:15:08,340 --> 00:15:10,600
.ستغرب الشّمس باكرًا

164
00:15:10,600 --> 00:15:12,890
.ستظلّ النّجوم والقمر مستيقظين طوال اللّيل

165
00:15:13,580 --> 00:15:15,530
.اللّيل وشيك

166
00:15:15,530 --> 00:15:18,300
.اللّيلة الطّويلة والقصيرة وشيكة

167
00:15:18,780 --> 00:15:20,070
.مرحبًا

168
00:15:20,800 --> 00:15:24,240
.يا ابنة البشر وابنة التّنانين وابنة الإلهة

169
00:15:24,610 --> 00:15:29,310
.تنتظر أمّ الشّتاء بشوق على التّلّة الشّرقيّة

170
00:15:29,310 --> 00:15:31,590
.من الأفضل أن تذهبي

171
00:15:32,090 --> 00:15:32,940
.نعم

172
00:15:36,780 --> 00:15:38,280
.توري

173
00:15:38,280 --> 00:15:41,160
هل يمكنك مرافقتهما للمنزل؟

174
00:15:41,460 --> 00:15:45,000
.سأذهب لأيّ مكان ما دام دافئًا

175
00:15:49,000 --> 00:15:51,170
فيلوميلا، هل أنت بخير؟

176
00:15:52,480 --> 00:15:53,280
.نعم

177
00:15:59,370 --> 00:16:00,960
!هيّا، لنذهب بسرعة

178
00:16:00,960 --> 00:16:02,640
.سأموت من البرد

179
00:16:14,870 --> 00:16:16,060
.لا بدّ أنّك تشعرين بالبرد

180
00:16:18,220 --> 00:16:19,080
.هيّا بنا

181
00:16:22,010 --> 00:16:22,900
.حسنًا

182
00:16:28,550 --> 00:16:31,600
أين هي التّلّة الشّرقيّة؟

183
00:16:32,100 --> 00:16:33,160
.تشيسي

184
00:16:33,160 --> 00:16:34,190
.هناك

185
00:17:23,060 --> 00:17:27,350
.شكرًا لمنحك أمّي أغصان زهور قطرات الثّلج

186
00:17:29,870 --> 00:17:34,560
.ليكن الموسم التّالي موسمًا لامعًا

187
00:17:37,850 --> 00:17:42,950
إنّك محظوظة للغاية لأنّها لم تطلب
.رأس مائة محارب أو ما شابه

188
00:17:44,120 --> 00:17:47,850
.عليك أن تتعلّمي أن تقولي لا

189
00:17:47,850 --> 00:17:49,830
.وأنا جادّ هذه المرّة

190
00:17:49,830 --> 00:17:50,980
.حاضرة

191
00:17:54,220 --> 00:17:55,220
إلياس؟

192
00:17:56,230 --> 00:17:57,490
.ستكون مفيدة

193
00:17:57,490 --> 00:17:59,410
.لنأخذه بعضها للمنزل، بإمكاننا بيعها أيضًا

194
00:18:00,160 --> 00:18:01,970
زهور قطرات الثّلج؟

195
00:18:01,970 --> 00:18:05,370
،يُقال في بعض المناطق
،إن وجدتها قبل نهاية السّنة

196
00:18:05,370 --> 00:18:08,410
.فستنعمين بحظّ جيّد

197
00:18:08,410 --> 00:18:09,600
فعلاً...؟

198
00:18:11,740 --> 00:18:12,580
.تفضّلي

199
00:18:17,720 --> 00:18:19,930
.يا لها من زهرة جميلة

200
00:18:25,990 --> 00:18:27,410
...من أجل كيس الأعشاب العطرة

201
00:18:27,410 --> 00:18:29,820
.فالمكوّنات بسيطة للغاية

202
00:18:30,260 --> 00:18:32,300
.لدينا الكثير من الإبر أيضًا

203
00:18:32,300 --> 00:18:33,540
.يمكنك استعمال ما تريدين

204
00:18:34,060 --> 00:18:36,230
ما أريد؟

205
00:18:36,230 --> 00:18:41,400
صحيح، هل يمكنني الحصول على ما
تبقّى من الأثواب والإبر والخيوط؟

206
00:18:41,400 --> 00:18:44,070
.أريد صناعة بعض الهدايا للآخرين أيضًا

207
00:18:44,070 --> 00:18:45,270
.بالطّبع

208
00:19:37,610 --> 00:19:38,980
.أحسنت

209
00:19:39,360 --> 00:19:41,260
هل حصلت عليه؟

210
00:19:41,870 --> 00:19:43,030
.فهمت

211
00:19:43,030 --> 00:19:44,350
.عمل جيّد

212
00:19:46,730 --> 00:19:48,890
.أحضرت لك وجبة

213
00:19:48,890 --> 00:19:51,120
هل أنت بخير؟

214
00:19:54,260 --> 00:19:55,810
.شكرًا

215
00:19:55,810 --> 00:19:57,110
.سأتناولها الآن

216
00:20:02,710 --> 00:20:05,140
...ما عاد بإمكاني أكل المزيد

217
00:20:06,120 --> 00:20:08,920
.لنلعب بالأوراق تاليًا

218
00:20:09,720 --> 00:20:12,080
.يبدو أنّنا سنأكل حساءً أبيضًا الآن

219
00:20:12,080 --> 00:20:14,250
.أنا أطير من السّعادة

220
00:20:14,250 --> 00:20:15,270
.يمكنني أكل المزيد

221
00:20:15,270 --> 00:20:16,830
فعلاً؟

222
00:20:16,830 --> 00:20:18,730
ماذا؟ أين تشيسي؟

223
00:20:22,840 --> 00:20:24,480
.أعدّت الفضّيّة هذا

224
00:20:25,210 --> 00:20:27,820
.أخبرتك أنّي لا أحتاجه

225
00:20:46,410 --> 00:20:47,550
...وإذًا

226
00:20:48,210 --> 00:20:50,880
ما الّذي كان عليك أن تضحّي به
للنّجاة هذه المرّة؟

227
00:20:51,880 --> 00:20:54,730
.أعتقد أنّي قمتُ بما أستطيعه

228
00:20:55,250 --> 00:21:02,430
،ولكن بسبب ذلك، مات الكثيرون
.ولم أفعل أيّ شيء حيال الأمر

229
00:21:03,490 --> 00:21:04,740
وبعد؟

230
00:21:05,380 --> 00:21:08,420
.أخبرتُ نفسي أنّه لا مهرب من ذلك

231
00:21:17,220 --> 00:21:19,270
.سبق وأخبرتك

232
00:21:19,270 --> 00:21:22,000
ما الفرق بيني وبينك؟

233
00:21:22,000 --> 00:21:25,200
.تعلّمتِ أخيرًا أن تفكّري في نفسك أوّلاً

234
00:21:25,200 --> 00:21:26,530
.تهانيّ لك

235
00:21:27,870 --> 00:21:30,510
.ليس وكأنّ ذلك ما أردته

236
00:21:30,510 --> 00:21:32,750
.لن يغيّر ذلك النّتيجة

237
00:21:35,640 --> 00:21:36,990
.بربّك

238
00:21:43,620 --> 00:21:45,770
.شيء تخلّيتُ عنه

239
00:21:46,650 --> 00:21:48,900
.شيء أردتُه وحصلتُ عليه

240
00:21:49,960 --> 00:21:51,780
.شيء أردتُ تقديره

241
00:21:53,130 --> 00:21:54,650
.شيء تخلّصتُ منه

242
00:21:56,970 --> 00:22:03,570
،ما زلت لا أعرف ما الصّواب
وما زال عليّ الاستمرار؟

243
00:22:10,610 --> 00:22:12,340
لم تقرّري بعد؟

244
00:22:15,570 --> 00:22:19,670
.لا أعرف ما الّذي أفضّله

245
00:22:26,780 --> 00:22:29,250
.لست مضطرّة لاختيار واحدة فقط

246
00:22:31,480 --> 00:22:33,020
.هناك الكثير منها

247
00:22:33,720 --> 00:22:36,390
.والكثير من الوقت

248
00:22:37,070 --> 00:22:39,520
.مهلاً، أرني تلك البطاقة

249
00:22:39,520 --> 00:22:40,680
.لن أفعل

250
00:22:40,680 --> 00:22:42,060
!لا تدفعني

251
00:22:58,880 --> 00:23:00,920
!ما الّذي تفعلونه؟

252
00:23:00,920 --> 00:23:02,300
...عفوًا

253
00:23:02,300 --> 00:23:03,430
ما هذا؟

254
00:23:03,430 --> 00:23:04,650
!آسف

255
00:23:34,220 --> 00:23:37,100
النّهاية

256
00:23:47,010 --> 00:23:51,930
.لا يمكنني أن أكون حليفك هذه المرّة

257
00:24:08,590 --> 00:24:10,960
.“الفصل التّالي، فصل ”قاتل الوحوش