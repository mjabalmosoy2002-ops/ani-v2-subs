1
00:00:11,460 --> 00:00:14,480
.توشك الرّائحة أن تزول

2
00:02:02,110 --> 00:02:04,590
.هذه الفتاة أيضًا

3
00:02:04,590 --> 00:02:06,980
إذًا فحالتها هي نفس حالة سيميون؟

4
00:02:07,890 --> 00:02:11,660
.يمتصّ كتاب "وصيّة كارناماغوس" قوّتها السّحريّة

5
00:02:12,980 --> 00:02:15,100
وصيّة كارناماغوس"؟"

6
00:02:16,210 --> 00:02:17,560
...عفوًا

7
00:02:17,560 --> 00:02:20,930
.إنّه كتاب شعوذة بإمكانه إيذاء النّاس حتّى الموت

8
00:02:21,540 --> 00:02:23,810
.اتُّفق على أنّ استعماله محرّم

9
00:02:24,380 --> 00:02:25,620
...مُحرّم

10
00:02:26,200 --> 00:02:27,370
،على هذا المعدّل

11
00:02:27,370 --> 00:02:31,130
،سيواصل امتصاص قوّتها
.مهما كان القدر الّذي نزوّدها به

12
00:02:31,840 --> 00:02:33,750
.هذه مشكلة

13
00:02:38,690 --> 00:02:43,280
.ربّما بإمكاني تقفّي إلى أين تُؤخذ قوّتها السّحريّة

14
00:03:00,320 --> 00:03:01,600
.أو ربّما لا

15
00:03:01,600 --> 00:03:02,500
أرأيت؟

16
00:03:03,440 --> 00:03:08,360
،لا أستطيع الجزم إن كانت هذه طبيعة التّعويذة
...أو إن كانوا يخفون أنفسهم

17
00:03:08,770 --> 00:03:12,670
.علينا الإمساك بالجاني بالجرم المشهود

18
00:03:13,470 --> 00:03:16,420
.إنّها تعويذة سيّئة. وهذا لا شكّ فيه

19
00:03:16,950 --> 00:03:21,280
.أفترض أنّ استيقاظ لوسي حتّى الآن كان بفضل تشيسي

20
00:03:21,280 --> 00:03:22,370
.على الأرجح

21
00:03:22,800 --> 00:03:27,040
أفترض أنّ الأمر يتطلّب سلاي بيغي
.لتزويد أكثر ممّا سُلب منها

22
00:03:27,650 --> 00:03:30,990
...لكن إن كان القصد هو القتل

23
00:03:30,990 --> 00:03:32,040
!كلاّ

24
00:03:32,750 --> 00:03:38,220
لا يملك أيّ منهما قوّة سحريّة كبيرة
.لتستحقّ أن تسلب منهما

25
00:03:38,630 --> 00:03:39,950
.بالضّبط

26
00:03:39,950 --> 00:03:42,740
.لا ندري لماذا تمّ اختيارهما كضحايا

27
00:03:44,080 --> 00:03:47,240
.في كلّ الأحوال، إنّها مشكلة بالنّسبة لي بسبب هويّتهما

28
00:03:47,240 --> 00:03:48,120
ماذا؟

29
00:03:48,120 --> 00:03:52,360
.ستقوم تشيسي بشيء متهوّر ثانية من أجل لوسي

30
00:03:53,000 --> 00:03:55,980
.ويمكن أن يصير سيميون صديقي

31
00:03:57,270 --> 00:03:59,700
.هذا مزعج، لكن عليّ حلّ هذه المشكلة

32
00:03:59,700 --> 00:04:00,850
.يا إلهي

33
00:04:00,850 --> 00:04:01,910
.لقد تفاجأت

34
00:04:01,910 --> 00:04:06,990
كان السّيّد ليندل والسّيّدة رحاب مجرّد
معارف"، بينما لإلياس صديق الآن؟"

35
00:04:07,620 --> 00:04:08,930
...سوف

36
00:04:08,930 --> 00:04:11,380
.سوف أقوم بأيّ شيء للمساعدة

37
00:04:11,380 --> 00:04:13,930
.لن أسمح لك بوضع نفسك في خطر

38
00:04:14,320 --> 00:04:18,450
إضافة لذلك، هذه ليست حادثة
.ليتورّط فيها الأطفال

39
00:04:18,690 --> 00:04:20,880
.لا علاقة لك بها أيضًا يا إلياس

40
00:04:20,880 --> 00:04:24,200
ومع ذلك، لكنّك قلت أنّك ستفعل
.شيئًا من أجل الأستاذ سيميون

41
00:04:24,200 --> 00:04:27,750
.أنا أتصرّف من أجل صالحك نوعًا ما أيضًا

42
00:04:27,750 --> 00:04:30,080
.إذًا لديّ علاقة بالأمر أيضًا

43
00:04:30,080 --> 00:04:33,240
.إنّها زميـ— صديقتي

44
00:04:33,790 --> 00:04:39,130
.ما زلت لا أفهم ذلك الجانب فيك

45
00:04:39,130 --> 00:04:40,120
!مهلاً

46
00:04:40,120 --> 00:04:42,010
.أنت طفلة. ابقي خارج الموضوع

47
00:04:42,450 --> 00:04:45,200
ألا ترين أنه قلق عليك؟

48
00:04:47,350 --> 00:04:51,050
.على أيّ حال، سأذهب لتبليغ المديرة بالوضع

49
00:04:51,050 --> 00:04:54,490
لا تذكروا هذا لأيّ أحد، مفهوم؟

50
00:04:55,180 --> 00:04:56,810
.هناك فصل إضافيّ اليوم

51
00:04:56,810 --> 00:04:58,890
.قد يساعد على شغل بالك

52
00:05:14,080 --> 00:05:15,510
.فيلوميلا

53
00:05:17,570 --> 00:05:20,590
.صباح الخير

54
00:05:22,480 --> 00:05:23,580
...عفوًا

55
00:05:24,550 --> 00:05:26,650
...مزيج الأعشاب الّذي أعطيتنيه

56
00:05:27,620 --> 00:05:29,600
.بدأت رائحته تزول

57
00:05:30,860 --> 00:05:32,040
...لذلك

58
00:05:40,770 --> 00:05:43,280
.صار الكيس رثًّا

59
00:05:44,510 --> 00:05:46,540
هل تريدين كيسًا جديدًا؟

60
00:05:46,540 --> 00:05:48,290
أم أغيّر المحتوى فحسب؟

61
00:05:49,190 --> 00:05:50,290
...غيّريه

62
00:05:50,610 --> 00:05:52,360
.لكن بنفس الرّوائح

63
00:05:57,410 --> 00:05:58,680
.أشمّ رائحة دماء

64
00:05:59,550 --> 00:06:01,920
أتريدين مزجه معًا لاحقًا؟

65
00:06:04,150 --> 00:06:06,580
هل هذا شيء يمكنني القيام به وحدي؟

66
00:06:06,580 --> 00:06:09,340
.سأحضر أنواع أكثر

67
00:06:15,840 --> 00:06:18,340
.لنقم بذلك يومًا ما إذًا

68
00:06:18,880 --> 00:06:21,420
.نعم، يومًا ما

69
00:06:23,520 --> 00:06:27,810
.درس اليوم الإضافيّ عن شعوذة الحروف الرّونيّة

70
00:06:28,200 --> 00:06:33,830
استُعملت الحروف الرّونيّة في الأصل
.في الحياة اليوميّة كنظام كتابة صوتيّ

71
00:06:33,830 --> 00:06:39,090
يتطلّب استعمالها في الشّعوذة درجة
.من المعرفة والأُلفة

72
00:06:39,690 --> 00:06:43,890
.يقال أنّ كلّ حرف لديه معنى خاصّ به

73
00:06:43,890 --> 00:06:45,420
،إضافة إلى التّكهّن

74
00:06:45,420 --> 00:06:49,090
،تُستعمل لأنواع في تمائم حماية مختلفة
.إضافة إلى الشّعوذة الهجوميّة

75
00:06:49,440 --> 00:06:53,550
.بمعنى آخر، استعمالاتها متعدّدة جدًّا

76
00:06:54,140 --> 00:06:55,960
...معنى كلّ واحد

77
00:06:54,960 --> 00:06:57,320
.هذا يبدو مثل شوكة

78
00:06:58,050 --> 00:07:00,120
هل أنت مهتمّة بذلك الحرف الرّونيّ؟

79
00:07:00,120 --> 00:07:01,380
.نعم

80
00:07:01,730 --> 00:07:04,320
.يُدعى ذلك الحرف ثوريساز

81
00:07:04,320 --> 00:07:08,880
...إنّه يعني عمالقة وجنّيّات وإله البرق ثور

82
00:07:09,450 --> 00:07:11,150
."وأيضًا "ثورن

83
00:07:11,150 --> 00:07:12,320
.وتعني أشواك

84
00:07:12,820 --> 00:07:14,180
."ثورن"

85
00:07:14,750 --> 00:07:18,710
.بإمكانك استعماله للحماية، لكنّي لا أنصح به

86
00:07:18,710 --> 00:07:24,300
.لن يحميك بالضّرورة بالطّريقة الّتي يفضّلها البشر

87
00:07:27,030 --> 00:07:28,050
.حسنًا

88
00:07:28,050 --> 00:07:32,510
سنتدرّب اليوم على استعمال الحروف
.الرّونيّة لصناعة تمائم حماية

89
00:07:32,510 --> 00:07:33,770
.حاضر

90
00:07:33,770 --> 00:07:36,020
أيّ الحروف أستعمل؟

91
00:07:36,020 --> 00:07:37,390
...أظنّني

92
00:07:36,530 --> 00:07:37,550
.تشيسي

93
00:07:37,390 --> 00:07:38,620
!أفضّل هذا

94
00:07:38,300 --> 00:07:40,600
كيف حال لوسي؟

95
00:07:38,620 --> 00:07:39,700
!يبدو جيّدًا

96
00:07:39,700 --> 00:07:41,090
.إنّه جميل

97
00:07:41,090 --> 00:07:42,000
.يناسبك

98
00:07:42,000 --> 00:07:42,860
فعلاً؟

99
00:07:42,860 --> 00:07:44,860
ما رأيك بهذا؟

100
00:07:56,150 --> 00:07:57,380
.زوي

101
00:07:58,290 --> 00:07:59,280
هل أيقظتك؟

102
00:07:59,750 --> 00:08:02,410
.أخبرتني تشيسي أنّك فقدت الوعي ثانية

103
00:08:02,410 --> 00:08:04,040
.عليك أن ترتاحي أكثر

104
00:08:04,540 --> 00:08:06,160
ما الوقت الآن؟

105
00:08:06,160 --> 00:08:07,440
.إنّه اللّيل

106
00:08:07,440 --> 00:08:10,370
.لديّ إذن من ألكساندرا

107
00:08:11,130 --> 00:08:12,410
...أخي

108
00:08:12,410 --> 00:08:13,050
ماذا؟

109
00:08:13,480 --> 00:08:15,000
لديك أخ؟

110
00:08:15,770 --> 00:08:17,270
.لا تهتمّ

111
00:08:17,820 --> 00:08:18,930
...عفوًا

112
00:08:18,930 --> 00:08:20,350
.عليك أن تنامي أكثر

113
00:08:20,820 --> 00:08:21,670
.حسنًا

114
00:08:22,360 --> 00:08:23,830
...عفوًا

115
00:08:23,830 --> 00:08:26,690
.أردت إلقاء التّحيّة عليك فحسب

116
00:08:27,270 --> 00:08:28,270
...ثعابينك

117
00:08:28,270 --> 00:08:28,900
ماذا؟

118
00:08:29,620 --> 00:08:33,490
هل يمكنني مداعبة ثعابينك؟

119
00:08:34,150 --> 00:08:34,990
!ماذا؟

120
00:08:36,860 --> 00:08:38,770
ماذا؟ ما المشكلة؟

121
00:08:38,770 --> 00:08:41,890
...لا شيء، أعني

122
00:08:52,950 --> 00:08:55,480
.اعتدتُ تربية العناكب

123
00:08:58,620 --> 00:09:01,330
.كانت ظريفة للغاية

124
00:09:02,590 --> 00:09:03,850
فعلاً؟

125
00:09:04,800 --> 00:09:06,540
...اسمعي يا لوسي

126
00:09:06,860 --> 00:09:13,150
لا يجدر بك أن تسألي الغورغون
.الآخرين أن يدعوك تداعبين ثعابينهم

127
00:09:13,720 --> 00:09:17,140
...لذلك معنى خاصّ بالنّسبة لنا

128
00:09:22,670 --> 00:09:24,320
.لا يهمّ

129
00:09:26,890 --> 00:09:28,760
.يا للشّباب

130
00:09:32,730 --> 00:09:36,360
.سنقيم في المدرسة لبعض الوقت

131
00:09:38,320 --> 00:09:42,160
.تكون لوسي أفضل بقليل وأنا إلى جانبها

132
00:09:42,160 --> 00:09:44,630
.أريد القيام بما أستطيع من أجلها

133
00:09:44,630 --> 00:09:46,470
.كما لديّ غرفة في المسكن أيضًا

134
00:09:48,470 --> 00:09:49,660
.أنا آسفة

135
00:09:49,660 --> 00:09:51,960
.سأعود إن احتجت إليّ

136
00:09:51,960 --> 00:09:54,140
.هذا فقط إلى أن نحلّ هذه المشكلة

137
00:09:55,750 --> 00:09:57,160
إلياس؟

138
00:09:57,160 --> 00:09:59,350
.وجب على إلياس البقاء هناك

139
00:09:59,890 --> 00:10:02,830
.قال أنّ للكبار مسؤوليّات

140
00:10:04,030 --> 00:10:05,680
...أخبريني أيّتها الفضّيّة

141
00:10:07,040 --> 00:10:11,230
.قال إلياس أنّه يقوم بذلك لأجل صديقه

142
00:10:11,230 --> 00:10:12,510
أليس هذا رائعًا؟

143
00:10:12,950 --> 00:10:17,670
...أنا سعيدة، ولكنّ مشاعري متضاربة

144
00:10:18,500 --> 00:10:20,460
...لا أدري كيف أصف الأمر

145
00:10:30,790 --> 00:10:33,670
.حسنًا، سأخرج لبعض الوقت

146
00:10:35,420 --> 00:10:36,830
.لا داعي للقلق

147
00:10:36,830 --> 00:10:38,720
.لن أبتعد كثيرًا

148
00:10:47,590 --> 00:10:48,910
.أحضرت أجركم

149
00:10:55,670 --> 00:10:56,860
...العقد

150
00:10:56,860 --> 00:10:58,360
...حسب عقدنا

151
00:10:58,360 --> 00:10:59,320
.لحم

152
00:10:59,320 --> 00:11:02,630
.جيّد

153
00:11:04,850 --> 00:11:08,480
.يا إلهي، لا أصدّق أنّك فكّرت في القيام بذلك

154
00:11:08,740 --> 00:11:12,990
.شكرًا على مساعدتي في تحضير الخرفان

155
00:11:13,300 --> 00:11:14,610
.وعلى مرافقتي

156
00:11:14,850 --> 00:11:19,610
.كان لديّ الأجر ومسموح لي بالمرور

157
00:11:20,050 --> 00:11:22,580
من أين حصلت على تلك الخرفان؟

158
00:11:22,580 --> 00:11:28,440
.تكون القرابين من الحيوانات عادة خرفانًا أو ماعزًا أو دجاجًا

159
00:11:28,870 --> 00:11:33,090
هناك العديد من الأشخاص
.الّذين يعملون في هذا المجال

160
00:11:33,440 --> 00:11:35,120
.فهمت

161
00:11:39,360 --> 00:11:41,590
.تبدين محبطة

162
00:11:41,590 --> 00:11:44,930
.كانت تلك هي الغاية من تربيتها

163
00:11:44,930 --> 00:11:46,340
.لا داعي للقلق

164
00:11:47,870 --> 00:11:49,380
.أنا آسفة

165
00:11:49,730 --> 00:11:54,110
أنا منزعجة فقط من حقيقة
.أنّني لم أستطع الدّفع لهم بنفسي

166
00:11:56,820 --> 00:12:00,540
.إنّك متشبّثة بهذه الأخلاق الفضيلة
.أو ربّما أنت غبيّة فحسب

167
00:12:02,100 --> 00:12:05,020
،من قد يتكبّد عناء الدّفاع عن شخص لا يعرفه

168
00:12:05,020 --> 00:12:07,540
وخاصّة إن كان ذلك الشّخص يسعى خلف حياتك؟

169
00:12:07,960 --> 00:12:12,200
إنّك لا تفكّرين في الأمور مليًّا، صحيح؟
.تتوقّعين أن تنجح الأمور فحسب

170
00:12:12,850 --> 00:12:15,110
.لا يمكنني مجادلتك في ذلك

171
00:12:16,610 --> 00:12:18,930
.الأمور صعبة على رجلك بالتّأكيد

172
00:12:20,350 --> 00:12:23,380
ماذا كنتِ لتفعلي لو لم يقبلوا بالخرفان؟

173
00:12:23,890 --> 00:12:26,540
هل كنتِ لتخطفي أحدًا من من الشّارع؟

174
00:12:26,540 --> 00:12:29,510
أم أنّك ما كنتِ لتمانعي لو أكلوك أنت؟

175
00:12:30,690 --> 00:12:32,130
...ذلك

176
00:12:32,130 --> 00:12:35,530
.إنّك تتعاملين مع كائنات من ذلك النّوع

177
00:12:36,110 --> 00:12:41,530
هناك العديد من النّاس الّذين خلفوا
.وعودهم وقُتلوا أو فقدوا عقولهم

178
00:12:41,530 --> 00:12:45,710
.العالم بأسره ظالم بما يكفي كما هو

179
00:12:45,710 --> 00:12:49,110
ما الغاية من القيام برهانات سيّئة؟

180
00:12:53,530 --> 00:12:57,200
.واثقة أنّني أريد أن أعيش

181
00:12:58,080 --> 00:13:02,060
.لكنّي لا أنفكّ أتصرّف بتسرّع

182
00:13:03,650 --> 00:13:08,040
كيف يمكنني تعلّم التّفكير في نفسي
عندما أقوم بأمور كهذه؟

183
00:13:08,470 --> 00:13:09,430
.الصّبر

184
00:13:10,760 --> 00:13:12,180
...الصّبر

185
00:13:12,180 --> 00:13:14,230
.راقبي بحذر شديد

186
00:13:14,230 --> 00:13:15,740
.لا تتسرّعي

187
00:13:15,740 --> 00:13:18,870
.حتّى الذّئاب لها أدوارها في قطعانها

188
00:13:18,870 --> 00:13:21,940
.راقبي لرؤية من عليه القيام بماذا

189
00:13:22,470 --> 00:13:27,300
لكن عندما أكون في وضع
...يُحتّم عليّ التّصرّف

190
00:13:27,300 --> 00:13:28,620
.اسمعي

191
00:13:29,070 --> 00:13:32,840
هل أنت توّاقة لحماية الآخرين بالفعل؟

192
00:13:32,840 --> 00:13:36,070
أم أنّك تتصرّفين بطمع وتحاولين أن تكوني مهمّة؟

193
00:13:37,310 --> 00:13:39,120
أنا؟ طمّاعة؟

194
00:13:39,410 --> 00:13:43,780
،إن كنت تريدين إنقاذ الجميع
.فذلك متوقّف عليك

195
00:13:44,400 --> 00:13:46,080
،لكن تذكّري إنّك إن تعرّضت للأذى

196
00:13:46,080 --> 00:13:49,690
.فهنالك من سيشعر بذلك الألم بقدر شعورك به

197
00:13:50,050 --> 00:13:54,400
إضافة لذلك، لستِ الوحيدة
.الّتي قد يأخذون حصّتهم منها

198
00:13:54,400 --> 00:13:56,830
.سواء كانت الكلاب أو هذا العالم بأسره

199
00:13:57,570 --> 00:14:00,590
ماذا لو لم تكوني كافية لهم؟

200
00:14:01,010 --> 00:14:02,720
ماذا إن أخذوا أصدقاءك؟

201
00:14:02,720 --> 00:14:03,360
...لن أسمح

202
00:14:03,360 --> 00:14:06,900
.تعرفين ما علي كفعله للحرص ألاّ يحدث ذلك

203
00:14:07,550 --> 00:14:10,780
.أنا لستُ صديقك ولا وصيًّا عليك

204
00:14:10,780 --> 00:14:12,570
.لن أخبرك ماذا تفعلين

205
00:14:13,690 --> 00:14:15,880
.سأفكّر في ذلك

206
00:14:21,840 --> 00:14:23,730
.أشرقت الشّمس

207
00:14:25,360 --> 00:14:27,540
!خدعة أم حلوى

208
00:14:27,540 --> 00:14:29,830
!توقّف أيّها الغبيّ! لقد تبلّلت

209
00:14:29,830 --> 00:14:33,460
!حلوى أم لا، ما زلت أضايقك

210
00:14:33,460 --> 00:14:35,520
!خدعة أم حلوى

211
00:14:35,520 --> 00:14:36,910
.تفضّلوا حلوى

212
00:14:37,540 --> 00:14:39,320
.شكرًا لك

213
00:14:40,140 --> 00:14:42,750
هذه هي كلّ الزّينة الّتي لدينا؟

214
00:14:42,750 --> 00:14:44,180
.للأسف

215
00:14:44,180 --> 00:14:46,490
.أعتقد أنّ الحلوى هي الجزء الأهمّ

216
00:14:46,490 --> 00:14:47,570
...ولكن بصراحة

217
00:14:47,900 --> 00:14:51,430
...لا أصدّق أنّني سأوزّع حلوى معك أنت

218
00:14:51,790 --> 00:14:53,030
ماذا تتوقّع؟

219
00:14:53,860 --> 00:14:56,540
.المدرّسون مشغولون كثيرًا الآن

220
00:14:57,240 --> 00:14:59,150
...لصّ ذلك الكتاب

221
00:14:59,570 --> 00:15:01,090
...الهجمات

222
00:15:01,720 --> 00:15:05,550
.وإمكانيّة وجود الجاني في الكلّيّة

223
00:15:05,880 --> 00:15:08,660
.أعلم أنّ الأمور فوضويّة

224
00:15:08,660 --> 00:15:13,100
،ولكن في نفس الوقت
.سيكون من المريب إن ألغينا الحدث

225
00:15:13,970 --> 00:15:18,630
.أعتقد أنّه واحد من القابعين تحت الأرض

226
00:15:19,020 --> 00:15:21,230
القابعون تحت الأرض؟ تعني برج النّفايات؟

227
00:15:21,450 --> 00:15:23,800
.أعتقد أنّ ذلك سيكون منطقيًّا

228
00:15:24,220 --> 00:15:27,940
لماذا توزّع الحلوى إن كنت تعرف كلّ هذا؟

229
00:15:27,940 --> 00:15:32,280
.بصراحة، أنا لستُ مهتمًّا بهذه الحادثة بشكل خاصّ

230
00:15:32,280 --> 00:15:37,410
لذلك عليّ على الأقلّ أن أدع
الأطفال يستمتعون، صحيح؟

231
00:15:37,410 --> 00:15:39,040
.نعم

232
00:15:39,510 --> 00:15:41,740
...حسنًا، سأغادر الآن

233
00:15:42,370 --> 00:15:43,460
.يا تريستان

234
00:15:45,890 --> 00:15:48,310
.أخبرتك ألاّ تناديني بذلك الاسم

235
00:15:48,810 --> 00:15:49,890
.سأصفعك

236
00:15:50,980 --> 00:15:52,330
.أمزح معك فحسب

237
00:15:53,540 --> 00:15:54,730
.يا إلهي

238
00:16:00,500 --> 00:16:01,800
!خذ

239
00:16:05,000 --> 00:16:06,670
.اليوم هو عيد الهالوين

240
00:16:06,670 --> 00:16:07,400
!كلاّ

241
00:16:10,730 --> 00:16:12,040
!هيّا، هيّا

242
00:16:14,190 --> 00:16:15,780
!انتبه لطريقك

243
00:16:15,780 --> 00:16:17,320
.مهلاً، إنّها أكبر منّا

244
00:16:17,710 --> 00:16:19,640
.آ-آسف

245
00:16:24,020 --> 00:16:25,170
...اسمع

246
00:16:25,170 --> 00:16:25,970
!حاضر

247
00:16:26,580 --> 00:16:29,600
هل يمكنك إعارتي ذلك عندما تنتهي منه؟

248
00:16:31,740 --> 00:16:33,590
!اتركني

249
00:16:33,590 --> 00:16:35,070
!كلاّ

250
00:16:36,350 --> 00:16:38,100
...عفوًا

251
00:16:38,100 --> 00:16:41,170
!ابتعد عنّي بسرعة

252
00:16:41,170 --> 00:16:43,460
!قد تفقدين وعيك ثانية

253
00:16:43,460 --> 00:16:45,080
!عودي للفراش

254
00:16:45,080 --> 00:16:46,890
ماذا يحدث هنا؟

255
00:16:47,230 --> 00:16:49,690
!لديّ عمل في الهالوين

256
00:16:50,660 --> 00:16:54,290
لا يجدر بك الذّهاب لأيّ مكان
!إن كنت تعلمين أنّك ستفقدين وعيك

257
00:16:54,500 --> 00:16:57,600
!لهذا السّبب سأذهب قبل أن أفقد وعيي

258
00:16:57,600 --> 00:16:59,900
.لا تتركيها يا تشيسي

259
00:16:59,900 --> 00:17:00,740
.نعم

260
00:17:01,260 --> 00:17:06,000
أهذا ما يشعر به الآخرون عندما يوقفونني
أو يغضبون منّي لتصرّفي بتهوّر؟

261
00:17:06,380 --> 00:17:08,040
!اتركيني

262
00:17:08,480 --> 00:17:10,590
!أحتاج للمال من أجل دراستي

263
00:17:10,990 --> 00:17:13,840
ألا يدفع السّيّد سِث التّكاليف؟

264
00:17:14,930 --> 00:17:17,350
.لا أريد أنفاق ذلك المال

265
00:17:17,810 --> 00:17:20,570
.سيستعمله كعذر ليملي عليّ ما يريد فحسب

266
00:17:21,860 --> 00:17:24,190
.لا يجب عليك الخروج في كلّ الأحوال

267
00:17:24,190 --> 00:17:25,520
.عودي للفراش

268
00:17:25,520 --> 00:17:26,670
!كلاّ

269
00:17:27,470 --> 00:17:29,400
ما هذه الجلبة؟

270
00:17:29,400 --> 00:17:31,410
...أتينا لنرى كيف حالك، لكن

271
00:17:32,250 --> 00:17:34,280
.أنت تؤلمينني يا تشيسي

272
00:17:34,280 --> 00:17:35,440
...أنا آسفة

273
00:17:35,850 --> 00:17:38,910
.تصرّ لوسي على الذّهاب لبرج النّفايات

274
00:17:38,910 --> 00:17:40,790
برج النّفايات؟

275
00:17:40,790 --> 00:17:42,430
ما هو ذلك المكان؟

276
00:17:42,430 --> 00:17:45,420
.إنّه واحد من الأبراج المكوّنة للكلّيّة

277
00:17:45,420 --> 00:17:47,910
.لا يتسنّى للتّلاميذ الذّهاب إلى هناك كثيرًا

278
00:17:48,620 --> 00:17:51,600
تقول الشّائعات أنّهم يبقون نتائج

279
00:17:51,600 --> 00:17:55,290
الشّعوذة الفاشلة وأشياء أخرى
.لا يمكنهم التّخلّص منها

280
00:17:55,820 --> 00:17:59,450
بالإمكان أيضًا العثور على خامّ نادر
.وأعشاب طبّيّة

281
00:17:59,450 --> 00:18:02,470
...ويُمكن الحصول على مال إذا ما جمعتها

282
00:18:02,470 --> 00:18:04,550
.لكن لم أعتقد أنّك قد تعملين هناك

283
00:18:05,280 --> 00:18:08,090
واثقة أنّ ذلك صادم بالنّسبة لفتى
.صغير مطيع مثلك

284
00:18:08,570 --> 00:18:11,810
على أيّ حال، سبق ووافقت على
.القيام بذلك هذه السّنة أيضًا

285
00:18:12,470 --> 00:18:14,570
.سيكون هنالك مدرّس برفقتي

286
00:18:14,570 --> 00:18:15,210
—سأكون

287
00:18:15,210 --> 00:18:15,900
!كلاّ

288
00:18:15,900 --> 00:18:18,380
...إن كان عليك الذّهاب

289
00:18:15,900 --> 00:18:18,380
...لا أعرف ما تحتاجين له، ولكن

290
00:18:18,380 --> 00:18:20,810
.سأذهب بدلاً عنك

291
00:18:21,500 --> 00:18:22,340
ماذا؟

292
00:18:35,580 --> 00:18:36,920
!مرحبًا

293
00:18:37,980 --> 00:18:39,450
.لا أحد هنا

294
00:18:41,140 --> 00:18:42,270
.ما باليد حيلة

295
00:18:42,270 --> 00:18:44,390
.يمكننا إعلامهم لاحقًا

296
00:18:44,390 --> 00:18:46,180
.لنذهب

297
00:18:46,180 --> 00:18:46,920
.حسنًا

298
00:18:47,680 --> 00:18:50,180
.أقدّر فعلاً مجيئك إلى هنا

299
00:18:50,890 --> 00:18:54,800
.هناك تلاميذ مؤهلّون أقل كلّ سنة

300
00:18:56,300 --> 00:18:57,620
.مرحبًا

301
00:18:58,520 --> 00:19:01,210
هل هذا هو المدخل لبرج النّفايات؟

302
00:19:02,440 --> 00:19:03,590
.فيلوميلا

303
00:19:04,120 --> 00:19:05,070
.تشيسي

304
00:19:05,730 --> 00:19:06,950
...وأنت

305
00:19:07,820 --> 00:19:09,180
...عفوًا

306
00:19:09,180 --> 00:19:12,870
كان يفترض بلوسي وبستر المجيء
.إلى هنا لدرس التّجميع التّطبيقيّ

307
00:19:12,870 --> 00:19:17,490
.لن تستطيع المجيء، لذلك أتينا بدلاً منها

308
00:19:17,490 --> 00:19:18,850
...درس تطبيقيّ

309
00:19:19,800 --> 00:19:21,200
.فهمت

310
00:19:21,200 --> 00:19:22,320
.واثق أنّها ممتنّة

311
00:19:23,400 --> 00:19:25,970
هل أخبرتكم وبستر ما الّذي ستجمعونه؟

312
00:19:25,970 --> 00:19:26,780
.لا

313
00:19:27,260 --> 00:19:29,270
.سأشرح لكم في الطّريق إذًا

314
00:19:30,700 --> 00:19:32,280
.أنا فابيو

315
00:19:32,650 --> 00:19:34,220
.فابيو زاكّروني

316
00:19:34,880 --> 00:19:35,970
.شكرًا على المساعدة

317
00:19:42,340 --> 00:19:45,310
.لا داعي لتُظهري انزعاجك هكذا

318
00:19:45,310 --> 00:19:47,190
.لا أحبّ حراستك هكذا أيضًا

319
00:19:47,500 --> 00:19:50,070
.كان عليك الذّهاب مع تشيسي إذًا

320
00:19:50,320 --> 00:19:53,740
.أخبرتني أن أراقبك لكي لا تتسلّلي خارجًا

321
00:20:00,260 --> 00:20:03,330
.لا تقومي رجاءً بأيّ شيء متهوّر مثل تشيسي

322
00:20:04,090 --> 00:20:09,920
ما عدتُ أملك أحشاءً الآن، لكن
.لكنّ أخاك لديه معدة قد تؤلمه

323
00:20:10,320 --> 00:20:12,350
.هذا ليس تهوّرًا

324
00:20:12,940 --> 00:20:14,130
...أنا

325
00:20:14,130 --> 00:20:15,080
.لوسي

326
00:20:15,740 --> 00:20:17,390
.أستاذة فاخمان

327
00:20:17,390 --> 00:20:19,440
.سمعتُ أنّك مريضة

328
00:20:19,900 --> 00:20:21,430
هل تشعرين بتحسّن؟

329
00:20:21,430 --> 00:20:23,680
.نعم. أنا آسفة

330
00:20:23,680 --> 00:20:26,050
أعلم أنّني تقدّمت للمشاركة
...في درس التّجميع التّطبيقيّ

331
00:20:26,930 --> 00:20:28,670
.المكان خطير هناك

332
00:20:28,670 --> 00:20:31,620
.سأجد لك مهمة تجميع أخرى عندما تتحسّني

333
00:20:32,560 --> 00:20:35,030
.يمكنني تولّي أمر هذه وحدي

334
00:20:36,380 --> 00:20:38,870
هل قابلتِ زملائي؟

335
00:20:44,700 --> 00:20:46,730
هل تعملين هنا أيضًا يا فيلوميلا؟

336
00:20:47,210 --> 00:20:48,840
.أنا أساعد فحسب

337
00:20:48,840 --> 00:20:49,680
دائمًا؟

338
00:20:50,580 --> 00:20:51,920
.أحيانًا

339
00:20:52,630 --> 00:20:53,450
...تشيسي

340
00:20:54,210 --> 00:20:56,100
.انتبهي من ذلك الرّجل

341
00:20:57,490 --> 00:20:59,270
...حسنًا أيّها التّلاميذ

342
00:20:59,950 --> 00:21:01,350
.تماسكوا

343
00:21:01,950 --> 00:21:05,070
.النّباتات والحيوانات الّتي انقرضت وأضعناها في الماضي

344
00:21:05,510 --> 00:21:09,200
.المعادن النّفيسة الّتي تأثير الأفئدة

345
00:21:09,940 --> 00:21:13,250
أولئك الّذين تمّ التّخلّي عنهم
،ولكن لا يُسمح لهم حتّى بالتّلاشي

346
00:21:13,860 --> 00:21:16,780
...وحتّى أولئك الّذين سلبت قلوبهم

347
00:21:17,220 --> 00:21:20,210
.قد يكون هذا المكان غامرًا، فاحذروا

348
00:21:32,550 --> 00:21:34,590
.مرحبًا أيّتها الأمّ

349
00:21:35,800 --> 00:21:39,230
.تنهال عليّ المشاكل الواحدة تلو الأخرى

350
00:21:39,670 --> 00:21:42,050
اخبريني، ماذا أفعل؟

351
00:21:42,540 --> 00:21:44,690
من أين أبدأ؟

352
00:21:45,910 --> 00:21:49,800
.هذا لا يعني أنّني لا أستمتع بوقتي

353
00:21:49,800 --> 00:21:52,710
.كلّما زادت المشاكل، كان ذلك أفضل

354
00:21:53,050 --> 00:21:55,430
.فهذا هو عملي قبل كلّ شيء

355
00:21:55,920 --> 00:21:58,580
.وكلّما حللت مشاكل أكثر، صارت سمعتي أفضل

356
00:22:01,880 --> 00:22:03,710
.أنت فظيعة

357
00:22:04,490 --> 00:22:08,690
.أفترض أنّ عليّ البدء بهذه الرّسائل

358
00:22:19,970 --> 00:22:24,030
.أرى أنّ فيلوميلا سيرجنت ستنسحب من الكلّيّة