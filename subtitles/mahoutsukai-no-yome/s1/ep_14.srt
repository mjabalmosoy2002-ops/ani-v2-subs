1
00:01:45,200 --> 00:01:47,710
.والآن، اذهبي

2
00:01:48,170 --> 00:01:51,000
.لديك القوّة لذلك الآن

3
00:01:51,630 --> 00:01:58,380
آخر مكان تقفين فيه سيكون المكان
.الّذي تنتمين إليه من الآن

4
00:02:01,100 --> 00:02:02,010
!تشيسي

5
00:02:02,720 --> 00:02:04,060
أتحاول إغاظتي؟

6
00:02:04,470 --> 00:02:08,560
هل تمقت البشر إلى هذه الدّرجة لتقييدهم لك؟

7
00:02:09,020 --> 00:02:13,820
.ستعود إن تاقت للعودة إلى المنزل

8
00:02:14,440 --> 00:02:20,320
وأيضًا، قد يكون من الأفضل أن
.تبقيها معك بهيئة غير بشريّة

9
00:02:21,120 --> 00:02:27,000
.حياة البشر أكثر هشاشة من فاشل ولد في الغابة

10
00:02:27,750 --> 00:02:31,080
.جميعكم تتجنّبونني قائلين أنّ هذا ما أنا عليه

11
00:02:31,630 --> 00:02:35,380
.ولكنّي أكره البرد

12
00:02:38,420 --> 00:02:43,430
.يا للظّرافة

13
00:02:54,190 --> 00:02:56,570
.هذا جميل وممتع للغاية

14
00:02:59,990 --> 00:03:02,490
...أنا

15
00:03:02,910 --> 00:03:04,240
ماذا كنت؟

16
00:03:06,660 --> 00:03:07,700
...تشيسي

17
00:03:08,450 --> 00:03:11,580
.يبدو وكأنّ أحدهم يصرخ بجانب أذني

18
00:03:13,130 --> 00:03:14,540
إلى أيّ مدى عليّ أن أذهب؟

19
00:03:15,420 --> 00:03:17,550
.أشعر أنّ بإمكاني التّقدّم إلى الأبد

20
00:03:26,760 --> 00:03:28,770
.إلى مكانٍ لا يوجد فيه أحد

21
00:03:29,180 --> 00:03:31,190
هل ستغادرين؟

22
00:03:31,810 --> 00:03:32,900
.نعم

23
00:03:32,900 --> 00:03:34,650
.إنّني أُنادى

24
00:03:35,150 --> 00:03:36,230
إلى أين؟

25
00:03:36,230 --> 00:03:37,320
.هناك

26
00:03:38,190 --> 00:03:39,530
أهذا ما تريدينه؟

27
00:03:39,940 --> 00:03:41,200
.هذا ما أريده

28
00:03:42,160 --> 00:03:45,160
.إن كان هذا ما تريدينه، فسأذهب معك

29
00:03:45,660 --> 00:03:49,500
ولكن ألم يبقَ لديك شيء هناك؟

30
00:03:51,290 --> 00:03:52,330
هناك؟

31
00:03:52,710 --> 00:03:55,250
أنا... ماذا كنت؟

32
00:03:55,790 --> 00:03:56,250
.تشيسي

33
00:03:58,300 --> 00:04:02,720
.تشيسي، هنالك الكثير ممّا لا أعرفه بعد

34
00:04:07,970 --> 00:04:11,140
.سأضطرب إلّم تكوني معي

35
00:04:13,020 --> 00:04:14,850
حقًّا؟

36
00:04:14,850 --> 00:04:16,650
.نعم، سيجعلني ذلك أضطرب

37
00:04:19,690 --> 00:04:22,200
.المكان بارد وموحش من دونك

38
00:04:30,660 --> 00:04:34,120
.أنا أيضًا أكره البرد

39
00:04:34,960 --> 00:04:37,710
.لذا سأرجع إلى المنزل

40
00:04:42,550 --> 00:04:46,140
.ما زلت أشعر أنّ هناك ضباب في دماغي

41
00:04:46,510 --> 00:04:48,600
.إنّها لعنة من نوع ما

42
00:04:49,560 --> 00:04:50,720
لعنة؟

43
00:04:50,720 --> 00:04:53,730
.يحوّل هذا الجلد مرتديه إلى متحوّل

44
00:04:54,230 --> 00:04:56,940
.ولكنّ هذا الجلد لثعلب

45
00:04:57,560 --> 00:05:01,480
.جلد المتحوّل يحقّق أمنيات الشّخص

46
00:05:02,030 --> 00:05:04,240
.ترك لي شيئًا فظيعًا

47
00:05:04,240 --> 00:05:06,780
.أخبريني حين تريدين استعماله

48
00:05:06,780 --> 00:05:09,330
.كان ذلك خبيثًا منه

49
00:05:09,330 --> 00:05:10,540
.وقد رحل أيضًا

50
00:05:10,950 --> 00:05:12,250
.لا أريد استعماله

51
00:05:20,840 --> 00:05:24,170
ماذا لو ذهبت إلى الجانب الآخر؟

52
00:05:24,720 --> 00:05:27,260
.سأوقفك إلّم يكن ذلك ما تريدينه

53
00:05:27,260 --> 00:05:29,850
.أوقفني حتّى وإن أردت ذلك

54
00:05:30,970 --> 00:05:31,970
.تصبح على خير

55
00:05:32,430 --> 00:05:33,720
.تصبحين على خير

56
00:05:36,770 --> 00:05:37,690
!تشيسي

57
00:05:38,190 --> 00:05:40,690
!أنقذي جويل

58
00:05:44,030 --> 00:05:44,780
.تشيسي

59
00:05:51,950 --> 00:05:54,750
.لم يستيقظ طوال اليوم

60
00:05:55,580 --> 00:05:58,420
.لا يمكنني فعل شيء له

61
00:05:59,580 --> 00:06:00,840
!اركبي يا تشيسي

62
00:06:01,380 --> 00:06:02,130
...ولكن

63
00:06:02,130 --> 00:06:03,420
!لا بأس

64
00:06:17,310 --> 00:06:19,400
.أنت قفلٌ جيّد، قفل قديم

65
00:06:19,980 --> 00:06:22,270
.أنا زيتك الجيّد

66
00:06:22,270 --> 00:06:24,900
.أنا مفتاحك الذّهبيّ

67
00:06:27,610 --> 00:06:28,650
!سيّد جويل

68
00:06:29,910 --> 00:06:31,070
سيّد جويل؟

69
00:06:31,200 --> 00:06:32,330
!سيّد جويل

70
00:06:38,620 --> 00:06:39,290
...تشيسي

71
00:06:41,000 --> 00:06:43,210
.لهذا خرجتِ مسرعة فجأة

72
00:06:43,750 --> 00:06:44,800
.إلياس

73
00:06:47,420 --> 00:06:49,050
ما خطب هذا الرّجل؟

74
00:06:49,510 --> 00:06:50,800
.إنّه على شفير الموت

75
00:06:53,890 --> 00:06:55,310
.ليانان شي

76
00:06:55,850 --> 00:06:57,980
ما الخطب؟ ألن تأكليه؟

77
00:06:58,430 --> 00:07:00,060
إنّه فريستك، أليس كذلك؟

78
00:07:00,060 --> 00:07:01,900
.لـ-لا

79
00:07:01,900 --> 00:07:04,150
!لن آكله

80
00:07:04,150 --> 00:07:05,520
!ولا نقطة دم واحدة

81
00:07:05,520 --> 00:07:07,150
!ولا جزءًا من حياته

82
00:07:07,150 --> 00:07:09,450
...يُختم مصير المرء

83
00:07:10,860 --> 00:07:13,740
بمجرّد أن يلاحقهم مصاص دماء، أليس كذلك؟

84
00:07:14,780 --> 00:07:15,700
...كلاّ

85
00:07:16,240 --> 00:07:17,160
!كلاّ

86
00:07:17,790 --> 00:07:19,120
.لستُ ألاحقه

87
00:07:23,630 --> 00:07:24,960
.عليّ الابتعاد

88
00:07:25,380 --> 00:07:28,590
...إن ابتعدت كثيرًا، فقد

89
00:07:28,590 --> 00:07:29,510
.لا فائدة

90
00:07:30,930 --> 00:07:33,640
.وضعتِ يدك عليه بالفعل

91
00:07:33,640 --> 00:07:34,890
...إلياس

92
00:07:36,060 --> 00:07:38,600
...مهما ابتعدت، فإنّ

93
00:07:38,600 --> 00:07:39,480
!إلياس

94
00:07:41,810 --> 00:07:43,060
.أنا آسفة

95
00:07:43,850 --> 00:07:46,110
هل يمكنك الاعتناء بالسّيّد جويل؟

96
00:07:47,480 --> 00:07:48,360
.نعم

97
00:07:52,780 --> 00:07:54,030
.لا أحبّه

98
00:07:54,950 --> 00:07:55,870
.لا

99
00:07:57,620 --> 00:08:01,000
.لا أحبّ ذلك الرّجل

100
00:08:03,080 --> 00:08:06,090
.لا

101
00:08:08,420 --> 00:08:09,920
!لا أحبّه

102
00:08:10,920 --> 00:08:18,970
.سيكون علينا إكمال ذلك الحبّ إن كنت أحببته

103
00:08:34,610 --> 00:08:35,780
...اللّيل

104
00:08:36,200 --> 00:08:37,780
كيف حالك؟

105
00:08:44,830 --> 00:08:48,920
هل أنت حاصد الأرواح أو شيء من ذاك القبيل؟

106
00:08:48,920 --> 00:08:51,010
.شيءٌ مشابه

107
00:08:51,010 --> 00:08:53,170
.شكرًا لرعايتك لفتاتي

108
00:08:54,550 --> 00:08:56,390
.اسمها هو تشيسي

109
00:08:59,720 --> 00:09:01,770
.كانت فتاة جيّدة

110
00:09:05,730 --> 00:09:08,310
.لم يتبقَّ لديك الكثير من الوقت

111
00:09:08,730 --> 00:09:11,440
.ليس شيئًا يمكن معالجته في المستشفى

112
00:09:17,360 --> 00:09:24,620
هل يمكنني سؤالك كم من الوقت
لديّ يا حاصد الأرواح اللّطيف؟

113
00:09:25,000 --> 00:09:26,670
.أسبوع بأقصى تقدير

114
00:09:27,000 --> 00:09:28,670
هل سأعاني؟

115
00:09:28,670 --> 00:09:29,920
.هذا غير محتمل

116
00:09:30,670 --> 00:09:34,510
.هذا جيّد إذًا

117
00:09:35,090 --> 00:09:37,510
.كانت حياة جيّدة

118
00:09:39,300 --> 00:09:42,220
ألستَ خائفًا؟

119
00:09:43,020 --> 00:09:45,430
.أنا كذلك بالطّبع

120
00:09:45,430 --> 00:09:47,900
.الجميع يخاف الموت

121
00:09:48,520 --> 00:09:51,730
.ولكنّه ليس شيئًا يمكنني الهرب منه

122
00:09:54,030 --> 00:09:57,700
.ماتت زوجتي صغيرة

123
00:09:58,450 --> 00:10:01,200
.عرّفَنا آباؤنا على بعضنا

124
00:10:01,200 --> 00:10:05,450
.لم نتزوّج عن حبّ، ولكنّي حزنت مع ذلك

125
00:10:06,790 --> 00:10:12,500
ولكنّ حديقة الورود الّتي تركتها
.زوجتي أنقذتني من يأسي

126
00:10:13,670 --> 00:10:16,840
،لا بدّ وأنّه لم يكن إلاّ وهم منتصف الصّيف

127
00:10:16,840 --> 00:10:20,510
.ولكنّي قابلت امرأة جميلة هناك أيضًا

128
00:10:21,350 --> 00:10:23,470
.أنا راضٍ

129
00:10:25,770 --> 00:10:33,480
مع ذلك، إن كان بإمكاني مقابلة تلك المرأة
...ذات العينان الحمراوتان كعنب الثّعلب

130
00:10:34,320 --> 00:10:35,820
.إنّني أطلب الكثير

131
00:10:46,700 --> 00:10:48,620
مرهم جنّيّات؟

132
00:10:49,000 --> 00:10:50,620
هل يمكنني صنعه؟

133
00:10:51,210 --> 00:10:52,130
لماذا؟

134
00:10:52,540 --> 00:10:55,300
.يمكننا دعكه على جفنيه

135
00:10:55,800 --> 00:10:59,630
سيمكّن ذلك شخصًا عاديًّا مثل
.السّيّد جويل من أن يراها

136
00:11:00,180 --> 00:11:04,310
.ذلك لا يفترض أن يستخدم على البشر

137
00:11:04,850 --> 00:11:08,600
.سيغضب الأليفون غضبًا شديدًا إن عرفوا

138
00:11:09,600 --> 00:11:13,900
.ولكنّي أريده أن يلقي ولو لمحة واحدة

139
00:11:14,820 --> 00:11:17,570
.أن يتشاركا ولو كلمة واحدة

140
00:11:19,320 --> 00:11:20,150
.لا

141
00:11:20,990 --> 00:11:23,780
.هو ما أريد قوله، ولكن لا بأس

142
00:11:25,700 --> 00:11:28,120
.لم تطلبي شيئًا من قبل

143
00:11:28,700 --> 00:11:31,210
.ولكن لا تتهوّري

144
00:11:31,210 --> 00:11:31,830
مفهوم؟

145
00:11:33,000 --> 00:11:33,960
.نعم

146
00:11:38,920 --> 00:11:40,880
كيف حدث ذلك؟

147
00:11:40,880 --> 00:11:42,590
.لماذا يا ترى

148
00:11:43,550 --> 00:11:46,680
.ينبغي عليك الإمساك بها بهذه الحالة

149
00:11:47,060 --> 00:11:49,220
.لا يمكنني مساعدتك هذه المرّة

150
00:11:49,600 --> 00:11:52,650
.آسف، أنا أيضًا لا يمكنني مساعدتك

151
00:11:52,650 --> 00:11:53,520
.لا بأس

152
00:11:54,150 --> 00:11:59,320
.الجنّيّات تكره أن يتمّ رؤيتها، حتّى الأليفين

153
00:12:00,990 --> 00:12:06,280
هل تعتقد أنّ بإمكاني فعلها لوحدي؟

154
00:12:06,280 --> 00:12:11,750
.أفضّل ألاّ تفعلي، خصوصًا مع جسدك الضّعيف

155
00:12:14,420 --> 00:12:16,710
.ولكنّي أريد فعلها

156
00:12:17,880 --> 00:12:19,170
.هذه المرّة فقط

157
00:12:24,720 --> 00:12:28,760
.أحدّق بشدّة عندما أستخدم السّحر

158
00:12:29,640 --> 00:12:34,270
.أتمكّن من رؤية الضّوء يرقص ويلعب حينها

159
00:12:36,310 --> 00:12:39,690
.هذا ما يطلق عليه القوّة السّحريّة

160
00:12:41,110 --> 00:12:43,780
.تأخذ ألوان نجوم اللّيل في حين

161
00:12:45,200 --> 00:12:51,500
.وفين حين آخر تكون زرقاء كالبحر أو خضراء كالغابة

162
00:12:52,200 --> 00:12:54,710
.تكون بيضاء كشمس الصّباح أحيانًا

163
00:12:56,250 --> 00:13:01,460
.تتشابك كالمهد مجتمعة

164
00:13:05,380 --> 00:13:06,430
.فعلتها

165
00:13:09,390 --> 00:13:11,890
.نعم، تبدو جيّدة

166
00:13:12,350 --> 00:13:16,150
.عليك الحفاظ عليها للأيّام الخمس القادمة الآن

167
00:13:16,440 --> 00:13:17,100
.حسنًا

168
00:13:17,600 --> 00:13:19,860
.لا تتهوّري حقًّا

169
00:13:19,860 --> 00:13:22,070
.أخبريني إن حدث شيء

170
00:13:22,070 --> 00:13:23,110
فهمتِ؟

171
00:13:23,110 --> 00:13:24,030
.نعم

172
00:13:28,660 --> 00:13:33,000
.أشعر وكأنّ شيئًا مهمًّا يغادر جسدي

173
00:13:35,210 --> 00:13:37,330
.أنا خائف

174
00:13:41,300 --> 00:13:44,550
أيوجد أحد هناك؟

175
00:13:51,680 --> 00:13:55,270
مع الورود الّتي تزهر في مياه الرّبيع

176
00:13:56,140 --> 00:14:01,230
من العملات الذّهبيّة القديمة
.المغمورة داخلها، يُصنع البخور

177
00:14:02,480 --> 00:14:08,030
يومٌ في البدر، وبعدها في كلّ
،اتّجاهات البوصلة الأربع

178
00:14:08,450 --> 00:14:11,030
.تُحمّم في ضوء القمر وضوء الشّمس

179
00:14:12,370 --> 00:14:16,710
.عليّ البقاء رفقة إناء الدّواء طوال الوقت

180
00:14:17,460 --> 00:14:19,250
.لا يمكنني السّماح لنفسي حتّى بالنّوم

181
00:14:20,290 --> 00:14:24,590
.ومع ذلك، هنالك احتماليّة 50-50 أنّها ستنجح

182
00:14:28,090 --> 00:14:30,340
لِمَ تفعلين كلّ هذا لأجلي؟

183
00:14:32,850 --> 00:14:36,810
هذا ما تفعلونه من أجل الآخرين، أليس كذلك؟

184
00:14:38,980 --> 00:14:47,280
كلّ ما في الأمر هو أنّي أريد للأشخاص
.الّذين ابتسموا لي أن يستمرّوا بالابتسام لي

185
00:14:52,530 --> 00:14:54,660
.البشر حمقى

186
00:14:56,750 --> 00:14:59,670
.وأنانيّون أيضًا

187
00:15:02,840 --> 00:15:06,090
كم يومًا مرّ الآن؟

188
00:15:06,800 --> 00:15:08,470
.إنّه اليوم الرّابع

189
00:15:10,720 --> 00:15:11,970
.بقي القليل

190
00:15:26,360 --> 00:15:28,400
.أشمّها

191
00:15:29,070 --> 00:15:30,360
.هنالك رائحة

192
00:15:30,740 --> 00:15:32,280
.رائحة سعادة

193
00:15:37,120 --> 00:15:39,910
.إنّهم يفعلون شيئًا ممتعًا

194
00:16:01,310 --> 00:16:03,150
.هذا سيّئ، لقد نمت

195
00:16:11,490 --> 00:16:12,700
.أحسنتِ العمل

196
00:16:13,160 --> 00:16:14,410
...إلياس

197
00:16:14,410 --> 00:16:16,410
.لا تقلقي، لقد نجحت

198
00:16:18,200 --> 00:16:19,330
.كان ذلك وشيكًا

199
00:16:26,880 --> 00:16:29,090
.يمكنك فعل ما تريدين بها

200
00:16:32,130 --> 00:16:34,760
.افعلي ما تريدين أن تفعليه

201
00:17:06,420 --> 00:17:08,040
هل أحلم؟

202
00:17:08,460 --> 00:17:10,880
.لم أتمكّن من النّهوض من الفراش حتّى قبل قليل

203
00:17:11,550 --> 00:17:14,050
.أشعر وكأنّي نمت لوقت طويل

204
00:17:27,190 --> 00:17:30,900
.قابلتك أخيرًا

205
00:17:34,440 --> 00:17:36,570
...أنت

206
00:17:37,070 --> 00:17:39,910
.هذا كلّه لأنّك وجدتني

207
00:17:43,540 --> 00:17:47,370
.لم أستطع أن أتركك

208
00:17:49,380 --> 00:17:50,750
.إنّه خطؤك

209
00:17:52,340 --> 00:17:53,260
.أنا آسف

210
00:17:53,920 --> 00:17:55,670
لماذا تعتذر؟

211
00:17:56,680 --> 00:17:58,300
!قلتَ أنّك خائف

212
00:17:58,300 --> 00:18:00,140
!أنت خائف من الوفاة وحيدًا

213
00:18:02,850 --> 00:18:04,890
.إنّه خطئي

214
00:18:07,730 --> 00:18:14,650
.شكرًا لك لحبّي، يا ليانان شي، مُحبّة الشّعراء

215
00:18:15,280 --> 00:18:17,240
.ليس وكأنّي لم أعرف أبدًا

216
00:18:17,950 --> 00:18:22,830
يمكنك أخذ حياتي، إن كانت هذه
.الحياة المزمنة كافية لك

217
00:18:22,830 --> 00:18:24,700
.يمكنك أخذها كلها

218
00:18:25,660 --> 00:18:30,750
.ولكن، ولكن... لم أفعل شيئًا سوى الأخذ منك

219
00:18:31,210 --> 00:18:32,880
.لم أعطك شيئًا أبدًا

220
00:18:33,840 --> 00:18:35,210
.بل أعطيتني

221
00:18:37,010 --> 00:18:43,010
.منذ أن توفّت زوجتي، لم تكن حياتي إلاّ همودًا

222
00:18:43,350 --> 00:18:44,720
،ولكن في يومٍ ما

223
00:18:46,560 --> 00:18:49,270
.تقابلت أعيننا للحظة واحدة

224
00:18:50,480 --> 00:18:53,190
.كانتا جميلتان، بغاية الجمال

225
00:18:53,570 --> 00:18:55,690
.أردت رؤيتك ثانيةً

226
00:18:56,400 --> 00:19:01,240
.هذا لوحده أزاح همود حياتي

227
00:19:17,170 --> 00:19:19,510
.يا لك من غبيّ

228
00:19:20,300 --> 00:19:24,300
.هذ يجعل تركي لك أصعب

229
00:19:30,100 --> 00:19:32,900
.لا أعلم أين سأذهب تاليًا

230
00:19:33,310 --> 00:19:37,320
ربّما سأتمكّن حتّى من أن أكون
.إلى جانب زوجتي

231
00:19:37,780 --> 00:19:42,740
.ولكنّي حتمًا، حتمًا سآتي إلى جانبك أيضًا

232
00:19:43,950 --> 00:19:45,990
،ما دمتُ لستُ وحيدًا

233
00:19:46,490 --> 00:19:51,960
،ما دام هنالك شخصٌ ينتظرني
.فإنّي لست خائفًا على الإطلاق

234
00:19:52,750 --> 00:19:58,130
.لذا أريدك أن تأخذي حياتي هذه

235
00:20:28,200 --> 00:20:31,250
.أيّها الغبيّ، لم أتمكّن حتّى من الرّدّ

236
00:20:31,710 --> 00:20:35,080
.أنتم البشر أغبياء حقًّا

237
00:20:35,080 --> 00:20:36,960
.أنانيّون للغاية

238
00:20:56,190 --> 00:20:58,650
.سأبقى هنا

239
00:20:59,820 --> 00:21:03,860
.سأنتظر عودة جويل حتّى نهاية العالم

240
00:21:08,530 --> 00:21:11,080
.شكرًا لك يا تشيسي

241
00:21:19,250 --> 00:21:20,460
هل تشعرين بالحزن؟

242
00:21:26,380 --> 00:21:27,340
.ربّما

243
00:21:27,930 --> 00:21:29,180
.أنتِ تبكين

244
00:21:29,180 --> 00:21:30,760
.لا أفهم

245
00:21:31,220 --> 00:21:33,890
ماذا تعتقد يا إلياس؟

246
00:21:34,810 --> 00:21:35,890
.لا أعلم

247
00:21:36,440 --> 00:21:42,400
.ولكنّ رؤيتك تبكين تجعلني مضطربًا قليلاً

248
00:21:43,990 --> 00:21:47,200
.آسفة لعدم تمكّني من أن أكون معلّمتك

249
00:21:47,570 --> 00:21:48,570
.لا بأس

250
00:21:49,660 --> 00:21:51,790
.عليك أخذ قسط من الرّاحة على الفراش

251
00:21:53,790 --> 00:21:54,790
!مفاجأة

252
00:21:54,790 --> 00:21:55,620
.مرحبًا

253
00:21:56,710 --> 00:21:58,000
.أوبيرون

254
00:21:58,000 --> 00:22:02,500
.صنعت بشريّة مرهم جفن سعادة جنّيّات

255
00:22:02,500 --> 00:22:07,130
.يُحظر أن يصنعه البشر

256
00:22:07,720 --> 00:22:10,600
آسف، ولكن هل يمكنني الحصول على الباقي؟

257
00:22:12,260 --> 00:22:13,100
.تفضّل

258
00:23:56,370 --> 00:23:59,500
.ثمن ارتكاب أحد المحرّمات كان كبيرًا للغاية

259
00:23:59,950 --> 00:24:02,420
،متقيّحة تمامًا من ظلال الموت

260
00:24:02,420 --> 00:24:04,750
تُقدّم للفتاة يد المساعدة من
...ملوك الجنّيّات، ولكن

261
00:24:05,540 --> 00:24:08,760
.يبدو أنّ هؤلاء الأطفال يصبحون أضعف شيئًا فشيئًا