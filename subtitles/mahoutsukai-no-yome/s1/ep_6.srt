1
00:01:42,620 --> 00:01:44,160
.يا للاستهتار

2
00:01:44,500 --> 00:01:48,540
ألا تهتمّ إن ماتت أو نجحت؟

3
00:01:49,130 --> 00:01:51,420
.لن تموت، ولا أنوي تركها تموت

4
00:01:51,880 --> 00:01:53,800
.كانت غالية في نهاية المطاف

5
00:01:54,920 --> 00:01:59,470
لا يمكنك أن تكون بشريًّا ولا أن تعود
.لأن تكون جنيّ أيّها المخلوق القذر

6
00:01:59,890 --> 00:02:03,260
أتعتقد أنّ فعلاً شنيعًا مثل شراء
بشريّ سيمرّ مرور الكرام؟

7
00:02:03,560 --> 00:02:07,850
يبدو أنّك ما تزال تؤمن بسيادة
.البشر كعادتك يا رينفريد

8
00:02:08,270 --> 00:02:11,060
لماذا تعرف بشأن تشيسي؟

9
00:02:11,060 --> 00:02:13,690
إنّك تكره المزادات، أليس كذلك؟

10
00:02:14,230 --> 00:02:16,900
.ذلك الحدث كان سرّيًّا للغاية

11
00:02:16,900 --> 00:02:19,950
.ما يحدث هناك يُحفظ سرًّا

12
00:02:20,450 --> 00:02:26,080
وأيضًا، ما منفعتك من كتلة الكراهية
والنّدم البشريّة هذه؟

13
00:02:29,080 --> 00:02:30,290
.فهمت

14
00:02:33,670 --> 00:02:36,670
من سلب يدك تلك؟

15
00:03:03,370 --> 00:03:05,330
.أحسنتِ يا تشيسي

16
00:03:06,450 --> 00:03:07,790
.إلياس

17
00:03:09,580 --> 00:03:10,830
ورود؟

18
00:03:11,790 --> 00:03:13,580
!إنّك بخير

19
00:03:14,340 --> 00:03:15,750
.كان ذلك ذكيًّا

20
00:03:15,750 --> 00:03:20,090
.تشيسي لا تدمّر فحسب مثلك

21
00:03:24,180 --> 00:03:25,850
.يبدو مرتاحًا

22
00:03:26,100 --> 00:03:27,430
.لنذهب يا أليس

23
00:03:27,430 --> 00:03:28,100
...سيّدي

24
00:03:28,100 --> 00:03:29,350
هل ستغادر؟

25
00:03:29,350 --> 00:03:32,020
.لم تخبرني شيئًا بعد

26
00:03:32,020 --> 00:03:34,400
.ذهب الفساد، لذا ليس لديّ عملٌ آخر هنا

27
00:03:34,400 --> 00:03:37,320
.لا يهمّني كيف تستغلّ الفتاة

28
00:03:37,320 --> 00:03:38,570
.كن حذرًا

29
00:03:38,940 --> 00:03:41,780
.هنالك الكثير من الأشخاص المهتمّين بها

30
00:03:48,740 --> 00:03:50,710
كان أحد معارفك؟

31
00:03:51,660 --> 00:03:54,750
.ذلك المشعوذ معروف بكرهه للسّحرة

32
00:03:55,330 --> 00:03:58,500
.لطالما كان يحبّ مقاتلتي

33
00:04:00,130 --> 00:04:03,430
.ولكن كان لديه يدان في آخر مرة رأيته فيها

34
00:04:08,890 --> 00:04:10,640
.هنالك شيء ما

35
00:04:15,940 --> 00:04:17,940
هل أنتِ بخير يا تشيسي؟

36
00:04:20,230 --> 00:04:21,530
.يمكنك النّوم

37
00:04:22,320 --> 00:04:23,700
.شكرًا لك

38
00:04:27,330 --> 00:04:28,490
...إلياس

39
00:04:30,870 --> 00:04:33,160
متى سأموت؟

40
00:04:41,550 --> 00:04:43,670
لم تنسي؟

41
00:04:48,550 --> 00:04:51,310
بعد ثلاث سنوات، ربّما، ما لم
.يتمّ فعل شيء حيال الأمر

42
00:04:54,140 --> 00:04:56,060
.فكّرت بطريقة لمنع ذلك

43
00:04:56,060 --> 00:04:57,810
.لا داعي لأن تقلقي

44
00:04:59,020 --> 00:05:01,400
لماذا لم تخبرني؟

45
00:05:02,240 --> 00:05:04,200
.لأنّه لم يكن هناك سبب لذلك

46
00:05:04,570 --> 00:05:08,240
.موتك ليس جزءًا من خططي

47
00:05:10,280 --> 00:05:13,910
تجربتك هي منعي من الموت إذًا؟

48
00:05:14,460 --> 00:05:15,620
.صحيح

49
00:05:16,290 --> 00:05:21,380
لأرى ما سيحدث إن كانت في جواري
.سلي بيغي، خزّان سحر لا منتهٍ

50
00:05:22,550 --> 00:05:26,720
ولكنّك لا تحتاج السّحر، أليس كذلك؟

51
00:05:27,300 --> 00:05:28,720
إذًا لماذا أنا؟

52
00:05:33,560 --> 00:05:38,310
.أنا هجين— لست بشريًّا ولا جنيًّا ولا روحًا

53
00:05:38,730 --> 00:05:43,730
،عشت لزمنٍ طويل جدًّا جدًّا
،ورأيت العديد من البشر

54
00:05:43,730 --> 00:05:50,530
.ولكنّي ما أزال لا أفهمهم، بما فيهم أنت

55
00:05:53,080 --> 00:05:55,080
،يمكنني فهم أفكاركم

56
00:05:55,450 --> 00:05:57,250
.ولكن لا أستطيع التّعاطف معها

57
00:05:57,750 --> 00:06:01,170
يمكنني فهم الدّوافع خلف دموعكم
وغضبكم وضحككم

58
00:06:01,170 --> 00:06:02,960
.ولكنّي لا أستطيع جعلها ملكًا لي

59
00:06:04,090 --> 00:06:06,670
.اشتريتك لأنّ ذلك كان مفيدًا لي

60
00:06:09,510 --> 00:06:10,800
.هذا كلّ ما في الأمر

61
00:06:12,560 --> 00:06:17,520
لأنّك لم تمتلكي شيئًا، ولم تستطيعي
.الافتراق عنّي أنا غير البشريّ

62
00:06:18,940 --> 00:06:23,610
جعلتك تسمعين الكلمات الّتي اعتقدت
،أنّك تودّين سماعها، وآويتك وأطعمتك

63
00:06:23,610 --> 00:06:26,400
.ومنحتك المعرفة والانتباه

64
00:06:26,400 --> 00:06:30,030
اعتقدت أنّي سأعرف شيئًا إن
.ربّيت واحدًا منكم بنفسي

65
00:06:32,240 --> 00:06:37,330
كنت أنوي إخبارك بعد أن تصبحين
.متعلقة بي تمامًا

66
00:06:32,700 --> 00:06:34,700
.هذا غريب

67
00:06:38,250 --> 00:06:41,290
.ولكنّي اضطررت لفعلها أبكر بسبب رينفريد

68
00:06:41,290 --> 00:06:43,500
.تعابير وجهه لا تتغيّر

69
00:06:44,170 --> 00:06:45,170
.صحيح

70
00:06:46,170 --> 00:06:49,090
يمكنني تدمير هذه الذّكرى لك
.إن كنتِ لا تريدينها

71
00:06:49,090 --> 00:06:52,390
.ولكنّ وميض عينيه كالطّفل

72
00:06:53,850 --> 00:06:56,560
.ليس هنالك داعٍ للخوف

73
00:06:56,890 --> 00:06:59,480
...إلى الوقت الّذي لا تعود فيه بحاجتي

74
00:06:59,480 --> 00:07:02,440
...سأكون

75
00:07:04,400 --> 00:07:05,480
...إلى جانبك

76
00:07:13,910 --> 00:07:17,950
انظروا لذلك الذّكر المحظوظ يتمّ
.الاعتراف بالحبّ له من قِبل أنثى

77
00:07:17,950 --> 00:07:20,370
.لقد أبهرتني أيّها السّاحر

78
00:07:20,370 --> 00:07:24,540
أعتقد أنّها تعني "إنّك مثير للشّفقة
."جدًّا لدرجة أنّي لا أستطيع تركك

79
00:07:25,800 --> 00:07:29,420
.لمستني للمرّة الأولى

80
00:07:31,050 --> 00:07:35,930
يبدو أنّك ستحصل على مبتغاك
.أخيرًا بعد ترحالك الطّويل

81
00:07:36,510 --> 00:07:37,970
.أنا مسرورة من أجلك

82
00:07:50,070 --> 00:07:54,620
هلاّ عدنا إلى منزلنا يا تشيسي؟

83
00:08:20,470 --> 00:08:21,600
أهذا كلّ شيء لليوم؟

84
00:08:25,480 --> 00:08:29,530
.صحيح، آمل أن تستيقظ اليوم

85
00:09:01,850 --> 00:09:04,480
.نفسها ونبضها مستقرّان

86
00:09:04,940 --> 00:09:08,520
.لم يؤذها جسديًّا بعد

87
00:09:10,150 --> 00:09:14,110
.قد تكون تشيسي كفؤًا أكثر ممّا اعتقدت

88
00:09:27,250 --> 00:09:29,630
أتيت ثانية يا سايمون؟

89
00:09:30,040 --> 00:09:32,130
.دعني أقلق عليها على الأقلّ

90
00:09:32,670 --> 00:09:35,470
عدتما من أولتار منذ أسبوعين
.ولم تستيقظ بعد

91
00:09:36,050 --> 00:09:38,050
.هذا متوقّع

92
00:09:38,470 --> 00:09:41,260
،إنّها تُبقي على مهامها الجسديّة في الحدّ الأدنى

93
00:09:41,260 --> 00:09:44,270
.لتستطيع التّركيز على ملء السّحر الّذي استهلكته

94
00:09:45,600 --> 00:09:49,360
التّعافي أسرع في الغابات
.أو تحت الماء منه في المدينة

95
00:09:49,730 --> 00:09:51,190
.ستستيقظ مع الوقت

96
00:09:52,020 --> 00:09:55,990
.لا أحبّذ تركك لطفلة كهذه تتصرّف بهذا التّهوّر

97
00:10:00,620 --> 00:10:03,490
ما زلتَ تخفي شيئًا، أليس كذلك؟

98
00:10:03,490 --> 00:10:05,660
يمكنك معرفة ذلك؟

99
00:10:05,660 --> 00:10:09,380
.مرّت عشرة سنوات مذ عُيّنت لمراقبتك

100
00:10:09,380 --> 00:10:12,590
يمكنني التّمييز ما إن كنت
.شاحب الوجه تحت العظام تلك

101
00:10:38,570 --> 00:10:41,240
.غنّي، غنّي، غنّي

102
00:10:41,240 --> 00:10:43,120
،انتفشي أيّتها الأشجار في الرّياح

103
00:10:43,120 --> 00:10:45,620
،لا تدعي ضوء الشّمس يمرّ

104
00:10:46,910 --> 00:10:48,790
،ارقصي أيّتها الورود والأعشاب

105
00:10:48,790 --> 00:10:51,920
.لا تدعي رائحتك تضيّع الاتّجاه

106
00:10:53,590 --> 00:10:59,430
غنّي مُشيدةً أيّتها الطّيور المشرّدة
.لألاّ يمزّق سيّد اللّيل أجنحتك

107
00:11:00,470 --> 00:11:02,470
،عودي إلى الأرض وغنّي

108
00:11:02,470 --> 00:11:04,640
،رفرفي في السّماوات وغنّي

109
00:11:04,640 --> 00:11:07,390
،احني رأسك إلى الحديقة النّبيلة وغنّي

110
00:11:08,600 --> 00:11:13,560
.إنّه وصول غيالاخ العظيمة من تير نا نوغ

111
00:11:52,440 --> 00:11:56,610
.حسنًا، حسنًا، صادفت صبيّان

112
00:11:56,610 --> 00:11:58,150
.يا للطفكما

113
00:11:58,150 --> 00:12:02,450
ملكتي، لا ينبغي عليك مخاطبة
.الوضيعين بشكل مباشر

114
00:12:02,450 --> 00:12:04,370
.إنّك صارمٌ للغاية

115
00:12:04,660 --> 00:12:08,200
.إنّه واحد من نوعي يا سبريغان

116
00:12:08,740 --> 00:12:12,120
.لا أملك احترامًا لذوي اللّحم

117
00:12:14,210 --> 00:12:15,080
من تكون؟

118
00:12:15,080 --> 00:12:17,590
.حاول ألاّ تتحدّث معها كثيرًا

119
00:12:18,250 --> 00:12:21,420
.إنّها ملكة الجنّيّات

120
00:12:22,800 --> 00:12:26,010
.إنّها تقود جميع مخلوقات اللّيل في بريطانيا

121
00:12:26,010 --> 00:12:27,390
.تيتانيا

122
00:12:27,810 --> 00:12:32,430
على الأرجح أنت الوحيد باستثناء زوجي
.الّذي يدعوني باسمي يا ذا الأشواك

123
00:12:32,640 --> 00:12:34,100
أين الملك؟

124
00:12:34,100 --> 00:12:37,020
.إنّه يهيج، لذا تركته ورائي

125
00:12:37,360 --> 00:12:41,190
.أردت رؤيتك أنت وصغيرتك اليوم

126
00:12:41,820 --> 00:12:42,700
ماذا؟

127
00:12:44,070 --> 00:12:47,830
.أنت تعبد ذلك الإله الأجنبيّ

128
00:12:47,830 --> 00:12:50,450
أنت ما يدعى "كاهن"، أليس كذلك؟

129
00:12:50,450 --> 00:12:51,370
.نـ-نعم

130
00:12:53,210 --> 00:12:56,710
...صحيح، على الرّغم أنّ الرّائحة ضعيفة

131
00:12:59,420 --> 00:13:05,130
أولئك الّذين يرون فاكهة الجنّة
.على أنّ شرّ غير مرحّب بهم

132
00:13:06,510 --> 00:13:07,340
.فلترحل

133
00:13:16,690 --> 00:13:18,150
.كان ذلك فظًّا

134
00:13:18,150 --> 00:13:21,360
.أنا هنا للتّجوّل في الغابة قليلاً فحسب

135
00:13:21,360 --> 00:13:24,030
.سأغادر عندما ينتهي وقت نبيذ العسل

136
00:13:24,400 --> 00:13:27,820
والآن يا ذا الشوك، هلاّ قدّمتني إلى زوجتك؟

137
00:13:28,530 --> 00:13:30,990
.مذهل، ذات شعر أحمر

138
00:13:30,990 --> 00:13:32,870
.ستصبح ساحرة رائعة

139
00:13:34,830 --> 00:13:38,170
أوبيرون... ما الّذي تفعله هنا؟

140
00:13:40,380 --> 00:13:43,460
.ماذا؟ لقد وجدتِني

141
00:13:43,460 --> 00:13:45,670
.لم تكوني تنوين الاختباء حتّى

142
00:13:47,300 --> 00:13:49,140
.توقّف يا أوبيرون

143
00:13:49,140 --> 00:13:51,890
.ليست بلعبة ولا دمية

144
00:13:52,220 --> 00:13:53,350
.ابتعد عنها من فضلك

145
00:13:53,680 --> 00:13:55,480
ماذا، هل تشعر بالغيرة؟

146
00:13:56,020 --> 00:13:58,980
وصلت إلى هذا أخيرًا؟

147
00:13:59,860 --> 00:14:01,110
.يعجبني ذلك

148
00:14:01,110 --> 00:14:02,110
.يا للرّجولة

149
00:14:05,860 --> 00:14:11,410
...ذاك الّذي يرتدي قوقعة لحم
.رؤية تغيير في صغير مثلك رائعة

150
00:14:12,120 --> 00:14:14,950
،كنتَ تراقب من الظّلال حتّى الآن

151
00:14:14,950 --> 00:14:20,630
ولكنّك تحاول إنهاء تجوالك
.بجعل بشريّة قريبة منك

152
00:14:21,500 --> 00:14:25,920
من الممتع مشاهدتك تتصرّف
.وكأنّك أب أو زوج

153
00:14:26,300 --> 00:14:27,800
...ولكن

154
00:14:30,220 --> 00:14:35,470
أتساءل إلى متى يمكنك المحافظة على
.هذا اللّطف الزّائف لهذا الشّخص الواحد

155
00:14:36,310 --> 00:14:40,310
!مؤلم، مؤلم، مؤلم

156
00:14:36,350 --> 00:14:39,560
.لا ينبغي عليك التّنمّر على الأطفال يا عزيزي

157
00:14:42,110 --> 00:14:44,570
أنت هنا لرؤية زوجته، أليس كذلك؟

158
00:14:46,360 --> 00:14:49,240
إنّك ليّنة القلب عندما يتعلّق الأمر
.بالأطفال يا تيتانيا

159
00:14:49,740 --> 00:14:54,950
.للأسف، لست بلا ضمير مثلك

160
00:14:54,950 --> 00:14:57,120
!إنّك فظيعة

161
00:14:57,120 --> 00:14:58,790
.حسنًا

162
00:14:58,790 --> 00:15:01,880
.لنوقظ هذه النّائمة بسرعة

163
00:15:21,940 --> 00:15:22,810
.قوّة سحريّة

164
00:15:40,080 --> 00:15:41,620
.كما توقّعت

165
00:15:45,540 --> 00:15:50,840
.عزيزتنا روبين جميلة عندما تفتح عينيها

166
00:15:51,260 --> 00:15:54,800
.صباح الخير أيّتها الفتاة الّتي تحمل اسم الطّيور

167
00:15:54,800 --> 00:15:56,760
هل راودك حلمٌ جميل؟

168
00:16:00,930 --> 00:16:02,520
...ا-المعذرة

169
00:16:02,900 --> 00:16:03,850
من تكون؟

170
00:16:03,850 --> 00:16:06,020
.صباح الخير يا تشيسي

171
00:16:06,900 --> 00:16:07,570
.إلياس

172
00:16:11,700 --> 00:16:13,360
.رُفضت

173
00:16:13,360 --> 00:16:16,450
.التّأثير الملقى على الصّغار قويٌّ حقًّا

174
00:16:16,450 --> 00:16:19,290
.لا بدّ وأنّها أدركت مدى فظاعتك بحسب

175
00:16:19,290 --> 00:16:20,450
...المعذرة

176
00:16:20,450 --> 00:16:22,210
.كنتِ نائمة لفترة

177
00:16:22,500 --> 00:16:23,420
كيف تشعرين؟

178
00:16:23,420 --> 00:16:25,040
هل أنت متعبة أو متألّمة؟

179
00:16:27,040 --> 00:16:29,630
.كلاّ

180
00:16:29,630 --> 00:16:30,340
.جيّد

181
00:16:34,430 --> 00:16:37,600
.آسفة لإخافتك

182
00:16:37,600 --> 00:16:38,720
،سررت بمقابلتك

183
00:16:38,720 --> 00:16:44,560
أنا تيتانيا، ملكة كلّ الجنّيّات الّتي
—تعيش في ألبيون وتير نا نوغ

184
00:16:44,560 --> 00:16:46,650
!وأنا زوجها أوبيرون

185
00:16:46,650 --> 00:16:47,560
.سررت بمقابلتك

186
00:16:47,560 --> 00:16:48,980
ألبيون؟

187
00:16:48,980 --> 00:16:49,860
تير؟

188
00:16:49,860 --> 00:16:52,400
.اسم قديم لجزيرة بريطانيا العظمى

189
00:16:52,400 --> 00:16:54,820
—تير نا نوغ هي مدينة الجنّيّات

190
00:16:54,820 --> 00:16:56,950
أنتِ، اسمك تشيسي؟

191
00:16:56,950 --> 00:16:58,910
ألست خائفةً منه؟

192
00:16:58,910 --> 00:16:59,830
هل أنتِ بخير؟

193
00:16:59,830 --> 00:17:00,830
لستِ بائسة؟

194
00:17:01,330 --> 00:17:02,450
.نعم

195
00:17:03,790 --> 00:17:05,830
.نعم، أنا بخير

196
00:17:06,080 --> 00:17:07,130
هكذا إذًا؟

197
00:17:07,130 --> 00:17:08,170
.أنا مسرور

198
00:17:08,170 --> 00:17:09,250
.نعم

199
00:17:09,250 --> 00:17:11,000
.لا بأس ما دمت لستِ خائفة

200
00:17:11,000 --> 00:17:12,880
إذًا، ألم تنجبا أطفالاً بعد؟

201
00:17:12,880 --> 00:17:13,880
ماذا؟

202
00:17:13,880 --> 00:17:16,220
أنتما متزوّجان، أليس كذلك؟

203
00:17:16,220 --> 00:17:18,010
.ربّما ما تزالين صغيرة للغاية

204
00:17:18,010 --> 00:17:21,430
.لا بدّ وأنّ طفلكما سيكون ساحرًا رائعًا

205
00:17:21,430 --> 00:17:23,100
.الأطفال ظريفون

206
00:17:23,100 --> 00:17:23,980
!خصوصًا ذوي الشّعر الأشقر

207
00:17:23,980 --> 00:17:24,690
.بحقّ

208
00:17:24,690 --> 00:17:27,400
.نحن نحبّ ذوي الشّعر الأشقر

209
00:17:28,690 --> 00:17:29,820
.سبريغان

210
00:17:29,820 --> 00:17:30,570
.اذهبوا

211
00:17:35,650 --> 00:17:37,820
!مؤلم، مؤلم، مؤلم

212
00:17:38,740 --> 00:17:42,620
.أعتقد أنّه غبيٌ نوعًا ما

213
00:17:42,620 --> 00:17:44,000
.لا تباليه

214
00:17:44,000 --> 00:17:46,540
.أنا آسفة لأنّ زوجي أحمق تمامًا

215
00:17:46,540 --> 00:17:48,580
هـ-هل هو بخير؟

216
00:17:48,580 --> 00:17:50,040
.لا تقلقي

217
00:17:50,040 --> 00:17:51,630
.إنّه يستمتع

218
00:17:52,960 --> 00:17:53,550
!لا

219
00:17:54,760 --> 00:17:56,590
.إنّه من النّوع الّذي يحبّ هذه الأمور

220
00:17:58,260 --> 00:17:59,680
أطفال؟

221
00:17:59,680 --> 00:18:01,680
...عندما قال أطفال، هل يقصد

222
00:18:02,810 --> 00:18:03,970
أهنالك خطبٌ ما؟

223
00:18:05,310 --> 00:18:06,180
.لا

224
00:18:09,900 --> 00:18:12,480
.لا شيء

225
00:18:18,820 --> 00:18:20,120
إلياس؟

226
00:18:20,660 --> 00:18:23,740
...لا شيء، أمعائي للتّوّ

227
00:18:24,290 --> 00:18:25,370
.لا أعلم

228
00:18:26,540 --> 00:18:28,620
.يا إلهي، يا إلهي

229
00:18:29,170 --> 00:18:32,880
عديم الفائدة هذا يصبح
.مفيدًا في بعض الأحيان

230
00:18:34,840 --> 00:18:39,180
.سأغادر الآن، خصوصًا بوجود هذا الغبيّ

231
00:18:41,800 --> 00:18:45,520
.أنا مسرورة لتمكّني من مقابلة صغيرة السّاحر

232
00:18:45,520 --> 00:18:47,480
.تعالي لزيارتنا يومًا ما

233
00:18:47,480 --> 00:18:48,940
.سنقيم وليمة

234
00:18:49,520 --> 00:18:52,360
.سنأتي إن كنت تنوين تركنا نعود

235
00:18:53,400 --> 00:18:54,730
.سنرى ذلك

236
00:18:54,730 --> 00:19:02,120
كلّ كائنات اللّيل، بما فيهم هي وأنت
.هم أطفالي الصّغار الظّريفين

237
00:19:02,320 --> 00:19:04,620
.حسنًا إذًا، يومًا هنيئًا

238
00:19:04,620 --> 00:19:06,700
!إلى اللّقاء

239
00:19:09,290 --> 00:19:13,420
لا تجرؤ حتى على أن تطأ قدمك هناك
.ولو كانت الملكة تسمح بذلك

240
00:19:14,170 --> 00:19:18,720
.إنّه ليس مكانًا لمخلوق هجين بقوقعة لحم

241
00:19:22,470 --> 00:19:26,060
.ذوي الهياكل لا يجلبون إلاّ المصائب

242
00:19:27,390 --> 00:19:28,890
.أعلم

243
00:19:29,560 --> 00:19:31,520
.يستحيل أن أطلب الدّعوة للذّهاب

244
00:19:33,860 --> 00:19:34,940
إلياس؟

245
00:19:36,610 --> 00:19:39,780
.إنّك قاسٍ لكلّ من ليس جنيًّا

246
00:19:40,530 --> 00:19:41,950
...مجرّد قوقعة وضيعة

247
00:19:42,820 --> 00:19:46,700
.كم من النّاس والأرواح فُقدت بسببه

248
00:19:46,700 --> 00:19:49,580
.كان ذلك خطأ البشر

249
00:19:49,580 --> 00:19:54,460
دائمًا ما يكون أتباعنا في ظلال البشر
.هم من ينالون أسوأ المصائر

250
00:19:55,790 --> 00:20:00,380
حسنًا إذًا، ما رأيك أن نتراهن ما إن كانت الأمور
ستسير جيّدًا بين ذلكما الاثنين أم لا يا تيتانيا؟

251
00:20:01,430 --> 00:20:05,390
.سيكون أفضل لو راهنّا على كم سينجبون

252
00:20:06,810 --> 00:20:08,680
.بالطّبع

253
00:20:12,390 --> 00:20:14,310
.خرجت من الغابة أخيرًا

254
00:20:15,770 --> 00:20:18,190
.سحر الجنّيّات مزعج حقًّا

255
00:20:18,820 --> 00:20:20,280
.سايمون-سان

256
00:20:20,280 --> 00:20:21,240
!تشيسي-كن

257
00:20:21,820 --> 00:20:23,610
.استيقظت أخيرًا

258
00:20:23,610 --> 00:20:25,200
.كنّا قلقين عليك

259
00:20:25,200 --> 00:20:26,370
.آسفة

260
00:20:27,780 --> 00:20:32,250
.الأخوات ستوبّخنني

261
00:20:32,250 --> 00:20:33,000
.سأرجع الآن

262
00:20:34,500 --> 00:20:38,550
من المؤسف أنّي لا أستطيع
.البقاء في منزلك حتّى وقت العشاء

263
00:20:38,550 --> 00:20:41,800
هل أنت مراقبي حقًّا؟

264
00:20:42,590 --> 00:20:43,880
.إنّي أمزح

265
00:20:45,590 --> 00:20:48,560
.حسنًا إذًا يا تشيسي-كن، اعتني بنفسك

266
00:20:52,600 --> 00:20:54,060
.إنّه شخص جيّد

267
00:20:54,480 --> 00:20:57,110
.إنّه غبيّ فحسب

268
00:20:57,520 --> 00:20:59,900
.لم يتغيّر أبدًا خلال عشر سنوات

269
00:21:01,490 --> 00:21:02,320
...عشر سنوات

270
00:21:05,700 --> 00:21:09,700
.أتمنّى لو أنّك اشتريتني قبل عشر سنوات

271
00:21:11,240 --> 00:21:16,500
على الرّغم من أنّنا سنقضي وقتًا
أكثر من عشر سنوات بكثير؟

272
00:21:17,920 --> 00:21:21,380
.آمل أن تنجح تجربتك

273
00:21:22,550 --> 00:21:23,380
.ستنجح

274
00:21:33,890 --> 00:21:35,390
حقًّا؟

275
00:21:35,390 --> 00:21:36,900
.سنجعلها تنجح

276
00:21:39,520 --> 00:21:42,400
.والآن، الفضيّة تنتظر

277
00:21:42,780 --> 00:21:43,650
.لنعد إلى المنزل

278
00:21:50,490 --> 00:21:51,410
ما هذا؟

279
00:21:51,410 --> 00:21:54,290
.ليس في وقته، ولكنّه بودنغ عيد الميلاد

280
00:21:54,750 --> 00:21:57,830
.احتفظَت به منذ يوم عودتك

281
00:22:08,970 --> 00:22:10,180
.إنّه لذيذ

282
00:22:22,190 --> 00:22:23,280
...إيزابيل

283
00:23:55,950 --> 00:23:59,700
يذهب كلّ من الفتاة والسّاحر
.لينجزا مهمتهما الأخيرة

284
00:24:00,120 --> 00:24:05,420
مخطّطات المشعوذ جوزيف تبدأ لمطاردة
.الكلب الأسود الّذي لا يملك صاحبًا

285
00:24:06,090 --> 00:24:07,960
.قومي بعملٍ جيّد المرّة القادمة