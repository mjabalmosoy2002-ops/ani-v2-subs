1
00:02:29,670 --> 00:02:31,540
آخذ تشيسي إلى أرض التّنانين؟

2
00:02:33,800 --> 00:02:34,590
.نعم

3
00:02:34,590 --> 00:02:42,680
سمع سيّدي لينديل إشاعة تقول أنّ روبين
.تلك لديها مشكلة في استعمال السّحر

4
00:02:43,100 --> 00:02:46,270
.لذا فإنّه يصرّ على أن تصنع لها عصا بسرعة

5
00:02:47,060 --> 00:02:47,770
عصا؟

6
00:02:48,390 --> 00:02:51,940
.إنّها أداة لإيصال نواياك لأليفيك

7
00:02:52,310 --> 00:02:56,320
.يريد أن تذهبي لرؤيته يا روبين

8
00:02:56,320 --> 00:02:59,400
.إنّي أخرج كثيرًا مؤخرًا

9
00:02:59,650 --> 00:03:02,620
.لا تقلق بشأن ذلك

10
00:03:02,620 --> 00:03:06,290
.يريد أن تأتي روبين لوحدها

11
00:03:06,580 --> 00:03:07,950
تشيسي لوحدها؟

12
00:03:07,950 --> 00:03:11,830
أريد قضاء الوقت مع حفيدتي"
.وليس معك" كما يقول

13
00:03:12,250 --> 00:03:14,000
...ذلك العجوز

14
00:03:14,000 --> 00:03:14,840
حفيدة؟

15
00:03:14,840 --> 00:03:16,800
إذًا إلياس هو ابنه؟

16
00:03:17,300 --> 00:03:20,630
،يبدو أنّه يريد التّحدّث عن عصاك
.لذا أعتقد أنّ لا مشكلة في ذلك

17
00:03:21,130 --> 00:03:22,760
.اعتني بنفسك

18
00:03:26,600 --> 00:03:27,560
ألا تريدين؟

19
00:03:27,850 --> 00:03:30,890
لا، ولكن لوحدي؟

20
00:03:31,270 --> 00:03:32,600
.أنا معك

21
00:03:33,100 --> 00:03:34,440
.صحيح

22
00:03:34,440 --> 00:03:36,270
هل انتهيتم من الحديث؟

23
00:03:36,650 --> 00:03:38,900
.لم تتغيري إطلاقًا

24
00:03:38,900 --> 00:03:39,900
...عفوًا

25
00:03:39,900 --> 00:03:42,240
بربّك، هل نسيتني؟

26
00:03:42,240 --> 00:03:44,200
مع أنّنا تحدّثنا من قبل؟

27
00:03:44,530 --> 00:03:47,330
.ولكنّك رفضتِ الطّيران معي

28
00:03:52,330 --> 00:03:55,380
.بعض التّنانين تنمو بسرعة

29
00:03:55,710 --> 00:04:00,630
اعتقدت أنّي أصبحت بحجمٍ يسمح
.لك بركوبي، لذا انتهزت الفرصة

30
00:04:01,420 --> 00:04:02,550
حقًّا؟

31
00:04:14,150 --> 00:04:15,560
.شكرًا لك يا سيلكي

32
00:04:23,530 --> 00:04:25,110
.حسنًا إذًا، أنا ذاهبة

33
00:04:25,700 --> 00:04:26,950
.اعتني بنفسك

34
00:04:27,410 --> 00:04:28,990
.الطّقس بارد هناك

35
00:04:28,990 --> 00:04:30,500
.لا تتجمّدي

36
00:04:30,790 --> 00:04:31,450
.حسنًا

37
00:04:34,370 --> 00:04:35,420
إلياس؟

38
00:04:36,080 --> 00:04:36,920
نعم؟

39
00:04:39,800 --> 00:04:40,630
.لا شيء

40
00:04:40,630 --> 00:04:42,090
.لننطلق

41
00:04:45,090 --> 00:04:48,680
!تمسّكي جيّدًا لكي لا تسقطي

42
00:04:58,650 --> 00:04:59,730
ما هذا؟

43
00:04:59,730 --> 00:05:01,900
.إنّها تعويذة إخفاء

44
00:05:01,900 --> 00:05:03,990
.لن يجدنا أحد الآن

45
00:05:03,990 --> 00:05:07,240
.هذا أسرع بكثير من السّباحة خلال البحر

46
00:05:07,240 --> 00:05:08,160
البحر؟

47
00:05:08,530 --> 00:05:10,030
.أنا سِلكي

48
00:05:10,540 --> 00:05:16,710
.أنا قاطنة البحار العظيمة، بهيئتَيْ فقمة وبشر

49
00:05:57,120 --> 00:05:58,540
هل أنتِ بخير؟

50
00:05:58,540 --> 00:06:00,960
.سنصل حالما نمرّ من خلال الرّياح

51
00:06:00,960 --> 00:06:02,420
.تحمّلي أكثر قليلاً

52
00:06:03,050 --> 00:06:03,960
.حسنًا

53
00:06:19,730 --> 00:06:21,650
.سيكون إلياس على ما يرام

54
00:06:21,980 --> 00:06:22,690
.نعم

55
00:06:32,490 --> 00:06:34,080
!سيّدي لينديل

56
00:06:34,450 --> 00:06:38,210
.أنجزت ما طلبته منّي يا سيّدي لينديل

57
00:06:38,210 --> 00:06:41,380
.نعم، أحسنتِ العمل، إنّك رائعة

58
00:06:41,750 --> 00:06:43,500
.مرحبًا يا سيّد لينديل

59
00:06:43,500 --> 00:06:44,630
.تشيسي

60
00:06:44,630 --> 00:06:46,090
.لم أرك منذ وقتٍ طويل

61
00:06:46,590 --> 00:06:48,880
.تبدين بحالة جيّدة

62
00:06:50,130 --> 00:06:51,760
.وكسبتِ بعض الوزن

63
00:06:52,140 --> 00:06:53,100
.فتاة جيّدة

64
00:06:53,760 --> 00:06:56,310
.من الجيّد أنّك وجدت عائلةً جيّدة

65
00:06:57,350 --> 00:06:59,440
ما خطب هذه الملابس يا سيّد لينديل؟

66
00:06:59,440 --> 00:07:02,940
.نعم، ذهبت للتّسوّق في المدينة

67
00:07:03,310 --> 00:07:04,610
أنا وسيم، أليس كذلك؟

68
00:07:05,570 --> 00:07:07,570
.إنّه يشابه إلياس قليلاً

69
00:07:07,860 --> 00:07:11,030
.هيّا يا رفاق، ألقوا التّحيّة

70
00:07:12,530 --> 00:07:14,280
.أتطلّع للعمل معكم

71
00:07:19,500 --> 00:07:22,080
.لم أتمكّن من الشّرح بتفصيل في المرّة السّابقة

72
00:07:22,880 --> 00:07:27,340
تأسّست أرض التّنانين كأرض
،للتّعشيش من قِبل المدير الأوّل

73
00:07:27,340 --> 00:07:31,470
.للتّنانين القليلة المتبقّية المنتشرة في العالم

74
00:07:31,890 --> 00:07:34,720
لم تكن أنت من أنشأها إذًا؟

75
00:07:35,100 --> 00:07:38,310
.كنت مجرّد رحّالة

76
00:07:38,680 --> 00:07:43,350
.لم أملك اسمًا إلى أن سمّتني معلّمتي

77
00:07:43,690 --> 00:07:44,980
.حسنًا، لقد وصلنا

78
00:08:05,040 --> 00:08:07,050
.شجرة نيفين

79
00:08:13,550 --> 00:08:16,890
.سأعدّ العشاء

80
00:08:16,890 --> 00:08:17,350
.تشيسي

81
00:08:19,520 --> 00:08:20,810
.إنّها عصاك

82
00:08:20,810 --> 00:08:21,850
.عليك القيام بالأمر لوحدك

83
00:08:27,070 --> 00:08:28,270
هل أنتِ بخير؟

84
00:08:28,820 --> 00:08:30,110
.نـ-نعم

85
00:08:34,320 --> 00:08:38,120
!ما خطبك؟

86
00:08:38,330 --> 00:08:41,540
!من يسقط دون محاولة تعديل سقوطه؟

87
00:08:41,540 --> 00:08:42,290
.مؤلم

88
00:08:42,290 --> 00:08:43,120
.آسفة

89
00:08:43,120 --> 00:08:45,080
.حمايتك مفرطة

90
00:08:45,080 --> 00:08:48,840
.التّعرّف على الصّخور قليلاً لن يقتلها

91
00:08:49,090 --> 00:08:50,050
!اصمتي

92
00:08:50,460 --> 00:08:51,970
هل أذهب أنا؟

93
00:08:51,970 --> 00:08:54,800
.لا، أنا من سيستعملها

94
00:08:55,340 --> 00:08:57,050
.سأبذل جهدي أكثر

95
00:09:05,190 --> 00:09:06,900
.شكرًا لك يا فضيّة

96
00:09:09,400 --> 00:09:11,230
،المكان هادئٌ للغاية

97
00:09:13,650 --> 00:09:16,160
.على الرّغم من أنّ تلك الفتاة ليست كثيرة الكلام

98
00:09:17,740 --> 00:09:20,450
.أشعر أنّ الجوّ بارد للغاية

99
00:09:24,620 --> 00:09:27,330
.مرحبًا يا سيّد آينسورث

100
00:09:27,920 --> 00:09:32,050
.اسمي أدولف ستراود، من إدارة الكُلّيّة

101
00:09:32,800 --> 00:09:33,840
كلّيّة؟

102
00:09:34,340 --> 00:09:36,720
.سأدخل في صلب الموضوع مباشرة

103
00:09:37,220 --> 00:09:43,220
أريد التّحدّث عن مستقبل
.الطّفلة البشريّة بعمق

104
00:09:55,150 --> 00:09:56,990
.حساء رنّة

105
00:09:57,320 --> 00:09:59,160
.أعتقد أنّ هذه أوّل مرة تجرّبيه

106
00:09:59,160 --> 00:09:59,990
.نعم

107
00:10:05,040 --> 00:10:06,120
.إنّه لذيذ

108
00:10:07,580 --> 00:10:09,670
.جسدك مليء بالخدوش

109
00:10:09,670 --> 00:10:10,590
.دعيني أرى

110
00:10:19,430 --> 00:10:22,060
.إنّ يدي هي ما يُسمّى يد الشّفاء

111
00:10:22,350 --> 00:10:24,930
يمكنني شفاؤك فورًا ما لم
.تكوني مجروحة جروحًا قاتلة

112
00:10:25,430 --> 00:10:28,350
.كان هنالك المزيد منّا في السّابق

113
00:10:29,150 --> 00:10:32,360
.ولكن لم يولد الكثير خلال آخر مئات السّنين

114
00:10:38,780 --> 00:10:41,990
منذ متى تعيش يا سيّد لينديل؟

115
00:10:41,990 --> 00:10:45,160
هل السّحرة الآخرين يعيشون لوقتٍ طويل أيضًا؟

116
00:10:46,410 --> 00:10:49,040
.لهذا انفعلت كثيرًا سابقًا

117
00:10:49,040 --> 00:10:51,170
!ذلك الغبيّ

118
00:10:51,170 --> 00:10:53,420
!لم يشرح أيّ شيء

119
00:10:53,420 --> 00:10:54,250
...ما الّذي

120
00:10:54,250 --> 00:10:58,930
.آسفة، أنا المخطئة لعدم سؤالي إلياس

121
00:11:01,390 --> 00:11:07,270
تشيسي، سبب إحضاري لك إلى هنا
.لوحدك هو لأنّي أشعر بالقلق

122
00:11:07,850 --> 00:11:13,110
.يبدو أنّه يريد ترويضك، كما يفعل أحدهم بالرّنّة

123
00:11:13,980 --> 00:11:17,900
.ويبدو أنّك راضية بذلك يا تشيسي

124
00:11:24,580 --> 00:11:30,870
من أنجبتني أخبرتني أنّه لم يكن
.ينبغي أن تفعل ذلك

125
00:11:33,590 --> 00:11:38,460
.أمّي لم تردني، لذا هربت وماتت

126
00:11:39,800 --> 00:11:44,260
.أعتقد أنّ أبي وأخي الصّغير هربا منّي أيضًا

127
00:11:46,390 --> 00:11:50,440
.إلياس فقط من أبقاني إلى جانبه

128
00:11:53,480 --> 00:11:58,280
.لهذا لا أسأله شيئًا لا يقوله

129
00:11:58,820 --> 00:12:01,240
.أريد أن أكون راضية

130
00:12:05,160 --> 00:12:07,950
.ولكن لا يبدو كذلك على الإطلاق

131
00:12:13,830 --> 00:12:17,750
.سأخبرك قصّة نوم ممتعة

132
00:12:18,630 --> 00:12:20,380
قصّة ممتعة؟

133
00:12:21,010 --> 00:12:25,470
.أعتقد أنّي سأجيب سؤالك أيضًا

134
00:12:26,140 --> 00:12:30,770
.ولكن نصفها عقابٌ لذلك الوغد لإحزان ابنته

135
00:12:33,100 --> 00:12:36,560
،قبل زمنٍ بعيد، حين كان العالم ما يزال مظلمًا

136
00:12:36,560 --> 00:12:41,110
قبل قوّة البخار، وحتّى قبل قوّة
...الزّيت التّرابيّ القديم

137
00:12:42,400 --> 00:12:50,410
.نحن السّحرة كنّا ندرك أنّنا لسنا أشخاصًا عاديّين

138
00:12:52,160 --> 00:12:59,710
لأنّنا نرى مخلوقات سحريّة، ونثير معجزات
.لا يمكن لشخصٍ عاديّ أن يفعلها

139
00:13:00,000 --> 00:13:04,090
.وأحيانًا نعيش حياة طويلة للغاية

140
00:13:06,010 --> 00:13:10,560
،لا نعرف سبب طول حياتنا
.أو امتلاكنا لقدرات لا يملكها البشر

141
00:13:11,100 --> 00:13:15,810
.ربّما يكون القدر أرادنا أن نولد هكذا ببساطة

142
00:13:16,730 --> 00:13:20,900
ولكنّ أولئك الّذين لم يقتنعوا
.ظلّوا يبحثون عن إجابة

143
00:13:21,190 --> 00:13:23,490
"لماذا نحن هكذا؟"

144
00:13:24,150 --> 00:13:28,240
"أهنالك عملٌ علينا إنجازه؟"

145
00:13:29,660 --> 00:13:33,250
.الكثيرون من نوعنا هلكوا خلال بحثهم

146
00:13:40,300 --> 00:13:46,010
.تجوّلتُ لوحدي سائمًا من ذلك النّهج

147
00:13:46,800 --> 00:13:51,810
في أحد اللّيالي، كانت هناك ذئاب، ولم
.يكن لديّ خيار سوى الاحتراس طوال اللّيل

148
00:13:54,980 --> 00:13:57,440
.ولكن الذّئاب لم تأتِ

149
00:13:59,230 --> 00:14:01,900
.عوضًا عن ذلك، جاء ذاك

150
00:14:04,740 --> 00:14:10,120
.أتى بشكلٍ مؤكّد كقدوم اللّيل على رجلين

151
00:14:17,920 --> 00:14:18,960
...أنت

152
00:14:24,460 --> 00:14:26,090
ما الخطب؟

153
00:14:27,720 --> 00:14:30,050
.أنا جائع

154
00:14:31,640 --> 00:14:33,060
!أنت

155
00:14:46,490 --> 00:14:48,150
استيقظت إذًا؟

156
00:14:49,660 --> 00:14:51,990
.ظللتَ نائمًا طوال اللّيل

157
00:14:51,990 --> 00:14:55,200
.إنّك ضخم، كان حملك متعبًا

158
00:14:58,460 --> 00:14:59,670
ألن تأكل؟

159
00:15:00,750 --> 00:15:03,210
من أين أتيت؟

160
00:15:03,550 --> 00:15:04,670
.لا أعلم

161
00:15:05,550 --> 00:15:09,930
وجدت نفسي في الغابة عندما
.وعيت، وكنت أمشي

162
00:15:10,390 --> 00:15:16,220
تجنّبت النّاس، مشيت ومشيت
.ومشيت حتّى وصلت إلى هنا

163
00:15:16,810 --> 00:15:18,690
.أشعر بالتّعب

164
00:15:24,610 --> 00:15:25,650
ما الخطب؟

165
00:15:26,190 --> 00:15:27,280
.لا شيء

166
00:15:30,030 --> 00:15:33,410
.يبدو أنّك شيءٌ كالشّبح

167
00:15:33,410 --> 00:15:36,620
.ولكن تتّزر باللّحم، كمخلوق حيّ

168
00:15:36,950 --> 00:15:38,620
ماذا تكون؟

169
00:15:39,210 --> 00:15:40,210
.لا أعلم

170
00:15:43,630 --> 00:15:46,550
.على أيّ حال، لنذهب لمقابلة معلّمتي

171
00:15:47,130 --> 00:15:49,920
.إنّها غريبة

172
00:15:50,220 --> 00:15:54,640
.قد تكون في الجانب الآخر من العالم
.وقد تكون هنا تمامًا

173
00:15:54,640 --> 00:15:58,470
قد تكون حيّة بعد مائة سنة
.من الآن أو قبل مائة سنة

174
00:15:58,850 --> 00:16:02,600
.قد تقدّم الإرشادات كونها متطفّلة

175
00:16:03,770 --> 00:16:07,820
أتوقّع أنّ هذا سيكون أقل وجعًا
.من التّجوال خلال البراري بلا هدف

176
00:16:08,280 --> 00:16:09,990
من تكون؟

177
00:16:09,990 --> 00:16:11,400
.أنا لينديل

178
00:16:11,990 --> 00:16:16,410
."الأشخاص العاديّون ينادونا بـ"السّحرة

179
00:16:20,540 --> 00:16:21,790
ما ذلك؟

180
00:16:22,500 --> 00:16:25,460
.طقوس قديمة لإيجاد المفقود

181
00:16:25,750 --> 00:16:29,260
.اجمع بعض الصّنوبر، اربطها في خيط أحمر، ثم فكّها

182
00:16:29,550 --> 00:16:32,510
الصّنوبر الّذي يغطي الأرض عبارة
.عن طاولة عشاء لإله الغابة

183
00:16:32,510 --> 00:16:35,260
.نحن نطلب مساعدته وتوجيهاته

184
00:16:36,220 --> 00:16:42,690
.يا دليلي، خذنا إلى ما وراء الضّباب، إلى من نبتغيه

185
00:16:54,160 --> 00:16:55,740
.يصبح الضّباب كثيفًا

186
00:16:55,740 --> 00:16:56,740
.لا تبتعد عنّي

187
00:17:23,230 --> 00:17:24,140
.ماء

188
00:17:24,140 --> 00:17:25,270
.البحر

189
00:17:25,270 --> 00:17:26,400
.تذوّق

190
00:17:26,400 --> 00:17:27,690
.إنّه ممتع

191
00:17:36,240 --> 00:17:38,240
.هذا منزل معلّمتي

192
00:17:50,040 --> 00:17:51,050
.يا معلّمتي

193
00:17:51,050 --> 00:17:52,010
.راهاب

194
00:17:52,010 --> 00:17:52,590
هل أنتِ موجودة؟

195
00:17:56,590 --> 00:17:57,800
هذا أنت يا لينديل؟

196
00:17:58,050 --> 00:18:02,100
.من النّادر أن تأتي إلى هنا

197
00:18:02,520 --> 00:18:04,560
.وأنا من ظننت أنّك سُمّيت تيمّنًا بشجرة التّجمّع

198
00:18:04,560 --> 00:18:07,020
.أنتِ من اختار الاسم يا معلّمتي

199
00:18:07,020 --> 00:18:10,440
عليك أن تبذل المزيد من الجهد
—للتّفاعل مع النّاس

200
00:18:10,940 --> 00:18:12,980
.وجدته البارحة

201
00:18:13,320 --> 00:18:15,780
.أردتك أن تلقي نظرة عليه

202
00:18:18,110 --> 00:18:19,410
.ادخل

203
00:18:19,410 --> 00:18:22,990
.أودّ ذلك، ولكنّك كبير

204
00:18:23,370 --> 00:18:24,790
هل يمكنك أن تصبح أصغر؟

205
00:18:25,080 --> 00:18:26,370
أصغر؟

206
00:18:26,370 --> 00:18:27,420
.صحيح

207
00:18:27,420 --> 00:18:28,790
.بحجم البشر

208
00:18:28,790 --> 00:18:30,130
...البشر

209
00:18:34,460 --> 00:18:35,340
هكذا؟

210
00:18:35,340 --> 00:18:36,420
.نعم

211
00:18:36,420 --> 00:18:37,550
.أحسنت

212
00:18:38,130 --> 00:18:38,970
.تعال

213
00:18:46,430 --> 00:18:47,940
لا تعرفين؟

214
00:18:47,940 --> 00:18:49,480
...حسنًا

215
00:18:49,480 --> 00:18:55,240
،إنّه قريب جدًّا من كونه روحًا أو جنّيّ
.ولكن هنالك شيء "بشريّ" فيه

216
00:18:55,610 --> 00:18:59,410
سيكون من المنطقيّ إن كان مجرّد بشريّ حوّل

217
00:18:59,410 --> 00:19:02,410
.نفسه محاولاً استخدام السّحر الأسود

218
00:19:02,830 --> 00:19:04,490
...ولكن بعكس ذلك، هذا

219
00:19:06,040 --> 00:19:11,080
أتذكر شيئًا ممّا حدث قبل أن تبدأ المشي؟

220
00:19:11,750 --> 00:19:14,590
أتذكر شيئًا؟

221
00:19:18,550 --> 00:19:19,470
.أحمر

222
00:19:19,800 --> 00:19:20,680
أحمر؟

223
00:19:22,550 --> 00:19:25,060
.لا ترغم نفسك على التّذكّر

224
00:19:25,930 --> 00:19:30,730
.أنت ستعتني به يا لينديل

225
00:19:31,560 --> 00:19:32,860
لماذا أنا؟

226
00:19:32,860 --> 00:19:34,860
.أشفقتَ عليه مرّة بالفعل

227
00:19:34,860 --> 00:19:37,110
.لذا وجب عليك الاعتناء به إلى أن يصبح مستقلاًّ

228
00:19:37,610 --> 00:19:40,320
.عليّ اللّحاق بالرّنّة

229
00:19:40,320 --> 00:19:43,620
.حان الوقت لأن تتّخذ تلميذًا

230
00:19:43,620 --> 00:19:46,660
.لا ينبغي علينا أن نعيش لوحدنا

231
00:19:46,660 --> 00:19:47,830
ألم أعلّمك ذلك؟

232
00:19:48,710 --> 00:19:51,830
.لن أخبرك أن تحبّ عدوّك

233
00:19:52,170 --> 00:19:55,960
.ولكنّ الأليفين يحبّوننا

234
00:19:56,670 --> 00:20:00,720
.من واجبنا تقديم يد العون لمن يحتاجها

235
00:20:02,640 --> 00:20:05,560
.ليس وكأنّنا نطلب بأن نُحَبّ

236
00:20:05,810 --> 00:20:07,600
.لا أنا ولا أنتِ

237
00:20:07,850 --> 00:20:09,640
.كأنّنا ملعونان

238
00:20:10,440 --> 00:20:14,560
.اللّعنات والبركات نفس الشّيء في الجوهر يا لينديل

239
00:20:14,860 --> 00:20:16,520
.ما يهمّ هو كيف تتلقّاها

240
00:20:19,400 --> 00:20:20,450
.لا بأس

241
00:20:20,450 --> 00:20:21,910
.سأذهب

242
00:20:22,200 --> 00:20:26,240
،إن كان من الأفضل ألاّ أتواجد هنا
.فسأستمرّ بالمشي

243
00:20:27,330 --> 00:20:28,580
إلى أين؟

244
00:20:28,950 --> 00:20:32,830
لا أعلم، ولكنّك مشغول، أليس كذلك؟

245
00:20:33,630 --> 00:20:36,040
.أنا لا أتّخذ تلاميذًا

246
00:20:40,590 --> 00:20:44,890
.لذا أنت من الآن أحد معارفي

247
00:20:46,720 --> 00:20:50,730
.سيتوجّب عليّ أن أقدّم لمعارفي المتعبين مكانًا للنّوم

248
00:20:51,520 --> 00:20:53,020
.لستُ بحاجة لذلك

249
00:20:53,020 --> 00:20:55,100
.لا يحقّ لك الحديث بعد أن انهرت

250
00:20:55,100 --> 00:20:57,070
.يا للطفك

251
00:20:57,070 --> 00:20:57,770
!اصمتي

252
00:20:57,770 --> 00:21:00,780
.بما أنّ ذلك قد تمّ، نحن أصدقاء

253
00:21:01,150 --> 00:21:02,700
ما اسمك؟

254
00:21:03,280 --> 00:21:04,780
.أعتقد أنّك لا تملك واحدًا

255
00:21:04,780 --> 00:21:05,950
ماذا أناديك يا ترى؟

256
00:21:05,950 --> 00:21:09,120
.ها قد بدأ هوس معلّمتي بإعطاء الأسماء

257
00:21:09,990 --> 00:21:14,120
.كلّ الآلهة والجنّ معك

258
00:21:14,120 --> 00:21:17,170
،حتّى ولو لم يلحظك أحد

259
00:21:17,960 --> 00:21:24,630
حتّى إن كنتَ حزينًا، تعاني وتُسحق
.من الوحدة، فسيعتنون بك دومًا

260
00:21:25,510 --> 00:21:29,720
.لذا اطمئنّ وأنقذ نفسك

261
00:21:51,950 --> 00:21:53,330
.إلياس

262
00:21:58,880 --> 00:22:00,550
أنت! آينسورث؟

263
00:22:00,800 --> 00:22:02,920
!يا زميلي الأكبر! توقّف

264
00:22:02,920 --> 00:22:04,010
.رينفريد

265
00:22:04,630 --> 00:22:09,050
ستفسدها إن استمررت بعدم فعل
.شيء سوى تركها تعيش معك

266
00:23:55,740 --> 00:23:57,910
.قصّة ماضي السّاحر

267
00:23:57,910 --> 00:24:01,790
تزعزع قلب الفتاة بعد تلقيها
.للحقيقة الّتي كانت مخفيّة

268
00:24:01,790 --> 00:24:05,000
ما الّذي يجلبه الفراق القصير للاثنين؟

269
00:24:05,500 --> 00:24:09,170
.سأخبرك بما لم أتمكّن من إخبارك إيّاه أيضًا