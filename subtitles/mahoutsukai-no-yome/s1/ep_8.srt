.نعم

122
00:10:02,370 --> 00:10:07,580
.في الحقيقة، يمكنك فعل أيّ شيء بالسّحر

123
00:10:08,120 --> 00:10:10,500
يمكنك تحويل الصّخور إلى ذهب

124
00:10:10,500 --> 00:10:16,420
وجعل الأسماك تسبح في السّماء
.وحفظ المحاصيل من العفن

125
00:10:16,920 --> 00:10:21,220
.تدور كلماته في ذهني

126
00:10:23,810 --> 00:10:27,600
.ولكنّ هذا شيءٌ لا ينبغي أن يُفعل

127
00:10:28,770 --> 00:10:31,560
.لن أدعك تأخذه

128
00:10:33,270 --> 00:10:35,400
.إنّك مطّلعة على الرّغم من كونك طفلة

129
00:10:35,400 --> 00:10:36,740
.صقور الرّتيلاء

130
00:10:36,740 --> 00:10:37,820
.إنّها تصيد العناكب

131
00:10:38,280 --> 00:10:40,950
،ولكن بهذا الحجم الصّغير

132
00:10:42,410 --> 00:10:44,490
.سيتمّ أكلها فحسب

133
00:10:48,580 --> 00:10:50,540
!توقّفي يا تشيسي

134
00:10:50,540 --> 00:10:51,920
...جسدك

135
00:10:53,000 --> 00:10:54,210
!أيّها السّاحر

136
00:10:54,210 --> 00:10:56,260
.أكلت القليل منّي فحسب

137
00:10:57,550 --> 00:10:58,510
!تشيسي

138
00:11:07,220 --> 00:11:08,140
!تشيسي

139
00:11:08,390 --> 00:11:10,900
.لا ينبغي عليك فعل هذا يا تشيسي

140
00:11:10,900 --> 00:11:14,230
!لا يمكننا أن نلوي قوانين هذا العالم

141
00:11:15,650 --> 00:11:17,610
!الحصان وقبّعة

142
00:11:25,080 --> 00:11:27,330
تعويذة جنّيّة؟

143
00:11:27,790 --> 00:11:29,330
.هذا ليس سيّئًا

144
00:11:34,960 --> 00:11:37,250
لِمَ أردت هذا مرّة أخرى؟

145
00:11:37,760 --> 00:11:39,550
.لصنع كيميرا

146
00:11:39,550 --> 00:11:41,800
لِمَ أردت صنع كيميرا في المقام الأوّل؟

147
00:11:42,220 --> 00:11:43,390
لأجل ماذا؟

148
00:11:45,140 --> 00:11:46,890
.لا يهمّ

149
00:11:47,510 --> 00:11:50,600
.والآن، ابحثي عنهم بخيوطك

150
00:11:53,520 --> 00:11:56,770
.ذلك الوغد لن يأتي للبحث عنّا هنا

151
00:11:57,020 --> 00:11:59,110
.شكرًا لك أيّها الشّعلة الزّرقاء

152
00:11:59,110 --> 00:12:00,950
شوكة الظّلال؟

153
00:12:00,950 --> 00:12:03,200
.يا إلهي، جلبت الكثير من المتاعب رفقتك

154
00:12:03,200 --> 00:12:05,030
لا تكره هذا، أليس كذلك؟

155
00:12:05,030 --> 00:12:06,120
.يمكنك قول ذلك

156
00:12:06,120 --> 00:12:07,580
!ابتعد عن رأسي

157
00:12:07,580 --> 00:12:09,200
.إنّه وهج مستنقعيّ

158
00:12:10,040 --> 00:12:14,880
جنّيّ شعلة زرقاء يعيش في الغابات
.والمقابر، يربك المارّة

159
00:12:14,880 --> 00:12:16,250
!لا تقل اسمي

160
00:12:16,250 --> 00:12:17,630
!هذا فظّ

161
00:12:17,630 --> 00:12:18,670
.حسنًا، حسنًا

162
00:12:23,340 --> 00:12:26,930
.دمائي تجري بسرعة عبر جسدي

163
00:12:28,510 --> 00:12:30,640
.اهدئي يا تشيسي

164
00:12:30,930 --> 00:12:32,230
.ستكونين على ما يرام

165
00:12:33,520 --> 00:12:35,810
.إلياس

166
00:12:35,810 --> 00:12:37,940
.أنا آسفة

167
00:12:38,190 --> 00:12:39,360
.لم أستمع لك

168
00:12:39,940 --> 00:12:41,070
.أنا آسفة

169
00:12:41,070 --> 00:12:42,740
.كوني حذرة من الآن فصاعدًا

170
00:12:43,110 --> 00:12:44,280
.هذا يكفي

171
00:12:54,750 --> 00:12:55,620
!تشيسي

172
00:12:58,590 --> 00:13:01,880
.أشعر أنّ دمي سيفيض وينفجر

173
00:13:02,590 --> 00:13:04,470
أنتِ سلي بيغي؟

174
00:13:04,470 --> 00:13:05,590
.إنّك ضعيفة للغاية

175
00:13:05,590 --> 00:13:06,840
.مسكينة

176
00:13:07,220 --> 00:13:09,430
.خذي فحمي

177
00:13:09,430 --> 00:13:11,310
.سيهدّئك قليلاً

178
00:13:15,940 --> 00:13:17,270
.إنّه دافئ

179
00:13:17,270 --> 00:13:20,730
.استيقظت أخيرًا أيّها الكلب النّعسان

180
00:13:20,730 --> 00:13:21,730
!لست كلبًا

181
00:13:21,730 --> 00:13:22,400
...أنا

182
00:13:23,440 --> 00:13:26,240
.لا تقل أشياءً سخيفة أيّها الكلب الغبيّ

183
00:13:26,240 --> 00:13:29,240
.لستَ بشرًا ولا كلبًا عاديًّا

184
00:13:29,240 --> 00:13:30,950
ألم تستيقظ بعد؟

185
00:13:30,950 --> 00:13:32,410
،انضج أيّها الجرو

186
00:13:32,410 --> 00:13:34,790
!وتوقّف عن الاعتماد على أشخاص ميّتين

187
00:13:35,410 --> 00:13:40,790
كفّ عن الأنين وعد إلى هيئتك
!المعتادة يا روح الكنيسة الحالكة

188
00:13:44,630 --> 00:13:49,050
وظيفتك هي ملاحقة سارقي
.القبور إلى أبواب الجحيم

189
00:13:50,010 --> 00:13:52,220
.إنّك كلب أسود

190
00:13:54,930 --> 00:13:55,980
.فهمت

191
00:13:56,560 --> 00:13:57,810
.هذا ما كان عليه الأمر

192
00:13:59,350 --> 00:14:00,690
.فهمت الآن

193
00:14:01,820 --> 00:14:06,950
.لن تعود أختي الصّغيرة مهما انتظرت

194
00:14:13,540 --> 00:14:18,750
هلاّ أخذتني إلى جانبك يا تشيسي؟

195
00:14:19,370 --> 00:14:21,040
.سأمنحك كلّ ما لديّ

196
00:14:23,090 --> 00:14:25,460
!إنّك كلبٌ غبيّ

197
00:14:25,460 --> 00:14:30,340
سواءً كانت سلي بيغي أم لا، لا يمكننا الطّلب
!من البشر أن يعقدوا معنا ميثاقًا

198
00:14:31,300 --> 00:14:32,470
ميثاق؟

199
00:14:32,760 --> 00:14:35,430
.إنّه يطلب أن يكون أليفك

200
00:14:35,430 --> 00:14:40,150
وعدٌ مطلق على أنّكما ستشاركان
.كلّ شيء مع بعضكما البعض

201
00:14:40,560 --> 00:14:43,980
.حواسّكما ومشاعركما وحتّى وقتكما

202
00:14:45,070 --> 00:14:46,190
وقت؟

203
00:14:46,900 --> 00:14:49,200
.إن متِّ، فسيموت بدوره

204
00:14:49,660 --> 00:14:50,490
!لا

205
00:14:51,280 --> 00:14:52,320
.لا بأس

206
00:14:52,740 --> 00:14:54,870
.رأيت ما بداخلك، لذا أنا أعلم

207
00:15:01,170 --> 00:15:04,670
أليس عليك انتظار إيزابيل؟

208
00:15:07,510 --> 00:15:09,880
.ها قد وجدتكم

209
00:15:10,470 --> 00:15:11,340
!كارتفيلس

210
00:15:12,260 --> 00:15:16,100
!أخبرتك ألاّ تنادني بهذا الاسم

211
00:15:29,530 --> 00:15:31,070
.إنّك فظيعة

212
00:15:31,450 --> 00:15:34,700
.اعتدت على تلك الذّراع، هذا مزعج

213
00:15:34,990 --> 00:15:37,410
.لن أعيد لك ذراعك

214
00:15:37,740 --> 00:15:41,920
.لا أريد يدًا استُخدمت كمكوّن لمسخ

215
00:15:42,330 --> 00:15:45,170
.تحوّل إلى هيئة الكلب

216
00:15:45,170 --> 00:15:46,420
.هذا يجعله هدفًا أسهل

217
00:15:46,420 --> 00:15:47,840
.أعتمد عليك يا تشيسي

218
00:15:47,840 --> 00:15:50,260
.إن متِّ، فسيموت بدوره

219
00:15:50,260 --> 00:15:52,260
.لا أريده أن يأخذني

220
00:15:52,260 --> 00:15:53,550
.لا أريد أن أكون هنا

221
00:15:53,840 --> 00:15:55,680
...أفضّل أن أكون لك

222
00:15:59,520 --> 00:16:00,640
.لا بأس

223
00:16:01,850 --> 00:16:06,320
.أنا أيضًا لا أريد أن أكون وحيدة بعد الآن

224
00:16:19,790 --> 00:16:21,540
.كرّري كلماتي

225
00:16:23,540 --> 00:16:26,170
.فلترتبطي الآن أيّتها الخيوط الفضيّة

226
00:16:33,050 --> 00:16:37,220
.فلترتبطي الآن يا أوردتنا

227
00:16:39,220 --> 00:16:41,600
.البهشيّة، لكي لا نفترق

228
00:16:44,270 --> 00:16:46,440
.اللّبلاب، لكي لا نتفكّك

229
00:16:47,940 --> 00:16:51,150
.ارتبطي في شجر الطّقسوس سبع مرّات

230
00:16:51,940 --> 00:16:55,360
.حتّى اليوم الّذي تلفظ فيه الأفعى ذيلها

231
00:17:06,670 --> 00:17:10,340
.أعطيني اسمًا جديدًا يا تشيسي

232
00:17:11,670 --> 00:17:14,340
.خذيني إلى جانبك

233
00:17:19,010 --> 00:17:19,930
...تعال

234
00:17:21,350 --> 00:17:22,310
.يا روث

235
00:18:07,770 --> 00:18:09,060
.يا إلهي

236
00:18:09,060 --> 00:18:10,940
.استيقظ من حلم كونه بشريًّا

237
00:18:15,440 --> 00:18:17,950
.تصبحين على خير يا إيزابيل

238
00:18:27,120 --> 00:18:30,670
.انتظريني إلى أن ينتهي وقتي معها

239
00:18:38,680 --> 00:18:39,890
ما هذا؟

240
00:18:39,890 --> 00:18:41,680
.أصبحت مِلكًا لها

241
00:18:42,800 --> 00:18:45,430
.فكّ ميثاق أمرٌ مزعج

242
00:18:45,430 --> 00:18:47,730
لماذا لا تتراجع إذًا؟

243
00:18:47,730 --> 00:18:48,600
.نعم

244
00:18:48,600 --> 00:18:49,850
.سأفعل

245
00:18:50,650 --> 00:18:52,610
ما هذه التّعابير؟

246
00:18:52,610 --> 00:18:56,440
تتعلّم الاستسلام بسرعة
.عندما تعيش لوقتٍ طويل

247
00:18:57,240 --> 00:18:59,740
ما الغاية الّتي تقودك؟

248
00:19:00,950 --> 00:19:03,200
.لأن أعيش بلا معاناة

249
00:19:03,620 --> 00:19:08,290
سئمت من التّعفّن حتّى
.نهاية لا أعلم متى ستأتي

250
00:19:09,410 --> 00:19:10,420
.هذا مؤلم

251
00:19:10,420 --> 00:19:11,290
.يجعلني أعاني

252
00:19:11,540 --> 00:19:12,420
ماذا؟

253
00:19:12,420 --> 00:19:14,670
ولكن لماذا جسدي هكذا؟

254
00:19:15,050 --> 00:19:18,760
لا تمانع أن تجعل الآخرين
يعانون من أجلك رغم ذلك؟

255
00:19:19,550 --> 00:19:20,680
.صحيح

256
00:19:21,010 --> 00:19:24,390
أليست المخلوقات هكذا؟

257
00:19:25,060 --> 00:19:29,180
.لستَ بشريًّا ولا وحشًا إن كان هذا ما تعتقده

258
00:19:29,640 --> 00:19:33,690
.لستَ إلاّ مسخًا في هيئة بشر يا كارتفيلس

259
00:19:36,020 --> 00:19:39,610
.اسمي هو يوسف أيّها الفتى الصّغير

260
00:19:42,910 --> 00:19:43,950
.إلى اللّقاء

261
00:19:48,540 --> 00:19:50,660
.إنّه كالكارثة الطّبيعيّة

262
00:19:51,290 --> 00:19:54,960
.على الأقلّ يمكن معرفة الكوارث

263
00:19:55,590 --> 00:19:57,050
...كارتفيلس

264
00:19:58,670 --> 00:20:04,260
يُقال أنّه لُعن بالعجز عن الموت
.من قِبل ابن الإله

265
00:20:04,890 --> 00:20:11,060
،إنّه مسخ يطوف بلا هدف
.يسير لإشباع فضوله فقط

266
00:20:11,600 --> 00:20:15,480
وما حدث كان نتيجة مراقبتك
من قبل ذلك المسخ؟

267
00:20:17,570 --> 00:20:19,030
ما السّبب؟

268
00:20:19,860 --> 00:20:23,030
.كان سيطير رأسي لو رفضت

269
00:20:23,030 --> 00:20:24,360
.لم يكن لديّ خيار

270
00:20:24,910 --> 00:20:26,120
.فهمت

271
00:20:27,080 --> 00:20:28,290
.أنت

272
00:20:28,700 --> 00:20:30,500
هل التقيت به من قبل؟

273
00:20:30,950 --> 00:20:32,000
به؟

274
00:20:32,000 --> 00:20:33,540
.كلاّ

275
00:20:34,290 --> 00:20:35,210
.فهمت

276
00:20:36,380 --> 00:20:38,420
.كن حذرًا في طريق عودتك

277
00:20:38,420 --> 00:20:40,880
.لا أحتاج قلقك عليّ

278
00:20:42,050 --> 00:20:43,010
.سنعود

279
00:20:43,470 --> 00:20:44,380
!حسنًا

280
00:20:48,390 --> 00:20:49,720
.والآن

281
00:20:49,720 --> 00:20:52,810
.عليّ إيصالهما

282
00:21:12,330 --> 00:21:14,250
.إنّك تعمل بجدّ حقًّا

283
00:21:14,750 --> 00:21:18,750
.وظيفتي هي إيصال الأحياء إلى المستنقع

284
00:21:19,000 --> 00:21:23,760
ولكن وظيفتي أيضًا هي قيادة
.الموتى إلى أبواب الجانب الآخر

285
00:21:24,130 --> 00:21:30,600
هذا اصطناعيّ، ولكنّه سيحمل
.روحًا اصطناعيّة كونه كذلك

286
00:21:38,940 --> 00:21:40,360
!إلى اللّقاء

287
00:21:45,200 --> 00:21:47,700
.حسنًا، لنعد نحن أيضًا

288
00:21:48,200 --> 00:21:50,740
.يمكنني شرح كلّ شيء لك غدًا

289
00:21:51,240 --> 00:21:52,540
.لا بدّ وأنّك متعبة

290
00:21:52,740 --> 00:21:53,750
.نعم

291
00:21:54,450 --> 00:21:56,580
.سيحين وقت توبيخك عندما نعود أيضًا

292
00:21:56,580 --> 00:21:57,580
.حسنًا

293
00:21:58,420 --> 00:21:59,500
.روث

294
00:22:01,340 --> 00:22:04,130
.لنعد إلى المنزل معًا يا روث

295
00:22:07,260 --> 00:22:08,180
.نعم

296
00:22:10,050 --> 00:22:15,480
.منزلك هو منزلي من الآن فصاعدًا

297
00:23:55,950 --> 00:23:57,620
.صديقٌ جديد

298
00:23:57,620 --> 00:24:00,290
.راحة هادئة قصيرة

299
00:24:00,290 --> 00:24:05,590
تطأ قدم الفتاة في حديقة ورود جميلة
.وذهنها ما يزال مثقلاً بمشاكلها

300
00:24:06,290 --> 00:24:09,590
.سآكلك إن تحدّثت عنّي