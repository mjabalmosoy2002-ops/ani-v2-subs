1
00:00:02,810 --> 00:00:07,020
.عشتُ هذه الحياة لمدّة طويلة للغاية

2
00:00:07,360 --> 00:00:09,360
.فهمت. ستذهب

3
00:00:09,690 --> 00:00:10,780
.فلتكن بخير

4
00:00:10,780 --> 00:00:13,320
.انظري، إنّه الفاشل

5
00:00:13,320 --> 00:00:14,610
.لا تتورّطي معه

6
00:00:14,610 --> 00:00:18,080
.هذه ابنتي، أنجليكا

7
00:00:18,530 --> 00:00:19,620
.مرحبًا

8
00:00:19,870 --> 00:00:22,790
.وحش هجين مسكين

9
00:00:23,000 --> 00:00:26,000
سررت بمقابلتك، على الرّغم
.من أنّها قد لا تكون لفترة طويلة

10
00:00:32,550 --> 00:00:34,760
الشّخص الوحيد الّذي ينظر إليّ أنا فقط

11
00:00:36,840 --> 00:00:38,470
.كان أنتِ

12
00:02:17,490 --> 00:02:20,410
.هل سمعت؟ لقد ثار تنّين

13
00:02:20,410 --> 00:02:22,240
أين؟ في لندن؟

14
00:02:22,240 --> 00:02:26,040
.سمعت أنّ طفلة بشريّة قد روّضته

15
00:02:26,040 --> 00:02:27,750
.هذا مثير للإعجاب

16
00:02:27,750 --> 00:02:29,080
من تكون؟

17
00:02:29,920 --> 00:02:33,090
.إنّها السلي بيغي الّتي تستطيع الحديث إلينا

18
00:02:33,380 --> 00:02:35,800
.تفضّلي، أعتمد عليك في هذا

19
00:02:35,800 --> 00:02:36,710
.حسنًا

20
00:02:36,710 --> 00:02:38,010
.انتظري

21
00:02:38,010 --> 00:02:41,760
.سأترك ملحوظة من أجل توري أيضًا

22
00:02:42,430 --> 00:02:44,470
هل أنت بخير؟

23
00:02:44,470 --> 00:02:47,520
.لا أعتقد أنّني نمت بما يكفي منذ ذلك الحين

24
00:02:47,930 --> 00:02:50,140
.لستَ بخير إذًا

25
00:02:50,140 --> 00:02:51,770
أتحتاج شيئًا؟

26
00:02:52,060 --> 00:02:54,610
.زبديّة مليئة بالبطاطا المهروسة

27
00:02:54,610 --> 00:02:56,110
.الكثير من اللّحم المجفف

28
00:02:56,110 --> 00:02:58,820
.كان هناك حساء كرّاث في المقصف اليوم

29
00:02:58,820 --> 00:03:00,660
.كوب كامل

30
00:03:00,660 --> 00:03:01,610
.حسنًا

31
00:03:01,610 --> 00:03:02,660
.شكرًا لك

32
00:03:07,330 --> 00:03:09,660
ماذا كان عليّ فعله أيضًا؟

33
00:03:09,660 --> 00:03:16,550
،اختيار تاريخ لإعادة التّنّين
...والتّواصل معهم، وبعد ذلك

34
00:03:17,340 --> 00:03:19,130
.تبدو متعبًا

35
00:03:20,380 --> 00:03:22,800
.أسمع صوت معلّمي

36
00:03:25,010 --> 00:03:25,930
.ميري

37
00:03:27,350 --> 00:03:28,600
.لينديل

38
00:03:29,100 --> 00:03:33,400
.أنا آسف لإرهاقك هكذا

39
00:03:34,480 --> 00:03:36,440
.كان ذلك ضروريًّا

40
00:03:36,860 --> 00:03:39,070
.لا يمكنك ترك ذلك المكان

41
00:03:39,690 --> 00:03:44,240
ليس إلاّ عندما نجد الحارس
.التّالي، أو تنقرض التّنانين

42
00:03:45,740 --> 00:03:47,990
.إنّك طفلٌ لطيف

43
00:03:48,490 --> 00:03:54,210
.أنا هناك لأنّني لم أحبّ العصر الجديد فحسب

44
00:03:54,920 --> 00:03:56,130
...ولكن

45
00:03:56,130 --> 00:03:57,800
.لا تكن بغاية التّنازل

46
00:03:58,380 --> 00:04:00,340
ما الّذي أخطأتَ به؟

47
00:04:01,420 --> 00:04:05,050
.لم أقدر على أن أصبح ساحرًا

48
00:04:06,550 --> 00:04:09,930
.أردت أن أكون ذا منفعة لك

49
00:04:11,180 --> 00:04:14,650
.أنا فاشل غير مثابر

50
00:04:15,350 --> 00:04:18,820
،إلّم أستطع فعل هذا القدر البسيط

51
00:04:19,150 --> 00:04:24,820
.فلا أملك الحقّ بأن أكون هناك

52
00:04:25,660 --> 00:04:28,240
.أتعب نفسه وأصبح طفلاً

53
00:04:28,700 --> 00:04:30,040
.ما باليد حيلة

54
00:04:30,410 --> 00:04:33,410
.يا إلهي، ذات الشّعر الأحمر أوّلاً، والآن هو

55
00:04:33,410 --> 00:04:35,120
.البشر غريبون

56
00:04:35,120 --> 00:04:38,880
لِمَ لا تهرب وتنسَ ما يضايقك فحسب؟

57
00:04:39,750 --> 00:04:42,880
يبدو الأمر وكأنّهم يبذلون
.الجهد لجعل أنفسهم يعانون

58
00:04:44,050 --> 00:04:48,140
.لن أفهم ذلك مهما كبرت

59
00:04:52,020 --> 00:04:53,770
علينا النّوم فحسب الآن؟

60
00:04:54,140 --> 00:04:55,730
أهذا كلّ شيء؟

61
00:04:55,730 --> 00:04:58,020
.هذه هي الإرشادات في الدّعوة

62
00:04:58,020 --> 00:04:59,440
.علينا فعل ما تنصّ عليه فحسب

63
00:05:00,530 --> 00:05:02,190
.لنتحلّ بالثّقة الآن

64
00:05:39,150 --> 00:05:40,820
.شكرًا على قدومك

65
00:05:41,110 --> 00:05:42,440
.آنسة مارييل

66
00:05:42,440 --> 00:05:45,570
.أرحبّ بكم أيّها اليافعون

67
00:05:46,200 --> 00:05:50,280
.أنا بيليس، كاهنة هذه الطّائفة

68
00:05:50,280 --> 00:05:53,200
.أنا أعمل كشيء مثل المنسّقة

69
00:05:54,290 --> 00:05:57,460
.إنّها متجذّرة

70
00:05:57,710 --> 00:06:00,790
.شكرًا جزيلاً لك على الدّعوة

71
00:06:01,170 --> 00:06:02,750
.شكرًا جزيلاً لك

72
00:06:03,050 --> 00:06:05,670
أخبرتني مارييل أنّكما تبحثان

73
00:06:05,670 --> 00:06:11,800
عن طريقة لتخليصها من اللّعنة
.دون قتل التّنّين

74
00:06:12,600 --> 00:06:13,180
.نعم

75
00:06:14,100 --> 00:06:20,730
.المعذرة، ولكنّنا لا نملك المعرفة لكيفيّة فعل ذلك

76
00:06:21,190 --> 00:06:22,440
!بيوريس

77
00:06:22,440 --> 00:06:26,030
.أقدّر مشاعرك يا مارييل

78
00:06:26,400 --> 00:06:36,910
ولكن، سيكون فظًّا منّا أن نطلب المساعدة
.منهما في حين أنّنا لا نستطيع تلبية أمنيتهما

79
00:06:36,910 --> 00:06:37,790
...ولكن

80
00:06:39,870 --> 00:06:42,000
مساعدة؟

81
00:06:42,460 --> 00:06:50,510
حاولت ختم اللّعنة الّتي تربطني
.بهذه الشّجرة، ولكنّني فشلت

82
00:06:51,390 --> 00:06:58,020
تحاول مارييل استخدام قوّة
.التّنّين خاصّتك لإنقاذي

83
00:06:59,850 --> 00:07:01,060
.لا تبالي بي

84
00:07:01,440 --> 00:07:03,770
.سيهلك جميع النّاس في نهاية المطاف

85
00:07:03,770 --> 00:07:04,730
...ولكن

86
00:07:05,820 --> 00:07:06,730
...المعذرة

87
00:07:10,280 --> 00:07:13,490
.فلتقلقي بشأن نفسك الآن

88
00:07:13,950 --> 00:07:18,750
من الصّواب أن تنقذي نفسك
.قبل أن تنقذي الآخرين

89
00:07:20,710 --> 00:07:23,920
.عشتُ لوقت طويل

90
00:07:23,920 --> 00:07:27,510
حالتي هذه هي شيء كدليل

91
00:07:27,510 --> 00:07:31,680
.لحقيقة أنّني تمكّنت من مدّ يدي للآخرين

92
00:07:31,680 --> 00:07:34,640
.بعضهم لم يكن يستحقّ المساعدة

93
00:07:34,640 --> 00:07:36,260
.بالفعل

94
00:07:36,760 --> 00:07:41,480
ولكن يستحيل علينا معرفة
.ما يخبّئه لنا المستقبل

95
00:07:41,940 --> 00:07:46,610
الجميع حرّ باختيار طريقهم
.الخاصّ وكيف سيسلكونه

96
00:07:49,190 --> 00:07:54,530
هذه الفتاة الشّابّة هناك قد تشفي
.أحدًا آخر من لعنته يومًا ما

97
00:07:54,950 --> 00:08:00,080
.سأظلّ هنا منتظرة تلك الأخبار السّعيدة بلهفة

98
00:08:00,830 --> 00:08:04,750
.قال شخصٌ أعرفه شيئًا مشابهًا

99
00:08:04,750 --> 00:08:08,840
.من اللّطيف معرفة تأييد شخص آخر

100
00:08:09,300 --> 00:08:10,050
.فهمت

101
00:08:10,800 --> 00:08:15,640
،ما دام التّنّين حيًّا، إلّم نفكّر حتّى بقتله

102
00:08:15,640 --> 00:08:19,010
.فلا يمكننا إبطال ولا إرجاع اللّعنة

103
00:08:19,470 --> 00:08:21,520
هل هذا صحيح؟

104
00:08:22,730 --> 00:08:24,810
.على حدّ علمنا

105
00:08:25,980 --> 00:08:29,400
.آسفة على ردّكما بعد قدومكما كلّ هذه المسافة

106
00:08:30,110 --> 00:08:30,990
.على الإطلاق

107
00:08:30,990 --> 00:08:34,570
.أشكرك على السّماح لنا بالانضمام إلى تجمّعكم

108
00:08:37,530 --> 00:08:38,620
...يا ذا الشّوك

109
00:08:39,410 --> 00:08:40,750
...بالنّسبة لاعتذاري

110
00:08:49,300 --> 00:08:53,340
يصعب اختيار واحد على الآخر، أليس كذلك؟

111
00:09:03,310 --> 00:09:06,650
،قد لا نكون استفدنا شيئًا من هذا

112
00:09:08,270 --> 00:09:09,900
.ولكن لنبذل جهدنا

113
00:09:10,650 --> 00:09:11,360
.نعم

114
00:09:11,940 --> 00:09:14,240
.سأذهب للمساعدة في إعداد الفطور

115
00:09:24,160 --> 00:09:28,880
الشّيء الوحيد الّذي يمكنه
.تعويض حياة هو حياة أخرى

116
00:09:39,640 --> 00:09:41,310
هل ستذهب إلى مكان؟

117
00:09:41,890 --> 00:09:47,140
روث، أنت ستختار تشيسي
مهما حصل، أليس كذلك؟

118
00:09:48,810 --> 00:09:49,810
.بالطّبع

119
00:10:00,910 --> 00:10:03,540
أنت موجود، أليس كذلك يا مواطن الرّياح؟

120
00:10:03,540 --> 00:10:04,450
.نعم

121
00:10:05,540 --> 00:10:06,960
.يا لها من ليلة لطيفة

122
00:10:07,460 --> 00:10:10,000
.أعيريني قدرتك على رؤية وشمّ الرّياح

123
00:10:10,000 --> 00:10:11,790
.التهمي قدر ما تشائين

124
00:10:11,790 --> 00:10:13,170
.يا للكرم

125
00:10:13,880 --> 00:10:17,010
.أحبّ مذاقك

126
00:12:10,580 --> 00:12:11,910
آينسورث؟

127
00:12:12,870 --> 00:12:13,920
.سايمون

128
00:12:13,920 --> 00:12:15,630
.أتيت في الوقت المناسب

129
00:12:15,630 --> 00:12:17,500
.أردت إعطاء هذا إلى تشيسي

130
00:12:18,670 --> 00:12:20,970
أكانت هنالك أخبارٌ سارّة؟

131
00:12:21,380 --> 00:12:22,260
لماذا؟

132
00:12:23,180 --> 00:12:25,340
،تبدو وكأنّك صافي الذّهن

133
00:12:25,340 --> 00:12:29,430
.وكأنّ لديك هدفًا في بالك

134
00:12:30,140 --> 00:12:36,190
بدوتَ فاترًا طوال السّنوات
.العشر الّتي عرفتك فيها

135
00:12:40,110 --> 00:12:41,150
.أعتقد ذلك

136
00:12:43,950 --> 00:12:49,580
قد تكون هذه المرّة الأولى
.اّلتي أندفع فيها لتحقيق شيء

137
00:12:51,160 --> 00:12:52,710
!يا إلياس

138
00:12:54,750 --> 00:12:57,380
،أتيت في الوقت المناسب
.كنت سأذهب للّعب للتّوّ

139
00:12:57,380 --> 00:12:59,840
.نعم، إنّه الوقت المناسب فعلاً

140
00:13:01,710 --> 00:13:03,760
.لم يعد هنالك داعٍ لأذهب للبحث عنك

141
00:13:08,350 --> 00:13:14,940
.عدّ، عدّ إلى السّبعة

142
00:13:15,520 --> 00:13:22,230
.في الحلم الّذي ينام الطّفل فيه

143
00:13:22,230 --> 00:13:29,370
.لنجد الأزهار ونعدّها

144
00:13:29,370 --> 00:13:37,330
.ستعطيك والدتك باقةً من الأزهار

145
00:13:43,260 --> 00:13:45,090
.يا لها من رائحة فظيعة

146
00:13:46,510 --> 00:13:47,970
.إيريل

147
00:13:47,970 --> 00:13:49,300
.لم أرك منذ وقت طويل

148
00:13:50,220 --> 00:13:51,850
!أيّتها الغبيّة

149
00:13:52,220 --> 00:13:54,890
ما بال هذا الجسد البشع؟

150
00:13:55,560 --> 00:13:59,190
ما كان لينتهى بك المطاف
.هكذا إن كنتِ قد أتيتِ معي

151
00:13:59,900 --> 00:14:01,070
.يا لك من غبيّة

152
00:14:04,820 --> 00:14:06,320
.هذا لا شيء

153
00:14:06,320 --> 00:14:07,490
.سأكون على ما يرام عمّا قريب

154
00:14:08,360 --> 00:14:11,370
.تبدين وكأنّك ولدتِ من جديد

155
00:14:11,370 --> 00:14:13,700
.قرّرت أن أكون أكثر إيجابيّة

156
00:14:14,120 --> 00:14:15,160
.فتاة جيّدة

157
00:14:19,790 --> 00:14:26,090
إيريل، لم تكوني لتقلقي عليّ لو لم
أكن سلي بيغي، أليس كذلك؟

158
00:14:26,800 --> 00:14:27,930
وإن يكن؟

159
00:14:30,470 --> 00:14:33,430
.يخطّط إلياس لشيء ما

160
00:14:33,930 --> 00:14:35,600
.دون إعلامي

161
00:14:36,140 --> 00:14:37,230
.لوحده

162
00:14:38,350 --> 00:14:40,440
.مع أنّنا اتّفقنا على فعل هذا معًا

163
00:14:41,020 --> 00:14:42,860
.قد يكون روث يشاركه أيضًا

164
00:14:43,820 --> 00:14:44,690
...لذا

165
00:14:46,860 --> 00:14:52,070
،أريد شخصًا سيفعل ما أقوله
.مهما يحدث لي

166
00:14:52,450 --> 00:14:53,280
.الآن

167
00:14:53,780 --> 00:14:55,290
لِمَ أنا؟

168
00:14:56,330 --> 00:15:02,330
،ما تحبينه هو سلي بيغي، وليس أنا تحديدًا
وإلاّ ما كنتِ لتقفي مع إلياس، أليس كذلك؟

169
00:15:04,670 --> 00:15:10,130
لستِ مخطئة، لكنّني أحبّك
.أنتِ نفسك أيضًا يا تشيسي

170
00:15:10,130 --> 00:15:11,550
.شكرًا لك

171
00:15:11,550 --> 00:15:14,560
.أعتقد أنّ هذا يعني أنّه لا يمكنني إعطاؤك العمل

172
00:15:14,560 --> 00:15:18,060
هل ستقولين نفس الكلام لشخص آخر غيري؟

173
00:15:18,060 --> 00:15:20,140
.مستحيل

174
00:15:21,810 --> 00:15:24,690
ما الّذي تنوي فعله يا إلياس؟

175
00:15:25,190 --> 00:15:27,030
.تشيسي لن تصمد

176
00:15:27,690 --> 00:15:33,070
.هذه الطّريقة الوحيدة لكي لا نفقدها

177
00:15:33,950 --> 00:15:35,950
ما رأيك يا روث؟

178
00:15:37,080 --> 00:15:39,540
.الإجابة واضحة

179
00:15:43,210 --> 00:15:44,040
—إليا

180
00:15:44,460 --> 00:15:45,130
!ستيلا

181
00:15:45,590 --> 00:15:46,090
—لماذا

182
00:15:46,340 --> 00:15:47,340
.أنا آسف

183
00:15:53,930 --> 00:15:55,050
...إلياس

184
00:15:56,390 --> 00:15:57,560
...روث

185
00:15:58,520 --> 00:15:59,310
.آسف

186
00:15:59,930 --> 00:16:04,400
كلّ شيء سيكون على
.ما يرام عندما تستيقظين

187
00:16:07,320 --> 00:16:09,940
...لا... تفعل

188
00:16:19,290 --> 00:16:20,500
.نيفين

189
00:16:20,500 --> 00:16:22,040
.لا تقلقي

190
00:16:22,500 --> 00:16:26,040
.ستتمكّنين من الوقوف واللّحاق به

191
00:16:26,040 --> 00:16:31,050
.قدرتك على فعل ذلك تنمو

192
00:16:32,510 --> 00:16:35,640
.ولكنّني خائفة للغاية

193
00:16:36,800 --> 00:16:39,140
.لا أعلم ما الّذي سأجده عندما ألحق به

194
00:16:39,640 --> 00:16:42,270
...ما يحاول إلياس فعله

195
00:16:43,230 --> 00:16:44,770
لِمَ يفعل هذا؟

196
00:16:45,440 --> 00:16:47,560
.لا يهمّ

197
00:16:47,560 --> 00:16:53,650
ما يهمّ هو أن تكوني واضحة
.دائمًا فيما يجب عليك فعله

198
00:16:57,570 --> 00:17:00,790
لِمَ دائمًا ما تأتي إليّ؟

199
00:17:01,330 --> 00:17:05,120
.لستُ أقودك على الإطلاق

200
00:17:05,790 --> 00:17:11,630
أنا الّذي يوجد هنا هو أنا الّذي
.سمحتِ له بالبقاء داخل عقلك

201
00:17:12,380 --> 00:17:16,220
.أنتِ من تقودين نفسك

202
00:17:19,050 --> 00:17:22,810
.لا ينبغي عليك إغراق نفسك في المصاعب

203
00:17:23,230 --> 00:17:27,900
.طيري قويّة عبر المحيطات العاصفة

204
00:17:29,190 --> 00:17:33,320
ما الّذي قرّرتِ أنّه ينبغي عليك فعله؟

205
00:17:33,740 --> 00:17:37,320
.عليّ أوّلاً معرفة ما يحاول إلياس فعله

206
00:17:37,910 --> 00:17:41,160
.فلتمضي قدمًا

207
00:17:52,460 --> 00:17:58,140
سيكون كلّ شيء على ما يرام حين
أستيقظ في حين لم أفعل شيئًا؟

208
00:17:59,590 --> 00:18:04,600
لم يحدث لي أيّ شيء سحريّ
.إلى هذه الدّرجة من قبل

209
00:18:10,900 --> 00:18:11,940
.سيلكي

210
00:18:16,780 --> 00:18:17,950
.شكرًا لك

211
00:18:32,130 --> 00:18:33,210
.روث

212
00:18:33,210 --> 00:18:34,300
.أحضر تشيسي

213
00:18:34,300 --> 00:18:35,130
.حسنًا

214
00:18:35,880 --> 00:18:37,010
.إنّها مستيقظة

215
00:18:38,470 --> 00:18:40,140
.هذا غريب

216
00:18:42,510 --> 00:18:45,930
دعوتَني وحشًا، وتفعل هذا الآن؟

217
00:18:46,220 --> 00:18:47,180
...أنت

218
00:18:48,980 --> 00:18:51,440
!إلياس

219
00:18:51,440 --> 00:18:56,440
إن كنتُ وحشًا لخدمة
،نفسي على حساب الآخرين

220
00:18:57,440 --> 00:19:00,240
!فإنّك وحشٌ أيضًا كما توقّعت

221
00:19:01,410 --> 00:19:02,530
!إلياس

222
00:19:09,160 --> 00:19:10,870
!ساعديني يا تشيسي

223
00:19:11,170 --> 00:19:12,330
.ستيلا

224
00:19:12,330 --> 00:19:15,880
.يريد إلياس التّضحية بي مكانك

225
00:19:16,300 --> 00:19:19,300
.قال أنّه سينقل لعنتك لي

226
00:19:20,840 --> 00:19:22,760
.سيقتلني

227
00:19:23,350 --> 00:19:26,600
.ابتعدي عنها يا تشيسي

228
00:19:26,600 --> 00:19:27,520
...إنّها

229
00:19:27,520 --> 00:19:28,390
.إلياس

230
00:19:30,310 --> 00:19:33,980
حقًّا يا إلياس؟

231
00:19:44,910 --> 00:19:47,660
.سألحق بك لاحقًا يا ستيلا

232
00:19:47,660 --> 00:19:49,750
.اركضي إلى أبعد ما تستطيعين

233
00:19:49,750 --> 00:19:51,210
!حـ-حسنًا

234
00:19:51,210 --> 00:19:52,460
.تشيسي

235
00:19:52,460 --> 00:19:53,830
.لا تقترب منّي

236
00:19:54,840 --> 00:19:56,130
.وأنت لا تذهب أيضًا

237
00:20:02,720 --> 00:20:03,260
.آسف

238
00:20:03,680 --> 00:20:05,600
بشأن ماذا؟

239
00:20:06,100 --> 00:20:10,060
.لمحاولة التّضحية بستيلا مكانك

240
00:20:13,150 --> 00:20:19,110
!أردتك أن تجعلني أفكّر بهذا معك

241
00:20:20,030 --> 00:20:22,490
.لم أعدك بشيء

242
00:20:24,910 --> 00:20:25,740
...مـ

243
00:20:26,660 --> 00:20:27,870
...ما الّذي

244
00:20:30,040 --> 00:20:32,330
قرّرت أنّه إن كان ينبغي
.فعل ذلك، فستكون ستيلا

245
00:20:33,370 --> 00:20:37,840
إنّك تنظرين نحو ستيلا بتعابير
.تختلف عن نظراتك لي

246
00:20:38,340 --> 00:20:40,340
.لا يمكنني تحمّل ذلك

247
00:20:40,800 --> 00:20:43,680
...لمجرّد هذا

248
00:20:44,840 --> 00:20:48,560
.سأكون سعيدًا طالما حييتِ

249
00:20:59,820 --> 00:21:01,900
...أنت أيضًا في نهاية المطاف

250
00:21:05,160 --> 00:21:06,410
.إيريل

251
00:21:06,410 --> 00:21:07,070
!تشيسي

252
00:21:08,660 --> 00:21:09,950
.لن تذهب إلى مكان

253
00:21:12,500 --> 00:21:13,960
.أيّها الأحمق

254
00:21:17,710 --> 00:21:18,960
.ستيلا

255
00:21:22,840 --> 00:21:23,760
...كار

256
00:21:24,420 --> 00:21:25,720
...يوسف

257
00:21:27,470 --> 00:21:29,970
.ماذا؟ لقد عرفتِ

258
00:21:29,970 --> 00:21:32,680
لِمَ تفعل هذا بستيلا؟

259
00:21:33,180 --> 00:21:34,850
.لنعقد صفقة

260
00:21:34,850 --> 00:21:36,190
صفقة؟

261
00:21:36,690 --> 00:21:44,030
سأعطيك تعويذة تدرأ موتك
،المحتوم إن وافقتِ

262
00:21:44,030 --> 00:21:46,070
.وسأعيد هذه الفتاة

263
00:21:46,070 --> 00:21:46,780
ما رأيك؟

264
00:21:47,530 --> 00:21:49,240
...إلّم تفعلي

265
00:21:50,740 --> 00:21:51,910
تفهمين، أليس كذلك؟

266
00:21:52,700 --> 00:21:53,830
!تشيسي

267
00:21:55,290 --> 00:21:57,790
.هيّا، سيلحقان بنا

268
00:21:59,380 --> 00:22:00,920
ماذا ستفعلين؟

269
00:22:02,420 --> 00:22:02,920
.تشيسي

270
00:22:12,640 --> 00:22:16,560
.لا أستطيع البقاء بجانبك كما أنت الآن

271
00:23:55,780 --> 00:23:58,700
.تفترق الفتاة عن السّاحر

272
00:23:58,700 --> 00:24:04,170
.تلحق يوسف إلى الكابوس الّذي يعذبها

273
00:24:04,830 --> 00:24:06,250
.سامحيني

274
00:24:06,800 --> 00:24:09,340
.سامحيني يا تشيسي