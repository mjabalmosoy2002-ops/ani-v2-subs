1
00:02:04,100 --> 00:02:07,730
أخبرتك أن تجلب الفساد لي، أليس كذلك؟

2
00:02:08,140 --> 00:02:10,390
تواجه كلّ هذه الصّعوبة لمجرّد مهمة بسيطة؟

3
00:02:11,600 --> 00:02:13,230
.حسنًا، لا يهمّ

4
00:02:13,230 --> 00:02:16,360
.تمكّنت من مصادفته على غير المتوقّع

5
00:02:16,690 --> 00:02:20,400
،إن كنت لا تريد أن تصبح تلميذتك مكوّنًا

6
00:02:20,400 --> 00:02:21,910
.فلا تخفق في المرّة القادمة

7
00:02:29,500 --> 00:02:34,040
لماذا تستمع لما يقوله ذلك المختلّ يا معلّمي؟

8
00:02:34,540 --> 00:02:36,050
!لقد سلب منك حتّى يدك

9
00:02:39,010 --> 00:02:41,680
.لا داعي لأن تقلقي على شيء

10
00:02:41,680 --> 00:02:44,100
.يجب على المعلّم أن يحمي تلميذته

11
00:02:44,890 --> 00:02:46,060
.ثقي بي

12
00:02:46,060 --> 00:02:47,140
...ولكن

13
00:02:47,470 --> 00:02:48,770
.لا بأس

14
00:02:48,770 --> 00:02:50,140
.لديّ خطة

15
00:02:53,900 --> 00:02:57,730
ألم يكن من المفترض أن أحميك؟

16
00:03:13,920 --> 00:03:16,590
.بتلة نبتة يبروح واحدة

17
00:03:21,630 --> 00:03:22,590
.أرجوك

18
00:03:26,640 --> 00:03:30,220
.ضجّ، ضجّ في غابة اللّيل

19
00:03:30,220 --> 00:03:33,690
.غنّ، غنّ، أيّها الزّعرور اليافع

20
00:03:34,150 --> 00:03:38,070
.دع شوكك يخرق الحوافر الغازية

21
00:03:45,780 --> 00:03:46,490
.تشيسي

22
00:03:47,330 --> 00:03:51,080
متى تعتقدين أنّ بإمكانك إنهاء طلب
السّيّدة العجوز في أسفل التّلّ؟

23
00:03:51,080 --> 00:03:57,210
انتهيت للتّوّ من مزج نصف لتر من الجنجل
.وخمسة أوراق من الخُزامي لوسادة الأرق

24
00:03:57,210 --> 00:04:00,880
.وهذه جرعة مسحورة لطرد الكوابيس

25
00:04:02,300 --> 00:04:03,970
.كما علّمتك

26
00:04:11,850 --> 00:04:15,060
.استعملتِ الكثير من السّحر
.أصبح جرعة نوم

27
00:04:15,060 --> 00:04:17,730
.ابذلي جهدك أكثر في النِّسب

28
00:04:17,730 --> 00:04:18,690
.حسنًا

29
00:04:23,320 --> 00:04:24,900
.هذا صعب

30
00:04:25,910 --> 00:04:30,540
منذ أن عرفت هدفه، يبدو أنّ إلياس قد قرر

31
00:04:30,540 --> 00:04:33,870
.أن يبدأ بتعليمي السّحر بجدّ

32
00:04:35,040 --> 00:04:41,710
،ماذا يؤثّر على ماذا، ما الّذي سيساعد
...وما الّذي يجب تجنبه

33
00:04:42,420 --> 00:04:46,340
.تقاليد قديمة غريبة

34
00:04:47,090 --> 00:04:50,300
.أشياء يمكن أن تكون طبّيّة وسامّة في آنٍ واحد

35
00:04:55,520 --> 00:04:58,860
...بقّ الصّوف، سلمندر

36
00:05:00,110 --> 00:05:02,440
.سنخرج قليلاً يا تشيسي

37
00:05:03,900 --> 00:05:05,030
.حسنًا

38
00:05:10,990 --> 00:05:12,660
كلب أسود؟

39
00:05:13,330 --> 00:05:14,080
.نعم

40
00:05:14,580 --> 00:05:17,040
.يُعرف أيضًا بروح الكنيسة الحالكة

41
00:05:17,710 --> 00:05:20,630
.كلب مراقبة ممتاز يحمي الكنيسة والمقبرة

42
00:05:21,000 --> 00:05:23,380
.يبدو أنّه جعل من كنيسة مجاورة منزلاً له

43
00:05:24,090 --> 00:05:28,720
.مهمّتنا هي معرفة ما إن كان عدائيًّا أم لا

44
00:05:29,930 --> 00:05:32,260
أيمكن أن تكون عدائيّة؟

45
00:05:32,720 --> 00:05:34,890
.لا خطر منها ما دامت لم تفعلي شيئًا

46
00:05:35,310 --> 00:05:36,430
.عادةً

47
00:05:36,980 --> 00:05:38,230
عادةً؟

48
00:05:38,730 --> 00:05:40,610
.هذه المرّة الثّالثة

49
00:05:40,610 --> 00:05:42,230
.طلبهم الأخير

50
00:05:43,980 --> 00:05:46,110
...لماذا تقوم الكنيسة

51
00:05:46,530 --> 00:05:50,110
لماذا يطلبون منك القيام بأمور كهذه؟

52
00:05:52,530 --> 00:05:55,490
.ارتكبت خطأً في السّابق

53
00:05:56,040 --> 00:05:57,620
.إنّهم يراقبونني منذ ذلك الحين

54
00:05:58,460 --> 00:06:00,630
،لا أحبّ التّعامل معهم

55
00:06:00,630 --> 00:06:04,840
لذا فإنّي أعتني ببعض أمورهم مقابل
.أن يتركوني وشأني

56
00:06:06,460 --> 00:06:12,550
بالتّفكير في الأمر، نادى ذلك
.الرّجل إلياس باسم مختلف

57
00:06:13,850 --> 00:06:15,770
.بيلوم مورياليس

58
00:06:16,930 --> 00:06:19,810
.هناك الكثير ممّا لا أعرفه عنه

59
00:06:20,350 --> 00:06:22,190
.صحيح، نسيت

60
00:06:22,190 --> 00:06:23,230
.تشيسي

61
00:06:26,530 --> 00:06:29,280
.طلبت من أنجليكا أن تصنع هذا لك

62
00:06:33,530 --> 00:06:34,580
خاتم؟

63
00:06:38,250 --> 00:06:41,830
تعرفين سبب قصر عمر سلي بيغي، صحيح؟

64
00:06:42,290 --> 00:06:49,050
أجسادنا ضعيفة على الرّغم من قدرتنا العالية
على صنع وامتصاص السّحر، صحيح؟

65
00:06:49,380 --> 00:06:50,220
.نعم

66
00:06:55,850 --> 00:06:58,180
.ولكن لا يمكن للخاتم فعل الكثير

67
00:06:58,560 --> 00:07:03,020
.سيعمل بنشاطٍ أكبر كما حال جسدك إن انفعلتِ

68
00:07:03,440 --> 00:07:06,610
.لذا كوني هادئة قدر استطاعتك

69
00:07:07,480 --> 00:07:08,190
.حسنًا

70
00:07:09,820 --> 00:07:10,990
.لا بأس

71
00:07:10,990 --> 00:07:13,200
.أنا مسؤول عنك كوني من اشتراك

72
00:07:13,200 --> 00:07:15,580
.سأبحث عن حلولٍ أفضل

73
00:07:16,740 --> 00:07:18,240
.شكرًا جزيلاً لك

74
00:07:27,380 --> 00:07:30,130
.إصبع السّبّابة الأيمن هو الإصبع المُرشد

75
00:07:30,130 --> 00:07:33,380
ملاحظة، لستِ مستعدّة لخاتم
!إصبع السّبّابة الأيسر بعد

76
00:07:36,350 --> 00:07:40,930
.لم يقل إلياس شيئًا عمّا حدث منذ ذلك الحين

77
00:07:42,020 --> 00:07:42,940
.تشيسي

78
00:07:43,480 --> 00:07:44,850
.نعم

79
00:07:52,240 --> 00:07:56,490
.أريد تعيين أليف لك بسرعة في الحقيقة

80
00:07:56,490 --> 00:07:57,780
أليف؟

81
00:07:57,780 --> 00:08:01,870
.مخلوق يستهلك سحر سيّده ويخدمه

82
00:08:01,870 --> 00:08:03,660
،إنّه مفيد ومخلص

83
00:08:03,660 --> 00:08:05,420
.وقد يكون خادمًا ممتازًا

84
00:08:06,210 --> 00:08:08,420
مثل ذلك الّذي عند أنجي-سان؟

85
00:08:09,670 --> 00:08:13,050
إنّهم يصبحون مألوفين مع أسيادهم
.أكثر من الأسياد أنفسهم

86
00:08:13,050 --> 00:08:17,180
إنّهم ملائمين تمامًا لمساندة
.شخصٍ هادئٍ مثلك

87
00:08:17,640 --> 00:08:19,640
.آ-آسفة

88
00:08:20,560 --> 00:08:21,930
.انظري، وصلنا

89
00:08:22,680 --> 00:08:24,520
.تلك هي الكنيسة

90
00:08:34,610 --> 00:08:36,700
هل حدث شيء ما؟

91
00:08:38,910 --> 00:08:40,120
إلياس؟

92
00:08:42,620 --> 00:08:46,080
.قد يكون هذا أمرًا مزعجًا

93
00:08:46,710 --> 00:08:48,630
.قد يكون من الأفضل إن أسرعنا

94
00:08:49,250 --> 00:08:52,050
.سأذهب للحديث مع المسؤول

95
00:08:52,460 --> 00:08:55,300
.ألقي نظرة على المكان

96
00:08:55,840 --> 00:08:57,970
.أعلميني إن وجدتِ شيئًا

97
00:08:58,550 --> 00:09:00,140
.لا تخاطري بنفسك

98
00:09:00,640 --> 00:09:01,470
.حسنًا

99
00:09:02,140 --> 00:09:03,850
.هيّا، اذهبوا

100
00:09:03,850 --> 00:09:05,770
.هذا فظيع

101
00:09:05,770 --> 00:09:08,190
.إنّهم معضوضين ومخدوشين في كلّ مكان

102
00:09:08,190 --> 00:09:10,770
أكان هنالك كلاب مسعورة هنا؟

103
00:09:10,770 --> 00:09:13,990
.لا تنظري

104
00:09:33,300 --> 00:09:36,720
.هنالك شيءٌ سيّئ ينمو هنا

105
00:09:40,510 --> 00:09:46,600
من أين أنتِ؟

106
00:09:46,600 --> 00:09:47,600
أين؟

107
00:09:46,930 --> 00:09:49,350
.هذا أحد السّيّئين

108
00:09:47,600 --> 00:09:49,350
إلى أين ستذهبين؟

109
00:09:49,350 --> 00:09:52,440
أين؟

110
00:09:50,270 --> 00:09:52,480
.لا يجب أن أجيب سؤاله

111
00:09:53,320 --> 00:09:55,820
إلى من أعطي القميص بلا درز؟

112
00:09:56,280 --> 00:09:58,990
.إن أجبت على شيء واحد فسيأخذني

113
00:09:59,820 --> 00:10:00,950
.عليّ الهرب

114
00:10:02,530 --> 00:10:05,750
تساهلت لأنّ إلياس كان معي
.طوال الوقت مؤخرًا

115
00:10:05,750 --> 00:10:07,330
إلى أين تذهبين؟

116
00:10:07,330 --> 00:10:12,130
إلى أين؟

117
00:10:08,250 --> 00:10:09,250
من أين؟

118
00:10:12,130 --> 00:10:12,920
من أين؟

119
00:10:12,920 --> 00:10:14,590
من أين؟ إلى أين؟

120
00:10:16,170 --> 00:10:17,090
.إيزابيل

121
00:10:17,300 --> 00:10:18,800
!إلى أين؟

122
00:10:24,560 --> 00:10:26,310
.اغرب عن وجهي أيّها القمامة

123
00:10:36,070 --> 00:10:39,570
.هذا الشّخص... ليس إنسانًا

124
00:10:40,400 --> 00:10:44,200
.هذا المكان غير آمن لشخص بمثل حساسيّتك

125
00:10:45,330 --> 00:10:46,490
.عودي إلى المنزل بسرعة

126
00:10:46,490 --> 00:10:48,120
...ا-المعذرة

127
00:10:48,120 --> 00:10:49,120
—شكرًا جزيلاً لـ

128
00:10:50,460 --> 00:10:51,790
!ما الخطب؟

129
00:11:04,510 --> 00:11:05,930
...هذه الجروح

130
00:11:07,520 --> 00:11:08,600
.إلياس

131
00:11:09,100 --> 00:11:10,480
.عليّ مناداة إلياس

132
00:11:10,890 --> 00:11:13,100
أم هل أعالجه بالدّواء الّذي أملكه؟

133
00:11:14,230 --> 00:11:18,990
.أنتِ تشبهين إيزابيل

134
00:11:20,570 --> 00:11:21,700
.صحيح

135
00:11:22,240 --> 00:11:23,110
.إيزابيل

136
00:11:25,660 --> 00:11:26,450
...جروحك

137
00:11:32,670 --> 00:11:37,380
...إيزابيل

138
00:11:47,470 --> 00:11:49,930
...كلب أسود

139
00:12:09,790 --> 00:12:16,290
...إيزابيل

140
00:12:17,670 --> 00:12:18,710
.لا

141
00:12:19,710 --> 00:12:20,380
.انتظر

142
00:12:20,380 --> 00:12:24,550
من الخطر أن تتحرّك بكلّ هذه
!الجروح حتّى ولو كنت جنيًّا

143
00:13:06,930 --> 00:13:09,970
.جروح عض وعلامات تمزّق

144
00:13:11,100 --> 00:13:13,390
.مثل تلك الجثّة

145
00:13:13,720 --> 00:13:16,140
.لم يكن هو من فعلها

146
00:13:16,140 --> 00:13:16,810
.أنتِ

147
00:13:17,480 --> 00:13:19,110
.سلّمي ذلك الكلب

148
00:13:22,860 --> 00:13:24,780
.أنتِ من قابلتها سابقًا

149
00:13:24,780 --> 00:13:27,490
.لا شأن لي معك

150
00:13:28,110 --> 00:13:31,370
.سلّمي ذلك الكلب بسرعة، هذا كلّ ما أطلبه

151
00:13:31,370 --> 00:13:32,910
هذه ليست مشكلة بالنّسبة لك، أليس كذلك؟

152
00:13:32,910 --> 00:13:35,410
.لقد ساعدني

153
00:13:35,750 --> 00:13:37,830
.لذا أرفض ما لم تملكي سببًا وجيهًا

154
00:13:39,330 --> 00:13:41,040
!سلّميه فحسب

155
00:13:41,040 --> 00:13:42,590
!عليّ أخذه

156
00:13:43,590 --> 00:13:46,090
—ما الّذي فعلتِه

157
00:13:51,390 --> 00:13:56,770
أخفقت في صنعه، ولكنّه قد يكون
.ذا جدوى ضدّ البشر

158
00:13:59,150 --> 00:14:02,360
.يوليس

159
00:14:05,740 --> 00:14:06,650
.تعال

160
00:14:10,160 --> 00:14:14,330
ما الخطب يا إيزابيل، هل سخروا
منك لامتلاكك شعرًا أحمر ثانيةً؟

161
00:14:14,700 --> 00:14:17,120
.على الرّغم من أنّه جميل بلون غروب الشّمس

162
00:14:19,250 --> 00:14:23,590
.سأحبّك مهما كان لون شعرك

163
00:14:32,850 --> 00:14:33,970
...إيزابيل

164
00:14:47,570 --> 00:14:48,690
استيقظت؟

165
00:14:49,450 --> 00:14:51,450
.إنّي أحرق طارد الجنّيّات

166
00:14:51,450 --> 00:14:53,280
.سيتركنا الغريبون لوحدنا

167
00:14:54,580 --> 00:14:55,620
أين نحن؟

168
00:14:56,330 --> 00:14:58,500
.في غابة قريبة

169
00:14:59,910 --> 00:15:01,870
هل جروحك بخير؟

170
00:15:01,870 --> 00:15:04,040
...وضعت دواءً عليها، ولكن

171
00:15:07,380 --> 00:15:09,420
.تذكّريني بأختي الصّغيرة

172
00:15:10,010 --> 00:15:11,220
أختك؟

173
00:15:11,630 --> 00:15:12,840
.إيزابيل

174
00:15:13,430 --> 00:15:17,640
كان لديها شعر بلون غروب الشّمس
.وعينان كبذرات الرّبيع

175
00:15:18,060 --> 00:15:19,770
.كانت بنفس طولك تقريبًا

176
00:15:20,940 --> 00:15:25,610
إن كنتما قد أضعتما بعضكما، فإنّ المكان
...هنا خطر، لذا سأساعدك بالبحث

177
00:15:25,610 --> 00:15:26,570
.لا داعي لذلك

178
00:15:27,360 --> 00:15:29,190
.إنّها نائمة تحت التّراب

179
00:15:29,940 --> 00:15:32,320
هل يعني أنّها ميتة؟

180
00:15:33,660 --> 00:15:35,700
.إنّك كلب غريب

181
00:15:36,030 --> 00:15:36,870
كلب؟

182
00:15:42,710 --> 00:15:44,710
.أنا وإيزابيل كلانا إنسان

183
00:15:46,920 --> 00:15:50,550
.كنت أحميها منذ أن كانت صغيرة

184
00:15:51,220 --> 00:15:52,340
.يوليس

185
00:15:52,970 --> 00:15:53,930
.دائمًا

186
00:15:54,510 --> 00:15:58,680
.لطالما اعتقدت أنّها ستناديني بصوتها

187
00:16:00,310 --> 00:16:04,190
.قابلت شخصًا مثلك في السّابق

188
00:16:08,360 --> 00:16:11,150
هل استطاع أن يكون مع من يحبّ؟

189
00:16:12,240 --> 00:16:14,280
.يمكنك قول ذلك

190
00:16:14,530 --> 00:16:17,030
.ولكن يمكنك قول العكس أيضًا

191
00:16:17,280 --> 00:16:18,330
ما معنى هذا؟

192
00:16:19,370 --> 00:16:21,450
من أين أصبت بتلك الجروح؟

193
00:16:21,950 --> 00:16:23,000
.لا أعلم

194
00:16:26,750 --> 00:16:28,250
هل أنتِ بخير؟

195
00:16:29,800 --> 00:16:32,550
.أنا مسرورة أنّ الدّواء لا يدوم طويلاً

196
00:16:35,680 --> 00:16:37,430
—ما الّذي تعتقدين أنّك

197
00:16:39,680 --> 00:16:42,020
أليس-سان، صحيح؟

198
00:16:42,310 --> 00:16:45,310
.أخفتِني قليلاً، لذا ربطت معصميك

199
00:16:52,110 --> 00:16:52,780
.سحقًا

200
00:17:03,960 --> 00:17:07,040
ألن تفعلي شيئًا؟

201
00:17:07,040 --> 00:17:10,340
.ليس لديّ سبب لفعل شيء بك

202
00:17:11,750 --> 00:17:12,760
...إذًا

203
00:17:12,760 --> 00:17:14,420
حسنًا، هل يمكنني طرح سؤال عليك؟

204
00:17:14,670 --> 00:17:16,800
لماذا تريدينه؟

205
00:17:17,260 --> 00:17:20,930
.وفقًا لعلّتك، قد أتمكّن من فكّ قيدك

206
00:17:26,020 --> 00:17:28,190
.أحتاجه كعنصر خامّ لصنع كيميرا

207
00:17:28,770 --> 00:17:29,730
عنصر؟

208
00:17:30,150 --> 00:17:31,730
أتعرفين ما هي كيميرا؟

209
00:17:32,650 --> 00:17:37,070
إنّها مخلوقات تُخلق بدمج
.مخلوقين باستخدام السّحر

210
00:17:37,070 --> 00:17:42,200
طفلٌ غريب ما أتى لنا طالبًا منّا
.مساعدته في البحث عن عنصرٍ له

211
00:17:44,950 --> 00:17:46,750
.رفض معلّمي

212
00:17:47,620 --> 00:17:49,540
.ولكن لم يكن هنالك ما أمكنه فعله

213
00:17:50,880 --> 00:17:52,960
.لا يهمّني ما يحدث لي

214
00:17:57,010 --> 00:17:58,970
أنت تحبّينه، أليس كذلك؟

215
00:17:58,970 --> 00:17:59,550
!بالطّبع

216
00:18:03,060 --> 00:18:07,020
.لم يحدث لي شيءٌ جيّد مذ ولدت

217
00:18:08,230 --> 00:18:13,110
.ولكن لديّ بعض الموهبة، لذا احتضنني معلّمي

218
00:18:14,320 --> 00:18:15,780
ينطبق عليك نفس الشّيء، أليس كذلك؟

219
00:18:17,700 --> 00:18:24,490
.لستُ ذكيّة، ولكنّي سأفعل أيّ شيء لمعلّمي

220
00:18:26,000 --> 00:18:30,330
.أتساءل ما هو شعوري نحوه

221
00:18:31,330 --> 00:18:34,210
.لديه دوافع خفيّة ولكنّه لطيف

222
00:18:34,590 --> 00:18:36,710
.إنّه مهمٌّ بالنّسبة لي

223
00:18:37,340 --> 00:18:41,300
وفي نهاية المطاف، لا يمكنني
.الاستمرار بحياتي إن طردني

224
00:18:42,390 --> 00:18:44,850
.لا يهمّ ذلك

225
00:18:44,850 --> 00:18:45,930
.أعطيتك سببي

226
00:18:45,930 --> 00:18:47,310
!والآن فكّي قيدي

227
00:18:52,560 --> 00:18:54,940
.فهمت ما يجري

228
00:18:55,690 --> 00:18:58,150
!كنتِ تخفينه عنّي

229
00:18:58,150 --> 00:18:59,070
.آسفة

230
00:18:59,070 --> 00:19:01,200
هل رينفريد موجودٌ قريبًا من هنا؟

231
00:19:01,200 --> 00:19:03,280
!أتيت إلى هنا لوحدي

232
00:19:03,280 --> 00:19:03,910
...معلّمي

233
00:19:05,910 --> 00:19:07,910
.أنت، أيّها السّاحر

234
00:19:08,500 --> 00:19:11,120
لماذا أنتما هنا؟

235
00:19:11,120 --> 00:19:13,420
.لنفحص ذاك الّذي هناك

236
00:19:14,420 --> 00:19:16,960
ساحر؟ يفحصني؟

237
00:19:16,960 --> 00:19:17,880
لماذا؟

238
00:19:19,130 --> 00:19:22,640
.لقد استيقظ ككلب أسود حديثًا

239
00:19:23,840 --> 00:19:26,060
.ذاك ليس بمشكلة

240
00:19:26,060 --> 00:19:27,140
ذاك؟

241
00:19:27,140 --> 00:19:27,970
.آسفة

242
00:19:28,390 --> 00:19:29,310
وإذًا؟

243
00:19:29,310 --> 00:19:33,980
.كما قلت، هناك طفلٌ غريب يهدّدنا

244
00:19:34,360 --> 00:19:36,440
.سلب يد معلّمي أيضًا

245
00:19:37,980 --> 00:19:39,240
.لا عجب في ذلك

246
00:19:40,490 --> 00:19:41,650
.أرجوك

247
00:19:41,650 --> 00:19:43,450
.افعل شيئًا بأمره

248
00:19:43,870 --> 00:19:45,660
وما منفعتنا من ذلك؟

249
00:19:45,660 --> 00:19:48,910
.لديه كيميرا يجولون في الأرجاء بالفعل

250
00:19:49,370 --> 00:19:53,500
تلك الجثّة في المقدّمة وجروح
.الكلب من فعل الكيميرا خاصّته

251
00:19:54,500 --> 00:19:58,420
،إن ورّطت نفسك بأمر الكلب
.فستكون قطتك في خطرٍ أيضًا

252
00:20:01,420 --> 00:20:03,010
ألم يكن ذلك سببًا جيّدًا؟

253
00:20:03,970 --> 00:20:05,890
.حسنًا، لا أمانع

254
00:20:06,680 --> 00:20:09,390
ما ذلك الصّوت الواهي؟

255
00:20:09,390 --> 00:20:13,980
.لا، لم أعتقد أنّك ستوافق بسرعة

256
00:20:14,400 --> 00:20:18,940
إن تركته في الأرجاء، فستأتي الكنيسة
.لتشتكي لي لاحقًا في كلّ الأحوال

257
00:20:19,530 --> 00:20:22,740
إذًا ما صفات ذلك "الطّفل"؟

258
00:20:24,240 --> 00:20:26,240
.لا أعرف جيّدًا

259
00:20:26,240 --> 00:20:30,750
.يبدو كالطّفل، ولكنّي أرى العديد من الأمور تتداخل

260
00:20:31,080 --> 00:20:32,660
.كأنّه ضبابيّ

261
00:20:33,410 --> 00:20:35,120
...لديه

262
00:20:34,170 --> 00:20:35,120
ما الخطب؟

263
00:20:37,210 --> 00:20:38,750
.تكشيرة مخيفة

264
00:20:39,420 --> 00:20:40,880
—ما الّذي

265
00:20:59,440 --> 00:21:02,780
.جرو رينفريد غير مُدرّب جيّدًا

266
00:21:03,280 --> 00:21:05,530
.أفشت عن كلّ شيء

267
00:21:06,110 --> 00:21:06,950
!أنت

268
00:21:06,950 --> 00:21:08,070
ماذا؟

269
00:21:08,570 --> 00:21:10,200
هل أصبت الشّخص الخطأ؟

270
00:21:11,910 --> 00:21:14,830
ولكن، ما يهمّ بذلك؟

271
00:21:14,830 --> 00:21:18,210
تلك الفتاة مجرّد فأر تجارب، أليس كذلك؟

272
00:21:18,710 --> 00:21:22,710
.لأنّ من المستحيل أن تتعلّق أنت بإنسان

273
00:21:23,670 --> 00:21:27,470
أليس كذلك يا بيلوم مورياليس؟

274
00:21:40,270 --> 00:21:44,400
.قال معلّمي أنّه ساحرٌ من قصّة خياليّة

275
00:21:47,910 --> 00:21:52,030
،يمدّ يد العون في بعض الأحيان
.ويكشّر عن أنيابه في أحيانٍ أخرى

276
00:21:56,960 --> 00:22:00,130
.قال أنّه غير كامل ويحاول الادّعاء أنّه بشريّ

277
00:22:01,750 --> 00:22:02,710
.كلاّ

278
00:22:03,340 --> 00:22:05,800
.إنّه ليس هجينًا

279
00:22:06,760 --> 00:22:10,720
.لا يمكن لهذا الشّيء أن يصبح بشريًّا أبدًا

280
00:23:58,080 --> 00:24:00,330
.يصبح السّاحر وحشًا

281
00:24:00,330 --> 00:24:05,420
.باستسلامه لغضبه، يُظهر غرائزه الوحشيّة

282
00:24:05,750 --> 00:24:09,460
.تصل الفتاة المجروحة لقرار

283
00:24:09,840 --> 00:24:10,880
!إلياس