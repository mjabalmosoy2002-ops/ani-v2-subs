1
00:01:34,740 --> 00:01:35,820
...إيزابيل

2
00:01:36,820 --> 00:01:40,450
.بدأت بالاعتياد على حياتي الجديدة

3
00:01:41,780 --> 00:01:43,200
ماذا عنك؟

4
00:01:46,410 --> 00:01:48,330
هل تنامين جيّدًا؟

5
00:02:08,480 --> 00:02:10,440
.هذا خطر يا روث

6
00:02:10,440 --> 00:02:13,940
آ-آسف، كنت سعيدًا للغاية لدرجة
.أنّي لم أستطع كبح نفسي

7
00:02:14,820 --> 00:02:16,610
.مرحبًا بعودتك يا روث

8
00:02:17,450 --> 00:02:19,410
.لقد عدت يا تشيسي

9
00:02:21,990 --> 00:02:23,490
.فضيّة

10
00:02:23,490 --> 00:02:24,660
كيف حال إلياس؟

11
00:02:27,910 --> 00:02:29,620
ما يزال بنفسه حالته؟

12
00:02:31,170 --> 00:02:36,630
.يبدو أنّ الإفطار جاهز يا إلياس

13
00:02:40,470 --> 00:02:41,550
.آسف

14
00:02:42,220 --> 00:02:45,970
أيمكنك إخبار فضيّة أنّي لست
بحاجة للأكل اليوم أيضًا؟

15
00:02:48,230 --> 00:02:49,940
.أتساءل ما خطبه

16
00:02:50,480 --> 00:02:54,940
مرّ أسبوعان منذ أن عدنا من الكنيسة
.ولم يخرج من غرفته منذ ذلك الحين

17
00:02:55,730 --> 00:02:58,900
لماذا لا تفتحين الباب وتسألين؟

18
00:03:06,410 --> 00:03:08,040
.لنذهب يا روث

19
00:03:11,210 --> 00:03:15,550
.ربّما التّحوّل من ذاك القتال أضرّه

20
00:03:15,550 --> 00:03:16,710
تحوّل؟

21
00:03:16,710 --> 00:03:20,380
ربّما تغيير هيئتك يستهلك الكثير من الطّاقة؟

22
00:03:21,180 --> 00:03:23,140
لماذا تقول هذا كسؤال؟

23
00:03:23,550 --> 00:03:25,560
.لا يمكنني التّذكّر جيّدًا

24
00:03:25,560 --> 00:03:29,560
.ربّما لم أستوعب جيّدًا بعد أنّي جنّيّ

25
00:03:31,900 --> 00:03:33,610
هل استقررت الآن؟

26
00:03:33,980 --> 00:03:36,360
.كنت تستكشف الملكيّة طوال الوقت

27
00:03:37,860 --> 00:03:39,940
.إنّه شيء ضروري

28
00:03:39,940 --> 00:03:41,110
.بشكلٍ غريزيّ

29
00:03:41,910 --> 00:03:43,410
كونك كلب؟

30
00:03:43,410 --> 00:03:45,830
.لا أريد الاعتراف بهذا، ولكن نعم

31
00:03:57,170 --> 00:03:58,380
ما هذا؟

32
00:03:59,880 --> 00:04:01,420
.ا-انتظري، سيلكي

33
00:04:01,420 --> 00:04:02,800
ما الأمر يا تشيسي؟

34
00:04:10,810 --> 00:04:15,230
.لا أفهم ما الّذي حدث للتّوّ، ولكنّنا طُردنا

35
00:04:17,480 --> 00:04:19,110
".من أجل بعض التّغيّير"

36
00:04:19,730 --> 00:04:22,450
".عودا قبل حلول الظّلام"

37
00:04:23,200 --> 00:04:25,620
.يبدو أنّها أعطتنا مصروفًا

38
00:04:25,620 --> 00:04:26,910
.يبدو كذلك

39
00:04:29,120 --> 00:04:33,040
.ولكن أتساءل ما إن كان لا بأس من الخروج الآن

40
00:04:33,830 --> 00:04:35,210
.أنا معك

41
00:04:35,580 --> 00:04:38,590
!لم أرك منذ وقت طويل يا تشيسي

42
00:04:38,880 --> 00:04:40,380
.آنسة أنجليكا

43
00:04:40,710 --> 00:04:42,380
كيف حالك؟

44
00:04:42,380 --> 00:04:43,340
.مرحبًا يا روبين

45
00:04:44,180 --> 00:04:45,180
...المعذرة

46
00:04:45,840 --> 00:04:47,760
...إنّ إلياس الآن

47
00:04:49,350 --> 00:04:52,100
.لا، لم آتي من أجله

48
00:04:52,560 --> 00:04:54,850
.أريد معرفة كيف حالك

49
00:04:55,350 --> 00:04:56,560
هل لديك بعض الوقت؟

50
00:05:29,140 --> 00:05:30,640
.اشتريتِ الكثير

51
00:05:30,640 --> 00:05:37,650
لا يمكنني شراء هدايا لسيلكي، ولكنّي آمل
.أن أجد شيئًا يمكنها استعماله في المنزل

52
00:05:37,650 --> 00:05:38,980
.هذا يبدو جيّدًا

53
00:05:39,610 --> 00:05:41,900
حسنًا، هل يمكنني أن أرى؟

54
00:05:45,860 --> 00:05:48,160
.يبدو أنّها تعمل على ما يرام

55
00:05:48,530 --> 00:05:49,870
كيف تشعرين؟

56
00:05:50,490 --> 00:05:51,910
.لا شيء غير معتاد

57
00:05:51,910 --> 00:05:54,080
.إنّها تنام طوال الوقت

58
00:05:54,080 --> 00:05:54,870
!روث

59
00:05:55,160 --> 00:05:58,120
.تبدين متعبة بعد استعمال السّحر خصوصًا

60
00:06:03,170 --> 00:06:06,050
تعلّمي الاعتماد على الآخرين
...وإلاّ سيحدث أمرٌ مريع

61
00:06:06,630 --> 00:06:08,890
.حين تصبحين لوحدك يومًا ما

62
00:06:09,930 --> 00:06:12,060
.لا بدّ وأنّك أليف تشيسي

63
00:06:12,060 --> 00:06:13,010
.شكرًا لك

64
00:06:13,510 --> 00:06:15,270
.تبدين كشخصٍ جيّد

65
00:06:17,350 --> 00:06:20,060
.لا تحاولي فعل كلّ شيء لوحدك

66
00:06:20,060 --> 00:06:23,440
وإلاّ ما فائدة كون لديك جيرانًا مفيدين؟

67
00:06:26,030 --> 00:06:29,660
.أنتِ سريعة الانفعال، لكنّ قلبك ضعيف

68
00:06:30,280 --> 00:06:32,990
.لذا عليك الاعتناء بجسدك

69
00:06:34,620 --> 00:06:37,410
.سأفعل ما بوسعي

70
00:06:41,170 --> 00:06:43,500
بالمناسبة، ماذا عن المدرسة؟

71
00:06:44,000 --> 00:06:48,050
.يمكن أن تذهبي إلى المدرسة في عمرك هذا

72
00:06:48,050 --> 00:06:49,430
.لا أعلم

73
00:06:50,680 --> 00:06:53,050
.عليّ الاعتناء بالورود والأعشاب

74
00:06:53,050 --> 00:06:55,350
،دراسة السّحر صعبة

75
00:06:55,350 --> 00:06:59,850
لكن لدي أمور لأؤدّيها وأدرسها
.في الصّيف وفي الشّتاء

76
00:07:00,850 --> 00:07:06,610
قدرتي على العيش مع إلياس
.والبقيّة كافٍ بالنّسبة لي

77
00:07:07,740 --> 00:07:11,490
أليس هذا اتّكالاً يا تشيسي؟

78
00:07:13,870 --> 00:07:15,330
.أنتِ يافعة

79
00:07:15,660 --> 00:07:17,250
.ما زال لديك وقتٌ طويل

80
00:07:17,870 --> 00:07:20,250
.لا يمكنك أكل ما يُقدّم لك فحسب

81
00:07:22,170 --> 00:07:24,750
.لقد اشتُريتِ من قِبل آينسورث

82
00:07:25,380 --> 00:07:28,670
،أعلم أنّك عانيت وقتا عصيبًا في مكان آخر

83
00:07:29,170 --> 00:07:32,590
.ولكنّك لستِ مضطرّة لأن تكوني ملزمة به

84
00:07:36,310 --> 00:07:38,020
.أ-أنا آسفة

85
00:07:38,020 --> 00:07:39,730
.لم أقصد ذلك

86
00:07:39,730 --> 00:07:41,020
.أنا آسفة

87
00:07:41,020 --> 00:07:43,440
.لا، أنا قلت أكثر من اللاّزم

88
00:07:43,440 --> 00:07:44,610
.هذا غير صحيح

89
00:07:46,860 --> 00:07:48,650
.أعلم أنّك محقة

90
00:07:52,070 --> 00:07:53,240
.أنا آسفة

91
00:07:59,040 --> 00:08:01,040
.آسفة بشأن اليوم

92
00:08:01,040 --> 00:08:05,210
.لا، شكرًا لك على الاهتمام بي

93
00:08:06,170 --> 00:08:08,550
.لا تكوني فتاةً جيّدة أكثر من اللاّزم

94
00:08:09,380 --> 00:08:11,930
.إلى اللّقاء يا روبين، وأيّها الجديد

95
00:08:20,140 --> 00:08:23,140
.أنا جبانة

96
00:08:23,980 --> 00:08:27,480
.أعتمد على شخص لا يتوقّع شيئًا منّي

97
00:08:27,980 --> 00:08:33,530
،أقول لنفسي أنّي لا أمانع أن يُتخلّى عنّي
.مع ذلك لا أريد هذا

98
00:08:35,780 --> 00:08:39,160
.أنا أنانيّة

99
00:08:45,170 --> 00:08:49,840
كنت أكره العودة إلى المنزل حين
.تكون الأضواء مشتعلة

100
00:08:51,300 --> 00:08:52,090
.تشيسي

101
00:08:52,510 --> 00:08:54,510
ماذا يا روث؟

102
00:08:55,550 --> 00:09:00,100
.أشارك القليل من العديد من الأشياء معك

103
00:09:00,640 --> 00:09:01,390
.نعم

104
00:09:01,850 --> 00:09:05,980
.حواسك، مشاعرك، حتّى ذكرياتك

105
00:09:08,690 --> 00:09:16,240
.أريد أن تنقلع لعنة تلك الحادثة بسرعة

106
00:09:17,120 --> 00:09:17,950
.نعم

107
00:09:18,830 --> 00:09:19,700
.شكرًا لك

108
00:09:25,250 --> 00:09:26,370
.لقد عدت

109
00:09:29,290 --> 00:09:31,090
.شكرًا لك على المصروفات

110
00:09:31,380 --> 00:09:36,180
اشتريت بعض الهدايا— بل أعني
.بعض الشّاي والحلويات لنا

111
00:09:39,600 --> 00:09:40,810
كيف حال إلياس؟

112
00:09:45,980 --> 00:09:47,190
،إلياس

113
00:09:47,520 --> 00:09:49,020
هل أنت بخير؟

114
00:10:10,670 --> 00:10:14,010
إلياس، أين أنت؟

115
00:10:14,010 --> 00:10:14,960
—إليا

116
00:10:14,960 --> 00:10:15,760
!تشيسي

117
00:10:19,470 --> 00:10:21,510
.أنا آسف يا تشيسي

118
00:10:21,930 --> 00:10:24,310
.لا يمكنني التّحكّم بجسدي جيّدًا

119
00:10:24,970 --> 00:10:29,190
.قد يكون مخيفًا، ولكن دعيني أبقى هكذا

120
00:10:31,360 --> 00:10:36,490
هل ستشرح لي عندما يحلّ الصّباح؟

121
00:10:37,490 --> 00:10:38,240
.نعم

122
00:10:38,610 --> 00:10:39,700
.لا تقلقي

123
00:10:48,920 --> 00:10:50,880
.جسدٌ غير بشريّ

124
00:10:51,790 --> 00:10:52,920
،أطراف

125
00:10:53,800 --> 00:10:54,710
،وجه

126
00:10:55,800 --> 00:10:56,550
.رقبة

127
00:10:58,050 --> 00:11:00,090
سبب عدم خوفي هو ربّما

128
00:11:03,260 --> 00:11:05,810
.لأنّي ملعونة

129
00:11:23,740 --> 00:11:27,120
.لم يكن ينبغي أن أنجبك

130
00:11:33,170 --> 00:11:34,130
...إلياس

131
00:11:36,710 --> 00:11:37,960
إلياس؟

132
00:12:05,870 --> 00:12:07,490
.صباح الخير يا سيلكي

133
00:12:08,200 --> 00:12:09,790
هل رأيت إلياس؟

134
00:12:11,120 --> 00:12:12,250
.حسنًا

135
00:12:13,080 --> 00:12:15,670
.حان وقت الإفطار يا روث

136
00:12:18,880 --> 00:12:20,550
.شكرًا لك يا سيلكي

137
00:12:43,860 --> 00:12:45,110
.تشيسي-كن

138
00:12:45,110 --> 00:12:46,570
.سررت لقدومك

139
00:12:46,570 --> 00:12:48,700
هل أنت على ما يرام الآن؟

140
00:12:48,700 --> 00:12:50,790
.نعم، الفضل يعود لك

141
00:12:51,250 --> 00:12:52,210
.ابتعد

142
00:12:52,210 --> 00:12:53,920
.تبدو مزيّفًا

143
00:12:55,040 --> 00:12:57,790
لماذا صغرت يا روث؟

144
00:12:58,210 --> 00:13:00,840
.يسهل عليّ التّحرّك معك بهذه الهيئة

145
00:13:01,170 --> 00:13:02,510
.فهمت

146
00:13:02,510 --> 00:13:04,260
.لا بدّ وأنّك أليفها

147
00:13:04,720 --> 00:13:06,640
.لديك أخ كبير جيّد الآن

148
00:13:06,640 --> 00:13:08,260
...تحديق

149
00:13:09,310 --> 00:13:11,980
هل رأيت إلياس؟

150
00:13:12,230 --> 00:13:13,850
آينسورث؟

151
00:13:14,520 --> 00:13:16,400
—آسف، ولكن لم

152
00:13:16,400 --> 00:13:18,770
.شكرًا لك

153
00:13:18,770 --> 00:13:20,480
لحظة، بهذه السّرعة؟

154
00:13:20,480 --> 00:13:23,150
!أعتقد أنّك ترثين صفاته كثيرًا

155
00:13:26,530 --> 00:13:29,280
أين هو؟

156
00:13:31,040 --> 00:13:33,330
.إنّك تحبينه حقًّا

157
00:13:34,000 --> 00:13:36,040
لـ-لماذا؟

158
00:13:36,250 --> 00:13:38,290
.إنّك تخافين رحيله

159
00:13:38,630 --> 00:13:41,380
.ولكن ما أكثر من ذلك هو أنّك قلقة

160
00:13:42,260 --> 00:13:43,300
...لكن

161
00:13:43,670 --> 00:13:45,720
لماذا تحاولين إنكار ذلك؟

162
00:13:46,050 --> 00:13:49,510
.من المهمّ أن تحبّي شيئًا غير نفسك

163
00:13:51,510 --> 00:13:57,400
.هذا مهمّ من أجل حماية ذاك الشّيء ومن أجلك أيضًا

164
00:13:58,400 --> 00:14:02,280
.أحبّك، وسأحب إيزابيل دومًا

165
00:14:02,940 --> 00:14:04,570
ألا يمكن ذلك؟

166
00:14:07,910 --> 00:14:11,080
.أتمنّى لو أنّه كان بهذه البساطة

167
00:14:11,830 --> 00:14:13,580
.إنّك مكابرة

168
00:14:20,290 --> 00:14:22,420
.آه، مرحبًا

169
00:14:22,840 --> 00:14:24,420
.مرحبًا

170
00:14:24,800 --> 00:14:26,670
.لم أراكما من قبل

171
00:14:26,670 --> 00:14:29,090
.انتقلنا إلى هنا مؤخرًا

172
00:14:29,510 --> 00:14:31,470
هكذا إذًا؟

173
00:14:31,470 --> 00:14:34,430
إنّه ناءٍ، ولكنّه مكان جيّد، أليس كذلك؟

174
00:14:34,430 --> 00:14:38,690
.تعالا لرؤية حديقتي إن كنتما مهتمّان

175
00:14:38,690 --> 00:14:41,860
.ستكون الملكات سعيدات أيضًا

176
00:14:43,400 --> 00:14:45,650
.أنتِ سلي بيغي

177
00:14:45,650 --> 00:14:46,780
!هذا غير معتاد

178
00:14:47,700 --> 00:14:50,620
.سآكلك إن تحدّثتِ عنّي

179
00:14:50,910 --> 00:14:52,120
.ليانان شي

180
00:14:52,410 --> 00:14:56,250
.إنّها مصّاصة دماء تمنح رجلاً الموهبة مقابل دمه

181
00:14:56,250 --> 00:14:59,540
.وأنت مجرّد جرو

182
00:14:59,540 --> 00:15:02,710
ألا يفترض أن تكونين مهتمّة بمن هم أصغر سنًّا؟

183
00:15:03,040 --> 00:15:05,460
.سيموت هذا الشّخص فورًا إذا مصصتِ دمه

184
00:15:05,460 --> 00:15:08,170
.أنتِ هي زوجة ذا الشّوك إذًا

185
00:15:08,170 --> 00:15:09,050
.تلميذته

186
00:15:10,010 --> 00:15:11,300
!أنت

187
00:15:12,430 --> 00:15:14,760
ما رأيكما أن تحتسيا الشّاي؟

188
00:15:15,930 --> 00:15:17,980
.اذهبي لترتاحي قليلاً يا تشيسي

189
00:15:18,480 --> 00:15:21,310
.تبدين شاحبة الوجه من قلّة النّوم

190
00:15:21,650 --> 00:15:22,770
.سأخبرك إن وجدته

191
00:15:22,770 --> 00:15:23,570
.روث

192
00:15:24,440 --> 00:15:27,320
.سأمزّقك إربًا إن عبثتِ معها يا مصّاصة الدّماء

193
00:15:32,030 --> 00:15:38,500
أعيش لوحدي، كنت أودّ أن يحتسي
.أحدهم الشّاي معي

194
00:15:38,910 --> 00:15:41,460
.أنا جويل غارلاند

195
00:15:41,460 --> 00:15:42,710
ماذا عنك؟

196
00:15:43,080 --> 00:15:44,880
.تشيسي هاتوري

197
00:15:45,630 --> 00:15:47,340
.هذه مجموعة كتب مذهلة

198
00:15:47,340 --> 00:15:48,460
.أحبّ الكتب

199
00:15:49,170 --> 00:15:51,130
.أكتب بنفسي أحيانًا

200
00:15:51,130 --> 00:15:52,890
.هذا ممتعٌ كثيرًا

201
00:15:53,430 --> 00:15:57,390
لديّ قصّة قصيرة في الواقع، هل يمكنك قراءتها؟

202
00:15:57,390 --> 00:16:01,270
...آه، ولكن

203
00:16:01,270 --> 00:16:03,650
أليس لديك وقت؟

204
00:16:04,360 --> 00:16:06,570
.لست جيّدة بالقراءة

205
00:16:06,570 --> 00:16:08,990
.قد يستغرق ذلك وقتًا طويلاً

206
00:16:08,990 --> 00:16:10,610
.لا أمانع

207
00:16:26,290 --> 00:16:28,880
.كانت قصّة حبّ

208
00:16:29,590 --> 00:16:33,640
.قصّة بسيطة عن شخصان تقابلا في حديقة ورود

209
00:16:34,180 --> 00:16:36,930
.ولكن كان هنالك شيءٌ يثير الحنين بها

210
00:16:46,900 --> 00:16:48,860
كانت قصّة جميلة، أليس كذلك؟

211
00:16:49,280 --> 00:16:55,530
.نعم، ولكن لم يبد أنّك أعطيته الموهبة

212
00:16:58,870 --> 00:17:00,620
لماذا تتملّكينه؟

213
00:17:00,950 --> 00:17:02,660
.لستِ تأخذين دمه أيضًا

214
00:17:03,750 --> 00:17:10,510
شعرت أنّ أعيننا تقابلت في
.ذلك اليوم في غابة الورود

215
00:17:16,430 --> 00:17:18,100
!إنّه ليس نوعي المفضّل

216
00:17:18,100 --> 00:17:20,680
!إنّه عجوز ونحيف للغاية

217
00:17:22,020 --> 00:17:26,190
ليس لديه شيء يكرّس حياته له
،أو شيء من ذاك القبيل أيضًا

218
00:17:27,310 --> 00:17:29,440
.لذا لا يمكنني أخذ دمه

219
00:17:30,070 --> 00:17:32,030
.ولا يمكنني إعطاؤه ما يمكنني

220
00:17:33,700 --> 00:17:35,700
.لا أعلم ما أفعل

221
00:17:37,570 --> 00:17:42,830
.ربّما تفهمين شعوري بما أنّك إنسانة

222
00:17:46,960 --> 00:17:49,840
.آسف، لا أصدّق أنّ النّعاس غلبني

223
00:17:50,170 --> 00:17:52,170
.أشعر بالنّوم كثيرًا مؤخّرًا

224
00:17:52,760 --> 00:17:56,970
هل كانت تلك القصّة عن الورود الّتي هنا؟

225
00:17:57,800 --> 00:17:58,970
.كشفتِني

226
00:18:00,680 --> 00:18:04,730
رأيت شخصًا جميلاً جدًّا هنا
.ذات مرّة هنا قبل زمنٍ بعيد

227
00:18:05,060 --> 00:18:08,980
،ربّما تكون مجرد أحلام يقظة
....ولكن لا بدّ وأنّها

228
00:18:20,280 --> 00:18:21,240
سيّد جويل؟

229
00:18:21,830 --> 00:18:24,540
.لا شيء

230
00:18:26,250 --> 00:18:29,710
.شعرت أنّ عينانا تقابلت قبل قليل ثانيةً

231
00:18:30,040 --> 00:18:31,590
أكان ذلك بسببك؟

232
00:18:36,050 --> 00:18:38,550
—هل تحبّيـ

233
00:18:40,930 --> 00:18:43,850
.تلك ليست الإجابة الّتي أبتغيها

234
00:18:43,850 --> 00:18:47,140
.نحن نحبّ بالالتهام والوهب

235
00:18:47,810 --> 00:18:50,560
.لذا لا أحبّه

236
00:18:53,150 --> 00:18:54,820
.تعالي لزيارته ثانيةً

237
00:18:54,820 --> 00:18:56,860
.سيسعده ذلك

238
00:18:56,860 --> 00:18:58,660
.حسنًا

239
00:19:08,670 --> 00:19:13,340
إنّها ليست كلمة أنا جديرة بقولها
.بينما كلّ ما أفكّر به هو نفسي

240
00:19:13,630 --> 00:19:14,420
.تشيسي

241
00:19:14,920 --> 00:19:15,760
.روث

242
00:19:15,760 --> 00:19:16,920
.وجدته

243
00:19:18,470 --> 00:19:20,680
.إنّه في الغابة شمال المنزل

244
00:19:43,780 --> 00:19:44,870
.هناك

245
00:20:02,260 --> 00:20:03,260
.تشيسي

246
00:20:03,800 --> 00:20:06,850
.من الخطر أن تأتي إلى الغابة في الغسق

247
00:20:06,850 --> 00:20:08,810
.تركت لك ملحوظة أنّي سأعود في اللّيل

248
00:20:08,810 --> 00:20:13,270
لن تقوم بإخباري بشيء، صحيح؟

249
00:20:13,940 --> 00:20:19,490
سبب حدوث هذا، أيّ نوعٍ من
...المخلوقات تكون

250
00:20:20,740 --> 00:20:23,740
.دائمًا ما تتجنّبني حين أسأل

251
00:20:24,410 --> 00:20:27,040
.إنّك سريعة الفهم دائمًا

252
00:20:28,240 --> 00:20:31,660
.قبلتِ ما قلته دون مساءلتي

253
00:20:32,120 --> 00:20:33,460
...هذا لا يعني

254
00:20:34,130 --> 00:20:36,670
،مهما كنتُ أنانيّة

255
00:20:37,300 --> 00:20:42,630
ليس وكأنّي لست مهتمّة بك لدرجة
.أنّ بإمكاني تحمّل عدم معرفة شيء عنك

256
00:20:43,800 --> 00:20:45,930
.لم أرَ تعابيرك هذه من قبل

257
00:20:47,100 --> 00:20:49,890
أكنت أبدو غريبة؟

258
00:20:50,230 --> 00:20:52,230
.نعم، لم أرك هكذا من قبل

259
00:20:52,980 --> 00:20:55,150
أكنتِ تبحثين عنّي طوال الوقت؟

260
00:20:55,150 --> 00:20:56,860
.مع أنّي تركت لك ملحوظة

261
00:20:58,320 --> 00:20:58,820
ماذا؟

262
00:20:58,820 --> 00:20:59,900
.وجهك مخيف

263
00:21:00,400 --> 00:21:04,160
أتخبرني أن أقبل تلك الملحوظة
وأتركك مع كلّ ما يجري؟

264
00:21:04,490 --> 00:21:09,990
قد أقبل كلّ ما تقوله، ولكن
...إن اختفيت فجأة هكذا

265
00:21:12,250 --> 00:21:14,920
لماذا كنت تستريح هنا؟

266
00:21:15,250 --> 00:21:17,790
.جسدي غير متّزن

267
00:21:17,790 --> 00:21:20,340
.كنت هنا لضبطه

268
00:21:21,800 --> 00:21:24,220
.نصف ما يقوله كذب

269
00:21:24,220 --> 00:21:24,800
.ربّما

270
00:21:25,470 --> 00:21:28,600
.لم أمانع تضليله للأمور من قبل

271
00:21:29,100 --> 00:21:31,470
لِمَ أنا خائفة إلى هذا الحدّ الآن؟

272
00:21:34,440 --> 00:21:39,070
أيمكنك إعطائي بعض الوقت لأخبرك عنّي؟

273
00:21:40,150 --> 00:21:42,820
.أريد وقتًا لجمع أفكاري

274
00:21:46,780 --> 00:21:48,870
.سأنتظر إذًا

275
00:21:50,830 --> 00:21:52,120
هل أنتِ غاضبة؟

276
00:21:52,120 --> 00:21:53,910
.لستُ غاضبة

277
00:21:53,910 --> 00:21:55,040
.لست غاضبة

278
00:21:55,040 --> 00:21:57,080
ما الّذي تفكّرين به إذًا؟

279
00:21:57,380 --> 00:21:59,090
...أخبرتك، لست

280
00:21:59,500 --> 00:22:00,880
!خذ

281
00:22:02,760 --> 00:22:04,420
!إلياس

282
00:22:05,720 --> 00:22:06,970
جنّيّة؟

283
00:22:07,760 --> 00:22:09,850
.أليفة محاكاة

284
00:22:10,640 --> 00:22:15,350
لديّ رسالة من لينديل-ساما تقول
".من ليندينباوم  إلى ذي الشّوك"

285
00:22:15,350 --> 00:22:18,560
لديّ بعض الأمور مع الطّفلة الّتي"
"...أرعاها. تعال بسرعة

286
00:22:20,400 --> 00:22:22,440
".تعالا بسرعة إلى أرض التّنانين"

287
00:23:55,830 --> 00:23:58,790
.تزور الفتاة أرض التّنانين للمرّة الثّانية

288
00:23:58,790 --> 00:24:03,420
وتتعرّف هناك على جانب
.من السّاحر لم تعرفه من قبل

289
00:24:03,420 --> 00:24:08,300
.أتى ذلك بشكلٍ مؤكّد كقدوم اللّيل