19
00:02:57,900 --> 00:02:58,980
.توري

20
00:02:58,980 --> 00:03:00,030
ما خطبكما؟

21
00:03:00,030 --> 00:03:02,070
.كلاكما تبدوان في حالة فظيعة

22
00:03:02,070 --> 00:03:03,820
ألا يمكنك القدوم إلى هنا بهدوء أكثر؟

23
00:03:04,070 --> 00:03:06,240
.أنتما تشربان

24
00:03:06,240 --> 00:03:08,790
.دعاني أشارككما

25
00:03:08,790 --> 00:03:10,660
.لم أسمح لك بلمسه

26
00:03:11,120 --> 00:03:13,000
ألم تصلح يدك بعد؟

27
00:03:13,750 --> 00:03:16,500
كان اسمه كارتفيلس؟

28
00:03:16,500 --> 00:03:18,000
هل تواصلت معه منذ ذلك الحين؟

29
00:03:18,300 --> 00:03:19,090
.لا

30
00:03:19,090 --> 00:03:20,380
.إنّك محظوظ

31
00:03:20,380 --> 00:03:22,380
.قدّمني إليه

32
00:03:22,380 --> 00:03:24,090
.ها نحن أولاء ثانيةً

33
00:03:24,090 --> 00:03:26,510
مشعوذ يرتحل لقرون؟

34
00:03:26,720 --> 00:03:29,390
.الحياة الأبديّة موضوع خالد

35
00:03:29,390 --> 00:03:30,890
.يا له من حلم سخيف

36
00:03:30,890 --> 00:03:32,480
.إنّك متعجرف حقًّا

37
00:03:32,480 --> 00:03:34,520
.ذكيّ، لكنّك ستكسب أعداءً هكذا

38
00:03:34,520 --> 00:03:37,020
.لا أحتاج إلاّ لأشخاصٍ قليلين إلى جانبي

39
00:03:37,650 --> 00:03:39,780
...على أيّ حال، على أيّ حال

40
00:03:39,230 --> 00:03:41,530
!هذا كثير يا توري

41
00:03:41,530 --> 00:03:44,530
!بربّك، لا بأس بالقليل

42
00:03:44,530 --> 00:03:46,030
!لا

43
00:03:46,030 --> 00:03:48,490
.لستُ ذكيًّا

44
00:03:49,950 --> 00:03:54,500
ما كنت لأسمح لنفسي بأن أُهدّد
.من قِبله لو كنت ذكيًّا

45
00:03:56,170 --> 00:03:57,460
!ما هذا؟

46
00:03:57,460 --> 00:03:58,540
!هذا مضحك للغاية

47
00:03:58,540 --> 00:04:02,210
.سيستمرّ هذا لأربع ساعات أخرى. حظًّا موفقًا

48
00:04:02,210 --> 00:04:02,920
ما هذا؟

49
00:04:02,920 --> 00:04:04,010
.إنّه مزعج للغاية

50
00:04:04,220 --> 00:04:05,590
!اشرب معي

51
00:04:05,930 --> 00:04:06,970
!ساعدني

52
00:04:06,970 --> 00:04:08,720
!لا تسحبني

53
00:04:11,310 --> 00:04:12,180
ماذا؟

54
00:04:12,180 --> 00:04:15,940
ما هذا، ليس أدولف فحسب؟

55
00:04:16,270 --> 00:04:17,440
.ميريتولي

56
00:04:17,440 --> 00:04:18,440
جنيّة؟

57
00:04:18,440 --> 00:04:20,400
.إنّه أليف سيّدي السّابق

58
00:04:55,350 --> 00:04:56,310
...لندن

59
00:04:58,310 --> 00:05:01,520
.ما هذا؟ أشعر بأنّني مترنّحة

60
00:05:01,860 --> 00:05:03,280
.لا أكح أيضًا

61
00:05:04,280 --> 00:05:06,530
.لا أشعر بالدّفء ولا بالبرد

62
00:05:14,830 --> 00:05:16,960
هل أنت بخير؟

63
00:05:16,960 --> 00:05:17,410
!هذا مؤلم

64
00:05:20,540 --> 00:05:22,630
.آسف، شكرًا لك

65
00:05:23,670 --> 00:05:24,960
.كارتفيلس

66
00:05:25,970 --> 00:05:29,260
تعرفين اسمي؟

67
00:05:30,720 --> 00:05:31,680
ماذا؟

68
00:05:31,680 --> 00:05:33,060
...اسمي

69
00:05:33,060 --> 00:05:35,180
أكان اسمي كارتفيلس؟

70
00:05:38,600 --> 00:05:41,610
.يمكنني الرّؤية من خلالك يا آنسة

71
00:05:41,610 --> 00:05:43,070
هل أنتِ شبح؟

72
00:05:44,610 --> 00:05:48,570
.عليك الذّهاب إلى حيث تنتمين

73
00:05:49,610 --> 00:05:50,280
صحيح؟

74
00:05:53,280 --> 00:05:56,870
لأنّ غير ذلك غريب، أليس كذلك؟

75
00:05:57,250 --> 00:05:58,160
...أنا

76
00:06:10,010 --> 00:06:11,300
!هذا مؤلم

77
00:06:11,300 --> 00:06:12,720
!مؤلم

78
00:06:13,390 --> 00:06:14,600
!أنا آسف

79
00:06:14,600 --> 00:06:17,980
!آسف! آسف! آسف

80
00:06:17,980 --> 00:06:18,810
...ولكن

81
00:06:19,730 --> 00:06:21,060
...ولكن، هو

82
00:06:21,060 --> 00:06:21,980
—كارتا

83
00:06:21,980 --> 00:06:24,320
!لا أملك اسمًا ملعونًا كهذا

84
00:06:25,320 --> 00:06:26,280
...كارتفيلس

85
00:06:30,780 --> 00:06:31,860
...أنا

86
00:06:32,700 --> 00:06:35,280
.أنا يوسف

87
00:06:36,990 --> 00:06:38,120
.ساعديني

88
00:06:39,580 --> 00:06:42,830
.سامحني يا كارتفيلس

89
00:06:44,040 --> 00:06:47,670
ماذا علينا أن نفعل لنُنقَذ؟

90
00:06:58,810 --> 00:07:00,640
.ليس حلمًا

91
00:07:02,850 --> 00:07:04,810
ذهبتِ لرؤية من؟

92
00:07:08,570 --> 00:07:09,780
...إنّه هو

93
00:07:09,780 --> 00:07:11,280
...كارتفيلس

94
00:07:12,320 --> 00:07:13,490
...ساعديني

95
00:07:14,410 --> 00:07:16,780
.لا يمكنني إخراجه من أذناي

96
00:07:17,280 --> 00:07:19,040
كم يومًا مرّ الآن؟

97
00:07:19,540 --> 00:07:21,370
.نمتِ ليومين فقط

98
00:07:23,750 --> 00:07:27,380
إذًا، لماذا السّيّد لينديل وسيلكي هنا؟

99
00:07:28,170 --> 00:07:30,550
.استيقظتِ أخيرًا

100
00:07:31,420 --> 00:07:33,340
.لقد استيقظتِ

101
00:07:33,340 --> 00:07:34,300
.أليس

102
00:07:34,300 --> 00:07:35,140
...لماذا

103
00:07:35,140 --> 00:07:38,010
.سأُعلم الجميع

104
00:07:39,390 --> 00:07:43,350
.لدينا وضع معقّد... بل سيّئ للغاية في الواقع

105
00:07:47,060 --> 00:07:47,770
ماذا؟

106
00:07:49,070 --> 00:07:50,730
هل أختار ملابسك لك؟

107
00:07:50,730 --> 00:07:52,570
.شـ-شكرًا لك

108
00:07:53,490 --> 00:07:56,450
بالمناسبة، كم عمرك يا أليس؟

109
00:07:56,450 --> 00:07:58,160
.سأصبح في الثّامنة عشر هذه السّنة

110
00:07:58,160 --> 00:07:59,700
.لا بأس إذًا

111
00:08:07,330 --> 00:08:09,290
.صباح الخير يا تشيسي

112
00:08:09,960 --> 00:08:12,380
.صباح الخير

113
00:08:12,380 --> 00:08:13,590
كيف حالك؟

114
00:08:13,590 --> 00:08:15,050
.بخير بفضلك

115
00:08:15,050 --> 00:08:16,430
ماذا عنك؟

116
00:08:16,430 --> 00:08:17,760
.بفضلك

117
00:08:18,300 --> 00:08:22,270
.لم أتمكّن من النّظر إلى سلي بيغي جيّدًا من قبل

118
00:08:22,270 --> 00:08:24,770
.أنا مسرور للغاية لرؤيتك

119
00:08:24,770 --> 00:08:26,650
!شكرًا لكونك حيّة

120
00:08:26,650 --> 00:08:28,020
...ا-المعذرة

121
00:08:28,900 --> 00:08:29,730
.أليس

122
00:08:33,610 --> 00:08:38,280
،أكره الاعتراف بأنّه زميلي
.ولكن أعتذر بشأن زميلي

123
00:08:38,740 --> 00:08:40,120
.سررت بلقائك

124
00:08:40,120 --> 00:08:42,370
.أنا أدولف ستراود

125
00:08:42,750 --> 00:08:44,250
.سررت بلقائك

126
00:08:46,250 --> 00:08:47,710
.لم أرك منذ وقتٍ طويل

127
00:08:48,130 --> 00:08:49,540
.آسف على قلّة احترامي سابقًا

128
00:08:50,750 --> 00:08:52,500
.لا بأس

129
00:08:53,340 --> 00:08:55,470
.أنا توري إينيس

130
00:08:55,470 --> 00:08:57,090
.يمكنك مناداتي بتوري

131
00:08:59,010 --> 00:09:01,220
.نحن من الكلّيّة

132
00:09:01,220 --> 00:09:02,390
الكلّيّة؟

133
00:09:02,850 --> 00:09:04,310
ألم تسمعي؟

134
00:09:06,690 --> 00:09:08,690
.لا حاجة للحديث غير الضّروري

135
00:09:09,150 --> 00:09:11,980
هل يمكننا الدّخول في صلب الموضوع؟

136
00:09:16,150 --> 00:09:18,450
،شرحنا له الأمر مسبقًا

137
00:09:18,450 --> 00:09:22,530
تم صيد أطفال تنانين من أرض
.التّنانين بصورة غير شرعيّة

138
00:09:23,410 --> 00:09:25,330
.سُرق اثنان

139
00:09:25,330 --> 00:09:28,120
.ترك السّارق هذا خلفه

140
00:09:30,130 --> 00:09:31,170
ما هذا؟

141
00:09:31,170 --> 00:09:33,380
.إنّه جهاز نقل صنعته

142
00:09:34,130 --> 00:09:38,090
.كارتفيلس خلف هذه الحادثة على الأرجح

143
00:09:39,130 --> 00:09:42,300
يبدو أنّه سرق المعرفة اللاّزمة
.لاستعمال الجهاز حين سلبني يدي

144
00:09:43,060 --> 00:09:44,560
.هذا خطئي

145
00:09:44,560 --> 00:09:45,600
...معلّمي

146
00:09:45,970 --> 00:09:48,140
.لا تقلق بشأن ذلك

147
00:09:48,140 --> 00:09:51,230
.أتفهّم جيّدًا أنّك لم تقصد حدوث هذا

148
00:09:51,900 --> 00:09:58,780
السّؤال هو لماذا علينا أن نشارككم
.في البحث عن كارتفيلس والتّنانين

149
00:09:59,280 --> 00:10:05,040
،تملكون صداقة مع أرض التّنانين
.وأنتم على معرفة بكارتفيلس

150
00:10:05,450 --> 00:10:08,960
لِمَ تقوم الكلّيّة بالبحث عن التّنانين أساسًا؟

151
00:10:09,330 --> 00:10:13,710
.السّيّد لينديل والكلّيّة بينهما اتّفاق

152
00:10:13,710 --> 00:10:15,250
مع السّيّد لينديل؟

153
00:10:15,880 --> 00:10:22,390
هل يمكنك مساعدتنا في إعادة التنّانين
إلى لينديل، صديقك؟

154
00:10:22,390 --> 00:10:25,720
،إنّه ملزم بالبقاء في تلك الأرض
.لمصلحته أيضًا

155
00:10:28,430 --> 00:10:29,600
...إلياس

156
00:10:29,600 --> 00:10:30,690
.لا

157
00:10:30,690 --> 00:10:31,980
لِمَ لا؟

158
00:10:32,230 --> 00:10:34,900
.هذا ليس من شأننا، وهو خطير أيضًا

159
00:10:34,900 --> 00:10:35,820
...ولكن

160
00:10:35,820 --> 00:10:39,400
هل نسيتِ مدى ضعف جسدك؟

161
00:10:44,070 --> 00:10:47,330
.أعتقد أنّك نسيت أيضًا يا إلياس

162
00:10:48,290 --> 00:10:51,120
،كان الأمر مؤلمًا وموجعًا جدًّا أيضًا

163
00:10:52,170 --> 00:10:53,130
.ذلك اليوم

164
00:10:54,130 --> 00:10:56,090
ذلك اليوم؟

165
00:10:56,210 --> 00:10:57,590
ذلك" اليوم؟"

166
00:10:57,880 --> 00:11:02,090
.أنت محقّ، لسنا مزلمين ولا مسؤولين

167
00:11:03,010 --> 00:11:07,930
ولكن على عكسنا، غادرت
.التّنانين أرضها دون إرادتها

168
00:11:10,810 --> 00:11:14,690
لا أريد لأولئك الصّغار الّذين لعبت معهم

169
00:11:16,900 --> 00:11:17,770
.أن يعانوا

170
00:11:25,410 --> 00:11:26,740
.حسنًا

171
00:11:26,740 --> 00:11:28,240
.سأتعاون

172
00:11:29,490 --> 00:11:31,830
.شـ-شكرًا جزيلاً لك

173
00:11:34,920 --> 00:11:37,130
هل تغيرتَ قليلاً؟

174
00:11:37,840 --> 00:11:41,010
إذًا، هل لدينا أيّ أدلّة أو أفكار؟

175
00:11:41,510 --> 00:11:43,800
.لا شيء محتمل حول مكان كارتفيلس

176
00:11:44,260 --> 00:11:48,220
يقوم لينديل بالمحافظة على الاتّصال مع
،التّنانين، ولكنّ الأمور ليست واضحة كثيرًا

177
00:11:48,220 --> 00:11:51,390
.ربّما لأنّها ليست واعية تمامًا

178
00:11:52,940 --> 00:11:57,440
.أعتقد أنّ كارتفيلس في لندن

179
00:11:57,860 --> 00:11:58,400
لماذا؟

180
00:11:59,320 --> 00:12:02,280
.إنّه مجرّد حدس

181
00:12:03,490 --> 00:12:08,030
يا سيّد ستراود، هل تباع التّنانين
مقابل الكثير من المال؟

182
00:12:08,030 --> 00:12:08,580
—نعـ

183
00:12:08,580 --> 00:12:09,580
!إنّها كذلك

184
00:12:09,580 --> 00:12:10,990
.الكثير من المال

185
00:12:11,540 --> 00:12:14,790
...من الممكن إذًا

186
00:12:15,960 --> 00:12:20,050
المعذرة، هل يمكن لأحد أن يعيرني هاتفًا؟

187
00:12:23,090 --> 00:12:23,880
نعم؟

188
00:12:25,970 --> 00:12:27,340
.إنّها أنتِ

189
00:12:27,340 --> 00:12:28,350
كيف حالك؟

190
00:12:29,350 --> 00:12:30,430
.هذا رائع

191
00:12:30,810 --> 00:12:31,600
.نعم

192
00:12:32,020 --> 00:12:34,020
.أنا في باريس حاليًّا

193
00:12:34,890 --> 00:12:39,730
.سأقبل عملك اعتمادًا على السّعر والشّروط

194
00:12:42,400 --> 00:12:43,400
!أنت

195
00:12:43,400 --> 00:12:45,700
!اسحبه بشدّة أكثر

196
00:13:21,310 --> 00:13:22,650
.سيّد سيث

197
00:13:22,650 --> 00:13:25,070
.لم أرك منذ وقت طويل يا آنسة تشيسي

198
00:13:26,610 --> 00:13:29,070
أتى السّيّد آينسورث أيضًا؟

199
00:13:29,610 --> 00:13:34,080
يفترض أنّ السّحر والشّعوذة غير
.مسموح بهما في المزاد

200
00:13:34,660 --> 00:13:39,170
هذا ما سمعته، لذا لستُ
.أستخدم لا سحرًا ولا شعوذة

201
00:13:40,130 --> 00:13:42,090
.قمت بإعادة تركيب الشّكل فحسب

202
00:13:42,380 --> 00:13:45,170
.ليس أنا ولا السّيّد سايمون

203
00:13:45,170 --> 00:13:46,840
وجه من هذا؟

204
00:13:47,090 --> 00:13:51,510
.لن أسأل عن أسمائكم

205
00:13:51,510 --> 00:13:55,560
.إن كان ذلك ممكنًا، أودّ المشاركة بهذه

206
00:13:56,600 --> 00:13:57,640
ما هذا؟

207
00:13:57,850 --> 00:13:58,980
.هذا مناسب

208
00:13:59,390 --> 00:14:01,980
.سنجعل هذا الغرض الأوّل لفترة بعد الظّهيرة

209
00:14:01,980 --> 00:14:03,940
.وسننتقل بعدها إلى المزاد الرّئيسيّ

210
00:14:04,480 --> 00:14:05,610
هل يناسبك ذلك؟

211
00:14:05,900 --> 00:14:06,650
.نعم

212
00:14:07,240 --> 00:14:10,240
.يبدأ مزاد التّنانين عند السّاعة 6 مساءً

213
00:14:10,240 --> 00:14:12,120
.افعلوا ما تريدون حتّى ذلك الوقت

214
00:14:12,120 --> 00:14:15,830
.إنّكم تبيعون ما يحلو لكم هنا حقًّا

215
00:14:16,290 --> 00:14:18,040
.تفضلي يا آنسة تشيسي

216
00:14:19,660 --> 00:14:20,960
دفتر شيكات؟

217
00:14:21,250 --> 00:14:22,580
.وبطاقة

218
00:14:22,580 --> 00:14:25,750
.نصف قيمة سعر بيعك أودعت بها

219
00:14:25,750 --> 00:14:26,960
!النّصف؟

220
00:14:27,260 --> 00:14:30,050
،كنتِ منتَجًا وغرضًا للعرض في نفس الوقت

221
00:14:30,050 --> 00:14:31,470
.لذا فإنّ هذه حصّتك

222
00:14:31,930 --> 00:14:33,970
.التّنانين غالية

223
00:14:33,970 --> 00:14:37,220
.أرجوك استخدميها إن كان تمويل الكلّيّة غير كافٍ

224
00:14:37,600 --> 00:14:39,480
.شكرًا جزيلاً لك

225
00:14:40,890 --> 00:14:42,150
مال؟

226
00:14:42,520 --> 00:14:46,360
.بالتّفكير بالأمر، يعود هذا المال إلى إلياس

227
00:14:48,940 --> 00:14:50,650
.تغيّرت هالتك

228
00:14:51,910 --> 00:14:53,530
.وأصبحت أكثر طولاً أيضًا

229
00:14:53,530 --> 00:14:55,240
.أنت مختلفة عمّا سبق

230
00:14:56,080 --> 00:14:59,620
،تغيّرتُ في بعض النّواحي
.وبقيت كما أنا في نواحٍ أخرى

231
00:14:59,870 --> 00:15:03,000
.أهمّ أجزاء الفرد نادرًا ما تتغيّر

232
00:15:03,000 --> 00:15:06,000
.إنّك عنيدة في كلّ الأحوال

233
00:15:08,260 --> 00:15:09,170
ما الأمر؟

234
00:15:09,170 --> 00:15:10,380
ما الّذي كنتما تتحدّثان عنه؟

235
00:15:10,380 --> 00:15:13,090
أتريدين الذّهاب إلى الكلّيّة؟

236
00:15:14,090 --> 00:15:16,720
هناك من سيشعر بالوحدة
.في المنزل إلّم أكن موجودة

237
00:15:19,640 --> 00:15:21,520
.أنا مسرورٌ لأنّك لستِ سهلة المنال

238
00:15:25,110 --> 00:15:28,610
.إن كان هناك ما تريد قوله، فقله

239
00:15:28,610 --> 00:15:31,860
لم تخبرها عن الكلّيّة، أليس كذلك؟

240
00:15:32,200 --> 00:15:34,530
.لن تذهب إلى الكلّيّة

241
00:15:34,530 --> 00:15:36,580
.لذا لا يوجد سبب لإخبارها

242
00:15:36,950 --> 00:15:38,410
ماذا فعلت مع المرسول؟

243
00:15:38,410 --> 00:15:39,580
هل دمّرته؟

244
00:15:40,580 --> 00:15:45,580
ليس من عادتك يا رينفريد
.أن تركّز اهتمامك على سلي بيغي

245
00:15:45,790 --> 00:15:48,710
.الأمر ليس أنّني أهتمّ بشأن سلي بيغي

246
00:15:49,170 --> 00:15:52,090
.أنا قلق حيال مستقبل إنسانة

247
00:15:52,380 --> 00:15:53,720
،قد تكون بخير الآن

248
00:15:53,720 --> 00:15:58,260
ولكن إلى أيّ مدى ستنمو إن كانت
مجبرة على الاعتماد عليك؟

249
00:15:59,560 --> 00:16:01,600
أيحقّ لنا نحن مناقشة ذلك؟

250
00:16:03,640 --> 00:16:08,020
،نجد شخصًا بلا وجهة، نثقل كاهله بمعرفة كبيرة

251
00:16:08,020 --> 00:16:10,820
.ونجبره على ركوب سفينة تأخذه إلى المستقبل

252
00:16:11,400 --> 00:16:15,780
،نتصرّف وكأنّنا دللناهم على الدّرب
.ونجعلهم يصدّقون أنّه الدّرب الوحيد

253
00:16:16,740 --> 00:16:19,120
إنّنا لسنا مختلفين كثيرًا، أليس كذلك؟

254
00:16:21,200 --> 00:16:27,630
لم ترد أن تصبح مشعوذًا، أليس كذلك؟

255
00:16:28,080 --> 00:16:29,920
هل أجبرك أحد على ذلك؟

256
00:16:33,090 --> 00:16:35,720
.لا تقرّر دربي من تلقاء نفسك

257
00:16:37,970 --> 00:16:40,180
.تلك الفتاة ملك لي

258
00:16:40,930 --> 00:16:43,270
.هذا ما تريده تشيسي

259
00:16:46,730 --> 00:16:49,480
.ستكون رؤية إلى متى سيستمرّ هذا ممتعة

260
00:16:49,900 --> 00:16:54,280
.المخلوقات الحيّة تتغيّر، سواءً أرادت ذلك أم لا

261
00:16:59,030 --> 00:17:01,030
غـ-غريب، أليس كذلك؟

262
00:17:01,030 --> 00:17:01,950
.نعم

263
00:17:01,950 --> 00:17:05,330
.ولكن كتلة العظم ذاك لا يفهم الأمر

264
00:17:06,210 --> 00:17:09,170
هنالك العديد من الأشخاص الّذين
،يمكنهم اتّباع دربهم الخاصّ فقط

265
00:17:09,170 --> 00:17:12,960
.حتّى عندما يُمنحون طريقًا ممهّدًا

266
00:17:14,340 --> 00:17:16,800
هل تتبعين دربك الخاصّ؟

267
00:17:17,970 --> 00:17:21,300
.تتشكّل الدّروب حيث أختار أن أسير

268
00:17:23,970 --> 00:17:26,100
.الشّباب جميل

269
00:17:29,150 --> 00:17:32,940
.سنبدأ الآن مزاد السّاعة السّادسة

270
00:17:33,940 --> 00:17:37,400
.أرض التّنانين الشّماليّة مغلقة

271
00:17:38,610 --> 00:17:44,620
!هناك حيث تمّت تربية هذا التّنّين المجنّح الخالص

272
00:17:59,380 --> 00:18:01,590
.سنبدأ بثمانمائة ألف

273
00:18:01,590 --> 00:18:02,970
.ثمانمائة وعشرة آلاف

274
00:18:02,970 --> 00:18:04,100
.ثمانمائة وعشرون ألفًا

275
00:18:04,470 --> 00:18:05,520
.ثمانمائة وخمسون ألفًا

276
00:18:05,770 --> 00:18:06,680
.تسعمائة ألف

277
00:18:06,680 --> 00:18:07,480
!تسعمائة ألف

278
00:18:08,100 --> 00:18:09,480
.تسعمائة وعشرين ألفًا

279
00:18:09,480 --> 00:18:10,480
!مليون

280
00:18:15,280 --> 00:18:18,780
.يمكن للكلّيّة تدبّر حتّى مليون ونصف

281
00:18:18,780 --> 00:18:20,530
...إن اجتزنا ذلك

282
00:18:21,490 --> 00:18:22,620
.أعلم

283
00:18:23,330 --> 00:18:24,200
من هو العارض؟

284
00:18:24,830 --> 00:18:25,660
.هو

285
00:18:25,660 --> 00:18:27,120
!مليون ومائتان وعشرون ألفًا

286
00:18:27,450 --> 00:18:28,790
.مرتزق

287
00:18:27,790 --> 00:18:29,290
!مليون ومائتان وخمسون ألفًا

288
00:18:28,790 --> 00:18:30,920
.أو مرتزق يعمل لمرتزق

289
00:18:30,920 --> 00:18:34,130
.مليون ومائتان وخمسون ألفًا

290
00:18:39,720 --> 00:18:42,680
.ذلك الشّخص ينظر نحوي

291
00:18:42,680 --> 00:18:44,050
.مليون ونصف

292
00:18:44,050 --> 00:18:45,390
!مليون ونصف

293
00:18:45,390 --> 00:18:47,020
إلى أيّ مدى سنزيد؟

294
00:18:47,020 --> 00:18:49,180
.إلى حدّ رصيدي الّذي تعرفه

295
00:18:49,930 --> 00:18:51,310
.مفهوم

296
00:18:51,310 --> 00:18:52,850
!مليون وستّمائة ألف

297
00:18:54,020 --> 00:18:54,940
.لقد ذهبوا

298
00:18:54,150 --> 00:18:55,570
.مليون وسبعمائة ألف

299
00:18:55,770 --> 00:18:57,150
أيّ مُزايد آخر؟

300
00:18:57,150 --> 00:18:58,530
هل لدينا مُزايد آخر؟

301
00:18:59,110 --> 00:19:00,950
.مرحبًا أيّتها الآنسة الصّغيرة

302
00:19:04,070 --> 00:19:05,200
أهنالك خطب ما؟

303
00:19:05,580 --> 00:19:06,370
.لا

304
00:19:07,410 --> 00:19:10,120
.لا أحد غيرك يستطيع سماعي

305
00:19:10,120 --> 00:19:11,540
.لا تقلقي

306
00:19:12,290 --> 00:19:14,380
من تكونين؟

307
00:19:15,170 --> 00:19:18,090
.امرأة يمكنك الانتفاع منها

308
00:19:18,670 --> 00:19:20,590
أهذا جيّد؟

309
00:19:21,420 --> 00:19:22,630
أنتفع منك؟

310
00:19:22,630 --> 00:19:25,220
.مليون وثمانمائة ألف

311
00:19:25,930 --> 00:19:28,770
.مليون وثمانمائة وخمسون ألفًا

312
00:19:28,890 --> 00:19:31,980
.مليون وتسعمائة وعشرة آلاف

313
00:19:31,980 --> 00:19:34,730
.مليون وتسعمائة وثلاثون ألفًا

314
00:19:34,730 --> 00:19:36,230
.مليون وتسعمائة وسبعون ألفًا

315
00:19:36,230 --> 00:19:39,230
.أعتمد عليك إن وصلنا حدّنا

316
00:19:39,570 --> 00:19:41,900
.لا تفعلي إلّم يحدث ذلك

317
00:19:42,450 --> 00:19:44,950
.من المؤسف أنّه اتّفاق شفهيّ فحسب

318
00:19:45,660 --> 00:19:48,540
.احرصوا على ألاّ تندموا لاحقًا من فضلكم

319
00:19:48,540 --> 00:19:49,870
حسنًا؟

320
00:19:50,330 --> 00:19:51,580
.مليونان وستّمائة ألف

321
00:19:57,960 --> 00:20:00,630
.مليونان وتسعمائة ألف

322
00:20:03,930 --> 00:20:05,390
.يبدو هذا واعدًا

323
00:20:15,060 --> 00:20:16,650
.مليونان وتسعمائة ألف

324
00:20:16,650 --> 00:20:18,110
.وصلنا إلى مليونين وتسعمائة ألف

325
00:20:18,110 --> 00:20:20,860
أيوجد شخص سيزايد فوق
مليونين وتسعمائة ألف؟

326
00:21:09,280 --> 00:21:11,910
.لقد عُزّز ذلك بسحر خاصّ

327
00:21:11,910 --> 00:21:13,040
!كيف خرج؟

328
00:21:13,040 --> 00:21:14,080
.لا أعلم

329
00:21:14,080 --> 00:21:15,330
!لم يحدث هذا من قبل

330
00:21:21,460 --> 00:21:22,630
...إنّه ليس

331
00:21:22,630 --> 00:21:24,090
.بكامل قواه العقليّة

332
00:21:24,630 --> 00:21:25,380
!تشيسي

333
00:21:36,480 --> 00:21:38,230
.يريد العودة إلى المنزل

334
00:21:42,320 --> 00:21:43,860
.إنّه خائف

335
00:21:45,570 --> 00:21:48,660
.إنّه تعيس للغاية

336
00:21:54,740 --> 00:21:56,870
!أيمكنك سماع صوت التّنين؟

337
00:22:02,130 --> 00:22:03,540
.لا بأس

338
00:22:03,540 --> 00:22:05,300
.تلك ليست مشاعرك

339
00:22:06,050 --> 00:22:07,800
.لا يجب عليك تركها تجرّك

340
00:22:10,640 --> 00:22:11,090
!هذا سيّئ

341
00:23:57,830 --> 00:24:02,160
.يتردّد صدى عواء التّنّين الحزين في سماء لندن

342
00:24:02,160 --> 00:24:07,540
.تقرّر الفتاة إنقاذ التّنّين، ولكنّه كان وحشيًّا للغاية

343
00:24:08,590 --> 00:24:09,840
.لا بأس

344
00:24:09,840 --> 00:24:11,380
.لنعد إلى المنزل معًا