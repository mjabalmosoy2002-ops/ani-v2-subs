1
00:01:49,710 --> 00:01:51,590
.لن يستغرق الأمر كثيرًا

2
00:01:51,590 --> 00:01:53,170
.كوني صبورة

3
00:01:56,050 --> 00:01:59,390
كيف وصلت إلى هنا؟

4
00:02:01,470 --> 00:02:05,390
...كان يخبرني إلياس عن التّنانين وحينها

5
00:02:09,520 --> 00:02:10,650
تنانين؟

6
00:02:10,980 --> 00:02:12,570
.نعم، تنانين

7
00:02:15,230 --> 00:02:18,740
.سمعت أنّ التّنانين نشطة مؤخّرًا

8
00:02:18,740 --> 00:02:20,450
.طُلب منّي معاينتها

9
00:02:22,370 --> 00:02:25,750
.عرين التّنانين يوجد هنا في أيسلندا

10
00:02:26,950 --> 00:02:31,920
.إنّها على وشك الانقراض، مثلنا نحن السّحرة

11
00:02:32,420 --> 00:02:37,170
السّلالات النّاجية القليلة
.جُمِعت هنا ليتمّ الاعتناء فيها

12
00:02:41,090 --> 00:02:46,220
،إنّه مكانٌ معزول وغير مسكون
.ما يجعله مكانًا مثاليًّا للاختباء

13
00:02:46,680 --> 00:02:48,560
هل هي متوحّشة؟

14
00:02:48,560 --> 00:02:51,400
.تم التّخلّص من أغلبها قبل وقتٍ طويل

15
00:02:51,400 --> 00:02:53,820
.هنالك الكثير منها منصاع الآن

16
00:02:54,190 --> 00:02:55,610
.فهمت

17
00:03:10,000 --> 00:03:10,750
!تشيسي

18
00:03:11,420 --> 00:03:12,460
!إلياس

19
00:03:23,050 --> 00:03:25,640
.موهبته السّخيفة هي ما تجعله مغرورًا

20
00:03:25,640 --> 00:03:27,970
.لم يتغيّر أبدًا

21
00:03:32,480 --> 00:03:35,020
.انظري، يمكنك رؤيتها الآن

22
00:03:38,320 --> 00:03:41,280
.أرض التّنانين الأخيرة

23
00:04:07,430 --> 00:04:09,270
.أنت، اتركها

24
00:04:23,320 --> 00:04:24,160
!أنتِ

25
00:04:28,120 --> 00:04:30,410
أتنوي الاستمرار بالغرق هكذا؟

26
00:04:36,040 --> 00:04:39,380
.أشعر أنّ جسدي ثقيل

27
00:04:49,510 --> 00:04:52,480
.تشيسي

28
00:04:53,480 --> 00:04:54,140
!تشيسي

29
00:05:06,450 --> 00:05:07,780
.حسنًا

30
00:05:16,620 --> 00:05:19,420
.هذا ضيفٌ غير مُعتاد

31
00:05:24,300 --> 00:05:27,510
...رائحتك تبدو كساحرة

32
00:05:30,350 --> 00:05:33,270
.ولكن يافعة

33
00:05:33,270 --> 00:05:35,850
.رائحة شتلة

34
00:05:35,850 --> 00:05:41,360
رائحتك مثل نباتات وزهور
.وصخور من مكانٍ آخر

35
00:05:42,020 --> 00:05:44,190
.إنّها رائحة طيّبة

36
00:05:44,190 --> 00:05:46,400
...عيناه

37
00:05:47,410 --> 00:05:52,120
.جسده كلّه يبدو كغابة طحالب أيضًا

38
00:05:53,330 --> 00:05:56,620
.إنّه من سلالة تنانين تدعى أُوِيل

39
00:05:56,870 --> 00:06:02,040
إنّه أب وأمّ للغابة، يحمل الحياة
.النّباتيّة على جسده المتحلّل

40
00:06:03,210 --> 00:06:05,170
.أعتذر عن المعاملة العنيفة

41
00:06:05,170 --> 00:06:08,630
،مرحبًا بك في أرض التّنانين
.يا ابنة ذي الشّوك

42
00:06:09,260 --> 00:06:11,550
لِمَ أنا؟

43
00:06:11,930 --> 00:06:14,810
.كان هنالك فوضى بين الإيريل

44
00:06:14,810 --> 00:06:17,770
.قالت أنّ ذا الشّوك ذاك اتّخذ تلميذة أخيرًا

45
00:06:18,230 --> 00:06:21,230
.تنتشر الإشاعات كالرّياح حرفيًّا بالنّسبة لها

46
00:06:22,860 --> 00:06:24,980
.وصلتَ بسرعة هذه المرّة

47
00:06:25,400 --> 00:06:29,160
إلى متى ستختبئ في ظلال
تلميذتك يا ذا الشّوك؟

48
00:06:29,490 --> 00:06:31,870
لا، يا آينسورث؟

49
00:06:44,630 --> 00:06:48,010
عندما ينتهي هذا القديم من
.من كلامه السّخيف

50
00:06:48,550 --> 00:06:54,220
مرّت 300 سنة وما زلت تتلاعب بالنّاس يا إيكوز؟

51
00:06:54,810 --> 00:06:59,640
أتريد أن تتجمّد تلميذتك حتّى
الموت يا آينسورث؟

52
00:07:05,980 --> 00:07:07,780
.أنا... أنا بخير

53
00:07:09,700 --> 00:07:13,240
.إنّك متبلّلة بالكامل

54
00:07:15,030 --> 00:07:16,540
...قرّاص في الظّلال

55
00:07:20,000 --> 00:07:21,210
...حلَقة البهشيّة

56
00:07:30,630 --> 00:07:31,880
.لقد جففت

57
00:07:31,880 --> 00:07:34,510
.شـ-شكرًا جزيلاً لك

58
00:07:35,930 --> 00:07:37,600
ما الّذي تتبسّم له؟

59
00:07:39,100 --> 00:07:43,230
.يتصرّف كالبالغ أمام تلك الصّغيرة

60
00:07:43,230 --> 00:07:44,480
.اصمت

61
00:07:50,950 --> 00:07:53,410
.تشيسي، هذا لينديل

62
00:07:53,410 --> 00:07:57,700
.إنّه ساحرٌ مثلي، ووصيّ عرين التّنين هذا

63
00:07:57,990 --> 00:07:59,080
وصيّ؟

64
00:07:59,540 --> 00:08:04,040
وظيفته هي إبقاء أرض التّنانين هذه
.مخفيّة عن أنظار البشر العاديّين

65
00:08:04,040 --> 00:08:05,750
."لذا فإنّه "وصيّ

66
00:08:07,460 --> 00:08:12,630
إنّه عجوزٌ خبيث أكبر منّي عمرًا بكثير
.على الرّغم من مظهره، لذا كوني حذرة

67
00:08:13,470 --> 00:08:14,390
...أيّها الوغد

68
00:08:14,680 --> 00:08:15,930
!أنتِ، أنتِ

69
00:08:15,930 --> 00:08:17,390
هل انتهيتم من الحديث؟

70
00:08:17,390 --> 00:08:18,140
.لنلعب

71
00:08:18,260 --> 00:08:20,350
!لنلعب! لنلعب

72
00:08:20,350 --> 00:08:21,810
.هيّا

73
00:08:21,810 --> 00:08:23,810
.إنّها فراخ التّنانين

74
00:08:21,810 --> 00:08:23,810
.لنلعب

75
00:08:23,810 --> 00:08:24,690
!لنلعب

76
00:08:24,690 --> 00:08:26,020
أرجوك؟

77
00:08:24,690 --> 00:08:26,650
.ذو الأجنحة هو غوي

78
00:08:26,440 --> 00:08:27,730
!هيّا

79
00:08:26,650 --> 00:08:28,520
.والّذي أمامك هو بيانا

80
00:08:28,190 --> 00:08:31,280
!هيّا لنلعب

81
00:08:28,520 --> 00:08:31,280
.الّذي يتحرّك ببطء هو أويل

82
00:08:31,860 --> 00:08:35,200
.هذا ما أناديها به أنا فحسب

83
00:08:32,320 --> 00:08:33,700
!لنلعب

84
00:08:34,030 --> 00:08:35,530
!هيّا

85
00:08:35,530 --> 00:08:37,200
أتستمعين؟

86
00:08:36,320 --> 00:08:37,370
،لينديل

87
00:08:37,200 --> 00:08:38,330
!لنلعب

88
00:08:38,660 --> 00:08:42,370
هل يمكنك إخباري ما إن كانت
هنالك مشاكل هنا مؤخّرًا؟

89
00:08:43,710 --> 00:08:46,710
إنّهم يحدثون جلبة ثانيةً؟

90
00:08:46,710 --> 00:08:48,630
.كان الطّعام قليلاً هذه السّنة

91
00:08:48,630 --> 00:08:50,920
.سافر الكثير من التّنانين لمسافاتٍ بعيدة

92
00:08:57,300 --> 00:09:00,680
أتمانعين اللّعب معها يا تشيسي؟

93
00:09:12,990 --> 00:09:14,400
ماذا تريدن أن نلعب؟

94
00:09:14,400 --> 00:09:15,910
.هناك

95
00:09:16,110 --> 00:09:20,830
لنقفز من أعلى هناك ونتدرّب
.على الانحدار نحو البركة

96
00:09:26,580 --> 00:09:29,340
يمكن للبشر الطّيران هذه الأيّام، صحيح؟

97
00:09:29,340 --> 00:09:34,050
قد يكون ذلك صعبًا دون أن يتمّ
.تعديل جينات عظامي وعضلاتي

98
00:09:42,520 --> 00:09:44,270
!مرحى

99
00:09:51,440 --> 00:09:53,360
.تبلّلت ثانيةً

100
00:09:53,900 --> 00:09:56,110
هل يمكننا تجريب ذلك؟

101
00:09:54,900 --> 00:09:56,700
!كان ذلك رائعًا

102
00:10:43,330 --> 00:10:47,000
لديه أجنحة، أتساءل ما إن
.كان يستطيع الطّيران

103
00:10:47,450 --> 00:10:49,870
.ولكنّه في حالة رثّة

104
00:10:57,050 --> 00:11:00,220
أهذه أوّل مرّة ترين فيها تنّينًا؟

105
00:11:00,220 --> 00:11:01,640
...آ-آسفة، لم أقصد أن

106
00:11:03,050 --> 00:11:06,810
.لم أعنيها بتلك الطّريقة

107
00:11:06,810 --> 00:11:08,810
.استيقظ العمّ نيفين

108
00:11:08,810 --> 00:11:11,770
.سأعود إلى منزلي قريبًا

109
00:11:11,770 --> 00:11:15,820
اعتقدت أنّك ستفضّلين رؤية التّنانين
.اليافعة الظّريفة بدلاً عن ذلك

110
00:11:15,820 --> 00:11:18,650
.يكاد أن يحين وقته

111
00:11:18,650 --> 00:11:19,950
وقته؟

112
00:11:19,950 --> 00:11:23,490
.سيتحوّل العمّ نيفين إلى شجرة قريبًا

113
00:11:23,490 --> 00:11:24,910
.نعم

114
00:11:24,910 --> 00:11:27,620
.يحدث هذا لجميع تنانين الأويل

115
00:11:27,620 --> 00:11:30,540
.تتحوّل إلى أشجار وأعشاب ممتازة

116
00:11:47,430 --> 00:11:49,060
..."عندما قلت "سأعود

117
00:11:50,100 --> 00:11:51,190
ماذا قصدت؟

118
00:12:01,570 --> 00:12:06,830
نحن أيضًا سنتحوّل إلى أشجار
.وطحالب وصخور عندما نموت

119
00:12:06,830 --> 00:12:08,290
أليس كذلك؟

120
00:12:08,290 --> 00:12:09,910
عندما تموتين؟

121
00:12:10,580 --> 00:12:15,040
.لا نخشى الموت مثلكم أنتم البشر

122
00:12:15,540 --> 00:12:20,710
نعيش حياتنا بكلّ حيويّة
.لكي لا يبقى لدينا أيّ ندم

123
00:12:35,850 --> 00:12:38,320
ألا يؤلم ذلك؟

124
00:12:40,900 --> 00:12:43,820
.إنّك فتاة طيّبة القلب

125
00:12:44,610 --> 00:12:48,990
نتفهّم أنّ ما مُنحنا إيّاه هو مثل

126
00:12:48,990 --> 00:12:54,120
.ما مُنح لجميع من على هذا الكوكب

127
00:12:54,500 --> 00:13:01,510
،سواء أكان ذلك سعادة أو ألم الحياة
.أو حزن أو وحدة الموت

128
00:13:02,300 --> 00:13:05,550
.إضافةً على ذلك، عشتُ ما يكفي من الوقت

129
00:13:06,010 --> 00:13:11,270
.لوقتٍ طويل، طويلٍ جدًّا حتّى لتنّين

130
00:13:11,810 --> 00:13:15,730
.ستُسلّم الحياة القادمة إلى الجيل القادم

131
00:13:16,190 --> 00:13:19,110
.لا داعي لأن تحزني

132
00:13:19,820 --> 00:13:20,820
.كلاّ

133
00:13:24,280 --> 00:13:25,820
.لست أحزن

134
00:13:27,530 --> 00:13:28,570
.لا يمكنني

135
00:13:32,330 --> 00:13:33,450
...هذا

136
00:13:55,810 --> 00:14:00,190
.لا ينبغي على الحيّ أن يحسد الميّت

137
00:14:01,980 --> 00:14:04,690
لا يمكنك الطّيران، لذا فإنّ من الجيّد
.أنّك لا تستطيعين ذلك

138
00:14:05,610 --> 00:14:12,910
ما كان ليعرف من يتّخذ
.كتلميذ له ما لم يقابلك

139
00:14:13,700 --> 00:14:16,790
هل كنتَ تشاهد ذكرياتي؟

140
00:14:18,500 --> 00:14:21,170
.فِعل هذا لبشريّ تقليل لاحترامه

141
00:14:21,170 --> 00:14:22,540
.آسف

142
00:14:26,800 --> 00:14:33,810
ارتأيت أنّه ينبغي أن أجعلك تختبرين المتعة
.الحقيقيّة للطّيران بما أنّك لا تستطيعين ذلك

143
00:14:39,230 --> 00:14:42,900
،ليس لديّ القوّة للطّيران بعد الآن

144
00:14:43,860 --> 00:14:48,610
ولكن يمكنني أن أُريك السّماء
.الّتي أراها في بالي

145
00:14:49,280 --> 00:14:51,120
.انظري

146
00:16:45,350 --> 00:16:50,650
يبدو أنّ نيفين يرى حلمه
.الأخير، رفقة تشيسي

147
00:16:51,610 --> 00:16:55,360
تمرّر العديد من التّنانين شعلتها
.للجيل الجديد مؤخرًا

148
00:16:55,360 --> 00:16:57,990
.أعتقد أنّه آخر التّنانين القديمة

149
00:16:58,450 --> 00:17:01,290
التّنانين والسّحر في وضعٍ واحد، أليس كذلك؟

150
00:17:01,580 --> 00:17:05,330
.أعداد البشر المتزايدة وتغيّر الزّمن يطغون علينا

151
00:17:05,750 --> 00:17:10,340
ستكون تشيسي من الجيل الأخير
.حتمًا إن أصبحت ساحرة

152
00:17:11,210 --> 00:17:12,800
أيزعجك ذلك؟

153
00:17:16,470 --> 00:17:20,100
.قوّة تشيسي السّحريّة تتدفّق إلى نيفين

154
00:17:20,810 --> 00:17:24,060
،ستكون مساعدَة عظيمة لنيفين

155
00:17:24,060 --> 00:17:29,270
ولكنّ قوّة سلي بيغي السّحريّة الغامرة
.قد تضرّ صاحبها في بعض الأوقات

156
00:17:30,320 --> 00:17:32,940
.لا تعرف كيف تكبحها بعد

157
00:17:33,900 --> 00:17:36,860
أليس تعليمها هو وظيفتك؟

158
00:17:38,490 --> 00:17:43,450
جسدها لن يتحمّل لثلاث سنوات
.حتّى إلّم توقفها

159
00:17:43,450 --> 00:17:44,580
.أعلم

160
00:17:44,580 --> 00:17:46,420
.لا تلهو عنها

161
00:17:46,960 --> 00:17:49,790
.هنالك الكثير من النّاس يريدون سلي بيغي

162
00:17:50,250 --> 00:17:52,710
.الإشاعات هذه الأيّام ليست جيّدة

163
00:17:52,960 --> 00:17:55,510
.لم يكن الحصول عليها سهلاً

164
00:17:55,510 --> 00:17:58,220
.لن أفلتها بهذه السّهولة

165
00:18:03,100 --> 00:18:05,560
...آمل أن تكبر بسلام

166
00:18:07,440 --> 00:18:09,520
.سلي بيغي تلك

167
00:18:13,400 --> 00:18:16,400
.تخلّى نوعنا عن السّماوات

168
00:18:16,780 --> 00:18:20,280
.ولكن لطالما كان قدرنا أن نمكث تحتها

169
00:18:22,370 --> 00:18:24,750
.اسمك يحمل حرف "طائر" به

170
00:18:24,750 --> 00:18:28,500
.عليك أيضًا الطّيران تحت هذه السّماء للعيش

171
00:18:30,500 --> 00:18:31,960
للعيش؟

172
00:18:38,090 --> 00:18:39,010
الطّيران؟

173
00:18:48,600 --> 00:18:50,350
...لأعيش

174
00:18:58,280 --> 00:18:58,990
.إنّها شجرة

175
00:18:59,780 --> 00:19:00,990
.شكرًا لك

176
00:19:01,450 --> 00:19:06,330
استطعت أن أقضي آخر لحظاتي
.في الطّيران لأنّك كنتِ هنا

177
00:19:07,250 --> 00:19:08,710
.لم أفعل شيئًا

178
00:19:12,880 --> 00:19:19,300
زرَع لينديل بذرة صغيرة
.في جسدي قبل فترة

179
00:19:27,430 --> 00:19:32,400
.ستُنتج أزهارًا بيضاء جميلة كما سمعت

180
00:19:35,270 --> 00:19:37,820
أنتِ ساحرة، ألستِ كذلك؟

181
00:19:38,610 --> 00:19:42,070
.ستحتاجين عصا يومًا ما

182
00:19:42,610 --> 00:19:46,790
.اصنعي واحدة من أغصاني

183
00:19:53,000 --> 00:19:57,170
.تصبحين على خير، أيّتها السّاحرة الصغيرة

184
00:20:00,590 --> 00:20:02,470
.كان العمّ رائعًا

185
00:20:02,470 --> 00:20:03,640
أليس كذلك؟

186
00:20:03,640 --> 00:20:06,720
.آمل أن أصبح شجرةً عملاقة أيضًا

187
00:20:12,940 --> 00:20:14,770
.مرحبًا بعودتك يا تشيسي

188
00:20:16,480 --> 00:20:19,030
أكانت سماء نيفين جميلة؟

189
00:20:20,070 --> 00:20:23,030
.كانت جميلة للغاية

190
00:20:23,910 --> 00:20:26,320
.شهدتِ شيئًا يندر رؤيته

191
00:20:26,910 --> 00:20:30,870
لا تسنح الفرصة للكثيرين
.لرؤية عودة تنّين إلى الأرض

192
00:20:32,910 --> 00:20:34,710
.الزّيزفون

193
00:20:35,500 --> 00:20:38,040
.تُزهر أزهارها البيضاء الجميلة

194
00:20:42,720 --> 00:20:46,510
.ليس هنالك داعٍ لأن تحزني يا تشيسي

195
00:20:47,300 --> 00:20:49,010
.هذا عمل الطّبيعة

196
00:20:50,270 --> 00:20:55,270
تقضي التّنانين وقتها بتقوية
،عقولها منذ قديم الزّمان

197
00:20:55,770 --> 00:21:01,440
.وجميعها بكلّ لطف تصبح محضنة لحياة أخرى

198
00:21:09,080 --> 00:21:09,870
.حسنًا

199
00:21:10,910 --> 00:21:12,700
،كما قال نيفين

200
00:21:12,700 --> 00:21:16,830
سنعود لأخذ غصن لاستخدامه كعصاك
.حين يحين الوقت لأن تمتلكين واحدة

201
00:21:18,420 --> 00:21:21,460
.انتهى عملنا هنا لهذه المرّة

202
00:21:21,460 --> 00:21:22,880
.لنعد إلى المنزل

203
00:21:22,880 --> 00:21:25,550
ماذا؟ ستغادران بهذه السّرعة؟

204
00:21:25,550 --> 00:21:28,890
ليست هذه المسألة الوحيدة
.الّتي كُلّفت بها

205
00:21:28,890 --> 00:21:30,810
.يمكنك التّخلّي عنها فحسب

206
00:21:31,350 --> 00:21:33,930
إنّك جادّ بشكل مفاجئ، صحيح؟

207
00:21:33,930 --> 00:21:35,140
.دعني وشأني

208
00:21:39,020 --> 00:21:41,900
...هذه الطّبيعة

209
00:21:42,860 --> 00:21:44,530
.لنذهب يا تشيسي

210
00:21:46,280 --> 00:21:48,530
.لستُ حزينة

211
00:21:50,160 --> 00:21:54,450
.كان كمجرّد غريب أظهر لي بعض اللّطف

212
00:22:00,540 --> 00:22:02,710
.أشعر بالدّوار

213
00:22:03,460 --> 00:22:07,220
أهذا بسبب الطّيران؟

214
00:22:09,640 --> 00:22:11,220
،ولكن مع ذلك

215
00:22:13,890 --> 00:22:16,230
الطّريقة الهادئة الّتي تُوفّيَ بها

216
00:22:18,400 --> 00:22:22,940
.تُشعرني بالغيرة قليلاً

217
00:23:55,660 --> 00:23:59,290
.ما بعد النّفق كانت بلدة قطط

218
00:23:59,290 --> 00:24:03,880
،هناك في أرض غارقة في الأحزان
.تعرف الفتاة المزيد عن مهمّتها القاسية

219
00:24:04,170 --> 00:24:07,960
.أرجوك ساعدي هذا الشّخص. ساعديني