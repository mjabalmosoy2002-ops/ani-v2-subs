1
00:02:11,310 --> 00:02:15,860
ستفسدها إن استمررت بعدم فعل
.شيء سوى تركها تعيش معك

2
00:02:22,490 --> 00:02:23,740
...إلياس

3
00:02:23,950 --> 00:02:24,950
.صحيح

4
00:02:24,950 --> 00:02:29,170
.مُنح اسمه له بواسطة معلّمتي

5
00:02:30,500 --> 00:02:37,380
مرحبًا بك يا إلياس في هذا العالم
.المُدوّخ المقرف الجميل

6
00:02:39,930 --> 00:02:42,180
حسنًا إذًا، اعتن بإلياس

7
00:02:43,560 --> 00:02:44,640
.يا لينديل

8
00:02:52,810 --> 00:02:54,480
.هذا مفاجئ للغاية

9
00:02:55,650 --> 00:02:58,950
.حسنًا، أنت إلياس من الآن فصاعدًا

10
00:03:02,030 --> 00:03:08,620
ولبضع سنوات لاحقة، سافر كلانا
.خلال الغابة، ملاحقين الرّنّة

11
00:03:09,160 --> 00:03:13,290
سافرنا مستمتعين بمناظر البحيرات
.والحقول خلال طريقنا

12
00:03:26,510 --> 00:03:28,810
أنت! ماذا تفعل؟

13
00:03:28,810 --> 00:03:31,440
.لا ينبغي عليك أخذ الأشياء الّتي لن تأكلها

14
00:03:31,850 --> 00:03:32,900
حقًّا؟

15
00:03:34,810 --> 00:03:38,690
.بدا أنّ إلياس يفتقر لشيء ما

16
00:03:39,190 --> 00:03:43,870
تعلّم كلّ شيء سريعًا، ولكن كان يبدو
.وكأنّه ينظر لكلّ شيء من الخارج

17
00:03:44,700 --> 00:03:49,370
.في أحد الأيّام، زرنا بيتًا عندما كان ينقصنا الطّعام

18
00:03:50,540 --> 00:03:53,500
.مرحبًا، أنا طبيب ساحر

19
00:03:53,710 --> 00:03:56,750
أيوجد أحد مريض أو مجروح هنا؟

20
00:03:57,130 --> 00:04:01,380
هلاّ قدمتم لي الطّعام مقابل المعالجة؟

21
00:04:05,010 --> 00:04:08,310
.يصدف أنّ حفيدي طريح الفراش

22
00:04:10,180 --> 00:04:14,150
.يمكني الانتفاع من يدي لعلاج الحمّة

23
00:04:29,660 --> 00:04:30,910
.لا بدّ وأنّك عانيت

24
00:04:31,250 --> 00:04:32,410
.ستتحسّن قريبًا

25
00:04:33,160 --> 00:04:34,830
.نم جيّدًا

26
00:04:39,840 --> 00:04:41,090
هل أنتِ أخته الصّغيرة؟

27
00:04:41,920 --> 00:04:43,630
.لا تقلقي

28
00:04:43,630 --> 00:04:44,720
.سيكون أخوك على ما يرام

29
00:04:46,720 --> 00:04:47,640
...ذلك الشّخص

30
00:04:48,510 --> 00:04:50,720
.يوجد شيءٌ في ظلّه

31
00:04:54,230 --> 00:04:54,770
!أنا خائفة

32
00:04:55,600 --> 00:04:56,770
!ما الأمر؟

33
00:04:58,190 --> 00:04:59,400
!إنّه وحش

34
00:05:01,110 --> 00:05:02,400
!و-وحش

35
00:05:02,570 --> 00:05:03,240
!بسرعة

36
00:05:04,900 --> 00:05:05,740
!إنّه شرير

37
00:05:05,740 --> 00:05:06,660
!إنّه شيطان

38
00:05:06,660 --> 00:05:09,160
!كان ينوي أخذ الطّفل

39
00:05:09,160 --> 00:05:11,080
.كانت هنالك طفلة في ذلك المكان

40
00:05:11,080 --> 00:05:11,660
.تبًّا

41
00:05:12,410 --> 00:05:13,620
.آسف يا لينديل

42
00:05:13,620 --> 00:05:15,290
.إنّه ليس خطأك

43
00:05:16,080 --> 00:05:17,250
!أيّها الشّيطان

44
00:05:19,960 --> 00:05:21,090
!شيطان

45
00:05:24,380 --> 00:05:26,180
!اقتلوه

46
00:05:28,260 --> 00:05:29,470
!شرير

47
00:05:31,350 --> 00:05:33,430
!شيطان

48
00:05:33,430 --> 00:05:35,100
!سأقتلك

49
00:05:54,200 --> 00:05:55,040
!اطلبوا النّجدة

50
00:05:58,540 --> 00:06:00,290
!توقّف يا إلياس

51
00:06:02,670 --> 00:06:07,510
!يا حجاب الغابة، افتح نفسك لنا

52
00:06:15,390 --> 00:06:16,600
.لقد اختفى

53
00:06:29,910 --> 00:06:31,120
أين نحن؟

54
00:06:35,870 --> 00:06:39,120
.نحن حيث تعيش آلهة الغابة

55
00:06:45,090 --> 00:06:46,210
.لينديل

56
00:06:48,550 --> 00:06:51,800
هذا ما يحدث حين أرغم
.نفسي على استعمال السّحر

57
00:06:52,510 --> 00:06:54,720
.علينا الخروج من هنا بسرعة

58
00:07:18,080 --> 00:07:19,210
.تنوب

59
00:07:23,590 --> 00:07:28,260
.خذنا إلى الخارج، إلى رنّة لينديل

60
00:07:31,970 --> 00:07:34,550
.أنا علّمته ذلك

61
00:07:59,040 --> 00:08:02,120
.إنّك جيّد باستعمال أصابعك على نحوٍ مفاجئ

62
00:08:04,670 --> 00:08:07,590
.رأيتك تفعل هذا مرّات عديدة

63
00:08:09,340 --> 00:08:10,510
.شكرًا لك

64
00:08:16,970 --> 00:08:18,640
هل من خطب ما؟

65
00:08:19,350 --> 00:08:20,350
،لينديل

66
00:08:22,270 --> 00:08:28,360
.أنا متأكّد أنّي أكلت بشرًا من قبل

67
00:08:46,540 --> 00:08:48,340
ما رأيك يا تشيسي؟

68
00:08:48,340 --> 00:08:51,050
ماذا لو كان وحشًا آكلاً للبشر؟

69
00:09:06,350 --> 00:09:12,400
يمكنني رؤية أشياء من الجانب
.الآخر مذ أن كنت صغيرة

70
00:09:12,860 --> 00:09:16,820
الكثير منهم كان يتحدّث عن مدى
.لذّة أو سوء طعم البشر

71
00:09:18,410 --> 00:09:20,620
.كنت خائفةً حقًّا

72
00:09:23,370 --> 00:09:28,790
.ولكنّ إلياس لم يُخفني ولو لمرّة

73
00:09:30,840 --> 00:09:35,680
...لذا، إن كان حقًّا في السّابق

74
00:09:39,220 --> 00:09:42,140
.أخبريه البقيّة بشكلٍ مباشر

75
00:09:42,890 --> 00:09:45,060
.ولكن أنت من سألت

76
00:09:45,350 --> 00:09:46,850
.أنا آسف

77
00:09:48,860 --> 00:09:51,150
.يمكنك حسنة الحديث

78
00:09:51,520 --> 00:09:54,530
.عليك التّحدّث معه هكذا كثيرًا أيضًا

79
00:09:56,200 --> 00:09:58,780
ماذا رددت عليه يا سيّد لينديل؟

80
00:09:58,780 --> 00:09:59,820
أنا؟

81
00:09:59,820 --> 00:10:00,870
...قلت

82
00:10:01,950 --> 00:10:04,700
.لا بدّ وأنّي لذيذ. لا تأكلني

83
00:10:07,420 --> 00:10:09,540
.لن.. آكلك

84
00:10:09,540 --> 00:10:10,630
.حسنًا إذًا

85
00:10:11,710 --> 00:10:15,340
.ولكنّي أودّ ذلك أحيانًا

86
00:10:16,010 --> 00:10:17,590
.على الرّغم من أنّي لا أريد

87
00:10:18,220 --> 00:10:21,470
ألا يخاف البشر ممّن هم مثلي؟

88
00:10:22,100 --> 00:10:26,230
.هنالك آلاف الأشياء الّتي تأكل البشر

89
00:10:26,680 --> 00:10:30,190
.لا داعي لأن أخشاك أنت تحديدًا

90
00:10:32,230 --> 00:10:35,610
،كُل كلّ أنواع الأشياء، وقريبًا

91
00:10:35,610 --> 00:10:38,860
.ستنسى رغبتك المتذبذبة للبشر

92
00:10:40,620 --> 00:10:44,410
.أنهيت المحادثة عمدًا نوعًا ما

93
00:10:44,790 --> 00:10:46,790
.كنت في الحقيقة خائفًا

94
00:10:47,830 --> 00:10:49,370
كنتَ خائفًا؟

95
00:10:49,830 --> 00:10:52,090
،ستُفاجئين أيضًا ولو للحظة على الأقلّ

96
00:10:52,090 --> 00:10:55,630
إن علمتِ أنّ القطّة الّتي تلفلفت على حضنك
أكلت بشرًا في الحقيقة، أليس كذلك؟

97
00:10:56,800 --> 00:10:58,220
أتقارنه بقطّة؟

98
00:11:00,010 --> 00:11:05,060
ولكن، اختفى خوفي مباشرة
.بعد تناولي لرشفة من الحساء

99
00:11:06,680 --> 00:11:10,440
.وكان مذاق الحساء سيّئًا بشكلٍ لا يصدّق بالمناسبة

100
00:11:13,520 --> 00:11:15,730
.مسرورة لوجود سيلكي

101
00:11:16,610 --> 00:11:22,320
.مع ذلك، البشر هم أكثر المخلوقات خوفًا وقسوة

102
00:11:23,370 --> 00:11:28,500
.أخبرته أنّه لا ينبغي عليه أن يخبر النّاس بذلك كثيرًا

103
00:11:28,710 --> 00:11:34,340
ولكنّي لا أعلم ما إن كان يتّبع نصيحتي
...أو إن كان قد حدث شيءٌ آخر

104
00:11:34,710 --> 00:11:38,510
.ولكنّه يرفض أن يخبر الآخرين عن نفسه

105
00:11:40,170 --> 00:11:42,640
.ما يزال طفلاً كما السّابق

106
00:11:43,640 --> 00:11:45,680
.آسفٌ للتّحدّث لوقتٍ طويل

107
00:11:46,010 --> 00:11:47,560
.عليك الخلود للنّوم

108
00:11:54,650 --> 00:11:57,320
لا تستطيعين النّوم يا تشيسي؟

109
00:11:57,610 --> 00:12:00,360
.لا، ولكن شكرًا يا روث

110
00:12:04,410 --> 00:12:08,200
هل بدوت لذيذة؟

111
00:12:11,500 --> 00:12:15,080
.أعتقد أنّي استمعت لشيء لا يودّ قوله

112
00:12:23,930 --> 00:12:24,760
.حلّ الصّباح

113
00:12:26,890 --> 00:12:29,470
.صحيح، أنا في أرض التّنانين

114
00:12:32,980 --> 00:12:36,690
.صباح الخير

115
00:12:38,900 --> 00:12:40,030
!إنّها تشيسي

116
00:12:40,030 --> 00:12:40,990
!بشريّة

117
00:12:40,990 --> 00:12:42,860
!صباح الخير

118
00:12:42,150 --> 00:12:43,150
.صباح الخير

119
00:12:43,150 --> 00:12:43,950
—صباح الخـ

120
00:12:49,660 --> 00:12:51,040
!تشيسي

121
00:12:51,370 --> 00:12:53,750
.تلك الفتاة تسقط في الماء كثيرًا

122
00:13:20,780 --> 00:13:22,570
هل أنتِ بخير يا تشيسي؟

123
00:13:23,110 --> 00:13:25,360
.كان هنالك شيءٌ مذهل

124
00:13:28,950 --> 00:13:31,540
لماذا تقصّ شعري؟

125
00:13:31,540 --> 00:13:35,290
.الشّعر يحمل السّحر منذ قديم الزّمان

126
00:13:35,540 --> 00:13:37,630
.سنستخدم هذا كجوهرٍ لعصاك

127
00:13:37,960 --> 00:13:41,300
.من النّادر رؤية آسيويّين بشعر أحمر مثلك

128
00:13:41,630 --> 00:13:44,010
.إنّه لون مثاليّ للسّحر

129
00:13:45,010 --> 00:13:46,800
،الأحمر هو لون الأرض

130
00:13:47,140 --> 00:13:50,050
.لون اللّهب والدّماء الّتي تتدفّق خلال النّجوم

131
00:13:50,510 --> 00:13:52,520
.اختاري واحدة من القبضات التّالية

132
00:13:53,600 --> 00:13:57,440
.يطرق البيلسان الأحمر على باب الإلهة السّوداء

133
00:13:57,940 --> 00:14:01,940
.الصّفصاف يقف بين الأحياء والموتى

134
00:14:02,530 --> 00:14:06,070
.يطرد البندق الشّرّ

135
00:14:06,530 --> 00:14:08,660
.الطّقسوس رمز الأبديّة

136
00:14:08,660 --> 00:14:11,200
.يمكنه سحب السّحر أو التّخلّص منه

137
00:14:11,490 --> 00:14:16,080
شجرة الغبيراء لديها قوّة حياة
.قويّة وتعيد النّظام للأشرار

138
00:14:18,540 --> 00:14:20,880
.رأيته في أوّل مرّة أتيت

139
00:14:26,340 --> 00:14:29,390
.جعلته يجفف الخشب

140
00:14:29,760 --> 00:14:32,390
.حسنًا، لنبدأ النّحت

141
00:14:35,270 --> 00:14:39,350
.آسف، لا يوجد ما أعلّمك إيّاه

142
00:14:40,190 --> 00:14:43,610
،انحتيها كما تودّين فحسب
.لتكون مريحة لك للاستعمال

143
00:14:44,440 --> 00:14:49,200
من المعتاد أن ينحت الشّخص عصاه
.وأن ينهينها من هو أعلى منه

144
00:14:49,740 --> 00:14:53,280
.سيكون من الجيّد أن تتحدّثين مع نفسك أثناء النّحت

145
00:14:53,870 --> 00:14:55,290
مع نفسي؟

146
00:14:55,290 --> 00:14:57,500
.سأذهب لتفقّد الأرجاء

147
00:14:57,500 --> 00:14:59,500
.خذي وقتك

148
00:15:10,930 --> 00:15:13,100
أتحدّث مع نفسي؟

149
00:15:16,220 --> 00:15:18,600
عليك التّحدّث مع نفسك، أليس كذلك؟

150
00:15:19,190 --> 00:15:20,980
...روث

151
00:15:38,710 --> 00:15:45,500
.أعتقد أنّي لم أفكّر في نفسي من قبل حتّى الآن

152
00:16:26,710 --> 00:16:28,250
.حلّ اللّيل

153
00:16:28,250 --> 00:16:29,090
.ارتاحي

154
00:16:30,130 --> 00:16:32,300
.يا له من تركيز مذهل

155
00:16:32,590 --> 00:16:34,510
.تكادين تنتهين

156
00:16:35,300 --> 00:16:35,930
.نعم

157
00:16:36,430 --> 00:16:38,640
.بقي القليل

158
00:16:40,180 --> 00:16:43,440
.هذا عملٌ جيّد بالنّسبة لمحاولتك الأولى

159
00:16:43,440 --> 00:16:44,850
.لننهها في الغد

160
00:16:50,400 --> 00:16:52,650
.القمر ساطعٌ اليوم

161
00:16:53,030 --> 00:16:55,160
.يمكنني أن أريك شيئًا جيّدًا

162
00:16:57,490 --> 00:16:59,660
.الطّحلب هنا ينبت أزهارًا

163
00:16:59,870 --> 00:17:00,870
أزهار؟

164
00:17:01,250 --> 00:17:03,120
.أنشأ الأقزام هذه الأرض

165
00:17:03,120 --> 00:17:04,370
.إنّهم يعشقونها

166
00:17:04,750 --> 00:17:07,340
.ستتفتّح الأزهار حين ترقصين مع الأقزام

167
00:17:07,790 --> 00:17:10,170
أتعرفين اسمي الآخر؟

168
00:17:10,170 --> 00:17:13,590
إكوز، "أغنية المائة وردة"؟

169
00:17:13,590 --> 00:17:18,640
.الأسماء مهمّة للغاية بالنّسبة للسّحرة والمشعوذين

170
00:17:18,930 --> 00:17:22,560
عادة ما يُنادَوْن بالاسم الّذي يصف
.مواصفاتهم وطبيعتهم الحقيقيّة

171
00:17:29,320 --> 00:17:31,860
.تعاويذي عبارة عن أغنيات

172
00:17:33,440 --> 00:17:36,200
.لندعها تزهر لنا بشكلٍ خاصّ لهذه اللّيلة

173
00:18:18,820 --> 00:18:24,290
.كذوبان الثّلج، كان منخفضًا ومرتفعًا

174
00:18:24,290 --> 00:18:26,210
.كان يتردّد صداه من خلال الرّياح

175
00:18:28,790 --> 00:18:30,670
.لنرقص

176
00:18:30,670 --> 00:18:32,050
كائنات إلف؟

177
00:18:32,050 --> 00:18:33,630
.لم أرقص من قبل

178
00:18:34,170 --> 00:18:36,930
.دوري من حولهم فحسب

179
00:18:37,680 --> 00:18:41,100
،استمعي جيّدًا للصّوت، للأغنية

180
00:18:41,100 --> 00:18:44,140
.لصوت الرّياح، لصوت المياه

181
00:18:44,720 --> 00:18:47,980
ما تزال البشريّة تتذكّر الأصوات

182
00:18:47,980 --> 00:18:51,520
،الّتي ملأت أجسادنا منذ القدم
.حتّى قبل اللّغات بحدّ ذاتها

183
00:18:59,160 --> 00:19:00,950
.السّحر كذلك أيضًا

184
00:19:01,570 --> 00:19:04,790
.استمعي لما هو حولك، ومُدّي يدك له

185
00:19:05,330 --> 00:19:07,460
.ما تزال تتذكّرين ذلك

186
00:19:29,270 --> 00:19:31,060
.أنا مُرهقة

187
00:19:53,750 --> 00:19:58,460
.أتساءل ما الّذي كان سيقوله لو رأى هذا المنظر

188
00:20:01,380 --> 00:20:02,640
.إلياس

189
00:20:04,600 --> 00:20:05,510
.تشيسي

190
00:20:05,720 --> 00:20:07,600
لماذا صنعتِ مرآة مائيّة؟

191
00:20:07,930 --> 00:20:09,180
مرآة مائيّة؟

192
00:20:09,600 --> 00:20:13,520
.المرآة المائيّة تدعك ترين شخصًا من خلال الماء

193
00:20:15,230 --> 00:20:15,940
ماذا؟

194
00:20:16,570 --> 00:20:18,360
هل يغني الآن؟

195
00:20:18,360 --> 00:20:19,190
.نعم

196
00:20:19,740 --> 00:20:20,950
.لا عجب

197
00:20:21,450 --> 00:20:24,870
.وصلَ سحره هناك إلى هنا

198
00:20:25,370 --> 00:20:26,910
.فهمت

199
00:20:27,870 --> 00:20:29,040
...إلياس

200
00:20:29,330 --> 00:20:30,160
ماذا؟

201
00:20:31,580 --> 00:20:34,630
.تبدو مضطربًا

202
00:20:35,000 --> 00:20:36,790
هل حدث شيءٌ ما؟

203
00:20:38,130 --> 00:20:39,550
.نعم

204
00:20:39,550 --> 00:20:40,220
.قليلاً

205
00:20:41,130 --> 00:20:42,220
هل كلّ شيء على ما يرام؟

206
00:20:46,850 --> 00:20:51,940
.البيت باردٌ قليلاً من دونك

207
00:20:52,940 --> 00:20:55,860
.على الرّغم من أنّه الصّيف والموقد مشتعل

208
00:21:01,190 --> 00:21:03,950
.الأزهار جميلة هنا

209
00:21:04,410 --> 00:21:06,660
.أتمنّى لو كان بإمكاني أن أريك إيّاها

210
00:21:07,490 --> 00:21:10,950
.أنتِ شاهديها وأخبريني عنها عندما تعودين

211
00:21:16,830 --> 00:21:18,380
.هذا القليل منها

212
00:21:31,930 --> 00:21:33,140
،إلياس

213
00:21:33,940 --> 00:21:38,190
.سمعت العديد من الأمور عنك

214
00:21:39,270 --> 00:21:41,150
...ذلك العجوز

215
00:21:41,530 --> 00:21:47,660
.لذا سأخبرك بما لم أتمكّن من إخباره إيّاه أيضًا

216
00:21:50,410 --> 00:21:53,000
.سأعود حالما تنتهي عصاي

217
00:21:53,540 --> 00:21:54,460
.حسنًا

218
00:21:54,460 --> 00:21:55,420
.أرجوك

219
00:22:00,340 --> 00:22:02,170
.طفلان

220
00:22:02,170 --> 00:22:06,510
.ليس لديّ أطفال، ولكنّي أشعر أنّي أربّيهما

221
00:23:55,830 --> 00:24:02,210
الفتاة الّتي لم تمتلك مكانًا ترجع إليه دُلّت
.على الطّريق بواسطة عصا ليندينباوم

222
00:24:02,210 --> 00:24:05,250
ماذا تختار في نهاية تجوالها؟

223
00:24:05,840 --> 00:24:09,050
.صلني بذلك الشّخص