1
00:01:35,990 --> 00:01:39,370
...تشيسي

2
00:01:47,210 --> 00:01:53,500
!تشيسي

3
00:02:09,150 --> 00:02:13,730
.لا نرحم أيًّا كان من يلوّث هذا الرّبوة يا آينسورث

4
00:02:13,730 --> 00:02:15,320
.اتركوني

5
00:02:15,320 --> 00:02:19,110
ما الّذي تنوي فعله بهذه الهيئة
الدّنيئة أيّها الوحش الهجين؟

6
00:02:19,610 --> 00:02:23,580
.اتركوني

7
00:02:23,870 --> 00:02:31,380
تدعو نفسك ساحرًا، ولكنّك الآن بعيد
.كلّ البعد عنّا نحن والبشر أيضًا

8
00:02:31,380 --> 00:02:34,630
هل ستصبح وحشًا مهووسًا؟

9
00:02:35,840 --> 00:02:37,380
!أيّها المغفل

10
00:02:40,260 --> 00:02:41,840
.طفل مسكين

11
00:02:44,260 --> 00:02:45,060
...ملكتي

12
00:02:45,470 --> 00:02:46,770
أتيتِ وحيدة؟

13
00:02:47,430 --> 00:02:48,890
.هذا غصن

14
00:02:49,520 --> 00:02:54,690
،جسد بديل، عينان بديلتان
.أذنان بديلتان، فمٌ بديل

15
00:02:55,570 --> 00:02:59,610
.فقدان غصن لا يضرّ الشّجرة

16
00:03:01,070 --> 00:03:03,620
...إلياس، أيّها الطّفل المسكين

17
00:03:04,580 --> 00:03:09,500
،تقول أنّك لا تريد أن يُشفق عليك

18
00:03:09,500 --> 00:03:12,580
ولكن سامحني على الإشفاق عليك
.بغضّ النّظر عن ذلك

19
00:03:15,460 --> 00:03:19,170
تركتك تلك الفتاة، أليس كذلك؟

20
00:03:19,760 --> 00:03:22,590
تشيسي... لماذا؟

21
00:03:23,140 --> 00:03:30,940
.أنتِ من قال أنّك ستبقين معي حتّى أنتهي منك

22
00:03:33,480 --> 00:03:39,320
.إنّك كالبشر كثيرًا، ولكنّ طريقة حبّك هي مثلنا

23
00:03:39,940 --> 00:03:42,610
،لا ينبغي أن تتشاجر مع زوجتك

24
00:03:42,610 --> 00:03:46,530
.ولكن قد يكون ذلك ضروريًّا أحيانًا

25
00:03:46,530 --> 00:03:47,910
أنت أيضًا يا ملكي؟

26
00:03:47,910 --> 00:03:52,710
.سنساعدك إن كنت ستلحقها يا طفلي الحبيب

27
00:03:52,960 --> 00:03:53,830
.نعم

28
00:03:54,750 --> 00:03:58,000
.يموت البشر في لحظة

29
00:03:58,500 --> 00:04:04,550
مات أحبّاء تيتانيا قصيري الأجل
.فور إزاحة نظرها عنهم

30
00:04:05,970 --> 00:04:07,310
...لذا

31
00:04:11,520 --> 00:04:13,810
،عندما تمسك بها

32
00:04:13,810 --> 00:04:18,110
.عليك منعها من الخروج كي لا تهرب

33
00:04:18,860 --> 00:04:24,410
.لا بأس، سنجدها بسرعة ونرجعها إليك

34
00:04:25,410 --> 00:04:28,240
.لذا لا تقلق

35
00:04:28,240 --> 00:04:30,120
.ابقَ هنا فحسب

36
00:04:30,910 --> 00:04:37,710
.وسنعيش جميعًا في أرض الشّباب الأبديّ

37
00:04:46,430 --> 00:04:47,300
...لا

38
00:04:47,300 --> 00:04:48,140
.لا أريد ذلك

39
00:04:51,310 --> 00:04:55,810
.إنّها تفكّر مثلي

40
00:04:59,230 --> 00:05:01,320
...أنت أيضًا في نهاية المطاف

41
00:05:02,900 --> 00:05:05,150
.لا يمكن أن يكون الأمر هكذا

42
00:05:05,570 --> 00:05:08,990
.ولكن نحن هكذا

43
00:05:08,990 --> 00:05:10,990
.إنّه جزء من هويّتك أيضًا

44
00:05:11,450 --> 00:05:14,160
.لا يمكنك تغيير طريقتك في الحبّ لوحدك

45
00:05:14,750 --> 00:05:16,210
،مع ذلك

46
00:05:17,540 --> 00:05:20,040
...من أجل العيش معها

47
00:05:20,920 --> 00:05:24,260
...إن كانت تشيسي ستنظر إليّ ثانية

48
00:05:31,600 --> 00:05:35,480
.عليّ إعادة التّفكير في أساليبي

49
00:05:39,060 --> 00:05:41,820
أتعرف مكان تشيسي يا روث؟

50
00:05:42,230 --> 00:05:43,650
.إنّها ترفضني

51
00:05:44,240 --> 00:05:45,650
.لا أستطيع الاقتراب منها

52
00:05:47,150 --> 00:05:48,660
.يا إلهي

53
00:05:48,660 --> 00:05:53,870
لِمَ تعتقدان أنّني مددت أغصاني يا فتيان؟

54
00:05:54,580 --> 00:05:58,120
.تمتدّ أغصان جسدي إلى الإلهة موريغان

55
00:05:58,120 --> 00:06:00,330
.إنّها تتبرعم في أماكن كثيرة

56
00:06:00,790 --> 00:06:07,880
قد لا يعجبك ذلك، ولكنّكما
.ما تزالان طفلاي الحبيبان

57
00:06:08,880 --> 00:06:14,930
للتّعويض عن عدم قدرتي على منع نفسي
.من الإشفاق عليك، سأقدّم لك مساعدتي

58
00:06:24,690 --> 00:06:28,320
.لفّ شوكك حول أغصاني

59
00:06:29,070 --> 00:06:32,490
.ولنُعد رفيقتك إلى المنزل

60
00:07:19,710 --> 00:07:20,870
أليس؟

61
00:07:20,870 --> 00:07:22,290
.أصابتني قشعريرة

62
00:07:24,000 --> 00:07:25,750
!سحقًا

63
00:07:25,750 --> 00:07:29,260
تلك الملكة لا تعرف كيف تطلب
.من الآخرين معروفًا حقًّا

64
00:07:32,340 --> 00:07:35,760
.أودع رسوم التّدليك هنا من فضلك

65
00:07:36,350 --> 00:07:37,810
.شكرًا لك

66
00:07:40,560 --> 00:07:41,640
.مارييل

67
00:07:42,310 --> 00:07:43,230
بيليس؟

68
00:07:43,600 --> 00:07:44,520
...لماذا

69
00:07:45,690 --> 00:07:47,780
ماذا أخبرت ذلكما الاثنين؟

70
00:07:48,190 --> 00:07:50,320
كـ-كيف تعرفين؟

71
00:07:50,740 --> 00:07:52,780
هل نسيتِ قانوننا؟

72
00:07:53,410 --> 00:07:56,780
.لا ينبغي علينا أذيّة النّاس أبدًا

73
00:07:57,330 --> 00:08:00,790
.علينا معرفة أساليب أذيّتهم لكي نتجنّبها

74
00:08:00,790 --> 00:08:04,130
!أنتِ قديسة إلى أيّ حد؟

75
00:08:04,790 --> 00:08:09,920
توقّفي عن الاهتمام ببعض
!الغرباء واهتمّي لنفسك أكثر

76
00:08:10,720 --> 00:08:12,590
.افقدي الأمل بي

77
00:08:13,050 --> 00:08:14,680
.سأترك الطّائفة أيضًا

78
00:08:15,090 --> 00:08:17,890
.ستكونون أفضل حالاً دون مثيرةٍ للمشاكل مثلي

79
00:08:24,310 --> 00:08:29,900
لا تزالين طفلة إن كنتِ تعتقدين
.أنّك الوحيدة الّتي تشعر بالوحدة

80
00:08:30,530 --> 00:08:33,530
.افعلي ما يجب فعله

81
00:08:34,280 --> 00:08:39,830
،إن كنتِ من خلق تلك الفرصة
.فإنّ مساعدتهم هي واجبك

82
00:08:42,330 --> 00:08:44,120
...ماذا تقصدين بذلك

83
00:08:45,540 --> 00:08:47,460
!يا إلهي

84
00:09:08,730 --> 00:09:15,320
...هذا يؤلم

85
00:09:15,450 --> 00:09:20,200
...يؤلم

86
00:09:16,950 --> 00:09:18,240
.النّجدة

87
00:09:20,200 --> 00:09:21,160
.النّجدة

88
00:09:32,960 --> 00:09:35,260
.إنّه حفّار القبور الوضيع ذاك

89
00:09:35,260 --> 00:09:37,260
.سمعت أنّه يتحدّث مع الموتى

90
00:09:37,260 --> 00:09:38,470
.إنّه مشعوذ

91
00:09:38,470 --> 00:09:41,260
.إنّه ملوّث، لا تقتربوا منه

92
00:09:41,260 --> 00:09:42,310
.أنا خائف

93
00:09:42,720 --> 00:09:45,560
كيف له أن يستخدم شعوذة ملتوية كهذه؟

94
00:09:45,560 --> 00:09:47,390
.رائحته نتنة، لا تقتربوا منه

95
00:09:47,390 --> 00:09:48,100
.لا تنظر

96
00:09:51,270 --> 00:09:52,480
.ساعدني

97
00:09:58,820 --> 00:10:00,030
أيوجد أحد هناك؟

98
00:10:01,870 --> 00:10:03,240
.ساعدني

99
00:10:11,920 --> 00:10:13,750
.ساعدني

100
00:10:38,860 --> 00:10:40,160
هل استيقظت؟

101
00:10:40,910 --> 00:10:42,160
.هذا مذهل

102
00:10:42,160 --> 00:10:43,580
...كيف

103
00:10:44,830 --> 00:10:46,330
.أنا يوسف

104
00:10:46,790 --> 00:10:47,660
وأنت؟

105
00:10:48,620 --> 00:10:51,540
.كارتفيلس

106
00:10:51,960 --> 00:10:54,300
كارتفيلس؟

107
00:10:56,260 --> 00:10:57,300
.هذا يؤلم

108
00:10:59,510 --> 00:11:00,800
.ساعدني

109
00:11:02,550 --> 00:11:04,560
،ساعدني

110
00:11:05,640 --> 00:11:07,560
.أرجوك

111
00:11:09,690 --> 00:11:11,520
أنا؟

112
00:11:14,190 --> 00:11:15,070
.حسنًا

113
00:11:15,480 --> 00:11:16,610
!اعتمد عليّ

114
00:12:09,080 --> 00:12:10,120
!أمّي

115
00:12:11,540 --> 00:12:12,540
.مرحبًا بعودتك

116
00:12:12,540 --> 00:12:13,790
!لقد عدت

117
00:12:19,840 --> 00:12:22,840
.سأساعدك

118
00:12:25,680 --> 00:12:27,930
.حتمًا

119
00:12:28,600 --> 00:12:29,600
.أنا فقط

120
00:12:35,980 --> 00:12:38,020
.يا حفّار القبور الشّقيّ

121
00:12:39,360 --> 00:12:40,900
.قف

122
00:12:40,900 --> 00:12:42,780
أنت طفل مشعوذة، أليس كذلك؟

123
00:12:52,750 --> 00:12:54,750
...يوسف

124
00:12:54,750 --> 00:12:57,920
،عندما تتحسّن

125
00:12:58,840 --> 00:13:02,050
.لنترك هذه القرية الغبيّة ونسافر معًا

126
00:13:02,050 --> 00:13:04,510
.ولنعش بسعادة معًا

127
00:13:04,510 --> 00:13:05,380
حسنًا؟

128
00:13:10,810 --> 00:13:12,770
.عندما تتحسّن

129
00:13:13,520 --> 00:13:14,730
.بسرعة

130
00:13:16,440 --> 00:13:19,650
.تحسّن بسرعة

131
00:13:23,650 --> 00:13:27,660
!لماذا؟

132
00:13:25,450 --> 00:13:26,360
لماذا؟

133
00:13:27,660 --> 00:13:30,620
!لِمَ لا تتحسّن ولا تسوء حالتك؟

134
00:13:30,620 --> 00:13:32,410
!جرّبت كلّ شيء

135
00:13:34,290 --> 00:13:36,750
...أنا، نحن

136
00:13:37,710 --> 00:13:38,880
...متى سنقوم

137
00:13:40,920 --> 00:13:44,130
.أردت مساعدتك

138
00:13:44,760 --> 00:13:50,720
لم يطلب أحد المساعدة من
.حفّار قبور قذر مثلي من قبل

139
00:13:50,720 --> 00:13:52,680
...يوسف

140
00:13:53,310 --> 00:13:54,810
...لهذا أنا

141
00:13:55,230 --> 00:13:58,980
.أريد أن أحظى بحياة هنيئة فحسب

142
00:14:04,900 --> 00:14:06,780
.صحيح

143
00:14:07,240 --> 00:14:10,070
لِمَ لم ألحظ شيئًا بغاية البساطة؟

144
00:14:10,490 --> 00:14:11,990
.أنت لا تموت

145
00:14:12,450 --> 00:14:14,450
.لا تموت مهما حدث

146
00:14:17,410 --> 00:14:19,540
.علينا أن نصبح واحدًا فحسب

147
00:14:23,340 --> 00:14:26,800
.لنُنقَذ معًا يا كارتفيلس

148
00:14:34,010 --> 00:14:35,310
.معًا

149
00:14:40,100 --> 00:14:40,980
...هذا يؤلم

150
00:14:40,980 --> 00:14:47,690
...يوسف

151
00:14:41,810 --> 00:14:49,990
...يؤلم

152
00:14:49,990 --> 00:14:50,990
!يؤلم

153
00:14:54,370 --> 00:14:56,950
إنّه على قيد الحياة حتّى في تلك الحالة؟

154
00:14:56,950 --> 00:14:58,830
.هذا يؤلم، النّجدة

155
00:14:58,830 --> 00:15:00,000
.فلنذهب

156
00:15:00,790 --> 00:15:02,210
.هذا يؤلم

157
00:15:07,050 --> 00:15:09,590
هل أنت بخير؟ هل يمكنك المشي؟

158
00:15:10,550 --> 00:15:11,890
.النّجدة

159
00:15:12,340 --> 00:15:14,180
.هيّا، أمسك يدي

160
00:15:20,730 --> 00:15:22,980
.يمكنني المشي جيّدًا الآن

161
00:15:22,980 --> 00:15:24,110
.شكرًا لك

162
00:15:24,820 --> 00:15:26,190
...يوسف

163
00:15:26,190 --> 00:15:27,110
من هذا؟

164
00:15:29,950 --> 00:15:33,320
.لا يمكن فكّ لعنتك

165
00:15:33,870 --> 00:15:35,950
.إنّها لعنة قديمة قويّة

166
00:15:37,240 --> 00:15:39,660
من ألقاها عليك؟

167
00:15:41,000 --> 00:15:42,330
.لا أدري

168
00:15:42,830 --> 00:15:44,840
.لم أعد أذكر ذلك

169
00:15:45,750 --> 00:15:47,130
...يوسف

170
00:15:47,420 --> 00:15:48,800
من تكون؟

171
00:15:49,550 --> 00:15:51,220
ماذا تريد؟

172
00:15:51,680 --> 00:15:53,340
لِمَ تناديني؟

173
00:15:53,890 --> 00:15:54,850
من تكون؟

174
00:15:55,510 --> 00:15:56,600
.هذا يؤلم

175
00:15:57,350 --> 00:15:59,430
.يؤلم

176
00:16:00,020 --> 00:16:02,390
.فليساعدني أحد

177
00:16:05,310 --> 00:16:07,110
.الجوّ بارد للغاية

178
00:16:10,820 --> 00:16:15,320
كارتفيلس؟ من هذا ثانيةً؟

179
00:16:15,320 --> 00:16:19,410
ألم يكن ذلك هو الشّخص الّذي رمى
حجرًا على طفل الإله ولُعن لذلك؟

180
00:16:19,410 --> 00:16:21,040
ماذا؟

181
00:16:22,460 --> 00:16:24,040
...كارتفيلس

182
00:16:29,550 --> 00:16:31,420
...لهذا السّبب، أنا

183
00:16:32,090 --> 00:16:33,470
...نحن

184
00:16:34,340 --> 00:16:37,180
.نريد أن نُنقَذ فحسب

185
00:16:38,140 --> 00:16:39,600
متى سينتهي هذا؟

186
00:16:40,180 --> 00:16:41,770
إلى متى سيستمرّ الألم؟

187
00:16:42,140 --> 00:16:44,520
إلى متى علينا العيش بألم؟

188
00:16:45,150 --> 00:16:47,270
.لا أريد

189
00:16:47,610 --> 00:16:49,980
.النّجدة

190
00:16:53,450 --> 00:16:55,070
!ليساعدني أحدٌ ما

191
00:17:05,830 --> 00:17:07,000
هل رأيته؟

192
00:17:07,630 --> 00:17:11,340
ما... ماضيّ؟

193
00:17:17,470 --> 00:17:19,640
.على الرّغم من أنّني نسيته

194
00:17:20,510 --> 00:17:21,600
.هذا يؤلم

195
00:17:21,930 --> 00:17:25,770
.تتدفّق ذكرياته إليّ لأنّنا متصلان

196
00:17:22,520 --> 00:17:23,890
!هذا يؤلم

197
00:17:26,100 --> 00:17:27,270
...أنت

198
00:17:28,360 --> 00:17:29,940
لِمَ تنظرين إليّ هكذا؟

199
00:17:31,230 --> 00:17:31,980
...أنت

200
00:17:32,360 --> 00:17:33,490
!توقّفي

201
00:17:48,290 --> 00:17:53,130
.كلّ ما أحتاجه هو يدك

202
00:17:59,470 --> 00:18:01,220
.وجدتك

203
00:18:07,520 --> 00:18:09,060
.كارتفيلس

204
00:18:09,060 --> 00:18:12,270
!لا تنادني بذلك الاسم

205
00:18:12,690 --> 00:18:15,190
هذا ينهي شؤونك النّزويّة على
.ما أعتقد يا ملكتي

206
00:18:13,280 --> 00:18:14,820
...تتدخّل ثانيةً

207
00:18:15,190 --> 00:18:16,240
!لنرجع

208
00:18:16,240 --> 00:18:18,160
.هيّا يا تشيسي، فلنرجع

209
00:18:18,160 --> 00:18:19,780
.هذا المكان خطر

210
00:18:19,780 --> 00:18:22,030
على جميعكم تذوّق ما هو شعور

211
00:18:24,240 --> 00:18:26,000
،التّعفّن لألفَيْ سنة

212
00:18:26,660 --> 00:18:29,420
!غير قادرين على الموت إطلاقًا

213
00:18:39,340 --> 00:18:41,180
ما الّذي يجري هنا؟

214
00:18:42,010 --> 00:18:43,350
هل أنتِ بخير؟

215
00:18:43,350 --> 00:18:47,270
.ظهر هذا فجأة وقال أنّك في خطر

216
00:18:48,020 --> 00:18:49,850
لحظة، ما بال عينك؟

217
00:18:50,690 --> 00:18:51,690
لماذا؟

218
00:18:52,400 --> 00:18:54,110
.هذا يحدث دائمًا عندما أكاد أنجح

219
00:18:54,730 --> 00:18:57,900
!كان هذا أفضل تقدم منذ عقود! بل قرون

220
00:18:58,860 --> 00:19:02,280
لماذا؟

221
00:19:02,910 --> 00:19:03,740
!لماذا؟

222
00:19:04,280 --> 00:19:06,160
.هيّا يا تشيسي، فلنرجع

223
00:19:06,870 --> 00:19:08,460
لمَ أنا؟

224
00:19:08,460 --> 00:19:10,920
!لِمَ عليّ المرور بهذا؟

225
00:19:12,040 --> 00:19:15,380
!ما الّذي فعلته لأستحقّ هذا؟

226
00:19:17,340 --> 00:19:19,010
ما هذا؟

227
00:19:19,010 --> 00:19:20,090
.الأموات الّذين لم يرقدوا بسلام

228
00:19:20,090 --> 00:19:21,640
.كلّ الّذين رتقهم معًا

229
00:19:21,640 --> 00:19:22,890
.هذا يؤلم

230
00:19:23,220 --> 00:19:24,350
!يؤلم

231
00:19:24,890 --> 00:19:29,140
إلى متى عليّ أن أعاني من جريمة
لا أتذكّر ارتكابها حتّى؟

232
00:19:29,640 --> 00:19:32,100
سحقًا، كم يوجد منهم؟

233
00:19:32,100 --> 00:19:33,690
.هنالك الكثير منهم

234
00:19:33,690 --> 00:19:35,400
.لن يكفوا جميعًا في الجحيم

235
00:19:33,860 --> 00:19:36,190
...النّجدة

236
00:19:38,030 --> 00:19:39,990
.إنّه يحاول الهروب من خلال قناة أخرى

237
00:19:41,610 --> 00:19:42,610
.النّجدة

238
00:19:42,610 --> 00:19:43,530
تشيسي؟

239
00:19:43,530 --> 00:19:45,830
.آسفة، هنالك ما عليّ فعله

240
00:19:47,080 --> 00:19:47,990
!ملكتي

241
00:19:47,990 --> 00:19:50,370
.رُفضت ثانيةً

242
00:19:52,620 --> 00:19:54,130
!النّجدة

243
00:20:06,890 --> 00:20:09,180
!إلى متى ستظلّ واقفًا هكذا؟

244
00:20:09,180 --> 00:20:10,520
!الحق بها

245
00:20:11,390 --> 00:20:12,350
...ولكن

246
00:20:13,560 --> 00:20:16,980
أم أنّك لا تمانع فقدانها حين
تكون في مكانٍ لا تصل إليه؟

247
00:20:27,370 --> 00:20:31,870
.أيّتها الفتاة، أعطيني بعضًا من سحرك

248
00:20:32,330 --> 00:20:36,250
.أشتمّ رائحة النّيران من روحك

249
00:20:36,250 --> 00:20:38,420
.رائحتها لذيذة

250
00:20:40,300 --> 00:20:44,470
.لا أمانع أن أقلّكم عبر النّهر في المقابل

251
00:20:47,760 --> 00:20:48,930
.لا أستطيع اللّحاق به

252
00:20:50,100 --> 00:20:53,190
!انتبه وأنت تركض

253
00:20:54,230 --> 00:20:55,480
.الآنسة مارييل

254
00:20:56,810 --> 00:20:58,230
ماذا تفعلين؟

255
00:20:58,230 --> 00:21:00,650
.لا يمكنك الدّخول إلى زقاق كهذا

256
00:21:01,030 --> 00:21:02,780
...كنت على وشك القدوم

257
00:21:03,400 --> 00:21:06,740
.حالتك أصبحت أسوأ من قبل

258
00:21:07,660 --> 00:21:11,370
.آسفة، عليّ اللّحاق به

259
00:21:13,540 --> 00:21:15,370
.ما باليد حيلة

260
00:21:16,000 --> 00:21:17,420
.اعتبريه اعتذاري

261
00:21:24,010 --> 00:21:25,590
ثـ-ثور؟

262
00:21:27,390 --> 00:21:28,890
.تمسّكي جيّدًا

263
00:21:40,320 --> 00:21:42,150
هل أنت هنا يا إلياس؟

264
00:21:42,690 --> 00:21:43,650
.نعم

265
00:21:44,110 --> 00:21:47,530
.ما زلت غاضبة عليك كثيرًا

266
00:21:47,530 --> 00:21:48,740
.آسف

267
00:21:48,740 --> 00:21:50,370
.أريدك أن تعوّضني

268
00:21:50,370 --> 00:21:51,160
.أنت أيضًا يا روث

269
00:21:53,370 --> 00:21:55,620
.أريدكما أن تساعدانني في أمر ما

270
00:21:55,620 --> 00:21:59,920
.ولكن أريدكما أن تقطعا وعدًا من أجل ذلك

271
00:21:59,920 --> 00:22:01,000
وعد؟

272
00:23:55,910 --> 00:23:58,200
.تواجه الفتاة يوسف

273
00:23:58,200 --> 00:24:05,000
هل ستجلب نهاية للعذاب غير المنتهي
في مدينة لندن، حيث بدأ كلّ شيء؟

274
00:24:06,460 --> 00:24:09,510
.لننهِ الأمر إذًا