1
00:01:41,950 --> 00:01:43,290
موت؟

2
00:01:43,290 --> 00:01:44,700
موتي؟

3
00:01:53,000 --> 00:01:56,930
سلي بيغي عبارة عن كنوز يمكنك أن تنتج
،كميّات لا متناهية من السّحر خلالهم

4
00:01:57,300 --> 00:01:59,640
.ولكنّ أجسادكم ضعيفة للغاية

5
00:02:00,390 --> 00:02:04,810
إنّكم تمتصّون وتنتجون السّحر
.بلا توقّف بمجرّد كونكم أحياءً

6
00:02:05,560 --> 00:02:08,350
.لن يصبح جسدك قادرًا على التّحمّل في النّهاية

7
00:02:08,900 --> 00:02:11,360
.فهمك للموضوع عميق يا أليس

8
00:02:11,360 --> 00:02:11,810
.ليس كذلك

9
00:02:12,570 --> 00:02:17,240
إنّه يبقيك حيّة دون أخذ أيّ إجراءات
،لإبقائك بعيدة عن الخطر

10
00:02:17,240 --> 00:02:19,610
.لمجرّد أن يشبع فضوله

11
00:02:26,620 --> 00:02:27,910
...تلك الدّوخة

12
00:02:29,830 --> 00:02:33,040
.إنّه لا يملك مشاعرًا يا تشيسي

13
00:02:33,840 --> 00:02:38,760
لا ينبغي أن تتوقّفي لطفًا بشريًّا
.من بشريّ زائف

14
00:02:39,470 --> 00:02:42,930
.اشتراك بالمال وطوّقك بذلك الشّيء

15
00:02:43,640 --> 00:02:45,640
.ألقى عليها تعويذة تقفّي أثر

16
00:02:46,520 --> 00:02:47,890
.لا بدّ وأنّك عانيت

17
00:02:52,150 --> 00:02:55,650
.نحن سنحرّرك

18
00:03:08,540 --> 00:03:09,830
!إيريل

19
00:03:10,920 --> 00:03:12,000
!سيّدي

20
00:03:15,840 --> 00:03:18,170
.هذا المكان منطقتنا

21
00:03:18,170 --> 00:03:21,180
.لن أسمح لمشعوذين بالتّجوّل هنا

22
00:03:21,340 --> 00:03:23,050
هل أنت بخير يا إيريل؟

23
00:03:23,550 --> 00:03:27,470
.نعم، أنا بخير ما دمت لا ألمس المعدن

24
00:03:27,890 --> 00:03:29,020
لماذا؟

25
00:03:29,020 --> 00:03:30,890
ألا تريدين أن تتحرّري؟

26
00:03:32,810 --> 00:03:33,900
ممّاذا؟

27
00:03:34,440 --> 00:03:38,480
،إن كنت تعني من إلياس
.فإنّك على الأرجح لا تفهم

28
00:03:39,030 --> 00:03:43,410
حتّى وإن كان يكذب، فإنّه الوحيد
.الّذي اعتبرني عائلته من قبل

29
00:03:44,070 --> 00:03:47,620
لا يهمّني ما إن كان ما قلته
.كذبًا أو حقيقة

30
00:03:48,540 --> 00:03:51,500
.إنّه أوّل شخص قد قدّر قيمتي

31
00:03:52,920 --> 00:03:56,670
،لذا إلى أن يفلت إلياس يدي

32
00:03:58,300 --> 00:03:59,960
.فإنّي أنتمي له

33
00:04:06,890 --> 00:04:07,560
!أليس

34
00:04:08,770 --> 00:04:10,270
هل نسيت؟

35
00:04:10,850 --> 00:04:12,060
.أنا ظلّ

36
00:04:13,690 --> 00:04:15,810
.أختفي في ظلال الأشواك

37
00:04:16,190 --> 00:04:19,530
.أنا ما تطلقون عليه بيلوم مورياليس

38
00:04:25,780 --> 00:04:27,700
هل أنتِ بخير يا تشيسي؟

39
00:04:27,700 --> 00:04:28,580
.نعم

40
00:04:28,580 --> 00:04:29,740
.أريني جرحك

41
00:04:29,990 --> 00:04:30,910
جرحي؟

42
00:04:30,910 --> 00:04:32,330
.كان ذلك تهوّرًا منك

43
00:04:33,540 --> 00:04:34,710
...هذا مؤلم

44
00:04:34,710 --> 00:04:38,090
.البشر يموتون بسرعة بعد أن يُجرحون

45
00:04:38,290 --> 00:04:39,590
!لقد تأخّرت

46
00:04:39,590 --> 00:04:41,510
!اعتقدت أنّ الظّلال سريعة

47
00:04:41,510 --> 00:04:42,920
.تشيسي كانت هنا

48
00:04:42,920 --> 00:04:44,300
.ما باليد حيلة

49
00:04:49,560 --> 00:04:51,470
.القيد يرتخي

50
00:04:51,930 --> 00:04:54,440
.لا مشكلة في هذا المكان يا تشيسي

51
00:04:54,440 --> 00:04:56,100
.أعتمد عليكما بتطهيره

52
00:04:56,440 --> 00:04:57,310
.حسنًا

53
00:04:57,770 --> 00:04:59,110
.سآتي معك

54
00:04:59,440 --> 00:05:00,400
!أيّتها الملك

55
00:05:02,190 --> 00:05:04,360
.لا داعي للقلق

56
00:05:04,360 --> 00:05:06,360
.أنا وتشيسي يمكنني تدبّر الأمر

57
00:05:06,360 --> 00:05:12,450
مهمّة الملك الأخيرة هي
.أن أشهد على انقضاء الفساد

58
00:05:12,830 --> 00:05:14,040
أليس كذلك؟

59
00:05:58,210 --> 00:06:00,170
!تشيسي

60
00:06:00,170 --> 00:06:01,420
هل أنتِ بخير؟

61
00:06:02,300 --> 00:06:03,420
أين نحن؟

62
00:06:03,710 --> 00:06:05,720
.حانة من قديم الزّمان

63
00:06:05,720 --> 00:06:07,510
.مكان للأكل

64
00:06:07,510 --> 00:06:10,350
.المدينة المجاورة كانت جميلة

65
00:06:10,350 --> 00:06:12,560
سمعت أنّ هناك العديد
.من النّساء الجميلات هناك أيضًا

66
00:06:12,560 --> 00:06:13,810
.يمكنني الرّؤية من خلال جسدي

67
00:06:14,720 --> 00:06:17,560
.يبدو أنّنا في داخل ذكريات الفساد

68
00:06:20,310 --> 00:06:21,610
...ذلك الرّجل

69
00:06:25,990 --> 00:06:27,320
.شكرًا جزيلاً لك

70
00:06:34,910 --> 00:06:38,580
هل أنت المشعوذ المتجوّل؟

71
00:06:43,590 --> 00:06:45,670
.نعم، صحيح

72
00:06:46,300 --> 00:06:48,420
هل أنت متفاجئ لأنّي صغير للغاية؟

73
00:06:49,130 --> 00:06:50,760
هل تريد مساعدة ما؟

74
00:06:50,760 --> 00:06:52,220
أيمكنك معرفة ذلك؟

75
00:06:53,180 --> 00:06:57,060
العديد من الأشخاص يعتمدون
.عليّ أثناء سفري

76
00:06:57,390 --> 00:06:58,770
حصادك سيّئ؟

77
00:06:58,770 --> 00:07:01,100
تريد لفت انتباه سيّدة وقعت بحبّها؟

78
00:07:01,100 --> 00:07:05,070
.لا، جسد زوجتي ضعيف منذ الولادة

79
00:07:05,690 --> 00:07:07,610
.سرعان ما تكون طريحة الفراش

80
00:07:08,240 --> 00:07:11,110
.أريدها أن تكون سليمة معافاة

81
00:07:11,110 --> 00:07:14,240
هل لديك دواء أو شيء سيجدي نفعًا؟

82
00:07:16,370 --> 00:07:18,540
.لا بدّ وأنّك تهتمّ لزوجتك كثيرًا

83
00:07:18,830 --> 00:07:19,910
!بالطّبع

84
00:07:20,370 --> 00:07:21,830
.يا لها من إجابة سريعة

85
00:07:21,830 --> 00:07:24,250
.إنّك رجلٌ محرِج

86
00:07:28,630 --> 00:07:31,180
هل يمكنني رؤية زوجتك شخصيًّا؟

87
00:07:31,590 --> 00:07:33,390
.نعم، أرجوك

88
00:07:33,390 --> 00:07:34,680
.تعال بسرعة

89
00:07:41,520 --> 00:07:44,270
.إنّه شخص بغيض

90
00:07:47,110 --> 00:07:48,230
.شكرًا لك

91
00:07:48,530 --> 00:07:49,990
.نالي قسطًا من الرّاحة

92
00:07:49,990 --> 00:07:51,950
.سأذهب للحديث مع زوجك

93
00:07:52,320 --> 00:07:53,160
.حسنًا

94
00:07:53,660 --> 00:07:55,370
.شكرًا جزيلاً لك

95
00:07:58,540 --> 00:08:00,620
كيف حالها إذًا؟

96
00:08:01,460 --> 00:08:02,460
تيم؟

97
00:08:02,830 --> 00:08:03,670
.تيم

98
00:08:06,590 --> 00:08:08,300
ما الخطب يا تيم؟

99
00:08:08,550 --> 00:08:12,220
.لا أعتقد أنّها ستتحسّن أكثر ممّا هي عليه

100
00:08:12,720 --> 00:08:14,640
.لن تبقَ لأكثر من بضع سنوات

101
00:08:15,180 --> 00:08:16,430
.وُلدت هكذا

102
00:08:16,800 --> 00:08:17,760
.ما باليد حيلة

103
00:08:18,060 --> 00:08:19,390
...لا

104
00:08:22,810 --> 00:08:26,440
مـ-مينا لم تستطع حتّى اللّعب
.في الخارج أثناء طفولتها

105
00:08:26,440 --> 00:08:29,530
العمل بجدّ من طباعها، ولكنّها
!لا تستطيع تأدية الكثير بسبب صحّتها

106
00:08:29,530 --> 00:08:31,190
!إنّها تستحق الأفضل

107
00:08:31,190 --> 00:08:33,820
!سأفعل أيّ شيء لها

108
00:08:33,820 --> 00:08:34,910
!أرجوك

109
00:08:34,910 --> 00:08:37,330
!لا يمكنني تحمّل رؤيتها تموت

110
00:08:40,040 --> 00:08:42,460
أتحبّ زوجتك القطط؟

111
00:08:43,920 --> 00:08:44,870
القطط؟

112
00:08:47,040 --> 00:08:47,960
.نعم

113
00:08:47,960 --> 00:08:49,590
.فهمت

114
00:08:49,590 --> 00:08:51,510
!هذا مناسبٌ إذًا

115
00:08:52,260 --> 00:08:56,470
هل سمعت أنّ القطط تملك تسعة أرواح؟

116
00:09:00,810 --> 00:09:02,520
!فئران ثانيةً

117
00:09:04,940 --> 00:09:07,400
ألم تكثر الفئران مؤخرًا؟

118
00:09:07,400 --> 00:09:10,280
.أعتقد أنّ القطط لا تؤدّي عملها كما يجب

119
00:09:11,030 --> 00:09:11,900
.مينا

120
00:09:12,280 --> 00:09:14,700
ألا توجد مشكلة بقيامك من الفراش؟

121
00:09:18,070 --> 00:09:20,620
.نعم، الجوّ لطيف اليوم

122
00:09:21,080 --> 00:09:23,370
أرأيتنّ ماثيو؟

123
00:09:23,370 --> 00:09:26,420
،ذهبت لإيصال وجبة له
.ولكنّه لم يكن في الحديقة

124
00:09:26,420 --> 00:09:30,210
.ربّما قد خرج لرؤية امرأة ما

125
00:09:30,960 --> 00:09:33,380
!لا تقولي شيئًا سخيفًا

126
00:09:34,340 --> 00:09:37,970
.الجميع يعلم أنّ ماثيو مولعٌ بمينا

127
00:09:36,010 --> 00:09:38,800
.رأيته يذهب إلى الغابة مع فأس

128
00:09:37,970 --> 00:09:40,310
!كنت أمزح فحسب

129
00:09:39,350 --> 00:09:40,260
الغابة؟

130
00:09:51,980 --> 00:09:55,320
!ماثيو

131
00:10:03,660 --> 00:10:05,620
هل أنتِ بخير يا تشيسي؟

132
00:10:05,620 --> 00:10:07,710
.تبدين شاحبة الوجه للغاية

133
00:10:08,290 --> 00:10:11,670
.يراودني شعور فظيع لهذا

134
00:10:29,650 --> 00:10:30,770
كوخ؟

135
00:10:30,770 --> 00:10:33,110
أكان هنالك كوخٌ هنا؟

136
00:10:41,070 --> 00:10:41,820
!لا

137
00:10:42,620 --> 00:10:45,290
ما الّذي يفعله ماثيو؟

138
00:10:48,000 --> 00:10:49,210
ماثيو؟

139
00:10:49,580 --> 00:10:50,420
!لا

140
00:10:50,710 --> 00:10:51,750
.ماثيو

141
00:10:53,170 --> 00:10:54,170
!لا

142
00:10:56,420 --> 00:10:58,930
!لا تنظري إلى الدّاخل

143
00:11:03,220 --> 00:11:04,390
.ماثيو

144
00:11:26,660 --> 00:11:27,700
.مينا

145
00:11:37,380 --> 00:11:40,510
.إنّك بصحّة جيّدة اليوم

146
00:11:41,800 --> 00:11:43,260
.ممتاز

147
00:11:43,260 --> 00:11:45,560
.انتهيت من إعداد هذا للتّوّ

148
00:11:46,680 --> 00:11:48,770
.إنّه دواؤك

149
00:11:48,770 --> 00:11:50,140
دواء؟

150
00:11:50,560 --> 00:11:52,480
...ماثيو، ما الّذي

151
00:11:53,150 --> 00:11:54,400
ما الّذي تتحدّث عنه؟

152
00:11:54,400 --> 00:11:57,480
أتذكرين عندما عاينك مشعوذ؟

153
00:11:57,780 --> 00:12:03,070
.أخبرني أنّ هذه الجرعة ستجعلك في حالٍ أفضل

154
00:12:03,700 --> 00:12:05,830
...هـ-هذه القطط

155
00:12:06,280 --> 00:12:07,660
من أين أتت هذه القطط؟

156
00:12:07,660 --> 00:12:09,910
.إنّها مكوّنات

157
00:12:09,910 --> 00:12:12,870
.يقولون أنّ القطط تمتلك تسعة أرواح

158
00:12:12,870 --> 00:12:14,960
.يبدو أنّ ذلك حقيقي

159
00:12:14,960 --> 00:12:18,800
قال أنّ بإمكاني إعداد دواء لك
.من أرواح القطط

160
00:12:19,170 --> 00:12:23,260
امتلاك هذه الوحوش لكلّ هذه
.الأرواح غير منصف

161
00:12:23,260 --> 00:12:24,180
!ماثيو

162
00:12:24,180 --> 00:12:25,800
!ما الّذي حلّ بك؟

163
00:12:26,220 --> 00:12:28,390
!كيف يمكنك فعل شيء فظيع كهذا؟

164
00:12:28,390 --> 00:12:31,520
!لستَ من النّوع الّذي يمكنه فعل شيءٍ كهذا

165
00:12:32,940 --> 00:12:33,650
.يمكنني

166
00:12:38,020 --> 00:12:39,150
...لأنّ

167
00:12:39,440 --> 00:12:41,110
.هذا من أجلك

168
00:12:43,070 --> 00:12:44,360
...ماثيو

169
00:12:45,950 --> 00:12:48,160
.لا أستطيع الحراك

170
00:12:49,080 --> 00:12:51,830
.لا بأس، لا داعي لأن تخافي

171
00:12:52,580 --> 00:12:56,750
ستصبحين من ذات جسدٍ ضعيف
.إلى ذات جسدٍ صحيّ إن شربتِ ذلك

172
00:12:56,750 --> 00:13:00,380
.حتّى أنّه قد يمكنك العيش إلى الأبد

173
00:13:00,380 --> 00:13:01,630
...أنت

174
00:13:02,220 --> 00:13:03,760
!ما الّذي فعلته لماثيو؟

175
00:13:05,220 --> 00:13:07,430
.جعلته يثق فيّ قليلاً فحسب

176
00:13:08,890 --> 00:13:12,100
.لا تقلقي، إنّه دواءٌ رائع

177
00:13:13,020 --> 00:13:14,140
...لذا

178
00:13:16,150 --> 00:13:18,570
.أصبحي فأرتي

179
00:13:33,500 --> 00:13:35,540
.لا بأس يا مينا

180
00:13:36,000 --> 00:13:37,880
.قال أنّه يؤلم في البداية فقط

181
00:13:38,210 --> 00:13:40,090
.تحمّلي يا مينا

182
00:13:40,090 --> 00:13:42,380
.ستكونين بخير بعد هذا

183
00:13:46,840 --> 00:13:48,340
.أنا معك

184
00:13:48,800 --> 00:13:49,430
...لذا

185
00:13:51,430 --> 00:13:54,230
...ماثيو

186
00:14:20,080 --> 00:14:22,670
.لقد فشل الأمر

187
00:14:22,670 --> 00:14:24,510
.فقدت هيئتها

188
00:14:25,130 --> 00:14:28,470
أعتقد أنّ الوحوش مجرّد
.وحوش في نهاية المطاف

189
00:14:28,800 --> 00:14:31,010
،معالجتها أسهل من البشر

190
00:14:31,010 --> 00:14:33,720
ولكن أعتقد أنّ غرائزها القويّة
.تعني أنّ لديها لعنات قويّة أيضًا

191
00:14:34,470 --> 00:14:37,640
أعتقد أنّي سأعود لمحاولة معرفة
.كيفيّة تركيز الأرواح

192
00:14:38,140 --> 00:14:40,940
.شكرًا لك لبيانات البحث الثّمينة يا سيّد

193
00:14:43,150 --> 00:14:44,070
لماذا؟

194
00:14:45,860 --> 00:14:46,780
لماذا؟

195
00:14:48,200 --> 00:14:51,280
...مينا

196
00:14:51,870 --> 00:14:53,410
لماذا يا مينا؟

197
00:14:53,410 --> 00:14:55,500
.لقد انهار

198
00:14:55,500 --> 00:14:57,830
الحبّ مذهل، أليس كذلك يا سيّدة؟

199
00:14:58,120 --> 00:15:01,040
لماذا؟

200
00:15:01,210 --> 00:15:04,550
!لماذا؟

201
