1
00:01:34,690 --> 00:01:38,450
.لم يكن ينبغي أن أنجبك

2
00:01:46,750 --> 00:01:49,630
من قد تُباعين إليه؟

3
00:01:50,000 --> 00:01:52,130
.ظننتك غير مهتمّة

4
00:01:52,130 --> 00:01:54,340
.لا أحبّ التّألّم

5
00:01:54,340 --> 00:01:57,010
.ظننت أنّ عليّ الاستعداد على الأقلّ

6
00:01:57,010 --> 00:01:58,640
.لا تقلقي

7
00:01:58,640 --> 00:02:01,430
.أنتِ نادرة

8
00:02:02,220 --> 00:02:06,810
آسف، لا يهمّك سواء عشتِ أم متِّ، أليس كذلك؟

9
00:02:45,850 --> 00:02:47,230
...لحظة

10
00:02:51,400 --> 00:02:52,730
.شكرًا لك

11
00:02:53,900 --> 00:02:55,570
.صباح الخير يا تشيسي

12
00:02:55,820 --> 00:02:58,740
.صـ-صباح الخير

13
00:03:03,070 --> 00:03:04,450
من تكون؟

14
00:03:04,450 --> 00:03:07,450
.إنّها جارة تعيش هنا. اسمها سيلكي

15
00:03:08,200 --> 00:03:13,380
إنّها جنيّة تطبخ وتغسل الملابس
.وتُنظّف وتضرم نارًا للتّدفئة

16
00:03:13,960 --> 00:03:16,550
.جهّزت سيلكي ذلك أيضًا

17
00:03:19,260 --> 00:03:24,100
يمكنك القول أنّها تبدو كصاحبة المكان
.أكثر من كونها خادمة

18
00:03:36,320 --> 00:03:38,070
.شيءٌ لأحد معارفي

19
00:03:39,070 --> 00:03:44,160
يبدو أنّي اُشتريت من قِبل هذا
.السّاحر بمبلغ لا يُصدّق

20
00:03:46,280 --> 00:03:49,200
...كتلميذته، وأيضًا

21
00:03:49,540 --> 00:03:53,830
.آمل أن تكوني عروسي أيضًا

22
00:03:55,790 --> 00:03:57,420
...تلميذة أو عروس

23
00:03:57,420 --> 00:03:59,800
أيّ واحدٍ آخذ بجديّة؟

24
00:04:00,470 --> 00:04:03,260
لقد كنتِ نائمة ليومين، أتذكرين شيئًا؟

25
00:04:03,260 --> 00:04:04,510
يومان؟

26
00:04:04,510 --> 00:04:06,800
.لا بدّ وأنّك مرهقة عاطفيًّا

27
00:04:08,470 --> 00:04:13,390
.مظهره وسلوكيّاته... ما زلت لا أفهمه جيّدًا

28
00:04:14,230 --> 00:04:15,020
ألن تأكلي؟

29
00:04:18,940 --> 00:04:24,610
ولكنّه سيعتني بي، لذا فهو ليس
.شخصًا سيّئًا على ما أعتقد

30
00:04:30,080 --> 00:04:32,870
،آسف لطرح هذا بعد استيقاظك مباشرةً

31
00:04:34,290 --> 00:04:36,790
ولكن هل نجهّز لشهر عسلنا؟

32
00:04:39,090 --> 00:04:44,300
.ولكنّه يبدو غريبًا قليلاً

33
00:04:58,570 --> 00:05:02,860
.فكّرتُ أن أقدّمك إلى معارفي أثناء ذهابنا للتّسوّق

34
00:05:04,030 --> 00:05:06,700
،وجهه عبارة عن جمجمة
.لذا لا يمكنني قراءة تعابيره

35
00:05:06,700 --> 00:05:09,530
.لا أعرف ما إن كان جادًّا أم يمزح

36
00:05:12,370 --> 00:05:14,710
مـ-ماذا حدث لرأسك؟

37
00:05:15,080 --> 00:05:18,460
سأبدو مثيرًا للشّبهة إن تجوّلت
.في الخارج بذلك الرأس

38
00:05:19,000 --> 00:05:22,170
.استعملت القليل من السّحر

39
00:05:23,300 --> 00:05:24,300
ما رأيك؟

40
00:05:24,300 --> 00:05:27,220
.شعور لمسه تغيّر أيضًا

41
00:05:27,220 --> 00:05:28,340
هل أبدو رائعًا؟

42
00:05:28,340 --> 00:05:29,180
هل أنا وسيم؟

43
00:05:31,140 --> 00:05:34,640
.تبدو مزيّفًا نوعًا ما

44
00:05:36,100 --> 00:05:37,400
.هذا فظيع

45
00:05:39,810 --> 00:05:41,440
.آتي إلى هنا كثيرًا

46
00:05:42,030 --> 00:05:44,820
.ستجدين كلّ معدّاتك تقريبًا هنا

47
00:05:47,490 --> 00:05:49,910
هل هذا المكان مفتوح؟

48
00:05:51,530 --> 00:05:53,160
.هذا للعرض فقط

49
00:05:54,250 --> 00:05:55,410
.أنجي

50
00:05:55,410 --> 00:05:56,540
.أنجليكا

51
00:05:58,170 --> 00:06:00,960
!ماذا؟ هذا أنت يا آينسورث

52
00:06:00,960 --> 00:06:05,380
من كان يعتقد أنّك ستخرج من جحرك؟

53
00:06:05,380 --> 00:06:09,220
.لستِ منغلقة أقلّ منّي يا نحلة الأحجار الكريمة

54
00:06:09,220 --> 00:06:11,640
.أنا أملك تجارة

55
00:06:11,640 --> 00:06:12,560
.تشيسي

56
00:06:12,560 --> 00:06:14,020
!نـ-نعم

57
00:06:16,890 --> 00:06:20,440
.أريدك أن تجهّزي الأشياء الّتي تحتاجها هذه الفتاة

58
00:06:25,490 --> 00:06:27,570
.جعلتها تلميذتي قبل ثلاثة أيّام

59
00:06:29,110 --> 00:06:31,620
!تـ-تلميذة؟

60
00:06:32,330 --> 00:06:33,200
.نعم

61
00:06:35,290 --> 00:06:36,750
.مذهل

62
00:06:36,750 --> 00:06:38,410
من اليابان؟

63
00:06:38,410 --> 00:06:40,170
اسمك تشيسي؟

64
00:06:41,040 --> 00:06:41,920
.تفضلي

65
00:06:42,290 --> 00:06:44,170
.شكرًا جزيلاً لك

66
00:06:44,170 --> 00:06:45,800
.إنّها ظريفة

67
00:06:46,300 --> 00:06:49,220
يستحسن ألاّ تكون قد قمتَ بأمورٍ
.مريبة للحصول عليها

68
00:06:50,130 --> 00:06:52,720
.المال الّذي اشتريته بها كان نظيفًا

69
00:06:52,720 --> 00:06:55,060
!لا شيء قويم حول شرائها

70
00:06:55,640 --> 00:06:57,350
ألم يفعل شيئًا غريبًا لك؟

71
00:06:57,350 --> 00:06:59,520
ماذا تعتقديني؟

72
00:06:59,770 --> 00:07:01,060
شيئًا غريبًا؟

73
00:07:02,270 --> 00:07:06,230
تشيسي، تشيسي، عليك
.أن تنكري ذلك بشكلٍ أسرع

74
00:07:06,230 --> 00:07:11,280
غسلني بعد أن نزعت ملابسي وتقدّم
بطلب يدي... أيعدّ ذلك غريبًا؟

75
00:07:11,280 --> 00:07:12,990
حقًّا؟

76
00:07:16,910 --> 00:07:19,120
!أيّها السّاحر المنحرف

77
00:07:19,120 --> 00:07:21,460
!اذهب للتّمشّي

78
00:07:23,040 --> 00:07:26,420
.لا يملك أيّ منطق سليم

79
00:07:37,720 --> 00:07:41,940
ولكن، آينسورث ذاك وجد تلميذة؟

80
00:07:43,270 --> 00:07:45,320
هل تقدّم بطلب يدك حقًّا؟

81
00:07:48,480 --> 00:07:49,150
...المعذرة

82
00:07:51,110 --> 00:07:54,620
.آسفة، نسيت تقديم نفسي

83
00:07:55,410 --> 00:07:57,580
.أنا أنجليكا بارلي

84
00:07:57,580 --> 00:08:00,540
.أنا إحدى السّحرة الّذين ينقرضون

85
00:08:00,540 --> 00:08:02,670
.أنا ساحرة حرف يدويّة

86
00:08:02,670 --> 00:08:04,920
ساحرة حِرَف؟

87
00:08:06,170 --> 00:08:10,880
.أدوات وبِدع تعمل على السّحر بدلاً من الكهرباء

88
00:08:10,880 --> 00:08:13,640
...معالجة الأحجار الكريمة وصنع السّكاكين

89
00:08:13,640 --> 00:08:15,390
.أفعل كلّ شيء

90
00:08:15,390 --> 00:08:16,350
!أمّي

91
00:08:18,100 --> 00:08:19,350
زائرة؟

92
00:08:19,350 --> 00:08:20,640
.ألثيا

93
00:08:22,230 --> 00:08:23,060
!انظري

94
00:08:24,520 --> 00:08:26,310
.آسفة ولكنّنا سنؤجّل ذلك

95
00:08:26,310 --> 00:08:28,400
.ابقي هادئة

96
00:08:29,610 --> 00:08:33,700
!وعدتِني أنّك ستراقبين تدريبي

97
00:08:33,700 --> 00:08:35,410
!حسنًا، انصرفي فحسب

98
00:08:39,540 --> 00:08:41,160
أتلك ابنتك؟

99
00:08:41,160 --> 00:08:42,040
.نعم

100
00:08:42,040 --> 00:08:43,870
.إنّها ليست مهذّبة، آسفة لذلك

101
00:08:45,290 --> 00:08:50,130
،بغضّ النّظر ما إن كان ذلك إيجابيًّا أو سلبيًّا
.فإنّها تملك ما يلزم لأن تصبح ساحرة

102
00:08:50,710 --> 00:08:55,010
،أفضّل أن تعمل في وظيفة ملائمة
.خصوصًا في وقتنا الحاليّ

103
00:08:57,300 --> 00:08:59,260
ساحرة؟

104
00:09:02,600 --> 00:09:05,190
ألم يخبرك إلياس بعد؟

105
00:09:05,480 --> 00:09:06,600
.نعم

106
00:09:07,230 --> 00:09:10,020
.هنالك سحر وشعوذة في هذا العالم

107
00:09:10,020 --> 00:09:11,940
هل تعرفين الفرق بين الاثنين؟

108
00:09:13,190 --> 00:09:18,240
ببساطة، يستخدم المشعوذون
."علمًا يُطلق عليه "الشّعوذة

109
00:09:18,240 --> 00:09:20,240
،إنّهم يفهمون الواقع

110
00:09:20,240 --> 00:09:25,370
ويستخدمون طاقتهم الخاصّة لإعادة
.كتابته وتغييره لغاياتهم

111
00:09:28,380 --> 00:09:34,720
وفي الوقت نفسه، السّحر الّذي نستخدمه
نحن السّحرة يشير إلى المعجزات المُفتَعلَة

112
00:09:34,720 --> 00:09:38,850
،بمساعدة الجنّيّات والأرواح
.تتلاعب قوّاهم بذلك الواقع

113
00:09:38,850 --> 00:09:40,220
معجزات؟

114
00:09:41,390 --> 00:09:44,100
السّحر يبدو أسهل، أليس كذلك؟

115
00:09:44,100 --> 00:09:49,650
،ولكنّه كوجود أحدهم على يديك ورجليك
.لذا فإنّه يصعب ضبطه والتّحكّم به

116
00:09:49,650 --> 00:09:53,440
لذا إن حاولتِ فعل أكثر ممّا
...أنتِ قادرة عليه

117
00:09:58,030 --> 00:10:01,160
،ارتكبت خطأً سخيفًا أثناء تدريبي

118
00:10:01,160 --> 00:10:02,240
.لذا كانت هذه النّتيجة

119
00:10:03,370 --> 00:10:06,160
.هنالك الكثير لدراسته عن السّحر

120
00:10:06,160 --> 00:10:09,710
.عليك أخذه بجديّة وإلاّ فإنّ هذا ما سيحدث

121
00:10:09,710 --> 00:10:11,420
.لذا ادرسي بجدّ

122
00:10:21,390 --> 00:10:25,270
هل يمكنني استعمال السّحر أيضًا؟

123
00:10:26,480 --> 00:10:28,310
لِمَ لا تجرّبين؟

124
00:10:29,350 --> 00:10:30,360
!هيوغو

125
00:10:41,530 --> 00:10:42,830
.مرحبًا يا روبين

126
00:10:42,830 --> 00:10:45,040
أنا وليٌّ لأنجليكا، لذا لا أعدك

127
00:10:45,040 --> 00:10:47,580
،بأن أكون بألطف حالاتي معك
.ولكن سررت لمقابلتك على أيّ حال

128
00:10:47,580 --> 00:10:52,540
.هذا أليفي هيوغو، روح ماء فودونوي

129
00:10:52,540 --> 00:10:55,130
.إنّه مشاكس، ولكنّه يعمل بجدّ

130
00:10:55,760 --> 00:10:58,380
هلاّ ساعدتها يا هيوغو؟

131
00:10:58,380 --> 00:11:00,130
.إنّها تحتاج التّدرّب للسّحر

132
00:11:01,470 --> 00:11:03,470
...لـ-لكن أنا

133
00:11:05,520 --> 00:11:07,930
.الجميع يقوم بالمحاولة الأولى

134
00:11:11,560 --> 00:11:13,770
.ستستخدمين هذه للتّدرّب

135
00:11:13,770 --> 00:11:17,190
.شكّليها لتأخذ هيئة تريدينها

136
00:11:18,240 --> 00:11:19,610
أشكّلها؟

137
00:11:19,610 --> 00:11:20,410
.نعم

138
00:11:20,410 --> 00:11:23,320
.فكّري بزهرتك المفضّلة على سبيل المثال

139
00:11:25,950 --> 00:11:28,200
زهرة؟

140
00:11:28,960 --> 00:11:31,250
.الهواء هو ماءٌ ساخن

141
00:11:31,250 --> 00:11:33,290
.أنتِ هي الضّغط

142
00:11:33,290 --> 00:11:36,050
.وفي ذلك تتشكّل البلّورة

143
00:11:36,550 --> 00:11:38,210
.تخيّلي ذلك

144
00:11:48,020 --> 00:11:52,100
ما هي زهرتي المفضّلة يا ترى؟

145
00:12:00,450 --> 00:12:02,950
متى؟ أين؟

146
00:12:13,000 --> 00:12:15,880
.انظري يا تشيسي

147
00:12:16,710 --> 00:12:19,510
.إنّها حديقة زهور

148
00:12:19,510 --> 00:12:20,720
.يا لجمالها

149
00:12:22,760 --> 00:12:25,260
.يا لجمالها يا تشيسي

150
00:12:25,510 --> 00:12:26,260
.تشيسي

151
00:12:31,770 --> 00:12:33,690
.هذا سيّئ يا أنجليكا

152
00:12:33,690 --> 00:12:36,440
.لا تعلّمي تلميذتي أشياءً من تلقاء نفسك

153
00:12:38,320 --> 00:12:39,610
...إلياس

154
00:12:49,660 --> 00:12:51,620
.أ-أنا آسفة

155
00:12:51,620 --> 00:12:52,540
...الغرفة

156
00:12:52,540 --> 00:12:54,040
.آينسورث

157
00:12:54,420 --> 00:12:56,380
ماذا تكون هذه الفتاة؟

158
00:13:10,390 --> 00:13:12,140
،السّحر معجزة

159
00:13:12,680 --> 00:13:14,190
.ولكنّه ليس قادرًا على كلّ شيء

160
00:13:16,270 --> 00:13:17,650
.إنّها سلي بيغي

161
00:13:22,860 --> 00:13:24,490
.فهمت

162
00:13:24,950 --> 00:13:26,660
لماذا لم تخبرني؟

163
00:13:26,660 --> 00:13:28,950
.يُفضّل ألاّ يعلم بذلك الكثير

164
00:13:31,790 --> 00:13:33,960
.لا تكوني قلقة

165
00:13:36,880 --> 00:13:37,830
!هيوغو

166
00:13:37,830 --> 00:13:39,000
لماذا لم تخبرني؟

167
00:13:39,000 --> 00:13:40,800
...هذا لأنّ

168
00:13:41,090 --> 00:13:43,760
.إنّها وجودٌ مميّز بالنّسبة للجنّيّات

169
00:13:49,180 --> 00:13:51,180
.أ-أنا آسفة

170
00:13:51,640 --> 00:13:53,600
.جعلت المكان في حالة فوضى

171
00:13:58,400 --> 00:14:01,150
.لا حاجة لاعتذارك

172
00:14:02,900 --> 00:14:05,490
.اسمعي، إنّه خطأ رأس الجمجمة هذا

173
00:14:05,490 --> 00:14:07,280
.إنّه وغدٌ لم يخبرنا بشيء

174
00:14:07,280 --> 00:14:08,110
وغد؟

175
00:14:08,110 --> 00:14:11,950
،إن لم تستطع شرح شيء لتلميذتك
!فإنّك لست سوى وغد

176
00:14:13,080 --> 00:14:17,040
تشيسي، هل يمكنك مساعدتي بإحضار
مكنسة ومطرقة من الخلف؟

177
00:14:17,040 --> 00:14:17,870
!نعم

178
00:14:18,920 --> 00:14:20,540
ما خطبك يا آينس؟

179
00:14:25,420 --> 00:14:27,590
.سأجعلك تدفع أكثر

180
00:14:34,100 --> 00:14:34,850
.تشيسي

181
00:14:35,180 --> 00:14:36,520
نـ-نعم؟

182
00:14:39,560 --> 00:14:43,020
سكين أشابة محيط صيغت برحيق
.بلورة زهرة القمر

183
00:14:43,020 --> 00:14:45,780
.معطف محبوك من ريش طائر الرعد

184
00:14:45,780 --> 00:14:50,620
...ماذا أيضًا؟ جلد غلاشتين وحزام

185
00:14:51,070 --> 00:14:55,040
أعتقد أنّي سأضيف خيط كرمة
.فولاذيّة وعدسة فلوريت

186
00:16:18,540 --> 00:16:21,790
بالمناسبة، أتحبين زهور الخشخاش يا تشيسي؟

187
00:16:22,330 --> 00:16:26,840
.لا أحبّها تحديدًا، ولكنّي تذكرت شيئًا فحسب

188
00:16:26,840 --> 00:16:30,130
...رأيت حديقة ورود كهذه قبل زمنٍ طويل

189
00:16:33,260 --> 00:16:34,430
.مع أمّي

190
00:16:38,640 --> 00:16:41,520
هل مات والداك؟

191
00:16:42,060 --> 00:16:43,900
أم هل تخلّيا عنك؟

192
00:16:44,350 --> 00:16:46,980
.إنّك صريح للغاية

193
00:16:47,940 --> 00:16:50,280
،مهما كان ماضيك أو تربيتك

194
00:16:50,280 --> 00:16:53,320
.فإنّ ذلك لا يغيّر حقيقة أنّك هنا الآن

195
00:16:57,580 --> 00:16:59,120
.إنّك مُحقّ

196
00:17:00,790 --> 00:17:08,420
.كلماته الصّريحة والهادئة مريحة ولطيفة نوعًا ما

197
00:17:14,260 --> 00:17:19,180
...لا أعلم ما الّذي يفعله أبي، ولكنّ أمّي

198
00:17:23,230 --> 00:17:24,730
.ماتت

199
00:17:27,610 --> 00:17:29,320
.أمام عينيّ

200
00:17:31,230 --> 00:17:32,740
.كان ذلك منذ زمنٍ طويل

201
00:17:43,080 --> 00:17:44,210
!أنت

202
00:17:44,210 --> 00:17:45,790
!آينسورث

203
00:17:47,000 --> 00:17:50,340
ألم أرسل لك قائلاً أنّي سأكون
هنا حوالي هذا الوقت؟

204
00:17:50,340 --> 00:17:53,510
لِمَ غادرت حين كنتُ على وشك الوصول؟

205
00:17:53,510 --> 00:17:54,880
!على الرّغم من أنّك منعزل

206
00:17:54,880 --> 00:17:56,890
.لديّ أمورٌ لفعلها أيضًا

207
00:17:56,890 --> 00:18:00,180
.خدمك يكرهونني

208
00:18:00,180 --> 00:18:02,350
.لا يسمحون لي حتّى بالدّخول إلى المنزل

209
00:18:02,350 --> 00:18:05,810
.لم يكن ينبغي أن تأتي من الأساس

210
00:18:08,770 --> 00:18:12,110
أنتِ تلميذته الجديدة تشيسي، صحيح؟

211
00:18:13,030 --> 00:18:14,280
.مرحبًا

212
00:18:14,280 --> 00:18:15,820
.اسمي سايمون

213
00:18:15,820 --> 00:18:17,360
.سايمون كالَم

214
00:18:17,910 --> 00:18:21,490
.أنا هنا اليوم لأطلب منكما أن تنجزا مهمّة من أجلي

215
00:18:31,130 --> 00:18:33,380
.انتظرت في الخارج لساعتين

216
00:18:34,170 --> 00:18:38,260
.تشيسي، سايمون كاهنٌ في كنيسة القرية

217
00:18:38,640 --> 00:18:44,390
.مع أنّه يلقي خُطبًا ككاهن وكقس، إلاّ أنّه مُحايد

218
00:18:44,390 --> 00:18:46,520
."أطلق عليّ "مواظب على الدّراسة

219
00:18:46,520 --> 00:18:49,060
.لا داعي لأن تكوني متوتّرة يا تشيسي

220
00:18:49,060 --> 00:18:51,310
.سايمون مجرّد جبان

221
00:18:51,770 --> 00:18:56,860
نعم، أنا مجرّد حمل بائس يرتعد
.خوفًا من السّاحر الفظيع

222
00:18:56,860 --> 00:18:57,570
.فلتمت

223
00:18:57,570 --> 00:18:59,200
.إنّك صريحٌ للغاية

224
00:18:59,990 --> 00:19:02,080
.إنّهما لا يتوافقان

225
00:19:00,450 --> 00:19:03,540
،ما يزال الجوّ باردًا في الخارج
.على الرّغم أنّ الصيف اقترب

226
00:19:02,080 --> 00:19:04,950
.إلياس بالخصوص حقود للغاية

227
00:19:03,540 --> 00:19:07,410
كان ينبغي أن تعود إلى الكنيسة
.وتأتي يوم الغد إذًا

228
00:19:04,950 --> 00:19:06,580
.سيلكي أيضًا

229
00:19:07,410 --> 00:19:10,580
.ولكنّ ذلك مزعجٌ أيضًا

230
00:19:11,880 --> 00:19:15,670
.تشيسي-كن، أعتقد أنّي أتفهّم وضعك الآن

231
00:19:16,420 --> 00:19:18,090
.لا بدّ وأنّ ذلك كان فظيعًا

232
00:19:18,590 --> 00:19:22,850
مرحبٌ بك للقدوم إلى كنيستي
.متى مللتِ من هذا الأحمق

233
00:19:22,850 --> 00:19:24,350
.سأستمع لما لديك

234
00:19:24,350 --> 00:19:25,350
!أنت

235
00:19:26,890 --> 00:19:27,980
إذًا؟

236
00:19:32,810 --> 00:19:37,490
،هذا شيءٌ لا يمكننا التّعامل معه
.ولكنّه يفترض أن يكون سهلاً بالنّسبة لك

237
00:19:38,110 --> 00:19:39,320
ثلاثة؟

238
00:19:39,320 --> 00:19:39,990
.هذا كثير

239
00:19:40,490 --> 00:19:43,580
.إنّها غرامة أفعالك الحرّة

240
00:19:44,370 --> 00:19:50,000
،لم تقم بتحرّكات كبيرة لعقود
.وفجأة أخذت تلميذة الآن

241
00:19:50,000 --> 00:19:52,750
.ليس لديّ خيار سوى إخبار من هم فوقي

242
00:19:52,750 --> 00:19:56,670
.لا أعتقد أنّه يتمّ إدارتي من قِبل الكنيسة

243
00:19:56,670 --> 00:19:57,920
.أعلم

244
00:19:57,920 --> 00:20:00,050
.أنا أيضًا لا أريد إزعاج نفسي بهذا

245
00:20:00,380 --> 00:20:06,390
لا نريد العبث معكم أنتم السّحرة
.الّذين عشتم زمنًا أطول ممّا نعلم

246
00:20:07,680 --> 00:20:12,100
كم من القرون ستمرّ إلى أن يغيّر
رؤساؤك طريقة تفكيرهم؟

247
00:20:13,730 --> 00:20:17,190
.فقط لو كتب لنا الرّب أو ابنه رسالة أو رسالتين

248
00:20:18,190 --> 00:20:21,910
أهذا الإزعاج لأنّي أتيت إلى هنا؟

249
00:20:22,490 --> 00:20:24,870
.إنّه ليس خطأك على الإطلاق

250
00:20:25,330 --> 00:20:28,040
.جميعنا لدينا أمورٌ مزعجة

251
00:20:30,540 --> 00:20:32,580
هل يمكنني الحصول على المعتاد؟

252
00:20:32,580 --> 00:20:33,420
.نعم

253
00:20:35,590 --> 00:20:40,880
أعالج جميع النّاس في هذه القرية
.بالدّواء الّذي يعدّه آينسورث

254
00:20:40,880 --> 00:20:47,180
إن تعلّمتِ السّحر واستخدمتِه لصنع
.الأدوية، فإنّها ستقوم بالعجائب

255
00:20:47,930 --> 00:20:51,520
.دواء السّحرة فعّال ولطيفٌ على الجسد

256
00:20:53,850 --> 00:20:55,650
.ادرسي جيّدًا

257
00:20:56,270 --> 00:21:01,070
.لم أكن لأصدّق أنّه يحترمك كونه كاهنًا

258
00:21:01,070 --> 00:21:02,150
أهو كذلك؟

259
00:21:02,780 --> 00:21:05,740
.بريطانيا أرض سحر قديم

260
00:21:06,120 --> 00:21:09,660
.السّحرة جزءٌ مهمّ من الحياة هنا

261
00:21:11,080 --> 00:21:12,540
،حسنًا يا تشيسي

262
00:21:14,960 --> 00:21:18,590
لِمَ لا نذهب إلى شهر عسلنا أثناء إنجازنا للمهامّ؟

263
00:21:19,960 --> 00:21:23,800
لم تكن تمزح بشأن ذلك؟

264
00:21:32,480 --> 00:21:36,560
.أيسلندا، جزيرة بركانيّة في المحيط الهادئ

265
00:21:38,730 --> 00:21:42,400
.سمعت أنّ التّنانين نشطة مؤخّرًا

266
00:21:42,940 --> 00:21:44,650
.طُلب منّي معاينتها

267
00:21:45,030 --> 00:21:46,240
تنانين؟

268
00:21:53,910 --> 00:21:54,540
!تشيسي

269
00:22:06,590 --> 00:22:09,720
ما يزال غير حذر، أليس كذلك؟

270
00:22:09,720 --> 00:22:13,100
.لم يتمكّن حتّى من بالاحتفاظ بتلميذته

271
00:22:13,470 --> 00:22:15,770
مـ-من أنت؟

272
00:22:16,190 --> 00:22:19,060
.سنناقش ذلك في أرضنا

273
00:22:20,520 --> 00:22:24,360
.في أرض التّنانين الأخيرة

274
00:23:55,790 --> 00:23:57,120
.تفرّق الاثنان

275
00:23:57,500 --> 00:24:00,540
.ينضفر الموت والحياة في نهايات الأرض

276
00:24:00,920 --> 00:24:05,590
ماذا ترى الفتاة حين يُفتح باب ذكرياتها؟

277
00:24:05,880 --> 00:24:09,090
.تصبحين على خير أيّتها السّاحرة الصغيرة