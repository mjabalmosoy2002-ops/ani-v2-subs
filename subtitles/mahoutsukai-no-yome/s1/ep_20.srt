1
00:01:57,680 --> 00:01:59,050
!هذا سيّئ

2
00:02:03,890 --> 00:02:05,100
!إنّه يقذف النّار

3
00:02:05,100 --> 00:02:07,480
سمعت أنّ أعضاءها المسؤولة عن
!النّيران قد أصبحت لا وظيفيّة

4
00:02:07,730 --> 00:02:08,810
...إلياس

5
00:02:08,810 --> 00:02:10,270
.إنّه ارتداد وراثيّ

6
00:02:10,690 --> 00:02:13,020
أصبح كالتّنانين الّتي نقرأ عنها
.في القصص الخياليّة

7
00:02:22,280 --> 00:02:25,240
.ما زال بإمكانه أن يرجع للمنزل يا إلياس

8
00:02:25,240 --> 00:02:26,750
!يريد الرّجوع

9
00:02:26,750 --> 00:02:28,160
!لديه مكان يرجع إليه

10
00:02:28,620 --> 00:02:30,330
.أرجوك علّمه كيف

11
00:02:38,170 --> 00:02:42,390
.طلباتك الأنانيّة دائمًا ما تكون ليست من أجلك

12
00:02:45,060 --> 00:02:46,350
.لا بأس

13
00:02:46,350 --> 00:02:48,680
.أنا هنا لهذا السّبب من الأساس

14
00:02:50,100 --> 00:02:51,730
.شكرًا جزيلاً لك

15
00:02:57,990 --> 00:03:00,570
.المسي التّنّين أوّلاً

16
00:03:01,320 --> 00:03:04,990
.يمكنك أن تمتصي سحره هكذا

17
00:03:09,080 --> 00:03:13,840
.ثمّ سأقوم أنا بامتصاصه قبل أن ينكسر جسدك

18
00:03:16,050 --> 00:03:16,750
.حسنًا

19
00:03:19,090 --> 00:03:19,880
!أليس

20
00:03:19,880 --> 00:03:20,720
!نعم

21
00:03:21,300 --> 00:03:23,470
.سنجذب انتباه التّنّين

22
00:03:23,800 --> 00:03:24,850
.شكرًا لكم

23
00:03:28,640 --> 00:03:31,600
!من هنا

24
00:03:29,520 --> 00:03:30,600
!خذ هذه

25
00:03:36,230 --> 00:03:36,860
!نار

26
00:03:43,490 --> 00:03:44,740
!ميريتولي

27
00:03:45,200 --> 00:03:46,580
!إنّك صبيّ شقيّ

28
00:03:46,580 --> 00:03:49,250
!ارجع إلى منزلك بسرعة

29
00:03:51,830 --> 00:03:52,750
!الآن

30
00:03:53,210 --> 00:03:54,170
.فلنذهب

31
00:04:04,140 --> 00:04:05,340
.عند مؤخّرة عنقه

32
00:04:05,340 --> 00:04:07,260
.يوجد تدفّق قويّ هناك

33
00:04:10,020 --> 00:04:10,850
!تشيسي

34
00:04:18,820 --> 00:04:20,400
!إنّه يحاول الخروج

35
00:04:20,400 --> 00:04:22,240
!شتّت انتباهه يا ميريتولي

36
00:04:22,240 --> 00:04:24,410
!يا إلهي

37
00:04:33,620 --> 00:04:34,420
!هذا سيّئ

38
00:04:35,420 --> 00:04:36,920
!سينهار المكان

39
00:04:47,300 --> 00:04:48,180
!تشيسي

40
00:04:53,810 --> 00:04:54,640
!تشيسي

41
00:04:56,520 --> 00:04:58,270
!سحقًا، لا تكوني متهوّرة

42
00:04:58,270 --> 00:04:58,770
.روث

43
00:05:00,940 --> 00:05:02,820
هل أنتِ جاهزة يا تشيسي؟

44
00:05:06,530 --> 00:05:07,700
!إلياس

45
00:05:08,200 --> 00:05:09,120
!روث

46
00:05:09,120 --> 00:05:09,990
.نعم

47
00:05:14,500 --> 00:05:15,370
ماذا؟

48
00:05:16,250 --> 00:05:17,630
.يبدو القمر غريبًا

49
00:05:23,840 --> 00:05:25,470
هل أنتِ بخير يا تشيسي؟

50
00:05:25,470 --> 00:05:27,130
ماذا حلّ بإلياس يا روث؟

51
00:05:27,130 --> 00:05:28,590
.احترق، لكنّه بخير

52
00:05:28,590 --> 00:05:29,510
.نحن في طريقنا

53
00:05:29,510 --> 00:05:30,470
.النّهر

54
00:05:33,270 --> 00:05:34,480
...انتظري يا تشيسي

55
00:05:38,060 --> 00:05:40,690
.لا داعي لأن تأتي معي يا روث

56
00:05:41,320 --> 00:05:43,320
.اصطحب الجميع ثمّ تعالوا لأخذي

57
00:05:43,320 --> 00:05:45,700
...تشيسي، لا يمكن أن تكوني

58
00:05:46,030 --> 00:05:46,900
.لا بأس

59
00:05:49,570 --> 00:05:50,870
.لنرجع إلى المنزل معًا

60
00:06:44,670 --> 00:06:45,590
!أيّتها الغبيّة

61
00:06:51,050 --> 00:06:52,180
!تشيسي

62
00:06:55,600 --> 00:06:57,140
!تماسك

63
00:07:01,270 --> 00:07:02,190
...روث

64
00:07:02,980 --> 00:07:03,940
أين تشيسي؟

65
00:07:39,390 --> 00:07:42,270
...لم أعتقد أنّه سيهرب

66
00:07:57,700 --> 00:07:59,250
...سيّدة شانون

67
00:08:00,290 --> 00:08:01,250
...لماذا

68
00:08:02,790 --> 00:08:03,790
هل أنتِ بخير؟

69
00:08:03,790 --> 00:08:04,630
هل يمكنك النّهوض؟

70
00:08:05,630 --> 00:08:08,170
.سأنهض

71
00:08:17,760 --> 00:08:18,680
.مذهل

72
00:08:19,350 --> 00:08:21,810
.قد يكون مشدودًا، ولكن لا تنزعيه

73
00:08:22,350 --> 00:08:24,730
.أشعر وكأنّ شيئًا سينفجر

74
00:08:26,190 --> 00:08:27,270
!تشيسي

75
00:08:28,480 --> 00:08:29,820
.سيّدة أنجليكا

76
00:08:30,570 --> 00:08:32,490
.رائحتك فظيعة

77
00:08:33,900 --> 00:08:35,990
.سبقتك إليها أيّها الفاشل

78
00:08:44,670 --> 00:08:47,290
.سأفعل نفس الشّيء لابنتي

79
00:08:47,790 --> 00:08:50,710
.أخبرتك بألاّ تحاولي إنجاز كلّ شيء بمفردك

80
00:08:53,760 --> 00:08:56,590
.أعطيت هذا توبيخًا قاسيًا قبل قليل

81
00:08:57,680 --> 00:08:59,310
.أتساءل ما الّذي فعلته له

82
00:09:00,220 --> 00:09:01,680
كيف حال التّنّين؟

83
00:09:01,680 --> 00:09:04,230
والأشخاص الآخرون؟

84
00:09:04,730 --> 00:09:06,310
.عاد الجميع إلى منازلهم

85
00:09:06,690 --> 00:09:08,480
.التّنّين يحلم

86
00:09:13,320 --> 00:09:14,610
.هذا مطمئن

87
00:09:15,360 --> 00:09:19,120
هل احترقت أو شيء من ذاك القبيل يا إلياس؟

88
00:09:22,790 --> 00:09:26,710
أنتِ لا تدركين أنّك في حالٍ
أسوأ منّي، أليس كذلك؟

89
00:09:27,830 --> 00:09:29,500
.ليس كذلك في الحقيقة

90
00:09:30,040 --> 00:09:30,960
.أعلم

91
00:09:31,420 --> 00:09:36,010
حسنًا إذًا، لا يمكنني أن أترك هذا
المفسّر الفاشل أن يفسّر، صحيح؟

92
00:09:37,130 --> 00:09:38,340
.سيّد لينديل

93
00:09:38,340 --> 00:09:39,720
...يدك

94
00:09:40,140 --> 00:09:42,930
.جعلتك تقومين بدورٍ صعب

95
00:09:42,930 --> 00:09:43,970
.أنا آسف

96
00:09:44,850 --> 00:09:47,690
.فعلت هذا لأنّه يمكنني ذلك فحسب

97
00:09:49,520 --> 00:09:51,230
.لهذا السّبب ذلك سيّئ

98
00:09:52,320 --> 00:09:56,400
.لُعنتِ بواسطة قوى التّنّين

99
00:09:57,030 --> 00:09:58,110
لُعنت؟

100
00:09:59,370 --> 00:10:01,870
.سينتشر في جسدك

101
00:10:05,830 --> 00:10:08,080
.سيهاجمك، ويعذبك، ويسحرك

102
00:10:09,830 --> 00:10:12,800
.لا جسد بشريّ يمكنه احتواؤه

103
00:10:14,300 --> 00:10:17,630
.سينهار جسدك عاجلاً أم آجلاً

104
00:10:21,470 --> 00:10:25,060
إلى متى سيصمد هذا الجسد؟

105
00:10:26,390 --> 00:10:28,190
.لا أعلم، أنا آسف

106
00:10:29,140 --> 00:10:30,650
.فهمت

107
00:10:35,320 --> 00:10:36,570
...إذًا

108
00:10:37,030 --> 00:10:42,910
.عشت مع لعنتين حتّى الآن

109
00:10:43,580 --> 00:10:45,290
.أُجبرت على التّعايش معهما

110
00:10:46,200 --> 00:10:49,370
.إحداهما هي جسد السلي بيغي

111
00:10:50,040 --> 00:10:51,130
...والأخرى

112
00:10:55,000 --> 00:11:01,390
.على الأرجح أنّها لن تغادرني طالما عشت

113
00:11:05,600 --> 00:11:10,230
.ازدياد واحدة أخرى ليس بالأمر الجلل

114
00:11:14,360 --> 00:11:15,360
...أنتِ

115
00:11:19,570 --> 00:11:20,780
.إنّه غاضب

116
00:11:21,410 --> 00:11:23,240
أهكذا يغضب؟

117
00:11:23,490 --> 00:11:24,740
.أنا آسف

118
00:11:25,120 --> 00:11:26,990
.لا يمكنني أن أطلب منك مسامحتنا

119
00:11:26,990 --> 00:11:28,910
.لا تعتذر من فضلك

120
00:11:30,080 --> 00:11:32,170
.هذا دليل

121
00:11:32,920 --> 00:11:39,420
على أنّني تمكّنت من التّفكير
.بشخصٍ آخر عدا نفسي

122
00:11:41,680 --> 00:11:44,970
.لديك الخيار بالعيش في الجانب الآخر

123
00:11:44,970 --> 00:11:46,470
...ولكن هذا

124
00:11:47,260 --> 00:11:48,680
.سأفكّر بالأمر

125
00:11:48,680 --> 00:11:49,730
!تشيسي

126
00:11:50,020 --> 00:11:50,850
هل أنتِ متأكدة؟

127
00:11:51,390 --> 00:11:53,850
.قد لا تعودين بشريّة

128
00:11:54,940 --> 00:11:56,940
.أنا مستعدّة للأسوأ

129
00:11:57,900 --> 00:11:59,990
.عليّ فعل ما يمكنني فعله

130
00:14:08,910 --> 00:14:11,080
ألا بأس عليك بالخروج؟

131
00:14:11,580 --> 00:14:12,950
.ولم تخبري أحدًا أيضًا

132
00:14:13,660 --> 00:14:16,210
.أفضّل الهواء الخارجيّ

133
00:14:19,000 --> 00:14:21,460
كيف يمكنك الابتسام؟

134
00:14:28,840 --> 00:14:30,140
...منذ متى

135
00:14:30,640 --> 00:14:35,520
منذ أن حاولتِ المغادرة من النّافذة
.ولففت لفّة حول السّماء

136
00:14:36,230 --> 00:14:38,480
.هذا منذ البداية

137
00:14:40,730 --> 00:14:43,480
.يبدو أن جروتي قد فقدت عقلها

138
00:14:44,190 --> 00:14:47,150
.كنت أحاول ادّعاء الذّكاء فحسب

139
00:14:47,570 --> 00:14:49,360
ألم أخبرك من قبل؟

140
00:14:50,030 --> 00:14:54,620
،نسيتِ أخباري عندما تخرجين
.ومع ذلك ما زلتِ تتحدّثين بلباقة

141
00:14:55,160 --> 00:14:57,870
.لأنّك لم تردّ عليّ

142
00:14:59,670 --> 00:15:01,040
.كنت أنظّف

143
00:15:01,710 --> 00:15:03,340
طوال اليوم؟

144
00:15:04,420 --> 00:15:05,210
.نعم

145
00:15:06,090 --> 00:15:10,010
.دائمًا ما تحاولين الذّهاب إلى مكانٍ ما لوحدك

146
00:15:12,720 --> 00:15:19,890
.رغم أنّك دائمًا ما تمدّين يدك إليّ وتقبضينها

147
00:15:20,810 --> 00:15:23,150
.رغم أنّك تطلبين منّي العودة إلى المنزل

148
00:15:23,980 --> 00:15:30,280
ومع ذلك ستتركيني هكذا؟

149
00:15:31,820 --> 00:15:34,530
.ليس وكأنّني سأموت حالاً

150
00:15:35,160 --> 00:15:36,080
.لا أعتقد ذلك

151
00:15:37,080 --> 00:15:39,370
كيف كنت متفائلاً للغاية؟

152
00:15:39,830 --> 00:15:43,710
.علمتُ أنّ هذا ما سيحدث لك يومًا ما

153
00:15:44,130 --> 00:15:47,710
.كان عليّ إيقافك، ولكنّني لم أفعل

154
00:15:49,010 --> 00:15:56,350
ما زلت أعتقد في قرارة نفسي أنّك ستظلّين
.في ذلك المنزل إلى الأبد، وتمضين قدمًا

155
00:15:56,850 --> 00:15:59,560
.أنّك ستكونين بخير بطريقة ما

156
00:16:01,190 --> 00:16:02,730
.هذا غريب

157
00:16:03,230 --> 00:16:04,100
ما هو؟

158
00:16:04,440 --> 00:16:07,940
.كنّا نستغلّ بعضنا فحسب في بادئ الأمر

159
00:16:07,940 --> 00:16:11,110
.لم أعتقد أنّ هذا سيحدث لكوننا معًا فحسب

160
00:16:12,490 --> 00:16:16,530
.لم أرد العيش قبل هذا

161
00:16:17,410 --> 00:16:21,460
،ولكن أنقذني الكثير من الأشخاص

162
00:16:22,330 --> 00:16:27,340
واكتشفت أنّ بإمكاني فعل أمور
.تستحقّ أن أُشكر عليها

163
00:16:28,630 --> 00:16:31,880
لست أنتظر شخصًا يخبرني
.بأنّ بقائي مرحّبٌ به فحسب

164
00:16:32,590 --> 00:16:36,140
.بدأت أرغب بالبقاء وأرغب بفعل شيء

165
00:16:38,850 --> 00:16:40,470
.التّضحية بالنّفس

166
00:16:41,140 --> 00:16:45,850
تعتقدين أنّك ستكسبين الحقّ
.بالبقاء هنا بتدميرك لنفسك

167
00:16:46,360 --> 00:16:48,190
...إ-إلياس

168
00:16:49,190 --> 00:16:50,400
.أتساءل عن ذلك

169
00:16:51,030 --> 00:16:52,490
.لا أدري

170
00:16:53,490 --> 00:16:56,570
.فعلت ما فعلته لأنّ بإمكاني ذلك

171
00:16:58,370 --> 00:17:01,080
لست أكذب، هناك بعض الأشياء

172
00:17:01,080 --> 00:17:04,040
.في البشر لا نفهمها نحن فحسب

173
00:17:04,870 --> 00:17:05,870
حقًّا؟

174
00:17:07,830 --> 00:17:11,210
.إضافة إلى ذلك، جروتك غبيّة

175
00:17:11,210 --> 00:17:14,300
.يبدو أنّ جسدها يتحرّك قبل عقلها

176
00:17:18,720 --> 00:17:24,270
إلياس، هل ستساعد هذه الغبيّة
بالتّفكير بطريقة

177
00:17:24,940 --> 00:17:27,940
تمكّن كلينا من البقاء قرب بعضنا؟

178
00:17:30,070 --> 00:17:32,900
.لا أملك القدرة للقيام بما يلزم مثلك

179
00:17:33,530 --> 00:17:36,860
.ولكن يمكنني الذّهاب للتّأكد معك

180
00:17:38,450 --> 00:17:40,620
.أرجوك خذيني معك

181
00:17:48,420 --> 00:17:49,670
...علينا العثور عليها

182
00:17:50,170 --> 00:17:51,460
...علينا التّفكير

183
00:17:52,250 --> 00:17:54,800
.بطريقة للمضيّ قدمًا

184
00:17:56,930 --> 00:17:58,470
.مرحبًا

185
00:18:01,100 --> 00:18:02,760
.أنا مارييل

186
00:18:02,760 --> 00:18:04,770
.مارييل راعية الماعز

187
00:18:04,770 --> 00:18:06,730
.أنا ما يطلقون عليه مشعوذة

188
00:18:08,400 --> 00:18:10,360
صفقة في المزاد؟

189
00:18:10,360 --> 00:18:11,110
.نعم

190
00:18:11,110 --> 00:18:16,320
.طلبت دم التّنّين مقابل المال

191
00:18:16,780 --> 00:18:18,320
.لا يبدو أنّ ذلك سيجدي

192
00:18:18,320 --> 00:18:19,660
.أنا آسفة

193
00:18:21,870 --> 00:18:24,120
...أنت... يدك

194
00:18:28,080 --> 00:18:29,920
.سألقي نظرة فحسب

195
00:18:30,290 --> 00:18:31,710
.إنّك مفرط بالحماية

196
00:18:34,880 --> 00:18:35,920
...آنسة مارييل

197
00:18:35,920 --> 00:18:37,220
ذا مؤلم

198
00:18:41,220 --> 00:18:44,100
،يا إلهة الأرض اللاّمعة

199
00:18:44,510 --> 00:18:47,430
...يا إله الأعاصير ممزّق الثّعابين

200
00:18:48,730 --> 00:18:55,030
.مدّ لنا يد عونك، عينيك، لوهلة قصيرة

201
00:19:18,090 --> 00:19:19,970
ما هذا الشّيء؟

202
00:19:19,970 --> 00:19:21,550
!إنّه مخيفٌ للغاية

203
00:19:23,760 --> 00:19:25,640
لعنة تنّين؟

204
00:19:26,390 --> 00:19:29,770
هل لديك نيّة بأن تصبحي مشعوذة؟

205
00:19:30,480 --> 00:19:32,940
.اللّعنات تخصّص المشعوذات

206
00:19:32,940 --> 00:19:38,940
إن أصبحتِ واحدة منّا، إن انضممت
.إلى طائفتنا، فقد نتمكّن من مساعدتك

207
00:19:39,240 --> 00:19:40,150
.لا

208
00:19:41,110 --> 00:19:45,280
هل لديك الثّقة حقًّا بأن تخبر
امرأة ماذا تفعل بحياتها؟

209
00:19:46,370 --> 00:19:52,790
ماذا يجب أن أفعل لأصبح
واحدة منكم يا آنسة مارييل؟

210
00:19:53,130 --> 00:19:54,040
.تشيسي

211
00:19:54,380 --> 00:19:57,630
.شاركينا في اجتماعاتنا كضيفة في بادئ الأمر

212
00:19:58,210 --> 00:19:59,920
.بأسرع ما يمكن إن كان بمقدورك

213
00:20:02,800 --> 00:20:04,850
.افتحي هذا عندما تجهزين

214
00:20:10,520 --> 00:20:12,350
.سأنتظر ردّك

215
00:20:14,650 --> 00:20:15,900
.مع السّلامة

216
00:20:25,030 --> 00:20:27,370
.مرحبًا

217
00:20:30,160 --> 00:20:31,370
.هذا لا يصدّق

218
00:20:31,370 --> 00:20:33,170
فتاة صغيرة كهذه؟

219
00:20:35,210 --> 00:20:36,380
.تفضّلي

220
00:20:37,420 --> 00:20:38,340
بطاقة؟

221
00:20:38,800 --> 00:20:41,470
.إنّها دعوة لعيد ميلادي

222
00:20:41,470 --> 00:20:42,760
متى عيد ميلادك يا تشيسي؟

223
00:20:44,510 --> 00:20:45,470
.اليوم

224
00:20:45,470 --> 00:20:46,300
اليوم؟

225
00:20:46,300 --> 00:20:48,050
!ماذا؟! أين حفلتك؟

226
00:20:48,050 --> 00:20:50,220
لِمَ لم تُقم حفلة لها؟

227
00:20:50,220 --> 00:20:52,850
حفـ... يل؟

228
00:20:54,230 --> 00:20:55,440
.يا إلهي

229
00:20:55,440 --> 00:20:56,860
.إذًا، السّنة القادمة

230
00:20:56,860 --> 00:20:58,900
.عليك التّفكير بما ستفعلينه

231
00:21:00,230 --> 00:21:01,230
...السّنة القادمة

232
00:21:02,860 --> 00:21:04,150
ما الخطب؟

233
00:21:04,150 --> 00:21:05,860
.أشعر بالغثيان فجأة

234
00:21:06,200 --> 00:21:08,330
...سأذهب إلى دورة المياه، لذا

235
00:21:08,330 --> 00:21:11,370
.لا بأس، أتيت لإعطائك البطاقة فحسب

236
00:21:11,660 --> 00:21:12,870
.اعتني بنفسك

237
00:21:13,830 --> 00:21:14,580
...تشيسي

238
00:21:25,220 --> 00:21:29,640
.يحدث هذا عندما قرّرت أنّني لا أريد الموت

239
00:21:33,640 --> 00:21:35,940
.لننضمّ إلى اجتماع المشعوذين

240
00:21:37,730 --> 00:21:39,110
ألا تمانع ذلك؟

241
00:21:39,860 --> 00:21:44,280
.قد لا تنجو تلميذتك حتّى الرّبيع

242
00:21:46,200 --> 00:21:47,240
.لا بأس

243
00:21:48,320 --> 00:21:51,280
.ما يهمّ أكثر هو اعتناؤك بصحّتك

244
00:21:53,160 --> 00:21:55,870
.شكرًا لك

245
00:21:57,080 --> 00:22:01,420
.عليّ التّفكير بحفلتي للسّنة القادمة

246
00:22:11,050 --> 00:22:13,180
لعنة تنّين؟

247
00:22:15,640 --> 00:22:20,310
،بين لعنتي الّتي تمنعني من الموت
...ولعنتك الّتي تقودك إلى الموت

248
00:22:20,690 --> 00:22:23,440
.قد تسير الأمور بشكلٍ جيّد

249
00:23:55,660 --> 00:24:00,210
الحقيقة المقدّمة في اجتماع
.المشعوذين كانت قاسية

250
00:24:00,910 --> 00:24:05,000
يتحرّك السّاحر من أجل إنقاذ
...الفتاة، ولكن

251
00:24:05,460 --> 00:24:09,460
الشّيء الوحيد الّذي يمكنه
.تعويض حياة هو حياة أخرى