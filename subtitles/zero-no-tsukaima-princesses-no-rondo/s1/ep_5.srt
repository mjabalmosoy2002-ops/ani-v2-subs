1
00:00:05,550 --> 00:00:07,810
.لقد لمستُ صدر تيفانيا عندما كنتُ في المشفى

2
00:00:07,810 --> 00:00:11,180
.لم استطع إمساك نفسي من لمس صدرها

3
00:00:11,180 --> 00:00:15,360
.لقد قمتُ بتقيّد تيفانيا على الرغم من مقاومتها لي, حتّى أنفّذ رغبتي

4
00:00:15,770 --> 00:00:20,610
.كلما قاوّمتْ تيفانيا أكثر, كلما زادتْ رغبتي بها أكثر

5
00:00:20,780 --> 00:00:25,120
من قال لك أن تتوقّف؟ أليس هناك المزيد لتقرأه؟

6
00:00:25,120 --> 00:00:28,200
,كلما قاوّمتْ تيفانيا أكثر, كلما زادتْ رغبتي بها أكثر"

7
00:00:28,200 --> 00:00:32,710
وما زلتُ أ-أ-أداعبُ ص-صدرها" ,صحيح؟

8
00:00:32,710 --> 00:00:36,330
.لا يمكنني قراءة هذهِ السخافات

9
00:00:36,330 --> 00:00:37,420
ما هذهِ الوعود؟

10
00:00:37,420 --> 00:00:39,130
.إنّها ليستْ سخافات

11
00:00:39,130 --> 00:00:41,090
.لقد رأيتُ ذلك بأمِّ عيني

12
00:00:41,090 --> 00:00:43,590
.ص-صحيح, عندما كنتُ تلمسُ صدرها

13
00:00:43,590 --> 00:00:46,550
.لهذا قلتُ لكِ إنَّ تيفانيا هي من طلبتْ منّي ذلك

14
00:00:46,550 --> 00:00:48,890
.لا يمكنني تصديق هذهِ الكذبة

15
00:00:51,350 --> 00:00:53,390
.هيّا, اكمل القراءة الآن

16
00:00:53,730 --> 00:00:55,270
.حسنًا, حسنًا

17
00:00:55,270 --> 00:01:01,610
.آه, أنا الفارس سايتو دي هيراجا, أعترفُ بجريمتي هذهِ

18
00:01:01,610 --> 00:01:04,360
...إضافةًّ لهذا

19
00:01:05,860 --> 00:01:07,740
.بسرعة, قلها

20
00:01:08,490 --> 00:01:10,450
أم إنّك تريدُ قضاء بقيّة حياتك بلا ملابسك؟

21
00:01:11,700 --> 00:01:15,000
.أنا لا أحبُّ الصدور الضخمة

22
00:01:15,000 --> 00:01:18,920
.أقسمُ إنّي لن ألمس صدر أيِّ شخصٍ آخر

23
00:01:19,590 --> 00:01:20,920
.قم بتوقيعها

24
00:01:22,670 --> 00:01:24,670
.أشعرُ بالأسى بشأنِ سايتو-سان

25
00:01:24,670 --> 00:01:26,930
.هذا الأمر بين سيّدة ومرافقها

26
00:01:26,930 --> 00:01:28,550
.ابقي بعيدة

27
00:01:28,550 --> 00:01:29,510
...لكن

28
00:01:29,510 --> 00:01:31,390
.لا بأس, سيستا

29
00:01:31,390 --> 00:01:32,970
...سايتو-سان

30
00:01:38,520 --> 00:01:41,610
.ماذا؟ اسرع بالتوقيع

31
00:01:41,610 --> 00:01:43,530
.لا أستطيعُ التحمّل أكثر

32
00:01:45,780 --> 00:01:48,200
.لا يمكنني التوقيع على هذا الشيء

33
00:01:48,910 --> 00:01:51,870
.هيه, لن أسمح لك بالذهاب هكذا

34
00:01:52,410 --> 00:01:56,080
كيف لي أن أبقى مع سيّدةٍّ لا تثقُ بمرافقها؟

35
00:01:56,830 --> 00:01:58,120
.أراكِ لاحقًا

36
00:02:01,380 --> 00:02:03,170
...بعد مشاهدتي لذلك

37
00:02:03,760 --> 00:02:06,130
هل تتوقّع أن أثق بك؟...

38
00:03:42,650 --> 00:03:45,570
لماذا لا تصدّق ما أقولهُ لها؟

39
00:03:46,150 --> 00:03:48,780
.يجبُ أن تضع نفسك مكانها أيضًا

40
00:03:48,780 --> 00:03:51,990
.قبل أن أفعل هذا, كان يجب أن تستمع إلى قصتي

41
00:04:11,130 --> 00:04:12,680
...كولبيرت-سينسي

42
00:04:17,510 --> 00:04:21,100
.سينسي, لقد أصبحتُ فارسًا

43
00:04:22,190 --> 00:04:25,440
.لقد كنتُ سعيدًا, شعرتُ وكأنّهُ تم قبولي

44
00:04:26,400 --> 00:04:28,110
.أريدُ أن أرى عالمك

45
00:04:28,570 --> 00:04:30,650
.خذني إلى هناك يومًا ما

46
00:04:31,650 --> 00:04:35,950
.أنت الوحيد الذي يصدّق ما أقول

47
00:04:37,370 --> 00:04:41,410
.أريدُ أن أتحدث إليك أكثر

48
00:04:48,460 --> 00:04:50,960
كيف تكون تيفا قد طلبتْ منك ذلك؟

49
00:04:50,960 --> 00:04:52,510
.كنت تلمسهم بنفسك

50
00:04:52,590 --> 00:04:55,180
.هناك حدود لمدى غباء الآخرين وتصديقهم له

51
00:05:00,260 --> 00:05:05,190
...الصدر الوحيد المسموح لك بلمسه هو صدري

52
00:05:10,020 --> 00:05:12,690
ماذا؟ منذُ متى كنتُ نائمًا؟

53
00:05:12,990 --> 00:05:15,860
أنو, هل بإمكانكِ إهداء هذهِ إلى جييش-ساما؟

54
00:05:15,860 --> 00:05:17,320
وهذهِ إلى رينارد-ساما؟

55
00:05:17,780 --> 00:05:19,990
.رجاءً قفن في صفٍ واحد, صفٍ واحد

56
00:05:24,120 --> 00:05:25,330
ما هذا؟

57
00:05:28,920 --> 00:05:30,550
لما كلُّ هذا؟

58
00:05:31,500 --> 00:05:36,470
.لقد زادتْ بعد حادثة لوفت بانزر ريتر

59
00:05:36,470 --> 00:05:39,350
.رينارد-سان, هناك فتاةُّ من السنةِّ الأولى تناديك

60
00:05:39,350 --> 00:05:40,140
.حسنًا

61
00:05:40,720 --> 00:05:41,640
من هذا؟

62
00:05:41,640 --> 00:05:43,680
.جيملي, عضو جديد إنظم إلينا

63
00:05:43,680 --> 00:05:46,100
.إنظم لنا, حتّى يصبح شعبيًا بين الفتيات

64
00:05:48,650 --> 00:05:51,520
.ما هذا؟ الجميع مهتمٌ لهذا

65
00:05:54,240 --> 00:05:56,900
.لم أتوقّع أنّي سأقع بمشاكل الشهرة هكذا

66
00:05:56,900 --> 00:05:57,610
.جييش

67
00:06:00,410 --> 00:06:02,160
.م-مومورانسي

68
00:06:04,580 --> 00:06:06,580
من أعطاك كلَّ هذا؟

69
00:06:06,580 --> 00:06:08,830
.إنّه سوءُ فهم, مومورانسي

70
00:06:08,830 --> 00:06:12,130
.لقد أعددتُ كلَّ هذا لكِ, صدقيني

71
00:06:13,170 --> 00:06:15,420
.أريدُ تصديق هذا

72
00:06:15,920 --> 00:06:18,010
.لكنّي قلقة

73
00:06:18,010 --> 00:06:21,050
.لأنَّ الفتيات لن يتركنك وحدك الآن

74
00:06:21,800 --> 00:06:23,470
...مومورانسي

75
00:06:25,680 --> 00:06:28,560
.إنّه مختلفٌ عن شخصٍ نعرفهُ

76
00:06:28,560 --> 00:06:29,520
.بالفعل

77
00:06:29,520 --> 00:06:31,190
.آه, سايتو

78
00:06:31,190 --> 00:06:32,900
...مرحبًا, مارليكـ

79
00:06:34,400 --> 00:06:36,650
ما رأيك, ألا يبدو لطيفًا؟

80
00:06:36,690 --> 00:06:39,490
.بريجيتا أصرّتْ على أن أرتديه

81
00:06:39,490 --> 00:06:41,870
.آه, ماريكورن-ساما

82
00:06:41,870 --> 00:06:45,080
.آه, من الصعبِ أن تكون مشهورًا

83
00:06:45,080 --> 00:06:47,750
.لقد وصل إليه الربيع أيضًا

84
00:06:48,830 --> 00:06:51,920
آه, ما الذي تفعلهُ, جييش؟

85
00:06:51,920 --> 00:06:53,590
.تعال معي فقط

86
00:06:53,590 --> 00:06:56,630
.يبدو أنّك الوحيد الذي لا يحقُّ لهُ فعلُ مثل هذهِ الأشياء

87
00:06:56,630 --> 00:07:00,050
,ماذا, سايتو, يبدو أنّك قد تشاجرت مرّة آخرى مع لويز

88
00:07:00,380 --> 00:07:04,560
هل تريدني أن أعلمك كيف تتعامل مع الفتيات؟

89
00:07:08,890 --> 00:07:11,730
ماذا؟ ألا تريدُ العودة؟

90
00:07:12,560 --> 00:07:14,570
هل أنت غاضبٌ لهذا الحد؟

91
00:07:16,150 --> 00:07:18,490
...أين كنت طوال الوقت, سايـ

92
00:07:18,490 --> 00:07:21,240
.أنا آسفة لأنّي لم أكن سايتو-سان

93
00:07:22,370 --> 00:07:25,280
.لم ينطق أحد باسم ذلك الكلب الغبي

94
00:07:26,910 --> 00:07:30,000
.لا أعتقدُ أنَّ سايتو-سان سيعودُ الليلة هنا

95
00:07:30,410 --> 00:07:31,870
ماذا يكونُ هذا؟

96
00:07:31,870 --> 00:07:34,460
.تتحدثين وكأنّي أنتظرُ عودتهُ

97
00:07:34,460 --> 00:07:38,710
.من يهتم بذلك الكلب الغبي, يالهُ من شعورٍ رائع عندما يكونُ غير موجود

98
00:07:41,630 --> 00:07:43,340
لماذا أستحقُّ كلَّ هذا؟

99
00:07:44,600 --> 00:07:47,010
ما هو سبب شجاركما؟

100
00:07:47,010 --> 00:07:50,100
.لقد قام بلمس صدر أحدى الفتيات

101
00:07:50,100 --> 00:07:52,060
.أنا مندهش لبقائه على قيد الحياة

102
00:07:57,320 --> 00:07:57,980
.خذ

103
00:07:59,440 --> 00:08:02,160
.تناول المزيد, يبدو أنّك جائع

104
00:08:02,860 --> 00:08:04,530
.لقد فقدتُ شهيتي

105
00:08:08,080 --> 00:08:11,500
.كم أحسدك, ليس لديك شيءٌ لتقلق حوله

106
00:08:14,080 --> 00:08:17,500
.ذلك السايتو مكتئبٌ بالفعل

107
00:08:17,500 --> 00:08:19,460
.يالهُ من مسكين

108
00:08:19,460 --> 00:08:22,630
.أريدُ أن أراهُ مبتهجًا قريبًا

109
00:08:25,640 --> 00:08:27,510
.ليس هناك شيءٌ لنفعلهُ

110
00:08:28,180 --> 00:08:28,970
.كابتن جييش

111
00:08:29,810 --> 00:08:31,180
ماذا هناك, جيملي؟

112
00:08:32,140 --> 00:08:33,850
.لديَّ فكرةٌّ رائعة

113
00:08:36,730 --> 00:08:40,650
.في الحقيقة, أشعرُ بالذنب قليلاً لما فعلتهُ

114
00:08:43,780 --> 00:08:45,820
.أعتقدُ إنّي قلتُ الكثير أيضًا

115
00:08:46,450 --> 00:08:48,990
...لكن

116
00:08:50,790 --> 00:08:51,660
...لكن

117
00:08:53,330 --> 00:08:55,630
.لا يمكنني مسامحته

118
00:09:05,890 --> 00:09:07,510
.بالفعل, يجبُ علينا العودة

119
00:09:07,510 --> 00:09:10,060
ألا تريدُ اكتشاف الحقيقة؟

120
00:09:11,020 --> 00:09:12,600
.نحنُ نبلاء

121
00:09:12,600 --> 00:09:16,560
.من سيعلم متى سنموت من أجلا بلادنا

122
00:09:16,560 --> 00:09:21,650
رغم ذلك, تقول إنّك تريد الموت قبل اكتشاف الحقيقة؟

123
00:09:24,650 --> 00:09:27,160
.فيندانت, وصلنا إلى الأرض المقدسة

124
00:09:28,740 --> 00:09:30,790
.أحضر سايتو فورًا

125
00:09:30,790 --> 00:09:31,620
.حاضر

126
00:09:35,960 --> 00:09:38,710
.بالفعل, الكبير هو الأفضل بعد كلِّ شيء

127
00:09:38,710 --> 00:09:39,960
...أنو

128
00:09:43,090 --> 00:09:44,630
هل يمكنني الإنظمام؟

129
00:09:44,970 --> 00:09:46,130
...ا

130
00:09:46,130 --> 00:09:48,590
.إنّه خياركِ, استحمي أينما تشائين

131
00:09:49,050 --> 00:09:50,930
.هكذا إذًا

132
00:09:57,480 --> 00:10:01,690
.ي-ي-ي-يجبُ أن يكون هناك حدٌّ لهذا

133
00:10:03,440 --> 00:10:08,860
...إيل إيرث ديل

134
00:10:06,780 --> 00:10:08,200
.لقد أحضرتُ سايتو-سان

135
00:10:08,860 --> 00:10:10,950
ما هو الشيء الذي تريدون منّي مشاهدتهُ؟

136
00:10:18,750 --> 00:10:20,580
.هيّا, سايتو, سوف تحصل على أولِ نظرة

137
00:10:21,540 --> 00:10:22,300
أنا؟

138
00:10:22,300 --> 00:10:24,590
.اذهب للنظر وكن مبتهجًا

139
00:10:25,670 --> 00:10:27,630
ما كلُّ هذا؟

140
00:10:29,550 --> 00:10:30,680
ما هذا؟

141
00:10:30,680 --> 00:10:31,800
ضباب؟

142
00:10:35,560 --> 00:10:36,350
...ه-هل يمكن أن يكون

143
00:10:36,930 --> 00:10:38,440
حمام نساء؟

144
00:10:39,100 --> 00:10:41,310
هل أنتم من قام بصنع هذهِ الفتحة إلى حمام النساء؟

145
00:10:41,900 --> 00:10:44,320
.إنّها هديةًّ منّا

146
00:10:46,400 --> 00:10:48,900
.هذا الأمر لن يجعلني سعيدًا

147
00:10:48,900 --> 00:10:50,700
تبًا, في ماذا تفكرون؟

148
00:10:51,820 --> 00:10:52,950
.لويز

149
00:10:55,290 --> 00:10:56,080
.تيفا

150
00:10:56,080 --> 00:10:57,540
.ت-تيفانيا-تشان

151
00:10:57,910 --> 00:10:59,170
.ابتعد قليلًا, سايتو

152
00:10:59,170 --> 00:11:00,670
.أريدُ الرؤية بصفتي الكابتن

153
00:11:00,670 --> 00:11:03,000
.دعوني أرى أيضًا

154
00:11:13,180 --> 00:11:15,890
.تبًا, لا يمكنني الرؤية بسبب الضباب

155
00:11:15,890 --> 00:11:17,850
.إنّه دوري الآن

156
00:11:18,520 --> 00:11:21,480
.أنو, شكرًا لكِ

157
00:11:21,900 --> 00:11:24,150
.على إنقاذي قبل أيام

158
00:11:24,570 --> 00:11:27,490
.آه, ذلك, لم أفعل شيئًا

159
00:11:27,490 --> 00:11:35,740
.أردتُ الاعتذار قبل هذا, لكنّي شعرتُ بأنّكِ تتجنبيني, لذا فلم أجد الوقت المناسب

160
00:11:35,740 --> 00:11:38,330
.أ-أنا لا أتجنبكِ

161
00:11:38,330 --> 00:11:39,410
...فقط

162
00:11:47,000 --> 00:11:48,460
...أنا... أنا

163
00:11:48,460 --> 00:11:50,170
...يمكنني الموت الآن

164
00:11:51,680 --> 00:11:56,220
لا تريدين أن تصبحي صديقةًّ لفتاةٍّ تملكُ صدرًا غريبًا كهذا, صحيح؟

165
00:11:56,220 --> 00:11:58,640
.لا, الأمرُ ليس هكذا

166
00:12:00,810 --> 00:12:04,690
لويز-سان, أنو, هل تسمحين لي بلمس صدرك؟

167
00:12:04,980 --> 00:12:07,270
ماذا؟ تلمسين صدري؟

168
00:12:09,400 --> 00:12:12,070
.أريدُ معرفة كيف يبدو ملمس صدر الفتاة الحقيقي

169
00:12:12,070 --> 00:12:13,610
.أرجوكِ

170
00:12:13,610 --> 00:12:15,530
...حتّى إذا قلتِ هذا

171
00:12:15,950 --> 00:12:19,330
.بالمقابل, يمكنكِ أن تلمسي صدري أيضًا

172
00:12:19,330 --> 00:12:22,250
.وأيضًا, أن تقولي لي ما الغريب في صدري

173
00:12:23,420 --> 00:12:26,290
.انتظري لحظة, لستُ مستعدّةًّ لهذا

174
00:12:29,260 --> 00:12:32,720
أهذا ما تفعلهُ الفتيات في الحمام؟

175
00:12:34,260 --> 00:12:36,510
.إذًا هكذا يبدو ملمس صدر الفتاة الحقيقي

176
00:12:36,510 --> 00:12:38,850
.آسفة لأنّه مسطّح

177
00:12:40,430 --> 00:12:43,730
.كنتُ أعلمُ أنَّ هناك شيئًا غريبًا في صدري

178
00:12:49,730 --> 00:12:51,530
.ذلك السايتو الغبي

179
00:12:58,160 --> 00:12:59,950
...إنَّ الفتاتين

180
00:12:59,950 --> 00:13:01,750
.ستكونانِ عاريتين

181
00:13:03,540 --> 00:13:05,790
.ابتعدي, أنتِ تعيقين الرؤية, لويز

182
00:13:07,540 --> 00:13:11,050
.صحيح. لن يروا تيفا فقط

183
00:13:11,670 --> 00:13:15,800
.على هذا الحال, الجميع سيتمكّن من رؤية لويز عارية

184
00:13:15,800 --> 00:13:22,140
.لا تقلقي بشأنِ صدركِ, إنّه أكبر قليلاً من الآخريات

185
00:13:22,140 --> 00:13:24,270
.هذا مطمئن

186
00:13:24,270 --> 00:13:29,650
,لقد طلبتُ من سايتو-سان أن يلمسهما ليتفحصهما أيضًا
.لكن يبدو أنَّ الفكرة لم تعجبه

187
00:13:29,650 --> 00:13:32,230
انتظري لحظة, ماذا قلتِ الآن؟

188
00:13:32,530 --> 00:13:34,400
هل قام سايتو بلمسهما من أجلكِ؟

189
00:13:34,400 --> 00:13:35,320
.أجل

190
00:13:36,320 --> 00:13:39,780
.لهذا, فلتُ لكِ إنَّ تيفا طلبتْ منّي لمسهما

191
00:13:42,910 --> 00:13:46,540
.سايتو كان يقولُ الحقيقة

192
00:13:46,540 --> 00:13:50,210
.وأنا لم أصدقهُ مرّةًّ آخرى

193
00:13:50,750 --> 00:13:53,170
.ولم أحاول تصديقهُ حتّى

194
00:13:54,550 --> 00:13:55,670
!لويز-سان؟

195
00:13:57,090 --> 00:13:58,430
ماذا أفعل؟

196
00:13:58,430 --> 00:14:01,390
...إذا لم يعد سايتو

197
00:14:03,350 --> 00:14:08,150
.أنو, آسفة... لأنّي طلبتُ شيئًا غريبًا من سايتو-سان

198
00:14:08,150 --> 00:14:11,570
.باعتبار أن سايتو-سان حبيبكِ

199
00:14:13,610 --> 00:14:15,530
.إنّه ليس حبيبي

200
00:14:15,780 --> 00:14:17,610
.إنّه مرافقي فقط

201
00:14:19,070 --> 00:14:20,530
...أنتم

202
00:14:20,530 --> 00:14:22,120
.لا تنظروا

203
00:14:23,950 --> 00:14:25,000
.صوت رجل

204
00:14:26,960 --> 00:14:28,920
.انظرن, هناك فتحة هناك

205
00:14:29,250 --> 00:14:30,290
.آه, هذا سيئ

206
00:14:30,290 --> 00:14:31,210
.لنتراجع

207
00:14:31,210 --> 00:14:33,460
.لقد قلتُ لكم إنّه لا يجبُ علينا فعلُ هذا

208
00:14:33,460 --> 00:14:34,920
.من الأفضل أن تسرع, رينارد

209
00:14:35,260 --> 00:14:36,630
.انتظر

210
00:14:43,560 --> 00:14:45,560
.أيّها الرفاق, لا تدعوا أحدًا يمسكُ بكم

211
00:14:46,520 --> 00:14:48,520
.انتظروا, أيّها الرفاق

212
00:14:48,520 --> 00:14:50,980
.لقد علقت

213
00:14:57,570 --> 00:14:59,070
...رينارد

214
00:14:59,070 --> 00:15:02,030
.لم أتخيّل إنّك ستفعلُ هذا بينِ كلِّ الناس

215
00:15:03,120 --> 00:15:05,580
.أ-أنا كنتُ ضد هذهِ الفكرة

216
00:15:06,040 --> 00:15:09,040
.ال-الكابتن هو من اقتراح هذهِ الفكرة

217
00:15:09,540 --> 00:15:13,090
.الشخص الذي يقول هذا هو الأكثرُ ريبة

218
00:15:13,750 --> 00:15:14,840
...كن رجلاً و

219
00:15:15,840 --> 00:15:16,920
.اقبل العقوبة التي تستحقّها...

220
00:15:21,390 --> 00:15:24,810
...تبًا, بقي القليل حتّى أخرج

221
00:15:24,810 --> 00:15:26,220
.ها هو

222
00:15:27,060 --> 00:15:29,350
.لقد دخلتم من خلال تلك الفتحة

223
00:15:29,350 --> 00:15:31,810
.ارجوكن, ابقين على حياتي

224
00:15:36,320 --> 00:15:38,400
هل هناك شخصٌ آخر؟

225
00:15:41,320 --> 00:15:44,330
.توقّف عن الاختباء, يا مختلس النظر

226
00:15:46,740 --> 00:15:49,580
.من الأفضل لك أن تستسلم

227
00:15:51,540 --> 00:15:53,250
ما هذا؟

228
00:15:57,880 --> 00:15:59,090
.تيفا

229
00:16:01,470 --> 00:16:02,720
!ماذا يكونُ هذا بحق الجحيم؟

230
00:16:08,890 --> 00:16:10,520
.سأتحطّم, سأتحطّم

231
00:16:16,860 --> 00:16:18,030
من هناك؟

232
00:16:18,030 --> 00:16:19,190
.ابقى هادئًا

233
00:16:19,190 --> 00:16:20,070
...هذا الصوت

234
00:16:20,690 --> 00:16:21,740
!تاباسا؟

235
00:16:22,990 --> 00:16:25,820
هل من الممكن أنّكِ أنقذتِني من هناك؟

236
00:16:25,820 --> 00:16:28,200
.عشاء شيلفيد

237
00:16:28,200 --> 00:16:29,450
لأجلِ هذا؟

238
00:16:29,450 --> 00:16:31,580
.الفرسان لا يبقون دينًا على أعناقهم

239
00:16:32,960 --> 00:16:35,040
.على أيِّ حال, لقد انقذتِني, شكرًا لكِ

240
00:16:38,340 --> 00:16:40,800
!جييش, أين تحتبئ؟

241
00:16:41,420 --> 00:16:42,510
...آه

242
00:16:43,430 --> 00:16:44,680
.اخرج حالاً

243
00:16:46,350 --> 00:16:47,810
.جييش

244
00:16:47,810 --> 00:16:51,850
.لقد اخبرنا رينارد أنّك كنت أحد مختلسي النظر

245
00:16:53,520 --> 00:16:57,310
تلك التاباسا, لماذا هي عارية؟

246
00:17:01,440 --> 00:17:04,780
.أ-أرجوكِ, لا تقتربي أكثر

247
00:17:08,280 --> 00:17:09,410
.وجدنا جييش

248
00:17:09,410 --> 00:17:10,040
أين هو؟

249
00:17:15,620 --> 00:17:17,290
.نجونا

250
00:17:18,710 --> 00:17:20,090
ماذا هناك؟

251
00:17:21,340 --> 00:17:22,550
.شبح

252
00:17:23,300 --> 00:17:24,630
شبح؟

253
00:17:24,630 --> 00:17:27,970
ماذا؟ هل تخافين الأشباح؟

254
00:17:31,180 --> 00:17:33,850
.لا تقلقي, أنا معكِ

255
00:17:38,480 --> 00:17:39,520
.آوي, تاباسا

256
00:17:41,110 --> 00:17:44,070
.تبًا, هذا يثرني

257
00:17:53,250 --> 00:17:56,210
.سامحيني, مومورانسي

258
00:17:56,210 --> 00:17:58,710
.لقد كان بدافع الغريزة, إنّه مجرّد طيش فقط

259
00:18:00,340 --> 00:18:04,630
.هذهِ المرّة, عرفتُ بالفعل أيَّ نوعٍ من الأشخاص أنت

260
00:18:05,470 --> 00:18:06,590
.وداعًا

261
00:18:19,900 --> 00:18:22,320
كرة للدمى؟

262
00:18:22,900 --> 00:18:24,860
.يمكنني الرقصُ معك إذا أردت

263
00:18:27,400 --> 00:18:31,200
.أبذلُ جهدي كلَّ يوم, متمنيًا رؤية ابتسامتها

264
00:18:31,830 --> 00:18:34,160
رغم هذا, لماذا لا يجدي هذا نفعًا؟

265
00:18:35,330 --> 00:18:36,830
.سوف أصدقك

266
00:18:37,660 --> 00:18:39,710
.يبدو أني في حيرة

267
00:18:39,710 --> 00:18:44,630
.حتّى إذا كان طلب تيفا, ألا تعتبر خيانة للويز

268
00:18:44,630 --> 00:18:48,300
.حتّى الآن, أقولُ إنّي لم أفعل شيئًا خاطئًا, وبهذا أذبتُ مشاعر لويز

269
00:18:49,220 --> 00:18:50,640
.أنا الأسوأ

270
00:19:03,480 --> 00:19:06,280
.تلك الدمى ترقصُ هنا كلَّ ليلة

271
00:19:09,780 --> 00:19:12,450
.سمعتُ أنّك كنت داخل تلك الفتحة أيضًا

272
00:19:14,620 --> 00:19:15,990
ألن تنكر هذا؟

273
00:19:17,330 --> 00:19:18,330
.لا

274
00:19:18,910 --> 00:19:20,370
.أنت الأسوأ

275
00:19:20,370 --> 00:19:24,420
.لكنّي لم أعرف أنّهم سيختلسون النظر إلى حمام النساء

276
00:19:26,260 --> 00:19:30,090
.لقد تبعتهم لأنّهم قالوا لي إنَّ هناك شيئًا يستحق المشاهدة

277
00:19:30,090 --> 00:19:33,760
لكن بالتأكيد لن تصدقي ما أقولهُ, صحيح؟

278
00:19:35,220 --> 00:19:36,100
.أصدقك

279
00:19:37,560 --> 00:19:41,810
.حسنًا, لست ذكيًا بما فيه الكفاية لتلفّق كذبة

280
00:19:41,810 --> 00:19:44,020
.أنا أعرفك جيّدًا

281
00:19:44,020 --> 00:19:45,980
إذًا, حتّى ما حدث مع تيفا؟

282
00:19:46,900 --> 00:19:48,030
.أصدقك

283
00:19:50,280 --> 00:19:51,700
.شكرًا لكِ, لويز

284
00:19:53,320 --> 00:19:57,450
.أ-أنا أعتذرُ لك عن هذا أيضًا

285
00:19:57,450 --> 00:20:02,420
.حتّى إذا طُلب منك ذلك, كان خطأك لأنّك فعلتها

286
00:20:03,080 --> 00:20:06,090
.نعم, أنا آسف, لويز

287
00:20:06,090 --> 00:20:10,130
,أعدكِ بأن لا ألمس صدر فتاةًّ آخرى بعد الآن

288
00:20:11,300 --> 00:20:12,340
حقًّا؟

289
00:20:12,340 --> 00:20:14,970
ب-ب-بالرغم من أنّك تحب الصدور الكبيرة؟

290
00:20:15,640 --> 00:20:19,100
.أفضلُ الصغير مثل صدركِ تمامًا

291
00:20:19,890 --> 00:20:22,100
.ماذا؟ توقّف عن خداعي

292
00:20:22,100 --> 00:20:24,060
...إذا كنت صادقًا

293
00:20:26,730 --> 00:20:27,820
.اتركني

294
00:20:28,360 --> 00:20:29,900
.لن أترككِ

295
00:20:29,900 --> 00:20:32,070
.أردتُ دائمًا فعل هذا

296
00:20:32,570 --> 00:20:34,030
...سايتو

297
00:20:38,740 --> 00:20:40,540
.يجبُ أن تقبلني لتعوّض عن هذا

298
00:20:42,410 --> 00:20:44,750
.بكلِّ سرور, سيّدتي

299
00:20:57,470 --> 00:20:58,970
.شبح

300
00:21:09,480 --> 00:21:11,030
...هيه

301
00:21:11,030 --> 00:21:15,610
.يبدو أنَّك حقًّا تحبُ الصغير

302
00:21:15,610 --> 00:21:17,120
.اهدأي, لويز

303
00:21:17,120 --> 00:21:18,160
.هناك سببٌ لهذا

304
00:21:21,620 --> 00:21:25,870
.أنا لا أحبُ الفتيات الأصغر من لويز

305
00:21:25,870 --> 00:21:29,750
.أتعهّد بموجب هذا أن لا أمس صدر فتاةٍّ آخرى

306
00:21:30,050 --> 00:21:31,460
.وقعها

307
00:21:31,460 --> 00:21:32,510
.نعم

308
00:21:32,510 --> 00:21:33,630
...سايتو-سان

309
00:21:35,300 --> 00:21:37,640
.يمكنك أن تلمس صدري

310
00:21:40,390 --> 00:21:47,810
أ-أنت تعرفُ ماذا يحدثُ لك ع-عندما تنكثُ وعدًا, صحيح؟

311
00:21:48,310 --> 00:21:50,020
,انتظري, لويز