1
00:00:04,880 --> 00:00:06,340
أين أنا؟

2
00:00:10,280 --> 00:00:13,530
بحيرة؟ لمَ أنا عند بحيرة؟

3
00:00:13,530 --> 00:00:14,760
...كنتُ

4
00:00:16,100 --> 00:00:17,120
!تذكّرت

5
00:00:23,780 --> 00:00:26,880
!كلّا! آلة البيع في خطر

6
00:00:34,680 --> 00:00:38,310
كنتُ متيقّناً من موتي، لكن يبدو
أنّي على قيد الحياة

7
00:00:39,240 --> 00:00:40,870
...بأيّ حال، عليّ أن

8
00:00:40,870 --> 00:00:43,060
ماذا؟

9
00:00:43,060 --> 00:00:45,390
!ما هذا؟ جسدي لا يتحرّك؟

10
00:00:45,390 --> 00:00:46,800
!النجدة

11
00:00:46,800 --> 00:00:47,910
مرحباً

12
00:00:48,490 --> 00:00:50,830
أكان ذلك صوتي؟

13
00:00:50,830 --> 00:00:52,140
!انتظر، انتظر، اهدأ

14
00:00:52,760 --> 00:00:54,700
شكراً جزيلاً لك

15
00:00:54,700 --> 00:00:56,150
!ذلك صوتي بالفعل

16
00:00:56,420 --> 00:00:58,970
أتطلّع لاستعمالك التالي

17
00:00:58,970 --> 00:01:03,070
وسمعتُ هذه الكلمات مرّات عديدة

18
00:01:03,360 --> 00:01:05,290
}

19
00:01:05,550 --> 00:01:08,510
أنا مُعجبٌ بكلّ آلات البيع
التي قد صُنعت قطّ

20
00:01:08,510 --> 00:01:12,190
يعرف الجميع شغفي، فيستحيل أن
!أخطئ في التعرّف على ذاك الصوت

21
00:01:13,610 --> 00:01:14,740
...هذا يعني

22
00:01:15,420 --> 00:01:19,310
!أنّي تحوّلت لآلة بيع

23
00:01:26,780 --> 00:01:30,130
!هل وُلِدت من جديد بعد موتي كآلة بيع؟

24
00:01:31,170 --> 00:01:32,430
ذلك مستحيل

25
00:01:32,430 --> 00:01:36,030
...مهما كنتُ أهواها، لا يمكن أن يحصل شيءٌ

26
00:01:38,740 --> 00:01:42,570
!مـ-مذهل

27
00:01:42,570 --> 00:01:45,840
!كيفما نظرت للأمر، لا بدّ أنّي آلة بيع

28
00:01:45,840 --> 00:01:48,570
!سلعي معقولة السعر أيضاً

29
00:01:48,570 --> 00:01:53,600
هيكلي الأبيض المستطيل بدقّة
!يتميّز بالأناقة والعمليّة

30
00:01:53,960 --> 00:01:54,950
!لا يهمّ

31
00:01:55,230 --> 00:01:56,940
!هذا مُستحيل! لا يُعقل

32
00:01:56,940 --> 00:01:59,460
ولادتي من جديد كآلة بيع
!أفظع أمرٍ ممكن

33
00:01:59,890 --> 00:02:01,140
أو لا

34
00:02:01,140 --> 00:02:05,970
هل ولادتي من جديد كالشيء الذي أحبّه
هي تعاطفٌ إلهيّ معي؟

35
00:02:06,460 --> 00:02:09,120
حسناً، أنا ما أنا عليه الآن

36
00:02:09,120 --> 00:02:13,180
بصراحة، عدم استيائي الشديد من الأمر
هو الجانب الحزين من إعجابي

37
00:02:14,210 --> 00:02:15,570
مرحباً

38
00:02:15,570 --> 00:02:17,400
شكراً جزيلاً لك

39
00:02:17,400 --> 00:02:19,860
أتطلّع لاستعمالك التالي

40
00:02:19,860 --> 00:02:21,870
!قد تربح سلعة إضافيّة

41
00:02:21,870 --> 00:02:22,960
مؤسف

42
00:02:22,960 --> 00:02:24,230
!فزت

43
00:02:24,230 --> 00:02:26,330
أدخل قطعاً معدنيّة رجاءً

44
00:02:26,330 --> 00:02:28,880
هذا كلّ ما يمكنني نطقه؟

45
00:02:28,880 --> 00:02:30,790
أتساءل ما يمكنني فعله أيضاً؟

46
00:02:31,410 --> 00:02:34,920
أنت آلة بيع، آمن، تقمّص الدور

47
00:02:34,920 --> 00:02:36,910
!عليك التمكّن من تشغيل نفسك

48
00:02:36,910 --> 00:02:38,770
!افهم جسدك

49
00:02:40,220 --> 00:02:41,410
...في دماغي

50
00:02:41,410 --> 00:02:43,000
كلّا، لا أظنّ أنّي أمتلك دماغاً

51
00:02:43,000 --> 00:02:45,670
في رأسي، تظهر النصوص والأرقام

52
00:02:46,670 --> 00:02:50,470
هذه السلع التي أبيعها الآن، صنفان فحسب؟

53
00:02:50,470 --> 00:02:54,130
لتغيير النصف، أنفق نقاطاً رجاءً

54
00:02:54,130 --> 00:02:57,280
تغيير؟ يمكنني تغيير ما أبيعه؟

55
00:02:57,280 --> 00:03:00,770
ما النقاط؟ حيث مكتوب "بي تي"؟

56
00:03:00,770 --> 00:03:03,560
النقاط تُحوّل من النقود

57
00:03:03,560 --> 00:03:07,340
وإنفاق النقط يمكّن إعادة
تعبئة السلع وتغييرها

58
00:03:07,340 --> 00:03:09,300
كما الحصول على وظائف جديدة

59
00:03:09,300 --> 00:03:10,620
فهمت

60
00:03:11,770 --> 00:03:14,030
اكتشفتُ المزيد بالتحرّي أكثر

61
00:03:14,030 --> 00:03:18,300
لا تقتصر فائدة إنفاق تلك النقاط
،على الحفاظ على برودة ودفء السلع

62
00:03:18,300 --> 00:03:23,130
بل تمكّنني أيضاً من تسخين الطعام المجمّد
وإضافة ماء ساخن لرامن الكأس أيضاً وأشياء هكذا

63
00:03:23,530 --> 00:03:28,390
سأجرّب وظائفي وأرى ما السلع الأخرى
التي يمكنني بيعها

64
00:03:29,240 --> 00:03:34,350
يبدو أنّي أمتلك كلّ شيء قد اشتريه
!من آلات البيع عندما كنتُ حيّاً

65
00:03:34,350 --> 00:03:39,070
سأجرّب إنفاق 10 نقاط وأبدّل للشاي بالحليب البارد

66
00:03:42,430 --> 00:03:44,000
!كم هذا مُريح

67
00:03:44,000 --> 00:03:48,750
مئة ينّ ثمنٌ مناسب، وقالت أنّ بإمكاني
تحويل 100 ينّ إلى نقطة واحدة

68
00:03:49,070 --> 00:03:52,380
!حسناً! فلأتفقّد وظائفي الأخرى

69
00:03:52,910 --> 00:03:57,260
وأثناء قيامي بذلك، أدركتُ أمراً مهمّاً

70
00:03:58,360 --> 00:04:00,660
ولا يعمل جسدي بالكهرباء

71
00:04:00,960 --> 00:04:04,930
يبدو أنّي أستهلك النقاط لتشغيل نفسي بدل ذلك

72
00:04:06,090 --> 00:04:07,710
نقطة واجدة للساعة

73
00:04:07,710 --> 00:04:10,390
أي أنّي أستهلك 24 نقطة يومياً

74
00:04:10,390 --> 00:04:15,050
مما يعني أنّ عليّ جني 2400 ينّ يومياً

75
00:04:15,390 --> 00:04:20,130
،لا يزال لديّ فوق 900 نقطة
فيمكنني العمل لشهر

76
00:04:20,130 --> 00:04:23,540
لذا حرّي بي ألّا أهدر نقاطاً
حتّى يصبح دخلي ثابتاً

77
00:04:23,980 --> 00:04:24,810
...لحظة

78
00:04:25,070 --> 00:04:27,620
هل سيأتي زبائنٌ هنا بالأصل؟

79
00:04:33,990 --> 00:04:35,140
!لم يأتِ أحد

80
00:04:35,140 --> 00:04:37,250
هذا سيّئ! كلّ ما يحصل
!هو أنّي أفقد نقاطاً

81
00:04:37,250 --> 00:04:40,520
على هذا النحو، لن يظهر أحدٌ
!وسأتوقّف عن العمل

82
00:04:45,500 --> 00:04:46,790
ضفدع؟

83
00:04:46,790 --> 00:04:50,870
لكنّه يبدو بحجم البشر، ويرتدي
...ما يبدو درعاً، كما بيده

84
00:04:51,440 --> 00:04:53,210
،ربما هذا موضع دهشة

85
00:04:53,210 --> 00:04:56,360
لكنّ التحوّل لآلة بيع
يفوق صدمة ذلك

86
00:04:58,140 --> 00:04:59,370
مرحباً

87
00:05:02,080 --> 00:05:04,300
...أنا... حسناً

88
00:05:08,020 --> 00:05:09,220
!مهلاً، توقّف

89
00:05:11,060 --> 00:05:14,320
ضرر 3، انخفض التحمّل بمقدار 3

90
00:05:15,080 --> 00:05:16,580
ما هو "التحمّل"؟

91
00:05:16,580 --> 00:05:21,180
إن اُستنفد التحمّل، ستتعطّل آلة البيع
وتصبح غير قابلة للاستعمال

92
00:05:21,580 --> 00:05:23,680
!أي أنّها أشبه بنقاط ضربات في لعبة

93
00:05:23,680 --> 00:05:25,330
!كم لديّ الآن؟

94
00:05:25,840 --> 00:05:28,610
!ها هي! لا بدّ أنّها إحصائيّاتي

95
00:05:28,610 --> 00:05:31,130
!كلّ شيءٍ عدا التحمّل والصلابة 0

96
00:05:31,420 --> 00:05:34,410
حسناً، قد لا تحتاج آلة البيع لتلك

97
00:05:35,550 --> 00:05:36,620
لحظة، سحر؟

98
00:05:36,620 --> 00:05:38,560
هل يوجد السحر في هذا العالم؟

99
00:05:38,920 --> 00:05:42,190
يمكن استعادة التحمّل بإنفاق النقاط

100
00:05:42,190 --> 00:05:46,360
حقّاً؟ في تلك الحالة، لا أزال أملك
قرابة 900 نقطة، فقد يمكنني الصمود

101
00:05:49,220 --> 00:05:51,620
!كـ-كلّا! هذه ورطة

102
00:05:51,620 --> 00:05:53,360
...لو ضُرِبت بذاك الشيء

103
00:05:53,360 --> 00:05:54,640
!ربما وظيفة

104
00:05:54,640 --> 00:05:56,500
!أهنالك أيّة وظيفة مناسبة يمكنني إضافتها؟

105
00:05:56,500 --> 00:05:57,970
...لنرَ

106
00:05:57,970 --> 00:05:59,540
سكب الماء الساخن"؟"

107
00:05:59,540 --> 00:06:01,110
"تبويق العمليّات"

108
00:06:01,110 --> 00:06:02,470
"روليت الفائز الأكبر"

109
00:06:02,470 --> 00:06:03,790
!لا يمكنني استعمال أيٍّ من هذه

110
00:06:03,790 --> 00:06:06,700
ألّا توجد وظيفة ثوريّة بإمكانها
!إخراجي من هذا المأزق؟

111
00:06:07,090 --> 00:06:09,990
ضرر 2، انخفض التحمّل بمقدار 2

112
00:06:09,990 --> 00:06:12,090
!تبّاً! أحتاج لشيءٍ آخر

113
00:06:10,770 --> 00:06:13,830
ضرر 4، انخفض التحمّل بمقدار 4

114
00:06:14,140 --> 00:06:16,310
مُباركة"؟ ما هذا؟"

115
00:06:16,310 --> 00:06:18,690
قوّة خاصّة ممنوحة من إله

116
00:06:18,690 --> 00:06:21,980
قد تحصل عليها دون إنفاق أيّ نقطة

117
00:06:21,980 --> 00:06:25,250
لا أفهم تماماً، لكنّها أشبه بالسحر، صحيح؟

118
00:06:25,250 --> 00:06:26,640
!حسناً، أختار هذه

119
00:06:27,560 --> 00:06:30,080
!ماذا قد أفعل بفنّ المُسايفة أو الفنون القتاليّة؟

120
00:06:30,080 --> 00:06:31,440
!لا يمكنني تحريك أطرافي

121
00:06:31,440 --> 00:06:32,730
!لا أمتلك أطرافاً حتّى

122
00:06:32,730 --> 00:06:33,720
!ماذا يوجد أيضاً؟

123
00:06:34,780 --> 00:06:38,530
حاجز". يُنشر حاجز غير مرئيّ حولك"

124
00:06:38,530 --> 00:06:41,000
يمكنك اختيار الأجسام التي يمكنها عبوره

125
00:06:41,000 --> 00:06:43,060
!ها هو

126
00:06:49,700 --> 00:06:51,840
!قد تربح سلعة إضافيّة

127
00:06:53,630 --> 00:06:56,300
!وُلِدت آلة البيع المنيعة

128
00:06:57,080 --> 00:06:59,520
أتطلّع لاستعمالك التالي

129
00:07:01,000 --> 00:07:04,680
!انتظر لحظة، تتسرّب منّي النقاط كالماء

130
00:07:06,460 --> 00:07:09,890
!أعتقد أنّ عليكم الاستسلام! حقّاً

131
00:07:15,930 --> 00:07:17,130
نجوت

132
00:07:17,130 --> 00:07:19,630
فلأسترجع تحمّلي

133
00:07:22,170 --> 00:07:24,160
حسنٌ، تعافٍ كامل

134
00:07:24,160 --> 00:07:26,550
تبقّت لديّ 311 نقطة

135
00:07:26,550 --> 00:07:30,140
،سأصمد لما يفوق 10 أيّام
،لكن ما لم يشترِ أحدٌ شيئاً

136
00:07:30,140 --> 00:07:32,520
فستنفد نقاطي وأتوقّف عن العمل

137
00:07:32,520 --> 00:07:34,390
ما الذي سيحصل عندها؟

138
00:07:34,390 --> 00:07:35,560
هل سأموت؟

139
00:07:35,560 --> 00:07:39,440
...يا للحياة الجديدة المأساويّة
أو مدّة العمل المأساويّة بالأصحّ

140
00:07:39,440 --> 00:07:40,550
!أرجوكم

141
00:07:40,550 --> 00:07:43,940
!ليظهر أحد

142
00:07:46,860 --> 00:07:50,750
ليتني بعتُ شيئاً لمرّة على الأقلّ
كآلة بيعٍ قبل الموت

143
00:07:50,750 --> 00:07:52,670
!أعرف أنّكم هناك

144
00:08:01,530 --> 00:08:02,440
ماذا؟

145
00:08:02,440 --> 00:08:04,680
راودني شعورٌ أنّي سأجدهم هنا

146
00:08:05,240 --> 00:08:07,290
!لكن حمداً على عدم وجودهم

147
00:08:07,290 --> 00:08:11,500
!أتضوّر جوعاً، وخارت قواي

148
00:08:12,410 --> 00:08:14,930
لمَ يحصل هذا لي دوماً؟

149
00:08:14,930 --> 00:08:17,470
أسقطتُ حقيبة طعامي حتّى

150
00:08:17,470 --> 00:08:20,070
!آسفةٌ يا أمّي وأبي

151
00:08:20,070 --> 00:08:23,150
!لا أصلح لأكون صيّادة

152
00:08:23,150 --> 00:08:24,790
صيّادة؟ ما ذلك؟

153
00:08:25,130 --> 00:08:27,580
عليّ هزيمة شياطين ضفادع للحمها

154
00:08:27,580 --> 00:08:32,210
لكنّ هجماتي لا تصيبها عندما
!أكون وحدي، وأنا مُنهكة

155
00:08:32,850 --> 00:08:35,600
...لو كان لديّ طعامٌ على الأقلّ

156
00:08:35,600 --> 00:08:37,580
لحظة، ما ذلك؟

157
00:08:40,220 --> 00:08:43,980
يبدو معدنيّاً بالنسبة لنصبٍ حجريّ

158
00:08:44,300 --> 00:08:49,260
شكله غريب، لكن أهذه مشروبات وراء الزجاج؟

159
00:08:49,260 --> 00:08:51,740
وتبدو تلك ككتابة، لكنّي لا أستطيع قراءتها

160
00:08:51,740 --> 00:08:53,080
مرحباً

161
00:08:53,080 --> 00:08:55,750
!ما-ما كان ذلك الصوت؟! من أين صدر؟

162
00:08:55,750 --> 00:08:57,480
أدخل قطعاً معدنيّة رجاءً

163
00:08:58,070 --> 00:09:00,010
!أيتكلّم هذا الصندوق؟

164
00:09:00,010 --> 00:09:02,060
قطع نقديّة؟ أتقصد مالاً؟

165
00:09:02,060 --> 00:09:03,840
أتساءل ما إن كانت ستفي
القطع النحاسيّة بالغرض

166
00:09:03,840 --> 00:09:06,020
أنا مُتأكّدةٌ أنّها يجب
أن تكون فضّية على الأقلّ

167
00:09:06,020 --> 00:09:08,100
!لا تخبرني أنّها ذهبيّة؟

168
00:09:08,100 --> 00:09:10,280
...كأنّي سأمتلكها

169
00:09:10,630 --> 00:09:13,150
أدخلها؟ في هذه الفتحة الضيّقة؟

170
00:09:13,150 --> 00:09:16,630
ولا أدري ما هذا التجويف بالغطاء الشفّاف

171
00:09:18,060 --> 00:09:21,580
يبدو أنّ القطعة النحاسيّة
لم تكن صالحةً بالفعل

172
00:09:22,090 --> 00:09:23,710
هذه القطعة المعدنيّة غير مدعومة

173
00:09:23,710 --> 00:09:26,800
إذا حصلت على وظيفة تحويل القطع، يمكنك قبولها

174
00:09:26,800 --> 00:09:29,320
!ماذا؟ حقّاً؟! ا-انتظر قليلاً

175
00:09:29,320 --> 00:09:32,050
!ها هي! يمكنني إنفاق 100 نقطة

176
00:09:36,970 --> 00:09:38,850
ماذا؟ تغيّرت الأرقام

177
00:09:38,850 --> 00:09:40,220
!ألف أوا؟

178
00:09:41,010 --> 00:09:42,750
!تلك قطعة فضّية كاملة

179
00:09:42,750 --> 00:09:45,730
عملة هذا العالم هي "أوا" إذاً

180
00:09:46,300 --> 00:09:48,870
!ذلك باهظ، لكنّ معدتي بحاجةٍ للطعام

181
00:09:51,500 --> 00:09:55,240
!ها هي

182
00:09:55,560 --> 00:09:56,950
!إنّها تلمع

183
00:09:56,950 --> 00:09:59,120
!ربما عليّ ضغط هذا

184
00:10:00,040 --> 00:10:02,650
!حسناً، توجد صورة حساءٍ هنا

185
00:10:03,360 --> 00:10:04,910
!ما هذا؟

186
00:10:05,920 --> 00:10:07,490
خرج شيءٌ ما؟

187
00:10:07,490 --> 00:10:10,120
لن تلتهم يدي إن أدخلتُها، صحيح؟

188
00:10:10,120 --> 00:10:12,800
لن أفعل، لذا خذيها بسرعة

189
00:10:12,800 --> 00:10:15,250
!أنا أوصي بحساء الذرة هذا

190
00:10:19,000 --> 00:10:21,470
!مذهل! إنّه دافئٌ جدّاً

191
00:10:21,470 --> 00:10:24,200
حسناً، هل تلفّ الغطاء؟

192
00:10:24,200 --> 00:10:24,920
هكذا

193
00:10:26,140 --> 00:10:27,650
!رائحةٌ طيّبة

194
00:10:34,440 --> 00:10:36,530
!ما هذا؟! إنّه لذيذٌ جدّاً

195
00:10:36,530 --> 00:10:40,070
مذاقه أفضل بمراحل من الحانة
!التي كنت آكل فيها

196
00:10:40,940 --> 00:10:43,240
ما هذه السعادة؟

197
00:10:43,240 --> 00:10:47,530
إسعاد أحدٍ بهذا القدر يُشعرني بالبركة كآلة بيع

198
00:10:49,390 --> 00:10:51,680
نفد بهذه السرعة

199
00:10:51,680 --> 00:10:54,750
لا بدّ أنّ هناك أشياء أخرى لذيذة أيضاً

200
00:10:54,750 --> 00:10:57,340
هذا ماءٌ بوضوح

201
00:10:57,340 --> 00:11:01,010
مما يعني أنّ عليّ تجربة ذاك الشراب
باللون البنّي الخفيف أيضاً

202
00:11:02,800 --> 00:11:05,480
يبدو أنّ الشاي بالحليب راقها أيضاً

203
00:11:05,480 --> 00:11:10,060
اشترت فيما بعد ثلاثة علب
حساء بالذرة مع الماء

204
00:11:10,640 --> 00:11:15,310
جنيتُ ستّ قطع فضّية وثلاثين نحاسيّة
بما مجموعه 6300 أوا

205
00:11:15,310 --> 00:11:18,040
مما يعني أنّي استرجعتُ 63 نقطة

206
00:11:23,490 --> 00:11:26,360
لا بدّ أنّ المعدة الممتلئة أزالت توتّرها

207
00:11:26,360 --> 00:11:28,870
فقد غطّت الصيّادة في النوم

208
00:11:29,610 --> 00:11:32,900
إنّها عرضةٌ للهجوم، لكنّها أفضل زبائني

209
00:11:32,900 --> 00:11:35,570
لا تقلقي، سأحميكِ بحاجزي

210
00:11:37,180 --> 00:11:39,030
!حتّى إزالة القمامة مُتقنة

211
00:11:39,530 --> 00:11:43,400
يبدو أنّي آلة البيع الألطف في العالم

212
00:11:49,680 --> 00:11:51,500
غططتُ في النوم

213
00:11:52,180 --> 00:11:54,890
من الحسن أنّه لم تظهر وحوش

214
00:11:55,190 --> 00:11:59,310
صرفتُ الكثير من مالي، لكنّ معدتي
ودماغي بحالٍ أفضل

215
00:11:59,310 --> 00:12:00,860
شكراً لك حقّاً

216
00:12:00,860 --> 00:12:02,520
شكراً جزيلاً لك

217
00:12:01,760 --> 00:12:05,240
ماذا؟ أ-أجل، شكراً لك أيضاً

218
00:12:05,930 --> 00:12:09,180
هل يمكنك الكلام؟

219
00:12:11,540 --> 00:12:15,030
أو ربما يمكنك قول أشياء مُحدّدة فقط

220
00:12:15,500 --> 00:12:19,870
يبتكر أحد الأشخاص الذين أعرفهم
أدواتاً بقوّة سحريّة داخلها

221
00:12:19,870 --> 00:12:22,310
أتساءل ما إن كان هذا حالك أيضاً

222
00:12:22,310 --> 00:12:26,630
إن كنت لا تمانع، أودّ أن تقول شيئاً، أيّ شيء

223
00:12:26,630 --> 00:12:28,030
مرحباً

224
00:12:28,990 --> 00:12:30,170
!فهمتني

225
00:12:30,170 --> 00:12:32,920
!أنا مُتأكّدة أنّ هيولمي ستنبهر إن عرفت

226
00:12:32,920 --> 00:12:35,660
لحظة، لم أخبرك باسمي بعد

227
00:12:35,660 --> 00:12:37,230
أنا لاميس

228
00:12:37,640 --> 00:12:40,430
لاميس؟ يملك وقعاً غامضاً

229
00:12:40,430 --> 00:12:44,990
صحيح، إن كنت تريد، فلمَ لا تقول
،"مرحباً" عندما تقصد "أجل"

230
00:12:44,990 --> 00:12:47,930
وشيئاً آخراً عندما تقصد "لا"؟

231
00:12:47,930 --> 00:12:48,800
مؤسف

232
00:12:49,160 --> 00:12:52,110
أذلك مكان "لا"؟

233
00:12:52,110 --> 00:12:53,360
مرحباً

234
00:12:53,360 --> 00:12:55,060
أي "أجل"؟ فهمت

235
00:12:55,710 --> 00:12:58,260
حسناً... أيمكنك إخباري باسمك؟

236
00:12:58,260 --> 00:12:59,110
مؤسف

237
00:12:59,110 --> 00:13:04,830
فهمت، ما الذي تفعله هنا؟
ألديك مهمّةٌ هامة؟

238
00:13:04,830 --> 00:13:05,870
مؤسف

239
00:13:06,460 --> 00:13:10,850
هذا مجرّد تخمين... لكن أتشعر بالوحدة؟

240
00:13:10,850 --> 00:13:12,260
مرحباً

241
00:13:12,810 --> 00:13:15,040
ذلك ما ظننتُه

242
00:13:15,040 --> 00:13:17,300
بدوتَ حزيناً لسببٍ ما

243
00:13:17,890 --> 00:13:20,690
أيمكنني تحريكك؟

244
00:13:20,690 --> 00:13:21,930
مرحباً

245
00:13:21,930 --> 00:13:23,260
!حسناً

246
00:13:23,260 --> 00:13:26,540
هل تودّ أن أنقلك من هنا لتلتقي هيولمي؟

247
00:13:26,540 --> 00:13:29,320
أعتقد أنّكما ستكونان على انسجام

248
00:13:29,320 --> 00:13:30,480
مرحباً

249
00:13:30,480 --> 00:13:31,790
لا تمانع؟

250
00:13:31,790 --> 00:13:33,680
حسناً، اعذرني قليلاً

251
00:13:35,200 --> 00:13:36,410
!هكذا

252
00:13:37,270 --> 00:13:39,860
!مُحال! أنا أزن 500 كغ

253
00:13:40,840 --> 00:13:43,180
أنت ثقيلٌ بعض الشيء، لكن يمكنني تدبّر أمري

254
00:13:53,200 --> 00:13:54,940
!شكراً جزيلاً لك

255
00:13:57,740 --> 00:14:01,910
يبدو أنّ لاميس تمتلك مُباركة
"مدعوّة بـ "بركة القوّة

256
00:14:01,910 --> 00:14:05,180
ذلك يفسّر قوّتها المُذهلة

257
00:14:07,090 --> 00:14:09,360
سأستريح قليلاً هنا

258
00:14:10,120 --> 00:14:12,350
أصبحتُ أشعر بالجوع

259
00:14:12,350 --> 00:14:15,310
أتساءل ما إن كان بإمكاني شراء
ذاك الحساء الأصفر السميك

260
00:14:15,570 --> 00:14:18,490
لا يملؤ حساء الذرة المعدة لذاك الحدّ

261
00:14:18,940 --> 00:14:20,620
ماذا عن شيءٍ آخر؟

262
00:14:20,620 --> 00:14:22,260
!يبدو هذا مُناسباً

263
00:14:25,130 --> 00:14:28,780
...أ-أدهشني ذلك! لمعت فجأةً

264
00:14:29,610 --> 00:14:31,550
هل تغيّرت سلعك؟

265
00:14:31,550 --> 00:14:33,670
أهذا طعام؟

266
00:14:33,670 --> 00:14:34,750
مرحباً

267
00:14:35,050 --> 00:14:36,820
!هكذا إذاً

268
00:14:36,820 --> 00:14:39,820
إنّه الثمن نفسه، فربما سأشتري شيئاً

269
00:14:47,500 --> 00:14:49,080
!ما هذا القوام؟

270
00:14:49,080 --> 00:14:51,330
إنّه مالح، ذلك كلّ ما به

271
00:14:51,330 --> 00:14:52,740
!لكن لا أستطيع منع نفسي

272
00:14:53,660 --> 00:14:56,750
!مالي يتسرّب كالماء

273
00:14:56,750 --> 00:14:58,390
!لكن لا يمكنني التوقّف

274
00:14:58,390 --> 00:14:59,960
شكراً جزيلاً لك

275
00:15:00,650 --> 00:15:04,050
بفضل هذا، استرجعت 320 نقطة

276
00:15:04,430 --> 00:15:07,720
سأجرّب استعمالها لتغيير سعر المياه المعدنيّة

277
00:15:09,920 --> 00:15:14,080
أودّ عرضها بثمنٍ أرخص، لكنّ حياتي تعتمد على ذلك

278
00:15:14,080 --> 00:15:16,860
سنصل مدخل هذه الطبقة قريباً

279
00:15:16,860 --> 00:15:17,900
طبقة؟

280
00:15:17,900 --> 00:15:20,910
بعدها قرية، وسنستطيع الاسترخاء

281
00:15:25,400 --> 00:15:26,900
!رجعت

282
00:15:27,280 --> 00:15:28,580
!لاميس

283
00:15:28,580 --> 00:15:30,010
أنتِ سليمة؟

284
00:15:30,010 --> 00:15:32,060
كاريوس-سان، غورث-سان

285
00:15:32,060 --> 00:15:34,030
تمكّنتُ من العودة
على قيد الحياة بشكلٍ ما

286
00:15:35,200 --> 00:15:39,540
شعرنا بالقلق بعدما رجع أفراد
مجموعتك شبه أموات

287
00:15:39,540 --> 00:15:41,250
آسفة

288
00:15:41,250 --> 00:15:43,250
بالمناسبة، ما هذا؟

289
00:15:43,250 --> 00:15:47,290
،إنّها أداة سحريّة بإرادتها الخاصّة وفقما يبدو
جلبتُها من جانب البحيرة

290
00:15:47,290 --> 00:15:49,970
تعطيك سلعاً إن أدخلت نقوداً بها

291
00:15:49,970 --> 00:15:51,280
أداة سحريّة؟

292
00:15:51,280 --> 00:15:56,090
لم يسبق وأن سمعت بشيءٍ كهذا
"هنا في طبقة "بحيرة التدفّق الصافي

293
00:15:56,090 --> 00:15:58,220
أكان عليّ ألّا أجلبها؟

294
00:15:58,220 --> 00:15:59,610
لا أرى وجود مشكلة بالتحديد

295
00:16:00,250 --> 00:16:02,010
مفهوم المغارات

296
00:16:02,010 --> 00:16:05,480
هو أنّه من يجد شيئاً ملقيّاً
في طبقة، يصبح مالكاً له

297
00:16:08,210 --> 00:16:09,530
مغارات؟

298
00:16:09,530 --> 00:16:14,080
،كانوا يتكلّمون عن الطبقات وما شابه
أنحن في متاهةٍ ما؟

299
00:16:14,350 --> 00:16:16,520
لكن توجد سماء

300
00:16:16,520 --> 00:16:19,770
أخبريني، أيمكننا شراء أشياء أيضاً إن دفعنا؟

301
00:16:19,770 --> 00:16:22,310
أجل، أظنّ ذلك

302
00:16:22,310 --> 00:16:23,250
هذا ممكن، صحيح؟

303
00:16:23,250 --> 00:16:24,460
مرحباً

304
00:16:24,890 --> 00:16:26,080
!تكلّمت

305
00:16:26,890 --> 00:16:29,220
أداة سحريّة يمكنها الكلام

306
00:16:29,220 --> 00:16:30,970
يمكن بيعها بسعرٍ مرتفع، صحيح؟

307
00:16:30,970 --> 00:16:36,040
!لن أبيعها! ستذهب معي للقاء هيولمي

308
00:16:36,040 --> 00:16:38,860
إلى مهندسة الأدوات السحريّة المجنونة تلك؟

309
00:16:41,360 --> 00:16:43,330
قطعة فضّية؟

310
00:16:43,730 --> 00:16:47,020
ليس الثمن رخيصاً، لكنّي سأتناوله

311
00:16:47,020 --> 00:16:49,010
أدخل قطعاً معدنيّة رجاءً

312
00:16:51,770 --> 00:16:54,090
!يا للعجب! مذاقه لذيذ

313
00:16:54,090 --> 00:16:55,360
!هذا أيضاً

314
00:16:55,360 --> 00:16:57,470
!سأجرّب بعض تلك الأشياء مقليّة المظهر

315
00:16:57,470 --> 00:16:58,830
أعطني القليل

316
00:16:58,830 --> 00:17:02,680
في النهاية، اشتريا كلّ السلع

317
00:17:03,250 --> 00:17:06,630
ما أروع التمكّن من شرب
!الأشياء الدافئة والباردة

318
00:17:06,630 --> 00:17:10,530
علينا الحرّاس البقاء هنا، لذا سيكون
من الرائع لو جلبتِها من فترة لفترة

319
00:17:10,530 --> 00:17:11,590
!حسناً

320
00:17:11,590 --> 00:17:13,920
العمل يزدهر

321
00:17:25,240 --> 00:17:26,240
...ذلك

322
00:17:30,620 --> 00:17:34,150
كفّي عن إثارة الجلبة وإهدار وقتنا

323
00:17:34,150 --> 00:17:36,420
ستعسّرين الأمور عليكِ لا أكثر

324
00:17:38,520 --> 00:17:40,230
!ما الذي تفعلينه؟

325
00:17:40,230 --> 00:17:43,870
مجموعة رجال بغيضي المظهر
يتكاتفون على فتاة صغيرة عاجزة؟

326
00:17:43,870 --> 00:17:45,370
هذه جريمة

327
00:17:45,370 --> 00:17:47,840
!يا للتعالي

328
00:17:47,840 --> 00:17:49,660
!فلتحضّري نفسكِ

329
00:17:49,660 --> 00:17:52,170
!لن نتهاون معكِ لأنّك فتاة وحسب

330
00:17:58,310 --> 00:18:01,330
!يـ-يكفي هذا الدرس لليوم

331
00:18:01,330 --> 00:18:03,630
أتطلّع لاستعمالك التالي

332
00:18:04,490 --> 00:18:07,420
لم تُصب ضرباتي بالفعل

333
00:18:08,210 --> 00:18:09,540
أأنتِ بخير؟

334
00:18:09,540 --> 00:18:10,860
هل آذوكِ؟

335
00:18:10,860 --> 00:18:12,970
كلّا، أنا بخير

336
00:18:17,750 --> 00:18:19,700
!يا سيّدة! لقد رجعت

337
00:18:20,390 --> 00:18:22,080
!لم تتأذي؟

338
00:18:22,080 --> 00:18:23,750
!كنتُ بغاية القلق

339
00:18:23,750 --> 00:18:24,910
آسفةٌ يا سيّدة

340
00:18:27,020 --> 00:18:29,000
!لاميس

341
00:18:30,530 --> 00:18:32,960
!أنتِ على قيد الحياة؟! لستِ شيطان جثّة، صحيح؟

342
00:18:32,960 --> 00:18:35,650
!أنا حيّة! حيّة يا مونامي

343
00:18:35,650 --> 00:18:39,220
!أتعرفين كم جعلتِني أقلق عليكِ؟

344
00:18:40,510 --> 00:18:41,480
آسفة

345
00:18:42,320 --> 00:18:46,730
عندما سألتُ الصيّادين، قالوا
!أنّهم هربوا وتركوكِ

346
00:18:48,110 --> 00:18:51,000
نشرتُ كلاماً سيّئاً عنهم للكثيرين

347
00:18:51,000 --> 00:18:53,080
بحيث لن يستطيعوا جني قوت
عيشهم في هذه القرية من جديد

348
00:18:55,030 --> 00:18:56,800
بالمناسبة، ما ذاك الشيء؟

349
00:18:57,440 --> 00:18:59,660
وجدتُه بجوار البحيرة

350
00:18:59,660 --> 00:19:01,700
جلبتِ شيئاً غريباً آخراً؟

351
00:19:01,700 --> 00:19:03,710
!إ-إنّه مُختلفٌ هذه المرّة

352
00:19:03,710 --> 00:19:07,410
إنّه مفيدٌ جدّاً، وأنقذني من مأزق

353
00:19:09,900 --> 00:19:11,400
!حسنٌ

354
00:19:11,890 --> 00:19:14,600
سترجعين للسطح لترينه لهيولمي؟

355
00:19:14,600 --> 00:19:16,980
أتملكين مالاً للدفع لدائرة النقل؟

356
00:19:18,010 --> 00:19:19,750
كلّا

357
00:19:21,340 --> 00:19:25,220
دائرة النقل"، يبدو أنّ هذا شيء هنا"

358
00:19:25,610 --> 00:19:30,230
ويٌصادف أنّ نفاد نقود لاميس هو بسببي، آسف

359
00:19:30,230 --> 00:19:34,510
حسناً إذاً، سيتعيّن عليكِ
العمل في نزلنا لفترة

360
00:19:34,990 --> 00:19:37,980
ربما سنجعل هذا الصندوق
قائماً هنا ليجذب الزبائن

361
00:19:37,980 --> 00:19:40,830
يمكننا بيع محتوياته، أشبه بضرب
عصفورين بحجرٍ واحد، صحيح؟

362
00:19:40,830 --> 00:19:41,710
مرحباً

363
00:19:42,420 --> 00:19:44,370
تتكلّم حقّاً

364
00:19:45,270 --> 00:19:47,400
حسناً، اجذبي الزبائن لنا

365
00:19:48,230 --> 00:19:52,420
وهكذا أصبحتُ متمركزاً أمام النزل

366
00:19:53,370 --> 00:19:58,820
توجد سماء، لكن يبدو أنّ هذه طبقة
مغارة تُدعى ببحيرة التدفّق الصافي

367
00:19:59,770 --> 00:20:04,170
بدأ الناس بالكلام عن نُدرة وطيب مذاق
سلعي، وبعت كميّات كبيرة منها

368
00:20:04,540 --> 00:20:09,140
وعند هبوط الليل، تحملني لاميس
وتضعني  أمام البوّابة

369
00:20:10,480 --> 00:20:14,560
أشعر بالعطش، لكنّي سئمتُ من كلّ المشروبات أخيراً

370
00:20:15,910 --> 00:20:19,460
ذلك لأنّك تشتري خمسة منها
يوميّاً على الأٌقلّ

371
00:20:19,460 --> 00:20:22,110
ربما حان وقت تغيير مخزوني

372
00:20:22,110 --> 00:20:24,330
ما وضعي الحالي؟

373
00:20:26,160 --> 00:20:29,100
بعد إعادة التعبئة مراراً وتكراراً
،وبيع ما يفوق 400 سلعة

374
00:20:29,100 --> 00:20:30,940
!لديّ ما يفوق 3 آلاف نقطة

375
00:20:30,940 --> 00:20:33,190
حسناً، ماذا أضيف؟

376
00:20:34,310 --> 00:20:37,280
من الأفضل وضع احتياجات الزبائن أوّلاً

377
00:20:37,570 --> 00:20:38,920
...لذا عليّ أن أضيف

378
00:20:43,510 --> 00:20:45,770
!تغيّرت السلع

379
00:20:46,060 --> 00:20:51,620
ثلاث قطع فضّية ليست بالثمن الرخيص، لكن إن كانت
!هناك أشياء جديدة لأجرّبها، فعليّ المغامرة

380
00:20:53,590 --> 00:20:55,680
!ساخن! إنّه ساخن

381
00:20:55,680 --> 00:20:57,270
كيف أفتحه؟

382
00:20:57,270 --> 00:20:58,930
انظر، توجد رسومٌ عليه

383
00:20:58,930 --> 00:21:00,660
أهكذا تفتحه وتأكل ما بالداخل؟

384
00:21:01,420 --> 00:21:03,920
،أصبح هذا مشهوراً في مدينة كهربائيّة معيّنة

385
00:21:03,920 --> 00:21:06,330
وأُضيف شرح لطيف ومُفصّل عليه

386
00:21:06,330 --> 00:21:08,910
كي يستطيع حتّى السيّاح الأجانب فهم المُنتج

387
00:21:09,630 --> 00:21:11,020
!فُتح

388
00:21:11,020 --> 00:21:12,530
رائحته زكيّة

389
00:21:16,870 --> 00:21:18,960
!مُذهل! إنّه مُذهل حقّاً

390
00:21:18,960 --> 00:21:20,790
!قد يكون المُفضّل لديّ

391
00:21:20,790 --> 00:21:25,720
لم يسبق وأن تناولتُ هذه المكوّنات
!وهي مغمورة في نكهة خفيفة ومعقّدة بشكلٍ ما

392
00:21:25,720 --> 00:21:27,890
!تبّاً! إنّها تجعلني أشتهي الخمر

393
00:21:27,890 --> 00:21:28,900
!دوري الآن

394
00:21:28,900 --> 00:21:31,900
!أنت! كنتُ على وشك شراء شيء آخر

395
00:21:31,080 --> 00:21:35,180
نال إعجابهما! يبدو أنّ بإمكاني توقّع
!بيع الكثير من الأودين المُعلّب

396
00:21:37,180 --> 00:21:38,960
مضت بضعة أيّام

397
00:21:39,450 --> 00:21:42,290
انتشرت أنباء الأودين المُعلّب بعدها

398
00:21:42,290 --> 00:21:45,740
وتسبّبت ببعض الازدهار في القرية

399
00:21:46,320 --> 00:21:48,980
لا بدّ أنّ السبب يرجع
لبرودة الطقس مؤخراً

400
00:21:49,550 --> 00:21:53,480
يلقي المشروب الرياضيّ الجديد الذي
أضفته مؤخراً رواجاً أيضاً

401
00:21:54,050 --> 00:21:56,450
،في النهار، أجعل الأودين المُعلّب غير مُتوفّر

402
00:21:56,450 --> 00:22:01,290
ففي ذاك الوقت يكون الطلب على مطعم
النُزل في أوجّه، فأحاول ألّا أعارض ذلك

403
00:22:01,290 --> 00:22:03,490
بل أساعد في جذب الزبائن بالمقابل

404
00:22:07,480 --> 00:22:10,520
أعتقد أنّ هذه الفتاة التي
أنقذتها لاميس في الزقاق

405
00:22:10,520 --> 00:22:11,310
...أنا

406
00:22:11,310 --> 00:22:12,710
مرحباً

407
00:22:12,710 --> 00:22:16,410
!كنتُ سأتكلّم أوّلاً كي أنال أفضليّة التفاوض

408
00:22:19,140 --> 00:22:20,060
!أنتِ

409
00:22:23,270 --> 00:22:24,610
ما كان ذلك؟

410
00:22:26,250 --> 00:22:29,850
مع المساء، تحملني لاميس للبوّابة

411
00:22:30,290 --> 00:22:32,930
،تقول أنّ حملي من الأمام غير مريح

412
00:22:32,930 --> 00:22:36,170
لذا اشترت إطاراً خشبيّاً يُوضع على ظهرها

413
00:22:39,460 --> 00:22:41,150
أشعر بالتخمة

414
00:22:41,150 --> 00:22:43,180
!سأرجع الآن

415
00:22:44,090 --> 00:22:47,930
أتى ضيفٌ مثير للاهتمام للنزل اليوم

416
00:22:47,930 --> 00:22:48,890
مرحباً

417
00:22:48,890 --> 00:22:50,750
كيف مضت الأمور معك؟

418
00:22:50,750 --> 00:22:52,880
!قد تربح سلعةً إضافيّة

419
00:22:52,880 --> 00:22:54,760
هل استمتعت ربما؟

420
00:22:56,110 --> 00:22:59,340
آمل أن يمكنك الكلام كثيراً يوماً ما

421
00:22:59,800 --> 00:23:04,180
لذا سأسرع بالادّخار كي يمكننا الذهاب للقاء هيولمي

422
00:23:04,630 --> 00:23:06,320
شكراً جزيلاً لك

423
00:23:06,320 --> 00:23:08,330
!لا تشكرني

424
00:23:08,330 --> 00:23:11,790
أنت من أنقذني يا هاكّون

425
00:23:12,090 --> 00:23:13,310
هاكّون؟

426
00:23:13,310 --> 00:23:16,940
من المُزعج مناداتك بأنت دوماً، فما رأيك؟

427
00:23:17,210 --> 00:23:18,740
!ربحت

428
00:23:18,740 --> 00:23:21,980
!رائع! آمل أن نكون على وفاق معاً يا هاكّون

429
00:23:22,900 --> 00:23:27,360
،كوني آلة بيع في عالمٍ آخر أمرٌ سخيف

430
00:23:27,360 --> 00:23:31,270
لكن ها أنا بدأتُ أفكّر
أنّ هذه ليست بالحياة السيّئة

431
00:23:35,300 --> 00:23:37,120
شكراً جزيلاً لك

432
00:23:37,120 --> 00:23:39,500
أتطلّع لاستعمالك التالي