1
00:00:09,400 --> 00:00:13,670
حضرة القائد! يقول أكا أنّه وجد وحشاً يبدو
أنّه ملك الأرواح في مقدّمة الطريق

2
00:00:13,670 --> 00:00:14,980
وجده إذاً؟

3
00:00:15,550 --> 00:00:18,790
،هاكّون، هذه مسؤوليّة كبيرة
لكن لنبذل قصارى جهدنا

4
00:00:19,620 --> 00:00:21,090
مرحباً

5
00:00:27,840 --> 00:00:29,050
كيف الوضع؟

6
00:00:29,640 --> 00:00:33,340
يوجد ملك الأرواح والوحوش التي
تحت إمرته في مقدّمة الطريق

7
00:00:33,340 --> 00:00:39,560
،خمسة شياطين جثث، خمسة موتى أحياء
...ثمانية شياطين هياكل عظميّة، وأربع جماجم لهب

8
00:00:39,810 --> 00:00:42,280
مجموعها 22 إذاً

9
00:00:42,280 --> 00:00:44,020
...ليس مُستحيلاً، لكن

10
00:00:44,020 --> 00:00:48,090
كنّا لنستطيع محيها بالسحر
لو كانت النائبة هنا

11
00:00:48,470 --> 00:00:52,210
ربما يمكنني إزالة عدد منها
بالسهام قبل اقترابنا

12
00:00:52,210 --> 00:00:55,240
أفضّل البدء بتقليص عددها على الأقلّ

13
00:00:57,230 --> 00:00:58,740
!هاكّون-سان

14
00:00:58,740 --> 00:01:00,450
هل فكّرت بشيء؟

15
00:01:05,800 --> 00:01:08,490
يبدو أنّه الجهاز الذي يرشّ الماء

16
00:01:08,490 --> 00:01:11,620
أرجّح أنّ شيئاً سيخرج منِ الفوهة
إن سحبت هذا

17
00:01:11,850 --> 00:01:13,340
مرحباً

18
00:01:13,650 --> 00:01:15,710
!خرج شيء

19
00:01:15,710 --> 00:01:17,310
إنّه مقرف

20
00:01:18,550 --> 00:01:20,840
أمن الآمن لمس هذا؟

21
00:01:20,840 --> 00:01:22,280
مرحباً

22
00:01:24,150 --> 00:01:27,110
إنّه زلق مثل الزيت

23
00:01:27,110 --> 00:01:28,440
لنجرّب إشعاله

24
00:01:30,340 --> 00:01:31,260
!حارّ! حارّ

25
00:01:31,260 --> 00:01:33,000
!إنّه شديد الاحتراق

26
00:01:33,000 --> 00:01:36,230
علينا رشّ العدو بهذا الزيت
سريع الاشتعال إذاً؟

27
00:01:36,230 --> 00:01:37,380
مرحباً

28
00:01:42,280 --> 00:01:44,590
حسناً، اتّبعوا الخطّة

29
00:01:44,900 --> 00:01:45,780
!هيّا بنا

30
00:01:46,750 --> 00:01:49,450
!الآن! أزل القنّينة البلاستيكيّة فحسب

31
00:01:59,810 --> 00:02:04,060
استعمل الحاجز للوقاية من اللهب
!والحرارة وثاني أكسيد الكربون

32
00:02:14,770 --> 00:02:16,090
!نحن جاهزون

33
00:02:16,090 --> 00:02:17,700
!سأحمينا من أيّ سحر

34
00:02:24,270 --> 00:02:26,400
تدافع ضدّ سحري؟

35
00:02:27,000 --> 00:02:30,410
!لا بدّ أنّ ذاك الضوء الأزرق الباهت حاجز

36
00:02:46,040 --> 00:02:47,190
!لاميس

37
00:02:49,960 --> 00:02:51,570
!شياطين الهياكل العظميّة

38
00:02:51,570 --> 00:02:53,500
!أصبح عددها أكبر

39
00:02:53,500 --> 00:02:55,420
!ربما لا يمكننا الاعتماد على تعزيزات

40
00:02:55,970 --> 00:03:00,000
يا فتاة،؛ هنالك شيءٌ ما
!في الصندوق على ظهركِ

41
00:03:00,000 --> 00:03:03,670
!حسناً، لا أعرف

42
00:03:03,670 --> 00:03:05,130
!يا حجار الجليد

43
00:03:05,910 --> 00:03:08,030
!ماذا؟ صمدت أمام هذه؟

44
00:03:08,310 --> 00:03:11,500
!في هذه الحالة، سأقذفك مع الحاجز

45
00:03:14,940 --> 00:03:16,550
سهلٌ جدّاً

46
00:03:21,740 --> 00:03:25,790
!ما الذي يجري؟ أهي تقاوم الرياح بالسحر؟

47
00:03:25,790 --> 00:03:27,770
كلّا، إنّها مُباركة القوّة فحسب

48
00:03:29,840 --> 00:03:33,230
!ستحتاج لأكثر من الرياح أو البرَد

49
00:03:33,450 --> 00:03:34,810
!كلّ شيء أو لا شيء

50
00:03:34,810 --> 00:03:36,110
!للأمام

51
00:03:36,110 --> 00:03:37,220
!سحق

52
00:03:40,410 --> 00:03:45,190
فهمت، يبدو أنّي أسأت تقدير قوّتك

53
00:03:45,410 --> 00:03:48,690
!لكنّك ستكونين عاجزة أمام هذا

54
00:03:48,690 --> 00:03:52,360
!توسّعي أيّتها الأرض، اصرخي بعويلك

55
00:03:55,220 --> 00:03:56,170
!مهلاً

56
00:03:56,170 --> 00:03:57,770
!لحظة

57
00:03:57,770 --> 00:03:58,960
!تغيير الهيئة

58
00:04:01,320 --> 00:04:02,880
!شكراً لك يا هاكّون

59
00:04:02,880 --> 00:04:03,870
مرحباً

60
00:04:04,120 --> 00:04:05,710
!يا أفكاك الأرض، انطبقي

61
00:04:10,070 --> 00:04:11,850
!اللعنة عليك

62
00:04:14,510 --> 00:04:15,560
!نجحت

63
00:04:15,560 --> 00:04:16,760
!رائع يا شوي

64
00:04:19,140 --> 00:04:20,740
!لا أحتاج للاعتماد على هذه

65
00:04:20,740 --> 00:04:23,940
!حقّاً؟ أنا أعتمد على شيء

66
00:04:24,340 --> 00:04:25,200
!هاكّون

67
00:04:25,200 --> 00:04:26,290
!أجل

68
00:04:46,620 --> 00:04:48,600
!رائع

69
00:04:48,600 --> 00:04:50,650
!مهلاً

70
00:04:54,610 --> 00:04:55,910
!فعلتماها

71
00:04:55,910 --> 00:04:56,800
!أجل

72
00:04:56,800 --> 00:05:01,060
لم أتصوّر أن تستطيعا هزيمة ملك الأرواح

73
00:05:01,320 --> 00:05:02,300
أجل

74
00:05:02,300 --> 00:05:06,620
،كلّ ما تحتاجه هو التحكّم بقوّتها
!وستصبح لاميس أكثر قوّة

75
00:05:07,040 --> 00:05:11,060
تبّاً لكم، من تظنّونني أكون؟

76
00:05:11,480 --> 00:05:15,190
لا يزال هذا الوغد حيّاً بالكاد

77
00:05:15,190 --> 00:05:19,330
!تستحقّون الموت للتعدّي على عظمتي

78
00:05:19,330 --> 00:05:22,170
كلامٌ كبير بالنسبة لشخص
على مشارف الموت

79
00:05:22,170 --> 00:05:25,230
أعتقد أنّي سأقوم بسحقك
كي نحصل على العملة

80
00:05:25,230 --> 00:05:29,900
...العملة؟ تعتقدون أنّي مجرّد حاكم

81
00:05:33,720 --> 00:05:36,770
!ابتعدوا جميعاً

82
00:05:45,810 --> 00:05:48,540
!ما-ما هذا؟! أصبح كلّ شيء أسوداً

83
00:05:46,030 --> 00:05:48,860
!هاكّون، ما هذا؟! ما الذي يجري؟

84
00:05:48,860 --> 00:05:50,490
انخفضت النقاط بمقدار 500

85
00:05:55,230 --> 00:05:56,560
!توقّف

86
00:06:01,410 --> 00:06:02,870
!يا-يا رفاق

87
00:06:03,720 --> 00:06:04,800
!يا للخطأ

88
00:06:14,300 --> 00:06:18,180
لم أدرك وجود من يستطيعون
النجاة من سيل ظلامي

89
00:06:18,530 --> 00:06:23,930
سأسترجع ذراع الميت التي تتشبّث بالضوء

90
00:06:33,070 --> 00:06:37,570
تخصّ الأدوات السحريّة الفائقة
المُستعملين الفائقين

91
00:06:37,570 --> 00:06:41,500
ألا توافقني أيّها الزائر من عالم آخر؟

92
00:06:41,500 --> 00:06:43,810
!إنّه يعرف هويّتي

93
00:06:44,330 --> 00:06:46,470
!من تكون بالضبط؟

94
00:06:47,110 --> 00:06:50,780
اسمي؟ نسيته منذ دهر بعيد

95
00:06:50,780 --> 00:06:53,920
لكنّي ربما ما يدعونه بالحاكم السفليّ

96
00:06:56,280 --> 00:06:58,920
هذه عملة حاكم الطبقة إذاً

97
00:07:00,280 --> 00:07:02,530
لا تثير أيّ اهتمام

98
00:07:05,660 --> 00:07:07,620
لـ-لمَ تقوم بهذا؟

99
00:07:08,510 --> 00:07:10,260
تسألين لماذا؟

100
00:07:10,260 --> 00:07:12,590
ما الخطأ في قيامي بالصيد؟

101
00:07:13,090 --> 00:07:18,070
ألم تهاجموا ملك الأرواح بالمقابل
لإشباع رغباتكم؟

102
00:07:18,070 --> 00:07:19,780
...ذ-ذلك

103
00:07:20,120 --> 00:07:23,300
هل ستقولين أنّ الأمر مختلفين؟

104
00:07:24,100 --> 00:07:25,810
حسناً أيّتها البشريّة؟

105
00:07:31,740 --> 00:07:33,240
محاولة جيّدة

106
00:07:33,240 --> 00:07:34,650
ذلك سراب

107
00:07:38,760 --> 00:07:40,020
!ميشول-كن

108
00:07:40,250 --> 00:07:42,450
تهاجمني في غفلة؟

109
00:07:42,450 --> 00:07:46,630
هلّا وضحتم لي كيف هي العدالة؟

110
00:07:46,630 --> 00:07:48,020
!لاميس

111
00:07:48,020 --> 00:07:50,950
!لا تقاتلي ذاك الشيء مباشرةً

112
00:07:50,950 --> 00:07:51,750
!هاكّون

113
00:07:52,110 --> 00:07:52,950
!إبادة

114
00:07:55,940 --> 00:07:57,830
أهذا كلّ ما لديكم؟

115
00:07:57,830 --> 00:07:59,020
!أعد التفكير

116
00:08:02,590 --> 00:08:04,460
!الآن فرصتنا للهرب

117
00:08:08,890 --> 00:08:10,190
!أسرعوا

118
00:08:11,690 --> 00:08:13,290
!سنغادر للوقت الراهن

119
00:08:13,780 --> 00:08:15,260
تخالون بإمكانكم الهرب؟

120
00:08:19,950 --> 00:08:21,440
أنتِ مزعجةٌ بحقّ

121
00:08:23,710 --> 00:08:24,650
هيولمي؟

122
00:08:25,460 --> 00:08:28,660
هجمة أخرى في غفلة بعدما قلته؟

123
00:08:33,910 --> 00:08:34,780
!شوي

124
00:08:38,220 --> 00:08:39,880
!دعهما

125
00:08:39,880 --> 00:08:41,230
...اهربي

126
00:08:42,220 --> 00:08:43,580
...بسرعة

127
00:08:43,850 --> 00:08:46,450
...خذي البقيّة

128
00:08:49,000 --> 00:08:53,190
روح التضحية بالذات البشريّة المؤثّرة

129
00:08:53,190 --> 00:08:54,430
لا بأس

130
00:09:00,520 --> 00:09:03,760
!توقّف

131
00:09:13,700 --> 00:09:18,690
وعدتِ بأن تساعديني دوماً

132
00:09:19,520 --> 00:09:22,570
الجميع بالانتظار في الميتم

133
00:09:22,570 --> 00:09:24,950
...لذا أرجوكما

134
00:09:25,790 --> 00:09:29,000
!أرجوكما، افتحا عينيكما

135
00:09:30,780 --> 00:09:34,210
يبدو أنّهما تريدان البقاء راقدتين للأبد

136
00:09:40,020 --> 00:09:41,120
!هذا سيّئ

137
00:09:41,120 --> 00:09:42,710
!فقدت السيطرة على نفسها من الغضب

138
00:09:42,710 --> 00:09:43,470
...على هذا النحو

139
00:09:49,360 --> 00:09:51,310
ر-أ-سك مؤسف

140
00:09:51,810 --> 00:09:53,670
أعرف يا هاكّون

141
00:09:53,670 --> 00:09:55,570
تخبرني بالهدوء، صحيح؟

142
00:09:55,570 --> 00:09:56,820
مرحباً

143
00:09:56,820 --> 00:10:01,880
لكن ما لم يقم أحد بشيء لإيقافه، فسنُقتل جميعاً هنا

144
00:10:02,160 --> 00:10:04,920
!أعرف، لذا لديّ خطّة

145
00:10:04,920 --> 00:10:09,220
!لكن إذا لم تنجح، ستموتين هباءً وحسب

146
00:10:10,700 --> 00:10:13,540
ما الخطب؟ اكتفيتم من الهجوم؟

147
00:10:13,540 --> 00:10:17,640
إذاً حان دوري لإضفاء المرح

148
00:10:18,810 --> 00:10:19,920
!اثقب

149
00:10:20,550 --> 00:10:21,590
!تفعّل في الوقت

150
00:10:25,250 --> 00:10:27,000
يا للابتذال

151
00:10:28,600 --> 00:10:30,650
شكراً لك يا هاكّون

152
00:10:30,650 --> 00:10:32,040
مرحباً

153
00:10:33,770 --> 00:10:36,600
أنا أؤمن بك يا هاكّون

154
00:10:36,600 --> 00:10:38,930
!لذا لن أخسر أمامه

155
00:10:39,780 --> 00:10:42,360
صحيح، أنا أؤمن أيضاً

156
00:10:42,360 --> 00:10:44,890
!بكِ، وبقوّتك

157
00:10:47,070 --> 00:10:48,170
هاكّون؟

158
00:10:48,170 --> 00:10:50,140
!قد تربح سلعةً إضافيّة

159
00:10:50,490 --> 00:10:51,840
فهمت

160
00:10:51,840 --> 00:10:53,830
لديك خطّة

161
00:10:53,830 --> 00:10:55,170
مرحباً

162
00:10:55,170 --> 00:10:57,800
!حسناً، هيّا بنا إذاً

163
00:11:01,300 --> 00:11:05,050
يبدو أنّك أنهيتِ تبادل الوداع

164
00:11:05,050 --> 00:11:07,250
لكن لا سبب للحزن

165
00:11:07,790 --> 00:11:11,470
سيلتمّ شملك بهما قريباً

166
00:11:11,830 --> 00:11:14,700
بضربة أقوى تقنياتي

167
00:11:14,700 --> 00:11:15,670
!الآن

168
00:11:15,670 --> 00:11:19,210
!اقذف لاميس بأقصى قوّة من الحاجز

169
00:11:21,170 --> 00:11:23,750
!هيّا

170
00:11:24,080 --> 00:11:25,320
!لن أدعك

171
00:11:25,320 --> 00:11:27,250
!اقذف البالونات بأقصى قوّة أيضاً

172
00:11:29,940 --> 00:11:30,920
سخافة

173
00:11:49,360 --> 00:11:52,970
لم يخطر لي أن تحطّمي ذراع الميت

174
00:11:57,310 --> 00:12:00,690
أتطلّع لرؤية نموّكم

175
00:12:00,950 --> 00:12:03,630
تعالوا للثأر في أيّ وقت

176
00:12:09,650 --> 00:12:12,150
!هيولمي! هيولمي

177
00:12:13,360 --> 00:12:17,580
وعدتِني بمساعدتي، أليس كذلك؟

178
00:12:17,580 --> 00:12:20,000
!قلتِ بأنّكِ ستبقين معي

179
00:12:20,000 --> 00:12:22,360
!هيولمي

180
00:12:22,790 --> 00:12:26,200
!أنتِ أيضاً يا شوي! لنأكل معاً من جديد

181
00:12:26,200 --> 00:12:28,020
!افتحي عينيك

182
00:12:30,170 --> 00:12:32,190
!ذاك الحقير

183
00:12:33,140 --> 00:12:34,990
!شوي! شوي

184
00:12:36,390 --> 00:12:38,130
!لن أدعك

185
00:12:38,130 --> 00:12:40,850
!لن أترك أيّ من مجموعتي يرحلون

186
00:12:41,550 --> 00:12:42,640
...القائد

187
00:12:42,640 --> 00:12:43,920
!لا تبقي ساكنة

188
00:12:43,920 --> 00:12:47,350
تعلّمتِ في الرابطة ما تفعلينه
!في أوقات كهذه

189
00:12:47,350 --> 00:12:48,080
!أجل

190
00:12:49,100 --> 00:12:50,790
تدليك قلبيّ

191
00:12:51,500 --> 00:12:54,250
!مما يعني سكتة قلبيّة

192
00:12:54,250 --> 00:12:55,010
...في تلك الحالة

193
00:12:59,460 --> 00:13:03,710
إذا تغيّر هاكّون، فذلك يعني أنّ علينا
استعمال هذا غالباً

194
00:13:03,710 --> 00:13:06,170
لكنّي لم يسبق وأن رأيت شيئاً كهذا

195
00:13:06,500 --> 00:13:07,860
لا عجب

196
00:13:07,860 --> 00:13:11,880
حتّى في عالمي السابق، هناك قلّة فحسب
من يجيدون استعمال مزيل الرجفان

197
00:13:12,230 --> 00:13:15,340
وذلك محصور أكثر لأهل هذا العالم

198
00:13:15,750 --> 00:13:17,810
!لكنّي لا أملك وقتاً للشرح

199
00:13:19,080 --> 00:13:21,480
!سأنفق كلّ النقاط لديّ

200
00:13:24,850 --> 00:13:26,620
إنّه يطفو

201
00:13:26,620 --> 00:13:28,470
أأنت من تفعل هذا يا هاكّون؟

202
00:13:28,470 --> 00:13:29,650
مرحباً

203
00:13:31,460 --> 00:13:36,000
اكشف صدر المريض، وأخرج
الكيس المربّع من الغطاء

204
00:13:36,000 --> 00:13:39,340
افتح الكيس وأخرج اللبادات

205
00:13:39,340 --> 00:13:40,920
!حـ-حسناً

206
00:13:41,270 --> 00:13:43,180
الآن الجزء الصعب

207
00:13:49,970 --> 00:13:51,150
!هاكّون، انتهيت

208
00:13:51,500 --> 00:13:52,860
أهذا جيّد؟

209
00:13:52,860 --> 00:13:53,890
مرحباً

210
00:13:54,290 --> 00:13:55,580
...حسناً، أوّلاً

211
00:14:01,390 --> 00:14:03,520
لا تلمس الجسد

212
00:14:03,520 --> 00:14:05,690
جارٍ قياس تخطيط القلب

213
00:14:05,690 --> 00:14:07,520
لا تلمس الجسد

214
00:14:08,110 --> 00:14:09,950
الصدمة الكهربائيّة مطلوبة

215
00:14:09,950 --> 00:14:11,740
ابتعد عن الجسد

216
00:14:12,010 --> 00:14:13,410
!فلتنجحي رجاءً

217
00:14:16,020 --> 00:14:17,970
تمّ تطبيق الصدمة الكهربائيّة

218
00:14:17,970 --> 00:14:20,850
فلتبدأ التدليك القلبيّ فوريّاً

219
00:14:20,850 --> 00:14:21,710
!حسناً

220
00:14:26,790 --> 00:14:28,420
...لا

221
00:14:28,420 --> 00:14:30,260
فات الأوان

222
00:14:30,260 --> 00:14:32,310
!كان علاجي بطيئاً جدّاً

223
00:14:32,310 --> 00:14:36,440
هيولمي، ساعدكِ هاكّون، لذا ستكونين بخيرٍ الآن

224
00:14:36,440 --> 00:14:39,010
!لذا أرجوكِ، افتحي عينيك

225
00:14:39,010 --> 00:14:40,370
!هيولمي

226
00:14:45,940 --> 00:14:48,440
...ماذا؟ ما الذي كنت

227
00:14:48,710 --> 00:14:50,440
!هيولمي

228
00:14:50,440 --> 00:14:53,290
!هيولمي! هيولمي

229
00:14:50,790 --> 00:14:52,800
!هاكّون، افعل ذلك لشوي أيضاً

230
00:14:52,800 --> 00:14:53,890
مرحباً

231
00:14:58,870 --> 00:15:00,250
...قائد

232
00:15:00,900 --> 00:15:03,120
وأنتم يا رفاق، ما الذي حصل؟

233
00:15:04,180 --> 00:15:05,440
!قـ-قائد؟

234
00:15:05,440 --> 00:15:08,300
!أقلقتِني يا حمقاء

235
00:15:08,300 --> 00:15:11,650
!يا قائد، أنت تخنقني

236
00:15:11,650 --> 00:15:13,300
ما الذي أصابك؟

237
00:15:11,960 --> 00:15:16,330
أهل هذا العالم أكثر صلابة مما ظننت

238
00:15:13,580 --> 00:15:16,330
!أنا بحاجة للتنفّس يا قائد

239
00:15:18,560 --> 00:15:20,730
!أقدّم خالص اعتذاري

240
00:15:21,010 --> 00:15:24,740
كنتُ أرافقكما، لكنّي عرضتكما للخطر مع ذلك

241
00:15:25,050 --> 00:15:26,880
لا تشعر بالذنب

242
00:15:26,880 --> 00:15:30,070
تباهيتُ بدوري، ولم أستطع فعل شيء

243
00:15:30,070 --> 00:15:31,190
أنا كذلك

244
00:15:31,920 --> 00:15:35,340
لكن، ذاك الحاكم السفليّ خطر حقّاً

245
00:15:36,140 --> 00:15:38,860
علينا إعلام الرئيس الدبّ بأسرع ما يمكن

246
00:15:39,560 --> 00:15:41,930
كان خصماً مهيباً بحقّ

247
00:15:42,420 --> 00:15:46,560
عند لقائنا القادم، هل سأستطيع حماية الجميع؟

248
00:15:48,200 --> 00:15:51,850
،بعد عدّة أيام، تعافت هيولمي وشوي

249
00:15:51,850 --> 00:15:54,890
"ورجعنا إلى "طبقة بحيرة التدفق الصافي

250
00:15:55,490 --> 00:15:59,530
ثمّ أبلغنا الرئيس الدبّ بتفاصيل الحادثة

251
00:16:00,880 --> 00:16:02,940
الحاكم السفليّ؟

252
00:16:02,940 --> 00:16:04,560
أتعرف شيئاً عنه؟

253
00:16:05,490 --> 00:16:13,620
،قرأت عنه في السجّلات القديمة فحسب
لكنّي أعتقد أنّه قائد يتبع لملك الشياطين

254
00:16:13,890 --> 00:16:17,330
!أي أنّ هناك من هو أقوى منه

255
00:16:17,720 --> 00:16:22,540
سأطلب اجتماعاً عاجلاً مع رؤساء كلّ طبقة الآن

256
00:16:23,010 --> 00:16:27,740
أريد أن ينال الجميع راحةً كافية
في حال وقوع أمر غير متوقّع

257
00:16:27,740 --> 00:16:28,560
حاضر

258
00:16:31,790 --> 00:16:33,520
!رجعتُ يا سيّدتي

259
00:16:33,520 --> 00:16:36,180
!لاميس! كنتُ بغاية القلق

260
00:16:36,180 --> 00:16:37,850
لم تتأذي أبداً؟

261
00:16:37,850 --> 00:16:38,480
أجل

262
00:16:40,570 --> 00:16:42,140
!لاميس

263
00:16:44,750 --> 00:16:47,610
أشعر أنّي رأيت هذا المشهد قبلاً

264
00:16:47,610 --> 00:16:50,330
!أأنتِ بخير؟ لم تُصابي في أيّ مكان؟

265
00:16:50,330 --> 00:16:52,350
أ-أنا بخير

266
00:16:52,990 --> 00:16:54,790
!رائع

267
00:16:54,790 --> 00:17:00,360
سمعتُ أنّكِ قاتلتِ عدوّاً أقوى من
!حاكم الطبقة، وشعرت بقلقٍ كبير

268
00:17:00,920 --> 00:17:02,830
شكراً لكِ يا مونامي

269
00:17:04,610 --> 00:17:10,170
يبدو أنّ قصّة قتالنا للملك السفليّ
انتشرت في أرجاء القرية

270
00:17:10,540 --> 00:17:15,250
سمعنا بالأنباء يا هاكّون! يبدو
!أنّك أدّيت دور النجم من جديد

271
00:17:15,250 --> 00:17:16,160
مؤسف

272
00:17:16,160 --> 00:17:17,780
لا تكن متواضعاً

273
00:17:17,780 --> 00:17:20,580
أبعدت وحشاً أقوى من حاكم الطبقة

274
00:17:20,580 --> 00:17:23,000
وأنقذت حياة هيولمي وشوي

275
00:17:23,000 --> 00:17:27,630
أنت جزءٌ لا يتجزأ من هذه القرية
الآن يا هاكّون-سان

276
00:17:28,360 --> 00:17:32,110
...يُسعدني سماع ذلك، لكنّي

277
00:17:33,180 --> 00:17:36,580
سمعتُ ببطوليّتك أيضاً يا هاكّون-ساما

278
00:17:37,030 --> 00:17:41,020
يُشعرني ذلك برغبة أكبر لدعوتك لمنزلي

279
00:17:41,420 --> 00:17:46,010
إلى حينها، تحمّل العيش مع لاميس-سان
مع عدم أريحيّة الأمر

280
00:17:48,400 --> 00:17:50,090
ما-ما كان ذلك؟

281
00:17:50,090 --> 00:17:51,160
من يعلم؟

282
00:17:54,320 --> 00:17:57,530
يوجد الكثير من الناس في هذه القرية

283
00:17:57,530 --> 00:17:58,970
ميشول-سان

284
00:17:58,970 --> 00:18:00,360
!أ-أجل؟

285
00:18:00,360 --> 00:18:02,430
أنتم فرقة النهمين

286
00:18:02,750 --> 00:18:04,850
ما الذي أتى بكم هنا؟

287
00:18:04,850 --> 00:18:07,920
ما الذي ستفعله بعد هذا؟

288
00:18:07,920 --> 00:18:08,550
ماذا؟

289
00:18:08,550 --> 00:18:13,300
إنّه "الحاكم السفليّ"، صحيح؟
!يخيفني العدوّ بتلك القوّة

290
00:18:13,300 --> 00:18:15,900
!قاتل معنا رجاءً يا ميشول-سان

291
00:18:18,550 --> 00:18:22,550
هزمني الحاكم السفليّ في المعركة الأخيرة

292
00:18:22,550 --> 00:18:24,350
...ميشول-سان

293
00:18:24,350 --> 00:18:27,330
...لذا أقسم على هذا السيف

294
00:18:28,120 --> 00:18:30,280
!لن أخسر أبداً المرّة القادمة

295
00:18:30,280 --> 00:18:34,790
سأنجح في حماية رفاقي الأعزّاء بلا ريب

296
00:18:37,420 --> 00:18:39,520
!مرحى

297
00:18:40,110 --> 00:18:41,680
!رائع

298
00:18:41,110 --> 00:18:45,930
قال الرئيس الدبّ أنّه سيستدعي الصيّادين
!الخبراء من كلّ طبقة

299
00:18:41,560 --> 00:18:43,720
!لم أعد أشعر بخوف كبير الآن

300
00:18:45,930 --> 00:18:46,790
ماذا؟

301
00:18:46,790 --> 00:18:48,880
قرابة 40 أو 50، صحيح؟

302
00:18:48,880 --> 00:18:51,940
سمعت أنّهم 200 أو 300

303
00:18:51,940 --> 00:18:55,240
أتساءل ما إن كان يمكننا جمع ألف

304
00:18:56,350 --> 00:18:59,240
أليس ذلك مُطمئناً يا ميشول-سان؟

305
00:19:01,270 --> 00:19:02,550
معك حقّ

306
00:19:08,150 --> 00:19:10,440
ما الخطب أيّها القائد؟

307
00:19:11,360 --> 00:19:12,600
قائد؟

308
00:19:12,600 --> 00:19:16,010
ما الذي نفعله بالأصل؟

309
00:19:17,320 --> 00:19:23,470
،ظننتُ أنّه إن كنت أسعى لتحقيق أمنيتي
فلا بأس إن لقيت حتفي في مكانٍ ما

310
00:19:23,470 --> 00:19:29,130
لكن الآن، لم أعد واثقاً من تعريض مجموعتي للخطر

311
00:19:29,130 --> 00:19:33,600
لهدفٍ لا أدري ما إن يمكن تحقيقه حتّى

312
00:19:33,600 --> 00:19:35,100
...كيريول

313
00:19:35,620 --> 00:19:39,450
مُذ متى تتكلّم بهذا التردّد؟

314
00:19:39,450 --> 00:19:43,140
صحيح، لا تلائم هذه النظرة الجادّة وجهك

315
00:19:43,750 --> 00:19:45,250
...أنتما

316
00:19:45,610 --> 00:19:51,620
!اتّباعنا لك هو شيء قرّرناه بأنفسنا

317
00:19:51,620 --> 00:19:56,300
لذا يا قائد كيريول، واصل التقدّم
للأمام ولا تقلق رجاءً

318
00:19:56,300 --> 00:19:58,900
فنحن سنحميك في الخلف

319
00:19:58,900 --> 00:20:01,850
أنا أشاركهما الرأي

320
00:20:05,250 --> 00:20:08,340
متى بدأتم تقول أشياءً
جديرة بالثناء كهذه؟

321
00:20:08,340 --> 00:20:10,690
!حسناً، سنذهب للصيد غداً

322
00:20:10,690 --> 00:20:15,320
أكا، شيرو! حضّرا حصّة 30 يوماً
!من الطعام! وعلى حسابكما

323
00:20:15,320 --> 00:20:17,020
!حـ-حصّة 30 يوماً؟

324
00:20:17,020 --> 00:20:18,740
!وعلى حسابنا؟

325
00:20:18,740 --> 00:20:23,270
بالمناسبة يا قائد، لم نتقاضَ
أجر هذا الشهر بعد

326
00:20:26,700 --> 00:20:31,410
في صباح يوم ما، حملتني لاميس
على ظهرها وغادرت القرية

327
00:20:31,410 --> 00:20:33,260
دون إخباري أين نتّجه

328
00:20:35,630 --> 00:20:37,610
أين تنوي الذهاب يا ترى؟

329
00:20:38,330 --> 00:20:39,970
وصلنا يا هاكّون

330
00:20:44,000 --> 00:20:45,430
...هذا

331
00:20:45,430 --> 00:20:47,610
أتذكّره يا هاكّون؟

332
00:20:47,610 --> 00:20:50,600
إنّه مكان لقائنا الأوّل

333
00:20:50,600 --> 00:20:52,150
مرحباً

334
00:20:52,580 --> 00:20:57,010
وأوّل مكان أنقذتني فيه

335
00:20:57,600 --> 00:20:58,810
...لاميس

336
00:20:59,370 --> 00:21:02,900
حصلت أمور كثيرة مذ تعرّفت عليك

337
00:21:03,460 --> 00:21:05,720
كان الكثير منها خطراً

338
00:21:06,270 --> 00:21:11,690
لكن كلّ مرّة، قمت بحمايتي وحماية رفاقي

339
00:21:12,620 --> 00:21:14,320
أنتِ مخطئة يا لاميس

340
00:21:14,320 --> 00:21:16,680
صادف أن حالفنا الحظّ حتّى الآن وحسب

341
00:21:16,680 --> 00:21:19,360
...لكن أثناء المعركة الفائتة

342
00:21:19,360 --> 00:21:24,870
هاكّون، أتفكّر بأنّ إصابة الجميع كانت غلطتك؟

343
00:21:25,600 --> 00:21:27,070
ذلك ليس صحيحاً

344
00:21:27,630 --> 00:21:29,150
ليس صحيحاً أبداً

345
00:21:29,740 --> 00:21:33,200
فبسبب بوجودك، لم أُصب بأذى

346
00:21:33,540 --> 00:21:37,660
ونجاة هيولمي وشوي كانت بفضلك

347
00:21:38,020 --> 00:21:41,870
لذا لا تفكّر بأشياء مُحزنة كتلك

348
00:21:43,460 --> 00:21:44,780
أرجوك

349
00:21:46,610 --> 00:21:53,130
لاميس، يُذهلني اهتمامكِ بي بهذا
القدر وأنا محض آلة بيع

350
00:21:57,350 --> 00:21:59,390
يبدو أنّه لم تكن هناك حاجة لذلك

351
00:22:00,080 --> 00:22:01,710
!هيولمي! شوي

352
00:22:01,710 --> 00:22:02,800
!لمَ أنتما هنا؟

353
00:22:03,080 --> 00:22:08,290
حسناً، سمعنا أنّكِ غادرتِ القرية مع هاكّون

354
00:22:10,170 --> 00:22:13,910
كما لم يتسنّ لنا شكره بعد

355
00:22:13,910 --> 00:22:15,160
صحيح

356
00:22:15,160 --> 00:22:16,980
...ماذا؟ أ-أنا

357
00:22:19,670 --> 00:22:22,910
!ما-ما-ما الذي تفعلانه؟

358
00:22:23,220 --> 00:22:25,510
نشكره بالطبع

359
00:22:25,510 --> 00:22:28,380
فقد أنقذنا من الموت

360
00:22:28,380 --> 00:22:31,110
أنتِ تدينين لهاكّون بالكثير أيضاً، صحيح؟

361
00:22:31,110 --> 00:22:33,220
اشكريه من حينٍ لآخر على الأقلّ

362
00:22:33,220 --> 00:22:34,890
أ-أشكره؟

363
00:22:34,890 --> 00:22:38,830
أجل، سيكون من الصائب أن أشكره

364
00:22:38,830 --> 00:22:42,410
قالت أمّي أنّ علينا شكر الناس دوماً

365
00:22:42,410 --> 00:22:43,330
!قلبي يخفق

366
00:22:49,360 --> 00:22:52,380
!لا، لا أستطيع فعلها

367
00:22:52,380 --> 00:22:55,030
!سأموت من الإحراج

368
00:22:54,240 --> 00:22:55,270
هذا سهل

369
00:22:55,270 --> 00:22:56,050
هيّا

370
00:22:56,050 --> 00:22:56,820
افعليها

371
00:23:10,390 --> 00:23:12,950
!يا إلهي، هيولمي

372
00:23:13,800 --> 00:23:16,010
!رائعٌ لكِ

373
00:23:16,010 --> 00:23:17,730
!بدوتِ رائعة

374
00:23:18,100 --> 00:23:20,320
!أنتِ أيضاً يا شوي؟

375
00:23:21,220 --> 00:23:27,780
ولادتي من جديد كآلة بيع للتجوّل
في مغارات عالم آخر أمرٌ سخيف

376
00:23:28,630 --> 00:23:33,680
!لكنّي أجد نفسي أتمنّى مواصلة العيش هكذا