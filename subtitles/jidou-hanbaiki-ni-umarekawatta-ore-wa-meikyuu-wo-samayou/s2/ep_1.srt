1
00:00:01,210 --> 00:00:02,770
مرحباً

2
00:00:03,970 --> 00:00:05,850
!صباح الخير يا هاكّون

3
00:00:05,850 --> 00:00:06,870
مرحباً

4
00:00:06,870 --> 00:00:08,850
!صباح الخير يا لاميس

5
00:00:09,270 --> 00:00:12,850
كاريوس، غورث! شكراً لكما
!على المُراقبة ثانية اليوم

6
00:00:12,850 --> 00:00:16,110
العفو. لا شيء يفوق شاياً حلواً
في نهاية مُناوبة ليليّة

7
00:00:16,980 --> 00:00:19,420
أتطلّع قُدماً لاستخدامكما لي ثانية

8
00:00:20,710 --> 00:00:23,450
مُتُّ ووُلِدتُ من جديد كآلة بيع

9
00:00:23,450 --> 00:00:26,320
...هذا وضع غريب يتواجد فيه المرء فجأة

10
00:00:26,320 --> 00:00:27,500
!صباح الخير

11
00:00:27,500 --> 00:00:30,740
لكن وجدتُ سُبُلاً للاستمتاع بهذا الأمر

12
00:00:39,470 --> 00:00:41,060
من الخارج، صندوق فولاذيّ مُستطيل

13
00:00:41,320 --> 00:00:43,300
!ويوجد بداخله روح بشريّ

14
00:00:43,300 --> 00:00:48,720
في عالم من الأعاجيب، أركب
على ظهر شريكتي لاميس

15
00:00:48,720 --> 00:00:51,140
!اسمي هاكّون! مرحباً بكم

16
00:00:51,140 --> 00:00:52,870
"!يعني هذا "أجل

17
00:02:07,060 --> 00:02:10,980
الحلقة 1: صيّادون ودوافع

18
00:02:09,440 --> 00:02:11,380
!أشعر بأنّني في الصّيف الآن

19
00:02:11,380 --> 00:02:12,600
مرحباً

20
00:02:12,600 --> 00:02:14,730
مرحباً، الوقت يمضي بسرعة

21
00:02:14,950 --> 00:02:19,740
أجل. من السّهل النّسيان نظراً
،لوجود سماء ومواسم مُتقلِّبة

22
00:02:19,740 --> 00:02:23,110
لكنّنا داخل ديماس بطبقات مُتعدّدة

23
00:02:23,530 --> 00:02:27,180
حالما تشتدّ الحرارة، أبدأ ببيع الآيس كريم

24
00:02:26,670 --> 00:02:27,870
هاكّون

25
00:02:27,870 --> 00:02:29,380
ميشويل

26
00:02:29,380 --> 00:02:31,640
لديّ طلب ضخم منك

27
00:02:31,640 --> 00:02:33,630
لِمَ هذه النّظرة الجادّة والرّسميّة؟

28
00:02:33,630 --> 00:02:36,880
في الواقع، كنتُ أتساءل حول
فكرة منذ مدّة

29
00:02:36,880 --> 00:02:37,880
!هاكّون

30
00:02:37,880 --> 00:02:40,260
رغم جسدك الفولاذيّ، أنت نبيل ولطيف

31
00:02:40,260 --> 00:02:43,010
دفاعك متين، ويمكنك حتّى إحياء الموتى

32
00:02:43,010 --> 00:02:45,430
!هذا لا يُشكّل فرقاً لو كنتَ أداة سحريّة

33
00:02:45,430 --> 00:02:46,990
!أنا مفتون بك

34
00:02:47,270 --> 00:02:47,900
ماذا؟

35
00:02:47,900 --> 00:02:49,150
مـ-مفتون؟

36
00:02:49,150 --> 00:02:53,220
هاكّون! هل يمكنني أن أسمِّيك
مُعلّم" اعتباراً من اليوم؟"

37
00:02:53,220 --> 00:02:56,450
بـ"مفتون"، تقصد أفلاطونيّاً، صحيح؟

38
00:02:56,890 --> 00:02:58,280
!هل جوابك هو "لا"؟

39
00:02:58,280 --> 00:03:02,040
ميشويل هو صيّاد خبير، لكن
مهاراته الاجتماعيّة فظيعة

40
00:03:02,400 --> 00:03:05,310
أنا متأكّد بأنّه استجمع كثيراً
من الشّجاعة ليقول ذلك

41
00:03:05,310 --> 00:03:07,260
سأكون ناضجاً في التّعامل مع هذا

42
00:03:07,260 --> 00:03:08,650
مرحباً بك

43
00:03:09,250 --> 00:03:10,930
!هذا يعني أنّك قبلت

44
00:03:10,930 --> 00:03:13,290
!شكراً لك يا مُعلّم هاكّون

45
00:03:13,290 --> 00:03:17,540
هـ-هذه المُعانقة هي مُجرّد مُعانقة، صـ-صحيح؟

46
00:03:19,650 --> 00:03:21,800
حصل أحدهم على تلميذ لنفسه

47
00:03:21,800 --> 00:03:23,440
أنا مُنبهرة يا هاكّون

48
00:03:23,440 --> 00:03:27,670
،مـ-مهلاً! سواء كان تلميذاً أم لا
!ليس لدي ما أُعلّمه إيّاه

49
00:03:28,010 --> 00:03:29,440
حسناً يا مُعلّم هاكّون

50
00:03:29,440 --> 00:03:31,590
أوّل شيء سأفعله هو تنظيفك

51
00:03:31,590 --> 00:03:33,100
!مهلاً يا ميشويل

52
00:03:33,100 --> 00:03:36,160
!أنا من سيُنظّفه! ليس عليك أن تُتعب نفسك

53
00:03:36,160 --> 00:03:37,470
هكذا إذاً

54
00:03:37,470 --> 00:03:40,690
أعتذر على تطفُّلي

55
00:03:40,690 --> 00:03:43,780
ممتاز، جميعكم هنا

56
00:03:43,780 --> 00:03:45,210
المُدير دبّ

57
00:03:45,210 --> 00:03:48,150
هاكّون، لاميس، هيوليمي، ميشويل

58
00:03:48,150 --> 00:03:51,870
نحن على وشك عقد اجتماع مُهمّ
في طبقة رثاء الميّت

59
00:03:51,870 --> 00:03:53,910
حبّذا لو تُرافقونني

60
00:03:53,920 --> 00:03:56,920
طبقة رثاء الميّت

61
00:04:03,410 --> 00:04:06,020
،هؤلاء، إلى جانب أداة السّحر هاكّون

62
00:04:06,020 --> 00:04:09,420
هم النّاجون من مُواجهة مع حاكم العالم السّفليّ

63
00:04:09,420 --> 00:04:14,690
إذاً هذه الأداة هي الصّندوق ذائع الصّيت
الّذي يبيع أشياء غير عاديّة

64
00:04:14,690 --> 00:04:19,900
أجل. لديه أيضاً قدرات مُفيدة أُخرى
أنقذتنا في مُناسبات عدّة

65
00:04:19,900 --> 00:04:20,850
حقّاً؟

66
00:04:21,200 --> 00:04:27,100
إنّه مُهمّ جدّاً بما أنّ مُدير كلّ رابطة
صيّادي طبقة موجود هنا

67
00:04:27,100 --> 00:04:29,120
لنتطرّق إلى صلب الموضوع

68
00:04:29,120 --> 00:04:34,870
حاكم العالم السّفليّ الّذي ظهر قبل بضعة أيّام
هو بلا شكّ قائد وذراع يسرى لملك الشّياطين

69
00:04:35,690 --> 00:04:37,250
هذا يعني أنّ الأمر جلل

70
00:04:37,250 --> 00:04:39,070
حاكم العالم السّفليّ

71
00:04:39,070 --> 00:04:42,610
الهيكل العظميّ ذو الأذرع الأربعة
الغامض الّذي ظهرَ فجأة

72
00:04:42,610 --> 00:04:45,710
عندما هزمْنا حاكم طبقة رثاء الميّت

73
00:04:46,110 --> 00:04:49,350
،أوقفَ قلبَي هيوليمي وشوي باستخدام السّحر

74
00:04:49,350 --> 00:04:54,390
لكن تحوّلتُ إلى جهاز طبّي، وصدماتي
الكهربائيّة قد أنعشتهما

75
00:04:55,610 --> 00:05:00,670
من المُطمئن أنّه لم يمُت أحد، لكن
لا يمكننا السّماح لشخص مثله يفلت

76
00:05:01,530 --> 00:05:05,800
هذا كيريويل، قائد قطيع الوحوش الحمقى

77
00:05:05,800 --> 00:05:08,060
لا أستطيع رؤية وجهه، لكن يبدو
أكثر خطورة من المعتاد

78
00:05:08,540 --> 00:05:11,920
المعذرة. ماذا يعني قائد ذراع يسرى؟

79
00:05:11,920 --> 00:05:17,520
،خارج هذا الدّيماس، في أقصى الشّمال
توجد أرض يحكمها ملك الشّياطين

80
00:05:17,520 --> 00:05:19,090
!هناك ملك شياطين؟

81
00:05:19,090 --> 00:05:22,920
في الواقع، سيكون من غير الطّبيعيّ في عالم
كهذا ألّا يوجد ملك شياطين

82
00:05:22,920 --> 00:05:26,740
إذا اعتذرنا أنّ ملك الشّياطين
،بحدّ ذاته هو الرّأس

83
00:05:26,740 --> 00:05:31,250
:فالآخرون مُصنّفون بالتّرتيب التّنازليّ
الذّراع اليمنى، الذّراع اليسرى، السّاق اليمنى، والسّاق اليسرى

84
00:05:31,250 --> 00:05:35,900
بصيغة أخرى، قائد الذّراع اليسرى هو
الثّالث في صفوف قوّات ملك الشّياطين

85
00:05:35,900 --> 00:05:37,610
...الثّالث

86
00:05:38,020 --> 00:05:40,890
ما الّذي كان يفعله قائد قوّات ملك الشّياطين
يفعله في مكان كهذا؟

87
00:05:40,890 --> 00:05:43,530
قوّات ملك الشّياطين؟ هذا خطير

88
00:05:43,530 --> 00:05:49,030
إنّهم مُستعدّون لتجاوز مُدُن مُحصّنة وإمبراطوريّات
لغزونا، ما يبدو أمراً غير مُرجَّح

89
00:05:49,030 --> 00:05:50,910
حسناً، ماذا نفعل؟

90
00:05:50,910 --> 00:05:55,320
هاجمَ أعضاء الرّابطة داخل الدّيماس
وتحت أنظارنا جميعاً

91
00:05:55,320 --> 00:05:59,030
!سنضربه بكلّ ما أوتينا من قوّة بالطّبع

92
00:05:59,030 --> 00:06:01,640
ليس من عادتك أن تنفعل هكذا

93
00:06:01,640 --> 00:06:04,380
إنّ السّماح له بالإفلات بعد تلك
المُجازفة سيُضرّ بالعمل

94
00:06:04,380 --> 00:06:06,930
لدينا بعض الصيّادين الماهرين
!الّذين سيُشاركون

95
00:06:07,210 --> 00:06:09,430
ستُوفّر طبقة الأصل بعض الدّعم أيضاً

96
00:06:09,430 --> 00:06:13,060
،بعد ما تكبّده جماعتي من عناء
حان وقت ردّ الاعتبار

97
00:06:13,390 --> 00:06:15,580
سأشارك كذلك

98
00:06:15,580 --> 00:06:17,560
!أنا أيضاً آمل حسم النّتيجة

99
00:06:17,560 --> 00:06:19,320
دعوني أُشارك أيضاً

100
00:06:19,320 --> 00:06:23,950
بعد ما احدث لهيوليمي وشوي، لن أكون
!راضية ما لم أوجّه له لكمة

101
00:06:23,950 --> 00:06:25,370
أليس كذلك يا هاكّون؟

102
00:06:25,370 --> 00:06:26,820
مرحباً بك

103
00:06:27,290 --> 00:06:30,450
هيوليمي، يمكنكِ مُساعدتنا
بالتّخطيط للأمور

104
00:06:30,700 --> 00:06:34,020
على رسلكِ. حاول ذلك الشّخص قتلي

105
00:06:34,020 --> 00:06:36,080
سأكون أوّل من يثأر منه

106
00:06:36,350 --> 00:06:38,830
!هيوليمي! أجل

107
00:06:38,830 --> 00:06:42,080
أرى بوضوح مدى حماسكم

108
00:06:42,080 --> 00:06:45,600
ستضع طبقة بُحيرة التدفُّق النّقيّ
خيرة رجالها للتّعامل مع هذا

109
00:06:45,600 --> 00:06:49,740
!لنتعاون جميعاً لإسقاط حاكم العالم السّفليّ

110
00:06:49,740 --> 00:06:51,130
!أجل

111
00:06:51,600 --> 00:06:55,810
،هنا حيث لا يسعني سوى القول
"ليت لديّ ذِراعان"

112
00:06:57,100 --> 00:07:01,500
لم يمضِ وقت طويل حتّى ظهر
الأبطال من كلّ طبقة

113
00:07:04,430 --> 00:07:07,090
مرحباً يا لاميس وهيوليمي وهاكّون

114
00:07:07,650 --> 00:07:09,460
أنتما في فرقة الهجوم أيضاً؟

115
00:07:09,460 --> 00:07:10,650
!بالتّأكيد

116
00:07:11,440 --> 00:07:13,660
مرحباً يا هاكّون

117
00:07:13,660 --> 00:07:16,830
كنتُ أتساءل إلى أين ذهبت

118
00:07:16,830 --> 00:07:19,860
لنرَ، أظنّني سأشتري الماء المعتاد والحساء

119
00:07:19,860 --> 00:07:22,850
اليوم هو اليوم الّذي يُحالفني
الحظّ بهذه الأرقام

120
00:07:22,850 --> 00:07:26,000
،ماذا؟ أتفهّم وجود حُرّاس البوّابة

121
00:07:26,000 --> 00:07:29,170
لكن لماذا العجوزان اللّذان أراهما في كلّ
صباح موجودان في فرقة الهجوم؟

122
00:07:31,690 --> 00:07:33,800
هاكّون، لاميس

123
00:07:33,800 --> 00:07:35,390
!مُديرة المدرسة

124
00:07:35,870 --> 00:07:39,340
سمعتُ بأنّك كنت رفقة شوي عند
حاجتها لك. شكراً

125
00:07:39,340 --> 00:07:42,440
إنّها تُدير ميتماً في طبقة الأصل

126
00:07:42,440 --> 00:07:45,370
أنا متأكّد بأنّها علّمت شوي
الرّماية بالسِّهام أيضاً

127
00:07:45,730 --> 00:07:48,960
هوكسي، هل ستأتين أيضاً؟

128
00:07:48,960 --> 00:07:50,790
هل أنتِ بخير؟

129
00:07:50,790 --> 00:07:53,740
أجل لكلا السّؤالين، شيميلاي، ويوميتي

130
00:07:54,110 --> 00:07:56,380
!هؤلاء الثّلاثة يعرفون بعضهم الآخر؟

131
00:07:56,380 --> 00:07:58,990
هل هذا يعني أنّ الزّوجين هما
!صيّادان مُذهلان أيضاً؟

132
00:07:59,650 --> 00:08:04,290
في ذلك اليوم، الصيّادون الأبطال أتوا
،مُسرعين إلى هنا من كلّ طبقة

133
00:08:04,290 --> 00:08:07,490
والآن أقمنا حفلة انطلاق قُبيل
استهداف حاكم العالم السّفليّ

134
00:08:07,880 --> 00:08:09,950
!يوجد هنا مُختلف أنواع النّاس

135
00:08:09,950 --> 00:08:14,010
كلّ واحد منهم يمتلك برَكة قويّة

136
00:08:14,260 --> 00:08:17,020
ما مُشكلتكم أيّها العجائز؟

137
00:08:17,020 --> 00:08:20,270
.هذا ليس منزل تمريض
هل أنتم مُستعدّون لهذا؟

138
00:08:20,270 --> 00:08:24,890
ينبغي أن تصون لسانك إذا
كنت تعرف مصلحتك

139
00:08:24,890 --> 00:08:28,560
ماذا تقولين؟ أتحاولين افتعال مُشكلة معي؟

140
00:08:28,560 --> 00:08:29,580
!أتعلمين من نكون؟

141
00:08:30,240 --> 00:08:31,660
مرحباً بك

142
00:08:31,660 --> 00:08:33,540
ما الأمر؟ شِجار؟

143
00:08:33,540 --> 00:08:36,650
لاميس، نكزة واحدة منكِ كافية للقضاء عليه

144
00:08:36,650 --> 00:08:39,740
ماذا؟ هل أنت مع هؤلاء؟

145
00:08:39,740 --> 00:08:41,540
أجل، صحيح

146
00:08:41,540 --> 00:08:45,210
لكن عمليّاً، ما زلتُ أحاول ضمّهم لمجموعتي

147
00:08:45,210 --> 00:08:46,910
القائد كيريويل

148
00:08:47,910 --> 00:08:49,610
!كـ-كيريويل؟

149
00:08:49,610 --> 00:08:53,540
هل تقصدين كيريويل قائد قطيع الوحوش الحمقى؟

150
00:08:53,540 --> 00:08:55,090
وماذا ستفعل إن كنتُ كذلك؟

151
00:08:56,950 --> 00:09:00,560
!لـ-لا شيء سيّدي

152
00:09:02,010 --> 00:09:06,220
أنا كيريويل، قائد قطيع الوحوش الحمقى

153
00:09:06,220 --> 00:09:10,300
شرف لي أن أُساعدكم، لا سيّما أنّ أعضاء
مجموعتي خارج أوقات العمل

154
00:09:10,560 --> 00:09:14,430
من النّادر أن يلقي القائد التّحيّة
!على أحد بهذا الأدب

155
00:09:14,870 --> 00:09:18,370
بالمناسبة، شوي وتوأمتا الشّعر الأحمر
،والأبيض لم يتعافينَ بعد

156
00:09:18,370 --> 00:09:20,190
لذا يبدو أنّهن لن يُشاركنَ في العمليّة

157
00:09:20,190 --> 00:09:22,700
وهذا رغماً عن إرادتهن بالطّبع

158
00:09:23,700 --> 00:09:25,630
!اسمي ميشويل

159
00:09:25,630 --> 00:09:30,080
أنا صغير وعديم الخبرة، لكن أتطلّع
!قدماً لتوجيهاتك وتشجيعك

160
00:09:30,080 --> 00:09:33,370
اسمي هوكسي، من طبقة الأصل

161
00:09:33,370 --> 00:09:35,060
أنا يوميتي

162
00:09:35,060 --> 00:09:38,980
،برَكاتي هي قليل من نور الشّفاء
وقليل من المُبارزة بالسّيف

163
00:09:39,850 --> 00:09:41,750
اسمي شيميلاي

164
00:09:41,750 --> 00:09:44,720
أعرف السّحر وأمتلك برَكات عديدة

165
00:09:44,720 --> 00:09:46,850
من جديد، اسمي كاريوس

166
00:09:46,850 --> 00:09:48,230
أنا غورث

167
00:09:48,510 --> 00:09:52,640
أنا هيوليمي، مُهندسة أدوات سحريّة
وصديقة طفولة لاميس

168
00:09:52,640 --> 00:09:54,200
اسمي لاميس

169
00:09:54,200 --> 00:09:56,640
وهذا شريكي هاكّون

170
00:09:56,640 --> 00:09:58,230
مرحباً بك

171
00:09:59,490 --> 00:10:02,740
طليعة، حرس خلفيّ، وفريق علاجيّ

172
00:10:02,740 --> 00:10:05,070
هذا فريق مُتّزن نسبيّاً

173
00:10:05,070 --> 00:10:08,120
رغم أنّ قوّة أعضائنا الأكبر سنّاً
لم تتوضّح بعد

174
00:10:08,120 --> 00:10:12,370
أنا متأكّد بأنّ القائد كيريويل
سوف يتّخذ قرارات حكيمة

175
00:10:12,370 --> 00:10:15,250
سنبدأ بالبحث عنه غداً

176
00:10:15,250 --> 00:10:18,000
!لننتقم من ذلك الأحمق

177
00:10:18,000 --> 00:10:20,030
!أجل

178
00:10:23,450 --> 00:10:26,160
هاكّون

179
00:10:28,790 --> 00:10:31,390
،في اليوم التّالي، انفصلنا إلى عدّة فِرق

180
00:10:31,390 --> 00:10:34,520
وتوجّه كلّ شخص نحو وجهة البحث

181
00:10:34,520 --> 00:10:37,910
أنا آسف لإرهاقكم بهذه المهمّة الخطيرة

182
00:10:37,910 --> 00:10:43,480
لا تتغيّر أبداً. لا تزال رسميّاً جدّاً
بعد كلّ هذا الوقت

183
00:10:43,480 --> 00:10:48,060
هذا صحيح. جميعنا زملاء، لذا
لا داعي للاعتذار

184
00:10:49,410 --> 00:10:51,880
هذا مشهد يُعيدنا للذّكريات

185
00:10:52,800 --> 00:10:56,240
يا جماعة، هناك وحوش تتربّص في ذلك المكان

186
00:10:56,720 --> 00:10:59,920
لِمَ لا أتعامل معهم أنا ويوميتي وهوكسي؟

187
00:10:59,920 --> 00:11:04,050
جهد جماعيّ آخر مع زملائي السّينباي؟
يبدو هذا مُشوّقاً

188
00:11:04,050 --> 00:11:06,310
أيّتها النُّور، غلّفي رؤوس سِهامي

189
00:11:09,800 --> 00:11:11,930
ثلاثة في آن واحد

190
00:11:11,930 --> 00:11:13,290
عمل مُتقَن

191
00:11:13,290 --> 00:11:16,190
إنّها تُقاتل بتطرُّف كعادتها

192
00:11:16,190 --> 00:11:18,190
حقّاً؟

193
00:11:18,500 --> 00:11:22,920
يبدو أنّهم بعيدون جدّاً. لم يلحظنا الوحوش بعد

194
00:11:23,340 --> 00:11:25,020
!إذاً سأدعوهم بنفسي

195
00:11:40,210 --> 00:11:43,950
أداء ممتاز أنتم الثّلاثة. يبدو
أنّ مهاراتكم لم تنحسر

196
00:11:43,950 --> 00:11:46,980
لا، لم نعُد بأحسن حالاتنا بعد الآن

197
00:11:46,980 --> 00:11:50,320
من الأفضل أن أُصقِل سحري

198
00:11:50,320 --> 00:11:52,860
ضرباتي بالسّيف لم تعُد حادّة كما كانت

199
00:11:53,680 --> 00:11:56,180
ليتنا لم نكبر فحسب

200
00:11:56,180 --> 00:11:59,430
لا أستحقّ أن أفتخر بهذا أمام شوي

201
00:11:59,430 --> 00:12:01,100
من الأفضل إعادة النّظر في الأمر

202
00:12:01,100 --> 00:12:02,680
!كم هذا مُبهر

203
00:12:02,680 --> 00:12:04,990
هاكّون، حريّ بنا أن نُضاعف
جهودنا كي نُجاريهم

204
00:12:05,190 --> 00:12:06,610
مرحباً بك

205
00:12:11,000 --> 00:12:13,620
مذاق لذيذ

206
00:12:13,620 --> 00:12:15,970
أنا واثقة بأنّ شوي ستغار

207
00:12:15,970 --> 00:12:19,490
أرغب في تجربة كلّ أطعمته في هذه الحملة

208
00:12:19,490 --> 00:12:24,160
مُجرّد القدرة على أكل كلّ وجبة من طعام
!هاكّون كافية لتحفيزي

209
00:12:24,160 --> 00:12:26,330
أجل، معك حقّ

210
00:12:34,710 --> 00:12:38,030
لاميس، خفّضي مركز جاذبيّتكِ

211
00:12:38,280 --> 00:12:42,280
هذا سيُسهّل الأمور ويُحسّن قوّتك ودقّتك

212
00:12:42,280 --> 00:12:43,590
مركز جاذبيّتي؟

213
00:12:44,030 --> 00:12:45,420
حسناً

214
00:12:49,940 --> 00:12:51,550
!كان ذلك شعوراً رائعاً

215
00:12:51,550 --> 00:12:53,320
وبدا رائعاً

216
00:12:53,320 --> 00:12:57,360
ينبغي لكِ أن تعتادي على الشّعور
بالقتال في ظلّ غياب هاكّون

217
00:12:58,220 --> 00:12:59,140
!حسناً

218
00:13:00,600 --> 00:13:04,180
برَكة القوّة تمنح لاميس قوّة
أكبر ممّا تستطيع التحمُّل

219
00:13:04,180 --> 00:13:06,410
يتطلّب التحكُّم بنفسها جهداً

220
00:13:06,790 --> 00:13:10,180
في العادة أُساندها أنا، ممّا
يُوفّر الإعاقة المُناسبة

221
00:13:10,180 --> 00:13:13,220
إذا استطاعت استخراج قوّتها بشكل
...جيّد بما يكفي من دوني

222
00:13:17,160 --> 00:13:18,850
!يمكنكِ فعلها يا لاميس

223
00:13:28,020 --> 00:13:30,630
هاكّون. هل لي ببعض الوقت؟

224
00:13:30,630 --> 00:13:32,070
مرحباً بك

225
00:13:32,500 --> 00:13:34,450
ثمّة شيء لا يبدو منطقيّاً بالنّسبة لي

226
00:13:34,860 --> 00:13:39,160
يبدو وكأنّ حاكم العالم السّفليّ
سمح للاميس بالإفلات عمداً

227
00:13:39,160 --> 00:13:40,380
...هيوليمي

228
00:13:41,130 --> 00:13:46,180
فلو قُضي علينا حينها، لما
استطعنا العودة والإبلاغ

229
00:13:46,180 --> 00:13:49,840
ما كانت هذه الفرقة الهجوميّة
لتتأسّس من البداية أصلاً

230
00:13:50,070 --> 00:13:54,270
بصيغة أُخرى، ماذا لو كان هدفه
هو استخدام نفسه كطعم

231
00:13:54,270 --> 00:13:56,710
لجمع الصيّادين الأبطال هنا في هذه الطّبقة؟

232
00:13:57,950 --> 00:14:01,600
إذا كان كلامكِ صحيحاً، فهذا
يعني أنّنا وقعنا في الفخّ

233
00:14:03,730 --> 00:14:05,150
ها أنا ذي

234
00:14:05,610 --> 00:14:08,240
لكن لا أعلم ماذا سيحدث عقب ذلك

235
00:14:08,240 --> 00:14:10,250
،قد يحدث أسوأ سيناريو ممكن

236
00:14:10,250 --> 00:14:13,710
لكن لن أشوّش الجميع بإخبارهم بتخميني

237
00:14:13,710 --> 00:14:15,630
أنت الوحيد الّذي أستطيع إخباره يا هاكّون

238
00:14:16,030 --> 00:14:17,500
مرحباً بك

239
00:14:18,180 --> 00:14:20,620
شكراً، لا أمانع إذا كنتُ كذلك

240
00:14:22,120 --> 00:14:25,730
لِمَ لا نحتسي شاياً دافئاً بالحليب ونسترخي

241
00:14:28,160 --> 00:14:31,140
يبدو تدفُّق قوّة السّحر غريباً

242
00:14:31,140 --> 00:14:34,110
إنّه يزداد بشكل غير ثابت

243
00:14:34,110 --> 00:14:36,510
قد تكون هذه مُشكلة

244
00:14:37,080 --> 00:14:39,350
كان العجوز على حقّ

245
00:14:39,350 --> 00:14:44,370
بعد فترة قصيرة، علمنا بأنّ فريقَ صيّادين
آخر عثر عى حاكم العالم السّفليّ

246
00:15:14,550 --> 00:15:17,050
جيّد، التففنا من خلفه

247
00:15:17,050 --> 00:15:20,080
هوكسي وشيميلاي ستُوفّران التّغطية
النّاريّة من هنا

248
00:15:20,080 --> 00:15:21,310
عُلِم

249
00:15:21,310 --> 00:15:23,930
كاريوس وغروث، ستكونان حارسين

250
00:15:23,930 --> 00:15:24,730
!حاضر

251
00:15:23,930 --> 00:15:25,290
بأمرك

252
00:15:25,560 --> 00:15:29,430
.لاميس، لدينا الكثير من الأبطال
لا داعي لتفجير كلّ طاقتكِ

253
00:15:29,430 --> 00:15:31,060
!أجل، سأبذل جهدي

254
00:15:31,060 --> 00:15:32,770
نعتمد عليك أيضاً يا هاكّون

255
00:15:32,770 --> 00:15:34,320
مرحباً بك

256
00:15:34,320 --> 00:15:36,280
الآخرون سيُهاجمون جميعهم

257
00:15:36,280 --> 00:15:40,290
،هدفنا هو قتل حاكم العالم السّفليّ
لكن لا تُقدِموا على أيّ تصرُّف طائش

258
00:15:40,290 --> 00:15:42,580
إذا كسبنا الوقت، ستصل التّعزيزات

259
00:15:42,580 --> 00:15:43,250
!حاضر

260
00:15:42,580 --> 00:15:43,250
أجل

261
00:15:42,580 --> 00:15:43,830
!أنا جاهز

262
00:15:43,830 --> 00:15:46,680
!لنُرِه ما يمكننا فعله

263
00:16:08,430 --> 00:16:10,790
!تغيير الشّكل

264
00:16:11,440 --> 00:16:13,690
!غسّالة الطّاقة

265
00:16:13,690 --> 00:16:17,960
وبقدرة التحكُّم الذّهنيّ عن بُعد، البرَكة
،الجديدة الّتي كسبتُها في المعركة السّابقة

266
00:16:17,960 --> 00:16:22,450
كنتُ أتدرّب في كلّ ليلة لأعزّز قوّتي
!الجسديّة وبراعتي

267
00:16:22,450 --> 00:16:24,840
!والآن يمكنني حتّى فعل شيء كهذا

268
00:16:25,290 --> 00:16:28,210
لم أعُد آلة بيع بعد الآن

269
00:16:28,210 --> 00:16:29,670
لكن ما الجديد غير ذلك؟

270
00:16:30,210 --> 00:16:32,040
!مُذهل يا هاكّون

271
00:16:32,040 --> 00:16:33,590
!ربحت

272
00:16:50,510 --> 00:16:54,150
يبدو أنّنا لن نُحقّق أي نتيجة
ما لم نهزم حاكم العالم السّفليّ

273
00:16:54,150 --> 00:16:58,270
أجل، يبدو أنّه يستخدم تعويذة ما

274
00:17:02,290 --> 00:17:04,790
!ابتعدوا من هناك جميعاً

275
00:17:04,790 --> 00:17:08,030
يستجمع حاكم العالم السّفليّ مقداراً
!هائلاً من قوّة السّحر

276
00:17:08,030 --> 00:17:11,290
!إنّها غالباً تعويذة انفجار عظيم

277
00:17:11,590 --> 00:17:12,210
!لنتفرّق

278
00:17:12,210 --> 00:17:13,040
!حسناً

279
00:17:13,040 --> 00:17:14,930
...لكن، الصّيّادين الآخرين

280
00:17:15,130 --> 00:17:16,460
!دعي الأمر لي

281
00:17:17,920 --> 00:17:19,900
!أقترح أن تسدّوا آذانكم

282
00:17:20,430 --> 00:17:22,790
!لكن ليس لديّ يداً

283
00:17:22,790 --> 00:17:25,320
...أو أُذناً أو طبلة أذن

284
00:17:25,320 --> 00:17:28,600
!تعويذة رئيسيّة قادمة! تراجعوا

285
00:17:29,550 --> 00:17:31,800
لِمَ القيام بذلك؟

286
00:17:31,800 --> 00:17:33,820
لكن هل كان ذلك في الوقت؟

287
00:17:38,570 --> 00:17:40,150
!نشر الحاجز

288
00:17:58,670 --> 00:18:00,690
حسناً، حسناً. لا وفيّات إطلاقاً

289
00:18:00,690 --> 00:18:03,830
لا يمكن العبث مع صيّادي النّخبة

290
00:18:03,830 --> 00:18:08,620
هلكَ كافّة الوحوش، لكن ماذا يعني؟
يمكنني دوماً صنع المزيد

291
00:18:10,120 --> 00:18:12,990
مُحال أن نفوز إذا استمرّ الأمر هكذا

292
00:18:12,990 --> 00:18:16,040
الشّخص الّذي يملك فُرصة
...لقلب موازين المعركة

293
00:18:16,610 --> 00:18:17,730
هو أنا

294
00:18:18,810 --> 00:18:23,470
برَكة فتاة القوّة، بأداتها السّحريّة

295
00:18:23,470 --> 00:18:26,490
سأكون خصمك، إذا استطعتِ الوصول إليّ

296
00:18:26,490 --> 00:18:28,630
حسناً، إمّا الآن أو أبداً

297
00:18:30,650 --> 00:18:34,130
أنا الحقيقيّ فوق ساحة المعركة
بارتفاع شاهق الآن

298
00:18:34,130 --> 00:18:38,730
قذفَتْني لاميس للأعلى إلى هنا
أثناء فوضى تعويذة الانفجار تلك

299
00:18:38,730 --> 00:18:42,970
ما يوجد على ظهرها هو أداة سحريّة
صنعَتْها هيوليمي، البيت الّذي يأويني

300
00:18:43,300 --> 00:18:46,750
أنا الحقيقيّ تحوّلتُ وتحكّمتُ بالبوالين
باستخدام التحكُّم النّفسيّ عن بُعد

301
00:18:46,750 --> 00:18:49,020
وأصبحتُ فوق رأس حاكم
!العالم السّفليّ مُباشرة

302
00:18:49,020 --> 00:18:49,860
!ها أنا ذا

303
00:18:49,860 --> 00:18:52,580
!تغيير الشّكل

304
00:18:55,270 --> 00:18:58,960
،آلة البيع الأكبر في اليابان
!والموضوعة في ميناء صيد سمك ما

305
00:18:58,960 --> 00:19:02,510
تحدّثوا عنها في التّلفزيون وطولها
!يزيد عن 18 متراً

306
00:19:02,510 --> 00:19:05,650
!ها هي ذي، آلة بيع الثّلج

307
00:19:05,650 --> 00:19:07,800
واصلوا وكافحوا أيّها الصّيّادون

308
00:19:07,800 --> 00:19:10,630
—سأرى إن كنتُم تستطيعون الوصول

309
00:19:11,750 --> 00:19:13,760
ما-ما هذا؟

310
00:19:13,760 --> 00:19:15,620
!آلة بيع

311
00:19:25,150 --> 00:19:27,770
كنتُ جاهزاً تحسُّباً لعدم قدرتي
!على سحقك مباشرة

312
00:19:36,450 --> 00:19:38,350
،قبل أن أتبنّى هذا الجسد الضّخم

313
00:19:38,350 --> 00:19:42,150
!رجعتُ إلى آلة البيع المعتادة وحضّرتُ هذا

314
00:19:42,480 --> 00:19:44,120
،بفضل تعزيز قوّتي الجسديّة

315
00:19:44,120 --> 00:19:47,370
!صدمتي الكهربائيّة القصوى غير عاديّة الآن

316
00:19:47,370 --> 00:19:48,480
!خذ هذه

317
00:20:07,320 --> 00:20:08,560
!هاكّون

318
00:20:08,790 --> 00:20:10,320
!هل أنت بخير؟

319
00:20:10,320 --> 00:20:11,240
!هل تأذّيت؟

320
00:20:11,240 --> 00:20:12,910
!لا أضرار في أيّ مكان؟

321
00:20:11,950 --> 00:20:14,440
...أنا بخير يا لاميس. كما ترين

322
00:20:15,310 --> 00:20:17,990
خطر، خطر، خطر

323
00:20:20,060 --> 00:20:22,060
!ما زال حيّاً

324
00:20:24,580 --> 00:20:27,070
هذه العصا ثمينة

325
00:20:27,070 --> 00:20:28,830
سوف أسترجعها

326
00:20:28,830 --> 00:20:36,480
لكن رغم ذلك، تمكّنتم من هزيمة ما تحوّلتْ
إليه ذراعي اليسرى فحسب

327
00:20:36,480 --> 00:20:38,460
هذا جدير بالإطراء

328
00:20:38,460 --> 00:20:40,840
!ذراعه اليسرى؟ هذا غير مُمكن

329
00:20:41,110 --> 00:20:46,970
هزمتُم فرعاً منّي، لكن مع ذلك
حقّقتُ هدفي الأصليّ

330
00:20:46,970 --> 00:20:48,840
هدف أصليّ؟

331
00:20:50,180 --> 00:20:54,110
كان جمع كافّة الصّيادين الماهرين هنا

332
00:20:54,340 --> 00:20:56,730
!كان حدس هيوليمي مُصيباً

333
00:20:56,730 --> 00:21:01,480
،إذا مات صيّادون أو وحوش داخل هذا الدّيماس

334
00:21:01,480 --> 00:21:06,740
فإنّ الدّيماس بحدّ ذاته يستجمع القوّة
المُكافئة لقوّة الموتى

335
00:21:06,740 --> 00:21:11,260
إذا استخدمتُها، يمكنني صنع
المزيد من الوحوش الجديدة

336
00:21:11,260 --> 00:21:14,250
هكذا هي آليّة عمل هذا الدّيماس

337
00:21:14,470 --> 00:21:18,220
أعمل بنظام النّقاط. هل هذا شبيه بذلك؟

338
00:21:18,790 --> 00:21:23,110
لهذا خطر على ذهني قتل كلّ شيء
،في هذا الدّيماس

339
00:21:23,110 --> 00:21:27,000
وصنع قطيع جديد من الوحوش

340
00:21:27,000 --> 00:21:32,010
حسناً إذاً، لعلّ بعضكم عَلِمَ سلفاً ما أقوم به؟

341
00:21:33,020 --> 00:21:37,000
...يا للهول! إذا تجمّعَ كافّة الأبطال هنا

342
00:21:37,680 --> 00:21:40,370
فإنّ دفاع الطّبقة الأُخرى ضعيف جدّاً

343
00:21:40,370 --> 00:21:42,030
...إذا تعرّضوا لهجوم الآن

344
00:21:42,030 --> 00:21:43,400
!هذه كارثة

345
00:21:43,590 --> 00:21:47,600
والآن، ألا تعتقدون بأنّه يجدر
بكم العودة بسرعة؟

346
00:21:47,600 --> 00:21:50,280
يمكنكم الانتقال إلى كلّ طبقة

347
00:21:50,280 --> 00:21:54,220
لكن سأحرص على ألّا تستطيعون
الخروج من الدّيماس

348
00:21:54,220 --> 00:21:56,830
حان وقت بدء الجولة الثّانية

349
00:21:56,830 --> 00:22:02,600
كافحوا بجدّ وسخّروا قوّتكم العظيمة
لأجل هذا الدّيماس

350
00:23:35,050 --> 00:23:37,070
!قد تربح أداة إضافيّة

351
00:23:35,060 --> 00:23:40,050
الحلقة القادمة

352
00:23:35,060 --> 00:23:40,050
الحلقة 2: فهم مُتبادَل

353
00:23:37,970 --> 00:23:40,110
أتطلّع قُدماً لاستخدامك لي ثانية