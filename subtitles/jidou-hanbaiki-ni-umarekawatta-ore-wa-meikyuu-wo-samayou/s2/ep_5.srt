1
00:00:01,340 --> 00:00:02,820
مرحباً بك

2
00:00:04,320 --> 00:00:08,060
،لا بدّ أنّنا في وقت متأخّر من اللّيل
لأنّ الأمور قد هدأت أخيراً

3
00:00:08,060 --> 00:00:10,660
لكن لا أملك الكثير لأفعله، نظراً
إلى أنّه لا يوجد أحد لأتكلّم معه

4
00:00:10,990 --> 00:00:14,260
سأتفقّد قدراتي. لم أفعل ذلك منذ مدّة

5
00:00:14,260 --> 00:00:17,660
أوّلاً، سأراجع الأنواع المختلفة
من آلات البيع

6
00:00:18,000 --> 00:00:21,230
تُقسَّم آلات البيع عموماً إلى تصنيفين

7
00:00:21,230 --> 00:00:24,350
تلك الّتي تبيع سلعاً، وتلك ذات
الخدمات الآليّة

8
00:00:24,350 --> 00:00:28,500
التّصنيف الأوّل بالضّبط ما يوحي به
مظهره: بيع المُنتجات

9
00:00:28,920 --> 00:00:31,480
حتّى آلات الطّعام والشّراب وحدها
تندرج تحت التّصنيفات الثّانويّة

10
00:00:31,480 --> 00:00:36,130
،مشروبات غازيّة، قهوة، كحول، شراب بالحليب
سكاكر، مُنتجات طبخ، وتحليات جامدة

11
00:00:36,130 --> 00:00:38,510
تبقى السّجائر والتّذاكر والطّوابع البريديّة
والأختام والبطاقات البريديّة والدّمغات الماليّة

12
00:00:38,510 --> 00:00:40,920
...وكذلك أختام المُعاينة والجرائد والمجلّات

13
00:00:42,940 --> 00:00:44,690
الحرّ شديد اليوم من جديد

14
00:00:43,590 --> 00:00:44,690
مرحباً بك

15
00:00:46,180 --> 00:00:47,940
شكراً جزيلاً لك

16
00:00:46,380 --> 00:00:47,940
لطيف وبارد

17
00:00:48,770 --> 00:00:52,440
والآن، عندما يتعلّق الأمر بكيفيّة تصنيف
،آلات البيع ذات الخدمات الآليّة

18
00:00:52,440 --> 00:00:55,380
فإنّنا نتطرّق إلى آلات صرافة العملات
وآلات توزيع كُرة الباتشينكو

19
00:00:55,380 --> 00:00:59,440
هناك خلاف على تعريف هذه الوحدات ذات
،الخدمات الآليّة كآلات بيع

20
00:00:59,440 --> 00:01:02,680
لكنّها مُدرَجة ضمن هذا التّصنيف برأيي

21
00:01:02,680 --> 00:01:06,100
لا بُدّ أنّ لهذا السّبب "مغسلة الضّغط" موجودة
ضمن قائمة وظائفي

22
00:01:06,100 --> 00:01:07,880
،ولم ألحظ هذا إلّا مؤخّراً

23
00:01:07,880 --> 00:01:10,110
لكن "التّصنيف 3" قد أُضيف إلى القائمة

24
00:01:10,110 --> 00:01:13,920
يبدو أنّه ما زالت أمامي مساحة للتحسُّن كآلة بيع

25
00:01:14,310 --> 00:01:18,080
!للترقّي للتّصنيف 3، أحتاج... 3 مليون نقطة

26
00:01:18,080 --> 00:01:20,490
،لا أعرف ما الّذي ستدعني أفعله

27
00:01:20,490 --> 00:01:24,220
لكن القدرة على الحلم بالتطوُّر
...رغم كوني آلة بيع

28
00:01:25,220 --> 00:01:27,290
...يُسعدني للغاية

29
00:01:27,720 --> 00:01:30,770
!إنّه هاكّون! وجدتُه

30
00:01:29,790 --> 00:01:32,020
!معك حقّ! إنّه هناك

31
00:01:32,020 --> 00:01:32,990
!حسناً، هيّا بنا

32
00:01:32,990 --> 00:01:36,000
!دياج مغليّ! دياج مغليّ! دياج مغليّ

33
00:01:36,220 --> 00:01:39,670
أجل، إنّه "دجاج مقليّ"، لكن لا أستطيع
،لفظه بشكل جيّد

34
00:01:39,670 --> 00:01:42,000
لذا "دياج مغليّ" هو ما حفظوه

35
00:01:42,000 --> 00:01:43,000
آسف

36
00:01:43,000 --> 00:01:45,410
!دياج مغليّ

37
00:01:45,410 --> 00:01:46,510
!أعطنا المزيد

38
00:01:45,990 --> 00:01:48,990
!اهدؤوا، هناك ما يكفي من كمّية للجميع

39
00:01:56,460 --> 00:01:58,310
من الخارج، صندوق فولاذيّ مُستطيل

40
00:01:58,310 --> 00:02:00,300
!ويوجد بداخله روح بشريّ

41
00:02:00,300 --> 00:02:05,710
في عالم من الأعاجيب، أركب
على ظهر شريكتي لاميس

42
00:02:05,710 --> 00:02:08,150
!أنا هاكّون! مرحباً بك

43
00:02:08,150 --> 00:02:09,900
!"هذا يعني "أجل

44
00:03:24,610 --> 00:03:27,710
سهرت هيوليمي اللّيل كلّه وهي
،تصلح دائرة الانتقال

45
00:03:27,710 --> 00:03:31,080
لذا بدأنا بإخلاء سكّان طبقة الأصل

46
00:03:34,820 --> 00:03:39,570
في الواقع، ما زلتُ لا أعرف عدد
الطّبقات في هذا الدّيماس

47
00:03:39,570 --> 00:03:42,870
كـ-م ع-د-د ا-لط-بق-ات؟

48
00:03:42,870 --> 00:03:45,570
كم عدد؟ كم عدد الطّبقات؟

49
00:03:45,990 --> 00:03:49,080
،من الأعلى وبالتّرتيب، هناك طبقة الأصل

50
00:03:49,380 --> 00:03:52,570
وطبقة رثاء الميّت، وطبقة بُحيرة
،التّدفُّق النّقيّ

51
00:03:53,020 --> 00:03:56,080
،وطبقة المتاهة، وطبقة الرّمل الحارق

52
00:03:56,080 --> 00:03:59,800
وطبقة غابة الظّلام، وطبقة جبل الكلب

53
00:04:00,090 --> 00:04:03,350
بالإضافة إلى أنّ تحتها الطّبقة الأبديّة

54
00:04:03,350 --> 00:04:04,840
والّتي لم تُغزَ بعد

55
00:04:05,190 --> 00:04:08,620
لذا في هذه المرحلة، نعلم بأنّ هناك
ثمان طبقات على الأقلّ

56
00:04:09,040 --> 00:04:11,050
هيّا، لنبدأ بالإخلاء

57
00:04:19,390 --> 00:04:22,490
!حضرة المُدير

58
00:04:21,910 --> 00:04:22,710
!هذا ظريف

59
00:04:22,710 --> 00:04:24,190
!شكراً

60
00:04:24,190 --> 00:04:25,370
!حضرة المُدير

61
00:04:25,710 --> 00:04:27,360
!وداعاً

62
00:04:27,360 --> 00:04:30,100
تعمل دائرة الانتقال بشكل سليم

63
00:04:30,100 --> 00:04:33,100
ماذا سنفعل بخصوصها بعد ذلك؟

64
00:04:33,100 --> 00:04:37,880
،إذا تركناها وأساء الوحوش استعمالها
فسيُسبّب ذلك مُشكلة للطّبقات الأُخرى

65
00:04:37,880 --> 00:04:40,250
بوسعنا مُعالجة ذلك بإيجاد أتباع
حاكم العالم السّفليّ

66
00:04:40,250 --> 00:04:43,500
وكسر سيطرتهم على الوحوش

67
00:04:43,500 --> 00:04:48,030
لكن لا نملك ما يكفي من قوّة عاملة
للذّهاب واصطيادهم

68
00:04:48,030 --> 00:04:50,910
في هذه الحالة، ما رأيكِ بترك
البحث بشكل حصريّ

69
00:04:50,910 --> 00:04:54,010
على عاتق قطيع الوحوش الحمقى
وفرقة الشّرهين؟

70
00:04:54,230 --> 00:04:56,400
لا جدوى من الاندفاعيّة

71
00:04:56,400 --> 00:04:57,770
هل أنت مستعدّ لفعل ذلك؟

72
00:04:57,770 --> 00:04:58,960
لا أُمانع

73
00:04:58,960 --> 00:05:02,010
فأنا أريد مزيداً من المعلومات
حول حاكم العالم السّفليّ بأيّ حال

74
00:05:02,010 --> 00:05:04,780
وسوف يُكلّفك ذلك

75
00:05:05,030 --> 00:05:08,540
،حسناً. كلّما كانت النّتائج أفضل
كانت الجائزة أعلى

76
00:05:09,860 --> 00:05:12,770
كان سيفعلها حتّى لو رفضتْ هي

77
00:05:20,500 --> 00:05:23,140
ميشويل ماهر حقّاً يا آكا

78
00:05:23,140 --> 00:05:25,680
ليت لدينا هجمة مُبهرجة أيضاً

79
00:05:31,540 --> 00:05:34,140
!أيّتها الماء، شكّلي دوّامات واخترقي

80
00:05:38,070 --> 00:05:40,910
أحسنتم صنعاً جميعاً

81
00:05:40,910 --> 00:05:44,250
هاكّون، هل لي بشيء أشربه؟

82
00:05:46,990 --> 00:05:49,980
أ-نت ل-ن ت-ق-ا-تل؟

83
00:05:49,980 --> 00:05:52,770
عملي الرّئيسيّ هو الشّفاء

84
00:05:52,770 --> 00:05:58,420
لا أمتلك سحراً هجوميّاً، لذا أنا جوهريّاً
مُجرّد عابر أثناء القتال

85
00:05:58,420 --> 00:06:00,370
الشّخص المناسب في المكان المناسب

86
00:06:00,370 --> 00:06:02,650
لا أعلم ما إن كان جادّاً أم لا

87
00:06:02,650 --> 00:06:05,130
من الصّعب قراءة تعابير وجه هيفي

88
00:06:06,490 --> 00:06:09,040
والآن، أيّ اتِّجاه نسلك؟

89
00:06:09,040 --> 00:06:13,660
ورد في الخريطة بأنّ هناك بُحيرة صغيرة
ليست ببعيدة، على اليمين

90
00:06:13,660 --> 00:06:18,760
على اليسار، إنّها مسافة بعيدة، لكن هناك
تقاطُع ثُلاثيّ في الطّريق

91
00:06:18,760 --> 00:06:21,880
...أرغب في تفقُّد البُحيرة أوّلاً، لكن

92
00:06:22,270 --> 00:06:23,420
ما هذا؟

93
00:06:24,300 --> 00:06:26,910
ممتاز، لا يمكننا حتّى التوقُّف للكلام

94
00:06:29,300 --> 00:06:32,180
!هيفي؟ من الخطير الاقتراب إلى هذا الحدّ

95
00:06:32,180 --> 00:06:33,410
لا عليكِ

96
00:06:33,410 --> 00:06:34,850
!مـ-مهلاً، هيفي؟

97
00:06:34,850 --> 00:06:36,750
يا قائد، سأتعامل مع هذا

98
00:06:36,750 --> 00:06:38,660
حقّاً؟ أعتمد عليك

99
00:06:43,410 --> 00:06:46,670
ماذا؟ يظلّ العدوّ ينظر حوله

100
00:06:46,670 --> 00:06:49,170
لماذا لا يشنّ الوحوش هجوماً؟

101
00:06:50,130 --> 00:06:53,690
هذا مُجرّد تخمين، لكن غالباً يرون جدراناً خفيّة

102
00:06:53,930 --> 00:06:57,580
يبرع هيفي في التحكُّم بالضّوء
،لإظهار أوهام

103
00:06:57,580 --> 00:07:02,690
مع القدرات الّتي تدعه يؤثّر
على العقل بشكل مُباشر

104
00:07:02,980 --> 00:07:06,150
مثلما أخفى أولئك الأشخاص في السّجن

105
00:07:09,830 --> 00:07:15,070
لستُ مهتمّاً بحفاة الأقدام، لذا
لا حاجة لادّخار هذه الأشياء

106
00:07:16,270 --> 00:07:20,820
يتمتّع ببركة القوّة، لكن ليس
بقوّة بركة لاميس

107
00:07:24,890 --> 00:07:26,580
!لا توجد رحمة

108
00:07:26,580 --> 00:07:29,840
نستطيع أن ندعه الأمر له ببساطة

109
00:07:36,900 --> 00:07:39,280
حسناً، لننفصل إلى مجموعتين

110
00:07:39,280 --> 00:07:42,140
لن يكون من المُمتع إذا بحثنا جميعاً
،في اتّجاه واحد

111
00:07:42,140 --> 00:07:44,850
وقد تجاوزونا بالمجيء من الاتِّجاه الآخر

112
00:07:44,850 --> 00:07:48,630
سأذهب رفقة مجموعة البُحيرة

113
00:07:48,630 --> 00:07:50,860
ماذا يجدر بنا أن نفعل يا هاكّون؟

114
00:07:50,860 --> 00:07:54,230
أنا قلق بشأن المجموعة الّتي تشمل هيفي

115
00:07:54,230 --> 00:07:55,870
...إذا كان عليّ الاختيار

116
00:07:56,880 --> 00:07:58,120
هـ-ذا ا-لط-ريق

117
00:07:58,120 --> 00:08:01,040
!تريد الذّهاب إلى البُحيرة. حسناً، بالتّأكيد

118
00:08:01,040 --> 00:08:03,640
حضرة القائد، سوف نذهب إلى البُحيرة

119
00:08:10,260 --> 00:08:12,830
،فريق البحث هذا يُمثّل نصف أعضائنا فقط

120
00:08:12,830 --> 00:08:15,370
لكن تمكنّا من إبادة هؤلاء خلال فترة قصيرة

121
00:08:15,370 --> 00:08:17,740
!تلك هي البُحيرة! إنّها جميلة جدّاً

122
00:08:18,070 --> 00:08:21,050
،تولّينا زمام الأمور أبكر ممّا هو مُتوقَّع

123
00:08:21,050 --> 00:08:23,770
لذا لِمَ لا نستمتع قليلاً في الماء؟

124
00:08:24,330 --> 00:08:25,520
هذا مُريب

125
00:08:25,520 --> 00:08:28,410
الآخرون ينتظرون، لذا علينا العودة بسرعة

126
00:08:28,640 --> 00:08:32,660
حسناً، قال القائد بأنّنا يجب أن نعود
في غضون ثلاث ساعات

127
00:08:32,660 --> 00:08:34,610
أجل، هذا صحيح

128
00:08:34,610 --> 00:08:35,540
...لكن

129
00:08:35,540 --> 00:08:38,530
!حسناً، سأذهب وألعب في الماء

130
00:08:38,980 --> 00:08:40,280
!أجل، سأفعل أيضاً

131
00:08:45,290 --> 00:08:49,540
أشعر وكأنّهم قريبون من الانضمام

132
00:08:49,540 --> 00:08:53,700
سيّداتي، سأقف هنا للحراسة

133
00:08:53,700 --> 00:08:56,410
أعتقد حتّى غمر أقدامكن في الماء
وغسل شعركن

134
00:08:56,410 --> 00:08:58,050
سيُشعركن براحة

135
00:08:58,050 --> 00:09:00,710
مـ-معك حقّ. أتريدين الذّهاب يا لاميس؟

136
00:09:00,710 --> 00:09:03,060
حـ-حسناً، ربّما قليلاً فقط

137
00:09:03,060 --> 00:09:05,230
!انتظر هنا قليلاً يا هاكّون

138
00:09:05,230 --> 00:09:06,930
ا-ست-مت-عي

139
00:09:06,930 --> 00:09:09,540
!وتغيير الشّكل

140
00:09:10,920 --> 00:09:14,200
يا إلهي، هذا ليس مكاناً لترك هذه

141
00:09:14,200 --> 00:09:16,560
قد يسرقها أحدٌ ما

142
00:09:16,930 --> 00:09:19,680
من الأفضل أن أعتني بهم جيّداً

143
00:09:20,340 --> 00:09:24,110
أتساءل ما رائحة حذاء لاميس وشوي

144
00:09:24,110 --> 00:09:25,070
!توقّعت

145
00:09:25,070 --> 00:09:26,460
لسوء الحظّ

146
00:09:29,230 --> 00:09:31,630
لم يكن من الصّعب توقُّع ذلك إطلاقاً

147
00:09:31,630 --> 00:09:34,720
،أنعش عقلك وجسدك هناك

148
00:09:34,720 --> 00:09:37,360
واغسل رغباتك الدّنيويّة في طريقك

149
00:09:38,670 --> 00:09:39,930
!عدنا

150
00:09:39,930 --> 00:09:41,180
!مرحباً

151
00:09:41,420 --> 00:09:43,040
عدتُم

152
00:09:43,040 --> 00:09:45,180
لماذا هيفي هو الشّخص الوحيد المُبتلّ؟

153
00:09:45,390 --> 00:09:48,690
وقعتُ في البُحيرة لأسباب شخصيّة

154
00:09:49,290 --> 00:09:50,680
ماذا تقول؟

155
00:09:52,610 --> 00:09:54,950
ما رأيك بتناول الغداء؟

156
00:09:54,950 --> 00:09:56,660
هاكّون، لو سمحت

157
00:09:56,660 --> 00:09:58,080
!بالطّبع

158
00:09:58,080 --> 00:10:01,990
أُفكّر في اختبار وظيفة مُثيرة للاهتمام

159
00:10:02,330 --> 00:10:04,040
!تغيير الشّكل

160
00:10:05,050 --> 00:10:09,200
إنّه متجر آلة بيع، حيث يمكنك شراء
!أدوات متجر 24 ساعة في اليوم

161
00:10:09,200 --> 00:10:12,960
وأستطيع التّباهي بكيفيّة ترتيبي
للأشياء في هذا الفضاء المحدود

162
00:10:13,420 --> 00:10:15,810
حسناً، إنّها التّشكيلة المثاليّة

163
00:10:15,810 --> 00:10:21,480
تعالوا واستلذّوا بقوّة آلة بيع
!مُتحوّلة إلى متجر مُصغَّر

164
00:10:21,480 --> 00:10:23,110
مرحباً بك

165
00:10:21,480 --> 00:10:24,130
!مُذهل، إنّه كنز دفين

166
00:10:24,130 --> 00:10:26,990
!الكثير من الأطعمة الّتي لم أرها من قبل

167
00:10:26,210 --> 00:10:28,490
!حـ-حسناً، سوف أجرّبها جميعها فحسب

168
00:10:28,490 --> 00:10:31,620
!سـ-سأفعل أيضاً، من الأعلى إلى الأسفل

169
00:10:30,640 --> 00:10:33,520
!اهدأ يا ميكاني! وانزل إلى هنا

170
00:10:32,730 --> 00:10:35,050
بجدّية، يبدو كلّ شيء لذيذاً

171
00:10:35,050 --> 00:10:37,220
سوف يترتّب علينا تجربة عدد من الأشياء

172
00:10:37,220 --> 00:10:38,520
ماذا ينبغي أن نتناول يا آكا؟

173
00:10:38,520 --> 00:10:41,480
!شيرو، لنختر سلعاً مختلفة، ونتقاسمها

174
00:10:41,770 --> 00:10:43,640
ما هذا؟ كيف آليّة عمله؟

175
00:10:43,430 --> 00:10:44,500
على ذكر الأمر

176
00:10:43,640 --> 00:10:45,380
!اهدأ يا ميكاني

177
00:10:44,500 --> 00:10:48,860
غالباً لا يعلمون كيفيّة فتح كُرة
أرزّ، لذا ينبغي أن أشرح

178
00:10:45,380 --> 00:10:48,270
...أوّلاً نفعل هذا، ثمّ هذا

179
00:10:50,500 --> 00:10:52,240
!ما هذا يا هاكّون؟

180
00:10:54,860 --> 00:10:56,730
!المعذرة يا جماعة

181
00:10:57,870 --> 00:10:59,670
...أعتذر

182
00:11:00,410 --> 00:11:02,340
...لكن هل يستطيع أحد

183
00:11:02,340 --> 00:11:03,560
!تولّي هذا

184
00:11:03,560 --> 00:11:06,010
!هلّا تولّيتم مكاني الآن؟

185
00:11:06,410 --> 00:11:09,380
هاكّون

186
00:11:12,980 --> 00:11:14,020
توقّفوا

187
00:11:14,020 --> 00:11:17,020
غالباً سنجدهم في مكان ما
أسفل هذه التّلّة

188
00:11:17,020 --> 00:11:18,440
أجل، على الأغلب

189
00:11:18,440 --> 00:11:21,780
ميشويل، هل يمكنك الشّعور بعدد
الكائنات في الأسفل هناك؟

190
00:11:23,290 --> 00:11:26,170
إنّهم قريبون جدّاً من بعضهم
لدرجة تُصعّب التّحديد بدقّة

191
00:11:26,170 --> 00:11:29,300
ينبغي أن نكون مستعدّين لما
لا يقلّ عن مئة

192
00:11:29,300 --> 00:11:30,650
أهذا كلّ شيء؟

193
00:11:30,650 --> 00:11:33,840
إذاً أعتقد بأنّ فُرصة نجاتنا كبيرة إذا
دخل خطُّ جبهتنا

194
00:11:33,840 --> 00:11:35,970
سأتولّى أنا وميشويل القيادة

195
00:11:35,970 --> 00:11:37,550
لا مانع لديّ

196
00:11:37,830 --> 00:11:40,170
هل من شيء أستطيع فعله؟

197
00:11:40,170 --> 00:11:42,860
مثل طريقة ما لإبطاء الوحوش؟

198
00:11:43,380 --> 00:11:44,940
!بوسعي دوماً استخدام ذلك

199
00:11:44,940 --> 00:11:46,420
!تغيير الشّكل

200
00:11:47,520 --> 00:11:49,680
هاكّون؟ ما الأمر؟

201
00:11:50,850 --> 00:11:52,580
تـ-ن-حّوا جا-ن-باً

202
00:11:55,560 --> 00:11:57,800
هذا مُبهر بعض الشّيء

203
00:12:00,650 --> 00:12:03,250
مُعلّم هاكّون، ما هذه الكُرات؟

204
00:12:03,250 --> 00:12:04,730
أنت قريب جدّاً

205
00:12:04,730 --> 00:12:06,620
ع-ر-ق-لة ح-ر-كة

206
00:12:07,200 --> 00:12:11,600
المعذرة، إذا تحرّكوا، فإنّ الكُرات
ستدعهم يتعثّرون ويسقطون؟

207
00:12:11,600 --> 00:12:12,700
ص-ح-ي-ح

208
00:12:12,990 --> 00:12:16,460
ينبغي أن نعلن بأنّ لاميس هي
!المُفسِّرة الأولى لهاكّون

209
00:12:17,970 --> 00:12:20,560
أظنّني أسمع صراخ الوحوش
من هناك في الأسفل

210
00:12:20,560 --> 00:12:22,840
أصواتهم غريبة وهناك كثير من الضّجيج

211
00:12:22,840 --> 00:12:25,840
جيّد، هيّأ هاكّون المسرح لنا

212
00:12:25,840 --> 00:12:27,240
!لنُسارع إلى هناك

213
00:12:27,240 --> 00:12:28,100
!عُلِم

214
00:12:28,830 --> 00:12:33,270
إن كان يوجد الكثير منهم، فمن الآمن
!أن نفترض بأنّه يوجد قائد هنا

215
00:12:33,270 --> 00:12:34,410
!لنهجم

216
00:12:34,410 --> 00:12:35,870
!هجوم الزّئير

217
00:12:38,980 --> 00:12:44,660
مُذهل. ليتني كنتُ بهذه القوّة، لاستطعتُ
تقديم المُساعدة للجميع

218
00:12:48,030 --> 00:12:49,630
أنتِ بخير يا لاميس

219
00:12:49,630 --> 00:12:52,020
!ومن الأفضل أن أكون مشغولاً أيضاً

220
00:12:52,020 --> 00:12:55,100
أدركتُ مؤخّراً بأنّني أستطيع تبديل
،البضاعة لمنح الوصول إلى هذه الحلوى

221
00:12:55,100 --> 00:12:57,950
دون التحوُّل إلى آلة بيع مُختصّة

222
00:12:57,950 --> 00:13:00,380
لا أحد يعرف هذه الأشياء ما لم نُجرّب

223
00:13:00,690 --> 00:13:02,040
!إطلاق

224
00:13:06,800 --> 00:13:09,840
هاكّون، هل يمكنك تولّي الأعداء خلفنا؟

225
00:13:09,840 --> 00:13:11,050
مرحباً بك

226
00:13:11,260 --> 00:13:14,290
السّماح لي بحمايتها من الخلف
!هو دليل على أنّها تثق بي

227
00:13:14,290 --> 00:13:16,310
!من واجب الرّجل الارتقاء لذلك

228
00:13:16,670 --> 00:13:19,820
،أعرف الآن أنّ هذا يفلح كسلاح عريض

229
00:13:19,820 --> 00:13:24,330
لذا سأواجه أيّ عدو يحاول
!مُهاجمة لاميس من الخلف

230
00:13:24,560 --> 00:13:26,290
!هجوم الزّئير

231
00:13:30,700 --> 00:13:32,090
يستمرّون في التّوافد بلا توقُّف

232
00:13:32,360 --> 00:13:35,320
لا يمكننا الفوز إذا ظلّت وحوش جديدة
تظهر بسرعة هزيمتنا لهم

233
00:13:37,960 --> 00:13:40,200
قد أجرّب سؤالها كذلك

234
00:13:40,200 --> 00:13:41,300
ل-ا-ي-س

235
00:13:41,300 --> 00:13:42,040
هل ناديتني؟

236
00:13:43,410 --> 00:13:45,670
ا-ر-م-ني هـ-نا-ك

237
00:13:46,170 --> 00:13:48,740
تريدني أن أرميك إلى هناك؟

238
00:13:49,530 --> 00:13:50,470
!لا

239
00:13:50,470 --> 00:13:52,800
!لا أريد استخدامك كأداة

240
00:13:52,800 --> 00:13:54,410
أ-نت شا-ري-كة

241
00:13:54,410 --> 00:13:55,940
شاريكة"؟"

242
00:13:57,930 --> 00:13:59,940
أجل، نحن شريكان

243
00:13:59,940 --> 00:14:02,100
واسمح لي أن أقول هذا بصفتي شريكتك

244
00:14:02,520 --> 00:14:03,700
!مرفوض

245
00:14:04,690 --> 00:14:09,340
هاكّون، تحاول تعريض نفسك للخطر
من أجل حمايتي

246
00:14:09,340 --> 00:14:11,530
لكن الأمر نفسه ينطبق عليّ

247
00:14:11,530 --> 00:14:14,460
!لا أريدك أن تتأذّى أيضاً

248
00:14:14,460 --> 00:14:16,710
أجل... معك حقّ

249
00:14:16,710 --> 00:14:17,960
آ-س-ف

250
00:14:17,960 --> 00:14:19,890
لا حاجة للاعتذار

251
00:14:19,890 --> 00:14:21,860
قلبانا ينبضان معاً

252
00:14:21,860 --> 00:14:24,090
!أنا أهاجم، وأنت تدافع

253
00:14:24,090 --> 00:14:25,810
!كلانا نستطيع فعل أيّ شيء

254
00:14:25,810 --> 00:14:26,460
أ-جل

255
00:14:26,760 --> 00:14:31,480
،من الآن فصاعداً سوف نتعاون معاً
—ونناقش طريقة أكيدة كي

256
00:14:31,480 --> 00:14:34,970
!ولذا، لنشنّ كلانا هجمة انتحاريّة

257
00:14:34,970 --> 00:14:36,410
ا-انتظري لحظة يا آنسة

258
00:14:36,410 --> 00:14:39,230
!ألا تعتقدين بأنّ هذا مُتطرّف جدّاً

259
00:14:39,230 --> 00:14:41,610
أو-أو-أو-أو-أو

260
00:14:40,770 --> 00:14:42,570
لاميس؟ المُعلّم هاكّون؟

261
00:14:42,570 --> 00:14:44,830
!ا-المعذرة، سأمهّد طريقاً

262
00:14:46,630 --> 00:14:48,840
!المُعلّم هاكّون! يمكنك التقدُّم

263
00:14:49,050 --> 00:14:51,400
!لا، لا! يمكنك إيقافنا

264
00:14:51,400 --> 00:14:52,910
!شكراً يا ميشويل

265
00:14:52,910 --> 00:14:54,890
!هذا ما أتوقّعه من التّلميذ الأوّل لهاكّون

266
00:14:54,890 --> 00:14:57,150
لا شكر على واجب

267
00:14:57,150 --> 00:14:59,670
يبدو ميشويل مسروراً بالمديح

268
00:14:59,670 --> 00:15:01,660
!لم أعُد أُبالي

269
00:15:05,830 --> 00:15:08,700
...شلّ حركة العدوّ من دون هزيمتهم

270
00:15:08,700 --> 00:15:10,380
!يتطلّب كُرات باتشينكو

271
00:15:10,380 --> 00:15:14,130
المُنتج الأفضل للانزلاق والسّقوط
!هو هذه بلا شكّ

272
00:15:14,130 --> 00:15:15,300
!إطلاق

273
00:15:20,180 --> 00:15:21,890
!هذا مُمتع

274
00:15:21,890 --> 00:15:22,950
!سأظلّ أضيف المزيد

275
00:15:28,390 --> 00:15:29,960
هذا كفيل بالتخلّص منهم

276
00:15:29,960 --> 00:15:32,290
هاكّون، أين القائد؟

277
00:15:32,290 --> 00:15:35,950
جميعهم وحوش خضراء. لا أرى
أيّ شيء يُشبه القائد

278
00:15:35,950 --> 00:15:37,160
!هاكّون

279
00:15:38,150 --> 00:15:39,440
!ما هذه؟

280
00:15:44,440 --> 00:15:46,820
ميكاني! هل أنت بخير؟ ماذا حدث؟

281
00:15:45,490 --> 00:15:48,490
أمان. شكراً

282
00:15:48,490 --> 00:15:52,730
اسمعي، قبل قليل، سمعتُ ما يُشبه
صرخات بشريّة من هناك

283
00:15:52,730 --> 00:15:55,100
أعتقد كان ذلك داخل تلك التلّة

284
00:15:55,100 --> 00:15:57,440
ما زلتُ أسمع أنيناً ضعيفاً من هناك

285
00:15:57,440 --> 00:16:00,620
!لا بدّ أنّ تلك الهجمة الأولى تكفّلت بالعمل

286
00:16:00,620 --> 00:16:03,650
!في هذه الحالة، تغيير الشّكل

287
00:16:03,650 --> 00:16:05,750
!مغسلة الضّغط

288
00:16:07,940 --> 00:16:09,430
إنّهم هناك؟

289
00:16:09,430 --> 00:16:11,800
!حسناً، سأذهب لإلقاء نظرة. انتظر هنا

290
00:16:11,800 --> 00:16:12,700
بالتّوفيق

291
00:16:17,910 --> 00:16:18,710
!هنا

292
00:16:20,200 --> 00:16:21,930
!لا بُدّ أنّه القائد

293
00:16:24,050 --> 00:16:27,610
،عندما لا يستطيع العدوّ إيقافهم
فإنّنا نستهدف الخاتم

294
00:16:30,960 --> 00:16:32,720
!تخلّصنا من إحدى الأشياء المُؤرقة

295
00:16:33,410 --> 00:16:35,000
ل-ن-غا-در

296
00:16:35,000 --> 00:16:36,090
!المُعلّم هاكّون

297
00:16:36,090 --> 00:16:37,630
!مهّدنا طريقاً للانسحاب

298
00:16:37,630 --> 00:16:39,860
!تراجعوا إلى الممرّ

299
00:16:40,540 --> 00:16:44,310
،الآن بعد أن عدنا كلّ هذه المسافة
أُنجِزت المهمّة

300
00:16:44,310 --> 00:16:47,360
أعتقد سنسأل الفتاة هنا حالما
نعود إلى القرية

301
00:16:47,360 --> 00:16:48,440
أجل، سنفعل

302
00:16:48,440 --> 00:16:52,940
لكن هل ستستغلّ هذا الوضع المحموم
للرّبت على مؤخّرة امرأة؟

303
00:16:52,190 --> 00:16:54,970
فـ-في الواقع، كنتُ قد تحمّستُ زيادة عن اللّزوم

304
00:16:54,970 --> 00:16:57,060
ليس وكأنّني كنتُ أنوي لمسها هناك

305
00:16:57,060 --> 00:16:58,260
!حقّاً؟

306
00:16:58,260 --> 00:17:00,450
هذان الشّخصان منسجمان معاً

307
00:17:00,450 --> 00:17:01,610
أ-جل فـ-علاً

308
00:17:01,860 --> 00:17:04,620
ما العلاقة بينهما بالضّبط، على أيّ حال؟

309
00:17:03,630 --> 00:17:06,720
يا قائد، دائماً ما تتصرّف هكذا

310
00:17:05,790 --> 00:17:09,490
ينبغي لذلكما الاثنين أن يكونا كبيرين
بما يكفي ليعلما يا آكا

311
00:17:06,720 --> 00:17:09,490
كنائبة قائد، أقرّ بأنّ هذا
يضرب مثلاً سيّئاً

312
00:17:09,490 --> 00:17:12,520
مهلاً، أنا لستُ مهتمّاً بالمؤخّرات إطلاقاً

313
00:17:09,490 --> 00:17:12,790
أعترف بأنّ رؤية ذلك مُحرجة دوماً

314
00:17:12,790 --> 00:17:14,490
إنّهما "كبيران بما يكفي"؟

315
00:17:14,490 --> 00:17:16,890
أليست نائبة القائد فيلمينا صغيرة؟

316
00:17:16,890 --> 00:17:18,610
ألم تكوني تعلمين؟

317
00:17:18,610 --> 00:17:21,670
قد لا تبدو كذلك، لكنّها أكبر سنّاً من القائد

318
00:17:21,670 --> 00:17:23,730
!ما-ماذا؟ لكنّها صغيرة جدّاً

319
00:17:23,730 --> 00:17:28,520
المعذرة، نائبة القائد هي نصف... عرق ما
لا أستطيع تذكّره

320
00:17:28,520 --> 00:17:30,520
وحش مصّاص دماء يا شوي

321
00:17:30,520 --> 00:17:33,520
وحش مصّاص دماء؟ لم أسمع بهذا العرق

322
00:17:33,520 --> 00:17:39,040
المعذرة، أليس هذا عرقاً يتغذّى
على دماء النّاس؟

323
00:17:39,040 --> 00:17:41,520
جميعهم أشخاص جميلون يشبهون البشر

324
00:17:41,520 --> 00:17:45,110
علاوة على ذلك، سمعتُ أنّ وحوش مصّاصي الدّماء
يستطيعون الحصول على غذاء أيضاً

325
00:17:45,110 --> 00:17:48,500
من السّوائل الجسديّة حيث التّركيبة
مُشابهة للدّماء

326
00:17:49,660 --> 00:17:53,660
لهذا ليس من الغريب لهم أن يشكّلوا
علاقات مع البشر وينجبوا أطفالاً

327
00:17:53,660 --> 00:17:54,810
على ما أعتقد

328
00:17:55,090 --> 00:17:59,090
!يبدو هذا جميلاً. إنّه القدر

329
00:17:59,090 --> 00:18:01,190
ألا يزعجكِ هذا إطلاقاً يا لاميس؟

330
00:18:01,190 --> 00:18:03,500
فهذا يعني القيام "بذلك" مع وحش

331
00:18:03,500 --> 00:18:05,310
الكثير يعتبرون ذلك بغيضاً

332
00:18:05,610 --> 00:18:08,320
يبدو أنّ ردّة فعل لاميس كانت مُفاجئة

333
00:18:08,320 --> 00:18:11,140
،لكن حتّى لو كان عرق شخص أو مظهره مختلف

334
00:18:11,140 --> 00:18:14,160
"فهذا لا يعني أنّه ليس بـ"شخص
!لذا لا أمانع حقّاً

335
00:18:14,160 --> 00:18:15,380
أليس كذلك يا هاكّون؟

336
00:18:15,380 --> 00:18:16,700
أ-جل، أ-جل

337
00:18:16,700 --> 00:18:19,560
وقطيع الوحوش الحمقى قد قبلوها

338
00:18:19,560 --> 00:18:21,880
لذا هي مثل الآخرين فحسب

339
00:18:21,880 --> 00:18:25,030
حسناً، جميعنا غرباء أطوار في النّهاية

340
00:18:26,280 --> 00:18:31,330
تذكّرتُ للتو، سمعتُ أنّ قطيع الوحوش
الحمقى لديهم أمانٍ يريدون تحقيقها

341
00:18:31,330 --> 00:18:34,080
هل يمكنني السّؤال عن ماهيّتها؟

342
00:18:37,090 --> 00:18:40,150
آ-آسفة. هناك أشياء لا يريد
النّاس التحدّث عنها

343
00:18:40,150 --> 00:18:41,550
لا عليكِ

344
00:18:41,550 --> 00:18:46,220
لديّ أُمنية حادة فقط، وهي كسب الكثير
،من المال وتيسير أمور الميتم

345
00:18:46,220 --> 00:18:51,240
وذلك كي آكل أنا والأطفال كافّة الأطعمة
!اللّذيذة كلّ يوم معاً

346
00:18:51,240 --> 00:18:54,160
أجل، هذه أمنية بسيطة لشوي

347
00:18:54,480 --> 00:18:56,730
حسناً. سأذكر أُمنيتي تالياً

348
00:18:56,730 --> 00:19:00,010
أُمنيتي هي جعل هاكّون بشريّاً ثانية

349
00:19:00,010 --> 00:19:04,120
هل هذا يعني بأنّكما لديكما نفس الأُمنية؟

350
00:19:04,120 --> 00:19:04,740
أ-جل

351
00:19:04,980 --> 00:19:08,000
لديّ الكثير منها، لكن لنكتفِ بهذا

352
00:19:08,000 --> 00:19:11,750
حسناً إذاً، سوف أعترف بأُمنيتي

353
00:19:11,750 --> 00:19:13,250
هذا مرفوض تماماً يا هيفي

354
00:19:14,070 --> 00:19:18,630
مهلاً. سماع رغبات الآخرين جميعهم
بينما أتكتّم على رغبتي

355
00:19:18,630 --> 00:19:21,010
سيكون سلوكاً غير لائق بالنّسبة لشخص

356
00:19:21,450 --> 00:19:26,010
أُمنيتي هي جمع الأحذية من كلّ أنحاء
،العالم قبل أن تهترئ

357
00:19:26,010 --> 00:19:29,510
واستخدامها لبناء قلعة ضخمة

358
00:19:29,510 --> 00:19:34,430
لديّ حلم على نطاق واسع، حيث
،أتلقّى في كلّ عام، كضريبة

359
00:19:34,430 --> 00:19:37,200
حذاء تمّ ارتداؤه طوال العام السّابق

360
00:19:37,860 --> 00:19:41,110
هذه أمنية مُخزية حقّاً

361
00:19:42,360 --> 00:19:44,470
أعتقد حان دورنا تالياً

362
00:19:44,470 --> 00:19:46,230
أتشارك أُمنية مع شيرو

363
00:19:46,230 --> 00:19:47,120
أليس كذلك؟

364
00:19:47,120 --> 00:19:48,190
هذا صحيح يا آكا

365
00:19:48,190 --> 00:19:50,320
...أُمنيتنا هي

366
00:19:50,320 --> 00:19:53,290
!أن نشتهر بين الفتيات

367
00:19:53,630 --> 00:19:56,390
هذا كثير من اثنين أعزبين

368
00:19:58,280 --> 00:19:59,370
مع الأسف

369
00:19:59,370 --> 00:20:01,370
ماذا عن القائد ونائبة القائد؟

370
00:20:01,370 --> 00:20:03,120
هذا ما لا أعرفه

371
00:20:03,120 --> 00:20:06,640
سألتهما عن الأمر مرّة، لكنّهما
تجنّبا السّؤال

372
00:20:06,850 --> 00:20:08,890
كذلك هنا

373
00:20:09,170 --> 00:20:11,900
كلّ شخص له أسراره

374
00:20:11,900 --> 00:20:14,600
لا حاجة للتحرّي حولهما

375
00:20:14,850 --> 00:20:18,600
لدى هيفي كلام جيّد ليقوله، عندما
لا يتعلّق الأمر بالأحذية

376
00:20:19,250 --> 00:20:21,280
!أسرعوا يا رفاق

377
00:20:21,280 --> 00:20:23,610
وإلّا فلن نتمكّن من العودة إلى القرية اليوم

378
00:20:23,610 --> 00:20:25,540
!حسناً

379
00:20:26,110 --> 00:20:28,130
!أحسنتم صنعاً جميعاً

380
00:20:28,400 --> 00:20:32,770
هاكّون، هل أزعجك إذا طلبتُ منك توفير
الطّعام والشّراب من أجل وليمة؟

381
00:20:32,770 --> 00:20:34,120
مرحباً بك

382
00:20:35,650 --> 00:20:37,650
!يبدو لذيذاً

383
00:20:38,910 --> 00:20:40,040
!كنتُ أنتظر هذا

384
00:20:40,040 --> 00:20:41,260
!أنا سعيدة للغاية

385
00:20:40,410 --> 00:20:42,140
!دياج مغليّ، دياج مغليّ

386
00:20:42,140 --> 00:20:43,550
!يا سلام

387
00:20:43,820 --> 00:20:48,300
حسناً، حان الآن وقت تجربة شيء
كنتُ أرغب في تجربته

388
00:20:48,300 --> 00:20:50,140
!تغيير الشّكل

389
00:20:50,140 --> 00:20:52,070
!آلة بيع أرزّ

390
00:20:52,400 --> 00:20:57,560
الآن بعد أن امتلكتُ التّحريك عن بُعد، أستطيع
حتّى تحضيره بنفسي... على ما أعتقد

391
00:20:57,560 --> 00:20:59,610
والآن، كيف سأطبخ هذا؟

392
00:20:59,610 --> 00:21:01,890
هاكّون، ما هذا؟

393
00:21:01,890 --> 00:21:03,320
إنّها آلة طبخ، صحيح؟

394
00:21:03,320 --> 00:21:04,440
!وجدتُها

395
00:21:04,440 --> 00:21:08,460
طـ-ب-خ، سـ-عد-ني ر-جاء

396
00:21:08,460 --> 00:21:09,820
حسناً، بالتّأكيد

397
00:21:08,460 --> 00:21:11,030
ماذا يجدر بنا أن نفعل؟

398
00:21:11,030 --> 00:21:12,450
!تغيير الشّكل

399
00:21:12,450 --> 00:21:14,770
!آلة بيع غاز

400
00:21:14,770 --> 00:21:15,950
ض-ع هـ-نا

401
00:21:15,950 --> 00:21:17,280
هكذا؟

402
00:21:17,280 --> 00:21:18,350
شكراً لك

403
00:21:18,650 --> 00:21:21,460
هذه أداة سحريّة تنتج ناراً

404
00:21:21,460 --> 00:21:26,240
،حصلتُ على بعض المُساعدة في النّهاية
لكن أعتقد أستطيع تولّي الطّبخات البسيطة

405
00:21:26,240 --> 00:21:29,900
لكن يا هاكّون، لماذا بدأت تطبخ فجأة؟

406
00:21:29,900 --> 00:21:31,520
هذا سؤال جيّد

407
00:21:31,520 --> 00:21:33,720
يمكنك توزيع مُختلف أنواع الطّعام

408
00:21:34,980 --> 00:21:38,280
سيكون من الصّعب أن أقول بأنّني
جرّبتُ ذلك من باب التّسلية فقط

409
00:21:39,800 --> 00:21:41,910
!هذا الأرزّ جاهز

410
00:21:41,910 --> 00:21:43,590
!سأذهب لإحضار الأطباق

411
00:21:43,590 --> 00:21:44,960
سأقدّم المساعدة أيضاً

412
00:21:46,510 --> 00:21:48,320
!هذا لذيذ

413
00:21:48,320 --> 00:21:49,740
!أجل، إنّه لذيذ

414
00:21:51,530 --> 00:21:57,240
،كلّ ما فعلتُه كان الطّبخ باستخدام قدراتي
لكنّني سعيد جدّاً الآن

415
00:21:57,640 --> 00:22:00,500
هاكّون، شكراً على كلّ ما تفعله

416
00:22:01,330 --> 00:22:04,110
!أظنّني قد أطبخ ثانية، من وقت لآخر

417
00:23:35,060 --> 00:23:37,040
!قد تربح سلعة إضافية

418
00:23:37,990 --> 00:23:40,170
أتطلّع قُدماً لاستخدامك التّالي لي