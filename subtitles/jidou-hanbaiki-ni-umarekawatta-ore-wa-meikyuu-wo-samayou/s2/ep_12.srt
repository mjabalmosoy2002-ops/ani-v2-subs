1
00:00:02,410 --> 00:00:04,340
من الخارج، صندوق فولاذيّ مُستطيل

2
00:00:04,340 --> 00:00:06,270
!ويوجد بداخله روح بشريّ

3
00:00:06,270 --> 00:00:11,640
في عالم من الأعاجيب، أركب
على ظهر شريكتي لاميس

4
00:00:11,640 --> 00:00:14,170
!أنا هاكّون! مرحباً بك

5
00:00:14,170 --> 00:00:15,840
"!هذا يعني "أجل

6
00:00:30,360 --> 00:00:32,170
دعوا هذا الأمر لي

7
00:00:37,420 --> 00:00:40,180
هل كانت قوّة هيفي خارقة
إلى هذا الحدّ؟

8
00:00:40,180 --> 00:00:45,430
عرفتُ بأنّه يتمتّع ببرَكة القوّة، لكن
أعتقد بأنّه كان يتحفّظ كثيراً

9
00:00:45,690 --> 00:00:49,190
هل يُثبت شدّة صدمة ما حدث معه؟

10
00:00:54,840 --> 00:00:57,440
هـ-هل أنت وحش؟

11
00:00:57,690 --> 00:01:00,080
!هل يُفترَض لرجل الدّين أن يقتل النّاس؟

12
00:01:00,740 --> 00:01:04,200
أنا إنسان قبل أن أكون رجل دين

13
00:01:05,080 --> 00:01:06,330
!أ-أنا آسف

14
00:01:06,810 --> 00:01:08,270
!سأتوقّف عن كوني سيّئاً

15
00:01:08,270 --> 00:01:10,710
!ا-اعفُ عن حياتي فحسب

16
00:01:10,710 --> 00:01:17,200
تقول الآلهة بأنّ الموت هادئ، ويُدرك
الجميع بلا تحيُّز

17
00:01:17,730 --> 00:01:20,480
لكن ثمّة نقطة واحدة أختلف معها

18
00:01:20,480 --> 00:01:21,530
!ا-انتظر

19
00:01:21,530 --> 00:01:22,720
!سأدفع لك أيّ مبلغ

20
00:01:22,720 --> 00:01:26,730
الموت يجب ألّا يكون عديم التحيُّز
عندما يتعلّق الأمر بالحثالة

21
00:01:26,730 --> 00:01:29,040
—وكلّ ما تشاء من نساء، لذا

22
00:01:41,870 --> 00:01:46,380
إيّاك أن تعتقد بأنّك تستطيع
!أن تخدعني وتفلت بفعلتك

23
00:01:47,490 --> 00:01:50,200
انتهى أمركم

24
00:01:55,050 --> 00:01:58,930
الحلقة 12: عاصفة ثلجيّة في الصّحراء

25
00:01:57,260 --> 00:01:59,710
!لا بُدّ أنّه حاكم الطّبقة

26
00:01:59,710 --> 00:02:04,470
حاكم طبقة الغيلان الّذي قيل بأنّه يسكن
في الطّابق الأعلى من عمود الصّحراء؟

27
00:02:04,470 --> 00:02:06,850
انتهى أمركم جميعاً

28
00:02:06,850 --> 00:02:09,510
!والآن استيقظ أيّها الغول المزدوج

29
00:02:10,810 --> 00:02:11,990
وقت الطّعام؟

30
00:02:11,990 --> 00:02:13,110
وقت الطّعام

31
00:02:13,110 --> 00:02:15,610
يمكنك أكلهم أيّ الوحش

32
00:02:18,150 --> 00:02:20,310
!أنت! توقّف

33
00:02:20,310 --> 00:02:21,580
—أنا

34
00:02:24,620 --> 00:02:27,210
لن أتخلّى عن فريستي

35
00:02:27,210 --> 00:02:28,590
!أنت

36
00:02:28,590 --> 00:02:29,950
!لا تسرق منّا

37
00:02:29,950 --> 00:02:34,220
.أنا من يوجّه هذا الكلام لك
وضعتُ يدي عليه قبلك

38
00:02:35,830 --> 00:02:37,210
قا-تل-و-هم

39
00:02:37,210 --> 00:02:38,330
!حسناً

40
00:02:42,180 --> 00:02:43,810
!سأتعامل معه

41
00:02:43,810 --> 00:02:44,970
!احذري

42
00:02:45,330 --> 00:02:47,510
!وعدتُ أن أقدّم المُساعدة

43
00:02:47,510 --> 00:02:49,600
أنا مُمتنّ لذلك

44
00:02:49,600 --> 00:02:52,730
!لنُسرع ونهزم هذا الوحش

45
00:02:52,730 --> 00:02:55,990
،بوجود المُعلّم هاكّون والجميع هنا
!لن نُواجه أي مُشكلة

46
00:02:58,650 --> 00:03:01,410
لحم! لحم! هل يمكننا أن نأكل؟

47
00:03:01,410 --> 00:03:03,500
!أريد الأفخاذ والأمعاء

48
00:03:03,890 --> 00:03:07,240
!حان وقت المُواجهة الأخيرة في هذا الطّابق

49
00:03:15,250 --> 00:03:17,070
—أنت تستهين بالبشر كثيراً

50
00:03:17,070 --> 00:03:18,620
—مستحيل! اهربوا جميعـ

51
00:03:19,350 --> 00:03:21,640
!وقت الحاجز

52
00:03:22,630 --> 00:03:25,630
انخفضت النّقاط بقيمة 2222

53
00:03:25,630 --> 00:03:26,940
!ماذا؟

54
00:03:26,940 --> 00:03:31,020
في حين فقدتُ ألف نقطة فقط عندما
!اصطدم بي ذلك التّمساح ذو الثّمانية أرجُل؟

55
00:03:32,560 --> 00:03:34,420
لن تُحطّمونا

56
00:03:35,270 --> 00:03:37,770
!لماذا لم يُسقطه ذلك؟

57
00:03:39,360 --> 00:03:41,400
مع الأسف. مع الأسف. مع الأسف

58
00:03:41,400 --> 00:03:44,900
،إذا ظلّتْ تلك الهجمات تُصيبني
!فسأصبح خردة فوراً

59
00:03:44,900 --> 00:03:47,740
!هذا أكبر من طاقتنا. لننسحب

60
00:03:53,020 --> 00:03:54,020
!ليست خطّة جيّدة

61
00:03:54,020 --> 00:03:57,160
على ذكر الأمر، هذه أوّل مرّة نقاتل
!فيها حاكم طبقة بشكل مُباشر

62
00:03:57,160 --> 00:03:59,220
!كنّا قبل الآن نستغلّ نقاط ضعفهم

63
00:03:59,220 --> 00:04:03,670
وكونهم تحت قيادة حاكم العالم السّفليّ
!فقد جعلَهم ذلك أضعف من المعتاد

64
00:04:03,670 --> 00:04:05,930
!تغيير الشّكل

65
00:04:13,150 --> 00:04:13,890
!من هنا

66
00:04:13,890 --> 00:04:14,940
!لنتفرّق

67
00:04:16,320 --> 00:04:19,350
!لا تهربوا

68
00:04:19,350 --> 00:04:21,520
!وكأنّ هذا سيجعل الجميع يتوقّفون عن الهرب

69
00:04:24,270 --> 00:04:27,280
!هاكّون! يوجد كثيرٌ من الضّجيج خلفنا

70
00:04:27,640 --> 00:04:29,780
!قد تربح سلعة إضافيّة

71
00:04:42,130 --> 00:04:43,970
!تبّاً! ماذا يجدر بي أن أفعل؟

72
00:04:43,970 --> 00:04:47,000
...فكّر! ماء، جليد، لهب

73
00:04:49,520 --> 00:04:50,880
!الكثير من الطّعام

74
00:04:50,880 --> 00:04:52,760
!لحم! لحم

75
00:04:52,760 --> 00:04:53,800
ماذا؟

76
00:04:55,940 --> 00:04:57,730
!إ-إنّه يأكل الوحوش

77
00:04:57,730 --> 00:04:59,980
فهمت، إنّه جائع جدّاً

78
00:04:59,980 --> 00:05:02,210
!لا بُدّ أنّ معدته الفارغة تُثير غضبه

79
00:05:02,210 --> 00:05:03,260
...في هذه الحالة

80
00:05:03,260 --> 00:05:07,460
سأمنحه المُفضَّلة شخصيّاً، صلصة
!الشّواء الأصليّة

81
00:05:10,410 --> 00:05:11,450
ما هذا؟

82
00:05:11,450 --> 00:05:13,190
!رائحتها زكيّة

83
00:05:14,990 --> 00:05:17,600
!إنّها لذيذة

84
00:05:19,960 --> 00:05:21,900
!هذه الأصليّة لأجلك أنت

85
00:05:21,900 --> 00:05:24,010
!ينبغي أن يُكسبنا هذا بعض الوقت

86
00:05:27,210 --> 00:05:32,510
آسفة. كان ينبغي أن أخبركم أكثر
سلفاً عن حاكم الطّبقة

87
00:05:32,510 --> 00:05:35,480
ماذا يُفترض بنا أن نفعل
ضدّ خصم كهذا؟

88
00:05:35,820 --> 00:05:40,670
في العادة أردّ بـ"مرحباً بك" باستهتار
لكن لا أعلم أيضاً

89
00:05:41,410 --> 00:05:44,090
كنتُ عبئاً بدلاً من أن أكون مُفيداً

90
00:05:44,090 --> 00:05:46,180
أنا آسف يا مُعلّم هاكّون

91
00:05:46,180 --> 00:05:49,130
وأنا غضبتُ أكثر ممّا ينبغي

92
00:05:49,130 --> 00:05:52,240
أعتذر لتعريض الجميع للخطر

93
00:05:52,630 --> 00:05:56,000
حا-ن و-قت ال-خ-طّة

94
00:05:56,000 --> 00:06:00,010
معه حقّ. الاعتذار من شخص
لن يُحسّن الوضع

95
00:06:00,010 --> 00:06:02,620
لنفكّر فيما سنفعله بشأن ذلك الغول

96
00:06:03,120 --> 00:06:04,930
أمامنا خياران

97
00:06:04,930 --> 00:06:07,290
نهرب من هنا، أو نهزمه

98
00:06:07,290 --> 00:06:09,430
إنّه خصمٌ قويٌّ جدّاً

99
00:06:09,430 --> 00:06:11,300
أعتقد يجدر بنا التّفكير في الهرب

100
00:06:11,300 --> 00:06:13,880
هل أنت متأكّد؟ تركنا تاشتاي خلفنا

101
00:06:13,880 --> 00:06:18,760
،الاحتمالات هي أن يكون قد مات بالفعل
أو أن يلتهمه الغول المُزدوج

102
00:06:18,760 --> 00:06:22,150
حتّى خاتم الجمجمة ذاك لم يلجمه

103
00:06:22,150 --> 00:06:25,440
لا يستطيع الخاتم إلّا التّعامل
مع أوامر بسيطة

104
00:06:25,440 --> 00:06:27,210
،عندما يتعلّق الأمر بحاكم طبقة

105
00:06:27,210 --> 00:06:29,860
فإنّ الطّلب منه الهجوم هو غالباً
أكثر ما يتمنّاه المرء

106
00:06:29,860 --> 00:06:31,910
خاتم الجمجمة الخاصّ بتاشتاي

107
00:06:31,910 --> 00:06:36,290
ما كان الغول المُزدوج ليتلقّى
الأوامر إذا أكلَه، أليس كذلك؟

108
00:06:36,960 --> 00:06:39,010
...أنا متأكّدة بأنّ ذلك

109
00:06:39,010 --> 00:06:41,760
ليس مستحيلاً بالضّرورة

110
00:06:42,210 --> 00:06:46,550
في هذه الحالة، سيتحكّم حاكم
الطّبقة ببعض الوحوش

111
00:06:46,550 --> 00:06:49,390
...إذا هاجمَ القرية

112
00:06:49,390 --> 00:06:53,130
أعتقد من الأفضل أن نهزمه هنا والآن

113
00:06:53,130 --> 00:06:55,140
ما رأيك يا مُعلّم هاكّون؟

114
00:06:55,140 --> 00:06:59,390
هلّا امتنعتَ عن ترك قرار كهذا
لي أنا يا ميشويل؟

115
00:06:59,390 --> 00:07:04,670
يا جماعة، ما الّذي تتأمّلونه
من آلة بيع بالضّبط؟

116
00:07:04,670 --> 00:07:06,890
لكن أعتقد بأنّني لا أستطيع
!التكلّم هكذا

117
00:07:06,890 --> 00:07:09,910
أ-حت-اج مع-لو-مات

118
00:07:10,170 --> 00:07:12,650
تريد معلومات أوّلاً؟

119
00:07:13,700 --> 00:07:15,350
لديه رأسان

120
00:07:15,350 --> 00:07:17,640
الأيمن هو ذكر والأيسر أُنثى

121
00:07:17,640 --> 00:07:21,920
،يبدو أنّهما يختلفان في بعض الأمور
لكنّهما مُنسجمان عموماً

122
00:07:21,920 --> 00:07:25,790
جسده أقسى من الفولاذ، ورأيتم قوّته

123
00:07:25,790 --> 00:07:29,430
غالباً يتفوّق حتّى على لاميس
من حيث القوّة الخالصة

124
00:07:29,430 --> 00:07:31,610
،بعيداً عن هجماتي

125
00:07:31,610 --> 00:07:36,930
لكن ألا تستطيع هجمات ميشويل ولاميس
أن تخترق شيئاً صلباً كالفولاذ؟

126
00:07:36,930 --> 00:07:39,540
لنُناقش أيضاً برَكة الغول المُزدوج

127
00:07:39,540 --> 00:07:41,940
أعتقد جميعكم يتّفقون على
أنّ لديه برَكة القوّة؟

128
00:07:43,720 --> 00:07:46,180
أجل، كانت تلك القوّة استثنائيّة

129
00:07:46,180 --> 00:07:48,530
والمعضلة هي التّقسية

130
00:07:48,530 --> 00:07:50,190
هذا يجعله أكثر صلابة حتّى

131
00:07:50,190 --> 00:07:53,280
غالباً هذا هو سبب عدم تأثير هجمتي

132
00:07:53,280 --> 00:07:54,730
برَكة القوّة، والتّقسية

133
00:07:54,730 --> 00:07:57,570
رغم بساطة الأمر، لكنّه
في واقع الأمر مُعقَّد

134
00:07:57,570 --> 00:08:01,060
كنّا لنتمكّن من فعل شيء ما
لو كان القائد هنا

135
00:08:01,060 --> 00:08:03,200
أجل، برَكة اختراق العين

136
00:08:03,200 --> 00:08:05,570
لا جدوى من تمنِّي ما لا نملكه

137
00:08:05,570 --> 00:08:07,580
سيترتّب علينا العمل بما نملكه

138
00:08:07,580 --> 00:08:09,070
صحيح

139
00:08:09,070 --> 00:08:10,550
...أيضاً

140
00:08:11,080 --> 00:08:13,350
سمعتُ أنّه شرِه ومُدمن شرب

141
00:08:13,350 --> 00:08:16,170
يبدو هذا كغول يابانيّ

142
00:08:16,170 --> 00:08:19,390
هناك أقاويل قديمة عن مُهاجمته
بعد أن يصبح ثملاً

143
00:08:19,390 --> 00:08:21,260
!ثمل؟ كحول

144
00:08:21,260 --> 00:08:23,330
!أستطيع تقديم كحول غير محدودة له

145
00:08:23,330 --> 00:08:24,450
!حسناً

146
00:08:32,370 --> 00:08:33,840
...هذا

147
00:08:34,650 --> 00:08:35,860
خمر؟

148
00:08:35,860 --> 00:08:37,590
هناك الكثير منه

149
00:08:37,590 --> 00:08:39,470
هل سندع ذلك الشّيء يشربه؟

150
00:08:39,470 --> 00:08:40,610
كيف؟

151
00:08:40,610 --> 00:08:42,110
سؤال وجيه

152
00:08:42,110 --> 00:08:45,030
ربّما سيشربه إذا سكبَتْه له فتاةٌ جميلة

153
00:08:45,030 --> 00:08:47,920
لا نملك فكرة عمّا يراه الغول جميلاً

154
00:08:48,210 --> 00:08:51,560
المعذرة، ماذا لو كان غولاً جميلاً؟

155
00:08:51,560 --> 00:08:52,920
أين سنجد واحداً؟

156
00:08:52,920 --> 00:08:55,800
هل يمكن أن يكون هلوَسة غول؟

157
00:08:55,800 --> 00:09:00,580
قابلتُ العديد من الغيلان، لذا
هذا ليس أمراً مُستبعداً

158
00:09:00,580 --> 00:09:03,050
لكن لا أعرف كيفيّة التكلُّم بلغتهم

159
00:09:03,050 --> 00:09:06,230
أستطيع تعليمك بعض الأمور
السّطحيّة على الأقلّ

160
00:09:06,230 --> 00:09:09,570
،لا أعلم ما إن كان ذلك سينجح أو لا
لكن لا مانع من التّجربة

161
00:09:09,570 --> 00:09:11,230
مرحباً بك

162
00:09:15,020 --> 00:09:16,060
هاكّون

163
00:09:16,350 --> 00:09:18,780
وحش غول صخريّ

164
00:09:18,780 --> 00:09:21,320
،لكنّه هيفي في الواقع
بإطلاق وهم عليه

165
00:09:21,760 --> 00:09:26,830
وأنا على ظهره، مُتحوّلاً
إلى آلة بيع طفل

166
00:09:26,830 --> 00:09:29,160
ثلاثون قنينة بلاستيكيّة ذات اللّترين

167
00:09:29,160 --> 00:09:32,080
تمّ استبدال الماء بداخلها
بمشروبات كحوليّة مُتنوِّعة

168
00:09:32,360 --> 00:09:34,210
حسناً، ها أنا ذا

169
00:09:35,460 --> 00:09:38,410
إذا ارتأيتَ بأنّ الأمر خطير، فعُد حالاً

170
00:09:38,410 --> 00:09:40,230
توخّ الحذر رجاء

171
00:09:51,000 --> 00:09:52,090
من أنت؟

172
00:09:52,090 --> 00:09:54,480
ماذا يفعل غول صخريّ هنا؟

173
00:09:55,490 --> 00:09:57,450
هذه طريقة كلام غول تعلّمناها من هيوليمي

174
00:09:57,450 --> 00:09:58,740
إنّه تأكيد

175
00:09:59,490 --> 00:10:00,560
ما هذا؟

176
00:10:00,560 --> 00:10:01,410
ماء؟

177
00:10:01,410 --> 00:10:03,530
!والآن تخلّص من الخيوط والأغطية

178
00:10:06,330 --> 00:10:07,440
!هذه الرّائحة

179
00:10:07,440 --> 00:10:08,860
إنّها خمر؟

180
00:10:11,620 --> 00:10:14,390
!هذا صحيح، يحبّ الشّرب

181
00:10:14,390 --> 00:10:16,620
!لكن لا ضير من التمهُّل

182
00:10:18,330 --> 00:10:20,250
!أعطني هذه أيضاً

183
00:10:20,960 --> 00:10:22,160
!هذا لذيذ

184
00:10:22,160 --> 00:10:24,140
!لم أتناول شراباً بهذه اللّذّة من قبل

185
00:10:24,140 --> 00:10:26,020
!المزيد! المزيد

186
00:10:26,020 --> 00:10:28,160
!كنتُ أشعر بالعطش أيضاً

187
00:10:28,160 --> 00:10:29,890
يا له من غول صخريّ سخيّ

188
00:10:35,640 --> 00:10:37,310
!هل هناك ما يكفي؟

189
00:10:37,310 --> 00:10:40,600
!لكن تلكما القنينتين الأخيرتين هما الأقوى

190
00:10:43,160 --> 00:10:46,310
أشعر باسترخاء ونُعاس

191
00:10:46,310 --> 00:10:49,120
يا للإسراف! لنشرب أكثر

192
00:10:59,440 --> 00:11:00,670
!نجح ذلك

193
00:11:01,070 --> 00:11:04,170
يبدو أنّ الغول الثّمل لن يستيقظ بسهولة

194
00:11:06,660 --> 00:11:08,470
ماذا سنفعل بهذا؟

195
00:11:08,470 --> 00:11:10,440
إنّه مليء بالخمر. راقبي

196
00:11:11,010 --> 00:11:12,950
حسناً، غُرِست الإبرة

197
00:11:13,290 --> 00:11:16,810
يبدو أنّه يجب أن يكون صاحياً
كي يستخدم التّقسية

198
00:11:16,810 --> 00:11:19,940
كان هذا المصل لحقن شيخ وحش
الشّجرة بمادّة كيميائيّة

199
00:11:19,940 --> 00:11:21,940
لكنّه ينفعنا في مكان غير مُتوقَّع

200
00:11:23,950 --> 00:11:27,220
أشعر بتأنيب الضّمير لمُهاجمتي له
بينما هو نائم

201
00:11:27,220 --> 00:11:31,540
يؤلمني ذلك أيضاً، لكن أعتقد أنّه
لا حاجة للشّفقة في مُبارزة مُميتة

202
00:11:31,540 --> 00:11:33,200
أليس كذلك يا مُعلّم هاكّون؟

203
00:11:33,200 --> 00:11:34,390
أ-أجل

204
00:11:34,390 --> 00:11:36,970
حسناً، سأتولّى هذا الجانب

205
00:11:36,970 --> 00:11:39,070
هل يمكنك تولّي ذاك الجانب يا ميشويل؟

206
00:11:39,070 --> 00:11:39,990
حسناً

207
00:11:39,990 --> 00:11:41,340
لا-إي-س

208
00:11:41,340 --> 00:11:42,750
ما الأمر يا هاكّون؟

209
00:11:42,750 --> 00:11:45,500
ا-ضرب-وه ب-ي

210
00:11:45,500 --> 00:11:47,320
ماذا ؟بك؟

211
00:11:47,320 --> 00:11:48,260
أ-جل

212
00:11:48,260 --> 00:11:52,800
فهمت. إذا هزمتَ العدوّ، ستكسب نقاطاً

213
00:11:52,800 --> 00:11:54,270
أ-جل، أ-جل

214
00:11:54,270 --> 00:11:55,890
حسناً

215
00:11:55,890 --> 00:11:59,030
...لنرَ إذاً. بواسطة هاكّون

216
00:11:59,030 --> 00:12:01,700
لاميس، لنفعل هذا في نفس الوقت

217
00:12:01,700 --> 00:12:02,780
بالتّأكيد

218
00:12:02,780 --> 00:12:04,410
!واحد، اثنان

219
00:12:09,160 --> 00:12:11,040
!هذا ما يفعله حاكم طبقة

220
00:12:11,040 --> 00:12:13,560
،رغم أنّني تقاسمتُها مع لاميس وميشويل

221
00:12:13,560 --> 00:12:15,790
!حصلتُ على أكثر من مليون نقطة

222
00:12:15,790 --> 00:12:18,430
أما من مانع أن أمتصّ الغول المُزدوج؟

223
00:12:18,430 --> 00:12:19,960
مهلاً لحظة

224
00:12:19,960 --> 00:12:23,700
ثمّة جزء ثمين، ولا مانع لديّ
أن تفعلي ذلك بعد أن أسترجعه

225
00:12:24,210 --> 00:12:25,430
تفضّلي يا كيكويو

226
00:12:25,740 --> 00:12:27,350
شكراً لك

227
00:12:40,940 --> 00:12:44,510
من الأفضل أن نذهب ونتفقّد
ما جرى مع تاشتاي

228
00:12:44,510 --> 00:12:47,190
أجل. شكراً لكِ

229
00:12:50,690 --> 00:12:52,550
أليس الجوّ بارداً قليلاً؟

230
00:12:52,550 --> 00:12:54,920
أجل. إنّه قادم من الأعلى؟

231
00:12:54,920 --> 00:12:56,470
هذا غريب

232
00:12:56,470 --> 00:13:00,490
لم يكن الجوّ في الخارج بهذه البرودة

233
00:13:00,490 --> 00:13:02,930
ماذا يعني هذا يا مُعلّم هاكّون؟

234
00:13:02,930 --> 00:13:04,900
لا تسألني

235
00:13:11,800 --> 00:13:13,280
!البرد قارس

236
00:13:13,280 --> 00:13:17,200
برد شديد! هل نحن في
مُنتصف صحراء حقّاً؟

237
00:13:17,460 --> 00:13:20,280
...هذا البرد... هذا الإحساس

238
00:13:21,040 --> 00:13:22,060
معقول؟

239
00:13:27,580 --> 00:13:29,880
!ماذا؟ تجمّد تماماً؟

240
00:13:29,880 --> 00:13:32,690
!جميعكم، تجمّعوا حول هاكّون رجاء

241
00:13:34,080 --> 00:13:35,830
هاكّون، حاجزك

242
00:13:35,830 --> 00:13:38,080
!قرار حكيم. تفعيل الحاجز

243
00:13:40,320 --> 00:13:43,020
!ثلج؟! في طبقة الرّمل الحارق؟

244
00:13:43,020 --> 00:13:47,590
لم أسمع بوحش في هذه الطّبقة
يتحكّم بالهواء البارد

245
00:13:58,370 --> 00:14:00,350
أنتِ جنّية ثلج

246
00:14:02,100 --> 00:14:05,290
مُخطِئة إذا ظننتِ بأنّنا أعداء

247
00:14:05,290 --> 00:14:08,850
أتينا إلى هنا لرؤية ذلك الرّجل ببساطة

248
00:14:17,000 --> 00:14:18,880
لـ-لماذا ذلك؟

249
00:14:18,880 --> 00:14:22,880
!جنّيات الثّلج ليست عرقاً يقتل البشر

250
00:14:22,880 --> 00:14:26,010
ما الّذي تفعله طفلة ثلج مع البشر؟

251
00:14:26,010 --> 00:14:27,930
!هؤلاء أصدقائي

252
00:14:27,930 --> 00:14:29,610
البشر حثالة

253
00:14:29,610 --> 00:14:31,500
تعلمين ذلك أيضاً، أليس كذلك؟

254
00:14:31,970 --> 00:14:35,270
صحيح أنّني عشتُ حياتي
وأنا أهرب من البشر

255
00:14:35,520 --> 00:14:40,850
أخبرني المُدير دُبّ عن القوى الغامضة
الّتي يمتلكها أطفال الثّلج مثل كيكويو

256
00:14:40,850 --> 00:14:44,050
قيل بأنّك إذا قطعتَ رأس طفل ثلج
،في اليوم الّذي يصبح فيه بالغاً

257
00:14:44,050 --> 00:14:47,410
فإنّه يتحوّل إلى تمثال جليديّ
لا يذوب أبداً

258
00:14:47,410 --> 00:14:52,320
وسيستمرّ ذلك الرّأس المبتور
،في إطلاق لعنات

259
00:14:52,320 --> 00:14:54,530
ما يؤدّي إلى وباء إقليميّ

260
00:14:54,850 --> 00:14:57,670
!لكن هناك أيضاً بشر يمكنك الوثوق بهم

261
00:14:57,670 --> 00:15:00,480
وليس البشر فقط، لكن حتّى
...هاتاكي الموثوق

262
00:15:00,480 --> 00:15:02,670
!هناك كثير من الأشخاص الموثوقين

263
00:15:02,670 --> 00:15:06,570
مسكينة. خدعكِ البشر

264
00:15:06,570 --> 00:15:08,480
!لا، لم يخدعوني! أنتِ تُسيئين الفهم

265
00:15:08,480 --> 00:15:10,420
لسنا أعداءكِ

266
00:15:10,420 --> 00:15:11,680
لستُم أعدائي؟

267
00:15:11,680 --> 00:15:12,770
أجل

268
00:15:12,770 --> 00:15:15,470
إذاً تعملين لصالح حاكم العالم السّفليّ؟

269
00:15:15,470 --> 00:15:17,930
حاكم العالم السّفليّ؟

270
00:15:21,180 --> 00:15:22,790
لا، لا بُدّ أنّكِ لستِ كذلك

271
00:15:22,790 --> 00:15:25,000
الآن بعد أن أمعنتُ النّظر
،في ذلك الصّندوق الفولاذيّ

272
00:15:25,000 --> 00:15:28,810
تبدو وكأنّ أداة هاكّون السّحريّة تلك
هي الّتي تحدّث عنها حاكم العالم السّفليّ

273
00:15:28,810 --> 00:15:31,830
ما رأيكم بذلك؟ أنا مشهور
ولا أعلم بالأمر حتّى

274
00:15:31,830 --> 00:15:34,830
هذا يعني بأنّكِ أنتِ من تعملين
لصالح حاكم العالم السّفليّ؟

275
00:15:34,830 --> 00:15:37,740
أجل، أنا قائدة الدّواء سولريم

276
00:15:37,740 --> 00:15:39,530
قائدة تابعة لملك الشّياطين؟

277
00:15:39,530 --> 00:15:44,570
أنقذني حاكم العالم السّفلي قُبيل أن يقتلني
،بعض البشر الّذين قبضوا عليّ

278
00:15:44,570 --> 00:15:46,840
وكنتُ في صفّه منذ ذلك الحين

279
00:15:49,430 --> 00:15:53,480
ماذا لو نسّقَ حاكم العالم السّفليّ ذلك
كي يتمكّن من كسب قوى جنّية ثلج؟

280
00:15:53,480 --> 00:15:55,350
إنّه شيء قد يفعله حقّاً

281
00:15:55,350 --> 00:15:58,500
كلامه مُطلَق بالنّسبة لي

282
00:15:58,500 --> 00:16:00,590
جميعكم تعترضون طريقنا

283
00:16:03,970 --> 00:16:09,720
انخفضت النّقاط بقيمة 10

284
00:16:09,720 --> 00:16:13,240
نحن في ورطة. حالما نخرج، سوف نتجمّد

285
00:16:13,240 --> 00:16:17,120
حسناً، لديّ الكثير من النّقاط، لذا
قد أستطيع النّجاة من هذا

286
00:16:17,120 --> 00:16:20,990
هل لدى كلّ جنّية ثلج قوى مُبهرة كهذه؟

287
00:16:21,280 --> 00:16:25,300
،تختلف كلّ واحدة منّا عن الأُخرى
لكن هذه بمستوى مُختلف تماماً

288
00:16:25,300 --> 00:16:27,000
إنّها قويّة جدّاً

289
00:16:27,000 --> 00:16:29,440
إلى متى ستدوم هذه العاصفة الثّلجيّة؟

290
00:16:29,440 --> 00:16:33,380
بقوّتها، قد يستغرق ذلك
من يومين إلى ثلاثة

291
00:16:33,630 --> 00:16:36,770
هاكّون، إلى متى سيصمد حاجزك برأيك؟

292
00:16:36,770 --> 00:16:40,380
لنرَ، إذا كنتُ أستهلك عشر
...نقاط في الثّانية

293
00:16:40,380 --> 00:16:42,010
...فبحسب نقاطي الحاليّة

294
00:16:42,310 --> 00:16:43,760
ي-و-م وا-حد

295
00:16:48,030 --> 00:16:50,310
سأحاول إقناعها ثانية

296
00:16:50,310 --> 00:16:51,320
كيف؟

297
00:16:51,320 --> 00:16:53,560
سأكون بخير حتّى لو خرجتُ

298
00:16:53,560 --> 00:16:54,690
حقّاً؟

299
00:16:54,690 --> 00:16:57,050
شكراً على اهتمامك

300
00:16:57,050 --> 00:17:00,000
لكن أريد إيقافها

301
00:17:00,920 --> 00:17:04,690
إنّها "أنا" الّتي لم تلتقِ بهاتاكي أبداً

302
00:17:04,690 --> 00:17:10,140
لو التقيتُ بحاكم العالم السّفليّ قبل لقائي
بهاتاكي، لأصبحتُ مثلها

303
00:17:10,500 --> 00:17:12,140
تشفقين عليها؟

304
00:17:12,490 --> 00:17:16,340
،أكذب إذا قلتُ بأنّني لا أشفق عليها
لكن الأمر أكبر من ذلك

305
00:17:16,340 --> 00:17:17,500
ثِق بي من فضلك

306
00:17:17,800 --> 00:17:19,890
حسناً. سأثق بذلك

307
00:17:19,890 --> 00:17:20,760
...لكن

308
00:17:20,760 --> 00:17:23,270
هاكّون، كم السّاعة الآن؟

309
00:17:23,610 --> 00:17:27,380
في الواقع، سنصبح في مُنتصف
اللّيل بعد أقلّ من دقيقة

310
00:17:27,380 --> 00:17:29,010
!إذاً سوف أعود

311
00:17:36,830 --> 00:17:39,920
ماذا؟ هذان هادئان بشكل غريب

312
00:17:39,920 --> 00:17:41,280
هل يعرفان شيئاً؟

313
00:17:41,280 --> 00:17:44,580
ماذا؟ هل تهبُّ رياحٌ ثلجيّة
من الاتِّجاه المُعاكس؟

314
00:17:44,580 --> 00:17:47,550
وتدفع العاصفة الثّلجيّة الأصليّة؟

315
00:18:03,800 --> 00:18:06,810
المعذرة، من هذه؟ جنّية ثلج؟

316
00:18:06,810 --> 00:18:10,530
هل تعتقدون بأنّها أتت لإنقاذنا؟

317
00:18:10,530 --> 00:18:14,450
جزمتها مثل جزمة كيكويو تماماً

318
00:18:14,450 --> 00:18:15,760
مُعلّم هاكّون

319
00:18:15,760 --> 00:18:18,920
تفاقمتْ كثيراً مُقارنة بما شعرتُ
به من قبل

320
00:18:18,920 --> 00:18:21,400
لكن أشعر بنفس نوع طاقة كيكويو

321
00:18:21,400 --> 00:18:23,070
ماذا يعني هذا؟

322
00:18:23,070 --> 00:18:25,880
هذا يعني بأنّها كيكويو

323
00:18:25,880 --> 00:18:29,560
فهمت، نمَتْ وكَبُرَتْ بلمح البصر

324
00:18:29,560 --> 00:18:31,090
!لحظة، ماذا؟

325
00:18:31,090 --> 00:18:32,860
هذه كيكويو؟

326
00:18:32,860 --> 00:18:34,470
!ماذا؟ مستحيل

327
00:18:34,470 --> 00:18:38,210
سمعتُ أنّه حالما تبلغ جنّيات الثّلج
،عيد ميلادها الثّامن عشر

328
00:18:38,210 --> 00:18:40,830
تُصبح بالغة فجأة

329
00:18:40,830 --> 00:18:43,840
!إذاً اليوم هو عيد ميلاد كيكويو؟

330
00:18:43,840 --> 00:18:48,530
لهذا كانت تتنبّه لتقويمها في الأيّام
!القليلة الماضية

331
00:18:48,530 --> 00:18:50,390
اليوم هو اليوم الّذي تُحيط
به الدّائرة الحمراء

332
00:18:50,390 --> 00:18:53,100
!وقد تجاوزنا مُنتصفَ اللّيل للتو

333
00:18:53,100 --> 00:18:56,070
قواها السّحريّة أفضل بكثير
ممّا كانت عليه

334
00:18:56,070 --> 00:18:58,570
لم أتوقّع أن يكون التّغيير
جذريّاً إلى هذا الحدّ

335
00:18:58,570 --> 00:19:01,820
.إنّها تُنافس قائد تابع لملك الشّياطين
!هذا مُذهل جدّاً

336
00:19:01,820 --> 00:19:03,090
إنّها ندّ لندّ

337
00:19:03,090 --> 00:19:05,480
لا. كيكويو تطغى عليها

338
00:19:05,480 --> 00:19:08,730
هذا مطلبي الأخير. هلّا
غادرتِ هذا المكان؟

339
00:19:08,730 --> 00:19:11,160
لديّ شيء أحتاج لفعله

340
00:19:11,750 --> 00:19:13,770
لا أقبل الموت هنا

341
00:19:13,770 --> 00:19:15,650
لديّ مهمّتي الخاصّة

342
00:19:16,260 --> 00:19:18,250
حسناً، سأُغادر

343
00:19:28,650 --> 00:19:32,280
،ما زال الجوّ بارداً قليلاً
لكن يمكنكم الخروج

344
00:19:36,160 --> 00:19:38,900
المعذرة، أنت كيكويو، صحيح؟

345
00:19:38,900 --> 00:19:40,960
أجل، هذا صحيح

346
00:19:44,580 --> 00:19:47,830
ليتني استطعتُ رؤية لحظة
تحوّلها إلى بالغة

347
00:19:47,830 --> 00:19:51,150
أتساءل ما إن كان هذا يُشبه تسلسُل
تحوُّلات في أنمي فتيات سحريّات

348
00:19:51,150 --> 00:19:52,830
كم أتمنّى أن أُسجّل ذلك

349
00:19:54,090 --> 00:19:57,590
هاكّون، هل تُراودك أفكار
غريبة ثانية؟

350
00:19:57,590 --> 00:19:59,810
!قد تربح سلعة إضافيّة

351
00:19:59,810 --> 00:20:02,080
!ها أنت تدّعي البراءة ثانية

352
00:20:02,080 --> 00:20:06,660
حسناً، أعتقد بأنّ الأمور قد حُسِمت
في هذه الطّبقة أيضاً

353
00:20:06,660 --> 00:20:08,100
لكن أشفق على هيفي

354
00:20:13,850 --> 00:20:15,650
هل أنت جاهز للذّهاب؟

355
00:20:15,650 --> 00:20:19,730
أجل. تلقّى تاشتاي أكثر ممّا يستحقّ

356
00:20:19,730 --> 00:20:23,580
فضلاً عن ذلك، رؤيته يُعاني غالباً
لن يُبدّد أبداً

357
00:20:23,580 --> 00:20:26,880
هذا الضّباب داخل قلبي

358
00:20:26,880 --> 00:20:27,870
،ولذلك

359
00:20:28,550 --> 00:20:30,260
أنا راضٍ عن هذه النّتيجة

360
00:20:30,610 --> 00:20:34,370
ماذا؟ لم أتوقّع أن تظهر عليه
ملامح البهجة هكذا

361
00:20:34,680 --> 00:20:36,680
يبدو أنّك ستكون بخير

362
00:20:36,680 --> 00:20:40,480
هل كنتِ قلقة عليّ؟

363
00:20:40,480 --> 00:20:43,650
!من يقلق على مُنحرف أحذية؟

364
00:20:43,650 --> 00:20:47,760
لكن رغم ذلك، أعتقد بأنّ الأحذية
لم تعُد مُهمّة. هذا مُؤسف

365
00:20:47,760 --> 00:20:51,640
،إن كنت لا تزال تشعر بالإحباط
فيمكنني إعطاءك جزمتي

366
00:20:52,270 --> 00:20:54,890
هل كنتِ جادّة للتو؟

367
00:20:54,890 --> 00:20:58,520
ماذا؟ لا تهتمّ بالأحذية بعد الآن، صحيح؟

368
00:20:58,520 --> 00:21:01,420
صحيح أنّ الانتقام كان يقودني
،للبحث عن الأحذية

369
00:21:01,420 --> 00:21:03,910
لكن الأصحّ هو أنّني
مُهتمّ بجاذبيّتها أيضاً

370
00:21:03,910 --> 00:21:07,390
والآن، التزمي بما قلتِه رجاء
واخلعي هذه الجزمة

371
00:21:07,390 --> 00:21:11,840
لستُ مهتمّاً بكِ شخصيّاً، لكن كنتُ أضع
نُصب عينَي على جزمتكِ لبعض الوقت

372
00:21:11,840 --> 00:21:15,140
أنتِ لا مُبالية بشأن لباسكِ، لذا أعتقد
بأنّ هذه الجزمة الّتي كنتِ ترتدينها

373
00:21:15,140 --> 00:21:17,040
ستبعث رائحة عطِرة أخّاذة

374
00:21:17,040 --> 00:21:18,670
!مُت أيُّها المهووس

375
00:21:18,670 --> 00:21:20,770
!أسحب ما قلتُه

376
00:21:20,770 --> 00:21:22,680
!أريد أن ألعب أيضاً

377
00:21:22,680 --> 00:21:24,290
!هذا كبير جدّاً

378
00:21:32,060 --> 00:21:35,130
في فترة ما، اندلعتْ معركة كُرات ثلج

379
00:21:36,060 --> 00:21:39,070
هل نُشارك كذلك يا مُعلّم هاكّون؟

380
00:21:39,070 --> 00:21:43,150
بالتّأكيد، فمعركة كُرات ثلج في طبقة
الرّمل الحارق تبدو مُمتعة

381
00:21:43,150 --> 00:21:44,600
مرحباً بك

382
00:23:19,780 --> 00:23:22,710
أتعلم الأشخاص الّذين يقلق
يحذر حاكم العالم السّفليّ منهم؟

383
00:23:22,710 --> 00:23:24,630
هاكّون ولاميس؟

384
00:23:24,630 --> 00:23:29,300
يجب على مجموعتك أن تُساعدني
في التّعامل معهما

385
00:23:32,050 --> 00:23:34,150
!قد تربح سلعة إضافيّة

386
00:23:35,680 --> 00:23:37,060
!ربحت

387
00:23:37,390 --> 00:23:45,140
!الموسم 3 قادم