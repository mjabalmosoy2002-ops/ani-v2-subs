1
00:00:01,540 --> 00:00:03,550
من فضلك أدخل قطعاً معدنيّة

2
00:00:05,300 --> 00:00:09,230
انتهت المعركة الشّرسة، والفجوة الكبيرة
في الجدار الواقي قد سُدّت حالياً

3
00:00:10,040 --> 00:00:12,310
،قضينا على الأعداء الّذين دخلوا

4
00:00:12,310 --> 00:00:14,980
،وحالما يتمّ إصلاح الجدار بشكل كامل

5
00:00:14,980 --> 00:00:19,350
يمكنني القول بأنّ قرية طبقة بُحيرة
التدفُّق النّقيّ ستكون آمنة

6
00:00:21,740 --> 00:00:23,950
شكراً على عملك يا هيوليمي

7
00:00:23,950 --> 00:00:25,870
كيف حال دائرة الانتقال؟

8
00:00:25,870 --> 00:00:28,790
أعتقد بأنّني عرفتُها تقريباً

9
00:00:29,620 --> 00:00:32,100
،حتّى لو لم تُصلَح بشكل كامل

10
00:00:32,550 --> 00:00:35,890
إذا أجريتُ بعض التّعديلات، ينبغي أن نتمكّن
من إرسال شخصين أو ثلاثة

11
00:00:36,210 --> 00:00:37,420
...مؤلم

12
00:00:37,420 --> 00:00:39,260
يبدو هذا شهيّاً

13
00:00:41,970 --> 00:00:44,280
هل لي بواحد أيضاً؟

14
00:00:48,620 --> 00:00:50,140
لذيذ

15
00:00:53,010 --> 00:00:57,630
بالمناسبة، هل تعرفان مكان المُدير دُبّ؟

16
00:00:57,630 --> 00:01:01,910
أردتُ الحصول على تعليمات حول ما يجب فعله
بشأن ذلك الانخفاض في الأرض

17
00:01:01,910 --> 00:01:06,660
تقصدين حيث تحوّل هاكّون إلى بناء
ضخم وسقط

18
00:01:07,240 --> 00:01:11,240
يبدو أنّ تلك الفتحة تعبث بجهود الإنشاءات

19
00:01:11,620 --> 00:01:13,750
...مهلاً لحظة، هذا الشّكل

20
00:01:13,750 --> 00:01:14,960
!لديّ فكرة

21
00:01:22,420 --> 00:01:24,280
من الخارج، صندوق فولاذيّ مُستطيل

22
00:01:24,280 --> 00:01:26,260
!ويوجد بداخله روح بشريّ

23
00:01:26,260 --> 00:01:31,640
في عالم من الأعاجيب، أركب
على ظهر شريكتي لاميس

24
00:01:31,640 --> 00:01:34,170
!أنا هاكّون! مرحباً بكم

25
00:01:34,170 --> 00:01:35,860
!"هذا يعني "أجل

26
00:02:51,290 --> 00:02:53,130
عُدت

27
00:02:53,130 --> 00:02:54,680
...هاكّون

28
00:02:53,950 --> 00:02:55,700
أ-ح-س-نت ص-ن-عـ-ـاً

29
00:02:55,700 --> 00:02:58,910
سئمتُ من إزالة الأنقاض الصّباحيّة

30
00:02:59,660 --> 00:03:01,990
!أنا مُرهقة

31
00:03:02,300 --> 00:03:04,390
سئمتُ أيضاً

32
00:03:04,390 --> 00:03:07,660
الهواء خانق في غرفة الانتقال تلك

33
00:03:07,660 --> 00:03:10,240
أنا على وشك أن أجفّ تماماً

34
00:03:10,240 --> 00:03:12,810
أريد شيئاً بارداً

35
00:03:12,340 --> 00:03:15,810
...هاكّون، شيء بارد

36
00:03:16,500 --> 00:03:19,630
ماذا؟ هاكّون، إلى أين أنت ذاهب؟

37
00:03:19,100 --> 00:03:20,430
...هاكّون

38
00:03:20,430 --> 00:03:23,390
!عُد يا هاكّون

39
00:03:24,160 --> 00:03:25,640
!انتظر

40
00:03:24,310 --> 00:03:28,430
!شيء بارد

41
00:03:27,490 --> 00:03:31,400
!هاكّون

42
00:03:31,710 --> 00:03:33,950
...لحظة

43
00:03:42,210 --> 00:03:43,700
!من هنا

44
00:03:44,330 --> 00:03:46,700
!لا بُدّ أنّه شعور رائع

45
00:03:46,700 --> 00:03:49,330
!حسناً! لنغطس أيضاً

46
00:03:49,330 --> 00:03:50,870
!انتظري لحظة

47
00:03:51,580 --> 00:03:53,100
!مرحى

48
00:03:58,750 --> 00:04:00,830
!هذا لطيف جدّاً وبارد

49
00:04:01,450 --> 00:04:02,840
أنتِ عجيبة

50
00:04:05,040 --> 00:04:07,560
جيّد، الجميع مُستمتعون

51
00:04:12,570 --> 00:04:14,820
سوري، ما الّذي يجري؟

52
00:04:14,820 --> 00:04:16,060
!هيّا، انزلي

53
00:04:16,060 --> 00:04:18,850
—أ-أنا لا أحبّ اللّعب في الما

54
00:04:21,660 --> 00:04:23,360
!ماذا تفعلين؟

55
00:04:23,730 --> 00:04:26,670
كنتُ مُحقّاً في صنع مسبح مُؤقّت

56
00:04:29,120 --> 00:04:31,560
!سار الأمر بشكل أفضل من المُتوقَّع

57
00:04:32,730 --> 00:04:34,460
،قرّرنا أن نُقيم مهرجاناً صيفيًّاً

58
00:04:34,460 --> 00:04:38,680
لنمنح أهل القرية بعض التّغيير
والرّاحة من القتال المُستنزِف

59
00:04:42,140 --> 00:04:44,910
،نظراً لقلّة الموارد، لا يمكننا أن نطلق العنان

60
00:04:44,910 --> 00:04:47,890
لكن ارتأيتُ أنّ بمقدورنا استخدام
وسيلة إلهاء ما

61
00:04:47,890 --> 00:04:51,260
هذه الأمور هي السّبب الّذي يجعل
المُدير دُبّ مسؤولاً

62
00:04:51,910 --> 00:04:53,710
!هاكّون! آيس كريم

63
00:04:53,710 --> 00:04:54,710
!لي أيضاً

64
00:04:54,710 --> 00:04:55,930
آيس كريم؟

65
00:04:55,930 --> 00:04:58,650
،لا. في مهرجان الصّيف
!يجب أن يكون هذا

66
00:04:59,140 --> 00:05:01,140
!تغيير الهيئة

67
00:05:01,380 --> 00:05:02,780
!ثلج مبشور

68
00:05:02,780 --> 00:05:04,020
!لا أقبل بـ"لا" كإجابة

69
00:05:04,310 --> 00:05:05,860
ما-ما هذا؟

70
00:05:05,860 --> 00:05:07,550
!مُنتَج هاكّون جديد؟

71
00:05:06,720 --> 00:05:07,790
نقر

72
00:05:07,790 --> 00:05:11,620
لا أقول بأنّ جودة ثلج آلة البيع هذه
ممتازة جدّاً

73
00:05:11,620 --> 00:05:14,660
!لكن! هنا تكمن مهارتي

74
00:05:14,660 --> 00:05:17,040
!ثلج ناعم يشبه الثّلج المسحوق

75
00:05:17,040 --> 00:05:20,050
مع كثير من القَطر الطّازج
!المسكوب فوقه

76
00:05:20,790 --> 00:05:24,570
يمكن التّمييز بمُجرّد النّظر إلى
!شكل الثّلج المبشور اللّذيذ هذا

77
00:05:27,840 --> 00:05:29,510
!إنّه بارد وحلو

78
00:05:29,510 --> 00:05:33,530
!الثّلج المنفوش يذوب بسرعة في فمك

79
00:05:33,530 --> 00:05:35,180
!شهيّ

80
00:05:36,400 --> 00:05:38,060
!أجل، أنا واثق من أنّه كذلك

81
00:05:38,060 --> 00:05:41,420
أتمنّى فقط لو كان لديّ أكثر
من ثلاثة أنواع من القَطر

82
00:05:41,420 --> 00:05:42,440
!وجدتُها

83
00:05:43,330 --> 00:05:46,690
!أوّلاً، بعض شرائح التفّاح من آلة بيع تفّاح

84
00:05:46,690 --> 00:05:50,300
التّفّاح وفواكه أُخرى يمكن أن تكون
!زينة فوق الثّلج المبشور

85
00:05:50,300 --> 00:05:53,710
!ها أنا ذا! ثلج مبشور فاخر

86
00:05:55,620 --> 00:05:57,460
هاكّون، ماذا تبيع؟

87
00:05:57,460 --> 00:05:59,580
فواكه وثلج؟

88
00:05:59,580 --> 00:06:01,970
!يبدو هذا لذيذاً

89
00:06:04,930 --> 00:06:08,890
رابطة الصّيّادين تتولّى فاتورة
!كلّ الطّعام والشّراب اليوم

90
00:06:08,890 --> 00:06:11,050
!لذا تناولوا ما تشاؤون

91
00:06:12,940 --> 00:06:16,140
أيّ نوع من الأدوات السّحريّة هو هاكّون؟

92
00:06:16,140 --> 00:06:17,940
إنّه ليس سلاحاً أو درعاً

93
00:06:18,300 --> 00:06:22,560
أعتقد بأنّه سيكون أداة سحريّة توفّر كافّة السّلع

94
00:06:22,560 --> 00:06:24,220
!هذا طويل جدّاً

95
00:06:24,220 --> 00:06:26,960
أليس الأفضل اختصاره بـ
أداة سحريّة مُتعدّدة الأغراض"؟"

96
00:06:27,440 --> 00:06:30,190
آ-ل-يت ب-ا-ع

97
00:06:30,190 --> 00:06:33,210
ماذا؟ "آليت باع"؟

98
00:06:33,210 --> 00:06:34,700
أ-جل، أ-جل

99
00:06:34,700 --> 00:06:37,960
أحاول قول "آلة بيع"، لكن هذا ما يخرج منّي

100
00:06:38,220 --> 00:06:40,720
سيَفي هذا بالغرض حاليّاً

101
00:06:45,200 --> 00:06:46,710
هاكّون

102
00:06:47,210 --> 00:06:51,460
أتعرف ذلك الشّخص الّذي دمّر قريتي؟

103
00:06:51,460 --> 00:06:55,930
قال المُدير دُبّ في اللّيلة الماضية
بأنّه أنزل عليه العقوبة الّتي استحقّها

104
00:06:56,410 --> 00:07:00,800
أشعر وكأنّني لم أعُد أمتلك هدفاً

105
00:07:01,720 --> 00:07:07,010
بوضعها الثّأر هدفاً وحيداً لها، أصبحتْ
صيّادة حتّى في مبتغاها للقوّة

106
00:07:07,010 --> 00:07:09,240
ماذا ينبغي أن أقول لها الآن؟

107
00:07:10,280 --> 00:07:12,110
ا-س-ت-م-ت-ع

108
00:07:13,180 --> 00:07:18,390
أنت و-أنا مـ-ع-ـاً

109
00:07:18,900 --> 00:07:21,700
ها أنا ذا قد أصبحتُ آلة بيع

110
00:07:22,170 --> 00:07:24,080
ليس وكأنّني لا أملك شكاوى

111
00:07:24,080 --> 00:07:29,010
لكن الوقت الّذي قضيتُه مع لاميس
والبقيّة كان ثميناً جدّاً

112
00:07:29,580 --> 00:07:30,460
...ولذا

113
00:07:32,490 --> 00:07:34,480
أجل، معك حقّ

114
00:07:34,480 --> 00:07:37,690
ستكون معي حتّى النّهاية، أليس كذلك؟

115
00:07:37,690 --> 00:07:39,130
أ-جل، أ-جل

116
00:07:39,440 --> 00:07:40,630
!رائع

117
00:07:40,970 --> 00:07:44,290
!ما زالت هناك أمور كثيرة لفعلها

118
00:07:44,290 --> 00:07:45,640
مرحباً بك

119
00:07:47,640 --> 00:07:52,020
هيوليمي وشيميلاي شغّلا دائرة
الانتقال من جديد

120
00:07:52,020 --> 00:07:54,160
!أنتِ مُذهلة يا هيوليمي

121
00:07:54,160 --> 00:07:56,450
لكن لم تعمل بشكل كامل بعد

122
00:07:59,850 --> 00:08:02,790
يمكننا إرسال حوالي ثلاثة أشخاص
كحدّ أقصى فقط

123
00:08:02,790 --> 00:08:08,540
:قرّرتُ بالفعل إلى أين سأرسل الأشخاص
الطّبقة الأصل

124
00:08:08,540 --> 00:08:15,310
لأنّها الطّبقة الوحيدة الّتي تؤدّي
إلى خارج الدّيماس مباشرة

125
00:08:15,310 --> 00:08:19,180
سيجعل ذلك إخلاء السّكّان والحصول
على تعزيزات أسهل

126
00:08:19,180 --> 00:08:21,870
وبخصوص الأشخاص الثّلاثة الّذين سنُرسلهم

127
00:08:21,870 --> 00:08:23,800
أريدكِ أن تكوني أنتِ يا هيوليمي

128
00:08:23,800 --> 00:08:28,310
أجل، لأنّه من دوني، لن يكون هناك
أي ربط عودة إلى دائرة انتقالنا

129
00:08:28,680 --> 00:08:32,110
لاميس وهاكّون، أرغب في الطّلب
منكما بأن تذهبا أيضاً

130
00:08:32,110 --> 00:08:37,760
بقدراته الدّفاعيّة الممتازة وحفظه
للطّعام، ينبغي أن يكون هاكّون نافعاً

131
00:08:37,760 --> 00:08:39,190
بالتّأكيد، حسناً

132
00:08:39,190 --> 00:08:42,940
كنتُ قلقة أيضاً بشأن الجميع في الميتم
وقطيع الوحوش الحمقى

133
00:08:42,940 --> 00:08:44,190
هل أنت راضٍ عن ذلك يا هاكّون؟

134
00:08:44,190 --> 00:08:45,080
أ-جل

135
00:08:45,300 --> 00:08:48,580
،إذا كان بمقدوري تقديم المُساعدة
!فسأشارك بكلّ سرور

136
00:08:48,580 --> 00:08:54,130
وبما أنّ هاكّون غير محسوب من ضمن الأشخاص
المُرسَلين، فيمكننا إضافة شخص آخر

137
00:08:54,130 --> 00:08:55,330
سوف أرافقهم

138
00:08:57,170 --> 00:08:58,690
!ميشيول

139
00:08:58,690 --> 00:09:00,000
ستذهب لأجلنا؟

140
00:09:00,000 --> 00:09:01,610
وأفعل ما يمكنني فعله

141
00:09:01,610 --> 00:09:03,340
!هذا مُطمئن

142
00:09:05,340 --> 00:09:10,810
يمكنني التكلّم معك يا مُعلّم هاكّون
وقليلاً مع لاميس وهيوليمي

143
00:09:10,810 --> 00:09:12,860
ماذا سأفعل لو تركتموني جميعاً؟

144
00:09:12,860 --> 00:09:14,860
هذا ما في الأمر إذاً

145
00:09:15,400 --> 00:09:19,860
أعتذر على إرسالكم في ظلّ هذه
الظّروف، لذا أشرفوا على الأمر رجاء

146
00:09:19,860 --> 00:09:21,240
توخّوا الحذر

147
00:09:22,740 --> 00:09:24,730
!حسناً، لننطلق

148
00:09:29,270 --> 00:09:31,080
آلة البيع اثنان

149
00:09:31,080 --> 00:09:32,000
ماذا؟

150
00:09:37,630 --> 00:09:40,610
هذه آثار أقدام بشر، لا وحوش

151
00:09:40,610 --> 00:09:44,140
لا بدّ أنّهم عادوا أدراجهم عندما
لم يستطيعوا استخدام دائرة الانتقال

152
00:09:46,390 --> 00:09:48,920
!اطعنوا بهذه الرّماح

153
00:09:48,920 --> 00:09:51,400
!لا تتخلّوا عن السِّهام أيضاً

154
00:09:51,400 --> 00:09:53,730
!إن تعبتُم، فدعوا شخصاً يحلّ مكانكم

155
00:09:53,730 --> 00:09:55,020
!لننقضّ

156
00:09:56,400 --> 00:09:58,310
!هجوم الزّئير

157
00:10:01,540 --> 00:10:05,880
الأمور مُبشّرة! والآن أعتقد بأنّ هجوم
اليوم سوف يُوصلنا إلى نتيجة

158
00:10:05,880 --> 00:10:08,930
!يا قائد! جاءت التّعزيزات

159
00:10:08,930 --> 00:10:10,080
!نقدّر هذه المُساعدة

160
00:10:11,240 --> 00:10:15,100
!يا إلهي، أنت مشهد يُسرّ النّاظرين

161
00:10:15,320 --> 00:10:17,840
!يا قوم، الطّعام هنا

162
00:10:17,840 --> 00:10:19,640
!بارد جدّاً! لذيذ جدّاً

163
00:10:19,640 --> 00:10:22,050
مضى أيّام منذ تناولنا طعاماً لذيذاً

164
00:10:22,050 --> 00:10:23,480
!أنا مُمتنّ للغاية

165
00:10:23,480 --> 00:10:26,730
!هذا مُذهل! ستنفد الكمّية خلال قوت قصير

166
00:10:27,110 --> 00:10:29,300
!مهلاً! يمكنني التّفكير في الأمر لاحقاً

167
00:10:37,710 --> 00:10:39,600
أنت مُنقذ حقّاً

168
00:10:39,600 --> 00:10:41,800
كنّا مُنهَكون تماماً

169
00:10:41,800 --> 00:10:45,380
كان الوقت قد حان فعلاً للتّفكير
في أسوأ سيناريوهاتنا

170
00:10:45,600 --> 00:10:47,480
أسوأ السّيناريوهات؟

171
00:10:47,480 --> 00:10:49,630
لا، أفضّل ألّا أعلم

172
00:10:50,300 --> 00:10:53,460
مهما شكرتُك لا أ وفيك حقّك يا رجُلي هاكّون

173
00:10:53,460 --> 00:10:54,900
قا-ئ-د

174
00:10:54,900 --> 00:10:55,620
ماذا؟

175
00:10:55,620 --> 00:10:57,000
د-ر-ج

176
00:10:57,000 --> 00:10:59,560
ماذا؟ الدّرج المُؤدّي إلى السّطح؟

177
00:10:59,560 --> 00:11:00,470
!لحظة، ماذا؟

178
00:11:00,470 --> 00:11:02,450
!هل نجري مُحادثة

179
00:11:02,450 --> 00:11:04,440
!تعلّمت كيفيّة الكلام؟

180
00:11:04,440 --> 00:11:05,140
أ-جل

181
00:11:05,140 --> 00:11:08,000
آسفة، سيترتّب عليّ مُوافاتك
بأحدث المعلومات عن هاكّون لاحقاً

182
00:11:08,000 --> 00:11:11,190
لدى هذه الطّبقة درج مربوط بالسّطح؟

183
00:11:11,190 --> 00:11:13,890
لم تستطيعوا الخروج من الدّيماس؟

184
00:11:13,890 --> 00:11:18,500
لا. الباب الكبير أمام االدّرج
الكبير يرفض أن يتزحزح

185
00:11:18,500 --> 00:11:23,030
كان خيارنا الوحيد هو الحفر هنا وردع العدوّ

186
00:11:23,030 --> 00:11:24,150
هكذا إذاً

187
00:11:27,130 --> 00:11:29,270
...هاكّون

188
00:11:29,270 --> 00:11:31,030
...طعام

189
00:11:31,950 --> 00:11:33,290
!مهلاً يا شوي

190
00:11:39,030 --> 00:11:42,430
لا أحد يملك خبرة في طبقة الأصل

191
00:11:42,430 --> 00:11:46,180
،حتّى ضدّ كلّ أولئك الوحوش الخضراء
تكبّدنا كثيراً من الضّحايا

192
00:11:46,620 --> 00:11:50,900
كانوا ليقعوا في ورطة حقيقيّة
لو تأخّرنا في الوصول يا آكا

193
00:11:50,900 --> 00:11:52,530
هذا صحيح يا شيرو

194
00:11:52,530 --> 00:11:57,680
،وكانت المؤونات قد نفدت تماماً لدينا
لذا كانت مُصيبة لو لم يأتِ هاكّون

195
00:11:58,590 --> 00:11:59,800
كان ذلك رائعاً

196
00:11:59,800 --> 00:12:01,080
أريد المزيد

197
00:12:01,080 --> 00:12:02,720
!شكراً على الطّعام

198
00:12:02,720 --> 00:12:05,480
شوي، ينبغي أن تهدئي

199
00:12:05,480 --> 00:12:07,310
أجل، هذه آداب سلوك سيّئة

200
00:12:07,310 --> 00:12:08,520
آسفة

201
00:12:08,970 --> 00:12:10,820
شكراً لك يا هاكّون

202
00:12:11,520 --> 00:12:15,080
أجل، بالفعل. شكراً لك يا هاكّون

203
00:12:15,080 --> 00:12:15,950
مرحباً بك

204
00:12:15,950 --> 00:12:18,320
يسرّني أنّ الجميع بخير

205
00:12:18,320 --> 00:12:18,890
أجل

206
00:12:18,890 --> 00:12:20,460
أنا أيضاً

207
00:12:20,690 --> 00:12:23,590
يُقال بأنّ مُديرة المدرسة عندما عادتْ
،عبر دائرة الانتقال

208
00:12:23,590 --> 00:12:27,230
دحرَتِ الوحوش بقوّة عنيفة

209
00:12:27,600 --> 00:12:32,120
،والآن، حالما تُشغِّل هيوليمي دائرة الانتقال

210
00:12:32,120 --> 00:12:35,800
يمكننا إخلاء طبقة بُحيرة التّدفُّق النّقيّ

211
00:12:35,800 --> 00:12:37,230
بالتّأكيد، اعتمدوا عليّ

212
00:12:38,850 --> 00:12:41,480
امتلأ بطني أخيراً

213
00:12:41,480 --> 00:12:43,980
هاكّون هو مُنقذي

214
00:12:43,980 --> 00:12:46,500
ماذا يجدر بنا أن نفعل عقب هذا؟

215
00:12:46,500 --> 00:12:48,200
...أجل، بخصوص ذلك

216
00:12:48,200 --> 00:12:50,360
ما رأيكم بهذا التّوقيت؟

217
00:12:50,360 --> 00:12:52,500
!مُديرة طبقة الأصل

218
00:12:52,760 --> 00:12:56,360
مضى وقت طويل أيّتها الأداة
السّحريّة الّتي يدعونها هاكّون

219
00:12:56,360 --> 00:12:58,400
نحن مدينون بخلاصنا لك

220
00:12:58,400 --> 00:13:00,760
أشكرك بالنّيابة عن شعبي

221
00:13:00,760 --> 00:13:04,590
،مُهندسة الأداة السّحريّة هيوليمي
أدع دائرة الانتقال على عاتقكِ

222
00:13:04,590 --> 00:13:06,010
حـ-حسناً

223
00:13:06,510 --> 00:13:09,260
!هذا هو التّوقيت المُناسب! اسمعوني جميعاً

224
00:13:09,540 --> 00:13:12,630
الآن، من غير الحكمة البقاء في هذه الطّبقة

225
00:13:12,630 --> 00:13:14,510
،أعتقد يجدر بنا أن نعطي الأولويّة للبقاء

226
00:13:14,510 --> 00:13:18,260
ونلتجئ بشكل مُؤقّت في طبقة
بُحيرة التّدفّق النّقيّ

227
00:13:18,260 --> 00:13:24,120
لتحقيق ذلك، يجب علينا حماية هذه القرية
ريثما تعمل دائرة الانتقال ثانية

228
00:13:24,120 --> 00:13:26,270
اصبروا فترة أطول فحسب

229
00:13:26,620 --> 00:13:28,910
!سوف نتغلّب على هذا معاً

230
00:13:32,230 --> 00:13:38,830
!مُديرة! مُديرة! مُديرة! مُديرة

231
00:13:35,530 --> 00:13:40,010
يبدو أنّ مُديرة الأصل مشهورة جدّاً بين الرّجال

232
00:13:42,040 --> 00:13:46,090
في اليوم المُوالي، تمّ إرسال فريق بحث
نحو سجن شمال شرق القرية

233
00:13:46,090 --> 00:13:49,250
لرؤية ما إن كان أحد قد التجأ إلى هناك

234
00:13:49,250 --> 00:13:51,610
شاركتُ أنا ولاميس

235
00:13:52,770 --> 00:13:56,240
ما طبيعة الأشرار المُحتجزون هناك؟

236
00:13:56,240 --> 00:14:00,270
يُزَجّ بالمُجرمين العاديّين في زنازين سجون رابطة الصّيادين

237
00:14:00,620 --> 00:14:04,260
لكن الأشخاص المحبوسين هناك
هم قُمامة عديمة الجدوى

238
00:14:04,260 --> 00:14:07,290
مثل القتَلة التّسلسليّين أو أولئك
الّذين يقتلون من باب المتعة

239
00:14:07,290 --> 00:14:08,300
...وأيضاً

240
00:14:08,930 --> 00:14:11,530
ما حالة ذلك المُتدهور المُتطرّف؟

241
00:14:11,530 --> 00:14:15,760
لم يستطع الحدّ من سلوكه، لذا لا يزال محبوساً

242
00:14:15,760 --> 00:14:17,180
أيّ نوع من الأشخاص هو؟

243
00:14:17,180 --> 00:14:18,520
مُنحرف

244
00:14:18,520 --> 00:14:22,880
من طبيعة فريدة جدّاً، مع شكاوى كثيرة
مرفوعة ضدّه من قِبَل رجال ونساء

245
00:14:22,880 --> 00:14:24,540
لكن ما الّذي يفعله بالضّبط؟

246
00:14:24,800 --> 00:14:29,690
إنّه ليس مُجرماً، لكن كان زجّه في ذلك
السّجن فكرته جزئيًّ

247
00:14:29,690 --> 00:14:31,300
فكرته؟

248
00:14:31,540 --> 00:14:34,930
على أيّ حال، غريب الأطوار ذاك
أشبه بصارور

249
00:14:34,930 --> 00:14:37,180
يتطلّب الأمر الكثير لقتله

250
00:14:37,180 --> 00:14:38,490
صارور"؟"

251
00:14:38,490 --> 00:14:40,900
فهمت. لا بدّ أنّ هذا يعني "صرصور" هنا

252
00:14:41,810 --> 00:14:44,430
مهما كانت الحالة، ما زال علينا الذّهاب

253
00:14:51,010 --> 00:14:53,210
اختفى الأسرى؟

254
00:14:53,980 --> 00:14:56,600
الزّنازين كلّها فارغة

255
00:14:56,600 --> 00:14:58,130
ما الّذي يجري هنا؟

256
00:14:58,500 --> 00:15:01,380
هل من أحد هناك؟

257
00:15:01,380 --> 00:15:06,620
هل تقصد بأنّك لا تزال حيّاً أيّها
!الكاهن الفاسد؟

258
00:15:07,030 --> 00:15:09,120
ماذا؟ كاهن؟

259
00:15:09,470 --> 00:15:11,420
لستُ فاسداً

260
00:15:12,970 --> 00:15:15,800
أعيش ببساطة بصدق مع غرائزي

261
00:15:20,500 --> 00:15:22,850
لا حاجة للقلق

262
00:15:22,850 --> 00:15:27,510
أعشق الأحذية المُستعملة سواء
كانت للرّجال أو النّساء

263
00:15:27,510 --> 00:15:32,370
اطمئنّوا. لستُ مهتمّاً بالشّخص
الّذي يرتديها على أيّ حال

264
00:15:32,370 --> 00:15:37,950
كيف تمكّنت من جمع كلّ هذا الكمّ
الكبير وأنت في السّجن؟

265
00:15:37,950 --> 00:15:43,670
يغدو الجوّ أبرد مؤخّراً، لذا كنتُ
أستخدم هذه بدلاً من بطّانية

266
00:15:43,670 --> 00:15:46,120
،كان الوحوش يُسبّبون فوضى

267
00:15:46,120 --> 00:15:50,740
لذا فعلتُها وفتحتُ كافّة الزّنانزين وأطلقتُ
سراح كافّة السّجناء

268
00:15:50,740 --> 00:15:53,880
!هل تعي درجة شرور السُّجناء الّذين كانوا هنا؟

269
00:15:53,880 --> 00:15:56,200
أعلم بكلّ تأكيد

270
00:15:56,200 --> 00:16:00,610
لهذا السّبب سخّرتُ الأوهام والسّحر
لجذب الوحوش عندما فعلتُ ذلك

271
00:16:00,610 --> 00:16:02,960
ارتأيتُ أنّ ذلك قد ينفع المُواطنين

272
00:16:02,960 --> 00:16:04,390
!أنت تُلفّق كلّ هذا

273
00:16:04,390 --> 00:16:07,900
لا، يؤسفني بأنّه لا يكذب

274
00:16:07,900 --> 00:16:13,160
يا إلهي، شوي، صديقتي العزيزة

275
00:16:13,160 --> 00:16:14,660
!لستُ صديقتك

276
00:16:14,660 --> 00:16:18,280
كنتُ أتساءل لماذا لم أعُد أراك
!مؤخّراً. كنتَ هنا

277
00:16:18,280 --> 00:16:19,660
يعرفان بعضهما الآخر؟

278
00:16:19,660 --> 00:16:22,480
مُديرة الأصل، أنا آسفة

279
00:16:22,480 --> 00:16:26,290
يؤسفني بأنّه جزء من قطيع الوحوش الحمقى

280
00:16:26,290 --> 00:16:26,670
ماذا؟

281
00:16:26,670 --> 00:16:27,290
!ماذا؟

282
00:16:29,570 --> 00:16:34,540
إنّه مُعالجنا، وغريب أطوار بارع
في سحر تعديل العقل

283
00:16:34,540 --> 00:16:36,490
لا تُسيئوا الفهم

284
00:16:36,490 --> 00:16:39,710
الأحذية هي مرآة تكشف عن حياة صاحبها

285
00:16:39,710 --> 00:16:44,370
بالنّظر إليها، يمكنني معرفة كلّ شيء
عن ماضيهم وشخصيّتهم

286
00:16:44,370 --> 00:16:47,810
أريد لمس تاريخهم، وأتساءل حول دلالاته

287
00:16:48,090 --> 00:16:50,820
يا له من مُنحرف ثرثار

288
00:16:50,820 --> 00:16:54,450
لهذا لا أستفيد من حذاء جديد كلّياً

289
00:16:54,450 --> 00:16:58,860
أعطوني أحذية مُستعملة جيّداً تروي
!قصّة وتفوح منها رائحة حذاء

290
00:16:58,860 --> 00:17:04,200
تلك الّتي يرتديها الصّيادون بالذّات
!هي ناضجة كي أحصدها

291
00:17:04,200 --> 00:17:08,210
أتفهّم اهتمامك بها، لكن من السيّئ
!سرقة أحذية شخص

292
00:17:08,780 --> 00:17:12,330
السّرقة هي إحدى أسوأ الأفعال الّتي
يمكن للمرء ارتكابها

293
00:17:12,330 --> 00:17:16,210
بصفتي الشّخص الّذي يخدم الإله، لا أستطيع
دفع نفسي لارتكاب خطأ كهذا

294
00:17:16,770 --> 00:17:19,480
هذا ما يجعل هذا الشّخص مُزعجاً

295
00:17:19,480 --> 00:17:23,160
سيستمرّ فحسب في مُضايقة صاحب
،الحذاء الّذي يحوز على إعجابه

296
00:17:23,160 --> 00:17:24,720
حتّى يستسلم ويبيعه

297
00:17:25,090 --> 00:17:27,680
عليّ التعمُّق في تاريخه

298
00:17:27,680 --> 00:17:30,780
بالطّبع، أنا مُستعدّ لتسديد ثمن كبير لقاءه

299
00:17:30,780 --> 00:17:33,610
لا تروقني مسألة أنّ لديه بعض الخصال
الجيّدة على ما يبدو

300
00:17:33,610 --> 00:17:38,610
اسمه هيفي، وهو ماهر بقدر ما هو مُزعج

301
00:17:38,610 --> 00:17:43,120
إنّ 80% من السّمعة السّيّئة لقطيع
الوحوش الحمقى هي بسببه

302
00:17:43,120 --> 00:17:47,200
هيفي، أنت عضو في قطيع الوحوش الحمقى

303
00:17:47,200 --> 00:17:51,260
!ومع ذلك لم تُحاول مُقاومة هجوم ذلك الوحش؟

304
00:17:51,260 --> 00:17:54,330
وضعتُ قاعدة وهي ألّا أقحم رأسي
في شؤون غيري

305
00:17:54,330 --> 00:17:57,250
لا سيّما إذا كان الأمر مُعقّداً

306
00:17:58,760 --> 00:18:01,370
غير أنّني لم أدعهم يموتون فحسب

307
00:18:01,890 --> 00:18:04,230
حان الوقت لإلغاء تعويذتي

308
00:18:05,850 --> 00:18:11,360
بدمج الوهم، والسّحر الّذي يحجب وجود
الشّخص، أعمل على إخفائهم

309
00:18:12,620 --> 00:18:17,280
أردتُ إنقاذ مزيد من النّاس، لكن هذه غلطتي

310
00:18:19,540 --> 00:18:22,700
مُذهل. لم أستطع الشّعور بهم إطلاقاً

311
00:18:23,040 --> 00:18:24,060
هل نحن بأمان الآن؟

312
00:18:24,060 --> 00:18:25,310
أحقّاً ذلك؟

313
00:18:24,820 --> 00:18:25,540
هيفي؟

314
00:18:25,540 --> 00:18:26,500
هل من الآمن الخروج؟

315
00:18:26,500 --> 00:18:27,170
حضرة المُدير

316
00:18:27,170 --> 00:18:28,040
هيفي؟

317
00:18:29,820 --> 00:18:31,950
أنقذت كلّ هؤلاء النّاس؟

318
00:18:39,100 --> 00:18:40,940
أعتذر يا هيفي

319
00:18:41,430 --> 00:18:43,810
تسرّعتُ في الحكم عليك

320
00:18:43,810 --> 00:18:45,170
لا تلقي بالاً للأمر

321
00:18:45,170 --> 00:18:48,310
لكنّني فعلت. وأنا مَدينة لك بالشّكر

322
00:18:48,310 --> 00:18:50,890
من فضلك اقبل اعتذاري، وحدّد مُكافأتك

323
00:18:50,890 --> 00:18:54,180
حسناً، الحذاء الّذي ترتدينه حاليّاً

324
00:18:54,690 --> 00:18:57,710
هذا كثير بالنّسبة لإعادة تقييم

325
00:19:01,190 --> 00:19:03,790
،عندما أعدنا النّاجين إلى القرية

326
00:19:03,790 --> 00:19:06,520
شهِدنا بعض لمّ الشّمل المُبهج هنا وهناك

327
00:19:08,140 --> 00:19:09,080
خذه

328
00:19:09,080 --> 00:19:13,410
أقبل، مع رائحة رطوبة قدميكِ

329
00:19:13,410 --> 00:19:16,100
يمكنني الشّعور بالتّاريخ

330
00:19:18,460 --> 00:19:20,850
لكن من فضلك، اطمئنّي

331
00:19:20,850 --> 00:19:25,100
،أنتِ بحدّ ذاتكِ لستِ نوعي المُفضّل
أريد الحذاء فحسب

332
00:19:26,470 --> 00:19:28,970
أرى بأنّك ما زلت تُعاني من مرض في رأسك

333
00:19:28,970 --> 00:19:34,100
تسرّني عودة مُعالِجنا، لكن
لا يمكنني القول بأنّني مُتحمّس

334
00:19:34,460 --> 00:19:37,270
تفضّلي حذاءكِ يا حضرة المُديرة

335
00:19:37,270 --> 00:19:39,630
لا، لا أستطيع التّراجع عن كلامي

336
00:19:39,630 --> 00:19:40,360
متأكّدة؟

337
00:19:40,360 --> 00:19:42,500
...إذا أعطيتِ هذا الشّخص حذاء

338
00:19:46,110 --> 00:19:47,460
فماذا سيحدث؟

339
00:19:47,460 --> 00:19:50,700
يراودني فضول، لكن من الأفضل ألّا أعرف

340
00:19:50,700 --> 00:19:53,730
لكنّه ممتاز فيما يفعله

341
00:19:53,730 --> 00:19:56,960
هذا صحيح يا آكا. أنقذنا عدّة مرّات

342
00:19:56,960 --> 00:19:59,820
لطالما تحمّلتُما تصرّفات هيفي الغريبة

343
00:19:59,820 --> 00:20:01,810
أجل، فلِمَ لا؟

344
00:20:01,810 --> 00:20:05,970
لكن مضى وقت فعلاً منذ كان قطيع
الوحوش الحمقى هذا معاً

345
00:20:05,970 --> 00:20:07,070
هذا صحيح

346
00:20:07,070 --> 00:20:11,230
جميعكم مرِحون وأحرار، ممّا يُصعّب
عمليّة القيادة

347
00:20:11,230 --> 00:20:14,120
...تحديق

348
00:20:12,240 --> 00:20:15,550
ما نظرات "انظروا من يتكلّم" هذه بالضّبط؟

349
00:20:16,100 --> 00:20:20,710
لدى هيفي أخطاؤه، لكنّه مُفيد
جدّاً في المعركة على ما يبدو

350
00:20:20,710 --> 00:20:23,470
إنّ إضافة مُعالج إلى المجموعة هي أمر جلل

351
00:20:25,010 --> 00:20:28,310
هل لي ببعض الشّاي الدّافئ؟

352
00:20:28,310 --> 00:20:29,240
مرحباً بك

353
00:20:29,950 --> 00:20:33,200
كلّ هذه المُنتجات كانت غير مألوفة بالنّسبة لي

354
00:20:33,200 --> 00:20:35,990
...أعتقد بأنّ لاميس أوصت

355
00:20:40,860 --> 00:20:41,880
لـ-ح-ظ-ـة

356
00:20:41,880 --> 00:20:44,190
ماذا؟ هل هناك مُشكلة ما؟

357
00:20:44,190 --> 00:20:47,060
!هذا واضح بمُجرّد النّظر، هذا حذاء
!وليس كأساً

358
00:20:47,060 --> 00:20:50,960
هل أنت قلق بشأن هذا التّسريب؟

359
00:20:50,960 --> 00:20:54,560
لا تقلق، يوجد كأس في الدّاخل

360
00:20:55,070 --> 00:20:56,330
لقد فهمت

361
00:20:56,330 --> 00:20:57,260
!لا، لم أفهم

362
00:20:57,260 --> 00:21:00,430
بالمناسبة، تمّ ارتداء هذا الحذاء
لاثني عشر عاماً

363
00:21:00,430 --> 00:21:02,720
،كان مالكه الأصليّ صيّادة

364
00:21:02,720 --> 00:21:05,340
والعرق والخبرة واضحتان في هذه الجوهرة النّادرة

365
00:21:05,340 --> 00:21:07,530
نظّفتُها بشكل جيّد بالطّبع

366
00:21:07,530 --> 00:21:09,470
هذا مُطمئن بعض الشّيء

367
00:21:09,470 --> 00:21:13,790
أقصد، أمامك أسبوع فقط على الأكثر
للاستمتاع بالرّائحة

368
00:21:13,790 --> 00:21:15,780
!أترجع عن كلامي! إنّه مُنحرف حقيقيّ

369
00:21:18,620 --> 00:21:20,860
أداة سحريّة ناطقة

370
00:21:20,860 --> 00:21:24,290
حسبما اسمعت، توجد روح بشريّة بداخلك

371
00:21:24,290 --> 00:21:25,270
أ-جل

372
00:21:26,110 --> 00:21:30,110
يبدو أنّك كنت مُثقلاً بقدر سيّئ

373
00:21:30,110 --> 00:21:34,300
لكن ربّما يجدر بك أن تتروّى
تجاه الأمور أكثر من ذلك

374
00:21:36,120 --> 00:21:39,980
أنت مُتوتّر جدّاً وصلب كالصّخر

375
00:21:40,360 --> 00:21:42,300
شكراً لك

376
00:21:42,300 --> 00:21:45,260
كنتُ آمل سماع ضحِك أكثر من كلمة شكر

377
00:21:45,260 --> 00:21:47,750
لا يعيش المرء إلّا مرّة واحدة

378
00:21:47,750 --> 00:21:50,170
افعل الأشياء الّتي تريد فعلها فحسب

379
00:21:50,940 --> 00:21:54,110
وأيضاً من الصّعب معرفة السّبب

380
00:21:54,110 --> 00:21:59,500
لكن أشعر بأنّك تتمتع بنفس الرّوح
المُحبّة للهوايات مثلي

381
00:21:59,500 --> 00:22:01,240
ل-لا ل-س-ت ك-ذ-ل-ك

382
00:22:01,560 --> 00:22:04,730
!سأنكر بصافرة موت

383
00:23:35,010 --> 00:23:37,040
!قد تربح سلعة إضافية

384
00:23:37,920 --> 00:23:40,210
أتطلّع قدماً لاستخدامك التّالي لي