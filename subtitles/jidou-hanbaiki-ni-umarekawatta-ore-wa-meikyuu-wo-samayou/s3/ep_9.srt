1
00:00:01,130 --> 00:00:03,980
من فضلك أدخل قطعة نقديّة معدنيّة

2
00:00:07,850 --> 00:00:12,230
حسناً، كلّ ما بقي فعله هو
انتظار نفسي حتّى أستريح

3
00:00:16,980 --> 00:00:17,930
مهلاً لحظة

4
00:00:17,930 --> 00:00:21,780
لا بُدّ أنّ هذا يعني بأنّ حاكم العالم
السّفلي لا يستطيع رؤيتي، صحيح؟

5
00:00:21,780 --> 00:00:22,500
حسناً إذاً

6
00:00:23,610 --> 00:00:24,850
...أوّلاً

7
00:00:25,490 --> 00:00:28,580
إذاً سأنفق النّقاط الّتي ما زالت لديّ

8
00:00:30,000 --> 00:00:32,400
!وكأنّها جديدة

9
00:00:41,450 --> 00:00:44,290
،تُستخدَم هذه في الدّيوراما

10
00:00:44,290 --> 00:00:47,080
وبحسب معلوماتي، إنّها أصغر
آلات البيع حجماً

11
00:00:59,380 --> 00:01:03,260
آمل أن يجعل هذا الفعلُ الأمرَ
،يبدو وكأنّها دُمِّرَتْ

12
00:01:03,260 --> 00:01:06,090
لكن سأتابع وأموِّه نفسي
بما يتطابق مع الأرض

13
00:01:13,670 --> 00:01:17,430
ما الّذي يريده بالضّبط بدائرة
استدعاء بهذه الضّخامة؟

14
00:01:22,280 --> 00:01:25,460
هل يُعقَل أنّه دمجَ كافّة
!زُعماء الطّبقة معاً؟

15
00:01:25,940 --> 00:01:29,600
!في هذه الحالة، فقوّة ذلك الوحش هائلة

16
00:01:35,130 --> 00:01:38,460
ليست إلّا مسألة وقت قبل انهيار الدّيماس

17
00:01:41,150 --> 00:01:43,990
،بهذا، سأدفن ملك الشّياطين الوقح ذاك

18
00:01:43,990 --> 00:01:46,520
!وأتمكّن من السّيطرة على منطقتي الخاصّة

19
00:01:48,540 --> 00:01:52,640
هكذا تمكّنتُ من العيش تحت
الأرض لأربعة أيّام

20
00:01:53,080 --> 00:01:55,840
منذ ذلك الحين، استخدمتُ التّحريك الذّهنيّ
عن بُعد للتحكُّم بالكتل الخرسانيّة

21
00:01:55,840 --> 00:01:57,770
وبناء مخبأ لنفسي

22
00:01:58,350 --> 00:02:01,170
لا أتحمّل البقاء عالقاً هنا في الأسفل

23
00:02:01,170 --> 00:02:04,860
لكن أنا متأكّد بأنّ لاميس تحاول إنقاذي

24
00:02:05,770 --> 00:02:08,900
لاميس، قطعتِ شوطاً طويلاً حقّاً

25
00:02:08,900 --> 00:02:11,150
،عندما التقينا، قالوا بأنّكِ عديمة الجدوى

26
00:02:11,150 --> 00:02:13,730
ولا صيّاد بعقلٍ سليم كان
ليُشكّل فريقاً معكِ

27
00:02:13,730 --> 00:02:16,110
تخلّوا عنكِ آنذاك، أليس كذلك؟

28
00:02:17,060 --> 00:02:19,350
والآن، أنتِ صيّادةٌ مشهورة

29
00:02:19,350 --> 00:02:22,640
لا أحد من طبقة بُحيرة التدفُّق النّقيّ
لم يسمع بكِ

30
00:02:23,000 --> 00:02:25,210
هذا لأنّني كنتُ خلفها أُراقب
هذا طوال الوقت

31
00:02:25,210 --> 00:02:27,360
وجدتُ تطوُّرَها مُؤثِّراً جدّاً

32
00:02:27,930 --> 00:02:31,310
وقالت لي بأنّنا سنكون معاً للأبد

33
00:02:31,950 --> 00:02:33,450
،حالما تنتهي كلّ هذه الفوضى الحاليّة

34
00:02:33,450 --> 00:02:37,400
ستُساعدني حتماً في غزو ديماس
وذلك كي أعود بشريّاً من جديد

35
00:02:38,240 --> 00:02:42,450
،يبدو أنّ باقي المجموعة ستأتي أيضاً
لذا سأتطلّع قُدماً لذلك

36
00:02:42,450 --> 00:02:44,950
ليس لديّ ما أشتكي منه

37
00:02:44,950 --> 00:02:48,080
إذا استطعتُ المُغامرة ثانية مع تلك
المجموعة المُشاغبة والمُؤتمنة

38
00:02:48,940 --> 00:02:53,450
حسناً، حان وقت فعل المعتاد، وأُكافح
!ضمن حدود آلة البيع

39
00:02:53,450 --> 00:02:57,000
مرحباً بك. مرحباً بك. مرحباً بك

40
00:02:57,000 --> 00:03:01,450
.مرحباً بك. مرحباً بك
مرحباً بك. مرحباً بك

41
00:03:01,450 --> 00:03:04,810
مرحباً بك. مرحباً بك

42
00:03:04,810 --> 00:03:06,510
!هاكّون

43
00:03:14,950 --> 00:03:16,810
من الخارج، صندوق فولاذيّ مُستطيل

44
00:03:16,810 --> 00:03:18,890
!ويوجد بداخله روح بشريّ

45
00:03:18,890 --> 00:03:24,600
في عالم من الأعاجيب، أركب
على ظهر شريكتي لاميس

46
00:03:24,600 --> 00:03:27,040
!أنا هاكّون! مرحباً بك

47
00:03:27,040 --> 00:03:28,780
"!هذا يعني "أجل

48
00:04:50,650 --> 00:04:54,370
مرحباً بك. مرحباً بك. مرحباً بك

49
00:04:52,310 --> 00:04:54,370
!هاكّون

50
00:04:54,370 --> 00:04:55,520
...هل كان ذلك

51
00:04:56,040 --> 00:05:00,480
!هاكّون! أنا قادمة

52
00:05:00,480 --> 00:05:01,990
!إنّها لاميس

53
00:05:01,990 --> 00:05:03,780
!هاكّون

54
00:05:03,780 --> 00:05:05,000
مرحباً بك

55
00:05:05,000 --> 00:05:10,490
!هاكّون! سأُخرجك في أسرع وقت
!اصمد فحسب

56
00:05:13,570 --> 00:05:15,240
!هـ-هاكّون

57
00:05:15,240 --> 00:05:17,310
!هاكّون، أهلاً بعودتك

58
00:05:16,420 --> 00:05:20,120
!أقلقتَنا جميعاً، فأراك بخير في الأسفل هنا

59
00:05:24,160 --> 00:05:25,840
!إنّه هاكّون

60
00:05:25,840 --> 00:05:28,230
!لم تتحطّم، صحيح؟! أنت بخير، صحيح؟

61
00:05:28,230 --> 00:05:32,350
!كنتُ قلقة للغاية عليك

62
00:05:30,630 --> 00:05:35,020
أنت تُبالغ في التصرُّف في كلّ
مرّة. أتعلم ذلك؟

63
00:05:35,020 --> 00:05:35,900
أ-جل

64
00:05:37,260 --> 00:05:38,440
وصلنا إلى هنا مُتأخّرين

65
00:05:38,440 --> 00:05:39,900
هل أنت بخير يا هاكّون؟

66
00:05:39,900 --> 00:05:42,280
ما زال بإمكانك توزيع الطّعام، صحيح؟

67
00:05:42,280 --> 00:05:45,150
تمّ التّنقيب عن هاكّون؟

68
00:05:46,030 --> 00:05:49,520
لم أُشكّك بأنّك ستخرج من هذا
!سليماً يا صاح

69
00:05:49,520 --> 00:05:50,710
!ولا حتّى ظلّ من الشكّ

70
00:05:51,320 --> 00:05:54,440
لم يكن ذلك مُضحكاً يا حضرة المُدير ظلام

71
00:05:54,440 --> 00:05:56,910
هاكّون، تسرّني رؤيتك سالماً

72
00:05:57,160 --> 00:05:59,230
أرى بأنّ المُدراء بأمان

73
00:05:59,230 --> 00:06:01,160
رغم أنّني لا أرى المُدير دُبّ

74
00:06:01,160 --> 00:06:03,660
أ-ي-ن ال-با-ق-ي؟

75
00:06:03,660 --> 00:06:05,910
الجميع بخير أيضاً

76
00:06:05,910 --> 00:06:09,680
المُدير دُبّ وزملاؤنا الآخرون
يُطاردون قطيعَ الوحوش

77
00:06:09,680 --> 00:06:12,930
،الآن بعد أن عرفتُ بأنّ الجميع بأمان
هذا يُبدّد مخاوفي

78
00:06:12,930 --> 00:06:14,890
!حان وقت البدء ببيع الأشياء

79
00:06:17,170 --> 00:06:21,060
بدمار البلدة، ستكون هناك
الكثير من طلبات الطّعام

80
00:06:21,060 --> 00:06:23,180
!سأُقيم وليمة فاخرة للجميع

81
00:06:23,180 --> 00:06:24,600
مرحباً بك

82
00:06:24,600 --> 00:06:28,200
هناك كثير من الطّعام، لذا
!التزموا بالطّابور رجاء

83
00:06:28,200 --> 00:06:31,230
!مهلاً، الأولويّة للأطفال وكبار السنّ

84
00:06:31,230 --> 00:06:33,070
!ممنوع مُقاطعة الطّابور

85
00:06:33,070 --> 00:06:35,550
مرحباً بك. تفضّل

86
00:06:35,550 --> 00:06:38,790
!ستُحبّون هذه الأشياء! إنّها لذيذة

87
00:06:42,050 --> 00:06:46,660
في النّهاية، استمررتُ في توزيع
السّلع حتّى حان الصّباح

88
00:06:47,390 --> 00:06:51,130
بهذه الكمّية يا هاكّون، سنكون
بخير لمدّة من الزّمن

89
00:06:51,130 --> 00:06:52,480
شكراً لعملك

90
00:06:52,480 --> 00:06:55,350
والآن يمكننا اللّحاق بالآخرين دون قلق

91
00:06:55,350 --> 00:06:56,770
نـ-غا-د-ر قـ-ري-باً؟

92
00:06:57,340 --> 00:07:01,540
قالوا بأنّ عائلة القائد كيريويل
لَحِقَتْ بقطيع الوحوش

93
00:07:01,540 --> 00:07:04,710
بينما المُدير دُبّ والحُرّاس وهيفي وميشويل

94
00:07:04,710 --> 00:07:08,400
يحاولون توجيه الوحوش نحو المدينة المُحصَّنة

95
00:07:08,720 --> 00:07:12,830
ألا تحتاج لقسط من الرّاحة يا هاكّون؟

96
00:07:13,740 --> 00:07:15,270
معها حقّ

97
00:07:15,270 --> 00:07:18,300
يجب عليك أن... تأخذ استراحة

98
00:07:19,620 --> 00:07:21,420
!قريبة جدّاً يا بيتي

99
00:07:21,420 --> 00:07:25,120
ليستا مُخطئتين. ألا ينبغي أن ترتاح؟

100
00:07:25,120 --> 00:07:27,130
لا، أ-نا بـ-خي-ر

101
00:07:27,130 --> 00:07:30,160
جميعهن الأربعة سهرنَ معي اللّيلَ كُلّه

102
00:07:30,160 --> 00:07:32,480
لا أريد أخذ استراحة الآن

103
00:07:32,480 --> 00:07:35,010
توقّعتُ أن تؤول الأمور إلى هذا

104
00:07:47,390 --> 00:07:50,420
النّهوض باكراً وأنت بهذا السنّ
الكبير له إيجابيّاته

105
00:07:50,420 --> 00:07:53,240
الشّيخوخة ليست بذلك السّوء

106
00:07:53,240 --> 00:07:54,850
كما تقولين

107
00:07:57,020 --> 00:07:59,050
الثّلاثة جميعهم مُدجّجون بالأسلحة

108
00:07:59,050 --> 00:08:00,790
يريدون مُرافقتنا حتماً

109
00:08:01,100 --> 00:08:03,010
!يمكنكم أن تحسبوا حِسابي

110
00:08:03,010 --> 00:08:04,800
!سأذهب أيضاً

111
00:08:04,800 --> 00:08:07,260
أظنّهما قادمين أيضاً

112
00:08:08,110 --> 00:08:10,080
أنا نعسان جدّاً

113
00:08:09,300 --> 00:08:13,990
تمالك نفسك يا حضرة المُدير جبل
الدُّبّ، أنت أمام النّاس

114
00:08:13,990 --> 00:08:15,580
...بئس الأمر

115
00:08:15,580 --> 00:08:19,060
سنبقى هنا ونعمل على إعادة إعمار البلدة

116
00:08:19,060 --> 00:08:24,070
إذا بقيتْ مجموعتُهم هنا، لن نحتاج
!للقلق بشأن المكان

117
00:08:26,070 --> 00:08:30,060
أستُغادر المكان يا هاكّون؟
سوف نفتقدك

118
00:08:30,060 --> 00:08:32,360
لامي، بالتّوفيق لكِ هناك

119
00:08:32,360 --> 00:08:34,040
!اذهبي وأطلقي عنان قِواكِ

120
00:08:34,040 --> 00:08:36,080
شكراً. إ-لى الل-قاء

121
00:08:36,520 --> 00:08:38,950
هل أنتم جاهزون للانطلاق؟

122
00:08:38,950 --> 00:08:40,150
!أجل

123
00:08:45,010 --> 00:08:48,660
من قد تكون يا من تختبئ هناك؟

124
00:08:50,070 --> 00:08:53,680
يا للعجب! شعرتِ بي، أليس كذلك؟

125
00:08:56,290 --> 00:08:58,330
كيف حالكم جميعاً؟

126
00:08:58,330 --> 00:09:02,320
أعتذر على كلّ المتاعب الّتي
سبّبَها ابني لكم

127
00:09:04,540 --> 00:09:05,940
من أنت؟

128
00:09:05,940 --> 00:09:08,190
ومن يكون ابنك؟

129
00:09:09,770 --> 00:09:13,680
ريبي يُسبّب أذى كهذا. يا له من شقيّ

130
00:09:13,680 --> 00:09:17,700
المعذرة، من هو ريبي هذا؟

131
00:09:17,700 --> 00:09:20,640
كان صبيّاً مُؤدّباً وهادئاً

132
00:09:20,640 --> 00:09:24,050
كيف آلت الأمور إلى ما هو عليه الآن

133
00:09:24,510 --> 00:09:29,330
أجل، يستخدم ريبي اسماً مُختلفاً
في هذه الأيّام

134
00:09:29,330 --> 00:09:33,450
أعتقد رُبّما كان... "حاكم العالم السُّفليّ"؟

135
00:09:35,710 --> 00:09:39,210
ظهرتْ أمُّه؟ لم يكن هذا مُتوقَّعاً

136
00:09:46,680 --> 00:09:52,620
من كان يتوقّع أن يجري تجربة على أُمّه
للحصول على هذا الجسد العظميّ؟

137
00:09:54,950 --> 00:09:58,010
منذ ذلك الحين، وهو يرفض أن أدعني أموت

138
00:09:58,010 --> 00:09:59,950
أليس هذا تصرُّفاً قاسياً؟

139
00:09:59,950 --> 00:10:04,530
اختبرَ فنَّه الظّلاميّ على أمّه
!ليرى ما إن كان سينجح

140
00:10:05,690 --> 00:10:07,120
تبّاً لك يا حاكم العالم السُّفليّ

141
00:10:07,120 --> 00:10:11,210
كنتُ أعي تماماً بأنّك وضيع، لكن
!وضعك الآن ميؤوس منه

142
00:10:11,210 --> 00:10:15,620
لكنّني أُمّه، لذا سامحتُه على كلّ شيء

143
00:10:15,620 --> 00:10:20,730
الآن بعد أن صرتُ جِنرال الإبهام، سأتكفّل
!بأيّ شخص يعترض طريق ابني

144
00:10:20,730 --> 00:10:22,210
!يا لي من أُمّ رائعة

145
00:10:22,210 --> 00:10:25,370
هل هذا يعني بأنّكِ هنا لأجلنا؟

146
00:10:26,590 --> 00:10:30,850
!الحُبّ غير المشروط هو ما تتميّز به الأُمّ

147
00:10:32,850 --> 00:10:35,630
بغضّ النّظر، هذه مشاعر فيّاضة

148
00:10:35,630 --> 00:10:37,950
!لكن إذا كنتِ ستُساعدينه، فأنتِ مُذنبة مثله

149
00:10:38,350 --> 00:10:41,120
أنتِ أمٌّ حمقاء

150
00:10:41,120 --> 00:10:45,250
،إذا اختار الابن الطّريقَ الخطأ
!فمن واجب الأُمّ تقويمه

151
00:10:45,250 --> 00:10:49,110
!خلطتِ بين الحُبّ والدّلال فحسب

152
00:10:49,350 --> 00:10:52,980
إذاً جميعكم تُدينونني؟

153
00:10:52,980 --> 00:10:56,160
!لكنّني أُمّ حنونة

154
00:10:56,160 --> 00:10:59,690
أعتقد بأنّ الجميع في العالم يجب
!أن يموتوا باستثنائي أنا وريبي

155
00:11:00,130 --> 00:11:02,560
الابن كأُمّه

156
00:11:02,560 --> 00:11:05,290
لا جدوى من التّعاطف مع جِنرال
الإبهام أكثر من ذلك

157
00:11:05,840 --> 00:11:08,390
!إلى غير المُقاتلين، تراجعوا معي

158
00:11:14,560 --> 00:11:16,690
!جميعكم، موتوا

159
00:11:25,010 --> 00:11:27,320
!لن ندعكِ تفعلين ما يحلو لكِ

160
00:11:31,200 --> 00:11:33,710
جميعكم تتكاثرون عليّ

161
00:11:33,710 --> 00:11:35,550
يا له من سلوك لا يُغتفَر

162
00:11:35,550 --> 00:11:37,600
!جون! حان وقت الطّعام

163
00:11:39,710 --> 00:11:42,790
يُشبه هذا دائرة الاستدعاء الّتي
استخدمَها حاكمُ العالم السُّفليّ

164
00:11:42,790 --> 00:11:44,960
!يمكنني تخمين ما هو قادم

165
00:11:45,230 --> 00:11:49,620
أعتقد بأنّ هذا شكل من أشكال
سحر الاستدعاء. نحن في ورطة

166
00:11:49,620 --> 00:11:52,490
هل الأمر بذلك السُّوء يا عجوز؟

167
00:11:52,490 --> 00:11:55,860
أجل، هذه المانا غريبة جدّاً

168
00:11:55,860 --> 00:11:58,220
!قد تكون وحشاً من عالم آخر

169
00:11:58,220 --> 00:11:59,730
وحش من عالم آخر؟

170
00:12:00,940 --> 00:12:03,490
!ما-ما-ما هذا؟

171
00:12:03,490 --> 00:12:06,700
رأيتُ ما يكفيني من وحوش مُختلف

172
00:12:07,350 --> 00:12:09,560
!لكن هذا الشّيء غريب الأطوار

173
00:12:10,390 --> 00:12:13,380
!هاكّون

174
00:12:11,350 --> 00:12:12,290
هاكّون

175
00:12:27,470 --> 00:12:29,560
تراجعوا أنتم

176
00:12:29,560 --> 00:12:31,800
دعوه لنا

177
00:12:31,800 --> 00:12:35,700
حالما تبلغون سنّنا، لن يُخيفكم شيء بعدها

178
00:12:35,700 --> 00:12:39,060
أنتما تُخيفانني إلى يومنا هذا

179
00:12:39,060 --> 00:12:41,900
يغدو الأمر بغيضاً عندما تغضبان

180
00:12:41,900 --> 00:12:43,830
!يا له من تحوُّل حماسيّ للأحداث

181
00:12:43,830 --> 00:12:46,520
!قوى العدالة، تقف في وجه الشّرّ

182
00:12:46,520 --> 00:12:48,570
!هذا رائع

183
00:12:57,700 --> 00:12:58,750
ابتعدوا

184
00:13:00,350 --> 00:13:02,410
من الأفضل توخّي الحذر

185
00:13:02,410 --> 00:13:05,330
!يبدو أنّها تنفجر عند مُلامستك

186
00:13:11,340 --> 00:13:12,630
ماذا حدث للتو؟

187
00:13:12,630 --> 00:13:16,290
،إذا تحوّلتْ هذه إلى حرب استنزاف
فسيترتّب علينا القلق بشأن اللّياقة

188
00:13:16,290 --> 00:13:19,780
...ليتني أستطيع صرف انتباه خصمنا قليلاً

189
00:13:20,050 --> 00:13:21,990
!لحظة، عرفتُ ما يجب استخدامه

190
00:13:29,360 --> 00:13:31,980
سـ-وف أُش-ع-ل-ها

191
00:13:39,380 --> 00:13:40,760
أ-لع-اب نا-ر-ية

192
00:13:41,580 --> 00:13:42,820
!مُذهل

193
00:13:42,820 --> 00:13:44,250
!ما أجملها

194
00:13:44,560 --> 00:13:48,770
لا بُدّ أنّ الألعاب النّاريّة تُدهش أيّ شخص
لم يرها من قبل

195
00:13:49,370 --> 00:13:52,320
،ذلك الوحش الشّنيع لا يتحرّك قيد أُنملة

196
00:13:52,320 --> 00:13:54,960
لكن وجهه مُصوَّب مُباشرة بعيداً
عن الألعاب النّاريّة

197
00:13:54,960 --> 00:13:56,260
...ما يعني

198
00:13:56,260 --> 00:14:01,260
كنتُ على حقّ. إنّها جِنرال الإبهام
مَن يتحكّم بها

199
00:14:01,910 --> 00:14:03,770
جميل

200
00:14:03,770 --> 00:14:04,930
لا-ي-س

201
00:14:04,930 --> 00:14:06,770
ماذا؟ ما الأمر يا هاكّون؟

202
00:14:07,560 --> 00:14:09,190
ا-ر-مي

203
00:14:09,190 --> 00:14:11,450
،أجل، الآن بعد أن أصبحتُ برتبة 3

204
00:14:14,850 --> 00:14:17,050
يُفترض أن أرمي هذه؟

205
00:14:17,050 --> 00:14:18,220
مرحباً بك

206
00:14:18,220 --> 00:14:19,460
على جِنرال الإبهام؟

207
00:14:19,460 --> 00:14:20,280
أ-جل

208
00:14:20,620 --> 00:14:22,450
حسناً، ها أنا ذي

209
00:14:28,570 --> 00:14:32,970
تحوّلتُ إلى آلة بيع صناديق كرتونيّة
!قُبيل أن ترمي فحسب

210
00:14:32,970 --> 00:14:35,590
على هذا المُعدّل، هذه لن تمسّ
جِنرال الإبهام حتّى

211
00:14:35,590 --> 00:14:39,140
!لكن وضعتُ تصويب لاميس الضّعيف في الحُسبان

212
00:14:41,850 --> 00:14:43,520
!ماذا؟! هاكّون؟

213
00:14:52,900 --> 00:14:57,410
جميل جدّاً. أتمنّى مُشاهدتهم مع ريبي

214
00:15:04,920 --> 00:15:08,160
،أودّ الاحتفال بهزيمتنا لجِنرال الإبهام

215
00:15:08,160 --> 00:15:10,920
لكن سيعني ذلك أن أسقط في الأرض

216
00:15:10,920 --> 00:15:13,250
!لكن وضعتُ ذلك في الحسبان أيضاً

217
00:15:19,430 --> 00:15:21,760
ينبغي أن أكون بأمان الآن

218
00:15:21,760 --> 00:15:24,810
ماذا؟ ما هذا الإحساس بالعَوم؟

219
00:15:24,810 --> 00:15:27,560
قمتَ بعمل جنونيّ ثانية

220
00:15:28,230 --> 00:15:29,660
آ-س-ف

221
00:15:29,660 --> 00:15:32,830
إيّاك والاعتقاد بأنّك تستطيع
!الإفلات بكونك ظريفاً

222
00:15:32,830 --> 00:15:35,830
!ماذا عن الوحش الشّنيع؟

223
00:15:39,580 --> 00:15:44,090
بعد فقدان مُستدعيه، يعود
الوحش إلى عالمه الأصليّ

224
00:15:44,090 --> 00:15:45,970
حالة مُماثلة تماماً

225
00:15:46,280 --> 00:15:50,960
.تمّ الاهتمام بذلك... ليس بالأمر الجلل
لم نبدأ حتّى

226
00:15:50,960 --> 00:15:53,210
علينا أن نُسرع ونلحق بزملائنا

227
00:15:57,270 --> 00:15:59,680
،أجل! هذه آلة بيع مركبات

228
00:15:59,680 --> 00:16:02,510
مشهورة بين مُدمني آلة البيع

229
00:16:02,510 --> 00:16:06,560
أولئك الّذين يرونه للمرّة الأولى لا بُدّ
أنّهم يعتقدونه بناء رائجاً ما

230
00:16:06,560 --> 00:16:09,720
هاكّون، هل ستمنحنا سائرة أُخرى؟

231
00:16:10,010 --> 00:16:12,220
،هذه المرّة، هناك كثير من النّاس

232
00:16:12,220 --> 00:16:14,920
والأرضيّة ليست مُسطّحة كما
في طبقة الأبديّة

233
00:16:14,920 --> 00:16:17,710
إنّه وعر، ويجب عليّ أخذ هذا بعين الاعتبار

234
00:16:18,230 --> 00:16:21,530
!أجل، وهذا يعني شاحنة نقل

235
00:16:26,750 --> 00:16:29,340
إنّها بشكل مُختلف، لكن هل هي سائرة؟

236
00:16:29,340 --> 00:16:33,260
هكذا يبدو، لكنّها أضخم بكثير من السّابقة

237
00:16:33,260 --> 00:16:34,510
!رائع

238
00:16:38,960 --> 00:16:43,270
كثير من الطّرُق غير مُستوية، لذا كنتُ
مُحقّاً في اختيار هذه المركبة

239
00:16:43,270 --> 00:16:46,270
،وهناك مساحة كافية في السّرير
حتّى بوجودي هناك

240
00:16:46,270 --> 00:16:49,770
حتّى الحجم القياسيّ كبير
!عندما تكون صِناعة أجنبيّة

241
00:16:49,770 --> 00:16:51,890
!القيادة مُمتعة للغاية

242
00:16:51,890 --> 00:16:53,290
!سأسرع أكثر قليلاً

243
00:16:53,670 --> 00:16:57,020
هذه قيادة جيّدة، لكن حان وقت الغداء

244
00:16:57,020 --> 00:16:59,540
ماذا ينبغي أن أُقدّم للجميع يا تُرى؟

245
00:16:59,890 --> 00:17:02,050
!خطرتْ على بالي فكرة

246
00:17:07,630 --> 00:17:09,790
ما يكون هذا؟

247
00:17:09,790 --> 00:17:12,670
!هذا صحيح، أنا آلة بيع بيتزا

248
00:17:12,670 --> 00:17:17,300
،تُخبَز فوراً مع الزّينة الّتي فوقها
!إنّه نموذج إيطاليّ حقيقيّ

249
00:17:17,650 --> 00:17:19,800
!تبدو لذيذة

250
00:17:20,680 --> 00:17:22,680
!هذا جيّد

251
00:17:22,680 --> 00:17:24,580
!ما هذه الأشياء؟

252
00:17:24,580 --> 00:17:26,680
!إذا شددتها، فإنّها تمتدّ

253
00:17:26,680 --> 00:17:29,680
كانت مشهورة جدّاً، لدرجة
أكملوها بلمح البصر

254
00:17:29,680 --> 00:17:32,490
هيّا، ألم تجهز الأطباق الثّانية بعد؟

255
00:17:32,490 --> 00:17:35,700
أجل، اهدئي قليلاً. لن يرحل الغداء

256
00:17:35,700 --> 00:17:39,120
الجميع يُحبّون أكل هذه البيتزا السّاخنة جدّاً

257
00:17:40,060 --> 00:17:42,320
ماذا؟ ليس لديهم شهيّة مفتوحة

258
00:17:42,560 --> 00:17:46,340
فهمت، البيتزا ثقيلة جدّاً
على معدتهم الكهلة

259
00:17:49,400 --> 00:17:52,620
شكراً على تكبُّد عناء لأجلنا

260
00:17:52,620 --> 00:17:55,560
مذاقها لذيذ، لكنّها غنيّة قليلاً

261
00:17:55,560 --> 00:17:57,220
شكراً يا هاكّون

262
00:17:57,220 --> 00:17:59,630
لكن ماذا نفعل بالبقايا؟

263
00:17:59,630 --> 00:18:00,720
لا داعي للقلق

264
00:18:00,720 --> 00:18:03,220
شوي، إنّها لك إذا أردت

265
00:18:03,220 --> 00:18:05,720
!هل أنتِ جادّة يا حضرة المُديرة؟! سآخذها

266
00:18:05,720 --> 00:18:08,980
شوي، شهيّتك مفتوحة كعادتكِ

267
00:18:08,980 --> 00:18:13,300
من باب الحيطة، سأوفّر لها الكثير من البرغر
والدّجاج المقليّ قبل أن نشدّ الرّحال

268
00:18:16,230 --> 00:18:18,980
هاكّون، أريد إحدى تلك المشروبات الفوّارة

269
00:18:20,370 --> 00:18:24,500
لكن كيف سنتعامل مع حاكم العالم السُّفليّ؟

270
00:18:24,500 --> 00:18:26,410
،قِواه السّحريّة الواسعة مُزعجة

271
00:18:26,410 --> 00:18:29,330
لكن مع كلّ هذه النّقاط، أستطيع
—استخدام حاجزي للتصدّي

272
00:18:29,330 --> 00:18:32,580
هاكّون، أنا جائعة قليلاً. زوّدني

273
00:18:34,350 --> 00:18:36,950
ثمّ الهجوم عندما يجوع

274
00:18:36,950 --> 00:18:37,990
!أقصد، لا

275
00:18:37,990 --> 00:18:41,990
من بين جِنرالات الأصابع، هزمتُ جِنرال
الإبهام وجِنرال الإصبع الوسطى

276
00:18:41,990 --> 00:18:45,070
جِنرال البنصر سوليم انضمّتْ لنا

277
00:18:45,070 --> 00:18:46,340
—بقي

278
00:18:45,530 --> 00:18:48,350
هاكّون، هل لي بالمزيد؟

279
00:18:49,860 --> 00:18:52,410
لكن جِنرال الخبز الحلو ذي
...السّعرات الحراريّة العالية

280
00:18:52,410 --> 00:18:55,790
أقصد، الجِنرالان الآخران سيكونان مُزعجين

281
00:18:55,790 --> 00:18:59,110
جِنرال الخنصر قد هربت، ولا أحد
—يعلم أين جِنرال السّبّابة

282
00:18:59,110 --> 00:19:02,730
هاكّون، أنا عطشانة. أريد شيئاً حُلواً للشّرب

283
00:19:02,730 --> 00:19:05,560
على ذكر الحلاوة، هناك جِنرال العصير

284
00:19:05,560 --> 00:19:07,410
!هلّا توقّفت عن ذلك يا شوي؟

285
00:19:07,410 --> 00:19:10,740
أرغب في الطّلب من هيوليمي أن تُشرّح
!لك معدتك ونرى آليّة عملها

286
00:19:10,740 --> 00:19:13,000
هاكّون، أريدها حالاً

287
00:19:13,000 --> 00:19:18,260
،أشعر بأنّها تُكثر من السكّر
لذا سأعطيها شراباً خالياً من الحُريرات

288
00:19:19,130 --> 00:19:22,520
ماذا؟ هل من شيء غريب
في حلاوة هذه؟

289
00:19:22,520 --> 00:19:24,260
أقصد بأنّ مذاقه لا يزال لذيذاً

290
00:19:24,520 --> 00:19:28,330
لا تأكل شوي بشراهة فحسب، بل
حسّها الذّوقيّ مُتقدِّم بشكل مُفاجئ

291
00:19:28,330 --> 00:19:30,020
هذه مُشكلة لا أتمنّاها

292
00:19:30,020 --> 00:19:33,350
أنت لا تُفكّر في شيء وقح، أليس كذلك؟

293
00:19:33,350 --> 00:19:34,780
ت-زدا-دين و-ز-ناً

294
00:19:35,010 --> 00:19:36,430
أزداد وزناً؟

295
00:19:36,430 --> 00:19:38,500
!عـ-عمّاذا تتكلّم؟

296
00:19:38,500 --> 00:19:40,520
!أتمرّن كثيراً! لا مُشكلة

297
00:19:40,520 --> 00:19:44,280
!هاكّون! لا تُعلّق على وزن فتاة! هذا سيّئ

298
00:19:44,280 --> 00:19:45,840
مرحباً بك

299
00:19:46,460 --> 00:19:50,820
كانت رحلة الطّريق سلِسة ولم تقع حوادث

300
00:19:50,820 --> 00:19:52,550
مضتْ بضعة أيّام

301
00:19:52,550 --> 00:19:55,000
هذا الشّيء مُفيد حقّاً

302
00:19:55,000 --> 00:19:58,170
يمنحك رؤية واضحة للأشياء البعيدة

303
00:19:58,170 --> 00:20:00,910
أهمّ شيء هو أن نستمتع به

304
00:20:02,170 --> 00:20:03,740
!يا عجوز! يا عجوز

305
00:20:03,740 --> 00:20:06,190
أسمعك، لا حاجة للصُّراخ

306
00:20:06,190 --> 00:20:09,380
هناك أشخاص أمامنا يُقاتلون وحوشاً

307
00:20:09,380 --> 00:20:11,800
ماذا؟! دعيني ألقي نظرة

308
00:20:12,450 --> 00:20:14,070
هذا سيّئ

309
00:20:14,070 --> 00:20:17,240
.هناك الكثير جدّاً من الأعداء
من الواضح بأنّهم يفوقونهم عدداً

310
00:20:17,240 --> 00:20:20,190
،إذا كانوا يُقاتلون الوحوش هنا
...فهل هذا يعني

311
00:20:20,190 --> 00:20:21,630
!هيوليمي، إلى اليمين

312
00:20:21,630 --> 00:20:23,180
!هل يمكنك الإسراع قليلاً؟

313
00:20:23,940 --> 00:20:26,500
!أستطيع فعل ذلك

314
00:20:28,710 --> 00:20:31,960
هذا فظيع! حاصرَتْهم الوحوش

315
00:20:31,960 --> 00:20:36,020
،بتكتّلهم بمُتقاربين هكذا معاً
!فإنّ هجمة سحريّة ستكون خطيرة جدّاً

316
00:20:36,020 --> 00:20:37,830
أعتقد سنحرق الوسط أيضاً

317
00:20:38,050 --> 00:20:41,500
شيميلاي العجوز والمُدير حارِق ميؤوس منهما

318
00:20:41,500 --> 00:20:44,220
كان ينبغي أن أطلب من هيوليمي
—الذّهاب والبحث عن مكانٍ ما آمن كي

319
00:20:44,220 --> 00:20:46,100
!تمسّكوا بشيء جميعاً

320
00:20:46,470 --> 00:20:48,470
!ابتعدوا! ابتعدوا

321
00:20:48,470 --> 00:20:50,270
!ابتعدوا عن طريقي

322
00:20:51,720 --> 00:20:53,600
!توقّعت. إنّها مجموعة القائد

323
00:20:53,600 --> 00:20:56,090
!اخترتَ الوقت المُناسب للظّهور يا هاكّون

324
00:20:56,090 --> 00:20:59,490
حسناً، أدخلوا الجرحى إلى داخل
!تلك الجدران الزّرقاء

325
00:20:59,490 --> 00:21:02,530
!أولئك المُقتدرون، احملوا من لا يستطيع الحركة

326
00:21:02,530 --> 00:21:04,220
!إنّهم في صفّنا، لا تقلقوا

327
00:21:04,220 --> 00:21:05,980
!هاكّون، احمِ هؤلاء

328
00:21:05,980 --> 00:21:08,790
لا تقلق، سأُعالجك

329
00:21:08,790 --> 00:21:09,940
شكراً لكِ

330
00:21:09,940 --> 00:21:11,740
كاي، كوُن حذراً

331
00:21:11,740 --> 00:21:13,460
أجل. أنتِ أيضاً يا أختي الكبرى

332
00:21:14,630 --> 00:21:16,210
!أنا أشتعل

333
00:21:19,380 --> 00:21:20,970
!لنفعل هذا

334
00:21:20,970 --> 00:21:23,720
رؤية أصدقائي نشطين تُذكّرني

335
00:21:23,720 --> 00:21:26,970
كيف كانوا بمُستوى مُختلف تماماً
عن الصّيادين الآخرين

336
00:21:27,580 --> 00:21:30,140
لا أحتاج حتّى لإطلاق أيّ سِهام

337
00:21:30,140 --> 00:21:32,700
أتفهّم شعورك، لكن جميعنا بحاجة لعمل

338
00:21:32,700 --> 00:21:34,970
لا يُسمَح لك بدخول الحاجز

339
00:21:35,640 --> 00:21:37,990
أنت مُلحّ يا هاكّون

340
00:21:37,990 --> 00:21:42,490
شوي، ماذا علّمتُكِ أن تفعلي إذا كان
لديكِ الوقت الكافي للثّرثرة؟

341
00:21:42,490 --> 00:21:44,490
!حاضرة! وجدتُ عملاً أقوم به

342
00:21:44,490 --> 00:21:48,320
تبدو خائفة حقّاً. لا أعرف ما السّبب

343
00:21:48,320 --> 00:21:50,490
أعتقد سأكفّ عن الإلحاح عليها

344
00:21:51,180 --> 00:21:56,500
وهكذا انتهى القتال، بفضل
قوّة أصدقائي القاهرة

345
00:21:57,070 --> 00:22:00,030
!المعركة الأخيرة تلوح في الأُفُق أخيراً

346
00:22:00,030 --> 00:22:02,380
هاكّون، أريد شراباً

347
00:22:02,900 --> 00:22:04,470
مرحباً بك

348
00:23:35,930 --> 00:23:38,070
أتطلّع قُدماً لاستعمالك التّالي لي