182
00:12:11,330 --> 00:12:12,500
!ربحت

183
00:12:12,110 --> 00:12:13,570
شكراً جزيلاً لك

184
00:12:15,460 --> 00:12:16,910
مرحباً بك

185
00:12:27,040 --> 00:12:29,800
!فعلتها يا هاكّون! مُذهل

186
00:12:30,140 --> 00:12:32,310
!لم ينتهِ الأمر بعد يا لاميس

187
00:12:36,690 --> 00:12:39,220
النّصر لك، حاليّاً

188
00:12:39,220 --> 00:12:41,560
لكن ذات يوم، ستصبح مُلكي

189
00:12:41,930 --> 00:12:44,070
!أنت! لن تفلت

190
00:12:44,070 --> 00:12:46,330
لاميس، اصعدي إلى الأعلى

191
00:12:46,330 --> 00:12:47,190
!حسناً

192
00:12:49,080 --> 00:12:51,320
!تغيير الشّكل

193
00:12:55,990 --> 00:12:57,090
!ماذا؟

194
00:13:04,000 --> 00:13:05,850
كنّا وشيكين جدّاً

195
00:13:05,850 --> 00:13:08,340
!تبّاً! ينفد وقت التحوُّل

196
00:13:08,340 --> 00:13:11,470
!لا! ما زال هناك عشر ثوانٍ مُتبقّية

197
00:13:11,470 --> 00:13:13,290
!هذه مليئة بالغاز

198
00:13:13,290 --> 00:13:15,280
!صواريخ الكولا

199
00:13:15,280 --> 00:13:16,980
!انطلقي يا لاميس

200
00:13:45,670 --> 00:13:46,540
هل فعلناها؟

201
00:13:46,540 --> 00:13:49,180
أ-جل. أح-سن-ت صن-عاً

202
00:13:49,180 --> 00:13:52,080
هل عدت إلى هاكّون القديم؟

203
00:13:52,080 --> 00:13:52,990
أ-جل

204
00:13:52,990 --> 00:13:55,580
كنّا ضدّ ذلك الحدّ الزمنيّ

205
00:13:56,610 --> 00:13:58,720
!لاميس

206
00:13:57,600 --> 00:14:00,110
!المُعلّم هاكّون

207
00:13:58,970 --> 00:14:01,210
!فعلتُماها يا لاميس

208
00:14:01,740 --> 00:14:04,400
!هاكّون، هل أنت بخير؟! لم تتعطّل، صحيح؟

209
00:14:04,400 --> 00:14:05,240
أ-جل

210
00:14:05,240 --> 00:14:09,500
!المُعلّم هاكّون! أنا آسف لأنّني لم أكن مُفيداً

211
00:14:09,500 --> 00:14:11,990
!كانت تلك المعركة مُبهجة

212
00:14:11,990 --> 00:14:13,800
...عدد كبير من هاكّون

213
00:14:14,990 --> 00:14:16,620
...حسناً، في الواقع

214
00:14:16,620 --> 00:14:19,020
كان ذلك من بعيد، لكن بدتْ رائعة

215
00:14:19,380 --> 00:14:25,770
،أتمنّى لو رآها القائد كيريويل والعائلة
والمُدراء أيضاً

216
00:14:26,460 --> 00:14:29,260
البوّابة السّحريّة الّتي تقودنا إلى المنزل
لن تتفعّل

217
00:14:29,260 --> 00:14:32,290
لا بُدّ أنّ حاكم العالم السُّفليّ أحرق
كمّيةً كبيرة من المانا

218
00:14:32,290 --> 00:14:34,430
تقصد بأنّنا لا نستطيع المُغادرة حاليّاً؟

219
00:14:34,430 --> 00:14:36,170
!لا! ماذا سنفعل بشأن الطّعام؟

220
00:14:37,130 --> 00:14:41,510
،لعلّي استهلكتُ مُعظم نقاطي على التحوُّل
لكن ما زال لديّ الكثير

221
00:14:41,500 --> 00:14:44,890
أظنّني أستطيع إطعام ستّة أشخاص لعدّة سنوات

222
00:14:44,890 --> 00:14:47,760
نحن لا نُواجه الكثير من المتاعب
بوجود هاكّون هنا

223
00:14:47,760 --> 00:14:51,570
أجل، هاكّون مُفيد للغاية. كالعادة

224
00:14:51,570 --> 00:14:53,650
!عدم التضوُّر جوعاً هو الأفضل

225
00:14:53,650 --> 00:14:56,880
بالفعل... هاكّون... هو الأعظم

226
00:14:56,880 --> 00:14:59,540
!مُعلّم هاكّون، سأتبعك للأبد

227
00:14:59,540 --> 00:15:02,820
شكراً جزيلاً يا هاكّون. سنبقى معاً دوماً

228
00:15:02,820 --> 00:15:03,920
شكراً لك

229
00:15:03,920 --> 00:15:06,860
أتشكرني أنا؟ هذا مُضحك

230
00:15:14,310 --> 00:15:17,810
ذلك الرّجل... إنّه قويّ، مُعلّم هاكّون

231
00:15:17,810 --> 00:15:21,190
يبدو أنّني أخفتُكم. آسف بشأن ذلك

232
00:15:21,190 --> 00:15:25,990
أنا زعيم الذّراع اليُسرى... أقصد زعيم
الحاكم السُّفليّ، ملك الشّياطين

233
00:15:27,470 --> 00:15:29,970
و-ر-د ذِ-ك-ره فـ-ي ال-ر-سا-لة

234
00:15:29,970 --> 00:15:31,540
في الرّسالة؟

235
00:15:32,310 --> 00:15:35,060
تقصد الرّسالة من هاتاكي؟

236
00:15:35,060 --> 00:15:37,580
يبدو أنّكم فهمت ما يجري

237
00:15:37,840 --> 00:15:39,500
سمعتُ الكثير عنك

238
00:15:39,500 --> 00:15:41,580
أنت حقّاً آلة بيع

239
00:15:41,850 --> 00:15:43,090
يُعيدني هذا للذّكريات

240
00:15:43,090 --> 00:15:44,410
يُعيدك للذّكريات؟

241
00:15:44,410 --> 00:15:46,980
تقصد بأنّك تعرف معنى آلات البيع؟

242
00:15:46,980 --> 00:15:49,580
رُبّما ملك الشّياطين مثلي

243
00:15:49,580 --> 00:15:52,770
حسناً، ماذا تفعل هنا يا ملك الشّياطين؟

244
00:15:52,770 --> 00:15:55,300
هل أتيت لتنتقم لتابعك السّابق؟

245
00:15:55,300 --> 00:15:58,500
لا، أتيتُ لأحضركم

246
00:15:58,500 --> 00:16:02,080
في الواقع، البوّابة السّحريّة في دياركم لا تعمل

247
00:16:02,080 --> 00:16:04,050
ألا ينبغي أن أقلق بشأن ذلك؟

248
00:16:04,980 --> 00:16:06,980
لا، نحتاج للمُساعدة

249
00:16:06,980 --> 00:16:10,490
جيّد. إله شرّير يحكم هذا العالم

250
00:16:10,490 --> 00:16:13,020
لكن يمكن تأجيل التّفاصيل ريثما نعود

251
00:16:20,130 --> 00:16:22,490
!أنا مسرور جدّاً لعودتكم بالسّلامة

252
00:16:22,490 --> 00:16:24,350
جميعكم أدّيتم عملاً عظيماً

253
00:16:24,730 --> 00:16:26,620
!نجحت، أليس كذلك؟

254
00:16:26,980 --> 00:16:31,640
،بعد كلّ ما عرّضنا له حاكم العالم السُّفليّ
أردنا أن نكون نحن من يقضي عليه

255
00:16:31,640 --> 00:16:33,040
!لكن مع ذلك، أحسنت صنعاً

256
00:16:33,040 --> 00:16:36,500
والآن يمكننا أن نعيش بسلام أيضاً

257
00:16:37,050 --> 00:16:40,090
هاكّون، نُقدّر كلّ ما فعلتَه لأجلنا

258
00:16:40,090 --> 00:16:42,010
هذا ينطبق عليّ وعلى عائلتي

259
00:16:42,010 --> 00:16:44,120
لم يعُد موجوداً إذاً؟

260
00:16:44,750 --> 00:16:45,900
شكراً لك

261
00:16:46,840 --> 00:16:48,240
!أنا أشتعل حماساً

262
00:16:48,240 --> 00:16:51,520
أنا متأكّد بأنّه شعور رائع
!أن تُنقذ العالم وما شابه

263
00:16:51,520 --> 00:16:54,650
يبدو أنّنا نستطيع تركيز طاقتنا
على إعادة الإعمار الآن

264
00:16:54,650 --> 00:16:58,790
علينا نسيان ماضينا الحزين، وإعادة
!بناء غد أفضل

265
00:16:58,790 --> 00:17:00,240
أبليتم بلاء ممتازاً

266
00:17:00,780 --> 00:17:02,540
استريحوا لبقيّة اليوم

267
00:17:02,540 --> 00:17:05,870
لا بُدّ أنّ كلّ ذلك الجري قد أرهقكم

268
00:17:05,870 --> 00:17:10,190
الحرص على نَيل ما يكفي من راحة
هو جزء من عمل الصّيّاد

269
00:17:10,190 --> 00:17:11,040
شوي

270
00:17:11,040 --> 00:17:14,300
لم تتأذّ، صحيح؟ هذا أكثر ما يُقلقني

271
00:17:14,860 --> 00:17:16,040
أبليت بلاء حسناً

272
00:17:16,040 --> 00:17:18,680
!شكراً يا حضرة المُدير

273
00:17:18,980 --> 00:17:24,050
يُشرّفني أن أعتبركم صيّادي طبقة
بُحيرة التدفُّق النّقيّ

274
00:17:24,800 --> 00:17:28,570
أنا متأكّد بأنّ كافّة الصّيادين والسكّان
الّذين لم يعيشوا لرؤية هذا اليوم

275
00:17:28,570 --> 00:17:30,360
سُعداء بكم أيضاً

276
00:17:40,470 --> 00:17:42,580
كيف الحال؟

277
00:17:42,580 --> 00:17:44,090
مرحباً بك

278
00:17:46,810 --> 00:17:50,700
أنت وأنا نعيش حياة غريبة حقّاً، أليس كذلك؟

279
00:17:50,700 --> 00:17:53,080
مـ-تى ع-د-ت؟

280
00:17:53,080 --> 00:17:57,590
ع-د-ت؟" آسف، لا أستطيع فهم هذا"

281
00:17:59,750 --> 00:18:01,660
هذا ذكيّ

282
00:18:01,660 --> 00:18:04,340
لم أخُض مُحادثة باليابانيّة
منذ زمن بعيد

283
00:18:04,990 --> 00:18:07,100
"متى عدتُ"

284
00:18:07,100 --> 00:18:08,640
قبل دقائق قليلة

285
00:18:09,350 --> 00:18:15,650
كان هاتاكي قد غادر لرؤية أصدقائنا الّذين
!يُعيدون الإعمار حيث كان ديماسنا

286
00:18:15,650 --> 00:18:19,790
لا أصدِّق بأنّ الوصول إلى المدينة
المُحصَّنة أقلّ من يومين

287
00:18:19,790 --> 00:18:21,910
إنّه هاكّون دون سِواه

288
00:18:21,910 --> 00:18:22,990
مرحباً بك

289
00:18:22,990 --> 00:18:25,660
سمعتُ بأنّك هزمت حاكم العالم السُّفليّ
هزيمة نكراء

290
00:18:25,660 --> 00:18:27,840
هذا هو هاكّون الّذي نعرفه

291
00:18:27,840 --> 00:18:31,170
،حالما يُفتَح متجرنا من جديد
احرص على الزّيارة

292
00:18:31,170 --> 00:18:33,430
سأقدّم لك الكثير على حسابنا

293
00:18:33,430 --> 00:18:34,590
!ماذا تقول؟

294
00:18:34,590 --> 00:18:39,180
ليس لدينا أي فتيات مُثيرات إلى هذا الحدّ
!في الجانب الّذي أنا فيه

295
00:18:39,680 --> 00:18:41,430
!كم أشعر بالغيرة

296
00:18:41,430 --> 00:18:42,920
مرحباً بك

297
00:18:43,550 --> 00:18:45,680
بالمُناسبة، ماذا تنوي أن تفعل تالياً؟

298
00:18:45,930 --> 00:18:47,180
استكشاف الدّيماس

299
00:18:47,400 --> 00:18:50,690
تلك الّتي تمنحك أي أُمنية عند إنجازها

300
00:18:50,950 --> 00:18:53,840
أعتقد هناك فُرصة بأن أعود بشريّاً ثانية أيضاً

301
00:18:53,840 --> 00:18:55,950
هل سيتّسع جسدي داخل ديماس؟

302
00:18:56,640 --> 00:19:00,050
إذا وجدتُ ديماساً يمكنك الاتّساع
بداخله، فسأُخبرك

303
00:19:00,050 --> 00:19:01,820
!أتمنّى ذلك يا سيّد

304
00:19:01,820 --> 00:19:05,210
والآن لديّ سبب آخر لاستكشاف الدّياميس

305
00:19:05,550 --> 00:19:10,080
آمل أن نعود بشريّين ثانية يوماً ما
!ونستطيع مُشاركة الطّعام

306
00:19:10,080 --> 00:19:12,760
بالتّأكيد، آمل أن يتواجد مُستقبلٌ كهذا

307
00:19:12,760 --> 00:19:15,600
ليس وكأنّني لديّ شكوى بشأن
نمط حياتي الزّراعيّ

308
00:19:15,600 --> 00:19:17,160
نفس الأمر ينطبق عليّ

309
00:19:17,160 --> 00:19:19,880
الحياة كآلة بيع ليست سيّئة

310
00:19:19,880 --> 00:19:22,210
هل تخوضان مُحادثة؟

311
00:19:22,210 --> 00:19:23,650
مرحباً بك

312
00:19:23,650 --> 00:19:25,280
...بالمُناسبة يا هاتاكي

313
00:19:25,280 --> 00:19:28,300
ثمّة شيء أودُّ مُناقشته معك على انفراد

314
00:19:28,300 --> 00:19:29,570
ما هو؟

315
00:19:29,570 --> 00:19:34,690
ماذا كنت تقول قبل قليل عندما رأيت
الآنسة شيرلي والآخرين؟

316
00:19:35,520 --> 00:19:37,880
أتطلّع قُدماً لاستعمالك التّالي لي

317
00:19:40,960 --> 00:19:42,800
انتهى الأمر أخيراً

318
00:19:42,800 --> 00:19:43,770
أ-جل

319
00:19:44,240 --> 00:19:45,800
أخبرني يا هاكّون

320
00:19:45,800 --> 00:19:49,310
هل يمكنني المجيء معك لاستكشاف الدّياميس؟

321
00:19:49,310 --> 00:19:50,740
مرحباً بك

322
00:19:51,140 --> 00:19:53,200
تقصد بأنّك لا تُمانع؟

323
00:19:53,200 --> 00:19:54,720
مرحباً بك

324
00:19:54,720 --> 00:19:56,260
!جيّد

325
00:19:57,070 --> 00:19:59,630
،يمكنك فعل الكثير من الأشياء الآن

326
00:19:59,630 --> 00:20:03,010
كنتُ قلقة من أنّك قد لا تحتاجني بعد الآن

327
00:20:03,010 --> 00:20:04,640
مُحال

328
00:20:04,640 --> 00:20:08,080
صمدتُ في هذا العالم لأنّكِ هنا

329
00:20:08,080 --> 00:20:11,260
!لطالما كنّا معاً، وسنبقى معاً

330
00:20:11,650 --> 00:20:12,970
شكراً لك

331
00:20:13,840 --> 00:20:16,280
شكراً لك أيضاً

332
00:20:17,630 --> 00:20:19,930
قبّلتُك

333
00:20:21,870 --> 00:20:24,320
اسمع يا هاكّون

334
00:20:24,320 --> 00:20:27,690
أردتُ أن أُخبرك بشيء منذ فترة طويلة

335
00:20:28,140 --> 00:20:31,930
—في الواقع يا هاكّون، أُحبـ

336
00:20:31,930 --> 00:20:32,770
!إنّه هاكّون

337
00:20:32,770 --> 00:20:35,000
!دجاج مقليّ

338
00:20:33,660 --> 00:20:35,380
!لي أيضاً

339
00:20:36,540 --> 00:20:38,460
في الوقت غير المُناسب؟

340
00:20:43,610 --> 00:20:46,130
كان ذلك مُخيّباً للآمال

341
00:20:47,420 --> 00:20:48,880
...هل هذه

342
00:20:48,880 --> 00:20:51,840
شكراً على كلّ شيء يا لاميس

343
00:20:51,840 --> 00:20:53,810
هذه لأجل مُستقبلنا

344
00:20:53,810 --> 00:20:55,200
أُحبّك

345
00:20:59,950 --> 00:21:03,420
!أُحبّك أيضاً يا هاكّون

346
00:21:04,260 --> 00:21:05,990
!بمُناسبة النّصر

347
00:21:05,990 --> 00:21:07,230
!بصحّتكم

348
00:21:07,420 --> 00:21:08,930
!جميعنا اكتسبنا هذا

349
00:21:08,930 --> 00:21:10,110
هيّا، تناولوا بعضاً

350
00:21:10,110 --> 00:21:12,670
يحقُّ للجميع المُشاركة

351
00:21:12,670 --> 00:21:15,210
!أصبحت مولاتي سوري فتاة راقية رائعة

352
00:21:20,250 --> 00:21:22,010
افتح فمك

353
00:21:22,010 --> 00:21:24,240
أنتِ تُحرجينني يا أختي الكبرى سولريم

354
00:21:24,240 --> 00:21:25,510
!افتح فمك

355
00:21:25,510 --> 00:21:28,370
!لِمَ يحظى بكلّ الاهتمام يا آكا؟

356
00:21:28,370 --> 00:21:31,030
!لنبحث عن حبيبات في المدينة المُحصَّنة يا شيرو

357
00:21:31,030 --> 00:21:32,520
...أنتما

358
00:21:34,510 --> 00:21:36,940
من أجل أفضل ليلة على الإطلاق. بصحّتك

359
00:21:37,270 --> 00:21:39,430
كنتِ تشربين يا لامي؟

360
00:21:40,330 --> 00:21:42,690
!انتهت الأمور بشكل ممتاز

361
00:21:42,690 --> 00:21:44,440
جـ-جميل للغاية

362
00:21:44,980 --> 00:21:47,420
إنّها... ليلة مثاليّة

363
00:21:47,420 --> 00:21:49,270
يسرّني أنّنا لم نستسلم

364
00:21:51,790 --> 00:21:53,790
أليس هذا مُسلّياً يا هاكّون؟

365
00:21:53,790 --> 00:21:54,890
أ-جل

366
00:21:55,280 --> 00:21:56,530
!هذا أروع شعور

367
00:21:56,530 --> 00:21:59,340
،وُلِدتُ من جديد في عالم آخر كآلة بيع

368
00:21:59,340 --> 00:22:02,330
وهذا سخيف للغاية

369
00:22:02,330 --> 00:22:07,390
،لكن الآن، بينما أنا مُحاط بأصدقائي الموثوقين
!تغمرني السّعادة

370
00:22:10,500 --> 00:22:12,980
هل كانت هناك أداة سحريّة كهذه حقّاً؟

371
00:22:12,980 --> 00:22:15,150
كانت تُدعى "آلة بيع"؟

372
00:22:15,150 --> 00:22:16,750
إنّها الحقيقة

373
00:22:16,750 --> 00:22:20,960
،لم يكن يستطيع توزيع الطّعام والشّراب فحسب
بل أدوات يوميّة أيضاً

374
00:22:20,960 --> 00:22:23,260
كان أداة سحريّة عظيمة

375
00:22:23,260 --> 00:22:26,640
صندوق فولاذيّ ناطق؟ هذا لا يمكن تصديقه

376
00:22:26,640 --> 00:22:29,180
أنا واثق بأنّك تكذب علينا لأنّنا
طفلان يا عمّ

377
00:22:29,180 --> 00:22:30,200
...أخي

378
00:22:30,200 --> 00:22:33,230
لا تُنادني بـ"العمّ"، نادِني "شريك". مفهوم؟

379
00:22:34,650 --> 00:22:36,410
تناولا هذه

380
00:22:38,160 --> 00:22:39,420
!هذا لذيذ

381
00:22:39,680 --> 00:22:41,120
!ما هذه الأشياء؟

382
00:22:41,120 --> 00:22:43,160
!إنّها لذيذةٌ جدّاً

383
00:22:43,160 --> 00:22:44,140
يسرّني سماع ذلك

384
00:22:44,140 --> 00:22:46,680
يا عمّ... أقصد يا شريك

385
00:22:46,680 --> 00:22:48,330
من أين أتيت بهذه؟

386
00:22:48,920 --> 00:22:51,170
أنا ماهر في الاستحضار

387
00:22:51,170 --> 00:22:52,340
الاستحضار؟

388
00:22:52,340 --> 00:22:53,710
إنّه سحرٌ من نوع ما

389
00:22:53,710 --> 00:22:54,600
!سحر؟

390
00:22:54,600 --> 00:22:55,930
!يمكنك استخدام السّحر؟

391
00:22:55,930 --> 00:22:57,520
!أريد أن أرى

392
00:22:57,520 --> 00:22:59,710
—حسناً، لأجلكما فقط

393
00:22:59,710 --> 00:23:01,740
!ها أنت هنا

394
00:23:01,740 --> 00:23:04,030
!حان وقت الغوص في ذلك الدّيماس

395
00:23:04,030 --> 00:23:05,570
جميعنا هنا جاهزون

396
00:23:06,170 --> 00:23:08,330
وما زلتُ غير معتادة على هذا المنظر

397
00:23:08,330 --> 00:23:09,810
لكن أعتقد بأنّه جميل

398
00:23:09,810 --> 00:23:11,640
يبدو رائعاً بهذا الشّكل أيضاً

399
00:23:11,640 --> 00:23:14,030
أريد بعض الطّعام قبل أن ندخل الدّيماس

400
00:23:14,030 --> 00:23:16,600
ما رأيكِ بحذاء جديد أوّلاً؟

401
00:23:16,600 --> 00:23:19,460
حسناً، جميعنا مُتوجِّهون إلى داخل الدّيماس

402
00:23:19,460 --> 00:23:22,460
لكن سأمنحكما نظرة أخيرة
إلى خدعتي السّحريّة الرّهيبة

403
00:23:25,690 --> 00:23:27,140
مرحباً بك

404
00:23:28,020 --> 00:23:31,920
آمل أن تتحقّق أُمنيتك في هذا
الدّيماس يا هاكّون

405
00:23:31,920 --> 00:23:34,730
!والآن من فضلك أعطِ الإشارة للمُغادرة

406
00:23:34,730 --> 00:23:36,000
!مرحباً بك