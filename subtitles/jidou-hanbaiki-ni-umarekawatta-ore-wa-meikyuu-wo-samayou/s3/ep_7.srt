1
00:00:01,260 --> 00:00:03,970
!قد تربح سلعة إضافيّة

2
00:00:04,990 --> 00:00:09,600
يبدو بالفعل أنّنا بحاجة لوضع عملة حاكم
الطّبقة المعدنيّة هناك

3
00:00:09,600 --> 00:00:11,270
إنّها تتّسع بشكل مثاليّ

4
00:00:11,270 --> 00:00:12,610
...المُشكلة هي

5
00:00:14,360 --> 00:00:21,240
العملات المعدنيّة الّتي يمتلكها قطيع الوحوش الحمقى هي
عملات الأصل، ورثاء الميّت، والتدفُّق النّقيّ، والمتاهة

6
00:00:21,240 --> 00:00:26,990
لدينا ثلاثة منها: التدفُّق النّقيّ
والطّبقة الحارِقة، وطبقة الظّلام

7
00:00:26,990 --> 00:00:31,790
لدينا سبع قِطع معدنيّة، لكن اثنتين منها
من التدفُّق النّقيّ، ولا واحدة من جبل الكلب

8
00:00:31,790 --> 00:00:33,810
حسناً، سأحاول على أيّ حال

9
00:00:35,510 --> 00:00:38,970
أعتقد يجب امتلاك قطعة جبل
الكلب في نهاية المطاف

10
00:00:43,020 --> 00:00:44,180
مهلاً لحظة

11
00:00:46,120 --> 00:00:47,610
ما هذا؟

12
00:00:47,610 --> 00:00:52,350
قال المُدير دُبّ أن نفتحه عندما
نصل إلى الأعماق القصوى

13
00:00:52,890 --> 00:00:54,490
توقّعتُ ذلك

14
00:00:54,740 --> 00:00:56,120
!أهذا ما أفكّر فيه؟

15
00:00:56,120 --> 00:00:58,000
قطعة جبل الكلب نقديّة؟

16
00:00:58,000 --> 00:00:58,870
أجل

17
00:00:58,870 --> 00:01:01,540
سمعتُ بأنّ مجموعتهم كانت الوحيدة

18
00:01:04,460 --> 00:01:06,890
!المُدير دُبّ هو الأعظم

19
00:01:05,790 --> 00:01:07,200
!رجل الدُبّ المُثير ذاك

20
00:01:07,200 --> 00:01:09,200
!شكراً يا مُدير دُبّ

21
00:01:09,200 --> 00:01:11,340
!كلّ ما يمكنني فعله هو شكرك

22
00:01:26,990 --> 00:01:28,800
من الخارج، صندوق فولاذيّ مُستطيل

23
00:01:28,800 --> 00:01:30,840
!ويوجد بداخله روح بشريّ

24
00:01:30,840 --> 00:01:36,610
في عالم من الأعاجيب، أركب
على ظهر شريكتي لاميس

25
00:01:36,610 --> 00:01:38,990
!أنا هاكّون! مرحباً بك

26
00:01:38,990 --> 00:01:40,720
"!هذا يعني "أجل

27
00:02:49,470 --> 00:02:52,980
قبل ذلك، لنُناقش الأمور أوّلاً

28
00:02:52,980 --> 00:02:55,270
حول تلك الأُمنيات الّتي نريد تحقيقها

29
00:02:57,730 --> 00:03:00,660
عائلتنا لديها أُمنية واحدة فقط

30
00:03:00,660 --> 00:03:03,770
التخلُّص من برَكة كاي السّلبيّة، تفسُّخ

31
00:03:04,100 --> 00:03:05,280
هذا كلُّ شيء

32
00:03:05,900 --> 00:03:09,170
،إن كان هناك مجال لأُمنية أُخرى
!فأُريد حبيبة

33
00:03:08,280 --> 00:03:11,470
!ليس عدلاً يا آكا! أريد المثل

34
00:03:11,470 --> 00:03:12,920
ماذا عنكم؟

35
00:03:12,920 --> 00:03:17,670
أُمنيتي تحقّقتْ بالفعل، لذا أضمّ
أُمنيتي إلى أُمنياتكم

36
00:03:17,670 --> 00:03:20,430
لكن إن كان لا يزال هناك مساحة
للمزيد، فكومة من الأحذية

37
00:03:20,430 --> 00:03:22,340
سأدع الآخرين يُحقّقون أمانيهم

38
00:03:22,340 --> 00:03:25,170
فقط دعوني آكل حتّى الإشباع بالمُقابل

39
00:03:25,420 --> 00:03:29,300
أُمنية بيتي... تحقّقتْ أيضاً

40
00:03:29,300 --> 00:03:33,430
أُمنيتي هي شيء يجب أن أكسبه بنفسي

41
00:03:33,430 --> 00:03:35,130
لا أملك أُمنية أيضاً

42
00:03:35,550 --> 00:03:36,810
لاميس؟

43
00:03:36,810 --> 00:03:38,280
لا فكرة لديّ أيضاً

44
00:03:38,280 --> 00:03:41,190
أي أُمنية لي فهي تعنيني أنا فقط

45
00:03:45,980 --> 00:03:48,070
لم يبقَ غيري

46
00:03:48,070 --> 00:03:49,750
...أُمنيتي هي

47
00:03:49,750 --> 00:03:53,500
أ-ر-ي-د أ-ن أ-كو-ن ب-ش-ر-ياً

48
00:03:54,010 --> 00:03:55,500
شكراً لك

49
00:03:55,500 --> 00:04:00,620
ل-ك-ن ب-ع-د أُم-ن-ية ال-ق-ا-ئ-د

50
00:04:00,620 --> 00:04:04,010
الأولويّة لأُمنية القائد، بينما هذه
الأُمنية ستكون في الأخير

51
00:04:04,010 --> 00:04:07,020
!لكن ماذا لو كان يحقّ لنا أُمنية واحدة فقط؟

52
00:04:07,020 --> 00:04:13,640
.هـ-نا-ك دي-ام-يس أُ-خر-ى
يـ-مك-نن-ي ا-الا-نت-ظا-ر

53
00:04:13,640 --> 00:04:17,740
معك حقّ. هناك دياميس أُخرى في العالم

54
00:04:17,740 --> 00:04:20,590
حتّى إن لم تتحقّق أُمنية من أُمنياتك
،في هذا الدّيماس

55
00:04:20,590 --> 00:04:23,220
سيترتّب علينا غزو ديماس آخر فحسب

56
00:04:23,220 --> 00:04:25,650
سأُرافقك في هذه الجولة أيضاً

57
00:04:25,650 --> 00:04:27,950
سأذهب معك بالطّبع أيضاً

58
00:04:27,950 --> 00:04:29,790
وأنا أيضاً يا مُعلّم

59
00:04:30,630 --> 00:04:32,760
هذا المكان ضخم

60
00:04:32,760 --> 00:04:36,040
،كنّا نمشي منذ مدّة، لكن لا يمكن رؤية شيء

61
00:04:36,040 --> 00:04:38,410
لذا من الصّعب تحديد مدى حجمه الكبير

62
00:04:46,310 --> 00:04:48,790
يبدو أنّ طريقنا كان صحيحاً

63
00:04:48,790 --> 00:04:51,300
لا يوجد أحدٌ هنا يا هاكّون

64
00:04:51,300 --> 00:04:54,310
أحسنتُم صنعاً في الوصول إلى هنا

65
00:04:55,650 --> 00:05:01,190
بعد وصولكم إلى الطّبقة الدُّنيا، كسبتُم
الحقّ في تحقيق أُمنيتكم

66
00:05:01,190 --> 00:05:03,690
!سوف يمنح أُمنية فعلاً

67
00:05:04,000 --> 00:05:10,820
لكن من بينكم أحد يبدو مسؤولاً
عن تهديد ديماسي

68
00:05:10,820 --> 00:05:15,200
لا بُدّ أنّك تقصدني. كنتُ أعمل
لصالح حاكم العالم السُّفليّ

69
00:05:15,580 --> 00:05:17,000
حاكم العالم السُّفليّ أحمق

70
00:05:17,000 --> 00:05:21,720
يحاول السّيطرة على ديماسي
الّذي بُني من الشّجرة المُقدّسة

71
00:05:21,720 --> 00:05:25,040
!سرقَ مُعظم قوّتي بالفعل

72
00:05:25,040 --> 00:05:26,330
!هاكّون، هناك

73
00:05:28,340 --> 00:05:30,320
!أصغوا يا قوم

74
00:05:31,420 --> 00:05:34,930
.التكلُّم بهذه الطّريقة مُزعج
هل يمكنني التوقُّف؟

75
00:05:34,930 --> 00:05:37,170
!اسمعوا جيّداً

76
00:05:37,170 --> 00:05:41,300
لم أتوقّع ولا بأحلامي أن يأتي أحمق

77
00:05:41,300 --> 00:05:43,850
!ويحاول السّيطرة على الدّيماس

78
00:05:43,850 --> 00:05:48,230
وكأنّني أرى مُوظّفاً مكتبيّاً مريضاً
،وضجراناً من حياته

79
00:05:48,230 --> 00:05:50,610
لكن أعتقد بأنّه هو من صنع الدّيماس

80
00:05:50,880 --> 00:05:54,120
أنت من صنع الدّيماس، صحيح؟

81
00:05:54,120 --> 00:05:56,350
في الواقع، شيء من هذا القبيل

82
00:05:56,350 --> 00:05:59,170
أُعرَف بسيّد الدّياميس

83
00:05:59,170 --> 00:06:02,390
منذ زمن بعيد كانوا يُلقّبونني بالعبقريّ

84
00:06:02,390 --> 00:06:05,380
لكن سامحوني. نسيتُ الضّيافة

85
00:06:08,390 --> 00:06:10,660
هيّا، تفضّلوا بالجلوس

86
00:06:10,660 --> 00:06:13,400
أنا متأكّد بأنّ لديكم الكثير من الأسئلة

87
00:06:13,400 --> 00:06:18,320
سأجيب عنها إذا افترضنا بأنّني أستطيع ذلك

88
00:06:18,320 --> 00:06:20,390
لنشرب أيضاً ونتناول بعض المُرطِّبات

89
00:06:20,390 --> 00:06:21,640
مرحباً بك

90
00:06:24,890 --> 00:06:27,420
!انظروا إلى هذا

91
00:06:27,420 --> 00:06:30,400
لطالما كنتُ مُهتمّاً بهذا

92
00:06:30,400 --> 00:06:35,100
كآلة بيع، أُصرُّ على أن أكون مسؤولاً
عن المشروبات والأكلات الخفيفة

93
00:06:35,100 --> 00:06:37,920
بالإضافة إلى ذلك، يدعني هذا أمنع
أيّ عبث بالمشروبات

94
00:06:39,410 --> 00:06:42,290
سوف أستقبل الآن أسئلتكم

95
00:06:42,290 --> 00:06:45,800
مبدئيّاً، ما هو الدّيماس وسيّد الدّياميس؟

96
00:06:45,800 --> 00:06:47,070
سؤال وجيه

97
00:06:47,070 --> 00:06:53,740
الدّياميس هي أعمال فنّية صُنِعتْ بواسطة
سحَرة قُدماء لاستعراض قوّتهم

98
00:06:53,740 --> 00:06:56,800
أو رُبّما هي أقرب إلى مراكز استجماميّة

99
00:06:56,800 --> 00:07:00,560
الشّخص الّذي يصنعها يُدعى بسيّد الدّياميس

100
00:07:00,560 --> 00:07:03,040
سحَرة قُدماء؟

101
00:07:03,040 --> 00:07:05,180
لم أسمع بهذا من قبل

102
00:07:06,130 --> 00:07:10,130
حسناً، انطفأ بريقنا لأسباب مُحدّدة

103
00:07:10,130 --> 00:07:13,200
لم يبقَ منّا أي تاريخ أو ذكرى

104
00:07:13,200 --> 00:07:16,280
،لكن المقصد هو أنّهم صنعوا الدّياميس

105
00:07:16,280 --> 00:07:19,210
وتبجّحوا بصنيعتهم أمام بعضهم الآخر

106
00:07:19,210 --> 00:07:23,210
أعتقد بمُصطلحات عالمي، إنّهم
أشبه بمُصمّمي ألعاب الفيديو

107
00:07:23,560 --> 00:07:28,030
،هل صحيح أنّنا إذا وصلنا للطّابق الأدنى
يمكننا تحقيق أي أُمنية؟

108
00:07:28,030 --> 00:07:30,390
أجل، هذا صحيح

109
00:07:31,530 --> 00:07:33,470
كم عدد الأُمنيات؟

110
00:07:33,470 --> 00:07:37,350
أيّ عدد. لا يوجد سقف

111
00:07:37,350 --> 00:07:40,790
لكن هذا لا يعني بأنّها يمكن
أن تكون أي أُمنية

112
00:07:41,440 --> 00:07:45,950
تحقيق أُمنية يستهلك مقداراً كبيراً من المانا

113
00:07:45,950 --> 00:07:51,230
ما يعني بأنّ حدّ الأُمنيات هو مقدار
المانا الّذي يملأ هذا الدّيماس

114
00:07:51,490 --> 00:07:54,670
سيّد الدّياميس، هل يمكنك إزالة
!البرَكة السّلبيّة عن ابني؟

115
00:07:54,670 --> 00:07:56,190
يمكن فعل ذلك

116
00:08:00,730 --> 00:08:03,990
في هذه الحالة، أريدك أن تُزيل
!برَكته السّلبيّة

117
00:08:03,990 --> 00:08:08,550
من فضلك، لا تستعجل. سأمنحك
شرحاً أكثر تفصيلاً

118
00:08:08,550 --> 00:08:12,130
لنفترض أنّك تمنّيت فضّة وذهباً وجواهر

119
00:08:12,130 --> 00:08:16,940
وأعطيتُك الكنز الّذي جمعتُه، ولم
يستهلك ذلك أي مانا

120
00:08:16,940 --> 00:08:22,920
غير أنّ إزالة برَكة سلبيّة تستهلك
مقداراً كبيراً من القوّة

121
00:08:22,920 --> 00:08:25,470
سأكون أكثر تحديداً إذاً

122
00:08:25,910 --> 00:08:29,690
،هل من المُمكن إزالة "تفسُّخ" عن كاي
ثمّ إعادة هاكّون إلى بشريّ؟

123
00:08:29,690 --> 00:08:32,330
هذا صعب، لكنّه مُمكن

124
00:08:32,330 --> 00:08:37,580
،رغم أنّ هذا سيستهلك كلّ المانا
وبالتّالي استثناء أي أُمنية إضافيّة

125
00:08:37,840 --> 00:08:40,570
ماذا؟ يمكنني أن أصبح بشريّاً ثانية؟

126
00:08:40,570 --> 00:08:42,420
!بجدّية؟

127
00:08:40,950 --> 00:08:42,840
!أنا مسرورة لأجلك يا هاكّون

128
00:08:41,500 --> 00:08:43,460
!تهانينا يا مُعلّم

129
00:08:43,460 --> 00:08:45,200
!أنباء ممتازة يا هاكّون

130
00:08:45,200 --> 00:08:47,960
والآن لن أشعر بتأنيب الضّمير
!بشأن تحقيق أُمنيتنا

131
00:08:47,960 --> 00:08:49,520
!فعلتَها

132
00:08:49,520 --> 00:08:51,720
...لمسة... بشرة دافئة

133
00:08:55,840 --> 00:09:01,840
لمعلوماتكم، إذا حقّقتُ أُمنيتَي هذين
الشّخصين، فسينهار هذا الدّيماس

134
00:09:02,780 --> 00:09:04,220
...لا

135
00:09:04,220 --> 00:09:07,230
تبّاً! ظننتُ بأنّ هاكّون سيتمكّن من
أن يصبح بشريّاً ثانية

136
00:09:07,480 --> 00:09:10,620
إذا انهار الدّيماس، فسيُدفَن النّاسُ أحياء

137
00:09:10,620 --> 00:09:13,740
لا أستطيع تبرير تضحية كهذه
...فقط كي تتحقّق أُمنيتي

138
00:09:13,740 --> 00:09:14,710
!لحظة

139
00:09:15,210 --> 00:09:18,530
قـ-ا-ئ-د، ح-قّ-ق أُم-ني-تك

140
00:09:18,530 --> 00:09:21,620
ي-م-ك-ن تأ-جي-ل أُم-ني-تي لا-حقاً

141
00:09:22,380 --> 00:09:25,770
،إذا أزلتُ البركةَ السّلبيّة للفتى أوّلاً

142
00:09:25,770 --> 00:09:30,190
ثمّ عدت أنت إلى هنا حالما
،إخلائكم للدّيماس

143
00:09:30,190 --> 00:09:32,120
فأستطيع إعادتك إلى بشريّ

144
00:09:32,340 --> 00:09:36,010
يستطيع سيّد الدّياميس على ما يبدو
قراءة أفكاري، مثل كيكويو

145
00:09:36,010 --> 00:09:39,660
يبدو أنّ حاكم العالم السُّفليّ قد أغلق
،مخرج الدّيماس

146
00:09:39,660 --> 00:09:42,260
لكن أستطيع فتحه بشكل مُؤقّت

147
00:09:42,260 --> 00:09:43,630
!نستطيع فعلها إذاً

148
00:09:43,630 --> 00:09:45,140
!أنا مسرورة لأجلك يا هاكّون

149
00:09:45,140 --> 00:09:46,390
مرحباً بك

150
00:09:46,770 --> 00:09:50,630
إذاً سأبدأ بإزالة "تفسُّخ" الخاصّة بالفتى

151
00:10:05,000 --> 00:10:06,560
لا يوجد ألم

152
00:10:06,560 --> 00:10:08,040
!هذا غير مؤلم

153
00:10:08,040 --> 00:10:10,900
برَكة التفسُّخ قد زالت الآن

154
00:10:09,260 --> 00:10:11,800
!أحسنت يا أخي

155
00:10:10,900 --> 00:10:15,050
لم يعُد مُضطرّاً للتّعامل مع ألم تآكُل لحمه

156
00:10:15,050 --> 00:10:16,710
!شكراً لكِ على كلّ ما فعلتِه

157
00:10:16,710 --> 00:10:18,840
أنت حُرّ الآن

158
00:10:18,840 --> 00:10:20,540
حتّى لو لم تكن معي

159
00:10:20,540 --> 00:10:25,570
أجل. لهذا السّبب من الآن فصاعداً، سأفعلها
لأنّ هذا اختياري يا أختي الكبرى سولريم

160
00:10:31,960 --> 00:10:34,200
!كنتُ أنتظر هذه اللّحظة

161
00:10:34,200 --> 00:10:36,580
!كنت تختبئ هنا إذاً

162
00:10:44,460 --> 00:10:46,220
!سولريم

163
00:10:46,220 --> 00:10:48,450
!لـ-لم... أكن أعلم

164
00:10:50,120 --> 00:10:53,900
لم أتوقّع أبداً أن تنجح الخطّة
بهذا الشّكل المُبهر

165
00:10:58,340 --> 00:11:00,220
—حاكم العالم السُّفليّ، مـ

166
00:11:00,220 --> 00:11:02,710
هذا ما كنتُ أنتظره

167
00:11:02,990 --> 00:11:09,980
،إنّ منح أُمنية تُكلّفه مزيداً من القوّة
والآن، أستطيع القضاء عليه بسهولة

168
00:11:09,980 --> 00:11:11,590
!حاكم العالم السُّفليّ

169
00:11:12,750 --> 00:11:17,220
أتنحدر إلى هذا الحدّ لتتجاوز
...الحاجز المُضادّ للوحوش

170
00:11:17,220 --> 00:11:21,290
أخذتُ مزيداً من القوّة يا سيّد الدّياميس

171
00:11:21,290 --> 00:11:25,000
هذا الدّيماس هو مُلكي عمليّاً

172
00:11:25,000 --> 00:11:27,120
!استغللتَني

173
00:11:27,390 --> 00:11:31,750
أنتِ من أملاكي. لِمَ لا أستخدمكِ؟

174
00:11:31,750 --> 00:11:33,750
!إنّها ليست شيئاً

175
00:11:33,750 --> 00:11:39,440
سولريم، يمكنني أن أستثنيكِ أنتِ بالذّات

176
00:11:39,440 --> 00:11:40,900
عودي إليّ

177
00:11:43,000 --> 00:11:46,620
!كنتُ لأُسعَد بالانتماء لك قديماً

178
00:11:46,620 --> 00:11:48,760
!لكن اختلفت الأمور الآن

179
00:11:48,760 --> 00:11:51,520
!لأنّني عثرتُ على شيء أهمّ بالنّسبة لي

180
00:11:52,190 --> 00:11:54,110
هذا كلام فارغ

181
00:11:54,680 --> 00:11:55,680
!خرق العين

182
00:11:57,750 --> 00:12:00,850
مسحتها بـ"خرق العين"؟

183
00:12:00,850 --> 00:12:04,610
لن أدعك تقتل شخصاً قد يكون
ابنتي يوماً ما

184
00:12:04,870 --> 00:12:06,580
والآن، ماذا نفعل؟

185
00:12:06,580 --> 00:12:08,820
،بخرق العين الخاصّة بالقائد، وحاجزي

186
00:12:08,820 --> 00:12:12,500
،ووجود هذا العدد الكبير بجانبنا
...قد نحصل على فُرصة

187
00:12:14,250 --> 00:12:19,210
أرغب في الاستمرار في قتالكم، لكن
أنجزتُ هدفي بالفعل

188
00:12:19,730 --> 00:12:22,080
لنبدأ بمُباراة أُخرى بدلاً من ذلك

189
00:12:22,080 --> 00:12:24,500
!ما-ما هذا؟! سحره؟

190
00:12:22,970 --> 00:12:24,500
!ا-الأرض تهتزّ

191
00:12:24,500 --> 00:12:26,400
شدّتها 4 تقريباً

192
00:12:26,400 --> 00:12:29,010
هذا يُخيف الآخرين والّذين لا يمتلكون
مُقاومة للزّلازل

193
00:12:29,010 --> 00:12:32,270
أتُحاول إسقاط الدّيماس؟

194
00:12:32,270 --> 00:12:35,120
هذا صحيح، يا سيّد الدّياميس

195
00:12:35,120 --> 00:12:37,270
أخذتُ ما أتيتُ إلى هنا لأجله

196
00:12:37,270 --> 00:12:40,810
لا أنوي الحِفاظ على هذا الدّيماس

197
00:12:41,100 --> 00:12:45,820
سأنقل الوحوش إلى السّطح
وأراقب البشر يموتون

198
00:12:48,320 --> 00:12:50,820
!ما الّذي يُمتعك حيال هذا؟

199
00:12:51,220 --> 00:12:55,700
وُجِد الوحوش فقط للتسبُّب بألم للنّاس

200
00:12:55,930 --> 00:12:59,700
نسي ملكُ الشّياطين هذا. إنّه
لأمر مُثير للشّفقة

201
00:12:59,700 --> 00:13:04,290
،سأستمتع برؤية ما هو قادم أوّلاً
الانهيار أو إبادتكم

202
00:13:05,710 --> 00:13:08,680
اختفى؟ دون قتلنا؟

203
00:13:11,230 --> 00:13:17,970
جميعكم، سأستحضر لكم دائرة انتقال تؤدّي
بكم مُباشرة إلى طبقة بُحيرة التدفُّق النّقيّ

204
00:13:18,230 --> 00:13:23,230
عودوا، وخذوا النّاس معكم بينما
تهربون من الدّيماس

205
00:13:23,230 --> 00:13:29,250
بقوّتي المُتبقّية، سأحرّر الباب
المُؤدّي نحو السّطح

206
00:13:31,700 --> 00:13:34,600
لا أعرف إلى متى ستصمد قوّتي

207
00:13:34,600 --> 00:13:38,370
حبّذا لو تُسرِعوا، أجل

208
00:13:38,370 --> 00:13:41,820
سيستخدم آخر ما تبقّى من قوّته
!لمُساعدتنا في الهرب؟

209
00:13:41,820 --> 00:13:43,530
هاكّون

210
00:13:44,240 --> 00:13:49,800
أنا آسف لأنّني لم أستطع تحقيق
أُمنيتك في أن تصبح بشريّاً ثانية

211
00:13:49,800 --> 00:13:52,980
ي-م-ك-نن-ي إع-ا-دة ال-م-حا-ولة

212
00:13:53,750 --> 00:13:55,820
أنت مُثير للاهتمام

213
00:13:55,820 --> 00:14:02,270
سأحاول منع الدّيماس من الانهيار
لأطول مدّة مُمكنة

214
00:14:03,050 --> 00:14:05,280
ماذا عنك يا سيّد الدّياميس؟

215
00:14:05,280 --> 00:14:07,480
لا تقلقي بشأني

216
00:14:07,480 --> 00:14:11,670
تنصّ القاعدة على أنّه عندما يُغزَى ديماس

217
00:14:11,670 --> 00:14:15,670
،ويمنح سيّد الدّياميس الأُمنيات
حينئذ يختفي

218
00:14:16,550 --> 00:14:19,750
كنتُ حيّاً لفترة طويلة جدّاً

219
00:14:19,750 --> 00:14:25,290
،هذه طريقة غير مُتوقَّعة لإنهاء الأمور
لكنّها مُمتعة من جهة أُخرى

220
00:14:26,230 --> 00:14:28,260
هاكّون

221
00:14:28,260 --> 00:14:33,660
لم أستطع تحقيق أُمنيتك، لكن أستطيع
على الأقلّ القيام بهذا

222
00:14:37,680 --> 00:14:44,020
عسى أن ينتظر مُستقبلٌ واعدٌ
الصّيادينَ الشّجعان

223
00:14:44,020 --> 00:14:47,360
الّذين غزوا ديماس الشّجرة المُقدّسة

224
00:14:47,820 --> 00:14:50,990
...تهانينا، وشكراً لكم

225
00:14:51,600 --> 00:14:57,390
على الاستمتاع بديماسي حتّى النّهاية

226
00:15:01,380 --> 00:15:04,200
من كان يتوقّع أن تصل الأمور إلى هنا؟

227
00:15:04,200 --> 00:15:06,970
علينا إرسال الجميع فوراً
إلى طبقة الأصل

228
00:15:06,970 --> 00:15:08,830
!وإخراجهم من الدّيماس

229
00:15:08,830 --> 00:15:10,060
عُلِم

230
00:15:10,630 --> 00:15:12,660
!واحد، اثنان، ثلاثة

231
00:15:13,640 --> 00:15:14,870
!تعزيزات

232
00:15:14,870 --> 00:15:16,380
!إنّها فتاة القوّة

233
00:15:16,380 --> 00:15:20,290
لاميس! هاكّون! أوّلاً، أمِّنا الباب
!الّذي يؤدّي إلى الخارج

234
00:15:20,290 --> 00:15:21,190
!حسناً

235
00:15:20,560 --> 00:15:22,030
مرحباً بك

236
00:15:22,560 --> 00:15:24,970
!أنا آسفة، اسمحوا لنا بالمرور رجاء

237
00:15:23,780 --> 00:15:25,770
شكراً جزيلاً لك

238
00:15:39,340 --> 00:15:40,200
!لاميس

239
00:15:40,200 --> 00:15:41,010
!هيوليمي

240
00:15:40,200 --> 00:15:41,950
!المُدير دُبّ، ثمّة مُشكلة

241
00:15:41,950 --> 00:15:42,780
ما الخطب؟

242
00:15:42,780 --> 00:15:45,040
!هناك وحوش في كلّ أنحاء القرية

243
00:15:45,040 --> 00:15:48,290
حينئذ سيترتّب علينا البدء
بإخلاء القليل في كلّ مرّة

244
00:16:07,040 --> 00:16:09,720
تحوّلوا إلى فحم، وذلك كي نستخدمكم
!من أجل التّدفئة

245
00:16:11,850 --> 00:16:13,960
!إنّه وحش الضّفدع الملك

246
00:16:14,450 --> 00:16:16,610
العبوس لم ينفع أحداً

247
00:16:16,610 --> 00:16:20,600
عليك البقاء هادئاً ومُتّزناً طوال الوقت مثلي

248
00:16:23,370 --> 00:16:25,380
مهارات ممتازة

249
00:16:37,970 --> 00:16:40,480
بقي القليل للإخلاء

250
00:16:40,480 --> 00:16:43,660
أعتقد يمكننا كسب ما يكفي من وقت
من أجل خروجهم جميعاً

251
00:16:44,670 --> 00:16:47,120
!لكن مثل هذه الأفكار تعتمد على الحظّ

252
00:16:46,370 --> 00:16:50,780
أرى بأنّني استهنتُ بإصرارك

253
00:16:50,780 --> 00:16:52,250
أتى على ذكرِه

254
00:16:52,530 --> 00:16:58,600
أرى جهودك مُشوِّقة، لذا أُحرِّر
قبضتي عن الباب

255
00:17:07,290 --> 00:17:08,480
!هذا غير مُمكن

256
00:17:07,920 --> 00:17:09,260
!لا يمكننا التّعامل مع هذا

257
00:17:09,540 --> 00:17:14,620
ألا تكمن المتعة في اصطياد
الفرائس المُستميتة المُحاصرة؟

258
00:17:14,620 --> 00:17:17,210
أنت هيكلٌ عظميّ بغيض حقّاً

259
00:17:20,780 --> 00:17:23,050
و-والآن ماذا؟

260
00:17:28,020 --> 00:17:29,640
مـ-ن هـ-نا-ك

261
00:17:30,180 --> 00:17:32,150
يسرّني أنّها فهِمَتْني

262
00:17:32,150 --> 00:17:34,620
!حسناً، حان وقت تغيير الشّكل

263
00:17:34,620 --> 00:17:37,160
!آلة البيع الكبرى في اليابان

264
00:17:38,990 --> 00:17:44,180
أتعترض طريقي أنت، أيّتها الأداة
السّحريّة الّتي تُدعى هاكّون؟

265
00:17:44,180 --> 00:17:48,490
لكن لا يمكنك الحِفاظ على هذه
الهيئة لفترة طويلة

266
00:17:48,490 --> 00:17:52,950
صحيح، إنّ نشر حاجزي بهذه الهيئة
يستهلك نقاطاً بشكل سريع

267
00:17:52,950 --> 00:17:56,250
لكن الأمور مُختلفة الآن! لديّ
الكثير من النّقاط

268
00:17:56,250 --> 00:17:57,250
...لأنّ

269
00:17:57,250 --> 00:18:03,150
على الأقلّ سأمنحك هذا. أضفه
من فضلك إلى نقاطك

270
00:18:03,150 --> 00:18:06,640
!لأنّ سيّد الدّياميس ورّثَني كلّ كنزه

271
00:18:07,310 --> 00:18:09,720
ستُذهَل إذا عرفت كم نقطة لديّ الآن

272
00:18:09,720 --> 00:18:13,260
!سأُبقي هذا الحاجز حتّى يهربوا جميعاً

273
00:18:13,260 --> 00:18:15,720
!هاكّون! ماذا ستفعل؟

274
00:18:15,720 --> 00:18:17,900
!ستُترَك في الخلف هكذا

275
00:18:17,900 --> 00:18:20,520
لا يمكنني سوى قول جملة واحدة الآن

276
00:18:20,520 --> 00:18:24,520
د-ع هـ-ذا ل-ي و-ا-ذ-هـ-بي

277
00:18:24,520 --> 00:18:28,410
!لا! إن بقيتَ أنت، فسأبقى أنا

278
00:18:28,410 --> 00:18:32,770
لدى هاكّون فُرصة أفضل للعودة
بأمان إن لم نكن هنا

279
00:18:32,770 --> 00:18:34,240
أليس كذلك يا هاكّون

280
00:18:34,240 --> 00:18:35,270
أ-جل

281
00:18:35,270 --> 00:18:37,680
...لكن حينها، هو سوف

282
00:18:37,680 --> 00:18:40,930
لاميس، أنتِ تعلمين هذا أيضاً

283
00:18:40,930 --> 00:18:43,570
.سنُشكّل عقبة في وجهه فحسب
هيّا بنا نذهب

284
00:18:43,570 --> 00:18:45,560
...لكن، لكن

285
00:18:45,560 --> 00:18:47,350
سأكون بخير يا لاميس

286
00:18:47,350 --> 00:18:50,390
لا أنوي الموت. أو التحطُّم

287
00:18:50,390 --> 00:18:54,820
لهذا السّبب... لن أدعها تبقى داخل الحاجز

288
00:18:55,670 --> 00:18:56,780
...هاكّون

289
00:18:56,780 --> 00:18:58,920
أتطلّع قُدماً لاستعمالك التّالي لي

290
00:19:00,430 --> 00:19:01,780
حسناً

291
00:19:01,780 --> 00:19:04,270
أجل، لن أكون أنانيّة بعد الآن

292
00:19:04,870 --> 00:19:07,470
لكن حريّ بك ألّا تموت

293
00:19:07,470 --> 00:19:08,960
مرحباً بك

294
00:19:10,700 --> 00:19:12,920
أنا أعني ما أقول، حريّ بك ذلك

295
00:19:12,920 --> 00:19:14,710
سـ-أ-ح-م-يك

296
00:19:14,710 --> 00:19:18,460
حتّى لو دُفِنتَ، أعِدُك بأنّني
سأخرجك من قبرك

297
00:19:18,460 --> 00:19:20,980
!كلّ ما عليك هو الانتظار

298
00:19:21,490 --> 00:19:24,990
أتُضحّي بنفسك وذلك كي يتمكّن
أصدقاؤك من الهرب؟

299
00:19:24,990 --> 00:19:27,090
يا لها من عزيمة رائعة

300
00:19:27,090 --> 00:19:28,440
!شكراً لك

301
00:19:28,440 --> 00:19:30,720
دعني أُحذّرك

302
00:19:30,720 --> 00:19:34,980
كنتُ أتربّص كسِوار على جسد سولريم

303
00:19:35,420 --> 00:19:41,610
إنّه جزء منّي، ولا يزال في جسدها

304
00:19:40,820 --> 00:19:41,980
عمّاذا تتكلّم؟

305
00:19:41,980 --> 00:19:44,260
هذا ما أعنيه

306
00:19:45,000 --> 00:19:46,000
!أين أنا؟

307
00:19:45,280 --> 00:19:47,230
!هاكّون؟! حاكم العالم السّفليّ؟

308
00:19:47,230 --> 00:19:48,820
كيف؟

309
00:19:48,820 --> 00:19:49,730
!هاكّون

310
00:19:49,730 --> 00:19:53,120
هل أجبرَ سولريم على استخدام
!برَكة التّحويل؟

311
00:19:53,880 --> 00:19:55,620
!توقّف أيّها الهيكل العظميّ اللّعين

312
00:19:56,820 --> 00:19:58,790
حسناً إذاً يا كيريويل

313
00:19:58,790 --> 00:20:02,450
هل تُمانع إزالة ذلك الحاجز ببرَكة
خرق العين خاصّتك؟

314
00:20:02,980 --> 00:20:07,520
أشكّ في أنّك تريد رؤية
رأسَي ابنك وابنتك ينفجران

315
00:20:08,330 --> 00:20:10,280
لا تفعلها يا أبي

316
00:20:10,710 --> 00:20:12,610
يا له من فتى مُدهش

317
00:20:12,610 --> 00:20:14,220
اختر الآن

318
00:20:14,220 --> 00:20:19,610
الرّفض والموت مع ابنك، أو إزالة
الحاجز والعيش؟\

319
00:20:19,610 --> 00:20:21,530
!هذا ليس وقت التردُّد

320
00:20:21,530 --> 00:20:26,030
أزلتُ الحاجزَ بنفسي

321
00:20:26,640 --> 00:20:28,140
لقد زال

322
00:20:28,140 --> 00:20:32,980
إذاً دعنا نُراقب معاً بينما
تُدمَّر هذه الأداة السّحريّة

323
00:20:32,980 --> 00:20:34,590
لا تقلق يا قائد

324
00:20:34,590 --> 00:20:36,380
اتّخذتُ هذا القرار بنفسي

325
00:20:36,380 --> 00:20:42,090
الضّرر 2. انخفضت المتانة بمقدار 2

326
00:20:42,090 --> 00:20:45,760
الضّرر صفر. لا تغيُّر في المتانة

327
00:20:47,620 --> 00:20:49,760
الضّرر تسعمئة وتسعة وسبعون

328
00:20:52,130 --> 00:20:53,760
آسف

329
00:20:57,480 --> 00:20:59,400
...هاكّون

330
00:20:59,400 --> 00:21:04,420
.الضّرر تسعمئة وتسعة وسبعون
انخفضت المتانة بمقدار 979

331
00:21:04,420 --> 00:21:07,470
لم تعُد قادراً على استخدام هذه الهيئة

332
00:21:07,470 --> 00:21:09,520
العودة إلى آلة بيع أصليّة

333
00:21:11,700 --> 00:21:17,700
الضّرر 1. انخفضت المتانة بمقدار 1

334
00:21:19,950 --> 00:21:28,340
الضّرر 1. انخفضت المتانة بمقدار 1

335
00:21:47,240 --> 00:21:47,990
!خرق العين

336
00:21:48,340 --> 00:21:50,280
!سولريم! انقلينا إلى الخارج

337
00:22:01,950 --> 00:22:03,000
...لاميس

338
00:23:35,990 --> 00:23:38,380
أتطلّع قُدماً لاستعمالك التّالي لي