1
00:00:01,230 --> 00:00:03,390
!قد تربح سلعة إضافيّة

2
00:00:09,030 --> 00:00:10,580
!مرحباً بك

3
00:00:11,300 --> 00:00:13,080
!لذيذ

4
00:00:12,370 --> 00:00:14,980
إنّه أطيب مذاقاً حتّى عندما
يكون الجوّ حارّاً هكذا

5
00:00:15,270 --> 00:00:19,620
!أحبّ رؤية وجوه زبائني السّعيدة

6
00:00:20,690 --> 00:00:23,930
!لا بُدّ من تناول آيس كريم في يوم ساخن

7
00:00:23,930 --> 00:00:26,880
!لكن كانت تلك الفاكهة المُجمّدة لذيذة أيضاً

8
00:00:27,290 --> 00:00:29,290
!فاكهة مُجمّدة؟

9
00:00:29,290 --> 00:00:31,170
المُثلّجة؟

10
00:00:31,170 --> 00:00:32,840
!هذا صحيح يا هاكّون

11
00:00:32,840 --> 00:00:34,960
!انظر، كيكويو تبيعها هناك

12
00:00:35,290 --> 00:00:36,790
!مرحباً

13
00:00:36,790 --> 00:00:38,060
!تفضّلوا

14
00:00:38,510 --> 00:00:39,810
!تبدو لذيذة

15
00:00:39,810 --> 00:00:41,560
!شكراً على القدوم

16
00:00:41,560 --> 00:00:42,520
!كيكويو

17
00:00:42,520 --> 00:00:45,560
!لم أتوقّع أقلّ من ذلك من مُنافستي في العمل

18
00:00:45,560 --> 00:00:47,110
!كيكويو-تشان

19
00:00:47,110 --> 00:00:50,520
لكنّها كبرت الآن على ما أعتقد

20
00:00:50,520 --> 00:00:54,310
أصبحت ماهرة في تجميد الأشياء
منذ نضجت، أليس كذلك؟

21
00:00:54,310 --> 00:00:57,050
إذاً إنّها تُجمّد وتبيع فاكهة طازجة؟

22
00:00:57,050 --> 00:00:58,700
يبدو عملاً ممتازاً

23
00:00:58,700 --> 00:01:01,570
!العنب المُجمَّد كان شهيّاً حقّاً

24
00:01:01,870 --> 00:01:04,190
!ربّما سأجرّبه أيضاً

25
00:01:04,190 --> 00:01:07,080
!وحتّى أنّها تغوي زميلاتي؟

26
00:01:07,080 --> 00:01:10,450
!لن أسقط دون مُقاومة

27
00:01:18,960 --> 00:01:20,850
من الخارج، صندوق فولاذيّ مُستطيل

28
00:01:20,850 --> 00:01:22,850
!ويوجد بداخله روح بشريّ

29
00:01:22,850 --> 00:01:28,610
في عالم من الأعاجيب، أركب
على ظهر شريكتي لاميس

30
00:01:28,610 --> 00:01:31,000
!أنا هاكّون! مرحباً بك

31
00:01:31,000 --> 00:01:32,740
"!هذا يعني "أجل

32
00:02:45,830 --> 00:02:48,350
!اليوم لدينا خوخ

33
00:02:49,940 --> 00:02:52,780
.كلّها مُقطَّعة لسهولة الأكل
ألن تُجرّبوا واحدة؟

34
00:03:00,780 --> 00:03:03,870
!أتعتقدين بأنّني لم أرَ ابتسامة النّصر تلك؟

35
00:03:03,870 --> 00:03:06,170
!حسناً، ابتسمي ما دمتِ تستطيعين

36
00:03:06,170 --> 00:03:08,290
!سأزيل تلك الابتسامة عن وجهكِ

37
00:03:08,290 --> 00:03:10,680
!يبدأ هجومي الحقيقيّ الآن

38
00:03:14,040 --> 00:03:17,780
وجنّدتُ لاميس وميشويل لتقديم
!المُساعدة في هذا الصّباح

39
00:03:17,780 --> 00:03:22,750
مرحباً بكم! نحن نبيع آيس كريم
!بكريمة إضافيّة اليوم

40
00:03:22,750 --> 00:03:27,050
اليوم فقط! آيس كريم عالية الجودة
!بسعر مُخفَّض

41
00:03:32,870 --> 00:03:36,490
كيكويو، كنتِ خصماً جديراً. أهنّئكِ

42
00:03:36,490 --> 00:03:40,060
!لكن هذه هي القوّة الحقيقيّة لآلات البيع

43
00:03:40,510 --> 00:03:42,470
،في اليوم المُوالي، لسبب ما

44
00:03:42,470 --> 00:03:45,570
!تجمّع جمهورٌ ضخمٌ حول عربة كيكويو

45
00:03:45,580 --> 00:03:47,410
!تفضّلوا وزورونا

46
00:03:46,720 --> 00:03:48,940
!لدينا فاكهة مُجمَّدة باردة جدّاً

47
00:03:48,940 --> 00:03:51,080
!إنّها شهيّة حقّاً

48
00:03:50,190 --> 00:03:51,960
!تعالوا وجرّبوها

49
00:03:55,950 --> 00:03:58,850
!استدعتْ تعزيزات من طبقة بُحيرة التدفُّق النّقيّ

50
00:03:58,850 --> 00:04:00,970
!انجذبوا الشّرهون إلى هنا بمُجرّد ذِكر الطّعام

51
00:04:00,970 --> 00:04:03,970
أعتقد سيترتّب عليّ إخراج
!أوراقي القويّة أيضاً

52
00:04:10,970 --> 00:04:13,160
!مُحال أن أخسر الآن

53
00:04:13,160 --> 00:04:14,470
!النّصر لي

54
00:04:17,260 --> 00:04:22,710
لكن معركة المبيعات الّتي دامت أربعة أيّام
انتهت بإفلاسي أنا وكيكويو

55
00:04:23,270 --> 00:04:25,890
،عندما كافأنا مُساعدينا بدعوتهم إلى وليمة

56
00:04:25,890 --> 00:04:28,740
،فإنّ فواتير شوي وفِرقة الشّرهين

57
00:04:28,740 --> 00:04:31,250
الّذين استغلّوا ذلك كفُرصة لطلب
،أغلى الأطعمة وأفخرها

58
00:04:31,250 --> 00:04:33,130
فاقت دخلنا بكثير

59
00:04:33,610 --> 00:04:37,150
بصيغة أُخرى، انتهت المعركة بهزيمة مُتبادَلة

60
00:04:37,150 --> 00:04:39,010
!أحمق

61
00:04:40,660 --> 00:04:43,280
،بعد إنجاز التزاماتنا في تلك الطّبقة

62
00:04:43,280 --> 00:04:47,000
عدنا إلى طبقة بُحيرة التدفُّق النّقيّ

63
00:04:47,000 --> 00:04:49,300
كنتُم خير مُعين

64
00:04:49,300 --> 00:04:50,860
شكراً جزيلاً على كلّ شيء

65
00:04:53,130 --> 00:04:54,370
كيكويو؟

66
00:04:55,150 --> 00:04:57,160
هل حدث شيء لها؟

67
00:04:59,810 --> 00:05:01,830
!هذا لطيفٌ جدّاً

68
00:05:01,830 --> 00:05:04,460
!في نهاية المطاف، لا شيء يفوق الدّيار

69
00:05:04,460 --> 00:05:07,290
!هاكّون. كالعادة من فضلك

70
00:05:07,290 --> 00:05:09,790
مشروباتك تُنشّطني دوماً

71
00:05:10,120 --> 00:05:11,270
!نقرة

72
00:05:11,540 --> 00:05:13,100
شكراً جزيلاً لك

73
00:05:14,130 --> 00:05:16,400
مضى على عودتنا بضعة أيّام الآن

74
00:05:16,400 --> 00:05:17,890
أعتقد سيحلّ الخريف قريباً

75
00:05:18,540 --> 00:05:21,870
ما يعني بأنّه مضى على وجودي
هنا حوالي سنة الآن

76
00:05:21,870 --> 00:05:23,690
...أشعر وكأنّ الوقت مضى بسرعة

77
00:05:24,960 --> 00:05:28,790
لكن أعتقد بأنّ لاميس وهيوليمي كانتا
مشغولتين في الأيّام القليلة الماضية

78
00:05:28,790 --> 00:05:30,550
لأنّهما لم تمرّا

79
00:05:30,850 --> 00:05:32,300
أشعر بالوحشة قليلاً

80
00:05:36,560 --> 00:05:37,620
!هاكّون

81
00:05:37,620 --> 00:05:38,530
لاميس؟

82
00:05:38,530 --> 00:05:41,730
كنتُ مشغولة مُؤخّراً
،فلم نتحدّث كثيراً

83
00:05:41,730 --> 00:05:44,570
لكن كنتُ آمل لو نستطيع إجراء
مُحادثة ليليّة فعليّة

84
00:05:44,570 --> 00:05:45,820
هل هذا مُناسب؟

85
00:05:45,820 --> 00:05:47,280
!مرحباً بك

86
00:05:47,280 --> 00:05:51,290
أيّ رجل يرفض لاميس عندما
!تنظر إليه بهذا الشّكل؟

87
00:05:51,290 --> 00:05:53,530
!أقول وبثِقة: لا

88
00:05:53,530 --> 00:05:56,040
!هيّا! لنذهب إلى خيمتي معاً

89
00:06:01,330 --> 00:06:03,020
ما هذا؟

90
00:06:05,170 --> 00:06:08,730
!عيد ميلاد سعيد يا هاكّون

91
00:06:08,730 --> 00:06:10,510
!إنّه عيد ميلادي؟

92
00:06:10,790 --> 00:06:13,530
،لا نعرف عيد ميلادك بالضّبط

93
00:06:13,530 --> 00:06:16,750
لكن مضى على لقائي الأوّل
،بيني وبينك عام

94
00:06:16,750 --> 00:06:19,350
!لذا ارتأيتُ بأنّنا ينبغي أن نحتفل بعيد ميلادك

95
00:06:19,350 --> 00:06:21,030
آمل ألّا يُزعجك ذلك

96
00:06:22,090 --> 00:06:25,960
أريد أن أشكر لاميس، لكن
!الكلام لا يُسعفني

97
00:06:25,960 --> 00:06:29,540
،أنا مُتفاجئ جدّاً وسعيد في نفس الوقت
!لدرجة قد أتعطّل

98
00:06:29,540 --> 00:06:30,520
شكراً جزيلاً لك

99
00:06:30,520 --> 00:06:32,160
!هذا مُطمئن

100
00:06:35,800 --> 00:06:39,380
وكان ينبغي أن أقول ذلك قبلاً، لكن
!عيد ميلاد سعيد يا كيكويو

101
00:06:39,380 --> 00:06:41,280
ماذا؟ أنا أيضاً؟

102
00:06:41,280 --> 00:06:44,910
هذا صحيح! كان عيد ميلاد كيكويو
!منذ فترة قصيرة أيضاً

103
00:06:44,910 --> 00:06:46,790
!يمكننا إقامة حفلة مُشتركة

104
00:06:46,790 --> 00:06:48,590
!سيكون ذلك مُمتعاً للغاية

105
00:06:50,550 --> 00:06:52,810
شكراً على مُساعدتك

106
00:06:52,810 --> 00:06:57,050
وحميتَ طبقة الأصل من الانهيار

107
00:06:57,050 --> 00:07:01,930
جميعنا أردنا الزّيارة وشكرك
!على كلّ ما فعلته

108
00:07:01,930 --> 00:07:03,690
مهما شكرتُك، لا أوفيك حقّك

109
00:07:03,690 --> 00:07:08,570
هذه شهادةٌ تُمنَح لأولئك الّذين
تعترف بهم رابطة الصّيّادين

110
00:07:09,430 --> 00:07:11,080
أقدّمها لك

111
00:07:13,820 --> 00:07:15,070
!مُفاجأة

112
00:07:26,880 --> 00:07:29,690
كنتُ أفكّر فيما قد يكون مُلائماً

113
00:07:29,690 --> 00:07:32,290
وأتممتُ هذا للتو، لذا آمل أن تقبله

114
00:07:32,290 --> 00:07:35,460
،لقد حسّنتُ مرونة الحِبال المُثبِّتة

115
00:07:35,460 --> 00:07:38,810
لذا يمكنه التّعامل مع التحوُّلات
المُفاجئة بشكل أفضل

116
00:07:38,810 --> 00:07:40,490
!هذا نافعٌ للغاية

117
00:07:40,490 --> 00:07:43,560
!والآن أستطيع التحوُّل متى أردت

118
00:07:43,560 --> 00:07:46,060
إذاً أنا الأخيرة؟

119
00:07:46,060 --> 00:07:49,530
!هديّتي هي... هذه

120
00:07:52,350 --> 00:07:55,400
ذلك الكتاب الّذي أعطيتني إيّاه كان
،يحتوي على صور احتفالات

121
00:07:55,400 --> 00:07:58,930
!لذا أردتُ صنع واحد لعيد ميلادك

122
00:07:58,930 --> 00:08:01,470
المعذرة... هل يُعجبك؟

123
00:08:01,470 --> 00:08:03,630
شكراً جزيلاً

124
00:08:04,170 --> 00:08:08,340
لم أتوقّع أن أرى كعكة عيد
!ميلاد في عالم آخر

125
00:08:08,340 --> 00:08:10,330
...يسرّني أنّني آلة

126
00:08:10,330 --> 00:08:14,570
لو كانت لديّ وظيفة بُكاء، لوقع
!تماس كهربائيّ غالباً

127
00:08:14,890 --> 00:08:16,760
!وهذا لكيكويو

128
00:08:20,600 --> 00:08:23,670
هاكّون، كيكويو، هل يمكنكما نفخ الشّمعات؟

129
00:08:25,580 --> 00:08:28,690
!عيد ميلاد سعيد لكما

130
00:08:37,600 --> 00:08:40,140
!تبّاً، كان ذلك مُفاجئاً للغاية

131
00:08:40,140 --> 00:08:43,080
لم أتوقّع أن أتحوّل إلى آلة بيع

132
00:08:43,080 --> 00:08:46,110
وأتنعّم باحتفال الكثير من النّاس
!بعيد ميلادي

133
00:08:46,110 --> 00:08:48,470
أليس الطّعام شهيّاً؟

134
00:08:48,470 --> 00:08:51,250
!أتمنّى لو أطعمه للأحفاد

135
00:08:51,250 --> 00:08:54,670
أرغب في أخذ كمّية معي أيضاً

136
00:08:55,390 --> 00:08:59,270
،كان الخمر سلساً للغاية
وفيه بعض الحلاوة

137
00:08:59,270 --> 00:09:02,630
!أريد أن أتناول شراباً لذيذاً أيضاً

138
00:09:02,630 --> 00:09:06,020
سيوري-ساما، يمكنكِ تناول هذا
الشّراب الحلو الفوّار

139
00:09:06,020 --> 00:09:09,260
...بعد ذلك، استمتع  الجميع بالوليمة

140
00:09:09,260 --> 00:09:11,890
لكن ما كان ينبغي أن أُخرج الكحول

141
00:09:18,740 --> 00:09:21,170
!هذا مُبالغ به

142
00:09:21,590 --> 00:09:25,890
هاكّون! لديّ اختراع رائع جديد

143
00:09:25,890 --> 00:09:27,900
عليك تفقّده

144
00:09:27,900 --> 00:09:32,850
!أنت لا تصغِ! خذ هذه

145
00:09:33,810 --> 00:09:39,130
!هاكّون، هل أنت بخير؟ أنا بأحسن حال

146
00:09:40,830 --> 00:09:43,930
...أنت لطيف وبارد. شعور رائع

147
00:09:44,390 --> 00:09:48,680
...أتستمتع؟ أنا أستمتع كثيراً

148
00:09:48,680 --> 00:09:51,770
!هذا واضح تماماً! أنا أستمتع كثيراً

149
00:09:51,770 --> 00:09:53,390
!أنا كذلك فعلاً

150
00:09:53,390 --> 00:09:54,780
!مرحباً بك

151
00:09:55,160 --> 00:09:57,180
هذا جيّد

152
00:09:57,180 --> 00:10:02,130
كنتُ قلقة طوال الوقت لدرجة
...كنتُ مُزعجة ربّما

153
00:10:03,010 --> 00:10:05,910
هاكّون... أتسمعني يا هاكّون؟

154
00:10:05,910 --> 00:10:07,490
!مرحباً بك

155
00:10:07,920 --> 00:10:14,090
آمل أن نبقى معاً دائماً... وأبداً

156
00:10:14,090 --> 00:10:15,330
!مرحباً بك

157
00:10:16,020 --> 00:10:19,850
ليتك تستطيع قول كلام أفضل
"من "مرحباً بك

158
00:10:20,170 --> 00:10:25,750
ليتك تستطيع التكلُّم حقّاً

159
00:10:25,750 --> 00:10:29,140
!إنّها ظريفة حتّى عندما تكون هكذا

160
00:10:29,140 --> 00:10:30,900
هزمَتْني شرّ هزيمة

161
00:10:31,370 --> 00:10:33,640
!حسناً، سأُقدّم عرضاً

162
00:10:34,220 --> 00:10:37,990
أنتِ ظريفة عندما تشربين أيضاً

163
00:10:50,540 --> 00:10:52,380
عليّ أن أتكلّم معك اللّيلة

164
00:10:52,380 --> 00:10:54,000
هل أنت مُتفرّغ؟

165
00:10:54,000 --> 00:10:57,040
،في الأيّام القليلة الماضية
بدت تائهة في التّفكير

166
00:10:57,040 --> 00:10:58,570
ربّما السّبب هو ذلك؟

167
00:10:59,040 --> 00:11:00,550
!مرحباً بك

168
00:11:06,050 --> 00:11:07,800
آسفة لمجيئي مُتأخّرة

169
00:11:08,740 --> 00:11:13,550
هاكّون. نفكّر في مُغادرة الدّيماس

170
00:11:13,550 --> 00:11:15,460
راودني إحساس

171
00:11:15,460 --> 00:11:21,670
أعلم بأنّه من الأنانيّ المُغادرة
...قبل مُعالجة الأعطال

172
00:11:22,070 --> 00:11:23,430
!لا، أبداً

173
00:11:23,430 --> 00:11:26,080
أنا مُمتنّ على كلّ ما فعلتِه
!لدرجة مُحال أن أنتقدكِ

174
00:11:26,080 --> 00:11:29,260
ازدادت قوّة سحري منذ أصبحتُ بالغة

175
00:11:29,260 --> 00:11:33,080
أصبحتُ قادرة على سماع صوت
قطعة من هاتاكي

176
00:11:33,640 --> 00:11:37,080
أعتقد إذا أرجعتُ هاتاكي إلى جسده
الأصليّ، فيمكنه أن يحيا من جديد

177
00:11:37,580 --> 00:11:42,340
وسيُمهّد الطّريق لي

178
00:11:42,590 --> 00:11:46,090
كات تعمل بجدّ للّقاء بالشّخص
الّذي وُلِد من جديد كـ حقل

179
00:11:46,090 --> 00:11:48,090
!بالطّبع أنا سعيد لأجلها

180
00:11:48,090 --> 00:11:50,240
هل يمكنني؟

181
00:11:50,240 --> 00:11:51,670
!مرحباً بك

182
00:11:53,140 --> 00:11:56,820
قد تكون هذه آخر مُحادثة تخاطُريّة بيننا

183
00:11:57,240 --> 00:12:02,110
قوّة العالم السّفليّ لا ينبغي أن تكون
كافية للخروج من الدّيماس

184
00:12:02,110 --> 00:12:03,980
كيف تنوين الخروج؟

185
00:12:03,980 --> 00:12:08,840
تقول هيوليمي بأنّني إذا حوّلتُ
،كثيراً من قوّة السّحر إلى دائرة انتقال

186
00:12:08,840 --> 00:12:13,570
فإنّها تستطيع إنشاء طريق مُؤقَّت
إلى الخارج... رُبّما

187
00:12:13,570 --> 00:12:15,910
لكن هذا خطير جدّاً ولا توجد
،ضمانة بأنّه سينجح

188
00:12:15,910 --> 00:12:17,790
لذا لم تنصح بذلك

189
00:12:17,790 --> 00:12:20,330
ألا تعتقدين بأنّ هذا محفوف بالمخاطر؟

190
00:12:20,330 --> 00:12:22,160
أعلم بأنّه كذلك

191
00:12:22,160 --> 00:12:25,980
!لكن أريد إيجاد هاتاكي

192
00:12:28,120 --> 00:12:33,250
إنّه مُهمّ جدّاً بالنّسبة لكِ لدرجة
تُخاطرين بحياتكِ لأجله؟

193
00:12:33,740 --> 00:12:34,540
أجل

194
00:12:35,660 --> 00:12:39,800
لديّ قوّة سحر كافية لإحضار الأطفال أيضاً

195
00:12:39,800 --> 00:12:43,010
سأغادر هذا المكان قريباً

196
00:12:44,050 --> 00:12:47,770
،لكن عندما أنظر إلى وجوهكم جميعاً
تبدأ شجاعتي بالترنُّح

197
00:12:55,380 --> 00:12:57,210
!لا تحزني كثيراً

198
00:12:57,880 --> 00:13:00,820
جُلّ رغبتكِ هي إنقاذ شخص
مُهمّ بالنّسبة لكِ، صحيح؟

199
00:13:01,170 --> 00:13:04,610
!لذا اعتزّي بنفسكِ وقولي وداعاً بفخر

200
00:13:04,610 --> 00:13:07,270
!نحن معاً، لذا سنكون بخير

201
00:13:07,890 --> 00:13:10,150
!أنا مُمتنّ لكلّ ما فعلتِه

202
00:13:10,150 --> 00:13:13,550
شكراً لكِ على كلّ الأوقات الرّائعة
!الّتي منحتِها إيّاها

203
00:13:13,550 --> 00:13:17,090
أنا مُمتنّة لك أكثر

204
00:13:19,750 --> 00:13:24,310
قضيتُ وقتاً رائعاً أيضاً

205
00:13:26,180 --> 00:13:27,760
لنلتقِ ثانية

206
00:13:27,760 --> 00:13:30,630
!لا أطيق انتظار رؤيتك ثانية يا كيكويو

207
00:13:31,960 --> 00:13:34,400
أتطلّع قُدماً لاستخدامك التّالي لي

208
00:13:36,090 --> 00:13:40,910
في الصّباح التّالي، أعطيتُ الرّسائلَ الّتي
تركَتْها كيكويو معي للجميع

209
00:13:41,520 --> 00:13:44,430
آمل أن تلتقي بالشّخص الّذي تهتمّ لأمره

210
00:13:44,430 --> 00:13:45,820
أجل

211
00:13:45,820 --> 00:13:49,930
،إذا كانت هناك أدنى فُرصة لنجاح ذلك
فينبغي أن تُجرّب

212
00:13:49,930 --> 00:13:52,170
أفضل من تفويت الفُرصة والتحسُّر للأبد

213
00:13:52,170 --> 00:13:54,420
الحياة مُوحشة من دونك، أليس
كذلك يا هاكّون؟

214
00:13:54,420 --> 00:13:55,690
!مرحباً بك

215
00:13:57,110 --> 00:14:02,630
الطّبقة المُتبقّية هي طبقة جبل
الكلب وطبقة الأبديّة

216
00:14:02,630 --> 00:14:05,700
هل ينبغي أن نبحث عن طريقة
لدعم قوّاتنا أوّلاً؟

217
00:14:05,700 --> 00:14:09,190
أجل، مُغادرة كيكويو تترك
!ثغرة كبيرة يجب ملؤها

218
00:14:09,190 --> 00:14:10,960
بالفعل

219
00:14:10,960 --> 00:14:13,460
لكن ليس لديّ الكثير من الأشخاص
لأتخلّى عن أحد

220
00:14:13,460 --> 00:14:17,530
كنتُ أُفكّر في دعوة شخص
من قطيع الوحوش الحمقى

221
00:14:17,530 --> 00:14:18,660
!هل أنت مجنون؟

222
00:14:18,660 --> 00:14:20,980
الشّخص الّذي أُفكّر فيه لديه
موهبة بكلّ تأكيد

223
00:14:20,980 --> 00:14:24,410
والقوى الّتي تحتاجها تشكيلتُنا الحاليّة

224
00:14:24,750 --> 00:14:26,420
بغضّ النّظر عن الطّبع

225
00:14:26,420 --> 00:14:30,040
أجل، موهوب بلا شكّ، صحيح؟

226
00:14:30,330 --> 00:14:32,050
بالرّغم من... المشاكل

227
00:14:32,050 --> 00:14:34,290
من المُخيف أن يكون رأي شخصين يعرفانه

228
00:14:34,290 --> 00:14:36,800
سلبيّاً بشأن طبعه وشخصيّته

229
00:14:36,800 --> 00:14:40,310
هل تعرف أين يتواجد عضو قطيع الوحوش هذا؟

230
00:14:40,310 --> 00:14:45,310
لديّ فكرة جيّدة، لكنّها ليست
في أي طبقة سابقة

231
00:14:45,310 --> 00:14:49,130
لذا سيترتّب علينا الذّهاب إلى طبقة
جبل الكلب والبحث

232
00:14:49,130 --> 00:14:52,060
ينبغي لدائرة انتقال أن تُنجز العمل هناك

233
00:14:53,410 --> 00:14:57,280
بعد يومين، وصلنا إلى طبقة جبل الكلب

234
00:14:57,490 --> 00:15:02,300
كما يشير الاسم، هذه طبقة تحتوي
على صخرة عملاقة بهيئة كلب

235
00:15:02,520 --> 00:15:06,020
وإلّا فما هي إلّا طبقة بحريّة
تتوزّع فيها جُزُر صغيرة

236
00:15:06,300 --> 00:15:09,580
سيكون من الرّائع قضاء بعض
!الوقت في صيد السّمك

237
00:15:09,580 --> 00:15:12,300
لطالما عشِقَ القائد كيريويل صيد السّمك

238
00:15:12,300 --> 00:15:16,330
،ليتني أستطيع التمتُّع بأجواء الإجازة

239
00:15:16,330 --> 00:15:18,070
!لكنّنا لسنا هنا للّعب واللّهو

240
00:15:18,860 --> 00:15:20,760
!أنتم هناك

241
00:15:20,760 --> 00:15:22,310
هل أتيتُم عن طريق دائرة الانتقال؟

242
00:15:22,310 --> 00:15:25,130
!أجل، من طبقة بُحيرة التدفُّق النّقيّ

243
00:15:25,130 --> 00:15:26,650
!عظيم

244
00:15:26,650 --> 00:15:29,830
!سأخبر المُدير! انتظروا هنا

245
00:15:29,830 --> 00:15:32,370
هل أتيتم من طبقة أُخرى حقّاً؟

246
00:15:32,370 --> 00:15:33,830
!أجل، صحيح

247
00:15:33,830 --> 00:15:36,750
!إذاً دوائر الانتقال تنجح أخيراً

248
00:15:36,750 --> 00:15:39,700
!يمكننا أخيراً أن نأكل شيئاً غير الطّعام البحريّ

249
00:15:39,700 --> 00:15:42,320
ألم تتكبّدوا أي أضرار من وحوش هنا؟

250
00:15:42,320 --> 00:15:46,320
،نتعرّض لهجمات وحوش مُتكرّرة

251
00:15:46,320 --> 00:15:49,120
لكن وصل بعض الصّيّادين المُذهلين

252
00:15:49,120 --> 00:15:52,650
،قُبيل أن تتوقّف دوائر الانتقال عن العمل

253
00:15:52,650 --> 00:15:54,050
لذا تمكنّا من تدبُّر أنفسنا

254
00:15:55,060 --> 00:15:59,240
أولئك الصّيّادين... هل كانوا قطيع
الوحوش الحمقى؟

255
00:15:59,240 --> 00:16:02,320
صحيح! أتعرفونهم؟

256
00:16:02,320 --> 00:16:04,100
!هذا سيّئ

257
00:16:04,100 --> 00:16:06,480
لكن ربّما لا داعي للقلق، صحيح؟

258
00:16:06,480 --> 00:16:09,820
،أجل، تواصَلوا قبل قليل

259
00:16:10,200 --> 00:16:14,580
لكن لا أعتقد بأنّ المُدير والآخرين
سيتمكّنون من إقناعها

260
00:16:14,580 --> 00:16:15,970
مرحباً، مرحباً

261
00:16:16,330 --> 00:16:18,830
!شكراً على الحضور! جميعكم مُرحّب بكم هنا

262
00:16:18,830 --> 00:16:22,570
يبدو كطفل، لكن أعتقد هذا هو مُدير الطّبقة؟

263
00:16:22,570 --> 00:16:24,700
!المعذرة! مضى وقت طويل

264
00:16:24,700 --> 00:16:26,070
!أجل، بالفعل

265
00:16:26,070 --> 00:16:29,950
!أنا مُدير رابطة الصّيّادين في طبقة جبل الكلب

266
00:16:29,950 --> 00:16:32,080
أحمل رسالة لك من المُدير دُبّ

267
00:16:32,080 --> 00:16:33,410
هلّا قرأتها؟

268
00:16:33,410 --> 00:16:35,340
!حقّاً؟ أعطيني إيّاها

269
00:16:36,580 --> 00:16:41,350
.إذاً لهذا كان الوحوش عدوانيّين كثيراً
!أمسى الأمر مفهوماً

270
00:16:41,350 --> 00:16:44,110
!حسناً، آمل أن تتولّوا أمر الأعطال

271
00:16:44,110 --> 00:16:45,700
!أبلغوني عندما ينتهي كلّ ذلك

272
00:16:45,700 --> 00:16:46,600
!إلى اللّقاء

273
00:16:46,600 --> 00:16:48,360
!لا يمكنك المُغادرة هكذا فحسب

274
00:16:49,860 --> 00:16:52,430
سامحوه على وقاحته رجاء

275
00:16:51,960 --> 00:16:54,350
هذا أشبه بحضانة أطفال

276
00:16:54,760 --> 00:16:59,160
تُفيد الرّسالة بأنّه يريد مُساعدتنا
في البحث عن شخص لأجلكم

277
00:16:59,160 --> 00:17:02,110
يمكننا التحرّي حول الأمر إذا
أخبرتمونا عن سِمات مُحدّد له

278
00:17:02,110 --> 00:17:03,950
نشكركم على ذلك

279
00:17:03,950 --> 00:17:06,170
سأشرح إذاً

280
00:17:09,120 --> 00:17:13,750
،بينما كان هيفي يشرح الوضع
استمتعنا ببعض وقت الفراغ

281
00:17:14,210 --> 00:17:16,910
ماذا سنفعل يا هاكّون؟

282
00:17:16,910 --> 00:17:19,110
أعتقد لا يمكننا السّباحة

283
00:17:19,110 --> 00:17:22,510
وعندما تكون في شاطئ، فما تُريده
!هو صيد السّمك

284
00:17:22,510 --> 00:17:24,160
!سمك، إنّه الوقت

285
00:17:24,880 --> 00:17:28,260
حتّى لاميس الفطِنة لم تُميّز هذا
"!كـ"هيّا إلى صيد السّمك

286
00:17:28,260 --> 00:17:30,890
عدم امتلاكي المُفردات الكاملة
يجعل الأمر صعباً

287
00:17:31,360 --> 00:17:32,660
ماذا عن هذا؟

288
00:17:32,660 --> 00:17:34,160
!هيّا سمك

289
00:17:34,810 --> 00:17:37,740
سمك، إنّه الوقت؟ هيّا سمك؟

290
00:17:37,740 --> 00:17:39,510
تريد الذّهاب لصيد السّمك؟

291
00:17:39,510 --> 00:17:40,780
!أجل! أجل

292
00:17:40,780 --> 00:17:42,760
!لاميس مُذهلة

293
00:17:42,760 --> 00:17:44,780
!ظننتُ أنّ ذلك شاقّ أيضاً

294
00:17:44,780 --> 00:17:47,730
!فعلتُها! أصبتُ في ذلك

295
00:17:47,730 --> 00:17:50,290
صيد سمك؟

296
00:17:51,750 --> 00:17:55,070
أستطيع القيام بهذا النّوع
من صيد السّمك في نهر

297
00:17:55,070 --> 00:17:56,920
!لاميس، هذا ليس صيد سمك في الواقع

298
00:17:56,920 --> 00:17:59,920
أعشق صيد السّمك. يبدو هذا
جيّداً بالنّسبة لي

299
00:17:59,920 --> 00:18:03,420
،بدلاً من ضربهم بصخور أو لكم السّطح

300
00:18:03,420 --> 00:18:05,050
لنُمارس صيد السّمك الهادئ كنوع من التّغيير

301
00:18:05,050 --> 00:18:06,440
!فكرة سديدة

302
00:18:06,440 --> 00:18:08,950
حسناً، ماذا نفعل بالنّسبة للسنّارة؟

303
00:18:08,950 --> 00:18:10,900
أتبحثان عن بضاعة صيد سمك؟

304
00:18:10,900 --> 00:18:13,430
!تفقّدا تشكيلتي

305
00:18:18,010 --> 00:18:20,690
لكن يبدو أنّك لا تبيع سنّارات صيد

306
00:18:20,690 --> 00:18:22,760
ربّما يمكننا إحضار عصا من مكان قريب

307
00:18:22,760 --> 00:18:27,300
وبحسب الصّور على الأكياس، يبدو أنّ
هناك خيوطاً مع عوّامة وخطّاف

308
00:18:27,300 --> 00:18:30,370
وتلك الّتي عبارة عن كلمات فقط هي... طعم؟

309
00:18:30,370 --> 00:18:31,580
!مرحباً بك

310
00:18:31,580 --> 00:18:33,770
!سأذهب وأبحث عن بعض العصي

311
00:18:33,770 --> 00:18:34,590
!حسناً

312
00:18:34,590 --> 00:18:37,030
!لكن يبقى السّؤال المُهمّ

313
00:18:37,030 --> 00:18:42,100
كثير من الفتيات يصرخنَ عندما يرينَ
"!طعم صيد سمك أوّل مرّة. "مُقرف

314
00:18:42,620 --> 00:18:46,350
!يُراودني فضول غريب لرؤية ردّة فعلهما

315
00:18:46,350 --> 00:18:48,740
لا أطيق انتظار رؤية ردّة فعلهما
!الظّريفة النّاجمة عن صدمة

316
00:18:48,740 --> 00:18:50,720
!أنا مُستعدّ تماماً لتسجيل ذلك

317
00:18:51,100 --> 00:18:55,020
.رأيتُ أشياء كهذه في النّهر
رغم أنّه ليس نفسه تماماً

318
00:18:55,020 --> 00:18:58,370
إنّه ليس مُخيفاً مُقارنة ببعض
الوحوش الّذين رأيتُهم

319
00:18:58,370 --> 00:19:00,410
أجل، توقّعت

320
00:19:00,410 --> 00:19:06,120
لن تُصدَما إطلاقاً باعتبارهما اعتادتا
على الوحوش في الأرجاء هنا

321
00:19:06,120 --> 00:19:08,660
!حسناً، لنُزِد الأمر مرحاً

322
00:19:08,660 --> 00:19:11,290
!من يصطاد السّمكة الكبرى يربح

323
00:19:11,290 --> 00:19:12,920
!أجل! سوف أربح في هذه

324
00:19:12,920 --> 00:19:13,890
!مرحباً بك

325
00:19:24,260 --> 00:19:26,020
!أجل، ها أنا ذي

326
00:19:26,020 --> 00:19:27,250
!تعالي

327
00:19:27,820 --> 00:19:30,380
!مرحى! اصطدتُ شيوامي

328
00:19:30,380 --> 00:19:32,130
!لن تهزميني

329
00:19:32,130 --> 00:19:33,150
!سوف أربح

330
00:19:33,150 --> 00:19:35,150
سأدع هيوليمي تحصل على الجائزة

331
00:19:35,150 --> 00:19:36,410
!لكن سأكون الثّاني

332
00:19:36,410 --> 00:19:38,110
!ها أنا ذي

333
00:19:38,940 --> 00:19:39,840
!ستكسرين عصاكِ

334
00:19:39,840 --> 00:19:41,810
!أمسكِ بالخيط، لا بالعصا

335
00:19:47,330 --> 00:19:48,950
!إنّها سمكة وحش

336
00:19:48,950 --> 00:19:50,000
!لا تدعيها تهرب

337
00:19:50,000 --> 00:19:51,660
!سمعتُ بأنّها لذيذة

338
00:19:52,110 --> 00:19:53,700
!عُلِم

339
00:19:54,170 --> 00:19:56,660
إنّه وحش إذاً

340
00:19:54,610 --> 00:19:56,890
!حسناً، لنُواظب على ذلك

341
00:19:56,890 --> 00:19:58,600
!يمكنني اصطياد المزيد بالتّأكيد

342
00:19:57,440 --> 00:20:01,210
هل التقطَ خطّافي شيئاً؟

343
00:20:02,690 --> 00:20:06,670
،قد ينقطع الخيط إذا سحبتُ بقوّة أكبر
!لكن قد يكون هذا صيداً وفيراً

344
00:20:06,670 --> 00:20:08,430
!سأسحبه للأعلى بكامل قوّتي

345
00:20:10,200 --> 00:20:12,390
هل التقطت شيئاً أيضاً؟

346
00:20:12,390 --> 00:20:13,710
!مرحباً بك

347
00:20:13,710 --> 00:20:14,800
هل تحتاج مُساعدة؟

348
00:20:14,800 --> 00:20:16,120
!من فضلك

349
00:20:16,120 --> 00:20:17,550
!دع الأمر لي

350
00:20:21,060 --> 00:20:23,070
هذا محّار ضخم

351
00:20:23,070 --> 00:20:27,040
.لم أرَ وحشاً بهذا الشّكل من قبل
ربّما يكون طفرة

352
00:20:27,040 --> 00:20:28,320
أتعتقدين بأنّه لذيذ؟

353
00:20:28,320 --> 00:20:29,750
لستُ متأكّدة

354
00:20:29,750 --> 00:20:32,340
!يُراودني فضول، لذا لنطبخه

355
00:20:34,030 --> 00:20:35,720
!إنّه يستوي جيّداً

356
00:20:35,720 --> 00:20:38,210
مُعلّم هاكّون، كنتُ أبحث في كلّ مكان

357
00:20:38,210 --> 00:20:40,080
ماذا تفعل هنا؟

358
00:20:40,080 --> 00:20:42,200
!سمكة مُذهلة

359
00:20:42,200 --> 00:20:43,950
!وهل هذا محّار؟

360
00:20:46,460 --> 00:20:48,580
حتّى ميشويل لم يرَ واحداً من قبل؟

361
00:20:48,580 --> 00:20:51,970
في الواقع، لا أطيق انتظار رؤية
!ما بداخله بعد أن يُطبَخ

362
00:20:53,730 --> 00:20:54,690
!لذيذ للغاية

363
00:20:54,690 --> 00:20:56,630
!ميشويل، اصطدت بعضاً أيضاً

364
00:20:56,630 --> 00:20:58,250
بكلّ تأكيد

365
00:20:58,250 --> 00:21:01,400
!لو كانت شوي هنا لأكلت الكثير غالباً

366
00:21:01,400 --> 00:21:02,870
هل ناديتني؟

367
00:21:06,860 --> 00:21:09,860
لا تنظري إليه بهذا الجشع

368
00:21:09,860 --> 00:21:11,460
!كلاهما هنا إذاً

369
00:21:11,460 --> 00:21:14,380
!إذاً يمكن لمشويّات الشّاطئ أن تبدأ

370
00:21:14,710 --> 00:21:17,370
ماذا؟

371
00:21:17,370 --> 00:21:18,310
ما الّذي يجري؟

372
00:21:18,310 --> 00:21:20,860
هل رأيا هذا المحّار من قبل؟

373
00:21:21,830 --> 00:21:25,130
...شوي. أتعتقدين بأنّ هذا

374
00:21:25,900 --> 00:21:29,870
أتعتقد ذلك أيضاً؟ أجل، لا بُدّ أنّه كذلك

375
00:21:43,980 --> 00:21:46,490
!ما الأمر؟ هل كان المحّار وحشاً؟

376
00:21:46,800 --> 00:21:48,810
ما الّذي يجري هنا؟

377
00:21:48,810 --> 00:21:50,150
أستميحك عذراً

378
00:21:50,150 --> 00:21:52,360
بدا ذلك المحّار مألوفاً

379
00:21:57,200 --> 00:21:59,620
كان ذلك حارّاً للغاية

380
00:21:59,620 --> 00:22:04,140
...هذه ليست طريقة للتّعامل مع بيتي
حتّى لو كانت مُنعزلة

381
00:23:35,960 --> 00:23:38,360
أتطلّع قُدماً لاستخدامك التّالي لي