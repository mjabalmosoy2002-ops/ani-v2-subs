1
00:00:01,320 --> 00:00:02,790
!مرحباً بك

2
00:00:09,580 --> 00:00:12,800
مرحباً! أنا هاتاكي، نوكو هاتاكي

3
00:00:12,800 --> 00:00:14,860
"الجميع ينادونني بـ"هاتاكي

4
00:00:15,270 --> 00:00:17,600
،كنتُ تلميذاً عاديّاً في اليابان

5
00:00:17,600 --> 00:00:20,460
ثمّ سرعان ما وجدتُ نفسي قد وُلِدتُ
من جديد في عالم آخر

6
00:00:20,460 --> 00:00:23,930
!لكن على أي هيئة وُلِدت؟ وُلِدتُ كحقل

7
00:00:24,320 --> 00:00:27,880
طولي 100 متر من كلّ جانب، وبعمق 10 أمتار

8
00:00:27,880 --> 00:00:31,370
!والآن، سوف أعرّف عن عائلتي العزيزة

9
00:00:31,680 --> 00:00:35,490
،بريش أسود أملس، وثلاثة عيون
،وثلاثة أرجُل

10
00:00:35,490 --> 00:00:38,020
!إنّه حاكم السّماوات، كوروياتا

11
00:00:39,140 --> 00:00:42,850
وهذا ينقضّ مُسارعاً نحو الخطر
بقرن ظريف ينمو من رأسه

12
00:00:42,850 --> 00:00:43,750
!بوتان

13
00:00:46,160 --> 00:00:49,580
،بأُذنين حادّتين ومظهر ظريف
!إنّها عائلة أوساتّا

14
00:00:49,580 --> 00:00:50,770
!الأب، أوساتّا

15
00:00:51,040 --> 00:00:54,760
.والأمّ أوسّارينا، والابن الأكبر أوساريون
والابنة الكُبرى أوسابّي

16
00:00:55,280 --> 00:00:57,030
وهؤلاء هم أفراد عائلتي

17
00:00:57,430 --> 00:00:59,300
لكن لحظة، هناك المزيد

18
00:00:59,300 --> 00:01:02,210
!لديّ بعض الأصدقاء المُقرّبين أيضاً

19
00:01:02,560 --> 00:01:05,880
كيكويو، جنّية الثّلج الّتي كُبَرْتْ مُؤخّراً

20
00:01:05,880 --> 00:01:09,350
حسناً، نحن مُقرّبان بما يكفي
لتكون فرداً من عائلتي

21
00:01:09,350 --> 00:01:11,530
إنّها تُترجم لي، الأمر الّذي ينفعني كثيراً

22
00:01:12,080 --> 00:01:16,840
ليست غلطتي أن نكاد نقع في الحُبّ
عندما تتلاقى عيوننا

23
00:01:17,120 --> 00:01:22,130
رئيسة المدينة المُحصّنة والجميلة ذات
العينين السّاحرتين، جيسيكا

24
00:01:22,610 --> 00:01:27,060
يبدو ككبير خدَم عجوز شديد، وحادّ
!كالمسمار، ستيك

25
00:01:27,060 --> 00:01:31,100
،وعاشقة الحيوانات جامدة التّعابير
!وسليطة اللّسان في نفس الوقت

26
00:01:31,100 --> 00:01:35,620
لكنّها تُداعبهم وتُدلّلهم كثيراً
!لدرجة الإزعاج، مويدر

27
00:01:36,620 --> 00:01:39,560
!تبدو كفارسة، لكنّها في الواقع أميرة

28
00:01:39,560 --> 00:01:42,520
!لا تدعوا مظهرها الرّهيب يخدعكم

29
00:01:42,520 --> 00:01:45,120
!إنّها مُخيّبة للآمال إلى حدّ مُفاجئ، هاياتشي

30
00:01:45,510 --> 00:01:49,130
ومُستحضرة الأرواح ومصّاصة الدّماء من النّوع
البارد، جِنرال السّاق اليُسرى

31
00:01:49,130 --> 00:01:52,090
!باسم يصعب حفظه، إنّه كيويكوتيك

32
00:01:52,750 --> 00:01:56,730
،بدعم من أولئك الأصدقاء والعائلة

33
00:01:56,730 --> 00:01:59,850
،كنتُ أقضي أيّامي الهادئة والمُملّة كـ حقل

34
00:01:59,850 --> 00:02:02,820
لكن في الواقع، واجهتُ في السّابق
قوّات ملك الشّياطين

35
00:02:03,620 --> 00:02:07,460
بعد نِزال شرِس مع جِنرال السّاق اليُسرى
،السّابق التّابع لملك الشّياطين

36
00:02:07,460 --> 00:02:11,030
تمّت عرقلة وعيي، وفقدتُ إحساسي
بالذّات لبعض الوقت

37
00:02:11,980 --> 00:02:14,820
،مضت الأيّام بينما أنجرف عبر الظُّلُمات فحسب

38
00:02:14,820 --> 00:02:17,750
ثمّ ذات يوم، عندما كدتُ أفقد صوابي
...من شدّة العزلة

39
00:02:17,750 --> 00:02:20,460
أشرقَ النُّور على عالمي من جديد

40
00:02:22,230 --> 00:02:26,750
انقشع الظّلامُ، ووقفَ هناك أصدقائي
وعائلتي في عالم النُّور

41
00:02:26,750 --> 00:02:29,440
حدث ذلك قبل أسابيع قليلة

42
00:02:30,650 --> 00:02:34,000
،بينما كنتُ غائباً عن الوعي

43
00:02:34,000 --> 00:02:37,310
كانت كيويكوتيك تنشر بذور الخُضار
والشّتلات خاصّتي في الأرجاء

44
00:02:37,310 --> 00:02:41,430
تكفّلَ ذلك بأزمة المجاعة السّائدة
في قطّاع ملك الشّياطين

45
00:02:42,180 --> 00:02:44,530
نتيجة ذلك، قرّرَ ملك الشّياطين
بأنّني لستُ ضعيفاً

46
00:02:44,530 --> 00:02:48,010
دُعيتُ إلى قلعته وذلك لإجراء
مُفاوضات سلام

47
00:02:48,010 --> 00:02:51,300
بين قوّاته والمدينة المُحصَّنة

48
00:02:51,800 --> 00:02:53,470
وهذا يُفصّل كلَّ شيء

49
00:02:53,470 --> 00:02:57,170
هاتاكي؟ كنتَ تتكلّم كما لو أنّك تشرح الأمور

50
00:02:57,170 --> 00:02:59,200
ماذا كان كلّ ذلك؟

51
00:02:59,200 --> 00:03:00,320
!كيكويو

52
00:03:00,320 --> 00:03:03,590
!لا أصدّق كم تغيّرتِ وأصبحتِ جميلة

53
00:03:04,170 --> 00:03:06,040
شكراً جزيلاً لك

54
00:03:06,040 --> 00:03:08,960
أشعر بالخجل عندما أسمعك تقول ذلك

55
00:03:08,960 --> 00:03:12,960
نسيتُ تقريباً بأنّها تستطيع
سماع حواري الدّاخليّ

56
00:03:12,960 --> 00:03:15,670
ما كلّ هذه المُغازلة؟

57
00:03:15,670 --> 00:03:18,450
أليس لديك ما تقوله لي؟

58
00:03:18,450 --> 00:03:20,500
كيويكوتيك

59
00:03:20,500 --> 00:03:22,740
رغم أنّها حلّتْ أزمة مجاعة عالم الشّيطان

60
00:03:22,740 --> 00:03:25,810
،وأصبحت جِنرال السّاق اليُسرى الجديدة

61
00:03:25,810 --> 00:03:28,820
تقضي كلّ أيّامها تعمل في حدائقي

62
00:03:29,260 --> 00:03:30,970
لكن أتعلم؟

63
00:03:31,230 --> 00:03:36,250
أصبحتَ ماهراً في التحرُّك. بالكاد
أشعر باهتزاز بعد الآن

64
00:03:36,730 --> 00:03:38,770
هذا صحيح

65
00:03:39,230 --> 00:03:44,690
أجل! أنا حاليّاً في الطّريق إلى قلعة
!ملك الشّياطين

66
00:03:53,000 --> 00:03:54,920
من الخارج، صندوق فولاذيّ مُستطيل

67
00:03:54,920 --> 00:03:56,800
!ويوجد بداخله روح بشريّ

68
00:03:56,800 --> 00:04:02,640
في عالم من الأعاجيب، أركب
على ظهر شريكتي لاميس

69
00:04:02,640 --> 00:04:05,070
!أنا هاكّون! مرحباً بك

70
00:04:05,070 --> 00:04:06,820
"!هذا يعني "أجل

71
00:05:20,960 --> 00:05:24,600
قلعة ملك الشّياطين. لا أطيق الانتظار

72
00:05:24,600 --> 00:05:26,540
إنّه رجلٌ جيّد

73
00:05:26,540 --> 00:05:30,850
تكلّمنا الآن فأصبحنا صديقين مُقرّبين مع الوقت

74
00:05:31,410 --> 00:05:33,750
بالكاد تُشرق الشّمس في عالم الشّيطان

75
00:05:33,750 --> 00:05:36,350
إنّها أرضٌ قاحلة حيث لا تنمو المحاصيل

76
00:05:36,350 --> 00:05:38,950
لكن كنتُ أعمل

77
00:05:38,950 --> 00:05:43,290
على تحسين الخضراوات الّتي أزرعها
من مُستنبتات مُقاومة للجفاف

78
00:05:44,200 --> 00:05:49,250
،انتشرت في أرجاء عالم الشّيطان
لتُخفّف عوزه للغذاء

79
00:05:49,250 --> 00:05:52,970
،لم يعودوا بحاجة لمُهاجمة بلاد أُخرى
لذا توقّفوا عن الغزو

80
00:05:53,770 --> 00:05:59,650
منذ ذلك الحين، الجميع في عالم الشّيطان
عاملوني كبطل

81
00:05:59,650 --> 00:06:01,870
!أجل، أنا، الحقل

82
00:06:03,470 --> 00:06:05,870
ها أنت تتواضع من جديد

83
00:06:05,870 --> 00:06:09,740
كنتَ أنت من تمكّن من صنع
تلك الخُضراوات الصّلبة

84
00:06:09,740 --> 00:06:11,670
شكراً يا كيكويو

85
00:06:11,670 --> 00:06:17,390
أجل، بينما كنتُ نائماً، التقيتِ برجل
يابانيّ آخر وُلِدَ من جديد في هذا العالم

86
00:06:17,390 --> 00:06:18,600
حبّذا لو تُحدّثينني عنه

87
00:06:19,020 --> 00:06:21,140
بالتّأكيد، أتمنّى ذلك

88
00:06:21,140 --> 00:06:26,460
تخيّلوا فحسب، شخص غيري قد خُلِق
من جديد هنا من اليابان

89
00:06:27,170 --> 00:06:30,330
والمُفاجئ أنّه آلة بيع على ما يبدو

90
00:06:30,330 --> 00:06:33,530
!أقصد، خُلِقَ من جديد كآلة بيع؟

91
00:06:33,530 --> 00:06:36,410
أيحقُّ لي قول ذلك وأنا الّذي
!وُلِدَ من جديد كـ حقل؟

92
00:06:36,410 --> 00:06:40,110
"أنا متأكّدة بأنّه قال بأنّه "آلة بيع

93
00:06:46,470 --> 00:06:50,800
،يبدو أنّه ساعدكِ. لذا حالما تُعالَج مشاكلنا هنا

94
00:06:50,800 --> 00:06:53,060
أفكّر في أن نذهب ونُعينه في مُشكلته

95
00:06:53,820 --> 00:06:58,410
لا أصدّق بأنّ جِنرال الذّراع اليُسرى
كان يحيك المُؤامرات داخل الدّيماس

96
00:06:58,680 --> 00:07:02,940
سأرافقك مهما حدث يا هاتاكي

97
00:07:03,220 --> 00:07:07,430
لكن في تلك الحالة، لن أتمكّن تماماً
من طلب المُساعدة من كيويكوتيك

98
00:07:07,430 --> 00:07:11,490
بما أنّها جِنرال السّاق اليُسرى الجديدة
في جيش ملك الشّياطين

99
00:07:11,490 --> 00:07:13,940
لكن أعتقد بأنّني سأجرّب السّؤال على أيّ حال

100
00:07:14,150 --> 00:07:16,920
بالتّأكيد، سأبقى معك

101
00:07:16,920 --> 00:07:19,890
ملك الشّياطين هو زعيمي فحسب
في نهاية المطاف

102
00:07:19,890 --> 00:07:23,660
أنت من أنقذ هذا العالم وقريتي

103
00:07:23,660 --> 00:07:25,710
لا تُسئ الفهم

104
00:07:25,710 --> 00:07:30,220
.ليس وكأنّني أضمر مشاعر تجاهك
أريد فقط ردّ الجميل

105
00:07:30,220 --> 00:07:32,200
!إنّها من النّوع البارد المُثير المثاليّ

106
00:07:32,200 --> 00:07:37,250
أحبُّ المُزاح فحسب، لكن سأقبل
سلوكها دون تمحيص

107
00:07:37,250 --> 00:07:40,090
من الصّعب إيجاد حليف أفضل

108
00:07:40,090 --> 00:07:45,480
.قوّة كيويكوتيك في التحكُّم بالموتى مُفيدة
والكيمياء بيني وبينها جيّدة

109
00:07:45,480 --> 00:07:48,450
الكيمياء معي ليست سيّئة أيضاً

110
00:07:49,570 --> 00:07:51,470
أجل، أنتِ مُحقّة تماماً

111
00:07:53,740 --> 00:07:56,230
هذه هي قلعة ملك الشّياطين إذاً

112
00:08:02,870 --> 00:08:06,380
ها هو ذا. يبدو دمِثاً كعادته

113
00:08:06,650 --> 00:08:10,250
يتمتّع بالقوّة والمظهر، ناهيك عن الهيبة

114
00:08:10,930 --> 00:08:13,760
في العادة، كنتُ لأعترف بأنّه
يتفوّق عليّ في كلّ شيء

115
00:08:13,760 --> 00:08:15,470
!لكن مع الأسف

116
00:08:15,470 --> 00:08:18,160
!لا تستطيع صنع خضراوات لذيذة

117
00:08:18,640 --> 00:08:21,550
!لذلك لستُ مُستاء على الإطلاق

118
00:08:22,030 --> 00:08:24,900
حسناً، لنكتفِ بهذا القدر من الغيرة

119
00:08:24,900 --> 00:08:27,250
ذلك الرّجل هناك هو جِنرال الذّراع اليمنى

120
00:08:27,560 --> 00:08:31,080
مظهره يُوحي بأنّه رجلٌ أنيق في الخمسينيّات

121
00:08:31,080 --> 00:08:34,580
إذا كبرتُ في السنّ كبشريّ، فغالباً
سيكون شكلي هكذا

122
00:08:35,460 --> 00:08:38,820
،آسف، لكن لا. مهما بذلتُ من جهد
لن أبلغ تلك النّتيجة

123
00:08:48,240 --> 00:08:50,580
اعذرني لأنّني دستُ عليك

124
00:08:50,860 --> 00:08:53,590
حسناً، هنا يبدأ الجِدّ

125
00:08:53,590 --> 00:08:57,030
آمل فحسب أن تسير مُفاوضات
السّلام دون عقبات

126
00:08:59,840 --> 00:09:02,230
مضى وقت طويل يا هاتاكي

127
00:09:02,230 --> 00:09:05,320
وجِنرال السّابق اليُسرى كيويكوتيك

128
00:09:05,320 --> 00:09:06,970
هذا صحيح يا سيّدي

129
00:09:09,530 --> 00:09:10,970
!وقت طويل

130
00:09:10,970 --> 00:09:15,740
أجل، لم أرك منذ وقت طويل. ولا حاجة
للرّسميّات يا كيويكوتيك

131
00:09:15,740 --> 00:09:17,140
أليس كذلك يا جِنرال الذّراع اليُمنى؟

132
00:09:17,140 --> 00:09:21,750
،هذه الأرض مَدينة لهاتاكي-ساما بالكثير
لذا هو حالة استثنائيّة

133
00:09:21,750 --> 00:09:23,820
...ولذا، أجل

134
00:09:24,480 --> 00:09:26,300
حلقي جافّ جدّاً

135
00:09:26,300 --> 00:09:29,620
أرغب في تبليله

136
00:09:29,620 --> 00:09:33,120
أعرف ما يريده، وهو يعرف بأنّني أعرف

137
00:09:36,250 --> 00:09:38,010
تفضّل

138
00:09:38,010 --> 00:09:41,140
عصير فاكهة اليوم مصدره باريم
معصور حديثاً

139
00:09:42,040 --> 00:09:44,140
إذاً سأُشارك

140
00:09:51,270 --> 00:09:54,310
!مولايّ! هل يُعقَل أنّه كان مُسمّماً؟

141
00:09:54,310 --> 00:09:55,650
!لـ-لحظة

142
00:09:56,720 --> 00:09:59,740
كان شهيّاً جدّاً لدرجة شعرتُ
فيها بالإغماء

143
00:09:59,740 --> 00:10:02,030
جرّب جرعة بنفسك

144
00:10:02,030 --> 00:10:03,260
تفضّل

145
00:10:20,040 --> 00:10:21,860
أحسنت صنعاً في الحِفاظ على هدوئك

146
00:10:21,860 --> 00:10:23,810
!يمكنك الحصول على هذه كمُكافأة

147
00:10:31,380 --> 00:10:33,060
!ما-ما هذه؟

148
00:10:33,060 --> 00:10:37,260
لنرَ إن كنت تستطيع تحمُّل
!هذا الهجوم يا ملك الشّياطين

149
00:10:41,310 --> 00:10:43,210
يبدو أنّك مُستمتع بوقتك يا هاتاكي

150
00:10:43,210 --> 00:10:45,070
أجل، كثيراً

151
00:10:53,860 --> 00:10:56,220
!مـ-مذاقه لذيذ جدّاً

152
00:10:57,080 --> 00:11:00,100
لعلّي بالغتُ في فعلها قليلاً
من حيث الغذاء والأومامي

153
00:11:00,620 --> 00:11:02,710
أتريد تأجيل مُفاوضات السّلام إلى يوم غد؟

154
00:11:02,710 --> 00:11:04,980
لا، لنُنجز الأمر اليوم

155
00:11:07,380 --> 00:11:12,480
حسناً، الآن ستتوقّف قوّات ملك
الشّياطين عن مُهاجمة المدينة المُحصَّنة

156
00:11:14,480 --> 00:11:17,060
أوسابّي، أوساريون

157
00:11:17,060 --> 00:11:19,230
ولا بُدّ من وجود شيء في الدّاخل هناك

158
00:11:19,490 --> 00:11:25,630
ظننتُ بأنّ الأوساتّا كانوا يتحرّون
حول غابة القتل مع هاياتشي

159
00:11:25,630 --> 00:11:28,760
...لنرَ. جِنرال الذّراع اليُسرى

160
00:11:29,210 --> 00:11:30,560
!ماذا؟

161
00:11:30,560 --> 00:11:33,630
ما الفكرة من ذلك وفي مُنتصف
!مُفاوضات السّلام؟

162
00:11:33,630 --> 00:11:35,130
هل من مُشكلة؟

163
00:11:37,100 --> 00:11:42,120
سرقَ قوّةَ الدّيماس ويزحف نحو
المدينة المُحصَّنة

164
00:11:42,120 --> 00:11:42,840
أنت

165
00:11:43,400 --> 00:11:47,270
إذاً الذِّراع اليُسرى فعلها أخيراً

166
00:11:47,680 --> 00:11:49,650
هل كان هذا بأوامر منك؟

167
00:11:49,650 --> 00:11:51,640
لم يكن كذلك بالطّبع

168
00:11:51,640 --> 00:11:54,580
جِنرال الذّراع اليسرى فعل هذا
من تلقاء نفسه

169
00:11:54,580 --> 00:11:57,780
،لطالما عرفتُ بأنّه خائن

170
00:11:57,780 --> 00:12:01,150
لكن الحصول على قوّة الدّيماس
قد جعله يغترّ بنفسه

171
00:12:01,150 --> 00:12:04,410
إذاً لا مُشكلة إذا سحقتُ الذِّراع اليُسرى؟

172
00:12:04,410 --> 00:12:06,760
أبداً، افعل ما تشاء

173
00:12:06,760 --> 00:12:09,290
بل وسأُرسِل تعزيزات إن أحببت

174
00:12:10,010 --> 00:12:13,540
هلّا سمحت لي بأداء ذلك الواجب؟

175
00:12:13,540 --> 00:12:16,540
.هذا ما كنتُ أُفكّر فيه أيضاً
أترك الأمر كلّه لكِ

176
00:12:16,540 --> 00:12:18,390
عُلِم. اعتمد عليّ

177
00:12:20,550 --> 00:12:23,360
كتبنا رسالةً مفادها بأنّ ملك
،الشّياطين ليس خصمنا

178
00:12:23,360 --> 00:12:27,170
وطلبنا من كوروياتا أن يسبقنا ويحلّق
نحو المدينة المُحصّنة

179
00:12:27,470 --> 00:12:32,080
غادرنا الآن عالمَه وينبغي أن نصل
عمّا قريب إلى المدينة

180
00:12:32,440 --> 00:12:38,170
على ذكر الأمر. حالما نصل إلى هناك، سيترتّب
عليّ التكلُّم مع الآنسة جيسيكا

181
00:12:38,590 --> 00:12:44,510
،كُلّ ما في الأمر أنّه حالما تتلاقى عيوننا
أنسى نفسي وأدخل في حالة ذهول

182
00:12:46,750 --> 00:12:50,560
تبدو سعيداً حقّاً عندما تتكلّم
مع جيسيكا يا هاتاكي

183
00:12:50,560 --> 00:12:54,480
هذا صحيح، بالفعل. مع أنّك
لا تتصرّف بهذه الطّريقة تجاهي

184
00:12:54,480 --> 00:12:58,210
لا أملك أدنى فكرة عمّا تتحدّثان عنه

185
00:12:58,610 --> 00:13:01,560
،لا أعرف لماذا أنتما بمزاج عكِر

186
00:13:01,560 --> 00:13:04,090
لكن تفضّلا، تناولا أوتسوغا على حسابي

187
00:13:04,090 --> 00:13:06,960
لـ-لا يمكنك خداعنا بهذه الطّريقة

188
00:13:06,960 --> 00:13:09,010
أ-أجل، معها حقّ

189
00:13:09,010 --> 00:13:11,740
لا يمكنك إغراؤها بالفاكهة

190
00:13:11,740 --> 00:13:14,330
هيّا، ألا تريدانها؟

191
00:13:14,330 --> 00:13:16,250
أعلم بأنّكما تُريدانها

192
00:13:16,250 --> 00:13:17,640
هيّا، كونا صريحتين

193
00:13:17,640 --> 00:13:19,350
أنت مُخيف يا هاتاكي

194
00:13:19,350 --> 00:13:21,720
ماذا؟ ما الّذي كان يُفكّر فيه؟

195
00:13:22,140 --> 00:13:23,410
...سأُخبركِ

196
00:13:24,230 --> 00:13:25,750
...تحديق

197
00:13:26,090 --> 00:13:29,040
أنتما تتّفقان مع بعضكما الآخر
فعلاً في أوقات كهذه

198
00:13:33,990 --> 00:13:39,800
!هاتاكي! هاتاكي! هاتاكي

199
00:13:39,800 --> 00:13:41,640
!هاتاكي

200
00:13:46,720 --> 00:13:50,580
أهلاً بعودتك أيُّها الحارس

201
00:13:51,340 --> 00:13:52,800
تسرّني عودتي

202
00:13:52,800 --> 00:13:54,920
يسرّني أنّك تبدو بخير

203
00:13:58,000 --> 00:14:01,070
!أشعر وكأنّ تُربتي ستذوب

204
00:14:01,070 --> 00:14:02,090
!اصمد

205
00:14:02,090 --> 00:14:04,270
!جيسيكا رجل! جيسيكا رجل

206
00:14:04,270 --> 00:14:06,190
!لا تخذليني يا قوى المنطق

207
00:14:06,190 --> 00:14:11,200
جي-سي-كا، أنتِ تجعلين هاتاكي
يشعر بعدم ارتياح

208
00:14:11,200 --> 00:14:13,320
من فضلكِ ابتعدي عنه حالاً

209
00:14:13,320 --> 00:14:16,210
هل أنت غير مرتاح أيُّها الحارس؟

210
00:14:16,460 --> 00:14:19,590
هل من السيّئ أن أعانقك؟

211
00:14:19,590 --> 00:14:24,800
"أيّ رجل في هذا العالم يستطيع قول "نعم
عند النّظر إلى هاتين العينين؟

212
00:14:24,800 --> 00:14:27,200
!لا، يمكنني القول بأمان بأنّها غير موجودة

213
00:14:27,200 --> 00:14:30,040
هذا يجعلك غير مرتاح، صحيح؟

214
00:14:30,040 --> 00:14:32,690
أجل يا هاتاكي. أليس كذلك؟

215
00:14:32,690 --> 00:14:35,720
!تمّ عرقلة التّراجع

216
00:14:35,720 --> 00:14:37,600
!طلب التّعزيزات، على الفور

217
00:14:39,340 --> 00:14:41,790
...هُجرتُ بواسطة عائلتي

218
00:14:43,940 --> 00:14:46,760
هذه فُرصتك لتوضيح الأمر

219
00:14:46,760 --> 00:14:50,110
مَن بيننا نحن الثّلاثة تختار يا هاتاكي؟

220
00:14:50,110 --> 00:14:52,650
هذا اقتراح مُلفت

221
00:14:52,650 --> 00:14:55,360
،ليس لديّ أي اهتمام بك

222
00:14:55,360 --> 00:14:59,960
لكن إذا أصررت بأنّك تريد أن تكوني
معي، فسوف أُفكّر في الأمر

223
00:14:59,960 --> 00:15:03,240
إذا اخترتني، فسأكرّس حياتي لأجلك

224
00:15:03,480 --> 00:15:06,620
!فليهدأ الجميع! أنا حقل

225
00:15:06,620 --> 00:15:09,380
لستُ شخصيّة مُلائمة لمثل هذه
!الرّومانسيّة الكوميديّة

226
00:15:09,380 --> 00:15:10,240
!هيّا

227
00:15:10,240 --> 00:15:11,910
!أنتُن، كُنّ عاقلات

228
00:15:11,910 --> 00:15:14,730
!أنا حقل! أنا تُربة! أنا غير عضويّ

229
00:15:14,730 --> 00:15:15,520
!هيّا

230
00:15:15,520 --> 00:15:17,200
!أجل! أستطيع فعل هذا دوماً

231
00:15:19,700 --> 00:15:24,340
يمكنكن تناول هذه، إذا كان كلّ ما نُفكّر فيه
هو خطّة لإسقاط جِنرال الذّراع اليُسرى

232
00:15:24,970 --> 00:15:26,430
حسناً

233
00:15:26,430 --> 00:15:29,660
إذاً لنُشارك الأوتسوغا بعد
عقد مجلس حربنا

234
00:15:29,660 --> 00:15:30,500
حسناً

235
00:15:31,000 --> 00:15:33,780
يبدو أنّني تمكّنتُ من تغيير الموضوع

236
00:15:33,780 --> 00:15:36,340
!وهذه حالة طارئة للمدينة المُحصَّنة

237
00:15:36,340 --> 00:15:39,040
!ألا ينبغي أن نبدأ المجلس فوراً؟

238
00:15:39,040 --> 00:15:40,910
يبدو أنّ التّمثيليّة قد انتهت

239
00:15:40,910 --> 00:15:44,030
لنبدأ مجلس الحرب إذاً

240
00:15:44,030 --> 00:15:46,960
!يبدو أنّ وقت المُواجهة قد اقترب

241
00:15:52,050 --> 00:15:55,710
التمكُّن من أكل طعام دافئ في ساحة
المعركة دون أي تحضير؟

242
00:15:55,710 --> 00:15:56,900
!هذا هو الأفضل

243
00:15:56,900 --> 00:15:58,310
بكلّ تأكيد

244
00:15:58,310 --> 00:16:01,070
!هيوليمي! لنأكل

245
00:16:01,070 --> 00:16:03,550
سأفعل، حالما أنتهي من تنصيب هذا

246
00:16:03,950 --> 00:16:07,620
هيوليمي تُطوّر العربة الّتي كانت
مجموعة القائد كيريويل تستخدمها

247
00:16:07,620 --> 00:16:10,550
بحيث تُرفَق بالشّاحنة

248
00:16:12,030 --> 00:16:14,300
أمطرتْ في النّهاية

249
00:16:14,300 --> 00:16:15,920
كنتُ قد أوشكتُ على الانتهاء أيضاً

250
00:16:15,920 --> 00:16:18,150
!هذه هي إشارتي

251
00:16:20,070 --> 00:16:24,780
هذه آلة بيع بونتشو، كالّتي تراها في المركبات
المائيّة في الحدائق النّموذجيّة

252
00:16:26,410 --> 00:16:28,500
!هذا ما احتجتُه بالضّبط يا هاكّون

253
00:16:29,410 --> 00:16:32,160
بنينا ملجأ من الكتل الخرسانيّة العملاقة

254
00:16:32,160 --> 00:16:34,190
الّتي أستطيع صنعها عندما
أكون آلة البيع الضّخمة

255
00:16:34,190 --> 00:16:40,200
سيرتاح الصّيّادون الجرحى هناك
بينما نُسارع في التقدُّم

256
00:16:40,810 --> 00:16:44,740
إذاً، إن سلكنا هذا الطّريق، سنصل
إلى غابة المذبحة؟

257
00:16:44,740 --> 00:16:46,160
"غابة القتل"

258
00:16:46,160 --> 00:16:48,380
أعتقد بأنّنا نقترب أيضاً

259
00:16:50,600 --> 00:16:51,830
...الغابة

260
00:16:53,870 --> 00:16:59,200
ما سيأتي تالياً سيتغيّر اعتماداً على فيما
كان من فعل هذا وحوشٌ أو جماعتنا

261
00:16:59,200 --> 00:17:03,790
لنرَ. الأشخاص الّذين سبقونا كانوا
المُدير دُبّ، وهيفي

262
00:17:03,790 --> 00:17:07,160
والحارسان، وميشويل

263
00:17:07,160 --> 00:17:09,460
!سيف التنّين الكبير الخاصّ بميشويل

264
00:17:09,460 --> 00:17:13,100
معكِ حقّ. ربّما كان يحاول عرقلة العدوّ إذاً

265
00:17:13,670 --> 00:17:18,350
هل بقي هنا لوحده لإشغال الأعداء؟

266
00:17:18,810 --> 00:17:23,610
!مُعلّم هاكّون

267
00:17:20,590 --> 00:17:21,560
!هذا الصّوت

268
00:17:23,610 --> 00:17:26,360
!مُعلّم هاكّون، أنت بأمان

269
00:17:26,360 --> 00:17:29,360
!لم... لم أتوقّف عن الإيمان يوماً

270
00:17:29,360 --> 00:17:32,260
أ-ي-هـ-ا ال-تل-مي-ـذ أح-س-نت ص-ن-ع-اً

271
00:17:32,260 --> 00:17:33,110
!شكراً

272
00:17:34,350 --> 00:17:36,530
هل كان هذا من صنيعك يا ميشويل؟

273
00:17:36,530 --> 00:17:38,150
أجل، هذا صحيح

274
00:17:38,150 --> 00:17:41,280
اعتقدنا بأنّنا سنكسب الوقت
،من خلال نصب الفِخاخ

275
00:17:41,280 --> 00:17:44,230
لكن انتهى المطاف بالدّوس عليهم
بواسطة وحش عملاق

276
00:17:44,230 --> 00:17:47,390
كان الخيار الوحيد المُتبقّي هو
إشعال حريق في الغابة

277
00:17:47,390 --> 00:17:50,820
ميشويل، قلتَ "نحن". هل يوجد
شخصٌ آخر هنا؟

278
00:17:50,820 --> 00:17:54,900
أجل، أختي وأصدقاؤها ساعدوني

279
00:17:54,900 --> 00:17:58,270
هاياتشي، أوساتّا، أوسّارينا

280
00:17:58,270 --> 00:18:00,040
من الآمن أن تخرجوا

281
00:18:01,490 --> 00:18:03,330
اسمي هاياتشي

282
00:18:03,330 --> 00:18:06,800
سمعتُ من أخي الصّغير بأنّكم أبليتُم
بلاء حسناً. أنا مُمتنّة

283
00:18:06,800 --> 00:18:10,710
هذان الإيشّيغ هما أوساتّا وأوسّارينا

284
00:18:11,180 --> 00:18:16,080
أنقذني الإيشّيغ عندما تواجهتُ
مع الجِنرال الغريب

285
00:18:16,460 --> 00:18:20,360
.إنّهم أفضل منّي في السّيف
أو بالأحرى، آذانهم

286
00:18:20,790 --> 00:18:23,980
أجل، يبدون أقوياء

287
00:18:24,240 --> 00:18:26,310
!تغيير الشّكل

288
00:18:27,080 --> 00:18:32,320
،مجموعتنا أكبر من أن تستوعبها مركبةٌ واحدة
لذا قرّرتُ تحضير واحدة ثانية

289
00:18:33,270 --> 00:18:39,010
ماذا؟ ما يفعله حاكم العالم السّفليّ هو
عمل فرديّ، لا برغبة من ملك الشّياطين؟

290
00:18:39,010 --> 00:18:40,250
أجل، هذا صحيح

291
00:18:40,510 --> 00:18:44,060
حكمَ حاكمُ العالم السّفليّ في الأصل
،عالمَ الشّيطان

292
00:18:44,060 --> 00:18:47,270
لكن خسرَ أمام ملك الشّياطين الحاليّ
وأصبح أحد رعاياه

293
00:18:47,270 --> 00:18:51,780
فهمت. هذا أكثر من سببٍ كافٍ
لخيانة ملك الشّياطين

294
00:18:52,120 --> 00:18:56,160
إذاً كلّ ما علينا فعله هو التّعامل
مع جيش حاكم العالم السُّفليّ

295
00:18:56,160 --> 00:18:59,020
أعتقد بأنّ احتمالات فوزنا تحسّنتْ
قليلاً فحسب

296
00:18:59,020 --> 00:19:03,560
وأرغب في التّفكير في خطّة مُشتركة ما
،مع المدينة المُحصَّنة

297
00:19:03,560 --> 00:19:05,910
لكن لا نملك وسيلة للتّواصل معهم

298
00:19:05,910 --> 00:19:08,410
...التّواصل

299
00:19:09,100 --> 00:19:10,210
ما هذا؟

300
00:19:10,540 --> 00:19:11,920
!كوروياتا

301
00:19:14,800 --> 00:19:17,220
ما الّذي جاء بك إلى هنا يا كوروياتا؟

302
00:19:17,220 --> 00:19:19,850
.أنا مُتفاجئة من أنّك وجدتنا
كيف حال كيكويو؟

303
00:19:20,910 --> 00:19:23,690
ماذا؟ ثمّة شيء يتدلّى هناك

304
00:19:25,050 --> 00:19:26,990
يبدو كرسالة

305
00:19:27,310 --> 00:19:30,310
!إنّها رسالةٌ من الحارس

306
00:19:30,310 --> 00:19:33,990
الحارس. رسالة من هاتاكي؟

307
00:19:33,990 --> 00:19:37,430
لا، لحظة! أليس من الغريب أن يتمكّن
!حقلٌ من الكتابة؟

308
00:19:37,430 --> 00:19:39,220
سأقرأها بصوتٍ عال

309
00:19:39,220 --> 00:19:42,350
مرحباً بالجميع. اسمي هاتاكي"

310
00:19:42,350 --> 00:19:47,070
سمعتُ الأنباء من المُدير دُبّ، وأفهم الوضع

311
00:19:47,070 --> 00:19:52,580
،تكلّمتُ بالفعل مع ملك الشّياطين
"لذا لنركُل مؤخّرة حاكم العالم السُّفليّ جميعاً

312
00:19:52,810 --> 00:19:57,210
لنركل مُؤخّرته؟ كيف لحقل أن يفعل ذلك؟

313
00:19:57,410 --> 00:20:00,860
كتبتُ خطّةً مُفصَّلة على الجزء"
،الآخر من الورقة

314
00:20:00,860 --> 00:20:02,720
اطّلعوا عليها رجاء

315
00:20:02,990 --> 00:20:07,730
إن كان لديكم أي اقتراح، فدوّنوها
رجاء وأعطوها لكوروياتا

316
00:20:08,720 --> 00:20:12,330
"وأيضاً، أودُّ منكم إعطاءها لهاكّون

317
00:20:12,330 --> 00:20:13,340
تفضّل

318
00:20:13,990 --> 00:20:17,590
آلة بيع؟ هذه إعادة خلق أنيقة"

319
00:20:17,590 --> 00:20:20,480
لكن مَن أنا لأتكلّم؟ أنا حقل

320
00:20:20,480 --> 00:20:23,590
حالما ينتهي هذا، لنستغرق وقتنا
في الدّردشة حول اليابان

321
00:20:23,590 --> 00:20:27,590
،سأدعك تُجرّب بعض الخضراوات الشّهيّة
هذا إن كان لديك فم فقط

322
00:20:27,590 --> 00:20:29,940
"!أتطلّع قُدماً للقائك

323
00:20:29,940 --> 00:20:34,750
...بطريقة ما... يُراودني شعور بأنّني
أستطيع الانسجام مع هاتاكي هذا

324
00:20:34,750 --> 00:20:39,120
عندما نلتقي، سأمنحه بعض الأشياء
اليابانيّة الّتي تُعيد الحنين كهدايا

325
00:20:39,490 --> 00:20:42,660
بعد ذلك، عقدنا اجتماعاً إستراتيجيّاً

326
00:20:42,660 --> 00:20:45,860
دوّنّا العديد من الاقتراحات وأعطيناها لكوروياتا

327
00:20:48,830 --> 00:20:52,460
هزمْنا الكثير من الوحوش عندما
أحرقنا الغابة

328
00:20:52,460 --> 00:20:56,310
لكن في حين أنّنا قمنا بتصفية الكثير
،من الوحوش مُنخفضة الرّتبة

329
00:20:56,310 --> 00:20:59,260
تقريباً كافّة الوحوش رفيعة الرّتبة قد بقيتْ

330
00:20:59,530 --> 00:21:03,710
على أيّ حال، أريد فقط أن أفعل
ما أستطيع فعله كآلة بيع

331
00:21:04,100 --> 00:21:08,060
فضلاً عن ذلك، سأقاتل بجانب ابن
بلدي، هاتاكي

332
00:21:08,060 --> 00:21:10,520
لا شيء أكثر إبهاجاً من هذا

333
00:21:10,520 --> 00:21:13,140
تبدو سعيداً حيال شيء ما يا هاكّون

334
00:21:13,140 --> 00:21:14,910
ماذا؟ كيف عرفَتْ؟

335
00:21:14,910 --> 00:21:16,280
حقّاً؟

336
00:21:16,280 --> 00:21:18,920
لم أستطع تمييز أيّ فرق

337
00:21:18,920 --> 00:21:21,030
ما زلت بحاجة لكثير من التّدريب يا شوي

338
00:21:21,030 --> 00:21:24,660
الطّريقة الّتي تومض فيها أضواؤه
هي إشارة واضحة إلى أنّه سعيد

339
00:21:24,660 --> 00:21:28,690
حتّى كآلة بيع، لا أستطيع إظهار
وجه خالٍ من التّعابير؟

340
00:21:28,690 --> 00:21:31,120
بيتي عرفتْ... أيضاً

341
00:21:31,120 --> 00:21:33,170
على ما أعتقد... رُبّما

342
00:21:33,170 --> 00:21:36,030
بيتي، أشكّ في أنّكِ استطعتِ
التّمييز حقّاً

343
00:21:36,030 --> 00:21:38,280
ليس عليكِ الضّغط على نفسكِ
فقط كي تدخلي المُنافسة

344
00:21:38,280 --> 00:21:43,030
لطالما عرفتُه وقضيتُ معه الفترة الأطول

345
00:21:43,030 --> 00:21:44,770
أحلُّ في المركز الثّاني

346
00:21:44,770 --> 00:21:46,690
مدّة الزّمن... غير مُهمّة

347
00:21:47,050 --> 00:21:52,710
،لو كنتُ امرأة، حينها كنتُ لأقول
"لا تتشاجروا لأجلي"

348
00:21:52,710 --> 00:21:55,660
لكن الوقت الآن ليس مُناسباً
لمثل هذه الأمور

349
00:22:00,210 --> 00:22:04,340
الآن، لنُركّز على هزيمة حاكم
العالم السُّفليّ فحسب

350
00:23:36,020 --> 00:23:38,420
أتطلّع قُدماً لاستعمالك التّالي لي