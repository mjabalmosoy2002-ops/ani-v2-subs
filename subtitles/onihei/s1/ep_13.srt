1
00:00:05,340 --> 00:00:06,320
!بسرعة

2
00:00:10,140 --> 00:00:11,030
!لحظة

3
00:00:11,680 --> 00:00:12,680
...أوماسا

4
00:00:12,680 --> 00:00:13,860
...ماتاتارو-سان

5
00:00:14,520 --> 00:00:15,870
.دعني أذهب رفقتك

6
00:00:16,890 --> 00:00:17,870
!ماتا

7
00:00:18,570 --> 00:00:19,840
.حاولي التفهّم يا أوماسا

8
00:00:20,210 --> 00:00:23,820
.العلاقات الغراميّة ممنوعة عند كيتسونيبي

9
00:00:24,290 --> 00:00:26,290
.لا يمكنني خيانة والدي أكثر من هذا

10
00:00:41,710 --> 00:00:43,100
...ماتاتارو-سان

11
00:01:01,570 --> 00:01:02,450
...لماذا

12
00:01:03,650 --> 00:01:06,360
لماذا أحلم بما حدث قبل عشر سنوات؟

13
00:02:29,850 --> 00:02:31,970
.يا له من أمر فظيع

14
00:02:32,340 --> 00:02:34,380
.غيظي لهؤلاء الرجال لن ينتهي أبدًا

15
00:02:37,380 --> 00:02:39,790
،حالتان مماثلتان في فصل الربيع في العاصمة وأوساكا

16
00:02:39,790 --> 00:02:42,320
.بنفس علامة كيتسونيبي

17
00:02:42,320 --> 00:02:46,070
.أتوا إلى إيدو إذًا

18
00:02:47,830 --> 00:02:48,770
...أوماسا

19
00:02:50,420 --> 00:02:54,730
.ذكرت أنّ قائد كيتسونيبي ميّت

20
00:02:54,730 --> 00:02:55,570
.أجل

21
00:02:55,750 --> 00:02:58,870
أيعني هذا أنّ ابنه، خليفته، خلف هذا؟

22
00:02:58,870 --> 00:02:59,570
.كلّا

23
00:03:00,170 --> 00:03:01,730
.هذا ليس من فعله

24
00:03:01,730 --> 00:03:03,570
.لم يكن هذا من فعل خليفته

25
00:03:04,150 --> 00:03:06,950
!ما كان ذلك الرجل ليقوم بعمل فظيع كهذا

26
00:03:08,190 --> 00:03:08,960
...أوماسا

27
00:03:20,340 --> 00:03:23,970
أوماسا، لماذا تتستّرين على خليفة قائد كيتسونيبي؟

28
00:03:24,510 --> 00:03:28,390
...عندما عملت عند الكيتسونيبي السابق، أنا وخليفته كنّا

29
00:03:30,980 --> 00:03:32,140
.فهمت

30
00:03:32,500 --> 00:03:36,400
.لا اغتصاب، لا قتل ولا سرقة من الفقراء

31
00:03:36,400 --> 00:03:39,870
.قائدهم تمسّك بقواعد اللصّ الثلاثة بحزم

32
00:03:39,870 --> 00:03:41,900
.لا بدّ أن يواصل خليفته نفس الأمر

33
00:03:42,790 --> 00:03:46,120
.ما كان ليقوم بأمر وحشيّ كهذا

34
00:03:46,640 --> 00:03:47,740
...أوماسا

35
00:03:48,520 --> 00:03:52,940
،حتى وإن كانت لك علاقة بذلك الرجل فيما مضى

36
00:03:53,380 --> 00:04:00,070
.لا يمكنني التغاضي عن وحش قام بعمل همجيّ كهذا

37
00:04:00,740 --> 00:04:02,690
ولا يمكنك ذلك أنت أيضًا، صحيح؟

38
00:04:03,460 --> 00:04:04,760
.بالطبع

39
00:04:06,020 --> 00:04:08,760
.كنت مع الكيتسونيبي فيما مضى لذا أعتمد عليك

40
00:04:09,380 --> 00:04:10,670
.حقّقي في الأمر

41
00:04:11,570 --> 00:04:12,240
.حاضر

42
00:04:15,530 --> 00:04:18,510
.آخر قائد لهم كان لديه ابنان

43
00:04:19,040 --> 00:04:20,620
،الابن الأكبر ماتاتارو

44
00:04:21,140 --> 00:04:22,730
.والأصغر بونكيتشي

45
00:04:24,580 --> 00:04:27,730
.من الواضح أن يقوم الابن الأكبر ماتاتارو بقيادة الفريق

46
00:04:27,730 --> 00:04:30,520
.لكنّ ماتاتارو كان ابن خليلة

47
00:04:30,520 --> 00:04:34,410
،لن يكون من الغريب لو قام بونكيتشي
.الابن الشرعيّ، بأخذ ذلك المنصب

48
00:04:35,760 --> 00:04:38,310
.أجل... لا بدّ من ذلك

49
00:04:45,860 --> 00:04:48,250
.لا يمكن أن يكون ماتاتارو-سان الخليفة

50
00:04:51,060 --> 00:04:52,240
.لا يمكن

51
00:04:55,570 --> 00:04:57,120
.لم يقم بأعمال كتلك

52
00:04:59,620 --> 00:05:01,360
يوم السرقة؟

53
00:05:02,200 --> 00:05:06,510
.امرأة مسافرة انهارت أمام المتجر حيث وقعت العمليّة

54
00:05:06,510 --> 00:05:08,620
.وتمّ حملها بداخل المتجر

55
00:05:18,480 --> 00:05:21,580
.لا بدّ أنّ تلك المرأة هي هيكيكومي نو أوسن

56
00:05:22,230 --> 00:05:26,220
.القائد السابق طلب منها مرارًا التنكّر كمسافرة لتتبّع الهدف

57
00:05:26,520 --> 00:05:29,090
.لا بدّ أن يكون هنالك مخبأ في مكان ما

58
00:05:29,440 --> 00:05:33,280
...لكنّ الكيتسونيبي يعملون في المنطقة الغربيّة فقط

59
00:05:33,660 --> 00:05:35,360
.لا أعرف أيّ شخصٍ يمكنني سؤاله

60
00:05:36,560 --> 00:05:38,590
...كلّا، هنالك شخصٌ ما

61
00:05:39,100 --> 00:05:42,000
.شخصٌ في إيدو يعرف الكيتسونيبي أفضل منّي

62
00:05:51,570 --> 00:05:52,580
...أوماسا-سان

63
00:05:55,490 --> 00:05:58,460
.مرّ وقت طويل يا سيتوغاوا نو غينشيتشي-سان

64
00:05:58,460 --> 00:06:00,000
كيف عثرت عليّ؟

65
00:06:00,360 --> 00:06:03,840
.تذكّرت أنّني شاهدتك هنا فيما مضى

66
00:06:05,780 --> 00:06:07,420
أهذا صحيح؟

67
00:06:07,600 --> 00:06:09,390
!أخفضي صوتك

68
00:06:09,890 --> 00:06:12,290
.تركت طريق الخطيئة

69
00:06:12,290 --> 00:06:13,700
.عليّ أن أكون حذرًا

70
00:06:13,700 --> 00:06:14,840
.أنا آسفة

71
00:06:14,840 --> 00:06:16,930
لكن هل تلك القصّة حقيقيّة؟

72
00:06:16,930 --> 00:06:17,990
.أجل

73
00:06:17,990 --> 00:06:21,650
،قبل أربع سنوات، عندما كان القائد على فراش الموت

74
00:06:22,550 --> 00:06:24,400
.أسمعنا آخر كلماته

75
00:06:25,210 --> 00:06:27,150
."خليفتي سيكون ماتاتارو"

76
00:06:30,260 --> 00:06:33,100
.كنت هناك وسمعته يقول ذلك

77
00:06:33,100 --> 00:06:34,030
!كلّا

78
00:06:34,430 --> 00:06:36,080
...إذًا فحادثة إيتشيغايا

79
00:06:36,560 --> 00:06:39,040
إيتشيغايا؟ هل حدث أمرٌ ما؟

80
00:06:39,280 --> 00:06:40,720
...كلّا

81
00:06:41,110 --> 00:06:44,480
لكنّ ماتاتارو-سان في الغرب الآن، صحيح؟

82
00:06:44,480 --> 00:06:46,040
أليس كذلك؟

83
00:06:46,040 --> 00:06:49,880
ماتاتارو-سان ليس رفقتك؟

84
00:06:49,880 --> 00:06:52,550
ماذا؟ لمَ قد تقول ذلك؟

85
00:06:52,900 --> 00:06:54,560
،قبل فترة ليست ببعيدة

86
00:06:58,900 --> 00:07:01,690
.شاهدته يمرّ من هنا دون أن يلاحظني

87
00:07:02,000 --> 00:07:06,920
.اعتقدت أنه ذاهب لرؤيتك

88
00:07:07,280 --> 00:07:09,190
ماتاتارو-سان في إيدو؟

89
00:07:09,630 --> 00:07:12,570
.كانت تعلو وجهه تعابير مخيفة لم أرها من قبل

90
00:07:12,970 --> 00:07:14,950
.كان بمثابة رجل مختلف كليًّا

91
00:07:15,660 --> 00:07:17,830
.لكنّي واثق أنه ماتا-سان

92
00:07:19,810 --> 00:07:21,830
هل أنت هو سيتوغاوا نو غينشيتشي-سان؟

93
00:07:25,440 --> 00:07:26,590
!ما-تشان

94
00:07:30,290 --> 00:07:32,000
ما الذي تفعلانه هنا؟

95
00:07:32,000 --> 00:07:33,730
،يمكن للرجل أن يغسل أفعال يديه

96
00:07:33,730 --> 00:07:36,060
.لكنه لن يتمكّن من إخفاء بقايا التراب الذي تركه خلفه

97
00:07:36,060 --> 00:07:39,480
سمعنا أنّ ماتاتارو في إيدو

98
00:07:39,810 --> 00:07:40,980
أهذا صحيح؟

99
00:07:41,580 --> 00:07:42,980
سمعتم بخصوص ذلك؟

100
00:07:43,800 --> 00:07:45,120
أين هو الآن؟

101
00:07:46,840 --> 00:07:49,320
.علينا إعلام هاسيغاوا-ساما بذلك

102
00:07:49,320 --> 00:07:49,940
!انتظر

103
00:07:51,520 --> 00:07:54,640
.نحن لا نعلم إن كان هو الفاعل بعد

104
00:07:54,640 --> 00:07:58,700
...أرجوك أن تطلب من هاسيغاوا-ساما ألّا يقتله إن عثر عليه

105
00:07:58,700 --> 00:08:01,110
.سيكون ذلك عائدًا لهاسيغاوا-ساما

106
00:08:03,290 --> 00:08:04,180
...لكن

107
00:08:04,180 --> 00:08:08,840
ما-تشان، ما زلت تكنّين المشاعر لماتاتارو؟

108
00:08:09,270 --> 00:08:10,160
.أوماسا

109
00:08:10,680 --> 00:08:14,220
...يمكن للوقت أن يغيّر الناس

110
00:08:15,180 --> 00:08:17,100
.إلى أشخاصٍ مختلفين تمامًا

111
00:08:19,250 --> 00:08:20,380
.كوني حذرة

112
00:08:24,140 --> 00:08:25,980
.لا داعي للقلق يا ما-تشان

113
00:08:26,250 --> 00:08:29,880
.سأحرص على إخبار تيتسو-سان ما طلبته

114
00:08:29,880 --> 00:08:31,380
.شكرًا لك يا سيّدي

115
00:08:35,200 --> 00:08:36,380
...أوماسا-سان

116
00:08:37,890 --> 00:08:38,990
من كانا؟

117
00:08:39,690 --> 00:08:41,820
.أصدقاء لصوص قدماء

118
00:08:43,170 --> 00:08:46,960
لكن يا غينشيتشي-سان... هل يمكنني طلب خدمة منك؟

119
00:08:48,370 --> 00:08:50,800
،إن قام ماتاتارو-سان بالزيارة مجدّدًا

120
00:08:51,620 --> 00:08:53,260
.فلتخبره بهذا رجاءً

121
00:08:54,540 --> 00:08:58,030
...سأفعل ذلك إن أردت لكن

122
00:08:58,030 --> 00:08:58,800
.رجاءً

123
00:09:14,130 --> 00:09:16,440
.فهمت... شكرًا لك

124
00:09:20,340 --> 00:09:23,260
أين أنت يا ماتا-سان؟

125
00:09:28,770 --> 00:09:31,260
.قد يكون على اتّصال بذلك الرجل

126
00:09:31,260 --> 00:09:32,840
ما العمل أيها الخليفة؟

127
00:09:53,310 --> 00:09:55,370
هل أنت رسول من غينشيتشي-سان؟

128
00:09:55,370 --> 00:09:56,110
.أجل

129
00:09:56,320 --> 00:09:57,340
.افتحي

130
00:09:57,340 --> 00:09:59,240
!غينشيتشي-سان في خطر

131
00:09:59,240 --> 00:10:01,200
.لحظة، أنا قادمة

132
00:10:15,130 --> 00:10:16,300
.اختفت

133
00:10:16,580 --> 00:10:17,500
!أمسكوا بها

134
00:10:32,790 --> 00:10:33,750
.هذا مؤلم

135
00:10:39,990 --> 00:10:41,790
...فتاة شقيّة

136
00:10:52,780 --> 00:10:55,630
!أيتها العاهرة

137
00:11:06,380 --> 00:11:07,600
...بونكيتشي-سان

138
00:11:08,540 --> 00:11:09,790
أين هو أخي؟

139
00:11:10,400 --> 00:11:12,440
أين هو ماتاتارو؟

140
00:11:12,870 --> 00:11:13,950
.لا أعلم

141
00:11:14,350 --> 00:11:15,940
.أنا أبحث عنه أيضًا

142
00:11:16,620 --> 00:11:19,440
.نعلم أنه في إيدو

143
00:11:19,440 --> 00:11:23,080
!سأقتل تلك العاهرة

144
00:11:23,080 --> 00:11:25,560
.إنها مهمّة بالنسبة لأخي

145
00:11:29,200 --> 00:11:31,420
.سأفعل ما أشاء بها

146
00:11:44,390 --> 00:11:45,510
!ماتاتارو-سان

147
00:11:52,340 --> 00:11:53,350
...هذا سيّئ

148
00:11:54,050 --> 00:11:55,860
!حريق

149
00:11:56,880 --> 00:11:59,360
!هنالك حريق

150
00:11:59,520 --> 00:12:00,430
...ذلك الصوت

151
00:12:00,850 --> 00:12:02,110
هيكوجو؟

152
00:12:02,290 --> 00:12:04,030
ماذا؟ ما الذي يحدث؟

153
00:12:04,030 --> 00:12:05,900
أين هو الحريق؟

154
00:12:14,680 --> 00:12:16,290
أين الحريق؟

155
00:12:16,290 --> 00:12:18,700
!انظر يا عزيزي

156
00:12:19,310 --> 00:12:22,200
!ما-تشان! أين ذهبت؟ ما-تشان

157
00:12:26,760 --> 00:12:28,870
.مرّ وقت طويل يا أوماسا

158
00:12:29,460 --> 00:12:30,810
.أنت أيضا أيها الخليفة

159
00:12:31,040 --> 00:12:32,300
.لا تنادني هكذا

160
00:12:32,300 --> 00:12:33,540
.نادني ماتاتارو فقط

161
00:12:33,980 --> 00:12:35,100
.مثل الأيّام الخوالي

162
00:12:37,760 --> 00:12:39,110
...ماتاتارو-سان

163
00:12:39,320 --> 00:12:40,640
ما الذي أتى بك إلى إيدو؟

164
00:12:41,050 --> 00:12:44,810
.لإيقاف بونكيتشي... الكيتسونيبي المزيّف

165
00:12:44,810 --> 00:12:47,680
...إذًا فحادثة إيتشيغايا

166
00:12:48,180 --> 00:12:49,780
.كانت من فعل بونكيتشي

167
00:12:50,260 --> 00:12:52,710
.قام بعملين مماثلين في الغرب فيما سبق

168
00:12:53,260 --> 00:12:55,250
...أعمال فظيعة وعنيفة

169
00:12:56,110 --> 00:13:02,760
قائدنا كان ليحزن لو عرف أنّ اسم كيتسونيبي
.قد لطّخ بأعمال همجيّة كهذه

170
00:13:02,990 --> 00:13:05,350
...إذًا لم تكن أنت

171
00:13:05,850 --> 00:13:07,940
،خلال الأعوام الأربعة منذ أن تولّيت المنصب

172
00:13:07,940 --> 00:13:11,710
.منعت القيام بأيّ اغتصاب، قتل أو سرقة من الفقراء

173
00:13:12,340 --> 00:13:15,300
.قمت بعمل كبير مع احترام تلك القواعد

174
00:13:18,220 --> 00:13:19,400
.فهمت

175
00:13:19,920 --> 00:13:23,950
.لكنّ بونكيتشي لم يعجبه الأمر

176
00:13:25,170 --> 00:13:31,460
.لم يحبّذ فكرة أن يرث ابن غير شرعيّ مثلي العصابة

177
00:13:33,420 --> 00:13:34,630
...ماتاتارو-سان

178
00:13:35,780 --> 00:13:41,720
قائد السلطات القانونيّة في إيدو الآن هو رجل
.يدعى هاسيغاوا هيزو

179
00:13:41,720 --> 00:13:44,610
.سمعت الإشاعات، أنه أشبه بشيطان

180
00:13:44,610 --> 00:13:47,580
.إنه رجل صارم لا يحتمل الجرائم

181
00:13:48,080 --> 00:13:50,950
.دع أونيهي يهتمّ بأمر بونكيتشي

182
00:13:50,950 --> 00:13:53,720
.يجدر بك العودة إلى الغرب

183
00:13:54,660 --> 00:13:57,100
.أقدّر اهتمامك

184
00:13:58,560 --> 00:14:05,270
.لكن يا أوماسا... عليّ الاهتمام بأمر بونكيتشي بنفسي

185
00:14:06,080 --> 00:14:08,720
ما الذي تنوي فعله به؟

186
00:14:08,720 --> 00:14:10,870
،أريده أن يعترف بجرائمه

187
00:14:10,870 --> 00:14:14,340
.أعيده إلى العاصمة وأرسّخ في عقله طرق السرقة الحقيقيّة

188
00:14:15,300 --> 00:14:20,030
وإن... إن رفض فعل ما تريده؟

189
00:14:20,520 --> 00:14:21,600
...عندها

190
00:14:23,200 --> 00:14:26,420
.حسنًا إذًا. يبدو أنّني لن أتمكّن من إيقافك

191
00:14:26,420 --> 00:14:27,260
تتقبّلين هذا؟

192
00:14:28,040 --> 00:14:30,870
.في المقابل، اسمح لي بمساعدتك

193
00:14:30,870 --> 00:14:34,750
.كلّا، لا يمكنني السماح بتعريضك للخطر أكثر من هذا

194
00:14:34,750 --> 00:14:36,230
...ماتاتارو-سان

195
00:14:36,230 --> 00:14:37,930
لا تعرف إيدو كما ينبغي، صحيح؟

196
00:14:37,930 --> 00:14:39,040
...في الحقيقة

197
00:14:39,040 --> 00:14:41,500
...و... و

198
00:14:42,120 --> 00:14:42,980
...أوماسا

199
00:14:44,540 --> 00:14:46,860
لا بدّ أنك متعب، صحيح؟

200
00:14:46,860 --> 00:14:48,380
.يجدر بك أن ترتاح

201
00:14:49,780 --> 00:14:52,810
.أوماسا، اشتقت إليك... كثيرًا

202
00:14:54,010 --> 00:14:54,780
...لكن

203
00:15:06,250 --> 00:15:07,800
!تبًّا

204
00:15:08,330 --> 00:15:10,240
.لا تقلق أيها الزعيم

205
00:15:10,240 --> 00:15:12,300
.سنحضرهما

206
00:15:12,300 --> 00:15:14,050
.لا تنادني بالزعيم

207
00:15:14,970 --> 00:15:16,930
.بل الخليفة

208
00:15:18,010 --> 00:15:20,410
.أنت حسّاس للغاية أيها الخليفة

209
00:15:20,410 --> 00:15:23,700
.أدفع لك مقابل عملك هذا، يجدر بك القيام به كما ينبغي

210
00:15:23,700 --> 00:15:29,390
.أجل، سأفعل أيّ شيءٍ من أجل المال

211
00:15:35,570 --> 00:15:36,830
أوماسا اختفت؟

212
00:15:37,280 --> 00:15:41,280
،البارحة، قلقت عليها أنا والعجوز لذلك قمنا بزيارتها

213
00:15:41,910 --> 00:15:44,160
.ثمّ شاهدنا أنّ أولئك المتوحّشين قاموا بمهاجمتها

214
00:15:44,600 --> 00:15:45,710
...قمنا بملاحقتهم لكن

215
00:15:45,970 --> 00:15:48,670
.ثمّ ظهر مسافر وقام بإنقاذها

216
00:15:48,670 --> 00:15:49,860
.ماتاتارو

217
00:15:50,880 --> 00:15:53,090
.لا بدّ أنها لا تزال رفقته

218
00:15:53,090 --> 00:15:56,400
.أنا واثق أنّ لدى أوماسا خططها الخاصّة

219
00:15:56,400 --> 00:15:59,070
!صحيح. لا بدّ أنّ الأمر كذلك

220
00:16:00,100 --> 00:16:03,610
.علينا العثور على كليهما قبل أن يفعل ذلك المتوحّشون

221
00:16:04,140 --> 00:16:05,460
هل ستساعدانني؟

222
00:16:05,460 --> 00:16:06,650
.أجل

223
00:16:19,500 --> 00:16:22,330
.أجل، شاهدت أوماسا هذا الصباح

224
00:16:22,960 --> 00:16:25,830
.كانت بصدد مغادرة النزل رفقة رجل ما

225
00:16:26,480 --> 00:16:29,150
.كانا قريبين من بعضهما إن فهمت ما أعنيه

226
00:16:30,290 --> 00:16:31,840
أتعرف إلى أين ذهبا؟

227
00:16:32,180 --> 00:16:33,990
.لا أعلم

228
00:16:33,990 --> 00:16:36,480
.لكن لم يكن بحوزتهما أيّ حقائب

229
00:16:36,480 --> 00:16:39,230
.لذا أنا واثق أنهما سيعودان إلى النزل الليلة

230
00:16:39,620 --> 00:16:42,410
ما الذي يحدث على أيّ حال؟

231
00:16:42,410 --> 00:16:45,600
.أتت امرأة تبحث عن أوماسا قبل قليل أيضًا

232
00:16:46,560 --> 00:16:48,610
.ليست من سكّان المنطقة على ما يبدو

233
00:16:51,410 --> 00:16:55,150
...أ-أجل. قالت أنهما كانتا تعملان رفقة بعض لذا

234
00:17:01,470 --> 00:17:02,830
.لا بدّ أن يكون في مكان ما هنا

235
00:17:37,450 --> 00:17:38,820
.انتظري هنا

236
00:17:39,260 --> 00:17:40,250
.أنا قادمة معك

237
00:17:46,670 --> 00:17:49,630
.لا شكّ في ذلك. نزل إيسي-يا في شيناغاوا

238
00:17:49,630 --> 00:17:50,720
.سنهاجم في الليل

239
00:17:50,720 --> 00:17:51,580
!فلنفعل ذلك

240
00:17:51,580 --> 00:17:53,160
!سأقتلها

241
00:17:53,160 --> 00:17:54,590
.انتظروا لحظة

242
00:17:55,040 --> 00:18:00,020
.الآن وقد عرفت أوسِن، فأشكّ أنهما سيعودان إلى ذلك النزل

243
00:18:00,850 --> 00:18:01,600
...أوسِن

244
00:18:02,140 --> 00:18:05,600
هل أنت واثقة أنك ضيّعتهما؟

245
00:18:07,890 --> 00:18:09,500
!بالطبع

246
00:18:11,320 --> 00:18:13,860
.انتهينا لهذا اليوم جميعًا

247
00:18:13,860 --> 00:18:16,510
.لا تقوموا بأيّ عمل متهوّر قد يؤدّي إلى موتكم

248
00:18:16,510 --> 00:18:18,550
.هذا مملّ

249
00:18:19,130 --> 00:18:20,720
.هراء

250
00:18:29,480 --> 00:18:30,600
...بونكيتشي

251
00:18:30,600 --> 00:18:32,010
.لن ألومك

252
00:18:32,010 --> 00:18:33,660
.عد إلى العاصمة رفقتي

253
00:18:34,050 --> 00:18:36,560
.سأذكّرك كيف تكون لصًّا حقيقيًّا

254
00:18:36,560 --> 00:18:37,920
.هراء

255
00:18:40,050 --> 00:18:41,930
.لصّ حقيقيّ؟ هذا هراء

256
00:18:42,640 --> 00:18:48,240
،نقضي عامين إلى ثلاثة أعوام في التحضير للهدف
...وتدبير خطّة بعد أخرى

257
00:18:48,590 --> 00:18:52,440
.إنها تلك الطرق الملتوية التي تمنعنا من كسب أيّ مال وفير

258
00:18:53,000 --> 00:18:56,130
.تلك هي التجهيزات المتطلّبة لتفادي زهق الأرواح

259
00:18:56,640 --> 00:18:59,020
.ذلك هو فنّ السرقة

260
00:18:59,840 --> 00:19:04,020
.لا اغتصاب، لا قتل ولا سرقة من الفقراء

261
00:19:04,020 --> 00:19:06,200
.كلّ هذا قديم الطراز

262
00:19:07,280 --> 00:19:09,800
،لا يتعلّق الأمر بكونه قديمًا أو جديدًا

263
00:19:10,750 --> 00:19:12,430
.بل بالطريقة التي تريد العيش بها

264
00:19:12,760 --> 00:19:14,420
.أيّ نوع من الرجال تريد أن تكونه

265
00:19:15,330 --> 00:19:16,710
.هذا كلّ شيء

266
00:19:17,950 --> 00:19:20,060
.لا تنظر إليّ هكذا

267
00:19:21,060 --> 00:19:27,180
.شخصٌ بمثل بركاتك ما كان ليفهم ماهية شعوري

268
00:19:27,710 --> 00:19:28,590
ماذا؟

269
00:19:28,590 --> 00:19:31,460
.لطالما كان الأمر هكذا

270
00:19:31,460 --> 00:19:35,470
.كلّ ما أردته كان ملكًا لك من البداية

271
00:19:36,030 --> 00:19:40,490
...المظاهر، المهارة، الشعبيّة، و

272
00:19:41,570 --> 00:19:42,490
.المرأة

273
00:19:46,350 --> 00:19:48,530
.تحمّلت كلّ ذلك

274
00:19:48,530 --> 00:19:51,000
."وقلت "إنه القدر. ليس باليد حيلة

275
00:19:51,330 --> 00:19:55,350
...لكن عندما أخذت لقب الخليفة أيضًا، أدركت

276
00:19:56,080 --> 00:19:59,230
.على هذا المنوال، سأكون خاسرًا إلى الأبد

277
00:19:59,230 --> 00:20:00,010
...بونكيتشي

278
00:20:06,510 --> 00:20:09,360
.لذا لن أحتمل الأمر بعد الآن

279
00:20:10,290 --> 00:20:13,020
.اترك لقب الخليفة هنا

280
00:20:17,990 --> 00:20:19,200
...هذا سيّئ

281
00:20:30,840 --> 00:20:33,790
!هاسيغاوا هيزو من قسم مكافحة السرقة والحرائق المتعمّدة

282
00:20:35,110 --> 00:20:36,670
أونيهي؟

283
00:20:38,160 --> 00:20:41,160
.الإشاعات مجرّد إشاعات

284
00:20:41,620 --> 00:20:43,680
—سنرى لأيّ درجة

285
00:21:14,650 --> 00:21:16,740
،فهمت يا أخي

286
00:21:16,740 --> 00:21:18,210
.سأعود إلى العاصمة

287
00:21:40,910 --> 00:21:44,690
.كالعادة... لا يمكنني الفوز أبدًا

288
00:21:46,460 --> 00:21:47,600
...بونكيتشي

289
00:21:48,900 --> 00:21:52,110
.وداعًا... أيها الخليفة

290
00:22:00,280 --> 00:22:01,530
...ماتاتارو-سان

291
00:22:08,000 --> 00:22:11,510
أذاك هو خليفة كيتسونيبي يوغارو؟

292
00:22:12,530 --> 00:22:13,660
.كلّا

293
00:22:14,220 --> 00:22:18,300
.يدعى إمازويا، وهو تاجر من الغرب

294
00:22:18,940 --> 00:22:20,020
...أوماسا

295
00:22:20,330 --> 00:22:22,350
،ذاك الرجل هناك، بونكيتشي

296
00:22:22,350 --> 00:22:26,080
.هو من قتل الخليفة الحقيقيّ، انتحل شخصيته واقترف تلك الجرائم

297
00:22:26,570 --> 00:22:29,710
.أراد المساعدة في اعتقاله لا غير

298
00:22:30,670 --> 00:22:33,030
.هذا كلّ شيء

299
00:22:36,330 --> 00:22:38,830
إذًا فالخليفة الحقيقيّ قد مات؟

300
00:22:39,250 --> 00:22:40,040
.أجل

301
00:22:43,330 --> 00:22:44,550
إيمازويا، صحيح؟

302
00:22:45,020 --> 00:22:45,650
.أجل

303
00:22:46,710 --> 00:22:49,050
.شكرًا لك على مساعدتك لهذا اليوم

304
00:22:50,130 --> 00:22:53,280
.لا تعد إلى إيدو مجدّدًا

305
00:22:55,730 --> 00:22:57,020
.شكرًا لك سيّدي

306
00:23:09,480 --> 00:23:10,500
استدعيتني؟

307
00:23:10,500 --> 00:23:11,190
.أجل

308
00:23:12,320 --> 00:23:15,970
.إيمازويا ماتاتارو قد مات

309
00:23:16,770 --> 00:23:19,500
.أصيب بمرض في العاصمة ومات في فترة وجيزة

310
00:23:20,190 --> 00:23:23,330
.وقت وفاته، ترك رسالة لك

311
00:23:24,350 --> 00:23:27,310
."أخبر أوماسا أن تهتمّ بنفسها"