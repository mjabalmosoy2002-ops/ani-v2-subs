1
00:00:08,670 --> 00:00:10,460
! إنهم الشكيربيتشم

2
00:00:10,710 --> 00:00:13,210
! إن الشكيربيتشم يشنون هجوماً

3
00:00:29,840 --> 00:00:30,750
! هذا أقصى ما ستبلغه

4
00:00:31,160 --> 00:00:32,330
! صوبوا

5
00:00:33,880 --> 00:00:34,750
! انسحبوا

6
00:00:36,960 --> 00:00:37,840
! أطلقوا

7
00:00:47,000 --> 00:00:48,250
! سحقاً

8
00:02:26,670 --> 00:02:29,760
،ربما تمردنا على جيش شكيربيتشم حتى الآن

9
00:02:29,810 --> 00:02:32,410
لكن، بينما نتحدث، عسكروا خارج حدودنا

10
00:02:32,410 --> 00:02:35,730
أيضاً، لم يمحقوا قرية أو قريتان فحسب

11
00:02:36,170 --> 00:02:38,340
لقد زُهِقت العديد من الأرواح

12
00:02:39,130 --> 00:02:40,970
لن نتركهم يفلتون بفعلتهم

13
00:02:40,970 --> 00:02:43,100
! سنعيده لهم أضعافاً مضاعفة

14
00:02:43,100 --> 00:02:46,850
أتلمّح أنه ينبغي علينا غزو شكيربيكم ؟

15
00:02:46,850 --> 00:02:49,230
بالطبع ! أليس كذلك يا أخي ؟

16
00:02:51,400 --> 00:02:52,650
أخي ؟

17
00:02:52,650 --> 00:02:54,730
سنركزّ على الدفاع للوقت الراهن

18
00:02:54,730 --> 00:02:57,740
زد من عدد مراقبينا على الحدود

19
00:02:57,740 --> 00:02:58,780
ماذا ؟

20
00:02:58,780 --> 00:03:00,110
الدفاع فقط ؟

21
00:03:00,110 --> 00:03:01,110
!لمَ يا أخي ؟

22
00:03:01,620 --> 00:03:03,450
إنه قرار جلالته

23
00:03:06,830 --> 00:03:09,080
لقد أحضرت توكا-سان

24
00:03:17,550 --> 00:03:19,680
،بما أنك أخرجتني من زنزانتي

25
00:03:19,680 --> 00:03:22,090
فهل هذا يعني بأنك قررت ماهية عقوبتي ؟

26
00:03:24,140 --> 00:03:26,390
أنا مستعدة لمجابهة مصيري

27
00:03:26,640 --> 00:03:28,730
،ربما حصل سوء تفاهم

28
00:03:28,730 --> 00:03:30,810
لكن، تبقى حقيقة أنّي سببتُ المعاناة لأناسٌ أبرياء

29
00:03:31,060 --> 00:03:34,150
...لو كان قطع رأسي سيمحي خطاياي

30
00:03:34,150 --> 00:03:35,820
لن يكون لهذا داعٍ

31
00:03:36,440 --> 00:03:37,610
...إرورو

32
00:03:37,610 --> 00:03:38,320
حاضر

33
00:03:42,070 --> 00:03:43,570
أعيد هذه لك

34
00:03:43,870 --> 00:03:47,370
...لكن، بعد ما اقترفته بحقكم

35
00:03:48,870 --> 00:03:51,580
ليس لدينا سببٌ لاحتقارك

36
00:03:51,580 --> 00:03:54,960
كلُّ ما حدث، كان مجرد سوء فهمٍ محزن

37
00:04:00,670 --> 00:04:02,720
! يجب أن أكفِّر عن فعلتي

38
00:04:09,600 --> 00:04:11,560
لم يحن الوقت لتموتي بعد

39
00:04:11,560 --> 00:04:14,150
لا يزال هناك شيءٌ لتقومي به

40
00:04:14,770 --> 00:04:15,940
...بيناوي

41
00:04:21,990 --> 00:04:24,410
سأعيد الملك أوريكاكان لكِ

42
00:04:24,410 --> 00:04:27,200
أعيدي جثمانه إلى موطنه

43
00:04:28,660 --> 00:04:31,910
المسؤول عن هذه الجريمة هو من ضللكم

44
00:04:32,540 --> 00:04:36,210
لم يكن الملك أوريكاكان سوى أحد ضحاياه الغير محظوظين

45
00:04:41,800 --> 00:04:42,880
! رسالة يا سيدي

46
00:04:44,380 --> 00:04:48,640
! عبروا قوات شيكربيتشم حدودنا واستكملوا غزوهم

47
00:04:49,060 --> 00:04:51,140
! سنخرج يا أوبورو وكورو

48
00:04:51,140 --> 00:04:52,310
! حاضر

49
00:04:56,520 --> 00:04:58,690
الوداع يا سيدة توكا

50
00:05:10,200 --> 00:05:13,210
إذن، القرية التي نتوجه إليها تقع ما وراء هذا الوادي ؟

51
00:05:13,410 --> 00:05:16,080
! حريٌّ بنا أن نمحق شعب توسكورو فحسب

52
00:05:16,460 --> 00:05:19,590
لا بدَّ وأن لـ نيوا-ساما أسبابه الخاصة لفعل هذا

53
00:05:19,590 --> 00:05:21,630
إذن، لا يسعنا سوى الثقة به ؟

54
00:05:21,630 --> 00:05:22,260
ماذا ؟

55
00:05:24,630 --> 00:05:26,130
! قوات توسكورو

56
00:05:26,130 --> 00:05:28,760
! مشوّق، هذا ما نحن بحاجته

57
00:05:28,760 --> 00:05:32,100
! أعطي كامل الجيش أوامر بالهجوم
! امحقوهم من الوجود

58
00:05:32,100 --> 00:05:32,850
! حاضر، سيدي

59
00:05:34,310 --> 00:05:35,390
...ماذا

60
00:05:37,150 --> 00:05:38,480
! أيها الفريق الأزرق، صوبوا

61
00:05:38,940 --> 00:05:40,360
! أيها الفريق الأحمر، صوبوا

62
00:05:40,610 --> 00:05:41,780
! أطلقوا

63
00:05:46,030 --> 00:05:48,120
! لا تُفسدوا التشكيلة

64
00:05:50,330 --> 00:05:52,160
! سأسلبك رأسك

65
00:05:52,490 --> 00:05:54,200
! لا تغترّ، أيها الفتى

66
00:05:54,830 --> 00:05:55,830
! سيدي الشاب

67
00:06:03,630 --> 00:06:05,920
يا لكَ من شخصٍ متهوّر يا سيّدي الشاب

68
00:06:11,350 --> 00:06:13,640
يبدو بأننا أجبرناهم على التراجع

69
00:06:13,640 --> 00:06:14,770
! رسالة

70
00:06:15,850 --> 00:06:18,980
! يغزو جيش الشكيربيتشم حدودنا الغربية

71
00:06:18,980 --> 00:06:20,360
! يجب أن نغير مسارنا فوراً

72
00:06:20,610 --> 00:06:22,360
!يغزوننا الآن من الغرب ؟

73
00:06:33,660 --> 00:06:35,200
! قوات العدو قِلة

74
00:06:35,200 --> 00:06:37,790
! اطرحوهم أرضاً بضربةٍ واحدة

75
00:06:38,920 --> 00:06:39,920
ماذا ؟

76
00:06:40,210 --> 00:06:41,670
! يهاجمنا العدو من الخلف

77
00:06:46,920 --> 00:06:48,180
! اللعنة عليهم

78
00:06:48,180 --> 00:06:50,800
هجوم الكماشة: هجوم حيث يهاجم فيه جيش أو جيشان الأعداء من عدة جهات في آنٍ واحد ليحاصروهم

79
00:06:48,180 --> 00:06:50,800
!لديهم ما يكفي من القوات ليقوموا بهجوم الكماشة ؟

80
00:06:54,180 --> 00:06:56,390
!لا يعقل ! شخصٌ واحدٌ فحسب ؟

81
00:06:58,850 --> 00:07:01,440
! أيتها المتوحشة اللعينة

82
00:07:01,940 --> 00:07:03,730
هذا في غاية الوقاحة

83
00:07:12,320 --> 00:07:15,370
! طاردوهم ! لا تسمحوا لهم بالفِرار

84
00:07:19,580 --> 00:07:21,080
أحسنتِ عملاً

85
00:07:21,080 --> 00:07:23,590
لم يكن عملاً شاقاً على الإطلاق

86
00:07:26,460 --> 00:07:27,800
أتريد القليل ؟

87
00:07:27,800 --> 00:07:29,130
! الوقت مبكرٌ كثيراً على ذلك

88
00:07:29,380 --> 00:07:32,090
سأشرب القليل بعدما نقضي عليهم

89
00:07:53,120 --> 00:07:54,200
! سأقضي عليك

90
00:08:03,500 --> 00:08:05,130
مبهر

91
00:08:06,340 --> 00:08:10,340
علمت بأنّك كنت لواء ساموراي في كوتشا كيتشا

92
00:08:10,670 --> 00:08:15,430
نعم، أرجو بأن تسمح لي بالانضمام لقواتك، كما اتفقنا

93
00:08:16,100 --> 00:08:19,060
اتقفنا ؟ حسنٌ

94
00:08:24,600 --> 00:08:27,110
سأمنحك أمنيتك

95
00:08:27,110 --> 00:08:29,280
خذوه للمكان

96
00:08:34,280 --> 00:08:37,330
جمعت اللوازم، كما طلبت

97
00:08:37,330 --> 00:08:41,120
الباقي يعتمد على كيفية استخدامك لها

98
00:08:42,410 --> 00:08:47,210
لم يُرضِني أياً من هؤلاء الرجال

99
00:08:47,960 --> 00:08:51,970
أعتقد بأن ذلك الرجل هو الشخص الوحيد الذي يسعني توقع الكثير منه

100
00:08:54,930 --> 00:08:56,220
أتحرّق شوقاً

101
00:08:56,550 --> 00:09:00,180
أريد رؤية هيئته الحقيقية قريباً

102
00:09:09,270 --> 00:09:12,820
هجمات العدو في ازديادٍ يومي

103
00:09:12,950 --> 00:09:15,030
إنهم يبثون فينا القلق

104
00:09:15,030 --> 00:09:16,950
لمَ لا يهاجموننا بهجمةٍ شاملة فحسب ؟

105
00:09:17,370 --> 00:09:21,620
الكثير من رجالنا جرحى ومنهكون بشدّة

106
00:09:21,870 --> 00:09:24,290
هذا على الأرجح أحد أهدافهم

107
00:09:24,290 --> 00:09:27,440
إنهم ينوون إرهاقنا جسدياً وعقلياً بتكرار هذه المناوشات

108
00:09:30,420 --> 00:09:32,210
أيمكن وجود أسباب أخرى ؟

109
00:09:33,220 --> 00:09:35,050
لتحريضنا

110
00:09:35,050 --> 00:09:36,220
على الأرجح

111
00:09:36,590 --> 00:09:38,430
! حسنٌ، هذا مشوّق

112
00:09:38,430 --> 00:09:40,640
إذن، أينبغي علينا أخذ الجانب الهجومي يا أخي ؟

113
00:09:40,970 --> 00:09:45,020
لدى شكيربيتشم أكثر من عُشْر أضعاف عظمة بلادنا

114
00:09:45,020 --> 00:09:47,980
لا يسعنا أن نأمل الفوز بمهاجمتهم وجهاً لوجه

115
00:09:47,980 --> 00:09:50,480
! لن نعلم هذا ما لم نحاول

116
00:09:50,480 --> 00:09:52,480
! حريٌّ بنا مهاجمتم يا أخي

117
00:09:53,190 --> 00:09:54,700
سننتظر للوقت الحالي

118
00:09:54,700 --> 00:09:56,450
ننتظر ماذا ؟

119
00:09:56,780 --> 00:09:59,120
على هذا المعدل، فسنكون أول من يستسلم

120
00:09:59,120 --> 00:10:01,870
! هذا صحيح ! لا أريد مسايرتهم في نواياهم

121
00:10:01,870 --> 00:10:03,290
!! سننتظـر

122
00:10:03,910 --> 00:10:08,080
على الأرجح بأنه لا يوجد سوى خطةٌ واحدة لننتصر

123
00:10:08,500 --> 00:10:10,840
فقط خطةٌ واحدة لننتصر ؟

124
00:10:11,170 --> 00:10:12,630
لا يسعني البوح بها حالياً

125
00:10:12,630 --> 00:10:16,300
لو سمع العدو بها، فسنخسر فرصتنا الضئيلة بالنصر

126
00:10:16,300 --> 00:10:18,340
أريدكم أن تثقوا بي وتتبعوني

127
00:10:19,140 --> 00:10:20,890
! هذا مؤكد

128
00:10:20,890 --> 00:10:23,970
سنتبعك يا أخي. هذا كل ما في الأمر

129
00:10:40,370 --> 00:10:41,700
أين الآخرون ؟

130
00:10:41,700 --> 00:10:43,370
غادروا

131
00:10:43,370 --> 00:10:44,700
...فهمت

132
00:10:45,950 --> 00:10:47,830
تتحرك الأمور بسرعة، صحيح ؟

133
00:10:49,040 --> 00:10:50,460
بسرعةٍ كبيرة

134
00:10:52,040 --> 00:10:54,340
قلت لهم بأن يثقوا بي

135
00:10:56,340 --> 00:11:00,890
مجرد كلمة واحدة مني ستحدد مصير هذه البلاد

136
00:11:01,680 --> 00:11:05,020
أعلم بأنَّ تلك الكلمة ستجلب ألماً أكثر فحسب

137
00:11:08,770 --> 00:11:10,060
...إرورو

138
00:11:10,650 --> 00:11:13,900
،أردت فقط الدفاع عمَّن أحببت

139
00:11:13,900 --> 00:11:16,190
حيوات الجميع

140
00:11:16,190 --> 00:11:17,780
،لهذا كنتُ أقاتل باستمرار

141
00:11:18,280 --> 00:11:20,450
لكن المعارك تأبى الانتهاء

142
00:11:20,450 --> 00:11:24,990
عوضاً عن ذلك، اقترب خطر حربٍ أخرى من هذه البلاد

143
00:11:25,990 --> 00:11:28,660
ما الذي أفعله ؟

144
00:11:29,330 --> 00:11:32,000
ما هي وجهتي ؟

145
00:11:33,040 --> 00:11:36,210
لا أعلم

146
00:11:37,170 --> 00:11:42,340
لكن، ما أعرفه هو إني أثق بك

147
00:11:43,300 --> 00:11:48,350
دائماً، مهما حصل، بلا ريب

148
00:11:49,060 --> 00:11:50,060
...إرورو

149
00:11:51,980 --> 00:11:54,020
أنا قلق

150
00:12:06,030 --> 00:12:07,700
! امحقوهم

151
00:12:13,920 --> 00:12:15,340
هذا في غاية البساطة

152
00:12:20,050 --> 00:12:22,720
جلبوا الماء وكوّنوا بحراً من الطين

153
00:12:23,930 --> 00:12:26,430
خطط أخي متقنةٌ دائماً

154
00:12:26,430 --> 00:12:28,720
تقريباً من المسلي رؤية كيف سقطوا بالفخ بسهولة

155
00:12:28,720 --> 00:12:31,310
،نعم، لكن، بالرغم أننا كنا ننتصر بكل معركة

156
00:12:31,310 --> 00:12:33,020
فلا يبدو بأننا ننتصر بالمعركة بحق إطلاقاً

157
00:12:33,560 --> 00:12:37,690
سيدي الشاب، إلى متى يجب علينا أن نستمر بالقتال هكذا ؟

158
00:12:37,690 --> 00:12:41,190
لا يسعنا سوى فعل ما يتوجب علينا

159
00:12:52,910 --> 00:12:56,290
ومقاومة العدو أعظم مما توقعنا

160
00:12:56,290 --> 00:12:57,460
! جيد

161
00:12:58,000 --> 00:13:00,300
أقول بأن الأمور تسير جيداً، كما هي فحسب

162
00:13:00,760 --> 00:13:04,510
كلما قاتل، كلما قاد نفسه لطريقٍ مسدود

163
00:13:05,010 --> 00:13:07,930
! أؤمر الجيوش أن يواصلوا هجماتهم

164
00:13:07,930 --> 00:13:09,010
! حاضر، سيدي

165
00:13:28,330 --> 00:13:30,200
ألستَ مليئاً بالحماس ؟

166
00:13:30,200 --> 00:13:33,830
بالحكم على حالك، فسأقول بأنك ستخرج من هنا عما قريب

167
00:13:38,840 --> 00:13:41,000
! جيد، جيدٌ للغاية

168
00:13:46,010 --> 00:13:48,220
إنه أنت

169
00:13:48,220 --> 00:13:50,560
إنهم يتحولون جيداً

170
00:13:50,560 --> 00:13:53,230
لا بدَّ أن أُثني على مهارتك

171
00:13:54,390 --> 00:13:57,230
،ستحصل على الكثير من العينات ما دامت الحرب مستمرَّة

172
00:13:57,230 --> 00:14:00,270
لكن، اعلم بأن الجودة أهم من الكمية

173
00:14:01,320 --> 00:14:06,110
كان اسمه هاكورو، أليس كذلك ؟
راق لي باللحظة التي وقع نظري عليه

174
00:14:06,110 --> 00:14:09,280
حتماً سيرتقي لتوقعاتي

175
00:14:09,370 --> 00:14:13,410
! سأعدُّ أيُّ عددٍ من الأضحيات من أجله

176
00:14:26,550 --> 00:14:28,260
! أختي الكبيرة إرورو، تعالي إلى هنا أيضاً

177
00:14:28,430 --> 00:14:32,720
حاضر ! آرورو، اذهبي وأحضري الجديدة من الرف

178
00:14:35,980 --> 00:14:37,020
! آرورو

179
00:14:37,270 --> 00:14:38,980
أنا بخير

180
00:14:39,440 --> 00:14:41,150
وصلوا لحدودهم

181
00:14:41,150 --> 00:14:43,980
الجنود في قمة الإجهاد

182
00:14:44,570 --> 00:14:47,780
مهما كان عدد المرات التي ننتصر فيها، فلا يسعنا تفادي الخسائر

183
00:14:48,450 --> 00:14:50,200
...لو استمرت المعارك على هذه الحال

184
00:14:51,490 --> 00:14:54,950
حان الوقت يا نخبة قواتي

185
00:14:55,370 --> 00:15:00,040
! مهما بلغوا من المكر والدهاء، فمن الواضح بأننا الأقوى

186
00:15:00,960 --> 00:15:03,670
لا حاجة للخطط المعقّدة لجيشٍ ضخم

187
00:15:03,670 --> 00:15:05,460
! لا تفكروا على الإطلاق

188
00:15:05,630 --> 00:15:09,300
! فقط أحرقوا كلَّ شيء واقتلوا الجميع

189
00:15:15,850 --> 00:15:18,060
أنا بانتظاركم

190
00:15:26,280 --> 00:15:28,490
العدو يقوم بهجومٍ على مقاسٍ كامل

191
00:15:28,860 --> 00:15:32,490
بدئوا بتقدُّمٍ منظَّم على طول الحدود

192
00:15:32,490 --> 00:15:35,370
هل عبر كامل جيشهم حدودنا ؟

193
00:15:35,620 --> 00:15:38,750
،كلا، يبدو بأنه هناك اختلاف في سرعة وحداتهم المتقدمة

194
00:15:38,750 --> 00:15:39,750
لهذا، لا أعتقد بأنه كامل جيشهم

195
00:15:41,380 --> 00:15:42,830
أخي ؟

196
00:15:42,830 --> 00:15:45,090
لا يوجد هناك سوى خطةٌ واحدة يسعنا بها ربح هذه المعركة

197
00:15:45,090 --> 00:15:48,170
،علينا أن نسحب كامل جيش شكيربيتشم إلى بلادنا

198
00:15:48,170 --> 00:15:50,930
كي تصبح بلادهم بلا جيش

199
00:15:52,340 --> 00:15:55,720
بعدئذٍ ستقتحم وحدة منفصلة من قواتنا قلعة شكيربيتشم

200
00:15:55,720 --> 00:15:57,560
ليُطِحيوا برأس نيوا

201
00:15:57,560 --> 00:15:59,390
ليس هناك خطةٌ أخرى

202
00:15:59,640 --> 00:16:04,360
على كلٍّ، اختلاف سرعة قواتهم سبب خطأ تقدير حساباتٍ مفاجئ

203
00:16:04,360 --> 00:16:06,190
...لكن، على هذا المعدَّل

204
00:16:06,190 --> 00:16:07,860
سنواجههم وجهاً لوجه

205
00:16:07,860 --> 00:16:09,530
سيدي ؟

206
00:16:09,530 --> 00:16:11,240
لا تقلقا

207
00:16:11,240 --> 00:16:13,570
لا يزال بإمكاننا التصدِّي لهذا الهجوم

208
00:16:13,570 --> 00:16:14,830
لا يزال بوسعنا ذلك

209
00:16:15,580 --> 00:16:17,830
بيناوي، أنت ستأخذ الخيَّالة

210
00:16:17,830 --> 00:16:21,000
تقدّموا من الغرب واقطعوا امدادات العدو

211
00:16:21,000 --> 00:16:24,130
لو كان تقدُّم العدو غير متساوي فسيكون هذا ممكناً

212
00:16:24,130 --> 00:16:24,920
حاضر

213
00:16:25,460 --> 00:16:27,750
سأترك أمر القلعة لـ أوروتوري

214
00:16:27,750 --> 00:16:29,970
أوبورو وكورو وكارولا سترافقونني

215
00:16:29,970 --> 00:16:31,880
لنقاتل الأعداء القادمين من الحدود

216
00:16:32,050 --> 00:16:35,600
أيٌّ شخصٍ من الجرحى باستطاعته الحراك سينضمُّ للمعركة

217
00:16:35,600 --> 00:16:36,560
...لكن

218
00:16:37,060 --> 00:16:39,810
أعرف بأن هذا غير معقول. أرجوكِ تفهّمي الوضع

219
00:16:44,020 --> 00:16:46,060
! لا تتخاذلوا ! اهجموا

220
00:16:55,280 --> 00:16:57,330
هذا عملٌ صعب

221
00:16:59,950 --> 00:17:02,040
! أسرع، امضي أسرع

222
00:17:10,760 --> 00:17:12,050
! جورا

223
00:17:12,720 --> 00:17:13,630
! الآن

224
00:17:17,600 --> 00:17:18,430
! سيدنا الشاب

225
00:17:18,640 --> 00:17:19,770
أين أخي ؟

226
00:17:25,060 --> 00:17:26,060
! إرورو

227
00:17:26,060 --> 00:17:28,190
حاضر ! رجاءاً ابقيا بقربنا

228
00:17:32,530 --> 00:17:34,780
أرى بأن هاكورو هنا

229
00:17:34,780 --> 00:17:36,530
! سأحصل على اسمٍ لنفسي عن طريق ذبحك

230
00:17:36,910 --> 00:17:38,080
! اقضوا عليه

231
00:17:47,040 --> 00:17:49,590
سأردُّ ديني بمساندتك

232
00:17:49,590 --> 00:17:50,170
لمَ ؟

233
00:17:50,630 --> 00:17:54,800
استطعت إعادة الملك أوريكاكان إلى مسقط رأسه بفضل ترتيباتك الرحيمة

234
00:17:55,340 --> 00:17:58,720
إنها عادةٌ لدى عشيرة الإيفانكلوجا أن نُجازي الشرف بالشرف

235
00:17:59,180 --> 00:18:02,140
سيكون شرفاً وامتيازاً لي أن أخدمك من الآن فصاعداً

236
00:18:07,650 --> 00:18:10,020
لعينة .. إذن، أصبحتِ خائنة ؟

237
00:18:10,400 --> 00:18:12,320
أنا لستُ بخائنة

238
00:18:12,320 --> 00:18:14,530
أنا أردُّ ديني ببساطة

239
00:18:14,530 --> 00:18:18,320
! اِعلم بأنَّ نيوا هو الجبان لخديعته للملك أوريكاكان

240
00:18:18,570 --> 00:18:20,160
! كفى ثرثرة

241
00:18:20,160 --> 00:18:22,950
! سأطيحُ برأسك يا جنرال العدو

242
00:18:34,920 --> 00:18:36,090
كنتِ عوناً كبيراً لنا

243
00:18:36,090 --> 00:18:37,930
شكراً جزيلاً لكِ

244
00:18:37,930 --> 00:18:41,680
على العكس، أعتذر لوصولي إلى هنا متأخرة كثيراً

245
00:18:45,230 --> 00:18:46,230
! إرورو

246
00:18:50,860 --> 00:18:52,730
! لا تقلق، سأنقذها الآن

247
00:18:56,240 --> 00:18:58,740
لن أنجو

248
00:18:59,030 --> 00:19:00,530
...أنقذي طفلي فحسب

249
00:19:00,530 --> 00:19:02,200
! عليكِ ألا تقولي هذا

250
00:19:02,200 --> 00:19:03,990
! هذا الطفل بحاجةٍ إلى أمه

251
00:19:04,700 --> 00:19:05,950
! إرورو

252
00:19:11,000 --> 00:19:13,300
...رجاءاً أنقذا طفلي فحسب

253
00:19:13,300 --> 00:19:14,760
! كـلا

254
00:19:19,010 --> 00:19:20,720
! كــــلا

255
00:19:30,230 --> 00:19:33,190
...أنا آسفة، أنا آسفة

256
00:19:41,370 --> 00:19:44,950
تراجعت قوات شكيربيتشم إلى الحدود

257
00:19:44,990 --> 00:19:46,240
ما خسائرنا ؟

258
00:19:46,240 --> 00:19:50,670
أُحرقتْ العديد من القُرى، وهلك العديد من شعبنا

259
00:19:51,000 --> 00:19:53,670
أُبيدتْ نصف وحدتي

260
00:19:53,670 --> 00:19:54,340
...أخي

261
00:19:55,050 --> 00:19:58,550
على الأرجح بأنَّ العدو سيهاجم في المرة القادمة بكامل قواته

262
00:19:58,550 --> 00:20:01,220
بيناوي، سأترك معظم وحداتنا معك

263
00:20:01,260 --> 00:20:04,510
سآخذ قِلة من نخبة جنودنا ونتجه لقلعة العدو

264
00:20:04,510 --> 00:20:06,220
! هذا خطرٌ للغاية

265
00:20:06,220 --> 00:20:09,790
أدركُ هذا .. لكن، ليس هناك خطةٌ أخرى

266
00:20:10,560 --> 00:20:12,350
سترافقانني يا كارولا وتوكا

267
00:20:12,770 --> 00:20:16,150
أوبورو و كورو، أريدكما أن تُساعدا بيناوي

268
00:20:16,150 --> 00:20:17,320
...سيدي

269
00:20:17,570 --> 00:20:22,700
أسأقتلُ نيوا أولاً، أم سنذبحُ جميعاً قبل ذلك ؟

270
00:20:22,700 --> 00:20:25,450
ستكون معركةً ضد الوقت

271
00:20:53,480 --> 00:20:54,730
سنتقدم

272
00:21:10,790 --> 00:21:11,750
لنذهب