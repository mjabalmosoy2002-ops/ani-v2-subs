1
00:00:05,000 --> 00:00:09,140
انتهاء المُباراة. فوز إسبانيا 0-6

2
00:00:12,270 --> 00:00:14,420
أولئك الإسبانيّون الأوغاد

3
00:00:14,420 --> 00:00:17,810
أحضَروا امرأة للّعب فقط لأنّها المرحلة التّمهيديّة

4
00:00:18,340 --> 00:00:20,280
!يا للوقاحة

5
00:00:20,860 --> 00:00:22,950
أنا مُرتدي ملابس جنس مُغاير

6
00:00:22,950 --> 00:00:24,040
!أيُّها الواشي

7
00:00:24,040 --> 00:00:26,110
تـ-توقّف الآن

8
00:00:27,260 --> 00:00:29,910
…إذا تفاقمَ هذا الأمر

9
00:00:31,420 --> 00:00:34,600
فذلك الطّفل المُقنَّع سيقتلنا حتماً هذه المرّة

10
00:00:35,710 --> 00:00:41,710
كما قال غوته ذات مرّة، "أكبر خطيئة للإنسان
"هي سوء الطّبع

11
00:00:42,230 --> 00:00:46,220
لذا ابتسموا جميعاً

12
00:00:49,260 --> 00:00:53,070
،في المجموعة د من المرحلة التّمهيديّة
،بفوز كافّة المُباريات الثّلاثة

13
00:00:53,070 --> 00:00:56,070
تتأهّل إسبانيا إلى النّهائي في المركز الأوّل

14
00:00:57,040 --> 00:01:00,490
،في المجموعة ب من المرحلة التّمهيديّة
،بفوز 1-2

15
00:01:00,490 --> 00:01:04,480
تتأهّل اليابان إلى النّهائي في المركز الثّاني

16
00:01:14,960 --> 00:01:18,370
انتهاء المُباراة. أمريكا تفوز 0-6

17
00:01:21,540 --> 00:01:23,340
ما زال الطّريق أمامك طويلاً

18
00:01:23,850 --> 00:01:28,290
،في المجموعة ي من المرحلة التّمهيديّة
،بفوز كافّة المُباريات الثّلاثة

19
00:01:28,290 --> 00:01:31,290
تتأهّل أمريكا إلى النّهائي في المركز الأوّل

20
00:03:05,180 --> 00:03:07,870
رفضتَ فُرصتك لتمثيل أمريكا؟

21
00:03:07,870 --> 00:03:09,960
أنت تفعل ما يحلو لك فحسب يا إتشيزن

22
00:03:10,250 --> 00:03:13,530
ليست حقيقة ذهابك إلى أمريكا
هي الّتي تُثير الاستياء

23
00:03:13,530 --> 00:03:15,540
إنّما عودتك إلى هنا

24
00:03:15,880 --> 00:03:20,110
هل فكّرتَ في أولئك الّذين لم يتم
اختيارهم لتمثيل بلادهم؟

25
00:03:22,100 --> 00:03:25,980
تمّ اختياره لتمثيل اليابان من البداية

26
00:03:26,830 --> 00:03:34,280
تركَ المُدرّبُ ميفوني حالةَ ريوما إتشيزن
مُعلّقةً في حال قد عاد

27
00:03:34,490 --> 00:03:39,610
للوقت الرّاهن، ستنضمّ لفريق اليابان
بدور مُسانِد

28
00:03:40,330 --> 00:03:42,190
لا اعتراض لديك، صحيح؟

29
00:03:43,990 --> 00:03:44,650
شكراً

30
00:03:44,940 --> 00:03:47,700
تبدأ بطولة الاختيار بعد يوم غد

31
00:03:47,700 --> 00:03:49,100
استعدّوا

32
00:03:49,100 --> 00:03:50,150
حاضر

33
00:03:51,590 --> 00:03:53,010
أنت

34
00:03:56,110 --> 00:03:59,340
هل يستطيع أسلوبك في التّنس
التحكُّم بخصمك؟

35
00:03:59,710 --> 00:04:03,280
المعذرة، أنت سيدا، صحيح؟

36
00:04:03,650 --> 00:04:05,860
المسألة نفسيّة برمّتها

37
00:04:05,860 --> 00:04:08,310
إنّها نافعة بشكل مُفاجئ في التّنس أيضاً

38
00:04:08,630 --> 00:04:11,340
"هذا ما يطلقون عليه بـ"التحكُّم بالعقل

39
00:04:12,730 --> 00:04:18,320
لكن، أحياناً، يمكن لهذا التحكُّم بالعقل
أن يتعمّق ويقترب كثيراً من القلب

40
00:04:18,960 --> 00:04:25,360
الأفعال الّتي تُدمِّر العقل أو تُسبِّب للشّخص
فقدان إحساسه بذاته مُحرَّمة

41
00:04:26,450 --> 00:04:29,560
"وأيضاً، يمكنك أن تُناديني "روميفيرن

42
00:04:30,910 --> 00:04:33,850
لذا كفّ عن استخدام "أنت"، اتّفقنا يا سيدا؟

43
00:04:34,810 --> 00:04:35,830
تفضّل

44
00:04:35,830 --> 00:04:36,830
المعذرة

45
00:04:37,470 --> 00:04:41,010
مولايّ، طائرتك النفّاثة جاهزة

46
00:04:41,010 --> 00:04:42,150
حسناً

47
00:04:42,150 --> 00:04:43,840
إلى أين أنت ذاهب؟

48
00:04:43,840 --> 00:04:47,630
قال أبي بأنّه يحتاج لعودتي إلى إسبانيا

49
00:04:47,920 --> 00:04:49,380
سأعود في النّهائي

50
00:04:50,400 --> 00:04:53,990
إلى ذلك الحين، احتفظ بهذا
الكِتاب لأجلي يا سيدا

51
00:05:02,870 --> 00:05:09,310
رغم ذلك، لم أكن أدرك بأنّ لديك اهتمام
بالكوالا يا زيوس-ساما

52
00:05:10,660 --> 00:05:12,780
أرغب في الاحتفاظ بواحد ولو لمرّة

53
00:05:19,170 --> 00:05:21,080
…ذ-ذلك الرّجل

54
00:05:24,580 --> 00:05:27,520
زيوس-ساما، هل أثار هذا الشّخص اهتمامك؟

55
00:05:28,670 --> 00:05:30,910
لا، الأمر ليس بتلك الأهمّية

56
00:05:41,190 --> 00:05:45,130
هناك رعايا تجارب في كلّ مكان

57
00:05:49,560 --> 00:06:17,060
أرامينوما. أرامينوما

58
00:06:22,570 --> 00:06:24,520
انتظر يا موموشيرو

59
00:06:25,160 --> 00:06:26,700
إلى أين أنت ذاهب؟

60
00:06:26,990 --> 00:06:30,930
يواجه فريق اليابان خصمَهم الأوّل
،في النّهائي يوم غد

61
00:06:30,930 --> 00:06:33,030
لذا أتفقّد مُنشآت أرامينوما

62
00:06:33,030 --> 00:06:34,280
استطلاع إذاً؟

63
00:06:34,610 --> 00:06:41,040
غضبتَ عندما انضمّ إتشيزن من جديد
لفريق اليابان من فريق أمريكا

64
00:06:41,700 --> 00:06:45,050
لكن في أعماقك، كنت سعيداً جدّاً
حيال الأمر، أليس كذلك؟

65
00:06:46,320 --> 00:06:49,040
أنت رجلٌ طيّب، أتعلم ذلك؟

66
00:06:51,620 --> 00:06:53,020
أوشيتاري؟

67
00:06:53,020 --> 00:06:54,050
سأُرافقك

68
00:06:54,640 --> 00:06:55,860
شكراً

69
00:07:04,570 --> 00:07:06,830
مـ-من هؤلاء؟

70
00:07:06,830 --> 00:07:09,200
سمعتُ بأنّه بلدٌ مليء بالألغاز

71
00:07:09,590 --> 00:07:13,440
حتّى إينوي وياناغي كانا يشتكيان بشأن عدم قدرتهما
في الحصول على معلومات عنهم

72
00:07:13,780 --> 00:07:19,110
حقيقة فوزهم في كُلّ مُباراة في مجموعتهم
بنتيجة 2-3 مُخيفة قليلاً أيضاً

73
00:07:19,110 --> 00:07:21,210
ربحوا كُلّ مُباراة 2-3؟

74
00:07:22,160 --> 00:07:24,450
سينتهي المطاف بتلك الكُرة هنا

75
00:07:24,450 --> 00:07:25,260
—موموشيرو

76
00:07:25,260 --> 00:07:27,330
سأذهب للتّعريف عن نفسي

77
00:07:28,600 --> 00:07:31,810
لا يمكنك تحقيق هوم ران هكذا

78
00:07:31,810 --> 00:07:33,630
لا يمكنك فحسب يا رجل

79
00:07:35,370 --> 00:07:36,970
بوم

80
00:07:38,480 --> 00:07:39,920
!يا للهول

81
00:07:39,920 --> 00:07:41,640
ها قد فعلتها

82
00:07:41,640 --> 00:07:43,810
ا-المعذرة

83
00:07:45,640 --> 00:07:49,230
.لعلّي ضربتُها بقوّة زائدة عن اللّزوم
لا، أمزح فحسب

84
00:07:50,820 --> 00:07:53,570
آ-آسف لأنّني سبّبتُ جلبة

85
00:07:53,570 --> 00:07:55,550
سأغادر الآن

86
00:07:55,550 --> 00:07:56,320
ماذا؟

87
00:07:59,040 --> 00:08:01,100
تريدني أن أضرب المزيد؟

88
00:08:01,100 --> 00:08:03,720
حسناً. سأفعل إن كنت مُصرّاً

89
00:08:04,350 --> 00:08:08,090
ما هذا يا موموشيرو؟ أتنوي لعِب
مُباراة مع هؤلاء الأشخاص؟

90
00:08:08,090 --> 00:08:11,190
حسناً. لنرَ ما لديك

91
00:08:11,190 --> 00:08:14,060
ها أنا ذا. هل أنت جاهز؟

92
00:08:14,670 --> 00:08:17,040
هـ-هل هو جاهز؟

93
00:08:24,340 --> 00:08:26,890
حسناً، ماذا عن هناك؟

94
00:08:26,890 --> 00:08:30,900
يبدو ماهراً جدّاً، لكن سرعة
مِضربه ليس بتلك الرّوعة

95
00:08:31,290 --> 00:08:34,160
يبدو أنّ لاعبينا سيكونون على ما يُرام
عند مُواجهتهم

96
00:08:34,160 --> 00:08:35,500
خُذ هذه

97
00:08:35,500 --> 00:08:37,650
سكّين الجيب الأسود الجديد

98
00:08:41,430 --> 00:08:42,870
إنّه نفس الشّيء

99
00:08:43,150 --> 00:08:44,650
بوم

100
00:08:44,650 --> 00:08:47,540
رغم أنّه سُحب، ما زال يتطوّر

101
00:08:49,330 --> 00:08:52,210
أتريد الفوز في هذا يا موموشيرو؟

102
00:09:00,220 --> 00:09:01,300
…ماذا

103
00:09:01,300 --> 00:09:34,120
أرامينوما. أرامينوما

104
00:09:07,420 --> 00:09:10,070
ما هذه التّرتيلة المُخيفة؟

105
00:09:21,960 --> 00:09:23,430
موموشيرو؟

106
00:09:31,160 --> 00:09:33,040
هذا سيّئ

107
00:09:35,460 --> 00:09:40,660
أرامينوما. أرامينوما

108
00:09:40,660 --> 00:09:41,980
توقّفوا عن ذلك

109
00:09:43,840 --> 00:09:45,980
قلتُ توقّفوا

110
00:09:55,170 --> 00:09:56,200
موموشيرو؟

111
00:10:23,630 --> 00:10:28,320
لاعبو الإعداديّة طُلِبَ منهم الاستراحة
ليوم غد، ومع ذلك هُم هنا

112
00:10:28,320 --> 00:10:32,060
منذ انضمامه، بدا اللّاعبون الآخرون مُتحمّسين

113
00:10:34,280 --> 00:10:38,530
يبدو أنّه تمكّنَ من إشعال نار في قلوب الجميع

114
00:10:38,530 --> 00:10:40,520
جميعهم مُؤتمنون

115
00:10:43,020 --> 00:10:46,090
على أيّ حال، لدينا اجتماع في الفندق

116
00:10:48,740 --> 00:10:51,810
…بالمُناسبة، خصمنا الأوّل، جمهوريّة أرامينوما

117
00:10:53,810 --> 00:10:55,960
لم أسمع بها أبداً

118
00:10:56,210 --> 00:10:59,270
يُقال بأنّها بلد جديدة كُلّياً

119
00:10:59,270 --> 00:11:01,860
أين سمعت ذلك يا فوجي؟

120
00:11:01,860 --> 00:11:02,770
من يدري؟

121
00:11:03,400 --> 00:11:04,300
ما الخطب؟

122
00:11:04,830 --> 00:11:06,570
أوشيتاري؟ مومو؟

123
00:11:08,920 --> 00:11:10,300
ماذا حدث يا مومو؟

124
00:11:10,790 --> 00:11:12,280
!تماسك

125
00:11:17,980 --> 00:11:20,580
هذا ليس طبيعيّاً

126
00:11:20,580 --> 00:11:24,250
!موموشيرو! استفِق

127
00:11:24,250 --> 00:11:25,930
لا يا سانادا

128
00:11:25,930 --> 00:11:27,370
لا تصرخ هكذا

129
00:11:27,370 --> 00:11:28,320
آ-آسف

130
00:11:28,600 --> 00:11:31,350
كيتي، أحضر بعض الماء

131
00:11:31,350 --> 00:11:34,080
نيوه، ضع منشفة تحت رأسه

132
00:11:40,230 --> 00:11:42,820
أوشيتاري، ماذا حدث؟

133
00:11:42,820 --> 00:11:46,670
قال بأنّه أراد تفقُّد خصمنا الأوّل، أرامينوما

134
00:11:46,970 --> 00:11:51,690
أرامينوما. أرامينوما

135
00:11:48,590 --> 00:11:51,290
بدؤوا بتكرار هذه التّرتيلة المُخيفة

136
00:11:51,290 --> 00:11:56,640
تزامَنوا معه ووجّهوا ضرراً مُباشراً لعقله

137
00:11:57,110 --> 00:12:01,890
إذاً تمكّنتَ من الإفلات بإغلاق عقلك يا أوشيتاري؟

138
00:12:01,890 --> 00:12:03,020
أجل

139
00:12:03,020 --> 00:12:05,300
هذا لأنّه تدخّلَ في شؤون غيره

140
00:12:07,860 --> 00:12:09,920
إتشيزن، كيف أمكنَك قول ذلك؟

141
00:12:09,920 --> 00:12:11,080
أويشي

142
00:12:11,290 --> 00:12:13,070
سأخلد إلى النّوم

143
00:12:13,470 --> 00:12:17,820
إنّهما من نفس المدرسة، ومع ذلك
لا يُبالي مثلما نُبالي نحن

144
00:12:18,720 --> 00:12:20,940
أريد قضاء حاجتي

145
00:12:26,900 --> 00:12:31,000
جمهوريّة أرامينوما؟ تبدو مُزعجة

146
00:12:31,930 --> 00:12:34,020
كوشيماي، انتظر

147
00:12:34,580 --> 00:12:36,240
أتريد شيئاً؟

148
00:12:36,550 --> 00:12:38,180
أنا قادمٌ أيضاً

149
00:12:39,110 --> 00:12:41,150
للانتقام لمومو

150
00:12:45,830 --> 00:13:12,940
أرامينوما. أرامينوما

151
00:13:01,370 --> 00:13:03,320
أخرِجوا المزيد

152
00:13:03,730 --> 00:13:07,180
تخطّوا حدودَ قدراتكم

153
00:13:13,720 --> 00:13:16,180
أرامينوما

154
00:13:17,400 --> 00:13:20,610
يبدو أنّ التّجربة قد فشلتْ

155
00:13:22,390 --> 00:13:25,380
عقولهم ضعيفة للغاية

156
00:13:25,860 --> 00:13:29,920
هل يمكنكم تعليمنا بعض التّنس أيضاً؟

157
00:13:38,130 --> 00:13:44,480
الأفعال الّتي تُدمِّر العقل أو تُسبِّب للشّخص
فقدان إحساسه بذاته مُحرَّمة

158
00:13:45,340 --> 00:13:48,700
ما الّذي يجري هنا؟ الجميع يرتدون أقنعة

159
00:13:48,700 --> 00:13:51,020
هل هذا مقلبٌ أم ماذا؟

160
00:13:51,020 --> 00:13:53,190
هذا ليس طريفاً إطلاقاً

161
00:13:53,190 --> 00:13:56,260
في الواقع، أنا غاضبٌ جدّاً الآن

162
00:13:58,090 --> 00:14:01,320
نحن نُعلن الحرب. لنفعلها

163
00:14:09,750 --> 00:14:11,530
أتيتُما في الوقت

164
00:14:15,680 --> 00:14:18,110
ما هذا؟ ليس لديكم ما تقولونه؟

165
00:14:18,490 --> 00:14:19,960
ألن تتقدّموا؟

166
00:14:19,960 --> 00:14:22,670
لمعلوماتك، لن أدعك تمضي بعيداً فحسب

167
00:14:22,670 --> 00:14:33,210
أرامينوما. أرامينوما

168
00:14:25,510 --> 00:14:27,750
إذاً ستلعبان أوّلاً؟

169
00:14:28,140 --> 00:14:30,630
لا أستطيع التّمييز بينكما

170
00:14:35,430 --> 00:14:38,310
حسناً، سأعتبر ذلك كبداية للمُباراة

171
00:14:38,720 --> 00:14:40,890
هذا حماسيّ

172
00:14:48,630 --> 00:14:50,620
أرامينوما

173
00:14:59,030 --> 00:15:01,460
تخلّصوا من بعضكم الآخر

174
00:15:02,010 --> 00:15:06,370
أرامينوما. أرامينوما

175
00:15:12,010 --> 00:15:14,570
!إن تلقّيت ضربة، فرُدّها

176
00:15:17,360 --> 00:15:19,020
أليس كذلك يا كوشيماي؟

177
00:15:27,710 --> 00:15:29,230
ما زال الطّريق أمامك طويلاً

178
00:15:39,130 --> 00:16:06,440
أرامينوما. أرامينوما

179
00:16:07,540 --> 00:16:10,730
البشر مخلوقات بسيطة

180
00:16:13,720 --> 00:16:16,320
لن أدع أحداً منكم يفلت

181
00:16:17,400 --> 00:16:19,250
ما مُشكلة هذا الشّخص؟

182
00:16:19,250 --> 00:16:24,000
أرامينوما. أرامينوما

183
00:16:24,310 --> 00:16:27,200
ألم يتأثّر بالتحكُّم العقليّ؟

184
00:16:36,680 --> 00:16:38,830
ماذا يعني أرامينوما؟

185
00:16:38,830 --> 00:16:43,080
لم يكونوا مثلما توقّعتُهم، أليس
كذلك يا كوشيماي؟

186
00:16:42,010 --> 00:16:43,940
أرامينوما

187
00:16:43,940 --> 00:16:45,070
كوشيماي؟

188
00:16:45,070 --> 00:16:49,020
أرامينوما. أرامينوما

189
00:16:50,910 --> 00:16:54,500
أنت تُضحكني. حتّى أنت تحبّ
المُزاح يا كوشيماي؟

190
00:16:54,500 --> 00:16:55,170
ماذا؟

191
00:16:55,760 --> 00:16:59,080
ماذا؟ هل انتهت بهذه السّرعة؟

192
00:16:59,840 --> 00:17:01,360
بجدّية؟

193
00:17:03,020 --> 00:17:07,770
كان إحماء جيّداً للبطولة النّهائيّة

194
00:17:09,290 --> 00:17:11,730
إيّاكم والاستهانة بالتّنس اليابانيّ

195
00:17:11,730 --> 00:17:15,790
أصبحتَ أقوى بعد السّفر إلى أمريكا يا كوشيماي

196
00:17:15,790 --> 00:17:17,360
لا بأس بك أيضاً يا كينتارو

197
00:17:17,360 --> 00:17:19,850
تمكّنّا من الثّأر لمومو

198
00:17:19,850 --> 00:17:21,900
لم أفعل هذا لأجل ذلك

199
00:17:21,900 --> 00:17:23,820
لا داعي للخجل بشأن ذلك

200
00:17:30,090 --> 00:17:32,280
لم يعُد هناك حاجة لكم

201
00:17:34,090 --> 00:17:36,170
…طبعة الفهد تلك

202
00:17:39,480 --> 00:17:42,220
سأجعلك خارج الخدمة للأبد

203
00:17:42,810 --> 00:17:45,780
ماذا؟ نربح الجولة الأولى بشكل تلقائيّ؟

204
00:17:46,060 --> 00:17:52,380
يبدو أنّ كافّة لاعبي أرامينوما عادوا
إلى بلدهم في هذا الصّباح

205
00:17:52,380 --> 00:17:53,920
لِمَ ذهبوا؟

206
00:19:11,430 --> 00:19:14,040
أيّها الحارس

207
00:19:14,040 --> 00:19:16,550
ما الأمر يا 1226؟

208
00:19:16,830 --> 00:19:20,000
هل يمكنك إطلاق صوت المُنبّه؟

209
00:19:20,690 --> 00:19:23,220
ما الّذي تتحدّث عنه؟

210
00:19:23,220 --> 00:19:24,350
لن تفعل؟

211
00:19:24,700 --> 00:19:28,290
…بالطّبع لا. لِمَ يستمع أحدٌ لكلام سجين

212
00:19:36,460 --> 00:19:38,160
هكذا أريدك أيُّها الحارس

213
00:19:38,570 --> 00:19:41,270
والآن، افتح قفل باب الزنزانة

214
00:19:42,180 --> 00:19:44,890
وسلّم ملابسك لي

215
00:19:51,040 --> 00:19:53,170
…السّجين 1226

216
00:19:53,170 --> 00:19:54,250
قد هرب…

217
00:19:54,250 --> 00:19:57,620
يبدو أنّه يستخدم الممرّات المائيّة تحت
الأرض للوصول إلى السّاحل

218
00:19:57,620 --> 00:20:00,510
حسناً. الفريق أ، اسلك الممرّ
المائيّ تحت الأرض

219
00:20:00,510 --> 00:20:02,980
الفريق ب، صِلوا إلى السّاحل وسدّوا طريقه

220
00:20:02,980 --> 00:20:03,840
حاضر

221
00:20:07,870 --> 00:20:11,430
مرحباً؟ سامحني يا ميدانوري

222
00:20:12,880 --> 00:20:15,420
أجل، أنا مشغول قليلاً حاليّاً

223
00:20:15,800 --> 00:20:18,430
فقط دع الأمر لروميفيرن بعد يوم غد

224
00:20:19,380 --> 00:20:23,700
آسف، ماذا؟ سنلعب مع اليابان في النّهائي؟

225
00:20:25,450 --> 00:20:28,510
مُثير. إذاً ألمانيا قد خسرت، صحيح؟

226
00:20:31,520 --> 00:20:34,210
أعتذر لك يا سيّدي الرّئيس

227
00:20:34,210 --> 00:20:38,870
.تتفاقم مقالِب روميو سوءاً في كلّ عام
إنّها تغدو مُشكلة

228
00:20:38,870 --> 00:20:43,750
…لا أصدِّق بأنّه حبسَ نفسه فقط كي يهرب

229
00:20:45,260 --> 00:20:47,550
كم بقي حتّى الوصول إلى ميلبورن؟

230
00:20:48,470 --> 00:20:49,940
رافاييل؟

231
00:20:49,940 --> 00:20:52,500
حوالي تسع ساعات أُخرى يا سيّدي

232
00:20:53,060 --> 00:20:55,040
موتشاس غراشياس

233
00:20:59,210 --> 00:21:03,920
ذلك البلد الذّهبيّ الّذي هزمَ ألمانيا
العظيمة، جيبانغ

234
00:21:04,980 --> 00:21:07,680
انتظروا فحسب يا يابان

235
00:21:09,040 --> 00:21:12,950
.شاي النّصر بعد الظّهر هو الأفضل
أليس كذلك؟

236
00:21:12,950 --> 00:21:17,710
إذاً لاعب الولايات المُتّحدة الأمريكيّة السّابق الّذي
…ظهرَ في التّشكيلة فجأة، السّيّد وسيم

237
00:21:17,710 --> 00:21:18,960
هل يمكننا الوثوق به؟

238
00:21:21,910 --> 00:21:26,000
من كان يتوقّع أن يهزمَ قائدَ فريق أمريكا؟

239
00:21:26,250 --> 00:21:28,920
ردّ الجميل بالجحود

240
00:21:28,920 --> 00:21:30,770
كم هو جسور

241
00:21:31,040 --> 00:21:34,090
أجل. تقصدين ريوغا إتشيزن، صحيح؟

242
00:21:34,440 --> 00:21:37,770
يبدو أنّه ابن المُدرِّب

243
00:23:17,240 --> 00:23:22,170
أخيراً، مُباريات الجولة الثّالثة المصيريّة لتحديد
التّشكيلة الرّئيسيّة في النّهائي تبدأ

244
00:23:22,920 --> 00:23:26,060
كُلّ المخاوف. كُلّ الألم. كُلّ البهجة

245
00:23:26,060 --> 00:23:30,220
الجميع ينقلون تجاربَهم إلى الملعب
ويضعونها على المحكّ

246
00:23:30,550 --> 00:23:33,100
"الحلقة القادمة: "اطمح للنّصر فقط

247
00:23:33,350 --> 00:23:36,520
فوجي، سوف أبذل قصارى جهدي أيضاً

248
00:23:36,520 --> 00:23:38,090
سوف أربح حتماً