1
00:00:03,810 --> 00:00:07,100
عاد بامبيري إلى المنزل باكراً من جديد

2
00:00:07,100 --> 00:00:10,230
ألا يعرف شيئاً عن التّعاون الجماعيّ؟ بجدّية

3
00:00:11,430 --> 00:00:15,030
يبدو أنّه كان يتمرّن بمفرده في وقت
متأخّر من اللّيل

4
00:00:15,300 --> 00:00:18,480
وجوده كلاعب رئيسيّ في الفريق
قد جعلَه يغترّ، أليس كذلك؟

5
00:00:20,330 --> 00:00:23,590
ليس وكأنّه يتكاسل، لذا هذا ليس بالأمر الجلل

6
00:00:23,590 --> 00:00:25,410
...هذا صحيح، لكن مع ذلك

7
00:00:25,730 --> 00:00:28,760
ذلك الرّجل يستفزّني فحسب

8
00:00:28,760 --> 00:00:30,780
أتفهّم مقصدك

9
00:00:31,700 --> 00:00:34,240
هيّا يا فيليب وآدريان

10
00:00:34,240 --> 00:00:35,470
نحن فريق

11
00:00:36,240 --> 00:00:38,170
لذا يجب علينا أن ننسجم جميعاً

12
00:00:38,170 --> 00:00:39,710
حُبّ وسلام

13
00:00:40,010 --> 00:00:41,190
أجل، أجل

14
00:00:41,190 --> 00:00:43,050
فهمنا يا يوليو

15
00:00:43,330 --> 00:00:47,150
بامبيري حُرّ الطّبع ويحبّ تخصيص
وقت لنفسه بصورة جادّة

16
00:00:49,380 --> 00:00:52,350
تأخُّر ثمان دقائق و 19 ثانية كثير حقّاً

17
00:00:52,640 --> 00:00:57,700
إن كنتُ بصيص أمل، لأهدرتُ بالفعل
ما يكفي من وقت لبلوغ الشّمس

18
00:00:57,980 --> 00:01:00,330
هذه مُشكلة حقيقيّة

19
00:01:02,810 --> 00:01:04,420
أعتقد بأنّني لا أملك خياراً

20
00:01:10,590 --> 00:01:11,810
!شكراً على التّوقيع

21
00:01:12,930 --> 00:01:15,100
!سوف أُشجِّعك

22
00:01:20,300 --> 00:01:21,590
...هل هذا

23
00:01:21,880 --> 00:01:23,310
بامبيري؟

24
00:01:33,680 --> 00:01:34,950
وصلتُ للتو

25
00:01:34,950 --> 00:01:36,740
أهلاً وسهلاً

26
00:01:37,070 --> 00:01:39,940
أنت دوماً في الموعد لأجل هذه، أليس كذلك؟

27
00:01:39,940 --> 00:01:41,870
أنا تلميذ لديه مُتّسع من الوقت

28
00:01:41,870 --> 00:01:45,660
مُعجّنات التّوت الأزرق هذه
طازجة من الفرن مُباشرة

29
00:01:46,880 --> 00:01:49,590
!راؤول! ريناتو

30
00:01:49,590 --> 00:01:51,140
حان وقت العشاء

31
00:01:51,140 --> 00:01:52,620
تفضّلا إلى غرفة الطّعام

32
00:01:53,520 --> 00:01:55,960
لديّ فطائر التّوت الأزرق، المُفضّلة لديكما

33
00:01:56,790 --> 00:01:58,150
لستُ مُهتمّاً

34
00:01:58,150 --> 00:02:00,420
فضلاً عن ذلك، هناك واحدة فقط، صحيح؟

35
00:02:00,750 --> 00:02:03,680
أحضرها السّيّد بامبيري

36
00:02:04,650 --> 00:02:05,880
اثنتان

37
00:03:44,120 --> 00:03:45,580
30-40

38
00:03:56,310 --> 00:03:57,620
إرساليّة تانهوسر

39
00:04:07,040 --> 00:04:08,600
روندو الدّمار ثانية؟

40
00:04:11,520 --> 00:04:14,280
فوغا اليأس

41
00:04:14,280 --> 00:04:16,320
مُدهش كالعادة

42
00:04:17,360 --> 00:04:19,390
شوط. 0-1

43
00:04:19,720 --> 00:04:20,750
أوشيتاري

44
00:04:21,260 --> 00:04:25,410
لست أحمق بما يكفي للاعتقاد بأنّك تستطيع
هزيمتي باستخدام تقنيّاتي، صحيح؟

45
00:04:25,910 --> 00:04:27,680
ما الّذي تُفكِّر فيه بالتّحديد؟

46
00:04:28,200 --> 00:04:30,250
لا تستعجل الأمور

47
00:04:31,600 --> 00:04:34,710
يستغرق القمر وقتَه للتألُّق

48
00:04:42,880 --> 00:04:45,630
هل هي ضربة قويّة؟ لا

49
00:04:46,280 --> 00:04:47,700
تسديدة هابِطة ومُزيّفة

50
00:04:50,350 --> 00:04:51,390
تسديدة النّهج المُسطّح

51
00:04:52,950 --> 00:04:54,250
15-0

52
00:04:55,040 --> 00:04:59,280
،هدفه هو استدراجه نحو الشّبكة
،ثمّ توجيه رمية قويّة لاذِعة

53
00:04:59,280 --> 00:05:02,280
لكن يتعامل أتوبي مع كلّ تسديدة

54
00:05:03,560 --> 00:05:04,690
تسديدة النّهج الدّوران الجانبيّ

55
00:05:06,110 --> 00:05:07,400
30-0

56
00:05:19,000 --> 00:05:20,300
مُرتدّة اندفاعيّة مُسطَّحة مُباشرة

57
00:05:20,750 --> 00:05:22,140
كشفتُ تحرّكاتك

58
00:05:23,330 --> 00:05:24,600
40-0

59
00:05:25,370 --> 00:05:28,060
شوط. 0-2

60
00:05:28,630 --> 00:05:32,470
لن تدع الأمر ينتهي هنا، أليس كذلك؟

61
00:05:32,810 --> 00:05:35,670
بالطّبع لا. هنا قد بدأت

62
00:05:36,360 --> 00:05:39,790
في الشّوط الأوّل، استخدمَ تقنيّات
،أتوبي ضدّه

63
00:05:39,790 --> 00:05:42,850
وفي الثّانية، اندفع للأمام باستخدام تقنيّاته الخاصّة

64
00:05:43,210 --> 00:05:46,990
لكن ردّها أتوبي أيضاً

65
00:05:46,990 --> 00:05:49,630
...لذا حاليّاً، في هذا الشّوط الثّالث

66
00:05:56,210 --> 00:05:58,010
روندو الدّمار

67
00:05:58,010 --> 00:06:00,250
لا، إنّها فارغا اليأس

68
00:06:01,940 --> 00:06:04,960
حان الوقت لتضع حدّاً لهذه المهزلة

69
00:06:08,390 --> 00:06:09,710
15-0

70
00:06:11,680 --> 00:06:14,270
قرّرتُ تعديلها قليلاً

71
00:06:15,210 --> 00:06:18,580
ضربت الكُرة بطريقة قتلت الدّوران، صحيح؟

72
00:06:19,540 --> 00:06:23,390
نجحَ ذلك لأنّه يعرف تقنيّات
أتوبي عن ظهر قلب

73
00:06:25,740 --> 00:06:30,530
فهمت. يضيء القمر بشكل مُختلف
بحسب أشعّة الشّمس

74
00:06:31,010 --> 00:06:33,590
كان ذلك رائعاً يا أوشيتاري

75
00:06:34,500 --> 00:06:40,010
يبدو أنّ المُحادثة بين الشّمس
والقمر قد بدأت للتو

76
00:06:47,400 --> 00:06:48,710
40-15

77
00:06:56,000 --> 00:06:59,440
"استمرّ في الختم على "وهم
كُلّياً حتّى اللّحظة

78
00:07:00,170 --> 00:07:04,740
تنوي المُنافسة بصفة نيو ماساهارو، صحيح؟

79
00:07:06,240 --> 00:07:08,230
أتطلّع قُدماً لذلك

80
00:07:09,720 --> 00:07:11,320
40-15

81
00:07:13,090 --> 00:07:15,400
شوط. 0-2

82
00:07:15,400 --> 00:07:18,300
يبدو أنّك تمكّنت من حصدت شوطين
على التّوالي منّي

83
00:07:18,300 --> 00:07:20,860
أعتقد بأنّ الحظّ لم يبتسم لك، صحيح؟

84
00:07:22,150 --> 00:07:23,770
غلبتني في ذلك

85
00:07:26,270 --> 00:07:28,680
أشعر بتغيُّر في سينغوكو

86
00:07:37,120 --> 00:07:38,350
15-0

87
00:07:38,790 --> 00:07:43,150
كان ذلك إرسالاً جيّداً

88
00:07:43,740 --> 00:07:47,100
بالطّبع، أنت على وشك أن تستخدمها
مرّة أُخرى، صحيح؟

89
00:07:47,100 --> 00:07:49,610
سأستخدمها أكبر عدد مُمكن من المرّات

90
00:07:54,020 --> 00:07:55,540
30-0

91
00:07:55,540 --> 00:07:56,750
تبّاً

92
00:08:02,910 --> 00:08:06,620
للاستحواذ على الزّخم، يجب
أن أكسب هذه النّقطة

93
00:08:16,140 --> 00:08:17,850
30-15

94
00:08:18,780 --> 00:08:21,510
كان يعرف بالضّبط إلى أين سينتهي
مِدفع النّمر بالضّبط

95
00:08:21,890 --> 00:08:24,200
شوط. 0-3

96
00:08:24,430 --> 00:08:27,140
سمحَ لأفضليّته الحاسِمة المُبكّرة تفلت، صحيح؟

97
00:08:34,430 --> 00:08:35,520
مِدفع نمر؟

98
00:08:40,060 --> 00:08:41,650
0-15

99
00:08:42,580 --> 00:08:46,720
،لم تسرق مِدفع النّمر لنفسك فحسب
بل أتقنتها أيضاً

100
00:08:47,090 --> 00:08:50,580
أنت تقول ذلك، لكنّك رددتها بسهولة

101
00:08:50,860 --> 00:08:51,990
...في هذه الحالة

102
00:09:00,160 --> 00:09:02,230
15-15

103
00:09:06,360 --> 00:09:10,660
أضافَ عنصرَ إرساليّته المُلتوية
إلى مِدفع النّمر

104
00:09:11,090 --> 00:09:12,730
ما زال الطّريق أمامك طويلاً

105
00:09:13,060 --> 00:09:16,380
بجدّية. أنت لا تستسلم

106
00:09:17,210 --> 00:09:18,720
ها هي الحركة التّالية

107
00:09:30,090 --> 00:09:33,960
،رأيتُ إتشيزن يلعب ما يكفي من مرّات

108
00:09:34,400 --> 00:09:36,970
لكن بمُواجهته، أستطيع أن أؤكّد شيئاً واحداً

109
00:09:36,970 --> 00:09:39,310
إنّه يتطوّر مع كلّ شوط

110
00:09:39,310 --> 00:09:40,100
...لا

111
00:09:40,600 --> 00:09:43,490
بالأحرى مع كلّ تسديدة

112
00:09:48,030 --> 00:09:50,020
30-15

113
00:09:50,020 --> 00:09:51,910
...لا أعرف السّبب

114
00:09:53,910 --> 00:09:55,820
هذا مُبهج كثيراً

115
00:10:10,490 --> 00:10:11,500
تونو

116
00:10:11,500 --> 00:10:15,350
طريقة التّنفيذ 2: طلقة

117
00:10:19,170 --> 00:10:20,560
الدّفن الحيّ

118
00:10:22,270 --> 00:10:23,520
!تسوكي

119
00:10:27,410 --> 00:10:28,890
30-30

120
00:10:30,910 --> 00:10:33,230
ما مُشكلة تونو؟

121
00:10:33,230 --> 00:10:37,140
عادة في مثل هذه الفترة يبدأ بالتحدُّث بغرور

122
00:10:42,250 --> 00:10:44,200
ها هي ذي. إرساليّة بسرعة ماخ

123
00:10:44,960 --> 00:10:46,420
دع الأمر لي

124
00:10:47,840 --> 00:10:50,750
فلديّ مجموعة كاملة من بيانات أوتشي

125
00:10:50,750 --> 00:10:54,670
كيميشيما يُجاري إرساليّة ماخ
خاصّته في هذه المُباراة

126
00:10:56,550 --> 00:10:57,340
!تونو

127
00:10:57,340 --> 00:10:58,590
!أعلم

128
00:10:58,880 --> 00:11:04,920
عندما يردّ الكُرة، يُقرّر بهدوء
متى يتركها لتونو

129
00:11:05,260 --> 00:11:08,320
كيميشيما هو الشّخص الّذي
يتحكّم بهذه المُباراة

130
00:11:08,320 --> 00:11:09,980
هذا هو الأمير كيمي

131
00:11:11,530 --> 00:11:13,350
!الثّور النّحاسيّ

132
00:11:14,480 --> 00:11:16,340
30-40

133
00:11:18,600 --> 00:11:23,020
يبدو تونو كشخص مُختلف، أليس كذلك؟

134
00:11:23,020 --> 00:11:24,210
لا أُبالي

135
00:11:25,630 --> 00:11:28,280
شوط. 0-5

136
00:11:32,200 --> 00:11:35,870
لم يربح سينغوكو أي مُباراة بعد

137
00:11:36,260 --> 00:11:38,420
كُلّ هذا بخُطى إتشيزن

138
00:11:39,460 --> 00:11:42,840
هل سأدع الأمر ينتهي هكذا فحسب؟

139
00:11:42,840 --> 00:11:44,920
لا تستخفّ بهذا

140
00:11:45,420 --> 00:11:46,850
ماذا تفعل هنا؟

141
00:11:47,390 --> 00:11:49,850
مُجرّد عابر سبيل

142
00:11:51,090 --> 00:11:55,100
،تمّت دعوتي للانضمام لفريق اليابان
ابتداء بالمُباراة ضدّ فرنسا

143
00:11:55,700 --> 00:11:57,740
سأبذل قصارى جهدي لأجلك أيضاً يا أكوتسو

144
00:11:58,050 --> 00:12:00,210
لا تستخفّ بهذا

145
00:12:00,210 --> 00:12:03,520
،إن كان لديك الوقت للتّواجد هنا
فاذهب وتدرّب

146
00:12:05,950 --> 00:12:07,220
هذا صحيح

147
00:12:07,530 --> 00:12:09,650
لستُ بديل أكوتسو

148
00:12:10,030 --> 00:12:13,250
...أنا، كيوسومي سينغوكو

149
00:12:14,880 --> 00:12:16,950
سأقاتل وأربح

150
00:12:26,660 --> 00:12:28,040
15-0

151
00:12:31,010 --> 00:12:32,600
15-15

152
00:12:33,530 --> 00:12:34,890
30-15

153
00:12:43,980 --> 00:12:45,520
30-30

154
00:12:46,380 --> 00:12:47,860
أنت عنيدٌ حقّاً

155
00:12:47,860 --> 00:12:50,150
لم أبدأ بعد

156
00:12:50,510 --> 00:12:52,790
لن ينتهي الأمر هكذا

157
00:12:52,790 --> 00:12:54,790
لا أستطيع أن أدع الأمر ينتهي هكذا

158
00:13:03,490 --> 00:13:07,610
كان سينغوكو يمتلك فِطنة بصريّة
ديناميكيّة استثنائيّة

159
00:13:07,610 --> 00:13:10,260
...حالما يعتاد على تسديدات إتشيزن

160
00:13:22,160 --> 00:13:24,480
شوط. 5-1

161
00:13:24,480 --> 00:13:27,070
استخدمَ مِدفع النّمر لتوجيه تسديدة قويّة؟

162
00:13:27,070 --> 00:13:29,660
يغدو الأمر مُثيراً للاهتمام

163
00:13:43,460 --> 00:13:44,970
0-15

164
00:13:45,860 --> 00:13:47,290
15-15

165
00:13:47,760 --> 00:13:49,390
30-15

166
00:13:49,820 --> 00:13:51,380
30-30

167
00:13:51,670 --> 00:13:53,340
30-40

168
00:13:57,320 --> 00:14:00,260
دعني أرى تسديدتك القويّة مرّة أُخرى

169
00:14:00,660 --> 00:14:03,870
لأنّه إتشيزن، سيردُّ التّالية

170
00:14:03,870 --> 00:14:05,280
لا أستطيع استخدام نفس الرّمية

171
00:14:07,200 --> 00:14:11,110
ما لم تُستوفَ شروط تسديد
...رمية أكثر قوّة

172
00:14:12,380 --> 00:14:13,370
!هذه

173
00:14:13,370 --> 00:14:14,750
هذه هي

174
00:14:16,190 --> 00:14:17,920
تمّ استيفاء الشّروط

175
00:14:17,920 --> 00:14:20,080
لست الوحيد الّذي يتطوّر

176
00:14:21,330 --> 00:14:22,750
!مِدفع التنّين

177
00:14:35,040 --> 00:14:38,630
إذاً هذا ما يقتصر عليه ريوما إتشيزن، صحيح؟

178
00:14:41,100 --> 00:14:42,740
محظوظ

179
00:14:43,010 --> 00:14:48,020
انتهاء الشّوط. ريوما إتشيزن يربح، 1-6

180
00:14:48,560 --> 00:14:50,360
حسناً

181
00:14:50,650 --> 00:14:54,450
لا عجب في أنّ كاره التّنس أكوتسو مفتون به

182
00:15:04,260 --> 00:15:06,790
شوط. 2-3

183
00:15:08,890 --> 00:15:12,170
يبدو أنّ القمر بدأ يتألّق أكثر

184
00:15:13,960 --> 00:15:18,260
أتوبي، مضى وقت طويل منذ
واجهتُك بشكل صريح هكذا

185
00:15:19,230 --> 00:15:24,350
لم نخُض معركة صريحة منذ ذلك
اليوم، أليس كذلك يا أوشيتاري؟

186
00:15:25,730 --> 00:15:28,070
ظننتُك رجلاً مجنوناً بمهارات جنونيّة

187
00:15:28,400 --> 00:15:31,420
اعتقدتُ بأنّ شخصاً مُثيراً للاهتمام قد ظهر

188
00:15:31,730 --> 00:15:35,830
تحدّيتني، وفي لحظة ما، بدأت تستمتع بذلك

189
00:15:36,570 --> 00:15:39,500
،ربحتُ تلك المُباراة آنذاك

190
00:15:39,500 --> 00:15:44,040
لكن تركتني أشعر بأنّك قد تكون
لاعب التّنس الأفضل

191
00:15:44,790 --> 00:15:50,520
آمنتُ بأنّ أيّ شخص لا يستطيع المُجاراة
غير مرغوب فيه في الفريق

192
00:15:50,520 --> 00:15:51,390
...لكن

193
00:15:51,810 --> 00:15:55,270
بوجودك، لم يتمكّن الآخرون من المُواظبة
،والمُجاراة فحسب

194
00:15:55,270 --> 00:15:58,980
بل فاقوا توقُّعاتي بكثير أيضاً

195
00:15:59,340 --> 00:16:02,140
عندما أدركتُ ذلك، كنتَ قد أصبحت
شخصيّتي المُعاكِسة

196
00:16:03,520 --> 00:16:07,390
سنغزو الدّولةَ بأكملها. كنتُ
قد اقتنعتُ تماماً بذلك

197
00:16:07,390 --> 00:16:10,560
لكنّنا خسرنا

198
00:16:10,940 --> 00:16:13,070
هل أنت جادّ؟

199
00:16:13,070 --> 00:16:16,410
المُدرّب ساكاكي قالها، لذا
لا بُدّ أنّ ذلك صحيح

200
00:16:16,410 --> 00:16:19,340
!هذا رائع جدّاً! أنا مُتحمّس للغاية

201
00:16:19,340 --> 00:16:22,920
إلى أين ذهب أتوبي في وقت حرِج كهذا؟

202
00:16:22,920 --> 00:16:25,340
على أيّ حال، لنتفرّق ونبحث عنه

203
00:16:25,340 --> 00:16:27,210
يجب علينا إخباره بسرعة

204
00:16:34,460 --> 00:16:36,180
ها هو ذا

205
00:16:36,180 --> 00:16:39,310
أتوبي! وصلنا إلى البطولة الوطنيّة أيضاً

206
00:16:39,310 --> 00:16:41,580
يبدو أنّنا سنحظى بمكان كمدينة مُضيفة

207
00:16:41,580 --> 00:16:44,940
قالوا بأنّ أكاديميّة هيوتي تمّ اختيارها من طوكيو

208
00:16:44,940 --> 00:16:45,910
!أوتوبي

209
00:16:47,040 --> 00:16:49,390
نريد الذّهاب حقّاً مهما حدث

210
00:16:49,390 --> 00:16:52,940
من يأبه كيف وصلنا إلى هناك؟
!أريد الذّهاب إلى البطولة الوطنيّة وحسم النّتيجة

211
00:16:52,940 --> 00:16:54,880
يا قائد. من فضلك

212
00:16:54,880 --> 00:16:55,820
!أتوبي

213
00:17:01,700 --> 00:17:04,120
هيوتي سيربح

214
00:17:04,120 --> 00:17:18,020
!هيوتي! هيوتي! هيوتي! هيوتي

215
00:17:18,020 --> 00:17:21,680
أيّها الحمقى. انظروا إلى أنفسكم
كيف تتحمّسون أكثر من اللّازم جميعاً

216
00:17:24,440 --> 00:17:27,550
حسناً يا رِفاق. اتبعوني إلى البطولة الوطنيّة

217
00:17:27,550 --> 00:17:33,810
!أجل

218
00:17:31,030 --> 00:17:32,220
!حسناً

219
00:17:33,810 --> 00:17:37,780
!هيوتي! هيوتي! هيوتي! هيوتي

220
00:17:43,080 --> 00:17:46,380
ليس لديك وقت للاستغراق في التّفكير
في أمور غير ضروريّة

221
00:17:48,940 --> 00:17:52,520
.يجب علينا الفوز في الوطنيّة فحسب
هذا كُلّ ما في الأمر

222
00:17:52,950 --> 00:17:55,490
لا جدوى إن لم تكن الرّابح الوحيد

223
00:17:55,490 --> 00:17:59,010
وعندما نخسر، لن تخسر وحدك أيضاً

224
00:17:59,010 --> 00:18:01,010
نحن أكاديميّة هيوتي

225
00:18:02,850 --> 00:18:06,400
تلك كلمات شغوفة صادرة عنك

226
00:18:07,510 --> 00:18:11,740
،كيفما فعلناها في نهاية المطاف
سوف نُحقّق النّصر بجشع

227
00:18:12,060 --> 00:18:14,960
كفى مُماطلة. لنبدأ بالتّدريب بالفعل

228
00:18:14,960 --> 00:18:16,290
حسناً يا شيشيدو

229
00:18:16,290 --> 00:18:18,100
سوف نُسقط نخبة الدّولة

230
00:18:18,100 --> 00:18:18,900
أجل

231
00:18:18,900 --> 00:18:20,940
!سأحلِّق لارتفاع أعلى حتّى

232
00:18:20,940 --> 00:18:22,660
!أنا مُتحمِّس للغاية

233
00:18:23,440 --> 00:18:27,130
هذه هي هيوتي الّتي أسّستَها

234
00:18:28,770 --> 00:18:31,640
تقصد الّتي أسّسناها، صحيح؟

235
00:18:33,080 --> 00:18:35,850
ليس من طبعك أن تقول شيئاً كهذا

236
00:18:41,980 --> 00:18:43,260
أوشيتاري

237
00:18:43,880 --> 00:18:46,820
هذا لأنّك قدتَ هيوتي

238
00:18:47,440 --> 00:18:50,900
هذا لأنّك دعمتَ هيوتي

239
00:18:52,770 --> 00:18:54,290
30-15

240
00:18:56,860 --> 00:19:01,320
لم أتخيّل أن تكون مُواجهتك بشكل صريح
هكذا ستكون بهذه المتعة

241
00:19:01,590 --> 00:19:04,610
أعتقد بأنّ الشّمس على وشك الغروب

242
00:19:04,890 --> 00:19:08,210
لسوء حظّك، قرّرتُ بأنّ اليوم
سيكون يوماً قطبيّاً

243
00:19:18,680 --> 00:19:20,170
أتعود إلى قوقعتك؟

244
00:19:24,630 --> 00:19:26,920
شوط. 3-3

245
00:19:27,410 --> 00:19:29,890
شوط. 3-4

246
00:19:30,620 --> 00:19:33,830
،لو لم يتمّ اختياري لفريق اليابان
لما أدركتُ أبداً

247
00:19:34,550 --> 00:19:39,480
لا أستطيع الاستمرار في السّطوع
أمام ضياءك للأبد

248
00:19:39,850 --> 00:19:44,620
أتوبي، سأذهب لرؤية ما لم تلمحه بعد

249
00:19:44,860 --> 00:19:48,870
أوشيتاري. التّراجع إلى داخل
قوقعتك لن يفلح بعد الآن

250
00:19:50,720 --> 00:19:53,750
،أنت تسطع بشكل برّاق
لدرجة لا يمكن احتواؤها

251
00:19:55,320 --> 00:19:56,380
معك حقّ

252
00:19:56,380 --> 00:19:58,880
بئساً يا رجل. هذا مُبهر للعيون

253
00:20:00,040 --> 00:20:03,000
إذا لم أستطع التّراجع، فسوف أفعل هذا

254
00:20:05,310 --> 00:20:08,140
أنت تكشف نفسك تماماً، صحيح؟

255
00:20:08,140 --> 00:20:09,070
...في هذه الحالة

256
00:20:11,050 --> 00:20:13,130
فلتتجمّد

257
00:20:27,400 --> 00:20:31,500
،لو لم ألتقِ بك في ذلك اليوم
لما بدأ كُلّ هذا

258
00:20:31,830 --> 00:20:35,330
التقيتُ بك فبدأ هذا

259
00:20:37,750 --> 00:20:41,030
...أتوبي، وجودك بحدّ ذاته هو

260
00:20:41,570 --> 00:20:44,920
...أوشيتاري، وجودك اللّعين هو

261
00:20:45,440 --> 00:20:48,150
نقطة بداية حياتي في رياضة التّنس...

262
00:21:02,240 --> 00:21:07,370
نهاية المُباراة. كيغو أتوبي يربح 3-6

263
00:21:08,190 --> 00:21:15,510
تلك الضّربة القويّة كان أقوى من أيّ
تقنيّة شهدتُها من قبل

264
00:21:17,720 --> 00:21:23,170
أوشيتاري. هل أنت نادم على
اختيار الفرديّة 3#؟

265
00:21:23,430 --> 00:21:27,180
لم أملك خياراً. رأيتُ الورقة

266
00:21:27,590 --> 00:21:29,900
احرص لى كسب مقعد لك في الفريق

267
00:21:29,900 --> 00:21:32,890
مهلاً. ورقة؟ عمّاذا تتكلّم؟

268
00:23:17,870 --> 00:23:21,940
الجميع يخوضون المُباراة حاملين
أفكارهم ومشاعرهم الخاصّة

269
00:23:22,290 --> 00:23:25,370
وفي الثّنائيّات 2#، المُباراة الثّانية جارية

270
00:23:25,370 --> 00:23:27,890
ماذا؟ كينتارو يلعب مُباراة ثنائيّة؟

271
00:23:29,430 --> 00:23:30,890
هذا مُثير للاهتمام

272
00:23:30,890 --> 00:23:33,930
"الحلقة القادمة: "قرار يُدعى ثُنائيّات

273
00:23:34,800 --> 00:23:37,940
تستمرّ المعركة الحامية