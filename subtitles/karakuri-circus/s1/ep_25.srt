1
00:00:02,830 --> 00:00:07,830
CH: yume chan

2
00:00:09,730 --> 00:00:11,060
!إنّها قادمة يا ماسارو-سان

3
00:00:11,520 --> 00:00:15,530
!من المحال أن نهزمها كلّها

4
00:00:15,690 --> 00:00:18,700
.لا، سأهزم فايسلس

5
00:00:18,860 --> 00:00:21,820
!وسأنقذ شيروغاني

6
00:01:56,340 --> 00:01:59,920
.فشلت بالقبض على ماسارو بسبب الضباب

7
00:02:00,090 --> 00:02:01,630
.احرصي على القبض عليه

8
00:02:01,920 --> 00:02:04,380
.أريده حيًا يا نايا

9
00:02:04,590 --> 00:02:07,430
.حاضر، اعتمد علينا

10
00:02:07,600 --> 00:02:11,390
.لا حاجة لتدخّل الأربعة الحديثون

11
00:02:12,430 --> 00:02:13,940
.آمل هذا

12
00:02:14,100 --> 00:02:16,900
.ساعداها تحسّبًا

13
00:02:17,060 --> 00:02:18,070
.حاضر

14
00:02:19,190 --> 00:02:23,740
.اشهدوا! جوائز أسلافي العديدة

15
00:02:24,070 --> 00:02:26,780
.عائلة غوندو وعائلة فيلون

16
00:02:26,950 --> 00:02:32,250
.كل العائلات الشريفة والجسورة من أصدقائي

17
00:02:33,120 --> 00:02:34,580
...أثناء الحملات

18
00:02:34,750 --> 00:02:38,750
.كل هذا كذب، لا تمتلك الأوتوماتا أسلافًا ولا نسبًا

19
00:02:39,800 --> 00:02:43,300
.كابتن غرازيانو يطمح للتحلّي بهذه الخصائص البشريّة

20
00:02:44,170 --> 00:02:46,300
.ويصدّق كونه سيدًا نبيلاً

21
00:02:47,010 --> 00:02:49,470
.سمعت أن الفِيلة قوية جدًا

22
00:02:49,640 --> 00:02:51,890
.لهذا أمرتُ بجلب واحد لأقاتله

23
00:02:52,270 --> 00:02:53,730
.لم يستحق عنائي

24
00:02:54,480 --> 00:02:58,730
.ولا يهتم بريغيل إلّا بالفنون القتالية

25
00:02:59,650 --> 00:03:01,730
هل تعرفين رجلاً يدعى نارومي؟

26
00:03:03,030 --> 00:03:06,240
.سمعتُ أنّه يهزم الأوتوماتا بفن الكيمبو

27
00:03:06,530 --> 00:03:07,490
هل هو قويّ؟

28
00:03:09,280 --> 00:03:12,160
.نعم، أقوى منك بكثير

29
00:03:14,160 --> 00:03:16,870
.الغرفة التالية في هذا الاتّجاه فرانسين-ساما

30
00:03:17,040 --> 00:03:20,000
.كم مرّة عليّ إخبارك؟ أنا شيروغاني

31
00:03:22,420 --> 00:03:24,420
أنت أرلكين، صحيح؟

32
00:03:24,590 --> 00:03:27,010
أما يزال علينا مواصلة زيارة هذه الدّمى السخيفة؟

33
00:03:27,180 --> 00:03:31,930
.نعم، فايسلس-ساما طلب منّي مواصلة الترفيه عنك

34
00:03:34,270 --> 00:03:37,190
.أحب الأشياء الجميلة

35
00:03:39,650 --> 00:03:42,150
.الملابس، المجوهرات

36
00:03:42,690 --> 00:03:48,450
.وفرك جسدي بالدماء البشرية

37
00:03:59,920 --> 00:04:03,670
.أنا مهرّج فايسلس-ساما الشخصيّ

38
00:04:03,840 --> 00:04:08,720
.لهذا لن أسمعك أي أغاني سعيدة أو نكات مضحكة

39
00:04:09,470 --> 00:04:14,220
.أمكث هنا على هذه الوضعية حتّى يستدعيني فايسلس-ساما

40
00:04:21,480 --> 00:04:23,650
هل كل الأوتوماتا مثلهم؟

41
00:04:24,320 --> 00:04:28,530
.لا تتفاعل مع بضعها، وتنشغل فقط بما تريده

42
00:04:28,700 --> 00:04:33,620
.نعم، لا يشعرون إلّا بحاجة تمجيد فايسلس-ساما لهم

43
00:04:34,160 --> 00:04:35,660
أنت أيضًا؟

44
00:04:35,870 --> 00:04:40,000
.خدمتك هي بهجتي الوحيدة

45
00:04:40,500 --> 00:04:41,670
...بهجة

46
00:04:42,250 --> 00:04:44,000
.البهجة نوع من التعاطف

47
00:04:44,960 --> 00:04:47,010
تعاطف؟

48
00:04:47,550 --> 00:04:48,510
.نعم

49
00:04:49,380 --> 00:04:52,550
الغرباء الذين يجمعهم الدرب تحت سقف واحد

50
00:04:53,010 --> 00:04:57,810
.يتعلّمون الضحك والبكاء سويًا على نفس الأمور

51
00:04:58,810 --> 00:05:02,350
.تلك العملية هي جوهر البهجة الحقيقي

52
00:05:03,610 --> 00:05:05,480
.وأنتم سلبتموها

53
00:05:05,860 --> 00:05:08,490
.عليك تجربة الشعور بالبهجة بنفسك

54
00:05:08,780 --> 00:05:11,320
.مثل البهجة التي تشعر بها أثناء ابتسام الأطفال لك

55
00:05:13,700 --> 00:05:15,330
أهذا أمر؟

56
00:05:18,200 --> 00:05:20,080
.نعم، إنّه أمر

57
00:05:33,470 --> 00:05:35,300
!ليز-سان! تماسكي

58
00:05:37,560 --> 00:05:38,560
...ماسارو-سان

59
00:05:38,850 --> 00:05:40,810
نعم، هل أنتِ بخير؟

60
00:05:42,940 --> 00:05:44,560
أين غوري-بون-سان؟

61
00:05:44,730 --> 00:05:47,190
.لا أعلم، حدث هذا فجأةً قبل قليل

62
00:06:00,250 --> 00:06:01,540
.تذكرت

63
00:06:03,250 --> 00:06:03,580
ماذا هناك؟

64
00:06:11,130 --> 00:06:12,340
ما هذا المكان؟

65
00:06:12,920 --> 00:06:16,600
.جبل القدّيس ميشيل، دير قديم في فرنسا

66
00:06:17,470 --> 00:06:19,850
...هذه أنتِ يا آنسة

67
00:06:21,100 --> 00:06:22,350
!أنت

68
00:06:22,520 --> 00:06:25,190
.دكتور لاو، مروّض الحيوانات المتوحّشة

69
00:06:25,350 --> 00:06:27,940
.أتشرّف بلقائك مجددًا

70
00:06:29,230 --> 00:06:30,230
...حيوانات متوحّشة

71
00:06:31,110 --> 00:06:34,320
ما هذه؟ أهي أوتوماتا؟

72
00:06:34,490 --> 00:06:38,870
.نعم، لقد شربت دماء بشريّة ويحرّكها دماغ حيوانيّ

73
00:06:39,660 --> 00:06:43,580
.صنعتها بناءً على تجارب أجريت على دماغ بيست

74
00:06:43,750 --> 00:06:46,880
.إنّها صغاري الذكيّة

75
00:06:47,460 --> 00:06:48,630
هل هو بيست نفسه؟

76
00:06:48,840 --> 00:06:51,880
.نعم، النمر الذي قتل أختي

77
00:06:52,210 --> 00:06:56,720
.ماسارو-كن، تنص أوامري على القبض عليك حيًا

78
00:06:56,890 --> 00:06:58,930
.أرجو أن تستسلم

79
00:06:59,100 --> 00:06:59,970
!محال

80
00:07:00,470 --> 00:07:02,310
.اذهب يا ماسارو-سان

81
00:07:03,100 --> 00:07:03,640
...لكن

82
00:07:03,810 --> 00:07:06,980
.أرجوك، هذه معركتي وعليّ حسمها

83
00:07:09,690 --> 00:07:11,480
!فهمت، أعتمد عليكِ

84
00:07:11,650 --> 00:07:12,980
.لا فائدة من الهرب

85
00:07:15,030 --> 00:07:19,700
.لا يهم، رفاقي سيقبضون عليه

86
00:07:19,870 --> 00:07:23,370
.أمّا أنتِ سأطعمك لصغاري

87
00:07:30,000 --> 00:07:34,130
.يمكنني فتح هذا الباب باستخدام قدرة تفكيك فايسلس التي تم تنزيلها عليّ

88
00:07:53,860 --> 00:07:58,280
تناول الخنزير الصغير وجبة خفيفة

89
00:07:58,450 --> 00:08:01,740
وأصبح بلا أي شيء

90
00:08:02,780 --> 00:08:07,500
وبكى هذا الخنزير الصغير

91
00:08:08,330 --> 00:08:10,250
على طول طريق عودته

92
00:08:13,710 --> 00:08:16,260
.سمعت كل شيء عنك

93
00:08:16,420 --> 00:08:20,390
.أنت صغير وظريف كرضيع سمين

94
00:08:21,890 --> 00:08:25,060
.أنا الأوتوماتا كولومبين

95
00:08:25,220 --> 00:08:26,520
أليس اسمًا ظريفًا؟

96
00:08:26,890 --> 00:08:29,520
كولومبين؟ من الروّاد الأربعة؟

97
00:08:29,690 --> 00:08:30,770
.صحيح

98
00:08:30,940 --> 00:08:34,520
.هزمني الشيروغاني في الصحراء الكبرى

99
00:08:34,690 --> 00:08:38,030
.لكن فايسلس-ساما أصلحني ومنحني هذا الشكل

100
00:08:41,530 --> 00:08:46,370
.يمكنني جمع حشرات الزوناها الموجودة في الهواء وتشكيلها

101
00:08:46,620 --> 00:08:49,620
.لن أؤذيك إن أطعتني

102
00:08:50,790 --> 00:08:53,840
.أخبرني على أي حال

103
00:08:54,090 --> 00:08:57,550
ما الفائدة التي ستعود عليك من إنقاذها؟

104
00:08:57,710 --> 00:09:00,550
.الفائدة؟ لم أفكّر أبدًا في هذا الموضوع

105
00:09:06,100 --> 00:09:07,850
.يا آنسة

106
00:09:08,640 --> 00:09:11,140
قبّلي قدمي

107
00:09:11,310 --> 00:09:13,980
.وستموتين بسهولة دون ألم

108
00:09:14,310 --> 00:09:16,730
!لن أخسر أمامك أبدًا

109
00:09:18,360 --> 00:09:19,740
.خلفها

110
00:09:22,450 --> 00:09:24,070
.إلى السؤال التّالي

111
00:09:24,620 --> 00:09:26,620
لِمَ يعيش البشر في مجموعات؟

112
00:09:28,410 --> 00:09:30,160
.لأننا ضعفاء

113
00:09:30,870 --> 00:09:33,960
.نموت إن لم نساعد بعضنا

114
00:09:34,580 --> 00:09:35,880
.هذا هو السبب

115
00:09:38,090 --> 00:09:42,550
.الأوتوماتا قوية وبالتالي تتحرك بمفردها

116
00:09:43,010 --> 00:09:45,720
.لا سبب يدفعنا لتكوين جماعات

117
00:09:47,350 --> 00:09:49,890
لكن ألستِ وحيدة؟

118
00:09:50,730 --> 00:09:54,730
.وحيدة؟ وحدهم البشر من يشعرون بالوحدة

119
00:09:55,940 --> 00:09:58,070
.توجد من أريد حمايتها

120
00:09:58,230 --> 00:10:02,150
.لهذا بمقدوري أن أغدو أقوى وأن أتغيّر لأصبح أفضل

121
00:10:03,070 --> 00:10:04,660
أيمكنكِ التغيّر؟

122
00:10:04,950 --> 00:10:07,910
أيمكن لأوتوماتا وحيدة مثلك أن يتحسّن حالها؟

123
00:10:08,330 --> 00:10:12,910
.اصمت، حتّى وإن تحسّن حالكم، تظلّون ضعفاء وتخسرون

124
00:10:13,460 --> 00:10:14,920
.هذه حقيقة

125
00:10:16,840 --> 00:10:19,670
.لم يُخلق البشر ليخسروا باستمرار

126
00:10:22,380 --> 00:10:24,720
ما زال البشر أحياء إلى يومنا هذا

127
00:10:25,090 --> 00:10:29,310
.لأننا نورث ما صنعناه للجيل التّالي

128
00:10:29,470 --> 00:10:33,100
.وكل جيل يحاول التحسين من حالنا

129
00:10:34,560 --> 00:10:38,610
.على الرغم من مرورنا بتاريخ مريع إلّا أننا ما زلنا أحياء

130
00:10:39,520 --> 00:10:43,440
.هذا لأننا جميعًا نحاول حل الأمور

131
00:10:44,700 --> 00:10:47,120
من أجل الجيل التالي

132
00:10:47,820 --> 00:10:51,700
من أجل الذين يتظافرون سويًا

133
00:10:52,080 --> 00:10:54,790
.نريد تحسين الوضع من أجلهم

134
00:10:56,080 --> 00:11:00,670
لهذا طالما نتظافر سويًا بغض النظر عن عددنا

135
00:11:00,840 --> 00:11:02,840
!لن يخسر البشر أمامكم أبدًا

136
00:11:03,550 --> 00:11:07,510
.صحيح، لكن البشر فقط من يتظافرون سويًا

137
00:11:07,720 --> 00:11:12,060
أيمكن ليَدِي الصغيرة الظريفة الآلية أن تتظافر معكم؟

138
00:11:15,640 --> 00:11:20,060
.تظافرت دمية مع البشر فيما مضى

139
00:11:21,570 --> 00:11:26,070
.أصبحت إنسانة في النّهاية قبل أن تختفي

140
00:11:26,740 --> 00:11:29,070
.لم أسمع عن هراء كهذا من قبل

141
00:11:29,370 --> 00:11:30,580
.أنت كاذب

142
00:11:32,040 --> 00:11:33,120
.إنّها الحقيقة

143
00:11:39,210 --> 00:11:41,040
.آخر سؤال

144
00:11:41,920 --> 00:11:45,090
هل تحبّها؟

145
00:11:46,220 --> 00:11:49,680
أنت تحبّها! لهذا السبب جئت إلى هنا من أجلها؟

146
00:11:49,840 --> 00:11:52,930
.قلت قبل قليل بأن هناك من تريد حمايتها

147
00:11:53,100 --> 00:11:54,970
.هيّا اعترف يا ماسارو-تشان

148
00:11:55,350 --> 00:12:00,520
!لا أعلم، لكن سأنقذها

149
00:12:04,900 --> 00:12:06,530
لِمَ لا تحاول إذن؟

150
00:12:07,150 --> 00:12:07,800
أهذا فخ؟

151
00:12:08,030 --> 00:12:09,280
.كلّا

152
00:12:09,450 --> 00:12:13,280
.أشعر بالفضول إزاء ما إذا كنت ستتمكن من إنقاذ  من تحب

153
00:12:13,450 --> 00:12:17,040
ألن يكون هذا مشهدًا رومانسيًا؟

154
00:12:17,330 --> 00:12:21,130
،ليس عليك فعل هذا إن شئت
.أنا أفعل هذا بناءً على نزوة وحسب

155
00:12:21,290 --> 00:12:22,250
.سأذهب

156
00:12:22,750 --> 00:12:24,250
...تفضّل

157
00:12:29,800 --> 00:12:31,390
...تفضّل

158
00:12:35,520 --> 00:12:38,690
.جئت لرؤية ما ستفعله هذه الخردة

159
00:12:38,850 --> 00:12:40,230
.يا للخيبة

160
00:12:40,520 --> 00:12:41,480
من أنتِ؟

161
00:12:41,810 --> 00:12:43,770
.أنا نايا ستيل

162
00:12:44,610 --> 00:12:48,700
.أنا قائدة آليّو الأو التي تحرس جبل القديس ميشيل

163
00:12:48,860 --> 00:12:49,760
آليّو الأو؟

164
00:12:49,860 --> 00:12:50,660
.نعم

165
00:12:50,820 --> 00:12:53,990
.المختارون من بين الشيروغاني أو

166
00:12:54,280 --> 00:12:57,080
.منحنا فايسلس-ساما أحدث الأجساد

167
00:12:57,250 --> 00:13:01,290
.تم تنزيل شخصيّاتنا البشرية عليها

168
00:13:01,580 --> 00:13:06,050
.نحن كائنات ميكانيكية تتفوق على البشر

169
00:13:08,300 --> 00:13:13,300
تسمحين لغلام بالمرور عبر معقلنا؟

170
00:13:13,760 --> 00:13:16,970
!إلى الجحيم أيّتها الخردة العتيقة

171
00:13:22,480 --> 00:13:23,730
.هذا يكفي

172
00:13:24,810 --> 00:13:29,110
،بالنسبة ليّ، أنتم جميعًا مثل بعضكم
.يا له من شجار دمى سخيف

173
00:13:30,490 --> 00:13:31,740
ماذا قلت؟

174
00:13:32,110 --> 00:13:37,910
.عجبًا، ماسارو-تشان يُمسك بيّ

175
00:13:38,910 --> 00:13:41,370
.لم أقصد هذا، أنتِ من رُميتِ نحوي

176
00:13:41,540 --> 00:13:44,500
.لن أسامحكِ أبدًا على نشر الزوناها

177
00:13:44,830 --> 00:13:46,880
.سأهزم كل الأوتوماتا والأو

178
00:13:47,340 --> 00:13:49,210
.لا يروق ليّ ما أسمعه

179
00:13:49,380 --> 00:13:51,920
.لا تشبّهنا بهذه الخردة

180
00:13:52,090 --> 00:13:56,010
.يجب ألّا نحطّم جسد فايسلس المستقبليّ

181
00:13:56,180 --> 00:14:00,480
.لكن لا بأس في شعورك ببعض الألم الجسديّ

182
00:14:01,640 --> 00:14:03,600
.ستتألم كثيرًا

183
00:14:03,770 --> 00:14:06,440
.سنتجاوز هذه المسألة إن بكيت ورجوتنا

184
00:14:06,610 --> 00:14:07,770
.الألم لا يدوم

185
00:14:08,440 --> 00:14:13,950
.لكن إن بكى الرجل، لا يمكن أن تعود دموعه

186
00:14:14,110 --> 00:14:18,990
.مسلّي، إذن اغرق في بحر من دموعك

187
00:14:25,250 --> 00:14:28,340
قلتِ ألم جسديّ؟

188
00:14:28,500 --> 00:14:32,630
.لكنكم رميتم بأجسادكم ونسيتم معنى الألم

189
00:14:33,220 --> 00:14:37,550
ما رأيكم بأن أذكّركم بماهية الشعور بالألم؟

190
00:14:38,180 --> 00:14:39,430
تقفين ضدّنا؟

191
00:14:39,600 --> 00:14:42,390
.أنت دمية فايسلس-ساما الوفيّة

192
00:14:42,430 --> 00:14:43,230
!أيّتها الخائنة

193
00:14:43,640 --> 00:14:49,110
.ما بيدي حيلة، أنقذني ماسارو-تشان من السقوط

194
00:14:54,990 --> 00:15:00,990
.حلم حياتي أن يمد فتى بشريّ يده إليه

195
00:15:01,870 --> 00:15:05,500
.لهذا سأساعدك يا ماسارو-تشان

196
00:15:28,860 --> 00:15:30,650
أنتِ بشرية؟

197
00:15:31,480 --> 00:15:32,570
...أوتوماتا

198
00:15:39,030 --> 00:15:40,200
.بشريّة

199
00:15:41,990 --> 00:15:45,080
ماذا سيحدث إن لم أفعل شيئًا؟

200
00:16:04,470 --> 00:16:06,850
لماذا؟

201
00:16:07,270 --> 00:16:11,980
.أمرتنا فرانسين-ساما بعدم إيذاء البشر

202
00:16:14,230 --> 00:16:15,610
.لهذا أنقذتك

203
00:16:16,280 --> 00:16:17,400
.هذا كل شيء

204
00:16:21,120 --> 00:16:24,120
.عجبًا، انظر إلى أين وصلنا

205
00:16:24,410 --> 00:16:24,910
!ها هما

206
00:16:25,500 --> 00:16:26,830
!من هنا

207
00:16:27,620 --> 00:16:31,420
.ماسارو-تشان، أمسك يدي إن أردت أن تُنقذ

208
00:16:38,130 --> 00:16:39,630
!سحقًا

209
00:16:41,760 --> 00:16:43,850
!جسد فايسلس-ساما التّالي

210
00:16:44,010 --> 00:16:46,390
...وفوق هذا، إن هذه الحفرة

211
00:16:56,570 --> 00:16:58,780
.مظلّة لكلينا

212
00:16:59,900 --> 00:17:03,070
.ماسارو بخير، جيّد لن نُقتل

213
00:17:03,280 --> 00:17:07,540
يا غبيّ! ألا تدرك إلى أين تقود الحفرة؟

214
00:17:08,410 --> 00:17:09,710
!خلفهما

215
00:17:12,580 --> 00:17:13,710
.اذهبي

216
00:17:15,920 --> 00:17:18,840
.موتي حيث لا أراك

217
00:17:19,840 --> 00:17:21,880
.ابتعدي بسرعة عن مرمى بصري

218
00:17:30,390 --> 00:17:31,390
...المعذرة

219
00:17:32,060 --> 00:17:34,060
أيمكنني سؤالك عن اسمك؟

220
00:17:34,980 --> 00:17:36,320
.أرلوكين

221
00:17:37,070 --> 00:17:38,570
.أرلوكين-سان

222
00:17:39,030 --> 00:17:42,070
.أشكرك على إنقاذي

223
00:17:50,160 --> 00:17:53,330
هل ابتسمتِ؟

224
00:17:54,460 --> 00:17:55,420
.نعم

225
00:17:55,880 --> 00:17:56,920
ابتسمتِ ليّ؟

226
00:17:57,170 --> 00:17:57,670
.نعم

227
00:17:58,750 --> 00:18:02,130
هل أخطأت في شيء؟

228
00:18:03,470 --> 00:18:06,470
.يا له من شعور غريب

229
00:18:08,220 --> 00:18:14,100
.لم يسبق وأن شكرني أو ابتسم ليّ بشر من قبل

230
00:18:14,600 --> 00:18:16,480
.يا له من شعور غريب

231
00:18:21,030 --> 00:18:22,320
.اذهبي الآن

232
00:18:29,570 --> 00:18:32,160
.كان هذا مسليًا

233
00:18:32,410 --> 00:18:34,370
هل أنت بخير يا ماسارو-تشان؟

234
00:18:35,040 --> 00:18:36,000
.نعم

235
00:18:36,250 --> 00:18:38,000
.من هنا وتوخّ الحذر

236
00:18:40,380 --> 00:18:43,630
لماذا أنقذتني؟

237
00:18:43,800 --> 00:18:45,010
.أخبرتك بالفعل

238
00:18:46,140 --> 00:18:49,310
.لأنني أمسكت بك؟ كفى هراء

239
00:18:50,720 --> 00:18:54,390
ذهب الخنزير الصغير للسّوق

240
00:18:54,940 --> 00:18:58,730
ظل الخنزير الصغير في بيته

241
00:18:58,900 --> 00:19:00,320
!يا كولومبين

242
00:19:00,480 --> 00:19:03,440
تناول الخنزير الصغير وجبة

243
00:19:03,610 --> 00:19:07,160
وأصبح الخنزير بلا أي شيء

244
00:19:07,990 --> 00:19:11,450
."أحب عبارة "بلا أي شيء

245
00:19:15,410 --> 00:19:18,000
.صنعني فايسلس-ساما

246
00:19:18,170 --> 00:19:21,340
.منحتني فرانسين-ساما الإرادة

247
00:19:21,630 --> 00:19:24,470
.كل هذا لأتمكن من رسم البسمة على وجه فرانسين-ساما

248
00:19:25,050 --> 00:19:27,510
.أعلم هذا

249
00:19:28,430 --> 00:19:30,260
.هذا كل شيء

250
00:19:30,550 --> 00:19:32,890
.لا يوجد أي شيء آخر أريد فعله

251
00:19:33,270 --> 00:19:35,640
".أنا "بلا أي شيء

252
00:19:39,230 --> 00:19:40,520
...لكن بأحد الأيام

253
00:19:41,190 --> 00:19:44,940
.ذهبت إلى مكتبة للبشر لإرضاء نزواتي

254
00:19:47,950 --> 00:19:50,990
.وأخذت كتابًا عشوائيًا

255
00:19:51,620 --> 00:19:55,540
.كُتِب فيه عن الحب بين الرجل والمرأة البشريان

256
00:19:57,830 --> 00:19:59,670
.لم أفهمه

257
00:20:00,560 --> 00:20:08,320
ذهب مع الرّيح

258
00:20:01,420 --> 00:20:05,050
لكن الأسلوب الذي صوِّر به عناق الرجل والمرأة

259
00:20:05,300 --> 00:20:07,430
.جعلني أنجذب إليه

260
00:20:08,630 --> 00:20:12,970
.بعدها أصبحت أقرأ قصص البشر العاطفية

261
00:20:14,390 --> 00:20:17,980
.أحببت تخيّل شعور أن يُمسك أحد بيّ

262
00:20:18,770 --> 00:20:22,360
.أصبح هذا مصدر تسليتي الوحيد

263
00:20:23,650 --> 00:20:27,150
.وأنت حققته

264
00:20:27,700 --> 00:20:29,240
.لهذا أنقذتك

265
00:20:30,660 --> 00:20:34,740
.وفوق هذا أمرتني فرانسين-ساما بألّا أؤذي البشر مجددًا

266
00:20:34,910 --> 00:20:37,790
فرانسين؟ تقصدين شيروغاني؟

267
00:20:38,250 --> 00:20:42,540
.تريد أن تأتي على ذكر سيرتها مجددًا؟ هذا صحيح

268
00:20:42,790 --> 00:20:44,630
أين هي؟

269
00:20:44,800 --> 00:20:49,050
.رأيت؟ علمت أنك تحبّها

270
00:20:49,220 --> 00:20:53,470
.إنّها من تريد احتضانها فعلاً

271
00:20:53,640 --> 00:20:56,310
.اصمتِ! لستُ مراهقًا حتّى

272
00:20:56,470 --> 00:20:59,060
.لا أكنّ مشاعر كهذه لشيروغاني

273
00:21:03,770 --> 00:21:05,900
.وصلنا

274
00:21:06,280 --> 00:21:07,740
ماذا يوجد هناك؟

275
00:21:09,200 --> 00:21:13,950
.طريق مختصر نحو غايتك

276
00:21:25,250 --> 00:21:28,090
.يتم الاحتفاظ بأجساد الأو هنا

277
00:21:28,960 --> 00:21:32,550
.أجسادهم الأصليّة

278
00:21:44,100 --> 00:21:47,570
.بدأ الوضع يصبح مسليًا

279
00:21:50,990 --> 00:21:53,570
.سيمنعهم هذا من الدخول حاليًا

280
00:22:02,080 --> 00:22:03,290
.أخي نارومي

281
00:22:03,750 --> 00:22:09,050
.نحن الآن على وشك أن نشهد الظلمة خلف الدّمى