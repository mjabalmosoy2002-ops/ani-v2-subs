1
00:00:01,090 --> 00:00:03,100
.ولدتُ محرّكة دمى

2
00:00:02,830 --> 00:00:07,830
CH: yume chan

3
00:00:03,510 --> 00:00:05,560
.دمية بمهمة فطرية

4
00:00:06,560 --> 00:00:09,270
.تلك هي شيروغاني، تلك هي أنا

5
00:00:09,690 --> 00:00:12,900
.يكفي هراءً، اسمعي يا شيروغاني

6
00:00:13,360 --> 00:00:15,570
.أنتِ لستِ دمية

7
00:00:17,150 --> 00:00:19,400
!كلّا، لا تكن غبيًا، ستموت

8
00:00:19,990 --> 00:00:24,280
.سأقتل نفسي الضّعيفة البكّاءة

9
00:00:25,410 --> 00:00:28,330
...إن نجوت

10
00:00:29,040 --> 00:00:32,880
.إن نجوت، سأضحك طوال الوقت

11
00:00:34,670 --> 00:00:36,960
.كأنّه شخص مختلف تمامًا

12
00:00:37,710 --> 00:00:40,930
هذه النظرة، نظرة وحش

13
00:00:43,180 --> 00:00:44,890
.متعطّش للحياة

14
00:02:19,070 --> 00:02:21,360
،هيّا يا سيّد، قف بصفّي

15
00:02:22,070 --> 00:02:24,320
،أبي ترك ليّ ثروته

16
00:02:26,070 --> 00:02:27,950
.لذا سأدفع بقدر ما تشاء

17
00:02:28,450 --> 00:02:32,750
.جاء هذا الولد من السّماء

18
00:02:33,210 --> 00:02:37,170
.والآن يتفاوض مع القاتل المأجور الذي أُرسل لقتله

19
00:02:38,130 --> 00:02:40,420
.يا لعزمه

20
00:02:41,090 --> 00:02:46,510
أنا محرك دمى شهير من كوروغا، أتأثّر بهذا الصبيّ الصغير؟

21
00:02:48,140 --> 00:02:50,810
لحظة، هل قفزت من هناك؟

22
00:02:50,970 --> 00:02:54,390
.نعم، كان عليّ الهرب من عمّي زينجي

23
00:02:57,230 --> 00:02:58,560
.غير معقول

24
00:02:59,400 --> 00:03:03,570
.ولقد أنقذت حياتي أيضًا حتّى ولو كان هذا مصادفةً

25
00:03:04,950 --> 00:03:09,530
.لكننا نتّبع قواعد سلوكيّة

26
00:03:09,700 --> 00:03:14,370
.بغض النظر عن ما ستدفعه لنا، لا يمكننا خيانة عملائنا

27
00:03:15,370 --> 00:03:17,080
.اقرأ هذه إذن

28
00:03:18,500 --> 00:03:23,340
ماذا؟ نحن الكوروغا كنّا محض
فئران تجارب لصنع دمى أقوى؟

29
00:03:23,510 --> 00:03:27,430
،وبما أنّهم لم يعودوا بحاجتنا
سنقوم بالقضاء على بعضنا البعض؟

30
00:03:34,680 --> 00:03:35,810
حسنًا؟

31
00:03:37,440 --> 00:03:39,770
كم ستدفع؟

32
00:03:42,690 --> 00:03:44,150
كيف حال إصابتك؟

33
00:03:44,320 --> 00:03:47,400
.لا تُذكر، أنا قلق على ماسارو أكثر

34
00:03:47,860 --> 00:03:50,320
.يوجد مخرج في مكان ما حتمًا

35
00:03:50,870 --> 00:03:52,620
.يجب أن نجد سيّدي بسرعة

36
00:03:54,790 --> 00:03:57,540
.إيّاك وظن النصر من نصيبكم

37
00:03:58,120 --> 00:04:00,080
.ستسقطون معنا

38
00:04:00,920 --> 00:04:03,880
.ليس بوسع أحد إيقاف هذا الآن

39
00:04:05,630 --> 00:04:07,220
.ساعة واحدة فقط

40
00:04:08,130 --> 00:04:10,640
.ستموتون جميعًا

41
00:04:17,730 --> 00:04:21,480
.سحقًا لماسارو، مات بطريقة مؤسفة

42
00:04:21,940 --> 00:04:26,940
.إن أصبح ابني، لأظفر بتلك الثروة

43
00:04:30,700 --> 00:04:33,830
نعم، وجدتم جثّة ماسارو؟

44
00:04:33,990 --> 00:04:36,330
...في الحقيقة، إنّه

45
00:04:36,500 --> 00:04:37,790
حيّ؟

46
00:04:37,950 --> 00:04:41,750
.أخذ دمية غريميلدي من فريق الاختطاف  وهو في طريقه إليك

47
00:04:48,380 --> 00:04:50,930
!ماسارو! و... فريق الاغتيال؟

48
00:04:51,510 --> 00:04:55,640
.نأسف عن المقاطعة، لكن الولد يريد التكلّم معك

49
00:04:56,060 --> 00:04:59,560
.أرجوك يا عمّي، أوقف هذا رجاءً

50
00:05:00,140 --> 00:05:02,650
.أريد مساعدة شيروغاني وأخي نارومي

51
00:05:08,400 --> 00:05:10,700
.يبدو أن الحظ ما يزال يصب بصالحي

52
00:05:11,320 --> 00:05:12,950
!شيروغاني! أخي نارومي

53
00:05:13,450 --> 00:05:15,700
.سحقًا، لم ننتبه إليه

54
00:05:17,580 --> 00:05:19,500
.انتظر يا ياماناكا، لا تقتلهما

55
00:05:20,410 --> 00:05:26,040
لقد سببتَ جلبة كبيرة يا ماسارو
.لكن أنا مسرور جدًا لأنك حيّ

56
00:05:27,170 --> 00:05:29,970
تعرف ما أريد، صحيح؟

57
00:05:33,510 --> 00:05:35,100
.تريد أن تتبنّاني

58
00:05:36,140 --> 00:05:39,810
.بالضبط، كل ما عليك هو الموافقة

59
00:05:43,980 --> 00:05:46,190
.ياماناكا، اعصرهما قليلاً

60
00:05:50,400 --> 00:05:51,860
تسمعون؟ جميل، صحيح؟

61
00:05:52,030 --> 00:05:54,280
!توقّف، توقّف

62
00:05:54,990 --> 00:05:56,160
.ماسارو

63
00:05:56,370 --> 00:05:58,490
.إنّه يشاهدنا

64
00:06:01,870 --> 00:06:05,130
.يا له من شعور، إنّه يدغدغني

65
00:06:07,540 --> 00:06:10,920
!فعلاً، لا تقلق علينا يا سيّدي

66
00:06:11,300 --> 00:06:14,630
.صحيح يا ماسارو، لا تنصت لهذا القرد

67
00:06:14,800 --> 00:06:15,840
!اصمتا

68
00:06:21,020 --> 00:06:23,810
.يمكنني قتلهما بسهولة

69
00:06:23,980 --> 00:06:26,310
ماذا ستفعل يا ماسارو؟

70
00:06:30,610 --> 00:06:35,320
.أنا... سأصبح ابنك

71
00:06:36,620 --> 00:06:40,620
.ولد صالح! من الآن فصاعدًا، أنا والدك

72
00:06:40,950 --> 00:06:42,910
!لكن عليك تركهما

73
00:06:43,080 --> 00:06:47,130
.بالطبع، أفعل أي شيء لابني الحبيب

74
00:06:47,290 --> 00:06:51,300
.لنذهب إلى الباغودا، ستقابلهما هناك

75
00:06:56,430 --> 00:06:58,390
.هيّا بنا يا ماسارو

76
00:06:59,800 --> 00:07:01,470
.لحظة يا ولد

77
00:07:02,020 --> 00:07:04,640
.إنّه يخدعك

78
00:07:06,310 --> 00:07:07,900
.فكّر جيّدًا

79
00:07:08,270 --> 00:07:10,940
.إنّهما على علم بكل شيء جرى هنا

80
00:07:11,110 --> 00:07:13,780
أتظنّه سيتركهما في حال سبيلهما؟

81
00:07:18,200 --> 00:07:21,700
أيقول الحقيقة يا عمّي؟

82
00:07:23,660 --> 00:07:24,870
.نعم

83
00:07:25,040 --> 00:07:30,380
.سأرميهما من أعلى الباغودا

84
00:07:35,510 --> 00:07:37,930
.أنت رجل مريع

85
00:07:39,510 --> 00:07:43,810
وهل بيدك حيلة يا ماسارو؟

86
00:07:48,480 --> 00:07:50,560
.شيروغاني وأخي نارومي

87
00:07:52,770 --> 00:07:53,860
...أنت

88
00:07:57,030 --> 00:07:58,990
!أحمق

89
00:08:04,740 --> 00:08:06,790
!رجلي

90
00:08:05,300 --> 00:08:06,790
...عجبًا

91
00:08:07,620 --> 00:08:08,960
!هيّا يا ولد

92
00:08:09,120 --> 00:08:10,420
...أعرف، لكن

93
00:08:11,460 --> 00:08:16,170
.لن نصل في الوقت المناسب بسبب بُنية هذا القصر

94
00:08:16,800 --> 00:08:18,300
ماذا سنفعل إذًا؟

95
00:08:19,800 --> 00:08:21,760
!لا يمكنني تعطيلها

96
00:08:22,970 --> 00:08:25,560
!ستفجّر المكان بأسره

97
00:08:29,690 --> 00:08:33,060
.توقّف، لا بدّ من أننا عند قمة الباغودا

98
00:08:33,650 --> 00:08:35,820
ما الذي يخططون له؟

99
00:08:37,610 --> 00:08:39,200
ما الخطب يا شيروغاني؟

100
00:08:40,860 --> 00:08:43,780
...عندما كنت طفلة

101
00:08:44,580 --> 00:08:47,200
.كنتُ أُحتجز في غرفة كهذه

102
00:08:48,960 --> 00:08:50,210
.تذكّرتُ هذا الآن

103
00:08:54,880 --> 00:08:56,960
...خارج نافذتها

104
00:09:00,760 --> 00:09:02,550
.توجد يدان تحرّك دمية

105
00:09:09,270 --> 00:09:10,480
.خائفة

106
00:09:11,600 --> 00:09:14,480
...أراها... أرى تلك النافذة

107
00:09:15,820 --> 00:09:18,570
.تلك اليدان تتحكّمان بيّ

108
00:09:22,530 --> 00:09:24,070
.ابتسمي يا شيروغاني

109
00:09:28,540 --> 00:09:33,250
.لا يمكن للأشياء المخيفة، أن تتغلّب على ابتسامة

110
00:09:36,250 --> 00:09:40,720
.منذ زمن، أخبرني رجل بما قلته ليّ الآن

111
00:09:45,550 --> 00:09:47,220
.ابتسمي يا شيروغاني

112
00:09:48,560 --> 00:09:51,730
.يا لكِ من دمية مسكينة، نسيت كيف تبتسم

113
00:09:52,980 --> 00:09:55,860
.لكنّك ستبتسمين يومًا ما

114
00:09:56,690 --> 00:09:58,440
.ثقي بكلامي

115
00:09:59,320 --> 00:10:01,030
.كان اسمه سايغا شوجي

116
00:10:01,860 --> 00:10:03,820
.جد سيّدي ماسارو

117
00:10:05,280 --> 00:10:08,740
.شيروغاني، احمي ماسارو

118
00:10:09,740 --> 00:10:15,420
،احميه، ولا تعيشي كدمية بعد الآن

119
00:10:16,710 --> 00:10:18,420
.ستبتسمين مجددًا

120
00:10:21,210 --> 00:10:24,260
.لهذا تعتنين بماسارو

121
00:10:25,090 --> 00:10:27,050
.ذراعك غريبة

122
00:10:27,220 --> 00:10:29,180
...آسف، لم أقصد

123
00:10:29,700 --> 00:10:30,310
.لا بأس

124
00:10:31,770 --> 00:10:33,940
...وصفتها بالغريبة لأن

125
00:10:34,520 --> 00:10:38,190
.كلمات جدّي كانت أدفء ما شعرت به

126
00:10:39,610 --> 00:10:44,450
.لكن أشعر بدفء أكبر بذراعك

127
00:10:47,820 --> 00:10:51,580
مستحيل، تريد القفز من هنا نحو الباغودا؟

128
00:10:52,160 --> 00:10:57,670
نظرًا لمحيط المكان، سرعة غريميلدي ستفي بالغرض

129
00:10:59,290 --> 00:11:04,470
هل حلّل المسافة والسرعة في وضع كهذا؟

130
00:11:04,630 --> 00:11:09,640
.بالإضافة إلى ثقتي بك

131
00:11:12,680 --> 00:11:17,400
.حسنًا، طالما تدفع ليّ

132
00:11:24,820 --> 00:11:26,280
.نحن ننزلق

133
00:11:26,450 --> 00:11:29,280
!أعطني عنق غريميلدي! بسرعة

134
00:11:35,660 --> 00:11:37,710
كيف تعلمت فعل هذا؟

135
00:11:37,870 --> 00:11:39,710
.راقبتك يا أشيهانا-سان

136
00:11:46,470 --> 00:11:47,970
!أخي نارومي، شيروغاني

137
00:11:48,760 --> 00:11:49,300
!ماسارو

138
00:11:49,560 --> 00:11:50,090
!سيّدي

139
00:11:50,680 --> 00:11:52,760
.آسف، هذا خطئي

140
00:11:53,220 --> 00:11:56,430
.لا تقل هذا! انظر لنفسك، حالتك مزرية

141
00:11:57,140 --> 00:11:59,480
!سيّدي

142
00:12:01,650 --> 00:12:04,730
!أشيهانا يا وغد، ابتعد عنه يا ماسارو

143
00:12:04,900 --> 00:12:07,780
.لا بأس، لقد وظّفته

144
00:12:08,360 --> 00:12:09,820
.إنّه بصفّنا الآن

145
00:12:09,990 --> 00:12:11,120
.إنّه محق

146
00:12:12,080 --> 00:12:14,740
.لكن لم يعد بوسعي الحركة

147
00:12:14,910 --> 00:12:18,370
.يبدو أنّي لن أقدر على فعل أي شيء آخر

148
00:12:19,370 --> 00:12:20,630
.آسف

149
00:12:23,000 --> 00:12:25,800
!من توقّع أن تحلّقا بغريميلدي إلى هنا

150
00:12:25,960 --> 00:12:28,130
.لكن هذه هي النهاية

151
00:12:28,300 --> 00:12:31,720
.لا! أخي نارومي وشيروغاني تكبّدا كل هذا العناء لأجلي

152
00:12:32,140 --> 00:12:34,060
!الآن دوري لإنقاذهما

153
00:12:34,720 --> 00:12:36,390
.أنت شجاع

154
00:12:36,770 --> 00:12:42,520
لكن هل ستظل على نفس الشجاعة عندما أقطع ذراعك؟

155
00:12:42,690 --> 00:12:45,570
!توقّف! خذ ذراعي

156
00:12:46,400 --> 00:12:47,600
.سآخذ كلاهما

157
00:12:47,610 --> 00:12:48,700
!انتظر

158
00:12:53,620 --> 00:12:54,660
...لا يمكن

159
00:12:56,580 --> 00:12:58,870
.اشتدّ عودك يا ماسارو

160
00:12:59,460 --> 00:13:03,170
.لكن كفّيت ووفّيت

161
00:13:03,630 --> 00:13:05,170
.سنتولّى هذا الآن

162
00:13:05,880 --> 00:13:11,090
.سنتولى أنا وشيروغاني الباقي

163
00:13:13,470 --> 00:13:17,140
.قوّته ازدادت بسبب الدعم الروحيّ

164
00:13:17,390 --> 00:13:20,060
.اسمه تشيقونغ، تذكّر هذا

165
00:13:24,400 --> 00:13:27,360
.تغطّيك الكدمات يا سيّدي

166
00:13:27,530 --> 00:13:31,320
.أنا بخير، تسرّني رؤيتكما

167
00:13:35,070 --> 00:13:40,500
.بالغون يتنمّرون على طفل

168
00:13:40,660 --> 00:13:42,580
!يا لكم من حمقى

169
00:13:45,210 --> 00:13:48,840
.لا بأس بالنسبة لهاو

170
00:13:49,550 --> 00:13:51,550
.أنت من اختطف ماسارو

171
00:13:51,720 --> 00:13:54,300
صحيح، تذكر إذن؟

172
00:13:58,010 --> 00:13:59,770
وماذا في ذلك؟

173
00:14:06,810 --> 00:14:09,980
.أخي نارومي قوي جدًا

174
00:14:10,150 --> 00:14:12,530
نعم، اشتعل غضبًا

175
00:14:13,650 --> 00:14:15,530
.بسبب الجروح التي تغطّيك

176
00:14:16,950 --> 00:14:19,290
.يكره الذين يقتلون عبثًا

177
00:14:19,990 --> 00:14:26,170
.على الأرجح أخي نارومي يقاتل دومًا في سبيل شخص ما

178
00:14:26,580 --> 00:14:29,210
.ما زلت لا أفهمه

179
00:14:29,960 --> 00:14:31,460
لكن يا سيّدي

180
00:14:34,300 --> 00:14:37,970
.أحسد كاتو على هذا

181
00:14:43,680 --> 00:14:44,980
!شيروغاني

182
00:14:45,900 --> 00:14:46,770
هل أنتِ بخير؟

183
00:14:47,190 --> 00:14:49,190
.لا تقللي من حذرك يا آنسة

184
00:14:49,520 --> 00:14:50,900
.شيروغاني

185
00:14:53,400 --> 00:14:55,780
...إليك هذا يا

186
00:14:56,320 --> 00:14:57,530
!أرلوكان

187
00:15:01,120 --> 00:15:01,950
!شيروغاني

188
00:15:02,120 --> 00:15:03,540
.اهرب يا سيّدي

189
00:15:04,750 --> 00:15:06,370
.ستأتي معي يا ولد

190
00:15:06,540 --> 00:15:07,420
!اهرب يا ماسارو

191
00:15:08,250 --> 00:15:09,040
!اهرب

192
00:15:17,680 --> 00:15:18,800
أهرب؟

193
00:15:20,220 --> 00:15:21,510
وأتركهما؟

194
00:15:23,680 --> 00:15:24,770
!لا

195
00:15:25,850 --> 00:15:27,150
.لن أدير ظهري

196
00:15:28,310 --> 00:15:30,060
!اذهب رجاءً يا سيّدي

197
00:15:35,240 --> 00:15:36,700
.سأقاتل

198
00:15:38,610 --> 00:15:40,320
.يا للتسلية

199
00:15:40,490 --> 00:15:43,580
.تحريك الدمى أمر صعب يا ولد

200
00:15:43,740 --> 00:15:46,580
.طفل هاو مثلك لن ينجح بهذا

201
00:15:46,750 --> 00:15:48,290
!اهرب بسرعة يا سيّدي

202
00:15:48,460 --> 00:15:49,790
!قف يا أرلوكان

203
00:15:53,340 --> 00:15:54,260
.سيّدي

204
00:15:55,170 --> 00:15:59,550
الأكثر مهارة يستغرق، سنوات لإتقان تحريك الدمى

205
00:15:59,970 --> 00:16:01,470
...لكنك

206
00:16:04,890 --> 00:16:06,310
.آسف يا أرلوكان

207
00:16:06,600 --> 00:16:09,770
.لا يمكنني التحكم بك بمهارة شيروغاني

208
00:16:09,940 --> 00:16:12,820
.لكن أذكر حيلة واحدة

209
00:16:15,740 --> 00:16:17,780
!الفنون القتالية

210
00:16:19,700 --> 00:16:21,070
!النمر الدوّار

211
00:16:29,830 --> 00:16:30,960
ما هذا؟

212
00:16:31,880 --> 00:16:33,000
ماذا يجري؟

213
00:16:50,440 --> 00:16:51,980
أنت بخير يا ماسارو؟

214
00:16:55,400 --> 00:16:56,650
.شيروغاني

215
00:16:58,070 --> 00:16:59,650
.تماسكي يا شيروغاني

216
00:16:59,820 --> 00:17:00,950
.أنا بخير

217
00:17:01,320 --> 00:17:02,820
.غير صحيح، علينا أن نسرع

218
00:17:03,370 --> 00:17:05,660
لكن كيف نخرج من هنا؟

219
00:17:05,830 --> 00:17:06,240
.يا ولد

220
00:17:06,530 --> 00:17:07,290
!أشيهانا-سان

221
00:17:07,620 --> 00:17:10,500
.أظن أنّه بوسعنا الخروج من هنا

222
00:17:11,500 --> 00:17:12,830
.هيّا

223
00:17:19,550 --> 00:17:21,090
.أعددت حبل تنقّل

224
00:17:21,630 --> 00:17:23,180
.لنستخدمه

225
00:17:23,340 --> 00:17:26,560
كيف نثق أنّك لن تقطعه؟

226
00:17:27,680 --> 00:17:31,390
.استأجرني الولد لقاء مبلغ كبير

227
00:17:32,190 --> 00:17:33,560
.سأقوم بعملي

228
00:17:37,360 --> 00:17:39,650
.سأستأجرك أيضًا إذن

229
00:17:40,650 --> 00:17:42,410
.مقابل 10 ين

230
00:17:43,320 --> 00:17:44,910
.من الأفضل أن ينجح هذا

231
00:17:45,700 --> 00:17:47,410
.لا تقلق

232
00:17:49,450 --> 00:17:52,540
.تماسكي يا شيروغاني، سنأخذكِ لطبيب

233
00:17:52,710 --> 00:17:55,080
.نعم، عليك أن تسرع أيضًا يا سيّدي

234
00:17:57,800 --> 00:17:58,630
!ماسارو

235
00:17:59,170 --> 00:18:01,470
.سيّدي! أنا قادمة إليك

236
00:18:01,760 --> 00:18:02,590
.اذهبي

237
00:18:02,760 --> 00:18:05,720
!ماذا؟ محال أن أترككما

238
00:18:05,890 --> 00:18:08,220
.لا يمكنك التحرك بقدميك

239
00:18:10,180 --> 00:18:11,730
.لن نتأخر

240
00:18:12,100 --> 00:18:15,230
.سرعان ما سأعبر بهذا الحبل مع ماسارو

241
00:18:23,110 --> 00:18:24,910
.نوبة زونافا

242
00:18:25,660 --> 00:18:28,830
!يجب أن أضحك

243
00:18:29,620 --> 00:18:32,750
...يجب أن أضحك وإلّا... وإلّا

244
00:18:39,880 --> 00:18:41,630
!لا يمكنني الضحك

245
00:18:42,090 --> 00:18:45,380
لماذا لا أضحك؟

246
00:18:45,630 --> 00:18:48,350
.آسفة جدًا

247
00:18:52,810 --> 00:18:58,610
لِمَ تعتذرين عن عدم قدرتك على الضحك؟

248
00:18:59,770 --> 00:19:03,490
.أنتِ غريبة جدًا

249
00:19:05,320 --> 00:19:06,360
.كاتو

250
00:19:06,530 --> 00:19:08,990
.اخرجي من هنا

251
00:19:09,410 --> 00:19:11,620
!كوني هانئة البال، اذهبي

252
00:19:12,200 --> 00:19:13,790
!كاتو

253
00:19:20,460 --> 00:19:21,420
!ماسارو

254
00:19:24,720 --> 00:19:26,300
.يا أخي نارومي

255
00:19:34,480 --> 00:19:35,310
!يا أخي نارومي

256
00:19:39,900 --> 00:19:45,780
.كان يجب أن أنصت لجدّي وأتّبع خطاه

257
00:19:47,030 --> 00:19:49,570
.كان جدّي مهرجًا

258
00:19:50,370 --> 00:19:54,620
.لطالما تبجّح بمدى روعة عمله

259
00:19:54,950 --> 00:19:56,830
،لو أصبحتُ مهرجًا

260
00:19:57,420 --> 00:20:01,960
.لابتسم ليّ الأطفال بمثل ابتسامتك

261
00:20:02,880 --> 00:20:04,090
.يا أخي نارومي

262
00:20:04,760 --> 00:20:08,970
.لكن مقابلتك تساوي الكثير

263
00:20:11,100 --> 00:20:14,430
.ماسارو، ابتسم باستمرار

264
00:20:16,060 --> 00:20:18,140
.يمكنك أن تبكي

265
00:20:18,770 --> 00:20:20,980
.يمكنك أن تغضب

266
00:20:21,520 --> 00:20:26,490
.لكن عدا عن ذلك، ابتسم باستمرار

267
00:20:30,570 --> 00:20:31,490
!يا أخي نارومي

268
00:20:31,990 --> 00:20:33,410
.اخفض رأسك

269
00:20:33,580 --> 00:20:37,330
...لكن... لكن يا أخي نارومي، أنت

270
00:20:38,540 --> 00:20:41,920
،إن شعرت بالضياع يا ماسارو

271
00:20:42,080 --> 00:20:47,010
.تفكّر بقلبك وقرر ما عليك فعله

272
00:20:48,630 --> 00:20:53,220
،وبعد أن تقرر، ابتسم

273
00:20:53,430 --> 00:20:55,140
.إيّاك والبكاء

274
00:21:00,270 --> 00:21:02,190
فهمت يا ماسارو؟

275
00:21:36,010 --> 00:21:37,430
.أنا حيّ

276
00:21:38,720 --> 00:21:40,520
!نحن أحياء يا أخي نارومي

277
00:21:52,450 --> 00:21:54,370
.أخي نارومي اختفى

278
00:21:54,950 --> 00:21:57,280
،لقد منحني الكثير

279
00:21:59,080 --> 00:22:00,450
.ورحل

280
00:22:02,790 --> 00:22:08,880
.لكن، الذراع التي خلّفها كانت تحميني