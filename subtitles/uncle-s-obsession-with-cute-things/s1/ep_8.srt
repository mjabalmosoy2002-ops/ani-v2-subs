1
00:00:00,530 --> 00:00:04,440
"أوجي-سان وزملاؤه القدامى"

2
00:00:05,080 --> 00:00:06,380
،حين كنتُ صغيرًا

3
00:00:06,700 --> 00:00:08,890
.أهدتني أختي الكبرى دمية محشوة

4
00:00:09,160 --> 00:00:12,350
.وكانت تلك أوّل مرّة ألتقي فيها بباغتارو

5
00:00:13,490 --> 00:00:15,330
،حتّى حين كنتُ أواجه المتاعب

6
00:00:15,330 --> 00:00:19,080
كنت أنسى كلّ همومي
أمام ظرافته الفائقة

7
00:00:19,080 --> 00:00:21,750
.وتعبير وجهه الّذي لا يُفهم

8
00:00:21,750 --> 00:00:24,460
.وفي تلك الفترة وُلد حبّي له

9
00:00:24,460 --> 00:00:26,610
!باغ

10
00:00:27,930 --> 00:00:28,920
…لكن ذات يوم

11
00:00:30,670 --> 00:00:32,420
.غريب –
أهو معجب بهذا؟ –

12
00:00:32,420 --> 00:00:33,920
أحقًّا؟ –
.يا له من أمر مخزٍ –

13
00:00:34,350 --> 00:00:36,960
هل كبرت أكثر من اللاّزم
على حبّ هذه الأشياء؟

14
00:00:37,980 --> 00:00:40,250
.جعلوني أدرك ذلك بطريقة مؤلمة

15
00:00:42,610 --> 00:00:43,590
،اليوم

16
00:00:44,100 --> 00:00:45,820
سألتقي مجدّدًا بأولئك

17
00:00:44,100 --> 00:00:46,560
"لقاء الخرّيجين"

18
00:00:45,820 --> 00:00:49,020
الّذين علّموني التّخلّي عن الأشياء
.الّتي أحبّها مع تقدّمي في العمر

19
00:00:49,700 --> 00:00:52,230
.أنا ذاهب إلى لقاء للخرّيجين

20
00:00:52,660 --> 00:00:54,950
.مع رفاقي القدامى من المرحلة الإعداديّة

21
00:00:57,210 --> 00:00:59,310
.أشعر بقلق شديد

22
00:01:14,190 --> 00:01:18,050
"هوس العمّ بالأشياء الظّريفة"

23
00:02:31,600 --> 00:02:35,460
…لا بدّ أنّهم دعوا جميع أفراد صفّي

24
00:02:35,850 --> 00:02:38,240
.لم يكن ذلك باختياري

25
00:02:39,100 --> 00:02:41,660
،لكن في الواقع
.لم يحضر سوى عدد قليل

26
00:02:43,020 --> 00:02:47,020
على أيّ حال، لا بدّ أنّ العثور
.على الجميع لم يكن أمرًا سهلاً

27
00:02:47,020 --> 00:02:50,060
،جمعوا تلاميذ الصّفوف المختلفة
.لذا أنقذتني بطاقات الأسماء

28
00:02:50,990 --> 00:02:54,190
،ما زال جرحي غائرًا
،لكنّني تجاوزت الأربعين

29
00:02:54,190 --> 00:02:55,770
.ووقتي محدود

30
00:02:55,770 --> 00:02:57,650
.فلنستغلّ هذه الدّعوة

31
00:02:57,650 --> 00:03:01,160
،لولاها لما عرفت ما آل إليه حال رفاقي

32
00:03:01,160 --> 00:03:03,240
.كما أنّ الأمر يبعث على الانتعاش

33
00:03:03,240 --> 00:03:07,660
وفوق ذلك، فهي فرصة لمواجهة
أشباح الماضي

34
00:03:07,660 --> 00:03:10,030
.وطيّ صفحته أخيرًا

35
00:03:10,470 --> 00:03:12,500
،هذا ما أحاول إقناع نفسي به

36
00:03:12,500 --> 00:03:15,670
لكنّني في أعماقي
!أرتجف من شدّة الخوف

37
00:03:15,670 --> 00:03:18,550
،ومع ذلك، باستثناء رفاق صفّي

38
00:03:18,550 --> 00:03:20,010
،فإن تلاميذ الصّفوف الأخرى

39
00:03:20,010 --> 00:03:23,640
لا أتذكّر منهم إلاّ القليل لدرجة
.أنّني أشعر وكأنّني ألتقي بهم لأوّل مرّة

40
00:03:24,440 --> 00:03:28,970
،أمّا دماي الظّريفة المحبوبة
!فلا يمكنني نسيانها أبدًا

41
00:03:29,400 --> 00:03:31,560
،وبما أنّ عدد الحاضرين قليل

42
00:03:31,560 --> 00:03:34,470
.فربّما لن يحضر أولئك الذين سخروا منّي

43
00:03:34,770 --> 00:03:35,770
!باغ

44
00:03:36,040 --> 00:03:37,510
!أعزّائي الرّفاق القدامى

45
00:03:37,750 --> 00:03:39,070
!في صحّتكم

46
00:03:39,070 --> 00:03:41,740
!في صحّتكم

47
00:03:42,830 --> 00:03:45,200
!أحضرت صور صفوفنا

48
00:03:45,200 --> 00:03:47,160
!جيّد، فكرة رائعة

49
00:03:47,160 --> 00:03:48,620
!كانت أيّامًا جميلة

50
00:03:48,620 --> 00:03:50,620
في أيّ صفّ كنت يا أوجي-كُن؟

51
00:03:50,620 --> 00:03:52,460
.كان معي في الصّفّ نفسه

52
00:03:52,460 --> 00:03:56,170
لا، شكرًا. كانت ملامحي غريبة
.في الصّورة، لا داعي

53
00:03:58,270 --> 00:03:59,960
!ها هي! وجدتها

54
00:03:59,960 --> 00:04:01,610
!ماذا؟ أرني

55
00:04:01,610 --> 00:04:03,450
"أوجي ميتسوتاكا"

56
00:04:01,980 --> 00:04:03,410
أهذا… هو؟

57
00:04:03,560 --> 00:04:08,560
نعم، أجبرت نفسي على الابتسام
.بالتّفكير في إحدى الشّخصيّات الظّريفة

58
00:04:08,990 --> 00:04:12,020
.ما زلت أعاني من مشكلة مع الصّور
.لقد ترك ذلك أثرًا في نفسي

59
00:04:12,020 --> 00:04:16,650
من الصّعب أن تبتسم بعفويّة في الصّور
حين تكون مراهقًا، أليس كذلك؟

60
00:04:16,650 --> 00:04:18,900
!على الأقلّ كان الأمر كذلك بالنّسبة إليّ

61
00:04:18,900 --> 00:04:20,490
،بذلتُ قصارى جهدي

62
00:04:20,490 --> 00:04:21,860
…لكنّ النّتيجة

63
00:04:21,860 --> 00:04:23,780
.كنت أتمنّى ألاّ أراها مجدّدًا

64
00:04:23,780 --> 00:04:26,280
!يا لها من ملامح مضحكة
!ستبقى ذكرى جميلة

65
00:04:26,280 --> 00:04:28,080
أتظنّ ذلك؟

66
00:04:28,080 --> 00:04:29,080
.صورتي أسوأ من ذلك

67
00:04:29,080 --> 00:04:31,210
!لكنّه أصبح وسيمًا جدًّا الآن

68
00:04:31,210 --> 00:04:32,500
!صحيح

69
00:04:32,500 --> 00:04:34,460
!إنّه وسيم للغاية

70
00:04:34,460 --> 00:04:37,000
بالمناسبة، هل سيأتي معلّمنا؟

71
00:04:37,000 --> 00:04:38,920
.نعم، معلّم صفنا هنا

72
00:04:38,920 --> 00:04:41,470
معلّم صفّنا موجود هنا؟

73
00:04:41,470 --> 00:04:42,990
.لم أره حتّى الآن

74
00:04:43,380 --> 00:04:45,800
.كان شابًّا في مقتبل العمر آنذاك

75
00:04:45,800 --> 00:04:47,590
كم بلغ من العمر الآن؟

76
00:04:47,940 --> 00:04:51,880
كان هادئ الطّباع وكثيرًا ما
.يصل في اللّحظة الأخيرة

77
00:04:52,100 --> 00:04:55,860
…ذات مرّة، وبّخه الأستاذ ميا

78
00:04:55,860 --> 00:04:57,020
!أظهر بعض الجدّيّة

79
00:04:57,020 --> 00:04:58,930
.يا لها من ذكريات

80
00:04:59,150 --> 00:05:02,150
.أستاذ إيدِيْ! ام أرك منذ مدّة

81
00:05:02,910 --> 00:05:04,530
…عفوًا

82
00:05:04,530 --> 00:05:06,740
!يبدو أنّه في مثل عمري

83
00:05:06,740 --> 00:05:08,450
.أنا… أوجي

84
00:05:08,450 --> 00:05:09,690
…أوجي

85
00:05:10,300 --> 00:05:11,660
!أوجي

86
00:05:11,660 --> 00:05:13,330
!لم أتعرّف عليك

87
00:05:13,330 --> 00:05:15,000
كيف حالك؟

88
00:05:15,000 --> 00:05:17,820
!أستاذ ميا، إنّه أوجي! هل تتذكّره؟

89
00:05:18,140 --> 00:05:19,130
أوجي؟

90
00:05:19,130 --> 00:05:21,710
.يبدو أنّه أصبح أكثر لطفًا من قبل

91
00:05:21,710 --> 00:05:26,680
نعم، ذلك الّذي كان يأتي كلّ صباح
!ليأخذ مفتاح الفصل

92
00:05:26,900 --> 00:05:29,260
،كنتَ فتى هادئًا ومهذّبًا للغاية

93
00:05:29,260 --> 00:05:31,670
وها أنت ذا قد أصبحت
.رجلاً وسيمًا وناضجًا

94
00:05:31,820 --> 00:05:33,600
أتظنّ ذلك؟

95
00:05:33,950 --> 00:05:35,560
.يا للعجب

96
00:05:35,560 --> 00:05:39,060
.كانا يقضيان وقتهما في الشّجار في الماضي

97
00:05:39,060 --> 00:05:40,840
.سبحان مغيّر الأحوال

98
00:05:41,270 --> 00:05:42,740
،أنا وناروتو

99
00:05:42,740 --> 00:05:45,320
…ربّما نتغيّر نحن أيضًا مع مرور الوقت

100
00:05:45,320 --> 00:05:46,740
.أو لا

101
00:05:46,740 --> 00:05:49,240
!أستاذ ميا، ما أظرف ما تحمله

102
00:05:49,240 --> 00:05:50,330
!صحيح

103
00:05:50,330 --> 00:05:51,580
أتقول أنّه ظريف؟

104
00:05:51,960 --> 00:05:53,370
ماذا؟ هذا؟

105
00:05:53,370 --> 00:05:55,150
.إنّه هديّة من حفيدي

106
00:05:55,590 --> 00:05:58,670
!يا إلهي! إنّه باغتارو

107
00:05:58,970 --> 00:06:00,670
با-باغتارو؟

108
00:06:00,670 --> 00:06:02,420
ما الّذي يفعله باغتارو هنا؟

109
00:06:02,420 --> 00:06:05,260
!لم أتوقّع رؤيته في مناسبة كهذه

110
00:06:05,260 --> 00:06:06,880
،لا أعرف شيئًا عن هذه الأمور

111
00:06:06,880 --> 00:06:09,140
.لكنّه مستدير وظريف وأنا أحبّه

112
00:06:09,140 --> 00:06:12,180
بل إنّه يعرضه أمام الجميع
!دون أيّ تردّد

113
00:06:12,180 --> 00:06:14,810
!بل ويقول أنّه يحبّه

114
00:06:14,810 --> 00:06:16,190
!كم هذا رائع

115
00:06:16,190 --> 00:06:19,400
!إنّه معلّمي السّابق ويضرب لنا مثالاً رائعًا

116
00:06:19,400 --> 00:06:21,310
!أطمح لأن أصبح مثله

117
00:06:22,620 --> 00:06:24,940
.شكرًا لك على هذا اليوم يا أستاذي

118
00:06:24,940 --> 00:06:26,390
.أنت قدوتي

119
00:06:27,280 --> 00:06:30,390
!كان حضوري لهذا اللّقاء قرارًا صائبًا

120
00:06:30,740 --> 00:06:33,200
…باغ

121
00:06:30,740 --> 00:06:33,220
"بعد قليل"

122
00:06:33,220 --> 00:06:36,020
.أجل، هذا صحيح –
مهلاً؟ أوجي؟ –

123
00:06:36,260 --> 00:06:37,790
عفوًا؟

124
00:06:37,790 --> 00:06:40,540
!إنّه أنت حقًّا! لقد أتيت

125
00:06:40,540 --> 00:06:42,500
هل تذكرنا؟

126
00:06:44,470 --> 00:06:45,670
!مرحبًا، نحن هنا

127
00:06:45,670 --> 00:06:47,550
!ها أنتم أخيرًا

128
00:06:47,550 --> 00:06:48,630
!مرّ وقت طويل

129
00:06:49,270 --> 00:06:50,970
،هؤلاء هم من كنت أتجنّبهم

130
00:06:50,970 --> 00:06:52,920
.زملائي في المرحلة الإعداديّة

131
00:06:54,320 --> 00:06:55,600
كنتُ آمل أن أتغلّب

132
00:06:55,990 --> 00:06:58,310
على تلك الذّكرى المؤلمة

133
00:06:58,610 --> 00:06:59,590
…بمجيئي إلى هنا

134
00:07:01,410 --> 00:07:03,320
ظننتُ أنّني سأقابل على الأكثر

135
00:07:03,320 --> 00:07:05,890
،واحدًا أو اثنين منهم

136
00:07:06,200 --> 00:07:07,360
…لكن

137
00:07:08,040 --> 00:07:10,350
!لقد حضروا جميعًا

138
00:07:11,070 --> 00:07:13,280
،لو كنت وحدي مع أحدهم

139
00:07:13,280 --> 00:07:15,670
.لتمكّنت من التّهرّب من الحديث

140
00:07:15,670 --> 00:07:18,910
…لكن في مواجهة المجموعة كلّها
!توقّفوا! لستُ مستعدًّا

141
00:07:19,130 --> 00:07:23,380
،اهدأ، رغم ما حدث في الماضي
.ليس بالضّرورة أنّهم أشخاص سيّئون

142
00:07:23,380 --> 00:07:25,000
.إنّهم زملائي في النّهاية

143
00:07:25,000 --> 00:07:26,990
!لقد تحدّثنا كثيرًا في الماضي

144
00:07:26,840 --> 00:07:28,590
"ولو لثانية واحدة"

145
00:07:27,020 --> 00:07:28,590
!ولو لثانية واحدة

146
00:07:28,810 --> 00:07:32,100
!ثمّ إنّني جئت اليوم لأطوي صفحة الماضي

147
00:07:32,100 --> 00:07:33,510
…بالمناسبة

148
00:07:33,510 --> 00:07:35,050
…أوجي، أتذكّر أنّك في الماضي

149
00:07:35,050 --> 00:07:38,020
لم يطل الأمر! ماذا تريد؟ –
!أوما-تشان –

150
00:07:38,020 --> 00:07:39,440
!ينادونك هناك

151
00:07:39,440 --> 00:07:41,340
!أحقًّا؟ أنا قادمة

152
00:07:41,980 --> 00:07:44,440
ماذا كنتُ أفعل في الماضي؟

153
00:07:44,740 --> 00:07:47,550
.هذا يضرّ بصحّتي
.سأذهب لأحضر شيئًا أشربه

154
00:07:49,110 --> 00:07:51,110
لديّ بيرة، أتريد بعضًا منها؟

155
00:07:51,110 --> 00:07:52,700
!لديّ بعض المقبّلات

156
00:07:52,700 --> 00:07:54,950
…وهؤلاء بقيّة المجموعة

157
00:07:55,880 --> 00:07:57,560
.شكرًا، هذا لطف منك

158
00:07:58,910 --> 00:08:01,670
،ما داموا لن يتحدّثوا عن تلك الحادثة

159
00:08:01,670 --> 00:08:04,880
فيمكنني الاستمتاع بهدوء، بهذه
…اللّحظات الّتي تعيد الذّكريات

160
00:08:05,180 --> 00:08:08,620
إيتشيكاوا، كنّا معًا في الصّفّ
الأوّل، أليس كذلك؟

161
00:08:08,840 --> 00:08:10,970
!نعم، مع نيشينا

162
00:08:10,970 --> 00:08:12,470
أتذكر يا أوجي؟

163
00:08:12,470 --> 00:08:14,640
…في ذلك الوقت، وجدنا الأمر غريبًا جدًّا

164
00:08:15,610 --> 00:08:17,390
…مهلاً، هل سيبدأ الحديث عن

165
00:08:17,390 --> 00:08:21,520
قال نيشينا أنّه حتّى عندما يكبر
!لن يشرب سوى صودا الشّمّام

166
00:08:21,520 --> 00:08:23,030
ماذا؟ هل تتحدّثون عنّي؟

167
00:08:23,030 --> 00:08:24,660
!هذه بيرة –
هل صرت تشرب الكحول؟ –

168
00:08:24,660 --> 00:08:26,730
!لقد نسيتُ ذلك تمامًا

169
00:08:27,200 --> 00:08:29,010
…أتذكّر أنّه ذات مرّة

170
00:08:29,660 --> 00:08:30,690
…يا أوجي

171
00:08:30,690 --> 00:08:33,310
!ها قد وصلنا إلى ذلك

172
00:08:33,420 --> 00:08:36,120
غضبتَ بشدّة لأنّ أحدهم سرق منك

173
00:08:36,120 --> 00:08:38,060
!نقانق الأخطبوط

174
00:08:38,340 --> 00:08:40,660
حقًّا؟ أهذا صحيح؟

175
00:08:40,660 --> 00:08:43,620
في الصّفّ الرّابع، أتذكر يا أوجي؟

176
00:08:43,890 --> 00:08:47,330
!بالطّبع لا، لا أتذكّر ذلك

177
00:08:47,330 --> 00:08:50,590
أمّا أنا، فلو أردت ذكر
…أكثر ما علق بذاكرتي

178
00:08:50,590 --> 00:08:52,160
…دعوني أفكّر

179
00:08:52,420 --> 00:08:55,010
إيتشيكاوا، كنتَ تتناول غداءك
.دائمًا قبل الآخرين

180
00:08:55,010 --> 00:08:58,350
نيشينا، كنتَ كابوسًا لمعلّم
.الدّراسات الاجتماعيّة

181
00:08:58,350 --> 00:09:01,430
.وأنت يا مياما، كنتَ تلاحق كلّ الفتيات

182
00:09:01,430 --> 00:09:02,730
.على ما أظنّ

183
00:09:02,730 --> 00:09:04,310
أحقًّا؟

184
00:09:04,310 --> 00:09:05,520
ألم تكن أنت من يفعل ذلك؟

185
00:09:05,520 --> 00:09:07,770
.أتذكر مسألة الغداء المبكّر

186
00:09:07,770 --> 00:09:09,760
!يا لها من ذكريات تافهة

187
00:09:09,290 --> 00:09:10,550
"ها ها ها"

188
00:09:09,790 --> 00:09:12,990
،على نحو غريب
.كانت ذكرياتنا جميعًا غير واضحة

189
00:09:11,040 --> 00:09:12,390
"مضحك جدًّا"

190
00:09:16,080 --> 00:09:18,030
عمّ تتحدّثون؟

191
00:09:18,630 --> 00:09:20,240
…عضوة أخرى من المجموعة

192
00:09:20,240 --> 00:09:21,240
.مرحبًا يا تورا-سان

193
00:09:21,880 --> 00:09:23,960
هل تذكر اسمي؟

194
00:09:23,960 --> 00:09:26,460
…بالطّبع… لقد سبّبتم لي صدمة

195
00:09:26,840 --> 00:09:29,790
.سأذهب لأملأ كأسي –
!سأحضر شيئًا أشربه –

196
00:09:30,140 --> 00:09:31,660
.سأذهب إلى الحمّام

197
00:09:32,560 --> 00:09:34,630
عمّ كنتم تتحدّثون يا رجال؟

198
00:09:34,630 --> 00:09:37,750
.لا شيء مهمّ. مجرّد ذكريات قديمة

199
00:09:38,110 --> 00:09:41,850
،بالمناسبة يا تورا-سان
ألم تكوني في صفّ آخر؟

200
00:09:41,850 --> 00:09:43,180
!هيّا، لا داعي للرّسميّة

201
00:09:43,180 --> 00:09:45,730
.نعم، كنت في الصّفّ المجاور

202
00:09:45,730 --> 00:09:48,350
!ومع ذلك، تذكّر اسمي

203
00:09:48,350 --> 00:09:52,320
بالمناسبة، في الماضي كان
.هؤلاء الثّلاثة هم الأبرز

204
00:09:52,320 --> 00:09:53,820
.أمّا أوجي، فكان هادئًا نوعًا ما

205
00:09:53,820 --> 00:09:56,030
!لكن انظروا إليه الآن

206
00:09:56,030 --> 00:09:58,740
ما الّذي حدث خلال ثلاثين عامًا؟

207
00:09:58,740 --> 00:10:00,410
أين ذهبت صديقتك؟

208
00:10:00,410 --> 00:10:01,950
ماذا؟ أوما-سان؟

209
00:10:02,410 --> 00:10:05,000
يبدو أنّها تستمتع بوقتها
…مع مجموعة أخرى

210
00:10:05,000 --> 00:10:06,370
.حسنًا، فهمت

211
00:10:06,370 --> 00:10:07,580
.هذا أفضل

212
00:10:07,580 --> 00:10:10,450
فالتّعامل مع اثنتين ضدّ واحد
.كان سيصعّب عليّ الأمر

213
00:10:10,830 --> 00:10:19,430
"توري"

214
00:10:10,830 --> 00:10:15,630
مهلاً! سبّبت لي صدمة ومع ذلك
تحمل دمية ظريفة على حقيبتها؟

215
00:10:15,630 --> 00:10:18,010
"…لا أحد يحمل أشياء ظريفة"

216
00:10:18,010 --> 00:10:19,430
!لكنّ هذا غير صحيح إطلاقًا

217
00:10:20,390 --> 00:10:21,470
.تورا-سان

218
00:10:22,390 --> 00:10:24,510
هل تحبّ الأشياء الظّريفة؟

219
00:10:25,350 --> 00:10:26,770
أوجي-كُن؟

220
00:10:26,770 --> 00:10:27,980
…إنّه قريب جدًّا

221
00:10:28,190 --> 00:10:29,940
هل تحبّها؟

222
00:10:31,480 --> 00:10:32,560
.أنا آسف

223
00:10:32,820 --> 00:10:34,400
.هذا ليس مستغربًا

224
00:10:34,990 --> 00:10:38,150
فحتّى لو سخرتْ من الأم
،حين كانت صغيرة

225
00:10:38,150 --> 00:10:42,620
فهذا لا يمنعها من تغيير رأيها
.مع تقدّمها في العمر

226
00:10:42,620 --> 00:10:45,080
،هل سأتمكّن، إلى جانب تجاوز جراحي

227
00:10:45,490 --> 00:10:48,660
من العثور على صديقة أخرى
تشاركني حبّ الأشياء الظّريفة؟

228
00:10:48,660 --> 00:10:51,500
تورا-سان، هل وقعتِ أنت أيضًا في هذا الحبّ؟

229
00:10:51,500 --> 00:10:52,620
ماذا؟

230
00:10:56,170 --> 00:10:58,340
هل وقع أوجي-كُن في حبّي؟

231
00:10:58,340 --> 00:11:01,590
صحيح أنّ قلبي يخفق بسرعة
…حين أراه

232
00:11:01,890 --> 00:11:05,560
!ما الّذي تقوله؟! أنا امرأة متزوّجة

233
00:11:05,560 --> 00:11:07,770
متزوّجة؟ وما علاقة ذلك؟

234
00:11:07,770 --> 00:11:08,770
!بالطّبع له علاقة

235
00:11:08,770 --> 00:11:13,010
ألا يمكن للمتزوّجين
أن يحبّوا الأشياء الظّريفة؟

236
00:11:09,400 --> 00:11:14,610
"فظيع"

237
00:11:13,010 --> 00:11:14,610
!يا له من تصوّر مريع

238
00:11:14,610 --> 00:11:17,820
إذًا، ما الّذي تحملينه على حقيبتك…؟

239
00:11:18,490 --> 00:11:19,780
ماذا؟ هذا؟

240
00:11:19,780 --> 00:11:21,150
هل غيّر الموضوع؟

241
00:11:21,150 --> 00:11:22,860
!نعم، نعم –
!توري، توري –

242
00:11:23,200 --> 00:11:27,700
ماذا؟ هل سبق أن أهداني
أوجي-كُن هديّة مشابهة؟

243
00:11:27,700 --> 00:11:29,830
لا أظنّ ذلك، أهو سوء فهم؟

244
00:11:29,830 --> 00:11:33,620
،لكنّ أوجي-كُن كان هادئًا في الماضي
…ربّما نسيت

245
00:11:33,790 --> 00:11:35,880
.إنّها هديّة من ابنتي

246
00:11:35,880 --> 00:11:38,000
.قالت أنّها رائجة هذه الأيّام

247
00:11:38,000 --> 00:11:40,050
.أمّا أنا فلا أعرف شيئًا عن هذه الأمور

248
00:11:40,050 --> 00:11:41,130
لا تعرفين شيئًا؟

249
00:11:41,350 --> 00:11:44,800
أعطت واحدة لزوجي أيضًا
.وهو يحملها على مضض

250
00:11:44,800 --> 00:11:46,470
.وزملاؤه في العمل يسخرون منه

251
00:11:46,470 --> 00:11:48,270
…يسخرون منه

252
00:11:48,270 --> 00:11:50,180
هل تعرف ما هذه؟

253
00:11:50,180 --> 00:11:52,020
…حسنًا، نعم

254
00:11:52,020 --> 00:11:54,730
.رأيتُها من قبل كثيرًا. الآن فهمت

255
00:11:54,730 --> 00:11:56,440
.إنّها دمية مشهورة

256
00:11:56,440 --> 00:11:59,860
أشعر بالنّدم لأنّني بنيت آمالاً
.على أوهام لا أساس لها

257
00:12:00,110 --> 00:12:03,070
!باغ… باغ

258
00:12:00,110 --> 00:12:03,070
"في نهاية اللّقاء"

259
00:12:04,540 --> 00:12:06,910
!التّجمّع التّالي من هنا

260
00:12:06,910 --> 00:12:08,080
ألن تأتي يا أوجي-كُن؟

261
00:12:08,080 --> 00:12:09,870
.لا، سأستأذن منكم

262
00:12:12,180 --> 00:12:14,880
!شكرًا لكما يا أستاذاي على هذا اليوم

263
00:12:17,140 --> 00:12:19,250
ماذا؟ –
.لا داعي للشّكر –

264
00:12:23,600 --> 00:12:26,720
،لم يكن الأمر سهلاً لكن في النّهاية

265
00:12:26,720 --> 00:12:29,350
تمكّنت من لقاء أولئك الأشخاص
.دون مشكلات تُذكر

266
00:12:29,350 --> 00:12:33,630
!كما قابلتُ معلّمين يستحقّان أن أقتدي بهما

267
00:12:29,510 --> 00:12:34,090
"رجل في الثّمانين يعتزّ بما يحبّ"

268
00:12:30,520 --> 00:12:34,090
"ورجل في الخمسين لا يبدو في عمره"

269
00:12:34,410 --> 00:12:39,140
وفوق كلّ ذلك، تمكّنت على نحو غير
!متوقّع من رؤية باغتارو أيضًا

270
00:12:39,660 --> 00:12:42,770
هيّا، سأبذل قصارى جهدي
!أنا أيضًا! أجل

271
00:12:46,420 --> 00:12:47,990
،قد يبدو الأمر مفاجئًا بعض الشّيء

272
00:12:47,990 --> 00:12:50,360
.لكنّني أرتدي الآن زيًّا كاملاً

273
00:12:50,970 --> 00:12:54,080
لو كنت أعلم ما الّذي ينتظرني
…في هذا اليوم

274
00:12:54,470 --> 00:12:58,590
كنتُ أمرّ بجوار مركز لرعاية
…الأطفال في حيّي

275
00:13:00,800 --> 00:13:03,950
فرأيت رجلاً يخلع قناعه
.وعلى وجهه علامات الانزعاج

276
00:13:04,670 --> 00:13:06,930
!لا تحطّموا أحلام الأطفال

277
00:13:06,930 --> 00:13:09,900
بدّلوا ملابسكم بعيدًا عن الأنظار
!من فضلكم

278
00:13:09,900 --> 00:13:12,500
.وبينما أفكّر في ذلك، توقّفت للحظة

279
00:13:16,020 --> 00:13:17,270
…وهكذا، وما إلى ذلك

280
00:13:17,270 --> 00:13:19,610
،رأتني جارتي تاناكا-سان

281
00:13:19,610 --> 00:13:22,320
…وبعد سلسلة من الأحداث

282
00:13:22,660 --> 00:13:24,270
.وجدتُ نفسي هنا

283
00:13:26,210 --> 00:13:28,740
.هذه أوّل مرّة أرتدي فيها زيًّا كهذا

284
00:13:28,740 --> 00:13:30,660
.أشعر ببعض التّوتّر

285
00:13:31,170 --> 00:13:34,370
كلّ ما عليّ فعله هو توزيع
.الحلوى على الأطفال

286
00:13:34,630 --> 00:13:37,580
!لكنّني الآن السّيّد أرنوب

287
00:13:38,140 --> 00:13:40,710
لذا عليّ أن أتقمّص شخصيّتي

288
00:13:40,710 --> 00:13:43,050
!وأن أكون ظريفًا قدر الإمكان

289
00:13:43,680 --> 00:13:45,490
!إنّه السّيّد أرنوب

290
00:13:45,760 --> 00:13:48,270
!سأبذل قصارى جهدي

291
00:13:48,270 --> 00:13:49,890
…السّيّد أرنوب

292
00:13:49,890 --> 00:13:51,830
!هو أنا

293
00:13:54,770 --> 00:13:56,520
!ركلة، ركلة

294
00:13:58,620 --> 00:14:02,150
أهكذا يعاملون السّيّد أرنوب؟

295
00:14:02,150 --> 00:14:04,360
!مهلاً… أرجوكم

296
00:14:08,830 --> 00:14:10,160
الآن فهمت

297
00:14:10,160 --> 00:14:13,190
.ما كان يشعر به الرّجل الّذي رأيته قبل قليل

298
00:14:14,840 --> 00:14:15,820
.تفضّل

299
00:14:24,880 --> 00:14:27,340
"أدوات مكتبيّة"

300
00:14:30,050 --> 00:14:32,670
…أدوات مكتبيّة مزيّنة بالقطط

301
00:14:35,110 --> 00:14:37,770
.هذا يذكّرني بناروتو-كُن

302
00:14:38,740 --> 00:14:42,300
.مع أنّه قد يجدها سخيفة أيضًا

303
00:14:43,690 --> 00:14:48,470
هل يمكن استمالته بأدوات"
"مكتبيّة مزيّنة بالقطط؟

304
00:14:43,950 --> 00:14:45,150
:سؤال مهمّ

305
00:14:45,150 --> 00:14:48,200
هل يمكن للسّيّد ناروتو الّذي يكره
الأدوات المكتبيّة الظّريفة في العمل

306
00:14:48,200 --> 00:14:50,770
أن يستسلم لسحر الورق المزخرف بالقطط؟

307
00:14:48,500 --> 00:14:53,330
"بدأ التّحقيق"

308
00:14:50,790 --> 00:14:52,330
!سأجري تحقيقًا

309
00:14:52,330 --> 00:14:53,330
!باغ

310
00:14:58,130 --> 00:14:59,040
.مرحبًا

311
00:14:59,760 --> 00:15:01,280
.مرحبًا

312
00:15:01,680 --> 00:15:04,110
ناروتو، هل يثير هذا اهتمامك؟

313
00:15:04,770 --> 00:15:06,370
ما هذا؟

314
00:15:13,320 --> 00:15:17,390
!دفتر ملاحظات على شكل دُمية قطّة

315
00:15:13,860 --> 00:15:17,390
"أسلوب مبالغ فيه"

316
00:15:17,860 --> 00:15:20,520
.لستُ طفلاً، لذا لا

317
00:15:20,520 --> 00:15:22,350
.وليس هذا كلّ شيء

318
00:15:27,000 --> 00:15:30,240
!فواصل ورقيّة للكتب على شكل قطط

319
00:15:27,580 --> 00:15:30,240
"أسلوب شبه واقعيّ"

320
00:15:30,620 --> 00:15:32,280
ستفيدك، أليس كذلك؟

321
00:15:32,280 --> 00:15:33,640
.لا، أبدًا

322
00:15:34,950 --> 00:15:38,790
!ملاحظات لاصقة على شكل قطط حقيقيّة

323
00:15:34,950 --> 00:15:38,790
"أسلوب واقعيّ إلى حدّ ما"

324
00:15:42,220 --> 00:15:43,610
.لا أحتاج إليها

325
00:15:43,970 --> 00:15:45,090
.لقد تردّد

326
00:15:45,720 --> 00:15:47,420
.أرجو أن يكون هذا كلّ شيء

327
00:15:47,420 --> 00:15:50,220
…لديّ عمل عليّ إنجازه –
.بقي شيء واحد فقط –

328
00:15:50,220 --> 00:15:51,760
شيء آخر؟

329
00:15:51,760 --> 00:15:53,140
.وهذا الأخير

330
00:15:53,140 --> 00:15:54,600
.آمل ذلك

331
00:15:54,600 --> 00:15:56,220
.أعدك، أعدك

332
00:15:56,900 --> 00:16:00,680
!تقويم مكتبيّ يحوي صورًا للقطط

333
00:16:02,990 --> 00:16:04,770
هل فشلت هذه المحاولة إذًا؟

334
00:16:04,770 --> 00:16:06,860
!لقد طفح الكيل

335
00:16:06,860 --> 00:16:09,950
!لقد فهمتُ ما تحاول فعله
تريد إبطاء عملي

336
00:16:09,950 --> 00:16:12,070
!والتّأثير سلبًا على أدائي

337
00:16:12,290 --> 00:16:14,450
!كلاّ، لم يخطر لي ذلك قطّ

338
00:16:14,450 --> 00:16:17,910
.ظننتُ فحسب أنّها قد تفيدك في العمل

339
00:16:17,910 --> 00:16:19,660
…ثم إنّك يا ناروتو

340
00:16:20,260 --> 00:16:22,000
تحبّ القطط، أليس كذلك؟

341
00:16:23,760 --> 00:16:24,960
وماذا في ذلك؟

342
00:16:25,300 --> 00:16:28,800
ظننتُ أنّها قد تساعدك
.على الاسترخاء أثناء العمل

343
00:16:29,060 --> 00:16:30,340
عفوًا؟ –
…آسف –

344
00:16:30,340 --> 00:16:31,990
!أردت أن أضفي بعض المرح فحسب

345
00:16:32,920 --> 00:16:35,260
أيريد أوجي-سان أن يساعدني
على الاسترخاء في العمل؟

346
00:16:35,260 --> 00:16:36,890
هل يسخر منّي؟

347
00:16:36,890 --> 00:16:40,600
وكأنّ هذه الأشياء الطّفوليّة
…ستعجبني! لكن

348
00:16:40,600 --> 00:16:43,400
!تقويم صور القطط هذا يثير اهتمامي

349
00:16:43,400 --> 00:16:45,100
!بل أريده حقًّا

350
00:16:45,740 --> 00:16:48,970
.على أيّ حال، دعنا من مسألة الاسترخاء

351
00:16:49,580 --> 00:16:53,450
ـصحيح أنّ تقويمًا مكتبيًّا قد يفيدني

352
00:16:54,040 --> 00:16:56,770
.لذا سأحتفظ به

353
00:16:57,040 --> 00:16:58,900
…حـ-حسنًا

354
00:17:00,840 --> 00:17:03,170
…طريقة عقده لحاجبيه تلك

355
00:17:03,170 --> 00:17:06,340
.يبدو أنّه لا يحبّ سوى القطط الحقيقيّة

356
00:17:06,340 --> 00:17:08,570
.يا للخسارة

357
00:17:09,000 --> 00:17:11,460
!باغ

358
00:17:09,000 --> 00:17:11,460
"بعد العمل"

359
00:17:17,860 --> 00:17:20,850
.آسف، عليّ الانصراف

360
00:17:23,400 --> 00:17:24,770
!طابت ليلتك

361
00:17:24,770 --> 00:17:26,520
.طابت ليلتك يا سيّدي

362
00:17:26,520 --> 00:17:27,900
.طابت ليلتكم

363
00:17:27,900 --> 00:17:30,470
.بدا جادًّا للغاية

364
00:17:32,280 --> 00:17:37,240
"هل سيحظى باغتارو بصديق جديد؟"

365
00:17:33,660 --> 00:17:36,850
.يا للمفاجأة… لم أتوقّع هذا

366
00:17:37,790 --> 00:17:39,870
،كنت في طريقي إلى المنزل بالفعل

367
00:17:39,870 --> 00:17:42,500
.لكنّني أسرعت الخطى كثيرًا

368
00:17:42,500 --> 00:17:45,210
هل ستحصل كيتدلاند على شخصيّة جديدة؟

369
00:17:45,210 --> 00:17:49,240
وفوق ذلك، ستكون صديقًا جديدًا لباغتارو؟

370
00:17:49,470 --> 00:17:52,760
تتمحور كيتدلاند حول شخصيّات
.مستوحاة من الكلاب

371
00:17:52,760 --> 00:17:55,720
،ومن بينها باغتارو، شخصيّتي المفضّلة

372
00:17:55,720 --> 00:17:57,330
!الّذي سيحظى بصديق جديد

373
00:17:58,860 --> 00:18:02,390
،بحثت عن الأمر
.لكنّني لم أجد أيّ معلومات إضافيّة

374
00:18:02,390 --> 00:18:04,520
.وهذا طبيعيّ على أيّ حال

375
00:18:04,520 --> 00:18:07,300
.فهم يضيفون شخصيّات جديدة باستمرار

376
00:18:07,770 --> 00:18:11,610
،لكن بعد كلّ هذه السّنوات
سيحصل باغتارو على صديق جديد؟

377
00:18:11,610 --> 00:18:15,150
!لقد رافقني طوال 30 عامًا
…هذا شعور غريب

378
00:18:15,150 --> 00:18:17,240
كيف لي أن أتعامل مع هذه المشاعر؟

379
00:18:17,960 --> 00:18:20,060
.يصعب عليّ وصفها

380
00:18:20,420 --> 00:18:23,060
،أشعر وكأنّه تمّ التّخلّي عنّي
.بل أكاد أشعر بالغيرة

381
00:18:23,210 --> 00:18:26,920
هذه أوّل مرّة يجعلني باغتارو
.أشعر بشيء كهذا

382
00:18:26,920 --> 00:18:29,130
،إن كان صديقًا لباغتارو

383
00:18:29,130 --> 00:18:31,670
!فسأضطرّ حتمًا إلى التّعامل معه

384
00:18:31,670 --> 00:18:33,710
…باغ

385
00:18:33,710 --> 00:18:37,080
أظنّ أنّهم سيصدرون منتجات
.تجمع بينهما أيضًا

386
00:18:37,560 --> 00:18:39,680
هل سأتمكّن من أن أحبّه أيضًا؟

387
00:18:39,680 --> 00:18:42,350
،مهلاً! شخصيّة ظريفة جديدة

388
00:18:42,350 --> 00:18:45,420
!ستعيد الحيويّة إلى كيتدلاند
!هذا أمر رائع

389
00:18:45,680 --> 00:18:49,060
…ثمّ لا بأس، إنّه مجرّد صديق إضافيّ

390
00:18:49,060 --> 00:18:51,190
.الحياة مليئة باللّقاءات

391
00:18:51,190 --> 00:18:52,980
.ومن حقّ باغتارو أن يكوّن صداقات أيضًا

392
00:18:53,830 --> 00:18:54,830
…لقد عدت

393
00:18:54,830 --> 00:18:58,320
.مساء الخير! يوشك العشاء… أن يجهز

394
00:18:59,040 --> 00:19:01,140
.حسنًا، شكرًا لك

395
00:19:01,880 --> 00:19:05,120
هل يواجه مشاكل في العمل؟

396
00:19:05,120 --> 00:19:07,000
.بدا عليه القلق

397
00:19:07,000 --> 00:19:08,580
…صديق جديد

398
00:19:08,580 --> 00:19:10,400
كيف سيكون شكله؟

399
00:19:10,750 --> 00:19:13,490
…كلّ ما يمكنني فعله من أجله

400
00:19:15,810 --> 00:19:17,200
!هو إعداد وجبة لذيذة

401
00:19:17,840 --> 00:19:20,300
!باغ، باغ

402
00:19:17,840 --> 00:19:20,300
"في اليوم التّالي"

403
00:19:27,110 --> 00:19:28,220
ما الأمر؟

404
00:19:28,650 --> 00:19:31,940
.تبدو اليوم على غير عادتك أيّها المدير أوجي

405
00:19:32,280 --> 00:19:34,940
،ظننّا أنّ لديك مشاكل في العمل

406
00:19:34,940 --> 00:19:36,900
…لكن يبدو أنّ الأمر مختلف

407
00:19:37,330 --> 00:19:40,490
كلّ ما يمكننا فعله من أجلك
!هو إطعامك

408
00:19:40,490 --> 00:19:43,580
!إن كان بوسعنا مساعدتك، فأخبرنا

409
00:19:43,580 --> 00:19:45,060
…شكرًا جزيلاً لكم

410
00:19:45,340 --> 00:19:46,700
…الأمر ليس خطيرًا

411
00:19:47,840 --> 00:19:49,400
.لكنّني أقدّر لطفكم

412
00:19:52,850 --> 00:19:54,820
…أوجي-سان لديه هموم

413
00:20:01,190 --> 00:20:03,380
لا يمكنني إخبارهم

414
00:20:03,650 --> 00:20:07,470
أن صديق باغتارو الجديد
!هو سبب كلّ هذا القلق

415
00:20:07,470 --> 00:20:08,600
باغ؟

416
00:20:08,600 --> 00:20:11,730
لقد تأثّرتُ بالأمر لدرجة
…أن موظّفيّ لاحظوا ذلك

417
00:20:11,730 --> 00:20:13,010
.يا له من أمر مخزٍ

418
00:20:13,620 --> 00:20:17,320
لكنّها المرّة الأولى الّتي يحظى
!فيها باغتارو بصديق جديد

419
00:20:17,320 --> 00:20:20,530
!على أيّ حال، سيكشفون عنه قريبًا

420
00:20:20,530 --> 00:20:22,780
!لا داعي لكلّ هذا القلق

421
00:20:22,780 --> 00:20:24,620
،أيًّا كان صديقه

422
00:20:24,620 --> 00:20:27,770
،فسأبذل كلّ جهدي
!أنا أوجي ميتسوتاكا، لتقبّله

423
00:20:28,160 --> 00:20:30,620
!باغ

424
00:20:28,160 --> 00:20:30,620
"بعد بضعة أيّام"

425
00:20:30,620 --> 00:20:33,870
"الأربعينيّ اللّطيف"

426
00:20:30,880 --> 00:20:33,870
حان الوقت. سيكشفون اليوم
.عن صديقه الجديد

427
00:20:35,930 --> 00:20:37,990
.لا بدّ أنّ الإعلان قد نُشر بالفعل

428
00:20:46,360 --> 00:20:48,000
!تشرّفت بلقائكم

429
00:20:49,530 --> 00:20:52,270
"الاسم: بوسكيتشي"
"أحبّ الجبن أكره الرّعد"

430
00:20:52,270 --> 00:20:53,920
أيعجبني بالفعل؟

431
00:20:54,450 --> 00:20:56,820
!واحد جديد ينضمّ إلى قائمة المفضّلين لدّي

432
00:20:56,820 --> 00:21:00,070
!يا للّروعة! يا للّروعة! يا للّروعة

433
00:21:00,070 --> 00:21:01,140
!باغ

434
00:21:06,630 --> 00:21:09,750
.أوجي، تفضّل، هذا لك

435
00:21:09,750 --> 00:21:11,370
لأيّ سبب يا ناروتو-كُن؟

436
00:21:11,370 --> 00:21:13,650
هذا مفاجئ… هل كلّ شيء على ما يرام؟

437
00:21:15,140 --> 00:21:16,210
ماذا؟

438
00:21:16,720 --> 00:21:18,780
…بعد أن تكلّفتُ عناء إحضاره

439
00:22:56,740 --> 00:22:59,060
مهلاً، ما الّذي يحدث؟

440
00:23:00,320 --> 00:23:02,810
!لا أستطيع التّقدّم

441
00:23:04,410 --> 00:23:07,690
!هذا لأنّ باغتارو ضغط على زرّ غريب

442
00:23:09,000 --> 00:23:11,200
…باغ

443
00:23:26,020 --> 00:23:29,410
!أأنتم هنا؟ كنت أبحث عنكم

444
00:23:29,600 --> 00:23:31,840
!ماذا؟ بوسكيتشي

445
00:23:34,980 --> 00:23:38,500
كنت في الصّالون، وحين عدت
!لم أجدكم في أيّ مكان