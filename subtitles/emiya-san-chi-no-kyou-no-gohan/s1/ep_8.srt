1
00:00:15,160 --> 00:00:16,370
!يا توساكا

2
00:00:17,250 --> 00:00:19,790
أينَ تُريدينني أنّ أضع هذه؟

3
00:00:20,170 --> 00:00:21,750
!انتظر قليلًا

4
00:00:25,920 --> 00:00:28,760
أيُّمكنكَ أنّ تضع كلّ الكتب معًا في
إحدى الزوايا في الغرفة الأُخرى؟

5
00:00:29,050 --> 00:00:30,390
!فهمت

6
00:00:32,140 --> 00:00:33,100
!انتبه

7
00:00:35,270 --> 00:00:36,930
!انتبه إلى طريقك

8
00:00:37,180 --> 00:00:38,810
،إذا تعثّرتَ بشيءٍ ما وحطّمته

9
00:00:39,440 --> 00:00:41,060
أيُّمكنكَ أنّ تتخيّل ما
الّذي يُمكن أنّ يحدث؟

10
00:02:03,060 --> 00:02:04,600
.هذا مُذهل

11
00:02:05,390 --> 00:02:09,350
...متأكدٌ أنَّ كلّ هذه الأشياء قيمة، ولكنّ مع ذلك

12
00:02:10,480 --> 00:02:11,760
!يا توساكا

13
00:02:12,400 --> 00:02:14,280
ما الّذي عليَّ فعله بهذا؟

14
00:02:15,690 --> 00:02:16,990
.دعني أرى

15
00:02:18,700 --> 00:02:20,620
.يُمكنكَ ترك ذلك مكانه

16
00:02:20,990 --> 00:02:24,290
.سيكون مِن الخطير إذا فُتِح ذلكَ الغطاء عن طريق الخطأ

17
00:02:25,620 --> 00:02:28,000
أ-أحقًّا ذلك؟

18
00:02:28,870 --> 00:02:30,380
.فهمت

19
00:02:30,380 --> 00:02:31,790
،الأهم مِن ذلك

20
00:02:31,790 --> 00:02:34,920
،أيُّمكنكَ وضع هذه في غرفتي
في مكانٍ ما بقرب مكتبي؟

21
00:02:35,800 --> 00:02:37,670
غرفتكِ أنتِ يا توساكا؟

22
00:02:38,510 --> 00:02:40,760
ألا تُمانعين؟

23
00:02:40,760 --> 00:02:41,890
ما الّذي تتحدّث عنه؟

24
00:02:42,300 --> 00:02:44,760
أعني، ألا تُمانعين إذا دخلتُ إلى غرفتكِ؟

25
00:02:46,060 --> 00:02:48,230
.لستُ أُمانع إذا كانَ أنت يا شيرو

26
00:02:49,390 --> 00:02:50,650
،وبينما أنتَ في خضم ذلك

27
00:02:51,150 --> 00:02:53,060
هلّا تفقدتَ ساكورا رجاءً؟

28
00:02:58,070 --> 00:03:00,700
...أعلم أنّها أخبرتني بحمل هذه للأعلى، ولكنّ

29
00:03:01,780 --> 00:03:04,370
أينَ هي غرفة توساكا أصلًا؟

30
00:03:05,200 --> 00:03:08,880
.منزل توساكا حقًّا ضخمٌ جدًا

31
00:03:11,830 --> 00:03:13,540
...سينباي

32
00:03:13,920 --> 00:03:15,750
!ساكورا

33
00:03:15,750 --> 00:03:18,510
هل أوشكت أُختي الكبيرة على الانتهاء؟

34
00:03:19,140 --> 00:03:23,390
.ليسَ بعد. أخبرتني للتو أنّ أجلب هذه إلى مكتبها

35
00:03:24,310 --> 00:03:25,520
...في هذه الحالة

36
00:03:27,060 --> 00:03:30,730
.يُمكنكَ أنّ تُضعها هنا

37
00:03:31,190 --> 00:03:32,030
.شكرًا

38
00:03:32,320 --> 00:03:33,190
.لقد كنتِ عونًا لي

39
00:03:35,860 --> 00:03:38,740
يا ساكورا، كيفَ هي الأحوال عندكِ هنا؟

40
00:03:39,160 --> 00:03:41,370
،أظنني أُحرز تقدمًا

41
00:03:41,580 --> 00:03:44,080
.لكنّ كما ترى، ما يزال هناكَ الكثير لفعله

42
00:03:47,000 --> 00:03:48,540
.أنتِ مُحقة

43
00:03:51,630 --> 00:03:53,960
!يا لهُ مِن كمٍ هائل مِن الرسائل

44
00:03:54,760 --> 00:03:56,800
كنتُ أُنظمها قبل قليل

45
00:03:57,720 --> 00:04:00,300
.لأنّها كانت مُبعثرة في كلّ مكان فوق المكتب

46
00:04:01,060 --> 00:04:04,560
."لنرى... "لندن، إنجلترا

47
00:04:04,810 --> 00:04:06,890
هل هذه مِن برج الساعة؟

48
00:04:07,480 --> 00:04:11,400
.يبدو أنّها كانت على تواصل معهم بهذه الطريقة لسنوات

49
00:04:11,860 --> 00:04:14,150
.رغمَ كونها مشغولة بالفعل

50
00:04:14,900 --> 00:04:16,760
!كما توقعت، أُختي الكبيرة مُذهلة

51
00:04:17,490 --> 00:04:20,200
.توساكا... إنّها تبذل قُصار جهدها

52
00:04:29,580 --> 00:04:31,040
تأخّرَ الوقت لهذه الدرجة بالفعل؟

53
00:04:31,290 --> 00:04:33,460
هلّا ذهبنا لإلقاء نظرة على أُختي الكبيرة؟

54
00:04:37,720 --> 00:04:38,880
!يا أُختي الكبيرة

55
00:04:41,220 --> 00:04:42,260
!أنتما الاثنان

56
00:04:43,350 --> 00:04:45,890
.لقد كنتُ على وشك أنّ أُنادي عليكما

57
00:04:47,390 --> 00:04:49,140
.هذا ما كنّا ننوي نحنُ أيّضًا فعله

58
00:04:50,770 --> 00:04:53,190
ماذا نفعل بشأن الغداء؟

59
00:04:53,570 --> 00:04:57,030
،إذا يُمكنني استعارة مطبخك
.فسيسعدني اعداد شيء ما

60
00:04:57,360 --> 00:04:58,400
.كلّا، لا بأس

61
00:04:58,650 --> 00:05:02,280
،فوقَ طلبي منكَ مساعدتنا في التنظيف
!لا يُمكنني طلب منك أنّ تطبخ لنا أيّضًا

62
00:05:02,780 --> 00:05:04,540
!أنا سأُعد شيئًا ما

63
00:05:07,450 --> 00:05:09,580
!سأُساعدكِ

64
00:05:13,170 --> 00:05:15,250
.استخدم ذلكَ المئزر الّذي هناك

65
00:05:15,500 --> 00:05:17,510
.حسنًا، فهمت

66
00:05:21,300 --> 00:05:22,930
...بصمة قط

67
00:05:24,010 --> 00:05:27,270
.أظنها... تُحبّ القطط

68
00:05:35,520 --> 00:05:36,940
.كلا، لا شيء

69
00:05:41,910 --> 00:05:44,660
.متأكدة أنّهُ يوجد لدينا كلّ المكونات

70
00:05:46,120 --> 00:05:52,710
،بيض، جزر، كراث، فلفل أخضر
.كامبوكو، لحم الخنزير المشوي

71
00:05:53,250 --> 00:05:54,790
!أجل، هذا كلّ شيء نحتاجه

72
00:05:55,540 --> 00:05:57,760
!أجل! اليوم سوفَ نعد أرز مقلي

73
00:05:59,300 --> 00:06:00,670
ما-ماذا؟

74
00:06:01,220 --> 00:06:02,470
.اعذريني على الضحك

75
00:06:02,720 --> 00:06:06,390
.لقد راودني شعورٌ أنّكِ كنتِ ستعدين طعامًا صينيًّا

76
00:06:07,060 --> 00:06:09,980
،بالاضافة إلى ذلك

77
00:06:10,430 --> 00:06:13,270
،أنا لا أطبخ الأطعمة صينيّة في العادة

78
00:06:13,480 --> 00:06:16,020
.لذا كنتُ آمل أنّ تعلميني

79
00:06:17,070 --> 00:06:19,240
...هذا ما في الأمر إذن

80
00:06:19,780 --> 00:06:22,660
إنّهُ ليسَ طبقًا فاخرًا لتلكَ الدرجة
...لأُعلمكِ كيفيّة اعداده، ولكنّ

81
00:06:24,320 --> 00:06:27,660
فلنبدأ. أيُّمكنكِ مُساعدتي بتقطيع المكونات؟

82
00:06:27,910 --> 00:06:28,790
!بالطبع

83
00:06:30,200 --> 00:06:35,250
،خُذي لحم الخنزير المشوي، الجزر
،الكامبوكو، الكراث والفلفل الأخضر

84
00:06:35,250 --> 00:06:37,750
.وقطعيهم إلى حجم حبات الأرز

85
00:06:38,840 --> 00:06:42,970
.هذا لكي تُطبخ كلّ المكونات بسرعة وبتساوي وبقوامٍ جميل

86
00:06:43,220 --> 00:06:44,760
!حاضر أيّتها المُعلمة

87
00:06:55,600 --> 00:06:56,900
!انتهيت

88
00:06:59,280 --> 00:07:01,030
هل مِن خطبٍ ما؟

89
00:07:01,610 --> 00:07:03,530
.كلّا، كلّا. لا شيء

90
00:07:03,780 --> 00:07:04,910
...حسنًا إذن، الخطوة التاليّة هي

91
00:07:05,530 --> 00:07:08,330
،كنتُ أتسائل ما إذا يُمكنني المُساعدة

92
00:07:08,990 --> 00:07:11,290
ولكنّ لا يجب عليَّ أنّ أتدخّل، صحيح؟

93
00:07:14,370 --> 00:07:16,750
.يجب أنّ أنتظر في صمت

94
00:07:23,170 --> 00:07:24,170
!حسنًا

95
00:07:24,800 --> 00:07:25,800
لا يُمكنه البقاء ساكنًا

96
00:07:27,140 --> 00:07:29,970
.حمّي المقلاة وأضيف بعض الزيت

97
00:07:30,930 --> 00:07:34,440
،اطبخ الجزر على حرارة متوسطة
،وعندما يُصبح نصف مطبوخ

98
00:07:34,440 --> 00:07:37,900
.أضف لحم الخنزير المشوي، الكامبوكو والفلفل الأخضر

99
00:07:38,230 --> 00:07:40,400
،تبلها قليلًا بالملح والفلفل

100
00:07:40,650 --> 00:07:43,150
.ومِن ثُمَّ أخرجها مِن المقلاة وضعها في طبق

101
00:07:47,320 --> 00:07:49,410
.اخفق البيض بشكلٍ منفصل

102
00:07:49,740 --> 00:07:51,910
بعد ذلك، أضف كمية سخية
مِن الزيت في المقلاة

103
00:07:52,160 --> 00:07:54,910
.على حرارة بينَ المتوسطة والمرتفعة، وصب البيض المخفوق

104
00:07:57,580 --> 00:08:00,750
حركهم بشكلٍ جيّد لتصنع قطعًا
.صغيرًا مِن البيض المخفوق

105
00:08:01,050 --> 00:08:02,760
ثُمَّ، قبل أنّ يُطبخ البيض بشكلٍ كامل

106
00:08:02,760 --> 00:08:05,050
،أضف الأرز بينما ما يزال البيض نصف مطهوّ

107
00:08:05,300 --> 00:08:07,680
.وحركها كما لو كنتَ تقطعها باستخدام معلقة خشبيّة

108
00:08:10,100 --> 00:08:13,020
،الآن، أضف باقي المكونات الأُخرى الّتي قمتَ بطبخها بالفعل

109
00:08:13,020 --> 00:08:14,600
،جنبا إلى جنب مع الكراث

110
00:08:15,230 --> 00:08:18,350
.وتبلها ببعض الساكي، الملح والفلفل

111
00:08:18,900 --> 00:08:20,480
،عندما أُفكر بالطعام الصينيّ

112
00:08:20,730 --> 00:08:24,860
يجعلني ذلكَ أرغب في أنّ أُحاول قلب
،الطعام كما يفعلون في المطاعم

113
00:08:25,360 --> 00:08:27,610
.ولكنّ أخشى أنّ تتناثر المكونات في كلّ أرجاء المكان

114
00:08:28,820 --> 00:08:29,780
،كما تعلمين

115
00:08:30,070 --> 00:08:32,950
،حرارة الموقد المنزلي ليست قويّة بما يكفي

116
00:08:33,200 --> 00:08:34,290
،لذلك إذا فعلتيها زيادة عن اللزوم

117
00:08:34,290 --> 00:08:37,790
.حرارة المقلاة ستنخفض، وسيبدأ الطعام بالتمسك

118
00:08:42,960 --> 00:08:45,550
!يحتاج الأرز المقلي أنّ يُطبخ بسرعة على حرارة عاليّة

119
00:08:45,840 --> 00:08:46,840
...لكنّ

120
00:08:47,760 --> 00:08:50,340
!فعلها بهذه الطريقة يجعل الأمر أكثر إثارة

121
00:08:57,430 --> 00:08:59,350
!هذه الرائحة تشعرني بالجوع

122
00:09:00,270 --> 00:09:02,440
!لقد تعلّمتُ الكثير منكِ يا أُختي الكبيرة

123
00:09:04,690 --> 00:09:06,030
!فلنعد طبقًا جانبيًّا الآن

124
00:09:13,160 --> 00:09:15,790
!يا سينباي، شكرًا لكَ على صبرك

125
00:09:16,450 --> 00:09:18,000
!شيءٌ ما رائحتهُ زكيّة

126
00:09:18,290 --> 00:09:19,870
هل عدت في الوقت المناسب؟

127
00:09:22,540 --> 00:09:26,260
.ظننتكَ ستكون مُستريحًا ومُسترخيًّا
أيّنَ كنت؟

128
00:09:27,260 --> 00:09:29,430
،لم أستطع البقاء ساكنًا

129
00:09:29,840 --> 00:09:31,470
.لذا كنتُ أُنظف قليلًا

130
00:09:31,760 --> 00:09:33,930
.يا رين، الغبار يهمّ المكان

131
00:09:38,300 --> 00:09:39,930
!ماذا؟

132
00:09:46,810 --> 00:09:48,230
!هذا يبدو لذيذًا جدًا

133
00:09:48,230 --> 00:09:51,650
!بالطبع يبدو كذلك! فأنا مَن أعددته في النهاية

134
00:09:51,650 --> 00:09:53,940
.وساعدتني ساكورا أيّضًا

135
00:09:55,860 --> 00:09:58,740
!تفضّل وكل رجاءً

136
00:10:04,660 --> 00:10:06,410
!هذا بسيط ولذيذ

137
00:10:06,410 --> 00:10:08,750
.الأرز ليسَ لزجًا، وإنّما جميل وجاف

138
00:10:08,750 --> 00:10:11,170
!ليسَ مِن السهل تحقيق ذلك

139
00:10:15,460 --> 00:10:17,180
!بالطبع

140
00:10:18,430 --> 00:10:22,430
.لستُ واثقة ما إذا يُمكنني اعداده بمثل هذه اللذة

141
00:10:23,140 --> 00:10:25,430
.ولكنّني أود أنّ أصنعه في المرّة القادمة

142
00:10:25,430 --> 00:10:28,480
لذا أرجوكَ قُم بتذوقه وقتها يا سينباي، حسنًا؟

143
00:10:28,480 --> 00:10:31,440
!أخيرًا، بدأت ساكورا بسلك طريق الطعام الصينيّ

144
00:10:31,980 --> 00:10:33,360
...وأيّضًا

145
00:10:34,730 --> 00:10:38,200
!أتمنى أنّ أتعلّم المزيد منكِ يا أُختي الكبيرة

146
00:10:41,570 --> 00:10:43,330
أ-أحقًّا ذلك؟

147
00:10:44,490 --> 00:10:45,620
!أجل

148
00:10:48,080 --> 00:10:49,750
.وجهكِ أحمر يا توساكا

149
00:10:51,290 --> 00:10:53,790
!اخرس! اخرس

150
00:10:56,040 --> 00:10:58,170
!يا إلهي