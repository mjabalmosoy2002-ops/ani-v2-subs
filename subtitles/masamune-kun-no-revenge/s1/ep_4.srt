1
00:00:06,030 --> 00:00:07,780
!إلى اللقاء يا أيجي

2
00:00:14,340 --> 00:00:15,370
...أيجي

3
00:00:20,600 --> 00:00:23,430
.لا أرى سواكِ الآن

4
00:00:25,340 --> 00:00:26,400
...أيجي

5
00:00:31,380 --> 00:00:33,320
.ستتبلّل يا أيجي

6
00:00:33,320 --> 00:00:35,360
،إن فكّرت بأنّها دموعك

7
00:00:35,360 --> 00:00:37,830
.فإنّ التبلّل بالمطر ليس سيّئًا

8
00:00:42,640 --> 00:00:45,630
.فهمت. هنا يخفق قلبها إذًا

9
00:00:45,630 --> 00:00:47,420
.حسنًا، تسجيل

10
00:00:49,100 --> 00:00:51,270
.دعني أستعير بعض المانغا يا أونيتشان

11
00:00:53,630 --> 00:00:55,400
أما تزال تدرس؟

12
00:00:57,270 --> 00:01:00,540
.تنفيذ الانتقام كالدراسة

13
00:02:34,010 --> 00:02:36,280
لا تجمعي معلومات

14
00:02:36,280 --> 00:02:38,560
.خاطئة كهذه ثانيةً

15
00:02:38,560 --> 00:02:40,800
.أنا آسفة يا أكي-ساما

16
00:02:43,100 --> 00:02:44,770
...أداغاكي أكي

17
00:02:44,770 --> 00:02:48,650
.سأجعل من انتقامي حقيقة بخطتي التالية

18
00:02:51,620 --> 00:02:53,730
.حسنًا، هذا كلّ شيء لدرس اليوم

19
00:02:54,040 --> 00:02:57,380
.كل من لديه حصص إضافيّة فليتوجه إلى هناك الآن

20
00:03:07,150 --> 00:03:08,750
أمن الضروري أن تجلس هنا؟

21
00:03:09,000 --> 00:03:10,100
.بالطبع

22
00:03:10,960 --> 00:03:13,670
في هذا العصر عندما كان الصراع بين
المحكمة الإمبراطوريّة الشماليّة

23
00:03:13,670 --> 00:03:16,110
،والمحكمة الإمبراطوريّة الجنوبيّة محتدمًا

24
00:03:16,110 --> 00:03:19,540
.استولت المحكمة الجنوبيّة على كيو عند نقطةٍ ما

25
00:03:19,540 --> 00:03:23,320
.ولكن المحكمة الإمبراطوريّة الشماليّة استطاعت إعادة كيو

26
00:03:23,320 --> 00:03:27,640
،في النهاية، عندما توِّج أشيكاغي يوشيميتسو

27
00:03:27,640 --> 00:03:31,350
.ظلّت المحكمة الإمبراطوريّة الشماليّة تصبح أقوى وأقوى

28
00:03:31,720 --> 00:03:35,700
...نقلوا مكان معيشتهم إلى كيتاكوجي موروماتشي

29
00:03:34,340 --> 00:03:36,000
لِمَ لا تنظر للأمام؟

30
00:03:41,000 --> 00:03:44,010
.لا أرى سواكِ

31
00:03:48,750 --> 00:03:49,970
!الجوّ بارد

32
00:03:54,610 --> 00:03:57,590
.ربّما سأخبر يوشينو بأن تحضر لي مظلّة

33
00:04:00,850 --> 00:04:02,970
،إن اعتبرتها دموعك

34
00:04:03,270 --> 00:04:05,350
.فإنّ التبلّل بالمطر ليس سيّئًا

35
00:04:08,810 --> 00:04:09,380
.إلى اللقاء

36
00:04:09,680 --> 00:04:11,220
!ماكابي

37
00:04:16,350 --> 00:04:18,880
ما رأيك بخطّتي الزاهرة للحب؟

38
00:04:18,880 --> 00:04:21,020
!أحسنت الصنيع تمامًا

39
00:04:25,070 --> 00:04:26,200
مقرف؟

40
00:04:26,200 --> 00:04:28,660
مقرفٌ جدًّا" بعبارة أدقّ"

41
00:04:28,660 --> 00:04:32,200
ا-انتظري! هل هذا ما قالته أداغاكي؟

42
00:04:32,200 --> 00:04:34,930
.أعتقد أنّها قالت هذا 24 مرّة اليوم فقط

43
00:04:34,930 --> 00:04:36,940
!سأقتل هذه العاهرة

44
00:04:36,940 --> 00:04:38,420
.أنا أعتقد ذلك أيضًا

45
00:04:38,650 --> 00:04:41,350
!.استمعي "ستيرويد العين الوردية" عملٌ كلاسيكي

46
00:04:41,350 --> 00:04:43,800
!إنّه ككتاب مقدّس للفتيات

47
00:04:43,800 --> 00:04:46,050
.هذه ليست المشكلة هنا

48
00:04:46,500 --> 00:04:49,330
.حان الوقت لأن تنسحب قليلًا يا قدم الخنزير

49
00:04:49,330 --> 00:04:50,070
ماذا؟

50
00:04:50,890 --> 00:04:52,960
.لا يمكنك الاستمرار بالدفع

51
00:04:53,700 --> 00:04:55,280
.التغيير ضروري

52
00:04:56,410 --> 00:04:57,680
التغيير؟

53
00:04:58,480 --> 00:05:01,750
.عليك أن تكون باردًا جدًّا نحوها في المرّة القادمة

54
00:05:08,650 --> 00:05:10,450
.لقد عدت

55
00:05:10,700 --> 00:05:14,660
إنّك متأخّرة. كم تستغرقين للذهاب إلى المتّجر؟

56
00:05:14,900 --> 00:05:18,300
.أنا آسفة. كانت هناك قطّة ضالّة

57
00:05:18,300 --> 00:05:21,990
.لا أهتمّ بهذا. هيّا، أعطِني

58
00:05:33,820 --> 00:05:34,980
حسنًا، من الصحيح أنّ

59
00:05:35,560 --> 00:05:39,210
البطلة تُدرك مشاعرها عندما
يصبح البطل باردًا نحوها

60
00:05:39,210 --> 00:05:40,690
.هو أكثر المجازات المُعتادة

61
00:05:41,160 --> 00:05:45,010
ولكن ماذا سيحدث لو كنت
باردًا نحوها وكرهتني أكثر؟

62
00:05:45,770 --> 00:05:48,660
أشعر وكأنّي تخلّصت من
.واحدة من تلك الذبابات المزعجة

63
00:05:48,660 --> 00:05:49,990
.ذلك مريح

64
00:06:01,730 --> 00:06:02,630
—مرحبًا يا أداغاكي-سا

65
00:06:02,930 --> 00:06:04,000
.مقرف

66
00:06:04,260 --> 00:06:07,960
!سحقًا! كدت أن أتحدّث إليها عفويًا

67
00:06:08,840 --> 00:06:12,090
.كما قالت معلّمتي، تغيير الأمور مهم

68
00:06:30,630 --> 00:06:33,330
!فعلتها! لقد فعلتها حقًّا

69
00:06:33,330 --> 00:06:35,540
!تجاهلت الأميرة القاسية

70
00:06:36,110 --> 00:06:39,040
قد أكون دمّرت كلّ الجهد أو المحبّة

71
00:06:39,040 --> 00:06:41,320
.التي بنيتها حتّى الآن

72
00:06:43,700 --> 00:06:46,460
.ولكن لا يمكن تغيير ما تم اتّخاذه

73
00:07:01,440 --> 00:07:02,740
!مرحبًا يا ماكابي

74
00:07:02,740 --> 00:07:04,580
هل ستجلس هنا يا ماساموني-كن؟

75
00:07:04,580 --> 00:07:05,900
نعم. هل هذا الكرسي شاغر؟

76
00:07:06,160 --> 00:07:08,250
.آه، أجل. تفضّل

77
00:07:07,380 --> 00:07:08,610
!مرحى

78
00:07:11,650 --> 00:07:13,350
!إلى اللقاء يا ماكابي-كن

79
00:07:13,350 --> 00:07:14,550
.إلى اللقاء غدًا

80
00:07:14,550 --> 00:07:15,780
!مع السلامة

81
00:07:28,300 --> 00:07:29,770
حسنًا، ماذا عن الآن؟

82
00:07:29,770 --> 00:07:32,760
تشتاقين إليّ بشدّة الآن، أليس كذلك؟

83
00:07:39,680 --> 00:07:42,190
!ا-استجابة عكسيّة؟! تمهّلي

84
00:07:49,170 --> 00:07:52,530
أتعنين ألّا أحاول التقرّب بعد يا معلّمتي؟

85
00:08:12,960 --> 00:08:15,780
ماذا لو استمرّ هذا الآن؟

86
00:08:16,080 --> 00:08:18,540
هل كنت في الواقع شخصيّة جزئيّة؟

87
00:08:23,110 --> 00:08:24,210
.ماكابي

88
00:08:30,850 --> 00:08:33,070
باغتتني فجأة بشكلٍ مباشر؟

89
00:08:33,970 --> 00:08:36,030
.أريد التحدّث معك

90
00:08:36,520 --> 00:08:40,130
،إذا كنتِ ستقولين ذلك في هذا الوقت
...ألا يفترض أن يكون ذلك عادةً

91
00:08:41,570 --> 00:08:45,060
...هناك ما أودّ التحدث معك حوله يا ماكابي-كن

92
00:08:45,060 --> 00:08:46,250
!كشيء أقرب إلى هذا؟...

93
00:08:46,940 --> 00:08:50,610
بدل أن تكون خجولة، إنّها
!في وضع الأميرة القاسية الغاضبة

94
00:08:51,680 --> 00:08:53,430
.ر-ربما في وقتٍ آخر

95
00:08:54,760 --> 00:08:56,140
!انتظر

96
00:08:56,460 --> 00:08:58,350
مؤلم! ماذا تفعلين؟

97
00:08:58,620 --> 00:09:02,200
!لا تقل لي هذا! هذا ما أريد أن أسأله أنا

98
00:09:28,750 --> 00:09:30,780
!اتركيني

99
00:09:30,780 --> 00:09:31,920
!لا

100
00:09:32,420 --> 00:09:36,280
هل أنت غبي؟ غبيٌ تمامًا؟
!ما الذي تحاول فعله؟

101
00:09:36,280 --> 00:09:38,180
...تـ-توقّفي! توقّفي

102
00:09:38,520 --> 00:09:40,180
ما هذا؟

103
00:09:38,690 --> 00:09:43,060
!لن أتوقّف! ما الذي يجري؟
!غبي غبي غبي

104
00:09:40,180 --> 00:09:43,110
!كأنّني في قتال أو يتم تهديدي من قِبل متهوّر

105
00:09:43,920 --> 00:09:46,320
هل يعني هذا أنّي لن أستطيع

106
00:09:46,320 --> 00:09:49,160
أن أكون مثل البطل في مانغا الشوجو أبدًا؟

107
00:09:54,570 --> 00:09:56,900
لمَ تتجاهلني؟

108
00:10:01,340 --> 00:10:05,200
.لا أعلم ما يجب أن أفعل

109
00:10:11,030 --> 00:10:15,870
!إنّها تحمرّ خجلًا، أليس كذلك؟

110
00:10:19,830 --> 00:10:23,720
لا، انتظر، انتظر. لا يمكنك الوقوع في حبّ
.أداغاكي أكي خجولة

111
00:10:24,020 --> 00:10:27,100
!أنتِ مذهلة يا معلّمتي! سار الأمر كما قلتِ

112
00:10:27,100 --> 00:10:29,190
.سأقلب الأمور الآن

113
00:10:31,150 --> 00:10:32,140
...أنا

114
00:10:33,110 --> 00:10:37,110
.كنت أنتظرك أن تقولي هذا يا أداغاكي-سان

115
00:10:37,110 --> 00:10:39,450
!ما— أتعني هذا كان عن قصد؟

116
00:10:43,970 --> 00:10:45,120
!هذا شنيع

117
00:10:45,650 --> 00:10:47,380
شـ-شنيع؟

118
00:10:47,380 --> 00:10:50,630
.تلقّيت تعليقًا يقطع كالسكين للتو

119
00:10:50,990 --> 00:10:53,430
أأنتِ متأكّدة أنّ هذا لم يعطِ ناتجًا عكسيًا يا معلّمتي؟

120
00:10:54,840 --> 00:10:55,740
...لا، لحظة

121
00:10:56,470 --> 00:10:59,510
...إنّها تطلق عليّ أشياءً قاسية كـ"شنيع"، ولكن

122
00:11:00,000 --> 00:11:03,330
.إنّك شنيعٌ حقًّا. أنت غير معقول

123
00:11:03,660 --> 00:11:06,060
،مع أنّها تصرخ عليّ، إلّا أنّها لا تبدو سريعة الغضب

124
00:11:06,060 --> 00:11:08,140
.ولكنّها تبدو مضطربة في الواقع

125
00:11:08,500 --> 00:11:11,310
.أعتقد أنّه يفترض بي أن أفعل شيئًا غير معتاد الآن

126
00:11:13,000 --> 00:11:15,330
لمَ قد تفعل شيئًا كهذا؟

127
00:11:16,110 --> 00:11:18,400
—حـ-حسنًا، هذا لأنّني معج

128
00:11:18,400 --> 00:11:20,790
ما الذي يعجبك بي؟

129
00:11:21,350 --> 00:11:22,070
ماذا؟

130
00:11:24,020 --> 00:11:26,380
.كان تقييم علامتي رقم 1 في أبراج الفلك اليوم

131
00:11:25,680 --> 00:11:28,940
هل تريدين لي أن أُبدي الأسباب؟

132
00:11:26,380 --> 00:11:28,410
!مذهل، محظوظة

133
00:11:30,680 --> 00:11:33,070
.لديك وجهٌ جميل، ولكنّك تكرهين الشباب

134
00:11:33,370 --> 00:11:35,840
.لديك جسدٌ رائع، ولكنّك شرهة جدًّا

135
00:11:36,580 --> 00:11:39,010
.إنّك ذكيّة ولكن غافلة

136
00:11:39,260 --> 00:11:42,470
وتسألين ما يعجبني بأميرة قاسية كهذه؟

137
00:11:47,600 --> 00:11:50,310
!لم أفكّر بذلك حقًّا

138
00:11:50,730 --> 00:11:52,890
.نعم، ربّما لا ينبغي لي قول ذلك

139
00:11:54,750 --> 00:11:56,150
ما-ما يعجبني؟

140
00:11:56,370 --> 00:11:59,280
!كـ-كل شيء! كل شيءٍ بك

141
00:11:59,540 --> 00:12:01,240
ما-ما الذي يعنيه هذا؟

142
00:12:01,510 --> 00:12:03,580
!إنّك الأفضل حقًّا

143
00:12:03,580 --> 00:12:06,700
!أوه، آسف! تذكّرت أنّ هناك ما يجب أن أفعله

144
00:12:07,670 --> 00:12:08,910
!ماكابي

145
00:12:08,910 --> 00:12:11,830
ماساموني-كن؟! لماذا تهرب؟

146
00:12:11,830 --> 00:12:14,330
!استطعت أن تجعلها تستجيب إلى هذه الدرجة

147
00:12:14,330 --> 00:12:16,380
ما الذي ستفعله بعد هذا؟

148
00:12:16,660 --> 00:12:18,130
!لا أعلم

149
00:12:18,540 --> 00:12:21,170
!هيّا يا معلّمتي

150
00:12:23,690 --> 00:12:24,550
هل أنت غبي؟

151
00:12:24,550 --> 00:12:25,790
!لا تنعتني بالغبي

152
00:12:25,790 --> 00:12:28,740
.لم أتوقّع أنّك لم تفكّر حتّى بهذا

153
00:12:28,740 --> 00:12:30,680
!لا تفقدي الأمل فيّ! هذا يغضبني

154
00:12:31,060 --> 00:12:33,390
!علينا أن نفكر بشيء! أيّ شيء

155
00:12:33,390 --> 00:12:35,920
!هيّا، أعطِني شيئًا سيجعل قلبها يخفق عندما تسمعه

156
00:12:36,190 --> 00:12:39,360
.أنا لستُ قطّة آليّة

157
00:12:39,600 --> 00:12:41,800
أعلم. ماذا إن أخبرتها أنّها جميلة؟

158
00:12:41,800 --> 00:12:42,570
.لا

159
00:12:42,840 --> 00:12:44,670
!ماذا؟ لا؟ لماذا؟

160
00:12:45,270 --> 00:12:47,510
!لا تتنهّدي هنا

161
00:12:49,880 --> 00:12:51,120
.ليس هنالك طريقة أفضل من الرسالة

162
00:12:51,680 --> 00:12:54,020
.إن حاولت قوله شفهيًا فإنّي سأخطئ على الأرجح

163
00:12:54,020 --> 00:12:56,190
.أفكار المعلّمة رائعة

164
00:12:58,230 --> 00:12:59,290
ما الذي تفعله؟

165
00:13:02,760 --> 00:13:05,800
هل يمكنك قراءة هذه؟

166
00:13:05,800 --> 00:13:08,070
.إنّها تقول ما أشعر به الآن

167
00:13:21,020 --> 00:13:23,580
.إنّي أكرهك حقًّا

168
00:13:34,130 --> 00:13:36,560
—يبدو أنّك تسيئين الفهم. أنا

169
00:13:36,560 --> 00:13:37,580
!اصمت

170
00:13:38,100 --> 00:13:39,830
!لا يمكنك خداعي

171
00:13:39,830 --> 00:13:43,630
!أدركت حقيقة أنانيّتك منذ وقتٍ طويل

172
00:13:49,360 --> 00:13:51,010
!أداغاكي-سان؟

173
00:13:53,100 --> 00:13:54,330
هل هنالك خطبٌ ما؟

174
00:13:56,110 --> 00:13:57,480
...أيّتها المعلّمة

175
00:13:59,520 --> 00:14:01,570
!لم أعد أعرف ما الذي يجري

176
00:14:01,570 --> 00:14:04,590
!قالت فجأةً أنّها تكرهني وهربت

177
00:14:05,610 --> 00:14:08,520
.وإنّها تتصرّف بشكلٍ مختلفٍ عن البارحة تمامًا

178
00:14:08,820 --> 00:14:10,370
ما الذي يجري؟

179
00:14:10,740 --> 00:14:14,730
اعتقدت أنّ الأمور كانت تجري
!على ما يرام البارحة. سحقًا

180
00:14:16,280 --> 00:14:18,900
.حسنًا. اترك الأمر لي

181
00:14:18,900 --> 00:14:22,000
!هل لديك فكرة عمّا يجري؟ أخبريني يا معلّمة

182
00:14:23,200 --> 00:14:25,670
قلت لك اترك الأمر لي، أليس كذلك؟

183
00:14:27,980 --> 00:14:31,990
إنّك لا تستطيع حتّى شرح ما تحبّه
.بأكي-ساما الآن

184
00:14:32,380 --> 00:14:35,760
.هذا يعني أنّ لا شيء تقوله لها سيصل لداخلها

185
00:14:37,200 --> 00:14:39,150
...أنا-أنا

186
00:14:40,800 --> 00:14:44,200
.لا تقلق. سأحرص على أن تستطيع الخروج معها

187
00:14:50,380 --> 00:14:52,830
هل تُخبر قدم الخنزير ألّا يتدخّل بالأمر؟

188
00:14:54,360 --> 00:14:56,490
.سحقًا يا ماكابي ماساموني

189
00:14:56,490 --> 00:14:59,880
!لمن هذا الانتقام، لي، أليس كذلك؟

190
00:15:00,590 --> 00:15:04,180
لن أحقّق انتقامي إن بقيت هنا
.فحسب وكأنّي أنتظر أن يتمّ إطعامي

191
00:15:07,290 --> 00:15:08,850
!هذا غير مقبول

192
00:15:21,450 --> 00:15:23,810
.هذه المرّة الأولى التي أغيب فيها عن درس

193
00:15:23,810 --> 00:15:27,140
هـ-هل سأكون في ورطة؟

194
00:15:27,140 --> 00:15:28,280
!أنت

195
00:15:28,880 --> 00:15:31,110
!أنا آسفة! أنا آسفة! أنا آسفة

196
00:15:31,970 --> 00:15:34,770
!سحقًا يا كوكّي! عد إلى هنا

197
00:15:42,020 --> 00:15:45,690
لا يمكنني تحمّل هذا! لمَ أنا منزعجة للغاية؟

198
00:15:48,040 --> 00:15:49,720
...هذا كلّه

199
00:15:49,980 --> 00:15:52,020
!إنّك الأفضل حقًّا

200
00:15:52,020 --> 00:15:55,220
!أوه، آسف! تذكّرت أنّ هناك ما يجب أن أفعله

201
00:15:56,200 --> 00:15:57,430
!ماكابي

202
00:16:01,360 --> 00:16:03,350
!نسيتَ هذه

203
00:16:03,650 --> 00:16:06,320
!هيّا يا معلّمتي

204
00:16:07,290 --> 00:16:08,780
"معلّمتي؟"

205
00:16:09,550 --> 00:16:12,900
.لم أتوقّع أنّك لم تفكّر حتّى بهذا

206
00:16:13,240 --> 00:16:15,070
!لا تفقدي الأمل فيّ! هذا يغضبني

207
00:16:15,500 --> 00:16:17,860
!علينا أن نفكر بشيء! أيّ شيء

208
00:16:17,860 --> 00:16:20,330
!هيّا، أعطِني شيئًا سيجعل قلبها يخفق عندما تسمعه

209
00:16:20,650 --> 00:16:23,030
ماذا يعني بـ"كلّ شيء"؟

210
00:16:20,860 --> 00:16:23,690
.لستُ قطّة آليّة

211
00:16:23,030 --> 00:16:25,750
!لا بدّ وأنّه كان يقول هذا لكلّ الفتيات! ذلك الوغد

212
00:16:27,070 --> 00:16:28,820
...متى قام هو ويوشينو

213
00:16:30,570 --> 00:16:33,260
...بعد أن سألني للخروج معه مرّاتٍ عدّة

214
00:16:33,520 --> 00:16:35,720
!علمتُ أنّ الأمر سيصبح هكذا

215
00:16:38,300 --> 00:16:39,060
.أكي-ساما

216
00:16:47,550 --> 00:16:49,510
لمَ لم تخبريني؟

217
00:16:55,700 --> 00:16:56,940
هل تريدين شيئًا؟

218
00:16:56,940 --> 00:16:59,670
يمكنني أخذ القرار بنفسي
.ما إن كنت أريد الذهاب إلى الصفّ

219
00:16:59,670 --> 00:17:01,410
.يمكنك العودة إلى الصفّ

220
00:17:01,680 --> 00:17:05,700
.كنتُ أقابل ماكابي ماساموني-كن يا أكي-ساما

221
00:17:08,710 --> 00:17:10,650
.كان يحتاج أحدًا للحديث معه

222
00:17:11,230 --> 00:17:12,870
حقًّا؟ وإذًا؟

223
00:17:13,570 --> 00:17:15,840
.لقد راسلني واتّصل بي أيضًا

224
00:17:15,840 --> 00:17:16,970
وإذًا؟

225
00:17:16,970 --> 00:17:20,560
.لا يهمّني ما إن كنتِ أنتِ وماكابي قريبان

226
00:17:21,380 --> 00:17:23,060
هل أنتِ حزينة؟

227
00:17:23,060 --> 00:17:26,310
هذا مستحيل. لمَ قد أحزن
على ذلك النرجسي المغرور؟

228
00:17:30,330 --> 00:17:32,680
هل هذا كلّ شيءٍ حقًّا؟

229
00:17:41,990 --> 00:17:44,120
...هذه الفتاة حقًّا

230
00:17:44,350 --> 00:17:46,340
،إنّها متبلّدة عادةً، ولكن بشكلٍ ما

231
00:17:46,340 --> 00:17:48,890
.تكون دوماً واعية جدّاً عندما يتعلّق الأمر بأمور كهذه

232
00:17:54,060 --> 00:17:55,710
!هـ-هذا مستحيل

233
00:17:56,200 --> 00:17:58,640
.يستحيل أن أحزن من أجل صبي

234
00:17:59,140 --> 00:18:01,970
.لن يحدث هذا ثانيةً

235
00:18:04,660 --> 00:18:08,450
.لأنّ ما يزال هناك شيء أؤمن به بشكلٍ كبير

236
00:18:10,300 --> 00:18:12,650
!كل الفتيان كاذبون

237
00:18:13,000 --> 00:18:15,570
...إنّهم أنانيّون ويفعلون ما يشاؤون، وفي النهاية

238
00:18:16,230 --> 00:18:18,110
.يتصرّفون وكأنّ شيئًا لم يحدث

239
00:18:19,390 --> 00:18:21,130
.قد يكون ذلك صحيحًا

240
00:18:22,140 --> 00:18:24,940
...نعم، إنّه كذلك. لهذا

241
00:18:27,270 --> 00:18:30,570
.يستحيل أن أحبّ شابًّا

242
00:18:31,280 --> 00:18:34,280
لن أحزن على حقيقة أنّ ماكابي ماساموني كان

243
00:18:34,280 --> 00:18:36,410
،يقابل يوشينو بلا علمي

244
00:18:36,760 --> 00:18:39,720
.ناهيك عن الوقوع بحبّه

245
00:18:39,980 --> 00:18:41,550
!لا شكّ في ذلك

246
00:18:44,470 --> 00:18:46,530
.لا بأس يا أكي-ساما

247
00:18:46,880 --> 00:18:49,020
.إنّه لا يرى سواكِ

248
00:18:51,590 --> 00:18:54,690
أنتِ تحبّينه أيضًا، أليس كذلك؟

249
00:19:09,790 --> 00:19:13,090
.هـ-هـ-هذا غير صحيح

250
00:19:13,090 --> 00:19:15,250
.هذا غير صحيح طبعًا

251
00:19:18,500 --> 00:19:20,380
!انتظري يا يوشينو

252
00:19:23,490 --> 00:19:26,140
يا إلهي، إلى أين ذهبت؟

253
00:19:26,750 --> 00:19:28,990
!أنا جائعة يا أمّي

254
00:19:34,780 --> 00:19:38,160
...لمَ أنا غاضبة؟ أنا

255
00:19:40,510 --> 00:19:41,920
.فظيعة

256
00:19:43,060 --> 00:19:44,940
.إنّني فظيعة

257
00:19:45,240 --> 00:19:48,540
.لطالما جرحتُ الناس كي لا أنجرح أنا

258
00:19:48,920 --> 00:19:51,110
،إن كان ذلك يعني ألّا أمرّ بذلك ثانيةً

259
00:19:51,110 --> 00:19:53,820
.فإنّي أُفضّل أن أُكره وأن يبقى الناس بعيدين عنّي

260
00:19:53,820 --> 00:19:56,130
.لهذا فعلتُ كلّ ما فعلتُه

261
00:19:58,450 --> 00:20:00,630
لمَ أتذكّر الماضي الآن؟

262
00:20:03,220 --> 00:20:04,720
.لا أعلم

263
00:20:05,140 --> 00:20:09,140
.لا أعلم ما إن كان يحبّني

264
00:20:09,640 --> 00:20:12,730
...وأنا

265
00:20:16,570 --> 00:20:17,520
!توقّفي

266
00:20:36,150 --> 00:20:38,840
...اعتقدت أنّي وجدتك أخيرًا، ثم

267
00:20:39,360 --> 00:20:41,970
!ما الذي كنت تفكّرين به؟ كان الضوء أحمرًا

268
00:20:43,740 --> 00:20:46,130
!لـ-ليس وكأنّ ذلك يهمّك

269
00:20:46,130 --> 00:20:47,220
!لا تعبثي معي

270
00:20:47,640 --> 00:20:51,400
هذا غير صحيحٍ طبعًا! لا أعلم
!ما الذي أفعله من دونك

271
00:20:54,780 --> 00:20:57,190
هل هذا كلّ شيء حقًّا؟

272
00:21:01,410 --> 00:21:05,110
.أ-أداغاكي-سان؟ آسف، قد أكون تماديت في الكلام

273
00:21:09,340 --> 00:21:10,590
...أنا

274
00:21:15,390 --> 00:21:16,500
...أنا

275
00:21:23,470 --> 00:21:26,680
أنا آسفة حقًّا! هل أنتِ بخير؟

276
00:21:30,290 --> 00:21:31,640
هل جُرحتِ؟

277
00:21:32,160 --> 00:21:34,350
.لا، أنا بخير

278
00:21:34,640 --> 00:21:37,290
.فهمت. حمدًا لله

279
00:21:41,260 --> 00:21:42,260
...يا إلهي

280
00:21:42,260 --> 00:21:44,620
...أبانا الساكن في السماء

281
00:21:44,620 --> 00:21:46,240
.لا أصدّق هذا

282
00:21:46,240 --> 00:21:48,710
.لا أصدّق أنّ هذا قد يحدث هنا

283
00:21:54,220 --> 00:21:56,230
.كنت أتوق لرؤيتك

284
00:22:05,170 --> 00:22:07,010
من هذه؟