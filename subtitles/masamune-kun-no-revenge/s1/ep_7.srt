1
00:00:01,860 --> 00:00:04,940
!مرحى، انتهينا

2
00:00:07,520 --> 00:00:09,400
!انتهينا يا ماكابي-كن

3
00:00:09,860 --> 00:00:11,920
هل تمكّنت من النجاة بشكلٍ ما يا كوجورو؟

4
00:00:11,920 --> 00:00:14,330
!نعم! إنّها الإجازة الصيفيّة أخيرًا

5
00:00:14,330 --> 00:00:15,870
هل لديك أيّ خطط؟

6
00:00:15,870 --> 00:00:18,200
...أنا؟ أنا

7
00:00:21,880 --> 00:00:23,210
!ماكابي

8
00:00:23,500 --> 00:00:24,830
!ها هي ذي

9
00:00:26,040 --> 00:00:27,880
ما الذي تفكّر به؟

10
00:00:27,880 --> 00:00:30,670
!لا تستخدم مكتبي كحاوية قمامة

11
00:00:30,670 --> 00:00:32,510
.أنا متفاجئ من معرفتك أنّه كان أنا

12
00:00:32,510 --> 00:00:35,470
.أيّ أحد سيلاحظ عندما تكتب شيئًا كهذا

13
00:00:35,740 --> 00:00:38,800
.نعم. إجازة صيفيّة ليس لدينا حصص دراسيّة بها

14
00:00:38,800 --> 00:00:44,140
لا أستطيع القلق بشأن المنطق
.ونحن بلا حصص دراسيّة لأربعين يوم

15
00:00:44,410 --> 00:00:46,030
.سأنتهج أسلوب اللعب القوي

16
00:00:47,150 --> 00:00:50,110
.هذا ما تعلّمته من فوجينوميا نيكو

17
00:00:50,850 --> 00:00:52,820
...هذا مؤسفٌ لك

18
00:00:53,240 --> 00:00:56,870
.سأقضي الصيف في قصر جزيرتنا

19
00:00:59,510 --> 00:01:00,790
...شوري-كن

20
00:01:01,100 --> 00:01:03,300
.أنت مدعو

21
00:01:06,130 --> 00:01:08,360
!ماذا؟

22
00:01:09,120 --> 00:01:11,260
أ-أنا؟

23
00:01:11,260 --> 00:01:13,090
ألن يكون ذلك ممتعًا يا شوري-كن؟

24
00:01:13,390 --> 00:01:16,720
!إنّها تفعل هذا لإغاظتي. لإغاظتي شخصيًّا

25
00:01:17,600 --> 00:01:19,430
...أ-أنا

26
00:01:19,890 --> 00:01:22,310
!لا أريد الذهاب ما لم يكن معي ماكابي-كن

27
00:01:22,590 --> 00:01:24,560
.أحسنت يا كوجورو

28
00:01:24,560 --> 00:01:26,560
.صحيح يا أداغاكي-سان

29
00:01:26,860 --> 00:01:29,950
.أنا وكوجورو-كيون واحد

30
00:01:29,950 --> 00:01:33,070
إن كنت ستصطحبين كوجورو
.فتوقّعي قدومي أيضًا

31
00:01:33,620 --> 00:01:34,280
—ما

32
00:01:35,340 --> 00:01:38,740
إن كان ماساموني-ساما سيذهب
.فسأرافقه أيضًا

33
00:01:38,740 --> 00:01:42,240
ماذا؟ هذا لطيف جدًّا! الشاطئ؟

34
00:01:42,240 --> 00:01:44,830
.أريد السباحة إلى أن أتقيّأ

35
00:01:44,830 --> 00:01:46,210
!أشعر بالغيرة

36
00:01:46,720 --> 00:01:49,170
ما الذي ستفعلينه الآن يا أداغاكي-سان؟

37
00:01:49,170 --> 00:01:51,450
،هل ستعتنين بنا جميعًا

38
00:01:51,450 --> 00:01:55,420
أو تقضين وقتك في شاطئٍ خاص وحيدةً؟

39
00:01:55,420 --> 00:01:57,130
.هذه هي خياراتك

40
00:02:00,920 --> 00:02:01,640
...حس

41
00:02:01,640 --> 00:02:04,630
!حسنًا

42
00:02:06,600 --> 00:02:08,310
وهكذا

43
00:02:09,060 --> 00:02:12,980
نحن متوجّهون إلى جزيرة معزولة
.تسمّى جزيرة تسونادي

44
00:03:44,560 --> 00:03:45,450
!مرحى

45
00:03:45,720 --> 00:03:47,710
!هذه فرصتي

46
00:03:47,710 --> 00:03:48,760
.يا قدم الخنزير

47
00:03:50,560 --> 00:03:51,830
أين الأميرة القاسية؟

48
00:03:51,830 --> 00:03:53,850
.ما تزال تأكل

49
00:03:54,790 --> 00:03:57,000
،بوضع موضوع أكي-ساما جانبًا

50
00:03:57,370 --> 00:04:00,710
.كنت أستطلع أمر فوجينوميا نيكو

51
00:04:01,000 --> 00:04:02,840
.لا يمكنني إيجاد نقطة ضعف

52
00:04:02,840 --> 00:04:05,840
.لا يمكنني معرفة سبب هوسها بك

53
00:04:07,000 --> 00:04:08,680
...إذًا منطقيًّا

54
00:04:09,880 --> 00:04:12,100
.يوجد قارب هناك أيضًا

55
00:04:13,350 --> 00:04:15,770
.لا تقلقي على أيّ حال يا معلّمتي

56
00:04:15,770 --> 00:04:20,250
مهما يحدث، فإنّ هدفي الوحيد
.هو الانتقام من أداغاكي أكي

57
00:04:21,320 --> 00:04:26,070
لا مشكلة لدي بقدوم واحدة أو اثنتين
.من فوجينوميا نيكو بكل ما أوتيت من قوة

58
00:04:26,380 --> 00:04:28,870
لا ينبغي أن تكون مسترخيًا
.حيال ذلك الآن

59
00:04:28,870 --> 00:04:31,200
هل هي غاضبة؟

60
00:04:33,200 --> 00:04:34,460
،قدم الخنزير

61
00:04:34,860 --> 00:04:38,210
إن لم تفعل شيئًا حيال أكي-ساما
...في هذه الرحلة

62
00:04:38,210 --> 00:04:39,920
...سأخبر أكي-ساما

63
00:04:40,520 --> 00:04:42,880
.بكلّ ما حدث حتى الآن

64
00:04:51,380 --> 00:04:52,800
لحظة، ماذا؟

65
00:04:52,800 --> 00:04:54,890
ماذا تعني بأنّي لم أكن شيئًا مهمّا؟

66
00:04:55,320 --> 00:04:58,860
أتعني أنّ ذلك لا يعني
...أنّنا كنّا نتواعد؟ ولهذا

67
00:04:58,860 --> 00:05:02,860
—انتظر! استمع! كينجي! كين

68
00:05:08,140 --> 00:05:11,080
!ذلك الأناني الوغد

69
00:05:11,080 --> 00:05:13,020
ما الذي كان سيّئًا بي؟

70
00:05:13,020 --> 00:05:15,880
لأنّ مظهري مظهر عشيقة؟
لأنّي أتغيّر كثيرًا عندما أشرب؟

71
00:05:15,880 --> 00:05:17,820
لأنّي أغنّي ديث ميتال في الكاريوكي؟

72
00:05:17,820 --> 00:05:21,000
.وصلت السيّدة الشابّة يا يويساكي-سان

73
00:05:22,790 --> 00:05:25,800
.حسنًا، سآتي حالًا

74
00:05:31,060 --> 00:05:32,430
!خلّاب

75
00:05:32,750 --> 00:05:34,640
أهكذا تبدو القصور؟

76
00:05:34,640 --> 00:05:37,390
!تمكّني من البقاء في مكانٍ كهذا أمر رائع

77
00:05:37,790 --> 00:05:40,360
—بالفعل، إنّه أفخم ممّا

78
00:05:40,360 --> 00:05:43,350
.لا، لا. لا وقت لديّ للذهول

79
00:05:44,680 --> 00:05:46,840
هل هي جادة بإخبارها عن كلّ شيء؟

80
00:05:46,840 --> 00:05:49,600
.هذا غير عادل

81
00:05:50,430 --> 00:05:53,560
.يُفترض أن تكون يويساكي-سان وصلت قبلنا

82
00:05:53,560 --> 00:05:55,260
يويساكي-سان؟

83
00:05:55,260 --> 00:05:56,780
.سكرتيرة والدي

84
00:05:56,780 --> 00:06:01,420
بما أنّ والد يوشينو كان مشغولًا
.فإنّها أتت كمرافق

85
00:06:02,400 --> 00:06:05,350
الاهتمام بسيّدة المنزل الشابّة
.هو جزء من وظيفة السكرتيرة

86
00:06:05,760 --> 00:06:08,220
...عزيزتي أكي-ساما الظريفة

87
00:06:08,710 --> 00:06:11,930
.أنتِ فقط من يمكنها أن تريحني الآن

88
00:06:13,200 --> 00:06:14,460
.افتحا الباب من فضلكما

89
00:06:17,990 --> 00:06:19,760
.لا بدّ أنّها كانت رحلةً طويلة

90
00:06:19,760 --> 00:06:22,150
.كنّا بانتظارك يا أكي-ساما

91
00:06:22,560 --> 00:06:24,300
!إنّها جميلةٌ جدًّا

92
00:06:24,300 --> 00:06:25,870
!تبدو كممثّلة

93
00:06:25,870 --> 00:06:28,280
.سنكون تحت رعايتك يا يويساكي-سان

94
00:06:28,720 --> 00:06:31,160
.لن تكون مشكلةً إطلاقًا

95
00:06:31,740 --> 00:06:34,710
.سمعت أنّك ستجلبين الكثير من الأصدقاء

96
00:06:35,840 --> 00:06:36,810
!وفتىً أيضًا؟

97
00:06:37,640 --> 00:06:39,830
سيّدتي، ما هذا؟

98
00:06:40,910 --> 00:06:43,180
.أنا فتى أيضًا

99
00:06:44,290 --> 00:06:46,880
.سأخبر أكي-ساما بكلّ شيء

100
00:06:46,880 --> 00:06:49,840
.لا يمكنني القلق حيال المظاهر بعد الآن

101
00:06:49,840 --> 00:06:53,380
...إن لم أجعل أداغاكي تقع بحبّي هنا، أنا

102
00:06:50,720 --> 00:06:53,640
...حـ-حسنًا

103
00:06:55,220 --> 00:06:57,640
،إنّها أميرة قاسية تكشّر أنيابها ضد الرجال

104
00:06:57,640 --> 00:07:00,040
من يكون هذا يا سيّدتي؟

105
00:06:57,640 --> 00:07:00,970
ولكنّها تحبّ أن تبدو جيّدة
.أمام الفتيات الأخريات

106
00:07:00,040 --> 00:07:01,480
...حسنًا

107
00:07:02,470 --> 00:07:05,690
هذه خطوة فيها الكثير من المجازفة
.ولكن ليس بيدي إلّا المواجهة

108
00:07:06,210 --> 00:07:07,000
!نعم

109
00:07:07,880 --> 00:07:10,450
.أنا أواعد أداغاكي-سان

110
00:07:13,990 --> 00:07:16,580
.مسرورٌ لمقابلتك

111
00:07:18,910 --> 00:07:20,600
!هذا يؤلم

112
00:07:20,600 --> 00:07:23,040
!لأنّ ما قلته أثبتَ أنّ عقلك فاسد

113
00:07:23,040 --> 00:07:24,810
أين المشكلة؟ هذا ليس بالأمر الجلل

114
00:07:24,810 --> 00:07:27,190
بل هو كذلك! إنّه أمر جلل

115
00:07:27,670 --> 00:07:29,660
...بالطبع

116
00:07:30,420 --> 00:07:33,520
إن كنتِ ما تزالين تتحدّثين
،عن مدى كرهكِ للرجال

117
00:07:33,520 --> 00:07:35,800
.فسأكون قلقة

118
00:07:36,500 --> 00:07:39,060
أ-أتعتقدين ذلك؟

119
00:07:39,060 --> 00:07:42,400
بالطبع! لا يهم إن قلتِ ذلك
،في المرحلة الابتدائيّة أو الإعداديّة

120
00:07:42,400 --> 00:07:46,010
ولكن إن كنتِ ما تزالين تقولين أنّك
،تكرهين الرجال في الثانويّة

121
00:07:46,010 --> 00:07:49,180
.المعذرة على ذلك، ولكنّ سيكون ذلك محرجًا للغاية

122
00:07:49,980 --> 00:07:51,720
.ولكنّي أشعر بالارتياح الآن

123
00:07:51,720 --> 00:07:54,730
.لديك حبيبٌ رائعٌ كهذا

124
00:07:54,730 --> 00:07:57,260
!كان ينبغي أن تخبريني

125
00:07:57,260 --> 00:07:59,040
...صـ-صحيح

126
00:07:59,470 --> 00:08:03,000
ينبغي أن يساعد هذا مع أمر
.انعدام نمو ثديك أيضًا

127
00:08:05,960 --> 00:08:09,840
.ا-اعتقدت أنّه شيء لا يستحق الذكر

128
00:08:10,190 --> 00:08:14,220
.بالله عليك. من الصعب إيجاد حبيب بهذه الوسامة

129
00:08:14,220 --> 00:08:15,550
.إنّه عادي

130
00:08:16,800 --> 00:08:17,930
.هيّا يا ماكابي

131
00:08:17,930 --> 00:08:18,400
ماذا؟

132
00:08:18,400 --> 00:08:20,200
أردت الذهاب للسباحة، أليس كذلك؟

133
00:08:22,260 --> 00:08:24,350
...ذلك الطفل

134
00:08:25,250 --> 00:08:28,360
.حمدًا لله أنّك مهتمّة جدًّا بالمظاهر

135
00:08:28,360 --> 00:08:31,230
!وخطأ من هذا باعتقادك؟

136
00:08:31,230 --> 00:08:34,470
.أنتِ اخترتِ هذا بنفسك يا أداغاكي-سان

137
00:08:36,570 --> 00:08:41,540
على الرغم من أنّ أداغاكي أكي هي الأميرة القاسية التي
،تلقّب الشبّانَ ألقابًا فظيعة

138
00:08:41,540 --> 00:08:45,560
اختارت أن تحافظ على مظهرها
.أمام الفتيات الأخريات

139
00:08:46,250 --> 00:08:48,260
،كانت تلك حركةً بها مجازفة كبيرة

140
00:08:48,660 --> 00:08:50,710
.ولكنّي توقّعت الوضع بشكلٍ صحيح

141
00:08:51,520 --> 00:08:54,720
الحمدلله أنّ تلك السكرتيرة
.الجميلة لم تكن قاسيةً أيضًا

142
00:08:54,720 --> 00:08:57,420
...لو لم تقل شيئًا غريبًا

143
00:08:57,420 --> 00:08:58,950
.يويساكي-سان

144
00:09:08,310 --> 00:09:11,480
اسمع يا ماكابي، هذا يسري أثناء
.وجودنا في هذه الجزيرة فقط

145
00:09:11,800 --> 00:09:12,330
ماذا؟

146
00:09:12,330 --> 00:09:13,580
،هذا تظاهر فحسب

147
00:09:13,580 --> 00:09:15,990
أنت تعلم ما الذي سيحدث
.لو فعلتَ شيئًا لا داعي له

148
00:09:16,680 --> 00:09:19,930
.حسنًا، فهمت! لا مشكلة

149
00:09:21,520 --> 00:09:25,330
.بالطبع، لن أدع الأمر ينتهي كتظاهر فحسب

150
00:09:27,040 --> 00:09:32,090
!انظروا! جسدي البرّاق تحت أشعة الشمس

151
00:09:33,010 --> 00:09:34,510
!إنّه البحر

152
00:09:34,510 --> 00:09:36,160
!هجوم

153
00:09:36,160 --> 00:09:36,980
ماذا؟

154
00:09:38,310 --> 00:09:40,220
!شعورٌ رائع

155
00:09:38,930 --> 00:09:40,840
.إنّها بغاية الحيوية

156
00:09:40,840 --> 00:09:44,390
!الماء رائع! تعالوا جميعًا

157
00:09:40,840 --> 00:09:44,390
.قد تكون دلفينًا أو غطّاسة في حياتها السابقة

158
00:09:44,900 --> 00:09:47,560
.أنت تبدو رائعًا كالعادة يا ماكابي-كن

159
00:09:47,560 --> 00:09:49,480
.أنا مسرورٌ من أجلك يا كوجورو

160
00:09:50,110 --> 00:09:53,320
تمكّنت من تجنّب ارتداء إحدى
.ثياب السباحة التي اختارتها لك ممثّلة الصفّ

161
00:09:50,850 --> 00:09:53,320
!لا

162
00:09:53,320 --> 00:09:55,950
!بالطبع لا! أنا صبي

163
00:09:55,950 --> 00:09:58,060
.سأرتدي ملابس صبيان بالطبع

164
00:09:58,060 --> 00:09:59,530
لمَ ترتدي قميصًا إذًا؟

165
00:10:00,980 --> 00:10:02,410
.لكي لا تحرقني الشمس

166
00:10:02,410 --> 00:10:04,750
أليس رائعًا؟

167
00:10:04,750 --> 00:10:06,960
...فهمت

168
00:10:06,960 --> 00:10:09,630
.عليك أخذ جميع الاحتياطات

169
00:10:09,900 --> 00:10:12,680
.الأشعة فوق البنفسجية مضرة لبشرتك

170
00:10:13,990 --> 00:10:16,090
...صحيح يا ماساموني-ساما

171
00:10:16,590 --> 00:10:18,240
أتمانع القدوم إلى هناك

172
00:10:18,240 --> 00:10:21,030
وتساعدني على وضع حاجز الشمس؟

173
00:10:22,110 --> 00:10:24,650
!جسد فتاة

174
00:10:24,650 --> 00:10:28,770
،لا، لحظة! إن رأت يويساكي-سان هذا

175
00:10:29,100 --> 00:10:33,160
الفرصة التي حصلت عليها
"من خطّة "نحن نتواعد

176
00:10:33,160 --> 00:10:34,310
!ستذهب سدى

177
00:10:34,690 --> 00:10:38,500
...فوجينوميا-سان، أنا

178
00:10:42,870 --> 00:10:43,910
.يا إلهي

179
00:10:44,200 --> 00:10:47,480
هل يمكنك تجربة خدعك الرخيصة
في مكانٍ آخر؟

180
00:10:47,870 --> 00:10:51,610
.سمعتِ ماكابي. نحن نتواعد

181
00:10:51,610 --> 00:10:53,950
.توقّفي عن التدخّل

182
00:10:53,950 --> 00:10:57,840
...يـ-ياه! لم أتوقّع أنّها من سيفعل هذا

183
00:10:59,340 --> 00:11:02,940
يبدو أنّك لستِ مستاءة
.كما يظن الناس يا أكي-ساما

184
00:11:02,940 --> 00:11:05,010
.أنا أقول هذا لمصلحتك

185
00:11:05,290 --> 00:11:07,480
،أعتذر على جرّك لهذا

186
00:11:07,480 --> 00:11:09,480
.ولكن إن رأت يويساكي-سان هذا، فقد تسيء الفهم

187
00:11:10,120 --> 00:11:13,190
،سيكون ماكابي اللّعوب الحائر

188
00:11:13,580 --> 00:11:15,530
.وأنتِ من سيتلاعب بكِ

189
00:11:15,940 --> 00:11:19,820
لن يبدو ذلك جيّدًا بالنسبة
.لعائلة فوجينوميا أيضًا

190
00:11:21,640 --> 00:11:23,390
.حسنًا

191
00:11:23,390 --> 00:11:27,860
سأنسحب في الوقت الحالي
.لأنّك تمكّنت أن تبقي هادئة

192
00:11:28,340 --> 00:11:30,360
.أنا مسرورة لتفهمك السريع

193
00:11:33,830 --> 00:11:35,790
إلى أين تذهبين؟

194
00:11:36,230 --> 00:11:39,150
.مكانٌ هادئ. تعال معي

195
00:11:39,150 --> 00:11:41,010
أنت حبيبي، أليس كذلك؟

196
00:11:42,970 --> 00:11:46,150
ما الذي يجري؟

197
00:11:56,900 --> 00:11:59,560
.نحن بمفردنا تمامًا الآن

198
00:12:03,200 --> 00:12:04,420
...ماكابي

199
00:12:07,240 --> 00:12:10,660
.لا يهمّ ما يكون، ولكن اجلب لي بعض الكربوهيدرات

200
00:12:12,770 --> 00:12:13,930
!ماذا؟

201
00:12:13,930 --> 00:12:15,630
.الجوّ بارد

202
00:12:15,630 --> 00:12:17,500
.هيّا، بسرعة

203
00:12:17,500 --> 00:12:20,810
.ستعدّ يويساكي-سان شيئًا إن طلبتَ منها

204
00:12:20,810 --> 00:12:21,950
...المعذرة

205
00:12:21,950 --> 00:12:23,110
ماذا؟

206
00:12:23,110 --> 00:12:24,720
ماذا بشأن تظاهرنا بأنّنا نواعد بعضنا؟

207
00:12:24,990 --> 00:12:27,680
.لا أحد سيرانا هنا

208
00:12:28,030 --> 00:12:31,280
لا يوجد داعٍ أبدًا وإطلاقًا لاستمرار
هذا التظاهر

209
00:12:31,280 --> 00:12:32,770
.في مكانٍ لا يرانا فيه أحد

210
00:12:33,100 --> 00:12:34,520
هل أنت غبي؟

211
00:12:34,520 --> 00:12:37,270
...أيّتها العاهرة الغبيّة

212
00:12:39,800 --> 00:12:42,190
،إن كنت تريد الاستمرار فلا بأس

213
00:12:42,190 --> 00:12:44,950
.ولكن ما أريده لا يتغيّر

214
00:12:45,310 --> 00:12:47,590
.أحضِر طعامي بسرعة

215
00:12:48,410 --> 00:12:50,970
.افعل ما بوسعك يا عزيزي

216
00:12:51,370 --> 00:12:55,770
.نعم، نعم، فهمت. انتظري من فضلك يا عزيزتي

217
00:12:55,770 --> 00:12:57,420
.سننفصل إن مشيت

218
00:12:59,160 --> 00:13:00,440
سحقًا... إنّها لا تتغيّر

219
00:13:00,440 --> 00:13:04,050
سواءً كانت في مخزن الصالة الرياضيّة
...أو في الشاطئ. تلك الساديّة الوغدة

220
00:13:04,350 --> 00:13:06,570
على أيّ حال، لا يمكنني أن
.أبقي الأوضاع على هذا الحال

221
00:13:06,570 --> 00:13:09,930
.أحتاج لشيء يدفع بهذه الخطوة أكثر إلى الأمام

222
00:13:11,200 --> 00:13:12,770
،المعذرة

223
00:13:13,330 --> 00:13:15,230
.آه، ماكابي-كن

224
00:13:16,710 --> 00:13:18,890
.أكي-ساما لم تتغيّر أبدًا

225
00:13:18,890 --> 00:13:20,880
.أنا آسف بشأن ذلك

226
00:13:20,880 --> 00:13:25,510
،لا بدّ وأنّك حبيبٌ لطيفٌ للغاية
.لفعل هذا لحبيبتك

227
00:13:26,930 --> 00:13:29,570
.لـ-لا، هذا طبيعي

228
00:13:30,930 --> 00:13:33,120
هل يمكنني سؤالك شيئًا؟

229
00:13:33,120 --> 00:13:34,040
نعم؟

230
00:13:34,040 --> 00:13:37,500
هل هنالك أماكن ممتعة في هذه الجزيرة؟

231
00:13:37,840 --> 00:13:42,400
،حسنًا... هنالك نادٍ، ومكان للغناء الحي

232
00:13:42,400 --> 00:13:44,380
.وبما أنّك شاب، هنالك ملهى

233
00:13:44,380 --> 00:13:48,340
أعني شيئًا قد يستمتع به طلّاب
.في المرحلة الثانوية أكثر

234
00:13:48,340 --> 00:13:50,240
.فهمت

235
00:13:50,240 --> 00:13:51,540
...حسنًا

236
00:13:52,810 --> 00:13:56,060
ماذا عن اختبار للشجاعة؟

237
00:13:56,060 --> 00:13:57,270
اختبار للشجاعة؟

238
00:13:58,240 --> 00:13:59,920
...أداغاكي أكي

239
00:13:59,920 --> 00:14:02,680
إن لم تخنّي الذاكرة، إنّها لا تجيد
.التعامل مع الأشياء المرعبة كثيرًا

240
00:14:02,680 --> 00:14:06,900
إن أتيت لإنقاذها بعد أن يتصلّب
...ظهرها وتصبح غير قادرة على الحراك

241
00:14:07,240 --> 00:14:09,310
.أعتقد أنّ هذا طفولي للغاية

242
00:14:09,310 --> 00:14:11,150
!لا، إنّه جيّد

243
00:14:11,150 --> 00:14:14,870
الجميع يحبّ هذه! هل هنالك مكانٌ محدّد؟

244
00:14:15,120 --> 00:14:18,520
.نعم. هنالك مكانُ مثالي

245
00:14:19,680 --> 00:14:21,290
.شكرًا لك

246
00:14:21,630 --> 00:14:24,730
.لن أقول لك أن تنفجر بحق أيّها الشخص الطبيعي

247
00:14:24,730 --> 00:14:26,710
.لأنّك حرٌ بالوقوع في الحب

248
00:14:27,550 --> 00:14:31,020
...ولكن، ولكن

249
00:14:31,430 --> 00:14:35,340
!هذا مبكّر مئة سنة لطفلٍ وغد مثلك

250
00:14:35,340 --> 00:14:39,220
!سأرسلك إلى الجحيم مباشرة

251
00:14:42,050 --> 00:14:46,900
كانت السنة التي عُيّنت فيها
.كسكرتيرة لعائلة أداغاكي

252
00:14:46,900 --> 00:14:50,360
نعم، تقابلنا في الحفل الموسيقي، أتتذكّر؟

253
00:14:50,640 --> 00:14:52,830
لحظة، ماذا تعني بأنّك كنت تعبث معي فحسب؟

254
00:14:52,830 --> 00:14:53,870
!عمّاذا تتحدَّث؟

255
00:14:54,660 --> 00:14:57,590
.لا، يا ميدوري! هذا مكان عملك

256
00:14:58,560 --> 00:15:00,580
سحقًا، أيوجد أحدٌ هنا؟

257
00:15:08,550 --> 00:15:12,560
سـ-سيّدتي؟ لمَ تبكين؟

258
00:15:12,560 --> 00:15:17,480
أين كان ذلك الصبي المستدير الذي كان يلعب معك؟

259
00:15:18,270 --> 00:15:19,660
!لقد رحل

260
00:15:22,150 --> 00:15:24,630
.لقد رحل مسبقًا

261
00:15:27,210 --> 00:15:29,340
!لا أريد أحدًا مثله

262
00:15:31,540 --> 00:15:34,190
.تصرّفت بكبرياء بدل التدلّل

263
00:15:34,190 --> 00:15:36,330
.يا لها من فتاةٍ ظريفة

264
00:15:37,490 --> 00:15:39,260
،منذ ذلك الحين

265
00:15:39,260 --> 00:15:42,700
يُفترض أن تكون السيّدة الصغيرة
.مستمرّة بطريقها بكره وتحطيم الرجال

266
00:15:39,500 --> 00:15:40,790
!أداغاكي-سان

267
00:15:40,790 --> 00:15:42,290
...أرجوك

268
00:15:42,700 --> 00:15:44,210
!واعديني...

269
00:15:47,960 --> 00:15:50,110
،رائع! على الرغم من وجهها الرائع

270
00:15:50,110 --> 00:15:52,780
.إنّها أميرة شيطانيّة تسحق الذكور

271
00:15:52,780 --> 00:15:54,670
!ذلك يثيرني

272
00:15:54,670 --> 00:15:56,810
يمكن أن تتحوّل مظلمةً تمامًا

273
00:15:56,810 --> 00:16:00,980
وتأخذ كلّ طاقتها السلبيّة الكارهة
.للرجال وتسيطر على العالم بها

274
00:16:01,440 --> 00:16:03,190
...ومع ذلك

275
00:16:03,830 --> 00:16:05,900
من أين أتى؟

276
00:16:05,900 --> 00:16:09,110
ذلك الطفل الوغد ذو الوجه المنعش؟

277
00:16:19,350 --> 00:16:23,710
.هذا يجعلني أرتعش من الحماس تمامًا

278
00:16:23,710 --> 00:16:26,540
لمَ تبدين بهذه السعادة؟

279
00:16:26,540 --> 00:16:28,200
هل قلتِ شيئًا؟

280
00:16:28,200 --> 00:16:30,860
.قلت أنّ هذا جيّد

281
00:16:30,860 --> 00:16:32,660
!نعم، فعلًا

282
00:16:33,750 --> 00:16:35,140
،الآن

283
00:16:35,470 --> 00:16:38,100
.لنحدِّد ترتيب دخولنا

284
00:16:38,220 --> 00:16:39,480
من أوّلًا؟

285
00:16:41,060 --> 00:16:41,770
ثانيًا؟

286
00:16:41,770 --> 00:16:43,140
.أ-أنا

287
00:16:43,140 --> 00:16:44,140
ثالثًا؟

288
00:16:44,140 --> 00:16:44,890
!أنا

289
00:16:44,890 --> 00:16:46,170
رابعًا؟

290
00:16:47,360 --> 00:16:48,970
.وأنا الخامس

291
00:16:48,970 --> 00:16:52,270
.ويبدو أنّي السادسة والأخيرة

292
00:16:52,270 --> 00:16:55,310
!حسنًا إذًا، لنبدأ. كويواي-سان

293
00:16:55,310 --> 00:16:56,450
!يمكنك فعلها

294
00:16:57,720 --> 00:17:01,160
.أعطيتِني اقتراحًا رائعًا يا يويساكي-سان

295
00:17:01,160 --> 00:17:03,370
.هذا المسرح المثالي حقًّا

296
00:17:03,370 --> 00:17:04,620
!أنا تاليًا

297
00:17:05,590 --> 00:17:09,680
دعوني أشرح لكم، ترتيب الأدوار
.كان مزوّرًا تمامًا

298
00:17:09,680 --> 00:17:12,960
وعندما تصبح الأميرة القاسية خائفة
...جدًّا لدرجة أنّها لا تستطيع الحراك

299
00:17:12,960 --> 00:17:17,640
.سآتي بسرعة وأنقذها من مصيبتها

300
00:17:19,280 --> 00:17:22,440
.لنذهب إلى المخرج معًا يا أداغاكي-سان

301
00:17:23,140 --> 00:17:27,600
مـ-ماكابي... أستسامحني؟

302
00:17:28,090 --> 00:17:30,810
.بالطبع، فأنا حبيبك

303
00:17:31,320 --> 00:17:32,790
...أعلم أنّ هذا متأخّرٌ قليلًا، ولكن

304
00:17:34,080 --> 00:17:37,990
.ليس الآن فقط... كن حبيبي إلى الأبد

305
00:17:38,300 --> 00:17:40,300
.يُعتمد عليك حقًّا يا عزيزي

306
00:17:40,990 --> 00:17:43,840
!رائع، رائع. هذا مثالي

307
00:17:41,320 --> 00:17:44,330
!اختفى؟! لحظة، لقد ذهب

308
00:17:44,330 --> 00:17:47,210
لماذا؟ لمَ لا يعمل؟

309
00:17:44,330 --> 00:17:48,670
هل أنتِ مستعدة لأن ترتعبي
إلى أقصى درجة يا أداغاكي أكي؟

310
00:17:53,490 --> 00:17:54,920
هل الطريق من هنا؟

311
00:17:54,920 --> 00:17:58,230
.لا حاجة لي معك أيّتها الطفلة

312
00:17:56,520 --> 00:17:57,590
.سأذهب من هنا

313
00:17:59,250 --> 00:18:02,410
!هدفي الوحيد هو ماكابي ماساموني

314
00:18:02,410 --> 00:18:06,100
!سأحوّل قناع الوسامة ذاك إلى خوفٍ تام

315
00:18:06,410 --> 00:18:08,810
حتّى أكي-ساما ستتمكّن من الخروج
.من هذه المغارة

316
00:18:08,810 --> 00:18:11,820
ومع ذلك، أنت، حبيبها، ستكون
.خائفًا جدًّا لدرجة أنّه سيتصلّب ظهرك

317
00:18:11,820 --> 00:18:14,640
!لا يوجد شيء أكثر إحراجًا
!سيختفي الحب الذي بينكما

318
00:18:14,640 --> 00:18:16,810
!لا شيء سيسعدني أكثر

319
00:18:17,780 --> 00:18:21,240
.هل أكي-ساما التالية؟ ولكن لا تخافي

320
00:18:36,400 --> 00:18:38,860
!لا

321
00:18:43,690 --> 00:18:46,350
.هنالك خطبٌ ما بهذا حقًّا

322
00:18:51,810 --> 00:18:53,690
!لا

323
00:18:53,130 --> 00:18:53,690
!ها هي

324
00:18:56,990 --> 00:18:58,880
هل أنتِ بخير يا أداغاكي-سان؟

325
00:18:58,880 --> 00:19:00,110
!ماذا؟

326
00:19:02,160 --> 00:19:03,670
من أنت؟

327
00:19:05,510 --> 00:19:07,040
!اركضوا جميعًا

328
00:19:07,400 --> 00:19:09,500
يويساكي-سان؟

329
00:19:11,710 --> 00:19:13,790
!لا

330
00:19:19,110 --> 00:19:21,470
...هذا حلم... هذا حلم
!هذا حلم... هذا حلم

331
00:19:21,470 --> 00:19:24,190
حادثة يُقتل الجميع بها في
!جزيرة معزولة! سفّاح شهواني

332
00:19:24,190 --> 00:19:26,310
!أسماء الموتى تتضمّن يويساكي ميدوري

333
00:19:26,310 --> 00:19:30,780
!لا، لا أريد أن يعرف الجميع عمري

334
00:19:33,640 --> 00:19:36,520
يويساكي-ساما؟ ما الذي تفعلينه هنا؟

335
00:19:38,040 --> 00:19:39,320
...ماذا نفعل

336
00:19:40,040 --> 00:19:42,410
.يبدو أنّها ستمطر

337
00:19:42,410 --> 00:19:46,060
!لـ-لا

338
00:19:46,060 --> 00:19:47,830
!هذا كابوس

339
00:19:56,040 --> 00:19:58,410
هل استيقظتِ؟

340
00:20:00,840 --> 00:20:02,550
.لا ينبغي أن تتحرّكي

341
00:20:02,830 --> 00:20:05,510
.ارتطم رأسك، ينبغي ألّا تتحرّكي

342
00:20:06,920 --> 00:20:09,480
...أنا آسفة، أنا

343
00:20:10,220 --> 00:20:12,010
.لقد أخفتِني حقًّا

344
00:20:12,010 --> 00:20:15,850
طلبت من كويواي-سان أن تساعدني
،على إخافة الجميع قليلًا

345
00:20:16,230 --> 00:20:20,940
.ولكنّي لم أعتقد أنّك ستشاركين أيضًا يا يويساكي-سان

346
00:20:21,210 --> 00:20:23,660
.هكذا إذًا

347
00:20:23,950 --> 00:20:28,190
.ولكنّك شخصٌ يعتمد عليه حقًّا يا يويساكي-سان

348
00:20:28,190 --> 00:20:29,940
.عليّ أن أتعلّم منك

349
00:20:31,160 --> 00:20:33,100
.هذا غير صحيح

350
00:20:33,100 --> 00:20:35,630
.تبدو كحبيبٍ يهتمّ بحبيبته

351
00:20:35,880 --> 00:20:37,880
.هذا غير صحيح

352
00:20:37,880 --> 00:20:38,340
ماذا؟

353
00:20:38,750 --> 00:20:42,300
.في الواقع، مواعدتي لأداغاكي-سان كذبة

354
00:20:42,600 --> 00:20:47,260
،أردت فقط أن أتباهى أمامها
.لذا فكّرت بالقيام باختبار الشجاعة هذا

355
00:20:47,760 --> 00:20:51,290
.وأقحمتكِ بالأمر أيضًا، لذا أنا آسف

356
00:20:51,720 --> 00:20:52,970
.إنّه فتىً جيّد

357
00:20:53,380 --> 00:20:58,540
ومع ذلك، أنا... فعلت كلّ
.هذا لأنّني كنت متعصبة

358
00:21:00,240 --> 00:21:01,820
!تأخرت يا ماكابي

359
00:21:02,280 --> 00:21:05,280
!لن أسامحك إن أسقطت يويساكي-سان

360
00:21:05,860 --> 00:21:07,350
...سيّدتي

361
00:21:08,240 --> 00:21:11,620
.لـ-لكن سأشكرك على الأقل

362
00:21:13,480 --> 00:21:17,140
بشأن ما قلته لك قبل قليل
.يا يويساكي-سان، لا تخبريه لأداغاكي-سان

363
00:21:18,010 --> 00:21:19,080
ما الذي تتحدّث عنه؟

364
00:21:19,080 --> 00:21:19,720
ماذا؟

365
00:21:20,240 --> 00:21:22,280
.لم أسمع شيئًا

366
00:21:27,840 --> 00:21:31,260
.لم أحصد أيّ نتيجة في النهاية

367
00:21:31,880 --> 00:21:32,760
.يا قدم الخنزير

368
00:21:32,760 --> 00:21:34,730
!نعم، أنا آسف

369
00:21:34,730 --> 00:21:37,430
.لا داعي لأن تكون منفعلًا إلى هذه الدرجة

370
00:21:37,430 --> 00:21:38,300
ماذا؟

371
00:21:38,300 --> 00:21:42,200
.أعني أنّ خطّتك لم تكن سيّئة

372
00:21:42,600 --> 00:21:45,480
،تهتمّ أكي-ساما بالمظاهر

373
00:21:45,480 --> 00:21:47,880
.ولكنّها تكره القيام بأشياء تكرهها حقًّا

374
00:21:48,670 --> 00:21:53,780
فعل ذلك أمام شخصٍ مهم كان
.شيئًا جيّدًا على الأرجح

375
00:21:54,390 --> 00:21:56,800
.لذا لن أخبر أكي-ساما

376
00:21:56,800 --> 00:21:58,510
.فـ-فهمت

377
00:21:58,510 --> 00:22:00,570
.لا ترخي دفاعك يا قدم الخنزير

378
