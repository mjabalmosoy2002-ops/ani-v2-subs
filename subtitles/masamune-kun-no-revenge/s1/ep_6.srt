1
00:00:15,000 --> 00:00:17,090
.تأخّرت أكي-ساما

2
00:00:18,990 --> 00:00:21,510
الجوّ حارٌّ اليوم، أليس كذلك؟

3
00:00:34,790 --> 00:00:38,760
أتعرفين أين يكون ماساموني-ساما؟

4
00:00:38,760 --> 00:00:40,950
لمَ تسألينني؟

5
00:00:40,950 --> 00:00:44,500
.اعتقدت أنّه أنتِ أوّل من يجب أن أسأله

6
00:00:44,800 --> 00:00:46,430
.لا أعرف

7
00:00:46,950 --> 00:00:48,220
حقًّا؟

8
00:00:48,220 --> 00:00:49,840
.نعم

9
00:00:49,840 --> 00:00:52,070
.فهمت

10
00:02:42,260 --> 00:02:44,970
...على سبيل المثال، صحيح

11
00:02:44,970 --> 00:02:46,710
.يمكنك تقبيلي

12
00:02:47,430 --> 00:02:48,420
...تقبيل

13
00:02:49,790 --> 00:02:51,230
...التلامس

14
00:02:53,880 --> 00:02:56,640
.تبادل القبل

15
00:03:04,380 --> 00:03:08,740
ماذا؟ إن كنتَ تحبّني حقًّا
.فبإمكانك فعل هذا على الأقل

16
00:03:09,060 --> 00:03:11,350
...حـ-حسنًا، آه

17
00:03:11,710 --> 00:03:13,500
!لا-لا تطلبي المستحيل

18
00:03:13,500 --> 00:03:17,840
الـ-قـ-قـ-قـ-قـ-قـ-قبلة كانت آخر
".ما بخطّة "الموت أو الحب

19
00:03:17,840 --> 00:03:20,640
!كنت أنوي استعمالها كاختتامٍ عظيم

20
00:03:27,250 --> 00:03:28,410
...ماكابي

21
00:03:30,270 --> 00:03:31,420
.أحبّك

22
00:03:37,020 --> 00:03:38,400
!ولكنّي أرفض

23
00:03:38,400 --> 00:03:40,860
!تمّت المهمّة

24
00:03:40,860 --> 00:03:43,260
.هذا هو المشهد الأخير

25
00:03:44,120 --> 00:03:47,580
وحدوثه في هذا الوضع العشوائي السخيف

26
00:03:47,580 --> 00:03:53,240
!وفي منتصف خطّتي كان غير مخطّطٍ له أبدًا

27
00:03:53,240 --> 00:03:55,290
.أترى؟ كما توقّعت

28
00:03:55,290 --> 00:03:57,080
.ليس لديّ وقت لهذا

29
00:03:57,500 --> 00:03:58,620
!انتظري

30
00:04:04,750 --> 00:04:07,200
!ما الذي تفعله ممسكًا بها هكذا؟

31
00:04:07,200 --> 00:04:09,710
!دفعتَ نفسك في منتصف المنصّة

32
00:04:09,710 --> 00:04:12,600
!مستحيل! هذا مستحيل

33
00:04:12,600 --> 00:04:16,970
ولكن لا يمكنني الفرار
...من هذا. ماذا يجب أن

34
00:04:18,640 --> 00:04:20,890
.صحيح. إنّها قطعة لحم

35
00:04:20,890 --> 00:04:22,880
.إنّها مجرد قطعة لحم بشكل إنسان

36
00:04:22,880 --> 00:04:24,480
إنّها مجرد قطعة لحم حصلتَ عليها
.كهديّة مهرجان بون

37
00:04:24,480 --> 00:04:26,610
...إن فكّرت أنّي سأقضم شيئًا لذيذًا فحسب

38
00:04:28,930 --> 00:04:30,110
!ا-انتظر

39
00:04:32,450 --> 00:04:34,910
!لا! لا تفعل

40
00:04:43,710 --> 00:04:45,210
!ما الذي تفعلينه؟

41
00:04:45,210 --> 00:04:46,900
...حـ-حسنًا

42
00:04:46,900 --> 00:04:48,680
!"لا تقولي "حسنًا

43
00:04:49,020 --> 00:04:52,880
لا فائدة من لعب دور الضحيّة
!هنا أيّتها اللحمة الغبيّة

44
00:04:52,880 --> 00:04:55,010
ماساموني-كن؟

45
00:05:00,050 --> 00:05:02,270
ممثّلة الفصل؟

46
00:05:02,270 --> 00:05:04,730
ما الذي تفعله هنا؟

47
00:05:04,730 --> 00:05:07,870
،جعلنا أحد الأساتذة ننظّف المسبح كعقاب

48
00:05:07,870 --> 00:05:11,430
ولكنّ المسبح بدا باردًا لذا لم
.نستطع أن نقاوم ودخلنا به

49
00:05:11,430 --> 00:05:13,060
ما هذا؟

50
00:05:13,060 --> 00:05:15,950
.لا يفترض أن تغطس بملابسك مع ذلك

51
00:05:16,460 --> 00:05:19,560
...يـ-يبدو أنّي استطعت خداعهم للآن

52
00:05:20,070 --> 00:05:22,170
ما الذي تفعلينه هنا يا ممثّلة الفصل؟

53
00:05:22,170 --> 00:05:25,290
.أنا؟ لديّ تمرين

54
00:05:26,140 --> 00:05:28,450
.إنّها في نادي السباحة أيضًا إذًا

55
00:05:28,450 --> 00:05:31,480
.لهذا لديها جسد رياضي رشيق

56
00:05:31,480 --> 00:05:33,660
.حسنًا إذًا، ابذل ما بوسعك بالتنظيف

57
00:05:33,660 --> 00:05:35,430
...شـ-شكرًا

58
00:05:39,550 --> 00:05:42,360
ما هذا؟ أتحاولين الهرب؟

59
00:05:42,360 --> 00:05:43,770
...حسنًا

60
00:05:43,780 --> 00:05:47,400
،أعتقد أنّي سأقبل حقيقة أنّك تحبّني جدًّا

61
00:05:47,400 --> 00:05:49,990
.لدرجة أنّك لا تدري ما تفعل بنفسك

62
00:05:52,680 --> 00:05:55,780
وهذا يؤدّي إلى طرح سؤال: وإن يكن؟

63
00:06:02,340 --> 00:06:07,510
!لا تعبثي معي! فليحوّلها أحدٌ إلى لحمٍ محمّر

64
00:06:13,190 --> 00:06:17,890
.ما خطبها؟ هي من أخبرتني أن أفعل ذلك

65
00:06:20,970 --> 00:06:23,930
.حاولتُ تقبيلها حقًّا

66
00:06:26,060 --> 00:06:29,190
.ها أنت ذا يا ماساموني-ساما

67
00:06:29,190 --> 00:06:30,810
!فوجينوميا-سان؟

68
00:06:31,640 --> 00:06:33,720
.كنت أبحث عنك

69
00:06:39,990 --> 00:06:43,290
...لا أعتقد أنّه لديّ الطاقة لمرافقتك حاليًّا

70
00:06:43,290 --> 00:06:47,530
يا إلهي، لا بدّ وأنّك متعبٌ من
.العمل اليدوي الشديد

71
00:06:58,550 --> 00:07:01,270
.تفضّل خذ هذا إن أردت

72
00:07:01,270 --> 00:07:04,340
شاي حار؟ في هذا الوقت من السنة؟

73
00:07:08,220 --> 00:07:09,570
.إنّه مالح

74
00:07:13,870 --> 00:07:18,460
سمعت أنّه من الأفضل ألّا تترك
.جسدك باردًا حتّى في الصيف

75
00:07:18,460 --> 00:07:21,610
سمعت أيضًا أنّك تحتاج الصوديوم
.وملح الليمون لمقاومة الجفاف

76
00:07:21,610 --> 00:07:28,000
ولهذا اعتقدت أنّ الحل الأفضل
.سيكون شاي هوجي بالخوخ المخلّل

77
00:07:29,330 --> 00:07:32,300
.حسنًا، هذا منطقي

78
00:07:32,300 --> 00:07:36,400
.أفضّل هذا على عصيرٍ حلو بشكلٍ مقرف

79
00:07:36,400 --> 00:07:39,800
الأشياء الأخرى التي تنقصك هي
!الفيتامينات الأساسيّة والمغنيسيوم

80
00:07:39,800 --> 00:07:41,990
.خميرة البيرة والعكبر

81
00:07:41,980 --> 00:07:45,190
العكبر من هذه الشركة لديه
طريقة فريدة من حيثُ

82
00:07:45,190 --> 00:07:48,280
.امتصاص الجسد له ممّا يجعله فعّالًا جدًّا

83
00:07:48,290 --> 00:07:50,740
...وبالنسبة للمغنيسيوم

84
00:07:52,280 --> 00:07:57,340
.أ-أنا آسفة للغاية! إنّي أتجاوز حدودي

85
00:08:00,530 --> 00:08:04,040
لا أفضّل الاعتماد على الأدوية
.وما نحو ذلك من البداية

86
00:08:04,040 --> 00:08:06,660
.ممارسة الرياضة والحمية المعتدلة هي أكثر ضرورة

87
00:08:06,660 --> 00:08:10,360
إن كنتِ ستستعملينها كاحتياط
...فلا بأس إذًا على ما أعتقد، ولكن

88
00:08:10,360 --> 00:08:14,100
.بالطبع أعتقد أنّ هذا هو المثالي

89
00:08:15,190 --> 00:08:18,560
.إنّها ظريفة وهي عابسةٌ هكذا أيضًا

90
00:08:20,020 --> 00:08:22,890
هل يمكنني سؤالك شيئًا ما يا فوجينوميا-سان؟

91
00:08:22,890 --> 00:08:24,230
ماذا؟

92
00:08:25,160 --> 00:08:27,470
ما الذي تحبّينه فيّ؟

93
00:08:30,900 --> 00:08:34,530
.إنّي شابٌ يستطيع تصوير حتّى الفشل إلى مكسب

94
00:08:34,910 --> 00:08:39,290
إنّه سؤالٌ صعب جدًّا طرحته عليّ
.أداغاكي أكي ولم أستطع الإجابة عنه

95
00:08:39,780 --> 00:08:42,500
ما الذي تحبّه بي؟

96
00:08:42,500 --> 00:08:46,950
"سأرفض أيّ إجابة سطحيّة مثل "وجهك
!و"كلّ شيء" فورًا

97
00:08:46,950 --> 00:08:53,420
وبالطبع، بما أنّك لا تعرفينني فلا
.يمكنك تقديم إجابات عن شخصيّتي

98
00:08:53,420 --> 00:08:57,670
هذا أفضل سؤال تمكّنني إجابته
!أيًّا كانت من رفضها بسهولة

99
00:08:57,670 --> 00:08:59,930
حسنًا، بماذا ستجيبين؟

100
00:09:02,640 --> 00:09:07,220
أنّك متواضعٌ للغاية لدرجة
.أنّك لا تدرك محاسنك حتّى

101
00:09:10,210 --> 00:09:11,150
...أبيض

102
00:09:13,240 --> 00:09:14,720
!ابيِضاض

103
00:09:25,580 --> 00:09:27,530
.فـ-فهمت

104
00:09:28,720 --> 00:09:32,000
،يجب أن تكون أكثر ثقة

105
00:09:33,100 --> 00:09:36,250
.لأنّك شخصٌ رائع يا ماساموني-ساما

106
00:09:45,140 --> 00:09:49,180
.هذه الامرأة أقوى ممّا توقّعت

107
00:09:49,180 --> 00:09:55,360
فهمت! ما ينقضني هو القدرة
.على أن أكون جريئًا بشكلٍ غير معقول

108
00:09:57,180 --> 00:09:59,940
.آه، يكاد سروالي يجف

109
00:10:05,570 --> 00:10:10,160
تلك الفتاة الجريئة خطيرةٌ حتمًا
.عليّ إخفاؤها من الصورة بسرعة

110
00:10:23,200 --> 00:10:24,900
إلى أين تذهب وحيدة؟

111
00:10:26,910 --> 00:10:28,310
...هذا المكان

112
00:10:29,450 --> 00:10:32,810
ما الذي تفكّر به هذه الامرأة؟

113
00:10:42,290 --> 00:10:44,470
هل تريدين شيئًا من نيكو-ساما؟

114
00:10:48,490 --> 00:10:51,070
.لـ-لا أعلم ما الذي تتحدّثين عنه

115
00:10:51,990 --> 00:10:55,780
.إنّي أعرفها يا شيدو

116
00:10:55,780 --> 00:10:57,610
.كويواي يوشينو-سان

117
00:10:59,730 --> 00:11:02,760
إنّك تعملين خادمةً لأداغاكي-ساما، أليس كذلك؟

118
00:11:07,350 --> 00:11:10,400
.أنا آسفة. أنا آسفة. لا أعلم

119
00:11:11,170 --> 00:11:13,440
.يمكنك إيقاف التمثيليّة

120
00:11:15,570 --> 00:11:18,750
.أعلم أنّه عملك، لا بدّ وأنّه صعب

121
00:11:20,730 --> 00:11:23,690
لمَ أنتِ مهتمّة بماكابي ماساموني؟

122
00:11:23,690 --> 00:11:26,550
.لأنّه أنقذني في الماضي

123
00:11:26,550 --> 00:11:30,030
.أنتِ تكذبين. سمعت كلّ شيء من قدم الخنزير

124
00:11:36,920 --> 00:11:39,410
هل يمكنني مساعدتكما؟

125
00:11:40,520 --> 00:11:44,380
أنّي متواضعٌ للغاية لدرجة أنّي
...لا أدرك محاسني حتّى، هاه

126
00:11:44,690 --> 00:11:47,600
سأستخدم هذه العبارة في المرّة
.القادمة التي أرى فيها أداغاكي أكي

127
00:11:47,600 --> 00:11:52,570
،ولكن إن ظللت أقدّرها هكذا
.فإنّي سأستمرّ بالوقوع في حبّها

128
00:11:54,020 --> 00:11:55,260
.لقد عدت

129
00:11:54,020 --> 00:11:57,340
...صحيح. تمسكين الجمبري أوّلًا

130
00:11:56,780 --> 00:11:58,470
ما كلّ هذا الإزعاج؟

131
00:11:57,340 --> 00:11:58,470
هكذا؟

132
00:11:58,470 --> 00:12:00,430
.نعم، هكذا

133
00:12:00,430 --> 00:12:03,070
!نعم، استمرّي، هذا جيّد
.لدينا البيض تاليًا

134
00:12:05,680 --> 00:12:08,030
.مرحبًا بعودتك يا ما-كن

135
00:12:09,940 --> 00:12:13,450
.مرحبًا بعودتك ماساموني-ساما

136
00:12:13,450 --> 00:12:15,660
!ما الذي تفعلانه هنا؟

137
00:12:15,660 --> 00:12:18,500
كنت أحاول إعداد الجمبري
.المقلي لأوّل مرّة بحياتي

138
00:12:18,500 --> 00:12:20,660
.آمل أن يعجبك

139
00:12:23,420 --> 00:12:24,940
.آ-آه... فهمت

140
00:12:24,940 --> 00:12:26,780
.هذا ليس منزلي

141
00:12:26,780 --> 00:12:30,630
.يكاد يجهز، لذا كل بعض البسكويت ريثما تنتظر

142
00:12:27,900 --> 00:12:30,030
...ولكنّ اللولي العجوز هنا

143
00:12:30,630 --> 00:12:31,210
!لحظة

144
00:12:31,210 --> 00:12:32,840
!إنّه منزلي فعلًا

145
00:12:33,560 --> 00:12:35,320
!مـ-معلّمتي

146
00:12:40,350 --> 00:12:42,660
.يداي دبقتان

147
00:12:42,660 --> 00:12:46,550
هذا لا يهمّ الآن! ما الذي يجري؟

148
00:12:48,840 --> 00:12:51,530
هل يمكنني مساعدتكما؟

149
00:12:55,200 --> 00:12:58,490
.هذا الزيّ! لا بدّ أنّكما من مدرسة ما-كن

150
00:12:58,490 --> 00:13:01,960
هل كنتما تبحثان عن ما-كن؟
هل أنتما معجبتان بما-كن؟

151
00:13:02,470 --> 00:13:05,210
!ما-كن محبوبٌ للغاية

152
00:13:05,210 --> 00:13:08,380
.لم يعد ما-كن بعد. ادخلا

153
00:13:08,380 --> 00:13:10,350
.كنت أنوي إعداد جمبري مقلي الليلة

154
00:13:10,350 --> 00:13:12,090
.لا، لا داعي

155
00:13:12,090 --> 00:13:14,890
!إي-بي-آي! المعروف بالجمبري

156
00:13:14,890 --> 00:13:15,720
!جمبري

157
00:13:15,720 --> 00:13:19,040
!أنتِ أيضًا! ردّدي خلفي

158
00:13:19,040 --> 00:13:21,430
.لا، أنا لديّ عمل

159
00:13:22,640 --> 00:13:25,620
.أنا آسف، أمّي لا تتفهّم الجوّ المحيط

160
00:13:25,620 --> 00:13:27,900
.كان ذلك غريبًا للغاية

161
00:13:27,900 --> 00:13:31,400
،على أيّ حال، يجب أن تغادرا

162
00:13:31,880 --> 00:13:34,340
.قبل أن تريا شيئًا خطيرًا

163
00:13:37,790 --> 00:13:39,920
هل كان هنالك شيءٌ آخر؟

164
00:13:39,920 --> 00:13:43,270
بـ"خطير"، هل تعني كلّ شيءٍ هنا؟

165
00:13:43,270 --> 00:13:44,840
ماذا؟ ماذا تعنين؟

166
00:13:45,220 --> 00:13:47,510
هذه الغرفة توضّح تمامًا أنّه

167
00:13:47,510 --> 00:13:49,470
.لا يوجد شيءٌ برأسك سوى تمارين الأثقال

168
00:13:49,470 --> 00:13:51,140
!لـ-لا تنظري كثيرًا

169
00:13:51,140 --> 00:13:54,050
!"وأطلقي عليها "آلات الصالة الرياضيّة المثاليّة

170
00:13:54,050 --> 00:13:57,420
اسمعي، لا يمكنك تفويت حتّى يوم واحد
.في الطريق نحو كونك شابًّا وسيمًا

171
00:13:57,420 --> 00:14:01,570
إن سمحتِ بحتّى كمية دهنٍ قليلة
.فإنّها ستنمو إلى دهون حشويّة كبيرة

172
00:14:01,570 --> 00:14:04,070
قطرة دهنٍ واحدة هي البداية
.لأن تصبحي سمينة ضخمة

173
00:14:04,070 --> 00:14:06,770
.يا إلهي، يا لها من غرفة جميلة

174
00:14:10,230 --> 00:14:13,370
.كلّ هذا مثاليٌ لإعادة التأهيل

175
00:14:18,030 --> 00:14:19,560
ماساموني-ساما؟

176
00:14:22,470 --> 00:14:24,930
.من المخجل فعل هذا هنا

177
00:14:25,830 --> 00:14:29,500
!لن أُخدع مهما قلتِ من أشياء غريبة

178
00:14:29,500 --> 00:14:32,010
هل أردتِ شيئًا؟

179
00:14:32,370 --> 00:14:37,490
صحيح، الجمبري جاهز، عادت
،تشيناتسو-ساما للمنزل للتو

180
00:14:37,490 --> 00:14:39,280
.لذا كينوي-ساما تنتظرك

181
00:14:45,860 --> 00:14:47,770
...سعرات عالية ثانيةً

182
00:14:47,770 --> 00:14:49,810
.ياه، لقد تفاجأت

183
00:14:49,810 --> 00:14:53,730
لا أصدّق أنّ لديك أصدقاءً قد يودّون
.القدوم إلى المنزل يا أونيتشان

184
00:14:53,730 --> 00:14:56,110
لمَ هذا؟

185
00:14:56,110 --> 00:14:59,450
.ماساموني-ساما محبوبٌ للغاية

186
00:14:59,450 --> 00:15:02,770
—لأنّ أونيتشان يخاف أن يكتشف الناس من يكون

187
00:15:03,960 --> 00:15:06,820
هل سيتفوّه هذا الفم
!بأشياء لا داعي لها؟

188
00:15:06,820 --> 00:15:09,780
من يكون"؟ أتعنين ماساموني-ساما؟"

189
00:15:09,780 --> 00:15:13,570
—صحيح، إنّه يعتقد أنّه وسيمٌ الآن، ولكن

190
00:15:13,570 --> 00:15:16,590
!يكفي حديثًا فارغًا! لنأكل

191
00:15:17,110 --> 00:15:20,070
.لمَ تجلس هنا؟ لا توجد مساحة

192
00:15:20,070 --> 00:15:22,810
هل جلس الجميع؟

193
00:15:22,810 --> 00:15:25,280
.حسنًا، لنبدأ الأكل

194
00:15:27,980 --> 00:15:31,510
.فتات الخبز هذا مليءٌ بالدهون

195
00:15:39,620 --> 00:15:40,550
!يا إلهي

196
00:15:40,550 --> 00:15:42,740
!ما-كن، نيكو-تشان! لا تفعلا هذا

197
00:15:42,740 --> 00:15:45,080
!يُفترض أن تستمتعا بوجبتيكما

198
00:15:45,650 --> 00:15:47,210
نستمتع"؟"

199
00:15:47,210 --> 00:15:48,790
.ولكن السعرات الحراريّة مشكلة

200
00:15:48,790 --> 00:15:50,840
.العناصر الغذائيّة مهمّة

201
00:15:53,540 --> 00:15:56,350
.إنّكما متشابهان

202
00:15:56,350 --> 00:15:59,740
!لن أدع هذا يفوت

203
00:15:59,740 --> 00:16:01,120
لماذا؟

204
00:16:01,120 --> 00:16:04,070
لماذا؟ بماذا نتشابه؟

205
00:16:02,290 --> 00:16:04,880
.يوجد المزيد إن أردتِ يا يوشينو-تشان

206
00:16:04,880 --> 00:16:05,770
.حسنًا

207
00:16:05,770 --> 00:16:08,540
.لنشعل بعض الألعاب الناريّة بعد الأكل

208
00:16:08,540 --> 00:16:10,730
!توقّفي عن قول أشياء لا داعي لها

209
00:16:10,730 --> 00:16:12,580
.إنّهما مشغولتان

210
00:16:12,580 --> 00:16:16,690
!ياه! الألعاب الناريّة رائعة! أودّ ذلك

211
00:16:16,690 --> 00:16:18,420
ماذا عنكِ يا يوشينو-سان؟

212
00:16:18,420 --> 00:16:19,410
.حسنًا

213
00:16:19,410 --> 00:16:20,770
!مرحى

214
00:16:20,770 --> 00:16:22,360
...هذه الغبيّة

215
00:16:25,470 --> 00:16:28,790
!وقت الألعاب الناريّة

216
00:16:28,790 --> 00:16:31,760
هل كان ينبغي أن تغيّري
ملابسك إلى اليوكاتا حقًّا؟

217
00:16:37,460 --> 00:16:39,770
!تامايا

218
00:16:39,770 --> 00:16:41,170
ألستِ تزعجين الجيران؟

219
00:16:41,170 --> 00:16:44,640
!أسرعي يا فوجينوميا-سان! تعالي إلى هنا

220
00:16:44,640 --> 00:16:49,030
.ولكن، أحسنتِ بجلبها إلى الفناء يا أختي الصغيرة

221
00:16:49,030 --> 00:16:52,850
.إنّه أأمن من كوني داخل المنزل رفقة هذه الامرأة

222
00:16:54,780 --> 00:16:58,440
.أختك الصغيرة تختلف عنك كثيرًا

223
00:17:01,580 --> 00:17:03,700
.إنّها نشطةٌ جدًّا

224
00:17:04,080 --> 00:17:07,230
.آسف لإدراجك بكلّ هذا

225
00:17:07,230 --> 00:17:10,780
.لا بأس. لا أحبّذ الألعاب الناريّة كثيرًا فحسب

226
00:17:10,780 --> 00:17:12,040
لماذا؟

227
00:17:12,440 --> 00:17:13,640
،في الماضي

228
00:17:13,630 --> 00:17:16,010
فكّرت أكي-ساما بتجربة

229
00:17:13,770 --> 00:17:23,510
عشرة، تسعة، ثمانية، سبعة، ستّة
...خمسة، أربعة، ثلاثة، اثنان، واحد

230
00:17:16,010 --> 00:17:20,560
لمعرفة كم صاروخ من الألعاب الناريّة
،سيتطلّب ليطير بأحدهم إلى القمر

231
00:17:20,560 --> 00:17:23,510
...وأنا كنتُ موضوع التجربة

232
00:17:23,510 --> 00:17:27,310
أصبح كلّ ما أمامي أبيض
.ولم أعد أستطيع السمع

233
00:17:27,310 --> 00:17:28,730
!يكفي! هذا يكفي يا معلّمتي

234
00:17:28,730 --> 00:17:30,150
!لا تجبري نفسك بقول ذلك

235
00:17:30,660 --> 00:17:33,540
!هذه الأميرة القاسية ساديّة إلى أيّ درجة؟

236
00:17:35,070 --> 00:17:37,700
.لعبة الثعبان الناريّة هذه تريح البال

237
00:17:37,700 --> 00:17:40,000
.أعتقد أنّي سأتركها

238
00:17:41,870 --> 00:17:44,850
.الأوبي الخاص بك رخوٌ يا تشيناتسو-ساما

239
00:17:44,850 --> 00:17:45,710
ماذا؟

240
00:17:47,650 --> 00:17:49,470
.شـ-شكرًا

241
00:17:51,760 --> 00:17:54,230
لمَ تحمرّين خجلًا؟

242
00:17:56,580 --> 00:18:00,470
.ملاحظة: جملة تستعمل لوصف جمال امرأة ما

243
00:17:56,580 --> 00:18:00,470
كوردة الفاونيا عندما تكون قائمة
وكشجرة الفاونيا عندما تجلس، أكان المثل هكذا؟

244
00:18:05,140 --> 00:18:06,440
.شكرًا لك

245
00:18:08,840 --> 00:18:12,030
.تشيناتسو-ساما ظريفة للغاية

246
00:18:12,030 --> 00:18:15,060
.حقًّا؟ أنا لا أعتقد ذلك

247
00:18:15,450 --> 00:18:18,520
.لم يسبق أن استمتعتُ هكذا

248
00:18:18,900 --> 00:18:22,940
.لا أعلم كيف يفترض أن أتجاوب

249
00:18:22,940 --> 00:18:25,190
.الجميع جرّب الألعاب الناريّة من قبل

250
00:18:28,710 --> 00:18:30,410
.إنّها جميلة جدًّا

251
00:18:32,330 --> 00:18:34,830
.قطعت بطيخًا أيّها الجميع

252
00:18:34,830 --> 00:18:36,590
!المزيد من الطعام؟

253
00:18:36,590 --> 00:18:38,430
!بطيخ

254
00:18:38,430 --> 00:18:41,290
!فوجينوميا-سان، كويواي-سان، لنتقاتل

255
00:18:41,290 --> 00:18:42,640
نتقاتل"؟"

256
00:18:42,640 --> 00:18:43,580
على ماذا؟

257
00:18:43,580 --> 00:18:45,970
!سنرى من يبصق البذرات أبعد بالطبع

258
00:18:45,970 --> 00:18:47,680
.لن أخسر

259
00:18:47,680 --> 00:18:50,400
هل هنّ جميعًا في المرحلة الابتدائيّة؟

260
00:19:00,920 --> 00:19:03,450
،إن لم تكوني كاذبة

261
00:19:04,280 --> 00:19:07,400
.فقد نتمكّن من أن نكون في علاقة مختلفة

262
00:19:16,450 --> 00:19:24,390
إن لم أكن سأثأر من أداغاكي
أكي، فهل كنتُ سأشعر بشعورٍ مختلف؟

263
00:19:29,300 --> 00:19:32,110
هل انتهيتِ من تغيير ملابسك يا فوجينوميا-سان؟

264
00:19:32,110 --> 00:19:33,560
.وصلوا لقلّك

265
00:19:33,850 --> 00:19:35,520
.سآتي حالًا

266
00:19:46,110 --> 00:19:49,680
.ستعود أخيرًا، كان هذا مُتلِفًا للأعصاب

267
00:19:49,680 --> 00:19:51,320
.ماساموني-ساما

268
00:19:51,320 --> 00:19:54,080
ألن توصلني إلى المنزل؟

269
00:19:54,080 --> 00:19:57,790
.لا تكوني ساذجة، هناك أحدٌ بانتظارك

270
00:20:00,260 --> 00:20:04,810
.أنا حزينة. كان اليوم ممتعًا للغاية

271
00:20:04,810 --> 00:20:06,320
...حسنًا، حسنًا

272
00:20:06,320 --> 00:20:08,840
.أرجوك لا تأتي ثانيةً

273
00:20:08,840 --> 00:20:09,960
.إلى اللقاء

274
00:20:14,830 --> 00:20:17,620
ماذا عنك يا معلّمتي؟ هل تريدينني
أن أقلّك إلى منزلك؟

275
00:20:18,370 --> 00:20:20,610
.أنا أعيش في منزل أكي-ساما

276
00:20:20,610 --> 00:20:22,360
...صـ-صحيح

277
00:20:22,360 --> 00:20:25,510
.لا أريدها أن تسيء الفهم ثانيةً

278
00:20:26,170 --> 00:20:29,360
سأرافقك إلى طريقٍ رئيسي
.حيث يمكنك أن تأخذي سيّارة أجرة

279
00:20:33,640 --> 00:20:34,920
.يا قدم الخنزير

280
00:20:38,810 --> 00:20:41,210
.لا تدعها تجعلك تميل أبدًا

281
00:20:41,210 --> 00:20:44,390
مـ-ما الذي تتحدّثين عنه؟
.لن يحدث هذا

282
00:20:44,390 --> 00:20:45,730
.مهما يحدث

283
00:20:47,250 --> 00:20:48,970
!كان ذلك ممتعًا

284
00:20:49,380 --> 00:20:54,320
أشعر بالارتياح الآن. اعتقدت
.أنّ أونيتشان سيكون وحيدًا إلى الأبد

285
00:20:54,320 --> 00:20:55,180
.نعم

286
00:20:57,010 --> 00:20:59,300
...من كان يعتقد أنّنا سنلتقي هنا ثانيةً

287
00:21:00,780 --> 00:21:02,200
.فوجينوميا-سان

288
00:21:03,100 --> 00:21:07,370
.أنا آسفة لأنّي لم أستطع مرافقتك يا سيّدتي

289
00:21:07,370 --> 00:21:10,240
.لا بأس. تمكّنت من حصد بعض النتائج

290
00:21:12,980 --> 00:21:14,400
.نحن متشابهتان

291
00:21:15,540 --> 00:21:19,230
.قد تكون مُحقّة

292
00:22:53,290 --> 00:22:57,760
أنّك متواضعٌ للغاية لدرجة
.أنّك لا تدرك محاسنك حتّى

293
00:23:01,590 --> 00:23:02,500
ماذا؟

294
00:23:03,540 --> 00:23:06,210
.أخبرتك بشعوري للتو

295
00:23:07,030 --> 00:23:11,710
أكنت تعتقد أنّ هذا سيحرّك
قلبي ولو قليلًا؟

296
00:23:11,710 --> 00:23:14,940
.يا لها من جملة رخيصة. أنا لستُ أنت

297
00:23:16,400 --> 00:23:20,870
.لمعلوماتك فقط، أنا أعرف مدى إمكانيّاتي

298
00:23:20,870 --> 00:23:25,230
وبحالتك، المسألة ليست أنّك
،متواضعٌ جدًّا لدرجة أنّك لا تدرك ذلك

299
00:23:25,230 --> 00:23:28,730
.بل إنّك غبيٌّ جدًّا

300
00:23:32,580 --> 00:23:35,060
...معلّمتي

301
00:23:36,050 --> 00:23:39,590
سرقت جملتها؟ هل أنت غبي؟