1
00:00:02,350 --> 00:00:03,560
!حسنًا، ممتاز

2
00:00:04,440 --> 00:00:06,570
،لم أعدّ أحدها منذ زمن طويل
.لكن النتيجة جيدة

3
00:00:06,570 --> 00:00:08,230
!ربما أنا عبقريّ

4
00:00:09,000 --> 00:00:11,740
أتساءل إن كان حسابي هيتومان
.لا يزال يعمل

5
00:00:13,490 --> 00:00:16,340
.لم أدرك أنه صار لديّ عدد أكبر من المتابعين

6
00:00:19,830 --> 00:00:21,060
.لنشغّله

7
00:02:00,110 --> 00:02:01,720
!انتهيت

8
00:02:01,720 --> 00:02:05,020
.هذه أسئلة كافية للاختبار النصفيّ

9
00:02:06,050 --> 00:02:08,820
يُفترض أن يُساعد هذا طالباتي
،بعد دخولهنّ مجتمع البشر

10
00:02:08,820 --> 00:02:11,310
.لذا سأحتاج لمواصلة تحديث هذه المواد

11
00:02:13,350 --> 00:02:15,360
أغراض المعلم هوشينو مرة أخرى؟

12
00:02:15,360 --> 00:02:17,950
.أتمنى أن ينضمّ مكتبه

13
00:02:19,370 --> 00:02:22,410
كيف يتذكّر أين وضع كل شيء؟

14
00:02:25,220 --> 00:02:27,780
.أنا جائع

15
00:02:28,280 --> 00:02:31,210
.لم يكن لديّ وقت لتناول الغداء مع كل هذا العمل

16
00:02:31,210 --> 00:02:32,340
!كلا

17
00:02:32,340 --> 00:02:34,380
!نسيتُ أن أشتري السوشي لغداء اليوم

18
00:02:34,380 --> 00:02:35,480
!واشوي

19
00:02:36,590 --> 00:02:38,890
!سوشي، سوشي

20
00:02:38,890 --> 00:02:42,310
.يجب أن ندلّل أنفسنا أحيانًا

21
00:02:42,310 --> 00:02:47,510
،بما أنّي تقاضيتُ راتبي
!أسرفتُ قليلًا واشتريتُ سوشي فاخر

22
00:02:48,780 --> 00:02:50,390
.لا أستطيع فتحه

23
00:02:50,730 --> 00:02:52,430
ما هذا؟

24
00:02:52,430 --> 00:02:53,300
!هيّا

25
00:02:53,740 --> 00:02:56,150
!افتح

26
00:02:58,680 --> 00:03:01,660
.لقد سكبتها

27
00:03:02,610 --> 00:03:07,660
لهذا لا أثق بهذه الأكياس
.التي تُفتح من أيّ مكان

28
00:03:09,110 --> 00:03:11,000
.حسنًا، نظّفته

29
00:03:11,000 --> 00:03:12,360
.مهلًا

30
00:03:16,860 --> 00:03:19,800
أهذا منديل المعلم هوشينو؟

31
00:03:27,060 --> 00:03:28,890
.لا، إنها لا تزول

32
00:03:30,380 --> 00:03:32,540
!قُضي عليّ

33
00:03:33,410 --> 00:03:34,940
.هذا سيئ

34
00:03:34,940 --> 00:03:36,820
ما الذي فعلته؟

35
00:03:37,480 --> 00:03:39,360
ما الأمر أيها المعلم؟

36
00:03:41,330 --> 00:03:42,230
هانيدا؟

37
00:03:43,000 --> 00:03:45,070
ماذا تفعلين هنا في وقت متأخر؟

38
00:03:45,070 --> 00:03:48,240
ما الذي أخفيته للتو؟

39
00:03:48,240 --> 00:03:49,060
ماذا؟

40
00:03:50,870 --> 00:03:53,580
!هناك فضائي في السماء

41
00:03:53,580 --> 00:03:56,750
من قد يصدّق هذا؟

42
00:03:58,030 --> 00:04:00,300
...لم أكن أحاول خداعك

43
00:04:00,660 --> 00:04:02,630
.رأيتُ كل شيء

44
00:04:03,160 --> 00:04:04,840
عمّا تتحدثين؟

45
00:04:04,840 --> 00:04:08,420
.المنديل الفاخر الملطّخ

46
00:04:08,420 --> 00:04:10,170
رأيته حقًا إذًا؟

47
00:04:10,170 --> 00:04:11,450
من أين؟

48
00:04:11,450 --> 00:04:17,170
!منذ أن قلت "حسنًا، انتهيت
".هذه أسئلة كافية للاختبار النصفيّ

49
00:04:17,170 --> 00:04:18,980
من هناك؟

50
00:04:19,850 --> 00:04:22,320
.كنتُ مهملًا قليلًا

51
00:04:22,320 --> 00:04:25,080
أليس هذا للمعلم هوشينو؟

52
00:04:25,480 --> 00:04:26,360
.كما توقعت

53
00:04:26,950 --> 00:04:30,660
.عليك الاعتذار منه في أقرب وقت

54
00:04:30,660 --> 00:04:36,650
أنت محقة، لكنني أردتُ فعل ما بوسعي
.قبل إعادته له

55
00:04:36,650 --> 00:04:39,750
.لا أعتقد أنك ستحقق شيئًا بالضغط على نفسك

56
00:04:39,750 --> 00:04:41,090
...أجل

57
00:04:41,790 --> 00:04:44,890
.سأذهب لاستدعاء المعلم هوشينو إذًا

58
00:04:44,890 --> 00:04:46,130
!مهلًا يا هانيدا

59
00:04:46,130 --> 00:04:48,180
!أحتاج إلى الوقت لترتيب مشاعري

60
00:04:49,090 --> 00:04:50,530
.ها هو ذا

61
00:04:50,530 --> 00:04:51,480
!كان هذا سريعًا

62
00:04:51,480 --> 00:04:53,110
.استدعيته مسبقًا

63
00:04:53,110 --> 00:04:54,270
!كنتِ مستعدة إذًا

64
00:04:54,520 --> 00:04:55,600
ماذا؟

65
00:04:55,600 --> 00:04:56,690
ما الأمر؟

66
00:04:56,690 --> 00:04:58,650
...أيها المعلم هوشينو

67
00:04:59,620 --> 00:05:01,110
...كما ترى

68
00:05:01,590 --> 00:05:06,330
إنه المنديل الذي أهدتني إيّاه زوجتي
.في عيد ميلادي

69
00:05:06,330 --> 00:05:08,180
زوجتك؟

70
00:05:08,180 --> 00:05:10,030
هدية عيد ميلاد؟

71
00:05:10,840 --> 00:05:13,570
مهلًا، أنت متزوج؟

72
00:05:13,570 --> 00:05:17,290
.تملّكتني الحيرة لأنّي لم أعثر عليه

73
00:05:17,290 --> 00:05:18,460
.شكرًا لك

74
00:05:18,770 --> 00:05:19,940
أين كان؟

75
00:05:22,040 --> 00:05:26,390
أعتقد أنه ظهر بعد سقوط
.كومة الأوراق التي على مكتبك

76
00:05:26,390 --> 00:05:29,130
كان هناك إذًا؟

77
00:05:29,130 --> 00:05:30,750
.آسف على التسبب لك بالمتاعب

78
00:05:30,750 --> 00:05:33,070
.لا أحسن التنظيم

79
00:05:33,540 --> 00:05:36,280
.أيها المعلم هوشينو

80
00:05:37,080 --> 00:05:40,990
في الواقع، لقد استخدمته بالخطأ
.لمسح صلصة الصويا

81
00:05:40,990 --> 00:05:42,390
!أعتذر بشدّة

82
00:05:42,700 --> 00:05:43,750
صلصة الصويا؟

83
00:05:46,630 --> 00:05:49,700
.هذه البقعة ليست بالأمر الجلل

84
00:05:49,700 --> 00:05:52,060
.لا يزال قابلًا للاستخدام كمنديل

85
00:05:52,380 --> 00:05:54,870
لا داعي لتشعر بالسوء حيال ذلك
.أيها المعلم هوشينو

86
00:05:54,870 --> 00:05:57,710
.يسرّني أنك عثرت عليه

87
00:05:57,710 --> 00:06:00,230
.كنتُ أبحث عنه طيلة الأسبوع الماضي

88
00:06:00,230 --> 00:06:02,540
.كانت زوجتي على وشك أن تغضب منّي

89
00:06:02,540 --> 00:06:06,260
ألهذا استدعيتني إلى هنا يا هانيدا-سان؟

90
00:06:06,260 --> 00:06:07,470
.هذا صحيح

91
00:06:07,470 --> 00:06:08,660
.فهمت

92
00:06:08,660 --> 00:06:11,240
.هانيدا-سان، أيها المعلم هيتوما، شكرًا لكما

93
00:06:11,790 --> 00:06:12,890
.لا داعي للشكر

94
00:06:13,180 --> 00:06:14,100
.سأذهب الآن

95
00:06:18,610 --> 00:06:21,380
.من الجيد أنه لم يغضب منك أيها المعلم

96
00:06:21,380 --> 00:06:22,430
.أجل

97
00:06:22,430 --> 00:06:23,980
.شكرًا لك يا هانيدا

98
00:06:23,980 --> 00:06:26,340
!سأغادر أيضًا

99
00:06:29,270 --> 00:06:30,430
.هانيدا توباري

100
00:06:31,160 --> 00:06:33,060
.هيئتها الحقيقية هي طائر الصرد

101
00:06:33,460 --> 00:06:35,330
.هي دائمًا أفضل طالبة في الصفّ

102
00:06:35,670 --> 00:06:38,920
لكن سجلاتها المدرسية مخفية لسبب ما

103
00:06:38,920 --> 00:06:41,370
.لذا لا أدري كم قضت في المستوى المتقدّم

104
00:06:42,040 --> 00:06:45,380
تريد أن تصبح بشرية لتستطيع
.تأليف الموسيقى

105
00:06:54,170 --> 00:06:55,260
.أيها المعلم

106
00:06:56,500 --> 00:06:57,430
ما الأمر يا هانيدا؟

107
00:06:58,110 --> 00:07:00,350
.معدتي تؤلمني

108
00:07:00,800 --> 00:07:02,890
هل يمكنني الذهاب إلى مكتب الممرضة؟

109
00:07:02,890 --> 00:07:05,070
أجل. من تودّ مرافقتها؟

110
00:07:05,070 --> 00:07:06,770
.لا، لا بأس

111
00:07:06,770 --> 00:07:08,860
.أستطيع الذهاب بمفردي

112
00:07:09,330 --> 00:07:11,460
.لا، سيكون من السيئ أن يُغمى عليك في الرواق

113
00:07:11,830 --> 00:07:13,280
هلا ترافقها إحداكنّ؟

114
00:07:13,550 --> 00:07:14,950
!سأرافقها

115
00:07:15,310 --> 00:07:16,430
.حسنًا يا أوسامي

116
00:07:16,750 --> 00:07:18,120
.رافقيها رجاءً

117
00:07:18,120 --> 00:07:19,000
.حسنًا

118
00:07:19,000 --> 00:07:22,670
.لا، أنا على ما يرام بمفردي

119
00:07:22,670 --> 00:07:24,840
.لا تبدين كذلك، لذا اصمتي

120
00:07:25,130 --> 00:07:28,850
.ماذا؟ هذه ليست أوسامي التي أعرفها

121
00:07:28,850 --> 00:07:31,050
أليست الحصص أهمّ؟

122
00:07:31,050 --> 00:07:33,760
.أن ثرثرين كثيرًا بالنسبة لشخص مريض

123
00:07:33,760 --> 00:07:35,800
.اذهبي بسرعة لتستريحي في مكتب الممرضة

124
00:07:44,460 --> 00:07:47,540
هل ستكون توباري بخير؟

125
00:07:47,540 --> 00:07:53,110
،من النادر إصابتنا بنزلة برد حتى في هذه الهيئة
.لذا لا يسعني إلا القلق

126
00:07:53,110 --> 00:07:55,050
حقًا؟

127
00:07:55,050 --> 00:08:00,030
أجسامنا الحالية هي أجسام
.مراهقات بشريات سليمة

128
00:08:00,030 --> 00:08:04,900
.نتمتّع بصحة جسدية كاملة، تشمل اللياقة البدنية والمناعة

129
00:08:04,900 --> 00:08:07,290
.لذا لا نمرض بسهولة

130
00:08:09,240 --> 00:08:10,930
.نعم، تفضّل

131
00:08:10,930 --> 00:08:12,380
.أستأذن

132
00:08:12,380 --> 00:08:14,860
.مرحبًا أيها المعلم هيتوما

133
00:08:14,860 --> 00:08:16,050
أتبلي حسنًا؟

134
00:08:16,050 --> 00:08:18,590
.مرحبًا أيتها الطبيبة كاراسوما

135
00:08:18,950 --> 00:08:21,060
كيف حال هانيدا؟

136
00:08:21,060 --> 00:08:24,010
.تشعر بتحسّن بعد أخذ قيلولة

137
00:08:24,440 --> 00:08:26,310
.فهمت، هذا مطمئن

138
00:08:26,700 --> 00:08:29,860
.عليك التحدث إليها أيضًا أيها المعلم هيتوما

139
00:08:30,840 --> 00:08:35,240
تأتي هانيدا توباري إلى مكتب الممرضة
.في آخر لحظة دائمًا

140
00:08:35,600 --> 00:08:36,870
دائمًا؟

141
00:08:36,870 --> 00:08:42,180
تمرض في هذه الفترة من العام
.لذا اطلب منها أن تأتي مبكرًا

142
00:08:42,180 --> 00:08:44,430
.وأن تحصل على راحة كافية أيضًا

143
00:08:44,430 --> 00:08:46,350
كل عام؟

144
00:08:46,350 --> 00:08:48,660
ألديها اضطراب صحّي ما؟

145
00:08:48,660 --> 00:08:49,670
.بئسًا

146
00:08:49,670 --> 00:08:52,710
...شيء من هذا القبيل

147
00:08:54,120 --> 00:08:55,390
أيها المعلم؟

148
00:08:57,420 --> 00:08:59,300
أتيتَ لرؤيتي؟

149
00:08:59,950 --> 00:09:01,690
كيف حالك يا هانيدا؟

150
00:09:01,690 --> 00:09:04,300
.أشعر بتحسّن

151
00:09:04,300 --> 00:09:05,480
ماذا عن الصفّ؟

152
00:09:05,800 --> 00:09:10,460
تعالي إلى مكتب المعلمين
.أو غرفة تحضير الدراسات الاجتماعية بعد تعافيك

153
00:09:10,460 --> 00:09:12,300
ماذا عن حجرة تحضير الرياضيات؟

154
00:09:12,300 --> 00:09:15,730
.ذلك مخبأ المعلم هوشينو، لذا لا

155
00:09:16,470 --> 00:09:18,320
!عليه مشاركتنا إيّاها على الأقل

156
00:09:19,950 --> 00:09:23,380
لم أحظَ بفرصة للتحدث إليها على انفراد
.لذا لنواصل الحديث

157
00:09:23,860 --> 00:09:27,000
.تذكرت، قلتِ أنك مهتمة بالموسيقى

158
00:09:27,860 --> 00:09:29,170
.هذا صحيح

159
00:09:29,170 --> 00:09:32,120
أهناك موسيقى تروقك مؤخرًا؟

160
00:09:32,120 --> 00:09:32,870
ماذا؟

161
00:09:39,370 --> 00:09:41,100
!أعلم بما يذكرني هذا

162
00:09:41,100 --> 00:09:45,370
!تبدو كأب قلق على ابنته المراهقة

163
00:09:45,370 --> 00:09:46,310
ماذا؟

164
00:09:46,540 --> 00:09:48,780
أيّ موسيقى تروقني؟

165
00:09:48,780 --> 00:09:52,130
.تروقني مقاطع "أوتوماد" مؤخرًا

166
00:09:52,130 --> 00:09:53,500
أوتوماد"؟"

167
00:09:53,500 --> 00:09:55,400
.لا تعلم ماذا سيكون محتواها

168
00:09:55,660 --> 00:10:00,270
.أشاهد كل المقاطع القديمة منها والحديثة المشهورة

169
00:10:00,270 --> 00:10:04,510
...المقطع الذي يروقني حاليًا

170
00:10:04,510 --> 00:10:05,700
.هذا على الأرجح

171
00:10:08,500 --> 00:10:11,260
"اتضّح أن كايسيندونمان فاز بعشاء دجاج"

172
00:10:12,680 --> 00:10:15,570
.يصنعها شخص يُدعى هيتومان

173
00:10:15,570 --> 00:10:18,880
.من المضحك كيف يشبه ذلك اسمك

174
00:10:18,880 --> 00:10:19,850
.هذا سيئ

175
00:10:19,850 --> 00:10:22,180
!عليّ القيام بأمر ما لإخفاء شخصيتي الأخرى

176
00:10:22,180 --> 00:10:25,860
هل حاولت تأليف الموسيقى من قبل يا هانيدا؟

177
00:10:27,490 --> 00:10:29,700
.عبثت بالأصوات هنا وهناك

178
00:10:29,700 --> 00:10:32,020
.مثل المعلم هيتومان تمامًا

179
00:10:32,020 --> 00:10:33,010
ماذا؟

180
00:10:33,320 --> 00:10:34,940
...عذرًا

181
00:10:34,940 --> 00:10:39,740
إن كنتِ تشعرين بتحسّن
.فأفضّل أن تغادرا المكان

182
00:10:39,740 --> 00:10:42,140
...حسنًا

183
00:10:47,110 --> 00:10:48,540
هل يمكنك العودة إلى البيت؟

184
00:10:48,540 --> 00:10:51,310
!نعم، أنا على ما يرام

185
00:10:55,110 --> 00:10:58,320
لكنك لستَ مراعيًا، صحيح؟

186
00:10:58,320 --> 00:10:59,340
لِم لا؟

187
00:10:59,340 --> 00:11:03,820
في موقف كهذا، ألا يجب عليك إحضار
أغراضي إلى مكتب الممرضة؟

188
00:11:03,820 --> 00:11:08,050
أتعتقدين أنّي أمتلك ما يكفي من الشجاعة
للمس أغراض طالباتي؟

189
00:11:08,050 --> 00:11:09,370
.أنت محقّ

190
00:11:09,370 --> 00:11:12,030
،حركة واحدة خاطئة
.وقد يُعتبر ذلك تحرّشًا

191
00:11:12,030 --> 00:11:13,170
أليس كذلك؟

192
00:11:13,170 --> 00:11:14,980
.فكّر بهذا مليًا

193
00:11:16,140 --> 00:11:19,530
.صحيح أنّي كنت غير مراعٍ

194
00:11:21,060 --> 00:11:21,790
.هذا صحيح

195
00:11:22,150 --> 00:11:23,930
.لا خير يُرجى من التدخّل في أمور الآخرين

196
00:11:31,000 --> 00:11:33,350
.ليتني أستطيع المغادرة أيضًا

197
00:11:33,350 --> 00:11:36,380
أتقول هذا أمام طالبة حقًا؟

198
00:11:36,380 --> 00:11:39,860
ما العيب في التحدث بصدق
عن رغبتي في العودة إلى البيت؟

199
00:11:39,860 --> 00:11:43,800
.ما زال أمامي الكثير من العمل لإنجازه

200
00:11:43,800 --> 00:11:45,540
.من الرائع العودة إلى البيت

201
00:11:45,870 --> 00:11:48,080
.لا يمكنك تجاهل العمل فحسب

202
00:11:48,080 --> 00:11:50,480
.اعمل بجدّ لكن لا تجهد نفسك

203
00:11:50,870 --> 00:11:51,610
.حسنًا

204
00:11:51,610 --> 00:11:53,740
.لا تجهدي نفسك أيضًا

205
00:11:53,740 --> 00:11:56,400
أعلم أنكِ ساعدتِ
.أوسامي في دراستها ذلك اليوم

206
00:11:56,400 --> 00:11:57,960
كيف عرفت هذا؟

207
00:11:58,690 --> 00:12:00,550
.أعرف لأنّي معلمكنّ

208
00:12:01,160 --> 00:12:02,920
.تحدثتُ إلى بقية المعلمين

209
00:12:03,390 --> 00:12:07,300
تحسّنت درجات أوسامي
.في الاختبارات القصيرة بصفة عامة

210
00:12:07,300 --> 00:12:11,830
.لا يسعني إلا تشجيع شخص يبذل جهده

211
00:12:12,080 --> 00:12:15,870
.لكنك تراقبنا حقًا

212
00:12:16,210 --> 00:12:17,190
.بالطبع

213
00:12:17,190 --> 00:12:19,670
.هذا واجبي كمعلم

214
00:12:21,070 --> 00:12:25,090
.كنتُ أراقبك أيضًا

215
00:12:26,540 --> 00:12:27,720
.هذا صحيح

216
00:12:27,720 --> 00:12:30,830
.عرفتُ بأمر تلطيخي لمنديل المعلم هوشينو

217
00:12:34,500 --> 00:12:35,950
.أيها المعلم

218
00:12:36,770 --> 00:12:41,510
أنت سهل المعشر وغير مبالٍ في العادة
.لكنك تبدو حزينًا جدًا أحيانًا

219
00:12:41,510 --> 00:12:42,460
ماذا؟

220
00:12:42,460 --> 00:12:44,690
.ونظرة شاردة تعلو وجهك

221
00:12:45,220 --> 00:12:46,390
حقًا؟

222
00:12:46,390 --> 00:12:47,360
.أجل

223
00:12:47,360 --> 00:12:51,040
مثلما حدث عندما أخبرتك
.أنك غير مراعٍ في الرواق

224
00:12:53,950 --> 00:12:57,710
هل أصبت وترًا حساسًا؟

225
00:12:58,450 --> 00:13:00,210
.لا، الأمر ليس كذلك

226
00:13:00,730 --> 00:13:03,510
.أعتذر إن كنت فعلت

227
00:13:05,430 --> 00:13:07,590
الأمر كذلك حقًا؟

228
00:13:12,210 --> 00:13:16,290
.يمكنني الإنصات لك إن كان هناك ما يزعجك

229
00:13:16,290 --> 00:13:21,820
.أو إن أخبرتني، سيكون بوسعي تجنّب ذلك في المستقبل

230
00:13:22,570 --> 00:13:23,930
.لا، لا بأس

231
00:13:24,600 --> 00:13:26,820
.آسف على إزعاجك بهذا

232
00:13:27,720 --> 00:13:30,020
.كما أن ذلك بات من الماضي

233
00:13:31,260 --> 00:13:36,200
ما زلت تفكر بالأمر لأنك لا تستطيع
.نسيان الماضي

234
00:13:36,630 --> 00:13:38,420
هل أنا مخطئة؟

235
00:13:42,180 --> 00:13:45,510
.التحدث عن الأمر قد يُخفّف عنك

236
00:13:47,370 --> 00:13:49,950
.ها أنت تبدو حزينًا مجددًا

237
00:13:50,310 --> 00:13:51,490
.أعتذر

238
00:13:52,040 --> 00:13:53,680
.لا بأس

239
00:13:54,460 --> 00:13:57,500
.سأكون موجودة هنا مهما حدث

240
00:13:59,130 --> 00:14:02,550
ألا بأس بالتوقف عن حمل هذا العبء؟

241
00:14:03,810 --> 00:14:05,130
لِم لا؟

242
00:14:05,450 --> 00:14:09,730
.أعتقد أن هذه هي طريقة نسيانه

243
00:14:11,740 --> 00:14:13,010
...لأكون صادقًا

244
00:14:13,530 --> 00:14:14,220
أجل؟

245
00:14:15,790 --> 00:14:19,780
،في مدرستي السابقة
.طلبت منّي إحدى طالباتي المساعدة

246
00:14:20,670 --> 00:14:22,420
.كانت تتشاجر مع إحدى صديقاتها

247
00:14:23,660 --> 00:14:26,930
.بصفتي معلمها، أردتُ فعل ما بوسعي

248
00:14:27,660 --> 00:14:28,300
.أجل

249
00:14:30,330 --> 00:14:31,690
.لكن كان ذلك خاطئًا

250
00:14:32,600 --> 00:14:34,410
...في النهاية، بسببي

251
00:14:34,410 --> 00:14:39,410
.بسبب تدخّلي، ساءت الأمور أكثر من ذي قبل

252
00:14:40,170 --> 00:14:43,400
.تركت الطالبة المدرسة في نهاية المطاف

253
00:14:45,670 --> 00:14:49,410
،وقبل مغادرتها

254
00:14:49,410 --> 00:14:52,660
قالت أنّي عاقبتها جسديًا
.مع أني لم أمسّها قطّ

255
00:14:54,730 --> 00:14:57,570
.رفضت الإدارة الإصغاء إلى ما قلته عن المسألة

256
00:14:59,130 --> 00:15:02,390
.لهذا اضطررتُ للرحيل أيضًا

257
00:15:05,940 --> 00:15:10,180
،في آخر يوم لي
...اقتربت منّي تلك الطالبة وقالت

258
00:15:11,110 --> 00:15:13,330
!حدث كل هذا بسببك

259
00:15:15,900 --> 00:15:17,890
.وكانت محقّة

260
00:15:17,890 --> 00:15:19,220
.كنتُ مخطئًا

261
00:15:19,820 --> 00:15:20,530
...لهذا السبب

262
00:15:21,580 --> 00:15:22,620
.أيها المعلم

263
00:15:23,180 --> 00:15:25,110
.الوقت لا يبقى ثابتًا

264
00:15:25,620 --> 00:15:26,290
ماذا؟

265
00:15:27,550 --> 00:15:31,570
،قد لا تفارقك ذاتك السابقة أبدًا

266
00:15:31,570 --> 00:15:34,460
.لكن ذاتك الحالية هي ما أراه الآن

267
00:15:35,540 --> 00:15:38,520
.قد تُخطئ لكن بوسعك البدء من جديد دائمًا

268
00:15:39,210 --> 00:15:40,340
.لا تقلق

269
00:15:40,340 --> 00:15:44,380
.أنا هنا، وأراك على ما أنت عليه الآن

270
00:15:51,490 --> 00:15:52,550
.شكرًا لك

271
00:15:52,550 --> 00:15:54,330
.شكرًا لك أيضًا

272
00:15:54,330 --> 00:15:57,530
.شكرًا لك على مجيئك إلى هذه المدرسة

273
00:15:57,970 --> 00:15:58,750
ماذا؟

274
00:15:59,100 --> 00:16:00,390
.أخبرني أيها المعلم

275
00:16:00,730 --> 00:16:02,940
قلتَ أنك تريد العودة إلى البيت؟

276
00:16:09,990 --> 00:16:12,950
هانيدا-سان؟

277
00:16:13,620 --> 00:16:14,900
.أيها المعلم

278
00:16:15,290 --> 00:16:19,240
لِم لا نهرب معًا إلى مكان ما؟

279
00:16:24,150 --> 00:16:27,710
.أيُسمح لنا بالصعود إلى هنا

280
00:16:27,710 --> 00:16:30,380
ألا يغلقون باب السطح؟

281
00:16:31,100 --> 00:16:33,020
.يغلقونه في العادة

282
00:16:33,020 --> 00:16:35,300
.لا يُسمح للطالبات العاديات بالدخول

283
00:16:35,300 --> 00:16:37,010
أنتِ تخرقين قوانين المدرسة إذًا؟

284
00:16:37,010 --> 00:16:39,970
لماذا كان مفتوحًا إذًا؟

285
00:16:40,590 --> 00:16:43,400
من السهل الصعود إلى هنا إن استخدمت هذه
.لفتح القفل

286
00:16:43,400 --> 00:16:44,640
!تعلمين أنه لا يجب عليك فعل ذلك

287
00:16:46,580 --> 00:16:48,940
ألا يبعث التواجد هنا على السطح بشعور رائع؟

288
00:16:49,170 --> 00:16:51,020
.آتي إلى هنا دائمًا

289
00:16:55,560 --> 00:16:56,670
ما رأيك؟

290
00:16:56,670 --> 00:16:58,800
هل صفى ذهنك قليلًا؟

291
00:16:59,620 --> 00:17:02,580
.أجل، ربما صفى ذهني

292
00:17:02,580 --> 00:17:04,810
.أنت مضحك

293
00:17:05,130 --> 00:17:06,120
.هانيدا

294
00:17:06,120 --> 00:17:10,460
آسف، لكنك ستفقدين بعض النقاط
.لتسللك إلى السطح مخالفة القوانين

295
00:17:11,030 --> 00:17:12,640
.حسنًا، لا مانع لديّ

296
00:17:12,640 --> 00:17:15,430
،إذًا بما أنّي سأفقد النقاط على أيّ حال
ما رأيك بهذا؟

297
00:17:17,090 --> 00:17:19,660
.استدر أيها المعلم

298
00:17:19,660 --> 00:17:21,040
أستدير؟

299
00:17:21,040 --> 00:17:22,350
!ثق بي

300
00:17:28,270 --> 00:17:30,830
أهذا ما أظنه؟

301
00:17:30,830 --> 00:17:34,530
ألستِ تبالغين يا هانيدا-سان؟

302
00:17:35,330 --> 00:17:37,590
!هما ليّنان حقًا إذًا

303
00:17:37,590 --> 00:17:38,950
!مهلًا، لا يجب أن أستسلم لهذا

304
00:17:40,540 --> 00:17:44,040
.بدأت أشعر بخفّة في رأسي

305
00:17:44,040 --> 00:17:46,650
...كأن جسدي يطفو في الهواء

306
00:17:46,650 --> 00:17:47,620
...مهلًا

307
00:17:51,140 --> 00:17:53,660
!نحن نطفو يا هانيدا-سان

308
00:17:53,660 --> 00:17:55,650
.بالطبع، بما أننا نطير

309
00:17:55,650 --> 00:17:58,610
!سأخصم نقاطك لتصرّفاتك غير البشرية

310
00:17:58,610 --> 00:18:00,900
.ستسقط إن واصلت التحرك

311
00:18:01,260 --> 00:18:02,710
.لا تقلق

312
00:18:02,710 --> 00:18:05,180
.تصرّف بشكل طبيعي ولن أسقطك

313
00:18:05,180 --> 00:18:07,090
أتدركين كم هذا مخيف؟

314
00:18:07,090 --> 00:18:09,720
!تطلق غريزة الأمان لديّ الإنذار

315
00:18:09,720 --> 00:18:11,610
.هذه طريقة غريبة للتعبير عن ذلك

316
00:18:11,610 --> 00:18:15,310
.في هذه الحالة، ضع ذراعيك حول رقبتي

317
00:18:15,310 --> 00:18:15,940
ماذا؟

318
00:18:17,300 --> 00:18:19,520
أتشعر بتحسّن الآن؟

319
00:18:19,520 --> 00:18:22,990
...أجل، أشعر بأمان أكبر

320
00:18:23,460 --> 00:18:26,160
.مع أن هذا يصيبني بتوتر مختلف

321
00:18:26,160 --> 00:18:28,710
هل تفكر في أمر قذر؟

322
00:18:28,710 --> 00:18:30,490
.لا، على الإطلاق

323
00:18:30,490 --> 00:18:31,500
.جيد

324
00:18:31,500 --> 00:18:33,000
.هيّا، انظر

325
00:18:41,180 --> 00:18:43,590
،عند رؤية السماء من الأعلى

326
00:18:43,980 --> 00:18:46,730
.تبدو أكبر بكثير وأجمل مما تبدو عليه من الأسفل

327
00:18:47,150 --> 00:18:50,770
.أردتُ أن أريك ما تبدو عليه

328
00:18:52,710 --> 00:18:53,800
.أيها المعلم

329
00:18:53,800 --> 00:18:59,640
أريد أن أكون مثل هذه السماء
.وأقبلك كما أنت

330
00:19:00,030 --> 00:19:01,530
هل تعترفين لي؟

331
00:19:01,530 --> 00:19:03,640
.لا تغترّ بنفسك

332
00:19:04,230 --> 00:19:05,530
...أعتذر

333
00:19:11,170 --> 00:19:12,230
.شكرًا لك

334
00:19:13,300 --> 00:19:15,340
هل استمتعت أيها المعلم؟

335
00:19:15,870 --> 00:19:17,210
.استمعتُ حقًا

336
00:19:17,770 --> 00:19:21,750
.لكنك خرقتِ العديد من القوانين أمام معلم

337
00:19:22,220 --> 00:19:24,260
.لا تلوميني إن لم تتمكني من أن تصبحي بشرية

338
00:19:25,420 --> 00:19:26,960
.لا بأس بذلك

339
00:19:26,960 --> 00:19:31,190
.في الحقيقة، يسعدني أن أراك تعاملني بعدل

340
00:19:31,190 --> 00:19:33,530
ألا تريدين أن تصبحي بشرية؟

341
00:19:33,530 --> 00:19:34,860
.بلى

342
00:19:35,560 --> 00:19:40,280
.لكنّي لستُ مضطرّة للتحوّل بعد

343
00:19:40,900 --> 00:19:42,200
ما الذي يعنيه هذا؟

344
00:19:44,010 --> 00:19:45,350
.هذا سرّ للوقت الراهن

345
00:19:47,230 --> 00:19:49,550
.ستفقد نقاطًا بسبب ما فعلته اليوم

346
00:19:50,360 --> 00:19:54,290
فعلت كل ذلك لتحضرني إلى هنا
.محاولةً مواساتي

347
00:19:54,610 --> 00:19:56,680
.مع ذلك، أنا معلم

348
00:19:57,510 --> 00:20:00,220
،فيما عدا الاختبارات الدراسية
.كل ما يمكنني فعله هو سلب النقاط

349
00:20:01,420 --> 00:20:02,190
...لماذا إذًا لا

350
00:20:03,270 --> 00:20:04,650
.أخبريني يا هانيدا

351
00:20:05,850 --> 00:20:08,580
تحبين الموسيقى، صحيح؟

352
00:20:08,580 --> 00:20:10,100
.أجل، هذا صحيح

353
00:20:10,410 --> 00:20:12,190
.سماع الموسيقى والغناء

354
00:20:12,660 --> 00:20:16,650
هلا تغنين لي الآن إذًا؟

355
00:20:16,650 --> 00:20:18,080
هنا؟

356
00:20:18,080 --> 00:20:20,540
.شاهدتِ مقطعي في مكتب الممرضة

357
00:20:20,540 --> 00:20:22,210
.اعتبريه تبادلًا منصفًا

358
00:20:22,520 --> 00:20:23,690
ماذا؟

359
00:20:23,690 --> 00:20:25,620
ألم تأخذ التحليق بعين الاعتبار؟

360
00:20:25,620 --> 00:20:28,760
.كان ذلك خرقًا صارخًا للقوانين، لذا لا

361
00:20:28,760 --> 00:20:31,090
.قلت أنه كان ممتعًا

362
00:20:31,510 --> 00:20:34,030
.إن كنتِ تفضلين عدم فعل ذلك فلا بأس

363
00:20:34,030 --> 00:20:35,300
ماذا؟

364
00:20:41,720 --> 00:20:45,220
ألا بأس بهذا حتى لو لم يكن غنائي جيدًا؟

365
00:20:45,220 --> 00:20:46,230
.دعيني أسمعه

366
00:20:48,940 --> 00:20:51,130
.هذه المرة فقط إذًا