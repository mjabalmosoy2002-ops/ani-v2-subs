844
01:12:47,000 --> 01:12:48,240
...هذا

845
01:13:02,640 --> 01:13:03,950
!القائد

846
01:13:22,320 --> 01:13:26,200
...إذن فهذا أنت؟ الشخص الذي جعلني أقاتل بجديّة

847
01:13:28,230 --> 01:13:30,440
!صباح الخير، يا كين-تشان

848
01:13:31,710 --> 01:13:34,530
!لا تسقطي، يا ياتشيرو

849
01:13:34,750 --> 01:13:36,780
.يا لك من سريع

850
01:13:57,030 --> 01:14:00,330
!لا نهاية لهؤلاء الأوغاد

851
01:14:01,200 --> 01:14:03,660
!توقفي، يا روكيا

852
01:14:11,710 --> 01:14:21,430
هذا الرجل... يجب علينا أن نمحي ذكرى هذا
.الرجل، بهذه الطريقة لن يتذكر أحدهم روكيا

853
01:14:21,930 --> 01:14:27,320
.نعم، بالنسبة لنا روكيا أكثر أهمية من أي شيء

854
01:14:27,320 --> 01:14:31,710
!أيها الأحمقان! الذكريات ليست كل شيء

855
01:14:31,710 --> 01:14:36,040
!روح رينجي... وروحي كذلك تتذكر! وروح روكيا أيضًا

856
01:14:36,900 --> 01:14:41,190
!لن تسلبا هذا منا

857
01:14:44,920 --> 01:14:46,000
.روكيا

858
01:14:54,630 --> 01:14:55,590
.روكيا

859
01:15:17,670 --> 01:15:18,580
.كيسكي

860
01:15:18,580 --> 01:15:20,000
.لا يمكننا الاستمرار هكذا

861
01:15:20,000 --> 01:15:21,700
.إنه ضخمٌ للغاية

862
01:15:21,700 --> 01:15:27,090
.يجب علينا أن نذهب للمختبر للاعتناء بهذا

863
01:15:27,090 --> 01:15:30,890
...ولكنه في طريقنا

864
01:15:31,610 --> 01:15:32,670
ما هذا؟

865
01:15:34,930 --> 01:15:36,460
!لا تبقَ ورائي، يا يوميتشكي

866
01:15:36,460 --> 01:15:38,780
أعاد زاراكي للحياة؟

867
01:15:39,070 --> 01:15:43,200
!جميعًا، هذه هي فرصتنا، لنغتنم هذه الفرصة ونتوجه للمختبر

868
01:15:43,200 --> 01:15:45,980
.فلتتبعثر، يا سينبونزاكورا

869
01:15:50,190 --> 01:15:51,920
...كوتشيكي-سان

870
01:15:51,920 --> 01:15:54,140
.كما هو متوقعٌ منكَ، أيها الفتى بيا

871
01:15:54,640 --> 01:15:56,000
.سأذهب أولًا

872
01:15:56,000 --> 01:15:58,140
.أعتمد عليك، أيها القائد كوتشيكي

873
01:16:18,560 --> 01:16:21,660
دايغورين هيورينمارو

874
01:16:24,850 --> 01:16:26,530
.المعذرة، أيها القائد هيتسوغايا

875
01:16:26,530 --> 01:16:27,520
.لا تكن رسميًّا

876
01:16:27,520 --> 01:16:28,500
!لننطلق

877
01:16:34,590 --> 01:16:36,430
ريوسينكا

878
01:16:39,350 --> 01:16:41,860
.حسنًا، سآخذ الأمر على محمل الجدِّ أيضًا

879
01:16:47,810 --> 01:16:49,340
.فلتُمزقي، يا بينيهيمي

880
01:17:05,210 --> 01:17:07,380
!احذر! خلفك، يا إيتشيغو

881
01:17:10,870 --> 01:17:13,260
فن الباكودو رقم 61

882
01:17:13,260 --> 01:17:15,000
ريكوجو كورو

883
01:17:30,860 --> 01:17:32,260
.القائد

884
01:17:32,260 --> 01:17:33,350
.بياكويا

885
01:17:34,580 --> 01:17:36,140
من أنت؟

886
01:17:47,330 --> 01:17:48,370
!بياكويا

887
01:17:49,110 --> 01:17:51,780
،إن كان ما قالاه صحيح

888
01:17:52,700 --> 01:17:57,030
.فيجب علي أن أدمرها

889
01:18:02,040 --> 01:18:05,600
!مهلًا، روكيا ما زالت هناك

890
01:18:05,970 --> 01:18:09,020
،لا يهم ما يحصل
!فنحن ما زلنا مرتبطان

891
01:18:11,110 --> 01:18:12,630
!روكيا

892
01:18:12,630 --> 01:18:14,780
!أليس هذا صحيحٌ، يا روكيا؟

893
01:18:22,990 --> 01:18:28,140
...لقد بدأت الرياتسو بالتحول إلى هولو، هذا مستحيل

894
01:18:30,090 --> 01:18:31,830
...أختي

895
01:18:37,140 --> 01:18:38,030
!كون

896
01:18:38,570 --> 01:18:45,130
!أنقد أختي

897
01:18:45,130 --> 01:18:46,560
!أختي

898
01:18:49,850 --> 01:18:52,430
أتود أن تنقذ عائلتك؟

899
01:18:54,010 --> 01:18:55,980
!بالطبع

900
01:18:55,980 --> 01:18:57,980
أثمة طريقة لإنقاذهم؟

901
01:18:58,740 --> 01:19:00,750
.واحدةٌ فحسب

902
01:19:01,590 --> 01:19:04,810
!يجب عليك أن تصبح شينيغامي

903
01:19:05,310 --> 01:19:13,220
.سواءً نجحت أم لا، أنا لست متأكدة
!ولكن، إذا فشلت، أنا وأنت سنموت معًا

904
01:19:20,770 --> 01:19:35,030
!لقد ضحت بحياتها من أجل إنقاذي أنا وعائلتي
!لن أستسلم مطلقًا

905
01:19:38,590 --> 01:19:41,100
.افعل ما تريد

906
01:19:56,170 --> 01:20:00,160
!لنقتله، لنقتل الشينيغامي

907
01:20:01,130 --> 01:20:07,110
!ها أنا آتٍ، يا روكيا
!هذه المرة أنا من سيمدّكِ بالقوة

908
01:20:17,400 --> 01:20:19,970
!افتحي عينيكِ، يا روكيا

909
01:20:20,540 --> 01:20:25,340
.أنا كوروساكي إيتشيغو

910
01:20:32,840 --> 01:20:33,840
...روكيا

911
01:20:35,130 --> 01:20:37,530
ماذا فعل ذلك الوغد؟

912
01:21:18,280 --> 01:21:19,980
بان كاي

913
01:21:19,980 --> 01:21:22,920
سينبون زاكورا كاغيوش

914
01:21:29,370 --> 01:21:31,630
مدفع العظم

915
01:21:54,000 --> 01:21:56,520
.يبدو أنهم اعتنوا بالأمر

916
01:22:06,820 --> 01:22:08,100
...إيتشيغو

917
01:22:10,630 --> 01:22:11,620
.مرحبًا

918
01:22:22,790 --> 01:22:23,570
.إيتشيغو

919
01:22:24,470 --> 01:22:25,790
.اذهبي بسرعة

920
01:22:30,080 --> 01:22:31,300
...أنتما

921
01:22:32,170 --> 01:22:34,020
...روكيا

922
01:22:34,360 --> 01:22:35,570
هل هذه أنتِ، يا روكيا؟

923
01:22:35,710 --> 01:22:37,190
.نعم، هذا أنا

924
01:22:38,010 --> 01:22:40,420
لقد عُوقبنا، هاه؟

925
01:22:40,890 --> 01:22:43,820
.لعدم استماعنا لروكيا

926
01:22:44,460 --> 01:22:49,120
...روكيا، لا تكرهي أختي

927
01:22:55,100 --> 01:22:57,060
.أنجدينا، يا روكيا

928
01:22:57,060 --> 01:23:00,240
!روكيا! روكيا -

929
01:22:57,060 --> 01:23:00,240
أين أنتما؟ -

930
01:23:04,990 --> 01:23:06,010
!روكيا

931
01:23:06,200 --> 01:23:07,870
.شينيغامي

932
01:23:07,870 --> 01:23:09,000
!توقف

933
01:23:16,270 --> 01:23:17,630
...أنتما

934
01:23:17,750 --> 01:23:19,210
.روكيا

935
01:23:19,210 --> 01:23:20,700
هل أنتما على ما يرام؟

936
01:23:20,700 --> 01:23:21,940
!روكيا، خلفكِ

937
01:23:29,100 --> 01:23:30,960
.روكيا مذهلة

938
01:23:31,110 --> 01:23:35,310
مهلًا. من هذا؟

939
01:23:35,310 --> 01:23:39,030
...لا أريد هذا الهراء

940
01:23:39,030 --> 01:23:42,450
.هذا الجسد ليس جيدًا بما يكفي

941
01:23:42,450 --> 01:23:43,610
.اهربا

942
01:23:51,640 --> 01:23:54,760
...أنتَ لست بشينيغامي

943
01:23:54,760 --> 01:23:56,560
!بل أنت وحش

944
01:24:01,570 --> 01:24:03,010
!روكيا

945
01:24:09,700 --> 01:24:12,270
!ابتعد عن روكيا، أيها الشينيغامي

946
01:24:14,580 --> 01:24:16,080
!أنتِ تعترضين طريقي

947
01:24:23,820 --> 01:24:25,310
!أختي

948
01:24:33,660 --> 01:24:44,310
...عندما استيقظت لم أرَكما
...وقد نسيت أمركما

949
01:24:44,810 --> 01:24:49,950
.هذا لأن ذلك الهولو محى ذكرياتكِ

950
01:24:50,010 --> 01:24:57,000
.بالإضافة إلى أن هذين الاثنين لديهما القدرة على التلاعب بالفضاء

951
01:24:57,000 --> 01:25:04,600
،من المحتمل، كمحاولةٍ أخيرة من أجل أن ينقذاكِ
.نقلا الهولو إلى جسديهما

952
01:25:05,140 --> 01:25:16,190
،وبدون أن يلاحظا، انتهى بهما المطاف في الويكو موندو
.يائسان، ولكن الهولو كان لا يزال واعيًا

953
01:25:16,660 --> 01:25:24,040
.ومن ثمَّ عادا بسبب رغبتهما الشديدة لرؤيتكِ

954
01:25:25,750 --> 01:25:27,190
أتذكرين الآن؟

955
01:25:28,080 --> 01:25:30,220
.المعذرة لكذبنا عليكِ

956
01:25:31,790 --> 01:25:36,850
.الحقيقة هي أننا مُتنا في ذلك الوقت

957
01:25:36,850 --> 01:25:41,840
.أنتما لم تختفيا! فالموت ليس النهاية

958
01:25:42,580 --> 01:25:48,490
.ألم تعودا؟ لقد كنت سعيدةً للغاية

959
01:25:48,490 --> 01:25:50,670
!لقد كنت سعيدةً للغاية

960
01:25:51,230 --> 01:25:53,710
.لأننا أردنا رؤيتكِ مجددًا

961
01:25:54,380 --> 01:25:56,800
.لا يوجد لدينا سواكِ

962
01:25:58,630 --> 01:26:01,110
.أنتما لستما لوحدكما

963
01:26:01,110 --> 01:26:07,170
أكثر شخصٍ مهم بالنسبة لكما
.لطالما كان إلى جانبكما

964
01:26:10,690 --> 01:26:13,790
...لقد تذكرت اسميكما

965
01:26:15,660 --> 01:26:18,140
.هومورا وشيزوكو

966
01:26:18,140 --> 01:26:21,290
."إذا جمعتهما معًا فستعني "القوي المتألق

967
01:26:22,390 --> 01:26:23,640
.هومورا

968
01:26:23,640 --> 01:26:25,140
.شيزوكو

969
01:26:27,480 --> 01:26:28,730
...يا لهما من اسمين رائعين

970
01:26:30,580 --> 01:26:34,500
.وددت أن أسمعهما منكِ

971
01:26:34,500 --> 01:26:35,640
.أنا سعيد

972
01:26:37,330 --> 01:26:38,810
.شيزوكو

973
01:26:38,810 --> 01:26:40,810
.أختي هومورا

974
01:26:42,420 --> 01:26:43,810
.شكرًا لكِ

975
01:26:47,970 --> 01:26:50,410
.وداعًا، يا روكيا

976
01:26:54,360 --> 01:27:00,490
!هومورا! شيزوكا! لا تذهبا

977
01:27:00,490 --> 01:27:08,980
!هومورا! شيزوكا! أجيباني! أجيباني

978
01:27:41,730 --> 01:27:47,490
.تبدو جيّدة، هاه؟ لقد نسخنا رسمكِ

979
01:27:53,060 --> 01:27:55,240
هل أنتَ عائدٌ، يا إيتشيغو؟

980
01:27:55,240 --> 01:27:56,050
.نعم

981
01:27:57,120 --> 01:27:59,760
.لقد أنقذتني مجددًا

982
01:28:00,540 --> 01:28:03,440
.حسنًا، لقد أنقذتني أولًا

983
01:28:06,090 --> 01:28:14,250
.إذا كان الموت ليس النهاية حقًا بالنسبة لنا، فلقاؤنا غير المتوقع ربما يكون بداية

984
01:28:15,370 --> 01:28:19,070
.ربما أننا ارتبطنا لفترةٍ أطول بكثير

985
01:28:20,610 --> 01:28:25,600
أنا لا أعلم حقًا، ولكن عندما تكون هنالك رابطة، فمن المستحيل أن تختفي

986
01:28:25,960 --> 01:28:31,730
.لذا، حتى وإن نسينا كل شيء، فتلك الرابطة ستعود مجددًا

987
01:28:32,590 --> 01:28:35,610
.مثلكِ أنتِ وذان الشقيقان

988
01:28:40,630 --> 01:28:44,030
.أراكِ لاحقًا
.أنا ذاهبٌ أولًا، أيتها الشينيغامي

989
01:28:44,030 --> 01:28:45,750
.أنا لست بشينيغامي

990
01:28:46,310 --> 01:28:49,020
.بل أنا كوتشيكي روكيا

991
01:33:06,960 --> 01:33:08,970
.مهلًا

992
01:33:08,970 --> 01:33:10,970
!أحدكم

993
01:33:11,490 --> 01:33:16,960
!لمَ لمْ يأتِ أحدٌ ما لإنقاذي؟

994
01:33:20,770 --> 01:33:25,650
...إيتشيغو، لا تقل لي أنك نسيتني

995
01:33:25,650 --> 01:33:32,100
!أولًا أختي والآن أنت... اللعنة

996
01:33:33,490 --> 01:33:39,910
.أختي

997
01:33:40,850 --> 01:33:43,400
.لا تنسنِي