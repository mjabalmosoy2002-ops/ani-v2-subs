1
00:00:21,440 --> 00:00:23,000
.يا إلهي

2
00:00:23,000 --> 00:00:26,250
لا يستيقظ ماسارو قبل الظّهيرة
.أبدًا في أيّام الأحد

3
00:00:26,250 --> 00:00:28,890
!لا بدّ أنّ هذا التّغيير بفضل أغو-تشان

4
00:00:30,320 --> 00:00:31,760
!المزيد

5
00:00:31,760 --> 00:00:32,720
.حسنًا، حسنًا

6
00:00:32,720 --> 00:00:34,130
.أمهلاني لحظة

7
00:00:34,130 --> 00:00:35,090
.تفضّل يا أغو-تشان

8
00:00:35,090 --> 00:00:36,510
وماذا عنّي يا أمّي؟

9
00:00:36,510 --> 00:00:38,680
!قدّمي لي طعامًا قبله

10
00:00:38,680 --> 00:00:42,350
.لم أقل أنّي لن أعطيك حصّتك
.انتظر قليلاً فحسب

11
00:00:42,790 --> 00:00:45,310
.ما زال أغو-تشان طفلاً قبل كلّ شيئًا

12
00:00:45,670 --> 00:00:48,160
وهل هذا حجم طفل؟

13
00:00:51,050 --> 00:00:52,030
!أعطني ذلك

14
00:00:52,230 --> 00:00:56,260
لن أسمح لأيّ أحد بأخذ آخر بيضة مقليّة
!من سايوري حتّى لو كنتَ أنت

15
00:00:59,770 --> 00:01:01,950
!ابصق ذلك! أعطني إيّاها

16
00:01:01,950 --> 00:01:02,950
!مستحيل

17
00:01:02,950 --> 00:01:07,310
!وكفّ عن مناداة أمّي باسمها الشّخصيّ

18
00:01:06,520 --> 00:01:07,880
.يا للأطفال

19
00:01:17,590 --> 00:01:18,890
.توما-ساما

20
00:01:18,890 --> 00:01:21,310
.الحرارة اليوم 17 درجة

21
00:01:21,310 --> 00:01:24,740
،إنّ الجوّ أدفأ قليلاً عن النّمسا
أليس كذلك؟

22
00:01:35,390 --> 00:01:37,610
ما الّذي تفعله يا أغو-تشان؟

23
00:01:38,260 --> 00:01:41,410
!تشيكا
!ساعديني على دخول السّلّة

24
00:01:41,410 --> 00:01:43,080
حسنًا، ولكن لماذا؟

25
00:01:43,440 --> 00:01:47,250
لا أريد مواصلة الرّكض خلف
!أنيكي طوال الوقت

26
00:01:51,530 --> 00:01:52,750
...يا لك من طفل

27
00:01:52,750 --> 00:01:54,440
...سُحقًا

28
00:01:56,370 --> 00:01:57,980
!رافقتك السّلامة

29
00:02:00,910 --> 00:02:03,930
!تشجّع يا أنيكي! تشجّع يا أنيكي

30
00:02:03,930 --> 00:02:07,600
لماذا عليّ أن أحملك على ظهري؟

31
00:02:07,600 --> 00:02:12,670
،أنت من قال لي
"!أنت دمية محشوّة، فلا تتحرّك"

32
00:02:13,970 --> 00:02:15,830
...ما باليد حيلة إذًا

33
00:02:19,260 --> 00:02:22,120
مهلاً... ما الزّرّ الّذي عليّ ضغطه؟

34
00:02:22,120 --> 00:02:23,840
...هذا؟ لا

35
00:02:25,690 --> 00:02:28,410
.معك المقرّ الرّئيسيّ
.التقطنا إشارة ديجيمون

36
00:02:28,580 --> 00:02:29,620
!أين؟

37
00:02:29,750 --> 00:02:32,170
.المنطقة سي-7
أيمكنك الذّهاب إلى هناك مباشرة؟

38
00:02:32,170 --> 00:02:33,540
!نعم! دعوا الأمر لنا

39
00:02:33,540 --> 00:02:34,550
!لنا

40
00:02:36,910 --> 00:02:38,510
...كم هذا مملّ

41
00:02:38,670 --> 00:02:41,260
...لا شيء يحدث هنا على الإطلاق

42
00:02:41,260 --> 00:02:43,300
!على الإطلاق

43
00:02:43,300 --> 00:02:44,350
...نعم، نعم

44
00:02:44,350 --> 00:02:46,470
مهلاً، ما خطب صوتك؟

45
00:02:46,470 --> 00:02:47,600
ماذا؟

46
00:02:47,600 --> 00:02:49,030
عمّ تتحدّث؟

47
00:02:58,640 --> 00:02:59,530
ما هذا؟

48
00:02:59,530 --> 00:03:00,750
!وجدتُه

49
00:03:01,350 --> 00:03:02,490
!لنتقاتل

50
00:03:03,640 --> 00:03:05,130
...نتقاتل

51
00:03:08,600 --> 00:03:10,710
!أنيكي! سأهاجم

52
00:03:10,710 --> 00:03:12,270
!اللّهب الصّغير

53
00:03:15,400 --> 00:03:17,840
!لم يكل لهجومي أيّ تأثير

54
00:03:17,840 --> 00:03:22,590
أنيكي، أعطني ذلك الشّيء
!المطقطق والمتفجّر

55
00:03:22,590 --> 00:03:24,010
الرّوح الرّقميّة؟

56
00:03:24,010 --> 00:03:25,140
!انتظر

57
00:03:28,620 --> 00:03:30,310
ما خطب هذا؟

58
00:03:30,310 --> 00:03:32,980
!إنّه خفيف جدًّا، لذلك لا تلمسه لكماتي

59
00:03:37,010 --> 00:03:39,590
!أنت لستَ صلبًا بما يكفي

60
00:03:39,840 --> 00:03:44,160
،لو استطعتُ إصابتك ولو لمرّة
!أستطيع جعل أغومون يتطوّر

61
00:03:50,330 --> 00:03:53,370
!لا يستطيع أنيكي الحصول على روحه الرّقميّة

62
00:03:58,610 --> 00:03:59,670
!لنتبعه يا أغومون

63
00:03:59,670 --> 00:04:01,020
!حاضر يا أنيكي

64
00:04:04,540 --> 00:04:06,430
ما كان ذلك؟

65
00:04:06,430 --> 00:04:08,890
وحش ناريّ... وسحليّة؟

66
00:04:08,890 --> 00:04:10,430
.إنّهم يُسمّون ديجيمون

67
00:04:10,430 --> 00:04:13,060
.لكن ليس عليكم تذكّر ذلك

68
00:04:18,670 --> 00:04:20,790
.تمّ محو الذّاكرة

69
00:04:21,190 --> 00:04:23,250
.تمّ تأمين طريق المطاردة

70
00:04:23,600 --> 00:04:25,160
.هيّا بنا يا غاومون

71
00:04:25,160 --> 00:04:26,990
.حاضر يا سيّدي

72
00:05:31,970 --> 00:05:33,640
"!عودة العبقريّ توما للدّيار"

73
00:05:33,850 --> 00:05:35,480
"!الإطاحة بميرامون"

74
00:05:36,210 --> 00:05:37,480
...سُحقًا

75
00:05:37,960 --> 00:05:39,940
...أغضبني ذلك الشّيء

76
00:05:42,220 --> 00:05:46,340
كنتُ أتوقّع أنّ الأمر لن يتمّ
...بسهولة من البداية

77
00:05:47,640 --> 00:05:48,950
.ذلك صحيح

78
00:05:51,350 --> 00:05:53,620
.تمّ تأمين الدّيجيمون

79
00:05:57,020 --> 00:05:58,790
مـ-من تكون؟

80
00:05:58,790 --> 00:06:00,210
!توما-ساما

81
00:06:00,540 --> 00:06:01,540
متى عدت؟

82
00:06:01,540 --> 00:06:03,650
!يا لها من مفاجأة

83
00:06:04,200 --> 00:06:05,980
!أنا جدّ سعيدة

84
00:06:04,660 --> 00:06:05,980
!وأنا كذلك

85
00:06:09,870 --> 00:06:11,490
ومن أنت؟

86
00:06:14,160 --> 00:06:16,580
!لقد تجاهلني! يا له من وغد

87
00:06:18,130 --> 00:06:19,140
!يا هذا

88
00:06:19,400 --> 00:06:20,980
!لقد أخذت فريستي منّي

89
00:06:26,690 --> 00:06:28,500
هل تريد القتال؟

90
00:06:34,770 --> 00:06:35,790
.أيّها القائد ساتسوما

91
00:06:36,560 --> 00:06:38,540
.توما إتش نورشتاين

92
00:06:38,710 --> 00:06:42,250
سأتولّى منصبي هنا في فرع داتس
.ابتداءً من اليوم

93
00:06:44,110 --> 00:06:45,600
.سررت بتواجدك هنا

94
00:06:47,200 --> 00:06:49,220
...لقد راجعتُ التّقارير المكتوبة

95
00:06:49,220 --> 00:06:53,180
ويبدو من الغريب أن تظهر أعداد
.كبيرة من الدّيجيمون في هذا البلد مؤخّرًا

96
00:06:53,790 --> 00:06:55,890
!مظهره الصّارم رائع جدًّا

97
00:06:55,890 --> 00:06:56,390
!معك حقّ

98
00:06:57,790 --> 00:07:01,060
هل أعداد الظّهور أقلّ
من هذا في الاتّحاد الأوروبّيّ؟

99
00:07:01,500 --> 00:07:05,540
.نعم. ربّما السّبب راجع للمساحة الكبيرة

100
00:07:08,800 --> 00:07:12,010
.عفوًا، اسمحا لي بتقديمكما
...هذا هو

101
00:07:13,390 --> 00:07:14,410
!أنت

102
00:07:15,310 --> 00:07:17,790
...لا أهتمّ إن كان اسمك توما أو بومة

103
00:07:17,950 --> 00:07:21,370
!ولكن في هذا المكان، لديّ الأقدميّة

104
00:07:21,370 --> 00:07:27,650
،صحيح أنّي هنا منذ ثلاثة أيّام فقط
!لكن نادني دايمون-سان أو دايمون-سينباي

105
00:07:28,410 --> 00:07:30,730
اختار إشعال نيران الحرب من البداية؟

106
00:07:31,280 --> 00:07:33,760
.في الحقيقة، توما أقدم منك هنا يا ماسارو

107
00:07:36,540 --> 00:07:40,730
كان توما جزءًا من فرع اليابان
.قبل مغادرته منذ ستّة أشهر

108
00:07:40,850 --> 00:07:44,690
لقد ساعدنا في السّيطرة على
.الدّيجيمون وتطوير معدّات النّقل

109
00:07:44,690 --> 00:07:50,110
عندما طلب مقرّ الاتّحاد الأوروبّيّ
.مساعدته بشدّة، التحق بهم مؤقّتًا

110
00:07:50,110 --> 00:07:53,110
،لـ-لكن مهما نظرنا للأمر
...فهو في نفس عمري

111
00:07:53,110 --> 00:07:57,580
لكنّ توما-ساما عبقريّ تخرّج من معهد العلوم
!في جامعة ستوكهولم في السّنة الثّالثة عشرة

112
00:07:57,580 --> 00:08:00,120
!وكان الأوّل في دفعته

113
00:08:00,370 --> 00:08:01,830
!عبقريّ؟

114
00:08:02,310 --> 00:08:06,540
إضافة لذلك، تعدّ عائلة نورشتاين واحدة
.من أبرز العائلات النّبيلة في النّمسا

115
00:08:06,540 --> 00:08:08,720
!إنّه بمثابة أمير

116
00:08:09,240 --> 00:08:10,690
أمير...؟

117
00:08:11,530 --> 00:08:14,680
...أمّا بالنّسبة لغاومون، شريك توما

118
00:08:14,680 --> 00:08:18,640
فإنّه لا مثيل لقدراته القتاليّة
.بين الدّيجيمون في داتس

119
00:08:18,640 --> 00:08:21,100
.إنّهما بالفعل أقوى ثنائيّ

120
00:08:21,100 --> 00:08:23,560
...لا... مثيل

121
00:08:24,000 --> 00:08:26,770
احرصوا على أن تنسجموا معًا
.بما أنّكم زملاء

122
00:08:27,760 --> 00:08:30,610
أعتقد أنّه لن تكون هنالك فائدة
.من ذلك أيّها القائد ساتسوما

123
00:08:30,610 --> 00:08:35,040
لا أرى أنّ داتس ستستفيد من هذا
.الشّخص بأيّ شكل من الأشكال

124
00:08:36,780 --> 00:08:38,280
!ما الّذي تعنيه؟

125
00:08:40,070 --> 00:08:43,460
.يجب طرد أمثاله فورًا

126
00:08:44,120 --> 00:08:46,790
لماذا لا تقول ذلك في وجهي؟

127
00:08:47,080 --> 00:08:49,380
!انظر إلى عيني الشّخص عندما تكلّمه

128
00:08:49,380 --> 00:08:51,000
.حسنًا إذًا

129
00:08:51,000 --> 00:08:54,220
.أنت وشريكك لستما مناسبين لداتس

130
00:08:54,500 --> 00:08:55,550
!توما

131
00:08:55,550 --> 00:08:56,260
!...أيّها الـ

132
00:08:56,260 --> 00:08:57,680
!نل منه يا أنيكي

133
00:09:01,050 --> 00:09:02,430
.عجبًا

134
00:09:02,430 --> 00:09:06,190
تريد مواجهتي بمستوى القوّة ذاك؟

135
00:09:06,190 --> 00:09:07,520
.كم هذا مثير للشّفقة

136
00:09:08,310 --> 00:09:10,190
ما الّذي تعنيه بذلك؟

137
00:09:10,190 --> 00:09:13,200
!ما مدى قوّتك أنت إذًا؟

138
00:09:13,730 --> 00:09:15,400
هل عليّ الرّدّ على ذلك؟

139
00:09:15,700 --> 00:09:17,160
!نعم

140
00:09:17,160 --> 00:09:18,910
!هيّا، أرني

141
00:09:18,910 --> 00:09:21,710
!لنرَ إن كان بإمكانك إثبات كلّ ادّعاءاتك

142
00:09:27,120 --> 00:09:29,880
!اسمع! ارتدِ واقي الرّأس هذا

143
00:09:29,880 --> 00:09:30,790
!لا أحتاجه

144
00:09:31,170 --> 00:09:33,510
!كما أنّه لا يرتديه أيضًا

145
00:09:36,420 --> 00:09:37,800
...هذا هو الأسوأ

146
00:09:37,800 --> 00:09:39,800
.لا بأس، افعل ما يحلو لك

147
00:09:40,050 --> 00:09:41,020
.طبعًا

148
00:09:41,470 --> 00:09:43,680
!أطح به يا أنيكي

149
00:09:48,060 --> 00:09:51,520
إنّك تضع كلّ ثقتك في قوّتك الجسديّة
.دون استخدام أيّ استراتيجيّة أو تكتيكات

150
00:09:51,810 --> 00:09:53,030
!اخرس

151
00:09:54,640 --> 00:09:56,650
لماذا انضممت لداتس؟

152
00:09:56,860 --> 00:09:57,740
!ماذا؟

153
00:09:57,740 --> 00:09:59,950
!انضممتُ لأستطيع الفوز بالطّبع

154
00:10:00,360 --> 00:10:01,410
الفوز ضدّ من؟

155
00:10:01,620 --> 00:10:03,160
!الخصوم الأقوياء

156
00:10:06,500 --> 00:10:08,260
.يا لها من قصّة مملّة

157
00:10:08,820 --> 00:10:11,210
.تؤدّي داتس مهمّة هامّة

158
00:10:11,540 --> 00:10:16,130
.ولكلّ عضو التزامٌ ومسؤوليّة للقيام بذلك

159
00:10:16,750 --> 00:10:18,090
!اخرس

160
00:10:18,090 --> 00:10:20,340
!كفّ عن التّصرّف كأنّك من النّخبة

161
00:10:22,420 --> 00:10:23,760
.وضعه ميؤوس منه

162
00:10:28,430 --> 00:10:30,030
!أنيكي

163
00:10:30,430 --> 00:10:31,860
!واحد

164
00:10:31,860 --> 00:10:32,900
!اثنان

165
00:10:33,150 --> 00:10:34,400
!ثلاثة

166
00:10:34,400 --> 00:10:35,650
!أربعة

167
00:10:35,650 --> 00:10:36,900
!خمسة

168
00:10:36,900 --> 00:10:38,030
!ستّة

169
00:10:38,030 --> 00:10:39,200
!سبعة

170
00:10:39,200 --> 00:10:40,320
!ثمانية

171
00:10:40,320 --> 00:10:41,570
!تسعة

172
00:10:41,570 --> 00:10:42,700
!عشرة

173
00:10:42,700 --> 00:10:44,080
!فاز توما

174
00:10:48,910 --> 00:10:52,970
لا حاجة لنا بالأشخاص الوقحين
.والسّوقيّين في داتس

175
00:10:54,090 --> 00:10:55,800
...أنيكي

176
00:10:54,090 --> 00:10:55,800
...كما توقّعت

177
00:10:55,800 --> 00:10:56,800
...انتظر

178
00:10:58,790 --> 00:11:02,260
...إنّك الفعل... كثير الكلام

179
00:11:02,540 --> 00:11:04,310
.انتهت هذه المباراة

180
00:11:04,680 --> 00:11:06,260
مباراة؟

181
00:11:06,260 --> 00:11:09,390
!إنّ ما نخوضه هنا هو قتال جادّ

182
00:11:09,390 --> 00:11:11,450
!وليس لعبة

183
00:11:12,930 --> 00:11:14,320
!توما-ساما

184
00:11:17,140 --> 00:11:22,780
لا ينتهي القتال حتّى يعترف
!أحد الطّرفين بالهزيمة

185
00:11:34,450 --> 00:11:35,710
...سُحقًا

186
00:11:35,880 --> 00:11:37,130
...ذلك الوغد

187
00:11:37,710 --> 00:11:40,510
عليك أن تكون سعيدًا لأنّ الأمر
!انتهى بالتّعادل

188
00:11:40,510 --> 00:11:44,430
!لقد هزم توما أبطالاً أولمبيّين في السّابق

189
00:11:44,430 --> 00:11:49,140
!وأنا هزمت قائد ثانويّة ميناتو الثّالثة

190
00:11:49,590 --> 00:11:53,310
إنّ الشّيء الوحيد الّذي يستحقّ الميداليّة
.الذّهبيّة هنا هو كبرياؤك وموقفك التّنافسيّ

191
00:12:00,820 --> 00:12:02,290
.يا إلهي

192
00:12:06,650 --> 00:12:07,740
!أيّها القائد

193
00:12:07,740 --> 00:12:10,950
التقطنا إشارة ديجيمون
!في المنطقة دي-82 لنطاق الميناء

194
00:12:11,360 --> 00:12:13,290
!جارٍ تحليل الدّيجيمون

195
00:12:13,290 --> 00:12:14,670
!يتمّ نقل البيانات للشّاشة

196
00:12:18,630 --> 00:12:21,840
