1
00:00:14,610 --> 00:00:17,240
!اتركيني! قلتُ لك اتركيني

2
00:00:17,780 --> 00:00:18,990
!أفلتيني

3
00:00:18,990 --> 00:00:19,910
.أيّها القائد

4
00:00:20,190 --> 00:00:21,790
.تم أسر رابتر-1

5
00:00:21,790 --> 00:00:25,540
كما أنّي أحضرتُ معي
.الشّاهد دايمون ماسارو

6
00:00:26,080 --> 00:00:27,000
!اسمع

7
00:00:27,000 --> 00:00:30,090
يجدر أن يكون أغومون
!قد بُرّئ من الشّكوك بالفعل

8
00:00:30,090 --> 00:00:32,550
!كفّوا عن معاملته كمجرم

9
00:00:32,550 --> 00:00:33,880
!الأمر ليس كذلك

10
00:00:34,130 --> 00:00:35,130
!ما هو إذًا؟

11
00:00:35,540 --> 00:00:39,140
لا يفترض بالدّيجيمون القدوم
!إلى هذا العالم من الأساس

12
00:00:39,140 --> 00:00:41,600
!إنّ مجرّد التّواجد مع البشر جريمة

13
00:00:41,600 --> 00:00:43,230
!جريمة؟

14
00:00:43,230 --> 00:00:45,610
!لكنّكم تملكون ديجيمون أيضًا

15
00:00:46,140 --> 00:00:49,070
إن أسرعت سيّارة شرطة خلف
،سيّارة مسرعة

16
00:00:49,230 --> 00:00:51,940
أيعني ذلك أنّ الشّرطيّ مجرم أيضًا؟

17
00:00:52,850 --> 00:00:54,150
...فهمت

18
00:00:54,150 --> 00:00:56,700
!أنيكي، تمالك نفسك

19
00:00:56,700 --> 00:00:59,530
ساتسوما، ما الّذي يجب القيام به
حيال رابتر-1؟

20
00:00:59,860 --> 00:01:02,540
إنّ الدّيجيمون الّتي تسبّب
...المشاكل في عالم البشر

21
00:01:02,540 --> 00:01:08,080
يجب أنّ تتحوّل بالكامل إلى بيضة
.رقميّة وتُرسَل بالقوّة للعالم الرّقميّ

22
00:01:08,660 --> 00:01:10,420
بيضة رقميّة؟

23
00:01:12,000 --> 00:01:13,090
!...تلك

24
00:01:25,050 --> 00:01:27,270
!تمّ تحديد محاور الإحداثيّات

25
00:01:27,270 --> 00:01:29,560
!جارٍ تبريد معدّات النّقل

26
00:01:30,060 --> 00:01:32,530
!الإلكترونيّات الحيويّة تعمل

27
00:01:32,530 --> 00:01:35,330
!جارٍ تصفيف المنسّق الرّقمي

28
00:01:35,810 --> 00:01:37,750
!فتح الأمن

29
00:01:38,440 --> 00:01:40,490
!فتح البوّابة الرّقميّة

30
00:01:41,780 --> 00:01:44,080
‫خمس ثوانٍ على النّقل!

31
00:01:44,450 --> 00:01:45,620
...ثلاثة

32
00:01:45,620 --> 00:01:46,620
...اثنان

33
00:01:46,620 --> 00:01:48,040
...واحد

34
00:01:48,240 --> 00:01:49,710
!ليبدأ النّقل

35
00:01:49,710 --> 00:01:50,880
!بدء النّقل

36
00:01:54,330 --> 00:01:55,670
ما-ما كان ذلك؟

37
00:02:04,670 --> 00:02:06,440
!اكتمل النّقل

38
00:02:08,010 --> 00:02:09,480
...اختفت

39
00:02:09,480 --> 00:02:13,360
لقد أرسلناها إلى العالم الرّقميّ
.حيث تعيش الدّيجيمون فحسب

40
00:02:13,360 --> 00:02:15,780
.حسنًا، حان دور رابتر-1

41
00:02:18,980 --> 00:02:20,700
!أنقذني يا أنيكي

42
00:02:20,870 --> 00:02:23,780
!ما الّذي تفعلونه لتابعي؟

43
00:02:31,120 --> 00:02:32,630
!لنهرب يا أغومون

44
00:02:32,630 --> 00:02:33,670
!حالاً

45
00:02:37,210 --> 00:02:38,930
!لن تهربا منّي

46
00:02:43,710 --> 00:02:44,970
جهاز رقميّ؟

47
00:02:45,300 --> 00:02:47,820
هل هو لذلك الفتى؟

48
00:02:49,470 --> 00:02:50,600
.فهمت

49
00:02:50,600 --> 00:02:51,900
...لا بدّ أنّ ذلك الرّجل

50
00:02:56,520 --> 00:02:58,440
...إذًا فهم مرتبطون بمكان كهذا

51
00:02:58,440 --> 00:03:00,960
!أنيكي، لنذهب من هنا بسرعة

52
00:03:00,400 --> 00:03:01,860
!غـ-غبيّ

53
00:03:02,020 --> 00:03:04,780
!ستجلب الأنظار لك إن غادرت هكذا

54
00:03:04,780 --> 00:03:06,200
...لا بدّ أنّ هنالك

55
00:03:07,530 --> 00:03:08,630
!تلك العلبة

56
00:03:13,700 --> 00:03:14,890
!حسنًا

57
00:03:19,250 --> 00:03:22,640
أخبرني يا أنيكي، كم يبعد المكان
الّذي سنذهب إليه؟

58
00:03:23,040 --> 00:03:23,770
!اصمت

59
00:03:26,800 --> 00:03:28,270
.لا تتكلّم واتبعني فحسب

60
00:03:28,270 --> 00:03:31,030
!أنا جائع

61
00:03:40,280 --> 00:03:43,620
!أنيكي، هذه الأشياء لذيذة

62
00:03:44,400 --> 00:03:47,490
ما كان ذلك الهراء عن أكل
طعام خاصّ بالدّيجيمون فقط؟

63
00:03:47,490 --> 00:03:49,450
!إنّه يأكل أيّ شيء

64
00:03:49,650 --> 00:03:50,620
ماسارو؟

65
00:03:50,620 --> 00:03:51,330
هل أنت هنا؟

66
00:03:52,740 --> 00:03:53,880
!اختبئ

67
00:03:54,630 --> 00:03:55,920
!هيّا، بسرعة

68
00:03:56,080 --> 00:03:57,090
!...أنيكي

69
00:03:58,870 --> 00:03:59,960
!ماسارو

70
00:04:00,120 --> 00:04:01,720
!أ-أمّي

71
00:04:01,720 --> 00:04:02,510
!لقد عدت

72
00:04:02,510 --> 00:04:05,720
يا إلهي منك، أين كنت ليلة البارحة؟

73
00:04:05,720 --> 00:04:11,100
ظننتُك تواجه مشاكل مع الشّرطة
!ثانية! قلقتُ كثيرًا عليك

74
00:04:11,380 --> 00:04:13,190
!إ-إطلاقًا

75
00:04:13,760 --> 00:04:16,770
بدأنا أنا وأصدقائي بالحديث
...عن الحياة

76
00:04:16,770 --> 00:04:19,070
!وكان الصّباح طلع قبل حتّى أن ندرك

77
00:04:22,230 --> 00:04:23,610
...ماسارو

78
00:04:23,610 --> 00:04:24,910
!ما-ماذا؟

79
00:04:25,780 --> 00:04:27,570
.إنّك تدوس على شكولاطة

80
00:04:28,030 --> 00:04:29,540
!كلاّ! لم ألاحظ ذلك

81
00:04:30,780 --> 00:04:32,750
!إنّ الفوضى تعمّ غرفتك

82
00:04:32,750 --> 00:04:34,460
،سـ-سأنظّفها في الحال

83
00:04:34,460 --> 00:04:36,630
لذلك دعيني أقوم بذلك، موافقة؟

84
00:04:40,410 --> 00:04:43,130
!أنيكي، ما كان سبب ذلك؟

85
00:04:43,750 --> 00:04:48,260
،إن عرف أيّ أحد أنّك هنا
!فسيأتون سعيًا خلفك

86
00:04:49,550 --> 00:04:51,020
!لا أريد ذلك

87
00:04:51,020 --> 00:04:55,310
،استمع إليّ إذًا
وإيّاك أن تصدر أيّ صوت، مفهوم؟

88
00:04:55,310 --> 00:04:56,480
!حاضر

89
00:04:56,480 --> 00:04:56,810
...وأيضًا

90
00:04:56,810 --> 00:04:57,860
ماسارو؟

91
00:05:00,390 --> 00:05:03,040
...ظننتُ أنّي سمعتُك تحدّث شخصًا ما

92
00:05:03,690 --> 00:05:05,280
...ذ-ذلك

93
00:05:05,280 --> 00:05:07,070
!تـ-تتخيّلين فحسب

94
00:05:07,070 --> 00:05:08,870
هل تخفي شيئًا ما؟

95
00:05:09,690 --> 00:05:11,240
!لا-لا شيء

96
00:05:11,240 --> 00:05:13,200
!انظر إليّ وأنت تكلّمني

97
00:05:13,200 --> 00:05:15,830
أتذكر وعدنا يا ماسارو؟

98
00:05:15,830 --> 00:05:21,340
قطعنا نحن الثّلاثة وعدًا بإخبار
!بعضنا كلّ شيء حتّى يعود والدك

99
00:05:21,340 --> 00:05:22,390
ثلاثة؟

100
00:05:35,050 --> 00:05:36,810
ما الخطب يا تشيكا؟

101
00:05:36,810 --> 00:05:38,810
!رأيتُ سحليّة ضخمة

102
00:05:38,810 --> 00:05:39,820
سحليّة؟

103
00:05:41,180 --> 00:05:42,570
!...كلاّ، مـ-مهلاً

104
00:05:43,430 --> 00:05:45,240
.لا يوجد أيّ شيء هنا

105
00:05:45,240 --> 00:05:46,450
!لقد رأيتها بالفعل

106
00:05:46,450 --> 00:05:49,160
!كانت هنالك سحليّة ضخمة

107
00:05:55,320 --> 00:05:57,130
!لا بدّ أنّه يوما

108
00:05:58,420 --> 00:06:02,960
كائن حيّ مجهول مثل نيسي
.أو رجل الثّلج البغيض

109
00:05:58,540 --> 00:06:02,960
"يوما: حيوان غامض مجهول"

110
00:06:02,960 --> 00:06:06,350
لحظة... أين وضعتُ كاميرا الفيديو؟

111
00:06:07,790 --> 00:06:08,930
ما هذا؟

112
00:06:10,140 --> 00:06:12,150
!إنّها تلك السّحليّة

113
00:06:13,010 --> 00:06:13,930
!تشيكا

114
00:06:14,380 --> 00:06:15,640
!مهلاً لحظة

115
00:06:15,800 --> 00:06:17,480
!الوضع خطير، تراجعي

116
00:06:17,480 --> 00:06:18,360
!...سأذهب أنا

117
00:06:30,650 --> 00:06:32,170
!أخي ماسارو؟

118
00:06:36,860 --> 00:06:38,290
.هذه يوشينو

119
00:06:38,540 --> 00:06:39,920
.تمّ تأمين الهدف

120
00:06:39,920 --> 00:06:42,960
سأعود للمقرّ الرّئيسيّ بعد
.أن أمحو ذكرياتهم

121
00:07:47,600 --> 00:07:49,690
"!تأجّجي يا روح الغضب الرّقميّة"

122
00:07:49,900 --> 00:07:51,490
"!فلايمون المترصّد في الظّلام"

123
00:07:53,860 --> 00:07:54,870
!أغومون

124
00:07:55,520 --> 00:07:57,080
...هذا مؤلم

125
00:07:57,530 --> 00:07:58,490
!أغومون

126
00:07:58,780 --> 00:08:00,000
!أين ذهبت يا أغومون؟

127
00:08:01,110 --> 00:08:02,330
!أغومون

128
00:08:03,990 --> 00:08:05,510
!أين أغومون يا أمّي؟

129
00:08:09,200 --> 00:08:10,420
!المزيد رجاءً

130
00:08:10,420 --> 00:08:11,600
!في الحال

131
00:08:13,080 --> 00:08:15,970
!كيف تتصرّف بهدوء وتأكل هكذا؟

132
00:08:15,970 --> 00:08:18,930
!لأنّ سايوري قالت أنّ باستطاعتي ذلك

133
00:08:18,930 --> 00:08:21,730
!لا تنادي أمّي باسمها الشّخصيّ هكذا

134
00:08:21,730 --> 00:08:23,350
!هـ-هذا يؤلم

135
00:08:23,350 --> 00:08:24,190
!مهلاً

136
00:08:25,180 --> 00:08:27,910
.إنّنا نأكل هنا
هلاّ هدأتما قليلاً؟

137
00:08:28,560 --> 00:08:32,570
!هذا الكوشيكاتسو لذيذ جدًّا يا سيّدتي

138
00:08:33,440 --> 00:08:36,070
ما الّذي تفعلينه هنا؟

139
00:08:36,360 --> 00:08:38,120
!لا أدري أيضًا

140
00:08:38,120 --> 00:08:40,500
...كنتُ سآخذكما معي، لكن

141
00:08:41,110 --> 00:08:42,870
.لن يكون ذلك ضروريًّا

142
00:08:42,870 --> 00:08:46,500
.تمّ إلغاء محو ذكريات
.دايمون ماسارو وعائلته

143
00:08:47,660 --> 00:08:51,050
..ابقي هناك يا يوشينو وراقبي رابتر-1

144
00:08:51,050 --> 00:08:52,170
.مفهوم؟

145
00:08:52,170 --> 00:08:53,470
....لـ-لكن

146
00:08:55,880 --> 00:08:57,510
...لذلك السّبب

147
00:08:57,510 --> 00:09:01,560
.سأعيش هنا معكم لبعض الوقت

148
00:09:01,560 --> 00:09:02,770
!ماذا؟

149
00:09:02,770 --> 00:09:04,520
!مستحيل! غادري في الحال

150
00:09:04,520 --> 00:09:06,480
.لا أستطيع المغادرة

151
00:09:06,480 --> 00:09:08,150
.إنّها أوامر القائد

152
00:09:08,150 --> 00:09:09,900
!عندما أقول غادري، فغادري

153
00:09:09,900 --> 00:09:11,570
!لن أغادر

154
00:09:11,570 --> 00:09:14,240
.كفاكما جدالاً مثل زوجين عجوزين

155
00:09:14,240 --> 00:09:15,950
!من تصفين بالزّوجين؟

156
00:09:20,120 --> 00:09:21,740
...أنيكي

157
00:09:21,740 --> 00:09:23,620
...ما عدت أستطيع الأكل

158
00:09:23,780 --> 00:09:25,300
...سُحقًا

159
00:09:26,280 --> 00:09:27,830
!لا أصدّق هذا

160
00:09:27,830 --> 00:09:29,590
...كلاّ

161
00:09:27,830 --> 00:09:30,290
...هامبرغر... بطاطس

162
00:09:53,180 --> 00:09:55,070
إلى أين ستذهب يا أنيكي؟

163
00:09:55,070 --> 00:09:56,070
.إلى المدرسة

164
00:09:56,070 --> 00:09:57,950
ما المدرسة؟

165
00:09:59,150 --> 00:10:01,740
.مكان يوجد فيه الكثير من الأشخاص لقتالهم

166
00:10:01,900 --> 00:10:03,340
!مذهل

167
00:10:03,990 --> 00:10:05,910
!سأذهب أيضًا يا أنيكي

168
00:10:06,110 --> 00:10:07,910
!حسنًا، لنذهب

169
00:10:07,910 --> 00:10:09,370
هل نسيت؟

170
00:10:09,620 --> 00:10:12,880
،إن ظهر ديجيمون في مكان عامّ
!فسيخلق حالة فوضى

171
00:10:12,880 --> 00:10:14,550
...ذلك صحيح

172
00:10:15,460 --> 00:10:18,010
!أريد الذّهاب للمدرسة مع أنيكي

173
00:10:18,010 --> 00:10:20,340
!أريد الذّهاب! أريد الذّهاب

174
00:10:20,340 --> 00:10:21,970
.لا بأس، افعل ما يحلو لك

175
00:10:22,170 --> 00:10:24,180
.خذ، استعمل هذا

176
00:10:24,340 --> 00:10:25,390
...هذا

177
00:10:25,390 --> 00:10:27,350
!ظننتُ أنّي أضعتُه

178
00:10:27,350 --> 00:10:29,690
.تركتَه في مقرّ داتس البارحة

179
00:10:29,690 --> 00:10:31,520
!شكرًا لك

180
00:10:31,520 --> 00:10:33,570
ماذا أفعل الآن؟

181
00:10:33,570 --> 00:10:36,830
صوّبه ناحية أغومون
.واضغط الزّرّ الأيمن

182
00:10:38,100 --> 00:10:39,620
هكذا؟

183
00:10:44,110 --> 00:10:46,950
!أنيكي! ما هذا؟
!أخرجني من هنا

184
00:10:46,950 --> 00:10:48,160
!أغومون

185
00:10:48,610 --> 00:10:52,380
بإمكان الجهاز الرّقميّ تحويل
.الدّيجيمون إلى بيانات وثمّ تخزينها

186
00:10:52,380 --> 00:10:56,630
استعمل تلك الخاصّيّة في كلّ مرّة
.تريدان الذّهاب معًا لمكان ما

187
00:10:57,540 --> 00:10:59,550
!ستتأخّر يا ماسارو

188
00:10:59,550 --> 00:11:00,590
!كلاً

189
00:11:00,590 --> 00:11:01,810
!لقد غادرت

190
00:11:07,260 --> 00:11:09,100
إلى متى ستستمرّين في ملاحقتي؟

191
00:11:09,100 --> 00:11:11,810
.إلى أن تسلّمني أغومون

192
00:11:12,430 --> 00:11:14,110
ألا يوجد شيء آخر بإمكاني فعله؟

193
00:11:14,510 --> 00:11:15,690
...لنرَ

194
00:11:15,690 --> 00:11:16,820
إذًا فهنالك شيء ما؟

195
00:11:17,070 --> 00:11:19,410
.بإمكانك الانضمام لداتس

196
00:11:20,520 --> 00:11:25,990
،بتعبير آخر، إن صرتَ عضوًا في داتس
.فلن يكون لدينا سبب لملاحقة أغومون

197
00:11:26,690 --> 00:11:30,750
،كما لن أكون بحاجة لمراقبتكما أيضًا

198
00:11:30,950 --> 00:11:32,920
.لكن أظنّ أنّ ذلك لن يحدث أبدًا

199
00:11:32,920 --> 00:11:34,220
!بالطّبع لن يحدث

200
00:11:37,160 --> 00:11:38,090
ما هذا؟

201
00:11:41,830 --> 00:11:44,060
مهلاً، ألم تتأخّر عن الذّهاب للمدرسة؟

202
00:11:44,500 --> 00:11:46,020
.تلك مدرسة تشيكا

203
00:11:46,380 --> 00:11:47,310
...يا إلهي

204
00:11:51,720 --> 00:11:52,820
!تشيكا

205
00:11:53,510 --> 00:11:54,690
!أخي ماسارو

206
00:11:57,020 --> 00:11:58,190
!انظر هناك

207
00:12:00,060 --> 00:12:01,370
...هذا فظيع

208
00:12:02,810 --> 00:12:06,830
تاكاشي-كُن هو المسؤول عن
...العناية بالحيوانات

209
00:12:06,830 --> 00:12:11,880
،لكن عندما أتى لإطعامها هذا الصّباح
!كانت كلّ الدّجاج والأرانب قد ماتت

210
00:12:12,990 --> 00:12:16,710
في الحقيقة، كانت هنالك
.سلسلة حوادث كهذه سابقًا

211
00:12:16,710 --> 00:12:20,710
وكان عدد كبير من الضّحايا
.من مدرسة إعداديّة في البلدة المجاورة

212
00:12:21,040 --> 00:12:21,930
.تعال معي

213
00:12:22,670 --> 00:12:23,880
ما-ماذا؟

214
00:12:26,840 --> 00:12:28,720
.هذا من صنيع ديجيمون

215
00:12:29,510 --> 00:12:30,430
!فعلاً؟

216
00:12:30,800 --> 00:12:31,640
.انظر

217
00:12:31,640 --> 00:12:33,770
يمكنك رؤية جهازي الرّقمي
يصدر إشارات، صحيح؟

218
00:12:33,770 --> 00:12:35,400
.هذا يعني أنّه يوجد ديجيمون قريبًا من هنا

219
00:12:35,400 --> 00:12:38,730
عجبًا، بإمكانه فعل هذا أيضًا؟

220
00:12:38,730 --> 00:12:41,860
بدأت الأمور تصير ممتعة أكثر
!يا أنيكي ماسارو

221
00:12:41,860 --> 00:12:42,570
!نعم

222
00:12:42,890 --> 00:12:45,570
!مهلاً، ما الّذي تفعله خارج الجهاز؟

223
00:12:45,730 --> 00:12:49,530
لم أستطع أن أعتاد على التّواجد
!داخل الجهاز الرّقميّ الضّيّق

224
00:12:50,440 --> 00:12:52,200
.إنّ الأنواع النّادرة مثلك متعبة للغاية

225
00:12:52,200 --> 00:12:56,130
لا يوجد أيّ ديجيمون آخر قد يغادر
.الجهاز الرّقميّ من تلقاء نفسه

226
00:12:57,410 --> 00:13:01,670
!أيُعقل أن تكون أنت من هاجم ذلك القنّ؟

227
00:13:03,000 --> 00:13:04,170
.لم يكن هو

228
00:13:04,170 --> 00:13:05,130
لالامون؟

229
00:13:05,130 --> 00:13:09,430
كنتُ أحرسه طوال اللّيل
.عندما كنتِ نائمة

230
00:13:09,430 --> 00:13:12,100
.لم يخطُ أغومون ولو خطوة خارج الغرفة

231
00:13:12,100 --> 00:13:13,900
!لا بدّ أنّه ديجيمون آخر

232
00:13:14,930 --> 00:13:16,810
...إذًا يا أنيكي، هذا يعني

233
00:13:17,100 --> 00:13:17,770
!نعم

234
00:13:18,020 --> 00:13:21,480
!يمكننا أن نوسع الجاني ضربًا ثانية

235
00:13:23,390 --> 00:13:25,290
.هيّا بنا يا تاكاشي-كُن

236
00:13:25,520 --> 00:13:26,710
.حاضر

237
00:13:28,520 --> 00:13:29,910
!تشيكا

238
00:13:29,910 --> 00:13:36,460
سنوسع الأوغاد الّذين هاجموا
!تلك الأقفاص ضربًا، مفهوم؟

239
00:13:41,120 --> 00:13:41,840
.انتهيت

240
00:13:42,050 --> 00:13:42,960
!مهلاً

241
00:13:42,960 --> 00:13:45,300
!ما الّذي تفعله يا أنيكي؟

242
00:13:45,620 --> 00:13:49,510
يُقال أنّ المجرم يعود دائمًا
إلى مسرح الجريمة، صحيح؟

243
00:13:49,510 --> 00:13:54,520
عندما يكتشف أنّه ما زالت هنالك فريسة هنا
.في الدّاخل، فأنا واثق أنّه سيضرب ضربته ثانية

244
00:13:54,520 --> 00:13:55,600
!مذهل

245
00:13:55,600 --> 00:13:57,730
!أنت ذكيّ جدًّا يا أنيكي

246
00:13:57,890 --> 00:14:01,530
.هذا يعني أنّه يستعملك كطُعم للعدوّ

247
00:14:02,350 --> 00:14:04,280
!أنا طُعم؟

248
00:14:04,280 --> 00:14:06,070
!لا داعي للقلق

249
00:14:06,070 --> 00:14:09,610
!سأوسعه ضربًا قبل أن يفعل أيّ شيء

250
00:14:09,610 --> 00:14:11,880
هل ستسير الأمر بشكل جيّد
هكذا بالفعل؟

251
00:14:15,750 --> 00:14:17,830
...أكرهك يا أنيكي

252
00:14:17,830 --> 00:14:19,880
...حتّى أنّك أقفلت الباب

253
00:14:35,220 --> 00:14:36,270
.ها قد أتى

254
00:14:43,890 --> 00:14:46,990
أليس هذا هو صديق تشيكا-تشان؟

255
00:14:46,990 --> 00:14:48,150
!إنّه تاكاشي

256
00:14:48,310 --> 00:14:49,860
!لقد رأى أغومون

257
00:14:50,070 --> 00:14:51,780
!هذا سيّئ

258
00:14:52,190 --> 00:14:53,370
!يا تاكاشي

259
00:14:55,150 --> 00:14:57,620
ما الّذي تفعله هنا في وقت متأخّر كهذا؟

260
00:14:57,620 --> 00:14:59,830
هل أتيت للتّحقّق من الأقفاص؟

261
00:15:02,330 --> 00:15:04,340
!أنت، لماذا لا تردّ؟

262
00:15:04,340 --> 00:15:05,380
!اخرس

263
00:15:05,380 --> 00:15:06,670
!ماذا قلت؟

264
00:15:06,670 --> 00:15:07,420
!مهلاً

265
00:15:07,420 --> 00:15:08,840
!ثمّة خطب ما به

266
00:15:09,460 --> 00:15:13,600
!أنا لم... أرد الاعتناء بتلك الحيوانات

267
00:15:13,880 --> 00:15:17,850
!تمنّيتُ أن تختفي

268
00:15:17,850 --> 00:15:19,610
...ثمّ ظهر هذا

269
00:15:30,770 --> 00:15:31,910
!تاكاشي

270
00:15:32,940 --> 00:15:35,380
!هو الجاني إذًا

271
00:15:37,120 --> 00:15:38,950
!سأوسعه ضربًا

272
00:15:38,950 --> 00:15:39,910
.تراجع رجاءً

273
00:15:39,910 --> 00:15:40,960
ماذا؟

274
00:15:41,240 --> 00:15:43,330
.ستتولّى داتس هذا الأمر

275
00:15:44,200 --> 00:15:45,420
!لالامون

276
00:15:45,420 --> 00:15:46,500
!اخرجي

277
00:15:50,920 --> 00:15:53,640
!لالامون

278
00:15:53,640 --> 00:15:55,480
!طلقات البذور

279
00:16:07,020 --> 00:16:07,990
!لالامون

280
00:16:09,770 --> 00:16:10,820
!ذلك الوغد

281
00:16:11,140 --> 00:16:12,030
!أنيكي

282
00:16:12,030 --> 00:16:13,740
!أخرجني من هنا أوّلاً

283
00:16:13,740 --> 00:16:14,490
!أكيد

284
00:16:16,020 --> 00:16:17,280
ماذا؟

285
00:16:17,280 --> 00:16:18,870
ما كان رمز القفل؟

286
00:16:18,870 --> 00:16:20,200
!لا يمكنك فتحه؟

287
00:16:20,360 --> 00:16:22,120
!حان وقت التّطوّر يا لالامون

288
00:16:26,030 --> 00:16:27,680
!شحن الرّوح الرّقميّة

289
00:16:31,790 --> 00:16:33,630
!تطوّر لالامون

290
00:16:42,800 --> 00:16:44,400
!سانفلاومون

291
00:16:49,930 --> 00:16:52,330
!شعاع نور الشّمس

292
00:16:56,770 --> 00:16:58,070
!أجل

293
00:16:58,230 --> 00:17:00,950
كلاّ، لقد حظيتا بكلّ المرح
!لأنّك بطيء جدًّا

294
00:17:00,950 --> 00:17:02,080
!ماذا قلت؟

295
00:17:09,370 --> 00:17:11,760
!مستحيل... إنّه يتطوّر

296
00:17:34,600 --> 00:17:35,780
ما هذا؟

297
00:17:35,780 --> 00:17:37,540
...إنّ جسدي يتخدّر

298
00:17:46,620 --> 00:17:48,500
!لقد جنيت على نفسك

299
00:17:48,500 --> 00:17:50,340
!أنيكي، حان وقت التّطوّر أيضًا

300
00:17:50,340 --> 00:17:51,550
!أجل

301
00:17:53,250 --> 00:17:54,300
ماذا؟

302
00:17:54,300 --> 00:17:56,010
ما الخطب يا أنيكي؟

303
00:17:56,010 --> 00:17:57,340
!لا أدري

304
00:17:57,340 --> 00:18:00,650
!لا أشعر بذلك الإحساس المتفجّر والحارق

305
00:18:05,680 --> 00:18:07,100
!سُحقًا

306
00:18:07,390 --> 00:18:08,690
!أنيكي

307
00:18:13,890 --> 00:18:15,900
!أخبرتك أن تتراجع

308
00:18:15,900 --> 00:18:20,370
هذا خطير، لذلك اهرب
!ودع القتال لنا

309
00:18:20,370 --> 00:18:22,080
!لا تتفوّهي بالهراء

310
00:18:23,440 --> 00:18:26,000
من المستحيل أن أدير ظهري
!للعدوّ وأهرب كالجبناء

311
00:18:27,530 --> 00:18:31,000
،لا يهمّ كم أنّ الأمر صعب
!سأقف ثابتًا دون التّراجع أبدًا

312
00:18:31,000 --> 00:18:32,250
...وهكذا يجب على الرّجل

313
00:18:32,500 --> 00:18:34,710
!أن يعيش حياته

314
00:18:48,130 --> 00:18:48,980
!ها هي

315
00:18:50,390 --> 00:18:52,150
أتريد القيام بهذا؟

316
00:18:52,150 --> 00:18:52,940
!نعم

317
00:18:53,140 --> 00:18:54,610
!ممتاز

318
00:18:56,680 --> 00:19:00,080
!شحن الرّوح الرّقميّة

319
00:19:04,400 --> 00:19:07,190
!تطوّر أغومون

320
00:19:21,130 --> 00:19:22,480
!جيوغريمون

321
00:19:38,020 --> 00:19:39,740
!اللّهب الهائل

322
00:19:47,990 --> 00:19:49,290
!نلتَ منه

323
00:19:49,290 --> 00:19:50,120
!نعم

324
00:19:53,290 --> 00:19:56,500
إذًا فإنّ قبضتك الغاضبة
!توقظ روحك الرّقميّة

325
00:19:56,920 --> 00:19:59,800
.إنّك تصير مثيرًا للاهتمام أكثر مع كلّ دقيقة

326
00:20:00,080 --> 00:20:02,760
!أنت هو العجوز الّذي أعطاني الجهاز الرّقميّ

327
00:20:02,760 --> 00:20:08,220
لا بدّ أنّ عالم البشر هذا صغير جدًّا
.عليك لتلوّح بقبضتيك النّاريّتين هاتين

328
00:20:08,760 --> 00:20:09,560
...اسمع

329
00:20:09,560 --> 00:20:14,690
في عالم الدّيجيمون، ستجد العديد من
.الخصوم الأقوياء لتقاتلهم بقدر ما تشاء

330
00:20:15,430 --> 00:20:18,190
...العديد من الخصوم الأقوياء

331
00:20:25,360 --> 00:20:27,160
!اكتمل النّقل

332
00:20:27,160 --> 00:20:30,580
...لكنّ الأقفاص وساحة اللّعب دُمّرت

333
00:20:30,580 --> 00:20:34,370
.تطلّب الأمر الكثير منّا للتّغطية عن الحادثة

334
00:20:34,370 --> 00:20:40,210
،لـ-لكنّا استطعنا الإمساك بالدّيجيمون
...ومحونا ذكريات تاكاشي-كُن

335
00:20:40,210 --> 00:20:42,170
لذلك فكلّ شيء انتهى على خير، صحيح؟

336
00:20:42,170 --> 00:20:43,270
!لا تستهيني بالوضع

337
00:20:43,710 --> 00:20:45,100
...أ-أنا آسفة

338
00:20:45,880 --> 00:20:49,690
بالمناسبة، من يراقب رابتر-1 الآن؟

339
00:20:50,090 --> 00:20:51,570
...في الحقيقة

340
00:20:55,260 --> 00:20:57,730
ما الّذي تفعلانه هنا؟

341
00:20:58,640 --> 00:20:59,610
!رجاءً

342
00:20:59,610 --> 00:21:01,410
!اسمحوا لنا بالانضمام لداتس

343
00:21:01,980 --> 00:21:03,240
!اسمحوا لنا

344
00:21:03,240 --> 00:21:04,320
ماذا؟

345
00:21:04,320 --> 00:21:07,830
،إن انضممنا إلى داتس
فلن تتخلّصوا من أغومون، صحيح؟

346
00:21:09,780 --> 00:21:10,740
.حسنًا إذًا

347
00:21:10,740 --> 00:21:12,330
!أيّها القائد

348
00:21:12,330 --> 00:21:17,130
،دايمون ماسارو
.توقّعتُ أن تأتي إلينا يومًا ما

349
00:21:17,130 --> 00:21:19,090
.وأنت أيضًا يا أغومون

350
00:21:19,090 --> 00:21:21,970
سيتمّ قبولكما كعضوين
.من داتس بدءًا من اليوم

351
00:21:23,330 --> 00:21:24,630
!نجحنا يا أنيكي

352
00:21:24,800 --> 00:21:25,550
!أجل

353
00:21:25,550 --> 00:21:28,550
يمكننا الآن أن نقاتل أكبر عدد
!من الأشخاص الأقوياء كيفما نشاء

354
00:21:29,460 --> 00:21:30,900
!مـ-مهلاً لحظة

355
00:21:36,640 --> 00:21:39,360
.سيّدي، سنهبط قريبًا

356
00:21:39,970 --> 00:21:41,070
.شكرًا لك

357
00:21:42,390 --> 00:21:46,410
مرّ وقت طويل على زيارتي
.لبلاد أمّي اليابان

358
00:22:48,300 --> 00:22:51,260
من يظنّ ذلك المدعوّ توما نفسه؟

359
00:22:51,430 --> 00:22:55,140
ظهر في مقرّ داتس فجأة
!وبدأ يعاملني بقلّة احترام

360
00:22:55,140 --> 00:22:58,100
سمعتُ من يوشينو أنّه شخص
...عبقريّ ورياضيّ بارع

361
00:22:58,100 --> 00:23:01,520
.كما أنّه من نبلاء أوروبّا أيضًا
!إنّه عكسك تمامًا يا أنيكي

362
00:23:01,520 --> 00:23:02,400
!اخرس

363
00:23:02,400 --> 00:23:04,150
!لا أهتمّ إن كان نبيلاً أو أيّ شيء

364
00:23:04,150 --> 00:23:07,030
!سألقّنه درسًا عن احترام الآخرين

365
00:23:07,030 --> 00:23:08,530
:منقذو الدّيجيمون

366
00:23:08,530 --> 00:23:10,150
"!عودة العبقريّ توما للدّيار"

367
00:23:10,150 --> 00:23:11,950
"!الإطاحة بميرامون"

368
00:23:11,950 --> 00:23:14,030
!استيقظي في قبضتي أيّتها الرّوح الرّقميّة

369
00:23:14,030 --> 00:23:16,910
!عودة العبقريّ توما للدّيار"
"الإطاحة بميرامون