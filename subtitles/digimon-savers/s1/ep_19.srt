1
00:00:18,020 --> 00:00:19,860
!الهدف هو إيكوتو؟

2
00:00:19,860 --> 00:00:21,500
!مُخطَّط غوتسومون

3
00:00:24,110 --> 00:00:27,770
عندما قاتلت المجموعةُ ميركوريمون
،في الجبال الجليديّة اللّانهائيّة

4
00:00:27,770 --> 00:00:32,930
قُهِروا بواسطة قوّته الهائلة

5
00:00:42,780 --> 00:00:49,820
أنقذهم العجوز الغامض وشريكه، غاوابّامون

6
00:00:53,160 --> 00:00:55,540
!شحن الرُّوح الرّقميّة

7
00:00:57,110 --> 00:00:58,540
كاميمون، تطوّر

8
00:01:00,450 --> 00:01:01,990
!غاوابّامون، أجل

9
00:01:03,450 --> 00:01:05,050
!رامي الدّي جيه

10
00:01:05,870 --> 00:01:09,000
،أنقذتْ شجاعتُهم فريقَ ماسارو

11
00:01:09,000 --> 00:01:13,920
الّذي عاد حينها إلى العالم البشريّ
مع إيكوتو وفالكومون

12
00:01:14,540 --> 00:01:15,890
اعتنِ بإيكوتو

13
00:01:16,880 --> 00:01:18,890
!أعده إلى العالم البشريّ

14
00:01:19,180 --> 00:01:19,840
العجوز؟

15
00:01:19,840 --> 00:01:20,930
!ماسارو، بسرعة

16
00:01:20,930 --> 00:01:22,140
!هيّا

17
00:01:22,140 --> 00:01:23,310
!ماسارو، هيّا

18
00:01:22,480 --> 00:01:23,310
!العجوز

19
00:01:36,350 --> 00:01:40,070
!دعوني

20
00:01:40,070 --> 00:01:43,240
!لا تلمسوني! ستدفعون ثمن هذا

21
00:01:43,240 --> 00:01:45,540
!كفّ عن المقاومة يا فتى! اهدأ

22
00:01:45,840 --> 00:01:47,450
!عليّ الخروج

23
00:01:48,570 --> 00:01:49,790
!ستبقى هنا

24
00:01:49,790 --> 00:01:52,000
!لكن عليّ الخروج إلى هناك

25
00:01:52,000 --> 00:01:52,780
—أيُّها

26
00:01:52,320 --> 00:01:56,010
!دعوني

27
00:01:56,010 --> 00:01:58,970
!اهدأ! هدّئ من روعك

28
00:01:56,010 --> 00:01:59,310
!عليّ العودة إلى العالم الرّقميّ

29
00:01:59,310 --> 00:02:00,580
!أجل

30
00:02:00,580 --> 00:02:04,730
عليّ العودة إلى العالم الرّقميّ
!وإنقاذ العجوز

31
00:02:05,640 --> 00:02:06,800
!أفلتوني

32
00:02:05,640 --> 00:02:10,310
لا! العودة إلى العالم الرّقميّ الآن
لن يحلّ أي مشكلة

33
00:02:10,310 --> 00:02:12,390
هل تريد أن تدع العجوز يموت فحسب إذاً؟

34
00:02:11,660 --> 00:02:15,280
!أفلتوني

35
00:02:13,500 --> 00:02:16,240
لا يريدنا الرّئيس أن نتصرّف بطيش

36
00:02:15,280 --> 00:02:16,350
!أمسكتُ به

37
00:02:16,240 --> 00:02:20,030
غاصَ في العالم الرّقميّ وهو
!على دراية بأنّ هذا قد يحدث

38
00:02:20,030 --> 00:02:21,400
الرّئيس"؟"

39
00:02:21,400 --> 00:02:23,990
حضرة القائد. تقصد ذلك العجوز؟

40
00:02:25,950 --> 00:02:27,170
!توما! يوشينو

41
00:02:28,430 --> 00:02:29,940
صحيح

42
00:02:29,940 --> 00:02:32,920
ذلك الرّجل الّذي التقيتموه في العالم الرّقميّ

43
00:02:33,680 --> 00:02:36,580
هو خبير في مجال جرائم الدّيجيمون

44
00:02:36,580 --> 00:02:40,640
وقائد بعثة العالم الرّقميّ قبل عشر سنوات

45
00:02:40,640 --> 00:02:42,470
،إنّه الرّئيس الأعلى لـ ف.ب.ت

46
00:02:42,470 --> 00:02:44,430
!الرّئيس يوشيما

47
00:02:44,660 --> 00:02:46,890
...مستحيل

48
00:02:47,270 --> 00:02:50,440
لماذا لا تبدون مصدومين من هذا؟

49
00:02:50,440 --> 00:02:54,460
ظهرَ في العالم الرّقميّ وجعل كاميمون يتطوّر

50
00:02:54,460 --> 00:02:56,900
كان من الواضح بأنّه ليس مجرّد مدنيّ

51
00:02:56,900 --> 00:02:59,120
لكن لم أتوقّع أن يكون رئيس ف.ب.ت

52
00:02:59,120 --> 00:03:00,370
!لم أتوقّع أيضاً

53
00:03:00,370 --> 00:03:04,020
لكن هذا يعني بأنّه واحد منّا، صحيح؟

54
00:03:04,020 --> 00:03:05,700
!لا يمكننا أن ندعه هناك فحسب

55
00:03:06,710 --> 00:03:12,170
إن عدتُم من دونِ رسم أيّة خطّة
ستُكرِّرون نفس الخطأ

56
00:03:12,570 --> 00:03:16,350
سيُغلَقُ الطَّريق إلى العالمِ الرقميّ
حتّى إشعار آخر

57
00:03:16,350 --> 00:03:19,130
ينبغي أن تُسرِعا وتُنهيا عِلاجكما الصحِّي

58
00:03:19,130 --> 00:03:19,830
مفهوم؟

59
00:03:20,270 --> 00:03:22,130
—أفلتوني أيّها الأغبياء

60
00:03:22,130 --> 00:03:23,970
!أفلتوني

61
00:03:24,650 --> 00:03:25,800
!زعيم

62
00:03:27,020 --> 00:03:29,060
ماذا ستفعلون بنا؟

63
00:03:29,350 --> 00:03:30,920
!لن نفعل شيئاً

64
00:03:31,430 --> 00:03:35,030
لكن لا يُفترَض أن يعلم العالمُ
،البشريّ بشأن الدّيجيمونات

65
00:03:35,030 --> 00:03:38,010
لذا لا يمكننا أن ندعك تتجوّل في المدينة

66
00:03:38,010 --> 00:03:39,530
لِمَ تتكتّمون على وجودنا؟

67
00:03:39,950 --> 00:03:41,780
لمنع حدوث هلع

68
00:03:41,780 --> 00:03:44,740
!توقّفوا! اتركوني

69
00:03:43,150 --> 00:03:44,740
!كفّ عن المقاومة

70
00:03:46,740 --> 00:03:49,200
يوشينو، توما. أريد سماع تقريركما

71
00:03:49,490 --> 00:03:50,700
!حاضر

72
00:03:52,120 --> 00:03:56,580
عدنا باستخدام البوّابة الرّقميّة
في الجبال الجليديّة اللّانهائيّة

73
00:03:56,580 --> 00:04:00,570
مصير ميركوريمون والرّئيس يوشيما
وكاميمون مجهول

74
00:04:00,570 --> 00:04:01,630
هذا كلّ شيء

75
00:04:01,880 --> 00:04:04,470
فهمت. أحسنتما صنعاً

76
00:04:05,340 --> 00:04:06,500
!مـ-مهلاً

77
00:04:06,500 --> 00:04:08,140
!ماذا تفعلان؟

78
00:04:08,440 --> 00:04:09,640
!اشتغِل

79
00:04:09,640 --> 00:04:11,350
...أيّها الشّيء الغبيّ

80
00:04:11,350 --> 00:04:13,460
!اِعمَل أيّها الوغد

81
00:04:13,000 --> 00:04:14,060
!كُفّ عن هذا

82
00:04:14,060 --> 00:04:16,310
!هذا ينطبق عليك أيضاً! ابتعدا من هنا

83
00:04:17,160 --> 00:04:18,360
ماذا تفعل؟

84
00:04:18,360 --> 00:04:20,700
!أبعِد يديك عن النّاقل الآنيّ

85
00:04:20,700 --> 00:04:22,270
!لا تتدخّل

86
00:04:22,270 --> 00:04:24,610
!سأعود إلى العالم الرّقميّ

87
00:04:24,610 --> 00:04:25,820
!عليّ إنقاذ العجوز

88
00:04:26,200 --> 00:04:27,940
!توقّف يا ماسارو

89
00:04:27,940 --> 00:04:30,790
!النّتيجة ستكون وخيمة إذا عبثت بالآلات

90
00:04:30,790 --> 00:04:31,980
!اللّعنة

91
00:04:31,980 --> 00:04:32,870
!اشتغِل فحسب

92
00:04:35,580 --> 00:04:37,710
!اشتغِل فحسب

93
00:04:40,760 --> 00:04:41,750
حطّماه

94
00:04:41,750 --> 00:04:43,220
أجل، حطّماه

95
00:04:43,700 --> 00:04:45,130
!ابتعد يا غبيّ

96
00:04:45,740 --> 00:04:47,880
ما الّذي فعلاه؟

97
00:04:47,880 --> 00:04:49,840
!علينا إصلاحه الآن

98
00:04:49,840 --> 00:04:51,290
أنا آسف

99
00:04:51,290 --> 00:04:53,530
لذا أصلحه... فحسب، اتّفقنا؟

100
00:04:53,530 --> 00:04:54,800
أسبوعان

101
00:04:55,730 --> 00:04:58,190
!سيستغرق أسبوعين لإصلاحه

102
00:04:58,590 --> 00:05:00,770
!ماذا؟

103
00:05:02,930 --> 00:05:05,860
لا تقل هذا الكلام. يمكنك إصلاحه، صحيح؟

104
00:05:05,860 --> 00:05:09,660
ليسَ بهذا المقدارِ من الدَّمار

105
00:05:09,660 --> 00:05:10,650
!مستحيل

106
00:05:10,650 --> 00:05:12,750
لكن ربّما يصبُّ هذا في صالحنا

107
00:05:13,640 --> 00:05:16,710
هذا يعني بأنّكما ستبقيان هنا

108
00:05:17,350 --> 00:05:19,500
ثمّة أمر أريد مناقشته معكم جميعاً

109
00:05:19,500 --> 00:05:21,870
أمر؟ ما هو؟

110
00:05:21,870 --> 00:05:24,550
يخصُّ بعثة العالم الرّقميّ

111
00:05:24,550 --> 00:05:27,210
وذاك الفتى كذلك

112
00:05:27,210 --> 00:05:28,680
تقصد إيكوتو؟

113
00:05:30,390 --> 00:05:34,060
،كانت بعثة العالم الرّقميّ فريق مشروع

114
00:05:34,060 --> 00:05:38,790
أوّل بشر تطأ أقدامهم العالم الرّقميّ

115
00:05:38,790 --> 00:05:44,190
كانت النّتيجة المباشرة لحادِثة
—وقعت قبل 10 سنوات

116
00:05:46,320 --> 00:05:53,750
سلسلة من الاختفاءات الغامضة
الّتي لا تفسير لها

117
00:05:53,750 --> 00:05:59,570
،لم يكن لدى الضّحايا شيء مشترك
ولا وجود لأي دافع

118
00:05:59,570 --> 00:06:03,250
بدا وكأنّ أُناس عشوائيّين يختفون ببساطة

119
00:06:04,260 --> 00:06:06,220
،بعد أن شعرَتْ بخطر هذه الأحداث

120
00:06:06,220 --> 00:06:10,350
نظّمتْ وزارةُ أمن المعلومات فريقاً خاصّاً

121
00:06:10,350 --> 00:06:11,300
...أطلقنا عليه

122
00:06:11,300 --> 00:06:13,970
...بعثة العالم الرّقميّ

123
00:06:13,970 --> 00:06:16,700
كانوا مؤسّسي ف.ب.ت من ناحية

124
00:06:16,700 --> 00:06:18,980
ومن بينهم مُمثّلا الشّرطة

125
00:06:18,980 --> 00:06:21,640
والمُحقِّقان السّابقان، الرّئيس يوشيما وأنا

126
00:06:21,640 --> 00:06:22,440
مُحقّقان؟

127
00:06:22,440 --> 00:06:24,640
سيّدي، كنتَ محقّقاً في الشّرطة؟

128
00:06:25,650 --> 00:06:27,370
وكان من بين المُمثّلين المدنيّين

129
00:06:27,370 --> 00:06:29,950
،والد ماسارو، الدّكتور دايمون

130
00:06:29,950 --> 00:06:31,440
،ومُعاونه كوراتا-كن

131
00:06:31,440 --> 00:06:35,410
وكذلك الزّوجان نوغوتشي، الخبيران الرِّياديان
في أبحاث الفضاء

132
00:06:38,050 --> 00:06:41,580
ونتائجُ ما جمعَه فريقُنا وما خرجَ به من تحليل

133
00:06:41,580 --> 00:06:45,300
قادتنا إلى اكتشاف عالم آخر

134
00:06:45,300 --> 00:06:47,710
تقصد العالم الرّقميّ؟

135
00:06:48,200 --> 00:06:49,490
أجل

136
00:06:49,490 --> 00:06:56,470
بعد الاستنتاج بأنّ الأشخاص المفقودين
،أُرسِلوا إلى هذا العالم الآخر

137
00:06:56,470 --> 00:06:58,390
نظّمنا بعثة هناك

138
00:07:03,310 --> 00:07:05,900
حينئذ بدأ الجحيم الحقيقيّ

139
00:07:07,420 --> 00:07:13,320
في العالم الرّقميّ، مررنا بنكسة تلو الأخرى

140
00:07:14,450 --> 00:07:16,890
...هجمات الدّيجيمونات

141
00:07:21,410 --> 00:07:25,290
...نقص في المؤونات

142
00:07:29,120 --> 00:07:33,640
ذكرتُ من قبل أنّ الدّكتور دايمون
كان مفقوداً هناك

143
00:07:35,700 --> 00:07:40,930
لكن الزّوجين نوغوتشي اللّذين ذكرتُهما
...كجزء من الفرقة

144
00:07:41,300 --> 00:07:42,850
...إنّهما

145
00:07:44,520 --> 00:07:46,740
!والدا ذلك الفتى

146
00:08:52,600 --> 00:08:54,020
والدا إيكوتو؟

147
00:08:54,020 --> 00:08:55,930
ماذا؟ ما معنى هذا؟

148
00:08:56,420 --> 00:08:59,930
فحصتُ الحمض النّوويّ الرّيبيّ الخاصّ به

149
00:08:59,930 --> 00:09:04,430
كشفت الفحص بأنّه ابنهما

150
00:09:05,310 --> 00:09:07,190
!لستُ أفهم

151
00:09:07,190 --> 00:09:09,260
هلّا أسهبتَ أكثر في الشّرح رجاء؟

152
00:09:09,260 --> 00:09:13,650
كان الزّوجان نوغوتشي رياديّين في مجال
،أبحاث الفضاء الما ورائيّ

153
00:09:14,160 --> 00:09:16,590
لكن تأثّرا أيضاً بحالات الاختفاء

154
00:09:18,020 --> 00:09:20,600
...سبب مشاركتهما في البعثة

155
00:09:20,600 --> 00:09:25,580
كان هو أنّ ابنهما المولود حديثاً
قد انجذب نحو العالم الرّقميّ

156
00:09:30,280 --> 00:09:34,300
!إيكوتو

157
00:09:34,300 --> 00:09:36,380
اذهبوا وتكّموا مع الزّوجين نوغوتشي

158
00:09:36,380 --> 00:09:38,800
إنّهما يعيشان حالياً في جبال
الألب اليابانيّة

159
00:09:39,140 --> 00:09:40,930
!دعني! لن أذهب

160
00:09:40,930 --> 00:09:43,590
!أمّي ليست بشريّة غبيّة ما

161
00:09:43,590 --> 00:09:46,270
استسلم يا فتى! أنت بشريٌّ حاليّاً، مفهوم؟

162
00:09:46,500 --> 00:09:48,480
!لا! أنا ديجيمون

163
00:09:48,480 --> 00:09:50,440
...بدأت تستفزّني يا هذا

164
00:09:50,440 --> 00:09:54,930
!تريدني أن أثبت بأنّك بشريّ؟

165
00:09:54,930 --> 00:09:55,650
!هيّا

166
00:09:55,650 --> 00:09:56,970
!دعه

167
00:09:56,970 --> 00:09:58,990
!أجل. أنت تؤذيه

168
00:09:58,990 --> 00:10:00,980
وماذا يُفترض بي أن أفعل؟

169
00:10:00,980 --> 00:10:04,300
!هذا الفتى لا يملك أي منزل آخر هنا

170
00:10:07,260 --> 00:10:08,830
!موتوا جميعكم

171
00:10:13,890 --> 00:10:16,920
ليس وكأنّنا نستطيع إعادتك إلى العالم
الرّقميّ على أيّ حال

172
00:10:17,420 --> 00:10:19,940
لذا أعتقد ستبقى معي لبعض الوقت

173
00:10:19,940 --> 00:10:22,640
إلّا إن كان هناك مكان آخر
تفضّل الذّهاب إليه؟

174
00:10:23,750 --> 00:10:25,410
لا؟ إذاً كفّ عن التذمُّر يا فتى

175
00:10:25,410 --> 00:10:26,600
هيّا

176
00:10:29,130 --> 00:10:31,560
بشر بائسون

177
00:10:31,560 --> 00:10:33,980
ماذا سنفعل الآن يا مولايّ؟

178
00:10:34,280 --> 00:10:36,670
أنا قلق على إيكوتو وفالكومون

179
00:10:36,670 --> 00:10:39,020
أريد استرجاعهما أوّلاً

180
00:10:39,020 --> 00:10:43,200
من فضلك... من فضلك دعني
!أتولّى ذلك يا مولايّ

181
00:10:50,720 --> 00:10:52,940
!ما-ما هذا المكان؟

182
00:10:57,360 --> 00:10:59,050
هذه ردّة فعل لطيفة

183
00:10:59,050 --> 00:11:02,200
أنت متحمّس أكثر من السّائح العاديّ حتّى

184
00:11:02,200 --> 00:11:04,390
!لستُ سائجاً! أنا ديجيمون

185
00:11:05,060 --> 00:11:06,720
أجل، فهمت

186
00:11:06,720 --> 00:11:09,280
!لدينا أشياء كثيرة لا يملكها العالم الرّقميّ

187
00:11:09,280 --> 00:11:12,360
!غير صحيح! العالم الرّقميّ فيه كلّ شيء

188
00:11:12,360 --> 00:11:14,860
حقّاً؟ هل فيه هذا إذاً؟

189
00:11:15,870 --> 00:11:18,060
!أجل! إنّها جداريّة بيانات

190
00:11:18,060 --> 00:11:21,870
خطأ، هذا تلفزيون! الصّورة تتحرّك فيه، صحيح؟

191
00:11:21,870 --> 00:11:24,120
.أعرف كلّ شيء عن هذا
فالكومون بارع في ذلك

192
00:11:24,350 --> 00:11:26,840
البراعةُ من عدمِها لا علاقة لها بتلفزيون

193
00:11:26,840 --> 00:11:30,170
لدى ميركوريمون مِئات من هذه الأشياء

194
00:11:30,170 --> 00:11:31,050
!حقّاً؟

195
00:11:31,050 --> 00:11:32,330
!هذا غير صحيح

196
00:11:32,330 --> 00:11:33,790
!بل صحيح

197
00:11:32,850 --> 00:11:33,790
يوشينو؟

198
00:11:34,490 --> 00:11:37,990
!لا يمكنك مشاهدة مئة تلفزيون
هذا يُضرُّ بعينيك

199
00:11:34,970 --> 00:11:37,720
هذا أشبه بوجود اثنين من ماسارو، صحيح؟

200
00:11:37,720 --> 00:11:40,510
ما إن يبدآ بالشِّجار، لا يتوقّفان

201
00:11:37,990 --> 00:11:40,510
!ما كنتُ لأتحمّل ذلك

202
00:11:40,790 --> 00:11:42,570
!أنا واثق بأنّك لا تملك واحداً حتّى

203
00:11:40,910 --> 00:11:42,220
...لكن

204
00:11:42,220 --> 00:11:44,770
!يبدو وكأنّهما منسجمان

205
00:11:42,570 --> 00:11:45,180
لدينا تلفزيون بالتّأكيد! لكنّه ليس بالفاخر

206
00:11:44,770 --> 00:11:47,430
!هناك أمور مشتركة كثيرة بينهما

207
00:11:45,180 --> 00:11:46,480
!إنّه صغير

208
00:11:46,480 --> 00:11:47,690
!ماذا قلت؟

209
00:11:47,690 --> 00:11:49,430
!لا أسمح لك بذلك أيّها الشّقيّ

210
00:11:50,850 --> 00:11:53,290
...يا له من عالم غريب

211
00:11:53,290 --> 00:12:00,420
كلّ هؤلاء البشر والمركبات الّتي تتنقّل
...بسرعات عالية دون اصطدام

212
00:12:00,420 --> 00:12:01,280
...وفضلاً عن ذلك

213
00:12:11,460 --> 00:12:16,770
إعلان عن الحدثِ الخاصّ في المحلَّات حيثُ
ستُباع أغنية هانامورا نيون الجديدة

214
00:12:16,770 --> 00:12:19,340
—بالطّبع، أغنيته الأحدث

215
00:12:27,810 --> 00:12:29,490
هل ما زلت تشعر بدُوار؟

216
00:12:29,490 --> 00:12:31,480
أنا بخير الآن

217
00:12:31,750 --> 00:12:33,050
إنّه الزّعيم

218
00:12:36,480 --> 00:12:38,460
تفضّل. أنت جائع، صحيح؟

219
00:12:39,580 --> 00:12:41,070
!أعِدُك بأنّه غير مُسمّم

220
00:12:44,620 --> 00:12:46,280
!إيكوتو، هذا شهيّ

221
00:12:46,280 --> 00:12:49,110
!إن كنت لا تريد، فسآكله أنا

222
00:13:00,700 --> 00:13:03,090
هدأت الأمور هنا أخيراً

223
00:13:03,840 --> 00:13:07,270
بئساً. الاعتناء بالأطفال ليس سهلاً

224
00:13:07,270 --> 00:13:09,890
ماذا؟ كنتَ تعتني به إذاً؟

225
00:13:09,890 --> 00:13:11,560
ماذا تقصدين بذلك؟

226
00:13:11,860 --> 00:13:13,260
لا شيء

227
00:13:13,260 --> 00:13:15,800
بدا أنّك كنتَ تبذل جهداً كبيراً

228
00:13:15,800 --> 00:13:17,100
لم أكن كذلك

229
00:13:18,290 --> 00:13:19,520
ماذا كنتَ تفعل إذاً؟

230
00:13:20,060 --> 00:13:24,030
.بما أنَّ لديه أبوان، فينبغي أن يراهما
هذا كُل ما في الأمر

231
00:13:24,530 --> 00:13:25,440
هذا صحيح

232
00:13:32,040 --> 00:13:35,250
لكن الآن بعد أن أُغلِقت البوّابة الرّقميّة
،عند الجبال الجليديّة اللّانهائيّة

233
00:13:35,250 --> 00:13:38,060
!ليس من السّهل الوصول إلى العالم البشريّ

234
00:13:38,060 --> 00:13:42,340
أهدر الكثير من الوقت بمجرّد
!محاولة البحث عن بوّابة

235
00:13:42,830 --> 00:13:45,620
!أما من... أما من طريقة أسهل؟

236
00:13:49,240 --> 00:13:50,970
...تلك الغابة... أليست

237
00:13:59,790 --> 00:14:01,980
هل يُمكن أن يسوء الأمر أكثر؟

238
00:14:05,690 --> 00:14:08,340
كان يتفاخر بنضجه قبل لحظات

239
00:14:09,310 --> 00:14:10,910
!إنّه مجرّد طفل في النّهاية

240
00:14:11,560 --> 00:14:13,960
ويفتقر لأدنى آداب السّلوك

241
00:14:13,960 --> 00:14:16,720
!يُفترض بك أن تُراعي مشاعر السّائق

242
00:14:16,720 --> 00:14:19,140
...تجعلني أتولّى القيادة طوال الطّريق

243
00:14:19,140 --> 00:14:21,130
كونُه تلميذاً ليس عذراً

244
00:14:21,440 --> 00:14:24,720
دعيه نائماً! لا بدّ أنّه مُرهَق

245
00:14:24,720 --> 00:14:27,240
!أنا مُرهَقة أيضاً

246
00:14:27,240 --> 00:14:30,090
...كنتُ لأتولّى القيادة عنكِ، لكن لا أستطيع

247
00:14:30,630 --> 00:14:33,380
أنا واثقة بأنّه لن يحظى بخليلة في حياته

248
00:14:34,980 --> 00:14:36,090
...هذا

249
00:14:36,090 --> 00:14:37,450
نداء طوارئ

250
00:14:37,450 --> 00:14:40,100
نرصد ديجيموناً في منطقة هوكوشينيتسو

251
00:14:40,430 --> 00:14:43,470
مُستوى الإنذار 3، المنطِقة ن-205

252
00:14:43,470 --> 00:14:46,500
إشارة واحدة فقط حالياً

253
00:14:46,500 --> 00:14:47,570
!مهلاً لحظة

254
00:14:47,910 --> 00:14:48,820
ما الأمر؟

255
00:14:49,500 --> 00:14:51,110
!ألتقط إشارة ديجيمون أخرى

256
00:15:01,000 --> 00:15:03,050
ما الأمر يا يوشينو؟

257
00:15:03,050 --> 00:15:05,370
ألا يمكنكِ القيادة بهدوء أكثر؟

258
00:15:05,370 --> 00:15:08,540
اصمت! الوقت ليس مناسباً لذلك الآن

259
00:15:08,540 --> 00:15:10,070
!ظهرَ ديجيمون

260
00:15:10,070 --> 00:15:10,970
!ماذا؟ أين؟

261
00:15:11,580 --> 00:15:15,310
إنّه قريب حقّاً. علينا الوصول إلى هناك
قبل أن تحدث مشكلة

262
00:15:15,720 --> 00:15:16,580
حسناً

263
00:15:16,580 --> 00:15:18,020
!ينبغي أن يكون هذا ممتعاً

264
00:15:37,570 --> 00:15:41,070
أوكوامون. ديجيمون بمستوى ممتاز
من نوع حشرة

265
00:15:41,070 --> 00:15:43,450
!تستطيع كمّاشته العملاقة قطع أيّ شيء

266
00:15:43,450 --> 00:15:46,040
!هجمته الخاصّة هي ذِراع المقصّ أوميغا

267
00:15:55,800 --> 00:15:58,310
!إيكوتو... يجب العثور على إيكوتو

268
00:16:06,800 --> 00:16:08,190
!اللّهب الصّغير

269
00:16:11,590 --> 00:16:14,120
!أنت... أنت هنا

270
00:16:14,990 --> 00:16:15,910
!غوتسومون

271
00:16:18,610 --> 00:16:20,890
،سأحرص على أن تُصيبك نيران صديقة

272
00:16:20,890 --> 00:16:23,920
!بحيث لا تعود أبداً إلى العالم الرّقميّ

273
00:16:24,320 --> 00:16:25,380
!اقضوا عليهم

274
00:16:25,640 --> 00:16:26,590
!هيّا بنا

275
00:16:26,590 --> 00:16:27,630
!أجل

276
00:16:27,630 --> 00:16:28,380
!لالامون

277
00:16:28,380 --> 00:16:28,840
!حسناً

278
00:16:29,620 --> 00:16:30,670
...الشّحن الكامل

279
00:16:35,010 --> 00:16:36,050
!للرُّوح الرّقميّة

280
00:16:40,140 --> 00:16:41,590
لالامون، تطوّري

281
00:17:01,840 --> 00:17:02,740
!ليلامون

282
00:17:04,380 --> 00:17:05,350
!ماسارو

283
00:17:05,350 --> 00:17:06,080
!حسناً

284
00:17:11,740 --> 00:17:12,900
!إيكوتو، هيّا بنا

285
00:17:12,900 --> 00:17:14,420
!جاء غوتسومون للنّيل منّا

286
00:17:25,470 --> 00:17:26,270
!أغومون

287
00:17:26,590 --> 00:17:27,350
!أجل

288
00:17:30,440 --> 00:17:32,880
!شحن الرُّوح الرّقميّة

289
00:17:37,490 --> 00:17:39,350
أغومون، تطوّر

290
00:17:44,610 --> 00:17:45,750
!جيوغريمون

291
00:17:53,730 --> 00:17:55,380
ما الخطب يا إيكوتو؟

292
00:17:55,380 --> 00:17:56,170
...أنا فقط

293
00:17:59,210 --> 00:18:00,090
هكذا

294
00:18:00,090 --> 00:18:01,680
!استمرّ في تثبيته

295
00:18:08,770 --> 00:18:10,650
!مرّة أخرى

296
00:18:11,480 --> 00:18:12,480
...الشّحن الكامل

297
00:18:16,820 --> 00:18:18,340
!للرُّوح الرّقميّة

298
00:18:21,900 --> 00:18:23,630
جيوغريمون، تطوّر

299
00:18:38,480 --> 00:18:40,090
!رايزغريمون

300
00:18:42,200 --> 00:18:44,160
!هيّا يا رايزغريمون

301
00:18:53,770 --> 00:18:55,190
!سأتعامل مع إيكوتو على الأقلّ

302
00:18:56,790 --> 00:18:57,850
!إيّاك

303
00:18:57,850 --> 00:18:59,490
!ماذا تفعل يا غوتسومون؟

304
00:18:59,490 --> 00:19:01,240
!ظننتُ بأنّنا في نفس الصفّ

305
00:19:01,240 --> 00:19:02,730
كلام فارغ

306
00:19:02,730 --> 00:19:05,330
!سوف... سوف أقتل إيكوتو

307
00:19:06,790 --> 00:19:07,750
لكن لماذا؟

308
00:19:07,750 --> 00:19:10,180
!إيكوتو خاننا

309
00:19:10,180 --> 00:19:13,460
!حقيقة وجوده مع هؤلاء البشر الآن تثبت ذلك

310
00:19:13,740 --> 00:19:15,170
!لا! الأمر ليس كذلك

311
00:19:15,170 --> 00:19:17,200
!بل هو كذلك قطعاً

312
00:19:17,200 --> 00:19:20,660
!إيكوتو هو سبب صراعنا مع العالم البشريّ

313
00:19:20,660 --> 00:19:22,970
!إنّه وباء بالنّسبة للعالم الرّقميّ

314
00:19:23,420 --> 00:19:24,930
!نحن أفضل حالاً من دونه

315
00:19:31,750 --> 00:19:32,650
...أنا

316
00:19:33,230 --> 00:19:34,480
!فلتمُت

317
00:19:34,480 --> 00:19:36,440
!إيكوتو

318
00:19:48,760 --> 00:19:50,120
...مؤلم

319
00:19:50,120 --> 00:19:51,170
...أنت

320
00:19:51,170 --> 00:19:54,250
!تبَّاً، كفّ عن جعلي أعتني بكَ طوالَ الوقت

321
00:20:00,850 --> 00:20:01,880
!ليلامون

322
00:20:02,450 --> 00:20:04,150
!طلقة الأعجوبة

323
00:20:14,550 --> 00:20:16,310
!خذ هذه

324
00:20:19,670 --> 00:20:23,310
يهزمون أوكوامون واحداً تِلو الآخر

325
00:20:32,850 --> 00:20:33,770
!أوكوامون

326
00:20:33,770 --> 00:20:35,960
!هيّا... هيّا ننسحب

327
00:20:36,280 --> 00:20:38,820
!لحظة! لسنا أعداء لكم

328
00:20:38,820 --> 00:20:42,200
!أعيدونا معكم إلى العالم الرّقميّ

329
00:20:42,200 --> 00:20:43,800
كفاك هُراء

330
00:20:43,800 --> 00:20:48,190
إيكوتو هو مخلوق مقيت! خطر
!على العالم الرّقميّ

331
00:20:48,190 --> 00:20:51,890
!لم يعُد لديه منزل في العالم الرّقميّ

332
00:20:51,890 --> 00:20:54,850
!هذه إرادة كافّة الدِّيجيمونات

333
00:20:55,080 --> 00:20:56,610
إيكوتو بشريّ

334
00:20:56,610 --> 00:20:58,890
!أجل، إنّه بشريّ

335
00:21:09,420 --> 00:21:10,450
...إيكوتو

336
00:22:49,510 --> 00:22:50,300
!اللّعنة

337
00:22:50,300 --> 00:22:53,580
هاغورومون هائج بوجود أمّ إيكوتو في الدّاخل

338
00:22:53,580 --> 00:22:56,510
!أنا ديجيمون! ليس لديّ أمّ بشريّة

339
00:22:56,510 --> 00:22:59,410
!إيكوتو! لا يمكنك محو حبّك لوالديك

340
00:22:59,410 --> 00:23:02,270
خرجَ ذلك الدِّيجيمون عن السّيطرة
!لأنّه يمتصّ مشاعرك

341
00:23:02,270 --> 00:23:06,060
اذهب! أنت الوحيد القادر
!على إنقاذ أمّك

342
00:23:06,060 --> 00:23:07,620
:مُنقِذو الدِّيجيمون

343
00:23:07,620 --> 00:23:11,030
!أنقذ أمّك يا إيكوتو"
"!قفص هاغورومون

344
00:23:11,030 --> 00:23:13,410
!استيقظي في قبضتي أيّتها الرُّوح الرّقميّة