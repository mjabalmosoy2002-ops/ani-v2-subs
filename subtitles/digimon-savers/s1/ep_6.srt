1
00:00:16,810 --> 00:00:18,370
!اللّهب الصّغير

2
00:00:21,400 --> 00:00:22,370
!نلت منه

3
00:00:23,540 --> 00:00:25,250
تورتومون
مستوى بالغ

4
00:00:26,080 --> 00:00:27,460
إلى أين تنظر في رأيك؟

5
00:00:31,410 --> 00:00:33,110
!ها هي ذي الرّوح الرّقميّة

6
00:00:40,920 --> 00:00:42,100
هل أنت بخير يا أغومون؟

7
00:00:43,710 --> 00:00:45,230
!نعم، أنا بخير

8
00:00:45,230 --> 00:00:45,600
!جيّد

9
00:00:46,380 --> 00:00:48,040
!هيّا بنا أيّها الوغد

10
00:00:50,970 --> 00:00:54,150
!شحن الرّوح الرّقميّة

11
00:00:54,680 --> 00:00:57,200
!تطوّر أغومون

12
00:01:03,940 --> 00:01:05,350
!جيوغريمون

13
00:01:24,250 --> 00:01:24,980
!حسنًا

14
00:01:26,000 --> 00:01:27,480
!الانفجار الهائل

15
00:01:36,640 --> 00:01:37,660
...يا إلهي

16
00:01:37,660 --> 00:01:40,660
أخبرته عدّة مرّات أن ينتظر
...حتّى ننضمّ إليه

17
00:01:42,310 --> 00:01:44,870
!لقد دمّرت المكان بالكامل

18
00:01:44,870 --> 00:01:47,510
هل فكّرت في إعادة البناء ولو للحظة؟

19
00:01:47,700 --> 00:01:49,350
!قل شيئًا

20
00:01:50,440 --> 00:01:52,170
!لقد فزنا

21
00:01:52,170 --> 00:01:53,000
!نعم

22
00:01:53,000 --> 00:01:54,770
...اسمعا كلاكما

23
00:01:55,070 --> 00:01:58,090
يجب أن تكونا أكثر حذرًا عند
.قتال الدّيجيمون

24
00:01:58,090 --> 00:02:00,090
لا يتعلّق الأمر بالأنتهاء
.من المهمّة بسرعة فحسب

25
00:02:00,090 --> 00:02:01,850
.إنّه منزعج من نفسه

26
00:02:01,850 --> 00:02:03,600
!نعم، إنّه منزعج

27
00:02:03,600 --> 00:02:05,270
!الأمر ليس كذلك

28
00:02:05,270 --> 00:02:08,310
،إن قاتلتما وحدكما وساءت الأوضاع
فما الّذي ستفعلانه إذًا؟

29
00:02:09,340 --> 00:02:13,610
وكأنّ هنالك ديجيمون بإمكانه
!هزيمتنا عندما نقاتل معًا

30
00:02:13,610 --> 00:02:16,740
!أكيد! إنّنا أفضل ثنائيّ على الإطلاق

31
00:02:16,740 --> 00:02:17,280
!على الإطلاق

32
00:02:18,720 --> 00:02:21,030
...هذا هو الأسوأ

33
00:02:21,030 --> 00:02:22,740
.سبقتِني إلى جملتي

34
00:02:24,140 --> 00:02:25,700
!هذا لذيذ

35
00:02:25,900 --> 00:02:28,870
البيض المقليّ الّذي تعدّينه
!يا أمّي هو الأفضل

36
00:02:28,870 --> 00:02:30,040
!نعم، نعم

37
00:02:30,040 --> 00:02:32,630
!سايوري عبقريّة في إعداد البيض المقليّ

38
00:02:32,630 --> 00:02:36,170
كم مرّة عليّ إخبارك ألاّ تنادي
أمّي باسمها الشّخصيّ؟

39
00:02:36,170 --> 00:02:38,300
.لكنّ سايوري هي سايوري

40
00:02:38,300 --> 00:02:39,430
.وتشيكا هي تشيكا

41
00:02:39,430 --> 00:02:40,840
.وأنيكي هو أنيكي أيضًا

42
00:02:40,840 --> 00:02:42,430
!ذلك ليس ما قصدتُه

43
00:02:42,430 --> 00:02:44,510
...تأكلان بشراهة كبيرة

44
00:02:47,710 --> 00:02:49,230
!كانت تلك آخر واحدة

45
00:02:50,040 --> 00:02:51,560
!ولقد سبقتك إليها

46
00:02:51,560 --> 00:02:52,400
!ماذا؟

47
00:02:52,400 --> 00:02:54,440
!على الأتباع أن يكبحوا أنفسهم

48
00:02:54,440 --> 00:02:55,400
!انظروا من يتحدّث

49
00:02:55,400 --> 00:02:57,190
!تقديم الأشياء للأتباع يُظهر كرم أنيكي

50
00:02:57,190 --> 00:02:58,820
!ما أقصده هو أنّك تأكل كثيرًا

51
00:02:58,820 --> 00:03:01,240
!تأكل بثلاثة أضعاف أيّ عالة عاديّ

52
00:03:01,450 --> 00:03:02,990
!بدأت تسيء التّصرّف

53
00:03:01,930 --> 00:03:05,160
...يا إلهي، يعرفان تمامًا ما الّذي يتحدّثان عنه

54
00:03:02,990 --> 00:03:05,160
!وكذلك أنت

55
00:03:05,160 --> 00:03:07,410
.ذلك لأنّهما شاهدا ذلك على التّلفاز

56
00:03:05,160 --> 00:03:08,120
!وأنت تتكلّم كثيرًا أثناء نومك
!ما عدت أستطيع النّوم بهناء

57
00:03:07,410 --> 00:03:10,460
ومع ذلك، من المذهل أنّهما
!يذاكران بينما يشاهدان التّلفاز

58
00:03:08,120 --> 00:03:10,120
!إنّك تشخر بصوت عالٍ

59
00:03:10,120 --> 00:03:12,850
!أنت أسوأ بكثير، تبدو مثل فيل

60
00:03:10,460 --> 00:03:11,620
...أمّي

61
00:03:13,190 --> 00:03:16,560
حسنًا، لن أقوم بتقديم
!المساعدة لك بعد الآن

62
00:03:16,650 --> 00:03:19,420
،لو لم أقدّم لك المساعدة اليوم
!لكنتَ قد ودّعتَ الحياة

63
00:03:19,420 --> 00:03:22,130
!ماذا؟! لا تتصرّف بغرور شديد هكذا

64
00:03:22,130 --> 00:03:25,780
!لا يمكنك حتّى التّطوّر بدون روحي الرّقميّة

65
00:03:28,790 --> 00:03:29,810
!سُحقًا

66
00:03:29,810 --> 00:03:30,850
!ما عدتُ أتحمّل هذا

67
00:03:30,850 --> 00:03:32,270
!لن أكون تابعك بعد الآن

68
00:03:32,550 --> 00:03:34,190
!وأنا أيضًا لا أمانع ذلك

69
00:03:34,190 --> 00:03:36,690
!لم نعد أنيكي وتابعه بعد الآن

70
00:03:37,300 --> 00:03:38,650
!انتهت علاقتنا

71
00:03:39,390 --> 00:03:41,570
لهذا السّبب أنت هناك في الدّاخل؟

72
00:03:44,010 --> 00:03:45,700
...هذا مزعج

73
00:03:45,700 --> 00:03:47,740
.يا لهما من طفلين

74
00:03:50,400 --> 00:03:51,580
.أنا متفاجئ بالفعل

75
00:03:51,810 --> 00:03:53,330
.وكذلك أنا

76
00:03:53,330 --> 00:03:55,000
أتصدّق ما فعله أغومون؟

77
00:03:55,000 --> 00:03:56,130
.ذلك ينطبق عليك أيضًا

78
00:03:56,130 --> 00:03:58,110
.كان شجاركما عن شيء تافه

79
00:03:58,110 --> 00:03:59,550
!لم تكن غلطتي

80
00:03:59,740 --> 00:04:00,510
!بل إنّها غلطتك

81
00:04:00,510 --> 00:04:01,590
!إنّها غلطتك بالكامل يا أنيكي

82
00:04:01,590 --> 00:04:02,510
!اخرس

83
00:04:02,510 --> 00:04:04,510
،لم تعد تجمعنا أيّ علاقة الآن
!لذلك لا تتحدّث معي

84
00:04:04,510 --> 00:04:07,220
!أتحرّق شوقًا لرؤيتك تهزم الدّيجيمون وحدك

85
00:04:07,220 --> 00:04:11,950
لا بأس! أنا أكثر من كافٍ
!لمواجهة ديجيمون أو اثنين

86
00:04:17,760 --> 00:04:19,820
!لننتظر ونرى ذلك يا أنيكي

87
00:04:22,050 --> 00:04:23,450
ما الّذي يحدث؟

88
00:04:23,450 --> 00:04:24,630
!أهنالك حادثة؟

89
00:04:25,220 --> 00:04:28,470
،إن كنّا لا نستطيع حتّى التّحرّك
!فسُحقًا لأضواء المرور

90
00:04:33,650 --> 00:04:36,000
!سُحقًا لأضواء المرور

91
00:05:40,970 --> 00:05:42,990
"!دمار ثنائيّ ماسارو وأغومون؟"

92
00:05:43,060 --> 00:05:44,490
"!غارورومون العاصفة"

93
00:05:51,430 --> 00:05:54,340
سيحلّ الآن السّلام مرّة أخرى
.في عائلة دايمون

94
00:05:57,980 --> 00:06:00,600
.سأقوم بكلّ شيء بنفسي

95
00:06:01,650 --> 00:06:03,420
.اسمع يا أغومون-تشان

96
00:06:03,420 --> 00:06:04,630
هل أنت جائع؟

97
00:06:04,910 --> 00:06:06,510
ما رأيك بوجبة خفيفة؟

98
00:06:06,510 --> 00:06:09,800
!انظر، إنّه برغر خاصّ بثلاثة أضعاف اللّحم

99
00:06:09,800 --> 00:06:11,350
!يمكنك أكل ما تستطيع منه

100
00:06:11,420 --> 00:06:13,240
!اخرسا! دعاني وشأني

101
00:06:14,750 --> 00:06:16,060
...ما باليد حيلة إذًا

102
00:06:16,060 --> 00:06:18,950
.أغومون-تشان، سنأكل بعضه أوّلاً

103
00:06:21,260 --> 00:06:23,900
كيف سيتصالحا مع بعضهما؟

104
00:06:23,900 --> 00:06:26,080
.إنّه ليس أمرًا علينا التّدخّل فيه

105
00:06:26,760 --> 00:06:29,610
.لكن لا يجب أن نسمح باستمرار هذا

106
00:06:29,610 --> 00:06:31,410
.عليهما أن يتعلّما لماذا هما مهمّين لبعضهما

107
00:06:31,980 --> 00:06:35,370
،إن لم يجدا ذلك الجواب
.فستكون هذه نهاية رحلتهما معًا

108
00:06:44,320 --> 00:06:45,920
.ذلك اللّعين الصّغير

109
00:06:46,410 --> 00:06:50,130
.كان هو من أراد أن يصير تابعي من البداية

110
00:06:52,630 --> 00:06:53,740
!سُحقًا

111
00:06:57,420 --> 00:07:00,850
.تصرّفاتك غير مفهومة يا أغومون

112
00:07:00,850 --> 00:07:05,150
كنت تقول دائمًا أنّك تكره التّواجد داخل
.الجهاز الرّقميّ لأنّك تشعر بالوحدة فيه

113
00:07:05,150 --> 00:07:07,030
!ما كنتما لتفهما

114
00:07:07,260 --> 00:07:08,410
.معك حقّ

115
00:07:08,520 --> 00:07:10,450
.لذلك السّبب أنا مهتمّ بالأمر

116
00:07:10,450 --> 00:07:12,240
.دعني وشأني فحسب

117
00:07:13,310 --> 00:07:17,040
تشاجرتَ مع سيّدك واختبأتَ
...في الجهاز الرّقميّ

118
00:07:17,040 --> 00:07:18,850
هناك أمور عديدة حيال هذا
.لا يمكنني تحليلها

119
00:07:18,850 --> 00:07:20,730
لم تتشاجرا من قبل يا غاومون؟

120
00:07:20,730 --> 00:07:22,790
.نحن نتشاجر كلّ يوم

121
00:07:22,790 --> 00:07:26,210
.هذا مثير للاهتمام
.أخبريني عن السّبب رجاءً

122
00:07:26,210 --> 00:07:28,630
!يوشينو كسولة دائمًا

123
00:07:28,630 --> 00:07:33,220
لا تنظّف غرفتها ولا تطوي ملابسها
—ولديها عادات نوم سيّئة و

124
00:07:33,220 --> 00:07:34,680
!رويدك

125
00:07:34,680 --> 00:07:37,060
!لا تخبري الآخرين عن حياتي الخاصّة

126
00:07:38,120 --> 00:07:40,060
!هذا مؤلم! مؤلم

127
00:07:41,460 --> 00:07:43,230
هل رأيت تلك الدّورة الكاملة؟

128
00:07:43,230 --> 00:07:45,110
!لو أنّها— هذا مؤلم

129
00:07:45,110 --> 00:07:45,730
!توقّف يا هذا

130
00:07:49,260 --> 00:07:50,750
!دا... دايمون

131
00:07:50,970 --> 00:07:52,200
كاتسوماتا؟

132
00:07:52,400 --> 00:07:55,000
ما زلت تتجوّل هنا؟

133
00:07:56,930 --> 00:07:58,130
!مـ-مهلاً

134
00:08:04,400 --> 00:08:05,710
.يا للحظّ السّيّئ

135
00:08:06,820 --> 00:08:09,460
.الغضب على حظّك لن يفيدك بشيء

136
00:08:09,460 --> 00:08:10,940
.كنتُ أقصد حظّك أنت

137
00:08:11,300 --> 00:08:14,470
!أنا غاضب جدًّا في الوقت الحاليّ

138
00:08:16,620 --> 00:08:21,180
.سيُحلّ كلّ شيء إن خرجت من هناك فحسب

139
00:08:21,180 --> 00:08:23,900
!لن أفعل ذلك أبدًا حتّى يعتذر أنيكي

140
00:08:24,050 --> 00:08:26,190
.لا بأس، ابق هناك للأبد

141
00:08:27,590 --> 00:08:31,240
.جرح أنيكي كرامتي

142
00:08:31,240 --> 00:08:34,780
!لا يمكنك حتّى التّطوّر بدون روحي الرّقميّة

143
00:08:44,980 --> 00:08:47,500
ما الخطب؟ هل اكتفيت سلفًا؟

144
00:08:58,830 --> 00:09:02,680
!أيّها الشّابّ! هل انتهت مشاكلك؟

145
00:09:04,260 --> 00:09:06,100
العجوز الّذي أعطاني الجهاز الرّقميّ؟

146
00:09:06,100 --> 00:09:07,310
ما الّذي تفعله هنا؟

147
00:09:08,600 --> 00:09:10,940
.كما ترى تمامًا، أقرأ الطّالع

148
00:09:10,940 --> 00:09:11,940
...دعني أرى

149
00:09:12,730 --> 00:09:15,490
تبحث عن شيء ما، صحيح؟

150
00:09:15,490 --> 00:09:17,110
.لا علاقة للأمر بك

151
00:09:17,940 --> 00:09:21,170
هذا مؤسف، لكنّ الأمور موجودة
.دائمًا حيث يمكنك إيجادها

152
00:09:21,820 --> 00:09:25,790
إنّ الأشياء الّتي تحتاج إليها بحقّ
.تظهر حتّى إن كنت لا تبحث عنها

153
00:09:25,790 --> 00:09:29,210
.ذلك لأنّك تدرك لماذا تحتاجها

154
00:09:29,210 --> 00:09:33,810
وإن كنت تجهل ذلك، فذلك يعني
.أنّك لم تحتج إليها أبدًا من الأساس

155
00:09:34,300 --> 00:09:35,670
.أنت تتكلّم كثيرًا

156
00:09:39,920 --> 00:09:43,180
هل فهم أم لا؟

157
00:09:47,220 --> 00:09:49,650
!سُحقًا لدايمون ذاك

158
00:09:49,650 --> 00:09:51,700
!لن يفلت منّي بسهولة المرّة القادمة

159
00:09:54,100 --> 00:09:56,610
!سُحقًا، إنّ أضواء المرور تتأخّر كثيرًا ثانية

160
00:09:56,610 --> 00:09:57,740
!هيّا، تغيّري

161
00:09:58,310 --> 00:10:00,700
!تغيّر الأضواء

162
00:10:01,820 --> 00:10:02,830
!ماذا؟

163
00:10:04,750 --> 00:10:10,250
إليكمون
مستوى طفل

164
00:10:08,370 --> 00:10:10,250
!تغيّر الأضواء

165
00:10:28,060 --> 00:10:31,060
التُقطت إشارة ديجيمون
!في المنطقة بي-4 من المدينة

166
00:10:31,390 --> 00:10:34,020
...يتوافدون كثيرًا اليوم

167
00:10:34,020 --> 00:10:35,440
أين ماسارو؟

168
00:10:35,440 --> 00:10:37,030
!لا يمكنني الاتّصال به

169
00:10:37,480 --> 00:10:38,820
.لا خيار أمامنا

170
00:10:38,820 --> 00:10:40,780
.اذهبا أنتما في الحال

171
00:10:40,780 --> 00:10:41,990
.عُلم

172
00:10:41,990 --> 00:10:42,490
!سأذهب أيضًا

173
00:10:44,740 --> 00:10:47,370
.مهلاً، نسيت

174
00:10:47,370 --> 00:10:50,210
.قرّرتُ ألاّ أخرج حتّى يعتذر أنيكي

175
00:10:56,330 --> 00:10:57,930
!هذا فظيع

176
00:10:59,170 --> 00:11:00,350
ديجيمون؟

177
00:11:02,340 --> 00:11:03,510
ماذا؟

178
00:11:03,510 --> 00:11:05,180
...الأضواء

179
00:11:05,180 --> 00:11:06,220
!...ذلك الوغد

180
00:11:06,220 --> 00:11:07,480
!انتظر

181
00:11:08,600 --> 00:11:10,560
!تمّ تأكيد تحليل الدّيجيمون

182
00:11:11,020 --> 00:11:14,610
.إليكمون. مستوى طفل
.ديجيمون من نوع الثّدييّات

183
00:11:14,860 --> 00:11:18,190
!بإمكانه استعمال الكهرباء للتّشويش على الإشارات

184
00:11:18,360 --> 00:11:20,030
...لذلك فإنّ الأضواء

185
00:11:20,230 --> 00:11:23,490
.يتحرّك الهدف من المنطقة سي-4 إلى دي-6

186
00:11:23,490 --> 00:11:24,200
.عُلم

187
00:11:46,880 --> 00:11:48,060
.لا بأس

188
00:11:48,060 --> 00:11:49,730
.لم تتأذّي على الإطلاق

189
00:11:54,430 --> 00:11:55,610
...أيّها الوغد

190
00:11:57,680 --> 00:11:58,820
!اعتني بها

191
00:12:01,020 --> 00:12:03,240
!لن تفلت منّي! هيّا يا أغومون

192
00:12:09,860 --> 00:12:13,040
.صحيح... لقد انفصلنا

193
