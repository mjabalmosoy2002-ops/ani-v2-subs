1
00:00:17,900 --> 00:00:19,370
!الكشف عن الماضي

2
00:00:19,370 --> 00:00:21,500
غيزمون عديم الرّحمة: أ.ت

3
00:00:28,540 --> 00:00:32,960
يوكيدارومون، ديجيمون بمستوى بالغ
مُكوّن من ثلج وجليد

4
00:00:32,960 --> 00:00:37,930
بالرّغم من مظهره الّذي يوحي بالبرد، إلّا أنّه
يتمتّع بشخصيّة دافئة ويكره القتال

5
00:00:55,050 --> 00:00:56,490
!يا عزيزي

6
00:00:58,380 --> 00:00:59,710
اهدأ، اهدأ

7
00:00:59,710 --> 00:01:03,610
!إيكوتو! إيكوتو

8
00:01:05,730 --> 00:01:07,000
إيكوتو"؟"

9
00:01:08,140 --> 00:01:10,500
هل تُدعى إيكوتو إذاً؟

10
00:01:10,500 --> 00:01:14,420
!إيكوتو

11
00:01:14,690 --> 00:01:16,110
ماذا أفعل؟

12
00:01:17,810 --> 00:01:18,930
...اهدأ، اهدأ

13
00:01:19,190 --> 00:01:21,260
تريد المجيء معي؟

14
00:01:21,910 --> 00:01:24,640
حقّاً؟ فهمت، فهمت

15
00:01:27,400 --> 00:01:28,790
!لا تتقاتلا

16
00:01:29,380 --> 00:01:33,720
!الزّعيم يخوض معركة رجوليّة الآن

17
00:01:33,720 --> 00:01:34,930
!لا تتقاتلا

18
00:01:34,930 --> 00:01:36,470
!لا تعترض طريقي، اللّعنة

19
00:01:36,470 --> 00:01:38,820
!لن أدعكما تتقاتلان

20
00:01:39,760 --> 00:01:40,910
...تبّاً

21
00:01:41,860 --> 00:01:43,070
!ميركوريمون

22
00:01:43,070 --> 00:01:46,200
!التقيتُ بأمّي في العالم البشريّ

23
00:01:48,150 --> 00:01:51,360
أنا... لستُ ديجيموناً حقّاً، أليس كذلك؟

24
00:01:51,360 --> 00:01:52,800
!أنا بشريّ، ألستُ كذلك؟

25
00:01:53,620 --> 00:01:54,420
أجل

26
00:01:55,100 --> 00:01:56,750
أنت بشريّ

27
00:01:56,750 --> 00:01:59,890
أتيتَ إلى هنا من عالم آخر

28
00:02:00,160 --> 00:02:03,010
!هذا ليس سبباً لمحاولة قتل الفتى

29
00:02:03,450 --> 00:02:04,520
قتله؟

30
00:02:04,520 --> 00:02:05,960
!لا تدّعِ الحماقة

31
00:02:05,960 --> 00:02:09,900
أحضر غوتسومون مجموعة
!من الدِّيجيمونات لمهاجمته

32
00:02:09,900 --> 00:02:12,660
!لم يكن ذلك بأمري

33
00:02:12,660 --> 00:02:13,570
ماذا؟

34
00:02:13,990 --> 00:02:16,030
أتعتقد بأنّ غوتسومون فعلها من تلقاء نفسه؟

35
00:02:16,660 --> 00:02:19,720
الكثير من الدِّيجيمونات يكرهون البشر

36
00:02:19,720 --> 00:02:22,030
وغوتسومون هو واحد منهم

37
00:02:22,530 --> 00:02:24,980
كنتُ أكره البشر أيضاً

38
00:02:24,980 --> 00:02:25,740
...لكن

39
00:02:26,400 --> 00:02:30,900
اللِّقاء بهؤلاء جعلني أدرك بأنّ
ليس كلّ البشر سيّئين

40
00:02:30,900 --> 00:02:31,710
...إيكوتو

41
00:02:32,030 --> 00:02:35,390
فضلاً عن ذلك، أصبحتُ صديقاً لفالكومون

42
00:02:35,390 --> 00:02:39,680
لذا ربّما البشر والدِّيجيمونات لا يحتاجون للقتال

43
00:02:42,590 --> 00:02:44,480
أتقول صديقاً؟

44
00:02:44,480 --> 00:02:47,220
!من المؤكَّد أنّك تمزح

45
00:02:47,650 --> 00:02:52,650
الدِّيجيمونات هي وحوش تُشكِّل
!خطراً على البشر

46
00:02:57,660 --> 00:03:00,740
!أنت... ماذا تفعل هنا؟

47
00:03:06,300 --> 00:03:07,430
...أيُعقَل

48
00:03:07,430 --> 00:03:10,190
هل أحضرته معك؟

49
00:03:10,190 --> 00:03:12,290
!خاب أملي بك يا ماسارو دايمون

50
00:03:13,460 --> 00:03:14,500
ماذا تقصد؟

51
00:03:14,500 --> 00:03:15,620
!لا تدّعِ الحماقة

52
00:03:15,620 --> 00:03:20,840
!هو من قتل شعبنا. يوكيدارومون وآخرين

53
00:03:22,130 --> 00:03:23,310
!ما-ماذا؟

54
00:04:36,200 --> 00:04:37,920
!ميركوريمون-ساما، من هنا

55
00:04:40,270 --> 00:04:42,420
مضى وقت يا يوكيدارومون

56
00:04:43,240 --> 00:04:47,880
ما الّذي يفعله عضو من أوليمبوس 12
في مكان كهذا؟

57
00:04:47,880 --> 00:04:50,150
أنا هنا لاستئصال جذر الخطر

58
00:04:50,150 --> 00:04:51,440
خطر؟

59
00:04:51,440 --> 00:04:52,890
!هذا الطّفل بالطّبع

60
00:04:53,700 --> 00:04:57,770
الدّيجيمونات والبشر لا ينتميان لبعضهما الآخر

61
00:04:58,320 --> 00:05:00,250
!والآن أعطيني الطّفل

62
00:05:00,250 --> 00:05:03,440
!رُغمَ أنَّك تأمرُ بذلك ولكن أرفضُ أمرَك هذا

63
00:05:03,440 --> 00:05:04,190
ماذا؟

64
00:05:05,050 --> 00:05:08,020
!سوف أربِّي هذا الطّفل، إيكوتو

65
00:05:08,020 --> 00:05:09,920
!لن أغيّر رأيي

66
00:05:09,920 --> 00:05:10,620
!أ-أنتِ

67
00:05:10,620 --> 00:05:14,720
كيف تجرئين على التكلُّم
مع ميركوريمون-ساما هكذا

68
00:05:16,620 --> 00:05:17,770
اهدأ، اهدأ

69
00:05:20,540 --> 00:05:22,090
سمعتُ بهذا

70
00:05:22,090 --> 00:05:26,440
الأمّهات البشريّات يحمين أطفالهن
بهذه الطّريقة

71
00:05:26,440 --> 00:05:28,760
أنتِ أمُّ هذا الطّفل الآن إذاً؟

72
00:05:29,190 --> 00:05:30,430
أمّه؟

73
00:05:33,000 --> 00:05:33,720
...أمّه

74
00:05:34,530 --> 00:05:36,280
يروقني هذا

75
00:05:36,530 --> 00:05:37,140
عظيم

76
00:05:38,100 --> 00:05:40,770
!أعلن بأنّني أمُّ إيكوتو

77
00:05:45,230 --> 00:05:50,130
يوكيدارومون أحبّت إيكوتو من أعماق قلبها

78
00:05:50,130 --> 00:05:53,440
أحببته كما لو أنّه ابنها

79
00:05:59,580 --> 00:06:04,170
!لكن قطع ذلك الرّجل الرّابطَ بينهما

80
00:06:04,770 --> 00:06:08,680
لا أكترث لهذه الاتِّهامات من طرف واحد

81
00:06:08,680 --> 00:06:11,760
!في الحقيقة، أنا الضّحيّة هنا

82
00:06:11,920 --> 00:06:14,000
ماذا تقصد بذلك؟

83
00:06:14,000 --> 00:06:18,800
...أثناء بعثة العالم الرّقميّ قبل عشر سنوات

84
00:06:19,620 --> 00:06:24,400
كادت الدّيجيمونات تُبيدنا جميعاً

85
00:06:31,980 --> 00:06:33,410
!هذا مُبهر

86
00:06:36,620 --> 00:06:39,000
الدّكتور دايمون، اتّخذ هذا الأمر
بجدّية لو سمحت

87
00:06:39,920 --> 00:06:43,080
!أتينا إلى هنا للبحث عن إيكوتو-كن

88
00:06:43,080 --> 00:06:44,710
مهلاً، مهلاً يا ساتسوما

89
00:06:45,650 --> 00:06:47,820
أتفهّم شعوره

90
00:06:47,820 --> 00:06:51,790
إنّه مكان غاية في الرّوعة، أليس كذلك؟

91
00:06:51,790 --> 00:06:54,390
!بالفعل! إنّه مُبهر

92
00:06:58,230 --> 00:06:59,710
!تـ-تراجع

93
00:06:59,710 --> 00:07:00,850
!تراجع

94
00:07:01,100 --> 00:07:02,600
!أخفِض سلاحك يا كوراتا

95
00:07:02,600 --> 00:07:03,310
!أخفضه

96
00:07:16,890 --> 00:07:18,040
لماذا أطلقت عليه؟

97
00:07:18,740 --> 00:07:19,840
لماذا...؟

98
00:07:19,840 --> 00:07:21,500
!كان على وشك أن يُهاجمني

99
00:07:22,020 --> 00:07:26,120
!إنّهم لا يهاجموننا ما لم نُظهِر عداوة أوّلاً

100
00:07:30,270 --> 00:07:31,420
!انظر

101
00:07:31,420 --> 00:07:32,890
!يعتقد بأنّنا عدوّه

102
00:07:35,140 --> 00:07:36,770
!هذا سيّئ! لنهرب

103
00:07:41,590 --> 00:07:42,230
!ساتسوما-سان

104
00:07:43,180 --> 00:07:46,150
ثمّ بدأت أيّام الجحيم

105
00:07:46,690 --> 00:07:53,360
،خشية من مزيد من هجمات الدّيجيمون
التجأنا في الجبال الجليديّة اللّانهائيّة

106
00:07:57,870 --> 00:07:59,750
!لن تهربوا أيُّها البشر الأوغاد

107
00:08:00,050 --> 00:08:00,980
!من هنا

108
00:08:12,800 --> 00:08:14,140
...سنضطرّ لـ

109
00:08:16,740 --> 00:08:17,910
...هذا

110
00:08:17,910 --> 00:08:19,220
قنبلة الاهتزاز الزّمكانيّة

111
00:08:20,160 --> 00:08:24,440
!يمكننا استخدامها لفتح بوّابة رقميّة قسريّاً

112
00:08:24,890 --> 00:08:27,190
!لا! لا تزال نموذجاً أوّلياً

113
00:08:27,190 --> 00:08:28,300
!هذا خطير جدّاً

114
00:08:30,600 --> 00:08:33,780
!إنّها الطّريقة الوحيدة للنّجاة

115
00:08:41,670 --> 00:08:44,760
كان ذلك وشيكاً حقّاً

116
00:08:44,760 --> 00:08:49,590
لو تأخّرت القنبلة الاهتزازيّة الزّمكانيّة
،بالانفجار لحظة واحدة فقط

117
00:08:49,590 --> 00:08:54,930
لكنّا قد مُزِّقنا إرباً بواسطة ذلك
الدِّيجيمون الهمجيّ

118
00:08:56,380 --> 00:08:58,100
!هذا صحيح أيّها الجبان الوغد

119
00:08:58,100 --> 00:08:59,980
!لقد هربت

120
00:09:00,750 --> 00:09:02,930
لكن ذلك الرّجل لم يفعل

121
00:09:03,770 --> 00:09:07,150
!استمرّ في مواجهتي وجهاً لوجه

122
00:09:07,410 --> 00:09:10,610
!ذلك الرّجل... تقصد أبي؟

123
00:09:24,660 --> 00:09:25,440
!دكتور

124
00:09:25,440 --> 00:09:27,460
سأتصدّى له

125
00:09:27,460 --> 00:09:28,920
!اهربوا الآن ما دامت الفُرصة سانحة

126
00:09:29,790 --> 00:09:30,780
...مستحيل

127
00:09:30,780 --> 00:09:32,880
!كيف لبشريّ أن يمتلك قوّةً كهذه؟

128
00:09:33,790 --> 00:09:38,340
عندما يرغبُ رجلٌ بحمايةِ شيء، فإنَّه يستطيعُ
إيجاد قوّة باطنيّة خفيّة في داخله

129
00:09:39,980 --> 00:09:42,220
...مثلما لديك سبب للقتال

130
00:09:42,220 --> 00:09:45,540
!لديّ شعبي لأحميهم

131
00:09:50,530 --> 00:09:51,670
!هذا مُثير

132
00:09:58,130 --> 00:09:59,490
!أجل، سأقاتلك

133
00:09:59,490 --> 00:10:01,450
!خصم جدير حقّاً

134
00:10:04,730 --> 00:10:06,470
!هـ-هذا رائع

135
00:10:06,470 --> 00:10:07,610
!أسمعتم ذلك؟

136
00:10:07,610 --> 00:10:11,580
!أبي تكلّم مع ميركوريمون من خلال قبضاته

137
00:10:11,580 --> 00:10:14,250
أجل! هذا ما نتوقّعه من والد الزّعيم

138
00:10:14,250 --> 00:10:16,200
إنَّه مُذهِل بكلّ معنى الكلِمة

139
00:10:16,200 --> 00:10:16,590
أجل

140
00:10:17,220 --> 00:10:19,180
كان سوغورو رجلاً قويّاً

141
00:10:19,180 --> 00:10:22,960
لم يرتجف قلبُه أبداً حتّى في مواجهتي

142
00:10:27,080 --> 00:10:30,480
لماذا دخلتُم الأراضي المُقدَّسة للعالمِ الرقميّ؟

143
00:10:30,970 --> 00:10:33,440
!لأنّنا رأينا رياحاً مجهولة تهبُّ من هنا

144
00:10:33,920 --> 00:10:34,940
أتقول رياحاً؟

145
00:10:37,960 --> 00:10:39,750
أريد استكشاف المجهول

146
00:10:39,750 --> 00:10:41,490
!أريد رؤية أشياء مذهلة

147
00:10:41,490 --> 00:10:44,510
!هذه غريزة رجل. دافعه الطّبيعيّ

148
00:10:44,510 --> 00:10:50,920
هل تعني بأنَّ إرضاءَ تِلك الغريزة تمنحكم
الحقّ في دخول عالمنا وتدميره؟

149
00:10:51,450 --> 00:10:52,880
!لم تكن تلك نيّتنا

150
00:10:54,590 --> 00:10:56,340
شرح سوغورو كلَّ شيء

151
00:10:57,320 --> 00:11:03,850
أخبرني كيف أنَّ البوّابات الرّقميّة العشوائيّة
كانت تُسبِّب اختفاء البشر

152
00:11:04,310 --> 00:11:09,300
وبأنّهم كانوا يبحثون عن طفل أحد
أصدقائهم الّذي امتصّتْه بوّابة

153
00:11:09,300 --> 00:11:10,730
تقصد إيكوتو؟

154
00:11:11,130 --> 00:11:12,150
أجل

155
00:11:12,150 --> 00:11:15,510
صدّقتُ كلمات سوغورو، وأخبرتُه بكلّ شيء

156
00:11:16,710 --> 00:11:19,110
ماذا؟ رأيت إيكوتو؟

157
00:11:19,110 --> 00:11:20,170
أجل

158
00:11:20,170 --> 00:11:22,410
أحد جماعتي يعتني به

159
00:11:22,970 --> 00:11:25,230
ممتاز! إنّه بأمان إذاً؟

160
00:11:25,230 --> 00:11:27,410
!ستكون نوغوتشي سعيدة

161
00:11:27,770 --> 00:11:28,930
نوغوتشي؟

162
00:11:28,930 --> 00:11:30,460
والد إيكوتو

163
00:11:30,460 --> 00:11:31,330
والده؟

164
00:11:31,640 --> 00:11:33,300
لديّ ابن أيضاً

165
00:11:33,300 --> 00:11:36,450
اسمه ماسارو. إنّه طفل شقيّ حقّاً

166
00:11:36,450 --> 00:11:39,340
الأطفال رائعون حقّاً. يفعلون ما يحلو لهم

167
00:11:40,250 --> 00:11:45,300
تعتقد بأنّك تعلّمهم، لكن معظم
الوقت هم من يُعلّمونك

168
00:11:47,310 --> 00:11:50,050
سوغورو. اذهب لرؤية يغدراشيل

169
00:11:50,050 --> 00:11:51,270
يغدراشيل؟

170
00:11:51,910 --> 00:11:55,360
إنّه إله العالم الرّقميّ فعليّاً

171
00:11:56,350 --> 00:12:01,820
التّناغم بين الدّيجيمون والبشر
يتطلّب مُوافقة يغدراشيل

172
00:12:02,140 --> 00:12:03,900
هكذا إذاً

173
00:12:03,900 --> 00:12:06,030
أين يمكنني إيجاد يغدراشيل؟

174
00:12:06,750 --> 00:12:09,490
إنّه في كلّ مكان وأيّ مكان في آن واحد

175
00:12:10,280 --> 00:12:11,460
هل هذه مزحة؟

176
00:12:12,340 --> 00:12:14,540
لا، إنّها الحقيقة

177
00:12:14,540 --> 00:12:16,170
يغدراشيل هو إله

178
00:12:16,940 --> 00:12:21,130
يمكنك الشّعور به، لكن لا تستطيع رؤيته

179
00:12:21,940 --> 00:12:22,840
هكذا إذاً

180
00:12:23,360 --> 00:12:26,300
،ليتني أستطيع مساعدتك

181
00:12:26,640 --> 00:12:30,690
لا يمكن ترك هذه هنا

182
00:12:30,690 --> 00:12:35,060
لا أريد أن يسقط أحد من جماعتنا
أن يهوي في العالم البشريّ

183
00:12:35,060 --> 00:12:36,030
أنا آسف

184
00:12:36,030 --> 00:12:38,110
لا تقلق. هذه ليست غلطتك

185
00:12:38,810 --> 00:12:43,070
لنبنِ عالماً يستطيع فيه الدِّيجيمونات
والبشر العيش معاً

186
00:12:45,300 --> 00:12:46,730
!أجل، سنفعل

187
00:12:50,220 --> 00:12:53,250
غادر سوغورو بحثاً عن يغدراشيل

188
00:12:53,250 --> 00:12:56,120
لكن لم نسمع عنه شيئاً منذ ذلك الحين

189
00:12:56,120 --> 00:13:00,800
قد يكون ميّتاً في حفرة في مكان
!ما من هذا العالم

190
00:13:01,230 --> 00:13:04,130
!غبيّ! أبي لم يمت

191
00:13:05,170 --> 00:13:08,180
لا بدَّ أن يكون حيّاً في مكان ما
!في هذا العالم

192
00:13:09,810 --> 00:13:11,640
!الدّكتور دايمون حيٌّ فعلاً

193
00:13:13,590 --> 00:13:18,360
مُخطَّط الجهاز الرّقميّ الّذي أرسله
لنا من العالم الرّقميّ يُثبِت ذلك

194
00:13:18,900 --> 00:13:22,070
في ذلك الوقت، أرسل أيضاً كاميمون
—وأرسلني حاملين رسالة

195
00:13:22,950 --> 00:13:24,440
تعاونوا مع البشر

196
00:13:24,440 --> 00:13:29,030
لبناء منظّمة تعتني بالدّيجيمون الّذين
ينتهي المطاف بهم في العالم البشريّ

197
00:13:29,860 --> 00:13:32,020
...والمُنظّمة الّتي أُسِّسَتْ كانت

198
00:13:32,020 --> 00:13:35,040
فرقة التّكتيكات الخاصّة بالدّيجيمون

199
00:13:35,400 --> 00:13:36,410
!ف.ب.ت

200
00:13:38,040 --> 00:13:41,460
تقصد أنّ أبي هو من اخترع الأجهزة الرّقميّة؟

201
00:13:41,880 --> 00:13:43,420
!هذا يفسِّر الأمر

202
00:13:43,420 --> 00:13:49,390
لهذا السّبب لا توجد بيانات حول كودامون
!أو كاميمون في قاعدة بيانات المقرّ

203
00:13:51,010 --> 00:13:56,750
أُرسِلوا إلى هنا بواسطة الدّكتور دايمون
...لمنع معارك عقيمة بيننا

204
00:13:57,270 --> 00:13:59,780
!كسُفراء للعالم الرّقميّ

205
00:14:05,250 --> 00:14:09,610
،متى انحرف ديجيمون نحو العالم الرّقميّ

206
00:14:09,610 --> 00:14:14,340
يعود إلى عالمنا على هيئة بيوض رقميّة

207
00:14:15,740 --> 00:14:20,250
بينما بقيتُ هنا أحرس البوّابة الرّقميّة

208
00:14:20,640 --> 00:14:23,160
...لكن السّلام بيننا قد حُطِّم

209
00:14:23,160 --> 00:14:27,850
!عندما غزانا هذا الرّجل وقوّاته

210
00:14:57,910 --> 00:14:59,750
!حان وقت العرض

211
00:15:22,060 --> 00:15:23,560
!البشر يهاجموننا؟

212
00:15:24,450 --> 00:15:25,520
!ميركوريمون-ساما

213
00:15:33,260 --> 00:15:35,860
!سوغورو، أيّها الوغد! خنتنا

214
00:15:37,130 --> 00:15:38,160
ما هذا؟

215
00:15:38,450 --> 00:15:40,870
أليس منزلك هناك؟

216
00:15:41,620 --> 00:15:42,820
...يوكيدارومون

217
00:15:54,760 --> 00:15:56,830
!لن ندعَكم تفعلون ما يحلو لكم

218
00:15:57,930 --> 00:16:00,890
...إ-إذا حاولتم أذيّة العالم الرّقميّ

219
00:16:00,890 --> 00:16:02,060
!ستدفعون الثّمن

220
00:16:02,780 --> 00:16:04,760
!أيّها الصّاغرون التّافهون

221
00:16:04,760 --> 00:16:08,570
أتعتقدون أنّكم أيّتها الدّيجيمونات المُثيرة
للشّفقة تملكون فُرصة ضدّنا نحن البشر؟

222
00:16:08,920 --> 00:16:12,620
!اسمحوا لي أن أريكم... قطعتي الفنّية

223
00:16:12,620 --> 00:16:15,380
!غيزمون، ريالايز

224
00:16:22,740 --> 00:16:25,130
ماذا؟ هل هذه الأشياء ديجيمونات؟

225
00:16:29,490 --> 00:16:31,840
مستحيل! إنّها لا تترك حتّى البيوض الرّقميّة؟

226
00:16:38,020 --> 00:16:39,600
!ماذا تفعلين؟

227
00:16:40,630 --> 00:16:42,020
!ما زال إيكوتو هناك

228
00:16:42,600 --> 00:16:44,730
!هناك أمور أهمّ للقلق بشأنها الآن

229
00:16:55,470 --> 00:17:00,330
!يوكيدارومون

230
00:17:00,540 --> 00:17:03,580
!إيكوتو، ابتعد! اهرب

231
00:17:09,700 --> 00:17:11,790
!يوكيدارومون

232
00:17:13,340 --> 00:17:14,600
!تقرير

233
00:17:14,600 --> 00:17:16,910
واجهنا مُقاومة ديجيمون في المنطِقة الغربيّة

234
00:17:16,910 --> 00:17:18,600
!الفصيل الثّالث يعاني

235
00:17:19,660 --> 00:17:22,510
أرسلوا الفصيل الثّاني إلى المنطِقة الغربيّة

236
00:17:22,510 --> 00:17:22,810
!حاضر

237
00:17:23,220 --> 00:17:30,100
،إذا تركنا هذه الوحوش الشَّرِسة وحدها
فستأتي لمُهاجمة العالم البشريّ يوماً ما

238
00:17:30,100 --> 00:17:31,730
!يجب أن ندمّرهم واحداً تلو الآخر

239
00:17:31,730 --> 00:17:35,070
نرصد إشارة ديجيمون ضخم قادم إلى هنا

240
00:17:35,160 --> 00:17:37,280
!قبضة الألف

241
00:17:40,720 --> 00:17:41,970
!مـ-مستحيل

242
00:17:41,970 --> 00:17:44,600
!قطعتي الفنّية. دُمِّرَتْ بلمح البصر؟

243
00:17:44,600 --> 00:17:47,120
!أيُّها البشريّ الوغد! لماذا خرقت اتّفاقنا؟

244
00:17:49,460 --> 00:17:50,710
!ستدفع الثّمن

245
00:18:05,170 --> 00:18:05,980
...إيكوتو

246
00:18:06,390 --> 00:18:08,400
إيكوتو... لا أستطيع المتابعة أكثر

247
00:18:08,400 --> 00:18:09,690
حان وقت الوداع

248
00:18:10,100 --> 00:18:12,400
!أريدكما أن تخرجا من هنا

249
00:18:12,720 --> 00:18:14,570
!لن أفعل

250
00:18:14,570 --> 00:18:17,220
!ستأتين معنا

251
00:18:24,070 --> 00:18:26,180
...اسمعني يا إيكوتو

252
00:18:26,180 --> 00:18:31,340
قد تكون الحياة الّتي تنتظرك مُحزِنة ومُؤلمة

253
00:18:31,340 --> 00:18:35,710
لكن يا إيكوتو... يجب ألّا تكره البشر أبداً

254
00:18:36,320 --> 00:18:39,100
...لأنّك

255
00:18:40,060 --> 00:18:42,100
...أمّي

256
00:18:42,100 --> 00:18:43,540
!أمّي

257
00:18:47,230 --> 00:18:50,230
!أمّي

258
00:19:01,480 --> 00:19:03,200
!هذه غلطة إيكوتو

259
00:19:03,200 --> 00:19:04,930
عمّاذا تتكلّم يا غوتسومون؟

260
00:19:04,930 --> 00:19:06,830
!كيف لهذه أن تكون غلطة إيكوتو؟

261
00:19:08,770 --> 00:19:11,960
!بدأت المشاكل عندما جاء إيكوتو

262
00:19:12,290 --> 00:19:14,610
!عرفتُ أنّك أصل الكوارث

263
00:19:14,610 --> 00:19:17,250
!غادر غابتنا حالاً

264
00:19:17,250 --> 00:19:20,060
!لا! لم يرتكب إيكوتو أي خطأ

265
00:19:20,060 --> 00:19:22,270
!أليس كذلك جميعاً؟

266
00:19:25,260 --> 00:19:26,510
...لا

267
00:19:29,170 --> 00:19:30,000
...إيكوتو

268
00:19:31,130 --> 00:19:36,240
مُغادرة إيكوتو لن تُعيد يوكيدارومون إلى الحياة

269
00:19:36,240 --> 00:19:38,070
...لكن يا ميركوريمون-ساما

270
00:19:38,590 --> 00:19:42,490
تمنّتْ يوكيدارومون أن تشارك قدر هذه الغابة

271
00:19:44,960 --> 00:19:50,160
إيكوتو، ابقَ في هذه الغابة
!كمُحارب للعالم الرّقميّ

272
00:20:02,100 --> 00:20:03,810
!أنا ديجيمون

273
00:20:03,810 --> 00:20:07,010
!أنا مُحارب العالم الرّقميّ، إيكوتو

274
00:20:11,340 --> 00:20:13,760
!قتلَ يوكيدارومون؟

275
00:20:13,760 --> 00:20:15,080
!أجل يا إيكوتو

276
00:20:15,080 --> 00:20:17,820
!هذا هو الرّجل الّذي قتل أمّك

277
00:20:18,140 --> 00:20:21,120
أمّه"؟ ما هذا الهُراء؟"

278
00:20:21,120 --> 00:20:23,660
!كلّ الدِّيجيمونات هي عدوّة البشريّة

279
00:20:24,460 --> 00:20:27,530
أنا أؤدّي واجبي فحسب

280
00:20:27,530 --> 00:20:31,620
لحماية البشريّة من خطر الدّيجيمونات الشرّيرة

281
00:20:32,090 --> 00:20:34,460
لا عجب في أنّ قصّتك ناقصة

282
00:20:34,640 --> 00:20:38,030
...كراهية إيكوتو وكراهية ميركوريمون

283
00:20:38,030 --> 00:20:40,880
!أنت السّبب وراء كلّ ذلك

284
00:20:41,530 --> 00:20:43,800
وماذا لو كنتُ كذلك؟

285
00:20:43,800 --> 00:20:48,270
هل ستُهاجمونني وأنتم أعضاء في ف.ب.ت؟

286
00:20:48,270 --> 00:20:49,970
سيبدو هذا غريباً، صحيح؟

287
00:20:50,300 --> 00:20:52,020
!أنت وغد حقير

288
00:20:52,020 --> 00:20:55,020
!لا تستحقّ أن تُدعى ببشريّ حتّى

289
00:20:55,500 --> 00:20:58,140
،لا يمكنك قتل ديجيمون واحد حتّى

290
00:20:58,140 --> 00:21:00,550
لكنّك ماهر بالكلام، أليس كذلك؟

291
00:21:00,550 --> 00:21:01,720
يا لها من مصيبة

292
00:21:01,720 --> 00:21:05,890
تمنّيتُ لك ولميركوريمون أن تقتلا
...بعضكما الآخر، لكن

293
00:21:05,890 --> 00:21:07,440
خيّبتَ أملي

294
00:21:10,110 --> 00:21:11,040
!ميركوريمون

295
00:21:17,820 --> 00:21:21,610
!سيّداتي سادتي، شكراً على الانتظار

296
00:21:21,610 --> 00:21:26,500
!اشهدوا قطعتي الفنّية، غيزمون: أ.ت

297
00:21:35,010 --> 00:21:36,170
!كوراتا

298
00:21:36,170 --> 00:21:39,520
!زعيم، لم أشعر باستفزاز كهذا من قبل

299
00:21:42,260 --> 00:21:46,260
!ستدفع ثمن هذا مهما كلّف الأمر

300
00:22:48,930 --> 00:22:51,070
!غيزمون الوغد هذا... إنّه قويٌّ جدّاً

301
00:22:51,070 --> 00:22:53,580
لقد أذى ميركوريمون

302
00:22:53,580 --> 00:22:55,370
!ستدفع الثّمن. سأدمِّرك

303
00:22:55,370 --> 00:22:57,590
—إيكوتو! لست في وضع

304
00:22:57,590 --> 00:22:59,120
فهمتُ الآن

305
00:22:59,120 --> 00:23:02,950
.لا ينبغي أن أكره كلَّ البشر
!فقط السيّئين مثل كوراتا

306
00:23:02,950 --> 00:23:04,400
!هيّا بنا يا فالكومون

307
00:23:04,400 --> 00:23:06,110
!تطوُّر بمستوى ممتاز

308
00:23:06,350 --> 00:23:07,830
:مُنقِذو الدِّيجيمون

309
00:23:07,830 --> 00:23:11,040
!حطِّم طموحات كوراتا"
"!حلِّق يا ياتاغارامون

310
00:23:11,040 --> 00:23:13,940
!استيقظي في قبضتي أيّتها الرُّوح الرّقميّة