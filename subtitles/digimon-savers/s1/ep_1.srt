1
00:00:33,120 --> 00:00:34,470
.تمّ إغلاق منطقة الميناء

2
00:00:34,470 --> 00:00:36,590
تمّ الإبلاغ عن الوضع إلى جميع
.الوزارات المعنيّة

3
00:00:36,590 --> 00:00:39,110
تمّ إغلاق كلّ المناطق البحريّة
.والجوّيّة المجاورة أيضًا

4
00:00:39,300 --> 00:00:41,560
.إنّه منشقّ من الأساس

5
00:00:41,560 --> 00:00:43,270
.لا خيار أمامنا سوى التّخلّص منه

6
00:00:43,270 --> 00:00:44,980
صحيح يا ساتسوما؟

7
00:00:45,640 --> 00:00:47,310
أين رابتر-1 الآن؟

8
00:00:47,310 --> 00:00:49,620
إنّه متّجهة حاليًّا إلى بي-01
.في منطقة الميناء

9
00:00:50,350 --> 00:00:52,280
.أرسلوا يوشينو

10
00:00:52,280 --> 00:00:54,990
إنّ الوحيدين الّذين بإمكانهم
...السّيطرة على الدّيجيمون

11
00:00:55,150 --> 00:00:56,950
!هم الدّيجيمون

12
00:00:57,520 --> 00:01:00,880
تمّ اكتشاف قنبلة غير متفجّرة
.في منطقة الميناء هذه

13
00:01:01,610 --> 00:01:06,960
ونظرًا لأنّ محاولات إزالتها مستمرّة، يُرجى من
.جميع المواطنين العثور على مأوى في الحال

14
00:01:06,960 --> 00:01:07,960
.أكرّر

15
00:01:08,170 --> 00:01:11,100
يُرجى من جميع المواطنين العثور
.على مأوى في الحال

16
00:01:08,780 --> 00:01:10,000
!تمهّلي في الحال

17
00:01:10,000 --> 00:01:11,460
.أنا فوجييدا من داتس

18
00:01:11,790 --> 00:01:13,310
كيف يسير أمر الإخلاء؟

19
00:01:13,660 --> 00:01:17,010
.تمّ إخلاء كلّ شيء جنوب هذه المنطقة

20
00:01:17,010 --> 00:01:17,690
!يوشينو

21
00:01:19,050 --> 00:01:19,640
ماذا؟

22
00:01:20,550 --> 00:01:23,020
.أشعر بإشارة حياة على بعد 500 متر

23
00:01:23,020 --> 00:01:24,230
أهو رابتر-1؟

24
00:01:24,230 --> 00:01:25,530
.لا. إنّهم بشر

25
00:01:26,930 --> 00:01:28,100
.هنالك 15 منهم

26
00:01:29,610 --> 00:01:31,860
!هذا هو الأسوأ

27
00:01:34,850 --> 00:01:35,790
!كم هذا فظيع

28
00:01:36,940 --> 00:01:37,990
.هذه يوشينو

29
00:01:37,990 --> 00:01:40,530
لدينا ضحايا. إنّهم بحاجة
...لعناية طبّيّة في الحال

30
00:01:40,530 --> 00:01:41,210
!يوشينو

31
00:01:48,320 --> 00:01:49,380
!إنّه رابتر-1

32
00:01:51,410 --> 00:01:54,460
من تظنّ نفسك بتدخّلك في قتالي هكذا؟

33
00:01:57,370 --> 00:02:01,300
لا أدري من تكون، لكن لا يُسمح
!لأيّ أحد بغزو منطقتي

34
00:02:01,920 --> 00:02:06,060
،أنا مقاتل الشّوارع الأوّل في اليابان
!واسمي دايمون ماسارو-ساما

35
00:02:06,840 --> 00:02:08,980
أيفتعل شجارًا مع... ديجيمون؟

36
00:02:09,220 --> 00:02:10,400
!اخرس

37
00:02:10,400 --> 00:02:11,900
!مجرّد كلام بلا أفعال

38
00:02:11,900 --> 00:02:14,690
!إنّك مغرور جدًّا أيّها البشريّ الغبيّ

39
00:02:15,020 --> 00:02:16,900
!حتّى هو يردّ عليه

40
00:02:16,900 --> 00:02:19,160
بل الأمر أشبه بأنّه يوافق
...على عرض القتال

41
00:02:19,440 --> 00:02:22,160
!أغلق ذلك الفم الكبير البشع

42
00:02:22,400 --> 00:02:24,620
!لا خيار لديّ فقد وُلدتُ هكذا

43
00:02:24,940 --> 00:02:25,460
!يوشينو

44
00:02:25,650 --> 00:02:26,080
!نعم

45
00:02:26,650 --> 00:02:29,580
!أبعدي ذلك المواطن عن رابتر-1 في الحال

46
00:02:29,990 --> 00:02:31,380
.إنّه خطير جدًّا

47
00:02:33,950 --> 00:02:35,750
!اسمع! عليك الابتعاد عنه

48
00:02:36,500 --> 00:02:39,720
!خسارتك محتومة إن قاتلته

49
00:02:41,170 --> 00:02:43,310
!لا يتعلّق الأمر بالفوز أو الخسارة

50
00:02:43,630 --> 00:02:46,220
!هذا قتالُ رجل ضدّ رجل

51
00:02:46,670 --> 00:02:49,070
!أجل! رجل ضدّ رجل

52
00:02:50,550 --> 00:02:52,980
!مفهوم؟ لذلك لا تتدخّلي

53
00:02:52,980 --> 00:02:53,770
!حا-حاضرة

54
00:02:53,770 --> 00:02:55,770
!يوشينو، لا يمكنك التّخلّي عنه

55
00:02:55,770 --> 00:02:57,070
.مـ-معك حقّ

56
00:02:57,890 --> 00:03:00,030
.أرى أنّك شجاع جدًّا

57
00:03:00,030 --> 00:03:01,240
!هلّم إليّ

58
00:03:02,150 --> 00:03:02,990
!أكيد

59
00:03:14,740 --> 00:03:15,760
!مستحيل

60
00:03:16,250 --> 00:03:18,260
!من كان ليضرب ذلك الشّيء في العادة؟

61
00:03:18,710 --> 00:03:20,430
ما الّذي يحدث هنا؟

62
00:04:30,570 --> 00:04:33,500
"!أنا ماسارو! هجوم كوكاتريمون"

63
00:04:46,040 --> 00:04:47,300
.لم أكن مستعدًّا

64
00:04:47,510 --> 00:04:50,010
!لكنّك لن تنال منّي هذه المرّة

65
00:04:50,010 --> 00:04:52,770
!لن أقع ضحيّة للكمتك ثانية

66
00:04:53,430 --> 00:04:54,320
!انتبه

67
00:04:58,810 --> 00:05:00,730
لن تقع ضحيّة لها ثانية؟

68
00:05:01,600 --> 00:05:02,580
...أيّها الـ

69
00:05:04,060 --> 00:05:05,070
!ما رأيك بذلك؟

70
00:05:05,070 --> 00:05:07,570
!ذلك مؤلم أيّها الوغد

71
00:05:15,990 --> 00:05:18,790
إنّه يسبّب ضررًا لديجيمون
...بيديه العاريتين

72
00:05:18,790 --> 00:05:20,430
من يكون ذلك الفتى؟

73
00:05:30,250 --> 00:05:31,310
...قاتلتَ جيّدًا

74
00:05:32,050 --> 00:05:35,190
سدّدتَ بعض اللّكمات
...الجيّدة أنت أيضًا

75
00:05:45,480 --> 00:05:46,780
.أنا أغومون

76
00:05:47,980 --> 00:05:49,490
.وأنا دايمون ماسارو

77
00:05:50,940 --> 00:05:53,290
!سررت بلقائك يا أنيكي ماسارو

78
00:05:54,450 --> 00:05:55,450
أنيكي؟

79
00:05:56,070 --> 00:05:56,760
!نعم

80
00:05:57,030 --> 00:06:02,040
أنت أوّل شخص يعتبرني
.كفرد كاملٍ مكتمل يا أنيكي

81
00:06:02,040 --> 00:06:04,920
!لذلك السّبب سأصير تابعك بدءًا من الآن

82
00:06:05,870 --> 00:06:07,060
تابعي؟

83
00:06:07,250 --> 00:06:11,060
،إنّك شخص غريب المظهر بالفعل
.لكن لا أمانع ذلك أبدًا

84
00:06:11,210 --> 00:06:12,890
!انتظرا لحظة

85
00:06:15,380 --> 00:06:16,430
!لالامون

86
00:06:16,430 --> 00:06:17,180
!اخرجي

87
00:06:21,760 --> 00:06:24,560
!لالامون

88
00:06:24,560 --> 00:06:25,940
!ظهر شيء ما

89
00:06:26,350 --> 00:06:29,450
والآن، لماذا لا تأتي معنا بصمت؟

90
00:06:30,150 --> 00:06:31,500
من تكونان؟

91
00:06:31,610 --> 00:06:33,330
.إنّهما هنا للإمساك بي

92
00:06:34,400 --> 00:06:37,250
!ستتخلّصان منّي أن أمسكتا بي

93
00:06:37,360 --> 00:06:38,120
ماذا؟

94
00:06:40,280 --> 00:06:42,040
مهلاً، ما الّذي تفعله؟

95
00:06:43,830 --> 00:06:46,300
!الاعتناء بالتّابع هو من أدوار أيّ أنيكي

96
00:06:46,300 --> 00:06:48,510
!لن أسلّمه لك

97
00:06:48,510 --> 00:06:49,640
!مرحى يا أنيكي

98
00:06:50,880 --> 00:06:52,190
!انتظر لحظة

99
00:06:52,710 --> 00:06:54,150
!طلقات البذور

100
00:06:57,880 --> 00:06:59,280
!أنيكي! دعني أتولّى هذا

101
00:07:02,510 --> 00:07:03,320
...مستحيل

102
00:07:04,010 --> 00:07:05,650
!الّلهب الصّغير

103
00:07:07,270 --> 00:07:08,940
!طلقات البذور

104
00:07:12,150 --> 00:07:13,120
!يوشينو

105
00:07:18,820 --> 00:07:19,710
!كلاّ

106
00:07:22,830 --> 00:07:24,330
"مغلق اليوم"

107
00:07:27,200 --> 00:07:29,880
!تحوّل هذا الأمر برمّته إلى فوضى كبيرة

108
00:07:30,370 --> 00:07:31,880
!أنت من تسبّب بهذا

109
00:07:33,000 --> 00:07:36,350
ماذا تكون من الأساس؟ من أين أتيت؟

110
00:07:37,880 --> 00:07:38,850
.لا أدري

111
00:07:39,430 --> 00:07:42,310
.كنتُ دائمًا في المؤسّسة

112
00:07:42,640 --> 00:07:43,480
المؤسّسة؟

113
00:07:43,480 --> 00:07:45,820
...ما عدت أريد العودة إلى هناك

114
00:07:49,100 --> 00:07:51,450
...لا أفهم ما يحدث بالضّبط

115
00:07:51,450 --> 00:07:54,360
،لكن بما أنّي قمتُ بهذا سلفًا
.فسأواصل مساعدتك

116
00:07:54,360 --> 00:07:57,380
!أنيكي! شكرًا لك يا أنيكي

117
00:07:58,820 --> 00:08:01,800
...أ-أنيكي... أنا جائع

118
00:08:02,320 --> 00:08:03,910
!تحمّل لبعض الوقت

119
00:08:03,910 --> 00:08:05,180
!لا أستطيع

120
00:08:05,660 --> 00:08:07,500
!أعطني شيئًا لآكله

121
00:08:07,500 --> 00:08:09,640
،أخفض صوتك
!فقد يسمعك أحد ما

122
00:08:09,830 --> 00:08:14,090
...بدأت معدتي تتقلّص

123
00:08:24,850 --> 00:08:27,360
!أيّها الوغد، حاولتَ أكلي

124
00:08:27,360 --> 00:08:28,530
!آسف يا أنيكي

125
00:08:29,020 --> 00:08:31,570
،بدوت لي لذيذًا جدًّا
...لم أستطع المقاومة

126
00:08:33,150 --> 00:08:34,360
.لا خيال لدينا إذًا

127
00:08:34,360 --> 00:08:36,530
،سأذهب لإحضار شيء ما
.لذلك انتظر هنا

128
00:08:38,190 --> 00:08:38,990
!أنيكي

129
00:08:40,320 --> 00:08:41,290
!اسمع

130
00:08:41,290 --> 00:08:42,710
!إيّاك أن تتحرّك من هنا

131
00:08:43,200 --> 00:08:44,370
!حسنًا

132
00:08:44,370 --> 00:08:45,670
!سأنتظر هنا

133
00:08:50,790 --> 00:08:53,130
.لا بدّ أنّ بإمكانه أكل شيء كهذا

134
00:08:54,370 --> 00:08:55,630
.هذا أيضًا لو سمحت

135
00:08:57,500 --> 00:09:00,180
،هذا يناسبك
صحيح يا دايمون ماسارو-كُن؟

136
00:09:04,380 --> 00:09:05,770
!هذا لذيذ

137
00:09:05,770 --> 00:09:08,270
!أكل هلام القهوة في الخارج هو الأفضل

138
00:09:08,430 --> 00:09:09,700
.ادفعي لي ثمن ذلك

139
00:09:10,970 --> 00:09:14,570
.سأدفع إن أخبرتني بمكان رابتر-1

140
00:09:15,730 --> 00:09:17,530
!لا أعرف عمّ تتحدّثين

141
00:09:17,530 --> 00:09:22,080
!لا أعرف أيّ أحد بذلك الاسم
!ومستحيل أن أخبرك حتّى إن عرفت

142
00:09:22,400 --> 00:09:23,330
هكذا إذًا؟

143
00:09:23,330 --> 00:09:28,040
إذًا سيكون عليك المجيء معي
.كشاهد أساسيّ يا دايمون ماسارو

144
00:09:28,660 --> 00:09:30,500
كيف عرفت اسمي؟

145
00:09:32,200 --> 00:09:34,720
.صرختَ به من قبل أمام الجميع

146
00:09:34,720 --> 00:09:39,390
.دايمون ماسارو. عمرك 14 سنة
.وُلدتَ في 2 أبريل. فصيلة دمك بي

147
00:09:39,390 --> 00:09:43,140
تدرس حاليًّا في السّنة الثّانية
.من إعداديّة أوتوري البلديّة

148
00:09:43,140 --> 00:09:48,820
اختفى والدك قبل 10 سنوات
.وتعيش الآن مع أمّك وأختك الصّغيرة

149
00:09:50,560 --> 00:09:51,950
من تكونين يا هذه؟

150
00:09:53,310 --> 00:09:56,400
.فرقة تكتيكات الحوادث الرّقميّة

151
00:09:56,400 --> 00:09:57,950
.فوجييدا يوشينو من داتس

152
00:10:00,230 --> 00:10:01,410
وما هذا؟

153
00:10:01,730 --> 00:10:04,910
،نحرص في داتس على إبقاء الدّيجيمون

154
00:10:04,910 --> 00:10:08,370
الكائنات المجهولة الّتي تأتي إلى هنا
.من العالم الرّقميّ، تحت السّيطرة

155
00:10:08,780 --> 00:10:11,640
وما علاقتكم بي أنا؟

156
00:10:11,910 --> 00:10:17,260
كما سبق وقلت! رابتر-1 ذاك الّذي تحميه
!عبارة عن ديجيمون هرب من داتس

157
00:10:17,260 --> 00:10:19,380
.وأتيتُ أنا لاستعادته

158
00:10:20,340 --> 00:10:21,930
إنّه ليس مجرّد ضفدع؟

159
00:10:22,380 --> 00:10:24,890
وهل سمعت بضفدع يتكلّم؟

160
00:10:25,590 --> 00:10:28,350
،على أيّ حال
!لا تأكل الدّيجيمون هذه الأشياء

161
00:10:28,350 --> 00:10:30,350
.إنّها لا تأكل سوى طعام خاصّ بها

162
00:10:30,850 --> 00:10:32,560
ومن يبيع هذا الطّعام؟

163
00:10:32,970 --> 00:10:34,860
!إنّه لا يباع في أيّ مكان

164
00:10:34,860 --> 00:10:37,280
يمكنك الحصول عليه في داتس
فحسب. مفهوم؟

165
00:10:37,940 --> 00:10:41,740
،ما دمت تواصل التّملّص من داتس
.فإنّ رابتر-1 ذاك سيموت جوعًا

166
00:10:48,450 --> 00:10:52,710
آسف، ولكن أيمكنك أخذي
إلى مكان داتس هذه؟

167
00:10:53,700 --> 00:10:54,420
...أنت

168
00:11:02,040 --> 00:11:03,010
ما هذا المكان؟

169
00:11:05,090 --> 00:11:06,470
.فوجييدا يوشينو، عدت من المهمّة

170
00:11:08,300 --> 00:11:09,780
.أنت هو دايمون ماسارو

171
00:11:10,970 --> 00:11:12,600
.أنا القائد ساتسوما

172
00:11:13,600 --> 00:11:15,070
.مرحبًا بك في داتس

173
00:11:20,480 --> 00:11:23,490
هذا هو الفتى الّذي أبقى رابتر-1
تحت السّيطرة؟

174
00:11:23,490 --> 00:11:26,580
لا يبدو لي أنّه يمتلك بأيّ قوى
.خاصّة من أيّ مستوى

175
00:11:27,650 --> 00:11:29,090
ما ذلك الوشاح الغريب؟

176
00:11:30,110 --> 00:11:32,540
.هذا كودامون، إنّه شريكي

177
00:11:32,780 --> 00:11:36,680
لكلّ أعضاء داتس ديجيمون
.كشريك خاصّ بهم

178
00:11:36,910 --> 00:11:39,510
.وهذه شريكتي لالامون

179
00:11:40,580 --> 00:11:41,720
شريك؟

180
00:11:41,920 --> 00:11:42,430
.نعم

181
00:11:42,830 --> 00:11:48,180
نعمل نحن البشر والدّيجيمون هنا
.معًا لتولّي أمر جرائم الدّيجيمون

182
00:11:51,840 --> 00:11:53,400
هذا ديجيمون أيضًا؟

183
00:11:54,550 --> 00:11:56,160
.لا شيء من هذا مهمّ الآن

184
00:11:56,770 --> 00:12:01,490
،هناك شخص جائع وينتظر عودتي
.لذلك كفانا من هذا الهراء

185
00:12:01,490 --> 00:12:02,610
!سلّموني ما أتيتُ لأجله فحسب

186
00:12:03,020 --> 00:12:04,070
.لا تتحمّس كثيرًا

187
00:12:04,650 --> 00:12:07,030
سواء كان بالإمكان إنقاذ
!رابتر-1 أم لا، أمر يعتمد عليك

188
00:12:07,860 --> 00:12:10,950
إنّنا وسط أزمة غير مسبوقة
.في الوقت الحاليّ

189
00:12:10,950 --> 00:12:15,790
الحاجز بين عالم البشر
.والعالم الرّقميّ قد بدأ ينهار

190
00:12:15,790 --> 00:12:16,890
.إنّنا نجهل ما السّبب وراء ذلك

191
00:12:17,160 --> 00:12:22,010
ولكنّ الحقيقة هي أنّ الدّيجيمون
.تظهر بشكل متكرّر في عالمنا

192
