1
00:00:16,950 --> 00:00:20,490
"!أسوأ أيّام حياة ماسارو"
"!سولمون ذو المقالب"

2
00:00:26,440 --> 00:00:28,170
...أخبرني يا أخي ماسارو

3
00:00:28,650 --> 00:00:31,130
هل يعيش توما-كُن هنا بالفعل؟

4
00:00:31,130 --> 00:00:33,590
!يا له من قصر رائع

5
00:00:33,590 --> 00:00:34,970
.إنّه يشبه قلعة

6
00:00:34,970 --> 00:00:36,090
.لا أدري

7
00:00:36,090 --> 00:00:38,600
.هذه أوّل مرّة أزوره فيها هنا أيضًا

8
00:00:39,330 --> 00:00:41,470
.أعتقد أنّي سأعود للمنزل

9
00:00:42,120 --> 00:00:44,980
.أنت من قالت أنّك وعدته بزيارته

10
00:00:44,980 --> 00:00:48,190
!لكنّي لم أعتقد أنّك ستأتي معي

11
00:00:48,670 --> 00:00:52,780
اعتقدت أنّك ستشعرين بالإحباط إذا أتيت
...إلى هنا وحدك، لذلك فكّرتُ في مرافقتك

12
00:00:53,260 --> 00:00:55,360
!ذلك ليس مهمًّا

13
00:00:55,360 --> 00:00:57,210
!انس الأمر، سأعود للمنزل

14
00:00:59,060 --> 00:01:03,330
أنتم دايمون ماسارو-ساما وتشيكا-ساما
وأغومون-ساما، صحيح؟

15
00:01:03,330 --> 00:01:06,710
.توما-ساما بانتظاركم. تفضّلوا بالدّخول

16
00:01:08,990 --> 00:01:10,350
.أ-أكيد

17
00:01:14,820 --> 00:01:16,780
.هذا مذهل

18
00:01:23,670 --> 00:01:25,850
.لا حاجة لخلع أحذيتكم

19
00:01:26,960 --> 00:01:28,060
!آ-آسفة

20
00:01:32,430 --> 00:01:34,740
!مرحبًا بكما يا تشيكا-تشان وأخوها الأكبر

21
00:01:34,930 --> 00:01:37,110
من تنادي بالأخ الأكبر؟

22
00:01:37,110 --> 00:01:40,700
!شكرًا على دعوتنا

23
00:01:46,560 --> 00:01:48,850
...هذا المكان رائع

24
00:01:49,360 --> 00:01:51,500
كم كلّف هذا؟

25
00:01:51,500 --> 00:01:52,840
!أخي ماسارو

26
00:01:55,700 --> 00:02:01,050
استمتعتُ باستضافتكم لي ذلك اليوم، لذلك
.اقبلوا بهذه الوجبة المتواضعة كعربون شكر

27
00:02:01,050 --> 00:02:03,720
!مذهل، يا لها من مائدة

28
00:02:03,720 --> 00:02:04,970
!أخي ماسارو

29
00:02:04,970 --> 00:02:06,640
ألا يوجد أيّ بيض مقليّ؟

30
00:02:06,640 --> 00:02:08,270
.يمكنني أن أطلب منهم إعداده إن أردت

31
00:02:08,750 --> 00:02:11,370
...أغو-تشان، إنّك تحرجني أيضًا

32
00:02:20,140 --> 00:02:22,050
ما الخطب يا تشيكا-تشان؟

33
00:02:22,180 --> 00:02:22,910
...أنا

34
00:02:23,390 --> 00:02:25,790
.لا داعي للحرج. قولي ما لديك

35
00:02:25,790 --> 00:02:27,100
!حـ-حسنًا

36
00:02:28,900 --> 00:02:31,080
!اشرب الماء! الماء

37
00:02:40,240 --> 00:02:42,780
!يُستعمل ذلك الماء لغسل الأصابع

38
00:02:46,210 --> 00:02:48,240
هل أنت بخير يا تشيكا-تشان؟

39
00:02:48,500 --> 00:02:49,350
!غاومون

40
00:02:49,350 --> 00:02:50,350
.نعم يا سيّدي

41
00:02:55,130 --> 00:02:58,280
هذا لذيذ! هذه المياه هي ما
!أتوقّع شربه في منزل توما تمامًا

42
00:02:58,280 --> 00:03:00,210
!تشيكا، عليك شربها أيضًا

43
00:03:00,300 --> 00:03:01,320
!توقّف

44
00:03:04,640 --> 00:03:06,700
!يا لغبائك يا أخي ماسارو

45
00:03:06,700 --> 00:03:09,050
!ما مشكلتك؟

46
00:03:12,980 --> 00:03:17,150
...أخي ماسارو

47
00:03:18,700 --> 00:03:23,760
آمل أن تنزلق في الشّارع وتصيب رأسك
...وتصطدم بلافتة وتقع من فوق جسر

48
00:03:23,760 --> 00:03:25,680
...أو تصدمك سيّارة

49
00:03:29,100 --> 00:03:31,810
!أو تسحقك ناقلة

50
00:03:34,630 --> 00:03:35,980
!مهلاً يا تشيكا

51
00:03:35,980 --> 00:03:36,730
!تشيكا-تشان

52
00:03:40,530 --> 00:03:41,550
!تشيكا

53
00:03:41,550 --> 00:03:42,710
!أنيكي

54
00:05:00,770 --> 00:05:01,980
موزة؟

55
00:05:01,980 --> 00:05:04,990
!ما الّذي تفعله قشرة موز هنا؟

56
00:05:05,470 --> 00:05:07,300
!اسمع! اسمع

57
00:05:05,760 --> 00:05:10,200
ما كان كلّ ذلك الّذي قالته
عن انزلاقي وإصابة رأسي؟

58
00:05:07,930 --> 00:05:10,780
!أنيكي! استمع لي يا أنيكي

59
00:05:10,780 --> 00:05:13,180
انزلقت وأصبت رأسي...؟

60
00:05:11,600 --> 00:05:13,180
!يا إلهي

61
00:05:13,270 --> 00:05:15,560
!أنيكي! يوجد ديجيمون هنا

62
00:05:17,320 --> 00:05:18,080
...ماسارو

63
00:05:18,860 --> 00:05:21,100
أيعاني غاومون من خطب ما؟

64
00:05:21,200 --> 00:05:22,670
!ذلك ليس ما قصدت

65
00:05:22,670 --> 00:05:25,470
!يوجد ديجيمون أمامك مباشرة

66
00:05:25,470 --> 00:05:25,840
ماذا؟

67
00:05:25,840 --> 00:05:27,940
!لا يوجد أيّ شيء

68
00:05:28,450 --> 00:05:30,300
!خلفك! خلفك

69
00:05:30,960 --> 00:05:32,510
!يا إلهي

70
00:05:33,170 --> 00:05:35,230
!لا تتحرّك يا أنيكي

71
00:05:35,230 --> 00:05:38,370
!سأبعد ذلك الوغد عنك

72
00:05:39,980 --> 00:05:42,320
!ما الّذي تفعله؟

73
00:05:42,320 --> 00:05:43,420
!ذلك مؤلم

74
00:05:42,800 --> 00:05:44,280
ما-ماذا؟

75
00:05:43,630 --> 00:05:45,650
!خذ هذا! وهذا

76
00:05:44,280 --> 00:05:45,650
!...لكن

77
00:05:46,140 --> 00:05:49,510
غاومون، يمكنك رؤيته أيضًا، صحيح؟

78
00:05:49,510 --> 00:05:51,870
!الدّيجيمون الّذي تشبّث بأنيكي

79
00:05:53,820 --> 00:05:55,660
ديجيمون؟ ما الّذي تتحدّث عنه؟

80
00:05:55,990 --> 00:05:58,000
!لا يمكنك رؤيته؟

81
00:05:58,000 --> 00:05:58,920
.كنتُ أعلم

82
00:05:59,450 --> 00:06:03,380
على أيّ حال، أواثق أنّ عليك السّماح
لتشيكا-تشان بالذّهاب وحدها هكذا؟

83
00:06:04,120 --> 00:06:05,310
!كلاّ

84
00:06:06,620 --> 00:06:08,550
...المشكلة هي

85
00:06:08,550 --> 00:06:10,930
أنّك بليد جدًّا عندما يتعلّق الأمر
.بمشاعر الآخرين

86
00:06:10,930 --> 00:06:13,150
بليد؟ ما الّذي تقصده بذلك؟

87
00:06:13,260 --> 00:06:15,470
.هذا ما أقصده بالضّبط

88
00:06:15,470 --> 00:06:20,480
أتفهّم جيّدًا كيف شعرت تشيكا-تشان
.عندما قالت كلماتها الأخيرة تلك

89
00:06:20,480 --> 00:06:22,560
..."كلماتها الأخيرة"

90
00:06:22,560 --> 00:06:25,070
تقصد تلك الأشياء عن انزلاقي
وإصابة رأسي؟

91
00:06:25,070 --> 00:06:26,490
.نعم

92
00:06:26,490 --> 00:06:28,530
...الانزلاق في الشّارع وإصابة رأسك

93
00:06:28,530 --> 00:06:31,500
.ثمّ اصطدامك بلافتة أيضًا

94
00:06:31,940 --> 00:06:34,490
لافتة؟

95
00:06:37,280 --> 00:06:38,670
!أنيكي، أنيكي

96
00:06:39,780 --> 00:06:42,540
!أشعر بوجود ديجيمون قريب منّا ثانية

97
00:06:42,540 --> 00:06:44,050
ثانية؟

98
00:06:45,830 --> 00:06:47,430
!هذا مؤلم

99
00:06:48,290 --> 00:06:50,970
!ما الّذي تفعله لافتة هنا؟

100
00:06:51,290 --> 00:06:53,970
!سبق وأخبرتك أنّ ديجيمون وراء هذا

101
00:06:53,970 --> 00:06:55,930
.هذا غريب

102
00:06:56,260 --> 00:06:57,220
!وكأنّي سأصدّقك

103
00:06:57,220 --> 00:06:59,730
!لا بدّ أنّك تعاني حطبًا ما يا أغومون

104
00:06:59,730 --> 00:07:00,780
.الأمر ليس كذلك

105
00:07:01,400 --> 00:07:03,060
،بالنّظر لتلك اللاّفتة

106
00:07:03,060 --> 00:07:07,860
يبدو وكأنّ تشيكا-تشان استعملت
.سحرًا ما لوضع لعنة عليك

107
00:07:08,640 --> 00:07:09,820
لعنة؟

108
00:07:10,150 --> 00:07:12,360
.يحدث كلّ شيء حسب ما قالته تشيكا-تشان

109
00:07:12,360 --> 00:07:14,990
...انزلقتَ في الشّارع وأصبت رأسك

110
00:07:14,990 --> 00:07:16,830
.وثّم اصطدمت بلافتة

111
00:07:17,820 --> 00:07:19,290
!ذلك ليس ممكنًا

112
00:07:19,290 --> 00:07:22,370
الخطوة التّالية هي السّقوط
من على جسر، صحيح يا سيّدي؟

113
00:07:22,370 --> 00:07:23,380
.غاومون

114
00:07:24,200 --> 00:07:26,670
!لن يحدث ذلك أبدًا

115
00:07:26,670 --> 00:07:29,720
!لا توجد أيّ جسور هنا من الأساس

116
00:07:33,790 --> 00:07:35,010
!هذا مؤلم

117
00:07:35,010 --> 00:07:35,930
!أنا آسف

118
00:07:35,930 --> 00:07:38,110
أنا جدّ آسف، هل أنت بخير؟

119
00:07:37,090 --> 00:07:38,730
!ما هذا؟

120
00:07:38,260 --> 00:07:39,480
!أنا آسف

121
00:07:39,480 --> 00:07:42,440
...عيدان الأكل... تُنطق مثل جسر

122
00:07:43,100 --> 00:07:44,980
...هذا مؤلم

123
00:07:44,980 --> 00:07:47,490
!لن أصدّق مسألة اللّعنة هذه

124
00:07:49,560 --> 00:07:51,030
...كم هذا مؤلم

125
00:07:55,070 --> 00:07:56,660
!ما الّذي يحدث؟

126
00:07:56,660 --> 00:07:57,990
.هنالك إشارة ديجيمون

127
00:07:57,990 --> 00:07:59,210
ماذا؟ أين؟

128
00:08:00,280 --> 00:08:02,880
!صادرة من داخل مقرّ داتس

129
00:08:03,710 --> 00:08:06,380
...بتعبير آخر، هنا... ولكن

130
00:08:08,880 --> 00:08:10,260
!إنّه أنيكي

131
00:08:10,260 --> 00:08:12,550
!إشارة الدّيجيمون صادرة من أنيكي

132
00:08:12,880 --> 00:08:13,630
ماذا؟

133
00:08:13,630 --> 00:08:15,510
مهلاً، ما الّذي تقصده بذلك؟

134
00:08:15,840 --> 00:08:17,100
.دايمون ماسارو

135
00:08:17,100 --> 00:08:18,510
.أنت رهن الاعتقال

136
00:08:22,270 --> 00:08:25,190
أتقولون أنّي أحضرته عن قصد؟

137
00:08:25,190 --> 00:08:26,270
.ذلك ممكن

138
00:08:26,270 --> 00:08:27,020
.ممكن جدًّا

139
00:08:27,020 --> 00:08:28,650
.هذا من طباعك يا ماسارو

140
00:08:28,650 --> 00:08:29,620
!ماذا؟

141
00:08:30,190 --> 00:08:32,900
!استمعوا لي رجاءً يا رفاق

142
00:08:32,900 --> 00:08:35,570
!هنالك ديجيمون يتشبّث بأنيكي الآن

143
00:08:35,900 --> 00:08:37,450
يتشبّث به؟

144
00:08:37,450 --> 00:08:39,660
!صار غير مرئيّ وبدأ يطفو حوله

145
00:08:39,660 --> 00:08:44,670
ثمّ ترك أشياء مثل قشرة الموز واللاّفتة
...في طريقه، وألحق به الأذى

146
00:08:44,670 --> 00:08:47,210
!أنيكي مجرّد ضحيّة

147
00:08:47,780 --> 00:08:48,790
...إذًا

148
00:08:48,790 --> 00:08:53,050
كلّ تلك الحوادث الصّغيرة الّتي كنتُ
...واثقًا أنّها بسبب بلادته فحسب

149
00:08:53,050 --> 00:08:55,220
كانت من صنيع ديجيمون؟

150
00:08:56,040 --> 00:08:57,680
!لا تنعتني بالبليد

151
00:08:58,300 --> 00:09:00,140
.يجب أن يكون ذلك آخر همّك

152
00:09:01,130 --> 00:09:05,100
مشكلتنا هنا هي أنّنا أتحنا لديجيمون
.دخولاً غير مسموح به إلى مقرّ داتس

153
00:09:05,680 --> 00:09:09,110
...ديجيمون حفّزته كلمات تشيكا-تشان

154
00:09:09,110 --> 00:09:13,570
.يُحوّل أفكارها تلك غير المؤذية إلى واقع

155
00:09:14,600 --> 00:09:17,030
ما كانت بقيّة كلماتها؟

156
00:09:17,030 --> 00:09:18,240
!القائد

157
00:09:18,240 --> 00:09:22,200
ما هي الكلمات الّتي لم تصر واقعًا بعد؟

158
00:09:22,530 --> 00:09:28,210
قالت أنّه سينزلق في الشّارع ويضرب رأسه
...ويصطدم بلافتة ويسقط من جسر

159
00:09:28,210 --> 00:09:32,210
.ثمّ ستطارده سيّارة وتسحقه ناقلة أيّها القائد

160
00:09:32,420 --> 00:09:34,420
!كفاكم هراءً

161
00:09:34,420 --> 00:09:38,300
!ما عدت أطيق الاستماع لهذا
!تجعلون الأمر يبدو كأنّه غلطة تشيكا

162
00:09:38,300 --> 00:09:41,730
!تعلمون أنّ تشيكا ما كانت لتستعمل ديجيمون

163
00:09:42,800 --> 00:09:45,430
!أنت! أيّها الدّيجيمون المتشبّث بي

164
00:09:45,430 --> 00:09:46,940
!اخرج! إنّك تلعب بشكل قذر

165
00:09:46,940 --> 00:09:49,940
كيف تجرؤ على أن تصير غير مرئيّ
!وتهاجمني من الخلف...؟

166
00:09:50,260 --> 00:09:51,480
!مهلاً

167
00:09:55,140 --> 00:09:56,450
...تشيكا

168
00:09:58,110 --> 00:10:00,410
عليّ إيجاد تشيكا فحسب، صحيح؟

169
00:10:00,730 --> 00:10:04,580
!ثمّ سترون أنّ لا علاقة لها بذلك الدّيجيمون

170
00:10:15,460 --> 00:10:18,430
...لقد طاردته عربة للتّوّ
...وهي تُعتبر سيّارة أيضًا

171
00:10:18,430 --> 00:10:21,010
.كلّ ما بقي إذًا هو أن تسحقه ناقلة

172
00:10:21,010 --> 00:10:23,140
ماذا؟ ناقلة؟

173
00:10:23,140 --> 00:10:24,390
.ذلك مستحيل

174
00:10:24,390 --> 00:10:27,440
،سيكون ذلك ممكنًا إن كنّا في المياه
.لكنّنا على اليابسة الآن

175
00:10:29,760 --> 00:10:31,190
ماذا الآن؟

176
00:10:45,940 --> 00:10:49,120
فقدت ناقلة وزنها 20 كيلو طنّ
!تُدعى إي إل السّيطرة

177
00:10:49,120 --> 00:10:52,710
!أرسلت وكالة السّلامة البحريّة إشارة استغاثة

178
00:10:52,710 --> 00:10:54,710
!إنّها تتحرّك بسرعة 23 عقدة

179
00:10:54,710 --> 00:10:58,470
وستضرب مقرّ داتس الرّئيسيّ
!خلال 10 دقائق و35 ثانية

180
00:11:02,340 --> 00:11:04,100
...أولويّتنا المطلقة الآن

181
00:11:04,100 --> 00:11:06,220
!هي ضمان سلامة طاقم النّاقلة

182
00:11:06,220 --> 00:11:09,390
،أرسلت وكالة السّلامة البحريّة حوّامة إليهم

183
00:11:09,390 --> 00:11:11,810
لكن ليس من المؤكّد بعد إن كانت
...تستطيع الوصول خلال 10 دقائق

184
00:11:12,390 --> 00:11:16,400
سيتطلّب الأمر كلّ الحواجز الّتي نستعملها
!في قاعدتنا وإعادة ضبطها استعدادًا للاصطدام

185
00:11:16,730 --> 00:11:17,860
!مهلاً لحظة

186
00:11:18,190 --> 00:11:20,570
أنا من تلاحقه النّاقلة، صحيح؟

187
00:11:20,570 --> 00:11:22,820
!لذلك عليّ مواجهتها مباشرة

188
00:11:23,150 --> 00:11:25,160
ما الّذي تفكّر فيه؟

189
00:11:25,160 --> 00:11:26,280
...من الواضح

190
00:11:26,280 --> 00:11:28,790
!أنّ هذا قتال رجل لرجل بيني وبين النّاقلة

191
00:11:29,490 --> 00:11:30,750
!لا تتصرّف بغباء

192
00:11:31,070 --> 00:11:33,080
!عليّ الخروج من هنا فحسب

193
00:11:33,080 --> 00:11:34,460
!إن كانت تريد قتالاً، فأنا جاهز

194
00:11:34,790 --> 00:11:37,130
!هذا ليس وقتًا مناسبًا للمزاح

195
00:11:37,130 --> 00:11:39,460
!إنّ مواجهة ناقلة أمر مستحيل

196
00:11:39,460 --> 00:11:40,550
.معه حقّ

197
00:11:40,550 --> 00:11:42,350
...علينا أن نكون الآن

198
00:11:43,750 --> 00:11:47,930
.لا تعترض طريقي
.كلّ ما عليكم مفعله هو المشاهدة

199
00:11:47,930 --> 00:11:49,640
...لا تقل أنّك

200
00:11:49,640 --> 00:11:50,850
ماسارو، هل أنت...؟

201
00:11:51,180 --> 00:11:52,020
!اخرس

202
00:11:52,020 --> 00:11:53,490
!لا تتبعوني

203
00:11:54,180 --> 00:11:55,360
!أنيكي

204
00:11:56,610 --> 00:11:58,580
!انتظرني يا أنيكي

205
00:12:01,480 --> 00:12:03,790
.يا له من غبيّ

206
00:12:04,110 --> 00:12:05,410
.غبيّ بالفعل

207
00:12:05,410 --> 00:12:07,950
.يبدو أنّه يواجه مشكلة في التّعبير عن نفسه

208
00:12:11,660 --> 00:12:13,670
،لم يرد أن تعاني داتس من الأضرار

209
00:12:13,670 --> 00:12:15,930
.لذلك غادر قصدًا للابتعاد عن هنا

210
00:12:16,580 --> 00:12:18,380
.إنّه شخص واضح للغاية

211
00:12:20,330 --> 00:12:21,840
.بقيت عشر دقائق فحسب

212
00:12:21,840 --> 00:12:24,720
علينا العثور على شيء مهما كان
.لحلّ هذه المشكلة

213
00:12:24,720 --> 00:12:25,800
.بالطّبع

214
00:12:25,800 --> 00:12:26,470
.نعم

215
00:12:28,420 --> 00:12:30,940
...يا رفاق

216
00:12:31,720 --> 00:12:33,600
!حسنًا! سأفعل شيئًا ما أيضًا

217
00:12:36,350 --> 00:12:39,530
!تشيكا! تشيكا

218
00:12:41,560 --> 00:12:42,740
أغو-تشان؟

219
00:12:43,520 --> 00:12:44,650
!مـ-مهلاً

220
00:12:44,650 --> 00:12:48,330
!ما الّذي تفعله هنا؟
!ماذا إن رآك شخص ما؟

221
00:12:48,330 --> 00:12:50,740
!أنيكي في ورطة بسببك

222
00:12:51,070 --> 00:12:53,710
.لا أهتمّ لأمر أخي ماسارو

223
00:12:54,030 --> 00:12:57,710
!أنت الوحيدة الّتي يمكنك مساعدته يا تشيكا

224
00:12:57,710 --> 00:12:59,090
!لماذا أنا؟

225
00:12:59,090 --> 00:13:01,550
!لأنّ ناقلة ستسحقه

226
00:13:01,550 --> 00:13:04,010
!ناقلة؟ كم هذا سخيف

227
00:13:04,010 --> 00:13:05,050
.كما أنّي لا أهتمّ

228
00:13:05,050 --> 00:13:07,260
!بالطّبع تهتمّين

229
00:13:07,260 --> 00:13:09,390
!قد يموت أنيكي

230
00:13:09,390 --> 00:13:10,720
.وقلتُ أنّي لا أهتمّ

231
00:13:10,720 --> 00:13:11,520
!لا تقولي ذلك

232
00:13:11,520 --> 00:13:13,600
!...فلأنّك قلتِ تلك الأشياء الغريبة له

233
00:13:13,600 --> 00:13:14,940
!ليست غريبة

234
00:13:14,940 --> 00:13:17,270
!على أيّ حال، لماذا عليّ تحمّل المسؤوليّة؟

235
00:13:17,270 --> 00:13:18,060
!أنا لا أهتمّ

236
00:13:18,230 --> 00:13:19,360
!الدّيجيمون

237
00:13:19,360 --> 00:13:21,150
!إنّها غلطة الدّيجيمون

238
00:13:21,150 --> 00:13:24,780
!إذًا بإمكان أخي ماسارو تولّي أمره

239
00:13:24,780 --> 00:13:25,650
!إنّه يقوم بذلك

240
00:13:25,650 --> 00:13:28,450
!لكن لا فائدة ما لم تساعديه

241
00:13:28,450 --> 00:13:29,450
.إنّه غبيّ

242
00:13:29,780 --> 00:13:31,700
!لا، أنيكي ليس غبيًّا

243
00:13:31,700 --> 00:13:32,740
وماذا إذًا؟

244
00:13:32,740 --> 00:13:34,870
...أنيكي هو أنيكي فحسب

245
00:13:34,870 --> 00:13:35,840
.أنت غبيّ

246
00:13:35,950 --> 00:13:37,460
!لا، أنت الغبيّة

247
00:13:39,420 --> 00:13:41,130
!انظري هناك

248
00:13:41,130 --> 00:13:44,550
حوّل أنيكي نفسه إلى طُعم
!لإبعاد النّاقلة كي لا تؤذي الآخرين

249
00:13:44,550 --> 00:13:47,590
!ستسحقه تلك النّاقلة بالفعل

250
00:13:53,720 --> 00:13:55,480
!أخي ماسارو

251
00:13:58,470 --> 00:14:01,940
حسب المعلومات الّتي جمعناها
...وإشارة الدّيجيمون من ساحة الجريمة

252
00:14:01,940 --> 00:14:04,110
.استطعنا تحديد نوع الدّيجيمون

253
00:14:04,110 --> 00:14:08,570
سولمون
مستوى بالغ

254
00:14:05,020 --> 00:14:08,570
.سولمون. ديجيمون من نوع الشّبح ومستوى بالغ

255
00:14:09,190 --> 00:14:16,160
،بسبب صغر حجمه وجعل نفسه غير مرئيّ
.كنّا غير قادرين على تتبّعه برادار الدّيجيمون

256
00:14:17,490 --> 00:14:19,170
.هذا يثير القلق

257
00:14:19,410 --> 00:14:23,420
،إن أمكننا على الأقلّ رؤية شكله
...يمكننا الإطاحة به بضربة واحدة

258
00:14:23,420 --> 00:14:24,300
.يوشينو

259
00:14:24,300 --> 00:14:27,390
إنّك تبدين مثل ماسارو أكثر
.فأكثر هذه الأيّام

260
00:14:27,670 --> 00:14:29,350
من أيّ ناحية؟

261
00:14:31,130 --> 00:14:32,720
ما الخطب يا توما؟

262
00:14:32,720 --> 00:14:35,470
.سولمون. عدوّ غير مرئيّ

263
00:14:35,470 --> 00:14:37,350
هل لديك أيّ خطط ضدّه؟

264
00:14:37,350 --> 00:14:38,270
...إن كان من الممكن

265
00:14:43,060 --> 00:14:45,570
!لم أكن جادّة عندما قلتُ ذلك

266
00:14:45,570 --> 00:14:49,360
،كان أخي ماسارو يحرجني
...وأغضبني ذلك

267
00:14:49,360 --> 00:14:51,450
!قلتُ ذلك لأنّي كنت غاضبة فحسب

268
00:14:51,450 --> 00:14:54,160
!أنيكي ليس محرِجًا

269
00:14:54,160 --> 00:14:55,910
!إنّه رائع وقويّ

270
00:14:56,440 --> 00:14:57,870
!أعلم ذلك

271
00:14:59,820 --> 00:15:04,670
!أخي ماسارو

272
00:15:01,740 --> 00:15:02,540
!تشيكا

273
00:15:04,670 --> 00:15:06,760
!لا! اهرب

274
00:15:06,760 --> 00:15:08,680
!ابتعد من هناك

275
00:15:10,210 --> 00:15:11,180
.تشيكا-تشان

276
00:15:12,420 --> 00:15:13,890
.لا يمكنه ذلك

277
00:15:14,420 --> 00:15:16,600
.فهذا هو أخوك

278
00:15:16,600 --> 00:15:18,600
.واثق أنّك تعرفينه أكثر من غيرك

279
00:15:19,550 --> 00:15:22,060
...لكن... إن لم يبتعد

280
00:15:22,390 --> 00:15:26,020
.لا بأس. لن تسحقه النّاقلة

281
00:15:26,020 --> 00:15:27,730
.ذلك لا يحدث أبدًا

282
00:15:27,730 --> 00:15:28,780
.ولن أسمح بحدوثه

283
00:15:38,110 --> 00:15:39,620
!أرني ما لديك

284
00:15:39,950 --> 00:15:41,210
.أنت غبيّ

285
00:15:42,030 --> 00:15:44,330
!توما! تشيكا! ما الّذي تفعلانه هنا؟

286
00:15:44,330 --> 00:15:48,210
لهذا السّبب يثير الأشخاص الّذين
.لا يفكّرون بشكل منطقيّ أعصابي

287
00:15:48,210 --> 00:15:49,590
!ماذا قلت؟

288
00:15:49,590 --> 00:15:50,840
.استمعي جيّدًا يا تشيكا-تشان

289
00:15:51,170 --> 00:15:54,760
.لا يستعمل سولمون السّحر

290
00:15:54,760 --> 00:15:59,020
لا يمكنك نقل أو محو شيء
.فقط بإلقاء تعويذة

291
00:16:00,880 --> 00:16:04,810
يملك ذلك الدّيجيمون
.قدرة الاختفاء الخاصّة فحسب

292
00:16:04,810 --> 00:16:05,940
.فهمت

293
00:16:05,940 --> 00:16:09,570
،بما أنّنا لا نستطيع رؤيته
.يستغلّ ذلك لصالحه للقيام بالمقالب

294
00:16:09,570 --> 00:16:10,740
.صحيح

295
00:16:10,740 --> 00:16:14,530
إذًا فقشرة الموز واللاّفتة وما شابه
...كانت من صنيع الدّيجيمون أيضًا

296
00:16:14,530 --> 00:16:16,280
!هذا يعني أنّ النّاقلة كذلك

297
00:16:22,610 --> 00:16:24,250
!ماسارو! توما

298
00:16:24,250 --> 00:16:24,790
!يوشينو

299
00:16:25,450 --> 00:16:28,840
،اتّصل بنا قبطان السّفينة
.وقال أنّ الدّفّة لا تعمل

300
00:16:28,840 --> 00:16:30,760
.هناك ما يعترض طريقه

301
00:16:31,080 --> 00:16:32,970
.كما توقّعت

302
00:16:32,970 --> 00:16:35,760
دخل الدّيجيمون إلى النّاقلة
.وسيطر على الدّفّة

303
00:16:35,760 --> 00:16:36,180
...علينا أن

304
00:16:36,180 --> 00:16:37,720
مهلاً، إلى أين تظنّ نفسك ذاهبًا؟

305
00:16:38,250 --> 00:16:40,390
.لتأمين الدّيجيمون بالطّبع

306
00:16:40,390 --> 00:16:43,940
!سبق وأخبرتك! هذا قتالي أنا
.لا تتدخّل

307
00:16:43,940 --> 00:16:45,230
!أنا قادم أيضًا

308
00:16:45,230 --> 00:16:46,570
!أخي ماسارو

309
00:16:51,730 --> 00:16:53,610
!لا داعي للقلق يا تشيكا

310
00:16:53,610 --> 00:16:55,570
!سأوسعه ضربًا لأجلك أيضًا

311
00:16:55,900 --> 00:16:57,540
.لا بأس

312
00:16:58,270 --> 00:16:59,750
.ماسارو، أمسك

313
00:17:00,240 --> 00:17:01,590
!مهلاً

314
00:17:01,900 --> 00:17:03,330
.استعمل ذلك

315
00:17:03,330 --> 00:17:04,750
ماذا؟ وما هذا؟

316
00:17:05,070 --> 00:17:07,750
.سحر صغير يُدعى العِلم

317
00:17:08,080 --> 00:17:09,420
ماذا؟

318
00:17:09,740 --> 00:17:11,880
!سننطلق! تمسّك

319
00:17:22,760 --> 00:17:24,030
.أمسك المقود

320
00:17:29,560 --> 00:17:31,270
!هيّا بنا يا أغومون

321
00:17:31,270 --> 00:17:31,980
!نعم

322
00:17:32,310 --> 00:17:34,610
!بلغت المسافة 500

323
00:17:34,610 --> 00:17:36,950
!لجأت كلّ الفروع لبرّ الأمان

324
00:17:36,950 --> 00:17:38,620
.عليكما المغادرة أيضًا

325
00:17:38,820 --> 00:17:39,950
!أيّها القائد

326
00:17:46,320 --> 00:17:48,710
...غرفة التّحكّم

327
00:17:48,710 --> 00:17:49,880
!هناك

328
00:17:50,200 --> 00:17:52,460
!سننتقم لأنّه أخاف تشيكا

329
00:17:52,460 --> 00:17:53,550
!هيّا بنا يا أغومون

330
00:17:53,550 --> 00:17:54,340
!أجل

331
00:18:03,720 --> 00:18:05,640
...لا يمكننا رؤيته

332
00:18:05,640 --> 00:18:07,310
.لكنّ ذلك لا يعني أنّه غير موجود

333
00:18:07,310 --> 00:18:08,020
.نعم

334
00:18:08,020 --> 00:18:08,850
...ذلك يعني

335
00:18:10,640 --> 00:18:13,320
!أنّك هنا تمسك بالدّفّة

336
00:18:14,230 --> 00:18:15,570
!أيّها الوغد

337
00:18:15,890 --> 00:18:17,990
!أأنت هنا؟ هنا؟ هنا؟

338
00:18:17,990 --> 00:18:20,330
!نعلم أنّك هنا أيّها الوغد

339
00:18:19,690 --> 00:18:20,990
!توقّف

340
00:18:20,990 --> 00:18:24,040
.بإمكانه رؤيتنا، ولكن لا يمكننا نحن رؤيته

341
00:18:24,040 --> 00:18:26,290
!ذلك يعني أنّ من السّهل عليه الهرب منّا

342
00:18:26,610 --> 00:18:28,750
ولكن... ماذا إن استعملتُ هذا؟

343
00:18:29,450 --> 00:18:31,040
...ذلك الرّشّاش

344
00:18:31,040 --> 00:18:36,510
مصنوع من عناصر خاصّة تتفاعل
.مع المادّة الّتي يتكوّن منها الدّيجيمون

345
00:18:41,750 --> 00:18:42,800
!ها أنت ذا

346
00:18:42,800 --> 00:18:44,850
!كيف تجرؤ على الاستخفاف بي؟

347
00:18:44,850 --> 00:18:47,150
!سأجعلك تدفع الثّمن الآن

348
00:18:48,230 --> 00:18:50,650
!هذه لأجل تشيكا

349
00:18:59,940 --> 00:19:02,160
!سُحقًا، لقد صار أكبر

350
00:19:02,160 --> 00:19:03,070
!أنيكي

351
00:19:03,070 --> 00:19:03,620
!نعم

352
00:19:06,360 --> 00:19:09,170
!شحن الرّوح الرّقميّة

353
00:19:13,130 --> 00:19:15,300
!تطوّر أغومون

354
00:19:25,920 --> 00:19:27,360
!جيوغريمون

355
00:19:55,990 --> 00:19:57,500
!الانفجار الهائل

356
00:20:01,830 --> 00:20:03,480
!نجحت

357
00:20:15,010 --> 00:20:16,410
.لقد توقّفت

358
00:20:26,070 --> 00:20:27,210
!أخي ماسارو

359
00:20:28,030 --> 00:20:29,450
.شكرًا يا تشيكا

360
00:20:31,450 --> 00:20:33,330
...بفضل مساعدتك

361
00:20:33,330 --> 00:20:34,040
!انظري

362
00:20:35,330 --> 00:20:36,210
!هذا صحيح

363
00:20:36,210 --> 00:20:37,460
!من الأفضل أن تكون شاكرًا

364
00:20:37,460 --> 00:20:39,000
ماذا عنّي أنا؟

365
00:20:39,000 --> 00:20:40,800
!صحيح، لقد ساعدت أيضًا يا أغومون

366
00:20:40,800 --> 00:20:41,510
!ماذا؟

367
00:20:45,920 --> 00:20:47,430
.تبدو كئيبًا

368
00:20:47,430 --> 00:20:48,300
.القائد

369
00:20:49,880 --> 00:20:55,020
هل سبق وتساءلت لماذا نفّذ ذلك
الدّيجيمون رغبات تشيكا-تشان؟

370
00:20:57,220 --> 00:21:03,400
لماذا تأتي الدّيجيمون إلى عالم البشر؟
ولماذا ترتكب الدّيجيمون الجرائم؟

371
00:21:03,980 --> 00:21:08,200
.ربّما يكون الأمر له علاقة بأفكار النّاس

372
00:21:08,200 --> 00:21:10,170
أفكارهم؟ هل تقصد مشاعرهم؟

373
00:21:10,990 --> 00:21:12,620
.نعم

374
00:21:12,620 --> 00:21:15,960
قبل أيّام، في حوادث هانامورا
...نيون والمنافس هاياسي

375
00:21:15,960 --> 00:21:19,040
،كانت لكلّ منهما رغبات وإرادة قويّة

376
00:21:19,040 --> 00:21:21,970
بحيث كانت أفعال الدّيجيمون
.الّتي ظهرت وقتها مقترنة بها بشدّة

377
00:21:24,210 --> 00:21:27,680
هل الدّيجيمون تتصرّف حسب
تأثير البشر عليها؟

378
00:21:27,680 --> 00:21:31,260
أم أنّ الدّيجيمون هي الّتي تؤثّر على البشر؟

379
00:21:31,260 --> 00:21:36,560
وفي كلتا الحالتين، أعتقد أنّه علينا التّحرّك
.بسرعة قدر الإمكان لكشف أسرار تلك العلاقة

380
00:21:36,560 --> 00:21:39,110
العلاقة بين الدّيجيمون والبشر؟

381
00:22:48,330 --> 00:22:52,890
أنيكي! جُنّ الجميع في داتس
!لأنّني أكلت الخبز الحلو

382
00:22:52,890 --> 00:22:56,850
دع الأمر لي! تُدير عائلة صديقي
.متجر وجبات خفيفة يابانيّة شعبيّة

383
00:22:56,850 --> 00:23:01,270
ماذا؟ والده مهووس بالقمار
وما عاد يدير المتجر؟

384
00:23:01,270 --> 00:23:02,230
!هل أنت واثق

385
00:23:02,230 --> 00:23:04,110
القمار... أذلك لذيذ؟

386
00:23:04,110 --> 00:23:06,440
!كفّ عن محاولة أكل كلّ شيء

387
00:23:06,440 --> 00:23:07,990
:منقذو الدّيجيمون

388
00:23:07,990 --> 00:23:09,700
"!إعادة الرّابط بين الأب وابنه"

389
00:23:09,700 --> 00:23:11,250
"!سحر إفيلمون"

390
00:23:11,310 --> 00:23:14,030
