1
00:00:18,070 --> 00:00:19,820
!سأكتشف بقبضتَي

2
00:00:19,820 --> 00:00:21,500
مشاعر أبي

3
00:00:40,860 --> 00:00:44,060
!أبي! إلى اللّقاء

4
00:00:44,250 --> 00:00:46,560
!إلى اللّقاء

5
00:00:53,430 --> 00:00:55,120
!يوشينو! يوشينو

6
00:00:55,120 --> 00:00:56,930
!استيقظي! أرجوكِ يا يوشينو

7
00:00:58,270 --> 00:00:59,710
ماذا؟

8
00:00:59,710 --> 00:01:01,910
عدنا إلى العالم البشريّ؟

9
00:01:03,670 --> 00:01:06,930
تقصد... بأنّنا نجونا؟

10
00:01:16,570 --> 00:01:17,800
من أنت؟

11
00:01:17,800 --> 00:01:20,260
لماذا ساعدتنا؟

12
00:01:20,980 --> 00:01:23,200
اسمي سليبمون

13
00:01:23,200 --> 00:01:24,980
أنا أحد الفرسان الملكيّين

14
00:01:25,650 --> 00:01:30,580
سليبمون. ديجيمون بمستوى نهائي
مُغطّى بدرع زويد رقميّ أحمر

15
00:01:30,580 --> 00:01:34,990
هجمته الخاصّة هي نفخة أودن
والّتي تُولّد عاصفةً ثلجيّة مُجمِّدة

16
00:01:36,030 --> 00:01:38,070
لا داعي للقلق

17
00:01:38,340 --> 00:01:40,320
إنّه في صفّنا

18
00:01:40,590 --> 00:01:42,120
!القائد ساتسوما؟

19
00:01:46,370 --> 00:01:48,710
!قائد

20
00:01:49,210 --> 00:01:50,890
!يسرّني أنّك على قيد الحياة

21
00:01:50,890 --> 00:01:52,840
...إذاً هذا

22
00:01:54,920 --> 00:01:56,060
كودامون؟

23
00:01:56,060 --> 00:01:59,880
إذاً سليبمون كان الشّكل
!المُتطوِّر من كودامون

24
00:01:59,880 --> 00:02:03,220
أنا آسف... لأنّني أثرتُ قلقكم

25
00:02:04,230 --> 00:02:05,140
!كودامون

26
00:02:06,670 --> 00:02:08,420
!لنعُد إلى الملجأ

27
00:02:08,420 --> 00:02:10,950
!زعيم! علينا الذّهاب

28
00:02:11,590 --> 00:02:12,570
زعيم؟

29
00:02:14,830 --> 00:02:16,040
...زعيم

30
00:03:18,170 --> 00:03:21,580
،كودامون، الّذي يعمل كسفير للعالم الرّقميّ

31
00:03:21,580 --> 00:03:24,560
كان يُراقب العالم البشريّ طوال هذا الوقت

32
00:03:24,560 --> 00:03:31,790
ليحدِّد فيما إذا كان البشر
قوّة حميدة أو خبيثة

33
00:03:31,790 --> 00:03:33,020
...تقصد

34
00:03:33,230 --> 00:03:36,560
!كودامون جاسوس من يغدراشيل؟

35
00:03:36,560 --> 00:03:38,240
اهدئي يا ميغومي

36
00:03:40,090 --> 00:03:44,040
لا أنكر بأنّني أحد الفُرسان الملكيّين

37
00:03:44,040 --> 00:03:51,250
لكن أصبحتُ مولعاً بالبشر أثناء
قضاء وقتي في عالمكم

38
00:03:52,140 --> 00:03:55,170
،إذا كان ذلك لأجل إنقاذ العالم الرّقميّ

39
00:03:55,170 --> 00:04:01,590
فلا أستطيع قبول أمر يغدراشيل
بتدمير العالم البشريّ

40
00:04:01,590 --> 00:04:03,970
دمّر البشرُ الجدار بين العالمين

41
00:04:03,970 --> 00:04:08,890
هم من تسبّبوا بهذه الكارثة

42
00:04:08,890 --> 00:04:16,190
لا جدوى من إبقائهم أحياء

43
00:04:16,840 --> 00:04:20,780
يغدراشيل هو إله العالم الرّقميّ، صحيح؟

44
00:04:21,250 --> 00:04:22,790
...ماسارو

45
00:04:22,790 --> 00:04:23,820
...لماذا

46
00:04:24,660 --> 00:04:27,530
!لماذا يسمّي أبي نفسه يغدراشيل؟

47
00:04:28,040 --> 00:04:30,660
لماذا هو عدوّنا؟

48
00:04:30,660 --> 00:04:31,830
!لماذا؟

49
00:04:33,850 --> 00:04:35,230
...إنّه

50
00:04:35,230 --> 00:04:37,670
الدّكتور دايمون قد تغيّر

51
00:04:39,370 --> 00:04:44,030
بعد أن هربنا من الفضاء بين العالمين
،وهبطنا في العالم الرّقميّ

52
00:04:44,030 --> 00:04:46,560
صادفناه

53
00:04:46,560 --> 00:04:47,630
ماذا؟

54
00:04:47,630 --> 00:04:49,010
!تُدمِّر العالم البشريّ؟

55
00:04:49,950 --> 00:04:54,220
هذا هو قراري كإله للعالم الرّقميّ

56
00:04:54,220 --> 00:04:57,580
لا يستطيع أحدٌ إيقافي

57
00:04:57,580 --> 00:05:00,990
!ماذا عن سايوري-سان وتشيكا-تشان؟

58
00:05:00,990 --> 00:05:03,990
ماذا عن ماسارو الّذي يقاتل
!من أجل البشر والدّيجيمون؟

59
00:05:04,200 --> 00:05:06,930
لا أعرف عمّاذا تتحدّث

60
00:05:06,930 --> 00:05:07,740
ارحل

61
00:05:10,370 --> 00:05:13,840
الأب الّذي عرفتَه قد اختفى

62
00:05:13,840 --> 00:05:14,830
...إنّه قد

63
00:05:15,300 --> 00:05:17,790
!الدّكتور سوغورو دايمون قد تغيّر

64
00:05:24,980 --> 00:05:26,550
...تـ-تشيكان

65
00:05:29,190 --> 00:05:30,060
!أنت تكذب

66
00:05:30,060 --> 00:05:31,260
!لا يمكن أن يكون هذا صحيحاً

67
00:05:32,400 --> 00:05:33,330
...تشيكا

68
00:05:37,440 --> 00:05:38,870
عائلة إذاً؟

69
00:05:38,870 --> 00:05:40,810
آمل أن يكونوا بخير

70
00:05:54,120 --> 00:05:55,860
—هل هذه

71
00:05:55,860 --> 00:05:57,910
!هذه للزّعيم

72
00:05:57,910 --> 00:06:00,260
!لم أكن أريدها

73
00:06:00,260 --> 00:06:02,750
!عـ-على أيّ حال... صحيح، ماسارو

74
00:06:02,750 --> 00:06:04,300
!سيكون ماسارو بخير

75
00:06:04,300 --> 00:06:06,170
!سيتحسّن مِزاجه قريباً بالتّأكيد

76
00:06:06,650 --> 00:06:08,260
لا داعي لتخبريني بذلك

77
00:06:08,260 --> 00:06:11,280
الزّعيم لا يسمح لشيء كهذا أن يُحبطه

78
00:06:13,130 --> 00:06:14,970
اسمعوا جميعاً

79
00:06:15,590 --> 00:06:20,820
كما تعلمون، العالمان البشريّ والرّقميّ
على وشك أن يصطدما

80
00:06:21,500 --> 00:06:25,820
يحاولون إخلاء النّاس إلى ملاجئ
،تحت الأرض

81
00:06:25,820 --> 00:06:29,060
لكنّه مجرّد إجراء مؤقّت

82
00:06:29,060 --> 00:06:31,810
،حالما تُستنزَف قوّة بانتشوليومون

83
00:06:31,810 --> 00:06:34,400
سيصطدم عالمانا

84
00:06:35,340 --> 00:06:41,430
لذلك، أريد منكم جميعاً أن تفكّروا
فيما سنفعله تالياً

85
00:06:41,430 --> 00:06:43,780
هذا كلّ ما لديّ لأقوله

86
00:06:43,780 --> 00:06:45,800
ماذا ستفعل يا قائد؟

87
00:06:46,250 --> 00:06:49,080
!سأبحث عن وسيلة لإنقاذ هذا العالم

88
00:06:49,080 --> 00:06:52,010
مع كودامون قدر ما أستطيع

89
00:06:52,660 --> 00:06:54,850
ماذا سنفعل تالياً؟

90
00:06:55,360 --> 00:06:58,560
!حضرة القائد! رُصِد ديجيمون شمال شرق الميناء

91
00:06:58,930 --> 00:07:00,060
ماذا؟

92
00:07:00,740 --> 00:07:02,980
...هذا ضخم. هل يُعقَل

93
00:07:05,780 --> 00:07:10,070
إله العالم الرّقميّ الّذي يسقط
علينا هو أبي

94
00:07:11,290 --> 00:07:16,320
يريد تدمير عالمنا لإنقاذ العالم الرّقميّ

95
00:07:16,320 --> 00:07:22,660
ألا يهتمّ أبي بنا... بعائلته بعد الآن؟

96
00:07:23,270 --> 00:07:25,520
...قضيتُ كلّ هذا الوقت، أنتظر وأؤمن

97
00:07:25,520 --> 00:07:29,670
...أؤمن بأنّه سيعود إلينا يوماً ما

98
00:07:30,470 --> 00:07:35,000
...مهما شعرتُ بوحدة، انتظرتُ وانتظرت

99
00:07:35,000 --> 00:07:36,640
...لِمَ عليه أن

100
00:07:36,640 --> 00:07:39,140
!لا بدّ من وجود خطأ ما

101
00:07:39,480 --> 00:07:42,330
!مُحال أن يخوننا أبي

102
00:07:42,330 --> 00:07:44,810
!من المؤكَّد أنّه يوجد سبب

103
00:07:45,100 --> 00:07:47,140
...سبب يدفعه لـ

104
00:07:49,260 --> 00:07:50,770
ماسارو

105
00:07:50,770 --> 00:07:55,740
لا أعرف ماذا حدث بينك وبين أبيك

106
00:07:56,940 --> 00:08:02,290
...لكن كيفما تصرّف عندما التقيته

107
00:08:02,540 --> 00:08:05,770
ما زلتُ أؤمن به

108
00:08:05,770 --> 00:08:09,250
فنحن عائلة

109
00:08:09,250 --> 00:08:10,460
...عائلة

110
00:08:10,750 --> 00:08:14,430
،حتّى عندما يكون الأمر عصيّاً
أفراد العائلة يثِقون ببعضهم

111
00:08:18,430 --> 00:08:20,340
!أريد الإيمان به أيضاً

112
00:08:21,180 --> 00:08:21,810
...أنا فقط

113
00:08:25,020 --> 00:08:27,700
...بعد رؤيته بهذا الشّكل

114
00:08:27,700 --> 00:08:29,780
!ماذا يُفترض بي أن أفعل؟

115
00:08:30,080 --> 00:08:32,620
!اللّعنة

116
00:08:42,690 --> 00:08:44,560
!انتظر يا ديوكيمون

117
00:08:48,310 --> 00:08:51,240
توقّعتُ أن تنجو من ذلك يا كودامون

118
00:08:51,240 --> 00:08:53,880
!دعوا العالم البشريّ وشأنه

119
00:08:54,350 --> 00:08:59,170
أمرنا يغدراشيل بتدمير العالم البشريّ

120
00:08:59,170 --> 00:09:03,390
من واجب الفُرسان الملكيّين تنفيذ مهمّتهم

121
00:09:03,730 --> 00:09:06,120
،حتّى لإنقاذ العالم الرّقميّ

122
00:09:06,120 --> 00:09:09,860
!لا يمكننا التّضحية بكثير من الأبرياء

123
00:09:10,090 --> 00:09:11,850
يا له من كلام غريب يُقال

124
00:09:11,850 --> 00:09:16,820
البشر شرعوا في هذا بقتل ديجيمونات أبرياء

125
00:09:17,050 --> 00:09:17,990
!مخطئ

126
00:09:17,990 --> 00:09:19,690
!كان ذلك كوراتا فقط

127
00:09:19,690 --> 00:09:22,070
!ليس كلّ البشر سيّئين

128
00:09:22,590 --> 00:09:26,830
مع الأسف، قرار يغدراشيل كان مختلفاً

129
00:09:27,810 --> 00:09:29,280
!والآن ابتعدوا

130
00:09:29,280 --> 00:09:33,260
إن لم تفعلوا، سأدمِّركم والأرض
!الّتي تقفون عليها

131
00:09:33,480 --> 00:09:35,690
!لست من يقرّر لوحده

132
00:09:35,690 --> 00:09:37,930
!سنُحافظ على سلامة هذا العالم

133
00:09:41,270 --> 00:09:43,090
!شحن الرُّوح الرّقميّة

134
00:09:43,090 --> 00:09:44,520
!أوفردرايف

135
00:09:45,300 --> 00:09:46,590
غاومون، تطوّر

136
00:09:46,590 --> 00:09:48,060
لالامون، تطوّري

137
00:09:48,060 --> 00:09:49,610
فالكومون، تطوّر

138
00:10:00,810 --> 00:10:02,990
!ميراجغاوغامون

139
00:10:14,630 --> 00:10:16,010
!روزمون

140
00:10:24,590 --> 00:10:26,020
!رافمون

141
00:10:28,960 --> 00:10:30,110
...الشّحن الكامل

142
00:10:30,720 --> 00:10:31,960
!للرُّوح الرّقميّة

143
00:10:32,610 --> 00:10:34,520
باونتشيسمون، تطوّر

144
00:10:34,520 --> 00:10:35,690
!روكتشيسمون

145
00:10:35,690 --> 00:10:37,150
!بيشوبتشيسمون

146
00:10:39,140 --> 00:10:40,710
أنتم من جديد؟

147
00:10:40,710 --> 00:10:44,830
ألم نثبت تفوّقنا في المعركة السّابقة؟

148
00:10:45,130 --> 00:10:48,170
!نحن لا نخشى الهزيمة

149
00:10:48,170 --> 00:10:50,790
كلّ ما نريد فعله هو حماية
!الأشخاص المهمّين بالنّسبة لنا

150
00:10:52,150 --> 00:10:53,250
حمقى

151
00:10:55,870 --> 00:10:58,170
!زعيم! مُصيبة

152
00:10:58,590 --> 00:11:00,550
!زعيم

153
00:11:05,170 --> 00:11:06,990
!إلى اللّقاء

154
00:11:06,990 --> 00:11:09,940
!أبي! إلى اللّقاء

155
00:11:10,290 --> 00:11:12,310
!إلى اللّقاء

156
00:11:13,130 --> 00:11:14,720
...أبي

157
00:11:14,720 --> 00:11:15,450
ماسارو؟

158
00:11:17,730 --> 00:11:19,440
لا شيء

159
00:11:20,710 --> 00:11:21,680
أمّي

160
00:11:23,520 --> 00:11:28,040
أتتذكّرين عندما غادر أبي
إلى العالم الرّقميّ؟

161
00:11:28,290 --> 00:11:29,420
بكلّ تأكيد

162
00:11:29,420 --> 00:11:31,290
مُحال أن أنسى

163
00:11:31,290 --> 00:11:34,090
كان ذلك في مثل هذه الفترة من اليوم

164
00:11:34,090 --> 00:11:34,750
أجل

165
00:11:35,050 --> 00:11:38,710
رغم أنّه لم يحوم هذا الشّيء الغريب فوقنا

166
00:11:43,320 --> 00:11:44,310
!خذ

167
00:11:48,140 --> 00:11:53,490
قبل أن يغادر أبي، لعِبنا
لعبة الإمساك مرّة أخيرة

168
00:11:49,620 --> 00:11:50,470
!خذ هذه

169
00:11:53,490 --> 00:11:55,190
...ثمّ قلتُ

170
00:11:55,560 --> 00:11:58,650
!أبي! ارمِها هذه المرّة

171
00:12:01,990 --> 00:12:03,960
!أقسم بأنّني سأمسكها

172
00:12:15,900 --> 00:12:16,720
...ماسارو

173
00:12:25,750 --> 00:12:27,350
!حسناً. ها أنا ذا

174
00:12:41,790 --> 00:12:42,900
!رأيت؟

175
00:12:43,160 --> 00:12:44,920
!هذا مذهل يا ماسارو

176
00:12:46,250 --> 00:12:50,600
أمسكتُ بالكُرة الّي رماها أبي بكامل قوّته

177
00:12:52,360 --> 00:12:53,220
ماسارو

178
00:12:56,770 --> 00:12:57,630
هذا لك

179
00:13:04,280 --> 00:13:05,800
!يمكنني الحصول عليه؟

180
00:13:06,180 --> 00:13:07,700
!هذا رائع

181
00:13:09,160 --> 00:13:10,260
ماسارو

182
00:13:10,570 --> 00:13:13,980
هذا الطّوق هو دليلٌ على أنّك رجلٌ حقيقيّ

183
00:13:14,470 --> 00:13:16,680
رجل حقيقيّ؟

184
00:13:17,410 --> 00:13:21,170
بدا سعيداً جدّاً آنذاك

185
00:13:21,170 --> 00:13:25,520
لا بدّ أنّه كان مُطمئنّاً بأنّه
،حتّى لو لم يعُد أبداً

186
00:13:25,520 --> 00:13:27,910
ستحمي عائلته بالنّيابة عنه

187
00:13:28,840 --> 00:13:31,850
وبأنّه يستطيع أن يأتمنك علينا

188
00:13:33,640 --> 00:13:35,090
معها حقّ

189
00:13:35,090 --> 00:13:38,020
ائتمنني أبي

190
00:13:38,020 --> 00:13:40,650
!يجب أن أؤمن به أيضاً

191
00:13:43,860 --> 00:13:44,550
...ماذا

192
00:13:46,120 --> 00:13:46,840
!انخفضا

193
00:13:52,090 --> 00:13:53,100
!بيشوبتشيسمون

194
00:13:53,100 --> 00:13:54,850
!زعيم

195
00:13:54,850 --> 00:13:56,930
!إنّه هجوم فارس ملكيّ

196
00:13:56,930 --> 00:13:58,270
!ماذا؟

197
00:14:03,040 --> 00:14:04,010
...ذلك الشّخص

198
00:14:04,560 --> 00:14:07,410
!زعيم! هيّا، لنهزم ذلك الشّخص

199
00:14:07,410 --> 00:14:08,110
!أجل

200
00:14:08,660 --> 00:14:10,660
!أمّي، تشيكا، توجّها إلى مكان آمن

201
00:14:11,560 --> 00:14:13,310
!هيّا يا أغومون! اتبعني

202
00:14:13,310 --> 00:14:14,070
!حسناً

203
00:14:29,780 --> 00:14:35,740
،بعد تكبيد كرانيومون كلّ ذلك العناء
...تساءلتُ عن حجم قوّتكم

204
00:14:35,740 --> 00:14:40,510
مع ذلك بهذه القوّة الهزيلة، تريدون
تحدّي الفُرسان الملكيّين؟

205
00:14:40,510 --> 00:14:42,330
!هذا هُراء

206
00:14:45,260 --> 00:14:48,440
!انتهى الأمر. سأقضي عليكم

207
00:14:48,440 --> 00:14:49,950
!لن نسمح لك

208
00:14:50,920 --> 00:14:52,120
!عليك مقاتلتنا أوّلاً

209
00:14:52,780 --> 00:14:53,740
!ماسارو

210
00:15:02,540 --> 00:15:04,290
!شحن الرُّوح الرّقميّة

211
00:15:04,450 --> 00:15:05,670
!أوفردرايف

212
00:15:06,850 --> 00:15:08,440
أغومون، تطوّر

213
00:15:20,160 --> 00:15:21,850
!شاينغريمون

214
00:15:22,150 --> 00:15:23,610
!هيّا بنا

215
00:15:23,610 --> 00:15:25,520
!سيف جيو الرّماديّ

216
00:15:46,240 --> 00:15:50,080
،لم تُلفِت روحك الرّقميّة انتباهي فحسب

217
00:15:50,080 --> 00:15:52,960
...بل أجبرتني على إشهار غرام أيضاً

218
00:15:52,960 --> 00:15:55,800
!عظيم. سوف أواجهك

219
00:15:56,020 --> 00:15:56,940
!حسناً

220
00:16:27,810 --> 00:16:28,880
!خذ هذه

221
00:16:28,880 --> 00:16:30,670
!الانفجار المجيد

222
00:16:33,950 --> 00:16:34,970
!شاينغريمون

223
00:16:38,750 --> 00:16:41,090
جهد أخير مستميت؟

224
00:16:41,090 --> 00:16:46,400
لكن هل توقّعت هذا أن يحطّم درعي؟

225
00:16:46,400 --> 00:16:47,680
...اللّعنة

226
00:16:47,680 --> 00:16:49,160
!انهض يا شاينغريمون

227
00:16:50,180 --> 00:16:50,940
!لا جدوى

228
00:16:51,920 --> 00:16:57,040
!لا يمكنك اختراق دفاعي مهما حاولت

229
00:16:57,040 --> 00:16:58,250
!اصمت

230
00:16:58,710 --> 00:17:01,290
!سنُسقطك أيُّها الفاشل

231
00:17:01,290 --> 00:17:03,500
!لن ندعكم تدمّرون العالم البشريّ

232
00:17:03,730 --> 00:17:07,050
فضلاً عن ذلك، عليّ معرفة
!الشّعور الحقيقيّ لأبي

233
00:17:07,050 --> 00:17:10,590
!إنّه ليس من النّوع الّذي يؤذي الأبرياء

234
00:17:11,050 --> 00:17:11,840
ماسارو؟

235
00:17:12,120 --> 00:17:14,780
،في العادة أتجاهل ثرثرتكم أنتم البشر

236
00:17:14,780 --> 00:17:18,050
!لكن لا أقبل بأي إهانة ليغدراشيل

237
00:17:18,050 --> 00:17:20,040
!سوف أُسقطك هنا والآن

238
00:17:21,320 --> 00:17:22,840
ساتسوما، دعني أتطوّر

239
00:17:22,840 --> 00:17:25,020
...لكنّك لست في وضع

240
00:17:25,020 --> 00:17:26,730
!هذا مهمّ جدّاً

241
00:17:27,810 --> 00:17:28,440
!بسرعة

242
00:17:29,660 --> 00:17:31,150
!إيليشيان الأخير

243
00:17:32,480 --> 00:17:34,360
!شحن الرُّوح الرّقميّة

244
00:17:34,360 --> 00:17:35,490
!أوفردرايف

245
00:17:36,600 --> 00:17:38,030
كودامون، تطوّر

246
00:17:39,700 --> 00:17:40,910
!سليبمون

247
00:17:43,770 --> 00:17:44,450
!ماذا؟

248
00:17:46,990 --> 00:17:48,060
!سليبمون

249
00:17:52,350 --> 00:17:55,670
!أتظنّ أنّك تستطيع مقاتلتي بوضعك؟

250
00:17:56,280 --> 00:17:57,460
لماذا؟

251
00:17:57,460 --> 00:18:01,740
لماذا أنت، فارس ملكيّ، تقف
!في صفّ البشر؟

252
00:18:02,730 --> 00:18:09,100
يغدراشيل على حقّ من حيث
أنّ البشر حمقى ومُتكبّرون

253
00:18:09,350 --> 00:18:13,320
لكنّهم قادرون على إصلاح أخطائهم

254
00:18:13,870 --> 00:18:17,030
!يمكنهم التطوُّر مثلما نتطوّر

255
00:18:17,620 --> 00:18:20,660
!أؤمن بإمكانيّات البشر

256
00:18:30,080 --> 00:18:32,400
!ابتعد يا سليبمون

257
00:18:32,400 --> 00:18:35,800
!ما كنتُ لأستمتع بتدميرك

258
00:18:36,330 --> 00:18:38,160
أتظنُّ نفسك قادراً على الفوز
بسهولة يا ديوكيمون؟

259
00:18:38,160 --> 00:18:39,760
!لكن ما رأيك بهذا؟

260
00:18:40,480 --> 00:18:41,810
!نفخة أودن

261
00:18:49,670 --> 00:18:50,620
...أنت

262
00:18:51,580 --> 00:18:54,850
!والآن يا ديوكيمون! تجمّد معي

263
00:19:01,520 --> 00:19:03,910
!لن أدعك تفعل ما تشاء

264
00:19:06,490 --> 00:19:09,040
ما الّذي سيحدث قبل الآخر؟

265
00:19:09,040 --> 00:19:12,820
هل سنتجمّد، أم أنّ غرام الخاص
!بك سيخترق نيفلهيم الخاص بي؟

266
00:19:12,820 --> 00:19:14,360
!لنكتشف ذلك

267
00:19:15,760 --> 00:19:17,010
!سليبمون

268
00:19:17,240 --> 00:19:19,360
!ساتسوما! ماسارو

269
00:19:19,360 --> 00:19:21,820
...أئتمكم أنتم البشر

270
00:19:21,820 --> 00:19:24,180
!على مستقبل عالمينا

271
00:19:29,770 --> 00:19:31,810
!سليبمون

272
00:19:45,240 --> 00:19:47,800
سأعود إلى العالم الرّقميّ

273
00:19:47,800 --> 00:19:50,170
عليّ اكتشاف المشاعر الحقيقيّة لأبي

274
00:19:50,170 --> 00:19:51,460
بالتّوفيق لك

275
00:19:51,750 --> 00:19:53,150
...ماسارو-نيتشان

276
00:19:53,150 --> 00:19:54,170
سأكون بخير

277
00:19:54,170 --> 00:19:55,500
اعتمدا عليّ

278
00:19:56,180 --> 00:19:57,820
كلانا رجلان

279
00:19:57,820 --> 00:20:01,800
،حالما نتبادل بعض اللّكمات
سنفهم بعضنا الآخر

280
00:20:02,340 --> 00:20:06,390
سأكتشف ما الّذي يفكّر فيه بالضّبط

281
00:20:06,390 --> 00:20:07,750
...ماسارو-نيتشان

282
00:20:07,750 --> 00:20:10,110
قلتُ بأنّني سأكون بخير! اهدئي، اتّفقنا؟

283
00:20:11,400 --> 00:20:13,480
!ماسارو-نيتشان، اقطع وعداً

284
00:20:13,480 --> 00:20:16,120
!عِدني بأنّك ستُعيد أبي إلى الدّيار

285
00:20:16,120 --> 00:20:17,950
!بالتّأكيد، أعِدُك

286
00:20:17,950 --> 00:20:18,860
ماسارو

287
00:20:19,360 --> 00:20:20,840
سآتي معك

288
00:20:20,840 --> 00:20:22,320
!وكذلك نحن

289
00:20:22,700 --> 00:20:25,240
لا، أنا وشاينغريمون نستطيع تولّي هذا

290
00:20:25,240 --> 00:20:26,760
كيف أمكنك قول ذلك؟

291
00:20:26,760 --> 00:20:30,190
!تعرف حجم قوّة الفُرسان الملكيّين

292
00:20:30,190 --> 00:20:32,330
هذا بيني وبين أبي

293
00:20:32,330 --> 00:20:34,830
من فضلكم، اسمحوا لي أن أفعل هذا بمفردي

294
00:20:34,830 --> 00:20:36,170
...ماسارو

295
00:20:36,170 --> 00:20:40,770
بالإضافة إلى ذلك، يحاول الفُرسان
الملكيّون تدمير العالم البشريّ

296
00:20:40,770 --> 00:20:45,020
من سيحمي هذا العالم إذا ذهبنا
جميعنا إلى هناك؟

297
00:20:46,830 --> 00:20:47,750
حسناً

298
00:20:47,750 --> 00:20:49,110
!اذهب يا ماسارو

299
00:20:49,950 --> 00:20:54,210
ميركوريمون وأنا فهمنا بعضنا الآخر
بعد أن تحادثنا

300
00:20:54,210 --> 00:20:57,200
!لذا يجدر بك أن تذهب وتتكلّم مع أبيك يا ماسارو

301
00:20:57,200 --> 00:20:57,940
!حسناً

302
00:20:58,770 --> 00:20:59,900
...يا إلهي

303
00:21:00,550 --> 00:21:03,110
لا تعدل عن قرارِك أبداً مهما حاوَلنا إقناعك

304
00:21:03,840 --> 00:21:05,110
عُد إلى هنا بالسّلامة، مفهوم؟

305
00:21:05,410 --> 00:21:06,750
...يوشينو

306
00:21:06,750 --> 00:21:08,200
شكراً

307
00:21:08,200 --> 00:21:09,580
اذهب يا ماسارو

308
00:21:09,800 --> 00:21:11,040
!توما

309
00:21:11,040 --> 00:21:15,330
سنظلّ نُحافظ على سلامة هذا المكان
ريثما تُحقِّق هدفك

310
00:21:15,760 --> 00:21:17,960
سنحمي ديارك

311
00:21:18,970 --> 00:21:20,490
!اعتمد علينا

312
00:21:20,490 --> 00:21:21,190
!أجل

313
00:21:22,940 --> 00:21:24,340
!أعتمد عليكم يا رِفاق

314
00:21:29,440 --> 00:21:30,540
ماسارو

315
00:21:30,920 --> 00:21:35,190
أؤمن بك. كلّنا نؤمن... فعلاً

316
00:21:36,160 --> 00:21:37,360
ابذل قصارى جهدك

317
00:21:38,160 --> 00:21:40,080
!أنا قادم يا أبي

318
00:21:40,080 --> 00:21:43,280
هذه المرَّة سأدعُك حتماً تُخبرُني عن مشاعرِك الحقيقيّة

319
00:22:48,880 --> 00:22:51,010
ما الّذي يجب عليّ حمايته"؟"

320
00:22:51,010 --> 00:22:54,620
يصارع توما عائلة نورشتاين وماضيه

321
00:22:54,620 --> 00:23:00,140
،لكن عندما يستهدف فارسٌ ملكيّ ريلينا
!يتّخذ توما قراره

322
00:23:00,140 --> 00:23:01,690
!لوردنايتمون

323
00:23:01,690 --> 00:23:05,070
...أقسم باسمي توما نورشتاين
!بأنّني سأهزمك...

324
00:23:05,070 --> 00:23:08,110
!هذا... وضع الانفجار الخاصّ بي

325
00:23:08,110 --> 00:23:09,400
:مُنقِذو الدِّيجيمون

326
00:23:09,400 --> 00:23:12,220
!وضع العزيمة الانفجاريّ الخاصّ بتوما

327
00:23:12,220 --> 00:23:14,990
!تعالي واسكني في قبضتي أيّتها الرُّوح الرّقميّة