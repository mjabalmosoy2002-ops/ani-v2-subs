1
00:00:17,350 --> 00:00:18,930
!فتى الدِّيجيمون إيكوتو

2
00:00:18,930 --> 00:00:20,520
!أمين الغابة، جوريمون

3
00:00:21,620 --> 00:00:26,660
وجد ماسارو والآخرون أنفسهم في مأزق
أمام الظّهور المفاجئ لميركوريمون

4
00:00:33,400 --> 00:00:38,930
غير أنَّ رغبة ماسارو في حماية الجميع
،أخرجَتْ روحاً رقميّة جديدة

5
00:00:38,930 --> 00:00:43,300
وتطوّر جيوغريمون إلى شكله الممتاز، رايزغريمون

6
00:00:50,370 --> 00:00:53,090
بالإضافة إلى ذلك، اشتبه أبطالُنا
بأنّ كافّة قضايا الدّيجيمون

7
00:00:53,090 --> 00:00:56,990
الّتي وقعَتْ في العالم البشريّ
كانت بتحريض من ميركوريمون

8
00:00:56,990 --> 00:01:00,420
لإيقافه، قرّروا التوجُّه إلى العالم الرّقميّ

9
00:01:01,780 --> 00:01:02,500
لحظة

10
00:01:04,330 --> 00:01:06,810
ثمّة شيء أريد أن أخبركم به جميعاً

11
00:01:08,970 --> 00:01:10,630
لا سيّما أنت يا ماسارو

12
00:01:10,630 --> 00:01:13,290
هذه معلومات مهمّة تخصُّ والدك

13
00:01:14,570 --> 00:01:16,750
أ... أبي؟

14
00:01:17,250 --> 00:01:17,820
أجل

15
00:01:19,300 --> 00:01:21,420
،حدث ذلك قبل عشر سنوات

16
00:01:21,420 --> 00:01:26,500
عندما اكتشفنا عالماً جديداً موجوداً في بُعد
مختلف عن عالمنا، العالم الرّقميّ

17
00:01:26,500 --> 00:01:30,330
وزارة أمن المعلومات التّابعة للحكومة الوطنيّة
جمعت أُناساً مختصّين في مجالات مختلفة

18
00:01:30,330 --> 00:01:32,830
وأرسلتنا للتحرّي حول العالم الرّقميّ

19
00:01:33,770 --> 00:01:35,770
اصطدمت مجموعتنا بعقبات شديدة

20
00:01:37,250 --> 00:01:41,110
،هوجِمنا بواسطة الدّيجيمون، ودُمِّر مُعسكرنا

21
00:01:41,110 --> 00:01:46,280
وتعرّضنا لخطر عدم القدرة على العودة
إلى العالم الرّقميّ

22
00:01:46,280 --> 00:01:49,730
...لكن تحت أوامر رجل بارع

23
00:01:49,730 --> 00:01:51,980
،تجنّبت فرقةُ الاستكشاف الكارثة

24
00:01:51,980 --> 00:01:55,080
وتمكنّا من العودة إلى الدّيار بأمان

25
00:01:55,080 --> 00:01:57,790
كان ذلك الرّجل هو الأستاذ دايمون سوغورو

26
00:01:59,100 --> 00:02:01,120
والدك

27
00:02:15,390 --> 00:02:19,090
حتّى اليوم، لا نملك فكرة عن مكانه

28
00:02:19,090 --> 00:02:19,980
...أمّي

29
00:02:20,350 --> 00:02:21,980
!أمّي، هل كنتِ تعلمين بهذا؟

30
00:02:25,280 --> 00:02:26,110
أجل

31
00:02:30,140 --> 00:02:34,030
صحيح أنّ سوغورو-سان كان الرّجل
الرّيادي في أبحاث الدِّيجيمون

32
00:02:34,240 --> 00:02:38,500
كان يبحث دوماً عن طريقة تسمح للبشر
والدِّيجيمونات بالعيش معاً بسلام

33
00:02:39,660 --> 00:02:40,880
كنتِ تعلمين إذاً

34
00:02:42,280 --> 00:02:43,960
كنتِ تعرفين كلّ شيء

35
00:02:44,470 --> 00:02:47,420
لهذا لم تتفاجئي عندما رأيتِني

36
00:02:50,700 --> 00:02:53,140
لم أكن أنوي إخفاء الأمر

37
00:02:53,840 --> 00:03:00,480
،لكن ارتأيتُ بأنّك إذا عرفت الحقيقة يا ماسارو
...فسوف تختفي في العالم الرّقميّ أيضاً

38
00:03:00,970 --> 00:03:02,640
!لن أختفي

39
00:03:03,670 --> 00:03:06,820
أنا متأكّد بأنّ أبي سيعود يوماً ما
أيضاً! مفهوم؟

40
00:03:07,540 --> 00:03:08,550
...ماسارو

41
00:03:09,890 --> 00:03:11,640
!لا تقلقي من شيء

42
00:03:11,640 --> 00:03:13,290
!دعي كلّ شيء لي

43
00:03:13,290 --> 00:03:14,090
...أنيكي

44
00:03:14,090 --> 00:03:17,720
سأذهب إلى العالم الرّقميّ
،وأهزم ميركوريمون

45
00:03:17,720 --> 00:03:19,450
!وأجد أبي بكلِّ تأكيد

46
00:03:22,660 --> 00:03:24,920
أنت ابنه فعلاً

47
00:03:25,810 --> 00:03:27,420
أ-أمّي؟

48
00:03:27,770 --> 00:03:29,740
...عِدني

49
00:03:29,740 --> 00:03:31,380
بأنّك ستعود حتماً

50
00:03:32,050 --> 00:03:37,350
لا أريد أن أفقد زوجي وابني الحبيبين
معاً بسبب العالم الرّقميّ

51
00:03:38,000 --> 00:03:38,810
حسناً

52
00:03:38,810 --> 00:03:41,810
لن أفعل شيئاً يُسبِّب لكِ الحزن

53
00:03:43,020 --> 00:03:44,770
...ماسارو

54
00:03:48,540 --> 00:03:49,230
هذا سيّئ

55
00:03:49,230 --> 00:03:53,700
كافّة البيانات المُتعلِّقة بالأستاذ دايمون سرّية

56
00:03:54,090 --> 00:03:55,730
...رغم ذلك

57
00:03:55,730 --> 00:03:59,660
من كان يتوقّع أنّ والد ماسارو كان
...الرّجل الرّيادي في بحث الدّيجيمون

58
00:03:59,850 --> 00:04:02,120
ماذا حلَّ به يا تُرى؟

59
00:04:03,260 --> 00:04:05,700
يبدو هذا خطيراً

60
00:04:05,700 --> 00:04:07,250
...رغم ذلك

61
00:04:07,250 --> 00:04:08,670
يستحقّ الأمر التحقُّق

62
00:04:19,490 --> 00:04:23,770
ما زال العالم الرّقميّ عالماً
مجهولاً يُطوّقه الغموض

63
00:04:23,770 --> 00:04:28,560
سيكون هناك بلا شكّ تهديدات تنتظرنا
ولا وسيلة لنا لتوقّعها

64
00:04:28,560 --> 00:04:29,890
...في أسوأ الاحتمالات

65
00:04:29,890 --> 00:04:33,530
قد لا تتمكّنون من العودة إلى العالم
البشريّ مثل الأستاذ دايمون تماماً

66
00:04:34,700 --> 00:04:36,630
هل ما زلتَ عازماً على الذّهاب؟

67
00:04:38,010 --> 00:04:39,990
مرحباً؟ أمّي

68
00:04:40,760 --> 00:04:42,990
...لا، لا يوجد سببٌ دفعني للاتّصال

69
00:04:44,770 --> 00:04:46,580
،إذا لم يطرأ تغيير في آرائكم

70
00:04:45,510 --> 00:04:46,180
نعم

71
00:04:46,580 --> 00:04:49,800
إذاً اجتمعوا هنا غداً على السّاعة 8:30 صباحاً

72
00:04:54,400 --> 00:04:55,210
!هذا ضخم

73
00:04:56,310 --> 00:04:59,120
أعدّت أمّي هذا الغداء لنا جميعاً

74
00:04:59,120 --> 00:05:00,470
...هذا كثير

75
00:05:00,770 --> 00:05:02,650
...لن نخرج في نزهة

76
00:05:02,650 --> 00:05:03,480
...أنيكي

77
00:05:03,480 --> 00:05:06,070
يقول توما بأنّه لا يريد بيض سايوري المقليّ

78
00:05:06,070 --> 00:05:07,150
ليس لدينا خيار إذاً

79
00:05:07,150 --> 00:05:08,190
سيترتّب علينا أكله كلّه بأنفسنا

80
00:05:09,630 --> 00:05:11,650
...أُصيب سيّدي بصدمة

81
00:05:12,280 --> 00:05:15,280
لا بدّ أنّك تعشق هذا البيض المقليّ

82
00:05:19,410 --> 00:05:21,160
قرّرتم جميعاً إذاً

83
00:05:23,630 --> 00:05:26,530
هذا رادار ديجيمون سيُرسَل مع كلّ شيء
آخر في حاوية واحدة

84
00:05:26,530 --> 00:05:29,390
سيحدِّد لكم المنطقة العامّة
الّتي يتواجد فيها ميركوريمون

85
00:05:29,390 --> 00:05:31,810
هذا جهاز اتِّصال بعيد المدى

86
00:05:31,810 --> 00:05:33,380
استخدموه لمُوافاتنا بكلّ جديد

87
00:05:33,880 --> 00:05:35,170
ما هذه؟

88
00:05:35,170 --> 00:05:36,840
إنّها مُؤشِّرات إرسال

89
00:05:37,960 --> 00:05:42,710
الإشارة الّتي تبعثها ستُعلمنا عن المكان
الّذي سنفتح لكم فيه البوّابة الرّقميّة

90
00:05:42,710 --> 00:05:45,310
لا تفقدوها، وإلّا فلن نتمكّن من إعادتكم

91
00:05:45,310 --> 00:05:47,030
إنّها أجهزة تعقُّب إذاً

92
00:05:47,920 --> 00:05:50,270
ماذا عن معدّات النّقل؟

93
00:05:50,270 --> 00:05:54,370
،بعد الاستعانة بكافّة البيانات في غوصنا السّابق
أجريتُ بعض التّعديلات

94
00:05:54,370 --> 00:05:55,480
إنّها آمنة تماماً

95
00:05:56,410 --> 00:05:57,990
اكتملت كافّة تحضيراتكم

96
00:05:58,330 --> 00:05:59,230
...حسناً إذاً

97
00:05:59,230 --> 00:06:00,160
!ابدؤوا بالمهمّة

98
00:06:00,520 --> 00:06:01,260
!عُلِم

99
00:06:03,840 --> 00:06:06,540
%تجميعُ مصدّة الانتِقال الآنيّ عندَ 98

100
00:06:07,130 --> 00:06:09,040
تشغيلُ المُكثِّف البيولوجيّ

101
00:06:09,550 --> 00:06:11,750
تصفيفُ المُنغِّم الرقميّ

102
00:06:12,540 --> 00:06:13,840
فتحُ مسار الأمن

103
00:06:14,460 --> 00:06:15,840
توليفُ المُثبِّت

104
00:06:16,230 --> 00:06:18,110
فتحُ البوَّابة الرقميّة

105
00:06:18,110 --> 00:06:19,420
العدُّ التنازليّ

106
00:06:19,420 --> 00:06:20,370
...3

107
00:06:20,370 --> 00:06:21,370
...2

108
00:06:21,370 --> 00:06:22,440
...1

109
00:06:23,400 --> 00:06:24,390
!ابدأ عمليّة الانتِقال

110
00:06:24,870 --> 00:06:25,890
!البدءُ بعمليّةِ الانتقال

111
00:06:42,590 --> 00:06:44,350
هل كانَتْ فكرة جيِّدة حقَّاً يا ساتسوما

112
00:06:44,350 --> 00:06:46,260
بالسّماح لهم بالذّهاب؟

113
00:06:46,920 --> 00:06:49,080
،أريد أن أؤمن بأولئك الأطفال

114
00:06:49,080 --> 00:06:51,620
والإمكانيّة غير المحدودة الّتي يمتلكونها

115
00:06:58,020 --> 00:06:59,240
لقد أتوا

116
00:08:07,790 --> 00:08:08,990
اكتملت عمليّة الانتقال الآنيّ

117
00:08:08,990 --> 00:08:11,070
...هذا هو العالم الرّقميّ إذاً

118
00:08:11,070 --> 00:08:13,670
...هناك صخور وأشياء عائمة في السّماء

119
00:08:13,670 --> 00:08:15,190
...هذا لا يُصدَّق

120
00:08:15,190 --> 00:08:17,070
تفاجأتم، أليس كذلك؟

121
00:08:17,070 --> 00:08:18,990
لِمَ تتصرّف بتكبُّر هكذا؟

122
00:08:18,990 --> 00:08:21,170
لأنّها الزّيارة الثّانية لي إلى هنا

123
00:08:21,170 --> 00:08:22,510
أنا خبيرٌ بالفعل

124
00:08:22,510 --> 00:08:23,670
حقّاً؟

125
00:08:23,670 --> 00:08:24,870
الحاوية هناك

126
00:08:24,870 --> 00:08:25,700
!هيّا بنا

127
00:08:26,390 --> 00:08:29,050
لماذا لم يُرسِلوها إلى نقطةٍ أقرب بقليل من ذلك؟

128
00:08:29,050 --> 00:08:30,630
انتظر هنا فحسب إذاً

129
00:08:30,630 --> 00:08:32,710
سنتناول الغداء في هذه الأثناء

130
00:08:32,710 --> 00:08:33,220
ماذا؟

131
00:08:33,220 --> 00:08:33,950
!أنيكي

132
00:08:33,950 --> 00:08:34,830
...أغومون

133
00:08:34,830 --> 00:08:37,680
!يوجد غداء سايوري في تلك الحاوية أيضاً

134
00:08:38,610 --> 00:08:40,450
!لهذا توما على عجلة من أمره

135
00:08:40,450 --> 00:08:41,570
!انتظر

136
00:08:42,620 --> 00:08:46,210
ألن يظهر ميركوريمون فوراً يا تُرى؟

137
00:08:53,160 --> 00:08:54,390
!أغومون

138
00:08:54,390 --> 00:08:55,970
!ماذا تفعل في الخارج؟

139
00:08:55,970 --> 00:08:59,540
!سأكون أوّل من يصل إلى بيض سايوري المقليّ

140
00:09:11,730 --> 00:09:13,950
!...بيض سايوري المقليّ

141
00:09:14,870 --> 00:09:16,070
!غاومون، ريالايز

142
00:09:17,310 --> 00:09:18,590
!لالامون، ريالايز

143
00:09:19,440 --> 00:09:20,780
!حاضر سيّدي

144
00:09:20,780 --> 00:09:22,330
!لالامون

145
00:09:32,020 --> 00:09:33,890
!فقدنا ماسارو والآخرين

146
00:09:33,890 --> 00:09:36,270
!مؤشِّرُ الإشارةِ الّذي يشيرُ إلى الفتحةِ قد زالَ أيضاً

147
00:09:36,270 --> 00:09:36,790
!ماذا؟

148
00:09:37,490 --> 00:09:38,820
...ساتسوما

149
00:09:46,030 --> 00:09:46,930
!ماسارو

150
00:09:46,930 --> 00:09:47,840
إلى أين أنت ذاهب؟

151
00:09:47,840 --> 00:09:49,800
!أنا ألحق به

152
00:09:49,800 --> 00:09:50,970
!هيّا يا أغومون

153
00:09:50,970 --> 00:09:51,760
!حسناً

154
00:09:52,570 --> 00:09:53,090
!توقّفا

155
00:09:53,090 --> 00:09:54,090
!هذا خطير

156
00:09:55,230 --> 00:09:56,470
!انتظر

157
00:09:57,080 --> 00:09:58,090
!توقّف مكانك

158
00:10:03,350 --> 00:10:04,750
من ذاك الفتى؟

159
00:10:04,750 --> 00:10:06,440
هل هو... فتى بشريّ؟

160
00:10:06,440 --> 00:10:07,750
!هذا غير ممكن

161
00:10:16,800 --> 00:10:18,470
!أنت، انتظر

162
00:10:19,410 --> 00:10:21,080
!يوشينو

163
00:10:23,130 --> 00:10:24,770
!إيكوتو

164
00:10:26,860 --> 00:10:27,860
!فالكومون

165
00:10:27,860 --> 00:10:29,180
!كنتُ أبحث عنك

166
00:10:29,180 --> 00:10:31,470
إلى أين ذهبت؟

167
00:10:31,470 --> 00:10:32,970
جاء البشر

168
00:10:33,920 --> 00:10:35,430
أتى أولئك النّاس إلى هنا؟

169
00:10:35,840 --> 00:10:37,890
!لن أسامح البشر أبداً

170
00:10:37,890 --> 00:10:38,790
!إيكوتو

171
00:10:45,330 --> 00:10:47,480
!أمسكتُ بك أيّها الشّقيّ اللّعين

172
00:10:47,480 --> 00:10:49,270
!دع إيكوتو

173
00:10:53,530 --> 00:10:54,600
...تبّاً

174
00:10:55,480 --> 00:10:56,120
!هل تهرب؟

175
00:11:01,840 --> 00:11:02,500
!...أنت

176
00:11:03,170 --> 00:11:04,500
!من تكون بالضّبط؟

177
00:11:04,990 --> 00:11:06,250
!أعِد البيضة

178
00:11:06,820 --> 00:11:08,670
!إنّه فالكومون ذاك

179
00:11:09,120 --> 00:11:11,380
إذاً هل هذا يعني بأنّ ذلك
الفتى مع ميركوريمون؟

180
00:11:11,750 --> 00:11:13,820
!أنتم عدوّ الدِّيجيمون

181
00:11:13,820 --> 00:11:15,350
!سوف أهزمكم

182
00:11:15,810 --> 00:11:16,510
!ماذا؟

183
00:11:16,900 --> 00:11:19,550
!البشر يُدمِّرون سلام العالم الرّقميّ

184
00:11:19,550 --> 00:11:21,470
!أنا لا أسامح البشر

185
00:11:21,470 --> 00:11:22,680
!كفاك حماقة

186
00:11:22,680 --> 00:11:25,580
!ميركوريمون هو من دمّر السّلام

187
00:11:25,580 --> 00:11:27,740
!لا تتكلّم بسوء عن ميركوريمون

188
00:11:27,740 --> 00:11:29,390
!ميركوريمون على حقّ

189
00:11:29,390 --> 00:11:32,030
!كافّة الدِّيجيمون تُطيعه

190
00:11:45,270 --> 00:11:46,710
!أوتشيتاكي أوتوشي

191
00:11:45,270 --> 00:11:46,710
إنزال أوتشيتاكي

192
00:11:51,520 --> 00:11:52,760
...هذا سيّئ

193
00:12:00,650 --> 00:12:04,560
...ا... اخرجوا

194
00:12:06,740 --> 00:12:08,150
ما هذا الضّباب؟

195
00:12:09,520 --> 00:12:15,790
!اخرجوا... من غابتي

196
00:12:16,620 --> 00:12:17,620
من هذا؟

197
00:12:26,890 --> 00:12:28,500
!ما هذه الأشياء؟

198
00:12:29,200 --> 00:12:30,030
!لالامون

199
00:12:30,030 --> 00:12:30,900
!غاومون

200
00:12:30,900 --> 00:12:32,100
!برغيّ لالا

201
00:12:32,100 --> 00:12:33,380
!الضّربة الخلفيّة المزدوجة

202
00:12:36,240 --> 00:12:37,240
هل أنتم بخير؟

203
00:12:37,980 --> 00:12:39,430
تبّاً، ما الّذي يجري؟

204
00:12:41,810 --> 00:12:46,390
...أيّها البشر الحمقى والعنيفون

205
00:12:46,390 --> 00:12:51,860
!غادروا هذه الغابة حالاً

206
00:12:52,720 --> 00:12:53,890
جوريمون

207
00:12:53,890 --> 00:12:55,290
ديجيمون بمستوى ممتاز يرسل

208
00:12:55,290 --> 00:12:57,070
سحابةً تجعل الآخرين يرون الأوهام

209
00:12:57,070 --> 00:13:00,830
يُمسِكُ بالخصومِ بلبلابه ويأكلهم كغذاء له

210
00:13:02,340 --> 00:13:04,580
هل هو أحد رِفاق ميركوريمون أيضاً؟

211
00:13:04,580 --> 00:13:08,000
أنا سيّد هذه الغابة

212
00:13:08,000 --> 00:13:10,020
ليس لديّ حُلفاء خارجيّون

213
00:13:10,020 --> 00:13:10,500
ماذا؟

214
00:13:11,310 --> 00:13:14,710
...الصّغيران اللّذان يختبئان هناك

215
00:13:15,980 --> 00:13:18,170
هذا ينطبق عليكما كذلك

216
00:13:18,170 --> 00:13:21,180
!غادروا هذه الغابة فوراً

217
00:13:21,510 --> 00:13:23,300
إنّه ليس في أيّ طرف؟

218
00:13:23,300 --> 00:13:28,140
هذا يعني أنّه ليس كافّة الدِّيجيمون في العالم
الرّقميّ يُطيعون ميركوريمون

219
00:13:29,640 --> 00:13:30,150
!اصمت

220
00:13:30,150 --> 00:13:32,320
!البشر أعداء للدّيجيمون

221
00:13:32,320 --> 00:13:33,610
!سوف أهزم البشر

222
00:13:34,110 --> 00:13:36,070
هل ما زلت تثرثر حول ذلك؟

223
00:13:37,000 --> 00:13:39,190
!إيكوتو، مدّني بالقوّة

224
00:13:39,190 --> 00:13:39,990
!حسناً

225
00:13:42,840 --> 00:13:43,770
!...هذا

226
00:13:43,770 --> 00:13:44,450
!جهاز رقميّ

227
00:13:44,920 --> 00:13:45,870
ما الّذي يجري؟

228
00:13:49,800 --> 00:13:51,510
!فالكومون، تطوّر

229
00:14:08,690 --> 00:14:09,830
!بيكمون

230
00:14:11,140 --> 00:14:12,230
بيكمون

231
00:14:12,230 --> 00:14:14,960
ديجيمون بمُستوى بالِغ بقوّةِ مشي حيويّة جدّاً

232
00:14:14,960 --> 00:14:16,610
هجمته الخاصّة هي المِخلب اللّولبيّ

233
00:14:16,610 --> 00:14:18,210
وبتدوير جسده بالكامِل بسرعةٍ فائقة

234
00:14:18,210 --> 00:14:20,320
يستطيع سحق العدوّ بمخالبه الهائلة

235
00:14:23,360 --> 00:14:24,590
!هيّا بنا يا بيكمون

236
00:14:27,630 --> 00:14:29,480
!المِخلب اللّولبيّ

237
00:14:33,760 --> 00:14:35,170
!يا لها من سرعة مُبهِرة

238
00:14:38,510 --> 00:14:41,060
!شحنة الرّوح الرّقميّة

239
00:14:48,020 --> 00:14:49,730
!شحنة الرّوح الرّقميّة

240
00:14:53,640 --> 00:14:54,970
!غاومون، تطوّر

241
00:15:00,160 --> 00:15:01,680
!غاوغامون

242
00:15:04,450 --> 00:15:05,790
!لالامون، تطوّر

243
00:15:16,260 --> 00:15:17,880
!سانفلومون

244
00:15:21,050 --> 00:15:22,270
!سأقاتل

245
00:15:22,270 --> 00:15:24,160
!سأحمي العالم الرّقميّ

246
00:15:33,780 --> 00:15:35,910
!بما أنّك لا تعلم، فسوف أخبرك

247
00:15:35,910 --> 00:15:40,660
لقد اخترتَ للتوِّ القِتال مع مُقاتِل
الشّوارع الأوّل في اليابان

248
00:15:44,280 --> 00:15:46,930
!شحنة الرّوح الرّقميّة

249
00:15:51,510 --> 00:15:53,310
!أغومون، تطوّر

250
00:16:08,930 --> 00:16:09,950
!جيوغريمون

251
00:16:14,300 --> 00:16:15,770
!اندفاعة القرن

252
00:16:16,130 --> 00:16:17,000
!لا جدوى

253
00:16:21,300 --> 00:16:23,110
!ريش كوناي

254
00:16:25,380 --> 00:16:26,930
!توقّفوا

255
00:16:26,930 --> 00:16:28,620
!توقّفوا عن هذا

256
00:16:29,330 --> 00:16:30,160
...في الوقت الّذي أتيتُ فيه

257
00:16:30,160 --> 00:16:32,080
...في وقت مجيئي لتبديد شكوكي

258
00:16:32,080 --> 00:16:33,410
!ذلك الشّقيّ إيكوتو

259
00:16:33,410 --> 00:16:34,830
!ماذا يفعل؟

260
00:16:35,570 --> 00:16:36,560
يانمامون

261
00:16:36,560 --> 00:16:39,560
ديجيمون بمستوى بالغ جسده مُغطّى بقشرة قاسية

262
00:16:39,560 --> 00:16:41,800
يُحلِّق بحرّية في السّماء بأجنحة في ظهره

263
00:16:41,980 --> 00:16:43,050
!شديدة

264
00:16:43,050 --> 00:16:45,000
!سأعاقبه عقوبة شديدة

265
00:16:45,960 --> 00:16:47,610
!اندفاع المِخلب المزدوج

266
00:16:51,530 --> 00:16:53,220
!شُعاع ضوء الشّمس

267
00:16:57,930 --> 00:16:59,060
!إنّه فائق السّرعة

268
00:17:00,120 --> 00:17:01,410
!توقّفوا عن هذا

269
00:17:02,080 --> 00:17:03,340
!قنبلة الكرز

270
00:17:06,510 --> 00:17:10,200
!ألا تعرفون متى تتوقّفون؟

271
00:17:15,550 --> 00:17:16,160
...هذه

272
00:17:20,950 --> 00:17:22,220
نيوكيمون

273
00:17:22,220 --> 00:17:24,630
إنّهم بمستوى رضيع، ديجيمون من نوع بذرة

274
00:17:24,630 --> 00:17:25,420
هكذا إذاً

275
00:17:25,420 --> 00:17:27,010
...كان جوريمون يحميهم

276
00:17:27,510 --> 00:17:28,460
!تبّاً

277
00:17:39,460 --> 00:17:40,770
...كلّ شيء

278
00:17:40,770 --> 00:17:42,980
!دمِّر كلّ شيء

279
00:17:50,430 --> 00:17:52,680
...أيُعقَل هذا

280
00:17:53,240 --> 00:17:54,740
!النّفخة اللّولبيّة

281
00:17:55,280 --> 00:17:57,040
!شُعاع ضوء الشّمس

282
00:17:59,500 --> 00:18:00,420
ماذا؟

283
00:18:00,860 --> 00:18:03,950
بوسعنا جميعاً الاستعانة ببعض
المساعدة في وقت الحاجة

284
00:18:03,950 --> 00:18:05,380
!هيّا يا جيوغريمون

285
00:18:05,790 --> 00:18:07,060
!اللّهب الهائل

286
00:18:10,060 --> 00:18:11,260
!النّفخة اللّولبيّة

287
00:18:11,680 --> 00:18:13,260
!شُعاع ضوء الشّمس

288
00:18:16,370 --> 00:18:17,910
!تبّاً، إنّها ضخمة جدّاً

289
00:18:17,910 --> 00:18:18,980
!إيّاكم والاستسلام

290
00:18:19,430 --> 00:18:23,260
لا شيء مستحيل بالنّسبة لرجل
!عندما يكرِّس روحه بالكامل في قبضته

291
00:18:25,860 --> 00:18:27,370
...الشّحن الكامل

292
00:18:31,190 --> 00:18:32,790
!للرّوح الرّقميّة

293
00:18:37,890 --> 00:18:39,860
!جيوغريمون، تطوّر

294
00:18:54,690 --> 00:18:55,930
!رايزغريمون

295
00:19:00,070 --> 00:19:02,720
!دمّرها يا رايزغريمون

296
00:19:02,720 --> 00:19:03,520
!عُلِم

297
00:19:03,780 --> 00:19:05,970
!الرّمح الثّلاثيّ الدوّار

298
00:19:18,750 --> 00:19:20,300
...يا لها من قوّة

299
00:19:20,300 --> 00:19:21,150
!هذا غير مهمّ

300
00:19:21,150 --> 00:19:22,350
!سأقاتل

301
00:19:22,350 --> 00:19:22,870
!لكن انظر

302
00:19:23,830 --> 00:19:27,840
!إذا قاتلنا أكثر، فسوف نُقحمهم في الأمر

303
00:19:28,600 --> 00:19:30,210
لننسحب حالياً

304
00:19:35,410 --> 00:19:37,040
أعتقد انتهى الأمر برمّته

305
00:19:37,040 --> 00:19:38,840
!كان ذلك سهلاً يا أنيكي

306
00:19:39,580 --> 00:19:40,970
...هذا لا يُصدَّق

307
00:19:40,970 --> 00:19:46,020
...تمّ إنقاذنا بواسطة البشر الحمقى العنيفين

308
00:19:46,440 --> 00:19:47,810
لا تقلق بشأن ذلك

309
00:19:47,810 --> 00:19:52,130
صحيح أنّ كثيراً من البشر أغبياء
كما تقول تماماً

310
00:19:52,130 --> 00:19:53,410
...لكن

311
00:19:53,410 --> 00:19:55,420
لأنَّهم أغبياء يُمكِنُ لهم أن يأخذوا
الأمورَ بمنحى عاطفيّ

312
00:19:55,420 --> 00:19:58,480
يُسارعون حتّى لإنقاذ ديجيمون غريب
من دون لحظة تردُّد

313
00:19:58,480 --> 00:19:59,410
...هكذا إذاً

314
00:19:59,710 --> 00:20:03,460
رغم ذلك، من كان الفتى إيكوتو هذا؟

315
00:20:03,460 --> 00:20:04,600
!من يكترث؟

316
00:20:04,600 --> 00:20:07,870
،في المرّة المقبلة الّتي أراه فيها
!سوف أُسقِطه

317
00:20:07,870 --> 00:20:09,880
انسوا ذلك، ماذا سنفعل الآن؟

318
00:20:09,880 --> 00:20:10,520
ماذا؟

319
00:20:10,520 --> 00:20:13,340
!كلّ المعدّات الّتي أحضرناها قد اختفت

320
00:20:13,340 --> 00:20:15,710
كيف سنجد ميركوريمون؟

321
00:20:15,710 --> 00:20:18,330
!كيف سنعود إلى الدّيار؟

322
00:20:19,760 --> 00:20:23,170
،كعربون شكر على مساعدة نيوكيمون

323
00:20:23,170 --> 00:20:25,670
سأخبركم بشيء واحد

324
00:20:27,270 --> 00:20:30,280
،في القصر الّذي يعيش فيه ميركوريمون

325
00:20:30,280 --> 00:20:33,000
سمعتُ أنّه تقع بوّابةٌ رقميّةٌ هناك

326
00:20:33,000 --> 00:20:35,240
تعرف مكان ميركوريمون؟

327
00:20:36,280 --> 00:20:38,200
خلف ذلك الجبل

328
00:20:38,990 --> 00:20:42,180
في مكان يُدعى بسلسلة الجبال
...الجليديّة اللّانهائيّة

329
00:20:42,180 --> 00:20:45,210
هناك يقع قصر ميركوريمون

330
00:20:46,770 --> 00:20:48,130
سلسلة جبال الجليد اللّانهائيّة؟

331
00:20:48,840 --> 00:20:53,590
سواء وصلتُم إلى هُناك أم لا فهذا عائد لكم

332
00:20:54,240 --> 00:20:56,810
لا مكسب من دون غِمار

333
00:20:56,810 --> 00:20:58,930
أمست الأمور أكثر تعقيداً

334
00:20:58,930 --> 00:21:00,100
حقّاً؟

335
00:21:00,600 --> 00:21:05,400
حسبما سمعت، لا يمكننا العودة إلى عالمنا
من دون هزيمة ميركوريمون

336
00:21:05,400 --> 00:21:07,280
هل هناك ما هو أبسط من ذلك؟

337
00:21:07,280 --> 00:21:08,560
!معك حقّ يا أنيكي

338
00:21:08,790 --> 00:21:09,510
!حسناً

339
00:21:09,510 --> 00:21:11,680
!لننطلق

340
00:21:11,680 --> 00:21:13,320
علينا... أن نمشي، أليس كذلك؟

341
00:21:13,320 --> 00:21:15,270
!قد يُورِّم هذا ربلة ساقنا

342
00:21:15,270 --> 00:21:16,570
!هذا سيّئ

343
00:21:16,950 --> 00:21:17,800
...هذه

344
00:21:17,800 --> 00:21:19,650
!هذه مُصيبة

345
00:21:26,000 --> 00:21:28,960
!ميركوريمون-ساما

346
00:21:30,390 --> 00:21:31,250
...ما

347
00:21:31,250 --> 00:21:34,370
!ماذا سنفعل بشأن أولئك البشر؟

348
00:21:34,370 --> 00:21:36,060
دعهم يفعلونها

349
00:21:37,430 --> 00:21:38,530
يا إلهي

350
00:21:38,530 --> 00:21:39,180
!يا إلهي

351
00:22:49,300 --> 00:22:52,790
يأخذ ميتالفانتومون أرواح أولئك الّذين
!ييأسون من كوابيسهم ويأكلهم

352
00:22:52,790 --> 00:22:54,070
!من الصّعب هزيمته

353
00:22:54,070 --> 00:22:55,500
...ذكريات أمّي

354
00:22:55,500 --> 00:22:59,210
من يعبث بتلك الذّكريات الثّمينة
!خاصّتي لن أغفر له

355
00:22:59,210 --> 00:23:00,270
!هيّا بنا يا غاومون

356
00:23:00,270 --> 00:23:01,510
!حاضر يا سيّدي

357
00:23:01,510 --> 00:23:03,860
!غاومون، تطوّر ممتاز

358
00:23:03,860 --> 00:23:06,880
!الشّحن الكامل للرُّوح الرّقميّة

359
00:23:06,880 --> 00:23:08,140
:مُنقِذو الدّيجيمون

360
00:23:08,140 --> 00:23:09,370
!ذكريات أمّي

361
00:23:09,370 --> 00:23:11,230
!اِزأر يا ماهاغاومون

362
00:23:11,230 --> 00:23:13,660
!استيقظي في قبضتي أيّتها الرُّوح الرّقميّة