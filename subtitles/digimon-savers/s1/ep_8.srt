1
00:00:23,070 --> 00:00:24,800
!سأبدأ الأكل

2
00:00:29,950 --> 00:00:31,310
.أتساءل ما كان ذلك

3
00:00:34,080 --> 00:00:35,680
!لذيذ

4
00:00:35,680 --> 00:00:37,600
.إعلان مفاجئ عن هانامورا نيون

5
00:00:37,600 --> 00:00:42,400
تمّ تأكيد أنّ المغنّي هانامورا
.نيون-سان كان برفقة فتاة شابّة

6
00:00:43,180 --> 00:00:49,610
رآهما شهود يغادران مبنى آر بي جي
!حيث يعيش هانامورا-سان معًا مؤخّرًا

7
00:00:55,100 --> 00:00:56,110
!يو-يوشينو؟

8
00:01:07,780 --> 00:01:10,090
!هذا هو الأسوأ

9
00:01:26,180 --> 00:01:27,770
ما-ما الّذي تريدونه؟

10
00:01:27,770 --> 00:01:29,700
!أنتم تعترضون طريقي! ابتعدوا

11
00:01:30,430 --> 00:01:31,440
!يوشينو

12
00:01:31,440 --> 00:01:32,070
!نـ-نعم؟

13
00:01:32,480 --> 00:01:33,860
ما معنى هذا؟

14
00:01:33,860 --> 00:01:37,450
كيف استطاعت الأكثر وداعة بيننا
...نحن عضوات داتس

15
00:01:37,740 --> 00:01:39,700
!الحصول على هانامورا نيون؟

16
00:01:39,940 --> 00:01:41,700
...إنّ ذلك

17
00:01:41,700 --> 00:01:43,080
!اشرحي الأمر

18
00:01:43,080 --> 00:01:45,410
.من يهتمّ مع من تخرج

19
00:01:46,360 --> 00:01:48,210
.إنّ ذلك لا يضرّ بالمهمّات أو ما شابه

20
00:01:48,210 --> 00:01:49,930
!بل يضرّ

21
00:01:49,940 --> 00:01:53,920
تصلنا مكالمات الواحدة
!تلو الأخرى منذ الصّباح

22
00:01:53,920 --> 00:01:57,800
كما تصلنا الكثير من رسائل
!الكراهية من معجبي نيون

23
00:01:57,800 --> 00:02:00,640
إنّهم يطالبون بمعرفة من تظنّ
!فوجييدا يوشينو نفسها

24
00:02:00,850 --> 00:02:01,890
!مستحيل

25
00:02:02,340 --> 00:02:05,020
!لم يُعلنوا عن اسمي في التّلفاز

26
00:02:05,130 --> 00:02:07,600
.لا، كُشف كلّ شيء

27
00:02:12,180 --> 00:02:17,780
اسمك وتاريخ ميلادك وعنوان
.عملك وفصيلة دمك

28
00:02:18,400 --> 00:02:20,110
!هذا هو الأسوأ

29
00:02:20,110 --> 00:02:21,450
!كما أنّ تلك صورة سيّئة

30
00:02:22,360 --> 00:02:24,990
...هيّا، اعترفي! متى وأين

31
00:02:24,990 --> 00:02:26,450
تعرّفت على نيون أوّل مرّة؟

32
00:02:26,450 --> 00:02:28,410
...حـ-حسنًا

33
00:02:28,740 --> 00:02:30,920
.دعوني أنا أفسّر

34
00:02:30,920 --> 00:02:31,880
!القائد

35
00:02:36,540 --> 00:02:37,770
.شكرًا لك

36
00:02:42,000 --> 00:02:46,850
قبل شهر، ظهرت إشارة ديجيمون
.في مبنى آر بي جي

37
00:02:46,850 --> 00:02:48,480
...أثبتت التّحاليل

38
00:02:48,480 --> 00:02:51,940
!أنّ الدّيجيمون المخفيّ هناك هو كيرامون

39
00:02:52,220 --> 00:02:57,780
إنّه ديجيمون يُدخل نفسه في شبكة الإنترنيت
ويتحكّم بشتّى الأجهزة كما يشاء، صحيح؟

40
00:02:57,780 --> 00:02:58,650
.هذا صحيح

41
00:02:58,650 --> 00:03:03,870
قام القسم الثّاني لداتس بتفتيش المنطقة
...سرًّا وتمّ الكشف عن المشتبه به الأوّل

42
00:03:04,190 --> 00:03:06,330
.هانامورا نيون

43
00:03:06,900 --> 00:03:09,290
...إذًا فهو يأوي ديجيمون

44
00:03:09,660 --> 00:03:12,210
.لسنا واثقين من ذلك بعد

45
00:03:12,210 --> 00:03:13,050
.نعم

46
00:03:13,410 --> 00:03:17,050
لذلك السّبب طلبتُ من يوشينو
.أن تجري تحقيقًا سرّيًّا

47
00:03:17,050 --> 00:03:18,710
ما هو التّحقيق السّرّيّ؟

48
00:03:18,710 --> 00:03:20,260
.إنّه عندما يتسلّل المحقّق سرًّا للتّحقيق

49
00:03:20,920 --> 00:03:25,600
،لكن إن كانت هنالك إشارة ديجيمون
.علينا التّدخّل واعتقاله في الحال فحسب

50
00:03:25,600 --> 00:03:28,020
.لا يمكننا ذلك

51
00:03:28,020 --> 00:03:30,310
.مبنى آر بي جي عالي التّقنية

52
00:03:30,760 --> 00:03:33,650
.لديه آخر التّطوّرات في أنظمة الأمن

53
00:03:33,650 --> 00:03:37,690
،لذلك إن تهوّرنا في اختراقه
.فسنُطرد في وقت وجيز

54
00:03:37,690 --> 00:03:38,820
.فهمت

55
00:03:38,820 --> 00:03:41,240
ستستمرّ يوشينو في إجراء
.تحقيقها الحاليّ الآن

56
00:03:41,240 --> 00:03:43,120
.سيقدّم لها البقيّة المساعدة

57
00:03:43,770 --> 00:03:45,250
!لا يمكنني الموافقة على ذلك

58
00:03:45,980 --> 00:03:47,950
لماذا وجب أن تكون يوشينو؟

59
00:03:47,950 --> 00:03:51,160
إن كان كلّ ما علينا فعله هو التّقرّب
...من نيون، كان بإمكاننا ذلك أيضًا

60
00:03:51,160 --> 00:03:52,580
.مهلاً لحظة

61
00:03:52,580 --> 00:03:55,760
.هناك سبب وجيه لتعيين هذه المهمّة لها

62
00:03:56,670 --> 00:03:58,880
.نيون صديق طفولة قديم

63
00:04:00,500 --> 00:04:02,630
.ذهبنا إلى نفس المدرسة الابتدائيّة

64
00:04:02,630 --> 00:04:04,130
.هذه أوّل مرّة أسمع فيها هذا

65
00:04:04,130 --> 00:04:07,760
لماذا لزمت الصّمت بشأن أمر مهمّ كهذا؟

66
00:04:07,760 --> 00:04:09,430
أهو مهمّ بالفعل؟

67
00:04:09,430 --> 00:04:11,350
.إنّه مختلف تمامًا عمّا كان عليه من قبل

68
00:04:11,350 --> 00:04:15,100
.كان أقصر منّي وسمينًا

69
00:04:15,100 --> 00:04:18,070
لم أدرك أنّه كان هو عندما حصل
.على بدايته الفنّيّة

70
00:04:20,940 --> 00:04:21,910
!عفوًا

71
00:04:23,530 --> 00:04:24,530
!إنّه نيون

72
00:04:26,730 --> 00:04:27,880
!هيتوشي

73
00:04:29,320 --> 00:04:30,750
هيتوشي؟

74
00:04:31,610 --> 00:04:34,160
.أخبرتك ألاّ تناديني باسمي الحقيقيّ

75
00:04:34,530 --> 00:04:36,290
وما الضّرر من ذلك؟

76
00:04:36,290 --> 00:04:38,540
.لم تتغيّري أبدًا

77
00:04:38,540 --> 00:04:39,420
.حسنًا، أراك لاحقًا

78
00:04:39,420 --> 00:04:41,180
!نعم! إلى اللّقاء

79
00:04:42,370 --> 00:04:43,340
ما كان ذلك؟

80
00:04:43,340 --> 00:04:44,680
.إنّهما مقرّبان جدًّا من بعضهما

81
00:04:44,680 --> 00:04:46,180
أهذه مهمّة بالفعل؟

82
00:04:49,800 --> 00:04:51,640
ما قصّة "هيتوشي"؟

83
00:04:51,640 --> 00:04:54,070
!أخبرينا بكلّ شيء

84
00:04:55,340 --> 00:04:56,280
!هذا مؤلم

85
00:04:58,510 --> 00:04:59,770
...لكن يا يوشينو

86
00:04:59,770 --> 00:05:02,070
.لا، إنّه شابّ لطيف

87
00:05:02,070 --> 00:05:04,820
.من المستحيل أن يفعل أيّ شيء سيّئ

88
00:05:17,700 --> 00:05:18,420
ماذا؟

89
00:05:18,420 --> 00:05:19,540
.الجزر

90
00:05:19,540 --> 00:05:22,130
.كنتُ أفكّر في أنّك بدأت تأكله أخيرًا الآن

91
00:05:22,130 --> 00:05:22,970
ماذا؟

92
00:05:23,080 --> 00:05:28,340
كلّما كان لدينا جزر في الغداء، كنت
.ترفض أكله وتُغضب المعلّمين منك

93
00:05:28,710 --> 00:05:32,350
،وكلّما كان لديك واجب الفصل
.كنتِ تقدّمين لي الكثير منه قصدًا

94
00:05:32,350 --> 00:05:35,780
كنتُ أبدي حبًّا أبويًّا لك
.لأنّي أردتُك أن تأكل بشكل صحّيّ وتكبر

95
00:05:36,430 --> 00:05:38,070
.لديك الكثير من الحبّ الأبويّ

96
00:05:41,180 --> 00:05:45,030
أذكر أنّك لم تكن قادرًا
...على فعل أيّ شيء وحدك

97
00:05:45,030 --> 00:05:46,160
.شكرًا على الطّعام

98
00:05:46,600 --> 00:05:47,960
أتريد بعض القهوة؟

99
00:05:48,060 --> 00:05:50,460
.لا، شكرًا. لديّ عمل

100
00:05:50,770 --> 00:05:52,620
.مهلاً، أرني عملك

101
00:05:52,620 --> 00:05:53,330
.لا أستطيع

102
00:05:53,330 --> 00:05:55,870
لن أستطيع التّفكير في جمل جيّدة
.إن كنتُ مشوّشًا

103
00:05:55,870 --> 00:05:57,580
...ولكن

104
00:05:57,580 --> 00:05:58,630
.هكذا هو الأمر

105
00:05:59,200 --> 00:06:02,180
لذلك لا يمكنك دخول غرفتي، مفهوم؟

106
00:06:07,880 --> 00:06:10,590
.يوشينو، حان الوقت لنبدأ نحن العمل أيضًا

107
00:06:10,590 --> 00:06:11,220
.نعم

108
00:06:12,300 --> 00:06:15,520
تمّ تحميل عيّنات من أغنيته الجديدة
.من أكثر من سبعة ملايين شخص

109
00:06:15,520 --> 00:06:17,350
!مرحبًا يا هانامورا نيون-سان

110
00:06:17,350 --> 00:06:19,190
.شكرًا لك. كلّ ذلك بفضل معجبيّ

111
00:06:19,760 --> 00:06:23,780
.سمعتُ أنّ لديك حبيبة هذه الأيّام

112
00:06:24,100 --> 00:06:25,900
!لا يمكنني أن أرى يا أخي ماسارو

113
00:06:26,390 --> 00:06:30,160
إنّها مصدر تشجيع كبير لي
.لتأليف أغانيّ

114
00:06:30,160 --> 00:06:33,620
.لكنّها شخص عاديّ، لذلك دعوها وشأنها

115
00:06:34,110 --> 00:06:35,950
!نيون رائع جدًّا

116
00:06:36,200 --> 00:06:37,170
ما الرّائع فيه؟

117
00:06:40,070 --> 00:06:43,970
.بطبيعة الحال رغبته في حماية حبيبته

118
00:06:44,290 --> 00:06:49,930
واثقة أنّه سيحين وقت أيضًا
.سيقدّرني فيه شخص ما مثله

119
00:06:50,250 --> 00:06:51,720
!لذلك، خذ هذا

120
00:06:51,720 --> 00:06:52,340
وما هذا؟

121
00:06:52,800 --> 00:06:56,810
!سمعتُ أنّ أختي يوشينو تخرج مع نيون

122
00:06:56,810 --> 00:06:58,360
كيف تعرفين ذلك؟

123
00:07:02,470 --> 00:07:03,650
!أنت من أخبرها

124
00:07:04,180 --> 00:07:08,530
هيّا! اطلب من أختي يوشينو
!أن تحضر لي توقيعه

125
00:07:08,530 --> 00:07:09,280
!كلاّ

126
00:07:09,280 --> 00:07:10,320
!لماذا؟

127
00:07:10,320 --> 00:07:15,200
اسمعي يا تشيكا، ما كنتِ لتحبّي أن يتدخّل
الآخرون في حياة من تحبّين أو تواعدين، صحيح؟

128
00:07:16,240 --> 00:07:17,660
.ينطبق نفس الأمر على يوشينو

129
00:07:17,660 --> 00:07:21,500
ناهيك عن ذكر أنّك تطلبين توقيعه
...فقط لأنّه شخصيّة مشهورة

130
00:07:22,160 --> 00:07:24,250
.أنت بخيل يا أخي ماسارو

131
00:07:26,080 --> 00:07:27,750
!مهلاً يا تشيكا

132
00:07:27,750 --> 00:07:29,260
.جعلتها تبكي

133
00:07:30,000 --> 00:07:32,350
!إنّها غطتك أنت

134
00:07:34,750 --> 00:07:36,560
.حسنًا، لنبدأ

135
00:07:38,270 --> 00:07:48,110
كيرامون
مستوى طفل

136
00:07:38,670 --> 00:07:39,730
.كيرامون

137
00:07:39,730 --> 00:07:43,810
ديجيمون من مستوى طفل يستهلك
.الكثير من البيانات بفمه الكبير

138
00:07:43,810 --> 00:07:45,690
.هجومه الخاصّ هو القهقهة المجنونة

139
00:07:45,690 --> 00:07:48,110
.بإمكانه إطلاق كرة ضوء مدمّرة من فمه

140
00:08:25,470 --> 00:08:26,770
ما هذا؟

141
00:08:26,770 --> 00:08:28,410
إعلان نيون؟

142
00:08:37,230 --> 00:08:38,120
ماذا؟

143
00:08:38,120 --> 00:08:38,990
ما الخطب؟

144
00:08:43,030 --> 00:08:44,410
...ظننتُ أنّي أطفأته

145
00:08:47,780 --> 00:08:49,590
هل تعطّل؟

146
00:08:49,590 --> 00:08:50,510
ماذا؟

147
00:08:50,830 --> 00:08:52,180
ما الّذي يحدث؟

148
00:08:53,920 --> 00:08:54,980
.هذا غريب

149
00:10:10,000 --> 00:10:12,130
"!يوشينو تحذو حذو سيندريلا؟"

150
00:10:12,130 --> 00:10:13,500
"!ظلّ كريساليمون"

151
00:10:28,840 --> 00:10:31,230
!أيّها القائد! ما الّذي يحدث هنا؟

152
00:10:31,230 --> 00:10:32,450
.تمّت السّيطرة على الشّبكة

153
00:10:33,310 --> 00:10:35,570
...فيديو هانامورا نيون الدّعائيّ

154
00:10:35,570 --> 00:10:37,360
يُوزَّع بشكل عشوائيّ على جميع
.شبكات الحاسوب

155
00:10:37,360 --> 00:10:38,820
ماذا عن أجهزة الإرسال لدينا؟

156
00:10:39,310 --> 00:10:41,290
.أنا عاجزة عن إجراء أيّ تحليل

157
00:10:45,030 --> 00:10:46,620
أين يوشينو؟

158
00:10:46,620 --> 00:10:49,210
،أحاول الاتّصال بها منذ مدّة
.لكنّها لا تردّ عليّ

159
00:10:49,570 --> 00:10:50,420
!واصلي الاتّصال

160
00:10:51,660 --> 00:10:52,510
!ماسارو

161
00:10:54,080 --> 00:10:56,220
!انتظر يا أنيكي

162
00:11:01,590 --> 00:11:04,600
لا أشعر بأيّ إشارات للحياة
.قادمة من هذه الغرفة

163
00:11:05,300 --> 00:11:09,280
قد يكون هناك حاجز خاصّ
.حولها يقوم بإلغاء جميع البيانات

164
00:11:24,320 --> 00:11:26,240
!مهلاً! من أين أتيت؟

165
00:11:26,240 --> 00:11:26,990
!اتركني

166
00:11:27,570 --> 00:11:28,500
ماسارو؟

167
00:11:30,740 --> 00:11:33,040
!إنّك تخترق المكان! تعال معي

168
00:11:33,040 --> 00:11:34,550
!أنت هناك، صحيح يا يوشينو؟

169
00:11:34,870 --> 00:11:35,670
!قلت تعال معي

170
00:11:35,880 --> 00:11:37,000
!أجيبيني

171
00:11:37,000 --> 00:11:39,260
!...لا تتحرّك أيّها الـ

172
00:11:41,080 --> 00:11:42,100
!يوشينو

173
00:11:43,590 --> 00:11:45,390
!جيّد، أنت بخير

174
00:11:45,670 --> 00:11:47,850
ماسارو! ماذا هنالك...؟

175
00:11:47,850 --> 00:11:48,970
هل حدث شيء ما؟

176
00:11:48,970 --> 00:11:50,180
!لا تتظاهر بالغباء

177
00:11:50,180 --> 00:11:51,810
!كلّ هذا جزء من مكيدتك

178
00:11:51,810 --> 00:11:53,350
ما-ما الّذي تفعله؟

179
00:11:53,350 --> 00:11:54,100
!من تكون؟

180
00:11:54,510 --> 00:11:57,150
!ما الّذي تخطّط له باستعمال ذلك الدّيجيمون؟

181
00:11:57,520 --> 00:11:59,150
!عمّ تتحدّث؟

182
00:11:59,150 --> 00:12:00,900
!لا تتصرّف وكأنّك لا تعرف

183
00:12:00,900 --> 00:12:01,910
!توقّف

184
00:12:04,480 --> 00:12:06,830
كيف تجرؤ على التّطفّل فجأة
!على منازل الآخرين؟

185
00:12:07,570 --> 00:12:10,500
لماذا لا تفكّر في ألاّ تكون مصدر
إزعاج للآخرين من باب التّغيير؟

186
00:12:10,500 --> 00:12:11,590
!ماذا؟

187
00:12:12,030 --> 00:12:13,080
.أنا آسفة

188
00:12:13,080 --> 00:12:14,250
.لا بأس

189
00:12:14,250 --> 00:12:15,510
.سأعود لاحقًا

190
00:12:19,250 --> 00:12:20,220
.إلى اللّقاء

191
00:12:21,870 --> 00:12:22,800
!مهلاً، انتظري

192
00:12:23,670 --> 00:12:24,850
!قلتُ انتظري

193
00:12:25,670 --> 00:12:27,230
ما كان ذلك؟

194
00:12:27,710 --> 00:12:28,680
.غبيّ

195
00:12:28,680 --> 00:12:30,690
.إنّك تفسد تحقيقي السّرّيّ

196
00:12:31,590 --> 00:12:34,230
.ماذا؟ كنتُ قلقًا عليها فحسب

197
00:12:34,230 --> 00:12:34,900
.عفوًا

198
00:12:37,430 --> 00:12:39,270
لماذا لا ترافقني إلى المكتب؟

199
00:12:39,270 --> 00:12:40,620
!لا-لا أريد

200
00:12:45,810 --> 00:12:48,620
!إنّها مظلمة، لا يمكن معرفة حتّى لمن الصّورة

201
00:12:48,620 --> 00:12:50,630
!أتسمّي نفسك محترفًا؟

202
00:12:50,860 --> 00:12:53,960
...لم أكن قادرًا على استعمال ضوء الكاميرا وقتها

203
00:12:53,960 --> 00:12:57,210
هذا النّوع من الصّور ليس جيّدًا
!كفاية للنّشر على أيّ حال

204
00:12:57,210 --> 00:13:00,300
،لـ-لكن إن فعلتُ ما هو أكثر من هذا
!سأصير مجرمًا

205
00:13:00,300 --> 00:13:01,380
!أيّها المغفّل

206
00:13:01,910 --> 00:13:04,880
إنّ قيامنا بأمور جريئة كهذه
!هو ما يجعل قرّاءنا سعداء

207
00:13:04,880 --> 00:13:06,600
!احصل على صورة لشيء حماسيّ أكثر

208
00:13:06,840 --> 00:13:09,100
!لستَ المصور الوحيد الّذي لديّ

209
00:13:09,100 --> 00:13:11,270
!مـ-مفهوم! سأقوم بذلك

210
00:13:15,590 --> 00:13:18,150
ظهرت إشارة الدّيجيمون أوّل
.مرّة قبل شهر

211
00:13:18,430 --> 00:13:23,620
وعدد تحميلات أغنية نيون الجديدة
.يتضاعف بشكل سريع منذ تلك اللّحظة

212
00:13:24,560 --> 00:13:27,820
هل تعتقد أنّ الدّيجيمون
يتلاعب بتلك الأمور عن قصد؟

213
00:13:27,820 --> 00:13:29,950
.أعتقد أنّ ذلك احتمال معقول

214
00:13:30,230 --> 00:13:31,840
...إذًا فالبارحة

215
00:13:32,110 --> 00:13:34,410
يبدو أنّ علينا اختيار ما العمل
.الآن أكثر من أيّ وقت مضى

216
00:13:34,950 --> 00:13:37,370
.علينا أن نقصد مسكن هانامورا نيون مباشرة

217
00:13:37,370 --> 00:13:38,330
.نعم

218
00:13:38,330 --> 00:13:39,960
!إذًا فسنخترق المكان؟

219
00:13:39,960 --> 00:13:41,140
!مهلاً رجاءً

220
00:13:41,700 --> 00:13:43,880
!ما زلنا لا نملك أيّ دليل

221
00:13:45,080 --> 00:13:46,350
ما هو جدول نيون؟

222
00:13:46,880 --> 00:13:49,260
سيظهر في 12 ظهرًا في برنامج
.مباشر على التّلفاز

223
00:13:49,260 --> 00:13:51,680
.وبعدها سيعود إلى عمله في الثّالثة عصرًا

224
00:13:51,680 --> 00:13:54,890
وسيظهر في منتصف اللّيل
.في برنامج حواريّ إذاعيّ

225
00:13:55,720 --> 00:13:58,560
.سأسمح اللّيلة بإجراء تحقيق قسريّ

226
00:13:58,560 --> 00:13:59,600
.سيتولّى توما القيادة

227
00:14:01,010 --> 00:14:02,070
.لديّ طلب

228
00:14:02,850 --> 00:14:04,740
.أبعد يوشينو عن التّحقيق رجاءً

229
00:14:05,230 --> 00:14:06,410
توما؟

230
00:14:06,940 --> 00:14:09,070
لا يحب على مشاعرها الخاصّة
.أن تتدخّل في هذه القضيّة

231
00:14:09,070 --> 00:14:10,410
.حسنًا

232
00:14:10,410 --> 00:14:11,950
.ستظلّين في المقرّ الرّئيسيّ يا يوشينو

233
00:14:11,950 --> 00:14:13,870
.سيتّبع الجميع أوامر توما

234
00:14:13,870 --> 00:14:14,880
!عُلم

235
00:14:19,450 --> 00:14:23,920
،عندا حلول منتصف اللّيل تمامًا
.سنخترق الشّقّة ونؤمّن الدّيجيمون المختبئ

236
00:14:23,920 --> 00:14:24,750
.عُلم

237
00:14:25,580 --> 00:14:27,300
.بقيت خمس دقائق على بداية الخطّة

238
00:14:27,300 --> 00:14:27,720
!مهلاً

239
00:14:30,130 --> 00:14:31,680
.ستدخل يوشينو

240
00:14:31,680 --> 00:14:33,480
!توما! ما العمل؟

241
00:14:34,760 --> 00:14:38,810
شغّلي الميكروفون الخفيّ
.الّذي وضعتُه عليها ودعيها تدخل

242
00:14:38,810 --> 00:14:39,440
!عُلم

243
00:14:39,850 --> 00:14:41,230
.هذا مذهل يا سيّدي

244
00:14:41,230 --> 00:14:42,490
.كنتَ تتوقّع هذا

245
00:14:42,890 --> 00:14:45,480
،إن كنت تريد خداع أعدائك
.عليك خداع أصدقائك أوّلاً كما يقال

246
00:14:50,860 --> 00:14:51,750
...يوشينو

247
00:14:54,190 --> 00:14:56,410
أواثقة من هذا بالفعل يا يوشينو؟

248
00:14:56,410 --> 00:14:57,120
.نعم

249
00:14:57,120 --> 00:14:59,090
.أريد تسوية هذا الأمر بنفسي

250
00:15:02,330 --> 00:15:03,210
!يوشينو

251
00:15:03,210 --> 00:15:04,090
.هيّا بنا

252
00:15:15,800 --> 00:15:18,350
إذًا فأنت تريدين معرفة سرّي بشدّة هكذا؟

253
00:15:18,550 --> 00:15:19,810
...هيتوشي

254
00:15:19,810 --> 00:15:21,100
ما الّذي تفعله هنا؟

255
00:15:21,100 --> 00:15:24,530
أهذه هي الدّيجيمون خاصّتك؟
.إنّها ظريفة

256
00:15:24,760 --> 00:15:26,570
!لماذا نيون هناك؟

257
00:15:26,570 --> 00:15:28,230
!يفترض أن يكون لديه برنامج إذاعيّ الآن

258
00:15:29,560 --> 00:15:34,170
أدركتُ أخيرًا أنّ هنالك أشخاصًا
.يتطفّلون عليّ

259
00:15:35,360 --> 00:15:38,160
.لذلك السّبب وضعتُ جدولاً مزيّفًا وانتظرت

260
00:15:38,700 --> 00:15:41,620
...لا أصدّق أنّك كنتِ منهم

261
00:15:42,160 --> 00:15:44,830
!ممنوع أن تأوي ديجيمون

262
00:15:45,290 --> 00:15:46,670
!لا تلقي الأوامر عليّ

263
00:15:57,890 --> 00:15:59,600
!دعيني أقدّمه لك

264
00:15:59,600 --> 00:16:02,600
.هذا هو كيرامون، الدّيجيمون الّذي تبحثين عنه

265
00:16:03,010 --> 00:16:04,770
!إنّه مذهل

266
00:16:04,770 --> 00:16:10,280
،إنّه ينشر أغانيّ حول العالم
!وبإمكانه تعديل ترتيب الأغاني النّاجحة

267
00:16:11,690 --> 00:16:14,610
والآن، صار جميع من في العالم
!يعرفون اسمي

268
00:16:14,980 --> 00:16:16,120
!توقّف يا هيتوشي

269
00:16:17,900 --> 00:16:19,080
!يوشينو

270
00:16:34,920 --> 00:16:35,760
!ماسارو

271
00:16:35,760 --> 00:16:37,190
!اللّهب الصّغير

272
00:16:42,720 --> 00:16:44,310
!سلّمنا الدّيجيمون بصمت

273
00:16:44,510 --> 00:16:45,940
!مستحيل

274
00:16:45,940 --> 00:16:48,440
!كيرامون شريكي

275
00:16:48,440 --> 00:16:51,690
يتمّ الاستماع لأغانيّ في كلّ
!أرجاء العالم بفضله

276
00:16:51,690 --> 00:16:53,240
!إنّه يجعلني مشهورًا

277
00:16:53,240 --> 00:16:55,000
!أيّها الغبيّ

278
00:16:56,820 --> 00:16:57,910
!ما الّذي تفعله؟

279
00:16:58,320 --> 00:17:00,450
!ما هذا الهراء عن جعله لك مشهورًا؟

280
00:17:00,450 --> 00:17:03,120
!إنّ ذلك ليس من مجهودك الخاصّ

281
00:17:03,120 --> 00:17:07,300
إن كنت تريد تغير نفسك من خلال
!موسيقاك، فقم بذلك بمجهودك الخاصّ

282
00:17:10,410 --> 00:17:12,180
!يا له من سبق صحفيّ

283
00:17:13,080 --> 00:17:13,970
...إنّه

284
00:17:13,970 --> 00:17:14,840
!هذا سيّئ

285
00:17:14,840 --> 00:17:16,680
!توقّف

286
00:17:16,920 --> 00:17:21,150
!على الجميع أن يكفّوا عن السّخرية منّي

287
00:17:22,670 --> 00:17:23,390
!ما هذا؟

288
00:17:23,390 --> 00:17:24,440
!سُحقًا

289
00:17:28,010 --> 00:17:29,860
!إنّ إشارة الدّيجيمون صارت أقوى

290
00:17:29,860 --> 00:17:30,860
!إنّه يتطوّر

291
00:17:47,960 --> 00:17:57,810
كريساليمون
مستوى بالغ

292
00:17:48,620 --> 00:17:49,830
.كريساليمون

293
00:17:49,830 --> 00:17:52,750
.ديجيمون من مستوى بالغ تحميه صدفة صلبة

294
00:17:52,750 --> 00:17:55,010
.هجومه الخاصّ هو ساحق البيانات

295
00:17:55,010 --> 00:17:57,810
بإمكانه تدمير بيانات خصمه
!باستعمال المجسّات على ظهره

296
00:18:01,630 --> 00:18:02,890
!هيّا يا غاومون

297
00:18:03,060 --> 00:18:03,900
!نعم يا سيّدي

298
00:18:04,510 --> 00:18:06,480
!اللّكمة العلويّة الدّورانيّة

299
00:18:17,440 --> 00:18:20,410
!شحن الرّوح الرّقميّة

300
00:18:23,490 --> 00:18:25,130
!تطوّر غاومون

301
00:18:39,920 --> 00:18:41,640
!غاوغامون

302
00:18:52,220 --> 00:18:54,070
!غاوغامون! اقض عليه

303
00:19:05,400 --> 00:19:06,380
!غاومون

304
00:19:06,900 --> 00:19:08,100
!تماسك

305
00:19:08,100 --> 00:19:09,370
!لنتبادل الأماكن

306
00:19:09,370 --> 00:19:10,500
!هيّا بنا يا أغومون

307
00:19:10,500 --> 00:19:11,510
!نعم

308
00:19:23,170 --> 00:19:25,940
!شحن الرّوح الرّقميّة

309
00:19:30,550 --> 00:19:32,480
!تطوّر أغومون

310
00:19:48,400 --> 00:19:49,420
!جيوغريمون

311
00:20:02,290 --> 00:20:03,380
!سُحقًا للغاز

312
00:20:09,720 --> 00:20:10,980
!جيوغريمون

313
00:20:10,980 --> 00:20:12,350
!أرهم قوّتك الحقيقيّة

314
00:20:12,840 --> 00:20:14,350
!الانفجار الهائل

315
00:20:25,270 --> 00:20:26,790
!نجحنا

316
00:20:27,730 --> 00:20:28,840
!أمسكتك

317
00:20:29,440 --> 00:20:30,380
!هُزم واحد آخر

318
00:20:30,740 --> 00:20:32,120
.عادت الشّاشات تعمل

319
00:20:32,120 --> 00:20:34,420
.اختفت إشارة الدّيجيمون

320
00:20:34,420 --> 00:20:35,170
!عُلم

321
00:20:36,080 --> 00:20:37,590
.تمّت المهمّة

322
00:20:37,590 --> 00:20:38,300
.نعم

323
00:20:38,870 --> 00:20:42,090
!أنا جائع يا أنيكي! أطعمني شيئًا ما

324
00:20:42,580 --> 00:20:44,760
.لا أمل يُرجى منك كالعادة

325
00:20:44,760 --> 00:20:46,050
!تريّث عليّ

326
00:20:49,260 --> 00:20:51,220
!حـ-حصلتُ على سبق صحفيّ رائع

327
00:20:51,220 --> 00:20:53,980
!لا أطيق الانتظار حتّى يرى رئيس التّحرير هذا

328
00:20:53,980 --> 00:20:54,900
!مهلاً

329
00:20:59,060 --> 00:21:01,990
ماذا؟ ما الّذي أفعله هنا؟

330
00:21:01,990 --> 00:21:02,910
ماذا؟

331
00:21:03,980 --> 00:21:06,320
ما الّذي سيحدث لي؟

332
00:21:06,320 --> 00:21:08,740
هل ستمحون ذاكرتي مثله أيضًا؟

333
00:21:09,030 --> 00:21:10,160
.نعم

334
00:21:10,160 --> 00:21:12,040
حتّى ذكرى لقائنا ثانية؟

335
00:21:12,040 --> 00:21:12,700
.نعم

336
00:21:13,740 --> 00:21:15,040
.ذلك مؤسف

337
00:21:15,040 --> 00:21:18,380
.لا تقلق. سأتذكر ذلك لِكلينا

338
00:22:48,790 --> 00:22:51,140
.يثير الملاكم هاياسي الشّبهات

339
00:22:51,140 --> 00:22:54,100
حقّق سبعة انتصارات متتالية
.لأنّ خصومه إمّا أصيبوا أو حالفه الحظّ

340
00:22:54,100 --> 00:22:55,850
.أعتقد أنّه يعمل مع ديجيمون

341
00:22:55,850 --> 00:22:58,020
!لا تتكلّم وكأنّك تعرفه يا ماسارو

342
00:22:58,020 --> 00:23:00,770
ما كان المنافس هاياسي
!أن يقوم بأيّ شيء مشبوه للفوز

343
00:23:00,770 --> 00:23:03,820
.هذا غريب. يشعر سيّدي بالإهانة بسبب هذا

344
00:23:03,820 --> 00:23:06,980
ما العلاقة الّتي تجمع سيّدي
مع المنافس هاياسي؟

345
00:23:06,980 --> 00:23:08,240
:منقذو الدّيجيمون

346
00:23:08,240 --> 00:23:10,280
"!معركة توما المخزية"

347
00:23:10,280 --> 00:23:11,860
"!توغيمون المناور السّرّيّ"

348
00:23:11,860 --> 00:23:14,030
!استيقظي في قبضتي أيّتها الرّوح الرّقميّة

349
00:23:14,030 --> 00:23:16,910
"معركة توما المخزية"
"توغيمون المناور السّرّيّ"