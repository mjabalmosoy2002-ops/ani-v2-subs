1
00:00:18,000 --> 00:00:21,500
وضع العزيمة الانفجاريّ الخاصّ بتوما

2
00:00:22,580 --> 00:00:26,290
والد ماسارو، سوغورو، قد أصبح
،إله العالم الرّقميّ

3
00:00:26,290 --> 00:00:28,090
ممّا يجعله عدوّ البشر

4
00:00:28,920 --> 00:00:32,970
أراد ماسارو رؤية أبيه من جديد
واكتشاف مشاعره الحقيقيّة

5
00:00:32,970 --> 00:00:36,510
بعد اتّخاذ هذا القرار، تركَ ماسارو
توما والآخرين خلفه

6
00:00:36,510 --> 00:00:39,100
وعاد إلى العالم الرّقميّ

7
00:00:59,430 --> 00:01:04,580
في مكان آخر في العالم، كان
الفُرسان الملكيّون قد بدؤوا بغزوهم

8
00:01:04,580 --> 00:01:06,710
وتحت قيادتهم أفواج من نايتمون

9
00:01:12,670 --> 00:01:14,510
!مِخلب العاصفة

10
00:01:18,030 --> 00:01:19,890
!الجناح المُفجِّر

11
00:01:23,530 --> 00:01:26,070
!الإغواء المُحرَّم

12
00:01:30,390 --> 00:01:31,610
!حسام الورود

13
00:01:34,360 --> 00:01:35,410
!لا نهاية لهذا

14
00:01:36,530 --> 00:01:38,600
ألا تنتهي أعدادهم؟

15
00:01:38,600 --> 00:01:42,780
مهما كانت أعدادهم، علينا
التصدّي لهم قدر المستطاع

16
00:01:47,040 --> 00:01:48,060
نعم؟

17
00:01:48,060 --> 00:01:49,470
أهذا أنت يا توما؟

18
00:01:49,470 --> 00:01:51,000
يوشيما-سان؟

19
00:03:01,800 --> 00:03:04,160
جنون! هل سيقلع حقّاً؟

20
00:03:04,480 --> 00:03:06,120
...حذّرتُه مِراراً

21
00:03:11,000 --> 00:03:12,080
!لا

22
00:03:12,670 --> 00:03:14,100
!رامي الدّي جيه

23
00:03:23,030 --> 00:03:23,930
ماذا حدث؟

24
00:03:24,730 --> 00:03:26,720
!ماذا تعتقد بأنّك تفعل؟

25
00:03:27,200 --> 00:03:28,990
أبي؟ ما الأمر؟

26
00:03:28,990 --> 00:03:29,930
!تراجعي

27
00:03:32,810 --> 00:03:34,980
لا... المكان ليس آمناً هنا

28
00:03:36,860 --> 00:03:40,180
أبي، لماذا نحن ذاهبون إلى المنزل الآن؟

29
00:03:43,600 --> 00:03:44,410
!ريلينا

30
00:03:49,110 --> 00:03:50,430
...النّجدة

31
00:03:50,430 --> 00:03:52,390
!أنقذونا أرجوكم

32
00:04:10,240 --> 00:04:11,140
...هذا

33
00:04:11,300 --> 00:04:13,310
!سراب الهِلال المزدوج

34
00:04:28,810 --> 00:04:32,390
الوضع هو نفسه في كلّ أنحاء العالم

35
00:04:32,390 --> 00:04:35,340
لا تُعرِّض ريلينا لخطر بلا سبب

36
00:04:35,340 --> 00:04:38,660
يجب أن أعود إلى النّمسا وأحمي ديارنا

37
00:04:38,660 --> 00:04:41,860
!تعلمُ أنَّ الرَّحلات محظورة حاليّاً

38
00:04:41,860 --> 00:04:45,410
مثل هذه الأمور لا تُقيّد اسم عائلة نورشتاين

39
00:04:45,410 --> 00:04:47,470
!هذا ليس بيت القصيد

40
00:04:47,470 --> 00:04:49,140
!احترم والدك

41
00:04:50,570 --> 00:04:51,470
...سيّدي

42
00:04:53,970 --> 00:04:56,370
قد تصل دُفعة ثانية

43
00:04:56,370 --> 00:04:58,350
عليكما أن تختبئا في ملجأ

44
00:04:58,350 --> 00:05:00,530
ملجأ؟ كفاك حماقة

45
00:05:00,530 --> 00:05:02,410
سأطلب من طائرة أخرى أن تقلنا

46
00:05:03,180 --> 00:05:05,280
!أخبرتُك للتو بأنّ هذا غير ممكن

47
00:05:05,500 --> 00:05:07,280
رافقنا إذاً

48
00:05:09,270 --> 00:05:11,240
...أنت حقّاً

49
00:05:11,490 --> 00:05:15,630
ماذا؟ لا تريد أن تحمي أختك الصّغرى؟

50
00:05:17,050 --> 00:05:18,460
...حسناً

51
00:05:18,940 --> 00:05:21,550
ماذا عنك إذاً؟

52
00:05:21,550 --> 00:05:22,720
ماذا؟

53
00:05:23,560 --> 00:05:26,880
ما الّذي حميتَه في حياتك؟

54
00:05:33,760 --> 00:05:35,350
توما، حان الوقت

55
00:05:36,800 --> 00:05:37,720
هيّا بنا

56
00:05:40,080 --> 00:05:40,890
توما

57
00:05:41,530 --> 00:05:42,340
...حسناً

58
00:05:56,950 --> 00:05:58,090
—أبي، انتظـ

59
00:06:16,080 --> 00:06:17,670
!لِمَ لا يا أمّي؟

60
00:06:17,670 --> 00:06:19,410
تمزح بالتّأكيد

61
00:06:20,410 --> 00:06:23,360
لستُ مُلزمة باللّقاء بذلك الطّفل

62
00:06:23,360 --> 00:06:26,800
!إنّه ابني! وحفيدكِ

63
00:06:26,800 --> 00:06:29,880
يربطني بالدّم فقط، لا أكثر

64
00:06:29,880 --> 00:06:33,160
ذلك الفتى ليس من عائلة نورشتاين

65
00:06:33,670 --> 00:06:34,830
...أمّي

66
00:06:38,660 --> 00:06:39,580
!توما

67
00:06:42,480 --> 00:06:43,660
ماذا تفعل هناك؟

68
00:06:43,660 --> 00:06:45,250
ألقِ التّحيّة

69
00:06:48,460 --> 00:06:50,630
طاب يومكِ يا جدّتي

70
00:06:54,450 --> 00:06:57,020
عينان واسِعتان كأمّه

71
00:06:57,250 --> 00:07:00,690
...تِلك التّلميذة المُنتقِلة الجاهلة

72
00:07:00,690 --> 00:07:02,970
لا عجب في أنّك تمكّنت من إغوائها بسهولة

73
00:07:05,390 --> 00:07:06,230
اسمعني يا بُني

74
00:07:06,900 --> 00:07:11,830
،قد تكون من عائلة نورشتاين
لكنّك لست واحداً منّا

75
00:07:11,830 --> 00:07:13,700
لا تنسَ ذلك

76
00:07:37,000 --> 00:07:39,670
لن أنسى ذلك أبداً

77
00:07:39,670 --> 00:07:41,770
!أهنتَ أمّي

78
00:07:42,540 --> 00:07:46,020
،وفعلتَ ذلك بأسوأ طريقة مُمكنة
بعدم قول شيء

79
00:07:48,200 --> 00:07:50,840
أنت لا تدري شيئاً عن الأمر

80
00:07:52,790 --> 00:07:53,240
سيّدي؟

81
00:08:01,670 --> 00:08:03,370
!افعل شيئاً يا توما

82
00:08:03,370 --> 00:08:06,790
!أرِني قدرتك كنورشتاين

83
00:08:09,300 --> 00:08:11,340
!يتسارع معدّل نبضات قلبها

84
00:08:10,580 --> 00:08:11,340
...هذا سيّئ

85
00:08:12,410 --> 00:08:13,490
!سيّد فرانز

86
00:08:14,440 --> 00:08:15,970
!تُعاني ريلينا-ساما من نوبة

87
00:08:16,620 --> 00:08:17,560
!ماذا؟

88
00:08:19,820 --> 00:08:21,060
...حسناً إذاً

89
00:08:21,060 --> 00:08:24,230
أعتقد حان الوقت لأصبح جادّاً

90
00:08:25,760 --> 00:08:27,190
...الشّحن الكامل

91
00:08:27,870 --> 00:08:30,150
!للرُّوح الرّقميّة

92
00:08:34,550 --> 00:08:35,940
غاوابّامون، تطوّر

93
00:08:45,520 --> 00:08:46,880
!شاوجينمون

94
00:08:47,570 --> 00:08:51,100
شاوجينمون، ديجيمون بمستوى مثاليّ
يتطوّر عن كاميمون

95
00:08:51,100 --> 00:08:53,720
،هجمته الخاصّة هي كويوجو: تاكي-نو-جين

96
00:08:53,720 --> 00:08:56,550
!مُستخدِماً عصاه لإطلاق تيّارات مائيّة

97
00:08:58,390 --> 00:09:00,680
!كويوجو: تاكي-نو-جين

98
00:09:17,440 --> 00:09:18,780
...أخي

99
00:09:26,930 --> 00:09:28,410
وُلِد الرّضيع؟

100
00:09:28,410 --> 00:09:29,930
أجل، إنّها فتاة

101
00:09:29,930 --> 00:09:30,880
فتاة؟

102
00:09:31,210 --> 00:09:32,760
...أجل، لكن

103
00:09:32,760 --> 00:09:35,120
كلّاً من الأمّ والطّفلة في خطر

104
00:09:35,120 --> 00:09:36,050
حسناً

105
00:09:36,050 --> 00:09:38,840
افعلوا المستحيل لإنقاذ الطّفلة

106
00:09:39,000 --> 00:09:42,440
!حصلَتْ عائلةُ نورشتاين على طفل أخيراً

107
00:09:59,610 --> 00:10:01,530
أنتِ ريلينا، صحيح؟

108
00:10:03,880 --> 00:10:06,910
الجميع قلقون عليكِ

109
00:10:44,810 --> 00:10:47,360
سأكافح لإنقاذ ريلينا

110
00:10:48,320 --> 00:10:52,290
!لكن ليس لأنّني من عائلة نورشتاين

111
00:10:54,730 --> 00:10:55,550
!توما

112
00:10:58,970 --> 00:10:59,970
...سيّدي

113
00:11:00,520 --> 00:11:01,420
أنا بخير

114
00:11:11,480 --> 00:11:13,270
!شحن الرُّوح الرّقميّة

115
00:11:13,270 --> 00:11:14,230
!أوفردرايف

116
00:11:15,970 --> 00:11:17,270
غاومون، تطوّر

117
00:11:30,490 --> 00:11:32,960
!ميراجغاوغامون

118
00:11:33,300 --> 00:11:34,420
!هيّا بنا

119
00:11:34,420 --> 00:11:35,610
!أجل يا سيّدي

120
00:11:41,680 --> 00:11:43,140
!ناسِف البدر

121
00:11:47,870 --> 00:11:49,770
!شكراً لك يا ميراجغاوغامون

122
00:11:50,140 --> 00:11:50,980
!هيّا بنا

123
00:11:51,290 --> 00:11:51,860
!حسناً

124
00:11:53,690 --> 00:11:55,740
يوشيما-سان! أنا آسف

125
00:11:56,620 --> 00:11:58,100
على ماذا؟

126
00:11:59,280 --> 00:12:00,650
إنّها البداية فقط

127
00:12:02,280 --> 00:12:02,990
أجل

128
00:12:04,680 --> 00:12:06,580
!سراب الهِلال المزدوج

129
00:12:09,880 --> 00:12:12,000
!واظب على ذلك يا ميراجغاوغامون

130
00:12:12,800 --> 00:12:14,280
!اقضِ عليهم

131
00:12:14,280 --> 00:12:15,330
!حاضر سيّدي

132
00:12:18,690 --> 00:12:19,890
إنّهم يتراجعون

133
00:12:38,970 --> 00:12:42,990
لوردنايتمون. ديجيمون بمستوى نهائي
من الفُرسان الملكيّين

134
00:12:42,990 --> 00:12:45,020
،هجمته الخاصّة هي الخوف الفوريّ

135
00:12:45,020 --> 00:12:48,280
موجة اهتزازيّة تُطلَق من المخزن
في ذِراعه الأيمن

136
00:12:52,520 --> 00:12:54,370
فـ... فارس ملكيّ؟

137
00:12:54,910 --> 00:12:56,080
أجل

138
00:12:56,810 --> 00:13:01,800
آذيتم جنودي، والآن يجب أن تدفعوا الثّمن

139
00:13:02,960 --> 00:13:04,760
!هيّا يا ميراجغاوغامون

140
00:13:05,200 --> 00:13:06,800
!حاضر يا سيّدي

141
00:13:07,570 --> 00:13:08,800
!لا تفعلها يا توما

142
00:13:11,570 --> 00:13:13,390
!التنكُّر اللّولبيّ

143
00:13:18,240 --> 00:13:19,260
حمقى

144
00:13:20,190 --> 00:13:21,610
...اللّعنة

145
00:13:21,880 --> 00:13:24,290
يتصرّف بطيش

146
00:13:24,290 --> 00:13:26,570
توقّعت. ثمّة شيء يؤرقه

147
00:13:29,000 --> 00:13:30,560
ضغط الدّم مستقرّ

148
00:13:30,560 --> 00:13:31,310
...طبيب

149
00:13:37,010 --> 00:13:39,300
...أنا... أنا

150
00:13:46,190 --> 00:13:48,640
اجعل توما خليفتك

151
00:13:49,820 --> 00:13:51,350
!ماذا؟

152
00:13:52,210 --> 00:13:55,120
ريلينا ضعيفة جدّاً

153
00:13:55,120 --> 00:14:00,670
بدلاً من ذلك، ابحث عن امرأة
من عائلة مناسبة للزّواج من توما

154
00:14:00,670 --> 00:14:04,310
عائلة لا يستطيع أحد انتقادها

155
00:14:04,310 --> 00:14:05,820
—لكن يا أمّي

156
00:14:07,020 --> 00:14:08,320
هل كلامي واضح؟

157
00:14:11,680 --> 00:14:12,600
...أجل

158
00:14:17,100 --> 00:14:18,210
!سيّد فرانز

159
00:14:18,770 --> 00:14:21,810
نحن مستعدّون للانتقال إلى المحطّة الطّرفيّة

160
00:14:21,810 --> 00:14:23,370
يجب أن ننقل ريلينا-ساما حالاً

161
00:14:24,400 --> 00:14:26,800
!حـ-حسناً. بسرعة إذاً

162
00:14:27,050 --> 00:14:30,570
يجب أن نفعل ذلك مستغلّين
!صرف توما-ساما انتباههم

163
00:14:32,720 --> 00:14:33,760
...توما

164
00:14:40,740 --> 00:14:41,900
!ميراجغاوغامون

165
00:14:45,050 --> 00:14:46,590
!التنكُّر اللّولبيّ

166
00:14:54,870 --> 00:14:55,730
!كاميمون

167
00:14:59,640 --> 00:15:03,710
...أثني على إصراركم

168
00:15:03,710 --> 00:15:07,010
لكن هذا لن يغيّر النّتيجة

169
00:15:07,010 --> 00:15:08,470
!الخوف الفوريّ

170
00:15:14,390 --> 00:15:15,640
!ميراجغاوغامون

171
00:15:21,820 --> 00:15:23,520
!بسرعة

172
00:15:26,930 --> 00:15:27,680
!بسرعة

173
00:15:30,210 --> 00:15:31,340
...أخي

174
00:15:32,700 --> 00:15:35,530
!لا... لا تذهب

175
00:15:35,530 --> 00:15:36,630
!ريلينا-ساما

176
00:15:36,630 --> 00:15:37,830
—عودي إلى سرير

177
00:15:38,810 --> 00:15:39,830
!ريلينا

178
00:15:40,450 --> 00:15:42,660
!أخي

179
00:15:46,750 --> 00:15:47,960
!ريلينا

180
00:16:15,430 --> 00:16:16,530
توما؟

181
00:16:18,050 --> 00:16:19,830
...أخي

182
00:16:20,500 --> 00:16:22,800
!ريلينا... ريلينا

183
00:16:31,350 --> 00:16:36,160
كنتُ... كنتُ مستميتاً

184
00:16:37,460 --> 00:16:42,350
!عملتُ باستماتة لحماية اسم نورشتاين

185
00:16:50,030 --> 00:16:51,200
...أبي

186
00:17:18,700 --> 00:17:19,950
أبي

187
00:17:19,950 --> 00:17:21,480
اعتنِ بريلينا

188
00:17:22,940 --> 00:17:24,100
توما؟

189
00:17:26,200 --> 00:17:28,610
سأحميكما

190
00:17:30,680 --> 00:17:32,780
أقسم بأنّني سأفعل

191
00:17:33,420 --> 00:17:36,240
لن أدعهم يؤذون ريلينا أيضاً

192
00:17:40,730 --> 00:17:42,200
حاضر سيّدي

193
00:17:46,950 --> 00:17:48,330
!لوردنايتمون

194
00:17:48,960 --> 00:17:51,290
!سينتهي طغيانك

195
00:17:51,290 --> 00:17:53,640
...أقسم باسمي كتوما نورشتاين

196
00:17:53,640 --> 00:17:55,050
!بأن أهزمك

197
00:17:55,850 --> 00:17:58,110
تهزمني؟

198
00:17:58,110 --> 00:18:01,550
واضح بأنّك تمزح، لكن مع ذلك
...أشعر بالإهانة

199
00:18:01,550 --> 00:18:04,220
!تستحقُّ مثل هذه الجريمة الموت

200
00:18:09,270 --> 00:18:10,860
!تصدَّى لها؟

201
00:18:22,520 --> 00:18:24,450
!حان الوقت يا ميراجغاوغامون

202
00:18:27,930 --> 00:18:28,710
!شحن

203
00:18:31,110 --> 00:18:33,290
!انفجار الرُّوح الرّقميّة

204
00:18:54,440 --> 00:18:56,230
!ميراجغاوغامون

205
00:18:56,420 --> 00:18:57,950
!وضع الانفجار

206
00:18:59,100 --> 00:19:01,160
وضع الانفجار ميراجغاوغامون

207
00:19:01,160 --> 00:19:05,910
تطوُّر انفجاريّ يفتح الحدود العُليا
من قوّة ميراجغاوغامون

208
00:19:05,910 --> 00:19:08,450
!هجمته الخاصّة هي صدمة نيزك البدر

209
00:19:11,180 --> 00:19:14,500
...هذا

210
00:19:14,750 --> 00:19:16,180
!وضعي الانفجاريّ

211
00:19:18,980 --> 00:19:20,670
خدعة صغيرة سخيفة

212
00:19:21,960 --> 00:19:23,640
!هيّا يا ميراجغاوغامون

213
00:19:23,960 --> 00:19:25,310
!حاضر يا سيّدي

214
00:19:31,620 --> 00:19:33,020
!اِلزم حدودك

215
00:19:35,100 --> 00:19:36,270
...ما-ماذا

216
00:19:40,370 --> 00:19:42,190
!التنكُّر اللّولبيّ

217
00:19:52,180 --> 00:19:54,310
...يـ-يا لها من قوّة

218
00:19:54,960 --> 00:19:57,920
!غادر العالمَ البشريّ يا لوردنايتمون

219
00:19:59,160 --> 00:20:02,150
أتجرؤ وتأمرني؟

220
00:20:02,150 --> 00:20:03,490
!ستدفع الثّمن

221
00:20:03,490 --> 00:20:05,390
!الخوف الفوريّ

222
00:20:05,390 --> 00:20:08,230
!صدمة نيزك البدر

223
00:20:13,560 --> 00:20:15,190
...مـ-مستحيل

224
00:20:38,740 --> 00:20:40,960
فهمت. ستذهب إذاً؟

225
00:20:41,310 --> 00:20:41,990
أجل

226
00:20:42,990 --> 00:20:44,680
هل أنت متأكّد؟

227
00:20:44,680 --> 00:20:48,050
وضع ريلينا مستقرّ. ستكون بخير

228
00:20:48,550 --> 00:20:49,520
لا أقصد ذلك

229
00:20:50,750 --> 00:20:52,060
قصدتُك أنت

230
00:20:52,920 --> 00:20:54,890
هل ستعود إلى هنا سالماً؟

231
00:20:58,500 --> 00:21:00,040
لا تقلق

232
00:21:00,040 --> 00:21:03,260
فأنا من عائلة نورشتاين

233
00:21:05,100 --> 00:21:06,260
فهمت

234
00:21:14,910 --> 00:21:16,360
شكراً لك على كلّ شيء

235
00:21:16,360 --> 00:21:17,790
لا عليك

236
00:21:22,990 --> 00:21:25,110
لنذهب ونساعد ماسارو

237
00:21:25,110 --> 00:21:26,150
!حاضر يا سيّدي

238
00:21:27,420 --> 00:21:30,140
مواجهة الخطر خير من انتظاره
حتّى يأتي إليك؟

239
00:22:48,900 --> 00:22:50,700
!إيكوتو! إنّه فارس ملكيّ

240
00:22:50,700 --> 00:22:52,130
!هذا دافتمون

241
00:22:52,130 --> 00:22:57,050
أيُضحِّي بأكبر قدر مُمكن من الدّيجيمونات
!لإنقاذ العالم الرّقميّ؟

242
00:22:57,050 --> 00:22:59,500
!دافتمون! ما تفعله خاطئ

243
00:22:59,500 --> 00:23:02,110
لا شيء "صائب" في الصّواب
!الّذي تفرضه على الآخرين

244
00:23:02,110 --> 00:23:05,030
!سوف أحمي ديارنا

245
00:23:05,030 --> 00:23:06,860
!هيّا بنا يا فالكومون

246
00:23:06,860 --> 00:23:08,380
:مُنقِذو الدِّيجيمون

247
00:23:08,380 --> 00:23:11,930
!القوّة دائماً على حقّ"
"!الفارس الوحش دافتمون

248
00:23:11,930 --> 00:23:14,580
!تعالي واسكني في قبضتي أيّتها الرُّوح الرّقميّة