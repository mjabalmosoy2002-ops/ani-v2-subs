1
00:00:06,570 --> 00:00:07,940
!هذا لا يصدّق

2
00:00:08,240 --> 00:00:11,230
!لستِ تسوكيميا-سان

3
00:00:13,360 --> 00:00:17,100
أتساءل في أيّ عالم سنلتقي
.المرة القادمة يا تاكيرو-كن

4
00:00:21,340 --> 00:00:23,950
.سترحل تسوكيميا. إلى اللقاء

5
00:00:34,620 --> 00:00:35,430
.سحقًا

6
00:00:35,870 --> 00:00:39,640
ما الذي تورطتُ به؟

7
00:00:42,990 --> 00:00:44,900
.عالم آخر مجددًا

8
00:00:47,830 --> 00:00:49,270
.إنه متهالك

9
00:00:57,570 --> 00:01:00,030
.لا تقلقي. لا تقلقي

10
00:01:02,930 --> 00:01:04,210
.هارياكي

11
00:01:04,490 --> 00:01:06,630
لا، بل تسوكيميا-سان؟

12
00:01:06,630 --> 00:01:07,540
أيّهما؟

13
00:01:07,880 --> 00:01:09,050
هل أنت جاهز؟

14
00:01:09,050 --> 00:01:10,660
.من فضلك

15
00:01:15,090 --> 00:01:16,030
!أنت

16
00:01:16,720 --> 00:01:19,630
.لم أتوقع أن تأتي إلى هذا العالم تاليًا

17
00:01:19,630 --> 00:01:21,180
أنت هارياكي؟

18
00:01:21,180 --> 00:01:23,900
.نعم، لستُ تسوكيميا

19
00:01:25,190 --> 00:01:26,470
.هذا جيد

20
00:01:28,850 --> 00:01:32,780
.شكرًا لك، شكرًا لك

21
00:01:32,780 --> 00:01:35,010
ما الذي تفعله؟

22
00:01:37,820 --> 00:01:44,090
فقد هذا العالم الفوضى المئوية
.وبات دماره محتومًا

23
00:01:45,110 --> 00:01:46,830
.هذه عملية التنجيم

24
00:01:46,830 --> 00:01:51,020
قبل دماره، تُربط مشاعر الجميع
وتجارب العالم

25
00:01:51,020 --> 00:01:53,130
.بالعالم التالي بواسطة هذا الطقس

26
00:01:53,130 --> 00:01:56,330
ألهذا علاقة بتقليص العالم؟

27
00:01:56,330 --> 00:02:02,810
نعم. يعلم المجتمعون هنا كل شيء عن ذلك
.ويريدون موتًا هادئًا

28
00:02:03,970 --> 00:02:04,770
...تقصد

29
00:02:05,030 --> 00:02:08,330
.إنهم يقدّمون أرواحهم

30
00:02:08,330 --> 00:02:10,690
.لتُنقل إلى العالم التالي

31
00:02:11,830 --> 00:02:13,290
!هذا يعني أنك تقتلهم

32
00:02:13,290 --> 00:02:14,450
.من فضلك

33
00:02:14,450 --> 00:02:15,540
!مهلًا

34
00:02:16,710 --> 00:02:18,860
.لا تحاول إيقافي

35
00:02:18,860 --> 00:02:21,340
.شكرًا لك يا سيمي-ساما

36
00:02:21,340 --> 00:02:22,750
.من فضلك

37
00:02:31,230 --> 00:02:32,950
لستَ راضٍ عن هذا؟

38
00:02:32,950 --> 00:02:35,730
.بالطبع لا، إنه مثير للاشمئزاز

39
00:02:35,730 --> 00:02:38,820
:لكن يقول أحد شعارات عائلة ناريهيرا

40
00:02:39,220 --> 00:02:41,930
".بعدد البشر تتعدد المعتقدات"

41
00:02:43,110 --> 00:02:46,890
.أريد سماع القصة كاملة

42
00:02:49,090 --> 00:02:52,810
يا لبساطتك، لكنك مع ذلك تورطتَ
.إلى هذا الحدّ

43
00:02:53,650 --> 00:02:57,250
.حسنًا، سأخبرك بكل شيء

44
00:04:29,180 --> 00:04:30,410
ما هذا المكان؟

45
00:04:30,410 --> 00:04:34,170
شاهد قبر لجميع من ضُحي بهم
.في تقليص العالم

46
00:04:34,870 --> 00:04:39,290
،بدأ كل شيء منذ ألف عام
.العام السادس من عصر جوهي

47
00:04:39,660 --> 00:04:45,340
في الوقت الذي بدأت أُعرف فيه
.كأونميوجي، التقيتُ رجلًا معيّنًا

48
00:04:45,970 --> 00:04:48,290
.اسمه كونيهيتو

49
00:04:51,250 --> 00:04:52,770
!سيمي-ساما

50
00:04:53,050 --> 00:04:54,970
!أبينو سيمي-ساما

51
00:04:57,470 --> 00:04:59,050
ما الذي تفعله؟

52
00:04:59,480 --> 00:05:02,440
.أنت من بدأ هذا

53
00:05:02,440 --> 00:05:04,260
تريدني أن أتوسّط؟

54
00:05:04,260 --> 00:05:05,820
ما الأمر على أيّ حال؟

55
00:05:04,730 --> 00:05:05,810
.نعم

56
00:05:05,810 --> 00:05:07,910
!أفسحوا الطريق

57
00:05:06,260 --> 00:05:08,400
.كأنك لا تعلم

58
00:05:08,400 --> 00:05:12,330
!تسدّان الطريق تتسببان بالمتاعب للآخرين

59
00:05:12,330 --> 00:05:15,540
!أتى كونيهيتو-ساما لتقييدكما

60
00:05:15,540 --> 00:05:18,000
.رئيس الشرطة

61
00:05:18,000 --> 00:05:20,900
!لا تتدخل يا كلب الإمبراطورية

62
00:05:20,900 --> 00:05:23,140
...لا، يبدو أقرب إلى

63
00:05:23,140 --> 00:05:24,670
!قرد

64
00:05:25,720 --> 00:05:27,800
!لا تنعتني بالقرد

65
00:05:28,630 --> 00:05:29,910
!أيها الوغد

66
00:05:30,590 --> 00:05:32,400
!نل منهم

67
00:05:32,400 --> 00:05:33,640
.يا للإزعاج

68
00:05:38,810 --> 00:05:39,880
ما هذا؟

69
00:05:39,880 --> 00:05:41,790
.اهدأ رجاءً

70
00:05:44,170 --> 00:05:46,110
هل أنت ساحر؟

71
00:05:46,110 --> 00:05:48,060
.بل أونميوجي

72
00:05:48,060 --> 00:05:50,010
.أنت تقاوم ببراعة

73
00:05:50,010 --> 00:05:51,580
!لن تفلح هذه السخافة ضدي

74
00:05:51,810 --> 00:05:55,400
!أكثر شيء أكرهه في هذا العالم هو السحر

75
00:05:55,400 --> 00:05:58,100
!إنه غامض وماكر

76
00:05:58,100 --> 00:05:59,540
!لن أستسلم له

77
00:06:00,880 --> 00:06:01,840
!هيّا

78
00:06:01,840 --> 00:06:03,870
!هيّا، قف! أرني بعض الشجاعة

79
00:06:03,870 --> 00:06:05,160
!لا أستطيع

80
00:06:04,130 --> 00:06:05,160
.إنه أحمق

81
00:06:05,160 --> 00:06:05,990
!ترفّق بي

82
00:06:05,990 --> 00:06:07,110
!ابذل جهدًا أكبر

83
00:06:07,110 --> 00:06:12,600
.كان قويًا وبسيطًا مثلك
.أسوء نوع في رأيي

84
00:06:12,600 --> 00:06:15,060
لماذا تسيء إليّ أيضًا؟

85
00:06:15,410 --> 00:06:18,890
.اعتقدتُ أنّه لن تربطني به أيّ صلة بعد ذلك

86
00:06:19,220 --> 00:06:20,520
...لكن

87
00:06:20,970 --> 00:06:26,700
تنبأ أبينو سيمي أننا سنتكبّد أضرارًا جسيمة
.جرّاء الفيضانات بعد عامين

88
00:06:26,700 --> 00:06:31,160
لهذا نريد تجنيد حارسٍ لنهر كامو
.للإشراف على مشروع إدارة الفيضانات

89
00:06:31,160 --> 00:06:34,580
.لكننا قيمنا بصيانة السدّ مؤخرًا فحسب

90
00:06:34,970 --> 00:06:39,050
.طلب منّا وزير اليمين توخّي المزيد من الحذر

91
00:06:39,050 --> 00:06:40,790
والآن، هل سيتطوع أحد منكم؟

92
00:06:41,220 --> 00:06:44,090
.وزير اليمين منحاز لسيمي

93
00:06:44,090 --> 00:06:46,260
.لدنيا الكثير من الأعمال

94
00:06:47,850 --> 00:06:52,470
،فروع المستقبل مثل الشجرة
.تعتمد على ما نفعله

95
00:06:52,830 --> 00:06:55,410
.هذه هي إمكانيات البشرية اللا محدودة

96
00:06:55,410 --> 00:07:01,430
هذه المرة، أظهرت تنبؤاتي وقوع
.العديد من الضحايا من بين احتمالات أخرى

97
00:07:03,670 --> 00:07:08,870
.لا مانع لديّ إن اخترتم جميعًا هذا المستقبل

98
00:07:08,870 --> 00:07:11,160
.إنه مجرد تنبؤ في النهاية

99
00:07:11,160 --> 00:07:15,330
.لكن هناك دائمًا احتمال ضئيل. سأقوم بذلك

100
00:07:16,070 --> 00:07:18,070
.أنت رئيس الشرطة

101
00:07:18,070 --> 00:07:21,040
.بلدتي معرّضة للفيضانات

102
00:07:21,290 --> 00:07:24,310
.أعرف الكثير عن إدارة الفيضانات

103
00:07:24,310 --> 00:07:26,950
.تبدو مناسبًا

104
00:07:26,950 --> 00:07:29,130
!أيها الساحر

105
00:07:29,130 --> 00:07:31,690
.بل أونميوجي

106
00:07:34,060 --> 00:07:38,510
.سأقوم بأمر لا تقدر عليه قواك

107
00:07:38,510 --> 00:07:39,940
!عليك إلقاء نظرة فاحصة

108
00:07:40,900 --> 00:07:42,270
.سأحضر بين الفينة والأخرى إذًا

109
00:07:43,790 --> 00:07:46,860
.وهكذا بدأ عمل إدارة الفيضانات

110
00:07:46,860 --> 00:07:49,620
!اغرزوها بعمق وثبات

111
00:07:49,620 --> 00:07:52,540
.لكن الأمور سارت بسلاسة في البداية فحسب

112
00:07:54,150 --> 00:07:55,030
!زلزال

113
00:07:58,490 --> 00:07:59,700
هل أنت بخير؟

114
00:08:00,450 --> 00:08:03,430
.زلزال؟ لم يرد هذا في تنبؤاتي

115
00:08:03,430 --> 00:08:05,370
!مهلًا، سنخرجك

116
00:08:05,370 --> 00:08:08,900
.تعرضنا لسلسلة من الحوادث والكوارث الطبيعية غير المتوقعة

117
00:08:08,900 --> 00:08:10,880
.وتوقف العمل أكثر من مرة

118
00:08:11,620 --> 00:08:13,840
.لم تتغيّر النتيجة مهما غيّرنا من نهجنا

119
00:08:14,970 --> 00:08:19,310
.حاولتُ التنبؤ بالمستقبل لتوضيح الأمور

120
00:08:19,310 --> 00:08:25,270
،ثماني بوابات في السماء، تقود لثمانية رياح
،وإن كانت هناك ثمانية طرق في الأرض

121
00:08:25,710 --> 00:08:27,480
!فهذا يعني ثماني ثلاثيات أحرف

122
00:08:37,420 --> 00:08:38,910
ما الذي يحدث؟

123
00:08:44,350 --> 00:08:46,430
.أدركت مع الوقت

124
00:08:47,330 --> 00:08:51,800
...المستقبل الذي تنبأتُ به
.كان ضرر الفيضان الكبير ثابتًا في مكانه

125
00:08:52,570 --> 00:08:55,010
،مهما فعلنا أو كيفما حاولنا الاستعداد

126
00:08:55,310 --> 00:08:57,580
.كان أمرًا محتومًا

127
00:08:59,750 --> 00:09:01,850
!كفاك مزاحًا

128
00:09:03,310 --> 00:09:05,690
أتقول أن كل هذا لا طائل منه؟

129
00:09:06,230 --> 00:09:09,400
.هذا صحيح. هذا المستقبل ثابت في مكانه

130
00:09:09,690 --> 00:09:12,820
سيحدث ضرر شديد جرّاء الفيضان
!مهما فعلنا

131
00:09:13,090 --> 00:09:14,400
!تبًا لك

132
00:09:14,680 --> 00:09:19,730
!ظننتُ أن للبشرية إمكانيات لا محدودة أيها الساحر

133
00:09:22,020 --> 00:09:24,540
كم مرة عليّ قول ذلك يا رئيس الشرطة؟

134
00:09:24,540 --> 00:09:27,500
!أنا أونميوجي

135
00:09:29,620 --> 00:09:32,590
!جرّبتُ كل تقنية أونميو أعرفها

136
00:09:32,590 --> 00:09:36,840
!لكن كل مستقبل يقود إلى ضرر الفيضان

137
00:09:37,060 --> 00:09:39,310
هل ستستسلم إذًا؟

138
00:09:39,310 --> 00:09:41,320
!أنت لا تعرف كل شيء

139
00:09:43,180 --> 00:09:45,710
ما الذي تعرفه بفضل قواك الماكرة؟

140
00:09:45,710 --> 00:09:51,320
المستقبل أمر تصادفه فتعرفه
!ثم تواجهه بشجاعة بينما تمضي قدمًا

141
00:09:51,320 --> 00:09:54,550
!هذا صحيح! هكذا يجب أن يكون المستقبل

142
00:09:54,550 --> 00:09:57,150
!لكن هذه المرة مختلفة

143
00:09:57,570 --> 00:10:04,370
،بغضّ النظر عن مدى كرهك لتقنيات الأونميو
!ذلك هو العالم الذي أراه بقوتي

144
00:10:06,010 --> 00:10:12,180
عليك تغيير المستقبل في ذلك العالم
!الذي تراه إذًا

145
00:10:12,180 --> 00:10:14,550
.سأفعل ذلك بطريقتي

146
00:10:15,760 --> 00:10:19,260
!لا يوجد مستقبل لا يمكنك تغييره بنفسك

147
00:10:23,470 --> 00:10:29,460
،وهكذا استمرّ العمل وقبل أن أدرك ذلك
.شاركتُ في العمل بنفسي

148
00:10:30,340 --> 00:10:35,950
مثل كونيهيتو، أردتُ أيضًا أن أكافح
.ضد مستقبل محتوم

149
00:10:38,910 --> 00:10:41,910
!ما رأيك أيها الساحر؟ لقد اكتمل

150
00:10:42,860 --> 00:10:45,130
.عمل ممتاز يا رئيس الشرطة

151
00:10:45,750 --> 00:10:47,970
.لم تتغيّر الأمور بعد إذًا

152
00:10:48,650 --> 00:10:51,210
.أنوي عدم الاستسلام

153
00:10:51,210 --> 00:10:52,170
!أجل

154
00:10:52,410 --> 00:10:55,290
.بذلتَ جهدًا في إقامة هذا السدّ أيضًا

155
00:10:55,700 --> 00:10:57,960
!ستكون الأمور على ما يرام بالتأكيد

156
00:11:06,340 --> 00:11:11,290
انهمر المطر لثلاثة أيام بلياليها
.وهاج النهر

157
00:11:11,810 --> 00:11:15,980
لكن السدّ أدّى وظيفته
.ويُحدث الفيضان أيّ ضرر

158
00:11:16,310 --> 00:11:18,440
.ثم حلّ اليوم

159
00:11:23,660 --> 00:11:25,790
هل يواجه أحدكم مشكلة؟

160
00:11:26,900 --> 00:11:28,590
.مرحبًا يا كونيهيتو

161
00:11:27,500 --> 00:11:29,870
.يتسرّب الماء من السقف بشدّة، لكن هذا كل شيء

162
00:11:30,090 --> 00:11:32,750
.ذلك بفضل السدّ الذي شيّدته

163
00:11:33,930 --> 00:11:35,490
.كان ذلك سهلًا

164
00:11:38,210 --> 00:11:40,480
.ظهرت الشمس

165
00:11:40,480 --> 00:11:43,550
.انتصرنا هذه المرة أيها الساحر

166
00:11:47,660 --> 00:11:49,470
.تجاوزنا هذا بسلام

167
00:11:49,740 --> 00:11:52,030
.نعم، هذا صحيح

168
00:11:55,140 --> 00:11:56,900
ما تلك الأشياء؟

169
00:12:20,730 --> 00:12:22,340
ما الذي حدث؟

170
00:12:24,190 --> 00:12:25,050
.أخلوا المكان

171
00:12:25,420 --> 00:12:27,010
!بسرعة! اهربوا

172
00:12:28,720 --> 00:12:31,860
!مستقبل محتوم؟ ليس وأنا موجود

173
00:12:34,050 --> 00:12:35,900
!احترسي

174
00:12:49,010 --> 00:12:50,080
الساحر؟

175
00:12:51,090 --> 00:12:52,180
ماذا عن الطفلة؟

176
00:12:52,530 --> 00:12:53,540
.إنها بأمان

177
00:12:53,870 --> 00:12:55,270
.حسنًا

178
00:12:56,340 --> 00:13:01,510
.لكن يبدو أن حتى السحر لا يستطيع إنقاذي

179
00:13:04,300 --> 00:13:05,460
.أنا آسف

180
00:13:06,460 --> 00:13:08,210
لماذا تعتذر؟

181
00:13:09,180 --> 00:13:12,770
.عرفتُ مستقبلك

182
00:13:15,390 --> 00:13:17,530
.كان السدّ مثاليًا

183
00:13:18,250 --> 00:13:20,650
!اعتقدتُ أنك غيّرتَ المستقبل

184
00:13:21,790 --> 00:13:22,780
...مع ذلك

185
00:13:23,240 --> 00:13:24,380
لماذا حدث هذا؟

186
00:13:24,380 --> 00:13:26,670
!أُعيدت هذه النتيجة قسرًا إلى مكانها

187
00:13:26,670 --> 00:13:31,580
،متأكد أنك ستضحك على هذا
!لكن كل ما يسعني استنتاجه هو أن قوانين العالم قد أعيدت صياغتها

188
00:13:31,810 --> 00:13:34,970
!أغلق الباب في وجه إمكانيات البشرية اللا محدودة

189
00:13:36,410 --> 00:13:38,060
.لن أضحك

190
00:13:39,430 --> 00:13:41,810
.سأستمر في قول هذا

191
00:13:42,500 --> 00:13:49,550
.ليس هناك مستقبل لا يمكنك تغييره بنفسك"
".لذا اغرب عن وجهي

192
00:13:50,470 --> 00:13:52,710
.كفاك حزنًا

193
00:13:52,710 --> 00:13:55,620
ستقوم بأمر ما حيال هذا، صحيح؟

194
00:13:56,350 --> 00:14:02,980
...استخدم قواك الماكرة تلك
.للقيام بأمر ما حيال تغيّر قوانين العالم تلك

195
00:14:03,790 --> 00:14:08,570
متأكد أن ستصنع المستقبل
.الذي تتخيله

196
00:14:09,270 --> 00:14:12,210
أليس كذلك يا سيمي؟

197
00:14:18,630 --> 00:14:20,420
.نعم، أنت محق

198
00:14:22,180 --> 00:14:23,290
...كونيهيتو

199
00:14:27,310 --> 00:14:32,450
بعد ذلك، اكشتفتُ عدة حالات أخرى
،أصلح فيها المستقبل

200
00:14:32,450 --> 00:14:33,970
.لكنني لم أعرف السبب

201
00:14:34,590 --> 00:14:38,940
.لكن خلال بحثي، اكتشفتُ أمرًا آخر

202
00:14:43,840 --> 00:14:48,780
.بعبارة أخرى، طريقة صنع عوالم موازية

203
00:14:51,190 --> 00:14:56,120
نجحتُ في النهاية في صنع
.مائة عالم موازي

204
00:14:56,120 --> 00:15:02,340
الثمن الذي دفعته لارتكابي ذلك الفعل المحظور
،هو فقداني القدرة على التقدّم بالعمر أو الموت

205
00:15:02,340 --> 00:15:05,170
.لكنه لم يكن أمرًا سيئًا بالنظر إلى الأمور

206
00:15:05,980 --> 00:15:10,820
،وهكذا استمرّ تطور العالم الموازية المائة

207
00:15:10,820 --> 00:15:14,490
.وبدا كأن إمكانيات العالم قد ارتفعت

208
00:15:14,490 --> 00:15:21,690
،لكن بعد مرور خمس سنوات
.بدأ انهيار جميع العوالم فجأة

209
00:15:21,690 --> 00:15:25,610
تطلب الحفاظ على أحدها فقط
،بذلي أقصى ما لديّ من جهد

210
00:15:25,610 --> 00:15:28,810
.لكننا فقدنا عشرات الملايين من الأرواح

211
00:15:29,730 --> 00:15:33,200
.مع ذلك، لم أستطع الاستسلام كليًا

212
00:15:33,610 --> 00:15:38,140
استخدمتُ العالم المتبقي
.لصنع مائة عالم موازي مرة أخرى

213
00:15:38,140 --> 00:15:41,140
.لكن بعد خمس سنوات، كانت النتيجة نفسها

214
00:15:41,580 --> 00:15:47,630
.أدركتُ أن انهيار العوالم الموازية محتوم

215
00:15:48,030 --> 00:15:49,970
.كارثة القتاء مسارات العالم

216
00:15:50,340 --> 00:15:52,300
.هذا ما أطلقته عليها

217
00:15:52,680 --> 00:15:54,640
.هذا دليل وحيد

218
00:15:54,640 --> 00:16:00,090
ريش أبيض وضوء غامض
.يظهران دائمًا قبل الانهيار

219
00:16:00,090 --> 00:16:05,310
خمّنتُ أن هناك كيانًا يقف
.وراء هذه الظاهرة

220
00:16:05,310 --> 00:16:08,820
.فكرتُ في طريقة للهرب منها

221
00:16:08,820 --> 00:16:12,430
،إن لم أستطع منع اندثار 99 بالمائة منها

222
00:16:12,430 --> 00:16:16,260
.كنتُ أورّث تقنيات تلك العوالم قبل دمارها

223
00:16:17,210 --> 00:16:19,140
.وكان ذلك تقليص العالم

224
00:16:19,740 --> 00:16:20,540
.نعم

225
00:16:21,410 --> 00:16:24,700
.وصارت النتائج واضحة قليلًا في كل مرة

226
00:16:24,700 --> 00:16:29,500
،دامت العوالم الموازية في النهاية أكثر
.على أن تصل المدة إلى مائة عام كحدّ أقصى

227
00:16:29,810 --> 00:16:33,800
.صنعت الفوضى المئوية بناءً على ذلك

228
00:16:34,310 --> 00:16:38,410
.هذا كل ما أستطيع شرحه

229
00:16:39,060 --> 00:16:40,580
.لا أطيق هذا

230
00:16:40,580 --> 00:16:42,000
...لم أتوقع أنك

231
00:16:42,000 --> 00:16:42,890
!لا

232
00:16:42,890 --> 00:16:46,480
أقصد لماذا تتحمّل عبءًا ثقيلًا كهذا وحدك؟

233
00:16:46,770 --> 00:16:48,380
!اعتمد على الآخرين

234
00:16:48,380 --> 00:16:51,580
!لديك كل أولئك الأونميوجي

235
00:16:52,020 --> 00:16:54,030
...توقع استيعابهم هو أمر

236
00:16:54,030 --> 00:16:57,950
!أخبرهم أيها الغبيّ
!أخبرهم مباشرة

237
00:16:58,990 --> 00:17:03,460
،إنه أمر تصادفه فتعرفه
!ثم تواجهه بشجاعة بينما تمضي قدمًا

238
00:17:05,110 --> 00:17:09,170
لا، ما زلت غير قادر
.على إثقال كاهلهم بكل هذا الجنون

239
00:17:12,110 --> 00:17:14,530
لماذا أخبرتني إذًا؟

240
00:17:15,090 --> 00:17:18,470
.لأنني وصلت إليه من خلالك

241
00:17:19,110 --> 00:17:21,560
جزء من الكيان الذي أفلت منّي
.طيلة ألف عام

242
00:17:21,560 --> 00:17:25,810
الكيان الذي يتسبب بكارثة
.التقاء مسارات العالم

243
00:17:26,980 --> 00:17:30,020
.قد أبلغه بقوتك

244
00:17:30,020 --> 00:17:35,490
ذلك الكيان الذي يرسّخ المستقبل
.ويستمرّ في قصّ فروع الإمكانيات

245
00:17:35,490 --> 00:17:37,070
.ناريهيرا تاكيرو

246
00:17:39,190 --> 00:17:41,670
.أرجوك أن تعيرني قوتك

247
00:17:42,410 --> 00:17:44,370
!ساعدني في معركتي

248
00:17:44,370 --> 00:17:47,590
!أنت تربكني

249
00:17:48,290 --> 00:17:51,710
عمومًا، ما ذلك الكيان؟ وحش؟

250
00:17:51,950 --> 00:17:54,420
.يُدعى طائر الزمن العظيم

251
00:17:56,310 --> 00:17:59,430
إنه الكيان الذي يسبب
.كارثة التقاء مسارات العالم

252
00:17:59,820 --> 00:18:02,590
.صنعته على القمر في المستقبل

253
00:18:02,590 --> 00:18:04,640
.أحسنت يا سيمي-ساما

254
00:18:05,510 --> 00:18:07,850
.حُلّ لغز الألفية خاصتك

255
00:18:08,190 --> 00:18:09,940
ما الذي تنوين فعله؟

256
00:18:11,370 --> 00:18:14,280
.لا أعتقد أن عليّ كشف ذلك بسهولة

257
00:18:14,280 --> 00:18:16,440
من أمازح؟

258
00:18:16,440 --> 00:18:23,400
يستطيع طائر الزمن تدمير أيّ مستقبل
.قد يتعرّض خلاله للهجوم

259
00:18:23,400 --> 00:18:26,080
تدمير المستقبل؟

260
00:18:26,910 --> 00:18:30,740
بعبارة أخرى، في النقطة الزمنية
،التي أطلعتك فيها على اسمه

261
00:18:30,740 --> 00:18:35,140
ارتفعت احتمالية مهاجمتك
.لطائر الزمن العظيم

262
00:18:35,140 --> 00:18:40,740
لهذا صارت دينجي هيّان-كيو هذه
.هدفًا يجب تدميره

263
00:18:43,850 --> 00:18:45,390
!ها هو ذا

264
00:18:45,390 --> 00:18:46,470
ريش؟

265
00:18:46,470 --> 00:18:48,170
.ها قد بدأ

266
00:18:53,450 --> 00:18:58,580
هكذا تُمحى مسارات العالم
.التي قد تشكل خطرًا على المستقبل

267
00:18:59,110 --> 00:19:00,170
!أيتها الحقيرة

268
00:19:00,170 --> 00:19:01,160
.بالمناسبة

269
00:19:01,510 --> 00:19:06,330
أيّ شيء تبتلعه أشعة الليزر هذه
.لا يُمكن توريثه للعالم التالي

270
00:19:07,300 --> 00:19:08,710
.تاكيرو-كن

271
00:19:08,710 --> 00:19:10,700
.تعالَ للهو معي

272
00:19:10,700 --> 00:19:15,770
عشت آلاف الحيوات
،خلال ألف عام الماضية

273
00:19:15,770 --> 00:19:20,970
وسأعلمك كيف تعيش حياة
.دينجي هيّان-كيو الأكثر إثارة

274
00:19:22,970 --> 00:19:24,550
...تسوكيميا-سان

275
00:19:26,310 --> 00:19:27,830
ألا يمكنك اتخاذ القرار؟

276
00:19:27,830 --> 00:19:32,630
.لا تنسَ أنه قاتل جماعيّ

277
00:19:39,750 --> 00:19:41,280
.يثير هذا اشمئزازي

278
00:19:41,280 --> 00:19:42,890
!رائع

279
00:19:42,890 --> 00:19:44,490
...لكن

280
00:19:44,890 --> 00:19:46,660
!سأعبرنا متساويين للوقت الراهن

281
00:19:47,690 --> 00:19:51,540
:يقول أحد شعارات عائلة ناريهيرا
"!لا تتجاهل صديقًا وقت الضيق"

282
00:19:52,190 --> 00:19:53,170
صديق؟

283
00:19:53,170 --> 00:19:55,470
.أصبحنا صديقين بعد قتالنا رجلًا لرجل

284
00:19:56,250 --> 00:19:58,110
.لننهِ تقليص العالم

285
00:19:59,690 --> 00:20:03,970
لستُ متأكدًا ما إن كنّا نملك
.حتى احتمال واحد بالمائة في الفوز

286
00:20:03,970 --> 00:20:08,880
ألم تكن تراهن على ذلك الاحتمال
طوال ألف عام؟

287
00:20:08,880 --> 00:20:12,310
!ليس هناك مستقبل لا يمكنك تغييره بنفسك

288
00:20:19,570 --> 00:20:22,980
.لا يروقني هذا الجانب من شخصيته يا تاكيرو-كن

289
00:20:22,980 --> 00:20:26,580
لماذا صرت تتصرفين هكذا يا تسوكيميا-سان؟

290
00:20:27,770 --> 00:20:29,660
.هذه طبيعتي منذ البداية

291
00:20:30,890 --> 00:20:31,830
.أيًا يكن

292
00:20:37,340 --> 00:20:38,800
سنُمحى؟

293
00:20:39,050 --> 00:20:40,300
!هارياكي

294
00:20:41,910 --> 00:20:43,050
هل أنت متأكد؟

295
00:20:43,050 --> 00:20:44,160
!افعلها

296
00:20:44,160 --> 00:20:46,510
.العالم التالي هو آخر عالم متبقي

297
00:20:46,790 --> 00:20:48,230
!ناريهيرا تاكيرو

298
00:20:48,810 --> 00:20:50,220
!المستقبل

299
00:20:51,850 --> 00:20:54,270
!نعم. سأغيّره

300
00:22:33,280 --> 00:22:35,910
هل أنت بخير؟

301
00:22:38,210 --> 00:22:40,710
!يا سكان دينجي هيّان-كيو

302
00:22:42,930 --> 00:22:46,380
!ستوقف منقذتكم كل هذا

303
00:22:46,380 --> 00:22:49,300
!بهزيمة أبينو سيمي الملعون

304
00:22:49,300 --> 00:22:54,850
!تسوكيميا! تسوكيميا! تسوكيميا

305
00:22:52,440 --> 00:22:54,260
ما الذي يحدث؟