605
00:49:56,470 --> 00:49:57,690
.أيّها الوغد

606
00:50:00,060 --> 00:50:01,100
.ضعيف

607
00:50:02,720 --> 00:50:03,860
—إدغـ

608
00:50:05,360 --> 00:50:06,620
.ضعيفة جدًّا

609
00:50:21,020 --> 00:50:22,220
مُرفرِف؟

610
00:50:32,650 --> 00:50:34,760
!مُرفرِف... مُرفرِف

611
00:50:42,270 --> 00:50:45,060
...ليز-سان... إدغار-سان

612
00:50:51,100 --> 00:50:52,930
...كاسومي

613
00:50:54,190 --> 00:50:56,370
...اهربي يا كاسومي-سان

614
00:50:59,210 --> 00:51:01,790
أتلك هي بالفعل؟

615
00:51:01,790 --> 00:51:04,620
.كلّ ما علينا هو التّأكّد من الأمر

616
00:51:05,220 --> 00:51:05,870
.اهرب

617
00:51:15,630 --> 00:51:17,360
.ضعيفة جدًّا

618
00:51:17,360 --> 00:51:18,720
.تقليد رديء

619
00:51:20,270 --> 00:51:23,140
!هذا مؤلم... مؤلم

620
00:51:24,590 --> 00:51:27,410
!هذا مؤلم! هذا مؤلم

621
00:51:27,410 --> 00:51:29,730
...مؤلم؟ مؤلم

622
00:51:30,720 --> 00:51:35,390
...مؤلم! هذا مؤلم، مؤلم

623
00:51:39,670 --> 00:51:40,750
...تلك الفتاة

624
00:51:42,520 --> 00:51:45,630
!أمّي

625
00:51:45,630 --> 00:51:46,760
!النّجدة

626
00:51:47,660 --> 00:51:50,220
!لا، لا

627
00:51:49,220 --> 00:51:52,510
...أنا أموت! أموت! أموت

628
00:51:52,510 --> 00:51:54,480
.أنا أموت! لا أريد الموت

629
00:51:54,480 --> 00:51:56,200
!لا أريد الموت. كلاّ

630
00:51:56,200 --> 00:51:58,570
!كلاّ! لا

631
00:51:59,700 --> 00:52:02,000
!سأعيش! سأعيش

632
00:52:02,000 --> 00:52:03,450
...أريد أن أعيش

633
00:52:03,450 --> 00:52:04,810
!أريد أن أعيش

634
00:52:04,810 --> 00:52:08,510
!سأعيش، سأعيش، سأعيش

635
00:52:08,510 --> 00:52:11,040
كاسومي...؟

636
00:52:13,770 --> 00:52:15,280
...أريد أن أعيش

637
00:52:15,490 --> 00:52:18,380
!أريد مواصلة العيش

638
00:52:20,480 --> 00:52:21,740
ماذا؟

639
00:52:22,160 --> 00:52:23,240
ما هذا؟

640
00:52:23,690 --> 00:52:26,000
ما هذه القوّة؟

641
00:52:41,980 --> 00:52:43,090
...ذلك السّاحر

642
00:52:43,090 --> 00:52:47,280
...سأعيش، سأعيش، سأعيش

643
00:52:47,840 --> 00:52:49,950
!أريد مواصلة العيش

644
00:53:08,440 --> 00:53:09,340
...ما

645
00:53:09,340 --> 00:53:10,360
هو هذا؟

646
00:53:16,890 --> 00:53:19,640
.دمّرت سحرة الظّلام في لمح البصر

647
00:53:19,640 --> 00:53:22,800
أهذه قوّة تلك الفتاة؟

648
00:53:24,440 --> 00:53:29,710
هل استدعت كاسومي ساحر النّور لإبعاد الظّلمة؟

649
00:53:29,710 --> 00:53:32,270
.لا بدّ أنّها قوّة كاسومي-سان

650
00:53:32,930 --> 00:53:37,360
.كاسومي-سان خيميائيّة نور

651
00:53:41,910 --> 00:53:44,260
.يبدو أنّ علينا التّراجع

652
00:53:55,530 --> 00:53:56,010
!كاسومي

653
00:53:56,010 --> 00:53:56,800
!كاسومي-سان

654
00:54:09,230 --> 00:54:10,690
.لقد اختفى

655
00:54:11,800 --> 00:54:14,190
تلك الفتاة هي الطّيف الأسطوريّ؟

656
00:54:14,190 --> 00:54:16,320
أقوى الأطياف؟

657
00:54:16,320 --> 00:54:18,060
.الطّيف الّذي يُبعد الظّلمة

658
00:54:18,680 --> 00:54:21,040
!الطّيف الأعظم

659
00:54:21,700 --> 00:54:23,040
...كاسومي-سان

660
00:54:32,080 --> 00:54:33,320
...تلك الفتاة

661
00:54:33,320 --> 00:54:35,560
.لقد لمست عقولنا

662
00:54:35,560 --> 00:54:40,030
.يبدو أنّ دسترولورك لم يخطئ بخشيته منها

663
00:54:40,030 --> 00:54:42,790
.يجب القضاء على التّهديدات

664
00:54:53,040 --> 00:54:55,560
تريدون من كاسومي أن تقاتل دسترولورك؟

665
00:54:55,850 --> 00:54:59,280
.إنّها الطّيف الّذي يُبعد الظّلمة بلا أدنى شكّ

666
00:54:59,800 --> 00:55:05,740
.لقد ضاعفت قوّة نورها باستعمال السّاحر الّتي استدعته

667
00:55:06,330 --> 00:55:10,700
لكنّها كانت متعمّقة كثيرًا في تلك اللّحظة
.لدرجة أنّها لا تتذكّر الكثير منها

668
00:55:11,460 --> 00:55:14,510
.لا يبدو أنّ بإمكانها السّيطرة على قوّتها أيضًا

669
00:55:15,540 --> 00:55:18,200
.لكن على هذا الحال، سيُدمّر العالم

670
00:55:18,200 --> 00:55:23,300
تكاد تنفد منّا كبسولات الخيمياء
.بعد معركة البارحة

671
00:55:23,300 --> 00:55:25,030
.لا خيار آخر أمامنا

672
00:55:25,030 --> 00:55:28,670
.جعل كاسومي تقاتل هو خيارنا الوحيد

673
00:55:32,320 --> 00:55:33,730
.أنا آسفة

674
00:55:33,730 --> 00:55:36,480
...أعلم أنّه طلب غير معقول، ولكن

675
00:55:37,530 --> 00:55:41,740
،لا أدري إن كنتُ أملك تلك القوّة بالفعل

676
00:55:43,140 --> 00:55:45,450
.لكنّني سأفعل كلّ ما بوسعي

677
00:55:53,200 --> 00:55:55,420
.أسرعي يا مجموعة المؤن

678
00:55:55,420 --> 00:55:57,910
.اجمعوا كلّ ما تقدرون عليه من كبسولات الخيمياء

679
00:56:02,870 --> 00:56:05,440
.سنلتقي بحلفائنا في مكان آخر

680
00:56:06,060 --> 00:56:07,280
.خذي

681
00:56:07,280 --> 00:56:10,570
.إنّه المحفّز الّذي استعملتُه عند استدعائك

682
00:56:10,570 --> 00:56:13,130
بإمكانك استعماله كبديل
.لدبّوس الشّعر الّذي فقدتِه

683
00:56:13,950 --> 00:56:15,640
.شكرًا لك

684
00:56:20,350 --> 00:56:22,250
.ممتاز. يبدو رائعًا عليك

685
00:56:24,680 --> 00:56:26,360
ماذا عن القرويّين؟

686
00:56:26,360 --> 00:56:30,720
،بما أنّ هذا المكان قد اكتُشف
.سيخلون القرية إلى مخزن خفيّ قريب

687
00:56:34,530 --> 00:56:36,950
أتيتم لتوديعنا؟

688
00:56:36,950 --> 00:56:39,620
هل ستذهبون لهزيمة الأشرار؟

689
00:56:43,410 --> 00:56:46,480
.نعم، هذا وعد

690
00:56:46,480 --> 00:56:50,050
.لن تعيشوا تجربة مخيفة كهذه ثانية

691
00:56:51,030 --> 00:56:52,790
.هذا ممتاز

692
00:56:53,240 --> 00:56:54,870
...استعداد

693
00:56:57,160 --> 00:56:59,120
.جمعناها كلّها

694
00:56:59,120 --> 00:57:00,470
.إنّها من أجلك

695
00:57:00,470 --> 00:57:01,400
.لقد جمعناها

696
00:57:01,400 --> 00:57:02,690
.جمعنا كلّ هذه

697
00:57:02,690 --> 00:57:04,890
.إنّها مرّة قليلاً، لكنّها ستُبهجك

698
00:57:06,620 --> 00:57:08,110
.شكرًا لكم

699
00:57:08,510 --> 00:57:10,090
.شكرًا لكم جميعًا

700
00:57:12,120 --> 00:57:14,010
.كاسومي، حظًّا سعيدًا

701
00:57:14,010 --> 00:57:15,520
.حظًّا سعيدًا، حظًّا سعيدًا

702
00:57:15,520 --> 00:57:18,000
.اهزمي سحرة الظّلام أولئك

703
00:57:18,000 --> 00:57:19,630
.كوني حذرة

704
00:57:19,630 --> 00:57:21,790
.شكرًا لكم

705
00:57:22,460 --> 00:57:24,840
.سأبذل جهدي من أجلكم

706
00:57:26,500 --> 00:57:31,210
ليس عليك تقديم وعود بإهمال هكذا
.وأنت تجهلين إن كنتِ ستفين بها

707
00:58:10,240 --> 00:58:11,130
.هذا مؤلم

708
00:58:12,360 --> 00:58:13,690
ما الخطب؟

709
00:58:14,090 --> 00:58:15,690
.لا شيء

710
00:58:15,690 --> 00:58:16,870
.دعني ألقي نظرة

711
00:58:17,260 --> 00:58:18,470
.هذا مؤلم

712
00:58:19,160 --> 00:58:20,840
أهذه إصابة من المعركة؟

713
00:58:20,840 --> 00:58:22,730
.هذا لا شيء

714
00:58:23,080 --> 00:58:26,240
.بإمكاننا علاج هذا بسهولة لو كنّا نملك سحرنا

715
00:58:29,920 --> 00:58:31,400
ثمّة شيء ما يناديني؟

716
00:58:46,940 --> 00:58:48,280
كيف تشعر؟

717
00:58:48,280 --> 00:58:51,320
.خفّ الألم قليلاً

718
00:58:51,320 --> 00:58:53,880
فعلاً؟ هل كنتِ تعرفين بأمر هذه النّباتات الطّبّيّة؟

719
00:58:53,880 --> 00:58:56,150
.لا، على الإطلاق

720
00:58:56,150 --> 00:58:57,820
كيف عرفتِ إذًا؟

721
00:58:57,820 --> 00:59:02,860
.شعرتُ أنّ الزّهور تنظر لإصابة إدغار-سان

722
00:59:03,080 --> 00:59:05,000
كانت الزّهور تنظر لإصابتي؟

723
00:59:05,000 --> 00:59:06,810
فعلاً؟

724
00:59:09,440 --> 00:59:14,080
زاين والبقيّة أطياف، صحيح؟

725
00:59:14,080 --> 00:59:18,390
نعم. إنّهم محاربون عظماء
.من زمن هجوم الملك الأسد

726
00:59:19,040 --> 00:59:23,440
،اعتاد إدغار-سان استدعاء زاين-سان

727
00:59:23,440 --> 00:59:29,040
،لكنّ بما أنّ دسترولورك يستدعيه الآن
.فأظنّه قد خسر جوهره الحقيقيّ

728
00:59:29,540 --> 00:59:34,130
هل سيعودون ثانية بمجرّد تدمير دسترولورك؟

729
00:59:34,130 --> 00:59:36,330
.نعم، على الأرجح

730
00:59:39,910 --> 00:59:41,310
هل من خطب ما؟

731
00:59:42,750 --> 00:59:45,070
.إنّ طبخ الأرض لذيذ للغاية

732
00:59:45,340 --> 00:59:46,860
.سرّني أنّه أعجبك

733
00:59:46,860 --> 00:59:51,160
أخبرتني أمّي ألاّ أطبخ بما
.أنّ خرقاء في تصرّفاتي

734
00:59:51,160 --> 00:59:53,540
.لا بدّ أنّ أمّك قلقة كثيرًا

735
00:59:55,070 --> 00:59:59,640
قالت أنّها لا تتحمّل مشاهدتي
.بسبب عدم براعتي في فعل أيّ شيء

736
01:00:01,320 --> 01:00:05,830
.إنّني خرقاء للغاية لدرجة أنّه حتّى أنا لا أطيق ذلك

737
01:00:05,830 --> 01:00:10,660
تُخبرني دائمًا ألاّ أقوم بأكثر ما أحتاجه
.بما أنّني لا أبرع في أيّ شيء

738
01:00:11,080 --> 01:00:14,120
.بإمكانك فعل ما هو أكثر من لا شيء

739
01:00:14,120 --> 01:00:17,130
.تمّ اختيارك لتقاتلي دسترولورك

740
01:00:18,160 --> 01:00:20,590
.سيكون نجاحك في ذلك أكثر من كافٍ

741
01:00:21,800 --> 01:00:23,200
...إدغار-سان

742
01:00:23,610 --> 01:00:25,260
.شكرًا على الطّعام

743
01:00:27,450 --> 01:00:31,270
فيما عدا الطّبخ، هل فعلتِ
أيّ شيء آخر على الأرض؟

744
01:00:33,520 --> 01:00:36,530
.أحببتُ التّمثيل عندما كنت طفلة

745
01:00:36,530 --> 01:00:39,610
ماذا؟ كنتِ ممثّلة يا كاسومي-سان؟

746
01:00:39,610 --> 01:00:41,580
هـ-هل كنتِ مشهورة؟

747
01:00:42,110 --> 01:00:46,780
.كـ-كلاّ. إنّها مجرّد لعبة طفولة

748
01:00:46,780 --> 01:00:49,230
كنتُ أحبّ تمثيل القصص

749
01:00:49,230 --> 01:00:52,760
في يوم أولياء الأمور في الحضانة
.أو في حديقة الحيّ

750
01:01:01,210 --> 01:01:02,970
.هذا مذهل

751
01:01:03,300 --> 01:01:07,840
.آن الأوان لهزيمة التّنّين الشّرّير واستعادة أملنا

752
01:01:08,220 --> 01:01:10,150
.سأكرّس حياتي للعالم

753
01:01:10,400 --> 01:01:13,020
!كلاّ، من أجل الجميع

754
01:01:24,570 --> 01:01:27,130
.بقيت فاقدة للوعي لأيّام

755
01:01:28,810 --> 01:01:30,620
.ثمّ توقّفتُ بعد ذلك

756
01:01:30,620 --> 01:01:32,140
ماذا؟ لماذا؟

757
01:01:33,000 --> 01:01:36,000
.لم أرد أن أقلق أمّي

758
01:01:37,220 --> 01:01:39,320
هل أخبرتك أمّك بالتّوقّف؟

759
01:01:39,320 --> 01:01:42,060
.قالت أنّ الدّراسة ستكون أفضل لمستقبلي

760
01:01:43,880 --> 01:01:46,650
هل أنت واثقة أنّك لا تريدين التّمثيل بالفعل؟

761
01:01:47,290 --> 01:01:48,720
لماذا لا تتحدّثي معها؟

762
01:01:48,720 --> 01:01:50,680
.واثقة أنّها ستتفهّم الأمر

763
01:01:50,680 --> 01:01:53,100
.فقبل كلّ شيء، تظلّ أمّك

764
01:01:53,100 --> 01:01:56,880
.حدث هذا عندما كنتُ طفلة صغيرة

765
01:01:57,660 --> 01:01:59,880
.لكن شكرًا لك

766
01:02:00,730 --> 01:02:08,740
،بصراحة، عندما أتيتُ لهذا العالم
...ظننتُه عقابًا لي، ولكن

767
01:02:10,070 --> 01:02:11,960
.أنا سعيدة للقائي بك

768
01:02:13,670 --> 01:02:14,700
.وأنا أيضًا

769
01:02:15,180 --> 01:02:16,710
.وأنت أيضًا يا إدغار-سان

770
01:02:16,710 --> 01:02:18,090
أقلتِ ذلك من باب الشّفقة؟

771
01:02:18,090 --> 01:02:20,090
.ماذا؟ كلاّ، لم أقصد ذلك

772
01:02:26,170 --> 01:02:29,230
.أتساءل ما حال أمّي

773
01:02:54,920 --> 01:02:56,400
...كاسومي

774
01:03:00,800 --> 01:03:04,880
إنّنا نرى الكثير من سحرة الظّلام
.كلّما اقتربنا من برج بابل

775
01:03:04,880 --> 01:03:07,550
.صحيح، وهم أكبر من ذي قبل

776
01:03:13,770 --> 01:03:16,990
ما الّذي سنفعله الآن؟

777
01:03:20,680 --> 01:03:21,830
ماذا؟

778
01:03:21,830 --> 01:03:22,700
من هناك؟

779
01:03:23,400 --> 01:03:25,820
.الأشجار الرّياح صامتة

780
01:03:27,130 --> 01:03:31,790
إنّها مسألة وقت فحسب قبل التهام
.الظّلمة لهذه الأرض بأكملها

781
01:03:32,220 --> 01:03:33,400
!تينا-سان

782
01:03:35,180 --> 01:03:38,280
.سرّتني رؤيتكما يا ليزبث وإدغار

783
01:03:38,970 --> 01:03:41,070
كيف هي الأحوال في منطقة ساغا؟

784
01:03:41,070 --> 01:03:43,710
...يقاتل الجميع بكلّ ما لديهم، لكن

785
01:03:44,320 --> 01:03:45,470
.فهمت

786
01:03:47,470 --> 01:03:51,480
.لا بدّ أنّ كاسومي، خيميائيّة النّور

787
01:03:51,480 --> 01:03:53,350
.سمعتُ الكثير عنك

788
01:03:57,840 --> 01:04:03,650
أستشعر أنّ الرّياح الّتي تهبّ
.في داخلك تختلف عن بقيّة الأطياف

789
01:04:03,880 --> 01:04:08,410
.ولكن، أستشعر دفئًا يفتقرون هم له

790
01:04:11,420 --> 01:04:12,660
ما معنى هذا؟

791
01:04:14,870 --> 01:04:17,000
.تينا-سان شامان رياح

792
01:04:17,000 --> 01:04:20,920
.بإمكانها التّواصل مع الطّبيعة والأرواح

793
01:04:20,920 --> 01:04:25,160
حتّى إنّ بإمكانها رؤية المستقبل
.قبل أن تُختم خيمياؤنا

794
01:04:25,840 --> 01:04:27,760
.سامحيني

795
01:04:27,760 --> 01:04:32,090
على الأرجح أنّني سأتسبّب لك
.بمعاناة أكثر ممّا يمكنك تخيّله

796
01:04:32,430 --> 01:04:38,810
،لكن بغضّ النّظر عن ذلك
.نحتاج لقوّتك لإنقاذ هذا العالم

797
01:04:55,720 --> 01:04:59,380
ما الّذي لم تريدي منها سماعه؟

798
01:04:59,970 --> 01:05:03,180
.اكتشفنا حقيقة جديدة في النّصّ القديم

799
01:05:03,180 --> 01:05:08,170
سيقضي الطّيف الّذي يُبعد الظّلمة
.على دسترولورك بكلّ تأكيد

800
01:05:08,580 --> 01:05:13,880
،ولكن، عندما سيُبعدون الظّلمة
.سيختفون هم أيضًا بالكامل

801
01:05:14,250 --> 01:05:17,760
...يختفون بالكامل؟ إذًا

802
01:05:17,760 --> 01:05:22,230
.لن تتمكّني من استدعاء كاسومي ثانية

803
01:05:22,970 --> 01:05:24,940
...أي أنّ كاسومي سوف

804
01:05:24,940 --> 01:05:27,650
.كلاّ! لا يمكننا فعل ذلك

805
01:05:29,070 --> 01:05:31,210
أليس كذلك يا إدغار-سان؟

806
01:05:31,210 --> 01:05:34,400
.لا يمكننا السّماح لكاسومي-سان بالاختفاء

807
01:05:37,230 --> 01:05:40,120
...أيعقل أنّك يا إدغار-سان

808
01:05:40,120 --> 01:05:41,900
!لا يمكننا هذا

809
01:05:41,900 --> 01:05:44,400
.لقد تغيّرت بالفعل يا إدغار-سان

810
01:05:44,400 --> 01:05:47,980
.كان إدغار-سان القديم ليعارض هذا

811
01:05:47,980 --> 01:05:49,090
.وأنت أيضًا

812
01:05:50,660 --> 01:05:56,640
وأنت القديمة كانت لتقول
.أنّها ستنقذ العالم وكاسومي معًا

813
01:06:01,050 --> 01:06:03,890
.فقدنا الكثير

814
01:06:06,370 --> 01:06:09,270
...لإنقاذ هذا العالم، فإنّ كاسومي-سان

815
01:06:10,390 --> 01:06:12,340
.ستختفي

816
01:06:14,700 --> 01:06:15,930
...كاسومي-سان

817
01:06:19,490 --> 01:06:22,670
سأختفي لإنقاذ هذا العالم؟

818
01:06:22,670 --> 01:06:24,700
.اسمعيني يا كاسومي-سان

819
01:06:24,700 --> 01:06:25,830
.معكم حقّ

820
01:06:28,270 --> 01:06:30,640
.أنا ميتة سلفًا

821
01:06:30,640 --> 01:06:33,170
.لا أستطيع العودة لعالمي

822
01:06:34,270 --> 01:06:35,200
.هذا سيّئ

823
01:06:35,200 --> 01:06:37,180
.على هذا المعدّل، ستخرج قوّتها عن السّيطرة

824
01:06:37,970 --> 01:06:41,180
...لإنقاذ هذا العالم، عليّ أن

825
01:06:41,430 --> 01:06:43,440
.اهدئي يا كاسومي-سان

826
01:06:43,980 --> 01:06:45,520
...أنا

827
01:06:52,200 --> 01:06:53,320
زاين؟

828
01:06:53,610 --> 01:06:57,630
.تعالي معي خلف العدم

829
01:06:59,200 --> 01:07:00,600
!كاسومي-سان

830
01:07:04,070 --> 01:07:05,200
...كاسومي

831
01:07:23,480 --> 01:07:25,050
أين أنا؟

832
01:07:25,050 --> 01:07:27,010
.في الظّلمة

833
01:07:28,070 --> 01:07:32,330
.الظّلمة في داخلك

834
01:07:40,930 --> 01:07:42,080
ما الأمر يا مُرفرِف؟

835
01:07:43,010 --> 01:07:45,200
هل تستشعر خيمياء كاسومي؟

836
01:07:47,320 --> 01:07:48,620
...كاسومي-سان

837
01:07:51,070 --> 01:07:54,320
لماذا اختطفتموني؟

838
01:07:54,320 --> 01:07:58,140
لقد كنتم حلفاء إدغار-سان وليز-سان، صحيح؟

839
01:07:58,640 --> 01:08:02,990
قالت أنّكم فقدتم جوهركم الحقيقيّ
.لأنّ دسترولورك استدعاكم

840
01:08:02,990 --> 01:08:05,290
—بمجرّد رحيل ذلك التّنّين، فسوف

841
01:08:10,210 --> 01:08:14,130
.توجد الظّلمة بداخل الجميع

842
01:08:14,990 --> 01:08:20,700
كلّ ذلك الغضب والكراهية والحزن

843
01:08:20,700 --> 01:08:24,040
.القابع في قلوبنا الآن كان بداخلنا سابقًا

844
01:08:24,040 --> 01:08:28,750
.احتضنّا الظّلمة بصمت فحسب

845
01:08:29,580 --> 01:08:34,940
.عرفنا كيف هو الحال داخل المُظلم

846
01:08:34,940 --> 01:08:37,870
.في دفء رحم الأمّ

847
01:08:41,730 --> 01:08:46,640
استعملنا قوّتنا لمساعدة النّاس عندما
.تواجدنا في هذا العالم أحياءً

848
01:08:47,300 --> 01:08:52,270
.وحتّى بعد موتنا، تمّ استدعاؤنا

849
01:08:52,270 --> 01:08:59,230
.قاتلنا وقاتلنا وقاتلنا بلا توقّف

850
01:08:59,230 --> 01:09:01,500
لكن لأيّ هدف؟

851
01:09:01,500 --> 01:09:05,150
.سألتِ إن كنّا سنتحالف مع إدغار والبقيّة ثانية

852
01:09:05,530 --> 01:09:08,890
.لم نعتبرهم حلفاء من الأساس

853
01:09:09,520 --> 01:09:14,700
.تمّ استدعاؤنا وأُمرنا وقاتلنا فحسب

854
01:09:16,610 --> 01:09:20,580
ألم يكونوا يستغلّونك أيضًا؟

855
01:09:47,370 --> 01:09:49,370
.يبدو أنّهم هربوا عائدين إلى هنا

856
01:09:49,370 --> 01:09:51,040
هل سنبقيها في القرية؟

857
01:09:51,040 --> 01:09:53,370
هنالك طيف بلا فائدة هنا؟

858
01:09:53,370 --> 01:09:55,150
.يبدو أنّها لا تستطيع فعل أيّ شيء

859
01:09:56,800 --> 01:09:59,050
.لا تبرعين في أيّ شيء

860
01:10:17,950 --> 01:10:21,360
.سيمحونني. سيقتلونني

861
01:10:21,360 --> 01:10:22,600
...سأُقتل... سأُقتل

862
01:10:22,600 --> 01:10:24,120
ما-ما هذا؟

863
01:10:24,120 --> 01:10:25,070
!كاسومي

864
01:10:25,970 --> 01:10:27,290
.هذا سيّئ

865
01:10:27,290 --> 01:10:28,650
ماذا يحدث؟

866
01:10:28,840 --> 01:10:30,800
.إنّ الظّلمة تبتلع كاسومي

867
01:10:31,670 --> 01:10:35,220
.على هذا الحال، ستُمسي كبقيّة الأطياف

868
01:10:39,180 --> 01:10:41,130
.لقد قتلوني

869
01:10:41,130 --> 01:10:42,970
...تقل، تقلوني، قتل

870
01:10:43,640 --> 01:10:45,940
.علينا ترك كاسومي تختفي

871
01:10:46,380 --> 01:10:48,640
.حاولوا قتلي

872
01:10:53,890 --> 01:10:55,040
!إدغار

873
01:10:55,610 --> 01:10:58,010
.إنّها ترفضنا

874
01:10:58,010 --> 01:11:01,770
.لا تستطيع أصواتنا الوصول إليها الآن

875
01:11:03,530 --> 01:11:07,000
.قتلوني... لقد قتلوني

876
01:11:07,000 --> 01:11:08,540
...قتل... قتلوني

877
01:11:12,380 --> 01:11:13,580
ليز؟

878
01:11:17,710 --> 01:11:19,090
ما الّذي تفعلينه؟

879
01:11:19,090 --> 01:11:21,090
.ما باستطاعتي

880
01:11:21,580 --> 01:11:22,680
.هذا تهوّر يا ليز

881
01:11:22,970 --> 01:11:26,300
...انتظري فحسب! وعدتُ أن أنقذك

882
01:11:27,370 --> 01:11:30,220
!كاسومي

883
01:11:30,220 --> 01:11:32,770
!لقد قتلوني

884
01:11:36,000 --> 01:11:38,720
...قتلوني، قتلوني

885
01:11:38,720 --> 01:11:42,480
...حاولوا قتلي. قتل، قتلوني، قتل

886
01:11:41,250 --> 01:11:47,530
.أنا آسفة لإقحامك في معركتنا

887
01:11:47,530 --> 01:11:50,900
لكن تذكّري ما أخبرتك به؟

888
01:11:50,900 --> 01:11:54,960
.سأتحمّل المسؤوليّة وسأنهي هذا الأمر

889
01:12:00,280 --> 01:12:02,420
.صدّقيني رجاءً

890
01:12:06,420 --> 01:12:12,290
!فنحن صديقتان قبل كلّ شيء

891
01:12:16,060 --> 01:12:17,240
...ليز-سان

892
01:12:17,910 --> 01:12:19,470
...كاسومي-سان

893
01:12:21,370 --> 01:12:22,780
.أنا جدّ سعيدة

894
01:12:31,200 --> 01:12:33,090
!كاسومي! ليز

895
01:12:34,670 --> 01:12:36,140
هل أنت بخير؟

896
01:12:37,790 --> 01:12:39,750
!ليز، تماسكي

897
01:12:39,750 --> 01:12:40,860
!ليز

898
01:12:44,030 --> 01:12:45,370
...ليز-سان

899
01:12:50,920 --> 01:12:53,970
.تذكّري يا كاسومي

900
01:12:54,890 --> 01:12:57,680
.سلّمي نفسك للظّلمة في قلبك

901
01:12:58,080 --> 01:13:00,570
.سيري معنا

902
01:13:00,570 --> 01:13:02,520
!أيّها الوغد زاين

903
01:13:02,810 --> 01:13:05,520
أُمرتم أن تختطفوا كاسومي؟

904
01:13:05,520 --> 01:13:07,450
لم نُؤمر؟

905
01:13:08,550 --> 01:13:12,280
.منحَنا دسترولورك الحرّيّة

906
01:13:12,540 --> 01:13:16,490
.اخترنا أن نعيره قوّتنا

907
01:13:16,760 --> 01:13:19,810
أطياف؟ بإرادتهم الخاصّة؟

908
01:13:19,810 --> 01:13:22,700
...هل ظننتِ أنّ من المستحيل

909
01:13:22,940 --> 01:13:25,320
لدُماكم أن تتصرّف بإرادتها؟

910
01:13:26,040 --> 01:13:31,830
يحاول دسترولورك إعادة هذا العالم
،إلى العدم وبناءه من جديد

911
01:13:31,830 --> 01:13:37,200
ليُنهي هذا العالم الّذي يختلط فيه
.الأموات مع الأحياء

912
01:13:38,430 --> 01:13:40,630
ماذا بوسع البشر أن يفعلوا؟

913
01:13:40,630 --> 01:13:43,070
...إنّكم توقظون الأموات ببساطة

914
01:13:43,070 --> 01:13:47,990
.وتشنّون حروبًا فظيعة باسم العدالة

915
01:13:48,880 --> 01:13:51,820
.إن عاد كلّ شيء للعدم، فسأختفي حينها

916
01:13:52,520 --> 01:13:57,580
لكنّ الأطياف كائنات معارضة
.للطّبيعة من البداية

917
01:13:57,580 --> 01:14:02,870
.سنخاطر بوجودنا بحدّ ذاته لخلق سلام حقيقيّ

918
01:14:18,870 --> 01:14:20,260
.اهربا بينما تستطيعان ذلك

919
01:14:23,960 --> 01:14:25,020
!لن تهربوا

920
01:14:27,560 --> 01:14:29,110
...أنت

921
01:14:38,330 --> 01:14:40,250
!كاسومي، تماسكي

922
01:14:40,510 --> 01:14:41,770
!كاسومي

923
01:14:41,770 --> 01:14:43,080
...سُحقًا

924
01:14:43,840 --> 01:14:44,790
...ليز-سان

925
01:14:53,980 --> 01:14:57,030
.لنبدأ طقس الخاتم

926
01:14:57,030 --> 01:14:58,890
.أحضروا القربان

927
01:15:06,560 --> 01:15:13,070
يا خيمياء المقدّس، ادخلي رحم
.الحجر المقدّس بهذه الدّماء

928
01:15:16,830 --> 01:15:22,180
.امنحي هذا الفراغ جسدًا وقوّة وحياة

929
01:15:20,610 --> 01:15:24,250
.أنا آسفة. أنا آسفة

930
01:15:22,180 --> 01:15:26,750
،عند انتهاء الخاتم من رحم أمّ الظّلام

931
01:15:27,050 --> 01:15:29,680
.فليحتضنه النّور ويُلد في هذا العالم

932
01:15:29,680 --> 01:15:31,160
.أنا آسفة

933
01:16:01,570 --> 01:16:04,540
.مرّ وقت طويل يا أميرة

934
01:16:20,240 --> 01:16:24,800
.آسف. ما زلت لم أفِ بالوعد الّذي قطعتُه

935
01:16:27,760 --> 01:16:31,510
...إدغار-سان، هذا المكان

936
01:16:31,510 --> 01:16:32,520
.نعم

937
01:16:33,020 --> 01:16:39,070
،في أوّل يوم ظهر فيه دسترولورك
.قاتلنا في هذه القرية

938
01:16:39,070 --> 01:16:40,120
...لكن

939
01:16:47,210 --> 01:16:48,710
!زاين

940
01:16:53,590 --> 01:16:56,140
!اهرب

941
01:17:18,240 --> 01:17:19,580
كاسومي؟

942
01:17:27,530 --> 01:17:29,610
.عليك العودة

943
01:17:30,340 --> 01:17:33,450
.لا يوجد ما أستطيع فعله وحدي

944
01:17:33,450 --> 01:17:36,010
.آسف لأنّنا استدعيناك لأغراضنا الخاصّة

945
01:17:36,540 --> 01:17:39,550
.عيشي بقيّة حياتك كما ترغبين

946
01:17:39,550 --> 01:17:41,890
ماذا؟ إدغار-سان؟

947
01:17:43,440 --> 01:17:46,160
.لم تبتلع الظّلمة بعض المناطق بعد

948
01:17:46,160 --> 01:17:48,840
.إن كنتِ محظوظة، فأنا واثق أنّك ستتدبّرين أمرك

949
01:17:48,840 --> 01:17:49,800
.مع السّلامة

950
01:18:04,920 --> 01:18:07,100
.لا بدّ أنّك تُمازحني

951
01:18:07,100 --> 01:18:08,740
!لا بدّ أنّك تُمازحني

952
01:18:10,950 --> 01:18:14,920
هل تحاول إثارة غضبي لكي لا أتورّط أكثر؟

953
01:18:15,860 --> 01:18:16,790
—عمّ تتحدّ

954
01:18:16,790 --> 01:18:22,240
هل تحاول إبعادي لتتمكّن
من قتال دسترولورك وحدك؟

955
01:18:22,240 --> 01:18:24,100
.لا تتصرّف بسخافة

956
01:18:24,100 --> 01:18:24,850
...ليز-سان و

957
01:18:26,040 --> 01:18:29,070
.ليز-سان وتينا-سان رحلا الآن

958
01:18:29,070 --> 01:18:31,950
ما الّذي بإمكانك تحقيقه وحدك؟

959
01:18:31,950 --> 01:18:33,830
.ذلك ليس من شأنك

960
01:18:33,830 --> 01:18:35,590
.هذه مشكلة عالمنا نحن

961
01:18:35,590 --> 01:18:38,030
.أنتم من استدعيتموني

962
01:18:38,030 --> 01:18:41,240
،طلبتم منّي القتال أوّلاً
،وبعدها طلبتم منّي الاختفاء

963
01:18:41,240 --> 01:18:43,520
والآن تريدوني أن أهرب؟

964
01:18:43,520 --> 01:18:44,910
—نلتُ كفايـ

965
01:18:50,780 --> 01:18:53,040
.هذه حرب

966
01:18:53,040 --> 01:18:54,250
—وهاوية مثلك لا يمكنها

967
01:18:54,250 --> 01:18:55,300
!أيّها الغبيّ

968
01:18:55,300 --> 01:18:56,290
.كاسومي

969
01:18:57,510 --> 01:19:00,470
أهذه محاولتك لمنعي من البكاء؟

970
01:19:00,470 --> 01:19:01,740
—هذا ليس ما

971
01:19:05,640 --> 01:19:07,510
كاسومي؟

972
01:19:07,510 --> 01:19:10,760
.لا احتاج لحماية رجل

973
01:19:11,400 --> 01:19:13,720
.ليس عليك التّظاهر

974
01:19:14,200 --> 01:19:18,960
