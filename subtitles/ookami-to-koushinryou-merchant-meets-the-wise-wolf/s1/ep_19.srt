1
00:00:11,500 --> 00:00:13,780
هل تعتقد بأنّ السيّد لورينس سيكون بخير؟

2
00:00:13,780 --> 00:00:18,780
سيكون الأمر صعباً. لن يتمكّن من تحمُّل
معركة من دون كمّية كبيرة من البيريت

3
00:00:19,160 --> 00:00:22,180
جُلّ ما نأمله فقط هو أن ترسل
ديانا شخصاً لأجله

4
00:00:23,880 --> 00:00:30,970
،إذا نفد صبره وباع عدداً مُتوسِّطاً من الأحجار

5
00:00:30,970 --> 00:00:33,420
فسوف يؤجّج طمع المُشترين فحسب

6
00:00:33,420 --> 00:00:36,410
إذا حدث ذلك، سيظلُّ السّعر يرتفع

7
00:00:36,800 --> 00:00:39,950
حينها، ألن يُضطرّ السيّد لورينس

8
00:00:39,950 --> 00:00:42,810
للتحرُّك إذا تصرّف السيّد أماتي
وكأنّه على وشك البيع؟

9
00:00:42,810 --> 00:00:46,690
هذا صحيح. أنت ذكيٌّ جدّاً

10
00:00:49,530 --> 00:00:50,830
أين هولو؟

11
00:01:01,470 --> 00:01:03,000
!بطاقة شراء جديدة

12
00:01:03,000 --> 00:01:04,750
سترتفع القيمة من جديد

13
00:01:05,790 --> 00:01:07,570
ينبغي لي أن أشتري بعضاً الآن أيضاً

14
00:01:08,300 --> 00:01:09,950
إلى أي درجة سيرتفع بالضّبط؟

15
00:01:13,800 --> 00:01:16,500
ارتفع كلّ هذا المقدار؟

16
00:01:16,500 --> 00:01:19,890
سيرتفع غالباً بنسبة عشرين بالمئة ظهراً

17
00:01:19,890 --> 00:01:22,790
كان ينبغي أن أشتري بعضاً عندما
كانت الفُرصة ما زالت سانحة لي

18
00:01:24,820 --> 00:01:27,330
السّعر يرتفع تدريجيّاً

19
00:01:27,330 --> 00:01:31,150
يمتلك أماتي حالياً من البيريت
ما قيمته ثمانمئة قطعة فضّية

20
00:01:31,150 --> 00:01:32,980
إذا ارتفع بنسبة عشرين بالمئة؟

21
00:01:32,980 --> 00:01:34,760
فسيساوي تسعمئة وستّون قطعة فضّية

22
00:01:36,570 --> 00:01:42,300
إذا حدث ذلك، فغالباً سوف يبيع كلّ ممتلكاته
لجمع الأربعين قطعة نقديّة المتبقّية

23
00:01:42,300 --> 00:01:45,120
وإتمام العقد

24
00:01:46,930 --> 00:01:50,880
سيفعل ذلك قبل أن يأخذ السمُّ
نتيجة البيع بالدّين مفعوله

25
00:01:51,320 --> 00:01:53,340
السمّ نتيجة البيع بالدّين؟

26
00:01:56,170 --> 00:01:59,030
مُمثِّل الآنسة ديانا لم يصل بعد؟

27
00:02:01,480 --> 00:02:03,860
،لو كانت هولو في صفّه طوال هذا الوقت

28
00:02:03,860 --> 00:02:06,680
...لاكتسب أماتي بالفعل الكثير من حكمتها

29
00:02:10,980 --> 00:02:12,360
!بطاقة شراء أخرى

30
00:02:12,990 --> 00:02:14,530
لا أصدِّق بأنّه ارتفع كلّ هذا الحدّ

31
00:02:14,530 --> 00:02:16,860
لا، أنا متأكّد بأنّه سيرتفع أكثر

32
00:02:17,930 --> 00:02:19,340
كم صار الآن؟

33
00:02:19,340 --> 00:02:20,990
!حسناً! واظب على ذلك

34
00:02:24,640 --> 00:02:25,690
هذا سيّئ

35
00:02:32,090 --> 00:02:36,710
هل أبرمت الآنسة ديانا عقداً مع أماتي؟

36
00:02:37,060 --> 00:02:41,260
لكن ألن يجني السيّد لورينس كثيراً
من المال إذا ربح السيّد أماتي؟

37
00:02:41,260 --> 00:02:42,830
معك حقّ

38
00:02:42,830 --> 00:02:45,620
إذاً نجحَ كتاجر

39
00:02:45,620 --> 00:02:48,010
لكن ستكون خسائره جسيمة

40
00:02:49,360 --> 00:02:53,690
،هناك أشياء لن تحصل عليها أبداً ثانية
مهما كان حجم المال الّذي تجنيه

41
00:02:54,620 --> 00:02:55,950
هل ينبغي أن نبيع؟

42
00:02:55,950 --> 00:02:57,250
لا، يجدر بنا أن ننتظر أكثر

43
00:02:57,250 --> 00:02:59,200
!أنا متأكّد بأنّه سوف يرتفع

44
00:02:59,200 --> 00:03:03,200
أنت مهتمّ ببيريت الخيميائيّين؟

45
00:03:03,540 --> 00:03:06,560
لم تجد مكاناً لشراء البيريت
!قبل توقيع العقد معه؟

46
00:03:06,560 --> 00:03:08,830
مع الأسف، لم يُسعفني الوقت

47
00:03:08,830 --> 00:03:11,580
شخص آخر قد طلبَ شراءه قبلك بالفعل

48
00:03:11,850 --> 00:03:13,830
سأكون أنا من يتولّى المُفاوضات

49
00:03:13,830 --> 00:03:18,340
أين سوف أجدك يوم غد؟

50
00:03:18,340 --> 00:03:19,740
عدد المُشترين لا ينخفض

51
00:03:19,740 --> 00:03:20,660
لا باعة

52
00:03:20,660 --> 00:03:21,890
...هذا لا يبدو

53
00:03:20,660 --> 00:03:21,890
لا ينفك يرتفع

54
00:03:21,890 --> 00:03:23,550
!مُشترٍ آخر

55
00:03:23,550 --> 00:03:25,540
مذهل. إلى متى سيظلّ يرتفع؟

56
00:03:24,390 --> 00:03:26,390
!رائع! واظب على ذلك

57
00:03:26,060 --> 00:03:28,060
!هذا ليس وقت القيام بصفقات عمل

58
00:03:28,060 --> 00:03:31,440
ارتأيتَ أنّ ألف قطعة فضّية
تستحقُّ الخسارة، أليس كذلك؟

59
00:03:37,440 --> 00:03:39,220
إنّه يبحث عنها أيضاً؟

60
00:03:39,220 --> 00:03:39,860
!بائع

61
00:03:39,860 --> 00:03:41,240
!أحدُهم قد باع

62
00:03:40,920 --> 00:03:41,990
!هل كان أماتي؟

63
00:03:41,240 --> 00:03:41,990
بِكَم؟

64
00:03:41,990 --> 00:03:43,320
كيف ستتأثّر الأسعار بذلك؟

65
00:03:45,210 --> 00:03:46,400
!المعذرة

66
00:03:46,400 --> 00:03:47,340
!من فضلكم

67
00:03:47,340 --> 00:03:48,800
!من فضلكم اسمحوا لي بالمرور

68
00:03:53,390 --> 00:03:55,330
...المعذرة

69
00:03:55,330 --> 00:03:56,920
!مُشترٍ آخر

70
00:03:56,080 --> 00:03:58,620
...لقد ارتدّ

71
00:03:58,620 --> 00:03:59,810
كان ذلك سريعاً

72
00:03:59,810 --> 00:04:02,400
لن يتوقّف عن الصّعود

73
00:04:00,180 --> 00:04:01,460
هل سيبدأ السّعر بالتغيّر؟

74
00:04:01,470 --> 00:04:02,510
هل حان وقت البيع؟

75
00:04:02,510 --> 00:04:04,580
لا، ينبغي أن تشتري مع ذلك

76
00:04:02,660 --> 00:04:05,160
لكلّ شيء حدود

77
00:04:04,580 --> 00:04:06,150
الوضع غير عادي اليوم

78
00:04:07,280 --> 00:04:08,060
!هولو؟

79
00:04:08,400 --> 00:04:10,270
ا-المعذرة

80
00:04:11,580 --> 00:04:13,260
هذا أنت

81
00:04:13,260 --> 00:04:17,910
أى أحدهم إلى عربتنا راغباً
في شراء القمح بالحجارة

82
00:04:18,470 --> 00:04:19,370
بِكَم؟

83
00:04:19,370 --> 00:04:20,730
مئتان وخمسون قطعة نقديّة

84
00:04:23,320 --> 00:04:24,780
بقدر استطاعتك، بسرعة

85
00:04:24,780 --> 00:04:25,480
!حاضر

86
00:04:29,330 --> 00:04:29,850
!بائع

87
00:04:29,850 --> 00:04:32,290
أريده أن يرتفع أكثر حتّى

88
00:04:32,290 --> 00:04:33,690
عدد الباعة يتزايد

89
00:04:33,690 --> 00:04:36,030
!سأشتري! هنا تكمن الفائدة

90
00:04:36,030 --> 00:04:37,880
!السّعر لا ينخفض

91
00:04:39,920 --> 00:04:43,670
اشترى أماتي من البيريت ما قيمته
،خمسمئة قطعة نقديّة من لورينس

92
00:04:43,670 --> 00:04:46,560
لكن لديه عقد بدلاً من المنتَج الفعليّ

93
00:04:46,560 --> 00:04:49,360
سيُسلّم المنتَج الأصليّ في مساء الغد

94
00:04:54,620 --> 00:04:57,080
هل تعي ما يعنيه هذا؟

95
00:04:57,810 --> 00:05:00,770
سيتمكّن من بيع العقد إذا بدا
أنّ السّعر سوف يرتفع

96
00:05:00,770 --> 00:05:03,180
لكن ليس إذا كان سينخفض

97
00:05:03,180 --> 00:05:04,570
هذا صحيح

98
00:05:04,900 --> 00:05:07,410
لا أحد يتمنّى التمسّك بشيء بهذه الخطورة

99
00:05:07,410 --> 00:05:11,650
،إذا عاد وانخفض السّعر إلى الحدِّ الطّبيعيّ

100
00:05:11,650 --> 00:05:16,080
العقد الّذي اشتراه مقابل خمسمئة قطعة فضّية
سيصبح قطعة ورق لا قيمة لها

101
00:05:17,540 --> 00:05:19,920
آخر شخص يحمل العقد سوف يُفلِس

102
00:05:20,190 --> 00:05:23,990
هذا صحيح. لهذا السّبب البيع
بالدَّين مسموم جدّاً

103
00:05:30,840 --> 00:05:32,690
أهذا هو الحدّ؟

104
00:05:32,690 --> 00:05:34,890
الصّبورون هم من سيكسبون في النّهاية

105
00:05:33,630 --> 00:05:35,640
!هذا السّعر مناسب بالنّسبة لي. سأبيع

106
00:05:35,640 --> 00:05:38,060
بسرعة يا لانت

107
00:05:40,440 --> 00:05:42,020
حان وقت البيع

108
00:05:41,300 --> 00:05:43,650
آنسة هولو؟ آنسة هولو؟

109
00:05:42,020 --> 00:05:43,650
...ينبغي أن أفعل قبل أن ينخفض السّعر أكثر

110
00:05:44,960 --> 00:05:46,280
!مُشترٍ آخر

111
00:05:46,280 --> 00:05:47,090
كم القيمة؟

112
00:05:46,650 --> 00:05:48,000
!لا يمكنني الرّؤية! ابتعدوا عن المُقدّمة

113
00:05:48,000 --> 00:05:49,790
!إنّه مُشترٍ ضخم

114
00:05:52,070 --> 00:05:53,570
ارتفع من جديد

115
00:05:53,570 --> 00:05:55,080
هل بلغتُ الحدّ؟

116
00:05:54,540 --> 00:05:55,630
لكن هل سيستمرّ في الارتفاع؟

117
00:05:55,630 --> 00:05:57,250
أنا متأكّد بأنّ هذه هي حدوده

118
00:05:57,250 --> 00:05:59,750
هناك عدد قليل من المُشترين الآن

119
00:06:02,070 --> 00:06:03,980
...إذا بعتُ كلّ ما لدي

120
00:06:05,880 --> 00:06:07,090
!سأبيع

121
00:06:07,090 --> 00:06:08,000
بائع

122
00:06:08,000 --> 00:06:09,050
كلّ هذا القدر؟

123
00:06:11,540 --> 00:06:12,750
انخفض السّعر كثيراً

124
00:06:12,750 --> 00:06:13,850
...فوّتُ التّوقيت المناسب للبيع

125
00:06:13,850 --> 00:06:16,770
!سيعود للصّعود. ما زالت فُرصتنا سانحة

126
00:06:27,470 --> 00:06:32,450
لو كان لديّ البيريت الّذي قيمته أربعمئة
،قطعة نقديّة من الآنسة ديانا الآن

127
00:06:32,450 --> 00:06:35,120
لانهارَ السّعر حتماً

128
00:06:41,240 --> 00:06:42,930
...إذا أتت الآن

129
00:06:42,930 --> 00:06:44,780
!سيّد لورينس

130
00:06:48,270 --> 00:06:49,260
!سيّد لورينس

131
00:06:49,770 --> 00:06:53,220
!آسف لو تأخّرت! تفضّل قيمة المئتين وخمسين نقديّة

132
00:06:55,740 --> 00:06:57,060
ما الأمر؟

133
00:06:57,060 --> 00:06:58,760
...حـ-حسناً

134
00:07:00,780 --> 00:07:04,730
من باب الأمان، ينبغي أن أنتظر
...مُمثِّل الآنسة ديانا

135
00:07:04,730 --> 00:07:05,680
...لكن

136
00:07:06,450 --> 00:07:08,210
هل سيأتي ذلك الشّخص؟

137
00:07:08,210 --> 00:07:08,900
ماذا؟

138
00:07:09,220 --> 00:07:10,040
هذا صحيح

139
00:07:10,510 --> 00:07:13,900
فقدتُ الأمل من ذلك قبل لحظات

140
00:07:14,900 --> 00:07:16,350
...إذا كنتُ سأجازف

141
00:07:18,750 --> 00:07:20,870
!يجب أن أبيع قبل أن يأتي مُشترٍ آخر

142
00:07:25,310 --> 00:07:26,990
!ها هو! مُشترٍ مليء

143
00:07:26,990 --> 00:07:28,800
!ما السّعر الآن؟

144
00:07:37,610 --> 00:07:38,810
!إنّه شراء تثبيت السّعر

145
00:07:38,810 --> 00:07:40,210
!ارتفع من جديد! إنّه أعلى سعر إلى الآن

146
00:07:40,210 --> 00:07:42,300
!سوف أشتري! ما زال وقت الشّراء مُتاحاً

147
00:07:40,690 --> 00:07:41,950
ما الأمر؟

148
00:07:41,950 --> 00:07:44,310
هناك... مُشترٍ آخر

149
00:07:45,250 --> 00:07:48,170
تغيّرت جهة الرّيح

150
00:07:48,820 --> 00:07:52,500
والآن كلّ ما يمكنني فعله هو انتظار
...مُمثّل الآنسة ديانا

151
00:07:53,460 --> 00:07:54,990
!ا-انظر

152
00:07:59,410 --> 00:08:00,390
!هولو

153
00:08:02,450 --> 00:08:03,630
لا شكّ في ذلك

154
00:08:04,170 --> 00:08:06,890
أدرك أماتي خطورة البيع بالدَّين

155
00:08:08,190 --> 00:08:09,940
!سيّد لورينس

156
00:08:11,960 --> 00:08:13,090
الوقت يُداهمني

157
00:08:13,490 --> 00:08:15,080
بسرعة أرجوك

158
00:08:15,080 --> 00:08:16,040
!أرجوك

159
00:08:17,160 --> 00:08:19,720
هل أنت السيّد لورينس؟

160
00:08:22,020 --> 00:08:23,890
أنت السيّد لورينس، أليس كذلك؟

161
00:08:23,890 --> 00:08:25,790
أ-أجل

162
00:08:25,790 --> 00:08:28,020
أحمل رسالة من الآنسة ديانا

163
00:08:32,440 --> 00:08:34,300
فشلتْ في المُفاوضات

164
00:08:36,680 --> 00:08:41,260
تقول الآنسة ديانا بأنّها فشلت في إقناع
الطّرف الآخر بالبيع لك

165
00:08:43,100 --> 00:08:46,290
تعتذر أيضاً عن عجزها في الارتقاء لتوقُّعاتك

166
00:08:48,590 --> 00:08:49,950
أستأذن

167
00:08:59,930 --> 00:09:01,400
سيّد لورينس

168
00:09:03,290 --> 00:09:04,430
سيّد لورينس

169
00:09:05,200 --> 00:09:08,440
!سيّد لورينس

170
00:09:10,330 --> 00:09:11,630
آسف

171
00:09:11,630 --> 00:09:14,880
...سبّبتُ لك الكثير من المتاعب

172
00:09:14,880 --> 00:09:17,820
...ماذا؟ لا، هذا ليس

173
00:09:17,820 --> 00:09:19,820
من فضلك أوصل رسالة إلى مارك

174
00:09:20,450 --> 00:09:23,450
فشلت الخطّة

175
00:09:24,280 --> 00:09:27,290
مع أنّني سأكسب ألف قطعة فضّية من أماتي

176
00:09:27,680 --> 00:09:30,440
كتاجر، ينبغي أن أكون سعيداً

177
00:09:30,440 --> 00:09:32,420
...تفضّل، هذه لك

178
00:09:36,980 --> 00:09:38,360
!سيّد لورينس

179
00:09:41,530 --> 00:09:43,220
!هـ-هل ستستسلم؟

180
00:09:43,220 --> 00:09:47,890
لطالما أخبرني مُعلّمي بأنّ التجّار
يجب ألّا يستسلموا بسهولة

181
00:09:47,890 --> 00:09:52,800
إ-إله المال الّذي لا يأتي لأولئك
،الّذين يصلّون

182
00:09:52,800 --> 00:09:55,650
!إنّما لأولئك الّذين لا يستسلمون بسهولة

183
00:09:58,270 --> 00:10:00,050
...أنا

184
00:10:00,050 --> 00:10:03,990
وقعتُ في حبّ الآنسة هولو
!في لحظة رؤيتي لها

185
00:10:04,900 --> 00:10:10,000
...لكن أخبرني المُعلّم بأنّك ستضربني

186
00:10:11,870 --> 00:10:13,670
!حتّى يُغمى علي إذا أخبرتُك

187
00:10:16,350 --> 00:10:19,510
!أجل، أحدهم سيُضرَب بكلِّ تأكيد

188
00:10:23,230 --> 00:10:25,060
...أريد أن أفعل المستحيل

189
00:10:26,310 --> 00:10:27,810
بمفردي

190
00:10:30,560 --> 00:10:31,580
ماذا؟

191
00:10:31,580 --> 00:10:32,910
نسيتُ

192
00:10:33,640 --> 00:10:39,820
الأشخاص الّذين لا يستسلمون بسهولة
هم حالِمون بشكل لا يُصدَّق

193
00:10:40,530 --> 00:10:43,080
وأنا واحد منهم

194
00:10:43,530 --> 00:10:46,410
التّاجر يمارس العمل برسم الخطط والتوقُّعات

195
00:10:46,820 --> 00:10:49,290
ومُقارنتها بالحقائق

196
00:10:49,710 --> 00:10:51,290
إذا بعتُ هذا، فسيحدث هذا

197
00:10:51,290 --> 00:10:52,880
إذا اشتريتُ هذا، فهذا ما سيحدث

198
00:10:52,880 --> 00:10:54,630
إنّه جانب مهمّ في العمل

199
00:10:55,200 --> 00:10:58,470
لكن يستطيع النّاس أن يضعوا
ما يشاؤون من فرضيّات

200
00:10:58,780 --> 00:11:01,970
لهذا قد تحتار وتتوه إذا طرحت
الكثير من الفرضيّات

201
00:11:01,970 --> 00:11:05,220
ستبدأ بالاعتقاد بأنّ أي عمل
تُمارسه سيكون محفوفاً بالمخاطر

202
00:11:05,880 --> 00:11:09,420
لهذا تحتاج لافتة طريق

203
00:11:10,270 --> 00:11:12,770
لافتة يجب على كلّ تاجر أن يمتلكها

204
00:11:13,070 --> 00:11:15,150
،إنّها لافتة طريق موثوقة

205
00:11:15,150 --> 00:11:17,530
...ينبغي أن تؤمن بها

206
00:11:21,000 --> 00:11:23,240
مهما بدا الأمر جنونيّاً

207
00:11:27,060 --> 00:11:28,500
هكذا ينبغي أن يكون الأمر

208
00:11:30,370 --> 00:11:34,540
حالما أبيع البيريت، وتنشر الإشاعة كما طلبتُ منك

209
00:11:35,800 --> 00:11:36,960
!حـ-حاضر

210
00:11:37,460 --> 00:11:39,060
هل تؤمن بالإله؟

211
00:11:39,060 --> 00:11:39,710
ماذا؟

212
00:11:42,190 --> 00:11:43,160
أعتمد عليك

213
00:11:51,110 --> 00:11:52,310
أنت هنا من جديد

214
00:11:55,640 --> 00:11:56,480
سأبيع

215
00:12:01,320 --> 00:12:02,530
سأبيع كذلك

216
00:12:02,930 --> 00:12:03,980
بائع آخر؟

217
00:12:03,300 --> 00:12:04,360
أحمق

218
00:12:03,980 --> 00:12:05,460
...هذا المقدار

219
00:12:05,960 --> 00:12:07,120
آسف

220
00:12:07,540 --> 00:12:10,890
بخلاف شخص أعرفه، كانت آنسة
ناضجة وحسناء، صحيح؟

221
00:12:08,190 --> 00:12:10,390
!تعال وساعدني

222
00:12:19,130 --> 00:12:20,300
!بائع

223
00:12:20,300 --> 00:12:21,750
إلى أي درجة سيتغيّر السّعر؟

224
00:12:28,670 --> 00:12:30,310
!إنّه بيع ضخم

225
00:12:30,830 --> 00:12:31,710
!هيّا نبيع

226
00:12:31,710 --> 00:12:32,860
!سأبيع أيضاً

227
00:12:32,860 --> 00:12:34,600
!ابتعد عن طريقي! أنا أوّلاً

228
00:12:33,730 --> 00:12:36,250
!أيُّها البائع! تعال إلى هنا بسرعة

229
00:12:59,220 --> 00:13:02,840
في النّهاية، لم يخسر أماتي
،الكثير من النّاحية المالية

230
00:13:03,170 --> 00:13:05,940
لكنّها كانت صدمة نفسيّة كبيرة له

231
00:13:09,230 --> 00:13:11,720
لا ينبغي أن تحاول أخذ امرأة شخص آخر

232
00:13:15,230 --> 00:13:17,100
هذا ما قيل له

233
00:13:19,310 --> 00:13:22,610
كنتُ أخطِّط لإنهاء الأمر معه
بطريقة أقسى بكثير

234
00:13:22,610 --> 00:13:23,700
ماذا؟

235
00:13:23,700 --> 00:13:26,730
!لا أسامحه على كلامه

236
00:13:26,730 --> 00:13:27,470
ماذا؟

237
00:13:27,470 --> 00:13:29,620
لا تسألني عن الكلام الّذي قاله

238
00:13:30,110 --> 00:13:31,830
هكذا أفضل ربّما

239
00:13:33,650 --> 00:13:38,040
وبعد؟ لا تخل أنّ كلّ شيء قد حُلّ

240
00:13:43,550 --> 00:13:44,690
أنا آسف

241
00:13:44,690 --> 00:13:48,390
هل تعلم حقّاً ما الّذي يجدر
بك أن تعتذر لأجله؟

242
00:13:49,850 --> 00:13:50,730
أجل

243
00:13:53,910 --> 00:13:55,140
على الأقلّ، هذا ما أعتقده

244
00:13:56,910 --> 00:14:04,300
كان عقدي مع السيّد أماتي
رحلة أنانيّة كاملة، صحيح؟

245
00:14:05,650 --> 00:14:10,910
والأسوأ كان هو أنّني لم أثق
بكِ بشكل كامل

246
00:14:11,280 --> 00:14:13,380
أريتِني الرّيش الأبيض لتخبريني

247
00:14:13,380 --> 00:14:17,660
بأنّكِ كنتِ أنتِ من اشترى
البيريت من الآنسة ديانا

248
00:14:17,940 --> 00:14:23,130
اختفيتِ لأنّكِ كنتِ تحصلين على البيريت
من الآنسة ديانا

249
00:14:23,130 --> 00:14:28,260
لكن ظننتُكِ قد نصبتِ فخّاً لي
عندما باع أماتي أحجاره

250
00:14:29,840 --> 00:14:31,860
!فسِّر موقفك

251
00:14:33,210 --> 00:14:35,850
ظننتُ أنّكِ كنتِ تحاولين دفعي
...للكشف عن أوراقي

252
00:14:36,280 --> 00:14:39,160
،علاوة على ذلك، لو ظلَّ السّعر يرتفع

253
00:14:39,160 --> 00:14:43,520
فسأضطرّ لشراء البيريت الّذي
...وعدتُ أماتي به بسعر أعلى

254
00:14:43,520 --> 00:14:47,030
ظننتُكِ قد صرتِ في صفِّ أماتي حرفيّاً

255
00:14:48,160 --> 00:14:49,390
لكن كنتُ مخطئاً

256
00:14:49,390 --> 00:14:54,550
حرّضتِ أماتي، الشّخص غير المعتاد
على هذه التّجارة، لبيع كمّية منه

257
00:14:54,990 --> 00:14:58,670
كنتِ تحاولين أن تخبريني بأنّ
،أماتي لديه ما يكفي من مخزون

258
00:14:58,670 --> 00:15:03,170
لذا ينبغي أن أسرع وأبيع، صحيح؟

259
00:15:03,680 --> 00:15:05,060
...يا للعجب

260
00:15:07,020 --> 00:15:12,680
حتّى قبل ذلك، أرسلتِ العقد الّذي
وقّعتِه والّذي أرسله أماتي

261
00:15:12,680 --> 00:15:13,550
...كان

262
00:15:14,270 --> 00:15:18,180
...كان هذا لجعلي أمتعِض بما يكفي للتحرُّك

263
00:15:20,390 --> 00:15:21,390
أليس كذلك؟

264
00:15:21,390 --> 00:15:24,650
...كنتُ في الطّابق الثّاني آنذاك

265
00:15:27,140 --> 00:15:28,590
لا شيء

266
00:15:28,590 --> 00:15:29,400
!تابع

267
00:15:32,160 --> 00:15:34,450
أخبرتِني في روفينهايغن

268
00:15:34,770 --> 00:15:38,450
بأنّني لا ينبغي أن أعبث ويجب
أن أخبركِ عن مشاعري الحقيقيّة

269
00:15:38,820 --> 00:15:41,830
أخبرتِني بأنّ المشاكل تُحَلّ بشكل أسرع
إذا غضِبنا وتجادلنا مع بعضنا الآخر

270
00:15:42,590 --> 00:15:44,960
ثمّ حدث بيننا أوّل التِباس

271
00:15:45,310 --> 00:15:47,460
...عندما امتعضتِ بشأن المُشكلة مع يويتسو

272
00:15:48,000 --> 00:15:50,220
...الاعتذار الّذي قدّمتِه لي في النّهاية

273
00:15:50,220 --> 00:15:51,420
أنا آسفة

274
00:15:53,170 --> 00:15:55,600
ظننتُ بأنّكِ كنتِ ترفضينني

275
00:15:56,040 --> 00:16:00,100
لكن قلتِ في الواقع بأنّ السّبب
هو أنّكِ عدتِ إلى رشدكِ، صحيح؟

276
00:16:00,100 --> 00:16:01,810
!أيُّها الأحمق

277
00:16:03,230 --> 00:16:06,590
هذا ما يقصدونه عندما يقولون بأنّ
!تفكير الأحمق هو مضيعة للوقت

278
00:16:06,590 --> 00:16:09,760
!أفسدتَ كلّ جهودي

279
00:16:09,760 --> 00:16:13,680
ولم تكتفِ بذلك، بل ظننتَ بأنّني
وقفتُ في صفّ العدوّ؟

280
00:16:13,680 --> 00:16:18,040
كنتَ مهووساً جدّاً بالعقد الّذي وقّعته
!مع ذلك الصّغير

281
00:16:18,040 --> 00:16:20,870
صحيح بأنّني لم ألتقِ بك إلّا مؤخّراً

282
00:16:22,530 --> 00:16:27,260
رغم ذلك، آمنتُ بأنّنا شكّلنا رابطاً
!متيناً أبعد ما يُمكن عن السّطحية

283
00:16:27,260 --> 00:16:30,010
هل كان ذلك افتراضاً من جانب واحد فقط؟

284
00:16:32,030 --> 00:16:35,430
...أم أنّك كنتَ فعلاً

285
00:16:37,810 --> 00:16:40,190
أريد الاستمرار في السّفر معك

286
00:16:50,520 --> 00:16:53,710
حتّى الآن، قضيتُ كلّ حياتي أمارس العمل

287
00:16:53,710 --> 00:16:55,280
ولا أنوي تغيير ذلك

288
00:16:55,660 --> 00:17:00,290
لهذا أنا غبيّ عندما يتعلّق الأمر بأشياء أخرى

289
00:17:02,810 --> 00:17:06,120
رغم ذلك، أريد أن أسافر معكِ

290
00:17:07,250 --> 00:17:10,830
إذاً ما أكون بالنّسبة لك؟

291
00:17:13,980 --> 00:17:16,190
لا توجد كلمات تستطيع وصف ذلك

292
00:17:21,240 --> 00:17:23,540
أي عبارة لاذعة هي هذه؟

293
00:17:23,540 --> 00:17:26,190
ألا تحبّين اللّحم المقدّد اللّاذع؟

294
00:17:27,740 --> 00:17:29,260
!أكرهه

295
00:17:35,530 --> 00:17:38,090
هناك شيء أردتُ أن أسأله أيضاً

296
00:17:39,750 --> 00:17:44,080
كيف تمكّنتِ من إقناع الآنسة ديانا
ببيعكِ البيريت؟

297
00:17:50,770 --> 00:17:57,480
تمكّنتُ من اكتشاف خطّتكِ من خلال
ما أخبرني به ذلك الصّغير

298
00:17:57,960 --> 00:18:02,080
كنتُ مندهشة من قدرتك على التّفكير
في شيء كهذا. تستحقُّ إطرائي

299
00:18:02,780 --> 00:18:05,410
...وديانا

300
00:18:05,410 --> 00:18:08,420
زرتُها لسبب مختلف

301
00:18:08,420 --> 00:18:09,730
سبب مختلف؟

302
00:18:12,980 --> 00:18:16,740
رغم أنّني لا أستطيع تحمُّل
رائحة كبريت شديدة كهذه

303
00:18:17,420 --> 00:18:18,990
أخبرتُها بهذا

304
00:18:19,460 --> 00:18:24,960
أن تخترع قصّة بأنّ يويتسو ما زالت موجودة
في مكان ما وبأن تروي لك تلك القصّة

305
00:18:25,720 --> 00:18:30,290
لكن رفضت تلك الشابّة طلبي

306
00:18:30,290 --> 00:18:31,580
حقّاً؟

307
00:18:34,030 --> 00:18:35,320
بئس الأمر

308
00:18:35,320 --> 00:18:40,440
كان ذلك مُحرِجاً، لكن أخبرتُها
بالوضع وكدتُ أقنعها

309
00:18:40,440 --> 00:18:41,760
ثمّ ظهرت أنت

310
00:18:46,730 --> 00:18:48,140
هل من أحد في المنزل؟

311
00:18:48,400 --> 00:18:52,140
ثمّ فكّرتْ تلك الشابّة في خطّة لا لزوم لها

312
00:18:53,170 --> 00:18:56,570
أخبرتني بأنّني ينبغي أن أتحقّق
من عمق عزيمتك

313
00:18:56,970 --> 00:18:58,630
...تكلّمتْ كما لو أنّها تعرف كلّ شيء

314
00:18:58,990 --> 00:19:00,880
أجل، تصبح على خير

315
00:19:00,880 --> 00:19:02,010
أستأذن

316
00:19:05,140 --> 00:19:06,300
بالتّوفيق

317
00:19:09,000 --> 00:19:13,630
سمعتُ سؤالك السّخيف بشكل واضح

318
00:19:16,910 --> 00:19:18,880
هلّا طرحتُ سؤالاً؟

319
00:19:18,880 --> 00:19:20,030
تفضّل

320
00:19:20,620 --> 00:19:26,970
هل هناك أي قصّة حول إله وثنيّ
وبشريّ أصبحا زوجين؟

321
00:19:28,610 --> 00:19:29,360
أجل

322
00:19:30,090 --> 00:19:31,300
هناك الكثير

323
00:19:31,900 --> 00:19:36,200
يبدو أنّه هناك الكثير من القصص حول
آلهة وبشريّين أصبحوا أزواجاً

324
00:19:37,150 --> 00:19:40,400
لا أمانع إذا كان هذا ما تتمنّاه

325
00:19:41,070 --> 00:19:42,410
...بالمقابل

326
00:19:43,110 --> 00:19:44,810
كُن رقيقاً من فضلك

327
00:19:47,530 --> 00:19:49,250
أمزح

328
00:19:49,250 --> 00:19:52,620
لا أستطيع الانخراط في الأجواء بعد
التحدُّث مع تلك الشابّة

329
00:19:55,680 --> 00:19:58,630
هل أدركت أن تلك الشابّة ليست بشريّة؟

330
00:19:58,630 --> 00:19:59,550
ماذا؟

331
00:19:59,860 --> 00:20:02,720
كان هناك الكثير من الرّيش في غرفتها

332
00:20:02,720 --> 00:20:04,430
كان ريشها

333
00:20:04,430 --> 00:20:05,730
حقّاً؟

334
00:20:05,730 --> 00:20:08,180
كانت في الأصل طائراً أكبر حجماً بكثير منك

335
00:20:08,180 --> 00:20:12,030
ذات يوم، وقعَتْ في حبّ راهب مُتنقِّل

336
00:20:12,030 --> 00:20:14,690
وقضت سنوات طِوال تبني كنيسة معه

337
00:20:14,690 --> 00:20:19,190
ارتابَ الرّاهبُ لأنّ الشابّة
لم تكن تشيخ أبداً

338
00:20:19,690 --> 00:20:22,200
أنا متأكِّدة بأنّه يمكنك أن تخمِّن
ما حدث لاحقاً

339
00:20:33,650 --> 00:20:35,800
أتمنّى العودة إلى موطني

340
00:20:36,210 --> 00:20:39,180
حتّى لو لم يعُد موجوداً

341
00:20:39,710 --> 00:20:40,500
أجل

342
00:20:52,730 --> 00:20:55,250
يقوم البشر بأشياء مُبهرجة كهذه

343
00:20:55,250 --> 00:20:57,230
أجل. هذا مذهل

344
00:21:10,500 --> 00:21:12,380
يجب أن ننضمّ لهم

345
00:21:12,380 --> 00:21:13,790
فكرة سديدة

346
00:21:13,790 --> 00:21:18,730
لا أمانع حرق تلك الشّخصيّة القشّية بشغف

347
00:21:26,020 --> 00:21:28,890
قد يفلح هذا مع وجود بعض المشروب

348
00:21:29,240 --> 00:21:32,220
!من سيعتني بي إذا ثملت أنت؟

349
00:21:32,690 --> 00:21:34,070
!أيُّها الأحمق

350
00:23:45,870 --> 00:23:49,540
الحلقة القادمة: فتاة الكنيسة وفتى الطّاحونة