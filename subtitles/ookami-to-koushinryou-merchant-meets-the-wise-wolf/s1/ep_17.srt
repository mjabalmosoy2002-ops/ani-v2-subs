1
00:00:35,890 --> 00:00:37,180
...لا

2
00:00:37,180 --> 00:00:39,480
...لا أريد أن أكون وحيدة ثانية

3
00:00:40,020 --> 00:00:42,830
لكن هذا غير مهمّ. تذكّرتُ الآن

4
00:00:42,830 --> 00:00:47,900
هناك... أجل، هناك شخص يحبّني

5
00:00:48,420 --> 00:00:50,270
!ما أنت بالنّسبة لي؟

6
00:00:50,770 --> 00:00:53,860
!لا، ما أنا بالنّسبة لك؟

7
00:02:28,330 --> 00:02:31,000
يا إلهي. ألم أقل لك؟

8
00:02:31,420 --> 00:02:34,670
كنتَ واثقاً جدّاً. انظر إلى نفسك الآن

9
00:02:34,670 --> 00:02:36,740
كان حادثاً غير مُتوقَّع

10
00:02:36,740 --> 00:02:38,260
—كان مُفاجئاً تماماً و

11
00:02:38,260 --> 00:02:40,340
اعترِف فحسب بأنّك كنتَ مستهتراً

12
00:02:41,110 --> 00:02:42,600
كُن صادقاً مع نفسك

13
00:02:44,250 --> 00:02:45,510
معك كلّ الحقّ

14
00:02:45,850 --> 00:02:48,030
وبعد؟ لماذا أنت هنا؟

15
00:02:48,030 --> 00:02:50,740
إذا كنتَ ستطلب المال، فطلبك مرفوض

16
00:02:50,740 --> 00:02:52,300
أريد أن أعرف من أيّ اتّجاه تهبُّ الرّياح

17
00:02:52,690 --> 00:02:55,050
،حتّى لو كنتُ أخطِّط للإبحار

18
00:02:55,050 --> 00:03:00,110
كشخص من الخارج، من الصّعب
قراءة حركة السّوق اليوميّة

19
00:03:01,580 --> 00:03:02,910
استسلم

20
00:03:03,630 --> 00:03:06,780
مثلما لا تستطيع إيقاف حصان
،قد اكتسب زخماً

21
00:03:06,780 --> 00:03:09,250
من النّادر أن يتوقّف ارتفاع الأسعار فجأة

22
00:03:09,680 --> 00:03:12,790
لائحة الأسعار الّتي وُضِعت بعُجالة
بجانب تاجر الأحجار

23
00:03:12,790 --> 00:03:16,890
تُظهِر بأنّ عدد الأشخاص الّذين ينتظرون
الشّراء يظلّ يتزايد مقارنةً بالباعة

24
00:03:17,730 --> 00:03:20,880
لا أثر لانخفاض السّعر في غضون
يوم أو يومين

25
00:03:21,150 --> 00:03:25,510
إلهنا العظيم هو الوحيد الّذي يستطيع
تغيير جهة الرّياح

26
00:03:26,280 --> 00:03:28,580
إذاً سأتظاهر بأنّني الإله

27
00:03:30,030 --> 00:03:34,740
لا أتصوّر أماتي يقع ضحيّة
لانخفاض مُتوقّع في الأسعار

28
00:03:35,630 --> 00:03:38,770
هل تخطِّط لانحسار في الأسعار؟

29
00:03:38,770 --> 00:03:40,230
ماذا عسايّ أفعل غير ذلك؟

30
00:03:41,330 --> 00:03:48,420
عليّ تحويل البيريت بين يديه إلى حجر
عاديّ مع غروب شمس الغد

31
00:03:55,460 --> 00:03:58,170
...فخّ سيجعله يُسيئ تفسير حركة السّوق

32
00:03:58,610 --> 00:04:00,810
...شيء سيُسبّب انحساراً في الأسعار

33
00:04:01,720 --> 00:04:03,590
هل يوجد طريقة كهذه؟

34
00:04:04,230 --> 00:04:06,700
إذاً، سأتظاهر بأنّني الإله فحسب

35
00:04:10,750 --> 00:04:11,810
...الإله

36
00:04:12,470 --> 00:04:15,940
أخبرني ثانية من فضلك بأيّ سعر
تريد شراء هذا الفِراء؟

37
00:04:15,940 --> 00:04:21,190
...يبدو أنّ نظري قد زاغ فجأة

38
00:04:24,110 --> 00:04:25,200
عظيم يا سيّدي

39
00:04:25,500 --> 00:04:27,830
هل لديك الوقت للتردُّد؟

40
00:04:28,520 --> 00:04:29,830
...لو كانت هولو

41
00:04:38,420 --> 00:04:40,230
!انظروا إلى هذا

42
00:04:40,750 --> 00:04:42,670
لا تتفاجأوا

43
00:04:43,840 --> 00:04:45,720
...يا للهول

44
00:04:45,720 --> 00:04:48,060
لقد جازفت، أليس كذلك؟

45
00:04:48,060 --> 00:04:50,220
هل تخطّط لاعتزال عملك كتاجر قمح؟

46
00:04:50,480 --> 00:04:53,000
يُشاع بأنّ السّعر سيتضاعف يوم غد

47
00:04:53,000 --> 00:04:54,530
يتضاعف؟! هل أنت متأكّد؟

48
00:04:54,530 --> 00:04:56,150
إنّه رِهان صعب

49
00:04:56,150 --> 00:04:58,800
،إذا طويت شِراعك فقط بسبب المهرجان

50
00:04:58,800 --> 00:05:00,940
!فسوف تفوتك الفُرصة المثاليّة للإبحار

51
00:05:00,940 --> 00:05:04,860
يبدو أنّ الآن ليس الوقت المناسب
!لشراء القمح بعد

52
00:05:04,860 --> 00:05:06,520
!معك حقّ

53
00:06:03,710 --> 00:06:04,800
!كان ذلك شهيّاً

54
00:06:04,800 --> 00:06:07,230
!سمك المياه العذب كان لذيذاً كما أُشيع

55
00:06:17,730 --> 00:06:18,790
سيّد لورينس

56
00:06:20,770 --> 00:06:22,900
المعذرة

57
00:06:22,900 --> 00:06:23,880
هل يمكنني مساعدتك؟

58
00:06:23,880 --> 00:06:26,740
أحمل رسائل لك

59
00:06:27,210 --> 00:06:28,240
من المُرسِل؟

60
00:06:28,490 --> 00:06:31,100
كلتاهما من شريكتك

61
00:06:31,100 --> 00:06:34,700
واحدة كُتِبَتْ بواسطتي بدلاً من شريكتك
بناء على طلبها

62
00:06:36,150 --> 00:06:37,960
هلّا وضعت لي شمعة؟

63
00:06:40,370 --> 00:06:42,920
مئتا قطعة فضّية نقداً

64
00:06:43,260 --> 00:06:47,060
يساوي البيريت ثلاثمئة قطعة فضّية

65
00:06:47,060 --> 00:06:48,920
...أصول يمكن تصفيتها

66
00:06:49,320 --> 00:06:52,260
!هذا تقسيم أصول أماتي

67
00:06:56,680 --> 00:06:57,740
...هولو

68
00:07:01,850 --> 00:07:05,040
...هذا خطّ أماتي

69
00:07:06,150 --> 00:07:07,400
لنرَ

70
00:07:07,400 --> 00:07:09,320
...باسم الربّ

71
00:07:12,670 --> 00:07:14,910
!عقد زواج؟

72
00:07:20,070 --> 00:07:21,300
...هولو

73
00:07:26,000 --> 00:07:28,680
!من فضلك أخرِج كلّ المال الّذي تركتُه معك

74
00:07:33,910 --> 00:07:37,140
حانات يزورها السيّد أماتي بانتظام؟

75
00:07:44,740 --> 00:07:46,330
ما به؟

76
00:07:46,330 --> 00:07:48,030
!إنّه ذلك الرّجل من الرّابطة

77
00:07:53,050 --> 00:07:54,870
!أنت! انتبه لخُطواتك

78
00:08:03,050 --> 00:08:03,980
المعذرة

79
00:08:10,250 --> 00:08:11,300
مساء الخير

80
00:08:15,470 --> 00:08:16,750
هل تريد شيئاً منّي؟

81
00:08:16,750 --> 00:08:18,830
لا حاجة للخوف

82
00:08:19,180 --> 00:08:21,390
أتيتُ لأتكلّم معك بشأن العمل

83
00:08:26,040 --> 00:08:28,300
هذا مكان لطيف وهادئ

84
00:08:28,300 --> 00:08:30,940
من الصّعب الاستمتاع بشراب
بهدوء في أماكن أخرى

85
00:08:30,940 --> 00:08:32,740
هذا مكان قيِّم جدّاً بالنّسبة لي

86
00:08:33,300 --> 00:08:36,040
ما الّذي تخطِّط له؟

87
00:08:36,040 --> 00:08:40,080
بصراحة، أريدك أن تشتري البيريت الخاصّ بي

88
00:08:40,080 --> 00:08:40,680
ماذا؟

89
00:08:41,080 --> 00:08:43,420
أريدك أن تشتري البيريت الخاصّ بي

90
00:08:43,420 --> 00:08:46,170
لديّ حالياً ما قيمته 500 تريني
،فضّية من البيريت

91
00:08:46,170 --> 00:08:48,000
وفقاً للقيمة السّوقيّة اليوم

92
00:08:48,000 --> 00:08:50,060
لا بدّ أنّك تمزح

93
00:08:50,060 --> 00:08:51,550
لستُ كذلك

94
00:08:51,850 --> 00:08:55,950
تعرف سلفاً بأنّني أجني المال من إعادة
بيع البيريت، أليس كذلك؟

95
00:08:55,950 --> 00:09:00,330
بمعرفتك بذلك، ما نيّتك وراء
!بيع البيريت لي؟

96
00:09:00,330 --> 00:09:03,520
هل يُعقَل أنّك لا تُبالي للآنسة هولو فعلاً

97
00:09:03,520 --> 00:09:06,140
ما دمتَ تسترجع المال الّذي ديّنته للآخرين؟

98
00:09:06,140 --> 00:09:10,040
لا، هولو عزيزة جدّاً عليّ

99
00:09:10,040 --> 00:09:11,010
لماذا إذاً؟

100
00:09:11,010 --> 00:09:14,150
بالطّبع، لا أنوي بيعه لك فحسب

101
00:09:14,750 --> 00:09:16,570
أنوي بيعه لك بالدّين

102
00:09:16,570 --> 00:09:18,660
بالدّين؟

103
00:09:18,660 --> 00:09:19,240
أجل

104
00:09:19,240 --> 00:09:21,050
ماذا تعني؟

105
00:09:21,050 --> 00:09:24,830
بصيغة أخرى، أريد أن أبيعك البيريت الّذي
،يُساوي حالياً 500 تريني فضّية

106
00:09:24,830 --> 00:09:27,940
بقيمة السُّوق الحاليّة في مساء الغد

107
00:09:27,940 --> 00:09:31,220
إذاً تكلّم معي ثانية في مساء الغد

108
00:09:31,220 --> 00:09:33,960
لا، أرغب في الحصول على المال الآن

109
00:09:35,470 --> 00:09:40,560
بعبارة أخرى، أريد أن أحصل على 500
قطعة فضّية مُقدّماً الآن

110
00:09:40,870 --> 00:09:48,770
ثمّ سأسلّمك البيريت في مساء الغد

111
00:09:52,380 --> 00:10:02,810
أي سأحسب البيريت بسعر اليوم
حتّى لو ارتفع السّعر؟

112
00:10:02,810 --> 00:10:03,830
تماماً

113
00:10:03,830 --> 00:10:07,950
على سبيل المثال، أبيعك قطعة بيري واحدة

114
00:10:07,950 --> 00:10:10,220
قيمتها ألف ومئتا إيليد بالدَّين

115
00:10:10,220 --> 00:10:13,730
وأحصل على المال منك الآن

116
00:10:13,730 --> 00:10:17,490
ثمّ حتّى لو كانت قيمة البيريت ألفَي إيليد
،مع نهاية يوم غد

117
00:10:17,490 --> 00:10:21,300
سأعطيك قطعة البيريت رغم ذلك

118
00:10:21,890 --> 00:10:26,140
من النّاحية الأخرى، حتّى لو انخفض
،السّعر إلى مئتي إيليد

119
00:10:26,140 --> 00:10:29,680
سأحصل مع ذلك على قطعة البيريت

120
00:10:29,680 --> 00:10:31,260
تماماً

121
00:10:34,500 --> 00:10:37,070
لِمَ لا نُمارس الصّفقة بشكل طبيعيّ فحسب؟

122
00:10:37,360 --> 00:10:40,490
هناك فارق يوم فقط عن التّجارة المعياريّة

123
00:10:40,490 --> 00:10:43,340
...هذا لا يختلف عن المعتاد

124
00:10:44,650 --> 00:10:46,070
لا، هذا مختلف

125
00:10:47,430 --> 00:10:49,210
إذاً، هذه هي خطّتك

126
00:10:49,660 --> 00:10:55,670
البيع بالدَّين يعني أن تتلقّى مالاً
ببيع أداة لا تملكها

127
00:10:56,040 --> 00:10:59,620
إذا اشتريتَ بالدَّين واكتسبت السّلعة
،ذلك القدر من القيمة

128
00:10:59,620 --> 00:11:01,170
فإنّك تكسب هذا المقدار من الرّبح

129
00:11:01,170 --> 00:11:04,550
لذا، إذا بعتَ بالدَّين، تأمل أن ترتفع قيمة المال

130
00:11:05,810 --> 00:11:11,440
بصيغة أخرى، تريد من قيمة السّلعة
الّي تبيعها أن تنخفض بالقيمة

131
00:11:12,650 --> 00:11:15,640
كما هو مُتوقَّع، أنت سريع الاستيعاب

132
00:11:15,640 --> 00:11:18,010
يا لها من طريقة مُثيرة لأداء العمل

133
00:11:18,010 --> 00:11:21,990
يبدو أنّني لا أستطيع رؤية آفاق هذا
العالم إذا لم أتاجر سوى بالسّمك

134
00:11:21,990 --> 00:11:25,700
هذه المرّة، يمكنك كسب ربح تناسبيّ
من زيادة الأسعار

135
00:11:25,700 --> 00:11:28,200
إذا اشتريتَ ما قيمته 500 قطعة فضّية
،من البيريت منّي

136
00:11:28,200 --> 00:11:34,130
لكن ستكون خسائرك أكبر إذا انخفضت القيمة

137
00:11:34,130 --> 00:11:35,570
هذا صحيح

138
00:11:35,570 --> 00:11:39,640
جنيك للأرباح يعني خسارتي أنا

139
00:11:39,640 --> 00:11:41,010
...هذا

140
00:11:41,300 --> 00:11:44,970
سيّد أماتي، أتحدّاك في نِزال

141
00:11:49,540 --> 00:11:51,850
لا يمكنك أن تسمّي هذا نِزالاً

142
00:11:52,140 --> 00:11:56,500
لا يمكننا مُمارسة هذه التّجارة
دون تدوينها على ورق

143
00:11:56,500 --> 00:12:00,500
حتّى لو انخفض السّعر قبل
،نهاية يوم غد

144
00:12:00,500 --> 00:12:04,530
غالباً سأبيع مستند القرض قبل
،مدّة من نفس اليوم

145
00:12:04,530 --> 00:12:06,990
ما دامت سترتفع بما يكفي لاستيفاء
المقدار المطلوب للعقد

146
00:12:06,990 --> 00:12:10,050
هذا خطير بالنّسبة لك يا سيّد لورينس

147
00:12:10,050 --> 00:12:15,790
فأساساً، حتّى زيادة بسيطة في الأسعار
ستكون كافية لأبلغ هدفي

148
00:12:15,790 --> 00:12:22,380
لا أقبل بصفقة أكسب منها
على حساب خسارتك

149
00:12:22,950 --> 00:12:26,070
قد يبدو الأمر كذلك فقط إذا نظرت
،إلى هذه الصّفقة لوحدها

150
00:12:26,070 --> 00:12:29,380
لكن هذا المقدار من المخاطر مُناسب لي

151
00:12:29,380 --> 00:12:30,310
ماذا تقصد؟

152
00:12:30,310 --> 00:12:34,980
هناك احتمال أن تمزّق هولو
عقد الزّواج منك

153
00:12:35,450 --> 00:12:37,770
هناك اتّفاق بينك وبينها، أليس كذلك؟

154
00:12:37,770 --> 00:12:40,860
،حتّى لو سدّدتَ دَين الألف قطعة فضّية

155
00:12:40,860 --> 00:12:45,850
فأنت تتحمّل عبء خطورة احتماليّة رفضها

156
00:12:45,850 --> 00:12:49,990
مخاطري ثانويّة مُقارنةً بمخاطرك

157
00:12:50,950 --> 00:12:54,410
لا أعتقد بأنّ هذا شيئاً تحتاج للقلق بشأنه

158
00:12:54,410 --> 00:12:57,130
سمعتُ بأنّكما دخلتُما في شِجار عنيف

159
00:12:58,200 --> 00:13:02,210
بكتْ هولو بين ذِراعَي ثلاث مرّات
منذ بدأنا السّفر معاً

160
00:13:03,920 --> 00:13:09,420
،إنّها ظريفة جدّاً عندما تفعل ذلك
لكنّها عنيدة

161
00:13:10,300 --> 00:13:13,180
هناك أوقات تتصرّف فيها بما يُعارض مشاعرها

162
00:13:13,740 --> 00:13:14,590
...بعبارة أخرى

163
00:13:15,900 --> 00:13:17,370
قبِلت

164
00:13:17,370 --> 00:13:19,690
قبلت تحدّيك يا سيّد لورينس

165
00:13:20,190 --> 00:13:22,660
...أنا... أنا

166
00:13:22,660 --> 00:13:29,000
ظننتُ أنّني سأكون قاسياً جدّاً
إذا انتزعتُ منك كلّ شيء

167
00:13:29,000 --> 00:13:32,950
،لكن، إذا كانت هذه هي طريقة كلامك
فإنّني أقبل بهذا التحدّي

168
00:13:33,640 --> 00:13:38,460
بهذا، سوف أنتزع منك كلّ شيء
!يا سيّد لورينس

169
00:13:42,200 --> 00:13:44,340
إذاً هل تقبل بهذه الصّفقة؟

170
00:13:47,490 --> 00:13:49,010
!بكلّ سرور

171
00:13:56,740 --> 00:13:57,940
!بصحّتك

172
00:14:06,420 --> 00:14:07,570
!هذه بيرة لذيذة

173
00:14:07,880 --> 00:14:10,900
كان حصاد القمح ممتازاً في هذا العام

174
00:14:10,900 --> 00:14:14,820
يجب أن يُستخدَم القمح للبيرة من أجل
الخبز كبديل عندما يكون الحصاد سيّئاً

175
00:14:14,820 --> 00:14:17,000
!أعتقد علينا أن نشكر آلهة الحصاد على ذلك

176
00:14:18,830 --> 00:14:20,040
!معك حقّ

177
00:14:20,880 --> 00:14:25,310
لكن عملي معك أكثر جدّية من أن
...أخبرك أثناء الشّرب

178
00:14:25,870 --> 00:14:27,130
هل هو مخطّط لدرّ المال؟

179
00:14:27,460 --> 00:14:29,140
...أتساءل حول ذلك

180
00:14:29,140 --> 00:14:32,390
إنّه مُربِح من ناحية، لكن ليس
هذا هدفي في هذه المرّة

181
00:14:32,680 --> 00:14:33,740
ماذا يعني؟

182
00:14:33,740 --> 00:14:37,570
ألا يتركّز شراء القمح بالجملة
عادة في نهاية المهرجان؟

183
00:14:37,570 --> 00:14:39,370
بلى

184
00:14:39,370 --> 00:14:42,230
أرغب في نشر إشاعة معيّنة

185
00:14:42,570 --> 00:14:44,700
أنا لا أفعل أيّ شيء خطير

186
00:14:44,700 --> 00:14:46,860
،قد يكون هذا خطيراً إذا نشرتها بمفردك

187
00:14:47,190 --> 00:14:50,660
لكن لا ينبغي أن تكون مشكلة
إذا نشرها المُتدرِّب لديك

188
00:14:51,970 --> 00:14:53,050
أخبرني ما هي

189
00:14:53,050 --> 00:14:56,290
:عندما أعطي الإشارة، أريده أن يقول

190
00:14:57,090 --> 00:15:00,000
أتساءل ما إن حان الوقت لأسعار"
"القمح أن ترتفع

191
00:15:02,660 --> 00:15:06,210
هل تنوي جعل أسعار تلك الحجارة
ينخفض باستخدام إشاعة؟

192
00:15:06,460 --> 00:15:07,760
شيء من هذا القبيل

193
00:15:08,380 --> 00:15:10,780
مُعظم الأشخاص الّذين يُتاجرون يُسافرون

194
00:15:10,780 --> 00:15:15,140
لبيع شيء وشراء شيء قبل
العودة إلى الدّيار

195
00:15:15,140 --> 00:15:19,270
السّلعة الّتي يشترونها لاستعادتها
هي القمح عادة

196
00:15:20,080 --> 00:15:25,130
،إذا أُشيع بأنّ سعر القمح سيرتفع
فإنّهم يُسارعون لشرائه قبل حدوث ذلك

197
00:15:25,590 --> 00:15:29,930
سيبيعون البيريت الّذي اشتروه لكسب
بعض المال الجانبيّ دُفعة واحدة

198
00:15:30,350 --> 00:15:35,080
وهذا سيخفض تلقائيّاً سعر البيريت؟

199
00:15:35,550 --> 00:15:39,960
لم أتوقّع أن تكون بهذه السّذاجة

200
00:15:39,960 --> 00:15:41,330
هذا ليس كلّ شيء

201
00:15:41,330 --> 00:15:44,780
...حالما يُطرَح كلّ ذلك البيريت في السُّوق

202
00:15:44,780 --> 00:15:45,840
كم الثّمن؟

203
00:15:46,190 --> 00:15:47,880
ألف تريني فضّية

204
00:15:47,880 --> 00:15:48,890
!ألف؟

205
00:15:48,890 --> 00:15:52,700
!هل أنت أحمق؟! تخيّل كم سيؤذي هذا مِحفظتك

206
00:15:52,700 --> 00:15:54,480
لا يهمّ مهما انخفضت الأسعار

207
00:15:55,150 --> 00:15:56,470
!ما الّذي تقوله بالضّبط؟

208
00:15:56,720 --> 00:16:00,380
ما دمتُ أستطيع كسب ما قيمته
،خمسمئة فضّية من البيريت

209
00:16:00,380 --> 00:16:04,060
فإنّ مِحفظتي لن تتأثّر سواء
ارتفعت الأسعار أو انخفضت

210
00:16:05,770 --> 00:16:08,110
تبّاً. بعتَ بالدَّين

211
00:16:08,110 --> 00:16:12,510
،اجل. أنا أتاجر بشكل منتظم بالدَّين

212
00:16:12,510 --> 00:16:17,390
لذا مِحفظتي آمنة سواء ارتفع
سعر البيريت أم انخفض

213
00:16:17,390 --> 00:16:19,230
بالمقابل، لا أكسب شيئاً أيضاً

214
00:16:20,870 --> 00:16:24,340
قد يخسر أماتي كثيراً من المال
أو قد يُفلس

215
00:16:24,340 --> 00:16:26,750
يبدو أنّك استغللت جهله

216
00:16:26,750 --> 00:16:29,250
لا، أظنّه قَبِلَ بالتحدِّي وهو
على دِراية كاملة بالمخاطر

217
00:16:29,250 --> 00:16:30,820
هذا ما قاله

218
00:16:30,820 --> 00:16:35,240
إذاً مع ذلك تمكّنتَ من إقناعه بالقبول
بلِسانك الفصيح هذا

219
00:16:35,240 --> 00:16:36,590
يا لك من رجل مُخيف

220
00:16:36,590 --> 00:16:39,930
أهذا كلّ ما أردت منّي فعله؟

221
00:16:39,930 --> 00:16:41,230
ثمّة أمر آخر

222
00:16:41,230 --> 00:16:43,060
أريدك أن تشتري مقدراً كبيراً من البيريت

223
00:16:43,530 --> 00:16:46,330
لم تجد مكاناً لشراء البيريت
!قبل توقيع العقد معه؟

224
00:16:46,330 --> 00:16:48,690
مع الأسف، لم يُسعفني الوقت

225
00:16:48,690 --> 00:16:53,150
إذا تجوّلتُ لشراء كثير من البيريت
،عندما تشرق الشّمس

226
00:16:53,150 --> 00:16:55,950
فستستمرّ الأسعار بالارتفاع فحسب

227
00:16:55,950 --> 00:16:59,440
أريد جمعه سرّاً دون التّأثير بالسُّوق

228
00:16:59,870 --> 00:17:03,870
لهذا أريدك أن تستخدم علاقاتك
كتاجر في البلدة

229
00:17:04,890 --> 00:17:08,890
ولا بأس إذا اشتريتَه بسعر أعلى قليلاً
من قيمة السُّوق الحاليّة نقداً

230
00:17:08,890 --> 00:17:12,260
سأدفع بقطع لوميوني ذهبيّة
حالما تجمع ما يكفي

231
00:17:12,260 --> 00:17:14,860
وبالطّبع، سأدفع لك جيّداً مقابل جهودك أيضاً

232
00:17:14,860 --> 00:17:15,720
لا أستطيع

233
00:17:15,720 --> 00:17:18,140
فهمت. إذاً... ماذا؟

234
00:17:20,610 --> 00:17:22,850
لا يمكنني مساعدتك في هذه

235
00:17:22,850 --> 00:17:26,670
سوف أدفع لك! أنا لا أقصد أجراً بسيطاً

236
00:17:26,670 --> 00:17:29,920
!ليس لديك ما تخسره! أليست صفقة جيّدة؟

237
00:17:29,920 --> 00:17:31,150
ليس لديّ ما أخسره؟

238
00:17:31,150 --> 00:17:36,040
بالطّبع! كلّ ما أطلبه منك هو
!شِراء البيريت

239
00:17:36,040 --> 00:17:37,700
لا أطلب منك الاستثمار

240
00:17:37,700 --> 00:17:39,870
وبالطّبع، سأدفع لك نقداً

241
00:17:39,870 --> 00:17:41,610
ما الّذي ستخسره في ظرف كهذا؟

242
00:17:42,230 --> 00:17:46,860
لورينس، أقصى ما يمكنك دفعه
هو حوالي 10 لوميوني، صحيح؟

243
00:17:46,860 --> 00:17:48,500
!أليس هذا كافياً؟

244
00:17:48,810 --> 00:17:52,020
أنا لا أطلب منك عبور الجبال
شديدة الانحدار لوحدك

245
00:17:52,020 --> 00:17:55,380
والعودة بمقدار هائل من البيريت

246
00:17:55,380 --> 00:18:00,430
تطلب منّي التجوُّل في السُّوق
وجمع البيريت لأجلك

247
00:18:00,430 --> 00:18:01,580
لا فرق بين هذا وذاك

248
00:18:01,580 --> 00:18:03,140
!كيف ذلك...؟

249
00:18:07,990 --> 00:18:13,470
أريدك فقط أن تستخدم علاقاتك
لشراء البيريت

250
00:18:13,470 --> 00:18:16,460
ما أقوله لك هو أنَّ الخطر هو نفسه

251
00:18:17,400 --> 00:18:20,700
المخاطر الّتي تتحدّث عنها تتعلّق
بالتُجّار المُسافرين

252
00:18:20,700 --> 00:18:24,950
لكن أنا تاجر بلدة وساحة معركتي هي السُّوق

253
00:18:24,950 --> 00:18:29,260
ليس من الفضيلة أن ينقضّ تاجرُ بلدة
على كلّ فُرصة لجني أموال ضخمة

254
00:18:29,730 --> 00:18:33,050
يُفضِّل تُجّار البلدة قضاء حياة
مُتواضعة بعملهم الأساسيّ

255
00:18:33,050 --> 00:18:36,010
على جني أرباح كبيرة في غِمار جانبيّ

256
00:18:37,050 --> 00:18:39,080
ما الّذي سيقوله النّاس عنّي إذا تجوّلتُ

257
00:18:39,080 --> 00:18:41,670
أجمع ما قيمته خمسمئة فضّية من البيريت؟

258
00:18:41,670 --> 00:18:43,130
سيظنّونني رجلاً بائساً

259
00:18:43,130 --> 00:18:46,720
أغرقَ نفسه في المُراهنات وتخلّى عن عربته

260
00:18:46,970 --> 00:18:51,230
قد أكون مالك هذه الغربة، لكن لستُ
الوحيد الّذي يُعدّ جزءاً من ذلك

261
00:18:51,230 --> 00:18:53,610
،كلّ من دعمَ هذا المكان

262
00:18:53,610 --> 00:18:57,820
زوجتي وأطفالي وكلّ أقربائنا

263
00:18:58,100 --> 00:19:00,950
كرامة كلّ أولئك النّاس مرتبطة بهذه العربة

264
00:19:01,300 --> 00:19:04,740
هل يمكنك أن تدفع لي ما يكفي
من مال للمُخاطرة بكرامتهم؟

265
00:19:05,330 --> 00:19:10,990
حتّى بالنّسبة لمحلّ كهذا، سعر لافتتي
باهظ إلى حدٍّ مفاجئ

266
00:19:11,390 --> 00:19:16,670
إذا تضرّرت، فإنَّ عشرة أو عشرين
ذهبيّة ليست كافية

267
00:19:21,140 --> 00:19:22,930
هكذا تسير الأمور

268
00:19:25,070 --> 00:19:26,040
آسف

269
00:19:27,400 --> 00:19:30,190
لا، أنا من يعتذر على طلبي غير المنطقيّ

270
00:19:31,930 --> 00:19:34,940
حسناً، أنا متأكّد بأنّه ليس باليد حيلة
نظراً لشريكتك تلك

271
00:19:35,620 --> 00:19:39,100
لستَ بحاجة لإعاقته بهذه الاستماتة

272
00:19:39,100 --> 00:19:41,980
فهي لن تميل له بتلك السّهولة، صحيح؟

273
00:19:42,490 --> 00:19:46,720
حتّى أنا خطر على ذهني ذلك، بعد
رؤيتك بجانبها للمرّة الأولى

274
00:19:47,230 --> 00:19:48,750
!يجدر بك أن تتحلّى بثِقة أكبر

275
00:19:49,140 --> 00:19:52,290
صُدِمتُ بعقد زواج وعليه توقيعها

276
00:19:52,290 --> 00:19:54,410
والطّرف الآخر هو أماتي بالطّبع

277
00:19:54,830 --> 00:19:58,350
لستُ من النّوع الّذي يفقد الثِّقة
من دون سبب وجيه

278
00:19:58,350 --> 00:20:00,350
لكن الآن، حدث شيء

279
00:20:01,590 --> 00:20:03,990
في هذا العالم، كلّ خطوة أمامك
تكون حالكة السّواد

280
00:20:04,420 --> 00:20:09,140
لكن مع ذلك تجري لأنّ لديك فُرصة، صحيح؟

281
00:20:09,140 --> 00:20:11,720
وبعد؟ هل لديك مداخل أخرى؟

282
00:20:11,720 --> 00:20:14,880
سأحاول التكلُّم مع السيّد باتوس أوّلاً

283
00:20:14,880 --> 00:20:15,860
هكذا إذاً

284
00:20:15,860 --> 00:20:18,650
تنوي الاستفادة من تلك المرأة

285
00:20:19,080 --> 00:20:20,090
تلك المرأة؟

286
00:20:20,090 --> 00:20:21,680
ماذا؟ هل أنا مُخطئ؟

287
00:20:21,680 --> 00:20:24,110
ألم تلتقِ بتلك المُؤرِّخة؟

288
00:20:24,510 --> 00:20:27,840
التقيتُ بالآنسة ديانا، لكن لا أفهم
ما تتحدّث عنه

289
00:20:28,280 --> 00:20:32,860
أعتقد لا ضير من أن يُتاجر غريبٌ
مثلك مع تلك المرأة

290
00:20:32,860 --> 00:20:34,370
ما زلتُ لم أفهم ما تقصده

291
00:20:34,370 --> 00:20:37,800
تتحكّم تلك المرأة بالحيّ الشّماليّ

292
00:20:37,800 --> 00:20:41,550
هي تحديداً من يجب التكلُّم معها إذا
أردتَ التّعامل مع الخيميائيّين

293
00:20:41,860 --> 00:20:46,300
الخيميائيّون مُستهدَفون دوماً لأسباب مختلفة

294
00:20:46,600 --> 00:20:49,790
الجميع يعتقدون بأنّ السّبب الوحيد وراء
تجمُّع الكثيرين منهم هو تلك المرأة

295
00:20:49,790 --> 00:20:50,600
وماذا يعني؟

296
00:20:50,600 --> 00:20:54,020
!يمتلك الخيميائيّون حجر البيريت

297
00:20:54,810 --> 00:21:00,760
إنّهم من النّوع الّذين لا تفلح
معهم التّجارة الحسنة أبداً

298
00:21:00,760 --> 00:21:01,960
...بعبارة أخرى

299
00:21:01,960 --> 00:21:04,530
!لم يلمس أحدٌ حجر البيريت الخاصّ بهم

300
00:21:04,810 --> 00:21:08,980
،أنا سعيد لأنّك فكّرتَ في الاعتماد عليّ
لكن هذا كلّ ما يمكنني فعله لأجلك

301
00:21:08,980 --> 00:21:12,080
!لا، كدتُ أُفوِّت فُرصة ضخمة

302
00:21:12,630 --> 00:21:16,130
أعلم بأنّني رفضتُ طلبك، لكن
أتمنّى نجاحك حقّاً

303
00:21:16,130 --> 00:21:19,290
تعلّمتُ شيئاً. هذا بحدِّ ذاته كسب غير مُتوقَّع

304
00:21:22,410 --> 00:21:24,720
،لا أستطيع فعل الأمور بشكل علنيّ

305
00:21:24,720 --> 00:21:28,380
لكن يمكنني على الأقلّ أن أهمس
حول الوضع المالي في أذن الآخرين

306
00:21:29,080 --> 00:21:34,310
عُد لاحقاً. يمكنني على الأقلّ أن أحدِّد
أماكنَ قد تكون مهتمّة بالبيع

307
00:21:35,340 --> 00:21:36,350
!سيكون هذا نافعاً

308
00:21:36,780 --> 00:21:42,510
.عجيب أن تصبح تعابير وجهك هكذا
لا عجب في أنّها أقدمَتْ على فعل جريء كهذا

309
00:21:42,510 --> 00:21:43,730
ماذا تقصد؟

310
00:21:43,730 --> 00:21:44,780
لا شيء إطلاقاً

311
00:21:44,780 --> 00:21:48,450
أقول فقط أنّ التُجّار عليهم أن يستمرّوا
في التّفكير في العمل

312
00:21:50,360 --> 00:21:52,450
أنا متأكّد بأنّ رياحاً جيّدة ستهبّ

313
00:21:52,830 --> 00:21:54,080
!حسناً، ابذل قصارى جهدك

314
00:21:57,530 --> 00:21:58,460
!إلى اللّقاء

315
00:23:45,820 --> 00:23:49,390
الحلقة القادمة: حسن النّوايا وعزيمة المُفاوضات