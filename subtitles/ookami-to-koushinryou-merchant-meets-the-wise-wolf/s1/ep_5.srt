1
00:02:00,690 --> 00:02:02,600
تجسيد ذئب؟

2
00:02:02,600 --> 00:02:06,410
إذاً هذه الرّسالة هي حتماً
شكل من أشكال التّهديد

3
00:02:06,410 --> 00:02:11,730
سيرسلونها إلى الكنيسة إذا لم ننسحب
من هذا حتّى ينتهي كلّ شيء

4
00:02:11,730 --> 00:02:16,110
أجل، لكن لا يوجد ما يضمن بأنّهم
لن يرسلوها إلى الكنيسة بعد ذلك

5
00:02:16,110 --> 00:02:18,120
علاوة على ذلك، استثمرنا بالفعل

6
00:02:18,120 --> 00:02:21,700
كثيراً من قطع تريني الفضّية
الّتي تضخّمت من حيث السّعر

7
00:02:22,030 --> 00:02:25,490
سنخسر خسارة هائلة إذا تراجعنا
عند هذه النّقطة

8
00:02:25,490 --> 00:02:27,500
!معنى هذا أنّ علينا أن نستخدم الخشونة

9
00:02:30,980 --> 00:02:34,670
لكن لنفترض أنّنا استرجعنا شريكتك
...ووضعناها تحت رعايتنا

10
00:02:35,000 --> 00:02:38,200
،إذا تمّ الإبلاغ عنّا وتدخّلت الكنيسة

11
00:02:38,200 --> 00:02:41,180
لا يمكننا سوى أن نصبح حملهم المُطيع

12
00:02:41,540 --> 00:02:44,370
لا يمكننا أن نخبئها في أيّ مكان في هذه البلدة

13
00:02:44,370 --> 00:02:46,460
ماذا عن الهرب من البلدة؟

14
00:02:46,460 --> 00:02:48,860
هناك أراضٍ عشبيّة على مدِّ النّظر

15
00:02:48,860 --> 00:02:51,310
سيتطلّب النّجاح في ذلك مقداراً
كبيراً من الحظّ

16
00:02:51,310 --> 00:02:57,780
.وقد يُبلَغ عنها في بلدة أخرى
حينها لا يسعنا فعل شيء

17
00:02:58,260 --> 00:03:02,780
نظراً إلى أرباحهم المرتقبة، لا نستطيع
حلّ هذه المسألة بالمال

18
00:03:03,200 --> 00:03:07,570
الأرباح الّتي قد يكسبونها من الممكن
أن تدمّرنا نحن، شركتهم المنافسة

19
00:03:07,570 --> 00:03:12,460
إذاً ألا يمكننا سوى السّماح لهم بإتمام هذه الصّفقة
ونرى ما إذا كان سيُبلَغ عنّا للكنيسة؟

20
00:03:12,850 --> 00:03:15,400
...ليتنا نمتلك ورقة رابحة ما

21
00:03:15,400 --> 00:03:17,340
هناك طريقة واحدة

22
00:03:17,700 --> 00:03:23,220
يمكننا الإبلاغ عن شركة ميديو
بأنّها تأوي شريكتك

23
00:03:23,830 --> 00:03:26,930
لكن ستواجه مشكلة مع ذلك، صحيح؟

24
00:03:26,930 --> 00:03:30,640
وقد تشهد ضدّنا حتّى

25
00:03:31,970 --> 00:03:33,560
سأفعل بالتّأكيد

26
00:03:47,980 --> 00:03:50,620
المنفعة الكبرى من قطع تريني الفضّية تلك

27
00:03:50,620 --> 00:03:54,320
هي الحصول على امتياز ما من ملِك تريني، صحيح؟

28
00:03:54,320 --> 00:03:55,090
أجل

29
00:03:55,090 --> 00:03:59,740
وفقاً لتحقيقاتنا، الحالة المادّية للعائلة
الملكيّة في حالة ضيق حاليّاً

30
00:03:59,740 --> 00:04:01,010
هذا ما أتصوّره

31
00:04:01,520 --> 00:04:04,540
فأساساً، يحاولون إذابة قطعهم الفضّية الحاليّة

32
00:04:08,610 --> 00:04:10,660
،سيحقّق هذا منافعَ على المدى القصير

33
00:04:10,660 --> 00:04:14,310
لكن سيدمّر هيبة العائلة الملكيّة
ويسبّب ضرراً أكثر من منفعة

34
00:04:14,740 --> 00:04:19,980
لا بدّ أنّ حالتهم المادّية في ضائقة
شديدة حتّى يلجؤوا لأمر كهذا

35
00:04:23,810 --> 00:04:27,010
،من أجل استبدال القطع النّقديّة ذات نقاوة أعلى

36
00:04:27,010 --> 00:04:29,980
سيتخلّون غالباً عن حقوق التّعدين
وحقوق تحديد التّعرفة

37
00:04:29,980 --> 00:04:34,580
وحقوق إدارة السّوق لصالحنا

38
00:04:34,580 --> 00:04:39,660
هذا أكبر ربح سنكسبه من شراء
قطعهم النّقديّة الفضّية

39
00:04:39,660 --> 00:04:40,750
...إذاً

40
00:04:41,120 --> 00:04:45,940
ما رأيك بإنهاء صفقتنا قبل أن تبلغ
شركةُ ميديو التّجاريّة عنّا

41
00:04:45,940 --> 00:04:49,810
واستخدام ذاك الرّبح الأكبر كورقتنا الرّابحة؟

42
00:04:51,470 --> 00:04:53,600
تريدنا أن نسمح لهم بشراء الامتياز منّا؟

43
00:04:53,600 --> 00:04:58,500
أجل، إذا جعلنا الشّراءَ أكثر ربحاً
،من إغلاق شركتكم

44
00:04:58,500 --> 00:05:02,130
فلن تبلغ ميديو التّجاريّة عنّا

45
00:05:02,130 --> 00:05:08,560
ورقتهم الرّابحة الحاليّة يمكن أن تحرقنا

46
00:05:08,560 --> 00:05:10,720
هل سيقبلون؟

47
00:05:10,720 --> 00:05:14,610
بالطّبع، من فضلك ضع بالحسبان
موقف ملِك تريني

48
00:05:15,750 --> 00:05:19,740
لن يرغب الملكُ أن يعرف العامّة
بأنّهم تعاونوا مع شركة تجاريّة

49
00:05:19,740 --> 00:05:21,460
قد أُرسِلَتْ إلى المحرقة

50
00:05:21,460 --> 00:05:23,000
فهمت

51
00:05:23,000 --> 00:05:29,720
إذا تمّ استهدافنا بواسطة الكنيسة، فمملكة
تريني سوف تُستهدَف أيضاً

52
00:05:29,720 --> 00:05:32,260
،إذا أتممنا صفقتنا أوّلاً

53
00:05:32,260 --> 00:05:36,280
فلن تتمكّن شركةُ ميديو التّجاريّة من الإبلاغ
عنّا خشيةً من ملِك تريني

54
00:05:36,280 --> 00:05:39,030
إذا فعلوا، فسيُغرِقون أنفسهم معنا

55
00:05:44,990 --> 00:05:48,650
إذا ظهرنا في وضعٍ كهذا وعرضنا
الحقوقَ الّتي يريدونها

56
00:05:48,650 --> 00:05:52,620
...مقابل سعر مناسب وشريكتك

57
00:05:53,300 --> 00:05:56,650
أجل، أنا متأكّدٌ بأنّهم سيوافقون

58
00:05:56,650 --> 00:06:00,310
ستكون هذه الطّريقة الوحيدة الّتي تتمكّن فيها
ميديو التّجاريّة من تحصيل الحقوق

59
00:06:12,730 --> 00:06:17,770
منطِقُك سليم. لكن لا تزال هناك
مشكلة كبيرة قائمة

60
00:06:18,120 --> 00:06:19,980
،وفقاً لتحليلي

61
00:06:19,980 --> 00:06:23,230
ميديو التّجارية لم تجمع كلّ القطع
الفضّية الّتي تحتاجها

62
00:06:23,230 --> 00:06:24,850
لماذا تعتقد ذلك برأيك؟

63
00:06:24,850 --> 00:06:27,440
هذه صفقةٌ تستغلّ نقطةَ ضعف ملِك

64
00:06:27,940 --> 00:06:32,180
،لهذا كانوا يجذبون التجّار ويجمعونها سرّاً

65
00:06:32,180 --> 00:06:35,080
وذلك كي يتمكّنوا من الحصول على قطع
فضّية رخيصة قدر الإمكان

66
00:06:35,390 --> 00:06:37,820
،لو كانوا قد جمعوا ما يكفي من فضّة

67
00:06:37,820 --> 00:06:40,750
لأرسلوا هولو إلى الكنيسة فوراً

68
00:06:40,750 --> 00:06:43,860
حقيقة استغلالهم لها لإيقاف
تحرّكاتنا بدلاً من ذلك

69
00:06:43,860 --> 00:06:46,340
تُثبِت قلّة ثقتهم

70
00:06:46,340 --> 00:06:50,130
بصيغة أخرى، في هذه المرحلة
لم يجمعوا ما يكفي من فضّة

71
00:06:50,130 --> 00:06:51,340
هكذا إذاً

72
00:06:52,080 --> 00:06:55,560
إذاً ما الإجراء الّذي تنوي اتّخاذه يا سيّد لورينس؟

73
00:06:57,060 --> 00:07:01,230
سأستعيد هولو منهم وأستمرّ
في الهرب حتّى إتمام صفقتك

74
00:07:02,440 --> 00:07:03,620
!هذا طيش

75
00:07:03,620 --> 00:07:06,940
،حتّى لو لم أستطع التملّص منهم
يمكننا إكساب أنفسنا بعض الوقت

76
00:07:06,940 --> 00:07:10,480
من فضلك اجمع ما تبقّى من الفضّة
وأتمم الصّفقة قبل ذلك الحين

77
00:07:10,480 --> 00:07:11,740
!هذا مستحيل

78
00:07:12,630 --> 00:07:14,780
إذاً هل ينبغي أن نبلغ عن هولو؟

79
00:07:15,090 --> 00:07:18,120
!سوف أشهد ضدّكم حتماً

80
00:07:19,730 --> 00:07:23,380
بمساعدتك، أنا متأكّد بأنّنا نستطيع تجنّب
الأسر ليوم أو يومين

81
00:07:23,650 --> 00:07:26,460
مُجسِّدة الذّئب سوف تهرب معي

82
00:07:26,460 --> 00:07:30,380
سمحَتْ لنفسها أن يُقبَض عليها في هذه
المرّة كي تفسح المجال لي للهرب

83
00:07:30,380 --> 00:07:34,530
،لو استخدمَتْ قوّتها الحقيقيّة
لما قَدِرَ عليها أيّ خصم

84
00:07:37,570 --> 00:07:38,890
دعني أطرح عليك هذا السّؤال

85
00:07:39,290 --> 00:07:43,940
كم ستستغرقون من وقت لجمع ما يكفي
من فضّة والتّفاوض مع الملك؟

86
00:07:46,530 --> 00:07:49,420
،إذا توجّهنا إلى قلعة تريني بحصان

87
00:07:49,420 --> 00:07:51,700
فينبغي أن نتمكّن من إتمام الصّفقة
قبل غروب الشّمس غداً

88
00:07:51,700 --> 00:07:54,020
،إذا أتممنا الصّفقة بنجاح

89
00:07:54,020 --> 00:07:57,340
فإنّ أقرب وقت يمكننا العودة فيه هو
بعد يوم غد فجراً

90
00:07:57,340 --> 00:07:58,410
بهذه السّرعة؟

91
00:07:58,730 --> 00:08:02,180
رغم أنّكم ما زلتُم لا تملكون كلّ الفضّة؟

92
00:08:02,180 --> 00:08:05,120
يمكننا التّفاوض باستخدام الأرقام المُقدَّرة

93
00:08:05,120 --> 00:08:09,420
لن تكون مشكلة ما دمنا نملك القطع
النّقديّة في وقت التّسليم

94
00:08:09,420 --> 00:08:12,380
هل تعتقدون بأنّكم ستتمكّنون من التّفاوض
مع الملك فوراً؟

95
00:08:13,860 --> 00:08:19,470
،إذا أمست ميلوني التّجاريّة جادّة
فإنّ أي مُفاوضات يمكن إجراؤها فوراً

96
00:08:21,060 --> 00:08:24,480
إذاً يجب عليك أن تعرف أين
تُحتجَز هولو حاليّاً

97
00:08:27,010 --> 00:08:30,230
نحن شركة ميلوني التّجاريّة

98
00:08:30,230 --> 00:08:32,680
يتعرّض موظّفونا لهجوم في الظّلام

99
00:08:32,680 --> 00:08:37,000
واحتراق أبنيتنا هو حدثٌ يوميّ

100
00:08:37,000 --> 00:08:40,300
إجراءات الطّوارئ خاصّتنا مثاليّة

101
00:08:40,300 --> 00:08:43,250
غير أنّ هناك جداراً كبيراً يسدّ طريقنا

102
00:08:43,250 --> 00:08:44,720
الكنيسة

103
00:08:44,720 --> 00:08:45,880
هذا صحيح

104
00:08:45,880 --> 00:08:49,400
لديها ارتباطات أكثر ممّا لدينا
عبر بلاد مختلفة

105
00:08:49,400 --> 00:08:51,630
إنّهم مستعدّون لاتّخاذ الإجراءات في أيّ وقت

106
00:08:51,630 --> 00:08:56,130
لهذا يجب علينا إنهاء كلّ هذا
قبل أن يقرّروا التحرُّك

107
00:08:56,740 --> 00:09:02,560
في العادة، لا نتحرّك حتّى ما لم نعرف
من كان يدعم ميديو التّجاريّة

108
00:09:02,560 --> 00:09:09,120
بهذا الشّكل، بوسعنا رسم خطط ملائمة
وربّما ننتزع تمويلهم كذلك

109
00:09:09,120 --> 00:09:10,860
هذا مؤسفٌ حقّاً

110
00:09:12,690 --> 00:09:15,700
أتمنّى لك السّلامة والنّجاح

111
00:09:16,530 --> 00:09:18,450
!سوف أنجح بكلّ تأكيد

112
00:09:19,580 --> 00:09:23,140
كلمات مرورنا هي بيريون ونوماي

113
00:09:23,140 --> 00:09:24,720
قطعتان ذهبيّتان رئيسيّتان؟

114
00:09:24,720 --> 00:09:26,160
ألا يمنح هذا حظّاً؟

115
00:09:40,230 --> 00:09:42,140
هل حفظت الطّريق؟

116
00:09:42,140 --> 00:09:43,340
،حالما أنزل إلى تحت الأرض

117
00:09:43,340 --> 00:09:46,480
يجدر بي أن أتقدّم للأمام ويدي
تلمس الجدار الأيمن، صحيح؟

118
00:09:46,480 --> 00:09:47,140
أجل

119
00:09:47,450 --> 00:09:49,730
من فضلك انتظرنا في آخر ذاك الطّريق

120
00:09:49,730 --> 00:09:52,940
البناء الّذي فوق تلك النّقطة هو
حيث تُحتجَز هولو، صحيح؟

121
00:09:52,940 --> 00:09:55,170
أجل. تمَّ التحقُّق من معلوماتنا

122
00:09:55,170 --> 00:09:58,450
سنبدأ عمليّة استعادتها مع قرع
جرس افتتاح السّوق

123
00:09:58,820 --> 00:10:03,660
إذا نجحنا، سيُفتَح الغطاء فوقك
وستنضمّ لك شريكتُك

124
00:10:03,660 --> 00:10:07,900
،"في تلك اللّحظة، إذا سمعتَ كلمة "راهّي
انتظر زميلي حتّى ينضمّ لك

125
00:10:07,900 --> 00:10:12,000
إذا سمعتَ "بيروسو"، فاهرب فوراً
من فضلك عبر الطّريق المُخطَّط

126
00:10:12,000 --> 00:10:14,100
إذاً سيكون إمّا "نجاحاً" أو "فشلاً"؟

127
00:10:14,100 --> 00:10:15,540
هذا سهل الفهم، أليس كذلك؟

128
00:10:19,750 --> 00:10:21,330
اقترب الوقت

129
00:10:34,310 --> 00:10:35,780
!كان ذلك خطيراً

130
00:10:36,370 --> 00:10:37,570
!كن حذراً

131
00:10:37,570 --> 00:10:38,750
!أنا آسف

132
00:10:40,590 --> 00:10:41,540
سيّد لورينس

133
00:10:42,030 --> 00:10:43,430
حان الوقت الآن

134
00:10:52,890 --> 00:10:53,870
!بسرعة

135
00:11:04,220 --> 00:11:06,680
...لا أصدّق بأنّهم حضّروا كلّ هذا

136
00:11:08,540 --> 00:11:12,920
سمعتُ بأنّ الكنيسة تستخدم
حفر القبور كواجهة

137
00:11:12,920 --> 00:11:15,750
لحفر معابر تحت الأرض لهدف
...التخفّي والتهرّب الضّريبيّ

138
00:11:25,220 --> 00:11:26,810
...ينبغي أن يكون هذا هو المكان

139
00:12:04,070 --> 00:12:07,430
...أرجوك، لا تكُن قاسياً

140
00:12:13,620 --> 00:12:15,730
!لِمَ أنا أرتجف؟

141
00:12:40,910 --> 00:12:42,070
...تأخّروا كثيراً

142
00:12:42,630 --> 00:12:44,980
هل أخطأتُ المكان؟

143
00:12:45,410 --> 00:12:46,430
راهّي

144
00:12:48,310 --> 00:12:49,280
راهّي

145
00:12:49,280 --> 00:12:50,220
!نوماي

146
00:12:51,140 --> 00:12:52,200
بيريون

147
00:13:01,710 --> 00:13:02,670
!هولو

148
00:13:03,950 --> 00:13:07,090
تريدنا أن نأخذ هذا ونجعل الأمر
يبدو وكأنّه عمليّة سرقة؟

149
00:13:07,090 --> 00:13:08,020
!بسرعة

150
00:13:08,730 --> 00:13:11,050
لا يمكنني النّزول ما لم تبتعد عن الطّريق

151
00:13:11,050 --> 00:13:11,520
ماذا؟

152
00:13:12,150 --> 00:13:14,470
أ-أجل

153
00:13:19,420 --> 00:13:20,300
—هو

154
00:13:20,980 --> 00:13:22,810
لِمَ تقف مكانك هكذا؟

155
00:13:23,910 --> 00:13:27,410
هذه حصّتك. بسرعة. خذها واذهب

156
00:13:27,410 --> 00:13:29,030
!حـ-حسناً

157
00:14:09,670 --> 00:14:10,450
بيريون

158
00:14:12,250 --> 00:14:13,610
!بيريون

159
00:14:13,610 --> 00:14:14,460
نوماي

160
00:14:26,450 --> 00:14:28,340
...يبدو أنّ الأمور تسير على ما يُرام

161
00:14:33,580 --> 00:14:36,350
!عالم الأعمال مليء بالمفاجآت

162
00:14:38,580 --> 00:14:40,100
كان هناك شخص آخر

163
00:14:40,100 --> 00:14:42,440
سيخرج من مخرج مختلف

164
00:14:42,830 --> 00:14:46,780
سنغادر البلدة بعد أن أنقل بعض المعلومات
عن ميديو التّجاريّة لزميل

165
00:14:46,780 --> 00:14:48,140
كم أنت دقيق

166
00:14:48,140 --> 00:14:49,860
أتمنّى لكما التّوفيق

167
00:14:51,890 --> 00:14:52,860
سالك

168
00:15:03,510 --> 00:15:05,150
يسرّني أنّكِ بخير

169
00:15:06,100 --> 00:15:08,660
يسرّك أنّني بخير؟

170
00:15:09,210 --> 00:15:10,220
أجل

171
00:15:11,250 --> 00:15:13,220
نادِني باسمي

172
00:15:13,220 --> 00:15:14,760
هولو، صحيح؟

173
00:15:14,760 --> 00:15:16,310
!الذّئبة الحكيمة هولو

174
00:15:16,780 --> 00:15:22,720
يمكنني إحصاء كلّ شخص أحرجني
!في حياتي كلّها حتّى الآن

175
00:15:22,720 --> 00:15:25,440
!والآن يجب أن أحفظ اسماً آخر

176
00:15:25,900 --> 00:15:27,400
!أقصدك أنت

177
00:15:28,190 --> 00:15:30,400
!قلتُ لك بوضوح، أليس كذلك؟

178
00:15:30,690 --> 00:15:32,820
!أن تأتي لأجلي

179
00:15:33,160 --> 00:15:34,890
أ-أجل

180
00:15:34,890 --> 00:15:36,330
...أنا

181
00:15:36,860 --> 00:15:40,410
كنتُ متأكّدة بأنّك كنتَ أنت
...من أتى لأجلي و

182
00:15:42,050 --> 00:15:44,830
!مجرّد التّفكير في الأمر يُغضبني

183
00:15:44,830 --> 00:15:47,130
...هل تقصدين أنّكِ

184
00:15:47,130 --> 00:15:51,800
لو كنتَ ذكراً لكشّرتَ عن أنيابك
!وانقضضتَ نحو ساحة المعركة

185
00:15:51,800 --> 00:15:54,840
!بدلاً من ذلك، اختبأتَ في ذلك الوكر

186
00:15:55,290 --> 00:15:59,110
!تمّ إذلالي بلا ضرورة بسبب ذلك

187
00:16:00,150 --> 00:16:02,310
لكنّكِ بخير، أليس كذلك؟

188
00:16:06,870 --> 00:16:08,780
يسرّني أنّكِ بخير

189
00:16:14,740 --> 00:16:18,940
لا يمكنني الموت ما دمتَ تحتفظ بذلك القمح

190
00:16:19,740 --> 00:16:23,460
أنا ظريفة. يقع الذّكور البشر ضحيّةً لي بسهولة

191
00:16:24,330 --> 00:16:28,880
رغم ذلك، لا يستطيع أي ذكر
بشريّ تحمُّل التّعامل معي

192
00:16:28,880 --> 00:16:31,880
عندما قلتُ لهم بأنّ ذلك الشّيء الّذي
،يخصُّهم سيُقتلَع إذا لمسوني

193
00:16:31,880 --> 00:16:34,420
شَحُبَتْ وجوههم ذُعراً

194
00:16:34,830 --> 00:16:36,260
...أنتِ

195
00:16:38,550 --> 00:16:39,660
يا إلهي

196
00:16:40,210 --> 00:16:41,890
كان هناك شخص غريب آخر

197
00:16:43,060 --> 00:16:47,150
من كان برأيك من بين أولئك
الّذين قبضوا عليّ؟

198
00:16:49,420 --> 00:16:51,060
من كان؟

199
00:16:52,630 --> 00:16:53,650
ياري

200
00:16:54,060 --> 00:16:55,160
تعرفه، أليس كذلك؟

201
00:16:55,160 --> 00:16:56,410
!ياري؟

202
00:16:56,410 --> 00:16:57,660
من قرية باسلوي

203
00:16:58,150 --> 00:17:00,910
يبدو أنّه سَمِعَ اسمي من زيرين

204
00:17:01,300 --> 00:17:03,670
هل تكلّمتِ معه؟

205
00:17:04,420 --> 00:17:05,910
قليلاً فقط

206
00:17:08,340 --> 00:17:10,670
ماذا قال ياري لي برأيك؟

207
00:17:20,970 --> 00:17:24,730
قال زيرين بأنّ اسمكِ هو هولو

208
00:17:26,180 --> 00:17:29,150
حينئذ فكّرتُ باحتمال وهو أن تكوني

209
00:17:30,170 --> 00:17:32,610
إله الحصاد من قريتي

210
00:17:34,300 --> 00:17:36,070
أنتِ هي فعلاً

211
00:17:43,530 --> 00:17:46,660
...أنا... في الواقع، أنا

212
00:17:48,070 --> 00:17:50,490
هذا مثيرٌ للشّفقة، لكن أسعدني ذلك كثيراً

213
00:17:51,870 --> 00:17:55,220
:لكن سرعان ما قال لي

214
00:17:57,240 --> 00:18:00,970
عصر محاولة كسب ودّكِ قد انتهى

215
00:18:00,970 --> 00:18:04,310
لم يعد هناك حاجة للخوف من سوء مزاجكِ

216
00:18:04,860 --> 00:18:09,270
سنُسلّمكِ للكنيسة ونقول وداعاً للحقبة القديمة

217
00:18:14,230 --> 00:18:18,230
...شعرتُ بالاستياء الشّديد والحزن

218
00:18:28,750 --> 00:18:31,390
حسناً، فكّري في الأمر من ناحية مختلفة

219
00:18:35,300 --> 00:18:38,970
في كلّ الأحوال، ترتّب عليكِ مغادرة
القرية من أجل العودة نحو الشّمال

220
00:18:39,330 --> 00:18:41,250
،إذا لم يكونوا نادمين على وداعكِ

221
00:18:41,250 --> 00:18:43,390
فابصقي في وجوههم قبل أن تغادري

222
00:18:43,730 --> 00:18:45,780
ستتمكّنين من قطع روابطكِ
بسهولة أكبر بهذا الشّكل

223
00:18:46,300 --> 00:18:48,640
لكن عندما تغادرين، ستجعلينهم يدفعون ثمناً

224
00:18:48,640 --> 00:18:52,220
نحن تجّار. كلّ شيء مناسب
ما دام يُجنينا المال

225
00:18:55,150 --> 00:18:59,480
،لا نضحك ما لم نحصل على المال
ولا نبكي ما لم نُفلِس

226
00:18:59,480 --> 00:19:00,510
،وأنتِ وأنا

227
00:19:02,270 --> 00:19:03,910
سنضحك بكلّ تأكيد

228
00:19:12,470 --> 00:19:14,290
أجل، أشعر بتحسّن كبير

229
00:19:15,830 --> 00:19:19,300
لم أتكلّم كما ينبغي مع أحد منذ مئات السّنين

230
00:19:20,580 --> 00:19:23,140
أصبحتُ ضعيفة أمام العواطف

231
00:19:23,140 --> 00:19:25,570
،رغم أنّني بكيتُ أمامك مرّتين

232
00:19:25,570 --> 00:19:27,810
فأنا متأكّدة بأنّني كنتُ لأبكي
سواء كنتَ هنا أو لا

233
00:19:28,120 --> 00:19:30,540
هل تفهم ما أحاول قوله؟

234
00:19:30,540 --> 00:19:32,180
ألّا أسيئ الفهم؟

235
00:19:32,180 --> 00:19:32,940
صحيح

236
00:19:33,290 --> 00:19:36,200
!أنا أفعل كلّ شيء لأجل المال فقط

237
00:19:36,200 --> 00:19:40,200
عملنا هو الاستمرار في الهرب حتّى
تختتم شركةُ ميلوني التّجاريّة الصّفقة

238
00:19:40,200 --> 00:19:43,200
ستصبحين عائقاً إذا ظللتِ تبكين طوال الوقت

239
00:19:43,620 --> 00:19:47,660
...لهذا السّبب حتّى لولاكِ، لكنتُ قد

240
00:19:51,070 --> 00:19:52,970
هذا ليس عدلاً

241
00:19:53,540 --> 00:19:55,310
امتياز أنثى، أليس كذلك؟

242
00:19:59,330 --> 00:20:00,920
وصلنا

243
00:20:00,920 --> 00:20:03,820
هل حُلّت الأمور بينكما؟

244
00:20:03,820 --> 00:20:04,930
ليس بعد

245
00:20:05,890 --> 00:20:09,930
الكونت أيريندوت هو من يقف
وراء ميديو التّجاريّة

246
00:20:10,210 --> 00:20:12,730
التجّار الّذين يتاجرون بالقمح
في منطقة الكونت هم

247
00:20:12,730 --> 00:20:14,650
الّذين استُهدِفوا لجمع القطع الفضّية

248
00:20:14,650 --> 00:20:16,650
من فضلك أخبر السيّد مارلهايت بذلك

249
00:20:16,650 --> 00:20:18,060
لا عليك

250
00:20:18,550 --> 00:20:21,820
كما هو مُتوقَّع، الأشخاص الّذين
يرسمون الأفكار لدرّ الأموال

251
00:20:21,820 --> 00:20:23,150
مختلفون قليلاً عن الآخرين

252
00:20:23,150 --> 00:20:25,380
هل تقصد أُذنَيّ؟

253
00:20:26,680 --> 00:20:31,750
كنتُ أفكّر في أن أصبح تاجراً
ثانية بعد أن رأيتكما

254
00:20:32,990 --> 00:20:34,420
هذه ليست فكرة جيّدة

255
00:20:35,250 --> 00:20:37,670
فسوف ينتهي المطاف بمُرافقتك
بواسطة شخص مثلها

256
00:20:38,180 --> 00:20:41,970
لا مشكلة، فمقصورة سائق كبيرة
جدّاً على شخص واحد

257
00:20:42,760 --> 00:20:44,840
هذه أقصى أمنياتي

258
00:20:55,450 --> 00:20:58,530
أنا أيضاً غارقة في فوضى فظيعة
بعد أن رافقتني

259
00:21:00,060 --> 00:21:01,780
كما توقّعتُ، لستِ مُنصِفة

260
00:21:01,780 --> 00:21:04,070
لكن أبقى ظريفة، أليس كذلك؟

261
00:21:05,660 --> 00:21:08,570
حسناً، لا أنكر بأنّكِ ظريفة

262
00:21:12,590 --> 00:21:13,750
أنا مسرورة

263
00:21:16,100 --> 00:21:19,130
أنت فتى ظريف بحدِّ ذاتك

264
00:23:45,900 --> 00:23:49,270
الحلقة القادمة: تاجر وإله غير منطقيّ