1
00:00:10,570 --> 00:00:12,690
يسرّني أنّها لم تُقفل القاعدة

2
00:00:12,690 --> 00:00:13,820
هل تشعرين بأيّ أحد قريب؟

3
00:00:13,820 --> 00:00:15,450
لا. لا يوجد أحد

4
00:00:16,370 --> 00:00:18,680
سأذهب للبحث عن الأدوات الّتي نحتاجها

5
00:00:23,960 --> 00:00:27,130
،ما دام يسير كلّ شيء على ما يُرام
ستتمكّنين من استغراق وقتكِ في القراءة

6
00:00:27,130 --> 00:00:28,330
...معك حقّ

7
00:02:01,380 --> 00:02:02,500
!سيّد لورينس

8
00:02:04,200 --> 00:02:04,970
!هنا

9
00:02:04,970 --> 00:02:07,400
والآن كلّ ما علينا هو إيجاد الوقت المُناسب

10
00:02:09,390 --> 00:02:10,650
كيف تسير الأمور؟

11
00:02:11,010 --> 00:02:12,390
هل يمكنكِ معرفة ما يقولونه؟

12
00:02:15,020 --> 00:02:17,150
يطلبون مالاً

13
00:02:20,010 --> 00:02:23,090
هو من خطّط لنصب فخّ لنا

14
00:02:23,090 --> 00:02:25,300
!أنت! ماذا تفعل بالضّبط؟

15
00:02:25,300 --> 00:02:26,840
...هذا

16
00:02:27,890 --> 00:02:31,420
إنّه الخبّاز. أكثر مَن يشتكي لي

17
00:02:33,490 --> 00:02:35,080
انتهى الأمر

18
00:02:35,080 --> 00:02:37,590
تلقّوا إنذارهم الأخير

19
00:02:48,140 --> 00:02:52,230
سيكون كلّ شيء على ما يُرام إذا أشعلتُم"
"هذا بالنّار وقبلتم بالتّعاليم الحقيقيّة

20
00:02:52,230 --> 00:02:55,560
"وإلّا، سنعلن عن أنَّ قريتكم وثنيّة"

21
00:02:56,610 --> 00:02:59,400
يعتمد البشر على الآخرين دوماً
عندما يقعون في ورطة

22
00:03:00,010 --> 00:03:03,720
مع ذلك، مرّت أوقات اعتمدتُ
فيها على البشر كذلك

23
00:03:03,720 --> 00:03:05,310
ماذا سنفعل؟

24
00:03:08,000 --> 00:03:10,650
،كخادمة للإيمان الحقيقيّ

25
00:03:10,650 --> 00:03:12,750
لا أستطيع التخلِّي عن قريتي

26
00:03:17,410 --> 00:03:18,920
لذا، فلنتقدّم

27
00:03:32,290 --> 00:03:33,240
!إيلسا

28
00:03:34,700 --> 00:03:36,840
!إيلسا! لماذا؟

29
00:03:36,840 --> 00:03:38,720
أنا آسفة يا سيّدة إيما

30
00:03:38,720 --> 00:03:40,170
حسناً، حسناً

31
00:03:40,170 --> 00:03:42,700
إنّها الآنسة إيلسا، وريثة البابا
فرانز دون سِواها

32
00:03:42,700 --> 00:03:45,540
مضى وقت طويل يا حضرة
الأُسقُف مينديز

33
00:03:45,540 --> 00:03:47,870
قيل لي بأنّكِ هربتِ

34
00:03:47,870 --> 00:03:50,660
هل كان ذنبكِ أثقل من أن يتحمّله ضميركِ؟

35
00:03:50,660 --> 00:03:54,120
الربّ يغفر دوماً لأولئك الّذين ارتكبوا خطايا

36
00:03:55,570 --> 00:03:59,790
،شعب إنبيرك، الّذي يتبع الإيمان الحقيقيّ
،كان يعاني من هذه اللّعنة

37
00:03:59,790 --> 00:04:03,260
في حين أنّ شعب تيريو لم يتأثّر

38
00:04:05,010 --> 00:04:09,850
من الواضح بأنّهم تحت حماية إله وثنيّ شرّير

39
00:04:10,360 --> 00:04:15,690
سنُعيد بناء كنيسة مُقدّسة وجديدة
تمثِّل الإيمان الحقيقيّ هنا

40
00:04:15,690 --> 00:04:23,010
الخادم المُزيّف للربّ هو أفعى شرّيرة
سامّة بصورة حمل وديع

41
00:04:23,010 --> 00:04:25,990
سيُواجه عقوبة إلَهنا الأكثر عدلاً

42
00:04:27,080 --> 00:04:28,830
لا ضرورة لذلك

43
00:04:29,140 --> 00:04:32,330
صحيح أنّ إيماني يترنّح أحياناً

44
00:04:32,690 --> 00:04:37,040
لكن هداني الربُّ إلى الطّريق الصّحيح

45
00:04:37,510 --> 00:04:40,340
!التقيتُ بأحد مبعوثيه الإلهيّين

46
00:04:46,220 --> 00:04:50,940
حقيقة ادّعائكِ بأنّكِ التقيتِ بمبعوث
!إلهيّ ببساطة هو دليل على زندقتكِ

47
00:04:50,940 --> 00:04:54,560
!إن كنتُ مُخطِئاً، فأريني الدّليل

48
00:04:55,860 --> 00:04:58,190
!اسمح لي أن أريك إن كانت تنتابك شكوك

49
00:05:03,180 --> 00:05:04,860
اسمحا لهما بالعبور

50
00:05:05,940 --> 00:05:08,990
كان البابا فرانز رجلاً موهوباً

51
00:05:08,990 --> 00:05:12,580
كان خادم ربّ مُثيراً للإعجاب

52
00:05:12,580 --> 00:05:16,750
غير أنّه كان ينبغي أن يتصرّف
بموجب إرادة الكنيسة

53
00:05:16,750 --> 00:05:20,750
يبدو أنّه فشل أيضاً في رعاية خليفة مُناسبة

54
00:05:20,750 --> 00:05:24,590
،عبادة الإله الثّعبان، ترويو
هو خطأ بلا شكّ

55
00:05:25,030 --> 00:05:28,590
غير أنّ الخطأ بحدِّ ذاته ليس فادحاً

56
00:05:31,510 --> 00:05:34,480
أؤمن بأنّ ترويو بحدِّ ذاتها

57
00:05:36,190 --> 00:05:39,520
هو إحدى مُعجزات الربّ

58
00:05:40,910 --> 00:05:45,280
لم تؤكّد ولم تنكر ترويو. حركة ذكيّة

59
00:05:45,280 --> 00:05:49,030
كلام البشر سرعان ما ينحرف عن الحقيقة

60
00:05:49,030 --> 00:05:52,480
كيف لكِ أن تجزمي بأنّها لم تكن
وسوسات الشّيطات؟

61
00:05:52,480 --> 00:05:55,810
،وعدَني المبعوث الإلهيّ بالكشف عن إشارة

62
00:05:55,810 --> 00:06:00,420
لهداية حملان الربّ التّائهة
إلى الطّريق الصّواب

63
00:06:01,610 --> 00:06:03,760
...أن يُظهِر ذلك الإله قوّته لشخص

64
00:06:04,380 --> 00:06:05,840
!ا-القمح

65
00:06:34,900 --> 00:06:37,920
!إله! إنّها مُعجزة إله

66
00:06:37,920 --> 00:06:39,000
!إله

67
00:06:40,830 --> 00:06:42,580
...هـ-هذا

68
00:06:42,580 --> 00:06:45,000
!انظرو! القمح على تلك العربة

69
00:06:45,000 --> 00:06:47,590
!نما قمح هناك

70
00:06:57,540 --> 00:07:00,080
أظهرَ لنا الربُّ الطّريقَ الصّواب

71
00:07:00,080 --> 00:07:02,870
...مـ-مستحيل. هذا

72
00:07:03,650 --> 00:07:09,600
الأُسقُف مينديز. أريدك أن تتحقّق
بأنّ هذا ليس فعل شيطان

73
00:07:09,600 --> 00:07:11,550
كـ-كيف؟

74
00:07:13,020 --> 00:07:14,240
بهذا

75
00:07:14,530 --> 00:07:17,410
بارِك بهذا الكأس المُقدَّس من فضلك

76
00:07:17,410 --> 00:07:21,050
حالما تفعل هذا، فإنّ إيفان، الّذي
،يطحن قمح هذه القرية

77
00:07:21,050 --> 00:07:23,750
سيُثبِت نقاء الربّ بجسده

78
00:07:23,750 --> 00:07:26,540
ما-ماذا تنوين أن تُثبتي بهذا بالضّبط؟

79
00:07:26,540 --> 00:07:30,340
حتّى الفقير قد يُعمَّد باسم الربّ

80
00:07:30,340 --> 00:07:34,470
من فضلك طهِّر هذا الكأس المُقدّس بيديك

81
00:07:39,070 --> 00:07:40,100
من فضلك

82
00:07:49,590 --> 00:07:54,160
الماء الّذي سكبّه الأُسقُف هو ماء
مُقدّس وهذا الكأس قد بُورِك

83
00:07:54,560 --> 00:07:57,030
خذ هذا الكأس إليه هناك

84
00:08:00,550 --> 00:08:02,380
راقبوا جيّداً رجاء

85
00:08:24,020 --> 00:08:29,320
بهذا، باستثناء واحدة، جمع طحيناً
من كلّ عربة

86
00:08:44,760 --> 00:08:50,880
هذه هي مُعجزة حقيقة الإله
الّتي كشفها لنا المبعوث الإلهيّ

87
00:08:52,580 --> 00:08:57,640
إذا كانت هذه المُعجزة باطلة، فيجدر
بك أن تُرينا مُعجزة حقيقيّة

88
00:08:58,590 --> 00:09:05,160
،الأُسقُف مينديز. إن كنّا على خطأ
فيجب عليك تقويمنا

89
00:09:06,600 --> 00:09:08,730
هل ستشرب هذا الماء؟

90
00:09:13,250 --> 00:09:17,860
حـ-حسناً. هذه مُعجزة. مُعجزة حقيقيّة

91
00:09:17,860 --> 00:09:20,310
إذاً ماذا عن كنيسة هذه القبرية

92
00:09:22,020 --> 00:09:25,070
شرعيّة. إنّها كنيسة شرعيّة

93
00:09:25,070 --> 00:09:27,550
إذاً دوّن ذلك كتابياً لو سمحت

94
00:09:46,780 --> 00:09:48,050
...أبتي

95
00:09:48,050 --> 00:09:49,270
شكراً لك

96
00:09:52,930 --> 00:09:54,540
كأنّك شعرت بالغيرة

97
00:09:54,540 --> 00:09:56,570
أجل، صحيح

98
00:09:56,990 --> 00:09:59,660
هذه المرّة، لم نعمل إلّا وراء الكواليس

99
00:10:01,270 --> 00:10:06,580
.لكن مُشكلة المال ما زالت لم تُحَلّ
أليس هذا عملك؟

100
00:10:06,580 --> 00:10:07,810
معكِ حقّ

101
00:10:07,810 --> 00:10:11,130
...لكن لا أصدِّق كيف انقلبت الموازين تماماً

102
00:10:17,570 --> 00:10:20,340
أجل، أعتقد يمكنني إنجاح الأمور؟

103
00:10:22,520 --> 00:10:23,280
ما الأمر؟

104
00:10:23,280 --> 00:10:27,220
هل أنت متأكّد بأنّك لست ذئباً بحدِّ ذاتك؟

105
00:10:32,100 --> 00:10:33,260
سيّد ريندوت

106
00:10:34,010 --> 00:10:35,700
انتظر لحظة من فضلك

107
00:10:39,770 --> 00:10:42,910
،صحيح أنّهم عالجوا المشاكل الدّينيّة

108
00:10:43,280 --> 00:10:45,740
لكن ما زال علينا حسم الشّؤون الماليّة

109
00:10:49,820 --> 00:10:51,660
لذا يا سيّد ريندوت

110
00:10:51,660 --> 00:10:52,710
!حـ-حاضر

111
00:10:53,070 --> 00:10:56,470
طُلِب منّي تولّي كافّة المُفاوضات الماليّة

112
00:10:56,980 --> 00:10:59,190
أنا متأكّد بأنّ أهل القرية لا اعتراض لديهم

113
00:11:00,470 --> 00:11:02,890
...لا يمكننا مُعارضة كبير القرية

114
00:11:03,410 --> 00:11:05,180
هذا ما في الأمر

115
00:11:05,180 --> 00:11:08,850
إذاً، فلنبدأ بالمطلب الأعظم

116
00:11:09,430 --> 00:11:11,480
نريدك أن تُحافظ على القمح

117
00:11:15,450 --> 00:11:16,690
!هـ-هذا مستحيل

118
00:11:16,690 --> 00:11:17,790
لماذا؟

119
00:11:17,790 --> 00:11:21,070
!لـ-لماذا؟ سقطت ضحيّة

120
00:11:21,070 --> 00:11:24,610
!تضرّرت سمعة محلّي بالفعل

121
00:11:24,610 --> 00:11:25,950
...بالإضافة، بالإضافة إلى ذلك

122
00:11:25,950 --> 00:11:29,790
ينصّ عقدُنا مع البابا فرانز بأنّه يمكن

123
00:11:29,790 --> 00:11:33,250
إعادة القمح كلّه إذا عُثِر
فيه على نار جحيم ريديليوس

124
00:11:33,560 --> 00:11:34,580
فهمت

125
00:11:34,580 --> 00:11:38,100
إذاً ما هو سعر قبول القمح المُرتجَع؟

126
00:11:40,010 --> 00:11:41,300
...مـ-مئتا ري

127
00:11:41,300 --> 00:11:42,550
!كفاك هُراء

128
00:11:44,260 --> 00:11:47,770
!هذا نفس السّعر الّذي اشتريته به تماماً

129
00:11:47,770 --> 00:11:51,520
...إ-إ-إ-إذاً مئة وخمسة وتسعين

130
00:11:51,520 --> 00:11:53,380
!ما زلت تتفوّه بكلام فارغ

131
00:11:53,380 --> 00:11:54,350
اهدأ، اهدأ

132
00:11:54,720 --> 00:11:55,790
سيّد ريندوت

133
00:11:55,790 --> 00:12:00,570
ألن يكون من السيّئ بالنّسبة لك
إذا حدثت مُعجزة أخرى؟

134
00:12:00,570 --> 00:12:01,640
!ماذا؟

135
00:12:01,640 --> 00:12:04,090
—رواية القمح السّامّ هي في الواقع

136
00:12:04,090 --> 00:12:07,970
!لا! لا! فهمت! فهمت

137
00:12:07,970 --> 00:12:10,950
...مئة وستّة

138
00:12:10,950 --> 00:12:16,630
...لا، خمـ... أربعون

139
00:12:20,060 --> 00:12:22,260
إذاً لنعتمد هذا

140
00:12:22,260 --> 00:12:24,050
فليشهد الجميع على ذلك

141
00:12:27,270 --> 00:12:28,920
بالمناسبة يا سيّد ريندوت

142
00:12:29,350 --> 00:12:32,850
هل ترغب في شراء وإعادة
القمح الّذي أرجعتَه؟

143
00:12:34,700 --> 00:12:35,940
فهمت

144
00:12:35,940 --> 00:12:38,290
لكن لا يملك سكّان هذه القرية

145
00:12:38,290 --> 00:12:40,230
ما يكفي من مال بمتناول اليد
ليُسدّدوه ثمن القمح المُرتجَع

146
00:12:40,230 --> 00:12:42,470
حتّى بالكلفة المُخفّضة، ما زال
ينقصهم المال

147
00:12:43,930 --> 00:12:45,780
لذا لديّ اقتراح

148
00:12:46,840 --> 00:12:48,290
إنّه بسيط

149
00:12:48,290 --> 00:12:54,240
أريدك أن تُقنع الأُسقُف بالسّماح للقرية
ببيع القمح باسمه

150
00:12:54,240 --> 00:12:54,920
ماذا؟

151
00:12:55,920 --> 00:13:01,180
إذا كنت تنوي بيع هذا القمح لمُنشآت
...أخرى، فينبغي أن تفقد الأمل

152
00:13:01,180 --> 00:13:03,210
أدرك هذا تمام الإدراك

153
00:13:03,210 --> 00:13:06,280
لذا هل يمكنك أن تصنع هذا المعروف لأجلنا؟

154
00:13:06,280 --> 00:13:08,890
...أ-أعتقد يمكنني

155
00:13:08,890 --> 00:13:09,970
إذاً، هناك أمر آخر

156
00:13:09,970 --> 00:13:15,380
هناك احتمال بأن يُسبّب شعب
إنبيرك مُشكلة لعملي

157
00:13:15,380 --> 00:13:18,940
أريدك أن تكون حليفي في هذه الحالة

158
00:13:20,010 --> 00:13:22,570
هل يُعقَل أنّك تفكِّر في صنع الخبز؟

159
00:13:22,570 --> 00:13:26,200
لا. من المؤكَّد أنّ الخبّازين لن يسمحوا
بشيء كهذا. لا تقلق

160
00:13:26,200 --> 00:13:28,260
...ما-ما الّذي

161
00:13:28,260 --> 00:13:33,290
مهلاً، مهلاً. سنُعيد المال حالما
يسير ذلك العمل على ما يُرام

162
00:13:33,290 --> 00:13:35,810
...لا، لا أقبل بوضع كهذا

163
00:13:35,810 --> 00:13:37,960
بالطّبع، أنا لا أقول بأن تنتظر مجّاناً

164
00:13:38,330 --> 00:13:41,090
سأضيف شرطاً جذّاباً جدّاً

165
00:13:43,060 --> 00:13:46,340
ما رأيك أن نفضّ العقد الّذي
أبرمَه البابا فرانز؟

166
00:13:48,340 --> 00:13:50,010
!لا يحقّ أن تقرّر ذلك بنفسك

167
00:13:50,010 --> 00:13:52,120
!حتّى لو فوّضك كبير القرية بالمُفاوضات

168
00:13:52,120 --> 00:13:54,990
،لكن ما دام العقد سارياً

169
00:13:54,990 --> 00:13:57,810
ستستمرّ بلدة إنبيرك في كرهكم

170
00:14:00,120 --> 00:14:01,480
هل كلامي صحيح؟

171
00:14:02,930 --> 00:14:05,490
كان هذا العقد غير عاديّ من الأساس

172
00:14:06,060 --> 00:14:08,990
ينبغي أن تكون العقود مفيدة للطّرفين

173
00:14:08,990 --> 00:14:11,340
هكذا يكون العمل

174
00:14:12,780 --> 00:14:15,950
ما رأيكم؟ هل ستفعلون ما أطلبه؟

175
00:14:15,950 --> 00:14:16,760
!مهلاً

176
00:14:16,760 --> 00:14:17,530
...لكن

177
00:14:17,530 --> 00:14:21,130
إذا كان السيّد ريندوت والأُسقُف مينديز
،يريدان الوقوف في صفنّا

178
00:14:21,130 --> 00:14:25,050
فيمكنني أن أقترح فكرة عمل
على هذه القرية

179
00:14:28,410 --> 00:14:30,330
...ما الّذي

180
00:14:30,330 --> 00:14:34,090
لكن سنحتاج بعض التّعاون من الخبّاز

181
00:14:35,140 --> 00:14:38,390
وأيضاً، هل يمكنك تحضير
بعض البيض والزّبدة؟

182
00:14:38,390 --> 00:14:40,100
وعسل أيضاً إن كان ممكناً

183
00:14:41,540 --> 00:14:44,960
يبدو أنّ هذا المُقترح سيؤدّي
إلى شيء شهيّ

184
00:14:52,410 --> 00:14:54,700
لا تأكلي بينما تقرئين

185
00:14:56,300 --> 00:14:58,480
لا تدع الفُتات يتناثر في كلّ مكان

186
00:14:58,480 --> 00:15:01,320
حسناً، حسناً. فهمت

187
00:15:05,130 --> 00:15:08,620
هذا "البسكويت" شهيّ

188
00:15:09,550 --> 00:15:13,430
تحقِّق مبيعات جيّدة في إنبيرك
كطعام تختصّ به تيريو

189
00:15:13,430 --> 00:15:20,100
على هذا المُعدّل، لن نتمكّن فحسب من إعادة
المال، بل سنُحقّق ربحاً كذلك

190
00:15:20,610 --> 00:15:24,940
من كان يتوقّع أن تكون الخبزة المُسطّحة
الّتي تحدّثت عنها ستكون بهذه اللّذّة

191
00:15:24,940 --> 00:15:27,940
،أجل، إنّها شائعة في الجنوب
،لكن مجهولة هنا

192
00:15:27,940 --> 00:15:31,910
لذا ارتأيتُ أنّها ستكون مهنة جيّدة

193
00:15:31,910 --> 00:15:33,570
،بالرّغم من أنّ القمح هو المُستخدَم

194
00:15:33,570 --> 00:15:36,370
خُبِز قبل برَكة الأرواح المُغادِرة للخبز

195
00:15:36,370 --> 00:15:40,540
لا تُشبه الخبز، لذا الخبّازون
لا يملكون سبباً للتذمُّر

196
00:15:40,920 --> 00:15:42,750
،،حسناً، حتّى لو حدث شيء

197
00:15:42,750 --> 00:15:46,590
أبرمنا عقداً يُرضي الطّرفين مع ريندوت
والأُسقُف مينديز

198
00:15:46,590 --> 00:15:48,130
أنا متأكّد بأنّهم سيتولّون الأمر

199
00:15:48,130 --> 00:15:50,290
لكن كان من الصّعب مُعاينة

200
00:15:50,290 --> 00:15:53,430
كافّة أكياس القمح للتحقُّق
...من عدم وجود سمّ

201
00:15:54,290 --> 00:15:56,260
حسناً، ينبغي أن نذهب قريباً

202
00:15:56,260 --> 00:15:58,090
ماذا؟ من الآن؟

203
00:16:01,310 --> 00:16:03,480
حسناً، أعتقد ينبغي لنا ذلك

204
00:16:09,240 --> 00:16:12,030
من فضلك زورينا مجدّداً متى رغبتِ
في قراءة الكُتُب

205
00:16:12,030 --> 00:16:14,090
...إذاً، احرصي

206
00:16:16,870 --> 00:16:19,240
على تحضير الكثير من البسكويت عندما أفعل

207
00:16:19,630 --> 00:16:20,830
بالطّبع

208
00:16:20,830 --> 00:16:22,750
!سأطحن كمّية هائلة من الطّحين لأجلك

209
00:16:22,750 --> 00:16:25,740
فهمت. إذاً سأحرص على تحقيق ربح ضخم

210
00:16:25,740 --> 00:16:28,160
بذلك الطّحين في المرّة المقبلة
الّتي نأتي فيها للزيارة

211
00:16:30,740 --> 00:16:31,940
هذا صحيح

212
00:16:31,940 --> 00:16:35,340
تغيّر سلوك القرويّين منذ ذلك الحين

213
00:16:35,340 --> 00:16:39,970
تمّ تعييني لتولّي أمر مُفاوضاتنا مع إنبيرك

214
00:16:39,970 --> 00:16:42,020
هذا مذهل

215
00:16:42,020 --> 00:16:46,230
مؤخّراً، بات يأتي أُناس أكثر إلى الكنيسة

216
00:16:46,230 --> 00:16:50,690
رغم ذلك، الربّ ترويو ما زال أشهر بكثير

217
00:16:51,040 --> 00:16:53,150
...صحيح. لكن

218
00:16:53,480 --> 00:16:58,810
أريد متابعة واجبي كخادمة للإله
هنا في هذه القرية

219
00:17:00,340 --> 00:17:03,450
آنسة إيلسا، طرحتِ عليّ سؤالاً من قبل

220
00:17:03,860 --> 00:17:06,210
هل عثرتِ على إجابتكِ؟

221
00:17:06,210 --> 00:17:06,920
أجل

222
00:17:07,310 --> 00:17:11,670
قلتَ لي بأنّ أبتي لم يكن مُخطِئاً

223
00:17:12,320 --> 00:17:15,380
فكّرتُ في الأمر مليّاً

224
00:17:15,760 --> 00:17:19,880
لماذا جمع أبي قصصاً عن الآلهة الوثنيّين؟

225
00:17:20,780 --> 00:17:27,930
أعتقد بأنّه أراد التحقُّق من وجود آلهة وثنيّين

226
00:17:27,930 --> 00:17:29,980
للتحقُّق من وجود الربّ

227
00:17:29,980 --> 00:17:32,420
أجل. أتّفق

228
00:17:32,420 --> 00:17:37,680
هذا هو السّبب عينه الّذي يجعلني أؤمن
بأنّه ليس من مصلحة كنيسة إنبيرك

229
00:17:37,680 --> 00:17:40,180
دحض وجود ترويو

230
00:17:40,180 --> 00:17:44,520
حسناً، كان كلّ هذا بفضل المُعجزة
الّتي خلقتُها أنا

231
00:17:44,980 --> 00:17:50,920
إذا كان مخلوق مثلكِ يستطيع
،خلق مُعجزة عظيمة كهذه

232
00:17:50,920 --> 00:17:57,440
فمن الواضح بأنّ إلَهنا يستطيع بسهولة
خلق كلّ الكائنات الحيّة في هذا العالم

233
00:17:59,030 --> 00:18:04,060
وإذا كان ترويو يستطيع خلق مُعجزات
...عظيمة كمُعجزاتك

234
00:18:04,520 --> 00:18:08,720
فهذا يعني أنّ سكّان هذه
...القرية يتمتّعون بحكمة

235
00:18:09,750 --> 00:18:11,470
هذا كلّ ما في الأمر

236
00:18:26,230 --> 00:18:27,680
سيّد لورينس

237
00:18:34,060 --> 00:18:36,710
هل ستستمرّ في سفرك؟

238
00:18:36,710 --> 00:18:39,220
ينبغي أن تقول شيئاً

239
00:18:39,220 --> 00:18:41,560
شكراً لكم على حسن ضيافتنا حتّى الآن

240
00:18:41,560 --> 00:18:42,680
لا شكر على واجب

241
00:18:43,000 --> 00:18:46,680
نجَتْ قريتُنا بفضلكما

242
00:18:46,680 --> 00:18:49,660
وإيلسا وإيفان أيضاً

243
00:18:55,430 --> 00:18:58,170
!شكراً لكما

244
00:18:59,590 --> 00:19:01,110
وداعاً إذاً

245
00:19:17,820 --> 00:19:22,390
المُسافرون لا يتركون خلفهم حسرة
في قرية باستثناء ذكريات جميلة

246
00:19:41,810 --> 00:19:43,130
!وداعاً

247
00:19:56,750 --> 00:19:59,280
عسى أن يُبارككما الربُّ بنعمته

248
00:20:01,150 --> 00:20:05,260
كما هو الحال مع التفّاح، هل ينبغي
أن نجعل كلّ وجباتكِ بسكويتاً؟

249
00:20:05,260 --> 00:20:08,180
من كان الّذي اكتشفَ السمَّ وخلقَ مُعجزة؟

250
00:20:08,180 --> 00:20:12,350
لولايّ، لتمّت تعريتك وحُرِقتَ على الوتد

251
00:20:12,350 --> 00:20:14,690
ما حدث قد حدث في النّهاية

252
00:20:15,120 --> 00:20:18,450
رغم ذلك، واجهنا كارثة فعلاً هذه المرّة

253
00:20:18,450 --> 00:20:22,990
حسناً، تمكّنّا من بيع قمحنا بسعر
معقول. حقّقنا ربحاً رغم كلّ شيء

254
00:20:22,990 --> 00:20:25,030
هذا كلّ ما تهتمّ لأجله

255
00:20:25,530 --> 00:20:31,520
،لم تُحقَّق كلّ آمالي تماماً هذه المرّة
لكن اكتسبتُ ما يكفي

256
00:20:31,520 --> 00:20:33,210
أعتقد كان ذلك يستحقُّ الجهد

257
00:20:36,260 --> 00:20:39,330
حسناً، إلى أين سنذهب تالياً؟

258
00:20:39,330 --> 00:20:43,630
لينوس. البلدة الّتي خلّفتِ فيها أسطورة

259
00:20:43,630 --> 00:20:45,820
حقّاً؟

260
00:20:49,630 --> 00:20:52,700
أرى تعبير الجشع واضحاً في وجهك

261
00:20:52,700 --> 00:20:54,490
!أكلتُ ما يكفي بالفعل

262
00:20:56,180 --> 00:20:58,520
مع ذلك، ما زالت نظرتك جشعة

263
00:21:05,030 --> 00:21:06,700
ما-ماذا؟

264
00:21:06,700 --> 00:21:08,100
لا شيء

265
00:21:11,770 --> 00:21:12,370
اسمعي

266
00:21:14,030 --> 00:21:16,660
...سمعتُ بصفقة عمل جيّدة

267
00:21:18,460 --> 00:21:19,290
...لكن

268
00:21:21,560 --> 00:21:23,760
لكن سنحيد عن طريقنا قليلاً

269
00:21:25,450 --> 00:21:28,950
إذاً سيطول سفري معك أكثر فحسب

270
00:21:28,950 --> 00:21:32,520
ليس باليد حيلة. أعتقد يمكنني مُرافقتك

271
00:21:33,550 --> 00:21:34,360
وبعد؟

272
00:21:40,530 --> 00:21:42,500
ما هو العمل الّذي ستؤدّيه؟

273
00:23:07,460 --> 00:23:10,010
حسناً، هذا يكفي لليوم

274
00:23:10,010 --> 00:23:11,310
!ماذا؟

275
00:23:11,310 --> 00:23:12,320
تأخّر الوقت

276
00:23:12,860 --> 00:23:14,490
حان وقت النّوم

277
00:23:14,490 --> 00:23:17,690
!لكن ما زلتُ أريد سماع المزيد

278
00:23:17,690 --> 00:23:19,330
هناك المزيد، أليس كذلك؟

279
00:23:19,610 --> 00:23:24,020
السرّ في الرّحلة النّاجحة هو
استغرق وقتك والاستمتاع بها

280
00:23:24,020 --> 00:23:25,300
...لكن

281
00:23:26,090 --> 00:23:27,530
!عاد إلى المنزل

282
00:23:29,470 --> 00:23:31,970
حمقاء! إلى أين أنتِ ذاهبة؟

283
00:23:32,240 --> 00:23:34,180
!عليّ التّرحيب بعودته

284
00:23:34,180 --> 00:23:37,600
!أخبريني بالمزيد غداً! هذا وعد

285
00:23:39,350 --> 00:23:40,980
حسناً، حسناً

286
00:23:42,870 --> 00:23:46,700
...بالطّبع، فالحكاية لم تنتهِ بعد