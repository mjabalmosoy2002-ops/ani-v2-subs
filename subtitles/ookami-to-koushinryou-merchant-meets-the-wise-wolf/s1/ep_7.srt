1
00:02:09,870 --> 00:02:11,440
ألستِ على ما يُرام؟

2
00:02:11,440 --> 00:02:13,520
أنا جائعة

3
00:02:13,520 --> 00:02:15,290
أكلتِ للتو بعض الخبز

4
00:02:15,290 --> 00:02:18,990
!الخبز القاسي وغير المستساغ ليس محسوباً

5
00:02:18,990 --> 00:02:21,700
إذا اشترينا طعاماً كافياً لكِ للشّعور
،بالشّبع في كلّ وجبة

6
00:02:21,700 --> 00:02:24,080
فسوف نُفلس خلال أسبوع

7
00:02:24,080 --> 00:02:29,710
.يمكنك أن تخدم شخصاً ظريفاً مثلي
ألا ينبغي أن يُشعرك هذا بالشّرف كرجُل؟

8
00:02:29,710 --> 00:02:32,910
ما رأيكِ أن أضع هذا الشّرف بين
شريحتَي خبز وتأكليها

9
00:02:34,150 --> 00:02:36,010
لا تنفخ نفسك غروراً

10
00:02:36,010 --> 00:02:38,430
لستُ خبزاً، لذا لا أستطيع الانتفاخ

11
00:02:41,100 --> 00:02:42,340
...حسناً

12
00:02:42,340 --> 00:02:44,810
كم بقي حتّى البلدة التّالية؟

13
00:02:49,350 --> 00:02:51,440
ينبغي أن تكون وراء تلك التلّة

14
00:02:51,440 --> 00:02:54,300
أتساءل ماذا سآكل تالياً

15
00:02:54,300 --> 00:02:58,530
أتمنّى أن أنقضّ على بقرة أو خروف
طازج ومليء بالدّماء

16
00:02:58,530 --> 00:03:01,940
وطعام حلو كطبق جانبيّ سيكون مثاليّاً

17
00:03:01,940 --> 00:03:04,590
أكلتِ كمّيةً كبيرة من فطائر التفّاح في باتزيو

18
00:03:04,950 --> 00:03:07,280
،بعد الاهتمام بالتفّاح الّذي لم تستطيعي إكماله

19
00:03:07,280 --> 00:03:10,660
لا أريد حتّى أن أشتمّ رائحة حلوة لبعض الوقت

20
00:03:10,660 --> 00:03:12,580
كانت لذيذة

21
00:03:12,580 --> 00:03:16,550
فاجأتْني مثل هذه الطّريقة الإبداعيّة لأكلها

22
00:03:16,550 --> 00:03:21,070
بئساً، آمل أن تعلمي بأنّ التّفّاح
لا يُعالَج بالمجّان

23
00:03:21,590 --> 00:03:24,740
سأضيف كلّ المال الّذي استخدمتِه
...إلى فاتورتكِ

24
00:03:35,890 --> 00:03:37,020
أهذه هي؟

25
00:03:37,020 --> 00:03:38,480
أ-أجل

26
00:03:39,140 --> 00:03:40,490
هذه بوروسون

27
00:03:45,950 --> 00:03:49,700
...ليس هناك إلّا إله واحد. يقود البشر

28
00:03:52,210 --> 00:03:54,580
يا لها من بلدة مُملّة

29
00:03:56,850 --> 00:03:59,250
حسناً، لا يوجد أي عربات طعام هنا

30
00:03:59,250 --> 00:04:02,520
تجعل الأمر يبدو وكأنّني غير مهتمّة
سوى بالطّعام

31
00:04:02,520 --> 00:04:04,570
إذاً هل تريدين الذّهاب للاستماع
لبعض المواعظ؟

32
00:04:05,090 --> 00:04:08,410
إنّهم أصغر بخمسمئة عام من أن يتمكّنوا من وَعظي

33
00:04:08,410 --> 00:04:12,240
أعتقد ستستفيدين من الاستماع لمواعظهم
حول التّوفير والاقتصاد

34
00:04:12,240 --> 00:04:15,060
أنا ذئبة

35
00:04:15,060 --> 00:04:18,570
لا أفهم مثل هذه الأمور المعقّدة كالموعظة

36
00:04:18,570 --> 00:04:21,650
حسناً، هذه البلدة هي غالباً المكان الوحيد

37
00:04:21,650 --> 00:04:24,700
الّذي يؤثّر فيها الوعظ

38
00:04:26,070 --> 00:04:29,370
،في مدينة روفينهايغن الدّينيّة

39
00:04:29,370 --> 00:04:32,040
الأُسقُف والكهنة الّذين ينبغي
أن يتّبعوا هذه التّعاليم

40
00:04:32,040 --> 00:04:34,290
هم أكثر الرّاغبين في تعبئة جيوبهم

41
00:04:34,290 --> 00:04:36,700
المدينة تُدعى روفينهايغن؟

42
00:04:36,700 --> 00:04:37,770
تعرفين الاسم؟

43
00:04:37,770 --> 00:04:42,300
أجل، رغم أنّ الاسم الّذي سمعته كان لشخص

44
00:04:43,380 --> 00:04:46,180
لستِ مخطئة

45
00:04:46,180 --> 00:04:49,180
،سُمِّيت المدينة باسم الصّليبيّ المُقدّس
،القدّيس روفينهايغن

46
00:04:49,180 --> 00:04:50,510
الّذي قاتل الوثنيّين

47
00:04:50,510 --> 00:04:54,170
كان اسم رجل لديه شعر أحمر
،مُتّقد طويل ولحية

48
00:04:54,170 --> 00:04:56,770
وبتعابير وجه جادّة وشديدة

49
00:04:56,770 --> 00:04:59,850
أعتقد هكذا دُوِّنَ القدّيس في التّاريخ

50
00:04:59,850 --> 00:05:03,930
قيل أيضاً بأنّ ذراعه اليسرى مبتورة
أثناء مقاتلة إله وثنيّ

51
00:05:03,930 --> 00:05:05,290
ذِراعه اليسرى؟

52
00:05:05,780 --> 00:05:08,620
عضضتُ مؤخّرته فقط

53
00:05:09,280 --> 00:05:12,730
،حالما رأى أُذنَي وذيلي الظّريف

54
00:05:12,730 --> 00:05:16,170
بدأ يصرخ قائلاً بأنّني من أتباع
الشّيطان وطاردني

55
00:05:16,170 --> 00:05:21,420
أغضبني لدرجة لم يسعني فيها
سوى عضّ مؤخّرته

56
00:05:22,210 --> 00:05:24,650
كانت مليئة بالألياف وغير شهيّة إطلاقاً

57
00:05:27,220 --> 00:05:30,390
مؤخّرته؟ هذا محرج جدّاً لدرجة لا يمكن
تدوينه في كتُب التّاريخ

58
00:05:31,190 --> 00:05:32,350
...لكن لا بدّ أن أقول

59
00:05:33,810 --> 00:05:38,290
عضضتُه فقط. لم أنهِ حياته

60
00:05:38,290 --> 00:05:40,220
تقلقين بشأن أمور غريبة

61
00:05:40,220 --> 00:05:41,770
إنّها مهمّة

62
00:05:43,030 --> 00:05:44,110
حسناً

63
00:05:45,140 --> 00:05:47,810
والآن، لنتوجّه إلى الشّركة التّجاريّة

64
00:05:47,810 --> 00:05:48,700
أجل

65
00:05:48,700 --> 00:05:50,300
...لكن أوّلاً

66
00:05:54,500 --> 00:05:55,910
هل انتظرتَ طويلاً؟

67
00:06:03,320 --> 00:06:08,830
بدوتِ كراهبة بعباءتكِ، لكنّك الآن
تبدين كفتاة بلدة عاديّة

68
00:06:08,830 --> 00:06:12,390
سيكون من الصّعب إيجاد فتاة
بلدة ظريفة مثلي

69
00:06:13,260 --> 00:06:17,640
لكن يبدو أنّه لا جدوى من التّباهي
بنفسي في بلدة مملّة كهذه

70
00:06:17,980 --> 00:06:21,560
سنتوجّه إلى روفينهايغن بعد أن بعنا هذه
الفليفلة إلى شركة لاتبارون التّجاريّة

71
00:06:21,560 --> 00:06:22,910
اصبري إلى ذلك الحين

72
00:06:27,890 --> 00:06:30,530
هل روفينهايغن بلدة كبيرة؟

73
00:06:30,530 --> 00:06:31,730
إنّها ضخمة

74
00:06:31,730 --> 00:06:34,810
.إنّها أقرب إلى مدينة منها إلى بلدة
سيكون هناك الكثير من العربات

75
00:06:34,810 --> 00:06:35,490
عربات تفّاح؟

76
00:06:36,030 --> 00:06:37,660
أنتِ لا تضجرين منها حقّاً

77
00:06:37,660 --> 00:06:40,510
!الأشياء اللّذيذة لذيذة

78
00:06:40,510 --> 00:06:42,000
حسناً، حدّثني عن ذلك

79
00:06:43,510 --> 00:06:45,650
لستُ متأكّداً بِأنّه حان الوقت تقريباً

80
00:06:45,650 --> 00:06:49,120
لتخليل التفّاح النيّئ للشّتاء

81
00:06:49,120 --> 00:06:50,360
تخليله؟

82
00:06:50,360 --> 00:06:51,870
يخلّلونه في العسل

83
00:06:52,220 --> 00:06:56,050
يخلّلون الإجاص أيضاً وأحياناً الدُّرّاق
في مناسبات نادرة

84
00:06:56,050 --> 00:06:57,640
تُعدّ أطعمة فاخرة

85
00:06:57,640 --> 00:07:01,400
يقطِّعون الدُّرّاق إلى شرائح ويضعون
تيناً ولوزاً بينها

86
00:07:02,180 --> 00:07:07,320
يسكبون العسل بسخاء فوقه ويضيفون
قليلاً من الزّنجبيل في النّهاية

87
00:07:08,990 --> 00:07:11,180
،كانت قد سنحَتْ لي فُرصة لأكله من قبل

88
00:07:11,180 --> 00:07:14,300
لكن كان حلواً جدّاً لدرجة أنّ
الكنيسة ناقشتْ منعه

89
00:07:15,830 --> 00:07:17,900
يسيل لُعابكِ

90
00:07:19,750 --> 00:07:22,600
لكن لا أعلم ما إن سيكون متوفّراً

91
00:07:22,600 --> 00:07:26,040
،تُحفَظ في العادة للنُّبلاء أو الأثرياء
لذا هي غير موجودة في المتاجر

92
00:07:30,300 --> 00:07:31,760
وماذا إن كانت كذلك؟

93
00:07:31,760 --> 00:07:34,240
فهمت. سأشتريها لكِ

94
00:07:34,240 --> 00:07:35,620
هل تقسم؟

95
00:07:35,620 --> 00:07:37,280
...أ-أجل

96
00:07:37,280 --> 00:07:39,590
!إذاً، يجب علينا أن نستعجل

97
00:07:41,850 --> 00:07:43,500
قد تنفد الكمّية لديهم

98
00:07:43,500 --> 00:07:45,120
سيكون من الفظيع أن يحدث ذلك

99
00:07:45,120 --> 00:07:46,940
نحن نتحدّث هنا عن دُرّاق وعسل

100
00:07:47,200 --> 00:07:48,380
لا أصدِّق ذلك

101
00:07:48,380 --> 00:07:49,800
!لا أصدّق ذلك إطلاقاً

102
00:07:49,800 --> 00:07:52,170
فقط إن كانت تُباع. هل تسمعينني؟

103
00:07:52,170 --> 00:07:54,700
لكن من الصّعب تجاهل الإجاص كذلك

104
00:07:59,740 --> 00:08:05,130
،يختبئ بيننا زنادِقة وشياطين في البلدة
ليظهروا كأشخاص عاديّين

105
00:08:05,130 --> 00:08:06,780
،قبل أيّام قليلة

106
00:08:06,780 --> 00:08:12,170
وجدوا ساحراً يعيش بينهم يستطيع
التحكُّم بالذّئاب قرب روفينهايغن

107
00:08:12,170 --> 00:08:15,860
لكن مع ذلك ما زالت الكنيسة تمدّ
أيديها الحميدة تجاه أشخاص كهؤلاء

108
00:08:15,860 --> 00:08:17,730
وتغفر لهم

109
00:08:19,940 --> 00:08:22,600
حسناً إذاً. هل نتطرّق للحديث عن العمل؟

110
00:08:23,700 --> 00:08:25,110
من فضلك

111
00:08:25,480 --> 00:08:28,980
حسناً، ما نوع المُنتَج الّذي لديك لأجلي اليوم؟

112
00:08:28,980 --> 00:08:30,340
هذا

113
00:08:31,990 --> 00:08:34,400
فليفلة؟

114
00:08:35,620 --> 00:08:37,280
أنا متفاجئ من معرفتك لها بهذه السّهولة

115
00:08:37,280 --> 00:08:38,860
يمكنني اشتمامها

116
00:08:38,860 --> 00:08:44,710
إذاً لنزِن المُنتَج. هل لديك ميزان؟

117
00:08:44,710 --> 00:08:46,340
لا، لا أملك

118
00:08:46,810 --> 00:08:49,910
لكن أنا أؤمن بالإله

119
00:08:52,500 --> 00:08:57,680
رغم ذلك، أحضرتَ فليفلة في وقت مناسب

120
00:08:58,000 --> 00:09:01,390
ازداد الطّلب على الفليفلة بشكل
كبير في الآونة الأخيرة

121
00:09:01,390 --> 00:09:06,260
كنتُ لأتمكّن من شرائها بسعر أدنى
لو أتيتَ قبل أسبوع

122
00:09:08,940 --> 00:09:10,760
أنا عطشانة

123
00:09:10,760 --> 00:09:11,900
!اصبري

124
00:09:16,280 --> 00:09:20,780
حسناً، حتّى القدّيسين لا يستطيعون
العيش من دون ماء

125
00:09:20,780 --> 00:09:24,540
هل تريدين ماء؟ أم بعض الخمر؟

126
00:09:24,540 --> 00:09:26,620
هل لي ببعض الماء؟

127
00:09:26,620 --> 00:09:29,090
انتظري لحظة رجاء

128
00:09:41,470 --> 00:09:44,170
الفليفلة تعادل 45 وزنة

129
00:09:44,170 --> 00:09:45,930
أين أُنتِجت هذه الفليفلة؟

130
00:09:46,230 --> 00:09:49,900
تمّ تحصيلها من راماباتا في مملكة ليدون

131
00:09:49,900 --> 00:09:52,530
تكفّلتْ شركةُ ميلوني التّجاريّة بعمليّة التّوريد

132
00:09:52,900 --> 00:09:58,750
من راماباتا؟ سافرت هذه الفليفلة
لمسافة طويلة

133
00:09:59,160 --> 00:10:01,910
يبدو أنّ الشّهادة أصليّة

134
00:10:02,220 --> 00:10:08,080
ما رأيك بذهبيّة لوميوني واحدة
مقابل كلّ وزنة هنا؟

135
00:10:08,080 --> 00:10:11,040
ما هي القيمة السّوقيّة الحاليّة
لقطعة لوميوني ذهبيّة؟

136
00:10:11,040 --> 00:10:13,630
ما العملة الأساسيّة الّتي تستخدمها
يا سيّد لورينس؟

137
00:10:13,630 --> 00:10:15,050
قطع تريني فضّية

138
00:10:15,050 --> 00:10:20,990
كلّ ذهبيّة تعادل 32 و 5\6 من قطع
تريني الفضّية في السّوق الحاليّة

139
00:10:26,350 --> 00:10:28,560
أقبل بهذا السّعر

140
00:10:29,470 --> 00:10:31,020
شكراً جزيلاً لك

141
00:10:32,230 --> 00:10:33,230
ما الأمر؟

142
00:10:34,690 --> 00:10:36,180
...أشعر بدُوار

143
00:10:36,180 --> 00:10:37,650
هل أنتِ بخير؟

144
00:10:39,100 --> 00:10:41,320
لا بدّ أنّكِ مُرهَقة من السّفر

145
00:10:41,320 --> 00:10:44,660
...يبدو أنّ نظري قد زاغ فجأة

146
00:10:50,170 --> 00:10:55,260
يا سيّد، يبدو أنّني ما زلتُ دائخة

147
00:10:55,260 --> 00:10:56,960
،كما ترى

148
00:10:57,260 --> 00:11:00,970
الجميع أمامي يميلون إلى طرف واحد

149
00:11:14,210 --> 00:11:18,980
هل شربتُ ماء أم خمراً؟

150
00:11:21,260 --> 00:11:24,320
لا بدّ أنّني شربتُ خمراً

151
00:11:24,320 --> 00:11:25,810
أليس كذلك؟

152
00:11:25,810 --> 00:11:30,970
،يُقال بأنّ الحانة كلّما كانت أكثر حيويّة
...يقلّ شرب مالك الحانة

153
00:11:30,970 --> 00:11:34,240
فهمت. أن تكون الصّاحي الوحيد في الغرفة

154
00:11:34,240 --> 00:11:37,300
هو المفتاح لتحقيق صفقة ناجحة

155
00:11:37,300 --> 00:11:39,060
...لا، هذا

156
00:11:39,060 --> 00:11:42,180
يبدو أنّ شريكتي وأنا ثملان

157
00:11:42,530 --> 00:11:46,780
لذا أنا متأكّدٌ بأنّنا سوف ننسى الكثير
من الأشياء الّتي رأيناها وسمعناها اليوم

158
00:11:47,170 --> 00:11:51,890
غير أنّ الثّمالى غالباً ما يطلبون
طلبات غير منطقيّة

159
00:11:51,890 --> 00:11:53,930
ما-ماذا تعني؟

160
00:11:53,930 --> 00:11:58,480
سنحصل على ما نستحقّ بعد
...أن تُوزَن الفليفلة جيّداً و

161
00:11:59,890 --> 00:12:01,240
...لنرَ

162
00:12:02,370 --> 00:12:06,070
ما رأيك بالسّماح لي لشرائه
بضعفَي قيمته بالدَّين؟

163
00:12:06,070 --> 00:12:08,220
!هذا كثير جدّاً

164
00:12:08,220 --> 00:12:13,290
هذا غير ممكن؟ مع الأسف، يبدو
أنّني أزداد صحوة

165
00:12:16,510 --> 00:12:18,930
...بخصوص المُنتج الّذي أريده

166
00:12:18,930 --> 00:12:20,670
ما رأيك بدرع عالي الجودة؟

167
00:12:22,050 --> 00:12:23,510
أتقول درع؟

168
00:12:23,900 --> 00:12:27,980
اقترب الوقت للبعثة الشّماليّة السّنويّة العظيمة

169
00:12:27,980 --> 00:12:32,390
الدّرع هو أداة مُربِحة متينة وخالية من المخاطر

170
00:12:32,390 --> 00:12:34,610
...درع

171
00:12:34,610 --> 00:12:39,110
أنا متأكّدٌ بأنّ لديك علاقة جيّدة مع بعض
الشّركات التّجاريّة في روفينهايغن

172
00:12:39,110 --> 00:12:40,320
،إذا بعتُ الدّرع لهم

173
00:12:40,320 --> 00:12:44,070
فينبغي أن أتمكّن من التّسديد لك
فوراً والتخلُّص من الدَّين

174
00:12:44,530 --> 00:12:45,810
ما رأيك؟

175
00:12:47,730 --> 00:12:49,360
شكراً جزيلاً لك

176
00:12:49,360 --> 00:12:52,490
إذاً من فضلك حضِّر المُنتجات في أسرع وقت

177
00:12:52,490 --> 00:12:54,160
...عُـ-عُلِم

178
00:12:54,160 --> 00:12:56,830
بشان التّقييم؟

179
00:12:56,830 --> 00:12:58,570
سأتركه لك

180
00:12:58,570 --> 00:13:01,050
فأساساً، أنا أؤمن بالربّ

181
00:13:01,050 --> 00:13:05,010
والآن يبدو أنّني أصحو كذلك

182
00:13:05,010 --> 00:13:10,260
خمر عالي الجودة ولحم خروف
مُجفّف سيكفيان لإرضائي

183
00:13:10,260 --> 00:13:15,860
هـ-هناك متجر يتعامل معي. من فضلكما
خذا ما تشاءان من هناك

184
00:13:15,860 --> 00:13:18,220
سأستدعي شخصاً لإرشادكما

185
00:13:23,100 --> 00:13:24,620
أشفق عليه

186
00:13:24,620 --> 00:13:27,460
رغم ذلك، أنا متفاجئ من أنّكِ لاحظتِ

187
00:13:27,460 --> 00:13:31,120
مظهري، وفِراء ذيلي، وعقلي، كلّهم ممتازون

188
00:13:31,120 --> 00:13:32,450
لكن كذلك أُذنَي وعينَي

189
00:13:32,810 --> 00:13:36,000
لاحظتُ حالما دخلتُ الغرفة

190
00:13:36,000 --> 00:13:39,650
حسناً، هذا كافٍ لخِداع أمثالك

191
00:13:39,650 --> 00:13:41,860
لا يمكنني مجادلتكِ على ذلك

192
00:13:43,060 --> 00:13:46,420
أنا متأكّدةٌ بأنّك ستكون بخير بمفردك
من الآن فصاعداً

193
00:13:47,010 --> 00:13:49,760
سأذهب لشراء طعام في هذه الأثناء

194
00:13:50,180 --> 00:13:55,350
يجب علينا المُغادرة إلى روفينهايغن في أسرع
!وقت ممكن من أجل الدُرّاق المخلّل بالعسل

195
00:13:58,190 --> 00:14:00,150
لكن اتركي ما يكفي لنا للوصول
إلى روفينهايغن

196
00:14:01,010 --> 00:14:04,400
أعلم! التّوفير، صحيح؟

197
00:14:15,170 --> 00:14:17,260
استغرق ذلك وقتاً

198
00:14:17,260 --> 00:14:19,610
هولو لم تعُد بعد؟

199
00:14:21,650 --> 00:14:24,500
آمل ألّا يفلس هذا المكان بسبب
فاتورة الشّرب الخاصّة بها

200
00:14:24,500 --> 00:14:28,010
سمعتُ عندما كنتُ أسافر في الشّمال

201
00:14:28,010 --> 00:14:32,910
...البلدة الّتي عبدت إلهَ ذئب وثنيّ

202
00:14:47,050 --> 00:14:48,500
كان ذلك شهيّاً

203
00:14:49,530 --> 00:14:51,380
هل أكلتِه كلّه؟

204
00:14:51,380 --> 00:14:54,770
اطمئنّ. ما زال هناك الكثير

205
00:14:55,520 --> 00:14:58,490
يبدو أنّكِ تم تطبّقي سياسة التّوفير إطلاقاً

206
00:14:58,490 --> 00:15:02,920
،حسناً، الآن بعد أن امتلأت معدتي
فينبغي أن أنظّف ذيلي

207
00:15:08,710 --> 00:15:10,070
هذا صحيح

208
00:15:12,170 --> 00:15:13,300
ما الأمر؟

209
00:15:13,300 --> 00:15:17,330
أريد بعض الزّيت حالما نصل
إلى البلدة التّالية

210
00:15:17,330 --> 00:15:18,140
زيت؟

211
00:15:18,140 --> 00:15:23,190
أجل، سمعتُ أنّه جيّد للحِفاظ على ذيلي

212
00:15:29,360 --> 00:15:30,950
هلّا اشتريته لي؟

213
00:15:32,420 --> 00:15:34,650
هل حسبتِ يوماً كم تكلّف ملابسكِ

214
00:15:34,650 --> 00:15:37,010
وأحذيتكِ ونفقات سفركِ وكحولكِ وطعامكِ؟

215
00:15:37,010 --> 00:15:39,850
!لا تقولي لي بأنّكِ لا تُجيدين عمليّة الجمع؟

216
00:15:40,750 --> 00:15:43,000
أستطيع الجمع

217
00:15:43,000 --> 00:15:46,240
لستُ جيّدة في الجمع فقط، بل في الطّرح كذلك

218
00:15:46,240 --> 00:15:50,420
إذاً ينبغي أن يكون من السّهل أن تخمّن
الذّئبة الحكيمة العظيمة إجابتي

219
00:15:51,010 --> 00:15:53,060
أجل، أعلم

220
00:15:53,060 --> 00:15:55,460
أنا متأكّدةٌ بأنّك سوف تشتريه لأجلي

221
00:15:55,890 --> 00:16:00,390
فأساساً، تمكّنتَ من تحقيق ربح
كبير بفضلي

222
00:16:04,270 --> 00:16:06,740
هل ستشتري الزّيت؟

223
00:16:06,740 --> 00:16:09,900
بِكَم أنتِ مَدينة لي برأيكِ الآن؟

224
00:16:09,900 --> 00:16:12,430
لن أشتري أشياء غير ضروريّة
تؤدّي إلى مُراكمة الدَّين

225
00:16:12,430 --> 00:16:17,200
ماذا؟ أتريدني أن أردّ لك الدَّين بهذا الإلحاح؟

226
00:16:17,200 --> 00:16:19,260
بالطّبع

227
00:16:19,650 --> 00:16:22,690
لم أعلم بأنّك تفكّر بهذه الطّريقة

228
00:16:22,690 --> 00:16:24,370
ما-ماذا تقصدين؟

229
00:16:24,370 --> 00:16:30,020
حسناً، سأكون حُرّة حالما أسدّد لك الدَّين

230
00:16:30,920 --> 00:16:33,370
إذاً، سوف أسرع نحو الشّمال

231
00:16:34,190 --> 00:16:36,670
آمل أن تكون بارو وميوري على ما يُرام

232
00:16:39,380 --> 00:16:41,990
لا يوجد موعد نهائيّ لدَينكِ

233
00:16:42,460 --> 00:16:45,660
فقط ادفعي لي قبل أن تصِلي
إلى الغابات الشّماليّة

234
00:16:46,150 --> 00:16:47,340
ما رأيكِ بذلك؟

235
00:16:48,820 --> 00:16:49,610
أجل

236
00:16:50,100 --> 00:16:54,810
ينبغي أن أكون قادرة على تسديد الدَّين
لك عندما أصل إلى الغابات الشّماليّة

237
00:16:54,810 --> 00:16:56,280
...لذا

238
00:16:56,280 --> 00:16:57,700
الزّيت؟

239
00:16:58,370 --> 00:17:00,160
هل ستشتريه لأجلي؟

240
00:17:05,250 --> 00:17:06,500
شكراً لك

241
00:17:13,450 --> 00:17:15,810
لماذا اخترتَ الدّرع من بين كلّ الأشياء؟

242
00:17:15,810 --> 00:17:18,210
روفينهايغن هي المِحور المركزيّ
،للبعثة الشّماليّة العظيمة

243
00:17:18,210 --> 00:17:21,010
وهي بعثة لاصطياد الزّنادِقة

244
00:17:21,010 --> 00:17:23,400
يحقّق الدّرع مبيعات جيّدة

245
00:17:23,400 --> 00:17:25,600
إذاً ينبغي أن تحقّق ربحاً كبيراً

246
00:17:25,600 --> 00:17:30,520
،لا، هناك تُجّار كُثُر يوفّرون الدّرع
ممّا يؤدّي إلى تخفيض السّعر بالمقابل

247
00:17:30,520 --> 00:17:33,500
لكن ألا ينبغي أن يكون هذا
كافياً لجَني بعض الرّبح؟

248
00:17:33,500 --> 00:17:36,110
حسناً، ينبغي أن نجني ما يكفي
لشراء الزّيت الّذي تريدينه

249
00:17:36,110 --> 00:17:40,600
لكن من بين كلّ الأشياء، التّوابل
هي الأمثل حتماً

250
00:17:40,600 --> 00:17:42,060
للأكل؟

251
00:17:42,060 --> 00:17:44,870
لستُ مثلكِ. أتحدّث عن الأرباح

252
00:17:45,850 --> 00:17:48,750
إذاً كان ينبغي أن تقايض مقابل
المزيد من التّوابل

253
00:17:48,750 --> 00:17:52,560
سعر الفليفلة لا يختلف كثيراً
بين بوروسون وروفينهايغن

254
00:17:52,560 --> 00:17:54,850
كنتُ لأخسر نتيجة دفع التّعرفة الجمركيّة

255
00:17:54,850 --> 00:17:58,540
إذا وجدتُ شيئاً أكثر إدراراً للمال
،أو أفضل من التّوابل

256
00:17:58,540 --> 00:18:00,600
فسوف أتمكّن من افتتاح متجر فوراً

257
00:18:00,600 --> 00:18:02,410
أما من شيء آخر؟

258
00:18:02,410 --> 00:18:06,270
على سبيل المثال، مجوهرات أو ذهب؟

259
00:18:06,670 --> 00:18:10,680
مثل هذه الأشياء غير مُربِحة كثيراً
في روفينهايغن

260
00:18:10,680 --> 00:18:11,880
ما السّبب؟

261
00:18:11,880 --> 00:18:16,570
،إذا حاولتِ توريد الذّهب في روفينهايغن
فإنّهم يكلّفونكِ بتعرِفة ضخمة

262
00:18:16,570 --> 00:18:20,050
ألا يريد النّاسُ في هذه البلدة ذهباً؟

263
00:18:20,050 --> 00:18:20,910
المسألة ليست كذلك

264
00:18:20,910 --> 00:18:25,290
وحدهم التُجّار الّذين لديهم علاقات مع الكنيسة
من يُسمَح لهم باستيراد الذّهب

265
00:18:25,610 --> 00:18:28,860
يتمكّنون من تسديد تعرِفة أقلّ
بكثير ممّا يدفعه الآخرون

266
00:18:30,040 --> 00:18:31,130
،علاوة على ذلك

267
00:18:31,130 --> 00:18:35,850
يمكنهم الحصول على ختم الكنيسة المنقوش
في الذّهب في كاتدرائيّة روفينهايغن المُقدّسة

268
00:18:35,850 --> 00:18:39,590
يصبح ذلك الذّهب "مُقدّس" ويرتفع
سعره بشكل كبير

269
00:18:39,590 --> 00:18:45,660
بصيغة أخرى، الكنيسة وتُجّار مُعيّنون
يحتكرون كافّة الأرباح

270
00:18:45,660 --> 00:18:46,700
تخمينكِ صحيح

271
00:18:46,700 --> 00:18:49,850
"هذا أقذر من أن يُسمَّى "مُقدّس

272
00:18:50,350 --> 00:18:53,120
،حسناً، إذا استطعتِ الانضمام للحلقة السرّية

273
00:18:53,120 --> 00:18:55,610
فستتمكّنين من بيعه بعشرة أضعاف
أعلى من قيمته الفعليّة

274
00:18:55,610 --> 00:18:57,940
ما رأيك بتهريبه للدّاخل؟

275
00:18:57,940 --> 00:19:00,500
كان الجميع ليفعلوا ذلك لو كان مُمكناً

276
00:19:00,500 --> 00:19:03,720
إذا قُبِض عليكِ، ستخسرين ذراعكِ
الأساسيّة على الأقلّ

277
00:19:03,720 --> 00:19:06,560
الأرباح لا تستحقّ هذه المُخاطرة

278
00:19:06,560 --> 00:19:08,160
هذا صحيح

279
00:19:08,160 --> 00:19:11,050
حسناً، لديك مشروع عمل متين

280
00:19:11,050 --> 00:19:13,380
من الأفضل ادِّخار مالك بالطّريقة النّزيهة

281
00:19:13,380 --> 00:19:16,460
لكن هناك شخص ينفق كافّة
...أموالي المُكتسَبة بعرَق الجبين

282
00:19:16,930 --> 00:19:17,590
انظر

283
00:19:18,750 --> 00:19:20,760
يوجد كثير من الأشخاص أمامنا

284
00:19:20,760 --> 00:19:21,550
ماذا؟

285
00:19:24,850 --> 00:19:27,970
إذا سلكنا هذا الطّريق الالتفافيّ، فسوف
...نجد أنفسنا على طريق لاين المُقدَّس

286
00:19:27,970 --> 00:19:29,890
ما رأيك بهذا النّسيج؟

287
00:19:29,890 --> 00:19:33,020
هل يتكلّم أحدٌ البالوشيّة هنا؟

288
00:19:36,220 --> 00:19:37,770
...يبدو وكأنّ الطّريق أمامنا

289
00:19:37,770 --> 00:19:41,400
جنود المرتزقة من الشّمال يتّجهون نحو الجنوب

290
00:19:41,400 --> 00:19:45,080
هناك طريق التفافيّ، لكلنّه مليء
بالذّئاب الهائمة

291
00:19:45,080 --> 00:19:50,070
وفوق ذلك، انتشرتْ إشاعات عن ساحر
وثنيّ يستطيع استدعاء الذّئاب

292
00:19:52,940 --> 00:19:55,580
إذاً ماذا تحبّ الذّئبةُ الحكيمةُ هولو أن تفعل؟

293
00:19:56,690 --> 00:20:00,140
ذكرياتي عن المُرتزقة ليست لطيفة

294
00:20:00,140 --> 00:20:02,730
حسناً، المُرتزقة يسبّبون مُشكلة أينما حلّوا

295
00:20:03,410 --> 00:20:04,800
ماذا عن الذّئاب في الطّريق الالتفافيّ؟

296
00:20:04,800 --> 00:20:07,720
سيكون التّعامل معهم أسهل من البشر

297
00:20:07,720 --> 00:20:10,090
على الأقلّ، يمكنني التكلُّم معهم

298
00:20:10,090 --> 00:20:11,250
حُسِمَ الأمر إذاً

299
00:20:16,400 --> 00:20:18,080
لا يوجد أحدٌ حولنا

300
00:20:18,080 --> 00:20:21,640
قوّة الإشاعات شديدة جدّاً

301
00:20:21,640 --> 00:20:22,860
هل تشعرين بأي ذئب؟

302
00:20:22,860 --> 00:20:29,650
نحن الذّئاب لسنا حمقى بما يكفي حتّى ننكشف
بسهولة في منطقة مفتوحة كهذه

303
00:20:29,650 --> 00:20:30,330
...لكن

304
00:20:35,090 --> 00:20:38,460
نوع من البشر أكرهه أمامنا

305
00:20:38,460 --> 00:20:40,840
السّاحر؟ ماذا يجدر بنا أن نفعل؟

306
00:20:40,840 --> 00:20:43,210
من واجب البشريّ أن يهرب

307
00:20:44,190 --> 00:20:46,930
لا حاجة لنا لنتجنّبهم

308
00:20:59,770 --> 00:21:00,610
...هذا

309
00:21:08,910 --> 00:21:10,030
...راعي

310
00:21:11,110 --> 00:21:14,910
إذاً السّاحر هو راعٍ في واقع الأمر

311
00:21:27,760 --> 00:21:29,760
ماذا كان ذلك؟

312
00:21:29,760 --> 00:21:32,120
إنّه طقس يُستخدَم عند اللِّقاء براعٍ

313
00:21:32,120 --> 00:21:35,270
الآن أنا متأكّدٌ بأنّ هذا الشّخص ليس ساحراً

314
00:21:38,130 --> 00:21:40,690
اسمي لورينس، تاجر رحّال

315
00:21:40,690 --> 00:21:42,900
وهذه شريكتي في السّفر، هولو

316
00:21:46,890 --> 00:21:49,970
أنا متأكّدٌ بأنّ الربَّ قد جمعنا معاً اليوم

317
00:21:49,970 --> 00:21:55,290
إذا كنت راعياً جيّداً، فأعلم بأنّك
سوف تُعاملنا مُعاملة حسنة

318
00:23:45,690 --> 00:23:49,260
الحلقة القادمة: مُسافر زميل وأنباء مُقلِقة