1
00:00:13,270 --> 00:00:17,410
لذا ذهبتُ إلى هناك ووجدتُ
!زوجتي تنتظرني

2
00:00:17,410 --> 00:00:18,700
!هل تصدّق ذلك؟

3
00:00:19,480 --> 00:00:20,490
سيّد باتوس

4
00:00:21,700 --> 00:00:25,080
أعتذر على إزعاجك

5
00:00:25,810 --> 00:00:28,140
حسناً، ما العمل الّذي تريد أن تطلبه منّي؟

6
00:00:28,140 --> 00:00:28,750
سأخبرك

7
00:00:29,130 --> 00:00:33,160
،أرغب في الحصول على بعض البيريت
وأبحث عن مُزوّدين

8
00:00:33,160 --> 00:00:36,660
ارتأيتُ بأنّك قد تعرف شخصاً يا سيّد باتوس

9
00:00:36,660 --> 00:00:37,890
بيريت؟

10
00:00:38,310 --> 00:00:40,010
هل تعرف أي مُزوِّد؟

11
00:02:13,630 --> 00:02:19,490
هل تتذكّر ما قلتُه عندما أعطيتُك
لمحة حول خطّة السيّد أماتي؟

12
00:02:19,490 --> 00:02:21,240
أتذكّر بالطّبع

13
00:02:21,240 --> 00:02:25,600
ليس ذلك فحسب، أتذكّر بأنّ الآنسة
ديانا كانت تكره الحديث عن العمل

14
00:02:25,600 --> 00:02:29,500
هل أنت مهتمّ ببيريت الخيميائيّين؟

15
00:02:29,500 --> 00:02:33,130
سعمتُ أنّه لا يمكن أداء عمل
من دون إذن الآنسة ديانا

16
00:02:33,130 --> 00:02:35,710
لهذا أتيتُك يا سيّد باتوس

17
00:02:35,710 --> 00:02:39,440
لماذا تقترح صفقة وأنت على دراية بذلك؟

18
00:02:39,440 --> 00:02:42,270
هل بسبب الأرباح الّتي يدرُّها البيريت؟

19
00:02:42,270 --> 00:02:43,680
لا، إطلاقاً

20
00:02:44,080 --> 00:02:46,200
هل بسبب الإشاعات بأنّ البيريت
يستطيع أن يُريك قدرك

21
00:02:46,200 --> 00:02:47,930
أو بأنّه يمكنه شفاء كافّة الأمراض؟

22
00:02:47,930 --> 00:02:51,060
أفعل هذا لتحقيق الرّبح

23
00:02:51,060 --> 00:02:53,080
لن أنكر ذلك

24
00:02:53,080 --> 00:02:58,900
لكن، الرّبح الّذي أحاول كسبه ليس
من الارتفاع الجنونيّ في السّعر

25
00:02:59,260 --> 00:03:02,490
إنّه شيء... شيء أكثر أهمّية

26
00:03:02,490 --> 00:03:04,450
...سيّد باتوس، أنت تاجر

27
00:03:04,450 --> 00:03:08,200
ألم تشعر يوماً بأنّ حمولتك كانت
على وشك السُّقوط في وادٍ؟

28
00:03:08,200 --> 00:03:11,040
،إذا عَلِقَتْ عربتُنا في الوحل

29
00:03:11,040 --> 00:03:15,750
فإنّنا نُوازن بين التخلّي عنها
وبين البقاء فيها بعِناد

30
00:03:15,750 --> 00:03:18,280
نضع بعين الاعتبار قيمة البضاعة
،في العربة، والأرباح

31
00:03:18,280 --> 00:03:22,970
،والمال الّذي بحوزتنا، والجدول الزّمنيّ
وكلفة الحصول على مساعدة

32
00:03:22,970 --> 00:03:25,890
هناك أيضاً خطر احتماليّة أن يرانا أشرار

33
00:03:25,890 --> 00:03:30,380
نفكّر في كلّ هذه الأمور قبل أن نقرّر
التخلّي عن البضاعة من عدمه

34
00:03:30,380 --> 00:03:32,350
وأنت بهذا الوضع الآن؟

35
00:03:32,350 --> 00:03:33,270
هذا صحيح

36
00:03:33,270 --> 00:03:36,080
لا أريد التخلِّي عن عربتي

37
00:03:37,300 --> 00:03:40,190
سأضغط على نفسي بطيش إذا كان
هذا ما أحتاجه للحِفاظ على البضاعة

38
00:04:05,910 --> 00:04:07,640
هذا ما كنتُ أنتظر سماعه

39
00:04:08,760 --> 00:04:11,740
مهما كان الوقت قصيراً، إن لم يكن
،هناك خيار آخر

40
00:04:11,740 --> 00:04:15,180
فإنَّ التّاجر الرحّال الماهر كان
لينتظر فُرصته بصبر

41
00:04:15,180 --> 00:04:16,330
...سيّد باتوس

42
00:04:16,330 --> 00:04:20,340
لا أملك أي حجر بيريت الآن

43
00:04:20,340 --> 00:04:24,490
غير أنّني أعتقد بأنّ الخيميائيّين
لديهم مخزون

44
00:04:24,490 --> 00:04:25,320
...إذاً

45
00:04:25,320 --> 00:04:30,570
أخبرها، "أتيتُ لشراء صندوق
"لتخزين ريش أبيض

46
00:04:30,570 --> 00:04:32,290
بعد ذلك، يعتمد الأمر كلّه عليك

47
00:04:32,590 --> 00:04:33,870
!شكراً جزيلاً لك

48
00:04:33,870 --> 00:04:35,220
—سأحرص على شكر

49
00:04:36,010 --> 00:04:39,900
فقط اروِ لي حكاية قديمة لاحقاً

50
00:04:39,900 --> 00:04:44,090
هل تنبعث منّي نفس هالة الوقار
الّتي تنبعث من الآنسة؟

51
00:05:14,040 --> 00:05:15,460
هل من أحد في المنزل؟

52
00:05:21,910 --> 00:05:23,210
من الطّارق؟

53
00:05:23,770 --> 00:05:26,040
أعتذر على المجيء في وقت متأخّر من اللّيل

54
00:05:26,040 --> 00:05:29,360
اسمي لورينس. زرتُك في الأمس
مع السيّد باتوس

55
00:05:39,400 --> 00:05:41,520
أتيتُ مُدرِكاً وقاحتي تمام الإدراك

56
00:05:41,920 --> 00:05:44,360
أتيتُ لشراء صندوق لتخزين ريش أبيض

57
00:05:57,740 --> 00:06:00,330
المهرجانات تجذب النّاسَ باستمرار

58
00:06:01,370 --> 00:06:05,170
نادراً ما يأتي عددٌ من الزوّار في يوم واحد

59
00:06:09,530 --> 00:06:10,580
تفضّل

60
00:06:10,930 --> 00:06:16,100
هل سمعتَ عن صندوق الرّيش
الأبيض من السيّد باتوس؟

61
00:06:16,100 --> 00:06:17,530
أ-أجل

62
00:06:18,010 --> 00:06:21,310
فرضتُ نفسي عليه قليلاً لرؤيتك

63
00:06:21,310 --> 00:06:23,150
أحقّاً ذلك؟

64
00:06:23,560 --> 00:06:27,530
إنّه ليس من النّوع الّذي يستسلم
بسهولة للآخرين، أليس كذلك؟

65
00:06:27,530 --> 00:06:32,410
ما العمل الّذي تريده منّي والّذي
يتطلّب إقناع رجل عنيد مثله؟

66
00:06:32,750 --> 00:06:36,080
أريد شراء البيريت منكِ

67
00:06:36,080 --> 00:06:38,090
سمعتُ بأنّ سعره في ارتفاع

68
00:06:38,090 --> 00:06:38,660
...لكن

69
00:06:38,660 --> 00:06:44,460
أعلم بأنّ السيّد باتوس ما كان ليُساعدك
فقط مقابل مكاسب بسيطة في الأرباح

70
00:06:44,460 --> 00:06:46,550
لا بدّ أنّ لديك سبب مختلف، صحيح؟

71
00:06:46,900 --> 00:06:51,260
،لا أحتاج البيريت لكسب الرّبح
أحتاجه من أجل نِزال

72
00:06:51,260 --> 00:06:52,730
نِزال مع من؟

73
00:06:52,730 --> 00:06:53,720
...هذا

74
00:06:57,630 --> 00:06:58,600
لا

75
00:07:04,110 --> 00:07:06,110
ستكون تلك حمولتي

76
00:07:06,420 --> 00:07:07,660
حمولة؟

77
00:07:07,660 --> 00:07:10,280
عدوّ التّاجر هو بضاعته دوماً

78
00:07:10,690 --> 00:07:13,500
يجب عليه تقدير قيمتها وإيجاد
،طريقة للتّعامل معها

79
00:07:13,500 --> 00:07:15,640
والتّدقيق في وجهة التّسليم

80
00:07:15,640 --> 00:07:19,370
التّاجر الرحّال يخسر عندما يرتكب خطأ
في أيّ ناحية من هذه النّواحي

81
00:07:19,710 --> 00:07:24,420
الآن، أحاول سحب البضاعة التّي
على وشك أن تسقط من عربتي

82
00:07:24,810 --> 00:07:28,720
بعد إعادة النّظر في قيمة ووجهة
،بضاعتي وكيفيّة التّعامل معها

83
00:07:28,720 --> 00:07:32,080
أدركتُ بأنّني لا يجوز أن أُسقِط
حمولتي في منتصف الطّريق

84
00:07:33,930 --> 00:07:36,720
...شِراء صندوق لتخزين ريش أبيض

85
00:07:37,240 --> 00:07:39,310
،تبدو ككلمة مرور عظيمة

86
00:07:39,580 --> 00:07:45,110
لكن أعددتُها على أمل إيجاد
أشياء تُلفِت اهتمامي

87
00:07:45,110 --> 00:07:48,580
يتساقط ريشُ الطّائر تلقائيّاً عندما
يُرفرف بجناحيه من شدّة البهجة

88
00:07:48,580 --> 00:07:52,990
الأشخاص الّذين مُنِحوا كلمة المرور خاصّتي
سينتقون زُوّاري انتقاء كذلك

89
00:07:53,540 --> 00:07:56,370
جُلّ ما أحتاجه هو إلقاء نظرة أخيرة فحسب

90
00:07:58,210 --> 00:08:01,310
هل لديك بعض البيريت بمتناول اليد؟

91
00:08:01,310 --> 00:08:02,770
ليس لديّ

92
00:08:02,770 --> 00:08:05,300
رغم أنّني أعرف بضعة تُجّار
يمكنني شرائه منهم

93
00:08:05,300 --> 00:08:06,710
آمل أيضاً أن أشتري بعضاً منكِ يا آنسة ديانا

94
00:08:06,970 --> 00:08:08,350
لا مانع

95
00:08:08,350 --> 00:08:11,130
إذا كان مجرّد بيريت، فيمكنك شراءه منّا

96
00:08:11,500 --> 00:08:12,880
—شكراً جزيلاً لـ

97
00:08:13,550 --> 00:08:14,510
...لكن

98
00:08:15,230 --> 00:08:17,760
شخص آخر قد طلبَ شراءه قبلك بالفعل

99
00:08:18,450 --> 00:08:19,810
!كم الكمّية؟! بأيّ سعر؟

100
00:08:19,810 --> 00:08:22,010
اهدأ من فضلك

101
00:08:22,010 --> 00:08:26,350
ذلك الشّخص قد اشتراه بالدَّين
ولم يتلقَّ السّلعة الفعليّة بعد

102
00:08:26,350 --> 00:08:28,610
يمكنك أن تعتبره حجزاً

103
00:08:29,040 --> 00:08:32,780
شخصيّاً، لا مانع لديّ أن أبيعه
إيّاك بدلاً من ذلك

104
00:08:34,900 --> 00:08:37,450
لذا اسمح لي أن أتفاوض مع الطّرف الآخر

105
00:08:37,850 --> 00:08:42,160
كانت الكمّية ستّة عشر ألف إيليد
بسعر السُّوق اليوم

106
00:08:42,450 --> 00:08:44,710
...أي أربعمئة تريني فضّية

107
00:08:46,480 --> 00:08:47,660
فهمت

108
00:08:47,660 --> 00:08:50,450
المعذرة، ما هو اسم ذلك الشّخص؟

109
00:08:50,450 --> 00:08:52,460
سأكون أنا من يتولّى المُفاوضات

110
00:08:52,810 --> 00:08:59,560
كإجراء أمان، لا نسمح أبداً للآخرين
بمعرفة مَن تعاملَ معنا

111
00:08:59,560 --> 00:09:01,250
...لـ-لكن

112
00:09:01,250 --> 00:09:02,380
ألم يُرضِك هذا؟

113
00:09:08,620 --> 00:09:12,730
أين سوف أجدك يوم غد؟

114
00:09:12,730 --> 00:09:14,450
...في الواقع

115
00:09:14,450 --> 00:09:17,410
أمام عربة تاجر الحجر في السُّوق

116
00:09:17,800 --> 00:09:21,890
أعتقد ستتمكّنين من إيجادي هناك
في الفترة الّتي يفتتح فيها السُّوق

117
00:09:21,890 --> 00:09:22,430
—خِلاف ذلك

118
00:09:22,430 --> 00:09:23,700
هذا يكفي

119
00:09:24,030 --> 00:09:25,320
فهمت

120
00:09:25,320 --> 00:09:27,750
سأدع شخصاً يتواصل معك في أسرع وقت

121
00:09:28,000 --> 00:09:29,080
من فضلكِ

122
00:09:29,080 --> 00:09:30,710
لا أبالي للسّعر

123
00:09:30,710 --> 00:09:33,480
من فضلكِ أبلغي الطّرف الآخر
أنّه ما دام السّعر

124
00:09:33,480 --> 00:09:36,520
ليس ضعف القيمة الحاليّة، فيمكنني
شراءه بسعر أعلى بكثير

125
00:09:37,880 --> 00:09:41,200
أعتذر ثانية على المجيء في وقت
متأخِّر جدّاً من اللّيل

126
00:09:41,200 --> 00:09:42,180
لا عليك

127
00:09:42,180 --> 00:09:44,780
فأسلوب حياتي لا يلتزم بدورة النّهار واللّيل

128
00:09:44,780 --> 00:09:48,540
ولا أمانع أن تقيم اللّيلة هنا

129
00:09:48,540 --> 00:09:51,000
ما دمتَ تروي لي حكايات مُثيرة

130
00:09:52,740 --> 00:09:53,930
ما الأمر؟

131
00:09:55,480 --> 00:09:57,220
...في الواقع

132
00:09:57,220 --> 00:10:01,450
تعابير وجهك تُوحي بأنّ لديك
...ما تقوله قبل مغادرة منزل امرأة

133
00:10:01,450 --> 00:10:04,730
بئس الأمر، عسى أن ينزل الربُّ حكمه عليك

134
00:10:06,550 --> 00:10:08,560
هلّا طرحتُ سؤالاً؟

135
00:10:08,560 --> 00:10:09,720
تفضّل

136
00:10:10,120 --> 00:10:16,530
هل هناك أي قصّة حول إله وثنيّ
وبشريّ أصبحا زوجين؟

137
00:10:18,550 --> 00:10:19,300
أجل

138
00:10:20,510 --> 00:10:21,600
هناك الكثير

139
00:10:22,580 --> 00:10:23,790
!حقّاً؟

140
00:10:23,790 --> 00:10:25,830
...أجل، على سبيل المثال

141
00:10:25,830 --> 00:10:28,280
صحيح، كنتَ مستعجلاً

142
00:10:28,280 --> 00:10:32,300
...أ-أجل، صحيح، لكن

143
00:10:32,300 --> 00:10:35,920
هلّا حدّثتِني عن هذه الرّوايات
بالتّفصيل في المرّة المقبلة؟

144
00:10:37,510 --> 00:10:38,660
بالطّبع

145
00:10:40,580 --> 00:10:43,410
إذاً سأنتظر البيريت وكلّي أمل

146
00:10:43,410 --> 00:10:45,170
أجل، تصبح على خير

147
00:10:45,170 --> 00:10:46,310
أستأذن

148
00:10:49,380 --> 00:10:50,410
بالتّوفيق

149
00:10:50,410 --> 00:10:50,980
ماذا؟

150
00:10:59,220 --> 00:11:00,540
كيف سارت الأمور؟

151
00:11:00,540 --> 00:11:02,470
تكلّمتُ مع الآنسة ديانا

152
00:11:02,470 --> 00:11:05,760
لكن سبقَني مُشترٍ إلى ذلك، لذا
لستُ متأكِّداً ممّا سيحدث

153
00:11:05,760 --> 00:11:07,040
سبقَك مُشترٍ؟

154
00:11:07,040 --> 00:11:10,890
لهذا أُعلِّق آمالي عليك

155
00:11:10,890 --> 00:11:13,640
...أجل. بخصوص ذلك

156
00:11:13,640 --> 00:11:14,850
هلّا أعطيته التّقرير؟

157
00:11:14,850 --> 00:11:15,610
حـ-حاضر

158
00:11:15,950 --> 00:11:18,090
،ما دام الدّفع نقديّ مُقدّماً

159
00:11:18,090 --> 00:11:21,490
فهناك من البيريت ما قيمته ثلاثمئة
—وسبعون من القطع المعد

160
00:11:21,490 --> 00:11:23,290
هذا يكفي

161
00:11:24,680 --> 00:11:26,080
هذا ما في الأمر

162
00:11:26,080 --> 00:11:28,030
...ثلاثمئة وسبعون قطعة معدنيّة

163
00:11:28,030 --> 00:11:29,220
كلّ هذا المبلغ؟

164
00:11:30,380 --> 00:11:33,630
في الواقع، فكّرتُ بعد مغادرتك

165
00:11:34,010 --> 00:11:36,850
السّبب الوحيد الّذي جعله مصروف
جيب بالنّسبة لي

166
00:11:36,850 --> 00:11:39,470
كان لأنّني لم أكن أملك مالاً
إضافيّاً من الأساس

167
00:11:39,470 --> 00:11:41,510
لكن ماذا عن هذه بكثير من المال؟

168
00:11:41,510 --> 00:11:45,160
لا بدّ أنّ بعض الأشخاص
اشتروا كمّية كبيرة سرّاً

169
00:11:45,160 --> 00:11:47,890
،بخلاف التُجّار الرحّالين الوحيدين

170
00:11:47,890 --> 00:11:50,800
إنّهم تُجَّار ذوو سمعة مرموقة

171
00:11:50,800 --> 00:11:53,000
اشتروا الكثير، لكن الآن بعد
،ارتفاع السّعر بشكل كبير

172
00:11:53,000 --> 00:11:54,730
من الصّعب عليهم بيعهم كلّهم

173
00:11:55,000 --> 00:11:57,980
حتّى مقدار صغير قد تحوّل إلى ربح كبير

174
00:11:57,980 --> 00:12:02,360
الحسّاسون مُتردِّدون أكثر حتّى
عن بيعه بشكل علنيّ

175
00:12:02,760 --> 00:12:05,890
حسناً، أنا واثق بأنّك تستطيع تخمين
ما فعلتُه عقب ذلك

176
00:12:05,890 --> 00:12:08,790
طلبتَ من مُساعدك يتجوّل وينقل الإشاعات

177
00:12:09,230 --> 00:12:11,250
هناك تاجر رحّال طمّاع"

178
00:12:11,250 --> 00:12:16,040
يتجوّل ويشتري البيريت بمبالغ
"كبيرة نقداً. هل أنتم مهتمّون؟

179
00:12:16,360 --> 00:12:18,120
هذا صحيح

180
00:12:18,120 --> 00:12:19,240
هل ينبغي أن أرسله؟

181
00:12:19,240 --> 00:12:20,160
بالطّبع

182
00:12:20,160 --> 00:12:21,160
...إذاً

183
00:12:25,370 --> 00:12:26,740
ما الأمر؟

184
00:12:26,740 --> 00:12:27,770
أنا آسف

185
00:12:27,770 --> 00:12:30,530
يُفترَض بك أن تشكرني هنا

186
00:12:30,530 --> 00:12:33,150
...ماذا؟ أجل، بالطّبع. آسـ

187
00:12:34,610 --> 00:12:35,520
لا

188
00:12:36,150 --> 00:12:37,200
شكراً

189
00:12:39,110 --> 00:12:42,170
...لو كنتُ أعلم بأنّك شخص مُثير للاهتمام

190
00:12:42,170 --> 00:12:43,610
لا، الأمر ليس كذلك

191
00:12:44,000 --> 00:12:49,950
،لم تكن مجرّد تاجر ممتاز فحسب
إنّما تاجر بكل ما تحمله الكلمة من معنى

192
00:12:50,210 --> 00:12:54,320
لم تعتبرني صديقاً يوماً، أليس كذلك؟

193
00:12:54,910 --> 00:12:56,080
ماذا عن الآن؟

194
00:12:56,350 --> 00:13:00,260
هل ما زلت تعتبرني تاجراً ملائماً
لصفقاتك التّجاريّة؟

195
00:13:00,260 --> 00:13:01,340
لا

196
00:13:01,340 --> 00:13:06,470
إنّها مُشكلة يواجهها مُعظم التجّار
الرّحالين عندما يصبحون تُجّار بلدة

197
00:13:06,930 --> 00:13:10,680
لكن هناك شيء أكثر اهتماماً من ذلك

198
00:13:11,710 --> 00:13:13,090
دعني أطرح عليك هذا السّؤال

199
00:13:13,090 --> 00:13:15,980
،إذا كنّا سنفترق للأبد لسببٍ ما

200
00:13:15,980 --> 00:13:19,610
هل كنتَ لتتجوّل في البلدة بهذه
الاستماتة من أجلي؟

201
00:13:22,290 --> 00:13:24,600
حسناً، سأتطلّع قُدماً للمستقبل

202
00:13:24,600 --> 00:13:28,530
فأنت تتجوّل بهذه الطّريقة المسعورة
لأجل شريكتك تلك

203
00:13:29,580 --> 00:13:32,790
فهذا هو مظهر رجل ضعيف عندما تفتنه امرأة

204
00:13:32,790 --> 00:13:36,870
لكن وحدها الأغصان المرِنة يمكنها
تحمُّل الرّياح الشّديدة

205
00:13:37,380 --> 00:13:39,450
أظنُّك مثلي

206
00:13:39,450 --> 00:13:42,300
لعلّك تأثّرت بلعنة التُجّار الرحّالين

207
00:13:43,050 --> 00:13:44,220
لعنة؟

208
00:13:44,220 --> 00:13:48,320
أصبحتَ رجلاً مُثيراً للاهتمام
لأنّ تِلك اللّعنة قد رُفِعت

209
00:13:49,870 --> 00:13:51,010
ألا تشعر بذلك؟

210
00:13:51,290 --> 00:13:56,270
حدثَ وأن بدأتَ برحلاتك مع شريكتك
بمشيئة الحظّ، صحيح؟

211
00:14:04,440 --> 00:14:07,540
تذكّرني بنفسي عندما التقيتُ بأديلي

212
00:14:07,540 --> 00:14:08,740
أنت ملعون

213
00:14:09,230 --> 00:14:11,870
أصابتك لعنة التُجَّار الرحّالين

214
00:14:11,870 --> 00:14:14,190
لعنة التُجّار الرحّالين؟

215
00:14:14,190 --> 00:14:14,950
!تماماً

216
00:14:15,210 --> 00:14:16,370
تعلم، أليس كذلك؟

217
00:14:16,620 --> 00:14:19,040
يقول الشُّعراء بأنّ المال لا يستطيع شراء الحُبّ

218
00:14:19,040 --> 00:14:23,170
يعِظُ الواعِظون بأنّ هناك أشياء أهمّ
في العالم من المال

219
00:14:23,170 --> 00:14:26,780
،إذاً عندما يصبح جني المال صعباً جدّاً

220
00:14:26,780 --> 00:14:32,240
فكيف نحصل على شيء أثمن من ذلك؟

221
00:14:32,240 --> 00:14:33,770
!أخبره يا مارك

222
00:14:40,690 --> 00:14:45,730
،إذا عملنا بجدٍّ وحصلنا عليه أخيراً
فإنّه يصبح عزيزاً علينا، صحيح؟

223
00:14:46,050 --> 00:14:50,160
لكن المفاجئ أنَّ الأشياء القيِّمة حقّاً
من السّهل الحصول عليها

224
00:14:50,160 --> 00:14:55,040
وسرعان ما تجد نفسك تحمي أميرتك تلك

225
00:14:56,420 --> 00:14:59,710
العضلات ليست قوّة الفارس الوحيدة

226
00:15:00,260 --> 00:15:01,880
لا تتثبّط

227
00:15:03,670 --> 00:15:06,210
أنت الشّخصيّة الرّئيسيّة في هذه القصّة

228
00:15:07,590 --> 00:15:09,390
!ما أنت بالنّسبة لي؟

229
00:15:14,300 --> 00:15:15,540
فهمت؟

230
00:15:20,350 --> 00:15:22,520
!ما أنا بالنّسبة لك؟

231
00:15:33,210 --> 00:15:35,790
أشعر وكأنّني أستطيع منحها جواب الآن

232
00:15:36,420 --> 00:15:40,850
حسناً، أشعر وكأنّني لم أقدّم
نصيحة جيّدة كهذه منذ مدّة

233
00:15:40,850 --> 00:15:42,900
،بالإضافة إلى المعلومات عن الشّمال

234
00:15:42,900 --> 00:15:45,420
أشعر وكأنّ 10 لوميوني غير كافية

235
00:15:45,790 --> 00:15:48,550
إذا كانت كلّ هذه المعلومات من مصدر
آخر، فستكون صفقة سيّئة

236
00:15:50,370 --> 00:15:52,030
آمل أن تفلح الأمور بالنّسبة لك

237
00:15:52,030 --> 00:15:52,630
نعم

238
00:15:53,130 --> 00:15:56,810
حسناً، يعتمد مسار الأمور عليك

239
00:15:57,250 --> 00:15:57,860
ماذا؟

240
00:15:57,860 --> 00:16:00,170
وبعد؟ أين ستنام اللّيلة؟

241
00:16:00,170 --> 00:16:01,140
لم أقرّر

242
00:16:01,880 --> 00:16:02,480
—إذاً

243
00:16:02,480 --> 00:16:04,440
لا، لقد قرّرتُ في نهاية المطاف

244
00:16:05,180 --> 00:16:06,650
هل ستدعني أقضي اللّيلة هنا؟

245
00:16:06,650 --> 00:16:07,790
هنا؟

246
00:16:07,790 --> 00:16:08,640
نعم

247
00:16:08,640 --> 00:16:10,510
لديك بعض الأكياس المُستخدمة
لاحتواء القمح، صحيح؟

248
00:16:10,510 --> 00:16:11,650
أعرني بعضاً

249
00:16:11,920 --> 00:16:15,370
،لا أمانع إعطاءك قدر ما تحتاج
لكن ينبغي أن تأتي إلى المنزل

250
00:16:15,370 --> 00:16:17,720
مجّاناً

251
00:16:24,200 --> 00:16:26,460
أريد كسب بعض الخبرة

252
00:16:32,260 --> 00:16:33,380
حسناً، أيّاً يكن

253
00:16:33,840 --> 00:16:35,930
أراك ثانية عند الفجر إذاً

254
00:16:35,930 --> 00:16:37,050
أجل

255
00:16:37,050 --> 00:16:38,790
قبل ذلكل

256
00:16:41,000 --> 00:16:43,310
!لنتناول شراباً تمنّياً للحظّ السّعيد

257
00:17:01,070 --> 00:17:04,680
هولو، الطّقس بارد اليوم، لذا
...هل يمكنكِ وضع ذيلكِ

258
00:17:11,080 --> 00:17:13,550
!صباح الخير

259
00:17:14,090 --> 00:17:17,630
صباح الخير

260
00:17:18,070 --> 00:17:20,940
هل أخبرك مارك بما سنفعله اليوم؟

261
00:17:20,940 --> 00:17:23,060
لا، لم يفعل

262
00:17:23,060 --> 00:17:27,050
لكن سمعتُ بأنّنا سننصب فخّاً
...لشخص فظيع

263
00:17:27,050 --> 00:17:29,360
،لا أستطيع أن أخبرك بالتّفاصيل
لكن يوجد شيء من هذا القبيل

264
00:17:29,770 --> 00:17:33,160
قد تضطرّ لأداء عمل صعب
من أجل إنجاح الخطّة

265
00:17:33,160 --> 00:17:34,520
ما اسمك؟

266
00:17:34,520 --> 00:17:36,860
ماذا؟ في الواقع... اسمي لانت

267
00:17:37,170 --> 00:17:38,880
اسمي إيو لانت

268
00:17:38,880 --> 00:17:40,740
لا بدّ أنّك وُلِدت شمال هذه المنطقة

269
00:17:40,740 --> 00:17:41,610
أجل

270
00:17:41,610 --> 00:17:43,880
من قرية مُتجمِّدة من الثّلج والصّقيع

271
00:17:43,880 --> 00:17:44,800
هكذا إذاً

272
00:17:46,560 --> 00:17:48,800
لانت، أعتمد عليك اليوم

273
00:17:51,670 --> 00:17:54,680
حسناً، عليّ أن أملئ معدتي أوّلاً

274
00:17:54,680 --> 00:17:57,990
.هناك عربة تبيع خبزاً مُجفّفاً
هل أذهب وأشتري لك؟

275
00:17:59,320 --> 00:18:00,570
من فضلك

276
00:18:03,270 --> 00:18:06,200
المعذرة، قطعة واحدة تكفي
لشراء الكثير

277
00:18:06,200 --> 00:18:08,520
الأخرى هي لقاء عملك اليوم

278
00:18:08,880 --> 00:18:12,580
بالطّبع، ستحصل على أجر منفصل
ومناسب لاحقاً كذلك، لذا لا تقلق

279
00:18:13,060 --> 00:18:15,240
سيصل مارك إلى هنا إذا ماطلت كثيراً

280
00:18:16,010 --> 00:18:18,280
يقول بأنّ تناول الفطور رفاهية، صحيح؟

281
00:18:18,280 --> 00:18:19,920
!سـ-سأذهب حالاً

282
00:18:21,830 --> 00:18:24,300
لا تُفسِد مُساعدي

283
00:18:24,300 --> 00:18:26,030
إذاً كان يجدر بك أن تمنعني

284
00:18:26,030 --> 00:18:27,960
كان الجوّ بارداً جدّاً مؤخّراً

285
00:18:28,220 --> 00:18:30,920
ستكون مشكلة إذا أُصيبَ بنزلة
برد بسبب الجوع

286
00:18:30,920 --> 00:18:32,350
كذلك الأمر بالنّسبة لي

287
00:18:32,350 --> 00:18:35,960
فأساساً، هناك عمل أريد من لانت أن يقوم به

288
00:18:37,940 --> 00:18:41,780
يبدو أنّه يوم مشمس آخر. إنّه
يوم جيّد للبيع

289
00:18:47,480 --> 00:18:50,060
الجميع ينتظرون الشّراء ولا أحد يبيع

290
00:18:50,060 --> 00:18:51,730
سيرتفع السّعر اليوم أيضاً

291
00:18:51,730 --> 00:18:53,610
سنشتري قمحاً لاحقاً

292
00:18:53,610 --> 00:18:55,480
يجدر بنا التّركيز على البيريت الآن

293
00:18:55,480 --> 00:18:59,610
تريد زوجتي بعضاً أيضاً، لكن
...بهذا السّعر

294
00:19:00,140 --> 00:19:02,240
السّعر الوسطيّ هو ثمانمئة إيليد

295
00:19:02,580 --> 00:19:04,280
ثمانون ضعف السّعر الاعتياديّ

296
00:19:04,860 --> 00:19:08,710
المعذرة، ما الّذي يتطلّبه ليربح السيّد لورينس؟

297
00:19:08,710 --> 00:19:11,900
متى ترتفع الأسعار؟

298
00:19:11,900 --> 00:19:15,530
عندما يكون عدد المُشتريين
أكثر من كمّية المُنتج

299
00:19:15,530 --> 00:19:17,240
إذاً، متى ينخفض؟

300
00:19:17,240 --> 00:19:20,200
عندما تكون كمّية المُنتج أكثر
من عدد المُشتريين

301
00:19:20,200 --> 00:19:21,550
حسناً، هذا هو مُلخّص الأمر

302
00:19:22,120 --> 00:19:24,970
البيع مطلوب لتحريك السّوق

303
00:19:25,300 --> 00:19:30,850
إن لم يقُم أحدٌ بالبيع، فوحدهم الأشخاص
الّذي لديهم منه يحظون بأفضليّة

304
00:19:31,200 --> 00:19:35,570
لأنّ النّاس بيع، يستطيع الآخرون
الحصول عليه فيرتفع السّعر

305
00:19:35,570 --> 00:19:37,140
تماماً

306
00:19:37,140 --> 00:19:40,050
غير أنّ هدفه هذه المرّة ليس جني المال

307
00:19:40,050 --> 00:19:40,610
ماذا؟

308
00:19:40,610 --> 00:19:43,410
لا يريد من أماتي أن يكسب مالاً

309
00:19:43,410 --> 00:19:46,750
عليه أن يبحث عن التّوقيت المثاليّ
لبيع كمّية كبيرة من البيريت

310
00:19:46,750 --> 00:19:48,950
ويجعل السّعر يهوي

311
00:19:49,710 --> 00:19:52,730
إذا باع أماتي مخزونه حتّى
قبل ثانية من ذلك

312
00:19:52,730 --> 00:19:56,770
وحقّقَ هدفه وهو ألف فضّية، فسيربح

313
00:19:57,420 --> 00:20:02,180
تحتاج فقط للصّبر والعزيمة المناسبين
لإيجاد التّوقيت المثاليّ

314
00:20:39,400 --> 00:20:41,530
صباح الخير يا سيّد لورينس

315
00:20:41,530 --> 00:20:42,990
صباح الخير

316
00:20:42,990 --> 00:20:46,590
سيزدحم المكان حالما يُقرَع
جرس افتتاح السُّوق

317
00:20:47,020 --> 00:20:49,880
ارتأيتُ أن أعطيك هذا في أسرع وقت مُمكن

318
00:20:49,880 --> 00:20:50,720
ما هذا؟

319
00:20:51,020 --> 00:20:52,680
ما وعدتُك به

320
00:20:56,600 --> 00:20:58,040
قطع ريمار ذهبيّة

321
00:20:58,040 --> 00:21:01,150
أجل. ارتأيتُ أنّ حمل خمسمئة فضّية

322
00:21:01,150 --> 00:21:05,610
سيكون ثقيلاً وغير ملائم بالنّسبة لك

323
00:21:06,860 --> 00:21:09,370
أنا متأكّد بأنّك دفعت أجراً كبيراً
مقابل تصريف العملة

324
00:21:09,370 --> 00:21:11,370
لم يكن بالأمر الجلل

325
00:21:11,690 --> 00:21:14,540
،صرّفتُه بالقيمة السّوقيّة الحاليّة

326
00:21:14,540 --> 00:21:16,750
ليصبحوا 23 ريمار ذهبيّة

327
00:21:19,380 --> 00:21:20,340
فهمت

328
00:21:20,870 --> 00:21:21,800
تلقّيتُ المبلغ

329
00:21:21,800 --> 00:21:24,550
ألن تحصيه للتحقُّق؟

330
00:21:27,480 --> 00:21:31,470
والآن أريد عقد ما قيمته 500 فضّية من البيريت

331
00:21:31,820 --> 00:21:32,970
حـ-حسناً

332
00:21:37,000 --> 00:21:38,310
تلقّيتُه بالفعل

333
00:23:45,770 --> 00:23:49,770
الحلقة القادمة: يد الإله الخفيّة وقلب الذّئب الخفيّ