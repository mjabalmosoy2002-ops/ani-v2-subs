1
00:00:04,550 --> 00:00:06,360
!يا لها من بلدة ضخمة

2
00:00:06,750 --> 00:00:07,830
هذه باتزيو

3
00:00:08,970 --> 00:00:11,240
هل يقطن ملِكٌ هنا؟

4
00:00:11,240 --> 00:00:14,570
.إنّها بلدة من النّبلاء والتُجّار
لا يوجد ملِكٌ هنا

5
00:00:17,320 --> 00:00:21,410
لا أصدّق أنّه توجد بلدة بهذا العدد
...الكبير من النّاس بلا ملِك

6
00:00:21,410 --> 00:00:24,120
أليس عليكِ إخفاء وجهكِ؟

7
00:00:24,420 --> 00:00:25,460
وجهي؟

8
00:00:25,460 --> 00:00:28,990
النّاس من باسلوي قد يسافرون عبر هذا المكان

9
00:00:29,470 --> 00:00:31,830
كنتُ أتساءل ما إن كانوا سيعرفونكِ

10
00:00:31,830 --> 00:00:34,020
أهذا كلّ شيء؟

11
00:00:34,020 --> 00:00:36,130
عشتِ في تلك القرية مئات السّنين

12
00:00:36,130 --> 00:00:38,720
أليست لديهم أساطير حولكِ؟

13
00:00:38,720 --> 00:00:39,870
بلى

14
00:00:40,490 --> 00:00:43,640
"تظهر هولو أحياناً على شكل فتاة حسناء"

15
00:00:44,290 --> 00:00:49,150
يبدو أنّ عمرها دون العشرين"
،مع شعر انسيابيّ وأُذنَي ذئب

16
00:00:49,150 --> 00:00:54,150
"وذيل بنّي داكن أبيض عند الرّأس

17
00:00:54,530 --> 00:00:56,900
،ما دمت تُبقي شكلها سرّاً"

18
00:00:56,900 --> 00:01:00,070
"تعِد بحصادٍ وفير في العام التّالي

19
00:01:00,920 --> 00:01:03,190
!يعرفون كلّ صفاتكِ

20
00:01:05,050 --> 00:01:06,760
لن يعرفني أحد

21
00:01:06,760 --> 00:01:09,420
نسوني منذ زمن بعيد

22
00:01:10,790 --> 00:01:11,900
هكذا إذاً

23
00:01:14,510 --> 00:01:15,970
اسمع

24
00:01:17,050 --> 00:01:20,620
لن يعرفوني، صحيح؟

25
00:01:20,620 --> 00:01:23,140
هذا ما أتمنّاه

26
00:01:27,460 --> 00:01:29,580
حسناً، أنا متأكّدة بأنّ الأمور ستكون بخير

27
00:03:03,420 --> 00:03:06,040
!يبدو أنّ هناك الكثير من الأشياء اللّذيذة

28
00:03:06,450 --> 00:03:07,660
يبدو تفّاحاً لذيذاً

29
00:03:07,660 --> 00:03:10,330
!أليس كذلك؟ ألا تبدو شهيّة ومُغرية؟

30
00:03:13,590 --> 00:03:14,710
أجل

31
00:03:17,030 --> 00:03:18,350
هذا صحيح

32
00:03:18,350 --> 00:03:21,100
استثمر أحدُ معارفي في مشروع تفّاح

33
00:03:21,510 --> 00:03:24,360
أنفق أكثر من نصف ممتلكاته عليه

34
00:03:24,360 --> 00:03:28,410
لعلّ ثروته أعلى بكثير من ثروتي الآن

35
00:03:28,410 --> 00:03:30,060
كان ينبغي أن أستثمر أيضاً

36
00:03:30,060 --> 00:03:33,290
أ-أجل، هذه خسارة فعلاً

37
00:03:33,290 --> 00:03:35,480
لكن كان رِهاناً محفوفاً بالمخاطر

38
00:03:35,860 --> 00:03:37,690
كنتُ لأفضّل الاستثمار في سفينة تجاريّة

39
00:03:37,690 --> 00:03:39,170
سفينة تجاريّة؟

40
00:03:39,170 --> 00:03:42,650
التجّار الّذين لديهم عقود فيما بينهم
يدفعون مالاً من أجل استعارة واحدة

41
00:03:43,070 --> 00:03:47,070
مساحة المخزن الّتي يمكنك استخدامها
تعتمد على المبلغ الّذي دفعته

42
00:03:48,500 --> 00:03:49,610
ما الأمر؟

43
00:03:49,610 --> 00:03:50,580
...التفّاح

44
00:03:52,090 --> 00:03:54,580
آمل أن آكل بعض التفّاح

45
00:03:54,580 --> 00:03:57,000
هذا ما في الأمر إذاً

46
00:04:02,630 --> 00:04:03,300
تفضّلي

47
00:04:03,300 --> 00:04:04,890
اشتري قدر ما تشائين

48
00:04:08,250 --> 00:04:10,720
من ينفق قطعة فضّية كاملة على تفّاح؟

49
00:04:12,850 --> 00:04:15,850
أنت من قال بأنّني أستطيع شراء قدر ما أشاء

50
00:04:15,850 --> 00:04:18,070
احرصي على كسب قوت يومكِ بنفسكِ

51
00:04:18,420 --> 00:04:22,240
تظاهرتَ بأنّك لم تلحظ قبل قليل

52
00:04:22,240 --> 00:04:25,820
لا بدّ أنّه من الرّائع معرفة ما يفكّر
فيه الآخرون بوضوح شديد

53
00:04:26,420 --> 00:04:28,020
...سأتناول واحدة أيضاً

54
00:04:28,950 --> 00:04:29,700
!مؤلم

55
00:04:29,700 --> 00:04:31,290
!هذه لي

56
00:04:31,290 --> 00:04:33,120
!أنا من سدّد ثمنها

57
00:04:33,120 --> 00:04:37,850
أنا الذّئبة الحكيمة هولو. يمكنني
كسب هذا المقدار من المال بسرعة

58
00:04:37,850 --> 00:04:39,420
حسناً، أتطلّع قدماً لذلك

59
00:04:40,000 --> 00:04:43,780
!كانت تلك القطعة النّقديّة لمبيت اللّيلة

60
00:04:48,720 --> 00:04:50,940
التفّاح هو فاكهة الشّيطان

61
00:04:50,940 --> 00:04:54,530
إنّه مليء بالإغراء الحلو الّذي لا يُقاوم

62
00:04:54,530 --> 00:04:57,020
إذا كنتِ ذئبة حكيمة، فلِمَ لا تحاولين
التغلُّب على جشع كهذا؟

63
00:04:57,020 --> 00:05:02,940
،قد تخسر العديد من الأشياء بسبب الجشع
لكنّك لن تكسب شيئاً من الامتناع

64
00:05:08,130 --> 00:05:10,990
سنبيع الفراء في شركة ميلوني التّجاريّة هناك

65
00:05:12,540 --> 00:05:16,000
أعتقد كانت هناك أبنية أكبر
في طريقنا إلى هنا

66
00:05:16,280 --> 00:05:18,540
هذه ثالث أكبر شركة تجاريّة هنا

67
00:05:18,540 --> 00:05:21,740
غير أنّ هذا مجرّد فرع من شركة
ضخمة جدّاً تمّ تأسيسها

68
00:05:21,740 --> 00:05:23,260
في بلد يقع جنوباً من هنا

69
00:05:23,260 --> 00:05:26,480
بصيغة أخرى، كثيراً ما يشترون
سلعاً بسعر أعلى

70
00:05:26,480 --> 00:05:28,550
للمنافسة في السّوق كغُرباء

71
00:05:28,550 --> 00:05:29,380
...علاوة على ذلك

72
00:05:29,380 --> 00:05:35,220
يستطيعون جمع الكثير من المعلومات"
من خلال فروعهم المختلفة"، صحيح؟

73
00:05:35,220 --> 00:05:37,440
،بما أنّهم يديرون شركةً تجاريّة عابرة للحدود

74
00:05:37,720 --> 00:05:41,340
فلا بدّ أنّهم حسّاسون للتغيُّرات
...في سوق العملة

75
00:05:41,340 --> 00:05:43,030
...تـ-تماماً

76
00:05:44,470 --> 00:05:47,900
أريد التحرّي حول المعلومات الّتي
مدّنا بها الشّاب المدعو زيرين

77
00:05:51,230 --> 00:05:53,410
أهلاً بكما في شركة ميلوني التّجاريّة

78
00:05:53,410 --> 00:05:55,450
هناك الكثير من النّاس

79
00:05:55,450 --> 00:05:58,170
اقترب وقت بعثتنا الكبرى نحو الشّمال

80
00:05:58,170 --> 00:06:01,580
كان عدد السّلع الّتي تُنقَل من
وإلى روفينهايغن هائل

81
00:06:01,580 --> 00:06:03,960
لا أحد يتمنّى تفويت فُرص لدرّ المال

82
00:06:03,960 --> 00:06:05,210
أنت محقّ بشأن ذلك

83
00:06:05,520 --> 00:06:07,760
حسناً، ما العمل الّذي تريده منّا اليوم؟

84
00:06:07,760 --> 00:06:12,890
اشتريتُم قمحاً منّي سابقاً. اليوم
أرغب في بيع بعض الفِراء لكم

85
00:06:12,890 --> 00:06:16,370
مُرحَّب بالعمل دوماً. تفضّل من هنا رجاء

86
00:06:17,020 --> 00:06:20,460
شكراً لك على التّعامل مع شركتنا التّجاريّة اليوم

87
00:06:20,460 --> 00:06:22,900
سيّد كرافت لورينس، أليس كذلك؟

88
00:06:22,900 --> 00:06:24,460
نادِني لورينس فحسب رجاء

89
00:06:24,460 --> 00:06:28,610
يشرّفني أنّك ما زلت تتذكّر اسمي
منذ ثلاث سنوات مضت

90
00:06:28,610 --> 00:06:30,730
لا، لا. المعذرة

91
00:06:30,730 --> 00:06:35,450
سمعتُ بأنّك تنوي بيعنا فِراء اليوم؟

92
00:06:35,450 --> 00:06:39,920
أجل. لديّ سبعون فِراء سِنسار
ذو جودة عالية اليوم

93
00:06:40,180 --> 00:06:42,460
يا له من جلد ناعم

94
00:06:42,460 --> 00:06:46,130
،كانت المحاصيل وفيرة في هذا العام
لذا لم نحصل على الكثير من جلد السِّنسار

95
00:06:46,130 --> 00:06:48,630
أنا متأكّد بأنّ كافّة المُزارعين انشغلوا
بالأعمال الزّراعيّة في هذا العام

96
00:06:48,630 --> 00:06:51,350
رغم ذلك، تمكّنتُ من جمع هذا
العدد من الفِراء عالي الجودة

97
00:06:51,350 --> 00:06:53,140
إنّها أكثر من مقبولة

98
00:06:53,660 --> 00:06:57,770
،حسناً، بما أنّنا تعاملنا معك من قبل

99
00:06:58,490 --> 00:07:02,350
ما رأيك بـ 132 تريني فضّية؟

100
00:07:05,610 --> 00:07:08,490
من الصّعب الحصول على فِراء بهذه الجودة

101
00:07:09,050 --> 00:07:15,410
كنتُ آمل أن نوطّد علاقتنا
...من خلال هذه التّجارة

102
00:07:15,410 --> 00:07:18,950
تتمنّى شركتُنا فعل ذلك أيضاً

103
00:07:18,950 --> 00:07:21,750
...بوضع علاقتنا المستقبليّة بعين الاعتبار

104
00:07:21,750 --> 00:07:25,210
ما رأيك بـ 140 فضّية؟

105
00:07:25,520 --> 00:07:27,550
...أجل، إذاً دعنا

106
00:07:29,730 --> 00:07:30,910
أستأذن قليلاً لو سمحت

107
00:07:32,420 --> 00:07:33,330
ما الأمر؟

108
00:07:33,330 --> 00:07:36,330
لا أعرف شيئاً عن السّوق. كيف هو السّعر؟

109
00:07:36,330 --> 00:07:37,220
ممتاز

110
00:07:40,890 --> 00:07:43,940
إذاً، هل هذا السّعر مقبول؟

111
00:07:43,940 --> 00:07:46,820
!‏140 تريني فضّية

112
00:07:46,820 --> 00:07:49,080
أهذا ما قلتَه؟

113
00:07:49,080 --> 00:07:50,370
أجل

114
00:07:50,370 --> 00:07:52,860
قلتُ 140 تريني فضّية

115
00:07:53,170 --> 00:07:56,490
أرى بأنّك تاجر ذو قدرة استثنائيّة

116
00:07:56,490 --> 00:08:00,290
لحظة، ألهذا السّبب تتظاهر بأنّك لم تلحظ؟

117
00:08:00,710 --> 00:08:03,170
إذا كان كذلك، فلا يمكننا
إرخاء دفاعنا أمامك

118
00:08:03,170 --> 00:08:08,050
ا-المعذرة. هل فاتني شيء؟

119
00:08:08,820 --> 00:08:12,010
سيّدي، من فضلك كُفّ عن تنمُّر كهذا

120
00:08:12,010 --> 00:08:14,550
لـ-لم تكن تلك نيّتي

121
00:08:14,550 --> 00:08:16,740
أخبريه

122
00:08:17,300 --> 00:08:18,930
حاضرة يا سيّدي

123
00:08:19,770 --> 00:08:22,660
سيّدي، شُمّ رائحة هذا الجلد

124
00:08:26,790 --> 00:08:27,560
ما رأيك؟

125
00:08:27,560 --> 00:08:29,860
هل هذه رائحة فواكه؟

126
00:08:30,470 --> 00:08:35,030
أجل، أنتجت الغابات الكثير من الفواكه
في هذا العام أيضاً

127
00:08:35,030 --> 00:08:38,530
هذا فِراء سِنسار عاش في غابة كهذه

128
00:08:38,530 --> 00:08:40,780
امتلأت بطونهم بكثير من الطّعام اللّذيذ

129
00:08:40,780 --> 00:08:43,620
لدرجة أنّ أجسامهم تنضح رائحة عذبة

130
00:08:43,620 --> 00:08:44,960
!بالفعل

131
00:08:44,960 --> 00:08:47,290
جودة جلد السِّنسار هذا هي العليا

132
00:08:47,290 --> 00:08:53,090
يتطلّب سلخه رجلان ضخمان باعتبار
أنّ أجساد السِّنسار كانت متينة

133
00:08:53,370 --> 00:08:54,740
حاول شدّ الجلد

134
00:08:55,730 --> 00:08:56,740
!أكثر

135
00:08:57,540 --> 00:08:58,550
ما رأيك؟

136
00:08:59,290 --> 00:09:01,890
إنّه مرِن كحيوان شرِس

137
00:09:01,890 --> 00:09:07,600
يستطيع أن يدفئك كدفء أشعّة الشّمس
في الرّبيع ويطرد رطوبة الأمطار

138
00:09:07,600 --> 00:09:10,520
علاوة على ذلك، هذه الرّائحة

139
00:09:10,520 --> 00:09:14,530
تخيّل كم سيكون هذا متألّقاً بين الملابس الأخرى

140
00:09:14,530 --> 00:09:20,080
المصنوعة من فِراء سِنسار عاديّ ذي رائحة كريهة

141
00:09:20,080 --> 00:09:24,460
أنا متأكّدة بأنّك تستطيع بيعه بسعر لا نظير له

142
00:09:25,370 --> 00:09:26,540
والآن

143
00:09:26,540 --> 00:09:30,050
أخبرني ثانية من فضلك بأيّ سعر
تريد شراء هذا الفِراء؟

144
00:09:30,910 --> 00:09:32,210
...حسناً إذاً

145
00:09:35,310 --> 00:09:37,970
ماذا عن 200 تريني فضّية؟

146
00:09:40,660 --> 00:09:44,140
ماذا عن 3 فضّيات مقابل كلّ قطعة جلد؟

147
00:09:44,140 --> 00:09:46,270
بعبارة أخرى، 210 قطعة فضّية

148
00:09:48,220 --> 00:09:50,400
سيّدي، ما رأيك بشركة تجاريّة أخرى؟

149
00:09:50,910 --> 00:09:54,650
!قـ-قبلت! سأشتريها بـ 210 فضّية

150
00:09:55,750 --> 00:09:58,070
هذا ما يقوله يا سيّدي

151
00:09:58,070 --> 00:10:00,410
أ-أجل

152
00:10:09,580 --> 00:10:11,700
!الخمر هو الأطيب بالفعل

153
00:10:12,380 --> 00:10:15,800
ألن تشرب؟ على حسابي

154
00:10:15,800 --> 00:10:18,340
هل عملتِ تاجرة من قبل؟

155
00:10:18,980 --> 00:10:23,140
ماذا؟ هل أهنتُ كرامتك بتصرّفاتي؟

156
00:10:23,910 --> 00:10:29,230
استخدمتُ للتو نفس الطّريقة كتاجر
حادّ الذّكاء زار القرية من قبل

157
00:10:29,230 --> 00:10:31,900
لم ألفّق ذلك من عندي

158
00:10:41,340 --> 00:10:44,320
لكن لم ألحظ أبداً

159
00:10:44,320 --> 00:10:48,330
لمستُهم عدّة مرّات ولم أشتمّ رائحة الفاكهة

160
00:10:48,330 --> 00:10:52,540
حسناً، كان ذلك من التُّفّاح الّذي
اشتريتُه من قبل

161
00:10:53,670 --> 00:10:54,890
!...هذا يعني أنّ

162
00:10:54,890 --> 00:10:56,970
"إنّها غلطته لوقوعه في الفخّ"

163
00:10:56,970 --> 00:10:58,520
...حسناً، ما كنتُ لأتمادى بهذا القول

164
00:10:58,520 --> 00:11:01,890
لكنّني متأكّدة بأنّه سيندهش من معرفته
بوجود طريقة كهذه

165
00:11:01,890 --> 00:11:03,690
حسناً، قد تكونين على حقّ

166
00:11:03,690 --> 00:11:07,180
النّاس الّذين يغضبون بسرعة نتيجة
الانخداع لن ينجحوا في حياتهم

167
00:11:07,180 --> 00:11:09,490
أي محترف حقيقيّ كان ليندهش
من هزيمته بهذه الطّريقة

168
00:11:10,390 --> 00:11:14,410
بغضّ النّظر عن ذلك، هل فعلتَ ما أردت فعله؟

169
00:11:15,690 --> 00:11:16,890
حاليّاً

170
00:11:17,670 --> 00:11:21,490
لم يبدُ أنّهم على علم ببلد

171
00:11:21,490 --> 00:11:23,820
سُكَّت قطعها النّقديّة الفضّية حديثاً

172
00:11:23,820 --> 00:11:27,660
لم يبدُ لي أنّ شركة ميلوني التّجاريّة
...تخفي شيئاً أيضاً

173
00:11:28,700 --> 00:11:32,120
،حسناً، مهما كانت الحيلة وراء رواية زيرين

174
00:11:32,700 --> 00:11:35,570
أنا بخير ما دمتُ لا أخسر المال وأكسب ربحاً

175
00:11:37,730 --> 00:11:40,290
!بصحّة لمّ شملنا

176
00:11:44,260 --> 00:11:46,050
هذا كحول لذيذ

177
00:11:46,050 --> 00:11:49,880
هذا يعني أنّك حقّقتَ ربحاً كبيراً
!من بيع الفِراء

178
00:11:49,880 --> 00:11:50,820
أجل

179
00:11:50,820 --> 00:11:52,310
يسرّني سماع ذلك

180
00:11:52,640 --> 00:11:56,610
كلّما استثمرت مالاً أكثر، حقّقتُ ربحاً أكبر

181
00:11:56,610 --> 00:11:57,900
لنكتفِ بهذا القدر

182
00:11:58,550 --> 00:12:03,370
قلتَ بأنّك أردت حصّةً من أرباحي
مقابل معلومات حول

183
00:12:03,370 --> 00:12:06,600
أي القطع النّقديّة سوف تُسَكّ
بنسبة أعلى من الفضّة

184
00:12:06,600 --> 00:12:08,300
هل كلامي صحيح؟

185
00:12:08,300 --> 00:12:08,910
أجل

186
00:12:08,910 --> 00:12:11,080
هل أنت متأكّدٌ من هذه المعلومات؟

187
00:12:11,080 --> 00:12:13,080
...حسناً، قبل أي شيء

188
00:12:13,080 --> 00:12:17,160
هذا تخمين من بعض المعلومات الّتي حصلتُ
عليها من بلدة تعدين كنتُ أقطن فيها

189
00:12:17,160 --> 00:12:20,240
أعتقد أنّ المعلومات موثوقة تماماً

190
00:12:20,240 --> 00:12:22,880
...لكن كما تعلم

191
00:12:22,880 --> 00:12:25,720
لا يوجد شيء مؤكَّد في العمل

192
00:12:27,270 --> 00:12:28,390
هذا صحيح

193
00:12:28,690 --> 00:12:31,970
كنتُ أنوي رفض عرضك لو قلتَ
بأنّك متأكّد بشكل كامل

194
00:12:31,970 --> 00:12:34,130
لأنّها ستكون صفقة مشبوهة

195
00:12:35,010 --> 00:12:37,110
حسناً، ما حصّتك؟

196
00:12:37,110 --> 00:12:40,840
أجل، أريد عشرة تريني فضّية مقابل المعلومات

197
00:12:40,840 --> 00:12:43,860
وعشرة بالمئة من أرباحك

198
00:12:44,140 --> 00:12:45,700
طلباتك خجولة

199
00:12:45,700 --> 00:12:50,580
هذا لأنّني لا أتحمّل مسؤوليّة خسارتك في النّهاية

200
00:12:50,580 --> 00:12:52,830
،مقابل الحِفاظ على نسبة عشرة بالمئة

201
00:12:52,830 --> 00:12:56,980
يمكنني إعادة العشر فضّيات خاصّتك

202
00:12:56,980 --> 00:12:59,770
لإنهاء الصّفقة إذا خسرتَ

203
00:12:59,770 --> 00:13:00,960
هكذا إذاً

204
00:13:00,960 --> 00:13:06,000
سيكون تاريخ التّسوية قبل ثلاثة أيّام
من سوق الرّبيع الضّخم في العام المقبل

205
00:13:06,000 --> 00:13:10,390
أعتقد أنّ كلّ هذا سيحدث قبل نهاية هذا العام

206
00:13:10,390 --> 00:13:13,480
في غضون نصف عام؟ يبدو هذا جيّداً

207
00:13:13,480 --> 00:13:17,540
إذاً أرغب في كتابة عقد عند
كاتب العدل العامّ غداً

208
00:13:17,540 --> 00:13:18,670
فهمت

209
00:13:18,670 --> 00:13:22,860
!بصحّة أرباحنا

210
00:13:25,110 --> 00:13:26,420
!فاروم فضّية

211
00:13:26,420 --> 00:13:29,380
خطأ. هذه قطعة مارين فضّية مزيّفة

212
00:13:29,380 --> 00:13:30,870
أليست هي هذه؟

213
00:13:30,870 --> 00:13:33,740
هذه فضّية مهرجان يوم ميلاد ميتزفينغ المُقدّس

214
00:13:35,110 --> 00:13:37,290
ستتعلّمين التّفريق بينها بينما تستخدمينها

215
00:13:37,290 --> 00:13:39,340
لنستأنف بعد أن تصحي من الشّرب

216
00:13:39,340 --> 00:13:41,590
!لا! مرّة أخرى

217
00:13:42,850 --> 00:13:45,260
ليس باليد حيلة. احرصي على الإصغاء جيّداً

218
00:13:45,720 --> 00:13:49,260
تريني فضّية، فيلينغ فضّية، إيلايد فضّية

219
00:13:49,730 --> 00:13:52,510
لوت فضّية، مارين مزيّفة فضّية

220
00:13:52,900 --> 00:13:56,180
فاروم فضّية، ملِك كالفوس لامباردو فضّية

221
00:13:56,630 --> 00:14:01,440
كاتدرائيّة ميتزفينغ فضّية، كاتدرائيّة
ميتزفينغ فضّية مزيّفة

222
00:14:01,440 --> 00:14:03,320
ميتزفينغ مقدّسة فضّية

223
00:14:03,320 --> 00:14:05,650
...ومهرجان يوم ميلاد ميتزينغ المُقدّس

224
00:14:05,650 --> 00:14:08,060
يكفي. سوف أنام

225
00:14:08,450 --> 00:14:09,990
خيار حكيم

226
00:14:09,990 --> 00:14:14,040
لماذا هناك أنواع مختلفة كثيرة؟

227
00:14:14,040 --> 00:14:16,840
،مع صعود وسقوط ممالك جديدة

228
00:14:16,840 --> 00:14:21,670
تستمرّ الكنيسة في سكّ أنواع
جديدة من القطع النّقديّة

229
00:14:21,670 --> 00:14:23,820
علاوة على ذلك، التّزوير لا يتوقّف

230
00:14:24,350 --> 00:14:28,140
كانت لوت الفضّية في الأصل تُدعى
...تريني مزيّفة فضّية

231
00:14:45,320 --> 00:14:46,900
شكراً على المعلومات

232
00:14:46,900 --> 00:14:48,900
شكراً لك

233
00:14:48,900 --> 00:14:51,820
سيّدي، آمل أن تجني كثيراً من المال

234
00:14:51,820 --> 00:14:54,770
!آمل أن تبقي جميلة يا سيّدة

235
00:14:54,770 --> 00:14:57,370
...ظلّ صاخباً حتّى آخر لحظة

236
00:14:58,100 --> 00:15:00,330
حسناً، أي قطعة فضّية هي هدفنا؟

237
00:15:00,330 --> 00:15:02,430
هذه. تريني فضّية

238
00:15:03,670 --> 00:15:07,000
إنّها قطعة موثوقة جدّاً في هذه المنطقة

239
00:15:07,000 --> 00:15:08,130
موثوقة؟

240
00:15:08,450 --> 00:15:11,400
أجل. هناك مئات الأنواع من العملة

241
00:15:11,400 --> 00:15:14,350
ونسبة الفضّة والذّهب فيها كثيراً ما تتغيّر

242
00:15:14,830 --> 00:15:20,010
قيمة القطعة المعدنيّة النّقديّة أعلى
بكثير من الفضّة أو الذّهب فيها

243
00:15:20,500 --> 00:15:23,340
لهذا الثّقة بها مطلوبة للتعاملات التّجاريّة

244
00:15:23,340 --> 00:15:24,420
هكذا إذاً

245
00:15:24,850 --> 00:15:27,110
حسناً، ماذا ستفعل بها؟

246
00:15:27,410 --> 00:15:31,310
لستُ أدري، لكن لديّ بعض الأفكار بشأن ذلك

247
00:15:32,390 --> 00:15:34,220
أريد أن آكل هذا

248
00:15:39,250 --> 00:15:42,000
حسناً، ماذا أدركت؟

249
00:15:42,000 --> 00:15:45,250
قد تكون روايته صحيحة إذا كانت
لها صِلة بعملة تريني الفضّية

250
00:15:47,070 --> 00:15:48,550
هذه فيلينغ فضّية

251
00:15:49,010 --> 00:15:52,260
نسبة الفضّة فيها عالية وهي
مُتداولة في السُّوق

252
00:15:52,580 --> 00:15:54,890
قد تُعتبَر قطعة مُنافسة لتريني

253
00:15:56,170 --> 00:15:58,810
مهما كان العصر، قيمة القطعة النّقديّة

254
00:15:58,810 --> 00:16:01,220
تعتمد دوماً على قوّة البلد

255
00:16:01,220 --> 00:16:04,650
إذا كانت العملة الأجنبيّة تهيمن
،على سوق بلد

256
00:16:05,130 --> 00:16:07,520
فإنّه يكون مُحاصراً اقتصاديّاً

257
00:16:07,520 --> 00:16:09,740
هذا أشبه بالخسارة في حرب

258
00:16:10,180 --> 00:16:11,380
،بصيغة أخرى

259
00:16:16,240 --> 00:16:17,330
أجل

260
00:16:18,810 --> 00:16:23,830
لهذا قد لا يكون زيرين يكذب بالضّرورة
كما كنتِ قد توقّعتِ

261
00:16:23,830 --> 00:16:27,690
حسناً، أُذنايّ ليستا بتلك المثاليّة

262
00:16:29,370 --> 00:16:32,590
ماذا؟ هل ظننت بأنّني سأغضب؟

263
00:16:33,660 --> 00:16:35,100
أجل

264
00:16:35,100 --> 00:16:38,740
لكن، قد أغضب من رأيك عنّي

265
00:16:41,380 --> 00:16:42,810
إلى أين أنت ذاهب؟

266
00:16:42,810 --> 00:16:43,980
الجسر

267
00:16:44,680 --> 00:16:47,520
أحد معارفي هو تاجر عملات هناك

268
00:16:47,800 --> 00:16:51,900
من الصّعب تمييز بريق العملة بدقّة

269
00:16:52,350 --> 00:16:54,900
رغم ذلك، سبب صعود وانهيار عملات
معيّنة من حيث التّداول هو

270
00:16:54,900 --> 00:16:58,490
لأنّ النّاس حسّاسون للتغيُّرات
في بريق الفضّة والذّهب

271
00:16:59,120 --> 00:17:02,790
لدرجة الاعتقاد بأنّ تغيُّراً طفيفاً
قد يكون تغيُّراً هائلاً

272
00:17:03,410 --> 00:17:06,840
لهذا هناك دوماً دلالة من نوع ما

273
00:17:06,840 --> 00:17:08,990
عندما تخضع عملة لتغيُّر كبير

274
00:17:10,040 --> 00:17:11,550
لا حاجة لتذكُّر كلّ هذا دُفعة واحدة

275
00:17:11,850 --> 00:17:14,680
سأشرحه لكِ رويداً في الشّهر المقبل

276
00:17:14,680 --> 00:17:15,700
...بعبارة أخرى

277
00:17:16,090 --> 00:17:20,500
عندما يقرّر سكّاك النّقود إجراء تغيير
،كبير في بريق قطعة نقديّة

278
00:17:20,500 --> 00:17:27,230
فإنّه يبدأ بالتّغيير البسيط لمراقبة
،ردّة فعل السُّوق

279
00:17:28,690 --> 00:17:31,170
أ-أجل، هـ-هذا صحيح بعض الشّيء

280
00:17:32,510 --> 00:17:34,620
لم أرك منذ وقت يا وايز

281
00:17:34,620 --> 00:17:35,780
!لورينس

282
00:17:36,220 --> 00:17:39,540
سررتُ بلقائك. ما اسمكِ؟

283
00:17:39,540 --> 00:17:41,370
...اسمي هولو

284
00:17:41,370 --> 00:17:43,900
!هولو. يا له من اسم جميل

285
00:17:43,900 --> 00:17:45,000
...مهلك

286
00:17:45,000 --> 00:17:49,710
ما رأيكِ بالعمل في متجري؟
...وبأن تصبحي زوجتي

287
00:17:49,710 --> 00:17:53,980
تاجر عملة يتعامل مع عملات
مختلفة كثيرة، أليس كذلك؟

288
00:17:53,980 --> 00:17:55,840
لا أعرف الكثير عنها

289
00:17:55,840 --> 00:18:00,350
لا مشكلة! سأعلّمكِ! يمكننا
!أن نستغرق وقتنا

290
00:18:00,720 --> 00:18:03,010
وايز، أردتُ التكلُّم معك حول أمر

291
00:18:03,260 --> 00:18:04,520
ما هو؟

292
00:18:04,520 --> 00:18:07,970
أريد أن أرى بعض قطع تريني
فضّية مسكوكة حديثاً

293
00:18:09,550 --> 00:18:11,230
من الأقدم إلى الأحدث

294
00:18:11,710 --> 00:18:13,460
لم يتغيّر شيء

295
00:18:13,460 --> 00:18:17,400
حتّى أمثالي الّذين يتعاملون مع المال
يوميّاً لم يلحظوا أي تغيُّر

296
00:18:18,250 --> 00:18:20,340
هل أنت مهتمّ بتذويبها وتفقّد ذلك؟

297
00:18:20,340 --> 00:18:23,080
!أحمق. لا أستطيع فعل ذلك

298
00:18:23,080 --> 00:18:25,410
هل يمكنني رؤيتهم كذلك؟

299
00:18:25,410 --> 00:18:26,450
هل لاحظتِ شيئاً؟

300
00:18:26,450 --> 00:18:27,660
!افعلي ما يحلو لكِ

301
00:18:30,250 --> 00:18:32,540
يا لك من رجل شقيّ

302
00:18:33,690 --> 00:18:36,550
آسف! أنتِ جميلة لدرجة لم أتحمّل

303
00:18:36,840 --> 00:18:38,970
راقب من فضلك

304
00:18:41,760 --> 00:18:43,600
هذا مستحيل

305
00:18:43,600 --> 00:18:48,230
كنتُ تاجر عملات لعقود ولا أستطيع
تمييز البريق من خلال الصّوت فقط

306
00:18:48,230 --> 00:18:52,560
،سمعتُ بأُناس يستطيعون التّمييز
لكن حتّى تلك الرّوايات مجرّد خُرافات

307
00:18:55,370 --> 00:18:56,830
ما رأيك؟ هل يمكنكِ التّمييز؟

308
00:18:57,390 --> 00:18:58,950
إطلاقاً

309
00:18:58,950 --> 00:19:01,240
ما باليد حيلة. ما باليد حيلة

310
00:19:01,240 --> 00:19:03,620
انسي أمر الفضّة وتناولي العشاء
معي بدلاً من ذلك

311
00:19:04,290 --> 00:19:05,970
يا له من رجل مُثير للاهتمام

312
00:19:05,970 --> 00:19:08,010
إنّه زير نساء

313
00:19:08,700 --> 00:19:12,920
هل ازداد البريق؟ أم نَقُص؟

314
00:19:12,920 --> 00:19:16,420
أصبحتَ ماهراً في خداع الآخرين
للحصول على إجابة

315
00:19:16,420 --> 00:19:18,350
رأيتُ حركة أُذنيكِ

316
00:19:18,860 --> 00:19:20,410
لا يمكنني أن أرخي دفاعي أمامك

317
00:19:20,410 --> 00:19:23,640
تفاجأتُ من عدم قولكِ شيئاً

318
00:19:23,640 --> 00:19:26,600
حسناً، كانت طريقتي في شكرك

319
00:19:26,930 --> 00:19:27,700
شكري؟

320
00:19:27,700 --> 00:19:30,250
أصابتك الغيرة قبل قليل، أليس كذلك؟

321
00:19:30,250 --> 00:19:31,520
فعلتُ هذا لأشكرك على ذلك

322
00:19:32,150 --> 00:19:33,810
لا حاجة للانزعاج من ذلك

323
00:19:33,810 --> 00:19:37,480
الذّكور جميعهم أغبياء غيّورون

324
00:19:37,480 --> 00:19:42,290
والإناث غبيّات يشعرنَ بالسّعادة
حيال أمور كهذه

325
00:19:42,290 --> 00:19:44,660
العالم مليء بالأغبياء

326
00:19:46,570 --> 00:19:49,160
كيف كانت القطع الفضّية؟

327
00:19:50,660 --> 00:19:55,340
،كانت مُتدرِّجة بشكل مُتقارب
لكن القطع الأحدث تبدو أبهت

328
00:19:55,340 --> 00:19:59,710
...أبهت؟ إذاً البريق يتناقص

329
00:19:59,710 --> 00:20:02,060
ما يعني أنَّ زيرين قد كذب

330
00:20:03,270 --> 00:20:07,560
من السّهل تحقيق ربح إذا كان بريق
الفضّة أو الذّهب يتزايد

331
00:20:07,820 --> 00:20:11,540
كلّ ما عليك فعله هو شراء القطع القديمة
ومبادلتها بالقطع الجديدة

332
00:20:11,540 --> 00:20:14,060
،لكن إذا كان البريق يتناقص

333
00:20:14,060 --> 00:20:16,730
فمن الصّعب جني المال حتّى
...لو كنّا نعلم سلفاً

334
00:20:17,340 --> 00:20:21,620
،يمكن شراؤهم كلّهم عندما تتناقص قيمتهم

335
00:20:21,620 --> 00:20:24,100
لكن نحتاج لتمويل أوّلي من أجل شيء كهذا

336
00:20:24,100 --> 00:20:27,780
...ومن غير المرجّح تحقيق ربح في نصف عام

337
00:20:28,740 --> 00:20:33,050
لا أملك فكرة. كيف ينوي زيرين
تحقيق ربح من هذا؟

338
00:20:35,500 --> 00:20:38,460
لعلّك قد خُدِعت

339
00:20:38,460 --> 00:20:42,670
خُدِعت؟ تقصدين بأنّه نصبَ عليّ
بالفضّيات العشرة الّتي أخذها منّي؟

340
00:20:42,670 --> 00:20:46,280
،لا. إذا نَقُصت قيمة تريني الفضّية

341
00:20:46,280 --> 00:20:49,210
فسيُعيد ذلك الفتى الفضّيات العشرة لك

342
00:20:49,210 --> 00:20:51,770
في أسوأ الحالات، لن يجني مالاً

343
00:20:51,770 --> 00:20:53,530
،من النّاحية الأخرى، إذا زادت القيمة

344
00:20:53,530 --> 00:20:57,980
سيكسب عشرة بالمئة من الأرباح
دون المُخاطرة بأي أموال

345
00:20:58,260 --> 00:21:01,190
حتّى لو لم يكسب شيئاً، لن يخسر شيئاً

346
00:21:01,190 --> 00:21:02,940
أفهم ما تقصدينه

347
00:21:02,940 --> 00:21:05,130
البشر سريعو الاستيعاب

348
00:21:05,130 --> 00:21:07,910
...لا أصدِّق ذلك. يا له من خطأ بدائيّ

349
00:21:08,460 --> 00:21:09,630
...كلّ ما في الأمر

350
00:21:10,660 --> 00:21:14,540
هل من الشّائع للبريق في الفضّة أن يتناقص؟

351
00:21:14,540 --> 00:21:17,200
لا، في العادة مستوى بريق قطعة فضّية

352
00:21:17,200 --> 00:21:19,000
يبقى على حاله مع العناية القصوى

353
00:21:20,060 --> 00:21:24,980
تلقّينا فجأة معلومات عن بريق
قطعة في وقت كهذا

354
00:21:24,980 --> 00:21:26,310
هل هي صدفة حقّاً؟

355
00:21:29,460 --> 00:21:33,600
أحياناً نحن الذّئاب نتسلّق شجرة
عند اصطياد فريسة

356
00:21:33,600 --> 00:21:38,650
نغيّر منظورنا. تبدو الغابة مختلفة
من أعلى شجرة

357
00:21:38,650 --> 00:21:41,110
ينبغي أن أغيّر منظوري؟

358
00:21:41,110 --> 00:21:46,030
ربّما ذلك الفتى ليس المحتال الحقيقيّ هنا؟

359
00:21:47,280 --> 00:21:53,140
قد لا يحتاج ذلك الفتى للحصول
على أرباح منّا بشكل مُباشَر

360
00:21:53,140 --> 00:22:00,210
لعلّه طُلِبَ منه بواسطة شخص
ذِكر هذه الصّفقة أمام الآخرين

361
00:22:00,700 --> 00:22:01,540
!هكذا إذاً

362
00:22:01,800 --> 00:22:03,000
فهمتُ الأمر

363
00:22:03,000 --> 00:22:06,510
فهمتُ طريقة جني المال بقطعة فضّية
!تنخفض من حيث القيمة

364
00:22:06,510 --> 00:22:08,840
يبدو أنّك أدركت شيئاً

365
00:22:08,840 --> 00:22:09,590
!هيّا بنا

366
00:22:10,480 --> 00:22:11,490
إلى أين؟

367
00:22:12,100 --> 00:22:13,710
!إلى شركة ميلوني التّجاريّة

368
00:23:45,700 --> 00:23:49,820
:الحلقة القادمة
تاجر عاطفيّ ووداع تحت ضوء القمر