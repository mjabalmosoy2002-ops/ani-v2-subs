1
00:00:08,160 --> 00:00:09,280
حسناً

2
00:00:09,860 --> 00:00:12,010
اكتملت التّحضيرات ليوم غد

3
00:00:12,010 --> 00:00:16,120
أما زلنا نتلقّى طلبات هانابيرا موتشي لشوغاتسو؟

4
00:00:16,120 --> 00:00:18,670
فقط لزبائننا المعتادين لفترة طويلة

5
00:00:18,670 --> 00:00:21,960
علينا أن نذهب لإلقاء التحيّة وأداء زيارات القبر

6
00:00:23,330 --> 00:00:24,840
أهذه بقايا؟

7
00:00:24,840 --> 00:00:26,600
أجل، يمكنك أن تفعل ما تشاء بها

8
00:00:26,600 --> 00:00:28,790
إن لم تستعملها، تخلّص منها

9
00:00:28,790 --> 00:00:32,170
أنت! لمَ لا تقول فحسب "يمكنك المتابعة والتمرّن"؟

10
00:00:32,160 --> 00:00:32,840
!أحمق

11
00:00:33,430 --> 00:00:35,450
،يمكنك أن تتمرّن

12
00:00:35,450 --> 00:00:37,260
لكن في الأصل، الهانابيرا موتشي

13
00:00:37,610 --> 00:00:40,320
قد صُنِعَتْ من الهيشيهانابيرا موتشي
التي كانت تُقدّم في البلاط الإمبراطوري

14
00:00:40,320 --> 00:00:43,830
لأوّل مراسم شاي أوراسينكي من كلّ سنة

15
00:00:45,060 --> 00:00:47,930
جذر غوبو والّذي يُغلى لمدّة ثلاثة أيّام
،بلياليها كي يُصبح حلواً

16
00:00:47,930 --> 00:00:52,250
يُلفّ بميسو آن بيضاء يتمّ صبغها باللّون
القرمزيّ الباهت وموتشي غيوهي حلوة

17
00:00:52,610 --> 00:00:56,570
لأجل زبائننا الّذين يحبّون  الهانابيرا
،خاصّتنا وفضّلوها على غيرنا

18
00:00:57,000 --> 00:00:58,630
لا يجوز أن نقدّم لهم أيّ هانابيرا سيّئة

19
00:01:00,150 --> 00:01:03,630
احرص على نقش ذلك في رأسك

20
00:01:03,630 --> 00:01:05,920
أجل. فهمت

21
00:01:11,670 --> 00:01:14,360
!العام الجديد قد وصل

22
00:01:14,360 --> 00:01:15,010
حقّاً؟

23
00:01:15,010 --> 00:01:17,310
مُبارك البدء بالعام الجديد

24
00:01:17,310 --> 00:01:19,160
أجل. مُبارك

25
00:01:19,160 --> 00:01:21,930
سأعتمد عليك في هذا العام أيضاً

26
00:03:10,530 --> 00:03:11,480
!مرحباً

27
00:03:12,540 --> 00:03:15,590
ما هذا؟ وأنا الّذي ظننتُ بأنّني
سأكون أوّل الواصلين إلى هنا

28
00:03:18,460 --> 00:03:19,760
!إنّها إشراقة الشمس الأولى

29
00:03:19,760 --> 00:03:21,590
مذهل

30
00:03:24,390 --> 00:03:26,140
تهانينا بدء العام الجديد

31
00:03:26,970 --> 00:03:29,940
أجل، تهانينا

32
00:03:32,920 --> 00:03:35,400
،النوع الّذي يُصنع بحساء سوماشي نقيّ لذيذ

33
00:03:35,680 --> 00:03:39,900
لكن أجل، يجب أن يكون حساء أوزوني حساءَ
ميسو أبيض يحتوي على موتشي دائريّة

34
00:03:39,900 --> 00:03:42,160
لدينا المزيد والمزيد إذا أردت طبقاً ثانياً

35
00:03:42,160 --> 00:03:43,690
!أريد! أريد

36
00:03:44,170 --> 00:03:45,020
إتسكا

37
00:03:45,020 --> 00:03:45,490
حاضرة؟

38
00:03:45,490 --> 00:03:47,380
تفضّلي. الأوتوشيداما خاصّتكِ

39
00:03:47,990 --> 00:03:49,660
شكراً لك

40
00:03:49,950 --> 00:03:51,880
آمل أن تكوني فتاة صالحة في هذا العام أيضاً

41
00:03:51,880 --> 00:03:52,590
حسناً

42
00:03:52,590 --> 00:03:54,560
!من الرّائع أن تحصلي على أوتوشيداما

43
00:03:54,560 --> 00:03:58,140
هلّا اعتبرتِ هذا مُقدّماً من عائلة إيرينو بأسرها؟

44
00:04:00,260 --> 00:04:02,720
أمزح. كفّا عن التحديق بصمت

45
00:04:02,720 --> 00:04:04,600
أحمل ظرفاً

46
00:04:04,600 --> 00:04:06,180
تفضّلي. هذا منّي

47
00:04:07,460 --> 00:04:09,600
شكراً لك

48
00:04:09,600 --> 00:04:11,050
قبل أن أنسى

49
00:04:11,580 --> 00:04:14,250
لديك طلبيّة توصيل لاحقاً

50
00:04:14,250 --> 00:04:15,900
لدينا طلبيّة توصيل؟

51
00:04:17,030 --> 00:04:18,300
!قادمة

52
00:04:19,440 --> 00:04:22,030
!تهانينا بدء العام الجديد

53
00:04:22,030 --> 00:04:24,750
!أتينا لأخذ الهانابيرا موتشي خاصّتنا

54
00:04:24,750 --> 00:04:26,320
!أتينا

55
00:04:26,320 --> 00:04:29,820
تهانينا لكم أيضاً. لحظة من فضلكم

56
00:04:29,820 --> 00:04:32,410
هل تريدون أوزوني قبل الذّهاب؟

57
00:04:32,410 --> 00:04:36,320
!سنذهب إلى بيت أقربائنا الآن

58
00:04:36,320 --> 00:04:37,460
!سنذهب

59
00:04:37,460 --> 00:04:40,520
سنزور والدَي زوجي ونقضي رحلة
عائليّة في نفس الوقت

60
00:04:40,520 --> 00:04:42,080
هذا رائع

61
00:04:42,080 --> 00:04:45,100
في هذه الحالة، ستتمكّنون من أكل
الكثير من الطعام الشهيّ

62
00:04:45,100 --> 00:04:46,050
!أجل

63
00:04:46,050 --> 00:04:47,790
!حسناً، توخّوا الحذر

64
00:04:47,790 --> 00:04:48,810
!حسناً

65
00:04:48,810 --> 00:04:49,550
هيّا بنا

66
00:04:49,550 --> 00:04:51,530
!أريد أن أصل إلى هناك بسرعة

67
00:04:51,970 --> 00:04:54,540
سأعود بعد قليل

68
00:04:54,540 --> 00:04:56,480
حسناً. انتبه على نفسك

69
00:05:03,270 --> 00:05:04,860
أنا آسف

70
00:05:05,320 --> 00:05:08,260
نحن لا نقوم إلّا بتعبئة الطلبات المسبقة اليوم

71
00:05:09,240 --> 00:05:12,870
حقّاً؟ آسف لإزعاجكم

72
00:05:21,590 --> 00:05:23,210
!البرد قارس

73
00:05:27,280 --> 00:05:28,660
إنّه هو

74
00:05:29,450 --> 00:05:30,680
المعذرة

75
00:05:31,550 --> 00:05:34,480
التقينا قبل قليل أمام المحلّ

76
00:05:37,640 --> 00:05:41,820
قبر أمّي قريب كما ترى

77
00:05:41,820 --> 00:05:46,320
تركتُ العناية بقبرها للأقرباء لفترة
...منذ فترة طويلة، لكن

78
00:05:46,320 --> 00:05:50,910
مؤخّراً، تحدث أمور سيّئة باستمرار

79
00:05:51,320 --> 00:05:52,910
ماذا تقصد؟

80
00:05:53,520 --> 00:05:57,630
كسر إصبع قدمي الخنصر والدّوس
...على نظّارتي وكسرها

81
00:05:57,630 --> 00:06:01,760
التّجادل مع زوجتي وتلقّي الرّكل في الوجه

82
00:06:03,800 --> 00:06:07,160
،أردتُ أن أظهر ندمي على إهمالي السّابق

83
00:06:07,160 --> 00:06:12,510
وارتأيتُ بأنّني أستطيع على الأقلّ أن أقدّم
...لها حلويّات الريوكوشو المفضّلة لديها، لكن

84
00:06:12,840 --> 00:06:17,020
.حتّى في هذا الأمر، حظّي تعيس
يراودني هذا الشّعور رغماً عنّي

85
00:06:18,180 --> 00:06:23,050
أعلم بأنّ عليّ الذهاب، لكن لا تُسعفني قدمايّ

86
00:06:25,520 --> 00:06:29,130
المعذرة، لديّ اقتراح

87
00:06:30,650 --> 00:06:33,120
ما رأيك أن تصبح من معارفي؟

88
00:06:35,910 --> 00:06:38,020
تأخّر ناغومو-سان كثيراً، أليس كذلك؟

89
00:06:38,800 --> 00:06:42,440
بئساً، هل ينبغي أن نتركه ونمضي
في الهاتسومودي؟

90
00:06:46,310 --> 00:06:49,380
غالباً يماطل ويتباطأ في طريق عودته

91
00:06:53,330 --> 00:06:54,760
...غير ممكن

92
00:07:01,380 --> 00:07:02,590
ناغومو-سان؟

93
00:07:02,900 --> 00:07:03,900
—ما الّذي كنتَ تفعله

94
00:07:03,900 --> 00:07:05,730
!صه

95
00:07:06,560 --> 00:07:09,400
!توزّع الهانابيرا موتشي الّذي أعددته كتمرين؟

96
00:07:09,400 --> 00:07:12,860
!تعلم بأنّك لا تستطيع فعل ذلك
!سيتمّ توبيخك

97
00:07:12,860 --> 00:07:15,580
...أعلم! أعلم، لكن

98
00:07:15,880 --> 00:07:19,640
قطعَ كلّ المسافة إلى هنا لأنّه أراد
أن يقدّم لها حلويّاتنا

99
00:07:20,000 --> 00:07:21,620
هذا يسعدني

100
00:07:23,800 --> 00:07:28,560
...أعلم بأنّ ما أعددتُه للتدريب لا يمكن بيعه

101
00:07:28,560 --> 00:07:32,220
لكن ارتأيتُ بأنّه لا مشكلة إذا
أعطيتُهم لأحد معارفي

102
00:07:32,970 --> 00:07:35,440
،أعددتُهم كتمرين

103
00:07:35,440 --> 00:07:38,970
لكن الآن، غيوهي موتشي الحلوى، وجذر
الغوبو كلّهم بنكهة الريوكوشو

104
00:07:39,900 --> 00:07:42,980
أنا متأكّد بأنّ بوذا سيسامحني على هذا

105
00:07:44,900 --> 00:07:46,740
سأذهب لإحضار كيس

106
00:07:48,410 --> 00:07:52,860
أنا في فترة تدريب، لذا ينبغي ألّا يكون
هناك مانع أن أساعدك، صحيح؟

107
00:07:53,200 --> 00:07:54,920
نحن في نفس الظرف

108
00:07:58,070 --> 00:07:59,700
آسف لو تأخّرت

109
00:07:59,700 --> 00:08:01,880
هـ-هل أنت متأكّد؟

110
00:08:01,880 --> 00:08:03,800
!شكراً جزيلاً لك

111
00:08:03,800 --> 00:08:05,290
كم ينبغي أن أدفع لك؟

112
00:08:05,290 --> 00:08:07,540
لا داعي

113
00:08:07,540 --> 00:08:11,000
أعددتُ هذه الحلويّات كتدريب، لذا
هي ليست مُتقنة تماماً

114
00:08:11,000 --> 00:08:13,840
إذا تلقّيتُ مالاً مقابله، سيتمّ توبيخي

115
00:08:13,840 --> 00:08:17,160
فضلاً عن ذلك، أعطيك إيّاها لأنّك من معارفي

116
00:08:17,160 --> 00:08:19,860
لو كنتَ زبوناً، ما كنتُ لأعطيك إيّاها

117
00:08:22,020 --> 00:08:24,700
،رغم أنّك تقول بأنّها غير مُتقنة تماماً

118
00:08:24,700 --> 00:08:28,820
إنّها أكثر من كافية بالنسبة لي
لأقدّمها في القبر

119
00:08:29,150 --> 00:08:32,520
أنا متأكّد بأنّها تنتظر زيارتك

120
00:08:32,520 --> 00:08:34,240
اذهب لرؤيتها

121
00:08:34,600 --> 00:08:37,310
في المرّة القادمة، سآتي كزبون

122
00:08:37,310 --> 00:08:38,860
سنكون في الانتظار

123
00:08:58,930 --> 00:09:00,300
إنّه شهيّ

124
00:09:03,190 --> 00:09:05,520
الحيّ هادئ حقّاً

125
00:09:05,520 --> 00:09:08,000
رحلَ الجميع إلى المُدن

126
00:09:08,000 --> 00:09:10,190
من اللّطيف أن نستغرق وقتنا في زيارتنا

127
00:09:10,510 --> 00:09:13,910
!تهانينا لكم

128
00:09:20,400 --> 00:09:22,040
هل أتيتِ إلى هنا في العام الفائت أيضاً؟

129
00:09:22,040 --> 00:09:22,950
أجل

130
00:09:22,950 --> 00:09:24,810
ماذا تمنّيتِ؟

131
00:09:26,410 --> 00:09:27,770
أنت تفتقر للّباقة

132
00:09:27,770 --> 00:09:29,630
معكِ حقّ. أنا آسف

133
00:09:30,210 --> 00:09:35,110
في العام الماضي، تمنّيتُ أن أجد أبي قريباً

134
00:09:37,340 --> 00:09:40,260
ها نحن ذا... ماذا؟

135
00:09:43,020 --> 00:09:44,490
!ها نحن ذا

136
00:09:46,820 --> 00:09:48,760
حسناً، هل نقدّم احترامنا؟

137
00:09:50,980 --> 00:09:54,730
إذا تمنّيتِ من أعماق قلبكِ، فإنّ
أمنياتكِ ستتحقّق بالتأكيد، صحيح؟

138
00:09:54,730 --> 00:09:59,320
أتظنّ ذلك؟ سمعتُ بأنّ الآلهة هنا تحبّ الاختصار

139
00:09:59,320 --> 00:10:00,570
حقّاً؟

140
00:10:00,570 --> 00:10:03,800
حسناً، لا بدّ أنّ الآلهة مشغولة

141
00:10:03,800 --> 00:10:07,790
إذا منحتْ ولو نصف أمنية، ربّما يمكننا
مسامحتهم على الباقي

142
00:10:07,790 --> 00:10:11,130
سامحتُهم سلفاً منذ مدّة طويلة

143
00:10:15,960 --> 00:10:20,120
أتمنّى أن يكون الجميع في ريوكوشو بصحّة
جيّدة وسعادة في العام المقبل

144
00:10:20,800 --> 00:10:22,220
...و

145
00:10:22,220 --> 00:10:26,090
أتمنّى أن يكون ناغومو-سان أكثر
جدّية قليلاً تجاه الأمور

146
00:10:29,200 --> 00:10:36,100
أتمنّى أن يكفّ شخص ما عن القول
بأنّ حلويّاته غير متقنة

147
00:10:36,530 --> 00:10:38,110
هل كُشِف أمرنا؟

148
00:10:39,200 --> 00:10:43,530
عندما تهبّ الرّياح من الشّرق، دعيها"
"تحمل رائحتك إليّ يا أزهار البرقوق

149
00:10:43,530 --> 00:10:46,570
"ورغم أنّ ضيفك قد لا يكون هنا، لا تنسي الرّبيع"

150
00:10:48,340 --> 00:10:51,150
بدأت براعم البرقوق تنتفخ، أليس كذلك؟

151
00:10:51,150 --> 00:10:53,990
...قد يكون الطقس بارداً الآن، لكن اقترب الرّبيع، أليس كذلك

152
00:10:54,900 --> 00:10:55,930
يا كومي؟

153
00:10:57,800 --> 00:10:59,970
!يا لها من حلويّات ظريفة

154
00:10:59,970 --> 00:11:02,390
ما فكرة هذه؟

155
00:11:02,390 --> 00:11:08,220
القُرمُز الملفوف يمثّل براعم زهرة البرقوق
التي تتفتّح في اليوم الأوّل من الرّبيع

156
00:11:08,220 --> 00:11:12,730
حقّاً؟ إذاً هذه الحلوى هي شيء يمكننا
الحصول عليه خلال فترة سيتسوبون

157
00:11:12,730 --> 00:11:14,230
أجل، تماماً

158
00:11:14,230 --> 00:11:17,950
إذاً سأطلب القُرمُز الملفوف مع ماتشا من فضلك

159
00:11:17,950 --> 00:11:19,100
وكذلك أنا

160
00:11:19,100 --> 00:11:20,530
اثنتان، صحيح؟

161
00:11:20,940 --> 00:11:22,220
...على ذكر الأامر

162
00:11:22,700 --> 00:11:24,520
ستذهبين لمهرجان السيتسوبون، صحيح؟

163
00:11:24,520 --> 00:11:27,180
رفقة كانوكو وميتسورو-تشان. أنتم الثّلاثة معاً

164
00:11:27,180 --> 00:11:28,100
أجل

165
00:11:28,500 --> 00:11:30,910
آمل أن تكون الأمور... سلميّة

166
00:11:30,910 --> 00:11:31,870
سلميّة؟

167
00:11:33,060 --> 00:11:34,910
!مرحباً

168
00:11:34,910 --> 00:11:36,710
!أوتسوروسان

169
00:11:36,710 --> 00:11:38,630
لكن لا عمل لديكِ اليوم

170
00:11:39,630 --> 00:11:42,750
قالت هارومي بأنّها لن تتمكّن من العودة
إلى المنزل في الوقت المعتاد

171
00:11:42,750 --> 00:11:45,980
...لذا ذهبتُ لأقلهم من الرّوضة بدلاً من ذلك، لكن

172
00:11:45,980 --> 00:11:47,180
!كنتُ أنا من قال ذلك

173
00:11:47,180 --> 00:11:49,640
قلتُ بأنّني أردتُ أكل حلويّات من ريوكوشو

174
00:11:49,640 --> 00:11:54,020
حقّاً؟ حسناً، شكراً على القدوم
يا يو-تشان وكومي-تشان

175
00:11:54,020 --> 00:11:55,500
توقّفي يا عمّتي

176
00:11:56,640 --> 00:11:59,360
!ناديني موناكا

177
00:11:59,360 --> 00:12:00,640
مـ-موناكا؟

178
00:12:00,640 --> 00:12:01,720
!كومي

179
00:12:02,530 --> 00:12:06,110
،"في أنمي "فرقة حلويّات التحوّل، باتي وبوري

180
00:12:06,110 --> 00:12:07,950
هذا هو اسم الفتاة ذات لون زهرة الدرّاق

181
00:12:07,950 --> 00:12:11,390
هناك خمسة منهن وكلّ واحدة منهن
بارعة في حلوى معيّنة، صحيح؟

182
00:12:11,390 --> 00:12:12,370
!هذا صحيح

183
00:12:12,700 --> 00:12:14,830
موناكا-تشان بارعة في الواغاشي

184
00:12:14,830 --> 00:12:18,520
"وكنيتي هي مومونوسي من "ِشلّالات الدرّاق
وهي بلون زهرة الدرّاق

185
00:12:19,000 --> 00:12:20,400
!ناغومو-تشان

186
00:12:20,400 --> 00:12:20,960
!يا للهول

187
00:12:21,440 --> 00:12:22,590
...المهارة الخاصّة

188
00:12:22,590 --> 00:12:24,760
!ميتاراشي هيفن بومبر

189
00:12:24,760 --> 00:12:26,330
!مؤلم

190
00:12:25,280 --> 00:12:26,330
!كومي

191
00:12:26,330 --> 00:12:28,200
!أخبرتُكِ بأنّني أكره هذا الاسم

192
00:12:28,200 --> 00:12:29,890
حسناً، حسناً

193
00:12:31,810 --> 00:12:33,740
ما الحلوى التي تحبّينها؟

194
00:12:34,620 --> 00:12:36,700
هذه الحمراء ظريفة

195
00:12:36,700 --> 00:12:38,980
حقّاً؟ إنّها حلوى برقوق أومي

196
00:12:40,280 --> 00:12:41,610
لن أتناولها إذاً

197
00:12:41,610 --> 00:12:43,160
سأطلب شيئاً آخر

198
00:12:43,160 --> 00:12:45,070
!يو-تشان تريد أوزينزاي

199
00:12:45,070 --> 00:12:46,700
حسناً. حساء أوزينزاي لك

200
00:12:47,350 --> 00:12:50,490
أنا آسفة! هل أمّي والأطفال هنا؟

201
00:12:50,490 --> 00:12:51,950
هارومي-تشان؟

202
00:12:51,950 --> 00:12:52,780
!كومي

203
00:12:52,780 --> 00:12:53,960
...هارومي

204
00:12:54,410 --> 00:12:56,270
ماذا فعلتِ لشيغي-كن؟

205
00:13:00,900 --> 00:13:02,970
تواصلت معي الرّوضة

206
00:13:02,970 --> 00:13:05,990
قالوا بأنّ كومي تشاجرت مع صديقتها

207
00:13:06,800 --> 00:13:09,550
معلّمتكِ قلقة عليكِ حقّاً

208
00:13:10,290 --> 00:13:11,700
...لكن أعني

209
00:13:12,390 --> 00:13:13,850
...الكتاب المُصوّر

210
00:13:14,530 --> 00:13:16,230
...العجوز أوميبوشي

211
00:13:16,950 --> 00:13:18,220
أوميبوشي؟

212
00:13:18,970 --> 00:13:20,650
أكره أوميبوشي

213
00:13:20,650 --> 00:13:21,320
لماذا؟

214
00:13:21,320 --> 00:13:24,250
!إنّها حامضة ومليئة بالتّجاعيد

215
00:13:24,250 --> 00:13:27,450
!"كومي، يوجد في اسمكِ "أومي

216
00:13:27,450 --> 00:13:29,180
!أوميبوشي

217
00:13:29,180 --> 00:13:30,870
!أنتِ امرأة عجوز مليئة بالتّجاعيد

218
00:13:30,870 --> 00:13:33,980
!ميتاراشي هيفن بومبر

219
00:13:30,870 --> 00:13:34,540
!مؤلم

220
00:13:35,080 --> 00:13:37,460
برقوق أومي غير ظريف إطلاقاً

221
00:13:37,740 --> 00:13:40,600
...إنّه مليء بالتّجاعيد وحامض

222
00:13:40,600 --> 00:13:42,090
!أكرهه

223
00:13:42,090 --> 00:13:45,910
!أكره برقوق أومي

224
00:13:53,030 --> 00:13:54,810
أنا آسفة جدّاً

225
00:13:55,100 --> 00:13:57,200
وقد سهرنا حتّى وقت متأخّر من اللّيل أيضاً

226
00:13:57,200 --> 00:13:59,770
إنّها مُتعبة جدّاً من البكاء حتّى غلبها النّعاس

227
00:13:59,770 --> 00:14:02,110
يو-تشان، لا بدّ أنّكِ نعسانة أيضاً

228
00:14:02,110 --> 00:14:06,110
يسرّني أنّني تعلّمتُ سبب كلّ
شيء، لكن... اسمها؟

229
00:14:06,110 --> 00:14:08,030
لا بدّ أنّ هذا صعب عليكِ

230
00:14:08,790 --> 00:14:12,450
لا بأس يا أمّي. ستفهم يوماً ما

231
00:14:12,450 --> 00:14:16,620
ناغومو، أنا آسفة. كومي وقحة معك دوماً

232
00:14:16,620 --> 00:14:19,960
في الواقع... اطلبي منها من فضلكِ أن
تخفّف من استخدام مهارتها الخاصّ

233
00:14:19,960 --> 00:14:21,220
لن يكون ذلك ممكناً

234
00:14:24,850 --> 00:14:27,950
أنت وهارومي-سان ترعرعتما معاً، أليس كذلك؟

235
00:14:27,950 --> 00:14:30,220
...أجل. إنّها تكبرني بعامين

236
00:14:30,220 --> 00:14:31,640
لكن كنّا في الرّوضة معاً

237
00:14:32,260 --> 00:14:35,740
رغم ذلك، إنّه شيء تحمله معها طوال حياتها

238
00:14:35,740 --> 00:14:38,140
آمل أن تتوصّل لطريقة للتصالح مع الواقع

239
00:14:39,120 --> 00:14:40,650
وكذلك أنا

240
00:14:48,580 --> 00:14:52,240
عندما تهبّ الرّياح من الشّرق، دعيها"
"تحمل رائحتك إليّ يا أزهار البرقوق

241
00:14:53,160 --> 00:14:56,790
"ورغم أنّ ضيفك قد لا يكون هنا، لا تنسي الرّبيع"

242
00:15:01,580 --> 00:15:03,080
...لنرَ

243
00:15:03,920 --> 00:15:05,830
...الرّيوكوشو هي

244
00:15:07,760 --> 00:15:09,720
!المزيد من الشّاي رجء

245
00:15:09,720 --> 00:15:11,040
تفضّلي

246
00:15:11,040 --> 00:15:13,020
!إتسكا-تشان، شكراً لكش

247
00:15:13,020 --> 00:15:14,010
كومي-تشان

248
00:15:14,010 --> 00:15:14,940
!موناكا

249
00:15:14,940 --> 00:15:18,800
موناكا-تشان، أين جدّتكِ ويو-تشان؟

250
00:15:18,800 --> 00:15:20,390
تلعبان في الحديقة

251
00:15:20,390 --> 00:15:23,020
لم أرد اللّعب، لذا أتيتُ إلى المحلّ

252
00:15:23,020 --> 00:15:24,680
!نادي أوتسوروسان

253
00:15:27,400 --> 00:15:29,280
سمعتُ من أمّك

254
00:15:29,280 --> 00:15:33,800
قالت بأنّ معلّمتك تكلّمت مع الجميع
كي لا يتنمّرون عليك بعد الآن

255
00:15:33,800 --> 00:15:35,200
!هذا سارّ

256
00:15:35,780 --> 00:15:38,870
لكن أكره برقوق أومي. إنّه غير ظريف

257
00:15:39,280 --> 00:15:40,890
...ما زالت لا تحبّه إذاً

258
00:15:41,990 --> 00:15:43,290
!مرحباً

259
00:15:44,130 --> 00:15:47,340
هل تريدين شيئاً على الماشي؟
أم تريدين الجلوس في محلّ الشّاي؟

260
00:15:47,340 --> 00:15:51,370
المعذرة، هل هناك فتاة تدعى كومي هنا؟

261
00:15:51,880 --> 00:15:53,460
كومي-تشان؟

262
00:15:56,220 --> 00:15:58,640
كومي-سان؟ أهذا اسمها الأوّل؟

263
00:15:58,640 --> 00:16:02,270
المعذرة... هذا اسم مسرحي قديم

264
00:16:02,270 --> 00:16:03,270
اسم مسرحي؟

265
00:16:03,560 --> 00:16:06,520
...لدينا كومي-تشان طفلة هناك، لكن

266
00:16:06,520 --> 00:16:08,220
!ليس كومي! موناكا

267
00:16:08,690 --> 00:16:10,600
هل أتيتِ إلى هنا لأنّكِ سمعتِ الاسم من شخص؟

268
00:16:10,600 --> 00:16:13,860
أجل! أنا هنا بمهمّة من جدّي

269
00:16:14,550 --> 00:16:17,130
هذا جدّي منذ فترة طويلة مع كومي-سان

270
00:16:17,130 --> 00:16:19,540
سمعتُ بأنّه مضى عليها أربعون عاماً

271
00:16:20,450 --> 00:16:22,710
ماذا؟ غيكو

272
00:16:23,180 --> 00:16:24,890
انتظري لحظة من فضلكِ

273
00:16:24,890 --> 00:16:28,180
قد يعرف زوجي عن هذا أكثر ممّا أعرف

274
00:16:30,440 --> 00:16:31,600
دعيني أرى

275
00:16:31,600 --> 00:16:32,380
تفضّلي

276
00:16:33,500 --> 00:16:35,430
هذه كومي-سان؟

277
00:16:35,740 --> 00:16:38,100
اسمك كومي-تشان، صحيح؟

278
00:16:38,840 --> 00:16:41,260
يوجد "أومي" في اسمي أيضاً

279
00:16:41,260 --> 00:16:42,740
أنا أوميكا

280
00:16:43,680 --> 00:16:45,260
أكره برقوق أومي

281
00:16:45,260 --> 00:16:46,270
لماذا؟

282
00:16:46,590 --> 00:16:50,820
عندما يتحوّل إلى أوميبوشي، يصبح
متجعّداً. إنّه غير ظريف

283
00:16:50,820 --> 00:16:54,220
...أنا آسف! مرّت بتجربة فظيعة، لذا

284
00:16:57,080 --> 00:17:00,120
كومي-تشان، هل سبقَ ورأيتِ أزهار البرقوق؟

285
00:17:00,120 --> 00:17:01,040
لا

286
00:17:01,410 --> 00:17:05,920
انظري. إنّها صغيرة وجميلة وظريفة أيضاً، صحيح؟

287
00:17:07,030 --> 00:17:09,210
...الأوميبوشي حامض

288
00:17:09,530 --> 00:17:12,970
لكنّه محفوظ، لذا يمكنكِ أكله بعد مئة عام من الآن

289
00:17:12,970 --> 00:17:14,130
!أليس هذا رائعاً؟

290
00:17:14,130 --> 00:17:17,090
ومعنى الزهور جميل أيضاً

291
00:17:17,640 --> 00:17:21,180
"تعني الحمراء "أناقة" والبيضاء "جمال مهيب

292
00:17:21,180 --> 00:17:23,820
"والورديّة الدّاكنة تعني "براءة

293
00:17:24,390 --> 00:17:27,150
حقّاً؟ كلّ هذه صور جميلة

294
00:17:27,150 --> 00:17:29,870
ناغومو-تشان، ماذا تعني "براءة"؟

295
00:17:29,870 --> 00:17:31,340
ماذا؟ ا-انتظري لحظة

296
00:17:31,820 --> 00:17:34,860
"هذا هو "جمال غير مُلطّخ

297
00:17:34,860 --> 00:17:35,860
غير مُلطّخ"؟"

298
00:17:35,860 --> 00:17:39,280
يعني أنّه شيء نظيف وجميل

299
00:17:39,280 --> 00:17:41,260
هكذا إذاً

300
00:17:43,200 --> 00:17:46,540
هل ينبغي أن نسأل النّاس في الحيّ
عن كومي-سان في الصّورة؟

301
00:17:46,540 --> 00:17:47,180
ماذا؟

302
00:17:47,180 --> 00:17:49,360
—يمكننا حتّى الاتّصال برابطة الحيّ و

303
00:17:49,360 --> 00:17:51,880
...شكراً لك، لكن

304
00:17:52,340 --> 00:17:54,950
...لعلّ جدّي كثير النّسيان، لكن

305
00:17:55,880 --> 00:17:58,460
جدّي في المشفى الآن

306
00:17:58,460 --> 00:18:00,760
،لكن عندما أحضرتُ له بعض الواغاشي الّتي يحبّها

307
00:18:00,760 --> 00:18:03,260
أشرقت تعابير وجهه الفارغة فجأة

308
00:18:04,100 --> 00:18:07,520
أوميكا، أودّ أن أطلب منكِ معروفاً

309
00:18:07,870 --> 00:18:10,630
يوجد محلّ واغاشي يدعى ريوكوشو

310
00:18:11,070 --> 00:18:13,180
...هناك شخص تُدعى كومي

311
00:18:13,980 --> 00:18:16,570
وقال بأنّه يريد أن يعيد هذا لها...

312
00:18:17,360 --> 00:18:18,880
يا له من صندوق خشب كيري جميل

313
00:18:18,880 --> 00:18:20,800
لكن لا أعرف ما بداخله

314
00:18:20,800 --> 00:18:21,910
...كومي

315
00:18:22,410 --> 00:18:24,200
!كومي سوف تبحث عن كومي-سان أيضاً

316
00:18:24,200 --> 00:18:25,500
أين ستبحثين؟

317
00:18:25,500 --> 00:18:27,360
!في أماكن مثل المعبد أو الحديقة

318
00:18:27,360 --> 00:18:28,510
...حـ-حسناً

319
00:18:29,250 --> 00:18:33,400
!إذا سألنا جدّتي، فقد تعرف
!أونيتشان، لنذهب معاً

320
00:18:33,400 --> 00:18:34,340
ماذا؟

321
00:18:35,460 --> 00:18:37,630
...أنا آسفة. هل كومي-تشان

322
00:18:37,630 --> 00:18:38,720
!جدّتي

323
00:18:39,380 --> 00:18:44,010
!جدّتي، هل تعرفين كومي-سان؟ قالوا بأنّها غيكو

324
00:18:44,010 --> 00:18:44,970
ماذا؟

325
00:18:44,970 --> 00:18:48,640
السيّدة هناك تبحث عنها. هل تعرفينها؟

326
00:18:49,210 --> 00:18:51,610
...كـ-كومي-سان هي

327
00:18:52,690 --> 00:18:57,320
قطعت كلّ المسافة إلى هنا. ألن
يكون من المناسب إخبارها؟

328
00:18:58,070 --> 00:18:59,520
ماسا-سان

329
00:18:59,520 --> 00:19:01,660
ولا حاجة لإخفاء الأمر

330
00:19:02,090 --> 00:19:04,090
أليس كذلك يا كومي-سان؟

331
00:19:04,910 --> 00:19:05,960
ماذا؟

332
00:19:37,190 --> 00:19:39,390
!حسناً، سأغادر الآن

333
00:19:39,390 --> 00:19:42,700
أريد أن أسرع وأخبر جدّي بأنّني
تمكّنتُ من إعادته لها

334
00:19:43,160 --> 00:19:45,550
المعذرة، هذه منّي

335
00:19:45,550 --> 00:19:46,220
ماذا؟

336
00:19:46,220 --> 00:19:48,080
!شكراً لكِ

337
00:19:48,630 --> 00:19:50,280
هل يمكنني فتحها؟

338
00:19:52,490 --> 00:19:54,380
...هذه

339
00:19:55,130 --> 00:19:56,560
!قُرمُز ملفوف

340
00:19:56,560 --> 00:19:59,110
!إنّها الواغاشي المُفضّلة لدى جدّي

341
00:20:00,030 --> 00:20:01,510
يسرّني هذا

342
00:20:03,650 --> 00:20:05,540
...أخبريني يا كومي

343
00:20:05,540 --> 00:20:10,150
حالما نكون معاً، هل نزرع شجرة
برقوق كبيرة في الحديقة؟

344
00:20:10,980 --> 00:20:14,170
...سأسمح لكما بالمواعدة. لكن

345
00:20:14,170 --> 00:20:16,700
إذا كنّا نتحدّث عن انضمامها لعائلتنا فتختلف المسألة

346
00:20:16,700 --> 00:20:17,390
!أمّي

347
00:20:17,390 --> 00:20:20,030
فكّر بمكانتك كوريث للعائلة

348
00:20:24,500 --> 00:20:25,590
!كومي

349
00:20:26,440 --> 00:20:28,200
!سامحني أرجوك

350
00:20:28,680 --> 00:20:31,330
!حتّى أنا لديّ كرامة

351
00:20:31,330 --> 00:20:32,500
!كومي

352
00:20:42,760 --> 00:20:47,260
عندما تهبّ الرّياح من الشّرق، دعيها"
"تحمل رائحتك إليّ يا أزهار البرقوق

353
00:20:47,970 --> 00:20:51,890
"ورغم أنّ ضيفك قد لا يكون هنا، لا تنسي الرّبيع"

354
00:20:53,140 --> 00:20:54,990
يا أزهار البرقوق

355
00:20:54,990 --> 00:21:00,250
عندما تهبّ الرّياح من الشّرق، أرسلي رائحتكِ إليّ

356
00:21:00,830 --> 00:21:04,970
ورغم أنّني قد لا أكون بجانبك، لا تنسي الرّبيع

357
00:21:05,480 --> 00:21:07,510
أليس كذلك يا كومي؟

358
00:21:11,060 --> 00:21:15,670
لديّ الكانجي الّذي يعني "برقوق" في
اسمَي كومي ويو من أمّي

359
00:21:15,670 --> 00:21:20,300
الطريق الّذي مهّدته أمّي لنفسها في
الفنّ هو الطريق الّذي لطالما أعجبتُ به

360
00:21:21,090 --> 00:21:24,920
لذا جعلتُ إعجابي يتجلّى في أسماء أطفالي

361
00:21:24,920 --> 00:21:26,970
!هذا رائع حقّاً

362
00:21:27,460 --> 00:21:28,730
حقّاً؟

363
00:21:29,560 --> 00:21:31,360
...جدّتي

364
00:21:31,360 --> 00:21:35,420
كنية كومي هي مومونوسي، صحيح؟
كأزهار البرقوق الورديّة، صحيح؟

365
00:21:35,420 --> 00:21:36,460
هذا صحيح

366
00:21:36,460 --> 00:21:40,340
"يُقال بأنّها تعني "براءة

367
00:21:41,340 --> 00:21:44,520
خدّاكِ ورديّتان كأزهار البرقوق

368
00:21:44,520 --> 00:21:46,900
سنمنحكِ اسم كومي

369
00:21:46,900 --> 00:21:50,600
يُقال بأنّ أزهار البرقوق الورديّة الدّاكنة
"يعني "براءة

370
00:21:50,600 --> 00:21:52,340
إنّه يلائمكِ كثيراً

371
00:21:54,500 --> 00:21:57,370
أزهار البرقوق الورديّة ظريفة، أليس كذلك؟

372
00:21:57,370 --> 00:21:59,540
...أجل! كومي

373
00:22:00,000 --> 00:22:02,090
!تحبّ اسمها

374
00:23:33,140 --> 00:23:35,470
لم أكن أعلم

375
00:23:35,470 --> 00:23:38,540
لم أكن أعلم بأنّ أوتسوروسان كانت غيكو

376
00:23:38,540 --> 00:23:40,300
حقّاً؟

377
00:23:40,300 --> 00:23:42,730
...ذلك الأنمي، باتي وبوري

378
00:23:42,730 --> 00:23:48,190
مكتوب هنا بأنّ في الأسبوع المقبل ستتغيّر المهارة
"من "هيفن بومبر" إلى "جحيم بومبر

379
00:23:48,190 --> 00:23:49,340
!جحيم؟

380
00:23:52,110 --> 00:23:56,030
قلتَ بأنّك عندما تنهمك في التّفكير
فإنّك تشتهي حلويّاتنا، صحيح؟

381
00:23:56,030 --> 00:23:57,370
هذا غريب

382
00:23:57,370 --> 00:23:58,660
لا تقل ذلك

383
00:24:00,750 --> 00:24:02,810
يعترض الأطفال طريقي

384
00:24:02,810 --> 00:24:04,800
...إنّهم مزعجون

385
00:24:04,800 --> 00:24:06,090
ولا ينفعون في شيء

386
00:24:06,090 --> 00:24:08,570
!الأمور جنونيّة في الخارج

387
00:24:08,570 --> 00:24:09,660
!اخرج وسترى