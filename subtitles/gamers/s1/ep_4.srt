1
00:01:43,640 --> 00:01:48,830
تبدأ تيندو كارين، تلميذة القسم "أ"-2
.من ثانويّة أوتوبوكي، يومها باكرًا جدًّا

2
00:01:57,100 --> 00:01:59,180
!إنّه صباح جميل آخر

3
00:01:59,960 --> 00:02:03,890
.تغادر المنزل للهرولة صباحًا بمجرّد استيقاظها

4
00:02:04,290 --> 00:02:08,600
.الصّباح هو وقتٌ لإغناء الذّات بالنّسبة لتيندو كارين

5
00:02:08,600 --> 00:02:09,540
!صباح الخير

6
00:02:09,540 --> 00:02:10,910
!صباح الخير لك أيضًا

7
00:02:10,910 --> 00:02:12,500
.أنت جميلة كعادتك

8
00:02:12,500 --> 00:02:13,860
.شكرًا جزيلاً لك

9
00:02:14,680 --> 00:02:21,740
وهكذا أبدأ أنا تيندو كارين، يومي
.الرّائع باستفاقة لطيفة

10
00:02:16,010 --> 00:02:17,280
!جرو لطيف

11
00:02:22,500 --> 00:02:25,890
.بعد تمريني الصّباحيّ، أنتقل لدراستي الصّباحيّة المبكّرة

12
00:02:26,410 --> 00:02:30,440
توفّر طمأنينة الصّباح الجوّ الأنسب

13
00:02:30,440 --> 00:02:32,460
.للدّراسة للتّلاميذ المشغولين

14
00:02:33,330 --> 00:02:37,160
أتناول فطوري وأحضّر نفسي
.بسرعة لأغادر للمدرسة

15
00:02:38,050 --> 00:02:43,340
ما لا يعرفه النّاس هو أنّي لا أبذل
.مجهودًا كبيرًا بشأن مظهري

16
00:02:43,340 --> 00:02:48,770
.أؤمن أنّ ما يهمّ حقًّا هو ما يصدر من الدّاخل

17
00:02:48,770 --> 00:02:49,640
!جيّد

18
00:02:58,210 --> 00:03:02,350
أجتمع مع صديقاتي في المدرسة
.بمجرّد وصولي لها

19
00:03:02,920 --> 00:03:04,370
!صباح الخير يا كارين

20
00:03:04,370 --> 00:03:07,540
!صباح الخير

21
00:03:08,380 --> 00:03:13,540
مبدئي هو أن ألتزم بالكامل بما يمكن
.القيام به في ذات اللّحظة والمكان فقط

22
00:03:14,620 --> 00:03:17,990
إلى جانب قضاء الوقت مع صديقاتي في
...المدرسة خلال فترة الغداء

23
00:03:17,990 --> 00:03:18,840
!أستاذ

24
00:03:18,840 --> 00:03:20,010
.سأساعدك في حمل ذلك

25
00:03:20,340 --> 00:03:22,810
.أتطوّع لمساعدة الأساتذة

26
00:03:22,810 --> 00:03:24,970
.شكرًا كالعادة يا تيندو-كُن

27
00:03:25,340 --> 00:03:27,260
،لا أفعل ذلك لأحصل على نقاط إضافيّة

28
00:03:27,260 --> 00:03:30,740
بل لأنّي أقدّر التّجربة المميّزة
.الّتي يمكنني اكتسابها من ذلك

29
00:03:31,650 --> 00:03:35,440
وبعدها يحين وقت ما أعتبره الجزء الأكثر كآبة

30
00:03:36,300 --> 00:03:37,260
.من يومي

31
00:03:38,650 --> 00:03:40,440
.واعديني أرجوك

32
00:03:40,440 --> 00:03:45,320
أؤمن أنّه من واجبي أن أواجه
،طلب الشّخص مباشرة

33
00:03:45,320 --> 00:03:47,300
.وأرفض بكلّ صراحة

34
00:03:47,300 --> 00:03:48,870
.أنا آسفة

35
00:03:49,800 --> 00:03:55,080
ومع ذلك، يترك رفض طيبة شخص
.آخر شعورًا لاذعًا في قلبي

36
00:03:57,240 --> 00:04:01,880
،أتّجه بعد المدرسة إلى نادي الألعاب
.الّذي أنا عضوة فيه بشكلٍ سرّي

37
00:04:02,290 --> 00:04:07,370
.يجتمع الأعضاء هناك لصقل مهاراتهم في اللّعب

38
00:04:07,870 --> 00:04:11,990
أنا أحبّ وبكلّ تأكيد الجوّ المشدود
الّذي يحين فقط عندما

39
00:04:11,990 --> 00:04:14,070
.يأخذ الجميع عمله على محمل الجدّ

40
00:04:15,610 --> 00:04:18,500
،عندما أعود للمنزل، أراجع دروسي وأحضّر لها

41
00:04:18,500 --> 00:04:22,680
ثمّ ألعب قليلاً لأرتاح إلى جانب
،جمع المعلومات أيضًا

42
00:04:22,680 --> 00:04:26,070
.ثمّ أنام باكرًا استعداد لليوم التّالي

43
00:04:26,610 --> 00:04:27,740
.ليلة هانئة

44
00:04:29,230 --> 00:04:35,250
وهكذا ينتهي يوم رائع آخر خالٍ
.من الخطأ في حياة تيندو كارين

45
00:04:45,990 --> 00:04:50,430
تبدأ تيندو كارين، تلميذة القسم "أ"-2
.من ثانويّة أوتوبوكي، يومها باكرًا جدًّا

46
00:04:53,040 --> 00:04:57,000
لـ-لماذا يراودني حلم عن أمانو-كُن؟

47
00:04:57,000 --> 00:04:59,820
!بل وحلم مخزٍ أيضًا؟

48
00:05:06,930 --> 00:05:08,450
!لم أنجز واجبي المنزليّ بعد

49
00:05:08,890 --> 00:05:12,830
توفّر طمأنينة الصّباح الجوّ الأنسب

50
00:05:12,830 --> 00:05:14,820
.للدّراسة للتّلاميذ المشغولين

51
00:05:14,820 --> 00:05:17,830
!ما الّذي أفعله؟

52
00:05:17,830 --> 00:05:19,170
...أتناول فطوري

53
00:05:19,170 --> 00:05:20,630
.شكرًا على الطّعام

54
00:05:20,630 --> 00:05:23,710
.وأحضّر نفسي بسرعة لأغادر للمدرسة

55
00:05:23,710 --> 00:05:28,570
ما لا يعرفه النّاس هو أنّي لا أبذل
.مجهودًا كبيرًا بشأن مظهري

56
00:05:28,570 --> 00:05:32,640
.أؤمن أنّ ما يهمّ حقًّا هو ما يصدر من الدّاخل

57
00:05:28,840 --> 00:05:30,340
ما هذا؟

58
00:05:30,340 --> 00:05:32,640
!لا تتسرّح غرّتي كما يجب

59
00:05:33,720 --> 00:05:35,250
!لقد تأخرّت

60
00:05:35,250 --> 00:05:37,730
كارين، هل تنوين الذّهاب للمدرسة
وأنت ترتدين ذلك؟

61
00:05:39,470 --> 00:05:44,030
أجتمع مع صديقاتي في المدرسة
.بمجرّد وصولي لها

62
00:05:46,420 --> 00:05:47,700
كا-كارين؟

63
00:05:48,200 --> 00:05:49,660
.صـ-صباح الخير

64
00:05:49,970 --> 00:05:51,680
...مبدئي هو أن ألتزم بالكامل

65
00:05:52,450 --> 00:05:53,500
!كلاّ

66
00:05:53,500 --> 00:05:55,220
كارين، هل أنت بخير؟

67
00:05:56,020 --> 00:05:57,410
.بأحسن حال

68
00:05:59,920 --> 00:06:05,420
بما يمكن القيام به في ذات
.اللّحظة والمكان فقط

69
00:06:05,800 --> 00:06:08,930
إلى جانب قضاء الوقت مع صديقاتي
...في المدرسة خلال فترة الغداء

70
00:06:06,180 --> 00:06:07,990
ماذا؟ أين كارين؟

71
00:06:07,990 --> 00:06:08,930
.لا أدري

72
00:06:08,930 --> 00:06:10,430
...تيندو-كُن

73
00:06:08,930 --> 00:06:11,220
.أتطوّع لمساعدة الأساتذة

74
00:06:10,430 --> 00:06:12,850
،أنا سعيد لأنّك تقدّمين المساعدة

75
00:06:12,850 --> 00:06:15,390
.لكنّ ذلك يجب أن يذهب لفصل الكيمياء

76
00:06:14,430 --> 00:06:15,570
!أعلم

77
00:06:15,570 --> 00:06:16,680
!دع الأمر لي

78
00:06:16,680 --> 00:06:19,730
.كلاّ، بل أنت ذاهبة في الاتّجاه المعاكس

79
00:06:18,940 --> 00:06:21,050
!لا تقلق، سأوصلها إلى هناك

80
00:06:21,050 --> 00:06:22,290
."إلى الفصل "و

81
00:06:22,820 --> 00:06:23,820
لماذا الفصل "و"؟

82
00:06:23,820 --> 00:06:25,870
،لا أفعل ذلك لأحصل على نقاط إضافيّة

83
00:06:25,870 --> 00:06:29,560
بل لأنّي أقدّر التّجربة المميّزة
.الّتي يمكنني اكتسابها من ذلك

84
00:06:33,530 --> 00:06:35,020
أليس هنا؟

85
00:06:35,020 --> 00:06:37,870
.يفترض أنّه يلعب الآن بمفرده

86
00:06:37,870 --> 00:06:40,080
ماذا؟ تيندو-سان؟

87
00:06:40,080 --> 00:06:42,840
ما الّذي تفعلينه هنا؟

88
00:06:44,680 --> 00:06:49,180
وبعدها يحين وقت ما أعتبره الجزء
.الأكثر كآبة في يومي

89
00:06:45,170 --> 00:06:46,710
!لِمَ لا؟

90
00:06:46,710 --> 00:06:49,160
أولستُ جيّدًا كفاية لك؟

91
00:06:49,160 --> 00:06:51,750
.كلاّ، الأمر ليس كذلك

92
00:06:51,750 --> 00:06:55,150
...أنا لا أعرفك كثيرًا، إضافة إلى أنّي

93
00:06:55,150 --> 00:06:56,720
هل هنالك شخص تحبينه؟

94
00:06:58,150 --> 00:06:59,810
...كـ-كلاّ

95
00:07:00,590 --> 00:07:02,780
شخص أحبّه؟

96
00:07:02,780 --> 00:07:04,760
.هذا غباء. بالطّبع لا يوجد

97
00:07:04,760 --> 00:07:07,290
!لا نيّة لي بمواعدة أيّ أحد

98
00:07:07,910 --> 00:07:09,290
...المواعدة

99
00:07:09,820 --> 00:07:13,860
.كلاّ، أنا لا أتخيّل مواعدة أحد ما أو ما شابه

100
00:07:13,860 --> 00:07:14,800
...المعذرة

101
00:07:14,800 --> 00:07:16,770
ماذا عن اعترافي؟

102
00:07:16,770 --> 00:07:18,060
.ذلك غير وارد بالمرّة

103
00:07:18,060 --> 00:07:18,750
.مستحيل

104
00:07:18,750 --> 00:07:19,770
!يا لفظاعتك

105
00:07:19,770 --> 00:07:21,000
!مهلاً! أعني... أنا آسفة

106
00:07:22,580 --> 00:07:25,840
كلاّ، كيف حدث هذا؟

107
00:07:26,440 --> 00:07:31,340
،أتّجه بعد المدرسة إلى نادي الألعاب
.الّذي أنا عضوة فيه بشكلٍ سرّي

108
00:07:31,780 --> 00:07:36,900
.يجتمع الأعضاء هناك لصقل مهاراتهم في اللّعب

109
00:07:36,900 --> 00:07:37,860
!تيندو

110
00:07:36,900 --> 00:07:40,930
أنا أحبّ وبكلّ تأكيد الجوّ المشدود الّذي
...يحين فقط عندما يأخذ الجميع

111
00:07:39,340 --> 00:07:40,930
!يا تيندو

112
00:07:41,530 --> 00:07:43,190
.آسفة

113
00:07:44,430 --> 00:07:47,050
.تبدين شاردة كثيرًا مؤخّرًا

114
00:07:47,050 --> 00:07:48,140
ما الخطب؟

115
00:07:48,140 --> 00:07:50,100
...لا أدري

116
00:07:50,100 --> 00:07:51,720
.هنالك أمور تشغل بالي فحسب

117
00:07:51,720 --> 00:07:54,850
.يشرد بالي في أفكار عشوائيّة بالكامل

118
00:07:55,690 --> 00:07:56,550
مثل ماذا؟

119
00:07:57,250 --> 00:07:58,450
...صحيح

120
00:07:58,450 --> 00:08:02,080
مثل أوّل مرّة تحدّثت فيها مع
.أمانو-كُن في متجر الألعاب

121
00:08:02,080 --> 00:08:04,830
أو الوقت الّذي أقنعت فيه أمانو-كُن
.بالمجيء إلى نادي الألعاب معي

122
00:08:04,830 --> 00:08:06,460
.والوقت الّذي رفضني فيه

123
00:08:06,460 --> 00:08:09,090
."وحينما كان وحده ثانية اليوم في الفصل "و

124
00:08:09,090 --> 00:08:12,470
.وعن رأيه الممتاز عن نادي الألعاب

125
00:08:12,470 --> 00:08:15,590
.لا أنفكّ عن التّفكير بهذا مرارًا وتكرارًا

126
00:08:19,470 --> 00:08:22,560
.تيندو، لقد بدأت تفقدين رجاحتك مؤخّرًا

127
00:08:23,720 --> 00:08:25,730
.لم تعودي بنفس البراعة كما في السّابق

128
00:08:25,730 --> 00:08:27,300
!مـ-مستحيل

129
00:08:27,300 --> 00:08:29,180
.أنت رئيسة النّادي في نهاية المطاف

130
00:08:29,180 --> 00:08:30,530
.ابذلي جهدك في اللعب

131
00:08:31,130 --> 00:08:32,130
.هذا صحيح

132
00:08:32,130 --> 00:08:35,300
.أنا تيندو كارين، رئيسة نادي الألعاب

133
00:08:35,300 --> 00:08:38,530
.عليّ التّوقّف عن تشتيت انتباهي والتّركيز على اللّعب

134
00:08:42,510 --> 00:08:46,250
.أتمنّى أن يأتي أمانو-كُن إلى نادي الألعاب غدًا

135
00:08:46,250 --> 00:08:49,040
مهلاً، لماذا قد أهتمّ لأمانو-كُن؟

136
00:08:49,040 --> 00:08:55,020
لـ-ليس الأمر وكأنّنا بحاجة لمهاراته
.في نادي الألعاب

137
00:08:55,500 --> 00:08:58,260
!وليس وكأنّي أريده أن يأتي

138
00:08:58,840 --> 00:09:03,720
لـ-لكن أعتقد أنّي لن أمانع بالتّرحيب
.به إن طلب الانضمام لنا

139
00:09:04,630 --> 00:09:10,280
ثمّ سأشرح له كيف تسير الأمور
...وأعلّمه كيف يلعب

140
00:09:13,010 --> 00:09:20,990
وهكذا ينتهي يوم رائع آخر ومختلف
.قليلاً في حياة تيندو كارين

141
00:09:40,450 --> 00:09:41,890
!جيّد! نلت منك

142
00:09:41,890 --> 00:09:43,460
.لست سيّئة

143
00:09:44,300 --> 00:09:46,750
بالمناسبة، هل سمعتِ أيّ شيء مذّاك الحين؟

144
00:09:46,750 --> 00:09:47,560
بشأن ماذا؟

145
00:09:47,560 --> 00:09:50,780
.بشأن علاقة هوشينوموري-سان بأمانو-كُن

146
00:09:53,440 --> 00:09:54,030
ماذا؟

147
00:09:54,030 --> 00:09:55,910
—ما الخطب يا تيندو-سا

148
00:09:55,910 --> 00:09:57,030
!تيندو-سان؟

149
00:10:02,250 --> 00:10:05,540
.لقد نزل مستواي في اللّعب بالفعل

150
00:10:11,810 --> 00:10:13,330
.أبدو باهتة

151
00:10:18,760 --> 00:10:21,160
.واضح تمامًا لماذا قلّ مستواي

152
00:10:22,140 --> 00:10:24,630
.نعم، أعرف السّبب

153
00:10:24,630 --> 00:10:25,670
،منذ ذلك اليوم

154
00:10:25,670 --> 00:10:30,170
منذ أن قال أنّ الاستمتاع هو أهمّ
،جانب من اللّعب

155
00:10:30,170 --> 00:10:34,800
.بدأ يظهر تردّد في أسلوب لعبي الرّزين

156
00:10:34,800 --> 00:10:38,780
.بالفعل. من الأفضل أن يتحمّل مسؤوليّة هذا

157
00:10:39,490 --> 00:10:42,170
!"مهلاً، ذلك ليس ما قصدتُه بـ"المسؤوليّة

158
00:10:42,170 --> 00:10:44,130
!الأمر ليس كذلك

159
00:10:44,130 --> 00:10:45,450
!تيندو-سان

160
00:10:47,540 --> 00:10:48,330
أمانو-كُن؟

161
00:10:48,330 --> 00:10:49,640
.نعم

162
00:10:49,640 --> 00:10:51,240
...أنا

163
00:10:51,240 --> 00:10:52,120
...عفوًا

164
00:10:52,620 --> 00:10:53,840
.مرحبًا

165
00:10:56,740 --> 00:10:57,840
".أحم"

166
00:10:59,490 --> 00:11:01,470
.يا لها من مصادفة يا أمانو-كُن

167
00:11:01,470 --> 00:11:02,550
هل خرجت للتّبضّع؟

168
00:11:02,550 --> 00:11:03,590
!أحسنت

169
00:11:03,590 --> 00:11:05,430
.هذه هي تيندو كارين الّتي أعرفها

170
00:11:05,950 --> 00:11:07,530
...أنا

171
00:11:07,530 --> 00:11:10,640
.كنتُ ألعب طوال اليوم وصرخت أمّي عليّ

172
00:11:10,640 --> 00:11:12,710
.لذلك أنا في الخارج الآن

173
00:11:12,710 --> 00:11:14,770
.هـ-هذا سبب قاسٍ لمغادرة المنزل

174
00:11:17,590 --> 00:11:20,110
في تلك الحالة، لماذا لا تأتي لتتمشّى معي؟

175
00:11:20,110 --> 00:11:21,620
...نعم، بالتّأكيد

176
00:11:21,620 --> 00:11:22,680
ماذا؟

177
00:11:22,680 --> 00:11:25,570
!مستحيل! لا يمكن أن أرافقك في نهاية الأسبوع

178
00:11:25,570 --> 00:11:28,760
...لستُ جديرًا بذلك! أعني أنّي

179
00:11:28,000 --> 00:11:29,490
لستَ جديرًا؟

180
00:11:28,760 --> 00:11:30,960
.أعني أنّ ذلك لن يكون محبّبًا

181
00:11:30,960 --> 00:11:32,920
.سوف يرفضني ثانية

182
00:11:34,750 --> 00:11:37,380
.لكن ليس في هذه المرّة

183
00:11:38,840 --> 00:11:39,850
لِمَ لا؟

184
00:11:39,850 --> 00:11:42,260
هل تكرهني يا أمانو-كُن؟

185
00:11:43,250 --> 00:11:45,140
.بـ-بالطّبع لا

186
00:11:48,840 --> 00:11:54,130
أعني أنّي ما كنتُ لأريد إزعاجك
.بالمزيد من الإشاعات

187
00:11:54,130 --> 00:11:55,990
...تذكّرت

188
00:11:57,110 --> 00:11:58,460
تيندو-سان؟

189
00:11:58,460 --> 00:11:59,320
ما الخطب؟

190
00:11:59,700 --> 00:12:01,780
.لا شيء... لا شيء أبدًا

191
00:12:01,780 --> 00:12:03,280
.لا شيء بالفعل

192
00:12:04,220 --> 00:12:05,480
هكذا إذًا؟

193
00:12:06,570 --> 00:12:10,360
.حسنًا إذًا، سوف أغادر الآن

194
00:12:11,290 --> 00:12:12,040
!مـ-مهلاً

195
00:12:12,040 --> 00:12:12,750
!انتظر

196
00:12:15,110 --> 00:12:16,540
ما-ماذا هنالك؟

197
00:12:16,540 --> 00:12:19,800
.لقد... عرضت عليك التّمشّي معًا فحسب

198
00:12:19,800 --> 00:12:21,500
.الأمر ليس وكأنّنا سنخرج في موعد

199
00:12:21,500 --> 00:12:24,090
.لذلك تحلّ ببعض الشّجاعة

200
00:12:24,510 --> 00:12:27,300
...أنا لا أعتقد أنّ ذلك هو المهمّ

201
00:12:27,300 --> 00:12:29,550
.تعال معي فقط يا أمانو-كُن

202
00:12:29,550 --> 00:12:31,810
مهلاً، إلى أين أنت ذاهبة؟

203
00:12:32,810 --> 00:12:33,880
.فهمت

204
00:12:33,880 --> 00:12:35,960
ماذا؟ هل لديك مشكلة؟

205
00:12:35,960 --> 00:12:39,320
أخبرتك أنّنا سنتمشّى فحسب
وأنّه ليس موعدًا، صحيح؟

206
00:12:39,320 --> 00:12:43,260
نعم، وزيادة على ذلك، لماذا نحن
في متجر ألعاب فجأة؟

207
00:12:45,100 --> 00:12:47,240
!لقد كنتُ مهتمًّا بهذه

208
00:12:47,720 --> 00:12:48,200
.وهذه أيضًا

209
00:12:48,650 --> 00:12:50,710
أيّها عليّ أن أختار؟

210
00:12:49,660 --> 00:12:52,040
.أنت تمرح أكثر منّي منذ الآن

211
00:12:58,230 --> 00:12:59,290
هل من خطب ما؟

212
00:13:01,800 --> 00:13:04,950
أنت تحبّ بالفعل "الذّكريات الذّهبيّة" إذًا؟

213
00:13:04,950 --> 00:13:07,050
!لا، الأمر ليس كذلك

214
00:13:07,050 --> 00:13:10,310
.كان عليها تخفيض ولم أستطع منع نفسي

215
00:13:10,310 --> 00:13:12,060
.لا بأس يا أمانو-كُن

216
00:13:12,060 --> 00:13:13,300
.أنت ولد

217
00:13:13,300 --> 00:13:17,050
لا تقولي هذا رجاءً وكأنّك أمٌّ وجدت
.كُتب ولدها السّرّيّة للتّوّ

218
00:13:17,050 --> 00:13:18,460
!لن أشتري اللّعبة

219
00:13:18,460 --> 00:13:20,330
لن تشتريها؟

220
00:13:20,330 --> 00:13:22,320
لماذا تبدين حزينة فجأة؟

221
00:13:23,480 --> 00:13:24,980
.لقد اشتريتَها في نهاية المطاف

222
00:13:27,380 --> 00:13:28,380
...أخبريني

223
00:13:28,380 --> 00:13:30,280
هذه مجرّد تمشية، صحيح؟

224
00:13:30,280 --> 00:13:34,890
المحطّة التّالية للاعبين خلال تمشية
.هي صالة الألعاب بالطّبع

225
00:13:34,890 --> 00:13:35,830
...نعم

226
00:13:35,830 --> 00:13:37,460
".تمشية"

227
00:13:37,870 --> 00:13:41,230
.في الحقيقة، لم أعرف أبدًا أنّك تذهبين لصالات الألعاب

228
00:13:41,730 --> 00:13:45,090
.أعتقد أنّي أذهب عندما لا يلتقي أعضاء النّادي

229
00:13:45,090 --> 00:13:45,840
ماذا عنك؟

230
00:13:46,790 --> 00:13:51,350
ظننتُي لم أحبّها، لكن تسنّت لي الفرصة
،للذّهاب مع أحدهم مؤخّرًا

231
00:13:51,830 --> 00:13:54,600
.وأدركت أنّ ألعاب صالة الألعاب ممتعة أيضًا

232
00:13:57,650 --> 00:14:00,340
...عندما قلتَ أنّك تذهب مع أحدهم

233
00:14:00,340 --> 00:14:02,020
.لقد وصلنا يا تيندو-سان

234
00:14:03,620 --> 00:14:04,970
!صحيح

235
00:14:04,970 --> 00:14:06,280
!ستفي هذه بالغرض! أجل

236
00:14:06,940 --> 00:14:08,980
إنّه يقصد أويهارا-كُن بكلامه، صحيح؟

237
00:14:08,980 --> 00:14:11,870
.وليس هوشينوموري-سان بالتّأكيد

238
00:14:13,740 --> 00:14:15,190
هل من خطب ما؟

239
00:14:15,190 --> 00:14:15,980
...لا

240
00:14:15,980 --> 00:14:18,010
فكرة ذهابك إلى صالة ألعاب مع فتاة

241
00:14:18,010 --> 00:14:20,980
.جعلتني أفكّر أنّك شخص مخزٍ فجأة
.لقد خاب ظنّي

242
00:14:20,980 --> 00:14:22,880
!رغم أنّك أنت من دعاني؟

243
00:14:23,610 --> 00:14:25,630
.لقد خدعتك بالكامل لتختاري الخيار السّيّئ

244
00:14:25,630 --> 00:14:27,400
.حسنًا، لندخل

245
00:14:27,400 --> 00:14:28,450
.هيّا، هيّا

246
00:14:30,430 --> 00:14:32,530
أعتقد أنّي قد أجد طريقة

247
00:14:32,530 --> 00:14:35,910
للخروج من فترة ركودي هذه
.إن تمكّنت من اللّعب معه هنا

248
00:14:40,870 --> 00:14:41,970
ما الخطب؟

249
00:14:41,970 --> 00:14:43,230
.لا شيء

250
00:14:43,860 --> 00:14:47,150
لقد تفاجأت فقط لمعرفتي أنّك من النّوع

251
00:14:47,150 --> 00:14:48,610
.الّذي قد يصبح تنافسيًّا في ألعاب الرّفع

252
00:14:48,610 --> 00:14:52,240
هذا صحيح، لستُ مهتمّة بالفعل
...بمثل هذه الأشياء

253
00:14:52,240 --> 00:14:54,870
...مهلاً، هل ما زال يتحدّث عن

254
00:14:58,870 --> 00:14:59,740
!إنّه قلب

255
00:14:59,740 --> 00:15:00,870
!أجل

256
00:15:06,590 --> 00:15:09,400
هل تريدين تجربة ألعاب عُملات يا تيندو-سان؟

257
00:15:10,130 --> 00:15:12,900
.انظري، إنّه يوم الحصول على ثلاثة أضعاف الميداليّات

258
00:15:12,900 --> 00:15:14,370
يا لحظّنا، صحيح؟

259
00:15:14,940 --> 00:15:15,560
.نعم

260
00:15:15,560 --> 00:15:19,200
لماذا لا نبدأ بخمسمائة ينّ إذًا؟

261
00:15:19,200 --> 00:15:20,050
...مهلاً

262
00:15:24,590 --> 00:15:25,570
تيندو-سان؟

263
00:15:26,350 --> 00:15:31,780
تبدين وكأنّ فردًا من فريقك قد أضاع
.نقاطه السّحريّة على سحر بلا فائدة

264
00:15:31,780 --> 00:15:37,240
لماذا لا تستطيع استعمال مواهبك
!في الملاحظة باكرًا؟

265
00:15:37,930 --> 00:15:42,490
،كنتُ سألعب معك في ألعاب الصّالة
.لكن انس ذلك

266
00:15:42,490 --> 00:15:43,120
.حسنًا

267
00:15:43,510 --> 00:15:45,150
.هذا تحدٍّ يا أمانو-كُن

268
00:15:45,700 --> 00:15:49,000
،لم أكن أنوي على هذا
.لكن لم تترك لي خيارًا آخرًا

269
00:15:49,660 --> 00:15:52,140
.ليس علينا لعب هذه إن لم تريدي ذلك

270
00:15:52,140 --> 00:15:52,930
!أمانو-كُن

271
00:15:52,930 --> 00:15:53,490
!نعم؟

272
00:15:53,900 --> 00:15:56,920
.قمت بخيار موفّق

273
00:15:56,920 --> 00:15:59,360
.طبعًا ألعاب العُملات تعتمد على الحظّ غالبًا

274
00:15:59,360 --> 00:16:01,700
.يمكننا أن نحظى بمعركة عادلة وجادّة

275
00:16:01,700 --> 00:16:05,170
...أنت تحبطين فجأة مهاراتي في اللّعب

276
00:16:05,170 --> 00:16:09,780
!هذه معركة حياتي... من أجل نهضتي ثانية

277
00:16:09,780 --> 00:16:12,530
!سوف أهزمك وأسترجع ما خسرتُه

278
00:16:12,530 --> 00:16:14,250
!أنت متحمّسة كثيرًا

279
00:16:14,250 --> 00:16:17,070
ألسنا سنلعب ألعاب عُملات فحسب؟

280
00:16:17,070 --> 00:16:19,410
...أ-أعلم، ولكن

281
00:16:19,410 --> 00:16:22,540
لن تُعجب بك الفتيات إن واصلتَ التّدقيق
!على التّفاصيل الصّغيرة

282
00:16:22,540 --> 00:16:26,540
هل أتخيّل أنّي أفقد نقاط الشّخصيّة
اليوم بشكل غير عادل أم ماذا؟

283
00:16:26,900 --> 00:16:28,510
!هذا تحدٍّ على أيّ حال

284
00:16:28,510 --> 00:16:31,190
.سنلتقي هنا بعد ثلاثين دقيقة

285
00:16:31,190 --> 00:16:32,690
.حا-حاضر

286
00:16:32,690 --> 00:16:35,390
!فلتبدأ اللّعبة إذًا

287
00:16:35,390 --> 00:16:39,180
سأفوز في مواجهة أمانو-كُن
.وأتجاوز فترة ركودي هذه

288
00:16:41,810 --> 00:16:45,270
.لعبة الدّافع هي الأكثر ألفة

289
00:16:45,270 --> 00:16:47,850
.لكنّ كلّ المقاعد المعروفة محجوزة بالطّبع

290
00:16:47,850 --> 00:16:51,530
كما أنّها ليست جيّدة لإحراز نقاط
.كثيرة في وقت قصير

291
00:16:53,490 --> 00:16:55,680
إنّه في المقعد صاحب أقلّ معدّل؟

292
00:16:55,680 --> 00:16:57,300
هل لديه خطّة من نوع ما؟

293
00:16:58,070 --> 00:16:59,620
.هكذا تعمل إذًا

294
00:17:00,210 --> 00:17:01,870
!يا له من مبتدئ

295
00:17:02,550 --> 00:17:06,150
،لقد شتّت ذلك انتباهي نوعًا ما
.لكنّي لن أدع دفاعاتي مفتوحة

296
00:17:06,150 --> 00:17:09,880
!وسأضع حدًّا لوضعي المحبط مع أمانو-كُن

297
00:17:12,630 --> 00:17:17,190
.كنتُ آمل أن أبلي بلاءً حسنًا بما أنّها لعبة عُملات

298
00:17:17,190 --> 00:17:19,960
.لكنّ ذلك كان ممتعًا

299
00:17:19,100 --> 00:17:23,740
لماذا أشعر بعدم الرّضا رغم فوزي؟

300
00:17:43,010 --> 00:17:46,070
تيندو-سان، هل يمكنني الحصول
على هذه العُملة؟

301
00:17:46,710 --> 00:17:48,750
.بالطّبع

302
00:17:49,060 --> 00:17:50,750
.شكرًا لك

303
00:17:52,110 --> 00:17:53,090
أمانو-كُن؟

304
00:17:53,090 --> 00:17:57,630
،أريد أن أستفيد تمامًا من عُملتك
.لذلك سأراهن بتحدّينا على هذه

305
00:18:00,060 --> 00:18:01,050
تحدّينا؟

306
00:18:02,050 --> 00:18:05,180
.تحدّي ألعاب العُملات بالطّبع

307
00:18:11,750 --> 00:18:13,690
.والآن، ستُفتح البوّابات

308
00:18:14,020 --> 00:18:15,320
لـ-لماذا؟

309
00:18:15,320 --> 00:18:17,410
.لأنّه تحدٍّ بالطّبع

310
00:18:18,950 --> 00:18:21,830
.لكنّك لست من ذلك النّوع

311
00:18:22,160 --> 00:18:24,200
أيّ نوع تقصدين؟

312
00:18:24,580 --> 00:18:26,450
.ظننتُ أنّك لست مهتمًّا بالفوز

313
00:18:29,020 --> 00:18:32,340
!إن كان تحدّيًا، فعلينا الفوز وإلاّ لن يكون ممتعًا

314
00:18:35,160 --> 00:18:38,090
.يقوم المتقدّم بالاستدارة الأخيرة
!هذا هو الإسراع الأخير

315
00:18:38,090 --> 00:18:39,550
!أجل! انطلق

316
00:18:40,680 --> 00:18:43,330
!سوغينامي تيو في المقدّمة

317
00:18:44,220 --> 00:18:47,480
احتلّ سوغينامي تيو المركز الأوّل
.متبوعًا بأوجي هوجيكي

318
00:18:48,970 --> 00:18:50,010
.هذا مؤسف

319
00:18:52,130 --> 00:18:53,260
تيندو-سان؟

320
00:18:55,020 --> 00:19:01,110
لقد رفضت الانضمام لنادي الألعاب لأنّك
لا تحبّ طريقة اللّعب بغرض الفوز، صحيح؟

321
00:19:01,460 --> 00:19:04,240
.نعم، بشكل مبسّط

322
00:19:04,240 --> 00:19:07,740
.لكنّك بدوتَ حزينًا عندما خسرتَ قبل قليل

323
00:19:07,740 --> 00:19:11,620
.في الحقيقة، حاولتَ الفوز حتّى آخر عُملة

324
00:19:12,280 --> 00:19:13,250
هذا محيّر، ألا ترى ذلك؟

325
00:19:14,110 --> 00:19:15,500
أهو كذلك بالفعل؟

326
00:19:15,500 --> 00:19:18,690
.حسنًا، ظننتُ أنّك اهتممت أكثر بالاستمتاع

327
00:19:18,690 --> 00:19:20,940
لذلك لا تهتمّ بالفوز، صحيح؟

328
00:19:20,940 --> 00:19:23,650
.كلاّ، بالطّبع أهتمّ

329
00:19:23,650 --> 00:19:24,640
.أريد الفوز

330
00:19:25,880 --> 00:19:27,640
.هذا ليس منطقيًّا

331
00:19:27,640 --> 00:19:31,090
...الاستمتاع باللّعب والرّغبة في الفوز

332
00:19:31,090 --> 00:19:33,400
هي نفس الشّيء تقريبًا، صحيح؟

333
00:19:33,740 --> 00:19:37,690
،أعني أنّه إن لم نهتمّ في الحقيقة بالفوز

334
00:19:37,690 --> 00:19:40,320
فهل سيكون هنالك أيّ متعة من اللّعب؟

335
00:19:45,630 --> 00:19:46,620
.مقرف

336
00:19:53,180 --> 00:19:54,650
!انظري يا تيندو-سان

337
00:19:54,650 --> 00:19:55,850
!لقد فزت

338
00:19:55,850 --> 00:19:57,050
!أجل

339
00:19:57,580 --> 00:19:59,400
!أجل! أنا محظوظ

340
00:20:02,440 --> 00:20:03,510
.تفضّلي

341
00:20:04,740 --> 00:20:06,010
.لقد فزتُ بها

342
00:20:08,280 --> 00:20:09,100
.شكرًا لك

343
00:20:10,110 --> 00:20:14,520
نعيش أوقاتًا جيّدة وأخرى سيّئة، ونحمّل
.الأمر أكثر ممّا هو عليه في كلتا الحالتين

344
00:20:14,520 --> 00:20:17,400
.لهذا السّبب الألعاب ممتعة بالنّسبة لي

345
00:20:19,420 --> 00:20:21,870
إذًا لماذا رفضت الانضمام لنادي الألعاب؟

346
00:20:22,310 --> 00:20:26,730
الأمر ببساطة لأنّي لا أملك المقدرة
.المطلوبة للفوز

347
00:20:27,370 --> 00:20:28,280
.فهمت

348
00:20:29,550 --> 00:20:34,430
أخبرني يا أمانو-كُن، أنا أتحمّس كثيرًا بشأن
.الفوز والخسارة في الألعاب

349
00:20:35,080 --> 00:20:36,650
.وكذلك نادي الألعاب

350
00:20:36,650 --> 00:20:38,880
هل نحن سخيفون؟

351
00:20:38,880 --> 00:20:40,230
عمّاذا تتحدّثين؟

352
00:20:40,230 --> 00:20:42,130
.لا يبدو هذا من شيمك

353
00:20:43,450 --> 00:20:46,430
الاستمتاع بالفوز والانزعاج بسبب الخسارة

354
00:20:48,110 --> 00:20:50,430
.هو أكثر متعة في اللّعب

355
00:20:53,940 --> 00:20:55,990
لذلك السّبب رغم إعجابي

356
00:20:55,990 --> 00:20:59,490
،بأعضاء نادي الألعاب لتدرّبهم بشدّة للفوز

357
00:20:59,490 --> 00:21:01,480
.لم أعتقد أبدًا أنّ تلك سخافة

358
00:21:02,780 --> 00:21:04,030
.فهمت

359
00:21:04,030 --> 00:21:07,020
،وخذي في اعتبارك أنّي شخص جبان

360
00:21:07,020 --> 00:21:11,340
لذلك ينتهي بي المطاف أهرب إلى ألعاب
.أخرى قبل أن أصبح جيّدًا في اللّعبة الأولى

361
00:21:12,950 --> 00:21:17,150
.أنت تواصل تخييب ظنّي

362
00:21:17,710 --> 00:21:18,960
.آ-آسف

363
00:21:19,950 --> 00:21:22,180
.أنا أقصد ذلك على نحو جيّد

364
00:21:24,860 --> 00:21:27,180
.حسنًا، هنا تنتهي تمشية اليوم

365
00:21:27,520 --> 00:21:28,800
.إلى اللّقاء يا أمانو-كُن

366
00:21:29,690 --> 00:21:30,460
.نعم

367
00:21:30,460 --> 00:21:32,180
.كان ذلك مفاجئًا

368
00:21:34,490 --> 00:21:36,220
...أنا أتوق إلى

369
00:21:39,530 --> 00:21:41,950
!العودة للمنزل واللّعب الآن

370
00:23:16,990 --> 00:23:18,980
...تيندو، أنت

371
00:23:19,590 --> 00:23:22,650
!كيف أصبحت أسوأ من ذي قبل؟

372
00:23:22,650 --> 00:23:23,770
!لماذا؟

373
00:23:23,770 --> 00:23:25,080
.كان أسلوبك يتحسّن أخيرًا

374
00:23:25,080 --> 00:23:28,900
لماذا تلعبين فجأة وكأنّك مبتدئة؟

375
00:23:28,900 --> 00:23:34,290
،في كلّ مرّة يصبح الأمر ممتعًا
.أتذكّر وجه أمانو-كُن

376
00:23:36,010 --> 00:23:39,980
!كلّ هذا بسبب أمانو-كُن

377
00:23:40,020 --> 00:23:43,980
اليوم 4

378
00:23:44,480 --> 00:23:47,980
...يُتبع