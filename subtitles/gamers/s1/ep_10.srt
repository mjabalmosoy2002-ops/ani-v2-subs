1
00:00:02,330 --> 00:00:05,100
تريدني أن أنضمّ للقاء اللاّعبين؟

2
00:00:05,100 --> 00:00:06,270
.نعم

3
00:00:07,180 --> 00:00:09,990
.لكنّي لا ألعب ألعابًا على الإطلاق

4
00:00:09,990 --> 00:00:11,250
.ذلك لا يهمّ

5
00:00:11,250 --> 00:00:13,460
.يمكنك ذلك ما دمت تحبّين اللّعب

6
00:00:13,460 --> 00:00:16,280
.كلاّ، لا أحبّ اللّعب أبدًا

7
00:00:16,620 --> 00:00:19,830
يمكنك ذلك ما دمت تحبّين شخصًا
!يحبّ الألعاب بدوره

8
00:00:19,830 --> 00:00:20,780
فعلاً؟

9
00:00:20,780 --> 00:00:23,040
هذه هي شروط الانضمام؟

10
00:00:23,040 --> 00:00:27,200
.تواجدي في لقاء مع تاسكو يبدو ممتعًا

11
00:00:27,200 --> 00:00:30,710
.لكنّي لا أريد أن أكون مزعجة لذلك الحدّ

12
00:00:32,390 --> 00:00:35,470
.في الحقيقة، لقد دعوتُ تيندو-سان أيضًا

13
00:00:36,650 --> 00:00:38,390
ستنضمّ تيندو-سان أيضًا؟

14
00:00:39,020 --> 00:00:40,980
.لا-لا بأس إذًا

15
00:00:40,980 --> 00:00:43,450
.لطالما كانت تيندو-سان لاعبة أيضًا

16
00:00:43,450 --> 00:00:45,900
.يبدو ذلك طبيعيًّا للغاية

17
00:00:47,270 --> 00:00:51,070
.لكنّ هذا لذيذ للغاية يا أمانو-تشي

18
00:00:51,070 --> 00:00:52,430
.خذي هذه إن أردت

19
00:00:52,430 --> 00:00:53,530
فعلاً؟

20
00:00:53,530 --> 00:00:55,140
.أجل

21
00:00:56,220 --> 00:00:59,530
.سأعطيك هذه إن انضممتِ للّقاء

22
00:00:59,780 --> 00:01:00,580
!سأنضمّ

23
00:01:00,580 --> 00:01:02,540
!سأنضمّ للّقاء

24
00:01:02,540 --> 00:01:04,330
فعلاً؟

25
00:01:04,330 --> 00:01:06,000
!شكرًا جزيلاً لك

26
00:01:09,580 --> 00:01:11,070
.كلي يا عزيزتي

27
00:01:11,650 --> 00:01:14,880
.إن كان هذا كلّ ما تحتاجين لتكوني سعيدة

28
00:01:15,510 --> 00:01:19,890
أعني، إنّ حبيبك يعترف بمشاعره
.لفتاة أخرى من وراء ظهرك

29
00:01:20,530 --> 00:01:23,970
!أشعر بالأسى عليك كثيرًا

30
00:02:54,110 --> 00:02:58,030
اليوم 10

31
00:02:59,980 --> 00:03:04,450
،إذًا بغضّ النّظر عن كلّ الأسئلة الّتي لديّ
.أريد أن أهنّئك أوّلاً يا تشياكي

32
00:03:04,990 --> 00:03:08,160
.لقد اعترف الرّجل الّذي تُعجبين به بمشاعره لك

33
00:03:08,160 --> 00:03:09,930
.هذه أخبار جيّدة

34
00:03:11,850 --> 00:03:13,080
أليس الأمر كذلك؟

35
00:03:14,270 --> 00:03:16,570
.أظنّه كذلك

36
00:03:18,090 --> 00:03:20,050
.أعتقد أنّي سعيدة

37
00:03:20,050 --> 00:03:24,850
أنا بالفعل سعيدة لأنّ شخصًا
.أنا مهتمّة به قال أنّه معجب بي

38
00:03:27,540 --> 00:03:30,810
.شخصيًّا، كنتُ لأرفضه دون تردّد

39
00:03:31,350 --> 00:03:36,570
ألا يملك أويهارا-سان حبيبة اسمها أغوري-سان؟

40
00:03:36,570 --> 00:03:39,010
وها هو الآن يسعى خلف أختي؟

41
00:03:39,010 --> 00:03:40,360
.إنّه مثير للمشاكل فحسب

42
00:03:42,370 --> 00:03:43,090
.إنّها على حقّ

43
00:03:43,090 --> 00:03:48,830
ما الّذي يفترض بي قوله لأغوري-سان
إن بدأت تشياكي بمواعدة أويهارا-كُن؟

44
00:03:48,830 --> 00:03:52,120
.حسنًا، لنتّصل به ونرفضه في الحال

45
00:03:52,540 --> 00:03:55,420
.لا أدري بشأن ذلك

46
00:03:55,420 --> 00:03:59,390
.لا يمكنني التّفكير بعذر لرفضه

47
00:04:00,800 --> 00:04:04,470
.في تلك الحالة، لنطلب رأي رافضة محترفة

48
00:04:07,810 --> 00:04:09,860
نـ-نعم؟ مرحبًا؟

49
00:04:09,860 --> 00:04:12,950
،آسف للاتّصال فجأة هكذا يا تيندو-سان

50
00:04:12,950 --> 00:04:16,580
لكن هل يمكنك تعليم شخص ما
كيف يرفض شخصًا آخر؟

51
00:04:17,700 --> 00:04:21,630
.أريد أن أعرف بالفعل كيف أرفض شخصًا الآن

52
00:04:22,710 --> 00:04:27,350
هـ-هل ذلك شيء تحتاج لمعرفته لتستعمله أنت؟

53
00:04:27,870 --> 00:04:30,080
.نعم، أنا سأستعمله

54
00:04:30,080 --> 00:04:31,010
!كلاّ

55
00:04:32,530 --> 00:04:35,710
.أرجوك، لا أعرف ممّن أطلب النّصح غيرك

56
00:04:35,710 --> 00:04:38,340
.رأيك هو الأكثر فعاليّة

57
00:04:38,340 --> 00:04:39,760
!نعم، أنا واثقة

58
00:04:39,760 --> 00:04:42,700
!طبعًا رأيي هو الأكثر فائدة لك

59
00:04:42,700 --> 00:04:46,970
إذًا فقد وافقت على تعليمي؟

60
00:04:46,970 --> 00:04:49,250
!بالطّبع لا

61
00:04:49,250 --> 00:04:53,380
لماذا لا تكتشف ذلك بنفسك؟

62
00:04:55,590 --> 00:04:56,570
!تيندو-سان؟

63
00:04:56,570 --> 00:04:57,820
!ما الخطب؟

64
00:04:57,820 --> 00:05:00,520
هل لكمك ملاكم عابر في بطنك؟

65
00:05:00,520 --> 00:05:05,540
،نادرًا ما قد أكون في ورطة كتلك
.لكنّي في أمر مشابه الآن

66
00:05:05,540 --> 00:05:08,570
.ماذا؟ تمهّلي، سآتي لمساعدتك

67
00:05:10,060 --> 00:05:12,520
تأتي لمساعدتي؟

68
00:05:12,520 --> 00:05:13,330
أنا؟

69
00:05:13,330 --> 00:05:15,110
.طبعًا سآتي

70
00:05:15,110 --> 00:05:18,510
أيّ حبيب هذا الّذي يأبى مساعدة حبيبته؟

71
00:05:18,510 --> 00:05:19,770
حبيبة؟

72
00:05:20,810 --> 00:05:21,870
!تيندو-سان؟

73
00:05:23,340 --> 00:05:24,610
.وصلت الرّسالة

74
00:05:24,610 --> 00:05:25,890
!أيّ رسالة؟

75
00:05:26,430 --> 00:05:28,640
.آسفة للتّسبّب بالمشاكل لك

76
00:05:28,640 --> 00:05:31,510
!تيندو كارين على خير ما يرام الآن

77
00:05:31,510 --> 00:05:34,060
!لا تبدين بخير على الإطلاق

78
00:05:34,490 --> 00:05:35,580
...أمانو-كُن

79
00:05:35,580 --> 00:05:36,600
نـ-نعم؟

80
00:05:38,210 --> 00:05:39,270
.أنا أحبّك

81
00:05:52,580 --> 00:05:56,330
لماذا حبيبتي ظريفة للغاية؟

82
00:05:56,640 --> 00:05:58,750
!عمّاذا تتحدّث من الأساس؟

83
00:05:58,750 --> 00:05:59,840
...هذا مؤلم

84
00:05:59,840 --> 00:06:00,980
...كنتُ

85
00:06:00,980 --> 00:06:03,980
ماذا عنك يا كونوها-سان؟

86
00:06:03,980 --> 00:06:05,340
ما الّذي تعنيه؟

87
00:06:05,340 --> 00:06:09,310
كيف ترفضين أشخاصًا يعترفون بمشاعرهم لك؟

88
00:06:09,310 --> 00:06:12,930
أنت ظريفة للغاية، لذلك لا بدّ
.أنّ ذلك يحدث معك كثيرًا

89
00:06:13,850 --> 00:06:15,950
،حسنًا، في حالتي

90
00:06:15,950 --> 00:06:20,790
أقول شيئًا مثل "لست مهتمّة بأمر
."كهذا في الوقت الحاليّ

91
00:06:21,810 --> 00:06:24,900
—هذا ما قد يقوله لاعب ألعاب للرّاشدين

92
00:06:23,480 --> 00:06:24,900
.سينباي

93
00:06:26,090 --> 00:06:27,820
،إن سألنا لاعب ألعاب للرّاشدين مثلي

94
00:06:27,820 --> 00:06:33,780
.فإنّ الفتيات يبحثن دائمًا عن رجل لاستغلاله

95
00:06:36,900 --> 00:06:43,540
لا أستطيع إخبار الآخرين أنّي جدّ مشغولة
.على ذلك لأنّي رئيسة مجلس التّلاميذ

96
00:06:43,540 --> 00:06:44,710
...لكنّ أختي

97
00:06:45,570 --> 00:06:46,740
...أنا

98
00:06:46,740 --> 00:06:49,930
...أنا أصمّم الألعاب وما شابه، لكن

99
00:06:49,930 --> 00:06:54,300
صحيح، كلاكما أختان تصمّمان
الألعاب المجّانيّة، صحيح؟

100
00:06:55,210 --> 00:06:56,620
.صحيح، أنا نوبي

101
00:06:56,620 --> 00:06:57,940
!أجل

102
00:06:58,540 --> 00:07:00,670
.أحسنت يا كونوها

103
00:07:01,380 --> 00:07:04,670
هل يمكنكما أن تجلسا؟

104
00:07:04,670 --> 00:07:06,050
.أنتما تحرجانني

105
00:07:09,770 --> 00:07:14,330
بشأن وضع تشياكي وأويهارا-كُن هذا
...وكلّ الفتيات اللاّتي لهنّ علاقة بالأمر

106
00:07:14,330 --> 00:07:18,660
.أعتقد أنّ هنالك حلاًّ واحدة فقط

107
00:07:19,310 --> 00:07:20,990
أعتقد أنّ علينا إحضار

108
00:07:22,290 --> 00:07:27,960
،تيندو-سان وأغوري-سان إلى اللّقاء
.ونحاول حلّ الأمور

109
00:07:27,960 --> 00:07:28,910
!أجل

110
00:07:40,220 --> 00:07:41,580
...يا أمانو

111
00:07:40,590 --> 00:07:46,190
.يا رفاق، شكرًا على توفير وقت للحضور إلى هنا

112
00:07:46,900 --> 00:07:52,280
لقد جمعتكم اليوم هنا لمناقشة
.شيء مهمّ للغاية

113
00:07:52,280 --> 00:07:55,210
...أمانو-كُن، ماذا بالضّبط

114
00:07:55,210 --> 00:08:00,580
هل توشك أن تقول شيئًا مهمًّا للغاية؟

115
00:08:01,050 --> 00:08:01,860
.نعم

116
00:08:01,860 --> 00:08:04,330
.عليّ مناقشة هذا الأمر معكم بالفعل

117
00:08:05,140 --> 00:08:06,290
...أناقشكم بشأن

118
00:08:08,950 --> 00:08:10,210
...بشأن

119
00:08:10,940 --> 00:08:13,720
...غدًا، سوف

120
00:08:14,070 --> 00:08:17,790
!"أركض بكامل سرعتي لشراء "محيط الفضاء 5

121
00:08:17,790 --> 00:08:19,650
!عمّاذا سنتحدّث؟

122
00:08:19,650 --> 00:08:20,510
!كيتا

123
00:08:20,510 --> 00:08:22,820
!عمّاذا تتحدّث؟

124
00:08:22,820 --> 00:08:23,940
!لا أستطيع

125
00:08:23,940 --> 00:08:26,810
!من المستحيل أن أفتح الموضوع الآن

126
00:08:27,190 --> 00:08:31,370
ما هي "محيط"... أو ماذا كان اسمها؟

127
00:08:31,370 --> 00:08:36,370
صحيح، غدًا هو موعد إصدار لعبة
،محيط الفضاء" الجديدة"

128
00:08:36,370 --> 00:08:38,630
.وهي سلسلة ألعابي المفضّل على الإطلاق

129
00:08:38,630 --> 00:08:42,750
أفكّر في الرّكض بكامل سرعتي
.لشرائها بمجرّد أن تنتهي الفصول

130
00:08:42,750 --> 00:08:48,370
،إنّ اللّعبة ستصدر غدًا بالفعل
.وأنا أنوي شراءها أيضًا

131
00:08:48,370 --> 00:08:49,840
لكن هل حجزتها يا كيتا؟

132
00:08:50,170 --> 00:08:56,970
،في العادة، لا أنسى حجز لعبة أبدًا
...لكنّ هذا الصّيف قد كان

133
00:08:56,970 --> 00:08:59,660
.تعلمون، حدثت أمور عديدة

134
00:08:59,660 --> 00:09:01,380
.بالفعل

135
00:09:01,380 --> 00:09:05,690
قد يكون شراؤها بعد المدرسة
.صعبًا دون حجز

136
00:09:05,690 --> 00:09:09,860
ربّما تكون ما تزال هنالك نسخة
.واحدة إن حالفك الحظّ

137
00:09:09,860 --> 00:09:10,570
.نعم

138
00:09:10,570 --> 00:09:13,610
.لذلك أنوي الرّكض بكامل سرعتي غدًا

139
00:09:13,610 --> 00:09:17,240
.أردت أن أعبّر عن إصراري لكم ببساطة

140
00:09:17,240 --> 00:09:18,690
.فهمت

141
00:09:18,690 --> 00:09:21,290
.إذًا تريدنا أن نبتعد عن طريقك غدًا

142
00:09:21,290 --> 00:09:21,860
.نعم

143
00:09:21,860 --> 00:09:23,040
.فكرة جيّدة

144
00:09:23,040 --> 00:09:26,790
.لا بدّ أنّك تحبّ تلك اللّعبة أيضًا يا أمانو-تشي

145
00:09:26,790 --> 00:09:27,570
.نعم

146
00:09:27,570 --> 00:09:31,690
.هذه اللّعبة مهمّة للغاية لديّ

147
00:09:31,690 --> 00:09:36,840
لقد لعبتُها من قبل بالطّبع، لكن هل تستحقّ
بالفعل أن تكون مهووسًا بها لتلك الدّرجة؟

148
00:09:36,840 --> 00:09:40,830
.لقد كانت أوّل لعبة لي نوعًا ما

149
00:09:40,830 --> 00:09:43,920
،إنّها ليست أوّل لعبة لعبتها أو ما شابه

150
00:09:43,920 --> 00:09:47,520
لكن يمكنكم القول أنّها الأولى
.الّتي أثّرت فيّ بالفعل

151
00:09:47,890 --> 00:09:49,840
أثّرت فيك؟

152
00:09:49,840 --> 00:09:54,040
كانت اللّعبة الثّانية في السّلسلة
.من نوعي المفضّل

153
00:09:54,040 --> 00:09:58,450
وطبعًا لعبت الكثير من ألعاب
،تقمّص الأدوار حينها

154
00:09:58,450 --> 00:10:02,490
.لكنّ هذه اللّعبة قد أثّرت فيّ بالفعل

155
00:10:02,490 --> 00:10:07,830
.شعرتُ أنّي ولدتُ لألعب هذه اللّعبة

156
00:10:08,370 --> 00:10:12,110
لذلك هنالك خطب واضح فيّ

157
00:10:12,110 --> 00:10:14,270
.لأنّي نسيت حجز نسخة عن اللّعبة

158
00:10:14,690 --> 00:10:18,640
.لكن لا يمكنني أن أرضى بالنّسخة المحمّلة

159
00:10:18,640 --> 00:10:23,030
،لذلك قرّرتُ الذّهاب لشرائها
.حتّى إن قتلني ذلك

160
00:10:23,030 --> 00:10:24,890
.هذه هي الرّوح المطلوبة

161
00:10:24,890 --> 00:10:27,250
.أعتقد أنّ عليّ أن أدعو لك بالنّجاح

162
00:10:27,250 --> 00:10:28,840
.نعم، شكرًا

163
00:10:28,840 --> 00:10:32,700
.سأبذل جهدي غدًا لكي لا أخذلكم

164
00:10:32,700 --> 00:10:34,090
!أنطلق يا أمانو-تشي

165
00:10:34,090 --> 00:10:35,210
!حظًّا سعيدًا

166
00:10:35,210 --> 00:10:36,820
!تصفيق، تصفيق، تصفيق

167
00:10:50,380 --> 00:10:51,460
أختي؟

168
00:10:51,460 --> 00:10:52,460
نعم؟

169
00:10:52,790 --> 00:10:54,710
.أشعلي الأضواء على الأقلّ

170
00:10:55,300 --> 00:10:56,340
ماذا هنالك؟

171
00:10:57,710 --> 00:10:59,260
.آسفة

172
00:10:59,260 --> 00:11:02,180
.كنتُ أبحث عن لعبة قديمة

173
00:11:03,100 --> 00:11:03,760
ما تلك؟

174
00:11:04,650 --> 00:11:06,640
.إنّها لعبة "محيط الفضاء" الثّانية

175
00:11:07,150 --> 00:11:09,390
.إنّها رائعة بالفعل

176
00:11:09,390 --> 00:11:10,890
هل تريدين لعبها يا كونوها؟

177
00:11:11,270 --> 00:11:12,800
.لا

178
00:11:12,800 --> 00:11:15,420
بالمناسبة، كيف سار لقاؤكم اليوم؟

179
00:11:15,420 --> 00:11:17,730
هل وضّحتم الأمور بشكل كافٍ جعلك
تشعرين بتحسّن يدفعك للّعب؟

180
00:11:19,690 --> 00:11:22,480
.لم يُوضّح أيّ شيء

181
00:11:22,480 --> 00:11:26,990
.لقد جبُن كيتا ولم يُحلّ أيّ شيء

182
00:11:27,980 --> 00:11:29,890
.توقّعت حدوث ذلك

183
00:11:29,890 --> 00:11:33,780
.لكنّ نصف تلك الفوضى بسببك

184
00:11:33,780 --> 00:11:35,130
.حتّى أنّك أقحمتني فيها

185
00:11:36,270 --> 00:11:38,130
.آسفة

186
00:11:38,130 --> 00:11:40,580
.أنا ممتنّة لك كثيرًا

187
00:11:41,540 --> 00:11:43,760
ما الّذي كنت تريدينه؟

188
00:11:44,590 --> 00:11:46,320
.لا أدري

189
00:11:46,320 --> 00:11:49,980
.فكّرت في معرفة كيف تشعر أختي

190
00:11:50,670 --> 00:11:51,710
كيف أشعر؟

191
00:11:51,710 --> 00:11:52,810
بشأن ماذا؟

192
00:11:52,810 --> 00:11:54,270
وماذا قد يكون؟

193
00:11:57,780 --> 00:11:59,590
...لحظة

194
00:11:59,590 --> 00:12:03,270
.لدى كيتا حبيبة اسمها تيندو-سان

195
00:12:03,940 --> 00:12:10,140
هل يمكنك على الأقلّ أن تتّخذي
قرارًا بشأن ما تريدينه أنت؟

196
00:12:10,140 --> 00:12:15,170
.وإلاّ، سيضعف وضعي بصفتي نوبي ومونو

197
00:12:15,590 --> 00:12:18,130
.معك حقّ

198
00:12:18,980 --> 00:12:23,220
هل تريدين التّقرّب من سينباي أم ماذا؟

199
00:12:23,220 --> 00:12:26,150
أم أنّك تريدين مواصلة الشّجار معه كالعادة؟

200
00:12:26,620 --> 00:12:30,170
أم تريدين الابتعاد عنه فحسب؟

201
00:12:39,510 --> 00:12:43,380
أقصد أنّي لا أدفعك لاتّخاذ أيّ
.قرار في الوقت الحاليّ

202
00:12:43,990 --> 00:12:49,530
.حسنًا، قلتُ ما لديّ، تصبحين على خير يا أختي

203
00:12:49,530 --> 00:12:52,220
.وآسفة لإضافة هذا العبء عليك

204
00:12:52,220 --> 00:12:54,540
.لا، لا بأس

205
00:12:54,540 --> 00:12:55,830
.تصبحين على خير

206
00:13:00,810 --> 00:13:02,050
...أنا

207
00:13:02,930 --> 00:13:07,430
ما الّذي أريد أن يحدث مع كيتا؟

208
00:13:12,970 --> 00:13:15,140
.حسنًا، سأنطلق يا أويهارا-كُن

209
00:13:15,530 --> 00:13:16,850
.حظًّا سعيدًا

210
00:13:20,010 --> 00:13:24,400
.إنّ له شغفًا مذهلاً لألعاب الفيديو بالفعل

211
00:13:27,620 --> 00:13:29,700
.حسنًا، عليّ الذّهاب أيضًا

212
00:13:32,570 --> 00:13:37,670
ما دام أمانو يواعد تيندو، فأنا الوحيد
.الّذي يمكنه العناية بهوشينوموري

213
00:13:37,670 --> 00:13:40,420
.عليّ على الأقلّ أن أوضّح ذلك

214
00:13:40,420 --> 00:13:43,340
.الآن هي فرصتي بما أنّ أغوري وأمانو ليسا هنا

215
00:13:44,970 --> 00:13:46,750
...حسنًا

216
00:13:48,100 --> 00:13:49,580
.أ-أويهارا-سان

217
00:13:49,580 --> 00:13:50,810
.مرحبًا يا هوشينوموري

218
00:13:50,810 --> 00:13:52,390
هل يمكننا الحديث؟

219
00:13:52,390 --> 00:13:54,580
...أ-أنا... بشأن ذلك

220
00:13:54,580 --> 00:13:58,020
.ما زالت لم أفكّر بجواب بعد

221
00:13:58,810 --> 00:14:01,230
.لستُ جاهزة للتّسبّب بالألم لأيّ أحد

222
00:14:02,770 --> 00:14:03,940
.فهمت

223
00:14:03,940 --> 00:14:06,850
إنّها ليست واثقة بالكامل بشأن
.مشاعرها نحو أمانو بعد

224
00:14:07,380 --> 00:14:11,240
ليست جاهزة لتجرح تيندو عن
.طريق أخذ أمانو منها

225
00:14:11,240 --> 00:14:12,030
هل الأمر هكذا؟

226
00:14:12,790 --> 00:14:13,960
.مفهوم

227
00:14:13,960 --> 00:14:15,420
.آسف يا هوشينوموري

228
00:14:15,420 --> 00:14:16,850
.لم أرد استعجالك

229
00:14:17,690 --> 00:14:18,500
.لا-لا بأس

230
00:14:18,970 --> 00:14:23,780
.أدرك أنّك تريد أن تعرف كيف أشعر

231
00:14:24,430 --> 00:14:25,340
...لحظة

232
00:14:25,340 --> 00:14:29,470
لستُ واثقة ممّا يحدث، لكنّي أفترض
أنّكما قد انتهيتما من الحديث؟

233
00:14:30,190 --> 00:14:34,350
.أ-أكيد، انتهى قبل أن أدرك نوعًا ما

234
00:14:34,350 --> 00:14:35,710
...حسنًا

235
00:14:35,710 --> 00:14:40,480
.هنالك أمر أودّ أن أقوله لكما في الحقيقة

236
00:14:48,580 --> 00:14:50,860
.سُحقًا، كان فخًّا

237
00:14:51,190 --> 00:14:52,430
.انظرا

238
00:14:52,430 --> 00:14:53,700
.أغوري من الإعداديّة

239
00:14:53,700 --> 00:14:55,540
أليس هذا جنونيًّا؟

240
00:14:55,540 --> 00:14:56,260
أرأيت؟

241
00:14:56,260 --> 00:14:57,820
!مـ-مهلاً

242
00:14:59,670 --> 00:15:03,040
.لقد تغيّرت بالكامل يا أغوري-تشان

243
00:15:03,040 --> 00:15:05,780
.مظهرك المملّ لم يكن سيّئًا أيضًا

244
00:15:06,690 --> 00:15:07,730
!تمامًا

245
00:15:07,730 --> 00:15:09,940
من يكونان على أيّ حال؟

246
00:15:09,940 --> 00:15:11,940
.لديّ حبيب الآن كما تعلمين

247
00:15:11,940 --> 00:15:12,830
وماذا في ذلك؟

248
00:15:12,830 --> 00:15:15,040
لديّ حبيب أيضًا. فما قصدك؟

249
00:15:15,040 --> 00:15:16,490
أ-أنت جادّة؟

250
00:15:16,490 --> 00:15:17,680
عمّاذا تتحدّثان؟

251
00:15:17,680 --> 00:15:18,660
.لا شيء

252
00:15:18,660 --> 00:15:20,100
.هيّا

253
00:15:20,100 --> 00:15:22,710
.لا تروقني سارينا بالفعل

254
00:15:22,710 --> 00:15:24,550
.أخبريني يا أغوري-تشان

255
00:15:25,580 --> 00:15:28,440
هل صحيح أنّك تشاركين في لقاء
لاعبين أو ما شابه؟

256
00:15:28,440 --> 00:15:29,590
.صحيح

257
00:15:29,590 --> 00:15:31,170
وماذا في ذلك؟

258
00:15:31,170 --> 00:15:32,990
.لست سيّئة يا أغوري-تشان

259
00:15:32,990 --> 00:15:33,970
ماذا؟

260
00:15:33,970 --> 00:15:37,140
إنّه مليء بالمهووسين القذرين
أشباه الخنازير، صحيح؟

261
00:15:37,140 --> 00:15:39,460
.يا رجل، ذلك لئيم

262
00:15:39,460 --> 00:15:40,580
...عفوًا

263
00:15:40,580 --> 00:15:43,370
.تعبث أغوري-تشان معهم بكلّ تأكيد

264
00:15:43,370 --> 00:15:44,960
.ذلك مقرف يا رجل

265
00:15:44,960 --> 00:15:48,590
كلاّ، ذلك أفضل من القيام بذلك
.مع فتيات ثنائيّات الأبعاد

266
00:15:48,590 --> 00:15:51,450
.إنّ أغوري هي أميرة الأوتاكو

267
00:15:52,030 --> 00:15:53,870
.لا يمكنني التّعامل مع ذلك مطلقًا

268
00:15:53,870 --> 00:15:56,030
ماذا إن علقت بي رائحتهم؟

269
00:15:59,570 --> 00:16:05,700
آسفة، أحظى بمرح أكثر بالحديث
.مع أولئك المهووسين القذرين

270
00:16:05,700 --> 00:16:07,350
.سأغادر

271
00:16:11,350 --> 00:16:12,700
.مهلاً يا أغوري

272
00:16:12,700 --> 00:16:14,640
ما الّذي تعتقدين نفسك فاعلة؟

273
00:16:14,640 --> 00:16:16,700
.سأغادر فحسب

274
00:16:16,700 --> 00:16:21,380
حبيبك ليس واحدًا من أولئك
الأوتاكو القذرين، صحيح؟

275
00:16:21,380 --> 00:16:22,620
.كلاّ

276
00:16:22,620 --> 00:16:25,470
ما كان ذلك إذًا؟

277
00:16:25,470 --> 00:16:26,250
تسألين عن السّبب؟

278
00:16:26,250 --> 00:16:31,780
،إن لم يكن الشّخص حبيبك أصلاً
فلماذا غضبتِ لانّنا سخرنا منه قليلاً؟

279
00:16:31,780 --> 00:16:32,840
.لا أصدّق هذا

280
00:16:33,170 --> 00:16:35,340
كيف أمكنك إفساد الجوّ بسبب ذلك فحسب؟

281
00:16:35,340 --> 00:16:36,870
بسبب ذلك فحسب؟

282
00:16:38,500 --> 00:16:44,190
قد يكون أمانو-تشي مهووسًا قذرًا
.على حدّ رأيكم، لكنّ الأمر ليس كذلك

283
00:16:44,950 --> 00:16:46,020
عمّاذا تتحدّثين؟

284
00:16:46,020 --> 00:16:47,250
.كلامك غير منطقيّ

285
00:16:47,250 --> 00:16:49,290
إنّه ليس حبيبك، صحيح؟

286
00:16:49,290 --> 00:16:50,530
وماذا في ذلك؟

287
00:16:50,530 --> 00:16:51,790
تسألين عن السّبب؟

288
00:16:53,390 --> 00:16:56,890
.سوف أغادر إن كنتِ قد انتهيت

289
00:16:59,930 --> 00:17:02,780
!لم تتغيّري أبدًا

290
00:17:02,780 --> 00:17:04,660
.ما تزالين غريبة وخجولة من الدّاخل

291
00:17:06,420 --> 00:17:08,380
.يسعدني ذلك كثيرًا

292
00:17:08,380 --> 00:17:09,880
.شكرًا يا سارينا

293
00:17:25,870 --> 00:17:27,290
...تاسكو

294
00:17:31,820 --> 00:17:34,900
ما الّذي أردتِ أن تتحدّثين بشأنه؟

295
00:17:34,900 --> 00:17:37,240
.نعم، يساورني الفضول أيضًا

296
00:17:38,230 --> 00:17:43,240
.أعلم أنّ من الغريب لي أن أسألكما

297
00:17:43,860 --> 00:17:48,150
.لكنّي أتصرّف بغرابة مؤخّرًا

298
00:17:49,070 --> 00:17:55,150
،حسنًا... مذ بدأتُ مواعدة أمانو-كُن
.أصبحت بشرتي نضرة للغاية

299
00:17:55,150 --> 00:17:57,710
الأشياء الّتي كنتُ آكلها طوال
.الوقت أصبحت ألذّ فجأة

300
00:17:57,710 --> 00:18:01,140
!العالم بأسره جميل للغاية

301
00:18:01,140 --> 00:18:02,720
.لقد فقدت رشدها

302
00:18:02,720 --> 00:18:08,050
شخصيًّا، أريد أن أكون مع
.أمانو-كُن طوال الوقت

303
00:18:08,820 --> 00:18:13,300
.لكن اليوم، يبدو أنّ الألعاب أهمّ عنده منّي

304
00:18:13,730 --> 00:18:18,820
في نفس الوقت، يخرج للأكل مع
.أغوري-سان طوال الوقت

305
00:18:19,240 --> 00:18:21,210
.تواجهين وقتًا صعبًا أيضًا

306
00:18:22,470 --> 00:18:26,080
.لا أظنّ أنّ هنالك مشكلة في لقائه لأغوري

307
00:18:26,080 --> 00:18:30,970
حتّى أنّ أغوري قد قالت أنّها تعتبره
.أخًا صغيرًا يصعب التّعامل معه

308
00:18:30,970 --> 00:18:32,770
فـ-فعلاً؟

309
00:18:33,230 --> 00:18:35,670
.هذا مريح

310
00:18:35,670 --> 00:18:40,900
،لكن إن أبعدنا الألعاب عن أمانو
...فسيكون ذلك أشبه

311
00:18:43,420 --> 00:18:47,060
.أظنّ أنّه ما باليد حيلة يا تيندو-سان

312
00:18:47,060 --> 00:18:50,690
.هكذا هو كيتا

313
00:18:50,690 --> 00:18:53,500
.رغم أنّه ضعيف، قد يكون عنيدًا بطرق غريبة

314
00:18:53,500 --> 00:18:58,240
وأحيانًا، يعطي الأولويّة لألعابه بدل العثور
.على السّعادة في حياته الحقيقيّة

315
00:18:58,240 --> 00:18:59,820
.إنّه أوتاكو بمعنى الكلمة

316
00:19:01,820 --> 00:19:04,080
...لهذا السّبب بالضّبط يا تيندو-سان

317
00:19:06,860 --> 00:19:09,070
.معك حقّ

318
00:19:10,070 --> 00:19:11,010
.نعم

319
00:19:11,010 --> 00:19:12,660
.معك حقّ تمامًا

320
00:19:13,220 --> 00:19:17,340
إنّه يختار الألعاب بدلاً منّي
.أو أصدقائه. هكذا هو

321
00:19:18,100 --> 00:19:22,170
.لا بدّ أنّ تيندو معجبة كثيرًا بأمانو

322
00:19:25,810 --> 00:19:30,210
لكنّي لا أستطيع فعلاً الكفّ عن التّفكير
.بأمانو هذه الأيّام

323
00:19:30,210 --> 00:19:31,380
.أويهارا-كُن

324
00:19:31,380 --> 00:19:34,690
.كفانا حديثًا عن علاقتك الآن

325
00:19:34,690 --> 00:19:36,420
...تا-تاسكو

326
00:19:42,740 --> 00:19:46,050
!وا-واضح أنّك تخونني

327
00:19:46,050 --> 00:19:48,620
!أذكر تلك الصّرخة

328
00:19:49,250 --> 00:19:50,120
!أغوري

329
00:19:51,620 --> 00:19:53,630
.مهلاً يا أغوري، لا بأس

330
00:19:53,630 --> 00:19:58,250
.أويهارا-كُن يشبه حشرة تحوم حول أمانو-كُن

331
00:19:58,250 --> 00:19:59,310
!معها حقّ

332
00:19:59,310 --> 00:20:02,980
لقد تجاوزتُ المرحلة الّتي كنتُ أشعر
.فيها بالفخر لأنّ أويهارا-كُن معجب بي

333
00:20:02,980 --> 00:20:04,700
.شكرًا على الدّعم يا رفيقتاي

334
00:20:04,700 --> 00:20:07,690
.لكنّ كلامكما الآن جرحني لسبب ما

335
00:20:07,690 --> 00:20:09,480
!اخرس أيّها الخائن

336
00:20:09,480 --> 00:20:10,310
!كلاّ

337
00:20:11,230 --> 00:20:15,450
يُنعت حبيبي بالخائن من الفتاتان
!اللّتان يخونني معهما

338
00:20:15,450 --> 00:20:19,140
!ساعدني يا أمانو-تشي

339
00:20:23,140 --> 00:20:24,400
.آسفة

340
00:20:24,400 --> 00:20:27,330
.لقد سمحت للّحظة أن تؤثّر عليّ

341
00:20:27,330 --> 00:20:28,770
.لا بأس

342
00:20:28,770 --> 00:20:30,460
.ليست غلطتك يا أغوري-سان

343
00:20:30,460 --> 00:20:31,390
.إنّها على حقّ

344
00:20:31,860 --> 00:20:35,210
تقولان ذلك وكأنّ هنالك منبع
.شرّ آخر في مكان ما

345
00:20:37,250 --> 00:20:40,850
.صحيح، لقد اتّصلت بأمانو-تشي

346
00:20:40,850 --> 00:20:42,090
.عليّ أن أشرح الوضع

347
00:20:42,090 --> 00:20:45,270
.أنا واثقة أنّك لن تحتاجين لذلك

348
00:20:45,270 --> 00:20:48,560
.لا بدّ أنّه يركض بحثًا عن اللّعبة

349
00:20:48,560 --> 00:20:50,770
.نعم، بالنّظر إلى كم كان متحمّسًا

350
00:20:50,770 --> 00:20:52,610
.نعم، صحيح

351
00:20:53,460 --> 00:20:54,770
.أغوري-سان

352
00:21:00,020 --> 00:21:01,780
.أمانو-تشي

353
00:21:02,340 --> 00:21:03,140
ماذا؟

354
00:21:03,550 --> 00:21:05,280
أغوري-سان؟

355
00:21:05,280 --> 00:21:09,660
ظننتُ أنّك انفصلت عن أويهارا-كُن
.وكنت مكتئبة بشأن ذلك

356
00:21:09,660 --> 00:21:11,370
...أ-أنا

357
00:21:11,370 --> 00:21:12,410
...حسنًا

358
00:21:12,410 --> 00:21:14,010
...كيف أشرح الأمر

359
00:21:14,010 --> 00:21:15,420
...لحظة

360
00:21:15,860 --> 00:21:17,920
...لا تقولي لي

361
00:21:19,860 --> 00:21:21,940
!كان سوء فهم

362
00:21:21,940 --> 00:21:22,670
.نعم، نعم

363
00:21:23,060 --> 00:21:24,880
.عرفتُ هذا

364
00:21:24,880 --> 00:21:25,540
.يا إلهي

365
00:21:25,540 --> 00:21:27,300
.ما كان عليّ أن أقلق

366
00:21:27,300 --> 00:21:28,860
.آ-آسفة

367
00:21:28,860 --> 00:21:29,930
.أنا فعلاً آسفة

368
00:21:31,530 --> 00:21:34,690
أ-أمانو-كُن، لماذا أنت هنا؟

369
00:21:34,690 --> 00:21:35,560
ماذا؟

370
00:21:35,560 --> 00:21:37,030
لماذا؟

371
00:21:37,030 --> 00:21:40,900
.اتّصلت أغوري-سان وبدا الأمر خطيرًا

372
00:21:40,900 --> 00:21:45,280
لـ-لكن ألم تكن قد خرجت لشراء "محيط الفضاء"؟

373
00:21:45,280 --> 00:21:48,220
.ماذا؟ يمكن لذلك أن ينتظر

374
00:21:48,220 --> 00:21:50,280
.كان هذا أكثر أهمّيّة من اللّعبة

375
00:21:52,500 --> 00:21:54,550
.أنت متعرّق كثيرًا يا أمانو-تشي

376
00:21:54,550 --> 00:21:57,540
.ربّما تكون مهووسًا قذرًا أشبه بخنزير بالفعل

377
00:21:57,540 --> 00:21:59,540
