1
00:00:00,000 --> 00:00:03,980
اليوم 6

2
00:00:05,980 --> 00:00:09,110
.أنا آسفة! يبدو أنّي فهمت الأمر بشكل خاطئ

3
00:00:09,470 --> 00:00:11,100
.بكلّ تأكيد

4
00:00:11,510 --> 00:00:15,800
.وها أنا ذا أخرج مع هوشينوموري ثانية

5
00:00:15,800 --> 00:00:18,370
أويهارا-سان، هل أنت بخير؟

6
00:00:18,810 --> 00:00:20,820
.نعم، لا تهتمّي

7
00:00:20,820 --> 00:00:25,190
.راودتني لحظة كآبة بسبب قساوة العالم

8
00:00:26,830 --> 00:00:28,380
.بالطّبع

9
00:00:29,330 --> 00:00:33,850
ما زلت لا أفهم كيف يمكن
.أن يمتلك كيتا حبيبة جميلة مثلها

10
00:00:33,850 --> 00:00:37,670
...بشأن ذلك، أنا أيضًا لا أفهم الأمر

11
00:00:38,680 --> 00:00:41,470
.هذا العالم غريب بالفعل

12
00:00:41,470 --> 00:00:44,020
إنّ مجرّد التّفكير في تلك اللّحظة
الّتي كان فيها كيتا يتباهى بكلّ فخر

13
00:00:44,020 --> 00:00:48,540
.بعلاقته يجعلني أستشيط غضبًا

14
00:00:48,540 --> 00:00:51,570
هل أنت واثقة أنّك لم تتوهّمي ذلك؟

15
00:00:52,070 --> 00:00:56,410
.لم أرَ رجلاً يتباهى بحبيبته بلا خجل مثله من قبل

16
00:00:58,210 --> 00:00:59,050
ماذا؟

17
00:00:59,050 --> 00:01:00,510
هل من خطب ما؟

18
00:01:00,510 --> 00:01:03,070
.كلاّ، لا تهتمّي

19
00:01:03,070 --> 00:01:04,840
.لنتحدّث عن شيء آخر

20
00:01:04,840 --> 00:01:05,960
.حسنًا

21
00:01:05,960 --> 00:01:08,330
...أخبريني، بشأن أمانو

22
00:01:08,330 --> 00:01:11,090
.أتمنّى أن يركب في حوّامة بنتها كا*ـكوم

23
00:01:11,090 --> 00:01:12,710
.أنا سعيد لرؤية أنّك لم تتغيّري

24
00:01:14,870 --> 00:01:18,620
حسنًا، ما رأيك في تيندو إذًا؟

25
00:01:18,620 --> 00:01:20,600
أقلت تيندو-سان؟

26
00:01:21,220 --> 00:01:23,340
.لا أدري ما أقوله

27
00:01:23,340 --> 00:01:26,050
.أنا لا أتحدّث إليها كثيرًا في الفصل أو ما شابه

28
00:01:26,050 --> 00:01:31,150
.أعني أنّي مجرّد قمامة مقارنة بها

29
00:01:31,150 --> 00:01:34,090
.إنّكما تملكان نفس وجهة النّظر عن نفسيكما

30
00:01:34,610 --> 00:01:36,920
.رغم أنّي أحترمها كثيرًا

31
00:01:36,920 --> 00:01:39,590
.فكلتانا لاعبة قبل كلّ شيء

32
00:01:39,590 --> 00:01:42,810
.أتمنّى لو نصبح صديقتين يومًا ما

33
00:01:42,810 --> 00:01:45,390
.عليك أن تواعدي أمانو فحسب على هذا الحال

34
00:01:45,900 --> 00:01:46,830
...معذرة

35
00:01:47,490 --> 00:01:50,750
لماذا قلت ذلك فجأة؟

36
00:01:55,510 --> 00:01:58,470
ماذا عنك؟ ما رأيك يا أويهارا-سان؟

37
00:01:58,470 --> 00:02:02,020
.أقصد بشأن تيندو-سان

38
00:02:02,020 --> 00:02:05,070
أنا؟ ما رأيي بتيندو؟

39
00:02:06,370 --> 00:02:08,520
.أظنّ أنّها بلا عيوب

40
00:02:09,150 --> 00:02:10,940
.وهذا إلى أن تعرفيها حقّ المعرفة

41
00:02:10,940 --> 00:02:12,370
.عرفتُ هذا

42
00:02:12,370 --> 00:02:14,730
.أنت تحبّ تيندو-سان بالفعل

43
00:02:17,090 --> 00:02:19,300
.ابتهجي يا هوشينوموري

44
00:02:19,300 --> 00:02:22,580
.أنت فتاة رائعة بالكامل في نظري أيضًا

45
00:02:22,580 --> 00:02:24,660
.أنت على قدم المساواة مع تنيدو

46
00:02:24,660 --> 00:02:26,460
.حسنًا. شكرًا

47
00:02:26,870 --> 00:02:27,410
...مهلاً

48
00:02:31,020 --> 00:02:31,930
.آسف

49
00:02:31,930 --> 00:02:35,030
...أنا أخرج مع فتاة متعلّقة بي كثيرًا، لذلك

50
00:02:35,030 --> 00:02:38,340
.سـ-سوف أذهب الآن

51
00:02:38,820 --> 00:02:39,690
.مهلاً

52
00:02:39,690 --> 00:02:40,590
!انتظري

53
00:02:41,620 --> 00:02:42,500
.المعذرة

54
00:02:42,500 --> 00:02:44,610
.شكرًا جزيلاً لكما

55
00:02:45,760 --> 00:02:47,600
!إنّه يخونها بكلّ تأكيد

56
00:02:47,600 --> 00:02:49,730
،لم أسمع ما قاله في البداية

57
00:02:49,730 --> 00:02:52,290
لكنّي سمعت كلّ شيء قاله بعد أن وصف
،تيندو-سان بأنّ لا عيوب لها

58
00:02:52,290 --> 00:02:54,570
.وصولاً إلى تربيته على رأسها

59
00:02:54,570 --> 00:02:57,080
!هذا كثير للغاية يا أويهارا-كُن

60
00:02:57,080 --> 00:03:01,110
،فوق، فوق، أسفل، أسفل، يسار، يمين
...يسار، يمين، ب، أ، ب، أ، ب، أ، ب، أ

61
00:02:59,110 --> 00:03:01,110
!رمز الحفظ المشهور

62
00:03:05,510 --> 00:03:09,980
.تكاد مشاهدة الأمر تكون مريحة

63
00:03:10,450 --> 00:03:13,410
.أعتقد أنّ هذا أسهل قليلاً بطريقة ما

64
00:03:16,300 --> 00:03:19,140
.ومع ذلك، أنا أحبّ تاسكو

65
00:03:20,690 --> 00:03:22,850
ما العمل؟

66
00:03:22,850 --> 00:03:24,760
ما العمل بالفعل؟

67
00:03:26,830 --> 00:03:28,530
.كفانا حديثًا عنّي

68
00:03:28,530 --> 00:03:29,930
ماذا عنك؟

69
00:03:29,930 --> 00:03:31,770
ماذا عنّي؟

70
00:03:31,770 --> 00:03:33,260
وماذا قد يكون؟

71
00:03:33,260 --> 00:03:34,810
.أنت وتيندو-سان

72
00:03:36,370 --> 00:03:38,450
هل تحاول من الأساس يا أمانو-تشي؟

73
00:03:38,450 --> 00:03:42,180
تطلّب منّي الوصول إلى حيث
،أنا الآن عملاً كثيرًا

74
00:03:42,180 --> 00:03:43,820
.من الوقت الّذي كنتُ فيه خجولة ومنعزلة

75
00:03:43,820 --> 00:03:47,660
وصولاً إلى هنا حيث بدأ حبيبك
.بخيانتك هنا وهناك. مفهوم

76
00:03:47,660 --> 00:03:49,790
!هذا مؤلم

77
00:03:50,970 --> 00:03:54,750
ما أقصده هو أنّه لا يهمّ كم ستحسّن
.من نفسك، فذلك ليس كافيًا

78
00:04:00,580 --> 00:04:04,160
.اسمع يا أمانو-تشي. الحياة ليست لعبة

79
00:04:04,160 --> 00:04:05,850
.أنت على حقّ

80
00:04:05,850 --> 00:04:09,770
ومع ذلك، تعدّ بعض الألعاب
.تمثيلاً جيّدًا للحياة

81
00:04:09,770 --> 00:04:10,770
.اخرس ولا تتحدّث

82
00:04:10,770 --> 00:04:11,770
.آسف

83
00:04:12,910 --> 00:04:18,620
هل أنت واثق حتّى من أنّه يمكن تقييم
العلاقات الإنسانيّة بـ"المستويات"؟

84
00:04:18,620 --> 00:04:21,740
لا يمكن للنّاس أن يصبحوا أصدقاءً
بحصولهم على جاذبيّة كافية، صحيح؟

85
00:04:22,810 --> 00:04:27,130
أمانو-تشي، واحد زائد واحد
.لا تساوي اثنان في هذا العالم

86
00:04:27,130 --> 00:04:28,240
...نعم

87
00:04:28,890 --> 00:04:31,160
...في هذا العالم، واحد زائد واحد يساوي

88
00:04:31,630 --> 00:04:33,080
!"الحوبّ"

89
00:04:34,620 --> 00:04:35,870
!إنّه الحبّ

90
00:04:37,070 --> 00:04:38,460
تقصدين الحبّ؟

91
00:04:38,460 --> 00:04:39,630
.الحبّ هو ما قصدت

92
00:04:39,630 --> 00:04:42,130
لماذا أشعر بالأسى عليها؟

93
00:04:42,470 --> 00:04:46,130
،كلاّ، لكن قبل كلّ ذلك
.علينا أن نصبح صديقين أوّلاً

94
00:04:46,130 --> 00:04:51,110
في الحقيقة، أحتاج منها أن تراني
.كإنسان من الأساس

95
00:04:51,110 --> 00:04:52,660
.ذلك نفس الشّيء

96
00:04:52,660 --> 00:04:56,260
،في كلتا الحالتين، عليك أن تحدّثها مباشرة
.وإلاّ فلن تتقدّم إلى أيّ مكان

97
00:04:56,260 --> 00:04:57,810
...أعلم، ولكن

98
00:05:00,060 --> 00:05:04,530
بالمناسبة يا أغوري-سان، كيف اعترفت
بمشاعرك لأويهارا-كُن؟

99
00:05:05,060 --> 00:05:06,610
هل ستفعل ذلك؟

100
00:05:06,610 --> 00:05:08,090
هل ستفعل ذلك بالفعل؟

101
00:05:08,090 --> 00:05:09,030
.يا إلهي

102
00:05:09,470 --> 00:05:11,130
.مصيبة

103
00:05:10,250 --> 00:05:12,790
...حسنًا، حسنًا

104
00:05:13,410 --> 00:05:15,910
.قلت له "هل تواعدني يا أويهارا-كُن؟" مباشرة

105
00:05:16,540 --> 00:05:21,250
"قلت له "هل تواعدني يا أويهارا-كُن؟
.مباشرة يا أمانو-تشي

106
00:05:22,670 --> 00:05:26,730
سمعتُ إشاعة تقول أنّ تاسكو يحبّ
.الفتيات مشتّتات الذّهن

107
00:05:26,730 --> 00:05:28,980
،وحتّى إن لم يكن يحبّ ذلك

108
00:05:28,980 --> 00:05:32,040
.كنتُ لأقول له نفس الشّيء في كلّ الأحوال

109
00:05:32,040 --> 00:05:35,190
.هذا بسيط للغاية

110
00:05:35,190 --> 00:05:36,350
.لا، لا، لا

111
00:05:36,350 --> 00:05:37,770
.بل الأمر عكس ذلك يا أمانو-تشي

112
00:05:38,150 --> 00:05:41,250
.أعزّ مشاعرنا دائمًا ما تكون الأبسط

113
00:05:41,250 --> 00:05:43,280
.إنّها تخرج من أفواهنا بشكل طبيعيّ

114
00:05:45,030 --> 00:05:50,410
لذلك إن كنتَ تريد بالفعل أن تصبح صديقًا
.لتيندو-سان، فلن تواجه مشاكل في قول ذلك

115
00:05:50,410 --> 00:05:53,660
.الأمر منوط بما تشعر به حقًّا

116
00:05:57,460 --> 00:06:00,140
هل هذا شيء أستطيع حتّى أنا فعله؟

117
00:06:00,140 --> 00:06:01,430
.نعم، تستطيع

118
00:06:01,430 --> 00:06:02,410
.هذا مضمون

119
00:06:04,370 --> 00:06:08,180
.أعتقد أنّي سأحاول ذلك غدًا
.ليس لديّ ما أخسره

120
00:06:09,100 --> 00:06:11,460
.أحسنت يا أمانو-تشي

121
00:06:12,150 --> 00:06:14,810
!أنا رجل. وسأفي بكلمتي

122
00:06:14,810 --> 00:06:15,910
.أجل

123
00:06:15,910 --> 00:06:18,500
.لن أستسلم بعد أنا أيضًا

124
00:06:18,500 --> 00:06:20,030
!لنبذل جهدينا

125
00:06:20,030 --> 00:06:20,730
!نعم

126
00:06:20,730 --> 00:06:22,430
!لنساند بعضنا

127
00:06:24,110 --> 00:06:26,780
كلاّ، ألم أخبرك؟

128
00:06:27,150 --> 00:06:29,780
.لا نيّة لي في الخروج معك

129
00:06:29,910 --> 00:06:33,410
كلاّ، كيف يمكن لذلك أن يكون مختلفًا
عن أن نبدأ كصديقين؟

130
00:06:33,530 --> 00:06:36,660
ما الّذي تعنيه بـ"صديقين" من الأساس؟

131
00:06:36,790 --> 00:06:41,540
هل تعني بـ"صديقين"، أنّها مكانة أقلّ
من "حبيبين" لأنّك تريد حلاًّ وسطًا؟

132
00:06:41,670 --> 00:06:44,000
،كلاّ، الأمر ليس وكأنّ لدينا اختلافًا في القيم

133
00:06:44,000 --> 00:06:46,050
.بل هو أقرب إلى عدم توافقي معك جيّدًا

134
00:06:46,670 --> 00:06:50,380
لذلك بعد قولي لهذا، فأنا لا... ماذا؟

135
00:06:51,020 --> 00:06:52,170
!حقيرة

136
00:06:54,930 --> 00:06:56,690
يومٌ عصيب؟

137
00:06:58,540 --> 00:06:59,890
.أهلاً

138
00:06:59,890 --> 00:07:03,770
نادي الألعاب

139
00:06:59,890 --> 00:07:03,770
.أسوأ ما يمكن القيام به هو منح إجابة مبهمة

140
00:07:04,310 --> 00:07:08,810
وبذلك ينتهي بك المطاف مانحًا
.إيّاهم أملاً زائفًا إن خذلتهم على مهل

141
00:07:08,810 --> 00:07:10,040
.فهمت

142
00:07:10,040 --> 00:07:12,810
.لهذا السّبب كنت تضعين لهم حدًّا بلا رحمة

143
00:07:12,810 --> 00:07:15,640
هل كنت قاسية لذلك الحدّ؟

144
00:07:15,640 --> 00:07:19,410
.بصراحة، بدوتِ كوحش

145
00:07:19,990 --> 00:07:22,820
،ربّما السّبب هو أنّك كنتِ تنوين رفضهم

146
00:07:22,820 --> 00:07:25,340
.وتذهبين دائمًا وأنت عازمة على الرّفض

147
00:07:26,740 --> 00:07:31,510
أتساءل إن كان غُدُوّك رافضة لكلّ
.شيء قد أصبح عادة

148
00:07:31,510 --> 00:07:33,050
...بما أنّك ذكرت الأمر الآن

149
00:07:33,050 --> 00:07:36,660
.كلاّ، أنا لا أتّهمك بأيّ شيء

150
00:07:36,660 --> 00:07:42,020
صحيح. لماذا لا تسمحين لحدسك
بالحديث عنك وكوني أكثر انفتاحًا؟

151
00:07:42,020 --> 00:07:42,980
حدسي؟

152
00:07:42,980 --> 00:07:44,300
.نعم

153
00:07:44,300 --> 00:07:47,370
في نظري، أنت ترتدين درعًا
في السّرّاء والضّرّاء ممّا يشير إلى أنّ

154
00:07:47,370 --> 00:07:51,900
".هذه تيندو كارين المثاليّة"

155
00:07:52,910 --> 00:07:54,210
،حتّى في محادثاتك اليوميّة

156
00:07:54,210 --> 00:07:55,910
،يبدو أنّك تتعاملين معهم من وراء درعك أوّلاً

157
00:07:55,910 --> 00:07:59,960
.ثمّ تفكّرين بالأمر داخليًّا لاحقًا

158
00:07:59,960 --> 00:08:02,240
...ليتك تستطيعين القيام بالأمر بالعكس

159
00:08:02,240 --> 00:08:05,580
بعبارات أخرى، تقول أنّ عليّ
،الحديث بانفتاح أكثر

160
00:08:05,580 --> 00:08:09,420
وبعدها أحاول تليين الوضع
وشرح ما أرغبه بعد ذلك؟

161
00:08:09,420 --> 00:08:10,660
.بالفعل

162
00:08:10,660 --> 00:08:13,660
.أعتقد أنّ هذا سيكون مناسبًا لك

163
00:08:13,660 --> 00:08:14,930
.فهمت

164
00:08:14,930 --> 00:08:19,680
وإلاّ، ما كنتُ لأراك تقلّلين المسافة
.بينك وبين أمانو-كُن أبدًا

165
00:08:20,010 --> 00:08:20,940
ماذا قلت؟

166
00:08:20,940 --> 00:08:23,130
.لا شيء

167
00:08:23,130 --> 00:08:24,410
.معك حقّ

168
00:08:24,410 --> 00:08:29,200
عليّ أن أكون منفتحة أكثر، وأكفّ
.عن رفض كلّ شيء من البداية

169
00:08:29,200 --> 00:08:34,390
...أكفّ عن كوني رافضة

170
00:08:34,390 --> 00:08:36,870
...أكفّ... أكفّ... أكفّ

171
00:08:38,460 --> 00:08:40,210
!انظروا! إنّها ممتازة

172
00:08:40,210 --> 00:08:42,150
.لنستمتع معًا

173
00:08:42,150 --> 00:08:44,540
.لست مهتمّة بكم

174
00:08:44,540 --> 00:08:46,340
.لنذهب يا كيتا

175
00:08:47,890 --> 00:08:50,340
.سُحقًا، يا لها من حقيرة

176
00:08:50,340 --> 00:08:51,880
!تعالي إلى هنا فحسب

177
00:09:04,410 --> 00:09:06,560
...كـ-كيتا

178
00:09:06,560 --> 00:09:08,770
!يا له من خاسر

179
00:09:08,770 --> 00:09:10,100
.لنذهب

180
00:09:12,170 --> 00:09:13,170
...كيتا

181
00:09:20,340 --> 00:09:21,730
!هذه عاشر محاولة لي

182
00:09:21,730 --> 00:09:25,120
!جرّبت خيارات كثيرة

183
00:09:26,850 --> 00:09:33,060
ربّما هذه إشارة لي بأنّي غير متوافق
.من الأساس مع شخص مثل تيندو-سان

184
00:09:38,070 --> 00:09:41,630
!عليك أن تنام من أجل الغد يا أمانو-تشي

185
00:09:42,300 --> 00:09:46,580
!يحكم عليك النّاس حسب حالة بشرتك كما تعلم

186
00:09:47,130 --> 00:09:50,650
!لا تجرؤ على السّهر وأنت تلعب

187
00:09:51,150 --> 00:09:54,020
!لا، حتّى أنت لست بذلك الغباء

188
00:09:54,020 --> 00:09:55,360
!آسفة، تصبح على خير

189
00:09:55,360 --> 00:09:57,860
!أنا جدّ آسف

190
00:09:57,860 --> 00:10:02,250
.يا أمانو، سمعتُ أنّك ستلتقي بتيندو غدًا

191
00:10:02,250 --> 00:10:05,370
.سأحضر المزيد من الأشخاص من أجلك

192
00:10:05,820 --> 00:10:08,590
.لنضعك أمام الجميع عندما تقوم بذلك

193
00:10:08,590 --> 00:10:11,610
.سوف تحصل على  بعض الاحترام أخيرًا

194
00:10:11,610 --> 00:10:14,140
.رغم أنّه سيتمّ تجنّبك إن أخفقت

195
00:10:14,140 --> 00:10:15,880
!اغرب أنت و"هههه" خاصّتك

196
00:10:23,900 --> 00:10:28,900
لا يجب أن أكون فظًّا مع شخص
.يقوم بالكثير من أجلي

197
00:10:31,660 --> 00:10:34,690
.هذا بشأن حدث الصيد غدًا

198
00:10:35,580 --> 00:10:39,660
.لا بدّ أن مونو-سان خجولة وغريبة

199
00:10:41,010 --> 00:10:45,070
.شكرًا يا أغوري-سان وأويهارا-كُن ومونو-سان

200
00:10:45,070 --> 00:10:48,150
.أعتقد أنّي ما زلت قادرًا على القتال

201
00:10:48,150 --> 00:10:49,490
.تحميل اللّعبة

202
00:10:56,060 --> 00:11:02,180
أتساءل إن كان عليّ أن أكون لطيفًا مع كلّ
.فتاة في اللّعبة، وليس مع فلورا فحسب

203
00:11:02,180 --> 00:11:06,520
لا يُفترض جعل الجميع سعداء
...في ألعاب محاكاة المواعدة، ولكن

204
00:11:14,820 --> 00:11:18,840
...منذ أوّل مرّة رأيتك فيها قبل 10 سنوات

205
00:11:19,380 --> 00:11:20,570
ماذا؟

206
00:11:20,570 --> 00:11:23,070
مستحيل. هل هذا يحدث؟

207
00:11:23,070 --> 00:11:27,080
!كنتُ في انتظارك لتقول ذلك

208
00:11:27,120 --> 00:11:30,120
!أحبّك

209
00:11:32,660 --> 00:11:36,170
!بطلي لطيف مع الجميع

210
00:11:37,510 --> 00:11:40,630
.أنهيتُ اللّعبة أخيرًا

211
00:11:40,630 --> 00:11:42,160
.فهمت

212
00:11:42,160 --> 00:11:47,650
مهما حدث، لا يجب معاملة النّاس
.معاملة سيّئة إن عاملوني بشكل جيّد

213
00:11:49,670 --> 00:11:53,500
،كلّ هذا بفضل أغوري-سان وأويهارا-كُن
.ومونو-سان أيضًا

214
00:11:54,100 --> 00:11:56,430
!شكرًا لكم يا رفاق

215
00:11:56,430 --> 00:12:02,110
،حتّى إن رفضتني تيندو-سان
.فأنا سعيد سلفًا

216
00:12:13,000 --> 00:12:15,540
!تيندو قادمة لرؤية أمانو؟

217
00:12:15,540 --> 00:12:17,460
هل تعرف شيئًا بشأن ذلك؟

218
00:12:17,460 --> 00:12:19,210
!أويهارا

219
00:12:19,210 --> 00:12:23,470
ما كنتُ لأعرف. فأنا لستُ مقرّبًا
.لتيندو إلى ذلك الحدّ

220
00:12:23,470 --> 00:12:27,290
.رغم أنّه كان أنا من نشر الإشاعة

221
00:12:27,290 --> 00:12:29,470
.وأنا من أصرّ على استدعاء تيندو

222
00:12:32,510 --> 00:12:34,100
.لقد أخبرتك البارحة

223
00:12:34,460 --> 00:12:39,130
أنا أحاول منحك بعض الاحترام عن طريق
.جعلك تقوم بالأمر أمام مجموعة من النّاس

224
00:12:39,130 --> 00:12:43,610
.لا أريد التّقرّب من تيندو-سان لهذا السّبب

225
00:12:44,210 --> 00:12:45,620
أهو غاضب؟

226
00:12:46,660 --> 00:12:50,510
.أنا آسف لأنّي جهّزت للأمر دون أن أسألك

227
00:12:50,510 --> 00:12:52,670
.سألغيه إن لم ترد ذلك

228
00:12:52,670 --> 00:12:58,670
أنا ممتنّ لأنّك تفعل كلّ هذا
...من أجلي، لكن

229
00:13:01,780 --> 00:13:07,390
اسمع يا أمانو، أنا أفعل هذا
.من أجل مستقبلك ايضًا

230
00:13:07,390 --> 00:13:08,510
ما الّذي تعنيه؟

231
00:13:11,770 --> 00:13:13,570
.فكّر في الأمر

232
00:13:13,570 --> 00:13:17,940
.لنقل أنّك وتيندو قد أصبحتما صديقين

233
00:13:17,940 --> 00:13:21,780
ما الّذي سيعتقده النّاس عندما
يرونكما تتمشّيان معًا في الخارج؟

234
00:13:23,780 --> 00:13:24,610
.هذا ما أقصد

235
00:13:25,080 --> 00:13:29,900
لهذا السّبب من الأفضل وجود أناس
.حولك عندما تقدّم طلب الصّداقة

236
00:13:29,900 --> 00:13:33,010
ومن الأفضل أكثر لو كانوا من الثّرثارين غير المسؤولين

237
00:13:33,010 --> 00:13:35,100
.ممّن سينشرون المعلومة سريعًا

238
00:13:35,100 --> 00:13:39,750
ما المكان الّذي يخضع لكلّ هذه
المواصفات والأسهل بالنّسبة لك؟

239
00:13:43,260 --> 00:13:44,710
!القسم 2-ز

240
00:13:44,710 --> 00:13:48,130
بعد المدرسة مباشرة، عندما يكون هنالك
!الكثير من النّاس والكثير من الوقت

241
00:13:48,130 --> 00:13:50,140
.هذا هو المطلوب

242
00:13:50,140 --> 00:13:51,860
!أنت رائع يا أويهارا-كُن

243
00:13:51,860 --> 00:13:53,210
.أنت مذهل

244
00:13:53,210 --> 00:13:55,560
.أنا آسف. كنت أحمقًا

245
00:13:57,020 --> 00:14:00,170
،أساس هذه المتّجهة، أ ب، يسمّى نقطة البداية

246
00:13:59,930 --> 00:14:02,410
.أمانو-تشي معجب بتيندو-سان

247
00:14:00,170 --> 00:14:02,870
.ويسمّى السّهم بنقطة النّهاية

248
00:14:02,410 --> 00:14:04,390
.إنّه منجذب لها

249
00:14:04,390 --> 00:14:07,370
تعتقد تيندو-سان أنّه عاديّ؟

250
00:14:07,370 --> 00:14:09,800
.لا أعتقد أنّها تكرهه

251
00:14:09,800 --> 00:14:12,050
.أنا وأمانو-تشي صديقين

252
00:14:12,050 --> 00:14:13,780
!أنا معجبة بتاسكو

253
00:14:13,780 --> 00:14:15,270
.بل أحبّه

254
00:14:16,030 --> 00:14:18,500
...تاسكو وتيندو-سان

255
00:14:18,500 --> 00:14:20,620
ربّما هو معجب بها؟

256
00:14:24,530 --> 00:14:26,610
.لا تبكي يا أغوري

257
00:14:26,610 --> 00:14:28,500
!أنت فتاة قويّة

258
00:14:28,500 --> 00:14:31,780
.والآن، تكمن المشكلة مع هذه الفتاة

259
00:14:32,410 --> 00:14:38,750
،قال أمانو-تشي أنّه يكرهها
.لكن واضح أنّهما قريبان من بعضهما

260
00:14:39,440 --> 00:14:43,370
.وواضح أنّها مهتمّة بتاسكو

261
00:14:43,370 --> 00:14:46,190
...وتاسكو

262
00:14:50,340 --> 00:14:52,490
.حسنًا، سأكتبها

263
00:14:59,500 --> 00:15:01,040
!لماذا هذا صعب للغاية؟

264
00:15:01,040 --> 00:15:05,440
كانت هوشينوموري تشبهني كثيرًا عندما
!كنتُ خجولة ومنعزلة. لا أتحمّل هذا

265
00:15:05,440 --> 00:15:07,000
!وجدتُها

266
00:15:07,000 --> 00:15:09,590
.حدثُ أمانو-تشي لطلب الصّداقة بعد المدرسة

267
00:15:09,590 --> 00:15:11,850
!سأكتشف مشاعر تاسكو حينها

268
00:15:11,850 --> 00:15:12,720
.نعم

269
00:15:13,340 --> 00:15:15,590
سيتحدّث كيتا مع تيندو-سان بعد المدرسة؟

270
00:15:15,590 --> 00:15:17,220
بشأن ماذا؟

271
00:15:17,530 --> 00:15:22,520
ألا يملك كيتا حبيبة تُدعى أغوري-سان؟

272
00:15:23,930 --> 00:15:30,780
بالتّفكير بالأمر، سمعت إشاعات أنّ أغوري-سان
.على علاقة بأويهارا-سان

273
00:15:31,690 --> 00:15:36,160
ماذا لو، ماذا لو كان حبّ كيتا
لأغوري-سان غير متبادل؟

274
00:15:37,550 --> 00:15:38,420
!أجل

275
00:15:38,420 --> 00:15:41,150
!تتلاعب أغوري-سان بكيتا

276
00:15:41,150 --> 00:15:41,890
،وإلاّ

277
00:15:41,890 --> 00:15:45,440
من المستحيل أن يلتقي بتيندو-سان
!بينما أغوري-سان حبيبته سلفًا

278
00:15:45,440 --> 00:15:47,530
...لا يمكن إلاّ أن يكون الأمر

279
00:15:47,530 --> 00:15:48,440
!من أجل المال

280
00:15:48,440 --> 00:15:52,280
لا بدّ أنّ كيتا يدفع ثمن كلّ زياراتها
!لصالة الألعاب والشّاي

281
00:15:52,770 --> 00:15:55,510
!هنالك فتاة راضية بالحياة الحقيقيّة تتلاعب به

282
00:15:55,510 --> 00:16:00,230
نحن متشابهان. عليّ أن أساعده
.ليستفيق من غفلته

283
00:16:02,230 --> 00:16:06,900
أكره استعمال أمانو هكذا، لكن ما
!أخبرته لم يكن السّبب الحقيقيّ

284
00:16:07,500 --> 00:16:10,470
.ستأتي أغوري بلا أدنى شكّ لمشاهدة الحدث اليوم

285
00:16:10,470 --> 00:16:14,860
سوف أختبئ بين الحشود وأشاهد
.عن كثب ردّة فعل أغوري

286
00:16:14,860 --> 00:16:19,260
!حبيبتي الّتي يبدو أنّها تواعد أمانو

287
00:16:22,060 --> 00:16:24,380
،لن تتوقّع أبدًا أنّ هنالك من يشاهدها

288
00:16:24,380 --> 00:16:28,000
.بينما انتباه الجميع منصبّ على تيندو وأمانو

289
00:16:28,460 --> 00:16:31,210
،إن كان أمانو صديقًا فحسب لأغوري

290
00:16:31,210 --> 00:16:34,900
فعليها أن تكون سعيدة لرؤيته
.يصبح صديقًا لتيندو

291
00:16:34,900 --> 00:16:40,470
ولكن، إن أظهرت أغوري ولو تلميحًا
...عن خيبة الأمل

292
00:16:40,470 --> 00:16:43,730
!فستُقفل القضيّة، وسأكتشف خيانتها

293
00:16:46,940 --> 00:16:49,740
،إن كان تاسكو معجبًا بتيندو-سان فعلاً

294
00:16:49,740 --> 00:16:53,530
فلن يكون سعيدًا برؤيتها تصبح
.صديقة لأمانو-تشي

295
00:16:53,530 --> 00:16:56,490
.سيظهر ذلك على وجهه

296
00:16:56,490 --> 00:17:00,950
وإن كان اهتمامه الحقيقيّ منصبّ
.على هوشينوموري-سان، فسينظر إليها

297
00:17:01,320 --> 00:17:06,080
.سيكون قلقًا من رأي هوشينوموري-سان عن أمانو-تشي

298
00:17:08,970 --> 00:17:15,260
ممّا يعني أنّ طلب صداقة كيتا
.من تيندو-سان هو نداء استغاثته

299
00:17:15,260 --> 00:17:20,140
!لا يملك كيتا الشّجاعة ليهجر أغوري-سان

300
00:17:20,810 --> 00:17:21,930
!فهمت الأمر

301
00:17:21,930 --> 00:17:23,430
!فهمت يا كيتا

302
00:17:23,930 --> 00:17:28,380
سوف أسرع إلى الفصل ز بعد المدرسة
اليوم لأتحقّق من رسالتك

303
00:17:28,380 --> 00:17:30,630
.وأكتشف حقيقة تلك الشّيطانة الصّغيرة

304
00:17:35,230 --> 00:17:36,330
.لكن مهلاً لحظة

305
00:17:36,780 --> 00:17:42,660
،إن كانت أغوري تواعد أمانو فعلاً
.فسيكون هذا الحدث مجرّد تمثيل

306
00:17:43,040 --> 00:17:48,920
إذًا ماذا لو رأيتُ أغوري تنظر إليّ
بشكل مذنب كحبيبها؟

307
00:17:48,920 --> 00:17:52,000
!سيكون ذلك أسوأ وضع

308
00:17:53,090 --> 00:17:56,950
.رغم أنّي لا أعتقد أنّ الأمور ستسوء لذلك الحدّ

309
00:18:00,780 --> 00:18:04,560
لكن ماذا إن نظر تاسكو ليرى ردّة فعلي؟

310
00:18:04,560 --> 00:18:05,690
.بلع

311
00:18:06,560 --> 00:18:10,440
...النّظر إلى حبيبته في تجمّع للخائنين

312
00:18:10,810 --> 00:18:13,730
.هو أمر سيفعله متلاعب بالفعل

313
00:18:13,730 --> 00:18:17,860
.رغم اعتقادي أنّ تاسكو لن يكون بذلك السّوء

314
00:18:19,780 --> 00:18:22,660
!يا لذكائي

315
00:18:22,660 --> 00:18:26,000
.أنا أخشى ذكائي الخاصّ

316
00:18:26,490 --> 00:18:28,620
...لكن، ماذا لو

317
00:18:28,620 --> 00:18:32,500
ماذا لو نظر أويهارا-سان وأغوري سان
إلى بعضهما بنظرة ذنب؟

318
00:18:32,830 --> 00:18:34,790
،إن كانت علاقتهما جيّدة

319
00:18:34,790 --> 00:18:39,130
.فسوف يفزعان من إشارة استغاثة كيتا

320
00:18:41,350 --> 00:18:46,170
أ-أعتقد أنّ الأمور لن تسوء أكثر، صحيح؟

321
00:18:47,020 --> 00:18:48,140
...في كلّ الأحوال

322
00:18:48,140 --> 00:18:49,810
...حدثُ ما بعد المدرسة

323
00:18:49,810 --> 00:18:51,440
.سيشكّل نهاية كلّ شيء

324
00:19:00,060 --> 00:19:01,580
!ما زلت لا أفهم

325
00:19:01,580 --> 00:19:04,120
لماذا قد يرغب أمانو برؤيتي بعد المدرسة؟

326
00:19:05,020 --> 00:19:09,870
بصراحة، أفضل تفسير ممكن
.هو أنّه يريد إنهاء صداقتنا

327
00:19:11,340 --> 00:19:14,160
.يريد أن يلعب بسلام فحسب

328
00:19:14,160 --> 00:19:18,010
.علاقته بي ما هي إلاّ مشكلة بالنّسبة له

329
00:19:18,710 --> 00:19:20,730
.أمانو-كُن خجول

330
00:19:20,730 --> 00:19:24,640
ربّما لم يحبّ كل ذلك الاهتمام
.الّذي حصل عليه من مضايقتي له

331
00:19:25,220 --> 00:19:26,890
.تشجّعي يا تيندو كارين

332
00:19:27,280 --> 00:19:31,640
،حتّى إن واجهت وضعًا غير ملائم

333
00:19:31,640 --> 00:19:35,360
.فسأتصرّف بكلّ كرامة وصراحة

334
00:19:42,140 --> 00:19:44,030
!هجوم

335
00:19:46,940 --> 00:19:49,560
.سوف أتحضّر للأسوأ فحسب

336
00:19:49,560 --> 00:19:53,150
.سأردّ على ما سيقوله بشكل منفتح وصريح

337
00:19:54,040 --> 00:19:56,990
.أوّلاً، سأستمع بانتباه لكلامه

338
00:19:56,990 --> 00:20:02,980
،لا حاجة لأكون رافضة
.عليّ إخباره بما أشعر به فحسب

339
00:20:02,980 --> 00:20:05,560
.سألتقي أمانو-كُن وجهًا لوجه

340
00:20:05,560 --> 00:20:06,750
.هذا كلّ شيء

341
00:20:13,890 --> 00:20:14,560
!حسنًا

342
00:20:14,560 --> 00:20:16,020
.المعذرة

343
00:20:16,020 --> 00:20:17,620
هل أمانو-كُن هنا؟

344
00:20:17,620 --> 00:20:18,650
!وصلت

345
00:20:18,650 --> 00:20:19,890
!وصلت بالفعل

346
00:20:21,180 --> 00:20:22,340
!أنا هنا

347
00:20:22,340 --> 00:20:23,450
.حظًّا سعيدًا

348
00:20:23,930 --> 00:20:25,530
!أويهارا-كُن

349
00:20:28,900 --> 00:20:30,330
!أغوري-سان

350
00:20:31,230 --> 00:20:32,830
!تشياكي

351
00:20:32,830 --> 00:20:35,070
.الجميع هنا

352
00:20:35,070 --> 00:20:36,650
.مرحبًا يا أمانو-كُن

353
00:20:42,630 --> 00:20:44,520
.مرحبًا يا تيندو-سان

354
00:20:44,520 --> 00:20:46,300
.شكرًا لمجيئك إلى هنا اليوم

355
00:20:46,300 --> 00:20:48,170
.لا مشكلة

356
00:20:48,700 --> 00:20:52,250
إذًا ما الّذي أردت قوله لي اليوم؟

357
00:20:52,250 --> 00:20:55,550
...نعم، بشأن ذلك

358
00:20:56,900 --> 00:20:59,190
...أ... أنا

359
00:20:59,190 --> 00:21:02,170
...ليس من السّهل قول هذا، ولكن

360
00:21:02,940 --> 00:21:04,030
ما الخطب؟

361
00:21:04,030 --> 00:21:06,110
.لا شيء. لا تقلق

362
00:21:06,580 --> 00:21:07,820
.واصل يا أمانو-كُن

363
00:21:08,260 --> 00:21:09,700
.أنا جاهزة

364
00:21:12,060 --> 00:21:13,530
جاهزة؟

365
00:21:13,530 --> 00:21:16,330
.سأقدّم لها طلب صداقة فحسب

366
00:21:16,990 --> 00:21:19,210
!بالطّبع! إنّها جاهزة لرفضي

367
00:21:20,220 --> 00:21:21,350
...عفوًا

368
00:21:21,350 --> 00:21:22,930
هل من خطب ما؟

369
00:21:23,610 --> 00:21:25,250
.لا، لا شيء

370
00:21:26,090 --> 00:21:30,350
.كلاّ، يتفادى أويهارا-كُن النّظر إليّ بكلّ وضوح

371
00:21:34,250 --> 00:21:36,380
يا أمانو-كُن؟

372
00:21:36,380 --> 00:21:37,370
.فهمت

373
00:21:37,370 --> 00:21:39,810
.إنّهم يحرصون على ألاّ يروني أهزم شرّ هزيمة

374
00:21:39,810 --> 00:21:41,940
.إنّهم يراعون مشاعري

375
00:21:42,790 --> 00:21:43,840
.نعم

376
00:21:43,840 --> 00:21:48,330
،حتّى إن رفضت تيندو-سان طلبي
.فما يزال لديّ أصدقاء

377
00:21:48,330 --> 00:21:50,670
.أنا غارق في السّعادة سلفًا

378
00:21:57,670 --> 00:21:59,960
...تيندو-سان، أنا

379
00:22:01,840 --> 00:22:06,170
!أغوري تحدّق بي وهي تبدو مذنبة تمامًا

380
00:22:06,170 --> 00:22:09,410
،هذا هو الوضع الّذي يثبت أنّها مع أمانو

381
00:22:09,410 --> 00:22:14,680
!وتشعر بالذّنب بسبب هذه التّمثيليّة

382
00:22:14,680 --> 00:22:16,560
...تيندو-سان، أنا

383
00:22:18,230 --> 00:22:22,480
!تاسكو يحدّق بي وهو يبدو مذنبًا تمامًا

384
00:22:22,480 --> 00:22:26,220
وهذا يعني أنّ تاسكو كان متلاعبًا
.حقيرًا طوال الوقت

385
00:22:26,220 --> 00:22:31,620
.هذا يعني أنّه يخطّط للخيانة في السّرّ

386
00:22:31,620 --> 00:22:33,490
...تيندو-سان، أنا

387
00:22:35,370 --> 00:22:40,500
،أويهارا-سان وأغوري-سان يحدّقان ببعضهما
!وكلاهما يبدو مذنبًا تمامًا

388
00:22:40,500 --> 00:22:43,980
ممّا يعني أنّ أويهارا-سان وأغوري-سان
،على علاقة ببعضهما

389
00:22:43,980 --> 00:22:48,510
!وهما مرتعبان ممّا قد يقوله كيتا

390
00:22:48,510 --> 00:22:50,390
...تيندو-سان، أنا

391
00:22:50,390 --> 00:22:52,760
.أوّلاً، استمعي له وكوني منفتحة

392
00:22:52,760 --> 00:22:55,850
.لا تقومي بالرّفض من البداية

393
00:22:55,850 --> 00:23:02,010
هذه ليست الطّريقة الاعتياديّة
.الّتي أرفض بها الاعترافات

394
00:23:02,010 --> 00:23:06,630
.حتّى إن رُفضت، سأكون منفتحة تمامًا

395
00:23:07,340 --> 00:23:10,860
.لديّ مسؤوليّة الرّدّ بما أشعر به بالفعل

396
00:23:12,870 --> 00:23:14,740
...تيندو-سان، أنا

397
00:23:15,310 --> 00:23:17,370
،بمجرّد أن بدأت تلك الجملة

398
00:23:17,370 --> 00:23:22,000
أحداث الأيّام الأخيرة العديدة مرّت
.أمام ناظريّ بسرعة

399
00:23:25,800 --> 00:23:27,380
!أرجوك، واعديني

400
00:23:27,380 --> 00:23:29,090
.نعم، بكلّ سرور

401
00:23:32,470 --> 00:23:34,770
هل أخطأت فيما أريد قوله؟

402
00:23:44,270 --> 00:23:48,030
...يُتبع