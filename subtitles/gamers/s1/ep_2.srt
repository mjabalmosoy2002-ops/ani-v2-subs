1
00:00:01,290 --> 00:00:03,740
.أنت لا شيء لي

2
00:00:03,740 --> 00:00:05,660
.أنت سيّئ في الألعاب

3
00:00:05,660 --> 00:00:08,980
...كما لم أستمتع بقضاء الوقت معك

4
00:00:09,300 --> 00:00:12,280
.واصلي عملك الجادّ في نادي الألعاب

5
00:00:12,280 --> 00:00:13,240
.أنا أشجّعك

6
00:00:15,320 --> 00:00:16,700
.نعم، معك حقّ

7
00:00:26,550 --> 00:00:28,000
ما كان ذلك؟

8
00:02:03,640 --> 00:02:04,520
ماذا هنالك؟

9
00:02:04,520 --> 00:02:06,020
هل كانت تيندو-سان تبكي؟

10
00:02:06,020 --> 00:02:08,020
هل هي مشاكل علاقة بينهما أو ما شابه؟

11
00:02:08,390 --> 00:02:11,360
لكن ألم يكونا يتحدّثان عن نادٍ ما؟

12
00:02:11,690 --> 00:02:15,030
إن ساورك الفضول، لماذا لا تسألين
أمانو عمّاذا كانا يتحدّثان؟

13
00:02:15,030 --> 00:02:16,150
أنا؟

14
00:02:16,150 --> 00:02:17,990
.لا داعي لذلك

15
00:02:18,320 --> 00:02:20,740
من المستحيل أن نستطيع إجراء
.محادثة مع ذلك الفتى

16
00:02:20,740 --> 00:02:22,200
.هذا صحيح

17
00:02:23,780 --> 00:02:26,250
ما قصّتك يا هذا؟

18
00:02:28,040 --> 00:02:31,210
لكن ألم يكن ذلك محبطًا؟

19
00:02:32,250 --> 00:02:37,880
،لا، لا. ليس لأيّ سبب وجيه
.لكنّه يبدو مغرورًا نوعًا ما

20
00:02:37,880 --> 00:02:41,090
.إنّه يبدو متفاخرًا بنفسه قليلاً بالفعل

21
00:02:41,090 --> 00:02:43,800
.إنّه لا يستحقّ شيئًا، لكنّه متكبّر

22
00:02:43,800 --> 00:02:45,720
.عليه حقًّا أن يعرف مكانته

23
00:02:45,720 --> 00:02:46,850
نعم، أليس كذلك؟

24
00:02:47,560 --> 00:02:48,600
.تافه

25
00:02:49,730 --> 00:02:54,980
.لا، أعني أنّ حياته تبدو تافهة

26
00:02:54,980 --> 00:02:56,480
.هذا ما قصدتَه

27
00:02:56,480 --> 00:02:59,610
.لقد أخفتني. ظننتُك فقدت رشدك

28
00:03:00,070 --> 00:03:02,490
.لا، لا. لا شيء من ذلك

29
00:03:05,990 --> 00:03:07,870
،بخصوص الأفعال المساعِدة

30
00:03:08,580 --> 00:03:13,710
.من المهمّ فهم كيف تُستعمل أدوات الرّبط

31
00:03:14,080 --> 00:03:18,590
بعبارات أخرى، ما الّذي يلي الأفعال المساعِدة؟

32
00:03:16,340 --> 00:03:17,880
.سُحقًا له

33
00:03:19,760 --> 00:03:21,720
!تاسكو

34
00:03:21,720 --> 00:03:23,590
!لنأكل معًا

35
00:03:25,930 --> 00:03:28,220
!حان الوقت للشّحن بقوّة تاسكو

36
00:03:28,220 --> 00:03:31,190
.أنت معجبة حقًّا بأويهارا

37
00:03:32,730 --> 00:03:35,440
.أعددت الغداء اليوم

38
00:03:35,940 --> 00:03:36,770
!تفضّل

39
00:03:36,770 --> 00:03:38,190
.إنّها قطّة ظريفة

40
00:03:42,320 --> 00:03:45,620
!لقد تبعثرت بالكامل

41
00:03:46,780 --> 00:03:50,870
أخبرني، ذلك المغفّل أمانو
يدرس في فصلك، صحيح؟

42
00:03:50,870 --> 00:03:51,580
.نعم

43
00:03:51,580 --> 00:03:54,580
.يتحدّث الجميع عنه في الفصل ج

44
00:03:54,580 --> 00:03:57,750
يتحدّثون عن أمر بخصوص رفضه
.لتيندو-سان المشهورة

45
00:03:57,750 --> 00:03:58,670
فعلاً؟

46
00:03:58,670 --> 00:04:00,010
لستَ متفاجئًا؟

47
00:04:00,010 --> 00:04:02,300
هل أنتما تتواعدان أصلاً؟

48
00:04:02,300 --> 00:04:04,130
تظنّين ذلك؟

49
00:04:04,130 --> 00:04:05,970
.أعتقد أنّ ذلك طبيعيّ للغاية

50
00:04:14,730 --> 00:04:19,110
.أنا فقط لم أمتلك يومًا سببًا لأرفض

51
00:04:19,110 --> 00:04:22,240
.ذلك لا يهمّ ما دمتُ أحبّ تاسكو

52
00:04:22,240 --> 00:04:22,820
.أكيد

53
00:04:22,820 --> 00:04:25,610
فعلاً؟ أنت سعيدة بذلك؟

54
00:04:25,610 --> 00:04:29,620
.لا أهتمّ. أنا سعيدة ما دمنا معًا

55
00:04:31,040 --> 00:04:33,000
هل تعتقدون أنّنا سنتّسع هنا جميعًا؟

56
00:04:33,000 --> 00:04:35,960
ليس لديّ مال. هل يمكنك تولّي الأمر يا ماسايا؟

57
00:04:35,960 --> 00:04:37,960
سأدفع أنا ثانية؟

58
00:04:38,630 --> 00:04:39,500
تاسكو؟

59
00:04:39,500 --> 00:04:41,670
.أعتقد أنّ ثمّة الكثير منكم هناك سلفًا

60
00:04:42,380 --> 00:04:44,510
.تعال يا تاسكو وانضمّ لنا

61
00:04:44,510 --> 00:04:45,800
.سأذهب للحمّام

62
00:05:09,240 --> 00:05:10,830
.كفاك تحديقًا

63
00:05:23,050 --> 00:05:23,960
!أجل

64
00:05:25,420 --> 00:05:26,630
.سُحقًا

65
00:05:26,630 --> 00:05:29,010
متى ستكفّ هذه الرّؤى عن مراودتي؟

66
00:05:30,140 --> 00:05:31,600
!مهلاً، هذا أنت

67
00:05:34,060 --> 00:05:35,850
...المعذرة

68
00:05:35,850 --> 00:05:37,060
.أنا أمانو

69
00:05:37,060 --> 00:05:38,310
.أنا في فصلك

70
00:05:38,310 --> 00:05:40,270
.أعلم، أعلم

71
00:05:40,270 --> 00:05:41,770
حسنًا، ماذا هنالك؟

72
00:05:42,110 --> 00:05:45,900
المعذرة، هل تحبّ الألعاب يا أويهارا-كُن؟

73
00:05:48,570 --> 00:05:50,740
.لم أفكّر في الأمر من قبل

74
00:05:53,580 --> 00:05:54,750
...هذه اللّعبة

75
00:05:54,750 --> 00:05:55,910
!دعني أرى

76
00:05:57,080 --> 00:05:59,630
لم ألعبها من قبل، لكنّها مشهورة، صحيح؟

77
00:06:00,040 --> 00:06:01,790
."نسخة من الخيال"

78
00:06:02,590 --> 00:06:04,050
!هذه تحفة فنّيّة

79
00:06:04,050 --> 00:06:06,880
.عليك أن تلعبها بكلّ تأكيد إن كنت لم تلعبها بعد

80
00:06:06,880 --> 00:06:08,880
هـ-هكذا إذًا؟

81
00:06:08,880 --> 00:06:09,550
.نعم

82
00:06:09,550 --> 00:06:13,510
لقد قدّموا اللّعبة بغرض إحداث ثورة
،في مفهوم الألعاب الإلكترونيّة

83
00:06:13,510 --> 00:06:15,470
،لكن تبيّن أنّها لعبة تقليديّة للغاية

84
00:06:15,470 --> 00:06:18,350
،لذلك انتُقدت كثيرًا في حينها
.لكنّها متقنة بالفعل

85
00:06:18,350 --> 00:06:20,310
.أنا أوصي بها بكلّ صدق

86
00:06:21,110 --> 00:06:24,270
.حسنًا، لا أحتاج لتوصياتك

87
00:06:26,530 --> 00:06:29,240
.آسف، لقد تحمّست قليلاً

88
00:06:29,240 --> 00:06:31,240
.لا داعي لتعتذر

89
00:06:32,410 --> 00:06:34,830
.حـ-حسنًا، سوف أغادر الآن

90
00:06:48,880 --> 00:06:51,300
ما الّذي يفعله؟

91
00:06:57,310 --> 00:07:01,310
لا يعقل أنّه لا يأتي لصالات اللّعب
.رغم أنّه يحبّ الألعاب

92
00:07:04,360 --> 00:07:05,940
.مهلاً، مهلاً، مهلاً

93
00:07:06,940 --> 00:07:07,990
أويهارا-كُن؟

94
00:07:09,610 --> 00:07:11,700
.تعال معي لبعض الوقت

95
00:07:12,660 --> 00:07:14,700
!أنا لا أهتمّ بالرّجال

96
00:07:14,700 --> 00:07:16,950
لا داعي لردّة الفعل المبتذلة هذه، مفهوم؟

97
00:07:17,290 --> 00:07:18,500
ما قولك؟

98
00:07:18,500 --> 00:07:20,910
هل سنلعب أم لا؟

99
00:07:22,170 --> 00:07:24,670
!أرجوك! سأكون سعيدًا بذلك

100
00:07:26,800 --> 00:07:29,010
هل هذه هي اللّعبة الّتي أردتَ لعبها؟

101
00:07:29,010 --> 00:07:29,840
.نعم

102
00:07:29,840 --> 00:07:33,340
،لطالما أحببت هذه اللّعبة
.وكنت أرغب في لعبها

103
00:07:35,260 --> 00:07:36,890
.كنت هنا من قبل أيضًا

104
00:07:36,890 --> 00:07:40,020
لكن راودني شعور سيّئ بتضييعي للوقت
.في مشاهدة اللّعب التّجريبيّة وما شابه

105
00:07:40,350 --> 00:07:43,810
إذًا فقد عدتَ للمنزل دون القيام بشيء؟

106
00:07:43,810 --> 00:07:46,150
.أظنّ ذلك

107
00:07:46,150 --> 00:07:48,610
ما مدى تساهلك يا ترى؟

108
00:07:48,610 --> 00:07:52,110
لا أصدّق أنّه الفتى الّذي رفض
.تيندو-سان مباشرة

109
00:07:53,200 --> 00:07:57,120
أمانو، هل أنت على علاقة بتيندو؟

110
00:07:57,490 --> 00:08:01,620
صحيح... لقد رأيتَ ذلك؟

111
00:08:01,620 --> 00:08:04,420
.لا داعي لإجابتي إن كنت لا تريد ذلك

112
00:08:05,420 --> 00:08:07,920
...في الحقيقة

113
00:08:10,460 --> 00:08:12,420
!كلاّ، هذا مضحك للغاية

114
00:08:12,420 --> 00:08:13,590
.هذا كثير جدًّا

115
00:08:13,930 --> 00:08:18,060
.عد يا تاسكو وإلاّ ذهبتُ للمنزل

116
00:08:22,730 --> 00:08:24,310
من هذه؟

117
00:08:26,060 --> 00:08:27,860
نادي ألعاب؟

118
00:08:27,860 --> 00:08:29,900
.لم أعلم بوجود نادٍ كهذا

119
00:08:29,900 --> 00:08:30,690
.نعم

120
00:08:31,440 --> 00:08:37,200
ما لا أفهمه هو كيف كانت الألعاب في النّادي
مختلفة عن الألعاب الّتي أردتَ لعبها؟

121
00:08:37,200 --> 00:08:43,250
.إنّها... لا أدري. يصعب شرح الأمر

122
00:08:43,830 --> 00:08:47,130
أردت أصدقاءً لتحدّثهم عن الألعاب، صحيح؟

123
00:08:47,130 --> 00:08:49,130
...نـ-نعم، ولكن

124
00:08:51,050 --> 00:08:52,460
.تمالك نفسك

125
00:08:53,050 --> 00:08:55,510
.إنّها شاغرة يا أويهارا-كُن

126
00:08:58,010 --> 00:09:00,100
ألا تريد أن تأخذ وقتك في مشاهدة الفيديوهات؟

127
00:09:00,100 --> 00:09:02,310
!لا بأس. لنلعب

128
00:09:02,310 --> 00:09:03,730
.حسنًا

129
00:09:03,730 --> 00:09:05,730
.سوف أسحرك بمواهبي

130
00:09:05,730 --> 00:09:07,100
.حسنًا. تساهل معي رجاءً

131
00:09:08,560 --> 00:09:09,820
.إنّه يشوّش تفكيري

132
00:09:13,240 --> 00:09:15,530
يلعب أمانو بالشّخصيّة الرّئيسيّة إذًا؟

133
00:09:17,910 --> 00:09:20,370
أويهارا-كُن، هل لعبتَ هذه اللّعبة من قبل؟

134
00:09:20,370 --> 00:09:23,330
.لا، اخترتُ الشّخصيّة الّتي تبدو رائعة فحسب

135
00:09:23,330 --> 00:09:24,450
فعلاً؟

136
00:09:35,380 --> 00:09:37,510
.لم أتفاجأ، إنّه أفضل من أغوري

137
00:09:37,510 --> 00:09:39,220
.إنّها تضغط الأزرار بعشوائيّة فحسب

138
00:09:39,220 --> 00:09:41,470
!هيّا، هيّا، هيّا

139
00:09:41,810 --> 00:09:46,770
.لكنّ اللاّعبين مثل أمانو يسهل فهمهم

140
00:09:46,770 --> 00:09:47,890
...أعني

141
00:10:07,660 --> 00:10:09,290
.أنت ممتاز يا أويهارا-كُن

142
00:10:09,630 --> 00:10:11,540
.أنت سيّئ فحسب

143
00:10:13,000 --> 00:10:14,380
.سأفوز هذه المرّة

144
00:10:18,260 --> 00:10:18,970
!بهذه السّرعة؟

145
00:10:18,970 --> 00:10:21,010
!مهلاً... مهلاً لحظة، مهلاً

146
00:10:21,010 --> 00:10:24,310
.إنّها مجرّد لعبة قتاليّة
.لا أدري لماذا يستمتع كثيرًا

147
00:10:33,360 --> 00:10:35,320
!نلتَ منّي ثانية

148
00:10:35,320 --> 00:10:37,900
.أنت سيّئ للغاية في هذا

149
00:10:37,900 --> 00:10:40,860
.حتّى تلاميذ الابتدائيّة أصعب منك

150
00:10:42,660 --> 00:10:44,910
!كان ذلك ممتعًا للغاية يا أويهارا-كُن

151
00:10:44,910 --> 00:10:46,080
.نعم

152
00:10:48,500 --> 00:10:50,710
ماذا سنلعب بعد ذلك؟

153
00:10:52,040 --> 00:10:54,460
لن يكون الأمر ممتعًا إن واصلتُ الفوز، صحيح؟

154
00:10:56,090 --> 00:10:58,380
!نـ-نعم، معك حقّ

155
00:10:58,380 --> 00:11:01,470
!حسنًا، لنلعب هذه إذًا

156
00:11:22,530 --> 00:11:24,620
ماذا سنلعب بعدها؟

157
00:11:24,620 --> 00:11:28,870
تنوي لعب كلّ الألعاب الّتي لم
تستطع لعبها وحدك، صحيح؟

158
00:11:29,370 --> 00:11:31,250
.هـ-هذا ليس صحيحًا

159
00:11:31,250 --> 00:11:34,880
حسنًا، ماذا سنلعب الآن؟

160
00:11:36,590 --> 00:11:37,630
.يا إلهي

161
00:11:38,670 --> 00:11:41,430
...بالتّفكير في الأمر، لقد حدث هذا من قبل

162
00:11:42,800 --> 00:11:43,590
ما كان ذلك؟

163
00:11:47,720 --> 00:11:50,020
ما الّذي تفعله؟

164
00:11:54,190 --> 00:11:56,110
.يا أمانو

165
00:11:58,070 --> 00:11:59,780
...أويهارا-كُن

166
00:12:00,740 --> 00:12:03,530
.نسيت تمامًا

167
00:12:03,530 --> 00:12:04,950
.شكرًا على هذا اليوم

168
00:12:04,950 --> 00:12:06,530
.أ-أراك لاحقًا

169
00:12:06,530 --> 00:12:07,410
!مـ-مهلاً

170
00:12:07,950 --> 00:12:09,290
!تاسكو

171
00:12:09,790 --> 00:12:11,250
!أ-أمانو-كُن

172
00:12:11,250 --> 00:12:13,500
...لم أستسلم بعد عن

173
00:12:14,790 --> 00:12:16,540
.ها أنت ذا

174
00:12:16,540 --> 00:12:18,170
!كنتُ أتّصل بك طوال هذا الوقت

175
00:12:18,170 --> 00:12:19,880
أين كنت؟

176
00:12:21,670 --> 00:12:24,800
.آسف، لم ألاحظ ذلك

177
00:12:27,930 --> 00:12:30,060
.هذا فظيع يا أويهارا

178
00:12:30,060 --> 00:12:32,180
صحيح يا ماسايا، ألم يكن لديك عمل ما؟

179
00:12:32,180 --> 00:12:33,520
!كلاّ! لقد نسيت

180
00:12:33,520 --> 00:12:34,850
.لا فائدة منك

181
00:12:34,850 --> 00:12:37,230
.آسف، عليّ الذّهاب لمكان ما

182
00:12:37,230 --> 00:12:38,190
.سأعود في الحال

183
00:12:38,520 --> 00:12:40,150
!مهلاً يا تاسكو

184
00:12:45,240 --> 00:12:46,410
!سُحقًا

185
00:12:46,700 --> 00:12:48,410
ما الّذي أفعله؟

186
00:13:13,100 --> 00:13:13,980
.ها هو هناك

187
00:13:14,770 --> 00:13:15,850
!أمانو

188
00:13:17,060 --> 00:13:18,650
ما-ماذا؟

189
00:13:18,650 --> 00:13:20,650
ما الخطب يا أويهارا-كُن؟

190
00:13:23,990 --> 00:13:25,450
لماذا هربت؟

191
00:13:26,110 --> 00:13:29,700
.ماذا؟ لم أكن أهرب

192
00:13:29,700 --> 00:13:30,950
!بل هربت

193
00:13:34,790 --> 00:13:36,750
.لم أكن أهرب

194
00:13:36,750 --> 00:13:41,210
ما أعنيه هو لماذا قد تريدني معك؟

195
00:13:41,210 --> 00:13:45,090
.فلديك حياة قبل كلّ شيء

196
00:13:46,630 --> 00:13:50,010
...يا إلهي، كلّما نظرتُ إليه

197
00:13:56,560 --> 00:13:57,270
—ما الّذي

198
00:13:57,270 --> 00:13:58,520
!لا تعبث معي

199
00:13:58,520 --> 00:14:00,480
من تظنّ نفسك؟

200
00:14:00,480 --> 00:14:02,360
ما الّذي تقصده بأنّ "لديّ حياة"؟

201
00:14:02,360 --> 00:14:04,820
!لا تتجرّأ أبدًا بوصف النّاس بتلك الطّريقة

202
00:14:05,280 --> 00:14:08,820
،إن بدا عليّ أنّي راضٍ
!فذلك لأني أبذل جهدًا في ذلك

203
00:14:09,110 --> 00:14:12,910
ذلك لأنّي أبذل قصارى جهدي لأكفّ
!عن كوني مهووسًا في الثّانويّة

204
00:14:13,660 --> 00:14:16,790
إيّاك أن تجرؤ على وصفي
!بـ"لديّ حياة" بذلك التّكبّر

205
00:14:17,660 --> 00:14:19,040
...أنا لا أتصرّف بتكبّر

206
00:14:19,040 --> 00:14:25,300
أراهن أنّك تعتقد أنّه من الأفضل قضاء
وقتك في اللّعب بمفردك، صحيح؟

207
00:14:25,300 --> 00:14:27,170
تريد أن تستمتع باللّعب فحسب؟

208
00:14:27,510 --> 00:14:29,970
.يا له من عذر وقح

209
00:14:29,970 --> 00:14:32,140
."هراء "الانطباع المختلف

210
00:14:32,140 --> 00:14:33,180
تعتقد أنّك رائع جدًّا؟

211
00:14:33,180 --> 00:14:34,220
!لا تعبث معي

212
00:14:34,220 --> 00:14:38,230
لماذا أصلاً تتصرّف بجدّيّة بشأن
!ألعاب الفيديو؟ هذا غباء

213
00:14:38,940 --> 00:14:44,980
.وفوق هذا، أجد نادي تيندو للألعاب غبيًّا أيضًا

214
00:14:49,450 --> 00:14:52,280
لماذا لا تقول شيئًا؟

215
00:14:54,280 --> 00:14:55,700
.اسحب كلامك

216
00:15:00,870 --> 00:15:03,880
!اسحب ما قلتَ للتّوّ

217
00:15:03,880 --> 00:15:08,920
صحيح، أنا مجرّد متكاسل لا اهتمامات
!أخرى لديه فيما عدا اللّعب

218
00:15:08,920 --> 00:15:10,380
!أعرف ذلك منذ البداية

219
00:15:10,380 --> 00:15:11,640
!أنا آسف

220
00:15:11,640 --> 00:15:14,430
أنت محقّ تمامًا في تفكيري أنّي رائع

221
00:15:13,050 --> 00:15:14,430
...يا رجل، اهدأ

222
00:15:14,430 --> 00:15:16,140
لالتزامي بموضعي بشأن الألعاب
!لدرجة أنّ ذلك يؤلم

223
00:15:16,680 --> 00:15:17,970
نعم، أنا آفة، صحيح؟

224
00:15:17,970 --> 00:15:19,520
أنا مجنون، صحيح؟

225
00:15:18,560 --> 00:15:21,650
!لا، لا، لم أقل ذلك أبدًا

226
00:15:19,520 --> 00:15:22,350
!حتّى أنّي سأعترف أنّ الألعاب غبيّة لأجل الجدال

227
00:15:22,900 --> 00:15:28,280
لكنّ ذلك لا يعطيك الحقّ في إهانة
شخص بالكاد تعرفه لمجرّد

228
00:15:27,730 --> 00:15:29,650
!سـ-سوف يقتلني

229
00:15:28,280 --> 00:15:31,360
!أنّه منكبٌّ بأمر ما، حتّى إن كان شيئًا غبيًّا كاللّعب

230
00:15:32,450 --> 00:15:34,620
!لا يحقّ لك إهانتي

231
00:15:35,370 --> 00:15:38,120
.تيندو-سان إنسانة طيّبة للغاية

232
00:15:38,620 --> 00:15:41,210
،إنّها لطيفة، وتبادر بالأفعال

233
00:15:41,620 --> 00:15:44,630
وقد دعتني أنا من بين الجميع
.لأنضمّ لنادي الألعاب مرّتين

234
00:15:45,590 --> 00:15:50,840
لذلك أريدك أن تسحب ملاحظاتك
المهينة عن تيندو-سان

235
00:15:50,840 --> 00:15:52,550
!وعن نادي الألعاب

236
00:15:54,140 --> 00:15:56,550
!حسنًا، اهدأ فحسب

237
00:15:56,550 --> 00:15:58,010
اهدأ فحسب، مفهوم؟

238
00:16:03,020 --> 00:16:04,650
!أ-أنا آسف

239
00:16:10,530 --> 00:16:11,530
ما كان ذلك؟

240
00:16:12,400 --> 00:16:16,240
كان من الغباء مقارنته بنفسي
.والغضب هكذا

241
00:16:19,330 --> 00:16:21,370
.أشعر بالسّوء

242
00:16:22,750 --> 00:16:23,710
.آسف

243
00:16:23,710 --> 00:16:25,210
...كـ-كلاّ

244
00:16:26,750 --> 00:16:30,710
لكن لم أعتقد أبدًا أنّ نفس الشّخص
الّذي رفض دعوة مباشرة

245
00:16:30,710 --> 00:16:34,010
من تيندو كان ليدافع عن نادي
.الألعاب بكلّ شغف هكذا

246
00:16:34,630 --> 00:16:36,970
...هـ-هذا كان

247
00:16:44,190 --> 00:16:46,860
.حسنًا، سأعود لصالة الألعاب

248
00:16:46,860 --> 00:16:48,440
ماذا عنك؟

249
00:16:51,440 --> 00:16:52,820
.سأعود للمنزل لهذا اليوم

250
00:16:53,240 --> 00:16:55,110
.هنالك لعبة أريد لعبها في المنزل أيضًا

251
00:16:56,160 --> 00:16:57,030
هكذا إذًا؟

252
00:16:57,740 --> 00:16:59,830
.حسنًا. أراك لاحقًا

253
00:16:59,830 --> 00:17:00,700
.نعم

254
00:17:04,330 --> 00:17:07,000
.آسف لأنّي حدّثتك بتعالٍ عن امتلاكك لحياة

255
00:17:07,960 --> 00:17:10,000
.انس الأمر

256
00:17:17,890 --> 00:17:22,060
.حالي في الماضي لا علاقة له به

257
00:17:30,520 --> 00:17:32,900
.لقد شاهدتُ شيئًا مذهلًا للتّوّ

258
00:17:33,570 --> 00:17:36,400
.نجمة مدرستنا... يا إلهي

259
00:17:40,160 --> 00:17:41,870
.مرحبًا يا تيندو

260
00:17:42,910 --> 00:17:45,290
ما الّذي تريده من تيندو كارين؟

261
00:17:47,420 --> 00:17:49,750
.حسنًا، مفهوم

262
00:17:49,750 --> 00:17:51,250
.أتمنّى لك كلّ الخير

263
00:17:51,250 --> 00:17:53,050
!انتظر

264
00:17:53,050 --> 00:17:54,840
ما الّذي تعنيه؟ ما هو "المفهوم"؟

265
00:17:54,840 --> 00:17:57,050
كيف تتمنّى لي الخير؟

266
00:17:57,050 --> 00:17:58,760
...أنا

267
00:17:59,140 --> 00:18:02,890
.أعتقد أنّك وأمانو تبدوان ظريفين معًا

268
00:18:04,680 --> 00:18:05,520
.إلى اللّقاء

269
00:18:08,060 --> 00:18:12,020
لا أصدّق أنّ أجمل فتاة في المدرسة
...قد تُغرم بشدّة هكذا

270
00:18:12,570 --> 00:18:14,900
.سوف أشجّعهما بشدّة

271
00:18:14,900 --> 00:18:17,700
.ستكون طريقة رائعة لمضايقة أمانو

272
00:18:20,570 --> 00:18:21,830
.نسيت

273
00:18:23,280 --> 00:18:25,290
!هيّا، أحضر هذه لي

274
00:18:25,290 --> 00:18:27,210
.على مهلك عليّ

275
00:18:27,210 --> 00:18:29,830
كم صرفتُ من المال اليوم في رأيك؟

276
00:18:29,830 --> 00:18:30,830
!عرفتُ هذا

277
00:18:30,830 --> 00:18:33,290
فزت بجوائز لشخص آخر، صحيح؟

278
00:18:33,290 --> 00:18:36,340
كلاّ، كنتُ ألعب ألعاب الفيديو
.مع رجل آخر فحسب

279
00:18:37,340 --> 00:18:39,510
تلعب مع شخص آخر عداي؟

280
00:18:39,510 --> 00:18:42,600
!طوبا لك يا تاسكو-سان الخائن

281
00:18:51,900 --> 00:18:54,980
،نحن نتواعد طوال الشّهور السّتّة الماضية

282
00:18:54,980 --> 00:18:58,700
.لكن كلّ ما فعلناه هو الخروج معًا بعد المدرسة

283
00:18:59,070 --> 00:19:01,820
لماذا أواعدها من الأساس؟

284
00:19:03,950 --> 00:19:08,080
أخبريني يا أغوري، ما الّذي أعجبنك فيّ
وجعلك تريدين أن تعترفي بحبّك لي؟

285
00:19:08,080 --> 00:19:09,040
ماذا؟

286
00:19:09,040 --> 00:19:10,830
ألم أخبرك؟

287
00:19:10,830 --> 00:19:13,710
.أراهن أنّها أحبّت وجهي أو ما شابه

288
00:19:13,710 --> 00:19:18,510
.لأنّك كنتَ رائعًا بالطّبع

289
00:19:18,510 --> 00:19:19,630
.لقد أصبت

290
00:19:19,630 --> 00:19:24,050
.عندما فزت لي بدمية في الإعداديّة

291
00:19:25,930 --> 00:19:27,850
ما الّذي تفعله؟

292
00:19:30,230 --> 00:19:31,980
الإعداديّة؟

293
00:19:31,980 --> 00:19:33,350
أنا وأنت؟

294
00:19:33,350 --> 00:19:34,150
.نعم

295
00:19:34,150 --> 00:19:38,780
كان واضحًا أنّك كنتَ تستمتع كثيرًا
.عندما كنتَ تلعب هنا بين الحين والآخر

296
00:19:38,780 --> 00:19:41,740
.لقد وقعت في حبّك مذّاك الحين

297
00:19:42,320 --> 00:19:43,870
الإعداديّة؟

298
00:19:44,410 --> 00:19:47,200
خلال أيّامي المظلمة؟

299
00:19:49,700 --> 00:19:52,000
.هذا صحيح، لقد تذكّرت الآن

300
00:19:52,500 --> 00:19:57,840
كنتُ آتي إلى هنا أحيانًا لأشتّت
...انتباهي، وحصل أن

301
00:19:59,260 --> 00:20:00,300
...وحصل أن

302
00:20:08,010 --> 00:20:12,480
لذلك عندما عرفتُ أنّك سترتاد نفس
!الثّانويّة مثلي، قلتُ أنّ تلك هي فرصتي

303
00:20:12,480 --> 00:20:15,730
.لكنّك تحوّلت إلى شخص جذّاب حينها

304
00:20:15,730 --> 00:20:20,110
،وسمعتُ أنّك تحبّ الفتيات الأنثويّات
.لذلك عملت بجدّ للوصول إلى ذلك

305
00:20:23,610 --> 00:20:25,030
ما الخطب؟

306
00:20:31,080 --> 00:20:33,210
.هـ-هذا يكفي لهذا اليوم

307
00:20:33,210 --> 00:20:36,130
.ماذا؟ لنمشي للمنزل معًا

308
00:20:36,500 --> 00:20:38,250
!أنت تسكنين على مقربة من هنا

309
00:20:38,250 --> 00:20:38,920
!مع السّلامة

310
00:20:38,920 --> 00:20:40,510
!مهلاً يا تاسكو

311
00:20:42,420 --> 00:20:43,880
ما كان ذلك؟

312
00:20:43,880 --> 00:20:45,010
!ما كان ذلك؟

313
00:20:45,010 --> 00:20:47,470
لماذا تراودني مشاعر نحو أغوري الآن؟

314
00:20:47,470 --> 00:20:50,270
لقد وضعت عينيها عليّ منذ المدرسة الإعداديّة؟

315
00:20:50,270 --> 00:20:52,100
عندما كنت مجرّد فاشل؟

316
00:20:56,520 --> 00:20:58,860
هل كانت ظريفة هكذا من قبل؟

317
00:20:59,520 --> 00:21:02,320
لماذا تبدو ظريفة للغاية فجأة؟

318
00:21:02,320 --> 00:21:05,950
!لماذا؟

319
00:21:07,950 --> 00:21:09,330
.صباح الخير

320
00:21:09,330 --> 00:21:09,950
.مرحبًا

321
00:21:14,330 --> 00:21:16,210
.يا أمانو

322
00:21:17,670 --> 00:21:19,090
.صباح الخير يا أويهارا-كُن

323
00:21:19,090 --> 00:21:21,630
.كنتَ على حقّ. كانت ممتعة

324
00:21:21,630 --> 00:21:23,090
."قصدت لعبة "نسخة من الخيال

325
00:21:24,010 --> 00:21:26,930
.أعلمني كلّما وجدتَ المزيد من الألعاب الجيّدة

326
00:21:27,800 --> 00:21:29,850
!أكيد، سأفعل

327
00:21:29,850 --> 00:21:32,680
تاسكو، هل كنت قريبًا من أمانو هكذا من قبل؟

328
00:21:32,680 --> 00:21:34,350
.أظنّ ذلك

329
00:21:34,680 --> 00:21:36,730
.أنت في مزاج جيّد

330
00:21:36,730 --> 00:21:38,150
هل حدث أمر ما؟

331
00:21:40,650 --> 00:21:46,150
.أنا أقضي وقتًا ممتعًا مع ألعاب الفيديو مؤخّرًا

332
00:23:21,250 --> 00:23:23,790
...أتساءل ما خطب تيندو-سان

333
00:23:28,460 --> 00:23:30,130
ماذا؟ أمانو-كُن؟

334
00:23:32,010 --> 00:23:33,140
ماذا هنالك؟

335
00:23:33,140 --> 00:23:35,100
هل أنت هنا لرؤية تيندو-سان؟

336
00:23:35,100 --> 00:23:39,520
،أنا هنا لمقابلة فتاة أخرى اليوم
.وليس تيندو-سان

337
00:23:44,310 --> 00:23:48,030
...يُتبع