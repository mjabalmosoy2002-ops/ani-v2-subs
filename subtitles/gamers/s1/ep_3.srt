1
00:01:30,060 --> 00:01:33,980
اليوم 3

2
00:01:36,330 --> 00:01:37,240
!كلاّ

3
00:01:41,060 --> 00:01:42,490
.يا أمانو

4
00:01:43,620 --> 00:01:46,230
.صباح الخير يا أويهارا-كُن

5
00:01:47,040 --> 00:01:50,690
تلك اللّعبة المجّانيّة من تصميم ذلك
.المدعوّ نوبي كانت مملّة للغاية

6
00:01:50,690 --> 00:01:52,680
.ظننتُ أنّك قلت أنّها ممتعة

7
00:01:52,680 --> 00:01:54,650
مستحيل، هل لعبتها بالفعل؟

8
00:01:54,650 --> 00:01:55,860
كيف كانت؟

9
00:01:58,180 --> 00:02:01,370
،في البداية، كانت لعبة استكشاف مرعبة

10
00:02:01,370 --> 00:02:04,970
وقد جعلتني متحمّسًا بشأن كلّ تلك
.الأسرار والتّلميح لأحداث قادمة

11
00:02:05,360 --> 00:02:09,810
لم أكن واثقًا بما سيكون رأيي بها بعد أن
،أصبحت لعبة صيد في منتصف الطّريق

12
00:02:09,810 --> 00:02:13,000
،لكن بما أنّك من أوصاني بها

13
00:02:13,000 --> 00:02:14,940
.توقّعت أنّها تستحقّ مواصلة لعبها

14
00:02:14,940 --> 00:02:18,570
...ولكن

15
00:02:19,660 --> 00:02:21,990
كانت النّهاية عن مجرّد رجل أمسك
،بسمكة قاروس أسود

16
00:02:21,990 --> 00:02:24,620
!وهو يقف بفخر أمام بصمة سمكة

17
00:02:24,620 --> 00:02:26,120
!ما كان ذلك؟

18
00:02:26,120 --> 00:02:29,540
أعلم! ألعاب نوبي-سان كلّها رائعة، صحيح؟

19
00:02:29,540 --> 00:02:30,830
من أيّ ناحية؟

20
00:02:30,830 --> 00:02:33,410
.إنّ أذواقك معقدّة للغاية

21
00:02:33,410 --> 00:02:35,420
.كانت تلك اللّعبة فاشلة بالكامل

22
00:02:37,420 --> 00:02:39,030
.آسف

23
00:02:39,030 --> 00:02:42,980
.أعتقد أنّ ألعاب نوبي-سان سيّئة أيضًا

24
00:02:42,980 --> 00:02:47,220
.لكن لدى تلك الألعاب سحر لا يمكن شرحه

25
00:02:47,220 --> 00:02:48,680
.أنا لا أفهم بالفعل

26
00:02:49,010 --> 00:02:51,560
.على سبيل المثال... أجل

27
00:02:51,560 --> 00:02:53,960
.الأمر أشبه بالوقوع في الحبّ

28
00:02:53,960 --> 00:02:55,070
.إنّه ليس منطقيًّا

29
00:02:55,070 --> 00:02:57,780
.أنت بتول، وتقول هذا لشخص لديه حبيبة

30
00:03:00,820 --> 00:03:02,630
!ذلك ليس قصدي

31
00:03:02,630 --> 00:03:06,370
...صحيح أنّك تملك حبيبة، ولكن

32
00:03:09,040 --> 00:03:10,250
ماذا؟

33
00:03:10,250 --> 00:03:14,020
لا-لا تهتمّ بذلك، ماذا عنك وتيندو؟

34
00:03:14,620 --> 00:03:16,530
ماذا عن تيندو-سان؟

35
00:03:16,530 --> 00:03:18,590
ألا تراها كثيرًا منذ ما حدث حينها؟

36
00:03:22,450 --> 00:03:24,800
أنا حزين في الحقيقة نوعًا ما
.لأننا لم نلتقِ كثيرًا

37
00:03:24,800 --> 00:03:28,160
لا، لا. هل أنت جادّ في قولك هذا؟

38
00:03:28,160 --> 00:03:29,130
.نعم

39
00:03:29,130 --> 00:03:32,670
.أعني أنّي أراها من بعيد أحيانًا

40
00:03:33,800 --> 00:03:35,130
.لا تهتمّ

41
00:03:35,130 --> 00:03:37,170
.ذلك ممتع نوعًا ما أيضًا

42
00:03:37,170 --> 00:03:40,780
كن حذرًا فقط ألاّ تمرّا على بعضكما
.كثيرًا لدرجة أن يكفّ التّواصل بينكما

43
00:03:40,780 --> 00:03:41,570
.نعم

44
00:03:42,090 --> 00:03:43,170
نمرّ على بعضنا؟

45
00:03:44,210 --> 00:03:45,570
تقصد مسألة "3 دي إس"؟

46
00:03:46,020 --> 00:03:47,070
...نعم، وظيفة التّواصل

47
00:03:47,070 --> 00:03:48,910
!لا بالطّبع

48
00:03:54,900 --> 00:03:58,130
آسف يا أويهارا-كُن، هل تمانع إن لعبتُ قليلاً؟

49
00:03:59,820 --> 00:04:00,470
.لا بأس

50
00:04:05,490 --> 00:04:08,660
لماذا اسمك الرّمزيّ هو "تسوتشي"؟

51
00:04:09,810 --> 00:04:14,450
.أحبّ استعمال اسم لا يشبه اسمي وأنا على الإنترنت

52
00:04:14,450 --> 00:04:17,520
،نسب أمّي قبل الزّواج كان تسوتشياما
.لذلك اخترتُ تسوتشي

53
00:04:17,520 --> 00:04:20,280
.أستعمل ياما-سان أحيانًا أيضًا

54
00:04:20,280 --> 00:04:22,030
.هذا سخيف، كنت أتوقّع سببًا أفضل

55
00:04:22,030 --> 00:04:23,410
!دعني وشأني

56
00:04:23,980 --> 00:04:25,740
ماذا عن "مونو" تلك؟

57
00:04:25,740 --> 00:04:26,990
تقصد مونو-سان؟

58
00:04:27,430 --> 00:04:31,670
.إنّنا صديقان منذ أن بدأتُ لعب هذه اللّعبة

59
00:04:31,670 --> 00:04:33,860
.أشعر بقرب غريب منها

60
00:04:33,860 --> 00:04:38,430
هذا أشبه بتواصل موجود مع شخص
لم ترَ وجهه من قبل، صحيح؟

61
00:04:39,930 --> 00:04:45,680
يبدو أنّك ستحتاج لإعادة تأهيل قبل أن أتمكّن
.من الاستمتاع بقصّتك الرّومانسيّة الكوميديّة

62
00:04:45,680 --> 00:04:46,480
ماذا؟

63
00:04:46,480 --> 00:04:47,750
قصّة رومانسيّة كوميديّة؟

64
00:04:47,750 --> 00:04:48,930
أنا ومن؟

65
00:04:48,930 --> 00:04:50,620
.مع تيندو

66
00:04:50,620 --> 00:04:53,230
.لن تحقّق أيّ تقدّم على هذا الحال

67
00:04:53,670 --> 00:04:58,480
.ذ-ذلك صحيح، أنا لا شيء مقارنة بتيندو-سان

68
00:04:58,480 --> 00:05:02,860
.لا، أنا لا أحاول جعلك تحزن

69
00:05:03,300 --> 00:05:08,700
قصدتُ بإعادة التّأهيل أنّي أريدك
.أن تتطوّر من وضع الفتى الوحيد هذا

70
00:05:08,700 --> 00:05:10,330
!أويهارا-كُن

71
00:05:10,330 --> 00:05:12,160
هل تهتمّ لي إلى تلك الدّرجة؟

72
00:05:12,590 --> 00:05:13,880
.حسنًا، حسنًا

73
00:05:13,880 --> 00:05:17,670
لماذا لا نبدأ بالحديث مع بعض الفتيات
اللاّتي يحببن نفس الألعاب مثلك؟

74
00:05:17,670 --> 00:05:18,650
ما رأيك؟

75
00:05:24,210 --> 00:05:26,050
.حسنًا. إنّها هدفك

76
00:05:26,870 --> 00:05:29,100
.اسمها هو هوشينوموري تشياكي

77
00:05:29,100 --> 00:05:33,520
.يُفترض أنّها أوتاكو وحيدة تحبّ اللّعب مثلك

78
00:05:33,520 --> 00:05:35,170
.مـ-مستحيل

79
00:05:35,170 --> 00:05:37,610
لماذا عليّ أن أتقرّب من شخص
بشكل غريب هكذا؟

80
00:05:37,610 --> 00:05:38,520
!افعل ذلك فحسب

81
00:05:38,520 --> 00:05:40,670
!تعامل مع التّفاصيل المهمّة مباشرة

82
00:05:40,670 --> 00:05:42,330
!التّفاصيل المهمّة؟

83
00:05:42,330 --> 00:05:43,790
!تاسكو

84
00:05:45,470 --> 00:05:48,070
ألم تكن ستمضي الوقت معي اليوم؟

85
00:05:48,500 --> 00:05:50,230
.صحيح

86
00:05:50,230 --> 00:05:51,160
.آسف

87
00:05:51,960 --> 00:05:55,270
.حسنًا يا أمانو. سأنتظر إجابتك

88
00:05:56,050 --> 00:05:58,820
!من الأفضل أن تتحدّث إلى هوشينوموري

89
00:06:01,190 --> 00:06:04,030
هل فعلت شيئًا لأستحقّ هذا؟

90
00:06:06,970 --> 00:06:08,850
!إنّهم يحدّقون بي

91
00:06:12,390 --> 00:06:15,070
.أتساءل ما خطب تيندو-سان

92
00:06:19,420 --> 00:06:21,220
ماذا؟ أمانو-كُن؟

93
00:06:23,020 --> 00:06:24,120
ماذا هنالك؟

94
00:06:24,120 --> 00:06:25,530
هل أنت هنا لرؤية تيندو-سان؟

95
00:06:25,530 --> 00:06:27,560
.كـ-كلاّ، ليس كذلك

96
00:06:27,560 --> 00:06:30,410
،أنا لستُ مهتمًّا بتيندو-سان
.ولا علاقة لي بها من أيّ ناحية

97
00:06:32,310 --> 00:06:33,530
هكذا إذًا؟

98
00:06:33,940 --> 00:06:35,750
ما الّذي أتى بك للفصل "أ" إذًا؟

99
00:06:35,750 --> 00:06:41,300
،أنا هنا لمقابلة فتاة أخرى اليوم
.وليس تيندو-سان

100
00:06:43,390 --> 00:06:45,290
...هبوب

101
00:06:46,900 --> 00:06:47,460
.أجل

102
00:06:59,500 --> 00:07:01,270
...عفوًا... المعذرة

103
00:07:03,210 --> 00:07:05,270
.إنّها مركّزة تمامًا

104
00:07:05,270 --> 00:07:06,340
ماذا؟

105
00:07:06,340 --> 00:07:07,690
...هذه اللّعبة

106
00:07:07,690 --> 00:07:08,400
.أحم

107
00:07:09,190 --> 00:07:10,970
!تـ-تيندو-سان

108
00:07:10,970 --> 00:07:13,700
.لم أرك منذ مدّة يا أمانو-كُن

109
00:07:13,700 --> 00:07:15,530
.وأنا كذلك

110
00:07:15,530 --> 00:07:17,910
ما الّذي أتى بك للفصل "أ"؟

111
00:07:17,910 --> 00:07:19,050
...عفوًا

112
00:07:19,050 --> 00:07:22,840
.أنا هنا لرؤية... فتاة

113
00:07:22,840 --> 00:07:24,540
.فـ-فهمت

114
00:07:25,030 --> 00:07:30,340
،عرفت، لا بدّ أنّه أمر إداريّ حسب معرفتي بك

115
00:07:30,340 --> 00:07:31,970
.مثل أمور ممثّلي الفصل

116
00:07:31,970 --> 00:07:35,330
لا، لا. الأمر ليس كذلك

117
00:07:35,980 --> 00:07:39,300
.افعل ذلك فحسب. تعامل مع التّفاصيل المهمّة مباشرة

118
00:07:39,300 --> 00:07:42,900
...التّفاصيل المهمّة

119
00:07:41,980 --> 00:07:42,900
!صحيح

120
00:07:43,500 --> 00:07:47,110
"استجمعتُ شجاعتي للحضور إلى الفصل "أ
.لأصبح صديقًا لهذه الآنسة

121
00:07:50,680 --> 00:07:52,280
ما الخطب يا تيندو-سان؟

122
00:07:54,740 --> 00:07:57,950
.لا، لا، هذا ليس الوقت المناسب لذلك

123
00:07:58,330 --> 00:08:00,130
...سا

124
00:08:01,030 --> 00:08:01,910
سا؟

125
00:08:01,910 --> 00:08:04,490
...سا... سا... سا

126
00:08:05,170 --> 00:08:07,710
!سافل

127
00:08:08,110 --> 00:08:09,510
!تيندو-سان

128
00:08:09,510 --> 00:08:11,070
.آسف يا أمانو-كُن

129
00:08:12,270 --> 00:08:14,590
سا-سافل؟

130
00:08:15,010 --> 00:08:17,350
...صحيح، يا هوشينوموري-سان

131
00:08:20,390 --> 00:08:22,480
مـ-من تكون؟

132
00:08:22,480 --> 00:08:25,480
...أنا... كنتُ

133
00:08:25,770 --> 00:08:26,980
...هـ-هذه

134
00:08:27,480 --> 00:08:30,750
هذه لعبة "إيجيس 8" الّتي صدرت
الأسبوع الماضي، صحيح؟

135
00:08:37,560 --> 00:08:42,030
،هذا متأخّر نوعًا ما
."لكنّي أمانو كيتا من الفصل "و

136
00:08:42,030 --> 00:08:44,120
اسمك أمانو-سان؟

137
00:08:46,280 --> 00:08:49,250
هل تحبّين الألعاب أيضًا يا هوشينوموري-سان؟

138
00:08:49,860 --> 00:08:50,500
.نعم

139
00:08:54,760 --> 00:08:57,270
.حديثنا ميت

140
00:08:57,270 --> 00:08:58,200
...المعذرة

141
00:08:58,890 --> 00:09:01,520
أنت من نادي الألعاب، صحيح؟

142
00:09:02,130 --> 00:09:05,620
.أنا آسفة، ما زلت لا أهتمّ بالانضمام لنادي الألعاب

143
00:09:05,620 --> 00:09:07,800
.مـ-مهلاً لحظة

144
00:09:07,800 --> 00:09:09,610
.أنا لستُ في نادي الألعاب

145
00:09:09,610 --> 00:09:11,860
...لقد دعوني، ولكن

146
00:09:14,020 --> 00:09:16,340
مهلاً، هل دعوك أيضًا يا هوشينوموري-سان؟

147
00:09:16,340 --> 00:09:17,560
.نعم

148
00:09:17,560 --> 00:09:21,990
لقد دعتني تيندو-سان وذهبت
...لألقي نظرة، لكن

149
00:09:22,350 --> 00:09:27,150
لكنّ نشاطات النّادي لم تكن كما تصوّرتِها كلاعبة؟

150
00:09:27,650 --> 00:09:28,580
!نعم، نعم

151
00:09:28,950 --> 00:09:33,550
،نادي الألعاب رائع بكلّ تأكيد
.لكنّهم مبهرون للغاية بالنّسبة لنا

152
00:09:33,980 --> 00:09:34,920
!نعم، نعم

153
00:09:34,920 --> 00:09:38,860
،أحبّ اللّعب مع الآخرين وأتنافس معهم أيضًا

154
00:09:38,860 --> 00:09:42,760
لكن ليس لأنّي أريد أن أكون الأفضل
.في اللّعبة أو ما شابه

155
00:09:43,070 --> 00:09:44,290
!أعلم ذلك

156
00:09:44,290 --> 00:09:47,520
.لكنّ نادي الألعاب نادٍ عن حقّ بالتّأكيد

157
00:09:48,650 --> 00:09:52,150
...لذلك شعرتُ بالسّوء حيال تيندو-سان، لكن

158
00:09:52,150 --> 00:09:52,900
...لكن

159
00:09:52,900 --> 00:09:56,400
!الألعاب هي حياتنا ولا يمكننا التّنازل أبدًا

160
00:10:00,830 --> 00:10:01,610
!نعم

161
00:10:10,350 --> 00:10:13,380
وقبل أن ندرك الأمر، كنّا أنا وهوشينوموري-سان

162
00:10:13,380 --> 00:10:17,070
.مرتاحين أكثر برفقة بعضنا بعضًا

163
00:10:19,690 --> 00:10:24,580
.اتّضح أنّنا كنّا متشابهين أكثر ممّا توقّع أويهارا-كُن

164
00:10:24,580 --> 00:10:26,970
،كلّما تحدّثنا معًا أكثر

165
00:10:26,970 --> 00:10:30,470
.أدركتُ أكثر أنّ أذواقنا وإحساسنا كانا متشابهين

166
00:10:30,470 --> 00:10:32,250
،بالأخصّ عندما يتعلّق الأمر بالألعاب

167
00:10:32,250 --> 00:10:36,570
الألعاب الّتي لعبناها في الماضي
...وأهدافنا وأساليب لعبنا

168
00:10:36,570 --> 00:10:39,420
.كنّا أشبه بصورتين طبق الأصل لبعضنا

169
00:10:42,500 --> 00:10:45,400
صحيح، أنت تحبّين سلسلة "إيجيس"، أليس كذلك؟

170
00:10:45,400 --> 00:10:46,030
!نعم

171
00:10:46,030 --> 00:10:48,330
.أجل، جميعها تحف فنّيّة

172
00:10:48,330 --> 00:10:49,540
!نعم، نعم

173
00:10:49,540 --> 00:10:50,900
...أفضل شيء فيها

174
00:10:50,900 --> 00:10:52,040
...بالأخصّ

175
00:10:52,040 --> 00:10:53,660
!الشّخصيّات

176
00:10:52,040 --> 00:10:53,660
!الموسيقى

177
00:11:00,500 --> 00:11:02,930
.فيما عدا شيء واحد

178
00:11:12,940 --> 00:11:14,940
دار بينكما شجار كبير؟

179
00:11:14,940 --> 00:11:17,630
.كان لدينا اختلاف في فلسفتينا

180
00:11:17,630 --> 00:11:18,840
ماذا؟

181
00:11:18,840 --> 00:11:21,860
.ظننتُ أنّ هوشينوموري محبّة ألعاب وحيدة

182
00:11:21,860 --> 00:11:22,700
.نعم

183
00:11:22,700 --> 00:11:25,800
.أظنّ أنّنا توافقنا معًا كثيرًا

184
00:11:25,800 --> 00:11:30,080
كانت أقلّ تعاليًا كصديقة
.أكثر منك أنت يا أويهارا-كُن

185
00:11:31,220 --> 00:11:33,040
!أحبّك يا أويهارا-كُن

186
00:11:34,340 --> 00:11:36,900
لماذا تشاجرتما إذًا؟

187
00:11:36,900 --> 00:11:39,160
ظننتُ أنّكما كنتما متوافقين، لذلك ما المشكلة؟

188
00:11:39,160 --> 00:11:42,430
.ما كنتَ لتترك الأمر يمرّ مرور الكرام أيضًا

189
00:11:43,050 --> 00:11:43,930
يمرّ مرور الكرام؟

190
00:11:45,180 --> 00:11:48,200
!تقول تشياكي أنّ الألعاب لا تحتاج لشخصيّات مُوِي

191
00:11:48,200 --> 00:11:49,310
هل أنت غبيّ؟

192
00:11:49,650 --> 00:11:55,010
لا أهتمّ إن كانت فتاة، لن أتنازل
.أبدًا عندما يتعلّق الأمر بالألعاب

193
00:11:55,010 --> 00:11:56,230
...اسمع

194
00:11:57,770 --> 00:11:59,740
.لا بأس، لا بأس

195
00:11:59,740 --> 00:12:02,200
.أمسى لديك صديق لعب أخيرًا

196
00:12:02,200 --> 00:12:04,320
.لنتحدّث بهدوء عن الأمر لاحقًا

197
00:12:05,340 --> 00:12:07,080
!ماذا؟

198
00:12:07,080 --> 00:12:09,010
هل أنت جادّ يا كيتا؟

199
00:12:09,010 --> 00:12:11,310
فكّر في صناعة الألعاب اليابانيّة
.الّتي بالغت في استعمال المُوِي

200
00:12:11,310 --> 00:12:14,300
مقارنة بصناعة الألعاب الأجنبيّة
.الّتي تركّز على اللّعب والقصّة

201
00:12:14,300 --> 00:12:18,210
أليس واضحًا أيّها يحصل على زخم أكثر؟

202
00:12:18,650 --> 00:12:21,050
.هذه هي مشكلتك أيّها القصير محدود التّفكير

203
00:12:21,050 --> 00:12:23,700
.مـ-مهلاً لحظة يا تشياكي-سان

204
00:12:23,700 --> 00:12:30,020
ألم تلعبي لعبة أجنبيّة من قبل وقلت
لنفسك ليت الفتيات كنّ أكثر ظرافة؟

205
00:12:30,020 --> 00:12:32,700
!يا ذات... الشّعر الشّبيه بالطّحالب

206
00:12:33,480 --> 00:12:34,770
!ماذا؟

207
00:12:35,090 --> 00:12:36,860
.مهلاً، مهلاً، مهلاً

208
00:12:36,860 --> 00:12:38,300
من أين أتى هذا؟

209
00:12:40,010 --> 00:12:42,280
لماذا لا تتّفقان معًا فحسب؟

210
00:12:42,280 --> 00:12:45,770
.نـ-نعم، أنت على حقّ يا أويهارا-سان

211
00:12:46,950 --> 00:12:50,560
،إذًا تُعجبين بالأولاد الوسيمين
لكن لا تقبلين المُوِي، صحيح يا تشياكي؟

212
00:12:50,560 --> 00:12:52,330
!هذا ليس صحيحًا

213
00:12:53,080 --> 00:12:55,950
،القتال بشأن الألعاب أمر

214
00:12:55,950 --> 00:12:57,950
.ومهاجمة مظاهر بعضكما أمر آخر تمامًا وغير مقبول

215
00:12:59,030 --> 00:13:01,760
.رغم أنّ أمانو بتول قصير بالفعل

216
00:13:01,760 --> 00:13:02,250
.أنت

217
00:13:03,610 --> 00:13:08,430
إذًا، ألم تكونا تتحدّثان عن المستوى
الّذي وصلتما إليه في "إيجيس 8"؟

218
00:13:08,950 --> 00:13:12,680
صحيح! إلى أين وصلت يا تشياكي؟

219
00:13:12,680 --> 00:13:15,020
...حـ-حسنًا، أنا

220
00:13:15,800 --> 00:13:17,690
.وصلتُ لمخبأ الجنيّات

221
00:13:17,690 --> 00:13:19,690
!فعلاً؟ أنا هناك أيضًا

222
00:13:19,690 --> 00:13:22,390
تلك الخريطة هي واحدة
.من أفضل الخرائط في اللّعبة

223
00:13:22,390 --> 00:13:23,500
!نعم، نعم

224
00:13:23,500 --> 00:13:28,570
.لا نرى كثيرًا خريطة رفيعة ومدهشة مثلها

225
00:13:28,570 --> 00:13:29,730
!أعلم

226
00:13:29,730 --> 00:13:34,540
.ولها طريقة في إظهار أنّها مخيّم لكارهي البشر

227
00:13:34,540 --> 00:13:36,590
.إنّها معبّرة بالفعل

228
00:13:38,010 --> 00:13:41,040
...وأفضل شيء فيها هو جمالُ

229
00:13:41,040 --> 00:13:44,800
لكنّ الشّيء الوحيد الّذي سأقول أنّه أفسدها
...هو المظهر المقرف والمُوي لـ

230
00:13:45,310 --> 00:13:47,300
!رسومات تموضع الإلف

231
00:13:50,300 --> 00:13:51,660
!ماذا؟

232
00:13:52,810 --> 00:13:54,430
لماذا لا يمكنكما التّوقف هنا؟

233
00:13:54,430 --> 00:13:56,460
.أنت لا تفهم يا أويهارا-كُن

234
00:13:56,460 --> 00:13:59,440
نحن لاعبون وحيدون لا نملك
.إلاّ غرورنا المتضخّم

235
00:13:59,440 --> 00:14:02,130
!لا يمكننا التّنازل عندما يتعلّق الأمر بالألعاب

236
00:14:02,130 --> 00:14:03,180
.كيتا على حقّ

237
00:14:03,180 --> 00:14:06,110
،ذلك هو الخطّ الّذي لا يمكننا عبوره
.حتّى إن كنّا لاعبين وحيدين

238
00:14:06,110 --> 00:14:07,700
.أنتما مزعجان كثيرًا

239
00:14:12,080 --> 00:14:14,580
.لديها هالة مذهلة

240
00:14:15,660 --> 00:14:17,770
.هذا كلّ شيء لليوم

241
00:14:17,770 --> 00:14:20,670
.آسف لاستعدائك لهذا يا هوشينوموري

242
00:14:20,670 --> 00:14:23,340
.لا-لا بأس. لا أمانع أبدًا

243
00:14:23,340 --> 00:14:27,310
.استمتعت بالاستماع لحديثكما عن ألعاب الفيديو

244
00:14:27,310 --> 00:14:29,600
من يهتمّ إن كان شعرك يشبه الطّحالب؟

245
00:14:29,600 --> 00:14:32,160
.أنا أحبّ الفتيات ذوات الشّعر الأشعث طبيعيًّا

246
00:14:32,160 --> 00:14:32,600
ماذا؟

247
00:14:32,600 --> 00:14:35,180
فـ-فعلاً؟

248
00:14:36,910 --> 00:14:40,410
.أظنّ أنّ أغوري-سان ستفهم الأمر بشكل خاطئ

249
00:14:40,410 --> 00:14:43,520
.لذلك هيّا. نحن أصدقاء لاعبون أخيرًا

250
00:14:43,520 --> 00:14:45,010
.لنكن أفضل مع بعضنا بعضًا

251
00:14:45,010 --> 00:14:46,570
.سـ-سأبذل جهدي

252
00:14:46,940 --> 00:14:52,570
هذا المشهد يبدو كأنّ أويهارا-كُن
.يحاول التّقرّب من فتاة أخرى

253
00:14:53,180 --> 00:14:56,580
،صحيح! أحبّ شعرك كما هو الآن

254
00:14:56,580 --> 00:15:00,380
لكنّي أعتقد أنّه سيبدو أفضل
.إن كان أقصر قليلاً

255
00:15:00,380 --> 00:15:01,830
هـ-هل تظنّ ذلك؟

256
00:15:02,240 --> 00:15:03,080
.نعم

257
00:15:03,080 --> 00:15:06,300
أعني أنّك تملكين مقوّمات الفتاة
.الظّريفة من الأساس

258
00:15:07,410 --> 00:15:10,700
قد ينتهي به المطاف وهو يدفع
.ثمنًا غاليًا على ذلك التّعليق

259
00:15:10,700 --> 00:15:12,520
...أ-أغوري-سان

260
00:15:13,270 --> 00:15:14,390
ماذا؟

261
00:15:19,940 --> 00:15:24,260
ميسومي-كُن، ما العلاقة بين
هوشينوموري-سان وأمانو-كُن؟

262
00:15:25,020 --> 00:15:30,750
.لا أعرف حقًّا، لكنّهما يتّفقان كثيرًا معًا

263
00:15:31,270 --> 00:15:32,940
هل يتّفقان كثيرًا معًا بالفعل؟

264
00:15:32,940 --> 00:15:34,660
أهذا ما في الأمر؟

265
00:15:34,660 --> 00:15:36,950
لماذا لا تسألينه بنفسك؟

266
00:15:48,680 --> 00:15:50,970
.إنّها هادئة اليوم

267
00:15:55,090 --> 00:15:59,290
أ-أخبرني يا تاسكو، ما الّذي كنتَ
تفعله في الفصل سابقًا؟

268
00:16:00,020 --> 00:16:01,390
كنتِ تشاهديننا؟

269
00:16:01,710 --> 00:16:04,180
...أنا كنتُ

270
00:16:04,180 --> 00:16:06,110
هل هو أمر لا تحبّ الحديث بشأنه؟

271
00:16:06,110 --> 00:16:11,280
لا، لا. باختصار، كنتُ أصالح بين
.أمانو وهوشينوموري المتخاصمين

272
00:16:11,650 --> 00:16:15,230
تـ-تلك الفتاة تُدعى هوشينوموري-سان، صحيح؟

273
00:16:18,450 --> 00:16:21,270
إذًا ما قصّة قضائك للكثير من الوقت
مع المدعوّ أمانو هذه الأيّام؟

274
00:16:21,270 --> 00:16:22,040
ماذا؟

275
00:16:22,040 --> 00:16:24,540
.نحن نحبّ الحديث عن الألعاب فحسب

276
00:16:24,540 --> 00:16:26,330
.فهمت

277
00:16:37,890 --> 00:16:43,910
لكن أشعر أنّ هذه اللّعبة الجديدة
.لم ترد المخاطرة كثيرًا

278
00:16:44,370 --> 00:16:47,940
إنّها لم تملك أيًّا من التّحوّلات المجنونة
.في القصّة المعتادة من نوبي-سان

279
00:17:02,080 --> 00:17:03,150
.إلى اللّقاء

280
00:17:03,150 --> 00:17:05,330
.ابحث عن تلك الفتاة من أجلي

281
00:17:05,330 --> 00:17:06,410
.أكيد

282
00:17:06,410 --> 00:17:10,300
يساورني الفضول بالفعل بشأن تلك الفتاة
.الظّريفة الّتي ظهرت من العدم أيضًا

283
00:17:10,300 --> 00:17:14,610
هل هنالك بالفعل شخص فيما
عدا تيندو بذلك الجمال؟

284
00:17:14,610 --> 00:17:15,930
.أويهارا-كُن

285
00:17:15,930 --> 00:17:17,820
هل أنت ذاهب للمنزل؟

286
00:17:17,820 --> 00:17:18,820
.نعم

287
00:17:18,820 --> 00:17:20,640
.أنا أنتظر أغوري

288
00:17:20,640 --> 00:17:22,140
هكذا إذًا؟

289
00:17:23,890 --> 00:17:26,270
هل هنالك أمر تريد قوله؟

290
00:17:27,500 --> 00:17:34,040
لا، ربّما أتدخّل فيما لا يعنيني، لكن هل قالت
أغوري-سان شيئًا البارحة في طريقكما للمنزل؟

291
00:17:34,540 --> 00:17:36,030
.لا-لا شيء

292
00:17:36,030 --> 00:17:37,150
.كانت عاديّة

293
00:17:37,660 --> 00:17:40,410
.حسنًا، لا تهتمّ إذًا

294
00:17:40,410 --> 00:17:43,090
لماذا أمانو قلق بشأن أغوري؟

295
00:17:43,090 --> 00:17:45,040
إنّهما لا يعرفان بعضهما حتّى، صحيح؟

296
00:17:45,540 --> 00:17:47,560
...أمانو، هل أنت

297
00:17:48,300 --> 00:17:50,290
...المعذرة يا أويهارا-سان

298
00:17:58,060 --> 00:17:59,950
...لـ-لحظة

299
00:17:59,950 --> 00:18:01,260
من أنت؟

300
00:18:07,230 --> 00:18:08,690
...أنا... هي

301
00:18:09,110 --> 00:18:10,690
ألم تعرفني؟

302
00:18:11,160 --> 00:18:12,440
.طحالب مجفّفة

303
00:18:12,440 --> 00:18:13,800
!ماذا؟

304
00:18:13,800 --> 00:18:15,320
!ما مشكلتك أنت؟

305
00:18:15,320 --> 00:18:18,070
مهلاً... أيعقل أن تكوني هوشينوموري؟

306
00:18:18,070 --> 00:18:19,320
.نعم، نعم

307
00:18:19,320 --> 00:18:23,350
،أ-أعطيتُها نصيحة صغيرة بشأن مظهرها

308
00:18:23,350 --> 00:18:26,220
.لكنّي لم أتوقّع كلّ هذا التّحسّن

309
00:18:26,700 --> 00:18:27,930
...أ-أنا

310
00:18:27,930 --> 00:18:29,790
.آسفة

311
00:18:29,790 --> 00:18:30,700
بشأن ماذا؟

312
00:18:31,230 --> 00:18:36,090
الأمر مريب قليلاً عندما يكون
بهذه الجرأة، صحيح؟

313
00:18:36,090 --> 00:18:39,150
.كـ-كلاّ، لا أعتقد ذلك

314
00:18:39,150 --> 00:18:41,160
.لديك مقوّمات الفتاة الظّريفة من الأساس

315
00:18:41,160 --> 00:18:41,760
.نعم

316
00:18:41,760 --> 00:18:42,990
.أنت ظريفة للغاية

317
00:18:42,990 --> 00:18:45,010
...ظريفة للغاية

318
00:18:47,700 --> 00:18:49,530
ما الّذي يحدث؟

319
00:18:51,270 --> 00:18:52,310
أغوري-سان؟

320
00:18:53,460 --> 00:18:54,640
...المعذرة

321
00:18:54,640 --> 00:18:56,660
هل هذا مقبول؟

322
00:18:55,010 --> 00:18:56,660
!أغوري-سان

323
00:18:56,660 --> 00:19:01,970
.أعني أنّه حتّى والداي وأختي لم يعرفونني

324
00:19:01,970 --> 00:19:04,740
.طبعًا مقبول. تبدين رائعة

325
00:19:05,080 --> 00:19:06,760
فـ-فعلاً؟

326
00:19:07,660 --> 00:19:09,000
.شكرًا لك

327
00:19:10,870 --> 00:19:12,210
ماذا؟ أين هو أمانو؟

328
00:19:12,210 --> 00:19:14,710
.ركض كيتا من هنا

329
00:19:15,330 --> 00:19:17,220
!"كان يصرخ قائلاً "أغوري-سان

330
00:19:20,690 --> 00:19:23,240
مصيبة! أين ذهبت أغوري-سان؟

331
00:19:24,580 --> 00:19:25,410
!تيندو-سان

332
00:19:25,410 --> 00:19:26,970
أ-أمانو-كُن؟

333
00:19:26,970 --> 00:19:28,490
.أنا سعيد لأنّك هنا

334
00:19:28,490 --> 00:19:32,030
أظنّني فهمت الأمور بشكل
.خاطئ في ذلك اليوم

335
00:19:32,030 --> 00:19:33,440
.آسفة على كلّ شيء

336
00:19:33,910 --> 00:19:35,210
عمّاذا تتحدّث؟

337
00:19:35,210 --> 00:19:37,240
!كلاّ، ذلك لا يهمّ

338
00:19:37,240 --> 00:19:40,900
أخبريني، هل مرّت بك فتاة ما؟

339
00:19:40,900 --> 00:19:43,570
...بدت بريئة وخرقاء وظريفة

340
00:19:44,810 --> 00:19:48,700
رأيت فتاة هكذا متّجهة للمدخل
.الأماميّ وقد بدت كئيبة

341
00:19:48,700 --> 00:19:50,510
!شكرًا لك

342
00:19:51,290 --> 00:19:52,680
!أ-أمانو-كُن

343
00:19:52,680 --> 00:19:53,670
ماذا هنالك؟

344
00:19:54,080 --> 00:19:57,420
لماذا تركض خلفها؟

345
00:19:57,420 --> 00:19:59,880
.الأمر هو ما يمكن وصفه بمشاكل علاقات

346
00:20:04,750 --> 00:20:07,070
...مشاكل علاقات

347
00:20:11,700 --> 00:20:12,640
!أغوري-سان

348
00:20:13,590 --> 00:20:16,300
.إنّه الفتى المريب الّذي يتبع تاسكو

349
00:20:16,300 --> 00:20:18,920
هل يراني النّاس هكذا؟

350
00:20:18,920 --> 00:20:21,610
.لا عجب أنّهم كانوا يحدّقون بي

351
00:20:21,610 --> 00:20:23,390
ما الّذي تريده إذًا؟

352
00:20:23,390 --> 00:20:26,210
...أنا... في الحقيقة

353
00:20:28,500 --> 00:20:31,330
هل تودّين الخروج لشرب الشّاي معي؟

354
00:20:32,960 --> 00:20:37,240
لا أستطيع التّخلّص من شعور أنّي كنتُ
.أحاول التّقرّب من الجميع مؤخّرًا

355
00:20:42,700 --> 00:20:43,340
.هذا محرج

356
00:20:43,870 --> 00:20:46,840
.لم أخطّط لهذا أبدًا

357
00:20:46,840 --> 00:20:48,550
...المعذرة

358
00:20:48,550 --> 00:20:49,540
ماذا؟

359
00:20:50,580 --> 00:20:55,220
هل يُتخيّل لي أم أنّك تقترفين خطأ كبيرًا؟

360
00:20:56,970 --> 00:21:01,860
لا أظنّ أنّ الأمر كما تعتقدين أنت
.بشأن تشياكي وأويهارا-كُن

361
00:21:01,860 --> 00:21:06,360
.لكنّه قال أنّ هوشينوموري-سان ظريفة للغاية

362
00:21:06,360 --> 00:21:09,760
.ذ-ذلك نوع من الحديث أو ما شابه

363
00:21:09,760 --> 00:21:13,870
.قال أويهارا-كُن أنّك ظريفة جدًّا هذه الأيّام

364
00:21:15,500 --> 00:21:16,610
فعلاً؟

365
00:21:16,610 --> 00:21:18,580
.نعم، بالفعل

366
00:21:18,580 --> 00:21:22,630
.إنّ أويهارا-كُن يحبّك بكلّ تأكيد يا أغوري-سان

367
00:21:22,630 --> 00:21:27,320
كما أنّ أويهارا-كُن أفضل بكثير من
.ذات شعر الطّحـ— أقصد تشياكي

368
00:21:27,320 --> 00:21:29,890
.أنا في صفّك بكلّ تأكيد

369
00:21:32,100 --> 00:21:35,640
.سأذهب لإحضار عصير مختلف

370
00:21:40,950 --> 00:21:42,850
.كان ذلك وشيكًا

371
00:21:42,850 --> 00:21:44,570
.إنّه حدث ما

372
00:21:45,630 --> 00:21:47,400
.أظنّ أنّي سأدعو مونو-سان

