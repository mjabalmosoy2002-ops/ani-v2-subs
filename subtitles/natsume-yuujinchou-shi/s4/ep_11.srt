1
00:01:47,480 --> 00:01:48,780
عُدت

2
00:01:51,700 --> 00:01:53,080
أهلاً بعودتك يا تاكاشي

3
00:01:53,720 --> 00:01:55,650
...شيغيرو-سان، هل هذه

4
00:01:56,910 --> 00:01:59,650
وجدتُ هذه الكاميرا القديمة
عندما كنتُ أنظِّف

5
00:02:00,020 --> 00:02:02,090
...أختبر فيما إذا كانت لا تزال تعمل

6
00:02:07,530 --> 00:02:09,100
إنّها تُصدر صوتاً غريباً

7
00:02:10,240 --> 00:02:12,700
لا بدَّ أنّ الفيلم عالق

8
00:02:12,700 --> 00:02:16,670
لم أستخدمها إلّا عندما كنتُ
أخرج في رحلة مع توكو-سان

9
00:02:17,230 --> 00:02:18,740
لعلّ الغُبار تراكم فيها عبر الزّمن

10
00:02:18,740 --> 00:02:20,340
ربّما سأصلحها

11
00:02:20,740 --> 00:02:22,860
حالما تُصلَح، لنلتقط صورة جميعنا معاً

12
00:02:25,130 --> 00:02:26,120
حسناً

13
00:02:27,770 --> 00:02:29,610
صورة إذاً؟

14
00:02:35,660 --> 00:02:38,240
شكراً على التسوُّق معي يا تاكاشي-كن

15
00:02:38,240 --> 00:02:41,180
.أعددتُ بعض الشّاي المُثلّج
خُذ منه معك

16
00:02:41,180 --> 00:02:42,390
شكراً

17
00:02:46,340 --> 00:02:48,430
عدتُ يا نيانكو-سينسي

18
00:02:48,950 --> 00:02:50,740
!أهلاً بعودتك

19
00:02:48,950 --> 00:02:52,560
أهلاً بعودتك يا ناتسومي-ساما

20
00:02:52,560 --> 00:02:54,690
!أهلاً بعودتك! أهلاً بعودتك

21
00:02:54,690 --> 00:02:56,650
!لا ترحّبوا بعودتي

22
00:02:56,650 --> 00:03:00,290
!لم أعطكم الإذن بالدّخول أصلاً

23
00:03:00,290 --> 00:03:01,690
أين سينسي؟

24
00:03:06,310 --> 00:03:08,390
!نيانكو-سينسي

25
00:03:08,390 --> 00:03:12,510
قال أحد المعارف بأنّ اسمه مكتوب
،في كِتاب الأصدقاء

26
00:03:12,510 --> 00:03:14,560
لذا أحضرناه إلى هنا

27
00:03:15,600 --> 00:03:17,120
مرحباً

28
00:03:19,230 --> 00:03:22,520
أنت يا من تحميني، اكشف عن اسمك

29
00:03:25,220 --> 00:03:28,300
...تحديق

30
00:03:28,300 --> 00:03:30,230
!لا تحدِّقوا! هذا مُخيف

31
00:03:30,230 --> 00:03:33,810
!إنّه ظريفٌ جدّاً عندما يغضب

32
00:03:41,130 --> 00:03:44,610
شكراً لك يا ناتسومي-ساما

33
00:03:45,560 --> 00:03:47,130
أنا مُرهق

34
00:03:48,230 --> 00:03:50,220
كم أنت ضعيف

35
00:03:50,220 --> 00:03:52,410
هل أنت متأكّد بأنّك حفيد ريكو؟

36
00:03:52,670 --> 00:03:54,320
حفيدها؟

37
00:03:54,320 --> 00:03:59,490
...إذاً كان لدى ريكو عائلة

38
00:03:59,980 --> 00:04:01,140
...عائلة

39
00:04:01,940 --> 00:04:03,670
أشكّ

40
00:04:07,070 --> 00:04:09,780
أعدتَ اسماً آخر، أليس كذلك؟

41
00:04:09,780 --> 00:04:14,780
ماذا تفعل لكِتاب الأصدقاء الخاص بي؟

42
00:04:16,170 --> 00:04:18,950
"احتفظتْ جدّتي باسم "ناتسومي
طوال حياتها

43
00:04:18,950 --> 00:04:23,400
لم أجرؤ يوماً على سؤال أي من أقاربي
...الّذين كنتُ أقيم معهم

44
00:04:24,170 --> 00:04:28,550
...كنتُ أخشى أن يسيئوا لها بالكلام

45
00:04:28,550 --> 00:04:30,610
أو أن يخبروني كم كانت وحيدة

46
00:04:39,300 --> 00:04:40,590
ما الأمر يا ناتسومي؟

47
00:04:40,590 --> 00:04:42,860
وجهك شاحب

48
00:04:42,860 --> 00:04:46,380
جعلتموني أسهر طوال اللّيل

49
00:04:46,550 --> 00:04:49,310
!تاكاشي-كن، حان وقت الفطور

50
00:04:49,800 --> 00:04:50,990
حسناً

51
00:04:51,930 --> 00:04:55,770
لم يعُد يؤرقني ذلك الآن

52
00:04:53,930 --> 00:04:55,310
صباح الخير

53
00:04:55,720 --> 00:04:57,240
صباح الخير يا تاكاشي

54
00:04:56,580 --> 00:04:58,850
،بسبب هؤلاء الّذين التقيتُ بهم

55
00:04:57,690 --> 00:04:59,070
صباح الخير يا تاكاشي-كن

56
00:04:58,850 --> 00:05:00,940
أنا متأكّد بأنّ ذلك لن يؤرقني

57
00:05:02,330 --> 00:05:05,790
يمكنني نسيان كلّ الألم الآن

58
00:05:03,150 --> 00:05:04,400
لنأكل

59
00:05:12,380 --> 00:05:16,340
عمّاذا تبحث يا ناتسومي؟

60
00:05:18,980 --> 00:05:19,960
هذه هي

61
00:05:20,510 --> 00:05:22,550
كانت داخل هذه

62
00:05:24,190 --> 00:05:25,460
ما هذه؟

63
00:05:30,060 --> 00:05:33,140
هذه صورة والدَي

64
00:05:33,140 --> 00:05:35,450
لم أكن أعلم بأنّ لديك واحدة

65
00:05:35,450 --> 00:05:39,130
أعتقد لا ضير أن ألقي نظرة إليها الآن

66
00:05:39,130 --> 00:05:40,360
!تاكاشي-كن

67
00:05:40,900 --> 00:05:43,110
!جاء أصدقاؤك

68
00:05:45,460 --> 00:05:46,570
!قادم

69
00:05:49,960 --> 00:05:51,360
مياه صودا؟

70
00:05:51,670 --> 00:05:54,120
تقصد كمشروب غازيّ؟

71
00:05:54,510 --> 00:05:55,630
أجل

72
00:05:55,630 --> 00:05:57,890
قال كيتاموتو بأنّه يعرف مكاناً

73
00:05:57,890 --> 00:06:00,240
تتدفّق فيه مياه صودا بشكلٍ طبيعيّ

74
00:06:00,950 --> 00:06:02,360
ما رأيك يا ناتسومي؟

75
00:06:03,200 --> 00:06:05,880
أنت من المدينة، لذا لا تصدّقني، صحيح؟

76
00:06:05,880 --> 00:06:08,050
نبع صودا؟

77
00:06:08,670 --> 00:06:11,360
...أعرف نبعين من السّاكي

78
00:06:11,360 --> 00:06:12,650
ساكي؟

79
00:06:13,990 --> 00:06:16,430
أحلم بذلك أحياناً

80
00:06:16,430 --> 00:06:18,220
أحلام غريبة

81
00:06:18,570 --> 00:06:20,190
حسناً، ما رأيك؟

82
00:06:20,190 --> 00:06:21,970
،لِمَ لا تأتي معي غداً

83
00:06:21,970 --> 00:06:24,100
وتتحقّق من صحّة ذلك؟

84
00:06:24,100 --> 00:06:25,520
!إلى نبع مياه الصّودا

85
00:06:26,340 --> 00:06:27,320
أريد الذّهاب

86
00:06:27,320 --> 00:06:28,150
أنا أيضاً

87
00:06:28,550 --> 00:06:30,150
حسناً، حُسِم الأمر

88
00:06:31,130 --> 00:06:33,440
سيأتي نيشيمورا إلى هنا أيضاً

89
00:06:33,440 --> 00:06:35,400
قال بأنّه سيأتي إلى هنا لاحقاً
لأنّ لديه دوام في مدرسة الحشو

90
00:06:35,400 --> 00:06:36,850
نيشيمورا؟

91
00:06:36,850 --> 00:06:40,540
هذا غريب بالنّسبة لنيشيمورا، صحيح؟

92
00:06:40,930 --> 00:06:42,480
لنُخِفه

93
00:06:42,480 --> 00:06:43,670
سأختبئ في مكانٍ ما

94
00:06:43,940 --> 00:06:45,230
تختبئ؟

95
00:06:45,230 --> 00:06:46,420
لماذا؟

96
00:06:50,560 --> 00:06:52,150
هيّا، لِمَ لا؟

97
00:06:52,150 --> 00:06:54,180
حسناً، سأختبئ هنا

98
00:06:54,830 --> 00:06:56,180
!قادمة

99
00:06:59,360 --> 00:07:01,490
أجل، هذا هو منزل فوجيوارا

100
00:07:02,700 --> 00:07:04,260
!لن يجدني هنا

101
00:07:03,220 --> 00:07:06,460
تاكاشي-كن، المعذرة

102
00:07:06,460 --> 00:07:07,740
هل لي بقليل من وقتك؟

103
00:07:07,740 --> 00:07:08,940
نعم، حسناً

104
00:07:09,720 --> 00:07:11,780
تلقّيتُ مكالمة من تاتشيبانا-سان

105
00:07:13,340 --> 00:07:17,270
يقول بأنّه يريد التكلّم معك مباشرة

106
00:07:18,720 --> 00:07:20,040
سأذهب

107
00:07:26,230 --> 00:07:27,600
المعذرة يا توكو-سان

108
00:07:28,450 --> 00:07:30,650
من تاتشيبانا-سان؟

109
00:07:33,580 --> 00:07:37,050
إنّه قريب. عاش تاكاشي معه عندما كان صغيراً

110
00:07:37,050 --> 00:07:40,040
يهتمّ بالمنزل الّذي عاش فيه تاكاشي ووالداه

111
00:07:40,040 --> 00:07:42,500
في صغره

112
00:07:44,020 --> 00:07:44,930
أجل

113
00:07:45,690 --> 00:07:47,330
أجل... أنا بخير

114
00:07:47,730 --> 00:07:49,110
هل من مُشكلة؟

115
00:07:51,670 --> 00:07:53,610
المنزل؟

116
00:07:53,890 --> 00:07:57,430
أجل، أعتقد وجدنا مُشترياً أخيراً

117
00:07:57,430 --> 00:07:58,920
ما رأيك يا تاكاشي؟

118
00:08:00,160 --> 00:08:04,070
ذلك المنزل لا ينفعك في شيء، أليس كذلك؟

119
00:08:04,620 --> 00:08:06,650
أنت تعيش حياة كريمة هناك، صحيح؟

120
00:08:07,410 --> 00:08:08,630
أجل

121
00:08:09,900 --> 00:08:11,420
هذا صحيح

122
00:08:12,040 --> 00:08:15,380
إنّه ليس شيئاً يمكنني فعل شيء حياله

123
00:08:15,870 --> 00:08:16,980
أجل

124
00:08:16,980 --> 00:08:21,620
،أتصوّر بأنّك بالكاد تتذكّر ذلك

125
00:08:22,390 --> 00:08:26,060
،لكن ارتأيتُ بأنّني ينبغي أن أتّصل بك

126
00:08:26,610 --> 00:08:29,300
وذلك كي أتمكّن من مُتابعة الإجراءات، صحيح؟

127
00:08:30,560 --> 00:08:31,820
أجل

128
00:08:32,340 --> 00:08:34,860
ستتمكّن مع ذلك من الزّيارة لأسبوعين آخرين

129
00:08:35,850 --> 00:08:39,710
إذا أردت، يمكنك أن تودّعه قبل أن يُباع

130
00:08:49,110 --> 00:08:50,320
توكو-سان؟

131
00:08:50,320 --> 00:08:53,010
ماذا أراد تاتشيبانا-سان؟

132
00:08:54,030 --> 00:08:55,870
حدّثَني عن منزلي

133
00:08:55,870 --> 00:08:59,370
إنّه منزل صغير، لكن كان مهجوراً لسنوات

134
00:08:59,370 --> 00:09:02,430
قال بأنّه وجد مُشترياً أخيراً

135
00:09:03,470 --> 00:09:04,790
لا تقلقي

136
00:09:04,790 --> 00:09:08,100
سيتولّى كافّة الإجراءات

137
00:09:08,400 --> 00:09:11,360
...يا إلهي... لكن

138
00:09:12,680 --> 00:09:13,860
لا عليكِ

139
00:09:14,980 --> 00:09:16,560
!مرحباً

140
00:09:16,560 --> 00:09:18,510
إنّه نيشيمورا

141
00:09:20,040 --> 00:09:21,240
تأخّرت

142
00:09:21,240 --> 00:09:22,970
آسف

143
00:09:22,970 --> 00:09:24,120
سمعتُ بأنّك تداوم في مدرسة حشو

144
00:09:25,080 --> 00:09:26,370
!ها أنا ذا

145
00:09:28,270 --> 00:09:30,380
ماذا، أين كيتاموتو؟

146
00:09:36,860 --> 00:09:38,270
ما هذا؟

147
00:09:38,270 --> 00:09:40,090
هل أنت طفل؟

148
00:09:43,830 --> 00:09:46,890
لكن يا ناتسومي، ما هذا؟

149
00:09:46,890 --> 00:09:48,350
في الجزء الخلفيّ من الخزانة

150
00:09:48,870 --> 00:09:50,740
ما الأمر؟

151
00:09:50,740 --> 00:09:51,990
لا داعي لإلقاء نظرة

152
00:09:51,990 --> 00:09:53,870
!نيشيمورا

153
00:09:53,870 --> 00:09:55,230
يراودني فضول

154
00:09:55,230 --> 00:09:56,260
حتّى أنت يا تانوما؟

155
00:09:56,720 --> 00:09:58,400
ممتاز يا تانوما

156
00:09:58,690 --> 00:09:59,980
!مـ-مهلاً

157
00:09:59,980 --> 00:10:01,240
!توقّفوا

158
00:10:01,240 --> 00:10:02,330
ما الأمر؟

159
00:10:02,330 --> 00:10:04,910
!توقّفوا! لحظة! قلتُ لحظة

160
00:10:05,860 --> 00:10:07,040
ما هذه؟

161
00:10:12,620 --> 00:10:14,100
ماذا؟

162
00:10:14,100 --> 00:10:16,440
لماذا هي هناك؟

163
00:10:16,840 --> 00:10:18,920
...في الحقيقة

164
00:10:18,920 --> 00:10:21,870
إذا وضعتُها في مكان يستطيع
،النّاس رؤيتهم فيه

165
00:10:21,870 --> 00:10:23,260
فسيكون ذلك مُحرِجاً

166
00:10:23,730 --> 00:10:26,010
أجل، لكن هل هذا يعني بأنّك
ينبغي أن تعلّقهم في الخزانة؟

167
00:10:27,060 --> 00:10:29,520
انسوا الأمر

168
00:10:29,860 --> 00:10:31,540
ماذا سنفعل غداً؟

169
00:10:31,540 --> 00:10:32,800
ما رأيك بمياه الصّودا؟

170
00:10:32,800 --> 00:10:35,000
سنذهب لرؤية مياه الصّودا؟

171
00:10:35,000 --> 00:10:35,940
أجل

172
00:10:36,340 --> 00:10:38,460
بجدّية؟

173
00:10:38,460 --> 00:10:40,150
ما زلت تشكّك في ذلك؟

174
00:10:40,590 --> 00:10:42,620
حسناً، أتطلّع قُدماً لذلك

175
00:10:42,620 --> 00:10:46,030
إنّها مليئة بالفُقاعات الّتي تتفرقع بهذا الشّكل

176
00:10:47,940 --> 00:10:49,820
أحضروا مطرة

177
00:10:49,820 --> 00:10:51,410
وتناولوا الغداء أوّلاً

178
00:10:52,030 --> 00:10:54,150
سنلتقي هنا على الواحدة

179
00:10:54,150 --> 00:10:54,950
أجل

180
00:10:54,240 --> 00:10:56,140
حسناً، السّاعة الواحدة

181
00:10:54,950 --> 00:10:56,330
لا تتأخّروا

182
00:10:59,440 --> 00:11:00,700
!وداعاً

183
00:11:00,700 --> 00:11:02,430
!نراك غداً على السّاعة الواحدة

184
00:11:07,340 --> 00:11:10,570
يبدو يوم غد مُمتعاً. أليس كذلك يا سينسي؟

185
00:11:11,650 --> 00:11:15,190
هل أنت متأكّد بشأن منزلك؟

186
00:11:16,020 --> 00:11:17,690
أجل يا سينسي

187
00:11:18,030 --> 00:11:21,670
أهمّ مكان بالنّسبة لي الآن هو هذا

188
00:11:22,270 --> 00:11:25,930
فضلاً عن ذلك، يكلّفني المال لصيانته

189
00:11:26,840 --> 00:11:31,840
نسيتُ تقريباً كلّ ما حدث هناك

190
00:11:31,840 --> 00:11:34,580
إذاً تتذكّر بعضاً منه

191
00:11:37,050 --> 00:11:42,070
لا أتذكّر أمّي، بما أنّها ماتت
،بعد ولادتي بفترة قصيرة

192
00:11:42,640 --> 00:11:45,340
لكن أتذكّر القليل عن أبي

193
00:11:45,810 --> 00:11:48,050
ربّاني بمفرده

194
00:11:48,850 --> 00:11:50,800
لكن كان ذلك لبضع سنوات فقط

195
00:11:51,590 --> 00:11:53,510
،كان يربت على رأسي

196
00:11:54,110 --> 00:11:56,020
،أو يضعني على ركبتيه

197
00:11:56,020 --> 00:11:59,120
...وكنّا نجلس على الشّرفة لساعات

198
00:12:04,720 --> 00:12:06,690
،تذكّر ذلك يؤلمني

199
00:12:06,690 --> 00:12:11,230
لذا حاولتُ قدر المستطاع نسيان ذلك

200
00:12:12,050 --> 00:12:15,420
ثمّ مع الزّمن، نسيتُ بالفعل

201
00:12:16,570 --> 00:12:19,070
لذا أنا بخير الآن

202
00:12:22,000 --> 00:12:26,660
لم أستطع تحمُّل رؤية هذه الصّورة

203
00:12:26,660 --> 00:12:28,890
والآن أستطيع

204
00:12:32,650 --> 00:12:34,690
لا مُشكلة

205
00:12:37,370 --> 00:12:40,570
هناك أشياء لا يمكنك الحصول عليها
مهما كانت شدّة رغبتك لها

206
00:12:41,090 --> 00:12:44,830
لذا من الأسهل نسيانها فحسب يا سينسي

207
00:12:46,230 --> 00:12:47,390
أليس كذلك؟

208
00:12:54,510 --> 00:12:55,530
أين هو؟

209
00:12:56,070 --> 00:12:58,240
أين منزلي؟

210
00:12:58,870 --> 00:13:00,310
لا أعلم

211
00:13:00,310 --> 00:13:01,490
لا أستطيع الذّهاب إلى المنزل

212
00:13:04,980 --> 00:13:06,600
نسيت

213
00:13:07,140 --> 00:13:10,790
حاولتُ جاهداً ألّا أنسى، ومع ذلك
نسيتُ أين أعيش

214
00:13:34,660 --> 00:13:37,670
تاكاشي-كن، وصل أصدقاؤك

215
00:13:37,670 --> 00:13:38,820
!حسناً

216
00:13:41,970 --> 00:13:43,820
سينسي، استيقظ

217
00:13:43,820 --> 00:13:44,720
سنغادر

218
00:13:48,420 --> 00:13:50,160
وداعاً يا تاكاشي-كن

219
00:13:51,010 --> 00:13:52,000
إلى اللّقاء

220
00:13:54,880 --> 00:13:55,720
مرحباً يا رِفاق

221
00:13:55,720 --> 00:13:56,780
ها هو

222
00:13:56,780 --> 00:13:57,530
لننطلق

223
00:13:57,530 --> 00:13:58,620
أجل

224
00:14:04,530 --> 00:14:06,560
الحرّ شديد اليوم

225
00:14:07,510 --> 00:14:09,890
أهذا هو الطّريق فعلاً؟

226
00:14:10,390 --> 00:14:13,910
وفقاً للخريطة الّتي رسمتُها عندما
كنتُ طفلاً، فهو هذا

227
00:14:15,320 --> 00:14:16,770
هذه خريطة؟

228
00:14:17,130 --> 00:14:19,610
أوّلاً، أين الشّمال وأين الجنوب؟

229
00:14:19,610 --> 00:14:21,900
لا تُدقِّق في التّفاصيل

230
00:14:21,900 --> 00:14:24,900
إذا وصلنا إلى هناك باتباع الخريطة
فحسب، فلن تُسمّى خريطة حينها

231
00:14:24,900 --> 00:14:25,990
تفاصيل؟

232
00:14:25,990 --> 00:14:30,160
قلتُ لكم بأنّ الوصول إلى هناك
من الطّريق سيكون أسهل

233
00:14:30,160 --> 00:14:33,680
لكن الذّهاب إلى هناك عبر درّاجاتنا
مباشرة ليس مُغامرة

234
00:14:33,680 --> 00:14:34,600
ماذا؟

235
00:14:34,600 --> 00:14:35,960
كان بمقدورنا ركوب درّاجاتنا؟

236
00:14:35,960 --> 00:14:36,690
اصمت

237
00:14:36,690 --> 00:14:38,340
تحتاج أن تعزّز لياقتك يا ناتسومي

238
00:14:39,720 --> 00:14:41,170
!وكذلك أنت يا تانوما

239
00:14:42,060 --> 00:14:43,820
أجل، أجل

240
00:14:43,820 --> 00:14:45,850
على أيّ حال، لنستمرّ في التقدُّم

241
00:14:48,290 --> 00:14:51,100
الضّياع ممتع أيضاً

242
00:14:51,770 --> 00:14:55,500
ذلك المنزل لا ينفعك في شيء، أليس كذلك؟

243
00:14:59,340 --> 00:15:00,320
ناتسومي؟

244
00:15:05,730 --> 00:15:07,100
...بشأن الأمس

245
00:15:07,500 --> 00:15:08,640
...لا

246
00:15:08,640 --> 00:15:11,580
،عندما كنتُ طفلاً

247
00:15:11,580 --> 00:15:13,120
بنيتُ قاعدة سرّية في خزانتي

248
00:15:14,340 --> 00:15:15,790
هذا من جديد؟

249
00:15:16,400 --> 00:15:20,440
وضعتُ ما كان يهمّني في الخزانة أيضاً

250
00:15:20,440 --> 00:15:22,300
ذلك ذكّرني في الأمر

251
00:15:23,780 --> 00:15:26,090
أي طريق سنسلك الآن؟

252
00:15:26,090 --> 00:15:28,020
لا أدري

253
00:15:28,020 --> 00:15:29,290
!أنت من رسمها

254
00:15:29,290 --> 00:15:30,640
انتظر، انتظر. أمهلني لحظة

255
00:15:30,640 --> 00:15:33,830
هل تعتقد بأنّنا سنصل إلى هناك أساساً؟

256
00:15:32,030 --> 00:15:34,820
الخريطة. انظر إلى الخريطة

257
00:15:41,900 --> 00:15:43,300
...تاكاشي

258
00:15:45,950 --> 00:15:48,070
تاكاشي، انظر إلى هذه

259
00:15:48,620 --> 00:15:49,650
رأيت؟

260
00:15:49,650 --> 00:15:51,700
إنّها هناك

261
00:15:52,520 --> 00:15:56,780
زرعتْ أمُّك بذوراً

262
00:15:57,440 --> 00:15:59,340
كانت سعيدة جدّاً بامتلاك حديقة

263
00:15:59,340 --> 00:16:02,690
زرعَتِ البذورَ سرّاً لإسعادنا

264
00:16:04,390 --> 00:16:08,060
آمل أن تتفتح ثانية في هذا
العام يا تاكاشي

265
00:16:09,100 --> 00:16:10,010
لا

266
00:16:11,140 --> 00:16:12,700
لا أستطيع تذكّر ذلك

267
00:16:13,260 --> 00:16:15,600
لا يمكنني العودة إلى هناك

268
00:16:16,090 --> 00:16:17,520
إنّه فارغ الآن

269
00:16:22,110 --> 00:16:23,370
لا بأس

270
00:16:23,370 --> 00:16:24,530
هذا لا يؤلمني

271
00:16:26,130 --> 00:16:27,390
اِنسَ

272
00:16:33,080 --> 00:16:35,930
كأنّني شممتُ رائحة لذيذة

273
00:16:35,930 --> 00:16:37,660
!إنّه بشريّ

274
00:16:37,660 --> 00:16:38,530
!انتظر

275
00:16:38,530 --> 00:16:41,880
لا أصدِّق بأنّني وجدتُ وليمة
!في مكان قصيّ كهذا

276
00:16:42,250 --> 00:16:44,510
!شهيّ

277
00:16:44,980 --> 00:16:46,010
يا إلهي

278
00:16:46,010 --> 00:16:47,260
!ارحل

279
00:16:51,060 --> 00:16:52,080
سينسي

280
00:16:52,080 --> 00:16:54,170
أحمق، ما مشكلتك؟

281
00:16:54,170 --> 00:16:57,050
كان بوسعك أن تضربه وتُغميه عن الوعي

282
00:16:57,050 --> 00:16:58,050
آسف

283
00:16:58,840 --> 00:17:01,320
ما خطبك؟

284
00:17:01,820 --> 00:17:03,310
...صحيح

285
00:17:03,310 --> 00:17:05,480
أرخيتُ دفاعي

286
00:17:05,480 --> 00:17:07,150
هذا لأنّني كنتُ أنظر إلى هذه الصّورة

287
00:17:09,250 --> 00:17:10,510
!اختفت الصّورة

288
00:17:10,510 --> 00:17:11,350
ماذا؟

289
00:17:11,350 --> 00:17:12,560
اختفت

290
00:17:12,560 --> 00:17:14,230
متى سقطت منّي؟

291
00:17:14,230 --> 00:17:16,500
لا تعلم متى أسقطتها؟

292
00:17:16,500 --> 00:17:19,250
سيكون من المستحيل إيجادها
في وسط الغابة

293
00:17:23,630 --> 00:17:24,880
!ناتسومي

294
00:17:24,880 --> 00:17:26,810
إلى أين ذهبت يا ناتسومي؟

295
00:17:26,810 --> 00:17:28,290
ها هو

296
00:17:28,290 --> 00:17:29,740
ماذا حدث يا ناتسومي؟

297
00:17:29,740 --> 00:17:31,010
تعثّرت؟

298
00:17:31,280 --> 00:17:32,510
أنا مُطمئنّ

299
00:17:32,890 --> 00:17:34,630
هل أنت بخير يا ناتسومي؟

300
00:17:34,630 --> 00:17:35,840
وجدتُ الطّريق

301
00:17:35,840 --> 00:17:36,760
هيّا بنا

302
00:17:40,940 --> 00:17:42,040
حسناً

303
00:17:42,040 --> 00:17:43,390
هيّا بنا

304
00:17:43,390 --> 00:17:45,970
أخفتني باختفائك للتو

305
00:17:46,650 --> 00:17:47,820
آسف، آسف

306
00:17:47,820 --> 00:17:49,850
أنت مُتّسخ تماماً

307
00:17:49,850 --> 00:17:51,040
أجل

308
00:17:52,790 --> 00:17:54,740
ناتسومي يعاني

309
00:17:54,740 --> 00:17:57,890
المزيد من الأمور المُتعلِّقة
باليوكاي يا سينسي؟

310
00:17:58,900 --> 00:18:01,540
لا، فقدَ صورة

311
00:18:02,840 --> 00:18:04,540
صورة لوالديه

312
00:18:06,440 --> 00:18:08,210
هل أنت متأكّد من هذا؟

313
00:18:08,210 --> 00:18:09,910
...أعتقد كانت تلك الشّجرة

314
00:18:09,910 --> 00:18:11,340
ما الّذي سقط منك؟

315
00:18:11,740 --> 00:18:12,880
...تانوما

316
00:18:13,240 --> 00:18:14,780
نيشيمورا. كيتاموتو

317
00:18:14,780 --> 00:18:16,740
يبدو أنّ ناتسومي أسقطَ شيئاً

318
00:18:16,740 --> 00:18:17,920
ساعداني في البحث عنه

319
00:18:17,920 --> 00:18:19,690
أسقطت شيئاً؟

320
00:18:19,690 --> 00:18:20,280
...لا

321
00:18:20,280 --> 00:18:22,690
أحمق، لِمَ لم تخبرنا بذلك؟

322
00:18:22,690 --> 00:18:24,060
كنّا على وشك المُغادرة

323
00:18:24,450 --> 00:18:26,880
لا مُشكلة صدِّقوني

324
00:18:26,880 --> 00:18:27,950
يمكنني المجيء للبحث عنه لاحقاً

325
00:18:27,950 --> 00:18:28,780
!ناتسومي

326
00:18:29,060 --> 00:18:33,410
!من الواضح من تعابير وجهك أنّك تكذب

327
00:18:35,680 --> 00:18:37,030
تعال يا ناتسومي

328
00:18:37,930 --> 00:18:39,790
لا تكذب إن لم تكن مضطرّاً لذلك

329
00:18:48,640 --> 00:18:49,800
أنا آسف

330
00:18:50,400 --> 00:18:52,090
هلّا ساعدتموني في البحث؟

331
00:18:52,490 --> 00:18:54,770
تلك الصّورة هامّة بالنّسبة لي

332
00:18:56,710 --> 00:18:59,130
...إنّها هامّة حقّاً

333
00:19:01,860 --> 00:19:03,290
وجدتها؟

334
00:19:03,290 --> 00:19:04,830
لا

335
00:19:05,990 --> 00:19:07,200
ماذا؟

336
00:19:07,610 --> 00:19:09,220
ما هذا؟ مجلّة إباحيّة

337
00:19:09,220 --> 00:19:10,110
ماذا؟

338
00:19:16,030 --> 00:19:17,740
أنت تعترض طريقي يا بونتا

339
00:19:19,940 --> 00:19:21,500
!وجدتُها! وجدتُها

340
00:19:23,600 --> 00:19:25,460
أهذه هي يا ناتسومي؟

341
00:19:33,470 --> 00:19:35,280
...نظرتُ إليها

342
00:19:35,280 --> 00:19:37,970
أهذه أمّك؟

343
00:19:38,520 --> 00:19:40,220
إنّها تشبهك بالفعل

344
00:19:41,370 --> 00:19:43,720
يبدو أنّهما لطيفان

345
00:19:45,990 --> 00:19:47,030
أجل

346
00:19:48,340 --> 00:19:50,780
شكراً يا شباب

347
00:19:56,030 --> 00:19:59,710
،هذه صورة لهما

348
00:20:00,340 --> 00:20:02,500
منذ ما قبل ولادتي

349
00:20:03,610 --> 00:20:05,530
،كلّما رأيتُ ابتسامتهما اللّطيفة

350
00:20:05,530 --> 00:20:10,120
...وتخيّلتُ نفسي بجانبهما أبتسم أيضاً

351
00:20:10,880 --> 00:20:13,900
لا أنفك أبكي

352
00:20:15,060 --> 00:20:18,680
إنّها مؤلمة جدّاً لدرجة أنّني أردتُ النّسيان

353
00:20:23,230 --> 00:20:24,000
ماذا؟

354
00:20:24,440 --> 00:20:25,890
إنّهما ساسادا وتاكي

355
00:20:25,890 --> 00:20:27,230
تاكي-سان؟

356
00:20:27,730 --> 00:20:29,530
!تاكي-سان

357
00:20:29,530 --> 00:20:30,640
!هنا

358
00:20:31,410 --> 00:20:34,750
ما الأمر؟ نادراً ما أراكما معاً

359
00:20:34,750 --> 00:20:35,900
التقيتُ بها هناك فحسب

360
00:20:36,170 --> 00:20:37,030
صحيح؟

361
00:20:37,030 --> 00:20:38,140
أجل

362
00:20:38,140 --> 00:20:42,780
أردنا نفس الأسطوانة، لذا قرّرنا
التّناوب على الاستماع لها

363
00:20:43,250 --> 00:20:44,910
أين كنتم؟

364
00:20:45,130 --> 00:20:46,960
جميعكم مُتّسخون

365
00:20:47,480 --> 00:20:49,500
مُغامرة فتيان

366
00:20:49,820 --> 00:20:51,120
ماذا؟

367
00:20:51,120 --> 00:20:54,070
ذهبنا لرؤية نبع مياه صودا

368
00:20:54,070 --> 00:20:55,720
!نبع مياه صودا؟

369
00:20:57,260 --> 00:21:00,930
!لا تضحكا! كان مليئاً بالفُقاعات

370
00:21:00,930 --> 00:21:02,600
هل وجدتموه فعلاً؟

371
00:21:02,900 --> 00:21:04,370
...في الحقيقة

372
00:21:04,370 --> 00:21:06,390
سنعود

373
00:21:06,630 --> 00:21:09,080
تهتُم، أليس كذلك؟

374
00:21:09,080 --> 00:21:11,890
عليكم أن تعرفوا الاتِّجاهات أوّلاً

375
00:21:11,890 --> 00:21:12,930
صحيح؟

376
00:21:13,950 --> 00:21:15,900
...منفوش... منفوش

377
00:21:18,760 --> 00:21:20,240
!منفوش

378
00:21:27,380 --> 00:21:29,450
أهلاً بعودتك يا تاكاشي-كن

379
00:21:29,450 --> 00:21:32,420
كيف اتّسخت هكذا؟

380
00:21:33,000 --> 00:21:35,310
سقط منّي شيء

381
00:21:35,310 --> 00:21:37,340
ساعدني الجميع في البحث عنه

382
00:21:38,240 --> 00:21:39,410
وهل وجدتموه؟

383
00:21:39,890 --> 00:21:40,970
أجل

384
00:21:41,320 --> 00:21:43,320
هكذا إذاً. يسرّني ذلك

385
00:21:43,320 --> 00:21:45,370
اذهب وبدِّل ملابسك

386
00:21:45,370 --> 00:21:47,070
لا بدّ أنّك جائع

387
00:21:47,070 --> 00:21:48,060
حسناً

388
00:21:53,210 --> 00:21:54,900
هيّا يا ناتسومي

389
00:21:55,610 --> 00:21:57,620
لا تكذب إذا لم تكن مُلزَماً

390
00:22:00,410 --> 00:22:01,570
،شيغيرو-سان

391
00:22:01,570 --> 00:22:02,670
توكو-سان

392
00:22:07,940 --> 00:22:12,700
أريد رؤية منزل والدَي مرّة
أخيرة قبل أن يُباع

393
00:22:15,130 --> 00:22:17,570
هل يمكنني الذّهاب؟

394
00:22:21,960 --> 00:22:24,470
أجل، بالطّبع

395
00:22:25,550 --> 00:22:28,200
سننتظر عودتك يا تاكاشي-كن

396
00:24:01,490 --> 00:24:03,100
لديّ مكان عليّ زيارته أوّلاً

397
00:24:03,100 --> 00:24:05,540
لديك دوماً أماكن تزورها

398
00:24:05,540 --> 00:24:07,160
!انتظر لحظة

399
00:24:07,950 --> 00:24:09,700
هل سيصل إلى هناك أصلاً؟

400
00:24:09,700 --> 00:24:12,910
!كانت أمّي وأبي لطيفين معك

401
00:24:12,910 --> 00:24:15,350
...سأعود إلى المنزل الّذي أحبّه