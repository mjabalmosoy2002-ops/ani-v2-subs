1
00:00:02,080 --> 00:00:07,070
،مضى نصف عام منذ جدالي مع بوتّاكولي

2
00:00:07,070 --> 00:00:08,520
رئيس العيادة الكبرى في البلدة

3
00:00:14,590 --> 00:00:15,780
!شكراً على الطعام

4
00:00:31,450 --> 00:00:35,930
،بوضع كلّ الأمور في الحسبان
تطوّرت جسمانيّاً حقّاً، صحيح؟

5
00:00:36,800 --> 00:00:38,080
بالفعل

6
00:00:38,080 --> 00:00:42,140
،أنا واثق أنّك عندما تمشي في الخارج
لن يُدرك أحدٌ بأنّك مُعالِج

7
00:00:42,750 --> 00:00:46,150
أجل، لأنّ المُعالجين عادةً لا يتدرّبون لأجل القتال

8
00:00:46,710 --> 00:00:48,110
حسناً، حان الوقت

9
00:00:48,110 --> 00:00:52,320
وحتّى بدأتُ أتجاوز خوفي من السّيوف مؤخّراً

10
00:00:53,110 --> 00:00:55,610
ربّما لأنّني جُرِحتُ مرّات كثيرة

11
00:00:55,610 --> 00:00:56,450
ماذا؟

12
00:00:56,450 --> 00:00:59,630
،أجل، تفاجئني وتحاول توقُّع هجماتي

13
00:00:59,630 --> 00:01:01,840
لذلك تُجرَح قليلاً أحياناً

14
00:01:01,840 --> 00:01:06,040
لكن بفضل ذلك، أنا واثقٌ على الأقلّ
من أنّني أستطيع حماية حياتي

15
00:01:06,420 --> 00:01:10,430
ما الّذي أتوقّعه غير ذلك من مدرّب شيطانيّ
وتلميذه المهووس الزّومبي؟

16
00:01:10,430 --> 00:01:13,930
هلّا استبعدتَ "مهووس زومبي" من الجملة رجاء؟

17
00:01:13,930 --> 00:01:18,140
وما الشّيطانيّ فيّي؟ أنا مُعلّم رقيق جدّاً

18
00:01:18,140 --> 00:01:20,640
رقيق؟ أنت؟

19
00:01:20,640 --> 00:01:22,120
!بكُل معنى الكلمة

20
00:01:23,580 --> 00:01:25,140
!لوشييل-كن

21
00:01:25,980 --> 00:01:27,990
وصلَتْك رسالة

22
00:01:27,990 --> 00:01:29,480
شكراً جزيلاً لكِ

23
00:01:29,480 --> 00:01:32,340
!"تقول "لوشييل-كن

24
00:01:32,340 --> 00:01:36,050
مهلاً. متى أصبحتُما مُقرّبين جدّاً؟

25
00:01:36,960 --> 00:01:38,870
!هذا ليس بالشّيء المُميّز

26
00:01:38,870 --> 00:01:44,120
هذا صحيح! مضى على وجود لوشييل-كن هنا
وقت طويل، ونحن في نفس السنّ تقريباً

27
00:01:44,120 --> 00:01:47,050
وبعد؟ مِمَّن الرّسالة؟

28
00:01:47,050 --> 00:01:49,670
إنّه... ماذا؟

29
00:01:52,420 --> 00:01:54,810
كنيسة شورول المُقدّسة

30
00:01:55,260 --> 00:01:56,970
مقرّ النّقابة؟

31
00:02:00,530 --> 00:02:04,780
الإكليركيّ العظيم

32
00:02:01,660 --> 00:02:04,830
دربُ مُوظَّف للنجاة في عالم آخر

33
00:03:28,970 --> 00:03:30,300
سوف أقرأها

34
00:03:28,970 --> 00:03:34,230
الحلقة 6 - في رحلة

35
00:03:31,110 --> 00:03:32,120
:إشعار

36
00:03:32,120 --> 00:03:38,670
إلى لوشييل من فرع نقابة المُعالجين ميرّاتوني

37
00:03:38,670 --> 00:03:44,310
أنت مدعو للعمل في مقرّ كنيسة شورول المُقدّسة

38
00:03:45,470 --> 00:03:49,110
،هذا استثنائيّ، لكن بموهبتك وجهودك

39
00:03:49,110 --> 00:03:51,660
بلغتَ المستوى 5 من الميول السّحري
المُقدّس عن عمر صغير

40
00:03:51,660 --> 00:03:55,890
تلقّينا توصية تثني على جهودك لإنقاذ الأرواح

41
00:03:55,890 --> 00:03:58,040
وبالتّالي توصّلنا إلى هذا القرار

42
00:03:58,580 --> 00:04:02,930
،بما أنّك مُعيّن حاليّاً في نقابة المُغامرين

43
00:04:02,930 --> 00:04:06,880
نطلب منك الانتقال في الشّهر السّادس
،من العام الجاري

44
00:04:06,880 --> 00:04:10,060
عقب انتهاء صلاحيّة تعيينك هناك

45
00:04:10,060 --> 00:04:14,330
"بتوقيع" البابا فلونا ألّوديل دي شورول

46
00:04:14,850 --> 00:04:19,150
نالَ منّا. لم أتوقّع أن يلجأ إلى هذه الطريقة

47
00:04:19,150 --> 00:04:20,730
ماذا تقصد؟

48
00:04:20,730 --> 00:04:22,850
إنّه بوتّاكولي

49
00:04:22,850 --> 00:04:26,700
عَلِمَ بأنّ نقابة المُغامرين كانت تحميك هنا

50
00:04:26,700 --> 00:04:28,820
وقرّر تدبير نقلك إلى المقرّ

51
00:04:28,820 --> 00:04:29,700
ماذا؟

52
00:04:30,070 --> 00:04:36,040
لكنّه لا يستهدفك فعليّاً. يحاول حظر
كلّ الشّفاء في النّقابة

53
00:04:36,040 --> 00:04:39,430
لهذا يُرسلني إلى المقرّ؟

54
00:04:39,790 --> 00:04:43,010
ترقية؟ مجرّد انتقال؟

55
00:04:43,010 --> 00:04:45,680
على الأقلّ ما زال أمامنا نصف عام

56
00:04:45,680 --> 00:04:48,630
،في ذلك الوقت، مع تدريبك الإسبرطيّ

57
00:04:48,630 --> 00:04:51,640
ستستمرّ في مُعالجة المرضى المحتاجين

58
00:04:51,980 --> 00:04:55,650
ولا قيود على عدد الأشخاص ذوي الجروح الخفيفة

59
00:04:56,480 --> 00:04:58,040
!عُلم

60
00:05:00,210 --> 00:05:02,570
...قلتُ ذلك، لكن

61
00:05:03,100 --> 00:05:05,760
سحري لا يصمد

62
00:05:06,130 --> 00:05:09,860
على هذا المُعدّل، سوف أصبح زومبي حقّاً

63
00:05:10,260 --> 00:05:12,040
لوشييل؟

64
00:05:12,040 --> 00:05:14,120
هل ما زال بمقدورك مُعالجة النّاس؟

65
00:05:14,520 --> 00:05:16,990
هناك الكثير ينتظرون في الخارج

66
00:05:16,990 --> 00:05:19,150
...زالَ السّحر

67
00:05:19,150 --> 00:05:20,790
...أنا في حالة جفاف

68
00:05:21,240 --> 00:05:23,260
!لا داعي للقلق يا لوشييل

69
00:05:24,280 --> 00:05:25,320
غولغار-سان؟

70
00:05:25,320 --> 00:05:26,150
!بئساً

71
00:05:26,150 --> 00:05:27,340
...هذه الرّائحة

72
00:05:27,340 --> 00:05:32,560
المادّة أكس تساعدك أيضاً على
استعادة قليل من السّحر

73
00:05:32,560 --> 00:05:33,430
!تفضّل

74
00:05:33,430 --> 00:05:36,390
!ما-ماذا قلت؟

75
00:05:36,390 --> 00:05:39,980
!نخبكّ! اشرب واستمرّ في الشّفاء

76
00:05:41,940 --> 00:05:45,580
...هـ-هذا هو المهووس الزّومبي الّذي نعرفه

77
00:05:52,530 --> 00:05:53,330
أنت

78
00:05:56,000 --> 00:05:58,540
لماذا تبدو يافعاً جدّاً وبعضلات مُفصّلة؟

79
00:06:01,750 --> 00:06:03,970
فاجأني ذلك أيضاً

80
00:06:03,970 --> 00:06:08,320
بينما كنتُ أدرّب ذلك الفتى، وصلَتْ
مهارة فنوني القتاليّة للمستوى 7

81
00:06:08,320 --> 00:06:10,340
هذا مُبهر

82
00:06:10,340 --> 00:06:16,560
الرّجل الّذي يُطلِقون عليه بالزّوبعة، بمهارات سرعة
وفنون قتاليّة بتصنيف س، أصبح أقوى حتّى؟

83
00:06:17,640 --> 00:06:20,060
الزّوبعة

84
00:06:18,270 --> 00:06:19,740
هذا كلُّه في الماضي

85
00:06:20,320 --> 00:06:24,700
لو أجّلت التّقاعد فترة أطول، لبلغت
حتّى التّصنيف س.س

86
00:06:24,700 --> 00:06:26,440
هذا غير مهمّ

87
00:06:26,440 --> 00:06:31,210
بالمناسبة، كان لوشييل يشرب
،ذلك الشّيء طوال الوقت

88
00:06:31,210 --> 00:06:33,160
لكن هل تعرف ماذا يفعل ذلك؟

89
00:06:34,760 --> 00:06:37,890
وفق النّصوص القديمة إنّه يقوّي الجسم

90
00:06:37,890 --> 00:06:41,440
ويحسّن المهارات بشكل أسهل

91
00:06:43,150 --> 00:06:45,590
لكن لا أدري ما إن كان ذلك يفلح أم لا

92
00:06:45,590 --> 00:06:49,060
فات الأوان الآن على الطلبِ منه
التوقُّف عن شربه

93
00:06:49,470 --> 00:06:51,550
هل ذلك يشكّل تأثيراً فعلاً؟

94
00:06:53,620 --> 00:06:57,520
لا شكّ في أنّه أقوى الآن ممّا كان
عندما أتى أوّل مرّة إلى هنا

95
00:06:57,520 --> 00:07:02,730
أجل. رغم ذلك، من الجامح أن يتمكّن
من الاستمرار في شرب ذلك الهُراء

96
00:07:02,730 --> 00:07:06,480
تغدو أنفاسه نتِنة بعد أن يشرب منه

97
00:07:07,740 --> 00:07:10,570
...عندما يتحدّث مع مونيكا ونانايلا

98
00:07:10,930 --> 00:07:12,580
تفضّل! المعتاد

99
00:07:15,870 --> 00:07:17,150
!هذا كريه

100
00:07:18,590 --> 00:07:19,830
هذا ما يحدث

101
00:07:20,400 --> 00:07:22,640
لا تُزعج الفتى كثيراً

102
00:07:22,640 --> 00:07:25,410
هذا وقتٌ حسّاسٌ له. ماذا لو فقدَ صوابه؟

103
00:07:27,590 --> 00:07:29,820
!أتعتقد بأنّه سوف يضطرب؟

104
00:07:30,650 --> 00:07:31,800
!مستحيل

105
00:07:32,270 --> 00:07:35,030
برود وغولغار، ما الأخبار؟

106
00:07:35,030 --> 00:07:37,580
غالبا. تعمل بجدّ كالعادة حسبما أرى

107
00:07:37,580 --> 00:07:38,790
إطلاقاً

108
00:07:40,850 --> 00:07:43,330
أنيكي، هل تمانع شراب المِزر؟

109
00:07:43,330 --> 00:07:44,060
أكيد

110
00:07:44,060 --> 00:07:45,350
وبعد؟

111
00:07:45,350 --> 00:07:48,660
حسناً، سارت المُفاوضات على ما يُرام

112
00:07:48,660 --> 00:07:52,870
الآن بعد أن يصل إلى هناك، لا ينبغي أن نُستهدَف

113
00:07:52,870 --> 00:07:54,160
ومن يقف وراء هذا؟

114
00:07:54,160 --> 00:07:56,860
بوتّاكولي كما توقّعنا

115
00:07:58,120 --> 00:08:00,750
حسناً، ما هي الخطوة التّالية يا أنيكي؟

116
00:08:01,110 --> 00:08:02,210
...لنرَ

117
00:08:02,210 --> 00:08:06,290
يبدو أنّ كثيراً من المال يتدفّق
إلى رئيس نقابة المُعالجين

118
00:08:06,690 --> 00:08:09,630
أعتقد حان الوقت لأُفلِسهم

119
00:08:10,120 --> 00:08:13,560
لم أتوقّع أن أراك تطلق العنان
من جديد بعد تقاعدك

120
00:08:15,880 --> 00:08:20,770
مقارنة بما فعلتُه كمُغتال، أعتقد هذا أنظف بكثير

121
00:08:20,770 --> 00:08:26,270
،يراودني إحساس بأنّ لوشييل-كن مختلف عنّا قليلاً

122
00:08:26,270 --> 00:08:29,930
لكن إذا كان مُصمّماً جدّاً على البقاء لدرجة
،أنّه مستعدّ للمجيء إلى نقابتنا

123
00:08:29,930 --> 00:08:32,490
فلا بدّ أنّه جادٌّ حقّاً

124
00:08:35,310 --> 00:08:37,560
لا يمكنني أن أدع فتى كهذا وشأنه

125
00:08:38,040 --> 00:08:39,100
معك حقّ

126
00:08:40,620 --> 00:08:43,880
إلى أيّ مدى سيصبح أقوى برأيك
بعد نصف عام؟

127
00:08:43,880 --> 00:08:45,540
حسناً، إنّه في المستوى 1 الآن

128
00:08:45,540 --> 00:08:47,750
التّصنيف ي

129
00:08:45,950 --> 00:08:48,610
مُغامرو التّصنيف ي هم أكثر من يستطيع تولّي أمرهم

130
00:08:48,500 --> 00:08:52,760
الخِداع

131
00:08:48,610 --> 00:08:52,760
لكن بالخِداع، قد يتمكّن من مواجهة التّصنيف ج

132
00:08:50,250 --> 00:08:52,130
التّصنيف ج

133
00:08:52,760 --> 00:08:55,970
إذاً ما زال أمامه مساحة كبيرة للتطوّر

134
00:08:55,970 --> 00:08:58,100
لِمَ لا تدرّبه أيضاً؟

135
00:08:58,100 --> 00:09:02,190
إذا لم يتغيّر بعد بضع سنوات، فسأفكّر في الأمر

136
00:09:02,190 --> 00:09:04,980
!إذا درّبتَه أنت، سيموت

137
00:09:08,820 --> 00:09:14,570
بـ-بالمناسبة، ألا تعتقد بأنّ الوقت قد حان
كي يقع في الحبّ مرّة أو مرّتين؟

138
00:09:14,570 --> 00:09:16,700
لماذا غيّرَ الموضوع هكذا؟

139
00:09:17,200 --> 00:09:20,910
يبدو أنّ كلّ موظّفات الاستقبال مُعجبات بلوشييل

140
00:09:21,270 --> 00:09:24,290
يعتبرنَه أخاً أصغر فحسب

141
00:09:21,630 --> 00:09:23,040
!لوشييل-كن

142
00:09:23,040 --> 00:09:24,290
اهدأ، اهدأ

143
00:09:24,290 --> 00:09:26,870
،إنّه طويل بعض الشّيء ووجهه وسيم

144
00:09:26,870 --> 00:09:32,710
مهووس زومبي

145
00:09:27,180 --> 00:09:30,040
لكن الجميع ينادونه زومبي ومازوخيّ

146
00:09:27,180 --> 00:09:30,040
...اضربوني أكثر أرجوكم

147
00:09:30,360 --> 00:09:32,710
!ما زلتُ لا أقبل ذلك

148
00:09:34,240 --> 00:09:37,520
ألا يعزو الفضل لمُدرّبه الشّيطانيّ والطبّاخ الدّبّ؟

149
00:09:37,520 --> 00:09:38,530
!ماذا قلت؟

150
00:09:38,530 --> 00:09:40,230
!أفعل هذا من باب اللّطف

151
00:09:40,230 --> 00:09:42,740
!لا تصنّفني مع هؤلاء المتوحّشين

152
00:09:42,740 --> 00:09:44,890
من تنعته بالمُتوحّش؟

153
00:09:44,890 --> 00:09:47,500
!انتبه! تعامل مع أطباقي بحذر

154
00:09:47,500 --> 00:09:49,400
!أخبرتُك مئة مرّة

155
00:09:49,400 --> 00:09:50,930
!حسناً، أنا آسف

156
00:09:50,930 --> 00:09:52,760
!سأشتري لك واحداً جديداً في يوم إجازتي

157
00:09:52,760 --> 00:09:53,810
!حاليّاً، أريد آخر

158
00:09:53,810 --> 00:09:54,780
!من دواعي سروري

159
00:09:54,780 --> 00:09:56,240
!أشكرك

160
00:09:56,620 --> 00:09:59,330
بالمناسبة، هل أخبرتُك؟

161
00:09:59,740 --> 00:10:02,280
ماذا؟ طبيعة الفتيات اللّواتي أحبّهن؟

162
00:10:02,280 --> 00:10:06,420
أجل. فقد وصلتَ إلى ذلك السنّ يا لوشييل-كن

163
00:10:06,420 --> 00:10:07,750
...المعذرة

164
00:10:09,960 --> 00:10:16,210
أحبُّ أن تكون الفتاة ذات وجه جميل
وشخصيّة ظريفة، ربّما؟

165
00:10:16,210 --> 00:10:18,430
ماذا؟

166
00:10:18,430 --> 00:10:22,390
عندما يقع في نهاية المطاف، لنُشجّعه جميعاً، حسناً؟

167
00:10:22,390 --> 00:10:27,620
بالتأكيد، لكن هذا يجعلك تخشى على
مُستقبله، أليس كذلك يا برود؟

168
00:10:30,230 --> 00:10:31,270
بالتأكيد

169
00:10:33,520 --> 00:10:36,690
بعد نصف عام

170
00:10:41,030 --> 00:10:42,360
شكراً جزيلاً

171
00:10:43,980 --> 00:10:47,510
مضى نصف عام بلمح البصر بعد أن تلقّيتُ
رسالة حول الانتقال

172
00:10:47,510 --> 00:10:49,690
إلى مقرّ كنيسة شورول المُقدّسة

173
00:10:51,690 --> 00:10:54,460
هل أتممت تجديدك في نقابة المُعالجين؟

174
00:10:54,460 --> 00:10:58,170
أجل! أصبحتُ أخيراً مُعالِجاً بتصنيف أ

175
00:10:58,170 --> 00:11:02,470
حسناً. هل ستذهب إلى المدينة المُقدّسة حقّاً إذاً؟

176
00:11:02,470 --> 00:11:06,660
،أجل. إذا عصيتُ أمراً من البابا

177
00:11:06,660 --> 00:11:10,440
فأشعر بأنّني سأواجه شكلاً من الاستجواب
أو الاتّهامات الغريبة

178
00:11:10,730 --> 00:11:14,200
إذا كان مقرّ الكنيسة فاسداً، فابحث
عن طريقة للهرب والعودة

179
00:11:14,200 --> 00:11:15,020
حسناً

180
00:11:15,400 --> 00:11:19,530
حسناً، لماذا دعيتني إلى قاعة التّدريب مرّة أخيرة؟

181
00:11:20,100 --> 00:11:22,610
لم تأتِ إلى هنا لتعترف بحبّك لي، صحيح؟

182
00:11:22,610 --> 00:11:26,200
...بالطبع ليس كذلك. لكن

183
00:11:26,930 --> 00:11:28,490
أودُّ أن أطلب معروفاً

184
00:11:45,990 --> 00:11:48,180
مضى عامان منذ أتيتُ إلى هذه النّقابة

185
00:11:48,930 --> 00:11:53,200
كمُعالج، أظنّني أنقذتُ عدد ما أستطيع من أرواح

186
00:11:53,200 --> 00:11:54,160
أجل

187
00:11:54,950 --> 00:11:58,860
لكن ما زال هناك الكثير لم أستطع إنقاذهم

188
00:12:02,850 --> 00:12:05,640
حالما أغادر، فإنّ عيادات مثل عيادة بوتّاكولي

189
00:12:05,640 --> 00:12:09,330
سوف تستمرّ في فعل ما كانت تفعله دوماً

190
00:12:09,790 --> 00:12:12,490
،المُغامرون الجدُد فُقراء

191
00:12:12,860 --> 00:12:16,790
لذا يُجازفون لكسب المال ويُصابون أثناء ذلك

192
00:12:17,490 --> 00:12:20,130
،حتّى مع جروح يمكن شفاؤها سريعاً

193
00:12:20,620 --> 00:12:25,480
،إن لم يملكوا مالاً للدفع لعيادة
فإنَّ الانتظار طويلاً قد يكلّفهم حياتهم

194
00:12:26,940 --> 00:12:29,850
،وحتّى لو عالجَتْهم عيادة وأنقذتهم

195
00:12:30,250 --> 00:12:35,580
،إذا طالبت العيادة بأجر غير منطقيّ
فقد تُفسِد حياةَ المُغامر

196
00:12:35,940 --> 00:12:39,290
أرغب في تجنُّب كلا هذين السّيناريوهين

197
00:12:43,540 --> 00:12:44,770
،بوضع ذلك في الحسبان

198
00:12:44,770 --> 00:12:47,660
هلّا بدأتَ بمنهاج تدريب للصّاعدين؟

199
00:12:50,650 --> 00:12:55,370
ليس مجرّد تدريب أساسي، إنّما ذبح لحم
الوحوش أيضاً وتعريف عن الأعشاب الطبّية

200
00:12:55,670 --> 00:13:00,050
ينبغي أن يكون المُدرّبون موظّفين في النّقابة
أو مُغامرين رفيعي المستوى سابقين فقط

201
00:13:00,050 --> 00:13:03,260
لمنع الجدُد من الإفلاس فوراً؟

202
00:13:03,260 --> 00:13:06,550
أجل. أعتقد التّدريب ولو مرّة
في الأسبوع سوف ينفع

203
00:13:07,230 --> 00:13:11,010
مثلما ساعدَني الجميع عندما أتيتُ إلى هذا العالم

204
00:13:11,410 --> 00:13:13,820
مثلما حظيتُ بتعليمات مُفيدة ونافعة كهذه

205
00:13:15,590 --> 00:13:20,730
لكن لماذا تطلب منّي ذلك؟ المُغامرون
مسؤولون عن أنفسهم

206
00:13:21,310 --> 00:13:24,820
لأنّ امتلاك مُدرّب مثلك هو ما جعلَني أقوى

207
00:13:27,230 --> 00:13:30,160
،بنفس الطريقة، أو بطريقة مُشابهة

208
00:13:30,160 --> 00:13:33,590
إذا أصبح المُغامرون أقوى وتعزّزتْ
،معرفتهم الأساسيّة

209
00:13:33,940 --> 00:13:35,750
سينخفض مُعدّل إصاباتهم

210
00:13:35,750 --> 00:13:40,020
وإذا حدث ذلك، ستتلقّى العيادات مرضى أقلّ

211
00:13:40,020 --> 00:13:42,960
وسأكتشف ما يجب عليّ فعله بنفسي

212
00:13:44,450 --> 00:13:47,800
رغم أنّك مُعالج، تريد عرقلة العيادات؟

213
00:13:48,400 --> 00:13:50,990
ضمنيّاً، أنا أقرب إلى مُغامر

214
00:13:52,990 --> 00:13:57,360
من بين كلّ المُغامرين الّذين التقيتُهم
هناك أشخاص طيّبون

215
00:13:59,250 --> 00:14:04,820
لهذا أريدك أن تؤسّس نظاماً يساعدهم على النّجاح

216
00:14:07,030 --> 00:14:08,910
هكذا إذاً

217
00:14:09,260 --> 00:14:14,570
أخبرني يا لوشييل، هل تعتقد حقّاً
بأنّك تطوّرتَ تحت وصايتي؟

218
00:14:14,910 --> 00:14:21,500
،ما زلتُ أفتقر للمهارات وأنا أخرق جدّاً
لكن أشعر بأنّني تطوّرتُ ذهنيّاً بشكل كبير

219
00:14:23,290 --> 00:14:25,440
،حدثت أمور كثيرة على مدى العامين الماضيّين

220
00:14:25,980 --> 00:14:29,340
لكن أنا مسرور جدّاً لأنّني استطعتُ
الدّراسة تحت وصايتك يا مُعلّم

221
00:14:35,910 --> 00:14:39,000
أتعتقد بأنّ تدريبي انتهى بعد عامين فقط؟

222
00:14:39,000 --> 00:14:40,690
!لا، إطلاقاً

223
00:14:40,690 --> 00:14:43,490
!ما زلتُ لم أصبك ولو بضربة واحدة

224
00:14:44,070 --> 00:14:45,440
لا مُشكلة

225
00:14:46,720 --> 00:14:48,970
سأفكّر في إحداث منهاج

226
00:14:49,730 --> 00:14:51,160
!شكراً جزيلاً لك

227
00:14:51,160 --> 00:14:55,190
والآن هناك أمر أريد أن أطلبه منك أيضاً

228
00:14:55,190 --> 00:14:56,120
ما هو؟

229
00:14:56,120 --> 00:14:57,780
إنّه بخصوص مونيكا

230
00:14:58,920 --> 00:15:01,980
،لا توجد مُشكلة في عملها

231
00:15:01,980 --> 00:15:04,290
لكن هل من المناسب توظيفها هنا فعلاً؟

232
00:15:05,800 --> 00:15:10,140
أنا من أحضرها إلى هنا من نقابة المُعالجين

233
00:15:14,600 --> 00:15:18,230
،أنا مسؤول عن وجودها هنا، وللحفاظ على سلامتها

234
00:15:18,230 --> 00:15:20,980
إبقاؤها هنا هو الأفضل غالباً

235
00:15:20,980 --> 00:15:24,330
لكن يعود القرار لها

236
00:15:24,650 --> 00:15:30,150
هكذا إذاً. أنتما مُتقاربان، لذا اعتقدتُ
بأنّها سوف تطلب مشورتك

237
00:15:30,550 --> 00:15:34,370
بالنسبة لأمر كهذا، لعلّها تكلّمَتْ مع نانايلا-سان

238
00:15:34,370 --> 00:15:35,790
هذا ما أعتقده

239
00:15:36,300 --> 00:15:38,670
حسناً إذاً، هل ينبغي أن ننطلق؟

240
00:15:38,670 --> 00:15:41,290
أجل. ما زلتُ أحتاج لحزم أمتعتي

241
00:15:43,460 --> 00:15:45,960
!أنتما هناك

242
00:15:46,600 --> 00:15:47,460
ماذا؟

243
00:15:49,290 --> 00:15:51,910
!ماذا؟

244
00:15:51,910 --> 00:15:54,360
سأسبقك

245
00:15:54,360 --> 00:15:58,040
ما-ماذا تفعلان هنا؟

246
00:16:00,870 --> 00:16:04,830
في التّوقيت المناسب. أردتُ أن
أشكركما كما ينبغي

247
00:16:05,860 --> 00:16:07,290
!لا مُشكلة

248
00:16:09,720 --> 00:16:12,730
أنت إلهام لقوم الوحوش يا لوشييل-كن

249
00:16:12,730 --> 00:16:15,320
من الغريب أن تنحني هكذا

250
00:16:15,320 --> 00:16:20,080
ما زلتُ على قيد الحياة لأنّك ما زلت
بجانبي يا لوشييل-كن

251
00:16:20,600 --> 00:16:25,290
.ثمّ أحضرتني إلى مكان آمن كهذا
شكراً جزيلاً لك

252
00:16:27,990 --> 00:16:30,160
...إذا وقعتَ في ورطة يوماً يا لوشييل-كن

253
00:16:30,160 --> 00:16:34,030
سنبذل قصارى جهدنا لمساعدتك
بأيّ شكل من الأشكال

254
00:16:35,430 --> 00:16:38,640
...نانايلا-سان، مونيكا-سان

255
00:16:39,530 --> 00:16:42,620
عليّ أيضاً أن أخبرهما عن مشاعري فعليّاً

256
00:16:43,650 --> 00:16:47,880
نانايلا-سان، ساعدتِني في دراستي
وحتّى في غسيل ملابسي

257
00:16:47,880 --> 00:16:51,130
رأيتِني في أضعف حالاتي

258
00:16:52,420 --> 00:16:56,890
استطعتُ تجاوز تدريب برود فقط
لأنّكِ كنتِ تقفين بجانبي

259
00:16:56,890 --> 00:16:58,240
شكراً جزيلاً لكِ

260
00:17:03,430 --> 00:17:07,770
ومونيكا-سان، لا تقلقي بشأن إنقاذي لكِ

261
00:17:07,770 --> 00:17:10,380
عوّضتِني بما يكفي عن ذلك

262
00:17:11,520 --> 00:17:15,970
إنقاذي لكِ أفادني أيضاً

263
00:17:15,970 --> 00:17:17,840
ماذا تقصد بذلك؟

264
00:17:17,840 --> 00:17:20,680
كان تدريب المُعلّم صعباً للغاية

265
00:17:20,680 --> 00:17:24,170
،لكن بعد أن أحضرتُكِ إلى هنا يا مونيكا-سان

266
00:17:24,170 --> 00:17:26,560
كان من المُحال أن أهرب بوجودكِ تُراقبين

267
00:17:27,680 --> 00:17:31,760
هل تعني بأنّني كنتُ عبئاً؟

268
00:17:32,380 --> 00:17:33,370
إطلاقاً

269
00:17:34,470 --> 00:17:37,720
يصبح الهرب شكلاً من العادات

270
00:17:37,720 --> 00:17:39,360
،حالَ الهرب من شيء

271
00:17:39,360 --> 00:17:42,950
عندما تشتدّ الأمور، يهرب المرء ثانية غريزيّاً

272
00:17:43,640 --> 00:17:48,580
مونيكا-سان، كنتِ المرساة الّتي منعَتْني
من الهرب من تدريبي

273
00:17:50,070 --> 00:17:52,590
،حتّى أثناء أسوأ السّيناريوهات

274
00:17:52,590 --> 00:17:57,930
بعد أن أنقذتُكِ، عاهدتُ نفسي ألّا أهرب

275
00:17:58,330 --> 00:18:00,970
هكذا وصلتُ إلى ما أنا عليه اليوم

276
00:18:02,360 --> 00:18:06,350
أنا ممتنٌّ على ذلك. لم أعتبركِ عبئاً يوماً

277
00:18:07,240 --> 00:18:08,630
...لوشييل-كن

278
00:18:11,060 --> 00:18:14,030
دُمِّرت القنوات الدّمعيّة

279
00:18:17,490 --> 00:18:19,110
هل أنتِ بخير؟

280
00:18:20,980 --> 00:18:22,930
أشعر بأكبر من مجرّد عطف تجاههما

281
00:18:22,930 --> 00:18:26,650
إنّهما صديقتان حميتاني وقاتلتا
بجانبي لمدّة عامين

282
00:18:26,650 --> 00:18:29,460
أريد أن أعدهما بشيء

283
00:18:30,330 --> 00:18:31,330
...المعذرة

284
00:18:32,380 --> 00:18:35,930
...سأغادر هذا المكان غداً، وبصراحة

285
00:18:36,350 --> 00:18:38,660
لا أعرف ما الّذي سيجري بعد ذلك

286
00:18:39,340 --> 00:18:44,060
!لكن يوماً ما، لنتشارك وجبة معاً من جديد

287
00:18:45,590 --> 00:18:47,770
،في عالم حيث الحياة لا قيمة كبيرة لها

288
00:18:48,110 --> 00:18:50,710
من المهمّ خلق أسباب للاستمرار في العيش

289
00:18:52,040 --> 00:18:56,190
سأعمل بجدّ وذلك كي أستطيع يوماً ما
أن أخبركما عن أهدافي المستقبليّة

290
00:18:56,510 --> 00:18:57,480
!حسناً

291
00:19:07,120 --> 00:19:10,080
مُذهل! وصلتُ للتّصنيف ي؟

292
00:19:17,710 --> 00:19:18,860
مُعلّم

293
00:19:21,220 --> 00:19:25,600
!أعِدُك بأنّني سأعود يوماً ما وأصيبك بضربة أخيراً

294
00:19:25,600 --> 00:19:29,930
،ماذا؟ إذا تمكّنتَ من فعل ذلك
فسأنفّذ أيّ طلب تطلبه

295
00:19:29,930 --> 00:19:33,190
سأدعك تشرب خمسة أباريق من المادّة أكس

296
00:19:34,020 --> 00:19:35,520
!طلب رخيص حقّاً

297
00:19:36,280 --> 00:19:37,960
!لوشييل

298
00:19:38,370 --> 00:19:40,660
وُضِعَتْ أمتعتك على العربة

299
00:19:40,660 --> 00:19:42,160
شكراً جزيلاً لك

300
00:19:43,200 --> 00:19:44,410
،حسناً إذاً يا جماعة

301
00:19:45,480 --> 00:19:47,740
!شكراً لكم جميعاً على كلّ ما فعلتموه لأجلي

302
00:19:48,190 --> 00:19:54,460
لو لم تقبلوني في هذه النّقابة لما
كانت أيّامي مُثمرة أبداً

303
00:19:54,770 --> 00:19:56,760
!شكراً لكم من أعماق قلبي

304
00:19:59,710 --> 00:20:02,390
أتكلّم باسمنا جميعاً

305
00:20:05,240 --> 00:20:07,180
أبليتَ بلاءً حسناً فعلاً

306
00:20:08,640 --> 00:20:12,850
تمَّ إنقاذ الكثير من المُغامرين بفضلك

307
00:20:13,450 --> 00:20:18,860
كثير من النّاس لم يخسروا عائلاتهم بفضلك

308
00:20:23,020 --> 00:20:24,450
!شكراً جزيلاً لك

309
00:20:24,770 --> 00:20:28,530
حسناً، يكفي. لا أتحمّل هذه الأمور العاطفيّة

310
00:20:33,060 --> 00:20:35,790
خُذ. هذه هديّة وداعك

311
00:20:36,200 --> 00:20:37,170
ما هذه؟

312
00:20:37,170 --> 00:20:39,260
حقيبة سحريّة

313
00:20:39,660 --> 00:20:41,920
يمكنك وضع حتّى عشرة أغراض فيها. أيّ غرض

314
00:20:41,920 --> 00:20:44,760
والكيس الجلدي يحتوي على مال

315
00:20:48,540 --> 00:20:51,180
إنّه عربون امتناننا

316
00:20:51,180 --> 00:20:53,520
اهتمّ بنفسك، اتّفقنا؟

317
00:20:53,520 --> 00:20:56,770
لا تنسَ الوعد الّذي قطعتَه

318
00:20:53,520 --> 00:20:56,770
هيّا، حاولي أن تقولي وداعاً بابتسامة

319
00:20:56,770 --> 00:20:59,410
!حريّ بك أن تعود أيّها المهووس الزّومبي

320
00:20:59,980 --> 00:21:02,400
!احرص على إحضار شيء جميل عند عودتك

321
00:21:10,090 --> 00:21:11,810
...لا أستطيع

322
00:21:11,810 --> 00:21:18,130
!فعلتُ فقط... ما ترتّب عليّ فعله

323
00:21:18,130 --> 00:21:20,150
!كُفَّ عن البُكاء

324
00:21:20,150 --> 00:21:22,760
عُد فحسب واعمل لأجلنا بثمن رخيص ثانية

325
00:21:22,760 --> 00:21:23,710
!سيكون هذا كافياً

326
00:21:23,710 --> 00:21:24,610
!سوف أفعل

