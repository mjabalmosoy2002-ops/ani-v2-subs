1
00:00:02,730 --> 00:00:05,980
تمّ تأكيد وجود سكّين الرّوح الخالدة؟

2
00:00:06,400 --> 00:00:11,150
المعلّم لوو من تحالف طبّاخي
.غوانغدونغ قد خبّأه في معبد دايسن

3
00:00:11,950 --> 00:00:14,060
يجب أن نحصل

4
00:00:14,060 --> 00:00:17,100
.على سكّين الرّوح الخالدة الأسطورية مهما كلّف الأمر

5
00:00:17,820 --> 00:00:19,580
.سذهب إلى غوانزو

6
00:00:19,890 --> 00:00:22,840
.دعونا نتكفّل بهذه المهمّة

7
00:00:23,180 --> 00:00:25,330
.سبق وقمنا بالتجهيزات

8
00:00:25,770 --> 00:00:27,560
.أنت تعمل بسرعة

9
00:00:27,960 --> 00:00:30,110
.فلنرَ كيف ستبلي

10
00:00:30,760 --> 00:00:32,050
.المهمّة لك

11
00:00:32,050 --> 00:00:32,700
.حاضر

12
00:01:00,680 --> 00:01:05,290
...لستُ متأكّدًا كم أستطيع إنجازه الآن، لكن

13
00:01:05,640 --> 00:01:09,250
!بصفتي طبّاخًا خارقًا، سوف أقاتل ضدّ عالم الطبخ السريّ

14
00:01:12,210 --> 00:01:13,340
...ماو

15
00:01:13,590 --> 00:01:17,340
.تملك العزيمة والمهارة

16
00:01:17,970 --> 00:01:23,970
.حان الوقت للكشف عن سرّ الأواني الأسطورية

17
00:02:55,050 --> 00:02:57,770
سرّ الأواني الأسطورية؟

18
00:02:58,120 --> 00:02:59,840
.اسمع يا ماو

19
00:02:59,840 --> 00:03:04,490
سكّين الرّوح الخالدة لغوانزو هو
.فقط واحدٌ من الأواني الأسطورية

20
00:03:04,760 --> 00:03:07,950
...هنالك أكثر؟ هل تقصد يا معلّم

21
00:03:08,650 --> 00:03:12,320
.هذا صحيح. ثمّة ثماني أواني أسطورية

22
00:03:12,730 --> 00:03:18,170
وقد انتشرت الأواني الثمان
.الأسطورية عبر ثمان مناطق في الصّين

23
00:03:18,390 --> 00:03:22,020
.ويقال أنّها تحمي عالم الطّبخ الصّيني

24
00:03:24,170 --> 00:03:27,230
،قبل ألف عام

25
00:03:27,590 --> 00:03:32,250
طبّاخ حقبة تانغ الأسطورية شيو لي صنع ثمان أواني

26
00:03:32,250 --> 00:03:35,440
.من النيزك الذي سقط من السماء

27
00:03:39,000 --> 00:03:41,540
.حملت هذه الأواني الثمان قوّة عظيمة

28
00:03:41,540 --> 00:03:46,090
.ويُقال أنّها تسبّبت في صراعٍ هائل في ذلك الوقت

29
00:03:46,470 --> 00:03:51,320
في النّهاية، بغيًا في تحقيق السّلام
،بين دوائر الطبخ وباقي العالم

30
00:03:51,320 --> 00:03:55,000
قام شيو لي بحبس الأواني في ثماني مناطق

31
00:03:55,000 --> 00:03:58,090
.حتّى لا تجتمع سويًّا مجدّدًا أبدًا

32
00:04:12,950 --> 00:04:16,810
.إنّ الأواني الأسطورية الثمان بمثابة سيفٍ ذو حدّين

33
00:04:16,810 --> 00:04:21,550
،إن استُخدمت بشكلٍ صحيح من طبّاخ شرعيّ
.فستُثمر عن نتائج مذهلة

34
00:04:21,550 --> 00:04:22,490
...لكن

35
00:04:23,230 --> 00:04:26,730
إن سقطت الأواني الأسطورية في يد طبّاخي العالم السريّ

36
00:04:26,730 --> 00:04:28,540
،وسُخّرت لأغراض شرّيرة

37
00:04:29,240 --> 00:04:32,710
،فلن يلحق الضرّ عالم الطّبخ الصينيّ فقط

38
00:04:32,710 --> 00:04:34,750
.بل بكلّ شعوب العالم

39
00:04:35,790 --> 00:04:37,740
.معلّم لو، تشويو

40
00:04:37,740 --> 00:04:41,630
.دعاني أذهب في رحلةٍ لجمع الأواني الثمان الأسطورية

41
00:04:41,950 --> 00:04:44,590
لقد قاتلت أمّي عالم الطّبخ السريّ سابقًا

42
00:04:44,590 --> 00:04:47,390
.لجلب السّعادة للنّاس

43
00:04:47,740 --> 00:04:50,470
،بما أنّي قاتلت ليان وليون

44
00:04:50,470 --> 00:04:54,770
.أرفض اعتبار عدم وجود صلة لي بهذا

45
00:04:54,960 --> 00:04:56,190
.دعاني أقم بهذا

46
00:05:02,990 --> 00:05:05,780
.قد يكون هذا قدره

47
00:05:05,930 --> 00:05:09,210
،عندما كانت أمّه باي يافعة

48
00:05:09,210 --> 00:05:13,540
.ارتحلت بحثًا عن الأواني الثمان

49
00:05:18,390 --> 00:05:21,800
.ماو، إنّنا نعي كيف تشعر

50
00:05:21,800 --> 00:05:26,990
.لكن لا يزال هنالك الكثير ما نجهله عن عالم الطبخ السريّ

51
00:05:26,990 --> 00:05:30,680
،إن ذهبت في رحلةٍ لوحدك الآن
.فمن الصّعب أن نعرف كيف ستؤول الأمور

52
00:05:30,680 --> 00:05:31,260
...لكن

53
00:05:31,560 --> 00:05:33,520
.تريّس يا ماو

54
00:05:33,520 --> 00:05:36,270
.ما زلنا نجهل الكثير حتّى نرسلك وحدك

55
00:05:38,050 --> 00:05:39,400
!انتظر يا ماو

56
00:05:41,320 --> 00:05:43,350
.شي لو، ليون

57
00:05:43,350 --> 00:05:46,210
.سأرافقك في رحلتك

58
00:05:46,210 --> 00:05:50,530
.القضاء على عالم الطبخ السريّ هو ما أكرّس حياتي لأجله

59
00:05:50,530 --> 00:05:51,830
.لـ-ليون

60
00:05:52,000 --> 00:05:56,120
.لن أدعكما تحظيان بكامل المتعة

61
00:05:56,120 --> 00:05:57,670
.خذاني معكما

62
00:05:57,670 --> 00:05:59,040
.شي لو

63
00:05:59,370 --> 00:06:01,560
.اعرفا حدّكما

64
00:06:01,560 --> 00:06:03,810
.نعرفها بالفعل

65
00:06:04,190 --> 00:06:07,210
.انتظر حتّى ترى هذا

66
00:06:08,720 --> 00:06:09,720
هل يعقل؟

67
00:06:15,360 --> 00:06:17,320
.أجل يُعقل

68
00:06:27,880 --> 00:06:29,850
أنت هنا بالفعل إذًا؟

69
00:06:29,850 --> 00:06:32,580
.سرعتك في العمل عجيبة

70
00:06:40,740 --> 00:06:42,170
...ذلك القضيب

71
00:06:42,170 --> 00:06:45,300
.فهمت. أنت الشخص الذي هاجم شي لو

72
00:06:52,470 --> 00:06:56,640
.أيها الخائن. مجيئك هنا يريحنا للغاية

73
00:06:57,330 --> 00:06:59,220
.فلتمت الآن

74
00:07:19,220 --> 00:07:21,370
.استعدته أخيرًا

75
00:07:21,690 --> 00:07:24,880
على أيّ حال، لماذا عانيت للتخلص من ذلك الضعيف؟

76
00:07:26,040 --> 00:07:29,880
.لم أرد أن أضرّ بأداتك الثمينة

77
00:07:31,320 --> 00:07:33,480
.شكرًا لأجل مراعاتك

78
00:07:33,930 --> 00:07:35,030
من هذا؟

79
00:07:35,030 --> 00:07:36,600
.خادم من العالم السري

80
00:07:36,850 --> 00:07:39,330
.لقد أتى لسرقة الأواني الأسطورية

81
00:07:39,330 --> 00:07:42,740
.لم أتوقّع أن يتحرّكوا في ليلة مراسم النقل

82
00:07:42,740 --> 00:07:46,070
.إنهم يعملون بشكلٍ أسرع ممّا توقّعت

83
00:07:46,210 --> 00:07:47,920
.معك حق

84
00:07:47,920 --> 00:07:50,830
.أيًّا كان، لقد استرجعت قضيبي الآن

85
00:07:50,830 --> 00:07:53,060
.يمكنني أن أواصل الترحال

86
00:07:53,500 --> 00:07:57,880
.وجدتها. سأُحدث ثَلمًا في قضيبي لأجل هذا الشخص

87
00:07:57,880 --> 00:07:59,270
.يجب أن تكون ممتنًّا

88
00:07:59,270 --> 00:08:01,240
.بدل فعل ذلك، ساعدني

89
00:08:02,520 --> 00:08:06,000
.لا يمكنني أن أربطه بهذه اليد

90
00:08:08,800 --> 00:08:09,890
...أنت

91
00:08:11,250 --> 00:08:12,350
.حسنًا

92
00:08:13,660 --> 00:08:16,850
.مضى ألف عام مذ تمّ حبس الأواني الأسطورية

93
00:08:16,850 --> 00:08:20,050
كان عالم الطبخ السري يعمل في سريّة

94
00:08:20,050 --> 00:08:23,060
.لكنّه أقدم على حركته وظهر إلى الملأ أخيرًا

95
00:08:23,550 --> 00:08:27,270
بات الأمر واضحًا بعد تحرّك
الرّجل المعروف بالطبّاخ المقنّع

96
00:08:27,270 --> 00:08:30,500
.بالإضافة إلى هذه الحادثة

97
00:08:30,990 --> 00:08:31,820
.أجل

98
00:08:32,290 --> 00:08:37,180
لعلّ الوقت قد حان لنا نحن الطبّاخين أن نجمع الأواني

99
00:08:37,180 --> 00:08:40,170
.قبل أن تُسرق من قبل عالم الطّبخ السريّ

100
00:08:40,530 --> 00:08:42,250
ماو، هل أنت جاهز؟

101
00:08:42,730 --> 00:08:46,250
.أجل. سأجمع بقيّة الأواني

102
00:08:48,010 --> 00:08:52,170
.لستُ بحاجة للقلق إن سافر ثلاثتكم لجمع الأواني

103
00:08:56,180 --> 00:08:58,000
!أيها الجدّ! أنا أيضًا

104
00:08:58,000 --> 00:09:01,180
!تلميذ ماو الأوّل شيرو سيذهب أيضًا

105
00:09:03,190 --> 00:09:05,680
.ستبقى وتساعد في المطعم

106
00:09:06,040 --> 00:09:09,300
!مستحيل! سأذهب وإن دفعتُ حياتي ثمنًا لذلك

107
00:09:09,300 --> 00:09:10,580
.أمزح

108
00:09:10,580 --> 00:09:11,490
كانت مزحة؟

109
00:09:11,490 --> 00:09:13,190
.تشو يو، أحضرها

110
00:09:13,190 --> 00:09:13,820
.حاضر

111
00:09:17,290 --> 00:09:20,240
معلّم، ما هذه الخرائط الثمان؟

112
00:09:21,080 --> 00:09:23,530
لقد مُنحتُها قبل 30 سنة

113
00:09:23,530 --> 00:09:26,680
.حينما عُيّنتُ أمينًا على سكّين الرّوح الخالدة

114
00:09:26,680 --> 00:09:29,800
.إنّها تظهر مواقع الأواني المحبوسة

115
00:09:30,680 --> 00:09:35,800
.الشّيء الوحيد الذي نعرفه هو أنّ هذه خريطة شانغهاي

116
00:09:35,800 --> 00:09:37,270
!شانغهاي

117
00:09:37,660 --> 00:09:41,050
.الحاضرة المعروفة بمدينة الشياطين

118
00:09:41,050 --> 00:09:42,320
.صحيح

119
00:09:42,320 --> 00:09:45,320
المكان الوحيد عدا غوانزو الذي يُعرف أنّه

120
00:09:45,320 --> 00:09:48,900
.يحتوي على أواني محبوسة هو شانغهاي

121
00:09:49,630 --> 00:09:53,900
أثناء رحلتكم، يجب أن تحلّلوا هذه الخرائط بشكلٍ أوضح

122
00:09:53,900 --> 00:09:57,020
.حتّى تصلوا إلى الأواني الأسطورية

123
00:09:57,020 --> 00:09:58,360
...ولفعل ذلك

124
00:09:58,360 --> 00:10:02,040
شي لو، شبكة المعلومات التي أسّستها

125
00:10:02,040 --> 00:10:05,120
.أثناء تجوالك في البلاد ستكون حاسمة

126
00:10:05,760 --> 00:10:09,310
وليون، المعرفة والمهارة التي تعلّمتها

127
00:10:09,310 --> 00:10:13,800
في عالم الطبخ السريّ ستكشف
.عن الكثير من الأمور الغامضة بالتأكيد

128
00:10:14,550 --> 00:10:19,010
.ماو، الأمر الأهمّ هو قدرتك الخاصة

129
00:10:19,420 --> 00:10:24,040
.ذاكرتك عن النكهات ستكون العامل الحاسم

130
00:10:24,500 --> 00:10:27,480
ذاكرتي عن النكهات؟

131
00:10:27,970 --> 00:10:33,040
.يُقال أنّ الأواني الأسطورية تتجاوب مع الأرواح اليافعة

132
00:10:33,040 --> 00:10:35,840
يمكن أن تتمّ هذه الرّحلة فقط بواسطتكم أيّها الشبّان

133
00:10:35,840 --> 00:10:38,650
.ذوي المعرفة والشجاعة والرّوح الاستثنائية

134
00:10:39,040 --> 00:10:42,300
.ماو، شي لو، ليون وشيرو

135
00:10:42,910 --> 00:10:46,260
.يجب أن تتمّوا هذه المهمّة بالعمل الجماعيّ

136
00:10:46,260 --> 00:10:47,350
.أنا أعتمد عليكم

137
00:10:47,350 --> 00:10:48,410
!حاضر

138
00:11:00,710 --> 00:11:04,810
.عدوني أنّكم ستعودون إلى غوانزو

139
00:11:05,120 --> 00:11:05,930
!أجل

140
00:11:10,950 --> 00:11:13,260
.أختي ميلي لم تأتي لتوديعنا

141
00:11:13,260 --> 00:11:13,910
.أجل

142
00:11:16,200 --> 00:11:19,190
.لا تكتئب هكذا من صباح رحيلنا

143
00:11:20,710 --> 00:11:21,380
.أجل

144
00:11:44,930 --> 00:11:46,120
ميلي؟

145
00:11:47,390 --> 00:11:50,430
!قرّرت أن آتي معك مجدّدًا يا ماو

146
00:11:50,810 --> 00:11:52,960
في النهاية، لا أريد

147
00:11:53,850 --> 00:11:56,590
.أن أنتظر عودتك

148
00:12:01,660 --> 00:12:03,160
هل أنت واثق من هذا؟

149
00:12:03,160 --> 00:12:06,200
.أجل. هذه رغبتها

150
00:12:07,740 --> 00:12:11,540
.لا بدّ أنّك تشعر بالقلق بصفتك والدها

151
00:12:16,500 --> 00:12:18,090
.ستكون رحلة وعرة

152
00:12:18,610 --> 00:12:19,660
.أعلم

153
00:12:24,540 --> 00:12:26,470
.قُضي الأمر إذًا يا ميلي

154
00:12:26,470 --> 00:12:27,760
!فلنذهب سويًّا

155
00:12:29,670 --> 00:12:30,430
!أجل

156
00:12:36,490 --> 00:12:38,270
.الطقس جميل مجدّدًا

157
00:12:38,270 --> 00:12:40,310
.كما أنّ الرّيح حليفتنا

158
00:12:40,310 --> 00:12:43,320
.على هذا الحال، سنصل إلى شانغهاي أسرع من المتوقع

159
00:12:43,320 --> 00:12:46,720
.لكنّ المنظر لم يتغيّر أمامنا. لقد ضجرت

160
00:12:46,720 --> 00:12:48,620
.كفّ عن التذمّر

161
00:12:48,620 --> 00:12:53,400
فور أن نصل إلى شانغهاي، قد
.لا يتسنّى لك الاسترخاء والاستماع بالمنظر

162
00:12:53,400 --> 00:12:56,040
.ماذا؟ لا تهدّدني هكذا

163
00:12:56,580 --> 00:13:01,820
.بالمناسبة يا ماو، سمعت أنّ أمّك كانت طبّاخة أيضًا

164
00:13:01,820 --> 00:13:02,630
.أجل

165
00:13:02,890 --> 00:13:06,380
هل اخترت هذا الطريق بسببها؟

166
00:13:08,860 --> 00:13:11,560
ما قصّتك أيّها الطبّاخ الخارق الأصغر في التاريخ؟

167
00:13:11,560 --> 00:13:14,810
لا تريد أن تشارك قصّتك الخاصّة؟

168
00:13:15,190 --> 00:13:16,210
.لا

169
00:13:16,560 --> 00:13:20,520
.لم يكن من السّهل عليّ أن أصبح طبّاخًا خارقًا

170
00:13:22,630 --> 00:13:24,990
...عندما كانت أمّي لا تزال حيّة

171
00:13:26,600 --> 00:13:28,620
.راجع نفسك يا شو آن

172
00:13:28,620 --> 00:13:31,040
...إن غادرت، هذا المطعم

173
00:13:31,210 --> 00:13:35,330
.إن حصلتُ على شهادة التفوّق، لن يهمّ هذا المطعم

174
00:13:35,740 --> 00:13:37,020
!أمّي

175
00:13:37,020 --> 00:13:38,580
...شـ-شو آن

176
00:13:44,350 --> 00:13:47,510
...راتب السّنة الذي حصلنا عليه من الدولة

177
00:13:47,510 --> 00:13:50,220
.أخذه شو آن كلّه

178
00:13:52,700 --> 00:13:56,510
.هذا يكاد لا يكفي لدفع ضريبة إنهاء خدمة عشر سنوات

179
00:14:03,940 --> 00:14:07,500
.افتحه حينما تكون في أمسّ الحاجة لذلك

180
00:14:14,390 --> 00:14:17,090
...أمّي

181
00:14:17,090 --> 00:14:20,600
!لا! أمّي

182
00:14:22,400 --> 00:14:24,910
...بعد شهر من وفاة أمّي

183
00:14:24,910 --> 00:14:28,740
.سيأتي رئيس طهاة جديد أخيرًا لهذا المطعم

184
00:14:29,070 --> 00:14:31,930
.ماو، لقد طلبت هذه المسابقة

185
00:14:32,250 --> 00:14:36,240
.إن خسرت، سنضطر لمغادرة هذا المطعم

186
00:14:36,640 --> 00:14:39,080
.سوف أهزمه مهما كلّف الأمر

187
00:14:42,490 --> 00:14:44,820
.يبدو أنّك تُبلي جيّدًا يا فتى

188
00:14:45,520 --> 00:14:46,860
.شو آن

189
00:14:46,860 --> 00:14:49,740
ماتت تلك الشمطاء باي، صحيح؟

190
00:14:50,720 --> 00:14:52,490
...بسببك، أمّي

191
00:14:53,720 --> 00:14:55,050
!إيّاك يا ماو

192
00:14:55,050 --> 00:14:56,910
!لن أسامحه أبدًا

193
00:14:58,280 --> 00:15:01,130
ما الذي يستطيع صبيّ ثرثار فعله؟

194
00:15:04,380 --> 00:15:06,130
!اكبحا نفسيكما أنتما الاثنان

195
00:15:11,530 --> 00:15:14,490
.ستُحدّد هذه المسابقة رئيس الطهاة الجديد لبرج الأقحوان

196
00:15:14,920 --> 00:15:16,710
.شو آن، ماو

197
00:15:17,020 --> 00:15:20,270
.عليكما طبخ مابو توفو الأسطوري

198
00:15:20,980 --> 00:15:21,500
...أسـ

199
00:15:21,500 --> 00:15:22,770
أسطوري؟

200
00:15:38,690 --> 00:15:41,070
.هذا اللّحم المفروم الأسطوري

201
00:15:41,490 --> 00:15:48,840
استُخدم هذا اللّحم في طبخ المابو
.توفو من قبل جنية السشين، باي

202
00:15:48,840 --> 00:15:51,760
،إنّها معلّمتك السّابقة يا شو آن
.وأمّك يا ماو

203
00:15:52,160 --> 00:15:54,510
مابو توفو الخاص بباي؟

204
00:15:55,060 --> 00:15:58,120
.لهذا السّبب بالضّبط كُلفتما بهذه المهمة

205
00:15:58,760 --> 00:16:01,940
.لقد حللت لغز هذا اللّحم. عمل مبهر

206
00:16:02,430 --> 00:16:04,860
!أنت رئيس الطهاة الجديد يا ماو

207
00:16:07,930 --> 00:16:11,700
.حينها رحلت إلى غوانزو لأجل التدريب

208
00:16:12,650 --> 00:16:15,320
.وعملتُ في مطعم ربيع يانغ

209
00:16:15,470 --> 00:16:17,330
.إنه محلّ تشو يو

210
00:16:18,940 --> 00:16:22,250
!لقد قلب كلّ تلك المكوّنات بشكلٍ مثالي

211
00:16:22,540 --> 00:16:25,480
.ذاك الرّجل هو رئيس الطهاة المنتدب

212
00:16:25,480 --> 00:16:27,210
.إنه أبي

213
00:16:34,250 --> 00:16:36,010
.لقد شبعت

214
00:16:36,750 --> 00:16:38,580
.تعرف ما يعنيه هذا يا سانجي

215
00:16:38,580 --> 00:16:39,900
.أنت مطرود

216
00:16:39,900 --> 00:16:41,020
!مهلًا

217
00:16:41,470 --> 00:16:43,020
!امنحه فرصة أخرى

218
00:16:43,020 --> 00:16:46,770
!أعدك أنّ نطبخ أنا وسانجي لحم بالفلفل لذيذ غدًا

219
00:16:51,810 --> 00:16:53,650
!إنها نكهات جديدة

220
00:16:53,650 --> 00:16:57,070
!الحلاوة الدقيقة تمنح عمقًا للنّكهات

221
00:16:58,270 --> 00:17:01,040
ما هو تقليد مطعم ربيع يانغ؟

222
00:17:01,640 --> 00:17:04,000
!قلب التقاليد يا سيدي

223
00:17:04,400 --> 00:17:05,820
.جيد

224
00:17:05,820 --> 00:17:09,280
.لا توجد نكهة يلتزم بها هذا المطعم

225
00:17:09,280 --> 00:17:13,470
.رغبتكما في اكتشاف نكهات جديدة تستحقّ التقدير

226
00:17:14,620 --> 00:17:15,470
...تقصد

227
00:17:16,080 --> 00:17:16,930
!أجل

228
00:17:22,960 --> 00:17:25,650
.ماو، لقد سررت بلقائك

229
00:17:26,380 --> 00:17:27,980
.سأغادر المطعم

230
00:17:28,420 --> 00:17:32,470
.سوف أعود إلى مطعمي وأشرع في التدريب من جديد

231
00:17:33,010 --> 00:17:37,250
،إن زُرتَ شانغهاي يومًا
.سأطبخ لك طبقًا لذيذًا

232
00:17:37,820 --> 00:17:40,870
.سأواصل العمل بمطعم ربيع يانغ لأجلك أيضًا

233
00:17:42,490 --> 00:17:44,740
...قابلت وفارقت الكثير من الناس في رحلتي

234
00:17:45,790 --> 00:17:50,500
.سوف تشارك في اختبار معيّن في غوانزو

235
00:17:51,070 --> 00:17:55,800
.قد يحدّد هذا الاختبار الطريق الذي يجب أن تسلكه

236
00:17:57,590 --> 00:18:01,640
.اختبر إلى أيّ مدى يمكن لقوّتك أن تأخذك

237
00:18:02,670 --> 00:18:04,630
.حاضر يا تشو يو-سان

238
00:18:12,590 --> 00:18:16,780
ماو من مطعم ربيع يانغ، الذي
.قدّم طبقًا من معكرونة معجون السلّور

239
00:18:17,520 --> 00:18:22,910
وفاي من بيت دايتونغ، الذي قدّم
.معكرونة عامرة باستخدام البطاطس

240
00:18:23,740 --> 00:18:25,780
.تهانينا على الوصول إلى هذا الحد

241
00:18:26,740 --> 00:18:29,720
.هذه مهمتكما الأخيرة

242
00:18:30,980 --> 00:18:33,530
.قيّما طبقكما

243
00:18:39,320 --> 00:18:43,760
.أوّلًا يا ماو، أعلن عن تقييمك من عشرة

244
00:18:44,920 --> 00:18:46,070
.عشرة

245
00:18:46,070 --> 00:18:48,330
ماو، علامة كاملة؟

246
00:18:49,370 --> 00:18:53,070
،ربّما ما زلت طبّاخًا متدرّبًا

247
00:18:53,070 --> 00:18:56,320
لكنّي أخرجتُ كلّ ما في ذوقي ومهارتي وقلبي

248
00:18:56,320 --> 00:18:58,600
.لتقديم أفضل طبقٍ ممكن

249
00:18:58,600 --> 00:19:01,370
!كطبّاخ، يمكنني أن أمنح نفسي العلامة الكاملة فحسب

250
00:19:02,080 --> 00:19:04,420
فاي، ماذا عنك؟

251
00:19:06,110 --> 00:19:08,000
.أمنح طبقي عشرة أيضًا

252
00:19:08,000 --> 00:19:11,760
.قال بالفعل كلّ ما أريد أن أقول

253
00:19:12,330 --> 00:19:14,670
.أفتخر لدعوته بمنافسي

254
00:19:24,060 --> 00:19:29,140
.إذًا، سأعلن عن الفائز باختبار الطباخ الخارق

255
00:19:30,080 --> 00:19:32,420
،فاي، ماو. بقدر معرفتي وعلمي

256
00:19:32,420 --> 00:19:36,280
.طبقا المعكرونة خاصتكما كانا متسوايين بشكلٍ مثاليّ

257
00:19:37,670 --> 00:19:40,520
.كلاكما تملكان المهارة لتصبحا طباخين خارقين

258
00:19:40,990 --> 00:19:44,500
كان الغرض من سؤالي الأخير
،هو أن أختبر فخركما كطباخين

259
00:19:44,500 --> 00:19:48,120
.وكلاكما أدّيتما بإعجاب في هذا الاختبار أيضًا

260
00:19:48,640 --> 00:19:50,150
...بالتالي

261
00:19:51,530 --> 00:19:55,130
.أمنحكما معًا لقب الطباخ الخارق

262
00:19:55,740 --> 00:19:57,290
!أجل

263
00:19:56,490 --> 00:19:58,000
!ماو

264
00:19:58,940 --> 00:20:01,550
!أجل! نجحت يا ميلي

265
00:20:01,550 --> 00:20:03,800
!لقد اتّخذت خطوة أقرب إلى أمي

266
00:20:08,280 --> 00:20:11,480
...يبدو أنك تعرف أمي

267
00:20:11,790 --> 00:20:12,810
كيف؟

268
00:20:13,550 --> 00:20:19,330
أظنني يمكنني أن أخبرك أنّنا
.نحن الاثنين تلمذين زميلين

269
00:20:19,330 --> 00:20:20,190
ماذا؟

270
00:20:20,590 --> 00:20:24,530
.إن أردت أن تعرف أكثر، عليك أن تهزمني مجدّدًا

271
00:20:25,460 --> 00:20:27,910
.فاي، هذا ليس عدلًا

272
00:20:28,250 --> 00:20:31,620
!مهلًا! أخبرني يا فاي

273
00:20:38,070 --> 00:20:39,320
...شوماي

274
00:20:40,720 --> 00:20:43,600
.فاي؟ هذا يعيد الذكريات

275
00:20:43,970 --> 00:20:46,720
.لم أره منذ اختبار الطباخ الخارق

276
00:20:48,560 --> 00:20:50,280
.آمل أن أستطيع منافسته مجدّدًا

277
00:20:55,830 --> 00:20:58,410
!أنت! أفق

278
00:20:58,690 --> 00:21:00,610
!أبلغ تشو يو بهذا

279
00:21:01,740 --> 00:21:04,650
.فشل؟ يا للأحمق

280
00:21:05,320 --> 00:21:09,660
لم يستطع حتّى أن يتخلّص من
.الخائن ليون ذو سكاكين النجم السبعة

281
00:21:10,260 --> 00:21:14,640
لكن لا بدّ أنهم يعلمون أنّ
.هنالك أكثر من آنية أسطورية واحدة

282
00:21:17,370 --> 00:21:19,970
.أيها الحاكم، أرسلني تاليًا

283
00:21:20,560 --> 00:21:23,010
.لا يستحقّ الأمر إرسالك

284
00:21:23,940 --> 00:21:28,320
.كلّا، أعرف من سيقف في طريقنا تاليًا

285
00:21:29,150 --> 00:21:33,810
.إنّه طبّاخ خارق وأكرهه بكلّ جوارحي

286
00:21:35,630 --> 00:21:39,220
.يبدو أنّ لديك تاريخًا معه يا شو آن

287
00:21:39,600 --> 00:21:44,150
.أجل. أنا مدين له بالكثير

288
00:21:50,820 --> 00:21:55,160
،أفضل طبّاخ ديم سَم في البلاد
.شي لو ذو القضيب الفولاذي

289
00:21:55,670 --> 00:21:59,190
،سيّد مهارات القطع الصغير
.ليون ذو سكاكين النجم السبعة

290
00:22:00,020 --> 00:22:04,090
.والطباخ الخارق الأصغر، ليو ماوشين

291
00:22:04,820 --> 00:22:09,280
سويًّا، أربعة طبّاخين يافعين استثنائيّين قد وحّدوا قواهم

292
00:22:09,280 --> 00:22:13,760
.وبدؤوا معركتهم ضدّ عالم الطبخ السريّ

293
00:23:56,990 --> 00:24:12,270
في الحلقة القادمة

294
00:24:09,650 --> 00:24:11,330
".شانغهاي، مدينة الشياطين"