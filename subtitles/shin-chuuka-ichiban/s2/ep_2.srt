1
00:01:33,740 --> 00:01:36,970
ماذا يعني ثلاثيّ التّوفو بالضّبط؟

2
00:01:37,400 --> 00:01:39,290
.ثلاثيّ التّوفو

3
00:01:39,960 --> 00:01:43,990
.المكوّنات هي التّوفو والمعكرونة واللّحم

4
00:01:43,990 --> 00:01:45,870
.هذا كلّ ما استخدمه

5
00:01:47,370 --> 00:01:48,630
...لا، مهلًا

6
00:01:49,380 --> 00:01:50,780
!هل يعقل؟

7
00:01:51,900 --> 00:01:54,050
ماذا؟ أين شيرو؟

8
00:01:54,910 --> 00:01:57,150
ماذا تفعل؟

9
00:01:58,470 --> 00:01:59,550
ماذا؟

10
00:02:00,040 --> 00:02:02,300
.أنت محتال كعادتك

11
00:02:03,010 --> 00:02:05,630
.يستحسن أنّك غسلت يديك جيّدًا

12
00:02:05,630 --> 00:02:07,980
.أجل، بالطّبع

13
00:02:11,130 --> 00:02:13,260
.إنّه توفو عاديّ في النّهاية

14
00:02:15,940 --> 00:02:16,910
هل يمكن؟

15
00:02:16,910 --> 00:02:19,550
!هذا ليس لحمًا. إنّه توفو

16
00:02:19,550 --> 00:02:20,360
توفو؟

17
00:02:21,370 --> 00:02:23,080
ماذا تقصد؟

18
00:02:23,800 --> 00:02:26,830
،قام بقلي اللّب المنتج من عمليّة طبخ التّوفو قليًا خفيفًا

19
00:02:26,830 --> 00:02:28,890
،وتبّله بصلصة الفلفل الحارّ بالإضافة إلى صلصة الصّويا

20
00:02:28,890 --> 00:02:31,420
.ثمّ غلّفه بالبطاطا الجبليّة وقلاه

21
00:02:31,420 --> 00:02:33,920
ما هو المكوّن الأخير إذًا؟

22
00:02:35,430 --> 00:02:36,540
،معكرونة

23
00:02:36,540 --> 00:02:39,380
.وهذه المعكرونة هي النّوع الثّالث من التّوفو

24
00:02:39,380 --> 00:02:40,810
ماذا؟

25
00:02:40,810 --> 00:02:44,350
هذه المعكرونة المنتفخة
!والمتماسكة اللّذيذة مصنوعة من التّوفو؟

26
00:02:44,350 --> 00:02:45,980
.فعلًا

27
00:02:45,980 --> 00:02:50,760
،بعد إزالة الرّطوبة عن التّوفو بواسطة حجر ثقيل

28
00:02:50,760 --> 00:02:53,980
هرسته ومزجته مع الطّحين، ثمّ عجنته

29
00:02:53,980 --> 00:02:55,730
.وشكّلتُ منه معكرونة توفو خاصّة

30
00:02:55,730 --> 00:03:00,240
صلصة التّوفو النشويّة واللّحم
!المعدّ من لبّ التّوفو ومعكرونة التّوفو

31
00:03:00,240 --> 00:03:07,200
الطّعم ثلاثيّ الأبعاد الّذي شكّلته معًا
!هو طبيعة ثلاثيّ التّوفو خاصّتي الحقيقيّ

32
00:03:12,290 --> 00:03:14,730
.عرفتها

33
00:03:14,730 --> 00:03:18,260
".إذًا لا بدّ أنّ هذا هو "الطّبق

34
00:03:18,840 --> 00:03:22,760
.لن نستطيع أن نتوصّل إلى نتيجة دون أن نناقش الأمر أوّلًا

35
00:03:23,310 --> 00:03:25,140
.يا رجال، تعالوا معي

36
00:03:25,140 --> 00:03:26,220
.حاضر

37
00:03:26,600 --> 00:03:29,180
.هذا ليس جيّدًا

38
00:03:32,520 --> 00:03:37,320
ماو، أسبق وأن سرت حافيًا على الشّاطئ؟

39
00:03:38,610 --> 00:03:41,380
.ترعرعتُ في أعماق غابة سيتشوان

40
00:03:41,380 --> 00:03:45,590
هذا ما فعلت بعد أن غادرت سيتشوان
.ووصلت إلى المحيط للمرّة الأولى

41
00:03:46,810 --> 00:03:49,810
.شعور الماء وهو يحيط قدمي العاريتان

42
00:03:49,810 --> 00:03:51,970
.رائحة شاطئ البحر وهي تداعب أنفي

43
00:03:51,970 --> 00:03:53,900
.وصوت الأمواج المتصاعدة

44
00:03:54,500 --> 00:03:58,210
.أشكالها تختلف، لكن تبقى كلّها مياه البحر

45
00:03:58,210 --> 00:04:02,440
.وهذه نعمة ثلاثيّة الحواس تأتي فقط من ماء البحر

46
00:04:02,860 --> 00:04:05,150
.والطّبخ سيّان

47
00:04:08,580 --> 00:04:13,150
ثمّة شعور ثلاثيّ الأبعاد معيّن يتمّ
اختباره فقط عندما يتّخذ مكوّن واحد

48
00:04:13,150 --> 00:04:15,590
.عدّة أشكال تتوحّد مع بعضها

49
00:04:16,630 --> 00:04:20,220
.خسرتَ معركة التّوفو هذه

50
00:04:21,110 --> 00:04:22,630
.إنّه ضخم

51
00:04:22,630 --> 00:04:26,420
.شو آن يبدو عملاقًا بصوة لا تصدّق

52
00:04:54,020 --> 00:04:55,410
هل حسموا قرارهم؟

53
00:04:55,410 --> 00:04:56,980
من فاز؟

54
00:04:56,980 --> 00:05:00,020
.يستحسن ألّا يكون تعادلًا

55
00:05:02,820 --> 00:05:04,900
.شكرًا على الانتظار

56
00:05:07,320 --> 00:05:12,490
.مع الأسف، لم نستطع التوصّل إلى نتيجة واحدة

57
00:05:12,490 --> 00:05:13,700
!ماذا؟

58
00:05:14,000 --> 00:05:16,500
سنطلب الآن من كلّ حكم أن يعلن

59
00:05:16,500 --> 00:05:21,500
.ما إن كان يصوّت على طبق ماو أو شو آن

60
00:05:21,500 --> 00:05:26,540
.مع الأسف، كان من الصّعب للغاية الاختيار بين طبقيهما

61
00:05:26,540 --> 00:05:28,730
.سنبدأ بالمحافظ هو

62
00:05:28,730 --> 00:05:30,100
.حسنًا

63
00:05:34,500 --> 00:05:38,150
.أصوّت على ثلاثيّ التّوفو الخاصّ بشو آن

64
00:05:40,310 --> 00:05:42,280
،جعل المكوّن الأساسيّ يغنّي

65
00:05:42,280 --> 00:05:44,850
.منتجًا طعمًا ثلاثيًّا يأتيك من ثلاثية اتّجاهات

66
00:05:44,850 --> 00:05:47,820
.إنّه طبق توفو مذهل. تحفة حقيقيّة

67
00:05:48,880 --> 00:05:51,530
.لا بأس. ما زال هناك المزيد من الحكّام

68
00:05:51,530 --> 00:05:52,950
!التّالي

69
00:05:53,850 --> 00:05:55,080
!أصوّت لماو

70
00:05:55,080 --> 00:05:56,210
!أجل

71
00:05:56,210 --> 00:06:00,420
الحيلة السّحريّة وعمق النّكهة الّتي حفّزت اللّسان بشكل مكرّر

72
00:06:00,420 --> 00:06:02,460
.كانت تفيض بالأصالة

73
00:06:07,960 --> 00:06:09,320
.أصوّت لماو أيضًا

74
00:06:09,320 --> 00:06:13,430
.هذه أوّل مرّة أختبر فيها مثل هذه المتعة أثناء الأكل

75
00:06:14,550 --> 00:06:15,430
!أجل

76
00:06:15,430 --> 00:06:16,360
.صوت آخر

77
00:06:16,360 --> 00:06:17,730
.وسيفوز ماو

78
00:06:23,700 --> 00:06:24,610
!التّالي

79
00:06:26,230 --> 00:06:28,620
.عانيتُ لاختيار فائز

80
00:06:29,930 --> 00:06:32,530
.لكنّي أصوّت لشو آن

81
00:06:32,530 --> 00:06:35,840
يعرف كلّ ما يحيط بخصائص المكوّن

82
00:06:35,840 --> 00:06:38,360
.واستخلص نكهته الحقيقيّة بطرق مختلفة

83
00:06:38,360 --> 00:06:41,000
.سأدفع الغالي والنّفيس لاكتساب تلك المهارة الممتازة

84
00:06:41,000 --> 00:06:42,480
.إنّه تعادل اثنين لاثنين

85
00:06:42,480 --> 00:06:44,710
.سيحسم الصّوت التّالي الفائز

86
00:06:44,710 --> 00:06:46,230
من سيكون؟

87
00:06:46,960 --> 00:06:52,220
.كلا الطّبقين تحفتان تأخذان طبق التّوفو إلى أقصى مفاهيمه

88
00:06:52,220 --> 00:06:55,100
.وكلاهما معدّان بنفس العناية

89
00:06:55,100 --> 00:06:57,740
،لكن بصفتي الرّجل الّذي يدير مدينة شانغهاي العالميّة

90
00:06:57,740 --> 00:07:00,770
اعتمدت بقراري

91
00:07:01,590 --> 00:07:04,110
.عن الإبداع والعالميّة

92
00:07:04,110 --> 00:07:05,430
...الإبداع

93
00:07:05,430 --> 00:07:07,110
العالميّة؟

94
00:07:07,110 --> 00:07:10,070
.بدأ طبق ماو باستعراض قبل الوجبة

95
00:07:10,070 --> 00:07:13,890
كلّ شيء وصولًا إلى المعاملة الحاذقة
للتّوفو ثنائيّ اللّون، الأسود والأبيض

96
00:07:13,890 --> 00:07:17,390
.أظهر إبداعًا مستوحى بشكل مذهل

97
00:07:17,390 --> 00:07:22,040
.كما فاض بعالميّة تجعل أيّ أحد في العالم يسعد في لحظة

98
00:07:22,470 --> 00:07:24,250
.ثمّ لدينا طبق شو آن

99
00:07:24,250 --> 00:07:26,550
.حوّل التّوفو إلى أشكال مختلفة

100
00:07:26,550 --> 00:07:29,630
.صلصة التّوفو النّشويّة ولحم لبّ التّوفو ومعكرونة التّوفو

101
00:07:29,630 --> 00:07:33,440
تمّ استخلاص الجاذبيّة الفريدة لكلّ منها عبر الإبداع الطّبخيّ

102
00:07:33,440 --> 00:07:36,270
.لطعم ثلاثيّ الأبعاد يُذهلنا

103
00:07:36,270 --> 00:07:38,430
،باستخدام المكوّن المحدود للتّوفو فقط

104
00:07:38,430 --> 00:07:42,710
،منحنا صورة قلبت عالميّتها رأسًا على عقب

105
00:07:42,710 --> 00:07:46,500
.ما أحيا أرض سيتشوان أمام ناظرنا

106
00:07:47,820 --> 00:07:51,280
.لكن، هذا هو جوابي

107
00:07:59,660 --> 00:08:01,120
!صمتًا

108
00:08:04,060 --> 00:08:06,520
!أيّها المحافظ تشان، أخبرني

109
00:08:06,520 --> 00:08:10,110
،غادرت سيتشوان ودرستُ الطّبخ من حول الصّين

110
00:08:10,110 --> 00:08:12,690
.وحتّى أنّني أتقنتُ مهارات العالم السّفليّ

111
00:08:13,270 --> 00:08:15,770
.يتفوّق طبقي حتّى على طبخ المعلّمة باي

112
00:08:15,770 --> 00:08:20,520
لا أفهم كيف يخسر أمام طبق ماو
.لا من حيث الإبداع ولا العالميّة

113
00:08:24,320 --> 00:08:27,940
.شو آن، طبقك ليس أصليًّا

114
00:08:28,400 --> 00:08:30,330
ليس أصليًّا؟

115
00:08:30,330 --> 00:08:32,150
ماذا تقصد؟

116
00:08:32,730 --> 00:08:37,110
.أكلت هذا الطّبق من قبل

117
00:08:37,780 --> 00:08:39,920
أنت... ماذا؟

118
00:08:41,400 --> 00:08:44,130
.كان ذلك قبل سبع سنوات

119
00:08:44,130 --> 00:08:47,910
على الرّغم من أنّني استقرّيت
،في سوق شانغهاي مذّاك الحين

120
00:08:47,910 --> 00:08:50,100
عندما كنتُ تاجر مواد غذائيّة

121
00:08:50,100 --> 00:08:52,590
.سافر شمالًا وجنوبًا في حوض نهر يانغتسي

122
00:08:52,590 --> 00:08:56,950
.حينها صادفت هذا الطّبق في مطعم معيّن

123
00:09:03,040 --> 00:09:05,190
.لحم، لكنّه ليس لحمًا

124
00:09:05,190 --> 00:09:07,230
.معكرونة، لكنّها ليست معكرونة

125
00:09:07,230 --> 00:09:10,120
كنت منتشيًا بالعطر التّرابيّ الّذي انتشر في فمي

126
00:09:10,120 --> 00:09:12,940
.والشّعور اللّطيف للوجبة الّتي تنزلق من حلقي

127
00:09:12,940 --> 00:09:15,400
المطعم... هل يعقل؟

128
00:09:15,400 --> 00:09:19,120
.هذا صحيح. كان برج الأقحوان

129
00:09:19,120 --> 00:09:25,120
بتعبير آخر يا شو آن، طبق ثلاثيّ التّوفو
.خاصّتك هو طبق المعلّمة باي الأصليّ

130
00:09:33,090 --> 00:09:36,970
تعلّمت ذلك الطّبق من أمّي؟

131
00:09:37,300 --> 00:09:39,930
.مستحيل. لم تعلّمني

132
00:09:39,930 --> 00:09:43,390
!ثلاثيّ التّوفو هو طبقي الأصليّ

133
00:09:45,620 --> 00:09:48,590
!ورحلتُ أرتحل عبر الجبال وسبحت في المحيط

134
00:09:49,070 --> 00:09:52,250
...إنّه لي. لي

135
00:09:52,250 --> 00:09:54,960
.هذا ساخر يا شو آن

136
00:09:54,960 --> 00:09:58,210
،حاولت أن تضع مسافة بينك وباي

137
00:09:58,210 --> 00:09:59,670
لكنّ الوجهة الّتي وصلت لها

138
00:09:59,670 --> 00:10:02,980
.كانت طبق باي، طبقٌ لم تعلّمك إعداده قطّ

139
00:10:04,410 --> 00:10:08,620
.دائمًا ما تعود قلوب النّاس إلى أوطانها

140
00:10:09,030 --> 00:10:11,790
قد تكون مدينة شانغهاي

141
00:10:11,790 --> 00:10:16,090
الّتي على طرف نهر يانغتسي الّذي
.يبلغ طوله 16،000 كيلومترًا هي حدودك

142
00:10:24,020 --> 00:10:25,020
.هكذا

143
00:10:26,440 --> 00:10:29,980
ضع المفصل الأوّل من إصبعك
.الأوسط الأيسر على طرف السّكّين

144
00:10:32,040 --> 00:10:33,190
.نجحت

145
00:10:33,190 --> 00:10:35,670
.شو آن، لديك غرائز عظيمة

146
00:10:35,670 --> 00:10:37,440
.أنا متشوّقة لمستقبلك

147
00:10:37,440 --> 00:10:40,260
.شكرًا لك يا معلّمة باي

148
00:10:42,280 --> 00:10:47,090
ويا ماو، قد يكون العامل الحاسم من نكهة طبقك

149
00:10:47,090 --> 00:10:49,570
.هو رائحة أوراق الخيزران

150
00:10:50,380 --> 00:10:52,540
رائحة أوراق الخيزران؟

151
00:10:52,920 --> 00:10:59,580
.أضاف هذا العطر الحلو عمقًا لطبقك اللّامع

152
00:10:59,580 --> 00:11:02,750
.وأضفى إليه لون الحنين الجميل

153
00:11:05,270 --> 00:11:06,950
.والآن ننتقل للنّتائج

154
00:11:06,950 --> 00:11:11,450
.بنتيجة ثلاثة لاثنين، الفائز هو الطبّاخ الخارق ليو ماوشين

155
00:11:11,450 --> 00:11:16,360
الفائز بمعركة الطّبخ من ثلاث
.جولات هو تحالف مطبخ شانغهاي العظيم

156
00:11:21,630 --> 00:11:23,240
!أجل

157
00:11:36,840 --> 00:11:38,600
أنت، هل أنت بخير؟

158
00:11:40,580 --> 00:11:43,160
كيف سار النّزال يا سيّدي؟

159
00:11:43,160 --> 00:11:44,300
مهلًا، من أنت؟

160
00:11:44,670 --> 00:11:45,970
.هذا نفس سؤالي لك

161
00:11:45,970 --> 00:11:47,760
لمَ كنت نائمًا هنا؟

162
00:11:47,760 --> 00:11:51,730
.كنتُ أحرس وثيقة مهمّة مخبّأة في السّقف

163
00:11:53,440 --> 00:11:55,440
ما معنى هذا؟

164
00:12:01,840 --> 00:12:03,160
.يبدو أنّهم قاموا بتنويمك

165
00:12:04,750 --> 00:12:05,760
!سحقًا

166
00:12:05,760 --> 00:12:08,120
الأهمّ، كيف آلت المسابقة؟

167
00:12:08,120 --> 00:12:08,950
مسابقة؟

168
00:12:08,950 --> 00:12:12,490
.يواجه معارف المعلّم الشّاب طبّاخي العالم السّفليّ

169
00:12:12,490 --> 00:12:14,080
!تبًّا، لا أملك الوقت لهذا

170
00:12:14,080 --> 00:12:16,330
هل تعمل في مطعم لونتشين؟

171
00:12:16,330 --> 00:12:18,040
.ماذا؟ أجل، فعلًا

172
00:12:18,040 --> 00:12:21,910
.أريد أن أسألك عن المعلّم تان لي

173
00:12:21,910 --> 00:12:23,760
عمّاذا تتحدّث؟

174
00:12:32,270 --> 00:12:33,470
.لا أحد هنا

175
00:12:33,470 --> 00:12:35,580
.كانوا هنا قبل هنيهة

176
00:12:36,940 --> 00:12:38,040
!سيّدي

177
00:12:40,720 --> 00:12:42,040
هل أنت بخير؟

178
00:12:42,530 --> 00:12:44,740
.لنغادر هذا المكان فورًا

179
00:12:45,030 --> 00:12:46,980
.لنسرع بالخروج من هذه السّفينة

180
00:12:46,980 --> 00:12:48,920
.من الغريب أنّه لا يوجد أيّ حرس

181
00:12:48,920 --> 00:12:51,200
.ما زال المعلّم الصّغير وأصدقاؤه في السّطح

182
00:12:51,200 --> 00:12:52,160
.علينا أن نبلغهم

183
00:12:52,160 --> 00:12:52,990
المعلّم الصّغير؟

184
00:12:52,990 --> 00:12:57,330
.أجل. إنّه يواجه العالم السّفليّ على سطح السّفينة الآن

185
00:12:57,330 --> 00:13:01,090
.علينا أن نمنح الأولويّة لإسعاف المعلّم تان لي المصاب الآن

186
00:13:01,090 --> 00:13:04,480
.إن أهدرنا هذه الفرصة، فقد يكون من الأصعب إنقاذه

187
00:13:04,880 --> 00:13:05,680
.مفهوم

188
00:13:07,180 --> 00:13:09,420
.هذه هي الوثيقة

189
00:13:09,420 --> 00:13:10,970
أهذا ما أردته؟

190
00:13:10,970 --> 00:13:13,320
،بما أنّ الهزيمة باتت محتملة

191
00:13:13,320 --> 00:13:15,880
.ينبغي أن ننتقل إلى مسار العمل التّالي

192
00:13:16,260 --> 00:13:17,140
.حاضر

193
00:13:18,560 --> 00:13:20,970
.نتيجة المعركة ليست أولويّتنا

194
00:13:20,970 --> 00:13:22,980
.هذه كلّ ما يهمّ

195
00:13:22,980 --> 00:13:25,350
.يجب أن أوصلها إليه

196
00:13:25,350 --> 00:13:28,120
لمَ العجلة يا آنسة؟

197
00:13:28,120 --> 00:13:30,530
.لم تسمعي بعد نتائج المسابقة

198
00:13:31,390 --> 00:13:34,500
.أعلم بمَ تفكّرين بالضّبط

199
00:13:34,500 --> 00:13:37,210
.والآن أعيدي تلك الورقة

200
00:13:42,430 --> 00:13:44,130
!شيان، أيّتها السّاقطة

201
00:13:48,950 --> 00:13:51,680
.كان تفكيرك سطحيًّا للغاية يا سيّد الدّيم سام

202
00:13:57,480 --> 00:13:59,480
!ما الّذي يجري؟

203
00:13:59,480 --> 00:14:00,560
!ماو، أسرع

204
00:14:02,070 --> 00:14:03,820
!ماذا فعلت يا شو آن؟

205
00:14:03,820 --> 00:14:07,610
.تمّ التخلّي عن الجميع، بمن فيهم أنا

206
00:14:07,990 --> 00:14:11,640
.أظنّهم لم يتوقّعوا منّي أن أنجح

207
00:14:11,640 --> 00:14:12,780
ماذا؟

208
00:14:13,070 --> 00:14:16,250
.نحن على بعد 100 كيلومتر من مصبّ نهر يانغتسي

209
00:14:16,250 --> 00:14:19,270
.لن ينجو أيّ أحد

210
00:14:19,270 --> 00:14:22,160
.وسنختفي جميعًا في القبور المائيّة

211
00:14:23,550 --> 00:14:25,490
!أرشدوا ضيوفنا

212
00:14:25,490 --> 00:14:27,340
!قوارب النّجاة على جانب المنفذ الخلفيّ

213
00:14:27,340 --> 00:14:28,680
!حاضر

214
00:14:28,680 --> 00:14:31,140
.الأواني الأسطوريّة لي

215
00:14:31,140 --> 00:14:35,760
،حكّام قلّلوا من قوّتنا، خاسرون حمقى

216
00:14:35,760 --> 00:14:39,830
.والطّهاة الأغبياء الّذين تحدّونا بسذاجة في مسابقة

217
00:14:44,690 --> 00:14:46,280
.ويحي

218
00:14:46,280 --> 00:14:48,640
،ستكون الإطاحة بتلك المرأة سهلة

219
00:14:48,640 --> 00:14:51,110
.لكن عليّ أن أستعيد تلك الوثيقة أوّلًا

220
00:14:51,110 --> 00:14:52,470
!انتظري مكانك يا شيان

221
00:14:52,470 --> 00:14:54,490
!لن أدعك تفعلي ما يحلو لك

222
00:15:08,210 --> 00:15:09,090
!تبًّا

223
00:15:15,520 --> 00:15:17,060
.يا للقبح

224
00:15:19,850 --> 00:15:24,060
.لا أحد يحبّ الرّجل العنيد يا سيّد الدّيم سام

225
00:15:27,440 --> 00:15:29,690
.ماو، أترك الباقي لك

226
00:15:39,600 --> 00:15:41,660
!سيّدي، أبوك بخير

227
00:15:41,660 --> 00:15:43,520
!عليك أن تهرب

228
00:15:43,520 --> 00:15:44,930
!مفهوم

229
00:15:45,460 --> 00:15:47,230
.حسنًا، لنذهب

230
00:15:47,230 --> 00:15:48,400
!أجل

231
00:15:48,960 --> 00:15:51,380
!يا إلهي، من الأفضل أن نسرع

232
00:15:57,640 --> 00:16:01,130
أولئك الحقيرون. كيف يجرؤون؟

233
00:16:01,580 --> 00:16:03,110
ألا توجد أيّ قوارب أخرى؟

234
00:16:03,110 --> 00:16:06,150
.كلّا. علينا أن نذهب لشانغهاي سباحةً

235
00:16:09,630 --> 00:16:10,690
أهي معك؟

236
00:16:10,690 --> 00:16:12,070
.فشلتُ في سرقتها

237
00:16:12,070 --> 00:16:15,030
.لكن لن يغادر أيّ أحد هذه السّفينة قيد الحياة

238
00:16:16,840 --> 00:16:18,030
.حرّرا القارب

239
00:16:18,030 --> 00:16:19,810
.سنغادر هذا المكان

240
00:16:22,920 --> 00:16:26,380
.تراجعي، وإلّا غادري هذا المكان

241
00:16:26,890 --> 00:16:30,840
لا يمكن أنّك تظنّين أنّكم الوحيدون
.الّذين سيفرّون على متن هذا القارب

242
00:16:31,880 --> 00:16:35,990
كيف سيتّسع كلّ أولئك النّاس على متن هذا القارب الصّغير؟

243
00:16:37,670 --> 00:16:38,840
.معها حقّ

244
00:16:40,270 --> 00:16:42,110
.لم ينته الأمر بعد

245
00:16:42,110 --> 00:16:45,150
!اليوم هو بداية الحرب فحسب

246
00:16:51,300 --> 00:16:53,000
.لنُدر هذا القارب يا ليو

247
00:16:53,000 --> 00:16:55,620
.لا يمكننا سوى أن نمنح الأولويّة للّذين لا يستطيعون السّباحة

248
00:16:55,620 --> 00:16:56,410
.أجل

249
00:17:06,330 --> 00:17:09,310
،بعبارة أخرى، لم أفشل في التفوّق على باي فحسب

250
00:17:09,310 --> 00:17:12,630
.بل وما زلتُ أقف عند راحة يدها

251
00:17:17,820 --> 00:17:20,260
.آسف يا سيّدي. سنغادر

252
00:17:20,260 --> 00:17:22,240
!اعتن بأبي

253
00:17:25,710 --> 00:17:28,270
ماذا؟ في؟

254
00:17:28,630 --> 00:17:30,230
من يكون؟

255
00:17:30,230 --> 00:17:32,110
.لا يمكن أن يكون هو

256
00:17:32,110 --> 00:17:34,390
ماذا؟ بالتّفكير في الأمر، أين ماو؟

257
00:17:34,390 --> 00:17:35,150
ماذا؟

258
00:17:35,150 --> 00:17:38,110
.مستحيل. كان معنا قبل برهة

259
00:17:44,980 --> 00:17:48,680
.يبدو أنّ السّماء تخلّت عنّي تمامًا

260
00:17:49,170 --> 00:17:52,290
.لا أصدّق أنّني فشلتُ حتّى في واجبي كطبّاخ العالم السّفليّ

261
00:17:54,600 --> 00:17:57,380
من يكترث لمطبخ العالم السّفليّ بعد الآن؟

262
00:17:57,940 --> 00:18:00,300
!لقد تخلّوا عنك

263
00:18:00,300 --> 00:18:01,370
.هذا صحيح

264
00:18:01,370 --> 00:18:05,200
.هذا ما أستحقّه لتخليّ عن برج الأقحوان والمعلّمة باي

265
00:18:05,200 --> 00:18:06,720
.بادر واسخر منّي يا ماو

266
00:18:06,720 --> 00:18:10,830
.لم أبتعد قطّ عن الشّخص الّذي ظننت أنّي تخليت عنه

267
00:18:13,880 --> 00:18:17,610
.إلّم نغادر الآن فلن نرجع أحياء

268
00:18:17,610 --> 00:18:22,030
!إذًا، لتعش أنت فقط يا ماو

269
00:18:29,220 --> 00:18:30,420
!شو آن

270
00:18:51,190 --> 00:18:54,350
ماذا تظنّ نفسك فاعل؟

271
00:18:54,350 --> 00:18:57,650
!أسرع. تمسّك بي بكلتا يديك

272
00:18:59,110 --> 00:19:03,710
.أنا الرّجل الّذي خان والدتك وقادها إلى حتفها

273
00:19:03,710 --> 00:19:06,620
لماذا يا ماو؟ لمَ تنقذني؟

274
00:19:06,620 --> 00:19:09,190
.لا أدري

275
00:19:09,190 --> 00:19:13,540
.لكنّك أعددت طبقًا لأمّي حتّى أنا لم أكن أعرف عنه

276
00:19:13,540 --> 00:19:16,210
!لن أدعك تموت

277
00:19:27,930 --> 00:19:29,650
.خذ هذه يا ماو

278
00:19:29,650 --> 00:19:31,980
.ستفيدك يومًا ما

279
00:19:33,310 --> 00:19:37,220
.لن أعود إلى جبال سيتشوان

280
00:19:37,220 --> 00:19:39,900
.شانغهاي هي ملاذي الأخير

281
00:19:39,900 --> 00:19:44,580
.سأستريح في المحيط الّذي بجّلته طويلًا وحلمتُ به

282
00:19:46,700 --> 00:19:48,950
!تذكّرني ما حييت يا ماو

283
00:19:48,950 --> 00:19:53,460
!تلميذ المعلّمة باي الأوّل، شو آن

284
00:19:54,720 --> 00:19:57,680
!يا رجال، دعونا نشرع في هذه السّباحة الطّويلة الممتعة

285
00:19:57,680 --> 00:20:02,220
،إن كنتم غير واثقين من مقدرتكم على السّباحة
!اربطوا أنفسكم ببعض الألواح واسبحوا! مفهوم؟

286
00:20:02,220 --> 00:20:04,720
!أجل

287
00:20:04,720 --> 00:20:07,570
أختي، ألن يجعلك هذا تغرقين؟

288
00:20:07,570 --> 00:20:10,640
ماذا؟

289
00:20:13,600 --> 00:20:14,640
...ذلك

290
00:20:14,640 --> 00:20:17,070
.ذلك القارب الّذي ركبناه إلى شانغهاي

291
00:20:20,390 --> 00:20:21,660
.أيّها القبطان

292
00:20:21,990 --> 00:20:26,140
.ذلك السّيّد هو من اتّحاد الشّحن

293
00:20:26,140 --> 00:20:28,000
!يا رجال، توقّفوا بجانبهم

294
00:20:28,000 --> 00:20:28,950
!حاضر

295
00:20:31,060 --> 00:20:32,120
.يا إلهي

296
00:20:32,120 --> 00:20:33,750
!أُنقِذنا

297
00:20:45,430 --> 00:20:47,690
هل أنت بخير أيّها المحافظ هو؟

298
00:20:47,690 --> 00:20:50,220
.أجل. اهتمّ بالجرحى

299
00:20:50,220 --> 00:20:51,390
.مفهوم

300
00:20:54,490 --> 00:20:56,470
.هذا ساخر

301
00:20:57,360 --> 00:21:01,650
طُرد ذات مرّة من عالم الطّبخ
.لأنّه لم يستطع إعداد طبق معلّمته

302
00:21:05,920 --> 00:21:11,080
.وفي النّهاية، أعدّ نفس طبق معلّمته وخسر كلّ شيء

303
00:23:01,850 --> 00:23:04,040
.رائحة أوراق الخيزران

304
00:23:04,040 --> 00:23:05,820
.رائحة أمّي

305
00:23:05,820 --> 00:23:08,720
،إن كانت أمّي ترشدني في كلّ شيء

306
00:23:08,720 --> 00:23:13,020
.فربّما ما زلتُ فتيًّا تحت راحة يدها

307
00:23:14,280 --> 00:23:16,260
...ماذا؟ أليس هذا

308
00:23:21,870 --> 00:23:23,900
،الآنية الأسطوريّة الثّانية

309
00:23:25,750 --> 00:23:27,070
!قدر التنّين الملفوف

310
00:23:29,840 --> 00:24:00,640
في الحلقة القادمة

311
00:23:57,010 --> 00:23:59,040
".مجيء الشّيطان"