1
00:00:04,870 --> 00:00:08,400
!اشهدوا أضخم نار في الأرض

2
00:00:08,400 --> 00:00:10,390
،عندما يطلق تلك الحرارة

3
00:00:10,390 --> 00:00:12,740
!سيتغلّف كلّ شيء يلمسه إلى نيران

4
00:00:13,200 --> 00:00:18,370
.أرى أنّك طبّاخ على مستوى عجيب يا ليو ماوشين

5
00:00:18,370 --> 00:00:22,490
!لكنّ ذلك لا يكفي لهزيمتي

6
00:00:25,870 --> 00:00:28,040
!نهر النّار العظيم المقدّس

7
00:00:32,010 --> 00:00:33,530
...نهر يانغتسي

8
00:00:33,530 --> 00:00:35,010
!يحترق

9
00:02:08,030 --> 00:02:11,370
!أنا أركان أحد نجوم النّمر الخمسة من العالم السّفليّ

10
00:02:11,370 --> 00:02:15,040
،ليو ماوشين، إن كنت ستحرق قاربًا

11
00:02:15,040 --> 00:02:18,050
!فسأحوّل نهر يانغتسي إلى بحر من النّيران

12
00:02:19,440 --> 00:02:23,160
.لحم صغير الخنزير المشويّ المتفجّر والمطبوخ مرّتين

13
00:02:23,160 --> 00:02:26,930
.ماوشين، أنت مبهر بحقّ

14
00:02:26,930 --> 00:02:31,430
.لكن، أركان-ساما أكثر إبهارًا منك

15
00:02:31,430 --> 00:02:32,760
.هيّا بنا يا ليك

16
00:02:32,760 --> 00:02:34,090
!حاضر

17
00:02:35,180 --> 00:02:37,540
لمَ تتصرّف وكأنّها صديقتنا؟

18
00:02:38,970 --> 00:02:41,480
.إنّه لا يأخذ أيّ مكوّنات أو أواني

19
00:02:41,480 --> 00:02:44,500
فما الّذي ينوي فعله بذلك القارب؟

20
00:02:45,190 --> 00:02:46,470
ما ذلك الصّوت؟

21
00:02:52,980 --> 00:02:57,030
.انظروا. الكثير من السّمك يطفو فوق سطح الماء

22
00:02:57,030 --> 00:02:59,400
أركان-ساما، كيف هي هذه؟

23
00:03:00,490 --> 00:03:03,960
.اختيارك موفّق كما العادة يا ليك

24
00:03:03,960 --> 00:03:05,980
.انظروا لظهرها الأزرق الأسود

25
00:03:05,980 --> 00:03:08,410
.اختارت شبّوطًا أسودًا طازجًا باستثناء

26
00:03:09,000 --> 00:03:10,030
.الشبّوط الأسود

27
00:03:10,030 --> 00:03:15,700
إحدى أسماك المياه العذبة الأربع الرّئيسيّة
.ومكوّن فاخر في المطبخ الصّينيّ

28
00:03:15,700 --> 00:03:17,870
فكّها القويّ وذيلها الّذي تلوّح به

29
00:03:17,870 --> 00:03:21,010
.عند استخدامها لفكّها المذكور يعتبران لذيذين

30
00:03:21,010 --> 00:03:24,640
لكن لمَ صعدت كلّ تلك الأسماك للسّطح؟

31
00:03:24,640 --> 00:03:25,840
.البارود

32
00:03:26,470 --> 00:03:28,620
.أطلقا البارود أسفل الماء

33
00:03:28,620 --> 00:03:32,400
.طفت الأسماك الّتي ضُربت بالانفجار إلى السّطح

34
00:03:32,400 --> 00:03:34,520
إنّها طريقة فعّالة لصيد

35
00:03:34,520 --> 00:03:37,440
.أعداد كبيرة من الشبّوط الأسود الّتي تعيش في ضفاف النّهر

36
00:03:37,440 --> 00:03:39,180
.إنّها تُمطر

37
00:03:39,180 --> 00:03:41,110
.ينتابني شعور سيّئ حيال هذا

38
00:03:41,110 --> 00:03:43,820
.عمّاذا تتحدّثين؟ هذا من حسن حظّنا

39
00:03:43,820 --> 00:03:47,770
.سيخمد المطر ناره وسيُفسد طبقه

40
00:03:47,770 --> 00:03:50,830
لا. بل على العكس، يبدو أنّ النّار تتأجّج أكثر

41
00:03:50,830 --> 00:03:53,420
.وكأنّها تقاوم المطر

42
00:03:56,090 --> 00:03:58,110
.هيّا يا ليك

43
00:03:58,110 --> 00:03:59,400
!حاضر

44
00:04:00,940 --> 00:04:05,320
.قاما بإزالة الأحشاء بالفعل وتقطيعها بقطع عميقة ومنتظمة

45
00:04:05,320 --> 00:04:06,600
.يا لها من سرعة

46
00:04:06,600 --> 00:04:09,240
.لا يؤثّر به هذا المطر على الإطلاق

47
00:04:09,240 --> 00:04:10,950
.يا له من شخص مذهل

48
00:04:11,480 --> 00:04:14,850
.إنّه متّجه صوب النّيران مباشرةً

49
00:04:14,850 --> 00:04:16,630
!هل يحاول قتل نفسه؟

50
00:04:18,240 --> 00:04:21,610
!اشهدوا رقصة ناري

51
00:04:27,670 --> 00:04:30,130
!عجلة النّار السّماويّة العظيمة

52
00:04:34,720 --> 00:04:35,970
ما هذا؟

53
00:04:36,470 --> 00:04:39,960
يلوّح أركان بمجموعة من أسماك الشبّوط داخل النّار

54
00:04:39,960 --> 00:04:43,010
.بينما ترشّ تلك الفتاة شيئًا عليها

55
00:04:43,010 --> 00:04:46,970
!هذا ليس طبخًا، بل هي رقصة شيّقة وبهيّة

56
00:04:49,100 --> 00:04:52,720
،القوّة المتطلّبة للتّلويح بالسّمك مبهرة بالتّأكيد

57
00:04:52,720 --> 00:04:57,480
لكن علينا أن نركّز على النّقطة
.حيث تخترق أسماك الشبّوط النّيران

58
00:04:59,220 --> 00:05:02,460
.إنّه يلوّح بها فحسب كالمجنون

59
00:05:02,460 --> 00:05:04,450
.كلّا، هذا منطقيّ

60
00:05:04,450 --> 00:05:08,570
إنّه يحقّق أقصى استفادة من القوّة
.الطّاردة النّاتجة عن وزن الشبّوط

61
00:05:08,570 --> 00:05:09,990
القوّة الطّاردة؟

62
00:05:09,990 --> 00:05:13,280
.لا بدّ أنّ ليك ترشّها بالصّلصة

63
00:05:13,280 --> 00:05:17,070
،بما أنّ القطع الّذي في جسدها عميق باتّجاه الرّأس

64
00:05:17,070 --> 00:05:20,070
،فإنّ القوّة تسفر عن تشرّبها بالصّلصة بسرعة وهي تُطبخ

65
00:05:20,070 --> 00:05:22,700
.بينما تُزال الصّلصة الزّائدة في نفس الوقت

66
00:05:23,150 --> 00:05:27,820
.إضافة الصّلصة تكرارًا وطهي السّمك يعمّق من النّكهات

67
00:05:29,240 --> 00:05:31,180
.يبدو أنّه انتهى من الطّبخ

68
00:05:37,490 --> 00:05:40,020
تذوّقوا

69
00:05:41,000 --> 00:05:43,480
.طبق الشبّوط الأسود السّماويّ المشويّ العظيم خاصّتي

70
00:05:44,550 --> 00:05:46,000
،قمتَ بعرض كبير

71
00:05:46,000 --> 00:05:48,340
.إلّا أنّك لم تفعل شيئًا سوى قليِ بعض السّمك على النّار

72
00:05:48,340 --> 00:05:52,700
.كلّا، شوي السّمك نادر جدًّا في المطبخ الصّينيّ

73
00:05:53,030 --> 00:05:55,870
،لأنّ شوي السّمك يعدّ طريقة طبخ بسيطة جدًّا

74
00:05:55,870 --> 00:05:57,960
.إلّا أنّ الأمر يتطلّب مهارة عظيمة في استخدام النّار

75
00:05:57,960 --> 00:06:01,460
.أرى أنّك واثق تمام الثّقة بمهاراتك مع النّار

76
00:06:03,670 --> 00:06:07,090
.إنّها زكيّة للغاية، لدرجة أنّ غشائي المخاطيّ يذوب

77
00:06:21,470 --> 00:06:22,760
شيلو؟

78
00:06:24,260 --> 00:06:26,860
.إنّها طيّبة. لذيذة

79
00:06:26,860 --> 00:06:31,130
.أكره الاعتراف بهذا، لكنّها طيّبة لدرجة تصيبني بقشعريرة

80
00:06:32,950 --> 00:06:35,660
.أتاحت القوّة الطّاردة للصّلصة أن تتغلغل داخل السّمك

81
00:06:35,660 --> 00:06:38,530
يصعب التّصديق أنّه حقّق هذا العمق
.من النّكهة في ظرف وقتٍ قصير

82
00:06:38,530 --> 00:06:40,650
،ربّما تسبّبت القوّة في إزالة الوحل عن السّمك

83
00:06:40,650 --> 00:06:43,090
.لأنّه لا توجد ذرّة منه عليها

84
00:06:43,520 --> 00:06:46,340
...لكن أكثر من يُذهل

85
00:06:46,340 --> 00:06:48,520
!هو كم طبخها بعناية

86
00:06:48,520 --> 00:06:51,290
.لونها بنّيّ فاتح، كما لو أنّها طُبخت ببطء

87
00:06:51,290 --> 00:06:54,950
.وليس ذلك فحسب، بل وتتداعى أينما طعنتها بعيدان طعامي

88
00:06:54,950 --> 00:06:56,180
!إنّها مطبوخة طبخًا منتظمًا جدًّا

89
00:06:56,180 --> 00:06:59,600
.منتظم؟ هذا مستحيل

90
00:07:01,230 --> 00:07:02,780
مستحيل؟

91
00:07:02,780 --> 00:07:08,150
.التّحمير غير المتساوي يعدّ نوعيّة مميّزة من شوي أيّ شيء

92
00:07:08,150 --> 00:07:12,040
،وينبغي بتلويح السّمك حول ذلك اللّهب أن يُشتّته

93
00:07:12,040 --> 00:07:14,140
.ما سيجعل التّحمير غير متساوٍ أكثر

94
00:07:14,580 --> 00:07:16,720
فأيّ مهارة استخدم؟

95
00:07:18,260 --> 00:07:22,050
.الأمر لا يتعلّق بمهارتي مع النّار يا ليو ماوشين

96
00:07:23,020 --> 00:07:25,830
.لننتقل إلى الطّبق الرّئيسيّ

97
00:07:27,630 --> 00:07:31,600
إذًا يا شيلو؟ أيّ الطّبقين أفضل؟

98
00:07:31,600 --> 00:07:36,300
أيّها الغبيّ! لا يمكنني أن أتّخذ هذا
.القرار إلى أن أتناول طبق أركان الثّانيّ

99
00:07:36,300 --> 00:07:39,000
الكفّة لصالح من حاليًّا إذًا؟

100
00:07:40,520 --> 00:07:44,460
كيف يقارن طبق أركان-ساما مع طبقَيّ ماوشين؟

101
00:07:44,460 --> 00:07:45,670
!لا تكوني سخيفة

102
00:07:45,670 --> 00:07:49,760
لقد طبخ أفضل طبّاخ خارق في
.البلاد طبقين مذهلين لي

103
00:07:49,760 --> 00:07:52,220
.ولا يمكن مقارنتهما مع طبق واحد

104
00:07:52,220 --> 00:07:54,200
...هذا يمنح الأفضليّة لماو

105
00:07:57,320 --> 00:08:00,070
.آسف. دعوني أفكّر في الأمر

106
00:08:00,070 --> 00:08:01,330
.شيلو

107
00:08:03,170 --> 00:08:07,220
.فكّر في لحم الخنزير المتفجّر المطبوخ مرّتين الخاصّ بماو

108
00:08:07,690 --> 00:08:12,560
وقوام الخضراوات المقرمشة
.المطبوخة بتلك المقلاة المحمرّة سخونةً

109
00:08:12,560 --> 00:08:17,890
لحم الخنزير الغنيّ الّذي تشرّب بالدّهون
.بالإضافة إلى الصّلصة الحلوة قليلًا والحارّة

110
00:08:18,290 --> 00:08:21,160
.ثمّ لدينا صغير الخنزير المشويّ

111
00:08:21,160 --> 00:08:25,590
كانت نكهة دهن لحم البقر وصغير
.الخنزير المحمّر لا يضاهيها شيئًا

112
00:08:25,590 --> 00:08:28,960
لا ينبغي أن يتواجد طبق يقارن مع هذين الطّبقين العظيمين

113
00:08:28,960 --> 00:08:31,410
.اللّذين طُبخا بنارين عالية وهادئة

114
00:08:31,860 --> 00:08:35,730
لكنّ طبق ذلك النّذل الملتهب شمل تلويح السّمك

115
00:08:35,730 --> 00:08:39,330
.داخل النّار بجنون

116
00:08:39,330 --> 00:08:42,670
.تغلغلت الصّلصة داخل السّمك، وكان السّمك عينه زكيًّا

117
00:08:42,670 --> 00:08:47,050
—لقد طُبخ بعناية وبانتظام. لذا

118
00:08:47,050 --> 00:08:50,280
...ماذا؟ لا، مهلًا. هذا ليس

119
00:08:50,280 --> 00:08:51,800
!هل يمكن؟

120
00:08:52,270 --> 00:08:54,310
إنّها على نفس المستوى، صحيح؟

121
00:08:56,260 --> 00:08:59,720
.طبقا ماوشين وطبقُ أركان-ساما

122
00:08:59,720 --> 00:09:02,360
من المنطقيّ أن تظنّ أنّها متساوية. أليس كذلك يا شيلو؟

123
00:09:02,360 --> 00:09:03,540
!سحقًا

124
00:09:03,540 --> 00:09:05,750
!هذا صحيح! إنّها متساوية

125
00:09:06,730 --> 00:09:08,510
.أنا آسف يا ماو

126
00:09:08,510 --> 00:09:12,190
.لكن كطبّاخ، لا أستطيع تكذيب لساني

127
00:09:12,660 --> 00:09:15,560
،عندما يتعلّق الأمر بالحرارة والنّكهة

128
00:09:15,560 --> 00:09:19,700
!لا يمكن لطبقيك أن يقارنا مع طبق أركان على حدّة

129
00:09:21,160 --> 00:09:25,820
لماذا؟ لمَ عساك تحكم لصالح العالم السّفليّ؟

130
00:09:25,820 --> 00:09:29,130
!استخدم عقلك يا شيرو! هذا أصعب بالنّسبة لي

131
00:09:29,130 --> 00:09:30,850
...لكن

132
00:09:32,760 --> 00:09:34,590
.حان الوقت لطبقه الثّانيّ

133
00:09:34,590 --> 00:09:38,450
ماذا سيفعل ذاك النّذل الملتهب هذه المرّة؟

134
00:09:39,990 --> 00:09:43,970
.سيكون طبقي الثّاني عبارة عن سمك مقليّ ومغليّ

135
00:09:44,230 --> 00:09:45,290
سمك مغليّ؟

136
00:09:45,290 --> 00:09:48,440
لكنّه لا يملك قدرًا. فكيف له أن يغلي السّمك؟

137
00:09:50,740 --> 00:09:51,950
ماذا؟

138
00:09:51,950 --> 00:09:55,580
!نار أركان تجعل سطح نهر يانغتسي يغلي

139
00:09:55,580 --> 00:09:57,910
!لا ينبغي بذلك أن يكون ممكنًا

140
00:09:57,910 --> 00:10:02,740
.لا، دائمًا ما يفعل رأس النّمر أركان ما يقول أنّه سيفعله

141
00:10:03,050 --> 00:10:08,110
.قادة العالم السّفليّ أقوى بكثير ممّا تخيّلنا

142
00:10:08,110 --> 00:10:10,580
،بما أنّ طبقَيّ ماو تساوي طبقه الوحيد

143
00:10:10,580 --> 00:10:12,580
...إن أعدّ طبقًا ثانيًا

144
00:10:12,580 --> 00:10:14,250
...سجلّ لا هزيمة ماو

145
00:10:15,610 --> 00:10:20,380
ولا حتّى ماو يستطيع هزيمة سجلّ
.اللّاهزيمة الخاصّ بنجوم النّمر الخمسة

146
00:10:26,100 --> 00:10:27,760
.بدأ المطر يهطل بغزارة أكثر فجأةً

147
00:10:27,760 --> 00:10:29,260
!انظروا إلى هناك

148
00:10:30,370 --> 00:10:33,810
.إنّه تخمد جدار أركان النّاريّ

149
00:10:36,530 --> 00:10:42,350
حتّى الطبّاخ الملتهب أركان لا يستطيع استخدام
.مهاراته مع النّار في هذا المطر الهاطل

150
00:10:47,270 --> 00:10:49,040
.إنّه تعادل

151
00:10:49,040 --> 00:10:51,640
...بالفعل. لكن

152
00:10:52,610 --> 00:10:55,630
.أنت ولدٌ محظوظ للغاية يا ماوشين

153
00:10:55,630 --> 00:10:57,760
.أنت مخطئة يا ليك

154
00:10:58,540 --> 00:11:03,850
.فهمت أخيرًا ما يكبحك يا ليو ماوشين

155
00:11:03,850 --> 00:11:06,220
ماذا تقصد؟

156
00:11:06,220 --> 00:11:08,520
،قال منسيوس ذات مرّة

157
00:11:08,520 --> 00:11:14,010
‘‘.من يتّبع السّماوات يعش، ومن يعصيها يمت’’

158
00:11:15,190 --> 00:11:16,690
.ليو ماوشين

159
00:11:16,690 --> 00:11:19,600
.أنت محبوب من السّماوات

160
00:11:21,510 --> 00:11:26,240
ولهذا خسر الطبّاخ المتفوّق شو آن

161
00:11:26,240 --> 00:11:31,160
.مسابقتين حدّدتا مصيره

162
00:11:32,730 --> 00:11:35,670
.لا أحد يستطيع عصيان أمر السّماوات

163
00:11:36,920 --> 00:11:40,690
.ما زالت السّماوات تفضّلك الآن

164
00:11:42,490 --> 00:11:44,100
.لنغادر الآن

165
00:11:44,510 --> 00:11:48,010
.لكنّ المرّة القادمة ستكون مختلفة يا ليو ماوشين

166
00:11:48,010 --> 00:11:51,520
.عليك أن تشحذ مهاراتك حتّى حين

167
00:12:06,240 --> 00:12:11,500
كان أركان أحد نجوم النّمر الخمسة
.من العالم السّفليّ طبّاخًا مذهلًا

168
00:12:12,140 --> 00:12:13,390
.أريد هزيمته

169
00:12:13,390 --> 00:12:18,170
!ومن أجل ذلك يا أركان، سوف أكشف عن أسرارك

170
00:12:21,890 --> 00:12:24,340
،تمكنّا من حماية الأواني الأسطوريّة بنجاح

171
00:12:24,340 --> 00:12:27,550
.لكنّ ماو غير المهزوم كاد يتكبّد أولى هزائمه

172
00:12:27,550 --> 00:12:29,990
بدا ذلك المدعو أركان مختلفًا تمامًا

173
00:12:29,990 --> 00:12:32,230
.عن سائر طبّاخي العالم السّفليّ الّذين واجهناهم حتّى الآن

174
00:12:32,230 --> 00:12:36,690
.أجل، فليس ماهرًا فحسب، بل ويتمتّع بسلوك جليل

175
00:12:37,080 --> 00:12:39,670
.عرف متى ينسحب أيضًا

176
00:12:39,670 --> 00:12:42,640
.من الخسارة أنّه عدوّنا

177
00:12:42,970 --> 00:12:47,030
،إنّه أحد نجوم النّمر الخمسة الحقيقيّة
.وأحد أقوى الطبّاخين في العالم السّفليّ

178
00:12:48,780 --> 00:12:53,080
.صحيحٌ أنّني لا أستطيع منافسته بمستواي الحاليّ

179
00:12:53,610 --> 00:12:57,540
.لكنّي سأتدرّب بعشرة—كلّا، بعشرين ضعف

180
00:12:58,250 --> 00:13:00,240
!سأفوز في المرّة القادمة

181
00:13:15,930 --> 00:13:18,700
.تساهل معك رأس النّمر أركان كثيرًا

182
00:13:19,770 --> 00:13:24,580
.نقطة ضعفه هو كبرياؤه الّذي لا يتزعزع

183
00:13:24,580 --> 00:13:25,900
.هذا الصّوت

184
00:13:25,900 --> 00:13:29,370
.لا أصدّق أنّه ترك خلفه الأواني الّتي كانت أمامه

185
00:13:35,070 --> 00:13:37,030
!لا. الدّقّيّ المقدّس

186
00:13:37,640 --> 00:13:38,500
!من هناك؟

187
00:13:40,500 --> 00:13:42,870
!شيان عشرة أقادم من الأزرق

188
00:13:42,870 --> 00:13:46,370
.كنتُ متسائلًا أين ذهبت بعد اختفائك في شانغهاي

189
00:13:46,370 --> 00:13:48,470
.فشلت في تعلّم درسك وأظهرت نفسك ثانيةً

190
00:13:49,850 --> 00:13:53,680
ليو ماوشين، محبوب من السّماوات؟

191
00:13:53,680 --> 00:13:57,450
.إذًا سأغيّر إرادة السّماوات بنفسي

192
00:13:59,410 --> 00:14:01,980
أما زلت لا تفهمين أيّتها الثّعلبة؟

193
00:14:01,980 --> 00:14:05,430
.لا فائدة مهما تحدّيتنا بذكائك الضّحل

194
00:14:05,430 --> 00:14:07,360
!أعيدي الآنية حالًا

195
00:14:13,780 --> 00:14:15,520
من أنت؟

196
00:14:17,560 --> 00:14:20,300
.أنا لوك، النّمر متعدّد الألوان

197
00:14:20,300 --> 00:14:24,840
أهؤلاء هم طبّاخو غوانغدونغ
الّذين هزموا شو آن في شانغهاي؟

198
00:14:24,840 --> 00:14:26,570
.أجل

199
00:14:27,820 --> 00:14:29,930
!تبًّا! احموا الخرائط

200
00:14:33,640 --> 00:14:35,000
!ماو

201
00:14:38,470 --> 00:14:41,160
.أعطانا المعلّم لو هذه الخرائط القيّمة

202
00:14:41,160 --> 00:14:43,480
.لن ندعك تفعلين ما يحلو لك

203
00:14:43,480 --> 00:14:46,360
!وما الغاية من المقاومة أيّها الضّعيف؟

204
00:14:46,360 --> 00:14:48,900
.سلّمني الخرائط يا ليو ماوشين

205
00:14:50,700 --> 00:14:51,620
!ماو

206
00:14:55,280 --> 00:14:56,670
!ليون

207
00:14:56,670 --> 00:14:57,620
!الخرائط

208
00:15:05,360 --> 00:15:06,560
!إنّها لي

209
00:15:10,970 --> 00:15:12,050
!ليون

210
00:15:16,840 --> 00:15:18,930
!شيلو، ليون

211
00:15:20,850 --> 00:15:22,270
.بقي ثلاثة

212
00:15:22,270 --> 00:15:23,900
لماذا يا شيان؟

213
00:15:23,900 --> 00:15:26,230
!كيف لك أن تكوني بهذه القسوة؟

214
00:15:26,230 --> 00:15:29,310
قبل ألفَيّ سنة، طارد غاوزو شيانغ يو ودمّره

215
00:15:29,310 --> 00:15:33,260
.وهو الّذي يفترض أنّه أبرم السّلام معه، ثمّ أسّس سلالة هان

216
00:15:33,260 --> 00:15:36,180
.مع ذلك، لا تدعوه الأجيال المستقبليّة بالجبان

217
00:15:36,180 --> 00:15:38,770
،إنّ السّماوات تفضّل أولئك الّذين ينتهزون الفرص

218
00:15:38,770 --> 00:15:42,920
.الّذين لا تقيّدهم مشاعرهم ولا يتزحزحون عن غايتهم

219
00:15:42,920 --> 00:15:46,560
سأنتزع منك الأواني والخرائط

220
00:15:46,560 --> 00:15:49,300
.وحتّى تفضيل السّماوات

221
00:15:50,290 --> 00:15:52,090
!ستدفعين ثمن هذا يا شيان

222
00:15:55,520 --> 00:15:56,220
ماذا؟

223
00:15:56,220 --> 00:15:57,340
.تراجع يا ماو

224
00:15:57,340 --> 00:15:58,460
!ماذا؟

225
00:16:00,520 --> 00:16:03,440
!لن تأخذي أيّ شيء

226
00:16:04,610 --> 00:16:08,050
.ماو! تشبّث بالأواني وابق هناك

227
00:16:08,690 --> 00:16:13,020
!لن أدعكما أيّها الحثالة تمسّان ماو بضرّ

228
00:16:13,480 --> 00:16:18,370
.إنّه بصيص أمل عالم الطّبخ الأخير

229
00:16:18,840 --> 00:16:21,340
...شيلو، ليون

230
00:16:21,790 --> 00:16:23,840
.هذه فرصتك الوحيدة للذّهاب يا شيلو

231
00:16:23,840 --> 00:16:26,230
.يمكنني تسوية هذا بنفسي

232
00:16:26,230 --> 00:16:30,760
أيّها الغبيّ، هل تظنّ أنّني سأدعك تموت ببطولة لوحدك؟

233
00:16:31,670 --> 00:16:34,220
.أنت غبيّ بحقّ

234
00:16:34,220 --> 00:16:36,260
!وأنت أيضًا

235
00:16:36,260 --> 00:16:38,430
!تحرّكوا الآن

236
00:16:39,170 --> 00:16:40,890
!ماذا تفعلان؟

237
00:16:44,520 --> 00:16:46,430
!لقد قطع السّلاسل

238
00:16:46,430 --> 00:16:47,940
!القاربين يتباعدان

239
00:16:47,940 --> 00:16:50,480
!لنسرق الخرائط والأواني المتبقّية

240
00:16:50,960 --> 00:16:52,400
—مفهوم

241
00:16:55,100 --> 00:16:57,330
.ظلّا على الأرض أيّها الوغدان

242
00:16:57,870 --> 00:16:59,200
!أنا قادم

243
00:16:59,200 --> 00:17:01,830
!أخبرتك أن تظلّ مكانك

244
00:17:02,740 --> 00:17:06,500
!ابلغ البرّ واتّجه صوب الآنية التّالية

245
00:17:06,960 --> 00:17:10,210
!ليس هكذا يا شيلو وليون

246
00:17:10,210 --> 00:17:14,410
.لا تقلق يا ماو. لدينا خريطتان

247
00:17:15,400 --> 00:17:19,670
.إن انفصلنا، يمكننا أن نجمع الأواني أسرع

248
00:17:19,670 --> 00:17:21,850
...ولكن يا شيلو

249
00:17:23,310 --> 00:17:29,860
ماو، دعنا نقم مسابقة شوماي
.أخرى في مطبخ مطعم ربيع يانغ

250
00:17:29,860 --> 00:17:33,780
.ابتسم يا ماو. أنت أفضل وأنت مبتسم

251
00:17:34,190 --> 00:17:37,290
...شيلو، ليون

252
00:17:38,240 --> 00:17:41,280
!تعلمان ما يقع على عاتقكما يا شيرو وميلي

253
00:17:41,280 --> 00:17:43,700
!عليكما مساندة ماو

254
00:17:43,700 --> 00:17:45,310
!شيلو

255
00:17:45,310 --> 00:17:46,210
!ليون

256
00:17:46,990 --> 00:17:47,910
!دعني

257
00:17:47,910 --> 00:17:49,690
.لا أظنّ ذلك

258
00:17:49,690 --> 00:17:52,650
.هذا هو قدركما

259
00:17:54,580 --> 00:17:58,950
!شيلو، ليون

260
00:18:09,400 --> 00:18:12,690
ماو، كم بقي لنصل إلى برج الأقحوان؟

261
00:18:12,690 --> 00:18:14,450
.كدنا نصل

262
00:18:14,450 --> 00:18:19,360
.لكنّك كنت تقول هذا منذ ثلاثة أيّام يا ماو

263
00:18:20,710 --> 00:18:23,260
...موطنك، برج الأقحوان

264
00:18:23,260 --> 00:18:26,330
هو أعظم مطعم حكوميّ في سيتشوان، صحيح؟

265
00:18:26,330 --> 00:18:29,890
كيف يتدبّرون أمرهم من دونك؟

266
00:18:34,080 --> 00:18:36,380
.المتجر مغلق حاليًّا

267
00:18:36,830 --> 00:18:41,510
.يفترض بكالين-نيتشان أن تعتني بالمتجر

268
00:18:46,390 --> 00:18:49,770
.هكذا تُدوّر مروحيّة خيزران، انظر

269
00:18:55,090 --> 00:18:57,780
.أنت سيّئ يا ماو

270
00:18:57,780 --> 00:19:00,320
!تجرّأت وقلتها يا شيرو

271
00:19:02,330 --> 00:19:03,810
.أيّها الشّقيّ الصّغير

272
00:19:03,810 --> 00:19:06,160
!هذا مؤلم يا ماو

273
00:19:07,610 --> 00:19:12,070
لمَ يتكلّف ماو كثيرًا بابتسامته؟

274
00:19:12,070 --> 00:19:15,630
.مضى شهر فقط مذّاك الحين

275
00:19:24,770 --> 00:19:26,320
.يا ماو

276
00:19:30,260 --> 00:19:32,960
!كفّ عن الشّرود يا ماو

277
00:19:32,960 --> 00:19:36,480
!لا ينبغي للطّباخ الخارق أن يحرق طبقه

278
00:19:38,830 --> 00:19:40,700
.شيرو، عشاؤك جاهز

279
00:19:40,700 --> 00:19:43,910
!هل ستجعلني أتناول هذا؟ أنت سيّئ بحقّ

280
00:19:45,520 --> 00:19:50,080
.بربّك يا ماو. لا أستطيع أكل هذا

281
00:19:47,210 --> 00:19:51,240
...يحاول ماو جاهدًا أن يبدو مبتهجًا، ولكن

282
00:19:50,080 --> 00:19:51,240
.يكفي

283
00:19:56,380 --> 00:19:59,820
.أريد أن أفعل كلّ ما أستطيع لمساعدة ماو

284
00:19:59,820 --> 00:20:03,540
.سأجني بعضًا من خضراوات الجبل النّادرة والطّيبة

285
00:20:05,080 --> 00:20:08,810
...إنّه فطر غريب. أليس

286
00:20:10,190 --> 00:20:12,140
.بئسًا

287
00:20:12,140 --> 00:20:15,320
.أنا واثقة أنّ ماو سيسعد إن أحضرت له هذا

288
00:20:15,320 --> 00:20:18,110
...أكاد أصل

289
00:20:23,690 --> 00:20:25,510
تمّ إنقاذي؟

290
00:20:29,210 --> 00:20:31,250
.كان ذلك وشيكًا

291
00:20:32,420 --> 00:20:34,160
من أنت؟

292
00:20:35,250 --> 00:20:38,720
.شكرًا لك. أنا خرقاء جدًّا

293
00:20:39,800 --> 00:20:44,300
.بالفعل. لا عجب أن تسقطي من ذلك الوادي بما أنّك خرقاء

294
00:20:45,760 --> 00:20:47,180
—اسمع

295
00:20:47,180 --> 00:20:49,790
.عجبًا، لقد تأذّيت

296
00:20:50,520 --> 00:20:52,710
.يا لك من فتاة ميؤوسة

297
00:20:52,710 --> 00:20:53,770
،لم تتأذّي فحسب

298
00:20:53,770 --> 00:20:55,980
.بل وشعرك فوضويّ وملابسك رثّة

299
00:20:55,980 --> 00:20:58,110
.لا تقربين بشيء لحسن المظهر

300
00:20:59,440 --> 00:21:03,240
!ما أدراك أنت؟! لديّ أسبابي

301
00:21:03,240 --> 00:21:06,650
.مررت برحلة خطيرة للوصول لهذا الحدّ

302
00:21:08,050 --> 00:21:11,870
.أقصد أنّك تهدرين جمالك الّذي لا يضاهيه جمال

303
00:21:13,910 --> 00:21:14,950
ماذا؟

304
00:21:16,240 --> 00:21:19,210
!لا تغضني

305
00:21:20,520 --> 00:21:23,400
إذًا، ماذا تصنعين هنا في هذه الجبال؟

306
00:21:23,400 --> 00:21:24,420
ماذا؟

307
00:21:24,420 --> 00:21:27,220
.كنتُ أحاول قطف ذلك الفطر

308
00:21:28,260 --> 00:21:31,450
.وإن كنتِ قد أدركته، لكنتِ ميّتة الآن

309
00:21:31,450 --> 00:21:32,700
لماذا؟

310
00:21:32,700 --> 00:21:36,680
.يدعى ذلك الفطر بقبّعات الموت الشّرق أسويّة البنّيّة السّامّة

311
00:21:36,680 --> 00:21:40,110
.ضعي إحداها على فمك وستلحقين بأجلك في دقائق

312
00:21:40,110 --> 00:21:44,070
ماذا؟ من أنت؟

313
00:21:44,070 --> 00:21:49,680
.أنا تزوتشي، رئيس طبّاخي برج الأقحوان

314
00:21:49,680 --> 00:21:51,530
.لا تنسي

315
00:21:51,530 --> 00:21:55,550
رئيس طبّاخي برج الأقحوان؟

316
00:23:29,920 --> 00:24:00,770
في الحلقة القادمة

317
00:23:57,270 --> 00:23:59,200
".مصيبة في برج الأقحوان"