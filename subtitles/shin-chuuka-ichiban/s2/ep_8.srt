1
00:00:04,930 --> 00:00:07,870
!يا لها من صحيفة ساخنة وغير معتادة

2
00:00:07,870 --> 00:00:09,900
!وهو جاهز للانطلاق

3
00:00:10,390 --> 00:00:12,580
...في نفس الأثناء، ماو

4
00:00:13,640 --> 00:00:16,160
يطبخ بقدر واحد؟

5
00:00:16,640 --> 00:00:18,720
.سيبدأ التذوّق بعد ساعتين

6
00:00:18,720 --> 00:00:22,620
.وسيطبخ الفائز بهذه المسابقة من أجل الأمير

7
00:00:24,950 --> 00:00:26,710
!والآن... ابدآ

8
00:02:01,970 --> 00:02:03,740
.تفقدّوا هذا

9
00:02:04,710 --> 00:02:07,030
شاهدوا وعيدان طعامي ترقص مع هذه الصّحيفة السّاخنة

10
00:02:07,030 --> 00:02:09,940
.وأنا أستعرض مهارات قبيلتي الأعظم في الطّبخ

11
00:02:09,940 --> 00:02:11,760
.أوّلًا، الكرّاث

12
00:02:11,760 --> 00:02:14,520
ثمّ نضيف لحم البطّ المتبّل بصلصة الصّويا والكحول

13
00:02:14,810 --> 00:02:20,110
.وصلصة الزّنجبيل والسّكر وزيت السّمسم

14
00:02:23,440 --> 00:02:26,830
.سأستخدم كلّ شبر من هذه الصّحيفة السّاخنة

15
00:02:26,830 --> 00:02:28,980
قيمة عيدان الطّعام الحقيقيّة هذه

16
00:02:28,980 --> 00:02:31,800
!هي قدرتها على قلب المكوّنات دونما توقّف

17
00:02:32,290 --> 00:02:37,280
رائحة حطب الصّنوبر المعطّرة الّتي اخترته بعناية

18
00:02:37,280 --> 00:02:41,220
تعبر من خلال هذه الصّحيفة
.السّاخنة مانحةً اللّحم رائحة سامية

19
00:02:42,720 --> 00:02:46,210
هذه الوصفة المنغوليّة التّقليديّة
:هي أعظم طبق مشويّ على وجه الأرض

20
00:02:46,210 --> 00:02:48,220
!الشّواء المنغوليّ

21
00:02:48,750 --> 00:02:52,200
.ما رأيكم؟ بالنّسبة لي، الطّبخ استعراض

22
00:02:52,200 --> 00:02:56,840
!وأفضل ما في استعراض الطّبخ هي رائحته

23
00:02:57,350 --> 00:02:59,490
!واصل يا تزوتشي

24
00:02:59,840 --> 00:03:01,950
!ما رأيك يا ليو ماوشين؟

25
00:03:04,570 --> 00:03:05,410
!ماذا؟

26
00:03:07,310 --> 00:03:10,650
.ما بال ذلك السّلوك؟ لم أحبّذه

27
00:03:10,650 --> 00:03:14,270
وما هذه الرّائحة الحلوة الشّبيهة بالعطر؟

28
00:03:15,410 --> 00:03:18,380
.إنّه مشروب لوزو لاوجاوزجو المشهور في سيتشوان

29
00:03:18,380 --> 00:03:21,840
ما الّذي يخطّط فعله بذلك؟

30
00:03:23,370 --> 00:03:28,270
.ماو، إنّه يكسب قلوب الجمهور ثانيةً

31
00:03:28,660 --> 00:03:30,200
!ماذا ستفعل بشأن ذلك؟

32
00:03:31,640 --> 00:03:34,500
!حسنًا! هذه الكُسبَرة هي اللّمسة الأخيرة

33
00:03:35,110 --> 00:03:37,560
!والآن سيصبح طبقي عطرًا أكثر

34
00:03:37,560 --> 00:03:39,110
!أحسنت يا تزوتشي

35
00:03:39,110 --> 00:03:40,090
ما رأيك؟

36
00:03:41,880 --> 00:03:45,070
!لم أفهم. ما الّذي يفعله؟

37
00:03:45,570 --> 00:03:47,660
!يا ليو ماوشين

38
00:03:47,660 --> 00:03:49,860
ماذا تفعل برأيك؟

39
00:03:49,860 --> 00:03:51,970
.أنا أطبخ بكلّ جهدي هنا

40
00:03:51,970 --> 00:03:55,960
.أنا آخذ هذه المسابقة محمل الجدّ

41
00:04:00,970 --> 00:04:04,880
.الجميع يخشون ما لا علم لهم به

42
00:04:05,340 --> 00:04:08,660
.لهذا تزوتشي أخاف وشوّش ماو

43
00:04:08,660 --> 00:04:11,390
...لكن الآن وقد كُشف عن هويّتك الحقيقيّة

44
00:04:11,390 --> 00:04:15,160
.أحد نجوم النّمر الخمسة تزوتشي، حان دورك الآن لتخشاه

45
00:04:16,650 --> 00:04:18,800
.حسنًا. انتهيت

46
00:04:19,780 --> 00:04:21,590
.النّيران تخمد

47
00:04:22,340 --> 00:04:23,700
.أرى شيئًا

48
00:04:25,330 --> 00:04:26,470
ما ذلك؟

49
00:04:26,470 --> 00:04:28,030
بيضة؟

50
00:04:28,030 --> 00:04:30,740
...تزوتشي، هل تودّ أن تتذوّق

51
00:04:31,330 --> 00:04:32,220
ماذا؟

52
00:04:33,080 --> 00:04:36,250
النّكهة الخالدة الكامنة داخل هذه البيضة؟

53
00:04:36,250 --> 00:04:37,920
ماذا؟

54
00:04:37,920 --> 00:04:40,550
نكهة خالدة؟

55
00:04:41,910 --> 00:04:43,670
!إنّها ضخمة

56
00:04:43,670 --> 00:04:46,560
أيّ بيضة هذه؟

57
00:04:47,090 --> 00:04:48,760
.ستعرف فور أن تتذوّقها

58
00:04:57,020 --> 00:04:59,000
...يوجد داخل البيضة

59
00:04:59,000 --> 00:05:00,520
بطّة مبخّرة؟

60
00:05:03,180 --> 00:05:06,320
.حان الوقت أخيرًا. عليّ تذوّق هذه الأطباق

61
00:05:06,320 --> 00:05:07,800
...بطّة مبخّرة

62
00:05:07,800 --> 00:05:11,290
.تبدو بيضاء وبسيطة

63
00:05:12,660 --> 00:05:15,280
.سحقًا! لديّ حاسّة تذوّق فظيعة

64
00:05:15,280 --> 00:05:19,220
!يستحيل أن أتذوّق النّكهات الرّفيعة

65
00:05:23,460 --> 00:05:25,770
!ماذا؟ لا

66
00:05:25,770 --> 00:05:27,530
!هذه ليست بطّة

67
00:05:27,530 --> 00:05:28,950
ماذا؟

68
00:05:28,950 --> 00:05:32,320
.بل هي بطّة خارق تجاوزت مفهوم البطّة العاديّة

69
00:05:32,320 --> 00:05:37,550
ضُخّمت النّكهة القويّة مئات المرّات داخل هذه البطّة

70
00:05:37,550 --> 00:05:38,900
...وأعيد تجسيدها كـ

71
00:05:41,220 --> 00:05:42,830
!عنقاء

72
00:05:42,830 --> 00:05:47,860
!إنّها نكهة خالدة بحقّ تعيش أبد الدّهر في ذاكرة لساني

73
00:05:48,490 --> 00:05:53,480
!زلابيّة العنقاء الخاصّة لليو ماوشين اكتملت

74
00:05:55,330 --> 00:05:58,620
!كيف أنتجت هذه النّكهة؟

75
00:05:58,620 --> 00:06:02,000
.فبالكاد فعلت أيّ شيء يدلّ على أنّك تطبخ

76
00:06:02,650 --> 00:06:05,000
.انظر بتمعّن إلى صدفة البيضة

77
00:06:10,990 --> 00:06:12,890
أهذا ملح؟

78
00:06:12,890 --> 00:06:19,200
غلّفتُ البطّة المتبّلة بكاملها داخل الملح
.المصلّب باستخدام بياض البيض لتشكيل البيضة

79
00:06:19,710 --> 00:06:22,570
،نصبتُ عشًّا مصنوعًا من شرائط القلقاس الهشّة

80
00:06:22,570 --> 00:06:25,840
،ووضعت البيضة في قدر مليء باللوزو لاوجاو

81
00:06:26,390 --> 00:06:28,240
،بخّرت الكحول

82
00:06:28,240 --> 00:06:31,110
.وسخّنت البيضة بينما أضيف النّكهة

83
00:06:32,300 --> 00:06:35,700
.لم يكن عليّ سوى أن أنتظر الكحول ليتبخّر

84
00:06:36,910 --> 00:06:39,030
.ليس وكأنّني لم أكن أطبخ

85
00:06:39,030 --> 00:06:41,030
.الانتظار جزء من الطّبخ أيضًا

86
00:06:42,270 --> 00:06:43,670
...هذا الشّقيّ

87
00:06:44,130 --> 00:06:47,690
.شغل الملح دور الباخرة لطبخ البيضة بشكل متساوٍ

88
00:06:48,700 --> 00:06:51,380
،بحيث يمنع تسرّب نكهة البطّة

89
00:06:51,380 --> 00:06:54,010
.بينما يكثّفها ويضخّمها بدلًا من ذلك

90
00:06:54,010 --> 00:06:56,850
،هذا يضيف رائحة الملح المشويّ إلى الملح فحسب

91
00:06:56,850 --> 00:06:59,940
.لكنّه يستخرج حلاوة البطّة كذلك

92
00:06:59,940 --> 00:07:01,720
.إنّها الباخرة المطلقة

93
00:07:03,100 --> 00:07:05,980
بالإضافة إلى ذلك، يعمل الملح المشويّ المعطّر المتبقّي

94
00:07:05,980 --> 00:07:09,190
.كتوابل مثاليّة قبيل أن تأخذ قضمة من البطّة

95
00:07:10,650 --> 00:07:13,700
!نكهات وتحضر بسيط وقويّ

96
00:07:13,700 --> 00:07:16,450
!نكهة رقيقة وكرامة

97
00:07:16,450 --> 00:07:23,080
!من الفكرة وحتّى التّقديم، إنّه طبق جدير لتقديمه إلى الأمير

98
00:07:23,080 --> 00:07:26,070
!حسنًا! ماو هو الفائز لا محالة

99
00:07:26,070 --> 00:07:28,510
!أحرز عودةً

100
00:07:28,510 --> 00:07:30,420
.فهمت

101
00:07:31,730 --> 00:07:35,440
.إذًا دعوني أريكم قوّتي

102
00:07:36,250 --> 00:07:40,340
أعتقد أنّك حضّرت الشّواء المنغوليّ، صحيح؟

103
00:07:40,340 --> 00:07:42,650
.أمهلني لحظة

104
00:07:43,400 --> 00:07:45,690
...طبقي

105
00:07:47,110 --> 00:07:48,810
.لم ينته بعد

106
00:07:50,880 --> 00:07:54,530
.حسنًا. حان الوقت

107
00:07:57,530 --> 00:07:59,230
.حفر شيئًا

108
00:07:59,230 --> 00:08:02,780
.إنّه قدر موحل

109
00:08:05,050 --> 00:08:06,850
أهذه صلصة؟

110
00:08:07,360 --> 00:08:10,760
البطّة فخذ جينهوا وخيار البحر المجفّف والحبّار المجفّف

111
00:08:10,760 --> 00:08:13,560
.والرّوبيان المجفّف وبراعم الخيزران وفطر شيتاكي

112
00:08:13,560 --> 00:08:16,550
ختمت أطايب البرّ والبحر داخل هذا القدر

113
00:08:16,550 --> 00:08:20,800
.وغليته ببطء ومهل لإنشاء أفضل حساء فاخر

114
00:08:21,870 --> 00:08:26,460
.رائحته أكثر تعقيدًا وطراوة من اللّحم المشويّ

115
00:08:27,020 --> 00:08:31,100
.طبختُ هذا الحساء من البداية

116
00:08:31,100 --> 00:08:38,300
النّار الّتي استخدمت لتسخين الصّفيحة
.السّاخنة سخّنت أيضًا القدر المدفون

117
00:08:38,300 --> 00:08:42,040
.كما قال ماو، الانتظار جزء من الطّبخ

118
00:08:42,040 --> 00:08:43,550
!مبهر يا تزوتشي

119
00:08:43,550 --> 00:08:45,420
!ذكيّ جدًّا

120
00:08:47,880 --> 00:08:54,840
هذا الشّواء المعبّأ الّذي يجمع بين اللّحم
.المشويّ والحساء هو طبقي المتكامل

121
00:08:55,300 --> 00:08:57,720
.هذا غريب على أيّ حال

122
00:08:58,200 --> 00:09:02,220
.حفر القدر وكأنّه عرف متى سينتهي طبخ الحساء

123
00:09:02,640 --> 00:09:05,860
كيف عرف متى سيكون جاهزًا؟

124
00:09:06,350 --> 00:09:08,210
.هذه قدرته

125
00:09:08,210 --> 00:09:09,270
ماذا؟

126
00:09:09,810 --> 00:09:13,060
لقد خمّن نكهات أطباقي دون أن يتذوّقها

127
00:09:13,390 --> 00:09:16,360
وحدّد نضج الحساء المدفون في القدر

128
00:09:16,360 --> 00:09:18,870
.دون أن يحفر عنه أو يفتحه

129
00:09:18,870 --> 00:09:21,450
.ثمّة حاسّة واحدة تمكّنه من ذلك

130
00:09:21,980 --> 00:09:23,120
.وهي حاسّة الشّمّ

131
00:09:23,600 --> 00:09:26,860
تمكّنه حاسّة شمّه القويّة تحديد جودة المكوّنات

132
00:09:26,860 --> 00:09:31,380
.دون لمسها وكذا تحديدها بدقّة دون تذوّقها

133
00:09:35,360 --> 00:09:37,460
.لاحظت يا ماو

134
00:09:37,460 --> 00:09:42,420
.إذًا لا بدّ أنّك اكتشفت سرّه الآخر أيضًا

135
00:09:42,870 --> 00:09:45,270
.تفضّل أيّها المحافظ

136
00:09:46,830 --> 00:09:51,690
يشكّل هذا المزيج من اللّحم المشويّ
.والحساء ثنائيًّا عطرًا بشكل رائع

137
00:09:53,390 --> 00:09:58,880
.سيكشف عن سرّ تزوتشي الآخر في هذا التذوّق

138
00:10:07,570 --> 00:10:10,080
...هـ-هذه النّكهة

139
00:10:10,370 --> 00:10:12,090
!إذًا أيّها المحافظ؟

140
00:10:12,470 --> 00:10:15,390
مزجت بين أعطر شواء منغوليّ مع حساء معبّأ

141
00:10:15,390 --> 00:10:19,780
!الغنيّ بالنّكهات المشتقّة من المكوّنات الفاخرة

142
00:10:20,950 --> 00:10:25,680
!بحيث أنّ رائحة كلا الطّبقين ممزوجة في طبق أعجوبة واحد

143
00:10:25,680 --> 00:10:28,300
!يستحيل ألّا يكون طعمه جيّدًا

144
00:10:30,500 --> 00:10:32,600
.إنّه مقرف

145
00:10:33,070 --> 00:10:35,030
!ماذا؟

146
00:10:35,360 --> 00:10:38,490
ماذا قلت للتّوّ أيّها الخنزير؟

147
00:10:41,700 --> 00:10:43,450
.لست مؤهّلًا لتكون طبّاخًا

148
00:10:43,450 --> 00:10:44,330
ماذا؟

149
00:10:44,730 --> 00:10:46,610
من تحسبني؟

150
00:10:46,610 --> 00:10:49,820
!لا ينبغي أن تدلي بمثل هذه الملاحظات الصّادمة عرضًا

151
00:10:50,710 --> 00:10:51,800
.تزوتشي

152
00:10:52,730 --> 00:10:55,340
.لدينا نتائج حُكم المحافظ

153
00:10:55,670 --> 00:10:57,540
.انتظر أيّها الطبّاخ التّنّين

154
00:10:57,540 --> 00:11:02,300
.أعلم أنّ هذا العجوز يملك حاسّة تذوّق ضعيفة

155
00:11:02,300 --> 00:11:06,560
فلمَ لا يخبرنا أيّ خطأ وجد في طبقي المثاليّ؟

156
00:11:06,560 --> 00:11:09,220
أم أنّك متواطئ معهم أيضًا؟

157
00:11:09,220 --> 00:11:11,440
.اخرس أيّها القرد

158
00:11:12,400 --> 00:11:15,190
،ربّما أملك حاسّة تذوّق ضعيفة
.لكنّ الأمر واضح حتّى بالنّسبة لي

159
00:11:15,190 --> 00:11:19,710
.الشّواء المنغوليّ المعطّر بامتياز والغنيّ بالنّكهات

160
00:11:19,710 --> 00:11:24,320
.الحساء المعبّأ المنكّه بمكوّنات فاخرة من البرّ والبحر

161
00:11:24,320 --> 00:11:28,290
.كلّها فاخرة ومعدّة بعناية

162
00:11:28,710 --> 00:11:32,920
.لكن عند الجمع بينها، تعطي شعورًا بالنّقص

163
00:11:33,390 --> 00:11:38,890
.يصبح اللّحم المشويّ والمقرمش لزجًا، ممّا يبرز نكهته القويّة

164
00:11:38,890 --> 00:11:42,290
كما أنّ الرّائحة القويّة للّحم
،المشويّ تطغو على نكهات الحساء

165
00:11:42,290 --> 00:11:46,230
.وبرزت فقط رائحة البرّ والأرض القبيحة

166
00:11:46,230 --> 00:11:50,180
.عندما تتذوّقها عبر الشّمّ، يشكّلان ثنائيًّا من الرّوائح مع ذلك

167
00:11:50,180 --> 00:11:55,400
.لكنّ النّكهات القويّة المتناقضة تطغى على بعضها الآخر

168
00:11:56,950 --> 00:11:59,150
!إنّه انعكاس مبدّد للنّكهات

169
00:11:59,610 --> 00:12:01,460
!هذا مستحيل

170
00:12:02,000 --> 00:12:02,920
.تزوتشي

171
00:12:04,290 --> 00:12:05,620
.دعني أسألك شيئًا

172
00:12:05,620 --> 00:12:07,990
،بعد المزج بين اللّحم المشويّ والحساء

173
00:12:07,990 --> 00:12:12,210
.إن قمت بغلي طبقك ثانيةً، لانسجمت النّكهات ثانيةً

174
00:12:12,740 --> 00:12:14,680
فلمَ لم تفعل ذلك؟

175
00:12:15,950 --> 00:12:20,480
.لـ-لأنّي إن فعلت، فسيفقد اللّحم المشويّ رائحته

176
00:12:22,790 --> 00:12:25,860
هذا كلّ شيء. هل انتهينا؟

177
00:12:28,670 --> 00:12:32,760
أيّها المحافظ، هلّا أخبرتنا بحُكمك رجاءً؟

178
00:12:33,240 --> 00:12:38,250
.ليس من الضّروريّ أن أكرّر حُكمي يا في-دونو

179
00:12:39,320 --> 00:12:40,720
.جيّد

180
00:12:41,550 --> 00:12:47,760
الفائز في مسابقة برج الأقحوان في طبق
.البطّ هو الطبّاخ الخارق ليو ماوشين

181
00:12:49,730 --> 00:12:52,700
!أجل! نجحت

182
00:12:52,700 --> 00:12:54,640
!أجل

183
00:12:54,640 --> 00:12:58,040
.والآن سيحظى ماو بشرف الطّبخ من أجل الأمير

184
00:12:59,070 --> 00:13:02,420
!أنت العنقاء يا ماو

185
00:13:04,250 --> 00:13:06,270
!نجحت يا شيرو

186
00:13:06,270 --> 00:13:07,590
!ماو

187
00:13:10,510 --> 00:13:12,520
...مـ-ميلي

188
00:13:18,130 --> 00:13:21,700
...ماو، أنا... أنا

189
00:13:24,760 --> 00:13:26,660
.أنت مسرور لأنّك بخير

190
00:13:28,050 --> 00:13:29,320
ماو؟

191
00:13:32,780 --> 00:13:34,740
...هذه القلادة

192
00:13:35,720 --> 00:13:37,040
.ميلي

193
00:13:38,940 --> 00:13:42,380
.لنزر تمثال بوذا العملاق في ليشان معًا

194
00:13:43,800 --> 00:13:44,770
.حسنًا

195
00:13:45,510 --> 00:13:47,410
!طوبى لك يا ماو

196
00:13:47,410 --> 00:13:49,240
!فاتن النّساء

197
00:13:49,240 --> 00:13:51,340
.فضّت هذه المسابقة

198
00:13:51,340 --> 00:13:53,270
.أراك لاحقًا يا ماو

199
00:14:00,450 --> 00:14:04,150
.ماذا تريد؟ انتهت المسابقة

200
00:14:04,150 --> 00:14:06,610
—لأنّني فوّتُّ تذوّق طبقي في الأخير، أنا

201
00:14:06,610 --> 00:14:07,560
.أنت مخطئ

202
00:14:08,180 --> 00:14:10,570
.ليس لأنّك لم تتذوّقه

203
00:14:11,130 --> 00:14:12,580
.بل لأنّك لم تستطع

204
00:14:14,660 --> 00:14:15,580
.تزوتشي

205
00:14:16,820 --> 00:14:19,290
لا تملك حاسّة تذوّق، أليس كذلك؟

206
00:14:23,530 --> 00:14:25,690
!لا يملك تزوتشي حاسّة تذوّق؟

207
00:14:25,690 --> 00:14:28,450
تقصد أنّه لا يستطيع تذوّق أيّ شيء؟

208
00:14:28,450 --> 00:14:30,680
.هذا هو سرّك

209
00:14:31,160 --> 00:14:36,700
إنّه السّبب الّذي دفعك لكره الطّبخ
.والحصول على حاسّة شمّ استثنائيّة

210
00:14:37,850 --> 00:14:41,050
،على الرّغم من مهارتك كطبّاخ

211
00:14:41,050 --> 00:14:44,190
.فإنّ تركيزك على الشّمّ وفشلك في آخر دقيقة أثبتا ذلك

212
00:14:44,780 --> 00:14:47,710
أليس كذلك يا تزوتشي أحد نجوم النّمر الخمسة؟

213
00:14:48,730 --> 00:14:52,080
.أنا منبهر أيّها الطبّاخ التّنّين لان فيهونغ

214
00:14:52,530 --> 00:14:56,340
هذا صحيح. أنا النّاسك العظيم
.المحلّق عاليًا في السّماء تزوتشي

215
00:14:57,480 --> 00:15:02,960
طبّاخ من العالم السّفليّ من الدّرجة
.الأولى وأحد نجوم النّمر الخمسة تزوتشي

216
00:15:03,260 --> 00:15:04,920
.مستحيل. تزوتشي

217
00:15:05,540 --> 00:15:08,880
لمَ انضممت إلى العالم السّفليّ؟

218
00:15:10,630 --> 00:15:16,170
.عندما كنتُ طفلًا، فقدتُ والدَيّ اللّذين كانا طبّاخين

219
00:15:16,170 --> 00:15:19,070
.كنتُ وحيدًا في هذا العالم

220
00:15:19,070 --> 00:15:23,120
،ذلك اليوم، وأنا أقف وحيدًا وسط تلك السّهول المنغوليّة

221
00:15:23,120 --> 00:15:25,860
.كنتُ منتظرًا الذّئاب لتأكلني

222
00:15:26,740 --> 00:15:30,280
.أبي، أمّي. لا أستطيع فعل هذا

223
00:15:30,280 --> 00:15:34,920
.لا يمكنني أن أعيش وحيدًا هنا

224
00:15:37,950 --> 00:15:40,360
.لا تستعجل بحتفك يا فتى

225
00:15:41,000 --> 00:15:44,210
.سأمنحك القوّة للعيش

226
00:15:44,970 --> 00:15:48,980
،الرّجل الّذي وجدني كان زعيم العالم السّفليّ

227
00:15:48,980 --> 00:15:51,420
.التنّين في السّحب كايو

228
00:15:52,190 --> 00:16:00,370
صدف وأنّي موهوب، لذا صقلتُ مهاراتي تحت
.إشراف كايو وصعدت سلّم العالم السّفليّ بسرعة

229
00:16:00,370 --> 00:16:02,470
.لكن ذات يوم، أصابني المرض

230
00:16:02,470 --> 00:16:06,400
.عانيت من حمّى عالية لعشرة أيّام

231
00:16:07,120 --> 00:16:08,690
...وعندما انقضت

232
00:16:12,720 --> 00:16:14,620
!لساني

233
00:16:14,620 --> 00:16:16,530
!لا أستطيع تذوّق أيّ شيء

234
00:16:17,310 --> 00:16:20,960
.طبّاخ دون حاسّة تذوّق؟ مستحيل

235
00:16:20,960 --> 00:16:24,070
.هذا يعني موتي في العالم السّفليّ

236
00:16:24,070 --> 00:16:28,040
ماذا يفترض أن أفعل؟! ماذا أستطيع
!أن أفعل من الآن فصاعدًا؟

237
00:16:29,510 --> 00:16:34,250
.حينها استيقظت فيّ دماء أهلي الفروسيّة

238
00:16:34,250 --> 00:16:36,150
القدرة على تحديد كلّ من الأعداء البعيدين

239
00:16:36,150 --> 00:16:39,470
.والتربّص في الرّياح الّتي تهبّ عبر السّهول

240
00:16:39,470 --> 00:16:42,810
.الحاسّة الّتي صقلتها قبيلتي

241
00:16:42,810 --> 00:16:44,840
.حاسّة شمّي

242
00:16:45,390 --> 00:16:48,780
بدلًا من حاسّة ذوقي، صقلتُ حاسّة شمّي

243
00:16:49,290 --> 00:16:51,570
.وصعدت في درجات العالم السّفليّ

244
00:16:52,820 --> 00:16:55,030
ركعت على يديّ وركبتيّ كالكلب

245
00:16:55,030 --> 00:16:58,070
.وتدرّبت على حاسّة شمّي وكأنّ حياتي تعتمد على ذلك

246
00:16:58,070 --> 00:17:04,240
.وفي الأخير، تمّت ترقيتي إلى أحد نجوم النّمر الخمسة

247
00:17:07,470 --> 00:17:11,060
.لكنّي دفعتُ ثمن ذلك غاليًا

248
00:17:11,900 --> 00:17:14,560
ابتهج النّاس بالاستعراض المبهرج الّذي أقوم به

249
00:17:14,560 --> 00:17:16,340
.باستخدام عيدان طعامي الطّويلة والرّوائح

250
00:17:16,340 --> 00:17:20,350
.وأكلوا طعامي بسعادة

251
00:17:20,870 --> 00:17:25,720
.لكنّي لم أعرف فرحة نكهاتي

252
00:17:25,720 --> 00:17:27,810
.فرحة أكل طعامي

253
00:17:29,970 --> 00:17:33,220
.وفقدتُ تدريجيًّا حبّي للطّبخ

254
00:17:34,030 --> 00:17:36,950
.وكلّ ما بقي الآن هي الكراهية

255
00:17:38,140 --> 00:17:41,160
.ماو، أنت محظوظ

256
00:17:41,870 --> 00:17:46,690
.كلّما طبخت أكثر، زاد حبّك للطّبخ

257
00:17:48,670 --> 00:17:51,240
.أعي الآن أنّك عانيت الأمرّين

258
00:17:51,240 --> 00:17:53,380
،لكن مهما كان السّبب

259
00:17:54,110 --> 00:17:57,800
.لا أستطيع مسامحتك على تسميم ميلي

260
00:18:03,050 --> 00:18:06,640
.كان ذلك خطأً في الحساب

261
00:18:07,390 --> 00:18:12,400
.صحيح. كانت خططي بدأت تتداعى منذ تلك اللّحظة

262
00:18:12,740 --> 00:18:17,400
.خطّتي لكسر روحك يا ماو

263
00:18:17,910 --> 00:18:20,490
.لم أتوقّع من ميلي أن تفعل ذلك

264
00:18:22,080 --> 00:18:27,100
.أطلب أن أكون أنا الحكمة على مسابقتهما

265
00:18:28,170 --> 00:18:35,850
أتدري كيف شعرت عندما سمّمت عيدان طعام ميلي؟

266
00:18:39,090 --> 00:18:42,180
.كان حبًّا من أوّل نظرة فعلًا يا ميلي

267
00:18:42,680 --> 00:18:45,820
،منذ لحظة التقيت بك في الجبال

268
00:18:45,820 --> 00:18:48,240
.حين لم أدرك أنّك صديقة ماو

269
00:18:49,750 --> 00:18:50,890
...تزوتشي

270
00:18:52,210 --> 00:18:56,730
.ماو، يا ليتني قابلتك في وقت أبكر

271
00:18:57,370 --> 00:19:00,630
.لكن فات الأوان الآن

272
00:19:06,410 --> 00:19:08,640
!أواني طبخه الثّمينة

273
00:19:08,640 --> 00:19:10,560
ماذا تفعل بظنّك يا تزوتشي؟

274
00:19:11,470 --> 00:19:13,520
.ما عدت بحاجة لهذه

275
00:19:17,160 --> 00:19:18,910
تزوتشي، إلى أين العزم؟

276
00:19:19,810 --> 00:19:24,090
.من يدري؟ لا يمكنني العودة لعالم الطّبخ السّفليّ الآن

277
00:19:24,090 --> 00:19:26,970
.سأتّبع الرّياح حيث تأخذني

278
00:19:27,610 --> 00:19:32,020
.تعلم أنّ العالم السّفليّ لن يسمحوا لفاشل بالهرب

279
00:19:34,840 --> 00:19:37,040
.يا له من شروق جميل

280
00:19:37,980 --> 00:19:44,590
.ستكون الأمور أسهل بكثير لو أنّه أذاب جسدي

281
00:19:46,470 --> 00:19:49,140
.تزوتشي، لن أنسى أبدًا

282
00:19:52,660 --> 00:19:54,760
.مذاق كعك القمر ذاك

283
00:19:55,830 --> 00:19:58,420
!لن أنسى أبدًا

284
00:20:02,510 --> 00:20:04,030
.شكرًا

285
00:20:06,970 --> 00:20:10,640
تلك الابتسامة الّتي ذابت مع شمس الصّبح المشرقة الحمراء

286
00:20:11,000 --> 00:20:14,100
.ترسّخت في ذهني إلى الأبد

287
00:20:15,270 --> 00:20:18,160
لن أنسى أبدًا الاسم الفخور

288
00:20:18,160 --> 00:20:24,760
للنّاسك العظيم المحلّق في السّماء
.وأحد نجوم النّمر الخمسة تزوتشي

289
00:20:31,470 --> 00:20:35,730
.زلابيّة العنقاء طبق باهر

290
00:20:36,930 --> 00:20:40,760
في، من أعدّ هذا الطّبق؟

291
00:20:41,510 --> 00:20:44,970
.طبّاخ غواندونغ الخارق لو ماوشين

292
00:20:45,340 --> 00:20:49,430
.الرّجل الوحيد الّذي أحسبه منافسي في هذا العالم

293
00:20:50,770 --> 00:20:52,040
.أريده

294
00:20:52,040 --> 00:20:55,900
!أريده أن يطبخ في مطبخ البلاط

295
00:20:55,900 --> 00:20:59,120
هل تظنّ أنّك تستطيع ضمّه؟

296
00:20:59,120 --> 00:21:00,360
ضمّ ماو؟

297
00:21:01,060 --> 00:21:04,560
.أشكّ في ذلك

298
00:21:06,780 --> 00:21:10,500
.قد يبدو وديعًا، لكنّه عنيد للغاية

299
00:21:13,750 --> 00:21:15,950
!نجحت يا ماو

300
00:21:15,950 --> 00:21:19,460
سوف نختزل الوقت كثيرًا الآن
.بما أنّنا نعلم أنّ هذه خريطة لتشنغدو

301
00:21:19,460 --> 00:21:22,210
.أجل. الآنية الأسطوريّة تقبع في تشنغدو

302
00:21:22,840 --> 00:21:24,310
.شكرًا على المساعدة يا أختي

303
00:21:24,310 --> 00:21:26,790
.أنا مسرورة لأنّني نفعت بشيء

304
00:21:26,790 --> 00:21:28,470
ستغادر أخيرًا إذًا؟

305
00:21:30,140 --> 00:21:32,200
ميلي، ما الخطب؟

306
00:21:33,560 --> 00:21:37,300
...عذرًا، ماو. تفضّل

307
00:21:40,310 --> 00:21:41,650
!شكرًا لك يا ميلي

308
00:21:41,650 --> 00:21:43,480
.أصلحته من أجلي

309
00:21:43,840 --> 00:21:48,830
.تسبّبت بالكثير من المشاكل هذه المرّة

310
00:21:50,380 --> 00:21:52,180
!أراك لاحقًا

311
00:21:52,180 --> 00:21:54,810
!أجل! بداية جديدة

312
00:21:54,810 --> 00:21:57,730
!الآنية الرّابعة نصب أعيننا في تشنغدو

313
00:21:57,730 --> 00:22:00,130
!هيّا بنا

314
00:23:30,090 --> 00:24:00,760
في الحلقة القادمة

315
00:23:57,030 --> 00:23:59,190
".في الحلقة القادمة، "دونهوانغ الباهرة