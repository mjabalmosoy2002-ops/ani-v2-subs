1
00:01:48,960 --> 00:01:51,960
!اكتفيت

2
00:01:54,390 --> 00:01:56,060
...ماو

3
00:01:56,060 --> 00:02:03,760
لمَ على طبّاخ ماهر أن يموت في مسابقة طبخ؟

4
00:02:05,130 --> 00:02:09,710
.لا يمكننا أن نتصوّر كم من آلاف النّاس يستطيع أن يُسعِد

5
00:02:10,970 --> 00:02:13,060
!وذات الأمر ينطبق على البقيّة

6
00:02:14,020 --> 00:02:16,670
.خاطروا بحياتهم من أجل صقل مهاراتهم

7
00:02:16,670 --> 00:02:18,640
لمَ عساك تلطّخ ذلك بالدّماء؟

8
00:02:30,730 --> 00:02:32,970
!التحكّم بالنّاس بواسطة الطّبخ؟ بربّك

9
00:02:32,970 --> 00:02:35,420
!لا بدّ أنّك تهزأ! هذا سخيف

10
00:02:35,420 --> 00:02:37,050
!ماو

11
00:02:37,050 --> 00:02:40,010
!هذا غير منطقيّ

12
00:02:41,970 --> 00:02:44,520
.أنتم مجانين

13
00:02:45,320 --> 00:02:50,540
...ليون وشوان وتزوتشي

14
00:02:51,110 --> 00:02:53,810
!دُمّروا جميعًا من قبل الطّبخ

15
00:02:53,810 --> 00:02:55,430
!أغبياء

16
00:02:55,430 --> 00:02:59,320
!أتمنّى أن يختفي عالم الطّبخ السّفليّ برمّته

17
00:03:09,390 --> 00:03:13,520
.يفترض أن يجعل الطّبخ النّاس سعداء

18
00:03:17,810 --> 00:03:18,710
.اسمع يا فتى

19
00:03:18,710 --> 00:03:21,840
أولئك الّذين ولدوا في جبل ليانغ ومن فرّوا من هنا

20
00:03:21,840 --> 00:03:24,890
!تخلّوا عن كلّ ذرّة أمل في تحقيق سعادة لائقة

21
00:03:25,220 --> 00:03:28,400
علّمنا كايو-ساما حسّ الإنجاز

22
00:03:28,400 --> 00:03:31,390
!الّذي يأتي من صقل مهاراتنا والمخاطرة بحياتنا

23
00:03:32,060 --> 00:03:35,430
،بمجرّد تسلّقنا إلى قمّة جبل ليانغ وتحرّرنا

24
00:03:35,430 --> 00:03:37,940
!بات كلّ النّاس عبيدنا

25
00:03:37,940 --> 00:03:39,210
—بعد كلّ هذا

26
00:03:40,170 --> 00:03:41,570
...أركان-ساما

27
00:03:42,090 --> 00:03:46,620
.ليو ماوشين، هذا الرّاهب الزّهريّ لو داتس

28
00:03:46,620 --> 00:03:50,540
.إن تعلّق الأمر بالأطباق الباردة، فهو منقطع النّظير

29
00:03:50,940 --> 00:03:55,460
ضرب رجلًا خسيسًا حتّى الموت لفرضه ضرائب باهظة

30
00:03:55,460 --> 00:03:58,040
.وفرّ هاربًا إلى هنا في جبل ليانغ

31
00:03:59,150 --> 00:04:03,970
هل تقصد أنّ حتّى مجرمًا مثله يمكنه إسعاد النّاس؟

32
00:04:03,970 --> 00:04:06,180
!يمكنه التّكفير عن جرائمه

33
00:04:06,180 --> 00:04:08,560
،بعدها، إن مارس مهاراته العظيمة بلا مقابل

34
00:04:08,560 --> 00:04:10,660
!فبيده أن يجعل بلدةً بكاملها سعيدة

35
00:04:11,180 --> 00:04:14,560
!لن يدعوه أحد بمجرم

36
00:04:18,180 --> 00:04:22,300
.أنا وو يونغ النّجم الضّليع، سيّد الشّاي الصّينيّ

37
00:04:22,300 --> 00:04:27,370
دخلت بالخطأ إلى غابة مملوكة من
.الحكومة وسرقت بعض أوراق الشّاي

38
00:04:28,090 --> 00:04:30,920
هل أملك الحقّ في إسعاد النّاس أيضًا؟

39
00:04:30,920 --> 00:04:33,220
يمكنك تحضير شاي السّعادة خاصّتك

40
00:04:33,220 --> 00:04:36,830
!الّذي سيجعل عشرات الآلاف يتنهّدون باقتناع كلّ يوم

41
00:04:36,830 --> 00:04:40,780
!يمكن مسامحة مثل هذه الجريمة التّافهة بسرعة

42
00:04:40,780 --> 00:04:41,930
!أنت

43
00:04:41,930 --> 00:04:44,010
!تكلّم بمنطقيّة

44
00:04:44,010 --> 00:04:46,130
!أجل، إنّك تتفوّه بكلام تافه فحسب

45
00:04:46,130 --> 00:04:47,850
.يعتمد الأمر على مشاعركم

46
00:04:48,450 --> 00:04:52,720
!يمكن أن يبدأ عصركم الآن

47
00:04:55,260 --> 00:04:57,060
عصرنا؟

48
00:04:57,060 --> 00:04:59,940
هل لاحظت؟

49
00:05:00,960 --> 00:05:04,170
بهذه السّاق المكبّلة، أراق دمه الخاصّ

50
00:05:04,170 --> 00:05:09,990
بينما تجوّل في منطقة مخزون
.الطّعام لجمع عدد معيّن من المكوّنات

51
00:05:10,950 --> 00:05:13,080
أيّ عدد؟

52
00:05:13,080 --> 00:05:18,640
.‫108، عدد اللّصوص الّذين أسّسوا منظّمتنا

53
00:05:19,260 --> 00:05:22,550
.بمفهوم آخر، إنّه يرمز لنا

54
00:05:22,550 --> 00:05:26,860
.يعتبرنا أبطال الأرض

55
00:05:26,860 --> 00:05:29,550
أليس كذلك يا ليو ماوشين؟

56
00:05:35,250 --> 00:05:37,020
نحن؟

57
00:05:37,020 --> 00:05:39,020
أبطال؟

58
00:05:44,500 --> 00:05:48,820
.إنّه خطير. ذلك الصّبيّ خطير للغاية

59
00:05:49,840 --> 00:05:53,990
،أمضيت أعوامًا في بناء هذه المنظّمة

60
00:05:53,990 --> 00:05:57,520
.وها هو يوشك على تدمير كلّ شيء في طرفة عين

61
00:06:04,390 --> 00:06:07,980
.هؤلاء الحمقى لا يردّون حبّي

62
00:06:11,470 --> 00:06:14,730
.كلماتك ليست منطقيّة

63
00:06:16,930 --> 00:06:20,780
.لكنّها تحرّك قلبي لسببٍ ما

64
00:06:21,270 --> 00:06:27,940
.ما زلتُ أذكر اليوم الّذي بارزتُ فيه أمّك، باي، هنا في جبل ليانغ

65
00:06:29,910 --> 00:06:33,870
.قاتلت ببسالة. كانت قويّة

66
00:06:33,870 --> 00:06:37,690
،عندما لم نستطع تحديد فائز وآلت مسابقتنا إلى تعادل

67
00:06:37,690 --> 00:06:39,580
...قالت

68
00:06:39,580 --> 00:06:43,010
.يا لها من خسارة. إنّها لخسارة يا أركان

69
00:06:43,010 --> 00:06:48,250
.يمكن لرجل بمهارتك أن ينقذ العديد من النّاس

70
00:06:49,170 --> 00:06:54,510
.ستدرك عمّا قريب أنّ الطّبخ ليس للتحكّم بالنّاس والتّلاعب بهم

71
00:06:54,510 --> 00:06:58,520
!وُجد الطّبخ لتحرير النّاس وجعلهم سعداء

72
00:06:59,270 --> 00:07:02,150
،كشخص وُلد وترعرع في العالم السّفليّ

73
00:07:02,150 --> 00:07:06,540
.حيث تدرّب بشكل أعمى، لم أفهم كلماتها

74
00:07:07,080 --> 00:07:08,370
!ارموا بها إلى الخارج

75
00:07:08,370 --> 00:07:09,600
!أركان

76
00:07:12,450 --> 00:07:18,200
لكن بعد مبارزتي لك، أشعر وكأنّني أملك فهمًا مبهمًا

77
00:07:18,200 --> 00:07:21,320
.لما يريد النّاس من الطّبخ

78
00:07:25,920 --> 00:07:28,940
...هل يمكن لطبخنا

79
00:07:29,510 --> 00:07:31,790
أن يسعد النّاس حقًّا؟

80
00:07:49,530 --> 00:07:51,600
...كايو-ساما، الآنية الأسطوريّة

81
00:07:51,600 --> 00:07:52,990
!وهذه أيضًا

82
00:08:11,630 --> 00:08:12,800
ما هذه؟

83
00:08:15,720 --> 00:08:18,180
شيلو، ما ذلك الضّوء؟

84
00:08:18,570 --> 00:08:20,640
—أيّ ضوء

85
00:08:21,120 --> 00:08:23,180
مهلًا، حقًّا؟

86
00:08:45,310 --> 00:08:47,590
.الأواني الثّمان تصرخ

87
00:08:47,590 --> 00:08:51,790
،أيعني هذا أنّ كلماته حرّكت قلوب طبّاخي كيرين خاصّتي

88
00:08:51,790 --> 00:08:54,450
مكشّرين أنيابهم لهذه الأرض؟

89
00:08:54,450 --> 00:08:57,050
.يا لها من هِبة من السّماوات

90
00:08:57,050 --> 00:08:59,390
.أنا محظوظ بحقّ

91
00:09:13,910 --> 00:09:15,940
ما الّذي يتسبّب بهذه الهزّات؟

92
00:09:35,490 --> 00:09:37,220
!ماذا حصل؟

93
00:09:38,140 --> 00:09:41,220
!دُمّر خزّان جبل ليانغ

94
00:09:49,690 --> 00:09:52,010
!إنّها تُمطر وترعد بجنون في الخارج

95
00:09:52,010 --> 00:09:53,110
ماذا؟

96
00:09:53,110 --> 00:09:56,360
.على هذا الحال، سيرتفع مستوى الماء بسرعة

97
00:09:57,190 --> 00:10:01,740
.تخلّى كايو عن جبل ليانغ أخيرًا

98
00:10:08,810 --> 00:10:11,040
!ادخلوا بسرعة

99
00:10:11,860 --> 00:10:13,810
!ماوشين، اصعد أيضًا

100
00:10:13,810 --> 00:10:15,760
!ماو، تماسك

101
00:10:22,640 --> 00:10:27,140
!ماو، لن تنجو مه تلك الكرة والأغلال في الماء

102
00:10:31,430 --> 00:10:32,440
!أركان

103
00:10:33,070 --> 00:10:34,150
.إنّه مصاب بشدّة

104
00:10:38,250 --> 00:10:42,630
.سنرى إلى أيّ مدى سأصمد بحرارتي في هذا الماء

105
00:10:44,220 --> 00:10:45,570
.لا تفعل يا أركان

106
00:10:45,570 --> 00:10:47,830
.هيّا يا ليو ماوشين

107
00:10:49,670 --> 00:10:51,000
.إلى بكين

108
00:10:51,650 --> 00:10:55,040
سيأخذ كايو الدّقّيّ المقدّس والخريطة

109
00:10:55,040 --> 00:10:59,090
.وكذلك الآنية الّتي سرق من جبل تاي إلى بكين

110
00:10:59,720 --> 00:11:03,430
.وهناك أحد نجوم النّمر الخمسة آخر

111
00:11:03,430 --> 00:11:05,100
أحد آخر؟

112
00:11:05,100 --> 00:11:09,350
.توخّ الحذر. حتّى أنا لا أفهمه بشكل كامل

113
00:11:14,200 --> 00:11:17,320
!أركان، يكفي. هذا يكفي

114
00:11:17,320 --> 00:11:20,280
!إيّاك أن تستهين بأحد نجوم النّمر الخمسة

115
00:11:23,280 --> 00:11:25,130
!ماو

116
00:11:25,130 --> 00:11:26,160
!ماوشين

117
00:11:35,780 --> 00:11:37,060
.أخرج القارب

118
00:11:37,060 --> 00:11:40,770
ما زال أركان-ساما والبقيّة في الدّاخل. هل أنت واثق؟

119
00:11:40,770 --> 00:11:42,590
.ما باليد حيلة

120
00:11:43,450 --> 00:11:47,180
.يبدو أنّ حبّي لم يكن كافيًا

121
00:11:47,180 --> 00:11:51,600
.لا يهمّ. يكمنني أن أدرّب المزيد من طبّاخي كيرين دائمًا

122
00:11:56,470 --> 00:12:00,620
.سأكون من يخلق عصرًا جديدًا

123
00:12:04,440 --> 00:12:05,620
!أركان

124
00:12:08,760 --> 00:12:12,260
.اخرج من هنا يا ليو ماوشين

125
00:12:12,260 --> 00:12:14,670
.موجة أخرى ستضرب

126
00:12:14,670 --> 00:12:17,040
.أنت مكبّل بكرة حديديّة أيضًا

127
00:12:17,550 --> 00:12:19,250
!أركان-ساما

128
00:12:21,560 --> 00:12:22,880
!أركان-ساما

129
00:12:26,470 --> 00:12:28,400
!أركان-ساما

130
00:12:30,770 --> 00:12:34,380
.نفدت حرارتي

131
00:12:36,170 --> 00:12:41,360
.أركان-ساما، رأس سهم اليشم ليك ستتبعك إلى أيّ مكان

132
00:12:43,930 --> 00:12:47,200
.أنا آسف على كلّ شيء يا ليك

133
00:12:53,580 --> 00:12:57,330
!أركان-ساما

134
00:12:58,850 --> 00:13:02,880
.أراه. يمكنني أن أراه يا ليو ماوشين

135
00:13:03,410 --> 00:13:08,310
.يمكنني أن أرى عالم الطّبخ الجديد الّذي ستنشئه

136
00:13:11,350 --> 00:13:14,350
!أركان

137
00:13:55,790 --> 00:13:56,820
...ذاك القارب

138
00:14:05,660 --> 00:14:06,820
—أركان

139
00:14:20,390 --> 00:14:21,500
!كايو

140
00:14:22,140 --> 00:14:25,670
!لن أسامحه أبدًا

141
00:14:25,670 --> 00:14:27,590
ماو، ما الّذي دهاك؟

142
00:14:27,590 --> 00:14:29,130
!ماو، توقّف

143
00:14:30,590 --> 00:14:31,740
!سحقًا

144
00:14:44,600 --> 00:14:46,620
.يا فتى، سنساعدك

145
00:14:50,230 --> 00:14:54,240
.أنت الفتى الّذي قادنا إلى العصر الجديد

146
00:14:54,240 --> 00:14:55,740
.واصل

147
00:14:56,120 --> 00:14:58,710
.تعال إلى هنا وتشبّث بدراعي

148
00:14:59,570 --> 00:15:00,670
.حسنًا

149
00:15:03,990 --> 00:15:07,110
.هيّا جميعًا. لنحرّك هذا القارب

150
00:15:07,110 --> 00:15:08,090
!أجل

151
00:15:13,370 --> 00:15:15,900
!قد يكون هذا صعبًا قليلًا

152
00:15:15,900 --> 00:15:17,220
.أعتمد على ذلك

153
00:15:24,430 --> 00:15:26,540
!أجل

154
00:15:26,540 --> 00:15:28,670
!بادر يا فتى

155
00:15:28,670 --> 00:15:30,520
!لا تدع كايو يهرب

156
00:15:31,450 --> 00:15:32,490
!شكرًا

157
00:15:33,040 --> 00:15:34,960
!انتظر يا كايو

158
00:15:37,600 --> 00:15:41,320
يا لك من فتى محظوظ بشكل لا يصدّق. أما زلت حيًّا؟

159
00:15:41,870 --> 00:15:44,940
.ضحّى أركان بحياته لإنقاذي

160
00:15:45,640 --> 00:15:47,740
!لن تهرب منّي يا كايو

161
00:15:51,920 --> 00:15:54,720
.يا لك من فتى شغوف

162
00:15:55,500 --> 00:16:01,160
لكنّي واثق أنّ أركان سيندم على إهدار آخر ما تبقّى من حرارته

163
00:16:01,160 --> 00:16:03,250
.لإنقاذ لهيبك الصّغير

164
00:16:04,000 --> 00:16:05,540
ما كان ذلك؟

165
00:16:06,720 --> 00:16:08,260
هل تشعر بالإحباط؟

166
00:16:08,980 --> 00:16:14,570
إذًا فلتلعن يديك الضّعيفتين والصّغيرتين
.جدًّا على إحكام أيّ شيء

167
00:16:14,570 --> 00:16:17,840
.فجّرت خزّان جبل ليانغ

168
00:16:17,840 --> 00:16:20,040
—وبسببك، أركان والبقيّة

169
00:16:20,040 --> 00:16:23,550
.لك أن تواصل حياتك في لوم الآخرين

170
00:16:23,550 --> 00:16:27,900
،سيواصل الّذين يفيضون حزنًا الظّهور أمام نفسك الغرّة

171
00:16:27,900 --> 00:16:30,340
.ليختفوا بعدها

172
00:16:30,650 --> 00:16:32,780
!لا تكن سخيفًا

173
00:16:42,270 --> 00:16:43,440
!كايو

174
00:17:14,070 --> 00:17:15,160
!ماو

175
00:17:27,090 --> 00:17:32,720
.ابن باي، أنت وأمّك قبيحان

176
00:18:05,030 --> 00:18:08,010
.يجب أن أذهب إلى بكين

177
00:18:09,820 --> 00:18:11,880
.عليّ أن أطبخ طبقي الأخير

178
00:18:18,360 --> 00:18:23,350
.الإمبراطور نفسه يرعى بطولة طبخ كبرى

179
00:18:23,350 --> 00:18:28,140
المفتوحة للرّجال والنّساء من كافّة
.الأعمار، بصرف النّظر عن مؤهّلاتهم

180
00:18:28,140 --> 00:18:33,390
.كلّ ذي مهارة مشجّع للمجيء إلى العاصمة الإمبراطوريّة بكين

181
00:18:38,260 --> 00:18:39,810
.يمكنني سماعها

182
00:18:39,810 --> 00:18:42,680
،الأرض ترتعش كما كلّ النّجوم، الصّالحين والطّالحين

183
00:18:42,680 --> 00:18:46,020
.سيجتمعون في العاصمة الإمبراطوريّة

184
00:18:46,020 --> 00:18:50,610
ليس ذلك فحسب، سيكافئ الإمبراطور الفائز

185
00:18:50,610 --> 00:18:53,730
.بأعظم الكنوز، قدر تنّين اليشم

186
00:18:57,100 --> 00:19:02,700
.أخيرًا، المعركة على الأواني الأسطوريّة تدنو من نهايتها

187
00:19:03,840 --> 00:19:08,900
.ماو، ستُختبر قيمتك الحقيقيّة

188
00:19:23,000 --> 00:19:25,940
.من قاعة شاولين في محافظة خنان، تشين باو يودّ الدّخول

189
00:19:25,940 --> 00:19:28,470
.من محافظة زيجانغ، أنا الطبّاخ الخارق شي كان

190
00:19:28,470 --> 00:19:30,040
.انظروا لذلكما الاثنين

191
00:19:30,040 --> 00:19:31,720
.إنّهما الطبّاخان الخارقان من محافظة خنان

192
00:19:31,720 --> 00:19:33,980
.الأخوان كالا ولو

193
00:19:34,450 --> 00:19:37,560
!يدعيان بأخوي الدّامبلغ

194
00:19:39,770 --> 00:19:42,050
.انظر لكلّ هؤلاء الحشد

195
00:19:42,050 --> 00:19:45,830
.يشجّع الدّخول غير المشروط على المشاركة بالتّأكيد

196
00:19:45,830 --> 00:19:49,200
.إنّها أوّل بطولة طبخ إمبراطوريّة

197
00:19:49,200 --> 00:19:53,860
.أنا متشوّق لرؤية أيّ طبّاخين سيجتمعون من حول البلاد

198
00:19:57,330 --> 00:19:58,950
ما ذلك؟

199
00:19:58,950 --> 00:20:00,420
من هم؟

200
00:20:00,420 --> 00:20:04,040
من أولئك الرّجال الخطيرون؟

201
00:20:06,550 --> 00:20:10,930
،من جبل ليانغ في محافظة شاندونغ
.أحد نجوم النّمر الخمسة كايو

202
00:20:11,350 --> 00:20:14,060
!مثله، أحد نجوم النّمر الخمسة إين سي

203
00:20:14,060 --> 00:20:16,860
!نودّ الدّخول إلى مسابقة طبخ المدينة المحرّمة

204
00:20:16,860 --> 00:20:20,010
ماذا؟ جبل ليانغ؟ نجوم النّمر الخمسة؟

205
00:20:20,010 --> 00:20:24,530
.لا أصدّق أنّ طبّاخين من العالم السّفليّ سيشاركان علنًا

206
00:20:24,530 --> 00:20:25,430
عالم الطّبخ السّفليّ؟

207
00:20:25,430 --> 00:20:26,170
هل لهم وجود؟

208
00:20:26,170 --> 00:20:27,780
...سمعتُ أنّهم يقتلون لتحقيق أهدافهم

209
00:20:27,780 --> 00:20:28,820
!مرعب

210
00:20:28,820 --> 00:20:32,710
.يا كايو. يبدو أنّ لدينا سمعة سيّئة

211
00:20:33,120 --> 00:20:35,630
.لا ينبغي أن يقولوا مثل هذا الكلام الرّذيل

212
00:20:35,630 --> 00:20:39,760
.اليوم هو اليوم الّذي سيغلّف فيه حبّي الأرض

213
00:20:40,170 --> 00:20:42,830
.لدينا آنيتان أسطوريّتان بالفعل

214
00:20:42,830 --> 00:20:48,140
.سنستخدمها حقّ استخدام في هذه البطولة ونفوز

215
00:20:48,590 --> 00:20:54,730
...لي، إن أخذا قدر تنّين اليشم الأسطوريّ

216
00:20:54,730 --> 00:20:58,320
.سيقع عالم الطّبخ الصّينيّ في الفوضى

217
00:20:59,300 --> 00:21:01,120
.لا أصدّق ذلك

218
00:21:02,060 --> 00:21:09,010
.لم يظهر أيّ طبّاخ قادر على هزيمة نجوم النّمر الخمسة بعد

219
00:21:11,080 --> 00:21:16,320
!سيحمي هذا الرّجل عالم الطّبخ الصّينيّ

220
00:21:18,040 --> 00:21:21,500
!فليعش يان شيان-ساما

221
00:21:33,230 --> 00:21:37,400
.عليّ أن أسرع إلى العاصمة بهذه الآنية الأسطوريّة

222
00:21:38,900 --> 00:21:41,440
ألم نصل بعد؟

223
00:21:41,440 --> 00:21:43,940
.كنت متحمّسًا جدًّا في البداية

224
00:21:43,940 --> 00:21:46,360
.اخرسي يا أختي. نفد وقودي

225
00:21:46,820 --> 00:21:49,700
.حسنًا يا شيرو. لنأكل هنا

226
00:21:49,700 --> 00:21:50,970
.هذا ما أردتُ سماعه

227
00:21:50,970 --> 00:21:52,750
.سأجمع بعض الحطب

228
00:21:52,750 --> 00:21:55,330
.سأجلب بعض الماء

229
00:21:55,330 --> 00:21:57,330
ماذا يوجد على القائمة اليوم؟

230
00:21:57,330 --> 00:21:59,480
...لنرَ

231
00:21:59,480 --> 00:22:01,760
!رفاق

232
00:22:03,760 --> 00:22:07,360
.ولا حتّى الطبّاخ الخارق يستطيع أن يطبخ وجبةً لائقة دون مكوّنات

233
00:22:07,360 --> 00:22:09,400
.ماو، آسف على التّأخير

234
00:22:09,400 --> 00:22:12,220
.هذه الآنية الأسطوريّة السّادسة

235
00:22:15,470 --> 00:22:17,690
!شيلو، ليون

236
00:22:20,980 --> 00:22:23,410
لمَ تبدو مصدومًا؟

237
00:22:23,410 --> 00:22:25,820
.لعلمك، لسنا شبحين

238
00:22:25,820 --> 00:22:27,120
.انظر لهذه

239
00:22:31,010 --> 00:22:32,430
!رائع

240
00:22:32,430 --> 00:22:35,080
!كلّ الخضراوات واللّحم لا تزال طازجة

241
00:22:41,370 --> 00:22:43,620
.إنّه لذيذ! وهذا أيضًا

242
00:22:44,150 --> 00:22:46,520
.طوّرت مهاراتك ثانيةً

243
00:22:45,430 --> 00:22:48,040
.ماو، هذا الشّيء مذهل

244
00:22:46,520 --> 00:22:49,040
.شيرو، أنت تسرف الأكل

245
00:22:53,590 --> 00:23:00,540
.أريد أن أنقل هذه السّعادة البسيطة إلى المزيد من النّاس

246
00:23:01,760 --> 00:23:06,480
.فذلك هو فرحنا الأعظم كطبّاخة

247
00:23:07,520 --> 00:23:09,750
أليس كذلك يا أمّي؟

248
00:23:13,050 --> 00:23:15,570
!ماو، الطّعام جاهز

249
00:23:15,570 --> 00:23:18,040
!ماو، تعال

250
00:23:18,040 --> 00:23:19,420
!حسنًا

251
00:23:19,420 --> 00:23:20,440
ما هذا؟

252
00:23:20,440 --> 00:23:21,790
هل تتحدّث أثناء نومك؟

253
00:23:21,790 --> 00:23:23,260
.ماو، أنت مضحك حقًّا

254
00:23:23,260 --> 00:23:26,280
ماو. هل تريد طبقًا آخر؟

255
00:23:26,280 --> 00:23:28,290
!أجل. المزيد، رجاءً