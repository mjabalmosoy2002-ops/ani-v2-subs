1
00:01:36,370 --> 00:01:40,740
أنا متأكّدة بأنّ لديّ بطاقات ذاكرة
تحتوي على صور هنا أيضاً

2
00:01:50,810 --> 00:01:55,050
يبعث هذا على الحنين. إنّه إيشيغامي

3
00:01:55,640 --> 00:01:59,010
فقدَ صوابه بعد تخرُّج تسوبامي

4
00:01:59,810 --> 00:02:04,220
رحلة صفّنا. دخلتُ في شِجار
عنيف مع هاياساكا

5
00:02:04,700 --> 00:02:08,490
لأنّها اعتقدتْ حينها بأنّها لا تستطيع
الهرب من عائلة شينوميا

6
00:02:08,490 --> 00:02:10,120
رغم أنّ ذلك لم يكن صحيحاً

7
00:02:10,580 --> 00:02:15,870
مُغادرة الرّئيس كي يتمكّن من الدّراسة خارج
البلاد كانت تقترب لذا كنتُ مُرتعدة جدّاً

8
00:02:17,230 --> 00:02:19,040
أتذكّر كلّ شيء

9
00:02:19,040 --> 00:02:21,740
كلّها ذكريات ثمينة لا تُعوَّض

10
00:02:22,550 --> 00:02:24,250
أجل... كلّها

11
00:02:25,490 --> 00:02:27,530
حسناً، هذه ليست مُميّزة تماماً

12
00:02:28,170 --> 00:02:32,040
...لكن أعتقد... كانت من عيد ميلادي

13
00:02:39,500 --> 00:02:41,980
!حقّقَ المقلب نجاحاً باهراً

14
00:02:41,980 --> 00:02:43,510
!يا للهول! أخفتني

15
00:02:43,830 --> 00:02:45,050
أنت أحمق للغاية

16
00:02:45,050 --> 00:02:48,940
من الواضح أنّ الفتيات العاديّات
لا يحلقنَ شعرهن بالكامل

17
00:02:48,940 --> 00:02:51,150
الفتيات العاديّات لا يرتدين
قبّعة قرعاء أيضاً

18
00:02:51,690 --> 00:02:54,140
حسناً... ما الغاية من هذه
المُفاجأة بالضّبط؟

19
00:02:54,140 --> 00:02:56,120
ماذا برأيك؟

20
00:02:56,120 --> 00:02:58,900
!هذه مُفاجأة عيد ميلاد كاغويا

21
00:02:58,900 --> 00:03:01,320
!مُفاجآت عيد الميلاد

22
00:03:01,820 --> 00:03:06,580
عُرف حيث يتمّ التّخطيط لمُفاجأة على أمل
أن تُخلَّد ذكرى عيد ميلاد شخص

23
00:03:07,460 --> 00:03:09,570
إذاً كيف لقبّعة قرعاء أن
تؤدّي هذا الغرض؟

24
00:03:09,570 --> 00:03:12,200
،لكن بحسب على المُفاجأة آنفة الذّكر
قد ينتهي الأمر بالتنمُّر

25
00:03:12,200 --> 00:03:16,010
لذا توضع حساسيّة الشّخص الّذي
يؤدّي المُفاجأة تحت الاختبار

26
00:03:16,010 --> 00:03:19,330
في الواقع، أنا في مأزق بينما
أحاول معرفة ذلك

27
00:03:19,640 --> 00:03:22,810
أتتذكّر كيف أعطتْك مويها
أصفاداً في الكريسماس

28
00:03:22,810 --> 00:03:24,960
وتحوّل الأمر إلى ذِكرى غريبة في نظرك؟

29
00:03:25,330 --> 00:03:29,610
،والآن كلّما فكّرتَ في الكريسماس
تُطاردك تلك الأصفاد

30
00:03:29,610 --> 00:03:30,900
...في الواقع

31
00:03:30,900 --> 00:03:32,650
لستُ مهتمّاً بذلك بصراحة

32
00:03:34,900 --> 00:03:37,790
هديّة الكريسماس الّتي حصلتُ عليها
...من شينوميا

33
00:03:39,190 --> 00:03:43,410
أعطتْني مجموعة قرطاسيّة، لكن يبدو
كشيء يختاره إيشيغامي

34
00:03:43,880 --> 00:03:47,830
المُفكِّرات لا تدوم للأبد، لذا
هي حُلوة تشوبها المرارة

35
00:03:49,030 --> 00:03:51,290
إن لم يكن لديك مانع، أرغب
في التجوّل برفقتك

36
00:03:51,290 --> 00:03:52,990
لنذهب ونشاهدها مع الجميع ثانية

37
00:03:52,990 --> 00:03:56,050
أرغب في اختيار مُفكّرتك للعام المُقبل أيضاً

38
00:03:56,990 --> 00:04:00,160
ناهيك عن أنّ عيد ميلاد شينوميا
كان في الأسبوع الماضي، صحيح؟

39
00:04:00,160 --> 00:04:01,630
يمكن القول بأنّك فوّتّ فُرصتك

40
00:04:02,140 --> 00:04:04,710
وقد أعطيتُها هديّة بالفعل

41
00:04:08,670 --> 00:04:11,890
حسناً، اليوم هو عيد ميلادي عمليّاً

42
00:04:12,320 --> 00:04:15,430
لكن الوحيد الّذي تمنّى لي عيد ميلاد
سعيداً كانت أخت زوجي

43
00:04:15,780 --> 00:04:19,890
لن تحصلي على الكثير من أحد
في هذه الحالة من هذه النّاحية

44
00:04:20,360 --> 00:04:23,650
لكن لديّ شيء أريد إعطاءكِ إيّاه

45
00:04:24,210 --> 00:04:25,640
إنّها من ميوكي

46
00:04:25,640 --> 00:04:26,910
!من الرّئيسة؟

47
00:04:30,560 --> 00:04:32,170
عِقد؟

48
00:04:32,590 --> 00:04:35,070
هذا فاخر جدّاً

49
00:04:35,550 --> 00:04:38,520
هاياساكا... هل لديكِ مسطرة؟

50
00:04:39,660 --> 00:04:43,340
!توقّعت! طوله 24.8 سم

51
00:04:43,960 --> 00:04:46,310
هل يعني الطّول شيئاً؟

52
00:04:46,310 --> 00:04:48,630
T = 2π√(L/g)

53
00:04:48,630 --> 00:04:49,970
ألا تفهمين؟

54
00:04:49,970 --> 00:04:52,590
أعطيتُه مُفكِّرة في الكريسماس

55
00:04:52,590 --> 00:04:56,190
مُفعمة بالأمل لقضاء العام
المُقبل معه أيضاً

56
00:04:56,190 --> 00:04:59,200
!هذا هو ردّه على ذلك

57
00:04:59,950 --> 00:05:06,270
،إذا كانت هذه المُعادلة تُساوي 24.8 سم هنا
!فهذا يعني أنّ الدّورة الزّمنيّة تُساوي 0.9995

58
00:05:06,270 --> 00:05:08,740
ما يعني بأنّ أرجحة واحدة
!تُساوي 1 ثانية

59
00:05:08,740 --> 00:05:11,200
!ما يعني بأنّ هذا رقّاص ساعة

60
00:05:12,460 --> 00:05:16,350
أنا متأكّدة بأنّ الرّئيسة ترتدي
الشّيء نفسه الآن

61
00:05:17,030 --> 00:05:19,200
"لنعِش الوقت نفسه"

62
00:05:19,200 --> 00:05:23,370
!هذا هو المعنى خلف هذا العِقد

63
00:05:26,120 --> 00:05:29,150
لِمَ يجب أن يكون مهمّاً إذا كنتُ
أحتفل بعد بضعة أيّام؟

64
00:05:29,150 --> 00:05:31,600
ما المُهمّ هنا هو حقيقة أنّني
!احتفلتُ به كما ينبغي

65
00:05:31,600 --> 00:05:35,510
وإلّا قد لا تحتفل هي بعيد ميلادي

66
00:05:35,510 --> 00:05:36,600
إذاً تفعلين هذا لأجل نفسكِ

67
00:05:36,600 --> 00:05:39,600
ما المقلب الّذي ينبغي أن نقوم
به برأيك يا حضرة الرّئيس؟

68
00:05:39,600 --> 00:05:42,770
ألا تريد أن ترى كاغويا مُرتعدة؟

69
00:05:42,770 --> 00:05:44,490
أنتِ حثالة لقولكِ ذلك
بابتسامة في محياكِ

70
00:05:45,000 --> 00:05:50,480
على سبيل المثال، يمكننا البدء بالشّجار
،فجأة وعندما تغدو الأمور غريبة

71
00:05:50,480 --> 00:05:53,210
!يمكننا أن نكشف بأنّه كان مقلباً

72
00:05:54,590 --> 00:05:57,340
لا أحبّ مثل هذه الأوضاع

73
00:05:57,340 --> 00:06:00,000
دائماً ما أغيّر القناة عندما تُعرَض
هذه الأشياء في التّلفزيون

74
00:06:00,250 --> 00:06:02,730
إذاً هل ينبغي أن نُغازل
بعضنا الآخر بدلاً من ذلك؟

75
00:06:02,730 --> 00:06:03,630
نُغازل؟

76
00:06:04,960 --> 00:06:08,200
يمكننا القول بأنّنا بدأنا نتواعد
أثناء استراحة الشّتاء

77
00:06:08,200 --> 00:06:10,430
!ونمسك بأيدي بعضنا الآخر

78
00:06:10,430 --> 00:06:11,890
!لا، لا، لا، لا

79
00:06:11,890 --> 00:06:15,270
شينوميا وأنا بدأنا نتواعد
!خلال استراحة الشّتاء

80
00:06:15,270 --> 00:06:18,440
مُحال أن أمزح حتّى بشأن
!خيانتها بهذه السّرعة

81
00:06:19,800 --> 00:06:22,660
لكن لم نُخبر فوجيوارا والآخرين
بشأن الأمر

82
00:06:22,660 --> 00:06:24,610
،إذا اكتشفَ المُحيطون بنا

83
00:06:24,610 --> 00:06:26,650
فغالباً ستقع مشاكل مع
عائلة شينوميا أيضاً

84
00:06:27,770 --> 00:06:30,020
!قد تكون كاغويا هنا

85
00:06:30,390 --> 00:06:31,380
!هيّا! لنذهب

86
00:06:31,380 --> 00:06:32,020
!مهلاً

87
00:06:36,520 --> 00:06:39,210
إنّه إيشيغامي فحسب

88
00:06:39,630 --> 00:06:41,160
ما الّذي يجري هنا؟

89
00:06:41,160 --> 00:06:42,750
...في الواقع

90
00:06:42,750 --> 00:06:47,700
الرّئيس وأنا بدأنا نتواعد
خلال استراحة الشّتاء

91
00:06:47,700 --> 00:06:51,170
مُحال لرجل في هذا الكون أن يخرج
مع فتاة ترتدي قبّعة قرعاء

92
00:06:51,630 --> 00:06:54,180
هذا رديء جدّاً إذا كان
يُفترض أن يكون مقلباً

93
00:06:54,440 --> 00:06:57,330
.وضع قبّعة قرعاء أو الخروج معاً
عليكما اختيار واحدة

94
00:06:57,330 --> 00:06:58,560
هذا فظيع بالفعل

95
00:06:58,860 --> 00:07:02,920
حتّى يوتيوبر لديه 1000 مُشترك
يستطيع أن يقدّم فكرة أفضل

96
00:07:04,540 --> 00:07:06,990
لن تتمكّني من خداع شينوميا هكذا

97
00:07:06,990 --> 00:07:09,200
من المؤكّد أنَّه اكتشفَ كلّ شيء
دون أن نقول كلمة

98
00:07:09,570 --> 00:07:12,940
في الواقع، يفتقر كلّ هذا لبعض
الواقعيّة إذا كان من المُفترض

99
00:07:12,940 --> 00:07:15,550
أن نُصدّق بأنّ الرّئيس اختاركِ يا فوجيوارا

100
00:07:15,550 --> 00:07:18,390
يجب أن تختاري شيئاً قابلاً أكثر للتّصديق

101
00:07:18,390 --> 00:07:20,340
كان ذلك لئيماً

102
00:07:20,340 --> 00:07:22,380
إذا كان هذا رأيك، فلا بأس

103
00:07:22,620 --> 00:07:25,570
سنقول فقط بأنّني وإيشيغامي
!نتواعد بدلاً من ذلك

104
00:07:25,570 --> 00:07:26,970
!ماذا؟! لماذا أنا؟

105
00:07:26,970 --> 00:07:29,160
!هذه عقوبة على كلّ ما قلتَه للتو

106
00:07:29,160 --> 00:07:31,470
يمكنك الاستفادة من هذا التّعذيب
!بتأمُّل تصرّفاتك

107
00:07:31,470 --> 00:07:35,220
لحظة! لماذا تكون عقوبة مُقابل
!خروجي أنا وإيشيغامي معاً؟

108
00:07:35,220 --> 00:07:38,480
الشّباب العاديّون كانوا ليبتهجوا
!إذا سنحتْ لهم هذه الفُرصة

109
00:07:38,950 --> 00:07:40,810
هل هي كاغويا هذه المرّة فعلاً؟

110
00:07:41,640 --> 00:07:43,300
!إنّها ميكو فحسب

111
00:07:43,550 --> 00:07:47,270
ميكو! هل تعلمين بأنّ إيشيغامي
لديه حبيبة الآن؟

112
00:07:47,270 --> 00:07:48,030
ماذا؟

113
00:07:49,220 --> 00:07:51,150
من تكون؟

114
00:07:51,150 --> 00:07:53,860
....في... الواقع

115
00:07:55,040 --> 00:07:56,410
!إنّها أنا

116
00:08:01,000 --> 00:08:02,920
ماذا؟ هذا سيّئ للغاية

117
00:08:03,180 --> 00:08:06,210
انسي الاعتناء بي. لا تتكلّمي
معي لبعض الوقت رجاء

118
00:08:06,210 --> 00:08:07,430
!ميكو، هذا مقلب

119
00:08:07,430 --> 00:08:08,640
!إنّه مُجرّد مقلب

120
00:08:09,640 --> 00:08:10,940
مقلب؟

121
00:08:14,960 --> 00:08:18,050
!أخفتني لوهلة حقّاً

122
00:08:18,350 --> 00:08:22,980
!بالطّبع! مُحال أن تخرجي مع إيشيغامي

123
00:08:22,980 --> 00:08:26,560
!أجل، تماماً! كوني منطقيّة

124
00:08:26,800 --> 00:08:28,830
!توقّعتُ ذلك

125
00:08:27,920 --> 00:08:29,070
...هذا غير ممكن

126
00:08:28,830 --> 00:08:34,580
مُحال أن تنجحا معاً! لا يمكن
!أن يحدث هذا

127
00:08:29,070 --> 00:08:33,310
جعل إيشيغامي يلعب دور حبيب فتاة
هو بمثابة الدّوس على لغم

128
00:08:33,310 --> 00:08:34,570
أجل

129
00:08:35,740 --> 00:08:38,830
إينو، ما الّذي سيُفاجئ شينوميا برأيكِ؟

130
00:08:40,180 --> 00:08:42,040
...دعني أُفكّر

131
00:08:42,040 --> 00:08:45,090
...لِمَ لا نتظاهر بأنّني ارتكبتُ خطأ

132
00:08:46,720 --> 00:08:50,720
ثمّ يصفعني الرّئيس شيروغاني
!صفعة قويّة

133
00:08:50,720 --> 00:08:52,340
!لكن لماذا؟

134
00:08:52,340 --> 00:08:57,720
أعتقد بأنّ شينوميا ستتفاجأ كثيراً
!إذا كنت شخصاً يضرب امرأة

135
00:08:57,720 --> 00:09:00,340
،تريدينني أن أضربكِ؟! مستحيل
!لن يحدث هذا

136
00:09:00,580 --> 00:09:02,820
...أقصد، لا أمانع ذلك

137
00:09:02,820 --> 00:09:05,850
ما رأيك ألّا نستكشف تحمّلكِ العشوائيّ
للعنف الأُسريّ؟

138
00:09:05,850 --> 00:09:09,760
أعتقد سيترتّب علينا العودة
...إلى البداية و

139
00:09:10,970 --> 00:09:13,240
أنا آسفة لتأخُّري

140
00:09:13,500 --> 00:09:15,810
!اسمعي، اسمعي، اسمعي يا كاغويا

141
00:09:15,810 --> 00:09:18,190
!هل تعلمين بأنّ الرّئيس لديه حبيبة الآن؟

142
00:09:18,190 --> 00:09:18,910
!مهلاً

143
00:09:21,210 --> 00:09:22,120
ماذا؟

144
00:09:22,880 --> 00:09:25,790
هل تعرفين من هي؟

145
00:09:25,790 --> 00:09:28,030
أجل، أعرف بالطّبع

146
00:09:28,450 --> 00:09:29,540
ماذا؟

147
00:09:41,850 --> 00:09:44,380
أنا حبيبته

148
00:09:45,370 --> 00:09:49,360
بدأتُ أنا والرّئيس نتواعد في استراحة الشّتاء

149
00:09:51,920 --> 00:09:52,980
ماذا؟

150
00:09:53,930 --> 00:09:56,940
!ماذا؟

151
00:09:56,940 --> 00:09:58,330
شينوميا...؟

152
00:09:58,330 --> 00:09:59,330
صه

153
00:09:59,330 --> 00:10:01,460
هل هذا... صحيح؟

154
00:10:01,460 --> 00:10:05,170
أجل. قبّلنا بعضنا عدّة مرّات بالفعل

155
00:10:05,170 --> 00:10:05,800
—قـ

156
00:10:08,930 --> 00:10:10,270
هل تفاجأتِ؟

157
00:10:10,270 --> 00:10:11,810
!في الواقع، أجل

158
00:10:11,810 --> 00:10:13,030
هكذا إذاً

159
00:10:18,210 --> 00:10:20,310
حسناً، هذا جيّد

160
00:10:20,620 --> 00:10:22,750
رأيتُ هذا من البداية

161
00:10:23,290 --> 00:10:25,940
يجب عليك إخفاء هذه الأشياء جيّداً

162
00:10:25,940 --> 00:10:28,270
أوه... ماذا؟

163
00:10:30,500 --> 00:10:32,440
!هكذا إذاً

164
00:10:32,710 --> 00:10:34,290
!أخفتِني فعلاً

165
00:10:34,290 --> 00:10:36,090
أنا أيضاً

166
00:10:35,980 --> 00:10:37,750
أخفتِني أنا حتّى

167
00:10:36,090 --> 00:10:37,750
أجل

168
00:10:38,160 --> 00:10:41,040
...أنا آسفة. لكن

169
00:10:49,020 --> 00:10:52,830
أردتُ التبجُّح قليلاً أمام الجميع

170
00:10:56,730 --> 00:10:58,340
...بئس الأمر

171
00:10:58,830 --> 00:11:00,600
يا صانعة المقالب

172
00:11:08,290 --> 00:11:11,410
...شكل الجميع وهم مُرتعدون آنذاك

173
00:11:11,410 --> 00:11:13,060
كان عريقاً

174
00:11:21,890 --> 00:11:25,100
على ذكر الأمر، عندما كنتُ
...قد اشتريتُ هذا الهاتف للتو

175
00:11:27,790 --> 00:11:32,070
أوّل بضعة أسابيع منذ بدء شيروغاني
...وكاغويا بالمُواعدة

176
00:11:32,460 --> 00:11:36,710
ترتّب على كاغويا إيجاد الوقت المثاليّ
للخروج خلسة من المنزل

177
00:11:37,210 --> 00:11:40,180
...لدى شيروغاني أعماله الّتي بدوام جزئيّ

178
00:11:40,180 --> 00:11:44,220
لذا لم يكونا قادرين على التصرُّف
كحبيبين كثيراً

179
00:11:45,200 --> 00:11:49,300
الأفعال الّتي تعبّر عن حبيبين
الّتي قاما بها

180
00:11:49,300 --> 00:11:53,290
هي مُحادثات لاين طويلة
في وقت متأخّر من اللّيل

181
00:11:53,290 --> 00:11:57,240
لكن... طرأ تغيير بعدها على ذلك الرّوتين

182
00:12:01,480 --> 00:12:03,360
!أوّل مُكالمة صوتيّة بينهما

183
00:12:03,360 --> 00:12:05,360
سيكون هذا أوّل عرض

184
00:12:05,360 --> 00:12:08,870
لمُكالمة صوتيّة تجريها كاغويا وشيروغاني
!منذ بدآ المُواعدة

185
00:12:08,870 --> 00:12:11,870
!لكن هناك مُشكلة واحدة فحسب

186
00:12:11,870 --> 00:12:14,380
أخته الصّغرى في غرفته

187
00:12:11,870 --> 00:12:16,870
واحد، اثنان. واحد، اثنان

188
00:12:14,380 --> 00:12:16,870
وأبوه في غرفة الجلوس

189
00:12:17,260 --> 00:12:20,870
لا يوجد ما يُدعى بالخصوصيّة في هذا المنزل

190
00:12:36,740 --> 00:12:38,440
...بعد دقيقتين

191
00:12:41,570 --> 00:12:43,400
مرحباً؟

192
00:12:44,210 --> 00:12:45,290
مرحباً

193
00:12:49,240 --> 00:12:51,710
ماذا؟ لماذا تضحكين؟

194
00:12:51,710 --> 00:12:54,440
كنتُ أقول لنفسي بأنّك أنت
حتماً يا حضرة الرّئيس

195
00:12:54,440 --> 00:12:55,830
ما معنى هذا؟

196
00:12:57,000 --> 00:13:00,490
...لا شيء

197
00:12:58,740 --> 00:13:01,810
عندما تجري مُكالمتك الصّوتيّة
،الأولى بعد بدئك بالمُواعدة

198
00:13:01,810 --> 00:13:04,760
هناك عادةً إحساس بالإثارة
غير قابل للتّفسير

199
00:13:05,580 --> 00:13:09,760
،عندما تجري كاغويا مُكالمة صوتيّة
فإنّ صوتها يصبح طفوليّاً قليلاً

200
00:13:10,430 --> 00:13:12,740
سألا بعضهما ما الّذي أكلاه في ذلك اليوم

201
00:13:12,740 --> 00:13:16,760
تحدّثا عن أصدقائهما وأشياء
مُثيرة حدثتْ مؤخّراً

202
00:13:16,760 --> 00:13:19,920
،تحدّثا عن أشياء تافهة لا معنى لها
،وفي بعض الأوقات

203
00:13:19,920 --> 00:13:24,280
تحدّثا عن رحلتهما المدرسيّة
كما لو أنّهما تذكّراها للتو

204
00:13:24,710 --> 00:13:30,570
في النّهاية، كانت كلّ هذه المواضيع
مجرّد عذر لمُتابعة المُكالمة الصّوتيّة

205
00:13:30,570 --> 00:13:32,780
كلاهما أدركا ذلك، ممّا جعل الأمر مُحرجاً

206
00:13:33,260 --> 00:13:38,100
،كاغويا-ساما، لديكِ مدرسة غداً
لذا اخلدي إلى النّوم رجاء

207
00:13:38,720 --> 00:13:40,420
أعلم

208
00:13:41,260 --> 00:13:42,420
هل كلّ شيء على ما يُرام؟

209
00:13:42,420 --> 00:13:46,180
أجل. يوجد خدمٌ من المنزل الرّئيسيّ هنا اليوم

210
00:13:46,720 --> 00:13:48,420
هل ينبغي أن نغلق إذاً؟

211
00:13:49,600 --> 00:13:51,840
لا، لا مُشكلة

212
00:13:53,360 --> 00:13:55,930
سأتابع بهدوء من فراشي

213
00:13:55,930 --> 00:13:57,930
!من فراشها؟

214
00:13:59,700 --> 00:14:01,810
...صوت حفيف فراشها

215
00:14:02,740 --> 00:14:04,750
هل أنت في غرفتك يا رئيس؟

216
00:14:04,750 --> 00:14:06,890
في الواقع... أنا خارج منزلي

217
00:14:06,890 --> 00:14:07,690
ماذا؟

218
00:14:07,690 --> 00:14:09,250
...منزلنا صغير جدّاً، لذا

219
00:14:09,250 --> 00:14:12,450
!هذا غير مُناسب! البرد قارس اللّيلة

220
00:14:14,520 --> 00:14:17,050
لا بأس، فأنا أرتدي ثياباً دافئاً

221
00:14:17,970 --> 00:14:19,700
ستُصاب بنزلة برد

222
00:14:21,130 --> 00:14:24,970
...لا أريد أن أشكّل عبئاً عليك

223
00:14:25,260 --> 00:14:26,170
لذا أرجوك

224
00:14:26,690 --> 00:14:31,160
.إنّها الواحدة صباحاً الآن
لذا هو وقت مُناسب

225
00:14:31,160 --> 00:14:34,230
وقت مُناسب على ما يبدو
لإيقاف المُكالمة

226
00:14:34,230 --> 00:14:36,980
إذاً سأذهب وأتكلّم من فراشي أيضاً

227
00:14:36,980 --> 00:14:39,730
لكن ما زال شيروغاني يريد مُتابعة المُكالمة

228
00:14:40,230 --> 00:14:42,650
أنا متأكّد بأنّني أستطيع كتم بعض
من الصّوت تحت الفراش

229
00:14:42,650 --> 00:14:43,390
ماذا؟

230
00:14:45,160 --> 00:14:47,610
فراشك؟

231
00:14:48,730 --> 00:14:51,760
لكن تضحك كاغويا بطريقة غريبة

232
00:14:54,570 --> 00:14:57,370
يا رئيس، هل أنت في فراشك؟

233
00:14:57,370 --> 00:14:58,210
أجل

234
00:14:59,060 --> 00:15:01,520
هل هذا جيّد؟ هل يصلكِ الصّوت؟

235
00:15:01,520 --> 00:15:03,230
أجل

236
00:15:04,600 --> 00:15:07,130
أعتقد كلانا في فراشنا الآن

237
00:15:07,860 --> 00:15:08,940
أجل

238
00:15:11,090 --> 00:15:13,020
بجدّية، ما تلك الضّحكة؟

239
00:15:13,020 --> 00:15:15,140
هل بدتْ غريبة؟

240
00:15:15,500 --> 00:15:17,520
بالمناسبة، كيف بدتْ؟

241
00:15:17,520 --> 00:15:18,490
...في الواقع

242
00:15:22,580 --> 00:15:24,410
لم أفعل ذلك

243
00:15:24,410 --> 00:15:25,480
ماذا؟

244
00:15:48,220 --> 00:15:50,400
،صحيح أنّ هناك الكثير من المواقع الشّهيرة

245
00:15:50,400 --> 00:15:52,550
لكن هل هناك أيّ مكان ترغبين
في الذّهاب إليه يا شينوميا؟

246
00:15:55,730 --> 00:15:56,810
شينوميا؟

247
00:16:09,930 --> 00:16:12,450
تصبحين على خير يا كاغويا

248
00:16:21,050 --> 00:16:22,200
ماذا؟

249
00:16:25,600 --> 00:16:27,300
—الحرّ شديد تحت

250
00:16:37,140 --> 00:16:38,840
هل سمعتِ ذلك؟

251
00:16:39,580 --> 00:16:41,090
بكلّ وضوح

252
00:16:41,550 --> 00:16:42,340
...المعذرة

253
00:16:43,260 --> 00:16:45,620
أعتقد هذا ليس عازلاً للصّوت في النّهاية

254
00:16:46,430 --> 00:16:49,980
كنت تتكلّم مع كاغويا، صحيح؟

255
00:16:50,780 --> 00:16:51,740
...أجل

256
00:16:51,740 --> 00:16:53,980
!كلاكما بدوتما كعاشقين، أليس كذلك؟

257
00:16:54,370 --> 00:16:55,800
!ماذا؟! أجبني

258
00:16:55,800 --> 00:16:56,870
هذا صحيح

259
00:16:56,870 --> 00:17:01,630
كاغويا من عائلة شينوميا وابني
تجمعهما تلك العلاقة

260
00:17:01,630 --> 00:17:03,260
!أبي؟

261
00:17:03,590 --> 00:17:08,580
كنتُ أعلم بالتّأكيد. طوال هذا الوقت

262
00:17:07,680 --> 00:17:10,180
!أجبني. أخبرني بالتّفاصيل

263
00:17:10,180 --> 00:17:12,250
لا، تأخّر الوقت. سنزعج الجيران

264
00:17:12,250 --> 00:17:15,470
هذا ما أردتُ قولك لك طوال الوقت
!الّذي كنتَ فيه على الهاتف

265
00:17:15,470 --> 00:17:17,160
كم السّاعة الآن برأيك؟

266
00:17:17,160 --> 00:17:18,830
ماذا؟ السّاعة 2 صباحاً؟

267
00:17:18,830 --> 00:17:22,780
إنّها 5 صباحاً! الشّمس على وشك
!الشّروق في اليابان

268
00:17:22,780 --> 00:17:23,550
...مستحيل

269
00:17:23,550 --> 00:17:25,040
أشعر بالجوع قليلاً

270
00:17:25,480 --> 00:17:27,520
سأشوي بعض الأحشاء. أتريدين؟

271
00:17:27,520 --> 00:17:28,770
!أجل

272
00:17:27,520 --> 00:17:28,770
...مستحيل

273
00:17:30,340 --> 00:17:32,710
سأسمع التّفاصيل بينما آكل

274
00:17:34,520 --> 00:17:37,210
!كاغويا! كاغويا! كاغويا

275
00:17:35,510 --> 00:17:39,300
!ناداني الرّئيس باسمي الأوّل

276
00:17:37,210 --> 00:17:43,030
!كاغويا! كاغويا! كاغويا
!كاغويا! كاغويا! كاغويا

277
00:17:40,620 --> 00:17:42,580
هل هذا حلم؟

278
00:17:44,130 --> 00:17:46,720
...مدّة مُكالمة اليوم

279
00:17:46,720 --> 00:17:49,500
خمس ساعات و 21 دقيقة

280
00:17:50,430 --> 00:17:52,580
...منزل الرّئيس القديم

281
00:17:53,070 --> 00:17:55,920
هم الثّلاثة عاشوا معاً في مكان صغير كهذا

282
00:17:56,470 --> 00:17:58,260
لكن بدا ذلك مُمتعاً للغاية

283
00:18:01,030 --> 00:18:02,930
يحمل ذلك المنزل ذكريات أيضاً

284
00:18:04,000 --> 00:18:06,080
أتساءل ما إن كان لا يزال هناك

285
00:18:08,740 --> 00:18:11,300
...ابنتي... وابني

286
00:18:11,300 --> 00:18:14,410
.لديّ أمر مهمّ لأخبركما به
اسمعا بهدوء رجاء

287
00:18:14,410 --> 00:18:16,180
لماذا تتكلّم برسميّة شديدة؟

288
00:18:16,580 --> 00:18:18,570
...أعلم بأنّ هذا مُفاجئ

289
00:18:21,080 --> 00:18:24,070
لكن يفكّر والدكما بتوفير قوت
يومه كفيتيوبر

290
00:18:24,070 --> 00:18:25,740
!لكن لماذا؟

291
00:18:25,740 --> 00:18:27,080
!الفيتيوبر هو ذلك الشّيء، صحيح؟

292
00:18:27,080 --> 00:18:29,380
مُزوِّدو البثّ الّذين يستخدمون تجسيماً
!ثلاثيّ الأبعاد للتكلُّم

293
00:18:29,380 --> 00:18:32,450
لا تحاول أن تتصرّف كشخص أغلقَ شركته
!ويفكّر في افتتاح مطعم رامن

294
00:18:32,450 --> 00:18:33,250
!أنت عجوز في الأربعينيّات من العمر

295
00:18:33,250 --> 00:18:35,720
!لا تتفوّه بهذا الهراء فجأة

296
00:18:35,720 --> 00:18:37,330
،بعد إجراء بحث في السّوق

297
00:18:37,330 --> 00:18:38,920
اكتشفتُ بصورة مُفاجئة أنّ هناك

298
00:18:38,920 --> 00:18:43,140
طلبات كبيرة على صوتي الرّقيق
الّذي يُعبّر عن رجل وسيم

299
00:18:43,140 --> 00:18:45,090
!لا أحد يريد عجوزاً

300
00:18:45,340 --> 00:18:49,760
لا، هناك المزيد من الفيتيوبر كبيري السنّ
مؤخّراً، لذا هناك طلبات

301
00:18:49,760 --> 00:18:52,720
رسمتُ التّصميم الّذي كنتُ
أُفكّر في انتهاجه

302
00:18:53,100 --> 00:18:54,190
ما رأيكما؟

303
00:18:54,190 --> 00:18:55,220
...تبدو كمحتال

304
00:18:55,220 --> 00:18:57,210
!يا للهول! أنت ماهر في الرّسم

305
00:18:57,210 --> 00:19:00,050
استخدمتُ "كليب أستوديو باينت" لتحويل هذا
إلى رسم خطّي ثمّ أضفتُ الألوان إليه

306
00:19:00,050 --> 00:19:02,580
ثمّ سأضيف مجموعة من التّشويهات
بطريقة تحريك ثنائيّ الأبعاد

307
00:19:02,580 --> 00:19:04,690
ثمّ أحرّكها باستخدام فيس-ريغ

308
00:19:04,690 --> 00:19:06,490
!أجريت بحثاً عميقاً حقّاً

309
00:19:06,490 --> 00:19:11,930
عملتُ على "أو.بي.أس" لتعديل الفيديوهات
من قبل، لذا سيكون ذلك سهلاً

310
00:19:11,930 --> 00:19:16,860
"على الأقلّ، أستطيع استخدام "في.أس.تي" في "داو
لتعديل صوتي وجعله أكثر ظرافة

311
00:19:16,860 --> 00:19:18,580
!عمّاذا تتكلّم بالضّبط؟

312
00:19:18,580 --> 00:19:21,130
رغم أنّني أفصّل لك الأمر تفصيلاً؟

313
00:19:21,420 --> 00:19:24,630
إذا اكتشفَ أصدقائي بأنّ أبي
،يؤدّي دور شخصيّة افتراضيّة

314
00:19:24,630 --> 00:19:25,940
!فلن أذهب إلى المدرسة بعد الآن

315
00:19:25,940 --> 00:19:27,640
!قطعاً لا

316
00:19:27,900 --> 00:19:30,020
فهمت. هذا مرفوض إذاً؟

317
00:19:31,300 --> 00:19:33,820
إذاً ما رأيكما بيوتيوبر عاديّ؟

318
00:19:33,820 --> 00:19:37,590
...حسناً، هذا... مقبول نوعاً ما

319
00:19:37,590 --> 00:19:39,150
لنعتمد ذلك إذاً

320
00:19:40,370 --> 00:19:43,400
،"كانت تقنيّة "الطّلب المُزيّف ثمّ الأصليّ
أليس كذلك؟

321
00:19:43,700 --> 00:19:45,350
دعيه وشأنه فحسب

322
00:19:45,350 --> 00:19:48,280
مُحال أن يكسب أي مال، لذا سيعتزل فوراً

323
00:19:48,280 --> 00:19:51,160
حدث كلّ هذا قبل بضعة أشهر

324
00:19:52,090 --> 00:19:53,240
عدتُ إلى المنزل

325
00:19:53,850 --> 00:19:57,270
إذاً فُرض عليك نفقة نتيجة طلاقك
بالإضافة إلى بعض الدّيون

326
00:19:57,270 --> 00:19:58,290
هذا قاسٍ بعض الشّيء

327
00:19:58,580 --> 00:19:59,810
ما المُشكلة؟

328
00:20:00,170 --> 00:20:02,380
هل تتظاهر بأنّك هيكاغين ثانية؟

329
00:20:02,930 --> 00:20:05,120
هل هذا أهمّ حقّاً من التّرحيب
بعودة ابنك إلى المنزل

330
00:20:05,120 --> 00:20:07,550
بعد إرهاقه نتيجة عمله بدوام جزئيّ؟

331
00:20:07,810 --> 00:20:09,810
...بعيداً عن المُزاح

332
00:20:08,050 --> 00:20:10,550
كم مُشتركاً لديك الآن على أيّ حال؟

333
00:20:10,550 --> 00:20:12,060
...غالباً لم تتجاوز حتّى المئة

334
00:20:16,070 --> 00:20:17,940
!خمسون ألفاً؟

335
00:20:17,940 --> 00:20:21,940
مؤخّراً، بات يكسب عدداً ضخماً من المُشتركين

336
00:20:22,320 --> 00:20:24,370
بصراحة، إنّه يجني مقداراً هائلاً من المال

337
00:20:24,370 --> 00:20:25,580
!هل أنتِ جادّة؟

338
00:20:25,850 --> 00:20:27,820
!مُزوِّدو البثّ

339
00:20:27,820 --> 00:20:33,010
،من أصل العدد الّذي لا يُحصى من الرّعاع
قلّة من المحظوظين يصبحون نجوماً في عالم اليوتيوب

340
00:20:33,010 --> 00:20:35,850
ليس إنجازاً سهلاً أن تتمكّن
!من التألُّق في وضع كهذا

341
00:20:35,850 --> 00:20:39,720
لكن والد شيروغاني لديه مهارات
تسويق كمالك شركة سابق

342
00:20:39,720 --> 00:20:42,610
ونوادر يستطيع مُشاركتها
من حياته المُضطربة

343
00:20:42,610 --> 00:20:45,370
وأيضاً سخّرَ مهاراته العالية
وقدراته في التّعديل

344
00:20:45,370 --> 00:20:47,570
...للرّفع بشكل مُتكرّر بسبب بطالته

345
00:20:47,570 --> 00:20:52,230
ونجحتْ قناته بطريقة ما في التحوّل
!إلى مصدر دخل

346
00:20:52,590 --> 00:20:54,170
كم كسب تقريباً؟

347
00:20:54,170 --> 00:20:56,080
كسب مليون ين فقط في هذا الشّهر

348
00:20:56,080 --> 00:20:57,100
!ماذا؟

349
00:20:57,390 --> 00:20:59,500
حسناً، أراكم ثانية غداً

350
00:21:01,920 --> 00:21:03,610
!أحسنت صنعاً يا أبي

351
00:21:04,020 --> 00:21:05,830
!ألست مُرهَقاً يا أبي؟

352
00:21:05,830 --> 00:21:06,860
!أبي

353
00:21:08,620 --> 00:21:12,970
ولدايّ يُناديانني بـ"أبي" للمرّة
...الأولى منذ سنوات

354
00:21:18,070 --> 00:21:19,310
مرحباً

355
00:21:19,310 --> 00:21:22,670
هنا السّيّد أبيض، الغارق في دَين
قدره 500 مليون

356
00:21:22,670 --> 00:21:25,730
سأبثّ على الهواء من مطبخي
من جديد اليوم

357
00:21:25,730 --> 00:21:30,330
حسناً، لنطمح لتسديد ذلك الدَّين
بينما أُجيب عن أسئلتكم

358
00:21:30,330 --> 00:21:33,380
"ماذا؟ "لأجور تدريس أطفالك
شكراً على المُحادثة المُموِّلة الحمراء

359
00:21:33,990 --> 00:21:36,580
المُحادثة الحمراء تُساوي 10،000 ين، صحيح؟

360
00:21:35,360 --> 00:21:40,390
حسناً... لنبدأ مع موساشينو لونلون

361
00:21:40,390 --> 00:21:44,170
"تهانينا على الـ 50،000 مُشترك"
شكراً على المُحادثة المُموِّلة الحمراء

362
00:21:45,770 --> 00:21:48,410
أنت... راقب هذا

363
00:21:49,790 --> 00:21:52,400
أجل، العقارات قد تكون محفوفة بالمخاطر

364
00:21:52,400 --> 00:21:54,530
...سيختلف الأمر إذا

365
00:21:54,530 --> 00:21:57,280
في العادة... شيء ما يدور؟

366
00:21:59,760 --> 00:22:03,530
"هديّة خطوبة" "ظريفة"

367
00:22:04,140 --> 00:22:06,690
"هل يمكنني الحصول على ابنتك؟"

368
00:22:06,690 --> 00:22:09,510
،كلّما مررتُ من أمام الكاميرا

369
00:22:09,510 --> 00:22:12,310
...يبدأ الجميع بالتبرُّع بـ 10،000 لسبب ما

370
00:22:13,210 --> 00:22:15,540
...أعلم بأنّ هذا خاطئ

371
00:22:15,540 --> 00:22:19,180
...لكن فعلتُها عمداً بضع مرّات إلى الآن

372
00:22:19,710 --> 00:22:22,850
!مبادئ أختي الصّغرى الأخلاقيّة تتلوّث

373
00:22:20,280 --> 00:22:23,690
هذا سيّئ... سيّئ حقّاً

374
00:22:23,690 --> 00:22:27,890
...انظر يا أخي. الجميع يقولون بأنّني ظريفة

375
00:22:29,400 --> 00:22:32,480
...ربّما سأفتتح صالة عرض أيضاً

376
00:22:32,480 --> 00:22:35,200
!على هذا المُعدّل، ستنحرف عن طريقها

377
00:22:35,200 --> 00:22:37,290
!لكن لا أستطيع إيقافها

378
00:22:37,290 --> 00:22:39,470
!ماذا يُفترض بي أن أفعل؟

379
00:22:39,470 --> 00:22:42,970
ماذا؟ هذا سؤال من فتاة في الثّانويّة

380
00:22:43,280 --> 00:22:45,090
أنا تلميذة سنة ثالثة في الثّانويّة"

381
00:22:45,090 --> 00:22:48,200
"...مؤخّراً، صرتُ أخرج مع فتى سنة أولى

382
00:22:50,360 --> 00:22:51,930
مُحتوى إضافيّ

383
00:22:59,360 --> 00:23:00,610
يا شباب

384
00:23:00,610 --> 00:23:02,880
ينبغي أن تكونوا حريصين أكثر على أموالكم

385
00:23:02,880 --> 00:23:05,330
هل أنتم أثرياء إلى هذا الحدّ؟

386
00:23:05,790 --> 00:23:07,260
...لا، بجدّية

387
00:23:07,260 --> 00:23:09,100
كفّوا عن إغداقي بالمال، اتّفقنا؟

388
00:23:09,560 --> 00:23:11,810
!أنتم لا تفهمون إطلاقاً

389
00:23:11,810 --> 00:23:14,250
!بجدّية... لا

390
00:23:14,250 --> 00:23:16,730
!توقّفوا فحسب أرجوكم

391
00:23:19,200 --> 00:23:20,820
...مهلاً

392
00:23:19,960 --> 00:23:23,890
تجاوز إجمالي المُحادثات المُموِّلة الـ 800،000 ين

393
00:23:26,380 --> 00:23:30,380
لعلّي كنتُ أكثر من تفاجأ عندما سمعتُ بذلك

394
00:23:31,890 --> 00:23:37,400
لا أصدّق بأنّ ذلك الأب النّزويّ غريب الأطوار
...يُحقّق نجاحاً باهراً كمُزوّد بثّ

395
00:23:39,180 --> 00:23:44,200
لكن بسبب ذلك، تمكّن الرّئيس من ادّخار
ما يكفي للانتقال إلى شقّة جيّدة

396
00:23:45,400 --> 00:23:48,370
ليس ذلك فحسب، تمكّنوا من تسديد ديونهم

397
00:23:50,890 --> 00:23:55,770
...عندما أخذني إلى شقّته الجديدة، أعتقد