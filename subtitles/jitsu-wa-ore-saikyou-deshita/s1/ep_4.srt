1
00:00:01,190 --> 00:00:03,090
!أخي

2
00:00:03,350 --> 00:00:05,820
!وجدت بعض الأشخاص المشبوهين

3
00:00:06,380 --> 00:00:10,580
.شار مفتونة بهذه الدوريات

4
00:00:10,580 --> 00:00:12,720
.ولذلك السبب أن مشغول للغاية

5
00:00:12,720 --> 00:00:14,270
!سيدي

6
00:00:14,270 --> 00:00:17,540
،أخبرتني الآنسة الصغيرة أنّك كنت تخرج بمفردك

7
00:00:17,540 --> 00:00:18,820
!لذا عدت بسرعة

8
00:00:18,820 --> 00:00:21,800
!دعني أنضم إليك في هذه المهام رجاءً

9
00:00:22,070 --> 00:00:23,910
!فلاي، شكرًا لك على علمك

10
00:00:23,910 --> 00:00:25,990
.عادت كي تجعل الأمر مزعجًا للغاية

11
00:00:26,340 --> 00:00:28,460
.ظننت مشغولة للغاية

12
00:00:28,460 --> 00:00:30,010
!لا مشكلة

13
00:00:30,010 --> 00:00:34,940
!أكملت كل أعمال الفناء ومهام إخضاع الوحوش خاصتي لليوم

14
00:00:34,940 --> 00:00:37,850
.أكملت كل شيء طلبته منها

15
00:00:37,850 --> 00:00:39,300
!هل يعقل؟

16
00:00:39,300 --> 00:00:41,900
!هل ستوحدين قواك معه يا فلاي؟

17
00:00:43,630 --> 00:00:48,330
.في كلّ قصة، عندما يكون البطل في ورطة، يأتي شريكه لإنقاذه

18
00:00:48,660 --> 00:00:51,450
!وذلك الشريك كان فلاي طوال الوقت

19
00:00:51,710 --> 00:00:53,160
!تمامًا

20
00:00:53,160 --> 00:00:55,030
،قد لا أكون بمستوى سيدي

21
00:00:55,030 --> 00:00:58,950
!لكن الجميع يعرفون أني ما زلت أستطيع المساعدة

22
00:00:58,950 --> 00:01:00,360
!لا تسايريها

23
00:01:00,570 --> 00:01:01,740
!أخي

24
00:01:01,740 --> 00:01:02,930
!سيدي

25
00:01:04,010 --> 00:01:05,660
!يا للإزعاج

26
00:01:07,340 --> 00:01:08,970
.اسمي يا فلي

27
00:01:08,970 --> 00:01:12,010
.لا أريد أيّ عنف وشار تشاهد

28
00:01:12,010 --> 00:01:12,920
مفهوم؟

29
00:01:12,920 --> 00:01:13,720
!أجل

30
00:01:13,720 --> 00:01:14,970
!أنا أعني ما أقول

31
00:01:14,970 --> 00:01:15,990
!مفهوم

32
00:01:20,270 --> 00:01:23,160
!انظروا إلى هذا الصيد الوفير

33
00:01:23,160 --> 00:01:26,630
!سنأكل طعامًا حقيقيًّا لبعض الوقت

34
00:01:26,630 --> 00:01:27,710
!أنتم

35
00:01:27,710 --> 00:01:29,360
!ما الذي تفعلونه؟

36
00:01:29,360 --> 00:01:31,410
!مـ-من هناك؟

37
00:01:33,730 --> 00:01:37,080
...يدعونني أظلم من الظلام

38
00:01:37,690 --> 00:01:40,480
!لقد وصل الفارس الأسود

39
00:01:41,990 --> 00:01:44,080
!الـ-الفارس الأسود؟

40
00:01:44,820 --> 00:01:47,540
...يدعونني أكثر احمرارًا من الحمرة

41
00:01:48,030 --> 00:01:51,250
!أنا الفارسة القرمزية

42
00:01:51,570 --> 00:01:53,460
!فينرير اللهب

43
00:01:54,040 --> 00:01:56,630
!مـ-من أنتما بالضبط؟

44
00:01:56,630 --> 00:02:00,980
!أنا على وشك تحويلكم جميعًا إلى رماد

45
00:02:00,980 --> 00:02:02,140
!خذوا هذه

46
00:02:02,140 --> 00:02:03,190
!مهلًا

47
00:02:03,190 --> 00:02:04,810
!هل كنت تستمعين لما قلته سابقًا؟

48
00:02:04,810 --> 00:02:07,410
!ساخن، ساخن، ساخن

49
00:02:07,410 --> 00:02:09,690
!مهلًا! سيحترقون

50
00:02:09,690 --> 00:02:11,400
!فلاي! اهدئي

51
00:02:12,810 --> 00:02:14,400
!احترقوا

52
00:02:14,400 --> 00:02:15,570
!اهدئي

53
00:02:21,840 --> 00:02:23,660
!لا ينجح الأمر؟

54
00:02:23,660 --> 00:02:26,700
!ماذا عن هذا إذًا؟

55
00:02:27,450 --> 00:02:29,160
!اهدئي

56
00:02:29,510 --> 00:02:32,590
!ألم أقل لك أني لا أريد عنفًا؟

57
00:02:32,900 --> 00:02:38,480
!أعلم، لكن أي أحد يعترض طريق سيدي هو عدوي

58
00:02:38,480 --> 00:02:40,220
!إنّها لا تفهم إطلاقًا

59
00:02:41,970 --> 00:02:44,310
!سئمت من هذه الغبية

60
00:02:44,590 --> 00:02:45,820
.اهدئي، اهدئي

61
00:02:47,030 --> 00:02:48,580
.فعلت ما يكفي

62
00:02:48,580 --> 00:02:50,500
.سأوجه الضربة القاضية

63
00:02:50,500 --> 00:02:51,530
!هل يمكنك العودة أوّلًا

64
00:02:51,880 --> 00:02:54,640
.فهمت. كما هو متوقع من سيدي

65
00:02:55,170 --> 00:02:57,100
.سأبقى حتى إنهاء الأمر

66
00:02:57,330 --> 00:02:58,210
.غادري

67
00:03:04,530 --> 00:03:07,960
!أخي وفلاي، كنتما رائعين

68
00:03:09,010 --> 00:03:11,910
!كان ذلك وكأني أشاهد روتين مانزاي

69
00:03:11,910 --> 00:03:13,670
!ماذا؟ مانزاي؟

70
00:03:14,030 --> 00:03:18,240
...لكني... كنت أهاجم بكل قوتي

71
00:03:18,240 --> 00:03:22,370
.لكن شيئًا ما اعترض طريقي، لذا لم أستطع المساعدة

72
00:03:22,720 --> 00:03:25,050
!لكن في المرة القادمة بالتأكيد

73
00:03:25,050 --> 00:03:27,260
.لا تكون هناك مرة قادمة أصلًا

74
00:03:27,590 --> 00:03:31,290
!لا يسعني الانتظار لرؤية مانزاي خاصتكما

75
00:03:31,290 --> 00:03:32,560
!مهلًا، ذلك الجزء؟

76
00:03:33,670 --> 00:03:36,210
رؤية شار سعيدة لتلك الدرجة

77
00:03:36,210 --> 00:03:38,150
!تجعلني أرغب في مواصلة العمل مع فلاي

78
00:03:38,150 --> 00:03:39,770
!مستحيل! لن يحدث ذلك

79
00:03:40,040 --> 00:03:43,180
!فلاي، وضعيتك النهائية يجب أن تكون هكذا

80
00:03:43,180 --> 00:03:44,370
هكذا؟

81
00:03:46,260 --> 00:03:50,860
متى سأتمكن من عيش حياة هادئة كمنعزل؟

82
00:05:23,170 --> 00:05:24,590
!تبًّا

83
00:05:24,590 --> 00:05:25,930
!كيف انتهى الأمر هكذا؟

84
00:05:26,270 --> 00:05:27,900
!أنا الأمير

85
00:05:27,900 --> 00:05:31,100
!ابن أميرة الوميض، وريث العرش

86
00:05:31,100 --> 00:05:33,560
...كنت سأحرص على فهمه لذلك

87
00:05:34,210 --> 00:05:38,090
!ظننت أنه يفترض أن يكون عديم نفع من المستوى 2

88
00:05:39,770 --> 00:05:42,430
.أستأذن يا سمو الأمير

89
00:05:42,430 --> 00:05:43,500
.يمكنك الدخول

90
00:05:45,480 --> 00:05:47,950
.اقترب وقت الوليمة

91
00:05:51,100 --> 00:05:55,710
.بالنسبة لجولة الغد، اطلب من شارلوت-ساما الانضمام لك رجاءً

92
00:05:55,710 --> 00:05:58,260
ماذا؟ لمَ تلك الصغيرة التافهة؟

93
00:05:58,650 --> 00:06:01,200
.ظننت لأنّك قد تستمتع برفقتها

94
00:06:01,970 --> 00:06:04,050
!لا حاجة لذلك

95
00:06:04,050 --> 00:06:05,010
.سمو الأمير

96
00:06:05,860 --> 00:06:09,530
.هذا لمصلحة سموك

97
00:06:09,530 --> 00:06:11,580
.افعل ما أقوله رجاءً

98
00:06:14,380 --> 00:06:15,650
.حسنًا إذًا

99
00:06:19,130 --> 00:06:22,490
!أخي، انتهت الوليمة

100
00:06:23,880 --> 00:06:26,910
!آسفة، نسيت أن أقرع الباب

101
00:06:27,360 --> 00:06:29,090
.هذا صحيح

102
00:06:30,250 --> 00:06:34,950
.الطعام فاخر كما تصورت

103
00:06:35,750 --> 00:06:36,950
ماذا؟

104
00:06:37,400 --> 00:06:41,130
.لديك الجرأة على إرسالي إلى تلك الوليمة

105
00:06:41,490 --> 00:06:45,830
نحن نفس الشخص، لذلك لا بدّ أنّك
.تعرف كم كان ذلك تعيسًا لي

106
00:06:45,830 --> 00:06:48,210
.أجل، ما كنت لأتمكن من تحمل ذلك

107
00:06:48,570 --> 00:06:50,670
!لقد سئمت من كل شيء

108
00:06:51,030 --> 00:06:53,590
!أُرغَم على فعل كل الأشياء التي لا تريد فعلها

109
00:06:53,590 --> 00:06:56,110
!ما الذي أعنيه لك بالضبط؟

110
00:06:59,640 --> 00:07:03,150
هل أخي الآخر بخير؟

111
00:07:03,580 --> 00:07:06,810
...على الأقل سأكون موجودة في الجولة غدًا

112
00:07:07,070 --> 00:07:08,930
ماذا؟ لمَ ستذهبين يا شار؟

113
00:07:08,930 --> 00:07:11,420
.دعاني الأمير للتو

114
00:07:13,050 --> 00:07:15,690
مهلًا، هل يحب الفتيات الصغيرات؟

115
00:07:19,880 --> 00:07:22,810
.حسنًا، سأذهب على ما أظنّ

116
00:07:27,250 --> 00:07:31,030
.إن كانت شار ذاهبة، فعليّ التأكد من كل شيء

117
00:07:31,030 --> 00:07:33,250
.لنتحقق من طريق الجولة

118
00:07:39,330 --> 00:07:40,840
من هؤلاء؟

119
00:07:41,530 --> 00:07:44,390
.يبدو أنّهم يستدعون شيئًا ما

120
00:07:45,530 --> 00:07:47,830
.أظنني سأذهب وألقي نظرة

121
00:07:55,350 --> 00:07:57,490
...المعذرة

122
00:07:57,490 --> 00:07:59,780
ما الذي تفعلونه هنا؟

123
00:08:00,700 --> 00:08:02,580
!مـ-من أنت؟

124
00:08:02,580 --> 00:08:05,120
.كنت مارًّا من هنا فحسب

125
00:08:05,120 --> 00:08:08,740
...هلّا تحصلون على الموافقة من المرغريف غولد زينفيس

126
00:08:08,740 --> 00:08:10,020
!أيها الوغد

127
00:08:10,020 --> 00:08:11,850
!هل أنت أجد رجال المرغريف؟

128
00:08:11,850 --> 00:08:13,210
!تخلصوا منه

129
00:08:13,210 --> 00:08:15,020
!لا تدعوه يهرب

130
00:08:16,410 --> 00:08:17,720
هكذا إذًا؟

131
00:08:18,400 --> 00:08:22,570
!في هذه الحالة لن أرحمكم أنا أيضًا

132
00:08:28,510 --> 00:08:32,870
...لا يمكنني أن نسمح بأن نُهزَم هنا

133
00:08:33,190 --> 00:08:36,150
!تعالوا أيها الهياكل الفرسان

134
00:08:38,770 --> 00:08:41,740
.مذهل! هذه أول مرة أرى فيها جنودًا هياكل

135
00:08:42,160 --> 00:08:45,710
إنهم رائعون في ألعاب الفيديو، لكنّهم
.مخيفون نوعًا ما في الحياة الواقعية

136
00:08:45,710 --> 00:08:48,060
!اهزموه

137
00:08:57,540 --> 00:08:59,760
.توقعت ذلك

138
00:08:59,760 --> 00:09:01,100
!تابعوا

139
00:09:01,100 --> 00:09:02,940
!قيّدوا تحركاته

140
00:09:12,090 --> 00:09:14,930
.سيطول هذا كثيرًا

141
00:09:15,940 --> 00:09:20,360
...مهلًا، تلك الأشياء الحمراء على صدورهم

142
00:09:20,670 --> 00:09:22,300
!مرة أخرى

143
00:09:23,210 --> 00:09:24,630
ما الخطب؟

144
00:09:24,630 --> 00:09:26,520
!ماذا تفعلون؟

145
00:09:34,350 --> 00:09:36,560
!ماذا حدث لهم؟

146
00:09:36,560 --> 00:09:38,470
!لم يبق لدي خيار

147
00:09:38,470 --> 00:09:40,870
!تعال أيها الغولم

148
00:09:48,510 --> 00:09:49,610
!مذهل

149
00:09:49,610 --> 00:09:51,600
!غولم حقيقي! قويّ جدًّا

150
00:09:51,600 --> 00:09:53,440
!ضرباته قوية حقًّا

151
00:10:01,330 --> 00:10:03,650
!أجل! الأمر ينجح

152
00:10:03,650 --> 00:10:05,850
!اسحقه

153
00:10:05,850 --> 00:10:08,000
.كما هو متوقع من غولم

154
00:10:08,000 --> 00:10:10,260
.كان دفاعي ضعيفًا قليلًا

155
00:10:10,850 --> 00:10:12,000
...حسنًا إذًا

156
00:10:12,000 --> 00:10:13,910
كيف أهتمّ بأمره؟

157
00:10:16,670 --> 00:10:20,910
.بعد إمعان النظر، هناك شيء ما في صدر الغولم أيضًا

158
00:10:40,070 --> 00:10:41,230
!ماذا؟

159
00:10:41,230 --> 00:10:43,280
!توقف عن الحركة فجأة

160
00:10:43,580 --> 00:10:44,920
!تحرك

161
00:10:44,920 --> 00:10:46,560
!قلت تحرك

162
00:10:54,790 --> 00:10:57,560
!لمَ يهاجمنا فجأة؟

163
00:10:57,560 --> 00:10:58,960
.أنا آسف

164
00:10:58,960 --> 00:11:00,490
.إنها غلطتي على الأرجح

165
00:11:00,490 --> 00:11:01,520
!ماذا؟

166
00:11:01,520 --> 00:11:06,080
،كنت أحاول إيقافه، لذا طعنته بحاجز على شكل وتد

167
00:11:06,080 --> 00:11:08,810
.لكن يبدو أني غيرته كي يستعمل صيغتي السحرية

168
00:11:08,810 --> 00:11:12,350
!ماذا؟! غيرت صيغته السحرية؟

169
00:11:12,350 --> 00:11:14,740
...هذا ما حدث حقًّا، لذا

170
00:11:15,190 --> 00:11:17,290
.المعذرة

171
00:11:17,290 --> 00:11:19,900
من منكم القائد هنا؟

172
00:11:27,560 --> 00:11:30,480
.أخبرني باسمك وانتمائك رجاءً

173
00:11:33,220 --> 00:11:34,670
لمَ أتيتم إلى هنا؟

174
00:11:37,290 --> 00:11:40,550
مهلًا، هل تجاوزت حدودي؟

175
00:11:40,550 --> 00:11:42,560
.لا أجيد التحدث إلى الناس

176
00:11:43,630 --> 00:11:46,720
...ما العمل

177
00:11:46,720 --> 00:11:47,630
.حسنًا إذًا

178
00:11:54,000 --> 00:11:56,770
!الـ-النجدة

179
00:11:57,060 --> 00:11:58,620
!أيها القائد

180
00:11:58,620 --> 00:12:03,060
.إما أن تُدفن هكذا، أو تخبرني بالحقيقة

181
00:11:59,970 --> 00:12:01,710
!ساعدنا

182
00:12:02,360 --> 00:12:04,090
!توقف

183
00:12:03,060 --> 00:12:04,580
.اختر

184
00:12:04,580 --> 00:12:06,900
!أيها القائد

185
00:12:06,900 --> 00:12:09,810
!لا تدفنّا

186
00:12:09,810 --> 00:12:15,220
!أ-أنا من وحدة استدعاء عقيلة الملك الشخصية

187
00:12:15,580 --> 00:12:18,500
،كما نقوم باستعدادات

188
00:12:18,500 --> 00:12:22,870
!كي نهاجم فرقة جولة المزارع غدًا بوحوش مُستدعاة

189
00:12:23,290 --> 00:12:24,510
عقيلة الملك؟

190
00:12:24,510 --> 00:12:26,160
عقيلة مملكتنا؟

191
00:12:26,770 --> 00:12:27,550
لماذا؟

192
00:12:29,970 --> 00:12:31,600
ما هو هدفكم؟

193
00:12:32,040 --> 00:12:34,450
...هـ-هدفنا

194
00:12:34,450 --> 00:12:37,970
!هو اغتيال شارلوت زينفيس

195
00:12:38,470 --> 00:12:39,580
ماذا؟

196
00:12:42,030 --> 00:12:44,270
...لم قد تستهدف عقيلة الملك

197
00:12:44,270 --> 00:12:46,400
حياة شارلوت؟

198
00:12:46,680 --> 00:12:50,750
...ستتجاوز قدرتها السحرية حتّى عقيلة الملك يومًا ما

199
00:12:50,750 --> 00:12:53,910
،هناك مخافة من انقسام المملكة نصفين في النهاية

200
00:12:53,910 --> 00:12:56,740
.إن حصلت على دعم المرغريف

201
00:12:56,740 --> 00:13:01,940
،استعملنا سابقًا جنودًا إمبراطوريين، لكنهم فشلوا مرتين

202
00:13:01,940 --> 00:13:05,210
.لذلك السبب أرسلتنا عقيلة الملك نحن وحدتها الشخصية

203
00:13:06,680 --> 00:13:08,060
.مهلًا لحظة

204
00:13:08,700 --> 00:13:12,300
،استعمال الجنود الإمبراطوريين لمهاجمة أبي

205
00:13:13,000 --> 00:13:15,510
...وكذلك محاولة اغتيال أمي وشار

206
00:13:15,980 --> 00:13:19,240
!كان كلّ ذلك من فعل تلك المرأة؟

207
00:13:21,570 --> 00:13:23,780
.فهمت الآن

208
00:13:24,750 --> 00:13:28,880
حدث نفس الشيء عندما تخلت عني، أليس كذلك؟

209
00:13:29,300 --> 00:13:34,090
.ستلجأ تلك المرأة لأي شيء لحماية مكانتها

210
00:13:36,510 --> 00:13:38,190
.ستدفع ثمن هذا

211
00:13:48,740 --> 00:13:49,790
.توقف

212
00:13:53,140 --> 00:13:56,190
.كدت أسمح له بالهيجان

213
00:13:58,030 --> 00:14:02,670
.لن أعد أحدًا يسلبني من أحبّ

214
00:14:04,060 --> 00:14:07,410
.حتى وإن كان ذلك الشخص أمي التي أنجبتني

215
00:14:09,470 --> 00:14:11,200
...حسنًا إذًا

216
00:14:12,380 --> 00:14:14,160
كيف أتعامل معها؟

217
00:14:32,060 --> 00:14:37,550
.لاياس-ساما، لا تحزن على خسارتك أمام أخي

218
00:14:37,550 --> 00:14:40,260
!لأنّك لم تملك فرصة من الأساس

219
00:14:41,100 --> 00:14:45,200
!في الحقيقة، عليك أن تفخر لأنّك تحديته في مبارزة أصلًا

220
00:14:46,140 --> 00:14:47,580
.هذا صحيح

221
00:14:47,580 --> 00:14:49,860
.وأيضًا لا يوحد عيب في الخسارة

222
00:14:51,490 --> 00:14:53,650
.أنتما، توقفا هنا

223
00:14:53,650 --> 00:14:56,250
!أنت آخر شخص أريد شفقة منه

224
00:14:56,250 --> 00:15:00,290
!وأيضًا، لم تستعمل أيّ سحر حينها

225
00:15:00,290 --> 00:15:02,090
!ما الذي فعلته بالضبط؟

226
00:15:02,090 --> 00:15:06,620
.يمكنني تطبيق تعزيز الذات إن قلت لنفسي، "كن قويًّا!" مثلًا

227
00:15:08,640 --> 00:15:10,390
!هل أنت جاد؟

228
00:15:08,640 --> 00:15:10,390
!حقًّا؟

229
00:15:10,390 --> 00:15:12,460
.ماذا؟ هذا غريب

230
00:15:12,460 --> 00:15:15,700
...لم يتفاجأ والداي عندما شرحت لهما الأمر هكذا

231
00:15:15,700 --> 00:15:17,810
!كما هو متوقف من أخي

232
00:15:19,200 --> 00:15:22,890
مهلًا، هل أنت شيطان مُرتَجَع؟

233
00:15:22,890 --> 00:15:23,700
!لاياس

234
00:15:24,070 --> 00:15:27,640
!لكن الأمر غير منقطي إن لم نفكر في ذلك

235
00:15:28,030 --> 00:15:29,860
ما هو الشيطان المُرتَجَع؟

236
00:15:29,860 --> 00:15:32,540
،عندما يتزوج شيطان من إنسان

237
00:15:32,540 --> 00:15:35,990
يمكن لسلاستهم إظهار بعض
.السمات الشيطانية في حالات نادرة

238
00:15:36,270 --> 00:15:40,870
،صحيح أن الشياطين المرتجعة تظهر قدرات جسدية استثنائية

239
00:15:40,870 --> 00:15:43,960
.وكذلك مخزونًا كبيرًا من المانا

240
00:15:44,720 --> 00:15:46,540
.لكني لا أرى أيّ قرون

241
00:15:46,540 --> 00:15:49,500
...وأذناه وعيناه تبدو عادية، لذا لا أظن

242
00:15:49,500 --> 00:15:53,170
.بشرة أخي ناعمة ولامعة

243
00:15:53,170 --> 00:15:53,740
ماذا؟

244
00:15:54,150 --> 00:15:58,550
!أقول هذا بصفتي شخصًا استحم معه، لذا لا شك في ذلك

245
00:15:58,550 --> 00:15:59,530
!ماذا؟

246
00:16:00,910 --> 00:16:04,060
!تـ-تـ-تستحم مع أختك؟

247
00:16:04,060 --> 00:16:06,150
!هـ-هـ-هذا عار

248
00:16:06,150 --> 00:16:09,560
!لعلمكما فقط، لم تكن فكرتي

249
00:16:09,930 --> 00:16:12,160
هل من خطب في ذلك؟

250
00:16:12,160 --> 00:16:15,070
...ماذا؟ ما كنت لأصل لذلك الحدّ

251
00:16:15,070 --> 00:16:17,490
...الأمر فقط أنّ لا أحد يفعل ذلك

252
00:16:18,670 --> 00:16:24,790
و-وأيضًا، الأمر مميز عندما يكون
...الرجل والمرأة عاريين أمام بعضهما

253
00:16:25,060 --> 00:16:30,380
...فعل نبيل للتناسل

254
00:16:27,610 --> 00:16:30,380
!مهلًا، هدئي يا أختي

255
00:16:32,580 --> 00:16:33,830
.يبدو أننا وصلنا

256
00:16:41,710 --> 00:16:43,640
.يا له من حقل قمح رائع

257
00:16:45,520 --> 00:16:48,110
.لم أر حقل قمح من قبل

258
00:16:48,110 --> 00:16:50,180
.اليابان مليئة بحقول الأرز

259
00:16:50,180 --> 00:16:51,480
!هذا رائع

260
00:16:51,480 --> 00:16:54,100
!عشب كثير ينمو في الحقل

261
00:16:54,100 --> 00:16:57,210
!لنذهب ونلق نظرة عن قرب يا ماريان

262
00:16:57,210 --> 00:16:59,420
!شارلوت-تشان

263
00:16:59,420 --> 00:17:01,400
!من الخطر الركض هكذا

264
00:17:15,220 --> 00:17:17,220
أبي، هل لي بلحظة؟

265
00:17:17,650 --> 00:17:19,390
ما الأمر يا هاروتو؟

266
00:17:19,390 --> 00:17:22,300
.لدي بعض الأسئلة فقط

267
00:17:28,490 --> 00:17:31,700
.من النادر أن تأتي إليّ

268
00:17:31,700 --> 00:17:34,200
.لا بدّ أنّه شيء مهم

269
00:17:35,250 --> 00:17:38,930
.في الحقيقة... هذه فرضية فحسب

270
00:17:40,040 --> 00:17:44,000
ماذا ستفعل إن كانت عقيلة الملك تستهدف حياة شار؟

271
00:17:45,630 --> 00:17:49,460
.آسف على طرح سؤال غريب كهذا

272
00:17:49,460 --> 00:17:53,600
.لا، يبدو أنّك تشعر بحدوث شيء ما

273
00:17:54,170 --> 00:17:58,070
.توصلت بالأمس برسالة أخرة من الفارس الأسود

274
00:17:58,550 --> 00:18:00,750
،عندما اتبعت تعليماته

275
00:18:00,750 --> 00:18:03,690
.وجت سحرة عقيلة الملك المختارين فاقدين للوعي

276
00:18:04,030 --> 00:18:10,640
...عرفت أنّها اعتبرتني عدوًّا، لكن لم أتوقع أن تستهدف شارلوت

277
00:18:10,940 --> 00:18:14,540
.هدف تلك المرأة هو إبادتنا تمامًا

278
00:18:14,540 --> 00:18:16,450
.لكنها عقيلة الملك

279
00:18:16,450 --> 00:18:18,750
.لا يمكننا الانتقام

280
00:18:19,280 --> 00:18:23,720
.أتمنى أن تختفي ملكة قاسية مثلها

281
00:18:27,510 --> 00:18:29,680
.احذر مما تتمناه

282
00:18:30,170 --> 00:18:34,420
.الواقع هو أنّ العاصمة الملكية ستكون في فوضى دونها

283
00:18:34,420 --> 00:18:36,360
لماذا؟

284
00:18:37,320 --> 00:18:43,040
.إنّها قصة حزينة، لكن الملك جيلك فقط السلطة قبل مدة

285
00:18:43,720 --> 00:18:47,710
.هناك الكثير من النبلاء الذين سيحاولون سرقة العرش

286
00:18:47,710 --> 00:18:52,410
.هم تحت السيطرة الآن بسبب سيادة عقيلة الملك

287
00:18:53,140 --> 00:18:57,730
.ما يعني أنّ موتها سيشعل حربًا أهلية

288
00:18:58,170 --> 00:19:00,040
...قبل سنتين من ولادتك

289
00:19:00,710 --> 00:19:05,330
.شُكّل جيش بقيادة الملك لهزيمة ملك الشياطين

290
00:19:05,330 --> 00:19:07,540
.كانت غيزيلوت بينهم

291
00:19:07,950 --> 00:19:12,150
.قطعت رأس ملك الشياطين بمفردها

292
00:19:12,810 --> 00:19:17,710
.اعتُبرت غيزيلوت بطلة وأصبحت تُعرف بأميرة الوميض

293
00:19:18,110 --> 00:19:23,760
بعد ذلك تزوجت من الملك بدعم قوي من المواطنين

294
00:19:23,760 --> 00:19:26,310
.وزادت شعبيتها أكثر

295
00:19:26,860 --> 00:19:31,670
.والآن تحاول أميرة الوميض الاستحواذ على المملكة

296
00:19:33,600 --> 00:19:36,190
.لم أعلم أنّها ذات تأثير لهذه الدرجة

297
00:19:36,630 --> 00:19:40,140
،لم أرد أيّ شيء يجمعني بوالديّ، لذا لم أبحث في شيء

298
00:19:40,140 --> 00:19:41,560
.لكنّ ذلك كان خطأ

299
00:19:41,860 --> 00:19:45,640
،لكن إن ظهر شخص قويّ لاستبدال عقيلة الملك

300
00:19:45,640 --> 00:19:47,300
.فستكون مسألة أخرى

301
00:19:47,670 --> 00:19:50,820
في تلك الحالة، لمَ لا تصبح الملك يا أبي؟

302
00:19:51,210 --> 00:19:53,820
.لا أعرف شيئًا عن السياسة

303
00:19:53,820 --> 00:19:55,670
.لن أكون مناسبًا لذلك

304
00:19:56,840 --> 00:19:59,200
...لكن

305
00:20:00,060 --> 00:20:03,910
.هنا شخص واحد، لكنّها لا تزال صغيرة في السن

306
00:20:03,910 --> 00:20:06,320
.أريد الانتظار إلى أن تصبح بالغة على الأقل

307
00:20:07,450 --> 00:20:08,820
.إنّها فتاة ذكيّة

308
00:20:08,820 --> 00:20:12,600
.أنا واثق أنّها ستصبح استثنائية ما يكفي لقيادة المملكة يومًا ما

309
00:20:13,110 --> 00:20:14,930
!تقصد شارلوت؟

310
00:20:15,430 --> 00:20:18,010
.وفوق ذلك، لديه قدرات لا يمكن فهمها

311
00:20:18,010 --> 00:20:20,750
،لا أعرف أنّها تعلم ذلك

312
00:20:20,750 --> 00:20:24,040
.لكني أظنها ستتجاوز أميرة الوميض في القوة السحرية بسهولة

313
00:20:24,040 --> 00:20:28,590
.صحيح، قال ذلك الرجل أنّ لديها قدرة كافية لتجاوز عقيلة الملك

314
00:20:28,590 --> 00:20:33,290
بعد سماع كل هذا، أنت تعلم تمامًا ما أتوقعه منك، صحيح؟

315
00:20:33,670 --> 00:20:34,510
.أجل

316
00:20:35,050 --> 00:20:36,260
هل ستفعل ذلك؟

317
00:20:36,910 --> 00:20:39,020
.أجل، بالطبع

318
00:20:41,270 --> 00:20:46,250
.ما عليّ فعله هو حماية شار إلى أن تكبر لتكون ملكة عظيمة

319
00:20:46,690 --> 00:20:53,030
بعد أن أفعل ذلك، سأتمكن من الاسترخاء
.والاستمتاع بحياتي كانطوائي في هذا العالم الخيالي

320
00:20:55,260 --> 00:20:59,910
.هاروتو-ساما، دعني أحضر لك رأس عقيلة الملك

321
00:21:00,230 --> 00:21:02,600
.سأنتقم لسيدي على حياته السابقة

322
00:21:02,600 --> 00:21:03,690
.لا

323
00:21:03,690 --> 00:21:07,280
.آسف، لكنّ هذا بيني وبينها

324
00:21:07,280 --> 00:21:10,410
.لن يعني الأمر شيئًا إلى أنّ أقتلها بيديّ

325
00:21:10,410 --> 00:21:11,690
.فهمت

326
00:21:11,690 --> 00:21:13,580
.كما هو متوقع منك يا هاروتو-ساما

327
00:21:13,580 --> 00:21:17,600
.سيشرفني أن أشهد ذلك عندما يحين الوقت

328
00:21:17,600 --> 00:21:18,450
.أجل

329
00:21:21,530 --> 00:21:25,330
.ستأتي تلك المرأة للتدخل مجدّدًا بالتأكيد

330
00:21:25,650 --> 00:21:28,090
.لا يمكنني أن أفكر في حماية شار فقط

331
00:21:33,090 --> 00:21:37,280
حسنًا إذًا، ربما حان الوقت للم شمل
.بين أم وابنها لأول مرة في عشر سنوات

332
00:23:09,460 --> 00:23:10,960
!هنا شارلوت

333
00:23:10,960 --> 00:23:13,750
!كان أخي مذهلًا مجدّدًا خلال مهمة اليوم

334
00:23:13,750 --> 00:23:16,500
!لا يسعني الانتظار حتى أكون قادرة على الانضمام له أيضًا

335
00:23:16,500 --> 00:23:18,080
!علي الاستعداد قدر المستطاع

336
00:23:18,080 --> 00:23:20,080
."الحلقة القادمة: "الأقوى في العالم

337
00:23:20,080 --> 00:23:22,860
!نحن نتحدث عن أخي، صحيح؟