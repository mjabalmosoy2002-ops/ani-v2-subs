...بشأن ذكرى أليس التي رأيناها

217
00:14:40,120 --> 00:14:43,520
.يفترض أن بريك يبحث في أمرها الآن

218
00:14:43,980 --> 00:14:47,150
.لهذا سنبقى في المنزل على أهبة الاستعداد

219
00:14:53,920 --> 00:14:58,900
.ولدي كثير من المواضيع أحادثك بشأنها

220
00:15:02,460 --> 00:15:03,700
أرأيتَ يا أوز؟

221
00:15:03,700 --> 00:15:05,840
!ذلك اللحم هناك يبدو شهيًا

222
00:15:05,840 --> 00:15:06,920
لحم؟

223
00:15:06,920 --> 00:15:08,040
ماذا ماذا؟

224
00:15:08,040 --> 00:15:08,840
تريدين تناولها؟

225
00:15:11,780 --> 00:15:13,420
.أريد تناولها

226
00:15:13,680 --> 00:15:14,580
!كلّا

227
00:15:14,580 --> 00:15:15,500
لماذا؟

228
00:15:15,500 --> 00:15:18,420
.شراء المكونات أرخص من الطعام الجاهز، هذا هو المنطق

229
00:15:19,680 --> 00:15:21,280
.أيها الجبان

230
00:15:21,900 --> 00:15:24,540
!لا بأس، سأحصل عليها بنفسي

231
00:15:24,540 --> 00:15:27,220
!مهلك! حسنًا سأشتريها لك

232
00:15:30,040 --> 00:15:31,450
.لا أريد

233
00:15:32,380 --> 00:15:34,560
.سأنتظر هنا

234
00:15:39,040 --> 00:15:41,620
.لا يشغل بالك ما قاله بريك

235
00:15:42,840 --> 00:15:46,160
.فكل ما يفعله مضايقة الآخرين

236
00:15:46,160 --> 00:15:47,900
– تخيل ما عانيت في العشر سنين هذه

237
00:15:47,900 --> 00:15:49,000
.غيل

238
00:15:49,580 --> 00:15:52,260
.أنا بخير، اذهب بسرعة

239
00:15:56,840 --> 00:15:58,040
.إلهي

240
00:15:58,800 --> 00:16:00,340
.سأعود بسرعة

241
00:16:00,340 --> 00:16:01,640
!مهلًا أيتها الأرنبة الحمقاء

242
00:16:05,280 --> 00:16:09,740
أتشغل بالي كلمات بريك يا ترى؟

243
00:16:10,620 --> 00:16:12,700
أين أنت؟

244
00:16:13,220 --> 00:16:20,150
...عيني الشاحبة هذه لا تبصرك البتة

245
00:16:22,960 --> 00:16:26,240
ما الذي حوّلك مختلًّا هكذا؟

246
00:16:26,240 --> 00:16:27,260
مختل؟

247
00:16:28,860 --> 00:16:32,480
.لست مختلّا

248
00:16:32,480 --> 00:16:34,600
...لأنني آنذاك

249
00:16:34,600 --> 00:16:38,250
.تجاوزت الأمر تمامًا

250
00:16:41,900 --> 00:16:43,100
.سمعت من أوز

251
00:16:45,240 --> 00:16:47,530
.أنك فقدت ذكرياتك أيضًا

252
00:16:48,820 --> 00:16:52,640
ألا تذكر شيئًا عن والديك؟

253
00:16:52,640 --> 00:16:53,980
لمَ السؤال؟

254
00:16:55,040 --> 00:16:56,350
.لا سبب

255
00:16:57,160 --> 00:17:00,980
.كنت أتساءل ما هما الوالدان فحسب

256
00:17:10,740 --> 00:17:13,620
،إن كان ما يفعله الوالدان هو الإنجاب

257
00:17:13,620 --> 00:17:16,960
فهل هما من يخلقان سببًا للعيش؟

258
00:17:18,240 --> 00:17:18,920
.وما أدراني

259
00:17:20,440 --> 00:17:22,400
.سؤالك كان غباءً مني

260
00:17:22,400 --> 00:17:24,320
– لا بأس، سأسأل أوز لاحـ

261
00:17:24,320 --> 00:17:24,760
!توقفي

262
00:17:37,200 --> 00:17:39,660
!إياك والحديث عن الوالدين في حضرة أوز

263
00:17:41,300 --> 00:17:42,120
لماذا؟

264
00:17:42,460 --> 00:17:44,820
!لأنني قلت هذا، أيتها الأرنبة الحمقاء

265
00:17:44,820 --> 00:17:47,530
!إنها مسألة حساسة بالنسبة لأوز

266
00:17:48,960 --> 00:17:50,540
...إنه أمرٌ

267
00:17:50,800 --> 00:17:52,880
!لن يفهمه تشين مثلك

268
00:17:57,680 --> 00:18:00,660
أتقول إنها حساسة لأوز؟

269
00:18:02,420 --> 00:18:06,360
.حتى حين قُذف إلى الهاوية، بدأ يأكل البسكويت دون أدنى اهتمام لما حوله

270
00:18:06,360 --> 00:18:09,740
.لا بد أنه فقد خمسة أو ستة براغي من دماغه

271
00:18:09,740 --> 00:18:11,040
...أيتها

272
00:18:11,040 --> 00:18:12,180
!وأنت من نفس الطينة

273
00:18:13,580 --> 00:18:16,480
لماذا تخدم ولدًا لعوبًا مثله؟

274
00:18:18,320 --> 00:18:19,980
!إنكِ لا تعلمين شيئًا

275
00:18:20,540 --> 00:18:22,360
!إياك وإهانة سيدي

276
00:18:29,740 --> 00:18:31,280
.ما باليد حيلة إذن

277
00:18:31,280 --> 00:18:32,440
.تحدّث

278
00:18:34,180 --> 00:18:38,540
.إن علمتُ عنه، يمكنني أن أسخر منه كيفما شئت

279
00:18:45,360 --> 00:18:50,200
.على أي حال، لست مهتمة بماضي خادمي

280
00:18:50,200 --> 00:18:54,060
.لكن إن أصررت، سأستمع إليك

281
00:18:56,440 --> 00:19:00,320
.وأيضًا، إن سمعت قصته الآن، لن أضطر لسؤاله

282
00:19:00,420 --> 00:19:02,620
...أيتها

283
00:19:02,620 --> 00:19:04,440
!الأرنبة الحقيرة

284
00:19:06,440 --> 00:19:08,720
.تأخّرا

285
00:19:09,700 --> 00:19:12,040
!توقف! رُدّها

286
00:19:13,340 --> 00:19:17,380
.انظرا إليه، يتمشى في الأرجاء حاملًا صورة أمه

287
00:19:18,740 --> 00:19:21,040
!يا له من مظهرٍ لابن نبيل

288
00:19:21,760 --> 00:19:23,920
...أتدريان؟ كان والده

289
00:19:23,920 --> 00:19:28,080
.يتوسل إلى دائنه ليؤجل موعد الدفع

290
00:19:28,900 --> 00:19:30,260
!نبيلٌ مثير للشفقة

291
00:19:30,260 --> 00:19:32,240
!لا تسخروا من والدي

292
00:19:43,280 --> 00:19:44,900
!يا له من شيء ممتع تفعلونه

293
00:19:46,040 --> 00:19:48,320
هل لي بالانضمام؟

294
00:19:49,280 --> 00:19:50,320
من تكون؟

295
00:19:50,900 --> 00:19:55,420
.يبدو أنكم لا تعلمون كيف تتنمرون على أحدهم

296
00:19:56,580 --> 00:19:59,300
.إن كنتم ستفعلونها، فعليكم بالقسوة

297
00:19:59,300 --> 00:20:01,080
.وليس لعب الأطفال هذا

298
00:20:02,540 --> 00:20:05,660
!اقطعوا ذراعًا، أو الاثنتين

299
00:20:06,420 --> 00:20:08,050
ذ-ذراع؟

300
00:20:08,920 --> 00:20:11,540
.سأعلمكم الكيفية

301
00:20:11,540 --> 00:20:13,340
.أسمعوني صراخكم

302
00:20:13,340 --> 00:20:14,600
!توقف

303
00:20:15,960 --> 00:20:17,860
!لا تتركانني

304
00:20:24,380 --> 00:20:26,160
.خدعتكم

305
00:20:30,340 --> 00:20:33,280
.أمك جميلة

306
00:20:33,460 --> 00:20:36,240
.أجل، لكنها توفيت

307
00:20:36,240 --> 00:20:38,650
.لقد كانت حنونة وطيبة

308
00:20:39,100 --> 00:20:39,880
أتشعر بالوحدة؟

309
00:20:41,380 --> 00:20:43,500
.ذلك أن أبي معي

310
00:20:46,220 --> 00:20:52,180
.ما عاد لدينا مال، لذا ما عدنا نعيش في قصرنا

311
00:20:53,020 --> 00:20:56,560
.أصبح منزلنا صغيرًا، ورحل كل خَدَمِنا

312
00:20:57,520 --> 00:20:58,140
،لكن

313
00:20:58,780 --> 00:21:01,400
!أبي يقضي يومه معي أكثر من أي وقتٍ مضى

314
00:21:04,420 --> 00:21:07,360
.لهذا لست وحيدًا

315
00:21:11,560 --> 00:21:12,240
.هكذا إذن

316
00:21:12,880 --> 00:21:13,810
!أيها

317
00:21:17,280 --> 00:21:18,440
ماذا عنك؟

318
00:21:19,560 --> 00:21:22,500
أي نوع من الأشخاص هما والداك؟

319
00:21:38,020 --> 00:21:40,000
...أمي

320
00:21:40,000 --> 00:21:41,660
.مثل أمك

321
00:21:41,660 --> 00:21:42,680
.رحلت عن هذه الحياة

322
00:21:45,820 --> 00:21:46,820
...أما أبي

323
00:21:48,240 --> 00:21:49,400
...أجل

324
00:21:52,000 --> 00:21:55,850
...ما عدت

325
00:21:53,850 --> 00:21:55,850
.أذكر وجهه

326
00:22:21,870 --> 00:22:28,650
هل تؤمن بحبٍّ أبديٍّ راسخ؟

327
00:22:28,750 --> 00:22:35,450
أتنفّسُ الصعداء فتذوب في الشاي الحلو

328
00:22:35,850 --> 00:22:40,200
إنّني قد سئمت الانتظار

329
00:22:41,110 --> 00:22:48,800
فلذلك هبطتُ وتبعتك إلى بلاد العجائب

330
00:22:49,830 --> 00:22:53,150
كم عليّ أن أجري بعدُ

331
00:22:50,070 --> 00:22:55,950
كنتُ وحيدةً في كلّ انتظاري

332
00:22:53,200 --> 00:22:56,500
عبر الظلام دائم التغيّر؟

333
00:22:56,550 --> 00:23:02,750
اللحن الذي أتبعه يثيرُ شيئًا ما في قلبي

334
00:23:02,800 --> 00:23:10,550
إن كان القدرُ كساعةٍ دقيقة، فسأحطّمها وأحرر نفسي

335
00:23:03,850 --> 00:23:10,550
نفسي الحقيقيّة حرّة

336
00:23:10,670 --> 00:23:13,950
إنّك الحقيقة الحقّ

337
00:23:14,110 --> 00:23:17,800
مخلّصي من حيرتي

338
00:23:17,800 --> 00:23:21,450
هذا برهانٌ لعيشي