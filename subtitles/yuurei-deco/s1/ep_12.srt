1
00:00:17,530 --> 00:00:18,990
ماذا؟

2
00:01:53,750 --> 00:01:56,340
...أعرف هذا المكان

3
00:01:57,840 --> 00:02:00,170
من هؤلاء؟

4
00:02:07,390 --> 00:02:08,600
صباح الخير

5
00:02:12,100 --> 00:02:14,940
ما الخطب أيّتها النّعسانة؟

6
00:02:18,400 --> 00:02:20,230
!صباح الخير يا أمّي

7
00:02:21,280 --> 00:02:23,240
انظري. الجميع سعداء برؤيتكِ

8
00:02:27,870 --> 00:02:29,370
!صباح الخير جميعاً

9
00:02:30,080 --> 00:02:32,290
صباح الخير يا حلوتي

10
00:02:33,290 --> 00:02:34,750
!صباح الخير يا أبي

11
00:02:38,380 --> 00:02:41,960
كنتِ تلقين التحيّة للتو على نادي
سمكة الملاك، أليس كذلك؟

12
00:03:02,900 --> 00:03:04,440
!صباح الخير

13
00:03:08,910 --> 00:03:10,370
!ما أجمله

14
00:03:10,370 --> 00:03:14,500
كان لدى الفتاة طاووس يُدعى سام

15
00:03:15,370 --> 00:03:17,960
سام، هل سمعت شيئاً للتو؟

16
00:03:18,460 --> 00:03:21,290
وكانت الفتاة تحبّ سام حبّاً جمّاً

17
00:03:21,290 --> 00:03:22,960
ها هو من جديد

18
00:03:26,840 --> 00:03:29,970
أمّي! أظلّ أسمع هذا الصّوت الغريب

19
00:03:29,970 --> 00:03:31,550
يبدو مخيفاً

20
00:03:31,550 --> 00:03:33,970
على أيّ حال، حان وقت الشّاي

21
00:03:33,970 --> 00:03:35,430
!مرحى

22
00:03:35,930 --> 00:03:37,940
كان مكاناً رائعاً بحقّ

23
00:03:38,810 --> 00:03:43,860
وكان هنا حيث عاشت الفتاة حياة هانئة

24
00:03:44,480 --> 00:03:45,570
إنّه لذيذ، أليس كذلك؟

25
00:03:45,570 --> 00:03:46,320
بالتأكيد

26
00:04:05,670 --> 00:04:07,300
أنتِ تبلين بلاء حسناً

27
00:04:10,260 --> 00:04:11,340
ها نحن ذا

28
00:04:11,970 --> 00:04:12,850
!انطلقي

29
00:04:18,390 --> 00:04:19,640
!أبي

30
00:04:20,770 --> 00:04:26,610
.كان كلّ شيء حقيقيّاً في هذا المكان
عالم بلا ديكو أو يوري

31
00:04:26,610 --> 00:04:27,610
...اسمعا

32
00:04:27,610 --> 00:04:29,360
ما الأمر يا حلوتي الصّغيرة؟

33
00:04:29,360 --> 00:04:33,960
أمّي وأبي، عندما أكبر، آمل أن
!أكون رائعة مثلكما

34
00:04:35,740 --> 00:04:37,950
مؤكّد أنّكِ ستكونين كذلك أيّتها الفتاة الطيّبة

35
00:04:39,330 --> 00:04:40,790
نامي بعمق، اتّفقنا؟

36
00:04:42,250 --> 00:04:47,380
وهكذا، عاشت الفتاة أيّامها بسلام

37
00:04:48,050 --> 00:04:51,590
وعاشوا برغد من بعد ذلك. النّهاية

38
00:04:56,970 --> 00:04:57,970
!هاك

39
00:04:58,640 --> 00:05:00,980
!هاك! هاك

40
00:05:03,350 --> 00:05:04,650
شبح؟

41
00:05:06,570 --> 00:05:07,900
!ابتعد

42
00:05:07,900 --> 00:05:08,570
!هاك

43
00:05:08,570 --> 00:05:09,190
!لا

44
00:05:09,820 --> 00:05:12,990
!أبي! أمّي! هناك شبح

45
00:05:13,910 --> 00:05:15,160
!انتظري

46
00:05:14,410 --> 00:05:15,160
!لا

47
00:05:15,370 --> 00:05:16,410
!هاك

48
00:05:16,780 --> 00:05:18,540
!ابتعد أيّها الشّبح

49
00:05:18,830 --> 00:05:22,790
.انظري، لستُ شبحاً. أنا يوري
!أنا بيري، من نادي يوري للتحرّيات

50
00:05:23,870 --> 00:05:24,790
بيري؟

51
00:05:25,130 --> 00:05:26,790
هل نسيتِ؟

52
00:05:26,790 --> 00:05:28,210
!هذه أنا، المهووسة

53
00:05:28,210 --> 00:05:29,840
المهووسة؟

54
00:05:29,840 --> 00:05:30,550
!هذا صحيح

55
00:05:31,220 --> 00:05:35,090
نحن في نادي التحرّيات معاً وقد حللنا مُختلف القضايا

56
00:05:36,640 --> 00:05:38,060
نادي تحرّيات؟

57
00:05:38,350 --> 00:05:41,070
وهناك شيء علينا فعله

58
00:05:41,070 --> 00:05:44,770
علينا حلّ اللّغز الأخير: لغز زيرو

59
00:05:44,770 --> 00:05:46,270
لغز؟

60
00:05:46,560 --> 00:05:51,570
أجل. هذا المكان غير حقيقيّ. يجب أن تنظري
بعينيكِ لتقرّري ما هو صحيح، أليس كذلك؟

61
00:05:54,740 --> 00:05:56,370
!لذا استيقظي يا هاك

62
00:05:58,870 --> 00:06:01,120
!أنا. أحبّ. أي

63
00:06:03,880 --> 00:06:06,710
أنا. أحبّ. أي

64
00:06:09,550 --> 00:06:11,130
!اللّعنة

65
00:06:11,130 --> 00:06:13,340
!أيّتها الغشّاشة الرّخيصة

66
00:06:13,340 --> 00:06:15,050
!اخرجي إلى هنا يا ساحرة الخلل البرمجي

67
00:06:15,380 --> 00:06:16,430
!هك

68
00:06:24,640 --> 00:06:27,770
لحظة، هذا ما كان فين يبحث بشأنه

69
00:06:28,650 --> 00:06:31,070
سوف نقبض عليها هذه المرّة أيّتها المهووسة

70
00:06:31,070 --> 00:06:33,440
!عُلِم يا هاك

71
00:06:36,820 --> 00:06:38,410
!اكشفي عن نفسك

72
00:06:49,670 --> 00:06:53,010
أنا مندهشة. العالم الّذي بنيتُه كان مثاليّاً

73
00:06:53,420 --> 00:06:55,260
كان خطّ دفاعي الأخير

74
00:06:55,550 --> 00:06:58,550
وتمكّنتم من كشف نادي سمكة الملاك

75
00:07:08,310 --> 00:07:09,860
يعتمد الأمر عليكما

76
00:07:12,480 --> 00:07:15,030
عليكما القبض على زيرو

77
00:07:53,650 --> 00:07:55,070
!وجدتُك

78
00:07:55,070 --> 00:07:56,530
!الطّيف زيرو

79
00:07:58,950 --> 00:08:02,990
أهلاً بكما في قصر "مارك توين" الخاص بي

80
00:08:04,990 --> 00:08:09,120
،كنتُ أنوي دمجكم مع الخوارزميّة

81
00:08:09,710 --> 00:08:12,210
لكن رؤيتكم تتعاونون معاً أدّت إلى توضيح أمر

82
00:08:12,710 --> 00:08:16,760
يبدو أنّ امتلاك أصدقاء هو أمر جوهريّ أحياناً

83
00:08:17,710 --> 00:08:22,180
لذا بدلاً من ذلك، سوف أخبركم بكلّ شيء

84
00:08:30,560 --> 00:08:31,770
من أنتِ؟

85
00:08:31,770 --> 00:08:37,110
أدير مركز الزبائن من هنا في مارك توين

86
00:08:37,110 --> 00:08:39,860
أراقب النّاس وأديرهم

87
00:08:39,860 --> 00:08:41,780
اسمي إنجاكشن جو

88
00:08:42,110 --> 00:08:43,280
...ملكة التلصّص

89
00:08:44,910 --> 00:08:47,790
تعرفونني أيضاً باسم الطّيف زيرو

90
00:08:50,080 --> 00:08:54,170
،إذا أخبرتُ الجميع بهويّة زيرو الحقيقيّة

91
00:08:54,170 --> 00:08:57,420
فذلك سيثبت بأنّنا لسنا الطّيف زيرو

92
00:08:57,420 --> 00:08:59,510
!حينئذ سنتمكّن من إنقاذ أصدقائنا

93
00:09:00,220 --> 00:09:02,800
ألهذا قطعتِ كلّ هذه المسافة إلى هنا حقّاً؟

94
00:09:02,800 --> 00:09:04,470
أيّتها الجميلة السّاذجة

95
00:09:04,470 --> 00:09:05,640
ساذجة؟

96
00:09:06,180 --> 00:09:08,270
ساذجة ونقيّة القلب

97
00:09:08,270 --> 00:09:12,140
لكن لا مشكلة. قد يكون هذا ما أبحث عنه تماماً

98
00:09:12,140 --> 00:09:13,480
!عمّاذا تثرثرين؟

99
00:09:14,100 --> 00:09:18,320
آبلود إينوسينت. التحكّم الإداري بمارك توين

100
00:09:18,320 --> 00:09:24,780
أقصد بأنّني سأنقل دور "الطّيف زيرو" إليكم
أنتم الأطفال طيّبي القلب والسُّذَج

101
00:09:25,030 --> 00:09:26,030
تنقلين؟

102
00:09:26,450 --> 00:09:29,040
أجل. ستصبحون زيرو

103
00:09:30,120 --> 00:09:33,460
،سيمنحكم هذا عيوناً في كلّ أنحاء الجزيرة

104
00:09:33,460 --> 00:09:38,960
ممّا يسمح لكم برؤية كلّ شيء ومعرفة أيّ شيء تريدون عنها

105
00:09:39,800 --> 00:09:41,720
،وحالما تعرفون كلّ شيء

106
00:09:41,720 --> 00:09:45,800
ستمتلكون حرّية تحديد ما إن كان حقيقة أو خيالاً

107
00:09:49,060 --> 00:09:52,350
"بمساعدة القوّة التي سمّيتموها جميعاً "ظاهرة زيرو

108
00:09:53,100 --> 00:09:54,270
مستحيل

109
00:09:56,900 --> 00:10:00,530
،من يصبح الطّيف زيرو هو إله بالمعنى الجوهريّ

110
00:10:00,530 --> 00:10:04,070
يحكم من هذا الارتفاع في سمائي هذه

111
00:10:04,070 --> 00:10:05,910
كفاكِ عبثاً يا ساحرة الخلل البرمجي

112
00:10:06,490 --> 00:10:08,030
كيف لهذا أن يكون ممكناً؟

113
00:10:09,830 --> 00:10:13,910
بدأ ذلك بخوارزميّة لحكم هذه الجزيرة

114
00:10:14,290 --> 00:10:17,130
حياة البشر تنصُّها الخوارزميّات

115
00:10:18,420 --> 00:10:23,300
ما نعتبره "قلوب" ليس أكثر من مجرّد صِيَغ مؤتمتة

116
00:10:23,300 --> 00:10:25,550
تستجيب لطيف من المُنبّهات

117
00:10:26,760 --> 00:10:30,760
!هذا غير صحيح! لديّ قلب... وعقل خاصّ بي

118
00:10:31,520 --> 00:10:32,720
بالفعل

119
00:10:32,720 --> 00:10:35,600
لكن عقلكِ هذا وطريقة استجابته

120
00:10:35,600 --> 00:10:39,940
يُحدّدان بردود الأفعال التراكميّة على مخزون
هائل من البيانات المحفوظة

121
00:10:41,070 --> 00:10:44,950
لا شيء يفعله النّاس يأتي عن فراغ

122
00:10:45,650 --> 00:10:52,200
قلوبكم وقلبي هي نتيجة معلومات
مُنظّمة بواسطة خوارزميّات

123
00:10:52,740 --> 00:10:55,710
إنّ كلمة "حرّ" لا تدخل المُعادلة أبداً

124
00:10:55,710 --> 00:10:58,500
،للإشراف على البشر وحمايتهم

125
00:10:58,500 --> 00:11:02,460
وبناء عالم حيث لا يحتاجون فيه للحكم
،على بعضهم الآخر

126
00:11:03,000 --> 00:11:06,430
صُنِع نظام لتطهير الخطيئة من قلوبنا

127
00:11:06,430 --> 00:11:08,970
هذا ما أنتم تعيشونه

128
00:11:11,720 --> 00:11:14,600
نحرص على ألّا يرى النّاس أشياء تُثير قلقهم

129
00:11:14,600 --> 00:11:15,810
إنّه عمل مهمّ جدّاً

130
00:11:16,560 --> 00:11:20,310
وتعتقدين أنّه لا ضير من التستّر
على الحقيقة بأكاذيب؟

131
00:11:20,310 --> 00:11:21,820
!مُحال أن يكون هذا صحيحاً

132
00:11:22,980 --> 00:11:28,610
مفهوم "الحقيقة" و "الخيال" بحدّ
ذاته يتطلّب سياقاً خارجيّاً

133
00:11:28,610 --> 00:11:32,370
وماذا لو أزلنا ذلك السّياق؟
يذهب التّمييز معه

134
00:11:34,450 --> 00:11:39,250
،حالما يتمّ إزالة شيء من السجلّ
يتلاشى من الذّاكرة مع الوقت

135
00:11:39,880 --> 00:11:41,710
وكأنّه لم يكُن موجوداً من الأساس

136
00:11:42,000 --> 00:11:45,050
!هذا غير صائب. أعلم بأنّه غير صائب

137
00:11:45,050 --> 00:11:47,420
النّاس كالقمر

138
00:11:47,420 --> 00:11:51,720
جميعنا لدينا جانب مظلم لم يره أحد آخر أبداً

139
00:11:52,800 --> 00:11:56,770
!قلوب... قلوب النّاس ليست بتلك البساطة

140
00:11:56,770 --> 00:12:00,770
يمكننا العيش على ما يُرام
!"من دون بصيرتك و"إدارتك

141
00:12:00,770 --> 00:12:03,480
يجب أن تنظري بعينيك لتقرّري
!ما هو صحيح، أليس كذلك؟

142
00:12:03,480 --> 00:12:06,230
!هناك بعض الحقائق لا يمكن رؤيتها بنفسك

143
00:12:06,740 --> 00:12:09,650
تتّخذين قرارات عن الجميع كما لو
أنّكِ على دراية بكلّ شيء

144
00:12:10,570 --> 00:12:11,870
!من تعتقدين نفسكِ؟

145
00:12:12,700 --> 00:12:18,620
أنا مثلكم جميعاً. مجرّد بشريّة عاديّة
ترقص على أنغام الخوارزميّة

146
00:12:18,620 --> 00:12:24,800
ووظيفتي داخل هذا النّظام هي
توفير "البشريّة" بكلّ تناقضاتها

147
00:12:25,590 --> 00:12:28,260
قليل من "اللّعب" مسموح بواسطة النّظام

148
00:12:28,670 --> 00:12:32,390
أفرض تأثيراً خارجيّاً على الخوارزميّة

149
00:12:33,470 --> 00:12:35,220
هذا ما تمّ اختياري لأجله

150
00:12:37,310 --> 00:12:43,690
والآن، باستخدام الصلاحيّات الممنوحة
لي، أنفّذ إيعازاً على نفسي

151
00:12:44,020 --> 00:12:45,940
إيعاز؟

152
00:12:45,940 --> 00:12:49,650
فرصة ملاذ أخير لتحرير نفسي على يدي

153
00:12:50,280 --> 00:12:51,700
أنا مُرهَقة

154
00:12:52,030 --> 00:12:53,530
..جو

155
00:12:53,530 --> 00:12:58,950
لهذا تجوّلتُ في الجزيرة على هيئة
الطّيف زيرو. لإيجاد خليفة

156
00:12:58,950 --> 00:13:02,580
...أردتُ شخصاً ساذجاً وطيّب القلب

157
00:13:02,580 --> 00:13:04,880
براءة دون ذرّة رغبة أنانيّة

158
00:13:06,800 --> 00:13:09,210
وبرؤيتكما، أصبح أمرٌ ما جليّاً

159
00:13:09,210 --> 00:13:12,260
لا يمكن لفرد بلا روابط مع الآخرين
أن يكون بريئاً

160
00:13:12,260 --> 00:13:14,930
يجب أن يكون شخصاً لديه أصدقاء مُقرّبون جدّاً

161
00:13:19,060 --> 00:13:22,520
!كنتِ تثرثرين لفترة طويلة لدرجة أنّني تعبت

162
00:13:24,900 --> 00:13:26,520
أنت تزدرين المحكمة

163
00:13:26,520 --> 00:13:28,820
تحاولين إنقاذ النّاس؟

164
00:13:28,820 --> 00:13:31,820
لا تتدخّلي. لم يطلب أحدٌ مساعدتكِ

165
00:13:31,820 --> 00:13:35,030
وبصراحة لا أحد يكترث يا سيّدة الطاووس

166
00:13:35,030 --> 00:13:36,370
!احتقار للمحكمة

167
00:13:37,240 --> 00:13:41,080
لا أكترث البتّة لما تقولينه أو فيما إذا
كان شيئاً صحيح أم لا

168
00:13:41,080 --> 00:13:45,630
أنا أؤمن بالأشياء الّتي أراها بأمّ عيني
والتّجارب التي أخوضها

169
00:13:46,330 --> 00:13:49,340
هذا ينطبق عليّ وعليها وعلى كلّ أصدقائها

170
00:13:49,340 --> 00:13:55,260
ولا أكترث إذا كانت خوارزميّتك تلك
تقول عن شيء بأنّه مزيّف أو لا

171
00:13:55,260 --> 00:13:58,560
الأشياء التي نجدها، مهما كانت، هي
!أكثر حقيقة من أيّ حقيقة

172
00:13:58,560 --> 00:14:00,180
!هل فهمتِ ذلك يا جو؟

173
00:14:05,310 --> 00:14:08,190
يبدو أنّني اتّخذتُ القرار الصّائب في نهاية المطاف

174
00:14:09,900 --> 00:14:14,280
امضيا وجرّبا. لنرَ إلى أيّ مدى
حقيقتكما حقيقيّة

175
00:14:14,280 --> 00:14:15,700
ماذا تقولين؟

176
00:14:16,070 --> 00:14:22,700
تريدان معرفة حقيقة الطّيف زيرو، صحيح؟
السّبب وراء ظاهرة زيرو؟

177
00:14:22,700 --> 00:14:24,500
لهذا أتيتما إلى هنا، أليس كذلك؟

178
00:14:24,500 --> 00:14:25,460
ساحرة الخلل البرمجيّ؟

179
00:14:27,130 --> 00:14:31,710
.حسناً، إن كنت تبحث عن الحقيقة الحقيقيّة
ابحث بنفسك. تقدّم واشهدها من تلقاء نفسك

180
00:14:33,590 --> 00:14:34,800
عُلِم

181
00:14:41,720 --> 00:14:46,270
.ماذا؟ مكتوب هنا ممنوع الدّخول
أليس من المُفترض أن يكون الحدث هنا؟

182
00:14:47,690 --> 00:14:51,020
تفيد الإشاعات بأنّ الطّيف زيرو
!الحقيقيّ سوف يظهر

183
00:14:51,020 --> 00:14:53,070
إذاً كلّ هذا جزء من التّنظيم؟

184
00:14:53,070 --> 00:14:54,360
!غالباً

185
00:15:00,320 --> 00:15:02,870
وصل الطّيف زيرو ومُتواطئوه

186
00:15:02,870 --> 00:15:05,870
الطّيف زيرو الحقيقيّ؟

187
00:15:13,380 --> 00:15:14,300
ها هُم

188
00:15:20,970 --> 00:15:23,720
أنتما الطّيف زيرو إذاً؟

189
00:15:25,390 --> 00:15:27,390
أطرح عليكم نفس السّؤال

190
00:15:29,350 --> 00:15:30,560
...ماذا؟! ما الّذي

191
00:15:31,100 --> 00:15:33,020
!ما هذا؟! الطّيف زيرو؟

192
00:15:31,690 --> 00:15:33,060
أعرف من فعل هذا

193
00:15:33,020 --> 00:15:34,230
!ما الّذي يجري؟

194
00:15:34,230 --> 00:15:36,360
!هل رأيتم كلّ أطياف زيرو هؤلاء؟

195
00:15:36,360 --> 00:15:38,240
ممنوع الدّخول

196
00:15:39,400 --> 00:15:41,610
!انظر! أنت الطّيف زيرو

197
00:15:41,610 --> 00:15:43,780
!كذلك أنت يا رجل

198
00:15:43,280 --> 00:15:44,370
!ما الّذي يجري؟

199
00:15:44,660 --> 00:15:48,370
هذا سيّئ! زالَ جدار ديكو! لا بدّ
!أنّه من صنيع عصابة الطّيف زيرو

200
00:15:48,710 --> 00:15:50,620
!أين الطّيف زيرو؟

201
00:15:50,620 --> 00:15:52,670
!أجل! نحن جميعنا الطّيف زيرو

202
00:15:50,960 --> 00:15:52,210
!توقّف مكانك

203
00:15:52,670 --> 00:15:54,380
!أنا الطّيف زيرو أيضاً

204
00:15:55,130 --> 00:15:56,800
ما الّذي يجري بالضبط؟

205
00:15:56,800 --> 00:15:58,210
آسف بشأن التأخّر

206
00:15:59,010 --> 00:16:01,300
!أتينا لنقلك يا فين

207
00:16:01,300 --> 00:16:02,800
!نعتذر لو جعلناك تنتظر

208
00:16:02,800 --> 00:16:03,890
ها نحن ذا

209
00:16:06,560 --> 00:16:08,770
عرفتُ بأنّكم المسؤولون عن هذا

210
00:16:09,310 --> 00:16:11,480
...محاربة النّار بالنّار! وزيرو

211
00:16:11,480 --> 00:16:12,480
!بزيرو...

212
00:16:39,630 --> 00:16:41,970
تسرّني عودتك يا فين

213
00:16:41,970 --> 00:16:44,680
أجل. تسرّني العودة جميعاً

214
00:16:44,680 --> 00:16:47,430
كيف كانت "السّماء"؟

215
00:16:48,350 --> 00:16:50,680
انتهت لعبتي

216
00:16:50,680 --> 00:16:53,020
لحظة، ماذا عن بيري؟

217
00:16:53,730 --> 00:16:55,310
إنّها نائمة فحسب

218
00:16:55,980 --> 00:16:57,360
إنّها مُرهَقة

219
00:16:58,020 --> 00:17:00,150
ماذا حلّ بهاك؟

220
00:17:00,740 --> 00:17:01,950
سؤال وجيه

221
00:17:03,990 --> 00:17:06,160
...الشيء الوحيد الّذي يمكنني قوله جازماً

222
00:17:06,990 --> 00:17:11,830
هو أنّ المستقبلَ عالمُ هاك الّذي يجب بناؤه

223
00:17:20,760 --> 00:17:22,760
هلّا أيقظتِ أمّكِ لأجلي؟

224
00:17:22,760 --> 00:17:23,800
!حسناً

225
00:17:30,890 --> 00:17:33,810
!أمّي! طلع الصّباح! استيقظي

226
00:17:35,900 --> 00:17:37,360
...صباح الخير

227
00:17:37,360 --> 00:17:38,480
لننزل

228
00:17:43,570 --> 00:17:45,950
أبي! استيقظت أمّي

229
00:17:47,120 --> 00:17:48,870
صباح الخير يا عزيزتي

230
00:17:48,870 --> 00:17:49,830
صباح الخير

231
00:17:51,620 --> 00:17:53,330
رائحة زكيّة

232
00:17:53,870 --> 00:17:56,500
إنّه أرزّ غاباو مع الكثير من الكزبرة

233
00:17:56,500 --> 00:17:59,170
مُبهر. ويبدو لذيذاً

234
00:17:59,170 --> 00:18:03,340
بما أنّه كان لديّ مناوبة ليليّة، أعددتُه مع
بيري قبل أن أخلد إلى النّوم

235
00:18:03,340 --> 00:18:04,010
صحيح؟

236
00:18:04,010 --> 00:18:04,970
!صحيح

237
00:18:06,380 --> 00:18:09,350
كنتُما مشغولين جدّاً مؤخّراً، صحيح؟

238
00:18:09,720 --> 00:18:12,680
حسناً، وُضِعت مزيد من الأمور
،بعين الاعتبار بشأن عملة الحبّ الآن

239
00:18:12,680 --> 00:18:15,230
بما في ذلك المحتوى الّذي كان يُرفَض

240
00:18:15,230 --> 00:18:19,110
أجل. جيّد كان أم سيّئاً، لا مزيد من الأسرار

241
00:18:19,520 --> 00:18:24,690
عمل مُشرفي المحتوى لم يعُد يقتضي
إخفاء الأمور سواء كانت جيّدة أم سيّئة

242
00:18:24,690 --> 00:18:30,120
حان الوقت لإخبار النّاس أيّ الأشياء سيّئة

243
00:18:30,660 --> 00:18:34,700
.هيّا، لدينا وجبة لذيذة هنا.
لنأكلها قبل أن تبرد

244
00:18:34,700 --> 00:18:36,370
لديكِ درس اليوم، صحيح؟

245
00:18:36,370 --> 00:18:39,080
!أجل! حان وقت الأكل

246
00:18:39,080 --> 00:18:40,380
حان وقت الأكل

247
00:18:42,300 --> 00:18:43,380
!جميل

248
00:18:43,800 --> 00:18:44,670
هذا لذيذ

249
00:18:44,670 --> 00:18:45,760
أليس كذلك؟

250
00:18:49,680 --> 00:18:52,350
تريدون معرفة المزيد عن نادي يوري للتحرّيات، صحيح؟

251
00:18:52,850 --> 00:18:54,850
،حدث كلّ ذلك قبل عام

252
00:18:54,850 --> 00:18:59,350
لكن بالرجوع بالذاكرة للخلف، أشعر
وكأنّها قصّة مغامرات

253
00:19:05,780 --> 00:19:09,660
هانك مشغول جدّاً بإزالة الخردة
لأجل متجر الخردة خاصّته

254
00:19:13,370 --> 00:19:16,250
قال "أيّ شيء أروع من كسب
"قوت يومك من البحر؟

255
00:19:27,010 --> 00:19:30,090
افتتح واتسون مطعم رامن

256
00:19:30,720 --> 00:19:34,760
تولّى الأامور مع أناليتيكا كمالِك
لعربة الرّامن الغامضة

257
00:19:39,640 --> 00:19:42,730
المدام وسمايلي يبليان بلاء عظيماً

258
00:19:51,110 --> 00:19:55,240
يبدو أنّ سمايلا ودورون يحلّقان بانتظام الآن

259
00:20:01,120 --> 00:20:03,840
عاد فين إلى موطنه القديم

260
00:20:04,420 --> 00:20:08,510
النّاس الّذين يقيمون هناك مُخوّلون
،الآن لاستخدام عملة الحبّ

261
00:20:08,510 --> 00:20:13,220
وبما أنّه يمكن الحصول على الحبّ من
التّنظيف، جميعهم يعملون بجدّ لإزالة النّفايات

262
00:20:26,230 --> 00:20:28,480
جو قالت بأنّها ستخرج في رحلة

263
00:20:28,820 --> 00:20:31,950
!مُغامرة بسفينة جوّية مصنوعة بجهود يدويّة

264
00:20:39,830 --> 00:20:41,160
...بالنسبة لهاك

265
00:20:41,750 --> 00:20:43,830
لم يعد هناك أيّ تواصل معها منذ ذلك الحين

266
00:20:43,830 --> 00:20:48,210
بما أنّ هاك قرّرت الحلول مكان
...جو في بناء العوالم

267
00:20:53,130 --> 00:20:54,590
...ما يعني

268
00:20:59,560 --> 00:21:01,770
...لكن أنا متأكّدة

269
00:21:02,890 --> 00:21:05,940
سوف نلتقي ثانية يوماً ما، أليس كذلك أيّتها المُفكّرة؟

270
00:21:49,690 --> 00:21:50,650
!يسار

271
00:21:50,650 --> 00:21:51,650
!يمين

272
00:21:53,030 --> 00:21:54,030
!هاك

273
00:21:57,070 --> 00:21:58,240
!هاك

274
00:21:58,740 --> 00:22:00,030
!المهووسة

275
00:22:00,030 --> 00:22:01,490
!أمسكتُ بك