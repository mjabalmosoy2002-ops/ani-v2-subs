1
00:00:00,890 --> 00:00:03,520
!أنتم الطّيف زيرو

2
00:00:05,900 --> 00:00:06,940
!هناك

3
00:00:08,440 --> 00:00:11,190
تبّاً. هربوا

4
00:00:11,190 --> 00:00:14,860
لكن بهذا، أكون قد اكتشفتُ هويّة الطّيف زيرو

5
00:00:15,320 --> 00:00:16,700
...ما الّذي

6
00:00:16,700 --> 00:00:18,160
!مذهل! جنون

7
00:00:18,160 --> 00:00:19,620
كان ذلك حقيقيّاً من البداية إذاً؟

8
00:00:19,990 --> 00:00:21,870
!هدفهم ظاهرة زيرو

9
00:00:21,870 --> 00:00:23,790
لنفجّر هذا ونقبض عليهم

10
00:00:25,790 --> 00:00:29,500
هذا سيّئ أيّتها المُفكّرة! إنّه أعظم
!خطر يواجهه نادي يوري للتحرّيات

11
00:00:29,500 --> 00:00:30,420
!إنّهم هم

12
00:00:30,840 --> 00:00:31,550
!أمسكوا بهم

13
00:00:31,550 --> 00:00:32,800
...يعتقد النّاس

14
00:00:34,050 --> 00:00:36,050
!بأنّنا الطيف زيرو؟

15
00:00:39,760 --> 00:00:42,180
!لحظة! لا! هذا غير معقول

16
00:00:42,180 --> 00:00:44,560
!ما الخطب يا رجل؟

17
00:00:44,560 --> 00:00:53,070
قبول. رفض. قبول. رفض

18
00:00:53,360 --> 00:00:55,780
ويُفترض أن يكونوا الطّيف زيرو؟

19
00:00:56,570 --> 00:01:00,910
،ما الّذي يجري هنا؟ إن لم نصلح هذا
مجرّد ضبط الحُبّ سيُثقِل علينا

20
00:01:00,910 --> 00:01:04,410
نتلقّى تقاريرَ شهود عيان من
مجموعة من الأحياء

21
00:01:04,410 --> 00:01:08,290
لا ينبغي أن يكون هناك حدث دولة
الطّيف زيرو الآن

22
00:01:08,750 --> 00:01:12,000
وردت التّقارير الأولى من حيّ سكنيّ غير مُسجَّل

23
00:01:12,590 --> 00:01:15,260
هذا خارج سلطتنا القضائيّة

24
00:01:15,260 --> 00:01:17,800
،صفقات الحبّ تنهال بشكل متردّد

25
00:01:17,800 --> 00:01:19,800
العثور
على
!الطّيف زيرو

26
00:01:17,800 --> 00:01:20,100
لم أرَ نفسي
أحرز
حُبّاً
!اليوم

27
00:01:17,800 --> 00:01:20,760
!وجدتُ الطّيف زيرو

28
00:01:17,800 --> 00:01:21,310
!رصد الطّيف زيرو

29
00:01:17,800 --> 00:01:21,310
رصد الطّيف زيرو

30
00:01:18,140 --> 00:01:21,260
سيكون من الصّعب التحقُّق من أيّ شيء

31
00:01:19,800 --> 00:01:21,310
!تعطّلت قِيَم الحُبّ! قد يكون المسؤول شخصاً مُحتالاً

32
00:01:20,760 --> 00:01:21,310
تحديثات الطّيف زيرو

33
00:01:27,060 --> 00:01:30,820
إن لم نضبطها تحت السّيطرة، فإنّ المُواطنين
سيغرقون في تيّار بيانات مُرتدّ

34
00:01:30,820 --> 00:01:31,770
!حاضر

35
00:01:34,740 --> 00:01:37,070
يبدو هذا سيّئاً

36
00:01:37,910 --> 00:01:41,080
لنفعل ما يمكننا فعله للحفاظ على سلامة المدينة

37
00:01:41,080 --> 00:01:45,080
مرفوض

38
00:01:45,660 --> 00:01:48,830
حضرة المُدير، تحقّقنا من مصدر التّقارير الأصليّ

39
00:01:48,830 --> 00:01:50,500
أرسلوا فريق بحث

40
00:01:54,510 --> 00:01:55,590
لا يوجد أحد هنا

41
00:01:55,590 --> 00:01:58,720
أغلقوا المكان. ثمّ اجمعوا كلّ الأدلّة المُمكنة

42
00:03:40,900 --> 00:03:52,410
!فلتسقط ظاهرة زيرو
!فلتسقط ظاهرة زيرو

43
00:03:45,030 --> 00:03:46,290
ما الّذي يجري؟

44
00:03:46,290 --> 00:03:48,410
لا أدري، لكن تبدو مشكلة كبيرة

45
00:03:49,450 --> 00:03:52,410
،تمكنّا من الهرب من خلال التفرُّق

46
00:03:52,410 --> 00:03:54,750
قبل العودة إلى الجزء الأعلى من
المدينة بالتنكّر بالدّيكو

47
00:03:56,000 --> 00:04:00,420
لكن يراقب مركز الزبائن كلّ شيء الآن

48
00:04:01,380 --> 00:04:02,460
هنا

49
00:04:02,460 --> 00:04:03,260
!فين

50
00:04:05,420 --> 00:04:06,590
هل أنت بخير؟

51
00:04:06,590 --> 00:04:07,550
أجل

52
00:04:08,260 --> 00:04:09,180
اتبعيني

53
00:04:09,600 --> 00:04:12,430
إلى أين سنذهب؟ كيف حالُ هانك والآخرين؟

54
00:04:12,430 --> 00:04:15,350
اهدئي. يعرفون نقطة الالتقاء

55
00:04:15,350 --> 00:04:16,690
بخلسة، خلسة، خلسة

56
00:04:17,020 --> 00:04:18,400
!مفاجأة

57
00:04:18,400 --> 00:04:19,810
!هاك

58
00:04:25,780 --> 00:04:27,990
أظنّنا أفلتنا

59
00:04:29,780 --> 00:04:32,620
!إنّه لصّ التخفّي الطيفيّ ذاك

60
00:04:32,620 --> 00:04:34,120
!نفسيّ

61
00:04:34,120 --> 00:04:37,500
تبّاً، أنتما. لمَ تخيفانني هكذا؟

62
00:04:38,420 --> 00:04:40,000
آسفة، آسفة

63
00:04:38,960 --> 00:04:40,000
سيكون ذلك على حسابي

64
00:04:40,000 --> 00:04:41,130
!شكراً

65
00:04:41,130 --> 00:04:43,170
لنجرّب ذاك المقهى

66
00:04:42,880 --> 00:04:44,420
وماذا الآن؟

67
00:04:45,130 --> 00:04:47,090
سنتوجّه إلى مخبأ فين

68
00:04:49,090 --> 00:04:51,140
هل هذا مخبأك يا فين؟

69
00:04:51,140 --> 00:04:52,100
أجل

70
00:04:52,100 --> 00:04:54,010
سننتظر هانك والآخرين هنا

71
00:04:54,010 --> 00:04:54,770
حسناً

72
00:05:05,980 --> 00:05:08,990
...الجميع يبحثون عنّا

73
00:05:09,910 --> 00:05:13,330
!يا لها من مجموعة طيور قيثارة كاذبة

74
00:05:14,540 --> 00:05:17,040
هذه مسؤوليّتي

75
00:05:17,040 --> 00:05:17,870
...فين

76
00:05:18,540 --> 00:05:23,340
بسبب قراراتي الطائشة، لم أعجز
،عن إنقاذ دياري فقط

77
00:05:23,340 --> 00:05:26,420
بل عرّضتُكم جميعاً للخطر كذلك

78
00:05:28,470 --> 00:05:30,380
!لم تنتهِ اللُّعبة بعد

79
00:05:31,800 --> 00:05:32,760
صحيح؟

80
00:05:33,260 --> 00:05:35,060
كما قلتِ أيّتها المهووسة

81
00:05:35,930 --> 00:05:37,220
أصبتِ في ذلك

82
00:05:37,220 --> 00:05:38,310
...هانك

83
00:05:40,480 --> 00:05:41,650
!ها نحن ذا

84
00:05:42,100 --> 00:05:44,570
يا رفاق! آمل أن تكونوا بخير

85
00:05:44,570 --> 00:05:46,400
!كنّا قد سئمنا الانتظار

86
00:05:47,650 --> 00:05:49,280
هذا قرار سهل الصّنع

87
00:05:51,160 --> 00:05:57,910
،إذا كان النّاس يشكُّ بأنّنا الطّيف زيرو
علينا القبض على الحقيقيّ

88
00:05:57,910 --> 00:06:00,120
!سوف نقبض على الطّيف زيرو؟

89
00:06:00,120 --> 00:06:01,290
!ساحرة الخلل البرمجي

90
00:06:01,290 --> 00:06:02,420
مهلاً

91
00:06:02,420 --> 00:06:06,000
كنّا نبحث طوال هذا الوقت ولم نعثر على شيء

92
00:06:07,750 --> 00:06:12,890
هذا صحيح. والجزيرة بأكملها تعتقد
...بأنّنا الطّيف زيرو

93
00:06:12,890 --> 00:06:15,350
يبدو أنّنا وصلنا إلى نهاية مسدودة

94
00:06:15,350 --> 00:06:18,020
لا. تكمن لمحتنا في السّماوات أعلاه

95
00:06:18,350 --> 00:06:19,520
السّماوات؟

96
00:06:21,140 --> 00:06:22,390
مارك توين

97
00:06:22,900 --> 00:06:25,150
قيل بأنّها موطِن الطّيف زيرو

98
00:06:25,150 --> 00:06:28,570
جزيرة حيث قيل بأنّ الطّيف يقطنها

99
00:06:28,570 --> 00:06:31,030
اسمي أناليتيكا

100
00:06:31,360 --> 00:06:36,030
حسناً يا سيّد أناليتيكا، كيف كان شعوروك
ككائن ذكيّ اصطناعيّ مدنيّ؟

101
00:06:36,450 --> 00:06:39,040
صنعتُ مارك توين

102
00:06:39,040 --> 00:06:42,920
بعد ذلك، دمجتُ البيانات الّتي سرقتموها
من الطّيف زيرو

103
00:06:42,920 --> 00:06:45,460
بما كانت تحتويه الكبسولة

104
00:06:45,460 --> 00:06:52,050
نتيجة ذلك، اكتشفتُ بأنّ مارك توين تحتوي
على بيانات عن أوقات ظهور الطّيف زيرو

105
00:06:52,050 --> 00:06:54,840
كلّ ما علينا فعله الآن هو إيجادها

106
00:06:54,840 --> 00:06:57,890
حصلت على كلّ هذا من الكبسولة أيضاً؟

107
00:06:57,890 --> 00:06:58,930
أجل

108
00:06:58,930 --> 00:07:00,390
...خطّة مُوفَّقة

109
00:07:00,390 --> 00:07:03,770
لكن أليست كلّ البيانات التي
تحتاجها في المكتب؟

110
00:07:03,770 --> 00:07:09,400
يمكننا أن نفترض بأنّ المكتب قد
نُبِشَ وجُرِّدَ الآن

111
00:07:09,400 --> 00:07:11,030
ماذا نفعل إذاً؟

112
00:07:11,030 --> 00:07:12,570
نفدت خياراتنا؟

113
00:07:12,570 --> 00:07:15,070
لا. ما زال هناك ورقة أخرى يمكننا اللّعب بها

114
00:07:15,070 --> 00:07:17,240
لكن أوّلاً، علينا أن نكسب الوقت

115
00:07:17,660 --> 00:07:20,870
لذا سوف نقوم بتشتيت الانتباه
باستغلال الظّرف الّذي نحن فيه

116
00:07:20,870 --> 00:07:22,160
وما هي الخطّة؟

117
00:07:28,210 --> 00:07:29,130
ماذا؟

118
00:07:30,250 --> 00:07:32,710
أنت عزيز هانك الصّغير

119
00:07:36,260 --> 00:07:39,510
يا إلهي. لم تتلقَّ تدريباً كافياً، أليس كذلك؟

120
00:07:41,770 --> 00:07:42,770
...هذا

121
00:07:45,810 --> 00:07:48,770
تبدو الأمور فوضويّة

122
00:07:48,770 --> 00:07:50,270
الأمور سيّئة الآن

123
00:07:50,270 --> 00:07:52,150
هكذا يبدو

124
00:07:52,610 --> 00:07:56,030
لا أحبّذ السّؤال، لكن هل بمقدوركِ
تحليل هذا لأجلي؟

125
00:07:56,030 --> 00:07:58,370
حسناً، حسناً. أليس هذا إطراء كبيراً لي؟

126
00:07:59,030 --> 00:08:00,280
اعتبر هذا قد تمّ

127
00:08:00,700 --> 00:08:02,540
أنا متشوّقة للبدء

128
00:08:11,670 --> 00:08:12,750
...يا مُفكِّرة

129
00:08:13,380 --> 00:08:16,880
"قال أحدهم ذات مرّة، "لا أؤمن بالمُعجزات

130
00:08:16,880 --> 00:08:18,300
!زيرو-رو

131
00:08:18,300 --> 00:08:19,800
!زيرو! زيرو

132
00:08:21,350 --> 00:08:24,020
يمكن لقلوب النّاس أن تتغيّر بسرعة

133
00:08:25,060 --> 00:08:29,350
يفعلون مُختلَف الأمور إذا كان
ذلك يجعل شخصاً يحبّهم

134
00:08:31,480 --> 00:08:35,030
وحتّى أنّهم يلجؤون للأكاذيب إذا كان
ذلك سيجعل شخصاً يحسدهم

135
00:08:36,400 --> 00:08:38,030
لكن ماذا عن الأصدقاء؟

136
00:08:38,410 --> 00:08:40,570
هناك شيء وحدهم الأصدقاء مَن يستطيعون فعله"

137
00:08:40,570 --> 00:08:44,660
وهو الوقوف بجانبك حتّى وأنت مخطئ

138
00:08:44,660 --> 00:08:47,410
تقريباً الجميع سيقفون معك عندما تكون على حقّ

139
00:08:50,250 --> 00:08:53,630
لكن أصدقاؤك؟ سيُعينونك مهما كلّف الأمر

140
00:08:56,630 --> 00:09:00,430
"لذا ينبغي أن تؤمن بأصدقائك

141
00:09:05,930 --> 00:09:06,980
...ولهذا السّبب

142
00:09:19,490 --> 00:09:20,660
فعلتُها

143
00:09:23,580 --> 00:09:24,660
ماذا؟

144
00:09:25,580 --> 00:09:27,410
هذه مُشكلة

145
00:09:29,670 --> 00:09:32,130
توقّفي! أوقفي ما تفعلينه

146
00:09:32,630 --> 00:09:35,920
أنتِ مُتّهمة بكونكِ مُتواطئة مع الطّيف زيرو

147
00:09:36,510 --> 00:09:38,170
ستُنقَلين إلى مركز عزل

148
00:09:40,840 --> 00:09:42,260
...لكن المُعجزات

149
00:09:44,640 --> 00:09:47,060
برقّة من فضلكما

150
00:09:51,650 --> 00:09:53,060
!لقد أفلت

151
00:09:53,060 --> 00:09:54,980
إنّه مجرّد كلب روبوت. دعه

152
00:09:54,980 --> 00:09:56,360
نعم. آسف بشأن ذلك

153
00:10:05,910 --> 00:10:07,620
لا أؤمن بالمُعجزات

154
00:10:10,500 --> 00:10:11,870
كيف سارت الأمور؟

155
00:10:11,870 --> 00:10:14,130
صادفَ واتسون جماعة مركز الزبائن

156
00:10:14,130 --> 00:10:15,540
قُبِضَ عليه

157
00:10:15,540 --> 00:10:16,750
هكذا إذاً

158
00:10:17,380 --> 00:10:20,220
هل من نبأ عن مدام؟

159
00:10:20,220 --> 00:10:24,590
تمّ إغلاق مُنشأتها. غالباً عثرَت
عليها فِرق البحث

160
00:10:24,590 --> 00:10:25,720
!مستحيل

161
00:10:25,720 --> 00:10:27,970
حقّاً؟ قبضوا على مدام أيضاً؟

162
00:10:28,470 --> 00:10:30,480
!أنت! من هناك؟! اكشف عن نفسك

163
00:10:32,980 --> 00:10:35,190
دوغّو! أنت بخير

164
00:10:35,190 --> 00:10:37,230
كيف عرفت مكننا؟

165
00:10:37,110 --> 00:10:40,240
!جيّد! جيّد! جيّد

166
00:10:37,860 --> 00:10:39,690
طلبتُ منه تسليم رسالة لمدام

167
00:10:42,700 --> 00:10:44,950
ثمّة شيء في مؤخّرته

168
00:10:44,950 --> 00:10:46,240
دعني أرى

169
00:10:48,240 --> 00:10:49,750
أحسنتِ صنعاً يا مدام

170
00:10:50,330 --> 00:10:51,410
...إذاً، هذا

171
00:10:51,410 --> 00:10:53,170
تركَتْ لنا هديّة

172
00:10:53,170 --> 00:10:54,830
هذا مُبهر يا مهووسة

173
00:10:54,830 --> 00:10:56,590
!أجل! هذا جميل

174
00:10:57,380 --> 00:11:03,630
مقبول. مرفوض. مقبول. مرفوض

175
00:11:00,880 --> 00:11:03,630
مرفوض

176
00:11:04,430 --> 00:11:05,640
...حضرة المُدير

177
00:11:05,970 --> 00:11:09,430
إليك ما وجدناه بعد فرز البيانات من أساسها

178
00:11:09,850 --> 00:11:12,350
!إنّهم هُم! أولئك الأشخاص

179
00:11:12,560 --> 00:11:13,390
أجل

180
00:11:13,810 --> 00:11:16,400
،المُدَّعى عليه الهارب من المُحاكمة السرّية

181
00:11:16,980 --> 00:11:19,400
والمُتواطئة مع الهارب. بلا أدنى شكّ

182
00:11:19,820 --> 00:11:22,740
وردَ في السجلّات بأنّ كليهما ماتا أثناء المُطاردة

183
00:11:23,110 --> 00:11:26,070
هل زُيِّفَ كلّ هذا؟ عُدِّل؟

184
00:11:26,070 --> 00:11:29,830
مستحيل. لحظة، هل يُعقَل أن يكونا الطّيف زيرو؟

185
00:11:29,830 --> 00:11:32,950
علينا اعتقالهما هذه المرّة مهما كلّف الأمر

186
00:11:33,210 --> 00:11:36,290
وأين هي قاعدة الطّيف زيرو السرّية؟

187
00:11:36,290 --> 00:11:40,920
نتائج المرجعيّات المُتقاطعة عن أماكن
ظهور الطّيف زيرو ينبغي أن تكون هناك

188
00:11:41,670 --> 00:11:42,960
!هذه هي

189
00:11:46,760 --> 00:11:48,800
مارك توين إذاً

190
00:11:48,800 --> 00:11:50,350
!لنذهب إلى هناك حالاً

191
00:11:50,350 --> 00:11:53,940
مهلاً. لا يمكننا مُعاينة هذا أكثر من هنا

192
00:11:57,810 --> 00:12:00,070
...ماذا؟ لكن المكتب

193
00:12:00,070 --> 00:12:02,570
أجل. أغلقوه

194
00:12:02,570 --> 00:12:05,950
ومن المؤكّد أنّهم صادروا أس.أو.أس كذلك

195
00:12:05,950 --> 00:12:09,570
ماذا عن هانك؟ أنا واثقة بأنّه بنى واحداً جديداً

196
00:12:09,570 --> 00:12:12,330
لم أتمكّن من الوصول إليه. إنّه مفقود

197
00:12:12,330 --> 00:12:16,410
...مستحيل. وبعد أن وجدت مدام ما احتجناه

198
00:12:17,500 --> 00:12:19,130
أنا آسفة يا مُفكِّرة

199
00:12:20,130 --> 00:12:21,800
...لكن فيما يخصُّ المُعجزات

200
00:12:25,340 --> 00:12:26,340
!استيقظوا

201
00:12:27,880 --> 00:12:30,010
لقد حاصرونا

202
00:12:30,010 --> 00:12:32,010
كم يبدو هذا مُزعجاً

203
00:12:33,270 --> 00:12:34,350
ماذا نفعل؟

204
00:12:34,350 --> 00:12:35,730
سنهرب من الخلف

205
00:12:35,730 --> 00:12:37,350
هيّا يا سمايلي

206
00:12:37,350 --> 00:12:38,600
ما الّذي يجري؟

207
00:12:38,600 --> 00:12:39,810
!بسرعة

208
00:12:41,820 --> 00:12:43,400
!نحن من مركز الزبائن

209
00:12:43,400 --> 00:12:45,610
!الطّيف زيرو، تعال بهدوء

210
00:12:45,610 --> 00:12:46,400
!يا للهول

211
00:12:48,280 --> 00:12:49,110
!سمايلي

212
00:12:55,100 --> 00:12:56,410
!باب

213
00:12:57,040 --> 00:12:58,580
!...لن تذهبي

214
00:12:58,580 --> 00:12:59,250
!هيّا

215
00:12:59,250 --> 00:13:01,130
...دعيني أيّتها

216
00:13:01,130 --> 00:13:03,130
!توقّفي عن ذلك

217
00:13:02,380 --> 00:13:05,710
لن تكون هناك أيّ مُعجزات

218
00:13:07,390 --> 00:13:10,350
مقبول. مرفوض. مقبول

219
00:13:10,350 --> 00:13:14,350
مرفوض

220
00:13:15,060 --> 00:13:15,980
—مرفوض

221
00:13:16,350 --> 00:13:16,850
هل هذا هو الشّخص الصّحيح؟

222
00:13:16,350 --> 00:13:16,850
بيري؟

223
00:13:16,350 --> 00:13:16,850
وسم شرح

224
00:13:16,350 --> 00:13:16,850
إضافة شرح

225
00:13:16,350 --> 00:13:16,850
معلومات

226
00:13:16,850 --> 00:13:18,860
هل هذا هو الشّخص الصّحيح؟

227
00:13:16,850 --> 00:13:18,860
بيري؟

228
00:13:19,320 --> 00:13:20,190
—مرفوض

229
00:13:22,860 --> 00:13:27,360
بيري؟

230
00:13:22,860 --> 00:13:27,360
هل هذا هو الشّخص الصّحيح؟

231
00:13:24,910 --> 00:13:27,370
"احصل على حقائقك أوّلاً"

232
00:13:28,030 --> 00:13:34,370
"ثمّ يمكن تشويهها قدر ما تشاء"
من كان من قال ذلك يا مُفكِّرة؟

233
00:13:35,500 --> 00:13:36,880
بيري؟

234
00:13:40,760 --> 00:13:42,300
لا أرى أيّ تحرّكات

235
00:13:43,380 --> 00:13:47,390
فوضى زيرو هذه من الأمس ما زالت
لم تُفرَز. لدينا أعمال نقوم بها

236
00:13:47,890 --> 00:13:49,260
عملكم؟

237
00:13:49,260 --> 00:13:53,390
هذا صحيح. نحرص على ألّا يرى النّاس
أشياء تُثير قلقهم

238
00:13:53,390 --> 00:13:54,770
إنّه عملٌ مهمٌّ جدّاً

239
00:13:54,770 --> 00:13:58,480
لكن ماذا يحدث إذا لم يعد النّاس
يميّزون ما هو حقيقيّ بعد الآن؟

240
00:13:58,480 --> 00:14:04,490
اسمعي. إذا كان شيئاً مهمّاً، فإنّ
حذفه لن يُزيله تماماً، صحيح؟

241
00:14:04,490 --> 00:14:06,610
!لكن أليس هذا مجرّد كذِب؟

242
00:14:06,610 --> 00:14:07,370
!بيري

243
00:14:09,280 --> 00:14:12,910
هذا صحيح. ولهذا لن تكون هناك مُعجزات

244
00:14:27,800 --> 00:14:32,720
أعتقد أنّ أمّي وأبي كشفاني
في أوّل مرّة كذبتُ عليهما

245
00:14:33,350 --> 00:14:35,190
لكن لم يغضبا

246
00:14:35,770 --> 00:14:39,360
كذبتُ لأنّني كنتُ خائفة من غضبهما

247
00:14:40,150 --> 00:14:45,150
لم أعترف بأنّني تشاجرت. قلتُ
بأنّ صديقي تعثّر وسقط عليّ

248
00:14:45,150 --> 00:14:47,070
...فقال أبي

249
00:14:47,070 --> 00:14:48,820
هكذا إذاً

250
00:14:48,820 --> 00:14:53,370
زميل الصفّ هو صديق، صحيح؟
ليس باليد حيلة

251
00:14:53,830 --> 00:14:55,910
أنا آسفة يا أبي

252
00:14:55,910 --> 00:14:57,370
لا عليكِ يا بيري

253
00:14:58,080 --> 00:15:00,880
يا مُفكِّرة، أنا كاذبة

254
00:15:01,170 --> 00:15:05,510
جميعنا كاذبون. لأنّه لن تكون هناك أيّ مُعجزات

255
00:15:06,090 --> 00:15:09,390
لكنّنا نفعل هذا لحماية أصدقائنا

256
00:15:19,190 --> 00:15:20,400
مقبول

257
00:15:21,650 --> 00:15:24,230
ما الأمر؟ هل من مشكلة؟

258
00:15:24,230 --> 00:15:26,530
لا. لا شيء هنا سيّدي

259
00:15:27,150 --> 00:15:29,820
هكذا إذاً. حسناً، واظبي على العمل إذاً

260
00:15:42,420 --> 00:15:42,920
إلغاء

261
00:15:46,170 --> 00:15:48,300
اهربي يا بيري

262
00:15:50,140 --> 00:15:52,050
!انظروا

263
00:15:52,050 --> 00:15:54,100
!شوهِد في الحيّ 3

264
00:15:54,100 --> 00:15:56,430
!مكتوب هنا الحيّ 3 أيضاً! هيّا بنا

265
00:16:03,940 --> 00:16:07,280
ترِدنا العديد من تقارير شهود
!العيان في الحيّ 3

266
00:16:07,280 --> 00:16:10,610
أغلقوا الأحياء المُجاورة وأرسلوا كافّة قوّاتنا

267
00:16:16,830 --> 00:16:19,960
عُلِم يا سيّدي. التوجّه إلى الحيّ 3 الآن

268
00:16:22,460 --> 00:16:24,340
يبدو أنّنا بأمان حاليّاً

269
00:16:24,340 --> 00:16:25,800
ماذا عن سمايلي؟

270
00:16:25,800 --> 00:16:28,920
يجب أن تكون أولويّتنا تحليل تلك البيانات

271
00:16:28,920 --> 00:16:31,300
فهذا سيفضي إلى مساعدتهم

272
00:16:31,300 --> 00:16:32,590
هلُمّ بنا يا مهووسة

273
00:16:34,640 --> 00:16:36,760
...حسناً يا مُفكِّرة

274
00:16:44,980 --> 00:16:47,980
!الحيّ 3! العثور على الطّيف زيرو

275
00:16:52,910 --> 00:16:53,990
هذه مُعجزة؟

276
00:17:07,630 --> 00:17:08,920
!حدثَ ذلك فعلاً

277
00:17:10,300 --> 00:17:12,220
!شكراً على مساعدتنا

278
00:17:12,680 --> 00:17:15,010
المعلومات غير الدّقيقة هي ضربٌ من الشُّرور

279
00:17:15,010 --> 00:17:18,770
ما يعني بأنّ هذه الادّعاءات الباطلة
بأنّكم جميعاً الطّيف زيرو

280
00:17:18,770 --> 00:17:22,770
والتّضخيم الإعلامي لها في كلّ أرجاء
المدينة هي ضرب من الشّرور أيضاً

281
00:17:22,770 --> 00:17:24,650
أريد أن أسألك شيئاً

282
00:17:25,360 --> 00:17:30,030
هلّا سمحت لنا باستخدام عتاد بناء عوالم
السّحابة الفائقة الخاصّة بمُنشأتك؟

283
00:17:31,610 --> 00:17:33,780
إنّه هنا

284
00:17:33,780 --> 00:17:35,910
الوقت يُداهمنا. لنبدأ بالنمذجة

285
00:17:35,910 --> 00:17:37,120
!حسناً

286
00:17:39,040 --> 00:17:41,450
حسناً. لنشرع في التّحليل

287
00:17:41,450 --> 00:17:42,790
عُلِم

288
00:17:49,300 --> 00:17:52,800
!ساحرة، ساحرة، ساحرة، ساحرة... الخلل البرمجيّ

289
00:17:59,140 --> 00:18:03,140
يا له من مكان مُفاجئ نحظى
فيه بلقائنا الّذي يدفئ القلوب

290
00:18:03,810 --> 00:18:06,850
رغم أنّها ليست الأجواء المناسبة

291
00:18:06,850 --> 00:18:08,110
...جدّتي

292
00:18:17,320 --> 00:18:18,830
هل تُحسنان السّلوك؟

293
00:18:18,830 --> 00:18:21,200
لا تُقدِمي على أيّ عمل طائش يا عجوز

294
00:18:22,910 --> 00:18:24,080
بالطبع

295
00:18:24,830 --> 00:18:26,500
فهمت

296
00:18:36,340 --> 00:18:39,100
هل تُحسن السّلوك بمفردك هنا؟

297
00:18:51,230 --> 00:18:52,360
!هذا سيّئ

298
00:18:52,360 --> 00:18:54,360
!مركز الزبائن قادم

299
00:18:54,650 --> 00:18:55,740
شارفنا على الانتهاء

300
00:18:56,360 --> 00:18:58,360
!علينا الإسراع

301
00:19:00,330 --> 00:19:01,370
ماذا؟

302
00:19:01,700 --> 00:19:02,870
هذه هي

303
00:19:03,450 --> 00:19:06,160
نحن من مركز الزبائن! أنتم الطّيف زيرو، صحيح؟

304
00:19:06,620 --> 00:19:08,880
!هؤلاء ليسوا الطّيف زيرو

305
00:19:08,880 --> 00:19:13,050
!إنّهم مُتحرّيون موهوبون من نادي يوري للتحرّيات

306
00:19:13,050 --> 00:19:15,420
!كفى هراء وتنحَّ جانباً

307
00:19:15,420 --> 00:19:17,030
لا يمكنني فعل ذلك

308
00:19:22,220 --> 00:19:24,180
!ما هذه الأشياء بالضبط؟

309
00:19:24,180 --> 00:19:27,230
...حذارِ من اللّيالي الّتي يزأر فيها نوي

310
00:19:27,940 --> 00:19:29,400
!شكراً لكم جميعاً

311
00:19:31,060 --> 00:19:33,230
هنا يبدأ الجزء الصّعب

312
00:19:33,230 --> 00:19:34,570
هل تفهم يا هاك؟

313
00:19:34,570 --> 00:19:36,240
!أنا. أحبّ. آي

314
00:19:36,740 --> 00:19:38,910
إذاً لنغادر إلى السّماء

315
00:19:40,740 --> 00:19:42,370
والآن فلنبدأ

316
00:19:42,370 --> 00:19:44,740
...أحجيتي مُحيّرة

317
00:19:45,160 --> 00:19:49,000
لكن لا يوجد لغز لا يمكن حلّه

318
00:19:49,000 --> 00:19:51,250
لا داعي من القلق حيال ذلك

319
00:19:51,580 --> 00:19:54,500
لكن تكمن المسألة في السّرعة

320
00:19:54,500 --> 00:19:58,510
من ابتكر هذه الوسائل المستحيلة وكيف؟

321
00:19:59,380 --> 00:20:03,510
اجمعوهم هنا. يمكننا الإمساك
بهم جميعاً في آن واحد

322
00:20:03,760 --> 00:20:06,600
تقارير عن هرب روبوت من مُنشأة عزل؟

323
00:20:06,600 --> 00:20:10,020
لا يهمّ الآن. يجب علينا التّركيز
على تعقُّب الطّيف زيرو

324
00:20:15,400 --> 00:20:16,530
!توقّفوا مكانكم

325
00:20:18,190 --> 00:20:19,450
!هذه مُصيبة

326
00:20:20,820 --> 00:20:22,780
حسناً؟ ماذا أنتم فاعلون؟

327
00:20:24,370 --> 00:20:24,990
!تبّاً

328
00:20:24,990 --> 00:20:26,540
!سنتولّى هذا الامر

329
00:20:26,540 --> 00:20:32,040
وماذا فعلوا حتّى نجحوا في ذلك؟
هذه أسئلة تحتاج لإجابة

330
00:20:41,800 --> 00:20:42,840
!اللّعنة

331
00:20:45,300 --> 00:20:46,970
!حضرة المُديرَ! هناك قطّ

332
00:20:46,970 --> 00:20:49,560
!أرى ذلك! حاصروا زيرو

333
00:20:51,940 --> 00:20:54,560
!تحرّكوا! الوقت يُداهمنا

334
00:20:56,610 --> 00:21:00,490
!لا فُرصة كهذه الفرصة الخطيرة، لا لا لا

335
00:21:00,780 --> 00:21:05,370
أجل، يجب أن تعزّز سرعة تفكيرك
حتّى تتفوّق على كلِّ الآخرين

336
00:21:16,540 --> 00:21:17,840
!تمّ القبض عليكم

337
00:21:18,500 --> 00:21:20,510
!الطّيف زيرو

338
00:21:21,130 --> 00:21:25,510
لم يعد أمامكم مفرّ. سلّموا أنفسكم بهدوء

339
00:21:25,510 --> 00:21:26,890
هل أنتم متأكّدون من ذلك؟

340
00:21:26,890 --> 00:21:28,640
!أنا. أحبّ. آي

341
00:21:29,720 --> 00:21:30,930
حان الوقت

342
00:21:31,520 --> 00:21:33,940
بإشارة منكم آتي

343
00:21:34,160 --> 00:21:35,480
!مفاجأة

344
00:21:35,480 --> 00:21:36,310
أجل

345
00:21:37,190 --> 00:21:38,190
!دورون

346
00:21:38,190 --> 00:21:39,690
!قرار حكيم يا باب

347
00:21:39,730 --> 00:21:40,940
!ماذا؟

348
00:21:44,610 --> 00:21:47,410
سنشدّ الرّحال إلى ما يقع وراء بحر الغيوم

349
00:21:49,330 --> 00:21:51,450
...السّماء! أو كما نُطلِق عليها

350
00:21:51,450 --> 00:21:52,870
!مارك توين

351
00:21:56,580 --> 00:22:02,220
،الطّيف زيرو هو ساحر من حكاية خرافيّة
قادر على فعل أشياء لا يستطيع فعلها آخر