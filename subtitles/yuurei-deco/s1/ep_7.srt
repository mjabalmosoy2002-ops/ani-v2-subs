1
00:00:02,270 --> 00:00:06,480
انتبهي، انتبهي يا عزيزتي

2
00:00:09,900 --> 00:00:12,990
سقط هذا من السّماء، صحيح؟

3
00:00:15,130 --> 00:00:17,990
ربّما تعاشرَ طاووسان بين الغيوم

4
00:01:58,630 --> 00:01:59,840
مللت

5
00:01:59,840 --> 00:02:01,840
...أتمنّى لو نحصل على قضيّة

6
00:02:01,840 --> 00:02:04,010
!سيّد قطقوط

7
00:02:07,600 --> 00:02:09,100
ماذا يفعل؟

8
00:02:10,800 --> 00:02:14,940
صدّقني، العربة الغامضة تبيع تونكوتسو رامن

9
00:02:14,940 --> 00:02:17,240
وسمعتُ بأنّها تبيع نكهة صلصة الصّويا

10
00:02:18,240 --> 00:02:19,880
عمّاذا تتكلّمون؟

11
00:02:19,880 --> 00:02:23,680
يا آنسة، ألم تسمعي بالعربة الغامضة؟

12
00:02:23,680 --> 00:02:25,070
العربة الغامضة؟

13
00:02:25,730 --> 00:02:31,580
أجل! إنّها عربة الرّامن الغامضة الّتي
لا يعرف أحد كيف يجدها

14
00:02:31,580 --> 00:02:34,840
رغم ذلك، انتشرت إشاعاتها كما ينتشر
النّار في الهشيم وهي الآن أسطوريّة

15
00:02:34,840 --> 00:02:38,960
لماذا يعتقد الجميع بأنّها عربة جيّدة وهم
لم يجدوها ولم يأكلوا منها بعد؟

16
00:02:38,960 --> 00:02:41,840
في الواقع، يقول بعض النّاس بأنّهم
أكلوا منها سابقاً

17
00:02:42,370 --> 00:02:46,030
تمكّن صديقُ صديقٍ لي من نيل
نصيبه من ذلك الرّامن

18
00:02:46,030 --> 00:02:49,520
قال بأنّ امتزاج مرقة التونكوتسو الغنيّة
مع المعكرونة الرّفيعة

19
00:02:49,520 --> 00:02:51,840
جعله أفضل طبق يحظى به على الإطلاق

20
00:02:52,140 --> 00:02:59,390
لا، قال صديقي بأنّها معكرونة ثخينة وحريريّة
تُقدّم مع لحم خنزير مشويّ ريّان

21
00:02:59,390 --> 00:03:02,900
في حساء صويا نقيّ مجيد يستمدّ
نكهته السّامية

22
00:03:02,900 --> 00:03:05,250
من السّردين المُجفّف المُستخدَم كمرقة

23
00:03:05,250 --> 00:03:07,460
سمعتُ أنّه كان رامن هاواي الأزرق

24
00:03:07,460 --> 00:03:08,870
!هذا مستحيل

25
00:03:09,670 --> 00:03:11,430
تعلم بالأمر كذلك يا هاك؟

26
00:03:11,430 --> 00:03:14,200
مجرّد إشاعة منذ زمن بعيد ومن مكان ما

27
00:03:15,340 --> 00:03:17,830
وماذا تفعل يا واتسون؟

28
00:03:19,080 --> 00:03:21,550
مهلاً، إلى أين أنت ذاهب؟

29
00:03:21,550 --> 00:03:23,280
!لنغادر ونلحق بقطقوط

30
00:03:23,280 --> 00:03:24,600
!انتظر

31
00:03:25,560 --> 00:03:27,250
عربة الرّامن المُشاعة؟

32
00:03:27,250 --> 00:03:28,600
سمعتُ عنها بالطبع

33
00:03:28,880 --> 00:03:35,920
يقول جدّ صديقتي بأنّه يريد أن يأكل
هناك ثانية قبل أن يموت

34
00:03:36,610 --> 00:03:41,110
أجل، سمعتُ بها. يقدّمون رامن هاواي
الأزرق هناك، أليس كذلك؟

35
00:03:41,450 --> 00:03:44,600
عربة غامضة؟ تقصد مطعم الرّامن القاتل؟

36
00:03:45,130 --> 00:03:47,070
،صديقُ صديقي أكلَ هناك

37
00:03:47,070 --> 00:03:50,480
.وأصيبَ بحُمّى لثلاثة أيّام بعدها
ظنّ نفسه سوف يموت

38
00:03:51,120 --> 00:03:55,000
قال شيئاً عن أنّ المالِك هو
رجل آليّ يكره البشر

39
00:03:55,000 --> 00:03:58,040
ويريد إبادتنا بالرّامن

40
00:03:58,040 --> 00:03:59,120
هل هو مخبول؟

41
00:03:59,590 --> 00:04:02,010
هل تتحرّى عن إشاعات عربة الرّامن؟

42
00:04:04,640 --> 00:04:05,480
بحث

43
00:04:04,640 --> 00:04:07,640
إشاعات عربة الرّامن

44
00:04:06,590 --> 00:04:09,640
هذا صحيح بالفعل. لا معلومات عنها إطلاقاً

45
00:04:10,480 --> 00:04:13,420
هل هناك مطعم حقّاً غير مُدرَج
في قائمة أطعمة ديكو؟

46
00:04:13,970 --> 00:04:18,150
حسناً، هذا المكان موجود فقط على ألسنة النّاس

47
00:04:18,420 --> 00:04:21,520
لم أسمع بهذا الرّامن الأسطوري بحدّ ذاتي

48
00:04:21,520 --> 00:04:23,100
أنا أيضاً

49
00:04:23,100 --> 00:04:25,360
لكنّها مجرّد إشاعات غالباً، صحيح؟

50
00:04:25,680 --> 00:04:28,370
كيف اكتشفت الأمر يا واتسون؟

51
00:04:28,370 --> 00:04:30,520
يبدو أنّه يجمع الإشاعات

52
00:04:31,920 --> 00:04:32,870
أليس كذلك؟

53
00:04:36,800 --> 00:04:37,870
تفضّل

54
00:04:45,380 --> 00:04:46,610
ما هذا؟

55
00:04:47,260 --> 00:04:49,330
الإشاعات التي جمعها واتسون

56
00:04:51,720 --> 00:04:57,150
مالكة الحانة في الحيّ 16 تواجه"
مشكلة مع رجل أصغر سنّاً"؟

57
00:04:58,240 --> 00:05:02,900
فتى من محلّ حلويّات يابانيّ يواعد فتاة"
من متجر يبيع الكعك"؟

58
00:05:05,960 --> 00:05:08,900
!هذا مضحك! هناك نظريّة ـقول بأنّ المدام 44 ميّتة

59
00:05:08,900 --> 00:05:11,250
حسناً، من المؤكّد أنّها إشاعة سخيفة

60
00:05:11,250 --> 00:05:15,790
.يُعتقَد بأنّ سمايلي تكذب بشأن سنّها"
"!رغم مظهرها، عمرها 50 في حقيقة الأمر

61
00:05:15,790 --> 00:05:16,910
!ماذا؟

62
00:05:17,430 --> 00:05:20,410
"ابن عائلة محلّية يخطّط لأمور سيّئة حقّاً"

63
00:05:20,620 --> 00:05:23,930
"أمّ محلّية غُسِل دماغها على ما يبدو"

64
00:05:24,420 --> 00:05:26,670
"أحدهم ذهبَ إلى القمر مرّة على ما يظهر"

65
00:05:26,980 --> 00:05:29,170
"بيدَ أنّ رحلة القمر تلك كذبة"

66
00:05:30,200 --> 00:05:32,170
وتحبّ جمع هذه يا واتسون؟

67
00:05:33,690 --> 00:05:35,550
سوف تتحرّى عن كلّ هذه الإشاعات؟

68
00:05:37,530 --> 00:05:39,350
فقط عربة الرّامن الغامضة؟

69
00:05:40,190 --> 00:05:41,350
لماذا؟

70
00:05:41,350 --> 00:05:43,680
"لا تدوم الأعجوبة إلّا تسعة أيّام"

71
00:05:44,080 --> 00:05:47,390
معظم الأوقات، تكون الإشاعات حاضرة
اليوم، وتختفي غداً

72
00:05:47,390 --> 00:05:51,480
لكن كان النّاس يتحدّثون عن عربة
الرّامن هذه منذ كنتُ طفلاً

73
00:05:52,770 --> 00:05:56,890
غالباً اهتمام واتسون بهذه الإشاعة
جعلَها تدوم فترة أطول

74
00:05:57,770 --> 00:06:00,120
"أنا أريد أيضاً أن آكل بعضاً من الرّامن"

75
00:06:02,160 --> 00:06:06,000
أفهمك. من ذا الّذي لا يريد أكل
رامن تحوم حوله إشاعات كثيرة؟

76
00:06:06,000 --> 00:06:10,720
ما رأيكم بقيام نادي يوري للتحرّيات
بالبحث عن عربة الرّامن الغامضة هذه؟

77
00:06:12,720 --> 00:06:15,620
لست مهتمّاً برامن لذيذ إلى الحدّ
الّذي يجعله سرّاً ولغزاً؟

78
00:06:15,620 --> 00:06:17,690
تبقى الإشاعات إشاعات

79
00:06:18,900 --> 00:06:21,720
ما لم أرها بأمّ عيني، فهي ليست حقيقيّة

80
00:06:22,280 --> 00:06:24,240
سأرفض أيضاً

81
00:06:24,240 --> 00:06:27,600
.لن أحصل على أيّ حُبّ من إشاعات
لستُ من أنصار ذلك

82
00:06:27,600 --> 00:06:30,250
لا أحبّ الرّامن حقّاً

83
00:06:30,250 --> 00:06:31,880
أنا مشغول

84
00:06:31,880 --> 00:06:33,120
أعتذر يا فتاة

85
00:06:34,580 --> 00:06:36,750
...مهلاً، مهلاً، مهلاً

86
00:06:36,750 --> 00:06:39,760
حسناً! سوف نبحث عنها بمفردنا

87
00:06:39,760 --> 00:06:42,450
وآكل هذه الرّامن الّذي يتحدّث عنه الجميع

88
00:06:42,890 --> 00:06:49,170
سأبدأ بالتكلّم مع "أصدقاء الأصدقاء" هؤلاء
الّذين يُزعَم بأنّهم أكلوا هذا الرّامن

89
00:06:49,170 --> 00:06:50,360
ماذا عنك يا واتسون؟

90
00:06:53,360 --> 00:06:56,560
"سأتوجّه إلى حيث تنتشر مُعظم الإشاعات"

91
00:06:56,560 --> 00:07:00,330
حسناً. إذاً لننفصل ونبدأ بجمع المعلومات

92
00:07:02,140 --> 00:07:03,970
تريدين التكلّم مع صديقي؟

93
00:07:05,740 --> 00:07:07,990
في الواقع، يعمل في المتجر هناك

94
00:07:08,270 --> 00:07:11,750
ماذا؟ تريدين التكلّم مع الشّخص الّذي
أكل في العربة الغامضة؟

95
00:07:11,750 --> 00:07:12,990
...لا أمانع، لكن

96
00:07:12,990 --> 00:07:17,580
اسمعي، لم أكن الشّخص الّذي ذهب إلى
هناك فعليّاً. سمعتُ عنها من صديقة فحسب

97
00:07:17,580 --> 00:07:18,990
تريدين التكلّم معها؟

98
00:07:19,260 --> 00:07:21,500
سمعتُ عنها من صديق أيضاً

99
00:07:22,140 --> 00:07:25,000
في الواقع سمعتُ عنها من صديقة صديقتي

100
00:07:25,420 --> 00:07:27,000
تريدين التكلّم معها؟

101
00:07:27,520 --> 00:07:29,000
...لا أتذكّر في الواقع

102
00:07:29,520 --> 00:07:31,920
أمهليني لحظة. لعلّي ما زلتُ أحمل الرّسالة

103
00:07:37,400 --> 00:07:38,500
المعذرة

104
00:07:38,780 --> 00:07:44,480
...سمعتُ من جوني بأنّك زرتَ العربة الغامضة من قبل

105
00:07:46,470 --> 00:07:50,360
أم أنّك سمعت عنها من صديق صديق أيضاً؟

106
00:07:53,780 --> 00:07:55,480
آسفة لإزعاجك

107
00:07:55,480 --> 00:07:56,380
صحيح

108
00:07:57,140 --> 00:07:59,290
!زرتَ العربة الغامضة؟

109
00:08:00,490 --> 00:08:01,280
صحيح

110
00:08:01,280 --> 00:08:02,600
!حقّاً؟

111
00:08:03,080 --> 00:08:03,790
صحيح

112
00:08:04,060 --> 00:08:06,610
أين يمكنني إيجاد هذه العربة الغامضة؟

113
00:08:06,610 --> 00:08:08,800
مارك توين

114
00:08:09,200 --> 00:08:10,840
مارك توين"؟"

115
00:08:10,840 --> 00:08:13,050
أيّ حيّ هو هذا؟ أين يمكنني إيجاده؟

116
00:08:14,630 --> 00:08:16,100
السّماوات

117
00:08:25,740 --> 00:08:32,060
يا مذكّرة، كلّ ما تعلّمتُه هو أنّ الأشياء الّتي يسمعها
النّاس من صديق صديق غير صحيحة بتاتاً

118
00:08:34,840 --> 00:08:36,000
كيف سارت الأمور؟

119
00:08:38,480 --> 00:08:39,430
ما الأمر؟

120
00:08:45,440 --> 00:08:46,580
!قيء

121
00:08:50,240 --> 00:08:51,160
خريطة؟

122
00:08:51,580 --> 00:08:52,840
!قيء قطّ

123
00:08:53,800 --> 00:08:55,590
المزيد من التقيّؤ؟

124
00:08:56,830 --> 00:09:00,540
إذاً ذهبتَ إلى غرفة انتظار في مشفى
تُعدّ وكراً للإشاعات

125
00:09:00,540 --> 00:09:03,240
،وبعد الاستماع للإشاعات هناك طوال اليوم

126
00:09:03,240 --> 00:09:06,680
وجدتَ شخصاً تعرّض لجروح أثناء
،بحثه عن العربة الغامضة

127
00:09:06,680 --> 00:09:08,680
وطلبت منه أن يرسم لك خريطة؟

128
00:09:09,970 --> 00:09:11,200
!هذا رائع

129
00:09:11,200 --> 00:09:14,690
!حسناً، لنذهب ونجد هذه العربة الغامضة

130
00:09:18,600 --> 00:09:23,520
لماذا ترافقني يا هاك؟ ظننتُك
لا تؤمن بالإشاعات

131
00:09:23,520 --> 00:09:26,540
!أريد رؤية قطقوط يفعل أشياء جديدة إضافيّة

132
00:09:27,950 --> 00:09:29,450
!قطقوط، تحوّل

133
00:09:29,450 --> 00:09:31,190
أشكّ في أنّه يعمل بهذا الشكل

134
00:09:33,240 --> 00:09:36,560
إنّها نهاية مسدودة. هل نسلك الطريق الصحيح؟

135
00:09:38,220 --> 00:09:41,600
...أتمزح معي؟ إذاً، العربة الغامضة

136
00:09:42,250 --> 00:09:43,470
في الأسفل هنا؟...

137
00:09:48,460 --> 00:09:50,480
الظلام دامس، بالكاد أستطيع الرؤية

138
00:09:52,280 --> 00:09:54,980
توجد عربة رامن في الأسفل هنا؟

139
00:09:57,230 --> 00:09:58,160
!هذا جميل

140
00:09:58,160 --> 00:09:59,290
!برّاق

141
00:09:59,290 --> 00:10:01,270
!سيّد فلاش

142
00:10:01,270 --> 00:10:04,200
!أنت مليء بالمفاجآت يا واتسون

143
00:10:29,090 --> 00:10:30,500
...جائع

144
00:10:30,500 --> 00:10:32,230
لديّ بسكويت. أتريد واحدة؟

145
00:10:34,310 --> 00:10:35,240
لا أريد

146
00:10:35,240 --> 00:10:37,150
لكن قلتَ بأنّك جائع؟

147
00:10:37,150 --> 00:10:38,520
أريد أكل رامن

148
00:10:38,520 --> 00:10:42,670
ماذا؟ ظننتُك لا تؤمن بالعربة الغامضة

149
00:10:43,400 --> 00:10:44,750
لا أؤمن بالإشاعات

150
00:10:45,040 --> 00:10:47,260
لكن أريد أكل رامن

151
00:10:47,260 --> 00:10:51,820
المهووسة لا تصمت بشأن الرّامن
!والآن هو كلّ ما يريده فمي

152
00:10:51,820 --> 00:10:52,560
ما هذا؟

153
00:10:52,560 --> 00:10:54,130
!كلّ شيء في فمي هو رامن

154
00:11:06,600 --> 00:11:09,630
ما هذا المكان؟ أين نحن؟

155
00:11:26,090 --> 00:11:27,400
...هل هذا

156
00:11:36,210 --> 00:11:38,500
هل تقدّم الرّامن هنا؟

157
00:11:39,140 --> 00:11:40,500
أجل

158
00:11:40,500 --> 00:11:42,500
!مرحى

159
00:11:42,870 --> 00:11:44,280
أهلاً بكم

160
00:11:45,220 --> 00:11:47,220
كانت الإشاعات صحيحة إذاً

161
00:11:47,220 --> 00:11:49,010
!رامن، رامن، رامن

162
00:11:52,370 --> 00:11:58,020
ما الّذي قادكم لتصديق الإشاعات
وقطع كلّ هذه المسافة؟

163
00:11:59,360 --> 00:12:01,040
!أردنا رامن

164
00:12:01,040 --> 00:12:02,520
أهذا كلّ شيء حقّاً؟

165
00:12:02,520 --> 00:12:08,770
هل صدّقتم الإشاعة وقطعتُم كلّ
هذه المسافة فقط بسبب الجوع؟

166
00:12:08,770 --> 00:12:11,330
كان هذا سببكم الوحيد لتصديق الإشاعة

167
00:12:11,330 --> 00:12:14,690
وشقّ الطريق الوعر إلى هنا؟

168
00:12:14,690 --> 00:12:17,020
!رامن، رامن، رامن

169
00:12:17,020 --> 00:12:19,030
ثلاثة أطباق من الرّامن رجاء

170
00:12:19,030 --> 00:12:19,830
!في الحال

171
00:12:20,700 --> 00:12:22,700
هل أنت إنسان آليّ؟

172
00:12:22,700 --> 00:12:23,420
أجل

173
00:12:23,940 --> 00:12:25,740
ما هذا المكان؟

174
00:12:25,740 --> 00:12:28,840
...حاولنا البحث حوله، لكن لم تعمل الخريطة

175
00:12:28,840 --> 00:12:31,690
هذا المكان غير مُدرَج في الخريطة

176
00:12:32,690 --> 00:12:35,040
لأنّني أنا من بنيتُه

177
00:12:35,630 --> 00:12:36,860
أنت من بنى هذا المكان؟

178
00:12:37,390 --> 00:12:40,840
ماذا تعني؟ يمكنك فعل ذلك؟

179
00:12:41,100 --> 00:12:47,370
كنتُ في الأصل إنساناً آليّاً هندسيّاً
يعمل في التطوير المدنيّ

180
00:12:47,660 --> 00:12:53,860
بناء مكان كهذا أسهل بالنسبة لي
من إعداد رامن شهيّ

181
00:12:54,130 --> 00:12:55,400
تفضّلوا

182
00:12:57,240 --> 00:12:58,370
!شكراً على الطعام

183
00:12:57,240 --> 00:12:58,370
!أخيراً

184
00:13:08,260 --> 00:13:09,380
!إنّه شهيّ

185
00:13:09,630 --> 00:13:12,260
كانت إشاعات نكهة صلصة الصّويا صحيحة

186
00:13:12,260 --> 00:13:15,500
كانت هناك إشاعات أخرى عن تونكوتسو
...رامن ونكهة ميسو، لكن

187
00:13:16,060 --> 00:13:18,790
لم تكن هناك معلومات ملموسة حول هذا المكان

188
00:13:18,790 --> 00:13:21,590
لماذا لا يوجد أيّ ذِكر له على الإنترنت؟

189
00:13:21,590 --> 00:13:24,100
لأنّني أشرف على إزالته

190
00:13:25,180 --> 00:13:29,660
أحذف أيّ مرجعيّة إلى هذا المكان
لحظة وصولها إلى الإنترنت

191
00:13:29,660 --> 00:13:33,180
بما في ذلك هذه المحادثة التي نجريها الآن

192
00:13:33,180 --> 00:13:33,910
بجدّية؟

193
00:13:33,910 --> 00:13:34,760
بجدّية

194
00:13:34,760 --> 00:13:36,400
لكن لماذا؟

195
00:13:36,400 --> 00:13:40,240
أتحرّى حول نُظُم إيمان البشر بالإشاعات

196
00:13:40,240 --> 00:13:42,210
نُظُم الإيمان بالإشاعات؟

197
00:13:42,700 --> 00:13:47,180
.الإشاعات لا هي حقيقة ولا هي خيال
إنّها إشاعات ببساطة

198
00:13:47,180 --> 00:13:53,550
لكن النّاس الّذين يشقّون طريقهم إلى هنا
غالباً ما يستاؤون أو يخيب ظنّهم

199
00:13:53,550 --> 00:13:55,970
بأنّ الرّامن ليس كما ظنّوه

200
00:13:55,970 --> 00:13:59,690
ما الّذي يقودهم لمثل هذا الإيمان
بهذه الإشاعات المؤقّتة الزائلة؟

201
00:13:59,930 --> 00:14:03,190
أنا مُنبهر بالنّظُم التي تقودهم للتفكير بهذه الطريقة

202
00:14:03,610 --> 00:14:04,850
!المزيد

203
00:14:04,850 --> 00:14:05,890
!في الحال

204
00:14:05,890 --> 00:14:07,950
ولماذا تتحرّى حول ذلك؟

205
00:14:08,370 --> 00:14:14,660
يؤمن البشر أحياناً بأشياء من الواضح بالنسبة
لهم أنّها غير صحيحة بالمُطلَق

206
00:14:15,540 --> 00:14:18,960
،درستُ عن البشر لسنوات عديدة الآن

207
00:14:18,960 --> 00:14:25,210
مع ذلك عجزتُ عن إيجاد جواب شافٍ
"عن سؤال "لماذا يؤمنون بالإشاعات؟

208
00:14:25,540 --> 00:14:27,720
كم استغرق ذلك من مدّة؟

209
00:14:27,720 --> 00:14:31,690
بدأ مع تأسيس هذه المدينة ذات البيانات
المُدارة، توم سوير

210
00:14:32,290 --> 00:14:33,940
!هذه مدّة طويلة جدّاً

211
00:14:35,020 --> 00:14:39,750
أجل. ورغم ذلك، لم أتوصّل لإجابة بعد

212
00:14:40,640 --> 00:14:43,730
لماذا تؤمنون بالإشاعات؟

213
00:14:43,730 --> 00:14:46,420
...أنا لا أؤمن بها تماماً، لكن

214
00:14:46,420 --> 00:14:47,590
لكن؟

215
00:14:47,590 --> 00:14:48,860
ربّما لأنّها مُمتعة؟

216
00:14:49,540 --> 00:14:50,870
مُمتعة؟

217
00:14:50,870 --> 00:14:55,310
واتسون يجمع الإشاعات، ويفعل
ذلك لأنّ الأمر ممتع

218
00:14:55,310 --> 00:14:56,310
صحيح؟

219
00:14:57,580 --> 00:14:58,890
هذا... ممتع؟

220
00:14:58,890 --> 00:15:00,560
هذا غير منطقيّ، صحيح؟

221
00:15:00,560 --> 00:15:02,500
...راودني نفس الشّعور في البداية، لكن

222
00:15:02,840 --> 00:15:06,660
بدأتُ أستمتع بينما كنّا نبحث عن هذه العربة

223
00:15:06,660 --> 00:15:10,860
هل هي حقيقيّة؟ إن كانت كذلك، فما"
"طبيعة الرّامن الّذي يقدّمه؟

224
00:15:10,860 --> 00:15:13,500
تخيّل هذه الأشياء كان ممتعاً

225
00:15:13,760 --> 00:15:16,170
بالمناسبة، اسمي بيري

226
00:15:16,170 --> 00:15:18,260
هذان هاك وواتسون

227
00:15:18,260 --> 00:15:21,160
نحن مُتحرّون من نادي يوري للتحرّيات

228
00:15:21,160 --> 00:15:22,500
ما اسمك؟

229
00:15:23,460 --> 00:15:24,500
لماذا؟

230
00:15:25,180 --> 00:15:29,730
لم أقابل بشريّاً يقدّم كلّ هذه
،المعلومات البشريّة من قبل

231
00:15:29,730 --> 00:15:32,530
ناهيك عن سؤالي عن اسمي

232
00:15:32,530 --> 00:15:33,240
بجدّية؟

233
00:15:33,240 --> 00:15:35,380
بجدّية. لماذا إذاً؟

234
00:15:35,380 --> 00:15:39,660
حسناً، الرّامن لذيذ، لذا أودّ المجيء
ثانية. أريد رؤيتك من جديد

235
00:15:40,140 --> 00:15:41,330
أنا؟

236
00:15:41,860 --> 00:15:42,740
لكن لماذا؟

237
00:15:44,340 --> 00:15:45,740
!لأنّ هذا كان ممتعاً

238
00:15:47,760 --> 00:15:48,500
!المزيد

239
00:15:48,790 --> 00:15:49,750
!أنا أيضاً

240
00:15:49,750 --> 00:15:50,970
!في الحال

241
00:15:51,340 --> 00:15:53,460
اسمي أناليتيكا

242
00:15:53,870 --> 00:15:58,460
سيّد أناليتيكا، ماذا كان شعورك كإنسان
آلي في التطوير المدنيّ؟

243
00:15:58,960 --> 00:16:01,470
صنعتُ مارك توين

244
00:16:01,980 --> 00:16:03,470
مارك توين"؟"

245
00:16:10,780 --> 00:16:11,860
!ساحرة الخلل البرمجي

246
00:16:11,860 --> 00:16:13,020
!ظاهرة زيرو؟

247
00:16:16,230 --> 00:16:17,790
!نحن في السّحابة الفائقة

248
00:16:18,930 --> 00:16:20,500
!اخرجي إلى هنا يا ساحرة الخلل البرمجي

249
00:16:26,740 --> 00:16:27,450
تبّاً

250
00:16:27,940 --> 00:16:28,820
!ها هي ذي

251
00:16:28,820 --> 00:16:29,730
...لكن

252
00:16:30,930 --> 00:16:32,120
!سيّد أناليتيكا

253
00:16:32,120 --> 00:16:33,040
!مخرج ما

254
00:16:33,040 --> 00:16:35,120
أجل. علينا البحث عن المخرج

255
00:16:35,120 --> 00:16:36,340
أين هو؟

256
00:16:36,340 --> 00:16:37,620
كيف نخرج من هنا؟

257
00:16:43,630 --> 00:16:44,980
!الطيف زيرو

258
00:16:49,770 --> 00:16:51,820
أتريدين أن تلعبي؟

259
00:16:51,820 --> 00:16:54,270
حسناً، أريد مزيداً من بيانات ساحرة
الخلل البرمجيّ خاصّتك

260
00:16:55,080 --> 00:17:01,280
—غيغا! تيرا! بيتا! إكسا! زيتّا! يوتّا

261
00:17:02,880 --> 00:17:03,780
!علينا أن نهرب

262
00:17:16,550 --> 00:17:17,490
هنا في الأسفل؟

263
00:17:20,090 --> 00:17:21,300
ماذا عنك يا واتسون؟

264
00:17:25,310 --> 00:17:27,310
!قطقوط يفعل المزيد من الأشياء الجديدة

265
00:17:27,700 --> 00:17:29,560
!إنّه كقطّ حقّاً

266
00:17:38,520 --> 00:17:39,920
حريّ بنا أن نبحث عن المخرج

267
00:17:50,220 --> 00:17:52,580
!ساحرة الخلل البرمجي! زوم

268
00:17:57,130 --> 00:17:58,650
مُدهش بحقّ

269
00:17:59,930 --> 00:18:01,590
!زوم، زوم

270
00:18:17,090 --> 00:18:20,340
المزيد من بيانات ساحرة الخلل البرمجي لي

271
00:18:25,920 --> 00:18:26,790
تبّاً

272
00:18:36,810 --> 00:18:38,140
!قطقوط

273
00:18:40,830 --> 00:18:43,060
!زوم، زوم، زوم

274
00:18:48,390 --> 00:18:49,600
!تبّاً

275
00:18:49,600 --> 00:18:53,020
هاك، ألا يمكنك إيجاد المخرج كما المرّة السّابقة؟

276
00:18:53,620 --> 00:18:55,370
!كيف نخرج من هنا؟

277
00:18:55,370 --> 00:18:56,400
...في الحال

278
00:18:57,650 --> 00:18:59,220
...مخرج

279
00:18:59,620 --> 00:19:01,930
...المخرج... هنا

280
00:19:01,930 --> 00:19:04,370
يُفتَح... الآن

281
00:19:05,620 --> 00:19:08,120
كيف تفعل ذلك؟

282
00:19:08,120 --> 00:19:17,120
أنا أناليتيكا، إنسان آلي هندسيّ
صُنِع لبناء مارك توين

283
00:19:17,120 --> 00:19:21,390
...لقد... بنيتُها... كلّها

284
00:19:23,060 --> 00:19:24,260
!أناليتيكا

285
00:19:24,760 --> 00:19:26,040
...الطلب جاهز

286
00:19:33,230 --> 00:19:34,020
!زوم

287
00:19:52,300 --> 00:19:53,130
هاك

288
00:19:53,130 --> 00:19:54,300
!ساحرة الخلل البرمجي

289
00:20:02,300 --> 00:20:04,050
!أعطيني بياناتي

290
00:20:06,380 --> 00:20:10,340
!ساحرة الخلل البرمجي، يا لصّة البيانات

291
00:20:10,340 --> 00:20:12,300
ماذا كان ذلك للتو؟

292
00:20:22,430 --> 00:20:24,020
مؤلم

293
00:20:32,540 --> 00:20:39,300
،يا مُفكّرة، العربة الغامضة موجودة حقّاً
،لكنّها اختفت الآن

294
00:20:39,540 --> 00:20:45,300
أظنّها فعلاً ليست أكثر من مجرّد إشاعة

295
00:20:40,700 --> 00:20:42,790
!ساحرة الخلل البرمجيّ الغبيّة

296
00:20:47,020 --> 00:20:47,800
ماذا؟

297
00:20:48,100 --> 00:20:51,080
وجدتُم العربة الغامضة فعلاً إذاً؟

298
00:20:51,080 --> 00:20:52,800
!كان ذلك رائعاً حقّاً

299
00:20:53,590 --> 00:20:55,310
!صحيح؟

300
00:20:55,310 --> 00:20:59,060
وواجهتم ظاهرة زيرو أيضاً؟ هذا غير معقول

301
00:20:59,340 --> 00:21:01,820
!سرقت ساحرة الخلل البرمجي بياناتي

302
00:21:01,820 --> 00:21:03,410
بياناتك؟

303
00:21:03,410 --> 00:21:05,570
!لصّة بيانات كريهة

304
00:21:05,810 --> 00:21:09,840
إذاً هذه العربة التي لم تكن في أيّ
خريطة اختفت الآن؟

305
00:21:09,840 --> 00:21:12,500
أجل، لم يبقَ شيء

306
00:21:12,500 --> 00:21:15,070
أيّ إنسان آليّ كان المالك؟

307
00:21:15,550 --> 00:21:16,630
أناكوندا

308
00:21:16,630 --> 00:21:18,080
كان أناليتيكا

309
00:21:18,780 --> 00:21:23,850
قال بأنّه إنسان آليّ هندسيّ صُنِع
...لبناء مارك أو ما شابه

310
00:21:25,350 --> 00:21:27,150
مارك توين ربّما؟

311
00:21:28,220 --> 00:21:30,410
!ساحرة الخلل البرمجي تلك أغضبتني ضِعفَين

312
00:21:30,410 --> 00:21:33,140
!في المرّة المقبلة، سوف أنتقم ضعفين

313
00:21:31,620 --> 00:21:33,140
...حسناً، على أيّ حال

314
00:21:33,140 --> 00:21:35,590
تمكّنا من أكل رامن على الأقلّ

315
00:21:35,590 --> 00:21:37,460
وكان أطيب رامن أتناوله على الإطلاق

316
00:21:37,460 --> 00:21:38,850
!صحيح؟

317
00:21:38,850 --> 00:21:41,350
حسناً، هذا مزعج جدّاً، لذا يكفي

318
00:21:43,870 --> 00:21:46,870
!العربة الغامضة لم تكن موجودة حقّاً

319
00:21:44,690 --> 00:21:49,440
ما تعلّمتُه من البحث عن العربة الغامضة
هو أنّ الرّامن كان يُعَدُّ

320
00:21:49,440 --> 00:21:51,870
،بواسطة إنسان آلي غامض يُدعى أناليتيكا

321
00:21:51,870 --> 00:21:54,840
وحصلَ واتسون على معلومات أكثر من المُتوقّع

322
00:21:56,420 --> 00:22:01,870
لكن أنا متأكّدة بأنّه ما زالت هناك
أمور كثيرة لا أعرفها