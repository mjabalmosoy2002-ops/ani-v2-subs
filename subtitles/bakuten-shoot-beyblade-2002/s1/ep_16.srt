1
00:01:30,490 --> 00:01:31,850
!درايغر

2
00:01:32,970 --> 00:01:36,350
.الأنسة هيرومي أرادت رؤية الوحوش بنفسها

3
00:01:36,350 --> 00:01:38,970
،تاكاو والأخرين توقعوا أن ذلك مستحيلاً لكن

4
00:01:38,970 --> 00:01:42,680
،عندما تحدى كاي يوسف في معركة

5
00:01:42,680 --> 00:01:49,550
.رأت الأنسة هيرومي وحش العدو وساعدت ري وبياكو بالهجوم والفوز عليه

6
00:01:49,550 --> 00:01:55,020
!أنا متأكد أن رغبت الأنسة هيرومي في مساعدة بياكو قد وصلت إليه

7
00:01:56,100 --> 00:01:57,210
!في الأعلى

8
00:02:08,770 --> 00:02:13,740
مأساة لاعب البليد الرقمي

9
00:02:22,280 --> 00:02:25,250
.دراغون الرقمي، والطائر الرقمي على وشك الخروج

10
00:02:44,160 --> 00:02:46,650
أرأين بنفسك، سيد غيديون؟

11
00:02:47,700 --> 00:02:49,630
.حسناً، هذا يكفي

12
00:02:59,290 --> 00:03:05,130
.بهذه الطريقة اكتملت الوحوش الرقمية التي لدينا بدون شك

13
00:03:05,130 --> 00:03:07,670
ألن يخرجوا هذه المرة عن السيطرة؟

14
00:03:07,830 --> 00:03:09,800
.لا داعي للقلق

15
00:03:09,800 --> 00:03:14,200
.نحن بحاجة الأن إلى ممثليّ بليد قادرون على استخدام البي الرقمي

16
00:03:14,200 --> 00:03:15,410
...ممثليّ بليد

17
00:03:15,410 --> 00:03:16,090
.أجل

18
00:03:16,090 --> 00:03:24,560
نحن بحاجة إلى لاعبيّ بليد يمتلكون ادارة كـ كينوميا والأخرين، كلا بل ارادتهم أقوى بكثير

19
00:03:24,560 --> 00:03:26,500
أهناك شخص في بالك؟

20
00:03:26,790 --> 00:03:29,970
.أجل، سوف أعرض لك أحدهم في الحال

21
00:03:30,340 --> 00:03:33,740
.أعتمد عليك

22
00:03:39,780 --> 00:03:41,030
!هيا بنا، كاي

23
00:03:41,030 --> 00:03:41,540
!تعال

24
00:03:41,930 --> 00:03:44,450
3! 2! 1!

25
00:03:44,670 --> 00:03:46,930
!هيا اطلاق

26
00:03:58,410 --> 00:04:01,240
.كاي ودُرانزر أصبحت حركتهما مختلفة

27
00:04:01,240 --> 00:04:04,640
.يبدو أن سرعته أصبحت أسرع بكثير

28
00:04:04,640 --> 00:04:06,120
.يمكني رؤية ذلك بوضوح

29
00:04:07,170 --> 00:04:13,470
.لقد زادت سرعة دُرانزر وتحسن مستوى توازنه العام كثيراً

30
00:04:13,470 --> 00:04:15,350
!أسميه الأن دُرانزر بركان

31
00:04:15,730 --> 00:04:18,310
دُرانزر بركان؟

32
00:04:26,670 --> 00:04:28,630
!ولكن هذا غير عادل، كيوجو

33
00:04:28,630 --> 00:04:31,690
لماذا كاي الوحيد الذي يحصل على بي جديد؟

34
00:04:32,280 --> 00:04:33,860
ما الذي تقوله؟

35
00:04:33,860 --> 00:04:38,870
!دُرانزر تعرض لكثير من الأضرار في أخر قتال بين كاي ودونغا

36
00:04:38,870 --> 00:04:41,650
،لذا لا يمكن أن ترتقي قوته أكثر

37
00:04:41,650 --> 00:04:43,560
!لهذا السبب عملت جاهداً لارتقائه

38
00:04:43,560 --> 00:04:44,210
!أصمت

39
00:04:45,100 --> 00:04:47,350
!لا أستطيع التركيز على المعركة

40
00:04:47,990 --> 00:04:49,660
!انطلق دراغون

41
00:04:50,810 --> 00:04:51,890
!دُرايزر

42
00:04:54,260 --> 00:04:55,110
!احترس

43
00:04:55,110 --> 00:04:55,970
!تاكاو

44
00:04:56,750 --> 00:04:57,440
ماذا؟

45
00:05:01,750 --> 00:05:02,360
!كاي

46
00:05:05,000 --> 00:05:05,660
من أنت؟

47
00:05:08,860 --> 00:05:09,900
...أنت

48
00:05:11,440 --> 00:05:13,410
.مضى زمن طويل، سيد كاي

49
00:05:17,640 --> 00:05:20,360
.أعتذر على وقاحتي

50
00:05:20,360 --> 00:05:25,130
...ولكن لم أتمالك نفسي عندما رأيت دُرانزر يعمل

51
00:05:25,850 --> 00:05:27,760
!أنا مينامي يوويا

52
00:05:28,170 --> 00:05:31,760
.أنا أقل رتبة من السيد كاي، وقد ساعدني من قبل

53
00:05:31,850 --> 00:05:33,430
أتعرفان بعضيكما؟

54
00:05:33,430 --> 00:05:35,850
!لا تفاجئنا هكذا، تباً لك

55
00:05:36,480 --> 00:05:41,160
.كما توقعت، أنت لاتزال إلى جانب فريق بي بي أي، سيد كاي

56
00:05:43,810 --> 00:05:46,560
.أردت رؤيتك، سيد كاي

57
00:05:46,560 --> 00:05:54,120
لكن بسبب ذلك الوقت عندما خضت معركة مع دُرانزر، اعتقدت أنك لن تسامحني

58
00:05:54,570 --> 00:05:55,540
...أيضاً

59
00:05:57,710 --> 00:05:59,640
!اطلاق

60
00:06:02,050 --> 00:06:02,980
ماذا؟

61
00:06:15,510 --> 00:06:20,930
.بعد ذلك الوقت لم تظهر أبداً

62
00:06:23,130 --> 00:06:24,280
!سيد كاي

63
00:06:24,280 --> 00:06:27,480
.أريد أن أصبح قوياً مثلك، سيد كاي

64
00:06:27,480 --> 00:06:31,020
.وبسبب ذلك أتدرب في مدرسة البليد

65
00:06:31,020 --> 00:06:34,240
.وبالطبع أتدرب بمفردي أيضاً

66
00:06:34,760 --> 00:06:37,010
.ولكن لايزال هناك شيء مفقود

67
00:06:37,890 --> 00:06:41,660
أنا .. أريد أن تدربني؟

68
00:06:42,090 --> 00:06:46,710
!حلمي هو أن أخوض معركة ضدك يا سيد كاي

69
00:06:46,710 --> 00:06:49,710
.ويجب أن أبذل جهدي لأجل هذا الحلم

70
00:06:49,710 --> 00:06:51,250
...كلا

71
00:06:51,250 --> 00:06:54,620
.يمكني العمل من كل قلبي

72
00:06:54,620 --> 00:06:58,260
...أعلم أن هذه الرغبة أنانية، لكن من فضلك

73
00:06:58,260 --> 00:06:58,870
.أرفض

74
00:06:59,880 --> 00:07:00,960
.غادر

75
00:07:01,600 --> 00:07:02,910
لماذا؟

76
00:07:02,910 --> 00:07:05,930
.أنا أقسم أن أتحمل أي نوع من التدريب

77
00:07:05,930 --> 00:07:10,240
!أريد أن أصبح أقوى لاعب بليد مثلك

78
00:07:10,240 --> 00:07:14,300
.قد يكون ذلك مستحيلاً، لكن أريد أن أخطو خطوة تقربني منك

79
00:07:14,300 --> 00:07:15,890
!من فضلك

80
00:07:18,190 --> 00:07:19,600
!سيد كاي

81
00:07:22,810 --> 00:07:24,520
.أعتذر إليك

82
00:07:24,520 --> 00:07:26,870
.ولكن أنا لن أستسلم

83
00:07:26,870 --> 00:07:29,760
.يوما ما سوف أتغلب عليك في المعركة

84
00:07:29,760 --> 00:07:31,410
.لا يمكنك هزيمتي

85
00:07:34,660 --> 00:07:35,960
.المعذرة

86
00:07:43,070 --> 00:07:44,600
ألا بأس بذلك، كاي؟

87
00:07:44,600 --> 00:07:47,520
...ليس من الجيد رده مرة أخرى

88
00:07:48,370 --> 00:07:51,620
هذا الفتى المدعو بيويا يريد أن يصبح قوي، أليس كذلك؟

89
00:07:51,620 --> 00:07:53,390
...كان على كاي تفهم ذلك

90
00:07:53,390 --> 00:07:55,840
.يبدو أني أفهم سبب رفضه

91
00:07:57,190 --> 00:08:00,630
.إن كاي يفهم ذلك الشخص أكثر من أي شخص أخر

92
00:08:01,110 --> 00:08:04,070
.على الأرجح أنه ينظر إلى نفسه القديمة الأن

93
00:08:04,070 --> 00:08:05,040
...كاي

94
00:08:08,440 --> 00:08:12,050
أولئك العلماء انتهوا من صناعة الوحوش الرقمية؟

95
00:08:12,340 --> 00:08:13,180
.أجل

96
00:08:13,950 --> 00:08:18,840
.شعرت بالفضول حول ذلك وتجسست على تجاربهم المرعبة

97
00:08:18,840 --> 00:08:20,500
.لا خطأ في ذلك

98
00:08:20,710 --> 00:08:25,280
.الأن يبحثون عن ممثلين بيلد قادرون على استخدامها

99
00:08:28,260 --> 00:08:29,920
،أولئك العلماء

100
00:08:29,920 --> 00:08:34,360
.سيهاجمون كينوميا والأخرين بمجرد تحديد لاعب البليد

101
00:08:34,360 --> 00:08:36,270
.نحن بحاجة إلى التحرك

102
00:08:36,270 --> 00:08:37,350
.هذا هو الأرجح

103
00:08:37,890 --> 00:08:39,180
!أياً كانت الطريقة

104
00:08:39,180 --> 00:08:42,570
.لن نسمح لهم بأخذ تلك الوحوش الأربعة

105
00:08:52,460 --> 00:08:53,530
...سيد كاي

106
00:08:54,020 --> 00:08:54,940
...سحقاً

107
00:08:54,940 --> 00:08:56,100
.مينامي

108
00:08:56,100 --> 00:08:57,680
.شخص ما يريدك

109
00:09:01,740 --> 00:09:04,010
أتريد أن أستخدم البي الجديد؟

110
00:09:04,190 --> 00:09:05,360
.هذا صحيح

111
00:09:05,360 --> 00:09:08,200
،عندما عُرضت إلي بيانات قدراتك

112
00:09:08,200 --> 00:09:11,790
.شعرت أنك ستكون الأكثر مثالية لذلك البي الذي قمنا بتطويره

113
00:09:11,790 --> 00:09:14,320
مارأيك؟ أتريد تجربته؟

114
00:09:16,450 --> 00:09:18,200
.مـ موافق

115
00:09:18,200 --> 00:09:18,970
!أتشرف بذلك

116
00:09:27,440 --> 00:09:28,400
.ستكون بخير

117
00:09:28,750 --> 00:09:30,190
.إنها أمنة جداً

118
00:09:30,190 --> 00:09:33,630
.أولاً سنعرض لك البي الذي يمكنك استخدامه

119
00:09:38,400 --> 00:09:41,030
3. 2. 1.

120
00:09:41,030 --> 00:09:42,340
!هيا اطلاق

121
00:09:46,680 --> 00:09:47,840
...مذهل

122
00:09:47,840 --> 00:09:49,710
.تم الوصول إلى نقطة الطاقة الحرجة

123
00:09:59,330 --> 00:10:00,910
.هذا هو الوحش

124
00:10:00,910 --> 00:10:02,720
.الوحش الرقمي

125
00:10:02,720 --> 00:10:05,300
الوحش الرقمي؟

126
00:10:08,980 --> 00:10:11,170
!لا ألومك عندما تفاجئت

127
00:10:11,170 --> 00:10:12,630
،قد لا تصدق ذلك

128
00:10:12,630 --> 00:10:16,290
،هذه البي أقوى من تلك الوحوش بعشرات المرات.. كلا

129
00:10:16,290 --> 00:10:19,270
!بل أقوى بمئة مرة من الأخريات

130
00:10:20,100 --> 00:10:22,220
أيمكن أن يكون هناك شيء كهذا؟

131
00:10:22,650 --> 00:10:26,700
.الوحوش لديها قوة لا حدود لها داخل البي

132
00:10:26,700 --> 00:10:31,950
.حتى أبطال العالم فريق بي بي أي لا يمكنهم التصدي لهذه البي

133
00:10:47,810 --> 00:10:53,110
.نريد منك القتال مع أحد أعضاء بي بي أي

134
00:10:54,100 --> 00:10:55,910
.خصمك هو هيواتاري كاي

135
00:10:57,880 --> 00:10:59,050
...سيد كاي

136
00:11:00,070 --> 00:11:02,970
.يمكنك استخدامه بمجرد الإعتياد على هذا الوحش

137
00:11:02,970 --> 00:11:06,810
.استناداً إلى بياناتك فإنك قادر على استخدامه

138
00:11:06,810 --> 00:11:09,690
أنا سأخوض معركة مع السيد كاي؟

139
00:11:10,040 --> 00:11:14,480
.إذا كنت موافق فسوف تخضع إلى نظام تدريب خاص

140
00:11:14,480 --> 00:11:15,160
موافق؟

141
00:11:18,380 --> 00:11:19,130
!أجل

142
00:11:27,850 --> 00:11:30,020
.لا يمكنك هزيمتي أبداً

143
00:11:30,900 --> 00:11:32,370
.سأفعل ذلك

144
00:11:32,370 --> 00:11:36,210
.سوف أتقاتل مع السيد كاي وأنتصر عليه

145
00:11:36,720 --> 00:11:40,310
!سوف أري السيد كاي قوتي الحقيقية

146
00:11:54,660 --> 00:11:56,280
،نظام التدريب قاسِ

147
00:11:56,280 --> 00:11:59,220
.لكن ذلك الفتى يويا يمكنه تحمله

148
00:11:59,570 --> 00:12:02,570
.بدأ يدخل إلى المرحلة النهائية بالتدريب

149
00:12:02,570 --> 00:12:05,910
.بمجرد انتهائه من جميع الإستعدادات سوف نرسله إلى هيواتاري

150
00:12:05,910 --> 00:12:08,390
.لن أسمح بفشل أخر

151
00:12:08,390 --> 00:12:08,870
!حسناً

152
00:12:09,010 --> 00:12:11,560
!لقد عدت

153
00:12:11,560 --> 00:12:13,820
.وأخيراً جئت، كينوميا

154
00:12:13,820 --> 00:12:14,460
ماذا؟

155
00:12:15,620 --> 00:12:16,320
!أوزوما

156
00:12:17,430 --> 00:12:19,950
أتريد خوض معركة أخرى معي؟

157
00:12:19,950 --> 00:12:21,450
!لا تذهب بعيداً

158
00:12:22,660 --> 00:12:24,820
.جئت إلى هنا كي أحذركم

159
00:12:24,820 --> 00:12:26,250
تحذرنا؟

160
00:12:26,250 --> 00:12:30,800
.أولئك العلماء سيرسلون لكم لاعب بليد آخر لمقاتلتكم

161
00:12:31,650 --> 00:12:33,570
.مع ذلك لا تقاتلوه

162
00:12:33,570 --> 00:12:38,040
.إنه يستخدم وحش رقمي، وسيحاول سرقة وحوشكم

163
00:12:38,980 --> 00:12:40,560
وحش رقمي؟

164
00:12:40,560 --> 00:12:42,720
أتقصد الوحش المنسوخ؟

165
00:12:42,720 --> 00:12:44,850
...ولكن كان في حالة هيجان

166
00:12:44,850 --> 00:12:48,500
.هذه المرة الوحش الرقمي لم يعد فاشلاً

167
00:12:49,130 --> 00:12:51,390
،أوزوما، شكراً لتحذرينا

168
00:12:51,390 --> 00:12:53,040
.لكننا لن نفعل ماقلته لنا

169
00:12:54,140 --> 00:12:58,550
.مهما كان التحدي فسوف نقبل بدون شك

170
00:12:58,550 --> 00:13:00,480
.أجل، هذا صحيح

171
00:13:00,480 --> 00:13:02,080
.لن نهرب أو نختبئ

172
00:13:02,080 --> 00:13:04,000
.هذه طريقة فريقنا بي بي أي

173
00:13:04,560 --> 00:13:07,080
،وحش رقمي أو أياً كان

174
00:13:07,080 --> 00:13:11,230
!سوف أتغلب عليه بسهولة عن طريق دراغون

175
00:13:11,230 --> 00:13:13,390
.إنك واثق من نفسك بشدة

176
00:13:13,390 --> 00:13:16,750
.ولكن لا تلتفتوا إليهم وإلا فسوف تندمون

177
00:13:17,040 --> 00:13:18,710
!انتظر أوزوما

178
00:13:19,030 --> 00:13:21,450
.أردت سؤالك في السابق

179
00:13:21,450 --> 00:13:24,310
هل أنت عدونا أم حليفنا؟

180
00:13:26,860 --> 00:13:28,430
!هوي، لا تتجاهلني

181
00:13:28,780 --> 00:13:30,900
.لا يعجبني أسلوبه

182
00:14:11,010 --> 00:14:13,430
.كاي يبدو نشيطاً اليوم

183
00:14:13,430 --> 00:14:18,450
.ولكن التدريب المستمر بدون تناول الطعام سيكون سيء لصحته

184
00:14:18,450 --> 00:14:21,250
كاي، مارأيك أن تأخذ استراحة؟

185
00:14:24,770 --> 00:14:26,680
...ذلك الصبي الذي جاء في ذلك الوقت

186
00:14:26,680 --> 00:14:27,420
يويا؟

187
00:14:27,680 --> 00:14:32,140
.إنه يرتدي نفس زي فريق بسيكيك

188
00:14:32,140 --> 00:14:33,410
...هذا يعني

189
00:14:33,680 --> 00:14:35,230
أهذا الشخص الذي أخبرنا عنه أوزوما؟

190
00:14:35,230 --> 00:14:38,870
إذاً أتقصد أنه لاعب البليد الذي أرسله فريق بسيكيك إلينا؟

191
00:14:39,350 --> 00:14:40,500
!سوف أتعامل معه

192
00:14:40,500 --> 00:14:41,110
.لا تقترب

193
00:14:45,860 --> 00:14:48,560
.سيد كاي، سوف أهزمك لهذا اليوم

194
00:14:49,250 --> 00:14:50,700
.لن أتقاتل معك

195
00:14:50,950 --> 00:14:52,500
.بل ستتقاتل

196
00:14:52,500 --> 00:14:55,140
.الوحش الخاص بي هو الطائر الرقمي

197
00:14:55,140 --> 00:14:56,400
الطائر الرقمي؟

198
00:14:56,400 --> 00:14:57,270
...أيها الوغد

199
00:14:57,270 --> 00:14:58,500
ماذا قلت؟

200
00:14:58,500 --> 00:15:01,000
لا تقل لي بأنك خائف مني؟

201
00:15:02,180 --> 00:15:04,360
كاي، ما الذي ستفعله؟

