1
00:00:06,760 --> 00:00:09,330
أين أنا؟

2
00:00:11,640 --> 00:00:14,610
.سررت بلقائك يا ماكوتو

3
00:00:14,860 --> 00:00:16,870
.أردتُ لقاءك

4
00:00:20,280 --> 00:00:21,420
من أنت؟

5
00:00:22,410 --> 00:00:25,120
.أنا إلهة

6
00:00:25,370 --> 00:00:28,430
أنت إلهة؟

7
00:00:29,080 --> 00:00:30,180
...عفوًا

8
00:00:30,580 --> 00:00:33,130
ما الّذي تريدينه منّي؟

9
00:00:33,130 --> 00:00:35,550
.كنتُ أراقبك طوال هذا الوقت

10
00:00:35,550 --> 00:00:39,970
.لذا أودّ أن أتّخذك تابعًا لي

11
00:00:39,970 --> 00:00:40,690
ماذا؟

12
00:00:41,220 --> 00:00:44,140
.أعلّق عليك آمالاً كثيرة

13
00:00:44,800 --> 00:00:45,640
،ماكوتو

14
00:00:46,720 --> 00:00:49,020
هلاّ صرتَ تابعي وآمنت بي؟

15
00:00:53,030 --> 00:00:56,030
"هل ستصبح من أتباع الإلهة؟"

16
00:00:54,480 --> 00:00:56,030
"نعم" "لا"

17
00:01:02,030 --> 00:01:06,050
"يصبح تاكاتسكي ماكوتو من تابعًا"

18
00:01:04,030 --> 00:01:06,290
أين أنا؟

19
00:01:06,990 --> 00:01:08,180
...هذا صحيح

20
00:01:08,740 --> 00:01:11,550
تعرّضنا لحادث في طريق
.عودتنا من رحلة التّزلّج

21
00:01:12,550 --> 00:01:14,550
...اشتدّ البرد بشكل كبير

22
00:01:15,920 --> 00:01:17,430
...بدأتُ أستسلم للنّوم

23
00:01:17,920 --> 00:01:20,550
...لا أذكر أيّ شيء بعد ذلك

24
00:01:21,260 --> 00:01:24,110
هل تمّ إنقاذنا؟

25
00:01:25,510 --> 00:01:27,440
أهذا يعني أنّي في مستشفى؟

26
00:01:27,440 --> 00:01:28,940
!حسنًا

27
00:01:28,940 --> 00:01:31,120
!سهم النّار

28
00:01:32,320 --> 00:01:33,330
ماذا؟

29
00:01:36,450 --> 00:01:38,030
!تاكي-دونو

30
00:01:38,030 --> 00:01:39,320
!لقد استيقظت

31
00:01:39,320 --> 00:01:40,700
!فوجيان

32
00:01:40,700 --> 00:01:43,080
!كنتُ قلقًا عليك

33
00:01:43,080 --> 00:01:46,790
لم أعرف ما يجب عليّ فعله
!لو لم تستعد وعيك كبقيّتنا

34
00:01:46,790 --> 00:01:48,710
.آسف لأنّي جعلتك تقلق

35
00:01:49,030 --> 00:01:51,340
الأهمّ الآن، هل نحن...؟

36
00:01:52,290 --> 00:01:54,220
.لقد حالفنا الحظّ

37
00:01:54,710 --> 00:01:57,590
!هل تصدّق هذا؟ إنّنا في حلم كلّ لاعب

38
00:01:57,590 --> 00:01:59,470
!هذا عالم آخر

39
00:01:59,470 --> 00:02:00,970
.عرفتُ هذا

40
00:02:00,970 --> 00:02:01,800
ماذا؟

41
00:02:01,800 --> 00:02:03,260
.إنّك هادئ جدًّا بشكل غريب

42
00:02:03,260 --> 00:02:06,230
تحمّستُ في اللّحظة الّتي رأيتُ
.فيها أشخاصًا بآذان حيوانات

43
00:02:06,630 --> 00:02:08,810
.أدركتُ ذلك عندما نظرتُ للخارج

44
00:02:08,810 --> 00:02:10,230
.فهمت

45
00:02:10,470 --> 00:02:14,440
.يبدو أنّنا في معبد ماء في بلاد الورود روزس

46
00:02:14,440 --> 00:02:18,240
.لقد اعتنوا بنا بعد أن فقدنا وعينا جميعًا

47
00:02:18,480 --> 00:02:21,660
.يبدو أننا نستطيع البقاء هنا لفترة

48
00:02:21,660 --> 00:02:23,490
.سرّني سماع هذا

49
00:02:23,490 --> 00:02:27,210
.ثمّة شيء أكثر حماسة وجاذبيّة بكثير هنا

50
00:02:28,070 --> 00:02:29,750
،هذا عالم آخر

51
00:02:30,490 --> 00:02:32,380
وعند التّفكير في قصص الانتقال لعوالم أخرى؟

52
00:02:32,380 --> 00:02:33,750
!هل أنت جادّ؟

53
00:02:34,880 --> 00:02:35,920
!هل توجد بالفعل؟

54
00:02:35,920 --> 00:02:37,060
!أقصد المهارات؟

55
00:02:39,380 --> 00:02:40,630
ماذا عن البقيّة؟

56
00:02:40,630 --> 00:02:42,050
.إنّهم هنا أيضًا

57
00:02:42,050 --> 00:02:43,850
.لكن ليس جميعهم

58
00:02:43,850 --> 00:02:44,640
ماذا؟

59
00:02:44,640 --> 00:02:47,140
.ينقصنا بعض من كانوا معنا

60
00:02:47,420 --> 00:02:48,940
.فهمت

61
00:02:55,560 --> 00:02:57,110
!إنّه تاكاتسكي

62
00:02:57,110 --> 00:02:58,400
هل استيقظت أخيرًا؟

63
00:02:58,690 --> 00:03:00,910
!ظننتُ أنّك لن تستيقظ أبدًا

64
00:03:02,150 --> 00:03:03,580
.ما كان ذلك ليكون مضحكًا

65
00:03:04,980 --> 00:03:08,340
.يمكنك أن تطلب منهم إخبارك بمهاراتك هنا

66
00:03:09,700 --> 00:03:12,330
فوجيان، أين ساسان؟

67
00:03:12,330 --> 00:03:15,670
،بعد ذكرك للأمر
.لم أرَ ساساكي-دونو هنا أبدًا

68
00:03:15,950 --> 00:03:17,850
..تاكاتسكي-كُن

69
00:03:18,250 --> 00:03:21,680
لا أصدّق أنّك تلعب بينما
.نحن مدفونون أحياء

70
00:03:21,680 --> 00:03:25,600
لقد أوشكتُ على بلوغ النّهاية
.الّتي لطالما تمنّيت رؤيتها

71
00:03:26,550 --> 00:03:29,480
إنّك تحبّ الألعاب بالفعل، صحيح؟

72
00:03:30,680 --> 00:03:32,020
.فهمت

73
00:03:32,020 --> 00:03:35,360
،كنّا نتحدّث معًا حتّى النّهاية
.لذلك ظننتُ أنّها ستكون بأمان

74
00:03:35,360 --> 00:03:36,730
!تاكي-دونو

75
00:03:37,310 --> 00:03:38,940
،مع أنّه تمّ إنقاذنا

76
00:03:38,940 --> 00:03:43,490
علينا الآن العيش في عالم
.آخر يعجّ بالوحوش

77
00:03:43,810 --> 00:03:45,830
!لا يمكنك أن تتهاون

78
00:03:46,980 --> 00:03:48,290
.هذا صحيح

79
00:03:49,250 --> 00:03:53,080
.حسنًا، عليك أوّلاً اكتشاف ما هي مهاراتك

80
00:03:53,080 --> 00:03:54,250
!مفهوم

81
00:03:54,250 --> 00:03:55,260
!سأعود حالاً

82
00:03:56,870 --> 00:03:59,670
أنت آخر المستيقظين، صحيح؟

83
00:04:00,000 --> 00:04:00,880
!نعم

84
00:04:00,880 --> 00:04:02,880
!اسمي تاكاتسكي ماكوتو

85
00:04:02,880 --> 00:04:05,760
.في تلك الحالة، اسمح لي بالشّرح

86
00:04:05,760 --> 00:04:09,640
.هذا عالم مختلف عن الّذي أتيتَ منه

87
00:04:09,640 --> 00:04:11,640
،وما كان المجيء إلى هنا ممكنًا

88
00:04:11,640 --> 00:04:14,450
.لو لم يمت المرء في عالمه الأصليّ

89
00:04:16,600 --> 00:04:17,650
...حسنًا

90
00:04:17,850 --> 00:04:23,150
نقلَتْكم إلهتنا المقدّسة إلى هذا
.العالم بفضل رحمتها العظيمة

91
00:04:23,400 --> 00:04:28,490
!وفوق ذلك، منحت كلاًّ منكم مهارات فريدة

92
00:04:28,490 --> 00:04:31,160
!أريد معرفة مهارتي الفريدة في الحال

93
00:04:31,160 --> 00:04:33,710
.اسمح لي إذًا بالتّحقّق منها

94
00:04:33,710 --> 00:04:34,670
.تفضّل

95
00:04:35,990 --> 00:04:38,290
.هذا كتاب الرّوح

96
00:04:38,290 --> 00:04:42,170
.سيسجّل مهارتك وإحصائيّاتك وما إلى ذلك

97
00:04:42,170 --> 00:04:45,510
.ولكن أوّلاً، لنصلّي للإلهة

98
00:04:45,510 --> 00:04:46,430
نصلّي؟

99
00:04:46,430 --> 00:04:47,300
.نعم

100
00:04:47,300 --> 00:04:49,400
،اركع هنا

101
00:04:50,510 --> 00:04:51,730
.ثمّ صلِّ

102
00:05:01,680 --> 00:05:03,940
.أنا متحمّس للغاية

103
00:05:03,940 --> 00:05:05,990
غالبًا ما يمتلك القادمون

104
00:05:05,990 --> 00:05:09,700
.من عوالم أخرى أمثالك إحصائيّات استثنائيّة

105
00:05:10,070 --> 00:05:11,960
.لا شكّ أنّك ستمتلكها أيضًا

106
00:05:12,700 --> 00:05:21,500
مهاراتك الفريدة هي: صفاء الذّهن، وسحر
.الماء (مبتدئ)، ولاعب ألعاب تقمّص أدوار

107
00:05:21,500 --> 00:05:23,840
!هذه مهارات قويّة، صحيح؟

108
00:05:23,840 --> 00:05:29,190
هذه أوّل مرّة أسمع فيها بالمهارة
...الأخيرة، لكنّ مستوى البقيّة متد

109
00:05:29,670 --> 00:05:30,760
ماذا؟

110
00:05:30,760 --> 00:05:32,180
.إنّه متوسّط

111
00:05:32,180 --> 00:05:33,430
...متوسّط

112
00:05:33,430 --> 00:05:35,650
!والآن حان دور إحصائيّاتك

113
00:05:38,480 --> 00:05:43,230
"همس"

114
00:05:38,970 --> 00:05:40,940
لا بدّ أنّ في هذا خطأ ما، صحيح؟

115
00:05:40,940 --> 00:05:43,230
.لا أصدّق أنّ ذلك ممكن

116
00:05:43,230 --> 00:05:45,150
...لكنّ هذه الأرقام

117
00:05:45,150 --> 00:05:47,070
!إنّها أسوأ من أيّ عامّيّ

118
00:05:47,070 --> 00:05:48,200
!لكنّه من عالم آخر

119
00:05:48,200 --> 00:05:52,280
عفوًا، هل هنالك خطب ما في إحصائيّاتي؟

120
00:05:52,280 --> 00:05:54,200
!على الإطلاق! لا بأس بها

121
00:05:54,200 --> 00:05:56,160
—يبدو أنّ إحصائيّاتك

122
00:05:56,160 --> 00:06:00,680
،لنقل أنّها ربّما تفتقر للكثير
.لكنّها لا تدعو للقلق

123
00:06:02,290 --> 00:06:04,250
!حسنًا، يمكنك تولّي الباقي أيّتها الأخت

124
00:06:06,670 --> 00:06:07,760
.تفضّل

125
00:06:12,760 --> 00:06:14,010
!عشر سنوات؟

126
00:06:14,300 --> 00:06:16,850
أيعني هذا أنّ لديّ عشر سنوات فقط لأعيشها؟

127
00:06:16,850 --> 00:06:19,900
يمكنك تمديد ذلك من خلال
.تبجيلك لإلهتنا المقدّسة

128
00:06:19,900 --> 00:06:20,770
تبجيل؟

129
00:06:20,770 --> 00:06:23,770
.أبسط طريقة هي تقديم التّبرّعات للكنيسة

130
00:06:23,770 --> 00:06:25,280
المال؟

131
00:06:25,680 --> 00:06:27,650
،يمكنك أيضًا كسبها عن طريق هزيمة الوحوش

132
00:06:27,650 --> 00:06:30,610
وإنقاذ الأشخاص الّذين يواجهون
.المتاعب، وما إلى ذلك

133
00:06:30,610 --> 00:06:32,030
.فهمت

134
00:06:32,030 --> 00:06:33,160
،والآن

135
00:06:33,160 --> 00:06:35,450
،بفضل الرّحمة العظيمة لإلهتنا المقدّسة

136
00:06:35,450 --> 00:06:37,790
يمكنك الإقامة هنا مجّانًا لمدّة عام

137
00:06:37,790 --> 00:06:41,580
والخضوع لتدريب في مجالات
.متنوّعة مثل السّحر

138
00:06:41,580 --> 00:06:46,130
آمل أن تتمكّن من العثور على مهنة
.تناسبك جيّدًا خلال تلك الفترة

139
00:06:46,130 --> 00:06:47,140
.مع السّلامة

140
00:06:50,540 --> 00:06:52,760
كيف سارت الأمور يا تاكي-دونو؟

141
00:06:52,760 --> 00:06:54,560
.لا تسُرّ، في الواقع

142
00:06:56,010 --> 00:06:59,730
.إحدى مهاراتي الفريدة هي صفاء الذّهن

143
00:06:57,810 --> 00:07:04,570
"!هدوء"

144
00:06:59,730 --> 00:07:02,350
تتيح لي هذه المهارة الحفاظ على
،هدوء أعصابي في جميع الأوقات

145
00:07:02,350 --> 00:07:04,570
.فأظلّ متماسكًا ولا أصاب بالذّعر أبدًا

146
00:07:04,570 --> 00:07:11,570
"...رشّ"

147
00:07:05,020 --> 00:07:07,610
.(والثّانية هي سحر الماء (مبتدئ

148
00:07:07,610 --> 00:07:08,860
،وكما يوحي الاسم

149
00:07:08,860 --> 00:07:11,570
فأنا عالق عند مستوى المبتدئين
.لقلّة ما أمتلكه من طاقة سحريّة

150
00:07:11,980 --> 00:07:14,660
وهناك أيضًا مهارة
.لاعب ألعاب تقمّص الأدوار

151
00:07:14,660 --> 00:07:17,920
تتيح لي هذه المهارة الاستفادة
.من منظور شخص يلعب لعبة ما

152
00:07:18,450 --> 00:07:21,580
يُفترض أنّ ذلك يُمكّنني من
،رؤية وضعي بموضوعيّة

153
00:07:21,990 --> 00:07:23,960
ولكن هل لديك أيّ فكرة
عن كيفية استخدامها؟

154
00:07:23,960 --> 00:07:28,760
ألا يُفترض بك أن تكون الخبير في هذا الأمر
بما أنّك تعشق ألعاب تقمّص الأدوار؟

155
00:07:28,760 --> 00:07:30,130
.أظنّ ذلك

156
00:07:30,130 --> 00:07:32,510
حسنًا، أعتقد أنّني سأكتشف
.الأمر في النّهاية

157
00:07:32,510 --> 00:07:33,970
حسنًا، ماذا عنك يا فوجيان؟

158
00:07:33,970 --> 00:07:38,520
حصلتُ على مهارة التّخزين، الّتي تتيح لي
.إضافة الأغراض إليها وإخراجها منها بحرّيّة

159
00:07:38,520 --> 00:07:41,230
وحصلتُ أيضًا على مهارة
التّقييم، التّي تتيح لي

160
00:07:41,230 --> 00:07:43,850
.معرفة قيمة الأشياء وخصائصها

161
00:07:43,850 --> 00:07:45,770
.كِلا المهارتين من فئة فائقة

162
00:07:45,770 --> 00:07:47,900
.فائقة؟ يا له من أمرٍ رائع

163
00:07:48,230 --> 00:07:50,280
حصلتُ أيضًا على
.مشغّل الرّوايات المرئيّة

164
00:07:50,280 --> 00:07:52,610
إنّها تتيح لي قراءة المحادثات
،مع الآخرين كنصوص

165
00:07:52,610 --> 00:07:56,490
،وحفظها في سجلّ
.والاطّلاع عليها مجدّدًا لاحقًا

166
00:07:56,490 --> 00:07:59,580
يبدو هذا ملائمًا لكلّ ألعاب
.المحاكاة الرّومانسيّة الّتي تلعبها

167
00:07:59,580 --> 00:08:03,000
حسنًا، ولا واحدة من تلك
،المهارات مفيدة في القتال

168
00:08:03,000 --> 00:08:05,880
.لذا أعتقد أنّني سأسعى لأصبح تاجرًا

169
00:08:05,880 --> 00:08:08,000
.إنّه خيار سديد

170
00:08:08,410 --> 00:08:14,380
ربّما ستثبت مهاراتك قيمتها بمجرّد
!أن تبدأ في استخدامها يا تاكي-دونو

171
00:08:14,380 --> 00:08:16,060
.لستُ متأكّدًا تمامًا من ذلك

172
00:08:17,090 --> 00:08:18,980
مهنة؟

173
00:08:19,630 --> 00:08:21,730
،يمكنني استخدام سحر الماء

174
00:08:21,730 --> 00:08:23,940
.لذا فمهنة السّاحر خيار آمن على الأرجح

175
00:08:23,940 --> 00:08:24,860
!تاكاتسكي-كُن

176
00:08:25,270 --> 00:08:27,020
.أرى أنّك استيقظت أخيرًا

177
00:08:27,020 --> 00:08:28,150
.كم سرّني هذا

178
00:08:28,150 --> 00:08:29,780
.كنتُ قلقًا عليك

179
00:08:29,780 --> 00:08:32,030
.فعلاً؟ شكرًا لك

180
00:08:32,240 --> 00:08:33,990
.ساكوراي ريوسكي

181
00:08:33,990 --> 00:08:36,070
،كان شخصيّة محوريّة في فصلنا

182
00:08:36,070 --> 00:08:38,530
ونجم فريق كرة القدم
.رغم كونه في السّنة الأولى

183
00:08:36,770 --> 00:08:40,080
ريوسكي، ماذا تفعل؟

184
00:08:38,530 --> 00:08:40,740
.بصراحة، لم تكن علاقتي به جيّدة

185
00:08:40,080 --> 00:08:41,910
!هيّا بنا، لنذهب

186
00:08:40,740 --> 00:08:43,420
.كان نقيضي تمامًا

187
00:08:41,910 --> 00:08:43,420
.أ-أكيد

188
00:08:44,110 --> 00:08:47,630
تاكاتسكي-كُن، هل قرّرت ما الّذي
ستفعله من الآن فصاعدًا؟

189
00:08:47,630 --> 00:08:50,550
نوعًا ما، على الأرجح أنّي سأتدرّب
.هنا لبعض الوقت

190
00:08:50,550 --> 00:08:53,630
.نحن لسنا بحاجة إلى أيّ تدريب

191
00:08:53,630 --> 00:08:56,340
،ريوسكي هنا هو بطل النّور
.في نهاية المطاف

192
00:08:56,340 --> 00:08:59,100
.أهذا صحيح؟ هذا رائع

193
00:08:59,100 --> 00:09:02,560
.اسمع، نحن نخطّط للانطلاق غدًا

194
00:09:03,010 --> 00:09:05,810
هل تودّ المجيء معنا؟

195
00:09:05,980 --> 00:09:06,810
ماذا؟

196
00:09:06,810 --> 00:09:08,110
!مهلاً يا ريوسكي

197
00:09:08,110 --> 00:09:09,650
!عـ-عمّاذا تتحدّث؟

198
00:09:09,650 --> 00:09:12,910
سيكون حال تاكاتسكي-كُن أفضل
.بصحبة أشخاص مثل فوجيهارا-كُن

199
00:09:11,810 --> 00:09:14,190
،أرغب حقًّا في التّدرّب هنا لبعض الوقت

200
00:09:14,190 --> 00:09:15,610
.لذا سأبقى هنا

201
00:09:15,610 --> 00:09:16,820
.فهمت

202
00:09:16,820 --> 00:09:18,160
.على أيّة حال، شكرًا لك

203
00:09:18,160 --> 00:09:19,320
.إلى اللّقاء

204
00:09:19,320 --> 00:09:22,040
ريوسكي، علينا الاستعداد للغد، صحيح؟

205
00:09:19,320 --> 00:09:24,370
حتّى لو ذهبت معهم، فلن أكون
.قادرًا إلاّ على حمل معدّاتهم

206
00:09:22,040 --> 00:09:23,330
!لنُسرع بالذّهاب

207
00:09:23,330 --> 00:09:24,370
.حسنًا، نعم

208
00:09:24,370 --> 00:09:28,050
،علاوة على ذلك، بوجود الفتاتين
.سأتحوّل بالتّأكيد إلى خادم لهما

209
00:09:28,580 --> 00:09:30,790
،يا إلهة الماء إير

210
00:09:30,790 --> 00:09:33,840
.تقبّلي صلواتنا الخاشعة

211
00:09:33,840 --> 00:09:36,050
،يا إلهة الماء إير

212
00:09:34,830 --> 00:09:38,340
.بدأتُ تدريبي في فئة المبتدئين

213
00:09:36,050 --> 00:09:38,840
.تقبّلي صلواتنا الخاشعة

214
00:09:38,340 --> 00:09:42,600
وبالطّبع، كان ذلك يعني أنّني كنتُ
.وحدي، دون أيٍّ من زملائي الآخرين

215
00:09:38,840 --> 00:09:41,730
!حافظوا على ثبات إنشادكم. مرّة أخرى

216
00:09:42,600 --> 00:09:46,100
كانت قوّة التّعاويذ الّتي يمكن إطلاقها
،تعتمد على مقدار الطّاقة السّحريّة

217
00:09:46,100 --> 00:09:48,310
.أو المانا، الّتي يمتلكها السّاحر

218
00:09:48,310 --> 00:09:51,940
ونظرًا لأنّ مستوى المانا لديّ منخفض
.للغاية، ظللتُ عالقًا في مستوى المبتدئين

219
00:09:51,940 --> 00:09:55,740
كان أقصى ما استطعت فعله هو استحضار
.كرة ماء بحجم كرة تنس الطّاولة

220
00:09:56,310 --> 00:09:59,990
لحسن الحظّ، فإنّ الإتقان، أي السّرعة
،الّتي يمكن للمرء بها استخدام السّحر

221
00:09:59,990 --> 00:10:02,740
،يتحسّن كلّما زادت ممارسة السّحر

222
00:10:00,940 --> 00:10:01,920
!أجل

223
00:10:02,740 --> 00:10:05,800
.لذا كنت أتدرّب على استخدام الماء يوميًّا

224
00:10:07,370 --> 00:10:09,630
خلال تلك الفترة، كان زملائي في الفصل

225
00:10:09,630 --> 00:10:12,960
يغادرون المعبد تباعًا بصحبة
شخصيّات مرموقة من دول أخرى

226
00:10:12,960 --> 00:10:15,060
.أو كشّافة يمثّلون مجموعات متنوّعة

227
00:10:16,750 --> 00:10:19,510
ستغادر أنت أيضًا أخيرًا يا فوجيان؟

228
00:10:19,510 --> 00:10:20,390
.نعم

229
00:10:20,630 --> 00:10:24,390
،سأذهب إلى ماكالان
.وهي البلدة الأقرب من هنا

230
00:10:24,390 --> 00:10:27,520
.سأعمل هناك كتاجر

231
00:10:27,520 --> 00:10:28,820
.فهمت

232
00:10:29,650 --> 00:10:31,150
،بمجرّد أن تغادر هذا المكان

233
00:10:31,150 --> 00:10:33,400
احرص على المرور علينا، موافق؟

234
00:10:34,890 --> 00:10:36,150
.حسنًا

235
00:10:36,150 --> 00:10:38,490
.حظًّا موفّقًا في تدريبك

236
00:10:38,490 --> 00:10:40,460
!اعتنِ بنفسك أنت أيضًا

237
00:10:47,240 --> 00:10:49,620
أصبحتُ أخيرًا قادرًا على استخدامها
.بشكل جيّد بعد تسعة أشهر

238
00:10:49,620 --> 00:10:51,420
!يا للرّوعة! إنّها الكاهنة صوفيا

239
00:10:53,670 --> 00:10:55,380
!الكاهنة صوفيا

240
00:10:53,670 --> 00:10:55,380
الكاهنة صوفيا؟

241
00:10:55,380 --> 00:10:57,670
.اللّيدي صوفيا إير روزس

242
00:10:57,670 --> 00:11:00,180
...إنّها أميرة روزس

243
00:11:00,180 --> 00:11:03,180
.وكاهنة الماء كذلك

244
00:11:03,180 --> 00:11:05,680
.أظنّ أنّها جاءت لاختيار الأشخاص بنفسها

245
00:11:06,380 --> 00:11:08,650
!تقوم كاهنة الماء باختيار الأشخاص بنفسها

246
00:11:10,340 --> 00:11:11,520
.فهمت

247
00:11:11,520 --> 00:11:13,980
إذًا فأنت تمتلك مهارة الفارس الذّهبيّ؟

248
00:11:13,980 --> 00:11:17,160
.اسمح لي إذًا بمنحك بركتها

249
00:11:19,270 --> 00:11:22,490
.أصبحتَ الآن أنت أيضًا من أتباع الإلهة إير

250
00:11:23,020 --> 00:11:25,950
.رجاءً، سخّر قوّتك لخدمة أمّتنا

251
00:11:25,950 --> 00:11:26,990
!سأفعل

252
00:11:26,990 --> 00:11:28,540
!شكرًا جزيلاً لك

253
00:11:28,540 --> 00:11:29,500
...والآن

254
00:11:29,500 --> 00:11:30,840
!أيّتها اللّيدي صوفيا

255
00:11:31,250 --> 00:11:34,380
!سأصبح أنا أيضًا من أتباع إلهة الماء

256
00:11:34,380 --> 00:11:36,500
!هل يمكنك منحي بركتها من فضلك؟

257
00:11:46,590 --> 00:11:47,890
.لا بأس

258
00:11:47,890 --> 00:11:50,770
.تدرّبتُ بجدّ طوال هذه الفترة

259
00:11:51,340 --> 00:11:54,270
سحر الماء؟ مستوى المبتدئين؟

260
00:11:56,010 --> 00:11:57,610
.عليك العمل بجدّ

261
00:11:57,610 --> 00:11:58,980
حـ-حسنًا؟

262
00:11:58,980 --> 00:11:59,780
...والآن

263
00:11:59,780 --> 00:12:00,530
!ماذا؟

264
00:12:00,890 --> 00:12:01,610
!مهلاً

265
00:12:01,610 --> 00:12:02,860
!انتظري لحظة من فضلك

266
00:12:02,860 --> 00:12:04,030
!امنحني بركةً أنا أيضًا

267
00:12:03,480 --> 00:12:04,030
!مهلاً

268
00:12:04,030 --> 00:12:05,530
!أنت! تصرّفك يفتقر للاحترام

269
00:12:04,480 --> 00:12:05,530
!رجاءً

270
00:12:05,530 --> 00:12:07,280
!أيّتها اللّيدي صوفيا

271
00:12:06,070 --> 00:12:07,280
!توقّف

272
00:12:08,610 --> 00:12:12,830
.يبدو أنّك بحاجة للمزيد من التّدريب أوّلاً

273
00:12:12,830 --> 00:12:14,470
.ربّما في المرّة القادمة

274
00:12:27,500 --> 00:12:29,060
لماذا؟

275
00:12:29,060 --> 00:12:30,690
لماذا أنا فقط؟

276
00:12:31,300 --> 00:12:32,680
...هذا العالم

277
00:12:32,680 --> 00:12:34,440
!لعبة قذرة

278
00:12:35,680 --> 00:12:36,940
،بعد ذلك

279
00:12:36,940 --> 00:12:40,980
،لم يأتِ أيُّ كشّافة لضمّي
،أنا الأضعف بينهم

280
00:12:40,980 --> 00:12:43,910
.انقضت سنتي أخيرًا

281
00:12:47,690 --> 00:12:49,240
.شكرًا لكم على كلّ ما قدّمتموه من رعاية

282
00:12:49,240 --> 00:12:51,120
!رجاءً، توخّ الحذر

283
00:12:51,120 --> 00:12:52,450
!لا تمت في الخارج

284
00:12:52,450 --> 00:12:54,590
!وإذا واجهت أيّ وحوش... فاهرب

285
00:12:55,320 --> 00:12:59,800
كنتُ ساحرًا متدرّبًا عالقًا بمهارات
.غير موثوقة، ولم يرغب بي أحد

286
00:13:00,160 --> 00:13:04,260
حسنًا، إنهاء لعبة قذرة
.هو سمةُ اللاّعب الحقيقيّ

287
00:13:04,260 --> 00:13:08,520
!سأقوم بإنهاء هذا العالم بالكامل

288
00:13:07,380 --> 00:13:11,010
اجتياز عالم آخر بالكامل"
"برفقة إلهة لا يؤمن بها أحد

289
00:13:16,890 --> 00:13:18,410
.يا له من هدوء

290
00:13:18,770 --> 00:13:22,280
.لم أشعر بوجود أيّ وحوش مؤخّرًا

291
00:13:22,280 --> 00:13:25,400
ربّما يجدر بي التّدرّب على السّحر
.أثناء سيري إذًا

292
00:13:25,400 --> 00:13:28,280
سيساعدني ذلك على تحسين مستوى
!إتقاني أيضًا، وأضرب عصفورين بحجر

293
00:13:29,270 --> 00:13:32,740
لا، لا، لا ينبغي لي إهدار المانا
.الخاصّة بي على ذلك الآن

294
00:13:32,740 --> 00:13:35,290
فمدينة ماكالان لا تزال
.بعيدة جدًّا على أيّة حال

295
00:13:36,240 --> 00:13:38,830
أتساءل كيف حال فوجيان؟

296
00:13:39,990 --> 00:13:42,050
.تلقّيت إشارة عبر مهارة الاستطلاع

297
00:13:42,050 --> 00:13:43,920
!هذا مفيد للغاية

298
00:13:43,920 --> 00:13:46,640
،يمكنني الاختباء أو تجنّبها
!لذا فالأمر سيكون في غاية السّهولة

299
00:13:47,630 --> 00:13:48,510
!النّجدة

300
00:13:48,510 --> 00:13:49,550
!ليساعدني أحد ما

301
00:13:49,550 --> 00:13:50,640
...مستحيل

302
00:13:50,640 --> 00:13:51,810
أهنالك من...؟

303
00:13:58,560 --> 00:14:01,570
...بدأ الأمر أخيرًا يبدو وكأنّه لعبة، ولكن

304
00:14:01,570 --> 00:14:03,570
!ابتعدوا

305
00:14:01,570 --> 00:14:03,570
.يبدو ذلك خطيرًا للغاية

306
00:14:04,270 --> 00:14:06,570
.هذا هو الواقع الآن

307
00:14:06,570 --> 00:14:08,490
.إذا متُّ هنا، فستكون النّهاية

308
00:14:08,490 --> 00:14:11,280
.لا أستطيع فعل أيّ شيء هنا

309
00:14:11,280 --> 00:14:12,080
!أنا آسف

310
00:14:11,280 --> 00:14:13,580
!لا أريد الموت الآن

311
00:14:13,580 --> 00:14:15,380
!النّجدة

312
00:14:17,990 --> 00:14:19,720
.أوّلاً، اهدأ

313
00:14:20,160 --> 00:14:21,840
.صفاء الذّهن

314
00:14:26,090 --> 00:14:30,590
"أنقذ التّاجر؟"
"نعم" "لا"

315
00:14:26,410 --> 00:14:27,510
ما هذا؟

316
00:14:27,510 --> 00:14:30,590
هل هذا تأثير لمهارتي
كلاعب ألعاب تقمّص أدوار؟

317
00:14:30,590 --> 00:14:33,850
.مهلاً، يا له من تصميم متقن ومدروس

318
00:14:35,880 --> 00:14:39,350
.لن أكون لاعبًا حقيقيًّا إن لم أنقذه الآن

319
00:14:39,350 --> 00:14:42,660
!حسنًا، حان وقت أوّل معركة

320
00:14:46,060 --> 00:14:48,610
!سحر الماء: سهم الجليد

321
00:14:51,480 --> 00:14:52,870
.كانت ضربة ضعيفة

322
00:14:53,230 --> 00:14:55,870
أظنّ أنّ سحري لا يكفي لهزيمتهم؟

323
00:14:55,870 --> 00:14:58,210
.ومع ذلك، فقد لفتُّ انتباههم

324
00:14:59,870 --> 00:15:01,040
!إنّه ضخم

325
00:15:01,040 --> 00:15:03,430
إذا تلقّيتُ هجومًا من ذلك
...الوحش، فحينها

326
00:15:04,250 --> 00:15:06,250
...أفضّل تجنّب القتال القريب، لكن

327
00:15:06,450 --> 00:15:08,970
!سحر الماء: إبر الجليد

328
00:15:13,000 --> 00:15:13,640
!أجل

329
00:15:15,890 --> 00:15:16,850
!الآن

330
00:15:18,470 --> 00:15:21,270
!سحر الماء: تجميد

331
00:15:30,400 --> 00:15:31,490
!لقد نجحت

332
00:15:31,490 --> 00:15:34,530
.تمكّنتُ من تجميد دمه ببراعة

333
00:15:34,530 --> 00:15:36,290
.لكنّ المانا قد نفدت منّي الآن

334
00:15:36,790 --> 00:15:38,290
.سأستخدم مهارة الهروب

335
00:15:42,200 --> 00:15:44,460
.لا بدّ أن يكون هناك نهرٌ بالجوار

336
00:15:44,460 --> 00:15:46,040
...إذا استخدمتُ مهارة لاعب تقمّص الأدوار

337
00:15:47,550 --> 00:15:49,550
...جيد. طالما أنّ لديّ ماء

338
00:15:50,370 --> 00:15:52,800
!سحر الماء: المشي على الماء

339
00:15:54,840 --> 00:15:56,900
!أنتم، أنا هنا

340
00:15:58,060 --> 00:15:59,060
!جيّد

341
00:15:59,060 --> 00:16:01,640
!سحر الماء، تدفّق

342
00:16:15,900 --> 00:16:17,870
!نجحتُ في ذلك

343
00:16:17,870 --> 00:16:21,670
لم أتخيّل قطّ أنّ تكون معركتي
.الأولى ضدّ مجموعة من الغوبلن

344
00:16:23,530 --> 00:16:24,710
...مع ذلك

345
00:16:25,080 --> 00:16:28,670
يبدو أنّني سأتمكّن من تدبّر
.أموري بفضل مهاراتي الفريدة

346
00:16:28,670 --> 00:16:29,960
أيّها المغامر؟

347
00:16:30,710 --> 00:16:32,010
!كم أراحني هذا

348
00:16:32,010 --> 00:16:33,640
!أنت بأمان أيضًا

349
00:16:34,710 --> 00:16:37,220
.يا إلهي، لقد أنقذتني حقًّا قبل قليل

350
00:16:37,220 --> 00:16:40,060
.ثمّ وافقتَ حتّى على حمايتي

351
00:16:40,060 --> 00:16:42,600
.كان ذلك هو التّصرّف الصّائب

352
00:16:42,600 --> 00:16:44,640
،شكرتني بما فيه الكفاية بالفعل

353
00:16:44,640 --> 00:16:46,900
.كما أنّك تسمح لي بمرافقتك إلى ماكالان

354
00:16:46,900 --> 00:16:49,480
.كنتُ متّجهًا إلى هناك أيضًا

355
00:16:49,480 --> 00:16:51,480
.ومع ذلك، أنا سعيد جدًّا جدًّا

356
00:16:50,100 --> 00:16:53,610
.مهلاً، لقد امتدّ عمري قليلاً للتّوّ

357
00:16:53,610 --> 00:16:56,280
.ويبدو أنّ مستواي قد ارتفع أيضًا

358
00:16:56,280 --> 00:16:58,030
،بدأ الظّلام يحلّ

359
00:16:58,030 --> 00:17:00,830
.لذا دعنا نُعِدّ مخيّمًا للمبيت في الأمام

360
00:17:15,880 --> 00:17:18,440
أين أنا؟

361
00:17:20,710 --> 00:17:23,730
.سررت بلقائك يا ماكوتو

362
00:17:23,730 --> 00:17:25,730
.أردتُ لقاءك

363
00:17:26,390 --> 00:17:27,570
من أنت؟

364
00:17:28,510 --> 00:17:31,230
.أنا إلهة

365
00:17:31,470 --> 00:17:34,580
أنت إلهة؟

366
00:17:35,230 --> 00:17:36,290
...عفوًا

367
00:17:36,690 --> 00:17:39,240
ما الّذي تريدينه منّي؟

368
00:17:39,240 --> 00:17:41,660
.كنتُ أراقبك طوال هذا الوقت

369
00:17:41,660 --> 00:17:46,080
.لذا أودّ أن أتّخذك تابعًا لي

370
00:17:46,080 --> 00:17:46,960
ماذا؟

371
00:17:46,960 --> 00:17:49,550
.أعلّق عليك آمالاً كثيرة

372
00:17:50,540 --> 00:17:51,750
،ماكوتو

373
00:17:52,790 --> 00:17:55,130
هلاّ صرتَ تابعي وآمنت بي؟

374
00:17:57,750 --> 00:17:59,190
تابعك؟

375
00:17:59,890 --> 00:18:04,020
.يبدو أنّك بحاجة للمزيد من التّدريب أوّلاً

376
00:18:04,020 --> 00:18:05,890
.ربّما في المرّة القادمة

377
00:18:07,090 --> 00:18:10,150
كانت راهبة الماء قاسية، صحيح؟

378
00:18:10,150 --> 00:18:14,900
ليس عليك أن تؤمن بالإلهة
.الّتي يؤمن بها الأشخاص من أمثالها

379
00:18:14,900 --> 00:18:17,040
هل قرأت أفكاري؟

380
00:18:19,150 --> 00:18:22,040
هل يمكنني أن أسألك عن اسمك أيّتها الإلهة؟

381
00:18:22,820 --> 00:18:25,160
،أنا مجرّد إلهة صغيرة

382
00:18:25,160 --> 00:18:28,040
.لذلك أشكّ في أنّ لاسمي أيّ معنى لك

383
00:18:28,040 --> 00:18:31,250
ما زلتُ أرغب في معرفته
.إذا كنتُ سأصبحُ مؤمنًا بك

384
00:18:31,250 --> 00:18:33,170
.سأخبرك به في النّهاية

385
00:18:34,620 --> 00:18:36,920
،قلتِ أنّك كنت تراقبينني طوال هذا الوقت

386
00:18:36,920 --> 00:18:40,300
لكن لماذا لم تقومي باختياري
عندما كنتُ لا أزال في معبد الماء؟

387
00:18:40,300 --> 00:18:44,060
.يقع معبد الماء تحت وصاية إلهة الماء إير

388
00:18:44,060 --> 00:18:45,680
.لذا اخترتُ الامتناع عن ذلك

389
00:18:45,680 --> 00:18:48,690
لكن جاء أتباع إلهات أخريات
.لاختيار النّاس هناك

390
00:18:48,690 --> 00:18:51,190
.حسنًا، سررت من أجلهم

391
00:18:51,190 --> 00:18:53,190
.لقد تهرّبت من الرّدّ على ذلك

392
00:18:53,190 --> 00:18:54,610
!والآن يا ماكوتو

393
00:18:54,610 --> 00:18:56,690
!لنجعلك تابعًا مؤمنًا بي

394
00:18:56,690 --> 00:19:01,700
لماذا قد ترغب في أن أكون أنا بمهاراتي
وإحصائيّاتي الضّعيفة تابعًا لها؟

395
00:19:01,700 --> 00:19:05,950
في ألعاب تقمّص الأدوار، غالبًا ما تكون هناك
.خدعة أو شرط خفيّ وراء صفقات كهذه

396
00:19:05,950 --> 00:19:07,660
.لا توجد أيّ خدع

397
00:19:07,660 --> 00:19:09,250
.سأحتاج لبعض الوقت للتّفكير في الأمر

398
00:19:09,250 --> 00:19:09,710
!ماذا؟

399
00:19:09,710 --> 00:19:11,580
!أ-أرجوك تمهّل

400
00:19:11,580 --> 00:19:13,040
!ستصبح تابعًا لإلهة

401
00:19:13,040 --> 00:19:17,590
إنّ الكلام مباشرة مع إلهتك
يُعدّ شرفًا عظيمًا، أتعلم ذلك؟

402
00:19:17,590 --> 00:19:19,840
هل هي إلهة حقيقيّة؟

403
00:19:19,840 --> 00:19:21,590
!أنا إلهة حقيقيّة

404
00:19:23,040 --> 00:19:23,850
...اسمع

405
00:19:23,850 --> 00:19:28,520
من الصّعب للغاية عليّ
،المجيء إلى عالم البشر

406
00:19:28,520 --> 00:19:31,350
لذا هل يمكننا إبرام العقد اللّيلة؟

407
00:19:32,100 --> 00:19:33,350
أرجوك؟

408
00:19:34,010 --> 00:19:35,980
.أرجوكِ، اتركيني للحظة

409
00:19:35,980 --> 00:19:37,400
.أنت قريبة جدًّا

410
00:19:37,400 --> 00:19:38,610
ما... ماذا؟

411
00:19:38,940 --> 00:19:40,200
.لن ينجح هذا معي

412
00:19:40,200 --> 00:19:41,610
.سحرُ الفتن خاصّتك

413
00:19:41,610 --> 00:19:42,610
ماذا؟

414
00:19:42,900 --> 00:19:45,370
.بإمكاني الحفاظ على موضوعيّتي

415
00:19:45,370 --> 00:19:46,960
!ماذا؟

416
00:19:47,780 --> 00:19:48,620
...لا

417
00:19:48,620 --> 00:19:50,660
!لا، لا، لا

418
00:19:50,660 --> 00:19:53,880
سنحت لي الفرصة أخيرًا
!لأكسب تابعًا بعد ألف عام

419
00:19:53,880 --> 00:19:58,380
!أحتاج منك أن تصبح تابعًا بي فورًا

420
00:19:55,450 --> 00:19:58,380
.يمكنني رؤية ما تحت تنّورتك

421
00:19:59,250 --> 00:20:03,430
إذًا... هل ستصبح تابعًا لي
إن سمحتُ لك بإلقاء نظرة؟

422
00:20:03,430 --> 00:20:05,350
كيف لك أن تقترحي أمرًا كهذا؟

423
00:20:05,350 --> 00:20:07,260
!أرجوك، أرجوك، أرجوك

424
00:20:07,260 --> 00:20:08,850
!أرجوك، صر تابعي

425
00:20:08,850 --> 00:20:10,850
!أرجوك

426
00:20:10,850 --> 00:20:14,560
!أنت الوحيد المتبقّي لي

427
00:20:12,090 --> 00:20:14,560
.يبدو هذا الأمر مريبًا للغاية

428
00:20:14,560 --> 00:20:16,400
!أرجوك، أرجوك

429
00:20:15,360 --> 00:20:17,360
"هل ستصبح من أتباع الإلهة؟"
"نعم" "لا"

430
00:20:16,400 --> 00:20:20,860
مع ذلك، هذه هي المرّة الأولى الّتي يكلّف
...فيها أحدهم نفسه عناء استقطابي

431
00:20:18,020 --> 00:20:19,860
!أرجوك

432
00:20:19,860 --> 00:20:22,860
!أتوسّل إليك

433
00:20:21,390 --> 00:20:22,860
.حسنًا

434
00:20:22,860 --> 00:20:23,620
ماذا؟

435
00:20:25,400 --> 00:20:26,910
.سأصبح من أتباعك

436
00:20:26,910 --> 00:20:27,620
ماذا؟

437
00:20:27,620 --> 00:20:29,620
هـ... هل أنت متأكّد؟

438
00:20:29,620 --> 00:20:30,620
.نعم

439
00:20:30,620 --> 00:20:31,870
!مرحى

440
00:20:31,870 --> 00:20:33,120
!أجل! أجل

441
00:20:33,120 --> 00:20:35,380
!أجل! مرحى

442
00:20:33,120 --> 00:20:35,380
.تبدو تلك الهيبة الّتي بدأت بها وكأنّها كذبة

443
00:20:35,380 --> 00:20:38,380
إذًا هل يمكنك إعارتي
كتاب الرّوح الخاصّ بك للحظة؟

444
00:20:38,380 --> 00:20:41,140
.نعم، تفضّلي

445
00:20:45,890 --> 00:20:48,390
أوّل تابع مؤمنٍ بالإلهة"؟"

446
00:20:48,710 --> 00:20:50,520
ألا يوجد أحدٌ غيري؟

447
00:20:50,520 --> 00:20:52,560
.كان لديّ المزيد في الماضي

448
00:20:52,560 --> 00:20:54,560
.أنت أوّل تابع أحظى به منذ وقتٍ طويل

449
00:20:54,560 --> 00:20:56,240
!اعتبر ذلك شرفًا عظيمًا

450
00:20:56,970 --> 00:20:59,650
حسنًا، وما هي بركاتك؟

451
00:21:00,060 --> 00:21:03,490
،إن واظبتَ على الصّلاة لي كلّ يوم
!فستنالها في الوقت المناسب

452
00:21:03,940 --> 00:21:05,320
.هكذا إذًا

453
00:21:05,320 --> 00:21:06,660
!لكن لا تقلق

454
00:21:06,660 --> 00:21:08,410
.سأعطيك هذا بدلاً من ذلك

455
00:21:08,730 --> 00:21:11,040
!لكنّني لن أسامحك إن أضعتَه

456
00:21:11,040 --> 00:21:13,410
.احرص على الإمساك به أثناء الصّلاة

457
00:21:13,700 --> 00:21:17,210
حسنًا، اعتمد عليّ إن واجهت
أيّ صعوبات، اتّفقنا؟

458
00:21:17,210 --> 00:21:17,710
ماذا؟

459
00:21:17,710 --> 00:21:20,210
مهلاً، أليس لديك أيّ توجيهات لي؟

460
00:21:20,210 --> 00:21:22,170
تُفضّل الألعاب ذات العالم
المفتوح، أليس كذلك؟

461
00:21:22,170 --> 00:21:23,840
.أرى أنّ معرفتك واسعة

462
00:21:24,330 --> 00:21:26,430
.إذًا ثمّة أمر واحد فقط

463
00:21:26,430 --> 00:21:28,010
!صر أقوى رجاءً

464
00:21:28,010 --> 00:21:30,480
.لن أسامحك إن متَّ بسهولة بالغة

465
00:21:31,260 --> 00:21:34,180
لأنّك تابعي الوحيد، مفهوم؟

466
00:21:34,510 --> 00:21:37,190
.أعقد عليك آمالاً كبيرة

467
00:21:37,800 --> 00:21:38,910
آمالاً كبيرة؟

468
00:21:39,390 --> 00:21:41,910
!حسنًا، حظًّا موفّقًا

469
00:21:51,320 --> 00:21:52,700
...خنجر الغوبلن

470
00:21:53,820 --> 00:21:55,630
.إذًا لم يكن ذلك حلمًا

471
00:21:56,700 --> 00:21:59,720
!أيّتها الإلهة، شكرًا جزيلاً لك

472
00:22:01,120 --> 00:22:04,260
!سأبذل قصارى جهدي لأكون عند حسن ظنّك

473
00:23:35,050 --> 00:23:40,020
:الحلقة الثّانية"
"يخوض تاكاتسكي ماكوتو تحدّيًا"