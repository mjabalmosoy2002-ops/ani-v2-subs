1
00:00:02,950 --> 00:00:04,980
!شكرًا على الوجبة

2
00:00:05,240 --> 00:00:07,610
!كانت لذيذة جدًا

3
00:00:07,610 --> 00:00:10,200
.يسعدني أنّها أعجبت الجميع

4
00:00:10,200 --> 00:00:11,570
.ها هو شاي ما بعد العشاء

5
00:00:12,340 --> 00:00:13,590
.شكرًا لك

6
00:00:14,880 --> 00:00:17,530
رائحته طيبة. إنه شاي هوجيتشا، صحيح؟

7
00:00:17,900 --> 00:00:20,620
اعتدنا على حياة المسكن هذه حقًا، صحيح؟

8
00:00:20,620 --> 00:00:21,500
.أجل

9
00:00:21,880 --> 00:00:24,040
.أعتقد أنّ غرفتي صغيرة نوعًا ما

10
00:00:24,040 --> 00:00:26,960
.ربما لأنك تملكين أدوات رياضية كثيرة

11
00:00:27,280 --> 00:00:29,710
!أحتاج لكل واحدة فيها

12
00:00:29,710 --> 00:00:32,220
.يبدو أنّ سريري هو ما يعترض طريقي

13
00:00:32,220 --> 00:00:34,430
وأين ستنامين دونه؟

14
00:00:34,940 --> 00:00:38,890
.ظننت أنني سعدت لحصولي على غرفة لوحدي أخيرًا

15
00:00:39,210 --> 00:00:41,720
كنت لأفضل غرفة تقليدية

16
00:00:41,720 --> 00:00:44,100
.وكوتاتسو على حصيرة التاتامي

17
00:00:44,520 --> 00:00:46,880
!يجب أن أحصل على أرضية خشبية

18
00:00:46,880 --> 00:00:48,310
ماذا عنك يا هارونا؟

19
00:00:49,720 --> 00:00:50,670
هارونا؟

20
00:00:51,870 --> 00:00:54,490
مايكا-تشان، هل من مشكلة؟

21
00:00:54,840 --> 00:00:57,450
كنا نسألك عن غرفتك. هل استقررت أخيرًا؟

22
00:00:57,820 --> 00:01:00,040
.أجل

23
00:01:00,040 --> 00:01:01,290
...ربما

24
00:01:01,610 --> 00:01:02,870
ما الذي يعنيه ذلك؟

25
00:01:05,000 --> 00:01:06,790
.عاد أحدهم

26
00:01:08,120 --> 00:01:10,210
.أهلًا بعودتك

27
00:01:10,210 --> 00:01:12,220
.لقد عدت

28
00:01:13,220 --> 00:01:14,650
ما رأيكم في بعض العشاء؟

29
00:01:14,650 --> 00:01:17,820
.كلا شكرًا. تناولنا بينتو

30
00:01:21,340 --> 00:01:22,780
.أشعر بالنعاس

31
00:01:22,780 --> 00:01:25,800
.ستصابين بالزكام إن نمت هنا

32
00:01:25,800 --> 00:01:27,220
.فلنوصلك لغرفتك

33
00:01:29,990 --> 00:01:32,150
هل أنتم بخير؟

34
00:01:33,080 --> 00:01:34,980
.نحن بخير

35
00:01:36,020 --> 00:01:37,610
.ليلة سعيدة

36
00:01:39,440 --> 00:01:41,580
.أصبح الأمر هكذا في كل ليلة مؤخرًا

37
00:01:41,920 --> 00:01:45,080
هل تعتقدين أنّ دروسهم صعبة لتلك الدرجة؟

38
00:01:45,080 --> 00:01:46,680
.هذا جنونيّ

39
00:01:46,680 --> 00:01:49,320
.علينا التدرّب من أجل التسجيل نحن أيضًا

40
00:01:49,320 --> 00:01:52,600
.معك حقّ. بقي أمامنا يومان حتى بداية الحصص

41
00:01:52,600 --> 00:01:53,800
.لا اعتراض

42
00:01:53,800 --> 00:01:54,550
...أنت أيضًا يا هارونا

43
00:01:56,190 --> 00:01:57,370
.لقد اختفت

44
00:03:48,440 --> 00:03:50,000
.أهلًا بعودتك يا هارونا

45
00:03:50,000 --> 00:03:52,400
.شكرًا لك

46
00:03:52,400 --> 00:03:54,080
لماذا اختفيت فجأة؟

47
00:03:54,570 --> 00:03:57,180
.من أجل شراء بعض الأشياء من المتجر

48
00:03:57,180 --> 00:03:59,040
هل تريدين التدرّب معنا؟

49
00:03:59,040 --> 00:04:01,550
.أجل. عليّ الذهاب لغرفتي لبعض الوقت فحسب

50
00:04:02,090 --> 00:04:04,710
لحظة، اشتريت ملفوفًا؟

51
00:04:05,170 --> 00:04:07,850
.أجل. اشتهيت واحدًا فجأة

52
00:04:08,220 --> 00:04:10,080
ستأكلينه كله؟

53
00:04:10,080 --> 00:04:11,140
في غرفتك؟

54
00:04:11,140 --> 00:04:12,570
بمفردك؟

55
00:04:12,570 --> 00:04:16,230
.هذا صحيح. أظنني لم أتناول خضروات كافية مؤخرًا

56
00:04:16,570 --> 00:04:17,900
.هذا مريب

57
00:04:17,900 --> 00:04:19,320
ما الذي تخفينه؟

58
00:04:19,660 --> 00:04:21,680
!لا أخفي أيّ شيء

59
00:04:21,680 --> 00:04:22,780
!إلى اللقاء

60
00:04:23,270 --> 00:04:24,390
!هارونا

61
00:04:24,820 --> 00:04:26,900
.من السهل فهمها

62
00:04:27,320 --> 00:04:29,240
.فلنتحرّ

63
00:04:36,390 --> 00:04:38,670
.يمكنني سماع حديث

64
00:04:38,670 --> 00:04:40,960
هل تعتقدون أنها على الهاتف مع أحدهم؟

65
00:04:41,340 --> 00:04:43,220
.افتح فمك

66
00:04:44,260 --> 00:04:47,000
.يسعدني أنّ شهيتك مفتوحة هذا اليوم

67
00:04:47,000 --> 00:04:48,430
.لا تتحدّث على الهاتف

68
00:04:50,450 --> 00:04:51,890
.الباب مفتوح

69
00:04:52,390 --> 00:04:54,120
.هارونا، سندخل

70
00:04:57,240 --> 00:04:58,480
ما الذي تفعلينه؟

71
00:04:58,480 --> 00:05:00,800
كم مضى على وجودكم هنا؟

72
00:05:00,800 --> 00:05:02,430
ماذا يوجد خلفك؟

73
00:05:02,430 --> 00:05:04,660
.ماذا؟ لا شيء! لا شيء على الإطلاق

74
00:05:10,680 --> 00:05:12,490
...أهذه

75
00:05:12,830 --> 00:05:13,760
سلحفاة؟...

76
00:05:13,760 --> 00:05:14,960
!لا تنادوه هكذا

77
00:05:14,960 --> 00:05:17,320
.آسفة

78
00:05:17,320 --> 00:05:19,310
.لكنها سلحفاة فعلًا

79
00:05:19,310 --> 00:05:21,420
.سلحفاة بلا شكّ

80
00:05:21,420 --> 00:05:24,970
لن تحبي الأمر إن ناداك أحدهم بـ"بشرية"، صحيح؟

81
00:05:25,290 --> 00:05:28,780
.يملك اسمًا هو أيضًا. يدعى كامي-سان

82
00:05:28,780 --> 00:05:29,930
كامي-سان؟

83
00:05:30,240 --> 00:05:32,220
.صحيح. كامي-سان

84
00:05:32,640 --> 00:05:33,390
.انظروا إليه

85
00:05:33,720 --> 00:05:35,850
ألا يبدو وجهه مثل وجه رجل عجوز؟

86
00:05:36,770 --> 00:05:39,660
.أظنّ أنّ جميع السلاحف تملك وجهًا كهذا

87
00:05:39,660 --> 00:05:42,110
!سبق وأخبرتكم أنه ليس سلحفاة

88
00:05:42,110 --> 00:05:43,440
،أتعلمين يا هارونا

89
00:05:43,440 --> 00:05:45,260
.الحيوانات الأليفة غير مسموح بها في المسكن

90
00:05:46,080 --> 00:05:49,900
.صحيح، ذكر ريو-سان ذلك عندما انتقلنا

91
00:05:49,900 --> 00:05:51,990
.ليس وكأنك لم تعرفي ذلك

92
00:05:51,990 --> 00:05:53,520
...أجل

93
00:05:53,520 --> 00:05:56,670
.لكنّ كامي-سان صديقي

94
00:05:59,640 --> 00:06:02,000
السلحفاة صديقك؟

95
00:06:02,620 --> 00:06:07,640
كلما كنت غير واثقة بخصوص أمر ما، أطلب النصح
.من كامي-سان

96
00:06:07,640 --> 00:06:10,720
.أشعر أنه في إمكاني التحدث إليه بخصوص أيّ شيء

97
00:06:11,100 --> 00:06:14,430
.أعني، انظروا إليه. يملك وجه حكيم نوعًا ما

98
00:06:14,830 --> 00:06:17,660
ألا تملك جميع السلاحف وجوهًا كتلك؟

99
00:06:17,660 --> 00:06:19,390
!هذا غير صحيح

100
00:06:19,390 --> 00:06:22,180
.هذا لا يغيّر كونه يخالف القوانين

101
00:06:23,140 --> 00:06:24,230
.صحيح

102
00:06:24,600 --> 00:06:30,360
.أنا فقط... لا أعلم ما قد أفعله من دون كامي-سان

103
00:06:31,300 --> 00:06:37,160
هل يمكن لكامي-سان البقاء إن وافقنا جميعًا على ذلك؟

104
00:06:37,520 --> 00:06:38,970
.هونوكا-تشان

105
00:06:38,970 --> 00:06:40,370
لمَ تقولين ذلك؟

106
00:06:40,880 --> 00:06:43,680
.نملك كلبًا في منزلنا

107
00:06:43,680 --> 00:06:45,840
.كنا رفقة بعض منذ كنت طفلة صغيرة

108
00:06:46,330 --> 00:06:47,800
...هونوكا-تشان

109
00:06:48,090 --> 00:06:52,760
.لكنك تركت كلبك وأنت تواجهين الحياة من دونه الآن

110
00:06:53,970 --> 00:06:57,980
صحيح، لا يمكنني إحضار كلب رفقتي

111
00:06:57,980 --> 00:07:01,130
.لكني أتفهم مدى صعوبة الفراق

112
00:07:01,130 --> 00:07:03,610
.ليس وكأنّ السلحفاة تنبح

113
00:07:04,500 --> 00:07:06,810
.عليكم أنتم الأربعة تقرير ذلك

114
00:07:08,060 --> 00:07:13,100
تعملون على نفس المشروع وغرفكم قريبة
.من بعضها في المسكن

115
00:07:13,100 --> 00:07:14,660
.أنتم بمثابة فريق

116
00:07:15,280 --> 00:07:18,680
،بالطبع، فيشترط ألا يزعج هذا أيّ شخص آخر

117
00:07:18,680 --> 00:07:21,140
.لكن عليكم أنتم الأربعة مناقشة هذا الأمر واتخاذ قرار

118
00:07:22,050 --> 00:07:23,470
...نحن الأربعة

119
00:07:23,470 --> 00:07:24,380
.نقرّر...

120
00:07:25,030 --> 00:07:28,090
.أنا لا أمانع. لا يزعجني الأمر

121
00:07:28,600 --> 00:07:31,300
هل كانيي-سان شرّير؟

122
00:07:31,550 --> 00:07:34,240
.اسمه ليس كانيي-سان وإنما كامي-سان

123
00:07:34,240 --> 00:07:35,510
.وهو ليس شريرًا

124
00:07:35,980 --> 00:07:38,060
.سأسمح بوجوده إذًا

125
00:07:38,660 --> 00:07:39,730
.أنا أيضًا

126
00:07:40,390 --> 00:07:42,380
.حسم الأمر إذًا

127
00:07:42,380 --> 00:07:43,840
هل أنت واثقة؟

128
00:07:43,840 --> 00:07:44,920
.بالطبع

129
00:07:44,920 --> 00:07:49,240
احرصوا على إخبار الفتيات الأخريات في المسكن
.اللواتي سينتقلن لاحقًا

130
00:07:49,240 --> 00:07:50,070
فهمتم؟

131
00:07:50,070 --> 00:07:53,070
.أجل! شكرًا لك

132
00:07:54,160 --> 00:07:56,530
.شكرًا لكم جميعًا

133
00:07:57,140 --> 00:07:58,120
أليس هذا رائعًا؟

134
00:07:58,430 --> 00:07:59,440
.تسوروتا-سان

135
00:07:59,440 --> 00:08:01,080
!اسمه كامي-سان

136
00:08:10,210 --> 00:08:10,800
هيغوروما تسوباكي

137
00:08:13,890 --> 00:08:16,050
ما رأيك يا كامي-سان؟

138
00:08:19,040 --> 00:08:20,020
نعم؟

139
00:08:21,400 --> 00:08:22,780
مايكا-تشان؟

140
00:08:22,780 --> 00:08:24,350
هل يمكنني الدخول؟

141
00:08:24,780 --> 00:08:26,990
.لم أستطع النوم

142
00:08:26,990 --> 00:08:29,320
.غدًا يوم التسجيل

143
00:08:29,740 --> 00:08:32,910
.سنكون هناك رفقة جميع مؤديي الأصوات المشهورين

144
00:08:32,910 --> 00:08:37,450
مجرد التفكير في طريقة التعريف عن نفسي
...يجعلني أشعر بالتوتّر

145
00:08:37,450 --> 00:08:39,160
ماذا عن شيهو-تشان وهونوكا-تشان؟

146
00:08:39,160 --> 00:08:40,800
.نامتا سلفًا

147
00:08:40,800 --> 00:08:42,370
.لا بدّ أنه شعور جميل ألا تكترثي

148
00:08:44,830 --> 00:08:46,560
تتدربين من أجل الغد؟

149
00:08:46,560 --> 00:08:47,790
.أجل

150
00:08:47,790 --> 00:08:53,800
.لا أملك أيّ أجزاء مسماة لكني سأبذل جهدي

151
00:08:53,800 --> 00:08:56,090
.كنت تطلبين النصح من كامي-سان إذًا

152
00:08:56,350 --> 00:08:57,120
.أجل

153
00:08:57,120 --> 00:08:59,560
.جعلته يستمع لمختلف الأمور

154
00:09:00,380 --> 00:09:02,770
.هارونا، هل تريدين التدرّب رفقة بعض

155
00:09:03,060 --> 00:09:05,310
ماذا؟ هل أنت واثقة يا مايكا-تشان؟

156
00:09:05,310 --> 00:09:08,460
.بالطبع. لا أعتقد أنني سأنام عما قريب على أيّ حال

157
00:09:20,030 --> 00:09:24,200
الطالبة أ

158
00:09:20,200 --> 00:09:21,850
.أراك لاحقًا يا تسوباكي

159
00:09:22,340 --> 00:09:25,780
.أنا واثقة أنك ستكونين بخير هناك

160
00:09:29,270 --> 00:09:33,880
.أتساءل حيال مشاعر تسوباكي في هذا المشهد

161
00:09:33,880 --> 00:09:35,770
.أجل، أنا أيضًا

162
00:09:39,230 --> 00:09:42,010
.تعجبني ملامح وجهها

163
00:09:42,510 --> 00:09:45,510
ما هي أفضل طريقة لإظهار مشاعرها هنا؟

164
00:09:47,560 --> 00:09:48,970
.بالطبع

165
00:09:48,970 --> 00:09:52,190
.بعد كل شيء، أنا هي أنا

166
00:09:53,410 --> 00:09:55,210
!كان ذلك جيدًا حقًا

167
00:09:55,210 --> 00:09:56,990
أتعتقدين ذلك؟ هل كان مناسبًا؟

168
00:09:56,990 --> 00:10:02,220
.لست واثقة، لكني أحببت تسوباكي الحالية

169
00:10:02,220 --> 00:10:03,340
حقًا؟

170
00:10:03,340 --> 00:10:04,460
!أجل

171
00:10:04,460 --> 00:10:06,400
.أشعر بالغيرة

172
00:10:06,400 --> 00:10:09,500
.ليتهم أروا وجه الطالبة أ أيضًا

173
00:10:09,870 --> 00:10:14,410
هذا يجعلك تعتقدين أنها شخص تستطيع جعل
.تعابير وجه تسوباكي هكذا

174
00:10:14,410 --> 00:10:15,500
.صحيح

175
00:10:16,020 --> 00:10:17,770
هل يمكننا التدرّب مجددًا؟

176
00:10:17,770 --> 00:10:18,870
!بالطبع

177
00:10:23,580 --> 00:10:25,430
.شكرًا لك

178
00:10:25,800 --> 00:10:27,180
.تذكروا هذا

179
00:10:27,180 --> 00:10:29,770
.هذا هو شعور أول يوم تسجيل

180
00:10:31,650 --> 00:10:33,300
.صباح الخير

181
00:10:34,010 --> 00:10:35,690
!صباح الخير

182
00:10:36,710 --> 00:10:37,660
.مرحبًا

183
00:10:40,680 --> 00:10:42,270
من كان ذلك؟

184
00:10:42,270 --> 00:10:44,410
.كانت تلك المانغاكا والمحررة خاصتها

185
00:10:45,800 --> 00:10:48,640
.حسنًا أنتم الأربعة، اذهبوا للتعريف عن أنفسكم

186
00:10:48,640 --> 00:10:49,580
!حسنًا

187
00:10:50,090 --> 00:10:54,480
عرفوا عن أنفسكم عن طريق ذكر اسمكم ودوركم أولًا، مفهوم؟

188
00:10:54,480 --> 00:10:55,550
.حسنًا

189
00:10:57,510 --> 00:10:59,760
.عفوًا. وصل أعضاء إيربلو

190
00:11:00,090 --> 00:11:01,050
.تفضلوا

191
00:11:03,590 --> 00:11:06,720
.أدعى تاكاتوري مايكا. أؤدي صوت هيغوروما تسوباكي

192
00:11:06,720 --> 00:11:08,180
.شكرًا على استضافتي

193
00:11:08,180 --> 00:11:09,560
.يسرنا تواجدك

194
00:11:09,560 --> 00:11:11,140
.أجل، أهلًا وسهلًا

195
00:11:11,420 --> 00:11:14,180
.أدعى كانو شيهو. أؤدي صوت ريندو أماغي

196
00:11:14,630 --> 00:11:16,230
.شكرًا على استضافتي

197
00:11:16,620 --> 00:11:20,030
.أدعى تسوكي هونوكا. أؤدي صوت شوبو أيامي

198
00:11:20,030 --> 00:11:21,700
.شكرًا على استضافتي

199
00:11:24,210 --> 00:11:28,700
.أدعى موتسويشي هارونا

200
00:11:29,200 --> 00:11:30,620
.شكرًا على استضافتي

201
00:11:33,830 --> 00:11:35,850
.أدعى إيسوزو، مديرة أعمالهم

202
00:11:35,850 --> 00:11:37,030
.أهلًا وسهلًا

203
00:11:37,840 --> 00:11:40,670
...لدينا ثلاث فتيات هنا للمراقبة أيضًا

204
00:11:41,080 --> 00:11:42,560
.أُعلمنا بذلك

