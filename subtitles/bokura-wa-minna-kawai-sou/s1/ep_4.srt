1
00:00:14,720 --> 00:00:15,690
! (( سينباي ))

2
00:00:18,100 --> 00:00:19,460
هل أنتِ متوجّهةٌ إلى الـ منزل ؟

3
00:00:19,760 --> 00:00:20,530
نـعـم

4
00:00:20,850 --> 00:00:22,190
! يا للـ صُدفة

5
00:00:21,850 --> 00:00:24,890
يكذب

6
00:00:22,190 --> 00:00:24,610
غادرتُ مُتأخراً لأنني كنتُ في
. واجبٍ يوميّ من أجل الـ صف

7
00:00:25,140 --> 00:00:26,400
... لقد فهمت

8
00:00:26,650 --> 00:00:27,900
... يكذب

9
00:00:41,490 --> 00:00:43,540
هل قمتَ بـ ثقبِ عجلةٍ في دراجتك ؟

10
00:00:43,930 --> 00:00:47,080
هل هذه طريقةٌ غيرُ مباشرة لـ إخباري
بـ أن تسبقني ؟

11
00:00:47,490 --> 00:00:49,830
! لكنني أرفض بـ أن آخذ الـ تلميح

12
00:00:50,080 --> 00:00:52,390
(( الـ طريق ليس بـ بعيد إلى مجمع (( كاواي

13
00:00:52,390 --> 00:00:54,270
لذا ظننتُ بـ إنّه يمكنني أن أسير

14
00:00:54,820 --> 00:00:57,000
كما الـ منظرُ من الـ جسر جميل

15
00:00:57,990 --> 00:01:01,730
، نحن نعيشُ في الـ مبنى ذاته
. لذا ليس عليكِ أن تكوني بـ هذا الـ برود

16
00:01:02,030 --> 00:01:03,400
... فكرةٌ فـحسب

17
00:01:08,510 --> 00:01:10,560
!  لقد قامتْ بـ غلق كتابِها بالـ فعل

18
00:01:11,030 --> 00:01:14,570
و لست متأكداً كيف سـ أفكّرُ بـ نفسي
... لـ كوني سعيداً بـ شأن هذا

19
00:01:14,570 --> 00:01:16,930
ريت - تشان )) تتصرّفُ و كـ إنّها ))
، لا تهتمّ إن كانتْ وحيدة

20
00:01:16,930 --> 00:01:19,320
. لكنني أظنّ بـ أنّها وحيدةٌ بالـ فعل

21
00:01:19,550 --> 00:01:22,330
لذا أرجوك كن هناك من أجلِها

22
00:01:22,330 --> 00:01:25,080
. إنّها مُنفتحةٌ لكَ كثيراً

23
00:01:25,420 --> 00:01:27,880
أعلمُ بـ أنّكَ قادرٌ على فعلها

24
00:01:27,880 --> 00:01:29,580
... قادرٌ على فعلها ... قادرٌ على فعلها ...

25
00:01:30,500 --> 00:01:32,390
هل (( ساياكا - سان )) محقة ؟

26
00:01:32,390 --> 00:01:34,090
هل أستطيعُ فعلَ هذا ؟

27
00:01:34,970 --> 00:01:37,870
! ربّما يجبُ عليّ أن أكون أكثر نشاطاً

28
00:03:15,730 --> 00:03:16,770
(( سوميكو - سان ))

29
00:03:17,360 --> 00:03:18,530
ما هذه ؟

30
00:03:18,830 --> 00:03:20,650
. هذه كانت هديّة من صديق

31
00:03:20,650 --> 00:03:22,030
هل يرغب الـ جميع بالـ بعض منها ؟

32
00:03:22,450 --> 00:03:23,720
! نعم

33
00:03:23,720 --> 00:03:26,460
. أوه ، طلاّب الـ مدرسة الـ ثانويّة سـ يحصلون على الـ عصير

34
00:03:26,460 --> 00:03:27,450
بالـ طبع

35
00:03:27,760 --> 00:03:31,200
، أوه ، أنا أقدّر لكِ عرضكِ
. لكن عليّ أن أتغاضى عن هذا ، آسفة

36
00:03:30,450 --> 00:03:31,160
آسفة

37
00:03:32,460 --> 00:03:34,580
!أ هي حقّاً صدمة كبيرة إلى هذا الـ حد  ؟

38
00:03:35,250 --> 00:03:38,050
هل تخرُجينَ بـ رفقة وغدٍ جديد ؟

39
00:03:38,050 --> 00:03:40,460
لِمَ تفترضين بـ إنّه سـ يكون
وغداً ؟

40
00:03:38,460 --> 00:03:40,420
وغد

41
00:03:41,160 --> 00:03:43,860
، لقد شربتُ و أكلتُ كثيراً

42
00:03:43,860 --> 00:03:45,590
. لذا أنا أحاولُ أن أُسيطر على نفسي

43
00:03:45,590 --> 00:03:46,970
. إنّه سيء لـ بَشَرَتي

44
00:03:47,270 --> 00:03:50,650
بعد الـ تفكير بالـ أمر ، أنتِ لم
. تأكلي كثيراً مؤخراً

45
00:03:50,650 --> 00:03:53,980
لقد إعتدتي على ملئ أمعائك
كـ الأطفال في الـ حكايات الـ شعبيّة

46
00:03:53,980 --> 00:03:57,560
!ماذا ؟

47
00:03:55,180 --> 00:03:58,460
لكنّ بطنكِ ناعمةٌ جدّاً
! و إسفنجيّة حاليّاً

48
00:03:57,730 --> 00:04:01,990
بطنك

49
00:03:58,460 --> 00:04:01,080
! ليس من الـ مفترض أن تكون بطني إسفنجيّة

50
00:04:01,080 --> 00:04:03,530
هذا يتركُ لي صدركِ فقط
. لـ أقوم بـ عصره

51
00:04:01,990 --> 00:04:06,990
صدر

52
00:04:03,530 --> 00:04:06,530
!لِمَ تقومين بـ عصرِ كلّ شيء على جسدي ؟

53
00:04:07,570 --> 00:04:08,990
أ هو الـ حبيبُ الـ سابق مجدّداً ؟

54
00:04:10,220 --> 00:04:12,250
. لا ، إنّها صديقة

55
00:04:13,520 --> 00:04:14,740
مرحباً ؟

56
00:04:15,520 --> 00:04:17,060
. نعم ، أستطيعُ أن أتكلّم

57
00:04:17,060 --> 00:04:18,750
إنّه بـ شأن الـ أسبوع الـ قادم ، صحيح ؟

58
00:04:19,100 --> 00:04:19,930
هاه ؟

59
00:04:21,270 --> 00:04:23,030
... لقد فهمتْ

60
00:04:23,960 --> 00:04:25,320
. لا أعلمُ ماذا أقول

61
00:04:25,770 --> 00:04:27,380
هل أنت بخير ؟

62
00:04:28,240 --> 00:04:29,170
. حسناً

63
00:04:29,470 --> 00:04:31,260
. عليك أن تحظي بـ بعض الراحة ، إذن

64
00:04:32,270 --> 00:04:34,560
. نعم ، أتحدّث إليكِ لاحقاً

65
00:04:35,720 --> 00:04:37,280
هذا جيّد

66
00:04:37,610 --> 00:04:39,060
بلع

67
00:04:38,110 --> 00:04:40,650
... آآه

68
00:04:40,730 --> 00:04:40,940
ضربة عنيفة

69
00:04:41,680 --> 00:04:43,490
ما الـ خطب ، (( مايومي - تشان )) ؟

70
00:04:43,440 --> 00:04:45,450
... شكراً لك

71
00:04:43,490 --> 00:04:47,000
صديقتي الّتي كانت تخرج بـ رفقة
، ذلك الـ فتى من الـ طبقة الـ راقية قالتْ

72
00:04:45,360 --> 00:04:46,450
رجفة                              رجفة

73
00:04:47,000 --> 00:04:49,910
! " سـ أخطط لـ موعد ثنائي مع صديق صديقي"

74
00:04:49,450 --> 00:04:53,240
رجفة                              رجفة

75
00:04:49,910 --> 00:04:53,170
، بـ صوت غامض و متعالي , و بعدها قالت

76
00:04:53,170 --> 00:04:55,790
! " عليكِ أن تخسري بعض الـ وزن ، هيهيهي "

77
00:04:55,000 --> 00:04:55,960
ضحكة عالية الصوت

78
00:04:55,790 --> 00:04:58,500
... و كأنّها كانتْ تعطيني نصيحة

79
00:04:55,960 --> 00:04:58,460
رجفة                               رجفة

80
00:04:58,990 --> 00:05:00,760
. تبدو و كـ أنّها صديقة جيّدة

81
00:05:00,760 --> 00:05:04,260
لكنّها أخبرتني للتو بـ أنّها قد
. إنفصلتْ عن حبيبها ، لذا فـ إنّ الـموعد الـ مزدوج قد أُلغي

82
00:05:02,210 --> 00:05:04,220
الـ موعد الـ ثنائي قد أُلغي

83
00:05:04,760 --> 00:05:07,710
هل يجبُ عليّ أن أكون مُحبطة ؟
هل يجبُ عليّ أن أشعر بالـ سوء لـ أجلها ؟

84
00:05:07,710 --> 00:05:09,200
هل يجبُ عليّ أن أكونَ سعيدة ؟

85
00:05:09,200 --> 00:05:11,310
، إذا قمتُ بـ عمل الـ إتصال الـ خاطئ
. فـ سأكونُ أنا هو الـ شخص المُريع

86
00:05:11,310 --> 00:05:14,270
حقيقةُ بـ إنكِّ ممزّقة بين هذه
. الإختيارات تجعلُ منك شخصاً سيئاً بالـ فعل

87
00:05:14,270 --> 00:05:17,230
و أستطيعُ أن أرى " مُحبطة " و
سعيدة " فقط على وجهك "

88
00:05:14,480 --> 00:05:17,190
مُحبطة

89
00:05:15,020 --> 00:05:17,190
سعيدة

90
00:05:17,720 --> 00:05:20,550
لا أريدُ أن أكونَ الـ مرأة التي
! تكون سعيدة لـ رؤية صديقتها تعاني

91
00:05:20,550 --> 00:05:22,000
! لا بأس إذا كان غريباً

92
00:05:22,000 --> 00:05:22,870
! لا ، ليس كذلك

93
00:05:22,870 --> 00:05:26,860
مايومي - تشان )) ، أنتِ لم تحبّي تلكَ ))
الـ صديقة من الـ بداية ، صحيح ؟

94
00:05:26,860 --> 00:05:27,700
إيماءة

95
00:05:26,860 --> 00:05:27,800
. آه ... هاه

96
00:05:28,110 --> 00:05:30,580
إذن هي غريبةٌ بالـ أصل ، صحيح ؟

97
00:05:30,120 --> 00:05:31,580
غريبة

98
00:05:32,140 --> 00:05:35,990
أدركتُ بـ إنّه لا سبب لي لـ أقومَ
(( بـ ضربِ (( شيرو

99
00:05:34,370 --> 00:05:39,080
... شكراً لكِ
... واحدةٌ أُخرى

100
00:05:35,990 --> 00:05:38,140
(( ما الـمشكلة ؟ إنّه فقط (( شيرو - سان

101
00:05:35,990 --> 00:05:38,310
... واحدةٌ أُخرى

102
00:05:38,140 --> 00:05:39,130
صحيح

103
00:05:41,490 --> 00:05:44,250
... حسناً ، تعلمون

104
00:05:44,520 --> 00:05:47,760
. تستطيعُ الـ فتاة أن تمتلك الـ عديد من الـ أصدقاء

105
00:05:48,150 --> 00:05:51,070
. تستطيعُ أن تقتربَ حقّاً من الـ بعض

106
00:05:51,800 --> 00:05:53,940
مع الآخرين ، عليك أن تتعامل مع الـ عادات

107
00:05:54,490 --> 00:05:56,610
. و كلّ تلك الـ قواعد الـ غريبة

108
00:05:56,610 --> 00:05:57,730
يا لهُ من إزعـاج

109
00:05:58,080 --> 00:05:59,500
! أعلمُ ما تقصدين

110
00:05:59,500 --> 00:06:00,780
صحيح ، (( ريت - تشان )) ؟

111
00:06:01,620 --> 00:06:04,500
تريدين منّي أن أتّفقَ مع
رأي مُنحازٍ كـ هذا ؟

112
00:06:04,800 --> 00:06:06,880
! أنا أتفقُ معك

113
00:06:06,880 --> 00:06:09,350
لا أحتاجُ إلى إمرأة تقوم
بـإخراج مَرَحِها خارجاً

114
00:06:06,990 --> 00:06:11,570
شوو

115
00:06:09,350 --> 00:06:12,050
صنعُ الـ أعداء و كسرُ الـ قواعد
. لـ تتفق معي

116
00:06:11,700 --> 00:06:12,910
بوووو

117
00:06:12,780 --> 00:06:14,510
. أنا الـ وحيدة الـتي تقومُ بـ تجاهل الـ قواعد

118
00:06:14,510 --> 00:06:17,690
. ريت - تشان )) لا تقومُ بـ صنع أيّ صداقات ))

119
00:06:17,690 --> 00:06:19,000
! (( إنتظري ! (( ساياكا - سان

120
00:06:19,240 --> 00:06:21,520
... أنا لم أخترْ بـ أن أكونَ بـ مُفردي

121
00:06:23,500 --> 00:06:27,170
هذا صحيح ! كونك سكرانة لا يعني
! إنّك قادرةٌ على قول ما تشائين

122
00:06:30,260 --> 00:06:32,740
، عندما دخلتُ الـ مدرسة الـ ثانويّة للـ مرّة الـ أولى

123
00:06:32,740 --> 00:06:35,210
لم يكُن هناك أيّ شخص مِنَ
. الـ مدرسة الـ متوسّطة في صفّي

124
00:06:35,890 --> 00:06:39,450
لم يكُن هناك أشخاصٌ من
. مدرستي الـ متوسّطة على الـ إطلاق

125
00:06:39,750 --> 00:06:41,780
. و كانوا جميعهم أولاداً

126
00:06:42,590 --> 00:06:45,360
لم أجد الـ فرصة الـ مناسبة
، لـ أتكلّم مع أيّ شخص

127
00:06:45,360 --> 00:06:46,950
. لذا و قبل أن أدركَ هذا ، كنتُ وحيدة

128
00:06:47,890 --> 00:06:50,500
، لقد كان أقلّ إجهاداً
. لذا قمتُ بـ تقبّله فحسب

129
00:06:50,500 --> 00:06:53,200
. لقد بدا بالـ تأكيد و كأنّك إخترتِ أن تكوني وحيدة

130
00:06:53,160 --> 00:06:54,660
عصر

131
00:06:53,200 --> 00:06:54,390
! هيـــا

132
00:06:54,700 --> 00:06:57,930
! ما زال لديك أنا

133
00:06:57,930 --> 00:07:01,580
! لم أطلب صديقاً يسعى خلفَ جسدي

134
00:07:01,580 --> 00:07:04,180
. حسناً ، علينا أن نقوم بـ تغليف هذه

135
00:07:04,180 --> 00:07:06,550
. إنّهم سُكارى على ايّ حال

136
00:07:05,550 --> 00:07:06,800
! وااااه

137
00:07:06,050 --> 00:07:07,300
! كيااااااااه

138
00:07:06,550 --> 00:07:09,670
! لن أكون قادرة أبداً على الـ إنسجام معك

139
00:07:16,610 --> 00:07:17,970
... أقلّ إجهاداً

140
00:07:19,060 --> 00:07:21,180
. أستطيعُ أن أقول بـ إنّها تحاولُ بـ جهد

141
00:07:22,330 --> 00:07:24,250
هل يبدو لك الأمر هكذا ؟

142
00:07:24,930 --> 00:07:27,230
. حسناً ، أعتقدُ بـ إنّها لا بدّ أن تكون وحيدة

143
00:07:27,790 --> 00:07:29,210
هل أنتَ متأكّد ؟

144
00:07:29,580 --> 00:07:31,130
على فتيات الـ ثانويّة أن يقُمن بـ مواكبة

145
00:07:31,130 --> 00:07:33,840
. الـ موديل الـ شائع إذا أردنَ أن ينسجمن

146
00:07:33,840 --> 00:07:35,280
، لابدّ أن يكون صعباً

147
00:07:36,540 --> 00:07:37,500
... الـ موديل الـ شائع

148
00:07:37,970 --> 00:07:38,920
... هذا يذكّرني

149
00:07:39,520 --> 00:07:42,120
... لكن أعتقدُ بـإنّه لا صلة له

150
00:07:42,330 --> 00:07:44,580
ماذا ؟

151
00:07:42,690 --> 00:07:44,620
. ماذا ؟ أخبرني

152
00:07:47,350 --> 00:07:51,560
تتذكّرُ كيف كانتْ الـ جواربُ الـ مُرتخية
هي الـ موضة الـ رائجة سابقاً ؟

153
00:07:51,560 --> 00:07:52,150
نعم

154
00:07:52,470 --> 00:07:56,970
تململ

155
00:07:52,770 --> 00:07:57,990
بـ إتّباعُ فكرة الـ " مُرتخية " ، أعتقدُ
. بـ إنّ الـ موضة الـ قادمة يجبُ أن تكون الـ سراويل الـ مُرتخية

156
00:07:57,990 --> 00:08:00,310
. يا إلهي ، أنتَ تنزلقُ إلى الـ أسفل مجدداً

157
00:08:00,310 --> 00:08:03,380
سيكون عليهنّ أن يمسكنَ سراويلهنّ
. من خلال تنانيرهنّ

158
00:08:03,270 --> 00:08:06,400
تململ

159
00:08:03,380 --> 00:08:05,100
. بالـ تأكيد لا صلة له

160
00:08:05,100 --> 00:08:06,400
إذهب إلى الـ نوم حالاً

161
00:08:12,930 --> 00:08:14,260
... غير مُجهد

162
00:08:15,860 --> 00:08:17,840
. أنا واثقٌ من أنّها تحاولُ جاهدة

163
00:08:19,000 --> 00:08:19,920
لا بدّ من أن تكون كذلك

164
00:08:20,870 --> 00:08:24,620
إصدارٌ جديد

165
00:08:21,290 --> 00:08:23,650
بالـ رغم من إنّه
. لا يبدو كذلك بالـ تأكيد

166
00:08:25,150 --> 00:08:26,850
إنّها حقّا تقومُ بـ إسعاد نفسها

167
00:08:27,450 --> 00:08:28,230
... لكن

168
00:08:29,170 --> 00:08:32,060
بعد أن كانتْ تضحكُ و
، تحمرّ خجلاً كالـ سابق

169
00:08:33,010 --> 00:08:36,050
سينباي )) لا تزالُ تقضي كلّ وقتها بالـ قراءة ))

170
00:08:37,930 --> 00:08:40,060
في غُرفة الـ جلوس

171
00:08:43,810 --> 00:08:44,680
! (( سينباي ))

172
00:08:45,000 --> 00:08:46,690
! يا لها من صُدفة ، مجدّداً

173
00:08:48,130 --> 00:08:49,790
أنا ذاهب إلى الـ مدرسةِ سيراً

174
00:08:51,190 --> 00:08:53,350
! لن أقوم بـ فهم الـ تلميح ، لن أقوم بـ فهم الـ تلميح

175
00:08:55,580 --> 00:08:57,380
... (( إممم ، (( يوسا - كن

176
