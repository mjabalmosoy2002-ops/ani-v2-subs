1
00:00:01,060 --> 00:00:06,230
الحلقة 7 [اللّيلة السّابقة]

2
00:00:16,520 --> 00:00:17,660
!مستحيل

3
00:00:17,660 --> 00:00:18,950
حصن جوّيّ؟

4
00:00:18,950 --> 00:00:21,910
نعم! أمر لا يُصدّق، صحيح؟

5
00:00:21,910 --> 00:00:24,750
!كيف تحلّق مركبة طائرة خفيّة عملاقة مثلها؟

6
00:00:25,410 --> 00:00:29,250
."أعتقد أنّها تُدعى "دومينيس ميني-شيء ما

7
00:00:29,250 --> 00:00:31,420
.دوميناس ليمينيس

8
00:00:31,420 --> 00:00:37,180
طبّق الإيلوميناتي بحوثًا علميّة على قوى
...شيطانيّة... القوّة السّحريّة متقدّمة فعلاً

9
00:00:37,180 --> 00:00:41,640
وسمعتُ أنّ الإكسير وبوّابة جهنّم الاصطناعيّة
...وحتّى دومينيس أو مهما كانت هذه

10
00:00:41,640 --> 00:00:44,980
.هي من ثمار جهودهم العلميّة

11
00:00:46,720 --> 00:00:48,730
!شيما! مِن هنا

12
00:00:48,930 --> 00:00:50,410
!مرحبًا

13
00:00:55,150 --> 00:00:59,410
.أوّلاً، دعني أثني عليك
.القائد مسرور بإنجازك أيضًا

14
00:00:59,410 --> 00:01:03,750
،لا، لا. لم أفعل شيئًا! بصراحة
—لقد دمّر نفسه بنفسه، لذا

15
00:01:04,110 --> 00:01:06,620
!كلاّ! أعتذر

16
00:01:07,120 --> 00:01:09,130
إذًا فأنت هو أوكومورا يوكيو؟

17
00:01:10,040 --> 00:01:12,130
.أنا تودو هوماري

18
00:01:12,290 --> 00:01:14,300
.أحمل رتبة معلّم عظيم

19
00:01:14,300 --> 00:01:19,640
،أنا قائدة الفوسفوروس، أو النّجمة الذّهبيّة
.وهي وحدة حراسة القائد لوسيفر، ملك النّور

20
00:01:19,800 --> 00:01:21,350
تودو؟

21
00:01:23,390 --> 00:01:25,770
.أوّلاً، ستأتي للقاء القائد

22
00:01:25,770 --> 00:01:27,280
.اتبعني

23
00:01:29,890 --> 00:01:32,150
!حسنًا يا سينسي! حظًّا موفّقًا

24
00:01:35,820 --> 00:01:38,320
.أحضرت أوكومورا يوكيو لرؤيتك

25
00:01:38,730 --> 00:01:40,080
.شكرًا لك

26
00:01:40,320 --> 00:01:42,000
.أدخليه رجاءً

27
00:01:42,690 --> 00:01:45,450
.القائد في حالة صحّيّة ضعيفة الآن

28
00:01:45,450 --> 00:01:47,880
.حاول ألاّ تزعجه بأيّ شكل من الأشكال

29
00:01:55,920 --> 00:01:57,840
...أوكومورا يوكيو-كُن

30
00:01:58,000 --> 00:02:01,220
.أعتذر لأنّي جعلتك تراني في وضعي هذا

31
00:02:01,220 --> 00:02:06,100
.ولكن، كنتُ متأكّدًا تمامًا من قدومك لرؤيتي

32
00:02:06,260 --> 00:02:07,980
ما الّذي تريده منّي؟

33
00:02:07,980 --> 00:02:09,820
.قلتَ أنّك أردتني

34
00:02:10,180 --> 00:02:11,860
ما الّذي تخطّط لفعله بي؟

35
00:02:12,600 --> 00:02:14,780
.لن أفعل أيّ شيء لك

36
00:02:14,780 --> 00:02:20,620
كلّ ما أردتُه من أجلك هو القدوم
.كلّ هذا المسافة من تلقاء نفسك

37
00:02:20,900 --> 00:02:26,120
.أنا ممتنّ لك لإحضارك والدي لي

38
00:02:26,860 --> 00:02:31,260
.أنت أملي لقيادة العالم نحو سلام حقيقيّ

39
00:02:31,490 --> 00:02:34,500
.سلام حقيقيّ؟ لا تسئ فهمي

40
00:02:34,790 --> 00:02:38,260
...إنّ خطّتك تلك وهذه المنظّمة
!ناهيك عن ذكرك أنت... مجرّد شرّ مطلق

41
00:02:38,500 --> 00:02:40,600
!هذا المكان وكر للشّرّ بالفعل

42
00:02:43,920 --> 00:02:46,020
.أنا أيضًا شرّ

43
00:02:46,020 --> 00:02:48,520
تخلّيتُ عن كلّ شيء

44
00:02:48,520 --> 00:02:52,230
.لاكتشاف سرّ هذه العين وولادتي ومن أكون

45
00:02:52,230 --> 00:02:55,520
.أخبرتني أيضًا أنّها ستوقظ قوّتي الكامنة

46
00:02:55,810 --> 00:02:57,910
.كلّ ذلك من أجل تلك القوّة

47
00:02:58,230 --> 00:03:00,040
.سأحصل عليها مهما كلّف الأمر

48
00:03:13,000 --> 00:03:18,090
طارد الأرواح الشّرّيرة الأزرق
آرك اللّيلة الزّرقاء

49
00:04:38,420 --> 00:04:41,170
"!كائن معادي للمجتمع؟"

50
00:04:38,660 --> 00:04:41,170
يا إلهي! أرأيت؟ أرأيت ذلك؟

51
00:04:41,330 --> 00:04:43,920
مؤشّر داو جونز الصّناعيّ
...في بورصة نيويورك للأوراق الماليّة

52
00:04:43,920 --> 00:04:45,930
!لا يجب علينا الخضوع للشّياطين

53
00:04:45,930 --> 00:04:48,100
"تأجّلت"

54
00:04:46,130 --> 00:04:47,470
...في العاصمة سانتياغو

55
00:04:47,470 --> 00:04:51,020
غُمرت كنيسة بالنّاس الباحثين
،عن الخلاص بعد رؤيتهم لشياطين

56
00:04:48,100 --> 00:04:50,640
"الكموهم بكتاب مقدّس #كيف_تهزمون_شيطان"
.طهّروا أجسادكم وصلّوا من قلوبكم"
".وبهذا فقط، يمكنكم إبعاد مبعوث الظّلام عنكم

57
00:04:48,100 --> 00:04:50,640
"لا شيء من هذا يبدو موثوقًا به"

58
00:04:51,020 --> 00:04:52,320
!والفوضى تعمّ المكان

59
00:04:52,630 --> 00:04:57,400
...بما أنّ وجود الشّياطين قد كُشف الآن

60
00:04:57,400 --> 00:05:00,480
.سيصير إيماننا الجماعيّ قوّة هائلة

61
00:05:00,480 --> 00:05:03,400
...كلّ شيء في تناغم كامل أخيرًا

62
00:05:03,810 --> 00:05:07,410
وفُتحت عيون البشر بالكامل إذًا؟

63
00:05:10,080 --> 00:05:12,330
!لن أسمح بأن يصير هذا واقعنا

64
00:05:12,570 --> 00:05:14,620
!كفارس عظيم، لن أسمح بذلك

65
00:05:14,620 --> 00:05:17,370
!هيّا بسرعة –
أستجعلوننا ننتظر للأبد؟ –

66
00:05:17,370 --> 00:05:19,750
!سُحقًا، لا فكرة لديّ ما الّذي تقولونه

67
00:05:19,750 --> 00:05:20,960
!تحدّثوا بالدّور

68
00:05:21,120 --> 00:05:23,260
.الجميع في حالة هلع في الفرع

69
00:05:23,260 --> 00:05:24,720
.سأذهب إلى هناك للمساعدة

70
00:05:24,960 --> 00:05:27,940
.اعتني بماموشي من أجلي رجاءً يا سيّدتي

71
00:05:30,090 --> 00:05:32,970
.سأذهب إلى الفرع أيضًا –
ماذا؟ تاتسوما-سان؟ –

72
00:05:33,130 --> 00:05:36,730
.لأنّ كونكومارو اتّصل لإخباري أنّه عائد

73
00:05:38,350 --> 00:05:41,070
.كان عليّ أنا أن أوصله

74
00:05:41,310 --> 00:05:42,780
.آسف يا كونكومارو

75
00:05:42,780 --> 00:05:45,320
لا بأس. أستطيع الوصول
.إلى هناك في الحال بالمفتاح

76
00:05:45,320 --> 00:05:48,960
سأوصل سيف الكوما المكسور
!هذا لكبير الرّهبان بالتّأكيد

77
00:05:51,530 --> 00:05:52,370
...حسنًا

78
00:05:52,570 --> 00:05:54,750
.سأنهي المهمّة الّتي أرسلني معلّمي للقيام بها

79
00:05:55,240 --> 00:05:59,130
سأعود بمجرّد انتهائي، اعتني
بمورياما-سان، موافقة يا كاميكي؟

80
00:06:15,760 --> 00:06:17,570
...مورياما شيمي

81
00:06:17,840 --> 00:06:19,270
ماذا؟

82
00:06:19,510 --> 00:06:21,320
هل أنت مستيقظة؟

83
00:06:21,560 --> 00:06:23,530
.استيقظت للتّوّ

84
00:06:23,930 --> 00:06:25,780
هل الجميع في أمان؟

85
00:06:25,780 --> 00:06:27,280
!كلّ ذلك بفضلك أنت

86
00:06:28,520 --> 00:06:31,870
.ابقي في الفراش
أم هل تريدي أكل شيء ما؟

87
00:06:32,110 --> 00:06:34,330
.شكرًا يا كاميكي-سان

88
00:06:34,570 --> 00:06:36,290
!أنت لطيفة جدًّا معي

89
00:06:37,150 --> 00:06:39,920
لـ-لماذا قد لا أكون لطيف معك؟
...الأمر ليس وكأنّي

90
00:06:42,410 --> 00:06:43,750
ما الّذي حدث؟

91
00:06:44,750 --> 00:06:47,850
رحل يوكي-تشان الآن، صحيح؟

92
00:06:48,960 --> 00:06:50,260
.نعم

93
00:06:50,460 --> 00:06:51,560
ماذا عن رين؟

94
00:06:51,920 --> 00:06:54,600
.لا بدّ أنّ السّيّد فيليس قد حبسه

95
00:06:54,600 --> 00:06:56,810
...فُتحت بوّابة جهنّم الاصطناعيّة

96
00:06:56,810 --> 00:06:59,350
.والعالم بأكمله غارق في الفوضى

97
00:06:59,970 --> 00:07:02,910
.لا فكرة لديّ ما الّذي سيحدث لأوكومورا رين

98
00:07:03,560 --> 00:07:04,980
.فهمت

99
00:07:05,180 --> 00:07:07,990
.في ذلك اليوم، كنتُ واثقة أنّي سأموت

100
00:07:10,350 --> 00:07:13,370
.وحتّى الآن، ما زلت أرتعد كلّما فكّرت في الأمر

101
00:07:13,370 --> 00:07:15,540
.كان شخصًا مختلفًا بالكامل وقتها

102
00:07:16,110 --> 00:07:18,840
...لكن قُبيل فقدانه للوعي

103
00:07:19,070 --> 00:07:20,260
...يا

104
00:07:20,570 --> 00:07:21,800
...رفاق

105
00:07:22,370 --> 00:07:24,000
—حمدًا علـ

106
00:07:24,200 --> 00:07:27,670
...أعتقد أنّه تمكّن من العودة بطريقة ما

107
00:07:27,670 --> 00:07:30,310
.قبل أن نتعرّض للقتل جميعًا

108
00:07:31,960 --> 00:07:33,390
.نوعًا ما

109
00:07:33,390 --> 00:07:36,310
إن فقدنا أوكومورا رين إضافة لفقدان
...أوكومورا-سينسي وشيما رنزو

110
00:07:36,310 --> 00:07:39,270
.فسيكون ذلك كارثيًّا

111
00:07:39,510 --> 00:07:40,570
.نعم

112
00:07:41,180 --> 00:07:43,770
.أنا مسرورة جدًّا بعودة رين

113
00:07:44,350 --> 00:07:45,270
...في تلك اللّحظة

114
00:07:45,600 --> 00:07:48,900
...ظننتُ أنّ رين قد رحل بالفعل

115
00:07:49,100 --> 00:07:50,900
.وأخافني ذلك

116
00:07:52,900 --> 00:07:56,410
إنّك غارقة في حبّ أوكومورا رين بالكامل، صحيح؟

117
00:07:59,780 --> 00:08:02,920
أنا؟

118
00:08:06,410 --> 00:08:08,420
غارقة في حبّ رين؟

119
00:08:18,050 --> 00:08:19,400
...أنا أحبّ

120
00:08:20,220 --> 00:08:21,430
رين؟

121
00:08:32,110 --> 00:08:37,370
مهلاً! أيمكنك أن تكوني أقوى من هذا؟
!عرفتُ ذلك لوقت طويل

122
00:08:38,320 --> 00:08:40,120
.أنت غبيّة حقيقيّة

123
00:08:40,440 --> 00:08:41,540
!نعم

124
00:08:41,540 --> 00:08:42,870
...أنا

125
00:08:42,870 --> 00:08:44,300
!غبيّة

126
00:08:44,700 --> 00:08:47,800
!أنا متأخّرة عن الجميع ببضعة خطوات دائمًا

127
00:08:48,290 --> 00:08:52,630
!مع أنّي أدركتُ الأمر أخيرًا، لكن فات الأوان

128
00:08:53,460 --> 00:08:56,640
ماذا تقصدين؟ فات الأوان على ماذا؟

129
00:08:57,750 --> 00:08:59,510
!ما عدت أستطيع تحمّل الأمر

130
00:08:59,510 --> 00:09:02,270
!من أنت؟ أخبريني

131
00:09:02,270 --> 00:09:04,060
...هل نحن صد

132
00:09:04,550 --> 00:09:05,360
...صد

133
00:09:05,590 --> 00:09:06,810
—صد... صديـ

134
00:09:13,240 --> 00:09:16,620
،أنا عضو من غريغوري سيديس
.الوكالة الرّئيسيّة من مقرّ الفاتيكان

135
00:09:17,060 --> 00:09:19,780
.أتيتُ لأخذ مورياما شيمي-ساما

136
00:09:19,780 --> 00:09:20,530
ماذا؟

137
00:09:20,780 --> 00:09:21,920
.المعذرة

138
00:09:23,160 --> 00:09:24,750
...ما-ما الّذي

139
00:09:24,750 --> 00:09:28,040
.شيمي-ساما، تعالي إلى الفاتيكان في الحال

140
00:09:30,700 --> 00:09:31,760
.حسنًا

141
00:09:33,010 --> 00:09:35,050
مهلاً! من تكونون يا هؤلاء؟

142
00:09:35,050 --> 00:09:36,880
إلى أين تأخذونها؟

143
00:09:36,880 --> 00:09:38,050
...كاميكي-سان

144
00:09:39,250 --> 00:09:41,980
.لقد كنت لطيفة جدًّا معي حتّى الآن

145
00:09:42,760 --> 00:09:44,310
!شكرًا لك

146
00:09:45,130 --> 00:09:48,310
!أخبري البقيّة أنّي شاكرة لهم أيضًا

147
00:09:48,510 --> 00:09:49,990
ماذا؟

148
00:09:50,600 --> 00:09:52,070
!مهلاً! انتظري

149
00:09:52,310 --> 00:09:53,870
!عودي

150
00:09:57,150 --> 00:09:58,410
ماذا...؟

151
00:09:58,770 --> 00:10:00,570
ما الّذي يحدث هنا؟

152
00:10:07,820 --> 00:10:09,330
.شيمي-سان

153
00:10:09,660 --> 00:10:12,180
.صرتِ غاية في الجمال بالفعل

154
00:10:12,410 --> 00:10:14,090
.لم أتعرّف عليك إطلاقًا

155
00:10:14,330 --> 00:10:15,430
...عفوًا

156
00:10:15,710 --> 00:10:17,140
من أنت؟

157
00:10:17,370 --> 00:10:19,340
.أنا أعتذر

158
00:10:19,340 --> 00:10:22,310
لم تستعيدي ذكرياتك بعد، صحيح؟

159
00:10:23,460 --> 00:10:26,100
.ولكن لا داعي للعجلة على الإطلاق

160
00:10:26,100 --> 00:10:28,860
.تعالي، والدتك بانتظارك

161
00:10:33,680 --> 00:10:36,280
أعيدوا بناء القوّات بمروّضين
.ذوي سمات روحيّة

162
00:10:36,440 --> 00:10:38,320
!سننشر القوّات ثانية بعد 30 دقيقة

163
00:10:38,320 --> 00:10:39,070
!حاضر

164
00:10:39,810 --> 00:10:40,910
!أيّها الفارس المقدّس

165
00:10:40,910 --> 00:10:42,040
...أنت

166
00:10:42,270 --> 00:10:43,950
...أنت تلميذ لايتنينغ

167
00:10:43,950 --> 00:10:46,910
.أنا سوغورو ريوجي
.آسف على إزعاجك بينما أنت مشغول

168
00:10:47,240 --> 00:10:48,410
.تفضّل هذا

169
00:10:48,410 --> 00:10:50,330
!إنّه دليل على أنّ لايتنينغ محقّ

170
00:10:53,790 --> 00:10:56,050
.اشرح الأمر لي عندما أعود

171
00:11:02,540 --> 00:11:04,100
كاميكي؟ ما الخطب؟

172
00:11:04,100 --> 00:11:07,060
اسمع، لديك مفتاح الذّهاب
إلى مقرّ الفاتيكان، صحيح؟

173
00:11:07,060 --> 00:11:08,730
!تعال لأخذي

174
00:11:08,730 --> 00:11:09,480
ماذا؟

175
00:11:09,480 --> 00:11:11,350
!سأذهب إلى الفاتيكان أيضًا

176
00:11:11,350 --> 00:11:11,980
ماذا؟

177
00:11:11,980 --> 00:11:12,980
!لقد أخذوها

178
00:11:13,390 --> 00:11:16,980
أخذ بعض الأشخاص من الفاتيكان
!مورياما شيمي بعيدًا

179
00:11:16,980 --> 00:11:18,280
ماذا تقولين؟

180
00:11:18,280 --> 00:11:20,990
."وصفوا أنفسهم بـ"غريغوري سيديس
...لا تظنّ أنّ ذلك يعني

181
00:11:21,400 --> 00:11:24,000
أنّ لها علاقة ما بالغريغوري، صحيح؟

182
00:11:29,070 --> 00:11:31,250
...مرحبًا بعودتك

183
00:11:31,250 --> 00:11:33,790
!يا شيمي-ساما

184
00:11:34,330 --> 00:11:37,260
!مـ-مرحبًا

185
00:11:39,120 --> 00:11:40,560
ماذا يجب أن أفعل؟

186
00:11:41,120 --> 00:11:42,880
...هذا مخيف أكثر

187
00:11:43,540 --> 00:11:45,190
!ممّا توقّعت

188
00:11:48,840 --> 00:11:54,150
من ظنّ أنّ النّباتات شبه الاستوائيّة والجبليّة
يمكن أن تنمو بشكل بريّ في نفس المكان؟

189
00:11:54,150 --> 00:11:55,690
هل يفاجئك ذلك؟

190
00:11:55,930 --> 00:11:57,940
...هذا هو العالم المقدّس

191
00:11:57,940 --> 00:12:01,950
،حيث يُقدّس الشّكل المتبلور لشيميهازا
.إمبراطورة الخلق وإحدى الغريغوري

192
00:12:02,230 --> 00:12:07,990
تمنح بلّورات شيميهازا أنظمة
.بيئيّة متنوّعة للأراضي المحيطة

193
00:12:08,570 --> 00:12:15,000
،واليوم، تُعرف بـ"إل"، ولكن في قديم الزّمان
..."سُمّيت "عدن" و"أفالون" و"توغنكيو

194
00:12:15,200 --> 00:12:21,260
"وفي اليابان، "تاكاماغاهارا
."حسب ظنّي، أو "أماهارا

195
00:12:21,960 --> 00:12:23,840
أماهارا؟

196
00:12:24,750 --> 00:12:27,390
هل سمعتِ عن حديقة أماهارا من قبل؟

197
00:12:27,390 --> 00:12:31,850
عليك الذّهاب للبحث عنها
.عندما تكبرين يا شيمي

198
00:12:33,050 --> 00:12:34,570
...إذًا فهذه هي

199
00:12:40,140 --> 00:12:43,570
.هذا هو المكان الّذي ستقيمين فيه يا شيمي-ساما

200
00:12:43,770 --> 00:12:46,320
!مرحبًا بعودتك

201
00:12:48,480 --> 00:12:50,240
...هذا القصر

202
00:12:50,570 --> 00:12:52,540
.يبدو مألوفًا

203
00:12:52,740 --> 00:12:55,670
.ألبسوا شيمي-ساما ملابس لائقة

204
00:12:55,670 --> 00:12:57,550
.مفهوم

205
00:12:58,120 --> 00:12:59,470
!هذا مخيف

206
00:13:00,330 --> 00:13:03,300
.والآن، سنساعدك على الاستحمام

207
00:13:03,460 --> 00:13:04,510
ماذا؟

208
00:13:04,510 --> 00:13:06,220
!بإمكاني الاستحمام وحدي

209
00:13:06,220 --> 00:13:10,060
.لن نقبل بذلك. هذا هو المعتاد

210
00:13:10,060 --> 00:13:11,930
!مستحيل

211
00:13:15,680 --> 00:13:17,600
.أشعر بقلق شديد

212
00:13:17,970 --> 00:13:20,030
.تشعرني هذه الغرفة بالقلق أيضًا

213
00:13:21,390 --> 00:13:22,950
ولكن لماذا؟

214
00:13:23,610 --> 00:13:26,610
!حسنًا... هذا يناسبك تمامًا

215
00:13:29,940 --> 00:13:31,380
.اقتربي من المرآة

216
00:13:34,740 --> 00:13:37,830
.هذه زهور أرتميس نمت في إل

217
00:13:37,830 --> 00:13:42,460
ارتدت أجيال من الحكماء هذه الزّهور
.وهي تعمل كتميمة فعّالة أيضًا

218
00:13:43,000 --> 00:13:45,020
.كما توقّعت، أنت جميلة

219
00:13:45,580 --> 00:13:49,060
.المعذرة، لكنّك لم تخبرني من تكون بعد

220
00:13:49,290 --> 00:13:51,350
.كان عليّ تقديم نفسي أبكر من هذا

221
00:13:51,960 --> 00:13:54,350
.أنا قائد غريغوري سيديس

222
00:13:54,350 --> 00:13:56,480
.اسمي إرميا أوزاي

223
00:13:56,890 --> 00:14:03,070
مهمّة غريغوري سيديس هي حماية
.وإدارة الغريغوري وعوالمهم المتبلورة

224
00:14:03,480 --> 00:14:06,490
إرميا-سان، متى يمكنني رؤية أمّي؟

225
00:14:06,690 --> 00:14:11,200
إنّ والدتك مشغولة بشدّة بسبب كلّ
.هذا الاضطراب في الوقت الحاليّ

226
00:14:11,200 --> 00:14:15,000
إنّنا نأمل أن تتمكّني من مساعدتها
.ولو بشكل ضئيل

227
00:14:15,360 --> 00:14:19,470
هل تذكرين أيّ شيء عن الطّقوس؟

228
00:14:20,950 --> 00:14:23,000
.أنا آسفة. لا أذكر أيّ شيء

229
00:14:23,950 --> 00:14:25,550
...لا يمكنني أن أتذكّر

230
00:14:25,550 --> 00:14:27,630
.مع أنّه يبدو أنّ عليّ ذلك

231
00:14:29,380 --> 00:14:31,350
.يا لك من مسكينة

232
00:14:31,750 --> 00:14:35,520
.لم تتغيّري على الإطلاق مذ كنتِ طفلة

233
00:14:36,170 --> 00:14:40,480
،لا تملكين أيّ ذكريات عنها
.لذلك بالطّبع لا يمكنك استعمالها

234
00:14:40,480 --> 00:14:42,110
.لكن اطمئنّي

235
00:14:43,010 --> 00:14:46,650
.سنكون مسرورين بالقيام بكلّ شيء من أجلك

236
00:14:49,060 --> 00:14:50,860
!هذا مخيف

237
00:15:00,820 --> 00:15:02,050
...أنا

238
00:15:02,330 --> 00:15:03,680
.وحيدة

239
00:15:05,330 --> 00:15:06,810
...يراودني شعور

240
00:15:07,040 --> 00:15:10,970
بأنّني ربّما أتيتُ إلى مكان لن تتسنّى لي
.فيه رؤية الآخرين مرّة أخرى

241
00:15:12,420 --> 00:15:13,600
!كلاّ

242
00:15:14,000 --> 00:15:17,390
!المعذرة! أ-أرغب في الذّهاب للحمّام

243
00:15:22,930 --> 00:15:25,190
!أشعر بالوحدة سلفًا

244
00:15:25,190 --> 00:15:28,530
!ما كان البقيّة ليستسلموا للبكاء بهذه السّرعة

245
00:15:28,530 --> 00:15:31,780
.أتساءل ما قد يفعله يوكي-تشان
—لو كنت رين

246
00:15:35,280 --> 00:15:37,620
ما-ما-ماذا؟ ما الّذي يفعله رين هنا؟

247
00:15:38,400 --> 00:15:40,370
شيمي-ساما، هل من خطب ما؟

248
00:15:40,370 --> 00:15:42,300
!كـ-كلّ شيء بخير

249
00:15:43,370 --> 00:15:46,260
ما معنى استلقائه هنا هكذا؟

250
00:15:46,580 --> 00:15:48,420
هل حدث خطب ما؟

251
00:15:50,370 --> 00:15:52,350
!رين

252
00:15:52,580 --> 00:15:53,970
هل أنت بخير؟

253
00:15:53,970 --> 00:15:55,300
هل تأذّيت؟

254
00:16:09,560 --> 00:16:11,330
!عيناه مفتوحتان

255
00:16:14,650 --> 00:16:15,960
ما هذا؟

256
00:16:17,230 --> 00:16:19,700
!سيُكتشف أمري

257
00:16:22,070 --> 00:16:24,250
...إنّ رؤية وجهه فحسب

258
00:16:25,450 --> 00:16:27,040
!كم هذا رائع

259
00:16:27,040 --> 00:16:29,640
!أنا أشعر بتحسّن أكثر بالفعل

260
00:16:30,870 --> 00:16:33,010
!أنت مذهل فعلاً يا رين

261
00:16:39,800 --> 00:16:41,230
...أمّي

262
00:16:41,630 --> 00:16:42,770
.أنا آسف

263
00:16:43,260 --> 00:16:44,820
أمّي؟

264
00:16:45,510 --> 00:16:46,780
...أيّها العجوز

265
00:16:47,010 --> 00:16:48,570
.أنا آسف

266
00:16:50,280 --> 00:16:52,030
...يوكيو

267
00:16:53,560 --> 00:16:55,110
...رين

268
00:16:56,520 --> 00:16:57,670
.أنا آسف

269
00:16:58,320 --> 00:17:00,000
.أنا آسف للجميع

270
00:17:00,280 --> 00:17:01,840
.كان كلّ ذلك خطئي

271
00:17:03,120 --> 00:17:03,750
...كان

272
00:17:04,370 --> 00:17:06,300
!ذاك هو أنا الحقيقيّ

273
00:17:07,410 --> 00:17:12,260
كان أنا الحقيقيّ محاصَرًا طوال
.هذا الوقت لأنّي شرّير

274
00:17:12,580 --> 00:17:17,140
الشّخص الّذي أنا عليه الآن هو ما
!صرته طوال 16 سنة. أنا الخارجيّ

275
00:17:17,460 --> 00:17:21,850
هذا صحيح! إنّ تحرير لهبي بدون
!أيّ مبالاة هو شعور رائع

276
00:17:21,850 --> 00:17:24,690
!من الرّائع أن أكون أنا

277
00:17:25,550 --> 00:17:29,730
!مات كلّ من أمّي والعجوز بسببي

278
00:17:29,730 --> 00:17:32,530
!يعتقد الجميع أنّي السّبب

279
00:17:33,520 --> 00:17:38,120
لم يكن هنالك أيّ فائدة
!من كوني طيّبًا مع الآخرين

280
00:17:38,400 --> 00:17:40,160
من يهتمّ لذلك؟

281
00:17:40,400 --> 00:17:44,050
!رحل أخي الأصغر لأنّه يكرهني أيضًا

282
00:17:44,400 --> 00:17:45,290
...رين

283
00:17:45,530 --> 00:17:47,540
أتريد الذّهاب إلى حيث يوجد يوكي-تشان؟

284
00:17:47,540 --> 00:17:50,040
ولماذا قد أهتمّ لذلك الشّخص؟

285
00:17:50,240 --> 00:17:52,050
تريد الذّهاب إليه، صحيح؟

286
00:17:52,050 --> 00:17:56,010
صحيح أنّ يوكي-تشان ذهب من تلقاء
.نفسه، لكنّ ذلك كان مؤلمًا له

287
00:17:56,010 --> 00:17:57,470
أردتَ إنقاذه، صحيح؟

288
00:17:57,470 --> 00:17:59,970
!سأقوم بما يحلو لي أيضًا

289
00:18:00,340 --> 00:18:02,360
.أردتُ إنقاذه أيضًا

290
00:18:02,840 --> 00:18:05,600
،ولكن عندما تقتضي الحاجة
!أصير بلا فائدة دائمًا

291
00:18:05,600 --> 00:18:07,600
!سأنشر الفوضى في كلّ مكان

292
00:18:07,930 --> 00:18:09,060
...لكن

293
00:18:09,060 --> 00:18:12,870
ربّما حتّى أنا أستطيع القيام
!بشيء ما لمساعدة الجميع

294
00:18:13,140 --> 00:18:16,820
،قاموا جميعًا بالكثير من أجلي
!أريد ردّ الجميل

295
00:18:17,400 --> 00:18:19,620
...إنّ سبب شعوري هكذا

296
00:18:19,860 --> 00:18:21,570
...هو في الحقيقة

297
00:18:21,820 --> 00:18:24,080
!بفضلك وبفضل يوكي-تشان

298
00:18:31,410 --> 00:18:34,340
...لو لم ألتق بك وبيوكي-تشان

299
00:18:34,580 --> 00:18:38,840
لربّما كنت لا أزال أخاف من النّاس
.والعالم الخارجيّ

300
00:18:39,670 --> 00:18:44,610
لقد منحتماني الفرصة لتعلّم كم أنّ العالم
.واسع وكم أنّ الأشخاص رائعين

301
00:18:48,010 --> 00:18:50,110
...بالنّسبة لي، أنتما الاثنان

302
00:18:50,350 --> 00:18:52,360
!مثل الشّمس

303
00:18:58,060 --> 00:19:00,790
سأبذل كلّ ما لديّ في السّعي خلفكما، مفهوم؟

304
00:19:08,120 --> 00:19:09,120
!شيمي-ساما

305
00:19:09,450 --> 00:19:12,630
!يبدو أنّك أخذت وقتًا طويلاً في الدّاخل

306
00:19:12,630 --> 00:19:13,840
...عـ-عفوًا

307
00:19:13,840 --> 00:19:14,960
...مهلاً

308
00:19:14,960 --> 00:19:17,260
!إ-إنّني أقضي حاجتي الآن وبشكل كبير

309
00:19:17,660 --> 00:19:20,050
...بشكل كبير؟ ما الّذي

310
00:19:20,290 --> 00:19:22,300
!علينا فحص برازك

311
00:19:22,630 --> 00:19:24,720
!قد نواجه أزمة كبيرة إن مرضتِ

312
00:19:24,720 --> 00:19:27,270
!ماذا؟! كـ-كلاّ

313
00:19:31,050 --> 00:19:34,200
ماذا؟ شيمي؟

314
00:19:35,860 --> 00:19:39,440
مهلاً، ما الّذي أفعله؟
!لا يمكنني مواصلة الثّرثرة هكذا

315
00:19:39,440 --> 00:19:41,110
!عليّ العودة إلى حيث توقّفت

316
00:19:41,270 --> 00:19:43,240
—أ-أنا بخير، لذلك

317
00:19:43,240 --> 00:19:44,370
.أستأذنك

318
00:19:46,150 --> 00:19:47,170
ماذا؟

319
00:19:47,400 --> 00:19:48,540
رين؟

320
00:19:49,780 --> 00:19:51,330
هل كنتُ أتخيّل؟

321
00:19:51,490 --> 00:19:53,010
أين برازك؟

322
00:19:53,490 --> 00:19:55,250
و-وهم؟

323
00:19:55,250 --> 00:19:56,920
.يبدو أنّك متعبة

324
00:19:56,920 --> 00:19:59,300
.عليك أخذ قسط كافٍ من الرّاحة

325
00:19:59,300 --> 00:20:01,380
.سيكون الغد يومًا حافلاً بالنّسبة لك

326
00:20:01,380 --> 00:20:02,880
...حتّى إن كان وهمًا

327
00:20:04,880 --> 00:20:06,550
!حسنًا

328
00:20:12,260 --> 00:20:13,780
.مرحبًا بعودتك

329
00:20:15,100 --> 00:20:17,280
هل ارتحت بما يكفي؟

330
00:20:18,860 --> 00:20:21,740
!أشعر بتحسّن أكثر وأجهل السّبب

331
00:20:21,740 --> 00:20:23,860
!لا أحتاج للمزيد من الرّاحة

332
00:20:23,860 --> 00:20:27,710
.هذا هو المتوقّع منك يا أوكومورا-كُن
.كم أراحني هذا

333
00:20:28,690 --> 00:20:30,120
...أراحك

334
00:20:30,120 --> 00:20:31,120
ماذا؟

335
00:20:32,610 --> 00:20:35,880
.لم يكن يجدر بي أن أولد أبدًا

336
00:20:37,080 --> 00:20:38,630
...لكنّ ذلك لا يعني

337
00:20:38,630 --> 00:20:40,960
!أنّ عليّ الموت بدون قتال أيضًا

338
00:20:42,970 --> 00:20:47,220
!سأقرّر ما الّذي سأفعله بعد أن أرى كلّ شيء

339
00:20:48,050 --> 00:20:49,930
...عجبًا

340
00:20:51,430 --> 00:20:52,390
ما هذا؟

341
00:20:52,390 --> 00:20:53,560
هل لاحظت الأمر؟

342
00:20:53,560 --> 00:20:56,860
!هذه هالة لوسيفر! كلاّ! هذا مستحيل

343
00:20:59,070 --> 00:21:00,940
!عاد ساتان للحياة

344
00:21:00,940 --> 00:21:02,190
!اهربوا

345
00:21:06,150 --> 00:21:07,450
...يوري

346
00:21:08,480 --> 00:21:10,130
أين أنت؟

347
00:21:10,490 --> 00:21:12,200
إلى أين تذهبين؟

348
00:21:13,400 --> 00:21:16,710
!أستطيع الشّعور بابتعادك عنّي

349
00:21:16,910 --> 00:21:19,710
...إنّ دماغ وعائه يتدهور أكثر وأكثر

350
00:21:20,200 --> 00:21:24,220
وتحوّلت رغبته المشتعلة من
.أجل يوري إغين إلى هوس

351
00:21:24,580 --> 00:21:26,230
...هل

352
00:21:26,790 --> 00:21:28,510
...ستقومين

353
00:21:28,510 --> 00:21:31,520
بالتّخلّي عنّي؟

354
00:21:36,510 --> 00:21:39,060
.بدأ ساتان بالانهيار

355
00:21:43,180 --> 00:21:49,030
!يوري

356
00:21:59,280 --> 00:22:02,050
.بدأت اللّيلة الزّرقاء أخيرًا

357
00:23:34,970 --> 00:23:39,930
الحلقة القادمة
[اللّيلة الزّرقاء]