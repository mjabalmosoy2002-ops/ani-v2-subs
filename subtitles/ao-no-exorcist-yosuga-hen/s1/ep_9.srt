1
00:00:11,740 --> 00:00:17,120
طارد الأرواح الشّرّيرة الأزرق
آرك اللّيلة الزّرقاء

2
00:01:32,440 --> 00:01:33,940
...ساتان

3
00:01:34,490 --> 00:01:39,700
الحلقة 9 [قتال حتّى الموت]

4
00:01:35,110 --> 00:01:39,700
!وجدتُكما يا يوري وشيرو

5
00:01:43,950 --> 00:01:46,210
.هكذا إذًا

6
00:01:46,570 --> 00:01:49,580
إذًا فقد كنتُ محقًّا بشأنك
من البداية يا يوري؟

7
00:01:49,830 --> 00:01:53,140
!يا لك من حقيرة خائنة

8
00:01:53,910 --> 00:01:57,520
!آسفة لأنّي لم أستطع البقاء إلى جانبك

9
00:01:58,040 --> 00:01:59,890
إنّك تتألّم، صحيح؟

10
00:02:00,130 --> 00:02:02,230
!ولكن انظر

11
00:02:02,510 --> 00:02:05,110
!إنّهما ابنانا

12
00:02:05,550 --> 00:02:06,600
...أنت

13
00:02:06,970 --> 00:02:09,360
!صرتَ والدًا الآن

14
00:02:11,470 --> 00:02:14,150
ماذا تكون كتلتا اللّحم هاتين؟

15
00:02:19,230 --> 00:02:22,740
أتعتقدين أنّ ذلك سيُرضي جوعي؟

16
00:02:25,190 --> 00:02:28,290
!ما أريده هو أنت

17
00:02:28,290 --> 00:02:29,670
!شيرو

18
00:02:30,120 --> 00:02:32,090
!أعطنيه

19
00:02:35,660 --> 00:02:38,550
!أعطني ذلك الجسد

20
00:02:42,590 --> 00:02:44,720
!أنت لا تشبه البقيّة

21
00:02:44,720 --> 00:02:47,470
لن تستسلم بسهولة، صحيح؟

22
00:02:47,470 --> 00:02:50,690
!ذكّرني بذلك الوقت

23
00:02:50,690 --> 00:02:52,190
ماذا؟

24
00:02:53,600 --> 00:02:59,200
وقتها، لم أدرك ما الّذي يحدث
...بالفعل، لكنّي صرتُ الآن

25
00:02:59,400 --> 00:03:03,250
!أفهم أنّي لطالما أردتُ أن أصير بشرًا

26
00:03:06,320 --> 00:03:10,330
لا يُعقل أنّ هذا هو رينكا
!الّذي قالت يوري أنّها رأته

27
00:03:10,490 --> 00:03:14,340
!ستكون يوري في خطر ما لم نوقفه

28
00:03:14,620 --> 00:03:16,840
!هذا ليس رينكا عاديّ

29
00:03:16,840 --> 00:03:19,720
!إنّ تلك الفتاة تحت تأثيره الآن

30
00:03:20,080 --> 00:03:21,470
...عليك قتله

31
00:03:21,670 --> 00:03:23,560
!يا أوكومورا

32
00:03:39,100 --> 00:03:41,620
.لكنّي فشلت

33
00:03:41,850 --> 00:03:43,990
...يوري

34
00:03:44,940 --> 00:03:48,870
كانت تلك صدمة كبيرة عندما
!شقّ العجوز حلقه

35
00:03:48,870 --> 00:03:50,870
.لا أذكر أيّ شيء بعد ذلك

36
00:03:50,870 --> 00:03:56,750
،عندما أحبطني ذلك العجوز وتلك الشّمطاء
.احتجتُ إلى وقت طويل لأستعيد قوّتي

37
00:03:57,950 --> 00:04:02,060
لكنّ لا شيء ينجح من أوّل محاولة، صحيح؟

38
00:04:04,920 --> 00:04:06,640
...نيكو-تشان

39
00:04:07,090 --> 00:04:08,510
...أوبابا

40
00:04:10,510 --> 00:04:12,140
...أوكو-تشان

41
00:04:13,220 --> 00:04:17,020
،بعد إعادة النّظر في الأمر الآن
.كان الفشل وقتها ضروريًّا

42
00:04:17,820 --> 00:04:21,030
كلّ ذلك لأحصل يومًا ما على
.وعائي الحقيقيّ

43
00:04:21,890 --> 00:04:24,160
...أريد أن أكون أنت

44
00:04:24,650 --> 00:04:28,030
.الشّخص الّذي تحبّه يوري

45
00:04:28,320 --> 00:04:30,490
.أنا أحسدك

46
00:04:30,490 --> 00:04:31,410
ماذا؟

47
00:04:31,570 --> 00:04:34,580
...أشعر بالغيرة... والمرارة

48
00:04:34,580 --> 00:04:38,420
!لأنّك سلبتني يوري

49
00:04:38,420 --> 00:04:40,090
أليس عليّ أنا قول ذلك؟

50
00:04:40,090 --> 00:04:42,420
!الأمر نفسه بالنّسبة لك

51
00:04:43,120 --> 00:04:45,300
.أنا وأنت متشابهان

52
00:04:45,300 --> 00:04:46,180
ماذا؟

53
00:04:46,460 --> 00:04:48,180
!اعترف

54
00:04:50,630 --> 00:04:52,650
...نحن

55
00:04:53,260 --> 00:04:55,190
.متشابهان

56
00:05:03,070 --> 00:05:04,070
!شيرو

57
00:05:14,360 --> 00:05:16,170
...يا إلهي

58
00:05:16,780 --> 00:05:18,500
!كم أنت مزعج

59
00:05:21,420 --> 00:05:22,510
...ما الّذي

60
00:05:23,410 --> 00:05:24,880
!لكنّي تلبّستُه

61
00:05:24,880 --> 00:05:26,430
...مستحيل

62
00:05:26,430 --> 00:05:27,940
!توقّف

63
00:05:29,880 --> 00:05:33,640
!أن نكون متشابهين أيّها الوغد الدّنيء

64
00:05:39,930 --> 00:05:43,410
!لقد قام... بقتل نفسه

65
00:05:51,900 --> 00:05:53,460
!كـ-كلاّ

66
00:05:54,160 --> 00:05:57,380
!كـ-كلاّ! شيرو

67
00:06:05,870 --> 00:06:07,640
...يـ-يوري

68
00:06:07,830 --> 00:06:09,890
!ا-انظري إليّ

69
00:06:13,460 --> 00:06:15,180
...صـ-صرتُ

70
00:06:15,180 --> 00:06:16,400
...الرّجل

71
00:06:16,760 --> 00:06:19,950
!ا-الّذي تحبّينه

72
00:06:26,740 --> 00:06:28,070
ما رأيك؟

73
00:06:28,070 --> 00:06:29,780
ألستِ سعيدة؟

74
00:06:29,780 --> 00:06:32,120
!قمتُ بهذا لأجلك لأنّي أحبّك

75
00:06:35,740 --> 00:06:37,250
!هذا لا يُسعدني

76
00:06:39,870 --> 00:06:42,590
!أنت هو أنت

77
00:06:43,410 --> 00:06:47,010
...ألم الجراح والخوف من الموت

78
00:06:47,540 --> 00:06:51,260
...ووحشة المرء من كونه وحيدًا
تعرف هذا حقّ المعرفة، صحيح؟

79
00:06:51,920 --> 00:06:55,010
لذلك لماذا قد تُقدم على أذيّة الآخرين؟

80
00:06:56,430 --> 00:06:58,610
!مع أنّك تعرف تلك المشاعر

81
00:07:03,430 --> 00:07:06,690
.لا تضغطي على نفسك. ستنزفين حتّى الموت

82
00:07:09,650 --> 00:07:10,950
...أعد

83
00:07:15,530 --> 00:07:17,950
!عليّ التّحدّث معه

84
00:07:19,610 --> 00:07:21,130
...أعد

85
00:07:22,240 --> 00:07:24,000
!أعدها لي

86
00:07:24,160 --> 00:07:24,960
!هذا مؤلم

87
00:07:24,960 --> 00:07:27,300
!لقد أحببتُها

88
00:07:28,460 --> 00:07:30,050
!ساتان، توقّف

89
00:07:30,050 --> 00:07:31,630
لماذا لا تعيدها لي؟

90
00:07:31,790 --> 00:07:34,190
!أعد لي حبّي

91
00:07:37,710 --> 00:07:39,440
...ما تتحدّث عنه

92
00:07:39,970 --> 00:07:41,350
!ليس حبًّا

93
00:07:56,020 --> 00:07:58,540
—ما-ما الّذي

94
00:07:58,820 --> 00:08:00,460
...لن أسمح له

95
00:08:00,700 --> 00:08:02,540
!بقتل يوري

96
00:08:07,290 --> 00:08:10,260
أرى أنّك لا تقوى إلاّ على السّرقة إذًا؟

97
00:08:11,790 --> 00:08:14,590
!ذلك كلّ ما تجيده

98
00:08:16,600 --> 00:08:17,970
!اغرب عن وجهي

99
00:08:23,090 --> 00:08:24,480
!شيرو

100
00:08:25,720 --> 00:08:27,280
.إنّه بخير

101
00:08:28,100 --> 00:08:30,780
.أنت في حالة أكثر خطورة منه

102
00:08:30,780 --> 00:08:34,240
.سأسرّع فترة نفاسِك

103
00:08:34,240 --> 00:08:35,710
.تحمّلي الأمر

104
00:08:41,900 --> 00:08:43,460
...يا للغباء

105
00:08:43,780 --> 00:08:47,580
.وكأنّي سأموت من أجل وحش مثله

106
00:08:47,580 --> 00:08:50,890
.كنتُ موضوع اختبارات لأجل تجارب الإكسير

107
00:08:51,120 --> 00:08:53,770
.أنا أشفى بشكل أسرع من البشر العاديّين

108
00:08:54,710 --> 00:08:59,020
،أعلم أنّه إن كان التّقطيع دقيقًا
.فسيلتئم جرحي في غضون ساعة

109
00:08:59,380 --> 00:09:01,600
.ومع ذلك كان تصرّفك متهوّرًا

110
00:09:02,640 --> 00:09:06,190
.حتّى بعد كلّ ذلك، ما زلتُ لم أطرده

111
00:09:06,430 --> 00:09:08,860
.سيعود عاجلاً أم آجلاً

112
00:09:09,140 --> 00:09:11,480
.معك حقّ تمامًا

113
00:09:11,480 --> 00:09:12,730
من أنت؟

114
00:09:12,730 --> 00:09:14,740
!هذه شيميهازا

115
00:09:14,940 --> 00:09:17,200
ما-ماذا؟ تـ-تلك هي؟

116
00:09:17,200 --> 00:09:19,250
.كان الحظّ إلى جانبك بالفعل

117
00:09:19,480 --> 00:09:23,340
.بإمكان روح شيميهازا تسريع نشاط الخلايا

118
00:09:24,740 --> 00:09:26,620
!التأم الجرح سلفًا

119
00:09:26,620 --> 00:09:27,790
...اللّيلة

120
00:09:27,790 --> 00:09:30,590
تكبّد أعضاء الغريغوري الآخرون
...عداي أنا بإصابات بليغة

121
00:09:30,590 --> 00:09:34,050
بينما الفارس المقدّس والفرسان العظماء
...والعديد من الرّهبان وطاردي الأرواح

122
00:09:34,050 --> 00:09:37,800
.تغلّفوا في ألسنة لهب زرقاء وماتوا

123
00:09:38,960 --> 00:09:40,300
...يوري إغين

124
00:09:40,300 --> 00:09:45,360
حدث كلّ ذلك لأنّ ساتان سعى
.خلفك وبدأ بالبحث عن جسد

125
00:09:46,970 --> 00:09:49,690
...على ضوء المذبحة المدمّرة الّتي أعقبت ذلك

126
00:09:49,690 --> 00:09:52,070
نطلب منك كطاردة أرواح شرّيرة
...أن تُضحّي بنفسك

127
00:09:52,070 --> 00:09:55,740
.حتّى يتوقّف هوس ساتان بك

128
00:09:55,740 --> 00:09:56,740
...ما

129
00:09:58,980 --> 00:10:00,410
ماذا عن طفلاي؟

130
00:10:00,860 --> 00:10:06,160
قد يكون من الأفضل قتل أيّ كائن
.قد يُشعل هوس ساتان ثانية

131
00:10:06,910 --> 00:10:11,180
مع أنّه علينا أن نربّيهما حتّى
.نكتشف طريقة لطردهما

132
00:10:12,200 --> 00:10:14,300
.خذوها وكونوا لطفاء معها

133
00:10:14,300 --> 00:10:15,050
!حاضر –
!حاضر –

134
00:10:15,460 --> 00:10:16,520
!مهلاً

135
00:10:17,000 --> 00:10:18,300
أتحاولون عرقلتنا؟

136
00:10:18,300 --> 00:10:20,050
!لم تقترف يوري أيّ جريمة

137
00:10:21,710 --> 00:10:23,930
.أنا لا أتحدّث عن أيّ جريمة

138
00:10:23,930 --> 00:10:26,180
.كنتُ أشير للحقائق فحسب

139
00:10:26,970 --> 00:10:29,310
!إنّك في حضرة غريغوري
!ابتعد عن الطّريق

140
00:10:31,350 --> 00:10:32,440
!لن أفعل

141
00:10:33,400 --> 00:10:35,030
!لن أسمح لكم بفعل هذا

142
00:10:35,030 --> 00:10:37,820
سُحقًا لك! كيف تجرؤ على تصويب
مسدّس في وجه غريغوري؟

143
00:10:37,820 --> 00:10:39,820
هل تدرك ما الّذي تفعله؟

144
00:10:40,650 --> 00:10:41,920
أيمكنك الوقوف؟

145
00:10:43,530 --> 00:10:45,330
.لن أسمح بموتك

146
00:10:50,700 --> 00:10:51,960
!لا تتحرّكوا

147
00:10:51,960 --> 00:10:53,290
!أيّها الوغد

148
00:10:53,290 --> 00:10:55,840
!هذه خيانة واضحة

149
00:10:57,420 --> 00:10:59,640
.افتحي الباب بهذا المفتاح

150
00:11:08,260 --> 00:11:09,600
...والآن

151
00:11:09,600 --> 00:11:12,400
ألم تكن تريد معرفة ما يجري حتّى النّهاية؟

152
00:11:17,770 --> 00:11:19,280
!سامحينا رجاءً

153
00:11:19,280 --> 00:11:20,070
.لا بأس

154
00:11:20,770 --> 00:11:22,410
أواثقة بشأن هذا؟

155
00:11:22,650 --> 00:11:24,950
في الوقت الحاليّ، ثمّة مسائل
.أخرى يجب تولّي أمرها

156
00:11:24,950 --> 00:11:26,920
.تعرف ذلك حقّ المعرفة

157
00:11:27,150 --> 00:11:29,000
...إضافة لذلك

158
00:11:29,570 --> 00:11:32,970
.ساعات تلك الفتاة معدودة

159
00:11:42,170 --> 00:11:43,800
!كانوا وشيكين جدًّا

160
00:11:43,800 --> 00:11:44,930
هل أنت بخير؟

161
00:11:47,340 --> 00:11:48,180
.نعم

162
00:11:48,510 --> 00:11:49,820
أين نحن؟

163
00:11:50,220 --> 00:11:53,740
إنّه واحد من مكاتب فرع التّنظيم
.تمّ إغلاقه منذ مدّة

164
00:11:53,970 --> 00:11:59,280
،ثمّة برج مراقبة لليتّي قريبًا من هنا
.قمتُ بتجديده وحوّلته لمخبأ

165
00:12:02,560 --> 00:12:05,120
.لنتّجه إلى هناك بمجرّد أن تسكن العاصفة

166
00:12:05,120 --> 00:12:07,870
إنّه مكان سرّيّ، لذلك سنكون
.بأمان لبعض الوقت

167
00:12:07,870 --> 00:12:09,910
!إنّك تحبّ المخابئ بالفعل

168
00:12:10,320 --> 00:12:13,300
ا-اخرسي! من يهتمّ لذلك الآن؟

169
00:12:14,950 --> 00:12:16,000
لماذا تضحكين؟

170
00:12:16,000 --> 00:12:17,680
!لا سبب معيّن

171
00:12:18,700 --> 00:12:19,920
!مهلاً

172
00:12:21,000 --> 00:12:24,430
!بدآ بالبكاء معًا في نفس الوقت

173
00:12:24,750 --> 00:12:27,220
.هذا هو حال التّوائم. إنّهم متزامنون

174
00:12:27,220 --> 00:12:29,010
.لا بدّ أنّهما يشعران بالبرد

175
00:12:29,300 --> 00:12:31,270
.سأذهب للبحث عن ملابس لهما

176
00:12:31,270 --> 00:12:33,850
استعملي أيّ شيء تعثرين عليه
.كوقود لإبقاء النّار مشتعلة

177
00:12:33,850 --> 00:12:35,520
!حسنًا. شكرًا لك

178
00:12:37,560 --> 00:12:39,280
.اهدآ، اهدآ

179
00:12:39,520 --> 00:12:42,450
.عليّ التّفكير بأسماء لكما

180
00:12:43,900 --> 00:12:44,910
!مرحبًا

181
00:12:44,910 --> 00:12:49,280
"شرائح بطاطس"
"نكهة الملح"

182
00:12:45,310 --> 00:12:49,280
!وجدتُ كيس وجبات خفيفة
.لكن لا ملابس جيّدة

183
00:12:50,030 --> 00:12:51,420
!مرحبًا بعودتك

184
00:12:53,160 --> 00:12:54,500
ما الّذي تفعلينه؟

185
00:12:54,500 --> 00:12:55,670
.أرضعهما

186
00:12:55,670 --> 00:12:56,630
ترضعينهما؟

187
00:12:56,630 --> 00:12:59,040
.إنّهما يرضعان الآن تحت ملابسي

188
00:12:59,040 --> 00:13:01,250
.فعلاً؟ هذا سبب إضافيّ يدفعك للأكل

189
00:13:03,920 --> 00:13:07,260
.لقد فكّرت في اسمين لهما

190
00:13:07,260 --> 00:13:10,470
خرج هذا إلى العالم بانفجار
..."مثل الوهج النّاريّ "رينكا

191
00:13:10,470 --> 00:13:11,720
."لذا فاسمه "رين

192
00:13:11,720 --> 00:13:12,720
.هذا حرفيّ

193
00:13:13,050 --> 00:13:14,350
.هذا حرفيّ جدًّا

194
00:13:14,350 --> 00:13:15,230
...وأيضًا

195
00:13:15,550 --> 00:13:19,730
،"سأسمّي الصّغير "يوكيو
."اختصارًا لـ"يوكي-أوتوكو

196
00:13:20,140 --> 00:13:21,270
...ذلك

197
00:13:21,430 --> 00:13:22,530
لماذا ذلك الاسم؟

198
00:13:22,850 --> 00:13:24,070
ماذا؟

199
00:13:24,070 --> 00:13:26,200
فهمت اسم رين، ولكن ماذا عن يوكيو؟

200
00:13:26,200 --> 00:13:28,030
ما مصدر ذلك؟

201
00:13:29,780 --> 00:13:32,540
.فهمت، إنّك تعبثين معي بالكامل

202
00:13:32,540 --> 00:13:34,120
!أنا لا أعبث على الإطلاق

203
00:13:34,120 --> 00:13:37,500
يوكي-أوتوكو هو ما يوصف به
!الشّخص الدّافئ والقويّ

204
00:13:37,500 --> 00:13:38,420
ماذا؟

205
00:13:38,870 --> 00:13:41,290
.على أيّ حال، لم تأكلي أيّ شيء

206
00:13:41,620 --> 00:13:44,090
.مع أنّي سمحت لك بأكل حصّتي

207
00:13:44,090 --> 00:13:47,180
معك حقّ. مع أنّك لئيم جدًّا
.في العادة يا شيرو

208
00:13:47,180 --> 00:13:49,930
أصبتِ. أنت مدينة لي الآن، صحيح؟

209
00:13:51,050 --> 00:13:52,180
!لئيم

210
00:13:54,380 --> 00:13:55,180
!مهلاً

211
00:13:55,930 --> 00:13:58,520
.بدأت العاصفة تسكن

212
00:13:58,520 --> 00:14:00,030
.يمكنني رؤية برج المراقبة

213
00:14:00,260 --> 00:14:04,230
هناك كهرباء وماء ومؤونة من
.الطّعام في مخبئي، كما أنّه آمن

214
00:14:04,230 --> 00:14:05,940
.حان الوقت لمواصلة المسير

215
00:14:05,940 --> 00:14:06,910
.حسنًا

216
00:14:09,820 --> 00:14:10,870
هل أنت بخير؟

217
00:14:11,110 --> 00:14:13,950
.آسفة. دختُ قليلاً فحسب

218
00:14:15,070 --> 00:14:16,960
.لنسرع بالذّهاب

219
00:14:18,660 --> 00:14:20,220
.لا، لنرتح أكثر

220
00:14:20,450 --> 00:14:21,710
لماذا؟

221
00:14:22,290 --> 00:14:24,550
!أنا بخير الآن

222
00:14:25,660 --> 00:14:26,890
.لنذهب

223
00:14:27,670 --> 00:14:30,590
.حـ-حسنًا إذًا

224
00:14:31,920 --> 00:14:34,270
.ركّزي على المشي فقط

225
00:14:39,260 --> 00:14:44,120
يستغرق الوصول إلى هناك ربع
.ساعة سيرًا دون كل هذا الثّلج

226
00:14:44,390 --> 00:14:46,450
هل ستظهر أيّ يتّي؟

227
00:14:47,480 --> 00:14:49,490
.سمعتُ أنّها انقرضت

228
00:14:49,490 --> 00:14:53,000
لذلك السّبب أقفلوا كلاًّ من
.مكتب الفرع وبرج المراقبة

229
00:14:53,900 --> 00:14:56,040
...بعد وصولنا إلى المخبأ

230
00:14:57,360 --> 00:14:59,370
فما الّذي سنفعله؟

231
00:14:59,990 --> 00:15:02,670
...سنتوارى عن الأنظار لفترة

232
00:15:02,670 --> 00:15:04,140
.وننتظر كيف ستنتهي الأمور

233
00:15:05,120 --> 00:15:08,560
.في ذلك الوقت، سأبحث عن مخبئنا التّالي

234
00:15:10,290 --> 00:15:11,690
.أنا آسفة

235
00:15:12,460 --> 00:15:15,390
.صرتَ الآن هاربًا بسببي

236
00:15:16,680 --> 00:15:18,820
.بصراحة، هذا مريح أكثر

237
00:15:19,510 --> 00:15:22,610
.لطالما أردتُ أن أكون حرًّا

238
00:15:23,600 --> 00:15:25,900
.كان عليّ القيام بهذا في وقت أبكر

239
00:15:31,020 --> 00:15:32,210
...وهذه المرّة

240
00:15:32,520 --> 00:15:34,000
.لنعش معًا

241
00:15:35,610 --> 00:15:39,040
.سأؤدّي دور الأب، وأنت دور الأمّ

242
00:15:39,400 --> 00:15:41,050
يبدو ذلك ممتعًا، صحيح؟

243
00:15:54,000 --> 00:15:56,300
!نعم. أحببتُ ذلك

244
00:16:02,930 --> 00:16:03,900
!يوري

245
00:16:03,900 --> 00:16:05,110
ماذا؟

246
00:16:10,850 --> 00:16:12,780
...إنّ كلّ قوّتي

247
00:16:12,780 --> 00:16:14,660
.تُستنزف منّي

248
00:16:20,110 --> 00:16:23,170
.شيرو، احملني على ظهرك

249
00:16:25,490 --> 00:16:28,800
يا إلهي. ما الّذي سأفعله بك؟

250
00:16:29,750 --> 00:16:32,310
.أتمنّى لو كانت شورا-تشان هنا أيضًا

251
00:16:32,920 --> 00:16:34,310
.لا تتفوّهي بالهراء

252
00:16:34,540 --> 00:16:38,020
.على أيّ حال، تلك الفتاة مقتنعة أنّي خطيبها

253
00:16:40,090 --> 00:16:44,390
.مع أنّ قيامي بدور والدها يبدو سخيفًا أيضًا

254
00:16:44,590 --> 00:16:46,900
.لا فكرة لديّ ما العمل

255
00:16:50,980 --> 00:16:55,530
في الرّبيع، لنرمي الفاصولياء للتّخلّص من
.الأرواح الشّرّيرة. ستقوم بدور الشّيطان

256
00:16:55,530 --> 00:16:56,660
ماذا؟

257
00:16:57,940 --> 00:17:02,300
أودّ الذّهاب لمشاهدة
.براعم الكرز عندما تتفتّح

258
00:17:04,910 --> 00:17:07,630
...وفي الصّيف، سنذهب إلى الشّاطئ

259
00:17:07,870 --> 00:17:11,470
ونأكل البطّيخ الأحمر بينما
.نشاهد الألعاب النّاريّة

260
00:17:14,710 --> 00:17:19,150
...وفي الخريف، سنُطعمهما طعامًا لذيذًا

261
00:17:19,420 --> 00:17:23,440
.وسنحملهما للفراش ملفوفين بأغطية دافئة

262
00:17:26,180 --> 00:17:27,570
...وفي الشّتاء

263
00:17:27,850 --> 00:17:31,620
.سنقيم لهما حفلات أعياد مولد

264
00:17:35,350 --> 00:17:36,830
...وأنت يا شيرو

265
00:17:37,310 --> 00:17:39,170
...ستلعب دور والدهما

266
00:17:39,440 --> 00:17:41,840
.بأيّ شكل تريد

267
00:17:42,860 --> 00:17:44,080
...وهكذا

268
00:17:44,900 --> 00:17:45,960
...ذات يوم

269
00:17:46,530 --> 00:17:49,130
...ستصير والدهما الحقيقيّ

270
00:17:50,160 --> 00:17:52,010
.بكلّ التّأكيد

271
00:17:54,660 --> 00:17:56,590
.ستكون بخير

272
00:17:57,170 --> 00:17:58,680
...حسنًا

273
00:17:58,680 --> 00:18:01,100
...ما دمتِ موجودة، فسأستطيع أن

274
00:18:04,090 --> 00:18:05,150
!يوري

275
00:18:05,800 --> 00:18:06,600
!مهلاً

276
00:18:06,760 --> 00:18:08,850
!هل أنت بخير؟ نكاد نصل

277
00:18:08,850 --> 00:18:10,110
!تماسكي

278
00:18:19,270 --> 00:18:20,330
...رين

279
00:18:22,530 --> 00:18:24,620
...يوكيو

280
00:18:25,320 --> 00:18:26,840
...كونا أخوين

281
00:18:27,450 --> 00:18:29,630
جيّدين لبعضكما، مفهوم؟

282
00:18:49,560 --> 00:18:50,780
!مهلاً

283
00:18:51,010 --> 00:18:52,480
!ا-انتظري

284
00:18:52,480 --> 00:18:53,990
!انتظري

285
00:18:54,970 --> 00:18:56,320
!لا يُعقل

286
00:18:56,890 --> 00:18:59,540
!لا تزالين... دافئة

287
00:19:00,310 --> 00:19:01,740
...أرجوك

288
00:19:01,740 --> 00:19:03,250
!أنا أتوسّل إليك

289
00:19:03,860 --> 00:19:06,330
...منذ أوّل لقاء بيننا

290
00:19:06,330 --> 00:19:09,010
!وأنا... واقع في حبّك

291
00:19:19,500 --> 00:19:20,640
...هيّا

292
00:19:21,420 --> 00:19:22,840
أتسمعينني؟

293
00:19:29,840 --> 00:19:31,600
.لا فائدة

294
00:19:32,970 --> 00:19:36,120
.ما عادت... تسمعني

295
00:19:40,270 --> 00:19:43,740
!لكنّها كانت تضحك قبل لحظة فحسب

296
00:19:44,480 --> 00:19:46,080
.رحلتْ الآن

297
00:19:57,620 --> 00:19:59,140
...لماذا لم

298
00:20:00,330 --> 00:20:01,560
...أنا

299
00:20:02,710 --> 00:20:04,230
...لمَ لم أحظى

300
00:20:04,630 --> 00:20:06,350
...بالمزيد

301
00:20:07,210 --> 00:20:09,520
...لو لم أكن موجودًا

302
00:20:10,090 --> 00:20:12,150
!كلّ هذا خطئي أنا

303
00:20:12,800 --> 00:20:14,530
...أنا المُلام

304
00:21:00,890 --> 00:21:02,820
لم تنقرضي إذًا؟

305
00:21:20,410 --> 00:21:22,090
.نعم

306
00:21:22,790 --> 00:21:25,060
.هذا بالضّبط ما أحتاجه

307
00:21:25,670 --> 00:21:27,840
.دعوني أموت فحسب

308
00:21:31,630 --> 00:21:34,400
.وجب أن أكون ألطف معها

309
00:21:35,180 --> 00:21:37,530
.وجب عليّ أن أحميها أكثر

310
00:21:38,970 --> 00:21:41,490
.لكنّي تركتها تعاني، وتموت

311
00:21:43,180 --> 00:21:45,450
...من أكون لأسخر من الوحوش

312
00:21:46,350 --> 00:21:49,460
بينما أنا أسوأ الوحوش على الإطلاق؟

313
00:21:52,150 --> 00:21:53,380
...والآن

314
00:21:54,450 --> 00:21:55,840
...ما عدت أملك

315
00:21:57,450 --> 00:21:59,760
.الإرادة لفعل أيّ شيء

316
00:23:34,890 --> 00:23:39,850
الحلقة القادمة
[نور]