1
00:00:11,690 --> 00:00:17,120
طارد الأرواح الشّرّيرة الأزرق
آرك اللّيلة الزّرقاء

2
00:01:33,070 --> 00:01:39,040
الحلقة 12   [شكرًا]

3
00:01:36,900 --> 00:01:38,910
حسنًا، هل أعجبك؟

4
00:01:40,900 --> 00:01:43,120
!رين! لا تأكل الصّحن أيضًا

5
00:01:45,780 --> 00:01:48,080
ما الّذي تفعله؟

6
00:02:00,290 --> 00:02:02,810
.يوكيو أضعف منك

7
00:02:03,010 --> 00:02:04,250
.عليك حمايته

8
00:02:04,250 --> 00:02:05,650
.مفهوم

9
00:02:05,850 --> 00:02:07,850
!حسنًا، لنرَ ما سيفعله –
!أعيدوها لي –

10
00:02:08,050 --> 00:02:09,810
!أعيدوها لي

11
00:02:09,810 --> 00:02:11,270
!يوكيو

12
00:02:15,190 --> 00:02:16,830
.أعتذر على هذا

13
00:02:16,940 --> 00:02:18,830
.هيّا! اعتذر أنت أيضًا

14
00:02:21,450 --> 00:02:24,250
!أخبرتك أن تحميه، لا أن تكون عنيفًا

15
00:02:25,360 --> 00:02:26,670
...شكرًا

16
00:02:27,320 --> 00:02:29,170
...شكرًا لك أيضًا

17
00:02:33,290 --> 00:02:35,030
!كم هذا رائع

18
00:02:35,030 --> 00:02:36,670
!إنّها جديدة

19
00:02:36,670 --> 00:02:37,670
!خذ

20
00:02:37,670 --> 00:02:39,180
مثلّجات الحمّام الاستوائيّة الفائقة

21
00:02:43,170 --> 00:02:45,230
...تلك الأشياء مخيفة

22
00:02:45,630 --> 00:02:48,400
!لا أريد رؤيتها بعد الآن... إنّها مخيفة

23
00:02:51,510 --> 00:02:52,700
...يوكيو

24
00:02:55,390 --> 00:02:58,190
أتريد أن تقاتلها معي؟

25
00:03:00,980 --> 00:03:03,290
.لا تخف من الظّلام

26
00:03:03,440 --> 00:03:06,880
.كُن قويًّا لحماية أخيك والبقيّة

27
00:03:10,280 --> 00:03:13,210
!أريد أن أصير قويًّا بما يكفي لحماية أخي

28
00:03:24,720 --> 00:03:27,220
!هيّا، تشجّع! لقد وعدتني

29
00:03:32,010 --> 00:03:33,560
.شكرًا على الطّعام

30
00:03:41,850 --> 00:03:43,110
!ابتعد عنّي

31
00:03:43,770 --> 00:03:45,710
!أخبرتك أنّي بخير

32
00:03:50,370 --> 00:03:52,050
!أجل

33
00:03:50,370 --> 00:03:54,630
مدرسة الصّليب الحقيقيّ الإعداديّة الجنوبيّة
مراسم الدّخول المدرسيّ

34
00:03:52,160 --> 00:03:53,760
!هيّا يا رين، ابتسم

35
00:03:58,000 --> 00:04:00,130
!انظري، إنّه أوكوموري يوكيو-كُن

36
00:04:00,130 --> 00:04:02,850
!كم هو وسيم –
!كم أحبّ نظّاراته –

37
00:04:15,680 --> 00:04:18,340
!رين! لا تتغيّب اليوم

38
00:04:18,340 --> 00:04:20,340
!إيّاك أن ترسب وتكرّر السّنة

39
00:04:20,340 --> 00:04:21,800
!اخرس أيّها العجوز

40
00:04:21,800 --> 00:04:24,500
!لا مكان لديّ في المدرسة

41
00:04:25,230 --> 00:04:28,000
.يا له من فتى صعب المراس

42
00:04:28,150 --> 00:04:30,740
...ومع ذلك، كم أحبّ أنّه يعدّ الفطور

43
00:04:34,110 --> 00:04:36,430
...اقترب الوقت

44
00:04:39,500 --> 00:04:41,970
!اخرس أيّها الوغد

45
00:04:42,460 --> 00:04:44,770
هل تسمع ذلك الصّوت ثانية؟

46
00:04:45,210 --> 00:04:46,810
.صار ذلك يحدث كثيرًا

47
00:04:47,960 --> 00:04:49,900
!لا تضخّم المسألة

48
00:04:51,010 --> 00:04:55,940
عندما يحين الوقت، سأجعله
!يعاني كثيرًا لدرجة الهرب

49
00:04:56,050 --> 00:05:00,280
سأقتلع أظافري وأحبس نفسي في صندوق
...تعذيب وأقطع ***ـي

50
00:05:00,520 --> 00:05:02,070
!سأريه

51
00:05:03,520 --> 00:05:06,670
!كفّ عن المزاح! أنا طارد أرواح أيضًا

52
00:05:06,670 --> 00:05:09,030
!لم أعد طفلاً، فدعني أساعدك

53
00:05:09,940 --> 00:05:11,540
.لا تقلق. أنا بخير

54
00:05:11,540 --> 00:05:15,650
!سرّ مقاومة التّلبّس هو امتلاك جسد صحّيّ

55
00:05:15,650 --> 00:05:17,540
!الأكل جيّدًا والنّوم جيّدًا والبقاء نشِطًا

56
00:05:17,950 --> 00:05:20,680
!لا يوجد ما هو أفضل من ذلك
!هيّا، كل أنت أيضًا

57
00:05:23,160 --> 00:05:25,350
.يوكيو محقّ

58
00:05:25,960 --> 00:05:28,690
.أنا في حالة سيّئة مؤخّرًا

59
00:05:29,170 --> 00:05:30,940
...لا بدّ أنّ سنّي يساهم في ذلك أيضًا

60
00:05:31,550 --> 00:05:34,900
لستُ واثقًا أنّي سأكون قادرًا
.على مقاومة التّلبّس التّالي

61
00:05:36,050 --> 00:05:38,630
.لا يجب عليك قول ذلك

62
00:05:38,630 --> 00:05:41,070
.يستغلّ الشّرّ أصغر نقاط الضّعف

63
00:05:42,220 --> 00:05:43,490
...أعلم

64
00:05:43,930 --> 00:05:46,540
.كما أنّ الطّفلين لا يزالان صغيرين

65
00:05:46,600 --> 00:05:48,410
.عليّ المقاومة أكثر

66
00:05:55,110 --> 00:05:56,830
من أين حصلت على البذلة؟

67
00:05:58,450 --> 00:06:02,280
لقد... قيل لي أنّ عليّ إجراء
.مقابلات، لذلك استعرتُها

68
00:06:02,280 --> 00:06:03,510
وربطة عنقك؟

69
00:06:03,950 --> 00:06:06,140
!ما عاد أيّ أحد يرتديها الآن

70
00:06:07,370 --> 00:06:09,530
.اعترف أنّك لا تعرف كيف تربطها فحسب

71
00:06:09,530 --> 00:06:11,640
.أعطني إيّاها، سأعلّمك كيف

72
00:06:17,510 --> 00:06:18,890
...يا إلهي منك

73
00:06:19,050 --> 00:06:21,400
!الشّيء الوحيد الّذي كبر فيك هو جسدك

74
00:06:21,810 --> 00:06:25,950
لا أصدّق أنّك كنت ظريفًا
.في صغرك وتسألك عن والدك

75
00:06:26,770 --> 00:06:28,620
عمّ تتكلّم؟

76
00:06:29,190 --> 00:06:32,030
سيكون من الغريب جدًّا
.أن أكون راشدًا وظريفًا

77
00:06:32,230 --> 00:06:34,130
راشد؟ ماذا؟

78
00:06:34,280 --> 00:06:36,460
.أين؟ لا أراه

79
00:06:37,950 --> 00:06:38,870
!اخرس

80
00:06:39,110 --> 00:06:43,260
،إن كنتَ تكره ذلك كثيرًا
!فابدأ بإظهار أنّك قد نضجت

81
00:06:45,450 --> 00:06:47,200
...لا تعبث معي

82
00:06:47,200 --> 00:06:50,180
!سأثبت أنّي أستطيع ذلك وحدي

83
00:06:50,380 --> 00:06:52,850
!أزل سدّادات عينيك وراقبني جيّدًا

84
00:06:53,420 --> 00:06:55,470
...العينان ليسا أذنين ليكون لهما سدّادات

85
00:06:55,470 --> 00:06:57,110
!اخرس أيّها العجوز الوغد

86
00:07:02,550 --> 00:07:03,530
...رين

87
00:07:12,230 --> 00:07:14,620
!اقتربت السّاعة

88
00:07:16,650 --> 00:07:22,770
أنتم يا طاردي الأرواح... أضحكتموني كثيرًا
...عندما قرّرتم تربية ذلك الطّفل

89
00:07:22,770 --> 00:07:27,320
!لقد كبُر في وقت أسرع ممّا ظننت

90
00:07:27,320 --> 00:07:31,130
!تبًّا لك أيّها الوغد
أتسعى خلف جسد رين؟

91
00:07:38,340 --> 00:07:39,440
!سُحقًا

92
00:07:40,720 --> 00:07:45,820
!كنتَ تستعملني لتتجسّس على رين فحسب

93
00:07:46,020 --> 00:07:47,660
!شيطان لعين

94
00:07:56,190 --> 00:07:57,250
ما هذا؟

95
00:07:59,740 --> 00:08:02,920
...أنا لا أفهم! هذا الشّيطان

96
00:08:02,920 --> 00:08:04,970
أيعقل أنّه يوشك أن يستيقظ؟

97
00:08:05,200 --> 00:08:07,170
ما هي حقيقتي بالضّبط؟

98
00:08:08,700 --> 00:08:10,880
...إنّك تضيّع وقتك

99
00:08:11,500 --> 00:08:13,880
...لا فائدة من هذا

100
00:08:18,710 --> 00:08:20,020
...هكذا إذًا

101
00:08:20,220 --> 00:08:23,270
سيُسوَّى كلّ شيء إن رحلتُ، صحيح؟

102
00:08:23,590 --> 00:08:25,900
!رين –
...ممتاز –

103
00:08:25,970 --> 00:08:29,150
إنّه جاهز، ألا تظنّ ذلك؟

104
00:08:29,310 --> 00:08:31,650
.يمكنك أن ترتاح من تلك النّاحية –
!رين –

105
00:08:34,150 --> 00:08:36,950
!اتركني! أنت من دفعني بعيدًا عنك

106
00:08:36,950 --> 00:08:39,500
...ما أنا إلاّ ابنٌ لا فائدة منه

107
00:08:39,650 --> 00:08:42,880
.كلاّ... بل لستُ ابنك من الأساس
.نحن غريبان عن بعض

108
00:08:42,950 --> 00:08:44,660
!رين –
.كن صريحًا –

109
00:08:44,660 --> 00:08:49,610
...اعترف أنّك سئمت من –
.إنّه يفقد السّيطرة الآن –

110
00:08:49,610 --> 00:08:51,850
...ربّما واجبك المقدّس يمنعك

111
00:08:51,960 --> 00:08:55,550
أم أنّك تريد لعب دور الأب
المتفاني لمرّة أخيرة؟

112
00:08:55,960 --> 00:09:00,560
...هذه هي الفرصة المناسبة لتلبُّسه

113
00:09:01,090 --> 00:09:03,810
!لا تتصرّف ثانية وكأنّك أبي

114
00:09:10,060 --> 00:09:11,990
.ستشرق الشّمس قريبًا

115
00:09:12,350 --> 00:09:14,070
.اذهب لحزم حقائبك

116
00:09:21,150 --> 00:09:22,080
.حسنًا

117
00:09:28,450 --> 00:09:32,760
...انتهى أمرك يا طارد الأرواح

118
00:09:36,630 --> 00:09:39,520
!تردّدتَ للحظة قبل قليل

119
00:09:47,510 --> 00:09:53,120
كيف بإمكانك أن تصدّق أنّ ذلك
الفتى قد يكون وعاءً لي أيّها الغبيّ؟

120
00:09:53,430 --> 00:09:56,580
.مع أنّه يملك الإمكانات لذلك

121
00:09:56,690 --> 00:09:59,560
عليّ فقط إرسال روحه إلى جهنّم

122
00:09:59,560 --> 00:10:03,620
حيث يستطيع والده الحقيقيّ
!تولّي أمر تعليمه

123
00:10:03,940 --> 00:10:06,350
،إن أحسنتُ في تولّي هذا الأمر

124
00:10:06,350 --> 00:10:10,000
.فقد يصير جسدًا مناسبًا لي لاحقًا

125
00:10:12,950 --> 00:10:16,010
وكيف سأفعل ذلك؟ –
!مهلاً –

126
00:10:16,210 --> 00:10:18,970
!سأستعمل جسدك بالطّبع

127
00:10:21,460 --> 00:10:23,110
!اختفِ

128
00:10:27,550 --> 00:10:29,980
...تقابلنا أخيرًا

129
00:10:30,720 --> 00:10:32,980
...يا بُنيّ

130
00:10:34,680 --> 00:10:36,540
.وأخيرًا

131
00:10:39,950 --> 00:10:41,620
.أنا ساتان

132
00:10:41,860 --> 00:10:45,630
.إله جهنّم، ووالدك الحقيقيّ

133
00:10:47,360 --> 00:10:49,960
!"يمكنك مناداتي "بابا

134
00:11:09,550 --> 00:11:12,420
،إنّ دمائي، دماء إله جهنّم
،تسري في عروقك

135
00:11:12,420 --> 00:11:15,320
.لكنّ جسدكم ينتمي لأسيا

136
00:11:15,560 --> 00:11:18,150
!وذلك يجعلك كائنًا استثنائيًّا

137
00:11:24,230 --> 00:11:26,210
!صرختك الأولى

138
00:11:26,320 --> 00:11:29,870
.ستولد اليوم من جديد كشيطان

139
00:11:31,250 --> 00:11:33,880
!النّجدة! ساعدوني

140
00:11:34,080 --> 00:11:36,570
!عيد مولد سعيد يا بُنيّ

141
00:11:36,570 --> 00:11:38,130
...فهمت

142
00:11:46,640 --> 00:11:48,820
...هكذا هو الأمر إذًا

143
00:11:49,170 --> 00:11:51,780
،هذا الفتى ابني أنا

144
00:11:52,510 --> 00:11:54,650
.وستُعيده لي

145
00:11:57,310 --> 00:12:00,370
!يا لك من طارد أرواح لعين

146
00:12:04,150 --> 00:12:08,630
هل ستُنهي حياتك بنفسك؟
...يا لك من راهب فاسد

147
00:12:09,190 --> 00:12:11,410
.لكنّ ذلك لا يهمّ، فات الأوان

148
00:12:12,360 --> 00:12:14,420
...صرتَ في قبضة بوّابة جهنّم

149
00:12:14,410 --> 00:12:16,640
...ولن تتركك أبدًا

150
00:12:19,790 --> 00:12:22,810
!أيها العجوز! تماسك أيّها العجوز

151
00:12:46,060 --> 00:12:48,460
هل عثرتَ على أجوبة لأسئلتك؟

152
00:12:54,280 --> 00:12:57,010
،ساتان، يوري إغين

153
00:12:57,280 --> 00:12:59,050
...فوجيموتو شيرو

154
00:12:59,790 --> 00:13:04,640
...رأيت الكثير من الموت
بماذا شعرتَ بعد ذلك؟

155
00:13:05,960 --> 00:13:09,690
هل تفضّل لو لم تكن قد وُلدتَ من قبل؟

156
00:13:14,300 --> 00:13:17,070
ما الّذي تريده بالضّبط؟

157
00:13:17,300 --> 00:13:19,280
أتريد أن تحوّلني إلى سلاح؟

158
00:13:19,430 --> 00:13:22,660
!أم إلى وعاء لساتان؟ أخبرني

159
00:13:26,060 --> 00:13:29,670
.حسنًا... الأمران معًا في الحقيقة

160
00:13:29,910 --> 00:13:35,340
.حتّى أنا، ملك الوقت، لا يمكنني توقّع المستقبل

161
00:13:35,740 --> 00:13:38,470
،لا يمكنني السّيطرة عليك بالكامل

162
00:13:38,530 --> 00:13:41,920
.مهما كان ما أرغب فيه

163
00:13:44,290 --> 00:13:46,530
،لا أريد تكرار الشّرح

164
00:13:46,530 --> 00:13:48,850
لكنّ مفتاح الاختفاء هذا

165
00:13:48,920 --> 00:13:52,060
.سيرشدك إلى المكان الّذي ترغب فيه

166
00:14:04,980 --> 00:14:08,250
.يعتمد المستقبل عليك فحسب

167
00:14:22,950 --> 00:14:25,100
.ها قد عدتَ أخيرًا

168
00:14:25,290 --> 00:14:27,680
أين كنت طوال هذا الوقت؟

169
00:14:29,630 --> 00:14:31,090
ماذا؟ من أنت؟

170
00:14:32,210 --> 00:14:33,650
...صحيح! أنا

171
00:14:33,880 --> 00:14:36,400
!كلاّ! نسيت ارتداء قلنسوتي

172
00:14:36,720 --> 00:14:39,100
.لا يهمّ، اجلس

173
00:14:39,680 --> 00:14:40,700
...حاضر

174
00:14:41,140 --> 00:14:42,860
!تذوّق هذه

175
00:14:48,100 --> 00:14:51,500
كرات الأرزّ المقليّة مع البونيتو
...المجفّف الّتي كان يعدّها

176
00:14:51,610 --> 00:14:55,120
...كان يقدّمها لنا دائمًا في صغرنا

177
00:14:55,610 --> 00:14:58,960
.إنّها وصفة جديدة، أخبرني برأيك فيها

178
00:14:59,780 --> 00:15:01,120
...حـ... حسنًا

179
00:15:15,130 --> 00:15:17,470
!لذيذة

180
00:15:18,220 --> 00:15:19,360
.إنّها لذيذة

181
00:15:20,590 --> 00:15:23,780
.قد تحتاج لبعض الملح –
أتظنّ ذلك؟ –

182
00:15:23,890 --> 00:15:27,230
أنا أحاول إعادة صنع كرات أرزّ
.أطعمني إيّاها صديق من قبل

183
00:15:27,730 --> 00:15:29,240
...يا للحنين

184
00:15:32,900 --> 00:15:35,210
.ثمّة الكثير، كُل بقدر ما تشاء

185
00:15:35,860 --> 00:15:36,900
!شكرًا

186
00:15:36,900 --> 00:15:39,750
!لا تبدو في حالة جيّدة
هل تأكل بما يكفي؟

187
00:15:40,820 --> 00:15:44,880
لا أصدّق الطّريقة المخزية الّتي ترهق
.بها القوّات الخاصّة رجالها اليافعين

188
00:15:45,830 --> 00:15:49,670
.أنا آسف، لكن عليّ رفض قيادة وحدة لادون

189
00:15:49,870 --> 00:15:53,730
عليهم أن يعهدوا بالمنصب الّذي كان
...للوسي إلى الفارس العظيم الجديد

190
00:15:53,840 --> 00:15:56,470
لحظة، ما كان اسمه؟

191
00:15:56,670 --> 00:15:59,870
.إينجل؟ نعم، هو من عليه تولّي الأمر

192
00:15:59,870 --> 00:16:01,740
.إنّه قويّ جدًّا

193
00:16:02,430 --> 00:16:03,850
،وبصراحة

194
00:16:04,180 --> 00:16:07,030
.دوري كوالد يأخذ كلّ وقتي

195
00:16:07,470 --> 00:16:10,700
سأترك أمر إبلاغ ذلك للفاتيكان
.بشكل ديبلوماسيّ لك أنت

196
00:16:13,230 --> 00:16:16,240
هل كونك والدًا... صعبٌ لتلك الدّرجة؟

197
00:16:16,650 --> 00:16:18,840
...حسنًا

198
00:16:19,530 --> 00:16:22,750
.لا أعرف ما معنى ذلك بالضّبط في الحقيقة

199
00:16:22,990 --> 00:16:25,770
انظر، أترى الأخوين النّائمين هناك؟

200
00:16:25,770 --> 00:16:27,970
يملك صاحب النّظّارات الّذي يسيل لعابه

201
00:16:28,250 --> 00:16:31,720
.قلبًا كبيرًا وهو مجتهد للغاية

202
00:16:31,920 --> 00:16:33,870
.لكنّه ضعيف ولا يأكل كثيرًا

203
00:16:33,870 --> 00:16:37,060
.تراه مرتعبًا دائمًا بسبب الشّياطين الّتي يراها

204
00:16:38,050 --> 00:16:41,270
.إنّ افتقاره للثّقة يُقلقني كثيرًا

205
00:16:41,510 --> 00:16:46,100
اقترحتُ أن يشدّ من أمره أكثر
.بأن يصير طارد أرواح معي

206
00:16:46,720 --> 00:16:50,200
إنّه يريد أن يصير قويًّا بما
.يكفي لحماية أخيه

207
00:16:50,350 --> 00:16:54,200
.لذلك اخترتُ عملاً كمعلّم لطرد الأرواح الشّرّيرة

208
00:16:55,020 --> 00:16:58,060
.إنّها الطّريقة الوحيدة لتعليمه

209
00:16:58,060 --> 00:17:00,040
.أفضّل أن أكون أنا من يدرّبه

210
00:17:00,940 --> 00:17:03,670
أمّا الأخ الآخر ذو المؤخّرة المكشوفة
،والّذي يسيل لعابه أكثر

211
00:17:04,610 --> 00:17:07,730
.هو أيضًا يهتمّ لأمر عائلته وليس فتى سيّئًا

212
00:17:07,730 --> 00:17:12,390
لكنّه يصير عنيفًا ويفقد السّيطرة
.عندما يغضب

213
00:17:12,460 --> 00:17:14,890
.يُكسبه ذلك الكثير من الأعداء

214
00:17:15,750 --> 00:17:20,580
تساءلتُ لوقت طويل إن كان عليّ تدريبه
.ليصير طارد أرواح مع يوكيو أيضًا

215
00:17:20,580 --> 00:17:23,270
،شغل ذلك السّؤال بالي كثيرًا

216
00:17:23,840 --> 00:17:24,770
.لكنّي عدلتُ عن الأمر

217
00:17:26,220 --> 00:17:29,320
.لذلك قرّرتُ تعليمه الطّبخ بدل ذلك

218
00:17:29,430 --> 00:17:32,990
لذلك السّبب كنتُ أتدرّب
...على الطّبخ، ولكن

219
00:17:33,060 --> 00:17:37,320
.أعتقد أنّي أنا من سيتعلّم أكثر بسبب هذا

220
00:17:39,190 --> 00:17:40,580
لماذا؟

221
00:17:45,080 --> 00:17:47,690
.يتطلّب الطّبخ جهدًا نفسيًّا وجسديًّا

222
00:17:47,690 --> 00:17:52,300
وعلى ممارسه أن يتعلّم التّحكّم
.ويفكّر دائمًا في من سيأكله طبخه

223
00:17:52,620 --> 00:17:56,450
.وأكثر شيء يُمتِعه هو إسعاد يوكيو

224
00:17:56,450 --> 00:17:59,800
.لا بأس إن لم يُمزج جيّدًا
.لقد أفسدتَ ذلك الوعاء

225
00:18:00,130 --> 00:18:04,060
!يحبّ يوكيو شرائح السّمك كثيرًا

226
00:18:23,080 --> 00:18:26,500
.من الرّائع جدًّا أنّ يوكيو ليس خائفًا من رين

227
00:18:32,740 --> 00:18:33,840
...ولكن

228
00:18:34,290 --> 00:18:37,970
ربّما لا مكان لديّ في المدرسة
...أو في المطبخ

229
00:18:38,120 --> 00:18:41,810
.ولكن من المستحيل الجزم بذلك بالكامل

230
00:18:41,960 --> 00:18:45,940
.لا أملك أيّ وقت لنفسي، وأنا أعاني الكثير

231
00:18:49,430 --> 00:18:50,980
،ولكن عندما أنظر إليهما

232
00:18:51,930 --> 00:18:55,450
.تختفي كلّ همومي

233
00:18:59,690 --> 00:19:01,370
...هكذا إذًا

234
00:19:04,360 --> 00:19:06,460
.حسنًا، عليّ الذّهاب الآن

235
00:19:07,400 --> 00:19:10,120
!أنا آسف، لقد ثرثرتُ كثيرًا

236
00:19:10,490 --> 00:19:11,470
!انتظر

237
00:19:11,700 --> 00:19:12,880
.خذ الباقي معك

238
00:19:13,950 --> 00:19:15,430
.شكرًا جزيلاً لك

239
00:19:15,540 --> 00:19:18,510
.هذا لا شيء. أعتمد عليك في إبلاغ الفاتيكان

240
00:19:18,870 --> 00:19:21,010
.حا... حاضر! أستأذن الآن

241
00:19:51,950 --> 00:19:53,040
!يا أبتي

242
00:19:56,040 --> 00:19:57,220
.شكرًا لك

243
00:20:06,380 --> 00:20:09,810
.هذا لا شيء. لا داعي للشّكر

244
00:20:15,100 --> 00:20:16,560
...كنتُ خائفًا

245
00:20:16,930 --> 00:20:18,200
...طوال هذا الوقت

246
00:20:19,520 --> 00:20:21,080
،من أنّ معرفة الحقيقة

247
00:20:23,150 --> 00:20:25,250
...ستُدمّر كلّ شيء

248
00:20:27,320 --> 00:20:28,540
...وأنّي

249
00:20:29,190 --> 00:20:31,380
.سأندمُ لأنّي وُلدت

250
00:20:39,330 --> 00:20:40,970
!يا لي من غبيّ

251
00:20:41,370 --> 00:20:43,770
...كلٌّ من أبي وأمّي

252
00:20:43,880 --> 00:20:46,560
!ضحّيا بكلّ شيء حتّى أعيش

253
00:20:48,800 --> 00:20:52,170
...حتّى أبناء ساتان... حتّى أنا

254
00:20:52,170 --> 00:20:55,000
.كلّ واحد منّا... جميعنا سنموت يومًا ما

255
00:20:55,000 --> 00:20:58,560
...وحتّى ذلك الحين
.نملك الحقّ لنعيش فحسب

256
00:20:59,470 --> 00:21:00,740
...كونا أخوين

257
00:21:01,640 --> 00:21:03,820
جيّدين لبعضكما، مفهوم؟

258
00:21:04,520 --> 00:21:06,970
،صحيح أنّها تصرّفت بغباء

259
00:21:06,970 --> 00:21:10,000
.لكنّها ظنّت أنّ بإمكانها مصادقة ذلك الشّيطان

260
00:21:10,150 --> 00:21:13,710
...والآن، لنرَ إن كنت تستطيع أنت النّجاح

261
00:21:14,740 --> 00:21:17,550
...أعتقد أنّ البشر والشّياطين

262
00:21:18,080 --> 00:21:19,590
!بإمكانهم فهم بعضهم

263
00:21:30,380 --> 00:21:32,400
!لديّ يوكيو

264
00:21:38,390 --> 00:21:39,820
...ويوكيو

265
00:21:40,970 --> 00:21:42,410
!لديه أنا

266
00:21:46,060 --> 00:21:47,510
...ومهما حدث

267
00:21:47,510 --> 00:21:48,490
أخي؟

268
00:21:56,700 --> 00:21:58,420
!لن أخذله أبدًا

269
00:23:34,890 --> 00:23:39,850
.شكرًا على المشاهدة