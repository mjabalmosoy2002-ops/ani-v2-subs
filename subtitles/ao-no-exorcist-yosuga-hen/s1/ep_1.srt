1
00:00:00,890 --> 00:00:06,980
الحلقة 1   [شيرو ويوري]

2
00:00:29,580 --> 00:00:31,420
...هذا هو

3
00:00:31,420 --> 00:00:33,760
الماضي؟

4
00:00:49,440 --> 00:00:51,980
منذ متى وهو خلفي؟

5
00:00:54,560 --> 00:00:57,620
إنّه الرّاهب الّذي تعرفه في المستقبل
.باسم فوجيموتو شيرو

6
00:00:57,620 --> 00:00:59,870
مفيستو؟ هل تبعتني؟

7
00:00:59,870 --> 00:01:00,910
.لا

8
00:01:00,910 --> 00:01:06,250
.أنا هو أنا قبل 40 سنة من وقتك

9
00:01:06,250 --> 00:01:09,290
أنت تمزح، صحيح؟
.إنّك تبدو مثلما تبدو عليه الآن

10
00:01:09,290 --> 00:01:14,090
إنّ وعاء شيطان لا يشيخ
.حتّى إن كان يتداعى

11
00:01:14,090 --> 00:01:15,390
...ناهيك عن ذكر

12
00:01:15,790 --> 00:01:18,090
!أنّني ملك الوقت

13
00:01:18,090 --> 00:01:22,140
،قد يتغيّر جسدي المادّيّ
.لكنّ هويّتي تظلّ كما هي

14
00:01:22,140 --> 00:01:24,940
.ولا يهمّ في أيّ نقطة من الوقت ستكون فيها

15
00:01:26,510 --> 00:01:29,940
.بالتّالي، سأرشدك في وقت فراغي

16
00:01:30,310 --> 00:01:32,530
...إنّ هذه الرّحلة بالذّات

17
00:01:32,530 --> 00:01:36,740
.ستنتهي بمّأساة، ومن الأفضل ألاّ تنسى ذلك

18
00:01:38,940 --> 00:01:40,490
.حسنًا

19
00:01:46,280 --> 00:01:47,460
أين نحن؟

20
00:01:47,460 --> 00:01:50,460
.لا الزّمان ولا المكان مختلفات كثيرًا

21
00:01:50,460 --> 00:01:53,130
هذا هو الحيّ الشّماليّ لبلدة
.أكاديميّة الصّليب الحقيقيّ

22
00:01:53,130 --> 00:01:55,760
.منطقة الإيجار المنخفض

23
00:01:57,210 --> 00:01:59,550
،كانت مليئة بالأطلال قبل أربعين سنة

24
00:01:59,550 --> 00:02:04,310
وكانت منطقة خطيرة يسكنها
.المتشرّدون والمجرمون

25
00:02:06,800 --> 00:02:08,350
!يوري

26
00:02:08,720 --> 00:02:11,020
!لا تتجوّلي في هذا المكان ليلاً

27
00:02:11,020 --> 00:02:12,230
!حان وقت العشاء

28
00:02:12,230 --> 00:02:13,520
!قادمة

29
00:02:14,810 --> 00:02:16,780
أقال يوري؟

30
00:02:23,690 --> 00:02:25,210
!مستحيل

31
00:02:30,490 --> 00:02:32,680
.ستُعرف لاحقًا باسم يوري إغين

32
00:02:32,950 --> 00:02:35,840
.إنّها أمّكما أنت وأوكومورا-سينسي

33
00:02:35,840 --> 00:02:37,380
!عـ-عرفتُ ذلك

34
00:02:37,380 --> 00:02:42,600
بالمناسبة، حاول رجاءً ألاّ تتدخّل
.في حياة الأشخاص من الماضي

35
00:02:43,170 --> 00:02:47,520
،لن يؤدّي ذلك لأيّ مفارقة زمنيّة
.لكنّه سيؤدّي إلى بعض الارتباك

36
00:02:48,470 --> 00:02:53,240
لا أفهم ماذا تعني، لكن لا يفترض
.بي التّدخّل، صحيح؟ مفهوم

37
00:02:53,850 --> 00:02:55,770
.هذا جيّد

38
00:02:56,930 --> 00:03:00,570
لا يجب عليك التّجوّل في الخارج
.بعد حلول الظّلام يا يوري-تشان

39
00:03:00,570 --> 00:03:04,410
معها حقّ. ثمّة العديد من الأوغاد
.الخطيرين في الأرجاء

40
00:03:04,410 --> 00:03:08,000
لا تلوميني إن عدت وقد فقعوا
.إحدى عينيك مثل أوبابا

41
00:03:10,240 --> 00:03:12,630
!إنّني لا أمانع ذلك في الحقيقة

42
00:03:12,630 --> 00:03:15,750
!صرتُ أبدو رائعة مثل القراصنة

43
00:03:19,710 --> 00:03:21,510
!هذا لا يدعو للضّحك

44
00:03:22,460 --> 00:03:24,430
.لن يكون البشر مشكلة كبيرة

45
00:03:24,430 --> 00:03:28,770
لكن هنالك مخلوقات فظيعة
.تخرّج بعد حلول الظّلام

46
00:03:28,970 --> 00:03:33,100
كنتما أنت وأوبابا طاردي أرواح شرّيرة، صحيح؟

47
00:03:33,100 --> 00:03:35,490
أنا لا أخاف من الوحوش، مفهوم؟

48
00:03:36,640 --> 00:03:40,400
!الوحوش مخيفة أكثر من البشر يا يوري

49
00:03:40,400 --> 00:03:43,820
!لأنّ الوحوش هي ما تُرينا إيّاه أرواح البشر

50
00:03:43,820 --> 00:03:44,780
!لا مشكلة

51
00:03:44,780 --> 00:03:49,700
،رأيتُ كرة نار زرقاء قبل أيّام
!ولم يخفني ذلك إطلاقًا

52
00:03:50,530 --> 00:03:52,790
كرة... نار زرقاء؟

53
00:03:52,790 --> 00:03:54,080
!عجبًا

54
00:03:54,080 --> 00:03:57,290
!لا بدّ أنّها رينكا

55
00:03:57,290 --> 00:03:58,340
رينكا؟

56
00:03:58,340 --> 00:04:01,760
ألسنة اللّهب المشؤومة
.الّتي شوهدت في جميع أنحاء العالم

57
00:04:01,760 --> 00:04:06,180
،"يسمّيها لبعض "أرواح الموتى
."ويسمّيها آخرون "نار الجحيم

58
00:04:06,180 --> 00:04:07,810
.إنّها لغز

59
00:04:07,810 --> 00:04:09,470
.كم هذا فظيع

60
00:04:09,470 --> 00:04:14,230
حتّى أنّ البعض يقول أنّها غوبلين
.أو جنّيّات أو ثعالب متنكّرة مؤقّتًا

61
00:04:14,230 --> 00:04:15,810
فعلاً؟

62
00:04:15,810 --> 00:04:17,360
!كم هذا رائع

63
00:04:17,360 --> 00:04:19,900
!أريد أن أصير صديقة لها

64
00:04:19,900 --> 00:04:21,320
!أوبابا

65
00:04:21,320 --> 00:04:23,570
!أتمنّى ألاّ تتحدّثي عن أمور مثل هذه

66
00:04:23,570 --> 00:04:25,210
!ستحوّلينها إلى غريبة أطوار مثلك

67
00:04:26,440 --> 00:04:29,920
!كون المرء غريب أطوال ممتع جدًّا

68
00:04:34,780 --> 00:04:37,920
.سنضطرّ إلى إرسالها إلى المدرسة قريبًا

69
00:04:37,920 --> 00:04:40,500
مرّ الوقت بسرعة، صحيح؟

70
00:04:40,500 --> 00:04:45,510
كعك مقلاة الشّبح"
"السّميك جدًّا

71
00:04:40,830 --> 00:04:45,510
في ذلك اليوم الّذي أحضرتها معك
...كرضيعة من ساحة خردة

72
00:04:45,510 --> 00:04:47,980
!لم أعرف ما العمل وقتها

73
00:04:49,050 --> 00:04:50,230
.نعم

74
00:04:51,550 --> 00:04:56,060
أوكو-تشان، لا تزال تملك رخصة
طرد الأرواح الشّرّيرة، صحيح؟

75
00:04:56,060 --> 00:04:58,200
لماذا لا تعود للعمل؟

76
00:04:59,520 --> 00:05:04,280
،ليت نظري كان أفضل من هذا
.لكنتُ خرجتُ للعمل أيضًا

77
00:05:05,060 --> 00:05:08,740
أعتقد أنّ الوقت حان لأن تبدآ
.أنتما على الأقل بعيش حياة محترمة

78
00:05:08,740 --> 00:05:10,920
.مثل تأجير منزل أو ما شابه

79
00:05:12,360 --> 00:05:13,910
.لن يحدث ذلك

80
00:05:14,110 --> 00:05:17,260
.استطعتُ تربيتها لأنّكما كنتما إلى جانبي

81
00:05:17,740 --> 00:05:19,050
...إضافة لذلك

82
00:05:19,490 --> 00:05:22,470
.الوضع ممتع أكثر بوجودنا معًا جميعًا

83
00:05:29,380 --> 00:05:32,180
.تبدو سعيدة جدًّا. حمدًا على ذلك

84
00:05:32,510 --> 00:05:35,060
.لنتقدّم بالوقت أكثر قليلاً

85
00:05:40,010 --> 00:05:41,900
!ماذا؟! اختفت الأرض

86
00:05:41,900 --> 00:05:43,690
!صه! إنّها هي

87
00:05:44,390 --> 00:05:47,200
!سنلعب اليوم بيت بيوت

88
00:05:47,200 --> 00:05:48,660
"!طرق، طرق"

89
00:05:48,660 --> 00:05:49,950
"!مرحبًا"

90
00:05:49,950 --> 00:05:53,240
"!مرحبًا بك في منزلي وشكرًا على الزّيارة"

91
00:05:53,240 --> 00:05:55,450
".كنت أوشك على شرب القهوة"

92
00:05:55,450 --> 00:05:57,540
"هلاّ انتظرت قليلاً؟"

93
00:05:57,540 --> 00:05:59,380
".لا داعي لإتعاب نفسك"

94
00:05:59,380 --> 00:06:00,460
"!حسنًا"

95
00:06:00,740 --> 00:06:03,460
...سكب، سكب، سكب

96
00:06:03,460 --> 00:06:05,800
!مهلاً، هذا حزين للغاية

97
00:06:05,800 --> 00:06:07,800
!أعطها أصدقاء بسرعة

98
00:06:07,800 --> 00:06:11,220
أليس هذا ما يفعله الأطفال عادة؟

99
00:06:12,300 --> 00:06:13,220
...والآن

100
00:06:22,640 --> 00:06:24,190
رينكا؟

101
00:06:24,350 --> 00:06:25,480
.إنّه ساتان

102
00:06:26,400 --> 00:06:29,200
في هذا الوقت، كان ساتان يُعرف
...باسم رينكا إضافة لأسماء أخرى

103
00:06:29,360 --> 00:06:32,910
.وكلّ ما كان يفعله هو الظّهور والاختفاء

104
00:06:33,820 --> 00:06:35,340
ما الّذي تفعله؟

105
00:06:36,700 --> 00:06:39,290
انتهيت! ما رأيك؟

106
00:06:40,790 --> 00:06:43,540
!كم هذا مذهل

107
00:06:48,500 --> 00:06:49,680
وماذا عن هذا؟

108
00:06:56,170 --> 00:06:57,890
إنّه يلعب معها؟

109
00:06:57,890 --> 00:06:59,360
.ذلك ما يبدو

110
00:06:59,890 --> 00:07:03,150
بالطّبع لم يكن يملك ساتان
...أيّ أنا خاصّ به الآن

111
00:07:03,350 --> 00:07:06,940
لذلك لا يمكن الجزم أنّه كان
.يعلم أنّه يلعب معها أم لا

112
00:07:07,140 --> 00:07:11,570
على الأقلّ، لا بدّ أنّ هذا
.هو أوّل تفاعل ذكيّ له

113
00:07:07,520 --> 00:07:09,950
!كم هذا رائع

114
00:07:11,980 --> 00:07:13,160
!يوري

115
00:07:13,160 --> 00:07:14,620
!المكان خطير هنا

116
00:07:14,620 --> 00:07:15,910
!لا يمكنك اللّعب هنا

117
00:07:15,910 --> 00:07:17,250
!حاضرة

118
00:07:18,740 --> 00:07:20,010
!إلى اللّقاء

119
00:07:23,120 --> 00:07:24,540
ماذا كنت تفعلين؟

120
00:07:24,540 --> 00:07:26,050
.ألعب بيت بيوت

121
00:07:26,580 --> 00:07:29,380
.ستُدفنين حيّة إن انهارت عليك الخردة

122
00:07:29,380 --> 00:07:33,560
،لكن هنالك أشياء عديدة هنا
!لذلك أستمتع كثيرًا

123
00:07:36,590 --> 00:07:38,390
.لننتقل للأمام

124
00:07:44,300 --> 00:07:45,450
حريق؟

125
00:07:46,720 --> 00:07:48,280
...أليس

126
00:07:49,230 --> 00:07:50,780
...أوكو-تشان

127
00:07:52,280 --> 00:07:54,040
!أ-أوكو-تشان

128
00:07:54,310 --> 00:07:55,620
!نيكو-تشان

129
00:07:55,620 --> 00:07:56,780
!أوبابا

130
00:07:57,530 --> 00:07:59,540
!أنت تعترضين الطّريق! ابقي بعيدة

131
00:08:01,410 --> 00:08:05,340
!أوكو-تشان

132
00:08:09,830 --> 00:08:12,880
سمعتُ أنّهم عثروا على ثلاثة
.جثث محترقة بالكامل

133
00:08:13,210 --> 00:08:16,390
كانوا مجرّد متشرّدين تصرّفوا
بتهوّر ثانية، صحيح؟

134
00:08:16,390 --> 00:08:18,310
!أتمنّى أن يتوقّف هذا

135
00:08:24,340 --> 00:08:25,900
!هذا حزين جدًّا

136
00:08:26,260 --> 00:08:27,060
!انتظر

137
00:08:27,470 --> 00:08:30,320
!لا تذهب لمساعدتها

138
00:08:31,810 --> 00:08:33,110
.المعذرة

139
00:08:33,110 --> 00:08:35,320
هلاّ أعطيتني بعض الطّعام رجاءً؟

140
00:08:35,320 --> 00:08:39,080
"كشك غيوزا"

141
00:08:35,320 --> 00:08:39,080
"غيوزا نباتيّة"
"غيوزا الكاري"

142
00:08:35,520 --> 00:08:39,080
!اذهبي! لا تقتربي من هنا
!يا لك من شقيّة متّسخة

143
00:08:40,330 --> 00:08:42,830
!اذهبي لمكان آخر إن لم يكن لديك مال

144
00:08:56,170 --> 00:08:57,440
!لقد فُتح

145
00:09:04,230 --> 00:09:08,230
"بيرة الصّليب الحقيقيّ"

146
00:09:08,680 --> 00:09:10,230
!إنّه منزل أحد ما

147
00:09:11,060 --> 00:09:12,480
.سرير

148
00:09:12,480 --> 00:09:14,490
"طبّ يامادا الدّاخليّ"

149
00:09:12,730 --> 00:09:14,490
.كتب صعبة

150
00:09:15,230 --> 00:09:17,990
.مجلاّت وصفتها نيكو-تشان بالقذرة دائمًا

151
00:09:15,560 --> 00:09:17,990
"إيرو إيرو"
"الملك العظيم"

152
00:09:17,990 --> 00:09:19,580
"رامن رقم 3"

153
00:09:26,160 --> 00:09:30,250
!أنا آسفة

154
00:09:30,250 --> 00:09:32,000
"رامن البطاطس"

155
00:10:04,650 --> 00:10:05,870
...أنت

156
00:10:06,570 --> 00:10:09,300
ما الّذي تفعلينه بالتّسلّل إلى منزلي؟

157
00:10:10,280 --> 00:10:12,010
!سأقتلك

158
00:11:52,140 --> 00:11:53,560
العجوز؟

159
00:11:54,430 --> 00:11:56,060
!مذهل

160
00:11:56,390 --> 00:11:58,230
!واضح لي أنّه هو

161
00:12:01,730 --> 00:12:03,660
.أنا آسفة

162
00:12:04,020 --> 00:12:05,620
.اسمي يوري

163
00:12:06,110 --> 00:12:10,290
،فقدتُ عائلتي كلّها
.لذلك لم يعد لديّ مكان ألجأ إليه

164
00:12:10,290 --> 00:12:11,540
ومن يهتمّ؟

165
00:12:11,540 --> 00:12:13,790
!لا تظنّي أنّ بإمكانك كسب تعاطفي

166
00:12:13,790 --> 00:12:15,790
!غادري المكان قبل أن أقتلك

167
00:12:15,790 --> 00:12:18,340
!تبًّا، أكلتِ الكيس بأكمله

168
00:12:18,340 --> 00:12:21,550
!لكن إن خرجتُ الآن، فسأموت من البرد

169
00:12:23,040 --> 00:12:24,800
.موتي إذًا

170
00:12:24,960 --> 00:12:26,980
.لا علاقة لذلك بي أنا

171
00:12:29,670 --> 00:12:33,650
....يـ-يـ-يـ

172
00:12:33,980 --> 00:12:35,560
!يوكي-أوتوكو

173
00:12:35,890 --> 00:12:36,940
ماذا؟

174
00:12:36,940 --> 00:12:38,440
...كانت أوبابا تقول

175
00:12:38,440 --> 00:12:43,200
أنّ اليوكي-أوتوكو هم رجال ثلج لونهم
!أبيض ناصع وضخام وباردون ومخيفون

176
00:12:43,520 --> 00:12:47,870
تبدو كذلك تمامًا! بإمكانك تركي
!هنا حتّى يتوقّف الثّلج على الأقلّ

177
00:12:47,870 --> 00:12:49,870
!كم أنت لئيم

178
00:12:50,150 --> 00:12:52,200
وبماذا سيفيدني ذلك؟

179
00:12:52,200 --> 00:12:54,460
!هذا مخبئي أنا الّذي بنيتُه بنفسي

180
00:12:54,460 --> 00:12:56,710
!لا يوجد متّسع لأشخاص آخرين فيه

181
00:12:57,280 --> 00:12:58,210
بماذا سيفيدك؟

182
00:12:58,540 --> 00:13:00,050
...بخصوص مجلاّتك المنحرفة هذه

183
00:13:01,090 --> 00:13:02,340
!لا تنظري إليها

184
00:13:02,340 --> 00:13:03,630
أنت تحبّها، صحيح؟

185
00:13:03,630 --> 00:13:04,720
!اخرسي

186
00:13:04,720 --> 00:13:08,930
!أعرف أين يمكنك إيجاد العديد منها

187
00:13:08,930 --> 00:13:12,270
سآخذك إلى هناك عندما يتوقّف
!تساقط الثّلج في الصّباح

188
00:13:12,270 --> 00:13:13,930
!لذلك دعني أظلّ هنا حتّى ذلك الوقت

189
00:13:14,090 --> 00:13:17,230
موافق؟ سيفيدك ذلك، صحيح؟
ما قولك؟

190
00:13:17,230 --> 00:13:18,100
صحيح؟

191
00:13:18,100 --> 00:13:22,650
صحيح؟ صحيح؟ صحيح؟

192
00:13:20,350 --> 00:13:22,650
!تبًّا! لا بأس

193
00:13:23,020 --> 00:13:24,950
.بإمكانك البقاء هنا حتّى الصّباح

194
00:13:25,810 --> 00:13:28,250
من الأفضل أن تكون هنالك
!مجلاّت بصدور كبيرة

195
00:13:28,570 --> 00:13:29,670
صدور كبيرة؟

196
00:13:29,900 --> 00:13:31,950
.هذا محرج

197
00:13:32,400 --> 00:13:33,500
...مهلاً

198
00:13:33,500 --> 00:13:35,960
!لقد اختفى مفيستو

199
00:13:42,040 --> 00:13:44,640
.الجوّ بارد جدًّا

200
00:13:48,790 --> 00:13:50,010
ماذا هناك؟

201
00:13:50,010 --> 00:13:53,270
.سنشعر بالدّفء إن اقتربنا من بعض
ألم تكن تعرف ذلك؟

202
00:13:53,270 --> 00:13:55,980
أو ربّما أنت لا تشعر بالدّفء
لأنّك يوكي-أوتوكو؟

203
00:13:55,980 --> 00:13:59,230
من تنعتين بـ"يوكي-أوتوكو"؟
ما خطبك يا صغيرة؟

204
00:14:00,180 --> 00:14:03,980
.في الحقيقة... ربّما أشبه يوكي-أوتوكو

205
00:14:04,270 --> 00:14:06,370
.فأنا لستُ بشريًّا أيضًا

206
00:14:09,360 --> 00:14:10,920
!أنت دافئ

207
00:14:11,150 --> 00:14:14,290
.قد تكون يوكي-أوتوكو، لكنّك دافئ

208
00:14:20,490 --> 00:14:24,100
.أمّي... بدأت تذكّرني بشيمي

209
00:14:24,870 --> 00:14:27,010
.هذا معقّد جدًّا

210
00:14:28,790 --> 00:14:32,730
."قالت "قد تكون يوكي-أوتوكو، لكنّك دافئ

211
00:14:33,920 --> 00:14:35,480
...يوكيو

212
00:14:39,220 --> 00:14:41,980
.لا تصدر أيّ صوت أثناء الاقتراب
!علينا الإمساك به مهما كلّف الأمر

213
00:14:45,230 --> 00:14:46,530
!كلاّ

214
00:14:52,940 --> 00:14:54,450
!عثرنا عليك

215
00:14:54,450 --> 00:14:56,870
!حان الوقت لتستسلم يا شيرو

216
00:14:58,200 --> 00:14:59,870
!مفهوم

217
00:15:00,950 --> 00:15:02,630
.يا له من مخبأ

218
00:15:02,870 --> 00:15:05,880
أكنت تتوارى عن الأنظار هنا
في كلّ مرّة تهرب فيها منّا؟

219
00:15:07,410 --> 00:15:10,880
،حتّى بين مجموعة عزازيل
.أنت الوحيد الّذي يقوم بمثل هذه الأمور

220
00:15:11,670 --> 00:15:12,560
...حسنًا

221
00:15:13,130 --> 00:15:14,640
من هذه الفتاة؟

222
00:15:15,210 --> 00:15:19,480
لا تسألني. إنّها مجرّد فتاة
.متشرّدة اقتحمت منزلي

223
00:15:19,480 --> 00:15:21,390
لقد سمعتْ محادثتنا، صحيح؟

224
00:15:21,390 --> 00:15:23,100
—لكنّها لا تزال

225
00:15:23,100 --> 00:15:25,820
،قالت أنّها يتيمة
.لذلك لن تتحدّث مع أيّ أحد

226
00:15:25,820 --> 00:15:27,450
كـ-كلب؟

227
00:15:29,060 --> 00:15:30,200
...أنت

228
00:15:30,200 --> 00:15:32,750
بإمكانك رؤية هذا الكلب الأسود؟

229
00:15:33,060 --> 00:15:34,170
ماذا؟

230
00:15:35,190 --> 00:15:38,290
،إن كان بإمكانها رؤية الشّياطين
.فستختلف القصّة تمامًا

231
00:15:38,290 --> 00:15:40,210
...سنأويها في الملجأ في الوقت الحاليّ

232
00:15:40,210 --> 00:15:42,170
.وسنتكشف من تكون

233
00:15:53,630 --> 00:15:55,680
الملجأ؟

234
00:15:56,420 --> 00:15:59,680
ما ذلك المكان؟ أهو مكان جيّد؟

235
00:16:00,510 --> 00:16:02,690
.إنّه مكان سيّئ وفظيع

236
00:16:03,220 --> 00:16:04,400
...أعتقد

237
00:16:04,640 --> 00:16:06,610
.أنّك تعيسة الحظّ فحسب

238
00:16:24,820 --> 00:16:27,800
.كنتُ وحيدًا بالكامل عندما كنت طفلاً

239
00:16:28,790 --> 00:16:31,970
...لم أعرف أبدًا كيف أتحكّم بمشاعري أو قوّتي

240
00:16:32,250 --> 00:16:34,840
لذلك انتهى بي المطاف ألحق
.الأذى بالآخرين كثيرًا

241
00:16:34,840 --> 00:16:38,060
.وقبل أن أدرك، صار الجميع خائفًا منّي

242
00:16:39,550 --> 00:16:42,480
...لكنّ يوكيو كان معي

243
00:16:42,480 --> 00:16:45,980
.ومنحني العجوز مكانًا أسمّيه منزلي

244
00:16:47,010 --> 00:16:51,480
.كنتُ محظوظًا جدًّا بامتلاكي لذلك

245
00:16:52,810 --> 00:16:54,240
...لا أدري

246
00:16:54,240 --> 00:16:56,490
.ما هي الوحدة الحقيقيّة

247
00:16:57,440 --> 00:16:58,490
...لذلك

248
00:16:58,980 --> 00:17:01,490
...ما شعرت به أمّي

249
00:17:01,490 --> 00:17:04,500
...تلك الوحدة وقتها
...تلك الوحدة الّتي شعرت بها

250
00:17:05,370 --> 00:17:07,500
.لا يمكنني تخيّل أيّ من ذلك

251
00:17:26,680 --> 00:17:28,650
هذا هو الملجأ إذًا؟

252
00:17:29,310 --> 00:17:31,150
إنّه مظلم قليلاً، صحيح؟

253
00:17:33,810 --> 00:17:36,030
لكنّ هذه هي مدرسة طرد
!الأرواح الشّرّيرة الخاصّة

254
00:17:36,690 --> 00:17:40,280
!إذًا فقد كانت تُدعى "الملجأ" قبل 40 سنة

255
00:17:40,610 --> 00:17:42,540
.شكرًا على عملكم الجادّ

256
00:17:42,540 --> 00:17:46,710
هذه هي الطّفلة الّتي طلبتُ منكم
.إيواءها بشكل مؤقّت قبل قليل

257
00:17:46,710 --> 00:17:48,040
.سنستقبلها عندنا

258
00:17:48,530 --> 00:17:50,250
ما اسمك أيّتها الصّغيرة؟

259
00:17:50,250 --> 00:17:51,840
...ما...؟ أ

260
00:17:51,840 --> 00:17:53,210
.اسمي يوري

261
00:17:53,210 --> 00:17:54,390
واسمك العائليّ؟

262
00:17:54,750 --> 00:17:56,060
...أنا لا

263
00:17:58,050 --> 00:17:58,980
.لا بأس

264
00:17:59,540 --> 00:18:01,100
.تعالي معي يا يوري-سان

265
00:18:01,100 --> 00:18:02,850
.عليك تنظيف نفسك أوّلاً

266
00:18:02,850 --> 00:18:05,680
لا يمكنني السّماح لك بأن تأوي
.للفراش وأنت متّسخة هكذا

267
00:18:05,680 --> 00:18:07,940
.شيرو، ستأتي أنت معنا –
!مهلاً –

268
00:18:09,060 --> 00:18:11,560
!عـ-عفوًا! إلى أيّ تذهب؟

269
00:18:12,060 --> 00:18:14,110
.ستأتين أنت معنا –
!مهلاً! مهلاً –

270
00:18:19,440 --> 00:18:21,870
.أنهينا بحثنا عن ماضيك

271
00:18:21,870 --> 00:18:23,540
"تقرير تحقيق عن الماضي"

272
00:18:22,230 --> 00:18:24,290
!اسمك يوري إغين

273
00:18:25,370 --> 00:18:29,620
كانت عائلة إغين أعضاءً من تكتّل ثريّ
.في السّابق، لكنّهم أفلسوا بعد أنّ تمّ حلّه

274
00:18:29,620 --> 00:18:33,380
،يبدو أنّ أفراد العائلة قد انتشروا
.ووالدتك متوفّاة

275
00:18:33,380 --> 00:18:36,920
.والدك غير معروف
.بتعبير آخر، أنت وحيدة وبلا حيلة

276
00:18:36,920 --> 00:18:40,010
.بالتّالي، سنقبل بك في الملجأ بشكل رسميّ

277
00:18:40,010 --> 00:18:42,100
.لا يمكنني قراءة هذا

278
00:18:42,100 --> 00:18:43,520
هل من أسئلة؟

279
00:18:43,960 --> 00:18:45,390
...أسئلة

280
00:18:45,920 --> 00:18:49,690
عفوًا، أيّ نوع من الأماكن يكون هذا الملجأ؟

281
00:18:49,690 --> 00:18:53,940
إنّه مؤسّسة يتمّ فيها حماية
.الأطفال الموهوبين مثلك

282
00:18:54,180 --> 00:18:56,690
ماذا تقصدين بموهوبين؟

283
00:18:56,690 --> 00:18:59,150
.من يملكون الموهبة ليصيروا طاردي أرواح شرّيرة

284
00:18:59,150 --> 00:19:00,570
طاردي أرواح؟

285
00:19:00,570 --> 00:19:01,700
.صحيح

286
00:19:01,700 --> 00:19:07,330
بدءًا من اليوم، ستتلقّين تعليمًا
.هنا لتصيري طاردة أرواح شرّيرة

287
00:19:07,330 --> 00:19:08,710
...تعليم

288
00:19:09,950 --> 00:19:13,970
.سنضطرّ إلى إرسالها إلى المدرسة قريبًا

289
00:19:15,040 --> 00:19:17,760
أهذا المكان مدرسة؟

290
00:19:17,760 --> 00:19:19,770
.بإمكانك اعتباره كذلك

291
00:19:21,380 --> 00:19:22,680
...في هذه المؤسّسة

292
00:19:23,380 --> 00:19:24,930
.عليك الاستيقاظ في السّادسة صباحًا

293
00:19:24,930 --> 00:19:27,180
.وبعد تسجيل الحضور، يتمّ تنظيف المساكن

294
00:19:27,630 --> 00:19:30,940
تبدأ الدّروس الإجباريّة بعد الفطور
.من الثّامنة صباحًا للثّانية بعد الظّهر

295
00:19:31,340 --> 00:19:37,440
ومن الثّانية للخامسة عصرًا، ستتلقّين تعليمًا
.وتدريبًا لتصيري طاردة أرواح شرّيرة

296
00:19:38,020 --> 00:19:41,450
وسيكون هنالك تدريب حتّى
.العاشرة ليلاً بعد العشاء

297
00:19:41,730 --> 00:19:43,450
.تُطفأ الأنوار في الحادية عشرة ليلاً

298
00:19:43,770 --> 00:19:46,700
لن يُسمح لك بمغادرة المنشأة
.في معظم الأحيان

299
00:19:53,780 --> 00:19:57,170
.كان أوكو-تشان وأوبابا طاردَيْ أرواح

300
00:19:57,170 --> 00:20:01,720
،إن صرتُ طاردة أرواح أيضًا
.أراهن أنّ أوكو-تشان سيغضب

301
00:20:02,000 --> 00:20:04,060
.لكنّ أوبابا ستكون سعيدة على الأرجح

302
00:20:04,290 --> 00:20:06,020
...أمّا نيكو-تشان

303
00:20:08,050 --> 00:20:10,100
!اخرسي

304
00:20:10,100 --> 00:20:11,940
لماذا تضحكين؟

305
00:20:11,940 --> 00:20:13,560
!إنّك تشتّتين انتباهي، لا يمكنني النّوم

306
00:20:13,560 --> 00:20:14,730
.آسفة

307
00:20:15,350 --> 00:20:18,650
.إنّ الأغلبيّة يبكون في أوّل يوم لهم هنا

308
00:20:18,650 --> 00:20:20,900
أتعانين من خلل في رأسك أو ما شابه؟

309
00:20:20,900 --> 00:20:22,360
لماذا يبكون؟

310
00:20:22,360 --> 00:20:23,200
ماذا؟

311
00:20:23,200 --> 00:20:26,240
.لـ-لأنّ التّدريب صعب جدًّا

312
00:20:26,240 --> 00:20:27,490
.هكذا إذًا

313
00:20:27,900 --> 00:20:31,120
لكنّي استمتعتُ بوقتي أثناء
!دراستي عن الشّياطين

314
00:20:31,950 --> 00:20:33,750
ماذا قلت؟

315
00:20:34,160 --> 00:20:35,800
!سرّني سماع هذا

316
00:20:37,080 --> 00:20:40,920
عندما تصيرين طاردة أرواح، فستحصلين
.على عمل، وستصيرين حرّة بعدها

317
00:20:40,920 --> 00:20:45,510
،وإذا اعتبروك مؤهّلة بشكل خاصّ
.فيمكنك أن تصيري متدرّبة، وهم النّخبة

318
00:20:45,510 --> 00:20:47,100
متورّدين؟

319
00:20:47,100 --> 00:20:48,520
!متدرّبين

320
00:20:48,760 --> 00:20:50,690
،إن صرت واحدة منهم
.سيمنحونك غرفتك الخاصّة

321
00:20:51,010 --> 00:20:53,770
.وسمعتُ أنّ الاختلاف في المرتّبات كبير جدًّا

322
00:20:54,220 --> 00:20:58,020
ولسبب ما، الفتيات أكثر عرضة
!للاختيار، فحظًّا سعيدًا لك

323
00:20:58,350 --> 00:21:00,400
،إن كان هنالك ما لا تعرفينه
.يمكنك أن تسأليني

324
00:21:00,400 --> 00:21:03,030
.أنا الأكبر سنًّا في هذه الغرفة

325
00:21:03,230 --> 00:21:04,700
.شكرًا لك

326
00:21:08,190 --> 00:21:13,330
عفوًا، ثمّة فتى ناصع البياض
في هذه المنشأة، صحيح؟

327
00:21:13,330 --> 00:21:15,120
.يبدو مثل يوكي-أوتوكو

328
00:21:15,120 --> 00:21:16,460
مثل رجل ثلج؟

329
00:21:16,460 --> 00:21:20,050
.نعم. أعتقد أنّ اسمه شيرو

330
00:21:20,330 --> 00:21:23,050
.لا، لا يبدو ذلك مألوفًا لي

331
00:21:23,050 --> 00:21:24,470
هكذا إذًا؟

332
00:21:27,170 --> 00:21:32,060
،يشبه هذا المكان الجيش
.لكن أعتقد أنّها استقرّت الآن

333
00:21:32,510 --> 00:21:34,440
!تشجّعي يا أمّي

334
00:21:38,730 --> 00:21:40,650
.رأيتُ هذا المكان من قبل

335
00:21:41,220 --> 00:21:42,150
.تفضّل

336
00:21:45,730 --> 00:21:47,450
.أحضرته إليه

337
00:21:47,450 --> 00:21:50,370
.شكرًا على عملك الجادّ
.بإمكانك الانصراف

338
00:21:50,370 --> 00:21:51,580
!حاضر

339
00:21:53,440 --> 00:21:54,580
...والآن

340
00:21:54,860 --> 00:21:56,580
...إنّك من مجموعة عزازيل

341
00:21:56,740 --> 00:21:59,460
...موضوع التّجارب رقم إس أو 004

342
00:21:59,460 --> 00:22:01,460
اسمك شيرو-كُن، صحيح؟

343
00:23:34,970 --> 00:23:39,980
الحلقة القادمة
[الحقيقة]