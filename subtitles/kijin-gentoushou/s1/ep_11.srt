1
00:00:16,420 --> 00:00:18,380
أظنّني اعتدتُ الأمر

2
00:00:19,420 --> 00:00:22,170
...ما عُدتُ أتردّد في ذبح الشياطين، ولكن

3
00:00:22,500 --> 00:00:26,540
كلّما أرديتُ أحدهم، أشعر أنَّ هذا السيف يتدنّسُ بالدماء

4
00:00:29,920 --> 00:00:33,790
لا، بل فؤادي هو ما يتدنّس

5
00:01:03,540 --> 00:01:07,830
Rise-KuN :محاكاة

6
00:01:31,660 --> 00:01:35,870
Rise-KuN :كارا

7
00:02:12,620 --> 00:02:14,380
شكرًا جزيلًا

8
00:02:14,770 --> 00:02:16,560
هذا مبلغٌ يسيرٌ لا يَفيكَ حقّكَ

9
00:02:19,000 --> 00:02:23,580
ثلج، قمر في الخريف، وزهور في الربيع

10
00:02:23,580 --> 00:02:28,330
كان سيّدي يحبّ هذه الأجواء الشاعريّة

11
00:02:28,830 --> 00:02:33,960
لا شكَّ أنّه سيسعدُ إن بنيتُ له قبرًا وقدمتُ له الساكي الّذي يُحبه

12
00:02:35,830 --> 00:02:38,790
أستأذنكَ الآن، لكَ خالص امتناني

13
00:02:51,460 --> 00:02:54,250
أبي، عليكَ التقليل من الشُّرب

14
00:02:54,460 --> 00:02:56,580
لا بأس بهذا القدر

15
00:02:56,650 --> 00:02:58,200
!نادرًا ما أحصل على يوم عطلةٍ كهذا

16
00:02:58,280 --> 00:02:59,500
!هيّا، شاركيني بالشُّرب

17
00:02:59,580 --> 00:03:02,330
أمتنع عن ذلك في وضح النهار

18
00:03:07,170 --> 00:03:12,670
إذن، اختفى السيّد الساموراي وكلّ من في القصر فجأةً؟

19
00:03:12,790 --> 00:03:17,040
أجل، واتخذه اثنا عشر شيطانًا أو نحو ذلك وكرًا لهم

20
00:03:17,040 --> 00:03:19,170
!يبدو أنّها كانت ليلةً حافلةً

21
00:03:19,350 --> 00:03:22,920
!عفوًا، سأحمل الأمتعة عنك، لا بدَّ أنّكَ مُتعب

22
00:03:23,290 --> 00:03:26,580
لا عليكِ، فهذا احتفال خاصّ

23
00:03:28,290 --> 00:03:30,290
أجل، بالطبع

24
00:03:30,290 --> 00:03:32,210
!تفضّلوا أيّها السادة

25
00:03:32,380 --> 00:03:37,540
!"أطلتُ عليكم، وصل ساكي "بقايا الثلج

26
00:03:37,710 --> 00:03:39,960
!رشفة واحدة تسلب الألباب

27
00:03:39,960 --> 00:03:44,880
!وكوب واحد يعرج بك إلى السماء، وإن شربته طوال العمر فلن تعود أبدًا

28
00:03:44,880 --> 00:03:50,920
!"أمزح بالطبع، اغتنموا الفرصة وتذوّقوا "بقايا الثلج

29
00:03:50,920 --> 00:03:52,130
!أعطني ثلاثًا، ثلاث زجاجات

30
00:03:52,290 --> 00:03:53,250
!وأنا كذلك

31
00:03:52,290 --> 00:03:53,250
ساكي؟

32
00:03:53,250 --> 00:03:55,080
!أريد خمس زجاجات

33
00:03:53,250 --> 00:03:55,080
!يبدو أنَّ له شعبيةً كبيرةً

34
00:03:55,080 --> 00:03:56,330
هل نشتري القليل؟

35
00:03:56,330 --> 00:04:00,080
لا، أفضّل عدم حشر نفسي في تلك الجلبة

36
00:04:00,080 --> 00:04:04,790
معك حقّ، لا تزال لدينا تحضيرات، لذا لنتابع السير

37
00:04:04,790 --> 00:04:07,080
!لا تتدافعوا، سأموت

38
00:04:08,630 --> 00:04:10,380
!يا للبرد

39
00:04:12,960 --> 00:04:15,250
أستميحكم عذرًا

40
00:04:15,250 --> 00:04:16,130
أهلًا

41
00:04:16,130 --> 00:04:17,580
تأخّرت

42
00:04:17,580 --> 00:04:21,880
المعذرة أيّتها الآنسة، انشغلتُ بالعمل

43
00:04:21,880 --> 00:04:25,920
حسنٌ، أنت نجم الليلة، لذا لا بأس

44
00:04:25,920 --> 00:04:28,130
لم يتبقَّ سوى ميورا-ساما

45
00:04:29,000 --> 00:04:30,130
!ناوتسوغو

46
00:04:30,970 --> 00:04:32,500
أعتذر عن التأخير

47
00:04:32,500 --> 00:04:34,750
أعتذر عن دعوتكَ اليوم

48
00:04:35,210 --> 00:04:38,000
يبدو أنَّ العدد اكتمل، هل نبدأ؟

49
00:04:40,420 --> 00:04:43,550
حسنٌ، أعتذر لتكلفكم عناء المجيء من أجلي اليوم

50
00:04:43,670 --> 00:04:46,000
مضت عشر سنوات مُنذ قدومي إلى متجر سوغايا

51
00:04:46,000 --> 00:04:47,960
وفّر كلامك

52
00:04:48,250 --> 00:04:49,920
أنتِ قاسية أيّتها الآنسة

53
00:04:50,290 --> 00:04:52,210
!حسنٌ، سأختصر كلامي

54
00:04:53,920 --> 00:04:58,880
!يسعدني أن أعلن أنّني أصبحتُ مسؤولًا عن متجر سوغايا

55
00:04:59,170 --> 00:05:03,880
أشكركم من صميم قلبي على إقامة هذا الحفل

56
00:05:04,080 --> 00:05:06,460
مبارك لكَ يا زينجي-سان

57
00:05:06,630 --> 00:05:08,830
شكرًا لكِ يا أوفو-سان

58
00:05:09,170 --> 00:05:12,880
مباركٌ لك، احرص على دعم جوزو-دونو جيّدًا

59
00:05:13,000 --> 00:05:15,250
!اعتمد عليّ

60
00:05:15,580 --> 00:05:18,040
سأجعل متجر سوغايا أكبر وأعظم

61
00:05:18,420 --> 00:05:21,080
أتمنّى لكَ مزيدًا من النجاح يا زينجي-دونو

62
00:05:21,080 --> 00:05:24,500
أجل، راقبوا براعتي في الإدارة

63
00:05:24,710 --> 00:05:26,420
!بدأ يغترّ بنفسه فورًا

64
00:05:26,420 --> 00:05:29,250
أيّتها الآنسة، دعيني أشعر بالرضا اليوم على الأقل

65
00:05:29,250 --> 00:05:30,750
إنّها الحقيقة

66
00:05:30,960 --> 00:05:32,750
حسنٌ، اكتفيا بهذا القدر

67
00:05:34,790 --> 00:05:36,790
أطلتُ عليكم، تفضّلوا

68
00:05:38,140 --> 00:05:39,920
!حساء دجاج ساخن

69
00:05:39,920 --> 00:05:43,000
الصوبا وحدها لا تكفي في مناسبةٍ كهذه

70
00:05:43,210 --> 00:05:45,500
مبارك لكَ هذه الترقية

71
00:05:45,500 --> 00:05:48,630
ممتنّ لكَ أيّها السيّد

72
00:05:49,130 --> 00:05:50,590
لدينا هذا أيضًا

73
00:05:51,720 --> 00:05:52,510
تفضّل

74
00:05:55,290 --> 00:05:56,540
!شكرًا لكِ

75
00:05:58,790 --> 00:06:01,330
أليس هذا ساكي كوداريزاكي فاخر؟

76
00:06:01,330 --> 00:06:03,540
كيف حصلتم على ساكي فاخر كهذا؟

77
00:06:03,540 --> 00:06:06,080
جينيا-كن هو من أحضره

78
00:06:07,040 --> 00:06:08,790
حسنٌ، فهذه مناسبة خاصّة

79
00:06:11,050 --> 00:06:13,130
ستجعلني أبكي من الفرح

80
00:06:13,580 --> 00:06:15,040
سأشربه بامتنان

81
00:06:15,460 --> 00:06:17,920
حسنٌ، كلوا قبل أن يبرد الطعام

82
00:06:36,580 --> 00:06:38,960
صحيح، كدت أنسى

83
00:06:43,000 --> 00:06:44,210
ما هذا؟

84
00:06:45,750 --> 00:06:47,830
إنّه الساكي الرائج مؤخّرًا

85
00:06:47,830 --> 00:06:50,630
كان يشربه السيّد كلّ ليلةٍ ويقول إنّه لذيذ

86
00:06:50,920 --> 00:06:52,120
أبي؟

87
00:06:52,290 --> 00:06:55,790
أجل، فكّرت أن نشربه جميعًا اليوم

88
00:06:55,960 --> 00:06:57,290
بقايا الثلج"؟"

89
00:06:57,290 --> 00:06:59,290
أجل، هل تعرفه يا جينيا؟

90
00:06:59,540 --> 00:07:01,580
شربه باردًا هو الأفضل

91
00:07:01,580 --> 00:07:03,000
استخدم هذا

92
00:07:03,460 --> 00:07:04,920
شكرًا لكِ

93
00:07:05,210 --> 00:07:07,290
حسنٌ، لنرى كيف طعمه

94
00:07:07,630 --> 00:07:09,500
آنستي؟

95
00:07:09,880 --> 00:07:12,460
هذا احتفال، لذا لا بأس بذلك أحيانًا

96
00:07:14,620 --> 00:07:18,000
لم أتخيّل أن يأتي يومٌ تسكب لي فيه الآنسة الساكي

97
00:07:18,130 --> 00:07:19,880
يا لها من حياةٍ مديدة

98
00:07:20,130 --> 00:07:22,000
لستَ عجوزًا إلى هذا الحدّ

99
00:07:22,250 --> 00:07:24,460
إنّه مجرّد شعور

100
00:07:24,460 --> 00:07:28,830
...يا له من أمر مؤثر، هذه الآنسة المشاكسة

101
00:07:29,040 --> 00:07:31,420
سأتجاهل ما قلته للتوّ

102
00:07:31,630 --> 00:07:32,790
آسف

103
00:07:39,710 --> 00:07:42,170
مهلًا، ما الّذي تفعله؟

104
00:07:42,170 --> 00:07:43,590
!ما هذا؟

105
00:07:43,830 --> 00:07:47,630
!حارّ ونتن وقويّ، لا يمكن شربه

106
00:07:47,630 --> 00:07:48,960
هل أنتَ بخير؟

107
00:07:47,630 --> 00:07:48,960
أستميحكم عذرًا

108
00:07:48,960 --> 00:07:50,670
هل أحضر لكَ الماء؟

109
00:07:55,960 --> 00:08:00,290
!إنّه قويّ حقًّا، وليس لذيذًا البتّة

110
00:08:00,420 --> 00:08:03,290
بئس الأمر، أُفسد الجوّ تمامًا

111
00:08:03,500 --> 00:08:06,250
!حسنٌ، لا تلمني على ذلك

112
00:08:06,540 --> 00:08:08,920
صحيح، جرّبه أنتَ أيضًا

113
00:08:10,330 --> 00:08:11,170
تفضّل

114
00:08:14,880 --> 00:08:18,000
ليس سيئًا، لكنّه خفيف

115
00:08:18,130 --> 00:08:20,000
أتسمّي هذا خفيفًا؟

116
00:08:20,000 --> 00:08:22,080
هل هذا الساكي الّذي يتحدث عنه الجميع؟

117
00:08:22,080 --> 00:08:24,790
إنّه ما يشربه السيّد بلا شكّ

118
00:08:25,130 --> 00:08:28,710
حسنٌ، لا يزال لدينا الكثير من الساكي

119
00:08:28,710 --> 00:08:30,170
لنتابع الشُّرب

120
00:08:30,170 --> 00:08:31,790
ما رأيكم ببعض الساشيمي؟

121
00:08:32,290 --> 00:08:33,250
!فكرة رائعة

122
00:08:34,000 --> 00:08:36,380
من الجيّد أنَّ الجميع لطفاء

123
00:08:36,380 --> 00:08:39,580
أنتِ الوحيدة القاسية هنا أيّتها الآنسة

124
00:08:39,790 --> 00:08:41,830
أقول لكَ؛ كُنْ مُمتنًّا

125
00:08:42,880 --> 00:08:44,330
!انتبه

126
00:08:52,000 --> 00:08:53,750
أتشرب مجدّدًا؟

127
00:08:54,480 --> 00:08:56,020
وما المشكلة في ذلك؟

128
00:08:56,420 --> 00:08:59,170
أبي، قلّل من الشُّرب قليلًا

129
00:08:59,170 --> 00:09:02,880
!أطبقِ فمكِ! لا بأس بهذا القدر

130
00:09:09,170 --> 00:09:11,960
أهلًا بالرونين، الجوّ بارد

131
00:09:12,500 --> 00:09:14,080
أبحث عن عمل

132
00:09:14,460 --> 00:09:18,790
عجبًا! هل أنتَ مُحاصر لدرجة أنّكَ لا تستطيع تبادل أطراف الحديث؟

133
00:09:21,080 --> 00:09:22,250
أمزح معك

134
00:09:23,170 --> 00:09:28,000
لا أدري إن كان هذا سيفيدك، لكنّي أسمع شائعات غريبة

135
00:09:28,210 --> 00:09:34,880
،مثل ابن مريض استُبدل بشيطان، أو شياطين تتجمّع تحت الجسر

136
00:09:35,250 --> 00:09:37,580
وامرأة تتجوّل في منتصف الليل

137
00:09:38,330 --> 00:09:39,830
هذا كثير للغاية

138
00:09:40,630 --> 00:09:41,790
أنتِ محقّة

139
00:09:42,130 --> 00:09:44,280
حسنٌ، العالم مضطرب

140
00:09:44,470 --> 00:09:47,530
...ربّما الجميع يشعر بالقلق

141
00:09:47,880 --> 00:09:51,960
بسبب السفن البخارية الّتي أيقظتْ سُباتنا الطويل

142
00:09:52,250 --> 00:09:54,040
تقصدين السفن السوداء في أوراغا؟

143
00:09:54,500 --> 00:09:57,960
تخضع الحكومة لإملاءات الأجانب

144
00:09:58,250 --> 00:10:01,170
حين تضطرب قلوب البشر تستشري الشياطين

145
00:10:01,630 --> 00:10:03,750
أظنّ الأمر كذلك

146
00:10:04,000 --> 00:10:06,540
هل يريدون الشُّرب للنسيان؟

147
00:10:06,540 --> 00:10:09,460
يبدو أنَّ ساكي "بقايا الثلج" يباع بكثرةٍ

148
00:10:10,000 --> 00:10:12,290
يتفاخر الزبائن به أمامي دائمًا

149
00:10:12,500 --> 00:10:14,500
ألم يذكروا شيئًا عن طعمه؟

150
00:10:15,290 --> 00:10:19,580
قالوا إنّه ساكي فاخر يعرجُ بكَ إلى السماء

151
00:10:21,130 --> 00:10:24,960
(مُومِس)

152
00:10:21,130 --> 00:10:24,960
ياتاكا، هلّا تحرّيتِ عن "بقايا الثلج" أيضًا؟

153
00:10:25,540 --> 00:10:26,360
ما الأمر؟

154
00:10:26,410 --> 00:10:27,710
هل ثمّة خطب ما؟

155
00:10:28,790 --> 00:10:32,330
لا أدري، إن لم يكن هناك شيء فلا بأس

156
00:10:34,050 --> 00:10:35,710
حسنٌ، لا مانع لديّ

157
00:10:36,210 --> 00:10:37,040
أنتِ خير عونٍ

158
00:10:37,670 --> 00:10:42,080
لكن لا تتهوّري، إن أصابكِ مكروه فسيحقد عليّ ناوتسوغو

159
00:10:44,040 --> 00:10:46,460
أنتَ أيضًا تمزح إذن

160
00:10:49,620 --> 00:10:51,460
لا عجب أنَّ الجوّ بارد

161
00:11:10,380 --> 00:11:11,230
!وجدتك

162
00:11:13,580 --> 00:11:14,420
ناتسو؟

163
00:11:14,790 --> 00:11:18,330
صباح الخير، رغم أنّنا في الظهيرة

164
00:11:18,460 --> 00:11:20,170
كيف عرفتِ مكاني؟

165
00:11:20,250 --> 00:11:22,540
أخبرتني أوفو-سان

166
00:11:22,750 --> 00:11:24,720
تسكن في مكانٍ كهذا إذن

167
00:11:25,010 --> 00:11:26,580
إنّه قريب منّا

168
00:11:27,040 --> 00:11:29,380
...كان بإمكانكَ إخباري، لسنا غرباء أو ما شابـ

169
00:11:29,380 --> 00:11:30,630
!طفح الكيل

170
00:11:30,910 --> 00:11:31,690
!أطبقِ فمكِ

171
00:11:31,910 --> 00:11:34,070
!اذهبي واشتري لي المزيد من الخمر

172
00:11:39,000 --> 00:11:41,170
مـ-ما كان ذلك؟

173
00:11:41,290 --> 00:11:46,000
الأسرة المجاورة، يبدو أنَّ الأب يشرب الساكي منذ وضح النهار مجدّدًا

174
00:11:46,960 --> 00:11:48,380
ساكي؟

175
00:11:48,540 --> 00:11:50,290
إذن، ما الّذي أتى بكِ؟

176
00:11:52,670 --> 00:11:55,580
لديّ طلب صغير

177
00:11:56,730 --> 00:11:57,670
!طارت

178
00:11:57,310 --> 00:11:58,300
!مُذهل

179
00:11:58,580 --> 00:11:59,670
زينجي؟

180
00:12:01,210 --> 00:12:06,040
لا يعمل مؤخّرًا، بل يقضي وقته في حانة نيهونباشي

181
00:12:06,710 --> 00:12:09,460
!رغم أنّنا احتفلنا بترقيته مؤخرًا

182
00:12:10,000 --> 00:12:14,830
ظَلَّ على هذه الحال منذ اليوم التالي، لا يفعلُ شيئًا سِوى الشُّرب ليل نهار

183
00:12:15,450 --> 00:12:17,940
قال والدي إنّه لن يتغاضى عن هذا بعد الآن

184
00:12:18,250 --> 00:12:20,460
إذن، ما المطلوب منّي؟

185
00:12:21,170 --> 00:12:24,710
أخشى دخول الحانة وحدي بصراحةٍ

186
00:12:25,290 --> 00:12:27,420
لن أشعر بالخوف إن كنت معي

187
00:12:29,420 --> 00:12:32,710
أرجوك، سأدفع لكَ إن أردت

188
00:12:34,290 --> 00:12:35,630
لا حاجة لي بالمال

189
00:12:36,210 --> 00:12:37,720
قلتِ في نيهونباشي، أليس كذلك؟

190
00:12:47,330 --> 00:12:49,330
!رائحة الساكي نتنة

191
00:12:53,210 --> 00:12:58,460
أهلًا بالآنسة، هل من خدمة؟

192
00:13:02,040 --> 00:13:03,710
!أيّ خدمة؟

193
00:13:03,760 --> 00:13:06,880
!تترك المتجر وتأتي لتسكر في مكان كهذا

194
00:13:07,430 --> 00:13:09,370
وما الضير في ذلك؟

195
00:13:09,510 --> 00:13:13,520
!هلا كففتِ عن النباح مثل الجراء؟

196
00:13:14,040 --> 00:13:16,580
هذا سبب بقائكِ عزباء

197
00:13:16,710 --> 00:13:22,000
حسنٌ، لا أحد يرغب بامرأة غير ظريفة مثلكِ

198
00:13:27,580 --> 00:13:30,080
...زينجي، أنت

199
00:13:31,280 --> 00:13:33,160
ما زلتِ هنا؟

200
00:13:33,230 --> 00:13:35,080
!يا للإزعاج

201
00:13:35,420 --> 00:13:37,080
اغربي عن وجهي

202
00:13:37,330 --> 00:13:38,920
لنكتفِ بهذا القدر

203
00:13:39,750 --> 00:13:41,380
!لا تتدخّل

204
00:13:41,630 --> 00:13:43,960
تجاوزتَ حدودكَ حتّى وإن كنت ثملًا

205
00:13:45,080 --> 00:13:47,850
مُجرّد رونين وضيع يتباهى بنفسه

206
00:13:48,240 --> 00:13:52,710
لم أطقك يومًا

207
00:13:52,830 --> 00:13:54,330
!توقّف يا زينجي

208
00:13:54,430 --> 00:13:55,790
أكثرت من الشُّرب

209
00:13:56,930 --> 00:13:59,040
!اخرس أيّها الوغد

210
00:14:08,000 --> 00:14:10,130
الساكي هِبةٌ من السماء

211
00:14:10,560 --> 00:14:15,150
حساب الخمر بمقدارٍ جفاءٌ وقِلّةُ ذوقٍ، لكنَّ العربدة تصرفٌ مخزٍ

212
00:14:15,210 --> 00:14:17,460
!أنتَ! تماديتَ كثيرًا

213
00:14:17,880 --> 00:14:19,460
لا أظنّ ذلك

214
00:14:22,790 --> 00:14:25,040
من الأفضل أن يتقيّأ هذا

215
00:14:26,420 --> 00:14:29,420
يا هذا، أتتحدّانا؟

216
00:14:29,420 --> 00:14:31,080
!لن نغفر لك

217
00:14:31,080 --> 00:14:32,210
!أجل، أجل

218
00:14:32,790 --> 00:14:35,420
مـ-مهلًا، ما هذا؟

219
00:14:38,460 --> 00:14:39,540
...جينيا

220
00:14:40,040 --> 00:14:42,830
أغمضي عينيكِ، سينتهي الأمر فورًا

221
00:14:43,040 --> 00:14:44,630
!أغلق فمك

222
00:14:47,300 --> 00:14:47,960
!خذ هذا

223
00:15:13,130 --> 00:15:15,170
زينجي! زينجي! هل أنتَ بخير؟

224
00:15:15,290 --> 00:15:16,210
!زينجي

225
00:15:16,800 --> 00:15:18,420
فقد وعيه فحسب

226
00:15:18,730 --> 00:15:19,960
فقد وعيه فحسب، لا داعي للقلق

227
00:15:21,500 --> 00:15:22,790
شكرًا لك

228
00:15:23,170 --> 00:15:27,290
!لكنّك... متهوّر حقًّا

229
00:15:27,500 --> 00:15:29,250
تلقّيتُ مُساعدةً

230
00:15:30,920 --> 00:15:34,630
لم أكن مضطرًّا للمساعدة

231
00:15:36,330 --> 00:15:38,920
وفّرتَ عليّ العناء، ممتنٌ لك

232
00:15:40,440 --> 00:15:44,130
لم تتغيّر أبدًا، كيف حالك؟

233
00:15:44,670 --> 00:15:47,830
مرّ وقت طويل يا أكيتسو سوميغورو

234
00:15:48,540 --> 00:15:50,670
الثالث

235
00:15:58,830 --> 00:16:03,210
عجبًا! لِمَ أنا هنا؟

236
00:16:05,420 --> 00:16:06,630
...آنستي

237
00:16:06,760 --> 00:16:09,250
زينجي، هل استيقظت؟

238
00:16:09,400 --> 00:16:11,540
...آ-آنستي

239
00:16:13,330 --> 00:16:15,250
لا ترهق نفسك بالنهوض

240
00:16:15,250 --> 00:16:16,790
...آنستي، أنا

241
00:16:17,080 --> 00:16:21,000
آسف، آسف حقًّا

242
00:16:21,960 --> 00:16:23,540
ما زلتَ تتألّم؟

243
00:16:24,110 --> 00:16:25,880
قليلًا

244
00:16:26,450 --> 00:16:30,210
كان عليه أن يرفقَ بكَ قليلًا

245
00:16:30,790 --> 00:16:32,170
حسنٌ، هذا مُستحيل

246
00:16:33,250 --> 00:16:34,710
آسف

247
00:16:34,770 --> 00:16:37,190
لا تعتذر، فلا أُبالي على أيّ حال

248
00:16:37,420 --> 00:16:40,710
!لكنّني قلت لكِ كلامًا فضيعًا

249
00:16:40,790 --> 00:16:41,840
ربّما

250
00:16:42,240 --> 00:16:44,880
لكنّك من قُلتها، أليس كذلك؟

251
00:16:45,080 --> 00:16:46,630
"هذا ليس الأهم"

252
00:16:52,040 --> 00:16:54,630
جرحتني قليلًا بالطبع

253
00:16:54,960 --> 00:16:56,630
لكنّني أعلم

254
00:16:57,360 --> 00:17:04,320
حتّى لو كان ذلك ما في قلبك، فأنا أعلم أنّكَ تهتمّ لأمري

255
00:17:05,310 --> 00:17:06,420
...آنستي

256
00:17:07,490 --> 00:17:10,280
لذا لا تبالِ بالأمر

257
00:17:10,830 --> 00:17:15,460
لستُ صغيرةً لآخذ كلام السكارى على محمل الجدّ

258
00:17:16,240 --> 00:17:21,130
مع ذلك اعذريني، لم أكن في وعيي

259
00:17:21,640 --> 00:17:25,500
!هذا صحيح، فقد هاجمتنا فجأةً

260
00:17:25,630 --> 00:17:28,920
كنتُ ثملًا بلا شكّ حينها

261
00:17:29,080 --> 00:17:34,330
شعرتُ بنشوة السكر، لكنّني لم أشعر بالرضا قطّ

262
00:17:34,330 --> 00:17:38,250
،وحين رأيتُ وجهكِ، شعرتُ بغضبٍ غريب

263
00:17:39,790 --> 00:17:43,920
وشعرتُ بكراهيةٍ شديدةٍ تُجاه جينيا

264
00:17:44,250 --> 00:17:46,380
لا أفهم ما حدث

265
00:17:46,540 --> 00:17:49,880
كفى يا زينجي، ارتح الآن

266
00:17:50,360 --> 00:17:51,820
...لكنّني

267
00:17:58,710 --> 00:17:59,480
!سيّدي

268
00:18:00,710 --> 00:18:03,500
سمعتُ أنّكَ أحدثتَ جلبة كبيرة

269
00:18:03,750 --> 00:18:05,250
أعتذر بشدّة

270
00:18:05,710 --> 00:18:08,000
إيّاكَ أن تُعيد الكرّة

271
00:18:14,320 --> 00:18:15,510
ما العمل؟

272
00:18:16,080 --> 00:18:18,960
عليكَ العمل بجدّ فحسب

273
00:18:22,960 --> 00:18:25,000
!أطبقِ فمكِ! لا تبكِ

274
00:18:25,380 --> 00:18:27,450
!أحضري لي الخمر

275
00:18:27,510 --> 00:18:29,040
!ما أطول بالهما

276
00:18:29,420 --> 00:18:33,170
سمعتُ شائعاتٍ عن الياشا ناحر الشياطين

277
00:18:33,330 --> 00:18:35,210
أنتَ مشهور، أليس كذلك؟

278
00:18:35,580 --> 00:18:37,680
إلى حدّ ما

279
00:18:38,030 --> 00:18:39,960
لِمَ كنت هناك؟

280
00:18:40,380 --> 00:18:43,460
في الواقع، وقعت حادثةٌ غريبةٌ اليوم

281
00:18:44,790 --> 00:18:47,830
أخ قتل أخاه الأصغر

282
00:18:47,830 --> 00:18:51,630
حسنٌ، لم أكن لأهتمّ لو كان هذا كلّ شيء

283
00:18:51,830 --> 00:18:55,040
لكن وقعت حوادث مشابهة تباعًا

284
00:18:55,650 --> 00:18:59,440
...بدا الأمر مريبًا، وحين تحرّيت عن الحادثة الأولى

285
00:18:59,560 --> 00:19:02,630
،وجدتُ أنَّ الأخ الأصغر اشترى ساكي نادرًا لأخيه

286
00:19:02,630 --> 00:19:05,080
وقُتل أثناء شربهما معًا

287
00:19:05,460 --> 00:19:08,840
وكلّ من هاجوا كانوا يشربون الساكي أيضًا

288
00:19:09,000 --> 00:19:13,660
وكان نفس الساكي القادم من إيدو

289
00:19:13,770 --> 00:19:15,670
أمر مُريب، أليس كذلك؟

290
00:19:17,850 --> 00:19:19,350
"بقايا الثلج"

291
00:19:19,630 --> 00:19:22,420
أبحث عن مصدره حاليًّا

292
00:19:27,880 --> 00:19:30,080
هل من خيوط أخرى؟

293
00:19:30,210 --> 00:19:37,000
حسنٌ، قبل وبعد الحادثة الّتي وقعتْ، شوهدتْ امرأةٌ غريبةٌ مِرارًا

294
00:19:37,080 --> 00:19:38,040
امرأة؟

295
00:19:38,290 --> 00:19:39,220
أجل

296
00:19:39,320 --> 00:19:43,930
لا تبدو مُناسبةً لجرائم الساكي، قد لا تكون لها علاقةٌ بالأمر

297
00:19:44,910 --> 00:19:48,700
بالمناسبة، كيف ستعرف مكان الساكي؟

298
00:19:48,990 --> 00:19:51,110
تهديدٌ بسيطٌ وسيتحدث دون شكّ

299
00:19:51,250 --> 00:19:54,540
أنتَ وحش حقًّا

300
00:20:01,540 --> 00:20:02,380
دماء

301
00:20:14,000 --> 00:20:15,750
!يا للهول

302
00:20:15,960 --> 00:20:19,040
إنّه صاحب المتجر الّذي رأيته سابقًا

303
00:20:19,290 --> 00:20:20,960
يا للقرف

304
00:20:21,130 --> 00:20:24,540
لا داعي لضربه بعد موته هكذا

305
00:20:24,750 --> 00:20:25,420
غير موجود

306
00:20:25,580 --> 00:20:26,380
ماذا؟

307
00:20:26,580 --> 00:20:29,500
"لا توجد زجاجة واحدة من "بقايا الثلج

308
00:20:29,710 --> 00:20:33,080
!لا يعني هذا أنّه نفد

309
00:20:34,380 --> 00:20:37,460
انظر، هذا المكان الوحيد السليم

310
00:20:38,040 --> 00:20:42,960
لا غبار عليه، أي أنَّ هذا الرفّ كان مُستخدمًا

311
00:20:44,380 --> 00:20:48,080
...المقتحمون لم يجدوا ضالّتهم

312
00:20:48,080 --> 00:20:50,380
لذا هاجوا ودمّروا المكان

313
00:20:50,670 --> 00:20:55,040
ثمّ وجدوه هنا أخيرًا، فحملوه بعنايةٍ

314
00:20:56,000 --> 00:20:58,330
"وهو "بقايا الثلج

315
00:20:59,250 --> 00:21:03,570
لكن، أيُزهقون روحًا لأجل بضع زجاجات ساكي فحسب؟

316
00:21:03,780 --> 00:21:07,790
إنّهم يسرقون ساكي يُفقد العقل

317
00:21:08,080 --> 00:21:09,960
لا تتوقّع منهم التعقّل

318
00:21:10,280 --> 00:21:11,920
أنتَ مُحقّ

319
00:21:13,250 --> 00:21:15,290
!انطلق يا طائري الورقي

320
00:21:22,380 --> 00:21:23,880
كان ذلك مُبهرًا

321
00:21:23,880 --> 00:21:25,210
إنّه سلاحٌ رائع

322
00:21:25,630 --> 00:21:26,630
ما رأيك؟

323
00:21:26,790 --> 00:21:30,290
ربّما جذبت رائحة الساكي الشياطين؟

324
00:21:30,760 --> 00:21:32,670
كلامُك هذا لا يبدو لي مزحةً إطلاقًا

325
00:21:42,150 --> 00:21:43,360
ثلج؟

326
00:21:44,130 --> 00:21:45,920
يتساقط كلّ ليلة مؤخّرًا

327
00:21:47,210 --> 00:21:47,960
...أجل

328
00:21:49,460 --> 00:21:50,790
يا لها من سماء بغيضة