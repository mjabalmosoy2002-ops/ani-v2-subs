1
00:01:30,560 --> 00:01:34,440
الخطوة 8
!د إ ي" تعني... لا يمكنك النّجاح؟ لا، بل يمكنك ذلك بكلّ تأكيد"

2
00:01:34,440 --> 00:01:37,060
.ها هي القطع الإضافيّة لليوم

3
00:01:34,440 --> 00:01:37,070
من صُنع بورين

4
00:01:35,240 --> 00:01:37,070
من صُنع جوبكو

5
00:01:37,060 --> 00:01:38,590
!هذا مذهل

6
00:01:38,590 --> 00:01:41,280
!جوبكو-تشان، تحضرين أشياء رائعة دائمًا

7
00:01:41,900 --> 00:01:43,670
!حسّك بالأناقة ممتاز

8
00:01:44,710 --> 00:01:48,070
.صـ-صحيح، نعم، أظنّ ذلك

9
00:01:48,540 --> 00:01:50,600
.بودينغ، أبليت حسنًا

10
00:01:52,330 --> 00:01:55,010
!أحضرت قطعًا صنعتها بنفسي أيضًا، مياو

11
00:01:55,830 --> 00:01:58,260
.لِمجيعها تفاصيل معقّدة جدًّا

12
00:01:58,560 --> 00:02:01,080
.هذا لأنّي استعمال طابعة ثلاثيّة الأبعاد

13
00:02:01,080 --> 00:02:03,250
!لديك طابعة ثلاثيّة الأبعاد؟

14
00:02:03,640 --> 00:02:05,840
.توجد واحدة في مدرستنا

15
00:02:06,150 --> 00:02:08,610
يمكنك استعمالها دون طلب الإذن هكذا؟

16
00:02:08,800 --> 00:02:12,950
حرصتُ على تجاوز الأمن عندما
!تسلّلت، لذلك سنكون بخير

17
00:02:12,950 --> 00:02:14,160
!أنت شينوبي

18
00:02:14,160 --> 00:02:16,620
."لا أدري كيف يمكن وصف بهذا "بخير

19
00:02:17,760 --> 00:02:22,120
.عـ-عفوًا، أحضرتُ قطعًا صنعتُها أنا أيضًا

20
00:02:22,120 --> 00:02:26,570
ما هي؟ ما هي؟ دبابيس؟ خواتم؟ قلائد؟

21
00:02:26,570 --> 00:02:29,970
.لا شيء من هذا القبيل

22
00:02:34,470 --> 00:02:38,330
أخذت المراييل الّتي حصلنا عليها
...من واكو واكو وان وان يومها

23
00:02:38,330 --> 00:02:42,960
وقمتُ.... ظننتُ أنّه سيكون من اللّطيف
.إن كان لنادي "د إ ي" زيّ رسميّ لارتدائه

24
00:02:46,520 --> 00:02:47,740
!تاكومين

25
00:02:47,740 --> 00:02:50,330
!إنّها تبدو رائعة

26
00:02:50,330 --> 00:02:51,400
!أبليتِ حسنًا

27
00:02:51,400 --> 00:02:54,010
.سرّني أنّها أعجبتكما

28
00:02:54,010 --> 00:02:57,070
!أسعدني هذا جدًّا، مياو! سأقدّره كثيرًا، مياو

29
00:02:57,170 --> 00:03:00,600
فــتــيــات عــبّــاد الــشّــمــس

30
00:02:57,390 --> 00:02:58,570
...هذا مثل

31
00:02:59,350 --> 00:03:01,410
...ما حدث في فتيات عبّاد الشّمس

32
00:03:02,830 --> 00:03:04,800
!صـ-صحيح

33
00:03:04,800 --> 00:03:09,980
تذكّرتُ عندما ارتدت كلّ فتيات نادي
!البستنة مراييلهنّ متشابهة

34
00:03:09,980 --> 00:03:12,760
!وجعلني ذلك أريد تجربة ذلك بنفسي

35
00:03:13,960 --> 00:03:17,080
!وصلتني مشاعرك بالكامل

36
00:03:17,080 --> 00:03:18,640
!شـ-شكرًا

37
00:03:18,640 --> 00:03:21,520
.لن نسمح لفتيات عبّاد الشّمس أن تهزمنا

38
00:03:21,520 --> 00:03:26,020
علينا نحن أيضًا أن نكون مثل عبّاد
!الشّمس ونتفتّح بأبهى طريقة

39
00:03:26,020 --> 00:03:27,020
!نعم

40
00:03:28,470 --> 00:03:31,450
.أ-أنا آسفة. لم أستطع كبح نفسي

41
00:03:33,220 --> 00:03:34,530
...حسنًا

42
00:03:34,530 --> 00:03:37,170
.لنراجع مداخيلنا ونفقاتنا اليوم

43
00:03:40,250 --> 00:03:43,650
.بيعت القطع الّتي وضعناها على الإنترنيت جيّدًا

44
00:03:43,650 --> 00:03:45,780
...مذهل

45
00:03:45,780 --> 00:03:46,620
...وأيضًا

46
00:03:46,620 --> 00:03:50,610
القطع الّتي وضعناها للبيع
.في محلّ واكو وان تُباع جيّدًا أيضًا

47
00:03:50,610 --> 00:03:53,540
.هذه قطع طريفة

48
00:03:53,840 --> 00:03:56,280
.إنّها تذكّرني بشبابي

49
00:03:56,580 --> 00:04:00,750
إن ارتديتُ هذه، هل ستجعل
قلب زوجي يرفرف قليلاً؟

50
00:04:01,430 --> 00:04:04,250
.إنّها محبوبة جدًّا لدى النّساء العجائز في الحيّ

51
00:04:04,560 --> 00:04:06,330
فعلاً؟

52
00:04:06,330 --> 00:04:11,590
وبهذا، جنينا ما مجموعه 40 ألفًا
.ابتداءً من البارحة

53
00:04:11,590 --> 00:04:13,370
!مذهل

54
00:04:13,370 --> 00:04:14,920
جنينا ذلك القدر سلفًا؟

55
00:04:14,920 --> 00:04:18,990
اليوم الّذي سنشتري فيها براغي
.التّثبيت على الأشجار وشيك

56
00:04:18,990 --> 00:04:21,740
!رحلة الألف ميل تبدأ بخطوة، مياو

57
00:04:23,660 --> 00:04:26,470
.مخبِؤنا السّرّيّ لم يعد مجرّد حلم

58
00:04:28,070 --> 00:04:31,620
والآن، علينا البدء بمناقشة تفاصيل
—معيّنة بشأن التّصميم و

59
00:04:30,360 --> 00:04:31,620
!يا رئيسة النّادي

60
00:04:31,620 --> 00:04:32,490
ماذا؟

61
00:04:32,490 --> 00:04:36,490
كم بيعت من القطع الّتي صنعتُ؟

62
00:04:37,060 --> 00:04:38,500
...حسنًا

63
00:04:38,500 --> 00:04:39,450
حسنًا...؟

64
00:04:39,830 --> 00:04:41,110
...عفوًا

65
00:04:45,450 --> 00:04:47,270
ولا واحدة، صحيح؟

66
00:04:48,790 --> 00:04:50,400
.لم تبلي حسنًا

67
00:04:51,180 --> 00:04:52,730
...ذلك

68
00:04:52,730 --> 00:04:56,800
ما هنالك يا سيروفو هو أنّ جودة
—ما صنعتِ كانت

69
00:04:57,440 --> 00:05:00,090
.تفرّدها كان كثيرًا على بعض النّاس ليتقبّلوه

70
00:05:00,990 --> 00:05:02,990
.لا، أعلم

71
00:05:03,460 --> 00:05:05,810
...كانت معووجة قليلاً

72
00:05:05,810 --> 00:05:07,920
...أو مشوّهة قليلاً

73
00:05:07,920 --> 00:05:10,830
...أو أنّ الصّمغ كان ظاهرًا قليلاً فيها

74
00:05:10,830 --> 00:05:11,740
قليلاً؟

75
00:05:13,190 --> 00:05:14,070
!والآن

76
00:05:14,070 --> 00:05:18,890
أريد الانتقال لمناقشة تفاصيل
.معيّنة عن مخطّط مخبئنا السّرّيّ

77
00:05:18,890 --> 00:05:22,480
تظاهرتِ أنّ لا شيء حدث وواصلتِ
.ما كنتِ تتحدّثين عنه سابقًا، مياو

78
00:05:23,010 --> 00:05:25,970
.سـ-سيروفو-سان، لا بأس

79
00:05:25,970 --> 00:05:28,430
.واثقة أنّها ستُباع أيضًا

80
00:05:28,700 --> 00:05:32,210
...صحيح! ربّما إن خفّضنا سعرها قليلاً

81
00:05:33,270 --> 00:05:34,510
.نعم

82
00:05:34,510 --> 00:05:39,020
.شكرًا لمواساتك لي يا تاكومين

83
00:05:39,850 --> 00:05:43,280
ماذا نفعل لنتقدّم في مخطّطاتنا؟

84
00:05:43,280 --> 00:05:47,160
علينا اكتشاف أيّ نوع
،من القواعد السّرّيّة نريد بناءه

85
00:05:47,160 --> 00:05:50,280
.ثمّ نستعمل تلك الفكرة لرسم مخطّط له

86
00:05:50,670 --> 00:05:53,390
تقصدين أن نضع مسودّة؟

87
00:05:54,910 --> 00:05:59,500
بشكل عمليّ، إنّه شيء يتمّ القيام به
،وفق قرارات مبنيّة على المكان

88
00:05:59,500 --> 00:06:01,630
.لكنّ ذلك شيء يقوم به المحترفون

89
00:06:01,890 --> 00:06:05,200
،نحن لن نبنيه بهدف بيعه

90
00:06:05,200 --> 00:06:08,270
.ولا يحتاج ليكون دقيقًا في أصغر قياساته

91
00:06:08,270 --> 00:06:10,680
الحجم وفهم شامل بالموادّ المطلوبة

92
00:06:10,680 --> 00:06:14,970
وترتيب البناء... سيساعدنا المخطّط
.كثيرًا لتحديد كلّ ذلك

93
00:06:14,970 --> 00:06:15,930
.هذا صحيح

94
00:06:18,090 --> 00:06:21,860
...بشأن التّصميم

95
00:06:21,860 --> 00:06:25,140
ما رأيكنّ أن ندع سيروفو-سان
أن تجمع بين أفكار الجميع؟

96
00:06:26,410 --> 00:06:27,740
أنا؟

97
00:06:27,740 --> 00:06:32,770
،نعم. أنت بارعة في الرّسم
.لذلك أظنّ أنّك ستكونين مثاليّة

98
00:06:32,770 --> 00:06:35,450
!فهمت. هذا صحيح

99
00:06:35,450 --> 00:06:37,450
!موافقة

100
00:06:37,450 --> 00:06:42,830
إنّ مساعدة سيروفو بعدما لم تُبع أيّ من
.قطعها يجعلك شخصًا لطيفًا يا تاكومين

101
00:06:42,830 --> 00:06:46,210
!كـ-كلاّ، هذا ليس مسعاي

102
00:06:46,210 --> 00:06:48,110
ما رأيك يا سيروفو-سان؟

103
00:06:52,920 --> 00:06:54,960
!نعم! سأبذل قصارى جهدي

104
00:06:57,440 --> 00:07:00,590
،حسنًا بما أنّنا سندع سيروفو مسؤولة عن التّصميم

105
00:07:01,140 --> 00:07:03,600
فأيّ نوع من المخابئ السّرّيّة نريد؟

106
00:07:03,600 --> 00:07:05,210
.باشرن بالحديث إن كان لكنّ أيّ رأي

107
00:07:05,210 --> 00:07:06,390
!تفضّلن

108
00:07:06,610 --> 00:07:08,730
.أريد أرجوحة، مياو

109
00:07:08,730 --> 00:07:11,630
!ولتكن طويلة لتمنح شعورًا وكأنّه معلّقة في السّماء

110
00:07:11,630 --> 00:07:14,360
!أرجوحة... ممتاز

111
00:07:14,360 --> 00:07:17,690
أودّ أنّ نكون قادرات على النّظر
.للمناظر حولنا وشرب الشّاي

112
00:07:18,080 --> 00:07:20,250
ربّما نضع منضدة أو ما شابه قرب النّافذة؟

113
00:07:20,250 --> 00:07:22,830
!منضدة... ممتاز

114
00:07:22,830 --> 00:07:25,020
.دعونا لا ننسى أرجوحة استلقاء

115
00:07:25,020 --> 00:07:27,620
!أرجوحة استلقاء... ممتاز

116
00:07:27,620 --> 00:07:31,570
.سيكون من الجميل لو كان له مدخنة
.بغرض التّزيين فحسب بالطّبع

117
00:07:31,570 --> 00:07:33,970
!مدخنة... ممتاز

118
00:07:34,250 --> 00:07:38,080
أريد أن أجرّب التّأرجح من بكرة
.على سطح المخبأ السّرّيّ

119
00:07:38,080 --> 00:07:39,400
...بكرة

120
00:07:39,400 --> 00:07:41,350
ماذا عن نافذة في السّقف؟

121
00:07:41,740 --> 00:07:45,590
!قد يكون ذلك رائعًا
.مع أنّ من الصّعب بناؤها

122
00:07:46,140 --> 00:07:47,970
...نافذة في السّقف

123
00:07:47,970 --> 00:07:50,720
.نحتاج لمنصّة هبوط طائرة مسيّرة

124
00:07:50,720 --> 00:07:51,900
فعلاً؟

125
00:07:51,900 --> 00:07:54,370
...طائرة مسيّرة

126
00:07:54,750 --> 00:07:58,670
كما نحتاج أيضًا لباب دوّار سرّيّ
مكان لإخفاء سيف، صحيح؟

127
00:07:58,670 --> 00:08:00,380
هل سنبني قصرًا للنّينجا؟

128
00:08:00,380 --> 00:08:02,210
...باب دوّار سرّيّ

129
00:08:02,210 --> 00:08:03,010
...مخبأ لسيف

130
00:08:03,010 --> 00:08:04,400
.لا تحتاجين لتدوين ذلك

131
00:08:04,400 --> 00:08:08,080
صحيح! سيكون من الرّائع
لو أمكنه التّحوّل، صحيح؟

132
00:08:08,080 --> 00:08:10,130
!سيكون ذلك رائعًا، مياو

133
00:08:10,130 --> 00:08:11,710
!لا تتحمّسا كثيرًا

134
00:08:11,710 --> 00:08:13,170
!المعذرة

135
00:08:13,180 --> 00:08:15,430
تصميم منزل الشّجر

136
00:08:13,180 --> 00:08:15,430
أرجوحة

137
00:08:13,180 --> 00:08:15,430
منضدة

138
00:08:13,180 --> 00:08:15,430
بهدف شرب الشّاي هناك

139
00:08:13,180 --> 00:08:15,430
أرجوحة استلقاء

140
00:08:13,180 --> 00:08:15,430
مدخنة

141
00:08:13,180 --> 00:08:15,430
(للتّزيين)

142
00:08:13,180 --> 00:08:15,430
التّأرجح من بكرة

143
00:08:13,180 --> 00:08:15,430
نافذة سقف

144
00:08:13,180 --> 00:08:15,430
طائرة مسيّرة

145
00:08:13,180 --> 00:08:15,430
سيف     باب سرّيّ

146
00:08:13,180 --> 00:08:15,430
تحوّل

147
00:08:14,260 --> 00:08:15,430
.حسنًا

148
00:08:15,430 --> 00:08:18,360
لدينا كلّ الأفكار الّتي كانت
في أذهان الجميع، صحيح؟

149
00:08:18,560 --> 00:08:20,280
!حسنًا

150
00:08:20,280 --> 00:08:22,180
!أنا أشتعل حماسة الآن

151
00:08:22,770 --> 00:08:24,870
أسنكون بخير بالفعل؟

152
00:08:42,060 --> 00:08:44,250
!انتهيت

153
00:08:44,250 --> 00:08:46,830
!الرّسم التّصوّريّ لمخبئنا السّرّي

154
00:08:51,010 --> 00:08:52,460
...هذا

155
00:08:52,750 --> 00:08:54,720
رسمتِ هذا في ليلة واحدة؟

156
00:08:55,060 --> 00:08:58,000
...تدفّقت إلى ذهني الكثير من الأفكار المختلفة

157
00:08:58,000 --> 00:09:00,220
!أنت رائعة يا سيروفوتشي

158
00:09:00,220 --> 00:09:01,810
...هذا المنزل

159
00:09:02,350 --> 00:09:04,730
يحلّق نحو الفضاء، صحيح؟

160
00:09:04,730 --> 00:09:07,100
...تدفّقت إلى ذهني الكثير من الأفكار المختلفة

161
00:09:07,530 --> 00:09:09,690
...منزل الشّجرة هذا

162
00:09:09,690 --> 00:09:12,940
.أشبه ببلدة على شجرة

163
00:09:12,940 --> 00:09:15,200
!تدفّقت إلى ذهني الكثير من الأفكار المختلفة

164
00:09:17,020 --> 00:09:21,070
!ثمّة أفعوانيّات ودوالب في كلّ الشّجرة

165
00:09:21,070 --> 00:09:23,450
!تدفّقت إلى ذهني الكثير من الأفكار المختلفة

166
00:09:23,450 --> 00:09:25,370
!مذهل

167
00:09:25,370 --> 00:09:29,450
!حتّى أنّ هنالك منزل شجرة داخل جذع الشّجرة

168
00:09:29,450 --> 00:09:31,950
!تدفّقت إلى ذهني الكثير من الأفكار المختلفة

169
00:09:32,260 --> 00:09:37,920
...عفوًا يا سيروفو-سان، إنّ رسمك جميل فعلاً

170
00:09:37,920 --> 00:09:43,390
لكن أعتقد أنّ استعمال هذا الرّسم
.للبناء... قد يكون صعبًا قليلاً

171
00:09:43,390 --> 00:09:45,940
.نعم. هذا صحيح

172
00:09:45,940 --> 00:09:47,610
...لـ-لكن

173
00:09:47,950 --> 00:09:51,450
...أحببت فعلاَ شكل هذا السّقف والمدخنة

174
00:09:51,450 --> 00:09:54,940
.والمفهوم العامّ لهذه النّافذة

175
00:09:54,940 --> 00:09:59,690
لذلك، يمكننا اختيار كلّ النّقاط والأشياء
،الجيّدة الّتي نظنّ أنّ بإمكاننا بناؤها

176
00:10:00,190 --> 00:10:02,950
ثمّ نجمعها معًا. ما رأيك؟

177
00:10:03,230 --> 00:10:05,950
.فهمت. هذا صحيح

178
00:10:05,950 --> 00:10:09,030
،لا يمكننا بناء منزل شجرة بصواريخ

179
00:10:09,030 --> 00:10:12,140
!لكن أظنّ أنّ بإمكاننا صنع أرجوحة من العجلة

180
00:10:12,140 --> 00:10:13,790
!أجل

181
00:10:14,620 --> 00:10:16,820
...ومنزلقة البكرة هذه تربط بين كوكبين

182
00:10:16,820 --> 00:10:20,540
بإمكانها الرّبط بين منزل الشّجرة
.وسطح غرفة النّادي

183
00:10:20,540 --> 00:10:21,830
!فهمت

184
00:10:22,240 --> 00:10:25,100
،حتّى إن كان بناء منصّة الطّائرة المسيّرة صعبًا

185
00:10:25,100 --> 00:10:27,710
!أبليت حسنًا بالنّسبة لأرجوحة الاستلقاء

186
00:10:27,710 --> 00:10:29,350
!جوبكو-تشان

187
00:10:29,350 --> 00:10:30,510
!حسنًا

188
00:10:30,510 --> 00:10:33,530
!لنجمع كلّ الأجزاء من رسم سيروفو معًا

189
00:10:33,530 --> 00:10:34,610
!أجل

190
00:10:33,530 --> 00:10:34,610
!مياو

191
00:10:37,650 --> 00:10:41,660
د إ ي نادي

192
00:10:42,510 --> 00:10:43,910
!انتهى

193
00:10:43,910 --> 00:10:47,910
د إ ي نادي

194
00:10:48,150 --> 00:10:49,460
.يبدو رائعًا

195
00:10:49,460 --> 00:10:50,980
!أحسنت يا سيروفوتشي

196
00:10:53,400 --> 00:10:56,830
!"سيصير رمزًا رائعًا لنادي "د إ ي

197
00:10:56,830 --> 00:10:58,240
!مذهل

198
00:10:58,710 --> 00:11:02,170
!ينتابني فجأة شعور غامر ينبئني أنّ بإمكاننا بناء هذا

199
00:11:02,170 --> 00:11:07,420
حسنًا، من سيستعمل هذا الرّسم
لرسم مسودّة للمخطّط؟

200
00:11:09,220 --> 00:11:10,270
ماذا؟

201
00:11:23,700 --> 00:11:28,450
د إ ي نادي

202
00:11:25,150 --> 00:11:28,450
.يبدو وكأنّه سيصير شيئًا مذهلاً بالفعل

203
00:11:28,450 --> 00:11:31,110
.سيروفو-سان، قمتِ بعمل ممتاز

204
00:11:33,110 --> 00:11:35,910
حسنًا، كيف ستضعن المخطّط؟

205
00:11:35,910 --> 00:11:41,710
أنجزت مخطّطات أوّليّة لأشياء مثل
،الرّفوف والكراسي من قبل

206
00:11:41,710 --> 00:11:45,230
لكن لم أضعها أبدًا لشيء كبير
...كمخبئنا السّرّيّ من قبل

207
00:11:45,230 --> 00:11:49,300
عليه أن يكون متقنًا جدًّا، صحيح؟

208
00:11:49,300 --> 00:11:52,360
.نعم، هذا صحيح

209
00:11:52,360 --> 00:11:57,130
حتّى بالنّسبة لذكاء اصطناعيّ، فإنّ وضع
.مخطّطٍ بناءً على رسمة قد يكون مستحيلاً

210
00:11:57,130 --> 00:12:00,350
قد يكون مفيدًا لاختبارات القوّة
...ومحاكاة الألوان، ولكن

211
00:12:01,940 --> 00:12:03,200
!وجدتُها

212
00:12:03,590 --> 00:12:04,990
ماذا وجدت؟

213
00:12:04,990 --> 00:12:07,480
!سأرسم المخطّط

214
00:12:07,480 --> 00:12:08,760
!ماذا؟

215
00:12:08,760 --> 00:12:11,010
...ربّما يكون وضع مخطّط أمرًا صعبًا

216
00:12:11,010 --> 00:12:12,250
...قليلاً

217
00:12:14,370 --> 00:12:18,440
حسنًا. سيكون صعبًا، لكنّي سأعمل
—بجدّ لاكتشاف كيف

218
00:12:18,440 --> 00:12:19,960
.سأقوم بذلك

219
00:12:19,960 --> 00:12:20,730
ماذا؟

220
00:12:21,640 --> 00:12:23,250
جوبكو-تشان؟

221
00:12:23,250 --> 00:12:24,790
أيمكنك ذلك؟

222
00:12:26,060 --> 00:12:27,690
.نعم، يمكنني

223
00:12:27,690 --> 00:12:31,680
.مخطّط. ذلك أسهل من تناول الفطور

224
00:12:32,200 --> 00:12:35,620
.كان بإمكانك قول شيء ما البارحة

225
00:12:35,620 --> 00:12:39,330
.آسفة. أردت رؤية كيف ستسير الأمور فحسب

226
00:12:49,490 --> 00:12:51,990
...قياس الشّجرة الّتي ستؤدّي دور الأساس

227
00:12:53,120 --> 00:12:54,390
.انتهى القياس

228
00:12:55,840 --> 00:12:59,060
.سأستعمل هذه البيانات لوضع المخطّط

229
00:12:59,760 --> 00:13:02,010
!كم يُعتمد عليك يا جوبكو-سان

230
00:13:02,010 --> 00:13:04,160
!كلّ آمالنا معلّقة عليك، مياو

231
00:13:04,160 --> 00:13:05,980
أيمكننا فعلاً ترك الأمر لك؟

232
00:13:05,980 --> 00:13:07,470
!بالطّبع

233
00:13:07,470 --> 00:13:10,180
.اعتبرن أنفسكنّ في مأمن بين يديّ

234
00:13:14,430 --> 00:13:17,430
.جرّبت إعداد الكاري بالدّجاج اليوم

235
00:13:20,770 --> 00:13:23,600
!إنّه حارّ قليلاً، لكنّه لذيذ

236
00:13:23,600 --> 00:13:25,120
.سرّني سماع هذا

237
00:13:25,120 --> 00:13:27,600
.ربّما نحوّله إلى كاري كاتسو غدًا

238
00:13:30,720 --> 00:13:34,720
لا أصدّق أنّ بإمكانها وضع مخطّطات
!بناء... إنّها فتاة عبقريّة بالفعل

239
00:13:34,720 --> 00:13:36,680
!بإمكانها فعل أيّ شيء

240
00:13:36,680 --> 00:13:37,510
.نعم

241
00:13:37,510 --> 00:13:40,750
.كما أنّ تاكومي بارعة في أيّ عمل يتطلّب الدّقّة

242
00:13:40,750 --> 00:13:43,380
.ورئيسة نادينا تستطيع صنع أيّ شيء

243
00:13:43,380 --> 00:13:46,460
.وشي-تشان قويّة ورشيقة

244
00:13:46,460 --> 00:13:50,140
.الجميع في نادي "د إ ي" رائعات

245
00:13:50,140 --> 00:13:53,210
!أتمنّى لو كنتُ مفيدة أكثر لهنّ

246
00:13:53,210 --> 00:13:56,090
لكنّك رسمت التّصميم، صحيح؟

247
00:13:56,090 --> 00:13:57,760
...نعم، لكن

248
00:13:58,220 --> 00:14:02,040
...الدّبابيس الّتي صنعتُ لا تباع
،وإن تواصل الحال هكذا

249
00:14:02,040 --> 00:14:06,800
لا أدري ما الّذي سأتمكّن من فعله
.عندما سنبني مخبأنا السّرّيّ

250
00:14:08,730 --> 00:14:09,850
!حسنًا

251
00:14:09,850 --> 00:14:10,850
!أمّي

252
00:14:10,850 --> 00:14:12,820
...المطرقة والمنشار والمفك

253
00:14:12,820 --> 00:14:15,720
!وكلّ الأدوات الأخرى! أين نضعها؟

254
00:14:16,550 --> 00:14:17,310
ماذا؟

255
00:14:26,220 --> 00:14:27,370
ما هذا؟

256
00:14:27,370 --> 00:14:28,740
!ويحي

257
00:14:30,310 --> 00:14:32,810
هل تدقّ مسامير أو ما شابه؟

258
00:14:32,810 --> 00:14:34,690
.آمل ألاّ تؤذي نفسها

259
00:14:34,690 --> 00:14:35,720
!هذا مؤلم

260
00:14:39,440 --> 00:14:41,200
جوبكو-تشان؟

261
00:14:41,200 --> 00:14:42,820
هل استحممتِ؟

262
00:14:46,240 --> 00:14:47,700
ما الخطب؟

263
00:14:47,700 --> 00:14:49,250
أتعانين من ألم معدة؟

264
00:14:53,490 --> 00:14:55,090
...هذه هي

265
00:14:55,370 --> 00:14:57,040
من أجل ماذا هذه المخطّطات؟

266
00:14:59,020 --> 00:15:01,820
عفوًا... جوبكو-تشان؟

267
00:15:06,650 --> 00:15:09,340
سأذهب للاستحمام أوّلاً إذًا، موافقة؟

268
00:15:17,580 --> 00:15:20,980
.أتساءل ما الّذي تحاول سيروفو صنعه

269
00:15:22,780 --> 00:15:25,220
...زجاج البحر الّذي التقطتُها ذلك اليوم

270
00:15:25,220 --> 00:15:27,120
.ربّما سأصنع منع سوارًا

271
00:15:27,740 --> 00:15:29,890
...سأستعمل آلة التّخديد لحفر الثّقب

272
00:15:29,890 --> 00:15:31,650
...وأمرّر سلسلة عبرها

273
00:15:31,650 --> 00:15:35,180
مهلاً! هذا ليس وقتًا مناسبًا
!للتّفكير في أمور كهذه

274
00:15:36,130 --> 00:15:38,260
!عليّ التّقدّم في فرضي

275
00:15:43,050 --> 00:15:44,410
جوبكو-تشان؟

276
00:15:57,300 --> 00:16:00,900
أيعقل أنّها تريد الحديث حيال أمر ما معي؟

277
00:16:01,170 --> 00:16:05,650
جوبكو-تشان، بدوت أنّك قلقة
.بشأن أمر ما قبل قليل

278
00:16:06,800 --> 00:16:08,630
أيتعلّق بتلك المخطّطات؟

279
00:16:08,630 --> 00:16:10,720
.بدت قديمة جدًّا

280
00:16:14,880 --> 00:16:18,690
هلا أخبرتني عنه إن لم يكن الأمر يزعجك؟

281
00:16:19,800 --> 00:16:22,050
.أفترض أنّ لا خيار آخر أمامي

282
00:16:22,050 --> 00:16:27,720
إن كنت تريدين معرفة ذلك بشدّة
.يا بودينغ، فبإمكاني إخبارك

283
00:16:31,330 --> 00:16:37,730
إنّها مخطّطات من أجل منزل شجرة
.أنشأتها أمّي عندما كنتُ صغيرة

284
00:16:37,730 --> 00:16:39,960
...فعلاً؟ أمّك

285
00:16:39,960 --> 00:16:41,910
!كنزي

286
00:16:41,910 --> 00:16:43,940
لماذا كنت تنظرين إليها؟

287
00:16:44,500 --> 00:16:47,570
قرّرنا أنّني من ستضع المخطّطات

288
00:16:47,570 --> 00:16:50,940
."للمخبأ السّرّيّ لنادي "د إ ي

289
00:16:50,940 --> 00:16:52,640
!هذا مذهل

290
00:16:53,240 --> 00:16:55,210
.ليس بالأمر العظيم

291
00:16:55,210 --> 00:16:59,590
كنتُ قلقة بشأن ترك ذلك العمل
.لأيّ من الأخريات، لذا أخذته على عاتقي

292
00:16:59,590 --> 00:17:03,820
وظننتِ أنّ بإمكانك استعمال
مخطّطات أمّك كمرجع؟

293
00:17:03,820 --> 00:17:04,900
.نوعًا ما

294
00:17:05,190 --> 00:17:06,930
هل ساعدك ذلك؟

295
00:17:07,850 --> 00:17:09,890
.لا أدري

296
00:17:09,890 --> 00:17:10,600
ماذا؟

297
00:17:11,860 --> 00:17:13,600
.لا فكرة لديّ

298
00:17:14,150 --> 00:17:16,300
ماذا تقصدين؟

299
00:17:16,300 --> 00:17:19,930
.أقصد أنّني لم أدرس المخطّطات قطّ

300
00:17:19,930 --> 00:17:22,230
.لا أعرف أيّ شيء بشأن الهندسة المعماريّة

301
00:17:22,230 --> 00:17:25,580
لا أعرف حتّى كيف أستعمل التّصميم
.بمساعدة الحاسوب لهذه الأشياء

302
00:17:25,580 --> 00:17:27,710
.أنت عبقريّة يا جوبكو-تشان

303
00:17:27,710 --> 00:17:29,680
بإمكانك تعلّم ذلك في وقت وجيز، صحيح؟

304
00:17:29,680 --> 00:17:32,220
.ذلك صحيح. أنا عبقريّة

305
00:17:32,220 --> 00:17:34,390
.أستطيع فعل كلّ ما أحاول فعله

306
00:17:35,000 --> 00:17:36,270
...ولكن

307
00:17:36,790 --> 00:17:40,920
!لا يوجد وقت كافٍ لبدء الدّراسة من الصّفر

308
00:17:42,340 --> 00:17:46,030
لماذا قلت أنّك ستقومين بالأمر من الأساس؟

309
00:17:46,030 --> 00:17:48,720
...ذلك... كان

310
00:17:48,720 --> 00:17:49,790
كان ماذا...؟

311
00:17:51,080 --> 00:17:53,040
.لأنّه كان ممتعًا

312
00:17:53,920 --> 00:17:57,930
!بأنّ الأمر كان ممتعًا جدًّا حينها

313
00:17:58,710 --> 00:18:02,240
.بناء منزل شجرة مع أمّي

314
00:18:02,240 --> 00:18:04,850
.عملت بجدّ قدر المستطاع

315
00:18:05,300 --> 00:18:07,530
.كان أبي سعيدًا أيضًا

316
00:18:10,230 --> 00:18:13,820
...سيروفو ورئيسة النّادي وتاكومين وشي

317
00:18:13,820 --> 00:18:16,880
...إن شعرن جميعًا بمثل ذلك الإحساس

318
00:18:16,880 --> 00:18:18,850
.لكان ذلك لطيفًا

319
00:18:18,850 --> 00:18:22,230
متى يجب الانتهاء من المخطّط؟

320
00:18:22,230 --> 00:18:25,110
.نفعى لفناء المخبأ الفّرّيّ قبر العطوة الفّيفيّة

321
00:18:25,110 --> 00:18:25,750
ماذا؟

322
00:18:26,270 --> 00:18:29,920
،قلنا أنّنا نريد أن نبدأ بعد الموسم الماطر مباشرة

323
00:18:29,920 --> 00:18:31,740
.أي قبل نهاية هذا الشّهر

324
00:18:32,350 --> 00:18:34,210
!هذا يعني أنّ أمامك أقلّ من عشرة أيّام

325
00:18:34,480 --> 00:18:38,300
،أنا هنا للدّورة الأولى فقط

326
00:18:38,300 --> 00:18:40,800
.لذلك أردت إنهاءها خلال ذلك الوقت

327
00:18:43,910 --> 00:18:45,750
.حسنًا

328
00:18:45,750 --> 00:18:47,510
.سأساعدك

329
00:18:47,510 --> 00:18:48,740
بإمكانك ذلك؟

330
00:18:48,970 --> 00:18:51,320
،لم أضع مخطّطات بناء من قبل أيضًا

331
00:18:51,320 --> 00:18:54,370
،لكن إن عملنا على الأمر معًا
فسيأخذ نصف الوقت، صحيح؟

332
00:18:57,210 --> 00:18:59,030
!أحبّك يا بودينغ

333
00:18:59,030 --> 00:19:02,130
!ماذا؟! مهلاً! لا تلمسي أماكن حسّاسة في جسدي

334
00:19:02,130 --> 00:19:05,540
!لا بأس! لا تقلقي حيال ذلك

335
00:19:13,420 --> 00:19:15,250
فواكه طازجة
قرية كانغي للفواكه

336
00:19:15,250 --> 00:19:17,670
مانغو 750 ينّ

337
00:19:15,250 --> 00:19:17,670
فراولة 500 ينّ
شاين موسكات
بـ500 ينّ

338
00:19:17,670 --> 00:19:20,680
قرية كانغي للفواكه

339
00:19:31,230 --> 00:19:33,610
في مُستطاع الجميع

340
00:19:31,230 --> 00:19:33,610
كتاب تمهيديّ سهل

341
00:19:38,360 --> 00:19:40,610
تسلّق الأشجار

342
00:19:38,360 --> 00:19:40,610
القائد ماتسودا

343
00:20:21,870 --> 00:20:26,150
.صباح الخير

344
00:20:23,230 --> 00:20:24,670
.جوبكو-تشان

345
00:20:27,710 --> 00:20:29,440
...أخبريني يا بودينغ

346
00:20:29,440 --> 00:20:30,630
ماذا؟

347
00:20:31,080 --> 00:20:32,990
...أنا فقط

348
00:20:32,990 --> 00:20:36,880
شكرًا لك. تمكّنتُ من الانتهاء
.من المخطّطات بفضلك أنت

349
00:20:36,880 --> 00:20:40,670
!أنا... أيضًا استمتعت كثيرًا بذلك

350
00:20:41,000 --> 00:20:45,490
"أعلم أنّ الجميع في نادي "د إ ي
.سيكون ممتنًّا لك أيضًا

351
00:20:45,490 --> 00:20:49,850
د-دعي أمر ساعدتي سرًّا بيننا، موافقة؟

352
00:20:49,850 --> 00:20:51,110
لماذا؟

353
00:20:51,110 --> 00:20:56,990
"قلتُ في السّابق أنّ "د إ ي
.أمر عفن عفى عنه الزّمن

354
00:20:56,990 --> 00:20:59,180
...سخرت منه كثيرًا

355
00:20:59,180 --> 00:21:00,660
...وقول خلاف ذلك الآن

356
00:21:00,660 --> 00:21:03,010
.صحيح، أظنّك محقّة

357
00:21:03,010 --> 00:21:04,460
...ومع ذلك

358
00:21:04,460 --> 00:21:07,120
!الصّيف في اليابان رطب وحارّ

359
00:21:07,120 --> 00:21:09,660
الموسم الماطر والصّيف فظيعان
.على حدّ السّواء

360
00:21:11,040 --> 00:21:13,990
!أنت مذهلة يا جوبكو-تشان

361
00:21:13,990 --> 00:21:16,030
!هذا هو المتوقّع من فتاتنا العبقريّة

362
00:21:16,030 --> 00:21:17,220
.إنّها رائعة

363
00:21:17,220 --> 00:21:19,300
!إنّها تعريف "أبليت حسنًا" بالفعل، مياو

364
00:21:19,300 --> 00:21:21,320
.سيكون كلّ شيء بخير بهذه الآن

365
00:21:21,320 --> 00:21:23,830
!تستحقّين كلّ الثّناء يا جوبكو-سان

366
00:21:24,670 --> 00:21:28,340
،عندما أضع يديّ على شيء كهذا
!يصير في غاية السّهولة

367
00:21:28,340 --> 00:21:33,000
من المحتمل أنّكنّ قد تصادفن
،أشياء تحتاج للتّعديل بينما تعملن

368
00:21:33,000 --> 00:21:35,010
.لكن لندع ذلك إلى أن يحدث

369
00:21:35,010 --> 00:21:37,730
.لدينا معظم الموادّ والتّمويل اللاّزم أيضًا

370
00:21:37,730 --> 00:21:39,660
.انتهى الموسم الماطر

371
00:21:39,660 --> 00:21:43,820
،عندما تنتهي امتحانات نصف الدّورة
!سنبدأ العمل على مخبئنا السّرّيّ

372
00:21:43,820 --> 00:21:45,640
!أجل

373
00:21:43,820 --> 00:21:45,640
!نعم

374
00:21:45,640 --> 00:21:47,560
!حظًّا سعيدًا لكنّ

375
00:21:47,560 --> 00:21:48,530
!صحيح

376
00:21:49,610 --> 00:21:51,140
...كنت أفكّر

377
00:21:51,140 --> 00:21:53,830
،قبل أن نبدأ بناء المخبأ السّرّيّ

378
00:21:53,830 --> 00:21:57,740
.أريد دعوة النّادي كلّه إلى منزلي

379
00:21:57,740 --> 00:21:59,610
إلى منزلك يا سيروفوتشي؟

380
00:21:59,610 --> 00:22:00,590
لماذا؟

381
00:22:01,500 --> 00:22:04,110
!هنالك شيء أريدكنّ أن ترينه

382
00:23:36,140 --> 00:23:39,930
الخطوة 9

383
00:23:36,140 --> 00:23:39,930
تعني د إ ي
!مفاجأة صادمة؟ كم هذا غير متوقّع! لذلك هو غير متوقّع بالفعل