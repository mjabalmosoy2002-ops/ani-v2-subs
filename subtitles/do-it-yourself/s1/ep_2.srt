1
00:00:02,880 --> 00:00:04,960
!إنّه جاهز

2
00:00:05,410 --> 00:00:07,570
.بورين، حاولي الجلوس عليه

3
00:00:08,640 --> 00:00:09,530
ماذا؟

4
00:00:10,730 --> 00:00:14,100
!بـ-بورين؟

5
00:00:17,260 --> 00:00:19,640
.حسنًا، لا بأس

6
00:00:23,260 --> 00:00:26,000
!لا، لا، لا، بل هناك بأس

7
00:01:58,470 --> 00:02:04,010
الخطوة 2
د إ ي" تعني القيام بشيء ما مع أحد ما؟"

8
00:01:59,490 --> 00:02:01,990
.أنا مغادِرة

9
00:02:01,990 --> 00:02:04,680
!حسنًا! رافقتك السّلامة

10
00:02:09,560 --> 00:02:11,390
!أنت آمنة

11
00:02:12,260 --> 00:02:13,390
ماذا تعنين؟

12
00:02:13,390 --> 00:02:16,250
."انضممتُ لنادي "د إ ي

13
00:02:16,250 --> 00:02:17,530
نادي "د إ ي"؟

14
00:02:18,260 --> 00:02:20,740
...إنّه اختصار لعبارة

15
00:02:20,740 --> 00:02:21,740
—دو إت

16
00:02:22,030 --> 00:02:23,700
!يورسلف، صحيح؟

17
00:02:25,420 --> 00:02:26,860
لماذا تشعرين بالخجل هكذا؟

18
00:02:26,860 --> 00:02:31,250
...سماعك تناديني باسمي الكامل
.أمر لم أعهده من قبل منك يا بورين

19
00:02:31,250 --> 00:02:32,800
.لم أناديك باسمك

20
00:02:33,110 --> 00:02:35,710
.كما أنّ اسمي ميكو

21
00:02:35,710 --> 00:02:37,750
!أتمنّى لو تكفّين عن مناداتي بورين

22
00:02:37,750 --> 00:02:39,000
،ولكن يا بورين

23
00:02:39,000 --> 00:02:42,340
إن كنت تتساءلين لماذا انضممت
..."إلى نادي "د إ ي

24
00:02:42,790 --> 00:02:45,600
فأنا أفكّر في بعض الأشياء
—الجميلة. مثل مقعـ

25
00:02:45,600 --> 00:02:49,520
سيروفو، إنّ ناديًا قديمًا وعفنًا ومهمَلاً
.مثل نادي "د إ ي" يناسبك تمامًا

26
00:02:49,520 --> 00:02:51,730
يناسبني إذًا؟

27
00:02:52,770 --> 00:02:54,250
لماذا تحمرّين خجلاً؟

28
00:02:57,520 --> 00:02:59,930
.أنا عكس ما هو قديم وعفن

29
00:03:00,410 --> 00:03:02,610
!كلّ ما أدرسه حديث

30
00:03:02,910 --> 00:03:05,950
سأساعد في تطوير الثّورة الصّناعيّة
...الرّابعة أكثر بيديّ هاتين

31
00:03:05,950 --> 00:03:08,370
.وتحقيق تفرّد تكنولوجيّ

32
00:03:08,980 --> 00:03:11,630
سيصير المستقبل ممكننًا بالكامل
.بفضل الذّكاء الاصطناعيّ

33
00:03:11,840 --> 00:03:14,370
...أمّا البشر، فسينسون ما هو العمل اليدويّ

34
00:03:14,370 --> 00:03:16,650
!ولن يضطرّون لعمل أيّ شيء

35
00:03:20,460 --> 00:03:22,960
!مع السّلامة

36
00:03:26,420 --> 00:03:28,300
.أعتقد أنّني سأعود للمنزل الآن

37
00:03:28,570 --> 00:03:31,220
.ويحي! بل العكس

38
00:03:31,460 --> 00:03:33,320
.عليّ المغادرة أيضًا

39
00:03:36,320 --> 00:03:39,380
مستقبل لن أضطرّ فيه لفعل أيّ شيء؟

40
00:03:40,160 --> 00:03:42,650
...إن لم يكن علي فعل أيّ شيء أبدًا

41
00:03:42,650 --> 00:03:45,390
فماذا سأفعل؟

42
00:03:54,710 --> 00:03:56,260
!صباح الخير

43
00:03:56,950 --> 00:03:58,260
!صباحو

44
00:03:58,260 --> 00:03:59,950
ماذا فعلتِ البارحة؟

45
00:03:59,950 --> 00:04:01,120
ماذا؟ البارحة؟

46
00:04:01,120 --> 00:04:02,840
.تناولت رامن الكاري

47
00:04:02,840 --> 00:04:05,060
.وأنا خرجت للأكل في كانيغي فروتس

48
00:04:05,060 --> 00:04:06,390
!كم أحسدك

49
00:04:06,390 --> 00:04:07,960
!تاكومين

50
00:04:09,160 --> 00:04:11,040
!صباح الخير

51
00:04:11,040 --> 00:04:14,820
!صـ-صباح الخير يا سـ-سيروفو-سان

52
00:04:17,780 --> 00:04:20,490
!صباح الخير

53
00:04:24,520 --> 00:04:26,330
.لا-لا شيء

54
00:04:26,330 --> 00:04:31,030
عفوًا يا سيروفو-سان، ماذا فعلت البارحة؟

55
00:04:31,740 --> 00:04:33,990
ماذا فعلت؟

56
00:04:34,590 --> 00:04:39,260
أخبريني يا تاكومين، إن لم يكن عليك
القيام بأيّ شيء، فماذا كنت لتفعلي؟

57
00:04:41,620 --> 00:04:46,060
.كنت لأقرأ المزيد من الكتب... على ما أظنّ

58
00:04:46,060 --> 00:04:49,760
لكن بما أنّه لن يكون عليّ
...القيام بأيّ شيء... مهلاً

59
00:04:50,170 --> 00:04:54,280
،إنّه سؤال فلسفيّ نوعًا ما
.إنّه أشبه بمفارقة

60
00:04:54,820 --> 00:04:57,130
ماذا كنت لتقومي به أنت سيروفو-سان؟

61
00:04:57,720 --> 00:05:01,050
.حسنًا، إنّه سؤال صعب

62
00:05:01,050 --> 00:05:03,500
...ربّما أقوم بالرّسم كثيرًا

63
00:05:03,500 --> 00:05:06,320
...أو ربّما ألعب مع بوتشي والبقيّة كثيرًا

64
00:05:06,320 --> 00:05:08,960
...أو ربّما آخذ قيلولات كثيرة

65
00:05:12,390 --> 00:05:16,240
"أفهذا حبّي الأوحد؟ من صلب عدوّي الأوحد؟"

66
00:05:16,610 --> 00:05:20,550
،لم أكُ أعرف حين رأيت الأملا"
".والآن عرفتُ وقد سبق السّيف العذلا

67
00:05:21,010 --> 00:05:24,660
"...ذا مولِدُ حبّ يُنذَر بالشّرّ المحتوم"

68
00:05:22,360 --> 00:05:24,230
...سيتحقّق

69
00:05:27,980 --> 00:05:31,100
ماذا؟ أعددت هذا بنفسك يا تاكومين؟

70
00:05:31,100 --> 00:05:32,840
!إنّه رائع

71
00:05:32,840 --> 00:05:36,070
!إنّه جميل! به تفاصيل كثيرة

72
00:05:36,070 --> 00:05:37,970
.شـ-شكرًا لك

73
00:05:39,160 --> 00:05:42,020
هل أخبرتك أنّني انضممت لنادي "د أ ي"؟

74
00:05:42,020 --> 00:05:45,080
ليس بعد! إذًا فقد حدّدت ناديك؟

75
00:05:45,080 --> 00:05:45,940
.نعم

76
00:05:45,940 --> 00:05:49,400
"—صحيح! "د إ ي" هو اختصار لـ"دو إت

77
00:05:49,400 --> 00:05:51,420
يورسلف، صحيح؟

78
00:05:54,140 --> 00:05:55,860
!تُنطق مثل يوا سيروفو

79
00:05:57,800 --> 00:05:59,490
ألهذا السّبب انضممت؟

80
00:05:59,840 --> 00:06:02,950
.تلك النّتيجة كانت مجرّد مصادفة

81
00:06:03,350 --> 00:06:06,160
تلك النّتيجة كانت مجرّد مصادفة إذًا؟

82
00:06:06,430 --> 00:06:10,940
.قالت بورين أنّ نادي "د إ ي" قديم

83
00:06:10,940 --> 00:06:12,170
بورين؟

84
00:06:12,170 --> 00:06:13,960
،إنّها تغضب دائمًا

85
00:06:13,960 --> 00:06:16,390
.وتنفخ خدّيها هكذا كسمكة النّفّاخ

86
00:06:16,830 --> 00:06:19,600
.تغضب بورين كسمكة نفّاخ

87
00:06:19,600 --> 00:06:24,700
"أخبرونا أنّه إن لم يحصل نادي "د إ ي
.على عضوات كافيات، فسيتمّ حلّه

88
00:06:24,700 --> 00:06:29,230
.يحدث هذا كثيرًا في الرّوايات عن النّوادي

89
00:06:29,230 --> 00:06:30,420
فعلاً؟

90
00:06:32,150 --> 00:06:36,820
.أحبّ هذا الكتاب. اسمه فتيات عبّاد الشّمس

91
00:06:37,080 --> 00:06:42,060
لم يستطعن إيجاد عضوات كافيات، لذلك
.يواجه ناديهنّ للبستنة خطر أن يُحلّ أيضًا

92
00:06:42,060 --> 00:06:44,250
.إنّه نفس الوضع تمامًا

93
00:06:44,250 --> 00:06:49,070
ثمّ يقوم نادي البستنة بتوزيع
.زهور بهدف ضمّ عضوات جديدات

94
00:06:49,070 --> 00:06:50,080
زهور؟

95
00:06:50,280 --> 00:06:53,360
.نعم! زهور جميلة وظريفة

96
00:06:53,360 --> 00:06:56,050
.لأنّهنّ يردن أن يهتمّ النّاس بالبستنة

97
00:06:57,310 --> 00:06:58,970
.فهمت

98
00:06:59,810 --> 00:07:03,460
."إذًا ربّما علينا توزيع الخشب في نادي "د إ ي

99
00:07:03,460 --> 00:07:05,410
.لا أظنّ أنّ هنالك من سيرغب بذلك

100
00:07:05,410 --> 00:07:06,330
!مسامير

101
00:07:06,700 --> 00:07:09,520
.لستُ واثقة أنّ ذلك سيجذب انتباه النّاس

102
00:07:09,520 --> 00:07:11,120
فعلاً؟ أين؟

103
00:07:11,500 --> 00:07:16,360
قيل أنّ مكانًا يُدعى مقهى كنشين
.فُتح حديثًا قرب ورك وان

104
00:07:16,360 --> 00:07:19,970
.سمعت أنّ كلّ العمّال يرتدون قلنسوة غيونين

105
00:07:20,290 --> 00:07:22,600
!فعلاً؟ لنمرّ عليه في طريق عودتنا للمنزل

106
00:07:23,060 --> 00:07:25,660
...ربّما إن حوّلنا غرفة النّادي لمقهى

107
00:07:26,790 --> 00:07:29,910
فسيأتي الزّبائن بكثرة، صحيح؟

108
00:07:31,120 --> 00:07:35,370
!مرحبًا بكم في نادي "د إ ي"! تفضّلوا

109
00:07:35,370 --> 00:07:39,440
تحتاجين للأعضاء وليس للزّبائن، صحيح؟

110
00:07:40,560 --> 00:07:41,470
فعلاً؟

111
00:07:41,700 --> 00:07:44,520
،أعتقد أنّ تحويله لمقهى قد يكون صعبًا

112
00:07:44,520 --> 00:07:47,200
لكن ما رأيك في جعل غرفة النّادي أكثر ظرافة؟

113
00:07:47,390 --> 00:07:48,700
أكثر ظرافة؟

114
00:07:48,950 --> 00:07:52,390
،تحبّ الكثير من الفتيات الأشياء الظّريفة

115
00:07:52,390 --> 00:07:54,890
.لذلك قد يكون ذلك بداية لكسب اهتمامهنّ

116
00:07:54,890 --> 00:07:57,610
!مفهوم! أنت رائعة يا تاكومين

117
00:07:57,610 --> 00:07:59,490
...لـ-ليس كذلك

118
00:08:02,710 --> 00:08:05,070
!تعالي معي بعد المدرسة

119
00:08:05,470 --> 00:08:07,080
!بـ-بالطّبع

120
00:08:08,610 --> 00:08:09,550
بالطّبع؟

121
00:08:17,740 --> 00:08:20,470
.غرفة نادي "د إ ي"  من هنا

122
00:08:20,980 --> 00:08:22,070
...حسنًا

123
00:08:25,010 --> 00:08:25,760
ماذا؟

124
00:08:26,490 --> 00:08:30,730
هذا ليس المخزن؟ بل غرفة النّادي؟

125
00:08:33,600 --> 00:08:36,370
.يبدو ذلك الطّائر المحنّط وكأنّه ما زال حيًّا

126
00:08:36,730 --> 00:08:40,350
هلاّ أخبرت رئيسة النّادي عن فكرتك يا تاكومين؟

127
00:08:40,350 --> 00:08:41,610
رئيسة النّادي؟

128
00:08:41,610 --> 00:08:44,210
.ياساكو-سان. إنّها في السّنة الثّالثة

129
00:08:44,460 --> 00:08:48,430
ماذا؟ أتقصدين الفتاة الّتي تطارد
الآخرين بمطرقة؟

130
00:08:48,430 --> 00:08:51,260
.هذا صحيح. ياساكو-سان تلك

131
00:08:53,910 --> 00:08:55,950
!حسنًا، ادخلي

132
00:08:55,410 --> 00:08:57,610
!مـ-مهلاً

133
00:08:55,950 --> 00:08:57,390
!هيّا، هيّا

134
00:09:03,980 --> 00:09:08,230
كوخ التّخزين ذاك... أهو مسكون أو ما شابه؟

135
00:09:08,660 --> 00:09:10,890
إلام تنظرين يا سوريديتشي؟

136
00:09:10,890 --> 00:09:12,660
سوريديتشي؟

137
00:09:14,000 --> 00:09:15,330
.لا شيء

138
00:09:15,800 --> 00:09:16,910
فعلاً؟

139
00:09:20,450 --> 00:09:24,260
أتساءل إن كان هنالك شيء ما
في كوخ التّخزين ذلك، مياو؟

140
00:09:28,200 --> 00:09:30,080
ما-ماذا؟

141
00:09:30,470 --> 00:09:32,150
ما هذا؟

142
00:09:32,820 --> 00:09:34,170
.إنّه صندوق مفاتيح

143
00:09:34,990 --> 00:09:37,960
.فكّرت أنّ هذا سيكون أفضل من مجرّد مسامير

144
00:09:39,180 --> 00:09:40,640
.وها قد انتهيت

145
00:09:43,320 --> 00:09:44,070
من تكون؟

146
00:09:44,710 --> 00:09:47,480
!هذه زميلتي في الفصل تاكومين

147
00:09:48,130 --> 00:09:49,180
تاكومين؟

148
00:09:49,490 --> 00:09:52,210
...عـ-عفوًا، أنا

149
00:09:53,630 --> 00:09:59,260
خطرت على بال تاكومين فكرة
!رائعة بشأن ضمّ عضوات للنّادي

150
00:09:59,260 --> 00:10:01,880
.هيّا يا تاكومين. أخبريها

151
00:10:01,880 --> 00:10:03,290
.حـ-حسنًا

152
00:10:03,830 --> 00:10:06,500
...عفوًا، أنا

153
00:10:07,340 --> 00:10:09,750
نجعل غرفة النّادي أظرف؟

154
00:10:09,750 --> 00:10:11,440
.نـ-نعم

155
00:10:11,970 --> 00:10:13,810
أظرف، صحيح؟

156
00:10:13,810 --> 00:10:19,410
حصلنا على الفكرة من وراية تحبّها
.تاكومين تُدعى فتيات الجليد المبشور

157
00:10:19,410 --> 00:10:21,380
.اسمها فتيات عبّاد الشّمس

158
00:10:24,730 --> 00:10:27,560
.حـ-حسنًا. سأغادر الآن

159
00:10:27,560 --> 00:10:28,350
فتيات عبّاد الشّمس؟

160
00:10:28,690 --> 00:10:29,390
ماذا؟

161
00:10:30,070 --> 00:10:33,600
.نـ-نعم. هذا صحيح

162
00:10:34,120 --> 00:10:35,930
.حوّلوها لمانغا أيضًا

163
00:10:35,930 --> 00:10:38,520
.نعم، تلك بالضّبط

164
00:10:40,070 --> 00:10:43,020
.قد لا يكون تجربة الأمر فكرة جيّدة

165
00:10:43,290 --> 00:10:44,000
ماذا؟

166
00:10:46,340 --> 00:10:48,900
!دو إت يورسلف

167
00:10:48,900 --> 00:10:51,770
!سلف... سلف... سلف

168
00:10:58,260 --> 00:11:01,220
لكن الآن، الموادّ الوحيدة المتوفّرة
...في النّادي الّتي يمكن استعمالها

169
00:11:01,220 --> 00:11:02,840
...لصنع أشياء ظريفة

170
00:11:02,840 --> 00:11:04,670
.هي قطع البلاط هذه

171
00:11:04,890 --> 00:11:06,720
...هكذا إذًا

172
00:11:06,720 --> 00:11:09,380
...إن وضعناها على جدران وسقف النّادي

173
00:11:09,810 --> 00:11:13,470
!فسيبدو مثل منزل حلوى كما القصص الخرافيّة

174
00:11:13,940 --> 00:11:16,060
.ليس لدينا ما يكفي لذلك

175
00:11:16,060 --> 00:11:17,430
.هكذا إذًا

176
00:11:17,430 --> 00:11:20,800
.لكن قد يكون هنالك ما يكفي لصنع لافتة

177
00:11:21,330 --> 00:11:22,800
لافتة؟

178
00:11:24,980 --> 00:11:27,940
.هذه كانت لافتة النّادي

179
00:11:27,940 --> 00:11:29,840
.جرّبي ذلك. قومي بالأمر كما يحلو لك

180
00:11:29,840 --> 00:11:30,740
ماذا؟

181
00:11:30,740 --> 00:11:32,270
كما يحلو لي؟

182
00:11:32,270 --> 00:11:35,850
أليس هذا رائعًا؟ قالت أنّ بإمكانك
.القيام بها كما يحلو لك يا تاكومين

183
00:11:35,850 --> 00:11:38,670
لقد كانت فكرتك من الأساس، صحيح؟

184
00:11:38,670 --> 00:11:42,130
.لا، لم تكن فكرتي بالكامل

185
00:11:42,370 --> 00:11:45,630
...أخذتُ فكرة يا سيروفو-سان وأضفتُ إليها

186
00:11:45,630 --> 00:11:47,840
...أو بالأحرى جعلتها أكثر واقعيّة

187
00:11:48,400 --> 00:11:50,180
.حسنًا، سأشرح الطّريقة

188
00:11:50,180 --> 00:11:51,740
.إنّها سهلة

189
