1
00:00:03,370 --> 00:00:04,320
.حسنًا

2
00:00:04,720 --> 00:00:07,190
.هذا هو آخر برغيّ

3
00:00:07,190 --> 00:00:08,730
.سأعهد لك به يا سيروفو

4
00:00:08,980 --> 00:00:10,600
هل أنت واثقة؟

5
00:00:10,600 --> 00:00:11,730
.بالطّبع

6
00:00:12,600 --> 00:00:13,810
...وقتها

7
00:00:13,810 --> 00:00:14,980
...وبمحض الصّدفة

8
00:00:15,400 --> 00:00:18,140
...طلبتُ مكن تثبيت ذلك البرغيّ يا سيروفو

9
00:00:18,140 --> 00:00:20,290
.أعتقد أنّ ذلك الحدث أوصلنا إلى هنا

10
00:00:23,820 --> 00:00:24,880
.وهذا هو السّبب

11
00:00:27,110 --> 00:00:28,000
!أكيد

12
00:00:48,910 --> 00:00:50,360
!انتهيت

13
00:00:51,110 --> 00:00:52,940
!قمتِ بذلك على أحسن وجه

14
00:00:52,940 --> 00:00:54,600
!شكرًا لك

15
00:00:55,620 --> 00:00:56,610
!بورين

16
00:00:59,970 --> 00:01:02,830
.شكرًا على المساعدة

17
00:01:05,430 --> 00:01:06,270
.العفو

18
00:01:27,080 --> 00:01:30,530
...هذا هو

19
00:01:32,600 --> 00:01:34,550
!مخبأنا السّرّيّ

20
00:01:35,520 --> 00:01:37,360
...في وليلة البارحة

21
00:01:37,360 --> 00:01:38,210
!مهلاً

22
00:01:38,210 --> 00:01:40,910
هل أنهين منزل الشّجرة؟

23
00:01:40,910 --> 00:01:43,660
يبدو حقيقيًّا، أليس كذلك؟

24
00:01:43,660 --> 00:01:45,420
!ذلك رائع بالفعل

25
00:01:46,020 --> 00:01:50,020
.تهانينا على إنهاء منزل الشّجرة

26
00:01:51,510 --> 00:01:54,250
!يا رفيقات... أبليتنّ حسنًا

27
00:01:54,250 --> 00:01:55,910
!أبلينا حسنًا

28
00:02:01,900 --> 00:02:04,750
رائحة الخشب رائعة، صحيح؟

29
00:02:04,750 --> 00:02:06,280
.نعم

30
00:02:06,280 --> 00:02:08,780
...لكنّ ألواح الأرضيّة هذه

31
00:02:08,780 --> 00:02:11,260
!صحيح! أنا من قام بذلك الجزء

32
00:02:11,260 --> 00:02:12,720
.هذا ما ظننت

33
00:02:12,720 --> 00:02:18,440
كلّ البراغي معوجّة وثمّة فجوة
.كبيرة بين الألواح هناك

34
00:02:12,980 --> 00:02:18,450
معوجّ

35
00:02:15,730 --> 00:02:18,450
فجوة

36
00:02:19,510 --> 00:02:21,130
لماذا تتصرّفين بخجل؟

37
00:02:21,130 --> 00:02:25,370
لكنّ هذا يمنحه شخصيّة خاصّة به
وهو أمر جيّد، صحيح يا رئيسة النّادي؟

38
00:02:26,510 --> 00:02:27,760
.هذا صحيح

39
00:02:30,640 --> 00:02:33,370
...الزّجاج الملوّن الّذي صنعته هيكاغي-سان

40
00:02:33,370 --> 00:02:34,930
!إنّه جميل بالفعل

41
00:02:34,930 --> 00:02:37,150
.شـ-شكرًا لك

42
00:02:37,150 --> 00:02:40,940
وكمّة المصباح الّتي صنتِها
.يا سوريدي-تشان جميلة جدًّا أيضًا

43
00:02:40,940 --> 00:02:42,130
.شكرًا لك

44
00:02:42,130 --> 00:02:44,440
.بإمكانك مناداتي بورين إن أردت

45
00:02:44,790 --> 00:02:47,190
.بـ-بورين-سان

46
00:02:47,790 --> 00:02:50,530
.ونادني تاكومين رجاءً

47
00:02:50,530 --> 00:02:51,710
!تاكومين-سان

48
00:02:54,430 --> 00:02:58,910
الرّفوف الّتي صنعتها جوبكو مناسبة
!لهذه الغرفة تمامًا

49
00:02:58,910 --> 00:03:00,280
!بالطّبع

50
00:03:00,890 --> 00:03:05,930
وأُثني على ألواح الحائط والسّقف
.الّتي وضعتِها يا رئيسة النّادي

51
00:03:05,930 --> 00:03:08,470
.وها هي تتحدّث وكأنّها أعلى شأنًا كالعادة

52
00:03:09,540 --> 00:03:12,760
!كما بنت شي هيكل سقف مثاليًّا

53
00:03:13,930 --> 00:03:16,910
!حصولي على ثناء كهذا شرف لي، مياو

54
00:03:17,590 --> 00:03:21,240
!لنُقم حفل مبيت معًا في المخبأ السّرّيّ

55
00:03:21,240 --> 00:03:22,390
!موافقة

56
00:03:22,390 --> 00:03:24,450
أليس صغيرًا جدًّا على ذلك؟

57
00:03:24,450 --> 00:03:26,580
!لنبِت هنا أنا وبورين فقط إذًا

58
00:03:26,580 --> 00:03:28,560
لـ-لماذا انتهى الأمر هكذا؟

59
00:03:31,520 --> 00:03:36,480
الخطوة 12
!د إ ي" تعني الصّداقة دائمًا وللأبد"

60
00:03:32,540 --> 00:03:35,130
.ستبدأ العطلة الصّيفيّة غدًا

61
00:03:35,650 --> 00:03:40,540
.اطمحن أيّتها التّلميذات لعيش حياة منظّمة جيّدًا

62
00:03:40,540 --> 00:03:47,920
تعاملن مع الدّراسة ونشاطات النّوادي
.وأوقات تسليتكنّ كلّ ما لديكنّ

63
00:03:47,920 --> 00:03:49,700
...وثمّ، في الدّورة الجديدة

64
00:03:51,080 --> 00:03:52,900
هل اقترب الموعد؟

65
00:03:53,200 --> 00:03:58,540
نعم. قيل أنّ اجتماع نهاية الدّورة
.لثانويّة يو المهنيّة سينتهي عند الظّهيرة

66
00:04:00,500 --> 00:04:01,470
.إنّها هنا

67
00:04:07,850 --> 00:04:09,230
...كوكي كوكورو

68
00:04:09,230 --> 00:04:11,420
!وصلت، مياو

69
00:04:11,840 --> 00:04:14,470
!أنت كونويتشي بالفعل

70
00:04:14,470 --> 00:04:16,780
!مرحبًا بك يا شي-تشان

71
00:04:16,780 --> 00:04:19,470
.شكرًا على دعوتي، مياو

72
00:04:19,470 --> 00:04:21,020
!مهلاً يا كوكي-سان

73
00:04:21,730 --> 00:04:25,240
أخبرتك أن تدخلي بشكل لائق من
باب ثانويّة غاتا للفتيات، ألم أفعل؟

74
00:04:25,240 --> 00:04:28,190
!لم يلاحظني الأمن، لذلك لا بأس، مياو

75
00:04:28,190 --> 00:04:30,080
!هذه ليست المشكلة

76
00:04:31,020 --> 00:04:33,580
!مرحبًا بك يا بورين

77
00:04:33,920 --> 00:04:36,660
!جميعنا هنا الآن

78
00:04:37,080 --> 00:04:41,280
شكرًا على لطفكنّ الزّائد معي
!الّذي طال ليشمل دعوتي

79
00:04:43,090 --> 00:04:48,180
،بما أنّ الجميع هنا الآن
فهل نحن جاهزات للاحتفال؟

80
00:04:48,180 --> 00:04:49,040
!نعم

81
00:04:49,040 --> 00:04:50,260
!نعم، مياو

82
00:04:51,110 --> 00:04:53,670
!إنّه منزل شجرة ممتاز

83
00:04:54,180 --> 00:04:57,180
.انتهى مخبأكنّ السّرّيّ

84
00:04:58,310 --> 00:05:01,060
.عملتنّ جميعًا بجدّ دون استسلام

85
00:05:01,510 --> 00:05:03,110
!جميعكنّ مذهلات

86
00:05:08,360 --> 00:05:11,980
والآن، سنبدأ الاحتفال بالانتهاء
...من بناء المخبأ السّرّيّ

87
00:05:11,980 --> 00:05:14,740
...وسيكون احتفال وداع أيضًا لجوبكو-سان

88
00:05:15,290 --> 00:05:18,370
!بصحّتكنّ

89
00:05:34,860 --> 00:05:37,320
.جهّزنا سنبتسو من أجل جوبكو-سان

90
00:05:37,320 --> 00:05:38,810
سنبتسو؟

91
00:05:39,300 --> 00:05:42,980
."أعتقد أنّ بالإمكان وصفها بـ"هديّة وداع

92
00:05:42,980 --> 00:05:44,650
!فهمت

93
00:05:45,220 --> 00:05:46,900
.هذه سوكونبو

94
00:05:47,230 --> 00:05:49,210
!كلي بقدر ما تحبّين منها

95
00:05:49,650 --> 00:05:51,130
!مذهلة

96
00:05:51,130 --> 00:05:53,230
!الكثير من السّوكونبو

97
00:05:53,230 --> 00:05:54,990
!شكرًا لك يا هاروكو

98
00:05:55,760 --> 00:05:57,570
!وهذه منّي

99
00:05:57,570 --> 00:05:58,270
ماذا؟

100
00:05:58,920 --> 00:06:02,920
جوبكو-تشان

101
00:05:58,920 --> 00:06:02,920
شــكــرًا لك

102
00:06:00,100 --> 00:06:02,390
أهذه أنا؟

103
00:06:02,920 --> 00:06:05,130
!إنّها مذهلة يا سيروفو-سان

104
00:06:05,130 --> 00:06:07,560
.عليك رسمي بشكل أظرف

105
00:06:07,560 --> 00:06:11,110
!بورين من صنعت الإطار

106
00:06:11,110 --> 00:06:12,810
أليس جميلاً؟

107
00:06:14,300 --> 00:06:17,070
،بما أنّكما تكبّدتما كلّ هذا العناء
.أفترض أنّني سأقبل بها

108
00:06:18,990 --> 00:06:21,280
...لم أكن واثقة ما أفضل هديّة، لكن

109
00:06:22,060 --> 00:06:25,300
.هذه مجموعة كاملة لمانغا فتيات عبّاد الشّمس

110
00:06:25,900 --> 00:06:27,930
هل اشترينا نفس الشّيء؟

111
00:06:27,930 --> 00:06:29,130
.لا

112
00:06:29,130 --> 00:06:33,890
أحضرتُ لها المجموعة الكاملة للعمل
.الأصليّ، روايات فتيات عبّاد الشّمس

113
00:06:34,690 --> 00:06:36,300
.كم أراحني هذا

114
00:06:36,750 --> 00:06:38,860
.حاولي قراءة كليهما

115
00:06:38,860 --> 00:06:41,970
أعتقد أنّها ستساعدك في تحسين
.قراءتك وكتابتك لليابانيّة

116
00:06:41,970 --> 00:06:43,950
!شكرًا جزيلاً

117
00:06:44,330 --> 00:06:47,020
!تاكومين! رئيسة النّادي

118
00:06:47,020 --> 00:06:49,410
."هذا ما يمكن تصميته بـ"التّبشير

119
00:06:49,410 --> 00:06:52,390
متى تعلّمتِ تلك الكلمة؟

120
00:06:54,730 --> 00:06:57,110
.هديّتي قادمة من بلادي

121
00:06:57,110 --> 00:06:58,440
.زئير

122
00:06:58,440 --> 00:07:00,530
.شـ-شكرًا لك يا شي

123
00:07:01,670 --> 00:07:03,520
،حتّى بعد عودتك إلى الولايات المتّحدة

124
00:07:03,520 --> 00:07:05,960
فلا تنسينا، موافقة؟

125
00:07:06,740 --> 00:07:09,160
...حتّى إن حاولت نسيانكنّ

126
00:07:09,940 --> 00:07:12,520
!فلن أتمكّن أبدًا من ذلك

127
00:07:12,520 --> 00:07:14,260
!سيروفو! هل أنت بخير؟

128
00:07:18,330 --> 00:07:19,610
.جوبكو-سان

129
00:07:20,740 --> 00:07:22,470
.خذي هذا المنديل رجاءً

130
00:07:25,830 --> 00:07:28,780
.سأستعيره في كلّ الأحوال رغم أنّني لا أبكي

131
00:07:28,780 --> 00:07:30,090
...هذا مؤلم

132
00:07:31,340 --> 00:07:33,760
...إن شعرتنّ بالوحدة

133
00:07:34,810 --> 00:07:37,910
.فلن أمانع العودة إلى هنا في الحال

134
00:07:39,870 --> 00:07:42,750
.أكيد، تعالي متى شئت

135
00:07:42,750 --> 00:07:45,450
يا إلهي. لا يمكنك التّحدّث بصراحة أبدًا، صحيح؟

136
00:07:46,640 --> 00:07:49,530
!إن أردتنّ ذلك منّي، فلن أمانع العودة

137
00:07:49,530 --> 00:07:52,270
.جوبكوتشي، أنت ظريفة جدًّا، مياو

138
00:07:57,530 --> 00:08:00,540
نادي د إ ي

139
00:08:00,740 --> 00:08:06,040
لا أصدّق أنّ خطّة زيادة عضوات
...النّادي انتهت ببناء منزل شجرة

140
00:08:06,040 --> 00:08:07,790
!معك حقّ

141
00:08:07,790 --> 00:08:12,290
.ولكن في النّهاية، لم نحصل على أيّ عضوات جديدات

142
00:08:12,290 --> 00:08:16,330
.نعم. لن نتمكّن من الحصول على ميزانيّة النّادي بعد الآن

143
00:08:16,850 --> 00:08:19,940
.ولكن لا أرى مانعًا في ذلك

144
00:08:21,050 --> 00:08:23,550
فقبل كلّ شيء، سيعني ذلك أنّنا
.لن نحصل على ميزانيّة فحسب

145
00:08:24,050 --> 00:08:27,020
.لكن سيشكّل ذلك تحدّيًا كبيرًا لنا

146
00:08:27,570 --> 00:08:31,070
.ومع ذلك، الأمر تمامًا كما قلتِ يا سيروفو-سان

147
00:08:31,070 --> 00:08:32,270
.نعم

148
00:08:32,270 --> 00:08:36,060
.بإمكاننا مواصلة صنع أشياء صغيرة وبيعها فحسب

149
00:08:36,060 --> 00:08:38,720
...وإن جمعنا أشياء لا يحتاجها الآخرون

150
00:08:38,720 --> 00:08:40,690
!سيكون كلّ شيء على ما يرام بطريقة أو بأخرى، مياو

151
00:08:40,690 --> 00:08:45,200
بنفس الطّريقة الّتي بنينا بها المخبأ السّرّيّ... صحيح؟

152
00:08:45,200 --> 00:08:46,920
.بالضّبط

153
00:08:51,230 --> 00:08:52,370
...أنا

154
00:08:52,880 --> 00:08:56,090
!"سعيدة جدًّا لأنّني انضممت لنادي "د إ ي

155
00:08:56,090 --> 00:08:57,830
!و-وكذلك أنا

156
00:08:57,830 --> 00:08:58,780
!وأنا أيضًا

157
00:08:58,780 --> 00:09:00,120
!وأنا

158
00:09:01,860 --> 00:09:05,140
.إنّ ملاقاتكنّ جميعًا جعلتني سعيدة جدًّا أيضًا

159
00:09:05,720 --> 00:09:07,350
!سأعتمد عليكنّ من الآن فصاعدًا

160
00:09:07,350 --> 00:09:08,700
!أجل

161
00:09:07,350 --> 00:09:08,700
!بالطّبع

162
00:09:07,350 --> 00:09:08,700
!مياو

163
00:09:12,270 --> 00:09:13,480
...المعذرة

164
00:09:15,120 --> 00:09:18,640
."كنّا نتساءل كيف هو نادي "د إ ي

165
00:09:18,640 --> 00:09:20,900
هل نستطيع دخول منزل الشّجرة؟

166
00:09:25,820 --> 00:09:27,160
!تفضّلا

167
00:09:27,160 --> 00:09:28,790
!شكرًا لكنّ

168
00:09:31,810 --> 00:09:34,510
حسنًا. أهذا كلّ شيء؟

169
00:09:35,320 --> 00:09:39,420
.جوبكو-سان، هذه آخر حقيبة

170
00:09:39,420 --> 00:09:41,560
هل أغلقها؟

171
00:09:41,560 --> 00:09:42,600
.حسنًا

172
00:09:43,570 --> 00:09:44,760
!توقّفا

173
00:09:45,600 --> 00:09:46,880
ماما؟

174
00:09:46,880 --> 00:09:48,240
.نسيت شيئًا

175
00:09:51,570 --> 00:09:53,100
تحبّين هذه، صحيح؟

176
00:09:53,410 --> 00:09:54,700
.خذيها معك

177
00:09:55,350 --> 00:09:56,420
!مذهل

178
00:09:56,420 --> 00:09:59,390
!الكثير الكثير من السّوكونبو

179
00:09:58,060 --> 00:10:00,830
تضاعفت السّوكونبو الّتي معك الآن، صحيح؟

180
00:10:00,830 --> 00:10:03,870
!شكرًا يا والدة بودينغ

181
00:10:04,210 --> 00:10:05,600
.على الرّحب

182
00:10:06,290 --> 00:10:10,370
.ميكو، أنا متّجهة في رحلة عمل للنّرويج

183
00:10:10,680 --> 00:10:12,930
.ستكونين هنا بمفردك لحوالي أسبوع

184
00:10:12,930 --> 00:10:15,640
.سأتطلّع قُدمًا لتذكارات من النّرويج

185
00:10:15,640 --> 00:10:17,380
سردين معلّب بالزّين، صحيح؟

186
00:10:18,250 --> 00:10:19,890
...بشأن هذه الأرجوحة

187
00:10:19,890 --> 00:10:20,690
.أعلم

188
00:10:20,690 --> 00:10:23,640
يترك الطّائر المغادر عشّه نظيفًا"، صحيح؟"

189
00:10:23,990 --> 00:10:28,260
،سأرسل بعد المتعهّدين ليأتوا لاحقًا
!لذلك لا يوجد أيّ داع للقلق

190
00:10:28,260 --> 00:10:29,710
.لا داعي لذلك

191
00:10:31,240 --> 00:10:33,270
،سأتركها كما هي

192
00:10:33,270 --> 00:10:34,900
.لذلك عودي متى شئت

193
00:10:36,500 --> 00:10:37,630
!أكيد

194
00:10:38,880 --> 00:10:41,170
.مع السّلامة إذًا يا جوبكو-تشان

195
00:10:43,280 --> 00:10:44,770
!أبليت حسنًا

196
00:10:52,010 --> 00:10:54,500
!شكرًا على كلّ شيء

197
00:10:54,790 --> 00:10:57,260
!كان الأوهاغي لذيذًا

198
00:10:57,780 --> 00:10:59,640
!سأعدّه لك ثانية

199
00:11:00,000 --> 00:11:03,350
!كم هذا رائع! كم هذا رائع! كم هذا رائع

200
00:11:01,060 --> 00:11:04,010
!هذا ممتاز يا والدة بودينغ

201
00:11:05,720 --> 00:11:07,630
يا جوبكو-تشان؟

202
00:11:07,630 --> 00:11:08,760
ماذا هنالك؟

203
00:11:09,160 --> 00:11:13,140
هل أنت واثقة أنّه ليس عليّ المجيء
معك للمطار لتوديعك؟

204
00:11:13,140 --> 00:11:14,520
.لا بأس

205
00:11:14,520 --> 00:11:18,700
.طلبتُ ليموزين، لذلك لن أضيع أو ما شابه

206
00:11:18,700 --> 00:11:19,700
...ومع ذلك

207
00:11:19,700 --> 00:11:22,290
...كما أنّك إن فعلتِ أمرًا كهذا

208
00:11:22,620 --> 00:11:24,860
فسيكون من الصّعب عليّ المغادرة، صحيح؟

209
00:11:26,200 --> 00:11:27,330
.هذا صحيح

210
00:11:28,020 --> 00:11:30,950
.أعتقد... أنّني سأصير وحيدة نوعًا ما

211
00:11:31,860 --> 00:11:34,310
.هذه صاحة نادرة منك

212
00:11:34,720 --> 00:11:37,050
لا بأس أن تكون لنا أيّام كهذه، صحيح؟

213
00:11:39,500 --> 00:11:41,690
...المخبأ السّرّيّ المكتمل

214
00:11:41,690 --> 00:11:46,050
...لا يبدو مثل الّذي بنيته مع أمّي على الإطلاق

215
00:11:47,560 --> 00:11:50,790
!لكنّ المتعة الّتي عشتها بينما نبنيه كانت هي نفسها

216
00:11:50,790 --> 00:11:54,020
!لا، بل كان ممتعًا أكثر

217
00:11:55,950 --> 00:12:01,060
سبب مجيئي إلى اليابان للدّراسة
.هو لأتمكّن من الابتعاد عن بابا قليلاً

218
00:12:01,820 --> 00:12:07,940
...منذ وفاة ماما، صار بابا مكتئبًا أكثر فأكثر

219
00:12:09,070 --> 00:12:12,700
...وقلّ حديثه معي

220
00:12:16,450 --> 00:12:21,760
عندما سأعود للمنزل، أعتقد أنّني
!سأخبره كيف بنيت منزل الشّجرة

221
00:12:22,460 --> 00:12:24,440
.واثقة أنّ ذلك سيسعده كثيرًا

222
00:12:25,040 --> 00:12:26,020
!نعم

223
00:12:27,660 --> 00:12:30,230
...إنّ قول ما نريده فعلاً

224
00:12:30,970 --> 00:12:34,900
.سيجعل الأمور أسهل لكلينا يا بودينغ

225
00:12:35,340 --> 00:12:36,520
.هذا صحيح

226
00:12:36,920 --> 00:12:40,810
تعرفين كيف يمكن لسيروفو أن تبدو
أنّها لا تراعي الآخرين أحيانًا، صحيح؟

227
00:12:40,810 --> 00:12:41,730
.أعرف

228
00:12:42,330 --> 00:12:44,030
،إنّها خرقاء في تصرّفاتها

229
00:12:44,420 --> 00:12:45,440
.وتؤذي نفسها كثيرًا

230
00:12:46,490 --> 00:12:48,160
.لا أستطيع تركها وحدها

231
00:12:49,400 --> 00:12:53,700
لكن بما أنّها كذلك، أعتقد أنّ بالإمكان
...وصف الأمر وكأنّني أعتني بها

232
00:12:54,400 --> 00:12:56,330
.تواجدي معها يسعدني

233
00:12:57,160 --> 00:13:01,160
لماذا إذًا أجدك دائمًا "بوري بوري" من الغضب؟

234
00:13:01,160 --> 00:13:03,070
لماذا؟

235
00:13:03,070 --> 00:13:07,450
لأنّ سيروفو قد تكون غير مراعية
!وتدفعني للتّصرّف كهذا

236
00:13:07,450 --> 00:13:08,400
.أعلم

237
00:13:08,400 --> 00:13:11,670
:كلاّ! كنت صريحة أكثر من اللاّزم

238
00:13:11,670 --> 00:13:14,930
.إذًا سأكون أنا أيضًا صريحًا

239
00:13:15,180 --> 00:13:19,130
.أودّ فعلاً تثبيت نظام تشغيلي جديد

240
00:13:21,790 --> 00:13:25,220
لا تستطيع فعلاً قراءة الأجواء، صحيح؟

241
00:14:05,540 --> 00:14:08,090
!جوبكو-تشان، إلى اللّقاء ثانية

242
00:14:12,580 --> 00:14:14,570
لقد غادرت، صحيح؟

243
00:14:15,650 --> 00:14:17,340
.نعم، غادرت

244
00:14:18,500 --> 00:14:21,320
!والآن، سنذهب أيضًا

245
00:14:22,230 --> 00:14:23,580
إلى أين؟

246
00:14:28,910 --> 00:14:31,550
.ميكو-سان، الجوّ ساخن في الخارج

247
00:14:31,550 --> 00:14:35,760
.احرصي على شرب الماء والحذر في طريقك

248
00:14:35,760 --> 00:14:40,360
حتّى صوتك تغيّر بعد تحديث نظام تشغيلك، صحيح؟

249
00:14:40,730 --> 00:14:43,610
.الحياة أشبه بنهر متدفّق

250
00:14:41,670 --> 00:14:43,440
.أنا مغادرة

251
00:14:43,610 --> 00:14:45,140
—على كلّ الأحياء أن

252
00:14:46,880 --> 00:14:49,200
لماذا نحن في النّادي؟

253
00:14:49,200 --> 00:14:51,480
أليس هذا يوم إجازتنا؟

254
00:14:51,480 --> 00:14:53,460
.إنّنا نفتقد لشيء ما

255
00:14:53,460 --> 00:14:54,780
شيء ما؟

256
00:14:55,110 --> 00:14:56,110
.هذا

257
00:14:56,370 --> 00:14:58,290
نادي د إ ي

258
00:14:56,780 --> 00:14:58,750
!أرجوحة

259
00:14:59,610 --> 00:15:01,390
أصممّتِ هذا يا بورين؟

260
00:15:01,750 --> 00:15:04,600
.هذا صحيح. سنصنعه معًا

261
00:15:04,600 --> 00:15:07,560
...صحيح! ولكنّ الموادّ

262
00:15:09,890 --> 00:15:13,130
...أشعر بالسّوء على عضوات الجيل الأوّل

263
00:15:13,360 --> 00:15:16,630
لكن لا أجد مانعًا من نزع بعض الألواح، صحيح؟

264
00:15:16,630 --> 00:15:17,860
.ذلك صحيح

265
00:15:18,450 --> 00:15:20,090
...لحظة

266
00:15:23,470 --> 00:15:24,470
!لدينا هذا أيضًا

267
00:15:24,970 --> 00:15:26,710
...بورين! هذا

268
00:15:26,710 --> 00:15:27,890
.احتفظتُ به جانبًا

269
00:15:28,260 --> 00:15:31,480
.هيّا. لا تقفي هناك مندهشة فحسب
!انزعي بعض الألواح

270
00:15:31,480 --> 00:15:32,640
!حـ-حسنًا

271
00:15:32,930 --> 00:15:34,670
كوني حذرة، مفهوم؟

272
00:15:34,670 --> 00:15:36,000
!حاضرة

273
00:15:41,910 --> 00:15:44,650
.مع أنّي أخبرتك أن تكوني حذرة

274
00:15:48,730 --> 00:15:50,200
ما الأمر؟

275
00:15:50,780 --> 00:15:54,180
كنت أفكّر أنّه قد مرّ وقت طويل منذ آخر
.مرّة وضعتُ لك فيها ضمادة يا سيروفو

276
00:15:54,180 --> 00:15:58,600
صحيح. كنت تفعلين ذلك دائمًا، صحيح؟

277
00:15:58,600 --> 00:16:01,750
لم يكن ذلك دائمًا فحسب، بل كان
!عدّة مرّات في نفس اليوم أيضًا

278
00:16:02,480 --> 00:16:05,690
...لكن بالنّسبة لي

279
00:16:06,000 --> 00:16:07,120
بورين؟

280
00:16:07,690 --> 00:16:10,000
!لا-لا شيء

281
00:16:10,000 --> 00:16:11,480
!حسنًا. لنقم بهذا

282
00:16:11,480 --> 00:16:12,330
!نعم

283
00:16:12,820 --> 00:16:15,820
الخلف

284
00:16:12,820 --> 00:16:15,820
المقعد

285
00:16:35,950 --> 00:16:37,920
مائيّ

286
00:16:35,950 --> 00:16:37,920
دهان خشب

287
00:17:03,020 --> 00:17:04,600
!انتهينا

288
00:17:04,950 --> 00:17:06,690
!اجلسي عليه يا بورين

289
00:17:06,690 --> 00:17:08,780
.عليك الجلوس عليه أوّلاً يا سيروفو

290
00:17:08,780 --> 00:17:10,670
!لا بأس! لا بأس

291
00:17:10,670 --> 00:17:12,640
!حـ-حسنًا، لنجلس معًا

292
00:17:12,640 --> 00:17:15,150
!نعم! اقتراح جيّد

293
00:17:26,560 --> 00:17:30,340
.تبدين سعيدة جدًّا لسبب ما يا بورين

294
00:17:32,160 --> 00:17:33,560
...اسمعي يا سيروفو

295
00:17:34,540 --> 00:17:40,570
.ثمّة أمر... عليّ إخبارك به

296
00:17:40,920 --> 00:17:41,980
ما هو؟

297
00:17:42,440 --> 00:17:48,560
قلتُ أنّ نادي "د إ ي" عفن
...ولا فائدة منه، لكن

298
00:17:50,410 --> 00:17:52,580
!استمتعتُ بوقتي كثيرًا فيه

299
00:17:52,580 --> 00:17:56,670
.شكرًا على دعوتك لي يا سيروفو

300
00:17:57,310 --> 00:17:58,500
...بورين

301
00:17:59,180 --> 00:18:00,630
...وأيضًا

302
00:18:02,210 --> 00:18:03,230
.أنا آسفة

303
00:18:03,230 --> 00:18:03,910
ماذا؟

304
00:18:04,660 --> 00:18:06,310
ماذا قلت؟

305
00:18:06,680 --> 00:18:08,230
.سيروفو الغبيّة

306
00:18:08,720 --> 00:18:11,510
.هيّا يا بورين. إنّك تغضبين بسرعة

307
00:18:12,190 --> 00:18:13,770
وذلك خطأ من في رأيك؟

308
00:18:13,770 --> 00:18:14,630
!ماذا؟

309
00:18:14,630 --> 00:18:17,440
!على أيّ حال، أنت من قالها يا سيروفو

310
00:18:18,870 --> 00:18:20,580
...يا بورين

311
00:18:20,570 --> 00:18:27,580
تهانينا
على الدّخول
المدرسيّ

312
00:18:20,580 --> 00:18:23,820
،بما أنّي في الإعداديّة الآن

313
00:18:23,820 --> 00:18:26,260
!سأبلغ مرحلة أستطيع فيها القيام بكلّ شيء وحدي

314
00:18:26,260 --> 00:18:27,150
ماذا؟

315
00:18:27,580 --> 00:18:30,800
!لذلك، سأكون بخير الآن

316
00:18:35,560 --> 00:18:41,040
.لم أكن اكره الاعتناء بك يا سيروفو

317
00:18:41,040 --> 00:18:42,480
...حتّى إن واصلتِ الاعتماد عليّ

318
00:18:42,480 --> 00:18:44,550
هل قلتُ ذلك؟

319
00:18:44,830 --> 00:18:46,190
!قلتِ ذلك بكلّ تأكيد

320
00:18:46,190 --> 00:18:50,230
.حـ-حسنًا، لا بأس، صحيح؟ كان ذلك في الماضي

321
00:18:52,320 --> 00:18:54,120
...يا إلهي

322
00:18:54,650 --> 00:18:57,570
إذًا لا تذكرين هذا أيضًا، صحيح؟

323
00:18:58,140 --> 00:19:00,560
!مخبأ سرّيّ

324
00:19:00,560 --> 00:19:02,400
مخبأ سرّيّ؟

325
00:19:03,260 --> 00:19:06,360
!أودّ بناء مخبأ سرّيّ على شجرة

326
00:19:06,670 --> 00:19:10,540
!وسأعلّق عليه جرس الرّياح خاصّتك يا بورين

327
00:19:10,880 --> 00:19:14,180
ماذا؟ أقلتُ ذلك فعلاً؟

328
00:19:14,180 --> 00:19:15,520
.عرفتُ هذا

329
00:19:16,230 --> 00:19:19,890
.وأراهن أنّك أضعتِ جرس الرّياح الّذي أعطيتك إيّاه أيضًا

330
00:19:20,250 --> 00:19:21,410
!ما زلت أحتفظ به

331
00:19:21,410 --> 00:19:22,270
!ماذا؟

332
00:19:22,620 --> 00:19:24,650
!لأنّه شيء أهديته لي يا بورين

333
00:19:28,730 --> 00:19:31,130
.احتفظتُ به في مكان آمن بكلّ حذر

334
00:19:32,320 --> 00:19:34,010
!إنّه كنزي

335
00:19:36,540 --> 00:19:37,660
!صحيح

336
00:19:37,660 --> 00:19:39,850
!أستطيع الذّهاب لإحضاره لنعلّقه الآن

337
00:19:39,850 --> 00:19:44,920
،ماذا؟ لكن بما أنّك ما زلت تحتفظين به
!عـ-عليك إبقاؤه معك

338
00:19:45,180 --> 00:19:47,640
...فعلاً؟ لكنّ المخبأ السّرّيّ قد

339
00:19:47,640 --> 00:19:49,170
تعتبرينه كنزًا، صحيح؟

340
00:19:49,580 --> 00:19:51,660
.احتفظي به حيث هو إذًا

341
00:19:51,660 --> 00:19:53,540
.حا-حاضرة

342
00:19:53,540 --> 00:19:56,050
نادي د إ ي

343
00:19:56,630 --> 00:19:58,850
،إن أردنا جرس رياح للمخبأ السّرّيّ

344
00:19:59,270 --> 00:20:00,970
.بإمكاننا صناعة واحد فحسب

345
00:20:01,990 --> 00:20:03,930
.فكّرتُ أنّ بمقدورنا استعمال هذه

346
00:20:03,930 --> 00:20:06,980
هل التقطت كلّ هذا من الشّاطئ؟

347
00:20:06,980 --> 00:20:07,880
.صحيح

348
00:20:08,320 --> 00:20:10,200
!مذهل

349
00:20:10,470 --> 00:20:12,530
!إنّها جميلة

350
00:20:13,390 --> 00:20:15,640
.تبدو وكأنّها ستصدر صوتًا جميلاً

351
00:20:16,060 --> 00:20:17,390
!حسنًا

352
00:20:17,390 --> 00:20:20,270
!سنصنع جرس رياح جديد

353
00:20:21,060 --> 00:20:21,740
!بورين

354
00:20:28,620 --> 00:20:30,300
...دو إت"

355
00:20:33,970 --> 00:20:37,120
"!يورسلف