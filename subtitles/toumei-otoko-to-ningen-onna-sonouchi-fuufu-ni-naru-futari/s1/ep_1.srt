1
00:00:13,200 --> 00:00:14,530
تونومي-سان؟

2
00:00:15,450 --> 00:00:17,280
أتمانعين لو جلستُ قربك؟

3
00:00:17,280 --> 00:00:18,950
.لا، تفضل

4
00:00:21,830 --> 00:00:24,210
كيف عرفتِ أنّي من جلستُ قربك؟

5
00:00:24,790 --> 00:00:27,540
.ظننتُ أنّك عمياء

6
00:00:28,210 --> 00:00:31,050
.بإمكاني شمّ رائحتك يا تونومي-سان

7
00:00:32,670 --> 00:00:35,470
!لم أقصد بذلك أنّ رائحتك سيّئة

8
00:00:35,470 --> 00:00:37,640
هل لديّ رائحة معيّنة؟

9
00:00:37,640 --> 00:00:39,220
!كـ-كلاّ

10
00:00:39,220 --> 00:00:43,560
إ-إنّ حاسّتَيْ الشّمّ والسّمع لديّ أقوى
!من معظم النّاس بما أنّي لا أستطيع الرّؤية

11
00:00:46,560 --> 00:00:50,150
لا بدّ إذًا أنّ لديك حاسّة شمّ
.حادّة يا ياكو-سان

12
00:00:50,150 --> 00:00:52,400
.لا يمكنني شمّ رائحتي الخاصّة على الإطلاق

13
00:00:52,400 --> 00:00:55,530
!نعم! أنا فعلاً لم أقصد أنّ رائحتك سيّئة

14
00:00:57,490 --> 00:01:01,700
.من اللّطيف معرفة أنّ لديّ رائحتي الخاصّة

15
00:01:07,830 --> 00:01:09,130
تونومي-سان؟

16
00:01:09,460 --> 00:01:12,880
ياكو-سان، أين أنا الآن؟

17
00:01:27,900 --> 00:01:30,270
أنت هنا، صحيح؟

18
00:01:32,440 --> 00:01:36,650
أعتقد أنّك الشّخص الوحيد
.الّذي بإمكانه العثور عليّ

19
00:01:37,200 --> 00:01:39,910
.جعل ذلك دقّات قلبي تتسارع

20
00:01:40,320 --> 00:01:41,830
قلبك؟

21
00:01:47,250 --> 00:01:49,670
هلاّ خرجتِ للعشاء معي هذا المساء؟

22
00:01:52,590 --> 00:01:54,300
أتفضّلين طعامًا معيّنًا؟

23
00:01:54,300 --> 00:01:57,800
الغربيّ أو الصّينيّ أو اليابانيّ؟

24
00:01:57,800 --> 00:01:59,930
!أيّ منها سيكون مناسبًا لي

25
00:02:00,510 --> 00:02:02,510
وهل لديك أيّ حساسيّات؟

26
00:02:02,510 --> 00:02:03,720
.لا، أنا بخير

27
00:02:04,140 --> 00:02:07,020
هل تفضّلين مطعمًا معيّنًا؟

28
00:02:07,020 --> 00:02:14,230
،حسنًا... أنا لا آكل في الخارج كثيرًا
.لذلك أذهب إلى الأماكن المعتادة

29
00:02:14,230 --> 00:02:17,400
!سأكون مسرورة بأيّ شيء توصي به

30
00:02:19,740 --> 00:02:22,830
جيّد. ثمّة مكان كنتُ أريد زيارته
.منذ مدّة في الحقيقة

31
00:02:22,830 --> 00:02:26,250
!نعم، ذلك يبدو رائعًا
!هذا هو إذًا! لنذهب إليه

32
00:02:26,250 --> 00:02:27,960
.حسنًا، لنغادر

33
00:02:29,670 --> 00:02:31,580
.أمسكي بذراعي رجاءً

34
00:02:38,170 --> 00:02:39,430
.سأبدأ السّير

35
00:02:39,760 --> 00:02:40,800
.حسنًا

36
00:02:49,480 --> 00:02:53,400
...ماذا؟ إيقاع خُطاه غير منتظم

37
00:02:53,770 --> 00:02:55,770
هل هنالك خطب ما؟

38
00:02:56,610 --> 00:03:00,650
أيُعقل أنّه لم يكن لديه مكان
!محدّد في ذهنه من الأساس؟

39
00:03:01,450 --> 00:03:06,660
تونومي-سان، أعتذر لأنّه لم تكن لديّ
!تفضيلات محدّدة وألقيت كلّ العبء عليه

40
00:03:06,660 --> 00:03:07,540
.ياكو-سان

41
00:03:07,540 --> 00:03:08,660
!ما-ماذا؟

42
00:03:08,660 --> 00:03:12,880
هل هنالك اتّجاه تبدو رائحته شهيّة لك؟

43
00:03:15,920 --> 00:03:17,300
.مِن هنا

44
00:03:17,670 --> 00:03:19,420
.حسنًا، سرّني هذا

45
00:03:19,760 --> 00:03:24,050
.كنتُ قلقًا ألاّ يكون على ذوقك

46
00:03:24,430 --> 00:03:27,390
.شكرًا لمساعدتي في اتّخاذ القرار

47
00:03:28,930 --> 00:03:31,480
.كلاّ، بل شكرًا لك لأنّك سألت

48
00:03:31,480 --> 00:03:32,650
!أتشوّق لتجربته

49
00:03:32,650 --> 00:03:34,480
.وكذلك أنا

50
00:03:36,400 --> 00:03:40,440
،هذه أوّل مرّة أزور فيها المكان
.لذلك طلبتُ ما أوصوا به

51
00:03:41,740 --> 00:03:44,910
.لم أشمّ أيّ شيء كهذا من قبل

52
00:03:44,910 --> 00:03:46,450
يا لها من مغامرة، صحيح؟

53
00:03:46,450 --> 00:03:47,830
!إنّها مغامرة بالفعل

54
00:03:51,500 --> 00:03:54,580
هذه... خضروات، صحيح؟
.هذا مثير للاهتمام

55
00:03:54,580 --> 00:03:56,460
.على الأرجح أنّها كزبرة

56
00:04:00,170 --> 00:04:04,050
هذه أوّل مرّة آكل فيها في مطعم
.مع شخص من العمل

57
00:04:04,050 --> 00:04:05,470
فعلاً؟

58
00:04:05,470 --> 00:04:07,890
—لذلك كنتُ أفكّر كم أنّ هذا لطيـ

59
00:04:10,640 --> 00:04:12,690
.جعل ذلك دقّات قلبي تتسارع

60
00:04:12,690 --> 00:04:14,980
هلاّ خرجتِ للعشاء معي هذا المساء؟

61
00:04:16,440 --> 00:04:20,440
ركّزتُ كثيرًا على أنّي لم أقم بهذا
...من قبل لدرجة أنّي لم أدرك

62
00:04:20,440 --> 00:04:23,400
!هل يُعتبر هذا موعدًا غراميًّا؟

63
00:04:24,070 --> 00:04:27,740
،لكنّه لم يصفه كذلك
!لذلك قد لا يكون موعدًا

64
00:04:27,740 --> 00:04:28,870
.ياكو-سان

65
00:04:29,580 --> 00:04:31,290
.هذا لذيذ أيضًا

66
00:04:31,290 --> 00:04:33,580
...سأضعه في طبقك، هنا

67
00:04:34,120 --> 00:04:35,870
.في اتّجاه الثّانية عشر

68
00:04:35,870 --> 00:04:37,540
!حسنًا، شكرًا لك

69
00:04:40,050 --> 00:04:41,130
هل من خطب ما؟

70
00:04:41,130 --> 00:04:47,180
لا. هذه أوّل مرّة أتناول فيها
.العشاء وحدي مع رجل

71
00:04:47,180 --> 00:04:51,140
،وكنتُ أقول لنفسي، "يا إلهي
"...يبدو هذا كأنّه موعد

72
00:04:51,140 --> 00:04:52,560
.كانت تلك نيّتي

73
00:04:53,230 --> 00:04:54,560
هل جعلك ذلك تتوتّرين؟

74
00:04:54,560 --> 00:04:57,440
...إ-إنّ ذلك... يمكنك قول هذا

75
00:04:57,440 --> 00:05:01,570
.بالغتُ في التّفكير في الأمر
.يا له من إحراج

76
00:05:04,450 --> 00:05:07,570
.ياكو-سان، أريني يديك للحظة

77
00:05:11,330 --> 00:05:15,830
أنا غير مرئيّ، لذلك يصعب على
،معظم النّاس ملاحظة الأمر

78
00:05:17,580 --> 00:05:21,300
،لكنّني ظننتُ أنّك قد تشعرين به
.حتّى من خلال ملابسي

79
00:05:25,720 --> 00:05:30,550
لا أريدك أن تعتقدي أنّك الوحيدة
.الّتي تشعر بالتّوتّر

80
00:05:30,550 --> 00:05:33,140
!تونومي-سان، ينبض قلبك بشدّة أيضًا

81
00:05:33,140 --> 00:05:35,100
.آمل ألاّ تنشري عدوى ذلك للجميع

82
00:05:37,730 --> 00:05:39,310
ألم يكن العشاء لذيذًا؟

83
00:05:39,310 --> 00:05:41,320
.أنا مسرور لأنّه مرّ على أحسن ما يرام

84
00:05:41,320 --> 00:05:44,570
.نـ-نعم، أوافقك تمامًا

85
00:05:45,320 --> 00:05:47,070
.والآن، أمسكي بذراعي

86
00:05:47,070 --> 00:05:48,660
.سأرشدك إلى المحطّة

87
00:05:55,950 --> 00:05:58,920
ما زال قلبي يخفق بسرعة
!بسبب ما حدث قبل قليل

88
00:06:04,170 --> 00:06:06,840
ألن يكون من الآمن إن أمسكت به بشدّة؟

89
00:06:06,840 --> 00:06:10,590
!لا! عكّازي معي، لذلك يمكنني السّير جيّدًا

90
00:06:10,590 --> 00:06:12,180
أأنت واثقة؟

91
00:06:12,640 --> 00:06:14,470
...أ-أعني

92
00:06:14,470 --> 00:06:16,270
!لم أقصد أنّي أنفر منك أو ما شابه

93
00:06:16,270 --> 00:06:19,310
...بل... إنّني فقط كنتُ

94
00:06:20,600 --> 00:06:23,070
ربّما العكس هو الصّحيح؟

95
00:06:25,280 --> 00:06:28,280
تونومي-سان، هل تبتسم لي الآن؟

96
00:06:28,280 --> 00:06:29,820
ماذا؟ أعرفتِ ذلك؟

97
00:06:29,820 --> 00:06:32,200
!بالكاد تستطيع إخفاء ذلك

98
00:06:33,990 --> 00:06:36,080
.ما كنتُ لأخفي ذلك أبدًا

99
00:06:36,750 --> 00:06:38,410
.أُفضّل أن تعرفي بذلك

100
00:06:42,670 --> 00:06:45,550
.في الحقيقة، أشعر برغبة بالسّير قفزًا الآن

101
00:06:45,550 --> 00:06:47,880
ماذا عنك؟ أتريدين السّير قفزًا معي؟

102
00:06:47,880 --> 00:06:49,010
!كـ-كلاّ

103
00:06:49,010 --> 00:06:51,090
!وليس عليك ذلك أيضًا

104
00:06:51,090 --> 00:06:52,550
.كم هذا مؤسف

105
00:06:53,680 --> 00:06:59,640
في تلك الحالة، سأكبح نفسي
.وأرافقك بطريقة لائقة

106
00:06:59,640 --> 00:07:02,480
...حـ-حسنًا

107
00:07:26,300 --> 00:07:33,010
هـ-هل سارت الأمور بشكل جـ-جيّد
!بالفعل مع تونومي-سان اليوم؟

108
00:07:35,680 --> 00:07:37,810
.الحمّام جاهز

109
00:07:38,470 --> 00:07:40,230
.أظنّني سأذهب للاستحمام

110
00:07:45,560 --> 00:07:48,070
تونومي-سان؟

111
00:07:48,070 --> 00:07:50,490
،منذ أوّل حديث لنا خلال مقابلة عملي

112
00:07:50,490 --> 00:07:54,280
.بدا دائمًا لطيفًا في تصرّفاته

113
00:07:56,990 --> 00:07:58,410
.ياكو-سان

114
00:07:58,410 --> 00:08:00,750
صوته وطريقة كلامه يبعثان
.على الطّمأنينة إلى حدّ كبير

115
00:08:01,330 --> 00:08:04,710
.يمكنني سماع مدى الأناقة الّتي يتحرّك بها

116
00:08:07,460 --> 00:08:12,550
!لا يسعني إلاّ أن أشعر أنّه شخص رائع

117
00:08:12,550 --> 00:08:16,090
مهلاً، مهلاً! خرجتما للعشاء
!معًا مرّة واحدة فقط

118
00:08:16,090 --> 00:08:17,720
!لا تستبقي الأمور

119
00:08:19,310 --> 00:08:24,310
.أتساءل ما رأي تونومي-سان فيّ

120
00:08:25,980 --> 00:08:27,520
.أُفضّل أن تعرفي بذلك

121
00:08:28,110 --> 00:08:31,150
ما الّذي قصد بذلك؟

122
00:08:31,650 --> 00:08:32,780
...بالمناسبة

123
00:08:33,070 --> 00:08:36,740
.تونومي-سان رجل خفيّ

124
00:08:36,740 --> 00:08:41,250
و"خفيّ" تعني أنّ النّاس
لا يمكنهم رؤيته، صحيح؟

125
00:08:42,040 --> 00:08:46,460
إذًا حتّى المبصرون لا يمكنهم رؤيته؟
.أتساءل ما ذلك الشّعور

126
00:08:47,170 --> 00:08:48,670
...أيُعقل أنّه

127
00:08:50,170 --> 00:08:55,930
تونومي-سان، هل تتمنّى
لو كان بإمكاني رؤيتك؟

128
00:08:55,930 --> 00:08:57,390
رؤيتي؟

129
00:08:59,720 --> 00:09:01,640
.لا أعتقد ذلك

130
00:09:02,100 --> 00:09:04,060
.أنا هو الخفيّ قبل كلّ شيء

131
00:09:04,730 --> 00:09:08,770
هل تتمنّين لو تستطيعين
رؤيتي يا ياكو-سان؟

132
00:09:10,400 --> 00:09:17,070
،يمكنني معرفة أيّ نوع من النّاس أنت
.لذلك أعتقد أنّ هذا كافٍ بالنّسبة لي

133
00:09:18,740 --> 00:09:20,030
.سرّني سماع ذلك

134
00:09:21,450 --> 00:09:22,450
!حسنًا

135
00:09:23,410 --> 00:09:27,500
فهمت الآن. لا يحتاجني
!تونومي-سان أن أراه

136
00:09:46,310 --> 00:09:48,600
.كان ذلك وشيكًا يا شيزوكا

137
00:09:49,270 --> 00:09:50,810
!جاراشي-سان

138
00:09:50,810 --> 00:09:52,110
لم تتأذّي، صحيح؟

139
00:09:52,110 --> 00:09:53,610
.صـ-صحيح

140
00:09:53,610 --> 00:09:56,900
...كانت تلك درّاجتي

141
00:09:56,900 --> 00:09:58,160
.أنا آسفة

142
00:10:00,740 --> 00:10:04,290
نعم، صحيح. نحن نتولّى تحقيقات
،من مختلف الأنواع

143
00:10:04,290 --> 00:10:07,960
.بما في ذلك الأشخاص المفقودين والخلفيّات

144
00:10:07,960 --> 00:10:10,330
نعم. هل تريدون أخذ موعد؟

145
00:10:10,750 --> 00:10:14,670
حاضرة، سنعاود الاتّصال بكم
.بعد التّأكّد من الموعد

146
00:10:15,800 --> 00:10:17,380
...حسنًا

147
00:10:21,090 --> 00:10:22,890
يوجد جدار هنا؟

148
00:10:22,890 --> 00:10:24,600
من الّذي تصفينه بالجدار؟

149
00:10:24,600 --> 00:10:25,810
...أنا متعب

150
00:10:25,810 --> 00:10:27,100
!كيكيرا-سان

151
00:10:27,100 --> 00:10:29,600
.أنت تعترضين طريقي
.تراجعي خمس خطوات

152
00:10:33,610 --> 00:10:35,230
.بإمكانك المرور الآن

153
00:10:36,570 --> 00:10:39,490
.وضعتُ كوب قهوتك على يمين حاسوبك

154
00:10:41,620 --> 00:10:43,330
.شكرًا لك

155
00:10:43,330 --> 00:10:44,660
...أنا متعب

156
00:10:52,630 --> 00:10:54,800
.جاراشي-سان. كيكيرا-سان

157
00:10:55,590 --> 00:10:59,720
لا يوجد أيّ شيء غريب حيال مظهري، صحيح؟

158
00:10:59,720 --> 00:11:00,680
.لا شيء بالتّحديد

159
00:11:00,680 --> 00:11:04,220
مهلاً، مهلاً. هل تحاولين نيل
إعجاب شخص ما؟

160
00:11:06,010 --> 00:11:07,970
!تبدين جميلة اليوم يا شيزوكا

161
00:11:07,970 --> 00:11:10,520
،إن كنتِ بحاجة للحديث عن الرّومانسيّة
!فأنا الشّخص المناسب

162
00:11:10,520 --> 00:11:11,520
!الأمر ليس كذلك

163
00:11:11,520 --> 00:11:15,690
!إنّك تحمرّين خجلاً أيّتها الظّريفة الصّغيرة

164
00:11:16,530 --> 00:11:17,900
.صوتك مرتفع

165
00:11:17,900 --> 00:11:20,610
!ماذا؟! لا أريد سماع ذلك منك

166
00:11:20,610 --> 00:11:21,740
...أنا متعب

167
00:11:23,700 --> 00:11:24,990
.ياكو-سان

168
00:11:25,280 --> 00:11:26,620
تونومي-سان؟

169
00:11:26,620 --> 00:11:29,450
هل تمانعين إن لمستُ شعرك؟

170
00:11:30,250 --> 00:11:33,040
يريد لمس شعري؟

171
00:11:36,040 --> 00:11:38,210
أم أنّك لا تحبّين ذلك؟

172
00:11:39,510 --> 00:11:41,880
...يـ-يمكنك ذلك

173
00:11:42,340 --> 00:11:47,010
.يمكنني الشّعور بيد تونومي-سان تقترب منّي

174
00:11:49,100 --> 00:11:51,020
.حسنًا، هذه هي

175
00:11:51,020 --> 00:11:52,600
.علقت به بتلة براعم كرز

176
00:11:54,600 --> 00:11:56,310
لقد حلّ الرّبيع بالفعل، صحيح؟

177
00:11:56,310 --> 00:11:58,820
.نعم، شكرًا جزيلاً لك

178
00:11:58,820 --> 00:12:01,900
!أنا محرجة كم أنّ ذلك جعلني متوتّرة

179
00:12:01,900 --> 00:12:05,320
مهلاً، أيُعقل أنّ من يُعجبك هو...؟

180
00:12:05,910 --> 00:12:10,120
!تـ-تونومي-سان! حان وقت استشاراتك

181
00:12:10,120 --> 00:12:11,370
فـ-فعلاً؟

182
00:12:10,620 --> 00:12:11,660
!نعم، نعم

183
00:12:11,660 --> 00:12:13,710
!جـ-جهّزتُ كلّ المواد

184
00:12:13,710 --> 00:12:15,420
.حـ-حسنًا

185
00:12:16,210 --> 00:12:17,210
...أنا متعب

186
00:12:19,050 --> 00:12:20,420
...حسنًا إذًا

187
00:12:20,420 --> 00:12:22,420
هلاّ قدّمتِ لي التّفاصيل؟

188
00:12:22,420 --> 00:12:24,300
.لطالما كان زير نساء

189
00:12:24,300 --> 00:12:27,140
.أريد أن أحرص أنّه مخلص لي قبل أن نتزوّج

190
00:12:27,640 --> 00:12:31,100
!أنا جادّ! رأيتُ ضفدعًا يموء

191
00:12:31,100 --> 00:12:35,480
إنّه يخونني بكلّ تأكيد ويعتقد أنّي
!لا ألاحظ عندما يخرج خلسة

192
00:12:36,480 --> 00:12:38,820
.حسنًا... أخبروني بالمزيد

193
00:12:38,820 --> 00:12:40,400
.طول العمر: 80 ألف سنة

194
00:12:40,400 --> 00:12:41,860
.وُلدت قرب درب التّبّانة

195
00:12:41,860 --> 00:12:43,490
.بارعة في إنشاء الكواكب

196
00:12:43,490 --> 00:12:45,030
.قادرة على السّفر بين النّجوم

197
00:12:45,030 --> 00:12:50,160
أ-أنا بحاجة لمواصفات ابنتكم
!المفقودة الجسديّة فقط

198
00:12:50,410 --> 00:12:52,000
.قُطر حدقة العين: 5 مليمترات

199
00:12:52,000 --> 00:12:53,460
.طول الأطراف: 1 سنتيمتر

200
00:12:53,460 --> 00:12:55,370
.رطوبة الشّفاه: 10 في المائة

201
00:12:55,370 --> 00:12:56,580
.أسنان قويّة

202
00:13:00,550 --> 00:13:02,840
...كتبتُ كلّ ذلك، لكن

203
00:13:02,840 --> 00:13:06,050
.من الصّعب جدًّا التّمييز بينهم

204
00:13:06,050 --> 00:13:08,180
.أتساءل إن كنّا سنجدها

205
00:13:08,180 --> 00:13:11,310
ابحث عن شخص يبدو مثلهم
تمامًا فحسب، صحيح؟

206
00:13:24,820 --> 00:13:26,360
.المعذرة

207
00:13:26,360 --> 00:13:27,820
!شكرًا على المساعدة

208
00:13:35,000 --> 00:13:38,710
.بعض الأمور سهلة على رجل خفيّ

209
00:13:39,330 --> 00:13:43,300
عاد مباشرة للمنزل بعد اتّصالات
...المبيعات اليوم

210
00:13:43,760 --> 00:13:46,300
—والآن، سأنتظر حتّى إغلا

211
00:13:54,810 --> 00:13:56,310
!شكرًا لك

212
00:13:58,770 --> 00:14:00,190
...لا تكون الأمور سهلة دائمًا

213
00:14:00,650 --> 00:14:02,520
.بالنّسبة لرجل خفيّ

214
00:14:12,740 --> 00:14:15,750
ماذا؟ لماذا تبتسمين هكذا؟

215
00:14:15,750 --> 00:14:16,870
تفكّرين بتونومي ثانية؟

216
00:14:16,870 --> 00:14:19,040
!ماذا؟ كـ-كلاّ

217
00:14:19,040 --> 00:14:20,960
.كنتُ أستمع لكتاب

218
00:14:21,380 --> 00:14:23,960
تستمعين... لكتاب؟

219
00:14:23,960 --> 00:14:26,670
.نعم، إنّه تسجيل لشخص يقرأ الكتاب

220
00:14:26,670 --> 00:14:28,760
!نعم، فهمت

221
00:14:28,760 --> 00:14:30,930
أتريدين تجربة ذلك؟

222
00:14:34,600 --> 00:14:35,640
!كان ذلك سريعًا

223
00:14:35,640 --> 00:14:38,480
.أنا مهتمّة بالرّوايات الرّومانسيّة مؤخّرًا

224
00:14:38,480 --> 00:14:43,110
،خرجا في موعد عشاء
...ثمّ وبسبب وردة، فإنّهما

225
00:14:43,110 --> 00:14:43,940
!صرخة

226
00:14:43,940 --> 00:14:46,860
تستمعين لقصّة رومانسيّة؟

227
00:14:47,240 --> 00:14:49,950
.أنا مندهشة لقدرتك على استيعاب كلّ ذلك

228
00:14:49,950 --> 00:14:51,620
.لا أعرف حتّى ما الّذي يقولونه

229
00:14:52,490 --> 00:14:55,830
.صرتُ مستمعة جيّدة منذ طفولتي

230
00:14:55,830 --> 00:14:59,750
...لكن يا جاراشي-سان
أنت من الوحشيّين، صحيح؟

231
00:15:00,370 --> 00:15:04,250
ذكر كتاب أنّ لكم حواسّ
...سمع وشمّ جيّدة

232
00:15:04,250 --> 00:15:08,210
.لكنّي لا أجيد مثل تلك الأمور

233
00:15:08,210 --> 00:15:11,380
.أنت هنا يا تونومي؟ لم ألاحظ ذلك

234
00:15:11,380 --> 00:15:14,300
.مع أنّي لستُ خفيًّا بالكامل الآن

235
00:15:14,300 --> 00:15:16,720
لكن ربّما بإمكاني القيام بعمل
.أفضل إن ركّزتُ جيّدًا

236
00:15:16,720 --> 00:15:19,680
صحيح، عندما تنغمسين بالكامل؟

237
00:15:19,980 --> 00:15:24,400
سمعتُ بذلك من تقارير تحقيقات
.تونومي-سان وكيكيرا-سان

238
00:15:24,400 --> 00:15:27,320
أهنالك ما يزعجك يا شيزوكا؟

239
00:15:27,320 --> 00:15:30,650
،عندما أكون منغمسة بالكامل
!بإمكاني هزيمة أيّ أحد

240
00:15:31,320 --> 00:15:33,620
.ليس عليك هزيمة أيّ أحد

241
00:15:34,990 --> 00:15:38,370
لكن هل يمكنني استعارة عينيك؟

242
00:15:39,250 --> 00:15:43,710
هذا الوصل... بإمكاني قراءة
.كلّ شيء فيه عدا السّعر

243
00:15:43,710 --> 00:15:45,130
.دعيني أرى

244
00:15:48,710 --> 00:15:52,760
.مهلاً، هذا الوصل بالٍ جدًّا

245
00:15:53,970 --> 00:15:58,100
.يحدث ذلك كثيرًا
ما السّعر الّذي كُتب فيه؟

246
00:15:58,100 --> 00:15:59,680
.إنّه 1600 ينّ

247
00:15:59,680 --> 00:16:01,560
.شكرًا لك

248
00:16:01,560 --> 00:16:08,530
والمُنتَج الّذي على الوصل هو عبوة
...اقتصاديّة من تشورون للوحشيّين

249
00:16:08,530 --> 00:16:11,440
هل اشتريتِها يا جاراشي-سان؟

250
00:16:11,440 --> 00:16:12,780
!نعم

251
00:16:12,780 --> 00:16:15,740
.لقد رأيتها بينما كنتُ أحرس زبونة

252
00:16:15,740 --> 00:16:18,030
.من الصّعب العثور عليها

253
00:16:19,290 --> 00:16:20,950
!كانت صفقة ممتازة

254
00:16:20,950 --> 00:16:24,580
.لا تنفقي أموال الشّركة على ذلك رجاءً

255
00:16:24,580 --> 00:16:26,670
!ماذا؟ أليس مسموحًا لي بذلك؟

256
00:16:26,670 --> 00:16:30,670
أنا آسفة. إنّهم لا يصنعون
!تشورون للبشر

257
00:16:30,670 --> 00:16:32,170
.تلك ليست المشكلة

258
00:16:32,170 --> 00:16:34,510
!كلاّ! عليّ الذّهاب

259
00:16:36,850 --> 00:16:38,010
!عفوًا

260
00:16:38,010 --> 00:16:41,270
تركتُ هاتفك وسمّاعاتك على
.الجانب الأيسر من حاسوبك

261
00:16:41,270 --> 00:16:42,480
!مفهوم

262
00:16:42,480 --> 00:16:43,940
.مع السّلامة

263
00:16:43,940 --> 00:16:45,520
!إلى اللّقاء

264
00:16:52,690 --> 00:16:54,700
.تأخّر الوقت كثيرًا

265
00:16:55,200 --> 00:16:57,870
.غادر تونومي-سان منذ مدّة

266
00:16:57,870 --> 00:17:00,410
.ظننتُ أنّه سيكون قد عاد الآن

267
00:17:06,210 --> 00:17:08,380
.مرحبًا بعودتك يا تونومي-سان

268
00:17:08,380 --> 00:17:10,670
.ماذا؟ لا يوجد أحد هنا

269
00:17:10,670 --> 00:17:12,010
ما-ماذا؟

270
00:17:12,550 --> 00:17:14,550
...ياكو، هل

271
00:17:14,550 --> 00:17:15,550
تأذّيتِ؟

272
00:17:17,180 --> 00:17:19,430
شيزوكا، أين أُصبتِ؟

273
00:17:20,140 --> 00:17:21,470
!لماذا لم تخبرينا؟

274
00:17:21,470 --> 00:17:22,520
!كـ-كلاّ

275
00:17:22,520 --> 00:17:24,140
!هيّا! أريني

276
00:17:24,140 --> 00:17:26,730
!لم أُصب! لم أُصب أبدًا

277
00:17:32,230 --> 00:17:33,780
.المعذرة

278
00:17:33,780 --> 00:17:37,820
.أحضرت جاراشي-سان علبة إسعافات أوّليّة

279
00:17:37,820 --> 00:17:41,450
أنت من تحتاجها، صحيح؟

280
00:17:42,620 --> 00:17:46,830
أفترض أنّي لا أستطيع إخفاء
.نفسي عنك بالكامل

281
00:17:47,920 --> 00:17:49,960
.واجهتُ بعض المشاكل اليوم

282
00:17:50,750 --> 00:17:54,300
...كنتُ أقدّم تقريري عن قضيّة الخيانة، ثمّ

283
00:18:00,260 --> 00:18:01,550
!يا هذا

284
00:18:01,550 --> 00:18:03,810
!كيف أمكنك فعل هذا بي؟

285
00:18:03,810 --> 00:18:05,730
!لا أصدّق أنّك عيّنتِ محقّقًا ليتحرّى عنّي

286
00:18:05,730 --> 00:18:07,600
!تُحمّلني أنا المسؤوليّة؟

287
00:18:07,600 --> 00:18:09,770
—أيّها المخادع الـ

288
00:18:07,600 --> 00:18:10,980
...مـ-مهلاً، اهدآ رجاءً

289
00:18:10,980 --> 00:18:11,860
!لا تتدخّل

290
00:18:11,860 --> 00:18:12,440
!هذا مؤلم

291
00:18:12,980 --> 00:18:16,400
.حاولتُ التّدخّل وآذيتُ نفسي

292
00:18:16,400 --> 00:18:19,610
!لكن... ما مدى سوء الوضع؟

293
00:18:19,610 --> 00:18:24,160
،ليس سيّئًا. هدأت الزّبونة
.لذلك سرت الأمور بسلاسة بعدها

294
00:18:25,790 --> 00:18:28,120
...بدا الجميع متفاجئًا

295
00:18:28,120 --> 00:18:31,710
لأنّ السّوائل لا تعود خفيّة
.بعد أن تغادر جسدي

296
00:18:31,710 --> 00:18:35,760
مذهل! الأشخاص الخفيّون ينزفون أيضًا؟

297
00:18:35,760 --> 00:18:37,970
.لم أرَ ذلك من قبل

298
00:18:38,260 --> 00:18:40,220
.لم يصدّقوا أعينهم

299
00:18:40,220 --> 00:18:41,430
...أنا

300
00:18:41,430 --> 00:18:44,560
!كنتُ أسأل عن مدى سوء وضع إصاباتك

301
00:18:45,560 --> 00:18:47,980
أنت قلقة عليّ أنا؟

302
00:18:47,980 --> 00:18:49,190
!بالطّبع

303
00:18:50,560 --> 00:18:51,810
.فهمت

304
00:18:53,270 --> 00:18:54,980
...بصراحة

305
00:18:54,980 --> 00:18:58,530
بما أنّ الضّرر خفيّ، لا يمكنني
.الجزم بمدى سوئه

306
00:18:59,320 --> 00:19:02,570
.لكنّي واثق أنّه ليس سيّئًا إلى حدّ كبير

307
00:19:02,570 --> 00:19:04,410
.نزفت أكثر من المتوقّع فحسب

308
00:19:04,410 --> 00:19:06,290
أ-أنت واثق؟

309
00:19:06,290 --> 00:19:09,160
!إن نزفت كثيرًا، قد تموت

310
00:19:09,160 --> 00:19:10,620
.أنا لا أنزف إلى ذلك الحدّ

311
00:19:10,620 --> 00:19:14,460
!أ-أليس هناك ما يمكنني مساعدتك به؟

312
00:19:14,460 --> 00:19:16,630
...إن كنت تعرضين المساعدة

313
00:19:17,710 --> 00:19:21,050
.أريد تثبيت الشّاش بالضّماد
هلاّ أمسكت به لأقوم بذلك؟

314
00:19:21,050 --> 00:19:21,760
!أكيد

315
00:19:25,140 --> 00:19:29,480
.لا أدري ما السّبب
...لم أرد أن تقلقي عليّ

316
00:19:30,600 --> 00:19:33,730
لكنّ هذا يجعلني أشعر بمتعة
.غريبة. أشعر بدغدغة خفيفة

317
00:19:35,650 --> 00:19:39,610
!أنا آسفة! هل دغدغك ذلك؟
هل أمسكتُ بالشّاش بطريقة خاطئة؟

318
00:19:41,530 --> 00:19:43,410
.في الواقع، أنا أتدغدغ بسهولة

319
00:19:44,280 --> 00:19:45,950
أتريدني أن أدغدغك؟

320
00:19:45,950 --> 00:19:47,120
.لا تفعلي رجاءً

321
00:19:51,580 --> 00:19:54,080
.عجبًا، لقد غادر الجميع

322
00:19:54,790 --> 00:19:57,090
.أعتقد أنّ أوقات العمل قد انتهت الآن

323
00:19:57,420 --> 00:19:59,510
هل ستغادرين أيضًا يا ياكو-سان؟

324
00:19:59,510 --> 00:20:02,010
نعم. ماذا عنك؟

325
00:20:02,010 --> 00:20:04,680
.لا، عليّ كتابة تقريري

326
00:20:04,680 --> 00:20:06,510
ستبقى هنا؟

327
00:20:06,510 --> 00:20:09,600
.نعم، تسبّب هذا في تأخير عملي

328
00:20:09,600 --> 00:20:12,810
.وأنا لستُ مصابًا بما يكفي لأتوقّف

329
00:20:14,060 --> 00:20:16,860
.بتعبير آخر، سيعمل لوقت إضافيّ ثانية

330
00:20:16,860 --> 00:20:20,280
...وعلى الأرجح أنّه لن يرتاح أبدًا

331
00:20:21,240 --> 00:20:24,360
.سأطلب بعض المؤن إذًا

332
00:20:24,360 --> 00:20:26,490
.لا تكلّفي نفسك عناء ذلك يا ياكو-سان

333
00:20:27,490 --> 00:20:30,080
...حسنًا، أنا

334
00:20:30,080 --> 00:20:35,170
.بإمكاننا أخذ استراحة معًا عندما أنتهي

335
00:20:36,210 --> 00:20:39,250
.لا، لنأخذ استراحة معًا الآن

336
00:20:39,250 --> 00:20:42,050
.ماذا؟ ظننتُ أنّ لديك عملاً لتقوم به

337
00:20:42,300 --> 00:20:44,380
.بإمكاني العمل بعد ذلك

338
00:20:47,300 --> 00:20:49,350
.عمل جيّد اليوم يا ياكو-سان

339
00:20:49,600 --> 00:20:51,770
.أعددتُ لك بعض الشّاي. تفضّلي

340
00:20:52,980 --> 00:20:54,690
!شكرًا لك

341
00:20:55,520 --> 00:20:57,900
هل هذا شاي جديد؟

342
00:20:57,900 --> 00:20:59,820
.إنّها خلطة عشبيّة

343
00:21:00,190 --> 00:21:01,780
.راودني الفضول حيالها

344
00:21:01,780 --> 00:21:04,860
.له رائحة جميلة جدًّا

345
00:21:07,120 --> 00:21:08,780
.إنّه لذيذ

346
00:21:10,200 --> 00:21:11,450
.سرّني أنّه أعجبك

347
00:21:13,620 --> 00:21:15,120
...تونومي-سان

348
00:21:15,460 --> 00:21:18,710
.دعاني للعشاء من قبل

349
00:21:18,710 --> 00:21:21,130
هل كانت لمرّة واحدة فقط؟

350
00:21:21,920 --> 00:21:28,050
.كم أودّ الخروج في موعد آخر... معه

351
00:21:28,510 --> 00:21:32,140
!لماذا إذًا لا أدعوه بنفسي هذه المرّة؟

352
00:21:32,680 --> 00:21:34,480
ولكن ماذا إن رفض؟

353
00:21:34,480 --> 00:21:37,940
!لا، من المهمّ التّحلّي بالشّجاعة

354
00:21:38,270 --> 00:21:39,980
—ياكو-سان، بالمناسبة

355
00:21:39,980 --> 00:21:42,900
!هل تودّ تناول العشاء معي اللّيلة؟

356
00:21:47,610 --> 00:21:49,780
!ما-ما-ما الخطب؟

357
00:21:49,780 --> 00:21:54,290
حسنًا، هل يمكننا القيام بحجز
آخر بعد ذلك أيضًا؟

358
00:21:56,790 --> 00:22:01,960
وجدتُ مكانًا يمكن إعداد خلطات
.شاي خاصّة بك وأردت دعوتك

359
00:22:01,960 --> 00:22:04,880
!ا-اعتبر الحجز قد تمّ

360
00:22:05,760 --> 00:22:07,050
.مهلاً لحظة

361
00:22:07,380 --> 00:22:09,300
.لنختر يومًا