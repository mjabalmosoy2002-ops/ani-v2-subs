1
00:01:37,860 --> 00:01:39,270
!مرحبًا

2
00:01:39,270 --> 00:01:41,920
!أهلاً بكما في حديقة الإلف

3
00:01:45,040 --> 00:01:47,040
!ثمّة روائح كثيرة

4
00:01:45,040 --> 00:01:47,040
.الحجز باسم تونومي

5
00:01:47,040 --> 00:01:48,500
.أهلاً وسهلاً بكما

6
00:01:48,560 --> 00:01:50,470
أنتما هنا من أجل تجربةِ
تذوّق الخليط الأصليّ؟

7
00:01:50,470 --> 00:01:52,800
.عفوًا، سأرافقكما إلى مقعديكما

8
00:01:55,910 --> 00:01:59,160
فكّرا بشأن الشّاي الّذي تريدان
.واختارا الأوراق

9
00:02:02,220 --> 00:02:05,330
أيّ نوع من الشّاي تحبّ يا تونومي-سان؟

10
00:02:05,330 --> 00:02:08,480
.أحبّ التّركيز على التّأثيرات الّتي يروّجون لها

11
00:02:08,480 --> 00:02:11,980
مثل الشّاي الّذي يحسّن التّركيز
.أو يساعد على الاسترخاء

12
00:02:12,170 --> 00:02:13,110
ماذا عنك؟

13
00:02:13,300 --> 00:02:14,940
.دعني أفكّر

14
00:02:16,660 --> 00:02:21,120
!أحببتُ كثيرًا الشّاي الّذي أعددتَه لي من قبل

15
00:02:22,520 --> 00:02:23,750
.كم أسعدني هذا

16
00:02:23,750 --> 00:02:27,500
!عفوًا، أنا من ابتكر ذلك الخليط

17
00:02:28,280 --> 00:02:31,500
!أتى رفيقكِ هذا للمتجر من قبل

18
00:02:31,500 --> 00:02:34,170
.قال أنّه يريد شيئًا سيُسعد فتاته

19
00:02:34,350 --> 00:02:36,200
!كم أنت محظوظة

20
00:02:36,200 --> 00:02:39,220
!أخبريني يا عزيزتي
ما هو شعور مواعدة رجل خفيّ؟

21
00:02:39,220 --> 00:02:40,490
هل تتواعدان منذ مدّة طويلة؟

22
00:02:40,490 --> 00:02:42,490
أهي علاقة جادّة؟ أتقيمان معًا؟

23
00:02:42,490 --> 00:02:45,680
ما كنتُ لأقول أنّنا نتواعد
...بشكل رسميّ بعد

24
00:02:46,920 --> 00:02:49,170
أقلتَ بعد؟

25
00:02:49,170 --> 00:02:50,770
أي أنّ ذلك سيحدث قريبًا؟

26
00:02:51,900 --> 00:02:54,030
ربّما تكون اللّيلة هي اللّيلة المنتظرة؟

27
00:02:55,410 --> 00:02:56,360
!هذا مؤلم

28
00:02:56,360 --> 00:02:59,170
!أنا آسفة على تصرّفات زوجي الغبيّة

29
00:03:00,060 --> 00:03:02,650
!أنا أتعرّض للاضطهاد من إلف بيضاء

30
00:03:02,650 --> 00:03:04,290
!اخرس أيّها الإلف الدّاكن

31
00:03:06,640 --> 00:03:08,040
...عفوًا

32
00:03:08,400 --> 00:03:11,630
.أنا آسف. كان ذلك محرجًا قليلاً

33
00:03:12,130 --> 00:03:15,210
...اسمع، بما أنّنا هنا

34
00:03:15,520 --> 00:03:20,550
.أودّ منك أن تُعدّ خليط شاي لي

35
00:03:21,890 --> 00:03:22,810
.بكلّ سرور

36
00:03:23,050 --> 00:03:27,060
!وأنا سأعدّ واحدًا لك أيضًا

37
00:03:27,500 --> 00:03:29,170
.أنا توّاق لتجربته

38
00:03:29,170 --> 00:03:30,870
!سأجعله يستحقّ الانتظار

39
00:03:30,870 --> 00:03:33,510
!نعم، نعم! أنا السّبب وراء حدوث هذا

40
00:03:33,510 --> 00:03:34,950
.لا تغترّ بنفسك كثيرًا

41
00:03:37,820 --> 00:03:38,810
.حسنًا

42
00:03:38,810 --> 00:03:41,620
سأقوم بتجهيز الشّاي من
.الخليطين اللّذين أعددتماها

43
00:03:42,320 --> 00:03:45,120
ألم يكن إعداد الشّاي معًا ممتعًا؟

44
00:03:45,120 --> 00:03:47,380
.نعم، أتطلّع قُدمًا لشربه

45
00:03:47,740 --> 00:03:49,590
...بـ-بالمناسبة

46
00:03:49,870 --> 00:03:54,460
هل عثرتَ على هذا المتجر لأجلي فحسب؟

47
00:03:54,540 --> 00:03:58,100
هل كان بحثًا لذلك السّبب؟

48
00:03:59,590 --> 00:04:02,480
!أنا آسفة! لقد تحمّستُ في توقّعاتي

49
00:04:02,480 --> 00:04:04,090
!أنا أعتذر بشدّة

50
00:04:05,840 --> 00:04:07,530
.بل أنت مصيبة في كلامك

51
00:04:07,530 --> 00:04:09,560
!أ-أنا آسفة

52
00:04:09,970 --> 00:04:14,790
.لديّ عادةُ محاولةِ فهم دوافع النّاس

53
00:04:14,950 --> 00:04:16,610
.لديك حدس ممتاز

54
00:04:16,960 --> 00:04:19,910
.إنّها ميزة ممتازة قد تتمتّع بها مساعِدة محقّق

55
00:04:19,910 --> 00:04:21,590
.كـ-كلاّ

56
00:04:21,860 --> 00:04:25,130
.ثمّة أمور عديدة لا أعرفها

57
00:04:25,130 --> 00:04:26,990
...أمور عنك أيضًا

58
00:04:26,990 --> 00:04:30,850
لا أستطيع حتّى تخيّل كيف تبدو
...ما لم ألمسك، لذلك

59
00:04:31,240 --> 00:04:32,430
أتودّين لمسي؟

60
00:04:35,620 --> 00:04:36,610
.أقصد يداي بالطّبع

61
00:04:36,610 --> 00:04:37,890
.نـ-نعم

62
00:04:39,380 --> 00:04:40,050
.تفضّلي

63
00:04:43,560 --> 00:04:46,410
.أصابعك أطول من أصابعي والدي

64
00:04:46,470 --> 00:04:48,710
.كما أنّك تعتني جيّدًا بأظافرك

65
00:04:48,960 --> 00:04:53,480
،حتّى إن كان لا يستطيع النّاس رؤيتها
.فأنا أحاول الحفاظ على نظافتي الخاصّة

66
00:04:53,810 --> 00:04:54,960
.ومع ذلك أنا مسرور

67
00:04:55,260 --> 00:04:58,360
أنا نفسي لا أستطيع أن أرى
.إن اعتنيتُ بها جيّدًا

68
00:04:58,360 --> 00:04:59,700
!أنا أفهمك

69
00:04:59,700 --> 00:05:03,150
لا يمكنني رؤية أظافري أيضًا، لذلك أكون
...قلقة دائمًا إن كانت تبدو غريبة

70
00:05:06,860 --> 00:05:09,780
.تعتنين بأظافرك جيّدًا أيضًا

71
00:05:12,270 --> 00:05:15,460
وكأنّه هو من يستطيع
...أن يرى من خلالي

72
00:05:15,620 --> 00:05:16,940
.تفضّلا

73
00:05:17,500 --> 00:05:19,900
.جهّزتُ هذا الشّاي من الخلطات الّتي أعددتماها

74
00:05:20,030 --> 00:05:21,600
.يا لها من رائحة زكيّة

75
00:05:21,770 --> 00:05:22,800
.لنجرّبه

76
00:05:22,920 --> 00:05:24,570
!أ-أكيد

77
00:05:30,150 --> 00:05:31,010
.جاراشي-سان

78
00:05:32,090 --> 00:05:35,250
ما هو أسلوب تونومي-سان
في ارتداء الملابس عادة؟

79
00:05:36,650 --> 00:05:38,130
ما هو أسلوبه؟

80
00:05:38,130 --> 00:05:40,680
.أعتقد أنّه يرتدي بذلات في معظم الأوقات

81
00:05:40,680 --> 00:05:43,000
كيف تبدو بذلاته؟

82
00:05:43,000 --> 00:05:44,170
من أيّ نوع؟

83
00:05:44,170 --> 00:05:45,510
نوع؟

84
00:05:47,440 --> 00:05:49,210
أعتقد أنّها مثل الّتي يرتديها
الرّجل الإنجليزيّ المحترم؟

85
00:05:49,210 --> 00:05:52,960
.رجل محترم! يبدو ذلك رائعًا

86
00:05:52,960 --> 00:05:54,080
!نعم، نعم

87
00:05:54,080 --> 00:05:57,260
،الرّجال الإنجليز المحترمين جواسيس
!وذلك رائع جدًّا

88
00:05:58,140 --> 00:06:00,460
!الرّجال الإنجليز المحترمين جواسيس؟

89
00:06:00,460 --> 00:06:02,220
.إنّها تقصد في الأفلام

90
00:06:02,320 --> 00:06:06,050
.وبالطّبع سيرتدي تونومي بذلاً أثناء العمل

91
00:06:06,050 --> 00:06:07,720
لماذا تسألين عن ذلك؟

92
00:06:07,720 --> 00:06:11,070
،حسنًا... كنتُ أفكّر في شراء ملابس

93
00:06:11,070 --> 00:06:13,650
...وأردتُ معلومات كمرجع

94
00:06:14,060 --> 00:06:17,560
،إن كنت ستشترين ملابس لنفسك
فلماذا تسألين عن ملابس تونومي؟

95
00:06:17,920 --> 00:06:19,560
...أيُعقل

96
00:06:19,560 --> 00:06:22,000
أنّكما تريدان ارتداء ملابس متشابهة؟

97
00:06:22,000 --> 00:06:23,480
!مرحى

98
00:06:23,910 --> 00:06:25,750
...لا، بالطّبع لا

99
00:06:25,820 --> 00:06:29,070
إنّها تريد ارتداء ملابس متناسقة
.في موعدهما أيّتها القطّة الغبيّة

100
00:06:29,070 --> 00:06:31,040
!ماذا قلت؟

101
00:06:30,660 --> 00:06:33,810
!هذا مؤلم، هذا مؤلم، هذا مؤلم

102
00:06:31,770 --> 00:06:35,360
.نعم، إنّها من أجل... موعد

103
00:06:35,360 --> 00:06:36,970
!مع تونومي؟

104
00:06:36,970 --> 00:06:38,670
.نـ-نعم

105
00:06:38,670 --> 00:06:40,520
!مفهوم يا شيزوكا

106
00:06:40,520 --> 00:06:41,640
تريدين التّأنّق في أفضل حلّة، صحيح؟

107
00:06:41,640 --> 00:06:43,670
!ذلك قد يكون مبالغًا فيه

108
00:06:44,380 --> 00:06:46,620
!أيمكننا الاحتفاظ بهذا بيننا فحسب؟

109
00:06:46,620 --> 00:06:49,300
.نحن الوحيدون الّذين نعمل هنا من الأساس

110
00:06:49,480 --> 00:06:53,380
كنت أشتري نفس أنواع الملابس باستمرار

111
00:06:53,380 --> 00:06:56,480
.حتّى لا تنشأ أيّ تناقضات

112
00:06:56,480 --> 00:07:01,350
.لكن... أريد ملابس مميّزة للأيّام الخاصّة

113
00:07:01,350 --> 00:07:02,270
!شيزوكا

114
00:07:02,270 --> 00:07:03,640
!دعي الأمر لي

115
00:07:03,640 --> 00:07:05,980
!سأكون رفيقتك في التّسوّق

116
00:07:05,980 --> 00:07:08,180
!شـ-شكرًا لك

117
00:07:09,070 --> 00:07:10,240
.يا جاراشي

118
00:07:11,020 --> 00:07:14,100
،قد تكونين متسلّطة بعض الشّيء

119
00:07:14,100 --> 00:07:15,840
.لذلك لا تضغطي على ياكو كثيرًا

120
00:07:15,840 --> 00:07:17,140
.كما أنك سريعة الغضب أيضًا

121
00:07:17,900 --> 00:07:19,040
أرأيت؟

122
00:07:21,450 --> 00:07:22,660
!نعم، نعم

123
00:07:23,020 --> 00:07:24,610
!تبدين رائعة

124
00:07:24,890 --> 00:07:26,610
!يا لظرافتك

125
00:07:26,610 --> 00:07:28,710
أ-أذلك صحيح؟

126
00:07:28,710 --> 00:07:32,970
.تختارين ملابس أنثويّة وعفويّة في العادة

127
00:07:33,240 --> 00:07:35,160
سيكون مفيدًا أن يكون لديك
بعض الملابس النّاضجة

128
00:07:35,160 --> 00:07:37,400
!الّتي يمكن ارتداؤها في المطاعم الفاخرة

129
00:07:37,400 --> 00:07:38,240
!جرّبي هذا أيضًا

130
00:07:38,240 --> 00:07:40,510
!مـ-مهلاً لحظة

131
00:07:40,980 --> 00:07:44,630
.أريد أن أتأكّد أيّ نوع من الملابس أوّلاً

132
00:07:45,480 --> 00:07:46,980
.التُقطت صورة. القماش أزرق باهت

133
00:07:47,490 --> 00:07:49,260
...أزرق باهت

134
00:07:50,860 --> 00:07:53,560
.شيزوكا. سأصفه أنا لك

135
00:07:53,560 --> 00:07:55,940
!شـ-شكرًا لك

136
00:07:57,080 --> 00:07:58,910
...هذا القميص

137
00:07:59,090 --> 00:08:01,600
...يبدو قماشه حيويًّا

138
00:08:01,600 --> 00:08:04,540
ما معنى "حيويّ" في هذا السّياق؟

139
00:08:04,540 --> 00:08:08,910
إنّه يتجعّد مثل الشّعر
.ما يجعله يبدو مليئًا بالحركة

140
00:08:11,080 --> 00:08:12,550
...وأيضًا

141
00:08:13,020 --> 00:08:16,350
.أنا آسفة. لم أكن مُراعية لك على الإطلاق

142
00:08:17,300 --> 00:08:20,620
هل أنت قلقة بشأن ما قاله كيكيرا-سان لك؟

143
00:08:20,620 --> 00:08:22,770
...ذ-ذلك

144
00:08:22,770 --> 00:08:26,360
كما أنّي جعلتك تتعثّرين بسبب
...درّاجتي من قبل أيضًا

145
00:08:26,360 --> 00:08:28,280
!هذا ليس من عادتك يا جاراشي-سان

146
00:08:28,340 --> 00:08:29,830
هل تؤلمك معدتك أو ما شابه؟

147
00:08:29,830 --> 00:08:31,440
!لا تأكلي أشياء تجدينها على الأرض

148
00:08:34,700 --> 00:08:37,690
.أرى أنّك تحبّين الانتقاد أيضًا يا شيزوكا

149
00:08:38,510 --> 00:08:39,620
.آسفة بشأن ذلك

150
00:08:39,830 --> 00:08:40,820
!حسنًا

151
00:08:40,820 --> 00:08:44,280
سأرافقك إلى أفضل أماكني
!عندما ننتهي من التّسوّق

152
00:08:44,280 --> 00:08:45,580
!أجل

153
00:08:45,580 --> 00:08:46,780
!لنقم بذلك

154
00:08:53,920 --> 00:08:55,590
...بالمناسبة يا كيكيرا-سان

155
00:08:56,100 --> 00:08:58,210
أتعرف أيّ مطاعم لتوصيني بها؟

156
00:08:58,210 --> 00:08:59,360
.لا أعرف

157
00:08:59,600 --> 00:09:02,520
.هيّا، سايرني في هذه المحادثة قليلاً

158
00:09:02,520 --> 00:09:03,840
.هذا مزعج

159
00:09:04,060 --> 00:09:05,460
.فهمت

160
00:09:05,990 --> 00:09:07,820
.كنتُ أودّ سماع بعض الأفكار

161
00:09:08,310 --> 00:09:10,090
.حسنًا، لنعد للعمل

162
00:09:19,040 --> 00:09:20,770
.أنا أبتسم

163
00:09:20,770 --> 00:09:24,100
!ليس عليك إطلاعي بتعابيرك
!اخرس فحسب

164
00:09:28,290 --> 00:09:29,940
.تفضّلوا بالدّخول

165
00:09:32,780 --> 00:09:34,660
!يا للمفاجأة

166
00:09:34,660 --> 00:09:37,180
!إنّهما زبونانا

167
00:09:37,180 --> 00:09:38,950
.أنتما صاحبا متجر الشّاي

168
00:09:38,950 --> 00:09:40,050
!هذا صحيح

169
00:09:40,050 --> 00:09:41,330
!أنا كارما

170
00:09:41,330 --> 00:09:42,800
.وأنا زوجته لايت

171
00:09:42,800 --> 00:09:45,930
!نحن زوجان من الإلف

172
00:09:48,350 --> 00:09:49,760
.فهمت

173
00:09:49,980 --> 00:09:52,360
شخصيّات مشبوهة ترتدي أغطية رأس بيضاء؟

174
00:09:52,360 --> 00:09:56,110
.إنّهم يجلسون في سيّارة مقابلة للمتجر كلّ يوم

175
00:09:56,320 --> 00:09:59,160
،كما أنّهم يستفسرون عنّا في الحيّ

176
00:09:59,160 --> 00:10:01,400
...ويلتقطون صورًا من داخل السّيّارة

177
00:10:01,400 --> 00:10:03,320
.يبدو ذلك مُقلقًا بالفعل

178
00:10:03,320 --> 00:10:07,990
لم يسبق أن لاحقني أحد ما طوال
!المائة عام الّتي عشتُها

179
00:10:07,990 --> 00:10:09,290
!أشعر بحماسة شديدة

180
00:10:09,290 --> 00:10:11,170
عفوًا... أنت خائف من هذا، صحيح؟

181
00:10:11,170 --> 00:10:14,590
.يبدو أنّهم يتبعوننا أينما ذهبنا أيضًا

182
00:10:14,860 --> 00:10:15,760
—حتّى إلى هنا

183
00:10:15,760 --> 00:10:19,000
!لا داعي للقلق! لقد ضلّلناهم بالكامل

184
00:10:19,000 --> 00:10:20,350
!لا يعرفون أننا هنا

185
00:10:20,350 --> 00:10:21,700
.آمل أن يكون محقًّا

186
00:10:22,350 --> 00:10:23,510
.مفهوم

187
00:10:23,510 --> 00:10:26,930
سأبحث في أمر المشتبه بهم
.وأفكّر في بعض الإجراءات المضادّة

188
00:10:26,930 --> 00:10:28,280
.شكرًا جزيلاً لك

189
00:10:28,280 --> 00:10:29,660
!مرحى

190
00:10:31,490 --> 00:10:32,970
.أخبرني يا تونومي

191
00:10:32,970 --> 00:10:33,820
ماذا؟

192
00:10:33,820 --> 00:10:36,650
تتبّعتُ جهاز الإرسال الّذي
،ثبّتته جاراشي على السّيّارة

193
00:10:36,650 --> 00:10:40,070
.فقادني إلى شركة أدوية كبرى في الجبال

194
00:10:40,280 --> 00:10:42,620
،أمّا بالنّسبة للأشخاص في السّيّارة

195
00:10:42,820 --> 00:10:46,080
،فملابسهم متطابقة
.لكنّ وجوههم مختلفة تمامًا

196
00:10:46,240 --> 00:10:47,420
...يبدو أنّ هذا

197
00:10:47,420 --> 00:10:48,840
.قد يكون هذا خطيرًا جدًّا

198
00:10:49,220 --> 00:10:50,540
...عفوًا

199
00:10:50,910 --> 00:10:52,790
ما الّذي تعنيه بذلك؟

200
00:10:52,990 --> 00:10:55,420
.قد تكون عمليّة منظّمة

201
00:10:55,770 --> 00:10:58,900
.ليست مجرّد حالة ملاحقة بسيطة

202
00:10:59,330 --> 00:11:01,660
.إنّ جاراشي-سان تحرسهما
—أخبرها أنّ

203
00:11:03,140 --> 00:11:04,880
!تونومي، الوضع خطير

204
00:11:04,880 --> 00:11:07,350
توقّفت سيّارتان قرب المتجر

205
00:11:07,350 --> 00:11:09,230
!ودخل إليه العديد من الرّجال

206
00:11:09,230 --> 00:11:12,140
أخرجتُ عصفورَيْ الحبّ من الخلف
!ونحن نهرب منهم الآن

207
00:11:12,420 --> 00:11:15,450
!هذا رائع! وكأنّنا في فيلم

208
00:11:15,450 --> 00:11:17,260
!حاول أن تكون مذعورًا على الأقلّ

209
00:11:17,480 --> 00:11:19,560
.مفهوم. أنا في طريقي

210
00:11:19,560 --> 00:11:21,480
.ثمّة عدّة تهديدات
.سأتوجّه إلى هناك أيضًا

211
00:11:21,480 --> 00:11:23,340
!سأظلّ هنا

212
00:11:23,340 --> 00:11:25,070
!كونوا حذرين رجاءً

213
00:11:25,070 --> 00:11:26,990
.ياكو-سان، نعتمد عليك

214
00:11:28,010 --> 00:11:30,460
...أرجو أن يتمكّنوا من تجاوز الأمر بسلام

215
00:11:36,850 --> 00:11:38,300
.تفضّل بالدّخول

216
00:11:39,580 --> 00:11:41,430
هل أنت زبون؟

217
00:11:42,060 --> 00:11:43,170
.أنا آسفة

218
00:11:43,170 --> 00:11:46,180
أخشى أنّنا تجاوزنا أوقات العمل
.لاستقبال زبائن جدد

219
00:11:46,540 --> 00:11:48,840
هل أنت وحدك هنا؟

220
00:11:49,700 --> 00:11:51,260
...ذلك صحيح

221
00:11:57,970 --> 00:11:59,390
.إيّاك ولمس شعرة منها

222
00:12:00,760 --> 00:12:01,940
تونومي-سان؟

223
00:12:02,140 --> 00:12:05,160
.أدركتُ أنّهم قد يستهدفون الوكالة

224
00:12:05,160 --> 00:12:06,910
!كـ-كلاّ

225
00:12:07,910 --> 00:12:09,650
!أنا إلف

226
00:12:09,650 --> 00:12:12,160
!إلف أبيض، مثل ابنتي تمامًا

227
00:12:16,340 --> 00:12:21,680
.هذا أبي. إنّه يدير شركة أدوية

228
00:12:21,680 --> 00:12:23,580
.أنا أعتذر على الإزعاج

229
00:12:23,840 --> 00:12:25,170
.فهمت

230
00:12:25,170 --> 00:12:29,080
قلقتَ بسبب هروب ابنتك مع حبيبها
.وأردتَ الاطمئنان عليها

231
00:12:29,320 --> 00:12:32,580
أبي، لماذا ورّطتَ العشيرة بأكملها؟

232
00:12:32,580 --> 00:12:33,850
...وهذا التّنكّر أيضًا

233
00:12:33,850 --> 00:12:38,570
،لقد أرادوا القدوم جميعًا
...ولم نرد أن تلاحظي

234
00:12:38,570 --> 00:12:41,780
،ثمّ زرتُما وكالة التّحقيقات

235
00:12:41,780 --> 00:12:44,520
...لذلك ظننّا أنّه قد يكون هنالك سوء تفاهم

236
00:12:44,520 --> 00:12:46,300
.إذًا فقد تبعوكما بالفعل

237
00:12:46,300 --> 00:12:49,610
!آهٍ يا أبي! كم أنت أخرق

238
00:12:50,700 --> 00:12:56,600
.تذكّر، لم أمنحك بعدُ مباركتي أيّها الإلف الدّاكن

239
00:12:56,600 --> 00:13:01,610
!ولكنّي لم أطلب مباركتك أبدًا يا أبي

240
00:13:01,610 --> 00:13:02,460
!كفّا عن ذلك

241
00:13:02,750 --> 00:13:03,970
...عفوًا

242
00:13:03,350 --> 00:13:05,620
!المخرج من هناك

243
00:13:04,610 --> 00:13:07,800
أهذا يعني أنّ... القضيّة أُغلقت؟

244
00:13:05,620 --> 00:13:06,760
ما كان ذلك؟

245
00:13:06,760 --> 00:13:08,550
!تريّث يا أبي

246
00:13:07,800 --> 00:13:10,970
،ثمّة العديد من المشاكل المستمرّة
.لكنّها مشاكل خاصّة بهم

247
00:13:08,550 --> 00:13:09,780
.لا تنادني أبي

248
00:13:09,780 --> 00:13:10,970
!بربّك يا أبي

249
00:13:13,580 --> 00:13:15,990
.أحسنتم عملاً اليوم جميعًا

250
00:13:18,860 --> 00:13:23,060
!من اللّطيف إقامة حفلة شُرب مع زملاء العمل

251
00:13:23,060 --> 00:13:25,780
.لا تتسنّى لنا فرص كثيرة للقيام بذلك

252
00:13:25,780 --> 00:13:28,740
.أنا أفضّل الوصول للمنزل في الوقت فحسب

253
00:13:28,740 --> 00:13:30,290
.يا لك من عبوس

254
00:13:30,350 --> 00:13:32,280
.أراهن أنّك لا تعرف أيّ فتيات

255
00:13:32,280 --> 00:13:35,320
.لديّ شريك بالفعل، لذلك لستُ بحاجة لذلك

256
00:13:37,740 --> 00:13:38,520
ماذا هنالك؟

257
00:13:38,790 --> 00:13:40,510
!لم أكن أعرف هذا

258
00:13:40,510 --> 00:13:41,890
.لم تذكر الأمر من قبل أبدًا

259
00:13:41,890 --> 00:13:43,040
هل أهنّئك؟

260
00:13:43,040 --> 00:13:44,230
!لا أحتاج لذلك

261
00:13:44,550 --> 00:13:50,160
بالمناسبة، كنتُ أتساءل دائمًا
.إن كنتِ تشربين يا شيزوكا

262
00:13:50,160 --> 00:13:55,010
أنا أشرب، لكن يكون من الصّعب
.العودة للمنزل وأنا ثملة

263
00:13:55,010 --> 00:13:57,280
سأعرّض حياتي للخطر إن لم
.أحافظ على حدّة حواسّي

264
00:13:57,280 --> 00:13:59,060
.فهمت الآن

265
00:13:59,320 --> 00:14:02,850
،حسنًا، سأرافقك للمنزل هذه المرّة
!لذلك اشربي بقدر ما تشائين

266
00:14:02,850 --> 00:14:04,310
أ-أأنت واثقة؟

267
00:14:04,310 --> 00:14:05,490
!بكلّ تأكيد

268
00:14:05,490 --> 00:14:07,370
حسنًا، ماذا تفضّلين؟

269
00:14:07,370 --> 00:14:11,280
أ-أهنالك أيّ شيء حلو؟

270
00:14:14,940 --> 00:14:15,540
...مهلاً

271
00:14:15,790 --> 00:14:18,040
!جاراشي-سان؟

272
00:14:18,670 --> 00:14:20,980
.هذا مثير للشّفقة

273
00:14:23,030 --> 00:14:24,140
ما العمل الآن؟

274
00:14:24,370 --> 00:14:25,180
.ياكو-سان

275
00:14:26,050 --> 00:14:27,700
.اتّصلتُ بسيّارة أجرة

276
00:14:27,920 --> 00:14:29,300
.سأحرص على إيصالك

277
00:14:33,560 --> 00:14:35,150
...ما-ما-ما

278
00:14:35,150 --> 00:14:36,260
!ماذا أفعل؟

279
00:14:36,260 --> 00:14:39,080
هل أدعوه لشرب الشّاي؟

280
00:14:39,080 --> 00:14:42,610
ولكن هل غرفتي في حالة جيّدة
!لاستقبال ضيوف أساسًا؟

281
00:14:42,760 --> 00:14:43,580
.ياكو-سان

282
00:14:43,580 --> 00:14:44,360
!ماذا؟

283
00:14:44,360 --> 00:14:46,300
.هنالك مطعم يثير اهتمامي

284
00:14:46,480 --> 00:14:48,210
أيمكننا الذّهاب إليه لاحقًا؟

285
00:14:48,540 --> 00:14:51,120
.يُقال أنّه مطعم مظلم

286
00:14:51,120 --> 00:14:53,600
.سنتناول العشاء في مكان حالك السّواد

287
00:14:53,970 --> 00:14:56,240
!نعم، لقد سمعتُ عنه

288
00:14:56,460 --> 00:15:00,580
.أنا مهتمّ بالعالم الّذي تعيشين فيه

289
00:15:00,770 --> 00:15:01,740
ما رأيك؟

290
00:15:01,860 --> 00:15:04,250
العالم الّذي أعيش فيه؟

291
00:15:04,570 --> 00:15:07,470
!سأكون مرشدتك في الظّلام

292
00:15:08,660 --> 00:15:10,260
.أقدّر لك ذلك بشدّة

293
00:15:13,260 --> 00:15:16,170
.شكرًا على توصيلي للمنزل

294
00:15:16,270 --> 00:15:18,300
.لا شكر على واجب. أراك غدًا

295
00:15:19,620 --> 00:15:21,270
...مـ-مهلاً

296
00:15:23,540 --> 00:15:26,260
!أتودّ شرب كوب شاي معي؟

297
00:15:28,850 --> 00:15:30,850
.لا أريد ترك سيّارة الأجرة تنتظر

298
00:15:30,850 --> 00:15:32,770
!أ-أكيد

299
00:15:32,950 --> 00:15:36,670
،لكن إن أردتِ
.سأسعد بقبول عرضك ثانية لاحقًا

300
00:15:37,420 --> 00:15:38,460
.تصبحين على خير

301
00:15:38,660 --> 00:15:41,830
...تصبح... على... خير

302
00:15:42,790 --> 00:15:47,110
عـ-عليّ أن أطلب من شخص ما
!أن يراجع غرفتي من أجلي

303
00:15:53,930 --> 00:15:54,680
ياكو-سان؟

304
00:15:55,020 --> 00:15:56,850
.نـ-نعم

305
00:15:56,850 --> 00:15:58,890
.ترتدين ملابس جميلة مرّة أخرى

306
00:15:58,890 --> 00:16:01,100
أ-أتظنّ ذلك؟

307
00:16:01,280 --> 00:16:03,770
.آمل أن ترشديني أثناء الوجبة

308
00:16:03,770 --> 00:16:05,190
!سـ-سأبذل جهدي

309
00:16:09,940 --> 00:16:12,270
كيف تجد الأمر يا تونومي-سان؟

310
00:16:12,380 --> 00:16:14,660
ألا يمكنك رؤية أيّ شيء على الإطلاق؟

311
00:16:14,660 --> 00:16:18,780
.في الحقيقة، هناك ضوء خافت جدًّا هنا الآن

312
00:16:19,620 --> 00:16:21,080
!انتباه أيّها الحضور

313
00:16:21,380 --> 00:16:23,960
سنقوم بإطفاء الأنوار الآن

314
00:16:23,960 --> 00:16:26,990
!وسنغوص في ظلمة حقيقيّة

315
00:16:31,310 --> 00:16:34,050
هل الظّلام دامس الآن؟

316
00:16:34,380 --> 00:16:35,900
.نعم، ذلك صحيح

317
00:16:37,340 --> 00:16:40,580
!تونومي-سان، مرحبًا بك في عالمي

318
00:16:43,370 --> 00:16:44,780
هل أنت بخير؟

319
00:16:45,500 --> 00:16:46,440
.نعم

320
00:16:46,690 --> 00:16:52,150
عليك الآن أن تتحسّس الطّاولة
!حولك لتعرف مكان كلّ شيء

321
00:16:52,700 --> 00:16:53,740
.مفهوم

322
00:16:54,370 --> 00:16:57,950
.يبدو تونومي-سان متوتّرًا جدًّا

323
00:17:01,200 --> 00:17:02,700
!كم هذا لذيذ

324
00:17:03,280 --> 00:17:05,870
!هل جرّبتَ الطّبق المسمّى تيرين؟

325
00:17:08,110 --> 00:17:09,220
تونومي-سان؟

326
00:17:09,790 --> 00:17:12,840
.أنا آسف. عليّ الذّهاب للحمّام

327
00:17:12,840 --> 00:17:14,170
.أ-أكيد

328
00:17:24,460 --> 00:17:25,430
ما الّذي يحدث؟

329
00:17:34,730 --> 00:17:35,740
ياكو-سان؟

330
00:17:36,750 --> 00:17:37,830
.تونومي-سان

331
00:17:38,560 --> 00:17:41,380
هل تودّ المغادرة؟

332
00:17:43,310 --> 00:17:44,330
ألا تمانعين ذلك؟

333
00:17:44,660 --> 00:17:45,370
.بالطّبع لا

334
00:17:49,210 --> 00:17:51,640
آسف لأنّي أنهيتُ سهرتنا سريعًا
.مع أنّي من دعاك

335
00:17:51,640 --> 00:17:53,130
!لا بأس

336
00:17:53,410 --> 00:17:56,260
.لقد فوّتنا علينا الطّعام اللّذيذ أيضًا

337
00:17:56,260 --> 00:17:58,000
.أعدك أنّي سأعوّضك عن هذا

338
00:17:58,000 --> 00:17:59,680
!لا داعي للقلق حيال ذلك

339
00:17:59,680 --> 00:18:03,730
!طلبتُ منهم تغليفه من أجلنا

340
00:18:03,860 --> 00:18:05,340
!هذا مذهل

341
00:18:08,690 --> 00:18:10,820
!لا أطيق الانتظار حتّى نعود ونأكله

342
00:18:10,820 --> 00:18:12,190
.ولا أنا

343
00:18:12,790 --> 00:18:15,810
هل تودّين الذّهاب إلى منزلي والأكل هناك؟

344
00:18:15,810 --> 00:18:17,920
ماذا؟ أيمكنني ذلك؟

345
00:18:23,220 --> 00:18:24,540
.كلّ شيء جاهز

346
00:18:25,830 --> 00:18:27,620
.جهّزتُ كلّ شيء في طبق واحد

347
00:18:29,330 --> 00:18:30,980
ألا بأس ببعض المشروب؟

348
00:18:30,980 --> 00:18:32,290
!أكيد

349
00:18:33,020 --> 00:18:34,050
!كلاّ

350
00:18:34,420 --> 00:18:38,050
!"أنا متوتّرة جدًّا، كلّ ما يمكنني قوله هو "أوه

351
00:18:38,740 --> 00:18:41,460
ياكو-سان. آسف على ما تسبّبتُ
.به من مشاكل اليوم

352
00:18:41,850 --> 00:18:44,310
.لا بأس. لا داعي للقلق حيال ذلك

353
00:18:44,510 --> 00:18:48,310
.لم أدرك الأمر، لكنّي ربّما أخاف الظّلام

354
00:18:48,610 --> 00:18:49,880
الظّلام؟

355
00:18:50,020 --> 00:18:52,260
...السّبب الوحيد الّذي يخطر ببالي هو

356
00:18:53,580 --> 00:18:57,060
هل سبق وسمعت عن المخيّمات
الّتي يُرسَل إليها الأطفال للمبيت؟

357
00:18:57,400 --> 00:19:00,630
...قاموا في إحدى المرّات باختبار شجاعة

358
00:19:01,070 --> 00:19:04,720
.كان علينا حمل شمعة والسّير في طريق جبليّ

359
00:19:05,700 --> 00:19:08,050
!انظر، إنّه فريق كات-تشان

360
00:19:08,600 --> 00:19:10,190
!كات-تشان

361
00:19:10,900 --> 00:19:12,260
!انتظرني

362
00:19:28,130 --> 00:19:29,300
...النّجدة

363
00:19:34,710 --> 00:19:37,620
،ظننتُ أنّه سيكون من الخطير المواصلة وحدي

364
00:19:37,720 --> 00:19:41,020
.لذلك قرّرتُ الانتظار حتّى يعثر عليّ أحد ما

365
00:19:43,440 --> 00:19:46,160
.لكن لم يأت أيّ أحد

366
00:19:46,510 --> 00:19:51,570
سئمت الانتظار واستطعتُ
...العودة للأكواخ وحدي

367
00:19:54,660 --> 00:19:57,680
.لكن لم يدرك أيّ أحد أنّي كنتُ غائبًا

368
00:19:59,860 --> 00:20:03,180
الأمر سيّان بالنّسبة لهم سواء
.كنتُ هناك أم لا لأنّي خفيّ

369
00:20:08,250 --> 00:20:10,640
.أعتقد أنّ ذلك كان صادمًا بالنّسبة لي

370
00:20:12,390 --> 00:20:15,980
وفي المدينة، من النّادر أن نجد
.أنفسنا في ظلام دامس

371
00:20:16,360 --> 00:20:18,600
،لم أدرك أبدًا أنّ ذلك كان صعبًا عليّ

372
00:20:18,760 --> 00:20:20,240
.لذلك أخذني الأمر على حين غرّة اليوم

373
00:20:21,130 --> 00:20:23,120
.سيتوجّب عليّ أن أحذر في المستقبل

374
00:20:23,660 --> 00:20:24,740
.تونومي-سان

375
00:20:25,660 --> 00:20:28,060
.أنا ألاحظ هذه الأشياء

376
00:20:31,080 --> 00:20:33,820
تكون الأصوات الصّادرة عنك
،متماسكة ومرتّبة

377
00:20:34,120 --> 00:20:37,490
.لذلك من السّهل الملاحظة عندما ترتبك

378
00:20:38,340 --> 00:20:41,550
...وحتّى الآن، تحاول أن تبدو مبتهجًا، لكن

379
00:20:41,960 --> 00:20:45,210
.أصوات كأسك وإيقاع شربك كلّها مضطربة

380
00:20:45,770 --> 00:20:49,900
.واضح لي أنّك خائف وحزين جدًّا

381
00:20:50,780 --> 00:20:54,550
.ومع ذلك، سأفتقدك لو لم تكن قربي

382
00:20:54,860 --> 00:20:57,320
!وكنتُ لأبحث عنك بكلّ تأكيد

383
00:21:07,330 --> 00:21:10,080
هلاّ صرتي حبيبتي؟

384
00:21:12,900 --> 00:21:15,080
أهذه هي ردّة فعلك؟

385
00:21:15,080 --> 00:21:16,350
!كـ-كلاّ

386
00:21:16,350 --> 00:21:18,260
!لا مشكلة لديّ حيال ذلك

387
00:21:18,260 --> 00:21:19,060
.حسنًا

388
00:21:19,760 --> 00:21:23,880
.أدركتُ للتّوّ أنّي أحبّ تواجدك قربي

389
00:21:24,260 --> 00:21:26,140
ما رأيك؟

390
00:21:26,930 --> 00:21:28,550
...لـ-لكن

391
00:21:28,760 --> 00:21:32,800
،إن كنّا نتواعد بشكل رسميّ الآن
فما الّذي سيحدث تاليًا؟

392
00:21:34,140 --> 00:21:34,740
...لا

393
00:21:35,260 --> 00:21:36,210
!لا، لا

394
00:21:36,310 --> 00:21:40,040
كنتُ أنوي توصيلك والذّهاب
!إلى المنزل مباشرة هذه المرّة

395
00:21:40,040 --> 00:21:41,340
هذه المرّة"؟"

396
00:21:41,340 --> 00:21:44,480
...ياكو-سان، رجاءً

397
00:21:44,850 --> 00:21:46,230
.يكفي

398
00:21:47,300 --> 00:21:50,360
أم تريديني أن أقوم بالمزيد؟

399
00:21:51,330 --> 00:21:54,460
.ما الأمر؟ لا تنطقين إلاّ بتأثيرات صوتيّة

400
00:21:54,460 --> 00:21:57,730
!إ-إنّها أصوات كوني غير مستعدّة ذهنيّة

401
00:21:57,730 --> 00:22:00,590
.نعم، أظنّ ذلك

402
00:22:02,820 --> 00:22:03,660
.حسنًا

403
00:22:04,410 --> 00:22:05,920
.أنا أحبّك

404
00:22:05,920 --> 00:22:07,050
!لا تصرخي