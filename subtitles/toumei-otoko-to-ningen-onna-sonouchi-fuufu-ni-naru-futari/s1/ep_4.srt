1
00:01:30,800 --> 00:01:35,320
.أحضرتُ الزّبونة الّتي بحاجة للتّحقيق

2
00:01:42,240 --> 00:01:43,660
.هذه سوكيا أيا-سان

3
00:01:44,460 --> 00:01:45,800
أنت خفيّة؟

4
00:01:46,020 --> 00:01:47,000
أنت أيضًا؟

5
00:01:47,550 --> 00:01:49,480
.تبدو مثل تونومي إن ارتدى ملابس نساء

6
00:01:50,250 --> 00:01:53,180
.ليس عليك البوح بكلّ فكرة تخطر في بالك

7
00:01:53,680 --> 00:01:56,180
تونومي-سان بملابس نساء"؟"

8
00:01:56,470 --> 00:01:58,600
.أنا آسف، إنّها تفتقر للّباقة

9
00:01:59,690 --> 00:02:01,920
أنت هو تونومي-سان إذًا؟

10
00:02:01,920 --> 00:02:02,560
.نعم

11
00:02:02,950 --> 00:02:06,360
!لم أقابل شخصًا خفيًّا في المدينة من قبل

12
00:02:06,360 --> 00:02:09,760
أنا مسرورة جدًّا لأنّ هنالك عضوًا
!من بني جنسي يساعدني

13
00:02:10,220 --> 00:02:11,180
.بكلّ سرور

14
00:02:16,390 --> 00:02:18,270
!يا لها من مصادفة

15
00:02:17,420 --> 00:02:19,120
.شيزوكا

16
00:02:18,270 --> 00:02:20,010
.كنت متفاجئًا

17
00:02:19,640 --> 00:02:21,440
هل تشعرين بعدم ارتياح؟

18
00:02:20,010 --> 00:02:24,830
ظننتُ أنّ وكالة تونومي للتّحقيق
.ستستطيع تولّي هذا

19
00:02:21,840 --> 00:02:24,810
!كـ-كيف تقولين هذا؟ إنّها زبونة

20
00:02:24,810 --> 00:02:26,080
...ومع ذلك

21
00:02:24,830 --> 00:02:29,130
!لا بدّ أنّها إشارة جيّدة

22
00:02:26,080 --> 00:02:28,740
يبدو أنّهما منسجمان كثيرًا، صحيح؟

23
00:02:28,740 --> 00:02:31,700
يحدث ذلك عندما لا يلتقي
.الفرد بنفس بني جنسه كثيرًا

24
00:02:29,130 --> 00:02:33,200
هذه أيضًا أوّل مرّة أقوم فيها
.بمهمّة لأحد من بني جنسي

25
00:02:32,200 --> 00:02:37,880
حسنًا... يبدو صوت أكيرا-سان
.ودودًا أكثر من المعتاد

26
00:02:33,630 --> 00:02:36,960
تونومي-سان، هل ولدتَ في قرية الخفيّين؟

27
00:02:36,960 --> 00:02:39,920
.لا، تربّيتُ خارجها

28
00:02:37,880 --> 00:02:39,900
.إنّك تشعرين بعدم الارتياح بالفعل

29
00:02:39,900 --> 00:02:41,630
!هذا ظريف

30
00:02:39,920 --> 00:02:41,640
!وأنا أيضًا

31
00:02:43,960 --> 00:02:45,940
تمّ اتّهامك بالسّرقة؟

32
00:02:46,350 --> 00:02:47,220
.نعم

33
00:02:47,630 --> 00:02:50,920
.اختفى مال من الخزنة حيث أعمل

34
00:02:52,060 --> 00:02:54,720
.لم يظهر أيّ أحد في كاميرات المراقبة

35
00:02:55,170 --> 00:03:01,450
قرّر نائب المدير أنّ الجاني
.لا بدّ أنّ يكون شخصًا خفيًّا

36
00:03:03,100 --> 00:03:04,240
ماذا قال المدير؟

37
00:03:04,240 --> 00:03:06,010
.المدير في المستشفى

38
00:03:06,010 --> 00:03:07,750
.وكان نائب المدير يتولّى الأمور بدلاً منه

39
00:03:07,750 --> 00:03:09,870
!لستُ الفاعلة بالطّبع

40
00:03:10,080 --> 00:03:15,570
...لكنّ نائب المدير يبدو مقتنعًا أنّي الفاعلة

41
00:03:16,360 --> 00:03:18,630
مع أنّه لا يملك أيّ دليل؟

42
00:03:19,090 --> 00:03:19,730
.صحيح

43
00:03:20,280 --> 00:03:22,640
،ومن الصّعب إثبات حجّة غياب

44
00:03:22,820 --> 00:03:26,640
لأنّه من الصّعب التّعرّف على
.الخفيّين من ملامح وجوههم

45
00:03:27,380 --> 00:03:30,790
،كانت سوكيا-سان في مكان آخر يومها

46
00:03:30,790 --> 00:03:34,970
لكنّها لا تعرف كيف تثبت
.أنّها هي لتأمين حجّة غياب

47
00:03:37,560 --> 00:03:38,490
.لا داعي للقلق

48
00:03:39,710 --> 00:03:41,390
.أعد أنّي سأساعدك

49
00:03:45,130 --> 00:03:48,280
.رجاءً وشكرًا لك

50
00:03:53,290 --> 00:03:57,240
.أنا أنوب عن المدير حاليًّا واسمي غامايكي

51
00:03:57,240 --> 00:04:02,930
أرى أنّها عيّنت محاميًا ومحقّقًا خاصًّا؟

52
00:04:03,490 --> 00:04:07,730
.وأنت أيضًا شخص خفيّ

53
00:04:07,730 --> 00:04:11,960
هل يمكنني رؤية بيانات
الفيديو من كاميرات المراقبة؟

54
00:04:13,440 --> 00:04:15,940
.حسنًا... بالطّبع يمكنك

55
00:04:18,130 --> 00:04:19,270
.فهمت

56
00:04:19,940 --> 00:04:24,260
يبدو أنّ لا أحد اقترب من الخزنة

57
00:04:24,500 --> 00:04:27,490
بين وقت إغلاقك لها آخر مرّة
.ووقت فتحها البارحة

58
00:04:27,490 --> 00:04:29,460
!نعم، وهذا هو السّبب

59
00:04:29,460 --> 00:04:33,080
لديكم أنتم الخفيّون
"قدرة "الاختفاء الكامل

60
00:04:33,080 --> 00:04:36,960
بحيث يمكنكم جعل حتّى
ملابسكم تختفي أيضًا، صحيح؟

61
00:04:36,960 --> 00:04:40,120
!أعتقد أنّها استعملت ذلك بكلّ تأكيد

62
00:04:41,810 --> 00:04:42,980
ما-ماذا؟

63
00:04:43,990 --> 00:04:45,790
!أين ذهب المحقّق؟

64
00:04:54,540 --> 00:04:55,360
.المعذرة

65
00:04:59,310 --> 00:05:02,240
.هكذا تعمل قدرة الاختفاء الكامل

66
00:05:02,630 --> 00:05:07,520
لكنّها تجعلنا نختفي فحسب
.ولا تجعلنا غير ملموسين

67
00:05:08,520 --> 00:05:09,480
...وبالتّالي

68
00:05:09,770 --> 00:05:15,540
من المستحيل أن تسرق المال
.من خزنة لم تكن مفتوحة

69
00:05:16,320 --> 00:05:18,710
...إ-إنّ ذلك

70
00:05:18,880 --> 00:05:21,920
!أفترض أنّي أسأت فهم الأمر

71
00:05:21,920 --> 00:05:27,340
،أنا آسف. اختفى المال
...لذلك كنتُ مصدومًا

72
00:05:27,340 --> 00:05:30,850
.في الحقيقة، لدينا فيديو آخر لنريه لك

73
00:05:31,220 --> 00:05:33,960
بعد بضعة أيّام من تولّيك زمام
،الأمور نيابة عن المدير

74
00:05:33,960 --> 00:05:38,330
تمّت مشاهدتك تُودِع نقودًا
.في جهاز صرف آليّ كلّ يوم

75
00:05:39,780 --> 00:05:41,720
،بسبب خوفك من أن يُكشف أمرك

76
00:05:42,000 --> 00:05:44,570
قرّرتَ أن تستغلّ صفات سوكيا-سان

77
00:05:46,120 --> 00:05:47,970
.لإلقاء اللّوم عليها

78
00:05:49,320 --> 00:05:50,180
أليس ذلك صحيحًا؟

79
00:05:53,470 --> 00:05:56,640
.أعتقد أنّ ذلك يُعدّ تشهيرًا

80
00:05:57,520 --> 00:05:58,880
.واختلاسًا أيضًا

81
00:05:59,530 --> 00:06:01,800
!ما الّذي يجري هنا؟

82
00:06:02,430 --> 00:06:04,540
!سـ-سيّدي المدير

83
00:06:04,540 --> 00:06:08,690
ما الّذي كنتَ تفعله وأنا في المستشفى
!بسبب التهاب الزّائدة الدّوديّة؟

84
00:06:08,690 --> 00:06:11,690
...كـ-كان ذلك وليد اللّحظة كما يُقال

85
00:06:11,690 --> 00:06:15,180
!واضح أنّ هذا أمر دُبّر له سلفًا

86
00:06:19,350 --> 00:06:21,260
!شكرًا لك! لقد أنقذت حياتي

87
00:06:21,720 --> 00:06:24,640
،شرح المدير كلّ شيء للآخرين

88
00:06:24,640 --> 00:06:26,570
.لذلك سأتمكّن من العودة إلى عملي

89
00:06:26,890 --> 00:06:28,830
.أنا مسرور لأنّه تمّت تبرئة اسمك

90
00:06:29,260 --> 00:06:32,130
.لا توجد كلمات كافية لشكرك بالفعل

91
00:06:36,710 --> 00:06:41,270
شكرًا لكم جميعًا على سلاسة
.تعاملكم مع هذا التّحقيق

92
00:06:41,690 --> 00:06:46,700
استطعنا حلّ القضيّة قبل أن تتفاقم
.الادّعاءات الموجّهة ضدّ موكّلتنا

93
00:06:47,340 --> 00:06:49,660
ومع أنّ لكم الكثير من الواجبات
...للتّعامل معها

94
00:06:49,660 --> 00:06:53,360
لا داعي للقلق. حرصتْ شيزوكا
.على أن تتوافق جميع جداولنا معًا

95
00:06:54,040 --> 00:06:56,260
.لقد تقاسمنا كلّ واجباتنا بيننا نحن الثّلاثة

96
00:06:56,660 --> 00:06:59,030
.كانت فكرة ياكو من البداية

97
00:06:59,280 --> 00:07:00,520
فكرة شيزوكا-سان؟

98
00:07:00,740 --> 00:07:04,150
.أرادت القيام بشيء ما لمساعدتك

99
00:07:04,150 --> 00:07:07,100
!لـ-لم أقم بأيّ شيء مهمّ

100
00:07:07,100 --> 00:07:08,650
!كنتُ أدعمهما فحسب في معظم الأحيان

101
00:07:08,650 --> 00:07:11,950
!أنا آسفة! ما كان عليّ المبالغة لذلك الحدّ

102
00:07:12,100 --> 00:07:14,640
لا، لكن... لماذا؟

103
00:07:14,920 --> 00:07:16,220
...لأنّ

104
00:07:17,430 --> 00:07:19,750
مع أنّه لا يملك أيّ دليل؟

105
00:07:20,540 --> 00:07:24,300
كان بإمكاني الشّعور بالقليل من
...الغضب في صوت أكيرا-سان

106
00:07:24,820 --> 00:07:26,910
.لكنّي واثقة أنّه لا يمكنني إخباره بذلك

107
00:07:30,780 --> 00:07:32,290
.شكرًا لك يا شيزوكا-سان

108
00:07:34,130 --> 00:07:37,180
.سمحتِ لنا بإنقاذ زبونتنا

109
00:07:40,440 --> 00:07:41,480
.لديّ اقتراح

110
00:07:41,620 --> 00:07:44,680
ما رأيكم برحلة شركة كعربون شكر؟

111
00:07:44,800 --> 00:07:48,550
!يبدو ذلك رائعًا! أريد الذّهاب للجبال

112
00:07:48,550 --> 00:07:50,750
فكرة ممتازة! ما رأيكم بالتّخييم؟

113
00:07:50,750 --> 00:07:53,860
!ستأتي أيضًا؟ لا تعمل هنا من الأساس

114
00:07:53,860 --> 00:07:56,420
إذًا جبلٌ يضمّ مخيّمًا؟

115
00:07:56,420 --> 00:07:57,320
.كان ذلك سريعًا

116
00:07:57,320 --> 00:08:00,200
!لا أطيق الانتظار للخيام ونيران المخيّم

117
00:08:00,200 --> 00:08:02,180
!دايتشي، بإمكاننا توصيل الجميع

118
00:08:01,030 --> 00:08:02,890
سيكون ذلك ممتعًا، صحيح يا شيزوكا-سان؟

119
00:08:02,700 --> 00:08:05,690
لا بأس، لكن ماذا عن عملك؟

120
00:08:04,800 --> 00:08:06,750
.عاد أكيرا-سان إلى طبيعته

121
00:08:05,690 --> 00:08:08,760
!سآخذ إجازة مدفوعة بالطّبع

122
00:08:07,560 --> 00:08:09,680
!أجل، سيكون هذا ممتعًا

123
00:08:08,760 --> 00:08:10,350
.أرى أنّك متحمّس جدًّا لهذا

124
00:08:13,800 --> 00:08:14,720
!نحن في الجبل

125
00:08:14,950 --> 00:08:15,730
!نحن في النّهر

126
00:08:15,960 --> 00:08:17,980
!نحن نخيّم

127
00:08:17,400 --> 00:08:19,020
!أجل

128
00:08:19,020 --> 00:08:21,140
أيمكنكما المساعدة؟

129
00:08:21,400 --> 00:08:24,370
ما الّذي يفعله ذلك المحامي الوغد؟

130
00:08:24,370 --> 00:08:25,480
!أجهّز آلة التّدخين

131
00:08:25,740 --> 00:08:27,910
لماذا ترتدين نظّارات شمسيّة
يا شيزوكا-سان؟

132
00:08:28,290 --> 00:08:29,700
.لكنّك تبديه رائعة جدًّا

133
00:08:29,840 --> 00:08:33,710
،مع وجودنا وسط الأشجار هنا
.هناك احتمال أن أؤذي عينيّ بغصونها

134
00:08:33,710 --> 00:08:35,000
.وهكذا أحاول منع ذلك

135
00:08:35,000 --> 00:08:35,920
!فهمت

136
00:08:36,330 --> 00:08:38,850
حسنًا، كيف يمكنني المساعدة؟

137
00:08:38,850 --> 00:08:42,950
هل يمكنك سحق حبوب القهوة
لنستخدمها وقت الاستراحة؟

138
00:08:42,950 --> 00:08:43,690
!أكيد

139
00:08:43,690 --> 00:08:47,460
.مهلاً، لا أعرف كيف أنصب خيمة

140
00:08:47,460 --> 00:08:49,460
ما رأيك بتجهيز الحطب إذًا؟

141
00:08:49,460 --> 00:08:50,970
!لستِ بحاجة لفأس حتّى

142
00:08:52,280 --> 00:08:55,080
.يبدو أنّك تحبّ التّخييم يا مادارايتو-سان

143
00:08:55,370 --> 00:08:58,240
كما أنّ لديك كلّ المعدّات
.المناسبة للتّخييم أيضًا

144
00:08:59,860 --> 00:09:03,230
.في الحقيقة، كنتُ أكره الجبال

145
00:09:03,490 --> 00:09:07,370
.لكنّي صرت أحبّها بفضل دايتشي

146
00:09:20,660 --> 00:09:21,440
.شيزوكا-سان

147
00:09:22,880 --> 00:09:25,070
أتودّين الذّهاب في نزهة معي؟

148
00:09:29,220 --> 00:09:31,240
ألا تبدو كلّ الأصوات مريحة؟

149
00:09:31,810 --> 00:09:34,220
...وكذلك الرّوائح في الرّيح

150
00:09:34,520 --> 00:09:36,840
أتفضّلين أن نُبطئ قليلاً؟

151
00:09:36,840 --> 00:09:38,690
.لا، لا بأس بهذه الوتيرة

152
00:09:40,820 --> 00:09:42,620
.لا يوجد سياج في هذه المنطقة

153
00:09:42,620 --> 00:09:44,890
أتفضّلين السّير على الجانب
الأبعد من الطّريق؟

154
00:09:45,030 --> 00:09:47,680
ما الّذي يوجد على الجانب الآخر من السّياج؟

155
00:09:47,680 --> 00:09:49,600
.منحدر حادّ، أشبه بجرف

156
00:09:50,400 --> 00:09:51,780
!لا بدّ أن ننتبه حتّى لا نسقط

157
00:09:52,270 --> 00:09:56,050
.لكنّي أشعر بأمان معك يا أكيرا-سان

158
00:09:57,480 --> 00:10:01,400
.أشعر بالأمان معك أيضًا يا شيزوكا-سان

159
00:10:01,660 --> 00:10:02,990
...هذا صحيح

160
00:10:03,840 --> 00:10:07,570
خاض أكيرا-سان تجربة مخيفة
.في الجبال خلال ذلك الوقت

161
00:10:08,580 --> 00:10:11,880
ألا تمانع بالفعل أن توجد في الجبال؟

162
00:10:13,320 --> 00:10:16,130
صحيح أنّ لديّ آثار صدمة
،عالقة من تلك التّجربة

163
00:10:16,440 --> 00:10:19,280
لكنّني أشعر بأنّي قادر على
،مواجهة أيّ شيء ما دمتِ هنا

164
00:10:19,860 --> 00:10:21,700
!حتّى أنّي نسيت الأمر تمامًا

165
00:10:23,440 --> 00:10:25,160
...أ-أنا لم أقصد

166
00:10:25,380 --> 00:10:27,430
.مهلاً، هنالك مقعد

167
00:10:27,710 --> 00:10:28,680
.لنجلس قليلاً

168
00:10:32,990 --> 00:10:38,280
.عفوًا... واثقة أنّي لا أشكّل قيمة كبيرة لك

169
00:10:38,510 --> 00:10:43,000
لكنّك ساعدتِ في قضيّة المرأة الخفيّة، صحيح؟

170
00:10:43,000 --> 00:10:44,700
!لم يكن ذلك بشيء يُذكر حتّى

171
00:10:44,700 --> 00:10:45,750
...لكن

172
00:10:46,190 --> 00:10:46,930
لكن ماذا؟

173
00:10:47,640 --> 00:10:50,870
...إنّك لا تغضب كثيرًا في العادة

174
00:10:53,040 --> 00:10:55,770
أنا آسف. هل أخفتك؟

175
00:10:55,770 --> 00:10:57,430
!ذلك ليس ما قصدت

176
00:10:57,610 --> 00:11:02,130
...فكّرتُ فقط أنّه إن كنتَ من اِتُّهم بذلك

177
00:11:02,510 --> 00:11:07,790
...بدأتُ أتخيّل الأمر
...ويُشعرني ذلك بخزن خانق

178
00:11:08,900 --> 00:11:13,400
ثمّ أقول لنفسي أنّه ربّما عليّ أن أهتمّ
...بشؤوني الخاصّة فحسب

179
00:11:14,430 --> 00:11:16,160
.ليس عليك القلق حيال ذلك كثيرًا

180
00:11:18,400 --> 00:11:22,620
،أحاسيس أكيرا-سان... حرارة جسده
!ورائحته... صارت أكثر حدّة فجأة

181
00:11:23,080 --> 00:11:26,970
لطالما كان يُقابَل الأشخاص الخفيّون
.بالرّيبة على مرّ التّاريخ

182
00:11:27,390 --> 00:11:30,080
،ولهذا أنا ممتنّ حقًّا لأنّنا
،بفضلك وبفضل الآخرين

183
00:11:30,080 --> 00:11:33,950
.تمكّنّا من تبرئة اسم زبونتنا تمامًا

184
00:11:35,580 --> 00:11:37,840
...لكنّ الأهمّ من ذلك الآن

185
00:11:38,250 --> 00:11:39,950
!أ-أكيرا-سان؟

186
00:11:41,840 --> 00:11:44,850
...إنّه يضغط على ظهري
!كم هو دافئ

187
00:11:45,330 --> 00:11:46,230
ألا تحبّين هذا؟

188
00:11:46,700 --> 00:11:48,810
...لا... لا بأس بهذا

189
00:11:50,580 --> 00:11:55,520
هل ضحكتَ للتّوّ؟
!شعرتُ بهزّة خفيفة في جسدك

190
00:11:58,090 --> 00:12:01,590
لا يمكنني إخفاء مشاعري عنك
.يا شيزوكا-سان

191
00:12:02,980 --> 00:12:05,640
.وهذا هو أكثر ما يُسعدني

192
00:12:06,560 --> 00:12:09,200
.أريدك أن تكشفي المزيد من الأشياء عنّي

193
00:12:17,070 --> 00:12:19,040
...أ-أكان ذلك

194
00:12:19,360 --> 00:12:20,400
.لقد قبّلتك

195
00:12:23,400 --> 00:12:24,430
ألا يجدر بي ذلك؟

196
00:12:24,600 --> 00:12:27,010
!لا، لا باس بذلك، فعلاً

197
00:12:29,550 --> 00:12:30,930
هل حان وقت العودة؟

198
00:12:32,030 --> 00:12:33,860
...عـ-عفوًا

199
00:12:34,830 --> 00:12:38,120
أيمكننا البقاء هكذا لوقت أطول؟

200
00:12:41,000 --> 00:12:42,220
هل أقبّلك ثانية؟

201
00:12:42,840 --> 00:12:46,440
.حسنًا... لا أظنّني... سأعترض على ذلك

202
00:12:50,650 --> 00:12:53,330
.لقد تأخّرا كثيرًا

203
00:12:53,330 --> 00:12:54,960
.قمتُ بتقشيرها كلّها

204
00:12:54,960 --> 00:12:57,460
!تناوُل الكاري أثناء التّخييم ضروريّ

205
00:13:05,810 --> 00:13:07,440
.يذكّرني هذا بالماضي

206
00:13:07,720 --> 00:13:10,820
.كنتُ أكره الجبال

207
00:13:11,360 --> 00:13:13,880
.كرهتها كثيرًا لدرجة أنّي بدأت أحمل ضغينة ضدّها

208
00:13:15,630 --> 00:13:18,690
كنت أقول لنفسي أنّي سأجد من ابتكر
فكرة الرّحلات المدرسيّة الجبليّة

209
00:13:23,830 --> 00:13:25,450
أأنت بخير يا مادارايتو؟

210
00:13:25,880 --> 00:13:28,700
.يمكنكما أن تسبقاني

211
00:13:29,090 --> 00:13:29,660
حسنًا؟

212
00:13:30,030 --> 00:13:30,730
أواثق من ذلك؟

213
00:13:31,040 --> 00:13:34,510
.نعم، اذهبا. سألحق بكم على وتيرتي

214
00:13:35,630 --> 00:13:37,640
.حسنًا... نراك لاحقًا إذًا

215
00:13:43,440 --> 00:13:46,690
.كلاّ... إنّ الجميع يسبقونني

216
00:13:53,560 --> 00:13:55,440
!أكره الرّحلات المدرسيّة

217
00:13:57,820 --> 00:13:58,860
...أهذا

218
00:14:00,080 --> 00:14:01,280
كيكيرا-كُن؟

219
00:14:01,800 --> 00:14:04,650
،إنّنا في نفس الفصل
.لكنّنا لم نتكلّم معًا من قبل

220
00:14:05,460 --> 00:14:07,120
.ومع ذلك، هذا جيّد

221
00:14:07,440 --> 00:14:10,100
.من المريح معرفة أنّ شخصًا آخر ما زال هنا

222
00:14:15,260 --> 00:14:19,400
وجود كيكيرا-كُن هنا ساعدني
...على الوصول إلى هذا الحدّ

223
00:14:20,690 --> 00:14:22,100
...لكن

224
00:14:22,920 --> 00:14:25,420
.لا يمكنني... المواصلة

225
00:14:31,440 --> 00:14:32,450
!كيكيرا-كُن؟

226
00:14:35,830 --> 00:14:37,220
شكرًا لك؟

227
00:14:39,180 --> 00:14:42,730
!مـ-مهلاً، انتظر
!لا يمكنني السّماح لك بذلك

228
00:14:43,150 --> 00:14:46,940
.سر بوتيرة أسرع إذًا يا هذا

229
00:14:48,290 --> 00:14:50,240
!يا له من تصرّف تسونداري مفاجئ

230
00:14:53,870 --> 00:14:56,360
.لقد تأخّرتما كثيرًا

231
00:14:56,670 --> 00:14:59,280
.سبق وتناول الجميع غداءهم

232
00:15:05,130 --> 00:15:05,970
.كيكيرا-كُن

233
00:15:07,160 --> 00:15:08,400
.شكرًا على ما فعلته لأجلي

234
00:15:08,820 --> 00:15:10,640
أتريد تناول الغداء معي؟

235
00:15:12,320 --> 00:15:12,910
لماذا؟

236
00:15:13,520 --> 00:15:14,780
!لماذا؟

237
00:15:15,030 --> 00:15:16,760
.نحن لسنا صديقين أو ما شابه

238
00:15:17,700 --> 00:15:22,150
!لكنّك... ساعدتني مع أنّنا لسنا صديقين

239
00:15:22,310 --> 00:15:25,910
الأمر مشابه لتقديم مقعدي
.في القطار لعجوز ما

240
00:15:26,480 --> 00:15:28,520
!أنا مثل عجوز ما بالنّسبة إليك؟

241
00:15:28,720 --> 00:15:29,280
.نعم

242
00:15:29,660 --> 00:15:33,720
!هيّا! سيكون الأكل وحيدًا غريبًا جدًّا

243
00:15:33,900 --> 00:15:35,520
!كُل معي

244
00:15:37,450 --> 00:15:38,720
.لا بأس إذًا

245
00:15:40,440 --> 00:15:41,620
!سرّني هذا

246
00:15:42,240 --> 00:15:46,090
.فهمت. كيكيرا-كُن شخص غريب نوعًا ما

247
00:15:46,450 --> 00:15:49,500
لذلك السّبب لا أسمع أنّه يواعد
.أيّ أحد مع أنّه شخص وسيم جدًّا

248
00:15:51,910 --> 00:15:53,340
!بإمكانك تناول بعض من غدائي

249
00:15:54,440 --> 00:15:55,360
.سآخذ الدّجاج المقليّ

250
00:15:55,360 --> 00:15:56,870
!بلا ذرّة خجل واحدة

251
00:16:01,140 --> 00:16:03,540
.اسمع، لنجلس معًا في الحافلة

252
00:16:03,540 --> 00:16:04,790
.لا أمانع

253
00:16:11,080 --> 00:16:12,590
.غلبني النّعاس

254
00:16:12,960 --> 00:16:15,480
.ماذا؟ كيكيرا-كُن نائم أيضًا

255
00:16:18,110 --> 00:16:19,420
...وبينما هو نائم

256
00:16:21,720 --> 00:16:24,520
...سيكون الوضع محرجًا قليلاً عندما يستيقظ

257
00:16:25,190 --> 00:16:27,870
...سأحاول ألاّ أوقظه

258
00:16:35,480 --> 00:16:36,680
...ربّما لبعض الوقت

259
00:16:44,640 --> 00:16:45,790
...عليّ النّوم

260
00:16:46,880 --> 00:16:49,940
!مهلاً، لمن تكن نائمًا؟

261
00:16:54,000 --> 00:16:56,090
!يمكنني البقاء هكذا إذًا؟

262
00:17:01,290 --> 00:17:03,160
!وذلك ما حدث

263
00:17:03,160 --> 00:17:05,880
!وبدأنا نتواعد بعدها

264
00:17:06,290 --> 00:17:09,190
لطالما كان مُتعِبًا هكذا إذًا؟

265
00:17:09,190 --> 00:17:12,550
!أمسكتما بيدي بعضكما طوال الطّريق
!كم هذا جميل

266
00:17:16,710 --> 00:17:18,810
.حسنًا

267
00:17:18,980 --> 00:17:22,230
.النّهر بطيء هنا، لذلك ستكون بقعة جيّدة

268
00:17:22,560 --> 00:17:25,160
!سمعتُ أنّه مكان جيّد لصيد السّمك أيضًا

269
00:17:26,030 --> 00:17:27,960
.إنّ خطوطك تجعل أيّ شيء يبدو لافتًا

270
00:17:28,810 --> 00:17:31,680
.وبطنك يجعل أيّ شيء يبدو مهيبًا

271
00:17:32,510 --> 00:17:34,700
.سأضع الغطاء هنا

272
00:17:35,120 --> 00:17:37,480
ماذا؟ أين ذهب ذلكما الاثنين؟

273
00:17:37,480 --> 00:17:38,870
.قالا أنّهما سيلحقان بنا

274
00:17:40,120 --> 00:17:42,300
!جا-جاراشي-سان

275
00:17:42,750 --> 00:17:45,440
شيزوكا-سان؟ هل من خطب ما؟

276
00:17:45,440 --> 00:17:46,520
!أكيرا-سان؟

277
00:17:46,910 --> 00:17:48,980
.ذهبت جاراشي-سان سلفًا

278
00:17:49,360 --> 00:17:50,350
هل أنادي عليها؟

279
00:17:50,350 --> 00:17:51,820
...كـ-كلاّ

280
00:17:52,680 --> 00:17:55,640
...أعتقد أنّك ستفي بالغرض

281
00:17:56,290 --> 00:17:58,900
هلاّ دخلت لبعض الوقت؟

282
00:18:00,500 --> 00:18:01,510
.بعد إذنك

283
00:18:03,570 --> 00:18:08,250
.لم أرتدتِ زيّ سباحة من قبل
.أعتقد أنّي أفسدته

284
00:18:11,230 --> 00:18:13,340
ماذا؟ أكيرا-سان؟

285
00:18:13,770 --> 00:18:16,100
...حسنًا... أنا... لحظة

286
00:18:17,630 --> 00:18:20,880
.يبدو الرّباط الآخر ملتفّ حول الهُدب

287
00:18:20,880 --> 00:18:23,740
.توقّعتُ أنّ ذلك ما حدث

288
00:18:24,430 --> 00:18:27,250
هل اخترتِ زيّ السّباحة هذا؟

289
00:18:27,880 --> 00:18:31,260
.لا، جاراشي-سان اختارته لي

290
00:18:31,690 --> 00:18:32,590
.هكذا إذًا

291
00:18:33,450 --> 00:18:35,370
.إنّه ظريف جدًّا. لقد أعجبني

292
00:18:35,370 --> 00:18:38,260
!فعلاً؟! كم سرّني هذا

293
00:18:39,100 --> 00:18:40,050
!يا للظّرافة

294
00:18:40,470 --> 00:18:42,100
...هذا صحيح

295
00:18:42,800 --> 00:18:44,920
.هذا جزء من الزّيّ أيضًا

296
00:18:44,920 --> 00:18:46,810
هل عليّ ارتداؤه؟

297
00:18:46,810 --> 00:18:47,540
.قومي بذلك رجاءً

298
00:18:52,330 --> 00:18:53,310
!لقد أتينا

299
00:18:55,060 --> 00:18:57,360
!تبدين ظريفة يا شيزوكا

300
00:18:59,320 --> 00:19:01,690
!انظر لكلّ الأسماك

301
00:19:02,420 --> 00:19:04,080
أليس شعورًا جيّدًا؟

302
00:19:04,080 --> 00:19:05,120
.نعم

303
00:19:05,120 --> 00:19:07,030
.انتبهي، تتّجه الأسماك نحوك

304
00:19:07,030 --> 00:19:08,240
.أنا لها

305
00:19:11,000 --> 00:19:12,670
!خذي

306
00:19:16,470 --> 00:19:18,680
.جاراشي-سان، أنت رائعة

307
00:19:18,680 --> 00:19:20,540
!أخافني ذلك

308
00:19:21,850 --> 00:19:23,800
!تعال وجرّب يا تونومي

309
00:19:23,800 --> 00:19:25,120
أنا؟

310
00:19:39,760 --> 00:19:41,280
.أخشى أنّ لا أمل منّي

311
00:19:41,280 --> 00:19:43,200
.نعم، نعم

312
00:19:43,460 --> 00:19:47,320
.مهلاً! تونومي، إنّك مفتول العضلات

313
00:19:48,200 --> 00:19:50,520
،التصق بك قميصك عندما تبلّل

314
00:19:50,520 --> 00:19:52,040
.وصار بإمكاني رؤية تفاصيل جسدك

315
00:19:52,040 --> 00:19:54,080
.هكذا إذًا

316
00:19:54,440 --> 00:19:57,400
أكيرا-سان... مفتول العضلات؟

317
00:19:59,590 --> 00:20:03,750
أ-أكيرا-سان! ألا يفترض بك خلع قميصك؟

318
00:20:03,750 --> 00:20:06,130
!ليس من الممتع الوقوف بملابس مبلّلة

319
00:20:06,130 --> 00:20:07,980
.نعم، هذا صحيح

320
00:20:08,630 --> 00:20:11,160
.لا يمكنني القيام بذلك

321
00:20:12,110 --> 00:20:13,670
لِمَ لا؟

322
00:20:14,190 --> 00:20:16,610
إنّ... كيف أصف الأمر...؟

323
00:20:17,610 --> 00:20:22,440
إن خلعتُ قميصي، فسيمكنكم مشاهدة
...ما بداخل سروالي القصير من الأعلى

324
00:20:22,890 --> 00:20:26,460
.وذلك... محرج نوعًا ما

325
00:20:29,360 --> 00:20:31,110
.لا أفهم الأمر بالكامل

326
00:20:31,110 --> 00:20:33,940
.وأنا لا أفهم أيضًا

327
00:20:33,940 --> 00:20:35,040
.لا يمكننا رؤية أيّ شيء من الأساس

328
00:20:35,040 --> 00:20:38,240
!الأمر محرج كثيرًا بالنّسبة للأشخاص الخفيّين

329
00:20:38,550 --> 00:20:39,610
.يا جاراشي

330
00:20:39,610 --> 00:20:42,310
.أمسكي بالمزيد من السّمك
.سنطبخه على الغداء

331
00:20:42,310 --> 00:20:43,830
!فكرة ممتازة

332
00:20:49,260 --> 00:20:50,310
.أكيرا-سان

333
00:20:50,880 --> 00:20:54,170
أيمكنني قول شيء ما؟

334
00:20:55,170 --> 00:20:55,940
ما هو؟

335
00:20:58,110 --> 00:21:02,640
...لا يُعجبني أن يقوم الآخرون
.بكشف أمور تخصّك

336
00:21:04,750 --> 00:21:06,650
.شيء من هذا القبيل

337
00:21:09,840 --> 00:21:12,880
.أنا آسف جدًّا حيال ذلك

338
00:21:16,580 --> 00:21:20,720
،آسفة لمقاطعة مرحكما
لكن أيمكنكما القيام بذلك في مكان آخر؟

339
00:21:28,270 --> 00:21:29,890
.بإمكانك النّوم إن أردت

340
00:21:30,080 --> 00:21:31,760
.لا، أنا بخير

341
00:21:32,290 --> 00:21:35,190
أعلمني فقط عندما تريد منّي
.القيادة بدلاً منك

342
00:21:35,400 --> 00:21:37,520
.وكأنّي سأثق برجل يتثاءب

343
00:21:37,520 --> 00:21:39,160
.ذلك لئيم

344
00:21:39,560 --> 00:21:42,000
.ها هو ذا لُطفك الغامض ثانية

345
00:21:42,400 --> 00:21:43,890
.من الجيّد أنّ ذلك يُعجبني

346
00:21:45,060 --> 00:21:47,080
...ما الّذي تقوله

347
00:21:47,700 --> 00:21:49,500
.إنّهم نائمون جميعًا

348
00:21:49,880 --> 00:21:52,400
العودة للمنزل من رحلةٍ مُتعبٌ دائمًا، صحيح؟

349
00:21:53,150 --> 00:21:56,210
...لا أزال مستيقظًا في الحقيقة

350
00:21:57,970 --> 00:22:00,110
...كم أودّ الذّهاب في رحلة معها فقط

351
00:22:00,900 --> 00:22:03,250
.لكن ربّما ما زال الوقت باكرًا على ذلك