1
00:01:30,850 --> 00:01:32,230
تونومي؟

2
00:01:32,430 --> 00:01:33,620
أأنت جاهز؟

3
00:01:33,620 --> 00:01:34,480
.نعم

4
00:01:34,680 --> 00:01:36,480
!اخرج إذًا

5
00:01:38,550 --> 00:01:40,750
—عجبًا، تبدو رائـ

6
00:01:40,990 --> 00:01:44,150
في الحقيقة، هذا أنت فقط وأنت
.ترتدي زيًّا مدرسيًّا بدل بذلة

7
00:01:44,150 --> 00:01:47,630
.لا يمكن تحديد عمري بالنّظر إليّ قبل كلّ شيء

8
00:01:47,630 --> 00:01:49,840
!يرتدي أكيرا-سان ملابس تلميذ؟

9
00:01:49,840 --> 00:01:51,890
!إنّ ذلك ظريف جدًّا بطريقة ما

10
00:01:52,120 --> 00:01:54,580
...لا شيء يستحقّ كلّ هذه الحماسة حقًّا

11
00:01:54,930 --> 00:01:58,760
إنّ تحقيقك التّالي في مكان يرتاده
الكثير من التّلاميذ، صحيح؟

12
00:01:58,760 --> 00:02:00,850
،وبما أنّه لا يمكن معرفة سنّه بالنّظر إليه

13
00:02:00,850 --> 00:02:03,050
.فإنّه مثاليّ لعمليّة سرّيّة كهذه

14
00:02:03,340 --> 00:02:06,410
لكنّها تناسبني، وأعتقد
.أنّي سأكون بخير هكذا

15
00:02:06,410 --> 00:02:07,560
!جيّد

16
00:02:08,110 --> 00:02:09,040
...حسنًا

17
00:02:09,040 --> 00:02:11,090
!التّالي هو كيكيرا

18
00:02:14,070 --> 00:02:16,470
!دايتشي! أيمكنني التقاط صورة؟

19
00:02:16,470 --> 00:02:18,620
.هذا ليس كوسبلاي

20
00:02:18,620 --> 00:02:21,190
.تبدو كشرطيّ بالفعل

21
00:02:21,190 --> 00:02:23,270
.ستنسجم معهم تمامًا

22
00:02:23,930 --> 00:02:27,120
.يبدو أنّ تنكّرنا أنا وكيكيرا-سان مقبولان

23
00:02:27,470 --> 00:02:30,580
—حسنًا، ستنتهي تجهيزاتنا هنا و

24
00:02:30,160 --> 00:02:31,090
.مهلاً

25
00:02:31,090 --> 00:02:33,380
من قال أنّنا انتهينا؟

26
00:02:34,060 --> 00:02:36,120
.لم تجرّبي تنكّرك بعد

27
00:02:36,360 --> 00:02:40,680
لا، لا أمانع! إنّه ليس شيئًا
...قد يودّ أيّ أحد رؤيته

28
00:02:40,680 --> 00:02:44,550
غير مسموح لك قول ذلك بعد
!أن جعلتني أمرّ بكلّ هذا

29
00:02:44,550 --> 00:02:46,090
!لا بأس

30
00:02:46,090 --> 00:02:48,520
!جرّبتُه قبل أن آتي إلى هنا

31
00:02:48,920 --> 00:02:50,520
!أيّتها المخادعة

32
00:02:50,520 --> 00:02:54,480
...ما دام يناسبها، فلا بأس بذلك

33
00:02:50,690 --> 00:02:52,450
!الأمر ليس مهمًّا

34
00:02:52,450 --> 00:02:53,810
!بل مهمّ

35
00:02:55,060 --> 00:02:57,820
ما هو زيّ جاراشي-سان؟

36
00:02:58,290 --> 00:03:00,880
.إنّه زيّ هدف عمليّتنا السّرّيّة التّالية

37
00:03:02,370 --> 00:03:03,410
!حاضرة

38
00:03:03,410 --> 00:03:05,990
!موكي-موكي كيون

39
00:03:06,820 --> 00:03:09,860
لماذا عليّ ارتداء هذا؟

40
00:03:10,370 --> 00:03:11,800
.ليس باليد حيلة

41
00:03:11,800 --> 00:03:14,780
.الهدف الّذي نسعى خلفه زبون دائم هنا

42
00:03:16,010 --> 00:03:18,080
،إنّه لم يصل بعد

43
00:03:18,080 --> 00:03:20,850
.لكن كفاك خجلاً وحافظي على تنكّرك

44
00:03:20,850 --> 00:03:22,140
!أنا لستُ خجلة

45
00:03:22,490 --> 00:03:24,400
!عفوًا أيّتها الخادمة الجديدة

46
00:03:24,400 --> 00:03:26,130
!إنّ نمط فروك ظريف جدًّا

47
00:03:27,700 --> 00:03:29,800
.قومي بعملك

48
00:03:30,880 --> 00:03:32,640
.فهمت

49
00:03:35,320 --> 00:03:39,240
.يا إلهي... الفرو العاديّ أفضل بكثير

50
00:03:39,740 --> 00:03:41,480
،إنّه يجعل الزّيّ محور الاهتمام

51
00:03:41,480 --> 00:03:43,610
.كما أنّه ناعم وظريف جدًّا

52
00:03:52,000 --> 00:03:54,670
!كان ذلك مرهقًا جدًّا

53
00:03:54,200 --> 00:03:57,380
!على مهلك! شكرًا على الجهد الّذي بذلته

54
00:03:57,550 --> 00:04:01,620
امتلأ المكان بالفتيات الصّغيرات الظّريفات
!اللاّتي يبدون رائعات بزيّ الخادمات

55
00:04:01,620 --> 00:04:07,700
لكنّ أكيرا-سان قال أنّك انسجمت معهنّ
.وحصلت على معلومات عن هدفك

56
00:04:08,300 --> 00:04:11,290
.بالطّبع كنتُ سأقوم بعملي في كلّ الأحوال

57
00:04:11,760 --> 00:04:15,840
أنا فقط لستُ مناسبة لمثل هذا
،العمل، وأعلم أنّي لستُ ظريفة

58
00:04:15,840 --> 00:04:18,080
.لذلك جعلني الأمر أشعر بعدم الارتياح

59
00:04:18,080 --> 00:04:18,820
،حسنًا

60
00:04:18,820 --> 00:04:21,820
،أنا لا أعرف كيف تبدين

61
00:04:21,820 --> 00:04:23,620
.لذلك لا أستطيع إبداء رأيي بشأن ظرافتك

62
00:04:24,200 --> 00:04:25,080
...لكن

63
00:04:26,450 --> 00:04:29,950
.أشعر أنّك ظريفة للغاية

64
00:04:30,110 --> 00:04:32,820
وأنا سعيدة لأنّي أستطيع
.احتضانك والشّعور بنعومتك

65
00:04:34,830 --> 00:04:36,600
!هذا تحرّش جنسيّ

66
00:04:36,600 --> 00:04:38,270
!ماذا؟ أذلك صحيح؟

67
00:04:38,270 --> 00:04:41,060
دعيني أداعب بشرتك أيضًا
.وسأعتبر أنّنا متعادلتان

68
00:04:41,060 --> 00:04:42,580
!أليس ذلك تحرّشًا جنسيًّا أيضًا؟

69
00:04:43,020 --> 00:04:45,880
على أيّ حال، لنذهب لشراء
!ملابس ثانية في وقت آخر

70
00:04:45,880 --> 00:04:47,090
!نزهة تسوّق حقيقيّة

71
00:04:48,320 --> 00:04:50,200
نزهة فتيات فقط؟

72
00:04:53,720 --> 00:04:57,990
!هذا ظريف! زيّ رائع آخر

73
00:04:59,230 --> 00:05:01,730
!مهلاً، هذا الفستان الجديد ظريف أيضًا

74
00:05:01,730 --> 00:05:02,850
!مـ-مهلاً لحظة

75
00:05:03,910 --> 00:05:06,000
نزهة التّسوّق من أجلي فقط؟

76
00:05:06,000 --> 00:05:06,740
نعم، لماذا؟

77
00:05:06,740 --> 00:05:08,880
.لا أريد حقًّا جذب كلّ الانتباه لي

78
00:05:08,880 --> 00:05:11,130
لماذا لا نشتري أشياء من أجلك أيضًا؟

79
00:05:11,130 --> 00:05:12,720
!لا تهتمّي لي

80
00:05:12,720 --> 00:05:15,500
!أحبّ مشاهدتك تجرّبين الملابس

81
00:05:15,500 --> 00:05:18,760
.لستُ دمية كما تعلمين

82
00:05:19,190 --> 00:05:22,470
.أنا متعبة قليلاً، لذلك سآخذ استراحة

83
00:05:22,470 --> 00:05:25,270
!استمتعي بالتّسوّق من دوني رجاءً

84
00:05:25,270 --> 00:05:26,600
...أ-أكيد

85
00:05:29,530 --> 00:05:34,020
،إنّ نمط فروي عدائيّ جدًّا
...ويجعل اختيار الملابس صعبًا

86
00:05:35,770 --> 00:05:37,750
...هذا الزّيّ ظريف

87
00:05:38,260 --> 00:05:42,350
.لكن إن ارتديتُه، فإنّ النّمطين سيتصادمان

88
00:05:47,130 --> 00:05:49,140
!ما كنتُ لأريد ذلك

89
00:05:52,690 --> 00:05:56,880
شيزوكا، هل شعرتِ يومًا
بالحسد من الآخرين؟

90
00:05:57,140 --> 00:05:59,110
شعرتُ بالحسد؟

91
00:06:00,990 --> 00:06:03,920
كالأشخاص الّذين يُبصرون... مثلاً؟

92
00:06:04,250 --> 00:06:08,190
لا أعرف ما هو شعور أن أبصر، لذلك
.لم يخطر ببالي يومًا أن أشعر بالغيرة

93
00:06:08,190 --> 00:06:11,180
هكذا إذًا؟

94
00:06:11,400 --> 00:06:13,350
ماذا عنك يا جاراشي-سان؟

95
00:06:13,890 --> 00:06:16,940
.أنا أحسدك كثيرًا يا شيزوكا

96
00:06:16,940 --> 00:06:18,400
تحسدينني أنا؟

97
00:06:18,750 --> 00:06:20,700
.إنّ لك لونًا واحدًا

98
00:06:21,110 --> 00:06:21,810
لون واحد؟

99
00:06:22,060 --> 00:06:24,110
!لذلك تناسبك الملابس الظّريفة

100
00:06:24,110 --> 00:06:25,570
.فهمت

101
00:06:25,720 --> 00:06:29,020
إذًا تريدين ارتداء ملابس ظريفة
يا جاراشي-سان؟

102
00:06:29,020 --> 00:06:30,750
!لكن لا أستطيع أن أنجح في ذلك

103
00:06:32,300 --> 00:06:37,420
قالت الخادمات والزّبائن في مقهى
...الخادمات أنّي بدوت جيّدة، لكن

104
00:06:37,700 --> 00:06:39,180
.ذلك ليس ما أريد

105
00:06:40,100 --> 00:06:42,620
،مهما جاملني الآخرون

106
00:06:42,910 --> 00:06:45,830
.فذلك ليس النّوع الّذي أريد من الظّرافة

107
00:06:46,640 --> 00:06:48,680
...أنا أريد أن أبدو مثل

108
00:06:51,620 --> 00:06:56,920
.لذلك ربّما لن أعتبر نفسي ظريفة أبدًا

109
00:06:58,230 --> 00:07:02,710
أتمنّى ألا تضحكي عليّ، مفهوم؟

110
00:07:04,210 --> 00:07:07,690
...لكن... كنت أفكّر في صباغة فروي

111
00:07:08,120 --> 00:07:10,450
.سأصبغ نمط فروي لأصير بلون واحد

112
00:07:10,860 --> 00:07:12,720
!يبدو ذلك جيّدًا في رأيي

113
00:07:12,720 --> 00:07:13,680
!لكنّه أمر صعب

114
00:07:14,240 --> 00:07:16,500
أهو أكثر جدّيّة ممّا يبدو عليه؟

115
00:07:18,860 --> 00:07:24,550
تنحدر سلالتي من شعب
.الوشق في الأمريكيّتين

116
00:07:24,780 --> 00:07:28,040
.ونمط فرونا هو دليل على إرثنا

117
00:07:28,410 --> 00:07:31,820
...وُلدتُ وتربّيتُ هنا، لذلك

118
00:07:31,820 --> 00:07:34,940
...أعتقد أنّي لا أدين بشيء لأيّ أحد، لكن

119
00:07:34,940 --> 00:07:38,020
!تذكّرتُ للتّوّ شيئًا قاله أكيرا-سان

120
00:07:38,820 --> 00:07:40,680
!هذا تغيير سريع للموضوع

121
00:07:40,680 --> 00:07:45,990
يهمس أكيرا-سان أحيانًا بأفكاره
.عن الأشياء الّتي ينظر إليها

122
00:07:46,700 --> 00:07:49,590
.القمر بدر كامل اللّيلة. إنّه جميل

123
00:07:49,840 --> 00:07:52,270
لماذا البدر جميل؟

124
00:07:53,400 --> 00:07:57,880
.بما أنّك ذكرت ذلك الآن، فأنا لستُ واثقًا

125
00:07:58,500 --> 00:08:03,450
هل تُعتبر كرة ذهبيّة مضيئة وسط
سواد سماء اللّيل شيئًا جميلاً؟

126
00:08:03,610 --> 00:08:05,410
...هذا يعني

127
00:08:05,660 --> 00:08:09,560
أنّ فاكهة يوزو على رقعة
طحالبِ نوري ستكون جميلة أيضًا؟

128
00:08:09,560 --> 00:08:10,840
لماذا؟

129
00:08:11,160 --> 00:08:15,500
عندما كنتُ طفلة، تعلّمتُ
،أنّ فاكهة اليوزو دائريّة وصفراء

130
00:08:15,500 --> 00:08:18,880
!وطحالب النّوري كبيرة وسوداء

131
00:08:18,880 --> 00:08:20,240
.فهمت

132
00:08:20,610 --> 00:08:22,810
.لكن أعجبني ذلك

133
00:08:24,030 --> 00:08:28,120
.هذه ليلةُ بدر كامل من أجلنا أنا وأنت فقط

134
00:08:28,120 --> 00:08:30,850
...من أجلنا أنا وأكيرا-سان فقط

135
00:08:34,490 --> 00:08:35,950
!يا شيزوكا

136
00:08:36,880 --> 00:08:39,860
.لا تشردي في أفكارك وتقهقهين لنفسك فقط

137
00:08:39,860 --> 00:08:42,450
!ماذا؟ أنا آسفة

138
00:08:42,450 --> 00:08:43,970
ما الّذي قاله تونومي إذًا؟

139
00:08:43,970 --> 00:08:46,550
!عفوًا... ذلك سرّ

140
00:08:46,550 --> 00:08:47,440
!يا فتاة

141
00:08:47,830 --> 00:08:51,680
لكن يبدو أنّك متردّدة حيال ذلك، صحيح؟

142
00:08:52,630 --> 00:08:53,720
.أظنّ ذلك

143
00:08:53,880 --> 00:08:57,270
،في العادة، عندما تتّخذين قرارك

144
00:08:57,270 --> 00:08:59,630
.لا تحتاجين لنصيحة أيّ أحد للقيام بما قرّرتِه

145
00:08:59,630 --> 00:09:01,520
...نعم... صحيح

146
00:09:01,760 --> 00:09:06,320
أعتقد أنّك لم تعثري على الجواب
.الّذي ترتاحين له بعد

147
00:09:07,520 --> 00:09:08,760
...الجواب

148
00:09:08,760 --> 00:09:11,440
على الأرجح أنّك لا تحتاجين بعد

149
00:09:11,640 --> 00:09:14,570
"لاتّخاذ موقف حاسم مثل "أريد فروًا عاديًّا

150
00:09:14,570 --> 00:09:17,560
."أو"لا أبدو جيّدة بالملابس الظّريفة

151
00:09:18,850 --> 00:09:19,950
...ما أقصده هو

152
00:09:20,310 --> 00:09:24,760
قد لا ترين نمط فورك كعيب
.على الإطلاق في النّهاية

153
00:09:37,260 --> 00:09:39,840
.بالمناسبة، لدينا ذلك بألوان أخرى

154
00:09:39,840 --> 00:09:44,530
،إنّه يتصادم مع نمط فروي
...لذلك أعتقد أنّي اكتفيت

155
00:09:45,740 --> 00:09:49,650
لا بأس بذلك. من الممكن
.تصميم أزياء بأنماط مختلفة

156
00:09:50,730 --> 00:09:52,270
!نمط فوق نمط

157
00:09:52,510 --> 00:09:57,790
سيكون مظهرك أفضل مع حزام يحدّد
.الخصر ولون يتناسق مع فورك

158
00:09:58,200 --> 00:10:00,220
...حسنًا، ربّما

159
00:10:00,800 --> 00:10:02,270
!خذي وقتك

160
00:10:13,950 --> 00:10:16,920
!أيمكنك تصديق هذا يا تونومي-تشان؟

161
00:10:17,540 --> 00:10:18,700
.العناق ممنوع لو سمحت

162
00:10:18,700 --> 00:10:20,920
!ثمّة أيد خفيّة توقفني

163
00:10:20,920 --> 00:10:22,600
ماذا هنالك الآن؟

164
00:10:22,600 --> 00:10:25,770
!عادت زوجتي إلى والديها

165
00:10:26,210 --> 00:10:26,850
هل ذكرت ما السّبب؟

166
00:10:26,850 --> 00:10:30,410
!والدها في المستشفى وعليها العناية به

167
00:10:30,410 --> 00:10:32,490
.فهمت. يا مسكين

168
00:10:32,490 --> 00:10:33,400
...أرجوك

169
00:10:33,590 --> 00:10:36,970
!اسمح لي بالبقاء هنا حتّى تعود لايت رجاءً

170
00:10:36,970 --> 00:10:38,400
!لماذا تريد ذلك؟

171
00:10:38,670 --> 00:10:41,580
أصير في مزاج سيّئ جدًّا عندما
.لا تكون لايت إلى جانبي

172
00:10:41,770 --> 00:10:46,040
فكّرتُ في إلقاء بعض اللّعنات أثناء
...تحقيقاتك كما حدث في السّابق

173
00:10:46,040 --> 00:10:48,000
لكن ماذا عن محلّك؟

174
00:10:48,000 --> 00:10:51,240
.إنّه مغلق حاليًّا

175
00:10:51,240 --> 00:10:54,080
،إن لم أنفّس عن لعناتي
.فستتسرّب وتؤثّر على كلّ شيء

176
00:10:54,080 --> 00:10:55,500
تؤثّر على كلّ شيء؟

177
00:10:55,500 --> 00:10:57,790
!مجرّد سوء حظّ هنا وهناك لا غير

178
00:10:58,510 --> 00:11:03,520
لذلك اسمح لي بالمساعدة حتّى
!عودة لايت! رجاءً يا تونومي-سان

179
00:11:03,800 --> 00:11:07,430
فهمت، لكن كم سيدوم غيابها؟

180
00:11:07,430 --> 00:11:09,400
.قالت لخمسة أشهر تقريبًا

181
00:11:09,400 --> 00:11:11,740
إذًا فهنالك مهلة محدّدة؟

182
00:11:11,950 --> 00:11:13,250
...هذا يعني

183
00:11:13,260 --> 00:11:14,960
...خمسة أشهر

184
00:11:16,510 --> 00:11:19,790
!لن تتسنّى لي رؤيتها طوال خمسة أشهر

185
00:11:19,790 --> 00:11:21,440
!اهدأ رجاءً

186
00:11:21,600 --> 00:11:23,140
خمسة أشهر؟

187
00:11:23,140 --> 00:11:24,830
...لمدّة خمسة أشهر

188
00:11:27,830 --> 00:11:29,740
كيف أبدو يا جاراشي-سان؟

189
00:11:30,000 --> 00:11:32,000
أيبدو هذا جيّدًا؟

190
00:11:32,000 --> 00:11:33,880
.نعم، جيّد تمامًا

191
00:11:34,400 --> 00:11:36,010
!انضمّت لنا يا شيزوكا

192
00:11:36,440 --> 00:11:38,180
!آسفة على التّأخير

193
00:11:38,180 --> 00:11:40,210
!لم نتقابل منذ مدّة يا لايت-سان

194
00:11:40,210 --> 00:11:41,620
!بكلّ تأكيد

195
00:11:41,620 --> 00:11:44,050
!شكرًا على اطمئنانكما عليّ

196
00:11:44,260 --> 00:11:45,790
كيف حالك يا لايت؟

197
00:11:45,790 --> 00:11:47,310
!في أحسن حال

198
00:11:47,310 --> 00:11:51,620
لايت-سان، سمعتُ أنّ والدك
...كان في المستشفى

199
00:11:51,620 --> 00:11:53,010
هل هو بخير؟

200
00:11:53,010 --> 00:11:54,320
...ذلك

201
00:11:54,840 --> 00:11:57,480
.كانت تلك مجرّد كذبة

202
00:11:57,480 --> 00:11:59,290
...أنا

203
00:11:59,290 --> 00:12:02,210
!حبلى في الحقيقة

204
00:12:02,210 --> 00:12:04,100
!أجل! عرفتُ هذا

205
00:12:04,100 --> 00:12:05,120
!أجل

206
00:12:05,120 --> 00:12:06,250
!تهانينا

207
00:12:06,250 --> 00:12:08,120
!تهانينا لك

208
00:12:08,800 --> 00:12:09,960
!شكرًا لكما

209
00:12:09,960 --> 00:12:13,130
لكن لماذا لم تخبري كارما بهذا؟

210
00:12:13,130 --> 00:12:15,220
...ذلك

211
00:12:15,600 --> 00:12:19,640
تعرفان بشأن قوى لعنات الإلف
الدّاكن الخاصّة بكارما، صحيح؟

212
00:12:19,640 --> 00:12:23,520
أنا إلف بيضاء، وهذا يعني
.أنّ لديّ قوى بركات

213
00:12:23,760 --> 00:12:26,370
.وتقوم قوانا بإلغاء بعضها في العادة

214
00:12:27,700 --> 00:12:32,350
،لكنّ معدّل الحمل لدى عرق الإلف منخفض

215
00:12:32,350 --> 00:12:35,030
،لذلك عندما تكون إحدانا حبلى
.يصير للأمر شأن كبير

216
00:12:35,030 --> 00:12:36,100
كيف ذلك؟

217
00:12:36,290 --> 00:12:37,890
،بمجرّد أن نعرف بالحمل

218
00:12:37,890 --> 00:12:42,520
نقضي الوقت في غابة إلف
.مقدّسة في قرية الإلف البيض

219
00:12:42,720 --> 00:12:45,870
نمارس طقوسًا
،ونصلّي من أجل ولادة آمنة

220
00:12:45,870 --> 00:12:51,280
حيث يقوم الجميع بقضاء يومهم
...وهم يغدقونا بالبركات

221
00:12:51,280 --> 00:12:55,040
.ويدعمنا الإلف في القرية بكلّ الطّرق الممكنة

222
00:12:55,040 --> 00:12:57,350
!مثل معاملة أميرة

223
00:12:57,350 --> 00:12:59,090
!ذلك رائع بالفعل

224
00:12:59,440 --> 00:13:02,800
،ولكن لأنّ الحياة الّتي أحملها غالية جدًّا

225
00:13:02,980 --> 00:13:05,760
...وإن حدث أيّ شيء لي

226
00:13:05,890 --> 00:13:07,990
.أعلم أنّه سيلوم نفسه

227
00:13:08,320 --> 00:13:11,260
.سيظنّ أنّ قوى لعناته هي السّبب

228
00:13:13,690 --> 00:13:18,020
،أعلم أنّ ذلك سيجعل حياتنا أصعب
.لذلك أحتفظ بالأمر سرًّا عنه

229
00:13:18,020 --> 00:13:19,360
.يا لصراحتك

230
00:13:20,160 --> 00:13:25,010
لكن ألا تشعرين بالتّوتّر
وهو ليس إلى جانبك؟

231
00:13:25,320 --> 00:13:26,990
...صحيح

232
00:13:26,990 --> 00:13:30,930
لكن أظنّني قلقة أكثر لما
!قد يفعله بدون تواجدي معه

233
00:13:30,930 --> 00:13:34,020
لن أخبرها أنّه أتى باكيًا
.إلى أكيرا-سان في الحال

234
00:13:34,020 --> 00:13:36,680
.لقد اقتحم وكالتنا وهو يبكي

235
00:13:37,730 --> 00:13:39,200
...يا جاراشي-سان

236
00:13:44,240 --> 00:13:46,550
صار اللّيل باردًا مؤخّرًا، صحيح؟

237
00:13:46,550 --> 00:13:48,420
ماذا نأكل اللّيلة؟

238
00:13:48,420 --> 00:13:51,320
!أنا أشتهي شيئًا دافئًا

239
00:13:53,560 --> 00:13:54,730
!قدر ساخن

240
00:13:56,800 --> 00:13:58,060
.اتُّخذ القرار إذًا

241
00:13:58,060 --> 00:13:59,840
أيّ نوع من القدر السّاخن سنأكل؟

242
00:13:59,840 --> 00:14:01,440
ماذا عن قدر الطّماطم السّاخن؟

243
00:14:01,440 --> 00:14:04,300
أحببتُ ذلك! هل نتناوله في منزلي؟

244
00:14:05,640 --> 00:14:08,690
.حسنًا، سأقطّع كلّ الخضروات

245
00:14:08,690 --> 00:14:11,020
.قم بغسلها رجاءً

246
00:14:11,020 --> 00:14:12,320
...حا-حاضر

247
00:14:13,110 --> 00:14:16,400
ألا بأس أن تستعمل شيزوكا-سان السّكّين؟

248
00:14:17,000 --> 00:14:21,580
إنّها تعيش وحدها، لذلك أنا
...واثق أنّها ستكون بخير. ولكن

249
00:14:22,360 --> 00:14:24,040
!هذا مذهل

250
00:14:24,240 --> 00:14:25,320
ماذا تقصد؟

251
00:14:25,320 --> 00:14:26,980
!انتبهي لما تقطّعينه

252
00:14:26,980 --> 00:14:28,800
.هذا ليس شيئًا ينطبق عليك على ما أظنّ

253
00:14:31,230 --> 00:14:32,710
.يُسعدني هذا كثيرًا

254
00:14:32,710 --> 00:14:34,040
ماذا تقصد؟

255
00:14:34,310 --> 00:14:37,490
،صرنا أقرب مذ بدأنا نتواعد

256
00:14:37,490 --> 00:14:39,820
.واستطعتُ تعلّم الكثير من الأشياء عنك

257
00:14:42,300 --> 00:14:46,290
.أدركتُ شيئًا عنك مؤخّرًا أيضًا

258
00:14:47,310 --> 00:14:48,240
ما هو؟

259
00:14:48,430 --> 00:14:52,750
...ثمّة رائحة ظننتُ أنّها لك

260
00:14:52,750 --> 00:14:54,940
.نعم، ذكرتِ ذلك من قبل

261
00:14:55,230 --> 00:14:59,480
.لكن أعتقد أنّها كانت رائحة بذلتك

262
00:14:59,480 --> 00:15:02,710
صحيح، رذاذ البذل المنعش؟

263
00:15:04,220 --> 00:15:08,310
أتودّين التّحقّق من رائحتي ثانية؟

264
00:15:09,210 --> 00:15:11,260
التّحقّق... من رائحتك؟

265
00:15:12,020 --> 00:15:13,690
!نـ-نعم، بكلّ سرور

266
00:15:14,620 --> 00:15:16,680
...حـ-حسنًا إذًا

267
00:15:16,680 --> 00:15:20,440
لكن هل عليّ خلع ملابسي حتّى
لا تخلطي بين رائحتها ورائحتي أنا؟

268
00:15:21,530 --> 00:15:22,640
ما رأيك؟

269
00:15:24,010 --> 00:15:25,750
.مـ-من الأفضل ألاّ تفعل

270
00:15:33,560 --> 00:15:35,840
شيزوكا-سان، هل أضيف الباستا؟

271
00:15:36,320 --> 00:15:38,520
!من الأفضل ألاّ أشرب الكثير من الحساء إذًا

272
00:15:42,420 --> 00:15:44,410
!لقد دفّأني ذلك بالفعل

273
00:15:44,410 --> 00:15:46,440
.لدينا تحلية أيضًا اليوم

274
00:15:47,460 --> 00:15:47,960
.تفضّلي

275
00:15:48,240 --> 00:15:49,550
ما هذه؟

276
00:15:49,920 --> 00:15:51,170
!أ-أهذه...؟

277
00:15:52,350 --> 00:15:54,690
.اشتريتها عندما كنتُ في محلّ البقالة

278
00:15:55,190 --> 00:15:56,480
.أنا آسفة

279
00:15:57,190 --> 00:15:59,360
.أواجه مشاكل مع فطائر القشدة

280
00:16:00,080 --> 00:16:01,840
!أنا جدّ آسف

281
00:16:01,840 --> 00:16:03,330
...فعندما أحاول أكلها كما ترى

282
00:16:05,080 --> 00:16:09,040
.تحاصرني القشدّة من كلّ جانب

283
00:16:09,050 --> 00:16:10,740
.نعم، يمكنني رؤية ذلك

284
00:16:31,910 --> 00:16:34,040
مرحبًا! أهذه أنت يا لايت؟

285
00:16:34,230 --> 00:16:35,440
كيف حالك؟

286
00:16:36,060 --> 00:16:39,880
صار الجوّ باردًا، صحيح؟ أتحافظين على دفئك؟

287
00:16:41,890 --> 00:16:44,500
خمسة أشهر مدّة طويلة، صحيح؟

288
00:16:45,830 --> 00:16:47,090
!لا أطيق الانتظار حتّى أراك

289
00:16:48,940 --> 00:16:50,060
فعلاً؟

290
00:16:53,770 --> 00:16:56,460
أنت لست غاضبًا؟

291
00:16:57,120 --> 00:16:58,030
لايت؟

292
00:16:58,200 --> 00:17:00,920
.أنا حبلى

293
00:17:01,890 --> 00:17:03,540
.لهذا السّبب أتيت إلى هنا

294
00:17:03,840 --> 00:17:06,190
.لديّ موارد أكثر هنا

295
00:17:06,190 --> 00:17:08,140
.وأنا أحتفظ بأشياء أخرى سرًّا عنك

296
00:17:08,140 --> 00:17:10,910
لـ-لكن لماذا لم تخبريني؟

297
00:17:12,150 --> 00:17:13,200
أتتذكّر؟

298
00:17:13,680 --> 00:17:17,160
...عندما تزوّجنا

299
00:17:17,600 --> 00:17:19,220
.ربّما ليس علينا هذا

300
00:17:20,120 --> 00:17:21,760
!هل ستتراجع الآن؟

301
00:17:21,760 --> 00:17:25,220
.لا مكان لإلف داكن مثلي مع إلف بيضاء مثلك

302
00:17:25,220 --> 00:17:28,480
.ليس ثانية، سبق وناقشنا هذا

303
00:17:28,480 --> 00:17:31,010
،ربّما كانت هنالك صراعات بين جيل آبائنا

304
00:17:31,010 --> 00:17:33,190
!لكن لا علاقة لذلك بنا نحن

305
00:17:33,190 --> 00:17:35,220
.ذ-ذلك ليس ما قصدت

306
00:17:35,220 --> 00:17:37,880
أنا فقط لستُ واثقًا كيف
...ستؤثّر عليك قوى لعناتي

307
00:17:37,880 --> 00:17:38,690
.اسمع

308
00:17:38,690 --> 00:17:41,090
هل تعتقد أنّ قوى البركات
خاصّتي بلا قيمة؟

309
00:17:41,090 --> 00:17:42,920
!إنّها تُلغي لعناتك

310
00:17:42,920 --> 00:17:45,290
!اسمع، أريد أن أكون معك

311
00:17:45,450 --> 00:17:49,200
...لكنّ قوى لعناتي هي عكس بركاتك

312
00:17:49,460 --> 00:17:51,670
.لذلك لستُ واثقًا أنّه بإمكاني إسعادك

313
00:17:51,670 --> 00:17:55,200
!إسعادي ليس واجبك

314
00:17:55,200 --> 00:17:57,880
...لكن إن حدث أيّ شيء لك

315
00:17:58,030 --> 00:17:58,700
...أنا

316
00:18:02,360 --> 00:18:07,920
حاولتَ الهرب لأنّك كنت خائفًا
من تأثير قوى لعناتك، صحيح؟

317
00:18:08,800 --> 00:18:11,440
.ظننتُ أنّ هذه قد تكون النّهاية هذه المرّة

318
00:18:13,010 --> 00:18:16,840
.لهذا السّبب لم أخبرك بشأن حملي

319
00:18:18,370 --> 00:18:20,080
!كنت ستهرب فحسب، صحيح؟

320
00:18:23,170 --> 00:18:24,350
.كم أنا فظيعة

321
00:18:24,350 --> 00:18:26,400
...لم أقصد أن أقولها بتلك الطّريقة

322
00:18:28,360 --> 00:18:30,600
.كنتُ أعرف أنّك حبلى

323
00:18:32,120 --> 00:18:34,880
.وصحيح... أنّي حاولتُ الهرب

324
00:18:35,550 --> 00:18:40,290
لن أهرب ثانية. أقسمت ألاّ أفعل
.ذلك عندما تزوّجنا

325
00:18:40,900 --> 00:18:43,500
.آسف لأنّي جعلتُك تحتفظين بهذا لنفسك

326
00:18:45,400 --> 00:18:48,220
!كيف عرفت؟

327
00:18:48,220 --> 00:18:50,460
،قلتِ أنّ والدك في المستشفى

328
00:18:50,810 --> 00:18:53,780
...لذلك قلقت واتّصلتُ به

329
00:18:54,490 --> 00:18:57,150
!مرحبًا! هل أنت بخير؟

330
00:18:57,150 --> 00:18:59,130
!اخرس! ابتعد عن حفيدي

331
00:19:01,180 --> 00:19:02,010
حفيد؟

332
00:19:02,990 --> 00:19:05,490
!كلاّ يا أبي

333
00:19:05,490 --> 00:19:06,160
!وإن كنت تعرف، لماذا لم تقل شيئًا؟

334
00:19:06,160 --> 00:19:10,010
!وإن كنت تعرف، لماذا لن تقل شيئًا؟

335
00:19:10,010 --> 00:19:12,800
...كنتُ أظنّ أنّك تريدين مفاجأتي بذلك

336
00:19:12,800 --> 00:19:15,250
!كلاّ أيّها الغبيّ

337
00:19:15,520 --> 00:19:19,600
حسنًا، ارتحتُ بعد سماع
.أنّ والدك بخير على الأقلّ

338
00:19:21,870 --> 00:19:24,480
.آسفة لأنّي كذبتُ عليه

339
00:19:25,000 --> 00:19:25,800
.لا بأس

340
00:19:27,080 --> 00:19:30,440
بالمناسبة، ما الأشياء الأخرى
الّتي تبقينها سرًّا عنّي؟

341
00:19:34,260 --> 00:19:35,890
.انتظر وسترى

342
00:19:36,980 --> 00:19:38,720
!أكيد، سأنتظر

343
00:19:47,110 --> 00:19:49,230
هل تبحثين عن شيء ما يا سيّدتي؟

344
00:19:49,230 --> 00:19:51,520
...لـ-ليس تمامًا

345
00:19:52,210 --> 00:19:54,440
...أعتقد أنّ ذلك الشّخص ليس هنا

346
00:19:55,200 --> 00:19:58,720
.أنا أبحث عن ملابس تتناسق مع نمط فروي

347
00:19:58,720 --> 00:20:02,750
حسنًا، ما رأيك بهذه؟

348
00:20:04,020 --> 00:20:06,140
هل أعجبتك يا سيّدتي؟

349
00:20:06,900 --> 00:20:08,720
!تبدين رائعة

350
00:20:09,080 --> 00:20:11,400
...إنّها علامة أجنبيّة، لذلك

351
00:20:11,400 --> 00:20:12,870
...نـ-نعم

352
00:20:13,320 --> 00:20:14,480
.لا فائدة

353
00:20:14,840 --> 00:20:19,980
لا يمكنني أن أثق بخيارات
.العاملين ذوي الفرو العاديّ

354
00:20:20,400 --> 00:20:23,240
...لكنّ الملابس الّتي اشتريتها ذلك اليوم

355
00:20:23,610 --> 00:20:26,770
عندما يقدّم لي شخص له نمط أيضًا
.نصيحة، أستطيع التّخفيف من حذري

356
00:20:27,030 --> 00:20:30,290
.أتمنّى لو أستطيع الحديث معه ثانية

357
00:20:30,740 --> 00:20:32,000
...المعذرة

358
00:20:32,000 --> 00:20:32,670
نعم؟

359
00:20:32,670 --> 00:20:36,880
أعتقد أنّ لديكم رجلاً سحليّة
...كعامل هنا

360
00:20:39,420 --> 00:20:40,400
!مرحبًا

361
00:20:41,170 --> 00:20:42,920
.أنت هنا إذًا

362
00:20:42,920 --> 00:20:44,960
.كنتُ أتولّى المخزن في الخلف

363
00:20:45,200 --> 00:20:48,240
هل أنت من تبحثين عنّي؟

364
00:20:48,240 --> 00:20:51,120
...نـ-نعم

365
00:20:51,120 --> 00:20:52,800
فعلاً؟ ماذا تريدين؟

366
00:20:57,770 --> 00:21:00,360
هل أغضبتك أو ما شابه؟

367
00:21:01,670 --> 00:21:05,150
!أحتاج لنصائح حول ملابسي

368
00:21:06,040 --> 00:21:08,020
.ماذا؟ بكلّ سرور

369
00:21:08,020 --> 00:21:10,000
.لنُلق نظرة

370
00:21:15,540 --> 00:21:16,500
كيف تبدو؟

371
00:21:19,190 --> 00:21:20,990
...إنّها تُظهر ساقاي

372
00:21:21,460 --> 00:21:22,940
ألا تتعارض مع نمط فروي؟

373
00:21:23,360 --> 00:21:26,650
.اختيار حجم النّمط المناسب يوازن الأمور

374
00:21:26,960 --> 00:21:29,600
،لكن لديك قوام ممتاز

375
00:21:29,600 --> 00:21:31,880
.ستبدين أنيقة في أيّ شيء تلبسينه

376
00:21:32,690 --> 00:21:34,170
.ذلك ليس صحيحًا

377
00:21:35,160 --> 00:21:39,480
،إن كنتُ سأبدو أنيقة في أيّ شيء
.ما كنتُ لأحتاج لمساعدتك

378
00:21:42,890 --> 00:21:44,860
.أنا ميزونامي أكو

379
00:21:45,720 --> 00:21:48,450
.هذه بطاقة عملي المطبوعة حديثًا

380
00:21:48,450 --> 00:21:51,040
،كان حلمي أن أفتح محلّي الخاصّ

381
00:21:51,240 --> 00:21:52,760
.المخصّص لأصحاب الأنماط

382
00:21:54,050 --> 00:21:56,820
.لذلك أتمنّى الاعتماد على دعمك

383
00:21:57,740 --> 00:21:58,800
فعلاً؟

384
00:21:59,360 --> 00:22:01,470
.سأدعمك بكلّ تأكيد

385
00:22:01,870 --> 00:22:03,520
.أنا جاراشي لونا

386
00:22:04,000 --> 00:22:05,370
!زبونة دائمًا محتملة

387
00:22:07,300 --> 00:22:08,280
.سررت بالتّعرّف عليك