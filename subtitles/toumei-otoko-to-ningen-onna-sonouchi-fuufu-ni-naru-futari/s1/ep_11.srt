1
00:00:01,120 --> 00:00:04,640
قالا أنّهما يشعران براحة أكبر
.وهما خفيّين بالكامل

2
00:00:05,800 --> 00:00:11,490
مع أنّي... ما كنتُ لأقول
.أنّي أفضّل كوني خفيًّا بالكامل

3
00:00:24,880 --> 00:00:28,450
.المحطّة التّالية هي شارع حيّ التّسوّق الثّالث

4
00:00:28,450 --> 00:00:30,280
.شارع حيّ التّسوّق الثّالث

5
00:00:34,530 --> 00:00:35,740
أكيرا-سان؟

6
00:00:37,330 --> 00:00:38,830
هل أنت بخير؟

7
00:00:39,040 --> 00:00:40,640
.أنا بخير

8
00:00:41,100 --> 00:00:43,810
.آسف لأنّه كان علينا أخذ عدّة وسائل نقل

9
00:00:44,010 --> 00:00:46,010
.إنّ بلدتي بعيدة جدًّا

10
00:00:46,010 --> 00:00:47,190
!لا مشكلة

11
00:00:47,190 --> 00:00:50,320
!أنا متشوّقة لزيارة قرية الأشخاص الخفيّين

12
00:00:50,320 --> 00:00:51,900
.إنّها في مكان بعيد منعزل

13
00:00:51,900 --> 00:00:54,080
.لا شيء حولها إلاّ السّهول

14
00:00:54,080 --> 00:00:55,480
.كما أنّها منغلقة جدًّا

15
00:00:55,480 --> 00:00:57,660
فعلاً؟

16
00:00:58,180 --> 00:01:00,540
.نعم، إنّها قرية غريبة

17
00:01:00,800 --> 00:01:02,610
قرية غريبة؟

18
00:02:39,300 --> 00:02:41,640
!الهواء منعش جدًّا

19
00:02:41,640 --> 00:02:44,260
.نعم، إنّه مكان هادئ وجميل

20
00:02:52,400 --> 00:02:54,440
.هذا هو شارع التّسوّق

21
00:02:57,290 --> 00:02:59,600
!مفهوم. إنّه حافل جدًّا

22
00:02:59,600 --> 00:03:01,440
أكلّ هؤلاء سكّان محلّيّون؟

23
00:03:04,520 --> 00:03:06,270
!أشعر بالكثير من الأشخاص

24
00:03:06,270 --> 00:03:08,400
.توقّعتُ هذا منك

25
00:03:09,240 --> 00:03:11,340
،إنّ القرية معفيّة من بعض القوانين

26
00:03:11,340 --> 00:03:14,560
لذلك مسموح لنا بالسّير في الأرجاء
.ونحن خفيّون بالكامل

27
00:03:14,880 --> 00:03:20,230
إنّ العديد من الأشخاص الخفيّين الّذين
.يعيشون هنا يقومون بذلك طوال الوقت

28
00:03:20,230 --> 00:03:21,410
!فهمت

29
00:03:22,860 --> 00:03:27,280
هل كونهم خفيّين بالكامل
هو ما يجعل البلدة غريبة؟

30
00:03:27,280 --> 00:03:29,670
،حسنًا، إنّ ذلك يُربك الكثير من النّاس

31
00:03:29,670 --> 00:03:32,180
.لكنّني أفترض أنّه أمر يوميّ بالنّسبة لك

32
00:03:34,300 --> 00:03:36,320
.حسنًا، منزل عائلتي إلى الأمام قليلاً

33
00:03:38,480 --> 00:03:40,250
هل أنت بخير يا شيزوكا-سان؟

34
00:03:40,250 --> 00:03:42,490
!صـ-صرتُ متوتّرة فجأة

35
00:03:42,800 --> 00:03:44,430
،أعرف كيف تشعرين

36
00:03:44,430 --> 00:03:46,560
.لكنّي أعلم أنّ بإمكانك تولّي ذلك

37
00:03:46,560 --> 00:03:48,630
!نـ-نعم! سأبذل جهدي

38
00:03:52,050 --> 00:03:54,350
أهذا... أكي؟

39
00:03:57,710 --> 00:03:58,640
!لقد وصلت

40
00:04:18,070 --> 00:04:19,120
.شيزوكا-سان

41
00:04:19,120 --> 00:04:21,360
.يجلس أبي إلى يسارك

42
00:04:21,360 --> 00:04:22,730
.بينما تجلس أمّي إلى يمينك

43
00:04:23,040 --> 00:04:25,730
.يـ-يخيّم الصّمت على الأجواء

44
00:04:26,340 --> 00:04:30,640
،صحيح أنّ أكيرا-سان صامت كثيرًا
.لكنّهما أكثر صمتًا منه بكثير

45
00:04:30,910 --> 00:04:34,370
...هذا أشبه... بضغط صامت

46
00:04:35,040 --> 00:04:35,740
ما الخطب؟

47
00:04:35,740 --> 00:04:39,660
!عفوًا... اسمي ياكو شيزوكا

48
00:04:39,660 --> 00:04:43,680
...إنّ أكيرا-سان يساعدني دائمًا... على

49
00:04:43,680 --> 00:04:46,420
!سـ-سررت بلقائكما

50
00:04:47,730 --> 00:04:48,650
.نعم

51
00:04:49,040 --> 00:04:51,660
.شكرًا لمساعدتك لابننا أكيرا

52
00:04:51,660 --> 00:04:54,320
.صوتها رتيب وموضوعيّ للغاية

53
00:04:54,320 --> 00:04:57,850
أيُعقل أنّها لم تحبّني؟

54
00:04:57,850 --> 00:05:00,120
ما-ما العمل يا أكيرا-سان؟

55
00:05:00,320 --> 00:05:04,110
.إنّنا نتواعد حاليًّا ونفكّر في العيش معًا

56
00:05:04,110 --> 00:05:05,480
!في صلب الموضوع مباشرة؟

57
00:05:06,600 --> 00:05:07,950
.لا أمانع ذلك

58
00:05:09,090 --> 00:05:10,960
.نعم، ولا أنا

59
00:05:11,160 --> 00:05:14,880
...لكنّي كنتُ أتساءل

60
00:05:15,700 --> 00:05:18,540
لماذا ترتديان هاذين القناعين الغريبين؟

61
00:05:18,770 --> 00:05:20,540
ماذا؟ قناعين؟

62
00:05:22,770 --> 00:05:25,800
.قلتَ أنّك ستحضر معك شخصًا من جنس آخر

63
00:05:25,800 --> 00:05:28,720
ظننّا أنّه سيكون من المريح أكثر
.إن كان لدينا وجوه

64
00:05:28,720 --> 00:05:31,680
.شيزوكا-سان عمياء
.لذلك لن يفيداكما كثيرًا

65
00:05:31,680 --> 00:05:33,880
.صحيح، معك حقّ

66
00:05:33,880 --> 00:05:35,200
.معك حقّ بالفعل

67
00:05:35,200 --> 00:05:37,320
.أعتقد أنّني أخبرتكم بذلك

68
00:05:37,630 --> 00:05:39,260
.أعتقد أنّها لا تستطيع ملاحظة الأمر

69
00:05:39,260 --> 00:05:41,000
.نعم، لا تستطيع بالفعل

70
00:05:41,400 --> 00:05:44,270
!حسنًا، قد يكون لا بأس بهذا

71
00:05:44,780 --> 00:05:47,760
ألا بأس إن اختفينا بالكامل إذًا؟

72
00:05:47,760 --> 00:05:49,000
.لا بأس بذلك

73
00:05:50,470 --> 00:05:53,670
إنّهما يشعران براحة أكثر
.إن كانا خفيّين بالكامل

74
00:05:53,670 --> 00:05:56,920
نعم. هكذا هو الوضع بالنّسبة
.لكلّ الأشخاص الخفيّين

75
00:05:57,960 --> 00:05:59,740
فعلاً؟

76
00:05:59,740 --> 00:06:04,640
،ينبغي لنا، في نهاية المطاف
.أن نكون خفيّين بالكامل

77
00:06:10,540 --> 00:06:13,470
.أعتقد أنّي سآخذها للقاء جدّتي الآن

78
00:06:13,470 --> 00:06:16,710
.إنّها تلازم غرفتها بسبب قدمها المريضة

79
00:06:22,380 --> 00:06:28,050
لكن لا أستطيع القول أنّني
.أفضّل أن أكون خفيًّا بالكامل

80
00:06:30,650 --> 00:06:35,630
هذا لأنّك تحبّ أن يرى النّاس
ملابسك المفضّلة، صحيح؟

81
00:06:36,920 --> 00:06:40,120
هل يمكنني إخبارك لاحقًا بكلّ
تفاصيل البذلة الّتي أرتديها الآن؟

82
00:06:41,760 --> 00:06:43,120
!كم أودّ سماعها

83
00:06:45,800 --> 00:06:47,960
.جدّتي، نستأذن بالدّخول

84
00:06:48,360 --> 00:06:49,630
!مرحبًا

85
00:06:50,670 --> 00:06:52,590
...جدّتي، إنّ شيزوكا-سان

86
00:06:52,590 --> 00:06:55,800
!لقد قلتُ لهما أن يخبراك أيضًا

87
00:06:55,800 --> 00:06:56,640
!عجبًا

88
00:06:59,510 --> 00:07:01,070
،في حقبة الممالك المتحاربة

89
00:07:01,070 --> 00:07:04,720
!كنّا عائلة نينجا خدمت سيّدها بإخلاص

90
00:07:09,070 --> 00:07:10,440
!نينجا

91
00:07:10,440 --> 00:07:13,080
!ماذا؟ كنتم نينجا؟! كم هذا رائع

92
00:07:14,180 --> 00:07:16,740
!لدينا شوريكن وما إلى ذلك في المخزن

93
00:07:17,160 --> 00:07:20,080
!أ-أيمكنك استعمال النّينجتسو؟

94
00:07:20,080 --> 00:07:26,560
إنّ أشكالنا الخفيّة بالكامل تبدو
!وبكلّ تأكيد مثل نينجتسو للغرباء

95
00:07:27,130 --> 00:07:30,520
لكنّنا لم نستطع جعل الشّوريكن
،وبقيّة أدواتنا خفيّة

96
00:07:30,520 --> 00:07:33,220
!لذلك كان علينا استعمال عدّة خدع أخرى

97
00:07:33,220 --> 00:07:35,360
!فـ-فهمت

98
00:07:35,360 --> 00:07:36,960
.إنّها متحمّسة جدًّا

99
00:07:35,860 --> 00:07:38,520
!هذا رائع! رائع جدًّا

100
00:07:36,960 --> 00:07:38,240
.أكيرا

101
00:07:45,240 --> 00:07:47,360
.مرحبًا. لم أرك منذ مدّة يا أكي

102
00:07:47,960 --> 00:07:50,780
!كيريغورو-سان! أعدت إلى هنا؟

103
00:07:50,780 --> 00:07:52,620
.أنا من عليه قول ذلك

104
00:07:52,620 --> 00:07:55,760
.عجبًا، أرى أنّك تغيّرت كثيرًا

105
00:07:57,220 --> 00:07:59,690
...لم نتحدّث معًا مذ كنّا في المدرسة

106
00:08:00,480 --> 00:08:02,360
.كنتَ طفلاً صغيرًا

107
00:08:02,360 --> 00:08:04,280
.لقد فاجأتني برؤيتك ترتدي هذه البذلة

108
00:08:05,330 --> 00:08:08,250
.اندهشتُ من أنّك عرفت من أكون

109
00:08:10,730 --> 00:08:11,970
من هذا؟

110
00:08:15,050 --> 00:08:17,090
.هذا كيريغورو ماساشي-سان

111
00:08:17,310 --> 00:08:19,470
هل تذكرين القصّة الّتي أخبرتكِ بها؟

112
00:08:20,440 --> 00:08:22,980
...عارض الأزياء الخفيّ الأوّل

113
00:08:22,980 --> 00:08:24,600
!نعم، تلك القصّة

114
00:08:24,600 --> 00:08:27,300
ما طريقة التّقديم هذه؟

115
00:08:28,110 --> 00:08:29,780
.كنّا نتحدّث عن الماضي فحسب

116
00:08:29,780 --> 00:08:33,040
.تقاعدتُ من عرض الأزياء
.أنا أدير هذه الحانة الإيطاليّة الآن

117
00:08:33,410 --> 00:08:35,040
.لكنّك فاجأتني بالفعل

118
00:08:35,040 --> 00:08:39,030
كنتُ أفتح المكان هذا الصّباح
"وقلتُ في نفسي "هل هذا هو أكي؟

119
00:08:39,030 --> 00:08:42,740
.أنا مندهش لأنّك تعرّفت عليّ
.مرّت أكثر من عشر سنوات الآن

120
00:08:42,740 --> 00:08:46,240
لا يوجد الكثير من الأشخاص هنا الّذي
.لا يحبّون أن يكونوا خفيّين بالكامل

121
00:08:46,240 --> 00:08:48,470
.توقّعتُ ذلك فحسب

122
00:08:49,920 --> 00:08:51,450
.حسنًا، تفضّلا بالأكل

123
00:08:53,510 --> 00:08:54,800
!يا لها من رائحة شهيّة

124
00:08:54,800 --> 00:08:55,960
.شكرًا على الطّعام

125
00:08:56,360 --> 00:08:58,400
هل تعرّفت عليّ يا أكي؟

126
00:08:58,400 --> 00:09:01,300
لم تكن لديّ كلّ هذه الوشوم
.في آخر لقاء لنا

127
00:09:01,300 --> 00:09:03,230
.عرفتُك بمجرّد أن رأيتك

128
00:09:03,230 --> 00:09:06,600
رسمتَ أنماطًا مشابهة عليك
بقلم عندما كنتَ طفلاً، صحيح؟

129
00:09:08,360 --> 00:09:10,850
.نعم، ذلك صحيح

130
00:09:10,850 --> 00:09:12,780
.أعتقد أنّي لم أتغيّر كثيرًا أيضًا

131
00:09:13,870 --> 00:09:17,430
.لكنّك ساعدتني كثيرًا وقتها

132
00:09:18,360 --> 00:09:19,980
!نعم، أنا أتذكّر

133
00:09:19,980 --> 00:09:23,740
كنتَ تبكي بحرقة وقلت
!أنّك لا تميّز بين الجميع

134
00:09:23,740 --> 00:09:26,640
!مهلاً، ليس عليك ذكر ذلك الآن

135
00:09:29,250 --> 00:09:30,990
كنتَ تبكي؟

136
00:09:31,310 --> 00:09:34,710
.كبرت وأنا محاط بأجناس أخرى

137
00:09:36,590 --> 00:09:39,840
عندما أتيتُ إلى القرية لأوّل
...مرّة وأنا طفل

138
00:09:39,840 --> 00:09:42,330
مهلاً، هل أنت وحدك؟

139
00:09:41,040 --> 00:09:43,890
!تعال إلى هنا! لديّ حلوى

140
00:09:43,150 --> 00:09:46,890
خفت كثيرًا بوجود كلّ ذلك القدر
...من الأشخاص الخفيّين حولي

141
00:09:43,900 --> 00:09:45,700
!يا لك من ظريف

142
00:09:45,700 --> 00:09:46,890
!اهدأ

143
00:09:51,830 --> 00:09:55,440
،ثمّ التقيتُ كيريغورو-سان
.الّذي رسم أنماطًا على وجهه

144
00:09:56,040 --> 00:09:58,520
أتيت من المدينة الكبيرة، صحيح؟

145
00:10:07,720 --> 00:10:11,440
قلتُ لنفسي حينها، "هل يُقيم
"هذا الفتى هالوين لشخص واحد؟

146
00:10:11,440 --> 00:10:12,780
.مهلاً. كفّ عن ذلك

147
00:10:13,960 --> 00:10:15,920
.ظننتُك حينها طفلاً غريبًا حقًّا

148
00:10:16,480 --> 00:10:20,140
.لكنّك جعلتني أشهر بالطّمأنينة

149
00:10:20,470 --> 00:10:22,100
،عندما أفكّر في ذلك الآن

150
00:10:22,100 --> 00:10:25,310
.أذكر أنّي رسمتُ أشياء مختلفة على وجهي

151
00:10:25,310 --> 00:10:28,340
لستُ واثقًا كيف نجحت
.في أن أصير عارض أزياء

152
00:10:28,520 --> 00:10:33,280
.وقتها، كان يعرض أزياء كأوّل عارض خفيّ

153
00:10:33,280 --> 00:10:36,210
!فهمت! هكذا إذًا

154
00:10:36,210 --> 00:10:40,750
وفي ذلك الوقت، كانت
الأعمال الوحيدة للخفيّين

155
00:10:40,750 --> 00:10:44,090
.هي عملاء سرّيّين أو أعمالاً من المنزل

156
00:10:44,090 --> 00:10:50,760
،راودني الفضول حيال المدينة الكبيرة
.لذلك حزمت حقيبتي وذهبت إليها

157
00:11:34,500 --> 00:11:37,010
.سُحقًا. ذهبت تجربة أداء أخرى سدى

158
00:11:39,250 --> 00:11:41,640
...لماذا أنا

159
00:11:43,530 --> 00:11:45,350
!مهلاً، هل أصبتك؟

160
00:11:45,350 --> 00:11:46,400
...هذا مؤلم

161
00:11:46,400 --> 00:11:49,400
!أخفض كمّيك! هذا ليس آمنًا

162
00:11:54,430 --> 00:11:56,000
.معك حقّ

163
00:11:56,940 --> 00:11:58,360
!مع السّلامة

164
00:11:58,360 --> 00:11:59,270
!إلى اللّقاء

165
00:12:04,720 --> 00:12:07,350
!أخفض كمّيك! هذا ليس آمنًا

166
00:12:07,730 --> 00:12:11,300
لا عجب أنّ سكّان القرية
.لم يرغبوا في أن أذهب إلى المدينة

167
00:12:11,850 --> 00:12:16,420
.الحياة هنا صعبة جدًّا على الخفيّين

168
00:12:33,660 --> 00:12:36,700
،إن كان كونك خفيًّا هو كلّ ما تقدّمه
.بإمكاني تعيين أيّ شخص خفيّ

169
00:12:37,430 --> 00:12:40,550
!لا يمكنني معرفة أيّ شيء إن لم أستطع رؤيتك

170
00:12:40,550 --> 00:12:42,340
ما الّذي تفكّر فيه من الأساس؟

171
00:12:43,480 --> 00:12:45,070
!إيّاك أن تهرب

172
00:12:46,160 --> 00:12:48,800
!أتيت إلى هناك لأنّك رغبت في ذلك

173
00:12:49,520 --> 00:12:52,710
كان عليك أن تظلّ في قريتك
!وتعيش حياة عاديّة

174
00:12:53,190 --> 00:12:55,630
!مغادرتك هي غلطتك أنت

175
00:13:39,960 --> 00:13:41,440
.أشعر بالاشمئزاز

176
00:13:41,440 --> 00:13:44,840
...كلاّ. لديّ تجربة أداء كبيرة اليوم

177
00:13:44,840 --> 00:13:46,030
...عليّ أن أسرع

178
00:13:49,230 --> 00:13:51,050
!ما الّذي فعلته؟

179
00:13:52,560 --> 00:13:54,170
!كلاّ، كلاّ، كلاّ

180
00:13:54,170 --> 00:13:56,000
!لديّ تجربة أداء

181
00:14:01,070 --> 00:14:02,240
!مستحيل

182
00:14:03,700 --> 00:14:05,070
...إذًا

183
00:14:05,520 --> 00:14:09,070
آسف لأنّي أتيتُ لتجربة الأداء
.بهذا المظهر السّخيف

184
00:14:09,680 --> 00:14:10,950
.سُحقًا

185
00:14:11,120 --> 00:14:13,220
.ارفضوني بسرعة فحسب

186
00:14:17,220 --> 00:14:18,100
...نعم

187
00:14:18,100 --> 00:14:20,580
إنّها مسألة "لحظة الفضول" تلك، صحيح؟

188
00:14:32,020 --> 00:14:34,320
وشمتَ هيكلاً عظميًّا على نفسك

189
00:14:34,320 --> 00:14:38,310
وأضفت طلاء الجسم ليتماشى
.مع أيّ تصاميم ترتديها

190
00:14:38,310 --> 00:14:41,720
أحبّ النّاسُ كم جعل ذلك
.الملابسَ تبرز أكثر

191
00:14:44,870 --> 00:14:46,860
!لا يمكنني تخيّل ذلك أبدًا

192
00:14:46,860 --> 00:14:50,870
جعل ذلك الملابس مميزة، لذلك تلقّيت
.اتّصالات لعرض مختلف أنواع المجموعات

193
00:14:50,870 --> 00:14:54,510
غالبًا ما يتمّ تصنيف الأشخاص الخفيّين
،في فئة واحدة لأنّنا لا نراهم

194
00:14:54,510 --> 00:14:56,000
،ولكن بالنّظر إلى الماضي الآن

195
00:14:56,000 --> 00:15:00,190
كان طلاء الجسم والوشوم
.طريقتي الخاصّة للتّعبير عن نفسي

196
00:15:04,900 --> 00:15:08,710
إنّها الطّريقة الوحيدة الّتي أعبّر
.بها عن نفسي في النّهاية

197
00:15:10,200 --> 00:15:11,340
...التّعبير عن نفسي

198
00:15:18,340 --> 00:15:20,060
.إنّهما متشابهان

199
00:15:22,920 --> 00:15:24,140
،عفوًا

200
00:15:24,140 --> 00:15:28,640
ألا يعاني سكّان القرية
لأنّ الجميع خفيّ طوال الوقت؟

201
00:15:28,640 --> 00:15:33,030
يملك الأشخاص الخفيّون أعضاءً تسمح
.لهم بالشّعور بالأشخاص الخفيّين الآخرين

202
00:15:33,030 --> 00:15:38,290
،بإمكاننا أن نشعر أين هم
.أو حتّى من يكونون

203
00:15:38,290 --> 00:15:41,880
لكنّ هذه الأعضاء المسؤولة
عن جعل ذلك ممكنًا

204
00:15:41,880 --> 00:15:44,570
لا تتطوّر بما يكفي عند من تربّوا
.في المدن الكبيرة مثلي

205
00:15:46,050 --> 00:15:49,400
كنتُ في المدرسة الابتدائيّة عندما عرفت

206
00:15:49,400 --> 00:15:53,180
كيف أتعرّف على الآخرين
.بأصواتهم وروائحهم الفريدة

207
00:15:53,180 --> 00:15:55,380
أهذه أنت يا إيما-تشان؟

208
00:15:55,380 --> 00:15:57,440
!ماذا؟ كيف عرفت؟

209
00:15:57,440 --> 00:16:01,910
،يبدو أنّ الآخرين كانوا يعجزون عن ذلك
.لذلك كان الأمر يثير دهشتهم دائمًا

210
00:16:01,910 --> 00:16:03,130
.فهمت

211
00:16:03,130 --> 00:16:05,770
.أفترض أنّنا جميعًا نتأقلم مع محيطنا

212
00:16:05,770 --> 00:16:08,840
وبما أنّي كبرت بين أشخاص
...ليسوا خفيّين

213
00:16:08,840 --> 00:16:09,760
،نعم

214
00:16:09,760 --> 00:16:14,400
إنّ السّبب الّذي جعلني أتعلّم كيفية القيام
،بذلك ليس لأنّني عملت بجدّ عليه

215
00:16:14,400 --> 00:16:17,300
...أو لأنّ الآخرين لا يعملون بجدّ عليه

216
00:16:17,300 --> 00:16:21,520
،كنتُ أعيش حياتي كوني عمياء ببساطة

217
00:16:21,520 --> 00:16:24,450
.وأعتقد أنّني تأقلمت مع تلك الحاجة

218
00:16:24,450 --> 00:16:26,230
.أعرف تمامًا ما تقصدينه

219
00:16:26,560 --> 00:16:28,250
...ولكنّي

220
00:16:28,510 --> 00:16:32,180
.استطعتُ إيجادك بسبب ذلك

221
00:16:32,180 --> 00:16:33,510
!وهذا يسرّني

222
00:16:35,840 --> 00:16:38,600
هلاّ قمتما بهذا في مكان آخر؟

223
00:16:39,220 --> 00:16:40,100
.مع السّلامة

224
00:16:40,100 --> 00:16:41,640
!شكرًا على الطّعام

225
00:16:41,640 --> 00:16:43,880
.أكي، احرص على زيارتي ثانية

226
00:16:43,880 --> 00:16:45,140
.سأزورك بالتّأكيد

227
00:16:52,880 --> 00:16:56,950
.يتمّ الحُكم على الخفيّين بسبب كونهم خفيّين

228
00:16:57,270 --> 00:16:59,100
.إنّهم يقدّروننا لأنّهم لا يستطيعون رؤيتنا

229
00:16:59,330 --> 00:17:00,990
.ويشكّون بنا لأنّه لا يمكنهم رؤيتنا

230
00:17:01,290 --> 00:17:02,360
.والبعض يخافنا

231
00:17:02,840 --> 00:17:04,300
.وآخرون يتجاهلوننا

232
00:17:05,320 --> 00:17:09,590
.لكنّ ذلك لم يكن مهمًّا بالنّسبة لشيزوكا-سان

233
00:17:17,280 --> 00:17:18,320
.شيزوكا-سان

234
00:17:18,320 --> 00:17:19,000
ماذا؟

235
00:17:21,790 --> 00:17:23,520
.أنا مسرور لأنّي قابلتك

236
00:17:24,640 --> 00:17:26,760
...ا-الأمر ليس بتلك الأهمّيّة

237
00:17:26,760 --> 00:17:29,020
.هذا ما أشعر به الآن فحسب

238
00:17:29,400 --> 00:17:32,020
!إنّك صريح دائمًا

239
00:17:32,020 --> 00:17:35,200
...هذا لأنّي شخص خفيّ

240
00:17:35,200 --> 00:17:38,200
.لا يمكنني التّعبير عن مشاعري إن لم أبح بها

241
00:17:44,320 --> 00:17:48,920
...إنّ سماع هذا... يجعل دقّات قلبي تتزايد

242
00:17:49,200 --> 00:17:54,170
إنّ كلّ الأشياء الصّغيرة الّتي تقولينها
.وتفعلينها تجعل دقّات قلبي تتزايد

243
00:17:54,170 --> 00:17:56,090
!كاذب

244
00:17:58,530 --> 00:17:59,810
.أنا لا أكذب

245
00:18:11,300 --> 00:18:12,970
.جيّد، في الوقت المناسب

246
00:18:12,970 --> 00:18:13,770
.يا أختي

247
00:18:15,310 --> 00:18:16,220
!فو-كُن

248
00:18:16,960 --> 00:18:20,750
لماذا أردت أن تأتي فجأة؟

249
00:18:22,430 --> 00:18:23,780
أين هو تونومي-سان؟

250
00:18:23,780 --> 00:18:26,290
ألا يصطحبك إلى المنزل بعد العمل؟

251
00:18:26,290 --> 00:18:29,040
!ما زال لأكيرا-سان عمل

252
00:18:29,040 --> 00:18:31,680
!ليس لعمل المحقّقين ساعات محدّدة

253
00:18:31,680 --> 00:18:32,700
.عجبًا

254
00:18:33,220 --> 00:18:34,830
.على أيّ حال، أنا جائع

255
00:18:34,830 --> 00:18:36,720
.خذيني إلى مكان ما لنأكل

256
00:18:36,720 --> 00:18:39,420
...لكنّي لم أقبض أجرتي بعد

257
00:18:42,630 --> 00:18:45,140
.أعطاني أبي 10 آلاف ينّ للعشاء

258
00:18:45,140 --> 00:18:46,430
!لننطلق إذًا

259
00:18:46,430 --> 00:18:50,810
أعرف بعض الأماكن المسجّلة
...في تطبيق التّوجيه خاصّتي

260
00:18:57,630 --> 00:18:59,170
ما الخطب؟

261
00:18:59,800 --> 00:19:01,840
.هنالك شخص خفيّ يرتدي بذلة

262
00:19:02,200 --> 00:19:03,410
.قد يكون تونومي-سان

263
00:19:03,970 --> 00:19:05,530
!أكيرا-سان قريب؟

264
00:19:05,530 --> 00:19:07,490
.سأتحقّق إن كان هنا

265
00:19:07,820 --> 00:19:10,040
ستتحقّق إن كان هو؟

266
00:19:13,020 --> 00:19:13,890
.تفضّلي

267
00:19:19,480 --> 00:19:21,130
...تونومي-سان

268
00:19:22,380 --> 00:19:24,390
!شكرًا جزيلاً

269
00:19:26,880 --> 00:19:27,770
.أختي

270
00:19:27,770 --> 00:19:29,300
!مرحبًا بعودتك

271
00:19:29,300 --> 00:19:31,230
أخبرني، هل كان هو؟

272
00:19:31,230 --> 00:19:33,940
.تونومي خائن

273
00:19:34,330 --> 00:19:35,480
.سأقوم بسحقه بالكامل

274
00:19:35,480 --> 00:19:37,400
عمّ تتحدّث؟

275
00:19:38,130 --> 00:19:41,160
...ماذا؟ سنلاحق أكيرا-سان

276
00:19:41,160 --> 00:19:43,240
.إنّه محقّق. سيلاحظنا في الحال

277
00:19:43,240 --> 00:19:45,120
.هو من يتسلّل خلسة هنا

278
00:19:45,120 --> 00:19:46,870
.سأوسعه ضربًا في كلّ الأحوال

279
00:19:47,120 --> 00:19:49,080
.على الأرجح أنّها عملية احتيال تتعلّق بالزّواج

280
00:19:49,080 --> 00:19:52,640
.ما كان أكيرا-سان ليفعل أيّ شيء كهذا

281
00:19:53,300 --> 00:19:57,810
.ولم تتحقّق بما يكفي لتُؤكّد أنّه خائن

282
00:19:57,810 --> 00:20:00,800
.لا، رأيتُه يقدّم الخاتم لها

283
00:20:01,970 --> 00:20:05,310
.يا إلهي. يا لك من هاوٍ يا فو-كُن

284
00:20:05,590 --> 00:20:09,810
!لا تنسَ أنّني أعمل في وكالة تحقيقات أيضًا

285
00:20:09,810 --> 00:20:12,310
.أنت هاوية أيضًا. لستِ محقّقة

286
00:20:13,900 --> 00:20:15,290
.لقد دخلا مبنى ما

287
00:20:24,400 --> 00:20:25,570
هل أنت متوتّرة؟

288
00:20:25,850 --> 00:20:28,450
.نعم، كثيرًا

289
00:20:35,960 --> 00:20:37,600
!فو-كُن، أين أنت؟

290
00:20:37,600 --> 00:20:39,590
!لا تتركني وحدي

291
00:20:39,590 --> 00:20:41,410
!أهذا زجاج؟ أهي نافذة؟

292
00:20:41,410 --> 00:20:43,380
!يا فو-كُن

293
00:21:00,480 --> 00:21:02,800
.من هنا يا شيزوكا-سان

294
00:21:04,740 --> 00:21:07,000
أ-أكيرا-سان؟

295
00:21:15,570 --> 00:21:16,500
.لقد نسيت

296
00:21:16,800 --> 00:21:21,160
.عفوًا... لم أتخيّل أن ألقاك هنا

297
00:21:21,160 --> 00:21:24,470
.أنا آسف، لكنّي أعمل الآن

298
00:21:24,470 --> 00:21:26,360
أيمكننا التّكلّم لاحقًا؟

299
00:21:27,730 --> 00:21:29,010
تعمل؟

300
00:21:33,970 --> 00:21:37,000
...عفوًا، آسف على التّدخّل

301
00:21:37,000 --> 00:21:38,400
أخي؟

302
00:21:42,420 --> 00:21:44,770
...كنتُ أبحث عنك لوقت طويل

303
00:21:45,070 --> 00:21:47,570
...مرّت عشرون سنة

304
00:21:47,570 --> 00:21:49,610
!وجدتك أخيرًا

305
00:21:57,630 --> 00:21:59,940
!كيف أحوالك؟

306
00:21:59,940 --> 00:22:01,680
!أنا بخير

307
00:22:01,680 --> 00:22:02,890
!فعلاً؟

308
00:22:02,890 --> 00:22:04,670
هل نمنحهما بعض الخصوصيّة؟

309
00:22:06,250 --> 00:22:08,200
ما رأيكما بعشاء؟