1
00:00:04,200 --> 00:00:04,980
.يا معلّمة

2
00:00:05,610 --> 00:00:08,810
لِم غادرت نونا في
عربة تلك العائلة؟

3
00:00:09,730 --> 00:00:11,160
...السيّد كلارك

4
00:00:11,920 --> 00:00:14,280
.حسنًا، لا أعلم

5
00:00:15,060 --> 00:00:17,450
ماذا؟ يا معلّمة؟

6
00:00:18,820 --> 00:00:22,330
.أعتذر لكن عليّ أن أغادر الآن

7
00:02:10,010 --> 00:02:12,700
ماذا حدث يا فيكتوريا؟

8
00:02:13,700 --> 00:02:17,440
سيتبنّى أحد النبلاء نونا
.على ما يبدو

9
00:02:19,250 --> 00:02:20,560
ماذا يجري؟

10
00:02:20,560 --> 00:02:22,650
هل وافقت نونا على ذلك؟

11
00:02:22,650 --> 00:02:23,530
.أظنّ ذلك

12
00:02:30,240 --> 00:02:33,790
لماذا؟ كنّا بخير، صحيح؟

13
00:02:34,850 --> 00:02:36,920
كنّا نعيش حياة سعيدة؟

14
00:02:38,920 --> 00:02:40,930
!هل أنتِ هناك يا فيكتوريا؟

15
00:02:41,770 --> 00:02:45,360
.لا أريده أن يراني محبطة

16
00:02:46,000 --> 00:02:47,350
!أعلم أنّك موجودة

17
00:02:47,350 --> 00:02:49,300
!سأكسر الباب إن لم تفتحي

18
00:02:49,750 --> 00:02:51,530
.إنّه مفتوح

19
00:02:56,450 --> 00:02:58,780
.تواصلت معي السيّدة يولانا

20
00:02:59,240 --> 00:03:01,440
أخبرتني أنّ نونا ذهبت
إلى بيت أحد النبلاء؟

21
00:03:02,240 --> 00:03:08,270
ظننتُ أنّ نونا ستبقى
.بجانبي إلى الأبد

22
00:03:08,710 --> 00:03:12,410
رغم أنّها تملكُ الحق
.في تقرير حياتها بنفسها

23
00:03:12,410 --> 00:03:13,620
...فيكتوريا

24
00:03:16,130 --> 00:03:19,360
أعتقد أنّ نونّا ذهبت معهما
.لأنّ لديها خطة

25
00:03:19,360 --> 00:03:22,450
.نعم، أظنّ ذلك أيضًا

26
00:03:22,450 --> 00:03:25,500
.لكن هذه فرصة كبيرة لها

27
00:03:26,090 --> 00:03:28,140
سيكون أكثر نفعًا وأمانًا

28
00:03:28,140 --> 00:03:32,760
أن يتبنّاها نبيل مع ضمان
.مكانة وحياة كريمة

29
00:03:33,000 --> 00:03:36,320
.لا تُقلّلي من نفسك بقول هذا الكلام

30
00:03:36,930 --> 00:03:39,880
.أنت امرأة قويّة ومستقلة تستحق التقدير

31
00:03:40,540 --> 00:03:42,030
.أنا متأكد أنّها ستعود

32
00:03:44,280 --> 00:03:50,190
أتألم لأنّني أعلم أنّها
.ستكون أسعد إن لم تعُد

33
00:03:53,680 --> 00:03:57,990
ستقرّر نونّا بنفسها
.ما يسعدها يا فيكتوريا

34
00:03:58,940 --> 00:04:00,660
.أثق بها

35
00:04:00,660 --> 00:04:02,810
.أعلمُ أنّها ستختارك وتعود للبيت

36
00:04:05,280 --> 00:04:06,550
.أنت محق

37
00:04:07,860 --> 00:04:10,700
،كمفاجأة عند عودتها

38
00:04:10,700 --> 00:04:14,100
عليّ أن أخيط هذه الأزرار
.المغطاة في ثيابها

39
00:04:16,850 --> 00:04:20,320
.شكرًا. سأكون بخير

40
00:04:21,010 --> 00:04:22,870
.ربّما عليّ أن أطبخ

41
00:04:22,870 --> 00:04:24,630
هل أكلتَ العشاء؟

42
00:04:25,880 --> 00:04:27,580
.ليس بالكثير

43
00:04:27,830 --> 00:04:28,880
.إنّه أكثر من كافٍ

44
00:04:28,880 --> 00:04:29,980
.يبدو لذيذًا

45
00:04:31,100 --> 00:04:33,330
،أنا متأكد أنّ نونا ستعود

46
00:04:34,050 --> 00:04:36,680
لكن لا داعي لكبح نفسك
.إن كنتِ حزينة

47
00:04:37,190 --> 00:04:39,920
.يمكنك الذهاب إلى قصر البارون وإعادتها

48
00:04:39,920 --> 00:04:43,300
!إن احتجتِ دعمًا... فسأرافقك

49
00:04:46,160 --> 00:04:50,560
.أودّ إعطاء الأولوية لمشاعرها لذا سأنتظر

50
00:04:50,560 --> 00:04:53,190
...فهمت

51
00:05:02,200 --> 00:05:06,220
أثناء غياب نونا، سأحاول أن
.أكيّف حياتي وفقًا لذلك

52
00:05:08,820 --> 00:05:11,160
ما الأمر؟

53
00:05:13,970 --> 00:05:18,040
هلّا تتدرّب معي يا سيّد مايلز؟

54
00:05:18,490 --> 00:05:19,530
.موافق

55
00:05:19,840 --> 00:05:21,510
.أنا مستعد متى كنتِ مستعدة

56
00:05:33,410 --> 00:05:36,440
.حسنًا، أصبتُ عيناك

57
00:05:36,440 --> 00:05:38,630
!نلتِ مني! لنعد الكرّة

58
00:05:39,360 --> 00:05:40,850
.بقدر ما تشاء

59
00:05:45,110 --> 00:05:46,740
ماذا حدث للفتاة؟

60
00:05:48,850 --> 00:05:51,120
.إنّها تمكث في منزل شخص آخر

61
00:06:04,150 --> 00:06:07,720
تجنبتُ النقطة الحساسة
.واستهدفتُ وركك

62
00:06:08,550 --> 00:06:11,940
بالنسبة للمسنين، الورك
...مثل أيّ نقطة حساسة

63
00:06:13,480 --> 00:06:15,980
أتقول عن نفسك
أنّك مُسن حقًا؟

64
00:06:17,850 --> 00:06:20,080
.ابتهجتِ أخيرًا

65
00:06:20,080 --> 00:06:21,040
!نعم

66
00:06:22,270 --> 00:06:24,040
.شكرًا جزيلًا

67
00:06:24,040 --> 00:06:26,140
.تعالي لزيارتي متى شئتِ

68
00:06:26,140 --> 00:06:28,310
.استمتعتُ كثيرًا اليوم

69
00:06:31,610 --> 00:06:34,880
.لم يتطفل السيّد مايلز

70
00:06:35,430 --> 00:06:38,340
.واستطعتُ التأكد ممّا أردتُ معرفته

71
00:06:49,600 --> 00:06:53,380
.أفهم ما تحاول قوله يا سيّد كلارك

72
00:06:53,380 --> 00:06:56,560
.لكنّني أقدّم مشاعر نونا على كلّ شيء

73
00:06:57,790 --> 00:07:00,800
!لو كان الأمر بيدي، لما تركتُ نونا تذهب

74
00:07:58,810 --> 00:08:00,450
ماذا تفعلين؟

75
00:08:07,320 --> 00:08:10,780
تتجولين وجدك ليلًا مرتدية هذا؟

76
00:08:10,780 --> 00:08:13,750
.هذا أشبه باستدراج أشرار لمهاجمتك

77
00:08:14,040 --> 00:08:15,950
ما الذي دفعكِ لفعل هذا؟

78
00:08:15,950 --> 00:08:18,270
.مكثت ست ليالٍ كما وعدتُ

79
00:08:18,270 --> 00:08:21,510
.ثم أضافا قفلًا لغرفتي

80
00:08:21,510 --> 00:08:24,820
.وصارا ينادياني دولوريس

81
00:08:24,820 --> 00:08:28,380
".أخبراني أن أناديهما "أمّي" و"أبي

82
00:08:28,380 --> 00:08:29,510
.لم يعجبني ذلك

83
00:08:29,510 --> 00:08:32,030
.لستُ دولوريس وليسا والديّ

84
00:08:32,860 --> 00:08:34,950
وكيف تسلّلتِ للخارج؟

85
00:08:35,370 --> 00:08:38,710
تدلّيتُ من نافذة الطابق
.الثاني ثم أفلتُ

86
00:08:39,440 --> 00:08:43,210
.تدحرجتُ عند الهبوط كما علّمتِني

87
00:08:44,450 --> 00:08:47,470
...أخبرتكِ أنّ ذلك للطوارئ فقط

88
00:08:47,470 --> 00:08:49,960
.حبسهما لي كان حالة طارئة

89
00:08:49,960 --> 00:08:52,450
تظاهرهما بأنّني طفلتهما
.الميتة كان حالة طارئة

90
00:08:53,720 --> 00:08:56,980
.صحيح، حبسكِ أمر فظيع

91
00:08:57,400 --> 00:09:00,000
لكن مع ذلك، ربّما لم يكن عليكِ

92
00:09:00,000 --> 00:09:02,820
.قبول عرضهما منذ البداية

93
00:09:03,240 --> 00:09:05,970
كانت السيّدة إيفا في
.موقف صعب وقتها

94
00:09:06,350 --> 00:09:09,730
.إنّها تمسك منديلها بقوّة عندما تضطرب

95
00:09:09,730 --> 00:09:11,500
.لهذا ذهبتُ

96
00:09:11,500 --> 00:09:13,640
.قالا أنّ بوسعي الرفض حينها

97
00:09:13,640 --> 00:09:17,220
هل سبق أن رأيتِ
السيّدة إيفا مضطربة؟

98
00:09:17,220 --> 00:09:21,240
نعم. عندما رأتني أركل
.السيّد كلارك بركبتي

99
00:09:21,460 --> 00:09:25,090
أنتِ... ركلتِ السيّد كلارك بركبتك؟

100
00:09:25,090 --> 00:09:26,000
.فعلت

101
00:09:26,000 --> 00:09:28,600
.لأنّه أراد أن يرى مثالًا

102
00:09:28,600 --> 00:09:30,480
!أريد أن أرى مثالًا على ركلة الركبة

103
00:09:30,480 --> 00:09:31,430
.حسنًا

104
00:09:31,430 --> 00:09:32,540
!مؤلم

105
00:09:32,540 --> 00:09:34,510
!ماذا يحدث بينكما؟

106
00:09:34,980 --> 00:09:39,150
ما الذي تفعلينه
بالضبط حين لا أراقبك؟

107
00:09:39,760 --> 00:09:43,760
ماذا؟ تسلّلت من قصر البارون ليلًا؟

108
00:09:44,050 --> 00:09:49,010
لا بدّ أنّهما قلقان لذا
.كنتُ ذاهبة للاعتذار الآن

109
00:09:50,270 --> 00:09:54,130
.لا، أظن أنّ من الأفضل ألّا تذهبا

110
00:09:54,130 --> 00:09:56,090
.سأتواصل معهما بالنيابة عنك

111
00:09:57,050 --> 00:10:01,030
قبل أربع سنوات، تفشّى زكام يُسبّب
.حمى شديدة في العاصمة الملكية

112
00:10:01,610 --> 00:10:04,600
.أودى بحياة عدد من الأطفال والشيوخ

113
00:10:05,040 --> 00:10:11,090
أصيب به كلارك وارتفعت حرارته
.لكنّه تعافى لحسن الحظ

114
00:10:12,270 --> 00:10:16,150
،لكن بما أنّ زوجي كان وزير الخارجية

115
00:10:16,150 --> 00:10:19,370
قال النّاس أنّنا استخدمنا
.دواء ممتازًا من بلد آخر

116
00:10:20,040 --> 00:10:24,400
لم يكن ذلك صحيحًا لكن
.مهما أنكرنا، لم تختفِ الشائعة

117
00:10:25,010 --> 00:10:29,300
.ثم أتى إلينا البارون هانسون يومًا ما

118
00:10:29,580 --> 00:10:33,440
.توسّل أن نشاركه الدواء وهو يبكي

119
00:10:33,440 --> 00:10:36,310
.وإلّا فإنّ ابنته ستموت

120
00:10:36,640 --> 00:10:41,480
لا ذنب لعائلة أندرسون فيما
.حدث يا سيّدة إيفا

121
00:10:41,480 --> 00:10:43,010
.منطقيًا، أعلم ذلك

122
00:10:43,390 --> 00:10:45,740
.لكن بالنسبة لهم، لم يكن الأمر عن المنطق

123
00:10:47,300 --> 00:10:50,620
آسفة لإقحامكِ في شؤوننا
.مع عائلة هانسون

124
00:10:51,370 --> 00:10:54,640
.سبّبنا متاعب لكِ ولنونا

125
00:10:55,100 --> 00:10:59,880
في اليوم التالي، وصلت أمتعة
.ورسالة من البارون هانسون

126
00:11:01,040 --> 00:11:06,340
في الرسالة، شكرنا على
منحه فرصة ليشعر

127
00:11:06,340 --> 00:11:08,520
.وكأنّ دولوريس عادت

128
00:11:10,100 --> 00:11:14,960
هناك فساتين، أحذية، مجوهرات
.وحقائب تبدو فاخرة هنا

129
00:11:15,350 --> 00:11:16,490
حقًا؟

130
00:11:17,260 --> 00:11:19,780
،شعرتُ بضيق في صدري

131
00:11:19,780 --> 00:11:24,400
وأنا أتخيّل كيف كان شعور آل هانسون
.وهُم يتخلّون عن هذه الأغراض

132
00:11:24,770 --> 00:11:29,700
هل اقتنعا أنّ لا أحد
يستطيع أن يحل محل طفلتهما؟

133
00:11:30,530 --> 00:11:34,170
...آنذاك، بعدما تركاني وأنا في الثامنة

134
00:11:34,730 --> 00:11:38,040
هل افتقدني والداي؟

135
00:11:40,610 --> 00:11:45,990
حذّر أخي الأكبر البارون هانسون
أن لا ينسى

136
00:11:45,990 --> 00:11:48,030
.أنّكِ وصية نونّا

137
00:11:48,510 --> 00:11:51,350
حتّى اللورد إدوارد تصرّف
من أجلي إذًا؟

138
00:11:51,690 --> 00:11:53,930
.أودّ أن أزوره قريبًا لأعبّر عن امتناني

139
00:11:53,930 --> 00:11:55,110
.لا تقلقي حيال ذلك

140
00:11:55,420 --> 00:11:58,500
.إنّه ممتن لما فعلتِه من أجل عمّنا

141
00:11:58,970 --> 00:12:03,310
هل فعلا لكِ شيئًا مخيفًا أثناء
إقامتكِ معهما يا نونا؟

142
00:12:04,170 --> 00:12:09,060
لم يفعلا لكنّني لم أحب
أن أبقى وحدي مع البارونة

143
00:12:09,060 --> 00:12:11,350
.لأنّها واصلت مناداتي دولوريس

144
00:12:11,350 --> 00:12:15,090
وأخافني بكاؤهما وهما يقولان
.أنّ العائلة عادت مكتملة

145
00:12:18,100 --> 00:12:20,090
.لكن لم يعد الأمر يزعجني

146
00:12:21,850 --> 00:12:23,860
.أنتِ فتاة قويّة

147
00:12:23,860 --> 00:12:25,380
.وطيّبة أيضًا

148
00:12:25,600 --> 00:12:27,090
.فيكي

149
00:12:27,090 --> 00:12:28,130
نعم؟

150
00:12:28,130 --> 00:12:30,430
ألا يمكننا العيش مع جيف؟

151
00:12:31,140 --> 00:12:32,250
...عجبًا

152
00:12:36,060 --> 00:12:39,960
.ليتنا نستطيع لكنّ ذلك مستحيل

153
00:12:46,590 --> 00:12:49,410
في الأصل، خطّطتُ للانتقال
إلى بلد آخر

154
00:12:49,410 --> 00:12:52,400
بعد نصف سنة تقريبًا
.وألّا أبقى في مكان واحد

155
00:12:52,760 --> 00:12:54,950
.لذا كنتُ مُستعدّة

156
00:12:56,080 --> 00:12:59,930
السيّد مايلز ليس الساكن
.الأصلي لذلك المنزل

157
00:13:00,380 --> 00:13:03,870
.الساكن الفعلي أعسر وأقصر بكثير

158
00:13:04,970 --> 00:13:06,710
التدريب مع السيّد مايلز أوضح

159
00:13:07,000 --> 00:13:09,440
.أنّ يده اليمنى هي المهيمنة

160
00:13:10,530 --> 00:13:13,100
علّاقة الأغراض في البيت
.مثبتة في مكان منخفض

161
00:13:13,570 --> 00:13:19,610
والجوربُ القديم الذي يستخدمه لتنظيف الأدوات
.أصغر بكثير من مقاس قدمي مايلز

162
00:13:20,590 --> 00:13:25,040
جندي سابق صدف أنّه
يعيش خلف منزل عميلة سابقة

163
00:13:25,040 --> 00:13:27,310
،ليس الساكن الحقيقي للمكان

164
00:13:28,020 --> 00:13:33,120
...كما أنّني صادفته أثناء ركضي اليومي

165
00:13:33,740 --> 00:13:35,840
.لم تعُد هذه مجرّد مصادفة

166
00:13:36,180 --> 00:13:41,750
شخص ما أسكن السيّد مايلز
.في ذلك البيت لمراقبة تحرّكاتي

167
00:13:42,260 --> 00:13:47,250
يلحّ عليّ حدسي، يخبرني أنّ وقت
.الرحيل حان إن كنتُ أخشى على سلامتي

168
00:13:49,750 --> 00:13:50,890
نونا؟

169
00:13:52,630 --> 00:13:54,950
!لديكِ حمّى

170
00:13:58,640 --> 00:14:03,710
.أنا ممتنة لقلقك عليّ يا جيف

171
00:14:04,070 --> 00:14:08,040
لكن عليك أن تُعطي الأولوية
.لشؤونك الخاصة حين تكون مشغولًا

172
00:14:08,040 --> 00:14:12,740
،أنا أعزب خالي البال
.لذا لا شؤون لديّ تقريبًا يا أمّي

173
00:14:13,580 --> 00:14:18,490
.أخبرني إدوارد أنّك صرت مقرّبًا من شابة

174
00:14:19,800 --> 00:14:22,990
متى ستُعرّفني عليها؟

175
00:14:23,480 --> 00:14:25,040
...هذا

176
00:14:25,040 --> 00:14:27,350
هل تمنحينني بعض الوقت؟

177
00:14:27,350 --> 00:14:29,510
.لم يُؤكّد شيء بعد

178
00:14:30,570 --> 00:14:34,270
.عجبًا، أنت حذر إذًا

179
00:14:35,030 --> 00:14:36,730
حذر إذًا؟

180
00:14:37,160 --> 00:14:40,780
.لا أظنّ أنّ فيكتوريا تكرهني

181
00:14:40,780 --> 00:14:45,180
،لكن كلّما تقدّمتُ خطوة
.تراجعت هي خطوة

182
00:14:45,850 --> 00:14:50,400
رصَدَت ذلك الرجل المشبوه أسرع
.من أيّ شخص في الحفل

183
00:14:50,830 --> 00:14:54,370
حاصَرَت مقاتلًا بارعًا مثل الأمير
،سيدريك وكسرت عظامه

184
00:14:54,370 --> 00:14:56,450
.لكنّها خرجت سالمة من ذلك

185
00:14:57,170 --> 00:15:00,160
،تتقن أربع لغات
،تجيد الطبخ والتنظيف

186
00:15:00,730 --> 00:15:02,910
.وتدرّبت على القتال بلا سلاح وفنون المبارزة

187
00:15:03,540 --> 00:15:06,040
...الاستنتاج الوحيد من كلّ ذلك هو

188
00:15:06,960 --> 00:15:08,690
.أنّها عميلة هاربة

189
00:15:09,270 --> 00:15:13,540
على الأرجح عميلة من دولة
.مُعادية لمملكة أشبوري

190
00:15:13,920 --> 00:15:19,240
من المنطقي أنّها لا تريد
.الحديث عن ماضيها أو مخاوفها

191
00:15:19,900 --> 00:15:22,630
.اسم فيكتوريا سيلارز مزيّف أيضًا

192
00:15:23,800 --> 00:15:24,800
...لكن

193
00:15:24,800 --> 00:15:28,380
لم يكن هناك مكسب من
.الاقتراب منّي أو من عمّي

194
00:15:28,920 --> 00:15:31,950
...وقد طُلِب منها أن تكون معلّمة لكلارك

195
00:15:32,400 --> 00:15:36,330
لا يعقل أن تكون مهمتها
.ومحال أن تتقاعد في مثل عمرها

196
00:15:36,770 --> 00:15:42,080
الهروب من منظّمتها هو
.التفسير الوحيد المعقول

197
00:15:43,100 --> 00:15:45,980
مع ذلك، ما الذي عليّ فعله؟

198
00:15:47,060 --> 00:15:49,550
.أهلًا، أحضرتُ بعض الكستناء المشوية

199
00:15:49,550 --> 00:15:52,930
.شكرًا لك كالعادة أيّها القائد

200
00:15:52,300 --> 00:15:55,090
إن اخترتُ العيش معها فأفضلُ حل

201
00:15:54,560 --> 00:15:55,720
.تفضّل بالدخول

202
00:15:55,090 --> 00:15:58,390
هو أن أشطب اسمي من سجل العائلة
وأصبح من العامّة

203
00:15:56,050 --> 00:15:57,810
كيف حال نونّا؟

204
00:15:57,810 --> 00:16:00,810
.انخفضت حمّاها لحسن الحظ

205
00:15:58,390 --> 00:16:00,800
.كي لا أسبّب لهم أيّ مشاكل

206
00:16:01,580 --> 00:16:07,320
لكن يبدو أنَّ فيكتوريا نفسها
.تطلبُ مني ألّا أتدخّل

207
00:16:07,810 --> 00:16:10,720
،ما إن أخبرها أنّني أريد العيش معهما

208
00:16:10,720 --> 00:16:14,040
.أشعرُ أنّها ستختفي مع نونّا

209
00:16:14,900 --> 00:16:21,060
،وإن أرادت أن تختفي فعلًا
.فلن أستطيع إيجادها

210
00:16:21,500 --> 00:16:23,460
.شكرًا كالعادة

211
00:16:31,250 --> 00:16:36,190
ألم تجدوا بعد المرأة حمراء الشعر
التي ساعدت في عملية الهروب من السجن؟

212
00:16:36,190 --> 00:16:37,260
.ليس بعد يا سيّدي

213
00:16:37,660 --> 00:16:39,490
،بما أنّ الدافع لا يزال غير واضح

214
00:16:39,490 --> 00:16:41,930
.لم نستطع تضييق نطاق التحقيق

215
00:16:41,930 --> 00:16:43,050
.فهمت

216
00:16:43,050 --> 00:16:46,830
.اختفت أخت السجين الصغيرة أيضًا

217
00:16:46,830 --> 00:16:49,430
نبحثُ في الأحياء الفقيرة
.لكن لم نجد شيئًا

218
00:16:49,430 --> 00:16:50,770
.فهمت

219
00:16:51,160 --> 00:16:54,810
كان لذلك الرجل ظروف مخففة، صحيح؟

220
00:17:01,390 --> 00:17:04,830
،التحقيق بخصوص فيكتوريا سيلارز

221
00:17:04,830 --> 00:17:08,140
،التقرير عن المرأة في حفلة الرقص

222
00:17:08,450 --> 00:17:11,550
...وحادثة الهروب من السجن

223
00:17:11,920 --> 00:17:17,750
،شابة هي محور كلّ هذه الأحداث
.وكلّها وقعت بعد قدومِها إلى هذا البلاد

224
00:17:18,490 --> 00:17:22,270
.قال جيفري أنّ والديها ماتا في حريق

225
00:17:22,730 --> 00:17:27,400
لكن التحقيق قال أنَّ وضع والدي
.فيكتوريا سيلارز مجهول

226
00:17:27,850 --> 00:17:31,420
،ووفقًا لتقرير مايلز

227
00:17:31,420 --> 00:17:35,800
قالت أنّها تعلّمت التعامل مع
.الخيول من إخوتها في الجيش

228
00:17:35,800 --> 00:17:38,490
لكن فيكتوريا سيلارز الحقيقية
.ليس لها إخوة

229
00:17:40,480 --> 00:17:42,750
.تهاونتِ يا فيكتوريا

230
00:17:43,060 --> 00:17:47,670
أوصيتُ بها للورد أندرسون
كمعلّمة لكلارك

231
00:17:47,670 --> 00:17:51,400
لأنّني أردتُ أن أبقيها
.في مجال رؤيتي

232
00:17:52,850 --> 00:17:55,540
.إنّها تهرب من شيء ما

233
00:17:55,540 --> 00:17:57,820
،وبحسب ما يكون
،قد تحتاج إلى حماية

234
00:17:57,820 --> 00:18:02,020
،لكن من ناحية أخرى
.قد يلزم تسليمها للطرف المعني

235
00:18:02,710 --> 00:18:07,720
لكنّني مدين لها لأنّها
.حرّرت جيفري من سجنه النفسي

236
00:18:07,980 --> 00:18:14,330
قد تستطيعُ إلقاء النّور
.على الظلام الكامن في قلبه

237
00:18:14,330 --> 00:18:17,330
.ليتني أستطيع دعم علاقتهما

238
00:18:17,730 --> 00:18:19,660
،لكن حتّى لو أردتُ نصحه

239
00:18:19,660 --> 00:18:22,990
فإنّ جيفري لا يعلم أنّني
.مع فيلق الفرسان الثالث

240
00:18:24,050 --> 00:18:28,490
لكن، لا بدّ أنّه يدرك أنّ تلك
.المرأة ليست مجرد عامية عادية

241
00:18:29,610 --> 00:18:32,570
.آملُ ألّا يقدم على فعل متهور

242
00:18:33,990 --> 00:18:37,410
.سأُخرج أليغ يا سيّد مايلز

243
00:18:37,410 --> 00:18:38,380
.حسنًا

244
00:18:39,150 --> 00:18:41,050
ألا ترافقك الصغيرة اليوم؟

245
00:18:41,730 --> 00:18:46,180
.لا، أصابها زكام خفيف لذا بقيت في البيت

246
00:18:46,420 --> 00:18:48,720
.فهمت. آمل أن تتحسّن قريبًا

247
00:18:49,020 --> 00:18:49,970
.نعم

248
00:18:50,610 --> 00:18:52,050
.شكرًا جزيلًا

249
00:18:56,890 --> 00:18:58,570
.ثمة أمر مريب

250
00:19:01,060 --> 00:19:03,520
هل حدث شيء أثناء خروجها؟

251
00:19:06,370 --> 00:19:08,840
.أعتذر عن الإزعاج وأنتِ مع ضيف

252
00:19:08,840 --> 00:19:12,670
.اسمي مايلز وأسكن خلفكم مباشرة

253
00:19:14,260 --> 00:19:16,060
.أنا يولانا هاينز

254
00:19:16,550 --> 00:19:17,550
ما حاجتك؟

255
00:19:17,550 --> 00:19:21,020
في الواقع، خرجت الآنسة فيكتوريا هذا الصباح

256
00:19:21,020 --> 00:19:25,350
.على حصان أعتني به لأجلها ولم تعُد

257
00:19:25,350 --> 00:19:27,010
.لذا قلقتُ عليها

258
00:19:27,860 --> 00:19:29,400
.فهمت

259
00:19:29,890 --> 00:19:32,940
.لم تعُد الآنسة فيكتوريا هنا

260
00:19:33,380 --> 00:19:35,820
.انتقلت باكرًا صباح اليوم

261
00:19:36,170 --> 00:19:38,690
.تركت لك رسالة

262
00:19:41,940 --> 00:19:45,460
.شكرًا لاعتنائك بأليغ

263
00:19:45,870 --> 00:19:48,200
.استمتعتُ بجمع الكستناء معك

264
00:19:50,250 --> 00:19:54,910
ارتحتُ إذ عملتُ أنّ الآنسة فيكتوريا
.بخير ولم يصبها مكروه

265
00:19:54,910 --> 00:19:57,800
.سأغادر الآن

266
00:20:01,730 --> 00:20:03,840
.سأذهبُ لتسليم الرسائل

267
00:20:05,280 --> 00:20:08,470
هل لي أن أسألك سؤالًا أيّها القائد؟

268
00:20:08,960 --> 00:20:09,980
.بالطبع

269
00:20:09,980 --> 00:20:12,490
ألم تخبرك فيكتوريا بأيّ شيء؟

270
00:20:20,600 --> 00:20:24,950
.لا، للأسف، لم تُخبرني بشيء

271
00:20:34,840 --> 00:20:38,680
.يا إلهي، توقفي عن البكاء الآن

272
00:20:39,210 --> 00:20:41,140
.حسنًا يا سيّدتي

273
00:20:41,760 --> 00:20:44,780
.كوني بخير رجاء

274
00:20:45,440 --> 00:20:49,720
.وعُودي يومًا ما إلى هذا المكان

275
00:20:50,600 --> 00:20:53,220
ما معنى هذا؟

276
00:20:54,330 --> 00:20:55,720
!رحلت؟

277
00:20:55,720 --> 00:20:58,300
!ماذا تقصد يا عمّي جيف؟

278
00:20:56,420 --> 00:20:57,690
!كلارك

279
00:20:59,150 --> 00:21:00,870
.يكفي يا كلارك

280
00:21:01,360 --> 00:21:02,730
.لا أعلمُ أيضًا

281
00:21:04,420 --> 00:21:06,260
...عزيزي اللورد جيفري آشر

282
00:21:06,660 --> 00:21:09,140
.أعتذر لأنّني اختفيتُ عنك فجأة

283
00:21:09,550 --> 00:21:13,650
.هناك سبب يمنعني من البقاء في ذلك البيت

284
00:21:14,700 --> 00:21:20,210
ساعدتَني، أظهرتَ لي لطفًا كبيرًا
.وتقاسمتَ الضحك معي

285
00:21:20,210 --> 00:21:21,740
.أشكرك على كلّ ذلك

286
00:21:22,330 --> 00:21:25,370
...عشتُ أسعد أيّامي هنا

287
00:21:26,020 --> 00:21:28,470
،كنتُ سأرحل أبكر

288
00:21:28,770 --> 00:21:33,640
لكن الحياة هنا كانت ممتعة
.جدًا فأجّلتُ الرحيل

289
00:21:34,360 --> 00:21:40,950
سعدتُ بالذهاب في نزهتي الأولى
.وبالحديث أثناء أكل الكستناء المشوية

290
00:21:41,520 --> 00:21:45,650
.حظيتُ بذكريات جميلة بفضلك أيّها القائد

291
00:21:46,210 --> 00:21:48,520
.شكرًا على كلّ شيء

292
00:21:49,370 --> 00:21:52,430
.وأنا... آسفة

293
00:21:55,230 --> 00:21:59,170
لا تشكريني على أشياء
!مثل نزهة وكستناء مشوية

294
00:21:59,840 --> 00:22:01,000
...طلبتُ منكِ

295
00:22:01,550 --> 00:22:07,390
.رجوتُكِ ألّا تختفي عنّي هكذا