1
00:00:00,890 --> 00:00:03,440
أيّها الأستاذ، أنا أحبّك

2
00:00:04,540 --> 00:00:06,690
سنفوز بالذهبيّ السنة القادمة

3
00:00:07,510 --> 00:00:12,650
أنا مسرورٌ لاستمراركِ بهذا كلّ ذاك الوقت"
"كان عزفكِ جميلاً

4
00:00:12,650 --> 00:00:15,630
أختي، أنا أحبّكِ كثيراً

5
00:01:48,850 --> 00:01:53,360
اعتزل طلّاب السنة الثالثة، وبدأنا اختيار مسؤولين جدد

6
00:01:56,690 --> 00:02:00,020
تمّ ترشيحي، يوكو يوشيكاوا، لمنصب الرئيس

7
00:02:00,020 --> 00:02:02,250
أيّ اعتراضات؟

8
00:02:02,250 --> 00:02:03,310
أظنّ هذا جيّداً

9
00:02:03,310 --> 00:02:04,410
أتّفق

10
00:02:05,310 --> 00:02:06,760
شكراً لكم

11
00:02:06,760 --> 00:02:09,380
إذاً سأفترض أنّي قد عُيّنت

12
00:02:09,380 --> 00:02:11,870
الآن سنختار نائب الرئيس

13
00:02:15,770 --> 00:02:18,950
تمّ ترشيحي، ناتسوكي ناكاغاوا، لمنصب نائب الرئيس

14
00:02:19,940 --> 00:02:22,280
أيّ اعتراضات؟

15
00:02:22,280 --> 00:02:24,050
لـ-لحظة

16
00:02:24,050 --> 00:02:25,350
أنتِ نائب الرئيس؟

17
00:02:25,350 --> 00:02:26,690
لم أسمع شيئاً عن هذا

18
00:02:26,690 --> 00:02:27,910
لم أخبركِ

19
00:02:27,910 --> 00:02:29,150
أأنتِ جادة؟

20
00:02:29,150 --> 00:02:31,290
ما الذي كان يفكّر به طلّاب السنة الثالثة؟

21
00:02:31,290 --> 00:02:32,670
من يدري؟

22
00:02:32,670 --> 00:02:35,780
شعرتُ بالدهشة عند سماعي أنّكِ ستصبحين الرئيسة أيضاً

23
00:02:35,780 --> 00:02:37,750
تكهّنتُ بحدوث هذا

24
00:02:37,750 --> 00:02:40,310
إنّه ما أرادته أسوكا-سينباي

25
00:02:40,310 --> 00:02:43,050
إنّها تعبث بنا تماماً

26
00:02:43,050 --> 00:02:44,640
وهكذا

27
00:02:44,640 --> 00:02:50,830
لا أريد القيام بهذا حقاً، لكنّه طلبٌ من سينباي
لذا سأدعم هذه الفتاة

28
00:02:50,830 --> 00:02:51,750
شكراً لكم

29
00:02:51,750 --> 00:02:54,400
أقدّر لو بإمكانكِ عدم الإشارة بإصبعك للآخرين

30
00:02:54,400 --> 00:02:56,460
أقدّم اعتذاري

31
00:02:57,650 --> 00:03:00,460
كفّي عن السخرية مني

32
00:03:01,410 --> 00:03:06,680
وهكذا استهلت فرقة حفلات ثانوية
كيتاؤجي الموسيقية بدايةً جديدة

33
00:03:06,680 --> 00:03:09,560
لكنّي كنتُ أشعر بالقلق

34
00:03:26,470 --> 00:03:28,890
عزفٌ مجوّف بالفعل

35
00:03:30,600 --> 00:03:34,310
علينا العثور على أعضاءٍ أكثر السنة القادمة

36
00:03:34,800 --> 00:03:36,190
...هذا

37
00:03:36,670 --> 00:03:37,560
أجل

38
00:03:37,960 --> 00:03:41,740
هذا ما يعنيه التدريس في مدرسة

39
00:03:42,040 --> 00:03:45,880
كلّ ما بنيتَه في سنةٍ يعود لنقطة البداية تماماً

40
00:03:46,370 --> 00:03:48,870
لكن هذا ما يعجبني في الأمر

41
00:03:50,130 --> 00:03:53,130
يمكنك البدء من الصفر كلّ عام

42
00:03:53,130 --> 00:03:55,960
أظنّ هذا مذهلاً

43
00:03:59,930 --> 00:04:01,360
لعلّكِ محقّة

44
00:04:04,710 --> 00:04:06,520
ساكس-كن آخر

45
00:04:06,520 --> 00:04:07,830
محاولة جديدة

46
00:04:07,830 --> 00:04:09,130
عدتِ لهذا؟

47
00:04:09,130 --> 00:04:12,140
كنتُ أقاوم أثناء فترة المسابقة

48
00:04:12,770 --> 00:04:15,650
طلّاب السنة الثالثة سيتقاعدون إذاً

49
00:04:15,650 --> 00:04:17,110
هل تفتقدينهم؟

50
00:04:19,510 --> 00:04:21,920
ربما ذلك

51
00:04:23,170 --> 00:04:26,010
لم أظن أنّكِ هكذا

52
00:04:26,010 --> 00:04:27,320
ماذا؟ لمَ؟

53
00:04:27,670 --> 00:04:29,100
لا أدري

54
00:04:34,260 --> 00:04:37,840
لا أعلم إن كانت هذه نهايةً ملائمة

55
00:04:37,840 --> 00:04:40,400
أشعر بحسرةٍ ما

56
00:04:40,400 --> 00:04:42,090
لأنّنا لم نفز بالذهبي؟

57
00:04:44,260 --> 00:04:45,550
ربما

58
00:04:47,850 --> 00:04:49,180
كوميكو-تشان

59
00:04:52,500 --> 00:04:53,730
شويتشي

60
00:04:53,730 --> 00:04:55,350
اذهبي إليه

61
00:04:55,350 --> 00:04:56,690
لمَ؟

62
00:04:56,690 --> 00:04:57,730
...بسبب

63
00:04:57,730 --> 00:04:58,650
أجل

64
00:04:58,650 --> 00:04:59,480
ماذا هناك؟

65
00:04:59,480 --> 00:05:00,610
أحصل شيءٌ ما؟

66
00:05:00,610 --> 00:05:02,580
ألم تتلقّي

67
00:05:02,580 --> 00:05:04,780
شيئاً من تسوكاموتو؟

68
00:05:08,390 --> 00:05:09,860
شويتشي

69
00:05:12,490 --> 00:05:13,490
مرحباً

70
00:05:14,300 --> 00:05:15,500
أخبرني

71
00:05:16,420 --> 00:05:18,710
لم تنشر الأمر بين الآخرين، صحيح؟

72
00:05:18,710 --> 00:05:20,000
ما قصدك؟

73
00:05:20,380 --> 00:05:24,510
أعطيتني دبّوس شعرٍ في اليوم السابق للمسابقة

74
00:05:24,510 --> 00:05:25,730
بخصوص ذلك

75
00:05:26,290 --> 00:05:28,470
ماذا؟ لمَ عساي أفعل؟

76
00:05:30,490 --> 00:05:32,410
حسناً إذاً

77
00:05:35,250 --> 00:05:36,980
آمل

78
00:05:37,450 --> 00:05:41,110
أن نصل للمسابقة الوطنية السنة القادمة
للفوز بالذهبي، ألستِ معي؟

79
00:05:41,810 --> 00:05:43,550
بلى، أجل

80
00:05:44,280 --> 00:05:46,990
سيكون لدينا أعضاء جددٌ أيضاً

81
00:05:47,430 --> 00:05:49,130
وصلنا للمسابقة الوطنية

82
00:05:49,130 --> 00:05:51,490
سنملك عدداً طيّباً العام القادم حتماً

83
00:05:51,490 --> 00:05:52,830
أجل

84
00:05:52,830 --> 00:05:54,710
آمل أن نتمكن من تعليمهم كما يجب

85
00:05:57,920 --> 00:06:01,040
يا للشباب، أيّها الاثنان

86
00:06:01,040 --> 00:06:02,920
أسوكا-سينباي

87
00:06:02,920 --> 00:06:04,590
صدقاً؟

88
00:06:04,590 --> 00:06:06,670
القسم الكاذب جنايةٌ حقيقية كما تعرفين

89
00:06:07,020 --> 00:06:08,060
ما رأيك؟

90
00:06:08,060 --> 00:06:11,840
أظنّ شويتشي-كن كان يبدي علاماتً منذ صغره

91
00:06:11,840 --> 00:06:13,390
لا أدري عن كوميكو-تشان

92
00:06:13,390 --> 00:06:14,390
مُحال

93
00:06:14,390 --> 00:06:17,290
ليس عليكِ الإنكار هكذا

94
00:06:17,290 --> 00:06:18,730
الحُب والأندية المدرسية

95
00:06:18,730 --> 00:06:20,340
هذا جوهر الشباب

96
00:06:20,340 --> 00:06:21,800
أأنتِ جادة؟

97
00:06:21,800 --> 00:06:22,650
بالطبع

98
00:06:23,260 --> 00:06:25,800
لا تكفين عن الحديث بالهراء كعادتك

99
00:06:27,220 --> 00:06:28,110
عجبي

100
00:06:28,620 --> 00:06:31,230
أنا أحبّكِ حقاً يا أوماي-تشان

101
00:06:31,230 --> 00:06:32,410
ما الذي تقصدينه بذلك؟

102
00:06:34,720 --> 00:06:36,410
حسنٌ، لا يهمّ

103
00:06:36,410 --> 00:06:37,660
سأذهب إذاً

104
00:06:39,160 --> 00:06:40,210
ماذا هناك؟

105
00:06:40,540 --> 00:06:42,290
ستذهبين بالفعل؟

106
00:06:42,290 --> 00:06:44,420
أجل، هناك ما عليّ فعله

107
00:06:44,420 --> 00:06:46,550
هل أنتِ بحاجةٍ لشيءٍ ما؟

108
00:06:46,550 --> 00:06:47,800
كلا

109
00:06:48,190 --> 00:06:50,930
مضى وقتٌ طويل مذ رأيتك وحسب

110
00:06:50,930 --> 00:06:53,280
وقتٌ طويل؟ ليس تماماً

111
00:06:53,280 --> 00:06:56,120
لم نكمل شهراً مذ تقاعدنا

112
00:06:56,120 --> 00:06:57,570
إلى اللقاء

113
00:07:01,460 --> 00:07:03,020
أوقع أمرٌ ما مع أسوكا؟

114
00:07:03,760 --> 00:07:04,630
...أوقع

115
00:07:04,630 --> 00:07:05,750
كلا

116
00:07:07,520 --> 00:07:08,740
لم يقع شيء

117
00:07:11,680 --> 00:07:13,490
لقد عدت

118
00:07:18,540 --> 00:07:20,040
ماميكو أوماي

119
00:07:20,950 --> 00:07:22,210
أختي

120
00:07:52,930 --> 00:07:54,490
أوماي-سان

121
00:07:55,450 --> 00:07:56,370
أجل

122
00:07:56,800 --> 00:07:58,990
ظننتُها كانت أسوكا-سينباي

123
00:07:59,510 --> 00:08:02,030
أسوكا-سينباي؟

124
00:08:02,030 --> 00:08:04,460
كان عزفكِ كعزفها تماماً

125
00:08:12,540 --> 00:08:14,930
إلى أختي العزيزة

126
00:08:15,570 --> 00:08:20,350
أشعر ببعض الغرابة بتحدثّي معك بالمراسلة هكذا

127
00:08:22,740 --> 00:08:26,730
إنّه فبراير، والجوّ يبرد أكثر فأكثر

128
00:08:26,730 --> 00:08:29,480
لكن لم تتغير الأمور بالنسبة لي

129
00:08:29,480 --> 00:08:33,180
أؤدي حسناً في المدرسة، وأتمرّن يومياً

130
00:08:34,450 --> 00:08:39,220
يبدو أنّ أمّي قلقةٌ حول مستقبلي من الآن

131
00:08:40,020 --> 00:08:43,740
مُبارك

132
00:08:40,730 --> 00:08:43,270
لكنّي لا أزال أريد الذهاب للمسابقة الوطنية مجدداً

133
00:08:43,750 --> 00:08:46,000
حفلة تخرج

134
00:08:44,110 --> 00:08:45,490
أريد الفوز بالذهبي

135
00:08:46,290 --> 00:08:47,880
لا أريد أن أندم على شيء

136
00:08:48,330 --> 00:08:50,520
كما نبّهتِني عليه

137
00:08:52,720 --> 00:08:56,840
حسناً، دخول المتخرّجين

138
00:09:02,160 --> 00:09:04,700
يبدو كما لو أنّ وقتاً طويلاً قد مضى، صحيح؟

139
00:09:04,700 --> 00:09:07,440
رغم أنّها كانت بضعة أسابيع فقط

140
00:09:07,780 --> 00:09:10,020
!كاوري-سينباي

141
00:09:09,090 --> 00:09:10,020
كان ذلك سريعاً

142
00:10:44,370 --> 00:10:50,670
كلّ الوقتُ الذي أمضيناه معكم لا يُقدّر بثمنٍ لنا

143
00:10:51,280 --> 00:10:53,270
نأمل أن ننقل هذا لزملائنا الأصغر صفّاً

144
00:10:53,270 --> 00:10:56,670
ونواصل بناء فرقة حفلات ثانويّة كيتاؤجي الموسيقية

145
00:10:57,170 --> 00:10:59,550
...ثمّ سنفوز بالذهبي في المسابقة الوطنيـ

146
00:11:00,590 --> 00:11:01,840
...في الجزء المهم

147
00:11:01,840 --> 00:11:03,390
!اخرسي

148
00:11:03,390 --> 00:11:04,760
...حسناً

149
00:11:05,560 --> 00:11:08,500
إذاً، بذاك الإيمان

150
00:11:08,500 --> 00:11:12,270
نهدي هذا العزف للطلبة الخرّيجين

151
00:15:49,810 --> 00:15:51,560
شكراً لكم

152
00:16:03,820 --> 00:16:07,590
هل غادرت أسوكا-سينباي بالفعل؟

153
00:16:07,590 --> 00:16:08,720
لا أدري

154
00:16:08,720 --> 00:16:11,400
قالت أنّها ذاهبةٌ لغرفة الآلات

155
00:16:36,950 --> 00:16:41,270
مُلقي الخطاب: ممثلة الطلبة الخرّيجين، أسوكا تاناكا

156
00:16:41,270 --> 00:16:42,300
حاضر

157
00:16:46,560 --> 00:16:47,780
خطاب

158
00:16:47,780 --> 00:16:52,780
هناك دلالةٌ لدفء الربيع القادم في ضوء الشمس

159
00:16:56,590 --> 00:16:58,770
شكراً لك حضرة الأستاذ

160
00:16:59,520 --> 00:17:01,250
اعتنوا بأنفسكن يا سينباي

161
00:17:01,580 --> 00:17:02,910
أنتم أيضاً

162
00:17:02,910 --> 00:17:04,840
عليك التحلّي بسلوك الطالب الجامعي

163
00:17:04,840 --> 00:17:05,710
حاضر

164
00:17:07,000 --> 00:17:07,710
هاك

165
00:17:07,710 --> 00:17:08,380
أجل

166
00:17:08,790 --> 00:17:12,180
ماذا سأفعل دون سينباي؟

167
00:17:12,820 --> 00:17:14,170
أوقفي هذا

168
00:17:15,890 --> 00:17:17,890
سنأتي لمشاهدة الحفلات الاعتيادية وهكذا

169
00:17:19,590 --> 00:17:21,110
أنتِ الرئيسة

170
00:17:21,110 --> 00:17:22,450
عليكِ التماسك

171
00:17:23,880 --> 00:17:24,950
أوماي-سان

172
00:17:25,440 --> 00:17:27,900
هل رأيتِ أسوكا-سينباي؟

173
00:17:27,900 --> 00:17:29,560
كلا، أتساءل أين ذهبت

174
00:17:53,520 --> 00:17:55,630
انتباه أيّها التلامذة الجدد

175
00:17:55,630 --> 00:17:58,680
مرحباً بكم في ثانويّة كيتاؤجي

176
00:18:00,200 --> 00:18:03,890
...احتفالاً بمناسبة التحاقكم السعيدة

177
00:18:10,140 --> 00:18:12,910
عجباً، أوماي-تشان

178
00:18:13,800 --> 00:18:16,450
ما الذي تفعلينه هنا؟

179
00:18:19,460 --> 00:18:21,700
ما الذي تفعلينه أنتِ؟

180
00:18:21,700 --> 00:18:24,830
لا أجيد التعامل مع مثل هذه الحالات

181
00:18:25,730 --> 00:18:28,080
مُباركٌ تخرّجك

182
00:18:28,080 --> 00:18:31,970
أخبرتكِ، لا أطيق هذه الأمور

183
00:18:32,460 --> 00:18:34,870
بأيّ حال، ما الخطب؟

184
00:18:34,870 --> 00:18:37,900
هناك ما أودّ قوله لك

185
00:18:37,900 --> 00:18:39,090
لي؟

186
00:18:39,090 --> 00:18:40,970
أكنتِ تبحثين عني؟

187
00:18:40,970 --> 00:18:42,010
صحيح

188
00:18:42,010 --> 00:18:43,450
ماذا؟

189
00:18:43,450 --> 00:18:45,220
هل أنتِ بحاجةٍ لنصيحة علاقات؟

190
00:18:45,620 --> 00:18:46,850
أجل

191
00:18:49,930 --> 00:18:51,010
صدقاً؟

192
00:18:51,600 --> 00:18:55,530
لم أكن معجبةً بك

193
00:18:55,530 --> 00:18:57,870
كنتِ سينباي لي، ونعزف الجزء نفسه

194
00:18:57,870 --> 00:18:59,780
لذا حاولتُ عدم التفكير في الأمر

195
00:18:59,780 --> 00:19:02,700
لكنكِ بدوتِ معقّدةً جداً

196
00:19:03,250 --> 00:19:06,210
لعلّي كرهتك

197
00:19:09,770 --> 00:19:11,850
هذا ما أردتِ قوله لي؟

198
00:19:11,850 --> 00:19:13,210
أهو مضحكٌ لذاك الحد؟

199
00:19:13,210 --> 00:19:14,590
أجل

200
00:19:14,590 --> 00:19:17,920
فأنا كنتُ أعرف من البداية

201
00:19:17,920 --> 00:19:19,380
كلا

202
00:19:20,620 --> 00:19:23,850
لأنّي الآن، أحبّكِ كثيراً

203
00:19:28,140 --> 00:19:32,220
لا تظهرين مشاعركِ الحقيقية مطلقاً يا أسوكا-سينباي

204
00:19:32,220 --> 00:19:34,570
بدا عليكِ أنّكِ تنظرين بازدراءٍ نحو الآخرين دوماً

205
00:19:35,090 --> 00:19:38,070
تقولين أشياء كعدم اهتمامكِ بأصدقائك

206
00:19:38,620 --> 00:19:42,070
لكنّي الآن وحيدة

207
00:19:42,570 --> 00:19:46,580
أريد سماع عزفكِ لليوفونيم أكثر

208
00:19:47,300 --> 00:19:51,670
أريد أن أعزف مثلك

209
00:19:52,660 --> 00:19:54,670
أهذا ما أردتِ إخباري به؟

210
00:19:54,670 --> 00:19:56,050
أجل

211
00:20:01,050 --> 00:20:02,430
خذي هذا

212
00:20:05,020 --> 00:20:08,180
أليس يخصّ والدك؟

213
00:20:09,080 --> 00:20:12,000
لم أعد بحاجةٍ له

214
00:20:13,760 --> 00:20:18,900
حان دوركِ لعزف تلك المقطوعة لزملائكِ الأصغر صفّاً الآن

215
00:20:20,440 --> 00:20:23,280
لا أريد قول الوداع

216
00:20:25,910 --> 00:20:27,280
لن نودّع بعضنا إذاً

217
00:20:44,230 --> 00:20:45,290
إلى اللقاء

218
00:20:46,530 --> 00:20:47,550
أجل

219
00:21:18,660 --> 00:21:23,190
متى عزفت لي أسوكا-سينباي هذه المقطوعة لأوّل مرة؟

220
00:21:24,300 --> 00:21:28,710
لم أعرف عنوانها حتّى تلك اللحظة

221
00:21:35,110 --> 00:21:36,720
!كوميكو

222
00:21:39,140 --> 00:21:41,030
ها أنتِ

223
00:21:41,440 --> 00:21:43,650
لدينا تمارين أقسامٍ في الظهيرة

224
00:21:44,460 --> 00:21:46,660
آسفة، سآتي حالاً

225
00:21:48,820 --> 00:21:51,200
اصدح أيّها اليوفونيم

226
00:21:53,890 --> 00:21:58,800
لن أنسى دفء ذاك الصوت أبداً

227
00:22:03,940 --> 00:22:09,890
النهاية