219
00:14:15,880 --> 00:14:18,240
كيف تقولين ذلك؟

220
00:14:19,420 --> 00:14:21,260
وماذا إن فعلت ذلك؟

221
00:14:21,260 --> 00:14:24,090
ما الذي أعنيه أنا لك؟

222
00:14:25,970 --> 00:14:27,200
يوكو

223
00:14:27,810 --> 00:14:33,470
عاملتِني بلطفٍ لأنّكِ شعرتِ بالأسى لي

224
00:14:34,470 --> 00:14:35,930
أشفقتِ علي

225
00:14:42,730 --> 00:14:43,760
أيّتها الحمقاء

226
00:14:43,760 --> 00:14:46,110
أأنتِ غبيةٌ صدقاً؟

227
00:14:46,300 --> 00:14:47,030
يوكو

228
00:14:47,030 --> 00:14:49,580
سأفقد صبري في النهاية

229
00:14:49,580 --> 00:14:53,030
لمَ سأرافق شخصاً أكرهه؟

230
00:14:53,690 --> 00:14:56,410
أتظنّين أنّي لطيفةٌ هكذا؟

231
00:14:57,020 --> 00:14:58,210
شفقة؟

232
00:14:58,210 --> 00:14:59,170
ماذا؟

233
00:14:59,170 --> 00:15:00,340
سينباي

234
00:14:59,170 --> 00:15:02,950
ألا تريني كصديقة لك يا ميزوري؟

235
00:15:02,950 --> 00:15:03,820
كلا

236
00:15:05,220 --> 00:15:06,880
الأمر نفسه مع النادي

237
00:15:06,880 --> 00:15:10,880
أكنتِ تعزفين في الفرقة لأجل ميزوري فقط حقّاً؟

238
00:15:11,080 --> 00:15:15,850
تمرّنتِ بجدٍ وعملتِ لأجل المسابقة، ولم تحصلي على شيء؟

239
00:15:15,850 --> 00:15:20,360
انتصرنا في كيوتو ودخلنا مسابقة كانساي، ولستِ سعيدة؟

240
00:15:21,770 --> 00:15:23,860
أنا كنتُ مسرورة

241
00:15:23,860 --> 00:15:25,970
مسرورةٌ لأنّي عملتُ بجد

242
00:15:25,970 --> 00:15:27,740
لم تضع جهودي هباءً

243
00:15:28,290 --> 00:15:30,450
شعرتُ أنّي تحرّرت أخيراً من شيءٍ

244
00:15:30,450 --> 00:15:32,410
كان يقيّدني منذ المرحلة المتوسطة

245
00:15:32,930 --> 00:15:34,500
لستِ كذلك يا ميزوري؟

246
00:15:34,500 --> 00:15:37,290
ألم تشعري بشيء؟ أخبريني

247
00:15:39,080 --> 00:15:40,460
كنتُ مسرورة

248
00:15:40,460 --> 00:15:43,950
لكن

249
00:15:43,950 --> 00:15:48,420
شعرتُ بالذنب تّجاه من انسحبوا بالقدر ذاته

250
00:15:48,420 --> 00:15:51,590
لا أعرف إن كان يجدر بي السرور

251
00:15:51,590 --> 00:15:53,180
بالطبع يجدر بك

252
00:16:00,640 --> 00:16:02,440
بالطبع يجدر بك

253
00:16:03,770 --> 00:16:06,820
لذا ابتسمي

254
00:16:11,700 --> 00:16:13,960
لحظة، ميزوري

255
00:16:16,810 --> 00:16:18,410
لمَ تبكين؟

256
00:16:20,760 --> 00:16:22,050
ماذا ستفعلين؟

257
00:16:25,340 --> 00:16:26,540
سأكون بخير

258
00:16:30,920 --> 00:16:32,470
نوزومي-سينباي

259
00:16:33,820 --> 00:16:35,100
نوزومي

260
00:16:37,150 --> 00:16:38,600
عليكِ التحدث معها بشكلٍ لائق

261
00:16:53,250 --> 00:16:56,570
أخبرتني أسوكا-سينباي بأنّ عليّ إحضار هذا

262
00:16:57,630 --> 00:17:00,950
هل فعلتُ شيئاً ضايقك؟

263
00:17:02,210 --> 00:17:04,000
أنا حمقاء

264
00:17:04,540 --> 00:17:07,480
لا أتذكر فعلاً

265
00:17:09,160 --> 00:17:10,510
لمَ؟

266
00:17:12,780 --> 00:17:16,050
لمَ لم تخبريني؟

267
00:17:16,510 --> 00:17:19,810
عندما تركتِ الفرقة

268
00:17:21,310 --> 00:17:24,440
لأنّي لم أكن بحاجةٍ لذلك

269
00:17:27,410 --> 00:17:30,730
كنتِ تعملين بجد

270
00:17:31,300 --> 00:17:33,440
حتّى عندما كنتُ أشعر بالغضب

271
00:17:33,440 --> 00:17:37,700
حتّى بينما لا أحد يتمرن، كنتِ تتمرنين بمفردك

272
00:17:39,090 --> 00:17:43,760
كيف يُفترض بي أن أطلب منكِ الانسحاب معي؟

273
00:17:45,910 --> 00:17:47,610
لذلك السبب لم تخبريني؟

274
00:17:48,200 --> 00:17:49,040
أجل

275
00:17:51,930 --> 00:17:55,470
هل ظننتِ أنّي تخلّيت عنك؟

276
00:17:56,700 --> 00:17:58,600
ماذا؟ كلا

277
00:17:58,600 --> 00:17:59,910
كلا

278
00:17:59,910 --> 00:18:00,790
!الأمر ليس كذلك أبدًا

279
00:18:00,790 --> 00:18:02,300
...لم أقصد

280
00:18:03,050 --> 00:18:04,210
ميزوري

281
00:18:04,210 --> 00:18:05,080
آسفة

282
00:18:05,080 --> 00:18:06,260
أنا آسفة

283
00:18:06,750 --> 00:18:08,150
آسفة

284
00:18:08,150 --> 00:18:09,900
لمَ تعتذرين؟

285
00:18:10,460 --> 00:18:13,250
كنتُ أتجنّبكِ دائماً

286
00:18:13,900 --> 00:18:16,030
ارتكبتُ غلطة

287
00:18:16,450 --> 00:18:17,880
كنتُ خائفة

288
00:18:18,380 --> 00:18:19,810
آسفة

289
00:18:19,810 --> 00:18:20,880
ميزوري

290
00:18:20,880 --> 00:18:21,840
أنا آسفة

291
00:18:22,450 --> 00:18:23,690
ميزوري

292
00:18:25,170 --> 00:18:29,580
اسمعي، ذهبتُ لمشاهدة مسابقة كيوتو

293
00:18:30,450 --> 00:18:32,340
كنتم جميعاً لامعين

294
00:18:32,340 --> 00:18:34,000
شعرتُ بقشعريرة

295
00:18:35,000 --> 00:18:37,400
سمعتُ عزفكِ الفردي

296
00:18:38,430 --> 00:18:39,720
كنتُ رائعة

297
00:18:41,080 --> 00:18:42,650
حقّاً؟

298
00:18:42,650 --> 00:18:44,520
بالطبع

299
00:18:45,040 --> 00:18:50,630
لطالما أحببتُ عزفكِ للمزمار منذ المتوسطة

300
00:18:57,400 --> 00:19:01,410
!أشعر بحماس كبير بداخلي

301
00:19:01,410 --> 00:19:04,620
أريد سماع عزفكِ للمزمار يا ميزوري

302
00:19:09,000 --> 00:19:10,250
ميزوري

303
00:19:20,620 --> 00:19:23,090
أريدكِ أن تستمعي لعزفي أيضاً

304
00:19:32,970 --> 00:19:35,290
صوتٌ جميلٌ بحق

305
00:19:36,350 --> 00:19:38,290
لم أعلم

306
00:19:39,140 --> 00:19:41,760
أنّها قادرة على العزف هكذا

307
00:19:41,760 --> 00:19:44,530
كانت ميزوري تعزف لأجل نوزومي طوال ذاك الوقت إذاً

308
00:19:44,530 --> 00:19:45,740
ربما

309
00:19:47,120 --> 00:19:49,610
لا يمكنني منافسة نوزومي

310
00:19:49,610 --> 00:19:51,710
كنّا معاً لسنةٍ كاملة

311
00:19:52,350 --> 00:19:54,900
بالطبع لا يمكنك

312
00:19:54,900 --> 00:19:57,870
فـ نوزومي فتاةٌ صالحة أكثر منك بمئة مرة

313
00:19:57,870 --> 00:19:59,010
صحيح

314
00:19:59,010 --> 00:20:01,380
إنّها فتاةٌ صالحة أكثر منك بخمس مئة مرّة على الأرجح

315
00:20:01,750 --> 00:20:05,990
لكن، أظنّ ميزوري كانت محظوظةً بامتلاكها لك

316
00:20:09,120 --> 00:20:11,020
...هل يعقل أنّك

317
00:20:11,980 --> 00:20:14,060
تحاولين إبهاجي؟

318
00:20:14,060 --> 00:20:15,160
ماذا؟

319
00:20:15,160 --> 00:20:16,920
حسنٌ حسنٌ، لا تخجلي

320
00:20:16,920 --> 00:20:17,910
ما قصدك؟

321
00:20:17,910 --> 00:20:21,390
!يا إلهي، ناتسكي تعاملني بلطف

322
00:20:21,390 --> 00:20:23,950
!لا تتصرفي بغرابةٍ هكذا

323
00:20:24,820 --> 00:20:29,120
أردتُ إبعادها حتّى نهاية المسابقة

324
00:20:29,120 --> 00:20:30,000
أجل

325
00:20:30,000 --> 00:20:34,140
لكنّ ميزوري أنانيةٌ حقاً أيضاً، أليس كذلك؟

326
00:20:34,690 --> 00:20:35,710
ألا توافقينني؟

327
00:20:36,220 --> 00:20:39,040
في النهاية، كانت ميزوري-تشان مهووسةً بـ نوزومي-تشان

328
00:20:39,040 --> 00:20:41,610
لأنّها خشيت البقاء وحدها

329
00:20:41,610 --> 00:20:44,010
كانت يوكو-تشان ضمانها

330
00:20:44,010 --> 00:20:45,010
مُحال

331
00:20:45,010 --> 00:20:49,810
أظنّ الناس يتبعون حساباتهم
في طريقة معاملتهم

332
00:20:51,510 --> 00:20:55,610
أظنّكِ تأخذين الأمور بتشاؤمٍ كثيراً يا أسوكا-سينباي

333
00:20:56,360 --> 00:20:57,630
بتشاؤم؟

334
00:20:57,630 --> 00:20:58,870
ربما ذلك

335
00:20:59,320 --> 00:21:00,590
هذا جانباً

336
00:21:03,050 --> 00:21:04,030
تأخرتِ

337
00:21:04,030 --> 00:21:05,450
لنعد إذاً

338
00:21:05,910 --> 00:21:07,390
أجل

339
00:21:09,080 --> 00:21:10,040
أوماي-تشان

340
00:21:10,040 --> 00:21:11,160
أجل

341
00:21:12,160 --> 00:21:14,420
لنذهب للمسابقة الوطنية

342
00:21:15,200 --> 00:21:16,940
متى تكون صريحة؟

343
00:21:16,940 --> 00:21:18,790
متى تتظاهر؟

344
00:21:19,330 --> 00:21:22,100
من الصعب معرفة هذا دوماً

345
00:21:23,000 --> 00:21:26,510
كان من المخيف قليلاً التفكير

346
00:21:26,510 --> 00:21:30,070
بما تراه من منظورها

347
00:21:31,170 --> 00:21:34,250
أخبريني، أين ذهبتِ لتتّسخ هكذا؟

348
00:21:39,170 --> 00:21:40,900
رينا

349
00:21:41,740 --> 00:21:44,670
هل تعزفين لأجل شخصٍ ما أو ما شابه؟

350
00:21:45,520 --> 00:21:47,280
لم أفكر بهذا من قبل

351
00:21:49,370 --> 00:21:53,040
إن كان عليّ الاختيار، فأنا أعزف لنفسي

352
00:21:58,040 --> 00:22:00,720
رينا، أنتِ رينا بحق

353
00:22:00,720 --> 00:22:02,560
ما هذا؟ هل تحاولين إغاظتي؟

354
00:22:02,560 --> 00:22:03,270
مطلقاً

355
00:22:03,270 --> 00:22:05,760
وهكذا تبدأ المعزوفة التالية

356
00:22:03,920 --> 00:22:09,960
يُتبع