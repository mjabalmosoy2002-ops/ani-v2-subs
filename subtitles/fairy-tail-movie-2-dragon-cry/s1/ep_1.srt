1
00:01:48,630 --> 00:01:50,410
!كيف أصبحتُ هُنا؟

2
00:02:04,460 --> 00:02:07,710
!ماذا يحصل هُنا؟

3
00:02:19,560 --> 00:02:21,060
!تبّاً

4
00:02:21,120 --> 00:02:22,930
!لا أملك قوّة

5
00:02:26,310 --> 00:02:27,510
!ها هي هناك

6
00:02:50,990 --> 00:02:53,170
!أيّها الطّائر القذِر

7
00:03:08,060 --> 00:03:12,360
!هل تعرف حتّى من الذي تُوَاجهه؟

8
00:03:13,860 --> 00:03:15,040
...أنا

9
00:03:16,090 --> 00:03:17,860
...ساحِرٌ من...

10
00:03:18,120 --> 00:03:20,220
!فيري تيل...

11
00:03:50,280 --> 00:03:51,270
!من أنتُما؟

12
00:03:51,320 --> 00:03:54,190
!هذا مَعبدٌ تحت حماية مملَكة فيوري

13
00:03:54,640 --> 00:03:56,360
!لا تقتربا أكثر

14
00:03:56,380 --> 00:03:57,910
!ألا تسمعاني؟

15
00:03:58,320 --> 00:04:01,660
لا يُمكنني فِعل هذا، فتاةٌ ضعيفةٌ مثلها

16
00:04:01,680 --> 00:04:04,900
.يُمكنها حماية أعظم غُموضٍ في الإمبراطوريّة

17
00:04:09,050 --> 00:04:09,900
!أوه

18
00:04:09,900 --> 00:04:13,850
."كما هو مُتوَقّعٌ من كبرياء فيوري، وِحدةٌ خاصّةٌ من "النّمر الأبيض

19
00:04:14,720 --> 00:04:15,550
و؟

20
00:04:15,730 --> 00:04:18,950
من هو أقواكم؟

21
00:04:25,860 --> 00:04:27,590
هل هو أنتِ؟

22
00:04:27,930 --> 00:04:31,090
أنت؟ هل يُمكن أن تكون زاش الذي خان فيوري؟

23
00:04:31,340 --> 00:04:32,880
.القصّة القديمة

24
00:04:33,340 --> 00:04:34,980
.لَقد نسيتُها منذ زمنٍ بعيد

25
00:04:35,490 --> 00:04:38,730
مع ذلك، مثل أولئكَ الجّنود الأقوياء

26
00:04:39,280 --> 00:04:41,930
،يتمركزون في مثل هذه المنطقة البعيدة

27
00:04:41,950 --> 00:04:43,710
.هذا بالفِعل سوء حظّ

28
00:04:45,390 --> 00:04:48,500
لكن سوء الحظّ الحقيقيّ

29
00:04:54,820 --> 00:04:59,260
!هو أنّني بمُوَاجهتكم

30
00:05:09,830 --> 00:05:11,540
أيّتها القائدة، ماذا تفعلين؟

31
00:05:28,780 --> 00:05:31,920
!لماذا... تُقاتِلون بلا... داعٍ؟

32
00:05:56,890 --> 00:05:58,760
،بما أنّه يُمكنكَ السّيطرة على البَشر

33
00:05:58,920 --> 00:06:01,600
...لَم تكُن بحاجةٍ لجعلهم يُعانون

34
00:06:01,800 --> 00:06:03,650
.أكرهُهم

35
00:06:03,920 --> 00:06:07,450
.من يكونون معاً
.الرّفاق" أو مهما يُدعَون"

36
00:06:14,110 --> 00:06:18,350
سونيا ساما، هل يُمكنكِ تحديد مكان الصّولجان لأجلي؟

37
00:06:20,350 --> 00:06:24,570
زاش ساما، هل يُمكنكَ سماع نحيب الأرواح؟

38
00:06:25,020 --> 00:06:28,520
.لا أسمع شيئاً كهذا

39
00:06:43,030 --> 00:06:45,680
!ناتسو

40
00:06:45,770 --> 00:06:48,540
!ساعدني

41
00:06:49,360 --> 00:06:49,960
هاه؟

42
00:06:51,340 --> 00:06:53,340
!إ-إنّه كلب، ناتسو

43
00:06:53,580 --> 00:06:55,540
!إنّه ينظُر إلى هُنا

44
00:07:11,700 --> 00:07:13,600
!شُكراً لك، ناتسو

45
00:07:13,620 --> 00:07:15,980
!لَم أفعل شيئاً يُذكر

46
00:07:18,990 --> 00:07:22,520
!لا أظنّ هذا! كيف أمكنكَ أن تُزعج هذا الكلب الظّريف؟

47
00:07:22,540 --> 00:07:24,240
كيف أزعجتُه؟

48
00:07:24,260 --> 00:07:26,020
.حدّقتُ به فقط

49
00:07:26,060 --> 00:07:27,220
هاه؟

50
00:07:27,740 --> 00:07:29,940
هابي، ألا تُحبّ الكلاب؟

51
00:07:30,350 --> 00:07:32,710
.بلو كلبٌ أيضاً

52
00:07:34,920 --> 00:07:37,620
.لكن أُنظُري، لا يبدو ككلب

53
00:07:37,700 --> 00:07:40,510
ماذا هو في الوَاقع؟ حشرة؟

54
00:07:41,770 --> 00:07:44,690
لَو كان سمكة، لكان يُسرّب... ظرافة، صحيح؟

55
00:07:45,010 --> 00:07:46,580
!بلو رُوحٌ سماويّة

56
00:07:46,860 --> 00:07:49,810
.إضافةً إلى هذا، أنتَ تبدو ككلب

57
00:07:50,360 --> 00:07:51,810
هل عيناكِ بخير؟

58
00:07:55,940 --> 00:07:57,700
ما-ما الأمر؟

59
00:07:59,930 --> 00:08:02,390
...أنتَ قريبٌ جدّاً

60
00:08:02,700 --> 00:08:04,740
كيف أبدو؟

61
00:08:05,670 --> 00:08:07,610
.تبدو كناتسو، هذا وَاضح

62
00:08:10,050 --> 00:08:12,620
!...ناتسو سان! لوسي سان

63
00:08:13,860 --> 00:08:16,140
!أمازلتُ أرى جيّداً؟

64
00:08:16,160 --> 00:08:18,000
!كـ-كلّا! لا تفهمي الأمر بشكلٍ خاطئ، ويندي

65
00:08:18,310 --> 00:08:21,910
!غراي! ظهرَ كلبٌ مُرعبٌ جدّاً قبل قليل

66
00:08:21,950 --> 00:08:22,410
أوه، نعم؟

67
00:08:23,770 --> 00:08:26,080
:آيس ميك

68
00:08:27,360 --> 00:08:28,290
.عجلَة عربة

69
00:08:30,290 --> 00:08:32,620
.سيصمد حتّى نصل إلى العاصمة الملَكيّة

70
00:08:32,960 --> 00:08:34,180
.سيكون هذا جيّداً بما يكفي

71
00:08:34,520 --> 00:08:37,300
.أنتَ بالفِعل ساحِرٌ عظيم، غراي

72
00:08:41,280 --> 00:08:44,120
.لَم نذهب إلى العاصمة منذ مُدّةٍ طويلة

73
00:08:44,610 --> 00:08:45,320
.نعم

74
00:08:47,320 --> 00:08:51,150
!هذا مُملّ

75
00:08:51,360 --> 00:08:53,500
.أُدرسي، و ماذا لَو كان هذا مُملّاً

76
00:08:53,860 --> 00:08:56,170
.في وَقتنا الحاليّ، المَعرفة تعني القوّة

77
00:08:56,220 --> 00:08:58,770
!كيف؟ غارجيل، أنتَ تدرس؟

78
00:08:59,140 --> 00:09:01,660
ما الذي تقوله؟
!أنتَ تقرأ مُعجم القِطط

79
00:09:01,680 --> 00:09:04,110
!هذه أيضاً دراسةٌ مُهمّةٌ جدّاً

80
00:09:05,890 --> 00:09:06,770
!أوووه

81
00:09:06,770 --> 00:09:08,600
.ماذا يفعل غراي ساما

82
00:09:09,760 --> 00:09:10,660
.تفضّل

83
00:09:10,690 --> 00:09:11,810
!آاااه-
!آاااه-

84
00:09:11,830 --> 00:09:13,600
!مَذاقه لَذيذٌ جدّاً، لوسي

85
00:09:13,700 --> 00:09:14,430
!أوه

86
00:09:14,430 --> 00:09:16,460
هل يُمكنكَ أن تدعكَ ظهري رجاءً؟

87
00:09:16,480 --> 00:09:18,450
و الأمام أيضاً؟

88
00:09:19,510 --> 00:09:21,800
.أرجوكَ غنّي لي تهويدة

89
00:09:21,900 --> 00:09:23,130
...أيّتها الطّفلة المُدلّلة

90
00:09:24,230 --> 00:09:25,490
!لا تصنعي مثل هذه الضّوضاء

91
00:09:26,600 --> 00:09:27,670
!هاي، غارجيل

92
00:09:27,780 --> 00:09:28,300
هاه؟

93
00:09:29,020 --> 00:09:30,490
هل ترغب بشِراء شيءٍ ما؟

94
00:09:30,870 --> 00:09:33,600
.المكان بعيدٌ قليلاً، لكن الأسعار جيّدة

95
00:09:33,620 --> 00:09:35,870
!أنا لها! سآتي

96
00:09:35,890 --> 00:09:37,690
.سنُنظّف الدّور العُلويّ اليوم

97
00:09:37,720 --> 00:09:39,270
!أحضري لي شيئاً ما

98
00:09:39,350 --> 00:09:40,940
!جوفيا ستأتي

99
00:09:41,570 --> 00:09:46,180
.لأجعل غراي ساما يشعُر بالغيرة على قلبي

100
00:09:47,100 --> 00:09:52,340
.غاجيل كن، صدركَ القاسي و البارد رائعٌ بالفِعل

101
00:09:52,550 --> 00:09:54,510
.حسناً، إنّه من الحديد

102
00:09:55,400 --> 00:09:58,390
.ليلي! أنتَ بروعة حيوانٍ مَحشوّ

103
00:09:58,460 --> 00:10:00,980
.أفلِتيني، أو سأحرِق أصابعكِ

104
00:10:02,000 --> 00:10:05,750
.ليفي سان، أنتِ صغيرةٌ جدّاً و ظريفة

105
00:10:05,840 --> 00:10:08,200
.لا تفعلي، جوفيا

106
00:10:10,840 --> 00:10:13,380
...مُستحيل

107
00:10:19,300 --> 00:10:21,020
.مقبرة التّنانين

108
00:10:21,570 --> 00:10:25,430
،أظنّ بأنّ البعض قد رأوها بالفِعل خلال ألعاب السّحر العُظمى

109
00:10:25,730 --> 00:10:26,700
لكن تحت السّاحة

110
00:10:26,720 --> 00:10:30,030
.يُوجد مكانٌ ترتاح فيه عِظام التّنانين القديمة

111
00:10:31,010 --> 00:10:32,570
،هو مكان الرّاحة الأخير

112
00:10:32,900 --> 00:10:35,210
للتنّين الذي وَاجه في الماضي

113
00:10:35,350 --> 00:10:38,780
.التنّين الأسود أكنولوغيا الذي قاتلَه و هزمَه

114
00:10:39,400 --> 00:10:42,640
.فحص أسلافي مكان الرّاحة لعدّة مرّات

115
00:10:42,670 --> 00:10:46,220
.في النّهاية، قاموا ببناء السّاحة لإحياء ذِكرى التّنانين

116
00:10:47,180 --> 00:10:52,570
.قبل 100 عامٍ تقريباً، تمّ إيجاد صولجانٍ في قبر التّنانين

117
00:10:52,690 --> 00:10:53,510
صولجان؟

118
00:10:53,920 --> 00:10:56,800
هل كان عصىً للسّير لأحد التّنانين؟

119
00:10:57,080 --> 00:10:59,630
.كلّا، هو أداةٌ بَشريّة

120
00:11:00,430 --> 00:11:05,020
،إمتصّ هذا الصّولجان غضب و حُزن التّنانين

121
00:11:05,040 --> 00:11:07,070
و بسبب القوّة المُتراكمة

122
00:11:07,200 --> 00:11:10,350
.تشوّه عن شكله الأصليّ

123
00:11:11,140 --> 00:11:12,950
...إسم الصّولجان هو

124
00:11:12,970 --> 00:11:14,610
!دراغون كراي

125
00:11:14,900 --> 00:11:18,810
.يملك هذا الصّولجان القوّة لمَحو الإمبراطوريّة بالكامل

126
00:11:19,700 --> 00:11:24,590
.قبل بضعة أيّام، أخذ وَزير خارجيّة فيوري السّابق الصّولجان

127
00:11:24,630 --> 00:11:26,870
.قام زاش كاين بسرِقته

128
00:11:27,390 --> 00:11:30,490
.زاش من أتباع السّحر الأسود

129
00:11:30,660 --> 00:11:33,940
.خطّط بالسّرّ للإطاحة بالعائلة المالِكة، لكنّه فشل

130
00:11:33,980 --> 00:11:35,730
قبل أن يتمكّن الجّيش من القبض عليه

131
00:11:35,760 --> 00:11:39,520
.هربَ إلى خارج البلاد بمُساعدةٍ من رِفاقه

132
00:11:39,970 --> 00:11:46,150
لكن عندما تمّ نفيُه، لجأ إلى مملَكة ستيلا، و قام بقتل

133
00:11:47,540 --> 00:11:51,560
.جميع أتباعه كهديّةٍ لمملَكة ستيلا

134
00:11:52,730 --> 00:11:55,310
قتلَ رِفاقه؟

135
00:11:55,520 --> 00:12:02,070
بعد هجرَته، تسلّق سُلّم المراتب إلى مرتبة وَزيرٍ عبر
.قُدراته التّجسّسيّة و أفعاله الوَحشيّة

136
00:12:02,400 --> 00:12:03,920
!رجلٌ فظيع

137
00:12:05,200 --> 00:12:09,760
.هذا الرّجل الخطير يملك بحوزته أداةً خطيرة

138
00:12:10,300 --> 00:12:13,560
.أرجوكم استعيدوا الصّولجان قبل أن يرتكب به فِعلاً سيّئاً

139
00:12:13,790 --> 00:12:14,630
!بالتّأكيد

140
00:12:15,150 --> 00:12:17,830
أخبريني، أين مملَكة ستيلا؟

141
00:12:18,100 --> 00:12:20,440
.تقع في الجّنوب الشّرقيّ من إيشغار

142
00:12:20,590 --> 00:12:22,500
.يُحيط بها مُنحدرٌ صخريٌّ حادّ

143
00:12:22,530 --> 00:12:25,530
.إنّها جزيرةٌ مَعزولةٌ عن الدّول الأجنبيّة بالكامل

144
00:12:25,610 --> 00:12:27,040
!جـ-جزيرة؟

145
00:12:27,100 --> 00:12:29,480
هل يعني هذا بأنّها سنذهب إليها بالقارب؟

146
00:12:49,090 --> 00:12:53,020
.ما يدعم اقتصاد ستيلا هو مَعدنٌ أقسى من الألماس

147
00:12:53,540 --> 00:12:54,870
.الستيلانيوم

148
00:12:55,500 --> 00:12:59,870
.يعني هذا بأنّه يمتصّ بريق النّجوم،  و يسطع بإشراقٍ أكبر

149
00:13:00,500 --> 00:13:01,530
!هييه

150
00:13:01,630 --> 00:13:03,330
!كم هذا رومانسيّ

151
00:13:04,080 --> 00:13:08,170
.ستيلا هي أجمل جُزءٍ من القارّة

152
00:13:08,520 --> 00:13:11,030
!يُفترض أن يكون البَحر جميلاً جدّاً أيضاً

153
00:13:11,470 --> 00:13:14,640
.يُفترض أن تُوجد الكثير من الأطعمة اللّذيذة

154
00:13:15,640 --> 00:13:17,280
ألَم نصل بعد؟

155
00:13:28,830 --> 00:13:31,530
لماذا يجب عليّ فِعل هذا؟

156
00:13:31,900 --> 00:13:33,290
.لا تشتكي

157
00:13:33,610 --> 00:13:35,080
.إنّه يُناسبكِ

158
00:13:36,430 --> 00:13:39,130
يبدو بأنّ زاش يقوم بمُختلَف الوَاجبات

159
00:13:39,150 --> 00:13:41,240
.في بُرجٍ في القلعة

160
00:13:41,690 --> 00:13:44,370
.مِفتاح الخزينة هو خاتمه

161
00:13:44,760 --> 00:13:48,180
.مهما كان شرّيراً، هو وَزير دولة

162
00:13:48,610 --> 00:13:50,170
،إن أخذناه بالقوّة

163
00:13:50,190 --> 00:13:51,990
.سيحصل صراعٌ دوليّ

164
00:13:52,760 --> 00:13:55,000
لذا سنأخذ منه الخاتم

165
00:13:55,000 --> 00:13:57,060
!في هذه الحانة، التي يزورها في العادة

166
00:13:57,380 --> 00:13:58,800
!دون أن تتمّ مُلاحظتُنا

167
00:13:59,390 --> 00:14:01,960
.لوسي، إجذبي الإنتباه نحوكِ

168
00:14:01,960 --> 00:14:03,060
.عُلِم

169
00:14:03,420 --> 00:14:05,140
.سنبدأ عمليّتنا

170
00:14:35,170 --> 00:14:36,070
.جيميني

171
00:14:37,010 --> 00:14:38,050
!هوه

172
00:15:09,120 --> 00:15:10,580
.إصنع نُسخةً منه

173
00:15:10,660 --> 00:15:13,020
.ثانيةٌ ستكفي

174
00:15:20,400 --> 00:15:21,600
.سأُعيده

175
00:15:25,070 --> 00:15:26,860
.هابي، تشارل

176
00:15:27,240 --> 00:15:30,190
.سنأخذه إلى ناتسو و ويندي

177
00:15:30,220 --> 00:15:31,790
!أُترك الأمر لنا

178
00:15:32,040 --> 00:15:33,590
!لنذهب

179
00:15:33,980 --> 00:15:34,970
!أعتمد عليكما

180
00:15:41,270 --> 00:15:42,810
ما الخطب، ليلي؟

181
00:15:42,950 --> 00:15:46,190
.شعرتُ بأنّ هابي و تشارل كانا هُنا

182
00:15:46,310 --> 00:15:48,240
في مثل هذه الجّزيرة البعيدة؟

183
00:15:53,740 --> 00:15:55,860
ناتسو، ماذا تفعل؟

184
00:15:58,930 --> 00:16:01,050
كيف تعرّفتَ عليّ؟

185
00:16:01,050 --> 00:16:02,790
.ويندي وَاضحةٌ جدّاً أيضاً

186
00:16:05,110 --> 00:16:07,940
.أخبرتكَ بأنّهما سيكشِفانا، ناتسو

187
00:16:08,790 --> 00:16:10,930
!لنذهب على الفور

188
00:16:10,930 --> 00:16:12,560
!لنختبئ قبل أن يتمّ اكتشافنا

189
00:16:15,930 --> 00:16:17,290
.يُوجد حارسان

190
00:16:17,360 --> 00:16:18,690
!أُتركوا الأمر لي

191
00:16:21,160 --> 00:16:22,360
!أسرِعي

192
00:16:22,360 --> 00:16:23,100
!أعتذر

193
00:16:27,870 --> 00:16:28,940
!المكان آمن

194
00:16:30,270 --> 00:16:31,920
!إبحثي بسرعة

195
00:16:31,920 --> 00:16:32,520
.حسناً

196
00:16:38,180 --> 00:16:38,930
!ناتسو سان

197
00:16:39,390 --> 00:16:41,980
.أشعر بقوّةٍ سِحريّةٍ هائلةٍ من هذا الإتّجاه

198
00:16:45,110 --> 00:16:46,010
هاه؟

199
00:17:20,520 --> 00:17:21,620
...إذاً هذا هو

200
00:17:23,280 --> 00:17:24,690
.الدراغون كراي

201
00:17:46,070 --> 00:17:47,660
نـ- ناتسو؟

202
00:17:47,660 --> 00:17:48,510
هاه؟

203
00:17:50,820 --> 00:17:51,830
!ما هذا؟

204
00:17:52,480 --> 00:17:53,370
فخّ؟

205
00:17:53,480 --> 00:17:56,100
!دائرةٌ سِحريّةٌ تُفعّل عندما يُزال الصّولجان

206
00:17:56,330 --> 00:17:58,000
!تبّاً! لنُغادر

207
00:17:58,120 --> 00:17:58,760
!نعم

208
00:18:01,160 --> 00:18:02,360
!تمّت رُؤية أعداء

209
00:18:02,760 --> 00:18:05,130
!إقتحم اللّصوص الخزينة

210
00:18:05,420 --> 00:18:07,290
!إلى مَواقعكم القِتاليّة، أُقتلوهم جميعاً

211
00:18:07,690 --> 00:18:09,950
.إستخدموا المَدافع التي تعمل بالسّحر

212
00:18:11,050 --> 00:18:12,050
!!نار

213
00:18:18,990 --> 00:18:20,740
!لا يُمكننا البقاء في السّماء! لننزل إلى الأرض

214
00:18:22,000 --> 00:18:24,320
.أمم... أيّها الضّيف العزيز

215
00:18:24,460 --> 00:18:26,380
.لكنّكِ جميلة

216
00:18:26,430 --> 00:18:28,570
.أ-أنتَ تُحرجُني

217
00:18:28,660 --> 00:18:30,030
لماذا؟

218
00:18:31,620 --> 00:18:34,210
!سأجعلكِ زوجتي

219
00:18:34,610 --> 00:18:35,260
ما رأيكِ؟

220
00:18:36,290 --> 00:18:37,370
،أيّها الزّبون العزيز

221
00:18:37,470 --> 00:18:38,670
هيه؟

222
00:18:38,770 --> 00:18:42,560
هل يُمكنكَ رجاءً كبح نفسكَ عن إزعاج راقصات هذه الحانة؟

223
00:18:42,880 --> 00:18:43,840
ماذا؟

224
00:18:44,560 --> 00:18:46,490
!زاش ساما، الصّولجان

225
00:18:47,340 --> 00:18:49,120
!سُرِق الصّولجان

226
00:18:52,310 --> 00:18:55,410
!ناتسو الغبيّ، كُشِف أمره بسرعةٍ كبيرة

227
00:18:58,280 --> 00:19:00,070
من أنت؟

228
00:19:05,560 --> 00:19:08,070
.التّدخين مَحظورٌ في هذه الحانة

229
00:19:13,020 --> 00:19:15,180
.من هُنا. سنُغادر

230
00:19:15,390 --> 00:19:16,250
!إرزا

231
00:19:26,120 --> 00:19:28,090
رجالٌ من فيوري؟

232
00:19:28,210 --> 00:19:29,780
!!توَقّفوا

233
00:19:29,780 --> 00:19:32,440
!يا لوَقاحتهم! سأُفجّرهم جميعاً

234
00:19:32,650 --> 00:19:36,150
!لا يُمكنك! لَم يفعل الجّنود أيّ شيءٍ شرّير

235
00:19:37,300 --> 00:19:38,000
!آه

236
00:19:38,000 --> 00:19:38,800
!ويندي

237
00:19:39,880 --> 00:19:42,060
،جميع من آذوا رِفاقي

238
00:19:42,830 --> 00:19:44,210
!هُم أعدائي

239
00:19:45,950 --> 00:19:47,820
!ويندي، إعتني بالصّولجان

240
00:19:47,990 --> 00:19:48,550
!نعم

241
00:19:54,030 --> 00:19:55,890
ويندي، هل جُرحكِ بخير؟

242
00:19:55,980 --> 00:19:57,840
.كلّا، لَيس جُرحاً خطِراً

243
00:19:58,150 --> 00:19:59,680
.الأهمّ هو الصّولجان

244
00:19:59,710 --> 00:20:00,300
!من الأعلى

245
00:20:02,800 --> 00:20:03,510
!الصّولجان

246
00:20:03,620 --> 00:20:04,460
!هابي

247
00:20:20,190 --> 00:20:21,670
!ويندي، إلى هُنا

248
00:20:22,000 --> 00:20:22,900
!أمسكيه

249
00:20:36,590 --> 00:20:37,450
!غراي

250
00:20:37,450 --> 00:20:38,250
!نعم

251
00:20:43,950 --> 00:20:45,050
!أعتذر، أيّها الرّجال

252
00:21:05,910 --> 00:21:06,800
!لوسي

253
00:21:11,480 --> 00:21:13,930
!إفتحي، يا بوّابة العقرب

254
00:21:14,370 --> 00:21:15,370
!سكوربيو

255
00:21:15,670 --> 00:21:16,780
!ها أنا

256
00:21:17,180 --> 00:21:18,790
!ساند بستر

257
00:21:21,950 --> 00:21:22,800
!رائع

258
00:21:26,840 --> 00:21:27,550
!لوسي

259
00:21:28,210 --> 00:21:29,010
!إحذري

260
00:21:29,010 --> 00:21:29,800
هاه؟

261
00:21:30,440 --> 00:21:31,260
...سكوربيو

262
00:21:34,490 --> 00:21:36,740
كيف دخلتُم الخزينة؟

263
00:21:40,120 --> 00:21:44,660
.لا يُفترض أن يُفتح الباب من دون خاتمي

264
00:21:46,470 --> 00:21:49,740
.إستسلِمي، لَقد فُزت

265
00:21:50,620 --> 00:21:55,390
هل تعلَمين سبب تكليفي بحماية هذه الإمبراطوريّة؟

266
00:21:57,770 --> 00:22:02,840
!لأنّني أقوى رجلٍ في هذه المملَكة

267
00:22:05,570 --> 00:22:06,300
!ناتسو

268
00:22:19,840 --> 00:22:21,110
!ناتسو

269
00:22:30,860 --> 00:22:32,200
ما خطبهم؟

270
00:22:32,570 --> 00:22:33,860
!سأُهاجمهم دُفعةً وَاحدة

271
00:22:33,890 --> 00:22:37,360
!توَقّف! إنّهم مُوَاطنون عاديّون تمّ إجبارهم ليكونوا جُنوداً

272
00:22:37,520 --> 00:22:38,190
كيف؟

273
00:22:38,650 --> 00:22:39,770
!تتمّ السّيطرة عليهم

274
00:22:39,800 --> 00:22:41,130
!خِدعةٌ قذِرة

275
00:22:41,400 --> 00:22:43,460
.كُن فتىً جيّد و أعطِني الصّولجان

276
00:22:43,670 --> 00:22:45,270
!هو لَيس ملكك

277
00:22:45,530 --> 00:22:49,800
!لا تملك فيوري فكرةً عن مدى قوّته الحقيقيّة

278
00:22:53,760 --> 00:22:54,600
!تمسّكي

279
00:22:54,830 --> 00:22:55,880
!وَداعاً

280
00:22:55,880 --> 00:22:56,530
ماذا؟

281
00:23:09,510 --> 00:23:14,600
.يا له من حظٍّ سيءٍ بالنّسبة لك، بأن أكون عدوّك

282
00:23:17,640 --> 00:23:20,850
.زاش، يا له من خِزيٍ لا مثيل له

283
00:23:21,140 --> 00:23:22,960
،لا تقلَق، جلالتُك

284
00:23:23,480 --> 00:23:26,640
.بقوّة سونيا ساما، سنجد مكانهم

285
00:23:28,860 --> 00:23:30,850
.سونيا مِلكي

286
00:23:31,390 --> 00:23:36,030
.لَن أُعرّضها للخطَر بسبب شخصٍ غير كفُؤٍ مثلك

287
00:23:39,870 --> 00:23:42,930
.لكنّنا لا نملك الكثير من الوَقت

288
00:23:43,740 --> 00:23:46,660
.يجب أن نستخدِم قوّة سونيا

289
00:23:47,900 --> 00:23:50,100
!ستُرافقكَ النّجوم الثّلاثة

290
00:23:50,530 --> 00:23:51,170
!حسناً

291
00:23:51,420 --> 00:23:54,430
،إسمع! عندما تستخدِم قوّة سونيا

292
00:23:54,770 --> 00:23:56,800
.يجب أن تكون بأفضل حال

293
00:23:57,740 --> 00:24:00,640
.لا يجب أن تُصاب سونيا بالأذى مهما حصل

294
00:24:09,170 --> 00:24:10,170
.سونيا

295
00:24:11,070 --> 00:24:12,530
.الملِك أمينوس

296
00:24:12,660 --> 00:24:15,810
.عُدتّ إلى غُرفتي بالفِعل دون إصدار أيّ صوت

297
00:24:17,000 --> 00:24:19,020
.لَستُ سوى ساحِر

298
00:24:21,370 --> 00:24:23,820
.لَم يبقى لهذه الإمبراطوريّة المزيد من الوَقت

299
00:24:28,370 --> 00:24:31,710
.يجب أن يكون الدراغون كراي بحوزتي مهما كلّف الأمر

300
00:24:38,330 --> 00:24:40,000
.حصلنا على الصّولجان

301
00:24:40,810 --> 00:24:44,380
.لكن السّؤال هو كيف سنتمكّن من إعادته إلى فيوري

302
00:24:44,770 --> 00:24:48,470
.إكتشافهم أمرنا هو خطأ ناتسو

303
00:24:48,520 --> 00:24:52,070
!هذا لَم يكُن خطأي! كان يُوجد فخّ

304
00:24:52,520 --> 00:24:54,670
.لَم أُلاحظه

305
00:24:54,990 --> 00:24:55,820
.أعتذر بشدّة

306
00:24:56,290 --> 00:24:57,290
،على أيّة حال

307
00:24:57,760 --> 00:25:00,920
.يبدو بأنّ هذا الصّولجان يحمل قوّةً هائلة

308
00:25:00,950 --> 00:25:02,650
!أريني، أريني

309
00:25:04,560 --> 00:25:07,170
.لا أشعر بأيّ سِحرٍ على الإطلاق

310
00:25:07,450 --> 00:25:08,760
!توَقّف عن اللّعب به

311
00:25:10,330 --> 00:25:12,150
.لكن قبل هذا، ناتسو سان

312
00:25:12,820 --> 00:25:14,850
.ماذا؟ نعم

313
00:25:18,540 --> 00:25:21,370
!لا أفهم الأمر

314
00:25:22,090 --> 00:25:26,430
.بجميع الأحوال، صولجانٌ يُمكنه تدمير مملَكةٍ هو أداةٌ خطِرة

315
00:25:26,630 --> 00:25:28,760
.يجب أن نتعامل معه بحذَر

316
00:25:32,930 --> 00:25:36,480
هل أتيتُنّ أيّتها الفتاتان من خارج المملَكة؟

317
00:25:37,080 --> 00:25:38,120
.نعم

318
00:25:38,760 --> 00:25:41,010
الرّجل الذي هناك أيضاً؟

319
00:25:43,370 --> 00:25:45,580
!بيبي، هاي بيبي

320
00:25:45,610 --> 00:25:47,580
!أيّها الضّيف العزيز، أرجوكَ توَقّف

321
00:25:49,610 --> 00:25:51,110
ما الخطب، جوفيا؟

322
00:25:54,290 --> 00:25:58,780
.إذاً مُستشعِر غراي ساما خاصّتي مازال يعمل في هذه المدينة أيضاً

323
00:26:01,010 --> 00:26:03,170
ماذا يحصل، غراي سان؟

324
00:26:03,350 --> 00:26:05,870
!لا شيء، شعرتُ بالقشعريرة تجري في جسدي

325
00:26:06,040 --> 00:26:08,130
و هل تُوَبّخ المُثلّجات لشُعوركَ بالبَرد؟

326
00:26:09,420 --> 00:26:10,960
!لا ترتدي أيّة ملابس

327
00:26:10,960 --> 00:26:11,780
هواه؟

328
00:26:11,780 --> 00:26:12,780
!منذ متى؟

329
00:26:12,950 --> 00:26:15,850
.بالمُقارنة مع فيوري، نحن هُنا فوق مُستوى البَحر

330
00:26:16,340 --> 00:26:18,070
.هذا يجعل الحرارة أبرَد هُنا

331
00:26:19,490 --> 00:26:21,530
!بالمُناسبة، الهواء لَذيذ

332
00:26:21,530 --> 00:26:23,690
.أعتذر. تبرّزتُ للتّوّ

333
00:26:24,920 --> 00:26:30,200
.بما أنّه يُمكن رُؤية النّجوم من هُنا جيّداً، تُدعى مملَكة ستيلا بـ"أرض النّجوم" أيضاً

334
00:26:30,600 --> 00:26:32,600
هيييييييييييييه؟

335
00:26:34,250 --> 00:26:35,130
.كاذبة

336
00:26:35,380 --> 00:26:37,830
.إن كان الجوّ غائماً، لا يُمكن فِعل شيءٍ بشأن هذا

337
00:26:38,340 --> 00:26:44,080
.كساحِرةٍ نجميّة، أردتّ دائماً رُؤية نُجوم ستيلا المُتلألئة

338
00:26:45,990 --> 00:26:46,990
!أُسكتي

339
00:26:47,050 --> 00:26:48,180
.أحدهم قادم

340
00:26:48,220 --> 00:26:49,150
مُلاحقين؟

341
00:26:49,600 --> 00:26:50,960
كيف وَجدونا هُنا؟

342
00:26:51,420 --> 00:26:53,200
!إستعدّوا

343
00:26:55,820 --> 00:26:56,400
!من الأعلى؟

344
00:26:56,480 --> 00:26:59,290
!تذوّقوا ساقاي الجّميلتان

345
00:27:04,250 --> 00:27:06,330
!خُذي رَكلاتي المُذهلة

346
00:27:08,420 --> 00:27:09,730
!الستيلانيوم؟

347
00:27:12,860 --> 00:27:16,090
!إبدءا بالعمل. فرانسوا، و كاثرين

348
00:27:19,130 --> 00:27:19,730
!هذا حارّ

349
00:27:20,180 --> 00:27:22,800
!أحسنتُما، فرانسوا، و كاثرين

350
00:27:24,960 --> 00:27:26,310
!ما هؤلاء؟

351
00:27:34,540 --> 00:27:35,510
!بطيءٌ جدّاً

352
00:27:39,840 --> 00:27:41,550
!أسرَع! أسرَع

353
00:27:43,380 --> 00:27:44,760
!فرانسوا، أحسنتِ

354
00:27:47,640 --> 00:27:49,640
.كاثرين، أنتِ رائعةٌ أيضاً

355
00:27:52,770 --> 00:27:54,350
ما رأيكِ بساقاي الجّميلتان؟

356
00:27:59,140 --> 00:28:00,570
.حصلتُ على الصّولجان ثانيةً

357
00:28:02,920 --> 00:28:04,080
!وَغد

358
00:28:18,060 --> 00:28:18,760
!ناتسو

359
00:28:20,100 --> 00:28:22,230
إنتظر لَحظة، ناتسو، ماذا يحصل؟

360
00:28:23,130 --> 00:28:23,900
!ناتسو؟

361
00:28:27,340 --> 00:28:28,890
ما الخطب، ناتسو؟

362
00:28:34,380 --> 00:28:35,380
!تبّاً

363
00:28:42,260 --> 00:28:44,550
.أنتِ بطيئةٌ جدّاً

364
00:29:04,030 --> 00:29:05,990
!أحسنتُم، أيّها النّجوم الثّلاثة

365
00:29:06,600 --> 00:29:07,850
.إقضوا عليهم

366
00:29:07,870 --> 00:29:09,820
.إ-إنتظر

367
00:29:10,020 --> 00:29:11,980
.حصلنا على الصّولجان بالفِعل

368
00:29:12,310 --> 00:29:13,460
...سيكون قتلُهم

369
00:29:13,710 --> 00:29:18,560
.لكن سونيا ساما، هُم يتمرّدون على إمبراطوريّتنا

370
00:29:18,870 --> 00:29:22,640
.إن لَم نُعاقبهم، لَن نُقدّم لمُوَاطنينا مِثالاً جيّداً

371
00:29:23,670 --> 00:29:28,070
.أُريد تهدئة بكاء الأرواح

372
00:29:30,430 --> 00:29:34,520
.إن آذيتَ مَشاعر سونيا ساما، سيشتعل جلالته غضباً عليك

373
00:29:34,740 --> 00:29:36,000
.هذا صحيح

374
00:29:36,210 --> 00:29:39,840
.فرانسوا، و كاثرين، إنتهى عملكما

375
00:29:42,040 --> 00:29:44,430
!إذاً سيُحتجزون في عُشّ الطّائر

376
00:29:44,570 --> 00:29:45,340
!نعم، سيّدي

377
00:29:51,950 --> 00:29:54,220
.عدا هذه المرأة. هي مِلكي

378
00:30:09,160 --> 00:30:10,520
.أذكر الآن

379
00:30:18,110 --> 00:30:19,400
!كلّ هذا خطأي

380
00:30:20,240 --> 00:30:21,880
!يجب أن أُنقذ الآخرين

381
00:30:22,320 --> 00:30:24,600
!سُحقاً! أعتذر

382
00:30:30,040 --> 00:30:31,310
!لوسي لَيست هُنا

383
00:30:31,650 --> 00:30:32,960
!لَيست هُنا أيضاً

384
00:30:33,100 --> 00:30:35,310
لماذا لوسي لَيست هُنا؟

385
00:30:35,870 --> 00:30:36,930
...هل يُمكن

386
00:30:37,380 --> 00:30:38,130
...لوسي

387
00:30:39,520 --> 00:30:40,230
!ناتسو

388
00:30:40,330 --> 00:30:43,050
.أعلَم. سنجدها بالتّأكيد

389
00:30:43,730 --> 00:30:45,940
!إنتظرينا، لوسي

390
00:30:53,380 --> 00:30:54,380
!سونيا

391
00:30:55,690 --> 00:30:56,940
!الملِك أنيموس

392
00:30:57,450 --> 00:30:58,850
ماذا بشأن الصّولجان؟

393
00:30:59,460 --> 00:31:00,570
،زاش ساما

394
00:31:01,070 --> 00:31:04,110
.سيتحمّل مَسؤوليّته و يُؤمّن سلامته حتّى وَقت طُقوس الغد

395
00:31:04,290 --> 00:31:06,940
!لماذا لا يُحضره لي؟

396
00:31:08,020 --> 00:31:09,020
.جلالتُك

397
00:31:10,010 --> 00:31:15,710
.لَم يعُد لدينا وَقت
.أحضري لي الدراغون كراي

398
00:31:34,970 --> 00:31:36,770
أين أنا؟

399
00:31:39,530 --> 00:31:40,400
أشخاص؟

400
00:31:41,130 --> 00:31:42,410
.المِسكينة

401
00:31:42,640 --> 00:31:43,940
.وَاحدةٌ جديدة

402
00:31:48,760 --> 00:31:52,830
.مرحباً بكِ في الجّحيم على الأرض

403
00:31:53,640 --> 00:31:56,040
ما-ما تلك الإصابات؟

404
00:32:08,100 --> 00:32:10,340
أنت؟ ما مَعنى هذا؟

405
00:32:17,130 --> 00:32:18,350
.تعالي معي

406
00:32:19,490 --> 00:32:20,250
.نعم، سيّدي

407
00:32:26,570 --> 00:32:27,840
.قِفي هناك

408
00:32:28,410 --> 00:32:29,180
.حسناً

409
00:32:33,020 --> 00:32:33,800
.حسناً

410
00:32:38,180 --> 00:32:42,020
هل تعرفين ما سيحصل لكِ الآن؟

411
00:32:45,330 --> 00:32:47,080
.سآخذ دِمائكِ كلّ يوم

412
00:32:47,110 --> 00:32:50,590
.ستبقى لَديكِ نُدَب، لكن لا تقلَقي
.لَن أقتُلكِ

413
00:32:51,140 --> 00:32:55,180
.لأجل سِحري الأسود، أحتاج للكثير من الدّماء النّقيّة

414
00:32:56,240 --> 00:32:58,640
.أسعديني بصُراخكِ

415
00:33:01,690 --> 00:33:02,920
...نـ-نعم

416
00:33:16,110 --> 00:33:17,240
!زاش ساما

417
00:33:17,240 --> 00:33:17,940
همم؟

418
00:33:18,040 --> 00:33:20,050
!أعِد لنا لوسي

419
00:33:20,380 --> 00:33:21,150
!أه، ناتسو

420
00:33:22,780 --> 00:33:24,960
قـ-قاتِل تنانين؟

421
00:33:30,920 --> 00:33:31,980
هل أنتِ بخير؟

422
00:33:33,030 --> 00:33:33,790
!نعم

423
00:33:35,530 --> 00:33:36,960
!ناتسو، أسرِع

424
00:33:37,090 --> 00:33:38,990
!أصبح عدد الجّنود أكثر حتّى

425
00:33:39,100 --> 00:33:40,980
.لَقد بالَغنا على الأرجح

426
00:33:41,860 --> 00:33:45,020
!هربتُم من عُشّ الطّائر؟

427
00:33:45,280 --> 00:33:46,920
كيف وَصلتُم إلى هُنا؟

428
00:33:46,940 --> 00:33:48,340
.أملك أنفاً

429
00:33:48,840 --> 00:33:51,190
!رائحة رِفاقي شيءٌ ثمين

430
00:33:51,570 --> 00:33:53,440
!توَقّف، ناتسو

431
00:33:55,580 --> 00:33:57,410
!أيّها الوَغد

432
00:34:00,020 --> 00:34:02,220
...زاش ساما، أرجوكَ توَقّف! الـ

433
00:34:02,620 --> 00:34:06,520
.فليختفي كلّ من يُعارضني

434
00:34:06,840 --> 00:34:08,820
!أستدعي سِحر الحماية

435
00:34:14,340 --> 00:34:15,860
هل الجّميع بخير؟

436
00:34:15,860 --> 00:34:16,780
.نعم

437
00:34:16,890 --> 00:34:18,020
.نوعاً ما

438
00:34:18,310 --> 00:34:20,830
.شُكراً لإسراعكم لإنقاذي

439
00:34:21,010 --> 00:34:23,560
.في الوَاقع، هذا خطأ ناتسو

440
00:34:23,560 --> 00:34:24,560
!كيف...؟

441
00:34:24,710 --> 00:34:26,320
من تلك؟

442
00:34:28,160 --> 00:34:28,990
!أوه

443
00:34:28,990 --> 00:34:30,290
!الآن بذكركِ للأمر

444
00:34:30,330 --> 00:34:31,330
من أنتِ؟

445
00:34:31,980 --> 00:34:33,410
...أ-أنا

446
00:34:33,480 --> 00:34:35,800
!أين أنتُم، أيّها اللّصوص البائسون؟

447
00:34:38,920 --> 00:34:41,390
.يُوجد هُنا مَمرٌّ سرّيّ، تعالوا معي

448
00:34:41,520 --> 00:34:43,260
!يجب أن نستعيد الصّولجان

449
00:34:43,490 --> 00:34:45,040
.يجب أن ننسحب للآن

450
00:34:45,300 --> 00:34:49,230
!إن لَم نتمكّن من إيجاد نُقطة ضعف سِحره، لا يُمكننا الفوز عليه

451
00:35:00,870 --> 00:35:01,810
.من هُنا

452
00:35:03,340 --> 00:35:05,420
هل تعرفين مكان الآخرين؟

453
00:35:05,670 --> 00:35:07,760
.هذا سِحري

454
00:35:07,830 --> 00:35:10,730
.إذاً لهذا مكاننا مَجهول

455
00:35:17,570 --> 00:35:19,690
.من هُنا، يُفترض أن تكونوا بأمان

456
00:35:19,860 --> 00:35:21,120
.شُكراً لكِ

457
00:35:21,190 --> 00:35:23,000
من أنتِ؟

458
00:35:23,400 --> 00:35:26,870
.أنا سونيا، مُقرّبةٌ من الملِك أنيموس

459
00:35:27,650 --> 00:35:30,520
و لماذا ساعدتّنا على الهرَب؟

460
00:35:32,260 --> 00:35:34,170
.لابدّ من وُجود سببٍ لهذا

461
00:35:36,270 --> 00:35:41,100
.لا أُريد أن يُوَاجه الآخرون المُعاناة بعد الآن

462
00:35:45,340 --> 00:35:49,840
.كنتُ صديقةً للملِك أنيموس منذ طُفولَتي

463
00:35:50,670 --> 00:35:52,600
.كان طيّب القلب

464
00:35:53,260 --> 00:35:57,210
،لكن منذ أن أحضر له زاش ساما الدراغون كراي

465
00:35:58,090 --> 00:36:00,560
.أصبح مهووساً بصولجانكم

466
00:36:01,900 --> 00:36:06,460
.شاركتُ أيضاً في السّرِقة لأجل إصلاح المملَكة

467
00:36:06,870 --> 00:36:08,380
لأجل الإصلاح؟

468
00:36:09,760 --> 00:36:11,930
هل تعرفون ما هو السيتلانيوم؟

469
00:36:12,310 --> 00:36:14,480
مَعدنٌ من هذه المَنطقة، صحيح؟

470
00:36:15,670 --> 00:36:23,190
كلّما ازداد امتصاص الستيلانيوم لبريق النّجوم، كلّما ازداد سُطوعاً
.و أصبح جوهرةً نفيسةً أكثر

471
00:36:24,080 --> 00:36:28,640
.مع ذلك، كان الستيلانيوم يصرُخ منذ عدّة أعوام

472
00:36:28,760 --> 00:36:29,580
!كيف؟

473
00:36:29,860 --> 00:36:37,530
من المُرجّح بأنّ الستيلانيوم يمتصّ الكثير من بريق النّجوم، و
.هذه الكمّيّة تجعله غير مُستقرٍّ أحياناً

474
00:36:38,410 --> 00:36:40,740
ماذا يعني هذا؟

475
00:36:41,250 --> 00:36:46,410
.الستيلانيوم الذي امتصّ كمّيّةً مُحدّدةً من بريق النّجوم، يملك قوّةً سِحريّة

476
00:36:47,470 --> 00:36:50,200
،عندما تتحرّر تلك القوّة دُفعةً وَاحدة

477
00:36:51,510 --> 00:36:54,760
.ستُدمّر هذه المملَكة بالكامل

478
00:36:55,660 --> 00:37:00,530
.لمنع هذه الكارثة، نحتاج لقوّة الدراغون كراي

479
00:37:02,660 --> 00:37:05,260
،نُريد استخدام الدراغون كراي

480
00:37:05,260 --> 00:37:07,450
.الذي يُقال أنّ بإمكانه التّأثير على أيّ بريق

481
00:37:07,620 --> 00:37:11,750
مَساء الغد، سنعقد طُقوساً في المَعبد، في الشّمال الغربيّ من المدينة

482
00:37:11,760 --> 00:37:13,860
.للتّخلّص من النّور

483
00:37:14,420 --> 00:37:16,500
...إن قام هو بتنفيذ هذا، هذه المملَكة

484
00:37:17,060 --> 00:37:19,680
.حتّى لَو اختفى الستيلانيوم

485
00:37:20,210 --> 00:37:23,150
.هذه هي الطّريقة الوَحيدة لإنقاذ إمبراطوريّتنا

486
00:37:24,490 --> 00:37:28,370
!لهذا، لا يُمكننا إعادة الصّولجان

487
00:37:28,370 --> 00:37:32,110
.لكن هذا الصّولجان من مُمتلكات مملَكتنا بالأساس

488
00:37:32,500 --> 00:37:34,330
...حتّى لَو كان الحال هكذا

489
00:37:35,210 --> 00:37:39,320
.يُمكنني فقط الإعتماد على قوّة الصّولجان الذي يُمكنه إنقاذ إمبراطوريّتنا

490
00:37:39,340 --> 00:37:41,260
!هذا لا ينفع مع هذا الصّولجان

491
00:37:41,260 --> 00:37:41,830
هاه؟

492
00:37:42,730 --> 00:37:45,850
،عندما حملتُه بين يَداي، شعرتُ بغضب

493
00:37:46,050 --> 00:37:48,900
.و ألَم، و مُعاناة التّنانين

494
00:37:49,540 --> 00:37:52,670
!القوّة السّحريّة لهذا الصّولجان يجب ألّا تتحرّر

495
00:37:53,070 --> 00:37:55,640
هل تعني بأنّ هذه الإمبراطوريّة ستهلك؟

496
00:37:55,880 --> 00:37:57,220
!سآخذه بالقوّة إن اضطّررت

497
00:37:58,970 --> 00:38:02,380
!سأُخبر المملَكة بأكملها

498
00:38:02,920 --> 00:38:04,560
!أعيدوا لنا الصّولجان

499
00:38:05,400 --> 00:38:08,270
.هذا مُستحيل

500
00:38:15,770 --> 00:38:19,330
.أخبرتكَ بأنّه يجب عليكَ عدم تعريض سونيا للخطَر

501
00:38:20,060 --> 00:38:24,180
!إستخدامكَ للصّولجان و تفجيرهم بعيداً مع الأعداء

502
00:38:24,450 --> 00:38:26,380
...يُؤلِمُني قلبي

503
00:38:26,950 --> 00:38:29,070
...فقدتّ رباطة جأشي

504
00:38:31,320 --> 00:38:33,700
.غداً ستُعقد المراسم المُهمّة

505
00:38:34,060 --> 00:38:35,800
.سيأتون بالتّأكيد

506
00:38:36,240 --> 00:38:37,770
.أُقتُلهم وَقتها

507
00:38:38,160 --> 00:38:39,410
.و افعلها بشكلٍ صحيحٍ هذه المرّة

508
00:38:39,860 --> 00:38:40,780
.نعم، سيّدي

509
00:38:46,210 --> 00:38:47,630
.سأقتُلهم

510
00:38:48,270 --> 00:38:50,310
.و بعدها سأقتُلكَ أيضاً

511
00:38:52,830 --> 00:38:54,830
!المكان جميلٌ هُنا

512
00:38:55,370 --> 00:38:57,880
ما الذي ينمو على الأشجار؟

513
00:38:57,900 --> 00:38:59,310
!لا يجب أن تأكُلها

514
00:38:59,730 --> 00:39:01,700
.سنُخيّم هُنا اليوم

515
00:39:01,790 --> 00:39:04,130
.لنأمل ألّا يهاجمونا ثانيةً

516
00:39:04,210 --> 00:39:05,910
.لنتناوَب بالحراسة

517
00:39:05,920 --> 00:39:07,800
.نعم، هذه فِكرةٌ جيّدة

518
00:39:07,810 --> 00:39:09,310
.أوّلاً، سيكون دوري

519
00:39:09,360 --> 00:39:10,630
!ستنام؟

520
00:39:12,770 --> 00:39:17,700
.إذاً يرغبون باستخدام الدراغون كراي للتّخلّص من سُطوع الستيلانيوم

521
00:39:18,310 --> 00:39:21,020
هل هذا مُمكنٌ حقّاً؟

522
00:39:21,130 --> 00:39:22,530
،حتّى لَو نجحوا بهذا

523
00:39:22,800 --> 00:39:25,060
.سينهار اقتصاد هذه الإمبراطوريّة

524
00:39:25,480 --> 00:39:29,770
.بكِلتا الحالَتين، لا يُمكنهم استخدام قوّة هذا الصّولجان السّحريّة

525
00:39:30,170 --> 00:39:30,920
.نعم

526
00:39:31,180 --> 00:39:34,160
.قالَت بأنّهم سيعقدون طُقوساً في الغد

527
00:39:34,780 --> 00:39:37,000
.يجب أن نستعيد الصّولجان قبل هذا

528
00:39:37,120 --> 00:39:38,960
.سأبذل جهدي

529
00:39:38,990 --> 00:39:41,310
!هاي، أنت، ماذا تأكل؟

530
00:39:53,260 --> 00:39:56,110
ما الخطب، لوسي؟
ألا يُمكنكِ الخُلود إلى النّوم؟

531
00:39:56,250 --> 00:39:59,600
.حسناً، لَيس دوري بالحراسة الآن

532
00:39:59,860 --> 00:40:02,040
.لكنّكِ تُفكّرين بالأمر

533
00:40:05,160 --> 00:40:09,190
،إن كنتَ تعلَم بأنّ مُهمّتنا هي باستعادة الصّولجان

534
00:40:09,870 --> 00:40:13,100
.لكن هذه المملَكة ستختفي على الأرجح

535
00:40:16,290 --> 00:40:17,480
.إصعدي إلى هُنا

536
00:40:17,880 --> 00:40:19,400
!كلّا، أرتدي تنّورة

537
00:40:19,670 --> 00:40:21,250
!هيّا تعالي

538
00:40:21,610 --> 00:40:23,750
يا إلهي، ماذا تُريد؟

539
00:40:26,420 --> 00:40:28,780
إنتظر لَحظة! كم بقيَ لأصل؟

540
00:40:31,600 --> 00:40:33,720
.هيّا. سأُساعدكِ

541
00:40:44,240 --> 00:40:45,400
!هوااااه

542
00:40:46,140 --> 00:40:47,600
!نُجوم ستيلا

543
00:40:49,280 --> 00:40:50,520
!هذا جميل

544
00:40:52,140 --> 00:40:54,000
.أردتّ رُؤيتها

545
00:40:57,900 --> 00:41:01,880
!لذا لا تسمحي لرأسكِ بالإنحناء

546
00:41:03,910 --> 00:41:04,710
!نعم

547
00:41:16,630 --> 00:41:19,800
ما هذا؟
.يُوجد العديد من الجّنود اليوم

548
00:41:19,830 --> 00:41:20,530
.بالفِعل

549
00:41:20,830 --> 00:41:22,440
هل حصل شيءٌ ما؟

550
00:41:22,530 --> 00:41:25,400
.يبدون مُوَقّرين مثل غراي ساما

551
00:41:25,440 --> 00:41:27,300
!هاي، ذلك الشّعار

552
00:41:27,580 --> 00:41:30,150
!ها هُم هناك، فيري تيل

553
00:41:30,360 --> 00:41:30,880
ماذا؟

554
00:41:30,920 --> 00:41:34,290
ماذا، ماذا؟
ماذا فعلنا؟

555
00:41:34,320 --> 00:41:35,370
ماذا يعني هذا؟

556
00:41:35,390 --> 00:41:37,260
.هذا يعني المتاعب

557
00:41:37,270 --> 00:41:38,260
.بالفِعل

558
00:41:38,970 --> 00:41:40,150
!إقضوا عليهم

559
00:41:40,390 --> 00:41:42,890
.دعوني أقع بالمتاعب

560
00:41:42,920 --> 00:41:44,350
!هاجموني

561
00:41:45,110 --> 00:41:47,070
!سأقوم بتحرّي الوَضع

562
00:41:49,960 --> 00:41:52,130
.يبدو بأنّ شيئاً ما يحصل في الجّهة الأُخرى

563
00:41:52,220 --> 00:41:53,600
!سأُلقي نظرَةً سريعة

564
00:41:53,630 --> 00:41:55,020
!أرجوكَ اعتني بنفسك

565
00:41:55,480 --> 00:41:57,680
.يبدو بأنّهم كانوا مُستعدّين لقُدومنا

566
00:42:03,580 --> 00:42:05,890
!أُتركوا الأمر لي
!إذهبوا إلى المَعبد

567
00:42:06,020 --> 00:42:06,890
!حسناً

568
00:42:07,040 --> 00:42:08,000
!لنذهب

569
00:42:08,000 --> 00:42:09,080
!نعم، سيّدي

570
00:42:09,320 --> 00:42:11,510
!هابي، لماذا لَونكَ أحمر؟

571
00:42:12,080 --> 00:42:12,840
هاه؟

572
00:42:13,760 --> 00:42:16,420
هل هذا بسبب الفاكهة التي أكلتُها البارحة؟

573
00:42:28,370 --> 00:42:31,390
.كنتُ بانتظاركِ، أيّتها الشّقيّة ذات الشّعر الأحمر

574
00:42:31,730 --> 00:42:32,790
!صاحبة السّاقين

575
00:42:32,790 --> 00:42:33,660
،كلّا

576
00:42:34,560 --> 00:42:36,350
.صاحبة السّاقين الجّميلتين

577
00:42:57,690 --> 00:42:58,950
!غراي ساما

578
00:42:59,050 --> 00:43:00,250
!جوفيا؟

579
00:43:00,410 --> 00:43:01,860
!ما... ماذا تفعلين هُنا؟

580
00:43:02,310 --> 00:43:06,610
!مُستشعِر غراي ساما خاصّتي لَم يُخطئ

581
00:43:07,190 --> 00:43:10,350
هل يُمكن أنّكَ تملك مُستشعِر جوفيا؟

582
00:43:10,510 --> 00:43:11,630
كيف لي أن أعلَم؟

583
00:43:19,670 --> 00:43:21,150
،فرانسوا، و كاثرين

584
00:43:22,720 --> 00:43:23,980
!هناك عملٌ للقيام به

585
00:43:24,470 --> 00:43:26,990
ما سبب هذه الجّلَبَة؟

586
00:43:27,190 --> 00:43:29,030
.حسناً، حصل الكثير

587
00:43:29,470 --> 00:43:30,630
.ساعديني أوّلاً

588
00:43:31,020 --> 00:43:31,890
!بسرور

589
00:43:45,830 --> 00:43:46,830
!بطيئون جدّاً

590
00:43:49,730 --> 00:43:51,250
.سأُوقِفه

591
00:43:51,560 --> 00:43:52,520
!إسبقونا

592
00:43:52,770 --> 00:43:54,070
!كارلا، أنتِ أيضاً؟

593
00:44:16,370 --> 00:44:17,970
!أنا أقوى منك

594
00:44:19,960 --> 00:44:22,120
!سنترُكه لكما، ويندي، و كارلا

595
00:44:23,200 --> 00:44:24,370
...لكنّني

596
00:44:25,130 --> 00:44:26,760
!لا يُمكنكم الهرَب

597
00:44:36,870 --> 00:44:37,600
!ماذا؟

598
00:44:43,210 --> 00:44:44,550
.كان هذا وَشيكاً

599
00:44:45,490 --> 00:44:49,450
.سأُحرّر الفتيات من قبو القلعة بسرعة

600
00:44:49,740 --> 00:44:51,340
هل يُمكنكِ فِعل هذا لوَحدك؟

601
00:44:52,020 --> 00:44:53,290
.لَستُ لوَحدي

602
00:44:54,450 --> 00:44:56,190
!أرواحي السّماويّة إلى جانبي

603
00:44:58,650 --> 00:45:01,390
!هابي، سنُوقِف الطّقوس

604
00:45:01,940 --> 00:45:03,180
!نعم، سيّدي

605
00:45:10,340 --> 00:45:13,390
،عندما حملتُه بين يَداي، شعرتُ بغضب

606
00:45:13,580 --> 00:45:16,150
.و ألَم، و مُعاناة التّنانين

607
00:45:16,910 --> 00:45:19,820
!القوّة السّحريّة لهذا الصّولجان يجب ألّا تتحرّر

608
00:45:33,270 --> 00:45:34,260
.سونيا

609
00:45:37,570 --> 00:45:38,940
!الملِك أنيموس

610
00:45:39,730 --> 00:45:42,730
.هيّا، أعطِني الدراغون كراي

611
00:45:44,300 --> 00:45:46,740
.هذه القوّة تُغرِق البَشر في المِحَن

612
00:45:48,250 --> 00:45:49,850
.لا يُمكنني إعطاوكَ الصّولجان

613
00:45:51,080 --> 00:45:53,610
!جميعكنّ، أُهربنَ بينما مازال لَديكنّ وَقت

614
00:45:53,900 --> 00:45:55,730
!أسرِعن، قبل أن يأتي

615
00:45:56,080 --> 00:45:58,810
...شُكراً جزيلاً... لكِ

616
00:46:02,000 --> 00:46:02,860
!أسرِعن

617
00:46:02,960 --> 00:46:04,510
!أين الصّولجان؟

618
00:46:04,510 --> 00:46:06,600
!عاد زاش ساما

619
00:46:07,270 --> 00:46:08,110
!كلّا

620
00:46:08,300 --> 00:46:10,240
!ماذا تفعلين هُنا؟

621
00:46:10,760 --> 00:46:12,090
!جميعكنّ، غادرنَ بسرعة

622
00:46:12,380 --> 00:46:13,880
!لا تلعبي الألعاب

623
00:46:14,990 --> 00:46:17,250
!إفتحي، يا بوّابة الجّدي

624
00:46:23,720 --> 00:46:24,910
!كابريكورن

625
00:46:26,740 --> 00:46:29,920
!عنزة؟ هل تمزحين معي؟

626
00:46:57,750 --> 00:47:01,830
.يبدو بأنّ سِحركَ لا يعمل عند تغطية العينين

627
00:47:02,230 --> 00:47:03,740
.مُمتاز، لوسي سان

628
00:47:04,710 --> 00:47:06,550
.أثرتِ إعجابي

629
00:47:11,220 --> 00:47:13,220
!الآن! أسرِعنَ إلى المَخرَج

630
00:47:16,900 --> 00:47:19,600
.سأُساعدكنّ بالهرَب

631
00:47:22,190 --> 00:47:24,980
.الآن لَيس الوَقت المُناسب لهذا

632
00:47:25,300 --> 00:47:27,140
!ريد نايف، إنطلِق

633
00:47:34,770 --> 00:47:36,070
.بما أنّني كنتُ سيّء الحظّ

634
00:47:37,890 --> 00:47:39,200
إلى أين يذهب؟

635
00:47:39,410 --> 00:47:40,550
.لنتبعه

636
00:48:41,340 --> 00:48:42,070
!ماذا؟

637
00:48:50,980 --> 00:48:53,770
.فرانسوا، و كاثرين

638
00:49:02,400 --> 00:49:04,860
!لا يُؤثّر بي الجّليد

639
00:49:06,730 --> 00:49:08,980
!الوَغد، إنّه يُدمّر مَدينته

640
00:49:10,230 --> 00:49:10,980
!إحذري

641
00:49:14,350 --> 00:49:15,260
!جوفيا

642
00:49:23,160 --> 00:49:24,850
!هاه، أوني تشان

643
00:49:28,220 --> 00:49:30,980
.عملٌ جيّد، كاثرين

644
00:49:49,950 --> 00:49:51,530
.إصابةٌ جيّدة

645
00:49:52,250 --> 00:49:55,350
!و هذا مع استخدامنا لتعويذة السّرعة

646
00:49:55,640 --> 00:49:57,030
.إنّه سريعٌ جدّاً بالنّسبة لنا

647
00:50:13,700 --> 00:50:16,350
!أُنظُروا إلى هذا! يُمكنني رُؤيتكنّ

648
00:50:20,600 --> 00:50:22,790
.ويندي، خطرَت ببالي فِكرةٌ جيّدة

649
00:50:22,920 --> 00:50:23,700
ماذا؟

650
00:50:26,350 --> 00:50:29,070
!سنتنهي حياتكنّ عبر هذا في النّهاية

651
00:50:33,550 --> 00:50:35,890
!كارلا، سيصل إلينا

652
00:50:36,240 --> 00:50:38,540
!لنُنسّق تنفّسنا

653
00:50:38,810 --> 00:50:39,440
!نعم

654
00:50:40,790 --> 00:50:42,590
...وَاحد، إثنان

655
00:50:44,380 --> 00:50:45,010
.ثلاثة...

656
00:51:02,240 --> 00:51:03,650
!إنّها النّهاية

657
00:51:09,780 --> 00:51:10,880
!هذا غير مُمكن

658
00:51:11,400 --> 00:51:16,310
!جليدٌ لا يُمكن لحرارة فرانسوا و كاثرين إذابته؟

659
00:51:17,450 --> 00:51:19,510
.هذا جليد مُعوّذ

660
00:51:20,500 --> 00:51:22,030
.هذا مِثاليّ

661
00:51:22,660 --> 00:51:26,100
.يبدو بأنّ دُميتاكَ مَلعونتان أيضاً

662
00:51:27,640 --> 00:51:31,180
هل تسخر من طِفلتاي؟

663
00:51:31,880 --> 00:51:33,900
!فرانسوا، و كاثرين

664
00:52:01,350 --> 00:52:03,700
!غـ-غراي ساما

665
00:52:11,050 --> 00:52:14,540
!خُصومٌ من الإناث

666
00:52:15,840 --> 00:52:18,220
!فلتصِلي إليه! يا أجنحة الحُبّ

667
00:52:18,440 --> 00:52:19,480
!غراي ساما

668
00:52:19,480 --> 00:52:21,070
!الحُبّ الأقصى

669
00:52:31,740 --> 00:52:32,600
!هذا جميل

670
00:52:34,890 --> 00:52:37,020
...فرانسوا، و كاثرين

671
00:52:59,540 --> 00:53:01,620
جوفيا، هل أنتِ بخير؟

672
00:53:02,100 --> 00:53:04,080
...نعم، غراي

673
00:53:06,720 --> 00:53:07,790
...سا

674
00:53:56,970 --> 00:53:58,320
!غراند فويتي

675
00:54:23,110 --> 00:54:25,310
مُستحيل! متى فعلتِ هذا؟

676
00:54:25,680 --> 00:54:28,420
،عندما رأيتُ هجمات السّاقين الذّكيّة خاصّتكِ

677
00:54:28,520 --> 00:54:30,680
.فكّرتُ بأنّه يُمكنني فِعل هذا أيضاً

678
00:54:30,970 --> 00:54:31,890
...أنتِ

679
00:54:31,910 --> 00:54:33,800
!مُستحيل

680
00:54:36,790 --> 00:54:37,950
!هذا مُذهل

681
00:54:38,000 --> 00:54:42,090
!لكن ركلاتي تسحَر جميع الرّجال

682
00:54:42,600 --> 00:54:45,990
!لا أحتاج لأن أسحَر جميع الرّجال

683
00:54:46,860 --> 00:54:49,220
.فلتُصدِر عليكِ النّجوم السّبعة الحُكم

684
00:54:50,780 --> 00:54:52,240
!غراند تشاريوت

685
00:55:34,540 --> 00:55:36,400
ما أمر مَوقِفكِ هذا؟

686
00:55:37,970 --> 00:55:40,250
.فلتُعطِني الدراغون كراي بسرعة

687
00:55:41,390 --> 00:55:42,390
...أنا

688
00:55:42,990 --> 00:55:44,360
.أعِد لنا الصّولجان

689
00:55:44,470 --> 00:55:45,560
!أعِده

690
00:55:45,730 --> 00:55:47,490
هاه؟

691
00:55:48,400 --> 00:55:49,590
سونيا؟

692
00:55:50,540 --> 00:55:51,120
هاه؟

693
00:55:53,070 --> 00:55:54,260
أين الملِك؟

694
00:55:54,640 --> 00:55:57,410
لماذا تحملين الصّولجان، سونيا؟

695
00:56:00,040 --> 00:56:02,740
...لإعطاءه للملِك عندما كان هُنا

696
00:56:02,770 --> 00:56:04,300
!أعطِنا الصّولجان

697
00:56:04,340 --> 00:56:07,230
...كلّا... هذا... حسناً

698
00:56:07,230 --> 00:56:09,690
.لا يُمكنكِ إعطاءه الصّولجان

699
00:56:13,310 --> 00:56:14,230
سونيا؟

700
00:56:14,390 --> 00:56:17,780
.لَم يعُد لدينا وَقت
.أحضري لي الدراغون كراي

701
00:56:17,810 --> 00:56:19,670
.غداً ستُعقد المراسم المُهمّة

702
00:56:19,810 --> 00:56:21,920
!لماذا لا يُحضره لي؟

703
00:56:22,430 --> 00:56:24,500
.سيأتون بالتّأكيد

704
00:56:29,960 --> 00:56:31,570
.أُقتُلهم وَقتها

705
00:56:32,490 --> 00:56:33,910
.و افعلها بشكلٍ صحيحٍ هذه المرّة

706
00:56:36,750 --> 00:56:37,670
!الملِك

707
00:56:38,570 --> 00:56:39,650
هل أنا...؟

708
00:56:40,230 --> 00:56:42,760
هل أدركتِ هذا الآن، سونيا؟

709
00:56:43,280 --> 00:56:44,040
...جلالتُك

710
00:56:44,320 --> 00:56:46,060
...أنتِ و أنا

711
00:56:46,760 --> 00:56:48,660
.نحن نفس الشّخص...

712
00:56:51,940 --> 00:56:52,980
!سونيا

713
00:57:07,020 --> 00:57:09,740
مـ-من أنتِ؟

714
00:57:11,990 --> 00:57:13,980
.أنا أنيموس

715
00:57:15,390 --> 00:57:17,120
.أنا في جسد سونيا

716
00:57:19,030 --> 00:57:20,480
.أنا تنّين

717
00:57:21,670 --> 00:57:22,670
تنّين؟

718
00:57:26,600 --> 00:57:28,910
ما الذي تهدف إليه؟

719
00:57:29,310 --> 00:57:34,230
ألا ترغب بمنع انفجار الستيلانيوم بهذا الصّولجان؟

720
00:57:35,790 --> 00:57:39,850
.سونيا الصّغيرة... سؤالها لهذا الطّلب السّخيف هو شيءٌ يُمكن تصديقه

721
00:57:40,600 --> 00:57:42,360
.يا لها من فتاةٍ مُطيعة

722
00:57:43,470 --> 00:57:49,290
.ما أهدف إليه هو الخُروج من هذا الجّسد البَشريّ المُقرِف

723
00:57:50,040 --> 00:57:52,780
.تمكّن إيغنيل من الخُروج لوَحده

724
00:57:53,210 --> 00:57:56,210
هل تعرف إيغنيل؟

725
00:57:57,430 --> 00:58:01,580
.زحفَ إيغنيل إلى داخل قاتِل تنانين

726
00:58:02,020 --> 00:58:05,490
.زحفَ إلى داخل الجّسد المِثاليّ

727
00:58:06,340 --> 00:58:09,750
.مع ذلك، لَم أملك الوَقت للإختيار

728
00:58:10,560 --> 00:58:14,510
دخلتُ جسد سونيا التي كانت على حافّة الموت، و التي
.تصادف وَجودها قُربي

729
00:58:14,630 --> 00:58:16,520
.و كنتُ بالإنتظار حتّى الآن

730
00:58:16,760 --> 00:58:20,970
.لهذا، لَم أتمكّن من الخُروج بإرادتي

731
00:58:21,580 --> 00:58:25,130
!لكن الآن، أحمل الدراغون كراي بيَداي

732
00:58:29,470 --> 00:58:32,850
.هذا الصّولجان يُعزّز قوّة التنّين

733
00:58:33,530 --> 00:58:35,200
!سأتحرّر

734
00:58:35,450 --> 00:58:37,650
!لَن أسمح بهذا

735
00:58:40,500 --> 00:58:43,860
.هل يُمكن أن تكون هذه قوّة إيغنيل

736
00:58:46,940 --> 00:58:48,800
!ناتسو، خُذ الصّولجان

737
00:58:48,910 --> 00:58:49,810
.سونيا

738
00:58:49,930 --> 00:58:51,390
!أسرِع بينما مايزال هناك وَقت

739
00:58:51,410 --> 00:58:52,850
!أُترُكيه، سونيا

740
00:58:54,360 --> 00:58:55,870
!ناتسو

741
00:59:00,250 --> 00:59:02,740
!سآخذ الدراغون كراي

742
00:59:02,850 --> 00:59:04,740
!كـ-كلب

743
00:59:06,120 --> 00:59:07,540
!زاش ساما

744
00:59:07,810 --> 00:59:11,800
أنيموس؟
.كلّا، أنتَ سونيا الآن على الأرجح

745
00:59:12,540 --> 00:59:17,890
.كملِك، كنتِ تُملينَ عليّ الأوامر، و عندما تكونين سونيا، كنتِ تحت إمرَتي

746
00:59:18,970 --> 00:59:23,040
.مللتُ من شخصيّتيكِ ذات الجّسد الوَاحد

747
00:59:23,360 --> 00:59:26,930
بماذا... تُريد استخدام... الصّولجان؟

748
00:59:28,090 --> 00:59:30,990
!سأستخدِمه للإنتقام من فيوري

749
00:59:33,490 --> 00:59:37,380
.الدراغون كراي يحوي إيثرنانو مُكثّفٌ مَضغوطٌ للغاية

750
00:59:37,790 --> 00:59:39,410
،إن حرّرتُه

751
00:59:39,430 --> 00:59:43,380
!يُمكنني تحرير قوّةٍ سِحريّةٍ تتفوّق على قوّة إيثريون بـ10 أضعاف

752
00:59:43,870 --> 00:59:49,320
!سأقوم بمَحو فيوري، التي احتقرَت سِحري لكونه سِحراً أسود و قامَت بنفيي

753
00:59:49,960 --> 00:59:51,350
!بيَداي

754
00:59:51,730 --> 00:59:52,780
!ريد نايف

755
00:59:53,400 --> 00:59:55,920
.هؤلاء طعامك

756
01:00:00,640 --> 01:00:01,990
!إنتظر

757
01:00:06,170 --> 01:00:08,920
.لَن أسمح لكَ بإيذاء ناتسو و سونيا

758
01:00:09,550 --> 01:00:11,570
!أنا ريد هابي

759
01:00:12,060 --> 01:00:14,190
.لا أخشاك

760
01:00:33,640 --> 01:00:35,330
!كان هذا عظيماً، هابي

761
01:00:35,620 --> 01:00:37,520
!أوه، لوسي

762
01:00:38,700 --> 01:00:39,700
!هابي

763
01:00:40,160 --> 01:00:41,870
!اللّعنة عليك، زاش

764
01:00:42,770 --> 01:00:43,640
!سونيا

765
01:00:44,530 --> 01:00:46,280
!كلّا، من أنتِ؟

766
01:01:05,120 --> 01:01:06,740
!هذا لا يُغتفر

767
01:01:08,180 --> 01:01:09,100
!تنّين

768
01:01:18,910 --> 01:01:21,020
.إعتني بهابي و سونيا

769
01:01:29,880 --> 01:01:31,680
!لَن تنجح على الإطلاق، جلالتُك

770
01:01:32,190 --> 01:01:36,220
.كُن أكثر حذراً مع مَباني إمبراطوريّتنا التّاريخيّة

771
01:01:36,760 --> 01:01:39,040
!أعطِني الصّولجان، زاش

772
01:01:39,230 --> 01:01:41,860
ألَم ترغب حقّاً باتّخاذ هذا الشّكل؟

773
01:01:42,280 --> 01:01:44,680
!حقّقتَ هدفكَ على أيّة حال

774
01:01:44,850 --> 01:01:47,220
.هذا الشّكل لَيس كاملاً

775
01:01:47,530 --> 01:01:50,620
!هذه لَيست الحُرّيّة التي أردتّها

776
01:01:52,580 --> 01:01:54,860
.سأُحرّركَ إذاً

777
01:01:55,300 --> 01:01:57,500
.جلالتُك، أنتَ مَحظوظٌ جدّاً

778
01:02:07,770 --> 01:02:09,520
...فلتثُر غضباً كما تشاء

779
01:02:10,500 --> 01:02:12,000
.بحُرّيّةٍ كاملة

780
01:02:16,060 --> 01:02:16,840
هاه؟

781
01:02:29,720 --> 01:02:32,560
.يبدو بأنّه مازال يُوجد بعض الجّان يتجوّلون في الأرجاء

782
01:02:33,880 --> 01:02:39,000
.رُبّما يجدُر بي استخدامهم، لَقد طوّرتُهم بالسّرّ لأجل مثل هذا اليوم

783
01:02:40,140 --> 01:02:42,520
!أُخرُج، يا جيش كوارتوم

784
01:03:02,160 --> 01:03:03,610
أيّ نوعٍ من الرّجال هُم؟

785
01:03:03,890 --> 01:03:04,670
