1
00:00:03,160 --> 00:00:05,350
منذُ عشر سنوات

2
00:00:08,800 --> 00:00:11,690
أرى أنّ ذلك الجرح لم يُشفَ بعد يا سويا

3
00:00:13,960 --> 00:00:15,860
سأعتبرُه شارة شرَف

4
00:00:17,860 --> 00:00:23,790
محطّة ميجيرو

5
00:00:18,660 --> 00:00:19,850
سأذهب

6
00:00:20,280 --> 00:00:22,890
انتبهي على نفسكِ رجاء

7
00:00:24,600 --> 00:00:25,590
...لماذا

8
00:00:27,260 --> 00:00:29,630
لماذا أنتِ الوحيدة التي...؟

9
00:00:46,320 --> 00:00:48,770
أهذا قلبُ بورانكي؟

10
00:00:51,170 --> 00:00:52,980
إنّه جميل للغاية

11
00:00:52,980 --> 00:00:54,150
،ليتيشيا-ساما

12
00:00:54,510 --> 00:00:57,560
،الآن بعدما أصبحتِ قادرة على إيقاظِ إيبّيميو

13
00:00:57,560 --> 00:01:02,080
البورانكي في موطنِنا إنجلترا، من نومِه العميق

14
00:01:06,530 --> 00:01:09,650
إنَّ البقاء فترة أطول في هذه الجزيرة سيُعرِّضُ صحّتكِ للخطر

15
00:01:09,650 --> 00:01:11,480
لقد حقّقنا هدفَنا

16
00:01:11,480 --> 00:01:13,000
لنعُد إلى القصر

17
00:01:15,470 --> 00:01:17,880
شكراً لك يا موسيس

18
00:01:20,360 --> 00:01:23,640
يبدو أنّ الفِرَق من تِلك البلاد الأخرى حاضرة هنا أيضاً

19
00:01:25,410 --> 00:01:29,010
يزدادُ الأمرُ إثارة، أشعرُ وكأنّني في مهرجان

20
00:01:29,010 --> 00:01:32,770
والآن حان الوقتُ لصَيد بورانكي مُمتِع ولطيف

21
00:01:32,770 --> 00:01:33,980
!كفاك تُرَّهات

22
00:01:33,980 --> 00:01:38,570
!هل تريدُ أن تحطِّمَ جزيرةَ الكنز، مسقط رأس كلّ البورانكي؟

23
00:01:39,460 --> 00:01:41,160
اصمتي أيّتها الطفلة

24
00:01:54,160 --> 00:01:56,240
لم أرك منذُ وقت طويل يا سويا-كُن

25
00:01:56,630 --> 00:01:57,760
تبدو بخير

26
00:01:59,430 --> 00:02:02,950
لا، أنتِ من تبدين جميلة كعادتكِ يا ميغيوا-سان

27
00:02:02,950 --> 00:02:05,720
شكراً جزيلاً على كُل ما فعلتِه

28
00:02:06,180 --> 00:02:09,980
!كم أنتِ مذهلة حقّاً! أنا مُندهش

29
00:02:10,490 --> 00:02:14,600
لم تكتفي بالتخلِّي عن كلّ شيء والمجيء
إلى هُنا لمنع البورانكي

30
00:02:14,600 --> 00:02:17,980
،الذين ظلّوا يهدِّدون البشريّة من السُّقوط في الأرض

31
00:02:17,980 --> 00:02:20,980
إنّما استمررتِ في منعهم من السّقوط

32
00:02:20,980 --> 00:02:25,990
حتّى بعدما فقدتِ زوجكِ وأطفالكِ

33
00:02:27,100 --> 00:02:30,460
.لكن أخبريني بشيء واحد فقط

34
00:02:30,930 --> 00:02:34,790
لماذا أوقفتِ قلوب جميع البورانكي في الأرض؟

35
00:02:35,300 --> 00:02:36,870
أوقفَتْ قلوبهم؟

36
00:02:37,610 --> 00:02:38,800
،منذُ ستّة عشر عاماً

37
00:02:39,420 --> 00:02:42,100
،اليوم الذي صعدت فيه إلى جزيرة الكنز

38
00:02:42,500 --> 00:02:45,940
أرسلتِ إشارةً من هُنا أدَّتْ إلى إيقاف

39
00:02:45,940 --> 00:02:50,310
قلوب كافّة البورانكي في الأرض، لماذا؟

40
00:02:50,750 --> 00:02:54,690
لهذا السبب لم يكُن قلب إيبّيزو-سان ينبضُ إذاً

41
00:02:55,210 --> 00:03:00,110
وقعَ العالمُ في حالةِ فوضى دون أن يعمل البورانكي كقوّةٍ رادِعة

42
00:03:00,650 --> 00:03:05,660
ومع ذلك ولسببٍ ما، وحده قلب إنتيـه لم يتوقّف

43
00:03:06,200 --> 00:03:08,870
نتيجة ذلك، أصبحَت ريوكو-ساما الشّخص

44
00:03:08,870 --> 00:03:12,420
الوحيدة في العالم التي تستطيعُ تشغيل بورانكي

45
00:03:12,730 --> 00:03:18,340
وكلّ الكراهيّة في العالم كانَتْ مُوجَّهة نحوها ونحو إنتيـه

46
00:03:18,340 --> 00:03:20,760
رُغمَ أنَّها اصطادَتْ

47
00:03:20,760 --> 00:03:23,640
وقتلَتْ كلّ بورانكي مبتور الرأس قد أتى من هُنا

48
00:03:23,640 --> 00:03:28,090
لعشر سنوات حتّى الآن، ريوكو-ساما هي الوحيدة
التي يُنادونها بالسّاحرة

49
00:03:28,090 --> 00:03:29,700
!لا أنتِ

50
00:03:30,680 --> 00:03:32,810
لِمَ لا تقولين شيئاً؟

51
00:03:33,360 --> 00:03:34,310
أنا آسفة

52
00:03:34,650 --> 00:03:35,690
ماذا؟

53
00:03:38,000 --> 00:03:43,320
سويا-كُن، يبدو أنّني سبّبتُ كثيراً من الألم
لك ولريوكو

54
00:03:43,810 --> 00:03:45,200
أنا حقّاً آسفة

55
00:03:45,400 --> 00:03:50,700
أنتِ "آسفة"؟ أهذه نكتة أم ماذا؟

56
00:04:02,390 --> 00:04:03,850
!هذا سهلٌ جدّاً

57
00:04:05,290 --> 00:04:06,050
...هذه

58
00:04:06,050 --> 00:04:07,530
!فتاة الصّخرة

59
00:04:07,530 --> 00:04:08,680
انسي أمرها

60
00:04:11,780 --> 00:04:14,530
أذلك هو الفريق الرُّوسي الذي كانَتْ
شيزورو تتحدّثُ عنه؟

61
00:04:14,530 --> 00:04:15,560
ما الذي جاء بهم إلى هنا؟

62
00:04:15,890 --> 00:04:17,070
كائناً من كانوا

63
00:04:17,380 --> 00:04:19,820
لن أدعهم يؤذون جزيرةَ الكنز أكثر من ذلك

64
00:04:21,420 --> 00:04:22,390
هيراغي-كُن

65
00:04:24,860 --> 00:04:27,370
هيراغي-كُن، ساعدني أرجوك

66
00:04:27,620 --> 00:04:28,870
حسناً

67
00:04:29,840 --> 00:04:32,160
إن استمرَّ هذا الوضع فستسقطُ جزيرةُ الكنز

68
00:04:33,210 --> 00:04:36,090
وإن حدثَ ذلك ستموتُ كثيرٌ من الكائنات الحيّة

69
00:04:36,970 --> 00:04:40,110
سيقعُ عددٌ هائلٌ من الضحايا لم تشهد
البشريّة مثله من قبل

70
00:04:41,210 --> 00:04:44,090
يجبُ أن أوقفهم مهما كلّفَ الأمر

71
00:04:49,990 --> 00:04:52,930
لقد تكبّدت الجزيرة ما يكفي من أضرار للسقوطِ في المحيط

72
00:04:52,930 --> 00:04:55,940
ما الذي يخطِّطُ له أولئك الرّوسيّون؟

73
00:04:56,180 --> 00:04:57,560
!أراباشيري

74
00:04:57,560 --> 00:04:58,980
!إلامَ تنظر؟

75
00:05:01,070 --> 00:05:03,240
!لا تدعيني أكرِّرُ كلامي

76
00:05:03,240 --> 00:05:04,600
لا تتدخّلي أيّتها الطفلة

77
00:05:04,600 --> 00:05:05,610
!افعليها يا كوغاني

78
00:05:06,440 --> 00:05:08,160
عُلِم يا كينوا-تشان

79
00:05:10,590 --> 00:05:11,530
!اللّعنة

80
00:05:18,320 --> 00:05:22,070
نحنُ الأطفال لدينا طريقتنا الخاصّة في القتالِ
يا أراباشيري

81
00:05:26,600 --> 00:05:30,310
أخي الكبير، فجَّرنا كافّة المتفجِّرات المتبقّية

82
00:05:30,710 --> 00:05:36,160
ألا نُبالِغ قليلاً فقط للحصولِ على قلب بورانكي؟

83
00:05:36,160 --> 00:05:39,730
سأُسقِطُ هذه الجزيرة في أرضي الأمّ

84
00:05:39,730 --> 00:05:40,410
ماذا؟

85
00:05:40,770 --> 00:05:44,320
هـ-هل كانَتْ أوامر مسيو غاي؟

86
00:05:45,810 --> 00:05:47,490
...ليو

87
00:05:48,070 --> 00:05:52,380
ألا تعتقدين بأنّ الوقت قد حان لتطهير
الفئران التي لا تعمل إلّا

88
00:05:52,380 --> 00:05:54,910
على تلويث هوائنا وأكل طعامنا؟

89
00:05:57,140 --> 00:05:58,330
...بلى

90
00:05:58,540 --> 00:06:04,090
لكن يا أخي الكبير، ماذا سيحلُّ بأمِّي وأبي حينئذ؟

91
00:06:04,440 --> 00:06:07,660
عقول نيِّرة ونظرات جميلة

92
00:06:07,660 --> 00:06:10,800
ونسَب مُمتاز، حالة اجتماعيّة تجعلُ الجميع صاغراً أمامنا

93
00:06:10,800 --> 00:06:12,250
...والبوبوكي الخاصّ بنا

94
00:06:13,050 --> 00:06:18,310
ألم نرِث كلّ ما ينبغي أن نرِثَه من أبوينا فحسب؟

95
00:06:19,480 --> 00:06:23,730
لقد حان الوقتُ لإعادة وِلادة أرضنا الأمّ على أيدينا

96
00:06:24,100 --> 00:06:26,070
سأقودُ جيشاً من البورانكي

97
00:06:26,500 --> 00:06:28,900
!وأقمع غاي بحدِّ ذاته

98
00:06:28,900 --> 00:06:30,580
!هذا هو أخونا الكبير

99
00:06:30,580 --> 00:06:33,100
خطّة لا يستطيع أحدٌ أن يطالها كما المُحيط القطبي تماماً

100
00:06:33,100 --> 00:06:34,490
...يمكنُك أن ترى إلى ما بعد مئة عام

101
00:06:41,540 --> 00:06:44,230
!إلى أين تُصوِّبين أيّتها الحمقاء؟

102
00:06:53,900 --> 00:06:55,920
،لا أعرف من تكون

103
00:06:57,070 --> 00:07:00,670
لكن لن أدعك تفعلُ ما يحلو لك
بجزيرةِ الكنز بعد الآن

104
00:07:05,110 --> 00:07:06,770
شكراً لك يا هيراغي-كُن

105
00:07:07,430 --> 00:07:09,400
شكراً لك يا إيواتوشي

106
00:07:10,610 --> 00:07:12,500
أتعرفُ إيواتوشي؟

107
00:07:12,860 --> 00:07:14,730
يوشيكي-سان، أبوك

108
00:07:15,460 --> 00:07:17,830
كان مُستخدم إيواتوشي

109
00:07:23,020 --> 00:07:28,480
في الماضي، ساعدَني أبوك كثيراً

110
00:07:30,970 --> 00:07:34,590
!لماذا تركتِه وأتيتِ إلى هنا إذاً؟

111
00:07:35,250 --> 00:07:39,130
تعلمين أنّ مجموعة من البورانكي قد هاجمَتْ
قبل أن نُولَد، صحيح؟

112
00:07:39,500 --> 00:07:41,640
أليس هذا سبب مجيئكِ إلى هنا؟

113
00:07:42,200 --> 00:07:46,980
!إذاً كان يجدرُ بكِ أن تحضري أبي معكِ لمُساعدتكِ

114
00:07:47,510 --> 00:07:50,400
...لو فعلتِ ذلك لكان... لكان

115
00:07:51,000 --> 00:07:53,020
لما انتهى المطافُ به هكذا

116
00:07:54,220 --> 00:07:57,750
وُلِدتَ قبل يوم من مجيئي إلى هُنا

117
00:07:59,380 --> 00:08:01,310
،بخلافِ حالتي

118
00:08:01,310 --> 00:08:05,920
اختارك إيواتوشي كمعلِّمه التّالي

119
00:08:05,920 --> 00:08:08,240
ممّا جعلَ يوشيكي-سان يفقدُ قِواه

120
00:08:09,330 --> 00:08:14,550
لهذا كان من الخطأ إقحام شخص عاجز
عن القتالِ في المعركة

121
00:08:15,680 --> 00:08:17,500
ماذا تقصدين بـ"إقحام"؟

122
00:08:17,500 --> 00:08:19,930
لا ضير من الاعتمادِ على زملائكِ في الفريق

123
00:08:20,510 --> 00:08:23,780
أنا متأكِّدٌ أنَّ أبي أرادكِ أن تعتمدي عليه أيضاً

124
00:08:24,330 --> 00:08:26,950
أرادكِ أن تقولي أنّ عليكما المجيء إلى هنا سوية

125
00:08:26,950 --> 00:08:27,900
!أنا متأكِّد

126
00:08:30,090 --> 00:08:33,950
أنا آسف... فقدتُ أعصابي

127
00:08:34,410 --> 00:08:36,530
لا، لا عليك

128
00:08:36,980 --> 00:08:41,120
لم أكن يوماً جيّدة في التعبيرِ شفوياً
عن مشاعري للنّاس

129
00:08:41,720 --> 00:08:45,120
لهذا أحسدُك على ذلك

130
00:08:50,790 --> 00:08:53,340
سأدخلُ جزيرةَ الكنز من هُنا

131
00:08:54,350 --> 00:08:56,680
تعالَ معي يا هيراغي-كُن

132
00:08:58,420 --> 00:08:59,250
!حسناً

133
00:09:03,830 --> 00:09:05,360
...أيّتها الصغيرتان

134
00:09:05,360 --> 00:09:09,020
عليكما أن تكبرا وتُصبِحا امرأتَين إن أردتُما هزيمتي

135
00:09:12,600 --> 00:09:14,900
كوغاني... لا تنهضي

136
00:09:17,260 --> 00:09:19,530
تبّاً، يا له من إصرار

137
00:09:19,830 --> 00:09:24,490
لا أكنُّ أي ضغينة اتّجاهك، لكن إن ظللتِ
تعترضين طريقي

138
00:09:24,920 --> 00:09:27,370
فسأضطرُّ لتنويمكِ قليلاً

139
00:09:29,880 --> 00:09:31,210
!ل-لا تفعل

140
00:09:31,570 --> 00:09:33,080
النِّهاية

141
00:09:40,150 --> 00:09:43,060
ساخن، ساخن، ساخن، ساخن

142
00:09:44,670 --> 00:09:47,030
ما الذي تحاولُ فعله بحقِّ السماء؟

143
00:09:47,030 --> 00:09:49,190
أجبني يا ماتوباي-سان

144
00:09:51,150 --> 00:09:53,020
...في الحقيقة

145
00:09:53,680 --> 00:09:55,990
،هذا سؤالٌ وجيه

146
00:09:56,260 --> 00:09:57,930
يا سويا

147
00:10:07,790 --> 00:10:09,300
!ماذا تفعل؟

148
00:10:09,300 --> 00:10:11,910
كلّ ما في الأمر أنّها كانَتْ نزوة صغيرة

149
00:10:11,910 --> 00:10:13,590
!كفاك هُراء

150
00:10:15,660 --> 00:10:18,930
أفضِّلُ الموت على أن تُساعدني أنت

151
00:10:21,170 --> 00:10:22,390
بالتأكيد

152
00:10:22,790 --> 00:10:26,180
أرأيت؟ هذا ما تستحقُّه على قيامك بعمل غير مُناسِب

153
00:10:26,430 --> 00:10:28,520
!كتفكيري تماماً

154
00:10:47,810 --> 00:10:49,930
ما الذي تحاولُ فعله يا سينباي؟

155
00:10:49,930 --> 00:10:52,830
!ولماذا أنتَ هنا أصلاً؟

156
00:10:52,830 --> 00:10:56,880
ينبغي أن أسألَ عمّا تفعلُه متسلِّلاً
من خلف ظهورنا

157
00:10:57,290 --> 00:11:00,770
كان هدفنا خطف الخائنة ميغيوا

158
00:11:00,770 --> 00:11:03,720
وتسليمها لريوكو-ساما، أليس كذلك؟

159
00:11:03,720 --> 00:11:05,330
،لِذا ماذا تظنُّ أنَّك تفعل

160
00:11:05,330 --> 00:11:09,060
بالتعاونِ مع جماعتَيّ روسيا وأمريكا؟

161
00:11:09,730 --> 00:11:13,900
أتِلك النّدبة التي أُصِبتَ بها وأنتَ تحمي
ريوكو-ساما هي للاستعراضِ فقط؟

162
00:11:15,490 --> 00:11:18,400
وما أدراك أنت؟

163
00:11:28,850 --> 00:11:30,130
...ريوكو-ساما

164
00:11:32,100 --> 00:11:34,750
أهذا أنت يا سوبو؟

165
00:11:36,410 --> 00:11:37,860
...البورانكي مبتور الرّأس

166
00:11:37,860 --> 00:11:39,840
!كم بورانكي مبتور الرّأس قد بقي؟

167
00:11:42,100 --> 00:11:43,860
!أجبْني يا سويا

168
00:11:43,860 --> 00:11:44,660
!أجبْني

169
00:11:46,390 --> 00:11:47,290
!ريوكو-ساما

170
00:11:48,350 --> 00:11:50,270
!سويا، أخبرني

171
00:11:52,760 --> 00:11:55,140
بقي ستّة

172
00:11:55,140 --> 00:11:58,000
الاثنان اللّذان سقطا في شينجوكو وأوشياغي

173
00:11:58,000 --> 00:12:00,770
قد استيقظا وبدآ بالتحرُّك

174
00:12:06,260 --> 00:12:08,230
!انتظري أرجوكِ يا ريوكو-ساما

175
00:12:08,800 --> 00:12:12,870
خسرتِ حياتكِ مرّتَين في المعركتَين
الأخيرتَين ضدّ البورانكي مبتور الرّأس

176
00:12:13,520 --> 00:12:15,880
في هانيدا، سُحِقَ جسدُكِ

177
00:12:16,230 --> 00:12:19,130
وهُنا في ميجيرو، احترقتِ حيّة

178
00:12:19,560 --> 00:12:24,210
ومع ذلك، تحدَّى جسدُكِ قوانين الطبيعة

179
00:12:24,210 --> 00:12:25,920
وعادَ إلى الحياةِ مرّتَين

180
00:12:27,140 --> 00:12:28,860
وما هو مقصدك؟

181
00:12:29,620 --> 00:12:31,770
،ما دام إنتيـه معي

182
00:12:31,770 --> 00:12:34,010
أستطيعُ العودة إلى الحياةِ عدداً
لا يُحصى من المرَّات

183
00:12:34,440 --> 00:12:36,900
لا سبب يدفعُك للقلق

184
00:12:38,420 --> 00:12:41,350
ريوكو-ساما، أعلمُ أنَّ جسدكِ يستطيع التّعافي

185
00:12:41,350 --> 00:12:45,320
بسُرعة بالغة مهما تعرضتِ لجروح

186
00:12:45,630 --> 00:12:48,870
...لكن دماغكِ... وحده دماغكِ الذي

187
00:12:49,180 --> 00:12:50,490
دماغي ماذا؟

188
00:12:51,340 --> 00:12:54,690
يتلقّى ضرراً كلّما شُفيَ جسدُكِ

189
00:12:54,690 --> 00:12:57,500
...ذكريات ضبابيّة وانتكاسة عقليّة

190
00:12:58,130 --> 00:13:01,550
...أثبت أنّ ذلك يحدثُ بالفعل! إن ظللتِ هكذا

191
00:13:01,550 --> 00:13:07,390
سأتحوّلُ في نهاية المطاف إلى كتلة لحم
لا تعرف من تكون؟

192
00:13:09,940 --> 00:13:11,260
الآن بعدما أصبحَ لدينا سرّاً

193
00:13:12,530 --> 00:13:15,110
تكتَّم عليه ولا تنقله لشوساكو والآخرين

194
00:13:16,870 --> 00:13:21,480
لِمَ عليكِ تحمُّل مسؤوليّة كهذه بمفردكِ؟

195
00:13:22,180 --> 00:13:26,540
إنتيـه، والذي سُحِقَ قلبه بواسطةِ ميغيوا
منذُ فترة طويلة

196
00:13:26,540 --> 00:13:30,030
،وأخذَ جسدي بحدِّ ذاته كقلبٍ جديدٍ له

197
00:13:30,030 --> 00:13:34,550
هو البورانكي الوحيد في الأرض والقادر على الحركة

198
00:13:36,270 --> 00:13:39,500
هنالِك واجبٌ لا يستطيعُ سِواي أدائه

199
00:13:39,500 --> 00:13:42,220
لأنّني أمتلكُ هذا الجسم الملعون

200
00:13:43,750 --> 00:13:44,840
...ميغيوا الحقيرة

201
00:13:46,730 --> 00:13:48,280
سأهاجمُ بإنتيـه

202
00:13:50,730 --> 00:13:51,640
...سويا

203
00:13:53,460 --> 00:13:54,870
لا تزعجني

204
00:14:02,920 --> 00:14:07,950
لديّ سببٌ أقاتلُ لأجله أيضاً

205
00:14:07,950 --> 00:14:12,160
يبدو لي أنّ لديك دافِع خفيّ بحدّ ذاتك يا ماتوباي-سان

206
00:14:12,520 --> 00:14:14,830
لا أعلمُ بالنسبةِ لي

207
00:14:14,830 --> 00:14:18,180
على أي حال، الوقتُ يُداهمني

208
00:14:18,780 --> 00:14:23,460
بحسبِ مسار الأمور، سيسقطُ عشُّ البورانكي
على عاصمةِ روسيا

209
00:14:23,730 --> 00:14:26,180
مساحة هذا الشيء عشرة كيلومترات

210
00:14:26,180 --> 00:14:29,340
سيموتُ عددٌ لا يُحصى من النّاس بلمح البصر

211
00:14:30,140 --> 00:14:32,510
سيقضي على العالم برمّته

212
00:14:33,140 --> 00:14:36,060
!أهذا ما تريده؟

213
00:14:36,060 --> 00:14:38,590
!أجبْني يا سويا

214
00:14:44,640 --> 00:14:46,400
!اللّعنة عليك

215
00:15:01,670 --> 00:15:03,460
...ش-شكراً لك

216
00:15:03,850 --> 00:15:06,560
أرى أنّ هذا خاطئ

217
00:15:07,150 --> 00:15:10,240
...أعني إسقاط هذه الجزيرة على الأرض الأمّ

218
00:15:12,470 --> 00:15:15,400
!أين القلب يا جرذ المجارير؟

219
00:15:15,400 --> 00:15:17,000
!هل كتبتَ وصيّة موتك؟

220
00:15:17,000 --> 00:15:19,130
!لا تغضبني أكثر من ذلك

221
00:15:19,130 --> 00:15:22,540
أخي الكبير، اهدأ أرجوك

222
00:15:27,520 --> 00:15:31,890
أخي الكبير، هلّا أعدت النّظر في الأمر من فضلك؟

223
00:15:32,660 --> 00:15:34,610
،مهما كنتَ عظيماً

224
00:15:34,610 --> 00:15:39,870
زهق أرواح بريئة للتّرفيه فقط هو أمرٌ لا يُغتفَر

225
00:15:39,870 --> 00:15:43,720
!ماذا؟ ليودميلا، هل تنتقدين أخينا الكبير؟

226
00:15:43,980 --> 00:15:45,890
ما الخطب يا ليو؟

227
00:15:45,890 --> 00:15:48,380
منذُ متى كنتِ مُحِبّة للغير؟

228
00:15:52,160 --> 00:15:55,390
فهمتُ يا ليو الطيّبة

229
00:15:56,280 --> 00:15:57,120
...أخي الكبير

230
00:15:57,120 --> 00:16:01,640
سامحيني، لكن لا أملك الوقت للتّعامل
مع ذاتكِ الأخرى

231
00:16:04,350 --> 00:16:06,810
لقد وضعتُ غشاءً من الرينزو على حنجرتكِ

232
00:16:06,810 --> 00:16:09,140
تجدين صعوبة في التنفُّس، أليس كذلك؟

233
00:16:11,110 --> 00:16:14,050
أنتِ يدي اليُمنى الثّمينة... أعني أختي

234
00:16:14,050 --> 00:16:16,940
لن أقتلكِ، ابقي هكذا لبعضِ الوقت فحسب

235
00:16:19,680 --> 00:16:21,530
لماذا تنظرُ إليّ هكذا؟

236
00:16:26,380 --> 00:16:26,920
...أنت

237
00:16:31,870 --> 00:16:33,100
ستكونُ بخير الآن

238
00:16:33,500 --> 00:16:35,430
سامحني، شكراً لك

239
00:16:35,750 --> 00:16:36,640
...هذه الجزيرة

240
00:16:38,030 --> 00:16:42,250
تقولُ أنّها تريدُ حِماية الكائنات الحيّة التي تعيشُ عليها

241
00:16:42,810 --> 00:16:44,580
!ما هذا الهُراء الذي تتفوّهين به؟

242
00:16:44,580 --> 00:16:47,010
أخي الكبير، دعنا ننسحب

243
00:16:48,030 --> 00:16:49,330
!لا تكوني سخيفة

244
00:16:49,330 --> 00:16:52,060
إنّهما اثنان فقط، أي خمسة ضدّ اثنَين

245
00:16:52,060 --> 00:16:53,740
!يا فتاة الصّخرة القبيحة

246
00:16:53,950 --> 00:16:57,280
أيُّها الفأران، اقضيا على مُستخدم القلب هذا

247
00:16:57,280 --> 00:16:59,490
كلّما حصلتُ على عددٍ أكبر من القلوب
كان أفضل

248
00:17:01,350 --> 00:17:03,500
ما معنى هذا؟

249
00:17:03,500 --> 00:17:05,160
!هل جُنِنتُم؟

250
00:17:09,880 --> 00:17:13,070
أخي الكبير، أصبحنا الآن اثنان ضدّ خمسة

251
00:17:13,560 --> 00:17:15,240
أعِد النَّظر في الأمر أرجوك

252
00:17:15,720 --> 00:17:19,510
أنا... بل نحنُ قادرون على التّفكير أيضاً

253
00:17:19,510 --> 00:17:21,180
حتّى كأطراف

254
00:17:21,610 --> 00:17:25,730
!إيّاكِ وانتقادي

255
00:17:27,940 --> 00:17:31,560
القلب والأطراف ليسَتْ ملِكاً وخدَماً

256
00:17:31,560 --> 00:17:33,400
،إن لم تفهم حتّى شيئاً كهذا

257
00:17:34,110 --> 00:17:36,030
فلا تستحقُّ أن تمتلك قلباً

258
00:17:36,240 --> 00:17:37,340
!أخي الكبير

259
00:17:37,710 --> 00:17:39,030
...لن تفلت بفعلتِك هذه

260
00:17:41,150 --> 00:17:43,450
...نامو

261
00:17:43,700 --> 00:17:45,670
،يا مُستخدم قلب يابونيا

262
00:17:45,670 --> 00:17:49,130
سامحنا على انتهاكاتنا غير الأخلاقيّة الكثيرة

263
00:17:49,130 --> 00:17:51,960
...بسببنا، الجزيرة

264
00:17:52,410 --> 00:17:55,470
لا عليكِ، هذه الجزيرةُ هي مسقطُ رأسي

265
00:17:55,940 --> 00:17:57,400
سأحافظُ على سلامتِها

266
00:17:58,830 --> 00:17:59,660
حسناً

267
00:18:08,520 --> 00:18:11,150
!والآن، انتهى أمرك

268
00:18:30,890 --> 00:18:32,670
لا جدوى من المُقاومة

269
00:18:56,290 --> 00:18:58,400
أنا آسف يا سويا

270
00:18:59,580 --> 00:19:02,300
لقد ربِحتُ في هذه المعركة

271
00:19:14,980 --> 00:19:17,460
ما-ما الذي حدثَ للتو؟

272
00:19:24,250 --> 00:19:26,770
سويا، بارِك لي

273
00:19:27,240 --> 00:19:29,760
وُلِدَ طفلي للتو في الأرض

274
00:19:29,980 --> 00:19:31,010
!ماذا؟

275
00:19:31,490 --> 00:19:33,720
!حسناً، مبروك

276
00:19:33,720 --> 00:19:37,980
لحظة، ما نوع الفخّ الذي تحاولُ أن تنصبه
!لي هذه المرّة؟

277
00:19:39,300 --> 00:19:40,990
لا شيء من هذا القبيل

278
00:19:40,990 --> 00:19:46,240
لم أعُد أمتلكُ ذرّةً من الرينزو

279
00:19:46,580 --> 00:19:48,930
...ماذا؟ هل أنت حقّاً

280
00:19:49,250 --> 00:19:50,620
...قبل

281
00:19:50,830 --> 00:19:55,550
قبل أن أفقد كافّة قِوايّ كمُستخدِم بوبوكي

282
00:19:55,550 --> 00:19:58,340
أردتُ أن أدمِّرَ رايجودو

283
00:19:59,340 --> 00:20:01,970
،إن استطعتُ جعلها فتاة عاديّة

284
00:20:01,970 --> 00:20:04,640
فستكونُ سعيدة

285
00:20:04,960 --> 00:20:07,510
لطالما آمنتُ بذلك

286
00:20:09,710 --> 00:20:13,920
لكن استعجلتُ كثيراً بصنع ذلك القرار

287
00:20:14,270 --> 00:20:19,980
لأنّها تبدو الأسعَد بوجودِها ضمن فريق
مُؤلَّف من خمسة أطفال

288
00:20:21,210 --> 00:20:24,230
آسف يا سويا، لقد خرجتُ من اللّعبة

289
00:20:24,960 --> 00:20:28,770
حدِّثني عن المبدأ الذي تُؤمِن به

290
00:20:31,890 --> 00:20:38,740
أنا... كلّ ما في الأمرِ أنّني لم أرد
أن أدعَ ريوكو-ساما تدخلُ إنتيـه بعد الآن

291
00:20:39,380 --> 00:20:43,230
،لقد فُرِضَ على عاتقِها كلّ شيء

292
00:20:43,230 --> 00:20:45,100
ودائماً ما تُعاني بمفردها

293
00:20:45,480 --> 00:20:49,170
لم أستطع تحمُّل ذلك، كان ذلك قاسياً جداً

294
00:20:50,290 --> 00:20:54,320
لم تتغيّر مُذ كنتَ طفلاً يا سوبو

295
00:20:55,200 --> 00:20:59,020
...لطيف جدّاً... وصادق جدّاً

296
00:21:09,470 --> 00:21:14,190
ما الذي يفكِّرُ به غاي وأولئك الديمقراطيّون على أي حال؟

297
00:21:14,670 --> 00:21:19,070
فتح غِطاء فرن الجحيم وإسقاط الشيء كلّه في الأرض؟

298
00:21:19,540 --> 00:21:22,330
لا بدَّ وأنّهم قد فقدوا صوابهم

299
00:21:23,500 --> 00:21:25,680
في هذه الحالة، ستسقطُ جزيرةُ الكنز

300
00:21:25,680 --> 00:21:26,910
!ماذا؟

301
00:21:26,910 --> 00:21:28,050
أين ميغيوا-سان؟

302
00:21:28,440 --> 00:21:31,490
قالَتْ أنّها ستبذلُ قصارى جهدها حتّى آخر لحظة

303
00:21:31,490 --> 00:21:32,720
بقيَتْ في الأسفل

304
00:21:33,000 --> 00:21:33,760
في الأسفل؟

305
00:21:33,760 --> 00:21:34,600
نعم

306
00:21:53,870 --> 00:21:55,260
...ميغيوا

307
00:21:56,260 --> 00:21:59,490
حرقتِ يديّ وقدميّ سابِقاً

308
00:22:00,040 --> 00:22:02,740
حان دوركِ لتُدفَني حيّة هذه المرّة

309
00:22:04,120 --> 00:22:08,240
!أمِّي