1
00:00:07,570 --> 00:00:08,440
...أوبو

2
00:00:19,120 --> 00:00:20,620
...هل هذا

3
00:02:09,030 --> 00:02:12,150
!تبّاً! يا لكِ من مزعجة

4
00:02:19,720 --> 00:02:21,930
"هذا ما يُطلَق عليه بـ"النكهة الناضجة

5
00:02:25,330 --> 00:02:26,790
!الآن يا كوغاني

6
00:02:28,740 --> 00:02:32,580
لن أدعك تفلتُ بفعلتِك هذه

7
00:02:41,820 --> 00:02:44,660
نجحنا... نجحنا

8
00:02:45,870 --> 00:02:48,390
هيّا بنا، أوبو في انتظارنا

9
00:03:07,590 --> 00:03:08,700
أ-تشان

10
00:03:09,580 --> 00:03:11,620
أ-تشان، هل أنت بخير؟

11
00:03:11,620 --> 00:03:13,080
...كوغاني-تشان

12
00:03:13,360 --> 00:03:15,290
يسرُّني أنّك في أمان

13
00:03:15,870 --> 00:03:17,530
أنتِ أيضاً يا كوغاني-تشان

14
00:03:18,080 --> 00:03:22,380
...على رسلِك... توقّف

15
00:03:22,690 --> 00:03:24,980
!ما-ماذا تفعلان؟

16
00:03:24,980 --> 00:03:26,770
هذا ليس مكاناً ملائماً لذلك

17
00:03:27,140 --> 00:03:29,180
العِناق هو مجرّد تحيّة في مكان آخر من العالم

18
00:03:29,180 --> 00:03:31,290
...هـ-هذا ليس

19
00:03:35,220 --> 00:03:39,150
آه تذكّرت، لقد عشت خارج البلد طوال هذا الوقت

20
00:03:39,150 --> 00:03:41,060
!يا لجيل هذه الأيّام

21
00:03:41,060 --> 00:03:42,660
،ترعرعَ خارج اليابان

22
00:03:42,660 --> 00:03:44,360
شكراً على مُساعدتكم لي

23
00:03:42,660 --> 00:03:47,450
ما رأيك أن نتجاهل هذا إذاً يا كينوا-سان؟

24
00:03:51,500 --> 00:03:52,410
"أنت"

25
00:03:52,410 --> 00:03:54,920
لم أكن أساعدكم" هذا ما تقوله"

26
00:03:56,880 --> 00:04:00,060
حسناً، هذا لا يمنع شكري لكم

27
00:04:00,600 --> 00:04:01,800
أخبروني بشيء واحد

28
00:04:02,100 --> 00:04:04,180
هل بوبوكي على قيدِ الحياة؟

29
00:04:04,180 --> 00:04:07,130
عمّاذا تتكلَّم؟

30
00:04:07,130 --> 00:04:09,510
هلّا كففتِ عن الصُراخ؟

31
00:04:09,930 --> 00:04:11,780
تعالوا إلى هنا

32
00:04:13,510 --> 00:04:16,940
إنه مجرَّد عظام، هذا ليس بأمر حميد، صحيح؟

33
00:04:16,940 --> 00:04:19,740
إنه هيكل عظمي، هل يعاني من نقصٍ في التغذية؟

34
00:04:19,740 --> 00:04:21,030
بِلا مُزاح

35
00:04:22,140 --> 00:04:24,190
...لا أستطيع رؤية أمِّي بهذا

36
00:04:25,470 --> 00:04:27,250
سلِّم البوبوكي الخاص بك

37
00:04:28,600 --> 00:04:30,880
قلتُ أعطِني القلب

38
00:04:30,880 --> 00:04:32,790
لا أستطيع أن أعطيك قلبي هكذا ببساطة

39
00:04:33,060 --> 00:04:35,060
اصمت وأعطِني إيّاه فحسب

40
00:04:35,060 --> 00:04:37,540
أتقِنُ استعمال القلب أكثر منك

41
00:04:38,130 --> 00:04:42,000
كيف يمكنُك أن تستخدمَ قلبي بشكل أفضل منِّي؟

42
00:04:42,340 --> 00:04:43,340
هل أنت بخير؟

43
00:04:44,360 --> 00:04:46,940
!أغلِق فمك! أتعبثُ معي؟

44
00:04:46,940 --> 00:04:50,890
مهلاً يا هيي-كن، لا أظنُّكما متّفقَين معاً

45
00:04:51,170 --> 00:04:52,270
ماذا؟

46
00:04:52,270 --> 00:04:56,140
لا يعرف أ-تشان شيئاً عن بوبوكي

47
00:04:57,010 --> 00:05:00,770
لديك شيء من هذا القبيل أيضاً، أليس كذلك؟

48
00:05:01,740 --> 00:05:03,460
لا، لا أملك

49
00:05:03,460 --> 00:05:04,740
!ما-ماذا؟

50
00:05:04,740 --> 00:05:08,240
عجباً! لم أكن أتمنّى تصديق ذلك

51
00:05:08,680 --> 00:05:10,910
إنه ليسَ حامِل القلب؟

52
00:05:12,880 --> 00:05:16,380
...سنخرجُ من هنا إذاً، وبعدما نقطعُ هذه المسافة

53
00:05:16,380 --> 00:05:18,920
لا، إن أفسدنا هذه الفُرصة، فلن نحصلَ على شيء

54
00:05:19,430 --> 00:05:22,250
لقد مضى عشر سنوات منذُ سقوطك هنا

55
00:05:22,250 --> 00:05:25,880
إيّاك والظنّ أن أحداً سيصدِّق جهلَك
فقط لكونِك عشتَ في بلد أجنبي

56
00:05:26,270 --> 00:05:28,490
لكن صدِّقني لا أعرف شيئاً

57
00:05:28,490 --> 00:05:30,740
لم أرَ أي بوبوكي قبل اليوم

58
00:05:31,190 --> 00:05:32,630
هذا يكفي

59
00:05:34,720 --> 00:05:36,430
هيي-كن

60
00:05:36,430 --> 00:05:39,230
يستجيبُ بوبوكي عندما يتعرّضُ مُستخدمُه لخطر

61
00:05:39,230 --> 00:05:41,860
كفّ عن إخفائه، أظهرْه لي

62
00:05:41,860 --> 00:05:43,320
!توقف

63
00:05:43,320 --> 00:05:46,110
!ما الفائدة التي ستجنيانها من القِتال؟

64
00:05:47,750 --> 00:05:48,950
أ-تشان

65
00:05:52,000 --> 00:05:52,950
!أ-أنت

66
00:05:52,950 --> 00:05:53,970
كوغاني-تشان

67
00:05:57,850 --> 00:05:59,870
...يا إلهي

68
00:06:01,690 --> 00:06:06,420
هل ظننتِ أنَّ لكمة ضئيلة كتِلك قادرة على هزيمتي؟

69
00:06:06,420 --> 00:06:07,260
!كوغاني

70
00:06:11,790 --> 00:06:15,210
هل تهوّرتِ لأنّكِ حسبتِ أنّكِ ستثأرين لأبيك؟

71
00:06:15,210 --> 00:06:17,940
كنتِ كذلك، صحيح؟

72
00:06:18,780 --> 00:06:22,900
هل جعلَتْكِ تِلك اللعبة الصغيرة تعتقدين
أنّكِ تمتلكين موهبة صغيرة؟

73
00:06:25,430 --> 00:06:27,400
تروقني تِلك النظرة

74
00:06:29,750 --> 00:06:30,730
ميغيتي-تشان

75
00:06:31,320 --> 00:06:33,550
راقبي جيّداً هذه المرّة

76
00:06:33,550 --> 00:06:36,700
كيف سيموتُ ميغيتي-تشان العزيز على قلبك

77
00:06:37,000 --> 00:06:39,330
لن أسمح لك بالقيامِ بذلك

78
00:06:44,010 --> 00:06:46,840
...طفل يستطيعُ بقالكاد أن يقِفَ على قدميه سوف

79
00:06:46,840 --> 00:06:49,530
!لا، أ-تشان، اهرب

80
00:06:51,020 --> 00:06:54,840
كانَتْ أمّك مجرِمة أفسدَتِ العالم

81
00:06:54,840 --> 00:06:57,280
...ستدفعُ ثمنَ جريمتها

82
00:06:57,280 --> 00:06:59,040
بحياتك

83
00:07:03,110 --> 00:07:03,860
أ-تشان

84
00:07:07,470 --> 00:07:11,900
لقد درّبتِ حيوانك الأليف هذا جيّداً

85
00:07:11,900 --> 00:07:16,620
لكن حان وقتُ وداع مالكك يا أيُّها الحيوان الأليف

86
00:07:17,240 --> 00:07:19,830
سأمزِّقُك إرباً

87
00:07:19,830 --> 00:07:21,580
!توقَّف

88
00:07:43,340 --> 00:07:45,190
...هـ-هذا

89
00:08:02,830 --> 00:08:06,030
انظري إليه، يستطيعُ فعلها بالمُحاوَلة

90
00:08:06,030 --> 00:08:08,090
...يا له من قلبٍ جميل

91
00:08:11,790 --> 00:08:14,090
ميغيتي-تشان؟ ميغيتي-تشان؟

92
00:08:19,740 --> 00:08:21,010
!ميغيتي-تشان

93
00:08:54,820 --> 00:08:57,360
ما هذا؟

94
00:09:06,750 --> 00:09:08,810
أ-أعرفُ ذلك الشيء

95
00:09:08,810 --> 00:09:13,820
إنه جزء من الشيء الذي سحقَ أوينو
منذُ مدّة طويلة

96
00:09:17,720 --> 00:09:19,910
!رائع

97
00:09:19,910 --> 00:09:21,580
!مرحى

98
00:09:21,580 --> 00:09:22,910
مُمتاز

99
00:09:36,520 --> 00:09:38,680
أيُّها الفرخ

100
00:09:47,140 --> 00:09:50,570
تستحقُّون هذا يا كِلاب ريوكو

101
00:09:50,570 --> 00:09:51,570
!توقّف

102
00:09:51,570 --> 00:09:54,220
لا تستخدِم أوبو أمِّي للقيامِ بأعمال كهذه

103
00:09:54,220 --> 00:09:55,650
اسمك هييراغي، صحيح؟

104
00:09:55,650 --> 00:09:58,020
!لماذا تفعلُ هذا؟

105
00:09:58,900 --> 00:10:01,410
اسمك هو أزوما، صحيح؟

106
00:10:01,410 --> 00:10:04,240
إن لم تكُن أهلاً للثِقة كما يُفترَضُ على القلبِ أن يكون

107
00:10:04,240 --> 00:10:07,460
فسنفعلُ ما يحلو لنا فحسب

108
00:10:07,460 --> 00:10:11,500
ما أعنيه هو أنني أرى بأنّ استخدام
أسلوبنا سيسهِّلُ الأمر

109
00:10:12,070 --> 00:10:14,930
هل يجدرُ بي أن أكون... كقلب؟

110
00:10:16,470 --> 00:10:18,050
...في الموعد تقريباً

111
00:10:22,880 --> 00:10:27,210
سألتَني عن سببِ قيامي بهذا، صحيح؟

112
00:10:27,210 --> 00:10:29,330
اسمح لي أن أخبرك السبب

113
00:10:29,750 --> 00:10:32,780
كلّ هذا لاستدراجِ ذلك الشيء نحونا

114
00:10:46,050 --> 00:10:48,650
بورانكي أحمر؟

115
00:10:50,380 --> 00:10:53,360
ها أنت ذي يا بانريو ريوكو

116
00:10:56,300 --> 00:10:57,760
،أهلاً بعودتكم

117
00:10:58,150 --> 00:11:00,320
يا أطفال ميغيوا

118
00:11:13,120 --> 00:11:13,940
!هيّا بنا

119
00:11:14,290 --> 00:11:18,440
سندمِّرُ إنتي ونثبِت أن ريوكو شرِّيرة

120
00:11:21,200 --> 00:11:22,070
!لا تخافوا

121
00:11:22,680 --> 00:11:26,550
فقدَ إنتي ذِراعيه وساقيه في المعركة منذُ 24 سنة

122
00:11:26,550 --> 00:11:29,700
!لِذا لا ينبغي أن يكون قادراً على استخدام قوّته الحقيقيّة

123
00:11:43,720 --> 00:11:46,120
ما هذا بالضبط؟ سينجحُ هذا الأمر كلّياً

124
00:11:46,120 --> 00:11:46,800
!نعم

125
00:11:47,150 --> 00:11:50,370
ريوكو، أنت مستخدم بوبوكي مثلنا

126
00:11:50,370 --> 00:11:53,190
لكنّك خنتِ كافّة مستخدمي بوبوكي

127
00:11:53,610 --> 00:11:56,900
بسببكِ يتمُّ اعتبار كافّة مستخدمي
البوبوكي متمرِّدين

128
00:11:58,530 --> 00:12:00,690
!أنتِ الساحرة الحقيقية

129
00:12:01,060 --> 00:12:04,920
!أنتِ السبب في جنونِ أبي

130
00:12:04,920 --> 00:12:08,370
انتزعتِ كبرياءَ أبي كمُستخدِم بوبوكي

131
00:12:08,820 --> 00:12:11,790
لهذا سأستعيدُ كبريائه

132
00:12:11,790 --> 00:12:15,460
سأسحقُ النظامَ الذي أنشأتِه

133
00:12:15,460 --> 00:12:19,220
!سأستعيدُ الحقيقةَ التي دفنتِها

134
00:12:19,220 --> 00:12:21,960
...سأفعل... سأفعل

135
00:12:22,350 --> 00:12:24,880
!سأفعل

136
00:12:25,770 --> 00:12:27,520
الحقيقة؟

137
00:12:27,520 --> 00:12:33,640
أتريدُ إذاً أن تنبشَ هذه الحقيقة من قبرِها
إلى جانبِ الهيكل العظميّ لبورانكي؟

138
00:12:33,640 --> 00:12:38,650
سأحوّلُكم جميعاً إلى هياكل عظميّة إذاً
مثل أوبو تماماً

139
00:12:40,480 --> 00:12:44,430
ليتَ أعضاؤكم الداخليّة الحيويّة تغلي

140
00:12:48,000 --> 00:12:51,910
يا إلهي! لقد تحمّصَ أولئك الأطفال

141
00:13:00,710 --> 00:13:03,950
اللّعنة... لا ينبغي أن تكون بأقصى قوّة

142
00:13:11,090 --> 00:13:16,020
الجرائم المُرتكَبة بواسطة كازوكي ميغيوا لن تُمحَى أبداً

143
00:13:19,980 --> 00:13:21,520
من أنتِ؟

144
00:13:21,520 --> 00:13:23,070
وما أدراكِ بأمِّي؟

145
00:13:24,450 --> 00:13:25,820
توقّعتُ ذلك

146
00:13:25,820 --> 00:13:28,910
لديك نفس عينَيّ تِلك المرأة التي أمقتها

147
00:13:30,070 --> 00:13:31,530
!هذا يثيرُ اشمئزازي

148
00:14:15,450 --> 00:14:16,560
...كوغاني-تشان

149
00:14:17,800 --> 00:14:19,610
كوغاني-تشان، تماسكي

150
00:14:19,610 --> 00:14:21,680
عثرنا عليكما أخيراً

151
00:14:22,290 --> 00:14:23,380
...كينو-تشان

152
00:14:23,380 --> 00:14:25,660
عثرنا عليهما

153
00:14:33,180 --> 00:14:36,720
حسناً؟ ماذا سنفعلُ الآن أيتها القائدة؟

154
00:14:37,140 --> 00:14:39,380
لا أدري، لا تسأليني

155
00:14:39,380 --> 00:14:40,600
ماذا قلت؟

156
00:14:40,600 --> 00:14:43,050
اللّعنة، لماذا حدثَ هذا؟

157
00:14:43,050 --> 00:14:46,050
لو أغلقتُم أفواهكم وفعلتُم ما أُمليه عليكم فحسب

158
00:14:46,050 --> 00:14:48,540
لما خسِرَ الأوبو الخاص بي أمام إنتي

159
00:14:48,540 --> 00:14:51,110
!ماذا؟! هل تلقي اللّومَ علينا؟

160
00:14:51,110 --> 00:14:55,200
أجل، هذا صحيح، أنتُم من أعاقَ عملي

161
00:14:55,200 --> 00:14:56,620
!أنتُم فاشلاً

162
00:15:03,710 --> 00:15:06,020
لا تفجِّر غضبك على البوبوكي الخاصّ بك

163
00:15:06,020 --> 00:15:08,670
ماذا؟ إنها مجرَّد أدوات

164
00:15:08,920 --> 00:15:11,820
لا تنطِق ولا تشعر بالألم

165
00:15:11,820 --> 00:15:13,260
قلتُ لك توقّف

166
00:15:13,260 --> 00:15:16,560
ما رأيكِ أن أحطّمَ رأسكِ بدلاً من ذلك إذاً؟

167
00:15:16,560 --> 00:15:18,940
هذا مضحكٌ للغاية، جرِّب فحسب

168
00:15:18,940 --> 00:15:21,060
هيي-كن، كينو-تشان! توقّفا

169
00:15:21,060 --> 00:15:24,020
لا وقت للشجارِ فيما بينكما

170
00:15:24,020 --> 00:15:25,350
...كوغاني

171
00:15:25,850 --> 00:15:28,740
معكِ حقّ، سأتوقَّف

172
00:15:29,070 --> 00:15:31,780
بعد أن أقطِّعَ هذا الحقير

173
00:15:35,830 --> 00:15:37,080
!إنتي؟

174
00:15:38,500 --> 00:15:42,120
يا ابن ميغيوا، لدي أنباء سيّئة لك

175
00:15:42,120 --> 00:15:44,340
،للمرّة الأولى منذُ عشر سنوات

176
00:15:44,340 --> 00:15:47,380
سقطَ بورانكي من عشِّ بورانكي في السماء

177
00:15:47,790 --> 00:15:49,670
وهذا يعني

178
00:15:49,670 --> 00:15:55,780
أن الشخص الذي منعَ بورانكي من السقوط
في الأرض خلال  عشر سنوات

179
00:15:55,780 --> 00:15:59,680
أمّك كازوكي ميغيوا، قد ماتَتْ

180
00:16:01,600 --> 00:16:02,810
...أ-تشان

181
00:16:03,920 --> 00:16:05,860
...إنَّ كازوكي ميغيوا

182
00:16:05,860 --> 00:16:08,450
يجبُ على ميغيوا أن يبقى بمفردِه

183
00:16:08,450 --> 00:16:11,610
يجدرُ بك أن تذهب وتكون معها حالاً

184
00:16:14,460 --> 00:16:17,910
تِلك الكثافة الناريّة الحادّة، لن نصمد هكذا

185
00:16:17,910 --> 00:16:19,230
،إن اضطررتُ للموت

186
00:16:19,230 --> 00:16:22,390
اقليني كي أبدو لذيذاً

187
00:16:22,390 --> 00:16:24,290
ستحترقين بلمح البصر

188
00:16:24,820 --> 00:16:27,790
آسِفة لأنّ الأمور آلَتْ إلى هذا

189
00:16:27,790 --> 00:16:30,230
...لو لم أطلب منك المجيء

190
00:16:31,690 --> 00:16:34,330
...أنا آسفة، أنا آسفة

191
00:16:38,120 --> 00:16:40,560
شكراً يا كوغاني-تشان

192
00:16:40,930 --> 00:16:42,430
أ-تشان؟

193
00:16:42,750 --> 00:16:44,790
أمِّي ليسَتْ ميّتة

194
00:16:44,790 --> 00:16:49,150
فلو ماتَتْ لسقطَ أكثر بكثير من بورانكي واحد

195
00:16:51,370 --> 00:16:54,620
ينعتُ الناسُ أمِّي من كل أنحاء العالم بالساحرة

196
00:16:55,110 --> 00:16:57,320
لكنّها ليسَتْ ساحرة

197
00:16:58,730 --> 00:17:02,430
لا تزالُ تكدحُ بمفردِها في جزيرة الكنز

198
00:17:02,430 --> 00:17:04,000
إنها تحمي هذا العالم

199
00:17:04,620 --> 00:17:07,840
لِذا حان دوري الآن لأصعد إلى جزيرة الكنز بواسطة أوبو

200
00:17:07,840 --> 00:17:09,670
!وأحمي أمِّي

201
00:17:10,840 --> 00:17:14,170
!هذه عبارة تعيسة تخرجُ من فاهِ شخصٍ سيُشوَى حيّاً

202
00:17:16,750 --> 00:17:18,300
لن أموت

203
00:17:18,790 --> 00:17:21,390
لا، بل نموت

204
00:17:22,130 --> 00:17:24,020
...كوغاني-تشان وكلّكم

205
00:17:25,000 --> 00:17:28,620
لم تنعتوا أمِّي بالساحرة أبداً

206
00:17:29,080 --> 00:17:30,750
أسعدَني ذلك حقّاً

207
00:17:31,470 --> 00:17:32,530
شكراً لكم

208
00:17:33,060 --> 00:17:36,030
...بوبوكي، أطراف بورانكي

209
00:17:36,480 --> 00:17:39,010
وأمتلِكُ قلبَه

210
00:17:40,000 --> 00:17:42,170
!أحتاجُ لمُساعدتِكم

211
00:17:42,170 --> 00:17:44,500
ائتَمِنوا إليّ بكامِل البوبوكي المخصَّص لكم

212
00:17:44,850 --> 00:17:46,460
!لأنني أمتلِكُ قلبَه

213
00:17:50,620 --> 00:17:53,670
...أ-تشان... أنا... أنا

214
00:17:54,630 --> 00:17:57,410
حسناً! أنا امرأة أيضاً، سأنضمّ

215
00:17:57,410 --> 00:17:58,970
...موافقة إن كنّا سنبدأ كصديقَين

216
00:18:01,210 --> 00:18:02,560
...من منحَك الـ

217
00:18:03,740 --> 00:18:06,380
أغلِق فمك، أنتَ فتى

218
00:18:08,410 --> 00:18:10,050
!أوبو

219
00:18:25,180 --> 00:18:29,120
أي شخص يسري في عروقِه دماءُ كازوكي
يحاولُ أذيّة بانريو ريوكو وإنتي

220
00:18:29,120 --> 00:18:31,370
!سيُمسَح عن الوجود

221
00:18:47,490 --> 00:18:49,380
لسنا ندّاً لهم

222
00:18:49,380 --> 00:18:50,560
لا جدوى بعد؟

223
00:19:04,450 --> 00:19:07,970
ألا تؤثِّر قِوانا على الإطلاق؟

224
00:19:07,970 --> 00:19:08,870
!لا

225
00:19:09,280 --> 00:19:11,320
،إن حاولنا نحنُ الخمسة جميعاً إزالته بشكل منفصل

226
00:19:11,320 --> 00:19:12,830
فلا نستطيع حتّى هزيمة عدو بمفردِه

227
00:19:13,090 --> 00:19:16,130
لِهذا علينا إزالته بإرادة مُوحَّدة

228
00:19:18,010 --> 00:19:19,090
!قدم يُمنى

229
00:19:19,610 --> 00:19:20,840
!حـ-حاضرة

230
00:19:20,840 --> 00:19:21,930
!قدم يُسرى

231
00:19:21,930 --> 00:19:23,680
لا تصدِر الأوامر وكأنَّك زعيم

232
00:19:25,490 --> 00:19:26,600
!يد يُسرى

233
00:19:26,600 --> 00:19:27,620
!نعم

234
00:19:29,220 --> 00:19:30,270
!يد يُمنى

235
00:19:30,270 --> 00:19:31,400
!حاضِرة

236
00:19:31,400 --> 00:19:34,240
حان وقتُ الطيران يا ميغيتي-تشان

237
00:19:41,410 --> 00:19:42,860
!نجَحْنا

238
00:19:49,330 --> 00:19:50,400
!لم ننتهِ

239
00:20:29,810 --> 00:20:32,900
سأخرجُ للتخلُّصِ من بورانكي قد أسقطَه إنتي

240
00:20:32,900 --> 00:20:34,210
أمِّن لي قِطاراً

241
00:20:34,210 --> 00:20:35,250
حاضر

242
00:20:35,250 --> 00:20:37,420
ماذا سنفعلُ بخصوصِ الأطفال؟

243
00:20:37,420 --> 00:20:38,820
دعْهم

244
00:20:38,820 --> 00:20:41,230
،حالما أزيلُ البورانكي الساقِط

245
00:20:41,230 --> 00:20:45,050
سأقتلُهم مع كازوكي ميغيوا فحسب

246
00:20:50,860 --> 00:20:52,020
ريوكا-ساما؟

247
00:20:52,570 --> 00:20:55,100
!ريوكو-ساما، ريوكو-ساما

248
00:20:57,850 --> 00:20:59,330
!أيُّها القلب

249
00:20:59,330 --> 00:21:01,030
!هيّا، سنرحل

250
00:21:01,360 --> 00:21:05,510
...صاحِبُ دماء كازوكي الذي يرِثُ قلبَ بوبوكي

251
00:22:46,600 --> 00:22:48,470
كيف حالُ ريوكو-ساما؟

252
00:22:48,750 --> 00:22:51,460
أحسنت صنعاً يا سينباي

253
00:22:51,460 --> 00:22:55,640
...سُرِقُ أوبو، وأفلتَ مُستخدِمو البوبوكي الفتيان

254
00:22:55,640 --> 00:22:57,730
هذا حقاً عملٌ مُتقَن

255
00:22:57,730 --> 00:23:01,220
!سألتُك كيف حالُ ريوكو-ساما

256
00:23:02,950 --> 00:23:05,930
لم يتغيّرْ شيء

257
00:23:06,560 --> 00:23:09,650
يبقى الزمنُ متجمِّداً بالنسبة لريوكو-ساما

258
00:23:10,120 --> 00:23:14,340
لا تزالُ في الجسدِ البالِغ 16 عاماً
والذي حصلَتْ عليه منذُ 24 ساعة

259
00:23:15,390 --> 00:23:18,450
ماذا؟ ألن تنتظر ريوكو-ساما؟

260
00:23:18,450 --> 00:23:20,900
سأدعُك تعتني بريوكو-ساما

261
00:23:20,900 --> 00:23:23,580
سأستدعي بقيّةَ الآلهة الأربعة

262
00:23:25,050 --> 00:23:28,010
...سُرِقَ أوبو، سقطَ البورانكي

263
00:23:28,010 --> 00:23:31,560
يبدو أنَّ الأمور على وشك أن تُصبِحَ مُثيرة