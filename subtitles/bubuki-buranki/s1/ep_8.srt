1
00:00:03,360 --> 00:00:07,820
إنتيـه الخاصّ بريوكو قد حرقَ "المُستأصَل" الذي سقطَ من السماوات؟

2
00:00:08,290 --> 00:00:16,260
حالياً، البورانكي الوحيدان اللّذان
تنبضُ فيهما الحياة هما إنتيـه وأوبو

3
00:00:16,260 --> 00:00:18,490
هذه مسألة غاية في الخطورة

4
00:00:18,860 --> 00:00:23,500
يجبُ علينا استعادة التوازُن للعالم بأيدينا

5
00:00:30,000 --> 00:00:33,060
هل كنتُم تراقبون سيّداتي سادتي؟

6
00:00:34,360 --> 00:00:37,500
...البورانكي إنتيـه وبانريو ريوكو

7
00:00:37,500 --> 00:00:39,930
،لم يكُن هناك من يمثِّل أطرافَه

8
00:00:39,930 --> 00:00:44,780
لكن أعتقد أن شخصاً واحداً مؤهّلاً
ليمثِّل قلبه كافٍ لتشغيلِ بورانكي

9
00:00:44,780 --> 00:00:46,100
كيف؟ كيف؟

10
00:00:46,280 --> 00:00:50,100
يبدو أنّ للبورانكي المدعو إنتيـه سرٌّ ما

11
00:00:50,960 --> 00:00:52,170
مثل ماذا؟ مثل ماذا؟

12
00:00:52,170 --> 00:00:53,740
!وما أدراني أنا؟

13
00:00:54,860 --> 00:00:59,890
بانريو ريوكو، مستخدمة قلب إنتيـه
بورانكي أقصى الشرق

14
00:00:59,890 --> 00:01:03,080
قد حصلَتْ على قلبٍ آخر أيضاً

15
00:01:03,360 --> 00:01:06,210
لا يمكنُنا إهمال هذا

16
00:01:07,250 --> 00:01:10,710
!والآن لقد رُفِعَ الستار

17
00:01:10,990 --> 00:01:13,270
!حان الوقتُ لتستولوا على المسرح

18
00:03:02,160 --> 00:03:03,520
!ما الذي يفعله ذلك الرجل؟

19
00:03:04,990 --> 00:03:08,450
!أيُّها الغبيّ! ابتعد عن الطريق أيُّها البدين

20
00:03:24,340 --> 00:03:26,350
هل أنت بخير؟

21
00:03:28,280 --> 00:03:31,120
ما خطبُ هذا الرجل بالضبط؟

22
00:03:33,570 --> 00:03:35,500
هل شيزورو بخير؟

23
00:03:35,920 --> 00:03:37,890
ماذا تعني بـ"بخير"؟

24
00:03:37,890 --> 00:03:39,920
بدَتْ متوعِّكة للتو

25
00:03:39,920 --> 00:03:41,100
حقاً؟

26
00:03:41,970 --> 00:03:46,980
...حجر... إنسان

27
00:03:47,780 --> 00:03:51,590
ما الذي كان هذا الرجل يفعلُه بالسّير
في الجبالِ على أي حال؟

28
00:03:51,590 --> 00:03:54,550
كان يُمسِكُ بقيثارة، أهو موسيقيّ؟

29
00:03:54,550 --> 00:03:57,630
هذا البدينُ هو موسيقيّ؟

30
00:03:57,630 --> 00:03:58,590
!مستحيل

31
00:03:58,590 --> 00:04:00,180
!أنا لستُ بديناً

32
00:04:00,180 --> 00:04:02,760
!لستُ بديناً

33
00:04:02,760 --> 00:04:07,300
دهوني هي سِتار من اللّحمِ يرمزُ إلى طبيعة
قلبي الكبير

34
00:04:07,300 --> 00:04:11,070
أتودَّان لمس جسدي الفاتن الرّقيق؟

35
00:04:11,070 --> 00:04:12,680
المُساه، المُساه

36
00:04:12,880 --> 00:04:13,940
!المُساه

37
00:04:13,940 --> 00:04:16,300
هيراغي، هيراغي

38
00:04:16,300 --> 00:04:19,060
لنعد هذا الوحش إلى الغابة؟ مفهوم؟ مفهوم؟

39
00:04:19,060 --> 00:04:19,610
!نعم

40
00:04:19,880 --> 00:04:22,400
أيُّها البدين، من أنتَ بحقِّ السماء؟

41
00:04:22,680 --> 00:04:23,430
ماذا؟

42
00:04:23,960 --> 00:04:28,280
اسمي إيبيزو إيفانس

43
00:04:28,280 --> 00:04:31,700
وُلِدتُ في أمريكا وعمري 16 عاماً

44
00:04:32,750 --> 00:04:33,760
مرحباً يا إيبيزو

45
00:04:34,290 --> 00:04:36,020
اسمي أزوما كازوكي

46
00:04:36,020 --> 00:04:37,920
وُلِدتُ في جزيرةِ الكنز، عمري 16 عاماً

47
00:04:37,920 --> 00:04:40,810
أزوما، سُرِرتُ بلقائك

48
00:04:42,060 --> 00:04:43,600
سُرِرتُ بلقائك أيضاً

49
00:04:46,220 --> 00:04:48,440
ماذا؟ ما الذي يجري؟

50
00:04:49,440 --> 00:04:51,790
أصبحَ صديقاً لأمريكي بهذه البساطة

51
00:04:52,240 --> 00:04:55,180
أهذه هي القوّة التي يكتسبُها شخصٌ
ترعرعَ في بلاد أجنبية؟ جميل يا أزوما

52
00:04:55,990 --> 00:04:57,310
...ماذا؟ أنت

53
00:04:59,420 --> 00:05:03,820
أزوما، أحسُّ بقدَرٍ ما في داخلك

54
00:05:04,310 --> 00:05:05,680
كيف أصِفُ لك الأمر؟

55
00:05:05,680 --> 00:05:08,480
أشعرُ وكأنّنا وُلِدنا تحت نفس النّجم

56
00:05:11,590 --> 00:05:12,700
أيُّها البدين

57
00:05:12,700 --> 00:05:14,990
ماذا؟ بدين؟ بدين؟

58
00:05:14,990 --> 00:05:17,650
بدين؟ بدين؟ بدين؟ بدين؟

59
00:05:15,310 --> 00:05:17,650
لماذا لم تخلِ المكان؟

60
00:05:17,650 --> 00:05:18,890
ألم تسمع التحذيرات؟

61
00:05:18,890 --> 00:05:20,450
أُخلي؟ لماذا؟

62
00:05:20,450 --> 00:05:22,710
لأنّ المكان كان خطيراً جداً هناك

63
00:05:22,710 --> 00:05:25,080
،كانت الحرائق مشتعلة في كلّ مكان

64
00:05:25,080 --> 00:05:28,260
وكان البورانكي يتعاركون

65
00:05:28,260 --> 00:05:33,430
عِراك البورانكي ليسَ مشهداً نراه كلّ يوم

66
00:05:33,430 --> 00:05:36,690
الإخلاء هو ما تفعله الجِراء الصغيرة

67
00:05:37,020 --> 00:05:39,810
ماذا كنتَ تحاولُ أن تفعل أصلاً؟

68
00:05:40,910 --> 00:05:45,700
لا أصدِّقُ أنني تمكّنتُ من رؤية معركة
بورانكي حقيقيّة بعدما وصلتُ إلى اليابان

69
00:05:45,700 --> 00:05:49,240
!يا لَحسن الحظّ! نعم، إنه الحظّ، نعم، نعم

70
00:05:49,240 --> 00:05:52,330
أسألُك ما الذي كنتَ تحاولُ فعله

71
00:05:52,330 --> 00:05:53,010
ماذا؟

72
00:05:53,010 --> 00:05:57,490
أعرضُ عليك أن أقلك إلى أي مكان تُريد

73
00:05:57,490 --> 00:05:59,080
لِذا اخرج من هنا

74
00:05:59,520 --> 00:06:01,340
إلى أين أنتُم متوجِّهون؟

75
00:06:01,750 --> 00:06:03,410
...نحن في الواقع

76
00:06:04,180 --> 00:06:05,420
نحنُ نقضي رحلة

77
00:06:05,420 --> 00:06:07,620
رحلة؟ بمفردكم؟

78
00:06:07,620 --> 00:06:09,090
نعم، نحنُ الخمسة

79
00:06:09,330 --> 00:06:11,910
تركبون قطاراً؟ من تلقاءِ أنفسكم؟

80
00:06:11,910 --> 00:06:12,800
بالطبع

81
00:06:13,620 --> 00:06:14,750
مذهل

82
00:06:14,750 --> 00:06:16,020
مدهش

83
00:06:16,020 --> 00:06:17,060
رائع

84
00:06:17,060 --> 00:06:18,600
أنتُم هائلون

85
00:06:18,600 --> 00:06:20,730
الأسلوب الياباني في السّجود

86
00:06:20,730 --> 00:06:23,640
أرجوكم، خذوني معكم

87
00:06:23,640 --> 00:06:27,940
لا، إن بقيت معنا فستتعرّضُ لخطر أيضاً

88
00:06:28,310 --> 00:06:29,070
...لِذا

89
00:06:29,070 --> 00:06:30,640
نعم

90
00:06:30,640 --> 00:06:34,020
"في خطر" يعني "عين خطيرة"

91
00:06:34,560 --> 00:06:36,330
!أهلاً

92
00:06:36,330 --> 00:06:38,330
نعم، نعم، نعم، نعم، نعم

93
00:06:38,330 --> 00:06:38,920
نعم

94
00:06:38,920 --> 00:06:42,160
أي حيوان هو هذا بحقِّ السماء؟

95
00:06:40,540 --> 00:06:42,740
نعم، نعم، نعم، نعم

96
00:06:42,160 --> 00:06:45,230
أهنالِك أمثاله يعيشون في بلاد أجنبيّة؟

97
00:06:45,230 --> 00:06:47,840
العالم واسع... واسع جداً

98
00:06:49,160 --> 00:06:53,630
لا يوجدُ قلب... يبدو أنّه انتُزِع

99
00:06:53,630 --> 00:06:56,620
...المرأة التي تتحكّمُ بإنتيـه ريوكو

100
00:06:56,970 --> 00:06:59,850
لا أصدِّقُ أنّها انتزعَتْ كلّ الأطراف والقلب آنِفاً

101
00:07:00,270 --> 00:07:02,300
إنّها شيطانة ماكرة حقاً

102
00:07:02,300 --> 00:07:07,980
لكن أخينا الكبير والحكيم قد توقّعَ ظرفاً كهذا

103
00:07:08,260 --> 00:07:09,870
أليس كذلك يا ليوميلا؟

104
00:07:09,870 --> 00:07:12,660
نعم، هذا صحيح يا جيانا

105
00:07:12,660 --> 00:07:17,210
دِماغ أخينا الكبير الذي يُعادِلُ مُستوى ذكاء كمبيوتر فائق

106
00:07:17,210 --> 00:07:20,250
قد درسَ تحرُّكاتهم المُقبِلة منذُ زمن

107
00:07:20,250 --> 00:07:23,580
عينا أخينا الكبير ياقوت

108
00:07:24,270 --> 00:07:26,170
شفتاه كورود حمراء داميّة

109
00:07:27,170 --> 00:07:30,260
وشعره الذهبيّ المتلألئ الرَّفيع

110
00:07:31,840 --> 00:07:35,510
أخي الكبير، أخي الكبير، أخي الكبير

111
00:07:36,500 --> 00:07:40,660
ينبغي أن يكون ذلكما الاثنين ينفِّذان الآن الأوامر الصّادِرة

112
00:07:40,660 --> 00:07:42,970
عن أخينا الكبير، أليس كذلك يا جيانا؟

113
00:07:42,970 --> 00:07:45,850
نعم، أنا متأكِّدة أنّهما يفعلان ذلك يا ليودميلا

114
00:07:54,260 --> 00:08:01,040
اسمع، لقد قلتُ لك، إن كان لديك ما تقوله
فقلْه يا مُستخدم البوبوكي الرُّوسي الصغير

115
00:08:02,780 --> 00:08:04,600
...يا إلهي

116
00:08:08,750 --> 00:08:11,090
"لقد تمَّ استرجاع قلب "المُستأصَل

117
00:08:11,450 --> 00:08:13,520
هيّا يا أمبا، صِل إلى ديرسو

118
00:08:15,970 --> 00:08:18,510
اللّعنة، هل كان هذا الفتى طعماً؟

119
00:08:21,520 --> 00:08:23,750
!سحقاً، لقد هرَب

120
00:08:24,070 --> 00:08:25,760
لقد خدعونا

121
00:08:25,760 --> 00:08:28,560
لِهذا لم يكشفْ تفتيشُ الجسد أمرَه

122
00:08:28,820 --> 00:08:33,360
كان ذلك الطفل يتصرّفُ بمعزلٍ عن البوبوكي الخاصّ به

123
00:08:33,730 --> 00:08:36,080
شكراً لكسبِ الوقتِ لنا يا ديرسو

124
00:08:36,080 --> 00:08:38,050
أتاحَ لنا ذلك تحقيق هدفنا

125
00:08:41,580 --> 00:08:44,580
أيتها الفتاة الجميلة، ما اسمك؟

126
00:08:44,580 --> 00:08:47,360
اسمي أسابوكي كوغاني

127
00:08:47,360 --> 00:08:49,200
اسميبوكي كوغاني؟

128
00:08:49,200 --> 00:08:51,670
!إنه اسم جميل

129
00:08:51,670 --> 00:08:54,590
لا لا، أسابوكي كوغاني فقط

130
00:08:52,610 --> 00:08:54,590
من الواضح بأنّه ينوي البقاء

131
00:08:54,590 --> 00:08:58,090
آسف، لالا أسابوكي كوغانيقط

132
00:08:55,050 --> 00:08:58,090
إذا بقيتُ قرباً منه فترة أطول فقد أصبح سمينة مثله

133
00:09:05,680 --> 00:09:08,060
هاي-هو، سيلفر

134
00:09:09,520 --> 00:09:12,180
تبّاً، إنه العدوّ، العدوّ يُهاجمنا

135
00:09:14,770 --> 00:09:16,090
إيبيزو-سان؟

136
00:09:16,090 --> 00:09:20,540
أنتُم الفريقُ الياباني الذي يتحكّم
بالبورانكي الأبيض، أوبو

137
00:09:21,400 --> 00:09:25,500
وأزوما، أنتَ مستخدمُ قلبه، صحيح؟

138
00:09:25,870 --> 00:09:27,750
...إيبيزو، أنت

139
00:09:33,160 --> 00:09:35,800
إيبيزو، ما الأمر؟ أتتألَّم؟

140
00:09:36,210 --> 00:09:37,550
هل هُنالِك ما يُؤلمك؟

141
00:09:38,210 --> 00:09:39,530
...قلبي

142
00:09:39,530 --> 00:09:41,000
قلبك يُؤلمك؟

143
00:09:41,350 --> 00:09:42,810
...قلبي

144
00:09:43,480 --> 00:09:45,270
لا ينبض...

145
00:09:46,450 --> 00:09:49,520
توقّفَ قلبي كما ترى

146
00:09:54,420 --> 00:09:59,540
لهذا أريدُ قلبك يا أزوما

147
00:10:18,320 --> 00:10:20,870
!حذارِ، حذارِ

148
00:10:21,270 --> 00:10:23,720
!أورغلا، أتحاولُ قتل قائدك؟

149
00:10:26,350 --> 00:10:28,730
...قائد؟ إيبيزو، أنت

150
00:10:29,770 --> 00:10:32,900
نعم، أنا قائدُ فريق أمريكا

151
00:10:33,190 --> 00:10:36,030
...مستخدم قلب البورانكي ميغالارا

152
00:10:38,710 --> 00:10:40,200
آه أنا آسفة

153
00:10:42,890 --> 00:10:43,660
...هـ

154
00:10:43,660 --> 00:10:46,020
هذا صحيح، أنا قائدُ فريق أمريكا

155
00:10:46,020 --> 00:10:48,710
...مُستخدِم قلب البورانكي ماغالارا

156
00:10:54,680 --> 00:10:57,160
ماذا قلت؟ أنتَ مستخدمُ ماذا؟

157
00:10:57,160 --> 00:10:58,550
مروِّض؟

158
00:10:57,160 --> 00:10:59,800
ملاحظة: تسوكاي قد تعني مُستخدِم وقد تعني مُروِّض أيضاً

159
00:11:03,630 --> 00:11:05,050
هل كان ذلك أحد رِفاق البدين؟

160
00:11:09,180 --> 00:11:10,180
لا لا لا؟

161
00:11:10,180 --> 00:11:12,690
سأمسِكُ بك، سأمسِكُ بك، سأمسِكُ بك

162
00:11:13,710 --> 00:11:15,330
!آسفة، آسفة، آسفة

163
00:11:16,100 --> 00:11:19,050
أنا بخير، لا تقلقي يا دومينا

164
00:11:19,050 --> 00:11:20,900
...تسريحة البومبادور قد حمَتْ

165
00:11:21,310 --> 00:11:22,290
حسناً

166
00:11:22,290 --> 00:11:24,190
هيّا بنا يا فرح ودومينا

167
00:11:24,190 --> 00:11:25,490
!أنا متحمِّسة

168
00:11:25,490 --> 00:11:26,990
نعم، نعم، نعم

169
00:11:32,190 --> 00:11:32,790
اللّعنة

170
00:11:33,280 --> 00:11:35,820
سنقعُ في ورطة إن حطّموا القطار أكثر من ذلك

171
00:11:35,820 --> 00:11:37,050
كينوا، كوغاني

172
00:11:37,050 --> 00:11:37,630
!نعم

173
00:11:37,630 --> 00:11:38,490
!أجل

174
00:11:44,290 --> 00:11:47,310
أتعتقدون أنّكم قادرون على نصبِ كمينٍ لنا
دون طرح أي أسئلة؟

175
00:11:47,310 --> 00:11:49,350
من أنتُم بحقِّ السماء؟

176
00:11:49,780 --> 00:11:52,370
نحنُ البورانكي الأمريكي، ميغالارا

177
00:11:52,370 --> 00:11:54,010
،أنا يدُه اليمنى

178
00:11:54,600 --> 00:11:56,040
لويس غارسيا

179
00:11:56,560 --> 00:12:00,760
وأنا اليدُ اليُسرى من نفس البورانكي
فرح أوملاوف

180
00:12:01,670 --> 00:12:06,090
وأنا القدمُ اليُسرى من نفس البورانكي، أورغلا هارا

181
00:12:06,460 --> 00:12:08,650
!كذلك، كذلك، كذلك

182
00:12:08,650 --> 00:12:11,370
أنا قدمُه اليمنى، دومينا دورسي

183
00:12:13,730 --> 00:12:16,150
أهذه هي البوبوكي الخاصّة بهم؟

184
00:12:16,150 --> 00:12:19,040
سنُريهم البوبوكي خاصّتنا إذاً
العينُ بالعين

185
00:12:19,920 --> 00:12:22,040
!النّصر للأسرع

186
00:12:22,040 --> 00:12:23,720
هويمارو، هيميكيري

187
00:12:27,040 --> 00:12:30,010
...اللّعنة أظنّهما لم يتعافيا جيّداً بعد

188
00:12:30,450 --> 00:12:32,940
،يا فتاة السّيفَين

189
00:12:32,940 --> 00:12:35,270
لا حاجة لاستعجالِ موتكِ

190
00:12:35,270 --> 00:12:38,910
ينبغي أن تكوني في ملعب ما
تغزلين بعينيكِ

191
00:12:38,910 --> 00:12:40,570
وتهزِّين مؤخّرتكِ للفتيان أيّتها المشجِّعة

192
00:12:44,530 --> 00:12:47,420
لا تستهيني بالمُشجِّعات وقيادة التشجِّيع

193
00:12:47,420 --> 00:12:49,840
،تنكسرُ مؤخّراتنا عندما نشجِّع

194
00:12:49,840 --> 00:12:52,200
نصرخُ حتّى تتصدّع رؤوسنا
ونتعرَّقُ كالمجنونات

195
00:12:52,760 --> 00:12:55,650
الهُتاف معركة، إنها حرب

196
00:12:55,650 --> 00:12:59,110
أسوأ بكثير من الرجالِ الأغبياء الذين يشتهون
هذه الملابس الرسميّة

197
00:12:59,110 --> 00:13:02,490
والنِّساء الغبيّات اللّاتي يحكمن على المُشجِّعات
من مظهرهن فقط

198
00:13:02,490 --> 00:13:04,350
!هذا يستفزُّني حقاً

199
00:13:04,810 --> 00:13:07,970
مهلاً، ليس هذا ما قصدتُ حتّى

200
00:13:11,550 --> 00:13:14,670
هذا الزيّ الرسميّ هو درع مشجِّعة قتالي

201
00:13:14,670 --> 00:13:15,940
!بالتأكيد، بالتأكيد

202
00:13:18,070 --> 00:13:19,660
كينو-تشان، تماسكي

203
00:13:19,660 --> 00:13:21,680
شكراً يا ميغيتي-تشان

204
00:13:38,270 --> 00:13:41,490
تخيّل! القلب بحدِّ ذاته يظهرُ في ساحة المعركة

205
00:13:41,840 --> 00:13:43,760
!يا لشجاعتك

206
00:13:43,760 --> 00:13:45,500
!ليس تماماً

207
00:13:47,940 --> 00:13:51,570
هذا هو الموقف المُتوقَّع من قائد

208
00:13:51,570 --> 00:13:53,400
اهدأ يا إيبيزو

209
00:13:53,400 --> 00:13:56,020
القلب الذي لا يعمل لن يكون إلّا عائقاً أمامنا

210
00:13:55,190 --> 00:13:56,020
!لا

211
00:13:56,020 --> 00:14:00,150
سأقاتلُ أزوما لأنّ قلبي عقيم وعديم الجدوى

212
00:14:00,380 --> 00:14:04,610
العودة من شفا حُفرة الهزيمة إلى الفوز
هي أكثر المشاعر إثارة على الإطلاق

213
00:14:04,900 --> 00:14:07,840
ناهيك عن أنّني سأنتزعُ ذلك القلب من أزوما

214
00:14:07,840 --> 00:14:10,110
وأعيد البورانكي ميغالارا إلى الحياة

215
00:14:10,450 --> 00:14:11,990
...نعم! نعم! نـ

216
00:14:12,890 --> 00:14:15,210
قلتُ لك أنتَ تعرقلُ عملنا

217
00:14:16,340 --> 00:14:17,850
عُـ... عُلِم

218
00:14:19,280 --> 00:14:22,780
إيبيزو غبيّ حقاً وأسوأ ما فيه عِناده

219
00:14:23,460 --> 00:14:26,690
لكن وجوده هُنا هو الذي يجمعُنا ككتلة واحدة

220
00:14:26,690 --> 00:14:29,670
نعم، باعتبار أنّ رأسه فارغ تماماً

221
00:14:29,670 --> 00:14:32,720
إنّه مِثالي لحشو كلّ أحلامنا فيه

222
00:14:32,940 --> 00:14:35,220
لا تمدحاني كثيراً

223
00:14:35,840 --> 00:14:36,890
!أنتُما تُحرجاني

224
00:14:37,260 --> 00:14:39,000
!لم يكن ذلك مديحاً

225
00:14:39,000 --> 00:14:39,940
...هكذا إذاً

226
00:14:40,530 --> 00:14:43,800
إيبيزو هو قائد جيّد لكم إذاً، صحيح؟

227
00:14:45,340 --> 00:14:49,250
يُشارِكُ قلبُكم شخصياً في المعارك؟

228
00:14:49,250 --> 00:14:54,950
نعم، لا يستطيعُ قلبنا أن يقف مكتوف الأيدي
وهو يرى زُملائه يُقاتلون

229
00:14:55,900 --> 00:14:58,080
لكن هذا مِثاليّ بالنسبةِ لنا

230
00:14:58,080 --> 00:15:01,580
آسف، لكن لأجلِ إيبيزو، سنأخذُ قلبَك

231
00:15:05,360 --> 00:15:07,630
الآن يا أزوما، عليك به

232
00:15:10,830 --> 00:15:13,220
أزوما؟ ماذا حدث يا أزوما؟

233
00:15:13,600 --> 00:15:15,600
ما الذي يجري؟

234
00:15:16,020 --> 00:15:18,430
...لا يخرج القلبُ منِّي

235
00:15:19,780 --> 00:15:22,070
لا أستطيعُ استخدام رينزو خاصّتي أيضاً؟

236
00:15:25,350 --> 00:15:29,480
...حجر، إنسان

237
00:15:30,880 --> 00:15:34,570
لم تعودي حجراً متألِّقاً جميلاً الآن

238
00:15:37,310 --> 00:15:41,750
زُملاؤكِ يُقاتلون بينما تقِفين هُنا دون أن تفعلي شيئاً؟

239
00:15:42,230 --> 00:15:45,670
أم أنّ رفاقكِ قد تخلّوا عنكِ؟

240
00:15:49,630 --> 00:15:51,050
!ا-اختفَتْ؟

241
00:15:53,620 --> 00:15:55,800
!يمتلكُ ذلكما الاثنان القلب

242
00:15:55,800 --> 00:15:57,310
...لهذا أتينا إلى هُنا

243
00:15:57,900 --> 00:16:00,210
لنزهق روحك...

244
00:16:00,680 --> 00:16:02,600
من أنتُما أيّتّها النّكرتان؟

245
00:16:02,600 --> 00:16:04,270
!تبّاً

246
00:16:04,560 --> 00:16:06,010
نحن

247
00:16:06,010 --> 00:16:08,690
البورانكي الروسيّ، زانبازا

248
00:16:08,690 --> 00:16:10,610
أنا يدُه اليمنى، ليودميلا

249
00:16:11,120 --> 00:16:13,570
وأنا يدُه اليُسرى، جيانا

250
00:16:13,570 --> 00:16:15,660
إيِّاكِ والمُقاومة

251
00:16:15,660 --> 00:16:18,550
سلِّمينا حياتكِ فحسب

252
00:16:23,020 --> 00:16:24,120
!مسكينة

253
00:16:24,420 --> 00:16:28,080
كما قلتِ، إنّها بعيدة تماماً عمّا وصفه سينسي لنا

254
00:16:28,080 --> 00:16:29,450
سينسي؟

255
00:16:29,450 --> 00:16:34,430
لقد درّبَنا تسووابوكي-سينسي القتال ذات مرّة

256
00:16:34,770 --> 00:16:41,600
هذا صحيح، قامَ سينسي بتلميعِنا نحن المُجوهرتَين الخامّتين
ليجعلنا ألماستَين متلألئتَين

257
00:16:42,010 --> 00:16:43,920
...لكن قال لنا سينسي

258
00:16:44,440 --> 00:16:47,810
بأنّ هُناك عبقريّ في يابونيا يتفوّقُ علينا

259
00:16:48,920 --> 00:16:52,320
لا أتخيّلُ أبداً أن يوجد عبقريّ أعظم منّا

260
00:16:52,990 --> 00:16:54,580
شيزورو تانيومي

261
00:16:54,580 --> 00:16:57,990
عليكِ أن تُرينا حجمَ قوّتكِ

262
00:17:02,030 --> 00:17:04,050
سمعتُ أنّ مُستخدمي البوبوكي الرّوسيين

263
00:17:04,050 --> 00:17:08,840
هُم آخر عشيرة من القتَلة المأجورين المحترفين

264
00:17:09,330 --> 00:17:13,340
كم حالتنا يُرثَى لها

265
00:17:13,760 --> 00:17:18,850
لقد أفسدنا الأمر هذه المرّة، أليس كذلك؟

266
00:17:22,040 --> 00:17:25,380
،والآن لننضمّ إلى ليودميلا-ساما وجيانا-ساما

267
00:17:25,380 --> 00:17:27,230
ونعود إلى مكسيم-ساما

268
00:17:32,240 --> 00:17:34,190
!اللّعنة

269
00:17:34,190 --> 00:17:35,950
بسُرعة، بسُرعة، بسُرعة

270
00:17:36,640 --> 00:17:40,110
!أرجوك... أرجوك، بسُرعة

271
00:17:46,750 --> 00:17:47,920
ريوكو-ساما

272
00:17:47,920 --> 00:17:50,350
الحمدُلله... الحمدُلله

273
00:17:50,350 --> 00:17:51,510
...سويا

274
00:18:04,100 --> 00:18:06,600
كلّ شيء على ما يُرام الآن يا ريوكو-ساما

275
00:18:07,440 --> 00:18:08,790
كلّ شيء على ما يُرام الآن

276
00:18:09,410 --> 00:18:11,560
سويا معكِ

277
00:18:11,560 --> 00:18:13,440
يمكنُكِ أن ترتاحي الآن

278
00:18:14,140 --> 00:18:15,470
حقاً؟

279
00:18:15,470 --> 00:18:18,950
نعم، صدّقيني، سأبقى دوماً معكِ

280
00:18:19,330 --> 00:18:22,070
...دوماً... دوماً

281
00:18:31,200 --> 00:18:34,640
...أعتقدُ أن ذلك الرجل هو معلّم ليودميلا-ساما وجيانا-ساما

282
00:19:01,420 --> 00:19:04,490
الجرذان، لقد هربا

283
00:19:07,330 --> 00:19:09,630
يتمتّعُ بروح صلبة

284
00:19:09,630 --> 00:19:11,690
ما زلتُ أرتجف

285
00:19:12,250 --> 00:19:15,500
إنه ليس كما وصفَتْه ليودميلا-ساما وجيانا-ساما

286
00:19:15,850 --> 00:19:19,370
على رسلِك... أهذا ما تقوله في النّهاية رغمَ ندرة كلامك؟

287
00:19:19,960 --> 00:19:21,840
هل كنتَ واثقاً من فوزنا؟

288
00:19:22,270 --> 00:19:26,350
سيكونُ من المُؤسِف قتل معلِّم ليودميلا-ساما وجيانا-ساما

289
00:19:26,640 --> 00:19:28,310
أنتَ واثقٌ إذاً

290
00:19:28,310 --> 00:19:32,070
لكن حسبما أرى، إن قاتلناهُ حينئذ

291
00:19:32,070 --> 00:19:34,860
سنخسرُ أنا وأنت رأسَينا

292
00:19:35,250 --> 00:19:36,360
عمل
جيّد
جدّاً

293
00:19:36,360 --> 00:19:37,860
عمل جيّد جدّاً
لكن ثابِر أكثر

294
00:19:41,330 --> 00:19:43,340
!اللّعنة

295
00:19:43,340 --> 00:19:47,120
حسناً، لا يوجدُ شخصٌ إلّا وهُناك من هو أفضل منه

296
00:19:52,370 --> 00:19:54,880
بانريو

297
00:19:55,240 --> 00:19:58,630
...لا وقت، لا وقت

298
00:20:02,140 --> 00:20:04,340
لا وقت على الإطلاق

299
00:20:06,540 --> 00:20:10,490
إيِّاكِ والظنّ أنّكِ المُميَّزة الوحيدة

300
00:20:10,490 --> 00:20:15,870
...هذا صحيح، تسوابوكي-سينسي قد حدّثنا عنكِ

301
00:20:16,680 --> 00:20:19,820
حدّثكما... عمّاذا حدّثكما؟

302
00:20:19,820 --> 00:20:21,900
لا، لن نتكلّم

303
00:20:21,900 --> 00:20:23,470
لكن كانَتْ مُفاجأة

304
00:20:23,470 --> 00:20:26,370
لم أتوقّع أن يقول كلاماً كهذا

305
00:20:26,370 --> 00:20:31,080
...نعم، لا أتخيّلُ أبداً أن تصدر تِلك الكلمات

306
00:20:31,080 --> 00:20:33,720
من فاهِ سينسي

307
00:20:35,930 --> 00:20:37,050
...جيانا

308
00:20:41,130 --> 00:20:42,380
!بوشتيزيني

309
00:20:45,980 --> 00:20:51,180
ماذا؟ أهذا كُل ما يستطيعُ قلب البورانكي أوبو فعله؟

310
00:20:51,560 --> 00:20:53,850
أزوما، تماسك

311
00:20:59,540 --> 00:21:02,490
أزوما، ما خطبك؟

312
00:21:12,300 --> 00:21:13,240
...أنت

313
00:21:15,340 --> 00:21:16,780
...القلب

314
00:21:18,070 --> 00:21:21,000
توقّفَ قلبُ أوبو

315
00:21:21,280 --> 00:21:22,410
ماذا قلت؟

316
00:21:42,310 --> 00:21:43,030
!هيراغي

317
00:21:46,260 --> 00:21:49,030
نعم يا أورغلا، واظِب على ذلك

318
00:21:49,630 --> 00:21:53,540
سيصمدُ رينزو هذا الرّمح دقيقة أخرى على الأكثر

319
00:21:59,470 --> 00:22:00,460
...أزوما

320
00:22:01,530 --> 00:22:03,300
،أنتَ مثلي تماماً الآن

321
00:22:04,210 --> 00:22:06,790
قلب بِلا نبض