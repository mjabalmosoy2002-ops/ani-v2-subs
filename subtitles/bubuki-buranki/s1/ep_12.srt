1
00:00:04,170 --> 00:00:06,970
اسمي بانريو ريوكو

2
00:00:07,450 --> 00:00:09,820
،وُلِدتُ كمُستخدِمة قلب مؤهّلة

3
00:00:09,820 --> 00:00:12,690
.وارثةً قلبَ إنتيـه من أمِّي

4
00:00:13,210 --> 00:00:15,410
،في ربيع عامي السّادس عشر

5
00:00:15,920 --> 00:00:18,630
قيلَ لي أنّه بقي من عمري ثلاث سنواتٍ فقط

6
00:00:19,040 --> 00:00:23,790
.لهذا أردتُ أن أتركَ دليلاً على أنّني قد عشت

7
00:00:29,550 --> 00:00:31,500
...بالمناسبة يا ريوكو

8
00:00:31,940 --> 00:00:36,260
لديّ حبيبٌ الآن، سأعرّفُك إليه في وقت ما

9
00:00:38,320 --> 00:00:39,830
!ماذا؟

10
00:00:42,800 --> 00:00:45,360
أ-ألديكِ حبيب يا ميغيوا؟

11
00:00:45,360 --> 00:00:46,010
نعم

12
00:00:46,530 --> 00:00:50,360
لا أصدِّق أنّكِ أنتِ تحديداً قد حصلتِ
على حبيبٍ قبلي

13
00:00:50,360 --> 00:00:52,510
!قبلي أنا، ريوكو-ساما

14
00:00:52,860 --> 00:00:55,240
!هُنا! لقد وجدتُه أخيراً

15
00:00:55,240 --> 00:01:01,700
إنّه نصٌّ يُلمّحُ إلى علاقة إنتيـه وطيدة وقديمة
بمفهوم الخلود

16
00:01:01,700 --> 00:01:04,120
ريوكو، انظري إلى هذا

17
00:01:05,830 --> 00:01:06,750
حسناً

18
00:01:10,090 --> 00:01:11,350
...ميغيوا

19
00:01:12,280 --> 00:01:15,670
لقد حرقتِ يدَيّ وقدمَيّ ذات يوم

20
00:01:16,130 --> 00:01:18,920
حان دوركِ الآن لتحترقي حيّة

21
00:01:24,620 --> 00:01:27,090
قصر كازوكي
(قصر بانريو الآن)

22
00:01:29,170 --> 00:01:30,360
!ميغيوا-ساما

23
00:01:30,360 --> 00:01:33,650
بانريو ريوكو وأتباعها قد أشعلوا ثورةً في أوينو

24
00:01:31,840 --> 00:01:34,770
كازوكي ميغيوا      16 عاماً

25
00:01:33,650 --> 00:01:35,280
لقد استدعوا إنتيـه

26
00:01:36,400 --> 00:01:38,680
استدعوا بورانكي أمام المدنيين؟

27
00:01:38,680 --> 00:01:40,530
هل جنّتْ بانريو؟

28
00:01:42,140 --> 00:01:45,450
غينما-سان، يوشيكي-سان... سأدخلُ أوبو

29
00:01:47,070 --> 00:01:47,910
!حالاً

30
00:01:48,820 --> 00:01:52,590
اقطعوا عقودَكم مع البوبوكي الخاصّة بكم
وامنحوها إيّاي

31
00:01:54,020 --> 00:01:57,690
سيّدتي، طلبكِ مُبالَغٌ به كثيراً أيّاً كانت الظروف

32
00:01:59,430 --> 00:02:02,580
سأوقِفُ ريوكو بنفسي

33
00:02:05,490 --> 00:02:07,470
سأكرّرُ كلامي مرّة أخرى أيُّها النّاس

34
00:02:05,910 --> 00:02:09,260
بانريو ريوكو      16 عاماً

35
00:02:07,950 --> 00:02:11,440
لا حاجة لبقائكم معي بعد الآن

36
00:02:12,220 --> 00:02:14,680
عمّاذا تتكلّمين؟ مشاعركِ بارِدة

37
00:02:14,680 --> 00:02:17,940
بصفتِنا حُلفاء غير مُحتمَلين، سنتشاطرُ مصيراً واحداً جميعاً

38
00:02:19,190 --> 00:02:20,740
هذا صحيح يا ريوكو

39
00:02:24,490 --> 00:02:27,130
سنُخرِجُ البورانكي في وضح النّهار

40
00:02:27,130 --> 00:02:30,750
ونكشف عن التّاريخ الذي أخفاهُ الكِبار

41
00:02:31,020 --> 00:02:32,950
!سنغيّرُ العالم

42
00:02:32,950 --> 00:02:33,970
!نعم

43
00:02:41,590 --> 00:02:42,970
...ميغيوا

44
00:03:08,660 --> 00:03:10,270
!ما الذي حدثَ بالضبط؟

45
00:03:10,270 --> 00:03:11,660
!ما الأمر يا ريوكو؟

46
00:03:12,360 --> 00:03:15,420
...أحسُّ بألم إنتيـه

47
00:03:32,540 --> 00:03:33,740
!ريوكو-ساما

48
00:03:33,740 --> 00:03:36,550
ما تِلك القوّة بالضبط؟

49
00:03:36,550 --> 00:03:39,760
ظننتُ أنّها طلبَتْ من موموكا-نيسان والآخرين
قطع عقودهم

50
00:03:39,760 --> 00:03:42,140
كي تتمكّن من التحكُّمِ بأوبو بنفسِها

51
00:03:46,440 --> 00:03:50,220
...كانت هذه الطريقة الوحيدة لإنقاذكِ

52
00:03:50,220 --> 00:03:52,460
أنا آسفة يا ريوكو

53
00:03:57,140 --> 00:04:01,460
...إذا سحقتُ قلبَ إنتيـه، فإنّ جسد ريوكو قد

54
00:04:03,090 --> 00:04:05,970
ريوكو، أنتِ وأنا واحد

55
00:04:06,690 --> 00:04:08,930
!لن أدعكِ تموتين

56
00:04:32,300 --> 00:04:33,310
...إنتيـه

57
00:04:34,520 --> 00:04:36,350
اعتنِ بريوكو

58
00:04:39,520 --> 00:04:42,870
بعد ثماني سنوات

59
00:04:45,970 --> 00:04:48,930
بانريو ريوكو       العمر 24

60
00:04:49,320 --> 00:04:53,170
توقّفَ جسدُ بانريو ريوكو عن النّضوج منذُ ثماني سنوات

61
00:04:51,840 --> 00:04:53,470
.تبدين بخير

62
00:04:53,840 --> 00:04:58,280
ميغيوا، كنتِ تعلمين بقدرة إنتيـه الخاصّة، صحيح؟

63
00:04:58,860 --> 00:05:02,390
،لهذا سحقتِ قلبَ إنتيـه

64
00:05:02,390 --> 00:05:05,600
.ممّا جعلَني بديلته

65
00:05:05,600 --> 00:05:10,120
.لقد كانَتْ قوّة إنتيـه هي التي أبقَتْني على قيدِ الحياة

66
00:05:12,840 --> 00:05:16,040
لكن أهذه أنا حقّاً؟

67
00:05:16,810 --> 00:05:22,000
فأنا أحدِّقُ كلّ يوم بهذا الوحش الذي لا يشيخ أبداً
وهو يُبادلني النّظرات

68
00:05:22,730 --> 00:05:25,170
سأصعدُ إلى عشِّ البورانكي

69
00:05:27,330 --> 00:05:32,810
لقد قرّرتُ الصعود إلى هُناك بينما لا يزالُ
أوبو يُصغي إليّ

70
00:05:34,170 --> 00:05:36,600
سأتركُ زمام الأمور هنا في الأرض بين يديكِ

71
00:05:38,600 --> 00:05:42,160
!بعدما حبستِني هُنا لثماني سنوات؟

72
00:05:42,590 --> 00:05:45,190
فعلتُ ذلك لأحميكِ من العالم

73
00:05:45,730 --> 00:05:47,150
افهمي أرجوكِ

74
00:05:50,830 --> 00:05:52,240
!ميغيوا

75
00:05:52,240 --> 00:05:56,160
!لن أسامحكِ أبداً

76
00:05:56,160 --> 00:05:57,750
إيّاكِ والهرب يا ميغيوا

77
00:05:58,280 --> 00:05:59,270
...ميغيوا

78
00:06:04,800 --> 00:06:06,260
كازوكي

79
00:06:07,570 --> 00:06:09,130
ريوكو-ساما؟

80
00:06:09,690 --> 00:06:11,390
أنتِ ريوكو-ساما، صحيح؟

81
00:06:13,010 --> 00:06:17,390
...أرجوكم يا ناس... لا تسخروا من شكلي

82
00:06:17,390 --> 00:06:20,310
!أشكرُ اللّه على سلامتكِ

83
00:06:20,900 --> 00:06:22,910
!أنا غاية في السّرور

84
00:06:22,910 --> 00:06:27,890
!كنتُ أخشى كثيراً من تعرّضكِ لتعذيب أو ما شابه

85
00:06:27,890 --> 00:06:30,110
سيكونُ سو الصّغير متحمّساً أيضاً

86
00:06:30,540 --> 00:06:35,500
قلِقَ شوساكو عليكِ كثيراً لدرجةٍ قد ابيضَّ شعرُه

87
00:06:35,500 --> 00:06:37,700
!اصمت! هذا ليس من شأنِك

88
00:06:38,140 --> 00:06:42,330
ريوكو، تبدين بهذا المظهر بسببِ قوّة إنتيـه، صحيح؟

89
00:06:43,840 --> 00:06:44,860
أجل

90
00:06:44,860 --> 00:06:47,030
!ستبقين شابّة للأبد إذاً

91
00:06:47,030 --> 00:06:49,760
!أغارُ منكِ غيرة شديدة

92
00:06:49,760 --> 00:06:54,780
ذات يوم، سأحظى بشباب أبديّ أيضاً

93
00:07:02,220 --> 00:07:03,730
،شكراً

94
00:07:04,230 --> 00:07:05,300
يا جماعة

95
00:07:08,880 --> 00:07:12,240
الضوء الذي برَقَ في سماء العالم

96
00:07:12,240 --> 00:07:15,830
أوقفَ قلوبَ كافّة البورانكي على الأرض

97
00:07:16,520 --> 00:07:20,660
بغيابِ البورانكي، غرِقَ العالمُ في فوضى ودمار

98
00:07:21,800 --> 00:07:25,670
وتغيّرتُ أنا ككائنة بشريّة

99
00:07:28,610 --> 00:07:31,120
الأفواج الآليّة وأفواج الدبّابات

100
00:07:29,230 --> 00:07:33,670
بانريو ريوكو     العمر 30

101
00:07:31,120 --> 00:07:35,150
قد بدأت بالانتشار عبرَ الطّرُق
البحريّة الغربيّة والجنوبيّة

102
00:07:36,200 --> 00:07:37,310
ريوكو-ساما؟

103
00:07:42,280 --> 00:07:45,060
...يصطادون ويقتلون مُستخدمي البوبوكي

104
00:07:45,630 --> 00:07:49,070
كيف يفعلون هذا بباقي البشر؟

105
00:07:49,850 --> 00:07:54,120
لا حاجة لقتلِ حتّى الأطفال فقط لكونِهم يستطيعون
استخدام البوبوكي

106
00:07:54,120 --> 00:07:56,130
رُبَّما لأنّهم أطفال تحديداً

107
00:07:56,550 --> 00:07:59,080
يقتلونهم قبل أن يتعلّموا استخدام
الرّينزو خاصّتهم

108
00:08:00,210 --> 00:08:04,380
لن أقبل بمثل هذا العالم المجنون

109
00:08:05,480 --> 00:08:09,620
زيتسوبي-سان، عودي من فضلكِ إلى قصر بانريو
وأبلغي ريوكو-ساما عن هذا الأمر

110
00:08:10,310 --> 00:08:11,840
ثمّة شيء يجبُ عليّ فعله

111
00:08:21,990 --> 00:08:25,820
قامت القوّات بقطعِ الاتِّصالات بين المُستوطنات المحلّية والخارج

112
00:08:25,820 --> 00:08:29,610
يبدو أنّهم يعزلونهم ويُحاصرونهم ويُبيدونهم

113
00:08:29,610 --> 00:08:31,010
اللّعنة

114
00:08:31,010 --> 00:08:34,960
وهل سيبقى غينما صامِتاً عمّا يجري؟

115
00:08:34,960 --> 00:08:37,110
أين هو بحقّ السماء على أي حال؟

116
00:08:37,110 --> 00:08:41,630
بقي أسابوكي غينما مفقوداً مع الرايجودو

117
00:08:41,630 --> 00:08:43,620
الذي سرقَه من الأوبو السّاقِط

118
00:08:44,680 --> 00:08:47,500
...ذلك الحُثالة الضعيف

119
00:08:51,800 --> 00:08:56,110
ميغيوا، كنتِ تعلمين بأنّ هذا سيحدثُ حالما أوقفتِ

120
00:08:56,110 --> 00:08:58,370
قلوبَ كافّة البورانكي على الأرض

121
00:08:59,250 --> 00:09:03,580
بزوالِ البورانكي، دُفِعَ البشرُ بواسطةِ خوفهم

122
00:09:03,580 --> 00:09:05,840
لقتلِ بَني جنسهم مجدّداً

123
00:09:06,530 --> 00:09:09,820
.العالم مليء بالحمقى ضيِّقي التّفكير

124
00:09:13,120 --> 00:09:14,980
حضِّروا التوابيت

125
00:09:17,200 --> 00:09:20,050
احذروا من الأعداء لكن تحرّكوا بسُرعة

126
00:09:20,430 --> 00:09:22,040
انتبهوا من الخلف كذلك

127
00:09:24,180 --> 00:09:25,310
!تشكيل خاصّ بالمعارك

128
00:09:48,560 --> 00:09:49,780
...أكيهيتو

129
00:09:50,500 --> 00:09:54,120
...ريوكو-ساما، أنا... أنا

130
00:09:54,120 --> 00:09:57,820
تبدو حقّاً كوحش آكِل للبشر الآن

131
00:10:01,560 --> 00:10:04,780
أنت مِثالي جدّاً للانضمامِ إلى موكبِنا الجنائزي

132
00:10:11,560 --> 00:10:15,950
...المعذرة، لم أتوقّعْ كلّ هذه الثلوج

133
00:10:17,940 --> 00:10:20,470
!ما-ما هذا؟

134
00:10:21,200 --> 00:10:24,210
...رئيس وزراء اليابان رقم 107

135
00:10:25,100 --> 00:10:29,340
أنت من أصدرَ الأمر باصطيادِ وقتل
كافّة مُستخدمي البوبوكي، أليس كذلك؟

136
00:10:29,340 --> 00:10:31,060
!بانريو ريوكو

137
00:10:31,060 --> 00:10:32,980
!كـ-كان قرار مجلس الوُزراء

138
00:10:33,880 --> 00:10:36,820
،هذا يعني أنّ مسؤوليّة ذلك تقعُ على عاتقِك

139
00:10:36,820 --> 00:10:39,320
!كقائد لهذا البلد

140
00:10:41,640 --> 00:10:43,530
هل ستقتلينني؟

141
00:10:43,530 --> 00:10:48,740
إنّ رجلاً مثلك قد قتلَ حتّى الرُضَّع
ليضمن بقائه

142
00:10:48,740 --> 00:10:50,870
!لا يستحقُّ أن يعيش

143
00:10:51,460 --> 00:10:54,750
...سيّدي، لقد وصلَتْ رِسالة عاجِلة إلى منزلِك

144
00:10:56,000 --> 00:10:56,830
سيّدي؟

145
00:11:05,680 --> 00:11:09,180
أمين السرّ
إتشيتو كوتيتسو

146
00:11:06,070 --> 00:11:09,180
إتشيتو كوتيتسو، أليس كذلك؟

147
00:11:09,520 --> 00:11:10,570
...نـ-نعم

148
00:11:10,570 --> 00:11:13,600
سأجعلُك رئيس هذا البلد

149
00:11:14,230 --> 00:11:19,110
ستقضي حياتك دُمية لي

150
00:11:30,440 --> 00:11:35,630
لقد زجَّ ذلك الحقير غاي بقوّات ديموكراتيا
في هذه الحرب في اللّحظة الحرِجة

151
00:11:35,920 --> 00:11:38,680
لن يصمد حاجز الجزيرة في هذه الحالة

152
00:11:38,680 --> 00:11:40,070
.بل أسوأ من ذلك

153
00:11:40,070 --> 00:11:43,420
سيسقطُ مدارُه في الأرض

154
00:11:43,420 --> 00:11:48,000
ستُرسَمُ خريطةُ العالم مرّة أخرى حرفياً إذاً

155
00:11:48,000 --> 00:11:51,770
سيموتُ عددٌ لا يُحصى من النّاس

156
00:12:07,690 --> 00:12:11,100
أيّتها الوحش التي حملَتْ بطفل
وسلّمَت البوبوكي الخاصّة بها

157
00:12:11,100 --> 00:12:13,670
...لكن مع ذلك لم تستخدمي قوّتكِ

158
00:12:16,220 --> 00:12:18,760
موتي مع البورانكي

159
00:12:18,760 --> 00:12:22,300
الذي تخلّى عن البشر لمُحاولة حماية
هذه الجزيرة يا ميغيوا

160
00:12:24,790 --> 00:12:27,050
اتركي أمِّي يا ريوكو

161
00:12:27,380 --> 00:12:28,810
...أوبو

162
00:12:28,810 --> 00:12:31,770
!ابتعدوا عن طريقي

163
00:12:38,440 --> 00:12:43,600
لا أتحمّلُ عينيكِ تِلكما اللّتان تستخفّان بالجميع

164
00:12:45,110 --> 00:12:45,950
!أمِّي

165
00:13:00,400 --> 00:13:01,580
عُملاق

166
00:13:06,470 --> 00:13:07,820
!حرب نوويّة تكتيكيّة؟

167
00:13:07,820 --> 00:13:10,460
إذا افترضنا أنّ غايتهم هي تدمير وإسقاط
عشّ البورانكي

168
00:13:10,460 --> 00:13:12,140
.ستكونُ تِلك النتيجة منطقيّة

169
00:13:12,650 --> 00:13:16,140
لا البوبوكي ولا الأجسام تستطيعُ تحمُّل هذا

170
00:13:16,410 --> 00:13:20,110
!هذا لا يعني أن نقِفَ مكتوفي الأيدي

171
00:13:24,860 --> 00:13:28,080
ميغيوا، أنتِ الفتاة التي لن أسامحها أبداً

172
00:13:30,610 --> 00:13:32,510
!أيّتها الوحش

173
00:13:42,830 --> 00:13:46,470
إنتيـه، استمرّ في الاعتناءِ بريوكو أرجوك

174
00:13:54,080 --> 00:13:54,970
!ميغيوا؟

175
00:14:08,530 --> 00:14:09,570
!أمِّي

176
00:14:34,850 --> 00:14:36,010
!أزوما

177
00:14:36,010 --> 00:14:37,070
!ماذا تفعل؟

178
00:14:37,070 --> 00:14:39,560
أ-تشان، ما الأمر؟ علينا أن نُسرِع

179
00:14:41,030 --> 00:14:43,150
سأفعلُ شيئاً حيال جزيرة الكنز

180
00:14:43,960 --> 00:14:45,440
...لـ-لكن

181
00:14:45,440 --> 00:14:47,410
سمعتُ صوتَ أمّي

182
00:14:48,300 --> 00:14:50,710
أعلمُ أنّها على حقّ

183
00:14:51,560 --> 00:14:52,640
...أزوما

184
00:14:52,640 --> 00:14:53,890
...أ-تشان

185
00:15:00,020 --> 00:15:04,260
حتّى تِلك الوحش لا يُمكن أن تنجو
من سقوط بهذا الارتفاع

186
00:15:04,260 --> 00:15:08,380
سأرسِلُك إلى حضن أمّك كذلك يا ابن السّاحرة

187
00:15:09,900 --> 00:15:12,050
ألم تكوني تُريدين حماية بلدكِ؟

188
00:15:12,420 --> 00:15:13,300
ماذا؟

189
00:15:14,180 --> 00:15:15,930
،إذا سقطَتْ هذه الجزيرة

190
00:15:15,930 --> 00:15:20,270
ألن يزول كلّ ما كنتِ تحاولين حمايته

191
00:15:21,360 --> 00:15:23,020
!يا ريوكو؟

192
00:15:28,940 --> 00:15:30,940
!اللّعنة عليك

193
00:15:35,560 --> 00:15:39,560
هل سينهارُ أوبو إن لم نصمد؟

194
00:15:39,560 --> 00:15:42,330
حسناً، هيميكيري، هويمارو

195
00:15:42,720 --> 00:15:43,420
تسوراراي

196
00:15:43,420 --> 00:15:44,500
إيواتوشي

197
00:15:44,500 --> 00:15:46,420
لنفعلها يا ميغيتي-تشان

198
00:15:47,500 --> 00:15:49,210
شكراً يا شباب

199
00:15:53,930 --> 00:15:55,620
...ميغيوا

200
00:15:55,620 --> 00:16:00,350
هجرَتْ تِلك المرأة عالمَنا وفرّتْ
إلى عشِّ البورانكي

201
00:16:00,350 --> 00:16:02,890
!بعدما ألبسَتْني لعنة

202
00:16:02,890 --> 00:16:07,110
مهما وُلِدتُ من مرَّات، لن أنسى ما فعلَتْه بي أبداً

203
00:16:07,110 --> 00:16:08,520
!أنتِ مُخطِئة

204
00:16:08,520 --> 00:16:13,080
أتَتْ أمِّي إلى جزيرةِ الكنز لتضمن عدم سقوط
المزيد من البورانكي نحو الأرض

205
00:16:13,080 --> 00:16:14,820
!لحماية العالم

206
00:16:15,030 --> 00:16:16,970
!تِلك مسألة بسيطة

207
00:16:16,970 --> 00:16:20,330
كلّ ما على المرء فعله هو قتل
كافّة البورانكي

208
00:16:21,200 --> 00:16:24,040
هذا غير صحيح... أنتِ مُخطِئة

209
00:16:24,370 --> 00:16:29,420
كانَتْ أمِّي تحاولُ حِماية كُل من البورانكي
والحياة البشريّة

210
00:16:29,740 --> 00:16:32,630
!حياة؟! هل قلتَ "حياة" يا ولد؟

211
00:16:33,070 --> 00:16:36,150
!لا تستخدم كلمة "حياة" بهذا الاستهتار

212
00:16:36,150 --> 00:16:38,790
،عندما يحاولُ البشرُ والبورانكي الاقتتال فيما بينهم

213
00:16:38,790 --> 00:16:41,020
!سينجو أحدُهما ويهلك الآخر

214
00:16:41,020 --> 00:16:46,550
جسدي الملعون الذي لا يشيخ أبداً ويظلُّ
ينهضُ من الموت باستمرار

215
00:16:46,550 --> 00:16:49,150
وُجِدَ فقط بهدف قتل كلّ بورانكي في الوجود

216
00:16:50,520 --> 00:16:53,540
لا تُولَدُ حياة لإنهاءِ حياة

217
00:16:54,050 --> 00:16:57,160
بل تُولَدُ الحياة لحمايةِ حياة

218
00:16:59,040 --> 00:17:02,160
بعدما اصطدتُ وقتلتُ كافّة البورانكي

219
00:17:02,160 --> 00:17:06,670
سأدمِّرُ إنتيـه وأُنهي حياتي

220
00:17:11,090 --> 00:17:12,510
لا يمكنكِ فعل ذلك

221
00:17:13,900 --> 00:17:16,550
.سيكون ذلك مُثيراً جدّاً للشفقة

222
00:17:18,320 --> 00:17:21,680
يا ولد، هذا الكلامُ تحديداً لا أريدك
أن تقوله عنِّي أبداً

223
00:17:30,620 --> 00:17:35,450
كما خطّطنا تماماً، سيسقطُ عشُّ البورانكي في الأرض

224
00:17:35,890 --> 00:17:42,830
إنّها نهاية مُناسِبة لمثل هذه الكائنات
القبيحة والقذِرة المُسمّاة بالبورانكي

225
00:17:46,670 --> 00:17:48,370
،ينبغي أن تراقبي هذا عن كثب

226
00:17:49,230 --> 00:17:50,480
يا كاوروكو

227
00:17:52,870 --> 00:17:56,950
اللّعنة... لا أمانع إنقاذ ريوكو-ساما
...في هذه الحالة فأنا سوف

228
00:18:00,070 --> 00:18:01,760
...أ-أنت

229
00:18:02,140 --> 00:18:03,480
!ريوكي؟

230
00:18:03,480 --> 00:18:07,430
ما الذي يفعلُه مُستخدِم قلب البورانكي
!باتروف هنا؟

231
00:18:08,360 --> 00:18:09,770
لقد حقّقتُ هدفي

232
00:18:10,090 --> 00:18:11,540
...فهمت

233
00:18:11,540 --> 00:18:15,440
!أتيت إلى هُنا للقضاءِ عليّ بأمر من غاي، أليس كذلك؟

234
00:18:34,240 --> 00:18:36,380
...نعم، بالطبع لا

235
00:18:48,850 --> 00:18:50,980
!ليودميلا، جيانّا

236
00:18:51,430 --> 00:18:54,360
يا إلهي، هكذا إذاً

237
00:18:54,820 --> 00:18:55,970
!سينسي

238
00:18:57,100 --> 00:18:58,150
!لا

239
00:19:05,680 --> 00:19:06,430
لا شيء

240
00:19:12,730 --> 00:19:16,500
عجباً يا أكيهيتو-كُن، أنت تُبالِغُ دوماً

241
00:19:16,500 --> 00:19:19,010
لن يصمد البوبوكي الخاصّ بك إن ظللت تفعلُ ذلك

242
00:19:19,360 --> 00:19:22,510
...حسناً، أظنُّني لا يحقُّ لي الكلام

243
00:19:27,790 --> 00:19:30,550
...إنّه يقهرُ إنتيـه الخاصّ بريوكو

244
00:19:32,590 --> 00:19:38,190
...أزوما، كوغاني، كينوا، شيزورو، هيراغي

245
00:19:38,650 --> 00:19:42,280
تمكّنتُم من بلوغِ هذه النّقطة مُباشرةً

246
00:19:42,600 --> 00:19:45,070
هذا مُبهر... مُبهر حقّاً

247
00:19:45,950 --> 00:19:51,420
سأستخدمُ كلّ ما أمتلك من قوّة لأعيش هذه اللّحظة أيضاً

248
00:20:03,590 --> 00:20:05,850
!لن تصمدَ الأطراف

249
00:20:15,720 --> 00:20:20,710
لا أدري من أين أتى البورانكي أو متى

250
00:20:20,710 --> 00:20:23,670
لكن لطالما عاشوا مع البشر

251
00:20:23,670 --> 00:20:25,450
.على هيئة بوبوكي

252
00:20:26,130 --> 00:20:30,200
لا فرق بين حياتهم وحياة البشر

253
00:20:30,880 --> 00:20:35,000
لماذا إذاً أوقفتِ قلوبَ البورانكي في الأرض؟

254
00:20:36,300 --> 00:20:39,450
إن استمرَّ البشرُ في التحكُّم بالبورانكي بشكل خاطئ

255
00:20:39,450 --> 00:20:41,630
،لتحقيق مآربهم الشخصيّة

256
00:20:41,630 --> 00:20:44,050
.لكان قد حدثَ شيء أفظع من ذلك بكثير

257
00:20:44,430 --> 00:20:47,070
...مثلما مررت به أنت

258
00:20:48,910 --> 00:20:49,970
...أمّي

259
00:20:50,450 --> 00:20:52,010
أنا بخير

260
00:20:52,500 --> 00:20:53,770
...لِذا يا أزوما

261
00:20:54,450 --> 00:20:56,240
أنقِذ ريوكو أرجوك

262
00:20:56,640 --> 00:20:58,870
فهي صديقتي العزيزة

263
00:21:18,030 --> 00:21:20,860
...حتّى من دون يدين وقدمين

264
00:21:22,910 --> 00:21:24,050
!اللّعنة عليك

265
00:21:27,390 --> 00:21:30,050
لن أدعكِ تُسقطين جزيرة الكنز نحو الأرض

266
00:21:30,050 --> 00:21:32,930
وسوف أنقذُكِ أيضاً

267
00:21:37,560 --> 00:21:39,860
!اتركني يا ابن ميغيوا

268
00:21:40,960 --> 00:21:44,560
لن أترككِ مهما كلّفَ الأمر

269
00:22:34,800 --> 00:22:38,580
،العباقِرة هُم من يغيّرون العالم دوماً

270
00:22:39,180 --> 00:22:44,000
لكن لا يستطيعُ النّاسُ العاديّون فهم عقليّة العباقِرة

271
00:22:45,300 --> 00:22:49,400
وجزيرة الكنز، وهي مكانٌ يعلو الغيوم
حاولَ عبقريٌّ حِمايتها

272
00:22:49,400 --> 00:22:54,010
.غرِقَتْ في البحرِ وانتهَتْ هذه الحادِثة تماماً

273
00:22:55,400 --> 00:22:56,680
!مفاجأة

274
00:22:57,000 --> 00:23:00,390
...ومن هُنا بدأت قصّتنا

275
00:23:00,390 --> 00:23:06,200
لا بل قصّتي، قصّة كازوكي كاوروكو

276
00:23:07,190 --> 00:23:09,840
أنا متحمِّسة للغاية، قلبي ينبُض بسُرعة

277
00:23:09,840 --> 00:23:12,270
!لا أطيق الانتظار، لكنّني مُضطرّة

278
00:23:12,270 --> 00:23:13,820
!من ينتظِر يحظى بأشياء جيّدة

279
00:23:13,820 --> 00:23:15,030
!لهذا عليّ أن أنتظر