1
00:00:09,310 --> 00:00:13,490
أظنُّني سأنتزعُ أطرافكم تِلك في نهاية المطاف

2
00:00:14,070 --> 00:00:14,950
زيتسوبي؟

3
00:00:15,310 --> 00:00:16,910
لماذا تتحكّمين بإنتيـه؟

4
00:00:17,650 --> 00:00:19,910
هذه الحسناء الصّغيرة التي استعرتُها من سويا

5
00:00:19,910 --> 00:00:24,790
تُوهِمُ إنتيـه بأنني ريوكو-ساما

6
00:00:25,850 --> 00:00:27,500
أذلك مُمكن حتّى؟

7
00:00:28,020 --> 00:00:32,070
إن كنتُم لا تُريدون أن تتأذّوا فاصمتوا واخسروا

8
00:00:32,070 --> 00:00:35,340
لأنّكم لا تستطيعون هزيمة إنتيـه على أي حال

9
00:00:35,340 --> 00:00:36,880
سنجرِّب ذلك

10
00:00:36,880 --> 00:00:39,480
نحنُ مختلِفون قليلاً الآن

11
00:00:39,480 --> 00:00:40,610
أليس كذلك يا أزوما؟

12
00:00:41,030 --> 00:00:41,890
نعم

13
00:00:42,750 --> 00:00:45,520
نعم، هكذا يبدو

14
00:00:46,150 --> 00:00:50,020
لكن راهنتُ بالكثير على هذا أيضاً، لن أدعكم تربحون

15
00:00:50,020 --> 00:00:51,670
!حضِّروا أنفسكم

16
00:02:36,530 --> 00:02:39,840
لن نحظى حتّى بفُرصة للنَّيل من القلب الآن

17
00:02:41,260 --> 00:02:43,590
...لن نتمكّن من مُواجهة أخينا الكبير

18
00:02:44,300 --> 00:02:48,770
يا إلهي... ألا يستطيع أحدكما أن يفعل شيئاً مهما كان بسيطاً؟

19
00:02:49,330 --> 00:02:50,520
!أخي الكبير

20
00:02:52,640 --> 00:02:55,700
يبدو أنّكما بحاجةٍ للعقاب

21
00:03:15,160 --> 00:03:18,050
يا جرذا المجارير البائسان

22
00:03:18,050 --> 00:03:19,360
!أيُّها الحقيران

23
00:03:19,360 --> 00:03:23,600
!هل نسيتُما أنّكما مدينان لأبي على تبنّيكما؟

24
00:03:24,110 --> 00:03:26,010
هل نسيتُما كيف منحَكما مكاناً

25
00:03:26,010 --> 00:03:29,770
للعيش وحساءً دافئاً للأكل عندما لم تكونا
!تمتلكان شيئاً؟

26
00:03:29,770 --> 00:03:33,520
!كيف تجرؤ القدمُ اليُمنى واليُسرى على عصيان القلب؟

27
00:03:33,850 --> 00:03:35,880
!تبّاً لكما، تبّاً لكما

28
00:03:34,640 --> 00:03:38,140
بالفعل، أنتُما صفيقان للغاية

29
00:03:38,140 --> 00:03:41,740
نعم، نعم، عليكما أن تستدركا مكانتيكما جيّداً

30
00:03:45,040 --> 00:03:48,740
أخي الكبير، سأزيلُ عنك دماءَ الفأر

31
00:03:53,510 --> 00:03:58,250
لستُ من أراد أن أُولَد قدَماً لشخص ما

32
00:03:58,250 --> 00:03:59,380
...ديرسو

33
00:04:01,070 --> 00:04:04,050
حسناً، اذهبا واسرقا القلبَ منهم

34
00:04:04,430 --> 00:04:08,350
لا تذلّاني مجدّداً يا أختاي الصّغيرتان

35
00:04:08,350 --> 00:04:11,470
ح-حاضر! عُلِم يا أخي الكبير

36
00:04:16,790 --> 00:04:19,360
!ما هذا بحقِّ السماء؟

37
00:04:19,820 --> 00:04:21,410
يمكنُنا فعلها يا أزوما

38
00:04:21,410 --> 00:04:23,860
حان وقتُ ردّ اعتبار ما فعلته في كاماكورا

39
00:04:27,990 --> 00:04:31,300
هذا حارِق... هذا مُؤلِم

40
00:04:31,300 --> 00:04:34,350
...هذا ما يعنيه التحكُّم بإنتيـه إذاً

41
00:04:34,350 --> 00:04:39,040
هل تحمّلَتْ... هل تحمّلَتْ ريوكو-ساما هذا طوال ذلك الوقت؟

42
00:04:42,660 --> 00:04:46,010
!لا تستخفُّوا بي أيُّها الأطفال

43
00:04:52,050 --> 00:04:54,430
هكذا أريدك يا ميغيتي-تشان

44
00:04:55,520 --> 00:04:56,640
!بمقدورنا النّجاة

45
00:04:56,640 --> 00:04:59,650
بوضعِنا الرّاهن، نستطيعُ هزيمة إنتيـه

46
00:05:01,240 --> 00:05:02,280
ماذا؟

47
00:05:06,580 --> 00:05:09,160
هل هُما مُستخدِمتا البوبوكي الرّوسيّتان؟

48
00:05:09,160 --> 00:05:10,120
!هذه هي

49
00:05:12,860 --> 00:05:15,430
إن كنت لا تُريد حرق هاتين الفتاتين

50
00:05:15,430 --> 00:05:18,710
فسلّمنا البوبوكي الذي لديك

51
00:05:18,710 --> 00:05:20,080
!أخي الكبير، لا تفعل ذلك

52
00:05:20,080 --> 00:05:22,110
!لا تقلق علينا

53
00:05:24,470 --> 00:05:27,510
حسناً، سأعطيكم البوبوكي بأكمله

54
00:05:27,900 --> 00:05:29,260
!أخي الكبير

55
00:05:30,630 --> 00:05:33,710
حتّى البوبوكي الذي لا يُقدَّر بثمن
الذي ورثتُه عن والدَيّ

56
00:05:33,710 --> 00:05:36,140
لا يستحقُّ روحيكما

57
00:05:39,680 --> 00:05:42,640
،حالما نُحيي زانبازا

58
00:05:42,640 --> 00:05:44,850
سيكونُ الصِّراع مع إنتيـه أمراً محتوماً

59
00:05:44,850 --> 00:05:49,660
لِذا لعلِّي أدعه يُريني كلّ قوّته وبشكلِه المُكتمِل

60
00:06:08,680 --> 00:06:12,280
!إنتيـه تحكّمَ بالبوبوكي الخاصّ بهم

61
00:06:12,680 --> 00:06:14,390
!ها هو ذا قادم يا جماعة

62
00:06:19,260 --> 00:06:20,000
!أزوما

63
00:06:24,280 --> 00:06:28,570
هذه هي قوّة إنتيـه المُكتمل بكامل أطرافه

64
00:06:28,570 --> 00:06:30,410
!إنّه مذهل

65
00:06:33,650 --> 00:06:36,240
اللّعنة، لن أقِفَ مكتوف الأيدي

66
00:06:40,780 --> 00:06:42,580
إيبيزو، هذا غباء

67
00:06:44,900 --> 00:06:48,840
أزوما، لا يزالُ هنالِك المزيد من القوّة
التي يُخفيها البورانكي

68
00:06:48,840 --> 00:06:52,260
سأعلّمكم جميعاً الأسرار التي أعرفُها عن القلب

69
00:06:57,760 --> 00:06:59,680
أ-تشان، هل أنت بخير؟

70
00:06:59,680 --> 00:07:02,610
...أوبو بشكلِه المُكتمِل أيضاً

71
00:07:02,610 --> 00:07:04,940
وإنتيـه قد ازداد قوّة فوق قوّته؟

72
00:07:05,790 --> 00:07:07,940
عليّ إنهاء هذا الأمر حالاً

73
00:07:08,530 --> 00:07:11,200
لا أستطيع الصُّمود أكثر

74
00:07:19,020 --> 00:07:20,500
!أزوما

75
00:07:20,500 --> 00:07:22,000
...ماذا؟ أليس ذلك الأمريكيّ

76
00:07:22,000 --> 00:07:23,370
البدين؟...

77
00:07:23,750 --> 00:07:25,100
!حطِّموا القلب

78
00:07:25,660 --> 00:07:27,380
!عليكم أن تحطِّموا القلب

79
00:07:27,380 --> 00:07:28,770
ماذا قال؟

80
00:07:28,770 --> 00:07:30,550
ما الذي يقوله في وقتٍ كهذا؟

81
00:07:30,550 --> 00:07:32,630
!أيُّها الأحمق المتطفِّل

82
00:07:35,830 --> 00:07:36,750
...القلب

83
00:07:37,520 --> 00:07:39,040
...حطِّموا قلب

84
00:07:39,040 --> 00:07:40,020
...البورانكي

85
00:07:43,140 --> 00:07:43,810
!إيبيزو

86
00:07:43,810 --> 00:07:45,810
!إلهي

87
00:07:46,480 --> 00:07:47,820
!أنتُم

88
00:07:47,820 --> 00:07:51,040
غباؤك لا نظير له حقّاً

89
00:07:51,040 --> 00:07:53,340
...هذا بورانكي ثقيل

90
00:07:53,340 --> 00:07:55,620
كم تزِنُ هذه الشّمطاء العجوز؟

91
00:07:55,870 --> 00:08:00,480
أوارغلا، من الوقاحةِ أن تسأل سيّدةً بدينةً عن وزنها؟

92
00:08:00,480 --> 00:08:03,840
لِمَ علينا مُساعدة أولئك الأشخاص؟

93
00:08:05,030 --> 00:08:07,780
!لويس، لا تدقِّق في التفاصيل

94
00:08:07,780 --> 00:08:10,300
،الآن بعدما تبادَلنا اللّكمات

95
00:08:10,300 --> 00:08:12,550
!أصبحنا أنا وأزوما كالأخوة

96
00:08:13,300 --> 00:08:14,300
!أزوما

97
00:08:14,630 --> 00:08:16,460
!حطِّم القلب

98
00:08:16,460 --> 00:08:19,810
!حرِّر قوّةَ البورانكي الحقيقيّة خاصّتك

99
00:08:19,810 --> 00:08:22,260
أحطِّم القلب؟

100
00:08:29,360 --> 00:08:31,450
!أزوما، ماذا تفعل؟

101
00:08:31,450 --> 00:08:33,690
لماذا تُصغي إلى ذلك الغبيّ؟

102
00:08:34,200 --> 00:08:36,880
خاطرَ إيبيزو بحياتِه ليُخبرني بذلك

103
00:08:36,880 --> 00:08:38,160
أنا أثِقُ به

104
00:08:40,070 --> 00:08:41,450
أنتَ تثِقُ بشكلٍ مُبالَغ به

105
00:08:42,340 --> 00:08:44,160
أظنُّنا لا نمتلِك خيارات أخرى

106
00:08:47,950 --> 00:08:48,880
...يمكنُنا

107
00:08:48,880 --> 00:08:49,750
تقديم المُساعدة أيضاً

108
00:08:51,730 --> 00:08:53,930
!حسناً، كلّنا سوية

109
00:08:53,930 --> 00:08:55,510
...واحد، اثنان

110
00:08:57,030 --> 00:08:58,090
!ثانية

111
00:09:03,460 --> 00:09:04,350
!إنّها تعمل

112
00:09:05,350 --> 00:09:06,640
...واحد، اثنان

113
00:09:16,020 --> 00:09:16,990
أ-تشان

114
00:09:25,490 --> 00:09:28,620
!مستحيل، دخلَ القلبُ جمجمته؟

115
00:09:30,250 --> 00:09:31,500
...هل هذا

116
00:09:31,660 --> 00:09:35,170
داخل رأس أوبو؟

117
00:09:48,020 --> 00:09:50,900
!أوبو يعومُ في الهواء

118
00:09:51,560 --> 00:09:54,650
لا بدّ وأنّ هذه هي الطريقة للدخول إلى جزيرةِ الكنز

119
00:09:54,910 --> 00:09:57,100
عندما يُوضَعُ صاحبُ القلب داخل

120
00:09:57,100 --> 00:09:59,280
،جمجمة بورانكي ويُصبِح دِماغه

121
00:09:59,280 --> 00:10:01,810
يُفتَحُ الباب إلى عشِّ البورانكي

122
00:10:02,550 --> 00:10:04,570
!كما قالَتْ ريوكو تماماً

123
00:10:05,830 --> 00:10:09,920
أزوما، لن أدعكم تصِلون إلى عشِّ البورانكي

124
00:10:23,400 --> 00:10:25,010
...تِلك الهجمة للتوّ

125
00:10:25,660 --> 00:10:27,280
هل فعلَ أزوما ذلك؟

126
00:10:29,480 --> 00:10:30,520
...جزيرة الكنز

127
00:10:31,830 --> 00:10:33,660
لقد عدتُ إلى دياري أخيراً

128
00:10:43,060 --> 00:10:45,990
،عندما يدخلُ القلبُ الرّأس

129
00:10:45,990 --> 00:10:49,070
يفتحُ البورانكي البوّابةَ إلى المكانِ الذي وُلِدَ فيه

130
00:10:49,500 --> 00:10:53,500
ماذا؟ أشعرُ وكأنّ هنالِك شيء مهمّ نسيتُ أن أقوله

131
00:10:54,760 --> 00:10:56,390
...لنرَ

132
00:10:56,390 --> 00:11:00,400
أوّلاً: عندما تحطِّمُ القلبَ وتدخل
رأسَ البورانكي، فإنّ قوّته تتعزّز

133
00:11:00,400 --> 00:11:03,010
ثانياً: تُفتَحُ البوّابة على جزيرةِ الكنز

134
00:11:03,010 --> 00:11:04,510
...ثالثاً: ومن ثمّ

135
00:11:06,000 --> 00:11:08,340
إيبيزو، أليس ذلك سيّئاً؟

136
00:11:08,340 --> 00:11:09,500
...نعم

137
00:11:10,170 --> 00:11:13,230
أزوما، اخرج من هُناك حالاً

138
00:11:15,380 --> 00:11:17,070
ما هذا؟

139
00:11:23,480 --> 00:11:24,660
...سويا

140
00:11:27,260 --> 00:11:29,850
سألقي نظرة إلى ذِراعك

141
00:11:29,850 --> 00:11:32,260
كنت أنت من سحبني إذاً

142
00:11:34,410 --> 00:11:39,310
هذا هو شكلُ البورانكي الحقيقيّ إذاً
...بوجودِ إنسانٍ كدِماغ له

143
00:11:43,610 --> 00:11:46,820
والآن هل رأيتِ مدى قوّة هزيمة ريوكو-ساما؟

144
00:11:47,240 --> 00:11:49,930
تتحمّلُ ريوكو الكثير بمفردها

145
00:11:50,720 --> 00:11:53,900
أتعتقدين أنّها ستكونُ قادرة على تحمّله
بمفردها للأبد؟

146
00:11:55,180 --> 00:11:56,650
ما الذي يعنيه ذلك؟

147
00:11:56,650 --> 00:11:57,930
لا أدري

148
00:11:57,930 --> 00:12:00,860
أظنُّ أنّ هُنالِك أمور يستطيعُ شابّ
مثلي أن يراها

149
00:12:00,860 --> 00:12:04,270
بينما لا تستطيعون أنتُم، باعتباركم في مثل سنّ ريوكو-ساما

150
00:12:04,270 --> 00:12:08,210
كم عمرك الآن على أي حال؟ ستّة وثلاثين؟

151
00:12:08,210 --> 00:12:09,920
أنا خمسة وثلاثين

152
00:12:09,920 --> 00:12:13,030
ينبغي أن أهنِّئكِ على بلوغ الأربعين

153
00:12:13,030 --> 00:12:14,360
!أغلِق فمك

154
00:12:14,360 --> 00:12:16,770
حسناً، سأغادر

155
00:12:16,770 --> 00:12:18,760
ثمّة أمور عليّ تولِّي أمرها

156
00:12:20,620 --> 00:12:22,670
سويا، شكراً

157
00:12:29,660 --> 00:12:34,560
في ذلك الوقت، أطلقَتْ هجمةُ أوبو عنانَ قلب إنتيـه

158
00:12:35,570 --> 00:12:39,070
ينبغي أن يكفَّ البورانكي عن الحركة
عندما يحدثُ ذلك

159
00:12:39,840 --> 00:12:44,060
لكن ظللتُ أشعرُ بأنفاسِ إنتيـه

160
00:12:45,250 --> 00:12:47,270
لماذا؟ كيف؟

161
00:12:47,800 --> 00:12:49,810
ما هو إنتيـه بالضبط؟

162
00:13:05,720 --> 00:13:09,220
مُكالمة واردة
مشفى

163
00:13:16,590 --> 00:13:17,900
...غينما

164
00:13:18,310 --> 00:13:22,330
هذه طريقتي في سداد الدّين

165
00:13:26,560 --> 00:13:28,570
أهذه جزيرةُ الكنز؟

166
00:13:29,420 --> 00:13:33,330
...الجزيرة التي طالما أرادَ والدي الذهاب إليها

167
00:13:59,610 --> 00:14:01,640
هذا مُؤلم

168
00:14:01,640 --> 00:14:03,190
ماذا حلَّ بأزوما؟

169
00:14:10,130 --> 00:14:11,800
!يبدو ذلك سيّئاً

170
00:14:11,800 --> 00:14:14,290
أ-تشان، أجبني

171
00:14:14,820 --> 00:14:18,450
يحاولُ أوبو أن يبتلع أزوما

172
00:14:18,450 --> 00:14:19,610
ماذا؟

173
00:14:24,150 --> 00:14:25,510
من هذا؟

174
00:14:29,020 --> 00:14:31,190
شكراً لك يا أوبو

175
00:14:31,190 --> 00:14:33,280
على حماية أزوما طوال هذا الوقت

176
00:14:33,810 --> 00:14:36,250
،أعلمُ أنّك بحاجة إليه

177
00:14:36,250 --> 00:14:38,500
لكن سأعيدُه حالاً

178
00:14:38,500 --> 00:14:39,600
أنا آسفة

179
00:15:05,880 --> 00:15:08,280
أهلاً بعودتك يا أزوما

180
00:15:24,000 --> 00:15:25,290
!أ-تشان

181
00:15:26,870 --> 00:15:27,820
!أزوما

182
00:15:27,820 --> 00:15:29,680
!أأنت بخير؟

183
00:15:30,270 --> 00:15:32,570
بخير؟ ماذا تقصدون؟

184
00:15:33,010 --> 00:15:36,630
أزوما، غبتَ عن الوعي لثلاثة أيّام

185
00:15:36,630 --> 00:15:37,620
ثلاثة أيّام؟

186
00:15:38,680 --> 00:15:40,380
...قلقنا عن فراغ

187
00:15:40,380 --> 00:15:43,800
نعم، كان هيراغي قلقاً أكثر من أي شخص آخر

188
00:15:43,800 --> 00:15:46,650
بلّلَ وِسادته بالدموع

189
00:15:46,650 --> 00:15:48,150
!لم يحدث هذا

190
00:15:48,150 --> 00:15:49,770
صباح الخير يا أزوما

191
00:15:51,740 --> 00:15:52,770
...أمِّي

192
00:15:59,470 --> 00:16:00,990
ها قد التقينا مجدّداً

193
00:16:21,790 --> 00:16:22,890
...هل هذا

194
00:16:23,500 --> 00:16:24,420
لا تقلقوا

195
00:16:24,860 --> 00:16:27,370
كلّ البورانكي هُنا مُسالِمون

196
00:16:27,730 --> 00:16:30,920
آه... حقّاً؟

197
00:16:33,870 --> 00:16:35,170
...هذا

198
00:16:36,680 --> 00:16:38,430
...منظر جميل على ما أظنّ

199
00:16:38,430 --> 00:16:40,060
منظر جميل على ما أظنّ

200
00:16:44,760 --> 00:16:49,970
ميغيوا-سان، أتيتُ إلى هُنا لأنني أودُّ
أن أطلبَ منك معروفاً

201
00:16:49,970 --> 00:16:52,640
هذه الجزيرة مليئةٌ بالأسرار والغموض

202
00:16:53,710 --> 00:16:58,430
يكونُ عادةً من المُستحيل لأي كائن حيّ
أن يصمدَ هنا

203
00:16:58,800 --> 00:17:03,140
أشعرُ وكأنّ شيئاً ما يصونُ النظامَ البيئي للجزيرة

204
00:17:03,140 --> 00:17:07,250
...ليس هذا ما أردتُ مُحادثتكِ حوله بالضبط

205
00:17:07,660 --> 00:17:11,630
،عندما أتَتْ عائلتي في بادئ الأمر إلى هنا

206
00:17:11,630 --> 00:17:14,230
حاولنا اصطياد الطّيور والسمك لنأكلها

207
00:17:14,230 --> 00:17:17,010
لكن شعرتُ بصدمةِ الجزيرة عندما فعلنا ذلك

208
00:17:17,630 --> 00:17:20,510
كانَتْ متفاجئة عندما أكَلْنا البطاطا أيضاً

209
00:17:20,510 --> 00:17:22,790
لكن لم تكُن أمامنا خيارات كثيرة

210
00:17:23,700 --> 00:17:27,600
لكن ليسَ عليكم القلق يا فتيان

211
00:17:27,600 --> 00:17:30,020
كلوا ما تشاؤون

212
00:17:30,330 --> 00:17:32,120
...ح-حسناً

213
00:17:35,670 --> 00:17:39,250
...ميغيوا-سان، تَتِمّة لما كنتُ أقوله من قبل

214
00:17:39,250 --> 00:17:40,410
...أريدُكِ أن

215
00:17:40,410 --> 00:17:41,200
تفضّل

216
00:17:42,070 --> 00:17:44,200
ش-شكراً لكِ

217
00:18:08,230 --> 00:18:09,820
ميغيوا-سان؟

218
00:18:09,820 --> 00:18:12,190
أأنت هنا يا هيراغي؟

219
00:18:13,010 --> 00:18:15,610
لقد تغيّرت كثيراً، أليس كذلك؟

220
00:18:16,140 --> 00:18:17,440
...طوال هذا الوقت

221
00:18:18,530 --> 00:18:24,950
طوال هذا الوقت وأنا أريدُ أن أطلب من ميغيوا-سان
أن تعود إلى الأرض وتقاتل ريوكو معنا

222
00:18:25,360 --> 00:18:27,690
نعم، هذا ما كنتَ تسعى إليه دوماً

223
00:18:27,690 --> 00:18:29,420
أردتُ أيضاً أن أسألها

224
00:18:29,420 --> 00:18:33,860
عن سببِ هجرِها للأرض ووالدي لتأتي إلى هنا

225
00:18:34,740 --> 00:18:37,900
لكن بعد العمل في الحقولِ وما شابه

226
00:18:37,900 --> 00:18:40,340
لم يعُد يهمّني ذلك بعد الآن

227
00:18:41,000 --> 00:18:43,730
هذا ما يُعجبني فيك

228
00:18:43,730 --> 00:18:45,850
ماذا؟ ماذا تقصدين؟

229
00:18:46,280 --> 00:18:47,640
سُؤال وجيه

230
00:18:52,700 --> 00:18:54,920
...اسمعي يا كينوا

231
00:18:56,160 --> 00:18:58,800
...هل أنتِ... أعني

232
00:18:59,510 --> 00:19:03,920
أتفعلينها... مع ذلك الفتى أراباشيري؟

233
00:19:04,580 --> 00:19:06,120
!ب-بالطبع لا

234
00:19:07,190 --> 00:19:09,120
لم تفعلي؟

235
00:19:09,120 --> 00:19:12,550
لكن هل... ق-قبّلتِه؟

236
00:19:12,550 --> 00:19:14,630
!هـ-هل أنت غبيّ؟

237
00:19:19,940 --> 00:19:22,390
...لقد قبّلَتْه إذاً

238
00:19:27,200 --> 00:19:29,030
تصبحين على خير يا كوغاني-تشان

239
00:19:29,030 --> 00:19:31,900
نعم، وأنتِ بخير

240
00:19:43,830 --> 00:19:46,740
،جزيرة الكنز شاهقة جدّاً

241
00:19:46,740 --> 00:19:48,560
لكنّها ليسَتْ باردة إطلاقاً

242
00:19:50,680 --> 00:19:53,810
ستبقى أمُّك هنا إذاً في نهاية المطاف

243
00:19:55,750 --> 00:19:57,170
...هكذا إذاً

244
00:19:58,060 --> 00:20:03,380
أتعلم؟ أحبُّ جزيرةَ الكنزِ هذه حقّاً

245
00:20:03,840 --> 00:20:06,510
تبدو لطيفة جدّاً ودافئة

246
00:20:07,470 --> 00:20:09,880
لقد ترعرعتَ هنا إذاً، صحيح؟

247
00:20:12,580 --> 00:20:15,700
أنا متأكِّدة أنَّ والدي سيحبُّها أيضاً

248
00:20:16,740 --> 00:20:20,260
أ-تشان، شكراً على إحضارِك لي إلى هنا

249
00:20:20,260 --> 00:20:23,660
لا، لم أتمكّن من المجيء إلى هنا

250
00:20:23,660 --> 00:20:25,960
إلّا بسببِ لِقائي بكِ في ذلك اليوم

251
00:20:26,610 --> 00:20:28,660
لِذا أنا من ينبغي أن يشكركِ

252
00:20:47,380 --> 00:20:51,020
والآن سنبعثُ البورانكي الخاصّ بي، زانبازا

253
00:20:53,570 --> 00:20:56,420
كم هذا مُملّ! هذا سهلٌ للغاية

254
00:20:56,420 --> 00:21:00,880
أعتقدُ أنّ عصابة ديراشين هنا شبه نائمة

255
00:21:00,880 --> 00:21:02,240
لماذا؟ لماذا؟

256
00:21:02,570 --> 00:21:05,600
لن ندعَ فِرَقَ البورانكي الأخرى تتفوّقُ علينا

257
00:21:06,030 --> 00:21:08,160
سنستهدفُ القلبَ أيضاً يا إيبيزو

258
00:21:08,160 --> 00:21:10,320
لا أظنُّ ذلك

259
00:21:10,320 --> 00:21:15,090
أي جبان هذا يسلبُ القلبَ من بورانكي نائم؟

260
00:21:16,450 --> 00:21:17,710
أوه؟

261
00:21:18,030 --> 00:21:19,300
!غصَّة

262
00:21:25,520 --> 00:21:27,470
ما ذلك الصوت؟

263
00:21:28,160 --> 00:21:29,250
!أمِّي

264
00:21:29,250 --> 00:21:31,010
أزوما، ما هذا؟

265
00:21:32,060 --> 00:21:33,350
!الغابة

266
00:21:39,830 --> 00:21:44,140
هذا مكان ألطف بكثير ممّا توقَّعت

267
00:21:44,140 --> 00:21:47,360
!توقّعتُ أن يكون كما الجحيم

268
00:21:47,360 --> 00:21:50,480
!أراباشيري؟ كيف وصلت إلى هنا؟

269
00:21:50,480 --> 00:21:54,160
أنتُم من فتح البابَ لي

270
00:21:54,160 --> 00:21:56,710
لحقتُ بكم إلى هنا فحسب

271
00:21:56,710 --> 00:22:00,150
يبدو أنَّ الفِرَق من تِلك البلاد الأخرى حاضرة أيضاً

272
00:22:01,080 --> 00:22:04,460
يزدادُ الأمرُ إثارة، أشعرُ وكأنَّني في مهرجان

273
00:22:04,460 --> 00:22:09,190
والآن حان الوقتُ لصَيدِ بورانكي مُمتِع ولطيف