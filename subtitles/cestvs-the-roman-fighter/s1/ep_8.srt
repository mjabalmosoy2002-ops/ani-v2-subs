1
00:00:06,700 --> 00:00:10,440
ما تحتاجون لتحسينه هو افتقاركم للقوّة الحاسمة

2
00:00:10,440 --> 00:00:12,410
تعوزكم قوّة استغلال الفرص

3
00:00:12,410 --> 00:00:15,550
قوّة قلب القتال لصالحكم بضربة واحدة

4
00:00:16,450 --> 00:00:19,580
عليكم تقوية قبضاتكم

5
00:00:20,980 --> 00:00:23,690
ستعملون بهذه حتّى أخبركم
أنّكم انتهيتم

6
00:00:25,710 --> 00:00:28,960
لا تشتكوا، إنّه عملٌ بسيط شاق

7
00:00:29,320 --> 00:00:31,520
ستأخذون استراحةً من كلّ
التمارين الأخرى باستثناء الركض

8
00:00:31,520 --> 00:00:33,190
كرسوا أنفسكم في الحفر

9
00:00:36,570 --> 00:00:39,760
حفرنا لشهرين متتاليين كما أمرنا

10
00:00:40,930 --> 00:00:45,850
ظهورنا متصلّبة وأذرعتنا متخدّرة
وراحات أيدينا مغطّاة بالبثور

11
00:00:46,350 --> 00:00:49,740
أسيجعلنا هذا العمل الشاق البسيط أقوى حقّاً؟

12
00:00:51,230 --> 00:00:52,610
!ادخلا الحلبة

13
00:01:05,400 --> 00:01:08,410
وقت النزال الرابع للمجموعة الرابعة

14
00:01:08,410 --> 00:01:10,090
سيحدّد هذا النزال المقاتل الأخير

15
00:01:10,090 --> 00:01:11,980
المتقدّم للجولة الثانية من التصفيات

16
00:01:12,780 --> 00:01:13,980
ليتحضّر المقاتلون

17
00:01:16,550 --> 00:01:20,350
كم لكمة عليّ توجيهها؟ كم مقاتل عليّ هزيمته

18
00:01:21,300 --> 00:01:24,010
لأفوز بحرّيتي فحسب؟

19
00:01:24,440 --> 00:01:25,390
!ابدآ

20
00:01:26,240 --> 00:01:32,800
إذا كانت كلّ لكمة أوّجهها وكلّ مقاتل أهزمه
يقرّبانني من الحرّية، فلا بأس

21
00:01:32,800 --> 00:01:35,990
!سأواصل اللكم حتّى أصلها

22
00:03:42,350 --> 00:03:43,070
!يكفي

23
00:03:45,740 --> 00:03:47,490
الفائز هو سيستس

24
00:04:10,640 --> 00:04:13,150
لا تزال حركة قدميك تفتقر للفعاليّة

25
00:04:13,150 --> 00:04:16,150
التزم بتحرّكات جانبيّة أصغر
عندما تدير جسدك

26
00:04:18,140 --> 00:04:20,090
سأكرّر كلامي، الحلبة ضيّقة

27
00:04:20,570 --> 00:04:22,630
ستكون بخير طالما
تستلم زمام الأسبقيّة

28
00:04:22,630 --> 00:04:25,680
لكن إذا تخلّفت، ستجد ظهرك على الحائط فوراً

29
00:04:25,680 --> 00:04:27,700
...وعندما تهاجم خصمك

30
00:04:28,910 --> 00:04:31,410
!أنا أبذل قصارى جهدي

31
00:04:31,770 --> 00:04:33,750
سأقدّم أداءً أفضل المرّة القادمة

32
00:04:33,750 --> 00:04:34,770
ألم تقل ما يكفي؟

33
00:04:34,770 --> 00:04:36,330
فزت، أليس كذلك؟

34
00:04:42,260 --> 00:04:46,310
سـ-سأخرج لتهدئة أعصابي

35
00:04:47,020 --> 00:04:48,550
لا تبرد جسدك كثيراً

36
00:04:53,710 --> 00:04:55,570
لقد تغيّر

37
00:04:56,020 --> 00:05:01,610
أصبح أقوى بالفعل، لكنّه لم يكن
يبرح الخصم الطريح ضرباً

38
00:05:03,940 --> 00:05:10,530
تقنيات قتاله جانباً، من الغريب سبب غضبه

39
00:05:11,170 --> 00:05:14,930
كان بذاك الشكل مُذ بدأنا تمرين المعول

40
00:05:14,930 --> 00:05:17,580
أصبح الاقتراب منه صعباً

41
00:05:19,290 --> 00:05:21,820
أعرف أنّه يعاني في الموقف
...الصعب الذي وُضع فيه، لكن

42
00:05:40,400 --> 00:05:41,460
ما الخطب؟

43
00:05:43,420 --> 00:05:44,630
لمَ توقّفت؟

44
00:05:44,630 --> 00:05:46,320
هل سئمت بالفعل؟

45
00:05:47,720 --> 00:05:48,660
كلا

46
00:05:48,660 --> 00:05:53,480
،رغم كلّ الصعاب التي مررتَ بها
كانت نتائج تمرينك مخيبة

47
00:05:53,480 --> 00:05:56,310
لا تظهر فعاليّة، ولا تبدو أنّك قوى

48
00:05:58,860 --> 00:05:59,950
...أنا

49
00:05:59,950 --> 00:06:02,710
هذا سبب غضبك

50
00:06:02,940 --> 00:06:03,820
...أنا

51
00:06:04,680 --> 00:06:06,680
لا أشعر بأنّي خُذلت

52
00:06:08,060 --> 00:06:10,010
حقّقتُ نتائجاً

53
00:06:11,120 --> 00:06:13,860
لكنّ هنالك أمرٌ ليس في محلّه

54
00:06:15,710 --> 00:06:19,910
،ليست هذه الإجابة التي أبتغيها
يمكنني معرفة ذاك القدر

55
00:06:21,380 --> 00:06:22,880
لا أستطيع التعبير تماماً

56
00:06:22,880 --> 00:06:28,330
أعرف أنّي أكاد أمسك بشيء، لكنّي أشعر
أنّي لا أستطيع القبض عليه

57
00:06:28,330 --> 00:06:29,160
...لذا

58
00:06:31,530 --> 00:06:34,160
ما الذي كنت تقوم به
في الأشهر الثلاثة الفائتة؟

59
00:06:36,010 --> 00:06:39,940
أكنت تحفر بلا معنى يوميّاً كما أُمرت؟

60
00:06:40,860 --> 00:06:43,650
لن ألقّنك التفاصيل أكثر من هذا

61
00:06:43,650 --> 00:06:47,880
من الآن فصاعداً، عليك اكتشاف ما هو
مهمّ وإتقانه بنفسك

62
00:06:49,320 --> 00:06:52,520
بما أنّك قريب، سأعطيك تلميحاً

63
00:06:53,300 --> 00:06:57,930
،عندما تضرب الأرض القاسية بقوّة وعمق بمعول

64
00:06:57,930 --> 00:07:00,190
كيف تستعمل عضلاتك؟

65
00:07:04,420 --> 00:07:08,440
عليك تطبيق ذلك الشعور على لكماتك وحسب

66
00:07:09,330 --> 00:07:11,500
افتح عينيك يا سيستس

67
00:07:33,550 --> 00:07:36,600
عليّ اكتشافه وإتقانه بنفسي

68
00:07:37,180 --> 00:07:40,850
كيف أجد ذاك الشعور؟

69
00:07:41,420 --> 00:07:44,020
لا فائدة، لا يمكنني حلّها بالتفكير

70
00:07:44,020 --> 00:07:45,190
بل بالإحساس

71
00:07:46,060 --> 00:07:48,060
أفتح عينيّ؟

72
00:07:49,130 --> 00:07:51,780
ما الذي يُفترض أن أراه؟

73
00:07:59,960 --> 00:08:01,280
!فعلها

74
00:08:01,280 --> 00:08:02,560
مذهل

75
00:08:01,540 --> 00:08:02,990
كان نصراً مهيمناً

76
00:08:11,540 --> 00:08:13,900
إنّه قويّ كما يُقال عنه

77
00:08:13,900 --> 00:08:16,300
أجل، لا اهتزاز فيه البتّة

78
00:08:17,500 --> 00:08:20,900
إنّه المعروف بالعاصفة الحمراء إذاً؟

79
00:08:20,900 --> 00:08:22,770
مُبهر بحقّ

80
00:08:24,970 --> 00:08:27,920
أليس المصارع المحترف فليكس؟

81
00:08:27,920 --> 00:08:29,510
المصارع المحترف؟

82
00:08:29,510 --> 00:08:33,050
أجل، يبدو أنّه يتنقّل بين الحلبات
الصغيرة في المنطقة

83
00:08:33,050 --> 00:08:34,730
ويجني الكثير من المال أثناء ذلك

84
00:08:34,730 --> 00:08:37,830
الحلبات الصغيرة؟ هذا مذهل

85
00:08:37,830 --> 00:08:43,260
قد يصبح بطل تصفيات الاثنين
وثلاثين مقاتلاً هذه

86
00:08:58,860 --> 00:09:00,480
أين تذهب يا سيستس؟

87
00:09:01,980 --> 00:09:04,350
أتنوي التمرّن بالمعول مُجدّداً؟

88
00:09:05,850 --> 00:09:07,900
ما المغزى من ذلك؟

89
00:09:07,900 --> 00:09:09,310
ألم تفقد صوابك؟

90
00:09:09,640 --> 00:09:10,530
توقّف

91
00:09:11,870 --> 00:09:13,810
تذمّرتَ قبلاً بدورك

92
00:09:14,320 --> 00:09:17,590
فلمَ تعمل به بطاعة عمياء
من الشروق للغروب؟

93
00:09:18,040 --> 00:09:19,700
تدرك أنّ ذاك التمرين عقيم في الواقع

94
00:09:19,700 --> 00:09:21,420
توقّف يا بيدرو

95
00:09:23,040 --> 00:09:27,000
لا تتذمّر، لن تتعلّم شيئاً طالما تتذمّر

96
00:09:27,000 --> 00:09:27,940
ماذا؟

97
00:09:29,040 --> 00:09:31,260
!ما الذي تعنيه؟ انتظر

98
00:09:31,840 --> 00:09:33,010
توقّف

99
00:09:33,010 --> 00:09:35,170
!أتخال نفسك مميّزاً؟

100
00:09:36,560 --> 00:09:39,800
معك حقّ، كان بإمكانه ألّا
يعبّر بذاك الشكل

101
00:09:41,110 --> 00:09:44,470
كلا، لم يكن يقصدنا

102
00:09:44,470 --> 00:09:46,610
أظنّه كان يخاطب نفسه

103
00:09:46,610 --> 00:09:47,320
ماذا؟

104
00:09:48,430 --> 00:09:51,790
أظنّ سيستس يصارع شيئاً

105
00:10:21,990 --> 00:10:24,570
أيّاً يكن، إنّه صبيّ مذهل

106
00:10:24,570 --> 00:10:29,130
جعلني أرتجف عندما أفقد خصمه الثاني
وعيه بضربة واحدة

107
00:10:29,130 --> 00:10:30,730
أهو مذهل لذاك الحدّ؟

108
00:10:30,730 --> 00:10:35,160
أجل، بقاؤه في التصفيات برهانٌ على ذلك

109
00:10:35,160 --> 00:10:38,750
جبتُ أماكن كثيرة، ولم يسبق أن رأيتُ صبيّاً مثله

110
00:10:38,750 --> 00:10:41,490
قد يكون مميّزاً حقّاً

111
00:10:41,790 --> 00:10:45,120
سمعتَه، قد تكون في ورطة يا فيلكس

112
00:10:47,510 --> 00:10:48,520
حسنٌ

113
00:10:50,600 --> 00:10:53,130
آسف، فزتُ مجدّداً

114
00:10:53,130 --> 00:10:55,200
تبّاً، غلبتنا

115
00:10:55,200 --> 00:10:57,250
لأيّ حدٍّ يحالفك الحظّ؟

116
00:10:57,770 --> 00:10:59,130
اعذراني

117
00:11:01,740 --> 00:11:03,510
إلى اللقاء إذاً

118
00:11:03,510 --> 00:11:07,140
تمهل، ما اسم ذاك الصبيّ المذهل؟

119
00:11:07,570 --> 00:11:10,640
سيستس؟ أجل، اسمه سيستس

120
00:11:10,960 --> 00:11:14,300
حتّى أنت قد تقع في مشكلة
إذا استهنت به

121
00:11:15,200 --> 00:11:17,460
شكراً على النصيحة

122
00:11:18,150 --> 00:11:22,080
إذاً أيّها المسافر، أيّنا تظن أكثر حظّاً؟

123
00:11:22,080 --> 00:11:24,250
أنا أم ذاك الصبيّ؟

124
00:11:24,250 --> 00:11:29,410
أنت بالطبع، فأنت أسعد الرجال حظّاً

125
00:11:29,690 --> 00:11:33,130
صدقت، عندما يحالفك الحظّ
تكون محظوظاً دوماً

126
00:11:33,130 --> 00:11:35,170
...وعندما لا يحالفك

127
00:11:38,320 --> 00:11:39,080
ما هذا؟

128
00:11:39,080 --> 00:11:41,300
أيّها الوغد! غششت؟

129
00:11:41,510 --> 00:11:43,070
لديك نرد مزيّف

130
00:11:43,070 --> 00:11:46,050
!متى بدّلت له؟ غششت

131
00:11:46,050 --> 00:11:49,430
عندما لا يحالفك، تكون غير محظوظ دوماً

132
00:11:49,430 --> 00:11:50,730
لاحظت؟

133
00:11:51,060 --> 00:11:54,470
!سـ-سأعيد المال، اصفح عن حياتي فحسب

134
00:11:55,100 --> 00:11:56,680
!النجدة

135
00:11:57,220 --> 00:11:59,090
أكان يجدر بك تركه يذهب؟

136
00:11:59,090 --> 00:12:00,540
رجل بحظّه الضئيل

137
00:12:00,540 --> 00:12:04,320
سيُبرح ضرباً أو يسقط ميتاً
مهما ركض مسرعاً

138
00:12:04,560 --> 00:12:08,540
حسناً، الفائز التالي سيحصل على المبلغ كاملاً

139
00:12:08,540 --> 00:12:09,600
!أ-أقبل

140
00:12:09,600 --> 00:12:10,580
!سنشارك

141
00:12:11,920 --> 00:12:13,450
سيستس إذاً؟

142
00:12:21,900 --> 00:12:24,440
لا يبدو أنّ المطر سيخفّ

143
00:12:41,390 --> 00:12:43,260
،مهما مررت بها من مرّات

144
00:12:43,260 --> 00:12:45,350
تخنقني فترة الانتظار هذه دوماً

145
00:13:02,410 --> 00:13:05,800
المطر غزير، لكنّنا متخلّفون عن الجدول فسنمضي

146
00:13:05,800 --> 00:13:06,930
جاهز للقتال؟

147
00:13:06,930 --> 00:13:07,640
أجل

148
00:13:08,510 --> 00:13:11,450
هذا أفضل بكثير من مجرّد الانتظار

149
00:13:21,730 --> 00:13:25,600
حالما يبدأ القتال، لا أمامك سوى إنهائه

150
00:13:34,330 --> 00:13:38,090
بالتركيز على ما أمامي فقط، يمكنني تصفية ذهني

151
00:13:47,260 --> 00:13:48,190
!ابدآ

152
00:13:52,470 --> 00:13:54,890
ركّز، تذكّر

153
00:13:56,760 --> 00:14:00,420
ذك الإحساس الذي زرعه الألم
في جسدك يومياً

154
00:14:04,490 --> 00:14:05,690
استشعره مجدّداً

155
00:14:06,820 --> 00:14:08,700
كلا، سطحيّ

156
00:14:08,700 --> 00:14:09,950
ليس الشعور نفسه

157
00:14:19,320 --> 00:14:21,690
لا تهلع، اصقل حواسك

158
00:14:22,970 --> 00:14:26,720
كان كلّ شيء لأجل هذه اللحظة

159
00:14:27,880 --> 00:14:33,180
أبصر الفرصة بعينيك، واضرب نقطة ضعف
!خصمك بقبضة حديديّة

160
00:14:53,470 --> 00:14:54,970
انتهى بهذه السرعة؟

161
00:14:54,970 --> 00:14:56,080
أفقد وعيه؟

162
00:14:56,080 --> 00:14:58,520
!توقّف، انتهى النزال

163
00:14:59,540 --> 00:15:02,780
أفقدتُ بالغاً وعيه بضربة واحدة؟

164
00:15:03,230 --> 00:15:04,770
بمنتهى السهولة أيضاً

165
00:15:13,600 --> 00:15:17,930
يفقد المرء وعيه، وينهار جسده
اللا واعي على الأرض

166
00:15:17,930 --> 00:15:20,930
كما لو كان دميةً قُطعت خيوطها

167
00:15:22,620 --> 00:15:25,520
فهمت، إنّه هذا الإحساس

168
00:15:26,170 --> 00:15:29,830
!هذا الشعور هو الإجابة التي كنت أبتغيها

169
00:15:32,190 --> 00:15:36,470
،بشدّ كلّ عضلات الذراع لحظة الاصطدام

170
00:15:36,470 --> 00:15:40,120
تتركّز الطاقة الحركيّة في قبضة المرء

171
00:15:40,700 --> 00:15:44,620
وفي حالة الضربة المعاكسة، تتضاعف
قوّة اللكمة عدّة مرّات

172
00:15:46,110 --> 00:15:49,020
فعاليّة لكمتين تتبعان المسار نفسه

173
00:15:49,020 --> 00:15:51,210
تتغيّر لحدٍّ كبير بناءً
على طريقة توجيههما

174
00:15:52,340 --> 00:15:56,140
مقارنةً باللكمة السريعة التي تُوجّه
بلفّ القبضة للأمام

175
00:15:56,560 --> 00:15:59,350
هذه طريقة لكم صلبة

176
00:16:00,290 --> 00:16:02,140
تمرين المعول هو الطريقة المثالية

177
00:16:02,140 --> 00:16:04,530
لتقوية العضلات تزامنياً

178
00:16:08,020 --> 00:16:10,220
في جسمك

179
00:16:10,990 --> 00:16:13,860
استبصر أخيراً

180
00:16:14,580 --> 00:16:17,260
لم تكن المعاناة الطويلة بلا فائدة

181
00:16:17,770 --> 00:16:20,540
كانت النتائج داخل قبضتي سلفاً

182
00:16:35,110 --> 00:16:38,360
يا إلهي، هذا ليس لمشروع بناء حتّى

183
00:16:38,360 --> 00:16:39,450
نحفر حفراً لا حاجة لها

184
00:16:40,710 --> 00:16:43,220
ما مدى سذاجتنا؟

185
00:16:47,180 --> 00:16:49,690
أعرف. لا تتذمر، صحيح؟

186
00:16:50,620 --> 00:16:52,610
ستنتج نتائج بالتأكيد

187
00:16:52,610 --> 00:16:54,500
أضمن لكم ذلك

188
00:16:58,080 --> 00:16:58,930
آسف

189
00:17:01,690 --> 00:17:04,470
كان البقاء حولي مزعجاً لاستثارة أعصابي، صحيح؟

190
00:17:04,470 --> 00:17:07,440
...كنتُ تحت ضغطٍ هائل، لكن

191
00:17:09,320 --> 00:17:13,020
أنا بخيرٍ الآن، تجاوزت ذلك أخيراً
في نزال البارجة

192
00:17:18,420 --> 00:17:22,700
أتقصد أنّك لم تستطع مشاركتنا قلقك؟

193
00:17:25,090 --> 00:17:27,190
معرفتنا دامت لفترة طويلة

194
00:17:27,190 --> 00:17:30,910
لطالما كنت تسبقنا

195
00:17:31,350 --> 00:17:33,290
وفخرك شديد فوق ذلك

196
00:17:33,290 --> 00:17:35,330
لا تريد أن تبدو ضعيفاً أمامنا، أليس كذلك؟

197
00:17:36,150 --> 00:17:38,960
تخبرنا بألّا نتذمّر دوماً

198
00:17:38,960 --> 00:17:42,780
لكن ألا ترى أنّ عدم التشكّي
لأصدقائك أمر محزن؟

199
00:17:43,990 --> 00:17:46,540
قد لا نكون أفضل من تستشيرهم

200
00:17:46,540 --> 00:17:49,180
لكن يمكننا الاستماع لتذمّرك على الأقل

201
00:17:49,180 --> 00:17:52,360
بح بما يجوب داخلك أحياناً بدل
تركه يتراكم دوماً يا سيستس

202
00:17:54,680 --> 00:17:58,630
بصراحة، كنتُ عنيداً وأضغط على نفسي كثيراً

203
00:17:59,700 --> 00:18:03,050
من المطمئن امتلاك أصدقاء حقّاً

204
00:18:04,970 --> 00:18:06,570
لتكن مُمتنّاً

205
00:18:08,540 --> 00:18:12,660
ذلك جانباً، كانت لكمتك بالأمس مذهلة

206
00:18:11,690 --> 00:18:12,660
أنتم

207
00:18:13,690 --> 00:18:15,540
ما الذي تصنعونه؟

208
00:18:15,540 --> 00:18:17,910
أتحفرون حقلاً؟

209
00:18:19,040 --> 00:18:20,740
من أنت؟

210
00:18:21,470 --> 00:18:23,790
أيّكم سيستس؟

211
00:18:23,790 --> 00:18:25,660
كلا، دعوني أخمّن

212
00:18:33,880 --> 00:18:35,760
إنّه أنت

213
00:18:36,400 --> 00:18:38,100
ألديك أمرٌ ما معي؟

214
00:18:38,550 --> 00:18:41,190
عجباً، أنت يافع

215
00:18:41,190 --> 00:18:43,830
تقاتل كمراهق؟ مثير للإعجاب

216
00:18:45,400 --> 00:18:48,570
تقلّصنا لأربعة مرشّحين أخيراً

217
00:18:48,570 --> 00:18:51,270
أريد رؤيتك بعينيّ بالطبع

218
00:18:55,570 --> 00:18:57,950
أنا فيلكس، سُررت بلقائك

219
00:18:57,950 --> 00:19:00,170
سأقاتل في المجموعة الأولى
في نصف نهائيّ الغد

220
00:19:01,160 --> 00:19:02,700
أنا في المجموعة الثانية

221
00:19:05,390 --> 00:19:06,940
أعرف ذلك

222
00:19:08,540 --> 00:19:11,620
ما خطبه؟ أيحاول تشتيت انتباهي عن القتال؟

223
00:19:13,420 --> 00:19:14,960
يكره الخسارة

224
00:19:14,960 --> 00:19:17,240
رائع، يروقني

225
00:19:20,710 --> 00:19:23,340
لـ-لمتى تنويان الإمساك بأيدي بعضكما؟

226
00:19:27,020 --> 00:19:30,520
إذا كنتَ مهتمّاً، فيجدر بك
تفقّد المرشّحين الآخرين أيضاً

227
00:19:30,960 --> 00:19:35,690
وجهاهما مغطّيان بالجراح، مدعاة للضحك

228
00:19:39,610 --> 00:19:42,020
وبالمقابل، نحن مختلفان

229
00:19:42,020 --> 00:19:44,690
خضنا ثلاث مواجهات دون أيّ خدش

230
00:19:45,340 --> 00:19:48,250
لا يتغيّر عملي مهمن كان خصمي

231
00:19:48,950 --> 00:19:52,600
قولٌ حسن، ما رأيك بهذا إذاً؟

232
00:19:53,420 --> 00:19:54,410
راقب

233
00:19:56,350 --> 00:19:59,610
راهن الآن، نقش أم طرّة؟

234
00:19:59,920 --> 00:20:01,170
ماذا؟

235
00:20:01,390 --> 00:20:03,050
خمّن فقط

236
00:20:05,530 --> 00:20:06,410
نقش

237
00:20:09,790 --> 00:20:12,780
أصبت! كنتُ أعرف أنّك تملكه

238
00:20:13,780 --> 00:20:15,000
أملك ماذا؟

239
00:20:15,400 --> 00:20:17,030
أقصد الحظّ

240
00:20:17,030 --> 00:20:19,190
أراك في النهائيّ

241
00:20:23,200 --> 00:20:25,210
لا يمكن أنّه عبد مقاتل

242
00:20:25,210 --> 00:20:27,580
يبدو أنّه يشارك في التصفيات للتسلية

243
00:20:27,580 --> 00:20:30,140
لا تخسر أمام شخص مثله يا سيستس

244
00:20:35,130 --> 00:20:37,700
فاز في الجولات السابقة إذاً؟

245
00:20:38,310 --> 00:20:40,630
لا تختلف بنيته عنّي كثيراً

246
00:20:40,630 --> 00:20:43,930
لا بدّ أنّه مقاتل قويّ يخفي تقنية مهيبة

247
00:20:44,400 --> 00:20:48,540
يتمرّن بمعول في يوم استراحته، فاجأني

248
00:20:48,540 --> 00:20:51,970
لا بدّ أنّه شهد مجازر كثيرة في عمره اليافع

249
00:20:51,970 --> 00:20:55,000
كما أستشعر حظّاً كبيراً منه
قبل أيّ شيء

250
00:20:56,180 --> 00:20:59,220
سيكون خصمي في النهائيّ غالباً

251
00:22:40,000 --> 00:22:42,630
لديه نقطة ضعف قاتلة

252
00:22:42,630 --> 00:22:44,680
أيحاول استفزازه؟

253
00:22:44,680 --> 00:22:46,960
يبدو مريباً

254
00:22:46,960 --> 00:22:50,470
يحسب الملاكم مدى خصمه بناءً على خبرته

255
00:22:50,470 --> 00:22:54,040
إذا لم أفز، لن أصبح حرّاً أبداً