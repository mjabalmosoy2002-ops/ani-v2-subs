1
00:00:05,760 --> 00:00:08,480
أوّل سلاح حصل عليه بنو الإنسان

2
00:00:08,820 --> 00:00:12,810
مُذ عصر الأساطير، تقاتل البشر بقبضاتهم

3
00:00:13,800 --> 00:00:17,820
أقدم رياضة في العالم، إنّها الملاكمة

4
00:00:19,650 --> 00:00:23,420
!سيستس، انهض! انهض

5
00:00:21,450 --> 00:00:23,690
...أسمع صوتاً

6
00:00:24,120 --> 00:00:24,850
!سيستس

7
00:00:24,850 --> 00:00:26,040
صوت من؟

8
00:00:26,530 --> 00:00:30,570
!سيستس، انهض! انهض

9
00:00:27,080 --> 00:00:29,680
...أشعر بتخدّر في رأسي

10
00:00:30,570 --> 00:00:34,220
أستشعر مذاق دم في عمق أنفي

11
00:00:31,210 --> 00:00:32,500
!انهض يا سيستس

12
00:00:32,500 --> 00:00:34,600
أيمكنك مواصلة القتال يا سيستس؟

13
00:00:34,600 --> 00:00:40,300
!انهض يا سيستس

14
00:00:35,000 --> 00:00:36,660
أين أنا؟

15
00:00:40,850 --> 00:00:42,220
!على قدميك يا سيستس

16
00:00:43,930 --> 00:00:44,840
أهذا أنا؟

17
00:00:47,100 --> 00:00:48,860
ما الذي يجري؟

18
00:00:48,860 --> 00:00:50,570
انهرتُ فجأةً

19
00:00:52,300 --> 00:00:54,330
!نهايتك محتومة إذا لم تظهر عزيمتك للقتال

20
00:00:54,330 --> 00:00:55,560
...ليس حلماً

21
00:00:55,560 --> 00:00:57,360
!هذا الألم حقيقيّ

22
00:00:57,360 --> 00:00:58,800
أيمكنك المواصلة؟

23
00:01:00,200 --> 00:01:03,520
سأفعلها، أنا بخير. سأفعلها

24
00:01:04,030 --> 00:01:05,330
حسنٌ، أكمل القتال

25
00:01:06,810 --> 00:01:08,450
هذا خصمي؟

26
00:01:08,900 --> 00:01:11,190
أيّ هجوم وجّهه لي؟

27
00:01:11,880 --> 00:01:13,470
ماذا أفعل؟

28
00:01:13,470 --> 00:01:13,880
!ها هو

29
00:01:15,600 --> 00:01:18,510
يا للضغط الهائل، إنّه قويّ

30
00:01:19,040 --> 00:01:20,860
لم يسبق أن قاتلتُ شخصاً مثله

31
00:01:21,290 --> 00:01:23,460
لستُ ندّاً له، سأخسر

32
00:01:29,470 --> 00:01:30,860
!كلا، سأموت

33
00:01:38,430 --> 00:01:40,600
هل سأخسر؟

34
00:01:41,310 --> 00:01:44,260
هل سأموت هنا؟

35
00:03:17,110 --> 00:03:19,180
،في هذا اليوم

36
00:03:19,180 --> 00:03:24,390
،نُصّب لوكيوس دوميتيوس أهينوباربس، نيرو
الإمبراطور الخامس للإمبراطوريّة الرومانيّة

37
00:03:25,440 --> 00:03:31,600
في ربيعه السابع عشر، أصبح أصغر إمبراطور
بين من اعتلوا العرش

38
00:03:31,600 --> 00:03:37,040
!يحيا الإمبراطور

39
00:03:49,050 --> 00:03:50,000
!طعام

40
00:03:58,030 --> 00:03:59,150
!ابتعد

41
00:03:59,150 --> 00:03:59,860
!اصمت

42
00:03:59,860 --> 00:04:00,920
!تبّاً لك

43
00:04:02,540 --> 00:04:05,420
لنتقاسم الطعام بتساوٍ، اتّفقنا؟

44
00:04:05,870 --> 00:04:10,390
لستما الوحيدين المنفعلين لتضوّرهما جوعاً

45
00:04:10,780 --> 00:04:12,000
حسناً

46
00:04:12,000 --> 00:04:14,010
ارفق بنا يا روكّو

47
00:04:14,010 --> 00:04:16,110
طالما أنّك تفهم

48
00:04:17,790 --> 00:04:19,400
تعال يا سيستس

49
00:04:19,980 --> 00:04:21,150
شاركنا

50
00:04:21,850 --> 00:04:22,570
حسناً

51
00:04:23,500 --> 00:04:24,650
هاك

52
00:04:24,650 --> 00:04:25,660
شكراً

53
00:04:25,990 --> 00:04:27,940
أعتذر على جعلك تهتمّ بي

54
00:04:28,990 --> 00:04:30,670
أنتَ شابٌ عظيم يا روكّو

55
00:04:32,570 --> 00:04:36,920
كُل كما يجب أيّها البطيء وإلّا
لن تكبر أبداً

56
00:04:36,920 --> 00:04:39,220
معك حقّ، آسف

57
00:04:39,220 --> 00:04:41,750
لا تعتذر على كلّ شيءٍ يا أحمق

58
00:04:41,750 --> 00:04:42,520
حسناً

59
00:04:44,750 --> 00:04:46,300
اخرجوا جميعاً

60
00:04:46,300 --> 00:04:49,650
سيبدأ الانتقاء النهائيّ الآن

61
00:04:49,650 --> 00:04:53,550
سيشارك المقاتلون التالية أسماؤهم
في معارك صوريّة

62
00:04:53,550 --> 00:04:57,070
سيتمّ تمرين الفائزين وحدهم على الملاكمة

63
00:04:57,070 --> 00:04:59,240
أوّلاً، روكّو وسيستس

64
00:04:59,820 --> 00:05:01,320
قتال؟

65
00:05:01,320 --> 00:05:02,880
وضدّ روكّو؟

66
00:05:03,670 --> 00:05:05,950
لا خيار أمامنا يا سيستس

67
00:05:06,170 --> 00:05:08,200
إنّه حسن البنية

68
00:05:08,200 --> 00:05:11,450
شجاعة روكّو وقوّته من المقام الأوّل

69
00:05:11,740 --> 00:05:14,230
لا يشبه بقيّة الفتيان

70
00:05:15,980 --> 00:05:17,710
شدّ صُلبك يا سيستس

71
00:05:18,310 --> 00:05:19,700
معلّم ظفر؟

72
00:05:20,110 --> 00:05:20,960
هات يدك

73
00:05:22,110 --> 00:05:23,550
ماذا أفعل يا معلّمي؟

74
00:05:24,070 --> 00:05:26,090
هذا قتالك الأوّل، صحيح؟

75
00:05:26,090 --> 00:05:28,970
روكّو شديد البسالة في المعارك

76
00:05:29,200 --> 00:05:32,460
لم أعلّمك كيف تعارك

77
00:05:33,870 --> 00:05:35,980
لا تخف، ونفّذ كما تعلّمت

78
00:05:38,290 --> 00:05:44,050
كان الملاكمون القُدماء يلفّون قبضاتهم
بقفّازات مرصوصة بالحديد

79
00:05:44,050 --> 00:05:46,740
سيستس، لا تتهاون معي

80
00:05:50,140 --> 00:05:51,120
!ابدآ

81
00:05:51,770 --> 00:05:56,430
لم تكن هنالك درجات وزن أو نظام نقاط
عند الملاكمين القُدماء

82
00:05:56,430 --> 00:05:59,290
لم يكن هناك حدّ زمنيّ، والقاعدة الوحيدة

83
00:05:59,290 --> 00:06:01,130
هي القتال حتّى يحقّق أحد الملاكمين نصراً تاماً

84
00:06:01,970 --> 00:06:03,880
يا للوضعيّة الغريبة

85
00:06:04,330 --> 00:06:06,380
لا تكنّ لي الضغينة يا سيستس

86
00:06:06,600 --> 00:06:08,380
هذا نزال ملاكمة

87
00:06:08,380 --> 00:06:10,510
عليك تحمّل ضربة واحدة فحسب

88
00:06:14,250 --> 00:06:14,830
-ما

89
00:06:14,830 --> 00:06:16,160
ما كان ذلك؟

90
00:06:16,160 --> 00:06:18,140
...ظننتُني ضربته، لكنّي

91
00:06:23,530 --> 00:06:25,140
!لا تتردّد يا سيستس

92
00:06:25,140 --> 00:06:26,780
!من الإساءة أن تتهاون

93
00:06:27,850 --> 00:06:29,150
...لكن أنا

94
00:06:29,400 --> 00:06:32,030
!يتهاون؟ لا تستخفّ بي

95
00:06:33,420 --> 00:06:36,120
لمَ عليّ ضرب صديقي؟

96
00:06:36,330 --> 00:06:37,740
!لا أريد هذا

97
00:06:37,740 --> 00:06:39,120
لا أستطيع لمسه حتّى

98
00:06:39,410 --> 00:06:43,250
لا تهرب! سيستمرّ النزال للأبد
!إذا لم تغلبه

99
00:06:43,520 --> 00:06:46,260
لمَ عليّ فعل هذا؟

100
00:06:46,590 --> 00:06:48,320
ليست لعبة ملاحقة

101
00:06:48,320 --> 00:06:50,130
!هلمّ بما لديك يا سيستس

102
00:06:52,050 --> 00:06:52,640
!روكّو

103
00:07:02,490 --> 00:07:04,480
ساقاي لا تتحرّكان

104
00:07:04,760 --> 00:07:07,450
أرجوك يا روكّو، لا تنهض

105
00:07:08,150 --> 00:07:09,160
لا يمكنه النهوض

106
00:07:10,700 --> 00:07:12,490
...لا-لا يُعقل

107
00:07:14,840 --> 00:07:17,950
مُبهر، فاجأتني يا سيستس

108
00:07:17,950 --> 00:07:18,730
...روكّو

109
00:07:19,400 --> 00:07:21,760
أنت سريعٌ جدّاً، لم أستطع رؤية حركاتك حتّى

110
00:07:22,490 --> 00:07:24,880
كنتَ تخدعني حتّى الآن

111
00:07:25,450 --> 00:07:27,270
أ-أنا آسف

112
00:07:27,270 --> 00:07:28,630
أيمكنك الوقوف؟

113
00:07:33,590 --> 00:07:35,740
...أحمق، أخبرتك أنّ لا داعي للاعتـ

114
00:07:37,390 --> 00:07:39,830
!ر-روكّو

115
00:07:40,700 --> 00:07:43,360
...سيستس

116
00:07:51,130 --> 00:07:53,910
!لمَ؟ لمَ فعلتم هذا؟

117
00:07:54,320 --> 00:07:56,170
تذكّر كلامي

118
00:07:56,950 --> 00:07:58,530
لا أحتاج للخاسرين

119
00:07:58,530 --> 00:08:01,040
فعندي عدد وفير من البُدلاء

120
00:08:01,630 --> 00:08:04,020
لا مستقبل للخاسرين

121
00:08:04,020 --> 00:08:06,300
هذا مصير العبد المُقاتل

122
00:08:08,760 --> 00:08:11,300
كان اسم الفتى هو سيستس

123
00:08:11,770 --> 00:08:17,530
،كمقاتل عبد في الخامسة عشر
كان يقبع في قاع المجتمع

124
00:08:21,910 --> 00:08:26,400
هذا الوسم هو الحرف الأوّل من اسمي، يولانيوس فالينس

125
00:08:26,400 --> 00:08:28,020
لكنّي فزتُ بالنزال، لمَ؟

126
00:08:32,570 --> 00:08:36,780
إنّه دلالةٌ على امتلاكي لكم

127
00:08:37,300 --> 00:08:40,040
"والحرف الأوّل من كلمة "النصر

128
00:08:40,480 --> 00:08:45,040
ستستعمل قبضتك تلك من الآن فصاعداً
للقتال والانتصار لأجلي

129
00:08:45,320 --> 00:08:49,040
وستبلغ الثراء ومصاعد الشهرة تحت رايتي

130
00:08:49,520 --> 00:08:51,690
أنا رجلٌ عطوف

131
00:08:51,690 --> 00:08:55,180
أعد كلّ من يحقّق مئة فوزٍ منكم بالحريّة

132
00:08:57,550 --> 00:08:59,810
مـ-مئة فوز؟

133
00:09:00,140 --> 00:09:03,060
لكنّنا سنُقتل إذا خسرنا ولو نزالاً واحداً

134
00:09:10,790 --> 00:09:12,030
!تفاداها كلّها

135
00:09:12,030 --> 00:09:13,280
!لا تتراجع

136
00:09:13,540 --> 00:09:15,360
،طالما تتفادى هجمات خصمك في مرماك

137
00:09:15,360 --> 00:09:17,740
!ستصله لكماتك

138
00:09:17,740 --> 00:09:19,410
!اضرب دون أن تُضرب

139
00:09:19,410 --> 00:09:21,160
!الهجوم والدفاع متّحدان سوياً

140
00:09:23,710 --> 00:09:26,160
إنّه صبّي هشّ لا يستطيع تحمّل
ضربة واحدة قويّة

141
00:09:26,870 --> 00:09:29,920
لا يمكنني تأمّل توجيهه لضربة قاضية واحدة

142
00:09:30,430 --> 00:09:33,170
لا مفرّ له من القتال بتفادي ضربات خصمه
وإغراقه بوابل من اللكمات

143
00:09:33,870 --> 00:09:37,930
لكنّ نظرته الثاقبة وحركته الخاطفة
لا تشوبهما شائبة

144
00:09:38,510 --> 00:09:42,110
إنّه موهبةٌ فريدة ستحدث ثورة
في رياضة الملاكمة الدامية

145
00:09:42,930 --> 00:09:46,770
سيكون التحدّي في تغيير عقليّته

146
00:09:51,250 --> 00:09:53,370
لا يمكنك هزيمة الخصوم الأقوياء بيديك فحسب

147
00:09:54,540 --> 00:09:57,690
تبدأ الضربة القويّة من أطراف أصابع أقدامك وركبتيك

148
00:10:00,490 --> 00:10:01,450
راقبني

149
00:10:01,450 --> 00:10:03,200
امتدّ من أسفل ركبتيك

150
00:10:03,700 --> 00:10:04,700
وأدر خصرك

151
00:10:05,060 --> 00:10:06,200
ولفّ كتفيك

152
00:10:06,560 --> 00:10:07,710
ثمّ اضرب بقبضتك

153
00:10:09,210 --> 00:10:10,710
مذهل

154
00:10:12,620 --> 00:10:13,710
!معلّمي

155
00:10:15,750 --> 00:10:17,380
مثير للشفقة

156
00:10:17,380 --> 00:10:20,350
الرجل المعروف سابقاً بذئب نوميديا
الذي لا يُهزم

157
00:10:20,350 --> 00:10:22,970
لا يستطيع حتّى الاعتناء بصبيٍّ الآن

158
00:10:23,220 --> 00:10:24,420
نزالك يقترب

159
00:10:25,000 --> 00:10:26,730
علينا مواصلة التمرين

160
00:10:26,730 --> 00:10:28,820
نـ-نزال؟

161
00:10:28,820 --> 00:10:33,750
قتال بين المدارس التمرينيّة باستضافة
الإمبراطور نفسه في حلبة في روما

162
00:10:34,180 --> 00:10:38,990
ستُجبر على القتال بين البالغين كمقاتل عبد

163
00:10:39,360 --> 00:10:41,190
إنّه نزالٌ على المسرح الكبير

164
00:10:45,530 --> 00:10:47,070
كـ-كبير

165
00:10:47,070 --> 00:10:48,570
أصغي لي يا سيستس

166
00:10:49,610 --> 00:10:53,350
سيكون قتالك الأوّل الحقيقيّ
في تلك الحلبة

167
00:10:53,350 --> 00:10:55,000
ستصبح أرضك المقدّسة

168
00:10:55,320 --> 00:10:57,410
ارم بقبضتك لأجل نفسك

169
00:10:57,410 --> 00:11:01,770
وانتصر وأمسك بمستقبلك

170
00:11:02,500 --> 00:11:04,540
...مستقبلي

171
00:11:06,090 --> 00:11:10,560
روما القديمة، التعداد السكّانيّ
قرابة مليون ومئتا ألف نسمة

172
00:11:10,560 --> 00:11:13,780
عاصمةٌ كانت مركز الإمبراطوريّة الرومانيّة

173
00:11:13,780 --> 00:11:19,310
كما رمز الإمبراطوريّة وهي تدخل العصر الذهبيّ

174
00:11:20,990 --> 00:11:24,660
لمَ كلّ شيءٌ هنا كبير الحجم؟

175
00:11:24,660 --> 00:11:25,310
أنت هناك

176
00:11:26,190 --> 00:11:28,500
أهذه أوّل مرّة لك في روما؟

177
00:11:28,500 --> 00:11:34,580
أجل، أتيتُ لخوض نزالٍ هنا في الواقع
لكنّي انفصلتُ عن مجموعتي

178
00:11:34,580 --> 00:11:36,190
نزال؟

179
00:11:36,900 --> 00:11:40,880
أأنت مقاتل عبد؟ ببنيتك الصغيرة هذه؟

180
00:11:40,880 --> 00:11:43,880
الـ-اليوم أوّل قتالٍ لي

181
00:11:44,500 --> 00:11:46,600
خذ ذاك المنعطف وانزل للأسفل

182
00:11:47,050 --> 00:11:48,920
هناك مكان اجتماعكم

183
00:11:50,030 --> 00:11:51,090
شكراً لمساعدتك

184
00:11:55,310 --> 00:11:57,900
!أنا سيستس، شكراً لك ثانيةً

185
00:11:58,120 --> 00:12:00,890
أنا روسكا، فلتفز يا سيستس

186
00:12:15,670 --> 00:12:19,110
هذا النشاط القاسي يُعتبر ترفيهاً في روما؟

187
00:12:19,110 --> 00:12:20,520
يا للأسى

188
00:12:29,510 --> 00:12:30,280
ميغيل؟

189
00:12:33,370 --> 00:12:35,730
فـ-فزتُ يا سيستس

190
00:12:35,730 --> 00:12:39,480
كنتُ محظوظاً، كان خصمي صبيّاً أيضاً

191
00:12:40,690 --> 00:12:42,850
هُزم نيكو ونوريس

192
00:12:42,850 --> 00:12:45,820
البالغون أقوياء حقّاً

193
00:12:45,820 --> 00:12:47,890
ماتا كلاهما؟

194
00:12:49,960 --> 00:12:51,450
سيستس، دورك

195
00:13:01,390 --> 00:13:03,530
!كفّ عن الارتجاف، تبّاً

196
00:13:07,760 --> 00:13:10,680
!نزال اليوم التاسع

197
00:13:10,680 --> 00:13:14,830
!المتحدّي هو سيستس من مدرسة تمرين فالينس

198
00:13:14,830 --> 00:13:15,800
!لن أخسر

199
00:13:16,590 --> 00:13:20,150
!خصمه من مدرسة تمرين ماريوس

200
00:13:20,590 --> 00:13:21,420
!غيدون

201
00:13:33,770 --> 00:13:36,140
سيُضرب هذا الفتى حتّى الموت أيضاً

202
00:13:36,540 --> 00:13:38,580
ماذا؟ مجرّد صبيّ؟

203
00:13:38,580 --> 00:13:39,520
!ابدآ

204
00:13:52,930 --> 00:13:53,970
!أيّها الصغير

205
00:13:56,900 --> 00:13:58,060
!حسنٌ! نل منه

206
00:14:05,760 --> 00:14:07,820
مستحيل، أخسر لصبيّ مثله؟

207
00:14:08,120 --> 00:14:10,140
!يمكنني فعلها، أستطيع هزيمته

208
00:14:10,610 --> 00:14:12,580
!تقنيات معلّمي مثاليّة

209
00:14:28,740 --> 00:14:30,630
!الفائز هو سيستس

210
00:14:35,800 --> 00:14:39,480
جميل، يا للقتال الرائع

211
00:14:41,470 --> 00:14:42,670
فزت يا روكّو

212
00:14:43,260 --> 00:14:45,550
اقتربتُ خطوةً من الحرّية

213
00:14:46,230 --> 00:14:48,630
!اقتلوه! اقتلوه

214
00:14:48,630 --> 00:14:50,240
أكنتَ تحاول حتّى؟

215
00:14:50,560 --> 00:14:52,470
!اقتلوه

216
00:14:50,560 --> 00:15:03,750
!اقتلوه! اقتلوه! اقتلوه

217
00:14:52,740 --> 00:14:58,250
،وُلِدت من نزالات مصارعيّ روما القديمة
كانت هذه إشارة الموت

218
00:14:59,050 --> 00:15:03,750
موت الخاسر من حياته كانت منوطةً
بالمتفرّجين عديمي المسؤولية

219
00:15:03,750 --> 00:15:07,650
!ا-انتظروا! لستُ محطّماً

220
00:15:03,750 --> 00:15:14,590
!اقتلوه! اقتلوه! اقتلوه

221
00:15:07,650 --> 00:15:09,380
!أهملتُ دفاعي فحسب

222
00:15:09,380 --> 00:15:10,520
،في هذه الحالات

223
00:15:14,590 --> 00:15:17,640
جلالتك، أستجدي رحمتك

224
00:15:14,590 --> 00:15:20,560
!اقتلوه! اقتلوه! اقتلوه

225
00:15:17,640 --> 00:15:20,190
جلالتك، ما قرارك؟

226
00:15:20,190 --> 00:15:23,650
ماذا؟ حسناً، ماذا أفعل؟

227
00:15:26,460 --> 00:15:28,530
!كلا! لا تفعل هذا يا سيستس

228
00:15:31,790 --> 00:15:33,250
...حسنٌ، اصفـ

229
00:15:33,250 --> 00:15:34,530
!اقتلوهما

230
00:15:34,900 --> 00:15:36,780
!اقطعوا رأسيهما

231
00:15:36,780 --> 00:15:41,630
يجب ألّا يُسمح لمقاتل عبد بأن
!يوجّه أوامرَ للإمبراطور االرومانيّ أبداً

232
00:15:41,630 --> 00:15:43,040
!أ-أمّي

233
00:15:43,300 --> 00:15:45,690
مع كامل احترامي يا مولاتي أرملة الإمبراطور

234
00:15:46,780 --> 00:15:50,350
في هكذا لحظات، لا بدّ على الإمبراطور
أن يظهر مقامه الرفيع بين الناس

235
00:15:50,350 --> 00:15:53,300
بالحكم على الموقف بهدوء

236
00:15:57,260 --> 00:15:59,500
أسحب أمري لأجل نيرو إذاً

237
00:15:59,500 --> 00:16:01,430
افعل ما تراه مناسباً

238
00:16:01,650 --> 00:16:04,810
لنعطِ شعب روما ما يريدونه إذاً

239
00:16:07,860 --> 00:16:08,970
!لا تتمادَ

240
00:16:08,970 --> 00:16:10,300
أتنوي الموت؟

241
00:16:10,300 --> 00:16:12,040
كان مجرّد نصرٍ واحد

242
00:16:12,040 --> 00:16:14,240
!كيف تتعاطف مع الخاسر؟

243
00:16:14,450 --> 00:16:18,230
لـ-لكنّ خصمي يموت كلّما أفوز

244
00:16:18,230 --> 00:16:21,180
!أنا بمثابة القاتل

245
00:16:22,720 --> 00:16:24,750
!هذا واقع الملاكمة

246
00:16:24,750 --> 00:16:27,590
!كلّ ما بإمكانك فعله هو مواصلة الركض بلا هوادة

247
00:16:27,830 --> 00:16:31,890
إحباطك وحزنك وألمك وغضبك

248
00:16:31,890 --> 00:16:34,280
سبيلك الوحيد للنجاة هو الإمساك بها

249
00:16:34,280 --> 00:16:37,320
!بقبضتك ومواصلة الانتصار يا سيستس

250
00:16:41,050 --> 00:16:43,500
سيستس، رافقني

251
00:16:43,500 --> 00:16:45,600
جلالة الإمبراطور يستدعيك

252
00:16:47,870 --> 00:16:50,610
أنت صغير الحجم عن قرب حقّاً

253
00:16:51,100 --> 00:16:52,810
لا تزال في الخامسة عشر فحسب؟

254
00:16:52,810 --> 00:16:55,400
أي أنّك أصغر بعامين منّي

255
00:16:55,850 --> 00:16:57,870
كان نزالاً مُبهراً

256
00:16:57,870 --> 00:17:01,750
هذا الصبيّ هو إمبراطور روما؟

257
00:17:03,120 --> 00:17:05,250
من ذاك؟

258
00:17:05,850 --> 00:17:07,370
ظفر نوميديا

259
00:17:07,870 --> 00:17:10,750
أعلّم هذا الصبيّ الملاكمة

260
00:17:10,750 --> 00:17:12,330
ظفر؟

261
00:17:12,330 --> 00:17:16,100
...أذكر وجود مقاتل عبد بهذا الاسم

262
00:17:17,450 --> 00:17:21,260
دميتريوس، إنّه الرجل الذي قاتلك

263
00:17:21,470 --> 00:17:27,720
صحيح، قاتلتُه في شرف حضور الإمبراطور
كلوديوس قبل 10 أعوام

264
00:17:29,330 --> 00:17:32,150
كان أفضل قتال قطّ

265
00:17:33,010 --> 00:17:33,730
بالفعل

266
00:17:34,220 --> 00:17:36,750
ماذا؟ معلّمي أيضاً؟

267
00:17:36,750 --> 00:17:39,290
ألم يحطّم ذاك القتال ركبته؟

268
00:17:43,140 --> 00:17:44,430
جلالتك

269
00:17:44,430 --> 00:17:49,670
رتّبتُ لنزال ختاميّ خاص احتفالاً باعتلائك للعرش

270
00:17:49,670 --> 00:17:53,170
حقّاً؟ أ-أتوق لرؤيته

271
00:17:53,690 --> 00:17:55,820
!قتال اليوم الأخير

272
00:17:58,110 --> 00:18:00,180
!أيّها المُقاتلان، ادخلا الحلبة

273
00:18:01,000 --> 00:18:03,240
مقاتل بسول من بلاد قرطاج الساقطة

274
00:18:03,660 --> 00:18:06,430
!الوحش الهائم، كيندل

275
00:18:07,160 --> 00:18:12,090
وخصمه هو التلميذ الأوّل لفرقة
!القتال الإمبراطوريّة العزلاء

276
00:18:15,850 --> 00:18:16,950
إنّه هو

277
00:18:16,950 --> 00:18:21,070
!غلام روما المقاتل، روسكا دميتريوس

278
00:18:23,360 --> 00:18:26,080
دميتريوس؟ أيمكن؟

279
00:18:26,080 --> 00:18:31,320
جلالتك، الملاكمة هي رياضة قتال ركيكة

280
00:18:31,320 --> 00:18:34,340
سترى دليلاً حيّاً على ذلك

281
00:18:34,340 --> 00:18:37,940
الغلام في الحلبة هو ابني، روسكا دميتريوس

282
00:18:39,850 --> 00:18:41,340
!روسكا

283
00:18:41,340 --> 00:18:43,220
!ليتقدّم المقاتلان للمنتصف

284
00:18:43,480 --> 00:18:46,180
يا-يا للحدّة

285
00:18:46,620 --> 00:18:50,360
يمكنك استشعار روحه وقوّته
حتّى من على هذا البعد

286
00:18:50,890 --> 00:18:53,520
إنّه في مستوى آخر عن الطويل
الهزيل الذي هزمته

287
00:18:54,720 --> 00:18:56,690
ما يدهشني هو ذاك الفتى

288
00:18:57,390 --> 00:19:00,530
يواجه ملاكماً مخضرماً، ولا يبدي أيّ خوف أو حماس

289
00:19:01,340 --> 00:19:03,700
إنّه خبير رغم صغر سنّه

290
00:19:04,060 --> 00:19:04,700
!ابدآ

291
00:19:11,310 --> 00:19:12,650
ما كان ذلك؟

292
00:19:12,650 --> 00:19:15,130
أهي رياضة قتاليّة مختلفة كليّاً عن الملاكمة؟

293
00:19:15,130 --> 00:19:19,440
يا وحش قرطاج، أثني على سجّلك المُبهر

294
00:19:19,440 --> 00:19:21,630
لنتبادل الضربات

295
00:19:29,070 --> 00:19:30,680
أسقطه أرضاً بصفعة؟

296
00:19:30,680 --> 00:19:34,060
كلّا، كانت الضربة الأخيرة ضربة مشط الراحة السفليّ

297
00:19:34,760 --> 00:19:37,180
إنّه يصيب ذقنه بدقّة

298
00:19:37,630 --> 00:19:39,820
إنّها أقوى بكثير من اللكمات الهزيلة

299
00:19:41,100 --> 00:19:43,530
الضربات القاضيّة تفتقر للذوق حقّاً

300
00:19:44,010 --> 00:19:45,570
عليّ إنهاؤه

301
00:19:46,830 --> 00:19:48,180
أزال دفاعه؟

302
00:19:48,180 --> 00:19:50,030
كما تريد أيّها الصغير اللعين

303
00:19:50,030 --> 00:19:54,380
سأسحق وجهك بحقد قرطاج
!ذي الثلاثمئة عام

304
00:19:54,380 --> 00:19:56,840
!مُت أيّها الرومانيّ

305
00:19:59,260 --> 00:20:01,340
!اللكمات التي لا تصيب ليست تهديداً

306
00:20:06,810 --> 00:20:07,850
!كسرها

307
00:20:10,180 --> 00:20:11,670
!رائع يا روسكا

308
00:20:11,670 --> 00:20:13,200
!ابن مارس المفضّل

309
00:20:13,600 --> 00:20:17,110
دميتريوس، ما تلك الرياضة القتاليّة؟

310
00:20:17,330 --> 00:20:19,130
إنّها تركيبة للرياضات القتاليّة

311
00:20:19,130 --> 00:20:21,310
تُدعى بالبانكراتيون

312
00:20:22,210 --> 00:20:26,200
أصلها هو موطني اليونان

313
00:20:26,720 --> 00:20:32,370
أساسها المصارعة، وأُضيفت لها الفنون القتاليّة
الشرقيّة من قبل جنودنا

314
00:20:32,370 --> 00:20:33,880
!إنّها الرياضة القتاليّة المُطلقة

315
00:20:34,570 --> 00:20:36,710
الرياضة القتاليّة المُطلقة؟

316
00:20:37,040 --> 00:20:41,390
تسخّر تقنيات الضرب والرمي والإمساك

317
00:20:41,390 --> 00:20:44,820
أي أنّ البانكراتيون هي أقوى رياضة قتاليّة على الإطلاق

318
00:20:45,220 --> 00:20:47,120
هل فهمت الآن جلالتك؟

319
00:20:47,120 --> 00:20:52,160
الملاكمة لا تعدو عن كونها
أكثر الرياضات القتاليّة بدائيّةً

320
00:20:52,630 --> 00:20:58,250
،ظفر، كما ترى عيناك
سيرث ذاك الغلام تقنياتي

321
00:21:00,670 --> 00:21:03,800
...روسكا دميتريوس

322
00:22:39,870 --> 00:22:43,330
لا تعرف من أكون؟ لا بدّ أنّك
لست من أهل المكان

323
00:22:43,330 --> 00:22:45,430
أنت، افتح الطريق

324
00:22:45,430 --> 00:22:48,340
سترى شيئاً مثيراً قريباً

325
00:22:48,550 --> 00:22:51,280
!لن تملك دافعاً للعيش ولا قيمة دون قتال

326
00:22:51,280 --> 00:22:53,300
عليك فعلها يا سيستس