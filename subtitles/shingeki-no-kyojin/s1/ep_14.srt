1
00:00:01,330 --> 00:00:04,040
.هيّا، أجب أيّها الحثالة

2
00:00:04,840 --> 00:00:06,550
ماذا تريد أن تفعل؟

3
00:00:11,930 --> 00:00:13,850
أريد أن أنضمّ لفيلق الاستطلاع

4
00:00:14,430 --> 00:00:17,060
!وأنحر العمالقة فحسب

5
00:00:19,730 --> 00:00:20,890
فعلاً؟

6
00:00:20,890 --> 00:00:21,980
.لا بأس بك

7
00:00:23,480 --> 00:00:24,560
،إروين

8
00:00:24,560 --> 00:00:26,820
.سأتحمّل مسؤوليّته

9
00:00:27,730 --> 00:00:29,360
.أخبر كبار الضبّاط بذلك

10
00:00:30,150 --> 00:00:32,740
.ليس وكأنّني أثق به

11
00:00:33,240 --> 00:00:37,910
.إن خاننا أو فقد السّيطرة على نفسه، فسأقتله على الفور

12
00:00:38,490 --> 00:00:40,290
.لا ينبغي أن يعارضوا

13
00:00:40,750 --> 00:00:43,250
.لأنّي الوحيد القادر على فعل ذلك

14
00:00:43,750 --> 00:00:45,250
.قبلتُ طلبك

15
00:00:45,920 --> 00:00:48,170
.يمكنك الانضمام إلى فيلق الاستطلاع

16
00:02:39,320 --> 00:02:43,450
بالمناسبة، أثمّة عملاق متحالف مع البشر حقًّا؟

17
00:02:43,870 --> 00:02:45,710
.من الواضح أنّها محض إشاعة

18
00:02:46,000 --> 00:02:51,130
قد تفشل مهمّة استرجاع أرضنا، وسينتهي بنا
.المطاف بإيواء العديد من اللّاجئين من سور روز

19
00:02:54,460 --> 00:02:58,180
.سرعان ما سنعاني من نقص في الغذاء إن حدث ذلك

20
00:02:58,180 --> 00:02:59,260
...اسمع

21
00:02:59,260 --> 00:03:05,810
.قد ينضمّ ذلك العملاق إلى مواطني روز ويغزونا

22
00:03:07,690 --> 00:03:09,600
!هذا مذهل

23
00:03:09,940 --> 00:03:12,730
!ظهر عملاق إلى جانبنا

24
00:03:12,940 --> 00:03:16,820
!لعلّنا نستطيع حتّى استرجاع سور ماريا

25
00:03:16,820 --> 00:03:17,900
...بل ويمكننا حتّى

26
00:03:17,900 --> 00:03:20,280
!بل ويمكننا حتّى أن نعتبره مُنقذنا

27
00:03:25,830 --> 00:03:27,580
مُنقذ؟

28
00:03:29,540 --> 00:03:33,090
.مهما كان العصر، يظلّ النّاس مستهترين

29
00:03:34,550 --> 00:03:37,760
.سيكون بيدقًا على الأغلب في الثّورة ضدّ المركز

30
00:03:38,170 --> 00:03:42,510
قبل حدوث ذلك، علينا نحن الشّرطة
.العسكريّة القضاء على إرين ييغر

31
00:03:43,470 --> 00:03:45,930
لا يمكننا السّماح لغريبي الأطوار
.أولئك من فيلق الاستطلاع أخذه

32
00:03:49,600 --> 00:03:50,650
!انتباه

33
00:03:59,740 --> 00:04:01,280
!حيّوا رئيسنا

34
00:04:04,740 --> 00:04:06,040
...الطّقس حارّ

35
00:04:08,290 --> 00:04:09,830
،أيّها القائد بيكشيس

36
00:04:09,830 --> 00:04:14,920
ألا تظنّ أنّ البعض لن يقبلوا لقاء
قائد الحامية سرًّا

37
00:04:15,340 --> 00:04:18,090
مع مقدّم فيلق الاستطلاع؟

38
00:04:18,590 --> 00:04:22,300
.أنت متكلّف كما يشاع عنك

39
00:04:22,970 --> 00:04:23,800
.لا تقلق

40
00:04:23,800 --> 00:04:27,810
.صادف أن التقيتُ بك أثناء نزهتي الصّباحيّة

41
00:04:29,180 --> 00:04:32,690
ونحن نتشارك محادثة قصيرة فحسب
.بينما أستمتع بنزهتي

42
00:04:33,650 --> 00:04:38,440
هل تعرف أنّ الشّرطة العسكريّة
تريد الآن إرين ييغر أيضًا؟

43
00:04:38,440 --> 00:04:39,530
.نعم

44
00:04:39,530 --> 00:04:41,200
.استلمتُ رسالةً البارحة

45
00:04:41,900 --> 00:04:43,950
.سيبتّ مجلس قضائيّ عسكريّ في ذلك

46
00:04:45,160 --> 00:04:49,660
لقد صُرّح لزاكّري ليُقرّر ما إن كان

47
00:04:50,040 --> 00:04:52,460
.فيلق الاستطلاع أو الشّرطة العسكريّة ستأخذه

48
00:04:53,080 --> 00:04:54,250
...زاكّري

49
00:04:54,750 --> 00:04:56,790
رئيس الأركان داليس زاكّري؟

50
00:04:58,050 --> 00:05:04,050
:الرّجل الّذي يتحكّم بكلّ القوّات العسكريّة الثّلاث
.الشّرطة العسكريّة والحامية وفيلق الاستطلاع

51
00:05:04,680 --> 00:05:09,180
:تستند قراراته على معيار واحد فقط

52
00:05:09,180 --> 00:05:12,190
.ما إن كان الأمر في صالح البشريّة أم العكس

53
00:05:12,190 --> 00:05:14,060
،إن كان يعتبر إرين تهديدًا

54
00:05:14,060 --> 00:05:16,810
.فسيأمر بإعدامه دونما تردّد

55
00:05:16,980 --> 00:05:18,610
.وعلى الفور

56
00:05:19,690 --> 00:05:22,150
.لا أريد أن أدع إرين يموت

57
00:05:22,990 --> 00:05:29,700
...لكن للأسف، الكثير من الحامية يخافون منه

58
00:05:30,160 --> 00:05:35,670
كلّ ما يمكنني فعله هو أن أرفض
.تأييد الشّرطة العسكريّة

59
00:05:37,710 --> 00:05:39,250
أتظنّ أنّك تستطيع أن تفوز؟

60
00:05:40,590 --> 00:05:41,630
.لا

61
00:05:42,670 --> 00:05:44,970
.لكنّي مستعدّ لتقديم اقتراح

62
00:05:46,300 --> 00:05:49,680
.يعتمد نجاحه من عدمه على طريقة سير التّحقيق

63
00:05:51,100 --> 00:05:53,890
إذًا لن تعرف إلى أن تذهب إلى هناك؟

64
00:05:54,810 --> 00:05:57,020
.تقضي مأموريّتا بالتّحرّي خلف الأسوار

65
00:05:57,020 --> 00:05:59,110
.لذا لا نعلم ما سنرى إلى أن نصل إليه

66
00:06:01,980 --> 00:06:04,740
.أظنّك مثيرًا للاهتمام أكثر ممّا توقّعت

67
00:06:05,410 --> 00:06:08,490
.كانت نزهة ممتازة أيّها المقدّم سميث

68
00:06:14,710 --> 00:06:16,000
...استجواب إرين

69
00:06:16,960 --> 00:06:17,920
ماذا عنه؟

70
00:06:17,920 --> 00:06:21,800
لستُ واثقًا، لكن أظنّ أنّهم
.يقرّرون ما ينبغي فعله بشأن إرين

71
00:06:21,800 --> 00:06:23,260
ما ينبغي فعله بشأنه؟

72
00:06:23,550 --> 00:06:26,930
.على الأغلب ما إن كان يجب قتله أو تركه يعيش

73
00:06:32,560 --> 00:06:35,560
!ميكاسا أكرمان! أرمين أرليرت

74
00:06:35,560 --> 00:06:36,440
هل أنتما هنا؟

75
00:06:36,770 --> 00:06:37,850
.نعم

76
00:06:38,600 --> 00:06:42,230
.أُمرتُما بالامتثال كشاهدين في تحقيق هذا العصر

77
00:06:51,990 --> 00:06:53,910
.آسف، لكنّي بحاجة للذّهاب إلى المرحاض

78
00:06:53,910 --> 00:06:55,500
!ذهبت لتوّك

79
00:06:57,120 --> 00:06:58,420
.أعطني بعض الماء رجاءً

80
00:06:58,420 --> 00:06:59,210
...أنت

81
00:07:00,710 --> 00:07:03,590
.الزم حدّك أيّها الوحش

82
00:07:07,010 --> 00:07:08,430
وحش؟

83
00:07:09,010 --> 00:07:11,510
...هذا صحيح، لكن

84
00:07:13,970 --> 00:07:17,440
لكنّهم خائفون منّي لدرجة تقييدي بالأصفاد؟

85
00:07:18,310 --> 00:07:20,060
...أظنّني أفهم

86
00:07:20,610 --> 00:07:22,650
.كما ليس وكأنّني أعلم ما يجري

87
00:07:23,570 --> 00:07:27,240
.ربّما أنا محظوظ لأنّي لم أمت آنفًا

88
00:07:29,110 --> 00:07:30,240
...فبالتّفكير في الأمر

89
00:07:31,160 --> 00:07:34,950
.لم يكن ذلكما الاثنان خائفين منّي قطّ

90
00:07:37,710 --> 00:07:39,750
ماذا تراهما يفعلان الآن؟

91
00:07:43,540 --> 00:07:44,960
...والبقيّة

92
00:07:45,510 --> 00:07:46,670
ماذا حلّ بهم؟

93
00:07:50,800 --> 00:07:53,180
.أمهلنا بعض الوقت

94
00:07:54,260 --> 00:07:56,680
.سوف نقنعهم بطريقةٍ ما

95
00:07:57,600 --> 00:07:59,730
.مضت أيّام مذّاك الحين

96
00:08:00,520 --> 00:08:02,440
فما الّذي يجري في الخارج؟

97
00:08:02,980 --> 00:08:07,400
لن أظلّ هنا إلى الأبد، أليس كذلك؟

98
00:08:18,750 --> 00:08:20,790
أنت إرين إذًا؟

99
00:08:20,790 --> 00:08:22,250
هل أنت بخير؟ هل من جديد؟

100
00:08:23,080 --> 00:08:25,550
.أعتذر على التّأخّر عليك

101
00:08:25,550 --> 00:08:27,840
.لكن يبدو أنّك ستخرج أخيرًا

102
00:08:28,970 --> 00:08:32,340
.لكن عليك ارتداء هذه

103
00:08:37,270 --> 00:08:41,100
.أنا قائد فرقة في فيلق الاستطلاع، هانجي زوي

104
00:08:41,520 --> 00:08:44,980
.وهو قائد فرقة آخر، ميكي زاكارياس

105
00:08:44,980 --> 00:08:46,190
...عذرًا

106
00:08:47,940 --> 00:08:51,490
لديه عادة شمّ رائحة الأشخاص
،الّذين التقى بهم حديثًا

107
00:08:52,280 --> 00:08:54,030
.ثمّ يبتسم بتكلّف

108
00:08:54,660 --> 00:08:57,580
...لا أظنّ أنّ للأمر أيّ أهميّة حقيقيّة

109
00:08:57,580 --> 00:09:01,000
ففي النّهاية، إنّه جيّد كفاية لدرجة
.أن يجعلوا منه قائد فرقة

110
00:09:04,790 --> 00:09:09,010
.آسفة! الكثير من اللّغو

111
00:09:09,010 --> 00:09:10,590
.وصلنا بالفعل

112
00:09:11,510 --> 00:09:12,880
.لا تقلق

113
00:09:12,880 --> 00:09:15,510
.من مصلحتك ألّا تحصل على أيّ شرح مسبق

114
00:09:16,390 --> 00:09:17,470
!مهلاً

115
00:09:18,430 --> 00:09:20,560
،أعلم أنّ هذا أنانيّ

116
00:09:20,560 --> 00:09:22,850
.لكن لا خيار لدينا سوى أن نثق بك ثقةً عمياء

117
00:09:23,850 --> 00:09:24,980
!بالتّوفيق

118
00:09:39,160 --> 00:09:40,450
...المحكمة العسكريّة

119
00:09:41,830 --> 00:09:44,790
هل كنتُ أسفل المحكمة العسكريّة
طوال هذا الوقت؟

120
00:09:45,670 --> 00:09:47,210
.تقدّم

121
00:09:57,720 --> 00:09:59,220
!اجثُ مكانك

122
00:10:10,150 --> 00:10:12,320
ما هذا الصّفوف؟

123
00:10:12,320 --> 00:10:15,820
ما الّذي يحكمون عليه أساسًا هنا؟

124
00:10:18,370 --> 00:10:19,450
...أنتم

125
00:10:28,790 --> 00:10:30,750
.حسنًا، دعونا نبدأ

126
00:10:33,670 --> 00:10:35,760
إرين ييغر، صحيح؟

127
00:10:36,300 --> 00:10:40,810
أنت جنديّ أقسم على التّضحية بحياته
.من أجل الصّالح العامّ

128
00:10:41,220 --> 00:10:42,430
أهذا صحيح؟

129
00:10:42,810 --> 00:10:43,890
.نعم

130
00:10:44,310 --> 00:10:46,100
.هذا وضع استثنائيّ

131
00:10:46,100 --> 00:10:50,770
.ستُعقد هذه المحكمة بموجب عسكريّ، لا مدنيّ

132
00:10:50,770 --> 00:10:54,320
.والقرار النّهائيّ متروك لي بالكامل

133
00:10:55,240 --> 00:10:59,120
.سيُقرَّر مصيرك هنا

134
00:10:59,570 --> 00:11:00,620
...عرفتها

135
00:11:01,030 --> 00:11:02,660
هل لديك أيّ اعتراض؟

136
00:11:04,120 --> 00:11:05,080
.لا يا سيّدي

137
00:11:05,620 --> 00:11:07,580
.أقدّر بصيرتك

138
00:11:07,960 --> 00:11:09,830
.سأكون صريحًا

139
00:11:10,420 --> 00:11:14,550
.كما كان متوقّعًا، فقد كان من المستحيل إخفاء وجودك

140
00:11:15,130 --> 00:11:18,840
،يجب أن نجعل وجودك علنيًّا بشكلٍ ما

141
00:11:18,840 --> 00:11:22,100
.وإلّا قد يظهر تهديدٌ آخر على البشر عدا العمالقة

142
00:11:22,720 --> 00:11:27,730
ما سأقرّره اليوم هو أيّ القوّتان
.ستكون تحت عُهدتها

143
00:11:28,440 --> 00:11:30,020
الشّرطة العسكريّة؟

144
00:11:30,770 --> 00:11:32,360
أم فيلق الاستطلاع؟

145
00:11:33,610 --> 00:11:37,070
.إذًا، أطلب من الشّرطة العسكريّة تقديم اقتراحها

146
00:11:37,070 --> 00:11:37,900
.حاضر

147
00:11:37,900 --> 00:11:41,870
أنا مقدّم الشّرطة العسكريّة
.نايل دوك، وسأقدّم اقتراحي

148
00:11:42,620 --> 00:11:47,410
،بعد تحقيق شامل لجسد إرين

149
00:11:47,410 --> 00:11:50,170
.نعتقد أنّه يجب أن نتخلّص منه على الفور

150
00:11:51,830 --> 00:11:56,710
لا شكّ أنّ قوّة العملاق خاصّته
.تغلّبت على خطرنا السّابق

151
00:11:57,050 --> 00:12:02,100
.إلّا أنّ وجوده الآن يهدّد بإشعال حربٍ أهليّة

152
00:12:02,970 --> 00:12:07,270
،لذا نطلب منه أن يموت في سبيل البشريّة

153
00:12:07,270 --> 00:12:09,980
.تاركًا خلفه كلّ المعلومات الّتي يستطيع

154
00:12:10,810 --> 00:12:12,360
!لا حاجة لذلك

155
00:12:12,980 --> 00:12:14,610
!إنّه آفّة عدوانيّة

156
00:12:14,610 --> 00:12:17,570
!لقد خدع الأسوار الّتي تجسّد حكمة الرّب

157
00:12:15,650 --> 00:12:17,280
.إنّه من كنيسة الأسوار

158
00:12:17,570 --> 00:12:19,360
!يجب قتله حالاً

159
00:12:17,940 --> 00:12:20,740
...قبل خمس سنوات، لم يعرهم أحد أيّ اهتمام

160
00:12:19,360 --> 00:12:20,740
.أيّها الكاهن نيك

161
00:12:20,740 --> 00:12:22,410
.النّظام رجاءً

162
00:12:20,740 --> 00:12:22,410
.لكنّهم اكتسبوا السّلطة

163
00:12:24,240 --> 00:12:27,620
.سنصغي لاقتراح فيلق الاستطلاع تاليًا

164
00:12:28,000 --> 00:12:29,040
.حاضر

165
00:12:29,620 --> 00:12:32,170
،أنا، المقدّم الثّالث عشر لفيلق الاستطلاع

166
00:12:32,170 --> 00:12:34,750
.إروين سميث، وسأقدّم اقتراحي

167
00:12:35,500 --> 00:12:40,050
،سوف نرحّب بإرين كعضو رسميّ في قوّاتنا

168
00:12:40,050 --> 00:12:43,300
.ونسخّر قوّته لإرجاع سور ماريا

169
00:12:45,510 --> 00:12:46,560
.هذا كلّ شيء

170
00:12:49,350 --> 00:12:50,890
هذا كلّ شيء؟

171
00:12:50,890 --> 00:12:51,640
.نعم

172
00:12:52,100 --> 00:12:55,520
.نستطيع بواسطة قوّته استرجاع سور ماريا

173
00:12:55,980 --> 00:12:59,070
.نعتقد أنّ أوليّاتنا واضحة

174
00:12:59,650 --> 00:13:00,780
.فهمت

175
00:13:01,240 --> 00:13:05,740
وأين تنوون البدء في هذه المهمّة؟

176
00:13:06,370 --> 00:13:11,250
يا بيكسيس، أُغلق سور تروست بالكامل، صحيح؟

177
00:13:11,710 --> 00:13:15,330
.نعم، لا يمكن فتحه مجدّدًا أبدًا

178
00:13:16,250 --> 00:13:18,800
.نودّ الانطلاق من كارانيس في الشّرق

179
00:13:19,300 --> 00:13:20,970
.ومن هناك سنتقدّم إلى شيغانشينا

180
00:13:22,010 --> 00:13:24,550
.سنحدّد الطّريق  بينما نتقدّم

181
00:13:24,550 --> 00:13:26,140
!مهلاً لحظة

182
00:13:26,140 --> 00:13:29,350
ألا ينبغي أن نغلق كلّ بوّابات السّور إلى الأبد؟

183
00:13:29,350 --> 00:13:33,060
.يمكن للعملاق الضّخم تدمير البّوابات فحسب

184
00:13:33,060 --> 00:13:36,730
إن استطعنا تقويتها، فلن نعود
!بحاجة لتحمّل المزيد من الهجمات

185
00:13:36,730 --> 00:13:39,030
!اخرس أيّها الكلب التّاجر

186
00:13:39,030 --> 00:13:42,780
،بفضل قوّة العملاق تلك
!بوسعنا استرجاع سور ماريا

187
00:13:43,280 --> 00:13:47,200
!ما عاد يمكننا التّمادي في أوهام عظمتكم

188
00:13:47,200 --> 00:13:49,040
.تتكلّم كثيرًا أيّها الخنزير

189
00:13:49,990 --> 00:13:54,710
هل لديك دليل أنّ العمالقة
ستنتظرنا بينما نغلق البوّابات؟

190
00:13:55,460 --> 00:13:57,710
نحن" الّذين تتحدّث عنهم هم الوحيديون"

191
00:13:57,710 --> 00:14:00,760
"الّذين تتمنّى حمايتهم، "أصدقاؤنا
.الّذين يساعدونك على حشو جيوبك

192
00:14:01,960 --> 00:14:05,090
النّاس الّذين يعانون من الجوع لأنّهم
لا يملكون أرضًا كافية لزراعتها

193
00:14:05,090 --> 00:14:07,680
.لا يشغلون حتّى تفكيركم أيّها الخنازير

194
00:14:08,180 --> 00:14:12,520
ظننّا فقط أنّنا نستطيع النّجاة
—إن أغلقنا بوّابات الأسوار

195
00:14:12,520 --> 00:14:13,810
!صمتًا

196
00:14:13,810 --> 00:14:15,520
!خائنٌ آثم

197
00:14:15,520 --> 00:14:19,940
،محض بشر يغيّرون سور روز
الأسوار الّتي وهبنا إيّاها الرّب؟

198
00:14:20,730 --> 00:14:22,740
،أيمكنك حقّا رؤية تلك الأسوار

199
00:14:22,740 --> 00:14:24,900
،عمل الرّب الّذي يتجاوز المقدرة البشريّة

200
00:14:24,900 --> 00:14:26,820
ولا تفهم؟

201
00:14:25,660 --> 00:14:27,240
،بفضلهم

202
00:14:26,820 --> 00:14:29,530
!لا ينبغي للبشريّة أن تضع ولو إصبعًا على تلك الأسوار

203
00:14:27,240 --> 00:14:30,370
.استغرقنا وقتًا طويلاً حتّى لتركيب الأسلحة على الجدران

204
00:14:30,370 --> 00:14:34,160
،يملكون الكثير من الدّعم والسّلطة
.ما يجعل التّعامل معهم صعبًا

205
00:14:35,210 --> 00:14:36,370
!زنديق

206
00:14:36,370 --> 00:14:38,580
!سأُخرسك أيّها الكاهن

207
00:14:38,580 --> 00:14:39,420
ماذا؟

208
00:14:42,300 --> 00:14:43,590
.صمتًا

209
00:14:43,590 --> 00:14:47,470
بوسعكما مناقشة فلسفتكما الشّخصيّة
.وآرائكما في مكان آخر

210
00:14:47,930 --> 00:14:50,470
.ييغر، أودّ التّأكّد من شيء

211
00:14:51,100 --> 00:14:57,600
هل يمكنك أن تواصل خدمتك كجنديّ
وتُسخّر قوى العملاق خاصّتك لفائدة البشريّة؟

212
00:14:57,600 --> 00:14:59,520
!نعم، يمكنني

213
00:15:00,940 --> 00:15:05,450
...لكنّ تقرير دفاع تروست يفيد بهذا

214
00:15:06,240 --> 00:15:11,620
سرعان ما تحوّل إلى عملاق، أخذ"
".يلوّح بقبضته تجاه ميكاسا أكرمان

215
00:15:13,700 --> 00:15:17,120
...لا يذكُر عدم استطاعته التّحكّم فيه

216
00:15:18,250 --> 00:15:20,920
هل تريدينني أن أكذب في التّقرير؟

217
00:15:20,920 --> 00:15:24,760
.إخفاء الحقيقة لن يساعد البشريّة

218
00:15:24,760 --> 00:15:26,470
هل ميكاسا أكرمان حاضرة؟

219
00:15:26,470 --> 00:15:28,260
.نعم، هذه أنا

220
00:15:28,840 --> 00:15:30,300
أنت أكرمان؟

221
00:15:30,300 --> 00:15:34,020
هل صحيح أنّ ييغر، بصفة عملاق، هاجمك؟

222
00:15:36,020 --> 00:15:39,730
.لن يساعد الكذب إرين بتاتًا

223
00:15:45,280 --> 00:15:47,320
.نعم، هذا صحيح

224
00:15:49,360 --> 00:15:52,030
.عرفتها... إنّه كباقي العمالقة

225
00:15:52,370 --> 00:15:54,620
حاولتُ قتل ميكاسا؟

226
00:15:55,410 --> 00:15:56,620
أنا؟

227
00:15:57,710 --> 00:16:00,920
،لكن في مناسبتين سابقتين

228
00:16:01,420 --> 00:16:04,090
.أنقذ إرين حياتي بهيئة العملاق خاصّته

229
00:16:04,800 --> 00:16:05,670
،في المرّة الأولى

230
00:16:06,340 --> 00:16:09,680
،قبل ثوانٍ من وقوعي في قبضة عملاق

231
00:16:09,680 --> 00:16:12,970
.حال بيننا حاميًا إيّاي

232
00:16:14,640 --> 00:16:19,600
.وفي المرّة الثّانية، حماني وأرمين من قذيفة شديدة الانفجار

233
00:16:20,730 --> 00:16:23,820
.أودّ إلقاء هذه الحقائق بعين الاعتبار أيضًا

234
00:16:24,230 --> 00:16:25,610
.أعارض

235
00:16:26,320 --> 00:16:30,610
أعتقد أنّ هذه التّعليقات تغلبها
.مشاعرها الشّخصيّة إلى حدّ كبير

236
00:16:31,240 --> 00:16:34,620
،في سنّ صغير، فقدت ميكاسا أكرمان أبويها

237
00:16:34,620 --> 00:16:37,950
.ووجدت الملجأ في أسرة ييغر

238
00:16:40,210 --> 00:16:46,300
كما أنّ تحقيقاتنا كشفت حقيقة
.مفاجئة بشأن الأحداث الضّمنيّة

239
00:16:48,050 --> 00:16:52,220
في سنّ التّاسعة، قام كلّ من إرين ييغر وميكاسا أكرمان

240
00:16:52,220 --> 00:16:55,720
.بقتل ثلاثة لصوص حاولوا اختطافها

241
00:16:57,220 --> 00:16:59,480
،حتّى إن كان دفاعًا عن النّفس

242
00:16:59,480 --> 00:17:03,060
.لا بدّ أن أشكّ في جوهرهما البشريّ

243
00:17:03,560 --> 00:17:09,610
هل من الصّائب أن نأتمن له
بمصير البشريّة ومواردها وأرواحها؟

244
00:17:10,110 --> 00:17:11,320
!هذا صحيح

245
00:17:11,320 --> 00:17:14,910
!ما هو إلّا عملاق تسلّل بيننا مدّعيًا أنّه طفل

246
00:17:14,910 --> 00:17:16,160
!وهي أيضًا

247
00:17:17,080 --> 00:17:19,160
هل نحن متأكّدون أنّها بشريّة؟

248
00:17:19,160 --> 00:17:21,790
!هذا صحيح! علينا تشريحها من باب الاحتياط

249
00:17:22,040 --> 00:17:23,330
!انتظروا

250
00:17:23,330 --> 00:17:27,050
!قد أكون وحشًا، لكن لا علاقة لها بذلك

251
00:17:27,050 --> 00:17:28,380
!لا علاقة إطلاقًا

252
00:17:28,380 --> 00:17:29,760
!لا يمكننا الوثوق بذلك

253
00:17:29,760 --> 00:17:30,550
!هذا صحيح

254
00:17:30,550 --> 00:17:32,220
!إن كنت تتستّر عليها، فيعني ذلك أنّها منكم

255
00:17:32,220 --> 00:17:32,880
!لا

256
00:17:36,930 --> 00:17:38,260
...أقصد

257
00:17:38,260 --> 00:17:39,520
.أنتم مخطئون

258
00:17:40,390 --> 00:17:47,020
لكنّكم ببساطة تأتون بفرضيّات
.تناسب ما يحلو لكم تفكيره فحسب

259
00:17:48,480 --> 00:17:49,900
ماذا قلت؟

260
00:17:49,900 --> 00:17:51,570
...غير ذلك، جميعكم

261
00:17:51,570 --> 00:17:52,450
أهذا حكيم؟

262
00:17:52,450 --> 00:17:54,570
!حتّى أنّكم لم تروا أيّ عملاق من قبل

263
00:17:54,570 --> 00:17:56,410
فما الّذي يخيفكم هكذا؟

264
00:17:56,870 --> 00:17:58,990
أينبغي أن أظلّ صامتًا فحسب؟

265
00:17:59,490 --> 00:18:03,710
.كلّا، سأخبرهم بكلّ ما يجول في خاطري

266
00:18:04,830 --> 00:18:08,420
ما المغزى إن كان من يملك الوسيلة والقوّة لا يقاتل؟

267
00:18:09,210 --> 00:18:12,090
،إن كنتم خائفين من القتال لأجل النّجاة

268
00:18:12,090 --> 00:18:13,720
!فساعدوني إذًا

269
00:18:14,260 --> 00:18:16,640
!أيّها... الجبناء

270
00:18:16,800 --> 00:18:17,760
ماذا؟

271
00:18:17,760 --> 00:18:19,260
!اخرسوا فحسب

272
00:18:19,260 --> 00:18:21,770
!وراهنوا بكلّ ما لديكم عليّ

273
00:18:27,480 --> 00:18:28,520
!جهّز سلاحك

274
00:18:28,520 --> 00:18:29,320
!حاضر

275
00:18:45,000 --> 00:18:46,500
!انتظري يا ميكاسا

276
00:18:53,840 --> 00:18:55,470
.هذا رأي شخصيّ

277
00:18:56,340 --> 00:18:58,970
لكن أعتقد أنّ الألم هو أفضل
.وسيلة لتدريب أحدهم

278
00:18:59,720 --> 00:19:05,180
.ما أنت بحاجته هو أن تُدرّب ككلب، لا رجل

279
00:19:05,520 --> 00:19:08,190
.يسهل ركلك وأنت راكع أيضًا

280
00:19:18,570 --> 00:19:20,700
...انتظر يا ليفاي

281
00:19:21,120 --> 00:19:22,290
ماذا؟

282
00:19:24,080 --> 00:19:25,330
...هذا خطير

283
00:19:25,580 --> 00:19:28,330
ماذا إن غضب وتحوّل إلى عملاق؟

284
00:19:31,290 --> 00:19:32,550
ماذا تقول؟

285
00:19:33,670 --> 00:19:36,670
ألن تشرّحوه؟

286
00:19:39,260 --> 00:19:41,260
،عندما تحوّل إلى عملاق آخر مرّة

287
00:19:41,260 --> 00:19:44,930
.قتل عشرين عملاقًا آخر قبل انهياره

288
00:19:45,730 --> 00:19:49,230
.إن كان عدوًّا، فإنّ ذكاءه يجعله خصمًا أكثر شراسة

289
00:19:50,020 --> 00:19:52,230
.لكنّه ليس ندًّا لي مع ذلك

290
00:19:53,190 --> 00:19:54,980
لكن ماذا ستفعلون؟

291
00:19:55,860 --> 00:19:58,610
على كلّ من يضطّهده أن يأخذ
.تلك الحقيقة بعين الاعتبار أيضًا

292
00:19:59,110 --> 00:20:01,870
هل تظنّون أنّكم تستطيعون قتله حقًّا؟

293
00:20:02,780 --> 00:20:05,040
.سيّدي، لديّ اقتراح

294
00:20:05,370 --> 00:20:06,660
ما هو؟

295
00:20:07,750 --> 00:20:11,790
.تظلّ تفاصيل قوّة عملاق إرين غير مؤكّدة

296
00:20:12,250 --> 00:20:14,050
.ما يجعله خطيرًا

297
00:20:15,050 --> 00:20:18,930
لذا أقترح أن يتولّى القائد ليفاي
،مسؤوليّة السّيطرة على إرين

298
00:20:18,930 --> 00:20:20,800
.وينطلق في رحلة استكشافيّة خارج الأسوار

299
00:20:20,800 --> 00:20:22,720
رفقة إرين؟

300
00:20:23,100 --> 00:20:24,060
.نعم

301
00:20:24,060 --> 00:20:26,520
،بناءً على نتائج البعثة

302
00:20:27,680 --> 00:20:30,480
أودّ منك أن تحكم ما إن كان
إرين يستطيع التّحكّم بقوّة عملاقه

303
00:20:31,350 --> 00:20:33,940
.وما إن كان نعمة أم نقمة على البشريّة

304
00:20:34,230 --> 00:20:36,780
...السّيطرة على إرين

305
00:20:37,490 --> 00:20:39,700
أيمكنك فعل ذلك يا ليفاي؟

306
00:20:40,450 --> 00:20:42,990
.أنا متأكّد من أنّني أستطيع قتله

307
00:20:43,450 --> 00:20:47,120
المشكل الوحيد هو أنّني أشكّ
.في أنّني أستطيع فعل أقلّ من ذلك

308
00:20:52,880 --> 00:20:54,710
.حسمتُ قراري إذًا

309
00:20:59,340 --> 00:21:02,220
.كان ذلك فظيعًا حقًّا

310
00:21:02,640 --> 00:21:03,760
هذا يؤلم، صحيح؟

311
00:21:03,760 --> 00:21:04,720
.قليلاً

312
00:21:05,180 --> 00:21:07,100
كيف يؤلمك إذًا؟

313
00:21:08,470 --> 00:21:09,520
.آسف

314
00:21:10,480 --> 00:21:13,900
.لكن بفضل ذلك، تمكّنّا من تسليمك لنا

315
00:21:13,900 --> 00:21:14,860
.نعم

316
00:21:15,520 --> 00:21:21,030
سمح لي الألم الّذي تحمّلتَه أن ألعب
.أوراقي في اللّحظة المناسبة

317
00:21:22,860 --> 00:21:24,030
.أحترمك على ذلك

318
00:21:26,080 --> 00:21:28,200
.إرين، أتطلّع للعمل معك

319
00:21:28,950 --> 00:21:31,210
!نعم! شكرًا لك

320
00:21:34,000 --> 00:21:35,130
...أخبرني يا إرين

321
00:21:35,500 --> 00:21:36,500
نعم؟

322
00:21:37,000 --> 00:21:38,630
هل تكرهني؟

323
00:21:38,630 --> 00:21:40,210
...لـ-لا

324
00:21:40,210 --> 00:21:42,970
.أفهم لِمَ كان ذلك ضروريًّا

325
00:21:42,970 --> 00:21:44,220
.هذا جيّد

326
00:21:44,220 --> 00:21:46,510
.لكنّك تماديت بعض الشّيء

327
00:21:46,970 --> 00:21:48,640
.فقدتَ ضرسًا

328
00:21:49,220 --> 00:21:49,930
أترى؟

329
00:21:49,930 --> 00:21:52,100
.لا تلتقطيه... هذا مقرف

330
00:21:52,100 --> 00:21:54,440
.حتّى هذا يعدّ عيّنة مهمّة

331
00:21:54,440 --> 00:21:58,020
إرين، لا يزال هذا أفضل من أن تُشرّح
على يد أشخاص مثل هانجي، صحيح؟

332
00:21:58,480 --> 00:22:00,940
...لستُ مثلهم

333
00:22:00,940 --> 00:22:03,780
.ما كنت لأقتله

334
00:22:04,110 --> 00:22:05,320
...يا إرين

335
00:22:05,320 --> 00:22:07,330
.دعني أرى داخل فمك

336
00:22:15,670 --> 00:22:16,670
...الضّرس

337
00:22:17,500 --> 00:22:19,250
.قد نمى مجدّدًا بالفعل

338
00:22:19,250 --> 00:22:22,170
...يُتبع

339
00:23:53,470 --> 00:23:57,520
عُيّن إرين أخيرًا في فيلق الاستطلاع
.الّذي يحلم الانضمام له

340
00:23:58,190 --> 00:24:00,690
لكنّه يكتشف أنّ الفيلق عبارة عن مجموعة من النّاس

341
00:24:00,690 --> 00:24:03,110
...الّذين يتوقون للثّورة

342
00:24:03,570 --> 00:24:06,280
.أو قد يكون وكرًا للمجانين