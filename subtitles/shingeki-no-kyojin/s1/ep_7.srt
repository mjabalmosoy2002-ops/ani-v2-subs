1
00:00:03,500 --> 00:00:05,880
،قبل مائة عام مضت

2
00:00:06,510 --> 00:00:09,090
.وجدت البشريّة نفسها تواجه مفترسًا جديدًا

3
00:00:14,560 --> 00:00:19,520
.كانوا أقوى بكثير من البشر

4
00:00:20,060 --> 00:00:23,980
.ودُفعت البشريّة في الحال إلى حافّة الانقراض

5
00:00:28,440 --> 00:00:32,450
:بنى النّاجون ثلاثة أسوار

6
00:00:32,450 --> 00:00:34,950
.ماريا وروز وسينا

7
00:00:34,950 --> 00:00:37,830
.وداخلها، نعموا بقرن من السّلام

8
00:00:38,580 --> 00:00:39,460
...ولكن

9
00:00:40,670 --> 00:00:42,420
...في سنة 845

10
00:00:43,040 --> 00:00:46,670
ظهر العملاقان الضّخم والمدرّع

11
00:00:46,670 --> 00:00:50,880
،فجأة ودمّرا السّور

12
00:00:50,880 --> 00:00:52,840
.إضافة إلى الحياة الّتي عهدناها

13
00:00:55,600 --> 00:00:57,970
،هجرت البشريّة سور ماريا

14
00:00:58,720 --> 00:01:01,980
،وخسرت عشرين في المائة من سكّانها وثُلث منطقتها

15
00:01:02,560 --> 00:01:06,690
.بغرض الانسحاب إلى سور روز

16
00:01:10,190 --> 00:01:11,820
...في السّنة 850

17
00:01:12,820 --> 00:01:17,450
،ظهر العملاق الضّخم واخترق السّور

18
00:01:17,990 --> 00:01:20,450
.سامحًا للعمالقة بالغزو مرّة أخرى

19
00:01:22,420 --> 00:01:24,500
!إرين! أسرع

20
00:01:32,010 --> 00:01:36,140
.بعد ساعتين، تمّ إخلاء السّكّان بنجاح

21
00:01:37,470 --> 00:01:40,100
.لم تُزهق حياة أيّ أحد بسبب العمالقة

22
00:01:41,560 --> 00:01:43,060
لا أحد فيما عدى الجنود

23
00:01:43,940 --> 00:01:46,810
.الّذين سارعوا لاعتراض طريقها

24
00:01:47,400 --> 00:01:48,320
...إرين

25
00:01:49,030 --> 00:01:50,740
،ما دمت معي

26
00:01:50,740 --> 00:01:52,570
.فبإمكاني فعل المستحيل

27
00:03:35,300 --> 00:03:36,920
!مهلاً أيّها النّقيب

28
00:03:37,430 --> 00:03:39,300
،إن هاجمت العمالقة

29
00:03:39,300 --> 00:03:42,510
.لن نستطيع نحن قوّات الإمداد حماية هذا المكان وحدنا

30
00:03:43,180 --> 00:03:45,600
!أرجوكم! ابقوا معنا

31
00:03:45,600 --> 00:03:47,310
.ابتعدوا عن الطّريق

32
00:03:47,310 --> 00:03:51,440
.عليّ تنظيم فرق التّعزيزات

33
00:03:52,820 --> 00:03:55,440
خلف البوّابة الدّاخليّة، حيث المكان الوضع آمن؟

34
00:03:56,400 --> 00:03:58,740
ما الّذي تحاول قوله؟

35
00:03:58,740 --> 00:04:00,820
!هذا هو الإجراء المتّبع

36
00:04:00,820 --> 00:04:04,490
!إنّه واجبنا كجنود أن نتّبع الإجراءات

37
00:04:04,490 --> 00:04:06,700
—لـ-لكن إن سقط هذا المكان

38
00:04:06,700 --> 00:04:08,210
!سكوت

39
00:04:09,920 --> 00:04:12,790
تفوّهوا بكلمة أخرى وسأكون مجبرًا

40
00:04:12,790 --> 00:04:15,050
!على معاملتكم كخونة ومعاقبتكم ها هنا

41
00:04:28,770 --> 00:04:31,650
.سمعت صوت الجرس معلنًا عن انسحاب مؤقّت

42
00:04:32,100 --> 00:04:34,360
لماذا لا يحاول أيّ أحد تسلّق الأسوار؟

43
00:04:49,660 --> 00:04:51,540
...انتهى الأمر

44
00:04:52,630 --> 00:04:53,880
.هذه النّهاية

45
00:05:04,140 --> 00:05:05,180
.فهمت

46
00:05:05,760 --> 00:05:08,640
فيما سينفعك ذلك؟

47
00:05:18,190 --> 00:05:20,440
يا جان! ماذا علينا فعله؟

48
00:05:20,610 --> 00:05:22,610
...لا يسعنا فعل أيّ شيء

49
00:05:23,320 --> 00:05:25,660
،أصدروا أمرًا بالانسحاب أخيرًا

50
00:05:25,660 --> 00:05:27,950
.لكن بدون أيّ غاز، لا يمكننا تسلّق الأسوار

51
00:05:28,620 --> 00:05:31,000
...لذلك سنموت جميعًا

52
00:05:31,370 --> 00:05:33,710
.بسبب أولئك الجبناء

53
00:05:34,130 --> 00:05:35,750
...فريق الإمداد

54
00:05:36,340 --> 00:05:38,000
!ما الّذي حلّ بهم؟

55
00:05:38,000 --> 00:05:39,260
هل قُضي عليهم؟

56
00:05:39,550 --> 00:05:41,840
.إنّهم عاجزون الحركة بسبب الخوف

57
00:05:42,300 --> 00:05:43,880
...أتفهّم السّبب

58
00:05:44,590 --> 00:05:48,930
لكنّ التّخلّف عن أداء مهمّتهم بإعادة إمدادنا
.والاختباء في المقرّ الرّئيسيّ. هذا لا يصدّق

59
00:05:49,600 --> 00:05:53,940
ومؤكّد أنّ العمالقة قد حاصرتهم ولا يمكننا
...الذّهاب للحصول على مزيد من الغاز

60
00:05:54,270 --> 00:05:56,230
،علينا إذًا أن نخاطر

61
00:05:56,230 --> 00:05:58,440
!ونحاول تدمير العمالقة حول المقرّ

62
00:05:58,900 --> 00:06:01,360
...لن يكون حالنا أسوأ من الجلوس هنا فحسب

63
00:06:01,360 --> 00:06:03,450
!ستجتمع العمالقة حولنا قريبًا

64
00:06:04,160 --> 00:06:08,160
.وإن واصلنا الهرب، فسنضيّع ما لدينا من غاز

65
00:06:08,160 --> 00:06:11,250
!إنّ أمرنا منتهٍ تمامًا بدون عدّة المناورة

66
00:06:12,200 --> 00:06:15,000
.أنا متفاجئ لرؤيتك تستعمل دماغك ولو لمرّة يا كوني

67
00:06:16,130 --> 00:06:19,550
لكن هل تعتقد أنّ بإمكاننا ذلك
نظرًا لأعدادنا الحاليّة؟

68
00:06:20,170 --> 00:06:22,920
.قُتل معظم زملائنا القدامى في الطّليعة

69
00:06:23,630 --> 00:06:27,930
فمن منّا نحن المتدرّبين قد يقود مهمّة انتحاريّة كهذه؟

70
00:06:28,930 --> 00:06:33,430
،وحتّى إن قام أحد ما بذلك
.فلا يمكننا قتال العمالقة

71
00:06:34,190 --> 00:06:39,320
أراهن أنّ غرفة إمدادات الغاز تعجّ
.بالعمالقة من صنف 3 أو 4 أمتار

72
00:06:40,110 --> 00:06:42,900
.ولا يمكننا طبعًا التّزوّد بالغاز حولها

73
00:06:45,450 --> 00:06:46,450
انتهى أمرنا إذًا؟

74
00:06:47,990 --> 00:06:50,280
...يا لها من حياة غبيّة

75
00:06:50,830 --> 00:06:53,250
.لو عرفت أنّ هذا سيحدث، لأخبرتهم بذلك

76
00:06:54,410 --> 00:06:56,460
!لنقم بذلك يا رفاق

77
00:06:56,670 --> 00:06:57,960
...هيّا، تماسكوا

78
00:06:57,960 --> 00:07:01,550
!إن عملنا جميعًا معًا، فسنكون بخير

79
00:07:01,550 --> 00:07:03,550
.سأقوم بتقدّمكم

80
00:07:14,430 --> 00:07:16,390
...أرمين، دعنا

81
00:07:23,610 --> 00:07:24,490
،راينر

82
00:07:24,860 --> 00:07:25,860
ماذا علينا فعله؟

83
00:07:25,860 --> 00:07:26,900
.لا شيء بعد

84
00:07:26,900 --> 00:07:28,700
.إن قمنا بالأمر، فسنقوم به جميعًا

85
00:07:29,320 --> 00:07:30,450
...لا فائدة

86
00:07:31,740 --> 00:07:36,290
مستحيل لأيّ أحد منّا أن يستطيع
!الخروج من هذه البلدة حيًّا

87
00:07:37,460 --> 00:07:40,000
...عرفتُ أنّني قد أموت

88
00:07:40,710 --> 00:07:43,960
ولكن لأيّ سبب سأموت؟

89
00:07:45,130 --> 00:07:46,010
ميكاسا؟

90
00:07:46,130 --> 00:07:47,880
.ظننت أنّك كنت في السّاقة

91
00:07:48,340 --> 00:07:49,260
!آني

92
00:07:50,340 --> 00:07:52,470
.لديّ فكرة عامّة عمّا حدث هنا

93
00:07:52,470 --> 00:07:55,390
،وأنا آسفة للسّماح لمشاعري الخاصّة بالتّدخّل

94
00:07:55,730 --> 00:07:57,390
لكن هل رأيتم فريق إرين؟

95
00:07:57,940 --> 00:07:59,650
،لم أرهم

96
00:07:59,650 --> 00:08:01,230
.لكن لم يتسلّق أحد الأسوار

97
00:08:01,230 --> 00:08:03,480
.في الحقيقة، أرمين موجود هناك

98
00:08:05,650 --> 00:08:06,490
!أرمين

99
00:08:08,030 --> 00:08:09,110
!ميكاسا

100
00:08:09,660 --> 00:08:10,570
!كلاّ

101
00:08:11,030 --> 00:08:13,620
كيف يفترض بي أن أواجهها؟

102
00:08:14,080 --> 00:08:16,540
.كانت نجاتي بلا فائدة

103
00:08:17,200 --> 00:08:22,130
!أتمنّى لو أنّني متّ هناك معه

104
00:08:24,340 --> 00:08:26,420
أرمين، هل تأذّيت؟

105
00:08:27,050 --> 00:08:28,050
هل أنت بخير؟

106
00:08:34,970 --> 00:08:36,220
أين هو إرين؟

107
00:08:38,850 --> 00:08:39,770
أرمين؟

108
00:08:51,530 --> 00:08:57,240
...أعضاء فريق فيلق المتدرّبين 34

109
00:08:57,910 --> 00:09:00,830
...توماس واغنر وناك تياس

110
00:09:01,790 --> 00:09:05,840
...ومليوس زرموسكي ومينا كارولينا

111
00:09:06,750 --> 00:09:08,420
!وإرين ييغر

112
00:09:09,590 --> 00:09:16,350
!مات هؤلاء الخمسة ببسالة أثناء تأدية الواجب

113
00:09:19,480 --> 00:09:20,730
...مستحيل

114
00:09:22,520 --> 00:09:25,310
إذًا فالفريق 34 كاد يُباد بالكامل؟

115
00:09:25,900 --> 00:09:29,240
.إن حاولنا مواجهة العمالقة، فسنلقى نفس الخاتمة

116
00:09:30,440 --> 00:09:32,070
...أنا آسف يا ميكاسا

117
00:09:32,950 --> 00:09:35,830
.إنّ إرين... ضحّى بنفسه من أجلي

118
00:09:36,580 --> 00:09:37,450
...أنا

119
00:09:37,700 --> 00:09:39,700
!كنتُ بلا حول ولا قوّة

120
00:09:41,040 --> 00:09:42,330
...أنا آسف

121
00:09:46,630 --> 00:09:47,710
.أرمين

122
00:09:51,220 --> 00:09:52,430
.اهدأ

123
00:09:53,010 --> 00:09:55,550
.هذا ليس وقتًا مناسبًا للاستسلام لمشاعرنا

124
00:09:57,850 --> 00:09:59,060
.هيّا، قف

125
00:10:00,810 --> 00:10:04,350
،ماركو، إن قضينا على العمالقة المحيطين بالمقرّ

126
00:10:04,810 --> 00:10:08,150
.فبإمكاننا التّزوّد بالغاز وتسلّق الأسوار

127
00:10:08,480 --> 00:10:09,360
أليس كذلك؟

128
00:10:09,860 --> 00:10:11,610
...صحيح، لكن

129
00:10:12,150 --> 00:10:15,160
...لكن حتّى بوجودك معنا، فثمّة العديد

130
00:10:15,160 --> 00:10:16,070
.يمكنني النّجاح

131
00:10:17,990 --> 00:10:20,240
!أنا قويّة

132
00:10:20,660 --> 00:10:22,910
.أقوى منكم

133
00:10:23,410 --> 00:10:24,620
.قويّة جدًّا

134
00:10:25,370 --> 00:10:29,550
!وبالتّالي، بإمكاني هزيمة تلك العمالقة

135
00:10:30,380 --> 00:10:31,840
.وإن كنتُ وحدي

136
00:10:33,800 --> 00:10:36,140
،إنّكم لستم ضعفاء فحسب

137
00:10:36,590 --> 00:10:38,720
.بل جبناء ضعفاء أيضًا

138
00:10:40,220 --> 00:10:41,680
.خاب ظنّي بكم

139
00:10:42,140 --> 00:10:44,690
...الزموا مكانكم هنا

140
00:10:44,980 --> 00:10:46,350
.ابقوا هنا وشاهدوا

141
00:10:46,560 --> 00:10:49,820
!مهلاً يا ميكاسا! ما الّذي تقولينه؟

142
00:10:49,820 --> 00:10:53,030
!ستقاتلين كلّ تلك العمالقة وحدك؟

143
00:10:53,030 --> 00:10:54,780
!مستحيل أن تستطيعي ذلك

144
00:10:54,780 --> 00:10:56,660
.إن لم أستطع، فسأموت

145
00:10:57,570 --> 00:10:59,830
.لكن إن فزت، فسأعيش

146
00:10:59,830 --> 00:11:01,740
.إن لم أقاتل، فلا يمكنني الفوز

147
00:11:03,660 --> 00:11:04,620
!مهلاً

148
00:11:09,500 --> 00:11:12,420
...الشّيء المخيّب هنا هي مصطلحاتك

149
00:11:12,670 --> 00:11:15,510
هل كان يفترض بذلك أن يكون خطابًا ملهمًا؟

150
00:11:16,010 --> 00:11:18,390
!هذه غلطتك يا إرين

151
00:11:19,220 --> 00:11:20,010
!اسمعوا

152
00:11:20,010 --> 00:11:23,560
!هل تدرّبنا للسّماح لزملائنا الجنود بالقتال وحدهم؟

153
00:11:23,560 --> 00:11:26,310
!أتريدون فعلاً أن تصبحوا جبناء؟

154
00:11:27,310 --> 00:11:29,150
.ما كنت لأرغب بذلك

155
00:11:35,860 --> 00:11:37,740
...هيّا أيّها الجبناء

156
00:11:37,740 --> 00:11:38,780
...الضّعفاء

157
00:11:38,780 --> 00:11:39,950
!الأغبياء

158
00:11:40,620 --> 00:11:41,700
...هؤلاء

159
00:11:42,120 --> 00:11:45,620
!سُحقًا... سأذهب

160
00:11:54,090 --> 00:11:54,960
!بسرعة

161
00:11:55,260 --> 00:11:56,720
!اتبعوا ميكاسا

162
00:11:57,050 --> 00:11:58,760
.سنقوم بهذا بسرعة

163
00:11:58,760 --> 00:12:01,550
!علينا الإسراع للمقرّ قبل نفاد الغاز منّا

164
00:12:02,560 --> 00:12:04,470
...ولكنّ ميكاسا مذهلة

165
00:12:04,970 --> 00:12:07,180
كيف تتحرّك بهذه السّرعة؟

166
00:12:07,770 --> 00:12:10,230
!كلاّ، إنّها تستعمل الكثير من الغاز

167
00:12:10,940 --> 00:12:12,440
!سينفد منها قريبًا

168
00:12:13,230 --> 00:12:14,570
،لا يهمّ ما مدى براعتها

169
00:12:14,570 --> 00:12:16,900
!ستكون عاجزة بلا عدّة المناورة

170
00:12:24,830 --> 00:12:26,870
.عرفتُ أنّها لم تكن على طبيعتها المعتادة الهادئة

171
00:12:27,580 --> 00:12:30,000
!إنّها تحاول تجاهل صدمتها بالمبادرة للقتال

172
00:12:30,370 --> 00:12:32,380
...على هذا المعدّل، فسوف

173
00:12:37,720 --> 00:12:38,670
!ميكاسا

174
00:12:39,430 --> 00:12:40,550
!سُحقًا

175
00:12:40,550 --> 00:12:43,180
.جان، خذ أنت مكانها

176
00:12:43,390 --> 00:12:44,810
!سأذهب خلف أرمين

177
00:12:45,100 --> 00:12:45,770
.وأنا أيضًا

178
00:12:45,770 --> 00:12:46,720
ما الّذي تفعله؟

179
00:12:46,720 --> 00:12:48,430
!ما زالت العمالقة حولنا

180
00:12:48,600 --> 00:12:50,600
!نحتاج لمهاراتك

181
00:13:04,240 --> 00:13:05,370
...ثانية

182
00:13:06,160 --> 00:13:07,450
.هذا ثانية

183
00:13:09,660 --> 00:13:11,670
...فقدت عائلتي ثانية

184
00:13:17,800 --> 00:13:21,470
،هل عليّ تذكّر الألم ثانية

185
00:13:22,430 --> 00:13:26,060
والبدء من جديد من هنا ثانية؟

186
00:13:47,030 --> 00:13:48,120
...لا فائدة

187
00:13:48,120 --> 00:13:50,250
.لا نستطيع حتّى الاقتراب من المقرّ

188
00:13:51,330 --> 00:13:53,580
.إلاّ إذا كنّا عازمين على المخاطرة بسقوط ضحايا

189
00:13:59,340 --> 00:14:01,590
!سُحقًا! نفد منه الغاز

190
00:14:03,680 --> 00:14:04,590
!تراجع

191
00:14:05,510 --> 00:14:07,050
!توم، أنا قادم من أجلك

192
00:14:07,050 --> 00:14:07,720
...إيّاك

193
00:14:07,720 --> 00:14:08,970
!فات الأوان

194
00:14:10,980 --> 00:14:12,520
—توقّف

195
00:14:22,860 --> 00:14:24,450
لماذا لم أستطع إيقافهم؟

196
00:14:29,040 --> 00:14:30,750
لماذا لم أوقفهم؟

197
00:14:31,330 --> 00:14:33,040
،إن كنت قد أجبرتهم على التّوقّف

198
00:14:33,830 --> 00:14:34,960
...ما كان لهذا أن يحدث

199
00:14:40,590 --> 00:14:42,340
