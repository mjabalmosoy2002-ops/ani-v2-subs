1
00:01:40,850 --> 00:01:43,020
متى غيّرت أعمدة الدّوران آخر مرّة؟

2
00:01:43,020 --> 00:01:44,350
.قبل ستّة أيّام

3
00:01:44,350 --> 00:01:45,860
.قبل عمليّة التّنظيف

4
00:01:47,070 --> 00:01:48,520
.هذا يوافق السّجلاّت

5
00:01:48,520 --> 00:01:49,570
.حسنًا، التّالي

6
00:01:49,570 --> 00:01:50,360
...أنت

7
00:01:50,860 --> 00:01:53,700
.كريستا لنز، الفرقة 42

8
00:01:54,360 --> 00:01:55,700
.سنتفقّد عتادك

9
00:01:56,200 --> 00:01:59,370
...أظنّ أنّه يمكن أن تعاقب حتّى على قتل العمالقة

10
00:02:00,080 --> 00:02:03,000
.هذا غريب، لكنّهما كانا عيّنتا تجارب مهمّتين

11
00:02:03,000 --> 00:02:07,210
أكيد، لكن لِمَ يبحثون عن الجاني
بيننا نحن المتدرّبون؟

12
00:02:07,210 --> 00:02:10,170
نعم. فقد انتهينا لتّونا من تنظيف
.ساحة المعركة اليوم

13
00:02:10,170 --> 00:02:11,630
.الجميع مرهقون

14
00:02:13,800 --> 00:02:16,640
.لا بدّ أنّ الفاعل يكره العمالقة حقًّا

15
00:02:17,510 --> 00:02:20,970
...لكن في الواقع، انتهى به المطاف يساعد العمالقة

16
00:02:21,770 --> 00:02:24,980
،ربّما حقّق رغبته في الانتقام

17
00:02:24,980 --> 00:02:27,150
.لكنّها ضربة موجعة للبشريّة

18
00:02:27,810 --> 00:02:30,820
...أظنّني أفهم سبب فعله لذلك لأنّني غبيّ بدوري

19
00:02:31,440 --> 00:02:33,320
،قبل رؤيتي للعمالقة

20
00:02:33,320 --> 00:02:36,280
.خطّطتُ حقًّا الانضمام لفيلق الاستطلاع

21
00:02:37,490 --> 00:02:39,330
.لكنّي لا أريد أن أرى واحدًا آخر

22
00:02:40,120 --> 00:02:43,000
.واليوم، علينا أن نقرّر إلى أيّ قوّة ننضمّ

23
00:02:50,920 --> 00:02:53,550
...حتّى جان جادّ

24
00:03:07,480 --> 00:03:09,900
.الجميع نادمون

25
00:03:11,270 --> 00:03:13,610
،لو أنّني عرفتُ أنّ الأمر سيكون قاسيًا هكذا

26
00:03:13,610 --> 00:03:15,240
.لما اخترتُ أن أكون جنديًّا أبدًا

27
00:03:16,610 --> 00:03:18,610
،بما أنّني مرهق

28
00:03:19,200 --> 00:03:21,120
...فهذا كلّ ما يمكنني التّفكير فيه

29
00:03:31,380 --> 00:03:32,550
...يا ماركو

30
00:03:33,590 --> 00:03:36,800
.ما عدتُ قادرًا حتّى على تمييز عظامك بعد الآن

31
00:03:42,720 --> 00:03:44,600
،لو لم أصبح جنديًّا

32
00:03:45,430 --> 00:03:48,440
لما احتجتُ للتّفكير فيمن سيُحشر
.في تلك الكومة تاليًا

33
00:03:50,980 --> 00:03:54,360
هل سنتخلّى عن المكتسبات الّتي راح
،ضحيّتها عشرات الآلاف منّا لتطويرها

34
00:03:54,360 --> 00:03:56,740
ونسمح للعمالقة بأكلنا دون قتال؟

35
00:03:57,400 --> 00:04:01,030
...أعلم أنّ علينا أن نقاتل

36
00:04:01,780 --> 00:04:06,330
.لكن ليس الجميع متلهّفون للموت مثلك

37
00:04:12,460 --> 00:04:14,750
...آمل ألاّ تغضب منّي بسبب ما سأقول

38
00:04:15,590 --> 00:04:17,760
.لكنّك لست شخصًا قويًّا

39
00:04:18,130 --> 00:04:20,840
.لذلك بإمكانك فهم شعور الضّعفاء

40
00:04:21,140 --> 00:04:25,470
.إضافة لذلك، أنت بارع في تقدير أيّ وضع

41
00:04:25,810 --> 00:04:28,850
أليس ذلك ما دفعك لمعرفة
ما يجب فعله في الحال؟

42
00:04:36,360 --> 00:04:39,280
...ما يجب فعله

43
00:04:41,240 --> 00:04:42,820
...يا رفاق

44
00:04:46,450 --> 00:04:50,160
هل قرّرتم إلى أيّ طرف ستنضمّون؟

45
00:04:51,830 --> 00:04:53,210
.فقد قرّرت

46
00:04:54,380 --> 00:04:57,710
...أنا

47
00:04:59,470 --> 00:05:01,130
!سأنضمّ لفيلق الاستطلاع

48
00:05:12,060 --> 00:05:12,900
.سحقًا

49
00:05:13,600 --> 00:05:16,150
أخبريني يا آني، ما رأيك؟

50
00:05:16,480 --> 00:05:19,110
.فحتّى جان قال أنّه سينضمّ لفيلق الاستطلاع

51
00:05:19,110 --> 00:05:21,030
ماذا؟ جان قال ذلك؟

52
00:05:21,030 --> 00:05:21,900
.لا شيء بالضّبط

53
00:05:22,530 --> 00:05:24,450
ستنضمّين للشّرطة العسكريّة، صحيح؟

54
00:05:24,820 --> 00:05:26,990
.ربّما يجب أن أفعل ذلك أيضًا

55
00:05:28,830 --> 00:05:32,370
إن طلب منك أحد أن تموت، فهل ستذهب لحتفك؟

56
00:05:32,920 --> 00:05:35,420
.ماذا؟ بالطّبع لا

57
00:05:35,670 --> 00:05:38,800
لِمَ لا تقرّر من نفسك إذًا؟

58
00:05:40,510 --> 00:05:43,010
ماذا عنك يا أرمين؟

59
00:05:44,050 --> 00:05:44,930
...أنا

60
00:05:45,470 --> 00:05:48,010
،أظنّ أنّه إن كان المرء يعرف السّبب من موته

61
00:05:48,010 --> 00:05:50,680
.فهناك أوقات تُحتّم عليه ذلك ببساطة

62
00:05:51,230 --> 00:05:52,440
.ليس وكأنّني أريد ذلك

63
00:05:52,850 --> 00:05:54,770
.فهمت... اتّخذت قرارك

64
00:05:56,440 --> 00:05:59,150
.فكّرتُ في فعل هذا مليًّا

65
00:05:59,150 --> 00:06:01,610
حقًّا؟ أنت أيضًا يا أرمين؟

66
00:06:03,530 --> 00:06:06,450
.أنت ضعيف، لكنّك جريء

67
00:06:06,910 --> 00:06:08,950
.شـ-شكرًا

68
00:06:09,620 --> 00:06:13,210
آني، أنت لطيفة جدًّا في الواقع، أليس كذلك؟

69
00:06:14,370 --> 00:06:18,710
.يبدو أنّك لا تريدين منّا أن ننضمّ لفيلق الاستطلاع

70
00:06:19,090 --> 00:06:23,220
أليس هناك سبب لرغبتك
في الانضمام إلى الشّرطة العسكريّة؟

71
00:06:23,800 --> 00:06:24,930
.ليس تمامًا

72
00:06:26,550 --> 00:06:28,010
...أنا فقط

73
00:06:29,100 --> 00:06:31,310
.أريد أن أنجو

74
00:06:38,650 --> 00:06:41,940
يبدو أنّهم لم يجدوا أيّ جنود استخدموا

75
00:06:41,940 --> 00:06:43,820
.عدّة مناورتهم دون إذن

76
00:06:44,400 --> 00:06:45,700
من الفاعل إذًا؟

77
00:06:45,700 --> 00:06:47,410
...لا أدري

78
00:06:47,410 --> 00:06:50,370
.حاليًّا، أنا قلق أكثر على مراسم التّجنيد القادمة

79
00:06:51,080 --> 00:06:54,750
كم فردًا من بين القوّات الجديدة سيكون
مجنونًا ما يكفي للانضمام لنا يا ترى؟

80
00:06:55,870 --> 00:06:57,170
...يا إرين

81
00:06:57,170 --> 00:07:00,250
أيوجد في فصلك من يطلب الانضمام لنا؟

82
00:07:00,550 --> 00:07:01,460
.أجل، هناك

83
00:07:02,960 --> 00:07:05,170
.لا، بل كان هناك

84
00:07:06,220 --> 00:07:08,090
.لا أدري الآن

85
00:07:09,390 --> 00:07:10,390
!انتباه

86
00:07:14,350 --> 00:07:15,560
.تأهّبا

87
00:07:15,560 --> 00:07:16,690
.سنذهب في دوريّة

88
00:07:16,690 --> 00:07:17,400
!حاضر

89
00:07:17,900 --> 00:07:20,150
!صباح الخير أيّها القائد ليفاي

90
00:07:20,150 --> 00:07:21,400
...اسمع يا إرين

91
00:07:21,400 --> 00:07:23,690
.لا تتأخّر عنّي بمسافة حصانين أبدًا

92
00:07:23,690 --> 00:07:28,160
لا تنسَ أنّ السّبب الوحيد من عدم
.اعتقالك هو لأنّني أراقبك

93
00:07:28,160 --> 00:07:29,030
!حاضر

94
00:07:29,030 --> 00:07:29,820
.لنذهب

95
00:08:00,440 --> 00:08:01,360
...جان

96
00:08:02,270 --> 00:08:04,440
هل ستنضمّ لفيلق الاستطلاع حقًّا؟

97
00:08:04,440 --> 00:08:05,070
.نعم

98
00:08:05,400 --> 00:08:07,110
لِمَ فجأةً؟

99
00:08:07,110 --> 00:08:10,280
أقصد... ألست خائفًا؟

100
00:08:10,910 --> 00:08:13,450
.بالطّبع لا أريد الانضمام لفيلق الاستطلاع

101
00:08:13,450 --> 00:08:15,750
...لـ-لماذا إذًا

102
00:08:15,750 --> 00:08:19,370
.ليس وكأنّني قرّرتُ أنّي لا أخاف من العمالقة

103
00:08:19,920 --> 00:08:25,840
ولن أقول شيئًا كـ"على الأفضل
."أن ينضمّ إلى فيلق الاستطلاع

104
00:08:26,670 --> 00:08:28,720
.فلستُ متلهّفًا للموت كما البعض

105
00:08:29,430 --> 00:08:30,340
أتقصد إرين؟

106
00:08:31,340 --> 00:08:34,350
.لقد انضمّ لفيلق الاستطلاع بالفعل

107
00:08:34,760 --> 00:08:37,180
!أيّها المتدرّبون، اصطفّوا

108
00:08:37,180 --> 00:08:41,270
!اصطفّوا أمام المنصّة

109
00:08:40,140 --> 00:08:45,150
.لن أخاطر بحياتي لأنّ أحدًا أقنعني بذلك

110
00:08:46,280 --> 00:08:50,740
.هذا عمل لا يمكنك القيام به ما لم تقرّر ذلك بنفسك

111
00:08:58,960 --> 00:09:03,040
.أنا إروين سميث، مقدّم فيلق الاستطلاع

112
00:09:04,380 --> 00:09:06,590
.ستختارون اليوم جناحًا عسكريًّا

113
00:09:07,090 --> 00:09:11,720
.لأكون صريحًا، أنا هنا لأقنعكم لتنضمّوا لفيلق الاستطلاع

114
00:09:12,220 --> 00:09:14,760
،خلال هجوم العمالقة

115
00:09:14,760 --> 00:09:17,560
.عرفتم مدى رعبها

116
00:09:18,020 --> 00:09:20,980
.كما عرفتم مدى حدود قوّتكم

117
00:09:21,560 --> 00:09:22,310
...لكن

118
00:09:23,270 --> 00:09:27,730
قرّبت هذه المعركة البشر من النّصر
.أكثر من أيّ وقت مضى

119
00:09:28,440 --> 00:09:30,570
.بواسطة تواجد إرين ييغر

120
00:09:31,990 --> 00:09:34,950
وبمخاطرته بحياته، فقد أثبت أنّه

121
00:09:35,450 --> 00:09:38,410
.حليف للبشر دونما أدنى شكّ

122
00:09:40,790 --> 00:09:45,880
،بفضل مساعدته، لم نوقف زحف العمالقة فحسب

123
00:09:46,500 --> 00:09:49,550
.بل وباتت لدينا طريقة لاكتشاف طبيعتها الحقيقيّة

124
00:09:55,470 --> 00:09:58,680
،ونعتقد أنّ في قبو بيته في شيغانشينا

125
00:09:58,680 --> 00:10:01,430
.توجد أجوبة عن العمالقة هو نفسه لا يملكها

126
00:10:02,230 --> 00:10:04,690
،إن استطعنا الوصول إلى ذلك القبو

127
00:10:05,400 --> 00:10:11,530
سنجد دليلاً يضع حدًّا لهذا القرن
.الّذي شهد سطوة العمالقة

128
00:10:13,570 --> 00:10:14,910
القبو؟

129
00:10:16,070 --> 00:10:17,990
هل تقدّمنا بهذا المدى فعلاً؟

130
00:10:18,410 --> 00:10:21,290
!إن عرفنا حقيقتها، يمكننا إنهاء هذا

131
00:10:22,410 --> 00:10:25,120
،مهما بلغت رغبته بضمّ مجنّدين

132
00:10:25,120 --> 00:10:27,710
.لا أصدّق أنّه ينشر هذه المعلومات

133
00:10:28,250 --> 00:10:30,920
أم أنّه يملك دافعًا خفيًّا؟

134
00:10:31,760 --> 00:10:35,550
ما الّذي يحاول رؤيته؟

135
00:10:49,900 --> 00:10:53,280
.وجهتنا هي القبو في شيغانشينا

136
00:10:54,240 --> 00:10:58,280
.لكن، يتطلّب من ذلك استعادة سور ماريا

137
00:10:58,280 --> 00:11:01,370
.بعبارات أخرى، لم يتغيّر هدفنا

138
00:11:02,870 --> 00:11:05,920
،لكن مع إغلاق بوّابة تروست

139
00:11:06,500 --> 00:11:09,500
.سنسلك الطّريق الطّويل، من كارانيس إلى الشّرق

140
00:11:10,880 --> 00:11:15,930
السّنين الأربع الّتي أمضيناها في تمهيد
.طريق لجيش كبير قد ذهبت سدى

141
00:11:18,550 --> 00:11:21,930
ففي تلك السّنوات الأربع، فقد أكثر
.من 60% من فيلق الاستطلاع حياتهم

142
00:11:23,100 --> 00:11:24,730
...ستّون بالمئة في أربع سنوات

143
00:11:25,600 --> 00:11:27,600
.إنّه رقم مجنون

144
00:11:29,900 --> 00:11:31,190
أيّ متدرّب يلتحق بنا

145
00:11:31,900 --> 00:11:34,780
.سيشارك في رحلتنا خلف الأسوار بعد شهر

146
00:11:35,240 --> 00:11:38,450
.نتوقّع أنّ ثلاثين بالمئة لن يرجعوا

147
00:11:38,990 --> 00:11:41,330
.وفي غضون أربع سنوات، سيموت معظمهم

148
00:11:41,830 --> 00:11:47,870
لكنّ النّاجين سيصبحون جنودًا متفوّقين
.بدرجة نجاة عالية

149
00:11:52,500 --> 00:11:54,460
،بمعرفتكم لهذه الحقائق المحبطة

150
00:11:55,210 --> 00:11:59,470
.ليبق هنا كلّ من لا تزال لديه النيّة في المخاطرة بحياته

151
00:12:00,600 --> 00:12:02,470
...اسألوا أنفسكم

152
00:12:02,680 --> 00:12:07,230
أمستعدّون لتقديم قلوبكم النّابضة للبشريّة؟

153
00:12:12,610 --> 00:12:13,520
.هذا كلّ شيء

154
00:12:14,230 --> 00:12:16,740
.لينصرف أيّ من يرغب الانضمام إلى جناح آخر

155
00:12:19,240 --> 00:12:20,110
...أيّها المقدّم

156
00:12:20,780 --> 00:12:23,120
ألا تظنّ أنّك أخفتهم أكثر من اللاّزم؟

157
00:12:23,740 --> 00:12:25,620
!سيغادرون جميعًا

158
00:12:50,730 --> 00:12:51,900
...سحقًا

159
00:12:52,190 --> 00:12:54,940
!بربّك، حسمتَ قرارك بالفعل

160
00:12:55,650 --> 00:12:58,950
...لا تجعلني أكره نفسي أكثر

161
00:12:59,950 --> 00:13:03,950
.إلّم أغادر الآن، فسيكون عليّ مواجهتها مجدّدًا

162
00:13:05,330 --> 00:13:08,910
...غادرتُ القرية للانضمام للشّرطة العسكريّة

163
00:13:10,210 --> 00:13:11,960
.ستسعد أمّي

164
00:13:11,960 --> 00:13:15,880
،إن انضممت للشّرطة العسكريّة
.سأكبر في عين كلّ أهالي القرية

165
00:13:16,750 --> 00:13:18,840
...نعلم بالفعل

166
00:13:19,630 --> 00:13:21,550
...رأينا ذلك

167
00:13:22,180 --> 00:13:24,010
...كيف أنّ العمالقة

168
00:13:24,850 --> 00:13:26,510
!تأكل البشر

169
00:13:51,750 --> 00:13:55,840
أيمكنكم أن تموتوا إن أُمرتم بذلك؟

170
00:13:56,290 --> 00:13:57,840
!لا أريد أن أموت

171
00:13:59,590 --> 00:14:00,510
.فهمت

172
00:14:01,050 --> 00:14:02,760
.أحببت النّظرة الّتي تعلو وجوهكم

173
00:14:05,010 --> 00:14:10,220
!إذًا أرحّب بالجميع هنا في فيلق الاستطلاع

174
00:14:10,640 --> 00:14:12,690
!هذه تحيّة حقيقيّة

175
00:14:12,980 --> 00:14:14,770
!كرّسوا قلوبكم

176
00:14:20,690 --> 00:14:21,780
...الجميع

177
00:14:22,820 --> 00:14:24,200
.هذا فظيع

178
00:14:24,200 --> 00:14:25,660
...فيلق الاستطلاع

179
00:14:26,780 --> 00:14:28,160
!أنا خائفة

180
00:14:28,160 --> 00:14:29,660
...أريد أن أعود إلى البيت

181
00:14:29,660 --> 00:14:31,750
.لا أهتمّ حتّى

182
00:14:36,210 --> 00:14:38,880
.إن كنت ستبكين، فكان حريًّا بك أن تغادري

183
00:14:40,760 --> 00:14:42,760
.أبليتم حسنًا في تحمّل خوفكم

184
00:14:43,130 --> 00:14:44,970
.أنتم جنود شجعان

185
00:14:46,140 --> 00:14:47,760
.أحترمكم من قلبي

186
00:14:56,310 --> 00:14:57,400
!تحيّة

187
00:14:59,150 --> 00:15:00,980
.أنا قائد الفرقة نيس

188
00:15:01,400 --> 00:15:03,530
.وهذه فَرسي شالوت

189
00:15:03,530 --> 00:15:06,410
،تحبّ نتف الشّعر بأسنانها

190
00:15:06,410 --> 00:15:08,490
.لذا احذروا إن كنتم لا تريدون أن تصبحوا صُلعًا

191
00:15:08,490 --> 00:15:09,580
!سعيد للقائكم جميعًا

192
00:15:09,950 --> 00:15:13,160
!مهلاً! تـ-توقّفي يا شالوت

193
00:15:13,160 --> 00:15:15,040
!ليمسكها أحدكم

194
00:15:15,580 --> 00:15:17,170
.بدأ تدريبنا في اليوم الموالي

195
00:15:17,920 --> 00:15:19,380
،بدلاً من التّدريب العمليّ

196
00:15:19,380 --> 00:15:25,170
معظم ما كنّا نقوم به هو حفظ تشكيلة
.الاستطلاع بعيد المدى الّتي وضعها المقدّم إروين

197
00:15:26,300 --> 00:15:27,720
،وما كان غريبًا

198
00:15:27,720 --> 00:15:30,050
،مع أنّها كانت مكتوبة بالتّفصيل الدّقيق

199
00:15:34,640 --> 00:15:36,810
.أنتم المجنّدون الجدد ستكونون هنا

200
00:15:36,810 --> 00:15:40,150
.ستكونون بين فريق حراسة العربة وفريق دعم الاستطلاع

201
00:15:40,730 --> 00:15:44,150
ستقتضي مهمّتكم بمصاحبة الأحصنة
.الاحتياطيّة وتبادل الرّسائل

202
00:15:45,360 --> 00:15:47,910
.ستكون فرقة العمليّات الخاصّة هنا

203
00:15:48,410 --> 00:15:50,490
.واقفة في مركز الصّفوف الأخيرة

204
00:15:50,490 --> 00:15:52,160
.نحن متراجعون كثيرًا

205
00:15:52,830 --> 00:15:55,080
.إنّه المكان الأأمن في التّشكيلة

206
00:15:55,580 --> 00:15:58,670
.حتّى أنّنا محميّون أكثر من عربات الإمداد

207
00:15:59,290 --> 00:16:02,500
.حسنًا، هذه المرّة، هدفنا هو الخروج والعودة فحسب

208
00:16:03,000 --> 00:16:09,720
هذه الرّحلة الاستكشافيّة قصيرة لأنّها
.تمرين قبل رحلتكم إلى شيغانشينا

209
00:16:10,680 --> 00:16:11,550
...عذرًا

210
00:16:11,970 --> 00:16:16,520
...ما زلتُ لا أدري كيف ينبغي تسخير هذه القوّة

211
00:16:17,100 --> 00:16:20,860
هل فهمت ما عناه المقدّم بسؤاله؟

212
00:16:22,730 --> 00:16:24,070
ما العدوّ بظنّك؟

213
00:16:24,730 --> 00:16:27,150
هل فهمتم جميعًا؟

214
00:16:27,150 --> 00:16:28,110
...لا

215
00:16:29,110 --> 00:16:32,490
.ربّما سنكذب إن قلنا أنّنا نفهم كلّ شيء

216
00:16:32,490 --> 00:16:33,330
—لكن أظنّ

217
00:16:33,330 --> 00:16:37,500
.ربّما هناك هدف آخر من هذه المهمّة

218
00:16:37,500 --> 00:16:42,380
لكن قرّر المقدّم أنّ من الأفضل
.ألاّ يعرف الجنود تلك الحقيقة

219
00:16:42,380 --> 00:16:46,670
لذا يجب أن نركّز فقط على الوصول
.إلى هناك والعودة

220
00:16:47,670 --> 00:16:49,010
.ثقوا بالمقدّم

221
00:16:49,010 --> 00:16:50,010
...حسنًا

222
00:16:50,640 --> 00:16:52,350
.هنا ينتهي تدريب اليوم

223
00:16:52,350 --> 00:16:53,600
.استعدّوا للرّجوع

224
00:17:09,320 --> 00:17:10,570
...إ-إنّهما

225
00:17:10,570 --> 00:17:13,990
أولوو-سان، أيمكنني الذّهاب للتّحدّث مع زملائي؟

226
00:17:14,580 --> 00:17:15,990
...اذهب

227
00:17:15,990 --> 00:17:17,950
!يا ميكاسا! أرمين

228
00:17:19,460 --> 00:17:20,210
...إرين

229
00:17:20,670 --> 00:17:22,920
!أشعر وكأنّه مرّ وقت طويل

230
00:17:22,920 --> 00:17:26,460
إرين، هل فعلوا لك أيّ مكروه؟

231
00:17:26,460 --> 00:17:28,720
كالتّحرّي في كلّ شبر من جسدك على سبيل المثال؟

232
00:17:29,010 --> 00:17:31,010
أو التّعذيب النّفسيّ؟

233
00:17:31,550 --> 00:17:33,220
.محال

234
00:17:33,720 --> 00:17:35,760
.تمادى ذلك القصير كثيرًا

235
00:17:36,180 --> 00:17:38,270
.سأجعله يدفع الثّمن يومًا ما

236
00:17:38,270 --> 00:17:40,730
لا تقصدين القائد ليفاي، أليس كذلك؟

237
00:17:41,600 --> 00:17:42,900
...مرحبًا يا إرين

238
00:17:42,900 --> 00:17:44,360
!مضى وقتٌ طويل

239
00:17:44,360 --> 00:17:47,480
ماذا؟ الجميع هنا؟

240
00:17:48,440 --> 00:17:52,240
...لكن إن كنتم هنا، فذلك يعني

241
00:17:52,240 --> 00:17:54,370
لا يعقل أنّكم انضممتم لفيلق الاستطلاع، أليس كذلك؟

242
00:17:54,530 --> 00:17:56,990
وهل من سبب آخر يأتي بنا إلى هنا؟

243
00:17:56,990 --> 00:18:01,960
إذًا فقط جان وآني وماركو انضمّوا للشّرطة العسكريّة؟

244
00:18:05,290 --> 00:18:07,590
!لا يمكن... ليس أنت أيضًا

245
00:18:08,130 --> 00:18:09,460
.مات ماركو

246
00:18:11,050 --> 00:18:13,300
ماذا قلت؟

247
00:18:14,430 --> 00:18:17,140
هل قلت أنّ ماركو مات؟

248
00:18:18,220 --> 00:18:21,730
.لا يبدو أنّ الجميع يموتون بمأساويّة

249
00:18:22,230 --> 00:18:24,650
.لا أعلم حتّى كيف مات

250
00:18:25,770 --> 00:18:29,780
.مات دون أن يعرف أحد أو يراه أحد

251
00:18:30,230 --> 00:18:31,440
...ماركو

252
00:18:34,490 --> 00:18:36,620
!أيّها الأطفال الجدد، تعالوا إلى هنا

253
00:18:37,780 --> 00:18:39,620
!أزياؤكم جاهزة

254
00:19:18,240 --> 00:19:20,410
...هل أنتم حقًّا

255
00:19:20,830 --> 00:19:24,620
.نعم، سنشارك في المهمّة أيضًا

256
00:19:24,620 --> 00:19:25,580
.بالمناسبة يا إرين

257
00:19:26,080 --> 00:19:30,000
،سمعتُ أنّك عندما تحوّلت إلى عملاق
.حاولت قتل ميكاسا

258
00:19:30,460 --> 00:19:31,840
ما معنى ذلك؟

259
00:19:32,630 --> 00:19:35,220
...لا. كان إرين يحاول ضرب ذبابة

260
00:19:35,220 --> 00:19:36,680
.لم أسألك أنت

261
00:19:38,220 --> 00:19:41,970
.ميكاسا، يبدو أنّ الجرح الّذي على خدّك بليغ

262
00:19:43,060 --> 00:19:44,560
متى أصبت به؟

263
00:19:47,770 --> 00:19:49,110
.سمعتُ أنّ ذلك صحيح

264
00:19:49,520 --> 00:19:52,530
.عندما تحوّلتُ إلى عملاق، حاولت قتل ميكاسا

265
00:19:52,530 --> 00:19:55,700
إن سمعتَ فحسب فأنت لا تذكر، صحيح؟

266
00:19:55,700 --> 00:19:59,320
،ما يعني أنّك لم تكن تعلم أنّك تملك قوّة العملاق

267
00:19:59,870 --> 00:20:03,160
.ولا تملك القدرة على السّيطرة عليها

268
00:20:03,160 --> 00:20:05,080
.نعم، هذا صحيح

269
00:20:09,210 --> 00:20:10,750
هل سمعتم؟

270
00:20:10,750 --> 00:20:12,420
.هذا هو الوضع

271
00:20:12,840 --> 00:20:15,510
.البشريّة وحياتنا مرهونة به

272
00:20:16,130 --> 00:20:18,180
،سنموت مثل ماركو على الأغلب

273
00:20:18,180 --> 00:20:20,510
.دون حتّى أن يُدرك إرين بموتنا

274
00:20:21,010 --> 00:20:24,770
جان، ما المغزى من طرح
هذه الأسئلة على إرين الآن؟

275
00:20:25,810 --> 00:20:27,390
.اسمعي يا ميكاسا

276
00:20:27,850 --> 00:20:30,560
ليس الجميع مثلك

277
00:20:30,560 --> 00:20:33,190
...مستعدًّا للموت من أجل إرين دون أيّ مقابل

278
00:20:34,480 --> 00:20:40,070
.يجب أن نعرف لِمَ نموت

279
00:20:40,570 --> 00:20:43,700
.وإلاّ سنتردّد حينما يحين الوقت

280
00:20:44,370 --> 00:20:47,330
.نريد منه شيئًا في المقابل

281
00:20:48,370 --> 00:20:50,710
.لذا لنرَ ما يمكنه تقديمه

282
00:20:51,710 --> 00:20:55,460
.وإن كان يستحقّ حياتي في سبيله

283
00:21:00,130 --> 00:21:01,640
...لذا يا إرين

284
00:21:02,640 --> 00:21:06,640
.أنا أعتمد عليك حقًّا

285
00:21:08,390 --> 00:21:09,600
.حسنًا

286
00:21:16,360 --> 00:21:18,150
.أيّها المقدّم، اقترب الوقت

287
00:21:20,110 --> 00:21:22,660
.لقد طردنا كلّ العمالقة في المنطقة

288
00:21:22,990 --> 00:21:25,080
!سنفتح البوّابة بعد ثلاثين ثانية

289
00:21:32,330 --> 00:21:33,790
!إنّه فيلق الاستطلاع

290
00:21:34,040 --> 00:21:37,300
!يسمّون الشّارة الّتي على ظهورهم بأجنحة الحرّيّة

291
00:21:37,670 --> 00:21:39,050
...رائع حقًّا

292
00:21:40,470 --> 00:21:41,510
!حان الوقت

293
00:21:42,550 --> 00:21:45,760
.ستتّخذ البشريّة خطوة أخرى إلى الأمام

294
00:21:46,390 --> 00:21:49,350
!أروني ما تستطيعون فعله

295
00:21:51,480 --> 00:21:53,150
!افتحوا البوّابة

296
00:22:05,700 --> 00:22:07,410
!تقدّموا

297
00:22:12,170 --> 00:22:15,290
!سنبدأ الآن الرّحلة الاستكشافيّة الـ57 خارج الأسوار

298
00:22:16,420 --> 00:22:18,340
!إلى الأمام

299
00:23:53,770 --> 00:23:56,640
،بدخولهم التّشكيلة الاستطلاعيّة بعيدة المدى

300
00:23:56,640 --> 00:23:59,190
.يتقدّم فيلق الاستطلاع خارج الأسوار

301
00:23:59,610 --> 00:24:02,480
لكنّهم يلتقون فجأةً

302
00:24:02,480 --> 00:24:05,820
.بعملاق غامض يمتلك ذكاءً