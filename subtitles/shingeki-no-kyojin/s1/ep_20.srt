1
00:00:01,620 --> 00:00:05,750
،خرج فيلق الاستطلاع لإيجاد طريقٍ إلى شيغانشينا

2
00:00:06,250 --> 00:00:09,300
.فإذا بهم يلتقون بعملاق أنثى ذكيّ

3
00:00:17,060 --> 00:00:20,140
،بينما كان الجنود يسقطون تواليًا

4
00:00:20,140 --> 00:00:23,440
،توجّهوا إلى غابة من الأشجار العملاقة

5
00:00:23,440 --> 00:00:25,610
.دون أن يعرف أحدهم السّبب

6
00:00:26,190 --> 00:00:29,740
إلّم تهزمه فرقة ليفاي، فمن سيهزمه؟

7
00:00:31,780 --> 00:00:32,990
...مات أحد آخر

8
00:00:33,950 --> 00:00:35,990
!وربّما أمكننا إنقاذه

9
00:00:37,290 --> 00:00:38,200
.اختر

10
00:00:38,830 --> 00:00:40,250
.ثق بنفسك

11
00:00:40,830 --> 00:00:44,500
.أو ثق بي وبفيلق الاستطلاع

12
00:00:47,300 --> 00:00:48,710
!سأتقدّم

13
00:00:55,340 --> 00:00:57,010
!أطلقوا

14
00:01:05,400 --> 00:01:06,310
...هل يعقل

15
00:01:07,190 --> 00:01:09,900
كان ينوي أخذ ذلك العملاق حيًّا؟

16
00:01:10,400 --> 00:01:12,400
إذًا يا إرين؟ هل ترى ذلك؟

17
00:01:12,400 --> 00:01:14,280
!قبضنا على ذلك العملاق

18
00:01:14,280 --> 00:01:16,570
!هذه قوّة فيلق الاستطلاع

19
00:01:16,570 --> 00:01:18,410
.لا تستهن بنا أيّها الأحمق

20
00:01:18,410 --> 00:01:20,160
إذًا؟ هل فهمت الآن؟

21
00:01:21,580 --> 00:01:22,500
!أجل

22
00:01:25,920 --> 00:01:27,630
...يبدو أنّه توقّف عن الحراك

23
00:01:28,460 --> 00:01:29,880
.لا يمكننا إرخاء دفاعاتنا

24
00:01:30,550 --> 00:01:34,050
.لكنّكم أبليتم جيّدًا بقيادته إلى هنا

25
00:01:34,720 --> 00:01:39,720
مات الرّجال في فرق السّاقة
.ليكسبوا لنا الوقت الّذي نحتاج

26
00:01:40,600 --> 00:01:42,680
.ما كنّا لنستطيع فعل هذا لولاهم

27
00:01:43,020 --> 00:01:43,980
هكذا إذًا؟

28
00:01:44,560 --> 00:01:45,650
.أجل

29
00:01:46,940 --> 00:01:51,570
.بفضلهم، سنستطيع رؤية من يوجد داخل هذا الشّيء

30
00:01:53,190 --> 00:01:56,320
...آمل أنّه لم يتبوّل من خوفه

31
00:03:43,140 --> 00:03:44,220
عملاق شاذّ؟

32
00:03:44,600 --> 00:03:47,390
أم يشبه العملاق الضّخم؟

33
00:03:49,390 --> 00:03:51,190
...أم أنّ المقدّم إروين

34
00:03:51,190 --> 00:03:53,820
!أنت، عد إلى وعيك

35
00:03:53,820 --> 00:03:56,070
.إرين، فكّر لاحقًا

36
00:03:56,070 --> 00:03:57,820
!علينا أن نبتعد أكثر ونتأهّب

37
00:03:58,320 --> 00:03:58,990
!أجل

38
00:04:05,450 --> 00:04:06,330
...انتظر يا ليفاي

39
00:04:07,160 --> 00:04:08,580
.العين بالعين

40
00:04:09,160 --> 00:04:11,920
!الوابلان 2 و3، أطلقوا

41
00:04:12,710 --> 00:04:14,630
!أطلقوا الطّلقات الاحتياطيّة

42
00:04:32,850 --> 00:04:35,400
...عذرًا، لنتسلّق للأعلى

43
00:04:35,400 --> 00:04:36,650
.حسنًا

44
00:04:36,650 --> 00:04:40,030
.سأتنحّى إن وصل إلى هنا

45
00:04:40,740 --> 00:04:45,990
.لكنّهم سيصدرون أمرًا بالانسحاب عمّا قريب

46
00:04:45,990 --> 00:04:51,080
هل للأمر علاقة بالانفجارات
الّتي كنّا نسمعها في عمق الغابة؟

47
00:04:51,080 --> 00:04:52,080
.لا أدري

48
00:04:55,250 --> 00:04:58,460
ميكاسا، ما ذلك الصّوت برأيك؟

49
00:04:59,050 --> 00:05:01,630
هل يطلقون المدافع في الغابة؟

50
00:05:04,800 --> 00:05:07,760
.لكن لم يبدُ وكأنّهم أحضروا مدافعًا

51
00:05:08,350 --> 00:05:10,350
.المكان صاخب للغاية هناك

52
00:05:11,100 --> 00:05:12,480
...يا بيرتولت

53
00:05:12,730 --> 00:05:15,060
هل تعرف أين ذهبت كريستا؟

54
00:05:15,060 --> 00:05:17,110
.آسف، لا أدري

55
00:05:17,520 --> 00:05:19,480
.لا أملك أدنى فكرة عمّا يجري

56
00:05:19,780 --> 00:05:21,860
ما الّذي أفعله ولماذا؟

57
00:05:22,200 --> 00:05:23,320
.أريد أن أذهب للدّيار

58
00:05:26,320 --> 00:05:27,910
.سنتبادل المواقع يا أرمين

59
00:05:27,910 --> 00:05:28,620
.حسنًا

60
00:05:35,960 --> 00:05:38,420
.بدأت تستوعب الأمر

61
00:05:38,800 --> 00:05:41,300
.يبدو أنّها تتحسّن أكثر فأكثر في التّسّلق

62
00:05:41,300 --> 00:05:44,800
.مع أنّ هذا مخيف، لكن يمكنها أن تتعلّم

63
00:05:44,930 --> 00:05:46,890
.مع أنّ بعضها أفضل من الآخر

64
00:05:47,600 --> 00:05:48,810
...أرمين

65
00:05:49,010 --> 00:05:51,560
.يبدو أنّ شيئًا ما يجري في أعماق الغابة

66
00:05:51,850 --> 00:05:53,850
.أظنّني أملك فكرةً عنه

67
00:05:54,810 --> 00:05:59,230
استدرجوا العملاق الأنثى كلّ هذا
.الطّريق لأجل القبض عليه

68
00:06:00,690 --> 00:06:02,190
...بشكلٍ أدقّ

69
00:06:02,940 --> 00:06:05,530
.ليقبضوا على أيّ كان من في داخله

70
00:06:06,490 --> 00:06:08,160
...كان ذلك هدف المقدّم إروين

71
00:06:09,660 --> 00:06:11,700
!كانت هذه خطّته من البداية

72
00:06:11,700 --> 00:06:13,160
أليس كذلك؟

73
00:06:13,870 --> 00:06:16,710
.يمكنني أن أفهم لِمَ لم يخبرنا نحن المستجدّون

74
00:06:17,080 --> 00:06:18,580
لكن لِمَ لم يخبركم

75
00:06:18,840 --> 00:06:21,210
مع أنّكم كنتم في فيلق الاستطلاع منذ مدّة طويلة؟

76
00:06:21,210 --> 00:06:22,380
!اخرس

77
00:06:22,380 --> 00:06:26,550
هل تقصد أنّ المقدّم والقائد لا يثقان بنا؟

78
00:06:27,090 --> 00:06:30,100
...لكن هذا ما يعنيه

79
00:06:30,100 --> 00:06:32,390
!بيترا، اخلعي أسنانه

80
00:06:32,390 --> 00:06:34,140
!بدّلي الأسنان الأماميّة مع الخلفيّة عندما تعيدينها

81
00:06:34,140 --> 00:06:36,100
.لا، إرين على حقّ

82
00:06:36,980 --> 00:06:41,440
.أظنّ أنّ المقدّم يملك سببًا من عدم ثقته بنا

83
00:06:42,440 --> 00:06:43,440
مثل هذا؟

84
00:06:43,440 --> 00:06:46,450
.ثمّة سبب واحد قد يمنعه من الوثوق بجنوده

85
00:06:46,990 --> 00:06:49,320
،هناك من يملك القدرة على التّحوّل إلى عملاق

86
00:06:49,320 --> 00:06:52,950
.أو جاسوس يساعده في فيلق الاستطلاع

87
00:06:54,540 --> 00:06:56,460
تظنّ ذلك أيضًا، صحيح؟

88
00:06:57,420 --> 00:06:58,620
.لا بدّ أنّه واحد منّا

89
00:07:00,330 --> 00:07:01,540
.نعم، أظنّ ذلك

90
00:07:06,720 --> 00:07:08,130
جاسوس؟

91
00:07:08,380 --> 00:07:09,840
أهذا ممكن؟

92
00:07:10,220 --> 00:07:13,510
.على أيّ حال، المقدّم متأكّد

93
00:07:13,770 --> 00:07:17,020
أتصوّر أنّ الجنود الوحيدين الّذين أُبلغوا بالخطّة

94
00:07:17,020 --> 00:07:19,350
هم الّذين تمكّنوا من النّجاة
.في السّنوات الخمس الأخيرة

95
00:07:19,350 --> 00:07:20,270
...فهمت

96
00:07:20,270 --> 00:07:21,770
.هكذا الأمر إذًا

97
00:07:21,770 --> 00:07:23,690
.لا بدّ أنّه كذلك

98
00:07:23,690 --> 00:07:25,030
هل فهمت يا إرين؟

99
00:07:25,030 --> 00:07:26,280
.لهذا السّبب

100
00:07:26,570 --> 00:07:29,110
.نعم، إن كان السّبب فقد فهمت

101
00:07:30,360 --> 00:07:33,950
،يفترض أنّه قبل خمس سنوات
،عندما انهار السّور الأوّل

102
00:07:33,950 --> 00:07:36,160
...تسلّل جاسوس إلى صفوفنا

103
00:07:36,540 --> 00:07:38,620
.وهكذا ضيّق الاحتمالات

104
00:07:39,420 --> 00:07:43,170
إذًا هل الجاسوس هو من قتل سوني وبين؟

105
00:07:44,210 --> 00:07:48,550
.حينها، سألني المقدّم عن ذلك

106
00:07:50,890 --> 00:07:52,470
ماذا ترى؟

107
00:07:53,430 --> 00:07:55,220
ما العدوّ بظنّك؟

108
00:07:55,890 --> 00:07:58,230
أهذا ما عناه بسؤاله؟

109
00:07:58,230 --> 00:08:00,480
،لو أنّنا استطعنا الإجابة عنه

110
00:08:00,650 --> 00:08:03,400
.لربّما استطعنا المشاركة في هذه الخطّة

111
00:08:04,400 --> 00:08:06,530
.لكن أشكّ أنّ أيّ أحد كان ليستطيع الإجابة حينها

112
00:08:06,530 --> 00:08:08,440
.لقد عرفت

113
00:08:08,440 --> 00:08:11,360
.لكنّي لم أقل أيّ شيء

114
00:08:11,740 --> 00:08:13,990
هل تعرفون لماذا؟

115
00:08:14,580 --> 00:08:15,540
لماذا؟

116
00:08:16,370 --> 00:08:18,660
ماذا؟ ألا ترون؟

117
00:08:19,040 --> 00:08:21,830
.حسنًا، لا ينبغي أن أتوقّع ذلك من أمثالكم

118
00:08:22,000 --> 00:08:25,380
.لم تصلوا لمستواي بعد

119
00:08:25,380 --> 00:08:28,590
أنت، هل تقلّد القائد ليفاي ثانيةً؟

120
00:08:28,840 --> 00:08:30,680
.ما كان القائد ليقول أيّ شيء كهذا

121
00:08:30,680 --> 00:08:34,850
إن نجح هذا، يمكنني أن أقترب أكثر
.من حقيقة هذا العالم

122
00:08:35,720 --> 00:08:42,270
.لكن... مات الكثير على أيّ حال

123
00:08:46,320 --> 00:08:48,570
هل تظنّون أنّ المقدّم كان مخطئًا؟

124
00:08:52,570 --> 00:08:54,780
.لا يمكنني الجزم فيمَ إن كان على صواب

125
00:08:54,780 --> 00:08:58,490
،لو أنّنا علمنا أنّ هناك عملاقًا يعرف بشأن عمليّاتنا

126
00:08:58,910 --> 00:09:00,750
.لتعاملنا مع هذا بطريقة أخرى

127
00:09:01,330 --> 00:09:03,710
.ونفس الشّيء ينطبق على قائد فريقكم والبقيّة

128
00:09:08,420 --> 00:09:10,630
.كلاّ، لم يكن مخطئًا

129
00:09:11,300 --> 00:09:12,930
ماذا تقصد؟

130
00:09:13,220 --> 00:09:15,890
كم أُزهقت من روح بلا سبب برأيك؟

131
00:09:16,640 --> 00:09:21,310
جان، يسهل أن نقول "كان حريًّا بنا
.فعل شيء آخر" بعد عِلمنا للحقيقة

132
00:09:21,310 --> 00:09:22,140
،لكن

133
00:09:22,850 --> 00:09:25,350
.لا أحد يدري كيف ستؤول الأمور

134
00:09:25,350 --> 00:09:28,150
.ومع ذلك، عليك أن تتّخذ قرارًا

135
00:09:28,480 --> 00:09:29,610
.عليك ذلك

136
00:09:30,740 --> 00:09:32,950
...حياة مائة جنديّ زميل

137
00:09:32,950 --> 00:09:34,990
...أو حياة كلّ البشر داخل الأسوار

138
00:09:35,870 --> 00:09:37,490
.اتّخذ المقدّم قراره

139
00:09:37,990 --> 00:09:41,580
.وقد اختار التّضحيّة بأولئك المائة

140
00:09:42,210 --> 00:09:45,630
،إرين، لا تدري بعد

141
00:09:45,630 --> 00:09:47,290
.لكنّك ستعلم قريبًا

142
00:09:47,880 --> 00:09:51,880
،سبب ائتمان إروين سميث بأمل البشريّة

143
00:09:51,880 --> 00:09:53,420
.فيلق الاستطلاع

144
00:09:54,050 --> 00:09:57,010
!انظر كم يثق فيه القائد ليفاي فحسب

145
00:09:57,220 --> 00:10:00,390
...هذا إن عشت ما يكفي لتعرف

146
00:10:01,850 --> 00:10:03,890
،لم أعش كثيرًا

147
00:10:04,310 --> 00:10:06,060
.لكنّي متيقّن من شيء واحد

148
00:10:06,730 --> 00:10:10,020
،إن كان هناك من يستطيع إحداث التّغيير

149
00:10:10,020 --> 00:10:13,900
.فسيكون أحدًا مستعدًّا للتّضحية بما يهتمّ له

150
00:10:14,900 --> 00:10:20,990
سيكون شخصًا يستطيع التّخلّي عن
.إنسانيّته من أجل هزيمة الوحوش

151
00:10:22,250 --> 00:10:24,750
ما كان شخص لا يستطيع التّضحيّة بأيّ شيء

152
00:10:25,080 --> 00:10:27,380
!أن يغيّر أيّ شيء أبدًا

153
00:10:40,350 --> 00:10:41,890
!أطلقوا

154
00:10:46,100 --> 00:10:47,600
ما رأيك؟

155
00:10:47,600 --> 00:10:50,060
.لن تستطيع حكّ ولو إنشٍ من جسدك

156
00:10:50,060 --> 00:10:53,530
.ولن تستطيع أن تقدم على أيّ خطوة
.ولبقيّة حياتك على الأغلب

157
00:10:54,690 --> 00:10:59,910
،صُمّمت بحيث كلّما عالجت جراحك
!شُلّت مفاصلك

158
00:11:03,120 --> 00:11:06,500
لكن ما زالوا عاجزين عن إخراج
الشّخص القابع في داخله؟

159
00:11:06,870 --> 00:11:09,960
ما الّذي يفعله ليفاي وميكي؟

160
00:11:34,940 --> 00:11:39,950
يمكنه أن يُصلّب جلده بشكل انتقائيّ
لحماية أجزاء معيّنة من جسده؟

161
00:11:40,450 --> 00:11:43,660
.هذا يشبه ما سمعته عن العملاق المدرّع

162
00:11:45,160 --> 00:11:49,500
هل سيضعف إن استمررنا باستخدام
عدّة المناورات والأنصال؟

163
00:11:50,710 --> 00:11:52,540
.لا نملك الوقت لنعرف

164
00:11:52,540 --> 00:11:53,540
...في تلك الحالة

165
00:11:55,510 --> 00:11:56,420
نعم؟

166
00:11:56,420 --> 00:11:57,550
.جهّزوا المتفجّرات

167
00:11:58,220 --> 00:12:00,050
.فجّروا رأسه

168
00:12:00,050 --> 00:12:00,800
...حاضر

169
00:12:01,510 --> 00:12:04,560
لكن ثمّة احتمال أنّ القدر الّذي نملك

170
00:12:05,140 --> 00:12:08,060
.يملك قوّة ناريّة كافية لتُدمّر ما في داخله أيضًا

171
00:12:08,060 --> 00:12:11,730
.اضبطوها إذًا لبتر المعصمين

172
00:12:12,980 --> 00:12:15,230
.فجّروها كلّها عند إشارتي

173
00:12:15,230 --> 00:12:16,070
.عُلم

174
00:12:25,620 --> 00:12:26,580
...أنت

175
00:12:27,040 --> 00:12:29,250
لِمَ لا تخرج فحسب؟

176
00:12:29,960 --> 00:12:32,580
.لا نملك وقتًا نضيّعه

177
00:12:33,290 --> 00:12:34,250
...لذا

178
00:12:34,250 --> 00:12:36,460
ماذا سيحدث لك الآن بظنّك؟

179
00:12:37,260 --> 00:12:41,510
هل تعتقد أنّك تستطيع الهرب؟

180
00:12:42,640 --> 00:12:45,890
...يا ليتك تُقدّر كلّ المصاعب الّتي نمرّ بها

181
00:12:46,970 --> 00:12:51,310
.وحسبما أذكر، فقد قتلت قوّاتي بطُرق مختلفة

182
00:12:51,690 --> 00:12:53,900
هل وجدت ذلك ممتعًا؟

183
00:12:55,360 --> 00:12:57,110
.حاليًّا، إنّي مستمتع

184
00:12:57,480 --> 00:13:00,110
وأنت أيضًا، صحيح؟

185
00:13:01,320 --> 00:13:04,660
.أظنّك تستطيع فهمي

186
00:13:07,200 --> 00:13:08,370
...صحيح

187
00:13:08,700 --> 00:13:10,790
.أردت سؤالك شيئًا

188
00:13:12,080 --> 00:13:14,920
ألا بأس إن بترنا يديك وساقيك؟

189
00:13:15,920 --> 00:13:17,750
ستنمو ثانيةً، صحيح؟

190
00:13:18,300 --> 00:13:20,720
.أقصد أطرافك أنت، لا العملاق

191
00:13:21,720 --> 00:13:25,220
...نحتاج إليك حيًّا في النّهاية

192
00:13:56,960 --> 00:13:59,960
.أيّها الوغد... لقد أفزعتني

193
00:14:02,050 --> 00:14:03,970
أكانت تلك صيحات احتضاره؟

194
00:14:07,220 --> 00:14:08,640
.إروين، إنّها قادمة

195
00:14:09,060 --> 00:14:09,930
من أيّ اتّجاه؟

196
00:14:10,260 --> 00:14:12,730
.من مصادر مختلفة ومن كلّ الاتّجاهات في آن واحد

197
00:14:17,860 --> 00:14:19,190
ما بالها؟

198
00:14:19,190 --> 00:14:20,690
كلّها تركض باتّجاه الغابة؟

199
00:14:21,070 --> 00:14:22,780
لِمَ بدأت تتجاهلنا فجأةً؟

200
00:14:27,530 --> 00:14:28,410
ماذا؟

201
00:14:29,030 --> 00:14:31,830
كلّها عمالقة شاذّة؟

202
00:14:31,830 --> 00:14:33,870
!لا يهمّ! لا تدعوها تدخل

203
00:14:34,710 --> 00:14:36,540
!ابدؤوا القتال

204
00:14:38,880 --> 00:14:40,290
ماذا حدث للتّوّ؟

205
00:14:40,670 --> 00:14:41,880
...انتظري

206
00:14:43,380 --> 00:14:46,090
.سمعتُ مثل تلك الصّرخة من قبل

207
00:14:46,300 --> 00:14:47,930
...في الغابة الّتي في دياري

208
00:14:48,340 --> 00:14:52,100
!إنّها صيحات حيوان محاصر لا يملك ما يخسره

209
00:14:52,100 --> 00:14:55,850
تعلّمتُ أن أتوخّى بالغ الحذر
!عندما يدنو الصّيد من نهايته

210
00:14:56,440 --> 00:14:58,310
عليّ الحذر إذًا؟

211
00:14:58,310 --> 00:15:00,650
!بل وبمائة ضعف عن المعتاد

212
00:15:00,650 --> 00:15:02,860
!إن استهنت بالغابة، فستموتين

213
00:15:03,320 --> 00:15:05,950
.نشأتُ في الجبال أيضًا

214
00:15:05,950 --> 00:15:08,320
!ما كانت فتاة مزارعة لتفهم هذا

215
00:15:08,450 --> 00:15:09,160
.فهمت

216
00:15:10,370 --> 00:15:13,370
.صحيحٌ أنّ حدس ساشا جيّد عادةً

217
00:15:13,830 --> 00:15:16,830
.ولا سيّما عندما تتوقّع بأن تسوء الأمور

218
00:15:27,970 --> 00:15:29,390
!جهّزوا تلك المتفجّرات، حالاً

219
00:15:30,260 --> 00:15:31,390
...إروين

220
00:15:31,390 --> 00:15:32,890
.سيأتي السّرب الأوّل من الشّرق

221
00:15:32,890 --> 00:15:33,810
.تكاد تصل

222
00:15:35,680 --> 00:15:37,730
!فريق حراسة العربة، اعترضوها

223
00:15:44,820 --> 00:15:45,900
تفادتنا؟

224
00:15:45,900 --> 00:15:47,030
أهي عمالقة شاذّة؟

225
00:15:47,900 --> 00:15:49,360
!ثلاثة منها تخترقنا

226
00:15:50,570 --> 00:15:52,120
!أيّها القائد ليفاي

227
00:15:52,120 --> 00:15:55,830
فعلت شيئًا للتّوّ، أليس كذلك أيّها الوغد؟

228
00:16:06,710 --> 00:16:08,760
تستهدف العملاق الأنثى إذًا؟

229
00:16:11,340 --> 00:16:14,100
!ثمّة عمالقة من كلّ اتّجاه

230
00:16:14,680 --> 00:16:16,520
.إلى كلّ الرجال، التحموا

231
00:16:17,020 --> 00:16:19,520
!احموا العملاق الأنثى وإن كلّفكم ذلك حياتكم

232
00:16:35,280 --> 00:16:36,240
!لا فائدة

233
00:16:50,220 --> 00:16:51,760
!انسحبوا يا رجال

234
00:16:53,850 --> 00:16:55,600
!عودوا لتشكيلتكم

235
00:16:56,760 --> 00:16:58,770
!عودوا إلى كارانيس

236
00:17:17,160 --> 00:17:18,370
.نالت منّا

237
00:17:20,000 --> 00:17:21,830
.انظر لحالك

238
00:17:22,460 --> 00:17:24,040
...لا تقل لي

239
00:17:24,040 --> 00:17:25,210
...كان العدوّ

240
00:17:25,540 --> 00:17:28,670
.مستعدًّا للتّضحية بكلّ شيء

241
00:17:30,090 --> 00:17:35,390
لم أتوقّع من العدوّ أن يُعرّض نفسه للالتهام
.من قبل العمالقة ليتخلّص من نفسه والدّليل

242
00:17:37,390 --> 00:17:41,020
بعد كلّ الكلام الّذي تفوّهنا به في
.المحكمة العسكريّة، وهذا ما يحصل

243
00:17:41,520 --> 00:17:45,520
،إن رجعنا خاليي الوفاض
.من يدري ما قد يحلّ بنا وإرين

244
00:17:46,190 --> 00:17:47,860
.يمكننا أن نفكّر في ذلك بعد عودتنا

245
00:17:48,570 --> 00:17:52,360
تقضي أولويّتنا الآن بالعودة
.إلى الدّيار دون المزيد من الخسائر

246
00:17:53,450 --> 00:17:54,490
...في الوقت الرّاهن

247
00:17:56,450 --> 00:17:58,410
.البخار النّاجم عن الجثّة يحجب الرّؤية

248
00:17:59,080 --> 00:18:01,660
.قد يتداخل مع نظام إشارة تبادل الرّسائل خاصّتنا

249
00:18:07,500 --> 00:18:09,000
.سأستدعي فريقي

250
00:18:09,800 --> 00:18:10,630
...انتظر يا ليفاي

251
00:18:11,840 --> 00:18:13,630
.أعد شحن غازك وأنصالك

252
00:18:13,930 --> 00:18:15,390
.لا نملك وقتًا

253
00:18:15,390 --> 00:18:17,010
.وأنا أملك الكثير من الوقت

254
00:18:17,010 --> 00:18:17,890
فلماذا؟

255
00:18:18,350 --> 00:18:19,470
.هذا أمر

256
00:18:20,060 --> 00:18:21,270
.اتّبعه

257
00:18:22,100 --> 00:18:23,890
.عُلم يا إروين

258
00:18:25,350 --> 00:18:27,400
.أثق بقرارك

259
00:18:41,120 --> 00:18:42,160
.سننسحب

260
00:18:42,620 --> 00:18:44,000
.انسحبوا جميعًا

261
00:18:44,500 --> 00:18:45,960
.امتطوا أحصنتكم وانسحبوا

262
00:18:45,960 --> 00:18:46,830
!حاضر

263
00:18:47,290 --> 00:18:49,840
ماذا؟ هل انتهى الأمر بالفعل؟

264
00:18:52,920 --> 00:18:54,970
!يمكننا العودة للدّيار! أجل

265
00:18:56,090 --> 00:18:57,680
ما الّذي يجري؟

266
00:18:58,470 --> 00:18:59,510
أين إرين؟

267
00:19:01,220 --> 00:19:02,770
.يبدو أنّها انتهت

268
00:19:03,520 --> 00:19:05,770
!عودوا إلى أحصنتكم! استعدّوا للانسحاب

269
00:19:06,350 --> 00:19:07,480
...سمعت الأمر

270
00:19:07,480 --> 00:19:11,900
.لنذهب ونرى كيف يبدو الوغد في الدّاخل

271
00:19:14,280 --> 00:19:16,650
هل سنعرف من يكون فعلاً؟

272
00:19:16,650 --> 00:19:18,070
.هذا بفضلك

273
00:19:18,530 --> 00:19:19,950
.لم أفعل أيّ شيء حقًّا

274
00:19:20,410 --> 00:19:22,410
.آمنت بنا

275
00:19:23,120 --> 00:19:27,250
.هذه نتيجة اختيارك للوثوق بنا حينها

276
00:19:27,250 --> 00:19:30,880
.ليس من السّهل اتّخاذ القرار الصّائب

277
00:19:31,790 --> 00:19:35,170
...لا تدلّليه يا بيترا

278
00:19:35,420 --> 00:19:37,430
ماذا فعل على أيّ حال؟

279
00:19:37,430 --> 00:19:40,800
.كان مثيرًا للشّفقة. ظلّ يشتكي فحسب

280
00:19:40,800 --> 00:19:44,430
.لكن، من الجيّد أن تنجو في رحلتك الأولى

281
00:19:44,430 --> 00:19:47,640
.لكنّ ذلك لا يُهمّ إلى أن تنتهي المهمّة

282
00:19:48,230 --> 00:19:52,480
اسمع يا فتى، تستمرّ الرّحلة الاستكشافيّة
...إلى أن تعود إلى بيتك وتنام على سريرك

283
00:19:52,480 --> 00:19:54,980
!تبًّا، أدري ذلك

284
00:19:57,610 --> 00:19:59,200
!أولوو! بيترا

285
00:19:59,200 --> 00:20:02,370
.لقد تبوّلتما من الذّعر وبكيتما في مهمّتكما الأولى

286
00:20:02,700 --> 00:20:03,870
!لقد كبرتما الآن

287
00:20:05,620 --> 00:20:06,750
!لا تقل هذا

288
00:20:06,750 --> 00:20:09,460
!ماذا إن توقّف عن احترامي؟

289
00:20:09,830 --> 00:20:10,750
أهذا صحيح؟

290
00:20:10,750 --> 00:20:12,000
.إنّها الحقيقة

291
00:20:12,000 --> 00:20:14,460
.ولم أتبوّل بالمناسبة يا إرين

292
00:20:14,460 --> 00:20:15,510
!غبيّ

293
00:20:15,510 --> 00:20:18,260
!قتلت أكثر منك

294
00:20:18,260 --> 00:20:19,800
!أكثر منك أيّها الغبيّ

295
00:20:19,800 --> 00:20:22,800
.لا تُعدّ جنديًّا بكم قتلتَ فقط

296
00:20:22,800 --> 00:20:24,350
!اخرس أيّها الأحمق

297
00:20:24,350 --> 00:20:25,100
...بيترا

298
00:20:25,260 --> 00:20:27,230
أيعني هذا أنّك نثرت بولك في الهواء؟

299
00:20:27,230 --> 00:20:28,520
!اخرسوا

300
00:20:28,520 --> 00:20:30,310
هل تحسبون أنفسكم في نزهة؟

301
00:20:30,310 --> 00:20:32,150
!نحن خارج الأسوار

302
00:20:32,150 --> 00:20:34,520
.لم أتوبّل على سروالي أيضًا يا إرين

303
00:20:44,910 --> 00:20:48,120
.واثق أنّ تلك الإشارة من القائد ليفاي

304
00:20:48,620 --> 00:20:50,120
!سنلتقي مع القائد

305
00:20:50,120 --> 00:20:51,960
.كفّوا عن اللّغو إلى أن نعود

306
00:21:12,810 --> 00:21:13,770
...إروين

307
00:21:14,270 --> 00:21:16,270
لِمَ أمرت ليفاي بإعادة التّموين؟

308
00:21:16,270 --> 00:21:17,360
.لا وقت نضيّعه

309
00:21:18,110 --> 00:21:19,570
.لقد التُهِم العملاق الأنثى

310
00:21:19,990 --> 00:21:22,860
لكن هل رأيت الشّخص الّذي في داخله يُلتهم؟

311
00:21:23,530 --> 00:21:24,530
.كلاّ

312
00:21:25,780 --> 00:21:26,830
...لا تقل

313
00:21:26,830 --> 00:21:27,540
...أجل

314
00:21:27,830 --> 00:21:30,290
،إن كانت فرضيّتك الأولى صحيحة

315
00:21:30,290 --> 00:21:34,460
إن كان بإمكانه التّحرّك بنسبةٍ ما
...بعد استعادته لشكله البشريّ

316
00:21:35,420 --> 00:21:39,550
وإن كان مهيّئًا بمعدّات مناورة
...ثلاثيّة الأبعاد آنفًا

317
00:21:41,090 --> 00:21:45,510
.فإنّ الشّخص القابع في العملاق الأنثى يرتدي زيّنا الآن

318
00:21:46,760 --> 00:21:48,140
القائد ليفاي؟

319
00:21:49,180 --> 00:21:50,850
!لا، ليس هو

320
00:21:50,850 --> 00:21:51,430
!من أنت؟

321
00:22:00,780 --> 00:22:01,900
!غـ-غونتا-سان

322
00:22:01,900 --> 00:22:03,650
ماذا؟ لماذا؟

323
00:22:04,700 --> 00:22:05,740
!غونتا-سان

324
00:22:14,500 --> 00:22:18,250
.إنّ العدوّ الآن متنكّر كأحد رجالنا

325
00:23:53,600 --> 00:23:55,640
.باءت عمليّة القبض بالفشل

326
00:23:56,270 --> 00:23:59,520
.وإذ بالعملاق الأنثى يظهر أمام إرين مرّة أخرى

327
00:23:59,900 --> 00:24:04,440
،وما يحول بينه وبين هدفه هم نخبة قاتلي العمالقة

328
00:24:04,440 --> 00:24:06,490
.فرقة المهمّات الخاصّة