1
00:00:01,670 --> 00:00:03,500
...في سنة 845

2
00:00:03,960 --> 00:00:06,760
ظهر العملاقان الضّخم والمدرّع

3
00:00:06,760 --> 00:00:11,090
،فجأة ودمّرا السّور

4
00:00:11,090 --> 00:00:13,300
.إضافة إلى الحياة الّتي عهدناها

5
00:00:14,680 --> 00:00:17,350
،هجرت البشريّة سور ماريا

6
00:00:17,980 --> 00:00:22,730
،وخسرت عشرين في المائة من سكّانها وثُلث منطقتها

7
00:00:23,230 --> 00:00:25,360
.بغرض الانسحاب إلى سور روز

8
00:00:27,110 --> 00:00:29,990
...ونحن الآن في سنة 850

9
00:00:31,030 --> 00:00:32,530
هجومنا المضادّ

10
00:00:33,320 --> 00:00:34,490
!بدأ للتّوّ

11
00:00:37,290 --> 00:00:39,910
!هدفنا هو العملاق الضّخم الّذي أمامنا

12
00:00:41,040 --> 00:00:42,080
!هذه فرصتنا

13
00:00:42,330 --> 00:00:43,630
!لا تسمحوا له بالإفلات

14
00:00:47,010 --> 00:00:48,010
...مرحبًا بك

15
00:00:49,090 --> 00:00:50,630
.مرّت خمس سنوات

16
00:02:50,130 --> 00:02:53,340
!كان يسعى خلف المدافع الثّابتة

17
00:02:54,880 --> 00:02:57,470
...وليست صدفة أنّه استهدف البوّابة أيضًا

18
00:02:58,550 --> 00:03:00,720
...بكلّ تأكيد، هذا الشّيء

19
00:03:01,760 --> 00:03:02,930
!واعٍ

20
00:03:08,400 --> 00:03:09,860
!لكنّ هذه هي فرصتنا

21
00:03:11,020 --> 00:03:13,030
!إنّه الوحيد الّذي يستطيع تحطيم الأسوار

22
00:03:15,490 --> 00:03:17,030
...إن استطعت قتله

23
00:03:24,830 --> 00:03:25,870
!بطيء جدًّا

24
00:03:28,500 --> 00:03:29,500
!أنت لي

25
00:03:32,050 --> 00:03:32,840
!ماذا؟

26
00:03:42,890 --> 00:03:46,230
!هيّا

27
00:03:50,360 --> 00:03:51,310
أخطأته؟

28
00:03:57,240 --> 00:03:58,360
...كلاّ

29
00:03:59,030 --> 00:04:01,490
هل اختفى العملاق الضّخم؟

30
00:04:03,330 --> 00:04:04,620
!إرين

31
00:04:04,620 --> 00:04:06,040
هل هزمته؟

32
00:04:06,540 --> 00:04:07,370
!كلاّ

33
00:04:08,460 --> 00:04:09,960
...هذا تمامًا ما حدث قبل خمس سنوات

34
00:04:10,500 --> 00:04:13,630
!ظهر من العدم واختفى في طرفة عين

35
00:04:16,880 --> 00:04:17,760
.أنا آسف

36
00:04:17,760 --> 00:04:18,930
.تركته يفلت منّي

37
00:04:18,930 --> 00:04:20,340
لماذا تعتذر؟

38
00:04:20,550 --> 00:04:22,100
—لم يستطع بقيّتنا حتّى التّحرّك

39
00:04:22,100 --> 00:04:24,060
!مهلاً، لا وقت للنّقاش

40
00:04:24,430 --> 00:04:26,430
.تمّ اختراق السّور

41
00:04:26,430 --> 00:04:29,640
،إن لم نصلحه بسرعة
!ستدخل العمالقة كما في السّابق

42
00:04:29,640 --> 00:04:30,980
ما الّذي تفعلونه؟

43
00:04:31,440 --> 00:04:34,860
.بدأت خطّة الطّوارئ الخاصّة بالعملاق الضّخم بالفعل

44
00:04:35,190 --> 00:04:36,820
!اذهبوا للمقرّ الرئيسيّ

45
00:04:37,030 --> 00:04:39,820
على كلّ من يستطيع الوصول إليه
!ألاّ ينسى أن يبلّغ عن الوضع

46
00:04:39,820 --> 00:04:40,570
!حاضر

47
00:04:40,570 --> 00:04:42,700
!حظًّا سعيدًا للفريق المتقدّم

48
00:04:59,340 --> 00:05:01,260
!احملوا أقلّ قدر من الأغراض الخاصّة

49
00:05:01,590 --> 00:05:03,470
!الزموا الهدوء أثناء الإخلاء

50
00:05:07,560 --> 00:05:09,100
،إن استطاعت الدّخول

51
00:05:09,100 --> 00:05:12,310
!فسنعيش المأساة الّتي حلّت بنا قبل خمس سنوات ثانية

52
00:05:13,350 --> 00:05:17,320
!سنوقف العمالقة هنا

53
00:05:18,780 --> 00:05:20,030
.استعدّوا لاعتراضها

54
00:05:22,780 --> 00:05:24,120
!أطلقوا

55
00:05:30,620 --> 00:05:31,580
!هجوم

56
00:05:35,630 --> 00:05:37,340
تجاوزتم جميعًا أيّها المتدرّبون

57
00:05:37,340 --> 00:05:40,010
.تمرينكم الأخير، وصرتم الآن جنودًا مكتملين

58
00:05:40,510 --> 00:05:42,720
.رجاؤنا فيكم عظيم

59
00:05:44,010 --> 00:05:45,470
...لا بأس يا هانا

60
00:05:46,350 --> 00:05:48,180
.سأحميك

61
00:05:48,510 --> 00:05:49,520
...فرانز

62
00:05:53,390 --> 00:05:55,150
هل أنت بخير يا أرمين؟

63
00:05:55,860 --> 00:05:57,570
.أ-أنا بخير

64
00:05:57,980 --> 00:06:00,280
.سأتجاوز هذا قريبًا

65
00:06:00,690 --> 00:06:02,400
.لـ-لكنّنا في وضع لا نحسد عليه

66
00:06:02,400 --> 00:06:07,120
لا نملك حاليًّا الوسائل الضّروريّة
...لإغلاق الفجوة ذات الأمتار الثّمانية

67
00:06:07,490 --> 00:06:12,660
لم نتمكّن حتّى من إخراج ذلك
!الجلمود قرب البوّاب الأماميّة

68
00:06:13,870 --> 00:06:17,960
سيكون علينا التّخلّي عن البلدة
.بما أنّنا لا نستطيع إغلاق الفجوة

69
00:06:21,960 --> 00:06:25,590
!إنّها مسألة وقت فحسب قبل أن تخترق سور روز

70
00:06:26,470 --> 00:06:27,680
،إضافة لذلك

71
00:06:28,100 --> 00:06:32,020
!بإمكانها القضاء على البشريّة وقتما تشاء على أيّ حال

72
00:06:32,350 --> 00:06:32,980
!أرمين

73
00:06:34,230 --> 00:06:35,230
...اهدأ

74
00:06:35,560 --> 00:06:36,650
.الأمور مختلفة الآن

75
00:06:37,270 --> 00:06:40,190
!لن تهزم العمالقة البشريّة بعد الآن

76
00:06:45,240 --> 00:06:46,280
.أنا آسف

77
00:06:47,280 --> 00:06:48,370
...أنا بخير

78
00:07:04,550 --> 00:07:07,590
مهلاً، هل أنت منتبه؟

79
00:07:08,590 --> 00:07:09,390
...انظر

80
00:07:09,640 --> 00:07:12,020
.فزتُ ثانية

81
00:07:13,140 --> 00:07:16,980
،أنا كريم كفاية لألعب معك كلّ شهر

82
00:07:16,980 --> 00:07:20,610
.لكنّك لا تتحسّن أبدًا يا بيكسيس

83
00:07:20,900 --> 00:07:25,150
.لا أزال لا أضاهيك أيّها الماركيز بارت

84
00:07:29,530 --> 00:07:34,290
ألست القائد الأعلى الّذي يشرف على المنطقة الجنوبيّة؟

85
00:07:37,540 --> 00:07:42,170
أنّى لك أن تهزم العمالقة بذلك
المستوى من الذّكاء والمهارة؟

86
00:07:42,170 --> 00:07:43,590
!أيّها القائد بيكسيس

87
00:07:43,880 --> 00:07:44,920
!رسالة عاجلة

88
00:07:45,420 --> 00:07:47,380
—كيف تجرؤ على مقاطعة لعبـ

89
00:07:47,380 --> 00:07:49,590
.ظهر العملاق الضّخم في تروست

90
00:07:50,390 --> 00:07:52,220
!لقد دمّر البوّابة

91
00:08:06,280 --> 00:08:08,490
...هذا شراب ممتاز

92
00:08:08,820 --> 00:08:12,740
.سيكون شرفًا لي أخذه معي للمعركة

93
00:08:14,160 --> 00:08:15,580
...مـ-مهلاً

94
00:08:15,580 --> 00:08:17,120
!انتظر يا بيكسيس

95
00:08:18,710 --> 00:08:21,670
!بيكسيس! تمهّل رجاءً

96
00:08:21,880 --> 00:08:24,250
.لن أسمح لك بالمغادرة

97
00:08:24,960 --> 00:08:29,720
!عليك جمع قوّاتك والدّفاع عن منطقتي

98
00:08:30,090 --> 00:08:32,600
ذلك هو واجبك، أليس كذلك؟

99
00:08:35,350 --> 00:08:36,970
،أيّها الماركيز بارت

100
00:08:36,970 --> 00:08:41,980
.يخاطر رجالي بأرواحهم في تروست الآن

101
00:08:41,980 --> 00:08:44,320
.أيّها القائد، سأجهّز حصانك

102
00:08:45,360 --> 00:08:48,990
.ومن المرجّح أنّ العديد منهم قد فقدوا أرواحهم

103
00:08:49,490 --> 00:08:52,660
وأعداد أكثر يموتون في هذه اللّحظة
.بينما نخوض نحن هذا النّقاش

104
00:08:53,450 --> 00:08:56,490
.حياتهم ليست ذات قيمة... دعهم يموتون

105
00:08:57,200 --> 00:08:59,250
.كما أنّك لم تفز حتّى في الشّطرنج

106
00:08:59,250 --> 00:09:04,340
.لن يحقّق تواجدك في المعركة أيّ شيء

107
00:09:04,340 --> 00:09:06,170
.لا تقلق نفسك أيّها الماركيز

108
00:09:07,050 --> 00:09:09,260
،في معركة حقيقيّة ضدّ العمالقة

109
00:09:09,760 --> 00:09:12,800
.ليس من الضّروريّ على القائد أن يخسر قصدًا

110
00:09:15,350 --> 00:09:16,600
.هذا يكفي

111
00:09:17,850 --> 00:09:19,140
،أيّها الماركيز بارت

112
00:09:19,520 --> 00:09:24,020
.تمتّع بيوم هانئ رجاءً، كما تفعل في أيّ يوم آخر

113
00:09:27,030 --> 00:09:28,070
...مهلاً

114
00:09:29,190 --> 00:09:33,200
!بيكسيس! عد يا بيكسيس

115
00:09:33,490 --> 00:09:35,280
!بيكسيس

116
00:09:37,160 --> 00:09:42,170
الجانب                               الأمام

117
00:09:37,160 --> 00:09:42,170
أثناء الاستعمال

118
00:09:37,160 --> 00:09:47,170
:معلومات يمكننا مشاركتها حتّى الآن

119
00:09:48,170 --> 00:09:50,840
!اتّبعوا تدريبكم! وانفصلوا لمجموعات

120
00:09:50,840 --> 00:09:53,050
،تحت أوامر الحامية

121
00:09:53,050 --> 00:09:55,260
ستقومون بإمداد المقاتلين وإيصال الأوامر

122
00:09:55,260 --> 00:09:57,850
!وقتل العمالقة

123
00:09:58,390 --> 00:10:00,930
!ستُشكّل قوّات الاعتراض الخاصّة بالحامية الطّليعة

124
00:10:00,930 --> 00:10:08,440
حرس الطّليعة

125
00:10:01,480 --> 00:10:04,440
وسيتشكّل الحرس الأوسط من
!متدرّبين بقيادة فريق الإمدادات

126
00:10:01,600 --> 00:10:08,440
الحرس الأوسط

127
00:10:04,520 --> 00:10:08,070
.وستشكّل قوّات نخبة الحامية حرس السّاقة

128
00:10:04,770 --> 00:10:08,440
حرس السّاقة

129
00:10:08,440 --> 00:10:12,780
كما أنّ المبعوثين قد أبلغونا
.أنّ فريق التّقدّم قد تمّ القضاء عليه

130
00:10:13,650 --> 00:10:15,240
،كما أنّ البوّابة الخارجيّة قد اختُرقت

131
00:10:15,240 --> 00:10:17,330
.ودخلت العمالقة للمدينة

132
00:10:17,830 --> 00:10:20,910
بعبارة أخرى، قد يظهر العملاق المدرّع

133
00:10:21,250 --> 00:10:25,290
!في أيّ وقت الآن لتدمير البوّابة الدّاخليّة

134
00:10:26,630 --> 00:10:27,670
.مستحيل

135
00:10:27,670 --> 00:10:28,710
...غير ممكن

136
00:10:29,460 --> 00:10:32,010
...إن فقدنا روز أيضًا

137
00:10:32,010 --> 00:10:33,550
!هدوء

138
00:10:34,090 --> 00:10:36,430
.تواجهها الطّليعة الآن بينما نتحدّث

139
00:10:36,930 --> 00:10:39,390
:لدينا هدف واحد لا ثاني له في قتالنا هذا

140
00:10:39,390 --> 00:10:43,940
الدّفاع عن سور روز بأرواحنا
!إلى أن تكتمل عمليّة الإخلاء

141
00:10:44,640 --> 00:10:47,020
،وأيضًا، كما تعلمون جيّدًا

142
00:10:47,020 --> 00:10:49,320
.الهجر في وجه العدوّ جريمة عقوبتها الموت

143
00:10:49,820 --> 00:10:52,280
!انقشوا هذا في أذهانكم، وقاتلوا حتّى الرّمق الأخير

144
00:10:52,280 --> 00:10:53,240
!انصراف

145
00:10:53,530 --> 00:10:54,610
!حاضر

146
00:11:00,330 --> 00:11:01,740
لماذا اليوم؟

147
00:11:02,370 --> 00:11:04,540
...كنتُ سأكون في الدّاخل غدًا

148
00:11:07,330 --> 00:11:08,420
هل أنت بخير؟

149
00:11:14,420 --> 00:11:16,720
...لا... لا، لا

150
00:11:16,720 --> 00:11:19,260
!لا، لا... لا

151
00:11:24,430 --> 00:11:25,350
.أنت في طريقي

152
00:11:26,440 --> 00:11:28,230
مهلاً يا جان... ما الخطب؟

153
00:11:28,230 --> 00:11:29,770
أتسألني ما الخطب؟

154
00:11:30,150 --> 00:11:33,190
!لا رغبة لي في الموت على عكسك أنت

155
00:11:33,530 --> 00:11:36,400
،بما أنّك أردت الانضمام لفيلق الاستطلاع

156
00:11:36,400 --> 00:11:39,740
!فأنا واثق أنّك جاهز لتصبح طعام عمالقة في أيّ وقت

157
00:11:39,950 --> 00:11:42,410
!لكنّني سأنضمّ للدّاخل غدًا

158
00:11:42,410 --> 00:11:43,240
!اهدأ

159
00:11:43,240 --> 00:11:45,200
أيفترض بي التزام الهدوء والموت؟

160
00:11:45,200 --> 00:11:46,290
!كلاّ

161
00:11:46,290 --> 00:11:47,250
لا تنسَ

162
00:11:48,120 --> 00:11:50,590
!تلك السّنوات الثّلاث الّتي تحمّلناها في الجحيم

163
00:11:52,340 --> 00:11:55,470
،في السّنوات الثّلاث الماضية
...كدنا نموت مرّات عدّة

164
00:11:55,970 --> 00:11:57,630
.وبعضنا قد مات بالفعل

165
00:11:58,090 --> 00:12:00,680
...والبعض هرب، والبعض الآخر طُرد

166
00:12:01,470 --> 00:12:03,260
!لكنّنا نجحنا

167
00:12:03,560 --> 00:12:04,560
ألم نفعل؟

168
00:12:05,020 --> 00:12:07,440
!لذلك بإمكاننا النّجاة في هذا اليوم

169
00:12:09,350 --> 00:12:13,400
ستنجو اليوم وستذهب للدّاخل غدًا، صحيح؟

170
00:12:18,650 --> 00:12:19,660
.سُحقًا

171
00:12:21,820 --> 00:12:23,080
!لنذهب يا داز

172
00:12:23,530 --> 00:12:25,040
!كفاك بكاءً

173
00:12:25,750 --> 00:12:26,700
...حسنًا

174
00:12:27,460 --> 00:12:28,250
...إرين

175
00:12:29,500 --> 00:12:32,420
.عندما يشتدّ وطيس القتال، جدني

176
00:12:32,420 --> 00:12:33,540
ماذا؟

177
00:12:33,540 --> 00:12:35,380
!أنت وأنا في فريقين مختلفين

178
00:12:36,010 --> 00:12:38,800
.ستنهار الخطط في فوضى المعركة

179
00:12:39,470 --> 00:12:40,970
.لكنّني سأحميك

180
00:12:40,970 --> 00:12:42,180
—ما الّذي تقو

181
00:12:42,180 --> 00:12:43,510
...أيّتها المتدرّبة أكرمان

182
00:12:44,470 --> 00:12:46,520
.تمّ نقلك للسّاقة على وجه الخصوص

183
00:12:46,520 --> 00:12:47,430
.اتبعيني

184
00:12:47,430 --> 00:12:50,440
!لـ-لكنّني سأعرقلهم فحسب

185
00:12:51,600 --> 00:12:53,820
.لم أطلب رأيك

186
00:12:54,440 --> 00:12:55,940
.عمليّة الإخلاء متخلّفة

187
00:12:56,400 --> 00:12:58,990
نحتاج لأكثر عدد من الجنود الموهوبين
.للإشراف على المدنيّين قدر الإمكان

188
00:12:59,450 --> 00:13:00,360
...لـ-لكن

189
00:13:00,360 --> 00:13:01,110
!مهلًا

190
00:13:02,370 --> 00:13:03,950
...يكفي يا ميكاسا

191
00:13:04,620 --> 00:13:06,490
!لا تهلعي أنت أيضًا

192
00:13:06,910 --> 00:13:08,870
.تواجه البشريّة خطر الزّوال

193
00:13:09,250 --> 00:13:11,710
!لا يهمّ ما ترغبين به أنت

194
00:13:16,250 --> 00:13:17,300
.أنا آسفة

195
00:13:17,840 --> 00:13:19,590
.كان تفكيري مشوّشًا

196
00:13:22,180 --> 00:13:25,010
.لكن لديّ طلب واحد

197
00:13:27,890 --> 00:13:30,230
.أرجوك... لا تمت

198
00:13:37,440 --> 00:13:39,900
.لن أموت

199
00:13:40,820 --> 00:13:42,950
.لا يمكنني الموت هنا

200
00:13:45,740 --> 00:13:49,910
.ما زلت أجهل حقيقة العالم بالفعل

201
00:13:53,500 --> 00:13:55,790
لا تذكر الوثائق التّاريخيّة الباقية

202
00:13:55,790 --> 00:13:58,710
.أيّ شيء عن أصول العمالقة

203
00:13:59,130 --> 00:14:01,050
.معرفتنا بها قليلة جدًّا

204
00:14:01,880 --> 00:14:05,180
كلّ المعلومات الّتي لدينا عنها

205
00:14:05,180 --> 00:14:08,180
.مصدرها تقارير أعدّها فيلق الاستطلاع

206
00:14:09,100 --> 00:14:12,850
.لم يوجد أيّ دليل عن أنّ ذكاءها يقارن بذكائنا

207
00:14:13,310 --> 00:14:17,730
.وبالتّالي، باءت كلّ محاولاتنا للتّواصل معها بالفشل

208
00:14:18,860 --> 00:14:20,860
تختلف بنية العملاق الجسديّة

209
00:14:20,860 --> 00:14:23,320
.اختلافًا جوهريًّا عن بنية بقيّة المخلوقات

210
00:14:23,990 --> 00:14:27,870
فهي تفتقر للأعضاء التّناسليّة
.وطريقة تكاثرها تظلّ مجهولة

211
00:14:28,410 --> 00:14:31,000
.ولكن، يبدو معظمها من الذّكور

212
00:14:31,870 --> 00:14:34,330
.حرارة أجسامها مرتفعة بشكل مفرط

213
00:14:34,710 --> 00:14:39,590
ولسبب مجهول، لا تبدي أيّ اهتمام
.بأيّ مخلوقات أخرى غير البشر

214
00:14:41,170 --> 00:14:44,630
.يبدو أن هدفها الوحيد في الحياة هو التهام البشر

215
00:14:44,970 --> 00:14:48,010
ولكن نظرًا لأنّها عاشت في بيئة

216
00:14:48,010 --> 00:14:50,930
،تخلوا من البشر لأزيد من قرن من الزّمن

217
00:14:51,520 --> 00:14:55,520
.يمكننا أن نفترض أنّ لا حاجة لها للأكل إطلاقًا

218
00:14:56,520 --> 00:14:57,560
،بعبارة أخرى

219
00:14:57,560 --> 00:15:02,240
نعتقد أنّ هدفها من التهام البشر
.ليس للتّقوّت، بل للقتل فحسب

220
00:15:03,820 --> 00:15:07,990
،أمّا بالنّسبة لسبب تشكيلها خطرًا على البشريّة

221
00:15:08,700 --> 00:15:11,450
.فإنّ حيوّيتها العالية هي العامل الرّئيسيّ

222
00:15:12,450 --> 00:15:15,960
،امتلكت البشريّة تقنيات المدافع منذ عصور القديمة

223
00:15:15,960 --> 00:15:18,380
.لكنّها أثبتت عدم جدارتها

224
00:15:18,960 --> 00:15:21,460
.لن موتت العمالقة وإن قُطعت رؤوسها

225
00:15:22,260 --> 00:15:23,840
،ورغم أنّ هذا قد لا يصّح في كلّ الأحوال

226
00:15:24,260 --> 00:15:27,890
إلاّ أنّها قادرة على تجديد رؤوسها
.خلال دقيقة إلى دقيقتين

227
00:15:28,090 --> 00:15:29,260
...مستحيل

228
00:15:29,260 --> 00:15:31,470
.يُعتبر حجمها بحدّ ذاته مشكلة

229
00:15:31,470 --> 00:15:34,350
سيّدي، هل يعني هذا أنّ العمالقة منيعة؟

230
00:15:35,940 --> 00:15:37,440
.ليست منيعة

231
00:15:37,980 --> 00:15:40,110
.ثمّة طريقة واحدة لهزيمتها

232
00:15:41,110 --> 00:15:42,320
.استهدفوا هذه المنطقة

233
00:15:43,440 --> 00:15:46,320
،سيمنعها أيّ ضرر حادّ لهذه المنطقة من التّجدّد

234
00:15:46,320 --> 00:15:48,570
.وستموت بعدها

235
00:15:49,450 --> 00:15:53,410
.بالتّالي، نستعمل سيفين لنزع لحمها

236
00:15:54,370 --> 00:15:57,040
،إن أمكننا استهداف تلك النّقطة الحيويّة

237
00:15:57,540 --> 00:16:01,590
.فستقتلونها قبل أن تحظى بوقت للتّجدّد

238
00:16:09,680 --> 00:16:10,930
...أخبرني يا أرمين

239
00:16:11,600 --> 00:16:13,850
أليست هذه فرصة كبيرة؟

240
00:16:15,220 --> 00:16:17,480
،إن نجحنا في هذه العمليّة

241
00:16:17,890 --> 00:16:20,020
،قبل حتّى أن ننضمّ لفيلق الاستطلاع

242
00:16:20,020 --> 00:16:24,070
!فسنرتقي بسرعة في المراتب بكلّ تأكيد

243
00:16:30,990 --> 00:16:33,370
.نعم، معك حقّ

244
00:16:34,040 --> 00:16:35,540
،لنكون واضحين فحسب

245
00:16:35,540 --> 00:16:38,710
يرغب الكثير من الأشخاص الانضمام
.لفيلق الاستطلاع في هذا الوقت

246
00:16:39,170 --> 00:16:43,040
.تقدّمت عليّ قبل قليل. لكن لن يتكرّر ذلك

247
00:16:43,040 --> 00:16:44,500
أتظنّ ذلك فعلاً يا توماس؟

248
00:16:45,170 --> 00:16:47,590
.لنرَ إذًا من سيقتل عمالقة أكثر

249
00:16:48,300 --> 00:16:49,760
...لا تغشّوا في الأرقام إذًا

250
00:16:49,760 --> 00:16:51,470
!أيّها الفريق 34، تقدّموا

251
00:16:51,470 --> 00:16:52,850
!ادعموا الطّليعة

252
00:16:54,510 --> 00:16:55,970
!حسنًا، هيّا بنا

253
00:17:20,330 --> 00:17:21,750
!انظروا لكلّ تلك العمالقة

254
00:17:22,330 --> 00:17:24,460
!هُزمت الطّليعة بالكامل

255
00:17:24,920 --> 00:17:26,170
ما الّذي يفعلونه؟

256
00:17:26,170 --> 00:17:28,210
رغم كلّ تفاخرهم؟

257
00:17:28,920 --> 00:17:31,260
،كنت أعرف أنّ الأمر لن يكون سهلاً

258
00:17:31,760 --> 00:17:33,180
...لكنّ هذا

259
00:17:34,470 --> 00:17:35,560
!عملاق شاذّ

260
00:17:36,560 --> 00:17:37,520
!توقّف

261
00:17:54,660 --> 00:17:55,830
ماذا؟

262
00:18:20,890 --> 00:18:22,600
!كيف تجرؤ؟

263
00:18:23,230 --> 00:18:23,980
!إرين

264
00:18:23,980 --> 00:18:25,690
!توقّف! لا تذهب وحدك

265
00:18:29,070 --> 00:18:30,940
!انتظر

266
00:18:32,030 --> 00:18:33,570
...سأثأر لتوماس

267
00:18:34,490 --> 00:18:37,410
!لن أسمح لك... لن أسمح لك بالإفلات

268
00:18:48,750 --> 00:18:50,960
!إرين

269
00:19:07,860 --> 00:19:08,730
!توقّف

270
00:19:09,110 --> 00:19:10,400
!توقّف أرجوك

271
00:19:17,370 --> 00:19:19,740
...لماذا أنا

272
00:19:20,700 --> 00:19:24,250
أشاهد أصدقائي يُلتهمون؟

273
00:19:31,800 --> 00:19:32,670
...لماذا

274
00:19:33,170 --> 00:19:34,720
...يعجز جسدي

275
00:19:35,260 --> 00:19:36,550
عن الحركة؟

276
00:19:47,350 --> 00:19:48,190
...أ

277
00:19:48,480 --> 00:19:49,440
...أرمين

278
00:19:51,230 --> 00:19:55,400
!إرين

279
00:19:57,360 --> 00:19:58,870
ما الأمر يا أرمين؟

280
00:19:58,870 --> 00:20:01,950
...كان جدّي يُخفي هذا

281
00:20:02,200 --> 00:20:04,910
!كتاب عن العالم الخارجيّ

282
00:20:05,620 --> 00:20:07,790
عن العالم الخارجيّ؟

283
00:20:08,170 --> 00:20:10,210
!لا يُفترض أن تحوز على ذلك

284
00:20:10,880 --> 00:20:12,380
.ستعتقلك الشّرطة العسكريّة

285
00:20:12,380 --> 00:20:15,210
...انس ذلك الآن

286
00:20:15,210 --> 00:20:17,880
ذُكر أنّ معظم العالم مغطّى

287
00:20:17,880 --> 00:20:20,350
."بسطح مائيّ ضخم يُدعى "البحر

288
00:20:20,600 --> 00:20:23,260
!وكلّه عبارة عن مياه مالحة

289
00:20:23,260 --> 00:20:24,560
مالحة؟

290
00:20:24,970 --> 00:20:28,390
!مستحيل! يساوي الملح ثروة

291
00:20:28,390 --> 00:20:30,980
.لكان التّجّار قد أخذوه بالكامل

292
00:20:30,980 --> 00:20:33,780
!إنّه أضخم بكثير من أن يُؤخذ كاملاً

293
00:20:33,780 --> 00:20:35,110
...ذلك مستحيل

294
00:20:35,990 --> 00:20:38,070
...ثمّة المزيد

295
00:20:38,740 --> 00:20:41,410
!مياه ملتهبة! أراضٍ متجمّدة

296
00:20:41,410 --> 00:20:42,620
!حقول من الرّمال بيضاء كبياض الثّلج

297
00:20:43,160 --> 00:20:44,700
أنا واثق أنّ العالم الخارجيّ

298
00:20:44,700 --> 00:20:47,080
!أكبر بكثير من العالم داخل الأسوار

299
00:20:48,210 --> 00:20:50,040
...العالم الخارجيّ

300
00:20:50,710 --> 00:20:51,630
...وأيضًا

301
00:20:51,630 --> 00:20:53,630
ما زال هذا سرًّا، صحيح؟

302
00:20:54,000 --> 00:20:58,260
.لكنّ أبي وأمّي قالا أنّهما سيذهبان خارج الأسوار قريبًا

303
00:20:59,130 --> 00:21:01,090
!العالم الخارجيّ

304
00:21:01,470 --> 00:21:02,680
...اسمع يا إرين

305
00:21:03,510 --> 00:21:07,600
ألن يكون من الرّائع لو استطعنا يومًا ما
الذّهاب لاكتشاف العالم الخارجيّ أيضًا؟

306
00:21:27,120 --> 00:21:27,910
!إرين

307
00:21:29,830 --> 00:21:32,880
...لا يمكنني الموت هنا

308
00:21:35,880 --> 00:21:38,210
...اسمع يا أرمين

309
00:21:39,590 --> 00:21:42,840
.أخبرتني عن العالم الخارجيّ

310
00:21:44,140 --> 00:21:45,140
...لذلك

311
00:21:46,220 --> 00:21:49,810
...سأخرج إلى ذلك العالم

312
00:21:52,230 --> 00:21:54,150
!إرين! أسرع

313
00:22:19,130 --> 00:22:22,130
...يُتبع

314
00:23:53,810 --> 00:23:55,390
.أمطار تهطل فجأة

315
00:23:55,980 --> 00:23:57,560
.صوت المطر الخافت

316
00:23:58,190 --> 00:23:59,610
.الهواء الرّطب

317
00:24:00,570 --> 00:24:02,780
،ورائحة المطر الحلوة على الدّوام

318
00:24:03,070 --> 00:24:06,240
.تجعل ميكاسا تتذكّر حدثًا شنيعًا من ماضيها