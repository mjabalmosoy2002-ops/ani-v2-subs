1
00:00:00,830 --> 00:00:03,500
!انتباه

2
00:00:04,630 --> 00:00:09,050
.سأشرح الآن خطّة استعادة تروست

3
00:00:09,510 --> 00:00:11,420
دعوني أقدّم لكم

4
00:00:12,380 --> 00:00:15,760
.إرين ييغر من فيلق المتدرّبين

5
00:00:17,180 --> 00:00:19,850
إنّه نتيجة مشروع بالغ السّرّيّة

6
00:00:19,850 --> 00:00:22,600
.يهدف لتحويل البشر لعمالقة

7
00:00:23,390 --> 00:00:25,270
،سوف يتحوّل إلى عملاق

8
00:00:25,270 --> 00:00:28,400
،ويحمل جلمودًا ضخمًا قرب البوّابة المدّمرة

9
00:00:28,400 --> 00:00:32,110
.وسيأخذه إلى الفجوة ويُغلقها به

10
00:00:32,700 --> 00:00:34,740
وسيكون دوركم في هذا

11
00:00:34,740 --> 00:00:40,120
!هو حمايته من العمالقة بينما ينقل هو الجلمود

12
00:00:40,580 --> 00:00:42,620
،ولكن عندما تنجح هذه العمليّة

13
00:00:43,290 --> 00:00:48,590
ستكون البشريّة قد استعادت أراضيها
.من العمالقة لأوّل مرّة على الإطلاق

14
00:00:49,500 --> 00:00:57,180
،مقارنة بكلّ ما خسرته البشريّة
.قد يبدو هذا انتصارًا واهنًا

15
00:00:58,180 --> 00:01:05,350
لكن بالنّسبة للبشريّة، ستكون تلك الخطوة
!تقدّمًا عظيمًا في هجومنا على العمالقة

16
00:01:19,910 --> 00:01:22,500
إرين، هل تعرف من أكون؟

17
00:01:22,500 --> 00:01:23,870
!هذه أنا ميكاسا

18
00:01:24,210 --> 00:01:26,040
!فرد من عائلتك

19
00:01:26,670 --> 00:01:28,040
!ابتعدي يا أكرمان

20
00:01:32,050 --> 00:01:33,510
ما هذا؟

21
00:01:33,510 --> 00:01:36,130
!إنه يشبه أيّ عملاق غبيّ آخر

22
00:01:36,510 --> 00:01:37,720
.سأغيّر الخطّة

23
00:01:38,090 --> 00:01:41,180
.سنحمي ييغر من العمالقة إلى أن نستطيع استعادته

24
00:01:42,100 --> 00:01:44,480
.إنّه لا يزال قيّمًا كأحد آمال البشريّة الأخيرة

25
00:01:44,980 --> 00:01:47,020
.لا يمكننا التّخلّي عنه هكذا فحسب

26
00:01:50,020 --> 00:01:51,110
أين أنا؟

27
00:01:55,150 --> 00:01:56,320
أنا في المنزل؟

28
00:01:58,740 --> 00:01:59,490
!جان

29
00:02:00,070 --> 00:02:02,330
لماذا لا يستعمل عدّة المناورة؟

30
00:02:03,620 --> 00:02:06,460
مستحيل... أهي معطّلة؟

31
00:02:07,120 --> 00:02:08,580
!سأفكّر في حلّ ما

32
00:02:08,580 --> 00:02:09,500
!ميكاسا

33
00:02:10,170 --> 00:02:11,460
ماذا حلّ بالخطّة؟

34
00:02:11,460 --> 00:02:12,960
.لقد فشلت

35
00:02:12,960 --> 00:02:15,920
.يقاتل الجميع لأنّنا لا نستطيع ترك إرين

36
00:02:16,470 --> 00:02:18,470
...لكن هنالك العديد منها

37
00:02:18,760 --> 00:02:21,100
.ستقضي علينا العمالقة قريبًا

38
00:02:24,140 --> 00:02:26,230
،المنطقة خلف العنق

39
00:02:26,680 --> 00:02:29,980
.عشرة سنتيمترات عرضًا، ومتر واحد للأعلى

40
00:02:32,480 --> 00:02:34,820
!إرين... أجبني

41
00:02:35,570 --> 00:02:39,820
.كنتَ تعلم أنّ الجحيم خلف الأسوار بخطوة

42
00:02:40,910 --> 00:02:45,450
لذلك لماذا أردت الذّهاب؟

43
00:02:48,160 --> 00:02:49,460
لماذا؟

44
00:02:51,040 --> 00:02:53,880
!لأنّني ولدت في هذا العالم

45
00:03:03,350 --> 00:03:04,220
!إرين

46
00:04:53,040 --> 00:04:54,330
...سُحقًا

47
00:04:54,330 --> 00:04:56,670
لماذا أنا الّذي يؤخّر تقدّمنا؟

48
00:05:10,310 --> 00:05:12,980
هل يمكنني فعلاً التّفكير في حلّ ما؟

49
00:05:19,400 --> 00:05:20,820
!انتهى أمرنا أيّتها القائد

50
00:05:22,400 --> 00:05:24,700
!نحن آخر من بقي

51
00:05:26,660 --> 00:05:28,070
!تراجعي إلى الجلمود

52
00:05:33,910 --> 00:05:35,040
ما الوضع؟

53
00:05:36,040 --> 00:05:37,170
،خمسة عمالقة

54
00:05:37,170 --> 00:05:38,210
.قادمة من البوّابة

55
00:05:50,050 --> 00:05:53,470
!لا أطيق الانتظار حتّى تختفي! مستحيل

56
00:05:53,720 --> 00:05:54,730
!جان

57
00:05:55,350 --> 00:05:56,940
.عدّة مناورته معطّلة بالفعل

58
00:05:57,810 --> 00:05:58,770
ما الخطب؟

59
00:06:01,570 --> 00:06:02,820
...سُحقًا

60
00:06:02,820 --> 00:06:04,110
ما الخطب؟

61
00:06:04,110 --> 00:06:05,490
...لا تعبثي معي

62
00:06:05,490 --> 00:06:06,570
!ليس في وقت كهذا

63
00:06:09,570 --> 00:06:10,660
!جان، اهدأ

64
00:06:14,620 --> 00:06:15,710
ماركو؟

65
00:06:15,910 --> 00:06:16,960
ما الّذي تفعلونه؟

66
00:06:29,140 --> 00:06:30,010
.يا إلهي

67
00:06:30,300 --> 00:06:32,100
!لا تكن مزعجًا هكذا

68
00:06:42,860 --> 00:06:46,900
سُحقًا، لماذا الزّناد عالق بشدّة هكذا؟

69
00:06:50,450 --> 00:06:51,450
!جان

70
00:06:57,790 --> 00:06:59,170
!ما الّذي تفعله؟

71
00:06:59,620 --> 00:07:00,880
!لا يحقّ لك قول ذلك

72
00:07:00,880 --> 00:07:02,000
!اخرج من هناك بسرعة

73
00:07:34,830 --> 00:07:36,410
!أنت مجنون

74
00:07:36,410 --> 00:07:37,750
!أنت المجنون هنا

75
00:07:37,750 --> 00:07:39,370
...لا أصدّق أنّني نجوت من ذلك

76
00:07:41,580 --> 00:07:42,670
.انظروا

77
00:08:17,830 --> 00:08:18,830
...إرين

78
00:08:19,410 --> 00:08:20,620
!ميكاسا

79
00:08:22,460 --> 00:08:23,290
!أرمين

80
00:08:24,040 --> 00:08:25,880
!فاز إرين

81
00:08:25,880 --> 00:08:29,010
!إنّه يحاول الآن إتمام المهمّة

82
00:08:29,380 --> 00:08:32,630
،إن استطعنا حمايته حتّى يصل للبوّابة

83
00:08:32,840 --> 00:08:34,260
!فسنفوز

84
00:08:39,720 --> 00:08:41,020
!دافعوا عنه بكلّ ما لديكم

85
00:08:41,850 --> 00:08:46,360
،احموا إرين إلى أن يصل للبوّابة
!وإن كلّفكم ذلك حياتكم

86
00:08:47,110 --> 00:08:49,980
!لا تسمحوا لأيّ منها بالاقتراب منه

87
00:08:50,690 --> 00:08:51,820
!لا تدعوها تتدخّل

88
00:08:52,320 --> 00:08:54,070
!احموا إرين

89
00:08:56,700 --> 00:08:59,290
.اذهبا أنتما نحو إرين

90
00:08:59,990 --> 00:09:01,040
!هذا أمر

91
00:09:01,160 --> 00:09:02,000
أهذا مفهوم؟

92
00:09:02,790 --> 00:09:03,620
!عُلم

93
00:09:07,840 --> 00:09:08,960
...فرقة ميتابي

94
00:09:09,300 --> 00:09:10,460
ما الّذي تفعلونه؟

95
00:09:11,010 --> 00:09:13,340
!تأبى العمالقة أن تتبعنا

96
00:09:13,340 --> 00:09:16,260
!علينا الاقتراب منها إلى أن تهاجمنا

97
00:09:16,970 --> 00:09:18,850
!انظري إلى هنا يا هذه

98
00:09:18,850 --> 00:09:23,140
!إن لم تفعلي، فسأحشر نصلي في أدبارك النّتنة

99
00:09:27,110 --> 00:09:28,020
!ها هي قادمة

100
00:09:28,020 --> 00:09:29,320
!اثنان قادمان

101
00:09:29,320 --> 00:09:30,530
!اهربوا

102
00:09:30,530 --> 00:09:32,110
!اهربوا للمبنى

103
00:09:32,570 --> 00:09:33,820
...مستحيل

104
00:09:33,820 --> 00:09:36,360
.التّحرّك على الأرض أشبه بانتحار

105
00:09:36,910 --> 00:09:39,580
!لا يمكنهم القتال بدون أحصنة أو أبنية

106
00:09:39,780 --> 00:09:44,160
...كلاّ... إنّها الطّريقة الوحيدة المتبقّية الآن

107
00:09:47,670 --> 00:09:49,290
!اتبعوا فرقة ميتابي

108
00:09:50,000 --> 00:09:52,090
.أرمين، لنذهب أيضًا

109
00:09:55,130 --> 00:09:57,470
!من هنا! هنا

110
00:10:05,810 --> 00:10:10,150
...أشعر وكأنّ جسدي يُسحق

111
00:10:12,480 --> 00:10:14,690
ميكاسا؟ أرمين؟

112
00:10:15,700 --> 00:10:17,320
ما الّذي تفعلانه؟

113
00:10:17,320 --> 00:10:20,910
!ستنال منكما العمالقة إن بقيتما في الأسفل

114
00:10:21,700 --> 00:10:24,410
!هيّا أيّتها البطيئة

115
00:10:24,750 --> 00:10:26,080
!من هنا

116
00:10:28,830 --> 00:10:30,250
!مـ-مهلاً

117
00:10:31,920 --> 00:10:33,210
!ميتابي

118
00:10:39,220 --> 00:10:43,350
إذًا لماذا أردت الذّهاب للعالم خلف الأسوار؟

119
00:10:46,730 --> 00:10:50,940
،منذ الوقت الّذي وُلدنا فيه

120
00:10:51,770 --> 00:10:52,730
...ونحن أحرار

121
00:10:55,570 --> 00:10:57,400
لا يهمّ ما مدى قوّة

122
00:10:58,070 --> 00:11:00,780
...أولئك الّذين يحرموننا من تلك الحرّيّة

123
00:11:02,530 --> 00:11:07,410
...مياه ملتهبة... أراضٍ متجمّدة
!لا أهتمّ ما هي

124
00:11:08,210 --> 00:11:10,000
إنّ من يراها

125
00:11:10,710 --> 00:11:14,170
!سيكون أكثر شخص حرّ في العالم

126
00:11:16,510 --> 00:11:17,510
...قاتلوا

127
00:11:18,590 --> 00:11:21,390
!أنا عازم على التّضحية بحياتي طوعًا من أجل ذلك

128
00:11:23,430 --> 00:11:27,310
.لا يهمّ كم أنّ العالم مرعب

129
00:11:30,020 --> 00:11:34,020
!لا يهمّ كم أنّ هذا العالم قاسٍ

130
00:11:35,440 --> 00:11:36,320
...قاتلوا

131
00:11:37,570 --> 00:11:42,910
!قاتلوا

132
00:11:46,740 --> 00:11:48,250
عملاق آخر؟

133
00:11:50,290 --> 00:11:51,750
.سأهتمّ بأمره

134
00:11:54,540 --> 00:11:57,130
!ابتعد عن الطّريق

135
00:12:19,360 --> 00:12:22,360
!انطلق يا إرين

136
00:12:23,700 --> 00:12:25,160
!قاتلوا

137
00:12:50,430 --> 00:12:51,350
...رفاق

138
00:12:52,230 --> 00:12:55,100
...لم تموتوا هباءً

139
00:13:01,360 --> 00:13:06,990
!اليوم، ولأوّل مرّة، هزمت البشريّة العمالقة

140
00:13:08,160 --> 00:13:09,740
.تمّ رصد إشارة دخانيّة صفراء

141
00:13:10,370 --> 00:13:13,250
!نجحت المهمّة

142
00:13:15,080 --> 00:13:16,750
!أرسلوا التّعزيزات

143
00:13:17,710 --> 00:13:19,840
!أخلوا فريق النّخبة

144
00:13:37,190 --> 00:13:38,860
!بقيّة العمالقة تقترب

145
00:13:39,770 --> 00:13:40,860
!تسلّقوا الأسوار

146
00:13:41,400 --> 00:13:43,780
.سنخلي المكان بعد أخذنا لإرين

147
00:13:45,700 --> 00:13:46,820
أرمين؟

148
00:13:46,820 --> 00:13:47,660
كيف هو إرين؟

149
00:13:48,030 --> 00:13:50,490
!إنّه ساخن جدًّا، بالكاد أصدّق هذا

150
00:13:50,830 --> 00:13:54,290
...علينا الإسراع في تسلّق الأسوار

151
00:13:57,460 --> 00:14:00,380
.جزء من جسمه ملتحم مع العملاق

152
00:14:00,380 --> 00:14:02,000
!لا أستطيع سحبه

153
00:14:02,000 --> 00:14:03,260
.علينا أن نقوم بتقطيعه

154
00:14:04,130 --> 00:14:05,510
!مهلاً

155
00:14:17,850 --> 00:14:18,690
...إرين

156
00:14:18,690 --> 00:14:19,520
!أرمين

157
00:14:40,040 --> 00:14:41,130
ميكاسا؟

158
00:14:42,630 --> 00:14:43,500
...ذلك

159
00:14:46,760 --> 00:14:50,430
...أجنحة الحرّيّة

160
00:14:57,190 --> 00:14:59,100
.أنتم أيّها الأشقياء

161
00:14:59,980 --> 00:15:02,020
ما الّذي يحدث هنا؟

162
00:15:08,700 --> 00:15:12,410
بعد ذلك، كان الوصول المفاجئ
،لفيلق الاستطلاع ومساعدتهم

163
00:15:12,410 --> 00:15:15,370
إلى جانب جهود مهندسي الحامية

164
00:15:15,830 --> 00:15:19,620
.ما سمح لسور روز بصدّ العمالقة ثانية

165
00:15:23,130 --> 00:15:28,470
تطلّب الأمر يومًا كاملاً للقضاء على
.كلّ العمالقة المتبقّية داخل تروست

166
00:15:28,970 --> 00:15:32,930
إنّ وابل القذائف من المدافع الثّابتة
.أعلى الأسوار كان بلا نهاية

167
00:15:35,260 --> 00:15:39,560
قتلت القذائف شديدة الانفجار معظم
.العمالقة المتجمهرة عند الأسوار

168
00:15:40,060 --> 00:15:45,400
والقلّة المتبقّية من العمالقة قضت
.على يد فيلق الاستطلاع

169
00:15:47,820 --> 00:15:51,320
وتمكّنت البشريّة خلال تلك العمليّة

170
00:15:51,320 --> 00:15:55,240
من أسر عملاقين من صنف 4
.و7 أمتار على قيد الحياة

171
00:15:56,370 --> 00:15:57,370
،ولكن

172
00:15:58,250 --> 00:16:04,290
.كان ثمّة 207 بين قتيل ومفقود، و897 جريحًا

173
00:16:05,000 --> 00:16:09,300
،حقّقت البشريّة بالفعل أوّل نصر لها ضدّ العمالقة

174
00:16:09,510 --> 00:16:14,930
لكنّ الخسائر كانت أكثر ممّا قد يسمح
.لأيّ أحد بالاحتفال بذلك النّصر

175
00:16:36,410 --> 00:16:37,410
...مهلاً

176
00:16:43,670 --> 00:16:44,790
...أنت

177
00:16:45,710 --> 00:16:48,300
ماركو...؟

178
00:16:50,800 --> 00:16:51,670
،أيّها المتدرّب

179
00:16:52,180 --> 00:16:54,140
هل تعرف اسمه؟

180
00:16:54,140 --> 00:16:55,430
...عرفتُ أنّني لم أره في الجوار

181
00:16:55,800 --> 00:17:00,060
...لكن ما كان هذا ليحصل له

182
00:17:01,060 --> 00:17:02,020
،ماركو

183
00:17:02,600 --> 00:17:04,150
ماذا حدث؟

184
00:17:05,480 --> 00:17:07,230
...هـ-هل هنالك أحد

185
00:17:07,770 --> 00:17:10,780
هل هنالك من رأى كيف مات؟

186
00:17:10,780 --> 00:17:12,150
ما اسمه؟

187
00:17:12,610 --> 00:17:13,990
.أطلعني عليه إن كنت تعرف

188
00:17:18,160 --> 00:17:20,200
أتفهم أيّها المتدرّب؟

189
00:17:20,700 --> 00:17:23,540
.مرّ يومان سلفًا على إغلاق الفجوة

190
00:17:24,120 --> 00:17:27,040
.وما زلنا لم ننتهِ من جمع الجثث

191
00:17:27,670 --> 00:17:30,800
.على هذا المعدّل، قد ينتشر وباء

192
00:17:31,510 --> 00:17:34,300
.علينا تجنّب حدوث مأساة ثانية

193
00:17:34,840 --> 00:17:37,800
.لا يوجد وقت لتبكي على صديقك بعد

194
00:17:38,260 --> 00:17:39,560
أتفهم؟

195
00:17:43,810 --> 00:17:47,980
.فيلق المتدرّبين 104

196
00:17:47,980 --> 00:17:52,030
.قائد الفرقة 19، ماركو بوتّ

197
00:17:52,530 --> 00:17:54,110
ماركو إذًا؟

198
00:17:54,110 --> 00:17:55,610
.أنا سعيدة لحصولنا على اسم

199
00:17:56,410 --> 00:17:57,910
.لنعد للعمل

200
00:18:08,790 --> 00:18:11,050
ما هذا؟

201
00:18:13,460 --> 00:18:14,760
.هذا ما تقيّأه عملاق

202
00:18:15,720 --> 00:18:18,050
.إنّها لا تملك أعضاءً للهضم

203
00:18:18,050 --> 00:18:21,430
...لذلك بعد أن تأكل كلّ ما تستطيع، تتقيّأ هكذا

204
00:18:22,390 --> 00:18:23,470
...هذا

205
00:18:24,480 --> 00:18:25,440
...سُحقًا

206
00:18:25,440 --> 00:18:28,060
!من المستحيل التّعرّف على أيّ أحد هناك

207
00:18:32,480 --> 00:18:33,860
...آسفة

208
00:18:37,450 --> 00:18:38,780
.آسفة

209
00:18:39,990 --> 00:18:41,780
.لن يساعد الاعتذار بشيء

210
00:18:42,290 --> 00:18:43,830
.احزني على وفاته فحسب

211
00:19:09,850 --> 00:19:11,480
هل من أسئلة؟

212
00:19:13,480 --> 00:19:18,490
.قائد قوّة فيلق الاستطلاع الضّاربة، المقدّم إروين

213
00:19:19,780 --> 00:19:21,240
...والقائد ليفاي

214
00:19:22,780 --> 00:19:24,370
...عـ-عفوًا

215
00:19:26,160 --> 00:19:27,500
...أين

216
00:19:28,790 --> 00:19:29,960
أنا؟

217
00:19:34,630 --> 00:19:38,220
.كما ترى، إنّها زنزانة تحت الأرض

218
00:19:39,180 --> 00:19:42,350
.أنت الآن تحت وصاية الشّرطة العسكريّة

219
00:19:42,850 --> 00:19:44,560
حصلنا مؤخّرًا فقط على الإذن

220
00:19:44,560 --> 00:19:46,970
.للحديث معك

221
00:19:50,100 --> 00:19:51,310
...ذلك المفتاح

222
00:19:51,310 --> 00:19:52,310
.نعم

223
00:19:52,310 --> 00:19:53,860
.إنّه لك

224
00:19:53,860 --> 00:19:55,070
.يمكنك استعادته لاحقًا

225
00:19:55,860 --> 00:19:57,610
،قبو منزلك

226
00:19:57,610 --> 00:20:00,240
منزل الطّبيب ييغر في شيغانشينا، يحمل الإجابة

227
00:20:00,950 --> 00:20:02,820
.للغز العمالقة

228
00:20:03,070 --> 00:20:03,910
أهذا صحيح؟

229
00:20:04,620 --> 00:20:05,740
...نعم

230
00:20:05,740 --> 00:20:06,830
.أعتقد ذلك

231
00:20:07,200 --> 00:20:08,870
.هذا ما قاله أبي

232
00:20:09,500 --> 00:20:13,460
.تعاني فقدان ذاكرة ووالدك مفقود

233
00:20:13,880 --> 00:20:16,000
.كم هذا مناسب لك

234
00:20:16,460 --> 00:20:17,510
.ليفاي

235
00:20:18,170 --> 00:20:21,630
.سبق ووصلنا لاستنتاج أنّ لا سبب يدفعه للكذب

236
00:20:22,430 --> 00:20:24,640
.ما زلنا نجهل الكثير

237
00:20:24,640 --> 00:20:28,020
.لكن الآن، نريد أن نسألك ماذا تريد أن تفعل

238
00:20:29,180 --> 00:20:31,350
ماذا أريد أن أفعل؟

239
00:20:32,730 --> 00:20:34,770
،بغرض الذّهاب لمنزلك

240
00:20:35,310 --> 00:20:38,820
.علينا استعادة شيغانشينا وسور ماريا

241
00:20:40,360 --> 00:20:44,620
أبسط وأسهل طريقة لإغلاق البوّابة المحطّمة

242
00:20:45,830 --> 00:20:48,410
.هي باستعمال قوّة عملاقك

243
00:20:49,950 --> 00:20:53,290
.من المرجّح أنّ العمالقة ستحدّد مصيرنا

244
00:20:54,210 --> 00:20:57,630
العملاق الضّخم والعملاق المدرّع

245
00:20:57,630 --> 00:20:59,920
.يخضعان لنفس المبدأ مثلك أنت

246
00:21:02,130 --> 00:21:03,890
.قرارك هو المفتاح

247
00:21:04,760 --> 00:21:08,390
.المفتاح الّذي سينقذ البشريّة من اليأس

248
00:21:09,060 --> 00:21:10,220
...أنا

249
00:21:11,480 --> 00:21:12,560
أنا؟

250
00:21:17,440 --> 00:21:18,940
!سأقتلها جميعًا

251
00:21:19,610 --> 00:21:23,570
...سأمحو كلّ واحد منها
!من على وجه هذه الأرض

252
00:21:24,360 --> 00:21:27,030
.هيّا، أجب أيّها الحثالة

253
00:21:27,870 --> 00:21:29,620
ماذا تريد أن تفعل؟

254
00:21:34,870 --> 00:21:36,880
أريد أن أنضمّ لفيلق الاستطلاع

255
00:21:37,670 --> 00:21:40,050
!وأنحر العمالقة فحسب

256
00:21:42,670 --> 00:21:43,800
فعلاً؟

257
00:21:43,800 --> 00:21:45,340
.لا بأس بك

258
00:21:49,430 --> 00:21:50,560
،إروين

259
00:21:50,560 --> 00:21:52,770
.سأتحمّل مسؤوليّته

260
00:21:53,640 --> 00:21:55,350
.أخبر كبار الضبّاط بذلك

261
00:21:56,150 --> 00:21:58,770
.ليس وكأنّني أثق به

262
00:21:59,320 --> 00:22:03,950
.إن خاننا أو فقد السّيطرة على نفسه، فسأقتله على الفور

263
00:22:04,530 --> 00:22:06,700
.لا ينبغي أن يعارضوا

264
00:22:06,700 --> 00:22:09,240
.لأنّي الوحيد القادر على فعل ذلك

265
00:22:09,780 --> 00:22:11,240
.قبلتُ طلبك

266
00:22:11,870 --> 00:22:14,460
.يمكنك الانضمام إلى فيلق الاستطلاع

267
00:22:19,250 --> 00:22:22,260
...يُتبع

268
00:23:54,010 --> 00:23:55,560
.وعد حُمل عاليًا

269
00:23:56,100 --> 00:23:57,480
.أمل مُداس

270
00:23:58,020 --> 00:23:59,980
.غضب يشتعل عميقًا في الدّاخل

271
00:24:00,980 --> 00:24:04,860
وفي غشية الاضطراب، يهلوس إرين

272
00:24:04,860 --> 00:24:06,650
.بشأن كلّ ما حدث ذلك اليوم