1
00:00:01,250 --> 00:00:03,210
...في سنة 845

2
00:00:03,800 --> 00:00:09,050
ظهر العملاقان الضّخم والمدرّع

3
00:00:09,680 --> 00:00:13,560
.فجأة ودمّرا السّور، إضافة إلى الحياة الّتي عهدناها

4
00:00:16,350 --> 00:00:18,940
،هجرت البشريّة سور ماريا

5
00:00:19,520 --> 00:00:24,860
وخسرت عشرين في المائة
،من سكّانها وثُلث منطقتها

6
00:00:25,190 --> 00:00:27,320
.بغرض الانسحاب إلى سور روز

7
00:00:30,240 --> 00:00:31,620
...في السّنة 850

8
00:00:32,540 --> 00:00:37,000
.ظهر العملاق الضّخم ثانيةً واخترق السّور

9
00:00:37,460 --> 00:00:40,840
.ومرّة أخرى، عجزت البشريّة عن إيقاف غزو العمالقة

10
00:00:42,090 --> 00:00:45,550
.هلك الجنود الواحد تلو الآخر إثر هجوم العمالقة

11
00:00:46,420 --> 00:00:47,590
...وأيضًا

12
00:00:47,880 --> 00:00:50,010
!إرين! أسرع

13
00:00:54,140 --> 00:00:57,310
،التهم عملاق إرين ييغر

14
00:01:01,190 --> 00:01:05,400
لكنّ هذا الأخير عاود الظّهور
.منبثقًا من عملاق غامض

15
00:01:07,740 --> 00:01:10,320
!انتباه

16
00:01:11,160 --> 00:01:15,450
تعرّف القائد الأعلى للمناطق
الجنوبيّة دوت بيكسيس

17
00:01:15,450 --> 00:01:20,040
على الإمكانات القتاليّة لقدرة
،إرين على التّحوّل لعملاق

18
00:01:20,040 --> 00:01:23,380
.وقرّر تنفيذ خطّة متهوّرة

19
00:01:24,420 --> 00:01:27,630
سوف يتحوّل إلى عملاق، ويحمل جلمودًا ضخمًا

20
00:01:27,630 --> 00:01:30,800
.قرب البوّابة المدّمرة وسيأخذه إلى الفجوة ويُغلقها به

21
00:01:32,260 --> 00:01:34,390
،عندما تنجح هذه العمليّة

22
00:01:34,390 --> 00:01:36,140
ستكون البشريّة قد استعادت

23
00:01:36,140 --> 00:01:39,520
.أراضيها من العمالقة لأوّل مرّة على الإطلاق

24
00:01:40,390 --> 00:01:45,190
لكن بالنّسبة للبشريّة، ستكون تلك الخطوة
!تقدّمًا عظيمًا في هجومنا على العمالقة

25
00:01:48,740 --> 00:01:54,370
ولكن، بمجرّد أن بدأت، بدت العمليّة
...وكأنّها أقرب إلى الفشل بالفعل

26
00:03:36,390 --> 00:03:41,390
تمكّنّا بطريقة ما من استدراج معظم
...العمالقة إلى حافّة البلدة

27
00:03:41,770 --> 00:03:44,390
لكن على الرّغم من جهودنا
،المضنية لتجنّب القتال

28
00:03:44,640 --> 00:03:46,900
.فقدنا حوالي عشرين بالمائة من قوّاتنا

29
00:03:48,020 --> 00:03:50,020
.لن نفقدهم

30
00:03:50,780 --> 00:03:53,150
.لم يمت أولئك الجنود من تلقاء أنفسهم

31
00:03:55,360 --> 00:03:58,320
.ماتوا بسبب أوامري

32
00:03:59,870 --> 00:04:02,700
.ستحدّد هذه المعركة استمرار البشريّة

33
00:04:03,290 --> 00:04:09,130
.وللفوز بها، أنا جاهز لأوصف بالقاتل

34
00:04:26,850 --> 00:04:27,600
!أكرمان

35
00:04:40,450 --> 00:04:42,580
!مهلاً! توقّفي يا أكرمان

36
00:04:42,580 --> 00:04:44,120
!ابتعدي عنه

37
00:04:44,120 --> 00:04:46,660
إرين، هل تعرف من أكون؟

38
00:04:46,660 --> 00:04:47,870
!هذه أنا ميكاسا

39
00:04:48,460 --> 00:04:50,630
!فرد من عائلتك

40
00:04:50,920 --> 00:04:54,090
!عليك استعمال ذلك الجلمود لإغلاق الفجوة

41
00:04:55,050 --> 00:04:56,590
.فشلت المهمّة

42
00:04:57,340 --> 00:05:01,600
.علمتُ أنّه لم يكن هنالك أيّ سلاح سرّيّ

43
00:05:06,770 --> 00:05:08,730
!إرين، أنت بشريّ

44
00:05:08,730 --> 00:05:09,440
...أنت

45
00:05:10,230 --> 00:05:11,770
!ابتعدي يا أكرمان

46
00:05:26,540 --> 00:05:28,000
ما هذا؟

47
00:05:28,410 --> 00:05:30,670
!إنه يشبه أيّ عملاق غبيّ آخر

48
00:05:30,670 --> 00:05:31,330
!إرين

49
00:05:31,330 --> 00:05:32,630
!يا قائد الفريق إيان

50
00:05:33,090 --> 00:05:34,960
!يقترب عملاقان من الأمام

51
00:05:34,960 --> 00:05:37,050
.إنّهما من صنف 10 و6 أمتار

52
00:05:37,550 --> 00:05:38,930
!وهنالك آخر يقترب من الخلف أيضًا

53
00:05:38,930 --> 00:05:41,340
!يقترب واحد من صنف 20 مترًا منّا

54
00:05:43,850 --> 00:05:45,430
!إيان، علينا التّراجع

55
00:05:45,770 --> 00:05:47,020
!انظر إليه

56
00:05:47,020 --> 00:05:48,850
!من المستحيل أنّ تلك الفجوة ستُغلق

57
00:05:48,850 --> 00:05:49,940
...صحيح

58
00:05:49,940 --> 00:05:52,810
.لا خيار آخر أمامنا سوى تركه هنا

59
00:06:00,610 --> 00:06:03,530
.شوهدت إشارة دخانيّة حمراء من قوّات النّخبة

60
00:06:03,530 --> 00:06:07,330
.طرأت مشكلة خطيرة خلال تنفيذ المهمّة

61
00:06:08,040 --> 00:06:09,210
.إنّنا نموت بدون أيّ سبب

62
00:06:09,540 --> 00:06:12,420
!مات أصدقائي هباءً

63
00:06:15,380 --> 00:06:17,050
!مهلاً! انظروا هناك

64
00:06:17,210 --> 00:06:18,630
ماذا؟ ما هذا؟

65
00:06:19,590 --> 00:06:22,050
فشلت... المهمّة؟

66
00:06:22,550 --> 00:06:23,680
لماذا؟

67
00:06:28,220 --> 00:06:30,690
مهلاً يا أرمين! إلى أين تذهب؟

68
00:06:31,390 --> 00:06:32,690
،أيّها القائد بيكسيس

69
00:06:33,190 --> 00:06:35,860
.علينا استدعاؤهم للدّفاع عن البوّابة

70
00:06:36,190 --> 00:06:37,320
هل أقوم بذلك؟

71
00:06:37,320 --> 00:06:38,230
.كلاّ

72
00:06:39,150 --> 00:06:41,200
ألا يجب علينا أن نأمر قوّات النّخبة بالانسحاب؟

73
00:06:41,200 --> 00:06:42,150
.كلاّ

74
00:06:42,150 --> 00:06:45,830
.واصلوا استدراج العمالقة إلى حافّة البلدة

75
00:06:46,990 --> 00:06:50,710
.تتمتّع قوّات النّخبة بسلطة تقديريّة تكتيكيّة كاملة

76
00:06:51,210 --> 00:06:53,460
.إنّهم ليسوا مجرّد جنود ممتازين فحسب

77
00:06:53,460 --> 00:06:57,210
.إنّهم نخبة النّخبة، وعُهد لهم بمصير البشريّة

78
00:06:58,090 --> 00:07:01,760
.لا يسعني تخيّل أنّهم قد يستسلمون بهذه السّهولة

79
00:07:02,220 --> 00:07:05,430
...سيقاتلون حتّى النّهاية

80
00:07:06,390 --> 00:07:09,720
.لذلك فإنّ موت من سقطوا لن يكون هباءً

81
00:07:10,810 --> 00:07:12,690
مهلاً، ما الخطب؟

82
00:07:12,690 --> 00:07:13,980
!أصدر الأمر

83
00:07:13,980 --> 00:07:15,900
!إيان، هذه ليست غلطتك

84
00:07:16,310 --> 00:07:18,230
.احتمال نجاح الخطّة كان بعيدًا من الأساس

85
00:07:18,770 --> 00:07:20,150
.علِم الجميع ذلك

86
00:07:20,150 --> 00:07:23,650
!كانت تستحقّ المحاولة، وقد بذلنا كلّ ما بوسعنا

87
00:07:24,410 --> 00:07:27,030
.هيّا! ستتسلّق فرقتنا الأسوار

88
00:07:30,120 --> 00:07:31,000
!مهلاً

89
00:07:31,830 --> 00:07:32,830
...تمهّلي

90
00:07:32,830 --> 00:07:34,120
.اهدئي يا أكرمان

91
00:07:34,710 --> 00:07:37,460
.ريكو، ستتولّى فرقتك عملاق الـ12 مترًا خلفنا

92
00:07:38,130 --> 00:07:40,510
.وستتولّى فرقتي وفرقة ميتابي العملاقين في الأمام

93
00:07:40,510 --> 00:07:41,670
ماذا؟

94
00:07:41,670 --> 00:07:43,880
!أنا من اُختير ليكون المسؤول

95
00:07:43,880 --> 00:07:45,590
!اخرسي واتّبعي الأوامر

96
00:07:46,640 --> 00:07:49,350
.لا يمكننا ترك ييغر بلا حماية

97
00:07:50,560 --> 00:07:52,060
.سأغيّر الخطّة

98
00:07:52,060 --> 00:07:55,390
.سنحمي ييغر من العمالقة إلى أن نستطيع استعادته

99
00:07:56,060 --> 00:07:58,310
.إنّه لا يزال قيّمًا كأحد آمال البشريّة الأخيرة

100
00:07:58,940 --> 00:08:01,030
.لا يمكننا التّخلّي عنه هكذا فحسب

101
00:08:01,650 --> 00:08:05,320
.بالإمكان استبدالنا، أمّا هو فلا

102
00:08:05,740 --> 00:08:08,450
إنّ فشل ذلك السّلاح البشريّ المعيب

103
00:08:08,450 --> 00:08:11,330
!كلّفنا سلفًا المئات من الأرواح

104
00:08:11,330 --> 00:08:15,160
أتقول أنّ علينا استعادته، لكي نعيش هذا مجدّدًا؟

105
00:08:15,160 --> 00:08:16,540
.هذا صحيح

106
00:08:16,540 --> 00:08:19,380
،علينا أن نعيد الكرّة مرارًا حسب الضّرورة
!بغضّ النّظر عن الخسارة في الأرواح

107
00:08:26,260 --> 00:08:28,390
ماذا حدث لإرين؟

108
00:08:28,850 --> 00:08:30,680
.اتّجه أرمين إلى هناك وحده

109
00:08:31,100 --> 00:08:33,180
.إنّه بخير على الأرجح

110
00:08:33,520 --> 00:08:34,600
على الأرجح؟

111
00:08:34,600 --> 00:08:35,730
.إنّه بخير

112
00:08:35,730 --> 00:08:36,480
.أنا واثق من ذلك

113
00:08:37,060 --> 00:08:38,400
.بإمكان إرين النّجاح

114
00:08:40,110 --> 00:08:44,360
.أعتقد أنّ لا فائدة من استدراج العمالقة لحافّة البلدة

115
00:08:44,360 --> 00:08:48,030
.يُعتبر أيّ قتال مع العمالقة حربَ استنزاف

116
00:08:48,030 --> 00:08:50,990
يريدون في هذه المرحلة تفادي
.أيّة خسائر لا ضرورة منها

117
00:08:53,540 --> 00:08:56,830
إذًا فإنّ كلّ من لن يستطيع النّجاة
الآن، فسيكون قد مات هباءً؟

118
00:08:57,290 --> 00:08:59,040
.في النّهاية، ستصير حربًا شاملة

119
00:08:59,040 --> 00:09:01,710
.وحتّى ذلك الحين، علينا المحافظة على قوّاتنا

120
00:09:01,710 --> 00:09:04,010
.واضح أنّ علينا التّقليل من الخسائر

121
00:09:04,670 --> 00:09:05,920
.اتّخذ الضّبّاط الكبار القرار الصّائب

122
00:09:05,920 --> 00:09:07,510
أهكذا الأمر إذًا؟

123
00:09:07,510 --> 00:09:08,760
!بالطّبع هو كذلك

124
00:09:09,590 --> 00:09:10,550
...على أيٍّ

125
00:09:10,550 --> 00:09:14,390
لنحرص كلانا على ألاّ ينتهي
.بنا المطاف كمجرّد خسائر

126
00:09:15,180 --> 00:09:17,100
إيان، هل أنت جادّ؟

127
00:09:17,100 --> 00:09:19,980
كيف يمكن للبشريّة هزيمة العمالقة بغير ذلك؟

128
00:09:19,980 --> 00:09:21,650
!ريكو، أخبريني

129
00:09:22,110 --> 00:09:24,730
هل هنالك أيّ طريقة أخرى لإخراج
أنفسنا من هذه الفوضى؟

130
00:09:25,190 --> 00:09:28,150
طريقة تحافظ على كرامتنا كبشر
!دون سقوط المزيد من الوفيات؟

131
00:09:28,450 --> 00:09:32,370
كيف لنا أن نجابه تقدّم العمالقة السّاحق علينا؟

132
00:09:32,950 --> 00:09:36,700
!وكأنّني قد أعرف طريقة لهزيمتها

133
00:09:37,410 --> 00:09:38,660
...هذا صحيح

134
00:09:39,210 --> 00:09:42,670
.لذلك فهذا كلّ ما بوسعنا فعله هذه اللّحظة

135
00:09:43,340 --> 00:09:46,170
لا بدّ أن نكون عازمين على التّضحية بأرواحنا

136
00:09:47,220 --> 00:09:50,470
وبذل كلّ جهدنا من أجل
.ذلك السّلاح البشريّ المبهم

137
00:09:51,760 --> 00:09:53,010
نثير الشّفقة، صحيح؟

138
00:09:53,680 --> 00:09:56,890
.لكنّ هذا كلّ ما يسعنا فعله كبشر

139
00:09:58,020 --> 00:10:00,190
والآن، ماذا ستفعلين؟

140
00:10:00,940 --> 00:10:03,230
.هذه هي المعركة الوحيدة التي يمكننا قتالها

141
00:10:04,110 --> 00:10:06,070
.هذا هو الصّراع الّذي سُمح لنا بالخوض فيه

142
00:10:16,410 --> 00:10:19,040
.لا يمكنني قبول ذلك

143
00:10:19,210 --> 00:10:20,410
!ريكو

144
00:10:21,080 --> 00:10:22,790
.سأمتثل لأمرك

145
00:10:23,580 --> 00:10:26,250
.أعتقد أنّ ما تقوله صحيح

146
00:10:27,090 --> 00:10:28,630
،لكن بينما نصارع بكلّ ما لدينا

147
00:10:28,630 --> 00:10:31,380
.سنريها أيضًا كم يمكن للبشر أن يكونوا مرعبين

148
00:10:32,010 --> 00:10:34,260
.أرفض الموت هباءً

149
00:10:34,970 --> 00:10:38,390
.دع صنف الـ12 مترًا خلفنا لفرقتي

150
00:10:41,890 --> 00:10:42,980
.لننطلق

151
00:10:42,980 --> 00:10:44,940
.سيكون هدفنا الاثنان أمامنا

152
00:10:44,940 --> 00:10:45,770
.نعم

153
00:10:49,150 --> 00:10:51,400
.شكرًا لك يا قائد الفريق إيان

154
00:10:51,400 --> 00:10:53,990
.أكرمان، لا داعي لشكري

155
00:10:54,820 --> 00:10:58,330
.كنتُ مرتعبًا لأنّه من المستحيل معرفة ما قد تفعلين

156
00:10:59,080 --> 00:11:01,540
.افعلي ما يحلو لك، كما جاء في الخطّة الأصليّة

157
00:11:01,540 --> 00:11:03,920
.سيكون ذلك استعمالاً أكثر كفاءة لقدراتك

158
00:11:04,500 --> 00:11:05,330
.حاضرة

159
00:11:06,000 --> 00:11:08,050
.عليك حماية حبيبك

160
00:11:08,800 --> 00:11:09,880
.نحن عائلة

161
00:11:16,470 --> 00:11:17,430
ماذا؟

162
00:11:18,140 --> 00:11:20,430
الأجزاء المتضرّرة لا تتجدّد؟

163
00:11:21,020 --> 00:11:22,520
هل هذا بسبب الضّرر الّذي تكبّده سابقًا؟

164
00:11:25,230 --> 00:11:27,020
ما الّذي سيفعله ذلك بإرين؟

165
00:11:27,020 --> 00:11:31,280
وهل ثمّة ما يضمن رجوعه لهيئته البشريّة؟

166
00:11:32,610 --> 00:11:33,950
.لا، يجب أن أتوقّف

167
00:11:33,950 --> 00:11:35,990
.لن أتمكّن من العثور على أجوبة لهذه الأسئلة

168
00:11:36,660 --> 00:11:39,620
.حاليًّا، سأقوم بما أستطيع فحسب

169
00:11:48,340 --> 00:11:49,210
...إرين

170
00:11:49,500 --> 00:11:51,920
ميكاسا! ماذا حدث؟

171
00:12:20,370 --> 00:12:21,240
ماذا؟

172
00:12:22,080 --> 00:12:27,170
ما الّذي... أفعله الآن؟

173
00:12:28,080 --> 00:12:29,750
هل أنا جالس؟

174
00:12:30,590 --> 00:12:32,130
.لا يمكنني رؤية أيّ شيء

175
00:12:32,920 --> 00:12:34,510
ما هو اليوم؟

176
00:12:36,180 --> 00:12:37,260
أين أنا؟

177
00:12:43,640 --> 00:12:44,770
ماذا؟

178
00:12:45,850 --> 00:12:47,100
أنا في المنزل؟

179
00:12:54,320 --> 00:12:55,440
.سأعود للنّوم

180
00:13:03,200 --> 00:13:04,120
!إرين

181
00:13:06,040 --> 00:13:08,210
ما الّذي تفعله يا إرين؟

182
00:13:09,880 --> 00:13:10,960
.استمعوا

183
00:13:10,960 --> 00:13:14,670
.عليكم إبقاء العمالقة في حافة البلدة فحسب

184
00:13:14,670 --> 00:13:17,880
.ركّزوا على ذلك واستدرجوها إلى هناك

185
00:13:18,430 --> 00:13:19,680
أهذا مفهوم؟

186
00:13:19,680 --> 00:13:21,850
.لا تحتاجون إلى القتال

187
00:13:22,350 --> 00:13:25,180
.أيّها المتدرّبون، شكّلوا فرقًا من ثلاثة واركضوا على الأرض

188
00:13:25,520 --> 00:13:27,520
.وعندما تبلغون السّور، تسلّقوه

189
00:13:27,520 --> 00:13:28,850
.إيّاكم أن تُقتلوا

190
00:13:29,150 --> 00:13:32,020
.إن هربت العمالقة، فسنهتمّ بأمرها

191
00:13:32,940 --> 00:13:34,480
أقال "إن"؟

192
00:13:34,480 --> 00:13:37,070
أليس من المرجّح أكثر قول "عندما" بدل "إن"؟

193
00:13:37,070 --> 00:13:41,700
،إن فكّرنا أنّنا في خطر
فهل يمكننا الخروج عن أوامرنا؟

194
00:13:42,030 --> 00:13:43,990
.إن كنت تظنّين أنّ ذلك سيساعد

195
00:13:46,540 --> 00:13:48,080
!يا فرقة كيرشتاين، انطلقوا

196
00:13:48,080 --> 00:13:48,960
!حاضر

197
00:14:08,230 --> 00:14:09,770
!هذا سيّئ! انتبهوا خلفنا

198
00:14:10,850 --> 00:14:12,480
!إنّه من صنف 13 مترًا

199
00:14:12,480 --> 00:14:14,320
!إنّه يقترب من ييغر

200
00:14:15,020 --> 00:14:17,570
!تدخل المزيد من العمالقة من الفجوة

201
00:14:18,490 --> 00:14:20,450
!أربعة عمالقة من صنف 10 أمتار تقريبًا

202
00:14:20,990 --> 00:14:22,780
!أكرمان، تولّي أمر من خلفنا

203
00:14:22,780 --> 00:14:23,660
.عُلم

204
00:14:23,660 --> 00:14:25,660
!لا تدعيه يقترب من ييغر

205
00:14:26,240 --> 00:14:27,540
!سنوقفها ها هنا

206
00:14:27,540 --> 00:14:28,330
!عُلم

207
00:14:28,910 --> 00:14:32,080
وإن كانوا من النّخبة، لا يمكن لفرقتين
...تولّي أمر أربعة دفعة واحدة

208
00:14:47,680 --> 00:14:48,890
...كلاّ

209
00:14:49,270 --> 00:14:51,060
لماذا هنالك الكثير من العمالقة؟

210
00:14:51,850 --> 00:14:53,730
.لا يوجد العديد من النّاس هناك

211
00:14:54,310 --> 00:14:57,610
هل يجذبهم إرين إليه؟

212
00:14:57,980 --> 00:14:58,900
!ميكاسا

213
00:14:59,690 --> 00:15:01,030
ماذا حلّ بالخطّة؟

214
00:15:01,030 --> 00:15:02,150
!أرمين

215
00:15:02,150 --> 00:15:03,910
ماذا حلّ بإرين؟

216
00:15:04,370 --> 00:15:06,160
!الوضع خطير! تراجع

217
00:15:06,160 --> 00:15:09,250
إرين غير قادر بالكامل على تطبيق
!إرادته من خلال العملاق

218
00:15:09,250 --> 00:15:11,660
!تحدّثتُ إليه، لكنّه لم يتعرّف إليّ

219
00:15:11,870 --> 00:15:14,000
!لا فائدة من تجربة أيّ أحد آخر لذلك

220
00:15:14,000 --> 00:15:15,040
ماذا عن الخطّة؟

221
00:15:15,040 --> 00:15:16,540
.لقد فشلت

222
00:15:16,540 --> 00:15:19,590
.يقاتل الجميع لأنّنا لا نستطيع ترك إرين

223
00:15:19,590 --> 00:15:21,420
...لكن هنالك العديد منها

224
00:15:21,800 --> 00:15:24,300
.ستقضي علينا العمالقة قريبًا

225
00:15:35,350 --> 00:15:37,610
،المنطقة خلف العنق

226
00:15:38,270 --> 00:15:41,400
.عشرة سنتيمترات عرضًا، ومتر واحد للأعلى

227
00:15:42,070 --> 00:15:43,070
!أرمين

228
00:15:43,070 --> 00:15:45,240
!سأخرج إرين من هنا

229
00:15:45,240 --> 00:15:47,950
!احمينا من أيّ عملاق

230
00:15:49,120 --> 00:15:50,240
ماذا تقول؟

231
00:15:51,200 --> 00:15:54,290
.خرج إرين من نقطة العمالقة الحيويّة

232
00:15:55,790 --> 00:16:00,590
على الأرجح أنّ هذا متعلّق
.بالغموض الّذي يحيطها

233
00:16:01,340 --> 00:16:02,090
.لا تقلقي

234
00:16:02,510 --> 00:16:04,510
،ما دمت أتجنّب إصابتها في المركز

235
00:16:05,930 --> 00:16:07,680
.فلن يموت

236
00:16:07,680 --> 00:16:10,060
...سيؤلمه ذلك

237
00:16:10,930 --> 00:16:12,180
!قليلاً فحسب

238
00:16:12,180 --> 00:16:13,060
...أرمين

239
00:16:23,360 --> 00:16:25,240
!أرمين، هذا جنون! توقّف

240
00:16:25,240 --> 00:16:28,410
!ميكاسا، افعلي ما تستطيعين

241
00:16:28,410 --> 00:16:30,740
!يمكن إنقاذ بعض الأرواح إن ذهبتِ

242
00:16:31,040 --> 00:16:33,330
!اتركي أمر إرين لي

243
00:16:40,800 --> 00:16:42,630
إرين، هل تسمعني؟

244
00:16:43,300 --> 00:16:44,920
!تمالك نفسك

245
00:16:44,920 --> 00:16:47,550
!إن لم نخرج من هنا، فسنموت جميعًا

246
00:16:48,180 --> 00:16:50,510
!لا تسمح لجسم العملاق أن يستحوذ عليك

247
00:16:50,510 --> 00:16:54,560
!اخرج من كومة اللحم تلك فحسب والآن

248
00:16:55,140 --> 00:16:57,100
أخرج؟

249
00:16:57,980 --> 00:16:58,980
لماذا؟

250
00:16:59,860 --> 00:17:02,570
...أنا متعب

251
00:17:02,570 --> 00:17:05,070
!إرين! اخرج من هناك

252
00:17:05,070 --> 00:17:06,280
!أسرع

253
00:17:06,280 --> 00:17:08,910
!إرين! إرين

254
00:17:13,160 --> 00:17:15,710
ماذا حدث لرغبتك بالثّأر لأمّك؟

255
00:17:16,160 --> 00:17:18,580
ألن تقوم بالقضاء على العمالقة؟

256
00:17:18,580 --> 00:17:22,000
ألا تكره الأشياء الّتي قتلت أمّك؟

257
00:17:23,170 --> 00:17:25,510
عمّ تتحدّث يا أرمين؟

258
00:17:26,970 --> 00:17:29,590
...أمّي هناك

259
00:17:30,550 --> 00:17:32,430
!إرين! إرين

260
00:17:32,430 --> 00:17:34,270
!استيقظ يا إرين

261
00:17:34,270 --> 00:17:36,730
ما زلت هناك، صحيح؟

262
00:17:36,980 --> 00:17:39,850
!إن بقينا هنا، فستقتلنا العمالقة

263
00:17:40,230 --> 00:17:42,230
!سينتهي كلّ شيء هنا

264
00:17:44,110 --> 00:17:45,650
...كما قلت

265
00:17:45,650 --> 00:17:48,320
.لا أفهمك يا أرمين

266
00:17:51,070 --> 00:17:53,740
لماذا عليّ المغادرة؟

267
00:17:54,240 --> 00:17:55,240
...صحيح

268
00:17:55,950 --> 00:17:57,750
لماذا عليّ المغادرة؟

269
00:18:01,960 --> 00:18:03,920
لماذا أريد الانضمام لفيلق الاستطلاع؟

270
00:18:13,600 --> 00:18:16,680
يبدو أنّه سيكون علينا الخروج
.عن الخطّة، أحببنا أم كرهنا

271
00:18:27,400 --> 00:18:28,690
!نلت منك

272
00:18:35,160 --> 00:18:37,660
سقطت أخيرًا أيّها الوغد؟

273
00:18:43,330 --> 00:18:44,670
!تراجعوا حاليًّا

274
00:18:44,670 --> 00:18:46,250
.أنا هنا

275
00:18:46,590 --> 00:18:48,210
.سأنضمّ إلى فرقة ميتابي

276
00:18:58,470 --> 00:18:59,230
!ماذا؟

277
00:19:05,440 --> 00:19:06,110
!جان

278
00:19:06,360 --> 00:19:07,780
!تحرّك بسرعة

279
00:19:11,530 --> 00:19:14,200
!لن أسمح بموت أيّ أحد آخر بسببي

280
00:19:29,550 --> 00:19:31,720
سُحقًا... عُطل في وقت كهذا؟

281
00:19:50,690 --> 00:19:51,400
!جان

282
00:19:57,070 --> 00:19:57,990
ما الخطب؟

283
00:19:58,950 --> 00:20:01,160
لماذا لا يستعمل عدّة المناورة؟

284
00:20:02,460 --> 00:20:05,460
مستحيل... أهي معطّلة؟

285
00:20:06,790 --> 00:20:08,290
!سأفكّر في حلّ ما

286
00:20:20,390 --> 00:20:21,680
.سُحقًا

287
00:20:21,680 --> 00:20:23,810
لماذا أنا الّذي يؤخّر تقدّمنا؟

288
00:20:37,620 --> 00:20:40,410
هل يمكنني فعلاً التّفكير في حلّ ما؟

289
00:20:43,910 --> 00:20:44,910
...إرين

290
00:20:45,960 --> 00:20:48,790
!إرين

291
00:20:50,590 --> 00:20:51,670
!إرين

292
00:20:53,300 --> 00:20:57,970
يومًا ما، سنذهب لاكتشاف العالم الخارجيّ، صحيح؟

293
00:21:00,510 --> 00:21:03,640
بعيدًا خلف هذه الأسوار

294
00:21:04,480 --> 00:21:07,140
!توجد مياه ملتهبة! أراضٍ متجمّدة

295
00:21:08,350 --> 00:21:10,650
!حقول من الرّمال بيضاء كبياض الثّلج

296
00:21:11,400 --> 00:21:14,820
...العالم الّذي حاول أبي وأمّي رؤيته

297
00:21:19,870 --> 00:21:21,950
.ظننتُ ربّما تكون قد نسيت

298
00:21:22,910 --> 00:21:25,200
لكنّ سبب توقّفك عن ذكر الأمر

299
00:21:25,200 --> 00:21:28,540
كان بسبب عدم رغبتك بأن أنضمّ
لفيلق الاستطلاع، صحيح؟

300
00:21:29,750 --> 00:21:32,250
العالم الخارجيّ؟

301
00:21:36,010 --> 00:21:38,260
!إرين... أجبني

302
00:21:38,970 --> 00:21:43,100
.كنتَ تعلم أنّ الجحيم خلف الأسوار بخطوة

303
00:21:43,970 --> 00:21:48,390
.قد تموت شرّ ميتة كما حدث لأبي وأمّي

304
00:21:49,310 --> 00:21:53,650
لذلك لماذا أردت الذّهاب؟

305
00:21:56,940 --> 00:21:58,400
لماذا؟

306
00:21:59,780 --> 00:22:02,700
.أنت تعرف السّبب

307
00:22:05,580 --> 00:22:08,960
!لأنّني ولدت في هذا العالم

308
00:22:19,340 --> 00:22:22,350
...يُتبع

309
00:23:53,980 --> 00:23:56,400
.اذهب. اهرب. عش

310
00:23:57,400 --> 00:23:59,610
،ملأت هذه الكلمات الأجواء

311
00:23:59,610 --> 00:24:02,030
.بينما تسقط عدّة أرواح في ساحة المعركة

312
00:24:02,740 --> 00:24:06,410
.يتّجه إرين نحو البوّابة، حاملاً أملاً معه