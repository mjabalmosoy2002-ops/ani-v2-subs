1
00:00:08,950 --> 00:00:12,080
أيمكنك فتحه حقّاً يا سايتو؟

2
00:00:12,080 --> 00:00:13,840
أجل، على الأرجح

3
00:00:22,440 --> 00:00:23,520
ما هذه؟

4
00:00:23,740 --> 00:00:25,640
أدوات لفتح الأقفال

5
00:00:40,110 --> 00:00:41,760
هل سيمضي هذا بخيرٍ حقّاً؟

6
00:00:41,760 --> 00:00:44,430
...إن فشل وتسبّب بتفعيل فخّ

7
00:00:44,430 --> 00:00:46,970
فلنجرّب الثقة به

8
00:00:46,970 --> 00:00:50,230
قلتِ أنّكِ أردتِ انضمام لصٍّ
موهوب كحليف، أليس كذلك؟

9
00:00:50,630 --> 00:00:52,080
...بلى، لكن

10
00:00:55,280 --> 00:00:56,590
فتحته

11
00:00:57,690 --> 00:00:59,660
!أنت مُذهلٌ يا سايتو

12
00:00:59,660 --> 00:01:01,120
!لا بأس بك

13
00:01:03,740 --> 00:01:07,740
كان الأمر أسهل من فتح قفل أسطوانيّ

14
00:01:14,730 --> 00:01:15,940
واحد آخر؟

15
00:01:16,480 --> 00:01:18,960
تلك الغرفة مُؤمّنة حقّاً

16
00:01:21,920 --> 00:01:23,930
ماذا؟ هذا غريب

17
00:01:26,910 --> 00:01:30,280
وُضِع ختمُ سحريّ عليها أيضاً

18
00:01:30,790 --> 00:01:33,690
"...سايتو، افتحها بعد "استعداد، و

19
00:01:33,690 --> 00:01:35,050
حسناً

20
00:01:35,050 --> 00:01:36,320
...استعداد، و

21
00:01:36,320 --> 00:01:37,320
!فتح

22
00:01:48,940 --> 00:01:49,800
!يوجد كنزٌ في الداخل

23
00:01:49,800 --> 00:01:51,760
!نجحنا

24
00:01:51,760 --> 00:01:54,240
!سايتو، افتح صندوق الكنز

25
00:01:54,240 --> 00:01:55,700
!أجل، بالطبع

26
00:02:11,830 --> 00:02:12,920
فتحته

27
00:02:12,920 --> 00:02:14,040
!سريع

28
00:02:14,040 --> 00:02:16,320
!كنتُ في ورطةٍ لأنّي فقدت مفتاحي

29
00:02:16,320 --> 00:02:20,280
الثمن الإجماليّ بحساب أتعاب
التنقّل والعمل يصل 7 آلاف ينّ

30
00:02:20,280 --> 00:02:21,320
ماذا؟

31
00:02:21,320 --> 00:02:23,380
بينما لم يستغرق الأمر منك
أكثر من دقيقة؟

32
00:02:23,380 --> 00:02:24,740
أتبالغ في ثمنك؟

33
00:02:24,740 --> 00:02:27,070
كلّا، هذا الأجر الاعتياديّ

34
00:02:27,070 --> 00:02:28,750
مكتوبٌ على الإعلانات أيضاً

35
00:02:28,750 --> 00:02:30,600
أعطني تخفيضاً

36
00:02:30,600 --> 00:02:32,600
طلب ذاك المبلغ مقابل
...عمل 30 ثانيةٍ فحسب

37
00:02:32,600 --> 00:02:34,800
ألا تراه إجحافاً؟

38
00:02:39,180 --> 00:02:40,680
!حسنٌ، فتحته

39
00:02:50,520 --> 00:02:51,900
!إنّه "مُحاكي"؟

40
00:03:08,330 --> 00:03:10,160
أأنت بخيرٍ يا سايتو؟

41
00:03:10,950 --> 00:03:13,070
شكراً لكِ يا رايلزا

42
00:03:22,360 --> 00:03:24,880
رايلزا، خوذتكِ محلولةٌ قليلاً

43
00:03:24,880 --> 00:03:25,770
ماذا؟

44
00:03:25,770 --> 00:03:26,640
علينا إصلاحها

45
00:03:26,640 --> 00:03:29,220
من الخطر أن تنزلق أثناء قتالكِ

46
00:03:31,380 --> 00:03:32,730
أعليّ خلعها؟

47
00:03:32,730 --> 00:03:34,140
أجل، صحيح

48
00:03:46,480 --> 00:03:47,830
فلتعجّل في الأمر رجاءً

49
00:03:48,650 --> 00:03:50,040
لن أطيل

50
00:03:57,960 --> 00:03:59,980
يمكنك فعل أيّ شيءٍ حقّاً

51
00:03:59,980 --> 00:04:02,030
حسناً، أنا عامل يدويّ

52
00:04:02,030 --> 00:04:05,550
عامل يدويّ؟ لست حدّاد أقفال؟

53
00:04:05,550 --> 00:04:08,240
...صحيح، لا أفتح الأقفال فحسب

54
00:04:08,240 --> 00:04:13,020
أصلح الحقائب وأجمع النفايات
وأبحث عن الكلاب الضالّة

55
00:04:13,020 --> 00:04:14,280
كلاب؟

56
00:04:14,280 --> 00:04:16,230
أتحبّ الكلاب أيضاً؟

57
00:04:16,230 --> 00:04:18,270
،حسناً، ذلك جزء

58
00:04:18,270 --> 00:04:20,440
لكن كان الأمر لأنّ عميلي
كان في ورطة

59
00:04:20,440 --> 00:04:22,240
اختفى شيبامارو

60
00:04:22,240 --> 00:04:25,290
شيبامارو؟ يا للاسم الغريب

61
00:04:31,840 --> 00:04:34,130
لكنّك مُذهلٌ حقّاً

62
00:04:58,080 --> 00:05:01,680
أيُفترض أنّ مورلوك-سان مشعوذ عظيم؟

63
00:05:02,150 --> 00:05:05,020
مستواه يفوق 80

64
00:05:05,020 --> 00:05:08,360
هنالك فرقٌ واسع في المستويات في مجموعتنا

65
00:05:12,410 --> 00:05:15,000
سبق وأن اعتزل العجوز مرّةً

66
00:05:15,000 --> 00:05:17,680
،مستواه عالٍ، لكنّه كثير النسيان

67
00:05:17,680 --> 00:05:19,420
فلا يتذكّر أسطر تعويذاته
كثيراً من الأحيان

68
00:05:19,420 --> 00:05:21,960
سبق وأن نسي مرّةً أين
يُفترض أن نلتمّ أيضاً

69
00:05:21,960 --> 00:05:24,090
كانت تلك تجربةً فظيعة

70
00:05:24,090 --> 00:05:25,880
،واصلنا الانتظار دون أن يظهر

71
00:05:25,880 --> 00:05:28,590
فدخلنا الديماس دونه

72
00:05:28,590 --> 00:05:31,960
يبدو أنّ العجوز استعمل سحر التنقّل
...الآنيّ للحاق بنا فيما بعد، لكن

73
00:05:31,960 --> 00:05:33,200
ماذا؟

74
00:05:33,200 --> 00:05:37,280
هل ارتكبتُ خطأً أثناء حساب الإحداثيّات؟

75
00:05:43,350 --> 00:05:45,320
صادف أن اندمج مع غولم

76
00:05:45,320 --> 00:05:47,320
كيف رجع لطبيعته؟

77
00:05:53,200 --> 00:05:55,040
أتى لنا بحالته

78
00:05:56,490 --> 00:05:57,820
أعتذر على الإطالة

79
00:05:57,820 --> 00:05:58,670
!تأخّرت

80
00:05:58,670 --> 00:05:59,880
فهمت

81
00:06:00,270 --> 00:06:02,570
كانت تلك المرّة فظيعة أيضاً

82
00:06:02,570 --> 00:06:05,430
تذكرين، الطابق بأولئك الموتى الأحياء

83
00:06:05,430 --> 00:06:06,440
أجل

84
00:06:06,440 --> 00:06:08,880
...كنتُ أتساءل أين رحل، و

85
00:06:10,070 --> 00:06:11,650
...حسناً

86
00:06:23,670 --> 00:06:27,780
،عادةً ما أنسى أسطر تعويذاتي
فطُردت من مجموعتي

87
00:06:27,780 --> 00:06:29,520
هلّا سمحتما لي بالانضمام لكما؟

88
00:06:32,510 --> 00:06:34,800
أنسي أمرنا أيضاً؟

89
00:06:34,800 --> 00:06:35,940
لا يهمّ

90
00:06:36,440 --> 00:06:38,670
لنتظاهر أنّه لم يكن موجوداً منذ البداية

91
00:06:39,720 --> 00:06:42,170
...أتمانعان إذاً، أم

92
00:06:46,130 --> 00:06:47,560
!هذا سيّئ

93
00:06:48,880 --> 00:06:50,320
موتى أحياء؟

94
00:06:52,400 --> 00:06:54,050
!سننسحب للوقت الراهن

95
00:07:05,280 --> 00:07:08,060
يا لكما من رفيقين صالحين

96
00:07:08,060 --> 00:07:09,530
أنت تنتمي هنا أيّها العجوز

97
00:07:09,530 --> 00:07:11,490
!ارحلوا أيّها الموتى الأحياء

98
00:07:12,760 --> 00:07:14,570
!اعتنوا بأنفسكم

99
00:07:14,570 --> 00:07:17,090
!لكن له محاسنه أيضاً

100
00:07:17,090 --> 00:07:18,580
...مثلما حصل مع رايلزا

101
00:07:18,580 --> 00:07:19,520
أجل

102
00:07:19,520 --> 00:07:20,750
أحصل أمرٌ ما؟

103
00:07:21,280 --> 00:07:24,990
في الماضي البعيد، مُحيت مجموعتنا
باستثناء العجوز

104
00:07:24,990 --> 00:07:26,550
متُّ بدوري

105
00:07:28,260 --> 00:07:30,340
،نفدت قوّة العجوز السحريّة

106
00:07:30,340 --> 00:07:34,090
لكنّه سحب كافّة جثثنا وراءه وهرب للسطح

107
00:07:34,650 --> 00:07:36,880
،لإعادتنا جميعاً للحياة

108
00:07:36,880 --> 00:07:39,520
باع كافّة معدّاتنا وذهب للكنيسة لأجلنا

109
00:07:42,020 --> 00:07:42,980
اسمع

110
00:07:42,980 --> 00:07:45,730
لمَ كان درع البيكيني خاصّتي
هو الشيء الوحيد الذي لم تبعه؟

111
00:07:47,000 --> 00:07:48,320
نسيت

112
00:07:48,320 --> 00:07:51,120
أرى أنّ ذلك شيئاً قد تتذكّره

113
00:08:04,620 --> 00:08:07,880
!ظـ-ظهري

114
00:08:09,880 --> 00:08:12,450
!تخفيف الألم وتحسين الدورة الدمويّة

115
00:08:12,450 --> 00:08:14,480
شكراً لكِ

116
00:08:19,180 --> 00:08:21,560
!حسناً، انتهيت! الثمن قطعة ذهبيّة واحدة

117
00:08:21,560 --> 00:08:24,240
يا لطمعكِ، رغم أنّنا رفيقان

118
00:08:24,240 --> 00:08:25,720
!شكراً كالمُعتاد

119
00:08:28,130 --> 00:08:29,690
!حسنٌ

120
00:08:30,760 --> 00:08:31,960
هل أساعدكِ في حملها؟

121
00:08:31,960 --> 00:08:34,300
لا بدّ أنّها ثقيلةٌ حتّى مع استعمالكِ
للسحر لتطفو، صحيح؟

122
00:08:34,300 --> 00:08:36,300
لا يمكنك، إنّها قطع ذهبيّة

123
00:08:36,300 --> 00:08:38,080
سأصنع لكِ حقيبةً لها إذاً

124
00:08:38,580 --> 00:08:40,370
أتستطيع ذلك؟

125
00:08:42,740 --> 00:08:44,960
حدادة الأقفال وإصلاح الأحذية والشنط

126
00:08:44,960 --> 00:08:47,390
وجهان لعملة واحدة في مراكز
تحسين المنازل التجاريّة

127
00:08:47,390 --> 00:08:49,170
مراكز تحسين منازل تجاريّة؟

128
00:08:54,940 --> 00:08:59,520
إن صنعتُها كما أفعل لبشريّ، فلن تكون
...هناك مساحة للأجنحة، لذا

129
00:09:00,040 --> 00:09:01,260
!هكذا

130
00:09:01,260 --> 00:09:02,940
!حسنٌ، فلترتديها

131
00:09:05,390 --> 00:09:06,800
!رائعة

132
00:09:06,800 --> 00:09:07,890
كم ثمنها؟

133
00:09:07,890 --> 00:09:09,340
لا داعي لذلك

134
00:09:09,340 --> 00:09:12,830
كلّا، عليك تلقّي تعويضٍ مقابل عملك

135
00:09:12,830 --> 00:09:13,750
...إذاً

136
00:09:13,750 --> 00:09:16,820
يساعدني مورلوك-سان بسحره دوماً

137
00:09:16,820 --> 00:09:18,400
!فحسّني ظهره من فضلكِ

138
00:09:18,400 --> 00:09:20,220
ماذا؟ أأنت مُتأكّد؟

139
00:09:21,770 --> 00:09:24,370
لا يروقني هذا الأمر

140
00:09:24,370 --> 00:09:25,830
من فضلكِ

141
00:09:27,290 --> 00:09:29,680
!تخفيف الألم وتحسين الدورة الدمويّة

142
00:09:31,300 --> 00:09:34,080
!تأثيره أفضل من المُعتاد

143
00:09:36,110 --> 00:09:40,110
مُذ ذاك اليوم، أمضت وقتاً أطول
في العناية بظهره

144
00:09:44,470 --> 00:09:48,110
...حسناً، الطول 15 سنتيمتر

145
00:09:48,110 --> 00:09:51,600
...والعرض 5 مليمترات، لذا

146
00:09:51,600 --> 00:09:54,080
سنتيمتر؟ مليمتر؟

147
00:09:54,400 --> 00:09:57,220
إنّها وحدات طويلٍ في عالمي

148
00:09:57,220 --> 00:09:59,030
ما الذي تستعملونه هنا من جديد؟

149
00:09:59,030 --> 00:10:00,210
ماديراكا

150
00:10:00,210 --> 00:10:03,840
لافانبان بطول واحد ماديراكا تقريباً

151
00:10:03,840 --> 00:10:06,080
قرابة 30 سنتيمتراً إذاً

152
00:10:06,080 --> 00:10:08,030
أتساءل ما الذي بُني عليه

153
00:10:09,730 --> 00:10:11,370
!سأجيبك

154
00:10:11,370 --> 00:10:12,760
مورلوك-سان؟

155
00:10:13,330 --> 00:10:16,400
...في الماضي البعيد، وما أبعد منه

156
00:10:16,400 --> 00:10:20,830
...كان ماديراكا الأوّل، مؤسّس هذه المملكة

157
00:10:21,800 --> 00:10:25,120
!ملكاً بعضوٍ طويل جدّاً

158
00:10:33,520 --> 00:10:38,740
!استغلّ عضوه ذاك وأنجب 300 طفل

159
00:10:38,740 --> 00:10:42,240
استعمل علماء ذاك العصر عضو
،ذاك الملك العظيم كمعيار

160
00:10:42,240 --> 00:10:47,250
وأسّسوا وحدة 1 ماديراكا
بناءً على طوله

161
00:10:49,350 --> 00:10:50,650
فظيع، صحيح؟

162
00:10:52,840 --> 00:10:54,140
ذلك طويل

163
00:10:57,290 --> 00:10:59,620
لا تنظر لي هكذا رجاءً

164
00:11:08,940 --> 00:11:11,240
أنا ساحرٌ من الأقزام

165
00:11:11,240 --> 00:11:12,920
،رغم أنّ ذلك نادرٌ في قومي

166
00:11:12,920 --> 00:11:15,860
قابليّتي السحريّة عالية، فأصبحتُ ساحراً

167
00:11:20,170 --> 00:11:23,670
أيّتها الحرارة الحارقة... اجتمعي الآن

168
00:11:22,120 --> 00:11:24,310
سحري بسيط

169
00:11:23,670 --> 00:11:27,120
حاوية حرارة الانفجار تقف هنا

170
00:11:24,310 --> 00:11:27,120
...أتحمّل هجمات العدوّ بمفردي

171
00:11:27,120 --> 00:11:29,800
!يا أفاعي النار العظيمة، اجتمعي هنا وارقصي

172
00:11:27,120 --> 00:11:29,800
...أتحمّل، وأركّز بينما أتحمّل

173
00:11:29,800 --> 00:11:30,880
!ثمّ

174
00:11:35,330 --> 00:11:38,650
هجوم شامل بوجود مُلقي التعويذة في المُنتصف

175
00:11:39,550 --> 00:11:43,700
لا أبالي بأحد، ولا يبالي أحدٌ بي

176
00:11:44,230 --> 00:11:46,680
!الدرب الوحيد لمُدرّع السحر الثقيل مملوءٌ بالفخر

177
00:11:58,640 --> 00:11:59,500
...لكن

178
00:12:00,270 --> 00:12:01,910
...بكون المرء وحيداً

179
00:12:02,320 --> 00:12:05,750
تصبح الليالي مُوحشة أحياناً

180
00:12:16,300 --> 00:12:18,840
توغّلنا لمسافات عميقة

181
00:12:18,840 --> 00:12:20,650
إنّه الطابق الثالث عشر بالفعل

182
00:12:23,190 --> 00:12:24,600
أشبه بعالم الشياطين

183
00:12:25,000 --> 00:12:28,680
من الآن فصاعداً، لن تكون
هجمات السحر بنفس الفعاليّة

184
00:12:28,680 --> 00:12:32,440
سنُلقي سحر تعزيزٍ على أسلحتنا
ويُنتهي بنا المطاف بالاشتباك

185
00:12:32,440 --> 00:12:33,760
أدرك ذلك

186
00:12:34,600 --> 00:12:36,000
حسناً، هلّا ذهبنا؟

187
00:12:38,320 --> 00:12:39,810
تراجع، المكان خطر

188
00:12:45,020 --> 00:12:46,650
ربما علينا العودة بالفعل

189
00:12:46,650 --> 00:12:47,960
كلّا، سنمضي

190
00:12:57,760 --> 00:12:58,810
ماذا؟

191
00:12:59,210 --> 00:13:02,040
سايتو-سان، يمكنك استعمال مِعدَادٍ أيضاً؟

192
00:13:05,000 --> 00:13:07,560
أجل، تعلّمتُ ذلك في طفولتي

193
00:13:07,560 --> 00:13:10,310
ويستعمل هذا العالم نظاماً
بأساس عشريّ أيضاً

194
00:13:10,310 --> 00:13:13,270
ذلك لأنّ عدد أصابع البشر 10

195
00:13:17,160 --> 00:13:18,860
!مرحباً

196
00:13:34,100 --> 00:13:36,210
أتبحثين عن شيءٍ بالتحديد؟

197
00:13:41,120 --> 00:13:42,430
أعشاب طبّية

198
00:13:42,430 --> 00:13:44,080
تفضّلي بتفقّد المكان

199
00:13:47,360 --> 00:13:50,010
لم أكن أعلم أنّ لديكِ
درعاً كهذا يا رايلزا

200
00:13:53,480 --> 00:13:55,900
لستُ من تظنّه يا سايتو-سان

201
00:13:55,900 --> 00:13:57,720
ناديتِني بـ سايتو للتوّ، أليس كذلك؟

202
00:13:57,720 --> 00:13:58,850
!ا-المعذرة

203
00:14:07,690 --> 00:14:08,620
...يا إلهي

204
00:14:08,620 --> 00:14:11,540
،إن كنتِ تشعرين بالفضول
كان عليكِ مُرافقته

205
00:14:16,120 --> 00:14:18,100
يستطيع سايتو اكتشاف هويّة
من بداخل الدرع

206
00:14:18,100 --> 00:14:19,240
إنّه بارع

207
00:14:22,840 --> 00:14:25,550
!مُذهل! كان سيفاً حديديّاً

208
00:14:26,210 --> 00:14:27,780
...هذا السيف السحريّ

209
00:14:27,780 --> 00:14:29,010
كم ستعطيني مُقابله؟

210
00:14:29,010 --> 00:14:30,560
!خمس عشرة قطعة ذهبيّة

211
00:14:30,560 --> 00:14:31,580
عشرون قطعة

212
00:14:31,580 --> 00:14:33,520
!ثـ-ثمان عشرة قطعة إذاً

213
00:14:34,760 --> 00:14:36,180
!حسناً! بعتكِ إيّاه

214
00:14:36,440 --> 00:14:38,640
!شكراً جزيلاً لك

215
00:14:40,600 --> 00:14:42,400
!يا للأضحوكة

216
00:14:42,400 --> 00:14:44,020
!حقّقتُ ربحاً كبيراً بسببها

217
00:14:44,400 --> 00:14:48,740
كان محض نصلٍ كليل وجدتُه في ديماس
!ألقيتُ سحر مضاعفة هجومٍ عليه

218
00:14:48,740 --> 00:14:50,990
!لا بدّ أنّه عاد لطبيعته الآن

219
00:14:51,240 --> 00:14:54,180
!فتاة محلّ الأدوات تلك مجرّد هاوية

220
00:14:54,180 --> 00:14:55,730
!لقمة سائغة كليّاً

221
00:14:59,210 --> 00:15:00,750
تزول شفرة السيف، صحيح؟

222
00:15:00,750 --> 00:15:01,940
كما أتوقّع منك

223
00:15:02,330 --> 00:15:04,080
من النظرة الأولى، يبدو محض سيفٍ كليل

224
00:15:04,080 --> 00:15:06,310
لكنّ شفرة السيف غطاءٌ في الواقع

225
00:15:06,310 --> 00:15:08,020
فضّة ميثريل؟

226
00:15:08,020 --> 00:15:10,820
حتّى بأضعف الاحتمالات، تبلغ قيمته
!ثلاث مئة قطعة ذهبيّة

227
00:15:10,820 --> 00:15:12,720
!كانت صفقةً ممتازة

228
00:15:24,370 --> 00:15:26,400
!سايتو! قف ورائي

229
00:15:26,400 --> 00:15:27,320
!مورلوك-سان

230
00:15:27,320 --> 00:15:31,160
أيّها السحر الذي أمتلكه، فلتصبح
..حائط قوّة متينة

231
00:15:31,160 --> 00:15:32,800
...لتصبح حائط

232
00:15:32,800 --> 00:15:34,400
لحظة، أكان حائطاً؟

233
00:15:35,700 --> 00:15:37,320
!نسيت سطر تعويذتك مُجدّداً؟

234
00:15:35,710 --> 00:15:37,320
سور؟ جدار صخريّ؟

235
00:15:37,320 --> 00:15:38,780
...حجر أساس

236
00:15:38,780 --> 00:15:40,360
كلّا، لم يكن حجر أساس

237
00:15:41,040 --> 00:15:42,210
...حسناً

238
00:15:47,470 --> 00:15:49,340
أأنت بخيرٍ يا سايتو؟

239
00:15:49,340 --> 00:15:51,830
!إنّها قلقةٌ على سايتو

240
00:15:52,060 --> 00:15:53,220
أعتذر

241
00:15:53,220 --> 00:15:54,180
أيّها العجوز

242
00:15:54,180 --> 00:15:56,300
تدهور نسيانك للأشياء مُؤخّراً

243
00:15:56,670 --> 00:15:58,120
ربما عليك التقاعد

244
00:15:58,120 --> 00:16:00,210
ستمرّون بصعوبات دوني، أليس كذلك؟

245
00:16:00,210 --> 00:16:02,280
لا تجيد لافا سوى استعمال سحر الدفاع

246
00:16:02,280 --> 00:16:04,310
يا للفظاظة! ليس ذلك كلّ
!ما أستطيع فعله

247
00:16:04,310 --> 00:16:08,200
لافا، لديكِ الدور الهام
في علاج ظهري

248
00:16:05,880 --> 00:16:08,860
أنا محض عبءٍ لهم

249
00:16:08,200 --> 00:16:10,620
!ماذا؟! لا أقوم بذلك بالمجّان

250
00:16:10,620 --> 00:16:12,300
أعرف ذلك

251
00:16:11,190 --> 00:16:14,310
،ربما أتيتُ من عالم بحضارة أكثر تقدّماً

252
00:16:12,300 --> 00:16:14,900
!عليك المحاولة بجدٍّ أكبر

253
00:16:14,310 --> 00:16:16,870
لكنّ فتح الأقفال والإصلاحات
هي كلّ ما يسعني فعله

254
00:16:14,900 --> 00:16:18,420
...أنا أحاول، لكن

255
00:16:17,280 --> 00:16:20,160
أأنا قيّمٌ بما يكفي بحيث
أطلب من الجميع حمايتي؟

256
00:16:18,420 --> 00:16:21,240
!حسناً، لا يظهر ذلك
أتحاول حقّاً؟

257
00:16:21,240 --> 00:16:25,160
أخبرتكِ... لحظة، ماذا قلت؟

258
00:16:24,010 --> 00:16:25,160
!مورلوك-سان

259
00:16:25,160 --> 00:16:27,750
!فلتعلّمني استعمال السحر رجاءً

260
00:16:39,290 --> 00:16:40,720
لا نهاية لهم

261
00:16:41,700 --> 00:16:43,220
إنّهم مُمتدّون للوراء

262
00:16:46,770 --> 00:16:49,220
أيمكننا أنّنا سلكنا الدرب الخطأ؟

263
00:17:07,520 --> 00:17:09,080
!رايلزا، تراجعي

264
00:17:09,720 --> 00:17:11,440
سأبيدهم باللهب

265
00:17:11,440 --> 00:17:13,040
!ضربة نارٍ مُشتعلة

266
00:17:15,690 --> 00:17:17,130
...أيّتها الحرارة الحارقة

267
00:17:19,470 --> 00:17:20,710
!اجتمعي الآن

268
00:17:25,450 --> 00:17:29,300
...أيّها القفص المُلتهب، امتلئ الآن بالروح و

269
00:17:31,000 --> 00:17:33,320
...حسناً

270
00:17:33,820 --> 00:17:35,320
ما التتمّة؟

271
00:17:35,920 --> 00:17:38,790
"...بعد "امتلئ الآن بالروح و

272
00:17:42,870 --> 00:17:44,480
كنتُ أعرف أنّ الأمر سيؤول لهذا

273
00:17:44,480 --> 00:17:45,580
!مورلوك-سان

274
00:17:45,880 --> 00:17:49,180
!"إنّها "يا سجين اللهب، أحرّر سلاسلك المُقيّدة

275
00:17:49,180 --> 00:17:50,580
!صحيح

276
00:17:52,030 --> 00:17:53,530
!يا سجين اللهب

277
00:17:55,640 --> 00:17:57,560
!أحرّر سلاسلك المُقيّدة

278
00:18:10,890 --> 00:18:13,160
!أحسنت الصنيع يا سايتو

279
00:18:18,500 --> 00:18:19,920
!ظهري

280
00:18:19,920 --> 00:18:22,280
حسناً، سيكون المُقابل قطعةً ذهبيّة واحدة

281
00:18:23,600 --> 00:18:24,400
أضيفيها للدين

282
00:18:24,400 --> 00:18:25,670
!مُجدّداً؟

283
00:18:25,670 --> 00:18:26,920
...يا إلهي، ليس بيدي حيلة

284
00:18:26,920 --> 00:18:28,420
...أسطر تعويذات العجوز

285
00:18:28,420 --> 00:18:29,790
أحفظتها كلّها؟

286
00:18:30,490 --> 00:18:32,730
حسناً، ليس كلّها

287
00:18:32,730 --> 00:18:35,490
،لا أمتلك قوّةً سحريّة
فلا أستطيع استعمال السحر

288
00:18:35,490 --> 00:18:38,300
خطر لي إن استطعتُ حفظ
...أسطر التعويذات على الأقلّ

289
00:18:38,300 --> 00:18:39,900
يُساعد ذلك العجوز كثيراً

290
00:18:39,900 --> 00:18:41,750
أنا أجيد الحفظ

291
00:18:41,750 --> 00:18:43,370
فقد فعلتُ ذلك في المركز

292
00:18:43,800 --> 00:18:45,110
المركز؟

293
00:18:45,800 --> 00:18:49,900
!إنّه فعّال! فعّالٌ جدّاً

294
00:18:49,900 --> 00:18:53,360
!هذه النقطة

295
00:19:03,160 --> 00:19:04,790
لا أستطيع الحراك

296
00:19:05,670 --> 00:19:08,080
ساقي... مكسورة

297
00:19:13,030 --> 00:19:15,640
لولا الماء، للقيتُ حتفي

298
00:19:15,640 --> 00:19:17,920
يُستحسن بك الاستسلام، أليس كذلك؟

299
00:19:17,920 --> 00:19:20,850
هذه منطقةٌ لا نستطيع فيها استعمال السحر

300
00:19:20,850 --> 00:19:23,240
إن حصل مكروهٌ ما، ما الذي سنفعله؟

301
00:19:23,240 --> 00:19:25,560
هنالك احتمالٌ بكونه "مُحاكياً" آخراً

302
00:19:25,560 --> 00:19:28,800
...لكن، بعدما قطعنا هذا الشوط

303
00:19:32,950 --> 00:19:34,740
إن كان "مُحاكياً"، دع أمره لي

304
00:19:34,930 --> 00:19:36,820
شكراً لكِ يا رايلزا

305
00:19:42,450 --> 00:19:43,370
ماذا؟

306
00:19:45,330 --> 00:19:46,690
!سايتو

307
00:20:08,730 --> 00:20:10,220
...الدم

308
00:20:27,940 --> 00:20:29,910
مضى وقتٌ طويل

309
00:20:30,370 --> 00:20:32,880
لا يستطيع أجدٌ استعمال
السحر في هذه المنطقة

310
00:20:32,880 --> 00:20:35,320
،لن تعمل تعويذات مورلوك-سان

311
00:20:35,320 --> 00:20:37,840
ولن تستطيع لافا الوصول لي بما
أنّها تستعمل السحر للطيران

312
00:20:38,340 --> 00:20:40,920
لا نملك حبلاً طويلاً بما يكفي ليصلني أيضاً

313
00:20:43,840 --> 00:20:48,270
كلّ ما أنا بنهاية المطاف هو عاملٌ
تحمل مهارات فتحه للأقفال قيمةً فحسب

314
00:20:50,000 --> 00:20:52,940
في النهاية، هذا العالم مثل عالمي السابق

315
00:20:53,510 --> 00:20:55,310
!إن لم يعجبك، فلتستقل

316
00:20:55,310 --> 00:20:57,840
هنالك بدلاء لا يُحصون لك

317
00:20:57,840 --> 00:21:00,310
!مرحباً! شكراً على اختيارك لنا

318
00:21:02,330 --> 00:21:04,060
أذلك صحيح؟

319
00:21:15,580 --> 00:21:17,000
!كلّا

320
00:21:17,000 --> 00:21:18,110
...أنا

321
00:21:18,760 --> 00:21:19,840
!إنّه هنا

322
00:21:23,790 --> 00:21:24,980
!سايتو

323
00:21:26,550 --> 00:21:27,550
...يا رفاق

324
00:21:27,550 --> 00:21:29,410
تبعنا مجرى الماء

325
00:21:29,410 --> 00:21:30,880
،بما أنّنا لا نستطيع استعمال السحر

326
00:21:30,880 --> 00:21:33,560
!أبطأني العجوز ولافانبان

327
00:21:33,560 --> 00:21:35,560
!يا للقسوة

328
00:21:35,560 --> 00:21:39,480
الأنبوب المُضيء الذي أعطاني إيّاه
سايتو كان مُفيداً جدّاً

329
00:21:41,170 --> 00:21:42,980
أأنت بخيرٍ يا سايتو؟

330
00:21:42,980 --> 00:21:45,980
أجل، عدا بضعة أضلعٍ مكسورة

331
00:21:50,360 --> 00:21:53,240
بصراحة، لم أتوقّع أن تأتوا لي

332
00:21:53,240 --> 00:21:54,470
يا لحماقتك

333
00:21:54,470 --> 00:21:56,690
يستحيل أن نتخلّى عنك، تعلم ذلك

334
00:21:58,210 --> 00:22:01,960
لا بديل لك يا سايتو

335
00:22:03,250 --> 00:22:04,460
شكراً لكم

336
00:22:04,460 --> 00:22:05,560
هيّا بنا

337
00:22:06,880 --> 00:22:08,640
يا جدّ، قالت أنّنا سنرجع

338
00:22:08,640 --> 00:22:09,840
حسناً، حسناً