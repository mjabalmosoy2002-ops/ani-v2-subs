1
00:00:02,020 --> 00:00:05,430
أنا قابلٌ للاستبدال لحدٍّ لا معدود

2
00:00:07,240 --> 00:00:09,990
ذلك ما اعتقدتُه في عالمي السابق

3
00:00:13,220 --> 00:00:13,940
...لكن

4
00:00:14,640 --> 00:00:15,670
أجل، غالباً

5
00:00:14,640 --> 00:00:17,870
كان هنالك أشخاصٌ بحاجتي

6
00:00:15,670 --> 00:00:17,670
!نجح ذلك

7
00:00:18,840 --> 00:00:20,090
أسعدني ذلك

8
00:00:20,510 --> 00:00:21,460
...في هذا العالم

9
00:00:21,460 --> 00:00:22,440
!هكذا

10
00:00:22,010 --> 00:00:24,120
الجميع يحتاجونني

11
00:00:23,330 --> 00:00:24,840
!"إنّها "يا سجين اللهب، حرّر سلاسلك المُقيّدة

12
00:00:24,840 --> 00:00:25,780
!صحيح

13
00:00:25,780 --> 00:00:26,420
أعتمد عليك

14
00:00:26,810 --> 00:00:28,340
!إنّه طعامك المُفضّل، صحيح؟

15
00:00:27,050 --> 00:00:27,840
...لذا

16
00:00:28,350 --> 00:00:31,030
أنا أبحث عن أشياء أستطيع فعلها دوماً

17
00:00:31,030 --> 00:00:32,900
مورلوك-سان، أكمل

18
00:00:49,360 --> 00:00:50,870
...هذا المكان

19
00:00:53,940 --> 00:00:55,260
رايلزا؟

20
00:01:00,160 --> 00:01:04,080
حمداً لله، ظننتُ أنّك
قد لا تستيقظ أبداً

21
00:01:04,730 --> 00:01:05,940
...أكنت

22
00:01:06,380 --> 00:01:09,180
غططتَ في النوم فورما رجعنا

23
00:01:09,180 --> 00:01:10,650
مضى أكثر من يوم

24
00:01:10,650 --> 00:01:14,100
آسف، كلّ ما أفعله
هو التسبّب بالمتاعب لكم

25
00:01:14,100 --> 00:01:16,100
تجمّدت بالسحر

26
00:01:17,700 --> 00:01:18,810
!سايتو

27
00:01:19,860 --> 00:01:21,300
لا عجب

28
00:01:21,920 --> 00:01:24,810
أبقت بجواري طول الوقت؟

29
00:01:27,560 --> 00:01:29,740
صحيح، ماذا عن مورلوك-سان؟

30
00:01:36,140 --> 00:01:38,560
...سايتو، العجوز قد

31
00:01:39,320 --> 00:01:42,000
هل كانت ليلتك جيّدة؟

32
00:01:42,000 --> 00:01:44,790
توقّف عن هذا، لا يصحّ أن تقول
!أشياء كهذه للنزلاء

33
00:01:44,790 --> 00:01:47,260
طاقة العجوز السحريّة لا تنضب

34
00:01:47,260 --> 00:01:49,180
،أعطى كلّ ما لديه للكلب

35
00:01:49,180 --> 00:01:51,800
لكنّه كان قد استرجع
كلّ شيء بحلول الصباح

36
00:01:53,500 --> 00:01:57,020
،وبما أنّه سبّب الكثير من المتاعب للمالك هنا

37
00:01:57,020 --> 00:01:59,180
يقوم بالمساعدة في أشغال النزل الآن

38
00:01:59,180 --> 00:02:01,640
لم أطلب منه ذلك

39
00:02:03,190 --> 00:02:05,790
غرفتكِ من هنا

40
00:02:05,790 --> 00:02:07,100
!ماذا؟ لحظة

41
00:02:08,940 --> 00:02:10,400
!لحظة أيّها الجدّ

42
00:02:10,410 --> 00:02:12,980
!أعد لي السبع عملات ذهبيّة

43
00:02:17,700 --> 00:02:21,370
هذه أوّل مرّة صعدتُ فيها
لقمّة المتاهة العظيمة

44
00:02:21,600 --> 00:02:24,450
،تحضيراً لوقت خروج الوحوش من المتاهة

45
00:02:24,450 --> 00:02:26,580
تمّ تعزيز الحصن بالجنود

46
00:02:27,720 --> 00:02:30,140
...الحفرة التي أحدثها سحر العجوز

47
00:02:30,140 --> 00:02:31,880
يمكنك رؤيتها حتّى من هنا

48
00:02:32,480 --> 00:02:35,840
يسرّني أنّ مورلوك-سان
تماثل للشفاء التام

49
00:02:36,830 --> 00:02:38,750
...إذاً، يا سايتو

50
00:02:39,290 --> 00:02:40,760
ما الذي أردت الكلام معي بشأنه؟

51
00:02:41,080 --> 00:02:44,630
أنا... لا أتذكّر تغييري لثيابي

52
00:02:45,510 --> 00:02:47,260
!لم أكن من فعلت ذلك

53
00:02:47,260 --> 00:02:49,530
...المُسن القزم

54
00:02:50,010 --> 00:02:53,970
...نصف ماديراكا، نصف ماديراكا، نصف ماديراكا

55
00:02:52,180 --> 00:02:53,970
سأبادلكِ

56
00:02:54,410 --> 00:02:56,200
ذلك يبعث على الارتياح

57
00:02:57,300 --> 00:02:58,920
ذلك ما أردت قوله؟

58
00:02:58,920 --> 00:03:01,340
لا، إنّه الكلب

59
00:03:01,630 --> 00:03:02,910
الكلب؟

60
00:03:03,320 --> 00:03:08,000
بدا أنّكِ كنتِ تحادثين
الكلب في عدّة مراحل

61
00:03:08,000 --> 00:03:11,420
أهو لعيشكِ مع ذئبٍ قبلاً؟

62
00:03:12,340 --> 00:03:14,280
أخبرك العجوز بذلك؟

63
00:03:14,930 --> 00:03:15,800
نعم

64
00:03:17,310 --> 00:03:19,600
نجونا من ثلاثة مواسم شتاء معاً

65
00:03:19,600 --> 00:03:21,890
بدا الذئب كذاك الجرو كثيراً

66
00:03:22,500 --> 00:03:25,380
أتساءل ما إن كان قد
اختفى لمكانٍ ما أيضاً

67
00:03:28,670 --> 00:03:30,900
،ربما لسبب عيشي مع ذئب

68
00:03:30,900 --> 00:03:34,650
لكنّي أشدّ صلابة وخشونة
من معظم النساء

69
00:03:35,720 --> 00:03:41,060
أنا، وساحر عجوز عديم النفع
...طاعن في السنّ وجنّية بخيلة

70
00:03:41,610 --> 00:03:45,400
هذه المجموعة الغريبة هي المكان
الوحيد الذي قد يحتضن شخصاً مثلي

71
00:03:48,320 --> 00:03:50,760
أنا في المجموعة أيضاً

72
00:03:54,380 --> 00:03:57,280
أحتاجكِ أيضاً يا رايلزا

73
00:04:02,940 --> 00:04:05,280
أكثر من أيّ أحدٍ في هذا العالم

74
00:04:05,280 --> 00:04:08,140
وأكثر من أيّ أحد في العالم
الذي أتيتُ منه

75
00:04:21,580 --> 00:04:22,650
...سايتو

76
00:04:22,650 --> 00:04:23,620
!أنت

77
00:04:23,920 --> 00:04:26,010
!أيّها العامل اليدويّ

78
00:04:26,620 --> 00:04:28,280
غيبونغل-سان؟

79
00:04:28,880 --> 00:04:30,530
كنتُ أبحث عنك

80
00:04:30,820 --> 00:04:33,790
فقد مُعلّمي مفاتيح النُزل
وهو في مشكلةٍ الآن

81
00:04:33,790 --> 00:04:36,800
أنت الوحيد القادر على فتح الأقفال، صحيح؟

82
00:04:36,800 --> 00:04:37,940
أجل

83
00:04:37,940 --> 00:04:40,560
لوجود تدابير مضادة للصوص عليها

84
00:04:40,560 --> 00:04:42,620
ارتدى سراويلاً داخليّة لأحد
،النزلاء بالخطأ

85
00:04:42,620 --> 00:04:44,680
!وقفل الباب وهو يضعها

86
00:04:44,680 --> 00:04:45,680
!أسرع

87
00:04:45,680 --> 00:04:47,140
أ-أجل

88
00:05:14,440 --> 00:05:15,400
أنا آسف

89
00:05:15,400 --> 00:05:19,180
كنتُ من ارتدى سراويلك الداخليّة في النهاية

90
00:05:19,180 --> 00:05:21,580
!لمَ أرجعت سايتو معك؟

91
00:05:21,580 --> 00:05:23,840
!يا لك من قزمٍ عديم اللباقة

92
00:05:33,800 --> 00:05:35,670
عضوي ذاك؟

93
00:05:35,670 --> 00:05:39,240
أعدتُ تجديده بالطاقة السحريّة عندما
استعدتُ قوّتي من الكلب

94
00:05:40,380 --> 00:05:42,680
لكن آنذاك، لم أستطع
ا،لتحكّم بطاقتي السحريّة

95
00:05:42,680 --> 00:05:45,360
...مما تسبّب بعودة شبابي مؤقتاً، ونتيجةً لذلك

96
00:05:46,220 --> 00:05:49,570
...بما أنّي كنت لا زلت أفتقد عضوي

97
00:05:50,000 --> 00:05:52,980
واصل التجدّد باستمرار واختفى

98
00:05:52,980 --> 00:05:56,380
...كنتُ دون عضوي عندما عاد إليّ شبابي

99
00:05:57,240 --> 00:05:59,820
ولوهلةٍ فحسب، وقعت مُعجزة

100
00:06:00,190 --> 00:06:03,340
ماذا؟ هل أصبحتُ امرأة؟

101
00:06:05,300 --> 00:06:06,640
...سايتو

102
00:06:07,030 --> 00:06:10,200
بعد إمعاني للنظر، وجهه ظريف

103
00:06:11,150 --> 00:06:15,780
لو وُلِدت امرأةً، لربما وقعتُ في حُبّ سايتو

104
00:06:18,740 --> 00:06:19,870
مورلوك-سان

105
00:06:20,730 --> 00:06:22,470
اشتريتُ عسلاً

106
00:06:22,470 --> 00:06:24,330
قلت أنّك أردت تذوّقه، صحيح؟

107
00:06:24,960 --> 00:06:27,650
يا لطفه، أحبّه

108
00:06:27,650 --> 00:06:29,070
لمَ؟

109
00:06:32,830 --> 00:06:37,080
إن لففتِ السلك حول إبهامكِ
...هكذا ثمّ سحبتِ، فالقفل

110
00:06:38,060 --> 00:06:40,290
سوف يتحرّر الربط وينبثق النصل

111
00:06:41,670 --> 00:06:43,580
لا تزال مُتصلّبةً بعض الشيء

112
00:06:44,200 --> 00:06:46,970
لا أرى بأساً، إنّها تعمل، أليس كذلك؟

113
00:06:47,240 --> 00:06:48,280
لا يصحّ

114
00:06:48,280 --> 00:06:51,740
عندما يشتدّ الوطيس، يجب
أن تكون ملساء... سلسة

115
00:06:52,340 --> 00:06:53,440
إنّه جادٌ جدّاً

116
00:06:59,190 --> 00:07:00,220
!تبّاً

117
00:07:02,020 --> 00:07:03,780
لا، لا بأس

118
00:07:07,080 --> 00:07:09,040
!انتهيت، جرّبيها

119
00:07:11,700 --> 00:07:14,240
أجل، هذا مُناسب

120
00:07:17,230 --> 00:07:18,310
ما هذا؟

121
00:07:19,130 --> 00:07:21,640
دبّوس شعر، إنّه من الفضّة

122
00:07:22,260 --> 00:07:24,150
لمَ هو عالقٌ هنا؟

123
00:07:24,150 --> 00:07:26,360
حسناً، أردتُ مفاجأتكِ

124
00:07:26,360 --> 00:07:29,100
ذلك جانباً، أيعمل كما يجب؟

125
00:07:31,020 --> 00:07:32,180
...حسناً

126
00:07:37,860 --> 00:07:39,720
ما-ما رأيك؟

127
00:07:42,910 --> 00:07:44,390
يبدو جميلاً عليكِ

128
00:07:44,500 --> 00:07:46,740
حسناً، شكراً على عطائك

129
00:07:58,380 --> 00:08:00,720
!يشبه مورلوك-سان تماماً

130
00:08:01,040 --> 00:08:04,930
...أيّتها الحرارة الحارقة، اجتمعي الآن! أيّها القفص

131
00:08:04,920 --> 00:08:07,360
امتلئ الآن بالروح والإرادة

132
00:08:04,930 --> 00:08:06,080
هذا سيّئ

133
00:08:06,080 --> 00:08:08,540
،بمواجهتها لشيءٍ يبدو مثلي، مثل أبيها تماماً

134
00:08:07,360 --> 00:08:10,550
...يا سجين اللهب، أحرّر سلاسلك

135
00:08:08,540 --> 00:08:10,550
!فلن تستطيع رايلزا القتال بقوّتها الكاملة

136
00:08:16,360 --> 00:08:19,000
!لهذا الشيء وجهٌ يثير حنقي

137
00:08:17,110 --> 00:08:19,000
!مُضاعفة قوّة الهجوم

138
00:08:19,000 --> 00:08:21,940
تبدوان مُتحفّزتان أكثر من المُعتاد، أليس كذلك؟

139
00:08:21,940 --> 00:08:23,190
ما رأيك يا سايتو؟

140
00:08:23,190 --> 00:08:25,730
!هذا مثاليّ، يمكنني اختبار النشّاب

141
00:08:25,730 --> 00:08:27,960
!ما قصدك بالمثاليّ؟

142
00:08:33,640 --> 00:08:35,000
رايلزا

143
00:08:39,720 --> 00:08:41,380
...صحيح

144
00:08:41,380 --> 00:08:44,980
قالت أنّها ستأخذ مورلوك-سان لعلاج بالوخز بالإبر

145
00:08:42,280 --> 00:08:44,190
...ظهري يُوجعني

146
00:08:44,190 --> 00:08:46,240
!يا لك من عجوزٍ مُتعِب

147
00:08:48,930 --> 00:08:50,520
ما هذا؟

148
00:08:57,360 --> 00:08:59,290
صنعتَ حمّاماً لي؟

149
00:08:59,290 --> 00:09:02,890
كنتُ أبحث عن حاوية معدنيّة بهذا الحجم

150
00:09:04,220 --> 00:09:06,020
!سأستعمله الآن إذاً

151
00:09:09,820 --> 00:09:10,910
ما الخطب؟

152
00:09:10,910 --> 00:09:13,160
!لـ-لأنّكِ خلعتِ ثيابكِ فجأةً

153
00:09:13,160 --> 00:09:14,810
أيُضايقك ذلك؟

154
00:09:14,810 --> 00:09:16,610
نحن جنّية وبشريّ، أليس كذلك؟

155
00:09:16,830 --> 00:09:18,960
كان الوضع ليختلف لو كنتُ إلف

156
00:09:18,960 --> 00:09:21,580
أ-أهكذا الأمر؟

157
00:09:21,580 --> 00:09:24,130
أطأ على هذا، صحيح؟

158
00:09:25,600 --> 00:09:28,500
!يا للنعيم

159
00:09:28,500 --> 00:09:30,800
!سأغسل شعري أيضاً

160
00:09:30,800 --> 00:09:33,460
!لم أحسب لذلك! سيفيض الحمّام

161
00:09:33,460 --> 00:09:36,440
!حسناً، اذهب واجلب لي نبيذاً

162
00:09:36,440 --> 00:09:39,470
!سايتو، سنمرح سهراً طوال الليل

163
00:09:39,720 --> 00:09:40,960
حسناً

164
00:10:01,760 --> 00:10:02,990
ماذا؟

165
00:10:07,560 --> 00:10:10,000
!ماذا؟

166
00:10:13,200 --> 00:10:14,960
عدّة لصّ

167
00:10:15,620 --> 00:10:17,420
درع فارسٍ مُقدّس

168
00:10:17,730 --> 00:10:19,880
!عباءة ساحر

169
00:10:19,880 --> 00:10:22,190
كونك بحجم البشر رائعٌ حقّاً

170
00:10:22,190 --> 00:10:23,940
هنالك اختيارات كثيرة مُتوفّرة لك

171
00:10:23,940 --> 00:10:25,470
لن تشتري شيئاً؟

172
00:10:25,470 --> 00:10:27,880
تكفيني ثياب رايلزا الاعتياديّة

173
00:10:27,880 --> 00:10:30,400
تعرف أنّي لا أنفق المال

174
00:10:30,400 --> 00:10:32,510
لكن اختفتِ أجنحتكِ حتّى

175
00:10:32,510 --> 00:10:34,790
سأرجع لطبيعتي إن تركنا الأمور
تأخذ مجراها، أليس كذلك؟

176
00:10:34,790 --> 00:10:37,010
وهذا ليس بالحال السيّئ

177
00:10:39,920 --> 00:10:41,010
...لافا

178
00:10:44,330 --> 00:10:46,320
ماذا؟ لي؟

179
00:10:46,990 --> 00:10:49,030
أجل، ظننتُها ستلائمكِ

180
00:10:49,030 --> 00:10:52,330
لا أستطيع قبولها، لا يمكنني دفع ثمنها لك

181
00:10:52,340 --> 00:10:56,870
ربما حصل هذا لاستعمالي
لذاك الإناء الغريب

182
00:10:56,870 --> 00:10:59,840
صرفتِ الكثير من عملاتكِ الذهبيّة
الثمينة لحمايتنا جميعاً

183
00:10:59,840 --> 00:11:01,800
!وهذا بمثابة اعتذار وامتنان لأفعالك

184
00:11:02,350 --> 00:11:05,050
...إن كان هذا ما عليه الأمر

185
00:11:12,570 --> 00:11:13,530
كيف أبدو؟

186
00:11:15,270 --> 00:11:16,640
يلائمكِ

187
00:11:19,150 --> 00:11:22,610
عليكِ قول هذه الأشياء لـ رايلزا

188
00:11:23,350 --> 00:11:26,080
!أنا أقولها لها

189
00:11:29,820 --> 00:11:31,040
!لا بأس إذاً

190
00:11:31,040 --> 00:11:32,820
!انتبهي أمامك

191
00:11:34,600 --> 00:11:36,390
آلمني ذلك

192
00:11:36,390 --> 00:11:37,700
آسفة

193
00:11:40,560 --> 00:11:44,120
خدشتِ درعي الجلديّ الجديد

194
00:11:44,120 --> 00:11:45,760
هل ستعوّضيني؟

195
00:11:46,080 --> 00:11:49,930
أم يمكنكِ القدوم واللهو معي
لبرهة بدل ذلك

196
00:11:50,440 --> 00:11:51,780
...ما

197
00:11:52,270 --> 00:11:54,220
!توقّف

198
00:11:54,550 --> 00:11:57,700
لمَ قد تُخدش مُقدّمة الدرع
إن ارتطمت بك من الخلف؟

199
00:11:58,220 --> 00:11:59,920
...هذه الثياب

200
00:11:59,920 --> 00:12:02,360
أنت من وجد النفق الجديد
في المتاهة العظيمة

201
00:12:02,360 --> 00:12:04,360
العامل اليدويّ سايتو، صحيح؟

202
00:12:05,070 --> 00:12:06,580
سمعتُ بك

203
00:12:06,580 --> 00:12:10,530
يُقال أنّ رفاقك أقوياء، لكنّك
محض ضعيف هزيل

204
00:12:10,530 --> 00:12:13,960
!كفّ عن الاستعراض بعد اشتهارك قليلاً فحسب

205
00:12:19,390 --> 00:12:21,880
!مؤلم! دعني

206
00:12:21,880 --> 00:12:23,040
!مؤلم

207
00:12:23,040 --> 00:12:24,300
...سايتو

208
00:12:25,190 --> 00:12:28,800
صحيح، إنّه يزداد قوّة

209
00:12:29,690 --> 00:12:31,560
!تـ-تبّاً لك

210
00:12:31,560 --> 00:12:32,680
...مؤلم

211
00:12:34,270 --> 00:12:36,140
لافا، أأنتِ بخير؟

212
00:12:46,630 --> 00:12:50,120
ما ذلك؟ كان رائعاً نوعاً ما

213
00:13:00,440 --> 00:13:01,380
لافا؟

214
00:13:06,890 --> 00:13:07,840
لافا؟

215
00:13:11,270 --> 00:13:13,060
رجعتُ لطبيعتي

216
00:13:22,070 --> 00:13:23,320
!آسف

217
00:13:23,320 --> 00:13:26,550
لكنّكِ قلتِ البارحة أنّ لا مشكلة
!إن رآكِ بشريّ

218
00:13:27,450 --> 00:13:29,360
ما الذي تفعله يا سايتو؟

219
00:13:29,910 --> 00:13:31,920
تأخّرتِ يا رايلزا

220
00:13:31,920 --> 00:13:32,840
أخبرتك

221
00:13:32,840 --> 00:13:35,460
منزل المُعالِج بالإبر بعيد

222
00:13:35,460 --> 00:13:38,830
لكن يبدو أنّ العجوز بخيرٍ الآن

223
00:13:38,830 --> 00:13:40,880
إنّه غارقٌ في الشراب
بالأسفل سلفاً

224
00:13:41,540 --> 00:13:43,050
أحصل شيءٌ ما هنا؟

225
00:13:43,050 --> 00:13:45,840
كان الأمر جنونيّاً

226
00:13:45,840 --> 00:13:48,840
!رايلزا، أعيدي لي عملاتي الذهبيّة السبع

227
00:13:54,590 --> 00:13:58,130
!إذا لم تسويّ الأمر، سآخذ الأمير بدلاً عنها

228
00:13:58,130 --> 00:13:59,010
!ماذا؟

229
00:13:59,410 --> 00:14:00,640
أمزح فحسب

230
00:14:00,640 --> 00:14:03,900
من الحسن أني من فصيلة أخرى، صحيح؟

231
00:14:05,800 --> 00:14:07,400
حصل ذلك لـ لافانبان؟

232
00:14:07,400 --> 00:14:09,880
وهذا السبب؟

233
00:14:09,880 --> 00:14:13,190
لا أستطيع التفكير بسببٍ آخر

234
00:14:13,190 --> 00:14:14,470
أين مورلوك-سان؟

235
00:14:14,470 --> 00:14:15,880
ذهب للهو

236
00:14:16,160 --> 00:14:19,270
العجوز بمثابة تجسّد متجوّل
للا مسؤوليّة بثياب

237
00:14:19,690 --> 00:14:21,840
يبدو أنّكم في مشكلة

238
00:14:22,300 --> 00:14:25,100
رأيتُ هذا المشهد تماماً من قبل

239
00:14:25,100 --> 00:14:28,130
سيمدّكم غيبونغل هذا بالعون

240
00:14:28,130 --> 00:14:30,550
...وفقاً لسحربيديا

241
00:14:30,550 --> 00:14:33,430
يجعل ذاك الإناء الكائنات مثل الجنّيات

242
00:14:33,430 --> 00:14:35,530
والوحوش الصغيرة أكبر حجماً بشكل مؤقّت

243
00:14:35,530 --> 00:14:38,520
،الأداة مدمجة بطاقة سحريّة قويّة
ذلك ما هو مذكور

244
00:14:39,350 --> 00:14:42,520
يجمع العجوز الكثير من الأشياء الغريبة

245
00:14:42,520 --> 00:14:44,270
!رايلزا

246
00:14:44,800 --> 00:14:48,730
خسرتُ في لعبة البطاقات، لذا أخذوا كلّ شيءٍ منّي

247
00:14:48,730 --> 00:14:50,850
!أخفِ عضوك القذر أيّها العجوز

248
00:14:50,850 --> 00:14:52,680
!أيّها الجدّ، يا لقذارتك

249
00:14:52,680 --> 00:14:53,860
...مُعلّمي

250
00:14:53,860 --> 00:14:55,990
هل أجلب لك من ثيابي؟

251
00:14:56,270 --> 00:14:59,670
قذر؟ لا داعي لاستعمال أوصاف كهذه

252
00:14:59,670 --> 00:15:01,670
!هذا مثاليّ

253
00:15:01,670 --> 00:15:04,080
إن أخفيته بهذه، فلن تتذمّروا، صحيح؟

254
00:15:04,080 --> 00:15:04,980
حسنٌ

255
00:15:10,800 --> 00:15:12,510
...عضو مورلوك-سان قد

256
00:15:12,510 --> 00:15:14,390
!تفاداه يا سايتو

257
00:15:15,090 --> 00:15:17,800
!ما الذي فعلته أيّها العجوز؟

258
00:15:15,740 --> 00:15:17,800
!اكبر وتضخّم

259
00:15:23,750 --> 00:15:26,520
نقودنا في انخفاض

260
00:15:30,480 --> 00:15:32,370
يا للمشكلة

261
00:15:32,780 --> 00:15:34,420
ماذا أفعل؟

262
00:15:35,760 --> 00:15:37,170
ناوليني إيّاها قليلاً

263
00:15:41,170 --> 00:15:43,730
شكراً لك، أنت موهوب

264
00:15:43,730 --> 00:15:45,280
لم يكن بالخطب الجلل

265
00:15:45,280 --> 00:15:48,260
من هذه الثياب... أأنت العامل اليدويّ سايتو؟

266
00:15:48,800 --> 00:15:50,130
كيف عرفتِ؟

267
00:15:50,460 --> 00:15:52,480
أنت مشهورٌ هذه الأيّام

268
00:15:52,480 --> 00:15:55,290
سمعتُ بأنّك حرفيّ ماهر
!يمكنه فعل أيّ شيء

269
00:15:55,290 --> 00:15:56,390
...لستُ بذاك

270
00:15:56,720 --> 00:15:58,840
ماذا؟ أقالت العامل اليدويّ سايتو؟

271
00:15:58,840 --> 00:16:00,830
أيمكنك إصلاح حقيبتي؟

272
00:16:00,830 --> 00:16:02,350
يوجد ثقبٌ في حذائي

273
00:16:02,350 --> 00:16:04,430
هنالك خطبٌ في تركيب نوافذي

274
00:16:04,430 --> 00:16:06,600
أيمكنك أطهو الهيدرا حقّاً؟

275
00:16:06,880 --> 00:16:10,600
!مـ-مهلاً قليلاً من فضلكم، بالترتيب

276
00:16:13,610 --> 00:16:17,540
كنت تعمل حتّى هذا الوقت المُتأخّر؟

277
00:16:17,840 --> 00:16:20,520
طلب منّي الكثير من الناس
أداء أعمال منوّعة

278
00:16:20,520 --> 00:16:23,850
وبفضل ذلك، حصلتُ على مالٍ
كافٍ لدفع ثمن الطعام

279
00:16:25,440 --> 00:16:28,000
ربما كان بإمكانك تقاضي المزيد منهم

280
00:16:28,450 --> 00:16:33,290
عندما يتعلّق الأمر بالأعمال الجلديّة
والنجارة، فلستُ مُحتر... خبيراً

281
00:16:33,290 --> 00:16:36,520
لا أشعر بارتياح لقبول ما قد
يتقاضاه حرفيّ فعليّ

282
00:16:36,520 --> 00:16:40,010
مع ذلك، عليك الحصول على تعويضٍ كافٍ لعملك

283
00:16:40,360 --> 00:16:42,040
معكِ حقّ

284
00:16:42,040 --> 00:16:44,380
،عندما أصبح أكثر معرفةً بهذا العالم

285
00:16:44,380 --> 00:16:47,510
قد أستطيع أن أكون عاملاً
يدويّاً هنا أيضاً

286
00:16:47,510 --> 00:16:48,670
ذلك جميل

287
00:16:48,670 --> 00:16:52,030
يمكنك افتتاح متجرٍ صغير مثل ميفينا

288
00:16:52,030 --> 00:16:54,550
!و-وإن فعلت ذلك، سأساعدك

289
00:16:54,550 --> 00:16:58,320
لا أجيد الحساب، لكن يمكنني
...ترتيب البضائع وما شابه

290
00:16:58,320 --> 00:17:00,660
!سايتو! كنّا نبحث عنك

291
00:17:00,660 --> 00:17:01,770
...أنتما

292
00:17:01,770 --> 00:17:04,140
!إلف-تشان ونينيا-تشان

293
00:17:04,140 --> 00:17:05,970
قفازي النصفّي محطّم

294
00:17:05,970 --> 00:17:07,360
هلّا أصلحته لي؟

295
00:17:07,360 --> 00:17:10,370
،في الواقع، أودّ إصلاحه لها

296
00:17:10,370 --> 00:17:12,800
لكنّي لا أبرع في تلك الأشياء

297
00:17:13,040 --> 00:17:14,320
!أنا هنا أيضاً

298
00:17:14,320 --> 00:17:15,760
من كان من جديد؟

299
00:17:16,320 --> 00:17:17,820
!أيّها العامل اليدويّ سايتو

300
00:17:17,820 --> 00:17:19,640
هلّا أصلحت ثيابي لي؟

301
00:17:19,640 --> 00:17:21,720
سقطت حراشف التنّين

302
00:17:22,170 --> 00:17:24,040
صيّادة الوحوش السحريّة ليليزا؟

303
00:17:24,360 --> 00:17:26,170
وغيفر-سان

304
00:17:26,700 --> 00:17:29,190
مـ-مضى وقتٌ طويل

305
00:17:30,000 --> 00:17:31,160
...مُعلّم سايتو

306
00:17:31,160 --> 00:17:34,660
أودّ منك أن تعلّمني كيف أعدّ
ذاك الخبز الذي أكلتَه قبلاً

307
00:17:34,660 --> 00:17:37,830
قال مونبوي أنّه يودّ أكله

308
00:17:37,830 --> 00:17:41,410
أنا مُتعبة، لنرجع للنزل

309
00:17:41,410 --> 00:17:43,950
إنّها مجموعة البطل المُعترف
بها من المملكة رسميّاً

310
00:17:44,460 --> 00:17:48,520
سايتو-سان، أتعتقد أنّ بإمكانك
تقييم هذا لي؟

311
00:17:48,520 --> 00:17:51,040
ميفينا! كيف حالكِ؟

312
00:17:51,920 --> 00:17:53,030
المعذرة

313
00:17:53,030 --> 00:17:54,760
...ملكنا

314
00:17:54,760 --> 00:17:58,790
أقصد أنّ فارساً سحريّاً من معارفنا
قد حطّم كنزاً ثميناً

315
00:17:58,790 --> 00:18:01,930
اعتقدتُ أنّ بإمكان حرفيّ
بسمعتك اللامعة إصلاحه

316
00:18:01,930 --> 00:18:04,370
أسقطتُه عرضاً وتحطّم

317
00:18:04,370 --> 00:18:06,640
لذا نخبرك مراراً بأن
ترتديه كما يجب

318
00:18:07,400 --> 00:18:09,640
الساحر من المملكة الأخرى ورفاقه أيضاً؟

319
00:18:09,640 --> 00:18:10,730
!سايتو

320
00:18:10,730 --> 00:18:12,610
!أتممتُ القفل الأعظم

321
00:18:12,610 --> 00:18:14,640
!إن كنت تعتقد أنّ بإمكانك فتحه، فلتجرّب

322
00:18:15,290 --> 00:18:17,150
حتّى دونباين-سان هنا؟

323
00:18:17,150 --> 00:18:18,760
فلتصلحه سريعاً، هلّا فعلت؟

324
00:18:18,760 --> 00:18:20,560
!بحثنا عنك في الأرجاء

325
00:18:20,560 --> 00:18:21,660
!أنا هنا أيضاً

326
00:18:21,660 --> 00:18:22,550
من كان مُجدّداً؟

327
00:18:22,550 --> 00:18:24,800
هلّا رافقتني... للاستطلاع وما شابه في وقتٍ ما؟

328
00:18:24,800 --> 00:18:25,550
الخبز

329
00:18:25,550 --> 00:18:29,170
!كاينز! فلنرجع

330
00:18:27,990 --> 00:18:29,170
...هوّني عليك

331
00:18:29,170 --> 00:18:31,740
أتعتقد أنّ بإمكانك إصلاحه لنا؟

332
00:18:31,740 --> 00:18:33,520
حضّرنا مُكافأةً لك
إن كنت تتساءل

333
00:18:33,520 --> 00:18:35,170
!سايتو! جرّب فتحه

334
00:18:35,170 --> 00:18:39,050
...هيّا يا سايتو! ألا يمكننا أن

335
00:18:36,900 --> 00:18:39,050
...إن سألتموني جميعاً فجأةً، لا أستطيع

336
00:18:39,050 --> 00:18:42,490
!لو قمتَ وحسب... هيّا يا سايتو

337
00:18:39,430 --> 00:18:42,490
أنتم! ألا ترون أنّ سايتو مضغوط؟

338
00:18:42,490 --> 00:18:44,190
!ارجعوا غداً

339
00:18:44,440 --> 00:18:46,950
لمَ تتولّى رايلزا-سان المسؤوليّة؟

340
00:18:46,950 --> 00:18:49,150
إنّها تلعب دور الزوجة سلفاً

341
00:18:49,470 --> 00:18:51,740
لا علاقة لكِ، لا تتدخّلي

342
00:18:52,300 --> 00:18:54,580
!أنا عضوةٌ في مجموعته

343
00:18:54,580 --> 00:18:57,650
ويمكنكِ لفّ سلكِ حول ذاك
!الشيء لإصلاحه بنفسكِ

344
00:18:57,650 --> 00:18:58,860
ما الذي قلتِه؟

345
00:18:58,860 --> 00:19:01,150
أتودّين خوض نزالٍ ثانٍ هنا؟

346
00:19:01,150 --> 00:19:03,370
!مُرحّب به

347
00:19:03,360 --> 00:19:04,640
هل لك أن تصلح هذا سريعاً؟

348
00:19:03,370 --> 00:19:07,320
سايتو-سان، هلّا قيّمته لي سريعاً؟

349
00:19:04,640 --> 00:19:06,040
!كنتُ هنا أوّلاً

350
00:19:07,640 --> 00:19:08,620
!حسنٌ

351
00:19:08,620 --> 00:19:09,790
!من فضلك

352
00:19:09,790 --> 00:19:11,340
!تذاكر مُرقّمة

353
00:19:11,340 --> 00:19:13,240
!تُباع بقيمة عملة ذهبيّة للواحدة

354
00:19:13,470 --> 00:19:16,250
لمَ لا نبدأ ببعض الشراب؟

355
00:19:16,250 --> 00:19:17,760
!أيّها العجوز، لا تلمسني

356
00:19:18,160 --> 00:19:20,140
!أنا هنا أيضاً

357
00:19:18,570 --> 00:19:20,140
من كان من جديد؟

358
00:19:20,630 --> 00:19:23,120
اهدؤوا جميعاً

359
00:19:25,840 --> 00:19:28,400
!حسناً، احصلوا على تذاكركم المُرقّمة هنا

360
00:19:26,440 --> 00:19:29,210
سأخبرك أين يمكنك شراء
بطاطا مُجفّفة حلوة لذيذة

361
00:19:27,760 --> 00:19:29,850
لا، لا يمكننا حقّاً

362
00:19:30,370 --> 00:19:31,680
!بلا تدافع

363
00:19:30,740 --> 00:19:33,100
أنت مسرورٌ للقائك له بعد
كلّ تلك المدّة، صحيح؟

364
00:19:33,100 --> 00:19:33,850
أجل، ر-ربما ذلك

365
00:19:33,850 --> 00:19:36,280
!يوجد ما يكفي للجميع

366
00:19:36,280 --> 00:19:37,360
!سأتناول ما آكله أيضاً

367
00:19:37,360 --> 00:19:39,520
المواد التي صُنع منها مُذهلة حقّاً

368
00:19:39,520 --> 00:19:41,360
!هذا طيّب المذاق

369
00:19:39,530 --> 00:19:41,360
يمكنك ملاحظة ذلك؟

370
00:19:41,740 --> 00:19:44,010
...نينيا-تشان

371
00:19:41,750 --> 00:19:44,010
أيّها العجوز، فلتتوقّف عن أفعالك

372
00:19:44,010 --> 00:19:45,820
فلتلكميه وحسب

373
00:19:44,010 --> 00:19:48,360
يا لظرافتكِ

374
00:20:00,320 --> 00:20:03,400
...أشعر بالاكتمال

375
00:20:04,030 --> 00:20:07,300
أكثر بكثير مما كنتُ عليه
في عالمي السابق