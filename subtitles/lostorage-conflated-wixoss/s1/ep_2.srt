1
00:00:05,480 --> 00:00:08,000
ماذا؟ تحبيّن "ويكروس"؟

2
00:00:11,120 --> 00:00:13,140
!أنا مثابرة للغاية

3
00:00:15,160 --> 00:00:19,160
كيوي، أنت مضحكة للغاية
.وأنت تبدين متجهّمة هكذا

4
00:01:50,960 --> 00:01:52,440
...سررت بلقائك

5
00:01:53,420 --> 00:01:55,180
.يا كوميناتو روكو-سان

6
00:01:59,170 --> 00:02:01,010
أعتقد أنّ هذا ليس أوّل لقاء لنا، صحيح؟

7
00:02:01,010 --> 00:02:04,600
."لقد تقابلنا من قبل كمنتقية و"لريغ

8
00:02:06,320 --> 00:02:07,940
.أحتاج للحديث معك

9
00:02:10,650 --> 00:02:13,050
لم تنتهِ معارك المنتقين؟

10
00:02:13,050 --> 00:02:13,770
.نعم

11
00:02:13,770 --> 00:02:15,640
...لكنّ ذلك مستحيل، لأنّ

12
00:02:15,640 --> 00:02:17,780
لأنّ مايو لم تعد موجودة، صحيح؟

13
00:02:20,400 --> 00:02:26,830
مايو، فتاة انقضت حياتها القصيرة
.قبل حتّى أن ترى العالم الخارجيّ

14
00:02:27,320 --> 00:02:31,790
،سكنت مشاعرها داخل الأوراق
.فوُلدت معارك المنتقين الأولى

15
00:02:32,150 --> 00:02:33,750
...ومايو قد

16
00:02:34,510 --> 00:02:38,040
ما زالت مايو هناك في تلك الغرفة البيضاء؟

17
00:02:38,040 --> 00:02:40,970
.كلاّ، مايو لم تعد موجودة

18
00:02:43,100 --> 00:02:45,190
.لقد أنقذتِها

19
00:02:45,190 --> 00:02:46,460
صحيح؟

20
00:02:46,460 --> 00:02:48,770
.لكنّ المعارك لم تنتهِ

21
00:02:49,360 --> 00:02:52,460
مشاعر كلّ أولئك الفتيات الضّائعات والمعذّبات

22
00:02:52,460 --> 00:02:54,920
.قد وضعت الأسس الأولى للمعارك التّالية

23
00:02:54,920 --> 00:02:56,780
...دائرة ظلام غير منتهية

24
00:02:57,500 --> 00:02:58,740
.وأريد أن أضع حدًّا لها

25
00:02:59,160 --> 00:03:01,160
تضعين حدًّا للدّائرة؟

26
00:03:01,160 --> 00:03:02,240
.ساعديني

27
00:03:02,590 --> 00:03:05,580
...لقد حرّرتِ كلّ "لريغ"، لذا بمساعدتك

28
00:03:05,580 --> 00:03:06,850
!أنا آسفة

29
00:03:07,320 --> 00:03:11,000
.لا... لا أستطيع مساعدتك

30
00:03:11,380 --> 00:03:13,460
.لديّ صديقة أهتمّ لأمرها

31
00:03:13,660 --> 00:03:15,380
.صديقة تعني لي كلّ شيء

32
00:03:15,960 --> 00:03:19,020
...إن تورّطتُ في هذا، فأنا واثقة أنّها

33
00:03:19,550 --> 00:03:22,680
!لا أريد القتال في أيّ معارك أخرى

34
00:03:23,310 --> 00:03:24,220
.فهمت

35
00:03:29,250 --> 00:03:31,460
...صديقة تهتمّ لأمرها

36
00:03:32,170 --> 00:03:33,190
!كيوي

37
00:03:37,040 --> 00:03:38,150
أميكا؟

38
00:03:38,150 --> 00:03:41,360
يا إلهي! لماذا لا تجيبين على هاتفك؟

39
00:03:42,040 --> 00:03:43,380
أين كنتِ؟

40
00:03:43,380 --> 00:03:44,820
.لن أخبرك

41
00:03:44,820 --> 00:03:47,200
ذهبتِ للقاء منتقين آخرين؟

42
00:03:49,920 --> 00:03:53,060
.يا إلهي... لا أنفكّ عن إخبارك بالتّوقّف

43
00:03:53,060 --> 00:03:55,790
.أعلم ذلك. لهذا السّبب أطفأت هاتفي

44
00:03:55,790 --> 00:03:57,640
...اسمعي

45
00:03:57,640 --> 00:03:59,050
.لا داعي للقلق

46
00:03:59,960 --> 00:04:01,720
.بالطّبع سأقلق

47
00:04:01,720 --> 00:04:05,300
لا تنفكّ صديقتي عن مواصلة
.توريط نفسها في لعبة خطيرة

48
00:04:06,290 --> 00:04:08,800
لماذا عليك القيام بهذا؟

49
00:04:08,800 --> 00:04:11,260
،ربّما آذيتِ أولئك الفتيات

50
00:04:11,260 --> 00:04:13,270
.لكنّها ليست غلطتك وحدك

51
00:04:13,800 --> 00:04:15,730
.توقّفي فحسب

52
00:04:16,520 --> 00:04:17,950
.شكرًا لك

53
00:04:17,950 --> 00:04:19,800
.لكنّني لا أستطيع

54
00:04:19,800 --> 00:04:21,330
هل للأمر علاقة بساكاغوتشي-سان؟

55
00:04:21,330 --> 00:04:22,090
.نعم

56
00:04:22,710 --> 00:04:24,070
.لكنّ هذا ليس السّبب الوحيد

57
00:04:24,960 --> 00:04:29,450
إن لم أفعل شيئًا، فلقائي معك
.سيغدو كذبة أيضًا

58
00:04:31,080 --> 00:04:33,730
أنت "لريغ" محاطة بالبؤس، صحيح؟

59
00:04:33,730 --> 00:04:37,470
.تجلبين البؤس لكلّ منتقٍ تلتقينه

60
00:04:38,790 --> 00:04:41,920
...مثل تلك الفتاة أوي أكيرا

61
00:04:42,550 --> 00:04:46,830
لا حاجلة لي بسماع هذا من شخص
.يستمتع بمشاهدة ذلك يحدث

62
00:04:46,830 --> 00:04:48,600
.لا تسيئي فهمي

63
00:04:48,600 --> 00:04:51,910
.أنا أحبّك

64
00:04:51,910 --> 00:04:55,140
.لا أحد يأتي إلى هنا كثيرًا مثلك

65
00:04:56,260 --> 00:05:00,430
.تُسحق أمنية فتاة أخرى في كلّ مرّة تأتين

66
00:05:01,370 --> 00:05:07,390
وما عدتِ تشعرين بأيّ شيء
.عندما تسحقينهنّ

67
00:05:08,090 --> 00:05:09,580
.كم أحبّ هذا

68
00:05:10,220 --> 00:05:13,460
من ستدمّرين بعد هذا؟

69
00:05:13,460 --> 00:05:16,300
...كما فعلتِ لتلك الفتاة ساكاغوتشي

70
00:05:18,460 --> 00:05:20,680
.لا أطيق الانتظار حتّى أعرف

71
00:05:29,460 --> 00:05:34,250
عفوًا... ’هذه "لريغ" وستكون أفتارك‘؟

72
00:05:40,210 --> 00:05:42,320
.لا أفهم الأمر

73
00:05:42,320 --> 00:05:44,820
ساكاغوتشي؟

74
00:05:46,670 --> 00:05:48,290
...بيرولوك

75
00:05:48,290 --> 00:05:50,660
هل أنت من ستحقّق أمنيتي؟

76
00:05:50,660 --> 00:05:52,410
.ذلك تخمين مقبول

77
00:05:52,880 --> 00:05:55,690
،فوزي بما يكفي من المعارك
.وستتحقّق أمنيتك

78
00:05:55,690 --> 00:05:58,830
هل يمكن للأمنية أن تكون
لشخص آخر عداي؟

79
00:05:58,830 --> 00:06:01,660
.نعم، ما دامت ما تتمنّينه بحقّ

80
00:06:02,930 --> 00:06:05,590
.أمّي مريضة

81
00:06:06,760 --> 00:06:10,270
هل ستتحقّق أمنيتي إن تمنّيتُ إنقاذها؟

82
00:06:11,590 --> 00:06:14,010
...إن فزت بما يكفي من معارك

83
00:06:14,540 --> 00:06:16,480
.ذكّرني وجهها بساكاغوتشي

84
00:06:16,910 --> 00:06:18,440
،ذلك كلّ ما ذكّرني بها

85
00:06:19,160 --> 00:06:20,900
.أو ذلك ما ظننت في البداية

86
00:06:21,440 --> 00:06:22,240
...لكن

87
00:06:23,180 --> 00:06:27,060
كنتُ خائفة للغاية عندما
.عرفتُ أنّ أمّي مريضة

88
00:06:27,060 --> 00:06:30,450
كنتُ قلقة للغاية ولم أستطيع
.التكلّم مع أيّ أحد

89
00:06:30,970 --> 00:06:35,160
لهذا السّبب كنتُ جدّ سعيدة عندما
.أصبح لديّ من أكلّمه يا بيرولوك

90
00:06:35,820 --> 00:06:40,000
.كما أنّني أحببتك من أوّل لحظة رأيتك فيها

91
00:06:40,370 --> 00:06:42,630
.من المضحك كم أنّ وجهك يبدو متجهّمًا

92
00:06:44,620 --> 00:06:48,720
!مهلاً، لا! قصدتُ ذلك بطريقة ظريفة

93
00:06:51,790 --> 00:06:54,510
.لا تملك "لريغ" أيّ قوى خاصّة

94
00:06:54,510 --> 00:06:57,860
تخلّصي منّي وتوقّفي عن المشاركة
.في معارك المنتقين

95
00:07:09,670 --> 00:07:13,320
ماذا؟ أهذه أنت يا كيوي-تشان؟

96
00:07:13,730 --> 00:07:15,030
!ريمامبر

97
00:07:15,330 --> 00:07:16,440
كيوي؟

98
00:07:16,440 --> 00:07:18,320
!مرّ وقت طويل

99
00:07:18,320 --> 00:07:20,240
إنّها منتقية الآن؟

100
00:07:20,240 --> 00:07:23,080
ماذا؟ ماذا تعنين يا بيرولوك؟

101
00:07:24,500 --> 00:07:27,040
اسمك هو بيرولوك الآن؟

102
00:07:28,000 --> 00:07:31,040
.كان هذا الجسد لها في السّابق

103
00:07:31,040 --> 00:07:32,840
.كان اسمها هو ميزوشيما كيوي-تشان

104
00:07:34,220 --> 00:07:36,840
.كنتُ "لريغ" الخاصّة بكيوي-تشان

105
00:07:36,840 --> 00:07:40,150
فازت كيوي-تشان بمعارك كافية
."لتصبح "فتاة أبديّة

106
00:07:40,150 --> 00:07:42,100
.ثمّ بدّلت الأماكن معي

107
00:07:42,100 --> 00:07:43,560
بدّلت الأماكن؟

108
00:07:44,590 --> 00:07:49,410
مقابل تحقيق أمنياتهم، يجب على
."المنتقين أن يصبحوا "لريغ

109
00:07:50,060 --> 00:07:51,960
.تلك هي القاعدة

110
00:07:51,960 --> 00:07:52,760
...مستحيل

111
00:07:52,760 --> 00:07:55,800
.لكن لا تقلقي

112
00:07:55,800 --> 00:07:59,790
.ستحقّق "لريغ" الّتي تأخذ مكان المنتقي الأمنية

113
00:08:01,330 --> 00:08:05,920
.لقد حقّقتُ أمنية كيوي-تشان

114
00:08:05,920 --> 00:08:08,500
."كانت "أريد إنقاذ صديقتي الّتي في المستشفى

115
00:08:08,500 --> 00:08:10,130
صحيح يا كيوي-تشان؟

116
00:08:12,140 --> 00:08:14,860
لديك أمنية أيضًا، صحيح؟

117
00:08:14,860 --> 00:08:16,090
.لذلك دعينا نتقاتل

118
00:08:16,090 --> 00:08:17,610
...ولكنّني

119
00:08:16,090 --> 00:08:18,470
...كنّا محظوظات بما يكفي لنلتقي

120
00:08:17,610 --> 00:08:18,470
!كلاّ يا أميكا

121
00:08:18,800 --> 00:08:21,740
!لقد خسرتِ مرّتين
...إن خسرتِ مرّة أخرى

122
00:08:23,780 --> 00:08:26,060
مرحبًا يا أبي. ماذا هنالك؟

123
00:08:27,360 --> 00:08:28,790
...أمّي قد

124
00:08:30,100 --> 00:08:32,300
!حسنًا. سأذهب للمستشفى في الحال

125
00:08:32,300 --> 00:08:33,280
...أميكا

126
00:08:34,150 --> 00:08:35,720
...لكن أوّلاً

127
00:08:37,040 --> 00:08:38,200
.لنقم بالأمر

128
00:08:39,200 --> 00:08:40,910
!أميكا، تخلّصي منّي

129
00:08:40,910 --> 00:08:42,790
!أريد إنقاذ أمّي

130
00:08:42,790 --> 00:08:43,910
!فتح

131
00:08:52,400 --> 00:08:55,750
،"حتّى إن استبدلت الأماكن مع "لريغ
.فلن تتحقّق أمنيتك

132
00:08:55,750 --> 00:08:58,810
،وإن خسرتِ ثلاث مرّات
.يحدث عكس ما كنت تتمنّينه

133
00:08:59,420 --> 00:09:00,140
...ممّا يعني

134
00:09:02,100 --> 00:09:04,940
.سيكون من المستحيل إنقاذ أمّك

135
00:09:09,340 --> 00:09:10,580
...كاذبة

136
00:09:11,420 --> 00:09:13,530
كذبتِ عليّ؟

137
00:09:13,730 --> 00:09:15,400
!لقد وثقت بك

138
00:09:15,640 --> 00:09:17,110
لماذا؟

139
00:09:18,500 --> 00:09:23,700
.لقد ضحّيتُ بمنتقيات كثيرات لأنتقم من ريمامبر

140
00:09:24,250 --> 00:09:25,710
.أنت واحدة أخرى مثلهنّ فحسب

141
00:09:26,190 --> 00:09:29,170
.لكنّني عدلتُ عن ذلك عندما قابلتك

142
00:09:30,200 --> 00:09:32,420
.لأنّك كنتِ تشبهين ساكاغوتشي

143
00:09:33,650 --> 00:09:36,950
...كان عليّ تركك باكرًا

144
00:09:36,950 --> 00:09:39,270
!لكنّني لم أستطع

145
00:09:39,800 --> 00:09:44,300
لأنّني شعرت وكأنّني لا أرغب
...في تركك أبدًا

146
00:09:47,300 --> 00:09:49,610
.آسفة يا أميكا

147
00:09:49,870 --> 00:09:51,090
...بيرولوك

148
00:09:56,970 --> 00:09:58,740
.سأغيّر أمنيتي

149
00:09:59,400 --> 00:10:01,300
.أريد إنقاذ أمّي

150
00:10:01,300 --> 00:10:03,910
،لكن إن كان ذلك مستحيلاً

151
00:10:05,260 --> 00:10:08,550
!أريد جعلك بشريّة ثانية

152
00:10:09,280 --> 00:10:10,750
.لأنّك صديقتي

153
00:10:12,220 --> 00:10:13,710
...أميكا

154
00:10:13,710 --> 00:10:16,780
ماذا؟ أهذا كلّ ما تتمنّينه؟

155
00:10:16,780 --> 00:10:19,590
!لكنّني سأفوز في كلّ الأحوال

156
00:10:27,400 --> 00:10:28,620
!هجوم

157
00:10:34,980 --> 00:10:36,490
!بيرولوك، اكبري

158
00:10:41,870 --> 00:10:43,080
المستوى 5؟

159
00:10:49,160 --> 00:10:52,890
.ستنتهي المعركة في هذا الدّور يا أميكا

160
00:10:54,040 --> 00:10:57,010
هلاّ وثقتِ بي مرّة أخيرة؟

161
00:10:57,310 --> 00:10:59,840
.نعم يا كيوي

162
00:11:02,420 --> 00:11:04,010
!"تحليل اختلاس النّظر"

163
00:11:09,330 --> 00:11:10,440
.إنهاء الدّور

164
00:11:10,440 --> 00:11:12,030
لن تهاجم؟

165
00:11:12,030 --> 00:11:14,770
...لا أعرف ما تسعى إليه، ولكن

166
00:11:18,900 --> 00:11:21,540
!سوف آخذ هذا الفوز السّهل

167
00:11:24,730 --> 00:11:25,820
!كيوي

168
00:11:27,750 --> 00:11:30,580
لقد تخلّت عن فرصتها بالفوز؟

169
00:11:33,190 --> 00:11:38,210
"حوّلت الزّيادة في المستوى "تحليل اختلاس النّظر
.إلى القدرة على تغيير إرادة شخص ما

170
00:11:38,660 --> 00:11:42,470
لقد استحوذتُ على عقل أميكا
.وأعدتُ كتابة أمنيتها

171
00:11:42,670 --> 00:11:46,300
أصبحت أمنيتها الجديدة هي
."أريد فقدان أمّي"

172
00:11:46,540 --> 00:11:49,770
.قواعد معارك المنتقين عديمة الرّحمة ومحدّدة

173
00:11:49,770 --> 00:11:52,230
.وبخسارتها، سيحدث عكس ما تمنّته

174
00:11:52,520 --> 00:11:56,190
!لن تفقد أمّها أبدًا

175
00:11:58,560 --> 00:12:01,180
تخلّيتِ عن فرصتك الوحيدة؟

176
00:12:01,180 --> 00:12:03,070
هل أنت غبيّة؟

177
00:12:03,330 --> 00:12:06,640
.حسنًا، أشكّ أنّنا سنلتقي ثانية

178
00:12:07,080 --> 00:12:08,340
!وداعًا

179
00:12:42,500 --> 00:12:44,400
.أشعر بالخيانة

180
00:12:44,840 --> 00:12:48,700
لقد تمكّنت بكلّ بساطة من الحصول
.على ما أريده بينما احترمتُ القواعد

181
00:12:48,700 --> 00:12:51,240
.عليّ معاقبتك

182
00:12:53,260 --> 00:12:56,420
ما رأيك أن أمحيك من الوجود فحسب؟

183
00:12:56,420 --> 00:12:56,960
.هكذا إذًا

184
00:12:58,550 --> 00:13:00,230
.لا تبدين خائفة أبدًا

185
00:13:00,230 --> 00:13:02,460
!ستختفين! ستُمحين من الوجود

186
00:13:02,940 --> 00:13:05,860
.لقد آذيتُ الكثير من الفتيات

187
00:13:06,560 --> 00:13:08,520
.يجب أن أُعاقب على ذلك

188
00:13:08,520 --> 00:13:09,680
!أنت مجنونة

189
00:13:09,680 --> 00:13:14,540
لماذا لا تصرخين قائلة "لا أريد
أن أختفي! لا أريد الموت!"؟

190
00:13:15,840 --> 00:13:17,180
.ما عاد ذلك يهمّ الآن

191
00:13:18,740 --> 00:13:21,530
