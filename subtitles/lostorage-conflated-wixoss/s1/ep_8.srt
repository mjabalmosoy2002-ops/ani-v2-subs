00:13:05,170 --> 00:13:08,210
...إن قاتلتِ دون أن تقلقي بشأني، فسوف

197
00:13:08,210 --> 00:13:10,850
!لكنّني أعرف أنّها لن تفعل

198
00:13:12,400 --> 00:13:14,810
!ذلك ليس من طباعها

199
00:13:21,160 --> 00:13:22,320
ما الخطب يا أميكا؟

200
00:13:23,200 --> 00:13:25,700
.لا شيء

201
00:13:26,080 --> 00:13:28,360
أجبرت كيوي نفسها على حمل
الكثير من الأعباء

202
00:13:28,360 --> 00:13:30,020
.وقاتلت بمفردها

203
00:13:30,700 --> 00:13:31,660
...لذلك

204
00:13:34,560 --> 00:13:36,440
...لذلك أستطيع أيضًا

205
00:13:44,580 --> 00:13:47,510
هل انتهينا بهذه السّرعة يا كيوي-تشان؟

206
00:13:47,980 --> 00:13:50,420
!هذا ممتع للغاية

207
00:13:50,420 --> 00:13:53,760
ضرب شخص ما بينما لا يستطيع
!القتال له وشعور رائع

208
00:13:53,760 --> 00:13:56,350
!وكأنّ دوري لا ينتهي

209
00:13:58,280 --> 00:13:59,980
!توقّفا

210
00:14:01,220 --> 00:14:03,230
.لا تفعلي ذلك

211
00:14:03,230 --> 00:14:06,730
!أريد اللّعب مع كيوي-تشان

212
00:14:06,730 --> 00:14:09,410
لديك أمنية يا كيوي، صحيح؟

213
00:14:09,970 --> 00:14:12,290
!إنهاء دائرة الظّلام هذه

214
00:14:13,100 --> 00:14:13,950
...بيرولوك

215
00:14:15,000 --> 00:14:16,240
!اغربي

216
00:14:16,240 --> 00:14:20,000
!لا تنسي أنّ لديّ رهينة

217
00:14:20,630 --> 00:14:23,040
!هيّا يا بيرولوك-تشان

218
00:14:23,040 --> 00:14:25,180
!يا لك من صديقة نبيلة

219
00:14:25,180 --> 00:14:27,450
.إيّاك وإزعاج نفسك بالمقاومة

220
00:14:27,450 --> 00:14:29,860
!استسلمي فحسب

221
00:14:34,060 --> 00:14:35,730
...توقّفي فحسب

222
00:14:36,300 --> 00:14:38,550
...لا أستطيع

223
00:14:39,240 --> 00:14:43,770
!كيوي

224
00:14:44,720 --> 00:14:45,650
!أميكا

225
00:14:46,040 --> 00:14:48,220
!كيوي

226
00:14:48,220 --> 00:14:49,100
.سُحقًا

227
00:14:49,100 --> 00:14:50,360
!لقد هربت

228
00:14:51,430 --> 00:14:52,820
!أنا بخير

229
00:14:53,450 --> 00:14:54,700
!لستُ مصابة

230
00:14:56,600 --> 00:14:57,410
...أميكا

231
00:14:58,400 --> 00:14:59,210
!آسفة

232
00:15:00,000 --> 00:15:01,200
!كيوي

233
00:15:02,560 --> 00:15:06,300
...أنا لست منتقية، لذلك لا يمكنني مساعدتك

234
00:15:07,130 --> 00:15:09,930
.من المؤلم تركك تقاتلين وحدك

235
00:15:10,320 --> 00:15:14,680
...لكن إن كانت حامية نفسي ستساعدك

236
00:15:16,160 --> 00:15:18,770
!فأنا أثق بك

237
00:15:18,770 --> 00:15:21,230
!لذلك ثقي بي أيضًا

238
00:15:21,680 --> 00:15:23,030
!وقاتلي

239
00:15:24,680 --> 00:15:26,150
...أميكا

240
00:15:26,520 --> 00:15:28,310
.اخرسي

241
00:15:28,310 --> 00:15:29,650
.كان قد بدأ الأمر يصبح جيّدًا

242
00:15:29,650 --> 00:15:31,680
!لا تقفي في طريقي

243
00:15:33,090 --> 00:15:35,000
انتهت هجماتك، صحيح؟

244
00:15:36,990 --> 00:15:39,000
.قوليها إذًا

245
00:15:41,260 --> 00:15:42,580
.إنهاء الدّور

246
00:15:44,720 --> 00:15:46,510
.إنّه دوري

247
00:15:46,510 --> 00:15:47,440
.اكبري

248
00:15:49,040 --> 00:15:50,760
."استدعاء اثنين "مانومين

249
00:15:51,250 --> 00:15:53,130
.بقيت لديك عُملة واحدة

250
00:15:53,720 --> 00:15:57,720
هل تعرفين ما يحدث عندما
تخسرين كلّ عملاتك؟

251
00:15:58,000 --> 00:15:58,800
.اخرسي

252
00:15:58,800 --> 00:15:59,980
.لا أهتمّ

253
00:16:00,390 --> 00:16:03,730
.يختفي كيانك بالكامل عن الوجود

254
00:16:04,010 --> 00:16:04,790
ماذا؟

255
00:16:04,790 --> 00:16:06,990
...يا إلهي يا كيوي-تشان

256
00:16:06,990 --> 00:16:09,080
.لا تخبريها بذلك

257
00:16:09,080 --> 00:16:12,110
.كنتُ سأخبرها في الوقت المناسب

258
00:16:12,570 --> 00:16:16,280
...المنتقية الّتي تفقد كلّ عُملاتها، تختفي

259
00:16:16,280 --> 00:16:17,710
.من هذا العالم

260
00:16:17,710 --> 00:16:19,950
!لا تعود موجودة باختصار

261
00:16:20,520 --> 00:16:22,290
ماذا؟

262
00:16:22,520 --> 00:16:25,890
.كنت غير متأكّدة حتّى الآن

263
00:16:26,360 --> 00:16:28,940
حتّى إن كان عليّ القيام بالأمر
،لإنهاء معارك المنتقين

264
00:16:28,940 --> 00:16:31,010
لم أعلم إن كان من المسموح
.بالوصول إلى ذلك الحدّ

265
00:16:31,340 --> 00:16:33,720
.لكنّني لن أتردّد بعد الآن

266
00:16:34,240 --> 00:16:37,790
،من أجل صالحي وصالح كلّ من أعرفهم

267
00:16:37,790 --> 00:16:39,720
!سأنهي معارك المنتقين

268
00:16:40,600 --> 00:16:41,790
...لذلك

269
00:16:41,790 --> 00:16:43,180
!لن أخسر أمامك

270
00:16:43,420 --> 00:16:46,440
هل تقولين أنّ ستجعلين أكيرا-تشان
تختفي من الوجود؟

271
00:16:49,360 --> 00:16:50,690
!هذا ممتاز

272
00:16:50,690 --> 00:16:52,430
سأختفي؟

273
00:16:52,430 --> 00:16:53,820
!لا بأس بذلك عندي

274
00:16:54,120 --> 00:16:59,080
لا أهتمّ أبدًا إن خسرت هذه الحياة
!العفنة وكلّ هذه النّدب

275
00:16:59,830 --> 00:17:00,890
.بيرولوك

276
00:17:00,890 --> 00:17:02,070
.حسنًا

277
00:17:02,070 --> 00:17:03,920
!"أسوأ ظرف"

278
00:17:11,080 --> 00:17:12,050
.إنهاء الدّور

279
00:17:12,280 --> 00:17:13,320
!حسنًا

280
00:17:13,320 --> 00:17:15,380
!لنقم بهذا! رهان العُملة

281
00:17:15,380 --> 00:17:16,510
!"التّنجيم"

282
00:17:20,180 --> 00:17:22,880
.سأكتشف تمامًا ما هو هجومك التّالي

283
00:17:25,020 --> 00:17:26,350
...يمكنني إخبارك

284
00:17:27,460 --> 00:17:28,480
!أنّه لا يمكنني إخبارك

285
00:17:29,200 --> 00:17:31,510
هل تحاولين العبث معي يا هذه؟

286
00:17:31,510 --> 00:17:33,600
كلاّ، نتيجة قراءة الطّالع

287
00:17:33,600 --> 00:17:37,490
.هي أنّنا لا نعرف ماذا سيكون الهجوم التّالي

288
00:17:37,490 --> 00:17:40,420
!ماذا؟ ما هذا؟

289
00:17:40,420 --> 00:17:42,200
.أنا سأخبرك

290
00:17:42,630 --> 00:17:45,330
.تحرير". رهان العُملة"

291
00:17:50,010 --> 00:17:53,760
،سوف تستريح بيرورون قليلاً
!لذلك أتت ميلولون

292
00:17:53,760 --> 00:17:55,590
.ميلولون، رهان العُملة

293
00:17:55,820 --> 00:17:57,500
!"حدوث"

294
00:17:58,840 --> 00:18:01,180
!سرقتِ ذلك منّي

295
00:18:10,920 --> 00:18:12,120
سوف أختفي؟

296
00:18:13,100 --> 00:18:14,650
هل سأختفي بالفعل؟

297
00:18:15,390 --> 00:18:17,940
.لا يمكن... مستحيل

298
00:18:17,940 --> 00:18:20,580
!هذا لا يمكن

299
00:18:20,580 --> 00:18:22,220
!لا تعبثن معي

300
00:18:22,220 --> 00:18:24,600
!ما زال هنالك الكثير أريد فعله

301
00:18:24,600 --> 00:18:26,030
!لديّ عمل

302
00:18:26,030 --> 00:18:28,740
!صحيح! لديّ تصوير غدًا

303
00:18:28,740 --> 00:18:30,290
.إنّها جلسة تصوير ملابس سباحة هذه المرّة

304
00:18:30,290 --> 00:18:31,600
،إنّها منحرفة قليلاً

305
00:18:31,600 --> 00:18:35,840
لكنّ مديري قال إنّ لديّ جسدًا
!جميلاً، لذلك سنحقّق أرباحًا

306
00:18:36,480 --> 00:18:39,050
!ومعجبيّ يتطلّعون قدمًا للأمر

307
00:18:39,050 --> 00:18:41,810
...لذلك... لذلك

308
00:18:42,680 --> 00:18:46,120
!لا أريد أن أختفي

309
00:18:52,840 --> 00:18:55,390
...اسمي هو أوي أكيرا

310
00:18:55,390 --> 00:18:58,400
.فتاة ثانويّة جميلة وعارضة مشهورة

311
00:18:58,780 --> 00:19:01,280
."من هواياتي التّسوّق ولعب "ويكروس

312
00:19:01,610 --> 00:19:04,530
...طعامي المفضّل هو الفراولة والبطّيخ

313
00:19:04,800 --> 00:19:12,750
!لا أريد أن أختفي

314
00:19:13,590 --> 00:19:15,130
...وجهك مخيف جدًّا

315
00:19:15,130 --> 00:19:17,710
.أنا أكرهك بشدّة يا كيوي-تشان

316
00:19:17,960 --> 00:19:19,280
.يا لها من صدفة

317
00:19:19,280 --> 00:19:22,470
.أنا أكرهك أيضًا

318
00:19:37,630 --> 00:19:39,940
...سوف أختفي

319
00:19:55,790 --> 00:19:59,070
إذًا هذا ما يعني أن نختفي؟

320
00:20:06,470 --> 00:20:07,470
!كيوي

321
00:20:07,980 --> 00:20:09,350
!أميكا

322
00:20:09,830 --> 00:20:11,230
هل أنت بخير؟

323
00:20:11,230 --> 00:20:12,700
هل تأذّيتِ؟

324
00:20:14,520 --> 00:20:16,110
.كنتُ خائفة

325
00:20:16,710 --> 00:20:18,930
.ظننتُ أنّي سأفقدك

326
00:20:21,770 --> 00:20:24,700
تعرفين الآن كيف أشعر، صحيح؟

327
00:20:32,200 --> 00:20:33,460
.أنا آسفة

328
00:20:34,380 --> 00:20:35,500
.شكرًا لك

329
00:20:36,240 --> 00:20:37,720
!حسنًا، سامحتك

330
00:20:42,630 --> 00:20:45,590
كيوي، لديك خمس عُملات الآن، صحيح؟

331
00:20:46,310 --> 00:20:47,920
...بالتّفكير في الأمر

332
00:20:47,920 --> 00:20:48,930
...لكن

333
00:20:48,930 --> 00:20:50,680
.لم يتغيّر أيّ شيء

334
00:20:51,140 --> 00:20:52,650
ماذا يحدث؟

335
00:20:52,650 --> 00:20:55,940
لن تنتهي المعارك حتّى إن حصلنا
على خمس عُملات؟

336
00:20:56,470 --> 00:20:58,930
.لم يتمّ إخباري أيّ شيء أيضًا

337
00:20:58,930 --> 00:21:01,440
.لم يتمّ إخباري حتّى عن كيفية الفوز

338
00:21:01,700 --> 00:21:02,780
...مستحيل

339
00:21:03,390 --> 00:21:04,700
...كيوي

340
00:21:05,200 --> 00:21:08,200
العُملات الخمس ليست شرط الفوز؟

341
00:21:13,070 --> 00:21:14,380
.صدمة

342
00:21:14,380 --> 00:21:15,670
ما معنى هذا؟

343
00:21:16,160 --> 00:21:17,380
...كلاّ

344
00:21:17,380 --> 00:21:19,590
إن لم ينتهي الأمر بعد الحصول
،على خمس عُملات

345
00:21:20,190 --> 00:21:23,130
كيف يمكنني إذًا استعادة ذكريات تشي-تشان؟

346
00:21:36,520 --> 00:21:40,020
.وجدتُك أخيرًا يا ثقب المفتاح

347
00:21:41,880 --> 00:21:44,940
...لقد عدت يا تاما ويوزوكي

348
00:21:48,440 --> 00:21:49,450
!تاما؟

349
00:23:26,480 --> 00:23:29,490
.لا جدوى من هزيمتك إلاّ أن كنت جادّة

350
00:23:28,450 --> 00:23:31,100
شرط الفوز مختلف هذه المرّة؟

351
00:23:30,240 --> 00:23:32,790
من المستحيل استعادة ذكرياتك؟

352
00:23:32,790 --> 00:23:34,320
تمّ اختيارها الآن؟

353
00:23:34,320 --> 00:23:35,930
.قد نستطيع استعادة تاما

354
00:23:35,930 --> 00:23:38,560
!سأطيح بك أوّلاً

355
00:23:38,560 --> 00:23:40,940
."تواصل، مفتاح وثقب مفتاح"