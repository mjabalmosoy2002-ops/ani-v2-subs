1
00:00:09,000 --> 00:00:10,060
!فتح

2
00:01:44,540 --> 00:01:46,500
هانا-تشان؟ ماذا هنالك؟

3
00:01:46,500 --> 00:01:48,460
،سؤال. يا سوزوكو-سان

4
00:01:48,460 --> 00:01:51,130
هل سمعتِ أيّ إشاعات عن معارك المنتقين؟

5
00:01:51,130 --> 00:01:52,450
.كلاّ

6
00:01:52,450 --> 00:01:53,410
.عُلم

7
00:01:53,940 --> 00:01:56,250
لماذا؟ هل حدث أمر ما؟

8
00:01:56,250 --> 00:01:58,550
.نكران. لا شيء على وجه التّحديد

9
00:01:58,550 --> 00:02:00,820
هل تذكرين ما قالته ميزوشيما-سان؟

10
00:02:00,820 --> 00:02:02,820
.سوف تبدأ المعارك ثانية

11
00:02:02,820 --> 00:02:05,440
.لذلك أجمع المعلومات من باب الحيطة

12
00:02:05,440 --> 00:02:06,080
...لكن

13
00:02:06,080 --> 00:02:08,770
.مفهوم. لا داعي للقلق

14
00:02:08,770 --> 00:02:11,820
.لا أريد التّورّط في المعارك أيضًا

15
00:02:17,000 --> 00:02:18,800
،مهلاً يا هانا-ساما

16
00:02:18,800 --> 00:02:22,530
لن تخبريها أنّه قد تمّ اختيارك كمنتقية؟

17
00:02:22,920 --> 00:02:23,790
.غباء

18
00:02:23,790 --> 00:02:26,080
،يبدو أنّه لم يتمّ اختيار سوزوكو-سان

19
00:02:26,080 --> 00:02:28,290
.لذلك لا حاجة لإخبارها

20
00:02:28,730 --> 00:02:30,730
.أنت لطيفة للغاية

21
00:02:31,960 --> 00:02:33,240
.طلب

22
00:02:33,240 --> 00:02:35,660
.في الحقيقة، هنالك أمر أردت أن أطلبه منك

23
00:02:35,660 --> 00:02:38,630
.أعطيني تفاصيل أكثر عن هذه المعارك

24
00:02:38,630 --> 00:02:42,930
.لا أعرف أكثر ممّا أخبرتك به البارحة

25
00:02:43,530 --> 00:02:44,030
...مهلاً

26
00:02:44,310 --> 00:02:47,200
...ربّما أعرف شيئًا آخر بالفعل

27
00:02:47,200 --> 00:02:48,770
.لكنّني نسيت

28
00:02:50,230 --> 00:02:52,040
سوف تمزّقينني؟

29
00:02:52,040 --> 00:02:54,630
!كلاّ! توقّفي

30
00:02:56,160 --> 00:03:00,020
،هانا-ساما، عندما لم أخبرك بشأن أخيك

31
00:03:00,020 --> 00:03:02,060
.لم تفعلي أيّ شيء لي

32
00:03:02,060 --> 00:03:06,010
يمكنك معاقبتي الآن عن طريق
.تعذيبي إن أردتِ

33
00:03:06,010 --> 00:03:06,920
.رفض

34
00:03:07,790 --> 00:03:10,600
.كانت تلك تجربة ضروريّة لي

35
00:03:10,600 --> 00:03:13,700
.لذلك أنا ممتنّة لك يا ناناشي-تشان

36
00:03:13,700 --> 00:03:15,440
أهذا صحيح؟

37
00:03:15,440 --> 00:03:16,710
.يا للأسف

38
00:03:22,480 --> 00:03:24,600
.لقد أصيبت هيتوي بالزّكام اليوم

39
00:03:24,880 --> 00:03:26,130
.وصلتني رسالة بذلك

40
00:03:27,230 --> 00:03:29,340
!روكو؟ روكو

41
00:03:30,730 --> 00:03:31,850
...آسفة

42
00:03:31,850 --> 00:03:33,080
ماذا قلتِ؟

43
00:03:36,320 --> 00:03:39,050
،إن أردتِ الحديث مع أحد ما
.فأنا هنا دائمًا من أجلك

44
00:03:39,050 --> 00:03:40,690
...يوزوكي

45
00:03:42,660 --> 00:03:45,570
ما زالت معارك المنتقين متواصلة؟

46
00:03:45,570 --> 00:03:48,790
.نعم، ذلك ما قالته فتاة تُدعى ميزوشيما-سان

47
00:03:49,220 --> 00:03:51,570
لكنّك وضعتِ حدًّا لها، صحيح؟

48
00:03:51,570 --> 00:03:53,760
.لكنّها قالت أنّ المعارك لم تنتهِ

49
00:03:53,760 --> 00:03:54,540
...كلاّ

50
00:03:54,540 --> 00:03:58,800
...لذا طلبت منّي مساعدتها على إنهائها للأبد

51
00:03:58,800 --> 00:04:00,200
!حسنًا

52
00:04:00,680 --> 00:04:03,250
.لكنّني رفضت

53
00:04:04,060 --> 00:04:07,140
هل كان ذلك القرار الصّائب بالفعل؟

54
00:04:07,920 --> 00:04:09,180
.بالطّبع

55
00:04:09,640 --> 00:04:12,040
.قمتِ بما يكفي في آخر مرّة

56
00:04:12,040 --> 00:04:13,810
.لم تعد مشكلتك الآن

57
00:04:15,590 --> 00:04:16,340
...نعم

58
00:04:21,220 --> 00:04:23,050
هيتوي، هل أنت بخير؟

59
00:04:25,740 --> 00:04:27,570
.أنا بخير يا ميدوريكو

60
00:04:27,570 --> 00:04:29,200
!بل يا ميدوري-سان

61
00:04:29,530 --> 00:04:31,420
.لا بأس بمناداتي ميدوريكو

62
00:04:31,420 --> 00:04:33,630
.آسفة، لم أكن أفكّر

63
00:04:33,630 --> 00:04:34,460
.لا بأس

64
00:04:34,990 --> 00:04:37,580
على أيّ حال، لماذا بقيتِ في المنزل
بدل الذّهاب للمدرسة؟

65
00:04:38,460 --> 00:04:40,460
.أردتُ الاستعداد

66
00:04:41,270 --> 00:04:45,240
.هنالك أشياء جديد مثل العُملات وأوراق المفاتيح

67
00:04:45,240 --> 00:04:46,470
تستعدّين للقتال؟

68
00:04:46,800 --> 00:04:50,310
،إن خسرت هذه المرّة
سأفقد ذكرياتي، صحيح؟

69
00:04:50,520 --> 00:04:54,390
.هنالك ذكريات عديدة لا أريد فقدانها

70
00:04:54,690 --> 00:04:55,650
...هيتوي

71
00:04:56,230 --> 00:04:57,230
ماذا ستفعلين بعد المدرسة؟

72
00:04:56,230 --> 00:04:57,230
.هنالك مكان أريد المرور عليه

73
00:04:56,230 --> 00:04:57,230
هل له علاقة بمعارك المنتقين؟

74
00:04:56,230 --> 00:04:57,230
.نعم

75
00:04:56,230 --> 00:04:57,230
ماذا حدث؟

76
00:04:56,230 --> 00:04:57,230
.لا شيء، أريد البحث في أمر ما فحسب

77
00:05:00,730 --> 00:05:02,360
.أريد المساعدة
.أخبريني إن طرأ أمر ما

78
00:05:03,740 --> 00:05:06,950
.أريد المساعدة
.أخبريني إن طرأ أمر ما
.شكرًا لك. لكن لا يحدث أيّ شيء الآن

79
00:05:08,650 --> 00:05:09,610
.بيرولوك

80
00:05:09,610 --> 00:05:10,200
ماذا؟

81
00:05:12,120 --> 00:05:15,550
بدأنا بثلاث عُملات هذه المرّة، صحيح؟

82
00:05:15,550 --> 00:05:16,380
.نعم

83
00:05:16,380 --> 00:05:17,870
.يبدأ الجميع بثلاثة

84
00:05:18,300 --> 00:05:23,090
هل تحتوي هذه العُملات الذّكريات
الّتي فقدتُها آخر مرّة؟

85
00:05:23,090 --> 00:05:27,930
كلاّ. هذه العُملات هي ذكرياتك
.وقد قُسّمت إلى خمسة أجزاء

86
00:05:27,930 --> 00:05:32,590
،لكن إن فزتِ بكلّ المعارك
.يمكنك تعديل واحدة من ذكرياتك

87
00:05:32,590 --> 00:05:36,100
ستكونين قادرة على استعادة
.ذكرياتك السّابقة بهذه الطّريقة

88
00:05:36,580 --> 00:05:38,350
...وورقة المفتاح أيضًا

89
00:05:38,350 --> 00:05:41,820
،القواعد الأساسيّة للمعارك لم تتغيّر

90
00:05:41,820 --> 00:05:45,900
لكنّ هذا العنصر الجديد يسمح لك
.بتغيير قدرات عُملتك

91
00:05:46,350 --> 00:05:47,580
تغييرها؟

92
00:05:47,580 --> 00:05:49,890
...لا أدري ماذا سيحدث

93
00:05:49,890 --> 00:05:53,120
.لكن أعتقد أنّ هذه الأوراق ستحدّد الفائز

94
00:05:53,600 --> 00:05:57,500
إذًا أحتاج لتجربة كيفية عملها في معركة؟

95
00:05:58,040 --> 00:05:59,200
.آسفة

96
00:05:59,200 --> 00:06:01,470
.لا داعي للاعتذار لي

97
00:06:02,840 --> 00:06:07,040
.بيرولوك، لديّ أمنية أخرى

98
00:06:07,550 --> 00:06:10,680
.أريد إنهاء دائرة الظّلام هذه

99
00:06:11,550 --> 00:06:12,810
.كوني حذرة

100
00:06:13,390 --> 00:06:17,900
يبدو أنّ ما خفي بشأن هذه المعارك
.الجديدة أعظم ممّا هو ظاهرٌ منها

101
00:06:18,640 --> 00:06:20,800
،كان التّدريب صعبًا جدًّا هذا الصّباح

102
00:06:20,800 --> 00:06:23,820
!لذلك شعرت بالنّعاس عندما تناولت غدائي

103
00:06:24,220 --> 00:06:25,920
.كنتُ شبه نائمة في الحقيقة

104
00:06:25,920 --> 00:06:27,900
!لا يفترض بك أن تنامي

105
00:06:28,130 --> 00:06:30,910
،لكنّني كنت شبه مستيقظة أيضًا
!لذلك لا بأس

106
00:06:30,910 --> 00:06:32,240
...يا إلهي

107
00:06:34,760 --> 00:06:38,410
.حينها، كنتُ أنا من يغلبها النّعاس

108
00:06:39,800 --> 00:06:41,270
تشي-تشان؟

109
00:06:41,270 --> 00:06:41,920
ماذا؟

110
00:06:42,380 --> 00:06:46,130
لماذا صدّقتِ أنّنا كنّا صديقتا طفولة؟

111
00:06:46,130 --> 00:06:48,240
...لماذا

112
00:06:49,360 --> 00:06:53,600
لم أتخيّل أنّك قد تكذبين فحسب، على ما أظنّ؟

113
00:06:55,060 --> 00:07:00,060
كما أنّ ما أخبرتِه عنّي في الماضي
،بدا لي وكأنّها أنا بالفعل

114
00:07:00,060 --> 00:07:01,810
.لذلك أظنّ أنّها الحقيقة

115
00:07:02,250 --> 00:07:04,320
.يومًا ما، سأتذكّر ذلك بالفعل

116
00:07:04,320 --> 00:07:06,940
.وعندما يحدث ذلك، لنتحدّث عن الماضي أكثر

117
00:07:08,000 --> 00:07:08,900
.نعم

118
00:07:10,360 --> 00:07:12,090
.لقد عدت

119
00:07:13,770 --> 00:07:14,660
!تاما

120
00:07:14,660 --> 00:07:17,410
!ليس عليك النّوم هنا

121
00:07:18,120 --> 00:07:22,290
كانت تاما-تشان متحمّسة جدًّا للمساعدة
.في تنظيف المنزل، لذلك تعبت كثيرًا

122
00:07:22,290 --> 00:07:24,170
.دعيها تنام حتّى وقت العشاء

123
00:07:25,160 --> 00:07:26,430
.معك حقّ

124
00:07:26,430 --> 00:07:27,960
.المكان نظيف الآن

125
00:07:27,960 --> 00:07:30,720
.تاما مفيدة أكثر منك

126
00:07:30,720 --> 00:07:34,620
!ماذا؟ أنا أساعد أيضًا

127
00:07:44,840 --> 00:07:46,540
...كان الأمر صحيحًا

128
00:07:47,290 --> 00:07:52,320
أخبرتني روكو اليوم أنّ معارك
.المنتقين ستتواصل

129
00:07:53,620 --> 00:07:55,820
إذًا فلدى روكو "لريغ" الآن أيضًا؟

130
00:07:55,820 --> 00:07:57,960
.كلاّ، لا أظنّ ذلك

131
00:07:57,960 --> 00:08:00,630
فتاة منتقية تدعى ميزوشيما

132
00:08:00,630 --> 00:08:04,490
أخبرتها أنّ المعارك متواصلة
.وطلبت منها المساعدة

133
00:08:05,340 --> 00:08:07,130
.لكنّها رفضت

134
00:08:08,130 --> 00:08:11,620
...صحيح، بالتّفكير بشأن تاما-تشان

135
00:08:12,120 --> 00:08:14,800
.دعينا لا نخبر روكو

136
00:08:14,800 --> 00:08:17,680
.نعم، أعتقد أنّ ذلك أفضل

137
00:08:18,250 --> 00:08:20,140
.على أيّ حال، سأجمع المعلومات

138
00:08:20,460 --> 00:08:22,280
.شكرًا لك يا يوزوكي

139
00:08:26,490 --> 00:08:27,900
.هذا جنون

140
00:08:29,480 --> 00:08:31,490
.تكبّدنا كلّ ذلك العناء لإنهاء هذا

141
00:08:33,600 --> 00:08:35,360
لماذا عادت ثانية إذًا؟

142
00:08:38,770 --> 00:08:39,720
.لا نتائج

143
00:08:39,720 --> 00:08:41,900
.لم أكتسب أيّ معلومات مفيدة

144
00:08:42,960 --> 00:08:45,980
لماذا لا تستسلمين وتخوضين معركة بدل هذا؟

145
00:08:45,980 --> 00:08:46,580
.رفض

146
00:08:47,080 --> 00:08:50,670
.لديّ وقت فراغ اليوم. سأذهب إلى هناك

147
00:08:50,670 --> 00:08:52,180
لدينا طاولات
معارك

148
00:08:54,760 --> 00:08:56,050
.مرحبًا يا هانا-سان

149
00:08:56,050 --> 00:08:57,410
.لم أرك منذ مدّة

150
00:08:57,410 --> 00:08:59,260
.مرحبًا يا كوريباياشي-سان

151
00:08:59,260 --> 00:09:02,130
من النّادر لك المجيء إلى شينجوكو، صحيح؟

152
00:09:02,130 --> 00:09:02,980
.بحث

153
00:09:02,980 --> 00:09:05,580
.سمعتُ إشاعة يمكنني استعمالها من أجل مقال

154
00:09:05,580 --> 00:09:07,690
هل سمعتِ أيّ شيء عن الأمر؟

155
00:09:07,690 --> 00:09:09,220
أيّ إشاعة؟

156
00:09:09,220 --> 00:09:10,340
.سؤال

157
00:09:10,340 --> 00:09:12,970
هل سمعتِ عن معارك المنتقين؟

158
00:09:13,860 --> 00:09:15,650
تأكيد؟ أسمعتِ؟

159
00:09:16,070 --> 00:09:18,690
.لا، لم أسمع

160
00:09:18,690 --> 00:09:20,660
أهي لعبة أوراق جديدة؟

161
00:09:22,580 --> 00:09:23,740
.كلام غير موثوق

162
00:09:23,740 --> 00:09:25,120
سمعتُ إشاعة فحسب

163
00:09:25,720 --> 00:09:30,720
"تقول أنّ هنالك معارك "ويكروس
.من نوع خاصّ يشارك فيها المختارون

164
00:09:30,720 --> 00:09:34,100
.ويفقد فيها الخاسرون ذكرياتهم

165
00:09:34,610 --> 00:09:36,110
...لم تكن تلك هي القاعدة

166
00:09:36,110 --> 00:09:37,480
.سؤال

167
00:09:37,480 --> 00:09:39,740
ما كانت القاعدة إذًا؟

168
00:09:39,740 --> 00:09:40,720
...أ... كلاّ

169
00:09:40,980 --> 00:09:44,330
أعني هذا مختلف عن الإشاعة
—الّتي سمعتُها

170
00:09:44,330 --> 00:09:45,020
.اشتباه

171
00:09:45,400 --> 00:09:48,190
ألم تخبريني للتّوّ أنّك لم تسمعي شيئًا؟

172
00:09:49,030 --> 00:09:52,260
.حسنًا، لقد تذكّرت للتّوّ

173
00:09:52,260 --> 00:09:54,620
...سمعتُ قصّة مشابهة

174
00:09:55,160 --> 00:09:58,580
لكنّها مجرّد أساطير محلّيّة، صحيح؟

175
00:09:58,580 --> 00:10:00,450
ارتياب. أتظنّين ذلك فعلاً؟

176
00:10:01,320 --> 00:10:02,950
،هانا-سان

177
00:10:02,950 --> 00:10:08,120
أعتقد أنّه من الأفضل ألاّ تتورّطي
.في هكذا أمور

178
00:10:08,120 --> 00:10:09,340
.عُلم

179
00:10:09,340 --> 00:10:11,460
.شكرًا على قلقك

180
00:10:11,460 --> 00:10:15,360
لكنّني بلغتُ سلفًا مرحلة
.لا يمكنني الرّجوع منها

181
00:10:17,150 --> 00:10:20,040
،إن عرفتِ أيّ معلومات عليّ معرفتها

182
00:10:20,040 --> 00:10:21,240
.اتّصلي بي رجاءً

183
00:10:21,720 --> 00:10:23,640
.حسنًا. مفهوم

184
00:10:25,010 --> 00:10:26,320
.نجاح

185
00:10:26,320 --> 00:10:27,770
.التقيتُ بمصدر معلومات

186
00:10:28,230 --> 00:10:30,770
.لكنّها ليست منتقية

187
00:10:30,770 --> 00:10:31,840
.نظريّة

188
00:10:31,840 --> 00:10:34,650
.على الأرجح أنّها منتقية من معارك سابقة

189
00:10:36,280 --> 00:10:39,610
.أنت ذكيّة للغاية يا هانا-ساما

190
00:10:52,340 --> 00:10:54,130
!هذا ظريف للغاية

191
00:10:54,330 --> 00:10:56,100
.يا إلهي، معك حقّ

192
00:11:00,430 --> 00:11:02,590
...في معارك المنتقين

193
00:11:03,850 --> 00:11:06,150
.لم أحقّق أيّ شيء

194
00:11:09,820 --> 00:11:12,440
أكيرا-تشان، أيمكنك منحي تعبيرًا أكثر سخفًا؟

195
00:11:12,440 --> 00:11:13,960
!حسنًا

196
00:11:15,310 --> 00:11:17,540
.كلّ الأشياء الّتي تفعلها أكيرا مؤخّرًا تبدو هكذا

197
00:11:16,920 --> 00:11:17,870
.نعم

198
00:11:17,540 --> 00:11:19,800
أصبحت شخصيّة كوميديّة، صحيح؟

199
00:11:19,800 --> 00:11:20,700
!آسف

200
00:11:24,620 --> 00:11:25,660
!أيّها الوغد

201
00:11:26,680 --> 00:11:28,640
!ما مشكلتك؟

202
00:11:29,560 --> 00:11:31,080
.لقد اعتذرت

203
00:11:32,010 --> 00:11:33,840
.لقد تحرّش بي هذا الرّجل

204
00:11:33,840 --> 00:11:34,460
!رويدك

205
00:11:35,430 --> 00:11:39,720
أتريدني أن أنهي حياتك في الحال؟

206
00:11:48,610 --> 00:11:51,580
.هذه النّدبة هي كلّ ما بقي لي

207
00:11:55,220 --> 00:11:57,150
هل تعرفين أين المنتقين الآخرين؟

208
00:11:57,810 --> 00:12:00,910
.يمكنني الشّعور قليلاً بمكانهم بشكل عامّ

209
00:12:01,660 --> 00:12:03,570
...لم أكن قادرة على ذلك من قبل

210
00:12:04,080 --> 00:12:07,440
.يريدوننا أن نكون سبّاقين أكثر للمعارك

211
00:12:09,460 --> 00:12:11,740
أين هم الأقرب منّا هنا؟

212
00:12:19,320 --> 00:12:20,460
.دعينا لا نفعل هذا

213
00:12:21,290 --> 00:12:22,300
لماذا؟

214
00:12:22,300 --> 00:12:23,720
...لأنّ هذا المكان

215
00:12:24,540 --> 00:12:27,030
.تقاتلتُ مع ساتومي هنا

216
00:12:27,030 --> 00:12:29,560
...إن كان بإمكانك الشّعور بمنتقٍ هنا

217
00:12:30,030 --> 00:12:32,130
...قد تكون كارنيفال، لذا

218
00:12:32,130 --> 00:12:33,940
سأخسر إن قاتلت؟

219
00:12:36,440 --> 00:12:38,920
،"كان ساتومي "منظّم المعارك

220
00:12:38,920 --> 00:12:41,360
.وكارنيفال كانت "لريغ" خاصّته السّابقة

221
00:12:41,360 --> 00:12:43,650
.لا بدّ أنّها تعرف الكثير

222
00:12:44,100 --> 00:12:46,320
.وأنا بحاجة لتلك المعلومة

223
00:12:46,800 --> 00:12:50,290
لا تهتمّين لِما قد يحدث لك، صحيح؟

224
00:12:50,630 --> 00:12:54,410
.أريد التّكفير عن خطاياي فحسب

225
00:12:55,070 --> 00:12:58,940
،تتحدّثين وكأنّك شخص قاسي القلب

226
00:12:58,940 --> 00:13:01,190
.لكنّك كنتِ لطيفة معي دائمًا

227
00:13:03,000 --> 00:13:07,130
.لذلك سأفعل كلّ ما باستطاعتي من أجلك

228
00:13:07,130 --> 00:13:10,850
.لكنّني لن أساعدك على قتل نفسك

229
00:13:14,730 --> 00:13:17,190
.حسنًا. شكرًا لك

230
00:13:19,510 --> 00:13:21,940
!كيوي، هنالك منتقٍ قريب

231
00:13:35,600 --> 00:13:38,340
أخبريني، هل أنت منتقية؟

232
00:13:38,340 --> 00:13:39,680
.لنتقاتل

233
00:13:39,680 --> 00:13:41,750
.أواجه يومًا سيّئًا

234
00:13:42,590 --> 00:13:44,320
...أوي أكيرا

235
00:13:45,560 --> 00:13:46,380
من أنت؟

236
00:13:46,820 --> 00:13:48,240
.بيرولوك

237
00:13:48,240 --> 00:13:49,510
.كنتُ "لريغ" خاصّتك

238
00:13:50,040 --> 00:13:52,510
إذًا فقد تمّ اختيارك كمنتقية ثانية؟

239
00:13:53,920 --> 00:13:56,250
هذه أنت يا بيرولوك-تان؟

240
00:13:56,250 --> 00:13:57,490
!مرّ وقت طويل

241
00:13:57,490 --> 00:13:59,390
لم تتغيّري أبدًا، صحيح؟

242
00:14:00,100 --> 00:14:01,730
...صحيح

243
00:14:01,730 --> 00:14:04,280
!لماذا لم تتغيّري أبدًا؟

244
00:14:04,680 --> 00:14:07,640
!أيّتها الوقحة بيرولوك! لا تعبثي معي

245
00:14:07,640 --> 00:14:10,250
لماذا أنا الوحيدة الّتي انتهى
!بها المطاف هكذا؟

246
00:14:12,280 --> 00:14:15,230
!استعملني الجميع كجسر للوصول لأهدافهم

247
00:14:15,230 --> 00:14:17,410
!كنتِ تضحكين عليّ أيضًا، صحيح؟

248
00:14:17,410 --> 00:14:18,560
!صحيح؟

249
00:14:19,870 --> 00:14:20,880
.افعليها

250
00:14:21,420 --> 00:14:23,240
أنت تعرفين، صحيح؟

251
00:14:23,760 --> 00:14:28,290
الاستمرار بهذا سيؤذي كلّ
.من له علاقة بالأمر فحسب

252
00:14:28,290 --> 00:14:30,890
!لا أهتمّ بذلك! قاتليني

253
00:14:31,180 --> 00:14:35,910
!حصلتُ على هذا الوجه لأنّك كنت ضعيفة

254
00:14:35,910 --> 00:14:38,940
—خسرتِ لأنّك استهنتِ بكوميناتو-سان

255
00:14:38,940 --> 00:14:40,410
!اخرسي

256
00:14:40,410 --> 00:14:43,360
!الخطأ خطؤك لأنّك كنتِ ضعيفة
!لا تحاولي إلقاء اللّوم عليّ

257
00:14:43,360 --> 00:14:44,820
.أقول الحقيقة فحسب

258
00:14:48,020 --> 00:14:50,780
لقد استغللتني، صحيح؟

259
00:14:51,510 --> 00:14:54,660
.هيّا، تحمّلي بعض المسؤوليّة

260
00:14:54,660 --> 00:14:58,660
!تحمّلي بعض المسؤوليّة لإفسادك حياتي

261
00:15:03,170 --> 00:15:05,000
.هكذا تمامًا

262
00:15:05,180 --> 00:15:06,290
!فتح

263
00:15:19,250 --> 00:15:22,060
هكذا تبدو حلبة القتال هذه المرّة؟

264
00:15:23,000 --> 00:15:25,520
.لنتعامل مع كلّ شيء لا نفهمه بينما نقاتل

265
00:15:25,910 --> 00:15:26,840
.معًا

266
00:15:26,840 --> 00:15:27,610
.نعم

267
00:15:28,420 --> 00:15:32,640
لطالما كرهت نظرة الرّضا
...عن النّفس على وجهك

268
00:15:34,030 --> 00:15:35,030
!مرحى

269
00:15:35,030 --> 00:15:37,080
!أنت الأولى يا أكي المحظوظة

270
00:15:37,080 --> 00:15:39,790
.سأجعل وجهك يتلوّى من الألم قريبًا

271
00:15:40,010 --> 00:15:41,130
!اكبري

272
00:15:42,400 --> 00:15:44,220
."استدعاء اثنين من "نيفونيوم

273
00:15:44,220 --> 00:15:44,880
.سحب

274
00:15:45,240 --> 00:15:48,170
!يد السّحر! صاخبة! سهم النّجم

275
00:15:52,180 --> 00:15:53,190
!بيرولوك

276
00:15:54,140 --> 00:15:56,050
.هجمات مركّبة... هذا جديد

277
00:15:56,050 --> 00:15:57,410
!مهلاً لحظة

278
00:15:57,410 --> 00:16:00,500
تسمّين "لريغ" خاصّتك بيرولوك؟

279
00:16:00,500 --> 00:16:03,960
ألا تجدين هذا مريبًا؟

280
00:16:04,750 --> 00:16:07,040
ماذا؟ هل جرحك ذلك؟

281
00:16:07,040 --> 00:16:09,010
!أمّا أنا فقد أسعدني

282
00:16:09,010 --> 00:16:09,800
.اكبري

283
00:16:10,450 --> 00:16:11,890
."استدعاء "مانومين

284
00:16:11,890 --> 00:16:13,410
.تجاهل "اليد" وهجوم

285
00:16:16,580 --> 00:16:19,860
ما زلتِ تحبّين رمي الأوراق، صحيح؟

286
00:16:19,860 --> 00:16:23,580
أعتقد أنّك غبيّة كثيرًا على تعلّم
.أكثر من خدعة واحدة

287
00:16:24,000 --> 00:16:27,540
وما زلت أنت تحاولين استفزازي
وتشتيت انتباهي، صحيح؟

288
00:16:27,780 --> 00:16:28,840
ماذا؟

289
00:16:28,840 --> 00:16:32,780
.لا أحاول استفزازك. أحاول مساعدتك

290
00:16:32,780 --> 00:16:35,890
واصلي على هذا المنوال مرارًا
.وتكرارًا وستخسرين

291
00:16:35,890 --> 00:16:36,990
.اكبري

292
00:16:39,230 --> 00:16:40,180
سوداء؟

293
00:16:40,180 --> 00:16:43,770
،عندما كنتُ معك يا بيررلوك-تان
استعملتُ مجموعة زرقاء، صحيح؟

294
00:16:43,980 --> 00:16:47,400
.لكنّ هذه تناسبني أكثر الأن

295
00:16:47,400 --> 00:16:48,970
!"خروج دمويّ"

296
00:16:50,980 --> 00:16:51,970
!بيرولوك

297
00:16:53,430 --> 00:16:56,110
أكي المحظوظة، أتريدين القيام بهجوم آخر؟

298
00:16:56,110 --> 00:16:57,870
.كلاّ. إنهاء الدّور

299
00:16:58,270 --> 00:17:01,170
.تغيّر أسلوب قتال أكيرا أيضًا

300
00:17:01,670 --> 00:17:04,040
.سابقًا، استعملت القوّة الغاشمة فحسب

301
00:17:04,810 --> 00:17:05,960
ماذا نفعل؟

302
00:17:07,840 --> 00:17:09,030
.رهان العُملة

303
00:17:11,470 --> 00:17:12,380
."اختلاس"

304
00:17:13,300 --> 00:17:14,880
.حسنًا، سأقوم بالمثل

305
00:17:14,880 --> 00:17:16,210
.رهان العُملة

306
00:17:21,380 --> 00:17:22,640
...لا أعرف

307
00:17:26,200 --> 00:17:28,060
أنت ترتعدين، صحيح يا بيرولوك-تان؟

308
00:17:28,060 --> 00:17:30,100
!لكن ما بيدكِ حيلة

309
00:17:31,510 --> 00:17:32,820
!"حدوث"

310
00:17:33,540 --> 00:17:37,150
حدوث" هي قدرةُ عُملةٍ"
.لا يمكن توقّع تأثيراتها

311
00:17:37,150 --> 00:17:39,030
.من المستحيل معرفة ما قد تفعل

312
00:17:40,660 --> 00:17:43,650
...ماذا؟ هذا ما فعلتْه هذه المرّة

313
00:17:43,650 --> 00:17:44,820
!يا للسّحرية

314
00:17:44,820 --> 00:17:48,260
!تخطيطك المفضّل قد عاد بالضّرر عليك

315
00:17:56,820 --> 00:17:58,660
أخبريني، هل أنت بخير؟

316
00:17:58,660 --> 00:18:02,740
،إن كنتُ قويّة رفقة "لريغ" ليست أنت

317
00:18:02,740 --> 00:18:06,570
!فذلك يعني أنّ لا فائدة لك

318
00:18:07,360 --> 00:18:10,340
هذا لأنّني ذكيّة للغاية، صحيح؟

319
00:18:10,340 --> 00:18:11,910
!اخرسي يا هذه

320
00:18:11,910 --> 00:18:15,540
،إن قاطعتني بهرائك عندما أتحدّث
!فسأمزّقك لنصفين

321
00:18:16,390 --> 00:18:18,570
!أنت مخيفة يا أكي المحظوظة

322
00:18:21,340 --> 00:18:22,080
!بيرولوك

323
00:18:22,580 --> 00:18:23,840
.لا بأس

324
00:18:23,840 --> 00:18:25,200
.ما زلت أستطيع القتال

325
00:18:26,010 --> 00:18:28,460
.أكيرا قويّة بالفعل

326
00:18:28,980 --> 00:18:31,540
.كيوي، هنالك أمر لم نجرّبه بعد

327
00:18:35,600 --> 00:18:39,250
.بيرولوك، أخبريني كيف أستعمل ورقة المفتاح

328
00:18:39,250 --> 00:18:40,280
.حسنًا

329
00:18:40,280 --> 00:18:42,550
.قولي "تحرير" وراهني بعملة

330
00:18:43,960 --> 00:18:45,100
.تحرير

331
00:18:45,730 --> 00:18:46,790
.رهان العُملة

332
00:19:03,900 --> 00:19:05,200
ما هذا؟

333
00:19:05,200 --> 00:19:06,830
!لا... لا أدري

334
00:19:14,600 --> 00:19:15,740
ما هذا؟

335
00:19:19,150 --> 00:19:20,860
.هيّا بنا يا كيوي

336
00:19:23,340 --> 00:19:24,760
.رهان العُملة

337
00:19:26,040 --> 00:19:27,060
!"تنفيس"

338
00:19:28,680 --> 00:19:29,930
!ما كان ذلك؟

339
00:19:39,060 --> 00:19:41,400
ماذا؟ ماذا، ماذا؟

340
00:19:47,440 --> 00:19:51,160
،هذه المرّة، إن خسرنا معركة
نخسر "لريغ" خاصّتنا؟

341
00:19:51,620 --> 00:19:53,040
.ذلك ما يبدو

342
00:19:53,360 --> 00:19:55,360
ماذا فعلتِ للتّوّ؟

343
00:19:55,360 --> 00:19:57,710
!أعيديها في الحال

344
00:19:59,740 --> 00:20:00,800
ما هذا؟

345
00:20:00,800 --> 00:20:02,800
!سُحقًا لك

346
00:20:02,800 --> 00:20:04,680
!أيّتها الوقحة بيرولوك

347
00:20:05,650 --> 00:20:08,330
.صحيح أنّني استغللتك في السّابق

348
00:20:08,330 --> 00:20:10,680
.أدرك تمامًا لماذا قد تكرهينني

349
00:20:10,680 --> 00:20:13,520
.لكن لديّ مسؤوليّة إنهاء معارك المنتقين

350
00:20:11,990 --> 00:20:13,520
!لا أهتمّ لذلك

351
00:20:13,810 --> 00:20:16,700
سوف أوسعك ضربًا

352
00:20:16,700 --> 00:20:20,940
!وأجعل وجهك يتلوّى من اليأس

353
00:20:29,840 --> 00:20:32,570
.مرّ وقت طويل أيّتها الحقيرة الصّغيرة

354
00:20:33,980 --> 00:20:34,980
...كارنيفال

355
00:20:34,980 --> 00:20:36,220
.نعم

356
00:20:36,220 --> 00:20:38,720
.أتمنّى أن تواصلي مناداتي بذلك

357
00:20:38,720 --> 00:20:41,460
،لقد أحببتُ كو

358
00:20:41,460 --> 00:20:45,260
.لكنّني لا أحبّ استعمال اسم شخص قد فشل

359
00:20:45,260 --> 00:20:46,470
فشل؟

360
00:20:46,720 --> 00:20:51,780
لقد خسر المعارك وما عاد الآن
قادرًا على الاستمتاع بوقته، صحيح؟

361
00:20:51,780 --> 00:20:54,840
أخطّط لمواصلة المعارك للأبد

362
00:20:54,840 --> 00:20:56,990
.والاستمتاع بها لأجل غير مسمّى

363
00:20:57,380 --> 00:20:59,960
الاستمتاع... بها؟

364
00:20:59,960 --> 00:21:02,380
.هذا العالم مملّ جدًّا

365
00:21:02,380 --> 00:21:03,990
.لكنّ ذلك مختلف

366
00:21:04,370 --> 00:21:07,300
.أيّتها الحقيرة الصّغيرة، تعرفين ما أقصده

367
00:21:07,300 --> 00:21:09,720
كنتِ تستمتعين حتّى إن لم
تعترفي بذلك، صحيح؟

368
00:21:09,720 --> 00:21:12,350
.أقصد معركتك مع أوي أكيرا

369
00:21:13,450 --> 00:21:17,800
والآن، لنبدأ معركة حيث يلتهم
!فيها القويّ الضّعيف

370
00:21:17,800 --> 00:21:19,270
!كم هذا مثير

371
00:21:19,270 --> 00:21:21,800
يمكنني سماع صرخات الفتيات
!وهنّ يتوسّلن من أجل حياتهنّ ثانية

372
00:21:23,490 --> 00:21:24,760
.حسنًا إذًا

373
00:21:25,000 --> 00:21:26,230
.لنبدأ

374
00:21:26,230 --> 00:21:28,840
.لكنّني لن أسمح للأمور بالسّير على هواك

375
00:21:29,480 --> 00:21:34,770
سأوقف هذه المرّة معارك المنتقين

376
00:21:34,770 --> 00:21:36,500
!ودائرة اليأس غير المنتهية هذه

377
00:21:37,700 --> 00:21:38,900
.يبدو هذا ممتعًا

378
00:21:39,320 --> 00:21:40,540
.جرّبيه

379
00:23:24,570 --> 00:23:25,520
ريرو؟

380
00:23:26,490 --> 00:23:27,680
.مرحبًا يا سوزوكو

381
00:23:27,680 --> 00:23:29,080
.أنت لطيفة جدًّا يا ريرو

382
00:23:29,080 --> 00:23:30,420
أصبح المنتقون "لريغ"؟

383
00:23:30,420 --> 00:23:32,040
.ما زال هنالك الكثير نجهله

384
00:23:32,040 --> 00:23:32,780
!كاناي-سان

385
00:23:32,780 --> 00:23:34,640
.إن خسرت، يسرق خصمك "لريغ" خاصّتك

386
00:23:34,640 --> 00:23:38,260
.تمّ اختيار منتقٍ جديد آخر

387
00:23:38,260 --> 00:23:40,760
."تجمهر، منهزم ومنتصر"