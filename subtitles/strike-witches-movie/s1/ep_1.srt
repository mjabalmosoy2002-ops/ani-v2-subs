00:45:23,330 --> 00:45:24,950
،لا تتّبع القواعد

620
00:45:24,950 --> 00:45:27,660
.تتجاهل الأوامر وتتصرّف بناءً على حكمها الخاص

621
00:45:27,660 --> 00:45:29,120
.كانت تثير الأعصاب

622
00:45:31,750 --> 00:45:33,630
".أنا أبغض الحرب"

623
00:45:35,170 --> 00:45:39,840
كان هذا أول ما قالته ميافوجي-سان
.أوّل مرّة دخلت جناحنا

624
00:45:39,840 --> 00:45:43,800
.أمامنا جميعًا، نحن اللّواتي ظللنا نقاتل النويروي

625
00:45:45,560 --> 00:45:47,890
،كنتُ منزعجة بصدق

626
00:45:47,890 --> 00:45:50,100
.وتعجبت من أمر هذه الفتاة

627
00:45:51,560 --> 00:45:53,400
.ولكن الأمر اِزداد غموضًا

628
00:45:54,480 --> 00:45:57,190
فمنذ اِنضمامها
،لتحالف الجناح المقاتل خمسمائة ووحاد

629
00:45:57,190 --> 00:45:59,780
.أصبحنا أشدّ بكثير من ذي قبل

630
00:46:01,700 --> 00:46:06,280
.بدونها، لما تحرّرت غاليا

631
00:46:07,540 --> 00:46:09,040
...أنا

632
00:46:10,210 --> 00:46:11,960
هل صعُب عليكِ الإستيعاب؟

633
00:46:12,710 --> 00:46:14,670
.دعينا نعود للنّوم

634
00:46:14,670 --> 00:46:16,460
.أوشك الصباح على الحلول

635
00:46:26,680 --> 00:46:28,720
.من المُقدّر أن نصل بعد السادسة مساءً

636
00:46:28,720 --> 00:46:32,520
.حوّل

637
00:46:29,930 --> 00:46:31,350
.الناطقُ بالمقر. عُلِم

638
00:46:32,520 --> 00:46:34,020
.إغلاق الإرسال

639
00:46:35,560 --> 00:46:38,570
.تبعد (لورد) حوالي 200 كيلومتر

640
00:46:38,570 --> 00:46:42,570
إن اتبعتما هذا الطريق، فستصلان
.إلى ديجون في فترة ما بعد الظهر

641
00:46:42,570 --> 00:46:44,990
إذًا هذه وجهتنا لليلة؟

642
00:46:44,990 --> 00:46:49,370
.تجنّبا المرور بالقرب من الحدود بأي ثمن

643
00:46:49,370 --> 00:46:55,380
غاليا

644
00:46:49,370 --> 00:46:55,380
لوكسمبورغ

645
00:46:49,830 --> 00:46:53,500
.إن عبرتماه، سيهاجمكما النويروي بلا هوّادة

646
00:46:53,500 --> 00:46:54,750
.عُلِم ويُنفّد

647
00:46:56,130 --> 00:46:58,250
.يوشكا-تشان، خُذي هذه معكِ

648
00:46:58,250 --> 00:46:59,550
ما هذه؟

649
00:47:05,050 --> 00:47:06,510
!معطف أبيض

650
00:47:07,470 --> 00:47:09,640
هل خيّطتِه من أجلي يا ليني-تشان؟

651
00:47:10,060 --> 00:47:10,810
.أجل

652
00:47:10,810 --> 00:47:13,600
...سمعت عن رغبتكِ بأن تصبحي طبيبة، فـ

653
00:47:14,600 --> 00:47:16,610
ليني-تشان، ما سبب إصاباتكِ...؟

654
00:47:16,610 --> 00:47:22,280
...فـ-في الحيقة أنا... لا أجيد الخياطة

655
00:47:22,860 --> 00:47:26,030
.ضلّت تخيطه من أجلكِ طيلة الشهر

656
00:47:27,030 --> 00:47:28,780
!أنا أقدّر جهدكِ يا ليني-تشان

657
00:47:28,780 --> 00:47:32,080
!أعدكِ أن أصبح أفضل طبيبة

658
00:47:32,080 --> 00:47:33,910
!أتمنى لكِ التوفيق يا يوشكا-تشان

659
00:47:33,910 --> 00:47:34,870
!شكرًا

660
00:47:43,130 --> 00:47:44,340
.هاكِ طعامكُما

661
00:47:44,340 --> 00:47:45,720
.كُلا منه في الطريق

662
00:47:45,720 --> 00:47:46,510
!حسنًا

663
00:47:46,510 --> 00:47:50,350
قطفت لكِ نبتة
.العرن المثقوب من حديقتنا

664
00:47:50,350 --> 00:47:51,470
.إنها نبتة طبّية

665
00:47:51,470 --> 00:47:54,270
!شكرًا لكما، ليني-تشان ويا بيرين-سان

666
00:47:55,390 --> 00:47:57,060
.سنغادر الآن

667
00:48:01,360 --> 00:48:02,570
!ليني-تشان

668
00:48:02,570 --> 00:48:04,150
!بيرين-سان

669
00:48:04,150 --> 00:48:05,650
!مع السلامة

670
00:48:05,650 --> 00:48:07,450
!يوشكا-تشان

671
00:48:07,450 --> 00:48:10,620
!ترقّبي رسائلي عمّا قريب

672
00:48:24,170 --> 00:48:25,760
ما بال نيپّا والأخريات؟

673
00:48:25,760 --> 00:48:27,380
،رغم أننا صديقاتهن ننوي الرحيل

674
00:48:27,380 --> 00:48:28,890
ألن يحضرن لتوديعنا؟

675
00:48:29,390 --> 00:48:32,010
.نيپّا-سان في منتصف مهمة

676
00:48:32,010 --> 00:48:34,100
.الأمر خارج عن إرادتهن

677
00:48:34,100 --> 00:48:35,640
...ولـــكن

678
00:48:38,150 --> 00:48:43,400
.قامت بجدولة مهامها لأجل توديعكِ

679
00:48:43,860 --> 00:48:45,400
.حضرة القائدة ساشا

680
00:48:45,400 --> 00:48:47,820
!شكرًا على رعايتنا

681
00:48:47,820 --> 00:48:48,660
.شكرًا...

682
00:48:49,160 --> 00:48:49,990
.لا شكر على واجب

683
00:48:50,780 --> 00:48:55,200
.سيعوم شعور الوحدة بدونكما ثانية

684
00:48:55,200 --> 00:49:00,040
!هاي

685
00:49:00,330 --> 00:49:02,290
!إنتظرانني

686
00:49:02,290 --> 00:49:04,210
!هاي

687
00:49:03,340 --> 00:49:06,460
.يا إيلا، ها قد عادت نيپّا-سان

688
00:49:06,460 --> 00:49:07,670
.حمدًا للرب

689
00:49:07,670 --> 00:49:09,800
.يبدو أن مامن مكروه حدث لها اليوم

690
00:49:09,800 --> 00:49:10,800
...هييه

691
00:49:10,800 --> 00:49:12,300
.لم ينتهِ اليوم بعد

692
00:49:17,930 --> 00:49:19,440
...ها هي ذي

693
00:49:19,440 --> 00:49:20,560
!~مصيبة

694
00:49:20,560 --> 00:49:24,360
.يا إلهي، منحوسة كما عاهدناها

695
00:49:27,360 --> 00:49:29,570
.ها قد حطّمتِها من جديد

696
00:49:29,910 --> 00:49:32,910
!هذه ثاني مرة هذا الشهر

697
00:49:32,910 --> 00:49:35,330
!من غير المعقول أن نظلّ نصلحها كلّ مرة

698
00:49:36,200 --> 00:49:38,290
...تلوميني كأني تسبّبتُ بالبرق

699
00:49:38,290 --> 00:49:42,210
!كونا حذرتين، فالجوّ يزداد سوءًا

700
00:49:45,000 --> 00:49:45,750
.حسنًا

701
00:49:46,380 --> 00:49:49,340
.سنحاول الطيران معظم الرحلة فوق السّحب

702
00:49:49,340 --> 00:49:50,630
.وداعًا نيپّا

703
00:49:50,630 --> 00:49:52,640
.لا تحطّميها المرة القادمة

704
00:49:58,480 --> 00:50:00,100
.إيلا

705
00:50:00,100 --> 00:50:01,020
.سانيا-سان

706
00:50:01,020 --> 00:50:01,810
!نيپّا-سان

707
00:50:03,230 --> 00:50:04,810
!هاي

708
00:50:05,270 --> 00:50:06,860
!توخّيا الحذر

709
00:50:06,860 --> 00:50:08,490
!عداني بأن تعودا لنلهُو مجدّدًا

710
00:50:08,490 --> 00:50:09,780
!حاولًا ألّا تمرضا

711
00:50:11,660 --> 00:50:14,490
!إحترسا من البرق

712
00:50:17,990 --> 00:50:20,620
!مع السلامة

713
00:50:47,480 --> 00:50:48,690
أأصبتِ بنزلة برد؟

714
00:50:48,690 --> 00:50:50,360
.أظن ذلك

715
00:50:50,360 --> 00:50:52,360
.لننخفض قليلًا

716
00:51:11,590 --> 00:51:14,340
.أتسائل عن صحّة ميافوجي

717
00:51:14,340 --> 00:51:16,850
...منذ أن قرأتِ طالعها

718
00:51:16,850 --> 00:51:20,520
~أنتِ من طلبتِ مني قراءة طالعها

719
00:51:22,930 --> 00:51:24,600
...هذا برج

720
00:51:24,600 --> 00:51:26,190
.يعني حظًا عاثرًا

721
00:51:26,190 --> 00:51:29,070
أليست ميافوجي في غاليا؟

722
00:51:29,070 --> 00:51:31,480
...لا يفترض أن يكون هنالك أي نويروي، لكن

723
00:51:31,480 --> 00:51:33,490
.معكِ حق

724
00:51:38,370 --> 00:51:39,580
ماذا حدث؟

725
00:51:39,580 --> 00:51:40,990
!إيلا

726
00:51:42,200 --> 00:51:44,580
ما هذا الشيء!؟

727
00:51:44,580 --> 00:51:47,000
أيعقل أنه.... نويروي؟

728
00:51:58,760 --> 00:52:01,220
.لنأكل قليلًا

729
00:52:01,220 --> 00:52:02,600
!إنه لذيذ

730
00:52:02,600 --> 00:52:03,850
.ليس الآن

731
00:52:03,850 --> 00:52:05,890
.أنا أتحقق من طريقنا

732
00:52:16,280 --> 00:52:17,200
من يكون؟

733
00:52:18,070 --> 00:52:19,200
!جنديّتان

734
00:52:19,200 --> 00:52:21,490
أتسمحان أن أستعير جهاز الإرسال خاصتكما؟

735
00:52:21,490 --> 00:52:22,330
ما المشكل؟

736
00:52:22,830 --> 00:52:26,040
وقع انهيار أرضي على قريتنا
!خلّف الكثير من الضحايا

737
00:52:26,330 --> 00:52:27,420
إنهيار أرضي!؟

738
00:52:27,420 --> 00:52:28,000
!هذه مصيبة

739
00:52:28,000 --> 00:52:29,540
،سبق وحاولنا طلب المساعدة

740
00:52:29,540 --> 00:52:31,000
!لكن هواتفنا خارج التّغطية

741
00:52:31,000 --> 00:52:31,920
!شيزوكا-تشان

742
00:52:31,920 --> 00:52:33,340
!حاضرة

743
00:52:37,090 --> 00:52:39,340
.ماذا؟ جهاز الإرسال لا يستجيب

744
00:52:39,340 --> 00:52:41,010
...كان يعمل منذ إنطلاقنا

745
00:52:41,350 --> 00:52:45,140
!أستطيع إسعافهم بنفسي، رجاءً خذني إليهم

746
00:52:45,140 --> 00:52:47,310
أ-أأنتِ طبيبة؟

747
00:52:47,770 --> 00:52:49,150
!ذلك مستحيل

748
00:52:49,150 --> 00:52:50,770
!فالقرية عبر الحدود

749
00:52:50,770 --> 00:52:53,020
!حذّرتنا الملازمة بيريين من عبورهم

750
00:52:53,020 --> 00:52:54,320
!فل نذهب يا شيزوكا-تشان

751
00:52:55,360 --> 00:52:56,490
...حضرة الملازمة

752
00:53:10,330 --> 00:53:11,420
.من هنا

753
00:53:17,130 --> 00:53:18,300
.يا للقسوة

754
00:53:18,630 --> 00:53:20,300
.سأحاول إيقاف النّزيف

755
00:53:21,550 --> 00:53:23,560
.أعشاب بيرين-سان ستفي بالغرض

756
00:53:24,510 --> 00:53:25,430
...أيضًا

757
00:53:25,890 --> 00:53:27,770
هل لديكم ضماضات؟

758
00:53:28,100 --> 00:53:30,770
.استخدمنا كل ما بقيَ بالفعل

759
00:53:31,100 --> 00:53:33,900
هل من ملاءات أو مناشف نظيفة؟

760
00:53:34,190 --> 00:53:35,690
.لم يتبقّ لدينا أي شيء

761
00:53:46,040 --> 00:53:47,660
.ليني-تشان، سامحيني

762
00:54:07,850 --> 00:54:09,980
.أسعفنا الجميع بفضلك

763
00:54:09,980 --> 00:54:12,440
.نقدّر مساعدتكِ لنا

764
00:54:23,160 --> 00:54:25,450
.هاه؟ حلّ اللّيل

765
00:54:28,580 --> 00:54:30,210
هل تمكنتِ من الإتصال بالقاعدة؟

766
00:54:31,000 --> 00:54:32,040
.لا جدوى

767
00:54:32,040 --> 00:54:32,830
.ثمّة ما يشوّش تواصلي

768
00:54:33,370 --> 00:54:34,380
،لا قاعدة سانت ترود

769
00:54:34,380 --> 00:54:37,750
.ولا (سيدان) و(ديجون) يردّون

770
00:54:38,920 --> 00:54:40,510
...أظنّ أن الجهاز معطّل

771
00:54:40,880 --> 00:54:43,430
.كان يعمل منذ رحيلنا

772
00:54:44,550 --> 00:54:46,430
.هواتف القرية لا تزال معطلة

773
00:54:46,430 --> 00:54:49,850
،لقد تأخر الوقت بالفعل
فل تقضيا اللّيلة هنا؟

774
00:54:51,390 --> 00:54:53,230
!أشكركُما جزيلًا

775
00:54:53,230 --> 00:54:54,690
.شيزوكا-تشان لنبق هنا

776
00:54:55,100 --> 00:54:59,730
لا أمانع، لكن لا زلنا غير قادرتين
.على إرسال تقريرنا لليوم

777
00:55:00,780 --> 00:55:02,070
ألا يمكننا فعل ذلك غذًا؟

778
00:55:03,360 --> 00:55:05,110
.تقديم التقارير من واجبي

779
00:55:05,530 --> 00:55:07,240
.يمكنك الذهاب أولًا

780
00:55:23,930 --> 00:55:25,680
.وقّعي على الإيصال

781
00:55:25,680 --> 00:55:29,390
.مرّ نصف شهر منذ أن أعدنا الإمداد

782
00:55:29,390 --> 00:55:31,640
.عدم الإنشغال أمر جيد

783
00:55:32,100 --> 00:55:34,730
يبدو أن الكتائب الأخرى
.تسير على هذا النحو أيضًا

784
00:55:34,730 --> 00:55:37,110
.نفضّل أن يستمر الحال على هذا النحو

785
00:55:37,770 --> 00:55:38,690
.آمل ذلك

786
00:55:39,690 --> 00:55:40,900
.بعد إذنكِ

787
00:55:41,730 --> 00:55:42,740
.أحسنتم عملًا

788
00:55:50,450 --> 00:55:51,910
!آآه

789
00:55:52,500 --> 00:55:54,870
...كسرتُ ظفري

790
00:55:56,250 --> 00:55:58,290
!يداي يرتجفان

791
00:55:58,290 --> 00:55:59,290
!تبًا لذلك

792
00:55:59,290 --> 00:56:03,720
!تبًا تبًا! تبًا! تبًا

793
00:56:00,630 --> 00:56:03,340
.هذا نتاج فقدانكِ المعبّئ

794
00:56:03,720 --> 00:56:04,380
!خطأ

795
00:56:04,380 --> 00:56:05,630
!إدخالها صعب جدًا

796
00:56:05,630 --> 00:56:09,890
!!ما عليكِ سوى إدخا...لها هكذا

797
00:56:10,470 --> 00:56:12,020
...أدخلتِها بالقوّة ليس إلّا

798
00:56:12,020 --> 00:56:13,140
ماذا!؟

799
00:56:13,560 --> 00:56:16,980
أساسًا كيف سوّلت نفسكِ فقدان المعبئ؟

800
00:56:16,980 --> 00:56:18,440
،كجندية كارلسلاندية

801
00:56:18,440 --> 00:56:22,030
.صيانة أسلحتك من أبسط الأساسيات

802
00:56:25,320 --> 00:56:27,410
.حضرة القائدة مينا، تنتظركِ مكالمة

803
00:56:29,280 --> 00:56:30,580
.فهمت

804
00:56:30,580 --> 00:56:32,240
حاربتن نويروي في فينيزيا؟

805
00:56:32,950 --> 00:56:35,160
،لا توجد أي خلايا على بعد 200 ميل

806
00:56:35,160 --> 00:56:38,250
.ولا في اتجاه مجرى النهر الذي يحدّ رومانيا

807
00:56:38,250 --> 00:56:40,630
.أتساءل من أين جاء

808
00:56:40,630 --> 00:56:42,090
.الأمر مقلق

809
00:56:42,750 --> 00:56:46,010
استمرا بمراقبة
.رفقة الجناح 504

810
00:56:46,300 --> 00:56:47,340
.عُلم

811
00:56:50,390 --> 00:56:53,680
.ظهر آخر مرّة في بلجيكا، والآن في فينيزيا

812
00:56:55,680 --> 00:57:01,690
.تقع أعشاشهم الرئيسية في برلين، نورمبرغ وبراغ

813
00:57:02,110 --> 00:57:04,360
...مناطق النويروي العملية ستكون

814
00:57:07,280 --> 00:57:08,320
.هذا غير منطقي

815
00:57:08,780 --> 00:57:11,200
.هذان النويروي بعيدان عن الأعشاش

816
00:57:11,620 --> 00:57:13,160
كيف كان النويروي الذي قاتلتيه؟

817
00:57:13,700 --> 00:57:14,410
.أذكره

818
00:57:14,410 --> 00:57:16,040
،كان كسفينة طويلة ومتوسطة الحجم

819
00:57:16,040 --> 00:57:18,790
.قادمًا من الجنوب ومتّجهًا إلى الشمال الغربي

820
00:57:19,250 --> 00:57:21,460
ألم يبدُ كمراقِب؟

821
00:57:22,090 --> 00:57:24,630
كانت قدرته على المناورة
،وهجومه مختلفان تمامًا عن الباقين

822
00:57:24,630 --> 00:57:26,460
.لم أشهد قطّ مثله من قبل

823
00:57:26,800 --> 00:57:27,590
.فهمت

824
00:57:28,340 --> 00:57:31,390
.سمعتُ نفس التفاصيل من تقرير شيرلي-سان

825
00:57:32,100 --> 00:57:33,890
هل يمكن أن يكونا من نفس العش؟

