1
00:00:18,200 --> 00:00:19,750
!أحصنة

2
00:00:47,810 --> 00:00:49,140
ما كان ذلك؟

3
00:00:49,140 --> 00:00:50,800
.يبدو أنّه انفجار

4
00:00:50,800 --> 00:00:52,940
!ساعدوا المصابين في الحال

5
00:00:52,940 --> 00:00:54,690
!أبعدوا الحشود عن المنطقة

6
00:00:54,990 --> 00:00:56,620
!هذا لأجل بوشين

7
00:01:10,660 --> 00:01:13,420
شيزوما-سان؟

8
00:01:15,510 --> 00:01:17,390
.سوميي

9
00:01:20,850 --> 00:01:22,970
!أيّها الخائن أوكوبو توشيميتشي

10
00:01:22,970 --> 00:01:24,310
!جهّز نفسك

11
00:01:26,690 --> 00:01:28,000
هل تأذّيت؟

12
00:01:28,000 --> 00:01:29,460
.أنا بخير

13
00:01:30,760 --> 00:01:31,940
.لا تطلق

14
00:01:31,940 --> 00:01:33,480
!لا تتدخّل

15
00:01:33,950 --> 00:01:35,330
!أمسكوا بالمجرمين

16
00:01:35,330 --> 00:01:36,070
!حاضر

17
00:01:38,700 --> 00:01:40,080
.لنهرب بينما ما زلنا نستطيع

18
00:01:45,850 --> 00:01:47,340
.سوميي

19
00:01:48,410 --> 00:01:49,930
.تماسك

20
00:01:52,450 --> 00:01:53,470
!لا تتحرّك

21
00:02:04,770 --> 00:02:09,770
الحلقة 8       السّقوط تِباعًا

22
00:02:10,550 --> 00:02:16,590
...القمر الكبير الدّائريّ في السّماء

23
00:02:25,000 --> 00:02:27,270
ما هذه؟ سمكة كوي؟

24
00:02:30,350 --> 00:02:32,620
مهلاً، اختفى القمر؟

25
00:02:43,640 --> 00:02:46,670
.قيل لي أنّ السّيّد أوكوبو تعرّض للهجوم

26
00:02:46,670 --> 00:02:50,400
سمعتُ أنّها كانت حادثة كبيرة
.بقنابل ورصاص

27
00:02:50,400 --> 00:02:52,730
.ومع ذلك، لم يصل أيّ منها للصّحافة

28
00:02:52,730 --> 00:02:54,890
.واثقة أنّهم يقيّدون المعلومات

29
00:02:54,890 --> 00:03:00,110
وبدل ذلك، ينشرون قصّص
أشباح عن اختفاء القمر

30
00:03:00,110 --> 00:03:02,990
.وسقوط سمك كوي خشبيّ من السّماء

31
00:03:02,990 --> 00:03:05,360
.يبدو ذلك سخيفًا

32
00:03:05,360 --> 00:03:10,200
يبدو أنّ هذه الحادثة وقعت في كلّ
.أرجاء طوكيو خلال ليلة واحدة

33
00:03:10,200 --> 00:03:11,300
.هكذا إذًا

34
00:03:11,770 --> 00:03:14,650
ما الّذي أردتَ منّي التّحقيق في أمره؟

35
00:03:14,650 --> 00:03:16,000
.هذه الحادثة

36
00:03:16,280 --> 00:03:18,980
وليس الهجوم على السّيّد أوكوبو؟

37
00:03:18,980 --> 00:03:21,880
.تمّ تولّي ذلك الأمر سلفًا

38
00:03:21,880 --> 00:03:26,000
أطلب منك التّحقيق في أمر قصّة
.الأشباح هذه يا آنسة كوروغي

39
00:03:26,000 --> 00:03:28,090
.ليس لديّ وقت لتضييعه

40
00:03:28,090 --> 00:03:29,880
.لا تقولي هذا

41
00:03:29,880 --> 00:03:34,150
أخطّط لإخبار صديقي
.في الوطن عن هذا اللّغز

42
00:03:34,150 --> 00:03:36,280
...صديقك الّذي يحبّ حلّ الألغاز

43
00:03:36,280 --> 00:03:40,390
.أحتاج لمعرفة الحقيقة قبل أن يصلني ردّه

44
00:03:40,390 --> 00:03:43,040
.وإلاّ، لن أعرف إن كان على حقّ أم لا

45
00:03:44,140 --> 00:03:47,580
.سأحلّ هذا اللّغز

46
00:03:49,190 --> 00:03:52,550
هل حدّدنا من خلف الهجوم؟

47
00:03:52,550 --> 00:03:55,510
.اعترف الرّجل الّذي اعتقلناه

48
00:04:03,330 --> 00:04:07,100
من أرسلك للهجوم على السّيّد أوكوبو؟

49
00:04:07,100 --> 00:04:08,600
.سيّدنا

50
00:04:08,600 --> 00:04:09,830
سيّدكم؟

51
00:04:09,830 --> 00:04:12,980
.ذلك ما نطلق عليه

52
00:04:12,980 --> 00:04:15,600
.إنّه يخفي وجهه بلثام

53
00:04:15,600 --> 00:04:17,400
.يبدو أنّه أجنبيّ

54
00:04:17,740 --> 00:04:19,850
هيراماتسو بوهي؟

55
00:04:19,850 --> 00:04:21,920
ما الّذي يريده؟

56
00:04:22,400 --> 00:04:28,360
...يريد قتل أوكوبو واستغلال الفراغ السّياسيّ

57
00:04:30,440 --> 00:04:33,650
.لتحريض ساموراي ساتسوما السّابقين للتّمرّد

58
00:04:34,320 --> 00:04:35,550
ماذا قلت؟

59
00:04:38,710 --> 00:04:41,870
.في البداية ساغا، والآن كاغوشيما

60
00:04:41,870 --> 00:04:45,550
.جنود ساتسوما لا يستهان بهم
.إنّهم لا يخشون الموت

61
00:04:46,200 --> 00:04:51,070
،إن اتّحدوا معًا لقتال الحكومة
.فسيكون الوضع حرجًا جدًّا

62
00:04:51,520 --> 00:04:55,420
علينا التّحرّك قبل أن يصير
...الرّفاق القدامى

63
00:04:57,010 --> 00:04:59,030
.أعظمَ أعدائنا

64
00:05:01,230 --> 00:05:05,450
بالمناسبة، ماذا حدث للرّجل
الّذي تلقّى الرّصاصة بدلاً منّي؟

65
00:05:05,450 --> 00:05:07,450
.اسمه أوريغاسا شيزوما

66
00:05:07,450 --> 00:05:09,850
.إنّه يرتاح الآن في المستشفى

67
00:05:11,180 --> 00:05:13,250
...بشأن الرّجل الّذي هاجمك

68
00:05:13,250 --> 00:05:15,150
كيف بدا؟

69
00:05:15,150 --> 00:05:16,420
.الفاعل امرأة

70
00:05:16,420 --> 00:05:17,610
ما صفاتها؟

71
00:05:17,610 --> 00:05:18,850
.لم أنظر إليها جيّدًا

72
00:05:19,710 --> 00:05:22,650
حسنًا، ما الّذي ستفعله الآن؟

73
00:05:22,650 --> 00:05:24,620
.سأرتاح لأتعافى

74
00:05:24,620 --> 00:05:28,270
هلاّ فكّرت في ارتداء الزّيّ مرّة أخرى؟

75
00:05:28,270 --> 00:05:29,810
لماذا قد أفعل ذلك الآن؟

76
00:05:29,810 --> 00:05:34,620
.يناشدك السّيّد أوكوبو لتعود

77
00:05:34,620 --> 00:05:37,020
.لقد أنقذت حياته في نهاية المطاف

78
00:05:37,020 --> 00:05:40,090
.صار اسمك مشهورًا
.ستبلغ مناصب عليا بالتّأكيد

79
00:05:40,970 --> 00:05:42,300
.لا أهتمّ لذلك

80
00:05:58,300 --> 00:06:00,510
تنفّس عن غضبك على الخيزران الآن؟

81
00:06:00,510 --> 00:06:02,410
.تبدو لي محبطًا للغاية

82
00:06:02,410 --> 00:06:04,280
.أنا في أفضل حالاتي

83
00:06:04,280 --> 00:06:06,220
.لا تحاول خداعي

84
00:06:06,220 --> 00:06:07,980
.ذلك واضح لي من سيفك

85
00:06:23,820 --> 00:06:27,400
.إنّ العقل المضطرب يسلبُ السّيفَ حدّتَه

86
00:06:28,050 --> 00:06:30,900
أنت تخفي شيئًا ما، صحيح؟

87
00:06:34,160 --> 00:06:37,120
.أعرف المرأة الّتي أطلقت النّار عليّ

88
00:06:37,640 --> 00:06:39,960
.هذه صورة قديمة

89
00:06:39,960 --> 00:06:44,800
الفتاة في الصّورة هي من أطلقت
.النّار عليّ واسمها كانوماتا سوميي

90
00:06:44,800 --> 00:06:46,160
من تكون؟

91
00:06:47,080 --> 00:06:48,500
.خطيبتي

92
00:06:49,790 --> 00:06:52,510
.يبدو أنّك فشلت في مهمّتك

93
00:06:52,510 --> 00:06:54,260
.أنا أعتذر

94
00:06:54,260 --> 00:06:56,690
.لا حاجة لذلك يا هينازورو

95
00:06:56,690 --> 00:07:01,840
،لكانت إزاحة أوكوبو عن الطّريق مثاليّة
.لكنّنا حقّقنا الهدف الرّئيسيّ من المهمّة

96
00:07:01,840 --> 00:07:03,400
ما الّذي تعنيه؟

97
00:07:03,820 --> 00:07:08,350
لا بدّ أنّ الحادثة قد زرعت شعورًا
.قويًّا بالخطر بين صفوف الحكومة

98
00:07:08,350 --> 00:07:14,070
.سيوقظون الآن دبًّا خطيرًا بأيديهم من سباته

99
00:07:14,830 --> 00:07:20,790
هنالك الكثير من السّاموراي السّابقين
.الأكفّاء في كاغوشيما نجوا من حرب بوشين

100
00:07:20,790 --> 00:07:26,130
لن يكون الجيش الحاليّ كافيًا
.لهزيمتهم، إن حان ذلك الوقت

101
00:07:26,130 --> 00:07:29,790
سيكون علينا وضع حدّ لهم
.قبل أن يحشدوا جنودهم

102
00:07:29,790 --> 00:07:32,340
سيبذل قسم شرطة العاصمة كلّ مجهوداته

103
00:07:32,340 --> 00:07:36,860
للبحث عن العقل المدبّر
.هيراماتسو بوهي واعتقاله

104
00:07:36,860 --> 00:07:39,720
.لن يكون الأمر بتلك السّهولة

105
00:07:39,720 --> 00:07:41,680
ألا يوجد ما يمكننا فعله؟

106
00:07:43,490 --> 00:07:45,100
.هناك طريقة واحدة فقط

107
00:07:46,090 --> 00:07:49,720
.سيكون علينا جذب بطل السّاموراي إلى جانبنا

108
00:07:50,480 --> 00:07:51,810
...تقصد

109
00:07:52,760 --> 00:07:56,800
.سنعيد سايغو تاكاموري إلى قلب الحكومة

110
00:08:06,730 --> 00:08:08,790
!سايغو-سينسي

111
00:08:08,790 --> 00:08:11,760
!تلقّينا تلغراف من أوكوبو في طوكيو

112
00:08:12,930 --> 00:08:15,850
...يبدو أنّ وقتي

113
00:08:17,580 --> 00:08:19,450
.قد حان أخيرًا

114
00:08:20,610 --> 00:08:24,270
.اختفت سفينة هيراماتسو من مياه تسوكيجي

115
00:08:24,270 --> 00:08:26,570
.إذًا فهو مختبئ الآن

116
00:08:26,570 --> 00:08:30,610
.واصلوا مراقبة موريا
.سيقودنا إلى هيراماتسو في النّهاية

117
00:08:30,610 --> 00:08:32,280
.أنا سأتبعه

118
00:08:32,280 --> 00:08:36,600
.سأراقب المنشأة الّتي بنوها

119
00:08:36,600 --> 00:08:40,070
.كنتُ أتساءل ما الغاية من ذلك المكان

120
00:08:40,910 --> 00:08:43,400
،بما أنّنا نعرف الآن أنّ لا وجود للذّهب

121
00:08:43,400 --> 00:08:46,540
.لا أعتقد أنّنا نحتاج لمواصلة التّحقيق في أمره

122
00:08:46,870 --> 00:08:49,650
لماذا لا نعتقله بتهمة قتل الشّرطيّ؟

123
00:08:49,650 --> 00:08:53,720
.لدينا مشكلة جديدة تُدعى هيراماتسو بوهي

124
00:08:54,220 --> 00:08:57,870
.اتبع كيوشيرو وحدّد مخبأه

125
00:09:02,570 --> 00:09:05,810
.أخبريني المزيد عن سوميي رجاءً

126
00:09:05,810 --> 00:09:06,820
...لكن

127
00:09:07,440 --> 00:09:11,700
.ما عاد شيزوما-سان من الشّرطة الآن
.بإمكانك إخباره بأيّ شيء

128
00:09:11,700 --> 00:09:14,260
!أرجوك! أنا أتوسّل إليك

129
00:09:16,960 --> 00:09:18,460
.مفهوم

130
00:09:21,250 --> 00:09:22,640
ما الّذي تفعلينه؟

131
00:09:23,320 --> 00:09:24,790
...هتان العينان

132
00:09:25,140 --> 00:09:27,300
.إنّهما يشبهان عينا الفتاة في الصّورة

133
00:09:28,560 --> 00:09:31,140
أنت كانوماتا سوميي، صحيح؟

134
00:09:31,540 --> 00:09:35,920
هل أتيتِ لمعرفة إن كنتِ قد قتلتِ خطيبك؟

135
00:09:37,920 --> 00:09:41,970
.أختي هينازورو قاتلة مُغتالة

136
00:09:43,260 --> 00:09:46,230
.سبق وسلبت حياة الكثيرين

137
00:09:46,230 --> 00:09:48,400
لماذا قد تفعل شيئًا كهذا؟

138
00:09:53,490 --> 00:09:56,150
.اخترت الشّخص الخطأ لتواجهيه بالسّيف

139
00:09:56,890 --> 00:10:00,560
على رسلك. أهذا هو المسدّس
الّذي أطلقت به على شيزوما؟

140
00:10:00,560 --> 00:10:02,110
هل شيزوما-سان بخير؟

141
00:10:02,360 --> 00:10:04,370
.أشكّ في ذلك

142
00:10:04,370 --> 00:10:07,490
.لقد التمّ شمله بخطيبته بأسوأ طريقة ممكنة

143
00:10:07,490 --> 00:10:09,440
.أفترض أنّه محطّم الآن

144
00:10:10,960 --> 00:10:16,870
لماذا خاطر بحياته لحماية
رجل دمّر موطنه أيزو؟

145
00:10:16,870 --> 00:10:19,970
ولماذا صرتِ أنت قاتلة؟

146
00:10:20,380 --> 00:10:23,260
سلكت أختي درب الاغتيال للانتقام

147
00:10:23,260 --> 00:10:26,810
.من حكومة ميجي الّتي سلبت كلّ شيء منها

148
00:10:27,340 --> 00:10:31,110
.لأنّها لم تعلم أنّك لا تزال على قيد الحياة

149
00:10:32,150 --> 00:10:36,450
.ترك شيزوما ماضيه خلفه للبحث عنك

150
00:10:36,450 --> 00:10:38,620
،ولأجل ذلك، صار شرطيًّا

151
00:10:38,620 --> 00:10:41,860
وعمل تحت أمرة نفس الأشخاص
.الّذين كانوا أعداءه

152
00:10:42,680 --> 00:10:44,080
من أجلي؟

153
00:10:44,080 --> 00:10:48,700
.إنّه مخلص لك بشدّة
.لا يسعني سوى أن أحسدك

154
00:10:49,730 --> 00:10:52,870
كومي-سان، هل قتلتِ أنت أيضًا؟

155
00:10:55,000 --> 00:10:56,580
.أردتُ المساعدة

156
00:10:57,110 --> 00:10:59,130
.لكنّها أبت السّماح لي

157
00:10:59,970 --> 00:11:02,550
.كلّ ما كان بوسعي فعله هو الوقوف إلى جانبها

158
00:11:02,950 --> 00:11:04,640
.أرجوك يا شيزوما-سان

159
00:11:05,130 --> 00:11:06,940
.أنقذها

160
00:11:07,290 --> 00:11:10,650
...إنّ جسدها... ما عاد

161
00:11:15,690 --> 00:11:19,270
ما علاقتك بشيزوما-سان؟

162
00:11:22,250 --> 00:11:23,660
...أنا

163
00:11:26,960 --> 00:11:28,210
.معلّمته

164
00:11:36,900 --> 00:11:40,590
مرض... خطير في الصّدر؟

165
00:11:41,970 --> 00:11:43,310
...مستحيل

166
00:11:43,310 --> 00:11:48,410
،إلى أن يخمد نور حياتها
فهي تنوي القتال لأجل السّيّد

167
00:11:49,090 --> 00:11:51,510
.والأجل أيزو الّتي ما عاد وجود لها

168
00:11:52,550 --> 00:11:53,560
هل أنت بخير؟

169
00:11:53,560 --> 00:11:55,850
.تراجعي! لا تقتربي منّي

170
00:11:57,750 --> 00:11:58,680
السّيّد"؟"

171
00:11:58,990 --> 00:12:01,290
.الرّجل الّذي يصدر أوامر الاغتيال

172
00:12:01,290 --> 00:12:02,650
من يكون؟

173
00:12:02,650 --> 00:12:05,320
.لا أعرف الكثير عنه أيضًا

174
00:12:19,860 --> 00:12:22,590
،في البداية، لاحظت اختفاء القمر

175
00:12:22,590 --> 00:12:26,920
وبعدها، بدأت تتساقط أسماك
!الكوي الخشبيّة من السّماء

176
00:12:26,920 --> 00:12:28,910
!تفاجأت كثيرًا

177
00:12:30,930 --> 00:12:35,310
.سقطت من السّماء. لا بدّ أنّه فأل خير

178
00:12:35,310 --> 00:12:37,650
.وراقني أنّ لونها أحمر

179
00:12:38,140 --> 00:12:41,070
أتى آخرون للحديث معك؟

180
00:12:41,070 --> 00:12:43,040
.لم يهتمّوا لكوني مشغولاً

181
00:12:43,040 --> 00:12:46,550
لم يكفّوا عن طرح الأسئلة عليّ عن المكان
.الّذي وجدتها فيه وما إلى ذلك

182
00:12:46,550 --> 00:12:50,110
.بعدها ضربوني عندما اشتكيت
.كانوا يخطّطون لأمر سيّئ بالتّأكيد

183
00:13:33,920 --> 00:13:38,310
لماذا لم تطلق؟ ستجلب علينا
.الكثير من الأعداء بتركها تذهب

184
00:13:38,310 --> 00:13:40,500
.إن زاد الأعداء، زاد المال

185
00:13:40,500 --> 00:13:42,080
!أصبت

186
00:13:43,350 --> 00:13:44,190
ماذا؟

187
00:13:45,220 --> 00:13:49,050
لا أصدّق أنّ جرذًا تسلّل إلى هنا
.قبل المهمّة الحرجة

188
00:13:49,050 --> 00:13:54,730
.علينا نقل البضاعة لمكان آخر من باب الحيطة

189
00:13:55,120 --> 00:13:57,440
.مرحبًا يا سيّد غوتو

190
00:13:57,440 --> 00:14:03,050
إنّك ودود جدًّا بالنّسبة لرجل
.أحدث ثقبًا في بطني

191
00:14:03,050 --> 00:14:05,820
.لديّ هديّة أخرى لك هنا إن أردت

192
00:14:05,820 --> 00:14:10,950
،بمجرّد أن تودّع جذعك
.فلن تزعجك بطنك بعد ذلك

193
00:14:10,950 --> 00:14:12,240
.سُحقًا

194
00:14:12,240 --> 00:14:14,220
.ضع سلاحك جانبًا

195
00:14:14,220 --> 00:14:16,820
.جميعنا رفاق نعمل نحو نفس الهدف

196
00:14:16,820 --> 00:14:18,510
.انسوا كلّ عداء بينكم

197
00:14:18,510 --> 00:14:20,160
.الأمر ليس بتلك السّهولة

198
00:14:20,160 --> 00:14:22,250
!كاد هذان الوغدان أن يسلباني حياتي

199
00:14:22,250 --> 00:14:23,690
.إنّه مجرّد عمل

200
00:14:23,690 --> 00:14:24,920
.لا شيء شخصيّ

201
00:14:24,920 --> 00:14:27,070
!ربّما هذا صحيح بالنّسبة لكما، لكن ليس لي

202
00:14:27,070 --> 00:14:30,260
.السّيّد هو من عيّنهما
.كما يوافق الزّعيم موريا عليهما أيضًا

203
00:14:32,020 --> 00:14:33,540
.أعلم ذلك

204
00:14:36,210 --> 00:14:38,700
أهو من أتباع كيوشيرو؟

205
00:14:38,700 --> 00:14:40,810
.إنّه مصاب

206
00:14:41,340 --> 00:14:44,690
عليكم أن تحسنوا معاملة الرّهبان
.وإلاّ جلبتم لنا سوء الحظّ

207
00:14:48,010 --> 00:14:49,560
أتريد نفسًا من هذا؟

208
00:14:52,330 --> 00:14:57,250
هذا ليس شيئًا مقارنة بالألم
.الّذي سبّبه لي كيوشيرو

209
00:14:57,250 --> 00:14:59,950
.جهّزوا العربة لنقل البضاعة

210
00:14:59,950 --> 00:15:00,820
.حاضر

211
00:15:00,820 --> 00:15:05,200
.وتواصلوا مع الغراب. هذه فرصة لردّ الدّين

212
00:15:11,940 --> 00:15:13,480
.حمامة غنجو

213
00:15:13,900 --> 00:15:14,800
أتحمل رسالة؟

214
00:15:14,800 --> 00:15:15,560
.لا

215
00:15:15,560 --> 00:15:17,880
.يبدو أنّه في ورطة

216
00:15:18,900 --> 00:15:24,100
نحن جاهزون أخيرًا لإعادة عالم
.السّاموراي الحقيقيّ

217
00:15:24,100 --> 00:15:29,560
إنّنا نطلب منك قيادة التّحرّك
.الّذي سيُسقط الحكومة يا سيّدي

218
00:15:30,010 --> 00:15:36,520
بوهي. ينعم النّاس بالسّلام، وأنت ترغب
في جلب الحرب لهذه الأرض ثانية؟

219
00:15:30,110 --> 00:15:34,070
سيّد منطقة أيزو السّابق
ماتسودايرا كاتاموري

220
00:15:39,920 --> 00:15:43,040
.إنّ أيّام إزالة الدّماء بالدّماء قد ولّت

221
00:15:43,040 --> 00:15:46,260
.لا أصدّق ما الّذي تسمعه أذناي

222
00:15:46,260 --> 00:15:49,890
هل نسيت ما الّذي فعلوه خلال حرب بوشين؟

223
00:15:49,890 --> 00:15:53,710
هل نسيت حزن أولئك الّذين ماتوا لأجل أيزو؟

224
00:15:59,340 --> 00:16:01,980
أنت... ما الّذي تفعله هنا؟

225
00:16:02,890 --> 00:16:04,410
.ها قد وجدتك

226
00:16:04,410 --> 00:16:06,320
أكنت تبحث عنّي؟

227
00:16:06,320 --> 00:16:10,890
،نعم. سألت الشّرطيّ ميدوريكاوا عنك
.وأعطاني ذلك الكلب بدل إجابتي

228
00:16:10,890 --> 00:16:12,690
.لديه أنف ممتاز

229
00:16:13,120 --> 00:16:15,240
ما الّذي تحتاجه؟

230
00:16:15,730 --> 00:16:18,320
.إنّنا نعرف مكان شوراغامي كيوشيرو

231
00:16:24,520 --> 00:16:25,640
من هناك؟

232
00:16:27,220 --> 00:16:29,920
.هذه هي نقطة بداية قصّة مرعبة

233
00:16:30,380 --> 00:16:34,950
.أنت هي الفتاة الّتي كانت تختبئ بين المدلّكين

234
00:16:34,950 --> 00:16:38,860
من يكون هؤلاء؟
ما الّذي يفعلونه بهذه الأشياء؟

235
00:16:39,310 --> 00:16:42,110
.لا شيء يجبرني على إجابتك

236
00:16:42,110 --> 00:16:44,980
.سأحرّرك إن أخبرتني

237
00:16:47,570 --> 00:16:50,980
.إنّهم أشرار يعملون مع عشيرة موريا

238
00:16:50,980 --> 00:16:54,940
،يبدو أنّهم يصنعون شيئًا ما هنا
.لكن لا فكرة لديّ عمّا يكون

239
00:16:55,330 --> 00:16:57,470
.لا أعرف ما الغرض من تلك الأشياء أيضًا

240
00:16:57,470 --> 00:16:59,350
.أنت بلا فائدة تمامًا

241
00:16:59,350 --> 00:17:02,460
.أجبتُ على سؤالك. لذلك حرّريني

242
00:17:02,460 --> 00:17:04,080
.لديّ سؤال آخر

243
00:17:04,780 --> 00:17:06,800
ما هي إل دورادو؟

244
00:17:07,270 --> 00:17:10,170
.يبدو أنّك تعرفين الكثير

245
00:17:10,170 --> 00:17:13,070
.إل دورادو تعني أرض الذّهب

246
00:17:13,070 --> 00:17:18,820
جمع جيش المتمرّدين الذّهب لشراء
.أسلحة من بروسيا خلال حرب بوشين

247
00:17:18,820 --> 00:17:21,440
إل دورادو هو اسم المكان
الّذي خُبّئ فيه الذّهب، صحيح؟

248
00:17:21,440 --> 00:17:27,060
إنّ كلّ إشاعة تبدو كالحقيقة
.في نظر أولئك الّذين عماهم الطّمع

249
00:17:27,060 --> 00:17:28,810
إذًا لا يوجد ذهب؟

250
00:17:28,810 --> 00:17:30,780
.أتساءل أنا بدوري عن ذلك

251
00:17:30,780 --> 00:17:32,510
.اذهبي واعثري عليه بنفسك

252
00:17:32,510 --> 00:17:34,430
.ذلك ما سأفعله

253
00:17:34,430 --> 00:17:36,110
!مهلاً، فكّي وثاقي

254
00:17:48,110 --> 00:17:49,710
!أنت! مكانك

255
00:17:57,360 --> 00:17:58,840
.هذا أنت

256
00:17:58,840 --> 00:18:00,630
!هذا من أجل غوين

257
00:18:03,840 --> 00:18:05,870
.لنسوِّ هذا الأمر

258
00:18:06,480 --> 00:18:07,410
.داريو

259
00:18:10,040 --> 00:18:12,480
.من الأفضل أن تقلق على نفسك أوّلاً

260
00:18:16,810 --> 00:18:18,250
.سأذهب خلفه

261
00:18:18,250 --> 00:18:19,920
.وأنت تولّ أمر داريو

262
00:18:25,220 --> 00:18:27,500
.أضرموا النّار بالمصنع بمجرّد خروج العربات

263
00:18:27,500 --> 00:18:28,110
.حاضر

264
00:18:28,590 --> 00:18:29,930
ألن تأتي؟

265
00:18:29,930 --> 00:18:33,870
.المتسلّل هو كيوشيرو. بإمكاني شمّه

266
00:18:33,870 --> 00:18:36,360
.سأقطعه بنفسي

267
00:18:41,180 --> 00:18:42,180
!انظر! هناك أمامنا

268
00:18:54,020 --> 00:18:55,570
.أنا الفائز

269
00:19:02,660 --> 00:19:05,930
.كان نزالاً جيّدًا يا روبين هود

270
00:19:12,560 --> 00:19:14,670
هل ما زلت حيًّا؟

271
00:19:18,090 --> 00:19:21,130
!كم اشتقت إليك يا كيوشيرو

272
00:19:22,160 --> 00:19:23,210
.غوتو

273
00:19:26,010 --> 00:19:28,060
!نالوا منه

274
00:19:41,330 --> 00:19:44,350
!تماسكوا! ما هو إلاّ رجل واحد

275
00:19:46,080 --> 00:19:46,620
.مرحبًا

276
00:19:52,330 --> 00:19:54,630
!ما الّذي تفعله؟

277
00:20:04,340 --> 00:20:06,880
...أيّها الكلب المسعور

278
00:20:24,930 --> 00:20:27,620
.انظر جيّدًا لمن تقتلهم

279
00:20:27,620 --> 00:20:30,330
.لديّ عين واحدة فقط، لذلك سامحني

280
00:20:30,760 --> 00:20:33,290
!شوراغامي كيوشيرو

281
00:20:34,700 --> 00:20:35,880
.هذا أنت

282
00:20:35,880 --> 00:20:41,090
.أنا أوريغاسا شيزوما
.أتيت للانتقام للشّرطيّ أوساناي

283
00:20:41,090 --> 00:20:42,900
...تأتون تِباعًا

284
00:20:42,900 --> 00:20:44,840
.لا بدّ أنّه يوم نحسك

285
00:20:55,240 --> 00:21:00,260
،ليتني أحمل مهلوساتي معي
.لما كان هذا الرّجل ندًّا لي

286
00:21:02,280 --> 00:21:04,940
لماذا قتلت الشّرطيّ أوساناي؟

287
00:21:04,940 --> 00:21:07,550
.كلّ ما فعلتُ هو التّخلّص من خطر كان سيحلّ بي

288
00:21:07,550 --> 00:21:10,980
هل تحاول القول أنّ الشّرطيّ
أوساناي هو من سحب سيفه أوّلاً؟

289
00:21:10,980 --> 00:21:14,120
.سل ذلك الرّجل هناك إن كنت تظنّ أنّي أكذب

290
00:21:14,120 --> 00:21:15,040
ماذا؟

291
00:21:24,910 --> 00:21:28,730
.يبدو أنّ البوذا يقف في صفّي

292
00:21:33,820 --> 00:21:34,700
!مهلاً

293
00:21:34,700 --> 00:21:35,690
!النّجدة

294
00:21:44,990 --> 00:21:46,190
.شكرًا لك

295
00:21:46,650 --> 00:21:48,090
.أنا مدين لك

296
00:21:53,020 --> 00:21:54,960
أين أنت يا كيوشيرو؟

297
00:21:54,960 --> 00:21:57,170
!اظهر وقاتلني

298
00:21:57,170 --> 00:22:00,400
.هذا المكان سيّئ أيّها الزّعيم. لنتراجع

299
00:22:00,400 --> 00:22:04,700
.أيّها الغبيّ. إيّاك أن تجبُن وإلاّ قتلتك أوّلاً

300
00:22:08,680 --> 00:22:09,970
!ها أنت ذا

301
00:22:27,650 --> 00:22:29,120
!أيّها الوحش

302
00:23:02,370 --> 00:23:05,060
.كنتُ أوشك أن أُشوى حيًّا

303
00:23:06,880 --> 00:23:09,730
.لديك خنجر غريب الشّكل

304
00:23:09,730 --> 00:23:13,590
تقصد هذا؟ إنّه نصل عالي
.الجودة ذو صناعة غربيّة

305
00:23:15,660 --> 00:23:20,970
سمعتُ أنّ النّصل الّذي قتل
.أوساناي-سان كان ذا حدّين

306
00:23:20,970 --> 00:23:22,200
فعلاً؟

307
00:23:26,500 --> 00:23:28,670
.أنت أكثر دهاءً ممّا توقّعت

308
00:23:28,670 --> 00:23:30,010
...ماكينو

309
00:23:31,220 --> 00:23:32,300
.أنت محقّ

310
00:23:33,180 --> 00:23:35,560
.أنا من قتل أوساناي

311
00:23:51,750 --> 00:23:52,870
هل أنت بخير؟

312
00:23:53,570 --> 00:23:54,410
.أنا أتألّم

313
00:23:55,220 --> 00:23:57,050
.هذا عقابي لا محالة

314
00:23:58,170 --> 00:24:02,560
.لأنّي خالفت القانون رغم أنّي شرطيّ

315
00:24:07,600 --> 00:24:09,160
.حان دورك الآن

316
00:24:09,160 --> 00:24:11,530
!وغد

317
00:24:18,600 --> 00:24:19,560
ماذا؟

318
00:24:31,290 --> 00:24:34,580
...كيوشيرو-ساما والجدّ غنجو

319
00:24:35,230 --> 00:24:37,590
...حسب ما يبدو

320
00:24:39,210 --> 00:24:41,790
.لم تحن ساعتي بعد

321
00:24:42,500 --> 00:24:45,020
!الجدّ! كيوشيرو-ساما

322
00:24:45,020 --> 00:24:46,960
.أرى أنّكما نجوتما أيضًا

323
00:24:46,960 --> 00:24:50,580
.يبدو أنّنا لسنا النّاجين الوحيدين