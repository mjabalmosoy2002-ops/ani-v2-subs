1
00:00:11,470 --> 00:00:13,100
!أوريتاني شيزويا

2
00:00:13,980 --> 00:00:16,100
.لم تقدّم كلّ ما لديك أيّها الوغد

3
00:00:16,100 --> 00:00:17,830
ما كلّ هذا فجأة؟

4
00:00:17,830 --> 00:00:19,990
خسرت في نزالنا عن قصد، صحيح؟

5
00:00:25,310 --> 00:00:27,790
.كان سيفك أسرع من سيفي

6
00:00:27,790 --> 00:00:29,090
.هذا كلّ ما هنالك

7
00:00:29,710 --> 00:00:34,180
كان بإمكانك قطع اللّحم وحتّى
.العظم بقوّتك الغاشمة

8
00:00:34,180 --> 00:00:35,880
لماذا تهاونت؟

9
00:00:35,880 --> 00:00:39,910
.تهاونتِ أنت أيضًا
.لقد هاجمتني بظهر سيفك

10
00:00:39,910 --> 00:00:44,520
،أتيتُ لأشارك في منافسة مسايفة
!وليس لقتل النّاس

11
00:00:46,780 --> 00:00:48,230
ما المضحك؟

12
00:00:48,230 --> 00:00:52,750
.عرفتُ هذا. لا يعقل أن تكوني المهاجم

13
00:00:52,750 --> 00:00:54,200
عمّ تتحدّث؟

14
00:00:55,320 --> 00:00:58,380
.اسمي الحقيقيّ أوريغاسا شيزوما

15
00:00:58,380 --> 00:01:00,620
.أنا شرطيّ في أساكوسا

16
00:01:00,620 --> 00:01:04,550
أشارك في الغيكّينكاي متخفّيًا
.للتّحقيق في هجوم معيّن

17
00:01:04,550 --> 00:01:06,000
تحقيق؟

18
00:01:06,000 --> 00:01:08,870
.ظننّا أنّكِ القاتل

19
00:01:08,870 --> 00:01:10,570
.آسف لأنّي اشتبهتُ بك

20
00:01:12,130 --> 00:01:15,970
.إنّك مستقيمة استقامة السّيف

21
00:01:17,330 --> 00:01:19,350
.لا بأس. فهمت

22
00:01:26,670 --> 00:01:27,850
!أمر عاجل

23
00:01:29,510 --> 00:01:31,310
ما الخطب أيّها الشّرطيّ ميدوريكاوا؟

24
00:01:33,400 --> 00:01:34,910
.الشّرطيّ أوساناي

25
00:01:36,410 --> 00:01:37,610
.لقد قُتل

26
00:01:48,570 --> 00:01:50,150
من قد يفعل هذا؟

27
00:01:50,640 --> 00:01:52,700
.ما زلنا نحقّق

28
00:01:53,060 --> 00:01:56,040
.يتمّ استجواب أشخاص في المنطقة

29
00:01:56,460 --> 00:01:57,820
.أيّها الرّئيس تانبا

30
00:02:06,720 --> 00:02:08,320
.أيّها الشّرطيّ ماكينو

31
00:02:09,050 --> 00:02:10,660
...إنّ الشّرطيّ أوساناي

32
00:02:13,100 --> 00:02:15,350
.عليّ إيجاد من هاجمه

33
00:02:15,350 --> 00:02:16,760
—وبيدي هاته

34
00:02:16,760 --> 00:02:17,970
ستعتقله؟

35
00:02:18,690 --> 00:02:19,850
أم كنت ستقول شيئًا آخر؟

36
00:02:21,710 --> 00:02:23,370
.شوراغامي كيوشيرو

37
00:02:23,980 --> 00:02:30,930
حسب الشّهود، كان شوراغامي كيوشيرو
.من قتل الشّرطيّ أوساناي

38
00:02:32,910 --> 00:02:37,420
!سنواصل منافسة الغيكّينكاي

39
00:02:37,420 --> 00:02:44,350
!في الجهة الشّرقيّة، شوراغامي كيوشيرو

40
00:02:44,350 --> 00:02:46,820
وفي الجهة الغربيّة... ماذا؟

41
00:02:46,820 --> 00:02:49,100
!شوراغامي كيوشيرو

42
00:02:49,100 --> 00:02:51,270
!لديّ سؤال لك

43
00:02:51,270 --> 00:02:53,100
ما الّذي يفعله؟

44
00:02:53,370 --> 00:02:55,650
أخذتَ دورك، صحيح؟

45
00:02:55,650 --> 00:02:57,930
هل قتلت أوساناي-سان؟

46
00:02:57,930 --> 00:03:00,150
.أنت! انزل عن الحلبة

47
00:03:00,150 --> 00:03:01,240
!أأنت الفاعل؟

48
00:03:01,480 --> 00:03:03,220
الرّجل الّذي من ساتسوما؟

49
00:03:03,220 --> 00:03:04,820
.تخلّصت منه قبل قليل

50
00:03:04,820 --> 00:03:06,290
!وغد

51
00:03:13,830 --> 00:03:16,660
...ذلك التّعطّش للدّماء
.وكأنّه شخص مختلف تمامًا

52
00:03:27,640 --> 00:03:29,880
.إنّك تقاتل الشّخص الخطأ

53
00:03:33,050 --> 00:03:34,190
.فوجيتا

54
00:03:34,630 --> 00:03:35,680
.ابتعد عن طريقي

55
00:03:38,900 --> 00:03:43,900
الحلقة 6      هجوم مفاجئ

56
00:03:55,540 --> 00:03:58,870
استيقظت أخيرًا؟
.ظللت فاقدًا للوعي ليومين كاملين

57
00:04:02,480 --> 00:04:04,730
.لا تتحرّك. ستخاطر بفتح جراحك

58
00:04:07,380 --> 00:04:09,380
لماذا تدخّلت في النّزال هكذا؟

59
00:04:10,580 --> 00:04:12,600
.للانتقام لصديقي

60
00:04:14,200 --> 00:04:19,740
كان شوراغامي ليقطع عنقك
.لولا تدخّل فوجيتا

61
00:04:21,010 --> 00:04:22,930
ماذا حدث بعد ذلك؟

62
00:04:23,780 --> 00:04:26,420
.خسر شوراغامي أمام فوجيتا

63
00:04:26,420 --> 00:04:29,080
.لا بدّ أنّه كان متعبًا بعد قتاله لك

64
00:04:30,290 --> 00:04:31,590
.هكذا إذًا

65
00:04:32,260 --> 00:04:37,990
.والمنتصر في النّهاية كان أنا ناكازاوا كوتو

66
00:04:37,990 --> 00:04:40,970
صحيح. بالمناسبة، لماذا أنت هنا؟

67
00:04:40,970 --> 00:04:43,220
.ستسبّب المشاكل لنفسك إن لم أوقفك

68
00:04:43,220 --> 00:04:44,890
.تلك ليست مشكلتك

69
00:04:44,890 --> 00:04:46,060
.اتّخذت قراري

70
00:04:47,900 --> 00:04:51,260
.أوريغاسا شيزوما، سأجعلك تلميذًا لي

71
00:04:52,000 --> 00:04:52,880
ماذا؟

72
00:04:53,760 --> 00:04:57,100
!حسنًا، اشربوا، اشربوا

73
00:04:57,100 --> 00:05:00,240
!جنينا الكثير من المال من الغيكّينكاي

74
00:05:00,240 --> 00:05:04,440
وما كنّا لنضطرّ لدفع الجائزة الماليّة
.لو لم يخسر شخص معيّن

75
00:05:06,170 --> 00:05:11,730
ماذا؟ هذا أفضل من أن يعتقد النّاس
.أنّنا تلاعبنا بالنّتائج ليفوز واحد منّا

76
00:05:11,730 --> 00:05:15,280
لنضع هذا جانبًا وأخبرني
.يا غوتو عن سير البناء

77
00:05:15,280 --> 00:05:21,420
إنّنا في الآونة الأخيرة نفتقر لليد العاملة
.لسبب ما، لذلك فنحن متأخّرون

78
00:05:21,420 --> 00:05:26,530
أيّها الغبيّ! إنّ الحرص على إبقاء كلّ
!شيء تحت السّيطرة هو عملك أنت

79
00:05:27,390 --> 00:05:30,010
.اسمع يا كيوشيرو. ساعده في ذلك

80
00:05:30,010 --> 00:05:34,940
مهلاً أيّها الزّعيم! سأنهي هذا المشروع
!بنفسي. لا أحتاج لأيّ مساعدة

81
00:05:34,940 --> 00:05:37,830
!أسرع وأنهه إذًا

82
00:05:37,830 --> 00:05:38,880
.حاضر

83
00:05:42,690 --> 00:05:45,290
!انهضوا للعمل جميعكم

84
00:05:45,290 --> 00:05:47,560
!هيّا، أسرعوا

85
00:05:51,400 --> 00:05:54,410
ما-ما هذا؟

86
00:05:57,070 --> 00:06:03,130
يبدو أنّ الأفيون الّذي فقدناه
.بدأ يظهر في منطقة هونجو فوكاغاوا

87
00:06:03,130 --> 00:06:04,840
على يد من؟

88
00:06:04,840 --> 00:06:09,260
.سؤال سخيف
.تلك المنطقة تابعة لعشيرة موريا

89
00:06:09,260 --> 00:06:11,000
هل ننتقم؟

90
00:06:11,000 --> 00:06:12,510
.بالطّبع

91
00:06:12,510 --> 00:06:15,180
.لهذا السّبب أبقيتكم إلى جانبي

92
00:06:16,570 --> 00:06:18,560
.من الأفضل أن أستفيد منكم كما يجب

93
00:06:18,560 --> 00:06:19,380
.حاضر

94
00:06:24,920 --> 00:06:26,170
كيف سار الأمر؟

95
00:06:26,170 --> 00:06:29,140
.زرعنا بذور الخلاف بشكل جيّد

96
00:06:29,140 --> 00:06:32,250
.سينشب الصّراع بين موريا وفوجيشيما قريبًا

97
00:06:32,990 --> 00:06:34,900
.كلّ ما بقي هو الانتظار

98
00:06:35,330 --> 00:06:40,200
.استعدّوا للقاء رفاقنا الجدد في الوقت الحاليّ

99
00:06:40,200 --> 00:06:41,140
.نعم

100
00:07:12,270 --> 00:07:14,150
من هناك؟

101
00:07:15,850 --> 00:07:17,820
.لا داعي للخوف

102
00:07:18,530 --> 00:07:21,820
.أنا مجرّد راهب يعزف البيوا كما ترين

103
00:07:24,470 --> 00:07:27,930
.أنت امرأة؟ هذا نادر بالفعل

104
00:07:27,930 --> 00:07:31,840
.لا أحد يأتي إلى هنا عادة
.يجد معظم النّاس المكان مربكًا

105
00:07:31,840 --> 00:07:36,070
.فهمت. إنّه المكان المثاليّ لإخفاء شيء ما

106
00:07:36,070 --> 00:07:40,940
هل أتيت إلى هنا بسبب إشاعة السّفينة؟

107
00:07:40,940 --> 00:07:41,850
سفينة؟

108
00:07:42,550 --> 00:07:45,060
.سأرشدك للبقيّة

109
00:08:02,790 --> 00:08:04,430
ما هذا التّجمّع؟

110
00:08:04,430 --> 00:08:08,870
فقد النّاس هنا مكانهم
.في المجتمع بعد الإصلاح

111
00:08:09,400 --> 00:08:14,440
أدّى إلغاء البوذيّة إلى تجريد هؤلاء
،الرّهبان من قدرتهم على خدمة بوذا

112
00:08:14,440 --> 00:08:16,630
.ممّا أجبرهم على العودة إلى الحياة الدّنيويّة

113
00:08:16,630 --> 00:08:22,340
كما أنّ المدلّكين وأمثالي أيضًا ليس لديهم
.مكان يذهبون إليه بعد حلّ التّودوزا

114
00:08:22,600 --> 00:08:26,780
.وفي عزّ عوزنا، سمعنا الإشاعة

115
00:08:26,780 --> 00:08:31,140
.سمعنا عن هذا المكان الّذي سيقبل بنا

116
00:08:31,960 --> 00:08:37,360
.مرحبًا يا رفاقي الّذين تخلّى عنكم الزّمن

117
00:08:37,360 --> 00:08:40,410
.ستصل السّفينة الموعودة بعد بضعة أيّام

118
00:08:40,410 --> 00:08:46,870
لن أدعو وجهتها بالسّماء، لكن يمكن
.للجميع العيش هناك دون تمييز

119
00:08:53,460 --> 00:08:56,150
كيف يسير التّحقيق بخصوص الذّهب؟

120
00:08:56,150 --> 00:08:58,880
.إنّنا نبذل ما في وسعنا

121
00:08:58,880 --> 00:09:01,190
.لا تملك بلادنا أيّ مال

122
00:09:01,190 --> 00:09:05,640
ومع ذلك، تستمرّ حكومتنا
في دفع مبالغ باهظة

123
00:09:05,640 --> 00:09:08,710
للسّاموراي السّابقين الّذين
.لا يساهمون بأيّ شيء للأمّة

124
00:09:11,530 --> 00:09:13,300
.نوشك بلوغ حدودنا

125
00:09:13,700 --> 00:09:16,460
ولكن ماذا سيحدث في افتراضك
إن توقّفنا عن الدّفع فجأة؟

126
00:09:16,460 --> 00:09:19,950
أتوقّع أنّه ستكون هناك انتفاضات
.للسّاموراي السّابقين في جميع أنحاء البلاد

127
00:09:21,300 --> 00:09:24,570
.لو كان لدينا ذهب، لوفّرنا بعض الوقت

128
00:09:24,570 --> 00:09:26,580
.علينا إيجاده، مهما كلّف الأمر

129
00:09:27,520 --> 00:09:30,800
ينتشر الأفيون في منطقتنا؟

130
00:09:30,800 --> 00:09:34,080
.إنّ عمّالنا بلا فائدة بسبب ذلك

131
00:09:34,080 --> 00:09:36,530
.مستحيل. ذلك الوغد فوجيشيما

132
00:09:36,530 --> 00:09:40,440
!بدأ العمل بدون إذني

133
00:09:40,440 --> 00:09:41,840
ما هذا؟

134
00:09:49,310 --> 00:09:50,490
ما كان ذلك؟

135
00:09:50,490 --> 00:09:52,680
انتقام الأبقار؟

136
00:09:53,450 --> 00:09:54,700
.إنّها ميتة

137
00:09:54,700 --> 00:09:55,740
!إنّها ميتة يا سيّدي

138
00:09:55,740 --> 00:09:57,420
.تلك البقرة اللّعينة أخافتني بشدّة

139
00:09:57,420 --> 00:09:58,770
!أخدموا النّار

140
00:10:01,000 --> 00:10:02,330
من يكون هذا؟

141
00:10:02,330 --> 00:10:03,440
!لا أصدّق هذا

142
00:10:03,440 --> 00:10:04,530
!نالوا منه

143
00:10:08,030 --> 00:10:08,790
!أيّها الوغد

144
00:10:10,330 --> 00:10:11,800
!أخرجوا الزّعيم من هنا

145
00:10:11,800 --> 00:10:13,250
!هيّا بنا يا زعيم

146
00:10:18,250 --> 00:10:19,940
...كلاّ

147
00:10:23,220 --> 00:10:24,420
...ما الّذي

148
00:10:26,130 --> 00:10:28,800
.يُرسل السّيّد فوجيشيما تحيّاته لك

149
00:10:29,920 --> 00:10:31,400
!غوتو

150
00:10:31,400 --> 00:10:32,680
!أيّها الوغد

151
00:10:35,470 --> 00:10:37,640
!أخرجنا من هنا يا سائق القارب

152
00:10:44,340 --> 00:10:48,740
.نجني الكثير من هذا العمل
.سيكون من العار أن ينتهي هنا

153
00:10:56,640 --> 00:10:57,530
من أنت؟

154
00:11:05,210 --> 00:11:08,520
.تمّ إرسالي إلى هنا لخدمتك

155
00:11:14,500 --> 00:11:16,160
.لا علم لي بهذا

156
00:11:16,160 --> 00:11:17,180
.غادري

157
00:11:18,720 --> 00:11:21,060
.سأُوبَّخ على هذا

158
00:11:21,700 --> 00:11:24,850
.افعل ما يحلو لك لو سمحت

159
00:11:38,040 --> 00:11:40,330
.توقّعت هذا

160
00:11:41,190 --> 00:11:42,930
من أرسلك؟

161
00:11:44,490 --> 00:11:45,540
.اقتلني

162
00:11:59,260 --> 00:12:01,330
.يبدو أنّك تعانين مرضًا قاتلاً

163
00:12:02,190 --> 00:12:04,750
.قد لا أعيش لرؤية يوم آخر

164
00:12:04,750 --> 00:12:06,860
إن قتلتني الآن، فلن يكون
.لديّ ما أندم عليه

165
00:12:08,290 --> 00:12:11,340
.إذًا فلا سبب لي لأقتلك

166
00:12:11,340 --> 00:12:13,040
.اذهبي حيث تشائين

167
00:12:13,880 --> 00:12:15,990
!أخي كيوشيرو، تعال بسرعة

168
00:12:18,210 --> 00:12:19,120
ماذا هنالك؟

169
00:12:19,120 --> 00:12:21,030
!تعرّض الزّعيم لهجوم

170
00:12:23,710 --> 00:12:28,440
.ذلك الوغد الخرف فوجيشيما
مع من يتعامل في رأيه؟

171
00:12:28,770 --> 00:12:31,480
.لن أسمح لهذا بالمرور مرور الكرام

172
00:12:31,480 --> 00:12:34,500
!سندمّرهم! جهّزوا أنفسكم

173
00:12:34,500 --> 00:12:35,490
!حاضر

174
00:12:45,530 --> 00:12:46,870
...شيزوما-سان

175
00:12:47,410 --> 00:12:49,950
.ستنضمّ إليك سوميي قريبًا

176
00:12:49,950 --> 00:12:51,700
.أختي هينازورو

177
00:12:56,160 --> 00:13:00,560
عرفتُ أنّي سأراك يومًا ما إن واصلتُ التّردّد
.على هذا المكان، وها قد عثرت عليك أخيرًا

178
00:13:00,560 --> 00:13:02,460
لماذا كلّ هذا الشّوق؟

179
00:13:02,460 --> 00:13:05,680
...عليّ إخبارك بشيء. إنّ خطيبك

180
00:13:05,680 --> 00:13:07,730
.أوريغاسا شيزوما-سان حيّ

181
00:13:15,310 --> 00:13:18,710
الشّرطيّ أوريغاسا! هل أنت
واثق أنّ بإمكانك العودة للعمل؟

182
00:13:18,710 --> 00:13:20,470
كيف يجري التّحقيق؟

183
00:13:20,470 --> 00:13:23,270
هل اعتقلتم قاتل أوساناي-سان؟

184
00:13:23,270 --> 00:13:24,580
...ذلك

185
00:13:25,570 --> 00:13:29,700
ليس مسموحًا لنا بالتّحقيق
في قضيّة أوساناي؟ ماذا يحدث؟

186
00:13:29,700 --> 00:13:32,910
ستقوم شرطة العاصمة بإجراء
.التّحقيق بشكل مباشر

187
00:13:32,910 --> 00:13:35,030
.إنّ قتل شرطيّ أمر ليس بالهيّن

188
00:13:35,340 --> 00:13:37,160
هل تمّ اعتقال القاتل؟

189
00:13:37,160 --> 00:13:41,570
،يبدو أنّهم يراقبون شوراغامي كيوشيرو

190
00:13:41,570 --> 00:13:45,700
.لكن لم يتمّ اعتقاله بعد
.لا بدّ أنّ لديهم خطّة ما

191
00:13:47,490 --> 00:13:48,880
ماذا يحدث؟

192
00:13:49,380 --> 00:13:51,150
.لا أفهم شيئًا

193
00:13:51,150 --> 00:13:54,090
.هناك أمر آخر غير مفهوم

194
00:13:54,090 --> 00:13:55,590
...بشأن الهجوم الآخر

195
00:13:55,990 --> 00:13:59,440
استطعنا حلّ الأمر بعد الإمساك
.بالياكوزا في رسم الشّرطة

196
00:14:00,210 --> 00:14:05,730
.لقد عيّن قاتلاً مأجورًا للانتقام من شخص ما

197
00:14:06,640 --> 00:14:07,930
قاتلاً مأجورًا؟

198
00:14:08,360 --> 00:14:10,610
.الرّجل الّذي قُتل، تاتشيبانا يوجيرو

199
00:14:11,510 --> 00:14:13,340
.لم يكن ضحيّة

200
00:14:13,900 --> 00:14:17,840
.تاتشيبانا بنفسه كان المهاجم

201
00:14:24,280 --> 00:14:27,580
.لكنّه قُتل أثناء تنفيذ هجومه

202
00:14:28,360 --> 00:14:30,640
.على يد شوراغامي كيوشيرو

203
00:14:31,420 --> 00:14:35,720
كان دفاعًا عن النّفس، لكنّه
.قتل الرّجل في كلّ الأحوال

204
00:14:35,720 --> 00:14:39,400
.إنّنا نحاول الإمساك به للتّحقيق معه

205
00:14:39,400 --> 00:14:41,330
الهجوم الآخر أيضًا؟

206
00:14:41,330 --> 00:14:44,560
وضعت شرطة العاصمة يدها على
.القضيّة. ليس بوسعنا فعل أيّ شيء

207
00:14:45,110 --> 00:14:48,000
إذًا فإنّ أيّ شيء يخصّ شوراغامي كيوشيرو

208
00:14:48,000 --> 00:14:50,770
يتمّ التّعامل معه من طرف شرطة العاصمة؟

209
00:14:57,080 --> 00:15:01,460
قسم شرطة
أساكوسا

210
00:14:57,080 --> 00:15:01,460
دنبوين

211
00:15:08,340 --> 00:15:10,970
قسم شرطة
العاصمة

212
00:15:08,840 --> 00:15:10,970
!لماذا لا نعتقل المهاجم؟

213
00:15:10,970 --> 00:15:14,420
.ليس على شرطيّ دوريّات معرفة كلّ شيء

214
00:15:14,420 --> 00:15:17,020
.أنت مصاب. ركّز على شفائك

215
00:15:17,020 --> 00:15:19,570
!هل تمازحني؟! لقد قُتل صديقي

216
00:15:24,790 --> 00:15:26,530
.هذا كلّ ما يمكنني إخبارك به

217
00:15:26,530 --> 00:15:27,850
.لا يكفيني هذا

218
00:15:27,850 --> 00:15:31,330
!لا تتدخّل في هذه الحادثة
!هذا أمر مباشر

219
00:15:31,330 --> 00:15:34,750
!لا يمكنني الامتثال لأمر كهذا
...كان واحدًا منّا

220
00:15:35,370 --> 00:15:38,720
إن كان عمل الشّرطيّ هو التزام
،الصّمت عندما يُقتل صديقه

221
00:15:38,720 --> 00:15:40,560
!فما عدت أريد أن أظلّ شرطيًّا

222
00:15:42,140 --> 00:15:45,620
.يبدو أنّ موريا وفوجيشيما على خلاف

223
00:15:45,620 --> 00:15:48,180
.مات عدّة أشخاص سلفًا

224
00:15:48,180 --> 00:15:52,110
لا أصدّق أنّهما قد يهاجمان
...بعضهما قبل التّفكير في خيانتي

225
00:15:52,110 --> 00:15:54,380
.لا بدّ أنّ الطّمع نال منهم

226
00:15:54,380 --> 00:15:56,850
.كما أنّ الغراب قد تواصل معنا

227
00:15:56,850 --> 00:16:00,110
.إنّ اغتيال شوراغامي كيوشيرو انتهى بالفشل

228
00:16:00,110 --> 00:16:01,300
.فهمت

229
00:16:01,300 --> 00:16:05,890
.قد يكون من يخطّط لكلّ هذا في الخفاء

230
00:16:06,380 --> 00:16:08,840
.ربّما علينا وضع فخّ ما

231
00:16:14,100 --> 00:16:16,210
!استعدّوا جميعًا

232
00:16:22,710 --> 00:16:24,700
ما شأنك هنا؟

233
00:16:24,700 --> 00:16:28,150
.قيل لي أنّ هنالك قتالاً
.أنا هنا لبيع خدماتي

234
00:16:28,150 --> 00:16:30,430
.فشلت في الفوز بالجائزة الماليّة في النّهاية

235
00:16:30,430 --> 00:16:36,260
.لا أنصحك بالتّدخّل في قتال الياكوزا
.سيُحزن ذلك الكاتانا خاصّتك

236
00:16:36,260 --> 00:16:37,430
...إضافة لذلك

237
00:16:37,430 --> 00:16:39,220
.لن يحدث أيّ قتال

238
00:16:41,690 --> 00:16:44,020
.اسمح لي بلقاء زعيمكم رجاءً

239
00:16:45,010 --> 00:16:47,150
.لديّ رسالة من السّيّد

240
00:16:47,480 --> 00:16:53,840
.القتال فيما بيننا عقيم ولا نتيجة منه"
".توقّفوا على الفور

241
00:16:53,840 --> 00:16:55,150
!سُحقًا لذلك

242
00:16:56,230 --> 00:16:59,010
،إن رفضتم التّراجع

243
00:16:59,010 --> 00:17:02,200
.فسيرسل السّيّد رجاله للتّعامل معكم

244
00:17:02,500 --> 00:17:04,430
ما جوابكم؟

245
00:17:04,430 --> 00:17:09,150
،أنا لا أثق بفوجيشيما
...لكن إن أصرّ السّيّد

246
00:17:09,150 --> 00:17:11,680
.فلا خيار أمامنا

247
00:17:11,680 --> 00:17:13,020
.جيّد

248
00:17:13,020 --> 00:17:17,090
ستقام مراسم وقف القتال
.في وقت لاحق بحضور السّيّد

249
00:17:21,190 --> 00:17:23,470
.أظهر الملك نفسه أخيرًا

250
00:17:23,470 --> 00:17:25,220
.كما خطّطنا تمامًا

251
00:17:25,970 --> 00:17:29,660
سيصير الوضع أكثر خطورة بكثير
.من الآن فصاعدًا

252
00:17:29,660 --> 00:17:33,360
.ولكن في البداية، دعنا نودّع رفاقنا

253
00:17:33,680 --> 00:17:35,550
.أبلغوا هذه المعلومة للقبطان

254
00:17:48,820 --> 00:17:53,390
أيّها القبطان، سأترك رفاقنا
.الجدد تحت رعايتك

255
00:17:53,390 --> 00:17:55,510
ألن تأتي معنا؟

256
00:17:55,510 --> 00:18:00,040
أخطّط لقضاء ما بقي لي من
.وقت في السّفر مع كيوشيرو

257
00:18:00,040 --> 00:18:02,160
.أنت رجل مخلص بالفعل

258
00:18:02,160 --> 00:18:04,590
.لديّ رسالة من كيوشيرو

259
00:18:04,590 --> 00:18:09,300
،إن حدث له أيّ شيء
.اهتمّ بأمر إل دورادو رجاءً

260
00:18:11,190 --> 00:18:12,900
مـ-من تكونين؟

261
00:18:16,170 --> 00:18:18,580
!خلفها، خلفها

262
00:18:20,320 --> 00:18:22,680
!لا تحاولي حتّى المقاومة

263
00:18:29,850 --> 00:18:31,300
فوجيتا غورو؟

264
00:18:31,300 --> 00:18:32,240
.علينا الهرب

265
00:18:33,570 --> 00:18:36,970
من أنت على أيّ حال؟
ما الّذي تفعله هنا؟

266
00:18:36,970 --> 00:18:40,070
.ما تفعلينه تمامًا يا كوروغي سنري

267
00:18:40,070 --> 00:18:41,700
كيف تعرف اسمي؟

268
00:18:41,700 --> 00:18:42,800
.أنا أعرفك

269
00:18:43,370 --> 00:18:45,730
أنت جاسوسة بريطانيّة، صحيح؟

270
00:18:45,730 --> 00:18:49,350
.أحيانًا. أنا لا أعمل لدى أيّ أحد الآن

271
00:18:49,350 --> 00:18:51,520
هل تنوين أخذ الذّهب لنفسك؟

272
00:18:52,140 --> 00:18:54,850
يبدو أنّك لم تعثري على أيّ شيء
.في المعبد القديم

273
00:18:54,850 --> 00:18:59,370
هل من عاداتك مراقبة النّساء
يا زميلي العزيز؟

274
00:18:59,940 --> 00:19:02,000
إلى أين ستبحر تلك السّفينة؟

275
00:19:02,000 --> 00:19:05,450
.من يدري؟ ربّما إلى حيث يتمّ إخفاء الذّهب

276
00:19:08,030 --> 00:19:11,100
أنت عميل لدى قسم شرطة
العاصمة، صحيح؟

277
00:19:11,100 --> 00:19:13,300
.لا تعترض طريقي فحسب

278
00:19:13,300 --> 00:19:14,940
.إنّها امرأة ماكرة

279
00:19:20,250 --> 00:19:25,850
أنت تاجر وضيع. ما كنت لتتردّد
.في بيع حتّى رجالك مقابل المال

280
00:19:26,130 --> 00:19:29,100
.وأنتم الياكوزا تحبّون الاتّهامات الباطلة

281
00:19:29,100 --> 00:19:31,730
.أنتم من هاجم أوّلاً

282
00:19:31,730 --> 00:19:33,140
ماذا قلت؟

283
00:19:33,140 --> 00:19:34,440
.يكفي

284
00:19:34,820 --> 00:19:35,890
!السّيّد

285
00:19:36,290 --> 00:19:40,240
.إنّ القتال فيما بيننا هو قمّة الغباء

286
00:19:40,240 --> 00:19:42,630
.وقعتما في شرك العدوّ

287
00:19:42,630 --> 00:19:43,590
عدوّ؟

288
00:19:43,590 --> 00:19:45,480
عمّن تتحدّث؟

289
00:19:45,710 --> 00:19:49,390
.انتهت هذه المسرحيّة يا شوراغامي كيوشيرو

290
00:19:49,390 --> 00:19:51,070
...أو ربّما

291
00:19:51,070 --> 00:19:55,420
عليّ مناداتك بإيكِغامي سويتشيرو؟

292
00:19:55,420 --> 00:19:59,430
.التقينا أخيرًا يا هيراماتسو بوهي

293
00:19:59,430 --> 00:20:02,070
.فـ-فسّر ما يحدث هنا يا كيوشيرو

294
00:20:02,070 --> 00:20:08,980
كان كلّ هذا مخطّطًا وضعه
.بنفسه لاستدراجي

295
00:20:11,970 --> 00:20:15,870
إن كنت تعرف، فلماذا تظهر نفسك لي؟

296
00:20:16,150 --> 00:20:19,090
.لأرسلك إلى الجحيم ثانية

297
00:20:21,430 --> 00:20:24,980
لا بدّ أنّك ظننت أنّك أوقعت بي
.في فخّ. لكنّي آسف

298
00:20:24,980 --> 00:20:25,860
.اقتلوه

299
00:20:33,880 --> 00:20:35,160
!جهّز نفسك

300
00:20:38,900 --> 00:20:41,280
!أنت تجهل مع من تتعامل

301
00:20:56,090 --> 00:20:58,040
.هيراماتسو بوهي

302
00:20:58,040 --> 00:20:59,270
...سوف تشعر

303
00:20:59,540 --> 00:21:00,620
!بغضبي

304
00:21:15,350 --> 00:21:17,570
!لن أسمح بذلك

305
00:21:20,250 --> 00:21:21,540
!غوين

306
00:21:28,250 --> 00:21:29,430
!تماسك

307
00:21:29,430 --> 00:21:30,960
.لقد نالوا من غوين

308
00:21:30,960 --> 00:21:32,270
!لن أسامحكم

309
00:21:33,960 --> 00:21:35,270
أين هم؟

310
00:21:37,260 --> 00:21:39,840
.لا مكان لتختفي فيه يا روبين هود

311
00:21:40,600 --> 00:21:43,320
.أطلق هذا أمام المسدّس الرّشّاش

312
00:21:43,320 --> 00:21:45,150
!سيطلقون أوّلاً

313
00:21:45,150 --> 00:21:47,410
.قم بذلك وإلاّ مات كيوشيرو

314
00:21:47,880 --> 00:21:49,690
.لن يكون موت غوين هباءً

315
00:21:49,690 --> 00:21:50,950
.هذا سخيف

316
00:21:50,950 --> 00:21:54,920
.هيّا. اظهر، اظهر

317
00:21:56,380 --> 00:21:57,360
.أنت لي

318
00:21:58,820 --> 00:21:59,540
!الآن

319
00:22:17,060 --> 00:22:19,870
لا يمكنني استعمال دخاني
.في مثل هذه الرّياح

320
00:22:19,870 --> 00:22:21,150
.وما عادت لديّ سهام

321
00:22:29,570 --> 00:22:30,420
!اركبوا

322
00:22:47,120 --> 00:22:49,040
.يبدو أنّه ما عاد لدينا عمل

323
00:22:50,170 --> 00:22:51,960
.ستعملان عندي

324
00:22:52,350 --> 00:22:54,930
.للإطاحة بهم

325
00:22:54,930 --> 00:22:56,470
!مهلاً لحظة

326
00:22:58,900 --> 00:23:01,180
...ذلك الخائن

327
00:23:01,850 --> 00:23:03,940
!سأقتله بنفسي