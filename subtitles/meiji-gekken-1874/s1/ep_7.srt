1
00:00:05,820 --> 00:00:08,630
.تعالوا للاستمتاع بوقتكم

2
00:00:10,340 --> 00:00:12,770
أنت أحد رجال موريا، صحيح؟

3
00:00:12,770 --> 00:00:14,420
ومن تكونان؟

4
00:00:14,420 --> 00:00:16,270
أين هو شوراغامي كيوشيرو؟

5
00:00:16,270 --> 00:00:17,320
.لا أدري

6
00:00:19,820 --> 00:00:24,070
.إنّ هذا الرّجل سريع الغضب
.من الأفضل أن تتكلّم قبل أن تتأذّى

7
00:00:24,070 --> 00:00:26,040
!أنا لا أعرف بالفعل

8
00:00:26,040 --> 00:00:28,920
!إنّنا نسعى خلف ذلك الخائن أيضًا

9
00:00:28,920 --> 00:00:29,720
ماذا؟

10
00:00:42,370 --> 00:00:43,830
لماذا ساعدتني؟

11
00:00:44,400 --> 00:00:46,310
.بدا أنّك بحاجة للمساعدة

12
00:00:49,240 --> 00:00:51,200
.وأنا لديّ عادة للتّدخّل

13
00:00:56,370 --> 00:00:58,370
هل ستنضمّ إلى مجموعتنا؟

14
00:00:59,950 --> 00:01:04,790
أعتقد أنّ هذا السّيف سيحزن
.إن تورّط في قتال ياكوزا

15
00:01:04,790 --> 00:01:06,040
.لا تسخر منّي

16
00:01:06,420 --> 00:01:10,050
.كما أنّ العدوّ الحقيقيّ ليس ياكوزا

17
00:01:12,510 --> 00:01:14,730
.يبدو أنّ لديك أسبابك

18
00:01:14,730 --> 00:01:18,320
.أنا أضع حياتي على المحكّ
.سيكون عليك إخباري بكلّ شيء

19
00:01:19,030 --> 00:01:20,090
.حسنًا

20
00:01:20,090 --> 00:01:22,900
هل ستسمح له بالفعل بالانضمام لنا؟

21
00:01:22,900 --> 00:01:25,750
!لا بدّ أنّك تمزح
!مستحيل أن نثق به

22
00:01:25,750 --> 00:01:30,860
سنحتاج لسيّاف موهوب إن كنّا
.نرغب في مواجهة قوّات هيراماتسو

23
00:01:30,860 --> 00:01:33,640
أهذا هو اسم هدفنا؟

24
00:01:35,160 --> 00:01:37,000
.هيراماتسو بوهي

25
00:01:37,740 --> 00:01:40,080
.التقينا أوّل مرّة قبل ستّ سنوات

26
00:01:40,660 --> 00:01:43,960
.مباشرة في بداية حرب بوشين

27
00:01:45,330 --> 00:01:50,330
الحلقة 7       روابط مقدّرة

28
00:01:51,920 --> 00:01:55,340
السّنة الرّابعة لحقبة كِيو
الشّهر الأوّل

29
00:01:58,630 --> 00:01:58,880
ي

30
00:01:58,880 --> 00:01:59,090
ين

31
00:01:59,090 --> 00:01:59,340
ينـ

32
00:01:59,340 --> 00:01:59,590
ينـا

33
00:01:59,590 --> 00:01:59,800
ينـاي

34
00:01:59,800 --> 00:02:00,050
ينـايـ

35
00:02:00,050 --> 00:02:02,260
ينـايـر

36
00:02:03,170 --> 00:02:05,980
.السّنة الرّابعة لحقبة كِيو. الشّهر الأوّل

37
00:02:05,980 --> 00:02:13,180
نشب صراع بين الشّوغونيّة وتحالف
.ساتشو حول من سيحكم اليابان

38
00:02:17,400 --> 00:02:23,410
انتهت المعركة بانتصار ساتشو
.المدعومة بقوّة الإمبراطور

39
00:02:29,780 --> 00:02:36,260
،مع غياب نظام الشّوغونيّة الآن
.تطالب كلّ المناطق بالانضمام لقوّاتنا

40
00:02:30,330 --> 00:02:34,340
كاتسورا كوغورو
(عُرف لاحقًا باسم كيدو تاكايوشي)

41
00:02:36,260 --> 00:02:39,610
.وبذلك، صار لدينا أخيرًا حكومة جديدة

42
00:02:36,800 --> 00:02:40,760
إيواكورا تومومي

43
00:02:39,610 --> 00:02:42,400
.لن تكون الأمور بهذه السّهولة

44
00:02:42,400 --> 00:02:45,010
هل هنالك ما يقلقك يا سايغو؟

45
00:02:44,510 --> 00:02:48,480
سايغو تاكاموري

46
00:02:45,520 --> 00:02:49,980
وحّدنا قوانا لأجل الهدف الكبير
.المتمثّل في هزيمة الشّوغونيّة

47
00:02:50,730 --> 00:02:55,080
.لكنّهم انهاروا أبكر ممّا توقّعنا

48
00:02:56,480 --> 00:03:00,490
أوكوبو توشيميتشي

49
00:02:56,780 --> 00:03:00,580
،إنّ أيّ مجموعة بلا هدف
.لا تختلف عن أيّ عصابة

50
00:03:00,580 --> 00:03:05,820
إن لم نكن حذرين، فقد ينتهي بنا الأمر نقتل
.بعضنا في الحكومة الجديدة سريعة التّوسّع

51
00:03:08,640 --> 00:03:13,100
.نحتاج لعدوّ جديد

52
00:03:13,100 --> 00:03:14,990
.أيزو وشوناي

53
00:03:14,990 --> 00:03:18,380
هتان المنطقتان ستكونان
.عدوّين ممتازين للدّولة

54
00:03:18,380 --> 00:03:22,180
.إنّها الفرصة المثاليّة للانتقام

55
00:03:22,180 --> 00:03:23,800
.لا اعتراض لديّ

56
00:03:23,800 --> 00:03:27,000
.حسنًا. لنواصل حربنا إذًا

57
00:03:29,240 --> 00:03:31,110
.يا لها من مفاجأة

58
00:03:31,110 --> 00:03:35,040
من كان يتخيّل أنّ قائد منطقة
أيزو سيكون أجنبيًّا؟

59
00:03:35,630 --> 00:03:39,280
لقد مُنحت اسم هيراماتسو بوهي

60
00:03:39,280 --> 00:03:43,940
إضافة إلى سلطة تعادل مستشارًا
.عسكريًّا من قيادة أيزو

61
00:03:44,460 --> 00:03:47,730
.إنّ قلبي قلب ساموراي مثلك

62
00:03:47,730 --> 00:03:50,860
ما هو هذا الشّأن الّذي يجب
أن يظلّ سرًّا من منطقة شوناي؟

63
00:03:50,860 --> 00:03:54,400
إنّها خطّة لقتال جيش من الصّعاليك

64
00:03:54,400 --> 00:03:57,480
.أعلنوا أنفسهم الحكومة الجديدة

65
00:03:57,480 --> 00:04:02,790
تستعمل منطقتنا تقنيات التّدريب
.الغربيّ وأسلحة ناريّة متطوّرة سلفًا

66
00:04:02,790 --> 00:04:08,370
إنّ كلّ من يجرؤ على التّعدّي
.على أراضي شوناي، فسيلقى حتفه

67
00:04:08,370 --> 00:04:12,980
أقدّر حماستك، لكنّك فشلت
.في رؤية الواقع

68
00:04:12,980 --> 00:04:13,890
!هذه فظاظة

69
00:04:13,890 --> 00:04:16,110
.اهدأ يا سويتشيرو

70
00:04:16,110 --> 00:04:17,200
...لكن يا أبي

71
00:04:17,450 --> 00:04:20,760
.تمتدّ الحرب إلى أبعد من منطقة شوناي

72
00:04:20,760 --> 00:04:23,030
،ولقتال عدوّ مرعب كهذا

73
00:04:23,030 --> 00:04:26,130
.سنحتاج لانضمام قوّات مناطق توهوكو إلينا

74
00:04:26,130 --> 00:04:31,370
لكنّ عدّة من مناطق توهوكو
.ما زالت تستعمل الأسلحة القديمة

75
00:04:31,370 --> 00:04:34,400
هل سيكونون بالفعل ندًّا
لهذه الحكومة الجديدة؟

76
00:04:34,400 --> 00:04:36,370
.هناك إجراءات بإمكاننا اتّخاذها

77
00:04:36,370 --> 00:04:37,680
.برانت-دونو

78
00:04:42,760 --> 00:04:47,760
قنصل مملكة بروسيا في اليابان
ماكس فون برانت

79
00:04:43,110 --> 00:04:47,960
.ستوفّر لكم بروسيا الدّعم العسكريّ سرًّا

80
00:04:47,960 --> 00:04:51,370
أنت مستعدّ لعصيان الاتّفاق
بين القوى الغربيّة

81
00:04:51,370 --> 00:04:53,840
الّذي يقضي بعدم التّدخّل حتّى نهاية الحرب؟

82
00:04:53,840 --> 00:04:58,890
الهدف الحقيقيّ من اتّفاقية
الحياد هو منع الدّول الأخرى

83
00:04:58,890 --> 00:05:02,690
من محاولة الاستيلاء على السّلطة من
.خلال استغلال الصّراع الدّاخليّ في اليابان

84
00:05:02,690 --> 00:05:09,420
لكنّ بريطانيا تتمتّع بالفعل
.بنفوذ وتساعد ساتشو

85
00:05:09,740 --> 00:05:13,780
.ومن غير العدل أن تُستبعد بروسيا

86
00:05:13,780 --> 00:05:16,750
آمل ألاّ تكون نواياكم هي استعمار اليابان

87
00:05:16,750 --> 00:05:20,680
بعد إرهاق شعبها بتشجيعهم
.على القتال بين أنفسهم

88
00:05:21,620 --> 00:05:23,420
.يا له من تلميح أحمق

89
00:05:23,420 --> 00:05:24,890
كيف تجرؤ على إهانتي؟

90
00:05:24,890 --> 00:05:26,220
.مونِنوري-دونو

91
00:05:26,570 --> 00:05:31,050
يبدو أنّ العاطفة قد طغت على ابنك
.ولا يستطيع المشاركة في حديث عقلانيّ

92
00:05:31,050 --> 00:05:33,440
.غادر الغرفة يا شويتشيرو

93
00:05:35,930 --> 00:05:37,990
،أقدّر عرضكم للمساعدة

94
00:05:37,990 --> 00:05:42,850
لكنّ أيزو وبقيّة مناطق توهوكو
.لا يملكون المال لشراء الأسلحة

95
00:05:42,850 --> 00:05:48,860
سيُكلّف الأمر على الأقلّ خمسة ملايين ريو
.لتجهيز سفن حربيّة وأسلحة عصريّة

96
00:05:48,860 --> 00:05:50,250
خمسة مليون ريو؟

97
00:05:50,250 --> 00:05:52,070
.لا داعي للقلق

98
00:05:52,070 --> 00:05:54,000
.لديّ خطّة بديلة

99
00:06:01,890 --> 00:06:04,150
.سنصل إلى بروسيا قريبًا

100
00:06:04,150 --> 00:06:06,760
هل هذا بالفعل هو الخيار الصّائب؟

101
00:06:06,760 --> 00:06:10,360
لا يمكنني تصديق أنّ الدّول الأجنبيّة
.ستدعمنا بدون أيّ دافع خفيّ

102
00:06:10,360 --> 00:06:13,950
.لا خيار آخر لدينا. وافق السّيّد أيضًا

103
00:06:13,950 --> 00:06:19,450
لكنّ ذلك الرّجل المدعوّ هيراماتسو بوهي
.لا يبدو لي أهلاً للثّقة

104
00:06:21,000 --> 00:06:23,950
.شكرًا لقدومكم كلّ هذه المسافة

105
00:06:22,770 --> 00:06:26,740
رئيس وزراء بروسيا
بسمارك

106
00:06:23,950 --> 00:06:26,740
.أبلغني برانت بالوضع

107
00:06:27,010 --> 00:06:30,570
سنوفّر لكم الدّعم كدولة كما وعدنا

108
00:06:30,570 --> 00:06:32,480
.في مقابل التّنازل عن منطقة أيزو

109
00:06:32,480 --> 00:06:33,750
التّنازل؟

110
00:06:33,750 --> 00:06:35,360
ألا تقصد تأجير؟

111
00:06:36,710 --> 00:06:39,410
.قيل لي أنّه تنازل

112
00:06:40,740 --> 00:06:45,520
كنتُ أعتقد أنّ إيزو الّتي هي
،تحت سيطرة أيزو وشوناي الآن

113
00:06:45,520 --> 00:06:50,680
ستُؤجّر لبروسيا لمدّة 50 سنة مقابل
.خمسة ملايين ريو من الذّهب

114
00:06:52,090 --> 00:06:54,480
.ذلك ليس ما قيل لي

115
00:06:54,480 --> 00:06:56,350
.لا بأس بالتّنازل

116
00:06:56,350 --> 00:06:58,930
!مهلاً! هذا يعني أنّنا سنبيع أراضٍ يابانيّة

117
00:06:58,930 --> 00:07:01,350
!لن يتمّ القبول بذلك أبدًا

118
00:07:01,940 --> 00:07:05,640
.إذًا فهذه المحادثة لم تتمّ أبدًا

119
00:07:08,490 --> 00:07:12,040
إيكِغامي-دونو، هل تنوي العودة خالي الوفاض؟

120
00:07:12,500 --> 00:07:14,570
!بدأت الحرب سلفًا

121
00:07:14,570 --> 00:07:17,520
!إن خسرنا، فسنفقد المنطقة بحدّ ذاتها

122
00:07:18,290 --> 00:07:21,270
.لا أستطيع اتّخاذ هذا القرار بنفسي

123
00:07:21,270 --> 00:07:23,550
.علينا طلب قرار من سيّدنا

124
00:07:23,550 --> 00:07:27,540
.إنّك هنا ومعك سلطة منطقة شوناي بأكملها

125
00:07:27,540 --> 00:07:29,160
.اتّخذ القرار رجاءً

126
00:07:42,770 --> 00:07:45,620
.سنصل هونغ كونغ قريبًا يا والدي

127
00:07:45,620 --> 00:07:47,280
أتريد أن تتشارك شرابًا معي؟

128
00:07:47,850 --> 00:07:52,490
ما الخطب؟ إنّك تتصرّف بغرابة
.منذ اجتماعك مع بسمارك

129
00:07:57,780 --> 00:08:01,910
أليست هذه هي الوثيقة الّتي
تثبت اتّفاقنا السّرّيّ مع بروسيا؟

130
00:08:01,910 --> 00:08:03,430
.انظر لما بداخلها

131
00:08:03,430 --> 00:08:04,590
هل أنت واثق؟

132
00:08:10,530 --> 00:08:11,680
.هذا لا يعقل

133
00:08:11,680 --> 00:08:13,520
كيف وافقت على هذا؟

134
00:08:13,520 --> 00:08:15,730
.لم يكن لديّ خيار

135
00:08:15,730 --> 00:08:19,000
هل وافقت أيزو... هل وافق هيراماتسو على هذا؟

136
00:08:19,550 --> 00:08:23,850
.إنّ ذلك الرّجل هو من خطّط لكلّ هذا

137
00:08:27,810 --> 00:08:30,570
أنت! ما الّذي تظنّ أنّك فاعل؟

138
00:08:30,570 --> 00:08:32,530
تبدو منزعجًا. ماذا هنالك؟

139
00:08:32,790 --> 00:08:36,850
أعتقد أنّه لا يجدر بالسّاموراي
.فقدان رباطة جأشه

140
00:08:36,850 --> 00:08:38,750
!وما كان السّاموراي ليخون بلاده

141
00:08:39,510 --> 00:08:41,570
.أرى أنّك قد اطّلعتَ على الوثيقة السّرّيّة

142
00:08:41,570 --> 00:08:45,660
بدون المال، يصير من الضّروريّ
.الدّفع بطُرق أخرى

143
00:08:45,660 --> 00:08:47,720
.لا يتعلّق الأمر ببيع إيزو فحسب

144
00:08:47,720 --> 00:08:51,290
.تشير الوثيقة أنّ جيش بروسيا سينضمّ للمعركة

145
00:08:51,290 --> 00:08:55,440
.يتطلّب النّصر دعمًا قويًّا

146
00:08:55,440 --> 00:08:57,540
أهذا ما أخبرت به والدي لتوقع به؟

147
00:08:57,540 --> 00:09:00,160
.وقّع عليها بعد أن وافق على الشّروط

148
00:09:00,160 --> 00:09:03,580
لماذا لا توجّه غضبك نحو والدك؟

149
00:09:04,230 --> 00:09:05,820
...يا لك من

150
00:09:08,690 --> 00:09:10,000
!هيراماتسو-ساما

151
00:09:10,000 --> 00:09:11,060
ماذا هنالك؟

152
00:09:11,060 --> 00:09:12,930
!وصلنا تلغراف للتّوّ

153
00:09:12,930 --> 00:09:16,970
استسلمت منطقتا أيزو وشوناي
!للحكومة الجديدة

154
00:09:18,790 --> 00:09:22,430
هذا يعني... انتهاء الحرب؟

155
00:09:31,390 --> 00:09:33,750
.تأخّرنا كثيرًا

156
00:09:34,430 --> 00:09:38,390
.لكن ربّما كان هذا للأفضل

157
00:09:38,390 --> 00:09:41,340
،لو أنّنا أحضرنا جيش بروسيا معنا

158
00:09:41,340 --> 00:09:44,370
.لطلبت الحكومة الجديدة دعم بريطانيا

159
00:09:44,370 --> 00:09:47,890
ولكانت الأراضي اليابانيّة تُداس
.الآن تحت أقدام جنود أجنبيّين

160
00:09:47,890 --> 00:09:50,410
.ولصارت الحرب كابوسًا لا ينتهي

161
00:09:51,370 --> 00:09:53,240
.انتهى كلّ شيء

162
00:09:53,240 --> 00:09:58,390
سيكون علينا مناقشة ردّنا مع
.هيراماتسو-دونو قبل عودتنا لليابان

163
00:10:07,620 --> 00:10:08,750
...هذا

164
00:10:14,560 --> 00:10:15,620
!والدي

165
00:10:17,980 --> 00:10:19,910
!تماسك يا والدي

166
00:10:21,310 --> 00:10:22,270
!والدي

167
00:10:25,840 --> 00:10:27,920
!هيراماتسو بوهي

168
00:10:27,920 --> 00:10:30,470
.أظنّ أنّني مصرّ على أن تموت هنا

169
00:10:32,010 --> 00:10:34,530
!قتلتَ والدي وجميع رفاقنا الآخرين

170
00:10:34,530 --> 00:10:39,420
إن عرفت الحكومة الجديدة
،بشأن الصّفقة السّرّيّة مع بروسيا

171
00:10:39,420 --> 00:10:41,990
،فستنهار سمعة أيزو

172
00:10:41,990 --> 00:10:45,480
.وسيُجبر كاتاموري-ساما على تنفيذ السّيبّوكو

173
00:10:47,220 --> 00:10:50,090
!سينتهي الأمر بكلّ شيء في الظّلام

174
00:11:26,200 --> 00:11:27,320
أين أنا؟

175
00:11:32,380 --> 00:11:35,120
.لا تضغط على نفسك، قد تتأذّى أكثر

176
00:11:36,130 --> 00:11:38,500
.أرى أنّك استيقظت أخيرًا

177
00:11:38,500 --> 00:11:39,390
.اشرب هذا

178
00:11:45,480 --> 00:11:48,740
.سيخفّف من ألمك. تحمّل واشرب

179
00:11:48,740 --> 00:11:50,090
.شكرًا لك

180
00:11:50,090 --> 00:11:53,640
.يجدر بك شكر القبطان
.هو من انتشلك

181
00:11:53,640 --> 00:11:55,900
.أرى أنّك نجوت

182
00:11:56,210 --> 00:11:58,580
.أنت رجل محظوظ

183
00:12:04,920 --> 00:12:06,860
.يمكنني الشّعور بشراستك

184
00:12:07,350 --> 00:12:09,520
أهنالك شخص تودّ قتله؟

185
00:12:10,940 --> 00:12:12,580
أنت راهب، صحيح؟

186
00:12:12,900 --> 00:12:14,880
لماذا أنت هنا؟

187
00:12:14,880 --> 00:12:17,860
.ليس لديّ مكان أذهب إليه حاليًّا

188
00:12:18,270 --> 00:12:23,240
،لديّ معرفة معيّنة بالطّبّ
.لذلك أقوم بدور الطّبيب هنا

189
00:12:23,240 --> 00:12:24,830
!أنت، اسمع

190
00:12:24,830 --> 00:12:28,240
،إن كانت لديك قوّة إضافيّة
!فساعدنا في العمل هنا

191
00:12:28,240 --> 00:12:31,320
!لا طعام لمن لا يشارك في العمل

192
00:12:55,070 --> 00:12:56,680
.شكرًا على المساعدة

193
00:12:57,210 --> 00:13:02,430
اسمع، إن لم يكن لديك مكان
تقصده، فلماذا لا تنضمّ لطاقمنا؟

194
00:13:02,430 --> 00:13:07,400
أقدّر عرضك هذا، لكن هنالك
.شيء أحتاج لإنهائه

195
00:13:07,400 --> 00:13:09,410
ستنتقم لما حدث لعينك اليمنى؟

196
00:13:10,610 --> 00:13:11,800
.أستأذن

197
00:13:12,530 --> 00:13:15,140
.سنظلّ هنا لبضعة أيّام أخرى

198
00:13:15,140 --> 00:13:17,320
.عد إن غيّرتَ رأيك

199
00:13:17,680 --> 00:13:19,550
!أفسحوا الطّريق

200
00:13:19,550 --> 00:13:20,900
.ابتعدوا

201
00:13:20,900 --> 00:13:21,650
!ابتعدوا

202
00:13:21,650 --> 00:13:25,120
سمعتُ أنّه مسيحيّ نزل في ناغاساكي
.بعد أن صعد على سفينة ما

203
00:13:25,120 --> 00:13:28,210
سيُضرب حتّى الموت
ما لم يتخلّ عن دينه، صحيح؟

204
00:13:28,210 --> 00:13:29,710
.يا إلهي

205
00:13:32,320 --> 00:13:34,390
هل أبحرت سفينة ليفي سلفًا؟

206
00:13:34,390 --> 00:13:35,970
.السّفينة البروسيّة

207
00:13:35,970 --> 00:13:37,030
.لا أدري

208
00:13:37,030 --> 00:13:38,840
لا تدري؟

209
00:13:38,840 --> 00:13:40,010
!أنت

210
00:13:40,330 --> 00:13:41,530
.نعم. أنا أكلّمك

211
00:13:41,910 --> 00:13:44,130
.ذلك الشّعار من منطقة شوناي

212
00:13:44,130 --> 00:13:46,030
هل أنت عدوّ للدّولة؟

213
00:13:54,360 --> 00:13:55,250
هل وجدته؟

214
00:13:55,250 --> 00:13:57,290
.لا. علينا البحث هناك

215
00:13:57,290 --> 00:13:58,010
.حسنًا

216
00:14:04,000 --> 00:14:06,080
.ما زال الوقت باكرًا على الاسترخاء

217
00:14:07,090 --> 00:14:12,240
أنت الأعور الملقّب بعدوّ الدّولة
الّذي ضرب ذلك الموظّف، صحيح؟

218
00:14:12,930 --> 00:14:14,160
ومن تكون أنت؟

219
00:14:14,540 --> 00:14:16,540
.صائد مكافآت

220
00:14:16,540 --> 00:14:21,010
أنوي تسليمك والحصول على
.بعض المال للشّراب

221
00:14:21,310 --> 00:14:23,470
تعتقد أنّ الأمر سيكون بتلك السّهولة؟

222
00:14:23,470 --> 00:14:25,460
.سأجرّب حظّي

223
00:14:43,650 --> 00:14:45,280
.ما ذلك الضّجيج

224
00:14:48,280 --> 00:14:51,330
ماذا؟ ما زال بإمكانك الوقوف
حتّى بعد تلقّيك لذلك؟

225
00:14:52,620 --> 00:14:54,740
.يا لها من خدعة ممتعة

226
00:14:54,740 --> 00:14:56,680
.لم أرغب في تفويتها

227
00:14:56,680 --> 00:14:58,130
!عثرت عليه

228
00:14:58,690 --> 00:15:01,590
!أيّها الرّجل المثير للشّبهات
!لا تقاوم الاعتقال

229
00:15:03,840 --> 00:15:06,920
.هذا مؤسف. يبدو أنّ الأمر انتهى

230
00:15:13,350 --> 00:15:14,200
.اسمع

231
00:15:14,670 --> 00:15:16,380
.لنصعد لشرب شيء ما

232
00:15:16,380 --> 00:15:17,970
.تبدو فكرة جيّدة

233
00:15:42,120 --> 00:15:43,970
أنت، أيمكنك التّحرّك؟

234
00:15:52,300 --> 00:15:53,390
ما الخطب؟

235
00:15:54,120 --> 00:15:54,950
!مهلاً

236
00:15:57,320 --> 00:15:59,470
.ليس لدينا وقت لنضيّعه

237
00:16:00,370 --> 00:16:01,490
هل ذلك يخصّك؟

238
00:16:07,690 --> 00:16:09,350
!هرب سجين

239
00:16:09,970 --> 00:16:13,030
.سأجذب انتباههم لي
.اهرب عندما تسمح لك الفرصة

240
00:16:13,740 --> 00:16:15,990
لماذا تساعدني؟

241
00:16:15,990 --> 00:16:17,980
.زنزانتك كانت إلى جانب زنزانتي

242
00:16:18,970 --> 00:16:21,840
تقولون "أحِبّ جارك"، صحيح؟

243
00:16:34,110 --> 00:16:35,850
.يا له من شعور مفرط بالالتزام

244
00:16:38,620 --> 00:16:40,620
قلتَ ليفي؟

245
00:16:41,780 --> 00:16:44,320
ألا تقرأ الصّحف؟

246
00:16:45,590 --> 00:16:47,690
.كلاّ. مستحيل

247
00:17:08,530 --> 00:17:11,710
هل تنوي التّخلّي عن الحياة
الّتي مُنحتَ إيّاها ثانية؟

248
00:17:13,270 --> 00:17:16,050
.ما عاد لديّ سبب لأعيش

249
00:17:16,050 --> 00:17:19,260
.أرى أنّك حقّقت انتقامك

250
00:17:20,310 --> 00:17:22,760
.ما عاد ذلك ممكنًا الآن

251
00:17:23,520 --> 00:17:30,270
"غرق سفينة ضخمة إثر عاصفة دون تخليف أيّ ناجين"

252
00:17:24,050 --> 00:17:26,350
الرّجل الّذي كنت أودّ الانتقام منه

253
00:17:26,350 --> 00:17:29,570
.اختفى في البحر مع حطام سفينته

254
00:17:31,170 --> 00:17:34,130
.ليس من المؤكّد أنّه مات

255
00:17:34,130 --> 00:17:35,580
!لا تحاول مواساتي

256
00:17:35,580 --> 00:17:42,840
.لكنّك نجوت، رغم أنّك كنت في حالة خطيرة

257
00:17:42,840 --> 00:17:43,910
...ذلك

258
00:17:44,250 --> 00:17:49,110
كيف تجرؤ على تنفيذ السّيبّوكو
قبل أن تردّ دينك لي أو للقبطان؟

259
00:17:49,110 --> 00:17:51,120
ألا تعتقد أنّ لديك التزامًا تجاهنا؟

260
00:17:52,030 --> 00:17:53,390
.وجدتك

261
00:17:54,900 --> 00:17:56,540
أهو من معارفك؟

262
00:17:56,540 --> 00:17:58,920
عدتَ لتحصل على مالٍ للشّراب؟

263
00:17:59,770 --> 00:18:07,020
قرّرتُ ببساطة أنّي أرغب في استخدام
.مهارات الشّينوبي البارزة خاصّتي

264
00:18:07,990 --> 00:18:09,750
هذه أمنيتك إذًا؟

265
00:18:10,980 --> 00:18:12,390
.سأجاريك

266
00:18:42,060 --> 00:18:43,840
!طفل وقح

267
00:18:49,520 --> 00:18:52,200
.لا أعرف من أنت، ولكن لا تتدخّل

268
00:19:13,800 --> 00:19:14,910
ماذا؟

269
00:19:21,910 --> 00:19:23,890
.لن تنطلي عليّ نفس الحيلة مرّتين

270
00:19:28,080 --> 00:19:30,560
.أنت الفائز. اقتلني

271
00:19:34,930 --> 00:19:37,040
.أنا لا أزهق الأرواح بلا سبب

272
00:19:41,000 --> 00:19:44,360
هل أنت بالفعل في وضع
يسمح لك بقول ذلك؟

273
00:20:05,290 --> 00:20:07,740
.أرى أنّك عدت ومعك رفقة

274
00:20:23,380 --> 00:20:25,860
،بعد بعضة سنوات مذ أصبتُ بحّارًا

275
00:20:26,320 --> 00:20:30,180
عرفتُ أنّ هيراماتسو بوهي
.لم يمت كما كنت أعتقد

276
00:20:30,180 --> 00:20:32,210
.لقد زيّف موته بنفسه

277
00:20:32,210 --> 00:20:33,500
.هكذا إذًا

278
00:20:33,500 --> 00:20:35,890
.يجب أن تنتهي حياته على يديّ

279
00:20:36,850 --> 00:20:38,360
.سأساعدك في ذلك

280
00:20:41,170 --> 00:20:43,680
ميشيماكن
مطعم
غربيّ

281
00:20:44,920 --> 00:20:47,670
أين تختبئ يا شوراغامي كيوشيرو؟

282
00:20:47,670 --> 00:20:49,750
.على رسلك. اهدأ

283
00:20:49,750 --> 00:20:52,480
.تناول بعضًا من هذا وبرّد أعصابك

284
00:20:58,120 --> 00:20:58,980
.إنّه بارد

285
00:20:58,980 --> 00:21:00,160
ما هذا الشّيء؟

286
00:21:00,160 --> 00:21:03,360
.إنّها مثلّجات. وجبة خفيفة غربيّة

287
00:21:06,270 --> 00:21:08,480
،كنتُ أتساءل لبعض الوقت

288
00:21:08,480 --> 00:21:11,780
ولكن لماذا تعرّض أوساناي هذا
للهجوم من شوراغامي؟

289
00:21:11,970 --> 00:21:14,700
.لا بدّ أنّه أدرك أنّ هنالك من يلاحقه

290
00:21:14,700 --> 00:21:17,460
قد يكون ذلك صحيحًا
.إن كان شوراغامي هو المجرم

291
00:21:17,460 --> 00:21:20,090
لكن أليس هنالك مشتبهًا به آخر؟

292
00:21:20,090 --> 00:21:23,870
هل كان ليقضي عليه فقط لأنّه كان
يتبعه إن لم يكن لديه ضمير يؤنّبه؟

293
00:21:23,870 --> 00:21:25,470
.نقطة وجيهة

294
00:21:25,470 --> 00:21:27,340
ما الّذي حدث هناك يا ترى؟

295
00:21:27,810 --> 00:21:30,130
...لا يفترض بي الكشف عن هذا

296
00:21:32,570 --> 00:21:33,350
...مهلاً، هذه

297
00:21:33,350 --> 00:21:35,100
قسم
شرطة
العاصمة

298
00:21:33,350 --> 00:21:35,230
وثائق التّحقيق 529

299
00:21:33,640 --> 00:21:35,110
!وثائق التّحقيق

300
00:21:35,110 --> 00:21:36,990
.اطّلعا عليها

301
00:21:38,190 --> 00:21:46,610
تقرير
ما بعد
الوفاة

302
00:21:38,530 --> 00:21:43,230
.طُعن الشّرطيّ أوساناي في البطن والصّدر

303
00:21:43,230 --> 00:21:46,270
طعنة الصّدر هي الّتي كانت
...قاتلة، لكن

304
00:21:46,620 --> 00:21:47,800
لكن ماذا؟

305
00:21:47,800 --> 00:21:54,050
قال الطّبيب أنّ طعنة البطن وطعنة
.الصّدر كانا بسبب نصلين مختلفين

306
00:21:54,050 --> 00:21:57,800
.يستعمل شوراغامي سيفين
.لذلك لا شيء من هذا يفاجئني

307
00:21:57,800 --> 00:22:02,310
باستثناء أنّ نصلاً ذو حدّين هو ما تسبّب
.بطعنة الصّدر. نصل ذو شكل غريب

308
00:22:02,310 --> 00:22:05,020
.نشتبه أنّ النّصل كان أجنبيًّا

309
00:22:05,020 --> 00:22:08,420
.يستعمل الياكوزا سيوف الدّوسو القصيرة

310
00:22:08,420 --> 00:22:11,500
هل كان شوراغامي ليستعمل أسلحة أجنبيّة؟

311
00:22:11,500 --> 00:22:13,020
.سؤال وجيه

312
00:22:15,050 --> 00:22:17,060
.تفضّل المزيد رجاءً

313
00:22:16,250 --> 00:22:18,400
.مع أنّه لا يجدر بي ذلك

314
00:22:18,400 --> 00:22:22,550
.لا يفترض بالشّرطة الشّرب أيّتها المراسلة

315
00:22:24,920 --> 00:22:28,340
هل من تطوّرات في قضيّة نزاع عشيرة موريا؟

316
00:22:28,340 --> 00:22:33,140
تتكفّل شرطة العاصمة بالقضيّة، إنّهم
.يبحثون عن رجل يُدعى شوراغامي كيوشيرو

317
00:22:33,140 --> 00:22:34,650
.لكن لا أحد يعرف مكانه

318
00:22:34,650 --> 00:22:36,450
ليست لديكم أيّ أدلّة بعد؟

319
00:22:36,450 --> 00:22:39,170
.نُوبَّخ كثيرًا من طرف رئيس المفتّشين

320
00:22:39,170 --> 00:22:42,720
كما أنّ السّيّد أوكوبو يعير
.اهتمامًا خاصًّا لهذه القضيّة أيضًا

321
00:22:42,720 --> 00:22:44,340
.السّيّد أوكوبو

322
00:22:46,980 --> 00:22:50,210
إلى أين ذهب ذلك الوغد كيوشيرو؟

323
00:22:50,210 --> 00:22:53,720
الأهمّ من ذلك الآن، يودّ سيّدنا معرفة

324
00:22:53,720 --> 00:22:56,930
.إن كانت الخطّة الكبرى تسير كما يجب

325
00:22:56,930 --> 00:22:59,220
.لا يوجد ما يدعو للقلق من تلك النّاحية

326
00:23:05,260 --> 00:23:08,990
.سنكون قادرين على اختبار نموذج عمّا قريب

327
00:23:08,990 --> 00:23:12,580
.سيكون السّيّد سعيدًا لسماع هذا

328
00:23:14,080 --> 00:23:18,050
.سمعتُ أنّ إيكِغامي سويتشيرو ما زال حيًّا

329
00:23:18,500 --> 00:23:20,960
.لسوء الحظّ، يبدو ذلك صحيحًا

330
00:23:21,200 --> 00:23:24,170
،إن عرفت الدّول الأخرى بالاتّفاق السّرّيّ

331
00:23:24,170 --> 00:23:26,560
.فسيضرّ ذلك بهيبة بلادنا

332
00:23:26,560 --> 00:23:28,350
.لا داعي للقلق حيال ذلك

333
00:23:28,350 --> 00:23:29,950
.سأتولّى الأمر

334
00:23:29,950 --> 00:23:34,180
قلتَ ذلك قبل ستّ سنوات أيضًا. لهذا
—السّبب تعاونت معك لتزييف موتك

335
00:23:34,180 --> 00:23:35,680
،وفي المقابل

336
00:23:35,680 --> 00:23:39,520
أودعتُ نصف الأرباح من الشّحنة

337
00:23:39,520 --> 00:23:44,600
في حسابك الخاصّ السّرّيّ
في المصرف الشّرقيّ، أليس كذلك؟

338
00:23:46,060 --> 00:23:50,280
،لا داعي للقلق. ما دمت تعمل معي
.فسأضمن أن تستفيد

339
00:23:50,280 --> 00:23:58,400
سواء كان شبحًا من ستّ سنوات
،مضت أو حاكم هذه البلاد

340
00:23:58,400 --> 00:24:00,370
.فسأزيحهم عن الصّورة ببساطة

341
00:24:01,250 --> 00:24:03,460
قسم
الدّاخليّة

342
00:24:01,780 --> 00:24:03,450
الذّهب مفقود؟

343
00:24:03,450 --> 00:24:09,960
يبدو أنّهم حاولوا شراء أسلحة
.مقابل التّنازل عن منطقة إيزو

344
00:24:10,260 --> 00:24:15,190
،وهذا المدعوّ هيراماتسو بوهي
العقل المدبّر لهذه الخطّة، لا يزال حيًّا؟

345
00:24:15,190 --> 00:24:19,610
.يبدو أنّنا صادفنا رجلاً خطيرًا بدلا من الذّهب

346
00:24:21,790 --> 00:24:22,720
ماذا هنالك؟

347
00:24:22,720 --> 00:24:25,080
.لا شيء. أظنّني كنت أتخيّل

348
00:24:35,930 --> 00:24:38,200
.عثرتِ على رجل ممتاز

349
00:24:39,600 --> 00:24:43,110
ماذا عنك يا أختي هينازورو؟
هل عثرت على خطيبك؟

350
00:24:44,930 --> 00:24:49,010
مهلاً لحظة! هل هي خطيبة شيزوما-سان؟

351
00:24:49,010 --> 00:24:49,950
سوميي-سان؟

352
00:24:49,950 --> 00:24:52,560
هلاّ سمحت لنا بالحديث على
انفراد يا كامِجيرو-سان؟

353
00:24:52,560 --> 00:24:54,430
لماذا لا تريدين مقابلته؟

354
00:24:54,430 --> 00:24:58,270
كان شيزوما-سان يبحث عنك
!طوال هذا الوقت

355
00:25:00,600 --> 00:25:02,200
!هذا مؤلم

356
00:25:01,310 --> 00:25:03,360
!غادر فحسب

357
00:25:06,090 --> 00:25:09,560
.أنا آسفة. إنّه غير حسّاس نوعًا ما

358
00:25:10,980 --> 00:25:13,560
ولكن لماذا لا تريدين مقابلته؟

359
00:25:16,650 --> 00:25:19,070
.إنّ الدّماء تغطّي يداي

360
00:25:21,560 --> 00:25:23,910
.لا أريد أن ألطّخ شيزوما-سان بهما

361
00:25:24,640 --> 00:25:25,890
...لكن

362
00:25:28,550 --> 00:25:30,960
.يعيش ذلك الرّجل في الحاضر

363
00:25:31,510 --> 00:25:35,930
.بينما ما زلتُ أنا متعلّقة بالماضي
.إنّنا نسير على طريقين مختلفين

364
00:25:36,860 --> 00:25:38,090
...أختي

365
00:25:40,110 --> 00:25:41,630
.سأقدّم هذا لك

366
00:25:44,800 --> 00:25:46,090
...هذا

367
00:25:46,090 --> 00:25:48,060
.خذيه دون قول أيّ شيء

368
00:25:48,060 --> 00:25:50,570
.لا يمكنني القبول بهذا

369
00:25:55,470 --> 00:26:02,090
،إن استطعتِ العثور على السّعادة
.أشعر أنّه قد كانت لحياتي معنى

370
00:26:04,920 --> 00:26:07,060
.ليس لديّ الكثير من الوقت

371
00:26:07,500 --> 00:26:12,680
.أحتاج لإنهاء عمل واحد أخير

372
00:26:17,740 --> 00:26:19,230
.ماكولي

373
00:26:19,230 --> 00:26:20,470
.لم أرك منذ مدّة

374
00:26:20,470 --> 00:26:22,400
.هناك أمر أريدك أن تبحث عنه

375
00:26:27,290 --> 00:26:29,880
.إنسان الغاب هو الجاني

376
00:26:31,410 --> 00:26:33,280
.أنت أسوأ شخص أعرفه

377
00:26:33,280 --> 00:26:35,960
.لا يجب عليك جعل الزّبائن ينتظرون

378
00:26:35,960 --> 00:26:38,260
حسنًا، ماذا تريدين؟

379
00:26:38,260 --> 00:26:40,480
هل تعرف إل دورادو؟

380
00:26:40,480 --> 00:26:42,870
.إنّه اسم مكان أسطوريّ

381
00:26:44,190 --> 00:26:45,650
.أرض الذّهب

382
00:26:46,380 --> 00:26:49,460
لم يكن عليك أن تسألي إن كنت
تعرفين سلفًا. أهذا كلّ شيء؟

383
00:26:51,170 --> 00:26:54,230
أريدك أن تبحث عن كتاب
.يُدعى تنريو-مارو

384
00:26:56,810 --> 00:26:58,990
!شيزوما-سان! لديّ أخبار مهمّة

385
00:26:58,990 --> 00:27:00,750
كامِجيرو. ما الأمر؟

386
00:27:01,090 --> 00:27:02,990
!وجدتُ سوميي-سان

387
00:27:04,410 --> 00:27:07,070
سوميي! أين سوميي؟

388
00:27:07,070 --> 00:27:09,030
.غادرت سلفًا

389
00:27:09,030 --> 00:27:09,850
إلى أين؟

390
00:27:11,120 --> 00:27:13,510
!أخبريني رجاءً

391
00:27:14,730 --> 00:27:16,270
.ضريح شوكونشاي