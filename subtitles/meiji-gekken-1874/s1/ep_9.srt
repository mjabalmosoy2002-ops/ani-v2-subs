1
00:00:20,130 --> 00:00:21,030
!مهلاً

2
00:01:00,170 --> 00:01:01,360
رمل؟

3
00:01:16,470 --> 00:01:19,560
.سننطلق من هنا

4
00:01:20,170 --> 00:01:23,360
.كونوا مستعدّين لبدء الخطّة في الحال

5
00:01:23,360 --> 00:01:25,630
.سنحتاج لرجال إضافيّين

6
00:01:25,630 --> 00:01:28,380
.استعملوا رجال موريا

7
00:01:54,200 --> 00:01:55,640
ما الّذي تفعلينه هناك؟

8
00:01:58,540 --> 00:02:00,900
ما الّذي تحاولين تحقيقه؟

9
00:02:01,640 --> 00:02:06,640
الحلقة التّاسعة سماء اللّيل

10
00:02:11,710 --> 00:02:13,270
.هذا خطير

11
00:02:13,870 --> 00:02:15,860
.قد يموت بدون مساعدة

12
00:02:17,210 --> 00:02:18,370
.داريو

13
00:02:42,500 --> 00:02:43,370
...ما الّذي

14
00:02:45,280 --> 00:02:46,830
شيزوما-سان؟

15
00:02:48,410 --> 00:02:51,390
.لا أصدّق أنّ الشّرطيّ ماكينو هو القاتل

16
00:02:51,650 --> 00:02:54,780
لا أصدّق هذا. لأيّ غرض؟

17
00:02:54,780 --> 00:02:57,280
.لم أعرف الكثير منه بعد

18
00:02:57,810 --> 00:03:00,690
.اسمح لي بحضور الاستجواب

19
00:03:01,060 --> 00:03:02,050
.رجاءً

20
00:03:02,050 --> 00:03:04,020
.مستحيل أن نوافق على ذلك

21
00:03:04,550 --> 00:03:05,610
.لا بأس

22
00:03:05,610 --> 00:03:06,790
!يا رئيس المفتّشين تانبا

23
00:03:07,220 --> 00:03:08,620
.شكرًا لك

24
00:03:12,280 --> 00:03:14,210
لماذا قتلت أوساناي-سان؟

25
00:03:16,050 --> 00:03:17,670
.لإسكاته

26
00:03:18,320 --> 00:03:22,320
.طلبتُ منه المساعدة لقتل شوراغامي، لكنّه فشل

27
00:03:22,320 --> 00:03:24,910
.لذلك تخلّصت منه قبل انتشار الخبر

28
00:03:24,910 --> 00:03:26,620
!يا لك من وغد

29
00:03:26,620 --> 00:03:29,970
لماذا تستهدف شوراغامي؟

30
00:03:31,200 --> 00:03:32,590
.كان أمرًا

31
00:03:33,120 --> 00:03:34,390
.من السّيّد

32
00:03:34,660 --> 00:03:36,350
أقلتَ السّيّد؟

33
00:03:36,350 --> 00:03:40,620
إذًا فإنّ رجال هيراماتسو تسلّلوا
حتّى لصفوف الشّرطة؟

34
00:03:40,620 --> 00:03:42,310
.الرّئيس المشرف كاواجي

35
00:03:42,810 --> 00:03:47,050
أوريغاسا، كنتَ تخفي أمرًا مهمًّا، صحيح؟

36
00:03:50,600 --> 00:03:55,050
كانوماتا سوميي هي من أطلقت
.النّار على السّيّد أوكوبو

37
00:03:55,530 --> 00:03:58,490
.إنّها الخطيبة الّتي كنتَ تبحث عنها

38
00:03:59,230 --> 00:04:00,030
.نعم

39
00:04:00,650 --> 00:04:05,600
كلّ ذلك بأوامر من هيراماتسو بوهي
.الّذي يخطّط لإسقاط الحكومة

40
00:04:06,220 --> 00:04:08,040
هيراماتسو بوهي؟

41
00:04:09,030 --> 00:04:10,520
هذا هو اسم السّيّد؟

42
00:04:10,520 --> 00:04:13,580
.اسمه الحقيقيّ هو جون هنري شنيل

43
00:04:13,580 --> 00:04:17,470
.إنّه أجنبيّ عمِل كمستشار عسكريّ في أيزو

44
00:04:17,470 --> 00:04:18,500
هل تعرفه؟

45
00:04:18,980 --> 00:04:20,710
.مرّ اسمه على مسامعي

46
00:04:21,330 --> 00:04:26,460
.يبدو أنّ كلّ هذا بدأ في حرب بوشين

47
00:04:27,040 --> 00:04:30,320
.عد لصفوف الشّرطة يا أوريغاسا شيزوما

48
00:04:30,840 --> 00:04:34,050
.ضع خاتمة لمصيرك

49
00:04:52,040 --> 00:04:55,630
.قيل لي أنّه سيتمّ هدم القلعة في أيزو

50
00:04:55,630 --> 00:04:58,700
.هكذا هو الزّمن. ما باليد حيلة

51
00:04:59,450 --> 00:05:05,030
.ما زلت أرى جمال أيزو عندما أغلق عينيّ

52
00:05:05,950 --> 00:05:11,780
كان النّاس بهيجين ومبتسمين
.تحت حكمك رغم الفقر

53
00:05:11,780 --> 00:05:14,150
.كانوا منضبطين وفخورين

54
00:05:14,150 --> 00:05:17,130
شعرتُ أنّي عثرتُ على طريقة
،حياة مسالمة مثاليّة

55
00:05:17,130 --> 00:05:21,850
متحرّرة من عبادة المال
.الّتي أوصلت الغرب إلى الجنون

56
00:05:22,760 --> 00:05:25,090
.طيف من غابر الأزمان

57
00:05:25,530 --> 00:05:28,400
.إنّ محارب أيزو ميت الآن

58
00:05:28,400 --> 00:05:30,880
!لكنّك لا تزال حيًّا! وأنا معك

59
00:05:30,880 --> 00:05:34,400
،باسم العصرنة

60
00:05:34,400 --> 00:05:39,280
تخلّى هذا البلد عن تقاليده
.وبدأ يقلّد الغرب بشكل أعمى

61
00:05:39,990 --> 00:05:45,640
يا سيّدي، أنا أطلب منك الوقوف
.واستعادة عالم السّاموراي الفخور

62
00:05:45,640 --> 00:05:52,640
إنّها الطّريقة الوحيدة الّتي نستطيع
.بها تحقيق العدالة لموتى أيزو

63
00:06:00,270 --> 00:06:01,920
.لقد عدت

64
00:06:02,170 --> 00:06:06,190
سمعتُ أنّكم تعرّضتم لهجوم
.من شوراغامي كيوشيرو

65
00:06:06,190 --> 00:06:09,550
.تمّ نقل الموادّ إلى نقطة المغادرة الثّانية

66
00:06:09,550 --> 00:06:11,730
.لم تتضرّر خططنا بأيّ شيء

67
00:06:11,730 --> 00:06:14,820
.إنّنا نوشك على بدء التّحضيرات الأخيرة

68
00:06:15,970 --> 00:06:21,960
يبدو أنّ أوكوبو قد وقع ضحيّة
.معلوماتنا الزّائفة واستدعى سايغو

69
00:06:21,960 --> 00:06:26,490
ليته فقط عرف أنّ ذلك سيكون الفتيل
.الّذي سيشعل نار تمرّد السّاموراي السّابقين

70
00:06:27,570 --> 00:06:29,860
.بدأ الأمر أخيرًا

71
00:06:38,180 --> 00:06:39,760
!بسرعة

72
00:06:54,650 --> 00:06:56,390
ما الّذي تفكّرين فيه؟

73
00:06:58,160 --> 00:07:03,570
هل كنتُ أقوم بالصّواب بالفعل؟

74
00:07:04,210 --> 00:07:09,420
الانتقام من أولئك الّذين دمّروا
موطنك وقتلوا خطيبك؟

75
00:07:11,720 --> 00:07:12,910
.إنّه حيّ

76
00:07:14,970 --> 00:07:17,330
.شيزوما-سان حيّ

77
00:07:18,070 --> 00:07:21,090
.كنتُ أوشك على قتله بيديّ هاتين

78
00:07:21,800 --> 00:07:22,710
.لا يُعقل

79
00:07:23,440 --> 00:07:24,580
كان ذاك هو؟

80
00:07:35,220 --> 00:07:37,590
.هذا كلّ ما بقي لدينا

81
00:07:37,960 --> 00:07:39,860
.هذا لا يُطمئن أبدًا

82
00:07:41,780 --> 00:07:44,950
.لن يستطيع داريو القتال بعد الآن

83
00:07:44,950 --> 00:07:47,610
.قام سلفًا بأكثر ممّا هو كافٍ لأجلنا

84
00:07:48,780 --> 00:07:51,760
.لنُعد داريو إلى إل دورادو

85
00:07:54,730 --> 00:08:00,620
نحن بحاجة لمساعدتك لإخماد السّخط
.المتزايد بين السّاموراي السّابقين

86
00:08:01,070 --> 00:08:04,570
يبدو أنّه لا يمكنكم إدارة حكومة
ناجعة بدوني، أليس كذلك؟

87
00:08:04,570 --> 00:08:12,050
سيلتزم السّاموراي بالنّظام في الحال
.بمجرّد كلمة واحدة من سايغو العظيم

88
00:08:12,980 --> 00:08:16,360
ولكن أوّلاً، سيكون عليّ حلق
.هذه اللّحية المزعجة

89
00:08:25,710 --> 00:08:29,200
أين هما كيوشيرو-ساما والجدّ غنجو؟

90
00:08:29,770 --> 00:08:32,460
.ذهب العجوز للبحث عن الدّواء

91
00:08:32,460 --> 00:08:37,340
وذكر شوراغامي شيئًا ما عن تأمين
.سفينة. سيعودان قريبًا

92
00:08:37,800 --> 00:08:39,780
سفينة؟

93
00:08:51,580 --> 00:08:54,670
.يبدو أنّك تمكّنت من التّسلّل بينهم

94
00:08:54,670 --> 00:08:57,290
.إن كنت تبحثين عن الذّهب، فلا فائدة

95
00:08:57,290 --> 00:08:59,250
.إنّه غير موجود

96
00:08:59,250 --> 00:09:02,790
فعلاً؟ لماذا إذًا ما زلت مع شوراغامي؟

97
00:09:02,790 --> 00:09:04,510
.لديّ شأن آخر معه

98
00:09:04,510 --> 00:09:05,500
.صدّقتك

99
00:09:06,030 --> 00:09:07,140
.لا يهمّ

100
00:09:09,060 --> 00:09:10,000
ما هذا؟

101
00:09:10,410 --> 00:09:14,510
حصلتُ على معلومات عن
.خطّة قد تُشعل فتيل ثورة

102
00:09:14,510 --> 00:09:15,660
.يمكنك أخذها

103
00:09:17,250 --> 00:09:18,690
لماذا تعطينني هذه؟

104
00:09:18,690 --> 00:09:20,700
أنت مع الشّرطة، صحيح؟

105
00:09:20,700 --> 00:09:21,870
...إضافة لذلك

106
00:09:22,540 --> 00:09:24,490
.أنا أسدّد ديوني دائمًا

107
00:09:25,410 --> 00:09:28,140
أهذا حقيقيّ؟

108
00:09:28,140 --> 00:09:30,770
.يجدر بك الذّهاب لإخبار الرّئيس المشرف بسرعة

109
00:09:39,100 --> 00:09:40,350
.لقد سمعنا

110
00:09:40,350 --> 00:09:41,900
.أنا متفاجئ من قدرته على التّحرّك

111
00:09:41,900 --> 00:09:45,340
.نحن اثنان ضدّ واحد، وهو يفتقر لذراع
.سنكون بخير إن واجهناه معًا

112
00:09:45,340 --> 00:09:47,550
.لكنّ واحدًا منّا سيصاب بسهم في رأسه

113
00:09:47,550 --> 00:09:49,650
لماذا لا ندع ذلك للحظّ إذًا؟

114
00:09:51,230 --> 00:09:52,240
.سهم برسالة

115
00:09:52,240 --> 00:09:54,010
.علينا أن نسرع

116
00:09:54,010 --> 00:09:55,740
.سأجذب انتباهه

117
00:09:55,740 --> 00:09:57,320
.وتولّي أنت أمره

118
00:09:59,940 --> 00:10:00,650
!الآن

119
00:10:05,910 --> 00:10:06,800
.تبًّا

120
00:10:10,050 --> 00:10:10,990
.بطيء

121
00:10:13,600 --> 00:10:16,050
.يا له من وضع غريب

122
00:10:16,050 --> 00:10:18,110
!إنّه جاسوس للشّرطة

123
00:10:18,110 --> 00:10:19,210
.يا إلهي

124
00:10:19,940 --> 00:10:21,060
فعلاً؟

125
00:10:21,390 --> 00:10:23,810
.ظننتُ أنّك ذئب

126
00:10:24,180 --> 00:10:26,080
.لكن يبدو أنّك مجرّد كلب

127
00:10:35,310 --> 00:10:36,520
.الوداع

128
00:10:48,600 --> 00:10:50,430
.ما زال بإمكاني القتال

129
00:10:51,170 --> 00:10:53,040
.سنظلّ معًا حتّى النّهاية

130
00:10:53,730 --> 00:10:54,870
.لا بأس

131
00:10:55,350 --> 00:10:56,580
.افعل ما يحلو لك

132
00:11:01,590 --> 00:11:02,930
وما هذا؟

133
00:11:13,100 --> 00:11:16,020
.ظننتُ أنّك هربت

134
00:11:16,020 --> 00:11:18,550
.نجوتَ مِن سهم في الصّدر

135
00:11:18,550 --> 00:11:20,040
.إنّك عنيد بالفعل

136
00:11:20,590 --> 00:11:25,490
.لقد سحب السّهم بفمه
.ما كان ليصل إلى قلبي

137
00:11:25,490 --> 00:11:28,250
قسم شرطة
العاصمة

138
00:11:26,370 --> 00:11:28,250
.أوريغاسا شيزوما

139
00:11:28,920 --> 00:11:33,540
،لقاءَ حمايتك الشُّجاعة والمتفانية لوزير الدّاخليّة

140
00:11:33,540 --> 00:11:37,280
،ودورك في القبض على قاتل الشّرطيّ أوساناي

141
00:11:37,660 --> 00:11:43,590
أوافق بموجب هذا على عودتك لصفوف
.الشّرطة وترقيتك إلى ضابط من الدّرجة الأولى

142
00:11:49,720 --> 00:11:53,830
كما سيُمنح للشّرطيّ أوريغاسا
.إذن خاصّ بحمل السّيف

143
00:11:53,830 --> 00:11:54,970
سيف؟

144
00:11:54,970 --> 00:11:59,280
إنّنا ننوي منح كلّ ضبّاك الدّرجة
.الأولى الإذن بحمل السّيف

145
00:11:59,280 --> 00:12:03,020
.ستكون الأوّل من بينهم

146
00:12:03,400 --> 00:12:10,330
.ستعمل بجدّ واجتهاد وتفان كمدافع عن الدّولة

147
00:12:10,330 --> 00:12:11,170
!حاضر

148
00:12:13,650 --> 00:12:15,200
.أرى أنّ الحياة تبتسم لك

149
00:12:17,450 --> 00:12:20,210
.ما عدت الآن قادرًا على الشّرب ثانية

150
00:12:21,380 --> 00:12:24,540
هل ستذهب لاعتقال خطيبتك؟

151
00:12:24,970 --> 00:12:29,390
،سأقوم بذلك بنفسي
.قبل أن يعتقلها شخص آخر

152
00:12:30,270 --> 00:12:31,480
هل ستقتلها؟

153
00:12:43,290 --> 00:12:45,940
.أعتقد أنّي سأعود إلى بلدتي

154
00:12:47,110 --> 00:12:50,850
هدفي الوحيد من تواجدي هنا
.هو المشاركة في الغيكّينكاي

155
00:12:50,850 --> 00:12:53,630
.بقيتُ هنا أكثر من اللاّزم

156
00:12:54,110 --> 00:12:57,880
.هذه هديّة لتلميذي غير الجدير

157
00:12:59,100 --> 00:13:01,500
.استعمله لقطع تردّدك

158
00:13:01,980 --> 00:13:04,620
.أو لحماية من هم عزيزون عليك

159
00:13:04,620 --> 00:13:06,150
.أحسن استعماله في كلّ الأحوال

160
00:13:22,660 --> 00:13:24,850
هل وجدت ما طلبته منك؟

161
00:13:24,850 --> 00:13:26,800
تقصدين التّنريومارو؟

162
00:13:26,800 --> 00:13:33,030
يبدو أنّها عبّارة تنتقل بين طوكيو
.وإيزو وعلى متنها بضائع محلّيّة

163
00:13:33,030 --> 00:13:34,100
إيزو؟

164
00:13:34,930 --> 00:13:36,580
.دوّنتُ التّفاصيل هنا

165
00:13:38,300 --> 00:13:41,460
هل يمكنك إرسال هذه للمفوضيّة البريطانيّة؟

166
00:13:41,740 --> 00:13:43,950
هل يبدو لك هذا كمكتب بريد؟

167
00:13:46,900 --> 00:13:48,330
.لو سمحت

168
00:13:50,110 --> 00:13:52,560
!أهذا صحيح أيّها الشّرطيّ فوجيتا؟

169
00:13:52,560 --> 00:13:55,850
!سيهاجم هيراماتسو بوهي الأرض المقدّسة؟

170
00:13:55,850 --> 00:13:58,890
.أسرع... وأخبر الرّئيس المفتّش

171
00:13:59,240 --> 00:14:03,020
.احذر... احذر من السّماء

172
00:14:21,620 --> 00:14:24,260
لتقّينا معلومات عن خطّة

173
00:14:24,260 --> 00:14:27,580
.دبّر لها هيراماتسو بوهي ورجاله لإسقاط الحكومة

174
00:14:27,880 --> 00:14:31,430
،سنبدأ بحثًا شاملاً في الجبال حيث يقيم

175
00:14:31,430 --> 00:14:35,850
،إضافة إلى مساكن عشيرة موريا
.الّذين كانوا يتعاونون معه

176
00:14:35,850 --> 00:14:41,060
أطلب منكم القيام بواجباتكم
.بحماسة بصفتكم عملاء للعدالة

177
00:14:41,060 --> 00:14:42,130
!حاضر

178
00:14:57,700 --> 00:14:59,770
أين موريا ريوزو؟

179
00:14:59,770 --> 00:15:01,490
.إنّه ليس هنا

180
00:15:02,540 --> 00:15:07,960
حان الوقت أخيرًا لتقف عشيرة
.موريا في قلب هذه الأمّة

181
00:15:07,960 --> 00:15:10,150
!استعدّوا لذلك

182
00:15:10,150 --> 00:15:11,370
!أجل

183
00:15:12,470 --> 00:15:14,170
ألا ترى أنّ الوقت باكر على الاحتفال؟

184
00:15:14,460 --> 00:15:16,200
.لدينا مهمّة بالغة الأهمّيّة

185
00:15:16,200 --> 00:15:20,070
.لا داعي لهذه القسوة. إنّه احتفال مسبق

186
00:15:20,070 --> 00:15:22,890
.السّيّد هنا. أحسن التّصرّف رجاءً

187
00:15:24,490 --> 00:15:27,520
أنت هنا شخصيًّا يا سيّدي؟

188
00:15:27,520 --> 00:15:29,570
!أحنوا رؤوسكم جميعًا

189
00:15:32,610 --> 00:15:35,020
!بسرعة! الشّرطة هنا

190
00:15:38,740 --> 00:15:42,140
!أروهم معدنكم الحقيقيّ

191
00:15:45,540 --> 00:15:46,920
!هجوم

192
00:15:52,390 --> 00:15:53,990
!اضغطوا عليهم أكثر

193
00:15:54,470 --> 00:15:56,090
...ذلك الرّجل

194
00:15:58,970 --> 00:16:00,470
!الموت لك

195
00:16:01,720 --> 00:16:04,710
!مت! مت! مت

196
00:16:06,710 --> 00:16:09,440
.يبدو أنّ هنالك من يكرهني بشدّة

197
00:16:09,440 --> 00:16:10,870
من تكون من الأساس؟

198
00:16:10,870 --> 00:16:12,810
.أنت عقبة في طريقنا

199
00:16:12,810 --> 00:16:13,920
ماذا؟

200
00:16:13,920 --> 00:16:15,320
!أيّها الشّرطيّ أوريغاسا

201
00:16:16,120 --> 00:16:17,200
!انحنوا

202
00:16:20,270 --> 00:16:21,670
ألا ترى أنّ ذلك كان وشيكًا؟

203
00:16:21,670 --> 00:16:22,920
.تأخّرت

204
00:16:22,920 --> 00:16:24,840
.لا شكر على واجب

205
00:16:34,390 --> 00:16:37,920
.اجعلني أبدو أنيقًا ووسيمًا

206
00:17:02,260 --> 00:17:03,310
!توقّف

207
00:17:04,500 --> 00:17:06,920
!ألق سلاحك أرضًا واستسلم

208
00:17:16,150 --> 00:17:18,050
!كيوشيرو

209
00:17:18,850 --> 00:17:21,470
.لا أرى زعيمكم هنا

210
00:17:21,470 --> 00:17:24,080
هل ترك رجاله ليقوموا بكلّ أعماله القذرة؟

211
00:17:24,080 --> 00:17:25,960
!اخرس أيّها الخائن

212
00:17:25,960 --> 00:17:31,030
إنّ زعيمنا يجلس مستعدًّا رفقة
!السّيّد الملثّم في قاعدتنا الرّئيسيّة

213
00:17:31,030 --> 00:17:32,660
إنّه هنا إذًا؟

214
00:17:32,660 --> 00:17:34,140
!مت

215
00:17:38,070 --> 00:17:39,690
!شوراغامي كيوشيرو

216
00:17:39,690 --> 00:17:41,230
!أنت رهن الاعتقال

217
00:17:41,230 --> 00:17:42,750
أواثقون من ذلك؟

218
00:18:10,210 --> 00:18:12,560
.دعا هذا لي. سألحق بكما لاحقًا

219
00:18:12,560 --> 00:18:13,330
.حسنًا

220
00:18:20,470 --> 00:18:21,700
!مهلاً

221
00:18:22,310 --> 00:18:23,570
.لن تبارح مكانك هذا

222
00:18:39,160 --> 00:18:41,710
ما ذلك الزّيّ؟

223
00:18:41,710 --> 00:18:44,730
أين اختفى فخر أيزو؟

224
00:18:44,730 --> 00:18:48,390
.عار عليك يا شيزوما

225
00:18:48,390 --> 00:18:49,930
غينّوسكي؟

226
00:19:17,040 --> 00:19:18,140
.مستحيل

227
00:19:19,860 --> 00:19:24,970
.كان يفترض بك أن ترى الجحيم
كيف لم تفقد عقلك؟

228
00:19:24,970 --> 00:19:27,960
.رأيتُ ذلك في كوابيسي مرّات لا تُحصى

229
00:19:29,890 --> 00:19:31,020
!غنجو

230
00:19:31,690 --> 00:19:32,990
!تراجع

231
00:19:38,000 --> 00:19:39,800
.كيوشيرو

232
00:19:40,970 --> 00:19:42,690
.حقّق هدفك

233
00:19:42,700 --> 00:19:43,490
!أيّها الجدّ

234
00:19:46,210 --> 00:19:49,610
.لن يتقدّم أيّ أحد أكثر

235
00:19:51,020 --> 00:19:52,540
.هذا هو الوداع

236
00:20:06,800 --> 00:20:09,050
.وغد غبيّ

237
00:20:09,410 --> 00:20:12,180
!أوريغاسا شيزوما

238
00:20:12,690 --> 00:20:16,350
!شوراغامي كيوشيرو

239
00:20:31,510 --> 00:20:32,820
.هذه الرّسائل لك

240
00:20:34,750 --> 00:20:37,500
.إنّها من مايكروفت من الوطن

241
00:20:37,500 --> 00:20:38,970
أهو صديقك؟

242
00:20:39,430 --> 00:20:42,370
.عضو زميل من نادي ديوغنيس

243
00:20:42,370 --> 00:20:44,920
.صديقك الّذي يحبّ الألغاز

244
00:20:45,410 --> 00:20:49,670
لا بدّ أنّ هذا هو جوابه على اللّغز
.الّذي أرسلته له من قبل

245
00:20:50,350 --> 00:20:53,860
.ويبدو أنّ هذا تقرير من الآنسة كوروغي

246
00:21:00,590 --> 00:21:03,700
.ممتاز. لنقارن الأجوبة

247
00:21:07,010 --> 00:21:09,110
"،عزيزي السّيّد باركس"

248
00:21:09,110 --> 00:21:12,130
".أشكرك عل أسئلتك المبهرة"

249
00:21:12,130 --> 00:21:17,010
.كانت صعبة، لكنّي أكملتها كلّها"
".إليك أجوبتي عليها

250
00:21:17,350 --> 00:21:22,260
لغز القمر المختفي الّذي تبعه"
".تساقط أسماك الكوي الخشبيّة

251
00:21:22,260 --> 00:21:27,080
كلاهما حدثان من فِعل شخص"
".يملك هدفًا محدّدًا

252
00:21:31,310 --> 00:21:34,720
"،بخصوص السّؤال الأوّل المتعلّق بالقمر"

253
00:21:34,720 --> 00:21:41,740
".هناك ما أعاق رؤية القمر ببساطة"

254
00:21:41,740 --> 00:21:44,400
".وذلك الشّيء هو منطاد"

255
00:22:02,800 --> 00:22:07,430
أمّا بخصوص السّؤال الثّاني عن"
"،تساقط أسماك الكوي من السّماء

256
00:22:07,430 --> 00:22:10,180
".فقد تمّ رميها من المنطاد"

257
00:22:12,800 --> 00:22:14,690
لماذا قد يفعلون شيئًا كهذا؟

258
00:22:15,510 --> 00:22:18,300
،حسب تقرير الآنسة كوروغي

259
00:22:18,300 --> 00:22:24,060
.فقد تمّ التّحليق بالمناطيد ليلاً لتجربتها سرًّا

260
00:22:24,380 --> 00:22:30,360
لكن من الصّعب تحديد مسار
.تحليق المناطيد في اللّيل

261
00:22:30,360 --> 00:22:37,460
ولذلك كانوا يرمون أسماك الكوي
،على فترات منتظمة لالتقاطها لاحقًا

262
00:22:37,460 --> 00:22:39,760
.ليروا المسار الّذي حلّقوا فيه

263
00:22:45,880 --> 00:22:51,750
لماذا إذًا اختاروا أسماك كوي خشبيّة"
"من بين كلّ الأشياء الّتي قد يستعملونها؟

264
00:22:51,750 --> 00:22:58,360
لا بدّ أنّ شخصًا معيّنًا له علاقة"
".بهذه الخطّة يحبّ أسماك الكوي

265
00:22:58,650 --> 00:23:03,860
سألتُ أخي الّذي لديه معرفة كبيرة"
".باليابان بخصوص هذا الجزء

266
00:23:04,180 --> 00:23:08,040
شرح لي أنّ الشّخص المتورّط في هذا"
"،لديه هواية تربية أسماك الكوي

267
00:23:08,040 --> 00:23:10,690
".أو لديه وشم لأسماك الكوي"

268
00:23:10,690 --> 00:23:15,800
حسب الآنسة كوروغي، فإنّ موريا ريوزو
،المتورّط في هذه الخطّة

269
00:23:15,800 --> 00:23:18,790
.لديه وشم لتنّين أحمر

270
00:23:19,080 --> 00:23:22,370
إنّ سمكة الكوي الّتي تتسلّق
.شلاّلاً تصير تنّينًا

271
00:23:22,750 --> 00:23:28,760
،رغم أنّ الخطّة سرّيّة
،إلاّ أنّ موريا ريوزو المحبّ للتّفاصيل

272
00:23:28,760 --> 00:23:32,390
.حرص على استعمال رمز يمثّله

273
00:23:32,390 --> 00:23:35,460
.هكذا رأت الآنسة كوروغي الأمر

274
00:23:53,030 --> 00:23:53,830
.تبًّا

275
00:23:55,020 --> 00:24:05,780
أستنتج أنّ هذا الحادث هو بمثابة تجربة"
".لاختبار هجوم مخطّط له سيتمّ تنفيذه ليلاً

276
00:24:10,510 --> 00:24:12,100
...ما-ما الّذي

277
00:24:15,480 --> 00:24:17,850
ما هذا في الأعلى؟

278
00:24:21,870 --> 00:24:26,730
أين هذا المكان الّذي يخطّطون
لمهاجمته بالمناطيد؟

279
00:24:27,070 --> 00:24:32,360
قلب طوكيو والأرض المقدّسة"
"...للأمّة اليابانيّة

280
00:24:33,100 --> 00:24:34,660
!القصر الإمبراطوريّ؟

281
00:24:34,490 --> 00:24:39,700
القصر
الإمبراطوريّ

282
00:24:40,720 --> 00:24:43,610
،يقال أنّ القصر الإمبراطوريّ منيعٌ لا يُخترق

283
00:24:43,610 --> 00:24:46,450
.لكنّه غير محميّ من أيّ هجوم من السّماء

284
00:24:47,080 --> 00:24:49,960
،سنستعيد الإمبراطور من أيدي الأشرار

285
00:24:50,320 --> 00:24:55,850
.ونجعل منه دليلاً مرئيًّا لصلاح تمرّدنا

286
00:24:58,090 --> 00:25:00,940
أتظنّ أنّ الأمر سينجح بهذه السّهولة؟

287
00:25:01,200 --> 00:25:03,190
.هذا ليس كلّ شيء

288
00:25:03,630 --> 00:25:07,790
سنبلغ العامّة أنّ اغتيال سايغو
.كان من صنع الحكومة

289
00:25:07,790 --> 00:25:11,390
سيجعل هذا دماء السّاموراي
.السّابقين في كلّ اليابان تغلي

290
00:25:11,910 --> 00:25:16,130
،وثمّ يا كاتاموري-ساما
،ستبزغ من كلّ هذا كإمبراطور

291
00:25:16,130 --> 00:25:20,120
وستقود السّاموراي السّابقين الغاضبين
!إلى النّصر على الحكومة

292
00:25:21,870 --> 00:25:28,500
.إنّ عصر السّاموراي سيبدأ من جديد