1
00:00:53,990 --> 00:00:55,490
.تحيّاتي

2
00:00:55,740 --> 00:00:58,950
.اسمي شوراغامي كيوشيرو

3
00:00:59,700 --> 00:01:05,580
،لا أزال حديث العهد في العالم الحقيقيّ
.وما زلت أتعلّم كيف أشقّ طريقي

4
00:01:05,580 --> 00:01:09,460
.أتطلّع قدمًا لأكون تحت جناحك

5
00:01:09,460 --> 00:01:11,000
!لا تتعجّل في إظهار طيبتك

6
00:01:11,590 --> 00:01:12,880
.أخي غوتو

7
00:01:12,880 --> 00:01:18,590
أنت هو الأعور الّذي تسبّب بالمشاكل
لعشيرة دوياما، صحيح؟

8
00:01:18,590 --> 00:01:20,180
.أرى أنّك الإشاعات قد وصلتك

9
00:01:20,180 --> 00:01:26,060
إنّك جوّال مثير للشّفقة حاول خداع
منزل قمار وتمّ طرده، صحيح؟

10
00:01:26,600 --> 00:01:30,230
عشيرة
موريا

11
00:01:26,770 --> 00:01:31,570
بعد مشاكلك مع عشيرة دوياما أتيت الآن
.إلى هنا للاختباء تحت اسم عشيرة موريا

12
00:01:31,820 --> 00:01:34,650
!لا يمكنني السّماح لأمثالك بلقاء زعيمنا

13
00:01:34,650 --> 00:01:36,200
!غادر في الحال وإلىّ تذوّقَ سيفي دماءك

14
00:01:38,700 --> 00:01:40,990
.يبدو أنّ هنالك سوء فهم

15
00:01:41,240 --> 00:01:44,160
.سأعود في وقت لاحق

16
00:01:48,210 --> 00:01:51,710
.تمّ طردك؟ يا لحظّك العاثر

17
00:01:51,710 --> 00:01:57,340
.يبدو أنّ عشيرة دوياما تنشر إشاعات زائفة

18
00:01:57,680 --> 00:02:02,810
بالطّبع، إنّهم ياكوزا. من المستحيل
.أن يعترفوا بأنّ رجالهم خسروا

19
00:02:03,640 --> 00:02:05,520
ماذا ستفعل الآن؟

20
00:02:06,560 --> 00:02:08,310
...كنتُ أفضّل ألاّ أضطرّ لهذا

21
00:02:08,940 --> 00:02:11,520
.لكن قد يتوجّب عليّ أن أمطرها دمًا عليهم

22
00:02:12,520 --> 00:02:17,530
الحلقة الثّانية     أسلوب الشّوارع

23
00:02:35,960 --> 00:02:38,340
.ا-اقطع رأسي الآن رجاءً

24
00:02:50,310 --> 00:02:51,770
...غنوسكي

25
00:03:05,830 --> 00:03:07,580
كان حلمًا؟

26
00:03:09,660 --> 00:03:12,420
.لا يمكنني الموت حتّى أفي بوعدي

27
00:03:13,130 --> 00:03:14,380
.أعلم ذلك

28
00:03:15,000 --> 00:03:17,380
.أنت، انتهت دوريّتك

29
00:03:17,380 --> 00:03:18,960
.أيّها الشّرطيّ أوساناي

30
00:03:18,960 --> 00:03:21,180
.أتمنّى ألاّ تكون قد نمت أثناء العمل

31
00:03:21,180 --> 00:03:23,930
.بالطّبع لا. يمكن الاعتماد عليّ في اللّيل

32
00:03:23,930 --> 00:03:25,930
.وكأنّي سأصدّق كلامك

33
00:03:25,930 --> 00:03:30,810
لماذا سمح مشرف الشّرطة كاواجي لفتى
من أيزو مثلك بالانضمام لقوّات الشّرطة؟

34
00:03:30,810 --> 00:03:33,060
.لم أرغب بالانضمام

35
00:03:33,060 --> 00:03:36,860
،لكنّه كان مصرًّا جدًّا
.لذلك لم أستطع رفض طلبه

36
00:03:37,520 --> 00:03:39,440
!أيّها الوغد المزعج

37
00:03:39,440 --> 00:03:42,950
إيّاك أن تجرؤ على القيام بأيّ شيء
،لتدنيس اسم المشرف كاواجي

38
00:03:42,950 --> 00:03:45,120
!وإلاّ جعلتك تندم على ذلك

39
00:03:45,320 --> 00:03:47,830
أتمانع لو أبعدت وجهك قليلاً؟

40
00:03:47,830 --> 00:03:49,330
!هناك شجار

41
00:03:50,200 --> 00:03:51,540
.أيّها الوغد

42
00:03:51,540 --> 00:03:54,000
أليس لديك ما تقوله بعد أن اصطدمت بي؟

43
00:03:54,000 --> 00:03:57,290
!لا تعبث معي! أنت من اصطدم بي

44
00:03:58,880 --> 00:04:01,760
.أرى أنّك جريء لافتعالك شجارًا مع التشينداي

45
00:04:03,380 --> 00:04:04,130
ما الخطب؟

46
00:04:04,130 --> 00:04:05,470
أنلت كفايتك؟

47
00:04:07,680 --> 00:04:10,100
.يا لجرأتك بالفعل لتواجهنا هكذا

48
00:04:10,350 --> 00:04:12,270
.سآخذ هذه لقاء تعبنا

49
00:04:12,270 --> 00:04:14,190
!أوقفوا هذا الشّجار

50
00:04:14,190 --> 00:04:16,110
.وصل أصحاب العصيّ

51
00:04:16,110 --> 00:04:18,190
وماذا ستفعلان إن لم نوقف القتال؟

52
00:04:18,190 --> 00:04:19,320
هل ستعتقلاننا؟

53
00:04:19,320 --> 00:04:21,530
!هيّا، تعالا واعتقلاني

54
00:04:21,530 --> 00:04:24,660
أليس من واجبكما القبض
عليّ بتهمة التّبوّل العلنيّ؟

55
00:04:24,660 --> 00:04:27,030
.أكيد. سأحقّق أمنيتك وأعتقلك

56
00:04:27,030 --> 00:04:29,450
.لذلك أرجع ذلك الغصن المثير للشّفقة لسروالك

57
00:04:29,450 --> 00:04:30,450
!ماذا قلت؟

58
00:04:30,450 --> 00:04:33,910
أتعتقد أنّ رجُلا شرطةٍ فاشلين
قادرين على مواجهة التشينداي؟

59
00:04:33,910 --> 00:04:37,080
.توقّف. الشّجار مع الجنود ليس فكرة جيّدة

60
00:04:37,080 --> 00:04:38,840
أتخبرني ألاّ أتدخّل؟

61
00:04:38,840 --> 00:04:41,010
.سنكتفي بتقديم إنذار فحسب

62
00:04:41,010 --> 00:04:43,670
أنت ساموراي مفلس، صحيح؟

63
00:04:43,670 --> 00:04:46,470
!لقد ولّى عصر السّاموراي المتغطرسين

64
00:04:46,470 --> 00:04:49,140
لماذا لا تحاول تقطيعي؟

65
00:04:49,140 --> 00:04:51,970
.مهلاً، أنا آسف. ما عدت تملك سيفك

66
00:04:52,890 --> 00:04:55,060
!أيّها الجنديّ الوضيع

67
00:04:55,060 --> 00:04:56,690
.اهدأ أيّها المغفّل

68
00:04:56,690 --> 00:04:57,860
.اتركني

69
00:05:00,900 --> 00:05:02,990
!ما الّذي تفعله؟

70
00:05:02,990 --> 00:05:04,400
ماذا؟ أتريد أن تجرّب؟

71
00:05:04,400 --> 00:05:06,160
.أنا جاهز لخوض شجار آخر

72
00:05:09,030 --> 00:05:10,370
.تبًّا، لنغادر في الحال

73
00:05:14,370 --> 00:05:19,210
كيف يسير التّحقيق مع الرّجال
الّذين هاجموا السّيّد إيواكورا؟

74
00:05:19,210 --> 00:05:24,590
حقّقنا مع الجميع، بمن في ذلك
.زعيمهم تاكيتشي كوماكيتشي

75
00:05:24,590 --> 00:05:27,930
.لكن ما زالت هناك عدّة أسئلة بلا أجوبة

76
00:05:27,930 --> 00:05:29,430
وما الّذي تريد أن تعرفه أكثر؟

77
00:05:29,430 --> 00:05:34,270
هويّة الشّخص الّذي أخبر تاكيتشي وبقيّة
،المجرمين عن جدول السّيّد إيواكورا

78
00:05:34,270 --> 00:05:38,150
ولماذا كان هناك مسدّس في حيازتهم
—عندما اعتقلناهم

79
00:05:38,150 --> 00:05:39,520
.لقد حُلّت القضيّة

80
00:05:39,520 --> 00:05:40,480
ماذا؟

81
00:05:40,480 --> 00:05:43,860
.تمّ اعتقال من يتحدّون الحكومة

82
00:05:43,860 --> 00:05:45,740
.وبهذا أُغلقت القضيّة

83
00:05:46,110 --> 00:05:51,740
وإن واصلنا تأخير إغلاقها، فسيشكّ النّاس
.في كفاءة الحكومة، وهذا ما علينا تفاديه

84
00:05:51,740 --> 00:05:52,370
—لكن

85
00:05:52,370 --> 00:05:54,370
.سينتهي هذا الأمر هنا

86
00:05:54,370 --> 00:05:55,660
هل من أمر آخر؟

87
00:05:55,660 --> 00:06:00,880
نعم. سيصل المستشار
.السّابق إتو إلى ساغا قريبًا

88
00:06:01,210 --> 00:06:05,710
واستجابة لذلك، هناك تزايد في نشاطات
.المحاربين غير الرّاضين في ساغا

89
00:06:05,960 --> 00:06:10,640
هناك احتمال كبير لنشوء ثورة سيلعب
.فيها المستشار السّابق إتو دورًا هامًّا

90
00:06:10,640 --> 00:06:14,680
ذلك الرّجال مثاليّ. إنّه يؤمن بالحكم
.بالقانون أكثر من القوّة

91
00:06:15,180 --> 00:06:20,560
أليس من المرّجح أكثر أن يقنعهم
بترك السّلاح بدل حمله؟

92
00:06:20,560 --> 00:06:25,070
.هذا ما لم يكن قد صار واحدًا منهم سلفًا

93
00:06:39,620 --> 00:06:41,460
.سمعتُ الأخبار يا غوتو

94
00:06:41,460 --> 00:06:45,880
.لقد طردت جوّالاً حاول الاختباء ضمننا

95
00:06:45,880 --> 00:06:50,720
حاول ذلك الوغد إقحامنا
.في نزاعه مع دوياما

96
00:06:50,720 --> 00:06:52,640
.أخفته بعض الشّيء وأرسلته في حال سبيله

97
00:06:52,640 --> 00:06:56,430
.الدّوياما هم منافسونا
.إنّنا نتقاتل على نفس المنطقة

98
00:06:56,430 --> 00:07:00,440
كان بإمكانك الاحتفاظ به استعداد
.لأيّ شيء من باب الحيطة

99
00:07:00,640 --> 00:07:05,820
.لكنّه شخص ذو كبد رطِبة
.سيكون مجرّد عائق لنا فحسب

100
00:07:05,820 --> 00:07:12,280
لماذا لا ندع الزّعيم يحدّد بنفسه
إن كانت كبدي رطِبة؟

101
00:07:12,280 --> 00:07:14,580
!يا هذا! ما الّذي تفعله هنا؟

102
00:07:14,830 --> 00:07:18,950
.اعذروا تطفّلي عليكم هكذا

103
00:07:19,290 --> 00:07:24,670
،سمعتُ إشاعات فظيعة عنّي
.وأردتُ أن أصحّحها بنفسي

104
00:07:24,670 --> 00:07:27,500
.لذلك أحضرتُ دليلاً معي

105
00:07:27,500 --> 00:07:28,840
ماذا؟

106
00:07:28,840 --> 00:07:30,630
ما الّذي أحضرته؟

107
00:07:30,880 --> 00:07:32,630
عشيرة
دوياما

108
00:07:34,600 --> 00:07:37,310
!إ-إنّها لافتة عشيرة دوياما

109
00:07:37,310 --> 00:07:38,350
...كيف استطعت

110
00:07:40,810 --> 00:07:42,190
.بالقوّة

111
00:07:48,730 --> 00:07:51,780
.وها قد صارت منطقة دوياما تابعة لك يا زعيم

112
00:07:53,320 --> 00:07:56,490
.أنت تروق لي يا فتى

113
00:08:06,080 --> 00:08:08,710
.سمعتُ أنّك واجهت وقتًا عصيبًا البارحة

114
00:08:08,710 --> 00:08:10,420
دخلت في شجار مع التشينداي؟

115
00:08:10,420 --> 00:08:12,590
.ما زال رأسي يؤلمني

116
00:08:12,590 --> 00:08:16,090
يعلمون أنّنا لا نستطيع التّدخّل
،في شؤونهم ببساطة

117
00:08:16,090 --> 00:08:18,510
لذلك يقومون باستفزازنا
.ويصعّبون الأمر علينا

118
00:08:18,510 --> 00:08:21,810
هل ندمت على الانضمام للشّرطة؟

119
00:08:21,810 --> 00:08:25,560
.لا يمكنني شرب السّاكي والرّاتب قليل

120
00:08:25,560 --> 00:08:28,900
.سأكون كاذبًا إن قلت أنّي لستُ نادمًا

121
00:08:29,690 --> 00:08:31,360
.المزيد رجاءً يا ميتسو-سان

122
00:08:31,360 --> 00:08:32,150
.في الحال

123
00:08:32,150 --> 00:08:34,910
.لكنّي شاكر للملجأ والمأكل الدّائمين

124
00:08:34,910 --> 00:08:37,870
كما يمكنك دخول المسارح
.بالمجّان إن كنت تحبّها

125
00:08:37,870 --> 00:08:42,200
لكن عليّ أن أكون حذرًا هناك. لا أريد
.أن ينتهي بي المطاف مثل الشّرطيّ أوساناي

126
00:08:43,500 --> 00:08:45,250
عمّ تتحدّث؟

127
00:08:45,460 --> 00:08:48,090
ذلك الشّخص هناك، بغضّ النّظر عن
.مظهره، من أكبر محبّي المسرح

128
00:08:48,090 --> 00:08:51,550
،تسبّب ذلك بالمشاكل له
.وتمّ نقله إلى هنا جرّاء ذلك

129
00:08:51,550 --> 00:08:54,010
ما مدى فداحة الخطأ الّذي قد يرتكبه
المرء لينتهي به الأمر هكذا؟

130
00:08:54,010 --> 00:08:57,140
.ربّما من الأفضل ألاّ تسألني عن التّفاصيل

131
00:08:57,140 --> 00:08:59,390
.قد أتعرض لتوبيخ شديد إن تكلّمتُ كثيرًا

132
00:08:59,720 --> 00:09:04,180
،أخبرني أيّها الشّرطيّ أوريغاسا
سمعت إشاعات أنّ المشرف كاواجي

133
00:09:04,180 --> 00:09:05,890
.جنّدك شخصيًّا

134
00:09:05,890 --> 00:09:07,480
أذلك صحيح؟

135
00:09:08,150 --> 00:09:09,820
.إنّها قصّة طويلة

136
00:09:11,070 --> 00:09:13,440
لن تعمل على عربتك اليوم؟

137
00:09:13,690 --> 00:09:15,320
أنت ثانية؟

138
00:09:15,700 --> 00:09:18,660
سبق وأخبرتك أنّي لستُ مهتمًّا
.بالانضمام للشّرطة

139
00:09:18,660 --> 00:09:24,290
صحيح، لكنّنا لا أستطيع السّماح لقاتل
.الأوني من أيزو بالتّجوّل بحرّيّة

140
00:09:25,210 --> 00:09:27,620
.لقد بحثتُ في ماضيك

141
00:09:27,620 --> 00:09:31,550
معك حقّ. قتلتُ الكثير من رجال
.ساتشو خلال حرب بوشين

142
00:09:31,960 --> 00:09:34,050
ومع ذلك ما زلتَ تريدني
أن أعمل لدى الشّرطة؟

143
00:09:34,210 --> 00:09:37,680
.أريد الاحتفاظ بك حيث يمكنني مراقبتك

144
00:09:37,680 --> 00:09:41,760
.لا أريد لمهاراتك أن تقع بين الأيدي الخطأ

145
00:09:41,760 --> 00:09:45,060
.لا سبب يدفعك للقلق
.لقد تخلّيت عن سيفي

146
00:09:45,430 --> 00:09:47,310
.أنا مجرّد سائق عربة الآن

147
00:09:47,310 --> 00:09:49,190
أواثق بشأن ذلك؟

148
00:09:50,690 --> 00:09:53,570
...لقد خاطرتَ بحياتك في قتال تلك اللّيلة

149
00:09:53,570 --> 00:09:56,110
ألم تشعر بالدّماء تغلي في عروقك؟

150
00:09:59,530 --> 00:10:04,200
لا يمكنك أبدًا التّخلّي عن دماء
.السّاموراي الّتي تجري في عروقك

151
00:10:04,200 --> 00:10:05,660
!أغلق فمك

152
00:10:06,500 --> 00:10:07,960
هل نختبر نظريّتي هذه؟

153
00:10:23,140 --> 00:10:25,770
.لا يمكنك الكذب على نفسك

154
00:10:26,480 --> 00:10:31,360
قوّات الشّرطة هي أفضل
.مكان لاستعمال قوّتك

155
00:10:31,360 --> 00:10:33,940
.وللبحث عن خطيبك أيضًا

156
00:10:33,940 --> 00:10:36,230
بحثتَ في ذلك الأمر أيضًا؟

157
00:10:37,530 --> 00:10:41,570
.انضمّ للشّرطة يا أوريغاسا شيزوما

158
00:10:43,580 --> 00:10:45,240
ما الخطب أيّها المستجدّ؟

159
00:10:45,240 --> 00:10:46,790
.تعلو وجهك نظرة كئيبة

160
00:10:48,370 --> 00:10:50,460
.هكذا أبدو في العادة

161
00:10:56,170 --> 00:11:01,680
منحت لي الحكومة اليابانيّة ترخيصًا
للقيام بهذا التّقرير. هلّي بالدّخول؟

162
00:10:56,550 --> 00:11:01,680
فرانكشتاين
أو بروميثيوس العصريّ

163
00:11:01,680 --> 00:11:03,430
...حسنًا

164
00:11:06,010 --> 00:11:08,600
.تاكيتشي كوماكيتشي. لديك زوّار

165
00:11:09,020 --> 00:11:11,100
.شكرًا. سأتولّى الأمر من هنا

166
00:11:13,690 --> 00:11:17,570
.أنا ميري بلاكوود
.مراسلة من المملكة المتّحدة

167
00:11:17,570 --> 00:11:19,530
.أنا هنا للقيام بمقابلة معك

168
00:11:19,530 --> 00:11:22,740
.غادري. أنا لا أثق في المراسِلات

169
00:11:24,030 --> 00:11:25,450
هل أنت واثق؟

170
00:11:25,450 --> 00:11:30,250
.سيتذكّرك التّاريخ كأحد أسوأ الأشرار

171
00:11:30,250 --> 00:11:31,420
!هُراء

172
00:11:31,420 --> 00:11:34,630
!أنا رجل نبيل في أمّة مريضة! أنا وطنيّ

173
00:11:35,090 --> 00:11:40,970
أخبرني بالحقيقة، وسأكتب جانبك
.من القصّة في مقالي

174
00:11:42,720 --> 00:11:44,430
ماذا تريدين أن تعرفي؟

175
00:11:44,720 --> 00:11:49,640
من أعطاك جدول سير هدفك؟
ووفّر لك المسدّس أيضًا؟

176
00:11:50,560 --> 00:11:53,650
.إنّها غيشا أعرفها منذ مدّة
.لكنّي لن أقول لك عن اسمها

177
00:11:53,650 --> 00:11:56,480
غيشا؟ ساعدتك غيشا؟

178
00:11:56,480 --> 00:11:59,110
.إنّها ليست غيشا عاديّة

179
00:11:59,110 --> 00:12:03,240
اكتشفت حركات الهدف والوقت
.والمكان المثاليّين للهجوم عليه أيضًا

180
00:12:03,240 --> 00:12:05,620
.إضافة إلى توفير مسدّس لي

181
00:12:05,620 --> 00:12:08,030
.إنّها وطنيّة بقدري أنا

182
00:12:08,030 --> 00:12:09,370
.فهمت

183
00:12:09,370 --> 00:12:11,540
.إذًا فهذه الغيشا هي العقل المدبّر

184
00:12:11,540 --> 00:12:12,750
!كلاّ

185
00:12:12,750 --> 00:12:15,130
!نحن حليفان نتشارك نفس الهدف

186
00:12:15,460 --> 00:12:20,590
لا بدّ أنّها في غاية الدّهاء
.إن كان بيدقها لا يعرف أنّه بيدق

187
00:12:21,590 --> 00:12:25,260
مهلاً! آمل أن تكتبي ذلك
.المقال كما ودعتِ

188
00:12:25,260 --> 00:12:27,140
.صحيح. المقال

189
00:12:27,140 --> 00:12:28,560
.تفضّل

190
00:12:30,430 --> 00:12:32,100
ما هذا؟

191
00:12:32,100 --> 00:12:33,850
.قرد في سيرك

192
00:12:33,850 --> 00:12:35,400
.مناسب لك تمامًا

193
00:12:35,400 --> 00:12:36,730
!إذًا فقد خدعتني؟

194
00:12:37,650 --> 00:12:40,320
.أدخلوها للمستودع بسرعة

195
00:12:40,320 --> 00:12:42,940
.ليس أمامنا اليوم بطوله

196
00:12:42,940 --> 00:12:45,240
.تبدو مشغولاً يا فوجيشيما-سان

197
00:12:45,240 --> 00:12:48,120
.نعم. شكرًا على قدومك يا هينازورو

198
00:12:48,120 --> 00:12:49,530
.تفضّلي بالدّخول

199
00:13:08,800 --> 00:13:10,600
ما غرضك اليوم؟

200
00:13:10,600 --> 00:13:12,850
.لديّ مسدّسات مثيرة للاهتمام

201
00:13:13,100 --> 00:13:15,390
.لا أحتاج لتلك الألعاب

202
00:13:15,390 --> 00:13:19,610
.أريد شيئًا يقتل بسرّيّة وصمت ودقّة لا متناهية

203
00:13:19,610 --> 00:13:21,270
.ما رأيك بهذا السّمّ إذًا

204
00:13:21,900 --> 00:13:24,070
.يمكنك تجربته بنفسك

205
00:13:25,030 --> 00:13:28,160
.سمعتُ أنّ إتو شينبي عاد لليابان

206
00:13:28,160 --> 00:13:31,410
هل تعتقدين فعلاً أنّه سيقوم بما
نأمل أنّه سيفعل؟

207
00:13:31,700 --> 00:13:35,210
.لديّ شخص ما يختبئ هناك في ساغا

208
00:13:35,660 --> 00:13:39,630
،حتّى إن لم يرغب إتو في ذلك
.فلا يمكنه الهروب من قدره

209
00:13:40,710 --> 00:13:43,130
.أنا أتعاطف معكم جميعًا

210
00:13:43,130 --> 00:13:48,050
ولكن يجب علينا الآن إدانة الحكومة
.بالقانون والمنطق، وليس بالعنف

211
00:13:48,050 --> 00:13:50,800
.هكذا يقاتل الأشخاص المتحضّرون

212
00:13:51,720 --> 00:13:53,010
!إتو-سينسي

213
00:13:53,010 --> 00:13:54,020
ماذا هنالك؟

214
00:13:54,020 --> 00:13:59,650
إنّ طبقة المحاربين في ساغا
!قد علموا بعودتك وحملوا الأسلحة

215
00:13:59,650 --> 00:14:00,400
ماذا؟

216
00:14:00,900 --> 00:14:05,690
!عليك أن تلتقي بهم وقيادة جيشهم في الحال

217
00:14:06,240 --> 00:14:07,400
!حان الوقت

218
00:14:07,400 --> 00:14:09,410
!إنّه وقت الإصلاح الثّاني

219
00:14:09,410 --> 00:14:12,370
!أجل! حان الوقت لنريهم قوّتنا

220
00:14:12,370 --> 00:14:13,990
!علينا أن نسرع

221
00:14:21,670 --> 00:14:26,670
إيّاك أن تعرقل حركتي بتصرّفاتك
.المثيرة للشّفقة هذه المرّة

222
00:14:26,670 --> 00:14:28,090
.وأنت كذلك

223
00:14:29,930 --> 00:14:31,890
!الـ-النّجدة

224
00:14:32,300 --> 00:14:34,220
!إنّهم التشينداي

225
00:14:34,680 --> 00:14:38,140
!أيّها الرّهبان المريبون! سألقّنكم درسًا

226
00:14:38,140 --> 00:14:39,980
!غادروا أيّها الحثالة

227
00:14:41,150 --> 00:14:43,020
!من منكم قال هذا؟

228
00:14:43,020 --> 00:14:44,610
!سأوسعك ضربًا

229
00:14:44,610 --> 00:14:46,070
!هذا يكفي

230
00:14:46,440 --> 00:14:48,280
!جميعكم خارجون عن القانون

231
00:14:48,280 --> 00:14:51,160
.هؤلاء التشينداي الأوغاد ثملون ثانية

232
00:14:51,160 --> 00:14:53,740
!يا-يا هؤلاء! ما الّذي تفعلونه؟

233
00:14:53,950 --> 00:14:57,950
ما الخطب أيّها العاملان المدنيّان المثيران
للشّفقة؟ أعدتما للمزيد من الضّرب؟

234
00:14:57,950 --> 00:15:02,880
أ-ألا تشعرون بالخزي من إحراج أنفسكم
!في العلن هكذا أيّها الجنود؟

235
00:15:03,290 --> 00:15:05,380
!وغد ثرثار

236
00:15:07,710 --> 00:15:08,550
!هل أنت بخير؟

237
00:15:08,550 --> 00:15:10,130
.لم أتوقّع ذلك

238
00:15:11,550 --> 00:15:14,550
ما الخطب أيّها الشّرطيّان العفنان؟
.الجميع يشاهدون

239
00:15:14,550 --> 00:15:15,640
!قوما بعملكما

240
00:15:15,640 --> 00:15:18,020
.إيّاك أن توقفني هذه المرّة

241
00:15:18,020 --> 00:15:21,480
!حسنًا. أرهم معدن الشّرطة الحقيقيّ

242
00:15:23,020 --> 00:15:24,900
.دخل نجم العرض

243
00:15:25,520 --> 00:15:28,030
...أيّها الصّعاليك الأوغاد الّذين تهدّدون الميناء

244
00:15:28,030 --> 00:15:30,780
!أنا أتحدّاكم

245
00:15:33,240 --> 00:15:34,490
!لا تعبث معنا

246
00:15:34,490 --> 00:15:35,780
!نالوا منه

247
00:15:44,420 --> 00:15:46,500
.أحسنت أيّها الشّرطيّ أوريغاسا

248
00:15:49,210 --> 00:15:50,380
!لا تستهن بي

249
00:15:57,850 --> 00:16:00,140
،أيّها المواطنون المجتمعون هنا في أساكوسا

250
00:16:00,140 --> 00:16:06,820
!لا تتهاون الشّرطة أبدًا مع أيّ أحد يستعمل العنف

251
00:16:07,820 --> 00:16:12,200
،إن كنتم تواجهون المشاكل
!فتعالوا إلى قسمي في دنبوين

252
00:16:17,450 --> 00:16:19,740
.ذلك الرّجل مذهل

253
00:16:30,550 --> 00:16:34,260
.لم يكن أداؤك على المسرح هناك أداء مبتدئ

254
00:16:34,260 --> 00:16:36,010
أين تعلّمت ذلك؟

255
00:16:36,340 --> 00:16:40,720
.كان بعض زبائني الدّائمين كسائق عربة من الممثّلين

256
00:16:40,720 --> 00:16:42,890
.انتحلت شخصيّة كيكوغورو اليوم

257
00:16:42,890 --> 00:16:46,650
!ركب كيكوغورو في عربتك؟
!كم أحسك على ذلك

258
00:16:47,150 --> 00:16:50,150
.إذًا فصحيح أنّك تحبّ المسرح

259
00:16:50,150 --> 00:16:54,530
أخبرك أحدهم أنّي واجهت المشاكل
بسبب ذلك، صحيح؟

260
00:16:54,530 --> 00:16:56,030
ماذا فعلت على أيّ حال؟

261
00:16:56,030 --> 00:16:57,620
.ذلك ليس بالأمر المهمّ

262
00:16:57,620 --> 00:16:59,950
،كان الممثّلون يقومون بعمل ممتاز

263
00:16:59,950 --> 00:17:04,540
نسيت أنّي كنتُ أرتدي زيّي
!"وصرخت قائلاً "الأفضل في اليابان

264
00:17:04,540 --> 00:17:06,370
.أراهن أنّ الكثير ضحكوا

265
00:17:07,040 --> 00:17:08,880
.ليت تلك كانت النّهاية

266
00:17:08,880 --> 00:17:13,210
بدأ المسرح بالتّرويج لعروضه
"!بقول "حتّى الشّرطة أحبّت العرض

267
00:17:13,210 --> 00:17:15,800
.وصار العرض محبوبًا للغاية

268
00:17:16,470 --> 00:17:18,970
وسمع الضّبّاط الكبار بذلك؟

269
00:17:18,970 --> 00:17:21,350
.وهكذا انتقلتُ إلى هنا

270
00:17:21,600 --> 00:17:25,850
على الأقلّ هناك الكثير من المسارح
هنا في تسوكاسا، صحيح؟

271
00:17:26,270 --> 00:17:27,730
.بكلّ تأكيد

272
00:17:31,480 --> 00:17:34,190
متى بدأ هذان الاثنان بالانسجام معًا؟

273
00:17:34,690 --> 00:17:36,780
رجل من ساتسوما وآخر من أيزو؟

274
00:17:37,070 --> 00:17:38,450
.إنّها معجزة

275
00:17:41,280 --> 00:17:43,660
يا سائق العربة، هلاّ أوصلتني؟

276
00:17:43,660 --> 00:17:45,660
!أكيد، إلى أين؟

277
00:17:46,000 --> 00:17:47,830
.إلى شينباشي لو سمحت

278
00:17:49,630 --> 00:17:52,380
هل أنت من صنع ذلك الأرنب؟

279
00:17:52,630 --> 00:17:56,590
.بل صنعه رجل أدين له بالكثير

280
00:17:57,050 --> 00:18:00,050
.تركته هناك آملاً أن يجلب لي الحظّ الجيّد

281
00:18:00,050 --> 00:18:02,350
.ويبدو أنّ ذلك نجح سلفًا

282
00:18:02,640 --> 00:18:04,060
كيف ذلك؟

283
00:18:04,060 --> 00:18:06,640
.هناك فتاة حسناء تركب عربتي الآن

284
00:18:06,640 --> 00:18:08,810
.يا إلهي، أنت بارع

285
00:18:10,560 --> 00:18:12,110
!أنا دائمًا في الخدمة

286
00:18:15,530 --> 00:18:16,400
ماذا؟

287
00:18:22,450 --> 00:18:23,540
.لقد عدت

288
00:18:23,990 --> 00:18:25,790
.يا لها من سمكة جميلة

289
00:18:37,550 --> 00:18:39,220
!لكن لماذا يا أختاه؟

290
00:18:39,630 --> 00:18:41,470
.كان لا بدّ من ذلك

291
00:18:41,720 --> 00:18:43,720
.رجاءً، أنت تخيفينني

292
00:18:43,720 --> 00:18:45,970
.توقّفي عن مخالطة أشخاص غرباء

293
00:18:46,470 --> 00:18:47,730
.أرجوك

294
00:18:48,230 --> 00:18:51,060
.إنّك فتاة طيّبة القلب يا كومي-تشان

295
00:18:51,060 --> 00:18:53,440
.عليك الابتعاد عنّي

296
00:18:53,820 --> 00:18:57,400
.عيشي حياة عاديّة مع أشخاص عاديّين

297
00:18:58,780 --> 00:18:59,900
!أختاه

298
00:19:00,490 --> 00:19:02,370
.لن أذهب إلى أيّ مكان

299
00:19:02,870 --> 00:19:05,450
.سأكون إلى جانبك دائمًا

300
00:19:05,740 --> 00:19:08,710
عشيرة
موريا

301
00:19:05,990 --> 00:19:07,580
!ما هذا؟

302
00:19:07,580 --> 00:19:08,710
!فسّروا لنا ما يحدث

303
00:19:08,710 --> 00:19:10,420
!نعم! قوموا بشيء ما

304
00:19:10,420 --> 00:19:12,170
!اهدؤوا جميعًا

305
00:19:12,170 --> 00:19:14,500
!كيف يفترض بنا أن نهدأ؟

306
00:19:14,500 --> 00:19:19,170
!إنّنا نحتاج لأجسادنا لجني قوت يومنا
!لن تفيدنا إن ملأتها الكدمات والكسور

307
00:19:19,170 --> 00:19:22,550
لقد ضربوا أحد رفاقي! لا يمكننا إظهار
!وجوهنا للعلن إلاّ إن نلنا منهم أيضًا

308
00:19:22,550 --> 00:19:24,050
!نعم، نعم

309
00:19:24,600 --> 00:19:27,020
ما الّذي يحدث في الخارج؟

310
00:19:27,020 --> 00:19:28,390
!الزّعيم موريا

311
00:19:28,390 --> 00:19:29,140
!أيّها الزّعيم

312
00:19:29,430 --> 00:19:32,730
يطالب العمّال أن نسمح لهم بأخذ اليوم إجازة

313
00:19:32,730 --> 00:19:36,070
للانتقام من التشينداي الّذين
.استهدفوا أحد رجالنا

314
00:19:36,070 --> 00:19:40,900
لن أسمح بذلك. سيكون علينا إيقاف
.أعمال البناء خاصّتنا هكذا

315
00:19:40,900 --> 00:19:45,200
لكن يا زعيم، كيف نسمّي أنفسنا
رجالاً إن لم نفعل أيّ شيء؟

316
00:19:45,200 --> 00:19:49,580
أخذ أحد رجال التشنداي علبة التّبغ
!الّتي تركها لي والدي قبل موته

317
00:19:51,370 --> 00:19:55,000
.حسنًا. سأتولّى أنا أمر ذلك القتال

318
00:19:55,000 --> 00:19:59,550
إذًا فستقوم عشيرة موريا بتسوية
الأمر مع التشينداي؟

319
00:19:59,550 --> 00:20:02,840
ثقوا بي. موريا ريوزو
.لا يتراجع أبدًا عن وعوده

320
00:20:03,760 --> 00:20:06,850
!هذا هو زعيمنا! أجل

321
00:20:07,140 --> 00:20:11,140
أيّها الزّعيم، هل ستقوم بتسوية الأمر
مع التشينداي بالفعل؟

322
00:20:11,390 --> 00:20:12,980
.بالطّبع لا

323
00:20:12,980 --> 00:20:17,730
.سنوفّر بعض الوقت وننتظر حتّى يهدأ العمّال

324
00:20:19,190 --> 00:20:24,780
إن لم ينجح ذلك، فسيكون علينا التّخلّص
.من الرّجل الّذي هُوجم بسرّيّة فحسب

325
00:20:24,780 --> 00:20:26,660
.هذا المتوقّع من زعيمنا

326
00:20:26,660 --> 00:20:29,910
.لن يبطئ فقدان عامل واحد أعمال البناء

327
00:20:29,910 --> 00:20:31,410
.لا يجب عليك فعل ذلك

328
00:20:31,910 --> 00:20:36,710
ستظهر آثامك للعلن في النّهاية
.وسيشوّه ذلك سمعتك

329
00:20:36,710 --> 00:20:40,630
.هذا شأننا نحن
.لا تتدخّل فيه رجاءً بما أنّك ضيف

330
00:20:40,630 --> 00:20:43,840
هل لديك فكرة أفضل؟

331
00:20:44,220 --> 00:20:49,430
كجوّال، فلن أسبّب المشاكل لأيّ أحد
.إن خضت شجارًا مع أحدهم

332
00:20:49,430 --> 00:20:52,520
كيوشيرو-سان، هل تقترح أن تقاتلهم بنفسك؟

333
00:20:52,520 --> 00:20:54,100
!انتبه لكلامك

334
00:20:53,270 --> 00:20:55,980
.لقد أطعمتموني وأويتموني

335
00:20:56,270 --> 00:20:59,400
لذلك من البديهيّ أن أضع جسدي
.على المحكّ لردّ الجميل لكم

336
00:21:00,020 --> 00:21:02,280
.سأقوم بذلك بكلّ سرور

337
00:21:10,030 --> 00:21:11,950
!مـ-من أنتم؟

338
00:21:12,250 --> 00:21:15,620
.نحن هنا لأخذ أحد رجالنا المسجونين

339
00:21:17,380 --> 00:21:20,040
!تعال بسرعة إلى قسم الشّرطة أيّها المستجدّ

340
00:21:22,050 --> 00:21:24,220
تهاجمون قسم الشّرطة؟
!هل فقدتم عقولكم؟

341
00:21:24,220 --> 00:21:26,840
!اخرس! إنّنا نستعيد أحد رجالنا

342
00:21:26,840 --> 00:21:30,680
!صدوهم حتّى يعود الشّرطيّون من دوريّتهم

343
00:21:30,680 --> 00:21:32,560
!لن يحدث ذلك

344
00:21:32,850 --> 00:21:36,060
.لدينا مجموعة ثانية في انتظارهم

345
00:21:36,690 --> 00:21:38,310
.أوغاد

346
00:21:38,310 --> 00:21:40,570
!سأشقّ طريقي بالقوّة إذًا

347
00:21:40,570 --> 00:21:42,150
!لن تصل إلى القسم أبدًا

348
00:21:48,820 --> 00:21:51,700
.أعدادهم كثيرة لقتالهم دفعة واحدة

349
00:22:00,960 --> 00:22:05,380
يا لكم من جبناء باتّحادكم جميعًا على
.رجل واحد. سأقاتل معك لتسوية الكفّة

350
00:22:05,380 --> 00:22:08,970
لا فكرة لديّ من تكون أو من
.أين أتيت، لكنّي مدين لك

351
00:22:09,220 --> 00:22:11,850
.اشكرني بعد أن تنجو

352
00:22:15,270 --> 00:22:17,480
!لا تهتمّوا بهذا! اقتلوهما

353
00:22:30,320 --> 00:22:33,530
.لست سيّئًا يا ذا العين الواحدة

354
00:22:33,530 --> 00:22:35,040
.وكذلك أنت

355
00:22:36,500 --> 00:22:37,750
.نحن هنا لأخذك

356
00:22:37,750 --> 00:22:39,670
!جيّد، كنتُ في انتظاركم

357
00:22:47,590 --> 00:22:49,380
!أيّها الشّرطيّ أوساناي

358
00:22:49,380 --> 00:22:50,640
...أوريغاسا

359
00:22:50,640 --> 00:22:51,840
!انتبه

360
00:22:51,840 --> 00:22:54,760
.يبدو أنّنا غفلنا عن بضع ملوّحي العصيّ

361
00:22:54,760 --> 00:22:57,270
.لن أغفر لكم هذا

362
00:22:57,270 --> 00:22:59,890
.أنت هو الوغد الّذي ربطني

363
00:22:59,890 --> 00:23:01,350
!سأقتلك

364
00:23:08,950 --> 00:23:12,070
.تلك علبة تبغ جيّدة يا هذا

365
00:23:12,280 --> 00:23:16,450
.نعم. أخذتها من عامل مغرور

366
00:23:18,290 --> 00:23:20,790
.اسمح لي بتقديم نفسي بسرعة

367
00:23:20,790 --> 00:23:22,130
ماذا؟

368
00:23:22,830 --> 00:23:28,710
أنا شوراغامي كيوشيرو، رجل مزعج محظوظ
.بما يكفي لتأخذني عشيرة موريا تحت جناحها

369
00:23:29,170 --> 00:23:33,590
،لا أكنّ لك أيّ ضغينة
.لكن لديّ دين مهمّ للغاية لأدفعه

370
00:23:33,800 --> 00:23:38,810
.لذلك عليّ أن أصرّ على أن تتحمّل المسؤوليّة

371
00:23:38,810 --> 00:23:40,180
مسؤوليّة؟

372
00:23:40,180 --> 00:23:43,860
يريد ياكوزا دنيء مواجهتي؟
!نحن التشينداي

373
00:23:59,870 --> 00:24:01,370
...ذلك الرّجل

374
00:24:03,710 --> 00:24:05,420
!استعمل هذا

375
00:24:06,130 --> 00:24:07,500
!هذه النّهاية

376
00:24:29,900 --> 00:24:32,740
!إلى كِلا الجانبين، أنزلوا سيوفكم

377
00:24:32,950 --> 00:24:34,740
.المشرف كاواجي

378
00:24:34,740 --> 00:24:37,530
.ليعد كلّ رجال التشينداي لوحداتهم

379
00:24:37,780 --> 00:24:38,780
!حاضر

380
00:24:38,780 --> 00:24:40,040
.مهلاً لحظة

381
00:24:40,040 --> 00:24:43,540
لا يمكن السّماح لهم بالذّهاب
!هكذا ببساطة بعد كلّ ما فعلوه

382
00:24:43,870 --> 00:24:46,790
.أفهم كيف تشعر، لكنّ البلاد تواجه أزمة

383
00:24:46,790 --> 00:24:48,920
.هناك تمرّد في ساغا

384
00:24:48,920 --> 00:24:56,590
يحتاج السّيّد أوكوبو إلى أكبر عدد ممكن من
!الرّجال لقيادة جيش إلى هناك وإخماد التّمرّد

385
00:24:56,890 --> 00:25:00,560
.وطبعًا لن يتمّ تبرئتهم جميعًا

386
00:25:00,560 --> 00:25:04,690
.سمعتُ بكلّ أعمالكما الأخيرة
.أنتما معفيّان من الخدمة في الجيش

387
00:25:04,690 --> 00:25:07,100
!سلّما نفسيكما للشّرطة بدون مقاومة

388
00:25:11,980 --> 00:25:14,900
أين ذهب ذلك الرّجل؟

389
00:25:17,160 --> 00:25:22,160
طبقة المحاربين في ساغا بقيادة إتو
...ضدّ التشينداي بقيادة أوكوبو

390
00:25:22,160 --> 00:25:24,250
من سيخرج منتصرًا يا ترى؟

391
00:25:24,460 --> 00:25:27,460
على من تضعين رهانك؟

392
00:25:29,420 --> 00:25:31,300
.يستحقّون الموت جميعًا

393
00:25:32,090 --> 00:25:33,760
هؤلاء المدّعين بأنّهم موالين للجيش

394
00:25:33,760 --> 00:25:37,930
ارتكبوا جرائم شنيعة خلال حرب بوشين
.يأكلون لحم بعضهم بعضًا الآن

395
00:25:38,390 --> 00:25:41,600
.لن يكون هناك عرض أكثر إثارة من هذا