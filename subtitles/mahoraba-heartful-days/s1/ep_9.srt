!مهلاً

212
00:13:10,680 --> 00:13:13,810
!يجب ان ترتدِ الزيّ المُناسب

213
00:13:14,810 --> 00:13:16,020
!ما هذا؟

214
00:13:16,810 --> 00:13:21,320
علمتُ انّ هذا سيحدث, لذلك جهّزتُ فخًّا

215
00:13:21,360 --> 00:13:23,230
...تـ تامامي - تشان

216
00:13:24,860 --> 00:13:27,490
عملٌ جيّد يا شريكتي

217
00:13:27,530 --> 00:13:31,370
على الرّحب يا عزيزتي

218
00:13:31,410 --> 00:13:34,200
...مهووسة صور و مهووسة ازياء

219
00:13:34,250 --> 00:13:36,250
انّهم فريقٌ لا يُقهر حقاً

220
00:13:36,290 --> 00:13:40,710
!و الآن يا تشيوري - تشان, اذهبي للأمام

221
00:13:41,340 --> 00:13:45,010
و الآن لنغيّر ملابسك

222
00:13:46,970 --> 00:13:49,010
!اوقفوا ذلك

223
00:13:55,430 --> 00:13:58,350
ما الخطب معي؟

224
00:13:59,770 --> 00:14:03,110
و الآن بعد ان فكّرتُ في الأمر, هذه المَلابس ليست مُناسبة

225
00:14:03,150 --> 00:14:05,110
يجب ان أُصحّح الخطأ على الفور

226
00:14:20,920 --> 00:14:22,210
!صحيح

227
00:14:22,250 --> 00:14:25,960
و اخيراً لديكِ الزيّ المُناسب يا آسامي - تشان

228
00:14:26,010 --> 00:14:27,760
...و الآن, التّالي

229
00:14:30,340 --> 00:14:31,220
!اوه لا

230
00:14:31,590 --> 00:14:35,140
!كيف يُمكنني ان ارتكب مثل هذا الخطأ؟

231
00:14:35,180 --> 00:14:38,480
!من الواضع انّ زي الأرنب هو المُلائم لك بالطّبع

232
00:14:38,520 --> 00:14:39,980
امنحيني دقيقة من فضلك

233
00:14:43,440 --> 00:14:46,110
ليس هُنا

234
00:14:54,620 --> 00:14:55,740
!هُناك

235
00:14:58,450 --> 00:15:00,790
عملٌ جيّد يا شريكتي

236
00:15:00,830 --> 00:15:04,590
على الرّحب يا عزيزتي

237
00:15:12,300 --> 00:15:13,550
!صحيح

238
00:15:13,590 --> 00:15:15,560
كدتُ افقدها

239
00:15:15,600 --> 00:15:17,930
سعيدة انّني تمكّنتُ من تصحيحك

240
00:15:18,930 --> 00:15:22,900
لم اعد ارَ مومونو - سان

241
00:15:24,560 --> 00:15:26,730
هذا خطير

242
00:15:26,770 --> 00:15:32,780
ان خرجت بملابس غير مُلائمة
فإنّها ستنشر الإرتباك في العالم

243
00:15:33,700 --> 00:15:34,760
!...هؤلاء هم

244
00:15:43,120 --> 00:15:46,460
علمتُ انّ هذا سيحدُث, لذلك جهّزتُ فخًّا

245
00:15:46,500 --> 00:15:48,050
!عمل جيّد

246
00:15:50,340 --> 00:15:52,340
كان ذلك وشيكًا

247
00:15:52,380 --> 00:15:54,300
لا تستهينوا بي

248
00:16:01,430 --> 00:16:05,270
علمتُ انّ هذا سيحدث
لذلك قمتُ بإعداد نظام الأشعة تحت الحمراء

249
00:16:05,690 --> 00:16:08,230
!عملٌ جيّد يا شريكتي

250
00:16:08,650 --> 00:16:11,440
!شُكرا لك يا عزيزتي

251
00:16:15,870 --> 00:16:17,200
كيف كان ذلك؟

252
00:16:17,240 --> 00:16:19,950
هل أنتِ راضية عن هذا؟

253
00:16:21,870 --> 00:16:23,080
!صحيح

254
00:16:23,120 --> 00:16:24,460
!مرحى

255
00:16:27,880 --> 00:16:31,050
لقد ذهبت بعيدًا مُجدّدًا

256
00:16:31,090 --> 00:16:32,340
...هايبارا - سان

257
00:16:32,840 --> 00:16:36,050
لا اهتم, و لكن لا تبتعدي

258
00:16:36,090 --> 00:16:37,350
انتِ مُزعجة جدًّا

259
00:16:37,890 --> 00:16:40,770
!كيف لك ان تتفوّه بهذه الفظاظة

260
00:16:40,810 --> 00:16:46,230
درستُ كل الاحتمالات للعثور على الملابس المثاليّة لكل شخص

261
00:16:46,270 --> 00:16:49,070
!افعلِ شيئًا لهذه الملابس اذاً

262
00:16:49,110 --> 00:16:51,110
!انّه لا يُغيّر ابدًا

263
00:16:51,610 --> 00:16:52,990
ملابسك؟

264
00:16:53,030 --> 00:16:53,700
أجل

265
00:16:54,400 --> 00:16:56,160
انت جيّد هكذا

266
00:16:56,200 --> 00:16:57,740
صحيح, صحيح

267
00:16:57,780 --> 00:17:00,580
!لا تهتمّين اطلاقاً

268
00:17:00,620 --> 00:17:02,250
هذا ليس صحيحًا

269
00:17:02,290 --> 00:17:05,420
اللّون الأخضر يُناسبك حقاً

270
00:17:05,460 --> 00:17:06,120
جيّد

271
00:17:06,580 --> 00:17:10,130
انّها تقول "صحيح" للأشخاص غير المُهتمّين

272
00:17:10,460 --> 00:17:13,970
بالمناسبة, لماذا لا تمسّكِ دائما يا تامامي؟

273
00:17:14,900 --> 00:17:19,120
تعال خذني

274
00:17:16,010 --> 00:17:19,600
تامامي - سان لا ترفض, لهذا هي صحيحة

275
00:17:19,640 --> 00:17:23,140
اذا تقول "صحيح" للأشخاص غير المكشوفين ايضًا

276
00:17:24,480 --> 00:17:25,310
حسنٌ

277
00:17:25,350 --> 00:17:27,230
قلتُ كلّ ما اُريد قوله, لذا انا مُغادر

278
00:17:28,150 --> 00:17:29,940
!انتظر دقيقة

279
00:17:29,980 --> 00:17:32,650
!افعل شيئًا بخصوص هذا, هايبارا - سان

280
00:17:33,110 --> 00:17:34,110
...أنت

281
00:17:39,030 --> 00:17:40,660
!أنا لا أعرفك

282
00:17:40,700 --> 00:17:42,370
!أنا لا أعرفك حقاً

283
00:17:42,910 --> 00:17:44,500
!و لكن هايبارا - سان

284
00:17:44,540 --> 00:17:46,160
!انّه انا! شيراتوري

285
00:17:46,210 --> 00:17:49,380
و الآن شُكرا لإنتظارك

286
00:17:49,420 --> 00:17:53,210
و الآن بعد ان انتهت جميع المُناوشات, لنُغيّر ملابسك

287
00:17:54,710 --> 00:17:55,720
حسنٌ

288
00:17:56,090 --> 00:17:57,550
!هذا رائع

289
00:17:57,590 --> 00:18:00,390
!و لكن سأُغيّر بنفسي

290
00:18:00,430 --> 00:18:01,720
يُمكنكِ تركي افعل ذلك على الأقل

291
00:18:01,760 --> 00:18:03,060
بالطّبع

292
00:18:18,530 --> 00:18:20,450
!لا تسترفوا النّظر

293
00:18:21,740 --> 00:18:25,410
لم افعل ذلك؟

294
00:18:26,450 --> 00:18:29,960
حسنٌ, سأصبح حُرًّا بعد هذا

295
00:18:30,670 --> 00:18:32,500
هيا بنا

296
00:18:34,630 --> 00:18:38,010
من المُزعج عدم القيام بأيّ شيء

297
00:18:38,050 --> 00:18:42,800
أهو مُمتع أكثر ان تُغيّري لهم ملابسهم؟

298
00:18:42,850 --> 00:18:43,850
!صحيح

299
00:18:43,890 --> 00:18:46,060
تعرفينني جيّدًا

300
00:18:46,100 --> 00:18:48,480
شكرا لك

301
00:18:51,480 --> 00:18:53,110
لقد انتهيت

302
00:18:53,150 --> 00:18:54,150
كيف هذا؟

303
00:18:54,190 --> 00:18:55,270
هل أنتِ راضية؟

304
00:18:56,780 --> 00:18:58,070
...هذا

305
00:18:58,110 --> 00:19:00,030
تبدين جميلة للغاية

306
00:19:01,660 --> 00:19:02,910
لقد انتهيتِ, صحيح؟

307
00:19:02,950 --> 00:19:03,660
وداعًا

308
00:19:04,240 --> 00:19:06,330
تمهّلي لحظة

309
00:19:06,910 --> 00:19:08,000
ماذا؟

310
00:19:08,040 --> 00:19:10,540
ارتديتُ كما وعدتك

311
00:19:10,540 --> 00:19:13,580
...لا بأس, و لكن

312
00:19:16,170 --> 00:19:20,550
...اشعر انّ هناك شيئًا ناقصا يجعلها مثاليّة

313
00:19:20,590 --> 00:19:22,340
ناقص؟

314
00:19:22,840 --> 00:19:25,350
أيمكن ان يكون ذلك هو المفقود؟

315
00:19:26,180 --> 00:19:27,180
!صحيح

316
00:19:27,220 --> 00:19:28,730
!هذه هي

317
00:19:28,770 --> 00:19:30,180
...أيعقل ان تكون هذه

318
00:19:30,230 --> 00:19:32,480
!الملابس الدّاخليّة المُفضّلة لدى مومونو - سان

319
00:19:33,350 --> 00:19:35,360
!ليس هذه

320
00:19:35,400 --> 00:19:37,280
ما الذي تقولينه؟

321
00:19:37,320 --> 00:19:41,030
ستكونين صحيحة اخيرا بعد ارتدائهم

322
00:19:41,070 --> 00:19:43,160
!كلّا يعني كلّا

323
00:19:45,120 --> 00:19:46,990
تم التقاط الهدف

324
00:19:47,040 --> 00:19:48,200
عمل جيّد تامامي - سان

325
00:19:48,950 --> 00:19:50,580
لا أستطيع مُساعدتك اذاً

326
00:19:50,620 --> 00:19:54,710
لا أُريد ذلك ايضا, لكن يجب عليّ فعل ذلك

327
00:19:56,610 --> 00:19:58,570
!اوقفوا ذلك

328
00:19:58,570 --> 00:20:00,590
لا بأس

329
00:20:00,630 --> 00:20:03,760
لا شيء لتخجلي منه, نحن نساء مع بعضنا

330
00:20:03,800 --> 00:20:05,640
!لا يُمكنك

331
00:20:05,640 --> 00:20:07,370
....لأنّ

332
00:20:10,430 --> 00:20:13,060
!أنا رجل

333
00:20:15,730 --> 00:20:17,570
انت رجل؟

334
00:20:17,610 --> 00:20:19,820
!كم هذا سخيف

335
00:20:20,190 --> 00:20:21,190
!أجل أنا كذلك

336
00:20:21,240 --> 00:20:22,990
!انا رجلٌ حقاً

337
00:20:24,110 --> 00:20:26,570
!هذا شعرٌ مُستعارايضاً

338
00:20:27,370 --> 00:20:31,450
!ان كنتِ لا تُصدّقيني, جرّديني من الملابس او ايّا يكن

339
00:20:31,500 --> 00:20:34,710
!على ايّ حال, انا رجل

340
00:20:34,750 --> 00:20:37,920
شيراتوري - سان يائسة الآن

341
00:20:37,960 --> 00:20:39,050
...مستحيل

342
00:20:39,630 --> 00:20:42,590
كيف يُمكن لشخص لطيف ان يُصبح رجل؟

343
00:20:42,630 --> 00:20:48,220
أيعني هذا انّني فعلتُ هذا و ذاك لرجل؟

344
00:20:51,470 --> 00:20:53,100
تشيوري - تشان؟

345
00:20:53,140 --> 00:20:55,230
انّها بريئة جدًّا

346
00:21:03,880 --> 00:21:06,200
اين ذهبت تلك الفتاة؟

347
00:21:12,540 --> 00:21:16,750
يا رجل, كان البارحة يوماً شاقاً

348
00:21:17,210 --> 00:21:19,880
لا يُمكنني النّوم بسهولة بعد الآن

349
00:21:19,920 --> 00:21:22,710
لم يسبق لي ان ارتديت هكذا

350
00:21:25,050 --> 00:21:29,260
الصّور من البارحة اصبحت جاهزة, شيراتوري ريوكو - تشان

351
00:21:33,520 --> 00:21:37,190
كانت هذه صديقتك اذاً

352
00:21:38,940 --> 00:21:41,150
....هذه

353
00:21:44,240 --> 00:21:46,860
مازال لديّ الكثير

354
00:23:22,440 --> 00:23:25,570
يا ولد, يا لها من مُشكلة واجهناها اليوم

355
00:23:25,610 --> 00:23:28,320
كنتُ أرغب ان تتعامل تشيوري - تشان معي ايضاً

356
00:23:28,360 --> 00:23:32,080
انا أكره نفسي لإمتلاكي ذوق مثالي في الموضة

357
00:23:32,120 --> 00:23:32,790
...مهلاً, مهلاً

358
00:23:32,830 --> 00:23:34,450
الحلقة القادمة من ماهورابا
رسم

359
00:23:34,450 --> 00:23:36,880
!مُسابقة رسم ناروتاكيزو, ها نحن ذا