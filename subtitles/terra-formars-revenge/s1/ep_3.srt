1
00:00:02,110 --> 00:00:07,690
يتحرّك القسم الرّابع لتأمين هيزامارو أكاري
وميشيل ك.ديفيس كما هو مخطَّط

2
00:00:07,690 --> 00:00:11,910
وبالتالي، تلقّينا طلباً للمُساعدة

3
00:00:12,220 --> 00:00:16,130
يسيرُ كلّ شيء حالياً وفق المخطَّط

4
00:00:16,130 --> 00:00:19,220
علينا القضاء على كُلّ من يُقاومنا فحسب

5
00:00:19,220 --> 00:00:22,080
،كائنات التيرافورمار لم تقم بأي تحرُّكات بعد

6
00:00:22,080 --> 00:00:26,110
لِذا لا ينبغي أن تكون هُناك أي إعاقات للمهمّة
إن سارت الأمور على هذا الحال

7
00:00:26,110 --> 00:00:27,290
.جيّد

8
00:00:27,290 --> 00:00:28,980
،نحن، القسم الرّابع

9
00:00:28,980 --> 00:00:32,370
سنُلبِّي طلبَ المُساعدة كي نعزِّزَ حلفَنا

10
00:00:32,370 --> 00:00:36,130
ولنتجنَّب خطأ الدُّخول بشكل مُباشَر
سننقسمُ إلى فرقتَين

11
00:00:36,130 --> 00:00:38,340
...ويا ألكسندر

12
00:00:38,340 --> 00:00:39,280
.حاضر

13
00:00:39,990 --> 00:00:42,130
سأكلِّفُك بمهمّةٍ مختلفة

14
00:02:16,530 --> 00:02:18,880
أكاري وميشيل

15
00:02:19,480 --> 00:02:23,510
القسم الأمريكي-الياباني المُشترَك، القسم الثّاني
والذي تمَّ تعيينهما فيه قد وقعَ في فخّ

16
00:02:24,170 --> 00:02:26,800
خانَهم القسم الرّابع

17
00:02:28,010 --> 00:02:30,140
،رسموا خطّةً مُتقَنة

18
00:02:30,140 --> 00:02:33,330
.وحاولوا الحصول على جسديهما المميّزَين

19
00:02:34,190 --> 00:02:37,380
،لإيقافِهم، اقتحمَ القائدُ الغاضب

20
00:02:37,380 --> 00:02:40,880
.شوكيتشي كوماتشي، معسكرَ العدوّ

21
00:02:42,390 --> 00:02:44,180
!اسمعوا

22
00:02:48,990 --> 00:02:52,780
حقنتُ سمَّ دبُّور في جسدِ قائدكم هنا

23
00:02:54,510 --> 00:02:58,280
إنّه يتألّمُ كثيراً لدرجة يتمنّى فيها
لو كان ميّتاً ولدرجةِ عجزه التامّ عن الحركة

24
00:02:58,590 --> 00:03:00,390
،وإن تُرِكَ هكذا

25
00:03:01,550 --> 00:03:02,880
.سيموت

26
00:03:03,220 --> 00:03:05,660
.سيفقدُ بصرَه جرّاء السمِّ في عينيه

27
00:03:05,660 --> 00:03:07,450
.ستنتشرُ الغرغرينا في أطرافه

28
00:03:07,450 --> 00:03:11,070
وستتوقّفُ أعضاؤه الحيويّة وجهازه القلبي والرّئوي
عن العملِ بشكل سليم ومن ثمّ سيسقط

29
00:03:11,720 --> 00:03:14,030
سيموتُ على نحو بطيء ومُؤلم

30
00:03:14,640 --> 00:03:16,410
.لكن هنالِك ترياق

31
00:03:16,410 --> 00:03:18,220
.هذا هو سلاحي

32
00:03:18,720 --> 00:03:20,790
،لا أستطيعُ استخدامه في المهمّة إطلاقاً

33
00:03:21,260 --> 00:03:23,400
.وذلك هو سبب رتبتي المنخفضة

34
00:03:23,870 --> 00:03:25,880
.لكن عثرتُ أخيراً على مكانٍ أستخدمُه فيه

35
00:03:26,640 --> 00:03:29,230
!القسم الرّابع، استسلموا حالاً

36
00:03:32,080 --> 00:03:35,690
!لقد أمسكتُ بك يا دبُّور

37
00:03:36,720 --> 00:03:40,580
.يا بنو جلدتي، أطلبُ منكم ألّا تقلقوا عليّ

38
00:03:40,580 --> 00:03:42,590
!أطلِقوا على ساقيه

39
00:03:45,860 --> 00:03:46,880
!حاضر

40
00:03:58,370 --> 00:04:00,610
.التحوُّل البشريّ

41
00:04:01,420 --> 00:04:03,220
،كان ذلك ممتعاً

42
00:04:05,270 --> 00:04:06,710
.يا كابتن

43
00:04:07,420 --> 00:04:11,730
لكن سنربحُ هذه الحرب

44
00:04:13,060 --> 00:04:16,130
أرى أنّك غير معتاد على الخيانة

45
00:04:16,600 --> 00:04:19,910
.انظر إلى حجمِ المشروع الذي أنشأناه هُنا

46
00:04:19,910 --> 00:04:24,420
ألا تعتقد أنه سيكون من الأفضل لو افترضت
أنّ كلّ شيء ليسَ كما يبدو لك؟

47
00:04:25,110 --> 00:04:27,350
.تصنيفاتنا المرّيخية، تاريخنا

48
00:04:27,350 --> 00:04:29,260
.وحتّى قواعد العمليات الجراحيّة خاصّتنا

49
00:04:29,490 --> 00:04:33,980
.وحتّى أسُسُنا الجراحيّة المخصّصة لمُقاتلة البشر الآخرين

50
00:04:33,980 --> 00:04:36,670
...أساسي الجِراحي ليس أفعى الأناكوندا

51
00:04:36,670 --> 00:04:39,870
.مُحال أن يكون كذلك

52
00:04:40,390 --> 00:04:42,260
أساسي الجِراحي هو الأخطبوطُ ذو الحلقات الزرقاء

53
00:04:43,180 --> 00:04:46,800
.ومعروف بأنّه يحملُ سمَّ التيدرودوتاكسين والذي له قدرات شفائيّة

54
00:04:49,090 --> 00:04:52,070
يستطيعُ أخطبوطٌ واحدٌ أن يقتلَ بهذا السمّ
سبعة أشخاص

55
00:04:52,070 --> 00:04:55,080
لكن يمكنُ استخدامه أيضاً كمُسكِّن ألم
.في المجال الطبِّي

56
00:04:55,470 --> 00:04:59,630
أكان من المُفترَض أن يتركَني سمُّ دبُّورك
أتلوّى من الألم؟

57
00:05:00,470 --> 00:05:03,450
لا أشعر بشيء البتّة

58
00:05:03,450 --> 00:05:04,760
...والآن

59
00:05:06,720 --> 00:05:10,800
أريدُ مُداواة جراح الكابتن، سنحتفظُ به كرهينة

60
00:05:11,120 --> 00:05:12,240
.هونغ-تشان

61
00:05:12,240 --> 00:05:14,520
أحضري إليّ الأوّل مجدداً

62
00:05:14,520 --> 00:05:15,750
!حـ-حاضرة

63
00:05:15,750 --> 00:05:17,480
.سأفعلُ ذلك حالاً، حالاً

64
00:05:18,390 --> 00:05:20,540
.لا أملك أي قيمة كرهينة

65
00:05:20,960 --> 00:05:21,950
ماذا؟

66
00:05:22,340 --> 00:05:23,910
ماذا...؟

67
00:05:25,620 --> 00:05:28,280
حضرة القائد ليو، يبدو وكأنّهم يهربون

68
00:05:32,480 --> 00:05:34,090
من يوجدُ على المتن؟

69
00:05:34,090 --> 00:05:36,310
.أنا آسفة، لا أدري

70
00:05:36,850 --> 00:05:39,150
الظرف الأسوأ هو إذا كان

71
00:05:39,150 --> 00:05:42,590
ميشيل وأكاري هما الوحيدان اللّذان
يقودان الوحدة 1 والوحدة 2

72
00:05:43,080 --> 00:05:44,010
صحيح؟

73
00:05:44,470 --> 00:05:47,200
هنالِك كثير من الوسائل لإيقافهم

74
00:05:47,200 --> 00:05:51,090
.يعرفون ما عليهم فعله

75
00:05:51,540 --> 00:05:52,590
.ابتعدوا

76
00:05:52,900 --> 00:05:54,180
.أعيدوا تنظيم أنفسكم

77
00:05:54,600 --> 00:05:56,780
...ما لم يحظوا بفُرصة لرسم خطّة جديدة

78
00:05:57,830 --> 00:06:00,630
.لن يعودوا

79
00:06:00,630 --> 00:06:04,240
.مهما نقلتَ إليهم صرخاتي

80
00:06:06,050 --> 00:06:09,010
بما أنّك تقولُ كلّ هذا الكلام فأظنُّك على حقّ

81
00:06:09,620 --> 00:06:11,470
.لكن لستَ مضطرّاً للادِّعاء

82
00:06:12,640 --> 00:06:15,620
،إن كنتَ مستعدّاً لمُساعدتي في هذه المُفاوضات

83
00:06:17,440 --> 00:06:22,200
فسألتزمُ بالعفو عن حياتك يا كابتن

84
00:06:22,690 --> 00:06:25,610
،لطالما كنتَ الرّجُل الفُكاهي

85
00:06:26,440 --> 00:06:27,810
يا ليو-سان

86
00:06:31,460 --> 00:06:33,720
نعم، كنتُ أمزح

87
00:06:33,720 --> 00:06:36,260
عرفتُ أنّك ستقولُ ذلك

88
00:06:37,390 --> 00:06:41,530
لهذا لا يمكن أن تكون أكثر من مزحة

89
00:06:51,450 --> 00:06:54,250
حسناً، لقد أدّيت دورك بسُرعة يا باو-كن

90
00:06:54,250 --> 00:06:55,910
أنا آسف

91
00:06:55,910 --> 00:06:58,050
قال الكابتن أنّه لم يكن يحمل
أي قيمة كرهينة

92
00:06:58,670 --> 00:07:02,130
وأيضاً أثناء حديثنا معه، كانَتْ
أهدافنا تبتعدُ أكثر فأكثر

93
00:07:02,430 --> 00:07:03,820
معك حقّ

94
00:07:04,630 --> 00:07:08,070
لم يتغيّر وضعُنا كثيراً

95
00:07:08,800 --> 00:07:11,120
أرسِلوا تحذيرنا الأخير للوحدة 1

96
00:07:11,120 --> 00:07:13,510
إن لم يستجيبوا فسنُسقِطُ الوحدة 2

97
00:07:14,130 --> 00:07:15,110
ماذا؟

98
00:07:15,760 --> 00:07:20,710
باو-سان، لماذا استخدمت البطّارية
الثّابتة لتُطلِق عليه؟

99
00:07:20,710 --> 00:07:21,770
...في الحقيقة

100
00:07:22,260 --> 00:07:26,010
أليس من المُفترَض أن تستخدمها
على كائناتِ التيرافورمار المتحرِّكة؟

101
00:07:26,010 --> 00:07:27,650
ماذا؟

102
00:07:27,650 --> 00:07:28,520
!هونغ

103
00:07:29,010 --> 00:07:29,880
!لا تستنشقيها

104
00:07:30,150 --> 00:07:31,450
!إنّه سلاح كيميائي

105
00:07:32,850 --> 00:07:34,670
...اللّعنة! متى قد

106
00:07:34,990 --> 00:07:36,720
...منذُ متى ونحن

107
00:07:36,720 --> 00:07:38,590
نرى هذا الوهم؟...

108
00:07:38,940 --> 00:07:40,060
!حضرة القائد ليو

109
00:07:40,060 --> 00:07:43,020
!جثّة الكابتن كوماتشي ليسَتْ هناك

110
00:07:44,260 --> 00:07:47,220
المُشكلة لا تكمُن في المدّة التي مضَتْ
...منذُ رؤيتنا لهذا الوهم

111
00:07:47,220 --> 00:07:48,620
...هذه الكثافة

112
00:07:48,620 --> 00:07:51,240
لو لم تُلاحظ باركي، لوقَعْنا في ورطة

113
00:07:51,960 --> 00:07:54,560
يُحاولون قتلنا

114
00:07:54,560 --> 00:07:56,630
...مُهاجمتهم لنا بهذا الشّكل تعني

115
00:07:57,340 --> 00:08:01,180
...أنّه يوجدُ جنودٌ غيرنا هُنا

116
00:08:01,180 --> 00:08:03,260
هذا الغازُ هو السّلاح رقم 10

117
00:08:08,100 --> 00:08:09,610
روسيا؟

118
00:08:10,390 --> 00:08:11,420
إيفان

119
00:08:12,350 --> 00:08:14,840
ما الذي يحلمون به برأيك؟

120
00:08:22,460 --> 00:08:23,630
!كابتن

121
00:08:28,770 --> 00:08:31,010
...شكراً جزيلاً لكما

122
00:08:33,230 --> 00:08:36,120
.لا داعي لتشكرينا

123
00:08:37,720 --> 00:08:38,520
...لحظة

124
00:08:39,910 --> 00:08:41,190
ماذا؟

125
00:08:41,190 --> 00:08:43,810
توجدُ مركّباتٌ هنا من نباتِ الداتورا الماثِلة

126
00:08:44,160 --> 00:08:49,280
تحتوي على مخدِّر أيضاً، لِذا ينبغي
أن يخفّف الألم قليلاً

127
00:08:49,650 --> 00:08:50,970
شكراً لك

128
00:08:51,350 --> 00:08:54,520
إذا أضفتُ منها الكثير، فستبدئين
برُؤية أشياء غريبة

129
00:08:54,520 --> 00:08:59,330
يعتمدُ ذلك على الشّخصِ نفسه
لكن في الأغلب، ستشرُدين

130
00:08:59,970 --> 00:09:04,000
وأولئك الذين لا يتحرّكون كثيراً يرون أحلاماً
سعيدة على ما أظنّ

131
00:09:04,480 --> 00:09:05,610
...نفَق

132
00:09:05,610 --> 00:09:07,440
يحفرون نفقاً؟

133
00:09:07,440 --> 00:09:08,890
!كيف حالُ الصّواريخ؟

134
00:09:08,890 --> 00:09:09,910
!إنّها سليمة

135
00:09:09,910 --> 00:09:12,030
ما زلنا نصوّبُ على الوحدة 1 و 2

136
00:09:12,660 --> 00:09:14,390
هذا سيئ يا حضرة القائد

137
00:09:14,390 --> 00:09:16,520
...وجود نفق هنا يعني

138
00:09:16,520 --> 00:09:19,640
لا، لا ينبغي أن تكون لديهم أي متفجِّرات

139
00:09:20,140 --> 00:09:22,620
...ما علينا أن نقلق بشأنه هو أعدادهم الآن

140
00:09:22,620 --> 00:09:24,550
!حضرة القائد، إنّهم قادمون

141
00:09:24,550 --> 00:09:26,440
!زينغ، أطلِق إحدى تِلك الصواريخ هُنا

142
00:09:26,810 --> 00:09:28,650
...لكن الدّرع المُضادّ الجويّ سوف

143
00:09:28,650 --> 00:09:29,530
!بسُرعة

144
00:09:29,530 --> 00:09:30,540
.فات الأوان

145
00:09:30,540 --> 00:09:31,520
.إنّه هناك

146
00:09:32,240 --> 00:09:33,710
.اختبئوا

147
00:09:34,620 --> 00:09:38,060
إنّه ليسَ أكثر من سِلاح دفاعي محدود المدى

148
00:09:38,060 --> 00:09:39,790
حسناً، نحنُ في حرب

149
00:09:39,790 --> 00:09:41,510
...إن كان بمقدورنا فعل ما نشاء

150
00:09:42,010 --> 00:09:43,890
فالتّدمير هو أبسط شيء

151
00:10:16,580 --> 00:10:18,800
هكذا إذاً

152
00:10:19,190 --> 00:10:22,400
أظنُّه العام الصينيّ الجديد

153
00:10:27,750 --> 00:10:31,460
تسرُّني رؤيتكم يا حُلفائي الزُملاء

154
00:10:38,220 --> 00:10:40,090
اعتباراً من اليوم، يشرّفنا أن نعلن بأنّنا

155
00:10:40,090 --> 00:10:43,440
جيش فضاء الاتِّحاد الرُّوسي، حُلفاء
حُلفاء للقوّات الأمريكيّة-اليابانيّة

156
00:10:50,320 --> 00:10:52,040
حضِّروا أنفسكم

157
00:10:58,490 --> 00:11:01,880
،حالما نتأكّد من توجُّه كاناكو نحو القسم الثّالث

158
00:11:01,880 --> 00:11:03,530
.سوف نُقلِع

159
00:11:04,730 --> 00:11:06,870
.اجتمع مع القسم السّادس

160
00:11:06,870 --> 00:11:08,050
القسم السّادس؟

161
00:11:08,050 --> 00:11:09,750
قائد الفرقة هو جوزيف

162
00:11:09,750 --> 00:11:11,980
.لن نُهزَم بهذه السّهولة

163
00:11:19,840 --> 00:11:25,260
لم أكن أريدُ الاعتماد كثيراً على جوزيف
لكن لا خيار آخر لدينا

164
00:11:28,800 --> 00:11:30,230
لقد بدأت

165
00:11:30,230 --> 00:11:32,020
...لقد أتوا إلينا فعلاً

166
00:11:32,490 --> 00:11:34,850
...القسم الرّوسيّ والأوروبّيّ الشّماليّ رقم 3

167
00:11:34,850 --> 00:11:38,320
أفكِّرُ بإطلاقِ بعض الصّواريخ نحوكم

168
00:11:38,800 --> 00:11:40,250
!ماذا يجدرُ بنا أن نفعل إذاً؟

169
00:11:40,530 --> 00:11:45,010
إن كانوا يستهدفونني أنا وميشيل، فلن يدعونا وشأننا إذاً

170
00:11:45,310 --> 00:11:48,850
إنّهم يعملون على شحنِ الأسلحة

171
00:11:48,850 --> 00:11:51,320
.لا يمكنُنا الاقتراب منهم أو الهرب

172
00:11:51,320 --> 00:11:52,630
سنطلبُ التّعزيزات

173
00:11:52,630 --> 00:11:53,520
تعزيزات؟

174
00:11:53,780 --> 00:11:57,640
إن كنت تعني أنّ القسم 3 لن يفي بالغرض

175
00:11:57,640 --> 00:12:00,420
فلا سبب لانضمامِهم إلينا إذاً

176
00:12:00,420 --> 00:12:05,070
أظنُّ أنّ القسم 3 أقرب كحلف
مُقارنةً بالقسم 4

177
00:12:05,070 --> 00:12:07,630
.لكن قد تطرأ تغييرات

178
00:12:07,960 --> 00:12:09,760
ما الذي يجري في الأرضِ إذاً؟

179
00:12:09,760 --> 00:12:10,500
.كاناكو

180
00:12:10,500 --> 00:12:11,230
.حاضرة

181
00:12:11,710 --> 00:12:13,320
سأكسبُ لأنفُسِنا وقتاً

182
00:12:13,320 --> 00:12:16,990
أريدُكِ أن تستفيدي من ذلك الوقت وتطلبي
المُساعدة من القسم 3 الذي يقترِبُ منّا

183
00:12:18,820 --> 00:12:21,470
لقد أتوا يا كابتن

184
00:12:22,700 --> 00:12:25,540
ذلك القِناع ليس مُنصِفاً جداً

185
00:12:25,540 --> 00:12:28,800
لولاه لكنّا قد ربِحنا ولكانَ غاز رَجُلي إيفان

186
00:12:28,800 --> 00:12:31,060
.قد حسمَ هذه المسألة

187
00:12:31,060 --> 00:12:35,120
يبدو أنّ قدمك اليُسرى قد شُفيَتْ بما أنّك
لا ترتدي بها شيئاً

188
00:12:35,120 --> 00:12:37,820
لو كان أساسك الجِراحيّ أناكوندا
لما تمكّنتَ من الشِّفاء

189
00:12:38,370 --> 00:12:40,720
،لقد تبدّدَ غازُ إيفان

190
00:12:40,720 --> 00:12:44,040
لكن لا يزالُ يرتدي قِناعاً، لا بدّ وأنه من القشريّات

191
00:12:44,620 --> 00:12:50,650
وحقيقة عدم خلعه لقِناعِه تعني
أنّك تفرزُ سُمَّ ذيفان الكبد

192
00:12:52,460 --> 00:12:55,580
لافتراسِ القشريّات، حيثُ يكون التيدرودوتاكسين غير فعّال

193
00:12:55,580 --> 00:12:58,890
يمكنُك أن تحمل سمّاً آخراً فعّالاً
وهو سمّ ذيفان الكبد

194
00:12:58,890 --> 00:13:00,240
...بعبارة أخرى

195
00:13:00,650 --> 00:13:04,290
من الواضح بأنّ أساسك الجِراحيّ هو
أخطبوط ذو حلقات زرقاء

196
00:13:04,840 --> 00:13:08,080
وأساسك هو سلطعان أيُّها القشريّ

197
00:13:08,450 --> 00:13:10,620
.السّلطعان التاسماني العُملاق

198
00:13:10,620 --> 00:13:14,100
وعلى أي حال سأقعُ في ورطة كبيرة
...إذا جلستُ هُنا ودردشتُ معك

199
00:13:14,680 --> 00:13:19,210
كلّ ما عليّ فعله لتجنُّب المُشكلة هو هذا

200
00:13:20,410 --> 00:13:23,060
...لم أكُن أنوي القيام بهذا رغبة منِّي، لكن

201
00:13:23,540 --> 00:13:26,500
...أنتُم من

202
00:13:31,080 --> 00:13:32,470
...هذا

203
00:13:32,470 --> 00:13:36,810
...علَّموا الحشرات كلّ هذا الكمّ

204
00:13:37,660 --> 00:13:39,760
أشعلتُم هذه الحرب...

205
00:13:46,330 --> 00:13:47,910
الأمر الصوتي: باو

206
00:13:53,830 --> 00:13:54,990
!الإطلاق في الوضع اليدوي

207
00:13:57,850 --> 00:13:58,950
اللّعنة

208
00:14:19,890 --> 00:14:20,750
.مستحيل

209
00:14:20,750 --> 00:14:23,740
القشريّات أكثر ثخانة منّا

210
00:14:24,250 --> 00:14:25,740
ممّا هو مصنوع؟

211
00:14:52,070 --> 00:14:53,910
!أيُّها الفتيان الأوغاد

212
00:14:53,910 --> 00:14:56,450
!كادت تدخل إحداها في عينيّ

213
00:15:00,490 --> 00:15:01,990
...وحش

214
00:15:02,950 --> 00:15:04,650
،يا أيُّها الجيش الرُّوسي

215
00:15:05,720 --> 00:15:07,640
لماذا غيّرتُم ولائكم؟

216
00:15:32,770 --> 00:15:35,980
هدفُنا الأوّل هو أسرُ هيزامارو أكاري

217
00:15:35,980 --> 00:15:39,920
صُنِعَ ليمتلك عضواً حيوياً فُسيفسائياً

218
00:15:40,390 --> 00:15:42,480
سنحصلُ على ميشيل ك.ديفيس كاحتياط

219
00:15:43,210 --> 00:15:48,140
كي نفهم تِلك التقنيّة، يجبُ علينا
فحص أجسامهم

220
00:15:48,780 --> 00:15:52,290
.ظننتُ أنّ لروسيا نفس الهدف

221
00:15:52,290 --> 00:15:56,260
لهذا كنّا قد طلبنا منكم المُساعدة
في تنفيذ الخطّة دلتا

222
00:15:56,260 --> 00:15:59,770
.لم يتغيّر هدفُنا على الإطلاق

223
00:15:59,770 --> 00:16:03,350
أتينا إلى هُنا لإبادةِ فيروس أ-ي في الأرض

224
00:16:03,980 --> 00:16:08,370
أرى أنّه من الأفضل لكم على الأقلّ
أن تُساعدونا

225
00:16:08,370 --> 00:16:11,580
في خطّتِنا المبدئيّة وهي أسر هيزامارو-كُن

226
00:16:17,050 --> 00:16:21,250
أظنُّنا ينبغي أن نتولّى القيادة في إنقاذ
أولئك الذين في كوكب المرّيخ

227
00:16:21,250 --> 00:16:25,480
جهّزْنا سفينةَ إنقاذ مُحمَّلة بأسلحة تكتيكيّة

228
00:16:26,470 --> 00:16:30,100
وبالطبع سنُتابعُ مهمّة أنّيكس-1

229
00:16:30,620 --> 00:16:32,920
ليس بعد يا شيتشيسي؟

230
00:16:38,250 --> 00:16:41,690
هيوغا-كُن، سوميا-كُن، اتركاه يستقلُّ السيّارة

231
00:16:42,270 --> 00:16:43,380
شيتشيسي-سان

232
00:16:43,510 --> 00:16:44,520
من هُم؟

233
00:16:44,520 --> 00:16:46,650
روسيّون على ما أعتقد

234
00:16:46,650 --> 00:16:47,500
هكذا إذاً

235
00:16:47,500 --> 00:16:49,460
كان ذلك وشيكاً

236
00:16:49,460 --> 00:16:54,000
كانَتْ كافّة مُختبرات أبحاث الدُّول المستقلّة
تمتلكُ كفاءة سيّئة

237
00:16:54,000 --> 00:16:58,260
أعتقدُ أنه سيكون من الحكمةِ تأسيس
منظَّمة مُشترَكة

238
00:16:58,260 --> 00:16:59,730
ما رأيكم؟

239
00:17:03,970 --> 00:17:05,210
شيتشيسي؟

240
00:17:05,210 --> 00:17:06,190
نعم

241
00:17:06,710 --> 00:17:07,980
هكذا إذاً

242
00:17:07,980 --> 00:17:11,170
هلّا تكلّمتُ معه من فضلك؟

243
00:17:11,780 --> 00:17:13,800
لم أرك منذُ مدّة يا دكتور

244
00:17:13,800 --> 00:17:15,760
شكراً لك على كلّ شيء

245
00:17:15,760 --> 00:17:16,890
وداعاً

246
00:17:16,890 --> 00:17:20,540
سيوفِّرُ بلدي المالَ والمراكز

247
00:17:20,540 --> 00:17:22,220
...بمقدور كلّ بلد

248
00:17:22,220 --> 00:17:24,190
لقد قمنا بتأمينِ هوندا كو

249
00:17:27,580 --> 00:17:30,500
!ما-ماذا قلت يا هيروما-سان؟

250
00:17:32,830 --> 00:17:34,570
البروفيسور هوندا

251
00:17:34,570 --> 00:17:36,350
الشّخص الذي صنعَ هيزامارو أكاري

252
00:17:36,350 --> 00:17:37,920
!هذا مستحيل

253
00:17:38,890 --> 00:17:42,720
.سمعتُ أنّ البروفيسور هوندا قد قُتِلَ منذُ 20 عاماً

254
00:17:42,720 --> 00:17:44,920
.تكلّمتُ معه بنفسي للتو

255
00:17:44,920 --> 00:17:46,740
.بدا بخير بالنسبةِ لي

256
00:17:52,330 --> 00:17:53,580
.هذا كُل ما كان عليّ قوله

257
00:17:53,580 --> 00:17:55,500
.آسِف للمُقاطَعة

258
00:17:55,500 --> 00:17:56,700
.انتظر

259
00:17:57,110 --> 00:17:59,350
أهذا كلّ شيء؟

260
00:18:00,360 --> 00:18:01,620
.هكذا إذاً

261
00:18:02,250 --> 00:18:03,690
تبدو المعلومات صحيحة

262
00:18:04,520 --> 00:18:07,910
الأمور في تغيُّر دائم

263
00:18:09,440 --> 00:18:13,410
ما دمتُم تتّخذون أنّيكس معقلاً، من المُستحيل
أن نكون حُلفاء

264
00:18:13,410 --> 00:18:15,850
.لا يهمّني ما يحدث في الأرض

265
00:18:15,850 --> 00:18:20,270
إن اصطففتُم إلى جانب الأمريكيين واليابانيين
فلن نتحفَّظ أبداً

266
00:18:20,970 --> 00:18:25,790
،تبدو متغطرساً جدّاً بقولِك هذا الكلام

267
00:18:25,790 --> 00:18:28,450
لكن أعتقدُ أنّ كلّ أسلحتكم الرّائعة
قد دُمِّرَتْ

268
00:18:28,450 --> 00:18:31,570
.الأسلحة النّارية لا تؤثِّر بك

269
00:18:31,570 --> 00:18:35,370
إن كنّا مضطرِّين للقيامِ بهذا فسوف أُقاتِلُك

270
00:18:35,710 --> 00:18:38,510
!هل تعلمُ أتباعَ من قد قتَلْت؟

271
00:18:39,170 --> 00:18:41,630
أعطوا الخوَنة الإشارة أ

272
00:18:41,630 --> 00:18:44,100
!سنستعيدُ مركزَ أبحاث أنّيكس

273
00:18:44,330 --> 00:18:45,260
!دا

274
00:18:45,640 --> 00:18:47,760
ها نحنُ ذا يا رجُل الكينبو

275
00:18:48,970 --> 00:18:52,240
تعالَ إليّ يا رجُل الجودو دان 100

276
00:18:52,240 --> 00:18:54,160
!قُلْ دان 7

277
00:18:55,060 --> 00:18:57,090
!اتركوا الزعيمَين يُقاتلان بعضهما الآخر

278
00:18:57,090 --> 00:18:58,630
!لن أدع أحداً يتدخّل

279
00:18:59,410 --> 00:19:02,130
يتغذّى الأخطبوط على السّلطعان

280
00:19:02,130 --> 00:19:05,270
!لا تطبِّق سياسةَ الأرض في المرّيخ

281
00:19:28,130 --> 00:19:29,820
قشريّ؟ خنفساء؟

282
00:19:29,820 --> 00:19:32,240
لا، نوع ما من الحَريش أو ما شابه؟

283
00:19:35,420 --> 00:19:37,880
قشرة هذا الرّجل تُبطِل أي شكل من أشكال الهجوم

284
00:19:37,880 --> 00:19:39,770
.لكن المفاصِل ضعيفة

285
00:19:39,770 --> 00:19:42,300
أو أستطيعُ انتظار السمّ حتّى يأخذ
مفعوله فحسب

286
00:19:44,680 --> 00:19:47,190
أي هجمة نحو المفاصِل لن تنجح

287
00:19:47,720 --> 00:19:52,010
لكن أي قبض أو إصابة للحبل الشّوكي سينجح

288
00:19:59,690 --> 00:20:00,710
.هذا سيئ

289
00:20:00,710 --> 00:20:02,120
.إنّه أفضل ممّا توقّعت

290
00:20:02,550 --> 00:20:06,960
في هذه الحالة، لن أصمد قبل أن يأخذ
السمُّ مفعوله

291
00:20:15,350 --> 00:20:16,970
!حان وقتُ الافتراس

292
00:20:22,840 --> 00:20:23,820
رغوة؟

293
00:20:28,770 --> 00:20:29,980
أنا على ظهره؟

294
00:20:33,120 --> 00:20:34,570
...كتلته

295
00:20:35,040 --> 00:20:36,280
انخفضَتْ؟

296
00:21:03,300 --> 00:21:05,480
.دمّرتُ قناتكما الهلاليّة

297
00:21:05,480 --> 00:21:07,930
استلقيا وادّعيا أنّكما لا تستطيعان القتال فحسب

298
00:21:12,750 --> 00:21:14,520
فا جين؟

299
00:21:15,150 --> 00:21:19,700
يبدو أنّكم ظننتُم أنّ جميعنا مهندسين
نعتمدُ على الأسلحة فحسب

300
00:21:20,160 --> 00:21:22,590
.أتيتُم إلى هنا وخنتمونا

301
00:21:22,590 --> 00:21:26,090
السّببُ الوحيدُ وراء عدم استسلامنا، رُغم

302
00:21:26,090 --> 00:21:28,770
خسارة حلفنا معكم أيُّها القسم الثّالث

303
00:21:29,260 --> 00:21:31,020
.هو أنّنا نستطيعُ الفوز بمفردنا

304
00:21:33,600 --> 00:21:34,330
!آرون

305
00:21:34,330 --> 00:21:35,420
!نينا

306
00:21:40,050 --> 00:21:41,540
ما الأمر؟

307
00:21:41,540 --> 00:21:43,460
يبدو أنّك تعاني من بعض المشاكل

308
00:21:48,470 --> 00:21:51,650
ستكونُ الأمور على ما يُرام يا أبي

309
00:21:53,270 --> 00:21:54,940
!أيُّها الخوَنة

310
00:21:54,940 --> 00:21:57,620
أنتُم من خنتمونا

311
00:21:58,330 --> 00:22:02,500
!خنتُم البشريّة