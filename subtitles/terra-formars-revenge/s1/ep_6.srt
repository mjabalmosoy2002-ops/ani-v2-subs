1
00:00:01,630 --> 00:00:03,730
،مع استمرار المعركة ثلاثية الأطراف

2
00:00:03,730 --> 00:00:07,530
تنضحُ هونغ الجراثيم كي تحمي أنّيكس 1

3
00:00:08,970 --> 00:00:11,520
ويُرغَم القسم 3 على التّراجُع

4
00:00:12,100 --> 00:00:13,810
!تراجعوا جميعاً

5
00:00:16,490 --> 00:00:19,190
لكن يدخلُ ألكسندر بمُفرده في مهمّةٍ انتحاريّة

6
00:00:19,190 --> 00:00:21,990
لأجلِ الأميرة النّائمة التي تنتظرُ عودته

7
00:00:24,370 --> 00:00:28,760
يُلحِقُ تصرُّفه المتهوِّر ضرراً جسيماً بالقسم 4

8
00:00:43,690 --> 00:00:44,460
هونغ-تشان

9
00:00:44,460 --> 00:00:45,800
حـ-حاضر؟

10
00:00:45,800 --> 00:00:49,380
،حالما ننتهي من مُعالجة شي-سان والآخرين

11
00:00:49,850 --> 00:00:51,320
.سنتبعُ الثّاني

12
00:00:51,710 --> 00:00:53,610
.ابقي أنتِ هنا

13
00:00:54,230 --> 00:00:55,900
هنالِك كثيرٌ من الطعام

14
00:00:55,900 --> 00:00:57,600
استخدمي قدرَ ما تستطيعين من المخدِّر

15
00:00:57,600 --> 00:00:59,240
دون حرق نفسكِ للحِفاظِ على عملِ الجراثيم

16
00:00:59,590 --> 00:01:01,050
...حـ-حسناً

17
00:01:01,050 --> 00:01:02,380
...المعذرة

18
00:01:02,380 --> 00:01:03,690
.معك حقّ

19
00:01:05,250 --> 00:01:07,210
ما الأمر يا هونغ؟

20
00:01:07,630 --> 00:01:11,990
لا يخطر على ذهنكِ الصّغير هذا أيّة أفكار، أليس كذلك؟

21
00:01:13,160 --> 00:01:16,360
فعلتِ ما بوسعكِ لحمايتنا

22
00:01:16,890 --> 00:01:20,760
وبالتّالي فعلنا ما بوسعنا لحمايتكِ

23
00:01:20,760 --> 00:01:22,330
هذا كُل ما في الأمر

24
00:01:24,750 --> 00:01:26,460
سيستغرقُ مُعالجتهم بعضاً من الوقت

25
00:01:27,020 --> 00:01:28,650
.لا تتأخّروا عندما نُغادِر

26
00:01:29,470 --> 00:01:33,750
لقد فُصِلَ الأوّل والثاني عن الكابتن كوماتشي

27
00:01:33,750 --> 00:01:36,870
آملُ ألّا تكون التيرافورمارس قد فرّقتْهما وأسرَتْهما

28
00:01:38,250 --> 00:01:40,380
اتّصل بالوحدة 1 والوحدة 2

29
00:01:40,380 --> 00:01:41,410
حاضر

30
00:03:25,580 --> 00:03:28,790
سلِّموا الأوّل والثّاني

31
00:03:29,330 --> 00:03:32,330
أو سنقصفُكم بذلك الصّاروخ

32
00:03:36,520 --> 00:03:40,680
أليسَتْ طريقة القسم 4 في العمل
تستفزُّكِ يا ميشيل-سان؟

33
00:03:41,790 --> 00:03:44,360
،إنّهم يستهدفوننا نحنُ الاثنَين

34
00:03:44,360 --> 00:03:47,590
فكيف لكِ أن تكوني هادئة؟

35
00:03:48,600 --> 00:03:50,230
.إنّه الفرقُ في مُستوى عزيمتنا

36
00:03:51,210 --> 00:03:54,170
خطط القسم 4 الغبيّة لا تعنيني

37
00:03:54,570 --> 00:03:58,140
أتيتُ إلى هُنا وأمتلِك عزيمةً ثابتة

38
00:03:58,860 --> 00:04:00,000
عزيمة؟

39
00:04:02,270 --> 00:04:03,510
...وأنا أيضاً

40
00:04:08,130 --> 00:04:09,410
ما-ماذا؟

41
00:04:12,750 --> 00:04:13,910
ما الأمر؟

42
00:04:13,910 --> 00:04:15,550
!ا-انظر

43
00:04:36,560 --> 00:04:37,520
ميشيل

44
00:04:42,030 --> 00:04:42,960
ميشيل؟

45
00:05:07,150 --> 00:05:08,450
...بارابونيرا

46
00:05:21,820 --> 00:05:23,970
هل استيقظت يا كابتن؟

47
00:05:25,730 --> 00:05:27,730
...المعذرة يا كابتن

48
00:05:28,200 --> 00:05:30,800
آسِف على تصرُّفي من تلقاء نفسي

49
00:05:31,480 --> 00:05:33,050
لقد تصرّفت بشكلٍ صحيح

50
00:05:33,050 --> 00:05:35,100
كلّ الأقسام هكذا

51
00:05:35,100 --> 00:05:38,040
على الأقلّ، أنقذتَني عندما كنتُ بحاجة

52
00:05:38,040 --> 00:05:39,090
شكراً

53
00:05:39,870 --> 00:05:41,290
هل أتيتُم جميعاً؟

54
00:05:41,660 --> 00:05:42,830
نعم

55
00:05:42,830 --> 00:05:44,340
ابني قد مات

56
00:05:48,110 --> 00:05:49,530
الأحمق

57
00:05:50,170 --> 00:05:52,210
،مهما كان ذلك مُحبِطاً بالنسبةِ له

58
00:05:52,210 --> 00:05:54,490
...مهما كنّا قريبين من أنّيكس 1

59
00:05:54,890 --> 00:05:58,450
...حتّى لو كان الظرفُ بأكمله جنونيّاً

60
00:05:59,050 --> 00:06:01,470
يبقى الموت خرقاً للأوامر، صحيح؟

61
00:06:09,260 --> 00:06:10,330
...والآن

62
00:06:19,300 --> 00:06:23,800
!عليّ أن أصنع اللُّقاح ولو على جثّتي

63
00:06:25,410 --> 00:06:26,340
...كابتن

64
00:06:26,710 --> 00:06:29,980
سأخبرُك بما يجري وعن كلّ ما أعرفه

65
00:06:30,520 --> 00:06:34,350
عمليّة العضو الفُسيفسائي ذات النّوع الجرثوميّ
...التي أُجريَتْ على تلك الفتاة

66
00:06:34,860 --> 00:06:38,390
ربّما كانَتْ تكنولوجيا طوّرَها مكتبُ الفرع 4
بشكل مُستقلّ

67
00:06:38,980 --> 00:06:41,300
...سِلاح حيويّ شبيه بالإنسان

68
00:06:41,300 --> 00:06:42,240
هذا صحيح

69
00:06:42,240 --> 00:06:44,390
،حالما يقتربُ من الهدف

70
00:06:44,390 --> 00:06:47,140
يستطيعُ تنفيذ القتل أو الإرهاب حسبما يشاء

71
00:06:47,700 --> 00:06:49,730
وبقيّتهم قد خضعوا ربّما لعمليّات

72
00:06:49,730 --> 00:06:52,940
جراحيّة شاذّة غريبة ما مختلِفة عن عمليّاتنا

73
00:06:53,730 --> 00:06:55,820
حتّى بأشكالهم العاديّة كانوا يمتلِكون قوّة

74
00:06:55,820 --> 00:06:58,170
مُكافِئة تقريباً لقوّتهم بعد التحوُّل

75
00:06:59,670 --> 00:07:04,340
لكن هذا يعني أنّهم لا يستطيعون
العيش في الحياة اليوميّة

76
00:07:04,910 --> 00:07:06,220
يمكنُني أن أتخيّل أنّ مجرّد

77
00:07:06,220 --> 00:07:09,060
قضاء ليلة في نفس الغرفة
مع النّوع الجرثوميّ

78
00:07:09,060 --> 00:07:11,650
.سيكونُ كافياً للإصابة بمرض

79
00:07:11,650 --> 00:07:13,620
لن يكون شخصاً ذو حواس مُعزَّزة بقادِر

80
00:07:13,620 --> 00:07:16,290
على الاستمتاع بالرّوائح أو الموسيقا
المُوجَّهة للبشر

81
00:07:16,630 --> 00:07:18,660
...إ-إنّهم إذاً

82
00:07:18,980 --> 00:07:20,020
نعم

83
00:07:20,020 --> 00:07:23,960
:لكسبِ تِلك القوّة، تخلّوا عن أملِنا الوحيد

84
00:07:23,960 --> 00:07:27,080
العَيش حياة طبيعيّة بعدما نعودُ إلى الأرض

85
00:07:27,980 --> 00:07:29,720
إنّهم أقوياء

86
00:07:30,800 --> 00:07:33,610
،لقد جعلوا من كافّة الأقسام الأخرى أعداء لهم

87
00:07:33,610 --> 00:07:35,570
وتخلّوا حتّى عن مُستقبلهم

88
00:07:35,990 --> 00:07:39,650
هل هُم مُستميتون للحصولِ عليهما إلى هذا الحدّ؟

89
00:07:39,650 --> 00:07:41,210
ربّما

90
00:07:41,620 --> 00:07:44,750
وُلِدَ ذلكما الاثنان بأعضاء فُسيفسائيّة

91
00:07:46,940 --> 00:07:49,980
كانَت الضابطة التنفيذيّة ديفيس
مُعجِزة طبيعيّة

92
00:07:50,340 --> 00:07:53,020
ليسَتْ اصطناعيّة

93
00:07:53,530 --> 00:07:56,530
لكن هيزامارو أكاري مسألة أخرى

94
00:07:57,090 --> 00:07:59,520
من الواضِح بأنّه اصطناعي

95
00:07:59,930 --> 00:08:03,040
لا بدَّ من وجود وسيلة لجعلِ الأعضاء
الفُسيفسائيّة شيئاً مُتوارَثاً

96
00:08:03,880 --> 00:08:06,300
إن كان من المُمكِن صنع إنسان قادِر
على الخضوع لعمليّة زرع عضو

97
00:08:06,300 --> 00:08:07,800
فُسيفسائي جراحيّة بنجاح

98
00:08:07,800 --> 00:08:10,680
!لوُجِدَتْ تِلك التّكنولوجيا بعد عشرين عاماً على الأكثر

99
00:08:11,340 --> 00:08:13,440
!جيش مُؤلَّف من مئة جندي سُلطعاني

100
00:08:13,440 --> 00:08:16,410
ومئة جاسوس قادر على التحكُّم بالكهرباء

101
00:08:16,410 --> 00:08:19,370
بل ويمكنُك صنع سياسيّ لا يتأثَّر بالسمّ

102
00:08:19,620 --> 00:08:22,750
والإمكانيّات الطبّية لا حدود لها بالطبع كذلك

103
00:08:22,750 --> 00:08:25,500
وإن تمكّنت من احتكارِ ذلك، فسوف تُصبِح ثريّاً جدّاً

104
00:08:26,730 --> 00:08:29,540
!بمقدورك أن تُصبِح أقوى من أي بلد أخرى

105
00:08:29,980 --> 00:08:31,980
.من الطبيعي أن يبتغوها

106
00:08:37,330 --> 00:08:38,810
سنتبعُ أكاري وميشيل

107
00:08:39,140 --> 00:08:41,660
سنُنقذهما قبل أن يتصرّف القسم 4

108
00:08:41,660 --> 00:08:42,760
حاضر سيّدي

109
00:08:42,760 --> 00:08:44,280
عُلِم يا كابتن

110
00:08:45,690 --> 00:08:49,080
ليسَ القسم 4 من يُريدهما فحسب

111
00:08:49,510 --> 00:08:50,970
علينا أن نُسرِع

112
00:09:05,460 --> 00:09:06,490
تمّ الإمساك به

113
00:09:06,800 --> 00:09:08,100
أنت نملةُ الرّصاصة

114
00:09:08,100 --> 00:09:09,350
بارابونيرا، صحيح؟

115
00:09:11,880 --> 00:09:15,980
التّصنيف المرّيخي 6

116
00:09:13,590 --> 00:09:15,980
هيزامارو أكاري

117
00:09:13,590 --> 00:09:15,980
أساس العمليّة الجراحيّة: عثّة الإيوميتا اليابانيّة

118
00:09:13,930 --> 00:09:15,460
.عثّة دودة المخباء

119
00:09:15,460 --> 00:09:17,010
.هيزامارو أكاري

120
00:09:23,550 --> 00:09:28,010
اسمح لي أن أمسِك بك بسهولة
أكثر ممّا أتوقّع رجاءً

121
00:09:46,460 --> 00:09:48,320
الاسم هو ميشيل ك.ديفيس

122
00:09:48,740 --> 00:09:52,010
سأستعيدُ تِلك القدرة

123
00:09:52,920 --> 00:09:54,270
ما الأمر يا أكاري؟

124
00:09:54,270 --> 00:09:58,650
هل أنتَ قلقٌ من فقدانِ رباطة جأشي أمام قدرة أبي؟

125
00:09:59,190 --> 00:10:00,460
شكراً

126
00:10:00,920 --> 00:10:03,670
لقد كنتُ مستعدّة لهذا مُذ أدركتُ أنّ التيرافورمارس

127
00:10:03,670 --> 00:10:05,300
تستطيعُ سرِقة قدراتنا

128
00:10:06,050 --> 00:10:08,230
أنا هادئة للغاية

129
00:10:08,230 --> 00:10:09,760
لكنّني غاضبة جدّاً

130
00:10:14,620 --> 00:10:16,110
!أكاري

131
00:10:16,420 --> 00:10:16,980
!نعم

132
00:10:30,760 --> 00:10:33,130
لا تستهِن بخيوط دودة المخباء

133
00:10:33,130 --> 00:10:35,300
!ميشيل-سان، نفّذي الخطّة

134
00:10:37,260 --> 00:10:39,160
هل كنتِ هناك طوال الوقت يا ميشيل؟

135
00:10:40,390 --> 00:10:43,150
هل تحبِّين النّمل؟

136
00:10:45,490 --> 00:10:46,540
!بعض الشيء

137
00:10:47,580 --> 00:10:50,370
كلّ ما في الأمر أنّك تمتلكُ ذراعَين تُشبِهان ذراعَيه

138
00:10:50,370 --> 00:10:51,630
لا يربطني بك أي شيء

139
00:10:52,230 --> 00:10:55,520
سأوقِفُك فقط كي لا تتبع أصدقائي

140
00:10:56,020 --> 00:10:59,300
سأقتلُك فقط لأنّك تيرافورمار

141
00:11:15,360 --> 00:11:17,390
أستطيعُ الشُّعور بضرباتِها من خِلال الخيوط

142
00:11:17,920 --> 00:11:19,190
أتبرِحُه ضرباً؟

143
00:11:19,790 --> 00:11:21,860
هل مكّنَتْ نفسها لهذا طوال الأسبوع؟

144
00:11:22,450 --> 00:11:23,440
هادئة؟

145
00:11:24,290 --> 00:11:26,430
لا يوجدُ ما يربطها؟

146
00:11:27,080 --> 00:11:29,170
فلماذا تبرحُه ضرباً إذاً؟

147
00:11:30,290 --> 00:11:32,960
لكن هل تعلمين يا ميشيل؟

148
00:11:33,350 --> 00:11:34,530
...النّمل

149
00:11:35,000 --> 00:11:36,270
.هذه هي نهايتُك

150
00:11:38,550 --> 00:11:40,690
...من بين كافّة الحشرات إنّها

151
00:11:40,690 --> 00:11:43,440
!حتّى البارابونيرا لا تستطيعُ كسر خيوطي

152
00:11:43,830 --> 00:11:46,530
!ميشيل-سان، هيّا

153
00:11:47,180 --> 00:11:48,040
...إنّها

154
00:12:00,110 --> 00:12:01,420
...إنّها

155
00:12:04,580 --> 00:12:06,240
إنّها الأقوى

156
00:12:10,860 --> 00:12:12,920
...لكن ينبغي أن يكون قد دخلَ إليه القليل منه

157
00:12:13,510 --> 00:12:17,410
سائل النّمل المُنفجِر الخاصّ بميشيل-سان

158
00:12:42,330 --> 00:12:43,820
ما الأمر؟

159
00:12:46,360 --> 00:12:47,860
لا تستطيعُ التقدُّم، صحيح؟

160
00:12:48,680 --> 00:12:51,750
آسف، لكن لا أعتمد على القوّة الخالِصة
مثل ميشيل-سان

161
00:12:52,160 --> 00:12:54,090
سأحبسُك

162
00:12:54,410 --> 00:12:56,550
وأدفنُك تحت الأرض

163
00:13:16,460 --> 00:13:17,440
!الخيوط

164
00:13:47,380 --> 00:13:48,590
ماذا؟

165
00:13:48,590 --> 00:13:50,660
أتريدُني أيضاً؟

166
00:13:50,660 --> 00:13:51,890
أتريدُ هذه الخيوط؟

167
00:13:52,400 --> 00:13:54,460
لكن أتعلم يا بارابونيرا؟

168
00:13:54,460 --> 00:13:58,310
أنا خائفٌ جدّاً من الاستدارة

169
00:13:58,840 --> 00:14:01,200
لأنّها أصبحَتْ غاضبة جدّاً الآن

170
00:14:02,060 --> 00:14:04,740
الجولة الثانية أيُّها الحقيران

171
00:14:05,530 --> 00:14:08,860
إن أردتها فحاول أن تُمسِك بي

172
00:14:23,680 --> 00:14:25,550
خيوط دودة المخباء تذوب؟

173
00:14:25,940 --> 00:14:26,800
حمض؟

174
00:14:28,180 --> 00:14:29,680
خُنفساء الأرض السّوداء؟

175
00:14:31,790 --> 00:14:34,130
أكاري، إن دخلَ عينيك فستُصابُ بالعمى

176
00:14:34,130 --> 00:14:35,220
حقّاً؟

177
00:14:35,900 --> 00:14:37,920
!هذا سيئ

178
00:15:15,980 --> 00:15:17,640
قرّرت إذاً أن تمنحك قِواك

179
00:15:17,640 --> 00:15:19,800
أفضليّة عليّ، عِوضاً عنه؟

180
00:15:20,270 --> 00:15:21,740
!هذا ما كنتُ أرجوه

181
00:15:30,370 --> 00:15:31,810
هكذا إذاً

182
00:15:31,810 --> 00:15:35,250
تستطيعُ إذاً إذابة أي خيوط متى شئت

183
00:15:36,370 --> 00:15:41,760
لقد أصبحتُ هذا الرّجُل الماهِر والذي يستطيعُ
غزل الخيوط مؤخّراً، وهذا يحزِنُني

184
00:15:42,910 --> 00:15:45,900
إن كنتُ عاجزاً عن استخدام خيوطي، فسأضطرُّ لسحقِك

185
00:15:54,770 --> 00:15:56,590
!لا توجدُ ثغرات

186
00:16:17,060 --> 00:16:18,660
يبعثُ حمضاً من قدمِه؟

187
00:16:19,500 --> 00:16:20,050
!لا

188
00:16:28,470 --> 00:16:30,730
الجولة الأولى... أنا الرّابح

189
00:16:36,230 --> 00:16:38,250
!لا يشعرون بالألم

190
00:16:51,600 --> 00:16:54,080
لم يكُن ذلك... جُبناً

191
00:16:55,350 --> 00:16:58,650
إنّه على استعداد أن يفعل أي شيء للفوز

192
00:17:05,320 --> 00:17:06,810
هيزامارو-كُن

193
00:17:06,810 --> 00:17:09,360
!أطلِقَ النّار على هيزامارو-كُن

194
00:17:09,360 --> 00:17:12,690
!التيرافورمارس على وشك أن يأخذوه

195
00:17:13,050 --> 00:17:14,940
إرسال وارد، من الوحدة 2

196
00:17:14,940 --> 00:17:17,950
أنا شبه متأكِّدة أنّنا لن نتمكَّن
من استرجاع الجسد

197
00:17:17,950 --> 00:17:20,070
هذا سيئ، صحيح؟

198
00:17:21,020 --> 00:17:23,650
،بسببِ هيزامارو-كُن صُوِّبَ صاروخ نحونا

199
00:17:23,650 --> 00:17:26,810
وقد أُجبِرتُ على القيادةِ بخطورةٍ بالغة
لدرجة أنّني أوشكتُ أن أتقيّأ

200
00:17:26,810 --> 00:17:28,820
!لم أعُد قادرة على التحمُّل

201
00:17:28,820 --> 00:17:29,940
!أطلِقوا أرجوكم

202
00:17:30,710 --> 00:17:33,130
هيزامارو-كُن وميشيل-سان يُقاتلان

203
00:17:33,130 --> 00:17:35,480
بين الوحدتَين 1 و 2 بشكل مُباشَر

204
00:17:36,140 --> 00:17:39,910
أطلِقوا بعض النِّيران واقتلوهما مع التّيرافورمارس فحسب

205
00:17:39,910 --> 00:17:43,380
!المهمّ أن تحافظوا على حياتي أرجوكم

206
00:17:43,900 --> 00:17:45,160
!بسُرعة

207
00:17:45,160 --> 00:17:47,690
!حالما يموتان ستستهدفُني التّيرافورمارس

208
00:17:47,690 --> 00:17:50,610
لا أريدُ أن أموت، أنقذوني

209
00:17:50,610 --> 00:17:52,900
هل خانَتْهم الرتبة 98 إذاً؟

210
00:17:53,360 --> 00:17:56,070
ربّما هذا ما يمكنُك تأمُّله من عنصر
غير مُقاتِل

211
00:17:56,070 --> 00:17:57,870
.قد تورّطَ في كلّ هذا

212
00:18:01,630 --> 00:18:02,560
.لنفعلها

213
00:18:10,100 --> 00:18:11,170
جاري الإطلاق

214
00:18:15,910 --> 00:18:20,410
يخشى القسم 4 من اختطافي أنا وأكاري
بواسطة التّيرافورمارس

215
00:18:20,410 --> 00:18:23,130
حيثُ لن يستطيعوا استرجاع أي جزء من جسدينا

216
00:18:23,130 --> 00:18:24,430
والقسمان 1 و 2

217
00:18:24,430 --> 00:18:26,300
سيجتمعان مع جوزيف وما تبقّى من القسم 6

218
00:18:26,300 --> 00:18:27,530
.وسيعودون لقتلِهم جميعاً

219
00:18:29,230 --> 00:18:30,750
،لا نستطيعُ استخدام أجهزة الإرسال

220
00:18:30,750 --> 00:18:34,360
لهذا سنرسلُ إشارةً دخانيّة لتنبيه
القسم 6 بالخطر الذي يحدق بنا

221
00:18:34,590 --> 00:18:36,560
لهذا طلبنا منهم إطلاق الصَّاروخ

222
00:18:36,930 --> 00:18:38,480
لهذا تظاهري بخيانتِنا

223
00:18:38,480 --> 00:18:40,280
!س-سأحاولُ ذلك

224
00:18:40,280 --> 00:18:41,370
!يـ-يايكو

225
00:18:42,080 --> 00:18:45,490
!عندما تشعران أنّني سأخسر، نفِّذا الخطّة

226
00:18:45,890 --> 00:18:48,430
سنتخلّصُ من إحدى صواريخ القسم 4 أيضاً

227
00:18:48,860 --> 00:18:49,860
!حاضر

228
00:18:52,870 --> 00:18:55,510
أؤمِنُ بك يا أليكس

229
00:18:56,490 --> 00:18:58,110
اعتمدي عليّ يا يايكو

230
00:18:58,560 --> 00:19:02,700
!سأطلِقُ عليه وأستخدمه كإشارة دُخانيّة

231
00:19:31,750 --> 00:19:34,080
!سأعودُ كشبحٍ وأسكنُك

232
00:19:39,580 --> 00:19:40,700
لم ينفجر؟

233
00:19:45,500 --> 00:19:49,220
لقد أهدَرْنا صاروخهم لكن لم نرسِل إشارتنا الدخانيّة

234
00:19:49,640 --> 00:19:50,510
فشِلَتْ؟

235
00:20:00,510 --> 00:20:02,070
جاري إعداد القذيفة الثانية

236
00:20:02,070 --> 00:20:02,780
!انتظر

237
00:20:03,520 --> 00:20:06,330
هل انحرفَ عن المسار وأخفقَ الهدف؟

238
00:20:06,810 --> 00:20:07,750
لماذا؟

239
00:20:11,350 --> 00:20:14,310
الرّتبة 7؟ ما الذي فعلَه؟

240
00:20:15,910 --> 00:20:18,660
كان حبلاً ضيِّقاً للغاية

241
00:20:18,660 --> 00:20:21,240
توجّبَ عليهم عبوره حتّى يحقّ لهم
أن يعتبروها خطّة

242
00:20:22,060 --> 00:20:25,090
...لو لم يُطلِق ليو الصّاروخ

243
00:20:25,660 --> 00:20:29,680
...لو أصابَ الصّاروخُ الوحدة 2، حيثُ كانَتْ يايكو

244
00:20:30,130 --> 00:20:33,420
...لو انفجرَ الصّاروخ

245
00:20:33,810 --> 00:20:38,350
كان خيطاً رفيعاً جدّاً من الأملِ
توجّبَ عليهم اجتيازه

246
00:20:38,350 --> 00:20:40,530
!وهو مُهدّد بالانقطاعِ في أي لحظة

247
00:20:41,940 --> 00:20:42,900
...لكن

248
00:20:43,920 --> 00:20:44,950
...شكراً لك

249
00:20:44,950 --> 00:20:45,870
.كائناً من تكون

250
00:20:48,210 --> 00:20:51,780
كان شريكٌ ساقطٌ من أرضٍ أخرى
حاضراً لتقديم المُساعدة

251
00:20:53,520 --> 00:20:54,890
...إذا كان هذا بحوزتي

252
00:20:54,890 --> 00:20:57,910
أستطيعُ القِتال جولة إضافيّة

253
00:21:00,450 --> 00:21:05,450
كان الرّتبة 7 يعلمُ إذاً أنّنا سنُطلِق
دون تردُّد إن اضطررنا إلى ذلك؟

254
00:21:06,180 --> 00:21:08,070
كان السّبب وراء تدميرهم للقاذِفة خدعة

255
00:21:08,070 --> 00:21:10,250
لإيهامنا بأنّ الصّواريخ بحدِّ ذاتها كانَتْ لا تزالُ بأمان

256
00:21:10,610 --> 00:21:12,430
...والسِّلاح الذي فصلَها

257
00:21:13,080 --> 00:21:17,140
كانوا قد أزالوا المواد المتفجِّرة من رأس القذيفة
ووضعوا ذلك السِّلاح بدلاً من ذلك؟

258
00:21:17,140 --> 00:21:18,940
...لكن تغيّرَ مركزُ الجاذبيّة

259
00:21:19,680 --> 00:21:22,190
...كان ذلك السِّلاح إذاً

260
00:21:23,790 --> 00:21:25,510
،لا أعرف من تكون

261
00:21:26,010 --> 00:21:28,570
لكن بلغَتْني آمالُك

262
00:21:34,170 --> 00:21:39,100
كان سِلاحاً خاصّاً ضحّى الرّتبة 7
بنفسِه ليهِبَه للرتبة 6

263
00:21:39,100 --> 00:21:41,100
...إن كنت تستخدمُ المُسدّسات

264
00:21:42,100 --> 00:21:44,410
!فسأستخدمُ هذا أيضاً

265
00:21:47,070 --> 00:21:50,140
سيف النّينجا الاهتزازي المُضادّ للتيرافورمار

266
00:21:50,510 --> 00:21:51,580
...والمعروف بـ

267
00:21:54,030 --> 00:21:55,990
هيزامارو

268
00:21:55,390 --> 00:21:56,810
!هيزامارو

269
00:23:38,580 --> 00:23:41,010
.تُصبِح على خير يا بارابونيرا