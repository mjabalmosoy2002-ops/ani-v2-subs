1
00:00:02,580 --> 00:00:07,170
.ثمّة شخص ظلّ حيًّا في ذكريات أكاري

2
00:00:08,670 --> 00:00:13,100
.ثمّة شخص علّم ميشيل القوّة

3
00:00:14,680 --> 00:00:15,890
.لهذا خاضا المعارك

4
00:00:17,020 --> 00:00:18,440
.لهذا لم يموتا

5
00:00:20,480 --> 00:00:22,740
...بدا أنّ المعركة قد انتهت، لكن

6
00:00:25,580 --> 00:00:28,170
.أنا أؤمن بك يا أليكس

7
00:00:31,250 --> 00:00:33,640
!سأعود كشبحٍ وأسكنك

8
00:02:09,870 --> 00:02:12,170
.كان ضمن مسار تحقيق الإصابة بلا شكّ

9
00:02:15,380 --> 00:02:16,760
.ولم يطلق صاروخٌ ثانٍ

10
00:02:16,760 --> 00:02:17,760
لماذا؟

11
00:02:17,760 --> 00:02:20,010
هل هذا يعني أنّ المهمّة قد نجحت؟

12
00:02:20,260 --> 00:02:23,360
،نجحنا في إهدارهم لصاروخٍ واحد

13
00:02:23,360 --> 00:02:26,400
.لكن فشلنا في إطلاق إشارة دخانيّة

14
00:02:26,400 --> 00:02:28,660
.لذا أعتقد أنّنا نجحنا بشكلٍ جزئيّ

15
00:02:30,870 --> 00:02:32,090
!أليكس

16
00:02:32,960 --> 00:02:35,170
.لقد عثرتُ على الأولى والثّاني

17
00:02:35,170 --> 00:02:36,420
.جارٍ استعادتهما

18
00:02:47,530 --> 00:02:50,320
.لم أرك منذ مدّة أيّتها الضّابطة التّنفيذيّة ديفيس

19
00:02:50,610 --> 00:02:53,460
.القسم رقم 4، الرّتبة 50، باو زيلان

20
00:02:53,960 --> 00:02:58,380
حدثت بعض الأمور، لهذا سأحتجزك
.أنت وهيزامارو-كن

21
00:02:58,550 --> 00:02:59,930
.هذه درّاجةٌ جوّيّة

22
00:02:59,930 --> 00:03:01,550
منذ متى تتبعنا؟

23
00:03:01,550 --> 00:03:03,400
.لا بدّ وأنّكما تتألّمان كثيرًا

24
00:03:08,070 --> 00:03:10,950
.والمذهل أنّ فكّيكما السّفليّين مكسورين

25
00:03:10,950 --> 00:03:12,670
.كذلك الأمر بالنّسبة لعظمة التّرقوة اليسرى

26
00:03:12,960 --> 00:03:15,000
.والأضلاع بالطّبع

27
00:03:15,000 --> 00:03:16,750
.وارتطام شديد في الرأس

28
00:03:17,130 --> 00:03:21,050
ربّما أصيبت الضّابطة التّنفيذيّة بكسورٍ
كثيرة في جمجمتها أيضًا، صحيح؟

29
00:03:21,630 --> 00:03:25,020
جروحك بليغة لدرجة أنّه من المدهش
.أن تقوي حتّى على التّحديق بي

30
00:03:27,020 --> 00:03:30,610
.نفدت العقاقير في الوقت المناسب حقًّا

31
00:03:31,320 --> 00:03:32,250
...والآن

32
00:03:38,250 --> 00:03:40,630
.تمّ تأمين الثّاني والأولى

33
00:03:42,020 --> 00:03:45,060
حصلت أيضًا على مائتَيْ عيّنة حصل عليها
.القسم اليابانيّ الأمريكيّ

34
00:03:46,060 --> 00:03:46,980
أليس هذا جيّدًا؟

35
00:03:48,730 --> 00:03:50,860
.ابقيا مكانيكما رجاءً

36
00:03:51,240 --> 00:03:53,580
.لا تستطيعان التّحرّك أصلاً

37
00:03:53,580 --> 00:03:55,580
ماذا حصل للقبطان كوماتشي؟

38
00:03:55,580 --> 00:03:56,380
.لا أعرف

39
00:03:56,380 --> 00:03:58,500
!لا تعبث معنا

40
00:03:58,790 --> 00:04:00,840
.لن أمدّكما بأيّ معلومة

41
00:04:01,630 --> 00:04:04,270
.وأنا من يطرح الأسئلة هنا

42
00:04:04,850 --> 00:04:06,850
.كان ذلك صعبًا للغاية

43
00:04:07,230 --> 00:04:11,110
لم نكن نعلم من كان على متن
.الوحدتين 1 و 2

44
00:04:11,610 --> 00:04:13,950
هل كنتما أنتما حقًّا؟

45
00:04:13,950 --> 00:04:16,920
.أردناكما على قيد الحياة ما أمكن ذلك

46
00:04:21,090 --> 00:04:23,100
لكن كان هنالك شخص آخر، صحيح؟

47
00:04:23,390 --> 00:04:25,390
.فتاة ذات رتبة منخفضة

48
00:04:25,390 --> 00:04:27,940
.اتّصلت بنا من الوحدة 2

49
00:04:28,480 --> 00:04:30,520
والرّتبة 12 هنا أيضًا، صحيح؟

50
00:04:31,650 --> 00:04:33,330
.لا تقلقا

51
00:04:33,580 --> 00:04:35,950
.لن نقتلهما إن لم نضطرّ لذلك

52
00:04:35,950 --> 00:04:38,000
.فهما جزء من فريقنا

53
00:04:41,080 --> 00:04:43,970
.حسنًا، السّؤال الأوّل

54
00:04:47,100 --> 00:04:49,190
.كانت الوحدة 1 من دون قائد

55
00:04:49,190 --> 00:04:51,870
إلى أين ذهب بقيّة القسمين 1 و 2؟

56
00:04:55,700 --> 00:04:57,540
.ماتوا جميعًا

57
00:04:57,950 --> 00:05:03,010
.قاتلنا التّيرافورمار مرّتين قبل أن نواجه البارابونيرا

58
00:05:03,640 --> 00:05:04,010
...إذًا

59
00:05:07,970 --> 00:05:08,640
!أنت

60
00:05:12,610 --> 00:05:14,030
...أيّها الحقير

61
00:05:15,160 --> 00:05:17,990
أتشعران بالألم إذًا؟

62
00:05:17,990 --> 00:05:19,830
رغم الوضع الّتي وُلدتما عليه؟

63
00:05:20,160 --> 00:05:21,420
.يا لها من جرأة

64
00:05:22,340 --> 00:05:25,100
أين الآخرون؟

65
00:05:26,220 --> 00:05:28,970
أين الرّتبة 8 والرّتبة 9؟

66
00:05:30,350 --> 00:05:32,610
ما هي أوامرك يا حضرة الضّابطة التنفيذيّة ميشيل؟

67
00:05:32,610 --> 00:05:34,280
كيف نستطيع الفوز؟

68
00:05:35,570 --> 00:05:40,620
هنالك طريقتان لهزيمة القسم رقم 4؛
.الطريقة المباشرة والطريقة غير المباشرة

69
00:05:41,250 --> 00:05:42,630
...يجب عليكم أن

70
00:05:44,090 --> 00:05:46,600
أين العناصر غير المقاتلة من القسمين 1 و 2؟

71
00:05:50,350 --> 00:05:52,110
.يا إلهي

72
00:05:52,110 --> 00:05:53,530
هل حان الوقت بهذه السّرعة؟

73
00:05:56,780 --> 00:05:58,870
ابقيا هنا، اتّفقنا؟

74
00:06:00,240 --> 00:06:02,090
.لقد أمّنت الأولى والثّاني

75
00:06:02,550 --> 00:06:04,930
.أطلب أن تقلّهما يا حضرة القائد ليو

76
00:06:04,930 --> 00:06:06,090
.علم

77
00:06:06,470 --> 00:06:07,970
.نحن في طريقنا إليك

78
00:06:08,470 --> 00:06:10,970
،سأبدأ بالعودة بواسطة الوحدة 1

79
00:06:10,970 --> 00:06:13,650
.لكن لا أرى أيّ موظّف آخر من القسمين 1 و 2

80
00:06:13,990 --> 00:06:16,360
.ظلّت مواقعهم مجهولة

81
00:06:18,760 --> 00:06:20,350
.يخيّم اللّيل

82
00:06:20,800 --> 00:06:22,730
.سيقلّلون من يقظتهم

83
00:06:22,730 --> 00:06:26,860
أجل، مهمّتنا هي هزيمة القسم رقم 4
.بشكل غير مباشر

84
00:06:28,700 --> 00:06:33,250
مهمّتكم هي إعادة برج الاتّصالات
،الّذي يستخدمونه كمشوّش إلى طبيعته

85
00:06:33,250 --> 00:06:36,970
.وإخبار الأرض أنّ القسم رقم 4 قد خاننا

86
00:06:37,670 --> 00:06:40,340
،سيدفع هذا كافّة الفروع في الأرض إلى التّصرّف

87
00:06:40,590 --> 00:06:43,940
.والسّماح لنا بهزيمتهم بشكلٍ غير مباشر

88
00:06:46,690 --> 00:06:48,450
هل أنت بخير يا بيغي؟

89
00:06:48,900 --> 00:06:51,670
82 :"تصنيف "مارس
بيغي فورتي
القسم الأمريكيّ اليابانيّ المشترك رقم 2
آكل النّمل الشّوكيّ ذو المنقار القصير

90
00:06:53,750 --> 00:06:55,840
جاريد، كم بقي؟

91
00:06:56,170 --> 00:06:57,880
.لقد اجتزنا المناجم

92
00:06:58,220 --> 00:07:00,680
.بقي 500 متر حتّى نصل إلى أنيكس

93
00:07:00,680 --> 00:07:02,810
‫500 متر؟

94
00:07:02,810 --> 00:07:04,400
.دعوني أستريح قليلاً

95
00:07:04,400 --> 00:07:05,020
.حسنًا

96
00:07:05,020 --> 00:07:05,860
.آسفة

97
00:07:06,150 --> 00:07:07,610
.لا ألومك

98
00:07:07,610 --> 00:07:10,030
حتّى لو كنت تمتلكين يديّ وقوّة آكل النّمل
،الشّوكيّ ذو المنقار القصير

99
00:07:10,030 --> 00:07:12,250
.فأنت فتاةٌ وغير مقاتلة

100
00:07:12,250 --> 00:07:13,170
.أجل

101
00:07:13,170 --> 00:07:15,880
.ولا ينبغي أن نصعد إلى السّطح بعد

102
00:07:15,880 --> 00:07:16,840
لماذا يا ولف؟

103
00:07:17,380 --> 00:07:20,260
.اختفت كثيرٌ من الحقول الحيويّة المغناطيسيّة

104
00:07:19,010 --> 00:07:25,190
90 :"تصنيف "مارس
ولف ريدفيلد
القسم الأمريكيّ اليابانيّ المشترك رقم 2
قرش أبو مطرقة

105
00:07:20,510 --> 00:07:25,190
،ربّما كان غازًا سامًّا أو سلاحًا بيولوجيًا أو إشعاعًا ما

106
00:07:25,190 --> 00:07:27,070
.لكنّه ليس انفجارًا نوويًّا

107
00:07:27,070 --> 00:07:27,980
...هل

108
00:07:27,980 --> 00:07:29,820
هل لديهم شيء كهذا؟

109
00:07:29,820 --> 00:07:30,860
.أجل

110
00:07:30,860 --> 00:07:34,920
،أوّل 500 حقل حيويّ مغناطيسيّ عبروا المنطقة بسرعة

111
00:07:34,920 --> 00:07:36,840
.ربّما كانت كائنات التّيرافورمار

112
00:07:36,840 --> 00:07:40,670
.ومن ثمّ اختفوا جميعًا حال اقترابهم من أنيكس

113
00:07:40,670 --> 00:07:41,980
.مات معظمهم بشكلٍ فوريّ

114
00:07:41,980 --> 00:07:44,060
.لم أشعر بأيّ شيء

115
00:07:44,060 --> 00:07:47,060
،أساسك الجراحيّ هو حوتٌ قاتل
.وبالتّالي فإنّك تستخدم أمواجًا صوتيّة

116
00:07:47,060 --> 00:07:49,110
.بينما أساسي هو القرش أبو مطرقة

117
00:07:49,480 --> 00:07:52,410
أرصد الحقول الحيويّة المغناطيسيّة
.الّتي تولّدها المخلوقات الحيّة

118
00:07:52,870 --> 00:07:54,080
.أنا متأكّدٌ من ذلك

119
00:07:54,080 --> 00:07:57,710
استخدم القسم رقم 4 سلاح
.دمارٍ شامل من نوع ما

120
00:07:58,080 --> 00:08:00,210
لا يمكننا الاقتراب إذًا، أليس كذلك؟

121
00:08:00,380 --> 00:08:03,100
.لا، سنقترب. لا بدّ أن نفعل

122
00:08:03,480 --> 00:08:09,610
هذا هو السّبب الّذي دفعنا جميعًا نحن المهندسون
.غير المقاتلون بالمجيء إلى هذا الكوكب

123
00:08:11,530 --> 00:08:13,870
.رائع أيّها الرّتبة 90، تتكلّم كالأقوياء

124
00:08:13,870 --> 00:08:15,210
ماذا؟

125
00:08:15,210 --> 00:08:16,500
هل لديك خطّة؟

126
00:08:17,000 --> 00:08:19,080
.لا أرجّح أن يكون الإشعاع

127
00:08:19,080 --> 00:08:20,880
.سننتظر حتّى الفجر إذًا

128
00:08:20,880 --> 00:08:21,930
فجر؟

129
00:08:22,350 --> 00:08:25,770
ستشلّ أيّ جرثومة جرّاء أيّ تغيّر
.في مقدار أشعّة الشّمس

130
00:08:26,270 --> 00:08:28,520
.وسيتبدّد أيّ غاز سامّ

131
00:08:29,020 --> 00:08:34,120
إن استطعنا صرف انتباههم إلى مكانٍ ما لبضعة
،دقائق إلى عشرات الثّواني عند شروق الشّمس

132
00:08:34,120 --> 00:08:37,410
فينبغي أن نكون قادرين على دخول
.غرفة قيادة أنيكس

133
00:08:37,710 --> 00:08:41,210
وهناك سنخترق البرج الّذي يتحكّم به
.القسم رقم 4 الكترونيًّا

134
00:08:41,930 --> 00:08:46,270
كان عملنا كمهندسين هو إعداد
.وتجهيز الأمور في الأصل

135
00:08:47,680 --> 00:08:52,280
.ومن ثمّ سنخبر الأرض أنّ القسم 4 قد خانهم

136
00:08:53,530 --> 00:08:55,790
.لا تستهينوا بالمدنيّين

137
00:08:55,790 --> 00:08:59,250
لقد خضعتُ لكلّ أنواع التّجارب
.الفظيعة في شركاتٍ رديئة

138
00:09:00,000 --> 00:09:02,470
.آسف لكوني حقيرًا آنذاك

139
00:09:02,800 --> 00:09:03,720
.أعتمد عليك

140
00:09:03,930 --> 00:09:05,060
.حسنًا

141
00:09:05,350 --> 00:09:09,310
لكن بصراحة، كلّ ما أبرع فيه هو معرفة
.الأشياء واتّخاذ المشاكل على محمل الجدّ

142
00:09:09,310 --> 00:09:11,910
،لا أفعل أيّ شيء ضدّ كائنات التّيرافورمار

143
00:09:12,610 --> 00:09:15,530
.لكن أريد حماية زملائي في الفريق

144
00:09:16,700 --> 00:09:20,910
لطالما كان أكيرا-كن والضّابطة التّنفيذيّة
،ميشيل الهدفين الرّئيسيّين

145
00:09:20,910 --> 00:09:23,930
.لكنّهما حرصا على حمايتنا دومًا من الموت

146
00:09:24,300 --> 00:09:25,930
...وأليكس ويايكو-تشان كذلك

147
00:09:26,550 --> 00:09:28,770
.لهذا أريد أن أقدّم المساعدة أيضًا

148
00:09:29,100 --> 00:09:32,650
أودّ استخدام قوانا
.حتّى إن لم تكن مؤهّلة للقتال

149
00:09:32,900 --> 00:09:34,030
.أجل

150
00:09:34,990 --> 00:09:36,070
.أودّ حمايتهم

151
00:09:38,370 --> 00:09:39,490
.شيلا

152
00:09:51,350 --> 00:09:52,610
!أنا آسف

153
00:09:54,740 --> 00:09:58,070
...كنتُ ولا أزال مع شيلا

154
00:09:58,240 --> 00:09:59,280
...شيلا

155
00:10:08,260 --> 00:10:11,140
ما الّذي أتينا إلى المرّيخ لفعله؟

156
00:10:11,140 --> 00:10:12,400
...لحماية شيلا

157
00:10:12,400 --> 00:10:13,190
حقًّا؟

158
00:10:13,570 --> 00:10:16,740
.لستَ بحاجةٍ للاعتذار منّي إذًا

159
00:10:16,740 --> 00:10:18,620
.لأنّ هذا ليس سبب وجودي هنا

160
00:10:18,950 --> 00:10:23,340
.لقد تمّ استغلالنا بشتّى الوسائل منذ ولادتنا

161
00:10:23,340 --> 00:10:25,260
كان باستطاعتنا الانضمام لعصابة أو بيع أنفسنا

162
00:10:25,260 --> 00:10:27,470
.أو عدم القيام بأيّ شيء والبقاء كحثالة

163
00:10:27,470 --> 00:10:30,140
أتينا إلى هنا لتغيير تلك الحياة، أليس كذلك؟

164
00:10:30,140 --> 00:10:32,190
وأنت مثلي، صحيح؟

165
00:10:32,190 --> 00:10:35,690
!لا وقت لديك للجلوس هنا والبكاء

166
00:10:40,450 --> 00:10:42,840
.سأثأر لشيلا

167
00:10:42,840 --> 00:10:44,250
...نعم

168
00:10:48,300 --> 00:10:51,470
...و... لا أعلم إن كان ذلك ممكنًا، لكن

169
00:10:52,230 --> 00:10:57,900
إن لم يكن هذا سلاحًا، إنّما مجرّد نوع جرثوميّ
،أو قدرة أخرى يستخدمها شخصٌ ما

170
00:10:57,900 --> 00:10:59,950
.فهذا يعني أنّه عسكريّ بالطّبع

171
00:10:59,950 --> 00:11:01,750
.إن كان كذلك، فالمسألة عائدة لكم

172
00:11:02,040 --> 00:11:02,960
.عُلم

173
00:11:02,040 --> 00:11:02,960
.حسنًا

174
00:11:03,670 --> 00:11:05,300
.بالتّوفيق لكم جميعًا

175
00:11:05,670 --> 00:11:10,340
سنهزم أولئك الخونة في القسم رقم 4
.ونعود جميعًا إلى الأرض

176
00:11:23,000 --> 00:11:24,130
!اللّعنة

177
00:11:24,130 --> 00:11:26,920
...لقد وجدتنا كائنات التّيرافورمار سلفًا

178
00:11:26,920 --> 00:11:28,710
!كانت تلك إشارة

179
00:11:29,050 --> 00:11:31,730
