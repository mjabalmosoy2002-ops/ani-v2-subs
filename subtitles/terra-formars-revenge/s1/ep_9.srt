!لا مُشكلة

185
00:15:34,060 --> 00:15:36,610
تخلّصتُ من كافّة الملابس التي توجدُ عليها فيرومونات

186
00:15:36,930 --> 00:15:38,990
هذا سبب تعرّيك إذاً

187
00:15:38,990 --> 00:15:40,620
!كان المنحرف في ورطة

188
00:15:40,620 --> 00:15:42,470
،أنا آسف

189
00:15:42,470 --> 00:15:45,610
...لخروجي بهذا المظهر المُثير أمام النّساء

190
00:15:45,610 --> 00:15:47,600
لا، ليس مُثيراً

191
00:15:47,600 --> 00:15:48,870
على الإطلاق

192
00:15:50,050 --> 00:15:52,640
أنا آسفٌ حقّاً

193
00:15:53,420 --> 00:15:56,000
أنا أبعثُ نوعاً آخر من الفيرومونات

194
00:15:56,000 --> 00:15:57,000
لا، ليس تماماً

195
00:15:58,150 --> 00:15:59,610
،يايكو-تشان

196
00:15:59,610 --> 00:16:01,900
أعطي هذين الاثنين بعضاً من العقار

197
00:16:02,690 --> 00:16:04,370
يمكنُك التحرُّك الآن، صحيح؟

198
00:16:04,370 --> 00:16:05,700
!حسناً

199
00:16:06,630 --> 00:16:10,350
لكن كيف تمكّنت من إيجادنا يا جو؟

200
00:16:11,390 --> 00:16:13,570
رأيتُ إشارتهم

201
00:16:14,140 --> 00:16:16,580
إشارتهم أوصلَتْه إلى هنا؟

202
00:16:17,040 --> 00:16:19,580
جلبَتْ كلّ كائنات التيرافورمار تلك وكذلك الرّتبة 1

203
00:16:19,980 --> 00:16:22,870
ومن ثمّ رأيتُ تِلك الابتسامة الفظيعة

204
00:16:26,490 --> 00:16:27,900
آسفة

205
00:16:28,300 --> 00:16:30,390
أنا بخير

206
00:16:31,490 --> 00:16:32,650
شكراً

207
00:16:33,460 --> 00:16:35,730
كنتُ مشبوهاً حتّى وقت قريب

208
00:16:36,410 --> 00:16:39,920
،لِذا كان كثير من النّاس يلاحقوننا اليوم

209
00:16:40,890 --> 00:16:45,010
ظننتُ أنّه قد لا يُعالجنا

210
00:16:46,320 --> 00:16:48,300
حسبتُ أنّه لن يفكّ الحِبال

211
00:16:50,160 --> 00:16:51,700
لكنّني مسرور

212
00:16:53,140 --> 00:16:54,470
...اليوم

213
00:16:55,470 --> 00:16:58,020
خلتُ نفسي سأموت كثيراً اليوم

214
00:16:58,600 --> 00:17:01,660
هل نتملّصُ من كائنات التيرافورمار؟

215
00:17:02,020 --> 00:17:03,990
نعم، كُل شيء على ما يُرام

216
00:17:06,070 --> 00:17:08,200
أحتاجُ إلى ماء، ماء

217
00:17:08,200 --> 00:17:09,480
.قبل أي شيء

218
00:17:10,210 --> 00:17:11,310
تفضّلي

219
00:17:12,500 --> 00:17:15,280
يايكو، يسرّني أنّكِ بخير

220
00:17:15,700 --> 00:17:17,160
...نعم

221
00:17:17,640 --> 00:17:20,660
...كم أنا سعيد

222
00:17:21,550 --> 00:17:23,910
،عندما نستخدمُ العقار للتحوُّل

223
00:17:23,910 --> 00:17:30,030
ندمّرُ الأعضاء الحيويّة البشريّة
بسرعة فائقة ونُنشئ غيرها

224
00:17:30,810 --> 00:17:34,890
كلّما استخدمت العقار أكثر كلّما نقص عمرك

225
00:17:35,570 --> 00:17:38,010
ميشيل-سان، أين العقار الذي كان بحوزتكِ؟

226
00:17:38,010 --> 00:17:38,990
استهلكتُه كلّه

227
00:17:41,080 --> 00:17:42,630
وأنا مُدرِكة للآثار الجانبيّة

228
00:17:42,630 --> 00:17:45,350
قاتلتِ حتّى نفدت عقاقيركِ؟

229
00:17:45,760 --> 00:17:47,820
لا بدَّ وأنّكِ عانيتِ الأمرّين حتّى الآن

230
00:17:47,820 --> 00:17:49,550
لكن كُل شيء على ما يُرام الآن

231
00:17:53,260 --> 00:17:55,720
،لأنّني أنا، الرتبة 1

232
00:17:55,720 --> 00:17:57,240
!حاضر هنا

233
00:17:57,750 --> 00:17:59,830
!تحفة البشريّة

234
00:18:00,390 --> 00:18:03,250
،المُحارب البشري الأقوى حاضرٌ هنا وبسيفه

235
00:18:03,250 --> 00:18:05,660
!يا ميشيل-سان، وهو يقفُ إلى جانبكِ

236
00:18:05,660 --> 00:18:09,630
يسرُّني حقاً أن يكون الرّتبة 1 في صفِّنا

237
00:18:09,630 --> 00:18:10,450
صحيح؟

238
00:18:10,450 --> 00:18:11,490
أجل

239
00:18:14,540 --> 00:18:17,910
من الآن فصاعداً، سيُقاتلُ الرّتبة 1 معك

240
00:18:17,910 --> 00:18:20,740
،وعندما نعودُ إلى الأرض

241
00:18:21,260 --> 00:18:23,910
أريدُكِ أن تكوني شريكة المستقبل

242
00:18:39,390 --> 00:18:42,410
أعتقدُ أنّ كافّة الجماعات في المرّيخ قد اجتمعت الآن

243
00:18:42,750 --> 00:18:47,450
ما رأيك يا بيترا-سان؟

244
00:18:42,890 --> 00:18:45,110
مكتب الفرع السّادس التّابع ليو-ناسا
رئيس رابطة الشّعوب الرومانيّة
لوك سنوريسون

245
00:18:48,340 --> 00:18:49,510
بخصوص ما يجري؟

246
00:18:49,510 --> 00:18:50,750
أجل

247
00:18:50,750 --> 00:18:56,220
ربّما يحصلُ رجلُنا جو على عيّناتٍ كثيرة
من فيروس أ.ي الآن

248
00:18:56,220 --> 00:18:59,530
نتحدّثُ عن الأرض الآن

249
00:18:59,530 --> 00:19:03,610
نناقشُ ما إن كنتُم أيُّها الرومانيّون راغبين
بالانضمام لدائرة

250
00:19:03,610 --> 00:19:07,340
مكتب الفرع 4 بناء على اقتراح رئيس وزراء اليابان هيروما

251
00:19:07,570 --> 00:19:10,780
لستُ متأكّداً

252
00:19:11,480 --> 00:19:14,960
إذاً الغرفة التي أعدّتها روما عازلة للصّوت؟

253
00:19:14,960 --> 00:19:16,020
إنّهم شديدو الحذر

254
00:19:16,020 --> 00:19:17,560
تاتشان

255
00:19:18,170 --> 00:19:23,180
لماذا برأيك لا يسأم الأشخاص في المرّيخ من فيروس أ.ي؟

256
00:19:24,230 --> 00:19:27,250
لا أحد يُحدِث جلبةً بشأن حقيقة عدم ارتدائهم لأقنعة

257
00:19:27,250 --> 00:19:29,170
.لهذا لم أفكّر بالأمرِ حقيقةً

258
00:19:29,170 --> 00:19:33,300
لكن قد تمتلك كائنات تيرافورمار
في المرّيخ فيروساً قاتلاً، صحيح؟

259
00:19:33,890 --> 00:19:36,310
هذا غريب، أليس كذلك؟

260
00:19:36,310 --> 00:19:39,930
يُخالِف ذلك الفيروس كلّ ما نعرفه عن الفيروسات

261
00:19:39,930 --> 00:19:42,480
ومن ثمّ لدينا علاقته بالعضو الفُسيفسائي

262
00:19:45,860 --> 00:19:50,350
قلت ذلك بعد أربعة أيّام من لقائنا

263
00:19:50,770 --> 00:19:51,790
هل قالها من قبل؟

264
00:19:52,420 --> 00:19:55,010
لا ينبغي أن تمزح مزاحاً كهذا

265
00:19:55,010 --> 00:19:56,950
!لا يا ميشيل-سان

266
00:19:56,950 --> 00:19:59,810
أنا جادٌّ تماماً

267
00:19:59,810 --> 00:20:01,190
في كلّ كلمة أقولها

268
00:20:01,190 --> 00:20:02,570
!جادّ كلّ الجدّ

269
00:20:03,820 --> 00:20:05,990
!عليّ أن أقولها الآن

270
00:20:05,990 --> 00:20:10,040
لأنّنا لا نعلم ما إن كنّا سنعيش ونرى الغدّ

271
00:20:10,590 --> 00:20:13,210
،قد أكون فاشلاً لا يستطيع حماية رجاله لكن

272
00:20:13,750 --> 00:20:14,960
،ميشيل-سان

273
00:20:16,310 --> 00:20:21,330
سأصنعُ لقاحاً وأعيدكِ إلى الأرض

274
00:20:21,330 --> 00:20:23,050
...عندما يحدثُ ذلك

275
00:20:23,660 --> 00:20:25,530
!أريدُكِ أن تتزوّجيني

276
00:20:25,530 --> 00:20:27,870
يـ-يتزوّجها؟

277
00:20:28,390 --> 00:20:31,170
مُت أيّها النرجسيّ

278
00:20:31,170 --> 00:20:32,690
!هذا ما أريد قوله، لكن لا أستطيع

279
00:20:32,690 --> 00:20:35,340
!لقد أنقذَ زملائي

280
00:20:41,670 --> 00:20:43,060
!ميشيل-سان

281
00:20:43,060 --> 00:20:45,820
...في الواقع

282
00:20:46,190 --> 00:20:47,820
وجدتُها

283
00:20:48,220 --> 00:20:51,620
سأحجزُ لك مكاناً جيّداً في قائمة المرشّحين

284
00:20:54,150 --> 00:20:55,850
!نعم

285
00:20:55,850 --> 00:20:58,260
حالما نعودُ إلى الأرض سنبدأ بالعشاء

286
00:20:58,260 --> 00:20:59,040
!نحنُ الاثنان فقط

287
00:20:59,040 --> 00:21:01,980
لا، الغداء، الغداء مناسب

288
00:21:01,980 --> 00:21:04,020
وسيكونُ من الأمتع حضور الآخرين معنا

289
00:21:04,020 --> 00:21:05,230
أليس كذلك يا أكاري؟

290
00:21:05,960 --> 00:21:06,530
أليس كذلك؟

291
00:21:06,530 --> 00:21:08,740
...نعم

292
00:21:08,740 --> 00:21:10,490
يمكنُنا أن نتناول الغداء جميعاً

293
00:21:10,490 --> 00:21:11,790
!في حانة

294
00:21:11,790 --> 00:21:12,580
في مقهى

295
00:21:12,580 --> 00:21:13,810
في غرفة خاصّة

296
00:21:13,810 --> 00:21:14,770
في شرفة

297
00:21:28,460 --> 00:21:30,570
إذا قدّرنا الوقت، ينبغي أن نكون قد اقتربنا من الوصول

298
00:21:50,670 --> 00:21:51,960
إنّهم يتحرّكون

299
00:21:51,960 --> 00:21:54,120
طاقم القسم 4 يُغادر أنّيكس 1

300
00:21:54,330 --> 00:21:57,090
...يمكنُنا الآن أن نتسلّل في غفلةٍ منهم

301
00:22:02,300 --> 00:22:04,740
!انظروا إلى ما لدينا هنا

302
00:23:38,260 --> 00:23:42,090
مهما كان عددهم كبيراً، سأقتلهم جميعاً