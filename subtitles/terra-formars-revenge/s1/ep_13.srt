1
00:00:01,890 --> 00:00:03,890
،في غضون ثانية أخرى

2
00:00:03,890 --> 00:00:06,770
.سيستعيدون السّيطرة على برج البثّ

3
00:00:07,230 --> 00:00:11,450
لكن ثمّة هجمة مباغتة شنّتها كائنات
.التّيرافورمار أدّت إلى تغيير الوضع

4
00:00:11,450 --> 00:00:13,700
،لا يستطيع ولف وبقيّة المدنيّين أداء أعمالهم

5
00:00:13,700 --> 00:00:15,580
.وتُركوا يائسين تمامًا

6
00:00:16,330 --> 00:00:19,010
.لكن كان هناك بصيص أملٍ واحد

7
00:00:19,470 --> 00:00:21,510
.أميليا فينكاتيش

8
00:00:21,510 --> 00:00:26,190
فعلت أصابعها النّحيلة والمرتعشة
.ما بوسعها لخلق الأمل

9
00:00:26,810 --> 00:00:28,990
،من أجل زملائها الّذين كانوا يترقّبون

10
00:00:28,990 --> 00:00:32,580
.ومن أجل كيجي الّذي عمل على حمايتها

11
00:00:38,040 --> 00:00:41,140
.لن أدع ذلك يذهب هباءً يا رفاق

12
00:00:43,760 --> 00:00:46,640
،أحسنت صنعًا بإيصالنا إلى هنا

13
00:00:48,310 --> 00:00:49,490
...يا ولف

14
00:00:50,990 --> 00:00:56,370
وأنت يا كينجي، قاتلت حتّى أصبحت
...شبه عاجز عن النّهوض

15
00:01:05,770 --> 00:01:08,180
!لن أدع ذلك يذهب هباءً

16
00:02:42,640 --> 00:02:44,430
ماذا ستفعل

17
00:02:45,600 --> 00:02:47,890
إن لم نستطع استعادة الاتّصالات؟

18
00:02:49,320 --> 00:02:53,240
.ستضيع كلّ جهودنا سدى

19
00:02:54,330 --> 00:02:55,990
...جهودنا

20
00:02:56,620 --> 00:02:58,210
.الواسعة

21
00:02:58,540 --> 00:03:03,350
.أعتقد أنّهم سيفعلونها

22
00:03:13,950 --> 00:03:17,290
...ريويتشي، أطلق خيطًا نحو القمّة

23
00:03:18,160 --> 00:03:19,460
!لا أستطيع

24
00:03:19,460 --> 00:03:21,550
!لا أستطيع إطلاقها سوى مرّة واحدة

25
00:03:22,050 --> 00:03:24,430
!لهذا رتبتي هي 70

26
00:03:25,800 --> 00:03:27,140
...أنا

27
00:03:32,820 --> 00:03:35,200
.هـ-هذا سيّئ

28
00:03:35,200 --> 00:03:38,990
لقد تجاوزت الحدّ الزّمنيّ الّذي أستطيع
.خلاله تحمّل السّمّ منذ فترة طويلة

29
00:03:40,420 --> 00:03:42,220
.سنموت جميعًا

30
00:03:42,670 --> 00:03:46,890
...كيجي... الّذي استهلك كلّ طاقته

31
00:03:46,890 --> 00:03:48,560
!على وشك أن يموت

32
00:04:00,170 --> 00:04:01,840
!اللّعنة

33
00:04:01,840 --> 00:04:04,510
!لن أموت هنا

34
00:04:17,950 --> 00:04:21,920
.اخرسوا! هذه الهسهسة مزعجة

35
00:04:22,460 --> 00:04:24,880
هل الوقت مناسب للضّحك يا أكاري؟

36
00:04:25,670 --> 00:04:27,430
.التزم بوعدك

37
00:04:28,970 --> 00:04:32,570
.فقد قطعت وعدًا مهمًّا على ذلك الفتى

38
00:04:33,020 --> 00:04:34,730
.إن كنتَ عاجزًا عن الوفاء به، سأقتلك

39
00:04:37,200 --> 00:04:39,290
.اسمي هاروكازي ساكوراتو

40
00:04:42,880 --> 00:04:47,510
.سنسافر إلى المرّيخ لإيجاد طريقة نعالج بها مرضك

41
00:04:47,510 --> 00:04:48,300
حقًّا؟

42
00:04:49,270 --> 00:04:50,650
!اترك الأمر لي

43
00:04:51,400 --> 00:04:53,820
أستطيع الوثوق بك والانتظار، صحيح؟

44
00:04:54,070 --> 00:04:56,400
.سأفي بذاك الوعد مهما كلّف الأمر

45
00:04:56,400 --> 00:04:57,860
!جيّد

46
00:05:01,120 --> 00:05:02,830
.الجميع يقاتلون

47
00:05:03,540 --> 00:05:04,710
...هل هم إذًا

48
00:05:17,860 --> 00:05:19,830
.لن أدعها تذهب هباءً

49
00:05:21,250 --> 00:05:22,540
!مهما كلّف الأمر

50
00:05:22,620 --> 00:05:25,340
تصنيف "مارس": 77
أميليا فينكاتيش
القسم اليابانيّ الأمريكيّ المشترك 2
أساس العمليّة الجراحيّة: حوت التّامور

51
00:05:31,560 --> 00:05:34,060
،لست بحاجةٍ لأيّ شيء سوى عينيّ وأصابعي

52
00:05:34,810 --> 00:05:36,360
.وعقلي الآن

53
00:05:40,950 --> 00:05:42,910
.يغطس الحوت في الأعماق ولمدّة طويلة

54
00:05:42,910 --> 00:05:48,040
عندما يفعل ذلك، يعطّل أعضائه
.الحيويّة الّتي لا يحتاجها

55
00:05:48,460 --> 00:05:52,140
.وأميليا أيضًا قد عطّلت معظم أعضائها الحيويّة

56
00:06:03,120 --> 00:06:06,210
لماذا تركض؟

57
00:06:10,480 --> 00:06:13,040
.الجميع يحتفلون

58
00:06:18,670 --> 00:06:22,090
.لقد ركضتُ لمدّة ساعة حتّى الآن

59
00:06:22,630 --> 00:06:24,310
.لا بدّ وأنّهم نسوا أمري

60
00:06:25,270 --> 00:06:27,730
.أنت دومًا هكذا

61
00:06:27,730 --> 00:06:30,440
.لا تتكاسل حتّى خلال التّدريب القاسي

62
00:06:30,440 --> 00:06:32,610
كيف تستطيع فعل ذلك؟

63
00:06:37,040 --> 00:06:38,250
لماذا؟

64
00:06:39,750 --> 00:06:41,550
هل هي مجرّد عادة؟

65
00:06:41,550 --> 00:06:46,390
أم أنّ "بذل الجهد أمر مهمّ" أمر تؤمن به؟

66
00:06:47,560 --> 00:06:49,020
.لا أدري

67
00:06:50,360 --> 00:06:52,910
.لست مهتمًّا بالمجهود بحدّ ذاته

68
00:06:53,290 --> 00:06:54,870
،لا بالمسافة الّتي قطعتها

69
00:06:56,620 --> 00:06:58,540
،إذا ركّزت كثيرًا على أولويّة ما خلال العمليّة

70
00:06:58,540 --> 00:07:02,000
.فسترضين بتلك النّتيجة وتفقدين رؤية هدفك الأصليّ

71
00:07:02,380 --> 00:07:03,760
.هذا خطير

72
00:07:05,020 --> 00:07:06,470
لماذا إذًا؟

73
00:07:08,350 --> 00:07:10,900
...عندما أصبحت بطل العالم

74
00:07:10,900 --> 00:07:12,820
بطل العالم؟

75
00:07:14,740 --> 00:07:17,040
.آسفة، استهنت بك

76
00:07:17,040 --> 00:07:18,540
.لا مشكلة

77
00:07:20,500 --> 00:07:22,630
.كانت متكافئة جدًّا

78
00:07:23,600 --> 00:07:26,810
.ربحت بقرار الحكم، في معركة متكافئة جدًّا

79
00:07:27,350 --> 00:07:31,940
كانت المرّة الأولى الّتي أشعر فيها
.أنّني حصدت ثمرات تدريبي

80
00:07:31,940 --> 00:07:33,990
حصدت ثمرات تدريبك؟

81
00:07:34,570 --> 00:07:39,200
أتدرّب كي أبذل مجهودًا إضافيًّا بسيطًا
.كلّما استدعت الحاجة لذلك

82
00:07:40,250 --> 00:07:44,680
لا أدري ما إن كان الجري سيفيدني
،في تنفيذ مهمّاتي على المرّيخ

83
00:07:45,010 --> 00:07:49,890
لكن أعتقد أنّني أفعل هذا كي أكون قادرًا
.على العطاء قليلاً عندما يحين الوقت لذلك

84
00:07:51,640 --> 00:07:55,280
.حسنًا، أودّ المشاركة في الحفلة المقبلة

85
00:07:56,830 --> 00:07:58,120
...تفضّل

86
00:08:06,300 --> 00:08:07,760
.إنّه لذيذ

87
00:08:13,320 --> 00:08:16,200
أهذا هو آخر شيء أتذكّره إذًا؟

88
00:08:17,030 --> 00:08:18,320
.عرفت ذلك

89
00:08:21,540 --> 00:08:27,010
.أحبّك يا كيجي

90
00:08:28,430 --> 00:08:29,930
.لا أريد أن أموت

91
00:08:30,430 --> 00:08:31,970
!لا أريد أن أموت

92
00:08:48,720 --> 00:08:52,510
...لكن هذا محبط للغاية

93
00:08:54,570 --> 00:08:56,610
.كيجي حمانا

94
00:08:57,450 --> 00:08:59,860
.وإيريكا أحضرتنا إلى هنا

95
00:09:00,950 --> 00:09:04,550
...بينما أنجز ولف والآخرون إنجازاتٍ كثيرة

96
00:09:08,930 --> 00:09:12,050
وكلّ ذلك تطلّب جهدًا إضافيًّا بسيطًا
.في حين أنّني لم أستطع تقديم المزيد

97
00:09:13,150 --> 00:09:16,110
!هذه قمّة في الإحباط

98
00:09:17,650 --> 00:09:21,660
.كيجي، الآن قد فهمت

99
00:09:22,160 --> 00:09:25,170
.ركضك الدّائم كان يحمل في طيّاته معنى

100
00:09:25,960 --> 00:09:28,210
وإصرار ولف على عدم الاستقالة كمهندس

101
00:09:28,210 --> 00:09:31,680
،رغم أنّ كلّ الأمور قد انقلبت ضدّه
.يحمل في طيّاته معنى أيضًا

102
00:09:32,830 --> 00:09:34,660
...سأصنعه

103
00:09:37,530 --> 00:09:39,530
...سأمسك به بإحكام

104
00:09:42,790 --> 00:09:44,920
...ذاك "الجهد البسيط" الّذي مددتموني به

105
00:09:45,670 --> 00:09:49,670
...ومن ثمّ

106
00:09:51,380 --> 00:09:55,480
،يمكننا القول أنّ معركتنا الّتي خضناها هي ذات معنى

107
00:09:56,440 --> 00:09:57,520
أليس كذلك؟

108
00:10:04,170 --> 00:10:06,670
،حالما أضغط هذا الزّرّ

109
00:10:07,710 --> 00:10:09,210
،قل لي أنّني أبليت حسنًا

110
00:10:10,090 --> 00:10:11,130
...يا كيجي

111
00:10:37,270 --> 00:10:39,020
ميشيل-سان، هل كان ذلك؟

112
00:10:46,910 --> 00:10:49,170
...أيّها القائد ليو، هذا

113
00:10:49,170 --> 00:10:51,000
.هذا سيّئ

114
00:10:51,000 --> 00:10:52,130
هل نالوا منّا؟

115
00:10:52,890 --> 00:10:55,680
.لن يستغرق تشغيل برنامج الدّعم إلاّ 10 ثوانٍ

116
00:11:05,580 --> 00:11:09,580
لكن أعتقد أنّني أفعل هذا كي أكون قادرًا على بذل
.القليل من المجهود عندما يحين الوقت لذلك

117
00:11:11,170 --> 00:11:13,640
...عليّ أن أخبرهم

118
00:11:14,430 --> 00:11:17,640
.عليّ أن أقولها

119
00:11:18,140 --> 00:11:22,310
.عليّ استعادة رئتيّ وحنجرتي

120
00:11:33,640 --> 00:11:35,810
...كيجي... والجميع

121
00:11:46,120 --> 00:11:49,080
!لقد التقطناها! مصدرها غرفة تحكّم أنيكس 1

122
00:11:49,080 --> 00:11:51,290
.لدينا دراية بالوضع

123
00:11:51,290 --> 00:11:53,340
.ينبغي أن يخبرونا عمّا يجري

124
00:11:53,340 --> 00:11:55,220
.لا تفوّتوا كلمة

125
00:11:56,760 --> 00:11:59,220
!تكلّمي! تكلّمي! تكلّمي

126
00:11:57,760 --> 00:12:00,270
اتّصال من غرفة التّحكّم في أنيكس 1

127
00:11:59,560 --> 00:12:00,270
!تكلّمي

128
00:12:06,620 --> 00:12:09,370
...أنقذونا

129
00:12:13,800 --> 00:12:15,010
.هذا سيّئ

130
00:12:15,010 --> 00:12:19,260
.لم تقل ما أردنا سماعه

131
00:12:19,260 --> 00:12:22,680
فشلٌ في الاتّصال

132
00:12:19,600 --> 00:12:24,030
كان الاتّصال الوحيد الّذي تلقّيناه
.من أنيكس 1 إلى مقرّ اليوناسا

133
00:12:25,150 --> 00:12:26,990
.لم نحصل على ما أردناه

134
00:12:26,990 --> 00:12:29,580
.كانت مجرّد صيحة نجدة

135
00:12:29,580 --> 00:12:31,540
...أنقذونا

136
00:12:32,290 --> 00:12:32,880
"!سي"

137
00:12:32,880 --> 00:12:33,300
"!دا"

138
00:12:33,300 --> 00:12:33,840
"!يا"

139
00:12:33,840 --> 00:12:34,510
!نعم

140
00:12:34,510 --> 00:12:35,470
!عُلم

141
00:12:45,220 --> 00:12:46,430
...كيجي

142
00:12:46,970 --> 00:12:48,020
...والجميع

143
00:12:48,640 --> 00:12:51,480
...لا أستطيع أن أخطو خطوة أخرى

144
00:12:51,480 --> 00:12:52,990
...أنقذونا

145
00:12:52,990 --> 00:12:55,410
.لكن بمجرّد أن أقول هذا، فسأكون معكم

146
00:12:55,950 --> 00:13:00,500
...دعوني أبقى معكم للأبد

147
00:12:58,120 --> 00:12:58,910
...أنقذونا

148
00:13:03,430 --> 00:13:04,430
!جاريد

149
00:13:04,430 --> 00:13:05,640
هل أميليا هي الأخيرة؟

150
00:13:06,010 --> 00:13:07,810
!نعم! بسرعة

151
00:13:08,260 --> 00:13:09,390
!إنّي أسمع هذا

152
00:13:09,390 --> 00:13:12,440
!إنّهم هنا! جيش ضخم من التّيرافورمار

153
00:13:25,300 --> 00:13:26,680
ثلاث سفن؟

154
00:13:26,680 --> 00:13:27,550
ما الأمر؟

155
00:13:27,550 --> 00:13:28,800
،رغم أنّ ذلك استمرّ لدقيقة فقط

156
00:13:28,800 --> 00:13:30,970
.لكن حصلنا على معلومات مراقبة من برج البثّ

157
00:13:30,970 --> 00:13:34,400
مفادها أنّ سفينة الإنقاذ المصفّحة
والتّابعة للمكتب الفرعي رقم 4

158
00:13:34,400 --> 00:13:37,570
تتوجّه نحو المرّيخ بسرعة أكبر ممّا ورد
.في المعلومات المعلنة

159
00:13:37,570 --> 00:13:38,950
ماذا؟

160
00:13:38,950 --> 00:13:40,160
.هذا ليس كلّ شيء

161
00:13:40,160 --> 00:13:41,120
.هنالك سفينتان إضافيّتان

162
00:13:41,120 --> 00:13:45,300
!هنالك ثلاث سفن متوجّهة نحو المرّيخ سرًّا الآن

163
00:13:46,930 --> 00:13:50,550
.يبدو أنّ الاتّصالات مع الأرض قد عادت لبضعة ثوانٍ فقط

164
00:13:50,930 --> 00:13:55,070
إنّ خطّة متابعة المهمّة الأصليّة
.قد أصبحت صعبة على الأرجح

165
00:13:55,490 --> 00:13:58,490
.أعيدوا الأولى والثّاني حتّى لو اضطررتم لقتلهما

166
00:13:58,490 --> 00:14:00,410
.واجتمعوا في النّقطة المحدّدة

167
00:14:00,410 --> 00:14:03,460
.سنغادر المرّيخ فورًا

168
00:14:07,220 --> 00:14:08,510
...هل اتّصالاتنا

169
00:14:09,130 --> 00:14:12,050
.عادت للعمل، لكنّها سرعان ما انقطعت

170
00:14:13,480 --> 00:14:14,570
...إذًا الجميع

171
00:14:14,820 --> 00:14:16,110
.لا أدري

172
00:14:16,110 --> 00:14:19,240
،إمّا اشتغل برنامج لحجب الاختراق البرمجيّ

173
00:14:19,240 --> 00:14:20,450
...أو

174
00:14:20,950 --> 00:14:22,530
.هيّا بنا نعود يا ميشيل-سان

175
00:14:22,530 --> 00:14:24,550
...إن حدث شيء في أنيكس

176
00:14:24,550 --> 00:14:28,420
.لا، كانت أوامر القبطان أن نتوجّه شمالاً

177
00:14:28,880 --> 00:14:31,640
.سنؤمن بالجميع حتّى الرّمق الأخير

178
00:14:36,400 --> 00:14:38,320
.لست في الجنّة

179
00:14:38,320 --> 00:14:39,780
جاريد؟

180
00:14:39,780 --> 00:14:42,530
إن لم أكن في الجنّة فأين أنا؟

181
00:14:43,330 --> 00:14:46,340
...شلّ السّمّ حركتي

182
00:14:49,380 --> 00:14:51,720
.كان بحوزتها ترياق

183
00:14:51,720 --> 00:14:54,060
.يُزعم أنّها استخلصته من جسدها

184
00:14:54,810 --> 00:14:57,110
،إنّه سمّ قويّ

185
00:14:57,110 --> 00:15:00,490
،لذا حقنة واحدة فقط لن تكون كافية لمعالجتك

186
00:15:00,490 --> 00:15:02,530
.لكنّها أعطتنا إيّاه دون مشاكل

187
00:15:08,670 --> 00:15:11,300
.لقد تمّ الاستيلاء على أنيكس 1

188
00:15:12,170 --> 00:15:13,140
.لا

189
00:15:13,140 --> 00:15:15,850
.يمكن القول أنّه تمّ تفكيكها

190
00:15:16,190 --> 00:15:20,230
.توافدوا بمعدّل مخيف وبأعداد هائلة

191
00:15:21,070 --> 00:15:23,290
حدث ذلك بعدما سمعنا بثًّا بواسطة تيرافورمار

192
00:15:23,290 --> 00:15:25,500
.داخل السّفينة لسببٍ ما

193
00:15:25,500 --> 00:15:28,540
.لا أعرف ماذا قالوا بلغتهم

194
00:15:28,540 --> 00:15:32,630
.ربّما قالوا أنّ السّمّ كان قد بدأ يفقد مفعوله

195
00:15:33,180 --> 00:15:38,110
ربّما ارتأوا أنّه لم يكن هنالك حاجة للتّعامل بحذر

196
00:15:38,110 --> 00:15:39,690
.مع سفينة أنيكس بحدّ ذاتها

197
00:15:39,690 --> 00:15:40,900
،حضرة القبطان

198
00:15:40,900 --> 00:15:44,410
...ليس هذا ما أريد معرفته

199
00:15:44,410 --> 00:15:46,210
،سبب كوني على قيد الحياة

200
00:15:46,210 --> 00:15:48,040
،وما حلّ بكائنات التّيرافورمار

201
00:15:48,040 --> 00:15:49,920
.هذا لا يهمّ

202
00:15:50,250 --> 00:15:53,470
.لا أذكر أنّني من النّوع الّذي يقول ما يحلو له

203
00:15:53,890 --> 00:15:55,430
...فعلت ما بوسعي، لكن

204
00:15:56,350 --> 00:15:58,270
!لم ينجح الأمر

205
00:16:01,480 --> 00:16:05,160
لم تستطيعي التّحدّث سوى لعشر ثوانٍ، أليس كذلك؟

206
00:16:05,160 --> 00:16:08,870
.خلال تلك الفترة، اتّصلت بأمريكا أو اليابان

207
00:16:10,460 --> 00:16:13,430
وفي نفس الوقت، أصبح مذياع الضّابط متّصلاً

208
00:16:13,430 --> 00:16:16,310
.وتمكنّا من سماع كلّ شيء

209
00:16:18,850 --> 00:16:20,440
.فعلها ذلكما الاثنان

210
00:16:22,650 --> 00:16:24,990
مكتب فرع ألمانيا، هل تسمعوننا؟

211
00:16:24,990 --> 00:16:27,410
!لقد خاننا القسم رقم 4

212
00:16:28,330 --> 00:16:31,170
!أرسلوا التّعزيزات! أنا ميشيل ك. ديفيس

213
00:16:31,710 --> 00:16:34,760
!شاركوا هذه المعلومات مع كافّة المكاتب الفرعيّة

214
00:16:37,560 --> 00:16:42,690
تلك الثّواني العشرة الّتي ضحّيتم
بأرواحكم لتأمينها لنا أيّها المدنيّون

215
00:16:42,690 --> 00:16:46,490
.غيّرت مصير هذا الكوكب وأنقذتنا

216
00:16:47,290 --> 00:16:49,200
.شكرًا لك يا أميليا

217
00:16:49,200 --> 00:16:51,160
.أبليتم حسنًا

218
00:16:51,160 --> 00:16:56,470
!شكرًا لكم يا كيجي وولف وإيريكا وريويتشي وريوجي

219
00:16:56,970 --> 00:16:59,310
،لحقنا بأكاري وميشيل

220
00:16:59,310 --> 00:17:02,060
.لكنّنا صادفنا كائنات التّيرافورمار فتأخّرنا

221
00:17:02,390 --> 00:17:07,030
قرّرنا العدول عن مطاردتهما وعدنا
.لنقلكم أنتم المدنيّون

222
00:17:07,030 --> 00:17:11,660
ومن ثمّ صادفونا عندما هربنا
.من أنيكس 1 عبر الدّرّاجات الجوّيّة

223
00:17:14,760 --> 00:17:17,300
،فقد كثيرٌ من زملائنا أرواحهم

224
00:17:17,300 --> 00:17:19,850
.لكن نجحت المهمّة

225
00:17:20,470 --> 00:17:23,030
.لقد أدّيتم عملاً مذهلاً جميعًا

226
00:17:52,370 --> 00:17:56,220
،هونغ هناك بالكاد تعرف شيئًا عن العمليّة

227
00:17:56,220 --> 00:18:00,010
لكن ينبغي أن تكون شي تشون-لي على دراية
.بكيفيّة التّواصل مع زملائها

228
00:18:00,010 --> 00:18:01,760
،عندما تستيقظ

229
00:18:01,760 --> 00:18:04,400
سأدعها تتواصل مع ليو عن طريق
.أدوات اتّصال الدّرّاجة الجوّيّة

230
00:18:05,150 --> 00:18:07,990
.وأخبره أنّ خطّته قد انكشفت

231
00:18:08,660 --> 00:18:10,660
.سيؤدّي هذا إلى إنهاء هذه المعركة

232
00:18:11,320 --> 00:18:12,960
.حتمًا

233
00:18:13,300 --> 00:18:16,210
.لم يعد هنالك أيّ داعٍ للقتال بعد الآن

234
00:18:16,880 --> 00:18:20,640
.ماذا؟ هذا محزنٌ للغاية

235
00:18:20,640 --> 00:18:24,690
.إن صحّ ذلك، فلا أستطيع وصفه إلاّ بالمحزن

236
00:18:25,150 --> 00:18:27,530
.هدفنا ورغبتنا لم يتغيّرا

237
00:18:28,450 --> 00:18:30,610
،حتّى لو كنّا عاجزين عن العودة إلى الأرض

238
00:18:31,110 --> 00:18:33,840
.لن ندعكم تحصلون على هيزامارو أكاري

239
00:18:34,250 --> 00:18:35,920
.التقطتها للتّوّ

240
00:18:35,920 --> 00:18:38,260
.جاري إدخال إحداثيّات تمركز الوحدة 1

241
00:18:42,510 --> 00:18:43,810
!الآن

242
00:18:43,810 --> 00:18:46,780
.أطلق الصّاروخ نحو هيزامارو أكاري

243
00:18:49,900 --> 00:18:51,530
.لن يحدث هذا

244
00:18:52,530 --> 00:18:54,460
.ينتهي الأمر هنا

245
00:19:03,940 --> 00:19:07,270
.هذا هو الجزء الأسوأ الآن

246
00:19:08,860 --> 00:19:10,070
.أجل

247
00:19:10,280 --> 00:19:15,920
هذه هي المرّة الأولى في حياتي الّتي أشعر
.فيها بسعادةٍ كوني على قيد الحياة

248
00:19:16,840 --> 00:19:18,340
أأنت أيضًا يا ميشيل-سان؟

249
00:19:18,340 --> 00:19:20,510
لماذا يا ترى؟

250
00:19:20,510 --> 00:19:21,550
...يا إلهي

251
00:19:22,510 --> 00:19:25,810
.آمل أن يساهم هذا في تحسّنه

252
00:19:27,310 --> 00:19:28,730
ساكوراتو؟

253
00:19:28,730 --> 00:19:30,480
هل كان هذا اسمه؟

254
00:19:31,610 --> 00:19:35,290
.يسرّني أنّنا تمكنّا من الحفاظ على نبض الأمل

255
00:19:35,830 --> 00:19:37,170
.ميشيل-سان

256
00:19:38,250 --> 00:19:39,840
هل تستطيع تولّى القيادة؟

257
00:19:39,840 --> 00:19:40,960
.بالتّأكيد

258
00:19:40,960 --> 00:19:44,140
.آسفة، أحتاج للرّاحة

259
00:19:47,810 --> 00:19:49,610
.لقد نامت هنا

260
00:19:49,610 --> 00:19:53,700
.لكنّها أصبحت ظريفة جدًّا الآن

261
00:19:56,040 --> 00:19:58,080
.لم أنم بعد

262
00:19:58,380 --> 00:20:00,340
لِمَ لا؟

263
00:20:00,340 --> 00:20:01,840
هل هذه غلطتي؟

264
00:20:01,840 --> 00:20:03,220
.لا، اخلدي إلى النّوم

265
00:20:03,220 --> 00:20:06,560
...أشعر بغيرةٍ شديدة من حبّ بعضهما لبعض

266
00:20:11,900 --> 00:20:15,250
،أعتقد أنّنا سنلتقي جميعًا بسلام

267
00:20:15,250 --> 00:20:18,460
.لكن إن حدث مكروه وعجزنا عن التّجمّع في أنيكس 1

268
00:20:18,460 --> 00:20:19,710
.فاهربوا نحو الشّمال

269
00:20:20,250 --> 00:20:22,500
.فإن كان هنالك أمل، ستجدونه هناك

270
00:20:27,310 --> 00:20:30,520
حضرة القبطان، إلى أين سنذهب؟

271
00:20:31,020 --> 00:20:32,650
!نعم، نحو الشّمال

272
00:20:34,030 --> 00:20:35,370
!توجّهوا نحو الشّمال

273
00:20:36,240 --> 00:20:37,500
!سنذهب إلى البحر

274
00:20:41,830 --> 00:20:43,430
!إلى البحر

275
00:21:00,710 --> 00:21:01,960
!هوّن عليك

276
00:21:01,960 --> 00:21:04,840
.لهذا قلت لك ألاّ تشتري سيّارةً قديمة

277
00:21:04,840 --> 00:21:05,800
.لحظة، لحظة

278
00:21:05,800 --> 00:21:06,850
.ثمّة قرية أمامنا

279
00:21:06,850 --> 00:21:09,520
لنستفسر عن الاتّجاهات، قد يكون
.هناك مكان نمكث فيه

280
00:21:23,840 --> 00:21:25,470
ما خطبهم؟

281
00:21:25,470 --> 00:21:26,680
هذه ليست إنجليزيّة، صحيح؟

282
00:21:26,680 --> 00:21:27,970
أيّ لغة هذه؟

283
00:21:27,970 --> 00:21:29,390
!يا للهول! هيّا بنا نعود

284
00:21:29,390 --> 00:21:30,470
.هؤلاء مهاجرون غير شرعيّين

285
00:21:31,020 --> 00:21:32,730
.أقرأ عنهم كثيرًا عبر الإنترنت مؤخّرًا

286
00:21:32,730 --> 00:21:35,240
.يقيمون في قرى مهجورة

287
00:21:35,700 --> 00:21:38,030
.لا يتكلّمون بلغتنا ولا أحد يعلم ما قد يفعلونه

288
00:21:38,030 --> 00:21:39,200
!لنهرب فحسب

289
00:22:06,930 --> 00:22:09,260
.سأترك بعضًا من الكاري لك

290
00:22:09,260 --> 00:22:10,890
.كل قبل أن يبرد

291
00:22:10,890 --> 00:22:13,900
!لا تقتربوا

292
00:22:13,900 --> 00:22:17,200
لم تخضع للامتحانات هذا العام، أليس كذلك؟

293
00:22:18,660 --> 00:22:21,910
...يقول العجوز ياماناشي أنّه سيبحث لك عن عمل

294
00:22:22,700 --> 00:22:24,500
!هذا صحيح

295
00:22:24,500 --> 00:22:26,340
ستصبح محاميًا، صحيح؟

296
00:22:27,170 --> 00:22:30,300
...آسفة لإزعاجك أثناء دراستك

297
00:23:03,500 --> 00:23:08,250
طريق طوكيو السّريع الجديد
الذّكرى السّنويّة الخمسمائة

298
00:23:13,310 --> 00:23:15,730
.سيكون هذا عراكًا بالأيدي

299
00:23:17,230 --> 00:23:18,940
.سنحتاج لمزيد من المقاتلين

300
00:23:20,900 --> 00:23:25,670
نحتاج لأكبر قدر ممكن من الخبراء
.المضادّين للتّيرافورمار

301
00:23:27,340 --> 00:23:28,840
!عودوا

302
00:23:30,800 --> 00:23:33,180
.لن أستسلم لمرضي

303
00:23:33,560 --> 00:23:34,770
...لذا

304
00:23:36,060 --> 00:23:37,650
...كن سالمًا أرجوك

305
00:23:38,360 --> 00:23:39,820
.يا هيزامارو-سان