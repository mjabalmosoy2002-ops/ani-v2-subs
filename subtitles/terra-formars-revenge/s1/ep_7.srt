1
00:00:03,120 --> 00:00:07,470
تمكّن القسم 4 من حماية أنّيكس 1 بصعوبة

2
00:00:09,210 --> 00:00:12,430
سارع قائدُهم ليو لأسْرِ الهدفَين

3
00:00:15,720 --> 00:00:20,940
أُطلِقَ صاروخان صوبَ أكاري وميشيل أثناء
مُقاتلتهما التيرافورمار

4
00:00:21,880 --> 00:00:26,170
...وعندما بلغت الأمور أشدّها، مُنِح أكاري

5
00:00:27,690 --> 00:00:33,060
سيف النّينجا المضادّ للتيرافورمار الذي أرسلَه ألكسندر

6
00:00:43,690 --> 00:00:45,880
اسمي ميناموتو يوريكو

7
00:00:46,290 --> 00:00:48,010
سأعيشُ معك هنا ابتداءً من اليوم

8
00:00:50,910 --> 00:00:51,760
من أنتِ؟

9
00:00:58,670 --> 00:01:01,240
أنا هاروكازي ساكوراتو

10
00:01:01,730 --> 00:01:02,780
!عمري عشرة

11
00:01:03,780 --> 00:01:06,130
أنا أقيمُ في هذا الفندق

12
00:01:06,530 --> 00:01:08,920
هذا اسمٌ أنيقٌ حقّاً

13
00:01:08,920 --> 00:01:10,090
ماذا عنك؟

14
00:01:16,500 --> 00:01:19,090
هيزامارو

15
00:01:17,130 --> 00:01:18,470
!هيزامارو

16
00:01:23,290 --> 00:01:25,790
أسلوب الشينغان الخاصّ بهيزامارو

17
00:01:27,240 --> 00:01:31,830
تُرِكتُ مهجوراً أمام نادي الدّوجو وذاك الاسم
مكتوب على الباب

18
00:01:32,920 --> 00:01:40,020
كانت الرّسالة مكتوبة بالإنجليزيّة واليابانيّة
والفرنسيّة... وبكلّ لغة

19
00:01:40,350 --> 00:01:42,120
.كُتبَتْ نفس الرّسالة بجميع اللّغات

20
00:01:42,500 --> 00:01:46,170
"...اعتنِ بهذا الطفل من فضلك، اسمه هو

21
00:01:47,090 --> 00:01:50,510
كان الاسمُ مختلفاً في كلّ لغة
لكن المقصَد هو ذاته

22
00:01:51,050 --> 00:01:52,260
"شعلة متوقِّدة"

23
00:01:53,710 --> 00:01:56,780
لماذا أخبرُك بهذا؟

24
00:01:57,910 --> 00:02:00,190
آسِف لكسبِ الوقت

25
00:02:00,680 --> 00:02:04,000
اسمي هيزامارو أكاري، معلّم أسلوب الشينغان الخاصّ بهيزامارو

26
00:02:06,450 --> 00:02:07,670
!هيّا نتقاتل

27
00:03:38,620 --> 00:03:40,670
عيد ميلاد سعيد

28
00:03:38,620 --> 00:03:40,670
اليوم الأوّل

29
00:03:43,570 --> 00:03:45,540
...ما زال عِوائهم مسموعاً

30
00:03:48,060 --> 00:03:51,200
اقتلهم... حتّى يكفّوا عن الحركة

31
00:03:52,430 --> 00:03:54,280
!اقتلهم جميعاً

32
00:03:54,860 --> 00:03:57,280
اقتلهم مهما كلّفَ الأمر

33
00:03:59,380 --> 00:04:03,740
تِلك الكراهيّة المُشتعِلة تكنُّها
البشريّة اتِّجاه الصّراصير فقط

34
00:04:03,740 --> 00:04:07,380
.وكذلك معدَّل التطوُّر المذهل

35
00:04:08,190 --> 00:04:11,500
ثمّة نظريّة تُفيد بأنّ هذه كانَتْ مخلوقات

36
00:04:11,500 --> 00:04:14,500
اصطناعيّة أنشأتها حضارةٌ قديمةٌ ما

37
00:04:15,120 --> 00:04:17,550
اسم الحضارة هو راحاب

38
00:04:17,550 --> 00:04:19,460
هنالِك دلالاتٌ على أنّ الاسم

39
00:04:19,460 --> 00:04:22,810
"يعني بالكتابة البشريّة "بيت الشّياطين

40
00:04:22,810 --> 00:04:26,530
وتُفيد هذه النظريّة بأنّ هنالك كوكب يقعُ بين المرّيخ والمُشتري

41
00:04:27,910 --> 00:04:31,970
كانَتْ تِلك الحضارة قادرة على السّفر
،في الفضاء. عدا عن المرّيخ

42
00:04:31,970 --> 00:04:34,800
سافروا أيضاً إلى الزهرة، والقمر

43
00:04:35,340 --> 00:04:40,470
وأوروبّا والأرض وتركوا أثاراً خلفهم

44
00:04:42,940 --> 00:04:46,080
خلتُها مجرّد نظريّة من نظريات المُؤامرة المجنونة تِلك

45
00:04:46,470 --> 00:04:50,710
لكن على مدى العقود العشرة الماضية
بدأت تتجلّى بوضوح

46
00:04:51,280 --> 00:04:54,360
لأنّنا رأينا أشياءً في المرّيخ لا يُمكِن تفسيرها

47
00:04:54,360 --> 00:04:57,260
إلّا بوجود تكنولوجيا مجهولة مُستخدَمة ما

48
00:04:57,880 --> 00:05:02,220
آثار المرّيخ ومعدَّل التطوُّر المذهل
...الذي تمتلكُه كائنات التيرافورمار

49
00:05:02,930 --> 00:05:04,840
تفيدُ النظريّة بأنّ هناك

50
00:05:04,840 --> 00:05:07,830
شيء ما في المرّيخِ هو ما يتحكّمُ بالتطوُّر

51
00:05:07,830 --> 00:05:10,150
وإن كانَ هناك من يستطيع فعل ذلك فهي حضارة راحاب

52
00:05:10,150 --> 00:05:13,490
حضارة قويّة لدرجة أنّها اعتُبِرَتْ إلَهاً في السّابِق

53
00:05:14,610 --> 00:05:17,190
،الرّجُل الذي يقِفُ وراء عمليّات باغز

54
00:05:17,190 --> 00:05:21,130
القائد ألكسندر غوستاف نيوتون هو من خرجَ بتِلك الفرضيّة

55
00:05:21,130 --> 00:05:25,250
والرّئيس الرُّوسي سميليس قد ساندَه من وراء الكواليس

56
00:05:25,920 --> 00:05:32,150
لِذا مهمّتنا هي إمّا إيجاد تِلك الأداة
،وإيقاف الحرب

57
00:05:32,150 --> 00:05:36,800
أو سرقتها كي تُصبِح البشريّة أكثر قوّة

58
00:05:37,380 --> 00:05:41,940
إمّا هذا أو ذاك... وبالطبع، الخيار الثّاني هو الأفضل

59
00:05:42,460 --> 00:05:46,360
،ولهذا عاينَ القسم 3 الإهرامات

60
00:05:47,430 --> 00:05:50,620
وتبيّن أنّ نظريّتنا كانَتْ خاطئة

61
00:05:50,620 --> 00:05:53,150
في الحقيقةِ لا يوجدُ شيء بهذا التطوُّر

62
00:05:54,410 --> 00:05:58,880
البشر قد دمّروا ونهبوا حضاراتٍ كثيرة في تاريخنا

63
00:05:59,750 --> 00:06:02,460
لكن هذه المرّة، لا نستطيعُ أن ندمِّر

64
00:06:02,460 --> 00:06:03,690
ولا نستطيعُ أن ننهب

65
00:06:03,690 --> 00:06:07,190
!لأنّها مُدمَّرة أصلاً

66
00:06:08,230 --> 00:06:11,730
،بُني هذا الكوكب من تقديرٍ خاطئ واحد

67
00:06:12,840 --> 00:06:18,170
.ومأساة أولئك الذين تُرِكوا خاليي الوفاض

68
00:06:25,140 --> 00:06:26,600
...هكذا إذاً

69
00:06:27,320 --> 00:06:31,050
لهذا أردتُ أن أمنحه اسمي عندما كان
عاجزاً حتّى عن النّطق

70
00:06:31,650 --> 00:06:33,140
...رائع

71
00:06:34,790 --> 00:06:36,620
!هؤلاء مُحاربون

72
00:06:37,210 --> 00:06:39,690
...ربّما تمرّنوا دون راحة

73
00:06:40,720 --> 00:06:44,000
لهزيمتِنا، رُغمَ أنّهم لم يكونوا يعلمون
أنّنا قادمون

74
00:06:44,640 --> 00:06:45,930
رائع

75
00:07:06,640 --> 00:07:08,820
أنا هيزامارو

76
00:07:09,990 --> 00:07:11,770
هيزامارو أكاري

77
00:07:13,210 --> 00:07:15,220
اسم رائع، صحيح؟

78
00:07:15,220 --> 00:07:16,330
هيزامارو-سان

79
00:07:17,470 --> 00:07:21,320
أعلمُ أنّك تريدُ شيئاً ما حتّى لو اضطررتَ لقتلي

80
00:07:22,300 --> 00:07:25,340
لكن لن أقبل بخسارة المزيد

81
00:07:25,960 --> 00:07:29,220
لِذا لا تتذمّر منّي إن ربِحت

82
00:07:41,150 --> 00:07:44,570
...عليّ الوصول إلى ميشيل-سان

83
00:07:46,260 --> 00:07:52,090
!ربّما تخوضُ معركةً الآن

84
00:07:58,030 --> 00:07:59,290
هذا مؤلم

85
00:08:04,850 --> 00:08:06,050
!ميشيل

86
00:08:06,530 --> 00:08:07,720
هل من السّليمِ أن تستيقظي؟

87
00:08:09,140 --> 00:08:11,680
أمّي، هل سمعتِ؟

88
00:08:11,680 --> 00:08:13,390
نعم، سمعت

89
00:08:13,850 --> 00:08:16,070
قالَت الشّرطة أنّه ربّما كان انفجاراً غازياً

90
00:08:16,690 --> 00:08:21,000
،تهشّمَتْ عظام أصدقائكِ في أماكن عدّة

91
00:08:21,000 --> 00:08:23,330
ولم يستيقظوا بعد ليتكلّموا عمّا حدث

92
00:08:25,000 --> 00:08:27,080
،أعلمُ أنني لا ينبغي أن أقول هذا

93
00:08:27,080 --> 00:08:29,430
.لكنّكِ محظوظة

94
00:08:30,150 --> 00:08:31,840
لا يا أمّي

95
00:08:32,410 --> 00:08:35,810
لم تكُن المسألة أنّني سعيدة الحظّ
بعدمِ سقوط أنقاض عليّ

96
00:08:36,800 --> 00:08:38,240
لم يكُن هذا ما حدث

97
00:08:38,940 --> 00:08:42,950
أدركتُ في ذلك اليوم عندما كانَ عمري
ثلاثة عشر عاماً فقط

98
00:08:42,950 --> 00:08:46,880
بأنّني لا أستطيعُ العيش كفتاةٍ عاديّة بعد الآن

99
00:08:48,720 --> 00:08:52,060
كرهتُها

100
00:08:53,230 --> 00:08:55,340
كرهتُ تِلك القوّة كثيراً

101
00:08:55,850 --> 00:09:00,910
كان أبوكِ من خيرة الرِّجال الذين التقيتُ بهم

102
00:09:01,550 --> 00:09:04,680
ضحّى بحياته لحمايتنا

103
00:09:06,620 --> 00:09:08,660
،لم أتوقّع هذه النتيجة

104
00:09:09,180 --> 00:09:11,680
لكن أظنُّكِ قد توقّعتِ هذا إلى حدٍّ ما

105
00:09:12,540 --> 00:09:16,430
لقد أدركنا بأنّكِ ورثتِ عنه قوّته

106
00:09:17,800 --> 00:09:20,900
لطالما كان قلقاً عليكِ

107
00:09:20,900 --> 00:09:22,270
،هذا ليس عملاً سهلاً

108
00:09:22,270 --> 00:09:26,760
لكنّني على يقين بأنّه سيكونُ سعيداً
لو علمَ بأنّكِ ستأتين لرؤيته

109
00:09:28,340 --> 00:09:29,510
اذهبي لِلقائه

110
00:09:29,930 --> 00:09:32,480
أهلاً بكِ في فريق استكشاف المرّيخ

111
00:09:32,480 --> 00:09:36,900
وعيد ميلاد ثاني وعشرين سعيد يا ميشيل

112
00:09:41,530 --> 00:09:44,220
كلّ ما عرفتُه عن أبي كان هو أنّ

113
00:09:44,220 --> 00:09:48,590
شيئاً سرّياً ما قد حدثَ في المرّيخ
أدّى إلى وفاته

114
00:09:49,340 --> 00:09:55,260
وحتّى أنّني خلتُه قد هجرَني في حقيقة الأمر

115
00:09:56,240 --> 00:10:01,780
...لأنّني كنتُ أمتلكُ هذا الشّيطان في داخلي حسبما ظننت

116
00:10:03,350 --> 00:10:04,440
...لكن

117
00:10:11,390 --> 00:10:12,970
هل تعلمين يا ميشيل؟

118
00:10:13,600 --> 00:10:19,060
النّمل هو أقوى الحشرات

119
00:10:19,410 --> 00:10:20,710
حقّاً؟

120
00:10:20,710 --> 00:10:22,900
رائع، النّمل مذهلٌ يا أبي

121
00:10:25,790 --> 00:10:30,190
ما ظننتُه قوّة شيطان كانَ في الواقع قوّة أبي

122
00:10:30,730 --> 00:10:34,800
لطالما كانَتْ قوّة أبي هي الّتي تحميني

123
00:10:35,290 --> 00:10:37,560
القوّة التي ما كان ينبغي أن أحصل عليها

124
00:10:38,700 --> 00:10:41,380
شكراً لك يا أبي

125
00:10:49,910 --> 00:10:54,680
تساءلتُ لماذا كان أبي مهتمّاً كثيراً بالنّمل

126
00:10:55,690 --> 00:10:58,240
لكن الآن قد عرَفْت

127
00:10:58,690 --> 00:11:03,150
إنّهم أقوى بكثير من هذا

128
00:11:03,150 --> 00:11:05,530
!النّملُ هم الأقوى

129
00:11:05,530 --> 00:11:07,870
!إنّهم أقوى بكثير من هذا

130
00:11:07,870 --> 00:11:12,830
القوّة التي تركَها أبي لحمايتي
أقوى بكثير من هذا

131
00:11:18,830 --> 00:11:20,970
لقد عرفتُه يا بارابونيرا

132
00:11:21,570 --> 00:11:23,280
،سبب عدم موتي

133
00:11:24,260 --> 00:11:28,790
وسبب واجبي بحسمِ الأمور معك هُنا

134
00:11:28,790 --> 00:11:30,250
...ليس لأجلِ شخص ما

135
00:11:30,970 --> 00:11:35,510
إنّما لأجلِ أن أسترجع حياتي البشريّة

136
00:11:33,190 --> 00:11:35,580
سِلاح فريد: مِطرَقة ميشيل، أداة تسارُع نقيّة
من النّوع المفجِّر والمضادّة للتيرافورمار

137
00:11:36,410 --> 00:11:37,870
سأهزمُك

138
00:11:39,710 --> 00:11:41,060
...والآن

139
00:11:41,910 --> 00:11:44,220
ميشيل كي. ديفيس

140
00:11:41,910 --> 00:11:44,220
أساس العمليّة الجراحيّة: نمل مُنفجر + بارابونيرا

141
00:11:41,910 --> 00:11:44,220
التّصنيف المرّيخي 5

142
00:11:42,500 --> 00:11:43,760
انهض

143
00:11:52,000 --> 00:11:53,320
صلِّ

144
00:11:53,790 --> 00:11:56,600
وإن كان في ثقافتِك صلاة، فلتعلَم إذاً

145
00:11:57,500 --> 00:11:59,770
أنَّ التّنكيل بالجثّة

146
00:12:01,380 --> 00:12:03,510
يُغضِبُ خصومك أكثر من أي شيء آخر

147
00:12:29,340 --> 00:12:30,350
ما الأمر؟

148
00:12:30,900 --> 00:12:31,810
انهض

149
00:12:59,590 --> 00:13:01,000
عرفتُ هذا

150
00:13:03,030 --> 00:13:06,510
لم يرد والدي الانتقام

151
00:13:08,770 --> 00:13:11,930
،حتّى لو هزمتُ أولئك الذين سرقوا جثمانه

152
00:13:13,170 --> 00:13:16,250
.فإنّه لن يعود

153
00:13:16,680 --> 00:13:19,800
أعلمُ كلّ هذا

154
00:13:23,310 --> 00:13:26,930
لكن من ناحية ثانية، ماذا عن روحي؟

155
00:13:28,790 --> 00:13:31,990
لن أعيش حياةً طبيعيّة أبداً

156
00:13:31,990 --> 00:13:33,060
ماذا عن روحي إذاً؟

157
00:13:35,530 --> 00:13:38,270
وزني يفوق الـ80 كيلوغراماً

158
00:13:38,900 --> 00:13:41,680
أستطيعُ سماع أصوات لا يسمعها الآخرون

159
00:13:42,420 --> 00:13:44,780
وأحياناً يظهرُ لي قرون استشعار

160
00:13:45,830 --> 00:13:47,890
مع من أستطيعُ التكلُّم حولَ ذلك؟

161
00:13:48,600 --> 00:13:52,510
من أستطيعُ مُشاطرته قلبي؟

162
00:13:53,100 --> 00:13:55,670
لهذا أصبحتُ وحيدة

163
00:13:56,580 --> 00:13:59,810
لكن حتّى لو تظاهرتُ بنسيانِ جسدي

164
00:13:59,810 --> 00:14:02,930
ونسيان موت والدي، حتّى بعدَ رغبتي

165
00:14:03,780 --> 00:14:06,400
،الشّديدة بمعرفةِ الحقيقة

166
00:14:06,400 --> 00:14:08,710
...وادّعيتُ أنّني أعيش حياةً طبيعيّة

167
00:14:09,840 --> 00:14:12,010
!ماذا سيحلُّ بروحي؟

168
00:14:13,440 --> 00:14:15,900
!لقد استخدمتَ الآن أسلحةَ بارابونيرا إذاً

169
00:14:18,490 --> 00:14:19,700
ماذا؟

170
00:14:19,700 --> 00:14:22,280
هل بدا لك أنّني كنتُ في خطرٍ كبير يا أليكس؟

171
00:14:22,280 --> 00:14:25,250
حسناً، إن كنتِ في خطر فسأساعدكِ

172
00:14:25,840 --> 00:14:27,830
،أنتِ مُقاتلة جيّدة

173
00:14:27,830 --> 00:14:29,560
،وقائدة جيّدة

174
00:14:30,050 --> 00:14:32,220
وفتاة جميلة

175
00:14:32,650 --> 00:14:35,610
،لكن إن اقتربتِ أكثر

176
00:14:35,610 --> 00:14:37,690
فلن أتمكّن من إطلاق النّار بدقّة

177
00:14:38,170 --> 00:14:39,660
لا مُشكلة، صحيح؟

178
00:14:39,660 --> 00:14:43,750
إن أردتِ حسم الأمور بنفسكِ كما خطّطنا في البداية

179
00:14:43,750 --> 00:14:46,670
فسأؤمِنُ بكِ

180
00:14:50,340 --> 00:14:51,660
هذا هو الأخير

181
00:14:52,160 --> 00:14:54,180
!لنُنهِ هذا الأمر

182
00:14:54,540 --> 00:14:56,650
...لم أعُد وحيدة

183
00:14:56,650 --> 00:14:59,820
...في قدَري

184
00:15:16,000 --> 00:15:18,680
...هذا مُؤلم

185
00:15:20,580 --> 00:15:25,410
!إلى الأمام

186
00:15:26,010 --> 00:15:27,380
!لا أريدُ أن أهرب

187
00:15:27,380 --> 00:15:28,630
!لا أريدُ أن أخسر

188
00:15:29,480 --> 00:15:32,670
...ليس هذا ما يريده أبي

189
00:15:32,940 --> 00:15:35,620
...لكن لأنّني لم أستطع الكذب

190
00:15:36,460 --> 00:15:38,390
!فهذا خياري الوحيد

191
00:15:43,670 --> 00:15:48,680
يايكو وأليكس، اصمتا ونفّذا الخطّة فحسب

192
00:15:48,680 --> 00:15:52,230
!أطلقوا ذلك الصّاروخ اللّعين الثّاني

193
00:15:53,410 --> 00:15:57,560
،عندما أدرك أكاري بأنّنا كنّا نقاتلُ البارابونيرا

194
00:15:57,560 --> 00:15:59,640
تدخّلَ فوراً

195
00:16:00,280 --> 00:16:03,820
جميعهم فعلوا ذلك لأجلي

196
00:16:07,090 --> 00:16:08,530
صحيح؟

197
00:16:10,590 --> 00:16:13,040
!لن أدعهم يفلتون بفعلتِهم هذه

198
00:16:19,220 --> 00:16:22,020
أكاري، أتتذكّرُ ما قلتَه؟

199
00:16:23,610 --> 00:16:25,860
!سنضعُ حدّاً لمصدرِ هذا الحزن

200
00:16:27,760 --> 00:16:29,400
!وداعاً يا بارابونيرا

201
00:16:29,790 --> 00:16:31,380
!سأتابعُ مهمّتي

202
00:17:07,770 --> 00:17:11,020
لا أستطيع أن أخطو خطوةً أخرى

203
00:17:11,440 --> 00:17:13,990
هل نكتفي بهذا القدر؟

204
00:17:16,180 --> 00:17:20,100
أمسِك بهم بالنيابة عنّي

205
00:17:20,860 --> 00:17:23,300
فأنا سيّئةٌ في ذلك

206
00:17:43,170 --> 00:17:45,630
شكراً لك يا أكاري

207
00:17:46,790 --> 00:17:51,270
تسعين للثأرِ لأنّكِ بحاجةٍ للقيام بهذا لنفسكِ

208
00:17:52,180 --> 00:17:56,110
المسألة لا تتعلّقُ بعودةِ يوريكو أو أبيكِ

209
00:17:56,790 --> 00:18:02,550
،لمُكافحة هذه الكارثة المجنونة التي تهدّدُ أرواحنا

210
00:18:03,550 --> 00:18:06,330
!سنضعُ حدّاً لمصدرِ هذا الحزن

211
00:18:11,930 --> 00:18:14,470
...أنا... هُنا

212
00:18:14,470 --> 00:18:16,560
أهلاً بعودتك

213
00:18:17,800 --> 00:18:20,830
هذا دخول آخر محرج للغاية

214
00:18:35,930 --> 00:18:38,170
أحسنتَ يا أكاري

215
00:18:38,590 --> 00:18:40,270
أنتِ أيضاً يا ميشيل

216
00:18:41,450 --> 00:18:42,840
نجَحْنا، صحيح؟

217
00:18:46,740 --> 00:18:49,130
تضع حدّاً لمصدرِ هذا الحزن؟

218
00:18:49,860 --> 00:18:53,150
عبارة رائعة جداً أسمعُها من فتى

219
00:18:53,980 --> 00:18:58,030
،لكن حالما تنتهي هذه المعركة

220
00:18:58,030 --> 00:19:02,120
أريدُكِ أن تفكّري بالعيش حياة طبيعيّة

221
00:19:03,580 --> 00:19:05,820
أنا متأكّدٌ أنّها ستكونُ ممتعة للغاية

222
00:19:13,530 --> 00:19:15,020
ما-ماذا؟

223
00:19:15,980 --> 00:19:17,450
...لا

224
00:19:17,450 --> 00:19:21,280
كنتُ أتذكّرُ كلّ ذلك الكلام الأناني الذي قلتَه لي

225
00:19:21,900 --> 00:19:26,640
أعني، حياة طبيعيّة؟ بعد كلّ هذا؟

226
00:19:26,640 --> 00:19:28,650
،أصبحتُ في الرّابعة والعشرين

227
00:19:28,650 --> 00:19:30,780
وقد كرّستُ حياتي كلّها لعملي

228
00:19:30,780 --> 00:19:32,090
فاتَ الأوانُ على ذلك

229
00:19:32,850 --> 00:19:36,570
لا مُشكلة، يمكنُكِ فعلها يا ميشيل-سان

230
00:19:36,570 --> 00:19:39,480
ولم تعودي في الرّابعة والعشرين

231
00:19:40,550 --> 00:19:45,240
فعيد ميلادكِ هو في التّاسع عشر من أبريل، صحيح؟

232
00:19:45,690 --> 00:19:47,810
إنّه اليوم على ما أعتقد

233
00:19:48,330 --> 00:19:50,680
إذا حسَبْنا من اليوم الذي وصَلْنا فيه إلى المرّيخ

234
00:19:52,810 --> 00:19:54,950
معك حقّ، إنّه اليوم

235
00:19:54,950 --> 00:19:55,890
أليس كذلك؟

236
00:19:56,400 --> 00:19:58,070
هكذا إذاً

237
00:19:58,070 --> 00:19:59,800
خمسة وعشرون

238
00:20:00,340 --> 00:20:02,100
حسناً، إنّه رقم صَحيح جميل

239
00:20:04,170 --> 00:20:06,870
وبعد خمس سنوات ستبلغين الثّلاثين

240
00:20:07,410 --> 00:20:09,230
لماذا أضفتَ خمس سنوات؟

241
00:20:09,230 --> 00:20:13,640
آه... آسف

242
00:20:13,640 --> 00:20:14,650
أسحبُ كلمتي

243
00:20:16,500 --> 00:20:21,320
بصراحة، كنتُ قلِقة حيال طبيعة الهُراء
الذي من المُتوقَّع أن أعمل معه

244
00:20:22,080 --> 00:20:24,510
،كانوا طاقماً قد تخلّى عن العَيش حياة طبيعيّة

245
00:20:24,510 --> 00:20:26,900
وأتوا للخضوعِ لتجارب على البشر

246
00:20:27,680 --> 00:20:30,640
لكن كنتُ مخطئة يا أبي

247
00:20:31,240 --> 00:20:33,720
ربّما لم يكن هذا ما أردته

248
00:20:34,340 --> 00:20:37,460
،لكن أتيتُ إلى هنا على أي حال

249
00:20:37,460 --> 00:20:40,260
وفي النّهاية، أُنعِمتُ بأصدقاء

250
00:20:40,750 --> 00:20:47,290
وهدفي في الحياة هو أقودهم وأقاتل إلى جانبهم

251
00:20:47,890 --> 00:20:50,970
عيد ميلاد سعيد

252
00:20:51,680 --> 00:20:54,080
نعم... شكراً لك

253
00:20:55,850 --> 00:21:02,650
امنحني مزيداً من الوقت حتّى أحلّ مُشكلة
فيروس المرّيخ يا أبي

254
00:21:06,300 --> 00:21:07,640
لنُسرِع

255
00:21:07,640 --> 00:21:09,810
أنا قلقةٌ على الكابتن كوماتشي والآخرين

256
00:21:10,270 --> 00:21:13,520
لم نتوقّع أن تكون هذه المعركة صعبة إلى هذا الحدّ

257
00:21:13,520 --> 00:21:17,290
لكن علينا الآن أن نذهب لإحضار
القسم 6 مهما حدث

258
00:21:18,390 --> 00:21:20,210
هل يمكنُك التحرُّك يا أكاري؟

259
00:21:20,210 --> 00:21:21,320
لا أدري

260
00:21:22,670 --> 00:21:25,720
لم أتوقّع أن أكسر هذا العدد الكبير من العِظام

261
00:21:26,530 --> 00:21:30,170
ينتابُني قلقٌ بشانِ إطلاق القسم 4 صاروخاً واحداً فقط

262
00:21:32,220 --> 00:21:36,050
نحتاجُ لأليكس ويايكو كي يأتيا ويأخذانا

263
00:21:36,410 --> 00:21:38,070
ألم يأتيا بعد؟

264
00:21:38,510 --> 00:21:42,030
ينبغي أن يكونا قد شاهدانا ونحنُ نربحُ المعركة

265
00:21:49,670 --> 00:21:51,220
يبدو أنّهما قد أتيا

266
00:21:59,770 --> 00:22:02,010
لقد وجدتُ الأوّل والثّاني

267
00:22:02,510 --> 00:22:03,770
جاري تأمينهما

268
00:23:38,500 --> 00:23:41,020
الرّتبة 50، باو زيلان