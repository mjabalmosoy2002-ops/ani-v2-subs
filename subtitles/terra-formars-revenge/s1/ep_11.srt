...وأنت يا ذا الرّتبة 8

186
00:17:10,840 --> 00:17:12,530
ألستَ غبيّاً؟

187
00:17:17,320 --> 00:17:18,210
!باو-سان

188
00:17:21,460 --> 00:17:24,200
هونغ، ادخلي غرفة الاتّصالات

189
00:17:24,560 --> 00:17:28,230
—سأبحثُ عن بقيّة الجرذان وأقتلهم

190
00:17:29,230 --> 00:17:30,620
!لن أدعك

191
00:17:32,450 --> 00:17:34,880
غيّرتَ نقطة التأثير في اللّحظة الأخيرة؟

192
00:17:34,880 --> 00:17:36,180
كنتُ مُستهتِرة

193
00:17:36,810 --> 00:17:39,340
لكن ما خطبُ هذه اليد؟

194
00:17:39,890 --> 00:17:42,430
لماذا لم تضربني من الخلف؟

195
00:17:42,430 --> 00:17:46,100
لا تقل لي لأنّك مُلاكم؟

196
00:17:47,770 --> 00:17:49,500
ليس لأنّني ملاكم

197
00:17:50,040 --> 00:17:51,440
بل لأنّني رجُل

198
00:17:53,190 --> 00:17:54,940
ماذا ستفعلُ إذاً؟

199
00:17:54,940 --> 00:17:57,970
كما خمّنت، إنّها من النّوع الجرثومي

200
00:17:58,360 --> 00:18:01,160
ما لم تقتلها وتقتلني، فلن تعجز

201
00:18:01,160 --> 00:18:03,270
،إلى دخول غرفة الاتّصالات فحسب

202
00:18:03,270 --> 00:18:04,670
!بل ستموتُ هنا أيضاً

203
00:18:05,110 --> 00:18:10,460
لا يهمّني فيما إن كنتَ تتحايل أو تتخلّى عن معتقداتك الآن

204
00:18:11,020 --> 00:18:12,400
فأنا سوف

205
00:18:12,880 --> 00:18:15,780
أقتلك حالاً على أي حال

206
00:18:16,240 --> 00:18:18,370
لم يطرأ أي تغيير

207
00:18:20,400 --> 00:18:21,840
أنا لا أضرب الفتيات

208
00:18:21,840 --> 00:18:23,280
هكذا إذاً

209
00:18:23,280 --> 00:18:26,480
!يعني إن متَّ هنا فسأقعُ في حبِّك

210
00:18:31,140 --> 00:18:32,960
كان ذلك وشيكاً

211
00:18:32,960 --> 00:18:34,820
!تحاولُ قتلي بالفعل

212
00:18:35,230 --> 00:18:37,030
إنّها مختلِفة عن الآخرين الذين قاتلتُهم

213
00:18:46,450 --> 00:18:48,480
تقنيّاتها وأسلوبها في الحركة

214
00:18:48,480 --> 00:18:50,420
وجسدها، كلّ ذلك مختلف تماماً عن المُلاكمة

215
00:18:51,460 --> 00:18:53,860
ماذا تعني أنّك لا تضرب الفتيات؟

216
00:18:54,700 --> 00:19:01,220
لستَ في الحلبة أو في صالة رقص
تحاولُ إثارة إعجاب سيّدة

217
00:19:01,630 --> 00:19:03,880
،قل لي على الأقلّ أنّك لا تريد أن تضرب فتاة

218
00:19:03,880 --> 00:19:09,100
،لكن مع ذلك تقرّر أن تقتلني عوضاً عن تركي أقتل أصدقائك

219
00:19:09,480 --> 00:19:11,270
!أيُّها المنافق

220
00:19:18,120 --> 00:19:20,740
!بمقدورك أن تقتلني بلكمة روبيان فرس النّبي

221
00:19:21,170 --> 00:19:22,210
افعل ذلك

222
00:19:22,590 --> 00:19:25,110
!تخلَّ عن سياستك الوضيعة وتقبّل الأمر فحسب

223
00:19:25,550 --> 00:19:27,760
وإلّا ستموت

224
00:19:38,020 --> 00:19:39,050
آسفة

225
00:19:39,460 --> 00:19:44,040
هذه هي الوسيلة الأسرع لإيقاف
ذوي الأنواع القشريّة المُصفّحة

226
00:19:44,440 --> 00:19:48,160
أنت المُلام لعجزِك عن أداء عملك اللّعين

227
00:19:49,140 --> 00:19:50,050
هيّا بنا

228
00:19:50,590 --> 00:19:52,060
—سنبحث عن الآخرين

229
00:20:05,760 --> 00:20:06,550
ماذا؟

230
00:20:06,830 --> 00:20:09,090
ما خطب هذا الرّجل؟ ما خطب هذا الرّجل؟
!ما خطب هذا الرّجل؟

231
00:20:10,060 --> 00:20:13,220
لن... أدعكِ تذهبين

232
00:20:14,340 --> 00:20:15,670
...توقّف

233
00:20:17,030 --> 00:20:19,700
لماذا لا يردّ الهجوم بعد كلّ هذا؟

234
00:20:22,460 --> 00:20:25,410
علّمَني أبي عندما كنتُ صغيراً

235
00:20:26,450 --> 00:20:28,690
ألّا أضرب امرأة

236
00:20:28,690 --> 00:20:30,620
وأن أكون لطيفاً معها

237
00:20:31,650 --> 00:20:37,520
أعلمُ على الأقلّ أنّني إذا ضربتُكِ
بقوّة روبيان فرس النّبي، ستموتين

238
00:20:39,100 --> 00:20:42,460
هدفي ليس قتلكِ

239
00:20:43,480 --> 00:20:45,300
...والآن هيّا

240
00:20:45,300 --> 00:20:47,360
لم أمُت بعد

241
00:20:47,800 --> 00:20:49,490
،لن أضرب فتاة

242
00:20:49,490 --> 00:20:51,720
ولن أدعكِ تقتلين أصدقائي

243
00:20:54,360 --> 00:20:56,230
هذا هو قراري

244
00:20:56,810 --> 00:20:58,570
لهذا أنا متشبّثٌ به

245
00:20:59,320 --> 00:21:01,620
!ومع هذا، لن أموت

246
00:21:03,060 --> 00:21:06,190
لأنّني... قويّ

247
00:21:12,320 --> 00:21:13,670
أجل

248
00:21:14,160 --> 00:21:18,940
هدفي ليس قتل أحد

249
00:21:42,790 --> 00:21:44,320
!بقيت ستّ دقائق

250
00:21:55,250 --> 00:21:57,510
!يمكننا فعلها

251
00:21:57,940 --> 00:21:59,770
!يمكننا استعادة البرج

252
00:22:00,240 --> 00:22:01,680
!حسناً يا جماعة

253
00:22:02,260 --> 00:22:04,040
!لنُنقذ العالم

254
00:23:38,930 --> 00:23:41,590
!هذه هي الضربة الأخيرة