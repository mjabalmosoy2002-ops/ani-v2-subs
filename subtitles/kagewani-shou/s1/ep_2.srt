1
00:00:20,500 --> 00:00:22,600
المعذرة حضرة المحقِّق

2
00:00:22,600 --> 00:00:24,440
هلّا أخذتُ قليلاً من وقتك؟

3
00:00:25,000 --> 00:00:26,060
تفضّل

4
00:00:27,130 --> 00:00:32,330
الطقسُ السيئ يعني أنّنا سنتأخّرُ عمّا هو مُخطَّط

5
00:00:32,730 --> 00:00:33,880
عُلِمَ ذلك

6
00:00:34,840 --> 00:00:38,900
شكراً لمُساعدتنا على نقلِ السّجين
في وسطِ عاصفةٍ كهذه

7
00:00:38,900 --> 00:00:40,250
لا شكر على واجب

8
00:00:46,900 --> 00:00:48,190
كيف سارت الأمور؟

9
00:00:48,190 --> 00:00:50,030
كان هادئاً جداً

10
00:00:50,030 --> 00:00:53,340
ما الذي فعلَه ذلك السّجين يا تُرى؟

11
00:00:54,110 --> 00:00:56,210
من المُحال أن تعرف حقيقةَ رجُل
بمُجرَّد إلقاء نظرة إليه

12
00:00:56,210 --> 00:00:59,970
من المُحتمَل أن يبدو شخصاً عادياً من الخارج
بينما هو سفّاحاً من الدّاخل

13
00:00:59,970 --> 00:01:01,790
نعم، معك حقّ

14
00:01:06,530 --> 00:01:07,670
ماذا؟

15
00:01:20,370 --> 00:01:21,720
ما-ماذا؟

16
00:01:25,900 --> 00:01:29,050
كفَّ عن التمثيل السيئ يا رقم 44

17
00:01:29,050 --> 00:01:32,270
أنا لستُ الرقم 44

18
00:01:32,270 --> 00:01:33,630
!كفاك عبَثاً

19
00:01:34,070 --> 00:01:36,210
لا يهمُّني اسمك

20
00:01:36,210 --> 00:01:38,900
تهوَّر أو قتلتُك فوراً

21
00:01:38,900 --> 00:01:40,180
لا تنسَ ذلك

22
00:01:42,700 --> 00:01:44,040
...لا

23
00:01:44,350 --> 00:01:46,250
...ثمّة شيء على متنِ هذا القطار

24
00:01:46,870 --> 00:01:49,050
ماذا؟ ماذا كان ذلك؟

25
00:01:54,860 --> 00:01:56,160
...المكابح

26
00:02:06,680 --> 00:02:08,720
ما الذي يجري؟

27
00:02:24,180 --> 00:02:25,390
!مُشكلة

28
00:02:25,390 --> 00:02:26,290
ما هي؟

29
00:02:26,290 --> 00:02:29,400
ثمّة وحش على قمّةِ المحرِّك الأمامي

30
00:02:39,580 --> 00:02:41,950
ما-ما هذا بحقِّ السماء؟

31
00:02:42,680 --> 00:02:44,790
إنّهم يستهدفونني

32
00:02:44,790 --> 00:02:46,040
ماذا؟

33
00:02:46,040 --> 00:02:48,980
إن لم تتصرّفوا بسُرعة فستُواجهون مُشكلة كبيرة

34
00:02:49,300 --> 00:02:52,060
علينا إيقاف القِطار حالياً

35
00:02:52,060 --> 00:02:55,490
وإلّا سنسقطُ عن المُنحدر عند ذلك المُنعطف

36
00:02:56,030 --> 00:02:56,830
!هيّا بنا

37
00:02:56,830 --> 00:02:57,570
!أنت

38
00:02:58,080 --> 00:02:59,220
!لا تتحرّك

39
00:03:00,570 --> 00:03:03,460
إن أضرمت النّار بي فماذا سيحلُّ بهم؟

40
00:03:03,810 --> 00:03:06,410
هل ستدعُ كافّة الركَّاب يموتون؟

41
00:03:05,960 --> 00:03:07,270
ما الذي يجري؟

42
00:03:08,520 --> 00:03:09,940
...حضرة المحقِّق

43
00:03:14,430 --> 00:03:16,560
!لنتوجَّه إلى المحرِّك

44
00:03:20,230 --> 00:03:21,910
!سنصرفُ انتباهه

45
00:03:21,910 --> 00:03:25,780
اذهب أنت إلى غرفةِ السّائق واضغط على المكابح

46
00:03:25,780 --> 00:03:26,760
!حاضر

47
00:03:29,930 --> 00:03:32,600
!الرقم 44، لا تذهب بمُفردك

48
00:03:32,980 --> 00:03:34,200
أعلمُ هذا

49
00:03:34,680 --> 00:03:37,280
لكن يبدو أنّ الوقت يُداهمنا

50
00:03:40,030 --> 00:03:41,490
هكذا يبدو

51
00:03:41,490 --> 00:03:42,670
ماذا سنفعل؟

52
00:03:43,110 --> 00:03:45,780
لا يمكنُنا الوصول إلى غرفة السّائق هكذا

53
00:03:50,460 --> 00:03:51,570
!انخفض

54
00:03:55,510 --> 00:03:57,170
...الـ-المكابح

55
00:04:06,460 --> 00:04:07,730
!اللّعنة

56
00:04:08,470 --> 00:04:10,760
اللّعنة! ماذا نفعل؟

57
00:04:14,170 --> 00:04:15,290
...لا

58
00:04:15,290 --> 00:04:17,690
من الخطير جدّاً أن أستخدم قوّتي هنا

59
00:04:18,070 --> 00:04:20,610
عليّ أن أفعل شيئاً حيال ذلك الحمض

60
00:04:20,610 --> 00:04:22,640
!الرقم 44، استفِق

61
00:04:23,560 --> 00:04:25,320
سنتخلّى عن المحرِّك الأمامي

62
00:04:25,320 --> 00:04:26,950
!افصل أداة الرّبط

63
00:04:27,340 --> 00:04:28,770
!حسناً

64
00:04:28,770 --> 00:04:29,910
سأذهب

65
00:04:47,990 --> 00:04:49,940
...كان ذلك وشيكاً

66
00:04:52,930 --> 00:04:54,890
!اقتربنا من المُنعطف

67
00:04:54,890 --> 00:04:55,940
!بسُرعة

68
00:05:08,710 --> 00:05:09,970
أهذه هي؟

69
00:05:17,260 --> 00:05:19,630
!إنّها عالِقة

70
00:05:25,230 --> 00:05:27,370
...إذا استطعتُ استخدامه

71
00:05:27,800 --> 00:05:29,470
ألم تنتهِ بعد؟

72
00:05:33,880 --> 00:05:34,850
!لا

73
00:05:37,240 --> 00:05:38,900
!أنا هُنا

74
00:05:54,900 --> 00:05:56,340
هل نلتُ منه؟

75
00:05:59,940 --> 00:06:01,760
!أمسِك بيدي

76
00:06:43,270 --> 00:06:45,950
هل نحنُ بأمان؟

77
00:06:46,260 --> 00:06:47,370
نعم

78
00:06:47,980 --> 00:06:49,340
ماذا عن الرُكَّاب؟

79
00:06:49,850 --> 00:06:51,110
إنّهم بخير

80
00:06:52,080 --> 00:06:53,770
بفضلِك

81
00:06:55,640 --> 00:06:59,040
...أشكرُك يا رقم 44

82
00:06:59,040 --> 00:07:02,860
لا، اسمي بانبا سوسكي

83
00:07:14,830 --> 00:07:16,390
أنتَ بانبا، صحيح؟

84
00:07:17,160 --> 00:07:18,070
!خذوه

85
00:07:18,070 --> 00:07:19,080
!اتركوني

86
00:07:18,400 --> 00:07:20,120
إلى أين تقتادونه؟

87
00:07:21,410 --> 00:07:23,050
لا حاجة لنُخبرك

88
00:07:23,050 --> 00:07:26,690
فقد كان قادماً إلينا في الحالتَين

89
00:07:30,800 --> 00:07:32,880
سنعودُ إلى المقرّ الآن

90
00:07:32,880 --> 00:07:34,800
ممتاز، شكراً

91
00:07:36,500 --> 00:07:38,520
،لم أرك منذُ زمن

92
00:07:40,460 --> 00:07:42,320
يا بانبا-سينسي