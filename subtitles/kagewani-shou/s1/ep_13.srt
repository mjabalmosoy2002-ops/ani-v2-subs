1
00:00:08,620 --> 00:00:10,080
بانبا-سينسي

2
00:00:10,450 --> 00:00:13,860
أنتَ تتمتّعُ بقوّة الكاغيواني لِذا ينبغي أن تفهم ذلك

3
00:00:15,160 --> 00:00:18,150
،بصفتِنا مُنفّذي هذا المشروع الهائل

4
00:00:18,150 --> 00:00:20,150
،لدينا واجبٌ تجاه البشريّة

5
00:00:20,150 --> 00:00:22,850
لا بل تجاه كلّ الكائنات الحيّة في الأرض

6
00:00:22,850 --> 00:00:26,720
لندعهم يتقدّمون إلى المرحلة المُقبِلة

7
00:00:29,170 --> 00:00:32,170
،والآن فلتتشابك أيدينا ببعضها البعض

8
00:00:32,170 --> 00:00:34,390
!بصفتِنا المُختارين

9
00:00:35,180 --> 00:00:36,700
لا أستطيع فعل ذلك

10
00:00:36,700 --> 00:00:37,890
لا تستطيع؟

11
00:00:38,200 --> 00:00:39,900
ماذا تعني؟

12
00:00:41,180 --> 00:00:43,230
لم يتم اختيارك

13
00:00:43,230 --> 00:00:44,960
ولا أنا

14
00:00:50,050 --> 00:00:51,640
هكذا إذاً

15
00:00:51,640 --> 00:00:53,990
من المُحزِن حقّاً ألّا نتفاهم

16
00:00:53,990 --> 00:00:57,050
يبدو إذاً أنّك خرجتَ من اللّعبة الآن أيضاً

17
00:00:59,130 --> 00:01:01,320
سأريك قوّة

18
00:01:01,870 --> 00:01:03,330
البشريّة الجديدة

19
00:01:22,320 --> 00:01:24,890
الوداع يا بانبا-سينسي

20
00:01:25,730 --> 00:01:30,060
سأستعيدُ كلّ النّسخ التي سرقتَها منّي أيضاً

21
00:01:48,980 --> 00:01:50,410
!بديع

22
00:01:51,070 --> 00:01:54,040
أهذه هي القوّة التي تتخطّى حتّى الأصلي إذاً؟

23
00:02:04,090 --> 00:02:04,970
اترك الأمر لي

24
00:02:08,440 --> 00:02:10,220
...عِديني

25
00:02:10,220 --> 00:02:17,860
...أنّكِ ستُنهين خطيئتنا

26
00:02:42,110 --> 00:02:43,510
هذه هي النّهاية

27
00:02:47,510 --> 00:02:50,020
هل ظننتِ أنّ بمقدوركِ منع

28
00:02:50,690 --> 00:02:52,570
،طلوع فجر عالمٍ جديد

29
00:02:52,570 --> 00:02:54,920
بقطعة الحديد هذه؟

30
00:02:54,920 --> 00:02:56,440
...إن كان كذلك

31
00:02:56,900 --> 00:02:58,690
فهذا يزعجُني حقّاً

32
00:03:01,800 --> 00:03:04,280
أنا آسفة أيّتها العجوز

33
00:03:05,320 --> 00:03:07,910
لم أستطع الوفاء بوعدي

34
00:03:12,010 --> 00:03:18,290
لكن مع ذلك، أنا مُعجبٌ بإنجازاتِ عشيرتكِ
في صنعِ الكاغيواني

35
00:03:18,910 --> 00:03:21,840
كمُكافأةن سأمنحكِ سلامَ الموت

36
00:03:30,340 --> 00:03:34,300
يبدو أنّك أنت من خرج من اللّعبة

37
00:03:56,470 --> 00:03:58,610
...أنت

38
00:03:59,910 --> 00:04:03,930
!لا يمكنُك إيقافي

39
00:04:40,960 --> 00:04:45,230
!خرجتَ من اللّعبة

40
00:05:07,670 --> 00:05:08,660
...ليس بعد

41
00:05:09,290 --> 00:05:12,450
لا يمكن أن تنتهي هنا

42
00:05:12,450 --> 00:05:15,920
!أنا المُختار

43
00:05:16,660 --> 00:05:19,520
!هذا صحيح... هذه مجرّد محنة

44
00:05:19,940 --> 00:05:21,920
!أستطيعُ تجاوزها

45
00:05:23,150 --> 00:05:26,860
قال هونما أنّني خرجتُ من اللّعبة

46
00:05:26,860 --> 00:05:27,960
!لكنّني أرفضُ تقبُّل ذلك

47
00:05:27,960 --> 00:05:29,240
!أرفُض

48
00:05:30,260 --> 00:05:31,330
...كيمورا

49
00:05:43,320 --> 00:05:45,060
...بانبا-سينسي

50
00:05:45,520 --> 00:05:47,990
هل ستضحكُ عليّ؟

51
00:05:49,730 --> 00:05:54,270
ألم يتم اختياري؟

52
00:06:01,210 --> 00:06:04,340
لا أحد يستطيعُ تحديد ذلك

53
00:06:06,780 --> 00:06:09,570
نعم، هذا صحيح، أليس كذلك؟

54
00:06:11,330 --> 00:06:16,220
لكن دعني على الأقلّ أصنع قراراً أخيراً بنفسي

55
00:06:17,790 --> 00:06:18,770
...كيمورا

56
00:06:19,630 --> 00:06:21,320
!بانبا-سينسي

57
00:06:21,830 --> 00:06:22,910
...بسرعة

58
00:06:23,570 --> 00:06:27,740
!اقتلني واقتل الكاغيواني

59
00:06:37,930 --> 00:06:38,960
أنت

60
00:06:43,200 --> 00:06:44,160
نعم

61
00:07:16,650 --> 00:07:20,180
أنا مُمتنّ لك حقّاً

62
00:07:37,770 --> 00:07:39,160
هُنا فريق برافو

63
00:07:39,160 --> 00:07:40,590
لا أثر لجثّة كيمورا

64
00:07:40,590 --> 00:07:41,270
!هنا

65
00:07:41,270 --> 00:07:42,190
ما الأمر؟

66
00:07:42,190 --> 00:07:44,120
!عثرنا على جثّة هونما

67
00:07:44,120 --> 00:07:45,870
حسناً، أحضروها

68
00:07:47,100 --> 00:07:48,610
ما هذا الشيء بالضبط؟