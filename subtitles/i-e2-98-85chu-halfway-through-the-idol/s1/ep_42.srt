1
00:00:09,610 --> 00:00:11,820
!حسنٌ! أحسنت الرميّ

2
00:00:12,360 --> 00:00:15,190
!رمياتُك جيّدةٌ للغاية يا نوري-سينباي

3
00:00:15,190 --> 00:00:17,200
!يُمكنُني رؤيةُ ذلك بوضوح من الجهةِ اليُسرى

4
00:00:17,560 --> 00:00:18,800
!إنّي مُغرمٌ بها

5
00:00:18,800 --> 00:00:20,050
!اخرس

6
00:00:28,520 --> 00:00:31,640
:لا تنسوا زيارتنا في

7
00:00:28,520 --> 00:00:31,640
منتديات العاشق

8
00:01:55,280 --> 00:01:56,090
!الجهةُ اليُسرى

9
00:01:56,090 --> 00:01:58,010
!إنّها لكَ يا سوامورا

10
00:01:58,320 --> 00:02:02,390
!حصلتُ عليها! حصلتُ عليها

11
00:02:00,290 --> 00:02:02,390
!فهمنا! فقط لا تسقطها

12
00:02:03,920 --> 00:02:05,430
!حصلتُ عليها

13
00:02:05,430 --> 00:02:08,190
!أجل! التقاطةٌ رائعةٌ يا سوامورا

14
00:02:08,190 --> 00:02:09,370
!التقاطةٌ رائعة

15
00:02:09,370 --> 00:02:11,150
.سقطت حيثُ يقفُ تماماً

16
00:02:11,550 --> 00:02:14,190
!نوري-سينباي، أحسنت الرميّ

17
00:02:14,190 --> 00:02:15,900
!خروجان

18
00:02:16,620 --> 00:02:18,600
.بمقدورهِ أن يلعبَ كمدافعٍ الآن

19
00:02:19,340 --> 00:02:21,950
.خاصّته MLB مع أنّي أكرهُ هُتافات الـ

20
00:02:19,340 --> 00:02:21,950
.ميوكي يقصد هُنا طريقة هُتافات سوامورا الصاخبة والتي تُشبه تلك الموجودة في دوري كرة القاعدة الرئيسي

21
00:02:23,010 --> 00:02:25,780
.أتوتّرُ كثيراً عندما تذهبُ الكُرةُ باتّجاهِه

22
00:02:25,780 --> 00:02:28,080
.ولكنّهُ تحسّنَ كثيراً كمُلتقِط

23
00:02:30,620 --> 00:02:33,210
!كواكامي سيبدأ! وميوكي سيكونُ الضارب المنظّف

24
00:02:33,880 --> 00:02:35,170
!وسوامورا سيلعبُ بالجهةِ اليُسرى

25
00:02:36,180 --> 00:02:37,870
.كُن مستعدّاً للرميّ في أيّ لحظة

26
00:02:37,870 --> 00:02:40,930
.حافظ على تحمية يدك بينما تلعبُ كمدافِع

27
00:02:41,720 --> 00:02:47,960
.الإنتقالُ من اللّعب كمدافع لاعتلاء التلّة، هي طريقةٌ قد نستخدِمُها في بطولة الصيف

28
00:02:47,970 --> 00:02:51,310
.فلنتأهّب لأيِّ طارئٍ قد يحدث

29
00:02:51,930 --> 00:02:52,600
!حاضر

30
00:02:55,690 --> 00:02:57,340
!خروجان

31
00:02:57,340 --> 00:02:58,400
!ركّز على الضارب

32
00:02:58,400 --> 00:03:01,570
.رؤيتُكَ للمُباراةِ تختلفُ بحسبِ المركزِ الذي تلعبُ فيه

33
00:03:02,620 --> 00:03:03,870
.ثلاثةٌ للخارجِ في شوطٍ واحد

34
00:03:04,990 --> 00:03:07,370
.و سبعةٌ وعشرون خروجاً في تسعة أشواط

35
00:03:08,480 --> 00:03:11,870
...سواءً كان الخروجُ سبَبُهُ المُدافعين، أو كان من خلال السترايك-آوت

36
00:03:08,480 --> 00:03:11,870
.السترايك-آوت: مصطلح يُطلق عندما يُحقق الرّامي 3 سترايك ويُخرج بها الضارب

37
00:03:12,620 --> 00:03:14,320
!كلاهما يُحقّقان نفسَ النتيجة

38
00:03:21,550 --> 00:03:23,850
!ها هي مدفعيّة القائدِ تظهر

39
00:03:25,100 --> 00:03:26,850
،مُتسلّحين بسلسلة انتصاراتهم الثمانية

40
00:03:27,480 --> 00:03:31,730
.ضاربو (سيدو) ينفجرون في هذه المُباراة، ويُضاعفون ضرباتهم المزدوجة مع نهاية الشوط السادس

41
00:03:32,780 --> 00:03:35,360
.وفي الشوط الثامن، سوامورا يعتلي التلّة

42
00:03:37,740 --> 00:03:41,420
.في البداية، رمياتُ الأرقام كانت عشوائية، و واجه صعوبةً في التحكّمِ بها

43
00:03:42,330 --> 00:03:43,720
!تمالك نفسك

44
00:03:43,720 --> 00:03:45,030
!آسف

45
00:03:46,140 --> 00:03:48,660
،وبعد ذلك، عاد لرمياتهِ السّريعة

46
00:03:49,190 --> 00:03:50,660
.واستقرّ تحكمهُ بها

47
00:03:51,120 --> 00:03:52,590
.ولم يقم بمنحهم أيّ نقطة

48
00:03:56,130 --> 00:04:01,550
،وحسمَ المُنظُف المُباراةَ بـ هوم-رن ثانية مُحققاً بذلك الفوز التاسع لـ (سيدو)

49
00:04:01,550 --> 00:04:03,630
.يا لهُ من شعورٍ عظيم

50
00:04:03,630 --> 00:04:05,180
!أجل

51
00:04:06,870 --> 00:04:09,290
.رمياتُ الرقم 2 بدت جيّدة للغاية

52
00:04:09,290 --> 00:04:12,260
.أجل، ورميات الرقم 7 تحسّنت أيضاً

53
00:04:12,260 --> 00:04:14,580
.أجل، دعنا نركّز عليها

54
00:04:18,060 --> 00:04:19,470
،وفي المُباراة التالية

55
00:04:19,900 --> 00:04:22,900
.ثنائيّ الرميّ كواشيما-أونو قد بدأ

56
00:04:24,040 --> 00:04:26,410
.الأشواطُ الأولى كانت معركةً شرسةً في الضرب

57
00:04:26,410 --> 00:04:29,050
.لاعبَيّ السّنة الأولي قدّما أداءاً جيّداً

58
00:04:30,250 --> 00:04:35,420
.المدافع الأيسر يوكي ماساشي حقق ضربتين مزدوجتين و هوم-رن

59
00:04:35,810 --> 00:04:39,170
.والمدافع الأيمن يوي كاورو حقق 3 ضرباتٍ و سجّل 4 نقاط

60
00:04:42,170 --> 00:04:48,550
.بوجود ميوكي و أونو في التشكيلةِ الأولى، فلن تسنحَ لكَ فرصٌ عديدة لارتداء قناع الماسك

61
00:04:55,600 --> 00:04:57,190
!المدرّب يسأله؟

62
00:04:57,640 --> 00:05:01,120
.لابدّ وأن ضربَ يوي قد أثارَ إعجابَه

63
00:05:01,980 --> 00:05:04,800
.أنا يوي كاورو من (ماميا سينيور)

64
00:05:04,800 --> 00:05:09,580
!لعبتُ كماسكٍ في المرحلةِ الإعداديّة والمتوسّطة، لذا فأنا لا أُفكّرُ باللّعب في أيّ مركزٍ آخر

65
00:05:15,780 --> 00:05:19,640
.أجل، طالما أنّك تعتقدُ بأنّهُ يُمكنُي مُساعدةُ الفريق بذلك

66
00:05:43,850 --> 00:05:46,240
.قامَ بضربِ تلكَ المُنزلقةِ بشكلٍ جيّد

67
00:05:46,240 --> 00:05:47,540
هل كان يستهدِفها؟

68
00:05:48,750 --> 00:05:54,240
.قلتُ بأنّي سأصقلُ مهاراتِه، ولكنّهُ موهوبٌ بالفطرة

69
00:05:55,500 --> 00:05:57,370
ما رأيك بهذين الاثنين؟

70
00:06:00,200 --> 00:06:02,360
.إنهما يُشكّلانِ معضلةً إن وصلا للقاعدة

71
00:06:02,360 --> 00:06:05,320
.وهذا وحدهُ يجعلني لا أريدُ الرميّ نحوهما

72
00:06:05,320 --> 00:06:10,390
.وإنّهُ لأمرٌ محبطٌ عندما يضربون رميات السترايك-آوت

73
00:06:11,230 --> 00:06:12,480
.فهمت

74
00:06:13,170 --> 00:06:16,080
.هذا رأيهُ كرامٍ، ولكنّهُ يُراقبهما بشكلٍ جيّد

75
00:06:17,880 --> 00:06:21,380
هلّا جعلتَ فوريا يُشاهدُ مُباراة التشكيلة الثانية من فضلك؟

76
00:06:21,380 --> 00:06:23,400
.سأفعلُ ذلك طالما أنّكَ تعتقدُ أنّ هذا ما يحتاجُه

77
00:06:23,840 --> 00:06:28,420
.أجل، أريدهُ أن يُراقبَ المُدافعين عن كثب

78
00:06:28,420 --> 00:06:32,100
.ذلك سيجعلهُ يُدركُ ماهيّة شعور اللّاعبين خلفه وهو يرمي

79
00:06:33,120 --> 00:06:35,880
...التماسُ أشياء كهذه من رامٍ طبيعيٍّ كهذا الفتى

80
00:06:38,380 --> 00:06:43,980
.مهما كانت براعة رمياتك، فقلبُك هو الذي يُحرّك جسدك

81
00:06:43,980 --> 00:06:48,080
.وهذا على الأرجح ما يُحاولُ المدرّبُ كاتاوكا إيصالهُ إليه

82
00:07:10,080 --> 00:07:12,020
كيف يبدو أكومورا اليوم؟

83
00:07:12,020 --> 00:07:13,320
.هادئٌ للغاية

84
00:07:13,320 --> 00:07:15,200
ما ذلك الشيءُ الذي يقرأُه؟

85
00:07:15,610 --> 00:07:17,920
.إنّهُ سجلّ نتائج كرة القاعدة

86
00:07:17,920 --> 00:07:19,330
سجلّ النتائج؟

87
00:07:19,620 --> 00:07:22,580
أوليسَ قصةً عن السيوف والسحرة؟

88
00:07:23,840 --> 00:07:27,340
.أكومورا-كن، لقد استعرتُ هذا من أوميموتو-سينباي

89
00:07:27,770 --> 00:07:28,620
.شكراً لكِ

90
00:07:30,780 --> 00:07:32,770
أوه، سجل النتائج؟

91
00:07:32,770 --> 00:07:35,570
!هذه دراسةٌ جادّةٌ حقاً

92
00:07:35,570 --> 00:07:37,160
!أنا مُندهشة

93
00:07:39,160 --> 00:07:44,980
.لقد أثنت على دراستي، ولكنّي لم أمتلك الشجاعة لإنكار ذلك

94
00:07:46,910 --> 00:07:48,310
.هذا مُذهل

95
00:07:49,250 --> 00:07:52,830
.إنّهُ لم يرمي رمياتٍ مُختلفةٍ وحسب، بل قام برميها أيضاً لمساراتٍ متعدّدة

96
00:07:53,900 --> 00:07:58,600
.قام برميّ الكثير في الأشواط الأولى ليُظهِرَ للضاربين رمياتهِ المُختلفة

97
00:07:58,600 --> 00:08:02,880
."ولكن في منتصف المُباراة، لم يقم برميّ أي كرة "بول

98
00:08:02,880 --> 00:08:05,070
."بل كانت جميعُها في منطقة "السترايك

99
00:08:06,290 --> 00:08:08,130
،واثقاً من أسلحةِ الرّامي

100
00:08:08,710 --> 00:08:10,910
.قيادتهُ كانت بسيطةً وفعّالة

101
00:08:12,160 --> 00:08:18,260
!ليكن في علمك، الرميُ هو فنٌّ يشكّلهُ الرامي والماسك معاً

102
00:08:18,800 --> 00:08:20,770
هل أنت متأكدٌ من ذلك؟

103
00:08:22,020 --> 00:08:24,940
هل ستشكّل ذلك الفنّ معي حقاً؟

104
00:08:35,660 --> 00:08:38,010
.حققتَ اثنين هوم-رن في مُباراةٍ واحدة

105
00:08:38,010 --> 00:08:40,750
.يبدو أن تدريبات الضرب خاصّتك أتت بثمارها

106
00:08:41,330 --> 00:08:42,830
.ربّما

107
00:08:42,830 --> 00:08:45,580
.كما أنّي اعتدتُّ على المضرب الخشبيّ الآن

108
00:08:47,760 --> 00:08:49,960
!أريدُ فعلَ ذلك أيضاً

109
00:09:05,100 --> 00:09:06,810
!أجل

110
00:09:06,810 --> 00:09:08,440
!هيّا

111
00:09:08,750 --> 00:09:10,440
!اركض

112
00:09:16,120 --> 00:09:18,570
!ما هذا؟ اللّعنة

113
00:09:19,830 --> 00:09:25,310
.لقد قال بأن من يتدرّبُ على الإطار ... سيكون شخصاً موعوداً

114
00:09:25,830 --> 00:09:30,480
.وقد بدا سعيداً للغايةِ عند قولهِ ذلك

115
00:09:31,210 --> 00:09:32,550
!حسنٌ! جولةٌ أخيرة

116
00:09:36,600 --> 00:09:38,400
.إنّهُ يُثيرُ أعصابي

117
00:09:46,190 --> 00:09:56,440
!شكراً لكم على الطعام

118
00:10:17,500 --> 00:10:20,550
!حرّك أقدامك وأخفض وركك

119
00:10:20,950 --> 00:10:22,560
!راقب الكرةَ بعناية

120
00:10:25,100 --> 00:10:27,300
فوريا يلعبُ كمدافعٍ داخلي؟

121
00:10:25,100 --> 00:10:27,300
.المدافع الداخليّ: هو مدافع يكون مركزه بالقرب من القواعد

122
00:10:27,300 --> 00:10:29,350
.لربّما سيُشاركُ في المُباراة

123
00:10:30,020 --> 00:10:32,430
.المدرّبُ جادٌّ بالفعل في ذلك

124
00:10:36,640 --> 00:10:39,610
!التالية هي العشرون! فلنجعلها رائعة

125
00:10:45,180 --> 00:10:46,230
!أحسنتَ الرميّ

126
00:10:46,230 --> 00:10:48,000
.والآن وقتُ الاستراحة

127
00:10:48,780 --> 00:10:50,000
.أجل

128
00:10:50,380 --> 00:10:52,060
استراحةٌ بعد 20 رميةً فقط؟

129
00:10:52,060 --> 00:10:54,160
أهذا تدريبه لهذا اليوم؟

130
00:10:54,160 --> 00:10:56,760
.كلّا، سيرمي 100 رميةٍ أُخرى

131
00:10:57,420 --> 00:11:01,760
.ولكنّهُ لن يرمي أبداً 100 رميةٍ بشكلٍ متواصل في مُباراةٍ حقيقيّة

132
00:11:02,280 --> 00:11:07,990
.رميةً واستراحة، ثم 20 رميةً تتلوها هرولة، وأخيراً 20 رميةً أُخرى واستراحة

133
00:11:02,280 --> 00:11:07,990
20

134
00:11:08,910 --> 00:11:15,400
.وضعتُ لهُ تدريباً كما لو أنّهُ في مُباراةٍ حقيقيّة، إضافةً لاحتماليّة وصولهِ للقاعدةِ كضارب

135
00:11:15,680 --> 00:11:17,900
.هكذا إذن

136
00:11:18,760 --> 00:11:20,880
أتريدُ تجربةَ بعضِ الأرقام الآن؟

137
00:11:20,880 --> 00:11:23,410
مثل الرقم 11 أو القاطعةُ المطوّرة؟

138
00:11:24,440 --> 00:11:28,020
.في الواقع، سألتزمُ بالكُراتِ السّريعةِ فقط لهذا اليوم

139
00:11:28,020 --> 00:11:30,230
.وفي الغد، سيلتقطُ ميوكي-سينباي لي

140
00:11:30,230 --> 00:11:32,170
.حينها سأعملُ على الأرقام

141
00:11:33,360 --> 00:11:34,510
.فهمت

142
00:11:37,900 --> 00:11:39,100
!أحسنتَ الرميّ

143
00:11:39,100 --> 00:11:40,930
!التاليةُ ستكون رميتُك الـ 15

144
00:11:43,870 --> 00:11:48,430
.أكومورا و سيتو ليسا جاهزينِ بدنيّاً بعد

145
00:11:48,430 --> 00:11:57,400
،صحيحٌ أنّي قلتُ بأنّي سأصقلُهما في التشكيلةِ الثانية
.ولكن معدّل ذكاء هذينِ الاثنين في كرة القاعدة قد يُساعدُ في تحفيز التشكيلةِ الأولى

146
00:12:00,320 --> 00:12:03,590
!أكومورا، ستأخذُ مكان يوي في هذهِ المجموعة

147
00:12:03,590 --> 00:12:05,570
.ستكونُ مُلتقطاً لسوامورا

148
00:12:14,230 --> 00:12:16,960
.أنا أعتذر، ولكن لا يُمكنُني فِعلُ ذلك

149
00:12:19,260 --> 00:12:20,360
لا يُمكنُك؟

150
00:12:20,360 --> 00:12:21,720
ماذا تعني؟

151
00:12:27,900 --> 00:12:32,260
!يا زعيم، إنّهُ لن يلتقِط لي حتّى يُصبحَ في التشكيلةِ الأولى

152
00:12:32,260 --> 00:12:35,480
!إنّهُ بمثابةِ قسمٍ أو قاعدةٍ له

153
00:12:35,980 --> 00:12:40,990
.إنّهُ مُزعـ ... أقصد يصعبُ التعاملُ معهُ كما لو أنّهُ ذئبٌ برّي

154
00:12:41,540 --> 00:12:45,320
!ولكن هذا ما يجعلهُ مُثيراً للاهتمام

155
00:12:49,580 --> 00:12:56,380
.أنا أعتزم وضعكَ أنت وسيتو في التشكيلةِ الأولى قبل أن يُغادرَ ميوكي لبطولة طوكيو

156
00:12:57,580 --> 00:12:59,280
ألا يُرضيكَ ذلك؟

157
00:13:02,940 --> 00:13:06,180
.أنا لستُ أهلاً لأن ألتقطَ لكَ بعد

158
00:13:07,470 --> 00:13:10,130
.سأحصلُ على مقعدي في التشكيلةِ الأولى حتماً

159
00:13:10,130 --> 00:13:11,410
...وحالما أفعلُ ذلك

160
00:13:13,090 --> 00:13:16,020
.عندما يحينُ ذلك الوقت، سأفعلُ وبكلِّ سرور

161
00:13:20,760 --> 00:13:21,280
...ولكن

162
00:13:21,980 --> 00:13:24,010
.أنا مُلتقطٌ فقط

163
00:13:24,010 --> 00:13:26,710
.إن كنتُ سألعبُ في التشكيلةِ الأولى، فسألعبُ كمُلتقطٍ فقط

164
00:13:42,600 --> 00:13:43,720
.فهمت

165
00:13:43,720 --> 00:13:44,630
.هذا يكفي

166
00:13:48,840 --> 00:13:51,830
!لم يستجِب لأمر المدرّب كاتاوكا

167
00:13:51,830 --> 00:13:53,520
من ذلكَ الفتى؟

168
00:13:55,340 --> 00:13:57,910
!أيّها الفتى يوي، حان وقتُ العودةِ للتدريب

169
00:13:57,910 --> 00:13:59,560
!ح-حاضر

170
00:13:59,560 --> 00:14:02,320
!حسنٌ، الشوطُ الثالث

171
00:14:09,760 --> 00:14:13,590
.أجل، طالما أنّك تعتقدُ بأنّهُ يُمكنُي مُساعدةُ الفريق بذلك

172
00:14:44,610 --> 00:14:46,150
!ها قد عاد! ها قد عاد

173
00:14:46,480 --> 00:14:48,490
!الفتى الذئب قد عاد

174
00:14:49,720 --> 00:14:51,320
أهُنالك درسٌ اليوم؟

175
00:14:51,320 --> 00:14:54,120
.كلّا، ليس كذلك

176
00:14:54,120 --> 00:14:55,890
إذن لمَ أنتَ هُنا؟

177
00:14:56,930 --> 00:14:58,870
.وصلتني أخبارٌ يا أكومورا

178
00:14:59,690 --> 00:15:02,910
.أنت لن تلتقِطَ لسوامورا حتى تصِلَ للتشكيلةِ الأولى

179
00:15:02,910 --> 00:15:05,130
أقُلتَ ذلك للمدّرب؟

180
00:15:14,730 --> 00:15:21,140
.المدّرّب فكّرَ بأنّك لو حاولتَ الالتقاطَ لرامٍ من التشكيلةِ الأولي فسيُساعدُ ذلك الفريق

181
00:15:21,140 --> 00:15:22,960
.ولكنّك واجهتَ طلَبَهُ بالرّفض

182
00:15:22,960 --> 00:15:25,600
.أنت غريبُ الأطوارِ فعلاً

183
00:15:25,600 --> 00:15:26,650
...وفي الواقع

184
00:15:27,160 --> 00:15:30,760
.لقد جعلتَ المدرّبَ يغضب والآن أفسدتَ فرصتك لتكونَ في التشكيلةِ الأولى

185
00:15:33,010 --> 00:15:34,960
!لن أُخالفهُ القولَ في ذلك

186
00:15:34,960 --> 00:15:38,270
!فالزعيمُ أكثر صرامةً ممّا يبدو عليه

187
00:15:42,760 --> 00:15:49,060
!بذكر ذلك، أذكرُ شخصاً قد تحدّى المدرّب فورَ انضمامهِ للفريق، وكاد يخسرُ فرصتهُ في أن يكونَ رامٍ

188
00:15:51,720 --> 00:15:53,390
أتسائلُ من يكونُ ذلك الغبيّ؟

189
00:15:53,390 --> 00:15:54,400
.إنّهُ أنت! أنت

190
00:15:54,400 --> 00:15:55,720
!يا لهُ من فتىً مُحيّر

191
00:15:55,720 --> 00:15:56,780
!قلتُ بأنّهُ أنت

192
00:15:57,590 --> 00:16:01,260
!وأساساً، لمَ تذكرُ هذا الموضوعَ الآن وأمام كوهاي حتّى؟

193
00:16:01,260 --> 00:16:05,230
!وفي الواقع، أنت من زادَ الطين بلّة بتدخّلك وقتها

194
00:16:14,070 --> 00:16:21,080
.لا شكّ بأنّكم أيّها السينباي في التشكيلةِ الأولى تنظرون لي باستصغار

195
00:16:21,640 --> 00:16:24,330
.كلّا! كلّا، أنا لا أنظرُ لك بهذهِ الطريقةِ أبداً

196
00:16:24,330 --> 00:16:28,190
.أنت مُميّز، وجيّدٌ كمُتلقِط، ومُخيفٌ أيضاً

197
00:16:29,190 --> 00:16:30,460
...أنا

198
00:16:31,080 --> 00:16:33,520
.لن أكتفي بالوصول للتشكيلةِ الأولى فحسب

199
00:16:33,520 --> 00:16:36,340
.بل أنا عازمٌ تماماً على أخذِ مكانكَ الأساسيّ

200
00:16:43,320 --> 00:16:44,400
حقّاً؟

201
00:16:46,160 --> 00:16:47,800
.فهمتُ الآن

202
00:16:47,800 --> 00:16:50,840
.لا عجبَ في أنّهُ كان ينظرُ لي بعدوانيّةٍ منذُ اليومِ الأوّلِ له

203
00:16:56,570 --> 00:16:59,060
.سأنضمُّ للفريق في هذا الرّبيع

204
00:16:59,060 --> 00:17:00,490
.اسمي هو ميوكي كازويا

205
00:17:00,940 --> 00:17:06,750
.سأسرقُ كلَّ شيءٍ منك، بما في ذلك مكانكَ الأساسيّ

206
00:17:07,270 --> 00:17:09,230
.حسناً، حظّاً موفّقاً

207
00:17:13,410 --> 00:17:14,540
.يبدو هذا مُمتعاً

208
00:17:49,610 --> 00:17:54,340
فوريا-سان، ما رأيُك باللّعبِ في مركزٍ آخر غير الرامي؟

209
00:18:00,630 --> 00:18:02,890
.لا أُريدُ ذلكَ بالطّبع

210
00:18:05,310 --> 00:18:06,740
.وخاصّةً كمدافعٍ داخليّ

211
00:18:06,740 --> 00:18:10,510
.هُنالِكَ الكثيرُ لأتعلّمه، والجميعُ أفضل منّي

212
00:18:17,550 --> 00:18:21,740
.ولكنّ في وضعي الحاليّ، لا تحقُّ لي الشكوى

213
00:18:22,710 --> 00:18:27,040
.إن كان عليّ أن ألعبَ مُدافعاً، فسأفعلُ ما بوسعي، حتى وإن كنتُ سيئاً

214
00:18:27,040 --> 00:18:28,650
.هذا ما أظنُّه

215
00:18:28,650 --> 00:18:34,000
.فعندما ألعبُ في الميدان، فهذا يعني بأنّي أخذتُ هذا المركز من شخصٍ آخر

216
00:18:43,590 --> 00:18:48,850
فوريا، ألا تملكُ قفّاز المدافع الخارجيّ؟

217
00:18:48,850 --> 00:18:52,080
.يُمكنُك أخذ خاصّتي عندما تلعب

218
00:18:52,080 --> 00:18:54,050
،إنّهُ في حالةٍ يُرثى لها

219
00:18:54,520 --> 00:18:56,240
.ولكنّهُ سَيفِي بالغرض

220
00:18:57,030 --> 00:18:58,790
،طالما أنّي سألعب

221
00:19:00,130 --> 00:19:03,540
.فسأقدّم أفضل ما لديّ في أيِّ مركز

222
00:19:04,800 --> 00:19:10,790
.لهذا أُريدُ التدرّب على التلويح وأن أقوم بتدريبات الضرب

223
00:19:11,860 --> 00:19:18,670
.الرّغبةُ في أن تكونَ الرامي الأفضل في اليابان، وأن تجعلَ فريقك الأفضل هما هدفينِ رائعين

224
00:19:19,640 --> 00:19:23,930
.الشخصُ الذي يحملُ على نفسهِ عاتقَ الفريقِ بأكمله هو النجم

225
00:19:23,930 --> 00:19:26,430
!جميعكم تناسوا أرقامكم الحاليّة

226
00:19:26,430 --> 00:19:32,940
!العشرون لاعباً الذينَ سيتم اختيارهم للبطولة سيكونُ بحسب أدائهم وسلوكهم في الأيامِ القادمة

227
00:19:33,340 --> 00:19:34,900
!إنّهُ يتّجهُ نحوَ الثالثة

228
00:19:34,900 --> 00:19:36,820
!إنّهُ مجنون

229
00:19:37,370 --> 00:19:38,440
!لقد خرج

230
00:19:39,770 --> 00:19:40,700
!للخارج

231
00:19:41,580 --> 00:19:43,660
.لا يوجد هُنالِكَ طريقٌ مُختصرٌ نحوَ المجد

232
00:19:44,200 --> 00:19:49,550
.الفريقُ ليسَ بحاجةٍ للاعبٍ لا يُفرّقُ بين الكفاحِ والغطرسة

233
00:19:51,290 --> 00:19:57,660
.ولكن هذهِ الأهدافُ ستكونُ بلا معنىً إن سيّطرت عليك

234
00:19:59,150 --> 00:20:08,210
.قد يبدو لك أنّك تقتربُ من بلوغها بينما أنتَ لا تفعلُ شيئاً مُميّزاً للاقترابِ منها

235
00:20:12,280 --> 00:20:14,350
.شكراً لكَ يا فوريا-سان

236
00:20:15,340 --> 00:20:21,300
.لقد اتّخدتُ هذا القرار بنفسي، لذا سألعبُ بطريقةٍ لن تجعلني أندمُ على هذا الاختيار

237
00:20:24,370 --> 00:20:27,030
.وأنا كذلك

238
00:20:27,030 --> 00:20:27,720
!أجل

239
00:21:19,860 --> 00:21:21,490
".بمثابةِ قسم"

240
00:21:34,920 --> 00:21:37,560
!اعتباراً من اليوم، نحنُ في نفسِ السنّ

241
00:21:38,110 --> 00:21:40,950
!ليسَ هُنالكَ داعٍ للرّسميّاتِ بيننا بعد الآن

242
00:21:40,950 --> 00:21:42,460
أليس كذلك يا يويتشي؟

243
00:21:44,080 --> 00:21:45,610
.سألتقطُ الصورةَ الآن

244
00:21:45,610 --> 00:21:48,700
!كوراموتشي-سينباي، ابتسم من فضلك

245
00:21:58,770 --> 00:22:01,520
!ما الذي تنتظِرهُ يا آسادا؟ التقطِ الصورة

246
00:22:01,520 --> 00:22:02,800
!أنا آسف

247
00:22:02,800 --> 00:22:05,250
!أنا آسفٌ يا سوامورا-سينباي

248
00:22:06,090 --> 00:22:09,970
...كوراموتشي-سينباي ليس شخصاً يُعبثُ معه