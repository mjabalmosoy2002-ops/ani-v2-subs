1
00:00:04,370 --> 00:00:11,060
.في حين أن فوريا كان يعاني مع تذبذب مستواه، رميّ ساوامورا هو من كان يقود الفريق

2
00:00:12,260 --> 00:00:15,610
،وأعتقدُ أن جميع اللّاعبين متّفقين على ذلك

3
00:00:17,320 --> 00:00:22,910
.وكلٌّ من فوريا و ساوامورا لم يكونا ليصلا لما وصلا إليه بمفردِهما

4
00:00:24,060 --> 00:00:25,690
:في البداية، رقم 1

5
00:00:26,910 --> 00:00:29,850
.ولكنّنا لم نصل لهدفنا النهائي بعد

6
00:00:31,270 --> 00:00:36,960
!لذا أعتقدُ أن تغيير رقميّهِما سيجعلُ كلّاً منهما يتطوّر أكثر

7
00:00:37,780 --> 00:00:38,770
ما خطبك؟

8
00:00:38,770 --> 00:00:40,120
أتريده أم لا؟

9
00:00:42,680 --> 00:00:43,640
...اللّعنة

10
00:00:46,050 --> 00:00:47,380
.توقف عن الإرتعاش

11
00:00:57,670 --> 00:01:00,080
،الطريقُ الذي سلكهُ فوريا

12
00:01:04,860 --> 00:01:07,920
.ها أنت ذا تسلكهُ الان يا ساوامورا

13
00:01:17,740 --> 00:01:20,970
!لذا سنواجه هذا الصيف بـ ساوامورا

14
00:01:27,540 --> 00:01:30,980
:لا تنسوا زيارتنا في

15
00:01:27,540 --> 00:01:30,980
منتديات العاشق

16
00:03:00,030 --> 00:03:03,100
.لغتهُ اليابانيّة جيّدة

17
00:03:03,100 --> 00:03:05,030
إذن فهو لن يلعب في هذه البطولة؟

18
00:03:05,030 --> 00:03:06,190
.يا للأسف

19
00:03:07,120 --> 00:03:11,270
.لعِبتُ معه شوطاً واحداً في مُباراتنا الثانيّة لتمثيل طوكيو

20
00:03:12,080 --> 00:03:14,170
،رأيتُ نهجهُ في كرة القاعدة

21
00:03:14,170 --> 00:03:16,080
،ومهاراتهُ الفنّية الفذّة

22
00:03:16,080 --> 00:03:18,050
.وعقليّته الفضوليّة التي تسعى للتطوّر أكثر

23
00:03:19,600 --> 00:03:22,640
.أنا فخورٌ بلعبي معه

24
00:03:31,070 --> 00:03:32,070
!رقم 1

25
00:03:32,070 --> 00:03:33,520
!ساوامورا حصل على الرقم 1

26
00:03:33,520 --> 00:03:35,320
أيعني ذلك أنك تتطوّرت أكثر؟

27
00:03:35,320 --> 00:03:37,280
!وأنا حصلتُ على الرقم 3

28
00:03:37,280 --> 00:03:39,140
!لا يسعني الانتظار

29
00:03:39,140 --> 00:03:40,820
أنتَ لستَ مصاباً، صحيح؟

30
00:03:42,840 --> 00:03:43,920
.فهمت

31
00:03:44,680 --> 00:03:47,100
.إذن فسنلعبُ بكلّ ما لدينا

32
00:03:47,880 --> 00:03:50,730
!أوي! ساوامورا

33
00:03:51,580 --> 00:03:54,240
!أنت ترتدي الرقم 1 الآن

34
00:03:54,240 --> 00:03:56,850
لمَ لم تخبرني؟

35
00:03:56,850 --> 00:03:59,560
!ولمَ عليّ إخبارك بتفاصيل حياتي؟

36
00:03:59,560 --> 00:04:01,670
أولسنا أصدقاء على الـ "لاين"؟

37
00:04:01,670 --> 00:04:03,900
!هذا لأنك أجبرتني

38
00:04:03,900 --> 00:04:06,300
!وفوق ذلك، نحنُ خصمان

39
00:04:06,790 --> 00:04:09,060
أهذانِ الاثنانِ صديقان؟

40
00:04:06,790 --> 00:04:09,370
!ولكنّنا أرسلنا لبعضنا ملصقاتٍ أكثر من مرّة

41
00:04:09,060 --> 00:04:11,060
.للتوّ علمتُ بذلك

42
00:04:09,370 --> 00:04:11,060
!هذا لأنك تلحُّ كثيراً برسائلك

43
00:04:11,480 --> 00:04:14,470
تودوروكي، أتريدُ أن تنضم لمجموعتنا على الـ "لاين"؟

44
00:04:14,470 --> 00:04:15,590
.لا أُمانعُ وجودك

45
00:04:15,590 --> 00:04:16,900
!اسألني أولاً

46
00:04:16,900 --> 00:04:18,320
وأيُّ مجموعةٍ هذه؟

47
00:04:18,320 --> 00:04:19,780
مجموعة؟

48
00:04:19,780 --> 00:04:21,790
.إنّْهُ لا يملكُ هاتفاً

49
00:04:21,790 --> 00:04:24,380
!ولكن بما أنّك طلبت، أنا سأنضمُّ لكم

50
00:04:26,400 --> 00:04:27,600
.الجولةُ الخامسة

51
00:04:29,110 --> 00:04:30,510
.نصفُ النهائي

52
00:04:34,380 --> 00:04:36,350
!و (إيناشيرو) في النهائي

53
00:04:39,990 --> 00:04:43,520
!لا يسعني الانتظارُ لسحقكم جميعاً

54
00:04:41,980 --> 00:04:45,460
!أنت! عليك هزيمتنا أولاً يا تودوروكي

55
00:04:45,460 --> 00:04:48,800
!أجل! لا تتحدّث كما لو أنّك وصلت للنهائي بالفعل

56
00:04:48,800 --> 00:04:50,600
.أنتم صاخبون يا رفاق

57
00:04:57,870 --> 00:04:59,780
مي-سان، هل علِمت؟

58
00:04:59,780 --> 00:05:02,360
.حامِل الرقم 1 في (سيدو) قد تغيّر

59
00:05:03,860 --> 00:05:05,110
ومن هو الآن؟

60
00:05:05,110 --> 00:05:06,750
.ساوامورا من السنة الثانية

61
00:05:11,390 --> 00:05:12,450
هل ستسحقهم؟

62
00:05:13,450 --> 00:05:14,960
أم أنّهم سيسحقونك؟

63
00:05:16,700 --> 00:05:22,970
.أراهنُ على أنّك تختبرُ هذهِ المشاعر الان يا فوريا ساتورو

64
00:05:24,960 --> 00:05:26,420
.فهمت

65
00:05:26,420 --> 00:05:29,360
.لم يستطِع تجاوز الأمرِ في النهاية

66
00:05:31,890 --> 00:05:36,060
،حسنٌ، لا يهمّ من يكونُ خصمي

67
00:05:38,100 --> 00:05:40,750
.سأسحقُ كلّ من يجرؤ على الوقوف في طريقي

68
00:05:41,510 --> 00:05:43,040
.هذهِ خلاصةُ الأمر

69
00:05:50,660 --> 00:05:54,620
.راميهم البادئ كان صاحب الرقم 12، أوسو من السنة الثانية

70
00:05:54,620 --> 00:05:58,620
.إنّهُ رامٍ أيمن يضغطُ على الضاربين برمياتهِ السّريعة

71
00:05:58,620 --> 00:06:04,510
.وحامِل الرقم 1، لاعب السنة الثالثة هيغاشياما لم يلعب اليوم

72
00:06:05,190 --> 00:06:08,040
.وضاربهم المنظف سيندا، سجّل 3 نقاط

73
00:06:08,040 --> 00:06:12,260
.اعتمَدوا على "السكويز" و "ضربة وركضة" في تسجيل نقاطهم

74
00:06:08,040 --> 00:06:12,260
.السكويز: هي تقنية يستخدمها الضارب ليضحّي بنفسه ويخرج حتى يتمكّن زميله على القاعدة الثالثة من التسجيل

75
00:06:12,570 --> 00:06:17,420
.وانتهت المُباراة في الشوط السابع بنتيجة 11-2 ضد ثانويّة (ساكانوي)

76
00:06:18,780 --> 00:06:24,500
.سأشاهدُ مباراتهم الثانية في الأسبوع المُقبل حتّى أستطيع تحليل ضاربيهم أكثر

77
00:06:25,420 --> 00:06:27,920
.انقسم أنت ورفاقك لتحليل الفرق الأخرى كذلك

78
00:06:27,920 --> 00:06:28,770
.حاضر

79
00:06:34,940 --> 00:06:38,940
.مدرب (سيدو) الشهير السابق، ساكاكاي إيجيرو

80
00:06:38,940 --> 00:06:40,630
.وهو المدرّب السابق لمدرّبنا

81
00:06:41,090 --> 00:06:43,100
أتسائلُ ما إن كانت مواجهتهُ أمراً صعباً على مدرّبنا؟

82
00:06:44,790 --> 00:06:46,770
،مُباراتنا الأولى في يوم 15

83
00:06:47,420 --> 00:06:49,630
،ما زال أمامنا وقتٌ طويل

84
00:06:50,280 --> 00:06:53,050
.أريدُ أن أجعلَ الأرقام دقيقةً أكثر

85
00:06:53,050 --> 00:06:55,980
.أريدُ أن يكون لديّ الكثير من الخيارات للرميّ

86
00:06:56,980 --> 00:06:59,470
.ما زال هُناك الكثير لأفعله

87
00:07:00,430 --> 00:07:02,450
!لا وقت لديّ لأضيّعه بالجلوس هكذا فقط

88
00:07:04,230 --> 00:07:05,730
.يال هذا الوجهِ المخيف

89
00:07:07,450 --> 00:07:10,130
.ما زال هنالك أكثر من أسبوع على مُباراتنا

90
00:07:10,130 --> 00:07:13,160
.إن تحمّستَ أكثر من اللّازم الآن، فستُرهقُ نفسك

91
00:07:14,180 --> 00:07:15,320
مخيف؟

92
00:07:15,320 --> 00:07:17,260
.أجل، أنت محق

93
00:07:17,260 --> 00:07:18,540
!ساوامورا

94
00:07:18,900 --> 00:07:21,280
،طالما أنّك لم ترمي الكثير في تدريبات اليوم

95
00:07:21,280 --> 00:07:22,610
أتريدُ الرمي في البولبين غداً؟

96
00:07:22,610 --> 00:07:23,540
!بالطّبعِ أريد

97
00:07:23,850 --> 00:07:26,560
.للتوّ كنتُ أفكّرُ بصقل الأرقام خاصّتي

98
00:07:26,560 --> 00:07:27,800
.فهمت

99
00:07:28,330 --> 00:07:32,430
.فلنُحاول أن ننتهي من صقلها قدر الإمكان قبل بطولة الصيف

100
00:07:32,810 --> 00:07:34,470
!أعتمدُ عليك أيّها القائد

101
00:07:35,100 --> 00:07:36,680
...صقلها بمثاليّة

102
00:07:36,980 --> 00:07:39,370
.إذن، وأنت يا فوريا ستكون في اليوم الذي يليه

103
00:07:39,370 --> 00:07:40,980
.شكراً لك

104
00:07:40,980 --> 00:07:41,930
،ميوكي

105
00:07:42,730 --> 00:07:43,470
وماذا عنّي؟

106
00:07:45,910 --> 00:07:47,370
متى ستلتقطُ لي؟

107
00:07:48,890 --> 00:07:49,980
أيُّ يومٍ يناسبُك؟

108
00:07:51,800 --> 00:07:52,750
..نوري

109
00:07:53,490 --> 00:07:55,420
!أجل يا نوري! اضغط عليه أكثر

110
00:07:55,420 --> 00:07:56,870
!ميوكي يرتعدُ خوفاً

111
00:07:56,870 --> 00:07:59,620
!سُحقاً، لو أنّهُ أظهرَ هذا الشغف مُبكراً فقط

112
00:07:59,620 --> 00:08:01,680
!كلّا! لم يفت الأوان بعد

113
00:08:02,590 --> 00:08:04,180
إذن، هل نفعلها الان؟

114
00:08:04,180 --> 00:08:06,130
!أجل، فلنفعلها

115
00:08:06,130 --> 00:08:07,800
!لقد وافق

116
00:08:07,800 --> 00:08:09,260
!نوري أرغمه على ذلك

117
00:08:09,260 --> 00:08:10,670
!إنّهما ثنائيٌّ الان

118
00:08:11,970 --> 00:08:12,880
ما الذي يحدثُ هُنا؟

119
00:08:12,880 --> 00:08:14,620
!حسنٌ، وأنا سأكونُ الضارب

120
00:08:14,620 --> 00:08:15,430
!وأنا سأكونُ الحكم

121
00:08:15,830 --> 00:08:17,960
آسو، أتريدُ التدرّب على آلة الضرب؟

122
00:08:17,960 --> 00:08:19,380
!كنتُ سأذهب من قبلِ أن تسأل

123
00:08:19,380 --> 00:08:21,590
!ماذا؟ وأنا الذي حاولتُ دعوتك

124
00:08:21,590 --> 00:08:23,810
!القفص ليس لك وحدك

125
00:08:24,890 --> 00:08:26,820
!أنتما! توقفا عن ذلك

126
00:08:26,820 --> 00:08:29,580
رقم قميصه ذو الخانة الواحدة مَنَحه الثقة، صحيح؟

127
00:08:29,580 --> 00:08:32,550
.أصبح لاعبوا السنة الثالثة على وفاقٍ مؤخراً

128
00:08:32,550 --> 00:08:34,320
.أجل، لاحظتُ ذلك أيضاً

129
00:08:34,750 --> 00:08:40,590
.عادةً، ميوكي-سينباي و كوراموتشي-سينباي يتسكّعان معاً في المدرسة، وجميعهم يضحكون سويةً

130
00:08:41,480 --> 00:08:45,290
!الأمرُ كما لو أنّهم مُسترخون بشكلٍ غريب، أو متحرّرون

131
00:08:54,120 --> 00:08:55,140
...أطول

132
00:08:56,560 --> 00:08:58,310
...أطول ولو ليومٍ واحد

133
00:09:00,780 --> 00:09:04,520
!أنا نجمُ هذا الفريق

134
00:09:07,540 --> 00:09:11,680
!لن أجعل صيف السينباي ينتهي بعد

135
00:09:14,710 --> 00:09:16,070
.مرحباً يا تيشّين

136
00:09:16,070 --> 00:09:18,520
.تمكنّا من الفوز في مُباراتنا الأولى بطريقةٍ ما

137
00:09:18,520 --> 00:09:21,970
.وتبقّى فوزٌ واحدٌ ونواجهكم

138
00:09:21,970 --> 00:09:26,750
.تبّاً، الآن علمتُ كم هو شاقٌّ أن يكون الفريق مصنّفاً كمدرستك

139
00:09:27,140 --> 00:09:30,500
.سننتظرك في الجولة الثالثة يا حضرة المدرب

140
00:09:31,840 --> 00:09:35,760
.أصبحت تتكلّم بتعالٍ أيّها الشقيّ المشاكس

141
00:09:36,330 --> 00:09:41,390
.صحيحٌ أنّي شغلتُ منصبي هذا في الخريف الماضي، ولكنّي كنتُ أستعد وأُجهّز اللّاعبين قبل ذلك بكثير

142
00:09:41,800 --> 00:09:44,900
.لذا فأنا متأهّبٌ تماماً

143
00:09:45,690 --> 00:09:47,810
.انتظر فقط

144
00:09:48,930 --> 00:09:51,310
!سأفعل! أتطلّعُ لمواجهتكم

145
00:10:04,070 --> 00:10:05,540
.صباح الخير

146
00:10:06,180 --> 00:10:07,460
...صباح

147
00:10:09,160 --> 00:10:10,420
.آسادا

148
00:10:11,380 --> 00:10:13,380
.انظر لهذا الغبي لوهلة

149
00:10:15,360 --> 00:10:18,050
!لقد نام بزيّه الرسميّ

150
00:10:22,300 --> 00:10:24,450
!آسادا، أعطِني قلماً

151
00:10:24,450 --> 00:10:25,020
ماذا؟

152
00:10:25,020 --> 00:10:25,910
...ما الذي

153
00:10:25,910 --> 00:10:27,590
!لا عليك! لا عليك

154
00:10:29,700 --> 00:10:31,360
ماذا؟ قائدة مشجّعات؟

155
00:10:31,650 --> 00:10:33,690
!أجل! قائدة المشجّعات

156
00:10:33,690 --> 00:10:36,280
!سأقومُ بدعمك بالتشجيع من المدرّجات

157
00:10:36,600 --> 00:10:38,070
بجدّية؟

158
00:10:38,070 --> 00:10:40,070
هل ستكونين بخيرٍ هناك؟

159
00:10:40,070 --> 00:10:42,610
!ضوء الشمس سيكون على المدرّجات طِوال الوقت

160
00:10:42,610 --> 00:10:43,540
ماذا؟

161
00:10:43,540 --> 00:10:45,370
.وهم لا يملكون سقفاً مثلنا في الدكّة

162
00:10:45,370 --> 00:10:47,020
!سيكونُ الحرُّ شديداً

163
00:10:47,020 --> 00:10:48,450
!لا تستهيني بالمدرّجات

164
00:10:48,450 --> 00:10:49,830
أحقاً ذلك؟

165
00:10:49,830 --> 00:10:52,880
،ولكنّي سأسأل السينباي بشأن ذلك

166
00:10:53,210 --> 00:10:55,350
!وسأستخدمُ واقياً للشمس أيضاً

167
00:10:53,710 --> 00:10:57,310
.مع أنّها دعتني، ولكن الأمر مستحيلٌ عليّ

168
00:10:55,350 --> 00:10:56,560
!لا تنهاري هناك فقط

169
00:10:56,560 --> 00:10:57,840
!ماذا؟

170
00:10:58,620 --> 00:11:01,020
.ولكن شكراً يا نيشينو

171
00:11:01,020 --> 00:11:04,890
!ونحنُ سنستجيبُ لتشجيعكم ونفعلُ ما بوسعنا

172
00:11:07,680 --> 00:11:09,960
!أجل، عليكم الوصول للكوشين

173
00:11:09,960 --> 00:11:11,880
!أجل، سنفعل

174
00:11:10,560 --> 00:11:13,270
.ساوامورا يبدو مختلفاً مُجدّداً

175
00:11:11,880 --> 00:11:13,270
!لا أُطيق الانتظار

176
00:11:13,270 --> 00:11:15,070
أحدث شيءٌ مع الفريق؟

177
00:11:13,270 --> 00:11:15,710
!الحرُّ سيكون شديداً في بطولة الصيف

178
00:11:15,710 --> 00:11:20,140
!فوريا لم يكن بالمدرّجات، ولكنّه كاد يموت تقريباً خلال مراسم الافتتاح

179
00:11:18,910 --> 00:11:20,140
.نوعاً ما

180
00:11:20,140 --> 00:11:21,530
!ماذا؟

181
00:11:23,390 --> 00:11:25,200
.حصلتُ على رقمٍ من خانةٍ واحدة

182
00:11:25,200 --> 00:11:26,410
...خانةٍ واحدة

183
00:11:26,890 --> 00:11:28,590
حقاً؟

184
00:11:27,540 --> 00:11:29,080
...أريدُ إخبار أحدهم

185
00:11:28,590 --> 00:11:31,590
!وأكومورا لم يكن مختلفاً عنه أيضاً

186
00:11:30,560 --> 00:11:32,350
!أريدُ أن يسألني الجميع

187
00:11:33,930 --> 00:11:34,630
...وبعدها

188
00:11:34,630 --> 00:11:37,520
!قمنا بكتابة الرقم على ظهره

189
00:11:37,520 --> 00:11:39,390
!لا أطيقُ الانتظار حتى يدخل للاستحمام

190
00:11:40,940 --> 00:11:42,260
.عليك التوقّف عن ذلك

191
00:11:42,940 --> 00:11:44,230
أهذا حقيقيّ؟

192
00:11:44,230 --> 00:11:44,920
!هذا عظيم

193
00:11:44,920 --> 00:11:46,640
!قلتُ لك

194
00:11:54,430 --> 00:11:56,410
!أيّها الرامي، الكرةُ للثالثة

195
00:11:56,410 --> 00:11:57,090
!حاضر

196
00:11:57,090 --> 00:11:58,280
!هلمّ بها

197
00:12:15,420 --> 00:12:18,020
.تحرّكات الجميع جيّدة

198
00:12:18,020 --> 00:12:21,700
.كنتُ قلقاً من تقبّل فوريا للأمر، ولكنّهُ يبدو بخير

199
00:12:22,980 --> 00:12:25,380
.يبدو أنّهُ تخطّى الأمر تماماً

200
00:12:26,620 --> 00:12:28,890
!حسنٌ، فلنفعلها يا كاني

201
00:12:29,290 --> 00:12:32,020
!صخب ساوامورا المعتاد لم يتغيّر

202
00:12:33,270 --> 00:12:34,230
!يو-سان

203
00:12:39,280 --> 00:12:42,320
!مذهل، تلك الالتقاطة والرمية كانت سريعة

204
00:12:42,320 --> 00:12:46,910
!تلك اللعبة تتطلّب ثقةً عمياء بين الرامي الملتقط

205
00:12:52,120 --> 00:12:54,500
!أنا رقم 5

206
00:12:55,100 --> 00:12:56,920
!حسنٌ! رميةٌ رائعة

207
00:12:57,720 --> 00:12:59,590
!ولكن رمية حظٍّ واحدة لا تعني شيئاً

208
00:13:00,120 --> 00:13:02,560
!إن فعلتها أكثر مرة فستثبت أنّها مهارتك الخاصة

209
00:13:03,820 --> 00:13:05,040
!صحيحٌ تماماً

210
00:13:07,470 --> 00:13:08,600
!ارجع لخلف! ارجع للخلف

211
00:13:13,890 --> 00:13:17,400
!إن كانت خطوتك الأولى أسرع، فسيسهل التقاطها

212
00:13:18,290 --> 00:13:19,890
.راقبني يا يوكي

213
00:13:19,890 --> 00:13:22,400
!هكذا تكون خطوتي الأولى

214
00:13:41,980 --> 00:13:43,120
!حسنٌ

215
00:13:43,120 --> 00:13:45,050
!رقم 2 تبدو جيّدة اليوم

216
00:13:45,980 --> 00:13:50,990
.سواء كان ضارباً أيمن أم أعسر، فلن يستطيع التعامل معها عندما تسقط ناحية قدميه هكذا

217
00:13:51,800 --> 00:13:53,770
!إذن فلتكن التالية رقم 11

218
00:13:54,110 --> 00:13:55,860
!سأرمي 10 رميات توالياً

219
00:13:57,070 --> 00:13:57,910
.كلّا

220
00:13:59,060 --> 00:14:01,980
.لقد رميتَ بالأمس، لذا فلنتوقف هنا اليوم

221
00:14:04,490 --> 00:14:05,450
!ماذا؟

222
00:14:05,450 --> 00:14:06,900
!ولكنّي ما زلتُ قادراً على الرميّ

223
00:14:06,900 --> 00:14:08,400
.لقد رميتَ 120 رمية

224
00:14:08,400 --> 00:14:09,740
.هذا يكفي لهذا اليوم

225
00:14:10,340 --> 00:14:13,040
.أرِح جسدك وتذكّر بأنّك لن ترمي غداً

226
00:14:13,040 --> 00:14:15,540
!لن أرمي؟

227
00:14:16,140 --> 00:14:18,290
!إذن دعني أرمي أكثر اليوم

228
00:14:18,290 --> 00:14:19,420
!أيّها القائد

229
00:14:23,630 --> 00:14:24,090
!أكومورا

230
00:14:24,090 --> 00:14:25,610
.أنا أرفض

231
00:14:26,420 --> 00:14:27,970
!يا عديم الإحساس

232
00:14:28,350 --> 00:14:30,870
.أنا أتفق في أنّك رميتَ الكثير

233
00:14:35,650 --> 00:14:37,080
.إنّهُ يكبح غضبه

234
00:14:38,310 --> 00:14:40,390
!فهمت! سأتوقفُ هنا اليوم

235
00:14:40,390 --> 00:14:45,200
!ولكن بما أنّى لن أهدأ الآن، فسأركض 10 دوراتٍ بالإطار

236
00:14:45,200 --> 00:14:46,980
لمَ أنت غاضبٌ هكذا؟

237
00:14:47,740 --> 00:14:49,330
!أستأذنكم يا سادة

238
00:14:51,680 --> 00:14:52,950
...يا إلهي

239
00:14:53,640 --> 00:14:58,950
.مع حسّه العالي بالمسؤولية، توقعتُ أن يكون بهذا الحماس بعد حصوله على رقم النجم

240
00:15:00,310 --> 00:15:04,000
.ولكن ذلك يستنفد طاقته بشدّة

241
00:15:05,030 --> 00:15:10,430
.على هذا الحال، سيصعب تخمين ما سيحدث فعلياً في المُباراة

242
00:15:32,700 --> 00:15:33,650
!أجل

243
00:15:33,650 --> 00:15:34,950
!ضربةٌ رائعة يا سين

244
00:15:34,950 --> 00:15:37,450
!كما هو متوقّعٌ من المنظّف

245
00:15:37,830 --> 00:15:40,010
المنظّف حصل على نقطةٍ أُخرى؟

246
00:15:40,460 --> 00:15:42,920
كان يستهدف تلك المنحنية، صحيح؟

247
00:15:42,920 --> 00:15:43,900
.أجل

248
00:15:43,900 --> 00:15:46,460
.انتظرَ حتى آخر لحظة للتلويح

249
00:15:47,380 --> 00:15:50,470
.حقاً ذلك الفتى يُعتمد عليه عند الحاجة

250
00:15:50,970 --> 00:15:53,540
.المدهش حقاً هو ذلك العجوز

251
00:15:53,540 --> 00:15:56,850
كيف لهُ أن يعلمَ بأن الرمية الثالثة ستكون منحنية؟

252
00:15:57,280 --> 00:16:02,530
.إنّهُ دائماً ما يتوقّع بدقّة ضربات البَنت أو محاولة سرقة القاعدة

253
00:16:03,630 --> 00:16:07,110
،أنا أهابك أكثر من احترامك

254
00:16:07,390 --> 00:16:09,470
!يا عجوز كرة القاعدة الوحش

255
00:16:09,470 --> 00:16:13,190
.والآن، يبدو أن هنالك نقاطاً تنتظرُ منّا تسجيلها

256
00:16:15,410 --> 00:16:20,630
.دخل هيغاشياما في الشوط السادس وأخرج ضاربي (سوغيوتشي) الستة

257
00:16:20,630 --> 00:16:23,570
.انتهت المباراة مع الشوط السابع بنتيجة 13-2

258
00:16:25,410 --> 00:16:27,880
...وبذلك، فخصمنا الأوّل

259
00:16:27,880 --> 00:16:30,730
.سيكون (يورا سوغو)

260
00:16:35,360 --> 00:16:37,840
.لقد فازوا بمُباراتيهم مع الرأفة

261
00:16:37,840 --> 00:16:40,600
.لذا أفترض بأن ضاربوهم جيّدون

262
00:16:41,170 --> 00:16:43,740
...السكويز، سرقة القواعد، ضربةٌ وركضة

263
00:16:43,740 --> 00:16:48,870
.مع قدرتهم الفعّالة بالتسجيل، رميةٌ واحدة كفيلةٌ لهم بقلب النتيجة، هذا ما بدا لي

264
00:16:50,430 --> 00:16:52,210
.نقطةٌ واحدة في كلّ مرة

265
00:16:52,210 --> 00:16:56,450
.ورامي الخصم لم يُدرك على الأرجح كيف قُلِبت النتيجة

266
00:16:57,940 --> 00:17:00,330
،نجمهم هيغاشياما برميته السريعة العالية

267
00:17:00,330 --> 00:17:03,620
...وضاربهم المنظّف سيندا والذي سجّل 3 نقاط في هذه المُباراة

268
00:17:03,980 --> 00:17:07,990
.هذانِ الاثنانِ أكثرُ من علينا الحذر منهم

269
00:17:07,990 --> 00:17:12,510
،ولكن الأفضلية لنا بعد أن حلّلنا مُباراتين لهم قبل مواجهتهم

270
00:17:12,510 --> 00:17:15,950
.وذلك سهّل علينا معرفة أسلوب ضاربيهم وعاداتهم

271
00:17:16,970 --> 00:17:18,510
.علينا الاطّلاع على معلومات الضاربين لاحقاً

272
00:17:19,290 --> 00:17:19,860
.أجل

273
00:17:21,720 --> 00:17:26,270
.تشكيلة الضاربين التي يعتمدون عليها، واستراتيجيّة الرميّ التي تجعل النجم يلعبُ كبديل

274
00:17:26,990 --> 00:17:30,650
.ولكن الأهم من ذلك، هو الزخم الذي اكتسبوه من فوزهم بالمُباراتين

275
00:17:31,700 --> 00:17:34,550
.نحنُ حتماً لن نُرخي دفاعنا أمامهم

276
00:17:36,650 --> 00:17:40,250
.ومدرّبا الفريق هما في السابق مدرّبٌ ولاعبُه

277
00:17:40,250 --> 00:17:42,910
.كلاهما يعلمُ بما يفكّر فيه الآخر

278
00:17:43,740 --> 00:17:46,870
...وبوضع ذلك في الحسبان، فسأعلن عن الرامي البادئ

279
00:17:48,630 --> 00:17:49,630
،ساوامورا

280
00:17:49,980 --> 00:17:51,370
.أعتمدُ عليك

281
00:17:55,980 --> 00:17:56,680
!حاضر

282
00:17:58,570 --> 00:18:00,190
،وللجولة الرابعة بعد يومين منها

283
00:18:00,870 --> 00:18:01,640
!فوريا

284
00:18:02,520 --> 00:18:03,520
.ستكونُ البادئ

285
00:18:06,360 --> 00:18:08,270
.وأيضاً، كاواكامي و كانيدا

286
00:18:08,950 --> 00:18:12,660
.مهما كان خصمنا، عليكما الاستعداد في البولبين من بداية المُباراة

287
00:18:12,660 --> 00:18:13,780
!حاضر

288
00:18:14,960 --> 00:18:17,400
!في هذه البطولة، الخسارةُ تعني النهاية

289
00:18:17,730 --> 00:18:23,740
لن أقول هذا للاعبيّ الميدان وحدهم، ولكن حتّى لأولئك
.الذين في الدكّة، عليكم أن تكونوا على أهبة الاستعداد للعب بأفضل ما لديكم

290
00:18:24,110 --> 00:18:25,070
!حاضر

291
00:18:31,340 --> 00:18:34,740
.وظيفةُ الرامي البادئ تختلفُ عن البديل

292
00:18:35,790 --> 00:18:40,380
.ولكن طبعاً بالنظر لمجريات المُباراة، فقد يختلف توزيع الأدوار

293
00:18:40,380 --> 00:18:46,060
.ولكن توضيح المدرّب للرّماة بأدوارهم من الآن، سيجعل استعدادهم أكثر سهولةً

294
00:18:54,940 --> 00:18:59,870
.بالطّبع منحك رقم النجم يعني أن هُنالك توقعات كبيرة عليك

295
00:19:01,030 --> 00:19:04,990
.ولكنك حصلتَ عليه لأنك ارتقيت لمستوى هذا الرقم

296
00:19:06,220 --> 00:19:10,070
.لذا ما أريدهُ منك الآن هو أن تُظهِر ما كنت تفعلُه بأفضل صورة على التلّ

297
00:19:18,820 --> 00:19:21,650
،مُباراتنا الأولى في الصيف

298
00:19:21,650 --> 00:19:23,430
،الخطوةُ الأولى نحوَ البطولة الوطنيّة

299
00:19:23,820 --> 00:19:27,630
.أول مرّةٍ يرتدي فيها رقم النجم، وهي البداية الرسميّة له

300
00:19:29,190 --> 00:19:31,970
...هذه البداية المليئة بالضغط على ساوامورا

301
00:19:34,990 --> 00:19:37,820
.آمل أن لا تسير الأمور على نحوٍ سيء

302
00:19:40,380 --> 00:19:41,160
ماذا؟

303
00:19:41,160 --> 00:19:42,700
أخي؟

304
00:19:43,240 --> 00:19:45,150
مُباراتكم الأولى ستكون بعد يومين، صحيح؟

305
00:19:49,390 --> 00:19:51,910
!فلتكونا أفضل مدافِعَين باليابان

306
00:19:53,210 --> 00:19:54,290
!أجل

307
00:19:54,290 --> 00:19:56,050
!سنلعبُ ضد (يورا سوغو)

308
00:19:58,120 --> 00:19:59,690
!أنا جاهزٌ بالتأكيد

309
00:19:59,690 --> 00:20:02,220
!تجاوزتُ أيامي السيئة تماماً الآن

310
00:20:02,220 --> 00:20:04,140
!نحنُ نتطلّعُ للقمّة

311
00:20:04,140 --> 00:20:06,800
!لذا انتظرنا في الكوشين يا جون-سان

312
00:20:09,810 --> 00:20:10,820
أتُمانع انضمامي لك؟

313
00:20:12,150 --> 00:20:13,330
...فوريا-سان

314
00:20:14,780 --> 00:20:16,870
هل أنت متأكدٌ أنّك تُريدُ التلويح فقط؟

315
00:20:17,510 --> 00:20:18,940
.إن أردتَ الرميّ، فسألتقطُ لك

316
00:20:18,940 --> 00:20:19,790
،أجل

317
00:20:20,880 --> 00:20:22,030
.سنفعلُ ذلك بالغد

318
00:20:54,060 --> 00:20:55,760
.ما يزالُ متصلّباً

319
00:20:55,760 --> 00:20:57,980
.أعتقدُ بأن وجهك كان أغبى من ذلك

320
00:20:58,290 --> 00:20:59,060
صحيح؟

321
00:20:59,060 --> 00:21:00,360
.أتفقُ معك

322
00:21:00,360 --> 00:21:00,920
—ماذ

323
00:21:00,920 --> 00:21:03,860
.في السابق كان مرتاحاً وأكثر إثارةً للشفقة

324
00:21:04,950 --> 00:21:06,110
مثيراً للشفقة؟

325
00:21:06,420 --> 00:21:08,270
!وأساساً، ما هذا التدريب؟

326
00:21:08,270 --> 00:21:10,270
!لم لا تسمحون لي بالرميّ؟

327
00:21:10,270 --> 00:21:13,120
!أريدُ تجربة الأرقامِ أكثر

328
00:21:13,400 --> 00:21:14,760
أحقاً تسألُ لماذا؟

329
00:21:14,760 --> 00:21:17,340
.نحنُ نفعل ذلك لأنّك متوتّرٌ للغاية

330
00:21:17,340 --> 00:21:21,130
.من الواضح أن رقم النجم لهُ حِملٌ ثقيل عليك

331
00:21:23,240 --> 00:21:25,380
.مع أنّي آمل أن ذلك يعني بأنك راضٍ عن نفسك

332
00:21:25,380 --> 00:21:29,520
.ومع ذلك، لا يُمكنُني تركك على هذا الحال بصفتي مُلتقاطاً وقائداً للفريق

333
00:21:29,520 --> 00:21:31,220
!لا تقل ذلك بشكلٍ مُباشر

334
00:21:31,220 --> 00:21:33,770
!ألا يُمكنك قولها بشكلٍ ألطف؟

335
00:21:34,140 --> 00:21:36,760
.إن لم أقلها بشكلٍ مباشر، فلن تفهمها

336
00:21:36,760 --> 00:21:38,420
!لأي درجةٍ تعتقدُ أنّي غبي؟

337
00:21:41,530 --> 00:21:43,790
.ولكن دعني أعترفُ لك بشيء

338
00:21:43,790 --> 00:21:44,540
ماذا؟

339
00:21:44,540 --> 00:21:46,540
،قبل شهرينِ من الآن

340
00:21:46,540 --> 00:21:51,620
.لم أتخيّل قط بأنّك سترتدي رقم النجم في بطولة الصيف هذه

341
00:21:54,850 --> 00:21:58,600
.أنتم يا رفاق دوماً ما تتجاوزون توقّعاتي

342
00:22:12,800 --> 00:22:13,890
".تحفيز"

343
00:23:45,460 --> 00:23:46,930
.سأقومُ بالإحماء للاحتياط

344
00:23:46,930 --> 00:23:49,220
!أنت لن ترمي اليوم

345
00:23:49,220 --> 00:23:51,490
!لا تجرؤ على تجاوز ذلك الخط ثانيةً

346
00:23:51,490 --> 00:23:56,430
.لا شكّ أن هذا الثنائي قد تجاوز العديد من المواقف الصّعبة معاً حتى الآن

347
00:23:56,430 --> 00:24:03,010
.كلّما كان الموقف صعباً، كلّما تحوّلوا للرميّ بأكثر رميةٍ يثقون بها

348
00:24:03,010 --> 00:24:04,240
.الجميع يُساندونني

349
00:24:04,240 --> 00:24:06,170
...عليّ فقط التركيز على ذلك القفّاز

350
00:24:06,530 --> 00:24:09,330
!كل ما عليّ فِعله هو التركيز على قفّاز الملتقط

351
00:24:09,330 --> 00:24:11,680
:في الحلقة القادمة من نجم الألماسة - الفصل الثاني

352
00:24:11,680 --> 00:24:13,000
".موطئ القدم"

353
00:24:11,680 --> 00:24:15,010
الحلقة القادمة

354
00:24:13,000 --> 00:24:15,010
!فلنفز بالبطولة الوطنيّة