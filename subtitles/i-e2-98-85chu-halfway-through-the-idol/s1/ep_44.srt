1
00:00:05,480 --> 00:00:07,480
!دعهُ يضربُها نحوي يا سوامورا

2
00:00:10,440 --> 00:00:11,950
!أحسنت يا سوامورا

3
00:00:15,580 --> 00:00:17,830
!سترايك! الضاربُ للخارج

4
00:00:17,830 --> 00:00:19,820
.ذلك هو سوامورا من (سيدو) إذن

5
00:00:19,820 --> 00:00:21,330
أكانت تلك ذات الدرزتين؟

6
00:00:21,330 --> 00:00:22,720
!لقد سقطت بشكلٍ عجيب

7
00:00:22,720 --> 00:00:24,460
كم كانت سرعتُها؟

8
00:00:24,460 --> 00:00:27,170
!أعتقدُ أنّهُ لا يُمكنُنا القولُ بأنّها رميةٌ سريعة

9
00:00:27,170 --> 00:00:28,590
.وقد بدت مُرتفعةً للغاية

10
00:00:28,900 --> 00:00:32,200
!يا إلهي، التفكيرُ بالإطاحةِ بفوريا وحده كان صعباً للغاية

11
00:00:32,200 --> 00:00:36,040
.نحنُ بلا شكّ لن نستطيعَ تجاهُلَ هذا الرامي بعد الآن

12
00:00:43,580 --> 00:00:46,200
:لا تنسوا زيارتنا في

13
00:00:43,580 --> 00:00:46,200
منتديات العاشق

14
00:02:09,430 --> 00:02:11,310
.الرقم 2 تبدو جيّدةً اليوم

15
00:02:12,130 --> 00:02:15,990
.والرقم 11 لا تُجدي نفعاً بسبب طريقة أصابعهِ الخاطئة في رميها

16
00:02:16,750 --> 00:02:20,630
.طريقةُ انكسار الأرقام تختلفُ بحسبِ اليوم

17
00:02:20,630 --> 00:02:25,080
.ما يجعلُ الأمرَ مُمتعاً ومُزعجاً في نفس الوقت

18
00:02:26,260 --> 00:02:27,630
...وطريقةُ نجاتهِ هي

19
00:02:28,610 --> 00:02:30,080
!رميتهُ السّريعة

20
00:02:31,950 --> 00:02:32,960
...داخليّةٌ وخارجيّة

21
00:02:35,240 --> 00:02:38,700
.بإمكانهِ رميُها بدقّة مثاليّة، مما يُتيحُ لنا العديد من الخيارات

22
00:02:39,770 --> 00:02:41,390
!لقد حاصرَ الضاربَ برميتين فقط

23
00:02:41,390 --> 00:02:43,350
!إنّهُ حقّاً لا يُضيّعُ أيّ رمية

24
00:02:43,350 --> 00:02:46,350
.لقد رمى 38 رمية في 5 أشواط

25
00:02:47,510 --> 00:02:54,660
.معدّل النقاط التي خسِرَها ضد (هاكوريو)، (ناروتا)، و (كومي) كان 1.17 فقط وهي مدارسٌ قويّة

26
00:02:55,980 --> 00:03:01,300
...قدرتهُ على التكيّف مع الأوضاع الصعبة، وتركيزهُ التامّ على كلِّ رمية

27
00:03:02,420 --> 00:03:07,250
.ويبدو أنّهُ كلّما واجه فريقاً قويّاً، رميهُ يصقلُ أكثر فأكثر

28
00:03:09,990 --> 00:03:12,000
!سترايك! الضاربُ للخارج

29
00:03:12,000 --> 00:03:13,380
!أجل

30
00:03:13,730 --> 00:03:16,630
أيعني ذلك أنّ ثقته تنتقلُ لرمياتِه؟

31
00:03:16,630 --> 00:03:18,820
.أنا سعيدٌ لكوني أخطأتُ بشأنِه

32
00:03:20,230 --> 00:03:26,010
.في ظلّ تدهور مستوى فوريا، سوامورا قد أظهرَ تطوّراً مُذهلاً

33
00:03:29,490 --> 00:03:30,590
.هذا لا يكفي

34
00:03:32,600 --> 00:03:34,440
.هذا لا يكفي بعد

35
00:03:35,990 --> 00:03:36,940
.أريدُ الرميّ

36
00:03:39,130 --> 00:03:40,950
.أريدُ الرميّ أكثر

37
00:03:42,220 --> 00:03:43,290
...أريدُ

38
00:03:44,620 --> 00:03:48,200
.الرميّ ضد رُماةٍ مُذهلين

39
00:03:52,780 --> 00:03:55,240
.سيكونُ ظهوركَ الأوّل منذُ مدّة كرامٍ في مُباراة فعليّة

40
00:03:55,240 --> 00:03:58,280
لهذا، أيجبُ علينا التركيزُ على الرّمياتِ السّريعةِ في البداية؟

41
00:03:58,670 --> 00:04:04,050
.إن استطعتَ إبقاء رمياتك في منطقة الإصابة، فلن يكونَ بمقدورِهم ضربُها

42
00:04:04,900 --> 00:04:08,170
.أنا لستُ رامياً يستطعُ كبحَ نفسِه

43
00:04:08,170 --> 00:04:09,200
.أجل

44
00:04:09,200 --> 00:04:10,930
.أعلمُ ذلك

45
00:04:13,720 --> 00:04:14,770
...أتعلمُ أن إيجون

46
00:04:16,220 --> 00:04:18,570
.كانَ الشخص المُلهِمَ لي

47
00:04:19,330 --> 00:04:21,490
.لقد رأيتُ كيف كان يعملُ بجدّ

48
00:04:22,640 --> 00:04:27,330
.قلتُ لهُ بأنّهُ قد أبلى بلاءً حسناً ضد (هاكوريو)، وكنتُ أعني ذلك تماماً

49
00:04:28,430 --> 00:04:30,410
.إنّهُ يّغيّرُ مِزاج الفريق

50
00:04:30,410 --> 00:04:32,350
.وحريصٌ على تطويرِ نفسِه

51
00:04:33,410 --> 00:04:36,670
.أعتقدُ أن رامياً مثله هو ما قد احتاجهُ الفريق

52
00:04:39,340 --> 00:04:40,510
...ولكنّ

53
00:04:41,400 --> 00:04:44,910
.أنا الآخرُ لا أريدُ الخسارةَ أمام أيٍّ كان على التلّة

54
00:04:46,060 --> 00:04:48,300
،لطالما كانت تلكَ طريقتي

55
00:04:48,970 --> 00:04:51,130
.ولن أقوم بتغييرها الآن

56
00:04:52,500 --> 00:04:55,730
...وقد يُسبّبُ ذلك مشكلةً لكَ وللفريق

57
00:04:56,490 --> 00:04:57,590
.أنا كذلك

58
00:04:58,990 --> 00:05:03,400
.أنا الآخرُ لا أُريدُ الخسارةَ أمام أيٍّ كان

59
00:05:06,640 --> 00:05:09,760
.لا بأس إن حصلوا على بعض الضربات في البداية، لذا سنبدأُ بالرميّ في المنتصف مباشرةً

60
00:05:09,760 --> 00:05:13,620
.إن تقدّمنا في التعّداد، فسأطلبُ رمياتٍ مُنكسِرة

61
00:05:14,460 --> 00:05:17,290
.وبحسب نتيجة رمياتِك، سنقرّرُ ماذا سنرمي تالياً

62
00:05:17,790 --> 00:05:22,700
.رجاء امنحني تلكَ الرّميات الفريدة التي يُعرفُ بها فوريا ساتورو، تماماً كما فعلتَ في البولبين

63
00:05:24,280 --> 00:05:27,300
!أعدك بأنّي سأكون ذا عونٍ لك

64
00:05:30,900 --> 00:05:32,890
!سترايك! الضاربُ للخارج

65
00:05:33,180 --> 00:05:35,150
!أجل

66
00:05:39,660 --> 00:05:41,900
!خروجان

67
00:05:43,260 --> 00:05:47,180
.صحيحٌ أنّنا مُتقدّمون بفارقٍ مُريح، ولكنّهم سجّلوا نقطة، ولديهم راكضان في موضع تسجيل

68
00:05:47,180 --> 00:05:49,780
!الأمرُ منوّطٌ بتلويحةِ ذراعِه

69
00:05:49,780 --> 00:05:51,400
!احسمِ الأمر يا توجو

70
00:05:51,400 --> 00:05:52,540
!نلّ منه

71
00:05:53,180 --> 00:05:55,660
حانَ الوقتُ لتُظهِرَ غريزتكَ كرامٍ

72
00:05:58,370 --> 00:06:00,820
.استطاعَ أرجحةَ ذراعِه بشكلٍ كامل

73
00:06:03,380 --> 00:06:06,720
!أجل! هذا فوزنا الرابعَ عشر على التوالي

74
00:06:06,720 --> 00:06:08,480
!أحسنت الرميّ يا توجو

75
00:06:08,480 --> 00:06:10,070
!أحسنتَ الرميّ

76
00:06:11,100 --> 00:06:12,860
.توجو هيديكي

77
00:06:12,860 --> 00:06:15,730
أهوَ رامٍ آخر علينا الحذر منه؟

78
00:06:16,050 --> 00:06:18,190
!انتصارٌ ساحقٌ على (هينو) ومن دون فوريا

79
00:06:18,190 --> 00:06:20,610
!(سيدو) تُحافظُ على زخمها

80
00:06:20,610 --> 00:06:22,320
!شكراً على المُباراة

81
00:06:24,830 --> 00:06:27,110
!سترايك! الضاربُ للخارج

82
00:06:28,450 --> 00:06:31,550
!فوريا ساتورو يرمي هُناك

83
00:06:31,550 --> 00:06:33,780
لمَ يرمي في مُباراة للتشكيلةِ الثانية؟

84
00:06:34,790 --> 00:06:39,670
.رمياتهُ عالية، ولكن سرعتها وقوّتها تُجبرُ الخصمَ على التلويح

85
00:06:40,450 --> 00:06:42,320
.هذا هوَ الخروجُ الأوّل

86
00:06:42,320 --> 00:06:44,420
.رمياتهُ عالية

87
00:06:44,940 --> 00:06:47,360
.إنّها المرّةُ الأولى التي يعتلي فيها التلّة منذُ أسبوعين

88
00:06:47,990 --> 00:06:50,430
.حصلنا على الخروج الأوّل كما نريد

89
00:06:51,250 --> 00:06:55,340
.أعتقدُ بأنّي سأضعُ القفّاز في المنتصف، وسنعتمدُ على القوّة في إخراجهم هذا الشوط

90
00:07:00,710 --> 00:07:02,810
.المعذرة، وقتٌ مستقطع

91
00:07:04,840 --> 00:07:06,180
ما الأمر؟

92
00:07:06,180 --> 00:07:07,440
أتواجهُ صعوبةً في الرميّ؟

93
00:07:07,440 --> 00:07:09,950
.كلّا، ليسَ ذلك

94
00:07:10,340 --> 00:07:14,460
.لديّ شعورٌ بأن هذا الفريقَ سيُلوّحُ حتّى للرّميات ذات المسار الضعيف

95
00:07:15,140 --> 00:07:19,080
أيُمكنُكَ أن تضع قفّازك للخارجِ عوض المنتصف؟

96
00:07:20,690 --> 00:07:24,590
.أريدُ التركيز على التقنيات يقدرِ التركيز على النتائج في هذهِ المُباراة

97
00:07:27,110 --> 00:07:28,910
!ما هذا إلّا الضاربُ الثاني

98
00:07:29,880 --> 00:07:31,300
.فهمت

99
00:07:31,300 --> 00:07:33,320
.فلننتقل للرّميات الخارجيّة إذن

100
00:07:36,170 --> 00:07:39,870
.هدفنا هوَ العمل على تحسين نقاط ضعفِه، ولكنّي لم أطلب منه إلّا رمياتٍ في المنتصف

101
00:07:40,510 --> 00:07:42,520
.كانت تلكَ قيادةً وقحةً منّي

102
00:07:43,710 --> 00:07:46,960
.إنّهُ الشخصُ الذي يرتدي رقم النجم في (سيدو)

103
00:07:47,660 --> 00:07:49,360
،إنّهُ لا ينظرُ لهذهِ المُباراة فقط

104
00:07:50,320 --> 00:07:52,030
.بل إلى جميعِ المُباريات القادمة

105
00:08:01,590 --> 00:08:03,500
.لا يوجدُ طريقٌ مختصرٌ نحوَ المجد

106
00:08:03,500 --> 00:08:08,750
.الفريقُ ليسَ بحاجةٍ للاعبٍ لا يُفرّقُ بين العدوانيّةِ والغطرسة

107
00:08:08,750 --> 00:08:12,630
أيُّ نوعٍ من الرُّماةِ برأيكَ هو الأفضلُ في اليابان؟

108
00:08:13,040 --> 00:08:16,260
.نحنُ لن نسمحَ لكَ بلعبِ كرةِ القاعدة لوحدك

109
00:08:16,640 --> 00:08:19,990
!لا أحدَ فينا راضٍ عن ما قدّمهُ في بطولة الرّبيع

110
00:08:19,990 --> 00:08:22,140
!لا تضع اللّوم على نفسك

111
00:08:23,490 --> 00:08:26,190
.الأمرُ لا يتعلّقُ بتنفيذ رغبتي من عدمها

112
00:08:27,310 --> 00:08:31,280
.مهما كان الوضعُ الذي يُشاركُ فيه، فهو يرمي أفضل ما لديه

113
00:08:31,990 --> 00:08:34,280
.وأنا أُعدُّ نفسي لفِعلِ المِثل

114
00:08:34,990 --> 00:08:38,030
...الأمرُ فقط أنّهُ ولأجل الفوز

115
00:08:39,060 --> 00:08:43,330
.سأنتزعُ رقم النجمِ منكَ حتماً

116
00:08:43,640 --> 00:08:47,210
.إنّ أردّتما الرميّ، فتعالا لرؤيتي

117
00:08:47,760 --> 00:08:49,710
!أنا لستُ راضياً البتّة

118
00:08:50,110 --> 00:08:53,320
.لا يُمكنُنا الخسارةُ أمامه

119
00:08:55,380 --> 00:08:56,230
...أنا

120
00:08:58,790 --> 00:09:00,770
...أريدُ أن أُصبحَ

121
00:09:03,280 --> 00:09:05,230
!الأفضلَ في اليابانِ رفقة هذا الفريق

122
00:09:07,770 --> 00:09:09,730
!سترايك

123
00:09:17,010 --> 00:09:18,160
!سترايك

124
00:09:18,500 --> 00:09:21,190
.لا أحدٌ بمقدورهِ ضربَ رمياتهِ الخارجيّة عندما تأتي في منطقة الإصابة

125
00:09:21,190 --> 00:09:23,910
!أنا سأضربها! يتحتّم عليّ ذلك

126
00:09:24,690 --> 00:09:26,800
.خروجان ولا يوجد راكضين

127
00:09:26,800 --> 00:09:29,660
.التعّدادُ: 1 بول، 2 سترايك

128
00:09:29,660 --> 00:09:31,550
.ورمياتهُ قد استقرّت الآن

129
00:09:36,690 --> 00:09:38,780
.أرجِح ذراعكَ كاملةً من فضلك

130
00:09:39,620 --> 00:09:41,680
.فلنجعل قوّةَ رميتكَ تُجبرهُ على التلويح

131
00:09:47,560 --> 00:09:48,230
.بول

132
00:09:49,730 --> 00:09:51,920
هل الكرةُ علِقت بين أصابعه؟

133
00:09:51,920 --> 00:09:53,360
.أظنُّ ذلك

134
00:09:53,920 --> 00:09:56,490
.أصابعهُ مقبوضةٌ بالكامل

135
00:09:56,970 --> 00:10:01,870
.عندما تأتي الكُرةُ بهذه السرعة، سيكونُ التقاطها أمراً صعباً مع انحرافها

136
00:10:02,410 --> 00:10:04,310
.إنّها المرّةُ الأولى التي يُشكّلُ فيها ثنائياً مع فوريا

137
00:10:04,870 --> 00:10:06,970
.لا يُمكنُني لومهُ على عدم إلتقاطها

138
00:10:09,930 --> 00:10:11,540
.ما زال لدينا كُرَتانِ للتجربة

139
00:10:12,140 --> 00:10:13,840
.فلنتحدّى الخصمَ بها

140
00:10:14,480 --> 00:10:16,670
.ركّز على ارتفاعِ الكُرةِ عوضاً عن مسارها

141
00:10:17,120 --> 00:10:19,500
.اجعلِ الكُرةَ تأتي فوقَ الصحن

142
00:10:20,360 --> 00:10:23,870
حسنٌ .. ماذا لديكَ الان لإنهائِه؟

143
00:10:31,810 --> 00:10:33,650
!أجل، لقد لوّح

144
00:10:33,650 --> 00:10:34,820
!ولكن المُلتقطَ قد أخفق

145
00:10:37,360 --> 00:10:39,370
!مذهل! الخروج الثالث على التوالي

146
00:10:39,370 --> 00:10:41,120
!هذهِ بدايةٌ مدهشة

147
00:10:41,440 --> 00:10:42,970
ذلك الكوهاي هادئ، أليس كذلك؟

148
00:10:42,970 --> 00:10:45,760
.أجل، ورميتهُ دقيقةٌ أيضاً

149
00:10:46,250 --> 00:10:47,570
.أنا آسف

150
00:10:47,570 --> 00:10:49,250
.سألتقطها في المرّةِ القادمة

151
00:10:49,970 --> 00:10:52,730
.تمكنّا من إخراج أوّل ثلاثة ضاربين

152
00:10:52,730 --> 00:10:55,250
.سأعتمدُ على قيادتكَ في الشوطِ التالي أيضاً

153
00:10:58,540 --> 00:11:02,190
.مهما كان الرّامي الذي معه، فإنّ كوشي لا يتغيّر

154
00:11:02,190 --> 00:11:06,140
.إنّهُ مذهلٌ بحقّ عندما يتعلّق الأمر بكرة القاعدة

155
00:11:06,620 --> 00:11:08,170
كيف ستضربُ هذه؟

156
00:11:08,170 --> 00:11:10,350
!"لن أفعل! سأتركها وستكون "بول

157
00:11:11,240 --> 00:11:16,090
.إنّهُ لأمرٌ رائع مقدرتهم على رمي المنفصلة عِوَض السّريعة وجعل الضارب يُلوّحُ لها

158
00:11:16,720 --> 00:11:21,700
.ذلك سيُشجّعُ فوريا ويُعطي أكومورا المزيد من الخيارات في الشوطِ التالي

159
00:11:23,100 --> 00:11:25,490
!لم يكن يتباهى بنفسهِ إذن

160
00:11:27,490 --> 00:11:29,840
طلبَ نفس الرّمية مجدّداً رغم إخفاقهِ بها؟

161
00:11:32,220 --> 00:11:33,830
!أحسنت الرميّ يا فوريا

162
00:11:33,830 --> 00:11:35,210
!أحسنت في استخدام قوّتك

163
00:11:35,210 --> 00:11:37,000
!وأنت يا أكومورا أحسنت في التقاطها

164
00:11:37,560 --> 00:11:39,510
!استمرّ هكذا وأخرجهم جميعاً

165
00:11:39,790 --> 00:11:42,540
.أستخدمُ قوّتي؟ هذا لا يُسعدني

166
00:11:42,540 --> 00:11:44,390
!باتَ ينظرُ لنا بدونيّةٍ الآن

167
00:11:48,220 --> 00:11:50,910
.فوريا رمى لثلاثة أشواط في هذهِ المُباراة

168
00:11:50,910 --> 00:11:53,520
.أخرج 6 ضاربين، ومنحهم مشيةً واحدة

169
00:11:54,620 --> 00:11:58,190
.مُظهراً أداءاً مُمتازاً في مُباراة عودتهِ بعد الإصابة

170
00:12:09,500 --> 00:12:12,620
!أجل، دفاعٌ رائع يا كانيداتشي

171
00:12:12,620 --> 00:12:13,870
!خروجٌ واحد

172
00:12:14,430 --> 00:12:16,380
،يُخرجونهم بسهولة

173
00:12:16,810 --> 00:12:19,340
.تم حقاً تدريب لاعبيّ (سيدو) جيّداً

174
00:12:19,780 --> 00:12:24,340
.هذا النّوعُ من اللّعبِ هو الذي يشكّل الفارق في مُباراةٍ مُتقاربة

175
00:12:28,070 --> 00:12:29,840
.أنا أبرعُ في الدّفاع

176
00:12:33,450 --> 00:12:36,900
.دائماً أكونُ متأهباً وجاهزاً

177
00:12:37,560 --> 00:12:41,510
.سأتجنّبُ التلويح نحو الـ "بول"، وأزيدُ معدّل وصولي للقواعد

178
00:12:42,150 --> 00:12:44,770
.بإمكاني فِعلُ الكثير

179
00:12:44,770 --> 00:12:47,660
.إن استطعتُ اللّعب، فأنا على يقينٍ أنّي سأُظهرُ النتائج

180
00:12:48,060 --> 00:12:49,830
!أريدُ المزيدَ من الفرص

181
00:12:50,940 --> 00:12:53,240
.أنا جاهزٌ في أيِّ وقت

182
00:12:53,240 --> 00:12:55,580
.تبقّى أن ألعب في مُباراةٍ فقط

183
00:12:56,050 --> 00:12:57,580
،أُريدُ اللّعبَ في مُباراة

184
00:12:58,460 --> 00:13:02,170
.حالما ألعب، فلن أخسرَ أمام الأساسيّين

185
00:13:04,050 --> 00:13:07,640
!هذا ملعبكم! هذهِ مُباراتُكم

186
00:13:07,640 --> 00:13:10,600
!لذا اذهبوا وأظهروا لهم كرة القاعدة خاصّتكم

187
00:13:11,130 --> 00:13:12,310
!أجل

188
00:13:13,340 --> 00:13:14,490
!نحنُ لن نخسر

189
00:13:24,460 --> 00:13:26,280
،في المُباراةِ الأولى لهذا اليوم

190
00:13:26,280 --> 00:13:29,200
.كواكامي كان الرامي البادئ ضد (كوساكابي كيوهي)

191
00:13:30,740 --> 00:13:32,230
!أحسنت الرميّ يا نوري

192
00:13:32,230 --> 00:13:33,690
!خروجانِ يا نوري

193
00:13:32,630 --> 00:13:33,690
!خروجان

194
00:13:33,690 --> 00:13:36,130
.قام برميّ 132 رمية في تسعةِ أشواط

195
00:13:37,260 --> 00:13:40,910
.لا شكّ بأنّهُ مُرهق، ولكنّهُ يُحافظ على تركيزه بشكلٍ مُمتاز

196
00:13:42,000 --> 00:13:47,450
.تطوّرُ كلٍّ من فوريا و سوامورا جعلا فرصتهُ في اللّعبِ قليلة

197
00:13:48,620 --> 00:13:53,770
.ولكن حالما يعتلي التلّة، فهو يرمي بنفس شغفهِ المُعتاد

198
00:13:54,520 --> 00:13:57,560
،هو على الأرجحِ لن يكون سعيداً بسماعِ ذلك منّي

199
00:13:59,730 --> 00:14:01,770
.ولكنّ إرادتهُ أصبحت قويّة حقاً

200
00:14:04,750 --> 00:14:06,950
!سترايك! الضاربُ للخارج

201
00:14:07,350 --> 00:14:08,650
!أحسنتَ يا نوري

202
00:14:07,920 --> 00:14:09,340
!كاواكامي

203
00:14:08,650 --> 00:14:10,200
رميٌّ رائع، صحيح؟

204
00:14:11,170 --> 00:14:15,760
!أنا على يقينٍ أن جميعنا يتّفقُ على أنّك نجمُ جيلنا يا نوري

205
00:14:18,640 --> 00:14:20,710
،وفي المُباراةِ الثانية من نفسِ اليوم

206
00:14:21,160 --> 00:14:26,720
.سوامورا قد بدأ ورمى لثلاثة أشواط، مانحاً ضربةً واحدة، مشيةً واحدة، ولم يخسر أيّ نقطة

207
00:14:27,950 --> 00:14:31,090
.بـ هوم-رن المنظّف، انفجرت تشكيلةُ الضاربين

208
00:14:32,690 --> 00:14:38,230
.في مُباراتيّ ذلك اليوم، (سيدو) حقّقت 24 ضربة وسجّلت 21 نقطة

209
00:14:39,100 --> 00:14:45,630
.وقبل مُغادرة القائد ميوكي لتمثيل طوكيو، (سيدو) وصلت لفوزها الـ 17 على التوالي

210
00:14:51,240 --> 00:14:53,790
.هذه تشكيلةُ مُمثليّ طوكيو إذن

211
00:14:54,590 --> 00:14:58,430
.(ياكوشي) أرسلت القائد هيراتا بدلاً من ساندا

212
00:14:58,430 --> 00:15:01,750
.ومن (إيتشيداي)، أرسلوا المنظُف هوشيدا

213
00:15:01,750 --> 00:15:06,770
.كما هو مُتوقّع، العديد من اللّاعبين قد رفضوا الدعوة نظراً لاقتراب بطولة الصيف

214
00:15:06,770 --> 00:15:10,010
.وقائدُ هذهِ التشكيلة سيكون إنوي من (تيتو)

215
00:15:10,560 --> 00:15:11,570
أخابَ أمَلُك؟

216
00:15:11,570 --> 00:15:14,010
.كلّا، كلّا، هذا مُريح

217
00:15:14,730 --> 00:15:18,120
.كلُّ مدرسةٍ تُرسلُ لاعباً على الأقل، وفي الغالبِ يكون في السنة الثالثة

218
00:15:18,120 --> 00:15:21,300
.والفريقُ المُمثّل لـ (طوكيو) متكوّنٌ من 18 لاعباً

219
00:15:21,300 --> 00:15:27,010
.ثانويّة (إيناشيرو) أرسلت المدرّب كونيتومو وأربعةً من لاعبيها

220
00:15:27,010 --> 00:15:30,380
.والتدريبات المُشتركة ستكونُ في ملعب (إيناشيرو) كذلك

221
00:15:31,120 --> 00:15:37,200
.الفريقُ المُمثّل لأمريكا يضمُّ 18 لاعباً من أكاديميّة (ويند) للشّباب على الساحل الغربيّ

222
00:15:37,200 --> 00:15:43,050
.إنّهم فريقٌ من طلاب المدارس الثانويّة في لوس أنجلوس فقط، وليس من كامل أمريكا

223
00:15:43,050 --> 00:15:46,670
‏‏‏‏‏‏‏‏‏‏‏‏‏‏‏‫ويُقالُ أن لاعباً سابقاً من MLB قد تطوّع لتدريبهم.

224
00:15:43,050 --> 00:15:46,670
‏‏‏‏‏‏‏‏‏‏‏‏‏‏‏‫MLB: دوري كُرة القاعدة الرئيسي، واحدٌ من دوريات كُرة القاعدة الإحترافية، ويُعدُّ من أقدم أربع دوريات رياضية في أمريكا و كندا

225
00:15:48,200 --> 00:15:52,420
.أنتَ لن تلعبَ في ملعب (إيناشيرو) وحسب، بل ستلتقطُ لناروميا أيضاً

226
00:15:52,420 --> 00:15:55,560
.هذهِ فرصةٌ لا تعوّضُ للاستطلاع

227
00:15:55,560 --> 00:15:59,690
.مع أنّي أشكُّ بأنّهُ سيُظهرُ لي كلّ ما لديه

228
00:15:59,690 --> 00:16:01,190
.أجل، معكَ حق

229
00:16:01,190 --> 00:16:05,920
يجبُ عليّ أن أحني رأسي شُكراً لكومينوتو-سان

230
00:16:05,920 --> 00:16:10,420
.على قبولهِ الدعوة وذلك لتعزيز النوايا الحسنة بين البلدين بغية تطوير كرة القاعدة في (طوكيو)

231
00:16:11,080 --> 00:16:17,250
.كما أنّها ستكونُ تجربةً عظيمةً أن تلعبَ في فريقٍ جميعُ لاعبيهِ في نفسِ سنّك

232
00:16:17,250 --> 00:16:21,580
.لذا اذهب وأرِهم ما لديك كلاعبٍ في كرة القاعدة

233
00:16:22,950 --> 00:16:23,570
.حاضر

234
00:16:24,610 --> 00:16:27,950
،أكرهُ أن أترك الفريق في وقتٍ مهمٍّ كهذا

235
00:16:27,950 --> 00:16:31,090
.لكنّي سأعودُ بما يُفيدُ الفريق مستقبلاً

236
00:16:31,090 --> 00:16:34,210
.لقد مضت فترةٌ على أخذِكَ استراحةً من كونك القائد، صحيح؟

237
00:16:34,210 --> 00:16:35,340
.هذا صحيح

238
00:16:35,340 --> 00:16:37,350
.تأكّد من أن لا تصابَ فقط

239
00:16:38,780 --> 00:16:42,570
...والآن، بالنسبةِ للاعبيّ السنةِ الأولى الذين سينضمّون للتشكيلةِ الأولى

240
00:16:46,800 --> 00:16:48,480
.لقد عدت

241
00:16:48,760 --> 00:16:51,280
كيف كان فوريا؟

242
00:16:51,280 --> 00:16:52,240
.إنّهُ بخير

243
00:16:52,780 --> 00:16:55,770
.لقد مضى يومانِ على رميه، ولم يشعر بأيّ ألمٍ على الإطلاق

244
00:16:55,770 --> 00:17:00,120
.سيستمرُّ في جلسات التدليك، لكن الدكتور هيغوتشي يقول أن حالتهُ تتحسّن بسرعة

245
00:17:01,300 --> 00:17:02,370
.مرحباً بعودتك

246
00:17:02,720 --> 00:17:03,600
كيف سارَ الأمر؟

247
00:17:04,800 --> 00:17:06,120
.على ما يرام

248
00:17:06,760 --> 00:17:09,420
،مع أنّهُ ما زال يحدُّ من رمياتي

249
00:17:09,950 --> 00:17:13,130
.ولكنّهُ سمحَ لي بالانضمام لتدريبات الرميّ

250
00:17:14,370 --> 00:17:15,730
.هكذا إذن

251
00:17:15,730 --> 00:17:19,020
.يُقالُ بأنّهُ من السّهل تفاقم الإصابة بعد شفائك منها مباشرةً

252
00:17:19,020 --> 00:17:20,390
.لذا فلا تضغط على نفسك

253
00:17:20,690 --> 00:17:21,370
.حاضر

254
00:17:22,140 --> 00:17:27,650
.أنا أنوي الاستمرار في تدريبات جزئي السفليّ والتي أعدّها لي المدرّب أوتشياي

255
00:17:29,320 --> 00:17:30,150
.فوريا-سان

256
00:17:30,700 --> 00:17:34,670
عندما ترمي في البولبين المرّةِ القادمة، هلّا سمحتَ لي بالتقاطِ رمياتك؟

257
00:17:35,720 --> 00:17:38,170
.أعدك بأنّي سأبتعدُ فورَ أن تُخبرني بذلك

258
00:17:38,170 --> 00:17:42,410
.ولكنّي أُريدُ الاعتياد على رمياتِك ولو قليلاً

259
00:17:43,660 --> 00:17:46,640
.أجل، كنتُ بصدد طلب ذلك منك بأيّة حال

260
00:17:47,260 --> 00:17:49,170
.سنفعلُ ذلك في مباراةٍ بعد كلِّ شيء

261
00:17:51,260 --> 00:17:53,370
!أجل! شكراً لك

262
00:17:53,370 --> 00:17:55,420
.ولكنّي لن أرمي في الغد

263
00:17:55,740 --> 00:17:57,930
.فوريا، دعني ألتقطها أيضاً

264
00:17:58,620 --> 00:18:03,750
.صحيحٌ أن عليّ العمل على قيادتي، ولكنّي أريدُ اللّحاق بركبِ قوّتكم أنتم الرُّماة

265
00:18:04,370 --> 00:18:07,690
.كمُلتقطين، فهذهِ أعظمُ أُمنياتِنا

266
00:18:12,780 --> 00:18:18,190
.وطبعاً لا أُريدُ أن تُكسَرَ سِلسلةُ انتصاراتنا المتتالية مع غياب ميوكي

267
00:18:24,060 --> 00:18:27,530
،لأن السينباي دائماً ما يُلوّحون بمضاربهم في مكانٍ ما

268
00:18:27,530 --> 00:18:31,210
.فإيجادُ بقعةٍ لكَ للتدريب سيكونُ أمراً عسيراً

269
00:18:33,320 --> 00:18:35,780
كيف كانت رمياتُ فوريا-سان؟

270
00:18:35,780 --> 00:18:37,440
أكانت مثل ما توقّعتها؟

271
00:18:37,440 --> 00:18:38,880
أم أفضل؟

272
00:18:43,250 --> 00:18:44,780
.لقد كنتُ مرعوباً

273
00:18:46,450 --> 00:18:48,660
،ليس بسبب قوّة وسرعة رمياتِه

274
00:18:48,660 --> 00:18:52,190
!وإنّما من مشاعرِهِ التي رماها عليّ

275
00:18:53,000 --> 00:18:54,610
.رماها دون أيِّ تردّد

276
00:18:55,560 --> 00:18:56,430
.نحوي مُباشرةً

277
00:18:57,630 --> 00:18:58,960
!كوشو

278
00:18:59,950 --> 00:19:06,240
.لأكونَ صريحاً، في تلك الثلاث جولات، لم يكن أمامي خيارٌ سوى الصمود أمام رمياتِه

279
00:19:09,150 --> 00:19:12,630
.سيكونُ الأمرُ مختلفاً تماماً عن الإحماء أيّها الفتى أكومورا

280
00:19:16,230 --> 00:19:21,130
.بالنسبةِ لهما، فهذا مستواهما الطبيعيّ

281
00:19:22,480 --> 00:19:25,890
...ومن يقفُ أمامهم دائماً

282
00:19:32,460 --> 00:19:36,470
.الأمرُ محبط، ولكنّي لم أصِل لهم بعد

283
00:19:37,890 --> 00:19:40,030
.لم أصِل للمستوى الذي هم فيهِ بعد

284
00:19:43,870 --> 00:19:44,700
.سُحقاً

285
00:19:46,450 --> 00:19:49,070
.كوني في النسةِ الأولى وحدهُ يضايقني

286
00:19:52,770 --> 00:19:54,010
.لا أُريدُ الخسارة

287
00:20:05,700 --> 00:20:12,510
.فوريا قد عاد من جديد للتشكيلة الأولى، و أكومورا و سيتو تم ضمّهما رسمياً للتشكيلةِ الأولى أيضاً

288
00:20:18,840 --> 00:20:22,940
...والآن، بالنّسبةِ للاعبيّ السنةِ الأولى الذين سينضمّون للتشكيلةِ الأولى

289
00:20:22,940 --> 00:20:28,900
.في حالة أكومورا، فليس لديّ شكٌّ في قدراتِه، ولكنّهُ يفتقرُ للنضج

290
00:20:29,940 --> 00:20:32,370
لذا أخبرني ما رأيك فيهِ كونك شريكهُ في الغرفة؟

291
00:20:32,940 --> 00:20:38,300
.حسنٌ، هو ليسَ مستقرّاً دائماً، ويُحاولُ أن يضبط أخلاقهُ ومبادئه

292
00:20:39,110 --> 00:20:43,550
،عندما كنتُ في السنةِ الأولى، كنتُ وقحاً مع السينباي وكانوا يكرهونني

293
00:20:44,270 --> 00:20:47,640
.ولكن انضمامي للتشكلةِ الأولى علّمني الكثير

294
00:20:48,190 --> 00:20:54,130
.لذا أظنُّ أن الزجّ بهِ في بيئةٍ عالية المستوى في الفريق الأوّل ستجعلهُ يُدركُ الكثير عن نفسه

295
00:20:55,320 --> 00:20:57,770
.كنتَ على علمٍ بوقاحتكَ وقتها إذن

296
00:20:58,220 --> 00:21:00,320
أنت من طينة الأشخاص الذين يغتابون الآخرين، صحيح؟

297
00:21:01,340 --> 00:21:03,930
!أجل! أجل! كان سليطَ اللّسان

298
00:21:03,930 --> 00:21:06,820
!السينباي دائماً ما كانوا مُغتاظين وهم حوله

299
00:21:14,330 --> 00:21:16,540
.أصبحتَ أخيراً في التشكيلةِ الأولى

300
00:21:17,250 --> 00:21:22,170
.أجل، وما زلتُ بديلاً حتّى عودة ميوكي-سينباي

301
00:21:27,020 --> 00:21:28,830
.أعتذرُ لإبقائكَ مُنتظراً

302
00:21:29,580 --> 00:21:32,180
.من الآن فصاعداً، اطلبني متى ما أردتَ ذلك

303
00:21:36,620 --> 00:21:39,400
.حتّى ولو كانَ ذلك الآن إذا أردت

304
00:21:42,710 --> 00:21:45,680
!يا للأسف! فأنا لن أرمي اليوم

305
00:21:45,680 --> 00:21:46,640
.غداً إذن

306
00:21:46,640 --> 00:21:49,020
!غداً ميوكي-سينباي هو من سيلتقط لي

307
00:21:49,020 --> 00:21:49,690
.غداً

308
00:21:49,690 --> 00:21:50,780
!سأرى

309
00:21:50,780 --> 00:21:51,970
.فنلفعلها غداً

310
00:21:51,970 --> 00:21:53,640
!الأمرُ لا يعودُ لي

311
00:21:53,640 --> 00:21:54,290
.هو الغدُ إذن

312
00:21:54,290 --> 00:21:56,540
!سأسألُ ميوكي-سينباي

313
00:21:54,850 --> 00:21:56,540
!شكراً لكم

314
00:21:56,540 --> 00:21:57,840
.سيكون في الغد

315
00:21:57,840 --> 00:21:59,560
ألهذه الدرجةِ أنت متلهّف؟

316
00:22:12,370 --> 00:22:13,420
"انتقال الحرارة"