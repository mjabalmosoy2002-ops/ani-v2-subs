1
00:00:04,500 --> 00:00:05,900
!كان ذلك وشيكاً

2
00:00:06,320 --> 00:00:08,120
.ذلك الملتقط ليسَ سيئاً

3
00:00:09,400 --> 00:00:11,700
.أنا سأهتمُّ بالراكض

4
00:00:11,700 --> 00:00:13,780
.وأنت عليكَ التركيزُ على الضارب

5
00:00:14,280 --> 00:00:14,930
.حاضر

6
00:00:16,600 --> 00:00:18,030
!أعتمدُ عليكَ إذن

7
00:00:22,090 --> 00:00:25,790
.لطالما أردتُّ منحَ أونو فرصةً كهذه

8
00:00:26,860 --> 00:00:32,470
.السببُ في إرسالي لميوكي لتمثيل طوكيو بضميرٍ مرتاح هو لأنّنا نملكُ أونو

9
00:00:37,970 --> 00:00:39,060
.أونو-سينباي

10
00:00:40,420 --> 00:00:44,590
السجلّ المعلّق على مكتبك، يعودُ لأيِّ مُباراة؟

11
00:00:46,850 --> 00:00:49,630
،إنّهُ يعودُ لبطولة جينغو في الخريف الماضي

12
00:00:51,260 --> 00:00:54,700
.للمباراةِ التي خسرناها لأنّي لم أستطِع التقاط رمية فوريا

13
00:00:59,800 --> 00:01:02,200
.كان هنالك خروجان، وراكِضَين على الأولى والثالثة

14
00:01:17,580 --> 00:01:19,320
.تركتُ الكُرةَ تتجاوزني

15
00:01:22,150 --> 00:01:24,950
.وسجّلوا بذلك نقطة الفوز

16
00:01:27,680 --> 00:01:30,320
.لا أريدُ نسيان الإحباطِ الذي شعرتُ بهِ وقتها

17
00:01:31,290 --> 00:01:34,440
.وضعتُها هُنا لأتذكّرها كلّ يوم

18
00:01:37,810 --> 00:01:39,820
.ولكنّي لم أُخبر فوريا بذلك

19
00:01:41,150 --> 00:01:44,950
...أنا لا أستطيعُ أخذَ مكان ميوكي

20
00:01:50,590 --> 00:01:56,170
!ولكنّي قرّرتُ أن أُصبحَ مُلتقطاً أفضل مِمّا كنتُ عليهِ في ذلك اليوم

21
00:01:57,220 --> 00:01:59,720
سيدو

22
00:01:57,220 --> 00:01:59,720
ياماموري

23
00:02:00,630 --> 00:02:03,600
!خروجان

24
00:02:08,460 --> 00:02:09,350
!سرقة

25
00:02:09,650 --> 00:02:11,110
!هاتوا ما لديكم

26
00:02:11,530 --> 00:02:13,000
!أعتمدُ عليك

27
00:02:15,070 --> 00:02:16,360
!ضربةٌ وركضة؟

28
00:02:20,040 --> 00:02:20,960
!فاول

29
00:02:40,440 --> 00:02:43,820
:لا تنسوا زيارتنا في

30
00:02:40,440 --> 00:02:43,820
منتديات العاشق

31
00:04:15,220 --> 00:04:16,900
!متغيّرةٌ دائريّة

32
00:04:19,020 --> 00:04:21,130
.انكسرت بشكلٍ جنونيّ

33
00:04:22,020 --> 00:04:24,820
!كارلايل لم يستطِع لمسها حتّى

34
00:04:25,900 --> 00:04:27,580
.مي ناروميا

35
00:04:27,580 --> 00:04:32,830
.إنّهُ نجم ثانويّة (إيناشيرو)، إحدى أفضل الفِرق في اليابان

36
00:04:34,650 --> 00:04:38,990
.لقد احتلّوا المركز الثاني في بطولة الصيف العام الماضي في ملعب الكوشين

37
00:04:41,690 --> 00:04:47,300
.نِتَاج ملعب الكوشين، الملعب المقدّس لكرة قاعدة اليابان

38
00:04:54,230 --> 00:04:55,760
.مي ناروميا

39
00:04:56,730 --> 00:04:58,860
!أجل! لقد أخرجه

40
00:05:16,460 --> 00:05:19,460
!يا لعين! ماذا تظنُّ نفسك فاعلاً؟

41
00:05:19,750 --> 00:05:20,930
مضربي؟

42
00:05:21,550 --> 00:05:22,960
هل أنت بخير؟

43
00:05:35,960 --> 00:05:37,740
.لا توجد مشكلة

44
00:05:48,920 --> 00:05:50,070
هل أنت بخير؟

45
00:05:50,730 --> 00:05:53,610
.أخذتُ وهلةً لأُدركَ ما حدث

46
00:05:53,610 --> 00:05:57,150
.ولكن الضارب كان يقفُ بلا حراك

47
00:05:58,240 --> 00:06:00,360
.وأخرجتُهُ من دون وعي

48
00:06:01,510 --> 00:06:03,290
!بغريزتك فقط؟

49
00:06:05,490 --> 00:06:07,690
!لقد تغاضى عن الأمرِ وكأن شيئاً لم يكن

50
00:06:07,690 --> 00:06:09,640
!أنت رائعٌ جداً يا إينوي

51
00:06:09,640 --> 00:06:11,640
!إينوي كينغو

52
00:06:12,860 --> 00:06:15,430
!أصابهُ المضرب من تلك المسافة؟

53
00:06:15,430 --> 00:06:17,310
.عليّ توخّي الحذر

54
00:06:22,590 --> 00:06:26,030
.الكرةُ ضربت يده اليُمنى بعد أن ارتدّت من المضرب

55
00:06:26,030 --> 00:06:28,500
.والأسوأ من ذلك أنّها رميةُ فوريا السّريعة

56
00:06:28,500 --> 00:06:30,030
.لا شكّ أنّها مؤلمة

57
00:06:30,360 --> 00:06:31,790
هل سيكون بخير؟

58
00:06:36,340 --> 00:06:37,040
!يوي

59
00:06:37,040 --> 00:06:38,120
!حاضر

60
00:06:39,010 --> 00:06:39,960
.جهّز نفسك

61
00:06:44,170 --> 00:06:47,260
.أنا آسفٌ يا فوريا، ولكن يبدو أنّي سأُغادر

62
00:06:50,640 --> 00:06:53,180
.أتركُ البقيّةَ لكَ يا يوي

63
00:06:53,610 --> 00:06:54,260
!حاضر

64
00:06:55,240 --> 00:06:56,530
.لا تقلق

65
00:06:56,530 --> 00:06:57,610
.يُمكنُكَ فِعلُها

66
00:07:01,230 --> 00:07:03,860
.فقط افعل ما بوسعك لمجاراة فوريا

67
00:07:13,200 --> 00:07:17,590
.لو أنّ الراكض لم يتحرّك، لما ارتدّت الكرةُ هكذا على يدِ أونو

68
00:07:17,590 --> 00:07:19,170
.يا لهُ من حظٍّ سيء

69
00:07:20,250 --> 00:07:23,760
.خروجُ أونو الآن سيؤثّرُ علينا كثيراً

70
00:07:24,670 --> 00:07:27,760
.قبل عامين كان كريس، والعام الماضي كان تانبا

71
00:07:28,170 --> 00:07:30,760
.يبدو وكأن الوقت قبل بطولة الصيف ملعونٌ بالنسبةِ لـ (سيدو)

72
00:07:40,140 --> 00:07:41,820
.أنا آسفٌ يا ساوامورا

73
00:07:42,790 --> 00:07:45,660
.قد لا أتمكنُ من الالقتاطِ لك

74
00:07:45,660 --> 00:07:47,150
!ما الذي تقوله؟

75
00:07:47,540 --> 00:07:50,020
!ليسَ عليكَ القلقُ بشأنِ ذلك

76
00:07:50,020 --> 00:07:54,420
.نحنُ لا نعلمُ مدى خطورة إصابتك، لذا أسرع من فضلك بزيارة الطبيب

77
00:07:58,890 --> 00:08:00,200
،ساوامورا

78
00:08:00,950 --> 00:08:01,830
.أنا آسف

79
00:08:07,540 --> 00:08:08,750
...لمَ

80
00:08:10,040 --> 00:08:12,650
لمَ تعتذرُ يا أونو-سينباي؟

81
00:08:19,500 --> 00:08:21,840
.بدوتَ ترمي الكثير من الرّميات المنكسرة

82
00:08:21,840 --> 00:08:24,100
ما الذي اتفقتما عليهِ أنتَ و أونو-سينباي؟

83
00:08:25,540 --> 00:08:29,440
،الضاربون يُلوّحون لرمياتي السّريعة فقط، لذا فضّلنا رميّ الكُرات المنكسرة أكثر

84
00:08:30,130 --> 00:08:31,610
.نحو منطقة السترايك مباشرةً

85
00:08:32,110 --> 00:08:34,750
.أعتقدُ أن الأمرَ سارَ بشكلٍ جيّد

86
00:08:34,750 --> 00:08:36,920
.تركتُ الكرةَ تذهبُ بالاتّجاهِ الذي أريده

87
00:08:36,920 --> 00:08:38,040
.فهمت

88
00:08:38,670 --> 00:08:40,870
.سأقودُكَ بنفسِ نهجِه

89
00:08:41,340 --> 00:08:43,370
.أجل، من فضلك

90
00:08:44,010 --> 00:08:47,230
!لا تفكّرا حتّي بالقيامِ بذلك وحدكما

91
00:08:47,970 --> 00:08:50,090
من تظنّانِ بأنّهُ يُدافعُ خلفكما؟

92
00:08:50,370 --> 00:08:52,630
.هذا هو الوقت الذي تعتمدون علينا فيه

93
00:08:52,950 --> 00:08:54,480
.حصلنا على خروجان بالفعل

94
00:08:54,480 --> 00:08:55,760
.فلنبدأ أولاً بإخراج الأخير

95
00:08:56,320 --> 00:08:59,260
!كما أنّهم لن يضربوا رميات فوريا بتلك السهولة

96
00:09:01,810 --> 00:09:02,540
.أجل

97
00:09:02,540 --> 00:09:03,710
!نعتمدُ عليكم

98
00:09:06,270 --> 00:09:09,270
!إنّهُ حادثٌ مؤسف، ولكن عليكم تخطّي الأمر

99
00:09:10,730 --> 00:09:12,900
!المُباراةُ بدأت للتوّ

100
00:09:13,520 --> 00:09:15,150
!لا تنسوا عدوانيّتكم

101
00:09:15,850 --> 00:09:17,620
!نحنُ نستمتعُ من أجل الفوز

102
00:09:17,620 --> 00:09:19,760
!تلك ماهيّة كرة القاعدة خاصّتنا

103
00:09:19,760 --> 00:09:20,750
!حاضر

104
00:09:24,930 --> 00:09:27,420
.سنبدأ برميةٍ منكسرة بما أنّك أخرجتهم بها

105
00:09:31,000 --> 00:09:35,800
.أنا آسفٌ لخروجي هكذا من المُباراة

106
00:09:36,740 --> 00:09:41,710
.برحيلِ ميوكي، أنا من يجبُ عليهِ قيادة تشكيلة المُلتقطين

107
00:09:43,250 --> 00:09:47,670
.حتّى أن ميوكي أخبرني بأنّ أهتمّ بمُلتقطيّ السنةِ الأولى

108
00:09:49,020 --> 00:09:50,190
...أونو-كن

109
00:09:50,920 --> 00:09:53,490
.حتّى في هذا الوقت، يُفكّرُ بالفريق

110
00:09:55,010 --> 00:09:56,460
.ادخل

111
00:09:56,460 --> 00:09:57,560
.علينا الإسراع

112
00:10:02,140 --> 00:10:03,330
!فاول

113
00:10:04,080 --> 00:10:05,600
.إنّهما محقّان

114
00:10:05,600 --> 00:10:08,580
.إنّهُ يُجاري رميات فوريا-سان السّريعة حقاً

115
00:10:09,100 --> 00:10:12,100
.هذا هو مستوى فريقٍ يلعبُ في الكوشين

116
00:10:13,420 --> 00:10:15,800
.ولكنّنا قمنا بمحاصرتِه

117
00:10:16,350 --> 00:10:17,750
.سنُنهي أمرهُ بهذه

118
00:10:36,010 --> 00:10:37,030
.اللّعنة

119
00:10:38,510 --> 00:10:39,670
.أنا مُثيرٌ للشّفقة

120
00:10:41,010 --> 00:10:44,060
لمَ يحدثُ ذلك الآن؟

121
00:10:45,620 --> 00:10:46,960
.لا بأس

122
00:10:48,260 --> 00:10:49,770
.لا تشغل بالك

123
00:10:51,130 --> 00:10:52,790
...نحنُ

124
00:10:53,950 --> 00:10:55,420
!سنتكفّلُ بهم

125
00:10:57,350 --> 00:10:58,340
.لا تقلق

126
00:10:59,160 --> 00:11:00,340
.يُمكنُك فعلُها

127
00:11:01,340 --> 00:11:04,220
.فقط افعل ما بوسعك لمجاراة فوريا

128
00:11:18,440 --> 00:11:20,890
.يبدو أنّهُ فقد وعيه لجزءٍ من الثانية

129
00:11:20,890 --> 00:11:22,570
.لذا أنصحُ بعدم الضغط عليهِ الآن

130
00:11:25,110 --> 00:11:26,430
.أنا بخير

131
00:11:26,430 --> 00:11:28,040
.يُمكنُني اللّعب

132
00:11:28,930 --> 00:11:34,250
...كنتُ أعلم بعدوانيّتهم في الضرب، لذا كنتُ أحافظُ على مسافةٍ بيني وبين ضارِبيهم

133
00:11:35,260 --> 00:11:41,930
.لكن وأثناء محاولتي لالتقاطِ رميات ناروميا المنكسرة تحديداً، انتهى بي الأمر بالتقدّم للأمام دون أن ألاحظ ذلك

134
00:11:43,170 --> 00:11:46,510
!ما زال لديكَ الكثيرُ لتتعلّمهُ يا إينوي كينغو

135
00:11:50,310 --> 00:11:52,610
!سترايك! الضاربُ للخارج

136
00:11:52,610 --> 00:11:54,810
!ماذا؟ خروجانِ بهذه السرعة؟

137
00:11:55,140 --> 00:11:57,570
هل يُمكنهم ضربُ رمياتِه؟

138
00:12:00,480 --> 00:12:03,360
.ياماوكا، ستكونُ على القاعدةِ الأولى في هذا الشوط

139
00:12:05,180 --> 00:12:09,480
.لن أُبالغ في الضغطِ على اللّاعبين في هذا الوقتِ المهمّ قبل بطولة الصيف

140
00:12:09,480 --> 00:12:11,880
.إينوي بحاجةٍ للرّاحة

141
00:12:12,800 --> 00:12:14,630
.سيتمُّ استبدال إينوي إذن

142
00:12:14,630 --> 00:12:16,500
من سيكونُ الملتقط؟

143
00:12:16,850 --> 00:12:20,580
.لم يتم الجمع بين أي ثنائي من نفس المقاطعة في هذا الفريق

144
00:12:21,920 --> 00:12:22,800
.ميوكي

145
00:12:24,730 --> 00:12:25,890
أيُمكنُكَ فِعلُها؟

146
00:12:32,500 --> 00:12:34,000
!الخروجُ الثالث! تبديل

147
00:12:34,920 --> 00:12:36,400
.اللّعنة

148
00:12:42,690 --> 00:12:45,070
.سأستبدلُ إينوي

149
00:12:45,680 --> 00:12:48,780
.ميوكي من سيرتدي القناع

150
00:12:49,160 --> 00:12:50,720
.لا خيارَ آخر أمامنا

151
00:12:50,720 --> 00:12:52,750
.فهذا الفريقُ لا يملكُ مُلتقطين آخرين

152
00:12:53,540 --> 00:12:54,610
بجدّية؟

153
00:12:55,620 --> 00:13:03,300
.السّماحُ لميوكي بأن يلتقطَ لناروميا يعني إطلاعهُ على كافّة تفاصيل رمياتِه

154
00:13:03,300 --> 00:13:09,190
.ملتقطٌ قويٌّ الملاحظة ومن فريقٍ منافس هو آخرُ شخصٍ ترغبُ في منحهِ مثل تلك التفاصيل

155
00:13:10,070 --> 00:13:14,270
.حسنٌ، أتينا بخطّةٍ لمثلِ هذه الظروف

156
00:13:14,860 --> 00:13:20,160
.لن نسمحَ لدقّةِ ملاحظتهِ بأن ترى الكثير

157
00:13:20,160 --> 00:13:21,380
.كازويا

158
00:13:22,730 --> 00:13:25,400
.لن نقومَ بإخفاءِ أيِّ شيءٍ عن بعضنا

159
00:13:29,480 --> 00:13:34,120
.إنّهم ليسوا فريقاً يُمكنُنا الإطاحةَ بهِ إن أخفينا أموراً عن بعضنا

160
00:13:34,620 --> 00:13:37,120
.فكما ترى، لديهم عدّة لاعبين خطيرين

161
00:13:39,660 --> 00:13:42,220
.إذن لا تعترض على إشاراتي

162
00:13:42,220 --> 00:13:44,960
.سأفعل طالما تطلبُ إشاراتٍ لا يتوجّبُ عليّ رفضُها

163
00:13:44,960 --> 00:13:46,510
.طبعاً

164
00:13:47,010 --> 00:13:51,940
حسنٌ، حسنٌ ... أتظنُّ أن بإمكانك التحكّمَ بملِكنا؟

165
00:13:51,940 --> 00:13:53,920
.لو ضربوا رمياتِه، فهي غلطتك

166
00:13:53,920 --> 00:13:55,900
.لو خسرنا، فهي غلطتك

167
00:13:55,900 --> 00:13:57,180
.ستكون السبب في كلِّ شيء

168
00:13:58,760 --> 00:14:00,780
.نحنُ سنسجّلُ النقاط

169
00:14:00,780 --> 00:14:02,900
.وأنت ركّز على قيادته بشكلٍ صحيح

170
00:14:07,110 --> 00:14:08,110
.كازويا

171
00:14:09,610 --> 00:14:11,800
،إن كنتَ ترى نفسكَ مُلتقطاً

172
00:14:11,800 --> 00:14:13,910
.فدعني أُخرِج أفضل ما لديّ كرامٍ

173
00:14:15,270 --> 00:14:16,350
...أيّها

174
00:14:21,110 --> 00:14:24,480
لأيّ درجةٍ تظنّون أّنكم أفضلُ منّي يا رفاق؟

175
00:14:26,270 --> 00:14:27,380
!ناروميا

176
00:14:28,860 --> 00:14:29,830
.أنا آسف

177
00:14:34,620 --> 00:14:35,930
...مهلاً، مهلاً

178
00:14:36,740 --> 00:14:38,940
!يا لها من تشكيلةِ نجومٍ هذه

179
00:14:39,580 --> 00:14:42,440
...هل أنت من قام بجمعهم

180
00:14:42,910 --> 00:14:43,560
يا مي؟

181
00:14:44,690 --> 00:14:45,640
.صحيح

182
00:14:45,640 --> 00:14:46,940
.والمتبقّي هو أنت يا كازويا

183
00:14:47,640 --> 00:14:50,950
.إن انضممتَ لنا، فيُمكنُني تشكيلُ فريقِ أحلامي الذي أردتُّه

184
00:14:51,730 --> 00:14:54,550
.أنا آسف، ولكن لا يُمكنُني الانضمامُ لكم يا رفاق

185
00:14:56,200 --> 00:14:59,340
فريقك سيمتلك كل هؤلاء اللّاعبين المذهلين، صحيح؟

186
00:14:59,340 --> 00:15:02,520
.إذن ... هذا يجعلني أتحرّقُ شوقاً لمواجهتكم

187
00:15:04,300 --> 00:15:05,730
.أنت رائعٌ حقاً

188
00:15:05,730 --> 00:15:08,600
.ولكنّك ستندمُ على اختياركَ هذا

189
00:15:09,730 --> 00:15:12,290
!حسنٌ، المواجهةُ الحقيقيّة تبدأُ من هنا

190
00:15:12,290 --> 00:15:14,890
!حافظوا على قوّتكم ودافعوا جيّداً

191
00:15:15,390 --> 00:15:16,260
!هيّا

192
00:15:16,260 --> 00:15:17,510
!أجل

193
00:15:17,900 --> 00:15:20,140
أمريكا
اليابان

194
00:15:23,840 --> 00:15:24,780
!سترايك

195
00:15:29,570 --> 00:15:31,110
أتسائلُ ما هو هذا الشعور؟

196
00:15:31,410 --> 00:15:33,240
.الدمج المحظور لهذين اللاعبَين معاً

197
00:15:33,830 --> 00:15:37,450
.مع أن الأمر محضُ صدفة، ولكن كان قراراً صارماً بالنسبةِ للمدرّب كونيتومو

198
00:15:40,000 --> 00:15:43,710
،هذين الاثنين قد يواجهانِ بعضهما في بطولة الصيف

199
00:15:43,710 --> 00:15:47,210
!ولكنّ نجمَهُ يشكّلُ ثنائياً مع القائد والمنظّف لغريمه

200
00:15:49,770 --> 00:15:52,630
.عدوانيٌّ كعادتِك

201
00:15:53,190 --> 00:15:58,050
،لعلّهُ لم يعتد على رمياتك بعد، أو أن رمياتك فاقت توقّعاته

202
00:16:04,270 --> 00:16:06,860
.هذا كازويا الذي أعرفه

203
00:16:07,570 --> 00:16:12,200
.دائما ما يطلبُ رمياتٍ تستفزُّ الضارب

204
00:16:12,520 --> 00:16:15,450
وأنت تحبُّ أن تُخضِعَهم، صحيح؟

205
00:16:16,420 --> 00:16:21,580
.يا إلهي، وأنا الذي أقولُ لهُ بأن خصمنا هذا ليسَ سهلاً

206
00:16:21,580 --> 00:16:23,750
،ولكن بطلبكَ لرمياتٍ كهذه

207
00:16:25,950 --> 00:16:27,500
!فلا يسعُني إلّا قبولُ التحدّي

208
00:16:33,400 --> 00:16:35,510
!سترايك! الضاربُ للخارج

209
00:16:36,100 --> 00:16:38,430
!مذهل، يال جرأتهما

210
00:16:38,430 --> 00:16:40,310
!أخرجوهُ برمياتٍ سريعةٍ فقط

211
00:16:40,310 --> 00:16:42,670
!وضد ضاربٍ لا يُستهانُ بهِ أيضاً

212
00:16:44,140 --> 00:16:47,520
أيكفيك هذا؟

213
00:16:45,900 --> 00:16:47,050
!أحسنتَ صُنعاً

214
00:16:48,100 --> 00:16:51,780
.كان من المفترضِ أن تكونَ مباراةً ودّيةً فقط بين الفريقين

215
00:16:52,630 --> 00:16:59,540
.كان باستطاعت المدرّب إعطاء الأولويّة لبطولة الصيف وتجنّب وضع هذينِ الاثنينِ معاً

216
00:17:00,390 --> 00:17:07,830
.ولكن كمدرّب لممثّل طوكيو ... لا، بل اليابان كاملةً، قرّر إظهار عزيمتهِ في القتال حتى النهاية للاعبيه

217
00:17:15,100 --> 00:17:17,270
.هذا أشبهُ بكابوس

218
00:17:18,600 --> 00:17:20,680
.لا عجبَ في ذلك

219
00:17:21,080 --> 00:17:24,510
.التغيّر المجنون في سرعتها، وسقوطها الحادّ للغاية

220
00:17:24,510 --> 00:17:27,940
.هذهِ رميةُ مي المتغيّرة المطوّرة

221
00:17:36,100 --> 00:17:37,010
!للخارج

222
00:17:41,010 --> 00:17:43,080
.مي ناروميا

223
00:17:43,380 --> 00:17:45,380
.نجمُ الفريقِ اليابانيّ

224
00:18:02,580 --> 00:18:05,480
هل أنت متأكدٌ من رميها بهذهِ الكثرة؟

225
00:18:05,840 --> 00:18:07,730
.فات أوانُ التراجعِ الآن

226
00:18:08,060 --> 00:18:10,980
.ضاربٌ أيمن كان أم أعسر، فلا يهمّني ذلك

227
00:18:15,740 --> 00:18:17,240
أتعلم؟

228
00:18:20,130 --> 00:18:24,040
.الضاربُ الأعسر يسهلُ الإطاحةُ بهِ أكثر

229
00:18:57,860 --> 00:18:59,120
!للخارج

230
00:19:00,020 --> 00:19:01,080
!يا لهُ من أداء

231
00:19:01,080 --> 00:19:03,490
!أنهى الشوط بإخراجِ 3 ضاربين بسهولة

232
00:19:03,490 --> 00:19:06,420
!ناروميا مي في مستوى آخر

233
00:19:06,420 --> 00:19:13,030
.بدا وكأنّهُ رمى تلك الرّمية على ميوكي-كن وليسَ الضارب

234
00:19:19,800 --> 00:19:21,260
.نحنُ متأخّرونَ بنقطتين

235
00:19:21,730 --> 00:19:24,510
.حسنٌ، كلُّ ما نحتاجه هو فرصةٌ واحدة لقلبِ الموازين

236
00:19:25,230 --> 00:19:28,770
.لن نسمحَ لهم بالعودةِ لديارِهم مبتهجين هكذا

237
00:19:35,720 --> 00:19:38,900
!أجل، ضربةٌ لمنتصف الملعب

238
00:19:39,570 --> 00:19:41,330
!ضربتُنا الأولى ضد كونراد

239
00:19:41,330 --> 00:19:43,530
!أحسنت الضربَ يا كارلوس

240
00:19:43,850 --> 00:19:46,280
.تشتّتَ انتباهي، ولكنّها كانت جيّدة

241
00:19:46,590 --> 00:19:51,540
.أوصلَتني للقاعدة، وتلكَ هي المرحلةُ الأولى

242
00:19:52,350 --> 00:20:00,300
.رامٍ طويل بذراعٍ جانبيّة ورميتهُ تأتي في زاويةٍ حادّة، ولكن يسهلُ رؤيتٍها من الجانبِ الأيمن

243
00:20:00,730 --> 00:20:03,650
!يتحتّمُ على الضاربين الأيامن الفوزُ بهذهِ المُباراة

244
00:20:06,300 --> 00:20:09,100
.و الآن، المرحلةُ الثانية

245
00:20:11,380 --> 00:20:13,850
.أوه، يتأخّرُ في إنهاءِ الرّمية

246
00:20:22,530 --> 00:20:24,300
!رماها دون أن يُغيّرَ وضعيّته

247
00:20:25,200 --> 00:20:26,740
!يا لها من ذراعٍ قويّة

248
00:20:26,740 --> 00:20:28,240
!لا يُمكنُني تصديقُ ذلك

249
00:20:28,790 --> 00:20:34,750
...لديهم راكضٌ على القاعدةِ أخيراً، ومن المفترض أن يُشكّل هذا ضغطاً على الخصم، ولكن

250
00:20:35,250 --> 00:20:37,380
،بوجود الأعسر كونراد

251
00:20:37,760 --> 00:20:40,130
.والذراع القويّة لكارلايل على الصحن

252
00:20:40,820 --> 00:20:46,670
.حتّى بالنسبةِ لكارلوس-كن، فسيكونُ من الصّعبِ عليه الوصول للقاعدةِ الثانية

253
00:20:52,770 --> 00:20:54,020
!لقد انطلق

254
00:21:01,050 --> 00:21:02,280
!آمن

255
00:21:05,140 --> 00:21:06,820
!مذهل

256
00:21:06,820 --> 00:21:08,280
!لقد فعلَها

257
00:21:08,280 --> 00:21:10,830
!سرعةُ كارلوس لا مثيلَ لها

258
00:21:10,830 --> 00:21:14,290
!كيف لهُ أن يتوقف فجأةً بسرعتهِ هذا؟

259
00:21:23,120 --> 00:21:24,190
!مُحال

260
00:21:24,590 --> 00:21:26,190
!ما مدى سرعتِه؟

261
00:21:28,930 --> 00:21:29,890
!فعلَها

262
00:21:30,490 --> 00:21:33,390
!ضربةٌ ثانية تمنحهم نقطة، هذا مفاجئ

263
00:21:33,390 --> 00:21:36,440
!هكذا يكونُ التعاون بين ضاربيّ (إيناشيرو)

264
00:21:37,100 --> 00:21:39,520
.شيراكاوا-كن وصلَ للثانيةِ أيضاً

265
00:21:40,220 --> 00:21:44,350
.تجنّبَ مواجهة تلك الرمية الجانبيّة وضربها ليمين الملعب عوضاً عن ذلك

266
00:21:44,350 --> 00:21:46,700
.مثالٌ رائعٌ لكيفيّة الضرب

267
00:21:46,990 --> 00:21:48,030
!أحسنتَ الركض

268
00:21:48,690 --> 00:21:50,300
.هذهِ نقطةٌ كبداية

269
00:21:50,300 --> 00:21:53,700
.والآن لا أُمانعُ إن قلبتَ الموازينَ لصالحنا

270
00:21:56,250 --> 00:21:58,710
!أجل! كارلوس

271
00:21:59,220 --> 00:22:01,160
قلبُ الموازينِ الآن؟

272
00:22:03,660 --> 00:22:06,020
!وكأنّ هذا الأمرَ سهلاً

273
00:22:13,210 --> 00:22:14,980
".عقليّةٌ لا تُقهر"

274
00:23:45,220 --> 00:23:47,070
!أجل! لعبةٌ مزدوجة

275
00:23:47,070 --> 00:23:48,740
!الفهدُ العظيم وصلَ للقاعدة

276
00:23:48,740 --> 00:23:52,000
!بركضهِ على القواعد، المُباراةُ ستُصبحُ مُمتعة

277
00:23:52,000 --> 00:23:57,450
!الواجهةُ الرئيسيّة لفريق (سيدو) لكرة القاعدة، كوراموتشي يويتشي

278
00:23:57,860 --> 00:24:00,350
!وهذا الرجلُ سيضربُ الآن

279
00:24:00,350 --> 00:24:04,330
!صاحبُ الوجه الطفوليّ، وشيطان (سيدو)، كوميناتو هارويتشي

280
00:24:04,330 --> 00:24:08,980
!سأستعيدُ النقطة بمضربي وبلَعِبي

281
00:24:08,980 --> 00:24:11,510
:في الحلقة القادمة من نجم الألماسة - الفصل الثاني

282
00:24:11,510 --> 00:24:14,930
الحلقة القادمة

283
00:24:11,800 --> 00:24:12,920
".رقيق"

284
00:24:12,920 --> 00:24:14,930
!فلنفز بالبطولة الوطنيّة