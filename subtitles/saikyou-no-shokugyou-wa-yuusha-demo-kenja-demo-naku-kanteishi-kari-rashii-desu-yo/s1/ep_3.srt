1
00:00:01,320 --> 00:00:02,650
!مرحبًا

2
00:00:02,650 --> 00:00:04,240
.أهلا بك

3
00:00:04,240 --> 00:00:06,220
.نحن نرحّب بك في شركة ديبي

4
00:00:06,220 --> 00:00:08,540
—اسمي أجاراتان ديبي

5
00:00:09,320 --> 00:00:12,570
.عفوًا... أردتُ تعيين حارس شخصيّ

6
00:00:17,530 --> 00:00:18,570
!يمكنني شمّها

7
00:00:19,220 --> 00:00:22,170
.لقد... أخذت حمّامًا بالفعل

8
00:00:22,170 --> 00:00:26,990
!يا لها من رائحة خلاّبة

9
00:02:03,510 --> 00:02:05,010
.حسنًا يا سيّد هيبيكي

10
00:02:05,010 --> 00:02:08,390
.اختر ما تحبّ

11
00:02:08,390 --> 00:02:09,600
.لا أريد

12
00:02:10,280 --> 00:02:12,380
...أشعر بالأسف عليهم

13
00:02:13,210 --> 00:02:16,390
.لا يوجد ما أشتكي حياله بخصوص قوّتهم

14
00:02:16,390 --> 00:02:18,230
.المشكلة هي نقاط السّحر

15
00:02:20,500 --> 00:02:21,830
،إن اقتضى الأمر

16
00:02:21,830 --> 00:02:25,660
أودّ أن أكون قادرًا على استعمال الشّفاء
.الفائق والعلاج المثاليّ من الكتاب الطّبّيّ

17
00:02:25,660 --> 00:02:27,400
،إن لم يعجبك أيّ واحد منهم

18
00:02:27,400 --> 00:02:29,860
.سأحاول إيجاد أشخاص يناسبونك أكثر

19
00:02:29,860 --> 00:02:31,450
لماذا لا تجد شخصًا ما بنفسك؟

20
00:02:35,110 --> 00:02:38,160
أعتقد أنّه ربّما عليّ إيجاد
.شخص ما بنفسي بالفعل

21
00:02:39,230 --> 00:02:41,130
.أعتذر على كوني صعب الإرضاء

22
00:02:41,130 --> 00:02:42,230
.على الإطلاق

23
00:02:42,230 --> 00:02:44,810
.أخبرني باستمرار بما تريده بالضّبط

24
00:02:45,140 --> 00:02:47,020
،فقبل كلّ شيء، يمكنني شمّها

25
00:02:47,020 --> 00:02:51,070
شمّ رائحة الثّروة الماليّة الشّهيّة
.الّتي تفوح من زبوننا الموقّر

26
00:02:51,940 --> 00:02:53,970
ثروة ماليّة"؟"

27
00:02:53,970 --> 00:02:55,120
.ربّما هي مهارة من نوع ما

28
00:02:55,120 --> 00:02:56,410
.سأقوم بالتّقييم

29
00:03:00,320 --> 00:03:01,820
،لم أفهم كلّ ذلك حقًّا

30
00:03:01,820 --> 00:03:03,890
لكن أعتقد أنّه يحبّ المال كثيرًا؟

31
00:03:05,310 --> 00:03:07,660
،كان في تلك الخيارات بعض العيوب

32
00:03:07,660 --> 00:03:09,250
.لذلك ما كنتُ لأوصيك بهم

33
00:03:09,250 --> 00:03:10,410
عيوب؟

34
00:03:10,410 --> 00:03:13,080
.إنّهم غير مناسبين لا للعمل ولا للقتال

35
00:03:13,790 --> 00:03:15,190
،لأسباب عديدة

36
00:03:15,190 --> 00:03:17,770
،لا يمكنهم العودة إلى مواطنهم

37
00:03:17,770 --> 00:03:20,180
.لكنّني سمحت لهم بالبقاء هنا بسبب طيبة قلبي

38
00:03:20,400 --> 00:03:22,820
...لا يمكنهم العودة إلى مواطنهم

39
00:03:22,820 --> 00:03:25,480
...أتساءل إن كانوا في نفس وضعي

40
00:03:26,130 --> 00:03:27,630
هلاّ أخذتني إليهم رجاءً؟

41
00:03:31,800 --> 00:03:33,880
!لا أصدّق هذا

42
00:03:33,880 --> 00:03:38,720
!رائحة الثّروة صارت أقوى بكثير

43
00:03:39,310 --> 00:03:40,920
هل نذهب الآن؟

44
00:03:49,570 --> 00:03:51,240
.انظر هناك

45
00:03:51,240 --> 00:03:52,080
ماذا؟

46
00:03:57,210 --> 00:03:58,610
.ذئب

47
00:04:01,520 --> 00:04:03,590
لماذا هو في قفص؟

48
00:04:03,590 --> 00:04:06,580
دخل في حالة هيجان
.وهو يحاول حماية تلك الفتاة

49
00:04:07,270 --> 00:04:11,470
،كان مجرّد سوء فهم
.لكنّ يجب احترام القواعد

50
00:04:11,470 --> 00:04:15,430
تمّ تقييم الفتاة البشريّة
،وحُدّد أنّها تملك قدرات سحريّة

51
00:04:15,430 --> 00:04:18,620
،لكنّها لا تستطيع التّحكّم بها
—لذلك تخرج منها بلا أيّ

52
00:04:19,890 --> 00:04:21,450
!اغرب من هنا يا فتى

53
00:04:21,710 --> 00:04:22,790
...مخيف

54
00:04:23,280 --> 00:04:24,660
.سأقوم بتقييمه

55
00:04:24,660 --> 00:04:25,690
فعلاً؟

56
00:04:28,460 --> 00:04:29,570
ماذا؟

57
00:04:29,840 --> 00:04:32,240
.بعض الإحصاءات خفيّة

58
00:04:32,240 --> 00:04:35,570
.كشفتْ عين الخبير تلاعبًا في الإحصاءات

59
00:04:35,570 --> 00:04:37,710
ماذا تفعل عين الخبير؟

60
00:04:37,710 --> 00:04:39,930
.أوصي باستعمال القاموس

61
00:04:39,930 --> 00:04:40,810
!صحيح

62
00:04:40,810 --> 00:04:41,950
.تفعيل القاموس

63
00:04:41,950 --> 00:04:43,330
.ابحث عن عين الخبير

64
00:04:44,590 --> 00:04:46,460
...الكثير من الكلمات

65
00:04:46,460 --> 00:04:49,520
.مهارة فطريّة: عين الخبير"
".رتبة النُّدرة تتجاوز س س س

66
00:04:49,520 --> 00:04:51,430
".يمنحها إلهٌ متى شاء"

67
00:04:51,430 --> 00:04:53,740
".إنّها عين التّقييم المطلقة في العالم"

68
00:04:54,030 --> 00:04:55,800
مهلاً، أهذا شيء عاديّ؟

69
00:04:55,800 --> 00:04:57,450
.هذا أمر غير مسبوق

70
00:04:57,450 --> 00:04:58,820
فعلاً؟

71
00:05:01,230 --> 00:05:05,930
!تماديت كثيرًا أيّها الإله

72
00:05:07,210 --> 00:05:08,390
.هاها

73
00:05:09,630 --> 00:05:11,130
هل أنت بخير؟

74
00:05:11,130 --> 00:05:12,950
.أ-أنا بخير

75
00:05:12,950 --> 00:05:15,700
.إعادة تقييم بعين الخبير

76
00:05:18,490 --> 00:05:19,710
.هذا سيّئ

77
00:05:19,710 --> 00:05:22,360
.لم أنتبه بما يكفي لإحصائيّاته السّابقة

78
00:05:22,360 --> 00:05:24,590
ما معنى "السّلاسل الثّابتة"؟

79
00:05:24,590 --> 00:05:27,150
لنرَ، لعنة خفيّة؟

80
00:05:27,150 --> 00:05:28,830
.سأقرأ ذلك لاحقًا

81
00:05:31,830 --> 00:05:33,390
!بطل؟

82
00:05:33,390 --> 00:05:34,640
...مذهل

83
00:05:34,640 --> 00:05:36,300
ماذا عن الفتاة؟

84
00:05:39,020 --> 00:05:40,270
حكيمة؟

85
00:05:40,270 --> 00:05:42,210
ملاذ الغضب"؟"

86
00:05:42,680 --> 00:05:45,000
.الكثير من المعلومات

87
00:05:45,000 --> 00:05:48,030
وبما أنّه لا يمكن السّيطرة عليها من"
".بشريّ، فإنّها تؤدّي إلى التّدمير الذّاتيّ

88
00:05:48,030 --> 00:05:50,550
مهارة يمنحها إله كاختبار"؟"

89
00:05:50,550 --> 00:05:53,550
أيّها الإله! كيف تفعل
هذا بفتاة صغيرة مثلها؟

90
00:05:54,200 --> 00:05:56,260
.لم يكن بوسعي فعل أيّ شيء

91
00:05:56,260 --> 00:05:58,460
.إنّه اختبار للحكماء

92
00:05:58,460 --> 00:05:59,800
اختبار؟

93
00:05:59,800 --> 00:06:03,280
...على أيّ حال، كلود أبراس وليليان روج

94
00:06:03,280 --> 00:06:05,900
،يملك كلاهما نقاط سحر كافية

95
00:06:05,900 --> 00:06:09,250
لكن هل مسموح لي بضمّ
بطل وحكيمة إليّ؟

96
00:06:09,250 --> 00:06:10,730
!افعل ما يحلو لك

97
00:06:11,810 --> 00:06:13,140
.لا بأس إذًا

98
00:06:13,490 --> 00:06:15,300
.رسالة من سابو

99
00:06:15,300 --> 00:06:19,510
،أوصي باستعمال المهارة التّقنيّة
.إجراء الإغاثة المستوى 1

100
00:06:19,930 --> 00:06:21,400
،لا أفهم ذلك بالكامل

101
00:06:25,860 --> 00:06:27,230
!أخبرني

102
00:06:29,600 --> 00:06:33,110
أعتقد أنّه يمكنني اعتبارها
.مهارة لمساعدة السّيّد كلود

103
00:06:33,450 --> 00:06:35,970
.سآخذ هذين الاثنين

104
00:06:37,410 --> 00:06:42,230
ر-رائحة الثّروة الفاخرة قويّة
!لدرجة أنّها تخنقني

105
00:06:42,970 --> 00:06:46,460
—شكرًا جزيلاً على شراء

106
00:06:47,790 --> 00:06:51,390
...سوف... أموت

107
00:06:55,770 --> 00:06:58,220
أهذا المكان... آمن؟

108
00:07:01,520 --> 00:07:02,630
!أيّها الوغد

109
00:07:02,630 --> 00:07:05,490
ما الّذي تحاول فعله بنا
هنا في هذه المنطقة النّائية؟

110
00:07:05,770 --> 00:07:06,870
.دعك من ذلك

111
00:07:06,870 --> 00:07:09,050
.لن أفعل أيّ شيء سيّئ لفتاة صغيرة

112
00:07:09,050 --> 00:07:12,240
لكنّي ربّما سأفعل أشياء
.كثيرة لك يا سيّد كلود

113
00:07:13,790 --> 00:07:15,740
!ما-ما الّذي تعنيه بذلك؟

114
00:07:15,740 --> 00:07:17,990
.لا تقلق، سأقوم بشفائك

115
00:07:17,990 --> 00:07:20,620
ماذا؟

116
00:07:24,500 --> 00:07:28,660
.لكنّي سأحتاج لمساعدتك في ذلك يا ليليان

117
00:07:28,660 --> 00:07:30,000
هلا قدّمت لي يد العون؟

118
00:07:30,000 --> 00:07:32,010
!بكلّ سرور إن كان ذلك سيشفيه

119
00:07:32,010 --> 00:07:33,030
!مهلاً

120
00:07:33,030 --> 00:07:34,140
.لا بدّ أنّه فخّ ما

121
00:07:34,410 --> 00:07:35,980
!اصمت قليلاً يا سيّد كلو

122
00:07:37,220 --> 00:07:40,450
...لطالما كان السّيّد كلو إلى جانبي

123
00:07:40,450 --> 00:07:42,840
.لطالما ساعدني

124
00:07:42,840 --> 00:07:45,470
!لذلك أريد أن أردّ له الجميل هذه المرّة

125
00:07:48,440 --> 00:07:49,480
...ليليان

126
00:07:49,800 --> 00:07:52,560
حسنًا، ماذا عليّ فعله؟

127
00:07:52,560 --> 00:07:56,020
.نحتاج للكثير من نقاط السّحر لشفائه

128
00:07:56,020 --> 00:07:59,480
لذلك هلاّ أبرمتِ عقدًا معي
وشاركتني نقاط سحرك؟

129
00:07:59,480 --> 00:08:01,020
!أنا موافقة

130
00:08:01,020 --> 00:08:03,140
.تمّ قبول العقد

131
00:08:07,250 --> 00:08:08,740
!تفعيل الكتاب الطّبّيّ

132
00:08:09,080 --> 00:08:10,840
!العلاج المثاليّ

133
00:08:26,930 --> 00:08:27,820
!سيّد كلو

134
00:08:31,760 --> 00:08:34,210
.كم سرّني هذا يا سيّد كلو

135
00:08:34,210 --> 00:08:35,930
.كم سرّني هذا

136
00:08:35,930 --> 00:08:37,030
.ليليان

137
00:08:38,030 --> 00:08:39,690
.أنا ممتنّ لك

138
00:08:39,690 --> 00:08:41,800
...شكرًا لك يا

139
00:08:42,100 --> 00:08:43,940
.اسمي هيبيكي

140
00:08:43,940 --> 00:08:45,290
.هيبيكي مانابي

141
00:08:45,290 --> 00:08:46,700
.هيبيكي

142
00:08:47,290 --> 00:08:49,020
كيف هو وضع جسدك الآن؟

143
00:08:49,020 --> 00:08:52,210
لا أصدّق ما الثّقل الّذي كنتُ
.أشعر به قبل دقيقة فحسب

144
00:08:52,210 --> 00:08:54,150
.لكن لستُ في أفضل حالاتي بعد

145
00:08:54,150 --> 00:08:55,890
.ذلك أمر متوقّع

146
00:08:55,890 --> 00:08:57,460
.اللّعنة هي السّبب

147
00:08:57,460 --> 00:09:00,220
كيف... كيف تعرف بشأن ذلك؟

148
00:09:00,530 --> 00:09:03,520
،لا يمكن اكتشاف تلك اللّعنة
.حتّى من طرف مقيّم

149
00:09:03,520 --> 00:09:06,720
أنت... تعرف من أكون؟

150
00:09:06,720 --> 00:09:08,200
أنت بطل، صحيح؟

151
00:09:08,200 --> 00:09:11,240
وأنت يا ليليان ستصيرين
.حكيمة في المستقبل

152
00:09:11,620 --> 00:09:12,850
حكيمة؟

153
00:09:13,320 --> 00:09:15,810
كـ-كيف تعرف هذا؟

154
00:09:16,100 --> 00:09:19,290
.لأنّ الإله منحني قدرة عين الخبير

155
00:09:19,490 --> 00:09:21,130
عين الخبير؟

156
00:09:21,130 --> 00:09:25,660
عينٌ وهبها الإله، العين الإلهيّة
...الّتي تستطيع أن ترى الحقيقة

157
00:09:30,700 --> 00:09:32,500
!تفعيل إجراء الإغاثة

158
00:09:32,500 --> 00:09:35,130
.تفعيل إجراء الإغاثة المستوى 1

159
00:09:59,940 --> 00:10:01,940
!هـ-هل مات؟

160
00:10:09,560 --> 00:10:10,710
أنا حيّ؟

161
00:10:14,020 --> 00:10:17,140
!أيّها الإله، أزال ذلك سلسلة واحدة فقط

162
00:10:17,140 --> 00:10:18,250
ما الّذي توقّعتَه؟

163
00:10:18,250 --> 00:10:20,250
!إنّ إجراء الإغاثة في المستوى 1 فقط

164
00:10:23,490 --> 00:10:25,010
...هـ-هذا

165
00:10:25,430 --> 00:10:27,470
!لقد استعدتُ بعضًا من قوّتي

166
00:10:27,470 --> 00:10:29,940
.يبد كأنّك صرتَ أقوى

167
00:10:29,940 --> 00:10:31,190
.يا سيّدي هيبيكي

168
00:10:32,390 --> 00:10:35,600
.سامحني رجاءً على فظاظتي من قبل

169
00:10:35,600 --> 00:10:37,140
،بعد أن أصبتُ باللّعنة

170
00:10:37,140 --> 00:10:40,360
.فقدتُ قوّتي وسمعتي وحتّى روحي

171
00:10:40,360 --> 00:10:43,870
أنا أكنّ لك كلّ الامتنان
.لإنقاذك لي من هذا الوضع

172
00:10:43,870 --> 00:10:45,310
ا-العفو؟

173
00:10:46,010 --> 00:10:50,260
سيّدي هيبيكي، امنحني رجاءً شرف
.أداء مراسم الولاء لك

174
00:10:50,260 --> 00:10:52,740
مراسم الولاء"؟ وما هذه؟"

175
00:10:53,260 --> 00:10:56,670
،إنّها طقوس أكرّس فيها روحي لك

176
00:10:56,670 --> 00:10:59,750
.وأقسم فيها على البقاء إلى جانبك وحمايتك

177
00:10:59,750 --> 00:11:02,780
إذًا أنت تريد إعلان قرارك ببساطة؟

178
00:11:02,780 --> 00:11:04,770
.أعتقد أنّي لا أمانع ذلك

179
00:11:04,770 --> 00:11:06,300
!شكرًا جزيلاً لك

180
00:11:06,930 --> 00:11:08,830
.رسالة من سابو

181
00:11:08,830 --> 00:11:12,120
أوصي باستعمال مهارة العقد
.من أجل مراسم الولاء

182
00:11:12,120 --> 00:11:13,240
العقد؟

183
00:11:13,240 --> 00:11:14,930
أذلك ضروريّ للمراسم؟

184
00:11:14,930 --> 00:11:18,480
تملك العقود القوّة لجعل
.الطّرفين يفيان بوعودهما

185
00:11:18,480 --> 00:11:20,880
،عند إبرام عقد بمراسم الولاء

186
00:11:20,880 --> 00:11:25,330
ستصيران أنت والبطل
.ملزمان بالوفاء بوعدكما

187
00:11:25,330 --> 00:11:27,240
.سيسعد البطل بذلك كثيرًا

188
00:11:27,240 --> 00:11:30,110
فهمت. لا بأس إن كان
.ذلك سيُسعد السّيّد كلود

189
00:11:30,110 --> 00:11:34,510
وفي حالة السّيّد كلود، لا أريد
.أن أخلف بوعدي له أبدًا

190
00:11:34,510 --> 00:11:36,520
.حسنًا، تفعيل العقد

191
00:11:37,440 --> 00:11:38,890
عقد"؟"

192
00:11:46,660 --> 00:11:51,980
أعيّن أنا كلود أبراس بموجب
.هذا هيبيكي مانابي سيّدًا لي

193
00:11:52,340 --> 00:11:56,110
،أُقسم له بالولاء التّامّ بجسدي وروحي

194
00:11:56,110 --> 00:12:00,930
وأتعهّد بحمايته بكلّ ما أملك
.من قوّة طوال حياتي

195
00:12:00,930 --> 00:12:05,440
."إن قبلتَ بولائي، قل "سأسمح بذلك

196
00:12:05,760 --> 00:12:07,930
.حسنًا... سأسمح بذلك

197
00:12:07,930 --> 00:12:09,950
.تمّ قبول العقد

198
00:12:11,420 --> 00:12:15,420
تمّ قبول مراسم الولاء بشكل
.رسميّ من طرف أرواح النّور

199
00:12:16,100 --> 00:12:19,940
.تمّ تأسيس الولاء

200
00:12:24,670 --> 00:12:26,260
ما هذا الرّمز؟

201
00:12:26,920 --> 00:12:29,700
.إنّه شعار أرواح النّور

202
00:12:29,700 --> 00:12:32,830
.إنّه علامة على أنّه تمّ الاعتراف بولائي

203
00:12:33,290 --> 00:12:37,090
سيّدي هيبيكي، نادني كلود
.فحسب من الآن فصاعدًا

204
00:12:37,530 --> 00:12:38,460
.حسنًا

205
00:12:38,460 --> 00:12:40,860
.أتطلّع للعمل معك يا كلود

206
00:12:40,860 --> 00:12:43,600
!وأنا كذلك يا سيّدي هيبيكي

207
00:12:43,960 --> 00:12:46,850
!سيّد كلو، أنا مسرورة لأجلك

208
00:12:57,550 --> 00:13:00,160
بالمناسبة، يفترض أنّ هنالك
.ينبوعًا ساخنًا أمامنا

209
00:13:00,160 --> 00:13:02,250
.فلنتوقّف فيه للرّاحة

210
00:13:02,250 --> 00:13:03,660
!ينبوع ساخن؟

211
00:13:03,660 --> 00:13:04,770
!هذا مذهل

212
00:13:04,770 --> 00:13:06,880
،سيريح ذلك الجسد، والأهمّ من ذلك

213
00:13:06,880 --> 00:13:09,300
سأكون قادرة على الاستمتاع
!بالنّظر لتلكما التّلّتين

214
00:13:14,510 --> 00:13:16,130
التّلّتين؟

215
00:13:16,400 --> 00:13:20,140
.أسحب كلامي. بإمكاني مواصلة السّير
.لا داعي للتّوقّف في الينبوع السّاخن

216
00:13:20,390 --> 00:13:21,860
لماذا؟

217
00:13:21,860 --> 00:13:24,660
.ينبغي علينا الاقتصاد قدر الإمكان
...وثمّ

218
00:13:24,660 --> 00:13:27,980
.سنكون عُزّل بالكامل عند دخولنا للحمّام

219
00:13:27,980 --> 00:13:31,450
إنّ إرخاء دفاعاتنا قرب شخص
.لا نعرفه جيّدًا قد يكون خطيرًا

220
00:13:31,450 --> 00:13:33,100
.أعتقد أنّك تتصرّفين بريبة كبيرة

221
00:13:33,100 --> 00:13:36,780
لا يمكننا ذلك! كما لا يمكنك أن تكوني
!عارية معها كأنّكما صديقتين

222
00:13:36,780 --> 00:13:37,910
!صديقتين؟

223
00:13:37,910 --> 00:13:41,010
.من العاديّ للأصدقاء أن يغسلوا بعضهم

224
00:13:44,100 --> 00:13:45,880
!لنذهب إلى الينبوع السّاخن

225
00:13:54,690 --> 00:13:59,390
لهذا السّبب لا يمكنني استعمال
.سحر الشّفاء بنقاط سحري فقط

226
00:13:59,860 --> 00:14:02,410
.لذلك أحتاج مساعدتكما

227
00:14:02,410 --> 00:14:03,790
.فهمت

228
00:14:03,790 --> 00:14:07,440
بإمكاننا تعويض الفارق
.بنقاط سحرنا ونقاط تحمّلنا

229
00:14:07,440 --> 00:14:09,310
.يمكنك الاعتماد عليّ يا سيّدي هيبيكي

230
00:14:09,310 --> 00:14:10,650
.وعليّ أيضًا

231
00:14:11,010 --> 00:14:12,320
.شكرًا

232
00:14:12,770 --> 00:14:16,410
.لنبرم عقدَ تشارك إذًا

233
00:14:16,410 --> 00:14:19,330
.تفعيل مهارة العقد التّقنيّة

234
00:14:21,410 --> 00:14:24,440
.ارتفع مستوى مهارة كتاب التّعاويذ التّقنيّة

235
00:14:24,440 --> 00:14:25,900
.صحيح، كتاب التّعاويذ

236
00:14:25,900 --> 00:14:26,930
...سيّدي هيبيكي

237
00:14:26,930 --> 00:14:30,680
،كنتُ أتساءل طوال هذا الوقت

238
00:14:30,680 --> 00:14:32,830
لكن أهنالك شخص ما تتحدّث معه؟

239
00:14:32,830 --> 00:14:34,310
—صحيح، إنّه سابو

240
00:14:34,310 --> 00:14:37,300
في الحقيقة، هنالك صوت يقوم
.بإرشادي بخصوص كلّ شيء

241
00:14:37,300 --> 00:14:38,380
!صوت؟

242
00:14:38,380 --> 00:14:39,900
...مهلاً يا سيّدي هيبيكي

243
00:14:39,900 --> 00:14:42,230
هل تملك مهارة المرحلة التّعليميّة؟

244
00:14:42,230 --> 00:14:42,850
.نعم

245
00:14:42,850 --> 00:14:43,750
!لا أصدّق

246
00:14:43,750 --> 00:14:47,190
إذًا لا بدّ أنّك تحمل أيضًا
!لقب "رحّالة من عالم آخر"؟

247
00:14:47,190 --> 00:14:48,830
أتعرف بأمر العوالم الأخرى؟

248
00:14:48,830 --> 00:14:49,920
.نعم

249
00:14:49,920 --> 00:14:53,730
.لا أعرف الكثير، لكنّي سمعتُ بوجودها

250
00:14:53,730 --> 00:14:56,830
!لا أصدّق أنّك شخص أتى من عالم آخر

251
00:14:57,090 --> 00:14:58,690
عمّ تتحدّثان؟

252
00:14:58,690 --> 00:15:00,840
...حسنًا... ذلك

253
00:15:01,200 --> 00:15:06,160
أتى سيّدي هيبيكي من مكان
.بعيد جدًّا، وقام بإنقاذنا

254
00:15:06,160 --> 00:15:08,200
.هذا كلّ ما تحتاجين لمعرفته الآن

255
00:15:08,200 --> 00:15:10,240
.إن كان الأمر هكذا، فقد فهمت

256
00:15:10,240 --> 00:15:14,300
عفوًا... ألا تمانع أنّي شخص
أتيت من عالم آخر؟

257
00:15:14,300 --> 00:15:15,510
.إطلاقًا

258
00:15:15,510 --> 00:15:17,810
.لن يؤثّر ذلك على ولائي

259
00:15:18,070 --> 00:15:19,450
.شكرًا لك

260
00:15:19,450 --> 00:15:23,230
ومع ذلك، بالكاد أصدّق أنّك تملك
مهارة المرحلة التّعليميّة المعجزة

261
00:15:23,230 --> 00:15:25,310
.الّتي يمنحها الإله مباشرة

262
00:15:25,310 --> 00:15:27,570
!أهي مهارة استثنائيّة لهذه الدّرجة؟

263
00:15:28,400 --> 00:15:29,810
!هذه مبالغة كبيرة

264
00:15:29,810 --> 00:15:31,950
.إنّه يبالغ فحسب

265
00:15:31,950 --> 00:15:33,580
.الأمر ليس كذلك إذًا

266
00:15:33,580 --> 00:15:37,820
مع أنّي منهك دائمًا لأنّي أستعمل
...ثُلث قوّتي على تلك المهارة

267
00:15:37,820 --> 00:15:40,070
!إذًا إنّها قوّة استثنائيّة بالفعل

268
00:15:43,090 --> 00:15:48,040
أعتقد أنّ الإله الّذي أنت
.على اتّصال به هو الإله الأعلى

269
00:15:48,330 --> 00:15:52,290
هنالك أحد عشر إلهًا
.في هذا العالم بالمجمل

270
00:15:52,680 --> 00:15:55,490
.ويُعتبر الإله الأعلى أوّلها

271
00:15:55,490 --> 00:16:00,250
المرحلة التّعليميّة وعين الخبير
.هما بركتان تُمنحان منه شخصيًّا

272
00:16:00,250 --> 00:16:02,480
إذًا فهو الأقوى بين الآلهة؟

273
00:16:02,480 --> 00:16:04,900
!ذلك صحيح، واصل تبجيلي

274
00:16:05,650 --> 00:16:07,280
...لكنّه عفويّ جدًّا

275
00:16:07,280 --> 00:16:11,560
يبدو أنّك نلت استحسان الإله الأعلى
.بشكل كبير يا سيّدي هيبيكي

276
00:16:11,560 --> 00:16:12,770
!هذا متوقّع

277
00:16:13,190 --> 00:16:18,170
أعتقد أنّه إذا كان هنالك أيّ أشخاص
.قد نالوا استحسانه، فهما أنت وليليان

278
00:16:18,170 --> 00:16:23,280
لكنّ مهارة ملاذ الغضب الّتي مُنحت
.إلى ليليان تبدو قاسية حقًّا

279
00:16:23,280 --> 00:16:25,440
ملاذ الغضب"؟"

280
00:16:25,440 --> 00:16:28,290
.هذه أوّل مرّة أسمع عنها
أيّ مهارة هي يا ترى؟

281
00:16:28,570 --> 00:16:30,340
هل أملك شيئًا مميّزًا؟

282
00:16:30,340 --> 00:16:33,390
.لديك مهارة تدمّرك بقوّة سحريّة هائلة

283
00:16:36,900 --> 00:16:39,040
أما كان عليّ إخبارها؟

284
00:16:39,040 --> 00:16:40,800
.إنّه أمر صادم بالفعل

285
00:16:40,800 --> 00:16:42,110
،بسبب تلك القوّة

286
00:16:42,110 --> 00:16:45,630
نبذتها عائلتها وباعتها كضمان
...للحصول على قرض

287
00:16:45,630 --> 00:16:47,000
.هذا ما حدث إذًا

288
00:16:47,000 --> 00:16:48,870
.ربّما أخطأتُ بإخبارها عنها

289
00:16:48,870 --> 00:16:52,530
،لا، إن كان هذا خطأ أحد ما
.فهو الإله الأعلى عندما منحها المهارة

290
00:16:52,530 --> 00:16:56,140
لا أعتقد أنّ الإله الأعلى
،هو من منحها تلك المهارة

291
00:16:56,140 --> 00:16:58,190
.بل هي إلهة السّحر

292
00:16:58,190 --> 00:17:01,090
إنّ كلّ الأمور المتعلّقة بالسّحر
.تقع ضمن سلطتها

293
00:17:02,720 --> 00:17:04,950
.قد يكون... ذلك صحيحًا

294
00:17:10,460 --> 00:17:11,620
!كلاّ

295
00:17:11,620 --> 00:17:13,410
!إنّه مجرّد سوء فهم

296
00:17:15,890 --> 00:17:17,000
ما الّذي يحدث؟

297
00:17:17,000 --> 00:17:18,620
.صار الوضع مقلقًا جدًّا فجأة

298
00:17:18,620 --> 00:17:22,860
.يبدو أنّ الفتاة تعاني بسبب تلك المهارة

299
00:17:24,030 --> 00:17:28,600
،لكن بمجرّد منح المهارة
.فحتّى نحن لا يمكننا إزالتها

300
00:17:28,600 --> 00:17:30,600
المعذرة، من تكونين؟

301
00:17:31,290 --> 00:17:33,000
.أنا إلهة السّحر

302
00:17:33,740 --> 00:17:35,350
إلهة السّحر؟

303
00:17:36,550 --> 00:17:40,550
،لحسن الحظّ أنّك تملك مهارتي
.كتاب التّعاويذ

304
00:17:40,550 --> 00:17:44,220
وباستعمالها، بإمكانك تعديل
.نقاط سحرها وقوّتها السّحريّة

305
00:17:44,220 --> 00:17:48,400
.لكن لا تُسئ الفهم
.لن أساعدك طوال الوقت

306
00:17:48,400 --> 00:17:50,150
تعنين بهذا أنّك...؟

307
00:17:50,630 --> 00:17:56,440
يعمل نظام الإدارة تلقائيًّا عند استخدام
.كتاب التّعاويذ، لذلك فلا داعي للقلق

308
00:17:56,440 --> 00:17:58,210
!شكرًا جزيلاً لك

309
00:17:58,210 --> 00:18:00,810
.أ-أنا أعتذر يا إلهة السّحر

310
00:18:00,810 --> 00:18:02,370
...أنا نادم بالفعل

311
00:18:02,370 --> 00:18:04,320
.وصلتُ لحدودي بالفعل

312
00:18:04,320 --> 00:18:06,200
.وكأنّني قد أسامحك

313
00:18:06,200 --> 00:18:07,900
!يا إلهة العالم السّفليّ

314
00:18:07,900 --> 00:18:11,230
ألم تقولي أنّك صنعت جهاز
عذراء حديديّة للتّعذيب مؤخّرًا؟

315
00:18:11,230 --> 00:18:12,850
!لا، لا، لا، توقّفي

316
00:18:12,850 --> 00:18:14,490
!ليس ذلك! قد أموت فعلاً

317
00:18:14,020 --> 00:18:16,480
.نعم، لا بأس بموتك

318
00:18:16,480 --> 00:18:20,230
ثمّ يمكنك أن تولد من جديد
.كإله أعلى جادّ هذه المرّة

319
00:18:20,230 --> 00:18:21,660
!أرجوك! لا

320
00:18:21,660 --> 00:18:23,450
...يا سيّدي هيبيكي

321
00:18:23,450 --> 00:18:25,570
ما الّذي قاتله إلهة السّحر؟

322
00:18:25,570 --> 00:18:28,250
.قالت أنّ كلّ شيء سيكون بخير

323
00:18:28,250 --> 00:18:29,740
فـ-فعلاً؟

324
00:18:30,040 --> 00:18:33,030
!يا إلهة السّحر! كم أنت رحيمة

325
00:18:33,260 --> 00:18:34,410
...أتساءل حيال ذلك

326
00:18:36,420 --> 00:18:38,180
.رسالة من سابو

327
00:18:38,180 --> 00:18:41,970
إنّ مهارتَيْ المرحلة التّعليميّة
.وعين الخبير خارج الخدمة الآن

328
00:18:41,970 --> 00:18:43,540
ماذا؟ خارج الخدمة؟

329
00:18:43,540 --> 00:18:46,050
.ستكون عين الخبير غير متوفّرة مؤقّتًا

330
00:18:46,050 --> 00:18:49,460
كما تمّ تعليق التّحكّم بالمصير
.لمهارة المرحلة التّعليميّة

331
00:18:49,460 --> 00:18:53,320
لا يمكنني الآن أن أمنحك إلاّ دعمًا
.بناءً على البيانات الّتي لديك مسبقًا

332
00:18:53,320 --> 00:18:57,060
لا أدري ما معنى هذا، لكنّي
.أتساءل إن كان الإله الأعلى بخير

333
00:18:57,520 --> 00:18:58,950
...ذلك الفتى

334
00:19:00,270 --> 00:19:02,450
.أشعر أنّي رأيته في مكان ما سابقًا

335
00:19:03,170 --> 00:19:05,960
.حسنًا. تفعيل كتاب التّعاويذ الآن

336
00:19:05,960 --> 00:19:08,820
.تفعيل المهارة التّقنيّة: كتاب التّعاويذ

337
00:19:11,650 --> 00:19:13,330
!مرحبًا

338
00:19:16,410 --> 00:19:17,700
!مرحبًا

339
00:19:17,700 --> 00:19:19,520
.مـ-مرحبًا

340
00:19:19,520 --> 00:19:20,800
من أنت؟

341
00:19:21,070 --> 00:19:23,510
.اسم فيني هو فيني

342
00:19:23,510 --> 00:19:26,750
أرسلتني إلهة السّحر لأعلّمها
—كيف تتحكّم بالسّحر

343
00:19:26,750 --> 00:19:28,710
!يا للظّرافة

344
00:19:29,700 --> 00:19:31,080
!كلاّ

345
00:19:31,970 --> 00:19:33,690
...ليس هناك

346
00:19:34,340 --> 00:19:37,120
!هذا ليس عدلاً يا ليليان
!أريد أن أجرّب أيضًا

347
00:19:37,860 --> 00:19:41,670
!يـ-يكفي

348
00:19:43,410 --> 00:19:45,410
.أرى أنّك تحبّ هذا

349
00:19:52,650 --> 00:19:54,040
هل من خطب ما؟

350
00:19:54,040 --> 00:19:57,940
،أكاد أجزم أنّي شعرتُ بهالة غريبة
.لكن ربّما كنتُ أتخيّل فقط

351
00:19:57,940 --> 00:20:00,390
أخبرني يا فيني، ماذا عن كتاب تعاويذي؟

352
00:20:02,250 --> 00:20:05,050
.فيني... هو كتاب التّعاويذ

353
00:20:05,050 --> 00:20:07,820
...فيني هو... وحش مقدّس قويّ

354
00:20:07,820 --> 00:20:11,940
...أنشأَتْه... إلهة السّحر

355
00:20:11,940 --> 00:20:14,390
.دعوا الأمر لفيني فحسب

356
00:20:14,390 --> 00:20:16,390
!مفهوم. كم أنت ظريف

357
00:20:16,390 --> 00:20:17,930
!أيّها الوغد

358
00:20:17,930 --> 00:20:21,270
!إلى متى تنوي التّشبّث بسيّدي هيبيكي؟

359
00:20:23,470 --> 00:20:29,690
فأنا... فأنا... فأنا... لم أحصل
!على تربيت منه من قبل

360
00:20:29,990 --> 00:20:31,200
.أنا أعتذر

361
00:20:31,200 --> 00:20:32,820
.حسنًا يا فيني

362
00:20:32,820 --> 00:20:33,720
...كتاب التّعاويذ

363
00:20:33,720 --> 00:20:36,330
!ما خطبكم جميعًا؟

364
00:20:36,330 --> 00:20:37,990
!تثرثرون، تثرثرون، تثرثرون كثيرًا

365
00:20:42,560 --> 00:20:45,580
.المياه السّاخنة منعشة
.سررتُ بمجيئنا إلى هنا

366
00:20:45,580 --> 00:20:46,440
.صحيح

367
00:20:47,450 --> 00:20:49,980
!يا لهما من تلّتين رائعتين

368
00:20:49,980 --> 00:20:51,640
.مذهلتان

369
00:20:51,930 --> 00:20:53,630
...بالمناسبة يا ستيليا

370
00:20:53,630 --> 00:20:56,600
ما المسألة المهمّة الّذي يريد
أبي الحديث معي بشأنها؟

371
00:20:57,570 --> 00:21:00,570
.لم يتمّ إبلاغي بأيّ شيء عن التّفاصيل

372
00:21:00,570 --> 00:21:02,100
.فهمت

373
00:21:02,100 --> 00:21:03,360
إيفل؟

374
00:21:03,360 --> 00:21:06,520
عفوًا... أتريدين أن أغسل ظهرك؟

375
00:21:06,520 --> 00:21:08,490
.ما... لا أريد

376
00:21:08,490 --> 00:21:10,440
ر-رفضت؟

377
00:21:10,440 --> 00:21:12,300
.سأقوم بذلك بنفسي

378
00:21:13,330 --> 00:21:14,860
!هـ-هذا طبيعيّ

379
00:21:16,830 --> 00:21:20,030
.أعتقد أنّنا لم نصر صديقتين في النّهاية

380
00:21:20,030 --> 00:21:21,260
.يا سيّدتي إماليا

381
00:21:21,590 --> 00:21:24,080
.تقرّبك من إيفل فيه استعجال كبير

382
00:21:24,430 --> 00:21:26,600
أ-أتعتقدين ذلك؟

383
00:21:26,600 --> 00:21:31,600
.أردتُ فقط تقليل المسافة بيننا لا غير

384
00:21:32,180 --> 00:21:36,930
إنّ مجرّد غسل ظهرَيْ بعضكما البعض
.في الحمّام لن يجعلكما صديقين

385
00:21:37,310 --> 00:21:39,500
!أ-أنا أعلم ذلك

386
00:21:39,500 --> 00:21:40,970
.لا تتحرّكي رجاءً

387
00:21:40,970 --> 00:21:43,060
.سيظهران هكذا، ولن أستطيع الرّؤية حينها

388
00:21:43,060 --> 00:21:44,130
وما معنى ذلك؟

389
00:21:44,130 --> 00:21:46,100
صديقتين"؟"

390
00:21:46,650 --> 00:21:47,900
!إماليا

391
00:21:47,900 --> 00:21:49,390
.سأغسل ظهرك إن أردتِ

392
00:21:49,390 --> 00:21:50,570
!فـ-فعلاً؟

393
00:21:51,740 --> 00:21:53,410
نحن صديقتين، صحيح؟

394
00:23:25,410 --> 00:23:27,420
!السّيّد كلو ناعم جدًّا

395
00:23:27,420 --> 00:23:28,850
!يا له من شعور رائع

396
00:23:29,150 --> 00:23:30,750
.وسائد كفّيه صلبة قليلاً

397
00:23:30,750 --> 00:23:32,610
.هذا صحيح، تبدو مثل قاع حذاء

398
00:23:33,170 --> 00:23:35,250
!لكنّ خنصريه ناعمين أيضًا

399
00:23:35,250 --> 00:23:36,690
.معك حقّ، يا له من شعور