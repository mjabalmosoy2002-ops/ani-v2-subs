1
00:00:01,780 --> 00:00:03,970
،سلكتُ طريقًا طويلاً للأسف

2
00:00:04,370 --> 00:00:06,670
.لكن يبدو أنّ هذا هو المكان الصّحيح

3
00:00:06,990 --> 00:00:09,330
كلود هو التّالي، أليس كذلك؟

4
00:00:09,330 --> 00:00:12,730
لقد فقد أطرافه، لذا ينبغي
.أن يكون الأمر سهلاً

5
00:00:13,590 --> 00:00:15,210
.أنا أهل لهذا الأمر

6
00:01:47,230 --> 00:01:50,250
.أوصي باستعمال استدعاء وحش مقدّس

7
00:01:57,790 --> 00:02:01,230
تريد لقاء الحكماء، أليس كذلك؟

8
00:02:01,230 --> 00:02:02,100
.نعم

9
00:02:02,550 --> 00:02:07,190
إذًا لا خيار أمامنا إلاّ الذّهاب
.إلى مدينة تُدعى تيرا دايناس

10
00:02:07,190 --> 00:02:09,010
تيرا دايناس؟

11
00:02:09,010 --> 00:02:10,820
أين توجد؟

12
00:02:11,130 --> 00:02:13,600
يمكن الوصول إليها بمجرّد
.الخروج من ديماس

13
00:02:13,600 --> 00:02:17,810
أسرع طريق إليها من رويل
.هو عبر الدّياميس الشّماليّة

14
00:02:17,810 --> 00:02:19,240
ما هو الدّيماس؟

15
00:02:19,240 --> 00:02:23,330
.مكان خطير يعجّ بالوحوش

16
00:02:23,330 --> 00:02:27,990
،ما لم نتدرّب بشكل أشدّ من السّابق
.فسيكون اجتيازه صعبًا

17
00:02:28,540 --> 00:02:31,730
.لا أفهم الأمر تمامًا، لكن يبدو ذلك صعبًا

18
00:02:32,150 --> 00:02:33,710
.شكرًا على الطّعام

19
00:02:35,430 --> 00:02:36,580
.مرحبًا

20
00:02:36,580 --> 00:02:37,920
هل حدث شيء ما؟

21
00:02:38,870 --> 00:02:40,060
!سيّدي

22
00:02:40,290 --> 00:02:44,220
.نمرّ أنا وليليان من عقبة صغيرة الآن

23
00:02:44,220 --> 00:02:45,860
.فهمت

24
00:02:45,860 --> 00:02:48,570
!لا داعي للقلق، أنا هنا معك

25
00:02:52,100 --> 00:02:54,080
.أحسنت يا هيبيكي

26
00:02:54,080 --> 00:02:57,810
لنبني بعض العضلات المفتولة
!خلال مخيّم التّدريب هذا

27
00:02:59,020 --> 00:03:01,080
.لنعد للمنزل يا سيّدي

28
00:03:01,080 --> 00:03:03,620
،لا أحبّ هذا أيضًا

29
00:03:03,620 --> 00:03:06,550
لكنّك بحاجة للمزيد من التّدريب
.بالفعل لاجتياز الدّيماس الشّماليّ

30
00:03:06,550 --> 00:03:09,450
.التّدرّب هنا ليست فكرة سيّئة

31
00:03:09,450 --> 00:03:10,470
!عجبًا

32
00:03:10,470 --> 00:03:12,450
!أنا مسرور لأنّك بدأت ترى الحقيقة أخيرًا

33
00:03:12,750 --> 00:03:15,170
.نحن هنا لصقل مهاراتنا فحسب

34
00:03:15,170 --> 00:03:18,630
إذا كانت عضلاتك قويّة، فستسير
.الأمور على ما يرام بطريقة أو بأخرى

35
00:03:18,630 --> 00:03:22,080
لن أسمح لك بتحويل سيّدي هيبيكي
.إلى مغفّل معضلات ضخمة

36
00:03:25,150 --> 00:03:28,590
!حسنًا... سأبذل جهدي

37
00:03:51,800 --> 00:03:54,630
إنّه يبذل جهده بالفعل، صحيح؟

38
00:03:54,630 --> 00:03:59,110
نظرًا لمدى سوئه، إنّه يبذل
.كلّ ما في وسعه بالفعل

39
00:03:59,110 --> 00:04:01,260
لأنّه يريد العودة لدياره؟

40
00:04:02,830 --> 00:04:04,290
.لا أدري

41
00:04:04,290 --> 00:04:06,570
.لكنّ ما يفكّر فيه ليس مهمًّا

42
00:04:06,570 --> 00:04:09,050
.لا يزال نفس الشّخص

43
00:04:19,890 --> 00:04:22,400
!يعمل الجميع بجدّ

44
00:04:22,400 --> 00:04:23,560
.آنسة تانيا

45
00:04:23,930 --> 00:04:25,530
.لقد أتيت

46
00:04:25,530 --> 00:04:26,960
أليس لديك عمل؟

47
00:04:28,840 --> 00:04:30,290
!كان ذلك وشيكًا

48
00:04:32,970 --> 00:04:34,650
.لنُبقِ نظرنا على الهدف

49
00:04:37,360 --> 00:04:38,540
!مذهل

50
00:04:38,540 --> 00:04:40,310
!عرفتُ أنّ بإمكانك النّجاح يا سيّدي هيبيكي

51
00:04:40,310 --> 00:04:41,810
.لنصب الهدف الآن

52
00:04:44,130 --> 00:04:46,560
!كنت وشيكًا

53
00:04:54,040 --> 00:04:56,320
...لا... أستطيع

54
00:04:56,320 --> 00:04:58,820
!أبليتَ حسنًا يا سيّدي هيبيكي

55
00:04:58,820 --> 00:05:00,570
.في المرّة القادمة، صوّب على المنتصف

56
00:05:00,570 --> 00:05:03,450
.أعتقد أنّك درّبتَ عضلاتك جيّدًا اليوم

57
00:05:03,450 --> 00:05:05,250
.حتّى إن كنتُ لا أستطيع رؤيتها بعد

58
00:05:06,390 --> 00:05:08,820
.أشعر أنّي صرت أقوى أيضًا

59
00:05:08,820 --> 00:05:11,380
.أرني إحصائيّاتي يا سابو

60
00:05:12,330 --> 00:05:14,840
.ماذا؟ لم يتغيّر أيّ شيء عن السّابق

61
00:05:14,840 --> 00:05:19,880
أشعر أنّه يجب أن يكون على
.وشك اكتساب مهارة الرّماية

62
00:05:19,880 --> 00:05:23,090
ربّما كان عليه التّركيز على تدريب
.عضلاته فحسب

63
00:05:23,510 --> 00:05:24,890
.ذلك ليس صحيحًا

64
00:05:24,890 --> 00:05:26,320
.المهارات هي المهمّة

65
00:05:26,320 --> 00:05:27,540
!بل العضلات

66
00:05:27,540 --> 00:05:30,930
!المهارات

67
00:05:28,420 --> 00:05:29,610
!العضلات

68
00:05:31,270 --> 00:05:32,930
ماذا؟ الآنسة جويل؟

69
00:05:33,190 --> 00:05:35,140
!لا يمكنك خداعنا

70
00:05:35,140 --> 00:05:36,970
!هذا صحيح

71
00:05:39,280 --> 00:05:40,770
.أنا هنا

72
00:05:40,770 --> 00:05:41,780
هل من مشكلة؟

73
00:05:41,780 --> 00:05:43,730
لماذا... أنت هنا...؟

74
00:05:44,370 --> 00:05:46,790
.راودني حدس سيّئ

75
00:05:57,150 --> 00:06:00,710
.لا شيء يضاهي الينابيع السّاخنة

76
00:06:00,710 --> 00:06:02,290
.هيبيكي

77
00:06:02,290 --> 00:06:04,680
أتريدني أن أغسل ظهرك؟

78
00:06:04,970 --> 00:06:07,170
!لا-لا تتعبي نفسك

79
00:06:08,700 --> 00:06:09,670
ماذا؟

80
00:06:10,060 --> 00:06:11,330
.لا شيء

81
00:06:11,330 --> 00:06:15,170
كنت أفكّر فقط أنّه قدّ مر وقت طويل
.منذ أن استطعت الاسترخاء هكذا

82
00:06:17,770 --> 00:06:20,570
إن كان قد أتى من نفس
،المكان الّذي أتيتُ منه

83
00:06:20,570 --> 00:06:23,510
.واثقة أنّ له ماضٍ مؤلم أيضًا

84
00:06:25,970 --> 00:06:27,950
...أخبرني يا كلود

85
00:06:27,950 --> 00:06:28,920
ماذا؟

86
00:06:28,920 --> 00:06:32,770
لم تتحدّث عن المكان الّذي
.أتيتَ منه من قبل

87
00:06:32,770 --> 00:06:35,340
هل لديك عائلة وأصدقاء هناك؟

88
00:06:36,010 --> 00:06:40,800
.كنتُ أعيش في عاصمة مملكة بيسترونيا

89
00:06:41,370 --> 00:06:43,810
.لكنّ المدينة دُمّرت الآن

90
00:06:44,370 --> 00:06:46,330
...وما عاد رفاقي

91
00:06:46,800 --> 00:06:48,390
...فهمت

92
00:06:48,810 --> 00:06:50,890
.حدث ذلك منذ مدّة

93
00:06:50,890 --> 00:06:56,850
.ما يهمّني الآن هو التّواجد إلى جانبك

94
00:06:57,460 --> 00:06:58,730
...كلود

95
00:07:03,770 --> 00:07:06,610
عفوًا... يا أخي الكبير؟

96
00:07:07,150 --> 00:07:08,270
ماذا؟

97
00:07:08,990 --> 00:07:10,620
...أنا

98
00:07:11,240 --> 00:07:12,590
هل من خطب ما؟

99
00:07:12,590 --> 00:07:14,000
...لقد كنتُ

100
00:07:14,000 --> 00:07:17,790
قالت أنّها تريد تشجيعك
.لأنّك تبذل جهدًا كبيرًا

101
00:07:17,790 --> 00:07:20,560
.سنذهب لتنظيف المكان

102
00:07:20,560 --> 00:07:21,530
...عفوًا

103
00:07:22,190 --> 00:07:23,680
...أنا

104
00:07:24,670 --> 00:07:26,330
...لا أريد

105
00:07:26,330 --> 00:07:28,870
.لا أريدك أن تغادر

106
00:07:33,390 --> 00:07:37,520
،لكن بما أنّي أحبّك كثيرًا

107
00:07:38,240 --> 00:07:40,730
.أريدك أن تفعل ما تريده لنفسك

108
00:07:41,690 --> 00:07:44,180
...لكن... لكن

109
00:07:44,670 --> 00:07:47,460
.ليليان، أنا آسف

110
00:07:47,940 --> 00:07:48,700
...أنا

111
00:07:51,720 --> 00:07:53,290
.لا

112
00:07:53,290 --> 00:07:55,720
.أنا من تتصرّف بأنانيّة هنا

113
00:07:56,510 --> 00:07:59,710
.أنت تبذل جهدًا كبيرًا

114
00:08:05,620 --> 00:08:06,540
.خذ

115
00:08:08,570 --> 00:08:09,820
ما هذا؟

116
00:08:09,820 --> 00:08:11,790
.إنّه سيقلّل من تعبك

117
00:08:11,790 --> 00:08:14,300
.سألتُ الآنسة تانيا عن كيفية صنعه

118
00:08:15,040 --> 00:08:16,190
من أجلي؟

119
00:08:17,300 --> 00:08:23,320
.لا أعرف ما العمل، لكنّي أريد دعمك

120
00:08:24,300 --> 00:08:25,380
.ليليان

121
00:08:26,420 --> 00:08:27,810
.شكرًا لك

122
00:08:32,670 --> 00:08:34,420
!كم هو لذيذ

123
00:08:34,420 --> 00:08:36,170
.شكرًا لك يا ليليان

124
00:08:42,430 --> 00:08:45,910
.لا بأس، لا بأس، أنا سعيدة أيضًا

125
00:08:54,870 --> 00:08:58,100
يُعدّ الحمّام الميزة الوحيدة تقريبًا
.للتّواجد في المنزل

126
00:08:58,540 --> 00:09:02,130
.لكنّي لم أستطع لقاء أبي مذ وصلت

127
00:09:02,590 --> 00:09:05,080
ما الّذي يحدث هنا؟

128
00:09:05,080 --> 00:09:07,810
ظننتُ أنّ هذه مسألة عاجلة؟

129
00:09:07,810 --> 00:09:11,490
لم يصلني أيّ خبر من إيفل
!مذّاك الوقت أيضًا

130
00:09:12,310 --> 00:09:14,430
!يا آنستي الصّغيرة، افتحي الباب رجاءً

131
00:09:14,740 --> 00:09:18,230
!اسمحي لي بمشاهدة التّلّتين الجميلتين رجاءً

132
00:09:18,230 --> 00:09:19,010
!هيّا

133
00:09:19,010 --> 00:09:21,510
!عليكنّ أن تتوسّلنها أيضًا

134
00:09:21,510 --> 00:09:23,460
!حالاً يا كبيرة الخادمات

135
00:09:23,770 --> 00:09:26,400
!رجاءً يا آنستي الصّغيرة

136
00:09:26,400 --> 00:09:29,400
!كنت تنظرين إليهما طوال هذا الوقت

137
00:09:29,400 --> 00:09:31,590
!ذلك ليس كافيًا

138
00:09:31,590 --> 00:09:33,050
!يا آنستي الصّغيرة

139
00:09:33,050 --> 00:09:36,260
!أتوسّل إليك أن تفتحي الباب رجاءً

140
00:09:38,300 --> 00:09:41,790
!اخرسي

141
00:09:43,530 --> 00:09:46,360
.وصل فستانك يا آنستي الصّغيرة

142
00:09:46,360 --> 00:09:48,100
.جرّبي ارتداءه رجاءً

143
00:09:48,100 --> 00:09:49,650
فستان؟

144
00:09:49,650 --> 00:09:51,110
.لن نقيم حفلة

145
00:09:51,110 --> 00:09:53,610
.بل ستكون هنالك حفلة

146
00:09:53,610 --> 00:09:55,120
.إنّ صاحب الجلالة يقيم حفلة بالفعل

147
00:09:57,020 --> 00:10:01,110
.لا يُعقل أنّ هذه هي المهمّة بالغة الأهمّيّة

148
00:10:01,390 --> 00:10:04,110
.ما كنتُ لأعرف إن كانت بالفعل

149
00:10:04,110 --> 00:10:06,870
ما الّذي يفكّر فيه؟

150
00:10:07,990 --> 00:10:12,450
!أب مغفّل

151
00:10:22,130 --> 00:10:23,300
.ها هم

152
00:10:23,710 --> 00:10:26,910
الهدف الوحيد المتبقّي
.هو ذئب الياقوت الفضّيّ

153
00:10:26,910 --> 00:10:28,440
.يبدو ذلك صعبًا جدًّا

154
00:10:30,310 --> 00:10:31,640
ماذا؟

155
00:10:31,640 --> 00:10:33,280
هل من خطب ما؟

156
00:10:35,260 --> 00:10:37,100
.لا يوجد شيء هنا

157
00:10:37,560 --> 00:10:39,480
.هذا مستحيل

158
00:10:42,240 --> 00:10:43,530
!مهلاً! مهلاً

159
00:10:43,530 --> 00:10:45,480
!لا أكنّ أيّ سوء

160
00:10:46,980 --> 00:10:48,250
!إنّها فتاة

161
00:10:48,250 --> 00:10:49,690
!تراجع يا كلود

162
00:10:50,350 --> 00:10:52,350
.أ-أعتذر بشدّة

163
00:10:52,350 --> 00:10:54,240
.ظننتُ أنّك وحش

164
00:10:55,120 --> 00:10:56,790
.أخافني ذلك كثيرًا

165
00:11:00,460 --> 00:11:04,180
.لكنّ خريطة العالم لم تُظهر أيّ شيء

166
00:11:04,610 --> 00:11:06,480
.عليّ تقييمها من باب الحيطة

167
00:11:08,780 --> 00:11:11,480
أيُعقل أنّه يقوم بتقييمي؟

168
00:11:12,250 --> 00:11:14,440
.أنا آسف، لم أدرك أنّك كنت هناك

169
00:11:15,100 --> 00:11:17,340
.لا داعي للقلق

170
00:11:17,760 --> 00:11:18,740
سيّدي هيبيكي؟

171
00:11:19,230 --> 00:11:21,480
لا أعتقد أن هناك أيّ شيء
.غير طبيعيّ بشكل خاصّ

172
00:11:22,650 --> 00:11:24,220
!عجبًا

173
00:11:24,220 --> 00:11:26,790
!واضح لي في الحال أنّك وحشيّ حقيقيّ

174
00:11:26,790 --> 00:11:29,120
.كم هذا صلب

175
00:11:29,410 --> 00:11:30,960
...عـ-عفوًا

176
00:11:31,730 --> 00:11:34,160
.واثقة أنّي قطعتُ هذا

177
00:11:34,160 --> 00:11:35,640
...عفوًا

178
00:11:35,640 --> 00:11:39,250
.عذرًا، أنا مغامِرة من الرّتبة إي واسمي إيفل

179
00:11:39,250 --> 00:11:41,920
.كنتُ أهرب من ذئب ياقوت فضّيّ

180
00:11:41,920 --> 00:11:43,620
ماذا؟ أين؟

181
00:11:43,620 --> 00:11:44,960
هلاّ أخبرتنا؟

182
00:11:44,960 --> 00:11:46,770
.عفوًا، أنا هيبيكي

183
00:11:46,770 --> 00:11:48,640
.وهذان هما كلود وليليان

184
00:11:48,640 --> 00:11:50,340
!سررت بلقائكم

185
00:11:50,340 --> 00:11:53,770
.حسنًا... كان ذلك عميقًا في الغابة

186
00:11:57,500 --> 00:11:58,910
يا آنسة إيفل؟

187
00:12:00,400 --> 00:12:02,400
.عليّ المغادرة الآن

188
00:12:02,990 --> 00:12:04,510
!مع السّلامة

189
00:12:09,300 --> 00:12:10,920
ما كان ذلك؟

190
00:12:11,560 --> 00:12:12,800
...لستُ واثقًا

191
00:12:15,610 --> 00:12:17,530
!إنّه هناك بالفعل

192
00:12:17,530 --> 00:12:20,910
.أظنّ أنّه لم يكن يظهر من قبل

193
00:12:30,430 --> 00:12:33,220
هل وصل إلى هذا الطّريق
المسدود من تلقاء نفسه؟

194
00:12:33,580 --> 00:12:36,310
.أنصحك باستخدام خريطة العالم

195
00:12:36,310 --> 00:12:37,620
ماذا؟ الآن؟

196
00:12:37,620 --> 00:12:40,550
.حسنًا، لا أرى مانعًا من ذلك

197
00:12:43,470 --> 00:12:44,570
ما الّذي يحدث؟

198
00:12:44,570 --> 00:12:47,150
ثمّة ذئاب ياقوت فضّيّ
!منتشرة في كلّ مكان

199
00:12:47,700 --> 00:12:48,550
ماذا؟

200
00:12:55,620 --> 00:12:56,740
!سيّدي هيبيكي

201
00:13:05,710 --> 00:13:09,100
!سيّدي هيبيكي

202
00:13:16,370 --> 00:13:18,000
...هذا الشّعور

203
00:13:18,690 --> 00:13:20,520
.كان ذلك حقيقيًّا

204
00:13:21,510 --> 00:13:24,420
هذا يعني أنّ جزءًا من لعنتك
.قد زال على الأقلّ

205
00:13:24,930 --> 00:13:26,400
ولكن كيف؟

206
00:13:27,850 --> 00:13:29,490
.لا يهمّ

207
00:13:29,490 --> 00:13:31,840
.ما دام سيصير طعامًا

208
00:13:34,780 --> 00:13:37,410
.أعطيته جرعة، لكنّ النّزيف لا يتوقّف

209
00:13:38,070 --> 00:13:39,560
لِمَ لا؟

210
00:13:39,560 --> 00:13:41,220
!أرجوك توقّف

211
00:13:41,520 --> 00:13:44,460
!ليليان، استخدمي تعويذة صيانة الحالة

212
00:13:44,460 --> 00:13:46,210
!سيوقف ذلك النّزيف

213
00:13:46,490 --> 00:13:48,050
!حـ-حسنًا

214
00:13:51,390 --> 00:13:52,800
.لا أصدّق أنّ هذا يحدث

215
00:13:52,800 --> 00:13:56,100
أعدّ سيّدي هيبيكي تلك الجرعة
.باستعمال الكتاب الطّبّيّ

216
00:13:56,380 --> 00:13:58,110
!علينا الخروج من هنا

217
00:13:58,110 --> 00:14:01,090
!على هذا المعدّل، لن ينجو سيّدي هيبيكي

218
00:14:01,350 --> 00:14:04,100
ولكن... أيمكننا الهرب؟

219
00:14:04,520 --> 00:14:07,130
!ليليان، خذي سيّدي هيبيكي إلى البلدة

220
00:14:07,130 --> 00:14:09,610
!أعلم أنّ السّيّد بالس سينقذه

221
00:14:09,610 --> 00:14:11,230
!ولكن ماذا عنك يا سيّد كلو؟

222
00:14:11,230 --> 00:14:12,870
.سأقوم بتعطيلها

223
00:14:12,870 --> 00:14:13,630
!أسرعي

224
00:14:13,900 --> 00:14:17,360
ثمّ ستأتي خلفنا لاحقًا، صحيح؟

225
00:14:17,920 --> 00:14:19,340
!بالطّبع

226
00:14:20,940 --> 00:14:22,280
!غولم الأرض

227
00:14:22,280 --> 00:14:23,860
!شكل الأسد

228
00:14:27,370 --> 00:14:29,460
...لا

229
00:14:29,460 --> 00:14:30,560
!اذهبي

230
00:14:30,890 --> 00:14:32,220
.كلود

231
00:14:32,500 --> 00:14:35,220
!سأحميك مهما كلّف الأمر

232
00:14:45,340 --> 00:14:48,520
.لا يبدو أنّها تكترث لسيّدي هيبيكي وليليان

233
00:14:49,280 --> 00:14:50,610
ماذا يجري؟

234
00:14:50,610 --> 00:14:52,240
.هناك شيء مريب

235
00:14:56,470 --> 00:14:58,120
هل تلاحقني أنا؟

236
00:15:05,110 --> 00:15:06,400
...مستحيل

237
00:15:16,220 --> 00:15:17,610
...أنت

238
00:15:19,310 --> 00:15:21,010
...وأناستازيا

239
00:15:22,050 --> 00:15:24,480
...لا... لنعد

240
00:15:24,890 --> 00:15:25,980
أخي الكبير؟

241
00:15:25,980 --> 00:15:27,910
!ليليان! ثمّة شيء ما خلفنا

242
00:15:29,770 --> 00:15:31,740
!إنّه ذئب زمرّد فضّيّ

243
00:15:41,820 --> 00:15:43,340
!جدار الأرض

244
00:15:55,360 --> 00:15:56,290
!ليليان

245
00:15:57,690 --> 00:15:59,540
!ستار الرّيح

246
00:16:03,260 --> 00:16:07,040
.تفعيل الكتاب الطّبّيّ

247
00:16:07,040 --> 00:16:08,960
.جارٍ تفعيل الكتاب الطّبّيّ

248
00:16:12,630 --> 00:16:15,120
.عرفتُ ذلك. إنّه سمّ دييريث

249
00:16:15,120 --> 00:16:17,730
...الشّفاء... الفائق

250
00:16:17,730 --> 00:16:19,470
.رسالة من سابو

251
00:16:19,470 --> 00:16:23,220
قوّتك الجسديّة والذّهنيّة
.في مستوى غير كافٍ

252
00:16:23,220 --> 00:16:25,480
.ستحتاج المهارة وقتًا حتّى تعمل

253
00:16:28,690 --> 00:16:30,920
!واصلي القتال يا ليليان

254
00:16:31,190 --> 00:16:32,260
.سُحقًا

255
00:16:32,260 --> 00:16:34,360
!تحرّك يا جسدي

256
00:16:34,360 --> 00:16:35,280
...بسرعة

257
00:16:36,660 --> 00:16:38,760
.جارٍ التّحضير للتّفعيل

258
00:16:40,860 --> 00:16:43,650
.إنّ كلود يقاتل وحده الآن

259
00:16:44,750 --> 00:16:46,160
.وليليان أيضًا

260
00:16:46,160 --> 00:16:47,980
...على هذا المعدّل، فإنّ الجميع سوف

261
00:16:48,640 --> 00:16:50,660
!تحرّك! تحرّك رجاءً! أريد أن أتحرّك

262
00:16:50,660 --> 00:16:52,660
!أنقذهم جميعًا

263
00:16:53,040 --> 00:16:54,860
.رسالة من سابو

264
00:16:54,860 --> 00:16:58,160
.عين الخبير والمرحلة التّعليميّة تعملان الآن

265
00:17:00,120 --> 00:17:03,180
.الشّفاء الفائق جاهز للتّفعيل الآن

266
00:17:03,180 --> 00:17:06,190
.ا-الشّفاء الفائق

267
00:17:07,320 --> 00:17:09,330
.تمّت إزالة السّمّ

268
00:17:09,330 --> 00:17:10,080
.حسنًا

269
00:17:10,080 --> 00:17:11,550
!أخي الكبير

270
00:17:11,550 --> 00:17:13,300
.رسالة من سابو

271
00:17:13,300 --> 00:17:16,830
أوصي باستعمال "استدعاء
.وحش مقدّس" في الحال

272
00:17:19,980 --> 00:17:21,960
!حاضر، مع أنّي لا أعرف ما ذلك

273
00:17:21,960 --> 00:17:24,050
!استدعاء وحش مقدّس

274
00:17:36,210 --> 00:17:37,950
!هذا وحش مقدّس؟

275
00:17:40,960 --> 00:17:43,950
.أُمرتِ إذًا بقتلنا

276
00:17:44,370 --> 00:17:46,320
.لكنّ هذه هي النّهاية

277
00:17:48,090 --> 00:17:52,710
!اسمي فينيتزيليانوستور فيراتيانو

278
00:17:53,270 --> 00:17:55,930
.أنا وحش البرق المقدّس

279
00:17:55,930 --> 00:17:59,730
أخدم إلهة السّحر العظيمة
!وأنا مسؤول عن إنزال الأحكام

280
00:18:00,450 --> 00:18:04,540
!وعقوبة مهاجمة سيّدي هي مليون موت

281
00:18:04,540 --> 00:18:08,700
!ستُباد أجسادك وأرواحك بالكامل

282
00:18:08,700 --> 00:18:13,300
!عقابك الأخير هو حُكم الهلاك

283
00:18:26,630 --> 00:18:28,940
.أنتما في أمان الآن

284
00:18:28,940 --> 00:18:32,210
أهذا أنت يا فيني...؟

285
00:18:33,230 --> 00:18:35,200
.نعم. هذا أنا

286
00:18:35,610 --> 00:18:39,830
والآن، بسبب— بفضل مهارتك
،لاستدعاء الوحش المقدّس

287
00:18:39,830 --> 00:18:43,110
.استعدتُ قوّتي الحقيقيّة بشكل مؤقّت

288
00:18:44,700 --> 00:18:48,650
في هذه الهيئة، بإمكانك هزيمة
ذلك الذّئب الضّخم أيضًا، صحيح؟

289
00:18:48,650 --> 00:18:50,800
!لنعد إلى كلود

290
00:18:51,620 --> 00:18:53,090
.لا يمكننا ذلك

291
00:18:58,650 --> 00:19:00,330
.انتهى الوقت

292
00:19:00,690 --> 00:19:02,900
ألا يمكننا القيام بذلك ثانية فحسب؟

293
00:19:02,900 --> 00:19:07,310
سيستغرق الأمر بعض الوقت قبل أن يتمّ
.تفعيل استدعاء الوحش المقدّس مرّة أخرى

294
00:19:07,310 --> 00:19:08,390
.فهمت

295
00:19:08,900 --> 00:19:11,330
إذًا، أعتقد أنّنا سنضطرّ إلى القيام
.بشيء ما بأنفسنا فحسب

296
00:19:11,610 --> 00:19:15,520
!إنّ ما هاجمك هو ذئب ألماس فضّيّ

297
00:19:15,520 --> 00:19:18,330
.لا فرصة لديك أمامه

298
00:19:18,620 --> 00:19:21,300
!بل ذلك سبب إضافيّ للعودة

299
00:19:27,730 --> 00:19:29,050
.أنت جادّ

300
00:19:29,450 --> 00:19:33,690
،واثق أنّ كلود يريد حمايتنا

301
00:19:34,640 --> 00:19:37,080
!لكنّي أريد حمايته أيضًا

302
00:19:38,660 --> 00:19:40,290
.لا أريد أن أخسره

303
00:19:40,290 --> 00:19:42,070
!إنّه صديق عزيز

304
00:19:43,080 --> 00:19:46,720
.أخي الكبير، سأساعد السّيّد كلو أيضًا

305
00:19:46,720 --> 00:19:48,890
!نعم! لنذهب معًا

306
00:19:48,890 --> 00:19:49,830
!حاضرة

307
00:19:49,830 --> 00:19:51,890
.رسالة من سابو

308
00:19:51,890 --> 00:19:54,950
.أوصي باستعمال عصا إله الطّبّ

309
00:19:55,240 --> 00:19:56,340
ما الأمر؟

310
00:19:56,340 --> 00:20:00,420
يبدو أنّي اكتسبتُ شيئًا
.يسمّى عصا إله الطّبّ

311
00:20:00,720 --> 00:20:02,750
!ماذا قلت؟

312
00:20:03,170 --> 00:20:04,750
ما هذه المهارة؟

313
00:20:05,270 --> 00:20:07,480
.رُتبة النُّدرة س س

314
00:20:07,480 --> 00:20:11,870
إنّها تشفي كلّ أشكال الحياة
.بالكامل ضمن نطاق معيّن

315
00:20:11,870 --> 00:20:14,220
...ولكن، عندما تُستعمل

316
00:20:13,650 --> 00:20:14,580
!سأستعملها

317
00:20:14,580 --> 00:20:16,700
!تفعيل عصا إله الطّبّ

318
00:20:18,050 --> 00:20:20,520
!جارٍ تفعيل عصا إله الطّبّ

319
00:20:23,090 --> 00:20:24,450
!هذا مذهل

320
00:20:24,450 --> 00:20:26,030
!لستُ متعبة بعد الآن

321
00:20:26,410 --> 00:20:28,030
!كان ذلك مبالغًا فيه

322
00:20:36,750 --> 00:20:38,230
ما هذا؟

323
00:20:38,230 --> 00:20:40,970
!...هذا

324
00:20:42,130 --> 00:20:44,420
!لا تستهن به على الإطلاق

325
00:20:44,420 --> 00:20:46,450
.رسالة من سابو

326
00:20:46,450 --> 00:20:49,210
.اكتسبتَ مهارة رماية الأرواح

327
00:20:49,210 --> 00:20:50,830
رماية الأرواح؟

328
00:20:53,950 --> 00:20:57,310
أليست نفس ما استعملته إماليا؟

329
00:20:57,310 --> 00:20:58,450
...إذًا هذا يعني

330
00:21:07,180 --> 00:21:09,600
.ماذا...؟ هذا مذهل

331
00:21:10,090 --> 00:21:11,180
.تقييم

332
00:21:12,120 --> 00:21:14,900
القوس الإلهيّ [القوس المتوهّج]"؟"

333
00:21:14,900 --> 00:21:17,200
.قوس مخصّص لهيبيكي مانابي فقط

334
00:21:17,200 --> 00:21:18,120
ماذا...؟

335
00:21:18,430 --> 00:21:20,490
!هذا رائع جدًّا يا أخي

336
00:21:20,900 --> 00:21:23,370
.لا أصدّق هذا

337
00:21:23,720 --> 00:21:25,850
!بإمكاني القتال الآن

338
00:21:25,850 --> 00:21:28,390
!لنعد إلى كلود

339
00:21:35,300 --> 00:21:38,180
.شكرًا على إيقاظي يا إلهة السّحر

340
00:21:38,180 --> 00:21:39,580
.لا داعي لشكري

341
00:21:40,010 --> 00:21:43,940
في كلّ الأحوال، ألا ترى أنّك
تُنعم عليه بالكثير من البركات؟

342
00:21:43,940 --> 00:21:47,840
.أنت أيضًا أعرته قوّتك

343
00:21:47,840 --> 00:21:53,730
إضافة إلى ذلك، فإنّ قدرته على استخدامها
.بشكل جيّد من عدمها تعتمد عليه كليًّا

344
00:23:25,740 --> 00:23:28,460
!كان سيّدي رائعًا جدًّا

345
00:23:28,460 --> 00:23:31,670
سيكون من المفيد بالتّأكيد لو استطعت
.دائمًا استخدام قوّتك الحقيقيّة

346
00:23:31,670 --> 00:23:36,560
لا يمكنني ذلك! تخفيف التّوتّر عن الجميع
!وأنا في هيئة قطّ هو أيضًا واجب مهمّ

347
00:23:36,560 --> 00:23:37,960
لا تملك القوّة، صحيح؟

348
00:23:37,960 --> 00:23:38,850
!ماذا؟