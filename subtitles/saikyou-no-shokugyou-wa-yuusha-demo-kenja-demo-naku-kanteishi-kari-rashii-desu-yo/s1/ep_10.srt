1
00:00:01,110 --> 00:00:03,510
.لا يمكن محو الماضي مهما حدث

2
00:00:04,030 --> 00:00:06,480
.ولا الأخطاء الّتي ارتكبناها

3
00:00:07,290 --> 00:00:10,990
ولهذا السّبب تحديدًا لن أدعك
.تموت يا هيبيكي

4
00:00:11,450 --> 00:00:15,580
.أريدك حقًّا أن تنجو وتجد السّعادة

5
00:00:16,130 --> 00:00:19,080
،حتّى إذا استيقظتْ أخيرًا من سباتها

6
00:00:19,080 --> 00:00:20,420
...فإنّ هذا العالم لن

7
00:00:21,420 --> 00:00:23,820
.يُدمّر

8
00:02:00,320 --> 00:02:02,200
ما الّذي تفكّر فيه؟

9
00:02:02,200 --> 00:02:05,160
لماذا هذين الطّفلين بصحبتك؟

10
00:02:05,720 --> 00:02:07,980
لا تقل أنّهما طُعم للوحوش
!...في الدّيماس

11
00:02:07,980 --> 00:02:11,120
هل تحاول السّخرية منّي؟

12
00:02:12,260 --> 00:02:13,980
.تمهّل يا كلود

13
00:02:13,980 --> 00:02:15,130
!أنت مخطئ تمامًا

14
00:02:15,130 --> 00:02:17,470
!قد يبدو صغيرًا، لكنّه في الواقع بالغ

15
00:02:17,470 --> 00:02:19,270
...إنّ أخي... إنّ أخي

16
00:02:19,270 --> 00:02:21,730
!صغير الحجم فحسب

17
00:02:21,730 --> 00:02:26,220
...صغير

18
00:02:27,010 --> 00:02:29,740
.هذه أوراقي من النّقابة

19
00:02:34,390 --> 00:02:35,910
!يمكنكم المرور

20
00:02:37,100 --> 00:02:39,820
.سأرى هيبيكي قريبًا

21
00:02:39,820 --> 00:02:41,870
،قال أنّه سيصبح مغامرًا

22
00:02:41,870 --> 00:02:44,350
.لذا ربّما يكون في فرقة مع أحدهم الآن

23
00:02:44,350 --> 00:02:46,840
لـ-لكن ربّما...؟

24
00:02:47,190 --> 00:02:49,790
.أتمنّى لو أستطيع رؤية إماليا قريبًا

25
00:02:49,790 --> 00:02:52,130
.إنّها جميلة جدًّا ولطيفة وجديرة بالثّقة

26
00:02:52,130 --> 00:02:55,840
.ناهيك عن أنّها أوّل صديقة لي في رويل

27
00:02:55,840 --> 00:02:58,240
...رويل... رويل

28
00:02:59,700 --> 00:03:03,460
.هذا ما يقوله وهو ينتظرني

29
00:03:10,000 --> 00:03:11,300
...هذه

30
00:03:13,750 --> 00:03:14,790
.شكرًا لك

31
00:03:23,500 --> 00:03:24,460
!إيفيل

32
00:03:29,430 --> 00:03:35,910
من المعتاد أن تبدأ المشاكل فور
.دخولك المدينة يا سيّدي

33
00:03:35,910 --> 00:03:38,530
.هذا هو حالنا جميعًا الآن

34
00:03:38,530 --> 00:03:39,640
.سيّدي هيبيكي

35
00:03:39,980 --> 00:03:43,450
.هناك أمرٌ يجب علينا فعله قبل الانطلاق

36
00:03:43,450 --> 00:03:46,400
علينا كتابة خطّة رحلة
.لكيفية التّغلّب على الدّيماس

37
00:03:46,670 --> 00:03:48,050
خطّة رحلة؟

38
00:03:48,050 --> 00:03:48,700
.نعم

39
00:03:49,100 --> 00:03:55,230
على من هم دون الرّتبة سي تسجيل
.المدّة التّقديريّة والحصول على إذن

40
00:03:56,330 --> 00:04:01,710
تريد النّقابة إيقاف المغامرين
.المتهوّرين وتقليل الخسائر

41
00:04:01,970 --> 00:04:03,390
.فهمت

42
00:04:03,390 --> 00:04:07,480
لكن هل يمكننا وضع خطّة رحلة
ونحن لا نعرف حتّى ما سيحدث؟

43
00:04:07,480 --> 00:04:09,970
.لدينا فكرة عامّة

44
00:04:09,970 --> 00:04:11,190
فعلاً...؟

45
00:04:12,040 --> 00:04:17,060
.حسنًا، أودّ محاولة وضعها
أيمكنني ذلك؟

46
00:04:17,060 --> 00:04:18,110
ماذا؟

47
00:04:19,570 --> 00:04:21,730
.نعم. يبدو ذلك جيّدًا

48
00:04:23,930 --> 00:04:26,610
،كلّما توغّلنا في الدّيماس

49
00:04:26,610 --> 00:04:28,400
.ازدادت مستويات أعدائنا

50
00:04:28,400 --> 00:04:30,780
.يحتوي الدّيماس الشّماليّ على 30 طابقًا

51
00:04:31,210 --> 00:04:33,750
.هناك معركة مع زعيم بعد كلّ 10 طوابق

52
00:04:34,340 --> 00:04:38,590
وسمعت أنّ الزّعيم في الطّابق
.العاشر هو ذئب زمرّد فضّيّ

53
00:04:39,040 --> 00:04:43,680
وإذا بدأنا بالعكس من هناك، يمكننا
.وضع خطّة للطّوابق العشرة الأولى

54
00:04:43,680 --> 00:04:47,260
،وإذا واجهتك أيّ مشكلة
.فلا تتردّدي في السّؤال في أيّ وقت

55
00:04:47,540 --> 00:04:48,790
.مفهوم

56
00:04:49,140 --> 00:04:50,880
!سأعمل بجدّ في وضع الخطّة

57
00:04:50,880 --> 00:04:53,640
!استريحا جيّدًا

58
00:04:54,010 --> 00:04:56,060
.نحن نعتمد عليك يا ليليان

59
00:04:57,310 --> 00:04:59,920
لقد كبرت ليليان حقًّا، أليس كذلك؟

60
00:04:59,920 --> 00:05:01,150
.أوافقك

61
00:05:01,150 --> 00:05:05,660
.لا بدّ أنّها تريد مساعدتك قدر استطاعتها

62
00:05:05,660 --> 00:05:08,380
.إنّها تساعد كثيرًا بالفعل

63
00:05:08,380 --> 00:05:11,660
.حسنًا، لنتأكّد ممّا نأخذه معنا

64
00:05:11,660 --> 00:05:13,030
.حسنًا

65
00:05:13,030 --> 00:05:16,660
لقد حصلنا بالفعل على أسلحة
،ودروع في رويل

66
00:05:17,070 --> 00:05:20,090
.ويمكنك صنع جرعات باستخدام مهارتك

67
00:05:20,090 --> 00:05:23,080
...بعد ذلك، ما زلنا بحاجة إلى طعام و

68
00:05:23,750 --> 00:05:25,670
!نسيت شيئًا مهمًّا جدًّا

69
00:05:25,670 --> 00:05:26,920
ما هو؟

70
00:05:28,700 --> 00:05:29,920
.ملابس داخليّة

71
00:05:31,170 --> 00:05:32,400
...ملابس داخليّة

72
00:05:32,940 --> 00:05:34,310
أنت ترتديها، صحيح؟

73
00:05:35,780 --> 00:05:36,820
.نعم

74
00:05:36,820 --> 00:05:38,430
.أنت تفهم إذًا

75
00:05:38,840 --> 00:05:41,470
،بمجرّد دخولنا الدّيماس
،لن نتمكّن من غسل الملابس

76
00:05:41,470 --> 00:05:44,100
وإذا لم نتمكّن من تغيير ملابسنا
.الدّاخليّة، فسيكون ذلك مقرفًا جدًّا

77
00:05:44,690 --> 00:05:46,420
ماذا؟

78
00:05:47,980 --> 00:05:51,930
ألن يكون من الأنسب استخدام
،الغسيل الفقاعيّ بدلاً من تغييرها

79
00:05:51,930 --> 00:05:53,450
كما كنّا نفعل؟

80
00:05:53,700 --> 00:05:55,690
.لكنّ هذا سحر

81
00:05:55,690 --> 00:05:59,440
أشعر أنّ التّنظيف بالماء يختلف
.تمامًا عن التّنظيف بالسّحر

82
00:05:59,440 --> 00:06:02,400
لكنّ تأثير الغسل بالماء
.أو السّحر هو نفسه

83
00:06:02,400 --> 00:06:04,450
.نحن لا نتحدّث عن النّتائج هنا

84
00:06:04,450 --> 00:06:06,510
!أتحدّث عن الشّعور

85
00:06:06,510 --> 00:06:09,000
!أريد حقًّا أن أرتدي ملابس داخليّة نظيفة

86
00:06:09,730 --> 00:06:11,970
.يمكنني أن أعيرك مئزري

87
00:06:12,200 --> 00:06:14,020
!أنا ولد عصريّ

88
00:06:14,020 --> 00:06:15,930
!لا أستطيع القتال بدون ملابسي الدّاخليّة

89
00:06:16,170 --> 00:06:18,430
إذًا لماذا لا تشتري المزيد؟

90
00:06:18,770 --> 00:06:21,620
.لكنّها غير متوفّرة في أيّ مكان هنا

91
00:06:21,620 --> 00:06:24,110
،أشعر أنّها ألطف من المآزر

92
00:06:24,110 --> 00:06:25,360
.لذا لا أفهم

93
00:06:25,360 --> 00:06:26,940
!اشرح لي رجاءً يا سابو

94
00:06:26,940 --> 00:06:28,970
.رسالة من سابو

95
00:06:28,970 --> 00:06:30,940
،ليس لديّ أيّ فكرة عن شعور ارتدائها

96
00:06:30,940 --> 00:06:34,060
.لا أستطيع الرّدّ على سؤال كهذا

97
00:06:34,060 --> 00:06:35,450
.انتهت رسالة سابو

98
00:06:35,450 --> 00:06:38,780
.فهمت، سابو فتاة إذًا

99
00:06:38,780 --> 00:06:42,330
...كان عليّ أن أحزر ذلك من صوتها سلفًا

100
00:06:42,330 --> 00:06:45,450
مهلاً، ألا يعني هذا أنّها رأتني
في مواقف سيّئة كثيرة؟

101
00:06:46,310 --> 00:06:49,030
أقلتَ مواقف سيّئة؟

102
00:06:49,760 --> 00:06:52,970
،إذا كنتَ تريد ملابس داخليّة
.فاستخدم ذلك فحسب

103
00:06:52,970 --> 00:06:54,290
أستخدم ماذا؟

104
00:06:54,290 --> 00:06:56,710
.استخدم عقلك قليلاً

105
00:06:56,710 --> 00:07:00,110
،لديك كلّ تلك المهارات
.لكنّك تُهمل أهمّ ما تملك

106
00:07:00,110 --> 00:07:02,210
!صحيح، نسيت ذلك

107
00:07:03,270 --> 00:07:06,460
!نسخ ولصق

108
00:07:08,180 --> 00:07:09,860
!الكثير رجاءً

109
00:07:13,440 --> 00:07:16,490
...كان بإمكانك فعل ذلك بعد غسلها

110
00:07:23,690 --> 00:07:25,970
.يُعيد لي هذا ذكريات سيّئة

111
00:07:25,970 --> 00:07:27,470
...مع أنّي لا أتذكّر جيّدًا، ولكن

112
00:07:30,760 --> 00:07:33,530
.ليس هذا وقت مناسب للخوف من الأشباح

113
00:07:33,530 --> 00:07:35,170
.إيفيل في خطر

114
00:07:41,890 --> 00:07:44,970
.تبدو كفؤًا جدًّا

115
00:07:45,460 --> 00:07:47,230
.تعال

116
00:07:51,810 --> 00:07:53,270
!إيفيل، ابتعدي

117
00:07:57,790 --> 00:08:00,050
!أنقذيني

118
00:08:19,730 --> 00:08:23,170
.كما توقّعت، ستكون مفيدًا جدًّا

119
00:08:23,170 --> 00:08:24,320
.هذا يكفي

120
00:08:25,420 --> 00:08:26,600
ما الّذي يحدث؟

121
00:08:26,600 --> 00:08:29,060
.إنّه رفيقي

122
00:08:30,040 --> 00:08:33,060
ماذا تحاولين فعله بالسّيطرة على الوحوش؟

123
00:08:33,680 --> 00:08:36,130
.أريد السّلام العالميّ

124
00:08:36,750 --> 00:08:38,570
.أنا جادّة

125
00:08:40,020 --> 00:08:41,840
.لا أصدّقك

126
00:08:42,090 --> 00:08:44,920
.سماع هذا من صديقة محزن جدًّا

127
00:08:48,700 --> 00:08:51,290
ما زلت تعتقدين أنّنا صديقتين؟

128
00:08:51,290 --> 00:08:53,830
.لا أحد يتجاوز العجائز في الحُمق

129
00:08:53,030 --> 00:08:54,810
.عمري 56 سنة فحسب

130
00:08:55,590 --> 00:08:57,450
!عمري 56 سنة

131
00:08:57,450 --> 00:09:03,090
بعد 56 عامًا طويلة، ظننت أنّني
!أخيرًا وجدت صديقتي الأولى

132
00:09:03,740 --> 00:09:04,750
ما هذا؟

133
00:09:04,750 --> 00:09:05,990
!أنسيت؟

134
00:09:05,990 --> 00:09:07,500
!رمز صداقتنا

135
00:09:07,500 --> 00:09:10,200
.فهمت

136
00:09:10,200 --> 00:09:12,230
.لهذا عرفتِ مكاني

137
00:09:29,360 --> 00:09:30,880
.لن أغفر لك هذا

138
00:09:30,880 --> 00:09:33,390
هل تستطيعين قتلي من الأساس؟

139
00:09:33,660 --> 00:09:35,210
!لا تستهيني بي

140
00:09:39,050 --> 00:09:41,020
!قاطع الرّياح

141
00:09:52,510 --> 00:09:54,460
...يا إلهي

142
00:09:54,460 --> 00:09:58,780
أقع في المشاكل عندما أقاتل
...شخصًا آخر غير هدفي

143
00:09:59,410 --> 00:10:02,400
.أنت مزعجة حقًّا

144
00:10:03,200 --> 00:10:05,470
.وليّنة

145
00:10:20,240 --> 00:10:23,320
.أنت هو السّيّد هيبيكي، المغامر من الرّتبة دي

146
00:10:23,320 --> 00:10:26,920
هل يمكنني رؤية خطّة رحلتكم رجاءً؟

147
00:10:26,920 --> 00:10:28,080
!تفضّلي

148
00:10:29,580 --> 00:10:34,740
...حسنًا، حسنًا، حسنًا

149
00:10:35,190 --> 00:10:37,450
...فهمت، فهمت

150
00:10:40,750 --> 00:10:43,500
.هذه خطّة رائعة حقًّا

151
00:10:43,500 --> 00:10:45,030
...هذا يعني

152
00:10:45,340 --> 00:10:48,450
.أنا أمنحكم الإذن بالدّخول للدّيماس

153
00:10:48,690 --> 00:10:51,070
!هذا رائع يا ليليان

154
00:10:51,070 --> 00:10:52,360
!شكرًا لك

155
00:10:52,840 --> 00:10:55,570
.هذا مدخل الدّيماس

156
00:10:55,570 --> 00:10:58,810
.سأدعو لعودتكم سالمين

157
00:10:58,810 --> 00:11:02,020
.حظًّا موفّقًا، وتذكّروا: السّلامة أوّلاً

158
00:11:02,020 --> 00:11:02,840
!نعم

159
00:11:03,160 --> 00:11:04,490
.نحن هنا أخيرًا

160
00:11:04,490 --> 00:11:08,600
علينا اجتياز الدّيماس للوصول
.إلى مدينة تيرا دايناس تحت الأرض

161
00:11:09,780 --> 00:11:11,850
هل الجميع مستعدّون؟

162
00:11:11,850 --> 00:11:15,110
أنا مستعدّ. وأنت يا ليليان؟

163
00:11:15,300 --> 00:11:17,350
.أنا مستعدّة في أيّ وقت

164
00:11:17,350 --> 00:11:18,670
صحيح يا معلّم؟

165
00:11:18,670 --> 00:11:20,110
!بالطّبع

166
00:11:20,290 --> 00:11:21,980
.لنذهب إذًا

167
00:11:26,320 --> 00:11:28,590
.يبدو أنّه لا يوجد أعداء هنا

168
00:11:28,590 --> 00:11:32,970
في الوقت الحاليّ، علينا أن نحاول المضيّ
.قدمًا دون استخدام خريطة العالم

169
00:11:33,830 --> 00:11:38,440
،إذا اعتمدت عليها كثيرًا
.فلن تكتسب أبدًا حسّ الخطر

170
00:11:38,440 --> 00:11:40,080
.هذا أيضًا جزء من تدريبك

171
00:11:40,080 --> 00:11:42,480
.ها هو ذا، رقيب الجحيم

172
00:11:42,480 --> 00:11:44,380
.حـ-حسنًا

173
00:11:44,380 --> 00:11:46,000
.رسالة من سابو

174
00:11:46,000 --> 00:11:49,910
انخفضت نسبة التّواصل مع
.٪السّلطة الإلهيّة بنسبة 15

175
00:11:49,910 --> 00:11:52,590
.نعم، كنت أتوقّع ذلك نوعًا ما

176
00:11:52,590 --> 00:11:54,870
هل كان هذا صوت الإله الأعلى؟

177
00:11:54,870 --> 00:11:57,600
.لم أسمع ما قاله بوضوح

178
00:11:57,600 --> 00:11:58,370
!سيّدي هيبيكي

179
00:11:58,370 --> 00:11:59,710
ما... ماذا؟

180
00:11:59,710 --> 00:12:03,070
.لا يمكنك أن تشرد لحظة دخولنا الدّيماس

181
00:12:03,430 --> 00:12:06,340
.مجرّد تهاونك للحظة قد يكلّفك حياتك

182
00:12:06,340 --> 00:12:07,570
.كن حذرًا من فضلك

183
00:12:07,570 --> 00:12:09,300
.آ-آسف

184
00:12:09,300 --> 00:12:10,630
.سأكون حذرًا

185
00:12:11,070 --> 00:12:14,080
حسنًا... ماذا أنا؟

186
00:12:15,350 --> 00:12:17,140
ماذا تقصد بـ"ماذا الآن"؟

187
00:12:17,140 --> 00:12:18,550
.يا إلهة السّحر

188
00:12:19,070 --> 00:12:21,580
،إن كانت هذه دعوة رومانسيّة
—فانتظري حتّى اللّيل

189
00:12:24,360 --> 00:12:25,620
.على مهلك

190
00:12:25,620 --> 00:12:27,200
!كانت مجرّد مزحة، مزحة

191
00:12:27,200 --> 00:12:29,750
.توقّفي رجاءً

192
00:12:30,140 --> 00:12:31,270
وبعد؟

193
00:12:31,270 --> 00:12:37,230
.إذًا، ذهب ذلك الطّفل إلى الدّيماس

194
00:12:37,230 --> 00:12:38,700
...مقرف

195
00:12:38,700 --> 00:12:42,510
لحظة، هل تقصده بقولك "ذلك الطّفل"؟

196
00:12:42,510 --> 00:12:46,940
حتّى مع مهاراتنا، أليس في خطر
نظرًا لإحصائيّاته الحاليّة؟

197
00:12:46,940 --> 00:12:49,340
،يريد اجتياز الدّيماس

198
00:12:49,340 --> 00:12:53,590
والوصول إلى الحكماء في المدينة تحت الأرض
.وسؤالهم عن كيفية العودة إلى عالمه

199
00:12:53,590 --> 00:12:54,680
ماذا؟

200
00:12:54,680 --> 00:12:56,450
عمّ تتحدّث؟

201
00:12:57,590 --> 00:12:59,880
.هذا ما قالوه

202
00:12:59,880 --> 00:13:02,580
فلماذا لم توقفه إذًا؟

203
00:13:02,580 --> 00:13:04,490
...لماذا لم تخبره أنّ الحكماء لا يعلمون

204
00:13:04,490 --> 00:13:08,060
وأنّه لا توجد طريقة للعودة إلى عالمه؟

205
00:13:08,060 --> 00:13:12,120
،كما تعلمين، ليس لديّ أيّ نيّة لتركه يموت

206
00:13:12,120 --> 00:13:15,020
،لكن في الوقت نفسه
.لا أريد السّيطرة عليه أيضًا

207
00:13:15,020 --> 00:13:17,630
لن تكون تلك حياة ممتعة، أليس كذلك؟

208
00:13:18,600 --> 00:13:19,900
...يحدث هذا ثانية

209
00:13:19,900 --> 00:13:23,480
لماذا أنا قلقة على ذلك الفتى؟

210
00:13:23,480 --> 00:13:27,980
أقالت "لا توجد طريقة
للعودة إلى عالمه"؟

211
00:13:27,980 --> 00:13:33,990
صحيح، على الأقلّ، "إنّها غير
."موجودة في ذاكرتك الحاليّة

212
00:13:34,550 --> 00:13:37,770
منذ دخوله الدّيماس، أصبح
،من الصّعب جعله يسمعني

213
00:13:37,770 --> 00:13:39,720
.لكنّني أستطيع أن أشعر بمكانه

214
00:13:39,720 --> 00:13:42,200
.لم ينقطع اتّصالي به

215
00:13:42,200 --> 00:13:44,510
.متأكّد أنّ الأمور ستسير على ما يرام

216
00:13:44,510 --> 00:13:47,460
على أيّ حال، ما الّذي أتى بك إلى هنا؟

217
00:13:47,460 --> 00:13:49,570
.لأدعوك لشرب الشّاي

218
00:13:49,570 --> 00:13:50,600
.سأعتذر

219
00:13:50,600 --> 00:13:52,110
.المضيفة هي إلهة الطّبّ

220
00:13:52,110 --> 00:13:54,900
إلهة الطّبّ؟

221
00:13:57,860 --> 00:13:59,150
!هيّا بنا

222
00:13:59,150 --> 00:14:01,360
!يا لها من ردّة فعل مختلفة

223
00:14:01,690 --> 00:14:04,320
!ذلك الصّدر الكبير يشفيني

224
00:14:04,320 --> 00:14:06,230
!يشفيني

225
00:14:17,550 --> 00:14:19,040
!انتبهوا يا رفاق

226
00:14:22,730 --> 00:14:24,960
!ذلك وحش سلايم بالتّأكيد

227
00:14:24,960 --> 00:14:26,540
صحيح يا سابو؟

228
00:14:26,540 --> 00:14:28,410
.هذه بركة ماء عاديّة

229
00:14:28,410 --> 00:14:30,590
.وانتبه أيضًا لما يحدث فوقكم

230
00:14:35,980 --> 00:14:37,830
لماذا تتصرّف بجبن هكذا؟

231
00:14:37,830 --> 00:14:39,930
.أره ثمار تدريبك

232
00:14:40,330 --> 00:14:41,340
.صحيح

233
00:14:42,350 --> 00:14:46,580
!هذا أوّل سحر هجوميّ اكتسبتُه

234
00:14:46,580 --> 00:14:48,740
!نار

235
00:14:53,610 --> 00:14:54,760
.هذا غريب

236
00:14:54,760 --> 00:14:56,770
!هل هي جثّة؟

237
00:14:56,770 --> 00:14:58,170
.إنّه طريق مسدود

238
00:14:58,170 --> 00:15:00,300
أنا متأكّد تمامًا أنّه لم يكن
.هناك طريق آخر

239
00:15:00,580 --> 00:15:04,660
.يبدو هذا الجدار غريبًا بعض الشّيء

240
00:15:04,660 --> 00:15:06,300
.تفضّل بتقييمه رجاءً يا سيّدي هيبيكي

241
00:15:06,480 --> 00:15:07,570
.حاضر

242
00:15:07,570 --> 00:15:08,640
.تقييم

243
00:15:09,560 --> 00:15:11,130
.إنّه وحش

244
00:15:11,130 --> 00:15:13,300
شيء يُدعى "الصّخرة المغلقة"؟

245
00:15:13,300 --> 00:15:14,540
.هكذا إذًا

246
00:15:14,540 --> 00:15:16,970
.لم أكن أتوقّع هذا في الطّابق الأوّل

247
00:15:16,970 --> 00:15:19,270
...لا يُجدي رمحي نفعًا ضدّ هذا

248
00:15:23,070 --> 00:15:26,360
.أستطيع اختراقه، لكنّني لا أستطيع تدميره

249
00:15:26,360 --> 00:15:29,900
نحتاج إلى شيء يُلحق ضررًا كبيرًا
.بمنطقة واسعة، بدلاً من نقطة واحدة

250
00:15:30,520 --> 00:15:33,450
ربّما سلاح ليليان سيكون مناسبًا إذًا؟

251
00:15:33,450 --> 00:15:34,690
سلاحي؟

252
00:15:34,690 --> 00:15:36,420
!هذا صحيح

253
00:15:36,420 --> 00:15:40,420
وجّهي له ضربة قويّة وأسقطيه
!أرضًا بضربة واحدة

254
00:15:40,420 --> 00:15:41,490
!حسنًا

255
00:15:51,530 --> 00:15:52,830
.مذهل

256
00:15:52,830 --> 00:15:56,540
ذروة قوّتها الهجوميّة أعلى
.من قوّتي حاليًّا

257
00:15:56,540 --> 00:15:59,350
.هذا مذهل يا ليليان

258
00:15:59,720 --> 00:16:01,260
!هذا صحيح

259
00:16:01,260 --> 00:16:03,100
.لنواصل التّقدّم

260
00:16:03,100 --> 00:16:07,080
.لكنّ الدّياميس أماكن غريبة بالفعل

261
00:16:07,080 --> 00:16:09,020
من أنشأ هذا؟

262
00:16:09,020 --> 00:16:13,410
.حتّى أنا لا أعرف من أنشأه أو لأيّ غرض

263
00:16:13,410 --> 00:16:14,580
فعلاً؟

264
00:16:14,950 --> 00:16:17,080
،لكنّه مليء بالفخاخ والوحوش

265
00:16:17,080 --> 00:16:21,370
لذا يمكنك التّأكّد من
.أنّ شخصًا لئيمًا أنشأه

266
00:16:22,150 --> 00:16:23,320
.يبدو هذا منطقيًّا

267
00:16:24,870 --> 00:16:26,670
.رسالة من سابو

268
00:16:26,670 --> 00:16:30,260
انخفضت نسبة التّواصل مع
.٪السّلطة الإلهيّة بنسبة 17

269
00:16:30,260 --> 00:16:34,090
من المحتمل أن تنخفض
.بنسبة 25٪ بشكل مجمل

270
00:16:34,090 --> 00:16:36,220
...مهلاً، ما معنى هذا بالضّبط

271
00:16:36,490 --> 00:16:37,310
!سيّدي هيبيكي

272
00:16:37,310 --> 00:16:38,220
!عدوّ

273
00:16:42,160 --> 00:16:43,220
!تقييم

274
00:16:43,840 --> 00:16:47,730
إنّها من المستويات 12 و18
!و15 ابتداءً من اليسار

275
00:16:48,000 --> 00:16:49,740
.سأقضي على الاثنين على اليمين

276
00:16:49,740 --> 00:16:51,690
!اهتمّ رجاءً بالّذي على اليسار

277
00:16:51,690 --> 00:16:53,000
!حاضر

278
00:16:53,000 --> 00:16:54,850
!عين الخبير، تفعيل

279
00:16:54,850 --> 00:16:57,080
.لديك فرصة 65٪ للإصابة

280
00:16:57,080 --> 00:16:57,620
ماذا؟

281
00:16:59,350 --> 00:17:01,400
.هذا هو الحدّ الأقصى لمساعدة التّصويب

282
00:17:01,400 --> 00:17:03,360
!قاطع الرّياح

283
00:17:06,680 --> 00:17:08,970
.شكرًا. لقد أنقذتني

284
00:17:08,970 --> 00:17:10,970
.متابعة ممتازة

285
00:17:11,770 --> 00:17:14,930
!سأحمي كلاكما في أيّ وقت

286
00:17:14,930 --> 00:17:16,180
.هذه الرّوح المطلوبة

287
00:17:16,180 --> 00:17:18,450
.حسنًا. لنكمل

288
00:17:18,450 --> 00:17:20,700
.هناك فخاخ أيضًا، لذا علينا التزام الحذر

289
00:17:20,700 --> 00:17:25,520
،توجد أنواع عديدة من الفخاخ
...لكنّ الأكثر شيوعًا هو

290
00:17:24,760 --> 00:17:27,390
.في السّابق، كانت إصابة الأهداف مضمونة دائمًا

291
00:17:27,390 --> 00:17:32,190
،يُصعّب الدّيماس وصول قوّة الإله الأعلى إليك

292
00:17:32,190 --> 00:17:36,990
لذا تضاءلت قوّة المهارتين الفطريّتين
."عين الخبير" و"المرحلة التّعليميّة"

293
00:17:36,990 --> 00:17:39,220
!ماذا؟ حقًّا؟

294
00:17:39,640 --> 00:17:40,570
.نعم

295
00:17:40,570 --> 00:17:43,740
،الحُفر هي أكثر أنواع الفخاخ شيوعًا

296
00:17:43,740 --> 00:17:47,200
لكن إذا انتبهنا، سيكون
.بإمكاننا إدراك أنّها فخاخ

297
00:17:47,200 --> 00:17:48,310
...على سبيل المثال

298
00:17:47,730 --> 00:17:52,320
لم أتوقّع أبدًا أن تضعف مهاراتي
.الفطريّة بمجرّد دخولي الدّيماس

299
00:17:52,320 --> 00:17:53,500
ماذا أفعل؟

300
00:17:53,770 --> 00:17:55,020
.لا تقلق

301
00:17:55,510 --> 00:17:58,650
،طالما أنّك كنتَ تُصغي جيّدًا لما قلته للتّوّ

302
00:17:58,650 --> 00:18:00,660
.فإنّ تجنّبها ممكن بسهولة

303
00:18:00,980 --> 00:18:03,130
ماذا؟

304
00:18:06,670 --> 00:18:07,850
.سيّدي هيبيكي

305
00:18:07,850 --> 00:18:10,480
ألم تكن منتبهًا لي؟

306
00:18:11,050 --> 00:18:13,490
عفوًا... منتبهًا إلى ماذا تحديدًا؟

307
00:18:13,490 --> 00:18:17,740
هل تقصد أنّك كنت تردّ دون
أن تستمع إلى كلمة ممّا قلت؟

308
00:18:17,740 --> 00:18:20,900
!إنّه يُشبه تمامًا مُعلّمي في المدرسة

309
00:18:20,900 --> 00:18:23,520
!أنا آسف جدًّا

310
00:18:24,560 --> 00:18:29,900
.عادةً، تستمع دائمًا لما أقوله

311
00:18:30,590 --> 00:18:34,880
قد تسمع شيئًا واحدًا وتُسيء
،فهمه بعشر طرق مختلفة

312
00:18:34,880 --> 00:18:36,900
أو تكون غارقًا في أفكارك الخاصّة

313
00:18:36,900 --> 00:18:40,130
.بحيث لا تستطيع استيعاب ما يقوله الآخرون

314
00:18:40,130 --> 00:18:42,590
...في الواقع، ما حدث هو

315
00:18:46,330 --> 00:18:48,320
!لم تعد قادرًا على استخدام مهاراتك؟

316
00:18:48,320 --> 00:18:51,690
ليس الأمر أنّني لا أستطيع
.استخدامها، لكنّ قوّتها تضعف

317
00:18:51,690 --> 00:18:56,350
لم أظنّ أنّ دخول الدّيماس
.سيؤثّر على مهاراتك

318
00:18:56,350 --> 00:18:58,520
حتّى أنت لم تكن تعلم يا معلّم؟

319
00:18:58,520 --> 00:19:00,160
...حسنًا

320
00:19:00,160 --> 00:19:04,530
أظنّ أنّني كنت أعلم أنّ الدّياميس
.خارجة سيطرة الآلهة

321
00:19:04,530 --> 00:19:09,190
،لذلك أخطأ سهمك الهدف
.رغم براعتك المعهودة مؤخّرًا

322
00:19:09,190 --> 00:19:11,550
.كنتُ متأكّدًا أنّك متوتّر فحسب

323
00:19:11,800 --> 00:19:13,020
.أنا آسف

324
00:19:13,020 --> 00:19:17,550
.بالكاد أستطيع المساعدة في القتال أصلاً
.كان القوس الشّيءَ الوحيد الّذي أعتمد عليه

325
00:19:18,060 --> 00:19:21,400
.بهذا المعدّل، سأصبح عبئًا عليكم

326
00:19:24,920 --> 00:19:27,350
.أخي، أنا هنا

327
00:19:27,350 --> 00:19:30,320
،حتّى لو أخطأ سهمك الهدف
.سأهزمهم بسحري

328
00:19:30,320 --> 00:19:31,430
!فلا تقلق

329
00:19:31,850 --> 00:19:33,750
.إنّها محقّة

330
00:19:34,270 --> 00:19:38,920
حتّى لو أخطأ سهمك الهدف، فإنّه يكفي
.تمامًا لإبقاء العدوّ تحت السّيطرة

331
00:19:38,920 --> 00:19:43,990
هذا وحده يُسهّل القتال عليّ في الخطوط
.الأماميّة وعلى ليليان في الخلف

332
00:19:43,990 --> 00:19:47,220
.أنت لا تقاتل وحدك

333
00:19:47,220 --> 00:19:51,080
.أنا وليليان وفيني معك هنا

334
00:19:51,080 --> 00:19:52,800
.اعتمد علينا أكثر

335
00:19:53,850 --> 00:19:56,490
.معك حقّ

336
00:19:56,490 --> 00:19:58,380
.نحن معًا في هذا

337
00:19:58,960 --> 00:20:01,010
.نحن معًا في هذا، ونحن أصدقاء

338
00:20:01,010 --> 00:20:05,340
،حتّى وإن لم تربطنا صلة دم
.فأنا أعتبركم عائلتي حقًّا

339
00:20:05,680 --> 00:20:07,770
،عندما تشتدّ الصّعاب
.سندعم بعضنا بعضًا

340
00:20:07,770 --> 00:20:10,240
.سنمضي قُدمًا يدًا بيد

341
00:20:10,240 --> 00:20:11,850
عائلة؟

342
00:20:12,360 --> 00:20:14,250
.هذا صحيح يا سيّدي هيبيكي

343
00:20:14,620 --> 00:20:17,840
أنا سعيد لأنّك كشفت لنا
.عن وضعك مبكّرًا

344
00:20:18,210 --> 00:20:22,520
سنواجه المشاكل حال ظهورها
.ونتعامل معها معًا

345
00:20:24,240 --> 00:20:26,720
.شكرًا لكم جميعًا

346
00:20:26,720 --> 00:20:27,950
ما الخطب يا كلود؟

347
00:20:28,820 --> 00:20:31,870
.لم أقل أنّه يمكنك النّهوض الآن

348
00:20:31,870 --> 00:20:33,640
ماذا؟

349
00:20:33,640 --> 00:20:36,530
.هناك الكثير والكثير ممّا أريد قوله

350
00:20:37,540 --> 00:20:40,360
،صحيح أنّ تلك المهارات النّادرة مفيدة

351
00:20:40,360 --> 00:20:44,790
لكنّك لن تنجو ما لم تستطع التّعامل مع
.المواقف الّتي لا يمكنك فيها استخدامها

352
00:20:44,790 --> 00:20:46,880
!آ-آخ... هذا مؤلم

353
00:20:47,220 --> 00:20:50,650
بالتّأكيد تتذكّر أنّني أخبرتك
أنّك بحاجة إلى تعلّم القتال

354
00:20:50,350 --> 00:20:51,940
!ساقاي

355
00:20:50,650 --> 00:20:52,970
دون الاعتماد على مهاراتك كثيرًا؟

356
00:20:56,990 --> 00:20:59,410
.لم تكن تستمع مجدّدًا

357
00:21:00,680 --> 00:21:03,110
.سنبدأ بعض التّدريب الآن

358
00:21:07,500 --> 00:21:10,110
.ابذل قصارى جهدك يا أخي

359
00:21:33,390 --> 00:21:35,880
!قاطع الرّياح

360
00:21:36,400 --> 00:21:37,560
...إنّها محقّة

361
00:21:37,560 --> 00:21:39,570
،لو استخدمتُ القوس
.لربّما تمكّنتُ من قتلها

362
00:21:40,070 --> 00:21:42,240
.لكنّني نجوت بفضل ذلك

363
00:21:50,400 --> 00:21:52,230
.يجب أن أوقفها

364
00:23:25,370 --> 00:23:29,820
،لم يتبقَّ لنا سوى حلقتين حتّى النّهاية
فلماذا يتحدّثون عن الملابس الدّاخليّة؟

365
00:23:29,820 --> 00:23:33,770
،السّيّد كلو متساهل مع أخي
.لذا عليّ أن أتحمّل المسؤوليّة

366
00:23:33,770 --> 00:23:37,350
!سأكون أنا الشّخص النّاضج لحماية الجميع

367
00:23:37,350 --> 00:23:39,310
.نحن آسفان حقًّا