1
00:00:03,360 --> 00:00:05,520
!هذا رائع جدًّا يا أخي

2
00:00:05,860 --> 00:00:08,400
.لا أصدّق هذا

3
00:00:08,710 --> 00:00:10,780
!بإمكاني القتال الآن

4
00:00:10,780 --> 00:00:13,400
!لنعد إلى كلود

5
00:02:02,360 --> 00:02:05,520
يتّجه قطيع من ذئاب الياقوت
.الفضّيّة نحونا أيضًا

6
00:02:05,520 --> 00:02:07,210
!أحد عشر ذئبًا من الأمام

7
00:02:07,210 --> 00:02:09,730
.عشرة على اليمين، وثمانية على اليسار

8
00:02:10,010 --> 00:02:11,370
ماذا سنفعل؟

9
00:02:11,940 --> 00:02:13,390
.ليس لدينا سوى خيار واحد

10
00:02:13,390 --> 00:02:16,620
.إذا أوقفناها هنا، فسيساعد ذلك كلود

11
00:02:16,620 --> 00:02:18,940
!هيّا نهزمها بسرعة ونتقدّم

12
00:02:18,940 --> 00:02:21,150
.كنتُ أتوقّع أن تقول هذا

13
00:02:21,620 --> 00:02:24,120
!ركّز على الذّئاب الّتي أمامك مباشرة

14
00:02:24,120 --> 00:02:25,490
!مفهوم

15
00:02:27,750 --> 00:02:30,070
.ربّما يكون هذا صعبًا للغاية

16
00:02:30,070 --> 00:02:31,670
.رسالة من سابو

17
00:02:31,670 --> 00:02:34,910
أوصي باستعمال
.المهارة الفطريّة عين الخبير

18
00:02:34,910 --> 00:02:35,640
ماذا؟

19
00:02:35,640 --> 00:02:39,340
!هذا يعني أنّ الإله الأعلى قد استعاد عافيته

20
00:02:39,780 --> 00:02:40,780
!حسنًا

21
00:02:40,780 --> 00:02:42,900
!تفعيل عين الخبير

22
00:02:44,380 --> 00:02:46,730
.جارٍ حساب فرص الإصابة

23
00:02:46,730 --> 00:02:48,530
.اختر الهدف رجاءً

24
00:02:48,530 --> 00:02:49,460
ماذا؟

25
00:02:49,460 --> 00:02:51,170
...إنّ هذا

26
00:02:51,170 --> 00:02:52,150
.حسنًا

27
00:02:52,610 --> 00:02:55,090
.%فرص الإصابة هي 100

28
00:02:55,090 --> 00:02:56,010
ماذا؟

29
00:02:56,010 --> 00:02:56,990
.ابدأ

30
00:02:56,990 --> 00:02:58,790
...حـ-حسنًا

31
00:03:03,860 --> 00:03:05,950
!أحسنت يا سيّدي

32
00:03:06,880 --> 00:03:09,730
سهمٌ ينتقل بسرعة الضّوء
.ويصيب الهدف بدقّةٍ متناهية

33
00:03:09,730 --> 00:03:12,500
أليس هذا سلاحًا فتّاكًا لا مفرّ منه؟

34
00:03:13,580 --> 00:03:15,750
.لكنّنا نحتاجه الآن

35
00:03:15,750 --> 00:03:17,270
.عليّ استخدامه

36
00:03:18,020 --> 00:03:21,290
ليليان، يمكنك إطلاق ثلث
!قوّتك السّحريّة

37
00:03:21,290 --> 00:03:22,560
!مفهوم

38
00:03:25,170 --> 00:03:26,790
!قاطع الرّياح

39
00:03:30,400 --> 00:03:31,940
!سوط الخشب

40
00:03:37,070 --> 00:03:39,820
.يبدو أنّ ليليان لا تتردّد أيضًا

41
00:03:40,480 --> 00:03:42,610
!أحسنت يا ليليان

42
00:03:42,610 --> 00:03:44,450
.كلّ الفضل يعود لمعلّمي

43
00:03:45,280 --> 00:03:48,040
لكنّني مندهش جدًّا لأنّها
.تهاجم بأسلوب الكمّاشة

44
00:03:48,040 --> 00:03:50,080
!يا لها من وحوش ذكيّة

45
00:03:50,080 --> 00:03:52,530
.إنّها تحت السّيطرة فحسب

46
00:03:52,960 --> 00:03:56,880
.كلّ هذا من صنيع ذئب الألماس الفضّيّ

47
00:03:56,880 --> 00:03:59,750
ما الّذي يفعله وحشٌ خطيرٌ كهذا هنا؟

48
00:04:00,110 --> 00:04:02,360
أظنّ أنّ السّبب هو تلك المرأة
.الّتي قابلناها سابقًا

49
00:04:02,360 --> 00:04:03,830
تقصد الآنسة إيفل؟

50
00:04:04,350 --> 00:04:09,030
،لو لم تظهر، لما توغّلنا في أعماق الغابة

51
00:04:09,030 --> 00:04:13,050
.ولما صادفنا ذئب الألماس الفضّيّ

52
00:04:14,610 --> 00:04:16,900
...ثمّ، ذلك الوجه

53
00:04:16,900 --> 00:04:19,940
.أقسم أنّني رأيته من قبل

54
00:04:19,940 --> 00:04:22,670
.عاني أكثر يا كلود

55
00:04:22,670 --> 00:04:26,310
...عاني، وسيزداد قلب تلك المرأة وروحها

56
00:04:26,770 --> 00:04:29,670
.فسادًا أكثر فأكثر

57
00:04:42,790 --> 00:04:44,160
لماذا؟

58
00:04:45,560 --> 00:04:48,590
.كنت أثق بها أكثر من أيّ شيء آخر

59
00:04:49,400 --> 00:04:51,780
.القمر جميل جدًّا

60
00:04:53,030 --> 00:04:53,780
صحيح؟

61
00:04:57,100 --> 00:05:01,400
أنتِ هناك، أليس كذلك يا أناستازيا؟

62
00:05:24,260 --> 00:05:25,480
لماذا؟

63
00:05:25,930 --> 00:05:30,340
هذه هي مهارة ذئب الألماس الفضّيّ
!الفطريةّ، الحاجز الفولاذيّ

64
00:05:30,340 --> 00:05:33,550
!لا يمكنك اختراقه بقوّتك الحاليّة

65
00:05:40,730 --> 00:05:42,020
!كلود

66
00:05:45,700 --> 00:05:47,700
!توقّف

67
00:05:49,720 --> 00:05:52,140
.يستدعي السّيّد أتباعه

68
00:06:03,260 --> 00:06:04,790
!كلود

69
00:06:04,790 --> 00:06:06,290
!سيّد كلو

70
00:06:06,620 --> 00:06:08,760
.بدء التّشخيص

71
00:06:09,560 --> 00:06:11,050
!ليليان

72
00:06:13,000 --> 00:06:17,140
!أطلقي كلّ قوّتك السّحريّة

73
00:06:27,960 --> 00:06:30,240
!بمجرّد انتهاء علاجه، علينا الإسراع

74
00:06:30,240 --> 00:06:32,300
.اكتمل التّشخيص

75
00:06:32,300 --> 00:06:33,200
!حسنًا

76
00:06:33,190 --> 00:06:34,150
ماذا؟

77
00:06:34,490 --> 00:06:36,530
!سمّ دييريث مرّة أخرى

78
00:06:36,530 --> 00:06:38,160
!الشّفاء الفائق

79
00:06:40,120 --> 00:06:42,780
...هذا السّمّ... أيعقل أنّه

80
00:06:43,590 --> 00:06:44,920
.تقييم

81
00:06:47,660 --> 00:06:50,540
!هو نفسه مصاب بالسّمّ؟

82
00:06:50,540 --> 00:06:54,410
وهو يطيع هذه الّتي تُدعى "أناستازيا"؟

83
00:06:54,410 --> 00:06:56,520
إذًا هي وراء كلّ هذا؟

84
00:06:56,870 --> 00:06:59,550
.لكن يبدو هذا الاسم مألوفًا نوعًا ما

85
00:07:02,550 --> 00:07:04,110
.اكتملت عمليّة إزالة السّموم

86
00:07:05,430 --> 00:07:06,970
!العلاج المثاليّ

87
00:07:07,810 --> 00:07:11,650
تمّ منع الاستخدام لأنّ نقاط
.السّحر لصاحب العقد غير كافية

88
00:07:11,650 --> 00:07:13,080
كيف؟

89
00:07:19,100 --> 00:07:21,740
!أعتقد أنّها تستنزف نقاط سحرها

90
00:07:21,740 --> 00:07:23,310
...إذا كان الأمر كذلك

91
00:07:23,310 --> 00:07:26,010
...قبل أن تنفد نقاط سحر ليليان تمامًا

92
00:07:26,010 --> 00:07:27,650
!علاج إضافيّ

93
00:07:33,380 --> 00:07:34,680
!لم ينجح ذلك

94
00:07:41,810 --> 00:07:43,140
!ليليان

95
00:07:50,400 --> 00:07:51,920
.يا إلهي

96
00:07:51,920 --> 00:07:53,310
.يا للغباء

97
00:07:53,810 --> 00:07:57,870
.ربّما ما كنت لتموت لو لم تعد

98
00:08:27,320 --> 00:08:28,740
!كلود

99
00:08:28,740 --> 00:08:32,810
انتقلت مهارة عين الخبير الفطريّة
."إلى "الوضع المستنير

100
00:08:33,890 --> 00:08:36,070
.جارٍ تصحيح المعلومات المغلوطة

101
00:08:48,000 --> 00:08:51,840
!قبضة سحق الألماس

102
00:08:58,850 --> 00:09:00,870
.سأنهي هذا سريعًا

103
00:09:01,610 --> 00:09:03,100
.انتظر هنا من فضلك

104
00:09:03,690 --> 00:09:04,970
ماذا عن سلاحك؟

105
00:09:04,970 --> 00:09:06,230
.لا تقلق

106
00:09:10,810 --> 00:09:12,160
.إنّه هنا

107
00:09:28,670 --> 00:09:31,160
!الجاذبيّة الموجّهة

108
00:09:34,250 --> 00:09:38,240
.الهدفان هما هذا الرّمح وأناستازيا

109
00:09:38,240 --> 00:09:40,770
،رمحي، المرتبط بك الآن بسلاسل الجاذبيّة

110
00:09:41,300 --> 00:09:44,040
.مضمونٌ له أن يطاردك

111
00:09:45,890 --> 00:09:47,160
!لا فائدة

112
00:09:47,160 --> 00:09:49,990
!سيتمزّق هذا الحاجز الفولاذيّ كالورق

113
00:09:49,990 --> 00:09:53,400
،بهذا الرّمح الّذي لا يمكن تفاديه أو صدّه

114
00:09:53,400 --> 00:09:55,980
.سأعيدك إلى الأرض

115
00:09:56,770 --> 00:09:59,810
!طعنة حاسمة

116
00:10:25,390 --> 00:10:26,610
.سأقيّمه

117
00:10:26,610 --> 00:10:28,090
!ستقوم بذلك؟

118
00:10:28,500 --> 00:10:34,680
مكتوب أنّ الرّوح الفاسدة الّتي كانت
.تحت السّيطرة قد تحرّرت أخيرًا

119
00:10:35,170 --> 00:10:39,640
هذا يوحي بأنّ أناستازيا كانت
.أيضًا تحت السّيطرة

120
00:10:39,640 --> 00:10:40,880
.شكرًا لك

121
00:10:42,760 --> 00:10:48,520
بفضلك، لم أعد أستطيع ارتكاب
.المزيد من الذّنوب

122
00:10:50,180 --> 00:10:52,470
.أنا آسفة يا كلود

123
00:10:53,020 --> 00:10:56,590
.سينتهي كابوسك اليوم أيضًا

124
00:10:57,320 --> 00:11:01,870
.سأنام هنا حتّى يحين ذلك الوقت

125
00:11:02,800 --> 00:11:05,620
سيّدي هيبيكي، هل أنت بخير؟

126
00:11:06,330 --> 00:11:07,630
!كلود

127
00:11:07,630 --> 00:11:09,650
!عادت قواك كبطل ثانية

128
00:11:09,650 --> 00:11:12,470
.لا، يبدو أنّ الوقت قد انتهى

129
00:11:13,500 --> 00:11:16,120
.لقد انتهى الوقت المحدّد

130
00:11:16,120 --> 00:11:20,440
.سيتمّ الآن تعطيل الوضع المستنير لعين الخبير

131
00:11:21,230 --> 00:11:23,050
...إذًا هي قوّة محدودة

132
00:11:23,600 --> 00:11:24,950
.سيّدي هيبيكي

133
00:11:25,560 --> 00:11:27,820
.أنا أعتذر بشدّة

134
00:11:27,820 --> 00:11:31,180
.كلّ ما حدث هنا كان خطئي

135
00:11:31,180 --> 00:11:32,570
ماذا تقصد؟

136
00:11:33,070 --> 00:11:37,170
.كان لديّ رفيقة تُدعى أناستازيا فايرين

137
00:11:38,010 --> 00:11:41,920
كان ذئب الألماس الفضّيّ
.يحمل جزءًا من روحها

138
00:11:42,600 --> 00:11:45,050
،بصفتها ساحرة أرواح
كانت تستطيع التّحكّم بالوحوش

139
00:11:45,890 --> 00:11:52,220
بتقسيم روحها واستخدام جزء
.منها للاستحواذ عليها

140
00:11:52,700 --> 00:11:58,610
.ثمّ... خانتني وانضمّت إلى أولئك الّذين لعنوني

141
00:11:58,610 --> 00:12:01,830
إذًا إذا هزمناها، ستزول اللّعنة؟

142
00:12:01,830 --> 00:12:05,440
.لا، لأنّها ليست من لعنتني

143
00:12:06,220 --> 00:12:08,710
.كما أنّها ميتة بالفعل

144
00:12:09,170 --> 00:12:11,070
.قتلتها بيديّ

145
00:12:12,120 --> 00:12:15,460
...لن... أدعك تأخذ

146
00:12:16,210 --> 00:12:19,260
...روحي

147
00:12:21,530 --> 00:12:23,750
!يا له من إهمال

148
00:12:23,750 --> 00:12:28,710
لم أتخيّل أبدًا وجود وحوش
.تحت سيطرتها حين ماتت

149
00:12:29,080 --> 00:12:32,620
لذلك فسبب هجوم ذئب الألماس
...الفضّيّ علينا هو

150
00:12:32,620 --> 00:12:34,650
.كان يلاحقني أنا

151
00:12:35,050 --> 00:12:37,210
.سأتقبل أيّ عقاب

152
00:12:37,680 --> 00:12:39,230
!احكم عليّ بما تراه مناسبًا

153
00:12:39,680 --> 00:12:42,240
وأين أخطأت في كلّ هذا؟

154
00:12:42,610 --> 00:12:45,210
!لولاي أنا، لما كنتَ في هذا الخطر

155
00:12:45,660 --> 00:12:47,930
.لقد أُجبرتَ على هذا

156
00:12:47,930 --> 00:12:49,300
.أنت ضحية

157
00:12:50,020 --> 00:12:54,370
.تعرّضتَ للخيانة واللّعن وفقدت أطرافك حتّى

158
00:12:55,150 --> 00:12:58,020
كيف يكون أيٌّ من هذا خطأك؟

159
00:12:58,630 --> 00:13:01,210
.ليس لديك أيّ سبب للشّعور بالذّنب

160
00:13:03,330 --> 00:13:04,960
.سأقول هذا مرارًا وتكرارًا

161
00:13:05,370 --> 00:13:06,930
!هذا ليس خطأك

162
00:13:07,180 --> 00:13:08,950
...سيّدي هيبيكي

163
00:13:11,900 --> 00:13:15,990
.أجدّد أنا كلود أباراس قسمي لك ثانية

164
00:13:16,710 --> 00:13:20,100
،إلى أن تتمكّن من العودة إلى عالمك

165
00:13:20,100 --> 00:13:23,880
.سأخدمك وأحميك بكلّ إخلاص

166
00:13:23,880 --> 00:13:28,950
،حتّى لو حان وقت فراقنا إلى الأبد

167
00:13:29,460 --> 00:13:34,570
أرجو أن يبقى هذا القسم
.وإخلاصي معك دائمًا

168
00:13:36,800 --> 00:13:37,810
.مستحيل

169
00:13:38,240 --> 00:13:39,960
.لن أقبل هذا القسم

170
00:13:39,960 --> 00:13:40,850
ماذا؟

171
00:13:41,370 --> 00:13:42,350
—أنا

172
00:13:43,370 --> 00:13:44,470
!سيّدي هيبيكي

173
00:13:44,850 --> 00:13:49,270
أظنّ أنّ الوضع المستنير كان صعبًا
.بعض الشّيء على مستواك الحاليّ

174
00:13:49,270 --> 00:13:51,100
.يجب أن تستريح قليلاً

175
00:13:51,100 --> 00:13:54,240
...هذا صوت الإله الأعلى

176
00:13:53,320 --> 00:13:54,620
!تصبح على خير

177
00:14:05,900 --> 00:14:08,140
.كان ذلك وشيكًا

178
00:14:08,740 --> 00:14:10,930
.بالتّأكيد

179
00:14:10,930 --> 00:14:13,660
.أنت السّبب لوصولنا لذلك الوضع

180
00:14:14,010 --> 00:14:16,820
...أبعدتني عن الخدمة لفترة طويلة

181
00:14:16,820 --> 00:14:17,790
ما هذا؟

182
00:14:17,790 --> 00:14:19,330
.لا شيء

183
00:14:19,750 --> 00:14:22,370
،بالمناسبة، يا إلهة العالم السّفليّ
هل أستطيع مساعدتك؟

184
00:14:22,370 --> 00:14:24,310
...عفوًا... أنا

185
00:14:24,310 --> 00:14:30,470
سمعتُ أنّك عانيت كثيرًا بسبب
.أداة التّعذيب الّتي صنعتُها

186
00:14:30,470 --> 00:14:32,500
.كان ذلك خطأ إلهة السّحر

187
00:14:32,500 --> 00:14:34,300
—إنّها ساديّة للغاية، وأنا

188
00:14:35,190 --> 00:14:37,060
!هذا مؤلم، مؤلم، مؤلم

189
00:14:37,060 --> 00:14:38,210
!حسنًا، كان خطئي أنا

190
00:14:38,210 --> 00:14:39,520
!كان خطئي

191
00:14:39,520 --> 00:14:41,270
!أرجو أن تسامحني

192
00:14:41,270 --> 00:14:44,380
في المرّة القادمة، قد يكون
.استخدام مِلزمةٍ مفيدًا

193
00:14:44,380 --> 00:14:46,410
!ألا يوجد أحدٌ إلى جانبي هنا؟

194
00:14:46,410 --> 00:14:50,560
،هذا هو وضعنا الحاليّ
.فلا داعي للقلق

195
00:14:50,560 --> 00:14:51,960
.نـ-نعم

196
00:14:51,960 --> 00:14:52,970
...بالمناسبة

197
00:14:52,970 --> 00:14:54,630
هل اخترتِ ملك شياطين جديد بعد؟

198
00:14:54,630 --> 00:14:57,370
.لا، ليس بعد

199
00:14:57,370 --> 00:14:59,560
.حسنًا، لا بأس

200
00:14:59,560 --> 00:15:03,440
هزم بطل مملكة الوحشيّين
.ملك الشّياطين منذ وقتٍ قصير فقط

201
00:15:03,440 --> 00:15:06,980
،ولكن من أجل حسن إدارة العالم

202
00:15:06,980 --> 00:15:10,600
من الأفضل شغل جميع مناصب
.ملوك الشّياطين الثّمانيّة

203
00:15:10,990 --> 00:15:13,630
.أعدك أنّني سأجد شخصًا مناسبًا

204
00:15:13,630 --> 00:15:17,540
لمعلوماتكما، لستما مضطرّتين
.لتكونا متشدّدتين جدًّا في كلّ هذا

205
00:15:17,540 --> 00:15:19,870
.كانت حالة مملكة الوحشيّين استثناءً

206
00:15:19,870 --> 00:15:22,850
.ملوك الشّياطين ليسوا بالضّرورة أشرارًا

207
00:15:22,850 --> 00:15:26,450
لـ-لكن ماذا لو دخل ملك الشّياطين
في حالة هيجان ثانية؟

208
00:15:26,450 --> 00:15:28,790
.الإله الأعلى على حقّ

209
00:15:28,790 --> 00:15:33,450
إلى جانب ذلك، سمعتُ أنّ جميع
.المرشّحين الجدد أطفالٌ صالحون

210
00:15:33,450 --> 00:15:36,700
أعلم أنّ الاختيار سيكون
.صعبًا، لذا حظًّا موفّقًا

211
00:15:37,030 --> 00:15:38,620
.مـ-مفهوم

212
00:15:38,620 --> 00:15:40,220
.شكرًا جزيلاً

213
00:15:40,220 --> 00:15:42,440
.سـ-سأذهب الآن

214
00:15:43,660 --> 00:15:46,430
.حسنًا، عليّ الذّهاب أنا أيضًا

215
00:15:49,460 --> 00:15:54,420
أخبرني، هل رأيتُ هذا الطّفل
هيبيكي في مكانٍ ما من قبل؟

216
00:15:54,420 --> 00:15:56,760
.أشعر أنّني أعرفه من مكانٍ ما

217
00:15:56,760 --> 00:15:58,010
من يدري؟

218
00:15:58,010 --> 00:16:02,770
.أنا أساعده فقط لأنّه ضعيفٌ جدًّا

219
00:16:04,120 --> 00:16:05,160
.فهمت

220
00:16:08,440 --> 00:16:12,090
،يبدو أنّها بدأت تكتشف الأمر

221
00:16:12,090 --> 00:16:16,410
.لكنّ القوّة ضروريّةٌ لكي ينجو هذا الطّفل

222
00:16:17,340 --> 00:16:21,590
.بصراحة، لم أُرده أبدًا أن يأتي إلى هذا العالم

223
00:16:21,590 --> 00:16:26,470
كان بإمكانه البقاء في عالمه
.والعيش حياةً سعيدة

224
00:16:31,530 --> 00:16:33,680
.ارتفع مستواك العامّ

225
00:16:33,680 --> 00:16:35,710
.من المستوى 12 إلى المستوى 25

226
00:16:35,710 --> 00:16:37,600
.ارتفع مستوى مهنتك

227
00:16:37,600 --> 00:16:39,710
.من المستوى 15 إلى المستوى 25

228
00:16:39,710 --> 00:16:42,350
.ارتفع مستوى مهارة التّقييم التّقنيّة

229
00:16:42,350 --> 00:16:44,170
.من المستوى 4 إلى المستوى 5

230
00:16:46,230 --> 00:16:48,500
.صباح الخير يا كلود

231
00:16:48,500 --> 00:16:51,650
.صباح الخير يا سيّدي هيبيكي

232
00:16:52,930 --> 00:16:55,080
.استيقظتَ أخيرًا

233
00:16:55,080 --> 00:16:58,040
.يا سيّدي، لقد كنتَ نائمًا ليومين متتاليين

234
00:16:58,040 --> 00:16:59,890
كلّ هذه المدّة؟

235
00:16:59,890 --> 00:17:04,310
استخدام الوضع المُستنير
.يُرهق الجسم بشدّة

236
00:17:04,740 --> 00:17:08,180
يرجى الالتزام بتعليمات
.الاستخدام عند استخدامه

237
00:17:08,550 --> 00:17:09,690
.مفهوم

238
00:17:09,690 --> 00:17:11,460
.سأحرص على ذلك يا سابو

239
00:17:11,460 --> 00:17:13,300
هل نأكل؟

240
00:17:20,530 --> 00:17:21,990
.يا صاحب الجلالة

241
00:17:23,440 --> 00:17:27,350
.شكرًا لك على دعوتك الكريمة اليوم

242
00:17:27,350 --> 00:17:29,760
.إماليا! إنّ عودتك شرف كبير

243
00:17:29,760 --> 00:17:32,370
.استدعاني والدي إلى المنزل لأمرٍ عاجل

244
00:17:34,370 --> 00:17:36,120
.والدي الغبيّ

245
00:17:36,120 --> 00:17:37,930
!أين هو الآن؟

246
00:17:37,930 --> 00:17:39,190
!إماليا

247
00:17:39,190 --> 00:17:40,620
.لقد طال غيابك

248
00:17:41,030 --> 00:17:42,680
المعذرة؟

249
00:17:42,680 --> 00:17:44,060
ألم تتعرّفي عليّ؟

250
00:17:44,060 --> 00:17:46,780
.هذا أنا. فيرديليس

251
00:17:46,780 --> 00:17:48,570
!الأمير فرديليس؟

252
00:17:48,570 --> 00:17:50,440
!يا للعجب، لقد كبرتَ كثيرًا

253
00:17:50,440 --> 00:17:53,980
كنتُ في العاشرة من عمري فقط
.عندما غادرتِ البلاد

254
00:17:56,280 --> 00:17:58,370
.ما زلت جميلة كما كنت دائمًا

255
00:17:58,370 --> 00:18:01,390
.ليت امرأةً مثلك تُنجب حاكمَ بلادنا القادم

256
00:18:01,390 --> 00:18:02,270
.هذا مقرف

257
00:18:02,670 --> 00:18:03,510
ماذا؟

258
00:18:03,510 --> 00:18:04,440
.مقرف

259
00:18:05,190 --> 00:18:07,300
!يا رعاياي الأعزاء

260
00:18:07,300 --> 00:18:08,980
.لديّ خبرٌ سارّ

261
00:18:08,980 --> 00:18:11,310
.فرديليس، ميلينكوريس

262
00:18:12,740 --> 00:18:17,570
في هذه السّنة، بلغ عمر كليهما 15 عامًا
.وقد حصلا على مهن مناسبة

263
00:18:17,570 --> 00:18:18,890
...مرّ وقت طويل

264
00:18:18,890 --> 00:18:20,700
!وقت طويل جدًّا

265
00:18:21,150 --> 00:18:24,020
وصلت دعوات بلادنا اليائسة
!أخيرًا إلى الآلهة

266
00:18:24,560 --> 00:18:28,740
!أصبح ولي العهد الأوّل فيرديليس بطلاً

267
00:18:29,450 --> 00:18:33,970
كما تمّ اختيار ميلينكوريس
!من آل هارتين ليصبح حكيمًا

268
00:18:34,720 --> 00:18:41,290
وأخيرًا، حظيت بلادنا بمهن
!لا يمنحها إلاّ الآلهة

269
00:18:41,290 --> 00:18:44,210
مهمّة البطل هي هزيمة
!ملك الشّياطين الشّرّير

270
00:18:44,210 --> 00:18:46,750
لا شكّ أنّهما سيقضيان على ملك الشّياطين

271
00:18:46,750 --> 00:18:49,720
!وسيصبحان فخرًا لبلادنا

272
00:18:50,070 --> 00:18:50,860
ماذا؟

273
00:18:50,860 --> 00:18:51,980
مهلاً. ماذا؟

274
00:18:51,980 --> 00:18:54,600
.لا بدّ أن تكون للبطل فرقة

275
00:18:54,970 --> 00:18:58,220
،ولذلك، سينضمّ إليهما أحد أفضل محاربي بلادنا

276
00:18:58,220 --> 00:19:01,260
.الفارس المقدّس دوغواير

277
00:19:02,650 --> 00:19:04,340
.إضافة إلى عضو آخر

278
00:19:04,340 --> 00:19:07,110
،المغامِرة المتمرّسة في العالم الخارجيّ

279
00:19:07,110 --> 00:19:10,390
.إماليا من آل ستينبارت

280
00:19:17,800 --> 00:19:22,560
أيّها الحضور، أقسم أن أقضي
.على ملك الشّياطين الشّرّير

281
00:19:22,560 --> 00:19:25,380
،وبعد أن أفي بهذا القسم

282
00:19:25,880 --> 00:19:29,600
.أعتزم الزّواج من إماليا ستينبارت

283
00:19:44,400 --> 00:19:46,600
.شبعتُ كثيرًا

284
00:19:46,600 --> 00:19:48,530
.كان الطّعام لذيذًا للغاية

285
00:19:48,530 --> 00:19:53,780
أعدّت السّيّدة تانيا هذه الوليمة
.لنا احتفالاً بشفاء سيّدي هيبيكي

286
00:19:54,090 --> 00:19:57,600
...أنا ممتنّ، لكنّي شبعان حتّى الغثيان

287
00:20:07,520 --> 00:20:11,080
كنت أفكّر في الذّهاب
.إلى تيرا دايناس في النّهاية

288
00:20:11,080 --> 00:20:14,390
.سأجد طريقة للعودة إلى عالمي، بكلّ تأكيد

289
00:20:15,030 --> 00:20:17,500
.عائلتي هناك

290
00:20:17,500 --> 00:20:19,110
.وأصدقائي أيضًا

291
00:20:19,110 --> 00:20:21,240
.أفتقد الكثير من النّاس هناك

292
00:20:22,260 --> 00:20:23,360
...ولكن

293
00:20:24,560 --> 00:20:27,040
.لا أريد أن أودّعكم أيضًا

294
00:20:27,460 --> 00:20:32,620
الوقت الّذي أقضيه معكم
.ثمين جدًّا بالنّسبة لي

295
00:20:33,270 --> 00:20:34,730
.سيّدي هيبيكي

296
00:20:35,550 --> 00:20:39,180
لا أطيق فكرة ألاّ أرى أحدًا
.من عالمي مجدّدًا

297
00:20:39,180 --> 00:20:42,650
.لكنّني لا أطيق فكرة وداعكم جميعًا أيضًا

298
00:20:42,650 --> 00:20:48,310
لهذا السّبب أنوي إيجاد طريقة
!للعودة دون أن أترككم

299
00:20:49,830 --> 00:20:52,060
حتّى أتمكّن من البقاء معك؟

300
00:20:52,540 --> 00:20:54,000
.هذا ما أريده

301
00:20:54,000 --> 00:20:55,220
وماذا عنكِ؟

302
00:20:55,220 --> 00:20:57,110
.أريد البقاء معك أيضًا

303
00:20:57,110 --> 00:20:58,680
.شكرًا لك يا ليليان

304
00:20:58,680 --> 00:21:04,060
لكن كيف ستعود إلى عالمك
دون أن تتركنا؟

305
00:21:04,450 --> 00:21:05,850
!لا أعرف

306
00:21:05,850 --> 00:21:07,840
ماذا توقّعتم؟

307
00:21:07,840 --> 00:21:11,460
!لا أعرف حتّى كيف أعود إلى دياري

308
00:21:11,650 --> 00:21:16,200
أعتقد أنّ هذا يبدو سهلاً جدًّا
...لدرجة يصعب تصديقها

309
00:21:16,200 --> 00:21:21,050
ربّما، لكنّ سيّدي هيبيكي
!قد يجعل المستحيل ممكنًا

310
00:21:21,520 --> 00:21:25,990
سأقول هذا ثانية، لكن ما لم
،تجتز الدّيماس الشّماليّ

311
00:21:25,990 --> 00:21:29,060
فلن تستطيع الوصول
.إلى تيرا دايناس، حيث الحكماء

312
00:21:29,060 --> 00:21:30,120
.أعلم ذلك

313
00:21:30,570 --> 00:21:33,570
.لهذا السّبب أطلب منكم جميعًا مساعدتي

314
00:21:33,950 --> 00:21:35,310
.بالتّأكيد

315
00:21:36,270 --> 00:21:41,340
أتعهّد لك يا سيّدي هيبيكي
بجسدي وروحي بصفتي فارسًا

316
00:21:41,340 --> 00:21:43,390
!لحمايتك طوال حياتي

317
00:21:43,390 --> 00:21:44,390
!وأنا أيضًا

318
00:21:44,710 --> 00:21:46,650
.شكرًا لكما

319
00:21:51,790 --> 00:21:55,920
أرجوكم لا تورّطوني في هذه
...المواقف المبتذلة

320
00:22:01,740 --> 00:22:03,580
!لا بأس

321
00:22:03,580 --> 00:22:07,350
!أريد البقاء معكم جميعًا أيضًا

322
00:22:07,350 --> 00:22:08,920
!مرحى

323
00:22:09,460 --> 00:22:11,880
،لا أعرف ما سيحدث في المستقبل

324
00:22:12,270 --> 00:22:14,540
.لكنّني أعرف أنّني لن أنسى مبادئي

325
00:22:15,180 --> 00:22:18,070
!لنجتز جميعًا الدّيماس الشّماليّ

326
00:22:23,570 --> 00:22:27,250
يا سيّدتي الصّغيرة، هل عليك
حقًّا المغادرة بهذه السّرعة؟

327
00:22:27,250 --> 00:22:28,780
!نعم

328
00:22:29,340 --> 00:22:32,570
،لا أطيق ذلك الأمير المتغطرس على الإطلاق

329
00:22:32,570 --> 00:22:36,180
وهو يعتقد فعلاً أنّ ملك الشّياطين
!عدوّ يجب هزيمته؟

330
00:22:36,180 --> 00:22:37,290
ما المشكلة في ذلك؟

331
00:22:37,290 --> 00:22:38,830
.كلّ شيء

332
00:22:38,830 --> 00:22:41,510
،لكن على أيّ حال
،لن يستمع إليّ أحد هنا

333
00:22:41,510 --> 00:22:43,490
.لذا عليّ الرّحيل

334
00:22:45,800 --> 00:22:47,470
.أراك لاحقًا يا ستيليا

335
00:22:47,470 --> 00:22:50,200
.بإمكان والدي الغبيّ التّعامل مع الباقي

336
00:22:51,050 --> 00:22:54,330
.لا أصدّق أنّ هذا كان طلبه العاجل

337
00:22:54,330 --> 00:22:55,260
!اللّعنة

338
00:22:56,140 --> 00:22:58,050
!انتظرني يا هيبيكي

339
00:22:58,050 --> 00:22:59,870
!أنا قادمة

340
00:23:06,800 --> 00:23:08,700
.أعتذر بشدّة

341
00:23:09,090 --> 00:23:10,970
...اعترض أحدهم طريقي و

342
00:23:11,400 --> 00:23:12,450
!هذا مؤلم

343
00:23:13,290 --> 00:23:15,620
...أعدك أنّني في المرّة القادمة

344
00:23:15,620 --> 00:23:20,200
.سأقتل كلود وسأقدم روحها لك

345
00:23:25,050 --> 00:23:26,250
.أخبرني يا سابو

346
00:23:26,250 --> 00:23:28,540
هل كنت تتحدّث معي وأنا نائم؟

347
00:23:28,540 --> 00:23:31,470
.نعم. كنت أتحدّث بصوت عالٍ طوال الوقت

348
00:23:31,470 --> 00:23:36,300
...فـ-فعندما لا تكون موجودًا، فأنا

349
00:23:36,570 --> 00:23:38,210
!لا يكون لديّ ما أفعله وأشعر بالملل

350
00:23:38,210 --> 00:23:39,650
!يا لها من قفلة مضحكة