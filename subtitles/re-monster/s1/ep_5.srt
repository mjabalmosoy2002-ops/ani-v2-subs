1
00:00:03,790 --> 00:00:07,120
كانت أوّل مرّة أصطاد فيها
رفقة غوبكيتشي منذ مدّة

2
00:00:09,450 --> 00:00:12,620
رأينا 12 جنديّاً بشريّاً مُسلّحاً

3
00:00:12,960 --> 00:00:15,580
!غوبكيتشي، سنغيّر مسارنا! لنلحق بهم

4
00:00:15,580 --> 00:00:16,620
!حسناً

5
00:00:16,620 --> 00:00:21,120
لحقنا بهم فوجدناهم مختبئين
على قارعة طريق، متخفّيين

6
00:00:21,630 --> 00:00:23,700
...بقليل من التنصُّت و

7
00:00:24,510 --> 00:00:29,130
تبيّن أنّهم هنا لاختطاف ابنة
زعيم قبيلة إيلفيّة

8
00:00:29,440 --> 00:00:32,260
يستهدفونها بينما هي في الطّريق
إلى الدّيار بعد أداء مهرجان ما

9
00:00:32,640 --> 00:00:37,640
علمتُ أيضاً أنّ أحداً بين الإيلف
قد مدّهم بمعلومات

10
00:00:38,390 --> 00:00:40,640
...بعد حوالي ساعتين من غروب الشّمس

11
00:00:44,480 --> 00:00:45,540
هناك

12
00:00:49,460 --> 00:00:51,410
تِلك هي ابنة زعيم القبيلة إذاً

13
00:00:52,080 --> 00:00:56,160
،الإيلفيّات جذّابات جدّاً بصورة عامّة
لكنّها الأجمل بينهن

14
00:01:09,300 --> 00:01:11,470
!تمّ تأكيد الهدف! هجوم

15
00:01:10,040 --> 00:01:14,300
حسناً، كنتُ لأشعر بالاستياء
...لمجرّد اختطافها، لذا

16
00:01:22,370 --> 00:01:24,310
غوبكيتشي، هل هم ثقيلون؟

17
00:01:24,760 --> 00:01:26,690
!البتّة

18
00:01:28,220 --> 00:01:31,530
سيترتّب علينا أن نصلّي ليرقد الباقي بسلام

19
00:03:08,060 --> 00:03:11,460
حسناً، فيما يخصّ الـ 12 بشريّاً
...الّذين أسرناهم

20
00:03:11,460 --> 00:03:13,470
!حسناً، سوف أتكلّم

21
00:03:12,460 --> 00:03:16,470
يبدو أنّ الجيش البشريّ سيبدأ
بتحرّكاته بعد 20 يوماً

22
00:03:13,470 --> 00:03:16,470
!سأتكلّم، لذا لا تقتلني

23
00:03:18,550 --> 00:03:22,830
أخذتُ قدرات الـ 12 جميعهم ولم أترك شيئاً

24
00:03:18,800 --> 00:03:21,020
،القوّة السرّية، المُعاقِب الفتّاك، النّاسك
،شعاع المهارة، مساهمة، فتك القفل، فخّ التّحرير

25
00:03:21,020 --> 00:03:23,230
،الشّعور بالفخّ، الشّعور بالعدوّ، الاغتيال المُحسَّن
،إتقان السّلاح الخفيّ، آفة الإنسان

26
00:03:23,230 --> 00:03:25,460
،الهجوم الفتّاك، ضربة الهالة الجارحة، الهجمة الخلفيّة
،طلقة الإبرة، رمية، مقاومة الألم الشّديد

27
00:03:25,460 --> 00:03:26,600
مقاومة التّميمة، مقاومة الاغتيال

28
00:03:32,610 --> 00:03:34,440
استيقظتِ أخيراً؟

29
00:03:38,030 --> 00:03:42,030
هذان الجناحان... الإيلف الأُخريات
لم يكنّ يملكن أجنحة

30
00:03:42,030 --> 00:03:44,500
أ-أين أنا بالضّبط؟

31
00:03:44,500 --> 00:03:47,370
—ماذا حدث لحرّاسي؟ هل هم

32
00:03:47,370 --> 00:03:48,620
اهدئي

33
00:03:48,970 --> 00:03:51,670
!هل ستسرق منّي عفّتي؟

34
00:03:51,670 --> 00:03:53,590
لا يستحقّ هذا الكلام جواباً حتّى

35
00:03:54,000 --> 00:03:56,070
سامحني على فقدان رباطة جأشي

36
00:03:56,070 --> 00:03:59,260
عندما كان التّوقيت مناسباً، أخبرتُها عمّا جرى

37
00:04:00,450 --> 00:04:04,770
هذا فظيع! ألم يكن بوسعك إنقاذ الآخرين؟

38
00:04:04,770 --> 00:04:09,430
...أن تبقى هادئاً وتترك الأمور تأخذ مجراها
!كيف أمكنك أن تكون قاسياً هكذا؟

39
00:04:05,770 --> 00:04:08,980
هذا ردٌّ منطقيّ على ما أعتقد

40
00:04:09,430 --> 00:04:12,270
!أنت فظيع جدّاً

41
00:04:14,500 --> 00:04:20,410
اسمعي، هذه المشكلة بينكم وبين
البشر ليست من شأننا

42
00:04:20,830 --> 00:04:24,520
بالإضافة إلى ذلك، ثمّة خائن بينكم

43
00:04:25,910 --> 00:04:28,170
،إذا كان لديكِ الوقت للارتعاد

44
00:04:28,170 --> 00:04:31,650
فربّما ينبغي أن تقلقي بشأن
التّعامل مع ذلك أوّلاً

45
00:04:39,470 --> 00:04:43,790
استريحي اليوم. سأعيدكِ إلى المنزل غداً

46
00:04:44,660 --> 00:04:48,930
حسناً، ما هذا الّذي سمعتُه عن الإيلف
ذات الجودة العالية؟

47
00:04:48,930 --> 00:04:51,210
هل يمكنني التذوّق؟

48
00:04:51,210 --> 00:04:53,400
!مُحال، لا يمكنك

49
00:04:53,940 --> 00:04:56,940
!أنت مملّ للغاية

50
00:04:58,910 --> 00:05:02,450
اليوم، غادرنا القرية لرؤية ديارها

51
00:05:03,590 --> 00:05:07,780
حسناً، ما سرّ الأجنحة الّتي كانت
منبعثة من ظهركِ؟

52
00:05:08,450 --> 00:05:13,630
هذه... لا يمتلكها إلّا الإيلف الرّفيعين

53
00:05:13,630 --> 00:05:16,960
عادةً ما نخفيها داخل أجسادنا

54
00:05:16,960 --> 00:05:22,370
،الإيلف الرّفيعون هم ترقية للإيلف
والأجنحة تسمح لهم بالتّحليق

55
00:05:22,370 --> 00:05:24,930
،عادةً لا ينبغي أن تُكشَف للآخرين

56
00:05:24,930 --> 00:05:28,970
،لكن لأنّني ما زلتُ ناقصة الخبرة
...تظهر فجأة أحياناً

57
00:05:29,320 --> 00:05:32,480
،وهكذا، بعد ثلاث ساعات من المشي

58
00:05:33,050 --> 00:05:35,980
...وصلنا إلى قرية الإيلف، لكن

59
00:05:40,960 --> 00:05:45,570
أكثر من 25 منهم، برؤوس سِهام ميثريليّة

60
00:05:45,570 --> 00:05:48,990
أوغر أمثالنا ينبغي أن يتمكّنوا من تحمُّل
بضع عشرات من السِّهام

61
00:05:48,990 --> 00:05:53,000
!انتظروا أرجوكم! أنقذوا حياتي

62
00:05:57,890 --> 00:06:02,510
كان الوضع متوتّراً لبعض الوقت، لكن
سُمح لنا بدخول القرية

63
00:06:03,760 --> 00:06:05,010
!أبي

64
00:06:05,410 --> 00:06:07,730
سامحني على إثارة قلقك

65
00:06:07,730 --> 00:06:11,920
ليس عليكِ الاعتذار. تسرّني عودتكِ بالسّلامة

66
00:06:11,920 --> 00:06:15,980
أشكركما جزيل الشّكر على إنقاذ ابنتي

67
00:06:16,630 --> 00:06:19,020
أنا زعيم هذه القرية

68
00:06:19,720 --> 00:06:22,010
...حسناً، لندخل صلبَ الموضوع

69
00:06:22,670 --> 00:06:26,180
لم أنقذ ابنتك عن نيّة طيّبة خالصة

70
00:06:27,370 --> 00:06:28,860
مكافأة إذاً؟

71
00:06:29,470 --> 00:06:31,320
إليّ بها

72
00:06:31,320 --> 00:06:32,540
حاضرة

73
00:06:33,080 --> 00:06:36,090
سأدعه يُثبِت لي ما الّذي تعنيه ابنته له

74
00:06:36,090 --> 00:06:40,550
ستكون فرصة مؤاتية لفهم حُكمه

75
00:06:41,710 --> 00:06:43,360
فيلنوت

76
00:06:43,360 --> 00:06:46,570
كنز عائليّ من كنوزنا، وأداة سحريّة

77
00:06:46,980 --> 00:06:48,550
!أبي؟

78
00:06:48,550 --> 00:06:52,980
عدتِ سليمة. هذا لا يساوي شيئاً

79
00:06:54,450 --> 00:06:57,150
أعتذر على اختبارك

80
00:06:57,150 --> 00:07:02,570
للتّعويض عن ذلك، لديّ بعض المعلومات
الّتي ستفيدك غالباً

81
00:07:04,240 --> 00:07:06,070
وما هي؟

82
00:07:07,240 --> 00:07:09,580
تحرُّكات الجيش البشريّ على سبيل المثال

83
00:07:10,280 --> 00:07:13,430
أعتقد سنصبح أصدقاء بسرعة

84
00:07:13,430 --> 00:07:17,610
أعطانا الأب الإيلفيّ كثيراً
من العتاد الميثريليّ

85
00:07:17,610 --> 00:07:22,640
بالمقابل، زوّدتُه بسكاكين حجر الرُّوح
،وأجراف أدوات سحريّة

86
00:07:22,640 --> 00:07:24,470
لنختتم صفقتنا

87
00:07:24,990 --> 00:07:28,470
،آمل ألّا تمانع سؤالي

88
00:07:29,740 --> 00:07:33,940
لكن مجموعة من مقاتلينا النّخبة
...فُقِدوا منذ قرابة 20 يوماً

89
00:07:35,130 --> 00:07:36,940
هل سمعت شيئاً؟

90
00:07:36,940 --> 00:07:39,040
!لا، لم أسمع

91
00:07:40,730 --> 00:07:44,300
في طريق العودة، كانوا قد حضّروا لنا
بعض هدايا الوداع

92
00:07:44,300 --> 00:07:47,140
هذه بعض الأدوية والخمر اللّذيذ
من تصنيع قريتنا

93
00:07:47,140 --> 00:07:49,000
آمل أن تستمتعوا بها

94
00:07:49,000 --> 00:07:52,990
!إذا احتجت مساعدة صديق، فاستدعِنا فحسب
!ستحصل على حسم من صديق

95
00:07:53,850 --> 00:07:55,500
!هذا لذيذ

96
00:07:55,500 --> 00:07:58,780
!كيف للنّكهة أن تكون غنيّة ومقرمشة هكذا؟

97
00:07:58,780 --> 00:08:02,180
هذا سبب آخر دعاني للانسجام
مع زعيم قبيلة الإيلف

98
00:08:08,350 --> 00:08:12,900
غوبمي... طلع الصّباح. انهضي

99
00:08:16,780 --> 00:08:21,150
كانت قد ترقّتْ إلى متحوِّر دامبير أثناء اللّيل

100
00:08:21,920 --> 00:08:25,610
ليس هي فحسب. حصلنا على ثمانية
من الهوبغوبلن الجدُد

101
00:08:26,030 --> 00:08:30,030
لا تزيلي هذا الزُجاجات ما لم
نكن بالقرب من العدوّ يا غوبمي

102
00:08:31,020 --> 00:08:33,030
حسناً، أعلم

103
00:08:33,030 --> 00:08:37,090
وفقاً لكلامها، برَكة من إله الجليد

104
00:08:37,090 --> 00:08:38,860
منحَتْها قدرة صنع

105
00:08:38,860 --> 00:08:40,310
والتحكّم بكمّيات كبيرة من الجليد

106
00:08:40,840 --> 00:08:42,430
قدرة عينَي الشرّ خاصّتها

107
00:08:42,430 --> 00:08:45,370
تستطيع فتن الأعداء ليتقاتلوا فيما بينهم

108
00:08:45,370 --> 00:08:49,550
ونقطة الضّعف المعتادة الّتي تعاني منها أمام
أشعّة الشّمس عُوِّضَتْ بالبركة الّتي تلقَّتْها

109
00:08:50,580 --> 00:08:51,550
...رغم ذلك

110
00:08:52,980 --> 00:08:58,000
مظهرها... مألوف لي، لسبب ما

111
00:08:58,000 --> 00:08:59,310
هل من مُشكلة؟

112
00:08:59,310 --> 00:09:01,390
لا. أنا مندهش من مظهركِ فحسب

113
00:09:01,390 --> 00:09:02,950
!أنت

114
00:09:03,610 --> 00:09:05,320
!ها أنا ذي

115
00:09:05,320 --> 00:09:08,820
غوبي قد تطوّرتْ إلى نصف لورد الأرض

116
00:09:09,330 --> 00:09:12,320
لدى لورد الأرض القدرة على التحكّم بالأرضيّة

117
00:09:12,320 --> 00:09:15,290
تستطيع تحديد نقاط الضّعف في صخر
...الأساس بالتّقييم الجيولوجيّ

118
00:09:15,290 --> 00:09:16,980
،وكذلك قدرة على جعل جسدها أقوى

119
00:09:16,980 --> 00:09:20,460
وسحر ضوء لكشف المجوهرات

120
00:09:20,460 --> 00:09:22,880
!أريد الكثير يا سي

121
00:09:22,880 --> 00:09:26,340
وهوبساتو تطوّرَتْ إلى نصف لورد دمويّ

122
00:09:27,090 --> 00:09:31,840
صفتهم المميّزة هي القدرة على التحكّم
بالدّماء وتحويله إلى سلاح

123
00:09:33,010 --> 00:09:34,850
...لكن يدفعني هذا للتّساؤل

124
00:09:35,520 --> 00:09:37,640
،المواقع والأشكال مختلفة

125
00:09:37,640 --> 00:09:40,060
لكن جميعهن لديهن وشوم تشبه وشومي

126
00:09:40,060 --> 00:09:44,860
،يُقال بأنّ الوشوم تمنحهن القوّة
لذا آمل أن أكتشف ذلك مع الوقت

127
00:09:45,380 --> 00:09:48,580
!هل تطوّرتم جميعاً مجدّداً؟

128
00:09:48,580 --> 00:09:53,360
!يبدو أنّكم بحاجة أسماء جديدة إذاً

129
00:09:53,360 --> 00:09:56,470
،هوبسي ستكون سبيلسي، وغوبمي ستكون دامي

130
00:09:56,470 --> 00:09:59,870
وهوبساتو هي الآن بلودساتو، وغوبي هي أيرثي الآن

131
00:09:57,570 --> 00:09:58,710
!أجل

132
00:09:59,870 --> 00:10:03,120
،وغوبكيتشي سيكون أوغركيتشي
،وغوبجي سيكون هوبجي

133
00:10:02,560 --> 00:10:06,500
حسناً، أعتقد كلّ ما يهمّ هو أن نستطيع
...تمييز بعضنا الآخر

134
00:10:03,120 --> 00:10:05,450
!وغوبرو هو أوغرو

135
00:10:07,360 --> 00:10:11,510
هكذا تبدو الأمور من حيث قوّة
كلّ عِرق مختلف

136
00:10:12,350 --> 00:10:17,260
حالما تبدأ حربهم مع البشر، سيلجأ
الإيلف إلينا طلباً للمساعدة

137
00:10:17,820 --> 00:10:21,520
،وكلّما كان لدينا عتاد أكثر
ازدادت خياراتنا التّكتيكيّة

138
00:10:22,020 --> 00:10:26,020
نتيجة ذلك، وزّعتُ مجموعة جديدة
من أقراط الأذن للاتّصالات

139
00:10:26,470 --> 00:10:27,380
...باستثناء

140
00:10:27,380 --> 00:10:29,700
لا يمكننا! لا نستطيع وضعها فحسب

141
00:10:29,700 --> 00:10:35,030
من المُحرَّم على الإيلف أن يزيّنوا
أو يدعوا آذانهم تتضرّر

142
00:10:35,740 --> 00:10:37,540
فليكُن إذاً

143
00:10:38,160 --> 00:10:43,570
استغرقتُ وقتي في إعفاء الإيلف
من تلك الذّريعة

144
00:10:45,210 --> 00:10:49,000
بإضافة الكوبولد والإيلف الآن
،إلى الّذين لديهم أقراط

145
00:10:49,480 --> 00:10:53,510
كان هناك المزيد من المشاركين
في تدريبنا اليوميّ اليوم

146
00:10:53,850 --> 00:10:57,090
في وقت لاحق، أقمنا منافسة قتال تدريبيّة

147
00:10:57,640 --> 00:10:59,620
كان الخصوم هياكل عظميّة صنعتُها

148
00:10:59,620 --> 00:11:02,890
بقدرة استدعاء الموتى الأحياء الأدنى
...الّتي اكتسبتُها قبل أيّام

149
00:11:06,680 --> 00:11:10,570
،باستخدام عِظام سوداء، بدلاً من البيضاء
وعتاد ثقيل شديد

150
00:11:11,540 --> 00:11:16,570
كلّما امتلك الهيكل العظميّ درعاً
أكثر، ازدادت جودته

151
00:11:18,070 --> 00:11:21,080
حتّى الإيلف، الّذين يحملون أسلحة
،ميثريليّة فعّالة ضدّ الموتى الأحياء

152
00:11:21,080 --> 00:11:22,830
...خسروا معظم نِزالاتهم

153
00:11:22,830 --> 00:11:25,580
لكن حتّى الخاسرين يبدو أنّهم قبلوا النّتيجة

154
00:11:25,930 --> 00:11:30,090
إنّ بناء الثِّقة بالطّريقة الطّبيعيّة
هي الأمثل في نهاية المطاف

155
00:11:33,090 --> 00:11:39,340
إذا استخدمتُ كمّيةً أقلّ من المانا، أستطيع صنع
هياكل عظميّة وزومبيّات عاديّة وموتى أحياء آخرين

156
00:11:39,340 --> 00:11:41,170
...تساءلتُ عن مذاقها

157
00:11:41,170 --> 00:11:44,880
لكن يبدو أنّه لا يمكن أكل الأشباح
نظراً لعدم امتلاكها شكلاً ملموساً

158
00:11:44,880 --> 00:11:50,360
الموتى الأحياء المختلفون شكّلوا خصوماً
،أقوياء للتّمرين وكسب الخبرة

159
00:11:50,700 --> 00:11:55,020
لكنّها تتطهّر بعد تعرّضها لضوء
النّهار ببضع عشرات من الثّواني

160
00:11:55,020 --> 00:11:57,490
عدم القدرة على استخدامهم
في النّهار لَهو مشكلة

161
00:11:58,670 --> 00:12:02,490
حاليّاً، أركّز على تدريب الإيلف والكوبولد

162
00:12:03,000 --> 00:12:07,380
فأساساً، هذه القرية تعجّ حاليّاً
،بأكثر من 100 عضو

163
00:12:07,380 --> 00:12:10,000
والكوبولد في مركز منخفض جدّاً

164
00:12:10,000 --> 00:12:13,000
...على هذا المُعدّل، ستغدو الأمور صعبة عليهم

165
00:12:10,000 --> 00:12:13,000
هل يمكنني الإمساك بهذا الزّومبي خائر القوى؟

166
00:12:13,000 --> 00:12:16,850
الطّريقة الوحيدة لتجاوز ذلك هي
أن يعملوا بجدّ ليصبحوا أقوى

167
00:12:13,670 --> 00:12:16,850
غوبفو، أليس أكل كلّ هذا اللّحم
الفاسد ضارّاً لك؟

168
00:12:16,850 --> 00:12:18,760
اللّحم الفاسد هو أطيب اللّحم

169
00:12:19,660 --> 00:12:22,760
اليوم، توجّهتُ إلى الكهوف حيث
يقطن الكوبولد

170
00:12:23,160 --> 00:12:27,520
بعد أخذ ممتلكاتهم، تركتُ
آرثي يتولّى زمام الأمر

171
00:12:27,520 --> 00:12:29,360
!حسناً

172
00:12:30,130 --> 00:12:33,050
ينبغي لهذا أن يضمن عدم
ظهور أي هيكل عظميّ

173
00:12:33,050 --> 00:12:34,780
...وكان هناك أمر آخر

174
00:12:35,730 --> 00:12:38,650
طلبتُ من الكوبولد أن يتمرّنوا
على الصّيد الجماعيّ

175
00:12:38,990 --> 00:12:41,660
كانت الفكرة هي تعزيز عدد وحوشنا
المُرافقين، الذّئاب السّوداء

176
00:12:42,340 --> 00:12:45,160
لكن أثبتوا بأنّهم يتحرّكون بشكل
،أفضل بكثير ممّا توقّعت

177
00:12:46,020 --> 00:12:48,960
ممّا سمح لنا بجمع ما مُجمله 20

178
00:12:49,950 --> 00:12:51,850
،لم يكن هناك أي قائد قطيع ضمن هذا العدد

179
00:12:51,850 --> 00:12:54,920
لكن الذّئاب الإضافيّين ينبغي
أن يكونوا نافعين كوحوش مُرافقين

180
00:12:54,920 --> 00:12:58,920
،وفي الطّريق، واجهنا خنزير الاصطدام البرّي
والّذي قيل بأنّه قاسٍ كالحجر

181
00:12:59,420 --> 00:13:01,840
!كيف لي أن أبقى هادئة بعد سماع هذا؟

182
00:13:12,560 --> 00:13:16,570
آسفة بشأن هذا! كنتُ في الواقع
!أحاول أن أحدّ من قوايّ

183
00:13:13,490 --> 00:13:16,570
وُضِع في وعاء كبير وأصبح يخنة في ذلك المساء

184
00:13:17,520 --> 00:13:19,570
!رائع

185
00:13:19,570 --> 00:13:25,580
وجدتُ الشّكل المُطوَّر من الفأس الّذي
أضررتُ به أثناء مقاتلة الدبّ الأحمر

186
00:13:22,570 --> 00:13:24,900
...لذا من حيث التّحسينات

187
00:13:26,590 --> 00:13:29,510
تقريباً تمّ تعديله برمّته

188
00:13:29,510 --> 00:13:33,620
بسبيكة حجر روحيّ، وحديد، وميثريل

189
00:13:34,080 --> 00:13:36,060
!عملتُ عليه بجدّ

190
00:13:36,060 --> 00:13:38,490
أنا مندهش حقّاً

191
00:13:38,490 --> 00:13:41,090
منذ متى أصبحتِ قادرة على صنع شيء كهذا؟

192
00:13:41,090 --> 00:13:42,840
...في الواقع

193
00:13:44,020 --> 00:13:47,970
،باكتسابها خبرة في التّعامل مع الأحجار الرُّوحيّة

194
00:13:47,970 --> 00:13:50,930
ترقّت الحدّادة إلى حدّادة عناصريّة

195
00:13:52,950 --> 00:13:57,860
يوم آخر، صيد كوبولد آخر. وجدتُ
نفسي أصطاد خنازير الاصطدام البرّية

196
00:14:01,860 --> 00:14:04,400
حسناً، عمّاذا أردت التكلّم؟

197
00:14:04,400 --> 00:14:07,120
فقط... عِدني ألّا تضحك يا أوغرو

198
00:14:08,270 --> 00:14:12,390
...في الحقيقة، لطالما أحببتُ آرثي

199
00:14:13,370 --> 00:14:15,630
أعلم أنّ هذا قد يبدو مفاجئاً

200
00:14:15,630 --> 00:14:18,420
لا، توقّعتُ ذلك

201
00:14:19,450 --> 00:14:22,280
أعني بأنّك لست حاذقاً
تماماً يا أوغركيتشي

202
00:14:22,280 --> 00:14:23,770
لـ-لستُ كذلك؟

203
00:14:23,770 --> 00:14:24,630
لا

204
00:14:25,560 --> 00:14:30,060
،منذ أصبحتْ نصف لورد أرض
...ازدادت آرثي جمالاً

205
00:14:30,060 --> 00:14:34,140
...و-ورؤيتها هكذا يجعلني لا أحتمل

206
00:14:34,770 --> 00:14:38,150
!لكن لا أعرف ماذا أقول لها

207
00:14:38,150 --> 00:14:41,720
!هـ-هـ-هل يمكنك مساعدتي؟! أرجوك

208
00:14:38,150 --> 00:14:41,720
الآن، يراودني هذا الشُّعور الدّافئ في قلبي

209
00:14:41,720 --> 00:14:43,150
!أوغرو

210
00:14:43,870 --> 00:14:46,660
!ولذا، اللّيلة هي لحظة الحقيقة

211
00:14:46,660 --> 00:14:47,830
!ا-اللّيلة؟

212
00:14:47,830 --> 00:14:49,340
!ستكون بخير

213
00:14:49,340 --> 00:14:52,160
وإن لم يكن كذلك، على الأقلّ ستخرج
بأقلّ الأضرار بما أنّك سارعت في ذلك

214
00:14:52,630 --> 00:14:56,670
سأخبرك كيف سار الأمر غداً

215
00:15:02,460 --> 00:15:04,670
ما الأمر يا كيتشي؟

216
00:15:06,370 --> 00:15:08,180
...أ-أنا

217
00:15:09,050 --> 00:15:13,120
!أريد أن نكون سعيدين... معاً

218
00:15:15,110 --> 00:15:17,940
...الحقيقة هي، يا كيتشي... أنا

219
00:15:27,630 --> 00:15:30,680
ضربني ضرباً مُبرِحاً بضع مرّات

220
00:15:31,410 --> 00:15:34,050
!أشعر برشاقة حقّاً اليوم

221
00:15:34,050 --> 00:15:36,350
!وأنا أقوى من أيّ وقت مضى

222
00:15:36,760 --> 00:15:38,880
!يعزو كلّ الفضل لك يا أوغرو

223
00:15:38,880 --> 00:15:41,680
حسناً، يسرّني أنّني أفدتُك

224
00:15:41,680 --> 00:15:44,290
يبدو أنّ اعترافه في ليلة الأمس
سار على ما يُرام

225
00:15:44,880 --> 00:15:49,420
كانت آرثي قد تحدّثَتْ مع دامي
...حول الأمر البارحة

226
00:15:49,420 --> 00:15:53,310
لذا، بيننا نحن الاثنان، رتّبنا السّاحة لهما

227
00:15:53,890 --> 00:15:58,760
آمل فقط ألّا يتحمّس أوغركيتشي كثيراً
...ويفسد الأمر أثناء العلاقة

228
00:15:58,760 --> 00:16:00,400
!أوغرو

229
00:16:00,770 --> 00:16:02,710
هل انتهى التّدريب؟

230
00:16:02,710 --> 00:16:05,650
يبدو أنّه لم يكن هناك حاجة للقلق

231
00:16:07,030 --> 00:16:11,100
كان قويّاً ونابضاً بالطّاقة لدرجة أنّني
جعلتُ هيكلاً عظميّاً أسود يتولّى الأمر

232
00:16:12,130 --> 00:16:13,410
!آسفة بشأن ذلك

233
00:16:13,410 --> 00:16:16,040
بعد التّدريب، خرجنا نحن الرُّباعيّ
المعتاد للصّيد

234
00:16:16,770 --> 00:16:19,620
كان هناك الكثير من الوحوش الحشرات
،الّتي لم أرها من قبل

235
00:16:19,620 --> 00:16:22,630
ممّا أفادنا كثيراً في جمع مواد صلبة ومصفّحة

236
00:16:23,110 --> 00:16:25,590
.الاستلاخ. نموّ الجناح الغمديّ. حافّة النّهاية. القتل الصّامت
نفخة القرن. تنافُر. طفيليّ

237
00:16:29,740 --> 00:16:32,020
هيكل خارجيّ؟

238
00:16:32,740 --> 00:16:34,390
لنجرّب ذلك

239
00:16:38,190 --> 00:16:40,900
...أبدو مثل أولئك الأبطال الخارقين المتحوّلين

240
00:16:43,180 --> 00:16:44,510
،إنّه متين كما هو مُتوقَّع

241
00:16:44,510 --> 00:16:47,760
ولديه القدرة على إصلاح نفسه
وتفريق وقع الضّربات كذلك

242
00:16:48,400 --> 00:16:51,730
لكن لا يُعجبني كونه مُلفِتاً للأنظار

243
00:16:51,730 --> 00:16:54,770
أوتظنّ ذلك؟ أراه رائعاً

244
00:16:54,770 --> 00:16:57,660
...فضلاً عن ذلك، يروقني زيّي المعتاد

245
00:16:59,970 --> 00:17:04,360
يبدو أنّ ملابسي العاديّة استُخدِمَتْ
لصنع الهيكل الخارجيّ

246
00:17:04,360 --> 00:17:08,420
أعجبني ذلك الزيّ. كان مصنوعاً
...من إهاب الدبّ الأحمر

247
00:17:13,430 --> 00:17:17,930
فهمت. أريد أن أسجّل أشكالاً
...للمعارك الجوّية والبحريّة، أيضاً

248
00:17:20,440 --> 00:17:21,930
!يستطيع التّحليق

249
00:17:20,440 --> 00:17:24,030
بنموّ الجناح الغمديّ، يمكنني
أن أبرز أجنحة حشرات

250
00:17:21,930 --> 00:17:23,440
!هذا رائع يا أوغرو

251
00:17:24,030 --> 00:17:27,440
لكن هذا ليس سهلاً. أحتاج للتمرّن

252
00:17:27,440 --> 00:17:28,830
!لقد سقط

253
00:17:28,830 --> 00:17:30,450
!أحسنت يا أوغرو

254
00:17:30,860 --> 00:17:34,730
،أحضرتُ لحم خنزير الاصطدام البرّي
وأكلناه جميعنا معاً

255
00:17:34,730 --> 00:17:37,330
كان يوماً مُثمِراً حقّاً

256
00:17:37,580 --> 00:17:40,580
هيَجان. هجمة الذّيل

257
00:17:42,330 --> 00:17:44,670
كم مضى من وقت منذ آخر مرّة أمطرت؟

258
00:17:45,490 --> 00:17:49,170
حسناً. أعتقد سأقضي اليوم
في الصّناعة الحِرفيّة

259
00:17:49,170 --> 00:17:52,180
!أوغرو! تعال وبارزني

260
00:17:52,930 --> 00:17:56,080
كانت ذات الشّعر الأحمر القصير
،تحقّق تقدُّماً ثابتاً

261
00:17:56,080 --> 00:17:58,920
ما دفعها لتطلب التّدريب مؤخّراً

262
00:17:59,700 --> 00:18:03,420
انتقلت من تذكيري بجرو أو كلب أصغر

263
00:18:03,790 --> 00:18:06,200
إلى الشّعور بدوبرمان

264
00:18:06,910 --> 00:18:10,690
وهكذا بدأتُ الصّباح أبارزها

265
00:18:11,130 --> 00:18:14,700
بعد بذل جهد كبير، توجّهتُ إلى الحدّادة

266
00:18:15,100 --> 00:18:20,520
مؤخّراً، كانت تزور الإيلف وتناقش
أفكارَ حول أسلحة جديدة معهم

267
00:18:16,370 --> 00:18:20,520
المزيد من الميثريل! سيكون هذا مفيداً

268
00:18:21,200 --> 00:18:24,020
لا، كلّ هذا جزء من دراساتنا

269
00:18:21,880 --> 00:18:25,710
بالمناسبة، اسمهما هو كيروي وآروي

270
00:18:26,450 --> 00:18:30,050
يجب أن يُحوّل الميثريل إلى ملغمة
قبل أن تتمّ معالجته

271
00:18:30,050 --> 00:18:34,720
سبيكة الحجر الرّوحيّ المُستخدَمة في مِطرَدي
هي أيضاً نوع من الملغمة

272
00:18:35,210 --> 00:18:39,220
،إنّها تعمل على تطوير نشّابيّة متكرّرة

273
00:18:40,930 --> 00:18:44,810
وتبدو الأمور جيّدة جدّاً حتّى طلبتُ منها
المضيّ قُدماً في التّصنيع

274
00:18:44,810 --> 00:18:47,190
هل يمكنكِ استخدام هذا لصنع
سلاح آخر لي؟

275
00:18:45,340 --> 00:18:47,810
وفّرتُ لها أيضاً مزيداً من الملغمة

276
00:18:47,190 --> 00:18:48,520
أعتمد عليكِ

277
00:18:49,190 --> 00:18:51,570
!سأتولّى الأمر

278
00:18:51,570 --> 00:18:53,880
في ذلك المساء. ساعدتُ الأختين الطبّاختين

279
00:18:53,880 --> 00:18:56,080
هل لي بصحن حساء؟

280
00:18:54,770 --> 00:18:59,560
يبدو أنّ كلتيهما حصلتا أيضاً على عمل
جديد: رئيس طبّاخين

281
00:18:56,810 --> 00:18:58,800
كيف تسير ترتيبات الطّعام؟

282
00:18:59,880 --> 00:19:03,100
بعد العشاء، طلبتُ منهما تجربة إعادة
إنشاء أطباق من حياتي الماضية

283
00:19:01,030 --> 00:19:03,710
!مذهل! إنّها مقرمشة

284
00:19:03,710 --> 00:19:05,080
كرقائق البطاطس وما شابه

285
00:19:05,080 --> 00:19:09,750
،لم أسمع بمعظم هذه الأطباق من قبل
!لكنّها مثيرة للاهتمام حقّاً

286
00:19:09,750 --> 00:19:12,340
!كلّما زاد تعقيدها، استطعنا التعلّم أكثر

287
00:19:12,770 --> 00:19:17,340
عقب ذلك، اجتمعتُ مع الخيميائيّة لمناقشة
تصنيع أدوات سحريّة

288
00:19:17,880 --> 00:19:22,050
تبيّن أنّ الهيكل العظميّ الأسود نافع جدّاً

289
00:19:22,610 --> 00:19:27,410
لدى هذا الظّفر العظميّ القدرة على تجميد
أيّ شيء يصيبه في مكانه

290
00:19:27,850 --> 00:19:32,860
إنّه أوّل شيء أنتجتُه منذ أصبحتُ صانعة أدوات

291
00:19:33,310 --> 00:19:36,860
اعتبره أنا واعتنِ به جيّداً

292
00:19:38,070 --> 00:19:42,040
سلوكها اللّعوب غير المعتاد أثّر بي

293
00:19:42,040 --> 00:19:43,240
...ثمّ

294
00:19:43,240 --> 00:19:46,750
!ها أنت ذا تتسلّل من جديد

295
00:19:46,750 --> 00:19:48,540
...بالنّسبة لما حدث تالياً

296
00:19:50,280 --> 00:19:51,750
لن أسهب

297
00:19:52,610 --> 00:19:54,760
!أوغرو! تعال بسرعة

298
00:19:55,600 --> 00:19:58,260
!هـ-هناك بعض الإيلف الغرباء عند المدخل

299
00:20:01,150 --> 00:20:05,270
أتينا بالنّيابة عن صديقك، زعيمنا

300
00:20:05,630 --> 00:20:08,590
...مرّوا بجانب زملائهم القدامى عند الدّخول، لكن

301
00:20:09,680 --> 00:20:14,780
كان لدى أقراط الأذن تأثير تنكُّريّ
جعلهم يبدون وكأنّهم إيلف ظلاميّون

302
00:20:15,760 --> 00:20:20,930
،يتقدّم الجيش البشريّ أخيراً نحو غابة كوديل

303
00:20:21,600 --> 00:20:25,450
بجيش كبير سنكون عاجزين عن صدّه بمفردنا

304
00:20:25,810 --> 00:20:29,290
أتيتُ إلى هنا لتأمين مساعدتكم

305
00:20:29,650 --> 00:20:33,720
المعذرة... ماذا حدث لقوّتكم النّخبة؟

306
00:20:33,720 --> 00:20:37,320
قـ-قيل لنا أن نعتبرهم في عداد الموتى

307
00:20:37,750 --> 00:20:39,300
...هـ-هكذا إذاً

308
00:20:39,740 --> 00:20:44,340
الثّمن غير مهمّ. يريد زعيمنا أن يُقضى
على العدوّ بشكل كامل

309
00:20:45,010 --> 00:20:50,060
لكن سيُعدّ العقد لاغياً في حالة الانسحاب

310
00:20:50,060 --> 00:20:54,250
أشكرك على التّنبيه وأقبل
بالعمل بكلّ تواضُع

311
00:20:54,250 --> 00:20:56,820
لكن بدأنا بتحرّكاتنا الخاصّة

312
00:20:57,730 --> 00:20:59,150
أعطوا هذا لزعيمكم

313
00:20:59,820 --> 00:21:02,580
سيتيح له الاتّصال معنا

314
00:21:02,930 --> 00:21:04,510
سأفعل ذلك

315
00:21:05,130 --> 00:21:06,760
أستأذن بالانصراف

316
00:21:06,760 --> 00:21:09,830
أجل، المعلومات هي دوماً سلاح حاسم

317
00:21:10,470 --> 00:21:13,840
لقد طلبتُ من مجموعتي تستطلع
في منطقة الغابة بالفعل

318
00:21:14,420 --> 00:21:19,490
من أراد السّلام، فليستعدّ للحرب"، صحيح؟"

319
00:21:20,900 --> 00:21:22,820
اجمعوا الآخرين

320
00:21:24,030 --> 00:21:26,850
حان الوقت للتّطبيق العمليّ
لكلّ ما عملنا عليه

321
00:21:26,850 --> 00:21:29,610
!ابتداء من اليوم، نحن سريّة مرتزقة

322
00:21:29,610 --> 00:21:31,320
ما-ماذا تعني؟

323
00:21:31,320 --> 00:21:34,860
ببساطة، نحن فرقة احترافيّة من المقاتلين

324
00:21:36,040 --> 00:21:37,860
!يبدو هذا رائعاً

325
00:21:37,860 --> 00:21:40,100
وماذا ستُدعى؟

326
00:21:41,270 --> 00:21:42,780
بارابيلام

327
00:21:44,200 --> 00:21:48,120
،والآن يا سريّة المرتزقة بارابيلام
!استعدّي للقتال

328
00:21:50,080 --> 00:21:51,120
!بارابيلام

329
00:21:51,710 --> 00:21:55,130
!بارابيلام! بارابيلام

330
00:21:55,130 --> 00:21:56,040
!بارابيلام

331
00:21:56,040 --> 00:21:59,960
والآن... حان الوقت لأوّل عمل ضخم لنا