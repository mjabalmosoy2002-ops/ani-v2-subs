1
00:00:01,290 --> 00:00:04,730
...بعد ستّة أيّام من مغادرة غابة كوديل

2
00:00:04,730 --> 00:00:09,140
وصلنا إلى وجهتنا: تريينت، مدينة الحامية

3
00:00:12,350 --> 00:00:14,110
،ومثلما علمنا مسبقاً

4
00:00:14,110 --> 00:00:18,510
يشكّل أنصاف البشر حوالي 25 بالمئة
من سكّان المنطِقة. أكثر من المعتاد

5
00:00:18,510 --> 00:00:20,850
!لا تدعوا الأوغر المشبوه يدخل البلدة

6
00:00:18,510 --> 00:00:20,850
!أحضروا الحرّاس

7
00:00:20,850 --> 00:00:23,270
!اطلبوا من السكّان أن يحتموا

8
00:00:21,510 --> 00:00:23,680
!أي مركبة هي هذه؟

9
00:00:23,680 --> 00:00:27,990
يبدو أنّ أوغر يجرّ معه مجموعة كاملة
من البشر يُعدّ مشبوهاً

10
00:02:05,760 --> 00:02:11,400
أصدقاؤنا التجّار السّابقون شرحوا
،الوضع بصورة أشمل

11
00:02:11,400 --> 00:02:14,650
ما سمح لنا بالوصول أخيراً إلى نُزُلنا

12
00:02:15,550 --> 00:02:20,060
كان ذلك عندما أخبرتُ الفتيات
البشريّات بأمر مهمّ

13
00:02:20,540 --> 00:02:22,720
،بينما نقيم في البلدة

14
00:02:22,720 --> 00:02:26,190
أريدكن أن تقرّرنَ ما إذا أردتُن البقاء
هنا أو العودة معي

15
00:02:27,310 --> 00:02:30,450
سأحترم قراركن

16
00:02:31,070 --> 00:02:38,180
أجل. نظراً إلى أنّهن هوجِمن أثناء
...سفرهن واختُطِفن قسريّاً

17
00:02:39,240 --> 00:02:44,030
بصراحة، ما كنتُ لأرغب في تركهن
...وشأنهن، لكن

18
00:02:45,590 --> 00:02:50,570
بعد ذلك، ذات الشّعر الأحمر القصير
دلّتْني إلى بناء النّقابة

19
00:02:50,570 --> 00:02:53,020
هل أنت متأكّد من أنّك تريد
أن تدفع هذا المبلغ؟

20
00:02:51,360 --> 00:02:55,570
الآخرون باعوا المُنتجات والمواد
الخامة الّتي كنّا قد جمعناها

21
00:02:53,020 --> 00:02:54,480
شكراً لك

22
00:02:54,480 --> 00:02:55,570
!هذا رائع

23
00:02:55,570 --> 00:02:56,840
!إنّه وحش

24
00:02:56,300 --> 00:02:59,070
...تعرّضتُ لهجوم عدّة مرّات

25
00:02:56,840 --> 00:02:57,900
!ماذا يفعل هنا؟

26
00:02:59,530 --> 00:03:01,030
لكن ضربتُهم حتّى أُغمَى عليهم فحسب

27
00:03:01,030 --> 00:03:04,650
...في الواقع، ندير سريّة مرتزقة

28
00:03:04,650 --> 00:03:06,580
هذا سيّئ. إنّها غائبة عن الوعي وقوفاً

29
00:03:07,000 --> 00:03:10,460
حسناً، أهذه أوّل مرّة تؤدّون
العمل فيها معنا؟

30
00:03:10,920 --> 00:03:14,580
أوّلاً، يجب تسجيلكم كمُغامرين

31
00:03:14,580 --> 00:03:16,600
!يمكنني تولّي المعاملات الورقيّة

32
00:03:17,290 --> 00:03:20,970
أخيراً، التقينا جميعاً وذهبنا للتسوُّق

33
00:03:18,090 --> 00:03:19,920
يا له من اختيار جيّد

34
00:03:21,290 --> 00:03:24,820
سنذهب لشراء الملابس

35
00:03:24,820 --> 00:03:25,980
هل ستأتي يا أوغر؟

36
00:03:25,980 --> 00:03:29,090
أريد جمع بعض المعلومات

37
00:03:30,110 --> 00:03:35,610
جعلتُ نفسي أبدو كما كنتُ في حياتي
الماضية كـ توموكي كاناتا

38
00:03:36,680 --> 00:03:40,480
سأتنكّر كبشريّ وأمشي في البلدة بمفردي

39
00:03:40,480 --> 00:03:41,620
!حسناً

40
00:03:41,920 --> 00:03:44,750
هل هذا الشّخص هو أوغر حقّاً؟

41
00:03:44,750 --> 00:03:48,120
في هذه المرحلة، التّفكير في الأمر
هو مضيعة للوقت

42
00:03:48,560 --> 00:03:53,620
بينما أمشي في البلدة، سمعتُ إشاعات
عن أوغر مليء بالوشوم في كلّ أرجائها

43
00:03:53,620 --> 00:03:55,950
يُزعَم أنّه تمّ إيقافه بواسطة
!النّقابة قبل أيّام

44
00:03:55,950 --> 00:03:57,230
!لكنّه وحش

45
00:03:56,380 --> 00:03:59,640
سمعة الأوغر سيّئة حقّاً

46
00:03:57,230 --> 00:03:59,640
!ماذا لو بدأ يهيج؟

47
00:03:59,950 --> 00:04:03,790
لن أتمكّن من التّرويج لسَريّتي
قبل بعض الوقت هكذا

48
00:04:04,640 --> 00:04:05,530
شكراً على المجيء

49
00:04:05,530 --> 00:04:06,450
العفو

50
00:04:06,450 --> 00:04:08,130
سيّدتي، هلّا حصلتُ على واحدة؟

51
00:04:13,200 --> 00:04:15,260
...ستّة منهم

52
00:04:17,700 --> 00:04:21,280
لصّ. الطّعنة الصّامتة. القنبلة الدّخانيّة

53
00:04:24,820 --> 00:04:27,780
لديهم خواتم؟

54
00:04:28,390 --> 00:04:31,040
وجميعهم الستّة لديهم نفس التّصميم

55
00:04:31,660 --> 00:04:34,490
هل يعملون لصالح مُنظّمة ضخمة؟

56
00:04:34,490 --> 00:04:36,300
!لم يكن هذا اتّفاقنا

57
00:04:36,710 --> 00:04:39,800
!قلتُم ستحرّرونها حالما أدفع الفدية

58
00:04:39,800 --> 00:04:44,950
كفاك سذاجة يا فتى. هذه الفكّة
السّخيفة لن تحرّر أحداً

59
00:04:45,490 --> 00:04:49,980
هل تريد الآن أن تتلقّى مولاتك
العزيزة معاملة سيّئة؟

60
00:04:49,980 --> 00:04:51,160
!لا يمكنكم ذلك

61
00:04:51,160 --> 00:04:54,940
ثلاثة أضعاف ما سدّدتَه لنا للتو قد يدعنا
!نُعيد النّظر في مسألة إطلاق سراحها

62
00:04:54,940 --> 00:04:55,970
!ثـ-ثلاثة أضعاف؟

63
00:04:55,970 --> 00:04:59,600
تلك الخواتم... هل هؤلاء جزء
من نفس الطّاقم؟

64
00:04:59,600 --> 00:05:00,810
!هذا يكفي

65
00:05:00,810 --> 00:05:03,680
...ستأخذونني إلى الأميرة، وإلّا

66
00:05:03,680 --> 00:05:04,750
أميرة؟

67
00:05:04,750 --> 00:05:07,580
تبدو هذه مُشكلة حقيقيّة

68
00:05:09,080 --> 00:05:10,790
لا تقلق بشأن ذلك يا فتى

69
00:05:10,790 --> 00:05:13,770
...سنتواصل مع جماعتك بشأن الصّفقة لاحقاً

70
00:05:14,080 --> 00:05:17,090
!عندما نُرسِل لهم جيفتك

71
00:05:21,510 --> 00:05:26,630
.جعلتُ إحدى نسخي تنتقل إليهم
سينفعني هذا في معرفة مخبئهم

72
00:05:28,210 --> 00:05:30,480
!لماذا تركتهم على قيد الحياة؟

73
00:05:30,480 --> 00:05:32,950
!ما الجدوى من إظهار الرّحمة لقاذورات؟

74
00:05:32,950 --> 00:05:34,080
—كان بوسعك إنزال الحُكم على

75
00:05:34,080 --> 00:05:35,090
!اصمت

76
00:05:35,690 --> 00:05:39,500
كيف توبّخ الشّخص الّذي أنقذك للتو؟

77
00:05:39,500 --> 00:05:41,880
فضلاً عن ذلك، تركتُهم لسبب

78
00:05:45,010 --> 00:05:47,750
إذا أردت الاستمرار في التكتُّم
،عن هذه المشكلة

79
00:05:47,750 --> 00:05:50,310
فتكلّم عبر هذه البِطاقة. استدعِني

80
00:05:50,620 --> 00:05:53,610
لكن لا تخبر أحداً عن هذا

81
00:05:56,040 --> 00:05:58,060
!مـ-من تكون بالضّبط؟

82
00:05:59,760 --> 00:06:03,070
مجرّد مرتزقة. إلى اللِّقاء

83
00:06:04,910 --> 00:06:06,270
...تلك اللّيلة

84
00:06:07,010 --> 00:06:11,980
حقيقة وجود الأميرة في البلدة كانت سرّاً

85
00:06:11,980 --> 00:06:16,370
واستغلّتْ ذلك لصالحِها
...للتملُّص من حمايتنا

86
00:06:16,370 --> 00:06:19,020
قبل أن تُختطَف بواسطة أولئك الأشخاص

87
00:06:19,320 --> 00:06:22,700
لن تكون هذه مُشكلة. أعرف مكانهم

88
00:06:22,700 --> 00:06:24,800
!حقّاً؟

89
00:06:24,800 --> 00:06:25,790
أجل

90
00:06:26,570 --> 00:06:30,090
مخبأهم هو منزل فارغ على أطراف البلدة

91
00:06:30,090 --> 00:06:32,540
كان قصراً لأحد النُّبلاء

92
00:06:36,540 --> 00:06:37,320
—ماذا

93
00:06:37,320 --> 00:06:38,080
...مهلاً

94
00:06:44,150 --> 00:06:45,460
...سموّ الأميرة

95
00:06:46,430 --> 00:06:47,630
!سموّ الأميرة

96
00:06:48,930 --> 00:06:52,850
يبدو أنّ الأمر برمّته كان مُخطَّطاً

97
00:06:53,430 --> 00:06:55,980
هناك كثير من النِّزاع داخل المملكة

98
00:06:55,980 --> 00:06:59,440
يتمحور حول هذه الأميرة الصّبيانيّة

99
00:06:59,720 --> 00:07:03,670
يا فتى. لا تُخبر أحداً عن هذا، مفهوم؟

100
00:07:04,710 --> 00:07:08,100
أخبرهم بأنّ الأميرة كانت هي من رتّبَتْ
،لعمليّة الاختطاف

101
00:07:08,100 --> 00:07:11,200
وسايرتَ الأمر لأنّها أجبرَتْك

102
00:07:11,200 --> 00:07:12,580
...لكن

103
00:07:13,950 --> 00:07:18,690
ألا ينبغي على الأقلّ أن أخبر سموّه بالحقيقة؟

104
00:07:18,690 --> 00:07:23,090
المعرفة بهذا الأمر قد يساهم
!في عدم حدوث ذلك ثانية

105
00:07:26,980 --> 00:07:31,700
،إذا تسلّط الضّوء على هذه الحادثة
فسوف تواجه أكثر عقوبة إفزاعاً

106
00:07:32,400 --> 00:07:35,730
أنصحك بالتّماشي مع روايتها وتدع
ذلك نهاية الأمر

107
00:07:37,650 --> 00:07:40,510
حسناً، هذا يكفي

108
00:07:40,510 --> 00:07:43,230
استفدتُ من التّنويم المغناطيسيّ
الخاصّ بغينكي

109
00:07:52,270 --> 00:07:55,500
!أخي أوغرو! هذا أنا! سيجي

110
00:07:55,500 --> 00:07:57,720
ما الأمر يا سيجي؟

111
00:07:57,720 --> 00:08:00,500
!وردتنا أنباء هامّة

112
00:08:00,500 --> 00:08:04,160
!وُلِدَ بعض الغوبلن والهوبغوبلن اليوم

113
00:08:04,570 --> 00:08:06,600
!الأطفال وأمّهاتهم بصحّة جيّدة

114
00:08:06,600 --> 00:08:08,510
!هذه أنباء سارّة

115
00:08:08,850 --> 00:08:11,670
،يسرّني أن أسمع بولادة الجيل الجديد

116
00:08:11,670 --> 00:08:16,010
لكن قبل أن أنطلق اليوم، سوف
أحصل على إجابة من الفتيات

117
00:08:16,010 --> 00:08:18,770
آمل أن تكون هذه أنباء سارّة أيضاً

118
00:08:20,820 --> 00:08:22,770
بصراحة لا نعلم لماذا تكبّدتَ عناء السُّؤال

119
00:08:22,770 --> 00:08:26,780
جمعنا الكثير من الأغراض ونحن
!جاهزات للعودة إلى الدِّيار

120
00:08:26,780 --> 00:08:29,910
هناك كثير من الوصفات لم نُجرّبها بعد

121
00:08:29,910 --> 00:08:31,780
!آمل أن تستمتعوا بها جميعاً

122
00:08:31,780 --> 00:08:35,790
أريد أن آكل مجموعة من الفرائس
!الجدُد يا أوغرو

123
00:08:35,790 --> 00:08:39,290
وما زلتُ أخمّر مشروباً كحوليّاً جديداً
خُصّصَ ليُناسِب ذوقك

124
00:08:39,580 --> 00:08:43,290
لنفكّر في مزيد من الاستعمالات للميثريل معاً

125
00:08:48,360 --> 00:08:50,800
يا فتيات... شكراً لكُن

126
00:08:52,710 --> 00:08:54,560
لقد جعلتني أنتظر طويلاً

127
00:08:54,950 --> 00:08:56,560
وأخيراً وصلت

128
00:08:56,560 --> 00:09:01,720
نمتُ سريعاً في اللّيلة الماضية
،ولم أستطع التحدُّث معك

129
00:09:01,720 --> 00:09:05,150
لكن يبدو أنّك الأوغر الّذي حرّرني؟

130
00:09:05,150 --> 00:09:06,570
أشكرك

131
00:09:06,570 --> 00:09:08,970
أوغرو، من هذه الفتاة؟

132
00:09:08,970 --> 00:09:10,900
...لم أعرّف عن نفسي

133
00:09:10,900 --> 00:09:14,710
أنا الابنة الأولى للعقيلة الملِكة
،الأولى لمملكة ستيرنبيرت

134
00:09:14,710 --> 00:09:17,970
!روبيليا إيس فول ستيرنبيرت

135
00:09:20,330 --> 00:09:25,630
...سامحني! كانت مُصِرّة على شكرك شخصيّاً

136
00:09:25,630 --> 00:09:27,270
عملُكِ شاقّ، صحيح؟

137
00:09:27,270 --> 00:09:28,920
،حسبما قيل لي

138
00:09:29,340 --> 00:09:32,270
أنت تقود سريّة مُرتزقة، صحيح؟

139
00:09:32,270 --> 00:09:35,850
أتيتُ شخصيّاً لأخصّص لكم عملاً

140
00:09:36,880 --> 00:09:39,260
...يا قائد بارابيلام، أوغرو

141
00:09:40,600 --> 00:09:44,420
!ستُرافقني إلى عاصمة أوسفيل الملكيّة

142
00:09:45,990 --> 00:09:48,860
...ما الأمر؟ ثمّة شيء في نبرة صوتها

143
00:09:49,740 --> 00:09:54,530
إنّها غير خائفة من رؤيتي إطلاقاً وتتكلّم
...وكأنّها أكبر من سنّها

144
00:09:54,530 --> 00:09:57,450
ناهيك عن هذه القوّة السّحريّة
الغريبة الّتي أشعر بها

145
00:09:58,300 --> 00:10:00,980
!من هذه الفتاة بالضّبط؟

146
00:10:02,840 --> 00:10:03,890
!لن يحدث هذا

147
00:10:04,880 --> 00:10:06,280
لِـ-لِمَ لا؟

148
00:10:06,280 --> 00:10:08,880
لديكِ حُرّاسكِ الشّخصيّون، أليس كذلك؟

149
00:10:08,880 --> 00:10:13,130
!إنّهم سيّئون! مُمِلّون جميعهم

150
00:10:13,130 --> 00:10:16,140
!لدينا شؤوننا الخاصّة لنتعامل معها

151
00:10:16,590 --> 00:10:21,070
فهمت. هذا يفسّر تمكّنها من الخروج
خلسة دون أن يلاحظها أحد

152
00:10:21,070 --> 00:10:24,650
ارتأيتُ أن أنتهز الفُرصة لإلقاء
...موعِظة عليها، لكن

153
00:10:26,070 --> 00:10:28,960
!أنت أوّل شخص يوعظني هكذا

154
00:10:26,070 --> 00:10:28,960
لم يؤثّر ذلك إطلاقاً...

155
00:10:28,960 --> 00:10:31,230
!أنت مُسلٍّ كما توقّعت

156
00:10:31,960 --> 00:10:35,940
من حيث الدّفع، نحن مستعدّون
لعرض صفيحة ذهبيّة عليك

157
00:10:36,410 --> 00:10:40,390
،رغم ذلك... إن لم تستطع قبول ذلك
...فلا مُشكلة على ما أفترض

158
00:10:40,910 --> 00:10:41,940
!اِقبل يا أوغرو

159
00:10:41,940 --> 00:10:44,190
الصّفيحة الذّهبيّة تساوي 1،000،000
!قطعة معدنيّة ذهبيّة

160
00:10:44,190 --> 00:10:45,810
!هذه هي القيمة السّوقيّة

161
00:10:45,810 --> 00:10:47,410
!يجب أن تقبل

162
00:10:47,410 --> 00:10:49,920
!تبدو الحالة الاقتصاديّة هنا غير عاديّة

163
00:10:50,290 --> 00:10:53,300
...وأنا مهتمٌّ جدّاً بالعاصمة الملكيّة

164
00:10:53,300 --> 00:10:56,430
لذا أجّلتُ عودتنا إلى الدّيار وقبلتُ بالعمل

165
00:10:57,890 --> 00:11:00,430
سوف ننتظر عند البوّابة إذاً

166
00:11:00,750 --> 00:11:06,200
رغم ذلك، أعتقد أنّ المبلغ الهائل من المال
دفعني لاتّخاذ قرار سيّئ

167
00:11:08,800 --> 00:11:12,340
اسمحي لي بالسُّؤال... ماذا
حدث لحُرّاسكِ؟

168
00:11:12,340 --> 00:11:14,430
!تركتُهم كما هو مُخطَّط

169
00:11:14,820 --> 00:11:15,830
!يا فتى

170
00:11:15,830 --> 00:11:18,590
!آسف يا سيّدي! الأميرة لم تقتنع

171
00:11:18,590 --> 00:11:19,830
!يا إلهي

172
00:11:20,140 --> 00:11:24,700
!سموّ الأميرة؟ سموّ الأميرة

173
00:11:21,530 --> 00:11:24,700
...حُرّاسها مُرتعِدون غالباً وهم يبحثون عنها

174
00:11:24,700 --> 00:11:28,790
!وإذا كُشِفَ أمري، فغالباً سيعتبرونني المُختطِف

175
00:11:28,790 --> 00:11:31,530
أ-أوغرو، ماذا نفعل؟

176
00:11:32,900 --> 00:11:35,850
كيفما جرت الأمور، هذه ليست
!غلطتي، اللّعنة

177
00:11:35,850 --> 00:11:37,790
!أجل، جيّد جدّاً

178
00:11:43,150 --> 00:11:46,590
ليس وكأنّني أستطيع خرق عقد
...بعد أن قبلتُه

179
00:11:48,560 --> 00:11:51,180
سريع جدّاً! ما هذا بالتّحديد؟

180
00:11:51,180 --> 00:11:53,130
حريشة هيكليّة عظميّة

181
00:11:55,040 --> 00:11:57,920
وما طبع المخلوق الزّغبيّ هناك؟

182
00:11:59,730 --> 00:12:02,830
أعتقد هذا قطيع من الجواميس

183
00:12:03,690 --> 00:12:05,940
يُفترَض أن تكون الجواميس ذات
،لحم عالي الجودة

184
00:12:05,940 --> 00:12:09,280
وقرونها قيّمة دوائيّاً

185
00:12:09,830 --> 00:12:11,590
!لنفعل هذا

186
00:12:20,730 --> 00:12:21,910
!لذيذ

187
00:12:22,260 --> 00:12:27,520
والآن الحريشة الهيكليّة العظميّة
أمسَتْ أقلّ شُبهة كأريكة

188
00:12:23,710 --> 00:12:26,340
!لحم الجاموس لذيذ جدّاً

189
00:12:30,400 --> 00:12:33,600
هذا شكل أعلى من أرنب
قرنيّ، أرنب النّصل

190
00:12:44,200 --> 00:12:47,150
!حسناً! أظنّني أصبحتُ أقوى قليلاً

191
00:12:45,730 --> 00:12:50,020
عليها أن تفعل مثل هذه الأمور
...كونها نوار سولدات

192
00:12:50,020 --> 00:12:51,060
!سموّ الأميرة

193
00:12:51,710 --> 00:12:53,960
!لنبتعد من هناك يا سموّ الأميرة

194
00:12:53,960 --> 00:12:57,170
!انظر كيف هي دائريّة وظريفة

195
00:12:57,590 --> 00:12:58,590
!سموّ الأميرة

196
00:12:59,120 --> 00:13:03,760
كانت رعاية الأميرة الصّبيانيّة
شاقّاً منذ اليوم الأوّل

197
00:13:04,110 --> 00:13:06,850
...كادتْ تسقط من الحريشة

198
00:13:06,850 --> 00:13:09,220
فاجأتِ الأختين بينما كانتا تطبخان

199
00:13:10,610 --> 00:13:14,860
عليكِ أن تتخيّلي ما الّذي يمكن أن يحدث
!إذا أخفتِ شخصاً يحمل سكّيناً

200
00:13:16,470 --> 00:13:17,980
وتستمرُّ رحلتنا

201
00:13:18,450 --> 00:13:21,300
أفعى سُلحفاة بغلاف

202
00:13:21,610 --> 00:13:24,480
هناك 88 منها في هذا الوكر

203
00:13:24,480 --> 00:13:26,920
هلّا ساعدتموني؟

204
00:13:26,920 --> 00:13:29,410
!لِمَ ينبغي لنا ذلك؟

205
00:13:29,410 --> 00:13:33,770
استسلم فحسب. أنت من شجّعه على الحفر

206
00:13:33,770 --> 00:13:37,060
هـ-هل عليّ حقّاً أن أساهم في هذا؟

207
00:13:37,060 --> 00:13:39,880
سوف نتولّى أمرهم جميعهم في آن
...واحد. استعدّوا جميعاً

208
00:13:39,880 --> 00:13:41,000
!ها أنا ذا

209
00:13:42,380 --> 00:13:45,390
أيّتها الأختان! أحضرا الصّلصة
!والمشروب اللّذين أخبرتُكما عنهما

210
00:13:45,390 --> 00:13:46,640
!لحظة فقط

211
00:13:49,640 --> 00:13:52,140
أعتذر على ما سبق

212
00:13:52,140 --> 00:13:54,100
اسمحا لي بتقديم المُساعدة للتّعويض

213
00:13:55,360 --> 00:13:56,650
شكراً لكِ

214
00:13:59,940 --> 00:14:03,150
ها نحن أولاء! الأفعى المشويّة مع صلصة
!الصّويا المُحضَّرة بواسطتي شخصيّاً

215
00:14:03,880 --> 00:14:05,100
!هذا رائع

216
00:14:05,100 --> 00:14:06,450
!مُذهل

217
00:14:05,100 --> 00:14:06,450
!هذا يتماشى جيّداً مع المشروبات

218
00:14:06,450 --> 00:14:08,640
كيف ابتكرت أطباق كهذه حتّى؟

219
00:14:15,060 --> 00:14:18,190
تعرف مدى خطورة الوحوش وهذه المركبة

220
00:14:18,190 --> 00:14:21,530
ومع ذلك تفعل ما يُملي عليها فضولُها

221
00:14:21,530 --> 00:14:24,270
وكأنّها تحاول خوض أكثر عدد من التّجارب

222
00:14:24,270 --> 00:14:27,180
في العالم الخارجيّ، للمرّة الأولى فقط

223
00:14:24,730 --> 00:14:26,000
!سموّ الأميرة

224
00:14:28,900 --> 00:14:34,180
في يوم واحد، يبدو أنّ كتِفي أصبح
...عرش الأميرة الصّبيانيّة

225
00:14:35,720 --> 00:14:38,920
خدمتُ الأميرةَ عن عمر صغير

226
00:14:39,610 --> 00:14:43,430
حسبما قاله لي، إنّه فارس
،حقيقيّ من فُرسان المملكة

227
00:14:43,430 --> 00:14:46,310
لذا قرّرتُ ضمّه لتدريبنا الصّباحيّ

228
00:14:46,310 --> 00:14:49,080
!هذا مُثيرٌ للاهتمام! سأنضمّ لك كذلك

229
00:14:49,080 --> 00:14:53,050
!لا يمكنكِ يا أميرة! هذه ليست لُعبة

230
00:14:53,050 --> 00:14:56,340
!أعي ذلك! سأجرّب بصرف النّظر عن ذلك

231
00:14:56,340 --> 00:14:58,880
!قد يغدو هذا قيّماً يوماً ما

232
00:15:00,000 --> 00:15:01,880
...إن كنتِ مُصِرّة

233
00:15:02,490 --> 00:15:03,880
!أشكرك

234
00:15:07,550 --> 00:15:12,250
كما توقّعت، كان الفارس الفتى يعتمد
على تعزيز مستواه ومنافع مهنته

235
00:15:12,250 --> 00:15:15,400
علّمتُه حقيقة وهي أنّه في نهاية المطاف

236
00:15:15,400 --> 00:15:18,400
يجب ألّا يعتمد سوى على جسده

237
00:15:19,760 --> 00:15:23,900
ومن ناحية أخرى، كانت الأميرة الصّبيانيّة
...تتمرّن على التّلويح بجدّ

238
00:15:25,060 --> 00:15:28,180
ثمّة كلام قالَتْه لازمَني

239
00:15:29,230 --> 00:15:32,430
،بينما نعبر ممرّاً جبليّاً وراء بلد تلّيّة

240
00:15:32,430 --> 00:15:34,910
ناقشنا الطّريق الّذي سنعبره لليوم المُوالي

241
00:15:35,410 --> 00:15:38,390
،إنّ سلوك المُنحدرات سيكون الطّريق الأقصر

242
00:15:38,390 --> 00:15:40,620
لكنّه الأكثر خطورة أيضاً

243
00:15:40,620 --> 00:15:44,420
أُوصي بسلوك الطّريق الأطول على امتداد النّهر

244
00:15:44,420 --> 00:15:48,010
أليس الطّريق على جانب المُنحدر
هو حيث تصنع نسور فاليز أعشاشها؟

245
00:15:48,010 --> 00:15:49,180
صحيح

246
00:15:49,180 --> 00:15:51,180
ما هو نسر فاليز؟

247
00:15:51,180 --> 00:15:54,310
العِرق الأقوى من المخلوقات في هذه الجبال

248
00:15:54,310 --> 00:15:58,650
ليست سريعة فحسب، لكن لديها أيضاً
سُمّ يشلّ الحركة في مخالبها

249
00:15:59,580 --> 00:16:04,770
علاوة على ذلك، قائدهم، نسر
...اليَشم لديه قوّة برَكة

250
00:16:05,820 --> 00:16:10,350
إذا واجهنا نسر يَشم، فسوف يصطادنا

251
00:16:10,350 --> 00:16:13,080
...إذاً يوجد مخلوق قويّ في هذه الأرجاء

252
00:16:13,530 --> 00:16:18,010
من الجيّد أن نمتلك المعلومات الّتي
نحتاجها لخوض رحلة آمنة

253
00:16:18,010 --> 00:16:19,580
!حسناً، هذا يحسم المسألة

254
00:16:20,290 --> 00:16:23,380
!سنتوجّه لصيد نسر يَشم

255
00:16:26,260 --> 00:16:28,360
!لستُ أفهم

256
00:16:28,360 --> 00:16:30,610
!لماذا نتقاتل مع نسر يَشم؟

257
00:16:30,610 --> 00:16:32,850
!لا تلُمنا إذا ساءت الأمور

258
00:16:43,900 --> 00:16:46,700
تحوّلتْ بعض النُّسور الّتي اصطدناها إلى فطور

259
00:16:46,700 --> 00:16:49,900
!من يرفض دجاجاً مقليّاً وياكيتوري؟

260
00:16:50,760 --> 00:16:56,410
كانت رحلة سلِسة حتّى الآن، لكن
...كان قد بدأ شعور سيّئ يُساورني

261
00:16:58,590 --> 00:17:01,670
!قادم! جميعكم، ابقوا في العربة

262
00:17:01,670 --> 00:17:05,290
...لـ-لا أريد أن أتخيّلك تخسر يا أوغرو، لكن

263
00:17:05,290 --> 00:17:07,670
هل عليك أن تقاتل حقّاً الآن؟

264
00:17:07,970 --> 00:17:11,390
...آسف لإثارة قلقكِ. رغم ذلك

265
00:17:13,250 --> 00:17:18,180
قرّرتُ أن أحاول أكل كلّ عدوّ جديد أُصادفه

266
00:17:23,000 --> 00:17:25,340
!مـ-مضى ساعة بالفعل

267
00:17:25,340 --> 00:17:26,990
!هل سيكون بخير؟

268
00:17:26,990 --> 00:17:28,950
أعلم بأنّ أوغرو سيكون بخير

269
00:17:30,020 --> 00:17:34,700
عندما قاتلَ دُبّاً أحمر، استغرقَ ليلة
كاملة، لكنّه انتصر

270
00:17:34,700 --> 00:17:38,870
!حمقاء! إنّه مُتحوِّر دُبّ رماديّ

271
00:17:38,870 --> 00:17:41,160
!لا يُقارَن بنسر يَشم

272
00:17:41,520 --> 00:17:46,260
ما علينا فعله هو معرِفة كيفيّة
!الهرب إذا مات

273
00:17:46,260 --> 00:17:47,820
لن أذهب إلى أيّ مكان

274
00:17:48,210 --> 00:17:50,040
ولا أنا

275
00:17:50,040 --> 00:17:56,310
وإذا مات، سوف أقتل ذلك الطّائر
!ولو على جثّتي

276
00:17:56,780 --> 00:17:58,290
...ا-المعذرة

277
00:17:59,220 --> 00:18:02,640
هدأت الأمور للتو

278
00:18:02,640 --> 00:18:04,720
ا-انتهى الأمر إذاً؟

279
00:18:14,320 --> 00:18:16,640
!رغم ذلك، توقّعت

280
00:18:17,740 --> 00:18:19,670
!كان هذا جنونيّاً

281
00:18:19,670 --> 00:18:21,750
!ينبغي أن نهرب في أسرع وقت

282
00:18:22,170 --> 00:18:26,170
قولوا شيئاً، اللّعنة! أم أنّ ذلك كان
!مجرّد تباهٍ مُزيَّف؟

283
00:18:36,060 --> 00:18:38,160
أعتقد هذه هي حدودك

284
00:18:38,160 --> 00:18:41,520
...كنتُ آمل أن أُطيل الأمور أكثر قليلاً، لكن

285
00:18:48,940 --> 00:18:52,860
أكلَ ذِراعه للتوّ! هل فقدَ صوابه أم ماذا؟

286
00:18:56,350 --> 00:18:59,740
شكراً على مساعدتي في تدريبي

287
00:19:00,120 --> 00:19:02,720
أعلم تماماً كم أنت قويّ

288
00:19:03,140 --> 00:19:06,740
!وبالتّالي، حان وقت الجدّ

289
00:19:15,450 --> 00:19:17,340
أنت لا تفهم غالباً، أليس كذلك؟

290
00:19:17,340 --> 00:19:21,400
علِقتَ بخيط ما فحسب، لكن
...تشعر بأنّ جسدَك أثقل فجأة

291
00:19:21,930 --> 00:19:27,310
لن تتمكّن من التحكُّم بالرِّياح أو استخدام
جناحيك للتّحليق بعد الآن

292
00:19:39,720 --> 00:19:42,190
،ظننتُك ستموت فوراً

293
00:19:42,190 --> 00:19:45,880
لكن هل من الصّعب حقّاً قتل
أيّ شيء يتمتّع ببرَكة؟

294
00:19:47,970 --> 00:19:51,380
ما خطبكم؟ تبدون مُرتعدين

295
00:19:53,630 --> 00:19:55,380
ما هذا...؟

296
00:19:57,680 --> 00:20:01,640
الحجر الّذي كان بجانب قلب نسر اليَشم

297
00:20:01,640 --> 00:20:05,070
كان حجره الرُّوحيّ على ما يبدو

298
00:20:07,700 --> 00:20:09,150
،وفقاً للفتيات

299
00:20:09,150 --> 00:20:11,200
!لم أرَه على حقيقته من قبل

300
00:20:09,850 --> 00:20:11,200
إنّه نادر جدّاً لدرجة أنّه لا يظهر إلّا

301
00:20:11,200 --> 00:20:14,130
لا يمكنك أكله، مفهوم؟

302
00:20:11,200 --> 00:20:14,130
في واحد من أصل مئة وحش من فئة
،زعيم مُشبَع ببرَكة

303
00:20:14,130 --> 00:20:17,280
ويمكن استخدامه لصناعة أدوات سحر قويّة

304
00:20:14,720 --> 00:20:17,280
علينا التّفكير في أفضل وسيلة لاستعماله

305
00:20:17,280 --> 00:20:20,320
تُباع بمالٍ كافٍ لشراء بلد بأكمله

306
00:20:21,860 --> 00:20:23,040
!لذيذ

307
00:20:23,660 --> 00:20:25,580
!شهيّ للغاية

308
00:20:27,450 --> 00:20:31,930
سهم الرّيش. مُفترِس السّماء. برَكة إله العاصفة

309
00:20:31,930 --> 00:20:36,800
.مُقاومة كاملة للرّياح. مخالب صُلبة
تحليق صوتيّ

310
00:20:42,130 --> 00:20:43,500
...أوغرو

311
00:20:46,260 --> 00:20:51,930
لماذا تلتهم دوماً المخلوقات الّتي
تقتلها يا أوغرو؟

312
00:20:55,570 --> 00:20:59,820
لماذا تأكل كلّ شيء تقتله؟

313
00:21:01,510 --> 00:21:04,830
سُئلتُ هذا السّؤال في حياتي الماضية أيضاً

314
00:21:05,350 --> 00:21:07,830
لم تتغيّر إجابتي

315
00:21:09,570 --> 00:21:12,000
آكلهم لأنّني أقتلهم

316
00:21:13,240 --> 00:21:18,060
.إذا قتلتُ شيئاً، فهذا يصبُّ في صالحي
كي أتمكّن من البقاء

317
00:21:18,470 --> 00:21:21,520
،إذا كانت مُواجهتي تعني الموت لشخص

318
00:21:21,520 --> 00:21:26,850
فإنّني آكله إذا استطعت، وذلك كي
آخذ حسراتهم وضغينتهم

319
00:21:27,810 --> 00:21:32,120
الأشخاص الّذين عملتُ معهم في حياتي
السّابقة استغربوا من ذلك أيضاً

320
00:21:35,200 --> 00:21:37,350
...هكذا إذاً

321
00:21:38,340 --> 00:21:41,360
هدأت بعد ذلك

322
00:21:42,920 --> 00:21:46,870
أنا متأكّدٌ بأنّ الأميرة الصّبيانيّة
لديها أفكارها الخاصّة حول الأمر

323
00:21:48,570 --> 00:21:52,620
لكن أنوي الاستمرار في التحدّي
وأكل الوحوش الّتي تعترض طريقي

324
00:21:53,190 --> 00:21:55,880
بينما تستمرُّ رحلتنا