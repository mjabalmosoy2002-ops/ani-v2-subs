1
00:00:06,000 --> 00:00:07,440
هاكو؟

2
00:00:08,250 --> 00:00:13,380
الأونكامي الجديد الخاص بنا قد تجلّى أمامنا

3
00:00:14,400 --> 00:00:19,490
عسى أن يراقبنا من هنا للأبد

4
00:00:31,540 --> 00:00:34,130
...لا... هاكو

5
00:00:36,080 --> 00:00:38,240
!هاكو

6
00:01:13,300 --> 00:01:14,510
تفضّلا

7
00:01:14,880 --> 00:01:16,500
هذا هو السّاكي الجديد لهذا العام

8
00:01:16,880 --> 00:01:19,760
كلاكما أحببتُما هذا النّوع، أليس كذلك؟

9
00:01:21,040 --> 00:01:23,770
،لم أتوقّع أن يصنعوا منه في هذا العام

10
00:01:24,190 --> 00:01:25,920
لكن يبدو أنّ الحظّ ابتسم لنا

11
00:01:25,920 --> 00:01:27,690
أوغي؟

12
00:01:27,950 --> 00:01:30,270
هل أنت هنا من الآن؟

13
00:01:30,270 --> 00:01:32,170
هنا من الآن؟

14
00:01:32,170 --> 00:01:34,150
ما الّذي أحضركم إلى هنا؟

15
00:01:34,780 --> 00:01:36,590
نفس الكلام نوجّهه لك

16
00:01:36,970 --> 00:01:38,310
إنّه يوم مُميّز

17
00:01:38,310 --> 00:01:40,180
نريد مشاركته معهما، صحيح؟

18
00:01:42,130 --> 00:01:47,290
أوشتور، مارورو، هل تستمتعان حيث أنتما؟

19
00:01:48,380 --> 00:01:50,900
تسير الأمور على ما يُرام هنا على ما أعتقد

20
00:01:51,990 --> 00:01:55,380
الأميرات كلّهن ناضجات الآن

21
00:01:56,270 --> 00:01:59,060
عملكما الدّؤوب قد أثمر

22
00:01:59,060 --> 00:02:00,310
كونا فخورين

23
00:02:07,850 --> 00:02:10,020
مضى وقت طويل يا أخي

24
00:02:10,460 --> 00:02:14,820
كنتُ مشغولاً في الحكم لدرجة أنّه
لم يُسعفني الوقت لزيارتكما. آسف

25
00:02:15,990 --> 00:02:20,160
تولّيتُ زمام الأمور من جدّي
...وأصبحتُ أولو رسميّاً

26
00:02:20,160 --> 00:02:22,080
!سيُخطَب لشينونون

27
00:02:22,080 --> 00:02:24,990
!ماذا؟! شينونون؟

28
00:02:24,990 --> 00:02:29,710
لسنا كذلك؟ هل كنتُ مجرّد لعبة بالنسبة لك؟

29
00:02:29,710 --> 00:02:32,940
...لعبة؟ نـ-نـ-نحن أبداً لا

30
00:02:32,940 --> 00:02:38,170
حسناً، كفى كآبة وجدّية. لنحتفل

31
00:02:39,430 --> 00:02:41,470
!بازدهار ياماتو

32
00:02:42,060 --> 00:02:43,760
!بازدهارها

33
00:02:45,620 --> 00:02:46,720
!بصحّتكم

34
00:02:49,340 --> 00:02:51,730
مضى وقت طويل يا زعيم

35
00:02:51,730 --> 00:02:54,190
هيّا، تفضّل مشروباً آخر

36
00:02:54,640 --> 00:02:58,170
ما الّذي ينوي هاكو فعله برأيكم؟

37
00:02:58,170 --> 00:03:02,180
أعرف طبعه، قد يكون هنا الآن

38
00:03:02,180 --> 00:03:04,910
!مذهل، تشرب كرجل حقيقي

39
00:03:05,120 --> 00:03:08,890
!لا تقلق، يوجد المزيد والمزيد

40
00:03:08,890 --> 00:03:10,550
!اشرب! اشرب

41
00:03:10,970 --> 00:03:13,590
لا، كنتُ أمزح فحسب

42
00:03:16,270 --> 00:03:18,050
مضى وقت طويل

43
00:03:18,320 --> 00:03:21,820
سمعتُ بأنّكِ حبستِ نفسكِ بعد ما حدث

44
00:03:21,820 --> 00:03:24,510
لكن أظنّكِ خرجتِ من حفرتكِ أخيراً

45
00:03:25,710 --> 00:03:28,770
وسمعتُ بأنّكِ بكيتِ لأسابيع

46
00:03:29,410 --> 00:03:33,620
المُسافرون من عرض البِحار أخبروني
بقصّة الميكادو الّتي انفجرت باكية

47
00:03:34,400 --> 00:03:36,410
فقدتُ جزءاً من نفسي

48
00:03:36,410 --> 00:03:38,030
من الطبيعي أن أبكي

49
00:03:38,030 --> 00:03:39,920
لمَ أخجل من ذلك؟

50
00:03:40,260 --> 00:03:43,870
وحتّى لو كنتُ أبكي، لن أدع ذلك
يثنيني عن المضيّ قُدماً

51
00:03:44,330 --> 00:03:47,050
عقدتُ العزم وقدتُ شعبي

52
00:03:47,050 --> 00:03:50,460
!بخلافكِ يا من حبستِ نفسكِ

53
00:03:51,020 --> 00:03:55,160
لو لم تخرجي من مخبأكِ، لكنتُ قد نسيتُ أمركِ

54
00:03:55,160 --> 00:03:58,270
كان لديكِ الوقت لتحزني على الأقلّ

55
00:03:58,590 --> 00:04:04,090
كوريثة، لم يكن لديّ ذلك، لذا أحسدكِ

56
00:04:07,060 --> 00:04:10,150
!يا للاخت الصّغيرة الأنانيّة

57
00:04:07,060 --> 00:04:10,150
!يا للأخت الصّغيرة المُتغطرسة

58
00:04:13,700 --> 00:04:17,210
يبدو أنّنا بحاجة لحسم الأمور بشكل نهائي

59
00:04:17,770 --> 00:04:19,870
حتّى لو بكيتِ، لن أتوقّف

60
00:04:23,280 --> 00:04:24,920
...يا إلهي

61
00:04:24,920 --> 00:04:27,280
تسرّني رؤيتكِ من جديد يا فوميرول

62
00:04:27,650 --> 00:04:29,900
يسرّني أنّكِ تبلين بلاء حسناً

63
00:04:29,900 --> 00:04:32,310
!أنتِ أيضاً يا رولو

64
00:04:32,310 --> 00:04:33,000
!شكراً لك

65
00:04:33,210 --> 00:04:37,400
!أحضري الجميع إلى توسكور يوماً ما

66
00:04:37,400 --> 00:04:40,530
!سنقيم لكم مأدبة ضخمة

67
00:04:40,530 --> 00:04:41,830
!حسناً، شكراً

68
00:04:41,830 --> 00:04:44,050
حان الوقت أنتما

69
00:04:44,320 --> 00:04:45,090
هل أنتما جاهزتان؟

70
00:04:51,950 --> 00:04:53,840
حـ-حسناً،

71
00:04:53,840 --> 00:04:58,040
أنتِ الوحيدة القادرة على التكلّم
معي بهذه الطريقة الآن

72
00:04:58,040 --> 00:04:59,900
أنا مُلزَمة بالضّحك ومُسامحتكِ

73
00:04:59,900 --> 00:05:01,820
هذه عبارتي أنا

74
00:05:04,010 --> 00:05:05,740
فلنبدأ إذاً

75
00:05:06,170 --> 00:05:08,740
أجل، فلنبدأ

76
00:05:14,330 --> 00:05:19,000
اليوم، في هذا اليوم الواعد، نقف
في حضرة الأونكامي

77
00:05:19,630 --> 00:05:21,940
أونكامي يوتسوالميتيا

78
00:05:22,390 --> 00:05:23,840
أونفيتايكايان

79
00:05:24,660 --> 00:05:28,080
عسى أن تبارك بخياراتنا

80
00:05:28,460 --> 00:05:32,310
عسى أن تهدينا طريق الصّلاح

81
00:05:37,030 --> 00:05:41,480
!إمبراطورة توسكور، السّليلة الإلهيّة، كون

82
00:05:41,770 --> 00:05:46,240
!ميكادو ياماتو، السّليلة الإلهيّة، آنجو

83
00:05:51,190 --> 00:05:53,030
!شعب توسكور

84
00:05:53,760 --> 00:05:55,540
!شعب ياماتو

85
00:05:56,240 --> 00:05:58,960
تتذكّرون أيّام الحرب الطويلة

86
00:05:59,520 --> 00:06:02,590
أيّام الكارثة الفظيعة

87
00:06:03,110 --> 00:06:06,210
كان وقت مُعاناة ومِحن كثيرة

88
00:06:06,630 --> 00:06:11,620
لكن بمساعدة الأبيض العظيم، تمكنّا
من التغلّب عليها

89
00:06:12,050 --> 00:06:14,980
!وها نحن هنا الآن

90
00:06:15,290 --> 00:06:21,190
كنّا نخوض حرباً من قبل، لكنّنا وضعنا
سيوفنا جانباً ونقف جنباً إلى جنب الآن

91
00:06:21,700 --> 00:06:23,940
هذه ليست مُعجزة عابرة

92
00:06:24,620 --> 00:06:28,150
يا شعبي، حان الوقت الآن للإمساك
بأيدي بعضنا الآخر

93
00:06:28,500 --> 00:06:32,910
قد نغضّ النّظر عن بعضنا الآخر
أحياناً. قد نتجادل أحياناً

94
00:06:33,280 --> 00:06:37,620
لكن رغم ذلك، نقسم أن نمشي جنباً إلى جنب

95
00:06:38,070 --> 00:06:41,470
،لأنّ هذه هي أمنية من يهدينا

96
00:06:41,470 --> 00:06:43,630
!وأمنيتنا كذلك

97
00:06:43,950 --> 00:06:49,510
لنُثبت للبشريّة جمعاء بأنّ كلامنا صحيح، نناديه باسمه

98
00:06:50,260 --> 00:06:54,010
!اسم الأوتاواريرومونو القديم، الأولو الأبيض

99
00:06:54,520 --> 00:06:57,390
!اسمعوا جيّداً جميعاً

100
00:06:57,770 --> 00:07:01,100
...باسمه، نقسم

101
00:07:01,520 --> 00:07:02,870
...أنّ توسكور...

102
00:07:02,870 --> 00:07:04,110
...وياماتو...

103
00:07:04,570 --> 00:07:08,190
!يُقسمان على سلام أبديّ، هنا والآن

104
00:07:08,810 --> 00:07:10,530
!باسم هوكولو

105
00:07:13,790 --> 00:07:17,670
!هوكولو! هوكولو! هوكولو

106
00:07:17,980 --> 00:07:20,660
قطعنا كلّ هذه المسافة أخيراً

107
00:07:20,660 --> 00:07:34,720
!هوكولو! هوكولو! هوكولو

108
00:07:21,140 --> 00:07:22,640
هذه هي البداية فحسب على ما أعتقد

109
00:07:25,870 --> 00:07:28,130
أتظنّينه في مكان ما يراقب؟

110
00:07:30,100 --> 00:07:31,220
هذا مُؤكّد

111
00:07:35,470 --> 00:07:37,080
إنّه هناك في مكان ما. أنا متأكّدة

112
00:07:50,950 --> 00:07:53,300
...هذا المكان فارغ تماماً

113
00:08:18,530 --> 00:08:21,110
فعلناها أخيراً

114
00:08:21,110 --> 00:08:24,310
أجل، يمكننا أخيراً أن نفتتح للعمل ثانية

115
00:08:24,890 --> 00:08:31,360
،ظللتِ تختفين لأجل عملكِ الآخر
لذا بذلتُ كلّ الجهد الكبير

116
00:08:31,360 --> 00:08:33,380
حسناً، لا تلوميني

117
00:08:33,380 --> 00:08:36,210
لم أستطع رفض ذلك العمل

118
00:08:36,210 --> 00:08:40,250
أنتما مُنسجمتان كالعادة حسبما أرى

119
00:08:41,260 --> 00:08:43,230
أجل، هذا صحيح

120
00:08:43,230 --> 00:08:44,900
أولتوري

121
00:08:44,900 --> 00:08:47,220
طلبتُ منها المجيء إلى هنا سرّاً

122
00:08:47,220 --> 00:08:51,780
إنّها الضيف الأوّل المثالي الّذي يحتفل
بإعادة افتتاحنا، صحيح؟

123
00:08:51,780 --> 00:08:53,030
حقّاً؟

124
00:08:53,910 --> 00:08:55,550
هي كذلك بالتأكيد

125
00:08:58,080 --> 00:09:01,510
أهلاً بكِ في نُزُل هاكوروكاكو

126
00:09:06,890 --> 00:09:08,880
!أتوي

127
00:09:08,880 --> 00:09:12,740
أشفق على سويانكيكور

128
00:09:12,740 --> 00:09:14,280
!الذنب ليس ذنبي

129
00:09:14,280 --> 00:09:17,260
الحبّ يحتاج تضحيات

130
00:09:17,260 --> 00:09:18,630
ماذا عنك يا نوسوري؟

131
00:09:18,630 --> 00:09:20,850
أنتِ إحدى قادة الأعمدة الثّمانية الآن

132
00:09:20,850 --> 00:09:23,750
هل كان من الملائم المُغادرة دون قول شيء؟

133
00:09:25,180 --> 00:09:27,670
لديّ أولويّات أخرى الآن

134
00:09:28,060 --> 00:09:32,380
وأمرتني سموّها أن أبحث عن هاكو

135
00:09:32,750 --> 00:09:35,220
ما يعني بأنّنا سنتوجّه إلى نفس المكان، صحيح؟

136
00:09:35,570 --> 00:09:39,400
!أنا قلقة من ذهابكِ بمفردكِ. لذا سأذهب معكِ

137
00:09:39,400 --> 00:09:40,890
...نوسوري

138
00:09:41,450 --> 00:09:45,580
تحبّينه أيضاً، أليس كذلك؟

139
00:09:47,060 --> 00:09:49,850
لحظة! مـ-ما هذا الكلام؟

140
00:09:49,850 --> 00:09:53,780
!هاكو زميل عزيز لا أكثر ولا أقلّ

141
00:09:55,780 --> 00:09:57,240
!هيّا بنا إذاً

142
00:09:57,240 --> 00:09:59,790
!لحظة، لحظة! لا تصدّقينني، أليس كذلك؟

143
00:09:59,790 --> 00:10:02,700
...امرأة صالحة مثلي

144
00:10:03,770 --> 00:10:07,960
كو تهرب متى سنحت لها فُرصة

145
00:10:08,650 --> 00:10:10,300
حقّاً؟

146
00:10:10,300 --> 00:10:13,310
ماذا تفعلون أيّها الأشرار؟

147
00:10:14,660 --> 00:10:16,590
!نحن آسفون! آسفون

148
00:10:18,030 --> 00:10:19,300
...يا إلهي

149
00:10:19,300 --> 00:10:25,310
بئس الأمر... لماذا رجالنا أغبياء؟

150
00:10:25,310 --> 00:10:26,180
ماذا؟

151
00:10:29,140 --> 00:10:30,260
رولوتيه؟

152
00:10:30,650 --> 00:10:35,420
أنا آسفة... يذكّرني هذا بالأيّام الخوالي

153
00:10:35,420 --> 00:10:36,480
الأيّام الخوالي؟

154
00:10:37,370 --> 00:10:40,070
سوف يعود

155
00:10:40,450 --> 00:10:42,350
هكذا يبدو الأمر بالنسبة لي

156
00:10:45,580 --> 00:10:47,330
معكِ حقّ

157
00:10:48,210 --> 00:10:49,040
أجل

158
00:10:50,100 --> 00:10:53,270
فوميرول هنا، تعمل كسفيرة نوايا حسنة لتوسكور

159
00:10:53,270 --> 00:10:56,260
وصلَتْ إلى كوجيوري بأمان

160
00:10:56,730 --> 00:10:59,860
مشروع إعادة إعمار العاصمة يسير
،على قدم وساق

161
00:10:59,860 --> 00:11:05,170
وسيستدعون مُمثّلين من البلاد الأخرى لإقامة مراسم

162
00:11:05,170 --> 00:11:06,600
هذه هي الأخبار، سموّك

163
00:11:06,940 --> 00:11:07,960
جيّد

164
00:11:10,740 --> 00:11:12,310
أدع الأمور بين يديك

165
00:11:12,570 --> 00:11:14,900
هل سموّها تصغر ثانية؟

166
00:11:15,330 --> 00:11:16,580
بالفعل

167
00:11:16,580 --> 00:11:21,280
لكن في الأمس، ظننتُ بأنّها نمَتْ
!لدرجة تكاد ملابسها تنفجر

168
00:11:21,770 --> 00:11:23,990
أهلاً بعودتكِ يا نيكوني

169
00:11:24,340 --> 00:11:27,450
لكن هل أنتِ متأكّدة بأنّه لا مانع من بقائه هنا؟

170
00:11:27,730 --> 00:11:31,660
عيّنوني مسؤولة عن أرشيف القلعة

171
00:11:32,150 --> 00:11:35,040
!الآن يمكنني أن أعيش معك

172
00:11:35,040 --> 00:11:37,630
مُبهر. شكراً لكِ

173
00:11:37,630 --> 00:11:41,670
كنتِ صغيرة جدّاً، والآن قد نموتِ بشكل جيّد

174
00:11:42,000 --> 00:11:43,520
أحبّ زيّكِ الجديد

175
00:11:44,770 --> 00:11:48,570
أعتقد أنّ إينّاكاموي ستتغيّر من الآن فصاعداً

176
00:11:49,500 --> 00:11:52,200
عيناكِ تحسّنتا أيضاً

177
00:11:52,200 --> 00:11:55,590
أعتقد حان وقت التطلّع قُدماً للمستقبل

178
00:11:58,060 --> 00:12:00,530
،أريد المُساهمة في بعض الأمور

179
00:12:00,930 --> 00:12:06,450
وذلك كي يتمكّن أخي وأصدقاؤه من رؤية
كيف تغيّر موطنه عندما يعودون

180
00:12:06,680 --> 00:12:11,330
أجل... أنا متأكّدة بأنّهم سيحبّون ذلك

181
00:12:11,770 --> 00:12:12,880
أجل

182
00:12:14,540 --> 00:12:18,750
هذا موطنهم

183
00:12:18,750 --> 00:12:20,510
!أحسنوا السّلوك

184
00:12:20,510 --> 00:12:23,240
هل تعلمون في حضرة من أنتم؟

185
00:12:23,240 --> 00:12:27,340
!أنتم في حضرة آنجو، ميكادو ياماتو

186
00:12:27,630 --> 00:12:30,350
ألا ترون هذا الختم؟

187
00:12:31,620 --> 00:12:33,450
!أنتم تقفون في حضرة السّليل الإلهي

188
00:12:33,450 --> 00:12:36,350
!اركعوا! اركعوا الآن

189
00:12:38,750 --> 00:12:43,050
كنتم تحاولون استغلال فوضى إعادة
!الإعمار لملء جيوبكم الخاصّة

190
00:12:43,050 --> 00:12:47,870
!قد تخدعون السّماوات بحدّ ذاتها، لكن لن تخدعوني

191
00:12:49,720 --> 00:12:54,500
لا يمكن أن تكون الميكادو الحقيقيّة هنا
!في مكان ناءٍ كهذا

192
00:12:54,500 --> 00:12:56,460
!إنّها مُحتالة

193
00:12:56,460 --> 00:12:57,600
!اقتلوها

194
00:12:57,600 --> 00:12:59,240
!حـ-حسناً

195
00:12:59,240 --> 00:13:01,930
...ينبغي أن تستسلموا فحسب

196
00:13:02,290 --> 00:13:05,010
ميكا، موني، لقّانهم درساً

197
00:13:05,300 --> 00:13:06,260
!أمركِ

198
00:13:10,890 --> 00:13:14,810
!لن ينتصر الشرّ أبداً

199
00:13:21,630 --> 00:13:22,500
!شكراً

200
00:13:25,870 --> 00:13:31,350
لكن من المُسلّي إخفاء هويّتي والسّفر سرّاً

201
00:13:31,760 --> 00:13:34,870
أتفهّم شعور أبي

202
00:13:35,450 --> 00:13:40,120
وألا تعتقدون بأنّنا إذا استمررنا في السّفر
هكذا، سوف نجده في مكان ما؟

203
00:13:41,500 --> 00:13:48,590
أعتقد... بأنّه هناك في مكان ما

204
00:13:51,340 --> 00:13:53,950
أنت مهتمّ بهذا حقّاً يا مولايّ الصّغير

205
00:13:53,950 --> 00:13:57,660
،أعتقد صحيح أنّك عندما تركّز اهتمامك على الشّاي

206
00:13:57,660 --> 00:13:59,310
تبدأ بصنع فناجين الشّاي الخاصّة بك

207
00:13:59,690 --> 00:14:03,790
أعطيتُ كون العرش، لذا يمكنني الاسترخاء أخيراً الآن

208
00:14:04,390 --> 00:14:07,360
يمكنني تكريس نفسي لهواياتي

209
00:14:08,610 --> 00:14:09,280
مولايّ

210
00:14:09,820 --> 00:14:14,100
بيناوي؟ ما رأيك بهذا؟ لا بأس به، صحيح؟

211
00:14:14,100 --> 00:14:17,010
سموّها قد هربت من جديد

212
00:14:20,570 --> 00:14:23,580
هذه المرّة، استخدمت شيكيغامي كنسخة بديلة

213
00:14:23,580 --> 00:14:25,880
تزداد خدعها تعقيداً

214
00:14:25,880 --> 00:14:28,500
إنّه شارد تماماً

215
00:14:28,500 --> 00:14:30,940
اضبط نفسك يا سيّدي

216
00:14:32,570 --> 00:14:35,610
!لا يمكنني الوقوف مكتوف اليدين! يجب أن ألحق بها

217
00:14:35,610 --> 00:14:36,230
!كورو

218
00:14:36,230 --> 00:14:37,450
حسناً

219
00:14:38,930 --> 00:14:40,210
...أنتما

220
00:14:43,130 --> 00:14:46,070
يجب التّعامل مع هذه المسائل بصورة عاجلة

221
00:14:46,070 --> 00:14:49,210
في ظلّ غياب سموّها، عليك أن تحلّها أنت

222
00:14:51,630 --> 00:14:52,880
...وكورو

223
00:14:52,880 --> 00:14:53,530
نعم؟

224
00:14:53,740 --> 00:14:58,910
في وقت لاحق، سنتحدّث حول السّماح لسموّها بالهرب

225
00:14:59,570 --> 00:15:01,700
حـ-حسناً

226
00:15:05,530 --> 00:15:07,290
اختفَتْ

227
00:15:07,290 --> 00:15:08,340
أجل

228
00:15:08,340 --> 00:15:10,950
ستكون الأجواء مُوحشة من دونها

229
00:15:10,950 --> 00:15:11,810
أجل

230
00:15:13,860 --> 00:15:15,760
ما الغاية من حقائب الظّهر هذه؟

231
00:15:15,760 --> 00:15:21,500
أدركتُ بأنّني لم أرَ ياماتو بعد، ولا أنتِ أيضاً

232
00:15:21,500 --> 00:15:23,890
تقصدين بأنّنا سنلحق بـ كو؟

233
00:15:24,330 --> 00:15:26,110
لن نلحق بها

234
00:15:26,110 --> 00:15:30,220
قد نصادفها في رحلتنا ربّما

235
00:15:30,700 --> 00:15:31,430
هذا كلّ شيء

236
00:15:31,430 --> 00:15:35,060
أجل، هذا يحدث أحياناً، صحيح؟

237
00:15:35,060 --> 00:15:36,120
أجل

238
00:15:36,120 --> 00:15:37,830
!حُسِم الأمر إذاً

239
00:15:59,170 --> 00:16:02,560
أنا مَدين له بشكر

240
00:16:04,270 --> 00:16:09,030
أخبرني بأنّه ربّما كان هناك شخص
ينتظرني وأخذ كلّ قوّتي

241
00:16:09,850 --> 00:16:14,040
الآن أنا مجرّد بشريّ عاديّ

242
00:16:14,040 --> 00:16:15,360
...هل هذا يعني

243
00:16:16,230 --> 00:16:17,320
!هذا هراء

244
00:16:19,060 --> 00:16:21,360
،أنت تجعل الأمر يبدو مُعقّداً

245
00:16:21,360 --> 00:16:26,790
لكن جوهريّاً، تستطيع الجلوس في الجنّة
طوال اليوم دون أن تعمل، صحيح؟

246
00:16:27,150 --> 00:16:28,710
!هذا هراء، وأنا أشعر بالغيرة

247
00:16:36,830 --> 00:16:39,500
أيّامك كإله غير مُستقرّ قد ولّت

248
00:16:41,530 --> 00:16:44,770
حان الوقت لتتعلّم قيمة العمل

249
00:16:50,730 --> 00:16:51,830
...الرّياح

250
00:16:57,550 --> 00:17:00,640
...رائحة العشب

251
00:17:02,340 --> 00:17:05,290
فترة أطول فحسب يا حبّي

252
00:17:06,480 --> 00:17:10,240
أجل، لنعُد إلى المنزل يا إيرورو

253
00:17:11,350 --> 00:17:12,690
...حيث الآخرون

254
00:17:13,210 --> 00:17:14,100
أجل

255
00:17:27,690 --> 00:17:29,050
حسناً، اناتهيت

256
00:17:31,070 --> 00:17:32,590
!حصان

257
00:17:32,590 --> 00:17:35,840
هل يمكنكِ صنع طائر تالياً يا آنسة؟

258
00:17:37,750 --> 00:17:39,450
!تعالي إلى هنا

259
00:17:39,450 --> 00:17:41,590
!هذه الآنسة مذهلة

260
00:17:41,590 --> 00:17:43,850
!يمكنها صنع أيّ شيء بالورق

261
00:17:45,700 --> 00:17:46,410
تعالي إلى هنا

262
00:17:48,340 --> 00:17:50,340
هل من شيء تريدينه؟

263
00:17:52,580 --> 00:17:53,710
زهرة

264
00:17:54,250 --> 00:17:55,330
زهرة؟

265
00:17:55,330 --> 00:17:56,340
أجل

266
00:17:56,340 --> 00:17:58,800
كلّها ذبلت في الثّلج

267
00:17:58,800 --> 00:18:02,250
لكن أريد واحدة لآخذها إلى قبر أمّي وأبي

268
00:18:03,730 --> 00:18:04,400
حسناً

269
00:18:16,570 --> 00:18:17,830
تفضّلي

270
00:18:18,350 --> 00:18:20,250
...شـ-شكراً لكِ

271
00:18:22,790 --> 00:18:24,120
...جميلة

272
00:18:24,120 --> 00:18:25,650
خذيها لهما

273
00:18:25,990 --> 00:18:26,850
!حسناً

274
00:18:34,190 --> 00:18:37,670
الفتاة الّتي رأيتِها اليوم، الّتي
...أعطيتِها الزهرة

275
00:18:38,320 --> 00:18:41,540
فقدت والديها في الحرب

276
00:18:42,010 --> 00:18:45,340
وقبل مدّة، ضلّت عن القرية

277
00:18:45,850 --> 00:18:47,390
...لم أكن أعلم

278
00:18:47,670 --> 00:18:52,350
لكن بعد مدّة، عادت سليمة

279
00:18:52,700 --> 00:18:56,860
تقول بأنّ "ماشيرو-ساما" قد أعادها

280
00:18:56,860 --> 00:18:58,410
ماشيرو-ساما؟

281
00:18:58,410 --> 00:19:03,140
أجل، ماشيرو-ساما أسطورة هنا

282
00:19:03,140 --> 00:19:05,330
هذا ليس مألوفاً بالنسبة لي على ما أعتقد

283
00:19:05,980 --> 00:19:09,430
،عندما تخسرين كلّ شيء وتكونين وحيدة

284
00:19:09,430 --> 00:19:15,590
يظهر رجل شاحب باللّون الأبيض لمساعدتك

285
00:19:17,130 --> 00:19:18,820
هذه قصّة مذهلة

286
00:19:20,610 --> 00:19:23,630
...على ذكر القصص الغريبة

287
00:19:23,630 --> 00:19:28,010
التاتاري في الكهف حيث نذهب
،بحثاً عن الأعشاب قد اختفت

288
00:19:28,010 --> 00:19:31,470
وهي الآن مليئة بالطّحالب

289
00:19:35,910 --> 00:19:38,480
لم أقصد إبقاءكِ حتّى هذه السّاعة المتأخّرة

290
00:19:39,170 --> 00:19:42,020
أعتقد حان الوقت لأخلد إلى النّوم

291
00:19:42,420 --> 00:19:45,960
بوضع العالم اليوم، أنتِ الزبونة
الوحيدة التي نحظى بها

292
00:19:46,380 --> 00:19:49,030
استخدمي هذه الغرفة كما يحلو لكِ

293
00:19:49,910 --> 00:19:51,820
حسناً، طابت ليلتكِ

294
00:19:52,170 --> 00:19:53,510
طابت ليلتكِ

295
00:19:58,100 --> 00:19:59,960
...ماشيرو-ساما

296
00:20:02,090 --> 00:20:03,430
لا، غير ممكن

297
00:20:14,300 --> 00:20:15,180
استيقظي

298
00:20:15,750 --> 00:20:17,370
استيقظي يا كون

299
00:20:18,670 --> 00:20:19,470
...كون

300
00:20:22,020 --> 00:20:24,740
ستُصابين بنزلة برد إذا نمتِ في الأرض

301
00:20:26,650 --> 00:20:28,390
هاكو؟

302
00:20:29,580 --> 00:20:30,930
بئساً

303
00:20:31,320 --> 00:20:35,010
كنتِ دوماً من تتذمّرين عندما لا أنام
على فِراش مناسب ومُريح

304
00:20:35,370 --> 00:20:36,340
!هاكو

305
00:20:36,340 --> 00:20:39,130
ارتدي هذا قبل أن تبردي، اتّفقنا؟

306
00:20:39,530 --> 00:20:40,430
ماذا؟

307
00:20:41,170 --> 00:20:44,800
يبدو وكأنّكِ رأيتِ شبحاً

308
00:20:44,800 --> 00:20:48,550
!أنت... اختفيت فحسب

309
00:20:49,430 --> 00:20:53,060
أين... أين كنت؟

310
00:20:54,320 --> 00:20:56,310
...كنتُ أبحث عنك لفترة طويلة

311
00:20:56,310 --> 00:20:59,250
...بحثتُ لفترة طويلة جدّاً

312
00:20:59,820 --> 00:21:01,530
كفاكِ حماقة

313
00:21:02,080 --> 00:21:05,890
كنتُ بجانبكِ طوال الوقت

314
00:21:06,540 --> 00:21:07,590
هكذا إذاً

315
00:21:07,940 --> 00:21:11,580
أنا آسف، جعلتُكِ تشعرين وكأنّكِ وحيدة

316
00:21:11,580 --> 00:21:15,460
أجل... كلّ الآخرين أرادوا رؤيتك أيضاً

317
00:21:17,330 --> 00:21:20,940
عندما يعلمون بأنّك عدت، سيفرحون

318
00:21:21,760 --> 00:21:24,880
وجدتُها. ما رأيك أن نذهب جميعاً
إلى نُزُل هاكوروكاكو؟

319
00:21:27,690 --> 00:21:31,100
هاكو، لماذا لا تقول شيئاً؟

320
00:21:32,160 --> 00:21:35,870
البريق شديد لدرجة لا أرى وجهك

321
00:21:37,420 --> 00:21:39,920
دعني أراك

322
00:21:41,450 --> 00:21:44,210
هذا غريب على ما أعتقد

323
00:21:45,380 --> 00:21:47,170
...لا أستطيع االحركة

324
00:21:49,680 --> 00:21:52,950
...هيّا يا هاكو... أرجوك

325
00:21:53,410 --> 00:21:57,270
اقترب أكثر. أرجوك، اقترب منّي أكثر

326
00:22:13,900 --> 00:22:15,140
أين أنا؟

327
00:22:15,760 --> 00:22:19,100
هكذا إذاً... غلبني النُّعاس

328
00:22:20,170 --> 00:22:21,230
!هاكو

329
00:22:24,150 --> 00:22:25,250
حلم؟

330
00:22:25,250 --> 00:22:26,920
كون، تعالي إلى هنا

331
00:22:26,920 --> 00:22:28,490
تعالي بسرعة

332
00:22:29,290 --> 00:22:30,690
مذهل، صحيح؟

333
00:22:36,890 --> 00:22:40,940
كان هناك ثلج في كلّ مكان في الأرض البارحة

334
00:22:40,940 --> 00:22:44,040
أجل... لكن لماذا؟

335
00:22:44,040 --> 00:22:46,670
لا أعلم. هذا غامض

336
00:22:47,060 --> 00:22:51,250
ربّما إشاعات ماشيرو-ساما صحيحة؟

337
00:22:52,130 --> 00:22:52,840
...هاكو

338
00:22:54,850 --> 00:22:57,290
سقطَ مِعطفكِ

339
00:22:57,290 --> 00:22:58,960
شكراً

340
00:23:00,790 --> 00:23:03,360
...هذا لهاكاو

341
00:23:05,980 --> 00:23:07,600
سوف أستعير هذا

342
00:23:08,090 --> 00:23:11,190
لا أشعر بأنّني على ما يُرام من دونه

343
00:23:18,150 --> 00:23:24,880
هكذا إذاً. هاكو... هاكو أنقذنا جميعاً

344
00:23:28,870 --> 00:23:30,710
...أتيت إذاً

345
00:23:32,790 --> 00:23:35,750
أخيراً... أخيراً وجدتُك

346
00:23:43,620 --> 00:23:47,290
!هذه المرّة، لن أدعك تهرب يا هاكو