1
00:00:03,170 --> 00:00:07,660
أوشتور ورجاله سيأكلون الطعم
...حتماً ويعودون إلى إينّاكاموي

2
00:00:08,430 --> 00:00:12,280
لكن دون أن يدركوا بأنّني أعرف مخبئهم

3
00:00:24,120 --> 00:00:27,310
!الختم الذهبيّ سيكون لي

4
00:01:59,850 --> 00:02:01,720
هل يمكنك أن تسهبي أكثر في التّفاصيل؟

5
00:02:02,150 --> 00:02:05,810
أرسل القصر جنوداً إلى إينّاكاموي

6
00:02:05,810 --> 00:02:07,500
أكثر من 2000

7
00:02:07,500 --> 00:02:10,940
سيصلون إينّاكاموي في غضون أيّام

8
00:02:11,310 --> 00:02:12,460
من قائدهم؟

9
00:02:12,820 --> 00:02:16,720
حارس اليسار الإمبراطوريّ في طليعتهم

10
00:02:18,280 --> 00:02:21,660
حارس اليسار الإمبراطوريّ... ميكازوتشي؟

11
00:02:22,080 --> 00:02:23,580
ميكازوتشي؟

12
00:02:23,580 --> 00:02:26,040
...إذا كان ميكازوتشي قادماً، إذاً

13
00:02:26,550 --> 00:02:27,850
مولايّ

14
00:02:28,640 --> 00:02:30,120
...أخي

15
00:02:34,710 --> 00:02:36,960
!سنعود إلى إينّاكاموي

16
00:02:44,470 --> 00:02:47,050
هذا هو الطريق الأسرع

17
00:02:47,050 --> 00:02:49,060
لكن هل أنت متأكّد؟

18
00:02:49,290 --> 00:02:50,220
لا مشكلة

19
00:02:50,630 --> 00:02:51,440
نيكوني

20
00:02:51,440 --> 00:02:55,540
أجل. أرسلتُ مبعوثين بناء على طلب

21
00:02:55,910 --> 00:02:57,130
مبعوثون؟

22
00:02:57,130 --> 00:02:59,190
هل ستطلب تعزيزات؟

23
00:02:59,190 --> 00:03:02,570
،إذا كان توكيفوسا يعمل مع رايكو

24
00:03:06,340 --> 00:03:10,970
ما يعني بأنّه من المؤكّد سينصب فخّاً
في طريقنا إلى الدّيار

25
00:03:15,780 --> 00:03:20,590
لكن إذا استطعنا توقُّع ذلك، فهناك
أمور يمكننا فعلها

26
00:03:24,030 --> 00:03:26,910
!أهدافنا تتحرّك كما هو مُتوقّع

27
00:03:27,330 --> 00:03:28,830
!هناك سبعة بالمُجمل

28
00:03:28,830 --> 00:03:30,910
!لا توجد قوّات معهم

29
00:03:30,910 --> 00:03:33,730
،ظننتُهم سيستعيرون قوّات من غينهو

30
00:03:34,000 --> 00:03:35,880
فلا أرى حتّى جنديّ واحد؟

31
00:03:35,880 --> 00:03:40,190
أوشتور المسكين... سيكون هذا قبرك

32
00:03:40,420 --> 00:03:42,160
!في مواقعكم

33
00:03:42,160 --> 00:03:43,280
!حاضر

34
00:03:45,170 --> 00:03:47,370
اقتربنا من الوادي العظيم

35
00:03:47,700 --> 00:03:51,420
زحف لمدّة ساعة عقب ذلك، لنصل إلى الحدود

36
00:03:51,870 --> 00:03:54,420
!توخّوا الحذر جميعاً

37
00:03:59,940 --> 00:04:01,660
!جُبناء

38
00:04:01,660 --> 00:04:02,550
!تجاهلوهم

39
00:04:02,550 --> 00:04:03,340
!اركضوا

40
00:04:11,150 --> 00:04:11,980
!يا للهول

41
00:04:12,420 --> 00:04:13,500
ما الأمر؟

42
00:04:13,500 --> 00:04:15,510
جفَّ النّهر

43
00:04:15,510 --> 00:04:17,120
هذا مؤسف لنا

44
00:04:17,550 --> 00:04:20,070
سوف نتوجّه إلى الجانب الآخر بأسرع ما يمكن

45
00:04:24,380 --> 00:04:27,850
!أهلاً بك يا أوشتور

46
00:04:27,850 --> 00:04:29,490
!لكن سيكون هذا المكان مقبرتكم

47
00:04:29,900 --> 00:04:33,330
!أنتم مُحاصرون تماماً

48
00:04:35,110 --> 00:04:42,130
أعيدوا ختمي الذهبيّ وحينها سأفكّر
في إبقائكم على قيد الحياة

49
00:04:42,430 --> 00:04:43,740
!أخي

50
00:04:43,740 --> 00:04:46,380
كما توقّعت، حاصرنا من الأمام والخلف

51
00:04:46,680 --> 00:04:48,530
ماذا نفعل يا أوشتور؟

52
00:04:48,530 --> 00:04:49,630
اهدئي

53
00:04:50,180 --> 00:04:53,400
أوغي، كم بقي حتّى الفجر؟

54
00:04:53,400 --> 00:04:55,140
أقلّ من ساعة

55
00:04:55,670 --> 00:04:57,050
هذا وقتٌ كافٍ

56
00:04:57,420 --> 00:04:58,900
اسمعوا جميعاً

57
00:04:59,350 --> 00:05:01,270
لديك خطّة إذاً

58
00:05:01,660 --> 00:05:02,730
عُلِم

59
00:05:02,730 --> 00:05:04,630
سنفعل كما طلبت منّا يا مولايّ

60
00:05:06,970 --> 00:05:09,570
ما الّذي يؤخّرهم؟

61
00:05:10,590 --> 00:05:14,040
أليس من المبكّر قليلاً الافتراض بأنّك ربحت؟

62
00:05:15,410 --> 00:05:17,370
!كلّ واحد منّا يساوي ألف مُحارب

63
00:05:17,710 --> 00:05:21,870
!لن تكون بضعة مئات من السّهام كافية لإيقافنا

64
00:05:21,870 --> 00:05:23,350
!هذا صحيح

65
00:05:23,350 --> 00:05:26,090
!سِهام الجبناء لا تُهاب

66
00:05:26,090 --> 00:05:29,510
!اشعروا بقوّة سهم أيفينكوروغا الحقيقيّ

67
00:05:36,380 --> 00:05:39,700
!لا تخافوا! انطلقوا

68
00:05:41,790 --> 00:05:42,880
!ها نحن ذا

69
00:05:42,880 --> 00:05:45,790
!اقضوا على أيّ جنديّ يعترض طريقنا

70
00:05:45,790 --> 00:05:46,360
!حاضر

71
00:06:14,220 --> 00:06:15,560
!ضعفاء

72
00:06:15,560 --> 00:06:17,220
!ضعفاء للغاية

73
00:06:23,060 --> 00:06:25,570
توقّعتُ هذا

74
00:06:25,830 --> 00:06:30,530
عندما يعمل شخص على صيد خنزير
برّي، لن يكون طائشاً ويقف أمامه

75
00:06:31,490 --> 00:06:33,600
...هكذا

76
00:06:40,740 --> 00:06:43,590
!يكون الصّيد

77
00:06:45,200 --> 00:06:47,000
إلى أين يصوّب؟

78
00:06:47,950 --> 00:06:50,380
!إنّه ليس إلّا حاكم مُزيّف

79
00:06:55,740 --> 00:06:58,140
!لا يُقارن أبداً بأبي

80
00:06:59,690 --> 00:07:00,810
ماذا؟

81
00:07:00,810 --> 00:07:01,860
ما هذا؟

82
00:07:19,730 --> 00:07:22,740
هذا ما بدا غريباً إذاً

83
00:07:41,510 --> 00:07:43,480
لا مفرّ لكم الآن

84
00:07:47,010 --> 00:07:48,900
كيف أمكنَه فعل هذا بزملائه؟

85
00:07:49,350 --> 00:07:50,740
!هذا لا يُغتفَر

86
00:07:50,740 --> 00:07:53,810
وتعتبر نفسك حاكم أيفينكوروغا؟

87
00:07:53,810 --> 00:07:55,660
ولمَ أبالي؟

88
00:07:55,660 --> 00:07:58,450
إذا انتصرت، سيصدح اسمي في كلّ مكان للأبد

89
00:07:59,420 --> 00:08:01,090
هذه فرصتكم الأخيرة

90
00:08:01,550 --> 00:08:06,630
!إذا رأيتُ منكم أيّ مقاومة إضافيّة، لن أرحمكم

91
00:08:06,950 --> 00:08:08,590
!كم أنت وضيع

92
00:08:08,590 --> 00:08:11,180
حسناً، ماذا ستفعلون؟

93
00:08:11,930 --> 00:08:13,220
حسنٌ

94
00:08:15,180 --> 00:08:17,050
قرار ذكيّ

95
00:08:17,280 --> 00:08:18,620
...أخي

96
00:08:18,620 --> 00:08:22,010
!أوّلاً، أعيدوا الختم الذهبيّ الّذي أخذتموه منّي

97
00:08:22,010 --> 00:08:24,390
!خسرتَ يا توكيفوسا

98
00:08:25,690 --> 00:08:26,730
ماذا؟

99
00:08:31,310 --> 00:08:34,030
!أخي! فعلناها

100
00:08:34,030 --> 00:08:35,570
!مـ-مستحيل

101
00:08:35,830 --> 00:08:37,860
انقلبت الموازين

102
00:08:38,210 --> 00:08:40,790
!القائد توكيفوسا! يجب أن ننسحب

103
00:08:40,790 --> 00:08:44,350
هل تقول لي أن أستسلم فحسب؟

104
00:08:44,870 --> 00:08:48,390
...لا، لكن... لا يمكننا

105
00:08:49,230 --> 00:08:51,150
—كلام فارغ! ما زال بمقدورنا

106
00:08:51,600 --> 00:08:53,710
!توكيفوسا، يكفي

107
00:08:54,130 --> 00:08:54,760
ماذا؟

108
00:08:58,510 --> 00:09:00,130
...أنت

109
00:09:02,240 --> 00:09:04,130
!تصالح مع أبي

110
00:09:04,470 --> 00:09:09,270
لا سبب يدفع شعب إيزوروها للاقتتال
!بسبب ضغينة قديمة بعد الآن

111
00:09:10,470 --> 00:09:14,860
،إذاً ليس غينهو من يسخر منّي فحسب
بل فتاة صغيرة مثلكِ كذلك؟

112
00:09:15,260 --> 00:09:18,270
!غينهو هو شجرة عظيمة، وأنا مجرّد عشبة ضارّة

113
00:09:18,270 --> 00:09:20,910
كلّما نما أكثر، غرقتُ في الظّلال أكثر

114
00:09:20,910 --> 00:09:23,870
!مهما كانت الزهور الّتي تتفتّح بفضلي، لا أحد يبالي

115
00:09:24,480 --> 00:09:27,180
!حاكم العشائر! أحد قادة الأعمدة الثّمانية

116
00:09:27,180 --> 00:09:30,050
هذه الألقاب ليست أكثر من مجرّد
!تبجُّح فارغ من شخص مُحتال

117
00:09:30,050 --> 00:09:31,790
!هذا غير صحيح

118
00:09:31,790 --> 00:09:34,380
!كلاهما شرف عظيم

119
00:09:34,380 --> 00:09:36,570
!لا تكذبي عليّ

120
00:09:36,890 --> 00:09:40,380
لكن إذا حصلتُ على الختم الذهبيّ، تختلف الأمور

121
00:09:40,380 --> 00:09:43,970
!إنّها رمز القوّة! قوّة الحاكم الحقيقيّ

122
00:09:44,370 --> 00:09:49,980
،هذا يجعلني أولو الخاص بإيزوروها
!والّذي يعترف به الميكادو

123
00:09:50,320 --> 00:09:54,710
ما دام لديّ هذا، فالشرف والقوّة
!يمكن أن يكونا لي

124
00:09:56,710 --> 00:09:58,780
هل هذا بتلك الأهمّية بالنسبة لك؟

125
00:09:58,780 --> 00:10:00,620
!بالطبع

126
00:10:02,630 --> 00:10:04,140
...السّبب هو

127
00:10:06,480 --> 00:10:07,540
!هذا الشيء إذاً

128
00:10:10,490 --> 00:10:14,170
!إنّه لي

129
00:10:12,240 --> 00:10:13,250
!لا

130
00:10:21,280 --> 00:10:22,970
!عاد لي من جديد

131
00:10:22,970 --> 00:10:26,040
!أنا حاكم الآن

132
00:10:26,040 --> 00:10:30,580
!أنا أحد قادة الأعمدة الثّمانية

133
00:10:40,820 --> 00:10:42,820
!توكيفوسا

134
00:10:50,030 --> 00:10:52,170
...توكيفوسا

135
00:11:08,250 --> 00:11:10,720
شكراً لكم على القدوم اليوم جميعاً

136
00:11:11,390 --> 00:11:14,230
سوف أؤدّي الآن طقوس الخِلافة

137
00:11:16,320 --> 00:11:17,310
نوسوري

138
00:11:17,310 --> 00:11:18,070
!حاضرة

139
00:11:18,400 --> 00:11:23,260
هل أنتِ مستعدّة لحمل مستقبل إيزوروها
كحاكمته الجديدة؟

140
00:11:23,260 --> 00:11:24,240
!بالطبع

141
00:11:25,620 --> 00:11:28,990
!أنا نوسوري، الابنة الكبرى للحاكم السّابق، غينغهو

142
00:11:29,670 --> 00:11:33,060
برحيل الميكادو، ياماتو

143
00:11:33,060 --> 00:11:37,000
وحاكمتها الشرعيّة الأميرة آنجو يعانيان بشكل كبير

144
00:11:37,500 --> 00:11:41,470
عدتُ إلى موطني وذلك كي أتمكّن من مساعدتها

145
00:11:42,300 --> 00:11:44,340
سقطَ ختم توكيفوسا الذهبيّ

146
00:11:44,790 --> 00:11:49,250
في ماء الوادي العظيم معه واختفيا

147
00:11:51,380 --> 00:11:54,410
،لكن حتّى من دون مساعدة الختم الذهبيّ

148
00:11:54,410 --> 00:11:56,940
!سأكون حاكمة تفوق أبي

149
00:11:57,450 --> 00:12:02,920
!لأجل الأميرة، مدّوني بقوّتكم، قوّة إيزوروها

150
00:12:02,920 --> 00:12:03,860
!حسناً

151
00:12:08,080 --> 00:12:10,570
من دون مساعدة الختم الذهبيّ؟

152
00:12:12,770 --> 00:12:15,790
!لنحتفل بحاكمتنا الجديدة إذاً

153
00:12:16,330 --> 00:12:18,880
!اليوم سنشرب ونأكل

154
00:12:24,420 --> 00:12:26,930
وبهذا أكون قد اختممت تقريري

155
00:12:28,290 --> 00:12:29,580
أحسنت صنعاً

156
00:12:30,000 --> 00:12:31,890
ماذا عن جيش القصر؟

157
00:12:32,220 --> 00:12:35,460
انسحبَ دون الوصول إلى حدودنا

158
00:12:35,980 --> 00:12:38,770
ولم يكن ميكازوتشي معه أيضاً

159
00:12:39,010 --> 00:12:41,270
كان مجرّد طعم إذاً؟

160
00:12:43,060 --> 00:12:45,880
لدينا حلفنا مع إيزوروها

161
00:12:45,880 --> 00:12:49,490
سيمثِّل نفعاً عظيماً لكِ

162
00:12:49,810 --> 00:12:53,620
!أتأمّل أشياء عظيمة منكِ كحاكمتهم الجديدة

163
00:12:53,940 --> 00:12:55,580
!اعتمدي عليّ

164
00:12:55,910 --> 00:12:59,710
كان ذلك مُمكناً بمساعدة غينهو فقط

165
00:13:00,130 --> 00:13:01,840
!أشكرك جزيل الشّكر

166
00:13:02,390 --> 00:13:06,340
كلماتك شرف لي، لكن لم أفعل شيئاً

167
00:13:06,560 --> 00:13:08,200
أنت متواضع جدّاً

168
00:13:08,200 --> 00:13:11,440
،قيل لي بأنّك زرت كلّ العشائر مُقدّماً

169
00:13:11,440 --> 00:13:14,930
وهذا ما سمح لطقوس الخِلافة تسير بسلاسة

170
00:13:15,190 --> 00:13:19,370
حبّذا لو تستمرّ في مساعدتنا

171
00:13:19,710 --> 00:13:21,310
لم أعد صغيراً كما كنت

172
00:13:21,310 --> 00:13:24,320
أريد العودة إلى تقاعدي الهادئ

173
00:13:24,940 --> 00:13:30,150
لكن، في الواقع... يمكنني على الأقلّ
الاهتمام بالامور في ظلّ غياب حاكمنا

174
00:13:31,310 --> 00:13:35,470
بالمناسبة، لديّ سؤال إن لم يكن هناك مانع

175
00:13:37,170 --> 00:13:42,020
لماذا تمنحين طفلتي الصّغيرة مركزاً
قريباً من مركزكِ؟

176
00:13:42,020 --> 00:13:45,130
أخشى أن تسبّب لك متاعبَ كثيرة

177
00:13:47,650 --> 00:13:51,630
نوسوري أنقذت حياتي

178
00:13:52,310 --> 00:13:53,520
أنقذت حياتكِ؟

179
00:13:53,900 --> 00:13:58,020
حتّى بعد وفاة والدي، تمّ تسميمي، بل
وتمّ إرسال قتَلة مأجورين لاستهدافي

180
00:13:59,060 --> 00:14:03,820
ظهرَتْ أميرة مُزيّفة وفقدتُ مركزي
وكلّ ما كنتُ أملكه

181
00:14:05,070 --> 00:14:09,600
وكانت نوسوري وأوشتور من وقفا بجانبي

182
00:14:10,780 --> 00:14:15,150
هم والآخرون كانوا الوحيدين الّذين بقوا معي

183
00:14:16,730 --> 00:14:18,750
هل هذه إجابة كافية؟

184
00:14:19,580 --> 00:14:22,400
إنّها أكثر من كافية

185
00:14:27,380 --> 00:14:30,430
أبي، هل من أمور مهمّة نناقشها؟

186
00:14:32,270 --> 00:14:34,550
أوشتور، حارس اليمين الإمبراطوري

187
00:14:34,550 --> 00:14:36,970
إنّه رجل مُبهِر

188
00:14:37,530 --> 00:14:39,690
وهو يمثّل كلّ ما قيل عنه في الإشاعات كقائد

189
00:14:40,240 --> 00:14:43,470
نادراً ما تمدح شخصاً بهذه الغزارة

190
00:14:44,000 --> 00:14:45,900
هل هناك مشكلة؟

191
00:14:46,870 --> 00:14:50,160
لا، لقد راقني فحسب

192
00:14:50,540 --> 00:14:52,080
وأريده لنفسي

193
00:14:54,350 --> 00:15:00,330
أو ربّما ينبغي القول بأنّني أريد نسبَه

194
00:15:02,250 --> 00:15:03,540
نسبه؟

195
00:15:05,680 --> 00:15:08,010
أنتِ بلهاء دوماً

196
00:15:09,280 --> 00:15:14,370
!أقصد أن تؤسّسي علاقة حميميّة معه

197
00:15:20,350 --> 00:15:22,940
!عـ-علاقة حميميّة؟

198
00:15:26,370 --> 00:15:29,650
أوشتور، أحضرتُ لك هذا

199
00:15:31,140 --> 00:15:33,430
...هل هذا

200
00:15:33,430 --> 00:15:36,700
أجل، كبد تشاموكّو

201
00:15:36,990 --> 00:15:38,560
يبدو شهيّاً

202
00:15:38,950 --> 00:15:42,090
يجب أن نشكر شيس على إرساله

203
00:15:42,090 --> 00:15:43,920
متى أرسلته لك؟

204
00:15:44,150 --> 00:15:49,940
في كوجيوري، نرسل تشاموكّو إلى العائلة
وأولئك القريبين منّا

205
00:15:50,420 --> 00:15:52,560
أصرّتْ على أن تجرّبه

206
00:15:54,800 --> 00:15:58,380
إذاً سأقبل هديّتها بكلّ سرور

207
00:15:58,380 --> 00:15:59,930
...هل هذا يعني

208
00:16:00,400 --> 00:16:02,520
!إنّه لذيذ

209
00:16:03,670 --> 00:16:04,590
!شهيّ للغاية

210
00:16:06,350 --> 00:16:09,180
كم هو أبله

211
00:16:13,040 --> 00:16:14,410
نوسوري؟

212
00:16:16,480 --> 00:16:21,940
أ-أوشتور، هـ-هلّا رافقتَني من فضلك
إلى الصّيد يوم غد؟

213
00:16:31,500 --> 00:16:35,430
فـ-في الواقع، الطقس مثاليّ للصيد

214
00:16:35,810 --> 00:16:39,260
كان الطقس جميلاً في آخر مرّة ذهبنا
فيها للصيد أيضاً، أليس كذلك؟

215
00:16:39,740 --> 00:16:43,550
كان ذلك بعد أن عدنا إلى إينّاكاموي، صحيح؟

216
00:16:45,910 --> 00:16:47,480
...أ-أجل

217
00:16:48,090 --> 00:16:49,870
كنتِ رائعة

218
00:16:52,560 --> 00:16:54,660
مهاراتكِ في الصّيد

219
00:16:55,690 --> 00:16:58,740
أنتِ أفضل صيّادة أعرفها

220
00:16:59,030 --> 00:17:00,950
أ-أنا؟

221
00:17:00,950 --> 00:17:03,120
أعني، بالطبع أنا كذلك

222
00:17:03,440 --> 00:17:05,000
...امرأة جيّدة

223
00:17:05,300 --> 00:17:09,590
!أقصد أن تؤسّسي علاقة حميميّة معه

224
00:17:15,290 --> 00:17:16,950
!حـ-حسناً

225
00:17:16,950 --> 00:17:18,930
!سأعلّمك كيفيّة الصّيد

226
00:17:18,930 --> 00:17:19,550
ماذا؟

227
00:17:19,550 --> 00:17:21,010
!لا تقل لا

228
00:17:22,110 --> 00:17:23,470
...أوّلاً

229
00:17:32,540 --> 00:17:34,080
ماذا تفعل؟

230
00:17:35,410 --> 00:17:37,790
...لـ-لا يهمّ أبداً

231
00:17:37,790 --> 00:17:40,430
!لا أريد مُساعدة مُنافسي

232
00:17:50,370 --> 00:17:51,880
مُذهلة كعادتكِ

233
00:17:51,880 --> 00:17:53,270
بالطبع

234
00:17:53,270 --> 00:17:55,210
هذا سهل للغاية

235
00:17:57,670 --> 00:18:00,220
الصّيد هو طريقة ممتازة لتهدئة العقل

236
00:18:00,570 --> 00:18:03,200
أظنّني عليّ الشّروع في العمل أيضاً

237
00:18:13,650 --> 00:18:15,850
نحن نبلي حسناً اليوم

238
00:18:21,650 --> 00:18:23,140
!لا

239
00:18:23,140 --> 00:18:25,290
!عليّ التركيز على المنافسة

240
00:18:29,360 --> 00:18:32,080
كان ينبغي أن أعلم بأنّني لا أستطيع
هزيمتكِ يا نوسوري

241
00:18:32,580 --> 00:18:35,550
لقد تحسّنت، لكن لا تزال تحتاج للكثير لتتعلّمه

242
00:18:35,840 --> 00:18:40,310
والآن، أظنّك مَديناً لي بشراب
لذيذ احتفالاً بنصري

243
00:18:41,030 --> 00:18:42,490
عظيم

244
00:18:42,940 --> 00:18:46,130
!ستكون مأدبة مُمتعة اللّيلة

245
00:18:51,290 --> 00:18:52,660
سأحمل القليل

246
00:18:52,980 --> 00:18:54,360
شكراً

247
00:18:55,020 --> 00:18:55,900
...إذاً

248
00:19:09,680 --> 00:19:11,640
من المؤسف أن نضطرّ لترك صيدنا

249
00:19:11,640 --> 00:19:13,110
لا مشكلة

250
00:19:13,110 --> 00:19:15,340
يمكننا العودة فحسب

251
00:19:16,660 --> 00:19:17,840
أجل

252
00:19:24,400 --> 00:19:25,600
شكراً

253
00:19:26,300 --> 00:19:28,970
بخصوص ماذا؟

254
00:19:30,000 --> 00:19:31,770
...بفضلك

255
00:19:34,000 --> 00:19:35,350
،حتّى ولو خطونا خطوة للأمام

256
00:19:35,350 --> 00:19:39,650
الطريق تجاه استعادة العاصمة ما زال طويلاً

257
00:19:40,490 --> 00:19:42,990
سأعتمد عليك يا نوسوري

258
00:19:43,970 --> 00:19:46,580
أجل، بالطبع

259
00:19:50,860 --> 00:19:55,240
بحملِك لي هكذا، أشعر وكأنّني
عدتُ إلى كوني طفلة

260
00:19:55,240 --> 00:19:56,750
طفلة؟

261
00:19:57,650 --> 00:20:00,340
قد لا تصدّق ذلك، لكن كنتُ صبيانيّة

262
00:20:01,440 --> 00:20:02,450
كنتِ"؟"

263
00:20:02,800 --> 00:20:07,470
كنتُ أحياناً أصعد الجبال مع أبي

264
00:20:07,470 --> 00:20:09,810
لكن كان ذلك أكبر من طاقة فتاة صغيرة

265
00:20:10,510 --> 00:20:16,520
وعندما تعبتُ كثيراً، كان أبي يحملني إلى المنزل

266
00:20:18,100 --> 00:20:22,360
...كان ظهره كبيراً ودافئاً

267
00:20:23,170 --> 00:20:24,660
هكذا تماماً

268
00:20:36,220 --> 00:20:37,880
...عجباً

269
00:22:17,750 --> 00:22:22,610
حظينا أخيراً بقاعدة ثابتة لجيش

270
00:22:22,850 --> 00:22:27,050
أشعر وكأنّ عملنا الدّؤوب قد أثمر أخيراً

271
00:22:27,050 --> 00:22:31,200
البلدان المُحيطة بنا بدأت تتحالف معنا أيضاً

272
00:22:31,920 --> 00:22:36,950
والآن ليس علينا القلق بشأن الحصار على ما أعتقد

273
00:22:36,950 --> 00:22:40,370
لكن لسنا جاهزين تماماً للهجوم

274
00:22:40,370 --> 00:22:44,950
علينا أن نبحث عن طريقة للتعاون مع ناكوكو

275
00:22:44,950 --> 00:22:48,840
ناكوكو دعمتنا طوال هذا الوقت، صحيح؟

276
00:22:48,840 --> 00:22:50,420
أجل

277
00:22:50,420 --> 00:22:53,570
،إنّهم في الجانب الآخر من البحر
،مع وجود العاصمة بيننا

278
00:22:53,570 --> 00:22:56,190
لذا لم نتمكّن من التواصل معهم حتّى الآن

279
00:22:57,050 --> 00:22:58,430
!أخي

280
00:22:58,430 --> 00:22:59,860
!المعذرة

281
00:23:00,230 --> 00:23:01,350
ما الأمر؟

282
00:23:06,070 --> 00:23:10,060
تفيد التّقارير بأنّ ناكوكو قد هوجِمت
،بواسطة جيوش القصر، وعاصمتها

283
00:23:10,060 --> 00:23:11,070
نارا، قد سقطت

284
00:23:11,350 --> 00:23:12,610
ماذا؟

285
00:23:12,610 --> 00:23:13,930
...لا

286
00:23:15,120 --> 00:23:19,250
،مُمثّلهم، سويانكيكور، الأولو الخاص بشياهورو

287
00:23:19,250 --> 00:23:22,080
طلبَ مقابلة الأميرة

288
00:23:23,310 --> 00:23:24,790
...أبي