265
00:15:31,650 --> 00:15:33,090
أحقاً هذا؟

266
00:15:33,090 --> 00:15:33,790
.نعم

267
00:15:34,350 --> 00:15:35,180
.أراكِ لاحقاً

268
00:15:46,150 --> 00:15:47,000
.ميو

