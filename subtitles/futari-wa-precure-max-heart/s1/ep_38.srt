1
00:00:18,160 --> 00:00:20,330
!ميسومي-سينباي! هيّا

2
00:00:21,840 --> 00:00:22,900
!رينا

3
00:00:28,440 --> 00:00:32,210
،عملنا بجدٍّ على تلك المسرحيّة

4
00:00:32,210 --> 00:00:34,610
!لكن أولئك الأوغاد عرقلوا الأداء

5
00:00:36,750 --> 00:00:39,250
...في المرّة المقبلة الّتي يأتون فيها، أقسم

6
00:00:39,250 --> 00:00:41,190
!ناغيسا! اهدئي، اهدئي، اهدئي

7
00:00:45,960 --> 00:00:47,490
!سأدعهم يدفعون الثّمن

8
00:02:13,740 --> 00:02:16,020
!هونوكا؟ هونوكا

9
00:02:16,020 --> 00:02:17,400
نعم؟

10
00:02:18,180 --> 00:02:19,400
تفضّلي

11
00:02:22,220 --> 00:02:24,280
من أمّي؟

12
00:02:29,930 --> 00:02:33,550
!وداعاً يا هونوكا؟
!روابطنا متينة للأبد

13
00:02:41,000 --> 00:02:42,200
هونوكا

14
00:02:42,910 --> 00:02:46,670
لم نركِ منذ مدّة، لكن آمل
أن تكوني على ما يُرام

15
00:02:47,340 --> 00:02:52,330
،كنّا نسافر حول العالم للعمل طوال هذا الوقت

16
00:02:52,330 --> 00:02:57,070
لكن سوف نستقرّ في باريس لفترة من الزّمن

17
00:02:57,070 --> 00:03:01,340
كنّا نأمل أن تنضمّي لنا أنتِ وجدّتكِ هناك

18
00:03:01,660 --> 00:03:07,050
نرغب في التكلّم معكِ حول مستقبلكِ كذلك

19
00:03:07,050 --> 00:03:09,450
ألن تأتي لزيارة؟

20
00:03:09,450 --> 00:03:10,630
أمّكِ

21
00:03:11,730 --> 00:03:13,600
نعيش... في باريس؟

22
00:03:19,680 --> 00:03:21,310
!باريس؟

23
00:03:21,310 --> 00:03:25,630
...أجل. ليس فوراً بالطّبع

24
00:03:25,630 --> 00:03:29,780
...لكن إذا انتهى المطاف باستقراري في باريس

25
00:03:30,550 --> 00:03:33,410
هل باريس بعيدة إلى هذا الحدّ؟

26
00:03:33,410 --> 00:03:34,470
!بعيدة جدّاً

27
00:03:34,470 --> 00:03:38,540
!إنّها وراء المُحيط، تبعُد ثلاثة أيّام بطائرة

28
00:03:38,540 --> 00:03:39,760
...ليس إلى هذه الدّرجة

29
00:03:40,130 --> 00:03:43,630
لكنّها رحلة إثنَي عشر ساعة
حتّى برحلة مُباشرة

30
00:03:43,630 --> 00:03:45,850
إثنا عشر ساعة؟

31
00:03:45,850 --> 00:03:48,370
ماذا ستقولين لها؟

32
00:03:48,370 --> 00:03:52,360
،سأضطرّ لتوديعكن حينها

33
00:03:52,360 --> 00:03:54,960
لذا لا أستطيع إجابتها فوراً

34
00:03:54,960 --> 00:03:57,340
ومشاعر والِدَي مُهمّة أيضاً

35
00:03:57,580 --> 00:03:59,460
هذا صحيح

36
00:03:59,460 --> 00:04:04,310
،لكن إذا أردتِ الذّهاب حقّاً
فأعتقد ينبغي لكِ ذلك

37
00:04:04,310 --> 00:04:08,290
ستكونين بخير. يمكنكِ تدبّر
!نفسكِ أينما ذهبتِ

38
00:04:10,430 --> 00:04:11,760
...أ-أجل

39
00:04:14,260 --> 00:04:15,530
!صباح الخير

40
00:04:15,530 --> 00:04:16,390
!شيهو؟

41
00:04:16,390 --> 00:04:17,860
!ناغيسا! صباح الخير

42
00:04:17,860 --> 00:04:18,680
صـ-صباح الخير؟

43
00:04:18,680 --> 00:04:20,260
!تأخّرنا، تأخّرنا، تأخّرنا

44
00:04:20,260 --> 00:04:21,260
!مهلاً

45
00:04:24,270 --> 00:04:25,620
!هونوكا! صباح الخير

46
00:04:25,620 --> 00:04:27,690
صباح الخير يا يوريكو

47
00:04:27,690 --> 00:04:29,610
!أسرعي أنتِ أيضاً يا هونوكا

48
00:04:31,910 --> 00:04:34,630
،الزّمن أشبه بمُسافر أبديّ"

49
00:04:34,630 --> 00:04:36,780
"والسّنوات العابِرة أشبه بمُسافِر

50
00:04:37,150 --> 00:04:40,970
لا أصدّق بأنّني قلتُ ذلك لها

51
00:04:40,970 --> 00:04:44,790
ستكونين بخير. يمكنكِ تدبّر
!نفسكِ أينما ذهبتِ

52
00:04:47,160 --> 00:04:49,630
،أولئك الّذين ولّوا تخلّوا عن رحلتهم"

53
00:04:50,170 --> 00:04:51,680
"...وذات يوم، نحن سنفعل كذلك

54
00:04:52,600 --> 00:04:54,820
حسناً، هذا يكفي لليوم

55
00:04:54,820 --> 00:04:57,430
!نهوض! انحناء

56
00:04:59,170 --> 00:05:00,530
...هونوكا

57
00:05:00,530 --> 00:05:03,700
...المعذرة، بخصوص ما تكلّمنا عنه

58
00:05:03,700 --> 00:05:04,800
...أنا فقط، المعذرة

59
00:05:04,800 --> 00:05:06,280
!ناغيسا، ناغيسا، ناغيسا

60
00:05:06,280 --> 00:05:07,580
ما-ماذا؟

61
00:05:07,580 --> 00:05:08,800
ما رأيكِ؟

62
00:05:08,800 --> 00:05:11,870
أردتِ عقد اجتماع قبل التمرّن، صحيح؟

63
00:05:11,870 --> 00:05:14,490
أ-أجل... آسفة، لنؤجّل ذلك

64
00:05:14,490 --> 00:05:14,880
!حسناً

65
00:05:18,890 --> 00:05:20,890
...حسناً... لنفترض فقط

66
00:05:20,890 --> 00:05:21,920
ماذا، ماذا، ماذا؟

67
00:05:21,920 --> 00:05:25,880
،إذا قلتُ بأنّني سأذهب إلى بلد آخر
فماذا كنتِ ستفعلين؟

68
00:05:26,500 --> 00:05:27,530
!إلى أين؟

69
00:05:27,530 --> 00:05:28,150
باريس

70
00:05:28,150 --> 00:05:31,090
!محظوظة، محظوظة، محظوظة
متى ستذهبين؟ هل هل رحلة عائليّة؟

71
00:05:31,090 --> 00:05:33,930
!ليست رحلة. انتقال. سأستقرُّ في باريس

72
00:05:33,930 --> 00:05:36,930
!بجدّية؟! سآتي للزّيارة

73
00:05:36,930 --> 00:05:38,570
!أنا أيضاً، أنا أيضاً، أنا أيضاً

74
00:05:39,010 --> 00:05:41,840
لكن هذا لن يحدث فعليّاً، مفهوم؟

75
00:05:42,150 --> 00:05:43,810
لن تسافري حقّاً؟

76
00:05:44,390 --> 00:05:49,040
أقصد، إذا لم أكن متأكِّدة ما إن
،أردتُ الذّهاب أم لا

77
00:05:49,040 --> 00:05:51,790
ماذا كنتُما ستقولان لي؟

78
00:05:52,830 --> 00:05:54,120
ماذا تقصدين؟

79
00:05:54,460 --> 00:05:56,860
لا أفهم سؤالكِ

80
00:05:57,100 --> 00:05:59,850
هل ستُسافرين إلى باريس أم لا؟

81
00:05:59,850 --> 00:06:02,130
!السّؤال ليس هنا

82
00:06:02,370 --> 00:06:04,560
،لستُ أفهم حقّاً

83
00:06:04,560 --> 00:06:07,330
!لكن إذا قرّرتِ الذّهاب، فأحضري لي هديّة

84
00:06:07,580 --> 00:06:10,140
!أنا أيضاً! أرجوكِ، أرجوكِ، أرجوكِ

85
00:06:11,280 --> 00:06:12,860
انسيا الأمر

86
00:06:12,860 --> 00:06:15,470
أنا السّبب لأنّني سألتُكما

87
00:06:15,850 --> 00:06:18,440
جاهزات؟ راقِبنَ جيّداً

88
00:06:27,330 --> 00:06:29,960
لستِ متأكّدة ما إن كنتِ ستُسافرين
إلى باريس أم لا؟

89
00:06:30,370 --> 00:06:32,920
كما قلت، إنّه مجرّد افتراض

90
00:06:32,920 --> 00:06:35,390
باريس؟ يُعيدني هذا للذّكريات

91
00:06:35,390 --> 00:06:37,290
كنتِ هناك؟

92
00:06:37,290 --> 00:06:38,490
لا

93
00:06:39,110 --> 00:06:40,930
!إذاً عن أي ذكريات تتكلّمين؟

94
00:06:41,090 --> 00:06:44,870
هناك مقهى كنتُ أتردّد إليه
!يوميّاً وأنا تلميذة

95
00:06:44,870 --> 00:06:47,340
!"كان اسم المقهى "باريس

96
00:06:47,580 --> 00:06:48,810
ماذا؟

97
00:06:49,120 --> 00:06:51,140
!يا لأيّام الشّباب تلك

98
00:06:51,590 --> 00:06:52,810
أيّام الشّباب"؟"

99
00:06:53,090 --> 00:06:57,440
التقيتُ بشخص هناك ووقعنا
...في الحُبّ وكنّا نتواعد

100
00:06:57,440 --> 00:06:59,280
خضنا الكثير من التّجارب حقّاً

101
00:06:59,280 --> 00:07:02,250
!ماذا؟ ماذا فعلتُما؟

102
00:07:03,230 --> 00:07:07,220
!لا أستطيع أن أخبركِ بذلك! تلك ذكرياتي الثّمينة

103
00:07:07,600 --> 00:07:09,420
!لا تتكلّمي هكذا

104
00:07:09,420 --> 00:07:11,560
!دعيني أتذوّق ولو قليلاً

105
00:07:11,560 --> 00:07:13,200
!ربّما أستطيع تعلُّم شيء

106
00:07:13,200 --> 00:07:15,230
لا، لا

107
00:07:15,230 --> 00:07:19,670
لحظة، ألم يكن لديكِ سؤال لي؟

108
00:07:20,420 --> 00:07:21,810
!المعذرة

109
00:07:21,810 --> 00:07:23,640
!أهلاً وسهلاً

110
00:07:24,890 --> 00:07:28,440
ما الّذي أفعله بالتّحديد؟

111
00:07:31,190 --> 00:07:32,880
ناغيسا-سان؟

112
00:07:34,200 --> 00:07:36,520
!تريدين أن تنفصلي عنّي وعن مِيبّل؟

113
00:07:36,520 --> 00:07:38,990
!مستحيل! لن يحدث هذا، ميبّو

114
00:07:38,990 --> 00:07:41,370
!لا أريد ذلك أيضاً، بوبّو

115
00:07:41,370 --> 00:07:44,990
!لا أريد الفُراق عن بولن، لولو

116
00:07:44,990 --> 00:07:46,960
!لولون. كفّي عن التمسُّك بي، بوبّو

117
00:07:47,340 --> 00:07:49,530
ابتعدي قليلاً فحسب، بوبّو

118
00:07:49,530 --> 00:07:51,470
!لا! أريد البقاء

119
00:07:50,200 --> 00:07:54,370
لا أريد الافتراق عن هونوكا أيضاً

120
00:07:54,650 --> 00:07:58,900
ماذا سأفعل إذا لم تكن هناك هونوكا
للحديث عن همومي ومشاكلي؟

121
00:07:58,900 --> 00:08:01,170
أو لتُساعدني في وظيفتي المدرسيّة؟

122
00:08:01,170 --> 00:08:03,710
أو لتشاركني وجبتها من الغداء
عندما أنسى وجبتي؟

123
00:08:04,160 --> 00:08:07,150
وتلك الأشياء هي السّبب الّذي
يجعلكِ تُريدينها أن تبقى، ميبّو؟

124
00:08:07,150 --> 00:08:09,450
...ليس ذلك فقط

125
00:08:09,450 --> 00:08:12,450
كلّ ما في الأمر أنّ ذلك
سيخلق الكثير من المشاكل

126
00:08:12,450 --> 00:08:13,620
والأمور الّتي تخصُّ بريكيور أيضاً

127
00:08:13,870 --> 00:08:17,890
لهذا أخبرتِها بأن تذهب إذا
أرادتْ ذلك، ميبّو

128
00:08:18,170 --> 00:08:20,460
!ماذا أردتني أن أقول؟

129
00:08:20,460 --> 00:08:24,370
لكن... أعتقد بدوتُ غير مُبالية قليلاً

130
00:08:24,980 --> 00:08:29,970
أنا متأكّدة بأنّ هونوكا-سان تُقدّر مشاعركِ

131
00:08:30,720 --> 00:08:32,940
...أعتقد ذلك، لكن

132
00:08:33,990 --> 00:08:38,780
لكن أما من شيء يمكنني قوله لهونوكا؟

133
00:08:51,340 --> 00:08:53,790
الذّهاب أو عدم الذّهاب؟

134
00:08:53,790 --> 00:08:56,330
أيُّهما يُسعدها أكثر؟

135
00:08:56,330 --> 00:08:58,500
!إنّه سؤال صعب

136
00:09:15,800 --> 00:09:17,750
أتيت إلى هنا... لرؤيتي؟

137
00:09:19,370 --> 00:09:21,220
لا أعلم

138
00:09:21,220 --> 00:09:22,720
...أنا فقط

139
00:09:23,610 --> 00:09:26,260
أين وُلِدت؟

140
00:09:26,910 --> 00:09:28,290
ما أنا؟

141
00:09:33,630 --> 00:09:39,040
يبدو أنّ صحوة ملِك الظّلام ليست ببعيدة

142
00:09:39,890 --> 00:09:44,280
في كلّ الأحوال، يجب أن نُدمِّر
أولئك الّذين يعترضون طريقه

143
00:09:51,330 --> 00:09:53,450
!عليكِ الذّهاب حتماً

144
00:09:53,450 --> 00:09:54,120
ماذا؟

145
00:09:54,370 --> 00:09:58,590
لطالما كان حلمي الدّراسة في أوروبّا

146
00:09:59,790 --> 00:10:02,760
لكن والدَي يقولان بأنّني صغيرة جدّاً
على الدّراسة خارج البلاد

147
00:10:02,760 --> 00:10:04,500
رفضاني رفضاً قاطعاً

148
00:10:05,550 --> 00:10:06,960
حقّاً؟

149
00:10:07,620 --> 00:10:12,240
إنَّ طلبَ والديكِ منكِ الانتقال
إلى باريس هو أشبه بحلمٍ لي

150
00:10:12,790 --> 00:10:14,670
إن كنتِ ستذهبين، فينبغي
،أن تذهبي بسنٍّ صغيرة

151
00:10:14,670 --> 00:10:16,710
!وتكسبين المعرفة

152
00:10:17,160 --> 00:10:19,810
لذا يجدر بكِ حقّاً أن تذهبي

153
00:10:19,810 --> 00:10:21,680
!فلا تسنح لكِ فُرصة كهذه كلّ يوم

154
00:10:22,600 --> 00:10:25,150
...هذا ما أعتقده، لكن

155
00:10:27,740 --> 00:10:29,920
!خذي

156
00:10:29,920 --> 00:10:32,320
!أسرع! إلى الأمام، إلى الأمام

157
00:10:36,380 --> 00:10:38,700
هونوكا! ماذا تفعلين هنا؟

158
00:10:38,700 --> 00:10:41,160
أردتُ أن أتفرّج فحسب

159
00:10:41,160 --> 00:10:43,130
هل اقتربت مُباراتكِ التّالية؟

160
00:10:43,990 --> 00:10:45,440
...هونوكا

161
00:10:47,520 --> 00:10:49,370
...تعلمين بأنّكِ تقولين دوماً

162
00:10:49,960 --> 00:10:52,340
بأنّه يجب على المرء أن يُقرّر مصيره بنفسه

163
00:10:52,860 --> 00:10:54,950
...لذا، أنا

164
00:10:55,730 --> 00:10:56,950
...لا أعرف كيف أعبِّر عن ذلك، لكن

165
00:10:56,950 --> 00:10:58,950
ناغيسا! ما التّالي؟

166
00:10:58,950 --> 00:11:00,380
...حـ-حسناً

167
00:11:00,380 --> 00:11:01,450
!انتظري لحظة

168
00:11:01,450 --> 00:11:02,850
!بسرعة، بسرعة، بسرعة

169
00:11:03,470 --> 00:11:05,960
آسفة يا هونوكا. هل يمكنني زيارتك
في المنزل لاحقاً؟

170
00:11:05,960 --> 00:11:07,460
يمكننا التكلّم أكثر حينها

171
00:11:07,460 --> 00:11:09,190
بالتّأكيد، أتمنّى ذلك

172
00:11:09,190 --> 00:11:10,930
آسفة لمُقاطعة تمرينكِ

173
00:11:10,930 --> 00:11:12,330
!لا عليكِ. إلى اللِّقاء

174
00:11:18,750 --> 00:11:20,610
...تعلمين بأنّكِ تقولين دوماً

175
00:11:20,610 --> 00:11:23,580
بأنّه يجب على المرء أن يُقرّر مصيره بنفسه

176
00:11:24,490 --> 00:11:28,110
...أعتقد ناغيسا على حقّ. لكن

177
00:11:28,110 --> 00:11:29,280
هونوكا؟

178
00:11:29,570 --> 00:11:30,880
نـ-نعم؟

179
00:11:30,880 --> 00:11:33,650
ناغيسا-سان هنا

180
00:11:36,140 --> 00:11:37,620
ناغيسا؟

181
00:11:38,600 --> 00:11:39,420
آسفة

182
00:11:40,210 --> 00:11:41,390
على ماذا؟

183
00:11:41,710 --> 00:11:44,690
أعتقد قلتُ بعض الكلام الأنانيّ

184
00:11:45,080 --> 00:11:48,770
إطلاقاً! أتفهّم شعوركِ كلّياً

185
00:11:48,770 --> 00:11:51,890
وأعتقد بأنّكِ مُحقّة تماماً

186
00:11:51,890 --> 00:11:52,630
أتعتقدين ذلك؟

187
00:11:52,630 --> 00:11:53,910
أجل

188
00:11:54,520 --> 00:11:56,000
!كم هذا مُطمئن

189
00:11:58,030 --> 00:11:59,980
...اسمعي يا هونوكا

190
00:11:59,980 --> 00:12:04,320
في وقت كهذا... قد يكون ذلك
...وقِحاً قليلاً، لكن

191
00:12:04,320 --> 00:12:08,950
المعذرة... في الواقع... من الصّعب
...قول ذلك، لكنّني

192
00:12:09,110 --> 00:12:10,380
...ناغيسا

193
00:12:12,670 --> 00:12:13,850
...هونوكا

194
00:12:14,580 --> 00:12:16,060
أتريدين أن تلعبي لعبة الإمساك؟

195
00:12:16,510 --> 00:12:18,130
الإمساك؟

196
00:12:26,020 --> 00:12:27,400
!ها أنا ذي

197
00:12:28,520 --> 00:12:29,900
!خذي هذه

198
00:12:33,930 --> 00:12:36,380
!رائع! مسكة جيّدة يا هونوكا

199
00:12:36,380 --> 00:12:37,720
!والآن حاولي أن تُمرّري

200
00:12:37,720 --> 00:12:40,180
!حسناً. ها أنا ذي

201
00:12:40,180 --> 00:12:41,380
!خذي

202
00:12:46,680 --> 00:12:48,720
!ناغيسا! أنتِ رائعة

203
00:12:49,410 --> 00:12:52,160
لستُ قائدة عن عبث

204
00:12:52,160 --> 00:12:54,160
!ها أنا ذي. تلقّيها

205
00:13:14,500 --> 00:13:16,150
...ناغيسا

206
00:13:16,150 --> 00:13:17,320
نعم؟

207
00:13:17,740 --> 00:13:21,130
لم نلعب الإمساك من قبل، صحيح؟

208
00:13:21,130 --> 00:13:22,550
!أجل، لم نلعب

209
00:13:27,120 --> 00:13:30,240
!إنّه لشعور لطيف أن نتحرّك هكذا

210
00:13:32,550 --> 00:13:33,930
!حقّاً؟

211
00:13:33,930 --> 00:13:35,470
أنا مسرورة

212
00:13:35,470 --> 00:13:37,210
!كلتاهما تشجّعتا كثيراً

213
00:13:37,210 --> 00:13:38,400
هذا لطيف، بوبّو

214
00:13:38,400 --> 00:13:41,810
ماذا عن انتقالها، ميبّو؟

215
00:13:41,810 --> 00:13:43,750
لا أعرف، مِيبّو

216
00:13:43,750 --> 00:13:47,380
لكن شعور هونوكا بالرّاحة هو
الشّيء الأهمّ، مِيبّو

217
00:13:47,380 --> 00:13:49,020
!الشّيء الأهمّ، لولو

218
00:13:49,020 --> 00:13:50,850
توقّفي، بوبّو

219
00:13:52,370 --> 00:13:53,950
هذا مُطمئن

220
00:13:55,610 --> 00:13:57,050
!هذا غير مُطمئن إطلاقاً، ميبّو

221
00:13:58,110 --> 00:14:00,170
!أشعر بحضور شرّير، ميبّو

222
00:14:01,780 --> 00:14:02,990
!ناغيسا

223
00:14:02,990 --> 00:14:04,140
نعم؟

224
00:14:07,620 --> 00:14:08,400
!شكراً

225
00:14:13,860 --> 00:14:15,710
أتستمتعان بوقتكما؟

226
00:14:17,730 --> 00:14:18,940
!ماذا تفعل؟

227
00:14:19,640 --> 00:14:22,850
...كلتاكما ستُصبحان مثل هذه الكُرة

228
00:14:22,850 --> 00:14:24,650
!ستُسحقان تماماً

229
00:14:24,810 --> 00:14:26,620
!ماذا قلت، ميبّو؟

230
00:14:26,940 --> 00:14:29,700
هذا كلام فارغ! هونوكا؟

231
00:14:35,720 --> 00:14:37,860
!موجة الشّفق الثنائيّة

232
00:14:44,060 --> 00:14:46,700
!مبعوثة النُّور، كيور بلاك

233
00:14:46,700 --> 00:14:49,570
!مبعوثة النُّور، كيور وايت

234
00:14:51,630 --> 00:14:53,510
!سوية، نحن بريكيور

235
00:14:54,940 --> 00:14:57,080
...يا خدم قوّة الظّلام

236
00:14:57,970 --> 00:15:00,380
!عودوا من حيث أتيتم

237
00:15:12,650 --> 00:15:15,210
ما المشكلة؟ أهذا ما لديكما فقط؟

238
00:15:23,670 --> 00:15:25,310
!هيكاري

239
00:15:28,800 --> 00:15:30,320
!لومينوس

240
00:15:30,320 --> 00:15:32,860
!السّيل اللّامِع

241
00:15:42,180 --> 00:15:44,820
!شرارة الحياة، لومينوس اللّامِعة

242
00:15:46,720 --> 00:15:49,130
!قلب النُّور وإرادة النُّور

243
00:15:49,530 --> 00:15:51,660
!لتوحيدهم جميعاً

244
00:16:14,450 --> 00:16:17,120
لِمَ لا تتوقّفن عن المُقاومة فحسب؟

245
00:16:17,490 --> 00:16:20,660
قريباً، سيُطوَّق هذا العالم بالظّلام

246
00:16:20,660 --> 00:16:23,740
لن يبقى لكُن مفرّ

247
00:16:24,260 --> 00:16:26,730
!مُحال أن نسمح بحدوث ذلك

248
00:16:26,930 --> 00:16:28,550
بلاك على حقّ

249
00:16:28,550 --> 00:16:32,020
!نحن من نُقرّر إلى أين نذهب

250
00:16:37,640 --> 00:16:39,410
تُقرّرن؟

251
00:16:39,410 --> 00:16:42,410
!هذا هُراء

252
00:16:44,780 --> 00:16:50,290
!ملِك الظّلام هو من يقرّر مصير العالم

253
00:16:53,520 --> 00:16:55,970
،ينبغي أن تقبلنَ قدركن

254
00:16:55,970 --> 00:16:58,500
!وتركعنَ وتسمحن للظّلام بابتلاعكن

255
00:16:58,500 --> 00:17:01,970
!لن يُسمَح لكم بفعل ما يحلو لكم

256
00:17:04,230 --> 00:17:05,400
!بلاك

257
00:17:05,970 --> 00:17:07,740
!لن يحدث ذلك

258
00:17:09,100 --> 00:17:12,040
!نحن من نُقرّر كيف نعيش

259
00:17:12,040 --> 00:17:15,610
!لن ندعكم تُقرِّرون عنّا

260
00:17:16,910 --> 00:17:19,030
...كلّ مقاومتكن

261
00:17:19,030 --> 00:17:21,230
!عقيمة...

262
00:17:25,750 --> 00:17:28,960
لا يمكنكن عصيان ملِك الظّلام

263
00:17:30,430 --> 00:17:32,180
...المصير

264
00:17:34,060 --> 00:17:36,570
هو طريقٌ نُمهّده نحن لأنفسنا...

265
00:17:36,570 --> 00:17:39,030
!لن أستسلم

266
00:17:41,270 --> 00:17:42,950
معها حقّ

267
00:17:42,950 --> 00:17:46,610
!سوف نرسم مصيرنا بأيدينا

268
00:17:46,610 --> 00:17:50,330
...إذاً أعتقد أنا بحاجة لأُظهِر لكُن

269
00:17:50,330 --> 00:17:51,480
!زاينّا

270
00:18:10,030 --> 00:18:12,180
!أنقذي بريكيور، بوبّو

271
00:18:12,180 --> 00:18:12,800
!حسناً

272
00:18:13,070 --> 00:18:15,600
!يجب علينا ردع قوّة الظّلام، بوبّو

273
00:18:15,900 --> 00:18:17,490
!إرادة النُّور

274
00:18:17,490 --> 00:18:21,160
!مُدّيني بالشّجاعة والأمل والقوّة

275
00:18:35,190 --> 00:18:36,520
!لومينوس

276
00:18:36,520 --> 00:18:39,130
!حركة هارتييل

277
00:18:46,670 --> 00:18:48,070
!شكراً يا لومينوس

278
00:18:48,840 --> 00:18:52,660
!سأُريكن قوّة الظّلام

279
00:19:00,180 --> 00:19:02,050
!وايت! بلاك

280
00:19:15,030 --> 00:19:18,680
نحن أقوى بكثير ممّا نبدو، مفهوم؟

281
00:19:19,130 --> 00:19:23,100
!سوف نُريك قوّتنا الحقيقيّة

282
00:19:23,100 --> 00:19:24,570
!ماذا؟

283
00:19:27,010 --> 00:19:30,360
املأ عيوننا بالأمل

284
00:19:30,360 --> 00:19:32,910
!ضع قوّة الأمل بين أيدينا

285
00:19:58,040 --> 00:19:59,600
!الرّعد الأسود

286
00:20:00,110 --> 00:20:01,940
!الرّعد الأبيض

287
00:20:06,520 --> 00:20:09,550
...روحا بريكيور الجميلتان

288
00:20:09,820 --> 00:20:12,380
!ستقهران القلوبَ الشرّيرة...

289
00:20:13,120 --> 00:20:15,350
...اللّولب الرُّخامي بريكيور

290
00:20:19,720 --> 00:20:21,320
!ماكس

291
00:20:25,300 --> 00:20:27,260
!هذا لا يعني شيئاً

292
00:20:36,780 --> 00:20:38,260
!شرارة

293
00:20:54,100 --> 00:20:56,050
!صباح الخير يا ناغيسا

294
00:20:56,050 --> 00:20:57,520
!صباح الخير يا هونوكا

295
00:20:57,520 --> 00:20:59,690
مُباراة اللّاكروس خاصّتكن اقتربت، صحيح؟

296
00:20:59,690 --> 00:21:01,120
أجل

297
00:21:02,100 --> 00:21:03,890
...ناغيسا

298
00:21:03,890 --> 00:21:07,490
هل ستستمرّين في لعِب اللّاكروس للأبد؟

299
00:21:08,110 --> 00:21:10,800
لا أستطيع الجزم بصراحة

300
00:21:10,800 --> 00:21:13,620
أجل، لا أعتقد ذلك. من الصّعب
معرفة هذه الأشياء

301
00:21:13,620 --> 00:21:16,050
!لا ضير من عدم المعرفة

302
00:21:16,050 --> 00:21:17,380
!صباح الخير يا هونوكا

303
00:21:17,380 --> 00:21:17,910
يوريكو؟

304
00:21:18,120 --> 00:21:21,880
هل يمكنني سحب ما قلتُه في الأمس؟

305
00:21:22,160 --> 00:21:23,850
ما قلتِه في الأمس؟

306
00:21:24,230 --> 00:21:26,280
!لا تُسافري إلى باريس

307
00:21:26,280 --> 00:21:28,690
!لا أريد أن أودّعكِ

308
00:21:28,690 --> 00:21:31,780
!ابقي معي للأبد

309
00:21:32,570 --> 00:21:34,950
كيف حالكِ يا أمّي؟

310
00:21:34,950 --> 00:21:37,760
جدّتي وأنا بصحّة جيّدة

311
00:21:37,760 --> 00:21:42,140
أعمل بجدٍّ في هذه البلدة
مع صديقاتي العزيزات

312
00:21:42,140 --> 00:21:44,130
،بخصوص العيش في باريس

313
00:21:44,130 --> 00:21:48,970
أعتقد أريد التّفكير في الأمر لفترة
...أطول حتّى أتوصّل لإجابة

314
00:21:48,970 --> 00:21:53,010
بالتّوفيق يا أمّي

315
00:21:53,010 --> 00:21:56,540
بلّغي تحيّاتي لأبي كذلك

316
00:21:56,540 --> 00:22:01,510
أظنّني سأكون أكثر نضجاً في المرّة
المُقبِلة الّتي نلتقي فيها

317
00:22:01,510 --> 00:22:04,020
انتظري ردّي بشأن ذلك

318
00:22:04,020 --> 00:22:07,450
أجل، استغرقي وقتكِ في التّفكير في الأمر

319
00:22:07,450 --> 00:22:10,000
كوني صادقة مع نفسكِ

320
00:22:10,770 --> 00:22:13,430
أليس هذا لطيفاً؟

321
00:22:13,430 --> 00:22:15,230
التعثُّر والكفاح

322
00:22:15,230 --> 00:22:18,460
وبذل الجهود في الأوقات الحرجة

323
00:22:18,460 --> 00:22:21,030
!هو الطّريق الصّحيح نحو السّعادة

324
00:23:57,710 --> 00:24:00,390
!ناغيسا، حان وقت نهائيّات اللّاكروس

325
00:24:00,390 --> 00:24:03,510
كنتُ متوتّرة جدّاً لدرجة لا أستطيع فيها سوى أكل
!ثلاث وجبات من الأرزّ على الفطور

326
00:24:03,510 --> 00:24:04,290
شَرِهة

327
00:24:04,290 --> 00:24:05,900
!لكن ينبغي أن تكوني بخير إذاً

328
00:24:05,900 --> 00:24:08,740
!لكن خصمنا هو هذا العملاق

329
00:24:08,740 --> 00:24:11,110
ناغيسا، لا تُبالغي

330
00:24:11,390 --> 00:24:13,120
!زاكينّا؟

331
00:24:13,120 --> 00:24:15,180
:نحن بريكيور ماكس هارت

332
00:24:15,180 --> 00:24:17,650
!أشعِلي كلّ حماسكِ
!نهائي الشّباب في رياضة اللّاكروس

333
00:24:17,650 --> 00:24:19,620
!حسناً، لنستعدّ للنّهائيّ

334
00:24:19,620 --> 00:24:22,180
بالمناسبة يا قائدة. ما هي خطّتكِ؟

335
00:24:22,180 --> 00:24:23,230
ا-المُحاولة الحثيثة؟