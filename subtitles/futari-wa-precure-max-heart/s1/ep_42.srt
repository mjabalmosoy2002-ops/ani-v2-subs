1
00:00:22,630 --> 00:00:26,650
تمكّنتُ أخيراً من تقديم هديّة لفوجيبي-سينباي

2
00:00:27,070 --> 00:00:31,320
من المهمّ التحلّي ببعض الشّجاعة

3
00:00:31,810 --> 00:00:34,360
!أشعر وكأنّني تقدّمتُ خطوة تجاه النّضج

4
00:00:37,410 --> 00:00:38,900
!ميسومي-سان

5
00:00:40,480 --> 00:00:41,770
سـ-سينباي؟

6
00:00:41,770 --> 00:00:44,820
هل لديكِ مشاريع لعشيّة الكريسماس؟

7
00:00:44,820 --> 00:00:45,400
ماذا؟

8
00:00:46,460 --> 00:00:49,570
...عشيّة الكريسماس؟ في الواقع... ليس تماماً

9
00:00:49,570 --> 00:00:52,660
حقّاً؟ ما رأيكِ بالمجيء معي
إلى مدينة الملاهي؟

10
00:00:53,030 --> 00:00:55,510
مـ-مدينة الملاهي؟ معك؟

11
00:00:55,510 --> 00:00:57,170
وفي... عشيّة الكريسماس؟

12
00:00:57,340 --> 00:00:58,620
أجل

13
00:00:58,620 --> 00:01:02,020
حصلتُ على تذاكر للافتتاح الجديد

14
00:01:02,020 --> 00:01:05,640
سمعتُ بأنّ لديهم الكثير من المركبات
والألعاب الجديدة

15
00:01:05,640 --> 00:01:07,060
...حـ-حسناً

16
00:01:07,060 --> 00:01:11,130
،في الواقع، أتمنّى الذّهاب
...إذا لم يكن لديك مانع

17
00:01:11,130 --> 00:01:15,330
فقط، أنا... يا إلهي، لا أعرف
...ماذا يجب أن أقول

18
00:01:15,330 --> 00:01:17,420
!لكن... أجل، سأذهب بكلّ سرور

19
00:01:17,420 --> 00:01:18,540
ممتاز

20
00:01:18,540 --> 00:01:20,390
سأطلعكِ على التّفاصيل لاحقاً إذاً

21
00:01:20,390 --> 00:01:21,870
!حـ-حسناً

22
00:01:23,790 --> 00:01:27,050
رحلة عشيّة كريسماس إلى مدينة
...ملاهٍ رفقة سينباي

23
00:01:27,050 --> 00:01:30,000
!هل هذه مُواعدة؟

24
00:02:55,450 --> 00:02:57,250
!إنّها أجمل حتّى من السّابق

25
00:02:57,250 --> 00:02:58,950
!بالفعل

26
00:02:58,950 --> 00:03:00,810
أحضر هونوكا وكيماتا-سان أيضاً

27
00:03:00,810 --> 00:03:03,590
توقّعت. مُحال أن يذهب بمفرده معي

28
00:03:03,830 --> 00:03:05,060
ما الأمر؟

29
00:03:06,230 --> 00:03:07,530
!لا شيء

30
00:03:11,070 --> 00:03:12,530
!أضافوا حلبة تزلُّج أيضاً

31
00:03:12,940 --> 00:03:14,400
ما رأيكم بالتزلّج معاً؟

32
00:03:14,400 --> 00:03:15,450
!أجل

33
00:03:18,370 --> 00:03:19,800
تزلُّج؟

34
00:03:22,950 --> 00:03:27,000
!عاشقان على الجليد؟
!أزمة تعثُّر وسقوط

35
00:03:31,090 --> 00:03:33,220
!أنا ماهر في الرّياضات الشّتائيّة

36
00:03:33,220 --> 00:03:34,650
!أحسنت صنعاً يا كيماتا! لكن أنا أسرع

37
00:03:37,430 --> 00:03:39,820
!هونوكا. لا تتركيني

38
00:03:42,130 --> 00:03:45,020
آسفة لأنّ الأمر انتهى هكذا يا ناغيسا

39
00:03:45,020 --> 00:03:48,500
أنا سيّئة في الرّياضات الشّتائيّة فحسب

40
00:03:50,640 --> 00:03:52,420
!تماسكي

41
00:03:52,420 --> 00:03:56,960
!لا تقلقي. ستتزلّجين كالمحترفين قريباً

42
00:03:56,960 --> 00:03:58,960
وكأنّها ليست مشكلتكِ، صحيح؟

43
00:03:58,960 --> 00:04:02,370
أنتِ ميسومي ناغيسا، قائدة فريق
اللّاكروس، أليس كذلك؟

44
00:04:02,850 --> 00:04:04,480
!أ-أجل. هذا صحيح

45
00:04:04,850 --> 00:04:07,370
كلّ ما عليّ هو وضع قدم أمام
الأخرى، أليس كذلك؟

46
00:04:07,370 --> 00:04:08,870
!أجل

47
00:04:10,330 --> 00:04:14,960
أسترخي ثمّ ببطء، قدم واحدة
...أمام الأخرى

48
00:04:21,700 --> 00:04:23,160
!أنا أتزلّج

49
00:04:23,160 --> 00:04:25,170
!فعلتُها! فعلتُها! انظري

50
00:04:42,700 --> 00:04:43,420
!ناغيسا

51
00:04:46,620 --> 00:04:47,820
!ابتعدوا

52
00:04:56,240 --> 00:04:58,390
هل أنتِ بخير يا ميسومي-سان؟

53
00:04:59,010 --> 00:05:00,070
!سينباي

54
00:05:00,070 --> 00:05:01,160
كان ذلك وشيكاً، صحيح؟

55
00:05:01,160 --> 00:05:02,340
!آ-آسفة

56
00:05:13,360 --> 00:05:16,950
لندع ميسومي-سان على فوجيبي
ونتزلّج معاً

57
00:05:16,950 --> 00:05:17,890
!حسناً

58
00:05:18,160 --> 00:05:21,080
لستُ ماهراً في هذا أيضاً

59
00:05:21,080 --> 00:05:23,220
لكن أعتقد يمكنني تعليمكِ الأساسيّات

60
00:05:24,630 --> 00:05:25,930
!حقّاً؟

61
00:05:37,440 --> 00:05:38,670
!ا-احذري

62
00:05:45,350 --> 00:05:47,780
!هيكاري! كان ذلك وشيكاً، بوبّو

63
00:05:47,960 --> 00:05:49,540
...صوت

64
00:05:49,540 --> 00:05:51,250
سمعتُ صوتاً

65
00:05:52,790 --> 00:05:54,720
صوت، بوبّو؟

66
00:05:54,720 --> 00:05:56,920
لم أسمع شيئاً، لولو

67
00:05:57,270 --> 00:05:59,890
...لكن أنا متأكّدة بأنّني شعرت

68
00:06:03,430 --> 00:06:06,260
ما الأمر، زاكينّا؟

69
00:06:06,900 --> 00:06:09,370
انتباه من ماذا، زاكينّا؟

70
00:06:11,150 --> 00:06:12,670
لا... لا شيء

71
00:06:13,080 --> 00:06:16,500
!بدأتِ تتعلّمين ذلك بسرعة يا ميسومي-سان

72
00:06:16,500 --> 00:06:18,940
...لـ-لا، أنا لستُ

73
00:06:19,250 --> 00:06:21,910
!نبضات قلبي تتسارع

74
00:06:25,030 --> 00:06:27,350
!نحن نتزلّج ونُمسِك أيدي بعضنا

75
00:06:27,350 --> 00:06:31,050
!هل يعتقد النّاس بأنّنا حبيبان؟

76
00:06:31,050 --> 00:06:32,860
!هذا لا يُصدَّق

77
00:06:37,210 --> 00:06:38,890
هل أنتِ بخير؟

78
00:06:41,740 --> 00:06:44,270
!هونوكا-تشان! انظري هناك

79
00:06:46,650 --> 00:06:47,800
ناغيسا؟

80
00:06:47,800 --> 00:06:50,680
!بدأت ميسومي تعتاد على ذلك

81
00:06:50,680 --> 00:06:51,440
!بالفعل

82
00:06:54,220 --> 00:06:56,150
...في الواقع، كنتُ أقول لنفسي

83
00:06:56,150 --> 00:06:57,080
نعم؟

84
00:06:57,080 --> 00:06:59,020
أنتِ مذهلة حقّاً

85
00:06:59,020 --> 00:07:00,890
أ-أنا كذلك؟

86
00:07:00,890 --> 00:07:03,290
!أجل، مذهلة بالفعل

87
00:07:04,200 --> 00:07:05,850
!فعلاً

88
00:07:05,850 --> 00:07:09,090
ماذا أفعل؟ هل هذا اعتراف بالحُبّ؟

89
00:07:09,090 --> 00:07:10,430
!هذا لا يُصدَّق

90
00:07:10,970 --> 00:07:14,800
أحبّ طريقتكِ في الانخراط في كلّ شيء

91
00:07:16,040 --> 00:07:19,300
أنا مذهول دوماً بمدى صدقك

92
00:07:20,320 --> 00:07:21,730
هكذا إذاً

93
00:07:21,730 --> 00:07:23,170
أجل، هذا منطقيّ

94
00:07:25,790 --> 00:07:28,480
ليتني أستطيع أن أكون مثلكِ

95
00:07:28,480 --> 00:07:30,010
...لـ-لا

96
00:07:30,010 --> 00:07:32,610
أنا بائسة تماماً في الواقع

97
00:07:32,610 --> 00:07:34,180
...أُسيئ فهم الأمور

98
00:07:35,400 --> 00:07:37,650
!أ-أقصد... لا شيء

99
00:07:37,650 --> 00:07:39,790
!تبدو جيّدة

100
00:07:40,300 --> 00:07:42,090
!شارفت على الانتهاء

101
00:07:42,340 --> 00:07:45,290
!وصل الكريسماس إلى مقهى تاكو

102
00:07:47,080 --> 00:07:49,530
!أشعر بذلك، بوبّو! أشعر بشيء، بوبّو

103
00:08:00,060 --> 00:08:01,510
ما الأمر؟

104
00:08:05,360 --> 00:08:06,820
لومينوس اللّامِعة

105
00:08:15,900 --> 00:08:18,530
ما الأمر؟ ماذا حدث؟

106
00:08:18,530 --> 00:08:21,360
!لا يروقني هذا، بوبّو. أنا خائف، بوبّو

107
00:08:21,360 --> 00:08:23,560
أنا خائفة أيضاً، لولو

108
00:08:23,850 --> 00:08:26,030
ما الّذي يجري هنا؟

109
00:08:26,030 --> 00:08:28,070
!هيكاري! هذا ليس آمناً، بوبّو

110
00:08:28,070 --> 00:08:30,740
!عليك إيجاد ناغيسا وهونوكا، بوبّو

111
00:08:37,630 --> 00:08:41,850
!رغم ذلك، قال سينباي بأنّني مذهلة

112
00:08:41,850 --> 00:08:45,050
لا أعتقد بأنّه قصد ذلك مثلما
،نظرتُ للأمر أوّل مرّة

113
00:08:45,050 --> 00:08:48,970
لكن هذا يُثبت بأنّه يهتمّ لأمري، صحيح؟

114
00:08:49,490 --> 00:08:53,860
!وكانت الأجواء بيننا لطيفة قبل قليل

115
00:08:54,640 --> 00:08:58,960
!على هذا المُعدّل... قد أفصح له عن مشاعري

116
00:08:58,960 --> 00:09:00,870
!قد تسير الأمور على ما يُرام

117
00:09:00,870 --> 00:09:03,570
لكن ماذا لو لم يكن يُبادلني نفس المشاعر؟

118
00:09:04,550 --> 00:09:07,040
!لا أستطيع فعلها! لستُ شُجاعة بما يكفي

119
00:09:07,040 --> 00:09:10,640
ناغيسا. ليتكِ كنتِ بهذه
!الجدّية في دراستكِ

120
00:09:10,640 --> 00:09:13,010
!قد يُحسّن هذا درجاتكِ، ميبّو

121
00:09:13,200 --> 00:09:15,500
اسمع، تراودني أفكار حسّاسة هنا

122
00:09:15,500 --> 00:09:16,980
لا تتكلّم معي، مفهوم؟

123
00:09:17,430 --> 00:09:18,650
!تفضّلي

124
00:09:18,650 --> 00:09:20,450
ناغيسا، هل تستمتعين؟

125
00:09:20,450 --> 00:09:22,590
!أ-أجل! بالطّبع

126
00:09:22,590 --> 00:09:24,990
هل يدور شيء في ذهنكِ؟

127
00:09:24,990 --> 00:09:27,090
!كـ-كلّا

128
00:09:27,090 --> 00:09:28,960
!شكراً على الآيس كريم

129
00:09:32,480 --> 00:09:33,970
أنا لوفلون

130
00:09:33,970 --> 00:09:37,000
!أذهب إلى أيّ مكان فيه قلب مُحبّ

131
00:09:37,190 --> 00:09:38,470
لوفلون؟

132
00:09:38,920 --> 00:09:41,940
"!أريد أن أفصح له عن مشاعري"

133
00:09:42,960 --> 00:09:45,140
من أين أتيتِ بذلك؟

134
00:09:45,530 --> 00:09:48,450
لكن من الصّعب معرفة ماذا أقول"

135
00:09:48,450 --> 00:09:51,620
"!فقلبي العُذريّ يفيض بعواطف مُتناقضة

136
00:09:51,800 --> 00:09:54,820
لوفلون صريحة في هذه الأمور

137
00:09:54,820 --> 00:09:56,820
!مهلاً، الأمر ليس كذلك

138
00:09:57,170 --> 00:10:00,780
لا مُشكلة. لديكِ دربكِ الخاصّ لسلوكه

139
00:10:00,780 --> 00:10:01,990
أنا؟

140
00:10:02,340 --> 00:10:06,470
!اتبعي مشاعركِ بصدق فحسب

141
00:10:24,570 --> 00:10:26,380
أتريدون ركب التّالية؟

142
00:10:26,570 --> 00:10:28,590
!عجلة فيريس؟ إنّها ممتعة

143
00:10:33,910 --> 00:10:35,530
ماذا؟ ماذا عن الآخرَين؟

144
00:10:35,530 --> 00:10:37,860
!ارتأينا أن نفعلها بشكل ثنائيّات

145
00:10:45,890 --> 00:10:47,370
...هونوكا

146
00:10:55,560 --> 00:10:56,980
!يا لها من إطلالة رائعة

147
00:10:57,330 --> 00:11:00,420
ماذا أفعل؟ ماذا يجدر بي أن أقول؟

148
00:11:00,420 --> 00:11:03,690
!منحَتْني هونوكا فُرصتي، وأنا أُفسدها

149
00:11:03,690 --> 00:11:06,490
أليست شجرة الكريسماس جميلة من الأعلى؟

150
00:11:15,320 --> 00:11:19,940
قضينا الكريسماس الماضي ننظر
إلى الشّجرة معاً أيضاً

151
00:11:19,940 --> 00:11:22,670
أتّبع مشاعري بصدق؟

152
00:11:22,670 --> 00:11:24,580
ميسومي-سان؟ ما الأمر؟

153
00:11:24,580 --> 00:11:26,610
!لـ-لا، لا شيء

154
00:11:26,610 --> 00:11:28,080
حقّاً؟

155
00:11:35,900 --> 00:11:37,820
نور وظلام

156
00:11:38,340 --> 00:11:41,860
...يناديان بعضهما الآخر، يُحفِّزان بعضهما

157
00:11:41,860 --> 00:11:46,130
ومع الوقت، الظّلام سيلتهم النُّور

158
00:11:46,130 --> 00:11:47,830
هذا هو القدر

159
00:11:53,800 --> 00:11:56,870
!انظري! يمكن رؤية حلبة التزلُّج أيضاً

160
00:11:57,060 --> 00:11:59,280
ماذا أفعل؟

161
00:11:59,280 --> 00:12:02,080
هل ينبغي... هل ينبغي أن أترك
الأمور تأخذ مجراها؟

162
00:12:08,640 --> 00:12:10,590
...ا-المعذرة، سينباي

163
00:12:10,590 --> 00:12:11,850
نعم؟

164
00:12:11,850 --> 00:12:15,660
هل من المهمّ إتِّباع المشاعر؟

165
00:12:16,780 --> 00:12:19,330
هذا ما أعتقده. لماذا تسألين؟

166
00:12:19,330 --> 00:12:21,200
...فـ-في الواقع

167
00:12:21,200 --> 00:12:23,830
...إذاً أريد أن أخبرك بشيء. أنا

168
00:12:23,830 --> 00:12:25,100
...المعذرة

169
00:12:26,300 --> 00:12:27,470
...أنا

170
00:12:28,460 --> 00:12:30,770
!سينباي؟ استيقظ

171
00:12:31,090 --> 00:12:32,840
!فوجيبي-سينباي؟

172
00:12:33,030 --> 00:12:35,110
!أشعر بحضور شرّير، ميبّو

173
00:12:35,300 --> 00:12:37,050
!ماذا؟ ليس ثانية

174
00:12:37,050 --> 00:12:39,780
!لماذا يحدث ذلك في الأوقات الحرِجة دوماً؟

175
00:12:48,620 --> 00:12:49,820
!ناغيسا

176
00:12:58,530 --> 00:13:00,730
!ناغيسا! كوني حذِرة، ميبّو

177
00:13:00,730 --> 00:13:02,600
!هونوكا! تحوّلي، مِيبّو

178
00:13:02,600 --> 00:13:03,640
!هونوكا

179
00:13:03,640 --> 00:13:04,300
أجل

180
00:13:11,330 --> 00:13:13,440
!موجة الشّفق الثنائيّة

181
00:13:23,620 --> 00:13:26,260
!مبعوثة النُّور، كيور بلاك

182
00:13:26,420 --> 00:13:29,260
!مبعوثة النُّور، كيور وايت

183
00:13:31,420 --> 00:13:33,200
!سوية، نحن بريكيور

184
00:13:34,560 --> 00:13:36,770
...يا خدم قوّة الظّلام

185
00:13:37,730 --> 00:13:40,070
!عودوا من حيث أتيتم

186
00:14:12,740 --> 00:14:14,600
!بلاك! وايت

187
00:14:15,160 --> 00:14:16,370
هيكاري؟

188
00:14:15,160 --> 00:14:16,370
هيكاري-سان؟

189
00:14:38,530 --> 00:14:40,760
!هيكاري! تحوّلي، بوبّو

190
00:14:44,590 --> 00:14:46,000
!لومينوس

191
00:14:46,300 --> 00:14:48,610
!السّيل اللّامِع

192
00:14:57,770 --> 00:15:00,310
!شرارة الحياة، لومينوس اللّامِعة

193
00:15:02,210 --> 00:15:04,620
!قلب النُّور وإرادة النُّور

194
00:15:04,950 --> 00:15:07,150
!لتوحيدهم جميعاً

195
00:15:20,260 --> 00:15:24,920
كيف تؤثّر قوّتكِ على نموّه؟

196
00:15:24,920 --> 00:15:26,370
!أخبريني

197
00:15:37,780 --> 00:15:40,030
!سأدمِّر بريكيور اليوم

198
00:15:40,030 --> 00:15:43,040
!قد ينتهي المطاف بإسقاطكِ معهما أيضاً

199
00:15:43,040 --> 00:15:44,220
!لذا حريّ بكِ أن تكوني مستعدّة

200
00:15:46,060 --> 00:15:47,460
!لومينوس

201
00:15:48,260 --> 00:15:50,400
!لا تقسُ على لومينوس، لولو

202
00:15:53,070 --> 00:15:54,130
!لولون

203
00:15:54,600 --> 00:15:55,840
!ذُبابة مزعجة

204
00:15:56,970 --> 00:15:58,440
!دع لولون

205
00:15:58,870 --> 00:16:01,550
!ربّما سأسحقها فحسب

206
00:16:02,870 --> 00:16:06,410
!ما رأيكن؟ أنا قويّ، أليس كذلك؟

207
00:16:06,410 --> 00:16:07,680
!توقّف

208
00:16:12,720 --> 00:16:14,420
!لولون

209
00:16:23,690 --> 00:16:26,980
!النُّور سيُضيء المستقبل، لولو

210
00:17:06,500 --> 00:17:07,800
...هل هذا

211
00:17:12,740 --> 00:17:14,510
ماذا حدث للتو؟

212
00:17:14,710 --> 00:17:16,760
موجة الظّلام

213
00:17:16,760 --> 00:17:18,980
بدأت قوّتُه تكشف عن نفسها

214
00:17:19,450 --> 00:17:23,290
!حسناً إذاً! سأكون جادّاً هذه المرّة

215
00:17:23,290 --> 00:17:25,800
!توقّف! ابتعد عن لومينوس

216
00:17:29,740 --> 00:17:32,430
!تمكّنتُ أخيراً من أن أكون لوحدي مع سينباي

217
00:17:32,430 --> 00:17:35,030
سينباي"؟ من هو هذا؟"

218
00:17:36,370 --> 00:17:38,630
!هـ-هذا ليس من شأنك

219
00:17:38,630 --> 00:17:41,700
!إذاً لا تذكري ذلك

220
00:17:41,700 --> 00:17:44,170
!هذا ليس من شأنك، لكنّه خطؤك

221
00:17:44,910 --> 00:17:47,940
!لا أريد سماع المزيد عن ذلك

222
00:17:48,780 --> 00:17:49,680
!وايت

223
00:17:49,680 --> 00:17:50,410
!أجل

224
00:17:51,580 --> 00:17:54,400
املأ عيوننا بالأمل

225
00:17:54,400 --> 00:17:56,250
...ضع قوّة الأمل

226
00:17:56,520 --> 00:17:58,020
!بين أيدينا...

227
00:18:19,440 --> 00:18:21,360
!هيّا يا زاكينّا

228
00:18:24,350 --> 00:18:26,110
!الرّعد الأسود

229
00:18:26,650 --> 00:18:28,450
!الرّعد الأبيض

230
00:18:34,790 --> 00:18:37,820
...روحا بريكيور الجميلتان

231
00:18:38,030 --> 00:18:40,660
!ستقهران القلوبَ الشرّيرة...

232
00:18:41,390 --> 00:18:43,630
...اللّولب الرُّخامي بريكيور

233
00:18:48,670 --> 00:18:50,270
!ماكس

234
00:18:55,680 --> 00:18:58,330
!ردّ اللّولب الرُّخامي

235
00:19:05,490 --> 00:19:06,990
!شرارة

236
00:19:09,760 --> 00:19:10,920
لـ-لا أستطيع فعلها؟

237
00:19:28,640 --> 00:19:30,960
...لكن... تلك الموجة قبل قليل

238
00:19:30,960 --> 00:19:32,240
ماذا حدث؟

239
00:19:41,490 --> 00:19:44,210
هل أنت جائع؟

240
00:19:44,210 --> 00:19:45,980
أظنّني كذلك

241
00:19:45,980 --> 00:19:48,150
سأشتري بعض الياكيسوبا

242
00:19:48,150 --> 00:19:50,680
!سأحضرها أنا

243
00:19:50,680 --> 00:19:52,650
لـ-لكن المسافة بعيدة

244
00:19:52,650 --> 00:19:55,650
أريد أن أشكرك على تدريبي في التزلُّج

245
00:20:01,840 --> 00:20:03,860
من الأفضل أن أرافقها

246
00:20:03,860 --> 00:20:06,730
سيكون من الصّعب حمل
خمس وجبات، صحيح؟

247
00:20:06,730 --> 00:20:08,180
حسناً، سأذهب معك

248
00:20:08,620 --> 00:20:10,150
سأفعلها أنا

249
00:20:10,520 --> 00:20:12,970
انتظروا هنا

250
00:20:12,970 --> 00:20:14,140
...لـ-لكن

251
00:20:14,140 --> 00:20:16,350
لا أريدها أن تتوتّر

252
00:20:18,230 --> 00:20:20,410
لا-لا شيء

253
00:20:20,410 --> 00:20:22,030
!انتظري هنا أيضاً يا هيكاري-سان

254
00:20:22,030 --> 00:20:23,450
!حـ-حسناً

255
00:20:33,140 --> 00:20:35,030
هذا صحيح

256
00:20:35,410 --> 00:20:37,730
دائماً ما يُسبّب تسارع نبضات قلبي

257
00:20:37,730 --> 00:20:41,140
متى كنتُ معه، أتوتّر كثيراً

258
00:20:41,580 --> 00:20:46,670
لكن كان ذلك اليوم مُبهِجاً للغاية

259
00:20:46,670 --> 00:20:51,380
لم أرد الخلود إلى النّوم في تلك اللّيلة

260
00:20:51,380 --> 00:20:54,950
وفي اليوم الموالي، تسارعت
نبضات قلبي أكثر حتّى

261
00:20:55,330 --> 00:20:59,550
...ومن خلال تلك الدّورة، أدركتُ ذلك

262
00:21:00,500 --> 00:21:03,060
...كلّ يوم يبدو جديداً بالنّسبة لي

263
00:21:04,010 --> 00:21:06,930
كلّ هذا لأنّه كان بجانبي

264
00:21:08,340 --> 00:21:10,060
...لذا

265
00:21:10,060 --> 00:21:13,170
...رغم أنّني لم أستطع قولها

266
00:21:13,170 --> 00:21:16,600
...رغم أنّني لم أتمكّن من قولها

267
00:21:16,600 --> 00:21:19,810
...أنا

268
00:21:19,810 --> 00:21:21,760
...فوجيبي-سينباي

269
00:21:21,760 --> 00:21:23,820
!أحبّك

270
00:21:27,530 --> 00:21:29,010
ميسومي-سان؟

271
00:21:29,010 --> 00:21:31,050
هل قالت شيئاً للتو؟

272
00:21:31,050 --> 00:21:32,360
لا أدري

273
00:21:53,090 --> 00:21:54,250
ثلج؟

274
00:21:54,560 --> 00:21:55,720
!ميسومي-سان

275
00:21:55,720 --> 00:21:57,840
هل قلتِ شيئاً وأنتِ في الأعلى؟

276
00:21:58,460 --> 00:21:59,850
...في الواقع

277
00:21:59,850 --> 00:22:02,550
استمتعتُ كثيراً اليوم

278
00:22:02,550 --> 00:22:06,430
أردتُ فقط أن أتمنّى لك
!عيد ميلاد مجيد

279
00:22:07,840 --> 00:22:09,130
عيد ميلاد مجيد

280
00:22:13,240 --> 00:22:15,260
عيد ميلاد مجيد

281
00:23:57,650 --> 00:24:00,140
أنا قلقة حقّاً بشأن تصرُّفات هيكاري-سان

282
00:24:00,140 --> 00:24:04,270
على ذكر الأمر، يبدو أنّ فريق اللّاكروس
!يخفي عنّي شيئاً

283
00:24:04,270 --> 00:24:06,380
!أعتقد نادي العلوم كذلك

284
00:24:06,380 --> 00:24:09,700
لكن هل كانت توجد غيوم داكِنة كهذه
دوماً أثناء استراحة الشّتاء؟

285
00:24:09,700 --> 00:24:10,180
...لحظة

286
00:24:10,180 --> 00:24:11,880
!زاكينّا

287
00:24:11,880 --> 00:24:13,680
:نحن بريكيور ماكس هارت

288
00:24:13,680 --> 00:24:16,520
!استراحة الشّتاء الأخيرة
!درس زاكينّا الخاصّ؟

289
00:24:16,520 --> 00:24:19,520
.لدينا استراحة الرّبيع والصّيف والشّتاء
فلِمَ لا توجد استراحة خريف؟

290
00:24:19,520 --> 00:24:21,290
علاماتكِ ستتساقط حينها كأوراق الخريف

291
00:24:21,290 --> 00:24:22,960
!مُحاولة جيّدة