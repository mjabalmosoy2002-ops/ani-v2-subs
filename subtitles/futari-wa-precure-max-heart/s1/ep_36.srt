1
00:00:27,800 --> 00:00:29,760
أنتما صديقان حميمان حقّاً، أليس كذلك؟

2
00:00:29,760 --> 00:00:32,180
لولون لا تدعني وشأني فحسب، بوبّو

3
00:00:32,180 --> 00:00:34,980
ما زلتِ تعملين، بوبّو؟

4
00:00:34,980 --> 00:00:38,780
آسفة. هل يمكنكما اللّعب معاً
فترة أطول قليلاً؟

5
00:00:40,080 --> 00:00:41,700
!حسناً، إلى اللّقاء

6
00:00:41,700 --> 00:00:43,750
لولون. دعيني أذهب، بوبّو

7
00:00:45,160 --> 00:00:45,980
!لا

8
00:00:45,980 --> 00:00:47,720
!لا تكوني أنانيّة، بوبّو

9
00:00:49,630 --> 00:00:51,290
!انتظر، لولو

10
00:00:51,290 --> 00:00:52,910
!لا، بوبّو

11
00:02:20,420 --> 00:02:21,950
...رحلة الصفّ

12
00:02:23,150 --> 00:02:26,750
كانت جنونيّة، لكنّها كانت مُمتعة للغاية

13
00:02:26,750 --> 00:02:31,220
!يبدو أنّ حدثاً ضخماً آخر قد ولّى

14
00:02:31,930 --> 00:02:35,500
لكن لا أصدّق بأنّ أولئك الأوغاد
!ظهروا حتّى هناك

15
00:02:35,960 --> 00:02:38,500
ما الّذي سيحدث لاحقاً؟

16
00:02:44,070 --> 00:02:45,860
...رغم ذلك

17
00:02:46,480 --> 00:02:49,660
!التّاكوياكي الخاصّة بأكاني-سان لذيذة كالعادة

18
00:02:55,410 --> 00:02:57,380
!يا لها من قيلولة جميلة، ميبّو

19
00:02:57,380 --> 00:02:59,740
!نمتُ بعمق أيضاً، مِيبّو

20
00:02:59,740 --> 00:03:01,350
المعذرة

21
00:03:01,350 --> 00:03:04,090
هل لي بتاكوياكي لشخصين من فضلك؟

22
00:03:07,830 --> 00:03:10,850
!التّاكوياكي في مقهى تاكو شهيّ جدّاً، ميبّو

23
00:03:13,100 --> 00:03:14,550
!تفضّلي

24
00:03:14,550 --> 00:03:17,370
!شكراً على الحضور، ميبّو

25
00:03:20,140 --> 00:03:22,430
حسناً، هيّا بنا

26
00:03:22,430 --> 00:03:24,560
!إلى اللِّقاء

27
00:03:24,560 --> 00:03:26,100
!وداعاً، ميبّو

28
00:03:28,680 --> 00:03:30,280
!كان ذلك وشيكاً

29
00:03:30,280 --> 00:03:33,580
من الصّعب أن نبقى ثابتين، مِيبّو

30
00:03:35,090 --> 00:03:38,110
!ناغيسا! لستُ دُمية، ميبّو

31
00:03:38,110 --> 00:03:39,720
!آسفة، آسفة

32
00:03:39,900 --> 00:03:42,580
!لكن كان ذلك وشيكاً، ميبّو

33
00:03:47,300 --> 00:03:49,760
!لولون! عودي، بوبّو

34
00:03:49,760 --> 00:03:51,840
!لا، لولو

35
00:03:51,840 --> 00:03:54,300
!أريد أن أكون معك، لولو

36
00:03:58,410 --> 00:04:00,100
!أحدهم قادم، بوبّو

37
00:04:05,180 --> 00:04:07,070
!اختبئي بوبّو

38
00:04:11,060 --> 00:04:12,560
!لا تتحرّكي، بوبّو

39
00:04:21,790 --> 00:04:22,970
!ما أظرفهما

40
00:04:24,410 --> 00:04:27,440
هل رماكما أحدٌ ما؟

41
00:04:30,450 --> 00:04:33,240
تعالا معي إلى المنزل، حسناً؟

42
00:04:39,390 --> 00:04:43,010
!دعينا نذهب إلى المنزل
!مُغامرة بولن ولولون الكبيرة

43
00:04:45,290 --> 00:04:47,090
بولن ولولون اختفيا؟

44
00:04:47,090 --> 00:04:52,380
،أجل. كانا يلعبان على هذا المقعد
!لكن لا أستطيع إيجادهما الآن

45
00:04:52,380 --> 00:04:54,060
إلى أين من الممكن أن يكونا قد ذهبا؟

46
00:04:54,300 --> 00:04:56,530
!لا أشعر بهما في أيّ مكان، ميبّو

47
00:04:58,310 --> 00:05:00,970
!لا بدّ أنّهما هربا إلى مكانٍ معاً، مِيبّو

48
00:05:01,280 --> 00:05:02,790
لنتفرّق ونبحث

49
00:05:02,790 --> 00:05:03,790
!حسناً

50
00:05:04,170 --> 00:05:07,140
كنتُما تشعران بالوحدة، صحيح؟
!لكنّكما بأمان الآن

51
00:05:07,480 --> 00:05:10,500
!يمكنكما العيش في منزلي الآن

52
00:05:10,500 --> 00:05:12,770
!سنصل إلى هناك قريباً

53
00:05:13,660 --> 00:05:15,070
...لولون

54
00:05:15,760 --> 00:05:17,240
لا تتحرّكي، بوبّو

55
00:05:17,240 --> 00:05:19,320
لا تتكلّمي بصوتٍ عالٍ، بوبّو

56
00:05:19,320 --> 00:05:20,050
لِمَ لا؟

57
00:05:20,360 --> 00:05:24,890
لأنّكِ إذا تحرّكتِ، فلن ألعب
!معكِ ثانية، بوبّو

58
00:05:29,760 --> 00:05:31,420
!لـ-لا تبكي، بوبّو

59
00:05:31,420 --> 00:05:33,900
!إذا بقيتِ ثابتة، سألعب معكِ، بوبّو

60
00:05:40,720 --> 00:05:42,770
فتاة مُهذّبة

61
00:05:42,770 --> 00:05:44,640
!ابقي لطيفة ولا تتحرّكي

62
00:05:44,640 --> 00:05:47,440
سينتهي الأمر قريباً

63
00:05:47,440 --> 00:05:51,580
...تفريش، تفريش

64
00:05:51,860 --> 00:05:54,050
!لولون... تحمّلي، بوبّو

65
00:05:54,230 --> 00:05:57,350
!حسناً، صرتِ نظيفة تماماً

66
00:05:59,430 --> 00:06:01,290
!تراجعي، بوبّو

67
00:06:04,770 --> 00:06:06,230
ماذا؟

68
00:06:06,580 --> 00:06:08,430
هل تركتُها هنا؟

69
00:06:11,480 --> 00:06:15,270
نوزومي-تشان، اتّصل أبوكِ للتو

70
00:06:15,270 --> 00:06:15,610
ماذا؟

71
00:06:15,950 --> 00:06:19,670
،انتهت رحلته الخاصّة بالعمل باكراً
!وهو عائد إلى المنزل اليوم

72
00:06:19,670 --> 00:06:21,740
!بابا عائد إلى المنزل؟

73
00:06:21,740 --> 00:06:24,240
!لنذهب ونقابله معاً

74
00:06:25,190 --> 00:06:26,490
لن أذهب

75
00:06:26,860 --> 00:06:27,950
لِمَ لا؟

76
00:06:27,950 --> 00:06:29,450
!لا أريد

77
00:06:29,450 --> 00:06:31,420
نوزومي-تشان؟

78
00:06:31,420 --> 00:06:32,980
هذا غريب

79
00:06:32,980 --> 00:06:36,390
...بدتْ مُتحمِّسة لرؤيته من جديد

80
00:06:47,320 --> 00:06:49,430
أنا قلق على هيكاري، بوبّو

81
00:06:49,430 --> 00:06:51,470
!علينا العودة بسرعة، بوبّو

82
00:06:52,280 --> 00:06:54,840
ميمي؟ أهذه أنتِ؟

83
00:07:08,640 --> 00:07:11,790
!ميمي! كوني لطيفة

84
00:07:12,530 --> 00:07:15,300
كوني صديقتيهما، حسناً؟

85
00:07:29,990 --> 00:07:30,850
هل من جديد؟

86
00:07:30,850 --> 00:07:31,540
!أبداً

87
00:07:31,540 --> 00:07:32,850
!لم نعثر عليهما

88
00:07:33,200 --> 00:07:35,820
من المُؤكّد أنّهما يشعران بالوحدة

89
00:07:36,130 --> 00:07:37,420
أجل، مِيبّو

90
00:07:37,420 --> 00:07:43,260
لا نشعر بالأمان إلّا عندما نكون
مع فتياتنا، مِيبّو

91
00:07:43,260 --> 00:07:46,360
لعلّهما خائفان جدّاً، ميبّو

92
00:07:46,360 --> 00:07:47,730
!يجب أن نجدهما، ميبّو

93
00:07:47,730 --> 00:07:50,060
!بسرعة

94
00:07:50,950 --> 00:07:53,540
بابا، ماذا تريد أن تلعب اليوم؟

95
00:07:54,020 --> 00:07:55,840
!لنذهب في جولة سيّارة

96
00:07:55,840 --> 00:07:56,510
!مرحى

97
00:07:57,320 --> 00:07:59,480
!جولة سيّارة، جولة سيّارة

98
00:07:59,960 --> 00:08:01,640
إلى أين يجدر بنا الذّهاب؟

99
00:08:01,640 --> 00:08:03,150
!الشّاطئ

100
00:08:03,150 --> 00:08:06,260
!حقّاً؟ هيّا بنا

101
00:08:06,260 --> 00:08:09,850
!هيّا بنا! أجل! أجل

102
00:08:33,160 --> 00:08:36,240
لكن ماذا عن سيّارة بابا الثّمينة؟

103
00:08:42,430 --> 00:08:44,120
إلى أين ذهبا؟

104
00:08:44,120 --> 00:08:45,880
!خذي الأمور برويّة

105
00:08:45,880 --> 00:08:49,490
!بروزين! هذا ليس وقت الأكل

106
00:08:49,490 --> 00:08:53,330
،عندما يكون المرء على عجلةٍ من أمره
!فهذا هو أفضل وقت للحِفاظ على هدوئه

107
00:08:58,550 --> 00:09:00,500
!ها هما

108
00:09:01,580 --> 00:09:03,470
!تروّي

109
00:09:04,750 --> 00:09:05,940
ماذا أفعل؟

110
00:09:09,560 --> 00:09:11,440
!ميمي، لا! توقّفي

111
00:09:11,440 --> 00:09:15,880
!أعيدي إطار سيّارة بابا

112
00:09:17,400 --> 00:09:18,650
!بولن! لولون

113
00:09:18,650 --> 00:09:20,520
!الآن فرصتكما! اهربا

114
00:09:20,770 --> 00:09:22,620
!حسناً، بوبّو

115
00:09:23,110 --> 00:09:24,860
!هيّا بنا، بوبّو

116
00:09:25,210 --> 00:09:26,230
لولون؟

117
00:09:26,230 --> 00:09:28,030
لن أذهب، لولون

118
00:09:28,240 --> 00:09:30,330
سوف أبقى هنا، لولو

119
00:09:30,330 --> 00:09:33,630
!لكنّها ستعود قريباً

120
00:09:34,300 --> 00:09:36,570
أنا قلق بشأن هيكاري، بوبّو

121
00:09:36,570 --> 00:09:38,270
!يجب علينا العودة، بوبّو

122
00:09:39,820 --> 00:09:42,240
!حالما نعود، يمكننا اللّعب، بوبّو

123
00:09:42,240 --> 00:09:44,560
تريدين اللّعب، بوبّو؟

124
00:09:44,560 --> 00:09:46,710
...أريد اللّعب، لولو

125
00:09:46,710 --> 00:09:48,310
لكن لن أذهب

126
00:09:48,310 --> 00:09:51,720
!فتاة مسكينة، لولو! فتاة مسكينة، لولو

127
00:09:54,570 --> 00:09:57,160
لولون... أنتِ قلقة على تلك الفتاة، بوبّو؟

128
00:10:00,280 --> 00:10:02,360
كانت تلك الفتاة تبكي، بوبّو

129
00:10:02,360 --> 00:10:04,160
أنا قلق أيضاً، بوبّو

130
00:10:04,160 --> 00:10:04,980
قلق؟

131
00:10:04,980 --> 00:10:05,960
...هكذا إذاً

132
00:10:05,960 --> 00:10:07,470
لن أذهب، بوبّو

133
00:10:09,790 --> 00:10:12,600
!لولون! سأبقى معكِ، بوبّو

134
00:10:31,610 --> 00:10:32,820
لا تتحرّكي، بوبّو

135
00:10:33,140 --> 00:10:34,790
!لا تتحرّكي، بوبّو

136
00:10:38,980 --> 00:10:41,370
!الجميع قلقون

137
00:10:41,370 --> 00:10:43,530
!علينا إعادتكما بسرعة

138
00:10:45,670 --> 00:10:47,740
!ستعود

139
00:10:49,890 --> 00:10:51,410
ماذا؟

140
00:10:52,160 --> 00:10:55,580
..لم أترك السيّارة على السّرير

141
00:10:56,850 --> 00:10:58,850
...هذا غريب

142
00:10:58,850 --> 00:11:00,320
!نوزومي-تشان

143
00:11:00,320 --> 00:11:04,150
!تلقّيتُ مُكالمة للتو! أبوكِ عند المحطّة تقريباً

144
00:11:04,150 --> 00:11:06,920
!علينا الذّهاب لاستقباله! استعدّي

145
00:11:06,920 --> 00:11:08,620
ماذا أفعل؟

146
00:11:16,850 --> 00:11:19,570
ماذا؟ كانا في هذا المنزل قبل قليل؟

147
00:11:19,570 --> 00:11:20,470
!أجل

148
00:11:20,470 --> 00:11:21,420
إلى أين ذهبا؟

149
00:11:21,420 --> 00:11:22,970
!لا أدري

150
00:11:23,360 --> 00:11:25,610
!يُراودني إحساس سيّئ حيال هذا، ميبّو

151
00:11:25,610 --> 00:11:26,910
!يجب علينا إيجادهما، ميبّو

152
00:11:26,910 --> 00:11:28,170
!بسرعة

153
00:11:29,800 --> 00:11:31,550
...بولن... لولون

154
00:11:35,770 --> 00:11:37,140
...بابا

155
00:11:50,450 --> 00:11:52,300
هيّا، بوبّو

156
00:12:03,700 --> 00:12:04,920
نوزومي؟

157
00:12:06,100 --> 00:12:07,490
!نوزومي

158
00:12:08,870 --> 00:12:10,590
!تشجّعي، بوبّو

159
00:12:11,270 --> 00:12:12,660
من هناك؟

160
00:12:14,840 --> 00:12:17,630
أنتِ تحبّين أباكِ، بوبّو

161
00:12:17,630 --> 00:12:20,700
!أبوكِ يحبّكِ أيضاً، بوبّو

162
00:12:21,820 --> 00:12:25,640
لن تتمكّني من رؤيته أبداً إذا
بقيتِ هنا، بوبّو

163
00:12:25,640 --> 00:12:26,370
...لكن

164
00:12:26,370 --> 00:12:28,570
!لن تريه أبداً، بوبّو

165
00:12:28,570 --> 00:12:29,240
!لا

166
00:12:29,430 --> 00:12:30,940
!كوني شُجاعة، بوبّو

167
00:12:30,940 --> 00:12:32,210
!ابقي قويّة، بوبّو

168
00:12:39,100 --> 00:12:40,710
!ابقي قويّة، لولو

169
00:12:49,580 --> 00:12:50,930
نوزومي

170
00:12:51,850 --> 00:12:53,700
!ابقي قويّة، بوبّو

171
00:12:55,050 --> 00:12:57,140
!ابقي قويّة، لولو

172
00:13:00,920 --> 00:13:03,240
...أعتقد بأنّهما هنا

173
00:13:03,240 --> 00:13:04,400
!إنّهما قريبتان

174
00:13:04,730 --> 00:13:06,380
...الحضور الّذي أحسستُ به

175
00:13:06,380 --> 00:13:07,420
!أنتما

176
00:13:11,030 --> 00:13:13,780
حقيقة وجودكما هنا تُشير

177
00:13:13,780 --> 00:13:15,550
إلى أنّهما قريبان

178
00:13:34,800 --> 00:13:38,080
أنتما! أين بريكيور؟

179
00:13:38,740 --> 00:13:40,010
...إن لم تخبراني

180
00:13:40,010 --> 00:13:42,040
!توقّفي مكانكِ

181
00:13:45,030 --> 00:13:46,650
!هيكاري

182
00:13:47,440 --> 00:13:48,910
!أنتِ ثانية؟

183
00:13:48,910 --> 00:13:50,520
توقّعتُ أن تأتيا إلى هنا

184
00:13:50,520 --> 00:13:52,760
سأسحقكن جميعاً معاً

185
00:13:54,180 --> 00:13:55,660
!زاكينّا

186
00:14:15,930 --> 00:14:17,670
!تحوّلي بسرعة، ميبّو

187
00:14:26,140 --> 00:14:28,320
!موجة الشّفق الثنائيّة

188
00:14:40,160 --> 00:14:42,800
!مبعوثة النُّور، كيور بلاك

189
00:14:43,470 --> 00:14:46,270
!مبعوثة النُّور، كيور وايت

190
00:14:48,430 --> 00:14:50,200
!سوية، نحن بريكيور

191
00:14:51,700 --> 00:14:53,780
...يا خدم قوّة الظّلام

192
00:14:54,740 --> 00:14:57,080
!عودوا من حيث أتيتم

193
00:15:04,090 --> 00:15:06,850
!لن نخسر أبداً أمام قوّة الظّلام

194
00:15:16,160 --> 00:15:19,800
ما الّذي تحاولين فعله له؟

195
00:15:35,810 --> 00:15:37,730
!عليّ حمايتها، لولو

196
00:15:37,730 --> 00:15:39,050
هل من أحد آخر هنا؟

197
00:15:39,250 --> 00:15:41,250
!إنّها نوزومي، بوبّو

198
00:15:41,250 --> 00:15:43,060
!إنّها في الدّاخل، بوبّو

199
00:15:46,690 --> 00:15:47,890
!هيكاري

200
00:15:51,330 --> 00:15:52,730
!لومينوس

201
00:15:53,000 --> 00:15:55,380
!السّيل اللّامِع

202
00:16:14,980 --> 00:16:17,290
!شرارة الحياة، لومينوس اللّامِعة

203
00:16:19,190 --> 00:16:21,590
!قلب النُّور وإرادة النُّور

204
00:16:21,990 --> 00:16:24,130
!لتوحيدهم جميعاً

205
00:16:51,420 --> 00:16:54,470
!النُّور سيُضيء المُستقبل، لولو

206
00:17:05,040 --> 00:17:06,000
!ماذا؟

207
00:17:12,510 --> 00:17:14,730
املأ عيوننا بالأمل

208
00:17:15,480 --> 00:17:18,210
!ضع قوّة الأمل بين أيدينا

209
00:17:49,210 --> 00:17:52,800
!ماذا تفعل؟ اسحقهن

210
00:17:55,080 --> 00:17:56,180
وايت؟

211
00:17:56,180 --> 00:17:56,890
!أجل

212
00:17:58,050 --> 00:17:59,790
!الرّعد الأسود

213
00:18:00,160 --> 00:18:02,120
!الرّعد الأبيض

214
00:18:08,060 --> 00:18:11,100
...روحا بريكيور الجميلتان

215
00:18:11,370 --> 00:18:13,940
!ستقهران القلوبَ الشرّيرة...

216
00:18:14,670 --> 00:18:16,900
...اللّولب الرُّخامي بريكيور

217
00:18:21,940 --> 00:18:23,540
!ماكس

218
00:18:29,180 --> 00:18:30,450
...هذه المرّة

219
00:18:30,450 --> 00:18:32,240
!سوف أوقفها

220
00:18:40,700 --> 00:18:42,300
!شرارة

221
00:19:02,650 --> 00:19:04,000
!نوزومي

222
00:19:04,000 --> 00:19:06,200
أنتِ بأمان الآن، بوبّو

223
00:19:08,620 --> 00:19:10,410
...هذه الأصوات

224
00:19:11,390 --> 00:19:13,400
هل كنتُما أنتما؟

225
00:19:13,400 --> 00:19:15,010
!ألم يكن كذلك؟

226
00:19:23,440 --> 00:19:24,770
!نوزومي-تشان

227
00:19:24,770 --> 00:19:25,990
!نوزومي

228
00:19:26,580 --> 00:19:28,490
!كنّا قلقين عليكِ

229
00:19:28,490 --> 00:19:30,310
ما الّذي يجري يا نوزومي؟

230
00:19:30,680 --> 00:19:32,430
!كوني شُجاعة، بوبّو

231
00:19:32,430 --> 00:19:33,800
!ابقي قويّة، بوبّو

232
00:19:33,800 --> 00:19:37,100
!ابقي قويّة، لولو
!ابقي قويّة، لولو

233
00:19:38,280 --> 00:19:39,810
...بابا

234
00:19:42,590 --> 00:19:44,610
أنا آسفة

235
00:19:44,930 --> 00:19:48,160
...كسرتُ سيّارتك. أنا آسفة

236
00:19:48,830 --> 00:19:50,350
عزيزي

237
00:19:54,170 --> 00:19:56,620
شكراً على إخباري

238
00:19:56,620 --> 00:19:58,070
كانت تلك شَجاعة يا نوزومي

239
00:19:59,410 --> 00:20:01,040
لستَ غاضباً؟

240
00:20:01,910 --> 00:20:04,360
يمكنني دوماً صنع سيّارة جديدة

241
00:20:04,810 --> 00:20:08,300
لكنّكِ الأثمن في حياتي

242
00:20:08,300 --> 00:20:10,800
لذا لا تذهبي بعيداً ثانية، مفهوم؟

243
00:20:10,800 --> 00:20:12,000
...بابا

244
00:20:12,000 --> 00:20:12,850
مفهوم؟

245
00:20:12,850 --> 00:20:13,640
!مفهوم

246
00:20:13,640 --> 00:20:15,020
!أحبّك، بابا

247
00:20:18,610 --> 00:20:19,390
!مهلاً

248
00:20:19,760 --> 00:20:22,080
هل اشتريتِ حيوانات محشوّة جديدة؟

249
00:20:22,080 --> 00:20:24,280
...لا، كانا

250
00:20:24,280 --> 00:20:26,930
!إنّهما لنا

251
00:20:29,170 --> 00:20:30,920
انظري. إنّهما مُتطابِقان

252
00:20:30,920 --> 00:20:33,490
!كنّا نبحث عنهما في كلّ مكان

253
00:20:33,490 --> 00:20:36,400
!هل كنتِ تعتنين بهما؟ شكراً لكِ

254
00:20:44,250 --> 00:20:47,970
هلّا أعدتِ لي صديقَي العزيزين؟

255
00:20:58,800 --> 00:20:59,800
تفضّلي

256
00:20:59,800 --> 00:21:01,090
شكراً لكِ

257
00:21:01,840 --> 00:21:03,870
هيّا يا نوزومي. لنعُد إلى المنزل

258
00:21:03,870 --> 00:21:04,700
...حسناً

259
00:21:15,720 --> 00:21:19,180
!وداعاً

260
00:21:25,660 --> 00:21:27,780
،يسرّني أنّ ذلك قد أفلح

261
00:21:27,780 --> 00:21:30,320
لكن ماذا لو كُشِف أمركما، ميبّو؟

262
00:21:30,600 --> 00:21:34,450
!لا تبتعدا هكذا ثانية، مِيبّو

263
00:21:35,800 --> 00:21:38,720
،لكن بفضل جهدهما الحثيث

264
00:21:38,720 --> 00:21:40,790
!استعادتْ تلك الفتاة ابتسامتها

265
00:21:40,790 --> 00:21:43,100
!أجل! استمرّا في العمل بجدّ

266
00:21:43,480 --> 00:21:45,730
!عملتُ بجدّ، بوبّو

267
00:21:45,730 --> 00:21:48,730
!عملتُ بجدّ مع بولن، لولو

268
00:21:51,750 --> 00:21:54,550
من المهمّ الاهتمام بالآخرين، صحيح؟

269
00:21:54,730 --> 00:21:58,380
إذا استمررن في إيجاد أصدقاء
،جدُد بهذه الطّريقة

270
00:21:58,380 --> 00:22:01,280
فسيغدو العالم مكاناً مُزدهراً جدّاً

271
00:22:01,280 --> 00:22:02,560
!يراودني نفس الشُّعور

272
00:22:02,560 --> 00:22:05,220
حسناً، حريّ بي أن أدخل إلى التشيريكت

273
00:22:05,220 --> 00:22:06,420
هذا صحيح

274
00:23:57,400 --> 00:24:00,170
!أوشيواكامارو، اترك سيفك

275
00:24:00,170 --> 00:24:02,030
!إذا أردته، خُذه

276
00:24:02,030 --> 00:24:03,540
...خذ هذه

277
00:24:04,190 --> 00:24:05,610
هل أنتِ بخير يا ناغيسا؟

278
00:24:05,610 --> 00:24:07,680
...أسبِّب مُشكلة للجميع ثانية

279
00:24:07,680 --> 00:24:10,140
!لكن لباس التّينغو ذاك واقعيّ

280
00:24:10,140 --> 00:24:11,250
...يجب أن أضاعف جهودي

281
00:24:11,250 --> 00:24:13,300
!لحظة، زاكينّا

282
00:24:13,300 --> 00:24:14,820
:نحن بريكيور ماكس هارت

283
00:24:18,670 --> 00:24:20,520
—لكن النّجم الحقيقيّ هو السّلك

284
00:24:20,520 --> 00:24:20,940
!أتشو...

285
00:24:20,940 --> 00:24:21,920
!لا، بدأ التّصوير

286
00:24:21,920 --> 00:24:22,760
!تطلّعوا قُدماً لذلك