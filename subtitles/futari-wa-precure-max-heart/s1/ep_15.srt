1
00:00:18,130 --> 00:00:19,850
!خذي هذه

2
00:00:20,830 --> 00:00:21,900
!آسفة

3
00:00:21,900 --> 00:00:23,530
!خرقاء

4
00:00:26,670 --> 00:00:30,450
أجل، سمعتُ بأنّ سوق الأنتيكات
!لديهم رائع فحسب

5
00:00:30,450 --> 00:00:31,990
أين افتتحوه؟

6
00:00:31,990 --> 00:00:34,080
!في حديقة واكاباداي المركزيّة

7
00:00:35,280 --> 00:00:37,180
!لطالما أردتُ زيارته

8
00:00:37,650 --> 00:00:39,360
!يبدو هذا مُمتِعاً بالنّسبة لي

9
00:00:39,360 --> 00:00:40,750
!إذاً لنفعلها

10
00:00:40,750 --> 00:00:42,300
!أجل، هيّا بنا

11
00:00:48,190 --> 00:00:49,840
!كوجو-سان

12
00:00:50,460 --> 00:00:51,610
تاباتا-سان؟

13
00:00:51,610 --> 00:00:53,500
كاغاياما-سان؟

14
00:00:53,500 --> 00:00:56,800
!أتريدين الذّهاب معنا؟ يوم الأحد المُقبل

15
00:02:19,180 --> 00:02:22,970
...بئساً. في يوم الأحد، عطلتي الوحيدة في الأسبوع

16
00:02:23,520 --> 00:02:26,410
...عليّ تنفيذ مهمّة خاصّة بمخبز في واكابادي

17
00:02:26,410 --> 00:02:29,170
...أعلم بأنّ أمّي تحبُّ خبزَهم، لكن

18
00:02:29,590 --> 00:02:31,520
!أنا واثق بأنّه أفضل من خبز أومب، ميبّو

19
00:02:31,890 --> 00:02:35,560
أعلم بأنّكِ شرِهة، لكن لا تأكليه
!وأنتِ في طريق العودة، ميبّو

20
00:02:35,560 --> 00:02:38,120
!أنت من قد يفعل ذلك! لا أنا

21
00:02:43,310 --> 00:02:46,390
!السّينباي الّتي أحبّها هي أعزّ صديقة لك؟

22
00:02:48,180 --> 00:02:50,500
!كوجو-سان

23
00:02:50,780 --> 00:02:52,910
!آسفة لو تأخّرت

24
00:02:52,910 --> 00:02:54,200
!بالمناسبة

25
00:02:54,200 --> 00:02:57,140
ماذا تفعلين في أيّام عطلتكِ في العادة؟

26
00:02:57,140 --> 00:02:59,670
أقدّم المساعدة في متجر ابنة عمّي

27
00:02:59,670 --> 00:03:01,720
حقّاً؟ ماذا تبيع؟

28
00:03:01,720 --> 00:03:02,660
تاكوياكي

29
00:03:02,660 --> 00:03:03,910
!مذهل

30
00:03:03,910 --> 00:03:07,160
لكن أليس عليكِ مساعدتها اليوم؟

31
00:03:07,160 --> 00:03:08,310
!كلّا

32
00:03:08,310 --> 00:03:12,120
قالت أكاني-سان بأنّني ينبغي
أن أخرج مع صديقاتي

33
00:03:12,120 --> 00:03:14,130
!قالت بأنّها ستكون تجربة جيّدة

34
00:03:14,470 --> 00:03:18,360
كوجو-سان، نحن في نفس السّنة
الدّراسيّة. لا داعي لتكوني رسميّة

35
00:03:18,360 --> 00:03:19,670
"قولي فقط "لا" أو "أجل

36
00:03:21,910 --> 00:03:23,640
...فـ-فهمت

37
00:03:24,310 --> 00:03:26,100
!انظرا إلى هذا

38
00:03:26,100 --> 00:03:28,330
!لنغُص بينهم

39
00:03:28,330 --> 00:03:29,610
!حسناً

40
00:03:31,620 --> 00:03:33,480
!هذه ظريفة

41
00:03:33,480 --> 00:03:35,390
!هناك الكثير

42
00:03:35,390 --> 00:03:38,260
أليست هذه التنّورة ظريفة؟

43
00:03:39,030 --> 00:03:40,850
!إنّها رائعة للصّيف

44
00:03:40,850 --> 00:03:42,280
!أجل، أجل

45
00:03:42,280 --> 00:03:44,560
!أحبُّ هذا القميص أيضاً

46
00:03:45,800 --> 00:03:48,270
!تحبّين الملابس كثيراً يا ناو

47
00:03:48,270 --> 00:03:49,870
!مُفاجأة! مُفاجأة

48
00:03:49,870 --> 00:03:51,660
!مُفاجأة

49
00:03:53,380 --> 00:03:55,170
!بضاعة يانغ-ساما

50
00:03:55,680 --> 00:03:59,500
!بضاعة يانغ-ساما! هذا كتابه النّادر جدّاً

51
00:03:59,500 --> 00:04:02,200
!لا أصدِّق بأنّ كلّ شيء بـ 100 ين

52
00:04:02,200 --> 00:04:04,870
ما زلتِ مهتمّة بيانغ-ساما يا ناو؟

53
00:04:04,870 --> 00:04:07,750
!برات بوت هو الرّائج اليوم

54
00:04:09,290 --> 00:04:12,010
انظري يا كوجو-سان! ألسنا زوجين رائعين؟

55
00:04:12,930 --> 00:04:15,490
...لا أمانع أن يكون خليلي

56
00:04:15,490 --> 00:04:17,850
مهلكِ

57
00:04:17,850 --> 00:04:21,290
،إذا أردتِه أن يكون حبيبكِ
...فيجب أن تسألي

58
00:04:21,290 --> 00:04:23,500
"هل يمكنك تكلّم الإنجليزيّة؟"

59
00:04:24,340 --> 00:04:26,430
وهل يمكنكِ التكلّم مع يانغ-ساما؟

60
00:04:28,240 --> 00:04:30,190
!لا

61
00:04:30,610 --> 00:04:31,510
!هذا مؤسف

62
00:04:35,210 --> 00:04:37,180
مكتبة واكاباداي المحلّية

63
00:04:38,120 --> 00:04:40,240
!هونوكا! هونوكا

64
00:04:43,060 --> 00:04:44,450
ما الأمر يا مِيبّل؟

65
00:04:44,450 --> 00:04:46,920
!أريد الدّراسة أيضاً، مِيبّو

66
00:04:47,840 --> 00:04:48,890
!حسناً

67
00:04:53,940 --> 00:04:57,720
مِيبّل-لساما، ماذا تريدين أن تدرسي اليوم؟

68
00:04:57,720 --> 00:05:00,330
!ما تدرسه هونوكا

69
00:05:00,330 --> 00:05:01,940
!فلنبدأ إذاً

70
00:05:03,110 --> 00:05:04,640
!ابذلي قصارى جهدكِ

71
00:05:04,640 --> 00:05:09,080
،بالنّسبة لي، إنّه أسيكورا-سان
طالب السّنة الثّالثة في فريق كُرة السلّة

72
00:05:12,820 --> 00:05:14,970
!أسيكورا-سينباي رائع

73
00:05:15,460 --> 00:05:17,410
!وسيم للغاية

74
00:05:17,410 --> 00:05:21,520
ماذا عنكِ يا كوجو-سان؟ هل هناك
شخصٌ تُعجبين به؟

75
00:05:22,560 --> 00:05:26,630
لا بدّ من ذلك! نظرة واحدة فقط
...تجعل قلبكِ ينبض أسرع

76
00:05:34,940 --> 00:05:37,800
ناغيسا-سان؟

77
00:05:37,800 --> 00:05:39,570
!تقصدين ميسومي-سينباي؟

78
00:05:39,570 --> 00:05:43,180
!بجدّية؟ تحبّين ميسومي-سينباي؟

79
00:05:43,180 --> 00:05:44,370
...فـ-في الواقع

80
00:05:44,370 --> 00:05:46,510
!أجل، أفهمكِ تماماً

81
00:05:46,510 --> 00:05:50,950
ميسومي ناغيسا-سينباي أشبه
!بامرأة خارقة في الرّياضة

82
00:05:50,950 --> 00:05:52,350
!أفهم ذلك تماماً

83
00:05:53,500 --> 00:05:56,350
،ميسومي-سينباي ماهرة جدّاً

84
00:05:56,350 --> 00:05:58,650
!لكن أحبّ يوكيشيرو هونوكا-سينباي أكثر

85
00:05:58,650 --> 00:06:02,260
تتمتّع بذكاء قادر على هزيمة
!الكمبيوتر الخارق ديب بلو

86
00:06:02,260 --> 00:06:04,590
!وتتمتّع بابتسامة لطيفة

87
00:06:04,590 --> 00:06:09,590
!وأفضل شيء هو أنّهما صديقتان مُقرّبتان

88
00:06:09,590 --> 00:06:12,460
أجل، لا أحد يستطيع هزيمتهما
!عندما يكونان معاً

89
00:06:12,460 --> 00:06:15,240
!هونوكا، لنل أخسر مُباراة اليوم

90
00:06:15,240 --> 00:06:17,300
!حان وقت بذل جهود حشيشة

91
00:06:17,300 --> 00:06:20,640
ناغيسا، هل تقصدين قول "جهود حثيثة"؟

92
00:06:21,320 --> 00:06:23,220
!هكذا هما

93
00:06:23,860 --> 00:06:27,180
حلمي أن أكون مثل ميسومي-سينباي

94
00:06:27,180 --> 00:06:28,780
لن تتمكّني من ذلك أبداً

95
00:06:28,780 --> 00:06:29,950
!لِمَ لا؟

96
00:06:29,950 --> 00:06:33,950
!لن تكوني مثل يوكيشيرو-سينباي أيضاً

97
00:06:34,640 --> 00:06:36,460
!ما معنى هذا؟

98
00:06:36,460 --> 00:06:38,660
!كلام فارغ

99
00:06:38,660 --> 00:06:40,030
...يا للوقاحة! يجدر بكِ أن تعلمي

100
00:06:40,030 --> 00:06:42,360
!يمكنني أن أكون مثلها تماماً

101
00:06:42,360 --> 00:06:43,500
!هيكاري

102
00:06:43,950 --> 00:06:45,760
ماذا تفعلين هنا؟

103
00:06:45,760 --> 00:06:46,970
!ناغيسا-سان

104
00:06:46,970 --> 00:06:48,870
!ميسومي ناغيسا؟

105
00:06:48,870 --> 00:06:49,840
!بذاتها

106
00:06:50,350 --> 00:06:52,240
!أنتِ مذهلة يا ناغيسا-سان

107
00:06:52,240 --> 00:06:53,710
لـ-لماذا؟

108
00:06:53,890 --> 00:06:55,770
...لا شيء

109
00:06:57,990 --> 00:07:00,280
تزورين سوق الأنتيكات؟

110
00:07:00,280 --> 00:07:01,620
ماذا عنكِ؟

111
00:07:01,620 --> 00:07:03,780
طلبَتْ منّي أمّي شراء بعض الخبز

112
00:07:03,780 --> 00:07:07,820
لكن بدا الكعك لذيذاً، فلم أستطع المُقاومة

113
00:07:07,820 --> 00:07:10,440
حقّاً؟

114
00:07:10,440 --> 00:07:12,420
هل هاتان صديقتاكِ؟

115
00:07:12,420 --> 00:07:14,400
أجل... من صفّي

116
00:07:14,400 --> 00:07:17,360
!سنة أولى من صفّ الخوخ! تاباتا ناو

117
00:07:17,360 --> 00:07:19,800
!كذلك أنا، كاغاياما ميو

118
00:07:20,250 --> 00:07:22,410
!سُرِرتُ بلقائكِ

119
00:07:25,290 --> 00:07:27,180
!أنتما مُفعمتان بالطّاقة

120
00:07:27,180 --> 00:07:28,180
!سُرِرتُ بلقائكما

121
00:07:34,900 --> 00:07:36,450
!يا له من يوم جميل

122
00:07:36,450 --> 00:07:39,420
أفضل شيءي هو الخروج عندما
!يكون الطّقس جميلاً، مِيبّو

123
00:07:39,420 --> 00:07:40,890
!أجل

124
00:07:42,300 --> 00:07:46,260
!الخروج مع ميسومي-سينباي... أشبه بحلم

125
00:07:46,260 --> 00:07:48,130
!لنتبجّح أمام الجميع غداً

126
00:07:51,210 --> 00:07:54,530
!هل تعرفين يوكيشيرو-سينباي أيضاً؟

127
00:07:54,530 --> 00:07:55,870
أجل، لماذا

128
00:07:55,870 --> 00:07:57,840
!ماذا؟ مستحيل

129
00:07:57,840 --> 00:08:00,870
مـ-مهلاً، هل يمكننا أخذ استراحة؟

130
00:08:00,870 --> 00:08:02,180
!حسناً

131
00:08:09,020 --> 00:08:10,180
!المعذرة

132
00:08:11,930 --> 00:08:15,520
ثلاثة على ثلاثة؟

133
00:08:17,970 --> 00:08:19,360
!شكراً

134
00:08:20,510 --> 00:08:24,030
أنا واثقة بأنّكِ بارعة في كُرة السلّة أيضاً

135
00:08:24,030 --> 00:08:27,630
...لا، ألعبها في درس الصّالة الرّياضيّة فقط

136
00:08:27,630 --> 00:08:30,200
!ستكونين رائعة فيها! أنا متأكّدة

137
00:08:30,200 --> 00:08:32,570
من تعتقدينني؟

138
00:08:32,570 --> 00:08:36,180
ميسومي ناغيسا، قائدة فريق اللّاكروس
!التّابع لأكاديميّة فيروني

139
00:08:36,660 --> 00:08:38,980
!أتتوقّعين منّي أن أخاف من كُرة سلّة صغيرة؟

140
00:08:38,980 --> 00:08:41,080
!غير معقول

141
00:08:41,080 --> 00:08:42,720
أليس كذلك يا هونوكا؟

142
00:08:42,720 --> 00:08:46,450
،بالمناسبة، اختُرِعت كُرة السلّة في عام 1891

143
00:08:46,450 --> 00:08:49,420
،بواسطة الأستاذ الأمريكيّ، جيمس نايسميث

144
00:08:49,420 --> 00:08:52,450
كرياضة تُمارَس في صالة رياضيّة

145
00:08:52,450 --> 00:08:55,260
!ملِكة المعرفة، هونوكا

146
00:08:55,260 --> 00:08:57,730
!إنّنا نشبهما تماماً، تماماً

147
00:08:58,710 --> 00:09:00,700
من أنتما؟

148
00:09:01,050 --> 00:09:04,170
!الطّقس رائع! لنُمارس بعض التّمارين

149
00:09:04,790 --> 00:09:07,210
!لنلعب كُرةَ السلّة، هيّا

150
00:09:12,160 --> 00:09:17,470
ناو سنة أولى فقط، لكنّها نجمة
صاعدة في فريق كُرة السلّة

151
00:09:17,470 --> 00:09:21,350
!أحبّتْها منذ كانت في المدرسة الابتدائيّة

152
00:09:25,170 --> 00:09:26,890
!قالوا بأنّهم سيلعبون معنا

153
00:09:26,890 --> 00:09:29,230
!لكنّهم تلاميذ مدرسة ثانويّة

154
00:09:29,230 --> 00:09:32,560
!لا داعي للقلق. لدينا ميسومي ناغيسا

155
00:09:32,560 --> 00:09:35,530
...ماذا؟! هوّني عليكِ

156
00:09:35,920 --> 00:09:38,900
!هيّا، بسرعة! بسرعة، بسرعة، بسرعة

157
00:09:40,220 --> 00:09:43,060
ماذا؟ ألن تلعبي يا كاغاياما-سان؟

158
00:09:43,060 --> 00:09:46,380
لستُ أُجيد الرّياضة

159
00:09:46,800 --> 00:09:49,080
!انضمّي إلينا يا كوجو-سان

160
00:09:50,930 --> 00:09:53,420
هيّا! إنّها تجربة جيّدة، صحيح؟

161
00:09:53,970 --> 00:09:55,690
سأحمل عنكِ مِحفظتكِ الصّغيرة

162
00:09:55,690 --> 00:09:58,260
...لا، من فضلك لا

163
00:09:59,070 --> 00:10:01,260
يمكنكن الهجوم أوّلاً

164
00:10:08,120 --> 00:10:09,330
!ميسومي-سينباي

165
00:10:12,790 --> 00:10:14,140
!سينباي

166
00:10:14,140 --> 00:10:15,870
!هيكاري

167
00:10:16,410 --> 00:10:17,880
!كوجو-سان، ارمي

168
00:10:30,910 --> 00:10:32,520
أنا آسفة

169
00:10:32,910 --> 00:10:34,360
!لا عليكِ

170
00:10:37,180 --> 00:10:39,430
...يبقون تلاميذ مدرسة ثانويّة

171
00:10:39,430 --> 00:10:41,400
أعتقد لا يمكننا هزيمتهم

172
00:10:41,400 --> 00:10:43,530
...صديقتكِ تلك

173
00:10:43,790 --> 00:10:45,670
تاباتا ناو؟

174
00:10:45,670 --> 00:10:47,490
!إنّها ماهرة

175
00:10:47,490 --> 00:10:49,840
...شـ-شكراً لكِ

176
00:10:50,560 --> 00:10:53,010
!مذهل، أتكلّم مع يوكيشيرو هونوكا

177
00:11:00,740 --> 00:11:02,290
هل أنتِ بخير؟

178
00:11:02,870 --> 00:11:04,490
!أنا بخير

179
00:11:04,940 --> 00:11:06,920
ربّما ينبغي أن نكتفي بهذا القدر؟

180
00:11:06,920 --> 00:11:10,130
أم تُرِدن مُعاودة المُحاولة؟

181
00:11:39,010 --> 00:11:40,690
...لا، لنتابع قليلاً

182
00:11:40,690 --> 00:11:43,030
نستطيع مُتابعة اللّعب قليلاً

183
00:11:43,410 --> 00:11:45,100
!توقُّف مُؤقَّت

184
00:11:46,830 --> 00:11:48,560
!توقُّف مُؤقَّت

185
00:11:48,560 --> 00:11:49,800
!هونوكا

186
00:11:49,800 --> 00:11:50,770
!هونوكا-سان

187
00:11:52,720 --> 00:11:55,640
هل هنا شعرتُ بالملِكة؟

188
00:11:56,230 --> 00:11:58,440
!يبدو كاجتماع تخطيطيّ

189
00:11:58,440 --> 00:12:01,810
...أن تنخرط في الرّياضة

190
00:12:01,810 --> 00:12:04,650
!كم قلبها نقيّ

191
00:12:05,430 --> 00:12:07,550
وبعد؟ هل تشعرين براحة؟

192
00:12:07,550 --> 00:12:09,120
أجل، شكراً

193
00:12:09,370 --> 00:12:13,660
،لا أعرف الكثير عن كُرة السلّة
،لذا لا أستطيع قول الكثير

194
00:12:13,660 --> 00:12:16,460
لكن لا تُركّزي على حقيقة أنّها كُرة سلّة

195
00:12:16,460 --> 00:12:19,230
تحرّكي كما تفعلين فقط عندما
!تلعبين اللّاكروس

196
00:12:19,230 --> 00:12:21,630
أنتِ دقيقة عندما يتعلّق بالرّمي، صحيح؟

197
00:12:21,630 --> 00:12:24,170
،يبدو أنّكِ اعتدتِ الآن على التحكُّم بالكُرة

198
00:12:24,170 --> 00:12:27,970
لذا لياقتكِ البدنيّة الطّبيعيّة وغريزتكِ
ينبغي أن ينفعاكِ في ذلك

199
00:12:27,970 --> 00:12:28,570
!أجل

200
00:12:28,570 --> 00:12:31,740
تاباتا-سان، لا تقلقي بشأن حقيقة
أنّ زميلتيكِ لا تمتلكان خبرة

201
00:12:31,740 --> 00:12:34,450
!تحرّكي أكثر كما تفعلين في العادة

202
00:12:34,450 --> 00:12:36,620
،ثِقي بهما أكثر

203
00:12:36,620 --> 00:12:39,420
!وأريهما كلّ ما لديكِ

204
00:12:39,420 --> 00:12:40,720
!حسناً

205
00:12:41,150 --> 00:12:43,250
ماذا عنّي؟

206
00:12:43,610 --> 00:12:45,260
...لنرَ

207
00:12:49,980 --> 00:12:51,560
أعتقد تتمتّعين بغريزة جيّدة

208
00:12:51,560 --> 00:12:54,360
في المرّة المقبلة الّتي تحصلين
!فيها على الكُرة، حاولي الرّمي

209
00:12:55,580 --> 00:12:57,330
!أنا؟

210
00:12:57,750 --> 00:13:00,800
!حسناً! ثِقنَ بالفريق وبأنفسكن

211
00:13:00,800 --> 00:13:01,230
!حسناً

212
00:13:01,230 --> 00:13:02,880
!أجل

213
00:13:02,880 --> 00:13:04,930
!أنا متأكّدة بأنّكن تستطعن فعلها

214
00:13:04,930 --> 00:13:05,740
!أجل

215
00:13:10,130 --> 00:13:11,450
مُبهِر

216
00:13:11,450 --> 00:13:13,280
إنّهن مُختلفات الآن

217
00:13:18,650 --> 00:13:19,580
!إنّي أراها

218
00:13:25,050 --> 00:13:26,420
إلى أين مرّرتها؟

219
00:13:29,160 --> 00:13:30,060
...ماذا

220
00:13:41,630 --> 00:13:42,780
!فعلتِها

221
00:13:42,780 --> 00:13:44,250
!أحرزنا هدفاً

222
00:13:44,250 --> 00:13:46,220
!أنتِ رهيبة يا سينباي

223
00:13:46,740 --> 00:13:48,520
!كان ذلك مُدهشاً

224
00:13:48,940 --> 00:13:51,060
!ناغيسا-سان، أنتِ رائعة

225
00:13:52,810 --> 00:13:54,330
!فعلتِها

226
00:13:54,330 --> 00:13:56,230
...رائعة

227
00:13:56,230 --> 00:13:58,930
رأيتِ؟ أليست ناغيسا رائعة؟

228
00:13:58,930 --> 00:14:01,700
!لا، أنتِ الرّائعة

229
00:14:12,130 --> 00:14:16,520
يتحرّكن بشكل مختلف تماماً الآن

230
00:14:16,520 --> 00:14:17,850
ربّما كانت ضربة حظّ؟

231
00:14:17,850 --> 00:14:18,910
!هذا مُثير للاهتمام

232
00:14:19,710 --> 00:14:22,150
!من فضلك، أعدها

233
00:14:27,930 --> 00:14:29,900
هيكاري. هل أنتِ بخير، بوبّو؟

234
00:14:31,890 --> 00:14:32,750
!بئساً

235
00:14:32,960 --> 00:14:33,890
!هيكاري

236
00:14:37,850 --> 00:14:39,330
!هيكاري! ارميها من هناك

237
00:14:41,620 --> 00:14:43,700
!هيكاري! ارمي

238
00:15:04,450 --> 00:15:05,850
!دخلتْ

239
00:15:11,320 --> 00:15:12,590
...مستحيل

240
00:15:16,360 --> 00:15:19,400
!هيكاري

241
00:15:29,400 --> 00:15:30,660
!أحسنتِ صنعاً يا هيكاري

242
00:15:30,660 --> 00:15:33,250
!عرفتُ بأنّكِ مُذهلة

243
00:15:34,240 --> 00:15:35,520
ما الأمر؟

244
00:15:35,520 --> 00:15:37,130
هيكاري؟

245
00:15:37,130 --> 00:15:39,620
ألستِ سعيدة يا هيكاري؟

246
00:15:39,820 --> 00:15:41,500
هيكاري؟

247
00:15:41,500 --> 00:15:44,940
لا... أنا سعيدة

248
00:15:45,890 --> 00:15:47,310
سعيدة جدّاً

249
00:15:48,720 --> 00:15:50,430
!رائع

250
00:15:50,430 --> 00:15:51,910
!يسرّني بأنّنا أتينا

251
00:15:51,910 --> 00:15:52,670
!أجل

252
00:15:54,530 --> 00:15:56,380
!هذه ملكتنا الّتي عهِدناها

253
00:15:56,380 --> 00:15:59,020
!إنّها تنخرط في كلّ شيء

254
00:15:59,020 --> 00:16:03,050
!قلبها النّقيّ حقّق مُعجزة فعلاً

255
00:16:03,050 --> 00:16:04,220
أتعتقدين بأنّ الأمر كان كذلك؟

256
00:16:04,220 --> 00:16:06,220
لا يوجد ما يُدعى بالمُعجزات

257
00:16:06,220 --> 00:16:08,690
لا شيء سوى هيمنة الظّلام

258
00:16:11,980 --> 00:16:13,390
ناغيسا؟

259
00:16:20,620 --> 00:16:22,690
تاباتا-سان؟ كاغاياما-سان؟

260
00:16:22,690 --> 00:16:24,800
!النّجدة! النّجدة

261
00:16:24,800 --> 00:16:25,660
سيكون؟

262
00:16:25,660 --> 00:16:26,680
بوران؟

263
00:16:31,230 --> 00:16:32,800
أنت من جديد؟

264
00:16:32,800 --> 00:16:36,670
هذا يوم عطلة هيكاري! حريّ بك
!ألّا تعترض طريقها

265
00:16:36,880 --> 00:16:38,320
كما توقّعت

266
00:16:38,320 --> 00:16:43,030
ينابيع الطّاقة تلك تنتشر حيثما تتواجدن

267
00:16:43,030 --> 00:16:46,150
ما رابطهن بالملِكة؟

268
00:16:46,520 --> 00:16:48,850
!ر-رابط؟ لا يوجد رابط

269
00:16:49,450 --> 00:16:50,650
بل يوجد، أليس كذلك؟

270
00:16:50,860 --> 00:16:52,340
!ناغيسا، لا تفضحي الأمر

271
00:16:52,340 --> 00:16:54,080
...لكن قال

272
00:16:54,260 --> 00:16:56,740
ربّما سآخذهم معي

273
00:16:56,740 --> 00:16:59,580
...لأدرس مدى ارتباطهم بإحياء الملِكة

274
00:16:59,580 --> 00:17:02,630
بالإضافة إلى حياة الملِكة الّتي هناك

275
00:17:04,270 --> 00:17:05,470
!لن نسمح بحدوث ذلك

276
00:17:05,470 --> 00:17:06,670
!ناغيسا

277
00:17:06,670 --> 00:17:07,340
!هونوكا

278
00:17:12,840 --> 00:17:14,980
!موجة الشّفق الثنائيّة

279
00:17:24,620 --> 00:17:27,260
!مبعوثة النُّور، كيور بلاك

280
00:17:27,560 --> 00:17:30,190
!مبعوثة النُّور، كيور وايت

281
00:17:32,390 --> 00:17:34,130
!سوية، نحن بريكيور

282
00:17:35,560 --> 00:17:37,700
...يا خدم قوّة الظّلام

283
00:17:38,600 --> 00:17:41,000
!عودوا من حيث أتيتم

284
00:17:55,080 --> 00:17:56,230
كم هذا مُثير للشّفقة

285
00:17:56,230 --> 00:18:00,520
تمتلكان كلّ هذه القوّة ومع ذلك
تستخدمانها ضدّ ملِك الشرّ؟

286
00:18:00,520 --> 00:18:02,110
!بكلّ تأكيد

287
00:18:02,110 --> 00:18:05,630
كلّ ما نريد فعله هو العيش
!بسلام مع الجميع

288
00:18:06,600 --> 00:18:08,010
مسكينتان

289
00:18:08,010 --> 00:18:11,720
ستُلتهَم حديقة أقواس قزح يوماً ما
،بواسطة منطِقة دوتسكو

290
00:18:11,720 --> 00:18:14,100
وتختفي بلا أثر

291
00:18:14,800 --> 00:18:16,820
...لـ-لا

292
00:18:17,770 --> 00:18:19,440
!لن أسمح بحدوث ذلك

293
00:18:20,280 --> 00:18:21,460
هيكاري؟

294
00:18:21,460 --> 00:18:25,650
!لا أريد أن تختفي حديقةُ أقواس قزح

295
00:18:26,280 --> 00:18:31,120
...فكرة عدم رؤية هؤلاء النّاس ثانية
!لا أطيقها...

296
00:18:31,390 --> 00:18:32,590
...هيكاري

297
00:18:32,860 --> 00:18:34,050
...هيكاري-سان

298
00:18:34,420 --> 00:18:35,960
!بولن

299
00:18:37,390 --> 00:18:38,580
!لومينوس

300
00:18:38,930 --> 00:18:41,230
!السّيل اللّامِع

301
00:18:49,170 --> 00:18:51,770
!شرارة الحياة، لومينوس اللّامِعة

302
00:18:53,740 --> 00:18:56,080
!قلب النُّور وإرادة النُّور

303
00:18:56,410 --> 00:18:58,610
!لتوحيدهم جميعاً

304
00:19:05,020 --> 00:19:06,350
!لومينوس

305
00:19:15,130 --> 00:19:19,360
!لماذا تهتمّين كثيراً لهذه الكائنات التّافهة؟

306
00:19:20,740 --> 00:19:22,420
...إنّها

307
00:19:23,240 --> 00:19:25,340
!إنّها ليست تافهة

308
00:19:26,040 --> 00:19:29,810
إنّهن أوّل من دعاني للخروج في صفّي

309
00:19:30,350 --> 00:19:32,500
!أدخلنَ السّرور في قلبي

310
00:19:32,500 --> 00:19:35,070
!منحنَني البهجة

311
00:19:35,720 --> 00:19:38,520
!لسنَ تافِهات على الإطلاق

312
00:19:46,900 --> 00:19:50,380
!إذاً سأُدمّركن معاً

313
00:19:59,140 --> 00:20:02,140
!سوف أحمي هؤلاء

314
00:20:02,140 --> 00:20:04,240
!لنعمل معاً، بوبّو

315
00:20:07,150 --> 00:20:08,780
!الشّجاعة الفيّاضة

316
00:20:09,320 --> 00:20:10,910
!الأمل الغامِر

317
00:20:11,490 --> 00:20:13,820
!والرّوابط المُشعّة بالنُّور

318
00:20:14,920 --> 00:20:16,450
...إكستريم

319
00:20:16,630 --> 00:20:18,320
!لوميناريو

320
00:20:43,710 --> 00:20:46,340
!كان الأمس شاقّاً

321
00:20:46,340 --> 00:20:47,470
ماذا تقصدين؟

322
00:20:47,470 --> 00:20:51,720
كان الجميع سُعداء، سمحتُ لهم
،بأكل كلّ الخبز

323
00:20:51,720 --> 00:20:52,910
...باستثناء الخبز الفرنسيّ

324
00:20:52,910 --> 00:20:55,080
،لكن عندما زرتُ المخبز في طريق العودة

325
00:20:55,080 --> 00:20:58,420
كانت الكمّية قد نفدت، وغضبت
!أمّي منّي غضباً شديداً

326
00:20:58,970 --> 00:21:01,830
!لكنّكِ أكلتِ مُعظمه

327
00:21:01,830 --> 00:21:04,300
!هذا لأنّني كنتُ جائعة

328
00:21:05,570 --> 00:21:07,960
ليس سهلاً أن يكون المرء بريكيور

329
00:21:07,960 --> 00:21:09,430
!هيكاري

330
00:21:10,710 --> 00:21:12,910
!بسرعة! بسرعة

331
00:21:13,780 --> 00:21:14,980
!ميسومي-سينباي

332
00:21:17,650 --> 00:21:20,270
!شكراً جزيلاً على الأمس

333
00:21:20,270 --> 00:21:22,370
!شكراً جزيلاً

334
00:21:22,370 --> 00:21:24,310
!على الرّحب

335
00:21:24,310 --> 00:21:28,010
،لديّ واجب صفّ صباحيّ اليوم
!لذا يجب أن أسرع

336
00:21:28,010 --> 00:21:29,920
!استأذن

337
00:21:29,920 --> 00:21:32,420
!لنخرج معاً ثانية في وقت لاحق

338
00:21:32,420 --> 00:21:33,990
غـ-غير معقول

339
00:21:37,640 --> 00:21:40,450
!صباح الخير

340
00:21:40,450 --> 00:21:41,800
هل أنتِ في واجب صباحيّ أيضاً؟

341
00:21:41,800 --> 00:21:43,770
!أجل، صحيح

342
00:21:44,180 --> 00:21:46,330
!هيكاري! بسرعة

343
00:21:46,330 --> 00:21:48,980
!سيُوبّخنا المُعلّم

344
00:21:49,280 --> 00:21:51,570
!نـ-نلتقي

345
00:21:51,840 --> 00:21:53,070
هيكاري-سان؟

346
00:21:56,120 --> 00:21:57,520
أليس هذا رائعاً؟

347
00:22:02,330 --> 00:22:04,270
!أجل

348
00:22:04,890 --> 00:22:05,990
!ناو

349
00:22:06,570 --> 00:22:08,050
!ميو

350
00:22:14,840 --> 00:22:17,400
!انتظراني

351
00:23:57,410 --> 00:23:58,970
!كان الحظّ يُحالفني مؤخّراً

352
00:23:58,970 --> 00:24:00,340
،ربحتُ بطّيخة

353
00:24:00,570 --> 00:24:02,870
!وصادفتُ فوجيبي-سينباي في الشّارع

354
00:24:03,620 --> 00:24:05,500
لكن هل أنتِ مستعدّة لمنتصف الفصل؟

355
00:24:05,500 --> 00:24:08,140
!أنا محظوظة الآن. ليس لديّ ما أخشاه

356
00:24:08,140 --> 00:24:09,470
!سنرى ذلك

357
00:24:09,470 --> 00:24:12,080
!حتّى ظهر أولئك! يا له من حظّ عاثر

358
00:24:13,030 --> 00:24:14,320
:نحن بريكيور ماكس هارت

359
00:24:14,320 --> 00:24:17,520
!سلسلة انتصارات ناغيسا
!تحقيق النّجاح بلون جالب للحظّ

360
00:24:17,520 --> 00:24:20,690
!لا أستطيع حلّ أسئلة الاختبارات هذه
!ظننتُ أنَّ الحظّ يُحالفني

361
00:24:20,690 --> 00:24:23,060
!لا يمكنكِ النّجاح في اختبار بالحظِّ وحده