1
00:00:20,530 --> 00:00:25,100
تجربتنا لمشروع استراحة الشّتاء
كانت ناجحة

2
00:00:25,100 --> 00:00:27,570
سوف نكتفي بهذا القدر

3
00:00:27,870 --> 00:00:29,990
!ابدؤوا بالتّنظيف جميعاً

4
00:00:29,990 --> 00:00:31,620
!حسناً

5
00:00:33,740 --> 00:00:37,430
تُبلي ناغاي-سان بلاء ممتازاً
كرئيسة نادٍ جديدة

6
00:00:37,430 --> 00:00:39,980
أجل، أشعر بأمان بترك
!النّادي بين يديها

7
00:00:40,150 --> 00:00:42,270
لكن أفتقد له أيضاً

8
00:00:42,270 --> 00:00:43,450
وكذلك أنا

9
00:00:45,690 --> 00:00:46,920
...المعذرة

10
00:00:46,920 --> 00:00:49,590
هل لديكِ مخطّطات لهذا الأسبوع؟

11
00:00:49,930 --> 00:00:51,940
لا، لماذا؟

12
00:00:51,940 --> 00:00:53,710
!لا يوجد سبب

13
00:00:55,700 --> 00:00:57,100
!أعيدي التّمريرة في أسرع وقت

14
00:00:57,100 --> 00:00:57,570
!حسناً

15
00:00:57,570 --> 00:00:58,770
!يا قائدة

16
00:01:02,600 --> 00:01:04,240
!وشيكة

17
00:01:04,240 --> 00:01:06,410
لا تنسي الأساسيّات، حسناً؟

18
00:01:06,410 --> 00:01:07,210
!حسناً

19
00:01:07,380 --> 00:01:09,630
ماكي صارمة جدّاً

20
00:01:09,630 --> 00:01:12,580
إنّها عكس القائدة ميسومي

21
00:01:12,580 --> 00:01:15,550
!حسناً، مرّة أخرى! تذكّري الأساسيّات

22
00:03:02,420 --> 00:03:05,020
أتعتقد بأنّ صحوته قريبة؟

23
00:03:05,020 --> 00:03:07,580
أ-أين أنت، زاكينّا؟

24
00:03:07,580 --> 00:03:08,810
!هنا، زاكينّا

25
00:03:08,810 --> 00:03:10,280
زاكينّا؟

26
00:03:13,770 --> 00:03:15,150
!أمسكتُ بك

27
00:03:19,140 --> 00:03:22,940
إنّهما يؤثِّران ببعضهما الآخر وينموان

28
00:03:23,310 --> 00:03:25,430
وحيث يؤدّي ذلك الطّريق

29
00:03:25,430 --> 00:03:27,910
هو الحُكم المُطلَق للظّلام

30
00:03:31,050 --> 00:03:34,970
!استراحة الشّتاء الأخيرة
!درس زاكينّا الخاصّ؟

31
00:03:49,810 --> 00:03:51,440
،تتطلّب ذلك كثيراً من الشّجاعة

32
00:03:51,770 --> 00:03:54,230
لكن سُرِرتُ لأنّني عبّرتُ عنها بصوتٍ عال

33
00:03:54,230 --> 00:03:56,510
ساعدني ذلك على تفريغ شحناتي

34
00:03:56,970 --> 00:03:59,780
!حسناً، سأستمرّ في بذل قصارى جهدي

35
00:04:07,390 --> 00:04:09,550
!يفعلنَها من جديد

36
00:04:11,590 --> 00:04:13,000
!التّسديدة قادمة

37
00:04:13,000 --> 00:04:13,760
!حسناً

38
00:04:19,940 --> 00:04:21,250
هل أنتِ بخير؟

39
00:04:21,250 --> 00:04:22,130
آسفة

40
00:04:22,130 --> 00:04:23,420
!أنتما

41
00:04:23,420 --> 00:04:26,490
هل نسيتُما تشكيلكما الدّفاعيّ؟

42
00:04:26,490 --> 00:04:27,940
!حسناً، مرّة أخرى

43
00:04:27,940 --> 00:04:28,530
حسناً

44
00:04:28,530 --> 00:04:29,970
!هيّا يا فيروني

45
00:04:30,210 --> 00:04:33,580
!هيّا، هيّا يا فيروني! هيّا، هيّا، هيّا

46
00:04:33,580 --> 00:04:35,210
!يا قائدة

47
00:04:35,210 --> 00:04:37,140
!أقصد، ميسومي-سينباي

48
00:04:39,720 --> 00:04:41,240
ماذا تفعلين هنا؟

49
00:04:41,240 --> 00:04:46,650
سمعتُ بأنّكن كنتُن تتدرّبن في استراحة
!الشّتاء لهزيمة أوتاكاكو

50
00:04:47,000 --> 00:04:48,580
!أشتمّ رائحة تاكوياكي

51
00:04:48,580 --> 00:04:50,350
!حاسّة شمّ قويّة

52
00:04:50,350 --> 00:04:51,520
على حسابي

53
00:04:51,520 --> 00:04:52,760
!رائع

54
00:04:52,760 --> 00:04:55,150
!أنتن! ما زلنا نتدرّب

55
00:04:55,540 --> 00:04:59,190
!مهلكِ. ميسومي-سينباي دعتنا لتناول طعام

56
00:04:59,700 --> 00:05:03,300
!ويحكُن. أصغينَ لقائدتكن

57
00:05:03,300 --> 00:05:04,600
...حسناً

58
00:05:04,600 --> 00:05:06,170
آسفة لتشكيلي عقبة أمامكن

59
00:05:06,750 --> 00:05:08,330
لا عليكِ

60
00:05:08,330 --> 00:05:11,640
!لنأخذ استراحة ونأكل قبل أن يبرد الطّعام

61
00:05:11,640 --> 00:05:12,580
!أجل

62
00:05:12,580 --> 00:05:13,650
!هذه هي قائدتنا

63
00:05:15,320 --> 00:05:18,950
ابذلنَ قصارى جهدكن لخوض تلك
!المُباراة التّمرينيّة ضدّ أوتاكاكو

64
00:05:18,950 --> 00:05:19,820
!حسناً

65
00:05:19,820 --> 00:05:23,520
لكن نفتقدكِ حقّاً يا ميسومي-سينباي

66
00:05:23,520 --> 00:05:24,940
!أجل، أجل

67
00:05:24,940 --> 00:05:28,760
من الصّعب أن نتحمّس من دونكِ

68
00:05:28,760 --> 00:05:30,420
مهلاً يا فتيات

69
00:05:30,420 --> 00:05:33,260
!لديكن قائدة جديدة الآن

70
00:05:33,260 --> 00:05:34,370
أليس كذلك يا ماكي؟

71
00:05:34,370 --> 00:05:35,000
!أ-أجل

72
00:05:35,310 --> 00:05:36,860
سأبذل قصارى جهدي

73
00:05:36,860 --> 00:05:38,970
!جميعكن، لنعُد إلى التّمرين

74
00:05:39,210 --> 00:05:42,940
!قاتِلن! قاتِلن! قاتِلن! قاتِلن

75
00:05:43,320 --> 00:05:45,810
ماكي-سان هي القائدة الجديدة؟

76
00:05:45,810 --> 00:05:46,410
أجل

77
00:05:46,410 --> 00:05:49,420
،ظننتُ بأنّها تُبلي حسناً

78
00:05:49,420 --> 00:05:52,110
لكن يبدو أنّها في حيرة من أمرها

79
00:05:52,110 --> 00:05:53,390
تُعاني قليلاً

80
00:05:53,800 --> 00:05:56,860
!كشخص ما قبل سنة

81
00:05:57,230 --> 00:05:59,330
...في الحقيقة... أجل

82
00:06:00,270 --> 00:06:02,330
،جعلنَني قائدة فجأة

83
00:06:02,330 --> 00:06:05,300
...وظننتُ بأنّني غير جديرة بذلك

84
00:06:05,300 --> 00:06:09,360
...لكن تعزّزت روابطنا شيئاً فشيئاً

85
00:06:13,280 --> 00:06:17,380
وحتّى أنّني انفعلتُ كثيراً ذات مرّة
...حتّى غبتُ عن الوعي

86
00:06:22,790 --> 00:06:27,780
تذكّرتُ الآن بأنّني قضيتُ عاماً
كاملاً وأنا قائدة

87
00:06:27,780 --> 00:06:28,990
كذلك أنا

88
00:06:29,770 --> 00:06:34,290
بدأتُ أتساءل عن سبب انضمامي
لنادي العلوم أصلاً

89
00:06:39,260 --> 00:06:43,800
لكن أدركتُ أنّه كانت هناك أمور
!كثيرة أردتُ فعلها

90
00:06:46,870 --> 00:06:50,840
وأشعر وكأنّنا حقّقنا إنجازات

91
00:06:50,840 --> 00:06:52,030
!هذا صحيح

92
00:06:52,030 --> 00:06:55,640
ستصبح ماكي قائدة عظيمة

93
00:06:55,640 --> 00:06:56,810
!أجل

94
00:06:56,810 --> 00:07:00,380
عمّاذا يتكلّمن يا تُرى؟

95
00:07:00,380 --> 00:07:01,490
...أتعتقدين

96
00:07:01,490 --> 00:07:02,120
ماذا؟

97
00:07:02,400 --> 00:07:04,090
...أتعتقدين، أتعتقدين، أتعتقدين

98
00:07:04,330 --> 00:07:06,720
سَمِعنَ بذلك؟

99
00:07:06,720 --> 00:07:08,060
ماذا؟

100
00:07:08,060 --> 00:07:09,790
ماذا تفعلان هنا؟

101
00:07:09,790 --> 00:07:11,420
!صه

102
00:07:16,550 --> 00:07:19,740
لكن الهمّ الأكبر في بالي هو هيكاري

103
00:07:19,740 --> 00:07:22,630
أجل. تتصرّف بغرابة أحياناً

104
00:07:22,630 --> 00:07:24,000
ما الّذي يمكن أن يكون قد حدث؟

105
00:07:24,000 --> 00:07:26,410
إنّه تشعر بشيء ما، مِيبّو

106
00:07:26,410 --> 00:07:28,840
!يحدث شيء ما بداخلها، مِيبّو

107
00:07:28,840 --> 00:07:30,210
بداخلها؟

108
00:07:30,210 --> 00:07:33,680
!على أيّ حال، يجب علينا مُراقبتها، ميبّو

109
00:07:33,680 --> 00:07:36,650
أجل. يجدر بنا أن نبقى قريبين
منها قدر المستطاع

110
00:07:49,300 --> 00:07:51,760
ماذا حدث هناك؟

111
00:07:54,920 --> 00:07:56,440
هيكاري. ما الأمر، بوبّو؟

112
00:07:57,250 --> 00:07:59,410
أنا بخير. لا شيء

113
00:07:59,410 --> 00:08:01,170
أحقّاً، لولو؟

114
00:08:02,990 --> 00:08:04,140
!ماكي

115
00:08:04,140 --> 00:08:05,350
!سينباي

116
00:08:09,460 --> 00:08:12,980
ماذا؟ لستِ متأكّدة ما إن كنتِ
جديرة بأن تكوني قائدة؟

117
00:08:12,980 --> 00:08:15,860
أبذل قصارى جهدي

118
00:08:16,240 --> 00:08:21,590
،لكن أشعر بأنّني كلّما بذلتُ جهداً أكبر
انهار الفريق أكثر

119
00:08:21,590 --> 00:08:23,160
وهذا ما يؤرقكِ؟

120
00:08:23,160 --> 00:08:24,930
لستُ واثقة إطلاقاً

121
00:08:25,350 --> 00:08:26,800
نفس الأمر كان ينطبق عليّ

122
00:08:27,180 --> 00:08:29,600
عندما تولّيتُ دورَ القائدة أوّل
،مرّة، قلتُ لنفسي

123
00:08:30,090 --> 00:08:33,570
.يجب أن أفعل هذا بشكلٍ صحيح"
"يجب عليّ أن أتصرّف كقائدة

124
00:08:33,760 --> 00:08:36,510
كنتُ قلقة طوال الوقت

125
00:08:36,510 --> 00:08:38,140
راودكِ ذلك الشُّعور أيضاً؟

126
00:08:38,140 --> 00:08:39,780
أجل، تماماً

127
00:08:39,780 --> 00:08:42,020
وماذا حدث؟

128
00:08:42,200 --> 00:08:45,450
هل توصّلتِ إلى طريقة لتجاوز مخاوفكِ؟

129
00:08:45,450 --> 00:08:47,490
لا، إطلاقاً

130
00:08:47,900 --> 00:08:49,720
...أدركتُ فقط

131
00:08:49,720 --> 00:08:53,160
"لم أستطع التصرّف "كقائدة

132
00:08:53,510 --> 00:08:55,960
،استطعتُ التصرُّف على طبيعتي

133
00:08:55,960 --> 00:08:59,970
والتمتّع بلعِب اللّاكروس مع الجميع

134
00:08:59,970 --> 00:09:01,600
هذا ما في الأمر

135
00:09:01,600 --> 00:09:02,900
هذا فقط؟

136
00:09:02,900 --> 00:09:07,470
لكنّني لستُ مشهورة مثلكِ

137
00:09:07,470 --> 00:09:09,880
لا أعتقد بأنّني أستطيع فعل ما تفعلينه

138
00:09:10,460 --> 00:09:12,680
ليس عليكِ فعل ما أفعله

139
00:09:12,680 --> 00:09:14,110
ماذا؟

140
00:09:14,460 --> 00:09:17,150
يجدر بكِ أن تفعلي الأمور على طريقتكِ

141
00:09:17,400 --> 00:09:19,620
أفعل الأمور... على طريقتي؟

142
00:09:19,620 --> 00:09:20,970
أجل

143
00:09:20,970 --> 00:09:22,920
كنتُ عديمة المسؤوليّة

144
00:09:22,920 --> 00:09:25,520
كانت شيهو ورينا تُوبّخانني طوال الوقت

145
00:09:25,520 --> 00:09:27,290
بينما أنتِ مُتماسِكة وأكثر هدوءاً

146
00:09:27,290 --> 00:09:29,390
أظنّكِ ستحظين بدعمهن خلال فترة قصيرة

147
00:09:29,390 --> 00:09:31,060
...ميسومي-سينباي

148
00:09:31,580 --> 00:09:32,770
هكذا تسير الأمور

149
00:09:33,280 --> 00:09:34,470
...لذلك

150
00:09:34,650 --> 00:09:38,600
غالباً ستُبدعين أكثر إذا استرخيتِ قليلاً

151
00:09:40,990 --> 00:09:43,240
استرخيت؟

152
00:09:43,630 --> 00:09:45,480
...أفعل الأمور على طريقتي

153
00:09:45,480 --> 00:09:47,410
!ميسومي-سينباي

154
00:09:47,410 --> 00:09:49,610
لديكِ تمرين أكثر غداً، صحيح؟

155
00:09:49,800 --> 00:09:53,020
احرصي على أخذ قسط من الرّاحة
!وإنعاش نفسكِ

156
00:09:53,020 --> 00:09:55,590
!حسناً! سأعمل بجدّ ثانية غداً

157
00:09:55,590 --> 00:09:56,860
!عليّ الذّهاب

158
00:09:56,860 --> 00:09:57,720
!إلى اللِّقاء

159
00:09:58,940 --> 00:10:00,830
!شكراً على كلّ شيء

160
00:10:03,110 --> 00:10:04,960
!ابذلي قصارى جهدكِ يا ماكي

161
00:10:06,520 --> 00:10:08,170
!ناغيسا

162
00:10:08,620 --> 00:10:10,640
شيهو؟ رينا؟ ما الأمر؟

163
00:10:11,050 --> 00:10:13,140
!ناغيسا، ناغيسا، ناغيسا

164
00:10:13,140 --> 00:10:15,340
هل يمكننا أن نطرح عليكِ سؤالاً؟

165
00:10:15,660 --> 00:10:18,340
هلّا التقيتِ بنا في المدرسة
على السّاعة الثّالثة غداً؟

166
00:10:18,590 --> 00:10:19,950
ما رأيكِ؟ ما رأيكِ؟ ما رأيكِ؟

167
00:10:19,950 --> 00:10:21,550
أ-أكيد، لكن لماذا؟

168
00:10:21,900 --> 00:10:23,550
...فـ-في الحقيقة

169
00:10:23,550 --> 00:10:25,250
!لا يمكننا أن نتكلّم بعد

170
00:10:25,770 --> 00:10:27,450
!إلى اللِّقاء

171
00:10:27,450 --> 00:10:30,560
مهلاً! أخبراني بالسّبب؟

172
00:10:32,610 --> 00:10:34,160
يوريكو؟

173
00:10:35,130 --> 00:10:36,760
غـ-غداً؟

174
00:10:37,580 --> 00:10:40,030
...لا أمانع، لكن

175
00:10:43,390 --> 00:10:45,700
حسناً، لنُغلق المحلّ

176
00:10:45,700 --> 00:10:47,040
!حسناً

177
00:10:47,840 --> 00:10:51,640
صحيح. لا ينقصنا شيء غداً، صحيح؟

178
00:10:52,230 --> 00:10:54,580
!سأتحقّق ثانية

179
00:11:35,500 --> 00:11:37,250
هيكاري؟ ما الأمر؟

180
00:11:38,570 --> 00:11:40,630
ما الّذي ينقصنا؟

181
00:11:41,910 --> 00:11:43,860
...يبدو أنّ لدينا كلّ شيء

182
00:11:47,930 --> 00:11:50,500
هيكاري تتصرّف بغرابة، بوبّو

183
00:11:50,500 --> 00:11:53,440
أعتقد هناك ما يُقلقها، لولو

184
00:11:54,460 --> 00:11:57,280
...ذلك... ذلك المشهد الّذي رأيتُه للتو

185
00:11:57,280 --> 00:11:58,870
ماذا كان؟

186
00:12:27,360 --> 00:12:29,110
!أشعر به! أشعر به

187
00:12:29,110 --> 00:12:31,240
!أشعر بحُبّ فائض

188
00:12:32,160 --> 00:12:35,710
!يبدو أنّ الأجواء حافلة في المدرسة

189
00:12:35,710 --> 00:12:39,850
!الكثير من المشاعر النّقيّة تتوحّد معاً

190
00:12:39,850 --> 00:12:41,180
!كم هذا مُبهِج

191
00:12:42,000 --> 00:12:43,380
استدعوكِ إلى هنا أيضاً؟

192
00:12:43,540 --> 00:12:46,060
طلبت منّي يوريكو أن أكون
هنا على السّاعة الثّالثة

193
00:12:46,060 --> 00:12:47,630
هل هي صدفة؟

194
00:12:47,630 --> 00:12:49,350
!ناغيسا! ناغيسا! ناغيسا

195
00:12:49,350 --> 00:12:51,820
!يوكيشيرو-سان! كلتاكما، تعالا من هنا

196
00:12:52,110 --> 00:12:53,530
كلتانا؟ معاً؟

197
00:12:53,950 --> 00:12:56,540
بجدّية، ما الأمر؟

198
00:12:57,020 --> 00:12:58,840
!بسرعة، بسرعة، بسرعة

199
00:13:01,130 --> 00:13:02,230
مُختبر العلوم؟

200
00:13:02,230 --> 00:13:04,100
!بالفعل، أخبرانا بسرعة فحسب

201
00:13:14,810 --> 00:13:16,380
!القائدة ميسومي

202
00:13:16,380 --> 00:13:17,520
!الرّئيسة يوكيشيرو

203
00:13:17,840 --> 00:13:21,360
!شكراً على عام رائع

204
00:13:23,010 --> 00:13:25,460
...إنّه ليس وقت التخرُّج بعد، بعد، بعد

205
00:13:25,460 --> 00:13:31,630
لكن أردنا حقّاً أن نُقيم حفلة
!شكر لكما قبل ذلك الحين

206
00:13:31,990 --> 00:13:35,010
،خطرت نفس الفكرة على ذهن نادي العلوم

207
00:13:35,010 --> 00:13:37,600
!لذا قرّرنا جمع الحفلتين

208
00:13:37,890 --> 00:13:41,570
هذا يُفسّر ما حدث! كنتُ أتساءل
ما الّذي تُخطِّطن له

209
00:13:41,570 --> 00:13:43,380
!أجل، كنتُ مُتوتِّرة للغاية

210
00:13:43,380 --> 00:13:44,540
ميسومي-سينباي

211
00:13:44,740 --> 00:13:47,240
سأفعل ما طلبتِه منّي

212
00:13:48,040 --> 00:13:52,660
سأعمل بجدّ وأحاول أن أكون
!قائدة على طريقتي

213
00:13:53,380 --> 00:13:54,720
!أعلم بأنّكِ ستبلين بلاء حسناً

214
00:13:55,080 --> 00:13:59,060
،سأتذكّر كلّ شيء علّمتِني إيّاه

215
00:13:59,060 --> 00:14:01,270
!وأحاول أن أكون رئيسة جيّدة

216
00:14:01,950 --> 00:14:05,100
!لا تقلقي. أنتِ رائعة بالفعل

217
00:14:05,100 --> 00:14:06,630
!ها أنا ذي

218
00:14:06,630 --> 00:14:07,860
أكاني-سان؟

219
00:14:07,860 --> 00:14:09,100
!هيكاري-سان أيضاً؟

220
00:14:10,590 --> 00:14:12,070
!رائع

221
00:14:12,630 --> 00:14:16,720
كعكة خاصّة لميسومي ناغيسا
!ويوكيشيرو هونوكا

222
00:14:17,270 --> 00:14:20,480
!أكاني-سان وأنا عملنا بجدٍّ عليه

223
00:14:21,470 --> 00:14:23,060
!شكراً جزيلاً

224
00:14:24,870 --> 00:14:27,060
!أحضرنا الكثير من التّاكوياكي أيضاً

225
00:14:27,060 --> 00:14:29,520
!لا أطيق الانتظار! لنبدأ في الأكل

226
00:14:29,520 --> 00:14:32,890
!أوّلاً لنلتقط صورة مع الكعكة

227
00:14:40,290 --> 00:14:42,010
ما خطبكن جميعاً؟

228
00:14:47,030 --> 00:14:48,980
!عرفتُ بأنّهم هم

229
00:15:11,450 --> 00:15:14,270
لنبدأ درسنا الخاصّ

230
00:15:16,800 --> 00:15:18,600
!تحوّلي، ميبّو

231
00:15:25,530 --> 00:15:27,670
!موجة الشّفق الثنائيّة

232
00:15:45,660 --> 00:15:48,360
!مبعوثة النُّور، كيور بلاك

233
00:15:48,360 --> 00:15:51,360
!مبعوثة النُّور، كيور وايت

234
00:15:53,530 --> 00:15:55,300
!سوية، نحن بريكيور

235
00:15:56,730 --> 00:15:58,870
...يا خدم قوّة الظّلام

236
00:15:59,940 --> 00:16:02,170
!عودوا من حيث أتيتم

237
00:16:04,810 --> 00:16:06,210
!لومينوس

238
00:16:06,510 --> 00:16:08,730
!السّيل اللّامع

239
00:16:22,820 --> 00:16:25,460
!شرارة الحياة، لومينوس اللّامِعة

240
00:16:27,400 --> 00:16:29,770
!قلب النُّور وإرادة النُّور

241
00:16:30,130 --> 00:16:32,300
!لتوحيدهم جميعاً

242
00:17:02,260 --> 00:17:04,670
!لن تهزمنا قوّةُ الظّلام

243
00:17:29,630 --> 00:17:30,890
!لومينوس

244
00:17:41,940 --> 00:17:43,890
حياة الملِكة

245
00:17:43,890 --> 00:17:46,310
...إذا دمّرتُها هنا

246
00:18:11,170 --> 00:18:12,330
!لومينوس

247
00:18:29,690 --> 00:18:31,550
!النُّور سيُضيء المستقبل، لولو

248
00:18:41,960 --> 00:18:44,280
املأ عيوننا بالأمل

249
00:18:44,900 --> 00:18:47,770
!ضع قوّة الأمل بين أيدينا

250
00:19:17,670 --> 00:19:20,750
!ماذا تفعل؟ اسحقهن

251
00:19:23,540 --> 00:19:24,400
وايت؟

252
00:19:24,400 --> 00:19:25,140
!حسناً

253
00:19:26,310 --> 00:19:28,040
!الرّعد الأسود

254
00:19:28,540 --> 00:19:30,380
!الرّعد الأبيض

255
00:19:36,250 --> 00:19:39,350
...روحا بريكيور الجميلتان

256
00:19:39,560 --> 00:19:42,190
!ستقهران القلوبَ الشرّيرة...

257
00:19:42,920 --> 00:19:45,160
...اللّولب الرُّخامي بريكيور

258
00:19:49,460 --> 00:19:51,060
!ماكس

259
00:19:56,800 --> 00:19:58,520
!سأوقفها هذه المرّة

260
00:20:06,420 --> 00:20:07,770
!شرارة

261
00:20:32,540 --> 00:20:34,090
!فتيات نادي العلوم

262
00:20:34,090 --> 00:20:35,610
!الكعكة والتّاكوياكي

263
00:20:35,780 --> 00:20:38,860
!القائدة ميسومي، شكراً لكِ

264
00:20:41,540 --> 00:20:44,670
!الرّئيسة يوكيشيرو، شكراً لكِ

265
00:20:52,430 --> 00:20:54,590
!شكراً للجميع

266
00:20:56,030 --> 00:20:57,560
!لنلتقط صورة

267
00:20:58,770 --> 00:21:01,550
!حسناً! ابتسمنَ

268
00:21:06,810 --> 00:21:10,170
أنا متأكّدة بأنّ الأمور على وشك
،أن تصبح حافلة بالأحداث

269
00:21:10,170 --> 00:21:14,670
لكن آمل أن تتذكّرن مشاعركن المُتّقدة
!وقلوبكن المُحِبّة

270
00:21:14,670 --> 00:21:16,400
!أجل، يراودني نفس الشُّعور

271
00:21:16,400 --> 00:21:19,040
!حسناً، حريّ بي أن أدخل التشيريكت

272
00:21:19,040 --> 00:21:20,440
!بالطّبع

273
00:21:23,690 --> 00:21:26,320
...أنا قلقة بشأن كلمة "حافلة بالأحداث" تلك

274
00:21:30,800 --> 00:21:31,630
!هيكاري

275
00:21:31,630 --> 00:21:32,520
هيكاري-سان؟

276
00:21:34,600 --> 00:21:36,860
هيكاري! هل أنتِ بخير، بوبّو؟

277
00:21:41,540 --> 00:21:43,570
أنا بخير. لا شيء

278
00:21:43,980 --> 00:21:46,410
أنا فقط... مُتعبة قليلاً

279
00:21:50,790 --> 00:21:53,080
لكن ماذا كان ذلك الشّيء؟

280
00:21:55,550 --> 00:21:59,910
بدا مختلفاً عن قوّة الظّلام
الّتي واجهناها في الماضي

281
00:21:59,910 --> 00:22:02,050
لا بدَّ أنّه هو

282
00:22:04,230 --> 00:22:07,490
ثمّة أمر يحدث له

283
00:23:57,710 --> 00:23:59,530
وقتنا كتلميذات مدرسة إعداديّة
!شارف على الانتهاء

284
00:23:59,530 --> 00:24:02,440
!لنستمتع به بكلّ كياننا
...أو هذا ما كنتُ لأودّ قوله

285
00:24:02,440 --> 00:24:04,750
!لكن قوّة الظّلام تزداد حدّة

286
00:24:04,750 --> 00:24:06,440
...وأنا قلقة على هيكاري-سان

287
00:24:06,440 --> 00:24:07,680
ماذا؟ أين هيكاري؟

288
00:24:07,680 --> 00:24:09,110
...كانت هناك قبل لحظات

289
00:24:09,110 --> 00:24:10,810
!هيكاري-سان... اختفت؟

290
00:24:11,660 --> 00:24:13,380
:نحن بريكيور ماكس هارت

291
00:24:13,660 --> 00:24:16,200
!اليوم الّذي اختفى فيه النُّور
!اليوم الّذي بحثنا فيه عن الغد

292
00:24:16,200 --> 00:24:18,790
...لا أعلم ما الّذي سيحدث في المستقبل. لكن

293
00:24:18,790 --> 00:24:20,360
!لن نخسر أمام قوّة الظّلام

294
00:24:20,800 --> 00:24:22,460
!سوف نصنع مستقبلنا الخاص