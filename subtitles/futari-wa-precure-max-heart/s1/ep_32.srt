1
00:00:17,510 --> 00:00:20,260
ماذا؟ ستستخدمين هذه الصّورة؟

2
00:00:20,580 --> 00:00:22,770
!!إنّها تسديدة العودة لتحقيق النّصر

3
00:00:22,770 --> 00:00:25,420
!إنّها أفضل مقالة في فيروني تايمز

4
00:00:25,420 --> 00:00:27,020
رائع، صحيح، صحيح، صحيح؟

5
00:00:27,020 --> 00:00:28,670
ألم تكن هناك واحدة أفضل؟

6
00:00:28,670 --> 00:00:31,610
آسفة، كان ذلك الخيار الوحيد

7
00:00:31,610 --> 00:00:33,930
شيهو، هل وجدتِ شيئاً لمقالة؟

8
00:00:33,930 --> 00:00:36,490
هل يمكننا استخدام المعلومات
العامّة من هنا؟

9
00:00:36,490 --> 00:00:38,760
!أجل، هذا ما أعتقده

10
00:00:38,760 --> 00:00:41,230
ما أخبار مقالتكِ يا ناغيسا؟

11
00:00:41,600 --> 00:00:42,990
مقالتي؟

12
00:00:43,150 --> 00:00:45,240
...لحظة، لا تقولي لي

13
00:00:45,240 --> 00:00:48,000
!تعملين على "بسمات الحيّ" في هذا الأسبوع

14
00:00:48,000 --> 00:00:52,720
قلتِ أنّ بمقدوركِ تولّي الصّفحة الخاصّة
!بالبسمات الرّائعة حول البلدة

15
00:00:52,720 --> 00:00:54,560
حـ-حقّاً؟

16
00:00:55,980 --> 00:00:59,040
...لا تقولي لي، لا تقولي لي، لا تقولي لي
أنّكِ لم تبدئي؟

17
00:00:59,040 --> 00:01:01,490
!ستكون الأمور على ما يُرام

18
00:01:01,490 --> 00:01:03,010
!اعتمدي عليّ فحسب

19
00:01:03,010 --> 00:01:05,610
بسمات الحيّ

20
00:01:03,920 --> 00:01:05,610
هذه الصّفحة؟

21
00:01:05,610 --> 00:01:08,590
!لا، لا، لا! سيُداهمنا الوقت

22
00:01:08,590 --> 00:01:10,410
!الموعد النّهائي هو غداً

23
00:01:11,600 --> 00:01:14,050
!غداً؟

24
00:02:34,180 --> 00:02:37,380
ماذا؟ بسمات رائعة من حول البلدة؟

25
00:02:37,380 --> 00:02:40,250
أقصد تلك الصّفحة الأسبوعيّة
في صحيفة المدرسة

26
00:02:40,250 --> 00:02:43,160
نحن مُكلَّفون بواجب تحريريّ في هذا
الأسبوع، هل نسيتِ؟

27
00:02:43,160 --> 00:02:45,770
...ومع ذلك، ومع ذلك، ومع ذلك

28
00:02:45,770 --> 00:02:47,560
ومع ذلك... ماذا؟

29
00:02:47,560 --> 00:02:48,740
ما الأمر؟

30
00:02:48,930 --> 00:02:53,070
كانت ناغيسا مسؤولة عن صفحة
...بسمات الحيّ، لكن

31
00:02:53,070 --> 00:02:55,330
!لم تبدأ بعد حتّى

32
00:02:55,330 --> 00:02:56,720
!هونوكا، أرجوكِ

33
00:02:57,940 --> 00:02:59,490
ترجوني ماذا؟

34
00:02:59,490 --> 00:03:01,740
معلوماتكِ وافرة، أليس كذلك؟

35
00:03:01,740 --> 00:03:02,840
!ساعديني هنا

36
00:03:02,840 --> 00:03:05,040
سنتولّى البحث كلّه

37
00:03:05,040 --> 00:03:06,790
!أرجوكِ، أرجوكِ، أرجوكِ

38
00:03:06,790 --> 00:03:10,520
صدّقنَني... لا يخطر على ذهني
شيء مُحدّد فجأة

39
00:03:10,520 --> 00:03:13,690
هونوكا. الشّاي جاهز

40
00:03:13,690 --> 00:03:14,800
!شكراً لكِ

41
00:03:14,800 --> 00:03:16,700
!شكراً لكِ يا جدّتي

42
00:03:16,700 --> 00:03:18,660
لدينا دانغو أيضاً

43
00:03:18,660 --> 00:03:19,840
تفضّلن

44
00:03:20,590 --> 00:03:22,770
إنّها من ميتويا، أليس كذلك؟

45
00:03:22,770 --> 00:03:25,670
!تلك الّتي من هذا المحلّ لذيذة جدّاً

46
00:03:25,670 --> 00:03:27,580
!لنأكل

47
00:03:27,580 --> 00:03:30,040
كُلن ولا تتردّدن جميعاً

48
00:03:30,040 --> 00:03:31,200
!شكراً

49
00:03:31,200 --> 00:03:32,600
!لنأكل

50
00:03:35,510 --> 00:03:37,250
شهيّ، صحيح؟

51
00:03:37,250 --> 00:03:39,380
!لذيذ، لذيذ، لذيذ

52
00:03:39,810 --> 00:03:41,610
!أنا سعيدة لغاية

53
00:03:41,610 --> 00:03:47,200
هونوكا أحبّت دانغو ميتويا منذ كانت طفلة

54
00:03:48,090 --> 00:03:52,420
.ليس الدّانغو الخاص فحسب
الأنميتسو لديهم شهيّ أيضاً

55
00:03:52,420 --> 00:03:55,630
والمالكة لطيفة

56
00:03:56,170 --> 00:03:58,030
أجل، أجل

57
00:03:58,030 --> 00:04:00,400
،عندما ذهبتُ لشراء دانغو منها اليوم

58
00:04:00,400 --> 00:04:05,440
كانت مُحاطة بأطفال الحيّ وترتسم
في وجوههم بسمات جميلة

59
00:04:06,440 --> 00:04:08,840
ماذا؟ هل من مشكلة؟

60
00:04:08,840 --> 00:04:10,110
بسمات جميلة؟

61
00:04:10,110 --> 00:04:13,210
!أجل، بسمات رائعة بحقّ

62
00:04:13,210 --> 00:04:15,010
!هذه هي! سنعتمد ميتويا

63
00:04:15,010 --> 00:04:16,630
ماذا تقصدين يا هونوكا؟

64
00:04:16,820 --> 00:04:19,600
!شكراً يا جدّتي

65
00:04:19,600 --> 00:04:22,120
!سنغادر لإجراء بحث من أجل مقالة صحيفة

66
00:04:22,120 --> 00:04:23,570
!شكراً على الطّعام

67
00:04:23,740 --> 00:04:25,490
يا إلهي

68
00:04:25,490 --> 00:04:27,540
إنّهن مشغولات

69
00:04:30,460 --> 00:04:34,370
!احمِها من الظّلام
!البسمة الأغلى في العالم

70
00:04:43,890 --> 00:04:47,450
!دانغو! دانغو! تبدو لذيذة

71
00:04:47,450 --> 00:04:48,920
اصبري قليلاً فحسب

72
00:04:48,920 --> 00:04:49,630
!حسناً

73
00:04:49,820 --> 00:04:51,350
ها هي ذي

74
00:04:51,350 --> 00:04:53,260
تمّ شيّها

75
00:04:53,260 --> 00:04:55,850
سأضع عليها صلصة لذيذة
،ثمّ أحضرها إليكما

76
00:04:55,850 --> 00:04:57,600
لذا اجلسا وانتظرا

77
00:04:57,600 --> 00:04:58,620
!حسناً

78
00:04:58,620 --> 00:05:00,500
!دانغو! دانغو

79
00:05:00,930 --> 00:05:03,130
أجل، أجل

80
00:05:03,530 --> 00:05:05,500
هيّا. اجلسي

81
00:05:07,840 --> 00:05:10,070
!انظري! هذا هو ميتويا

82
00:05:10,070 --> 00:05:11,240
هذا هو المكان إذاً؟

83
00:05:11,240 --> 00:05:13,370
!يبدو طعامه لذيذاً، لذيذاً، لذيذاً

84
00:05:13,370 --> 00:05:15,580
!ثمّة شيء يبعث على الحنين فيه

85
00:05:15,580 --> 00:05:17,740
تفضّلا

86
00:05:17,740 --> 00:05:19,920
!دانغو! دانغو

87
00:05:19,920 --> 00:05:21,910
!إنّه ساخن، لذا توخّيا الحذر

88
00:05:21,910 --> 00:05:23,160
!حسناً

89
00:05:24,590 --> 00:05:25,880
!ساخن جدّاً

90
00:05:25,880 --> 00:05:27,560
لا تستعجلي

91
00:05:27,560 --> 00:05:31,530
!انفخا عليه ثلاث مرّات قبل قبل العضّ

92
00:05:35,630 --> 00:05:37,920
!أجل، هكذا

93
00:05:37,920 --> 00:05:39,310
أحسنتما

94
00:05:39,310 --> 00:05:41,570
!رائع، رائع، رائع

95
00:05:43,580 --> 00:05:45,570
!يا له من مشهد رائع

96
00:05:45,570 --> 00:05:48,940
!أجل! إنّه مثاليّ لبسمات الحيّ

97
00:05:48,940 --> 00:05:50,380
!هيّا بنا، هيّا بنا، هيّا بنا

98
00:05:50,560 --> 00:05:52,880
!هيّا، كُلا على مهلكما

99
00:05:55,820 --> 00:05:57,500
!سيّدتي

100
00:05:57,500 --> 00:06:01,660
ماذا؟ ابنة يوكيشيرو، هونوكا؟

101
00:06:01,660 --> 00:06:04,660
!شكراً على الدّانغو اللّذيذ قبل مدّة

102
00:06:04,660 --> 00:06:06,660
!كان شهيّاً حقّاً

103
00:06:06,660 --> 00:06:08,630
العفو، الشّكر لكما

104
00:06:08,830 --> 00:06:12,440
وبعد؟ ما السّبب الّذي جعلكن تأتين
جميعاً إلى هنا؟

105
00:06:12,440 --> 00:06:15,400
في الواقع... لدينا طلب صغير

106
00:06:15,400 --> 00:06:17,010
ما هو؟

107
00:06:17,010 --> 00:06:19,710
هل يمكننا كتابة قصّة عنكِ
من أجل صحيفتنا المدرسيّة؟

108
00:06:19,710 --> 00:06:22,920
قصّة؟ حول مطعم الدّانغو الصّغير الخاصّ بي؟

109
00:06:22,920 --> 00:06:23,980
!أجل

110
00:06:23,980 --> 00:06:27,050
ميتويا، موطِن الدّانغو الشّهيّ
!والبسمات الرّائعة

111
00:06:27,050 --> 00:06:28,890
!نريد الكتابة عنه

112
00:06:28,890 --> 00:06:32,360
!يا له من إطراء رائع

113
00:06:32,360 --> 00:06:35,830
من فضلكِ، أيمكننا ذلك يا سيّدتي؟

114
00:06:35,830 --> 00:06:37,390
!دعينا نكتب المقالة

115
00:06:37,390 --> 00:06:38,960
!من فضلكِ

116
00:06:38,960 --> 00:06:43,030
حسناً، حسناً. أظنّني سأقدّم المساعدة

117
00:06:43,030 --> 00:06:44,800
!شكراً جزيلاً لكِ

118
00:06:45,300 --> 00:06:48,500
عند إعداد الدّانغو أوّلاً، نُبخِّر طحين الأرزّ

119
00:06:48,500 --> 00:06:52,040
ثمّ نجعله على شكل لُفافة ونُقطّعه

120
00:06:52,040 --> 00:06:54,670
وبعدها نصنع قطعاً كرويّة بهذا الشّكل

121
00:06:54,670 --> 00:06:57,350
ما هو طحين الأرزّ؟

122
00:06:57,350 --> 00:06:59,850
إنّه أرزّ مسحوق

123
00:07:00,180 --> 00:07:03,820
مذهل! الدّانغو يُصنَع من الأرزّ إذاً؟

124
00:07:03,820 --> 00:07:06,420
يجب تكويرها برفق ورقّة

125
00:07:06,420 --> 00:07:09,450
ثمّ وضعها على سيخ كلّ واحدة على حِدة

126
00:07:09,450 --> 00:07:11,890
لذا لا يجوز أن نستعجل فيها

127
00:07:11,890 --> 00:07:14,660
تحضّرينها بمفردكِ كلّ يوم؟

128
00:07:14,660 --> 00:07:17,630
أجل. بمفردي

129
00:07:17,630 --> 00:07:19,160
!لا بدّ أنّ هذا صعب

130
00:07:19,160 --> 00:07:22,770
سمعتُ أنَّ هناك آلات تصنع
...الدّانغو في هذه الأيّام

131
00:07:22,770 --> 00:07:26,380
أجل، وتلك الآلات لطيفة
على طريقتها الخاصّة

132
00:07:26,380 --> 00:07:29,640
لكن أحبُّ هذه الطّريقة أكثر

133
00:07:29,640 --> 00:07:34,910
لأنّني أكرّس قلبي وروحي في كلّ واحدة

134
00:07:34,910 --> 00:07:37,850
"وأغرس فيها صلاتي، "كوني سعيدة، كوني سعيدة

135
00:07:37,850 --> 00:07:42,830
ثمّ أراقب الزّبائن وهم يأكلونها
فترتسم ابتسامة في محياهم

136
00:07:42,830 --> 00:07:47,430
ليُشكّل ذلك مصدر سعادة غامرة لي

137
00:07:47,890 --> 00:07:50,770
مُجرّد مشاهدتهم تُسعدكِ

138
00:07:51,000 --> 00:07:53,470
!لا بدّ أنّه توجد كثير من البسمات حولنا

139
00:07:53,470 --> 00:07:55,230
تماماً

140
00:07:55,230 --> 00:07:58,440
أحبُّ رؤية الكثير من الابتسامات

141
00:07:58,440 --> 00:08:00,410
!بسمة الحيّ

142
00:08:00,410 --> 00:08:02,410
!هذا ما أردناه حرفياً

143
00:08:08,680 --> 00:08:11,120
!أعتقد سنكتب مقالة رائعة عن هذا

144
00:08:11,120 --> 00:08:12,580
يسرّني أن أكون نافعة

145
00:08:12,580 --> 00:08:13,950
!دانغو من فضلكِ

146
00:08:13,950 --> 00:08:15,350
!قادمة

147
00:08:15,660 --> 00:08:17,590
!هيكاري

148
00:08:17,590 --> 00:08:18,560
!هيكاري-سان

149
00:08:19,060 --> 00:08:21,530
ناغيسا-سان؟ هونوكا-سان؟

150
00:08:24,860 --> 00:08:28,730
لم أكن أعلمل أنَّ أكاني-سان
!من مُعجبات ميتويا أيضاً

151
00:08:28,730 --> 00:08:32,510
قالت بأنّها تشتهي الدّانغو هنا أحياناً

152
00:08:32,510 --> 00:08:35,980
!هذه أكاني-سان الّتي نعرفها! ذوّاقة حقيقيّة

153
00:08:35,980 --> 00:08:38,490
!رائع، رائع، رائع

154
00:08:38,490 --> 00:08:40,920
!أظنّني سأصبح مُعجبة أيضاً

155
00:08:40,920 --> 00:08:43,380
!أستطيع أكل هذا دون ملل

156
00:08:44,080 --> 00:08:46,690
!يجب أن نزور هذا المكان دائماً

157
00:08:46,690 --> 00:08:50,320
شكراً لكِ على استضافتنا اليوم يا سيّدتي

158
00:08:50,320 --> 00:08:52,660
على الرّحب والسّعة

159
00:08:52,660 --> 00:08:54,630
ستكون مقالة ممتازة

160
00:08:54,630 --> 00:08:57,700
!أنا مُعجبة الآن أيضاً، لذا سوف أعود

161
00:08:57,700 --> 00:08:59,770
أشكركِ

162
00:08:59,770 --> 00:09:03,670
...يسرّني سماع ذلك، لكن

163
00:09:04,740 --> 00:09:06,340
...الحقيقة هي

164
00:09:06,340 --> 00:09:10,210
كنتُ أفكّر في إغلاق المطعم

165
00:09:10,210 --> 00:09:11,950
إغلاق المطعم؟

166
00:09:12,180 --> 00:09:15,750
،كنتُن مُستمتعات بالحديث عن المقالة

167
00:09:15,750 --> 00:09:17,980
،لذا لم أرد إفساد الأمر

168
00:09:17,980 --> 00:09:20,420
...لكن لم يعُد يأتينا كثير من الزّبائن مؤخّراً

169
00:09:20,420 --> 00:09:22,220
!مستحيل، مستحيل، مستحيل

170
00:09:22,220 --> 00:09:24,870
!لكن الدّانغو عندكِ لذيذ

171
00:09:24,870 --> 00:09:26,260
ستتوقّفين عن مُمارسة هذا العمل؟

172
00:09:26,790 --> 00:09:28,230
...سيّدتي

173
00:09:28,230 --> 00:09:30,760
وأنا أكبر في العمر أيضاً

174
00:09:30,760 --> 00:09:33,200
تفضّلي. شكراً لزيارتكِ

175
00:09:34,030 --> 00:09:37,170
هل... ستغلقين حقّاً؟

176
00:09:37,170 --> 00:09:38,640
...في الحقيقة

177
00:09:38,640 --> 00:09:43,140
أردتُ الاستمرار في افتتاحه
،ما دام يُسعد النّاس

178
00:09:43,380 --> 00:09:46,180
،لكن عائلة ابني قلقة بشأني

179
00:09:46,180 --> 00:09:50,020
وأعتقد أنّ الوقت قد حان للتوقُّف

180
00:09:50,580 --> 00:09:52,580
،بما أنّني أكبر في العمر

181
00:09:52,580 --> 00:09:56,120
،يريدني أن أعيش معهم

182
00:09:56,120 --> 00:09:57,890
لذا اتّخذتُ قراري

183
00:09:58,290 --> 00:10:00,490
حقّاً؟

184
00:10:01,530 --> 00:10:03,630
أنا آسفة جدّاً

185
00:10:06,430 --> 00:10:07,800
!انظرن، انظرن، انظرن

186
00:10:07,800 --> 00:10:10,640
ألم ألتقط صورة رائعة لها؟

187
00:10:10,640 --> 00:10:14,140
لكن لا أصدِّق بأنّها ستتوقّف عن إعداد
...ذلك الدّانغو الشّهيّ

188
00:10:14,140 --> 00:10:16,610
هذا مُحزِن بعض الشّيء

189
00:10:17,110 --> 00:10:20,110
حسناً، مجرّد جلوسنا هنا نشعر
!بالحزن لن يُوصلنا إلى نتيجة

190
00:10:20,110 --> 00:10:25,680
لنكتب مقالة ممتازة ونخبر الكثير
!من النّاس عن ميتويا

191
00:10:25,890 --> 00:10:30,490
لنحرص على أن يرى مزيد من النّاس
!ابتسامتها المُذهلة

192
00:10:30,690 --> 00:10:34,090
،ثمّ ما دامت تُحافظ على بقاء المطعم

193
00:10:34,090 --> 00:10:39,930
يمكننا إيصال تلك الابتسامة المُذهلة
!إلى أكبر قدر مُمكن من النّاس

194
00:10:39,930 --> 00:10:41,560
!أجل! لنفعلها

195
00:10:41,770 --> 00:10:44,530
!أنا من سيكتب المقالة

196
00:10:44,530 --> 00:10:45,970
هونوكا؟

197
00:10:45,970 --> 00:10:47,500
!لكن تاريخ تسليمها غداً

198
00:10:48,970 --> 00:10:50,470
!لا مُشكلة

199
00:11:03,420 --> 00:11:05,720
هونوكا. ألن تنامي بعد، مِيبّو؟

200
00:11:06,060 --> 00:11:08,400
نامي أنتِ يا مِيبّل

201
00:11:08,400 --> 00:11:11,190
عليّ إنهاء هذا قبل الخلود إلى النّوم

202
00:11:11,190 --> 00:11:14,800
...لا تضغطي على نفسكِ كثيراً، مِيبّو

203
00:11:47,330 --> 00:11:48,830
!انظري، انظري، انظري

204
00:11:48,830 --> 00:11:51,640
أليست صورة يوشيمي-سينسي هذه
!مُثيرة فوق العادة؟

205
00:11:51,640 --> 00:11:55,410
!لا عليكِ! لا بدّ من جذب القُرّاء

206
00:11:55,410 --> 00:11:56,570
!أجل، أجل، أجل

207
00:11:56,880 --> 00:11:59,040
!فعلناها بفضلكِ

208
00:11:59,040 --> 00:12:01,650
هذا لأنّه كان لِزاماً عليّ كتابتها

209
00:12:01,650 --> 00:12:04,550
بسمات الحيّ... تحوّلَتْ إلى مقالة عظيمة

210
00:12:04,730 --> 00:12:07,310
!من الواضح كم اعتنيتِ بها

211
00:12:11,190 --> 00:12:13,150
صانعة دانغو مع بسمة رائعة

212
00:12:13,490 --> 00:12:16,860
تُدير مطعماً صغيراً، من النّوع
،الّذي يتواجد في كلّ بلدة

213
00:12:16,860 --> 00:12:21,070
لكن أشعر وكأنّني ترعرعتُ مع ميتويا

214
00:12:21,500 --> 00:12:24,540
عندما أحزن، عندما أشعر بالإحباط

215
00:12:24,540 --> 00:12:27,300
فإنّني آكل دانغو ميتويا اللّذيذ

216
00:12:27,300 --> 00:12:29,810
،والّذي يُشعرني بالدّفء دوماً

217
00:12:29,810 --> 00:12:31,840
،ويُبدِّد همومي

218
00:12:31,840 --> 00:12:34,680
ويبثّ الرّاحة في قلبي

219
00:12:34,680 --> 00:12:36,750
"لا جدوى من العبوس"

220
00:12:36,750 --> 00:12:39,820
"!عاود المُحاولة غداً فحسب"

221
00:12:40,190 --> 00:12:42,620
،لم أعرف ماذا كان سبب ذلك

222
00:12:42,620 --> 00:12:44,860
لكن عندما خرجتُ إلى هنا
،لكتابة هذه المقالة

223
00:12:44,860 --> 00:12:47,690
أدركتُ الأمر أخيراً

224
00:12:47,690 --> 00:12:54,370
مذاق دانغو ميتويا يرسم البسمة
ويجذب المشاعر اللّطيفة

225
00:12:54,370 --> 00:12:57,300
!لهذا يُسعد الجميع

226
00:12:57,600 --> 00:13:04,100
لكن قد نخسر مطعم الدّانغو
الرّائع هذا للأبد

227
00:13:04,100 --> 00:13:07,570
أخبرتنا المالكة بأنّها قد تُغلق المطعم

228
00:13:08,310 --> 00:13:11,240
لا أعلم إلى متى سأتمكّن من التمتُّع

229
00:13:11,240 --> 00:13:14,450
...ببسمتها الرّائعة والدّانغو الشّهيّ الخاصّ بها

230
00:13:14,450 --> 00:13:16,510
لكن شكراً لكِ يا سيّدتي

231
00:13:25,200 --> 00:13:28,100
!حظيت مقالتكِ بتفاعل كبير

232
00:13:28,100 --> 00:13:30,700
!أعتقد هناك الكثير من المُعجبين بميتويا

233
00:13:30,700 --> 00:13:32,700
كانت أكاني-سان حزينة بشأن ذلك أيضاً

234
00:13:32,700 --> 00:13:35,140
!أريد أكل الدّانغو أيضاً، بوبّو

235
00:13:35,140 --> 00:13:36,900
!اطلب من أومب إذاً فحسب، ميبّو

236
00:13:36,900 --> 00:13:39,370
!أريد دانغو ميتويا، بوبّو

237
00:13:39,370 --> 00:13:40,850
!أنا أيضاً، لولو

238
00:13:40,850 --> 00:13:44,210
عندما تتصرّف بأنانيّة يا بولن، فإنَّ لولون تُقلّدك

239
00:13:47,890 --> 00:13:52,420
في كلّ الأحوال، لنأكل قدر ما نستطيع
!من الدّانغو الخاصّ بميتويا

240
00:13:52,420 --> 00:13:54,420
!ناغيسا

241
00:13:56,390 --> 00:13:58,660
ستُغلقين ميتويا؟

242
00:13:58,660 --> 00:14:01,740
أجل، يغدو الأمر صعباً عليّ

243
00:14:01,740 --> 00:14:02,800
هذا مُؤسف

244
00:14:02,800 --> 00:14:04,190
!ماما! دانغو

245
00:14:04,190 --> 00:14:05,070
اصبر

246
00:14:05,070 --> 00:14:08,400
حسناً، تمّ شيّها بالكامل. تفضّل

247
00:14:08,400 --> 00:14:11,370
!إنّه ساخن، لذا انفخ عليه أوّلاً

248
00:14:11,710 --> 00:14:14,150
!أجل، شكراً على الزّيارة

249
00:14:14,150 --> 00:14:15,710
،الأنميتسو شهيّ أيضاً

250
00:14:15,710 --> 00:14:17,920
!لكن الدّانغو الحلو هو الأفضل

251
00:14:17,920 --> 00:14:19,340
!بالفعل

252
00:14:21,820 --> 00:14:24,180
...لكن هذه خسارة حقيقيّة

253
00:14:24,490 --> 00:14:27,330
...لن نتمكّن من أكل الدّانغو هنا ثانية

254
00:14:27,330 --> 00:14:28,830
سأفتقد له حقّاً

255
00:14:28,830 --> 00:14:30,850
!لا تقولي ذلك يا ناغيسا

256
00:14:31,010 --> 00:14:34,550
قرأتُ مقالتكن قبل قليل

257
00:14:34,550 --> 00:14:35,820
شكراً لكُن

258
00:14:35,820 --> 00:14:39,460
!قضت هونوكا اللّيل كلّه على تلك المقالة

259
00:14:39,680 --> 00:14:45,440
،ظللتُ أستحضر ذكريات من أيّام طفولتي
ولم أستطع التوقُّف

260
00:14:45,440 --> 00:14:46,880
هذا صحيح

261
00:14:46,880 --> 00:14:49,450
كنتِ تأتين إلى هنا طوال الوقت، أليس كذلك؟

262
00:14:49,450 --> 00:14:52,870
إنَّ قراءة مقالتكِ جعلتني أتأمّل كثيراً

263
00:14:53,350 --> 00:14:58,880
إنَّ مجيء الكثير من النّاس إلى هنا
على مدى سنين أسعدني حقّاً

264
00:14:59,490 --> 00:15:05,990
عندما أتيتُن إلى هنا، قلتُ بأنّني أعدُّ الدّانغو
،مُتمنّية السّعادة للآخرين

265
00:15:05,990 --> 00:15:08,380
لكن أعتقد بأنّني كنتُ مُخطئة

266
00:15:08,380 --> 00:15:11,730
كنتُ أنا من يحظى بالسّعادة

267
00:15:12,970 --> 00:15:18,770
مجيء أشخاص أمثالكن وقولهم بأنَّ
الدّانغو الخاصّ بي شهيّ

268
00:15:18,770 --> 00:15:20,430
هو ما أوصلني إلى هذه المرحلة

269
00:15:21,050 --> 00:15:25,480
كنتُ أستمدّ الطّاقة والشّجاعة منكم جميعاً

270
00:15:27,090 --> 00:15:28,410
...سيّدتي

271
00:15:28,920 --> 00:15:32,880
تلقّيتُ الطّاقة للاستمرار في شيّ الدّانغو

272
00:15:32,880 --> 00:15:35,350
والشّجاعة لمُواصلة العيش

273
00:15:35,660 --> 00:15:40,090
من كافّة الزّبائن الّذين أكلوا الدّانغو خاصّتي

274
00:15:43,600 --> 00:15:45,190
!حضور شرّير، ميبّو

275
00:15:49,600 --> 00:15:51,100
!هذا ليس آمناً، مِيبّو

276
00:15:51,100 --> 00:15:53,150
!إنّهم هم من جديد

277
00:15:55,380 --> 00:15:57,540
فالديس قد عاد

278
00:15:58,120 --> 00:16:02,730
قال بأنّه كان يتعافى من انغماسه
في ظلام ملِك الشرّ العميق

279
00:16:02,730 --> 00:16:04,140
ملِك الشرّ؟

280
00:16:04,490 --> 00:16:07,110
لديّ سؤال لكُن

281
00:16:07,330 --> 00:16:12,120
ماذا كانت الفائدة من كلّ تغيّركن ونموّكن؟

282
00:16:12,120 --> 00:16:17,090
وما علاقة الأمر بالتغيُّر الّذي يطرأ فينا؟

283
00:16:17,090 --> 00:16:20,030
!ما أدرانا نحن؟

284
00:16:20,030 --> 00:16:23,500
إن كان هناك أي رابط بيننا، فهو رفضنا

285
00:16:23,500 --> 00:16:27,110
!للسّماح لكم بعرقلة ابتسامات الجميع

286
00:16:30,580 --> 00:16:33,450
أنتنّ عقبة بالفعل إذاً

287
00:16:33,450 --> 00:16:36,010
!لا حاجة لكُن إذاً. زاكينّا

288
00:16:45,920 --> 00:16:47,890
!هذا ساخن، بوبّو

289
00:16:50,340 --> 00:16:51,660
...ناغيسا

290
00:16:52,000 --> 00:16:53,620
!هونوكا. هيّا بنا

291
00:17:01,360 --> 00:17:03,830
!موجة الشّفق الثنائيّة

292
00:17:13,840 --> 00:17:16,610
!مبعوثة النُّور، كيور بلاك

293
00:17:17,280 --> 00:17:20,080
!مبعوثة النُّور، كيور وايت

294
00:17:21,970 --> 00:17:24,020
!سوية، نحن بريكيور

295
00:17:25,300 --> 00:17:27,590
...يا خدم قوّة الظّلام

296
00:17:28,270 --> 00:17:30,890
!عودوا من حيث أتيتم

297
00:17:35,360 --> 00:17:36,880
!وايت

298
00:17:36,880 --> 00:17:38,070
!أنا بخير

299
00:17:38,070 --> 00:17:39,620
!هنا

300
00:17:48,190 --> 00:17:49,810
...ما الّذي

301
00:17:50,550 --> 00:17:51,310
!بلاك

302
00:17:51,900 --> 00:17:53,470
!لا أستطيع لمسه حتّى

303
00:17:53,470 --> 00:17:54,650
ماذا نفعل؟

304
00:17:54,650 --> 00:17:56,000
!لا أدري

305
00:17:57,620 --> 00:17:58,420
!إنّه قادم

306
00:17:59,720 --> 00:18:01,070
!احذري

307
00:18:14,290 --> 00:18:16,470
!بريكيور في خطر، بوبّو

308
00:18:16,470 --> 00:18:17,940
!بولن

309
00:18:20,460 --> 00:18:22,120
!لومينوس

310
00:18:22,120 --> 00:18:24,860
!السّيل اللّامِع

311
00:18:36,940 --> 00:18:39,630
!شرارة الحياة، لومينوس اللّامِعة

312
00:18:41,310 --> 00:18:43,930
!قلب النُّور وإرادة النُّور

313
00:18:43,930 --> 00:18:46,470
!لتوحيدهم جميعاً

314
00:19:05,080 --> 00:19:06,390
!لومينوس

315
00:19:06,610 --> 00:19:08,950
كفى مقاومة عقيمة

316
00:19:14,680 --> 00:19:16,660
!كوني حذرة يا لومينوس

317
00:19:16,660 --> 00:19:18,130
!حـ-حسناً

318
00:19:27,630 --> 00:19:29,060
ماذا نفعل يا وايت؟

319
00:19:30,280 --> 00:19:32,540
!دعه يحرقكن فحسب

320
00:19:33,200 --> 00:19:34,990
!لن أسمح لكِ بفعل ذلك

321
00:19:34,990 --> 00:19:37,960
!لن ندعكِ تدمّرين عالمنا

322
00:19:37,960 --> 00:19:40,920
!سوف نحمي بسمات الجميع

323
00:19:43,890 --> 00:19:45,860
!اعملنَ معاً، بوبّو

324
00:19:51,180 --> 00:19:52,800
!الشّجاعة الفيّاضة

325
00:19:54,700 --> 00:19:56,130
!الأمل الغامِر

326
00:19:56,590 --> 00:19:59,100
!والرّوابط المُشعّة بالنُّور

327
00:20:00,000 --> 00:20:01,810
...إكستريم

328
00:20:01,810 --> 00:20:03,670
!لوميناريو

329
00:20:27,320 --> 00:20:29,290
!اثنتان من الدّانغو الحلوة لو سمحتِ

330
00:20:29,290 --> 00:20:31,990
!أجل، ها أنا ذي

331
00:20:31,990 --> 00:20:34,430
سأشويها حالاً. انتظرا فحسب

332
00:20:34,430 --> 00:20:36,730
!أربعة أسياخ دانغو إضافيّة رجاء

333
00:20:36,730 --> 00:20:37,940
حسناً، حسناً

334
00:20:37,940 --> 00:20:40,410
!حسناً، تفضّلوا

335
00:20:40,410 --> 00:20:41,930
شكراً لكِ

336
00:20:41,930 --> 00:20:43,380
!شكراً على الزّيارة

337
00:20:43,380 --> 00:20:45,400
!يأتينا كثير من الزّبائن

338
00:20:45,400 --> 00:20:46,850
!طلب لو سمحتِ

339
00:20:46,850 --> 00:20:47,650
!قادمة

340
00:20:47,650 --> 00:20:50,310
!وجبتا دانغو إضافيّتان لو سمحتِ

341
00:20:50,310 --> 00:20:52,120
!شكراً

342
00:20:52,120 --> 00:20:54,920
مهلاً! ما زلتُما تأكلان؟

343
00:20:54,920 --> 00:20:57,520
!لا يجوز أن تتكلّمي مع الزّبائن بهذه الطّريقة

344
00:20:57,520 --> 00:21:00,400
!أجل، أجل، أجل! وجبتا دانغو لو سمحتِ

345
00:21:00,400 --> 00:21:03,860
فهمت. طبقا دانغو إذاً

346
00:21:04,390 --> 00:21:06,370
!ومزيد من الشّاي أيضاً، رجاء

347
00:21:07,590 --> 00:21:09,340
!على الفور

348
00:21:09,340 --> 00:21:12,100
إنّه لذيذ حقّاً

349
00:21:12,100 --> 00:21:13,760
!لا سيّما من المشواة مباشرة

350
00:21:13,760 --> 00:21:16,030
وجبتا دانغو لو سمحتِ

351
00:21:16,030 --> 00:21:17,800
رينا وشيهو... بئساً لهما

352
00:21:17,800 --> 00:21:19,540
تبقيان زوبنتين في النّهاية

353
00:21:19,540 --> 00:21:21,940
وجبتا دانغو لو سمحتِ

354
00:21:21,940 --> 00:21:23,680
!حسناً، شكراً

355
00:21:24,140 --> 00:21:26,170
!العمل يزدهر

356
00:21:26,170 --> 00:21:29,080
بفضل مقالتكِ بالطّبع

357
00:21:29,080 --> 00:21:32,130
جميعهم يراودهم نفس شعوري

358
00:21:34,490 --> 00:21:38,070
ربّما سأبقي المطعم مُفتتِحاً فترة أطول

359
00:21:38,070 --> 00:21:40,030
!هل أنتِ جادّة؟

360
00:21:40,760 --> 00:21:42,570
ستُبقين المطعم مفتوحاً؟

361
00:21:43,030 --> 00:21:46,400
،هناك شجاعة في التوقُّف عن التّفكير

362
00:21:47,040 --> 00:21:50,810
وشجاعة في الاستمرار كذلك

363
00:21:51,340 --> 00:21:54,180
سوف أستخدم السّعادة الّتي منحتُنّني إيّاها

364
00:21:54,710 --> 00:21:57,950
لمُعاودة المُحاولة

365
00:21:58,280 --> 00:21:59,920
...سيّدتي

366
00:21:59,920 --> 00:22:01,120
!مرحى

367
00:22:01,120 --> 00:22:02,220
!أنا مسرورة للغاية

368
00:22:01,880 --> 00:22:03,430
!يحيا ميتويا

369
00:22:03,050 --> 00:22:05,250
!رائع، رائع، رائع

370
00:22:05,250 --> 00:22:07,590
!أريد أكل المزيد من الدّانغو الآن

371
00:22:07,590 --> 00:22:09,230
!ناغيسا

372
00:22:09,230 --> 00:22:13,700
!يا للرّوعة! توجد الكثير من الشّجاعة هنا

373
00:22:13,700 --> 00:22:15,230
!بالفعل

374
00:22:15,230 --> 00:22:17,040
!وكثير من الأمل أيضاً

375
00:22:17,040 --> 00:22:20,330
لنتحلَّ بالشّجاعة ونشقّ طريقنا
!نحو المستقبل

376
00:22:20,330 --> 00:22:22,530
!أجل

377
00:23:57,470 --> 00:23:59,570
!عيد ميلاد سعيد يا ناغيسا

378
00:23:59,570 --> 00:24:00,340
!شكراً

379
00:24:00,340 --> 00:24:02,140
!آمل أن تلتقي بفوجيمورا-كن

380
00:24:02,140 --> 00:24:03,570
...مـ-مهلاً، لا أعتقد

381
00:24:04,190 --> 00:24:06,070
!انظري! ها هو

382
00:24:06,070 --> 00:24:07,630
!فوجيبي-سينباي، طاب يومك

383
00:24:07,630 --> 00:24:09,580
!يبدو وجهك ككُرة قدم

384
00:24:09,580 --> 00:24:10,550
لحظة، ماذا؟

385
00:24:10,550 --> 00:24:12,350
!زاكينّا؟

386
00:24:12,350 --> 00:24:14,350
:نحن بريكيور ماكس هارت

