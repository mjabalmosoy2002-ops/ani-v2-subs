1
00:00:17,960 --> 00:00:22,250
أصابنا هلعٌ شديد بسبب
!فقدان بولن ولولون

2
00:00:39,850 --> 00:00:42,920
لكن يسرّني أنّنا وجدناهما

3
00:00:43,950 --> 00:00:46,870
كانا يعملان بجدّ، على طريقتهما الخاصّة

4
00:00:46,870 --> 00:00:48,810
!كان ذلك لطيفاً

5
00:00:49,250 --> 00:00:54,630
!صباح الخير

6
00:00:54,630 --> 00:00:59,620
هل سيؤدّي صفُّنا مسرحيّةً من جديد
لأجل مهرجان فيروني هذا العام؟

7
00:00:59,620 --> 00:01:02,080
أجل! شيهو، ستكونين المُديرة
من جديد، أليس كذلك؟

8
00:01:02,080 --> 00:01:05,120
!بالطّبع، بالطّبع، بالطّبع
!أريد ذلك بشدّة

9
00:01:05,120 --> 00:01:05,810
...بالإضافة إلى ذلك

10
00:01:05,810 --> 00:01:08,260
!أعرف سلفاً ما أريد فعله

11
00:01:09,050 --> 00:01:09,900
ما الأمر؟

12
00:01:09,900 --> 00:01:12,200
ستكتشفين قريباً

13
00:01:12,200 --> 00:01:14,700
!لكن سيكون أفضل عمل لي

14
00:01:14,700 --> 00:01:17,520
!أريد استخدامه لإثبات نفسي

15
00:01:17,690 --> 00:01:18,990
إثبات نفسكِ؟

16
00:01:18,990 --> 00:01:19,990
...أجل

17
00:01:19,990 --> 00:01:24,340
عندما أخبرتُ والدَي بأنّني أردتُ
،دخول مجال الأفلام

18
00:01:24,340 --> 00:01:27,760
قالا لي أن أعيد النّظر في الأمر

19
00:01:28,230 --> 00:01:31,480
لذا أريد تقديم مسرحيّة رائعة معكن

20
00:01:31,480 --> 00:01:33,070
!وأمنح نفسي الثّقة

21
00:01:33,070 --> 00:01:36,920
!لنعمل بجدّ، بجدّ، بجدّ معاً، اتّفقنا؟

22
00:01:36,920 --> 00:01:39,190
أنتِ مُتحمِّسة جدّاً حيال هذا

23
00:03:07,300 --> 00:03:09,050
!أوشيواكامارو وبينكي؟

24
00:03:09,050 --> 00:03:10,880
!أجل، أجل، أجل

25
00:03:10,880 --> 00:03:15,930
قصّة أوشيواكامارو، والّذي يصبح لاحقاً
،ميناموتو نو يوشيتسوني

26
00:03:15,930 --> 00:03:18,400
...التقى ببينكي في جسر غوجو ثمّ

27
00:03:18,400 --> 00:03:19,840
!هي-يا

28
00:03:19,840 --> 00:03:23,380
ارتأيتُ أنّ بمقدورنا أن نؤدّي
!مشهداً قتاليّاً ضخماً

29
00:03:26,210 --> 00:03:28,030
ماذا؟ لم يُعجبكن؟

30
00:03:28,030 --> 00:03:30,240
،إنّها مُتعلِّقة بالتّاريخ

31
00:03:30,240 --> 00:03:33,180
لذا أظنّها فكرة جيّدة، فماذا عنكن جميعاً؟

32
00:03:33,180 --> 00:03:35,150
!أجل، تبدو مُمتعة

33
00:03:35,150 --> 00:03:38,860
!حقّاً، حقّاً، حقّاً؟ وقد كتبتُ النصّ بالفعل

34
00:03:39,730 --> 00:03:44,050
أوشيواكامارو، الّذي تدرّب تحت جناح
،تينغو جبل كوراما

35
00:03:44,050 --> 00:03:45,680
!رشيق جدّاً

36
00:03:45,680 --> 00:03:48,300
،يراوغ تلويحة من ناغيناتا الخاصّ ببينكي

37
00:03:48,300 --> 00:03:50,400
ويُلامس سور الجسر كما الرّيشة

38
00:03:50,400 --> 00:03:51,420
...ثمّ فجأة

39
00:03:51,420 --> 00:03:56,160
!يقفز من جديد ويهبط عى نصل ناغيناتا

40
00:03:57,550 --> 00:03:59,610
!حسناً؟ حسناً؟ حسناً؟ رائع، صحيح؟

41
00:04:04,220 --> 00:04:08,520
لكن كيف سيهبط شخصٌ على السُّور
!ثمّ يقف على النّصل هكذا؟

42
00:04:08,920 --> 00:04:11,710
!هناك طريقة لفعل ذلك

43
00:04:11,710 --> 00:04:14,510
،نربط الأسلاك بالمُمثّل

44
00:04:14,510 --> 00:04:18,020
!ونجعلهم يتأرجحون كما لو أنّهم يطيرون

45
00:04:18,020 --> 00:04:20,150
!انظرنَ. كما الشّبكة السّلكيّة في الأفلام

46
00:04:20,150 --> 00:04:21,500
!شبكة سلكيّة؟

47
00:04:21,500 --> 00:04:23,970
لكن أليس هذا خطيراً؟

48
00:04:23,970 --> 00:04:25,840
...أجل، هذا مستحيل

49
00:04:25,840 --> 00:04:26,590
أليس كذلك؟

50
00:04:26,590 --> 00:04:27,830
!لا تقلقنَ

51
00:04:27,830 --> 00:04:31,940
سينجح هذا مع المحترفين للحرص
!على سلامة الأمر

52
00:04:31,940 --> 00:04:36,410
حسناً، لكن من هنا سوف يُجازف؟

53
00:04:36,410 --> 00:04:38,700
!صحيح، لن يفعلها أحد

54
00:04:38,700 --> 00:04:40,310
صحيح

55
00:04:40,310 --> 00:04:42,740
،سيكون من الجيّد إذا أراد شخصٌ هنا فعلها

56
00:04:42,740 --> 00:04:44,250
...لكن لا نستطيع إجبار أحد

57
00:04:52,030 --> 00:04:53,230
...حسناً

58
00:04:54,100 --> 00:04:55,630
!سألعب دور أوشيواكامارو

59
00:04:57,800 --> 00:04:59,170
ميسومي-سان؟

60
00:04:59,550 --> 00:05:01,470
سـ-ستفعلين؟

61
00:05:01,810 --> 00:05:05,830
أجل... لأنّكِ عملتِ بجدّ على فكرة، صحيح؟

62
00:05:05,830 --> 00:05:07,940
!أريد أن أعمل بجدٍّ معكِ

63
00:05:09,280 --> 00:05:10,910
!ناغيسا... شكراً لكِ

64
00:05:11,220 --> 00:05:12,150
!هنا

65
00:05:12,150 --> 00:05:13,380
يوكيشيرو-سان؟

66
00:05:13,570 --> 00:05:15,350
!سألعب دور بينكي

67
00:05:17,250 --> 00:05:22,010
أريد مساعدة كوبوتا-سان في تقديم
!مسرحيّة رائعة

68
00:05:22,010 --> 00:05:23,190
...يوكيشيرو-سان

69
00:05:23,190 --> 00:05:26,660
لكن يوكيشيرو-سان لا تُشبه بينكي كثيراً

70
00:05:26,660 --> 00:05:28,840
...أجل... إنّها فعلاً

71
00:05:30,110 --> 00:05:31,620
!مع ذلك أريد تجربة الأمر

72
00:05:31,620 --> 00:05:34,130
!لطالما أردتُ لعِب دور كهذا

73
00:05:34,610 --> 00:05:36,100
...يوكيشيرو-سان

74
00:05:36,100 --> 00:05:40,170
ناغيسا تلعب دور أوشيواكامارو
...ويوكيشيرو-سان تلعب دورَ بينكي

75
00:05:40,170 --> 00:05:42,200
!أتمنّى رؤية ذلك

76
00:05:42,850 --> 00:05:44,080
!لنفعلها جميعاً

77
00:05:44,080 --> 00:05:45,550
...رينا

78
00:05:45,550 --> 00:05:47,550
!سأشارك

79
00:05:47,550 --> 00:05:48,410
!أنا أيضاً

80
00:05:48,410 --> 00:05:49,650
!شكراً للجميع

81
00:05:50,090 --> 00:05:52,950
!وشكراً لكما يا ناغيسا ويوكيشيرو-سان

82
00:06:10,840 --> 00:06:14,410
!سوف أجعلها مُمتعة، مُمتعة، مُمتعة حتماً

83
00:06:14,410 --> 00:06:16,170
!تعالا لمشاهدتها رجاء

84
00:06:16,170 --> 00:06:17,800
أكيد، سنفعل

85
00:06:17,800 --> 00:06:20,040
!هذا وعد! إلى اللّقاء

86
00:06:20,040 --> 00:06:21,380
طاب يومكِ

87
00:06:21,620 --> 00:06:23,350
إنّها مُتحمِّسة جدّاً

88
00:06:23,350 --> 00:06:26,820
لا بدّ أنّها تضغط على نفسها بعد ما حدث

89
00:06:27,430 --> 00:06:28,790
ماذا حدث؟

90
00:06:28,790 --> 00:06:32,260
بعد أن قالت بأنّها أرادت
دخول مجال الأفلام

91
00:06:32,440 --> 00:06:33,620
تقصدين هذا؟

92
00:06:33,620 --> 00:06:36,690
أعتقد مُعارضتك للأمر صدمَها حقّاً

93
00:06:36,690 --> 00:06:38,490
لم أكن مُعارِضاً للأمر

94
00:06:38,490 --> 00:06:40,270
،لكن لا تزال في المدرسة الإعداديّة

95
00:06:40,270 --> 00:06:43,230
لذا أريدها أن تركّز على الدّراسة

96
00:06:49,050 --> 00:06:53,440
أعتقد بأنّ صفّ الكرز سيُقدّم
!مشهداً عظيماً

97
00:06:53,440 --> 00:06:57,880
لنجعله عرضاً ضخماً ليكون محطّ
!أنظار مهرجان فيروني

98
00:06:57,880 --> 00:06:59,180
!عرض ضخم

99
00:06:59,180 --> 00:07:02,650
المهمّ ألّا يتأذّى أحد

100
00:07:02,650 --> 00:07:04,420
!بـ-بالطّبع

101
00:07:04,420 --> 00:07:06,290
!سنكون صارمين جدّاً

102
00:07:06,290 --> 00:07:08,760
!لكن نريده أن يبدو مُمتعاً

103
00:07:09,810 --> 00:07:11,660
!أجل، معك حقّ

104
00:07:11,660 --> 00:07:13,230
!نريده أن يبدو مُمتعاً

105
00:07:13,580 --> 00:07:15,060
...اسمحوا لي أن أعرّفكم

106
00:07:15,060 --> 00:07:19,970
!إنّهم طاقم شبكة سلكيّة مُحترفون

107
00:07:19,970 --> 00:07:21,100
سُررتُ بلقائكم

108
00:07:21,100 --> 00:07:22,730
سُرِرنا بلقائكم أيضاً

109
00:07:22,730 --> 00:07:24,210
لا داعي للقلق

110
00:07:24,400 --> 00:07:28,940
نحرص على الأمان في كلّ مشهد

111
00:07:28,940 --> 00:07:30,680
سنكون حاضرين للتّمرين أيضاً

112
00:07:30,680 --> 00:07:34,920
ونتولّى كلّ المعدّات والتّجهيزات

113
00:07:35,800 --> 00:07:38,890
كان هذا النّوع من التّأثير المسرحيّ
،"يُدعى "تشونوري

114
00:07:38,890 --> 00:07:41,190
!واستخدموه في كابوكي أيضاً

115
00:07:41,190 --> 00:07:44,760
!لكنّه اشتهر كثيراً في أفلام هونغ كونغ

116
00:07:44,760 --> 00:07:47,560
!نراه طوال الوقت في أفلام هوليود الآن أيضاً

117
00:07:47,560 --> 00:07:49,460
!هذه شيهو الّتي عهِدناها
!معلوماتِ غزيرة حول الأمر

118
00:07:49,460 --> 00:07:51,130
!بالتّأكيد، بالتّأكيد، بالتّأكيد

119
00:07:51,130 --> 00:07:56,570
أهمّ شيء هو أن يكون المُمثّل
!والطّاقم مُتزامنين

120
00:07:56,760 --> 00:07:58,200
تماماً

121
00:07:58,200 --> 00:08:01,340
بالمناسبة، أين ناغيسا ويوكيشيرو-سان
على أيّ حال؟

122
00:08:01,340 --> 00:08:02,540
!نحن هنا

123
00:08:10,800 --> 00:08:12,150
!مُفاجأة

124
00:08:12,800 --> 00:08:14,120
!تبدين رائعة يا ناغيسا

125
00:08:14,120 --> 00:08:16,590
!مثاليّ، مثاليّ، مثاليّ
!هذا ما تخيّلتُه تماماً

126
00:08:17,840 --> 00:08:20,130
نحن طاقم الملابس، أنسيتِ؟

127
00:08:20,130 --> 00:08:21,770
!يمكننا تولّي أيّ شيء

128
00:08:21,770 --> 00:08:22,560
صحيح؟

129
00:08:22,560 --> 00:08:25,060
!آسفة، يليق بي أيّ شيء

130
00:08:26,450 --> 00:08:27,900
!ها أنا ذي

131
00:08:31,120 --> 00:08:32,310
كيف أبدو؟

132
00:08:32,310 --> 00:08:33,810
...هـ-هونوكا

133
00:08:34,420 --> 00:08:36,680
!تبدين بينكي ظريفاً جدّاً

134
00:08:37,060 --> 00:08:39,150
!إنّه ثقيل جدّاً

135
00:08:39,430 --> 00:08:42,950
سنحاول تخفيفه! تحمّلي
!اليوم فقط، اتّفقنا؟

136
00:08:42,950 --> 00:08:44,920
حسناً، اخلعي هذا الزيّ

137
00:08:44,920 --> 00:08:47,720
!ماذا؟ لكن ارتديتُه للتو

138
00:08:47,720 --> 00:08:50,760
عليكِ أن ترتدي هذا تحته

139
00:08:50,760 --> 00:08:52,230
ما هذا؟

140
00:08:52,230 --> 00:08:55,930
نريدكِ أن ترتديه وذلك كي تُرفقي
الأسلاك معه

141
00:09:03,440 --> 00:09:05,040
حسناً، المشهد الثّاني

142
00:09:05,040 --> 00:09:08,910
!أوشيواكامارو وبينكي يتقاتلان على جسر غوجو

143
00:09:08,910 --> 00:09:10,880
!نبدأ بعبارة يوكيشيرو-سان! هيّا

144
00:09:10,880 --> 00:09:14,280
أوشيواكامارو، سيكون سيفك هو
سيفي الرّقم ألف

145
00:09:14,280 --> 00:09:15,850
!ضعه أرضاً

146
00:09:15,850 --> 00:09:18,320
!إذا كنت تريده، فمن الأفضل أن تأخذه

147
00:09:18,320 --> 00:09:20,790
...نـ-ناغيسا سيّئة كعادتها

148
00:09:20,790 --> 00:09:23,520
!حسناً إذاً! فلتتذوّق ناغيناتا الخاص بي

149
00:09:29,600 --> 00:09:30,700
!والآن اقفزي

150
00:09:33,320 --> 00:09:34,630
!ا-النّجدة

151
00:09:34,630 --> 00:09:37,040
!أنزلوها، أنزلوها، أنزلوها

152
00:09:50,940 --> 00:09:53,520
هذه الأمور صعبة حقّاً

153
00:09:56,890 --> 00:09:58,860
هل أنتِ بخير يا ناغيسا؟

154
00:09:58,860 --> 00:10:00,390
!أجل، أنا بخير

155
00:10:05,460 --> 00:10:07,730
!تحليق

156
00:10:08,670 --> 00:10:09,770
!فعلَتْها

157
00:10:15,490 --> 00:10:17,640
أجل، لقد فشلت

158
00:10:22,900 --> 00:10:25,480
وبعد؟ هل سنفعلها في الوقت
قبل يوم المهرجان؟

159
00:10:28,840 --> 00:10:32,860
شيهو. أتعتقدين بأنّنا سنُجهّز
كلّ شيء في الوقت؟

160
00:10:32,860 --> 00:10:36,330
لا أدري. سأفكّر في الأمر

161
00:10:36,780 --> 00:10:38,930
!لنأخذ استراحة نصف ساعة

162
00:10:48,560 --> 00:10:49,810
!فعلتُها

163
00:10:51,370 --> 00:10:52,360
...مؤلم

164
00:10:52,360 --> 00:10:54,440
!تعالوا إلى هنا جميعاً

165
00:10:54,730 --> 00:10:56,550
ناغيسا. شكراً جزيلاً

166
00:10:56,550 --> 00:10:59,420
...أقدِّر كلّ الجهود الكبيرة الّتي بذلتِها

167
00:10:59,670 --> 00:11:02,890
لكن لا أعتقد بأنّنا سننجح
،في هذا في الوقت

168
00:11:02,890 --> 00:11:05,430
،ولدينا الكثير لنتمرّن عليه

169
00:11:05,430 --> 00:11:07,360
لذا من الأفضل أن نلغي مسألة الأسلاك

170
00:11:07,360 --> 00:11:08,820
!ماذا؟

171
00:11:10,610 --> 00:11:15,170
لا مُشكلة! ستكون مع ذلك مسرحيّة
رائعة من دونها

172
00:11:15,170 --> 00:11:17,100
!أعلم بأنّ الجميع سيحبّونها

173
00:11:17,520 --> 00:11:20,070
!حسناً، لنبدأ من المشهد الأوّل ثانية

174
00:11:20,690 --> 00:11:24,480
أعتقد أرادت شيهو تلك الأسلاك بشدّة

175
00:11:24,480 --> 00:11:25,910
...أجل

176
00:11:25,910 --> 00:11:29,110
،تحاول أن تبقى إيجابيّة لأجلنا

177
00:11:29,770 --> 00:11:33,050
لكن أنا السّبب في عدم نجاح ذلك

178
00:11:33,050 --> 00:11:35,020
...ناغيسا

179
00:12:12,110 --> 00:12:15,190
!يجلسون في الوسط تماماً

180
00:12:16,290 --> 00:12:18,760
...يا لغرابة الأمر

181
00:12:19,310 --> 00:12:20,730
!فوجيبي-سينباي؟

182
00:12:21,420 --> 00:12:23,200
...و-والآن أنا مُتوتّرة جدّاً

183
00:12:23,200 --> 00:12:25,770
!أنا مُتحمّسة لرؤية كيف ستؤول الأمور

184
00:12:25,770 --> 00:12:27,170
أجل

185
00:12:27,620 --> 00:12:29,780
المُخرجة: كوبوتا شيهو" إذاً؟"

186
00:12:29,780 --> 00:12:31,640
!أشعر بالخجل حقّاً

187
00:12:31,830 --> 00:12:35,010
ستكون تمثيليّة رائعة، صحيح؟

188
00:12:35,010 --> 00:12:37,850
...أ-أجل، فالجميع عملنَ بجدّ، لذا

189
00:12:37,850 --> 00:12:41,590
!يبدو أنّها ستكون ممتازة، أجل

190
00:12:41,590 --> 00:12:43,020
سمعتُها

191
00:12:43,020 --> 00:12:44,120
!معك حقّ

192
00:12:45,010 --> 00:12:46,930
!لنعمل بجدٍّ جميعاً

193
00:12:46,930 --> 00:12:48,090
!أجل

194
00:12:57,620 --> 00:13:00,370
!هذا يكفي! أحسنت يا أوشيواكامارو

195
00:13:00,370 --> 00:13:02,430
!أجل! شكراً لك يا سيّدي

196
00:13:02,430 --> 00:13:05,400
!مُبهر! هذا رائع حقّاً

197
00:13:24,610 --> 00:13:26,260
...ظـ-ظلام حالك

198
00:13:33,690 --> 00:13:35,110
...مـ-مزماري

199
00:13:35,110 --> 00:13:36,830
...مزماري... مزماري

200
00:13:38,860 --> 00:13:40,140
...هنا

201
00:13:51,310 --> 00:13:52,920
!أنزلوا السّتار! السّتار، السّتار، السّتار

202
00:13:55,890 --> 00:13:58,460
!أنا آسفة لأنّني أخطأتُ في النّهاية

203
00:13:58,460 --> 00:14:00,680
!لا عليكِ، لا عليكِ، لا عليكِ

204
00:14:00,680 --> 00:14:01,900
!أجل يا ناغيسا

205
00:14:01,900 --> 00:14:04,870
...لكن لم أستطع التّعامل مع الأسلاك أيضاً

206
00:14:04,870 --> 00:14:07,070
!يا لي من فاشلة

207
00:14:07,070 --> 00:14:09,680
!سنكون بخير إذا نجحنا في الفصل الثّاني

208
00:14:09,680 --> 00:14:10,870
...حسناً

209
00:14:20,180 --> 00:14:23,150
...حسناً، لنُوصل أوشيواكامارو إلى الجسر

210
00:14:23,150 --> 00:14:24,660
!شيهو

211
00:14:23,150 --> 00:14:24,660
!كوبوتا-سان

212
00:14:32,010 --> 00:14:33,190
!ماذا؟

213
00:14:41,490 --> 00:14:43,910
!هيكاري! ثمّة مُشكلة ما، بوبّو

214
00:14:45,490 --> 00:14:47,470
...آسف على المُقاطعة

215
00:14:47,470 --> 00:14:48,440
!أنت

216
00:14:48,440 --> 00:14:50,200
!زاكينّا

217
00:14:50,910 --> 00:14:53,890
!ظننتُ بأنّ التّينغو في صفّ أوشيواكامارو

218
00:14:53,890 --> 00:14:56,190
!إنّهم في صفّي! هل من اعتراض؟

219
00:15:05,730 --> 00:15:06,540
!مؤلم

220
00:15:06,540 --> 00:15:07,120
!ناغيسا

221
00:15:07,120 --> 00:15:07,560
!حسناً

222
00:15:16,660 --> 00:15:18,870
!موجة الشّفق الثنائيّة

223
00:15:46,560 --> 00:15:49,260
!مبعوثة النُّور، كيور بلاك

224
00:15:49,930 --> 00:15:52,730
!مبعوثة النُّور، كيور وايت

225
00:15:54,860 --> 00:15:56,670
!سوية، نحن بريكيور

226
00:15:57,970 --> 00:16:00,240
...يا خدم قوّة الظّلام

227
00:16:01,200 --> 00:16:03,540
!عودوا من حيث أتيتم

228
00:16:17,490 --> 00:16:20,140
!والآن واجها نصلي

229
00:16:21,290 --> 00:16:22,990
!بلاك! وايت

230
00:16:23,620 --> 00:16:25,360
...مؤلم

231
00:16:25,360 --> 00:16:27,030
...تبّاً

232
00:16:35,970 --> 00:16:38,880
!والآن، واجهيني! واجهيني

233
00:16:47,890 --> 00:16:50,090
!لـ-لا أستطيع الرّؤية

234
00:16:50,090 --> 00:16:51,560
بلاك! أين أنتِ؟

235
00:16:51,560 --> 00:16:53,520
!دمّراهما

236
00:16:55,290 --> 00:16:57,180
بلاك! هل أنتِ بخير؟

237
00:16:58,560 --> 00:16:59,980
!بلاك

238
00:17:00,660 --> 00:17:02,500
!إنّه قادم! بلاك، خلفك

239
00:17:03,870 --> 00:17:05,080
!أمامكِ

240
00:17:09,200 --> 00:17:10,560
!من كلا الجانبين

241
00:17:16,710 --> 00:17:17,850
ماذا؟

242
00:17:17,850 --> 00:17:19,430
هزمَتْهما؟

243
00:17:21,180 --> 00:17:22,670
!شكراً يا وايت

244
00:17:22,670 --> 00:17:23,820
!على الرّحب

245
00:17:23,990 --> 00:17:25,300
!فعلتاها، بوبّو

246
00:17:25,300 --> 00:17:27,540
!حسناً، إنّه دورنا الآن

247
00:17:35,000 --> 00:17:37,250
!ابتعدي! ابتعدي حالاً

248
00:17:46,940 --> 00:17:48,940
...تبّاً لكِ

249
00:17:48,940 --> 00:17:51,010
!انهض، زاكينّا

250
00:17:54,450 --> 00:17:56,080
!هيكاري! تحوّلي، بوبّو

251
00:18:03,190 --> 00:18:04,590
!لومينوس

252
00:18:04,800 --> 00:18:07,210
!السّيل اللّامِع

253
00:18:30,250 --> 00:18:32,890
!شرارة الحياة، لومينوس اللّامِعة

254
00:18:34,760 --> 00:18:37,190
!قلب النُّور وإرادة النُّور

255
00:18:37,490 --> 00:18:39,730
!لتوحيدهم جميعاً

256
00:19:01,710 --> 00:19:03,750
!تعاونَّ معاً، بوبّو

257
00:19:17,230 --> 00:19:18,560
!الشّجاعة الفيّاضة

258
00:19:20,370 --> 00:19:21,700
!الأمل الغامِر

259
00:19:22,740 --> 00:19:25,000
!والرّوابط المُشعّة بالنُّور

260
00:19:27,840 --> 00:19:29,340
...إكستريم

261
00:19:29,340 --> 00:19:31,210
!لوميناريو

262
00:19:42,120 --> 00:19:43,860
!ليس من جديد

263
00:19:56,000 --> 00:19:57,690
!وايت. شكراً لكِ

264
00:19:57,690 --> 00:19:59,340
...طريقتكِ في توجيهي

265
00:20:00,980 --> 00:20:03,170
!هكذا ينبغي أن نفعلها

266
00:20:07,620 --> 00:20:10,000
ماذا؟ ماذا كنتُ أفعل؟

267
00:20:10,000 --> 00:20:11,150
!شيهو

268
00:20:11,420 --> 00:20:14,120
ما زالت شبكة الأسلاك
موجودة، أليس كذلك؟

269
00:20:14,120 --> 00:20:16,590
أجل. لماذا تسألين؟

270
00:20:16,800 --> 00:20:20,060
!رغم أنّنا في اللّحظات الأخيرة، أريد تجربتها

271
00:20:21,020 --> 00:20:25,250
!لـ-لكن لم نُتقِن فعلها، ولا حتّى مرّة

272
00:20:25,570 --> 00:20:28,120
أظنّني فهمتُ كيف يُفترَض
أن ينجح الأمر الآن

273
00:20:28,120 --> 00:20:31,090
،سأوقّت ذلك مع صوت هونوكا

274
00:20:31,090 --> 00:20:33,000
!لذا حاولي أن تبقي مُتزامنة معنا

275
00:20:33,410 --> 00:20:36,260
نُزامنه مع صوت يوكيشيرو-سان؟

276
00:20:36,810 --> 00:20:39,480
!حسناً، حسناً، حسناً! قد يفلح ذلك

277
00:20:40,050 --> 00:20:42,120
!ناغيسا! حلّقي عالياً، حسناً

278
00:20:42,120 --> 00:20:42,950
!أكيد

279
00:20:53,230 --> 00:20:55,410
!انتظر مكانك

280
00:20:55,410 --> 00:20:56,680
هل تتكلّم معي؟

281
00:20:56,680 --> 00:20:57,860
!أجل

282
00:20:57,860 --> 00:21:00,130
!ارمِ هذا السّيف من خاصرتك

283
00:21:00,770 --> 00:21:02,830
!سيكون جائزتي الألف

284
00:21:02,830 --> 00:21:05,170
!إذا أردتها، فيمكنك أخذه

285
00:21:05,740 --> 00:21:09,700
!ترفض؟ فلتتذوّق ناغيناتا الخاصّ بي إذاً

286
00:21:09,990 --> 00:21:11,010
!هيّا

287
00:21:11,010 --> 00:21:12,400
!تحليق! تحليق

288
00:21:12,400 --> 00:21:13,580
!تحليق

289
00:21:14,220 --> 00:21:15,440
!مُبهر

290
00:21:15,440 --> 00:21:16,210
!مذهل

291
00:21:24,930 --> 00:21:26,250
!أنت مُزعج

292
00:21:35,010 --> 00:21:37,000
!أ-أستسلم

293
00:21:41,970 --> 00:21:43,600
!فعلناها

294
00:21:48,920 --> 00:21:51,040
!يا لها من مسرحية مُمتعة

295
00:21:51,040 --> 00:21:53,210
!أجل، شيهو تُتقن عملها حقّاً

296
00:21:53,210 --> 00:21:55,310
!شكراً جزيلاً لكم

297
00:22:06,030 --> 00:22:07,320
!هابّينين

298
00:22:07,320 --> 00:22:10,120
الجميع سُعداء لأنّ المسرحيّة
!كانت جميلة

299
00:22:11,210 --> 00:22:14,130
!لأنّهن عملنَ بجدٍّ حتّى آخر لحظة

300
00:23:57,910 --> 00:23:59,840
هونوكا؟ هل ستنتقلين إلى باريس حقاً؟

301
00:23:59,840 --> 00:24:02,670
ما رأيكِ يا ناغيسا؟
...سنضطرّ لوداع بعضنا

302
00:24:02,670 --> 00:24:04,170
...أ-أجل، سوف أفتقدكِ

303
00:24:04,170 --> 00:24:06,280
...لكن إذا كان هذا لأجل مستقبلكِ

304
00:24:06,510 --> 00:24:08,740
!إذا كان هذا ما تريدينه، فسوف أدعمكِ

305
00:24:08,740 --> 00:24:10,110
هل أنتِ متأكِّدة من ذلك؟

306
00:24:10,110 --> 00:24:12,550
!قد لا نتمكّن من رؤية بعضنا الآخر ثانية

307
00:24:13,200 --> 00:24:15,150
:نحن بريكيور ماكس هارت

308
00:24:15,150 --> 00:24:17,990
!وداعاً يا هونوكا؟
!روابطنا متينة للأبد

309
00:24:18,200 --> 00:24:19,620
...حتّى لو افترقنا

310
00:24:19,620 --> 00:24:21,650
تبقى قلوبنا معاً...