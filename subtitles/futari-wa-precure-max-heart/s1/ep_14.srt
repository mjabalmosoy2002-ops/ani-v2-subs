1
00:00:26,470 --> 00:00:29,440
تشاجرتُ مؤخّراً مع أمّي

2
00:00:31,640 --> 00:00:35,410
...يسرّني أنّ ذلك ساهم في تقاربنا، لكن

3
00:00:56,470 --> 00:00:59,870
أولئك الأوغاد دائماً ما يُقاطعوننا
!في أحلك الظّروف

4
00:01:00,200 --> 00:01:02,170
!هذا يُغضبني بشدّة

5
00:01:11,110 --> 00:01:13,980
!ناغيسا-سان! هونوكا-سان

6
00:01:14,350 --> 00:01:15,690
!هيكاري

7
00:01:15,690 --> 00:01:17,570
ما الأمر؟

8
00:01:18,890 --> 00:01:20,660
خرجتِ متأخّرة اليوم

9
00:01:20,720 --> 00:01:23,110
كنتُ أدرس في المكتبة

10
00:01:23,110 --> 00:01:24,830
!يا لكِ من ناضجة

11
00:01:26,300 --> 00:01:27,300
ما الأمر؟

12
00:01:27,300 --> 00:01:28,800
إنّه فوجيمورا-كن

13
00:01:29,570 --> 00:01:31,780
!فـ-فوجيبي-سينباي

14
00:01:31,780 --> 00:01:33,000
!مرحباً

15
00:01:33,800 --> 00:01:35,450
...مرحباً

16
00:01:37,770 --> 00:01:40,460
سمعتُ بأنّكن ربحتُن في المُباراة
الأخيرة في البطولة

17
00:01:40,460 --> 00:01:42,460
!بعودة قويّة

18
00:01:42,460 --> 00:01:43,780
!تهانينا

19
00:01:44,710 --> 00:01:46,730
!شكراً جزيلاً لك

20
00:01:46,730 --> 00:01:51,270
سيترتّب عليّ العمل بجدٍّ مثلكِ
في مُباريات موسمنا المُنتظم

21
00:01:52,220 --> 00:01:55,240
هناك مُباراة تؤهّلنا إلى بطولة
يوم السّبت المُقبل

22
00:01:55,240 --> 00:01:57,240
!هل ستتمكّن من اللّعب؟

23
00:01:57,240 --> 00:02:00,780
،أجل. سأكون في بداية التّشكيلة فوراً

24
00:02:00,780 --> 00:02:02,860
لذا يجب عليّ الارتقاء للتوقُّعات

25
00:02:02,860 --> 00:02:05,270
...هذا مذهل! حسناً إذاً

26
00:02:05,730 --> 00:02:07,070
!سآتي لتشجيعك

27
00:02:09,390 --> 00:02:11,740
!نـ-نحن الثّلاثة معاً

28
00:02:12,170 --> 00:02:13,440
!شكراً

29
00:02:15,280 --> 00:02:16,760
سأبذل قصارى جهدي

30
00:02:20,180 --> 00:02:21,010
!وداعاً

31
00:02:21,010 --> 00:02:22,320
!إلى اللّقاء

32
00:02:25,250 --> 00:02:26,250
ناغيسا-سان؟

33
00:02:26,250 --> 00:02:27,810
ما-ماذا أفعل؟

34
00:02:27,810 --> 00:02:30,410
...قلتُ بأنّني سأذهب لتشجيعه

35
00:03:52,980 --> 00:03:56,970
أعتقد من الأفضل أن أعمل بجدٍّ في التشجّيع

36
00:03:56,970 --> 00:04:02,450
أتساءل ما إن كانت هناك
...طريقة جيّدة لدعمه

37
00:04:03,690 --> 00:04:05,430
!كم هذا جميل

38
00:04:05,430 --> 00:04:08,120
!يا له من قلب نقيّ لديكِ

39
00:04:08,120 --> 00:04:10,400
ماذا تفعلين هنا، ميبّو؟

40
00:04:10,400 --> 00:04:14,750
بوران حسّاسة جدّاً للقلوب البريئة

41
00:04:14,750 --> 00:04:16,450
بريئة، ميبّو؟

42
00:04:16,450 --> 00:04:19,920
ناغيسا تصبح هكذا دوماً عندما
!يتعلّق الأمر بفوجي-بي

43
00:04:20,370 --> 00:04:23,970
!لكنّها لا تخبره أبداً عن شعورها

44
00:04:24,670 --> 00:04:26,870
!لا داعي لتذكر ذلك

45
00:04:28,340 --> 00:04:29,540
...تبّاً

46
00:04:33,380 --> 00:04:37,550
هيّا يا فوجيبي-سينباي! راية تشجيع من أعماق قلب ناغيسا!

47
00:04:38,850 --> 00:04:40,520
راية تشجيع؟

48
00:04:40,520 --> 00:04:44,720
أجل. أريد صنع راية برّاقة وكبيرة

49
00:04:44,720 --> 00:04:47,010
!لتشجيع فريق كُرة القدم

50
00:04:47,010 --> 00:04:49,980
أتتذكّران مُباراة بطولتنا قبل مدّة؟

51
00:04:49,980 --> 00:04:52,730
،عندما كنتُ أشعر بتوتّر شديد وخوف

52
00:04:52,730 --> 00:04:54,920
!ساهمتْ تلك الأمور كثيراً

53
00:04:54,920 --> 00:04:57,430
!فكرة سديدة! سأساعدكِ

54
00:04:58,540 --> 00:04:59,890
ماذا؟

55
00:04:59,890 --> 00:05:03,840
في الواقع... كنتُ أفكِّر في أن
أفعل هذا بنفسي

56
00:05:04,550 --> 00:05:06,710
!حقّاً؟ حسناً

57
00:05:06,710 --> 00:05:09,080
ناغيسا-سان؟ ما الّذي يجري؟

58
00:05:09,080 --> 00:05:10,200
ماذا؟

59
00:05:10,200 --> 00:05:14,850
كنتِ تتصرّفين بغرابة منذ صادفتِ فوجيمورا-سينباي

60
00:05:15,030 --> 00:05:17,210
...فـ-في الواقع... أنا فقط

61
00:05:17,210 --> 00:05:20,550
الجميع يصبحون عاطفيّين أمام الشّخص
!الّذي يحبّونه، ميبّو

62
00:05:21,430 --> 00:05:22,820
!ميبّل

63
00:05:23,070 --> 00:05:24,350
الشّخص الّذي يحبّونه؟

64
00:05:24,350 --> 00:05:27,260
—ناغيسا واقعة في حبّ فوجي-بي، ميبّو

65
00:05:27,970 --> 00:05:29,960
أتريد أن تتأذّى من جديد؟

66
00:05:29,960 --> 00:05:32,270
!أنا أتأذّى بالفعل، ميبّو

67
00:05:33,240 --> 00:05:35,070
أيّها الوغد

68
00:05:37,050 --> 00:05:38,460
!إنّه مُخطئ

69
00:05:38,460 --> 00:05:42,440
...أنا لا أ-أحبّه أو ما شابه

70
00:05:48,720 --> 00:05:51,680
ما الّذي يجري مع ناغيسا-سان؟

71
00:05:52,190 --> 00:05:55,810
ما الّذي يعنيه أن تحبّ شخصاً؟

72
00:05:55,810 --> 00:05:58,890
!إنّه شيء طاهر جدّاً

73
00:06:00,540 --> 00:06:04,220
إنّه شيء يظلّ النّاس يكتمه
،الجميع في أعماق قلوبهم

74
00:06:04,220 --> 00:06:06,590
شيء نقيّ وجميل

75
00:06:06,590 --> 00:06:11,200
شيء نقيّ وجميل نكتمه في أعماق قلوبنا؟

76
00:06:14,580 --> 00:06:17,010
...إنّها غير مُلائمة

77
00:06:17,010 --> 00:06:20,610
أجل، فظيعة جدّاً، ميبّو

78
00:06:20,610 --> 00:06:22,220
!تبّاً

79
00:06:22,220 --> 00:06:24,880
لكن عليّ تحسينها فحسب، صحيح؟

80
00:06:24,880 --> 00:06:26,780
هل أنتِ متأكّدة من هذا، ميبّو؟

81
00:06:26,780 --> 00:06:28,620
هذه مُحاولتكِ العاشرة، ميبّو

82
00:06:28,780 --> 00:06:31,880
ماذا تريد؟ لستُ ماهرة في الرّسم

83
00:06:31,880 --> 00:06:33,750
هذا مُثير للشّفقة

84
00:06:33,750 --> 00:06:35,590
كيف انتهى الحالُ بي هكذا؟

85
00:06:35,590 --> 00:06:38,320
!انظري إليها كي تجلد ذاتها

86
00:06:38,320 --> 00:06:41,270
!يا له من قلب نقيّ تمتلكه

87
00:06:41,450 --> 00:06:43,900
،يسرّني أنّكِ تستمتعين برؤية ذلك

88
00:06:43,900 --> 00:06:47,000
!لكن ينبغي لكِ حقّاً أن تعودي إلى التشيريكت

89
00:06:47,000 --> 00:06:49,630
!دعيني فترة أطول قليلاً أرجوكِ

90
00:06:49,630 --> 00:06:53,110
!أريد رؤية المزيد من قلبها النّقيّ

91
00:06:53,360 --> 00:06:56,740
...القلب الجميل لهذه العذراء

92
00:06:56,740 --> 00:07:02,780
قد يكون قلبها جميلاً، لكن رسمها سيّئ، ميبّو

93
00:07:02,780 --> 00:07:04,790
!اصمتوا

94
00:07:04,790 --> 00:07:06,690
!دعوني أركِّز فحسب

95
00:07:06,690 --> 00:07:09,490
!يجب أن أُنجز هذا قبل يوم السّبت

96
00:07:10,670 --> 00:07:12,760
!يجب أن أعمل بجدٍّ حقّاً

97
00:07:14,080 --> 00:07:16,440
!حسناً... لنفعلها

98
00:07:16,440 --> 00:07:18,640
!إلى الأمام

99
00:07:31,260 --> 00:07:32,540
ماذا؟

100
00:07:36,120 --> 00:07:38,620
!انتبه، زاكينّا

101
00:07:38,930 --> 00:07:42,090
مخلوق صغير بطاقة كبيرة؟

102
00:07:42,270 --> 00:07:43,790
!زاكينّا

103
00:07:43,790 --> 00:07:45,990
!توقّف، زاكينّا

104
00:07:45,990 --> 00:07:47,260
!لا أستطيع إيقافه

105
00:07:47,260 --> 00:07:48,560
أجل

106
00:07:48,560 --> 00:07:53,000
بدا مختلفاً جدّاً عن المُحاربتين الأسطوريّتين

107
00:07:53,000 --> 00:07:55,800
قد يكون مُتّصلاً بالملِكة كذلك

108
00:08:02,120 --> 00:08:05,250
يستحقّ الأمر التحرّي على ما يبدو

109
00:08:21,880 --> 00:08:24,270
ناغيسا-سان ليست هنا بعد

110
00:08:24,270 --> 00:08:26,160
هذا غريب

111
00:08:26,160 --> 00:08:28,740
...ظننتُ بأنّها ستصنع راية

112
00:08:29,020 --> 00:08:32,120
سنواجه ثانويّة كاكوتوكان. إنّهم خصم قويّ

113
00:08:32,120 --> 00:08:36,480
تحدٍّ جيّد لفريقنا الجديد كلّياً

114
00:08:37,030 --> 00:08:38,210
!لنبذل قصارى جهدنا

115
00:08:38,210 --> 00:08:39,410
!أجل

116
00:08:40,350 --> 00:08:43,050
!لـ-لنبذل قصارى جهدنا

117
00:08:43,050 --> 00:08:44,310
!أجل

118
00:08:44,310 --> 00:08:46,080
!فوجيمورا! كيماتا

119
00:08:46,080 --> 00:08:47,230
!نـ-نعم

120
00:08:47,230 --> 00:08:48,990
!استرخيا، استرخيا

121
00:08:50,170 --> 00:08:50,820
!حاضر

122
00:08:51,740 --> 00:08:53,790
!آسفة لتأخُّري

123
00:08:53,790 --> 00:08:57,060
ناغيسا! هل أنهيتِ راية التّشجيع؟

124
00:08:57,060 --> 00:08:59,770
...أجل. أحضرتُها، لكن

125
00:09:00,050 --> 00:09:01,970
...لستُ متأكّدة

126
00:09:01,970 --> 00:09:03,870
ماذا تقصدين؟

127
00:09:03,870 --> 00:09:08,040
إنّها سيّئة للغاية لدرجة أنّها
!مُحرَجة من إظهارها، ميبّو

128
00:09:08,040 --> 00:09:09,170
!اصمت

129
00:09:09,170 --> 00:09:10,610
...لكن

130
00:09:10,890 --> 00:09:12,840
عملتِ بجدٍّ كبير عليها

131
00:09:12,840 --> 00:09:17,720
معها حقّ. ما يهمّ هو الشُّعور هنا

132
00:09:18,620 --> 00:09:20,090
!لا تقلقي بشأن ذلك

133
00:09:20,090 --> 00:09:23,590
...أجل... هذا ما أعتقده، لكن

134
00:09:23,590 --> 00:09:25,260
لِمَ لا تعرضينها إذاً؟

135
00:09:25,260 --> 00:09:27,360
هل يمكننا إلقاء نظرة؟

136
00:09:28,710 --> 00:09:29,930
نظرة خاطفة فقط، اتّفقنا؟

137
00:09:30,380 --> 00:09:32,160
ساعديني يا هيكاري

138
00:09:32,160 --> 00:09:32,870
!حسناً

139
00:09:36,920 --> 00:09:38,140
إنّها غريبة، صحيح؟

140
00:09:38,140 --> 00:09:39,940
!إطلاقاً

141
00:09:39,940 --> 00:09:43,410
!أعتقد فوجيمورا-كن سيحبّها

142
00:09:43,410 --> 00:09:45,210
أ-أوتظنّين ذلك؟

143
00:09:45,210 --> 00:09:46,240
!أجل

144
00:09:46,240 --> 00:09:47,310
لا تقلقي

145
00:09:47,310 --> 00:09:50,620
ولو كان أعوج قليلاً، يبقى قابلاً للقراءة

146
00:09:51,600 --> 00:09:54,190
...أ-أجل، صحيح

147
00:09:54,500 --> 00:09:56,120
...بـ-بجدّية

148
00:09:56,120 --> 00:10:00,600
ما يهمّ هو الشّعور الّذي تُعبِّر عنه، صحيح؟

149
00:10:00,600 --> 00:10:01,860
الشّعور؟

150
00:10:01,860 --> 00:10:02,730
أجل

151
00:10:02,730 --> 00:10:04,960
الرّسالة في الرّاية

152
00:10:04,960 --> 00:10:08,630
!تُوضّح مشاعركِ تجاه فوجيمورا-كن

153
00:10:11,490 --> 00:10:13,040
...ربّما ينبغي أن ألغيها

154
00:10:14,120 --> 00:10:15,270
لماذا؟

155
00:10:15,270 --> 00:10:17,740
هل ارتكبتُ خطأ؟

156
00:10:17,900 --> 00:10:19,440
!لـ-لا، إطلاقاً

157
00:10:19,440 --> 00:10:20,680
!الأمر ليس كذلك

158
00:10:20,680 --> 00:10:21,950
...ناغيسا

159
00:10:21,950 --> 00:10:25,080
...عَمِلَتْ بجدٍّ على تلك الرّاية

160
00:10:25,080 --> 00:10:26,920
!يا للهدر

161
00:10:50,660 --> 00:10:51,670
!كيماتا

162
00:10:51,670 --> 00:10:52,640
!عُلِم

163
00:10:54,540 --> 00:10:56,780
!هجمة مرتدّة! عودوا

164
00:10:58,950 --> 00:11:01,130
!هيّا! هيّا

165
00:11:05,970 --> 00:11:07,560
ناغيسا؟

166
00:11:07,980 --> 00:11:12,230
!أعتقد يجدر بكِ أن تُشجّعيه حقّاً بتلك الرّاية

167
00:11:12,230 --> 00:11:13,470
!معها حقّ

168
00:11:13,470 --> 00:11:16,530
أنتِ لستِ على طبيعتكِ

169
00:11:16,690 --> 00:11:18,070
أوتظنّان ذلك؟

170
00:11:18,070 --> 00:11:19,530
!أجل

171
00:11:20,740 --> 00:11:21,700
!هيّا بنا

172
00:11:28,830 --> 00:11:30,250
...هذا

173
00:11:48,920 --> 00:11:50,130
...هذا

174
00:11:59,860 --> 00:12:01,910
يجب علينا الخروج من هنا

175
00:12:04,370 --> 00:12:05,580
معكِ حقّ

176
00:12:09,680 --> 00:12:13,930
لن ندع ذلك الوغد يعرقل
!مُباراة فوجيبي-سينباي

177
00:12:20,250 --> 00:12:23,360
أعطياني حياة الملِكة

178
00:12:24,260 --> 00:12:28,070
...وذلك كي تحكم قوّةُ الظّلام للأبد

179
00:12:28,230 --> 00:12:30,540
،لديّ سؤال لكِ

180
00:12:30,700 --> 00:12:32,210
!يا لومينوس اللّامِعة

181
00:12:32,210 --> 00:12:33,850
عمّاذا تتكلّم؟

182
00:12:33,850 --> 00:12:36,910
!إذا فعلت شيئاً لهيكاري، فسوف تدفع الثّمن

183
00:12:37,100 --> 00:12:40,310
!ناغيسا! الحضور الشرّير يزداد قوّة، ميبّو

184
00:12:54,980 --> 00:12:55,890
!هونوكا

185
00:12:55,890 --> 00:12:56,440
!أجل

186
00:13:07,900 --> 00:13:10,180
!موجة الشّفق الثنائيّة

187
00:13:39,340 --> 00:13:41,970
!مبعوثة النُّور، كيور بلاك

188
00:13:43,140 --> 00:13:45,940
!مبعوثة النُّور، كيور وايت

189
00:13:48,070 --> 00:13:49,880
!سوية، نحن بريكيور

190
00:13:51,340 --> 00:13:53,450
...يا خدم قوّة الظّلام

191
00:13:54,510 --> 00:13:56,750
!عودوا من حيث أتيتم

192
00:14:16,670 --> 00:14:18,020
!ابقي هنا

193
00:14:26,210 --> 00:14:28,860
والآن لن يكون هناك من يُقاطعنا لبعض الوقت

194
00:14:31,350 --> 00:14:33,290
!سوف تتعاملين معي

195
00:14:33,720 --> 00:14:34,990
!حضّري نفسكِ

196
00:14:37,050 --> 00:14:39,330
!هيكاري! تحوّلي، بوبّو

197
00:14:45,660 --> 00:14:47,070
!لومينوس

198
00:14:47,500 --> 00:14:49,850
!السّيل اللّامِع

199
00:15:24,270 --> 00:15:26,540
!شرارة الحياة، لومينوس اللّامِعة

200
00:15:28,600 --> 00:15:30,840
!قلب النُّور وإرادة النُّور

201
00:15:31,270 --> 00:15:33,380
!لتوحيدهم جميعاً

202
00:15:39,950 --> 00:15:41,730
!ها أنتِ ذي يا لومينوس اللّامِعة

203
00:15:59,500 --> 00:16:00,770
هل أنتما بخير؟

204
00:16:03,410 --> 00:16:05,110
!لن تهربي يا لومينوس

205
00:16:06,980 --> 00:16:08,790
...إذا حاولت أذيّة لومينوس

206
00:16:08,790 --> 00:16:11,220
!سندعك تدفع الثّمن...

207
00:16:11,480 --> 00:16:12,930
حقّاً؟

208
00:16:12,930 --> 00:16:16,350
أتعتقدان حقّاً بأنّكما تستطيعان إيقافي؟

209
00:16:16,350 --> 00:16:18,540
!إن كنتَ مُصِرّاً، أجل

210
00:16:18,540 --> 00:16:19,870
!سوف نُوقفك

211
00:16:19,870 --> 00:16:21,060
!سنفعل ذلك

212
00:16:22,330 --> 00:16:24,210
!ابتعدا عن طريقي

213
00:16:29,800 --> 00:16:31,400
!وايت! خلفكِ

214
00:16:35,100 --> 00:16:36,470
!بلاك

215
00:16:38,940 --> 00:16:41,330
ابتعدا عنّي لبعض الوقت

216
00:16:42,340 --> 00:16:43,910
،لن تفلتي هذه المرّة

217
00:16:44,380 --> 00:16:45,320
!يا لومينوس

218
00:16:45,320 --> 00:16:46,930
!لا، لا، لا

219
00:16:47,620 --> 00:16:50,540
!إيّاك وأذيّة الملِكة

220
00:16:50,540 --> 00:16:53,910
!بوران! هذا ليس آمناً

221
00:16:53,910 --> 00:16:55,730
...أنتما

222
00:16:55,730 --> 00:16:57,060
ما أنتما؟

223
00:17:01,530 --> 00:17:02,330
!سيكون

224
00:17:02,570 --> 00:17:03,230
!بوران

225
00:17:03,570 --> 00:17:07,440
رغم حجمكما الضّئيل، تُشعّان بطاقة النُّور

226
00:17:07,770 --> 00:17:10,460
من تكونان بالضّبط؟

227
00:17:10,460 --> 00:17:13,410
ما هي رابطكما بالملِكة؟

228
00:17:13,740 --> 00:17:16,480
!أنقذي سيكون وبوران، بوبّو

229
00:17:18,010 --> 00:17:19,530
!إرادة النُّور

230
00:17:19,530 --> 00:17:23,100
!مُدّيني بالشّجاعة، والأمل والقوّة

231
00:17:44,370 --> 00:17:45,670
!لومينوس

232
00:17:45,880 --> 00:17:48,280
!حركة هارتييل

233
00:18:17,710 --> 00:18:21,280
!أبطلتِ قوّةَ ظلامي؟

234
00:18:25,180 --> 00:18:27,900
ردعَتْه بحركة هارتييل؟

235
00:18:27,900 --> 00:18:30,150
...مُذهل! بقوّة الإرادة وحدها

236
00:18:35,060 --> 00:18:36,680
!هيّا بنا يا وايت

237
00:18:38,590 --> 00:18:40,260
!الرّعد الأسود

238
00:18:40,700 --> 00:18:42,600
!الرّعد الأبيض

239
00:18:49,370 --> 00:18:52,370
...روحا بريكيور الجميلتان

240
00:18:52,640 --> 00:18:55,210
!ستقهران القلوبَ الشرّيرة...

241
00:18:56,010 --> 00:18:58,240
...اللّولب الرُّخامي بريكيور

242
00:19:03,280 --> 00:19:05,350
!ماكس

243
00:19:29,610 --> 00:19:30,780
!المُباراة

244
00:19:34,980 --> 00:19:36,600
...وصلوا للشّوط الثّاني

245
00:19:36,600 --> 00:19:39,420
...ولم يُحرِز أي من الفريقين بعد

246
00:19:42,620 --> 00:19:44,340
...فوجيبي-سينباي

247
00:19:47,130 --> 00:19:48,720
ناغيسا

248
00:19:48,720 --> 00:19:50,800
!شجّعيه بهذه

249
00:19:53,600 --> 00:19:57,820
!شجّعيه بالرّاية الّتي كرّستِ قلبكِ فيها

250
00:19:58,310 --> 00:20:02,740
!أجل. ستُسعِد فوجيمورا-سينباي كثيراً

251
00:20:17,530 --> 00:20:18,360
!فوجيمورا

252
00:20:26,640 --> 00:20:28,060
!قاتلوا يا فيروني

253
00:20:29,570 --> 00:20:31,590
!هيّا، هيّا، فيروني

254
00:20:32,340 --> 00:20:34,890
!قاتلوا يا فيروني

255
00:20:35,540 --> 00:20:37,400
!هيّا، هيّا، فيروني

256
00:20:38,510 --> 00:20:40,430
!قاتلوا يا فيروني

257
00:20:41,320 --> 00:20:43,400
!هيّا، هيّا، فيروني

258
00:20:44,280 --> 00:20:46,170
!قاتلوا يا فيروني

259
00:20:47,420 --> 00:20:49,340
!هيّا، هيّا، فيروني

260
00:20:49,820 --> 00:20:50,950
!ناغيسا

261
00:20:51,560 --> 00:20:52,920
!حسناً

262
00:20:54,960 --> 00:20:57,030
،هيّا

263
00:20:57,030 --> 00:20:58,490
!فوجيبي-سينباي

264
00:21:04,070 --> 00:21:05,220
!حسناً

265
00:21:23,680 --> 00:21:25,620
!هيّا

266
00:21:33,200 --> 00:21:35,090
!فعلناها

267
00:21:44,310 --> 00:21:46,240
!ربحنا

268
00:21:53,360 --> 00:21:55,550
شكراً يا ميسومي-سان

269
00:21:56,330 --> 00:21:59,520
أعتقد بأنّ رايتكِ منحَتْني الدّفع
الأخير الّذي احتجتُه

270
00:21:59,520 --> 00:22:01,720
حـ-حقّاً؟

271
00:22:01,720 --> 00:22:04,190
أليس هذا رائعاً يا ناغيسا؟

272
00:22:05,370 --> 00:22:07,390
!هذا مُبهِر فعلاً

273
00:22:07,390 --> 00:22:11,120
!أنا متأثِّرة لغاية

274
00:22:11,120 --> 00:22:14,600
!بوران. أنتِ بريئة جدّاً

275
00:23:57,470 --> 00:23:59,500
ناغيسا، هل لديك مثل أعلى؟

276
00:23:59,500 --> 00:24:02,270
يوميكو-سينباي، قائدة فريقنا
القديمة في رياضة اللّاكروس

277
00:24:02,510 --> 00:24:04,940
كانت صارمة، لكنّها كانت
!أيضاً لطيفة ورائعة

278
00:24:04,940 --> 00:24:07,310
أعتقد هناك فتيات أصغر سنّاً
!مُعجبات بكِ أيضاً

279
00:24:07,310 --> 00:24:08,780
تقصدين أنتِ، صحيح؟

280
00:24:08,780 --> 00:24:10,650
!خلفكِ كثير من المُعجبين الآن

281
00:24:10,650 --> 00:24:12,650
!لا، هذا زاكينّا

282
00:24:12,650 --> 00:24:14,550
:نحن بريكيور ماكس هارت

283
00:24:14,550 --> 00:24:16,450
!السّينباي الّذي أحبّه هو أعزّ صديق لك؟

284
00:24:16,450 --> 00:24:19,020
—المثل الأعلى لناغيسا هو فوجيبي-سينباي

285
00:24:19,020 --> 00:24:21,150
،ماذا تقولين؟! هذا لا يُصدَّق، لا يُصدَّق

286
00:24:21,150 --> 00:24:22,720
!لا يُصدَّق