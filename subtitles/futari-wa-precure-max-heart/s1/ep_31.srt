1
00:02:19,050 --> 00:02:21,100
ماذا كانت تلك القوّة؟

2
00:02:22,880 --> 00:02:25,390
ماذا حدث للومينوس؟

3
00:02:26,150 --> 00:02:30,260
هل كانت لولون حقّاً المسؤولة عن ذلك؟

4
00:02:30,860 --> 00:02:32,090
...وإن كان كذلك

5
00:02:32,090 --> 00:02:35,580
هل لولون مُرتبطة بإحياء الملِكة بطريقة ما؟

6
00:02:39,870 --> 00:02:41,920
!عليّ التّركيز على اللّاكروس حاليّاً

7
00:02:41,920 --> 00:02:44,620
!ستبدأ مُباريات البطولة غداً

8
00:02:44,620 --> 00:02:48,260
يا قائدة! هل يمكنكِ أن تُريني شيئاً؟

9
00:02:48,260 --> 00:02:49,390
!قادمة

10
00:02:56,680 --> 00:02:59,650
!يا فتيات، تعالَين إلى هنا

11
00:03:00,190 --> 00:03:03,920
سننقسم إلى فريقين لخوض مُباراة تمرينيّة

12
00:03:04,390 --> 00:03:06,680
ناغيسا مُتحمّسة جدّاً، أليس كذلك؟

13
00:03:06,680 --> 00:03:08,910
اقتربت مُباراتهن

14
00:03:08,910 --> 00:03:11,900
يبدو أنّكِ تأتين إلى هنا كثيراً مؤخّراً

15
00:03:13,300 --> 00:03:18,520
إنَّ مُشاهدة ناغيسا تُحفّزني حقّاً

16
00:03:20,040 --> 00:03:21,910
أريد أن أكون قائدة نادٍ جيّدة مثلها

17
00:03:24,480 --> 00:03:27,310
جميعهن يعملنَ بجدّ، أليس كذلك؟

18
00:03:32,960 --> 00:03:34,650
!أحسنتِ صنعاً يا ماكي

19
00:03:36,160 --> 00:03:38,080
أنتِ أيضاً يا ميغومي-سينباي

20
00:03:38,080 --> 00:03:39,920
!ميغومي! ماكي

21
00:03:40,160 --> 00:03:42,730
!تعالا وانضمّا إلينا هنا

22
00:03:43,230 --> 00:03:45,520
كانتا تعملان بجدّ مؤخّراً، أليس كذلك؟

23
00:03:45,520 --> 00:03:46,990
!أجل، أجل، أجل

24
00:03:46,990 --> 00:03:49,170
!تعملان بجدّ أكثر منّا حتّى

25
00:03:49,170 --> 00:03:50,290
!لن تهزميني

26
00:03:50,290 --> 00:03:51,470
!نلتُ منكِ

27
00:03:51,470 --> 00:03:54,060
!علينا أن نعمل بجدٍّ أيضاً

28
00:03:54,380 --> 00:03:56,460
ما هذه الوضعيّة السّخيفة؟

29
00:03:56,460 --> 00:03:58,940
!أنا أتحمّس! انضممن إليّ

30
00:03:58,940 --> 00:04:01,230
!مستحيل، مستحيل، مستحيل

31
00:04:01,230 --> 00:04:02,900
!تبدو كمزحة

32
00:04:01,930 --> 00:04:05,420
يعملنَ معاً لتحقيق نفس الهدف

33
00:04:05,690 --> 00:04:09,530
امتلاك فريق يُعتمَد عليه أمر مذهل، صحيح؟

34
00:04:08,970 --> 00:04:10,660
ماذا تفعلن؟

35
00:04:10,080 --> 00:04:13,120
...وناغيسا دائماً في مِحور الفريق

36
00:04:14,260 --> 00:04:16,210
تُوحّدهن معاً

37
00:04:20,770 --> 00:04:24,420
!إحياء فالديس
!!تحقيق فوز جماعي صعب

38
00:04:46,290 --> 00:04:48,250
!لنلعب، لولو

39
00:04:49,230 --> 00:04:50,260
لولون

40
00:04:50,260 --> 00:04:51,250
لولو؟

41
00:04:56,240 --> 00:04:57,790
لا شيء

42
00:04:57,790 --> 00:04:59,160
!أنتِ هنا

43
00:05:00,870 --> 00:05:02,630
!مـ-مرحباً بعودتكِ

44
00:05:02,630 --> 00:05:05,500
هيكاري، مُباراة ناغيسا بعد ظهر اليوم، صحيح؟

45
00:05:05,500 --> 00:05:06,840
!أجل! صحيح

46
00:05:07,180 --> 00:05:08,570
!اذهبي وشجّعيها

47
00:05:08,570 --> 00:05:09,800
...لـ-لكن

48
00:05:09,800 --> 00:05:11,120
!لا عليكِ، لا عليكِ

49
00:05:11,120 --> 00:05:14,850
!وقولي لها، بالمقابل، حريّ بها ألّا تخسر

50
00:05:16,290 --> 00:05:17,550
!حسناً

51
00:05:25,730 --> 00:05:27,090
!ما المشكلة؟

52
00:05:27,090 --> 00:05:30,310
...يبدون أقوى بكثير من المرّة الماضية

53
00:05:30,310 --> 00:05:32,860
مُباراتنا الأولى مع كاكوتوكان؟

54
00:05:32,860 --> 00:05:35,100
!علينا أن نربح هذه المُباراة

55
00:05:35,100 --> 00:05:36,440
ماذا؟ ماذا تفعلن؟

56
00:05:36,880 --> 00:05:38,530
...أفسِحن المجال

57
00:05:41,180 --> 00:05:44,180
!رائع! نُحبّكن

58
00:05:45,350 --> 00:05:47,470
!هذا مُقلِق جدّاً، جدّاً

59
00:05:47,470 --> 00:05:49,980
!لن يتغلّبن على حماسنا

60
00:05:51,660 --> 00:05:53,420
أظنّهن فعلنَ ذلك سلفاً

61
00:05:53,420 --> 00:05:57,120
ولماذا يستعرضنَ عضلاتهن هكذا؟

62
00:05:57,600 --> 00:05:59,930
!هيكاري-سان! من هنا

63
00:06:00,300 --> 00:06:02,090
!هونوكا-سان

64
00:06:03,210 --> 00:06:06,170
!ليت أكاني-سان قد أتت أيضاً

65
00:06:06,480 --> 00:06:10,760
"!قالت أكاني-سان "حريّ بها ألّا تخسر

66
00:06:13,280 --> 00:06:16,740
أعتقد ستكون مُباراة مُمتعة

67
00:06:17,310 --> 00:06:20,210
!هيّا، هيّا، فيروني! هيّا، هيّا، هيّا

68
00:06:20,690 --> 00:06:22,230
!بو، بو، فيروني

69
00:06:22,230 --> 00:06:24,230
!لو، لو، لو، لو، لو

70
00:06:24,390 --> 00:06:26,810
حاولا أن تهدآ

71
00:06:28,900 --> 00:06:31,490
هيكاري. أنِ مثل أمّهما، مِيبّو

72
00:06:37,240 --> 00:06:40,630
،قطعنا كلّ هذه المسافة. لنؤمن بأنفسنا

73
00:06:41,040 --> 00:06:42,600
!ونفعل ما بوسعنا

74
00:06:43,150 --> 00:06:43,770
!أجل

75
00:06:59,460 --> 00:07:00,750
!ناغيسا

76
00:07:03,650 --> 00:07:04,780
...أنا مُحاصرة

77
00:07:04,780 --> 00:07:06,220
!شيهو

78
00:07:07,020 --> 00:07:07,960
!رينا

79
00:07:15,880 --> 00:07:17,470
لا أستطيع التّمرير

80
00:07:18,750 --> 00:07:20,900
!حجبتْ عنّي كلّ شيء

81
00:07:25,920 --> 00:07:27,510
إنّها واثقة؟

82
00:07:27,940 --> 00:07:29,610
!ميغومي

83
00:07:30,610 --> 00:07:31,880
!رينا

84
00:07:53,490 --> 00:07:54,840
!لا تقلقن، لا تقلقن، لا تقلقن

85
00:07:55,280 --> 00:07:57,170
عرفنَ متى كنّا سنُمرِّر؟

86
00:07:58,450 --> 00:08:00,040
!تبّاً

87
00:08:12,770 --> 00:08:13,990
!قومي بتغطيتها

88
00:08:15,000 --> 00:08:16,360
!ناغيسا

89
00:08:19,160 --> 00:08:21,130
!تملّصي منهما

90
00:08:35,210 --> 00:08:37,080
!هيّا

91
00:08:50,310 --> 00:08:53,290
!يعرفنَ كلّ ما نحن على وشك أن نفعله

92
00:08:53,290 --> 00:08:56,660
أنا متأكّدة بأنّهن سيعُدنَ في الشّوط
الثّاني، أليس كذلك؟

93
00:08:56,660 --> 00:08:58,900
!ناغيسا... استمرّي في المحاولة

94
00:09:05,620 --> 00:09:08,010
إنّهن يُراقِبن ناغيسا مُراقبة حثيثة

95
00:09:09,490 --> 00:09:11,010
هكذا يبدو

96
00:09:12,030 --> 00:09:15,920
هل تعتقدين بأنّهن أجرينَ بحثاً شاملاً عنّا؟

97
00:09:15,920 --> 00:09:18,880
لا يمكننا حتّى أن نتمكّن من التّسديد
على المرمى هكذا

98
00:09:18,880 --> 00:09:21,020
ماذا يجدر بنا أن نفعل؟

99
00:09:21,870 --> 00:09:23,790
ماذا نفعل يا ناغيسا؟

100
00:09:28,880 --> 00:09:30,800
سوف نغيّر مواقعنا

101
00:09:31,610 --> 00:09:33,700
سأعود إلى الدّفاع

102
00:09:33,700 --> 00:09:37,380
غالباً أجرينَ بحثاً حول مُبارياتنا السّابقة

103
00:09:37,380 --> 00:09:40,710
لكن جعلَهن ذلك يشعرنَ غالباً بالثِّقة المُفرطة

104
00:09:40,710 --> 00:09:43,610
،لم أغيّر مركزي في مُباراة من قبل

105
00:09:43,610 --> 00:09:45,480
لذا ينبغي لهذا أن يُربكهن

106
00:09:45,480 --> 00:09:46,650
...أثناء الارتباك

107
00:09:47,260 --> 00:09:49,250
!تُهاجمنَ أنتن

108
00:09:49,250 --> 00:09:51,880
لكن هذا سيُخفّض من احتماليّة تسجيلنا

109
00:09:51,880 --> 00:09:53,990
!لا بدّ أن يكون أحدنا في الهجوم

110
00:09:53,990 --> 00:09:55,220
لكن من؟

111
00:09:56,770 --> 00:09:57,590
ماكي

112
00:09:58,820 --> 00:10:00,590
أعلم بأنّكِ تستطيعين فعلها يا ماكي

113
00:10:01,580 --> 00:10:02,960
أنا؟

114
00:10:03,380 --> 00:10:07,000
تعيين طالبة سنة ثانية كمُهاجمة بديلة عنّي

115
00:10:07,000 --> 00:10:09,300
هو آخر شيء يتوقّعونه

116
00:10:09,620 --> 00:10:11,900
،تعملين بجدٍّ في التّمرين دوماً

117
00:10:11,900 --> 00:10:13,940
وأعقد لديكِ المُؤهّلات

118
00:10:14,290 --> 00:10:17,360
!لذا آمني بنفسكِ وافعليها

119
00:10:17,360 --> 00:10:19,780
ميغومي، ساعدي ماكي

120
00:10:22,530 --> 00:10:24,620
بقيّتكن، آمنَّ بماكي وابذلنَ قصارى جهدكن

121
00:10:24,620 --> 00:10:25,780
!حسناً

122
00:10:26,170 --> 00:10:27,890
!سوف ينجح هذا

123
00:10:27,890 --> 00:10:29,390
!كُنَّ شُجاعات

124
00:10:36,650 --> 00:10:38,260
!سأحاول

125
00:11:09,080 --> 00:11:11,330
ما الّذي يجري هنا؟

126
00:11:11,810 --> 00:11:13,530
اختفتْ ناغيسا-سان؟

127
00:11:13,530 --> 00:11:15,300
عادتْ إلى الدّفاع

128
00:11:17,490 --> 00:11:21,070
لكن هل سيتمكنَّ من التّسجيل
بينما هي في الدّفاع؟

129
00:11:21,390 --> 00:11:23,910
أنا متأكّدة بأنّ لديها خطّة

130
00:11:23,910 --> 00:11:26,780
الرّياضة لا تتمحور حول الموهبة الفرديّة فقط

131
00:11:27,460 --> 00:11:29,520
التّعاون الجماعيّ مهمّ أيضاً

132
00:11:29,520 --> 00:11:31,580
...القدرة على الثِّقة ببعضهم الآخر

133
00:11:31,580 --> 00:11:34,180
والنّاس الّذين يُشجّعونك

134
00:11:34,940 --> 00:11:37,360
،ناغيسا تؤمن بفريقها

135
00:11:37,970 --> 00:11:40,130
وبالقوّة الّتي يمتلكها

136
00:11:45,950 --> 00:11:48,270
ماذا؟ أين نحن؟

137
00:12:00,000 --> 00:12:01,510
!جميعهم معاً، مِيبّو

138
00:12:01,510 --> 00:12:03,980
!أنا خائفة، لولو! أنا خائفة، لولو

139
00:12:06,950 --> 00:12:08,250
!زاكينّا

140
00:12:17,060 --> 00:12:18,860
!نحن مُحاصَرون، ميبّو

141
00:12:19,020 --> 00:12:21,290
!تحوّلي، مِيبّو

142
00:12:21,290 --> 00:12:22,170
!ناغيسا

143
00:12:22,170 --> 00:12:23,640
!انتظروا لحظة

144
00:12:23,640 --> 00:12:25,530
!أعيدونا إلى المُباراة

145
00:12:25,530 --> 00:12:26,940
مُباراة؟

146
00:12:26,940 --> 00:12:31,000
يا له من كلام مُضحك تقولينه
ونحن في وضع كهذا

147
00:12:31,290 --> 00:12:36,550
،فريقي فيروني يُقاتل ببسالة
مُؤمناً بأنّه سيفوز

148
00:12:36,550 --> 00:12:40,210
أريد القتال معه حتّى آخر لحظة
بصِفتي قائدتهن

149
00:12:40,670 --> 00:12:41,790
...لذا

150
00:12:41,790 --> 00:12:43,590
كلام فارغ

151
00:12:44,110 --> 00:12:46,650
أنتم لا تملكون حاضراً ولا مستقبلاً

152
00:12:47,010 --> 00:12:50,620
في نهاية المطاف، سيُحكَم العالم
بأسرِه بواسطة الظّلام

153
00:12:50,620 --> 00:12:52,100
كلام فارغ؟

154
00:12:52,100 --> 00:12:56,540
...بذلنا مجهوداً كبيراً وتمرنّا بشكلٍ يوميّ

155
00:12:56,540 --> 00:13:00,240
عمِلنا بجدّ مؤمنات بقوّتنا وبأنّنا نستطيع الفوز

156
00:13:00,240 --> 00:13:02,640
اليوم هو اليوم الّذي سنكتشف فيه
!فيما إذا كان ذلك العمل الدّؤوب مُثمِراً

157
00:13:02,640 --> 00:13:04,840
!فتقول لي بأنّه كلام فارغ؟

158
00:13:04,840 --> 00:13:09,010
!ما أهمّية نتيجة مُباراة وأنتم لا مستقبل لكم؟

159
00:13:09,260 --> 00:13:12,940
!إذا أردتِ العودة، فسيترتّب عليكِ هزيمتنا أوّلاً

160
00:13:12,940 --> 00:13:15,510
رغم شكوكي بأنّكِ تستطيعين فعلها

161
00:13:18,220 --> 00:13:19,320
!ناغيسا

162
00:13:19,320 --> 00:13:20,070
!ناغيسا-سان

163
00:13:20,070 --> 00:13:21,690
!ما أدراكم أنتم؟

164
00:13:21,690 --> 00:13:24,960
!لا تفقهون شيئاً! لذا أغلقوا أفواهكم التّافهة

165
00:13:24,960 --> 00:13:28,430
!مُباراة اليوم مهمّة جدّاً بالنّسبة لنا

166
00:13:28,430 --> 00:13:32,370
!لذا يجب عليّ تقدير الحاضر بينما أعيشه

167
00:13:32,820 --> 00:13:35,410
لا مُستقبل لنا؟ سيحكمنا الظّلام؟

168
00:13:35,410 --> 00:13:37,200
!مُحال أن نسمح بحدوث ذلك

169
00:13:37,200 --> 00:13:40,400
!لن ندعكم تفعلون ما يحلو لكم بهذا العالم

170
00:13:40,760 --> 00:13:43,310
!لن نخسر

171
00:13:47,670 --> 00:13:50,910
تابِعنَ وتحوّلن. لن نتحفّظ

172
00:13:59,820 --> 00:14:02,290
!موجة الشّفق الثنائيّة

173
00:14:16,910 --> 00:14:19,540
!مبعوثة النُّور، كيور بلاك

174
00:14:20,210 --> 00:14:23,010
!مبعوثة النُّور، كيور وايت

175
00:14:24,940 --> 00:14:26,950
!سوية، نحن بريكيور

176
00:14:28,210 --> 00:14:30,520
...يا خدم قوّة الظّلام

177
00:14:31,510 --> 00:14:33,820
!عودوا من حيث أتيتم

178
00:14:36,490 --> 00:14:38,060
!لومينوس

179
00:14:38,060 --> 00:14:40,640
!السّيل اللّامع

180
00:15:04,610 --> 00:15:07,320
!شرارة الحياة، لومينوس اللّامِعة

181
00:15:09,080 --> 00:15:11,630
!قلب النُّور وإرادة النُّور

182
00:15:11,890 --> 00:15:14,160
!لتوحيدهم جميعاً

183
00:15:40,350 --> 00:15:44,400
...مهما حاولتُم أن تقضوا على مستقبلنا

184
00:15:44,400 --> 00:15:46,100
!لن نستسلم أبداً

185
00:15:46,100 --> 00:15:48,260
...مراراً وتكراراً

186
00:15:48,260 --> 00:15:50,160
!سوف نتخلّص منكم

187
00:16:03,270 --> 00:16:04,390
!هيّا بنا

188
00:16:04,390 --> 00:16:05,180
!حسناً

189
00:16:30,670 --> 00:16:32,700
!من المُحال أن نخسر

190
00:16:33,470 --> 00:16:35,350
...لأنّنا حتّى إن لم نكن معاً

191
00:16:35,970 --> 00:16:37,990
!شيهو، الوسط

192
00:16:37,990 --> 00:16:39,440
!ميغومي

193
00:16:39,780 --> 00:16:41,410
!نقاتل ببسالة

194
00:16:41,680 --> 00:16:43,630
...لدينا فريق

195
00:16:46,010 --> 00:16:47,380
!يقاتل معنا

196
00:16:53,520 --> 00:16:54,490
!ماكي

197
00:16:54,490 --> 00:16:55,760
!ميغومي-سينباي

198
00:17:27,260 --> 00:17:29,840
...عالمنا وآمالنا وأحلامنا

199
00:17:29,840 --> 00:17:31,230
...بهجتنا وحزننا

200
00:17:31,590 --> 00:17:34,190
...مشاعرنا... وشغفنا

201
00:17:34,190 --> 00:17:36,680
...كلّ شيء

202
00:17:39,100 --> 00:17:41,590
!لن نتخلّى عنه

203
00:18:13,200 --> 00:18:16,020
!كصبِّ الطّعام على النّار

204
00:18:16,020 --> 00:18:18,420
"تقصدين "الزّيت

205
00:18:19,140 --> 00:18:20,040
!لومينوس

206
00:18:20,040 --> 00:18:20,930
!حسناً

207
00:18:23,610 --> 00:18:25,610
!اعملنَ معاً، بوبّو

208
00:18:32,250 --> 00:18:33,850
!الشّجاعة الفيّاضة

209
00:18:35,720 --> 00:18:37,320
!الأمل الغامِر

210
00:18:37,830 --> 00:18:40,160
!والرّوابط المُشعّة بالنُّور

211
00:18:41,230 --> 00:18:42,860
...إكستريم

212
00:18:42,860 --> 00:18:44,730
!لوميناريو

213
00:18:52,980 --> 00:18:54,140
!تفادوها

214
00:18:54,140 --> 00:18:57,000
!بلاك! وايت

215
00:18:58,340 --> 00:18:59,580
!لن تفلتوا

216
00:19:18,400 --> 00:19:19,950
!لننسحب

217
00:19:41,320 --> 00:19:43,590
!كدنا نهزمهن

218
00:19:44,130 --> 00:19:45,640
لستُ أفهم

219
00:19:50,470 --> 00:19:52,180
ينقصنا شيئاً

220
00:19:52,180 --> 00:19:54,790
...شيئاً مهمّاً جدّاً

221
00:20:10,250 --> 00:20:11,570
القائدة

222
00:20:13,160 --> 00:20:15,820
!لا تسمحنَ لـ 47 تُحرِز هدفاً

223
00:20:20,260 --> 00:20:21,690
...تبّاً

224
00:21:06,680 --> 00:21:08,370
أريد أن أقول شيئاً واحداً

225
00:21:09,410 --> 00:21:11,140
...في المرّة المُقبلة

226
00:21:11,710 --> 00:21:13,170
!سوف نهزمكن

227
00:21:13,170 --> 00:21:16,970
...خـ-خسرنا بالفعل من هذه النّاحية تحديداً

228
00:21:16,970 --> 00:21:19,710
!غالباً لن نملك فُرصة للفوز أصلاً

229
00:21:23,190 --> 00:21:25,050
تعاونكن كفريق مُبهِر

230
00:21:27,500 --> 00:21:29,390
!كانت مُباراة رائعة

231
00:21:33,700 --> 00:21:35,350
!لنلتقِ من جديد

232
00:21:36,470 --> 00:21:39,120
!كانت مُباراة شيّقة حقّاً

233
00:21:39,120 --> 00:21:43,670
!التصرُّف بشجاعة دائماً ما يُمهِّد طريقاً

234
00:21:44,220 --> 00:21:53,040
!هيّا، هيّا، فيروني! هيّا، هيّا، هيّا

235
00:21:44,310 --> 00:21:46,630
هارتييل جديدة؟

236
00:21:46,630 --> 00:21:50,040
!أكثر هارتييل شُجاعة، بريفن

237
00:21:50,040 --> 00:21:52,140
صوتهما مُرتفع، مِيبّو

238
00:21:52,750 --> 00:21:54,910
هدآتا الآن، بوبّو

239
00:21:58,530 --> 00:22:00,980
...ناغيسا هي دوماً مِحور الفريق

240
00:22:01,930 --> 00:22:05,450
تُوحّدنا معاً

241
00:23:57,470 --> 00:24:00,540
أنباء سيّئة! نسيتُ كتابة مقالتي
!الخاصّة بالصّحيفة تماماً

242
00:24:00,540 --> 00:24:02,330
!حسناً، كُلي هذا واهدئي

243
00:24:02,330 --> 00:24:04,270
!هذا الدّانغو رائع

244
00:24:04,270 --> 00:24:06,940
!حقّاً؟ اشتريتُه من مطعم دانغو محلّي أحبّه

245
00:24:06,940 --> 00:24:10,110
وجدتُها! سأكتب مقالة عن الزاكينّا
!في ذلك المحلّ

246
00:24:10,110 --> 00:24:11,310
!موزستحيل

247
00:24:11,310 --> 00:24:12,940
لماذا موز؟

248
00:24:12,940 --> 00:24:14,750
:نحن بريكيور ماكس هارت

249
00:24:18,020 --> 00:24:19,820
ما الشّيء المشترك بين صحفيّ وآيس كريم؟

250
00:24:19,820 --> 00:24:20,520
!ما الأمر؟

251
00:24:20,520 --> 00:24:22,060
"كِلاهما يحتاجان... "سكوب

252
00:24:22,060 --> 00:24:22,870
!أجل