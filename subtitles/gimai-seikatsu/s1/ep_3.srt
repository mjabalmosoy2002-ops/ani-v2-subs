1
00:00:10,740 --> 00:00:13,450
الخميس، 11 يونيو

2
00:00:17,340 --> 00:00:20,350
!ها هو أخوكِ الكبير

3
00:00:23,210 --> 00:00:28,290
آسفة. قالت مايا بأنّها أرادت
المجيء لرؤية منزلي الجديد

4
00:00:28,290 --> 00:00:33,000
،لم يكن لديّ رقم هاتفك النقّال
لذا جرّبتُ الاتّصال بهاتف المنزل

5
00:00:33,400 --> 00:00:36,050
غالباً كنتُ أستحمّ

6
00:00:36,650 --> 00:00:41,600
وأيضاً أخبرتُ مايا بأنّك وأنا شقيقان

7
00:00:41,600 --> 00:00:42,540
—لم أقصـ

8
00:00:42,540 --> 00:00:48,550
يبدو أنّها كانت تُراقب عندما أتيتَ
للتكلّم معي أثناء رياضة التّنس

9
00:00:49,590 --> 00:00:52,830
وعندما أعطيتني المِظلّة

10
00:00:56,180 --> 00:00:59,300
آسف. كان ينبغي أن أكون أكثر حذراً

11
00:01:02,300 --> 00:01:03,290
...حسناً

12
00:01:05,340 --> 00:01:07,370
هل يمكننا تبادل الأرقام؟

13
00:01:13,970 --> 00:01:14,880
ماذا؟

14
00:01:15,390 --> 00:01:16,910
!صباح الخير

15
00:01:16,910 --> 00:01:17,840
صباح الخير

16
00:01:18,350 --> 00:01:19,730
لماذا لستِ في السّرير؟

17
00:01:19,730 --> 00:01:21,970
واجهتُ صعوبة في النّوم

18
00:01:21,970 --> 00:01:25,880
وأيضاً قال تايتشي-سان بأنّه
،سيُغادر متأخِّراً اليوم

19
00:01:25,880 --> 00:01:28,230
لذا ارتأيتُ أن نأكل معاً

20
00:01:28,900 --> 00:01:29,900
سأساعدكِ

21
00:01:31,540 --> 00:01:32,480
شكراً لكِ

22
00:01:33,830 --> 00:01:37,190
مضى وقت منذ تناولنا الفطور معاً، صحيح؟

23
00:01:37,190 --> 00:01:38,010
صحيح

24
00:01:42,010 --> 00:01:44,450
إنّه النّعيم

25
00:01:44,950 --> 00:01:49,460
الحلقة 3: تأمُّل ومُراجعة

26
00:01:45,310 --> 00:01:47,200
!لا تكُن دراميّاً زيادة عن اللُّزوم

27
00:01:47,690 --> 00:01:48,670
لذيذة

28
00:01:51,670 --> 00:01:53,430
!معك حقّ! لذيذة

29
00:01:53,430 --> 00:01:55,240
هل هذه عجّة ملفوفة؟

30
00:01:55,940 --> 00:01:57,640
عجّة ملفوفة مع مرقة

31
00:01:57,640 --> 00:01:58,470
مع مرقة؟

32
00:01:59,210 --> 00:02:01,190
نُضيف مرقة داشي عند تحضيرها

33
00:02:02,370 --> 00:02:03,980
كالحساء للمعكرونة؟

34
00:02:03,980 --> 00:02:06,420
حسناً، نستخدم الداشي الأبيض في الواقع

35
00:02:06,420 --> 00:02:11,070
تعرف ساكي الوصفة. لِمَ لا تُعدّينها
له في المرّة المقبلة؟

36
00:02:11,070 --> 00:02:14,400
لكن لا أستطيع جعلها منفوشة هكذا

37
00:02:16,620 --> 00:02:19,540
أحبُّ البيض المقليّ العاديّ أيضاً

38
00:02:20,390 --> 00:02:21,530
حقّاً؟

39
00:02:22,140 --> 00:02:24,500
حسناً، ربّما سأحاول إذا كان
مِزاجي يسمح بذلك

40
00:02:28,760 --> 00:02:30,540
شكراً لك على المساعدة يا يوتا-كن

41
00:02:31,020 --> 00:02:32,570
لا عليكِ

42
00:02:33,060 --> 00:02:38,080
هل لديكِ مانع أن أضع ملابسكِ
مع غسيل هذا الأسبوع؟

43
00:02:38,690 --> 00:02:39,710
...هذا

44
00:02:40,180 --> 00:02:47,290
،في الواقع، إن كنت لا تُمانع يا يوتا-كن
يُسعدني أن أتولّى غسيل الملابس بنفسي

45
00:02:47,290 --> 00:02:50,110
ماذا؟ لا، لا أستطيع أن أدعكِ تفعلين ذلك

46
00:02:51,060 --> 00:02:55,770
.الكثير من الأقمشة حسّاسة جدّاً
هل تعرف كيفيّة استخدام حقيبة غسيل؟

47
00:02:56,130 --> 00:02:57,070
حقيبة غسيل؟

48
00:02:57,700 --> 00:03:01,720
إنّه مُؤلَّف من شبك معدنيّ لحماية
الملابس من الضّرر

49
00:03:02,220 --> 00:03:04,690
الضّرر؟

50
00:03:04,690 --> 00:03:07,870
من الصّعب شرح ذلك، لذا سنفعلها بأنفسنا

51
00:03:07,870 --> 00:03:09,190
حسناً

52
00:03:09,650 --> 00:03:14,940
.سأغسل الملابس التّحتيّة الخاصّة بتايتشي-سان
هل أغسل ملابسك التّحتيّة أيضاً يا يوتا-كن؟

53
00:03:15,320 --> 00:03:16,080
ماذا؟

54
00:03:24,900 --> 00:03:25,780
لحظة

55
00:03:27,020 --> 00:03:28,460
سأذهب معك

56
00:03:31,860 --> 00:03:33,400
أعتذر

57
00:03:33,400 --> 00:03:34,290
ماذا؟

58
00:03:34,290 --> 00:03:39,860
أعي بأنّ هناك احتمال أن تُفضِّل
الملابس التّحتيّة للنّساء

59
00:03:40,120 --> 00:03:42,290
هذا ليس مُستبعَداً

60
00:03:42,290 --> 00:03:43,030
ماذا؟

61
00:03:43,750 --> 00:03:48,100
رغم أنّني لطالما رفضتُ مبدأ
،تخصيص الأدوار لكل جنس

62
00:03:48,100 --> 00:03:50,540
افترضتُ تلقائيّاً بأنّك لا تُجيد غسل الملابس

63
00:03:50,540 --> 00:03:51,700
أياسي-سان؟

64
00:03:51,700 --> 00:03:54,860
،لم أرك تضع أحمر شفاه أو كريم أساس

65
00:03:54,860 --> 00:03:58,030
لكن قد تكون من النّوع الّذي يحبّ
أن يتزيّن سرّاً

66
00:03:58,030 --> 00:04:01,010
مهلاً. اهدئي لحظة يا أياسي-سان

67
00:04:01,010 --> 00:04:01,880
ماذا؟

68
00:04:12,460 --> 00:04:14,140
لقد هدئت

69
00:04:14,820 --> 00:04:15,820
حسناً

70
00:04:15,820 --> 00:04:17,810
،حتّى لو كنتَ مهتمّاً باللّباس المُغاير للجنس

71
00:04:17,810 --> 00:04:20,490
فهذا لا يعني أنّك تقوم بذلك فعليّاً

72
00:04:22,450 --> 00:04:26,920
،أنا لا أرتدي لِباساً مُغايراً
ولا أتزيّن بشكل سرّي

73
00:04:26,920 --> 00:04:29,910
لكن حاجبيك مرسومان بشكل جميل

74
00:04:30,500 --> 00:04:31,360
ماذا؟

75
00:04:31,360 --> 00:04:34,280
لا بدّ أنّك ترسمهما، صحيح؟
هل تذهب إلى صالون تجميل؟

76
00:04:34,280 --> 00:04:35,630
محلّ حِلاقة

77
00:04:35,630 --> 00:04:38,870
ماذا؟ تقصد أنَّ حاجبيك طبيعيّان تماماً؟

78
00:04:39,620 --> 00:04:40,830
أجل

79
00:04:41,960 --> 00:04:43,690
أغار منك

80
00:04:47,640 --> 00:04:51,770
ألا تعتقد أنَّه من الصّعب فرض الاختلافات
الجنسيّة ضمن صنيفين فقط؟

81
00:04:51,770 --> 00:04:53,900
أجل، هذا ما أعتقده

82
00:04:54,660 --> 00:05:01,340
لكن في السّابق، لم تخطر تلك
الفكرة على ذهني

83
00:05:02,290 --> 00:05:04,390
لستُ قلقاً بشأن ذلك صدّقيني

84
00:05:05,670 --> 00:05:07,530
شكراً. أنا ممتنّة

85
00:05:08,120 --> 00:05:11,020
لكن لا أستطيع مسامحة نفسي

86
00:05:11,370 --> 00:05:13,180
لهذا أردتُ الاعتذار

87
00:05:18,250 --> 00:05:20,310
أحياناً نفعل الأشياء بصورة انعكاسيّة

88
00:05:20,310 --> 00:05:22,680
انعكاسيّة؟ كما الضّوء؟

89
00:05:22,680 --> 00:05:26,000
لا، لا أقصد ذلك. أتحدّث عن المُنعكسات الاعتياديّة

90
00:05:28,740 --> 00:05:34,730
أعتقد أحياناً يقول المرء أو يفعل أشياء
بصورة غريزيّة دون أن يعي ذلك

91
00:05:35,140 --> 00:05:40,190
أنا متأكّد بأنّ القدرة على الاستجابة انعكاسيّاً
بهذا الشّكل مفيدة في ظروف مُعيّنة

92
00:05:40,740 --> 00:05:43,830
لكن رغم ذلك، الحكم المسبق
يؤدّي إلى التّمييز

93
00:05:47,000 --> 00:05:49,290
لهذا علينا إعادة النّظر في الأمور

94
00:06:00,920 --> 00:06:05,180
أياسي-سان، لقد أعدتِ النّظر بالفعل
وتأمّلتِ ما فعلتِه قبل مدّة

95
00:06:05,630 --> 00:06:09,930
بما أنّكِ فعلتِ ذلك، فلا أعتقد أنّكِ بحاجة
للاستمرار في القلق بشأن ذلك

96
00:06:12,730 --> 00:06:13,810
...شخصيّاً

97
00:06:14,530 --> 00:06:19,390
لا أعتقد بأنّكِ من النّوع الّذي لا يستطيع
التأمُّل والتعلُّم ممّا فعلتِه

98
00:06:20,190 --> 00:06:25,110
للدرّاجات الهوائيّة فقط

99
00:06:29,630 --> 00:06:30,810
أياسي-سان؟

100
00:06:34,970 --> 00:06:38,000
...أسامورا-كن، أنت حقّاً

101
00:06:45,500 --> 00:06:48,510
تفهمني جيّداً

102
00:07:01,260 --> 00:07:02,440
!حسناً، هيّا بنا

103
00:07:23,140 --> 00:07:24,460
عُدت من الآن

104
00:07:26,910 --> 00:07:28,170
ماذا؟

105
00:07:28,170 --> 00:07:30,970
لا، لا شيء. لا تقلقي بشأن ذلك

106
00:07:30,970 --> 00:07:31,720
حقّاً؟

107
00:07:31,720 --> 00:07:33,930
لديّ عمل اليوم

108
00:07:43,560 --> 00:07:47,070
رأيتني، أليس كذلك؟

109
00:07:46,120 --> 00:07:50,320
،كنت تنظر للملابس الدّاخليّة المُعلّقة إذاً

110
00:07:50,320 --> 00:07:54,430
لهذا السّبب، عندما فاجأتُك، انتبهت وهربت

111
00:07:55,100 --> 00:07:59,600
هل ظننتَ بأنّني سأعتقد بأنّك
كنتَ ستدخل وتسرقها؟

112
00:07:59,600 --> 00:08:01,990
في الواقع... ربّما

113
00:08:02,900 --> 00:08:04,980
رغم أنّها ملابس أختك الصّغرى؟

114
00:08:04,980 --> 00:08:08,010
أجل. أعي ذلك

115
00:08:09,230 --> 00:08:11,960
آسفة. كان ذلك غير مُنصِف

116
00:08:12,310 --> 00:08:12,970
ماذا؟

117
00:08:13,560 --> 00:08:15,140
تفضّل. كاكاو

118
00:08:16,150 --> 00:08:18,970
ألا تريد؟ يمكنني إعادته

119
00:08:18,970 --> 00:08:22,220
لا، لا مُشكلة. سأشربه

120
00:08:24,760 --> 00:08:27,470
أعتقد هذا يجعلنا مُتعادلَين الآن

121
00:08:27,470 --> 00:08:27,940
ماذا؟

122
00:08:28,910 --> 00:08:33,430
تحوُّل أنظارك نحو ملابسي الدّاخليّة
هو ردّة فعل انعكاسيّة أخرى

123
00:08:34,190 --> 00:08:39,520
لكن لا أظنّك من النّوع الّذي لا يستطيع
التأمُّل والتعلُّم ممّا فعلته

124
00:08:43,100 --> 00:08:45,450
حسناً، هذا مُطمئن

125
00:08:46,420 --> 00:08:52,190
هل هذا يعني إذاً أنّ ملابسي الدّاخليّة
كانت مُغرية بما يكفي لتُلفِت نظرك؟

126
00:08:52,190 --> 00:08:54,110
لم أقل ذلك

127
00:08:54,110 --> 00:08:57,520
لم تكن مُغرية إطلاقاً إذاً؟

128
00:08:58,170 --> 00:09:00,960
هل تستفزّينني الآن؟

129
00:09:01,310 --> 00:09:02,850
لا أدري

130
00:09:03,980 --> 00:09:08,690
لكن لا يمكنك أن تنكر أنَّ فكرة سرِقة ملابسي
الدّاخليّة لم تخطر على ذهنك، صحيح؟

131
00:09:08,690 --> 00:09:12,440
أكذب إذا قلتُ بأنّني لم أشعر
،بأي حافز لأخذها

132
00:09:12,440 --> 00:09:14,590
لكن هذا لا يعني أن أتصرّف بناء على ذلك

133
00:09:15,420 --> 00:09:18,490
شعرتَ بحافز إذاً

134
00:09:19,140 --> 00:09:23,920
امتلاك الحافز لفعل شيء والتصرّف
بناء على ذلك الحافز أمران مُختلِفان

135
00:09:26,870 --> 00:09:28,090
معك حقّ

136
00:09:28,090 --> 00:09:30,880
آسفة. لننسَ ذلك

137
00:09:31,290 --> 00:09:34,880
تناولُ العشاء واستحممت بالفعل

138
00:09:35,420 --> 00:09:37,600
ماذا؟ حسناً

139
00:09:38,350 --> 00:09:39,010
تصبح على خير

140
00:09:40,790 --> 00:09:41,950
تصبحين على خير

141
00:09:46,270 --> 00:09:49,270
الجمعة، 12 يونيو

142
00:09:55,630 --> 00:09:57,150
مرحباً يا أخي الكبير

143
00:09:58,390 --> 00:10:00,100
ليس في المدرسة

144
00:10:00,100 --> 00:10:01,720
هل حدث شيء لساكي؟

145
00:10:01,720 --> 00:10:02,450
ماذا؟

146
00:10:02,450 --> 00:10:06,380
كانت كذلك منذ هذا الصّباح

147
00:10:11,960 --> 00:10:14,420
تبدو حزيناً. هل حدث شيء؟

148
00:10:17,360 --> 00:10:18,200
!ها هي ذي

149
00:10:22,140 --> 00:10:25,020
لا

150
00:10:28,420 --> 00:10:31,660
لَحِقَ أبي بالقطار الأخير إلى المنزل

151
00:10:31,660 --> 00:10:32,420
حسناً

152
00:11:14,020 --> 00:11:17,430
آسف. لم أجد بعد عملاً براتب جيّد لكِ

153
00:11:18,190 --> 00:11:20,820
لم أتوقّع أن تجد واحداً فوراً

154
00:11:20,820 --> 00:11:26,840
لكن على هذا المُعدّل، تُعدِّين
لي العشاء مقابل لا شيء

155
00:11:27,270 --> 00:11:30,460
،إن أردتِني أن أقدّم مزيداً من المساعدة
فقولي ذلك بلا تردُّد

156
00:11:31,560 --> 00:11:32,360
حسناً

157
00:13:35,420 --> 00:13:36,460
...أسامورا-كن

158
00:13:39,960 --> 00:13:43,460
...هل ترغب في شراء

159
00:13:47,220 --> 00:13:48,970
جسدي؟

160
00:14:31,760 --> 00:14:34,010
أياسي          أسامورا

161
00:14:37,020 --> 00:14:40,300
الأحد، 7 يونيو

162
00:14:44,840 --> 00:14:48,380
أنا مُطمئنّة بصراحة

163
00:14:48,900 --> 00:14:53,400
عرفتُ حالما تعرّفنا على بعضنا
بأنّه ليس شخصاً سيّئاً

164
00:14:54,070 --> 00:14:57,240
وبأنّه لطيف أيضاً

165
00:14:58,660 --> 00:15:03,830
إنّه من الأشخاص الّذين يملئون حوض
الاستحمام لي عندما ينتهي

166
00:15:05,170 --> 00:15:08,880
ولم أتوقّع أبداً بأنّه يرتاد سويسي أيضاً

167
00:15:14,260 --> 00:15:16,260
الإثنين، 8 يونيو

168
00:15:14,970 --> 00:15:17,660
الاثنين، 8 يونيو

169
00:15:18,230 --> 00:15:21,460
أتى أسامورا-كن وتكلّم معي في المدرسة

170
00:15:22,270 --> 00:15:26,270
إنّه مُتّزن العقل أكثر ممّا توقّعت

171
00:15:27,720 --> 00:15:31,910
أنا منزعجة قليلاً من تصديقه
،الإشاعات المُتعلِّقة بي

172
00:15:32,580 --> 00:15:34,820
لكن لا ألومه بصراحة

173
00:15:36,210 --> 00:15:39,030
أعرف نظرة النّاس لي

174
00:15:40,140 --> 00:15:45,790
لكنّه غَضِبَ وعَلِمَ بأنّني كنتُ
غاضبة بسبب ذلك أيضاً

175
00:15:46,600 --> 00:15:52,330
قد تكون هذه المرّة الأولى الّتي يفهم
فيها شخصٌ مشاعري بسهولة

176
00:15:54,180 --> 00:15:57,620
الثّلاثاء، 9 يونيو

177
00:15:58,280 --> 00:16:02,440
مُلاحظة صغيرة: أسامورا-كن يحبّ
البيض المقليّ مع صلصة الصّويا

178
00:16:04,030 --> 00:16:05,880
اليوم، سأبدأ بالطّبخ

179
00:16:05,880 --> 00:16:10,130
يحاول أسامورا-كن إيجاد عمل
،بأجرٍ مرتفع لأجلي

180
00:16:10,130 --> 00:16:13,380
لذا أشعر بأنّ هذا أقلّ ما يمكنني فعله

181
00:16:15,880 --> 00:16:20,580
بدا آسِفاً عندما أخبرني بأنّه
،لم يعثر على عملٍ لي بعد

182
00:16:21,770 --> 00:16:26,760
لكن كنتُ أعلم أنّ الأمر
لن يكون بتلك السّهولة

183
00:16:29,330 --> 00:16:33,180
الطّريقة الصّحيحة للاعتماد على النّاس؟

184
00:16:34,190 --> 00:16:37,100
إذا استطعتُ فعل ذلك، فأجل

185
00:16:39,600 --> 00:16:41,600
الأربعاء، 10 يونيو

186
00:16:53,880 --> 00:16:56,900
الأربعاء، 10 يونيو

187
00:16:57,620 --> 00:17:00,620
كنتُ أستمع للموسيقى

188
00:16:59,260 --> 00:17:00,620
أنا مُحرَجة للغاية

189
00:17:00,620 --> 00:17:02,370
أعتذر لأنّني لم أكن منتبهة

190
00:17:01,470 --> 00:17:03,690
...لم أتوقّع أبداً أن يسألني

191
00:17:04,660 --> 00:17:06,620
دروس إنجليزي؟

192
00:17:05,020 --> 00:17:06,620
لا أريده أن يرى

193
00:17:06,620 --> 00:17:09,130
ما الفرق الّذي يُشكّله ذلك؟

194
00:17:07,250 --> 00:17:10,580
كم أبذل من جهد. أعلم
أنّ هذا ليس لائقاً

195
00:17:15,330 --> 00:17:17,920
أتت مايا لتزورني في منزلي الجديد

196
00:17:18,640 --> 00:17:21,900
لعِبنا نحن الثّلاثة ألعاب الفيديو وضحِكنا كثيراً

197
00:17:22,640 --> 00:17:24,640
لم أضحك هكذا منذ مدّة طويلة

198
00:17:27,110 --> 00:17:29,360
تبادلنا معلومات الاتّصال

199
00:17:30,150 --> 00:17:34,120
يستخدم أسامورا-كن صورة منظر
طبيعيّ كصورة شخصيّة

200
00:17:33,650 --> 00:17:36,150
أسامورا يوتا

201
00:17:34,120 --> 00:17:35,260
لستُ متفاجئة

202
00:17:36,150 --> 00:17:39,660
الخميس، 11 يونيو

203
00:17:40,990 --> 00:17:42,660
قال بأنّه ما كان ليفعل ذلك

204
00:17:43,480 --> 00:17:49,230
قال بأنَّ امتلاك حافِز والتصرّف بناء
عليه أمران مختلفان

205
00:17:51,420 --> 00:17:54,080
يراودني نفس الشّعور تماماً

206
00:17:54,960 --> 00:17:58,890
بدأتُ أدرك أنَّ في كلّ مرّة يُشارك فيها
،أسامورا-كن أفكاره

207
00:17:58,890 --> 00:18:02,180
أتمكّن دوماً من تأييدها وتفهّمها

208
00:18:00,050 --> 00:18:04,970
للدرّاجات الهوائيّة فقط

209
00:18:04,670 --> 00:18:08,910
لهذا يبدو هذا مناسباً على الأغلب

210
00:18:20,270 --> 00:18:22,990
أسامورا-كن خطير

211
00:18:23,990 --> 00:18:27,500
إنّه خير من يفهمني

212
00:18:31,080 --> 00:18:33,500
...أياسي-سان، الآن

213
00:18:34,060 --> 00:18:36,970
تصرّفين تماماً كفتاة أكرهها

214
00:18:41,220 --> 00:18:44,520
...إنَّ استخدام المظهر كسِلاح للتقدُّم

215
00:18:44,520 --> 00:18:46,590
ظننتُ بأنّكِ لا تريدين أن يُنظَر إليكِ هكذا

216
00:18:47,910 --> 00:18:52,020
إذا لم تستطيعي إثبات خطأ نظرة الآخرين
،بطريقة لا تعتمد على كونكِ امرأة

217
00:18:52,020 --> 00:18:53,290
فما المغزى إذاً؟

218
00:18:55,590 --> 00:18:56,400
...لكن

219
00:18:57,290 --> 00:19:00,500
—قلتُ لنفسي بما أنّك تفهم هذا القدر

220
00:19:00,500 --> 00:19:02,330
الأمر لا يتعلّق بي أنا

221
00:19:04,040 --> 00:19:04,660
...إنّه

222
00:19:07,130 --> 00:19:08,980
مُتعلِّق بكِ يا أياسي-سان

223
00:19:19,190 --> 00:19:21,360
أنا آسفة

224
00:19:23,930 --> 00:19:27,680
أياسي          أسامورا

225
00:19:27,110 --> 00:19:31,660
أعتقد كان أبي شخصاً لطيفاً

226
00:19:32,290 --> 00:19:36,390
،لكن بعد أن فشلت شركته
لم يعُد يثِق بالنّاس

227
00:19:37,610 --> 00:19:42,810
بدأت أمِّي بمُضاعفة جهودها في العمل
،لتأمين معيشتي

228
00:19:43,660 --> 00:19:47,800
لكن بدا أنّه غير راضٍ عن ذلك أيضاً

229
00:19:50,090 --> 00:19:55,000
"كان يقول لها، "لستِ سوى بائعة هوى

230
00:19:56,170 --> 00:19:59,960
"تستخدمين جسدكِ لجذب الزّبائن"
وكلام مُهين آخر

231
00:20:01,300 --> 00:20:04,220
،أتفهّم بأنّه كان يواجه وقتاً عصيباً

232
00:20:05,510 --> 00:20:08,730
لكن هذا لا يعني أنّ يحرّر
غضبه على أمّي

233
00:20:14,180 --> 00:20:15,970
أتّفق تماماً

234
00:20:15,970 --> 00:20:16,730
ماذا؟

235
00:20:17,470 --> 00:20:21,670
حسناً... هذا ما حدث لنا تقريباً أيضاً

236
00:20:22,770 --> 00:20:25,380
،بعد أن خانت أمّي أبي

237
00:20:25,380 --> 00:20:28,870
أصبح شديد الارتياب من النّاس لبعض الوقت

238
00:20:28,870 --> 00:20:30,330
أبوك؟

239
00:20:37,210 --> 00:20:39,290
وربّما أنت أيضاً؟

240
00:20:45,750 --> 00:20:48,260
أنت وأنا لدينا أمور مشتركة كثيرة

241
00:20:50,060 --> 00:20:52,080
بما في ذلك الأمور الجارحة

242
00:20:54,840 --> 00:20:56,170
قد تكونين على حقّ

243
00:20:58,890 --> 00:21:04,410
لكن حتّى مع هذه الأمور الجارحة، يراودني
إحساس بأنّنا سنتمكّن من الانسجام جيّداً

244
00:21:08,220 --> 00:21:10,150
كأخ وأخت

245
00:21:17,850 --> 00:21:23,050
اسمعي. لا أمانع إن كنتِ تريدين أن تبدئي
"بمُناداتي بـ"أخي الكبير

246
00:21:34,890 --> 00:21:36,080
شكراً

247
00:21:38,830 --> 00:21:39,810
أياسي-سان؟

248
00:21:44,100 --> 00:21:47,450
لنتجاوز هذا معاً بنجاح يا أسامورا-كن

249
00:21:48,950 --> 00:21:54,720
السّبت، 13 يونيو

250
00:21:55,350 --> 00:21:59,050
.أكلتُ أنا وأسامورا-كن العشاء معاً
نحن الاثنان فقط

251
00:21:59,610 --> 00:22:04,210
تمكنّا من إقناع والدينا بالخروج
للأكل ولو لمرّة واحدة

252
00:22:06,270 --> 00:22:08,490
كانت فكرة أسامورا-كن في الواقع

253
00:22:09,210 --> 00:22:13,220
إنّه مُراعٍ لمشاعر الآخرين حقّاً

254
00:22:24,700 --> 00:22:29,240
"لهذا بالضّبط لا ينبغي أن أناديه "أخي الكبير

255
00:22:31,070 --> 00:22:33,120
،حالما أبدأ بمُناداته بذلك

256
00:22:33,950 --> 00:22:38,230
سأبدأ بالاعتماد عليه في كلّ شيء غالباً

257
00:22:38,230 --> 00:22:40,120
لا أسمح لنفسي بفعل ذلك حتماً

258
00:22:41,880 --> 00:22:44,380
أعلم أنّه من الغريب تناول خبز محمّص بعجّتك الملفوفة مع مرقة

259
00:22:42,330 --> 00:22:44,070
أنا آسفة يا أسامورا-كن

260
00:22:44,630 --> 00:22:46,380
هذا ليس غريباً إطلاقاً يا أياسي-سان

261
00:22:46,460 --> 00:22:47,510
!أنا في غاية السّرور

262
00:22:47,160 --> 00:22:51,100
،"لكن كلّما ناديتُه "أسامورا-كن

263
00:22:47,760 --> 00:22:50,260
يبدو هذا رائعاً يا يوتا

264
00:22:50,260 --> 00:22:51,390
هلّا شاركت هذا مع أبيك؟

265
00:22:51,430 --> 00:22:53,370
يراودني هذا الشُّعور الّذي لا يوصف في صدري

266
00:22:53,370 --> 00:22:58,550
شعور مختلف تماماً عمّا عن شعوري
عندما أناديه بأخي

267
00:23:00,190 --> 00:23:02,970
لم يساورني هذا الشُّعور من قبل

268
00:23:03,500 --> 00:23:07,180
لا أعرف ماذا أسمّيه حتّى

269
00:23:07,950 --> 00:23:11,320
سرعان ما وجدتُ نفسي أضمر
المشاعرَ لأسامورا-كن

270
00:23:11,780 --> 00:23:13,160
عقلي مُشوّش

271
00:23:13,890 --> 00:23:17,370
مؤخّراً، حتّى وأنا في السّرير، أعاني
من صعوبة في النّوم

272
00:23:17,910 --> 00:23:23,760
.وأنا الّتي تريد أن تعيش باستقلاليّة
بدأتُ أشمئزّ من نفسي

273
00:23:24,580 --> 00:23:27,440
ما الّذي يصيبني؟

274
00:23:31,530 --> 00:23:32,670
...بالفعل

275
00:23:46,480 --> 00:23:49,990
الحلقة 14: نزعات واستراتيجيّات