1
00:01:30,360 --> 00:01:34,490
الحلقة 11: أخٌ وأخت

2
00:01:32,270 --> 00:01:34,880
أليس اجتماع المُعلّمين وأولياء
الأمور الخاص بكما هو اليوم؟

3
00:01:34,880 --> 00:01:35,670
بلى

4
00:01:36,560 --> 00:01:37,610
هل تريدين أن تأكلي؟

5
00:01:37,610 --> 00:01:42,740
،أجل، من فضلكِ. أردتُ مزيداً من الوقت للنّوم
لذا لم آكل في طريق العودة إلى المنزل

6
00:01:42,740 --> 00:01:44,870
إن خلدتِ إلى النّوم الآن، هل ستنهضين في الوقت؟

7
00:01:44,870 --> 00:01:50,380
حسناً، هذا ما أعتقده. لنرَ... دعني
أراجع الأمور مرّة أخرى

8
00:01:50,750 --> 00:01:53,820
يوتا-كن، اجتماعك على السّاعة 4:20، صحيح؟

9
00:01:53,820 --> 00:01:54,610
أجل

10
00:01:54,610 --> 00:01:58,600
وساكي... اجتماعكِ على 4:40؟
هل كلامي صحيح؟

11
00:01:58,600 --> 00:01:59,640
أجل

12
00:02:00,320 --> 00:02:02,520
لن تحظي بما يكفي من نوم إذاً

13
00:02:02,520 --> 00:02:04,880
سأكون بخير ما دمتُ أستيقظ على الثّانية

14
00:02:05,290 --> 00:02:11,020
المُشكلة الوحيدة هي أنّه لن يكون هناك
أحد في المنزل خلال هذه الفترة

15
00:02:11,380 --> 00:02:13,840
إذا أردتِ، يمكنني الاتّصال بكِ

16
00:02:13,840 --> 00:02:15,780
!شكراً لك يا تايتشي-سان

17
00:02:16,030 --> 00:02:20,280
.أمّي، لدى أبي عمل أيضاً
لا تُضايقيه

18
00:02:21,750 --> 00:02:24,030
لا مُشكلة! هذا ليس بالأمر الجلل

19
00:02:24,570 --> 00:02:28,110
إذاً أعتمد عليك في مُكالمة
!إيقاظ قاسية جدّاً

20
00:02:28,110 --> 00:02:28,780
حسناً

21
00:02:35,250 --> 00:02:37,150
ماذا تفعل؟

22
00:02:38,290 --> 00:02:42,080
.لا شيء. أمضي الوقت فحسب
اجتماعي هو اليوم

23
00:02:42,080 --> 00:02:45,300
أنت أيضاً؟ كم السّاعة؟

24
00:02:45,300 --> 00:02:47,010
السّاعة 4:20

25
00:02:47,010 --> 00:02:49,620
اقترب اجتماعنا. اجتماعي على السّاعة 4:00

26
00:02:50,710 --> 00:02:55,050
،لكن إذا كان متأخّراً إلى هذا الحدّ
بوسعك العودة إلى المنزل أوّلاً، صحيح؟

27
00:02:55,050 --> 00:02:56,760
أعلم أنّ ساكي فعلت ذلك

28
00:02:57,310 --> 00:02:58,010
ماذا؟

29
00:02:59,990 --> 00:03:05,490
عليّ الذّهاب إلى المنزل لأنّني نسيتُ شيئاً

30
00:03:05,990 --> 00:03:09,500
سأسبقك

31
00:03:09,500 --> 00:03:12,000
،وأوقظ أمّي

32
00:03:12,000 --> 00:03:16,000
وأوقظ أمّي، لذا لا داعي للقلق

33
00:03:16,500 --> 00:03:19,010
!شكراً لك

34
00:03:19,010 --> 00:03:21,260
!شكراً لك! أقدّر ذلك

35
00:03:19,130 --> 00:03:21,260
هل تسمعني حتّى؟

36
00:03:21,260 --> 00:03:24,440
آسف. ماذا؟

37
00:03:24,440 --> 00:03:29,740
كنتُ أقول فقط... بأنّك مهتمّ بساكي، صحيح؟

38
00:03:29,740 --> 00:03:30,660
لا، لستُ كذلك

39
00:03:31,140 --> 00:03:32,350
هل هذه هي الحقيقة؟

40
00:03:33,020 --> 00:03:36,490
تعلمين بأنّني وأياسي-سان أخوان

41
00:03:38,990 --> 00:03:42,030
ما زلت تُناديها "أياسي-سان" حتّى الآن

42
00:03:43,110 --> 00:03:46,190
لكنّكما أخوان غير شقيقين، صحيح؟

43
00:03:46,190 --> 00:03:51,280
وحدث ذلك عمليّاً فحسب، لذا
ألستُما بمثابة غريبين؟

44
00:03:51,280 --> 00:03:53,880
أقول لكِ بأنّ الأمر ليس كذلك

45
00:03:54,550 --> 00:03:56,240
ليس كذلك؟

46
00:04:02,280 --> 00:04:05,060
إذاً هل يمكنني تشجيع أحد آخر؟

47
00:04:06,660 --> 00:04:08,060
...المعذرة

48
00:04:08,530 --> 00:04:11,440
،إذا عرفتُ شخصاً آخر يحبُّ ساكي

49
00:04:11,440 --> 00:04:15,120
فهل يمكنني التّوفيق بينهما؟
هذا هو سؤالي

50
00:04:17,390 --> 00:04:21,290
هذا ليس شيئاً يجدر بكِ أن تطلبي
إذني للقيام به

51
00:04:22,590 --> 00:04:24,390
ليس كذلك؟

52
00:04:24,920 --> 00:04:25,640
لا

53
00:04:29,780 --> 00:04:33,690
إذاً أنتما لم تُصادفا بعضكما الآخر
في المدرسة من قبل؟

54
00:04:33,690 --> 00:04:39,180
ربّما حدث ذلك. لا أتذكّر فحسب

55
00:04:39,180 --> 00:04:43,720
يا لك من رجل مُهذّب. أنت لا تنظر
للفتيات الجميلات حتّى؟

56
00:04:44,570 --> 00:04:47,240
لا تكون النّتائج حميدة إذا فعلتُ
ذلك في هذه الأيّام

57
00:04:47,240 --> 00:04:50,490
حسناً، ما دام لا يخطر على ذهنك أفكار
غريبة، لا أعتقد بأنّهن سيُمانعن

58
00:04:50,490 --> 00:04:53,970
هل يمكنكِ أن تميّزي حقّاً فيما إذا
كان شخص تُراوده أفكار غريبة؟

59
00:04:53,970 --> 00:04:55,730
!بالطّبع

60
00:04:55,730 --> 00:04:57,160
تبدين واثقة تماماً

61
00:04:57,160 --> 00:05:01,860
،لا مُشكلة. إذا كان هناك سوء فهم
فيجب عليك أن تعتذر فحسب

62
00:05:02,340 --> 00:05:04,010
لا يؤثّر بكِ شيء

63
00:05:05,930 --> 00:05:06,850
هذه هي

64
00:05:06,850 --> 00:05:07,990
شكراً لك

65
00:05:09,620 --> 00:05:10,700
،يوتا-كن

66
00:05:11,890 --> 00:05:14,120
سأفعل ما بوسعي، اتّفقنا؟

67
00:05:18,180 --> 00:05:19,900
أشكركِ

68
00:05:25,330 --> 00:05:28,980
لذا، باختصار، إذا ظلّ يواظب
،على هذا العمل بجدّ هكذا

69
00:05:28,980 --> 00:05:32,500
فلا ينبغي أن تكون لديه أي مُشكلة
في الالتحاق بجامعة شهيرة في طوكيو

70
00:05:32,930 --> 00:05:34,640
حقّاً؟

71
00:05:35,860 --> 00:05:40,700
أنا متأكّد لأنّكِ أبليتِ بلاء حسناً في تربيته

72
00:05:42,750 --> 00:05:43,320
...الـ

73
00:05:43,320 --> 00:05:46,730
أجل. أنا ممتنّ جدّاً لأمّي

74
00:05:51,410 --> 00:05:54,610
ثمّ يجب عليك أن تقرّر فحسب
المكان الّذي ستتقدّم له

75
00:05:54,610 --> 00:05:58,100
ستحصل على ختم مُوافقتي
أينما أردت الذّهاب

76
00:05:58,100 --> 00:05:59,500
شكراً جزيلاً لك

77
00:06:02,510 --> 00:06:04,620
غرفة صفّ أياسي-سان من هنا

78
00:06:04,620 --> 00:06:09,630
من الأفضل أن أسرع. أيضاً، شكراً لك
!على ما قلته يا يوتا-كن

79
00:06:09,630 --> 00:06:12,010
!أنا سعيدة جدّاً لاعتبارك إيّاي أمّك

80
00:06:12,010 --> 00:06:14,610
لا تشدّي ذِراعي رجاء

81
00:06:14,610 --> 00:06:17,620
!تُغرغر الدّمعة في عيني

82
00:06:17,620 --> 00:06:19,200
...يا إلهي

83
00:06:19,200 --> 00:06:21,260
يوتا-كن، ماذا تريد على العشاء؟

84
00:06:21,260 --> 00:06:23,240
...في الواقع

85
00:06:23,240 --> 00:06:26,090
أ-أوّلاً، هل تُمانعين أن تدعيني وشأني؟

86
00:06:29,530 --> 00:06:31,900
،إذا أردتِ الصّدق

87
00:06:31,900 --> 00:06:36,080
كنتُ قلقة بعض الشّيء بشأن
ساكي-سان أثناء الفصل الأوّل

88
00:06:37,150 --> 00:06:40,190
كانت هناك بعض الإشاعات السيّئة
تدور حول سلوكها

89
00:06:41,950 --> 00:06:44,720
لكن أرى الأمور مُختلِفة الآن

90
00:06:45,910 --> 00:06:51,460
من الواضح لي من خلال مُراقبة ساكي-سان
بأنّها ليست كما قيل عنها في الإشاعات

91
00:06:52,130 --> 00:06:55,720
أعلم بأنّ هناك مُعلّمين آخرين يقولون
،هذا أو ذاك عن مظهرها

92
00:06:56,030 --> 00:06:59,820
لكن أتفهّم الرّغبة في التأنُّق
والظّهور بأبهى حلّة

93
00:07:01,800 --> 00:07:02,980
سأقول شيئاً واحداً فقط

94
00:07:03,530 --> 00:07:07,350
حاولي الالتزام بالحدود المعقولة
كتلميذة مدرسة ثانويّة

95
00:07:08,280 --> 00:07:09,360
حسناً

96
00:07:10,450 --> 00:07:13,620
والآن، لنتكلّم عن مخطّطاتكِ المستقبليّة

97
00:07:14,300 --> 00:07:19,120
علاماتكِ في فنون اللّغة بدأت
تتحسّن في الفصل الثّاني

98
00:07:19,550 --> 00:07:22,410
هل فكّرتِ في كلّيات ترغبين
في التقدُّم إليها؟

99
00:07:23,220 --> 00:07:26,140
أرغب في البحث عن واحدة
ذات تكاليف تدريس منخفضة

100
00:07:26,140 --> 00:07:30,250
وتوفّر لي مكاناً جيّداً في سوق العمل

101
00:07:34,810 --> 00:07:37,390
ما رأيكِ بكلّية تسوكينوميا للإناث إذاً؟

102
00:07:37,900 --> 00:07:40,340
تسوكينوميا؟

103
00:07:40,870 --> 00:07:44,360
...سمعتُ بأنّها مرموقة. لستُ أدري فيما إذا كنتُ

104
00:07:44,910 --> 00:07:48,640
بأدائكِ الحاليّ، أعتقد بأنّ لديكِ
فُرصة إذا ضاعفتِ جهودكِ

105
00:07:49,060 --> 00:07:51,540
سيمنحكِ هذا دُفعة حتماً في سوق العمل

106
00:07:53,900 --> 00:07:59,160
.إنّها مدرسة عامّة، لذا فأجور التّدريس مُنخفض
قد تكون ما تبحثين عنه بالضّبط

107
00:08:00,390 --> 00:08:02,920
لم أفكّر في الأمر حتّى

108
00:08:03,550 --> 00:08:04,880
لِمَ لا تذهبين وترينها؟

109
00:08:06,370 --> 00:08:10,350
انظري. لديهم حتّى حدث حرم
مفتوح في عطلة هذا الأسبوع

110
00:08:14,260 --> 00:08:16,680
حدود معقولة؟

111
00:08:16,680 --> 00:08:21,750
أعتقد إذا حاولتِ أن تكوني معقولة زيادة
عن اللّزوم، فستُصابين بجنون

112
00:08:22,680 --> 00:08:24,440
ماذا؟

113
00:08:24,440 --> 00:08:25,690
لا شيء

114
00:08:27,050 --> 00:08:29,000
حسناً، ماذا ستفعلين؟

115
00:08:29,660 --> 00:08:31,690
سأذهب غداً

116
00:08:32,510 --> 00:08:36,200
سأتفقّد الحرم المفتوح بنفسي

117
00:08:38,110 --> 00:08:39,200
هكذا إذاً

118
00:08:39,200 --> 00:08:45,070
تسوكينوميا، صحيح؟ أنا مُتحمّسة جدّاً
!لأنّ طِفلَي تلميذان مُجتهدان

119
00:08:45,070 --> 00:08:49,540
قيل ليوتا-كن بأنّه يستطيع
الالتحاق بأي مدرسة يريد

120
00:08:50,780 --> 00:08:55,700
واسمعي هذه! قال المُعلّم الخاصّ
...بيوتا-كن بأنّه

121
00:09:05,730 --> 00:09:11,860
الاستقبال

122
00:09:05,730 --> 00:09:11,860
السّبت، 26 سبتمبر

123
00:09:06,290 --> 00:09:07,450
يوميوري-سان؟

124
00:09:07,450 --> 00:09:11,860
مُذهل! أتيت لزيارتي في الكلّية؟
!أنا سعيدة للغاية

125
00:09:12,280 --> 00:09:15,360
!لو أخبرتِني، لرحّبتُ بكِ

126
00:09:15,860 --> 00:09:22,740
الحرم المفتوح

127
00:09:16,210 --> 00:09:18,190
كان قراراً مُفاجئاً

128
00:09:18,190 --> 00:09:20,920
أتيتِ من أجل المُحاضرة العينيّة، صحيح؟

129
00:09:20,920 --> 00:09:22,740
أجل، صحيح

130
00:09:22,740 --> 00:09:27,690
جيّد! ما زال هناك وقت، لذا
دعيني آخذكِ في جولة

131
00:09:27,690 --> 00:09:29,000
...ماذا؟ لكن

132
00:09:29,000 --> 00:09:31,390
!لا تخجلي، لا تخجلي

133
00:09:33,020 --> 00:09:39,820
ماذا لدينا هنا يا يوميوري-كن؟ هل هذه
الآنسة المُبهرة هي صديقتكِ؟

134
00:09:40,230 --> 00:09:41,350
كودو-سينسي؟

135
00:09:42,170 --> 00:09:46,650
كودو-سينسي ستقدّم اليوم مُحاضرة
عينيّة حول الأخلاق

136
00:09:46,650 --> 00:09:50,360
هذه أياسي ساكي. تعمل
في المكتبة معي

137
00:09:52,930 --> 00:09:55,600
سررتُ بلقائكِ. اسمي كودو إيها

138
00:10:03,210 --> 00:10:05,660
من الواضح بأنّكِ تعانين من شيء الآن

139
00:10:08,390 --> 00:10:12,380
لدينا بعض الوقت، لذا هلّا
انضممتِ لي في مكتبي؟

140
00:10:12,880 --> 00:10:15,780
قد أتمكّن من منحكِ الإجابة
الّتي تبحثين عنها

141
00:10:16,180 --> 00:10:17,880
...تُعاكِس الآخرين دوماً

142
00:10:20,440 --> 00:10:21,640
اصعدي إلى هنا

143
00:10:42,300 --> 00:10:47,070
بصراحة، سمعتُ عنكِ قليلاً
بالفعل من يوميوري-كن

144
00:10:48,990 --> 00:10:50,670
عنّي؟

145
00:10:50,990 --> 00:10:55,550
أجل. وبعبارة أدقّ، عنكما

146
00:10:55,990 --> 00:10:56,890
أتعلمين؟

147
00:10:57,690 --> 00:11:00,400
المعذرة... ماذا أطلقتْ عليه؟

148
00:11:01,230 --> 00:11:03,490
هل تقصدين أسامورا-كن؟

149
00:11:03,490 --> 00:11:06,890
اسمه أسامورا-كن إذاً

150
00:11:07,570 --> 00:11:09,690
لم تكوني تعلمين إذاً؟

151
00:11:09,690 --> 00:11:12,960
صحيح. لم أعرف اسمه بعد

152
00:11:13,700 --> 00:11:18,440
والغريب، يوميوري-كن مُتحفّظة
جدّاً بشأن المعلومات الشّخصيّة

153
00:11:18,940 --> 00:11:21,950
أخلاقيّات فوقيّة

154
00:11:18,940 --> 00:11:21,950
كودو إيها

155
00:11:18,940 --> 00:11:21,950
أخلاقيّات عامّة

156
00:11:20,420 --> 00:11:25,980
سأدخل صلب الموضوع. وقعتِ
في حبّ أسامورا-كن، صحيح؟

157
00:11:26,850 --> 00:11:31,080
،لكن وفقاً للمعايير الأخلاقيّة التّقليديّة

158
00:11:31,080 --> 00:11:33,440
إنّه شخص لا ينبغي أن تكنّي مشاعرَ له

159
00:11:35,330 --> 00:11:37,420
ما الّذي يجعلكِ تقولين ذلك؟

160
00:11:39,290 --> 00:11:42,470
حسناً، هذا كلّ الدّليل الّذي احتجتُه

161
00:11:45,590 --> 00:11:51,230
لا أعتقد بأنّكِ تروقينني كثيراً

162
00:11:51,850 --> 00:11:53,730
لكن أحبّ الفتيات الصّادقات بصراحة

163
00:11:54,360 --> 00:11:58,950
.وبعد؟ طرحتُ عليكِ سؤالاً
هل تحبّين أسامورا-كن؟

164
00:12:00,090 --> 00:12:02,220
أظنّه أخاً جيّداً

165
00:12:02,220 --> 00:12:07,470
ليس هذا النّوع من "الحبّ". أسأل فيما
إذا كان لديكِ مشاعر عاطفيّة تجاهه

166
00:12:07,970 --> 00:12:09,250
إنّه أخي

167
00:12:09,250 --> 00:12:10,640
لكنّكما لستُما قريبين

168
00:12:11,450 --> 00:12:13,450
الأخ غير الشّقيق يبقى أخاً

169
00:12:15,470 --> 00:12:18,490
رغم أنّه كان كذلك لثلاثة أشهر قصيرة فقط

170
00:12:24,150 --> 00:12:27,300
لستُ متيقّنة بحدّ ذاتي

171
00:12:29,810 --> 00:12:31,060
أسامورا-كن

172
00:12:32,710 --> 00:12:34,490
إلى الغداء يا فوجينامي-سان؟

173
00:12:34,490 --> 00:12:36,100
...أجل، وأيضاً

174
00:12:36,700 --> 00:12:41,610
،بما أنّك أتيت للجلوس بقربي
ارتأيتُ ربّما أنّ لديك ما تقوله

175
00:12:42,160 --> 00:12:46,620
أجل، لكنّه ليس بالشّيء المهمّ

176
00:12:47,730 --> 00:12:50,880
حقّاً؟ هل أنت ذاهب إلى مكان ما
على الغداء؟

177
00:12:51,390 --> 00:12:53,370
كنتُ أفكّر بالمتجر

178
00:12:53,900 --> 00:12:57,420
أنا أيضاً. يمكننا الأكل في صالة الطّعام

179
00:12:57,880 --> 00:13:00,630
سلطة بيض

180
00:13:02,880 --> 00:13:04,880
سلمون

181
00:13:02,880 --> 00:13:04,880
أعشاب بحريّة

182
00:13:02,880 --> 00:13:04,880
بيض سمك القُدّ حارّ

183
00:13:12,600 --> 00:13:17,110
هذا ما تغيّر بالنّسبة لكِ في هذه
الأشهر الثّلاثة؟

184
00:13:23,650 --> 00:13:25,530
أعتقد حدث التِباس بيننا

185
00:13:26,630 --> 00:13:28,730
ماذا تقصدين؟

186
00:13:28,730 --> 00:13:32,470
ماذا لو لم تكن هذه مشاعر رومانسيّة إطلاقاً؟

187
00:13:32,470 --> 00:13:33,240
...هذا غير ممكن

188
00:13:33,240 --> 00:13:35,970
اهدئي. لنفكّر في الأمر فحسب

189
00:13:35,970 --> 00:13:38,210
،وفقاً لما قالته يوميوري-كن لي

190
00:13:38,210 --> 00:13:43,320
يبدو أنّ أسلوبكِ الشّخصيّ هو
التأكيد على مشاعركِ بوضوح

191
00:13:43,930 --> 00:13:45,120
...أجل

192
00:13:45,120 --> 00:13:47,870
لكن بالنّسبة لكِ، طريقة ارتدائكِ ملابسكِ
إنجازيّة، أليس كذلك؟

193
00:13:49,860 --> 00:13:53,470
تستخدمين الأزياء كطريقة للتّعبير عن نفسكِ

194
00:13:57,620 --> 00:14:01,210
مظهركِ هو شيء أنشأتِه بعناية وحرص

195
00:14:01,580 --> 00:14:05,610
لكن، رغم أنّكِ ما زلتِ تلميذة ثانويّة
من الدّاخل، حقيقة مجيئكِ

196
00:14:05,610 --> 00:14:10,740
لرؤية كلّية نخبة تجعلني أعتقد
بأنّكِ أكثر جدّية بكثير من ذلك

197
00:14:11,410 --> 00:14:13,920
أُوصيَ بها لي في اجتماع
المُعلّمين وأولياء الأمور

198
00:14:14,540 --> 00:14:17,340
الشّخصيّة الّتي تُظهرينها للعالم

199
00:14:17,340 --> 00:14:21,750
ما كانت تأتي لزيارة مدرسة كهذه
فقط لأنّ مُعلّمة طلبتْ منها ذلك

200
00:14:24,310 --> 00:14:31,670
،لا أحاول أن أتصرّف كفتاة غير مُبالية
ولا أريد أن يعتقد النّاس بأنّني كذلك

201
00:14:32,470 --> 00:14:38,160
أريد فقط أن أثبت بأنّني أستطيع استخدام
ما لديّ لأبدو "ظريفة أو "جميلة" أو أيّاً يكن

202
00:14:38,160 --> 00:14:40,230
ولأجل أن يرى النّاسُ ذلك

203
00:14:44,670 --> 00:14:48,500
ولم آتِ اليوم لأنّني تلميذة جادّة

204
00:14:49,410 --> 00:14:55,300
ارتأيتُ فقط بأنّ هذا قد يُساعدني
في توفير أفضل حياة لنفسي

205
00:14:57,890 --> 00:15:02,390
أحاول إقناع نفسي بذلك

206
00:15:06,440 --> 00:15:07,630
هذا يُفسّر الأمور

207
00:15:08,170 --> 00:15:12,900
يبدو أنّ مظهركِ المُتناقض مع شخصيّتكِ

208
00:15:12,900 --> 00:15:16,680
كلاهما شيئان صغتِهما بشكلٍ مُتعمّد

209
00:15:19,150 --> 00:15:20,840
لكن سأضيف هذا الكلام أيضاً

210
00:15:22,040 --> 00:15:26,340
أنتِ من النّوع الّذي لا يريد وبشكلٍ قطعيّ
أن يرى الآخرون نقاط ضعفها

211
00:15:28,470 --> 00:15:34,220
اسمعي، من الواضح بأنّكِ من النّوع
الّذي يقاتل دوماً. وبمفرده

212
00:15:34,830 --> 00:15:39,380
كلّما كانت المعركة أقوى، احتجتِ
لحُبّ ومُوافقة أكبر

213
00:15:39,380 --> 00:15:41,530
،لذا عندما يُظهِر أحدٌ ولو دعماً ضئيلاً

214
00:15:43,000 --> 00:15:44,960
فإنّكِ تتعلّقين به فوراً

215
00:15:47,670 --> 00:15:50,940
كنتُ سأرفضك في الواقع

216
00:15:50,940 --> 00:15:52,180
ترفضينني؟

217
00:15:52,180 --> 00:15:55,780
كنتُ سأقول، "آتي إلى مدرسة الحشو
"للدّراسة، وليس لأجل ذلك

218
00:15:57,500 --> 00:15:59,720
إذاً ظننتِ بأنّني كنتُ أعاكسكِ؟

219
00:16:00,190 --> 00:16:02,300
لكن لا يبدو الأمر كذلك الآن

220
00:16:02,740 --> 00:16:06,650
حالما بدأنا بالأكل، وصلت
المُحادثة إلى طريق مسدود

221
00:16:10,020 --> 00:16:15,860
،آسفة. أنا لا أذهب إلى المدرسة
لذا لا بدّ أنّ النّاس يعتقدونني غير مُبالية

222
00:16:16,690 --> 00:16:18,450
لا تذهبين إلى المدرسة؟

223
00:16:18,960 --> 00:16:21,640
آسف. ليس عليكِ التطرُّق إلى التّفاصيل

224
00:16:21,640 --> 00:16:26,940
لا عليك. لأكون واضحة، أنا لا أذهب
إلى المدرسة في النّهار

225
00:16:28,010 --> 00:16:30,680
ترتادين المدرسة اللّيليّة؟

226
00:16:31,170 --> 00:16:35,720
إذا قلتُ "مدرسة ليليّة"، "أنثى"، "الذّهاب
،"إلى صالات الأركيد في مُنتصف اللّيل

227
00:16:35,720 --> 00:16:37,870
فما طبيعة الشّخصيّة الّتي سترسمها في ذهنك؟

228
00:16:39,150 --> 00:16:45,360
سأعتقد بأنّها تلميذة مدرسة ليليّة
تذهب إلى صالات الأركيد في آخر اللّيل

229
00:16:46,730 --> 00:16:48,280
أهذا ما ستعتقده حقّاً؟

230
00:16:49,310 --> 00:16:50,340
أجل. لماذا؟

231
00:16:51,170 --> 00:16:54,580
ألن تُعاكسني لأنّك ستعتقد
بأنّني هدف سهل كخليلة؟

232
00:16:57,000 --> 00:17:01,090
آسف. لا أعرف غيركِ يرتاد
،مدرسة ليليّة

233
00:17:01,090 --> 00:17:03,750
لذا لديّ أي أفكار مُبلورة مسبقاً حول ذلك

234
00:17:06,870 --> 00:17:12,320
.يُعجبني عدم تحامُلك هذا
هل تنظر إلى كلّ شيء دون تحيُّز؟

235
00:17:12,970 --> 00:17:16,880
في الواقع، أظنّني أبذل جهدي لفعل ذلك

236
00:17:22,070 --> 00:17:29,120
أنا واثقة بأنّك تعرفين القليل جدّاً من النّاس
الّذين يفهمون أعماقك فعلاً

237
00:17:30,070 --> 00:17:35,880
لذلك، ومهما بدا ذلك اعتباطيّاً، وقعتِ
في حُبّ شخص وقف بجانبكِ فجأة

238
00:17:35,880 --> 00:17:36,820
...لا، هذا

239
00:17:37,810 --> 00:17:42,990
ليس ما حدث؟ هل يمكنكِ قول هذا بثِقة؟

240
00:17:45,310 --> 00:17:47,950
يجدر بكِ أن تحاولي الاحتكاك
مع شريحة متنوّعة أكثر من النّاس

241
00:17:48,790 --> 00:17:53,730
،قد تجدين شخصاً آخر تنجذبين له يوماً ما

242
00:17:53,730 --> 00:17:56,720
وذلك قد يساعدكِ في حلّ هذه
المُشكلات دون توتّر

243
00:17:58,180 --> 00:18:00,110
ينبغي أن ألتقي بشخص آخر؟

244
00:18:00,430 --> 00:18:03,750
أنا لا أقول لكِ أن تخرجي وتبحثي عن عشيق

245
00:18:04,270 --> 00:18:07,840
لكن المنظور المحدود هو عدوّ المنطِق والفكر

246
00:18:09,050 --> 00:18:11,200
أعتقد بأنّني أتّفق معكِ

247
00:18:11,950 --> 00:18:12,710
جيّد

248
00:18:14,340 --> 00:18:15,340
...لكن

249
00:18:18,930 --> 00:18:22,420
إذا اتّصلتِ بشخص آخر انجذبتِ له

250
00:18:22,900 --> 00:18:25,830
،وبقيَتْ مشاعركِ ثابتة لم تتغيّر

251
00:18:28,740 --> 00:18:34,260
،فإنّ مشاعركِ تلك هي الحقيقيّة
وينبغي أن تُقدّريها دوماً

252
00:18:41,860 --> 00:18:42,650
حسناً

253
00:18:43,430 --> 00:18:48,560
ها أنتِ ذي. من المهمّ أيضاً ألّا تكوني
عنيدة جدّاً يا ساكي-تشان

254
00:18:49,890 --> 00:18:52,730
هل تمانعين مُناداتي بأياسي؟

255
00:19:06,740 --> 00:19:16,300
زواج الأقرباء

256
00:19:28,690 --> 00:19:30,690
هل ستتواجد في قاعة الدّراسة
ثانية يوم غد؟

257
00:19:31,300 --> 00:19:35,100
،لديّ دروس بعد الظّهر في عطلة الأسبوع
لكن في الصّباح، أجل

258
00:19:35,100 --> 00:19:41,000
.إذاً ينبغي أن نتناول الغداء ثانية
أعرف مطعماً رخيصاً وجيّداً

259
00:19:41,000 --> 00:19:42,070
حسناً، شكراً

260
00:19:44,310 --> 00:19:48,630
المعذرة، لم تري كُرة أرزّ أردتِها في المتجر؟

261
00:19:50,650 --> 00:19:52,040
كنتَ تُراقبني؟

262
00:19:52,040 --> 00:19:52,710
...أجل

263
00:19:53,140 --> 00:19:57,340
ف-في الواقع، مع كُرات الأرزّ، تعلق
الأعشاب البحريّة بين الأسنان، صحيح؟

264
00:19:58,030 --> 00:19:59,540
لذا رفضت

265
00:20:04,870 --> 00:20:06,220
أراك غداً

266
00:20:10,730 --> 00:20:13,230
أسامورا          أياسي

267
00:20:12,810 --> 00:20:15,660
ماذا؟ ويوميوري-سينباي كانت هناك؟

268
00:20:15,660 --> 00:20:18,000
أجل. كانت تعمل كموظّفة استقبال

269
00:20:18,510 --> 00:20:21,640
...إنّها ترتاد كلّية نخبة للإناث إذاً

270
00:20:22,040 --> 00:20:25,410
كانت هناك أستاذة غريبة أطوار أيضاً

271
00:20:25,410 --> 00:20:26,240
غريبة أطوار؟

272
00:20:26,810 --> 00:20:32,420
.لا أعرف كيف أصِفها بالضّبط
دخلنا في جِدال

273
00:20:32,420 --> 00:20:34,250
شعرتُ بالإرهاق في نهايته

274
00:20:34,760 --> 00:20:36,480
لكن استمتعتِ، صحيح؟

275
00:20:37,030 --> 00:20:39,800
أجل، صحيح

276
00:20:40,610 --> 00:20:43,290
وتفكّرين في الذّهاب إلى تسوكينوميا الآن؟

277
00:20:44,620 --> 00:20:46,270
،أعتقد في الكلّية

278
00:20:46,270 --> 00:20:50,470
تكون البداية هي عندما تُدرك
كيف تنظر للأمور

279
00:20:51,030 --> 00:20:53,480
كمكان تذهب إليه لحلّ المُشكلات

280
00:20:54,690 --> 00:20:57,400
أعتقد بأنّني أريد تجربة ذلك الآن

281
00:20:57,860 --> 00:21:00,630
حقّاً؟ هذا رائع

282
00:21:02,520 --> 00:21:04,660
وماذا عنك يا أخي؟

283
00:21:05,830 --> 00:21:08,550
هل ستستمرّ في الذّهاب
إلى قاعة الدّراسة تلك؟

284
00:21:09,090 --> 00:21:11,060
أجل، هذا ما أعتقده

285
00:21:11,060 --> 00:21:16,220
يُفترَض أن ألتقي بصديقة من مدرسة
الحشو على الغداء ثانية غداً

286
00:21:17,080 --> 00:21:18,420
حقّاً؟

287
00:21:19,510 --> 00:21:21,420
هذا رائع يا أخي

288
00:21:26,050 --> 00:21:29,510
معها حقّ. ينبغي أن يكون
هذا أمراً جيّداً

289
00:21:30,650 --> 00:21:34,430
التقتْ أياسي-سان بشخص أقنعها
،بالرّغبة في تجربة الكلّية

290
00:21:35,560 --> 00:21:39,690
وأنا وجدتُ صديقة أستطيع
التكلُّم معها في مدرسة الحشو

291
00:21:41,130 --> 00:21:45,670
كلانا نصنع علاقات جديدة

292
00:21:46,630 --> 00:21:49,450
هكذا ينبغي أن تكون الأمور

293
00:21:50,650 --> 00:21:54,450
،لكلّ منّا خطّته الخاصّة

294
00:21:54,980 --> 00:21:57,550
ودربانا لا يتقاطعان

295
00:21:59,700 --> 00:22:04,390
شيئاً فشيئاً، نقترب أكثر فأكثر من أن نصبح

296
00:22:05,900 --> 00:22:09,970
أخاً وأختاً عاديّان في السّابعة عشر من العمر

297
00:23:46,480 --> 00:23:49,990
***** الحلقة 12: ***** و