1
00:00:08,390 --> 00:00:12,460
إنّه تلقائيّ مع النّاس دوماً

2
00:00:12,460 --> 00:00:16,160
إنّه يساومني للانسجام مع شخصيّتي الصّعبة

3
00:00:16,730 --> 00:00:19,530
ليست لديه أي تحامُل ضدّي

4
00:00:20,210 --> 00:00:24,240
يُقدِّر كلّ الجهود الحثيثة المبذولة من قِبَلي
للحرص على ألّا يرى الآخرون

5
00:00:25,180 --> 00:00:28,710
يفهم طبيعتي

6
00:00:33,010 --> 00:00:37,480
لذا أريد أن أعرفه بشكل أفضل

7
00:00:38,730 --> 00:00:40,710
ليتني أستطيع فهمه أيضاً

8
00:00:42,270 --> 00:00:43,750
...أسامورا يوتا

9
00:00:44,890 --> 00:00:47,830
انجذبتُ له

10
00:00:51,450 --> 00:00:54,490
إنّه من النّوع الّذي ينتبه للتّفاصيل

11
00:00:54,490 --> 00:00:55,510
خليّة النّحل

12
00:00:54,490 --> 00:00:55,510
تامورا كاناي

13
00:00:54,490 --> 00:00:56,610
!صدر في 22 أغسطس

14
00:00:55,550 --> 00:01:01,450
لم يستغرق وقتاً في إيجاد كتاب
قضيتُ عشر دقائق بحثاً عنه

15
00:01:02,680 --> 00:01:07,200
لكن عندما أخبرني بأنّها كانت
...لتجده بشكلٍ أسرع حتّى

16
00:01:08,740 --> 00:01:13,880
،أدركتُ كم أنّني ضيّقة الأفق
وأشعرني ذلك بالإحباط

17
00:01:16,040 --> 00:01:20,320
اليوم الموالي... ألم يكن عندما تعطّل
المُكيّف في غرفة المعيشة؟

18
00:01:22,520 --> 00:01:26,170
في ذلك المساء، جابهني أسامورا-كن

19
00:01:27,000 --> 00:01:30,480
سأل ما إن كانت مايا قد دعتنا
للذّهاب إلى المسبح

20
00:01:31,820 --> 00:01:35,240
لا أريد حتّى أن أتذكّر كيف
كانت ردّة فعلي

21
00:01:34,280 --> 00:01:40,410
.إذاً عليك إجبار نفسكِ على الذّهاب

22
00:01:35,980 --> 00:01:39,590
أقصد، لا أستطيع إهدار وقتي في اللّعب

23
00:01:40,450 --> 00:01:41,410
ألن تذهبي؟ إلى المسبح؟

24
00:01:40,940 --> 00:01:42,110
لا أستطيع فحسب

25
00:01:41,660 --> 00:01:43,160
لا، لن أذهب

26
00:01:44,410 --> 00:01:47,660
أعتقد كنتُ مُرهَقة تماماً

27
00:01:51,150 --> 00:01:54,340
ألقيتُ عليه ردّاً غير مُبالٍ

28
00:01:54,340 --> 00:01:56,650
لأنّني لم أرد سماع المزيد عن الأمر

29
00:01:55,210 --> 00:01:57,630
سأسبقك

30
00:01:57,940 --> 00:02:02,090
ما قلتُه كان قاسياً جدّاً، بالكاد أصدّق
بأنّه خرج من لساني

31
00:02:03,060 --> 00:02:05,060
.لا أريد ذلك

32
00:02:05,060 --> 00:02:07,560
أجل، شكراً

33
00:02:06,200 --> 00:02:08,360
بدوتُ كطفلة

34
00:02:11,130 --> 00:02:13,530
كان ذلك يوماً فظيعاً

35
00:02:14,180 --> 00:02:18,330
أسوأ جزء كان هو أنّني كنتُ أعلم
،بأنّه تراودني هذه الأفكار الفظيعة

36
00:02:18,330 --> 00:02:20,700
لكن لم أُرِد أن أُجبَر على التّعامل معها

37
00:02:24,510 --> 00:02:26,330
لديها شعر طويل وجميل

38
00:02:27,090 --> 00:02:32,700
حتّى أنا أعتقد بأنّه جميل. إنّه
يلائم أسلوب أسامورا-كن المُتواضع

39
00:02:34,820 --> 00:02:40,010
أتساءل ما إن كان يحبُّ الفتيات
ذوات الشّعر الطّويل والجميل

40
00:02:41,580 --> 00:02:45,210
على الأقلّ شعري طويل أيضاً

41
00:02:47,750 --> 00:02:50,730
...ما الّذي أفكِّر فيه بالضّبط؟ بجدّية

42
00:02:53,910 --> 00:02:57,030
بعد إكمال العشاء، ذكرَ ذلك من جديد

43
00:02:57,300 --> 00:03:00,280
قال بأنّه يريدني أن أذهب
وأستمتع في المسبح

44
00:03:01,170 --> 00:03:06,490
لماذا هو قلقٌ بشأن شيء كهذا؟
يجب أن أقضي وقتي في الدِّراسة

45
00:03:07,860 --> 00:03:11,130
ليس لديّ وقت للخروج واللّعب

46
00:03:15,950 --> 00:03:19,670
رأيتُ تلك النّظرة من قبل

47
00:03:20,660 --> 00:03:22,410
،عندما كنتُ في المدرسة الإعداديّة ذات يوم

48
00:03:22,410 --> 00:03:26,790
أرادت أمّي أن تأخذني إلى الشّاطئ

49
00:03:27,820 --> 00:03:30,310
،نظراً لوضعنا الماليّ

50
00:03:30,730 --> 00:03:33,440
لم أتوقّع أن نتمكّن من تحمُّل نفقاته

51
00:03:33,940 --> 00:03:36,820
لا مُشكلة. لديّ اختبارات مُقبِلة

52
00:03:34,050 --> 00:03:38,440
لم أُرِد أن أجبر أمّي على أخذ
إجازة يوم من العمل

53
00:03:39,070 --> 00:03:47,200
حسناً، ربّما في المرّة المقبلة

54
00:03:39,150 --> 00:03:43,600
حينئذ عبّرت بتلك الطّريقة. بنظرة مُحبَطة

55
00:03:45,310 --> 00:03:47,200
الأحد، 6 أغسطس

56
00:03:48,180 --> 00:03:49,830
نحن في الشّاطئ اليوم

57
00:03:50,440 --> 00:03:53,030
يوتا! لا تركضي، مفهوم؟

58
00:03:57,550 --> 00:03:59,620
بئساً، ما الّذي قلتُه للتو؟

59
00:04:00,600 --> 00:04:02,310
هيّا. هل يمكنكِ النّهوض؟

60
00:04:18,490 --> 00:04:19,540
أتريد اللّعب؟

61
00:04:36,710 --> 00:04:38,270
يبدو هذا دافئاً جدّاً

62
00:04:39,430 --> 00:04:42,040
،حتّى في هذا النّسيم البارد

63
00:04:43,150 --> 00:04:46,550
أشعر بدفء وراحة بداخلي

64
00:04:48,070 --> 00:04:52,980
،وعندما أستنشق نفساً عميقاً وأزفر
أشعر بأنّ الضّيق غادر صدري

65
00:04:54,120 --> 00:04:56,500
جسديّاً وعقليّاً

66
00:04:58,830 --> 00:05:00,590
...كنتُ أفكّر في ذلك كثيراً

67
00:05:05,610 --> 00:05:07,390
وأعتقد بوسعي الذّهاب إلى المسبح

68
00:06:42,960 --> 00:06:45,960
الحلقة 9: أخت غير شقيقة ومفكّرة

69
00:06:51,020 --> 00:06:52,380
...ساكي

70
00:06:53,620 --> 00:06:54,860
ساكي

71
00:06:56,550 --> 00:06:57,720
ساكي؟

72
00:07:02,760 --> 00:07:04,720
انظري. وصلنا

73
00:07:20,420 --> 00:07:21,880
إنّها ظريفة جدّاً

74
00:07:23,400 --> 00:07:25,200
!إنّها رائعة

75
00:07:28,430 --> 00:07:30,910
هل أنتِ متأكّدة بأنّ هذا
هو الّذي تريدينه؟

76
00:07:30,910 --> 00:07:33,220
!أجل! هذه هي

77
00:07:35,150 --> 00:07:37,350
!غوااا

78
00:08:03,480 --> 00:08:06,110
!أمّي، انظري إلى هذا

79
00:08:08,470 --> 00:08:10,480
أسامورا، ألا تعمل في مكتبة؟

80
00:08:10,480 --> 00:08:11,720
هل تعمل حقّاً؟

81
00:08:11,220 --> 00:08:12,460
!مذهل

82
00:08:11,720 --> 00:08:12,460
أجل

83
00:08:12,460 --> 00:08:14,650
هل يمكنك جني كثير من المال في مكتبة؟

84
00:08:14,650 --> 00:08:15,600
أخبرنا. أخبرنا

85
00:08:15,600 --> 00:08:16,730
لا أعلم

86
00:08:16,730 --> 00:08:17,680
!يبدو هذا رائعاً

87
00:08:17,680 --> 00:08:19,730
هذا أوّل عمل أحظى به

88
00:08:19,730 --> 00:08:23,570
لكن كلّ ما فعلته في الاستراحة هو
!العمل والدّراسة؟ هذه مسؤوليّة كبيرة

89
00:08:23,570 --> 00:08:26,030
!مسؤول! سيّد مسؤول

90
00:08:25,030 --> 00:08:27,040
كلّ ما فعلتُه هو النّوم طوال الوقت

91
00:08:27,040 --> 00:08:28,010
!بالفعل

92
00:08:28,610 --> 00:08:30,500
لكن لستُ مسؤولاً إلى هذا الحدّ

93
00:08:29,410 --> 00:08:30,500
أنا كذلك

94
00:08:30,500 --> 00:08:32,990
!لا تكن مُتواضِعاً

95
00:08:31,710 --> 00:08:32,990
!بالفعل

96
00:08:34,390 --> 00:08:36,150
جاء هذا اليوم

97
00:08:37,860 --> 00:08:42,080
لستُ جيّدة في التّعامل مع الأصدقاء

98
00:08:43,470 --> 00:08:45,920
أنا سيّئة دوماً في تحليل الأجواء

99
00:08:47,190 --> 00:08:51,310
لكن لم يكن اليوم سيّئاً جدّاً

100
00:08:52,040 --> 00:08:54,760
ويعزو الفضل في ذلك لأسامورا-كن

101
00:08:55,470 --> 00:08:57,760
إنّه أفضل بكثير منّي مع الآخرين

102
00:08:59,180 --> 00:09:03,120
لكن عندما لا يحبّ شيئاً، يقول ذلك فحسب

103
00:09:04,770 --> 00:09:08,200
أعتقد هذه إحدى الأسباب الّتي
تجعلني منجذبة له

104
00:09:08,520 --> 00:09:10,090
!مرحى

105
00:09:41,620 --> 00:09:46,600
حسناً، سنلعب الآن لعبة أوثيلو
!ألواح السّباحة! إنّها سهلة جدّاً

106
00:09:46,600 --> 00:09:48,190
!حسناً

107
00:09:50,020 --> 00:09:53,270
،بدلاً من مُحاولة لفت الأنظار

108
00:09:53,270 --> 00:09:56,470
يحاول دوماً أن يحرص على إسعاد الآخرين

109
00:09:57,760 --> 00:10:00,010
ذلك الجانب فيه رائع حقّاً

110
00:10:03,330 --> 00:10:05,750
رغم أنّه يبدو أنّه لا يلاحظ ذلك أحدٌ غيري

111
00:10:08,190 --> 00:10:10,720
ربّما أنا الوحيدة الّتي تُلاحظ

112
00:10:12,930 --> 00:10:17,340
...لا أعلم. هذا يُشعرني بالفخر بعض الشّيء

113
00:10:15,840 --> 00:10:17,340
...ما قلته للتو

114
00:10:18,340 --> 00:10:21,390
كان ذلك رائعاً حقّاً

115
00:10:18,870 --> 00:10:20,310
والخوف قليلاً

116
00:10:21,460 --> 00:10:27,720
في الواقع، لا أريد أن أصبح محطّ
اهتمام ثمّ أخاطر بإفساد الأمور

117
00:10:27,720 --> 00:10:29,710
إنّها لعبة فِرق في نهاية المطاف

118
00:10:30,210 --> 00:10:31,420
حقّاً؟

119
00:10:32,520 --> 00:10:36,380
،حسناً، بتجاهل الحقيقة الموضوعيّة للظّرف

120
00:10:36,380 --> 00:10:39,610
ذاتيّاً، أردتُ أن أمدحك على ذلك

121
00:10:40,100 --> 00:10:43,180
ارتأيتُ أنّ ذلك كان رائعاً حقّاً

122
00:10:43,740 --> 00:10:46,310
كعامل مسرح كرّس نفسه لمساعدة الجميع

123
00:10:48,420 --> 00:10:51,130
لكن هل عُمّال المسرح بتلك الرّوعة حقّاً؟

124
00:10:51,780 --> 00:10:54,380
حسناً، تختلف المعايير بين شخص وآخر

125
00:10:56,870 --> 00:10:58,990
أعتقد معكِ حقّ

126
00:10:59,670 --> 00:11:02,540
،لكن إذا ظللتِ تتكلّمين بهذه الطّريقة
فسوف أُصاب بالإحراج

127
00:11:09,690 --> 00:11:11,920
لا، اكتفيتُ بهذا القدر

128
00:11:40,670 --> 00:11:44,790
حسناً. ربّما سأذهب لمزيد من السّباحة

129
00:11:57,410 --> 00:11:58,000
!هيّا بنا

130
00:11:58,000 --> 00:11:58,720
!حسناً

131
00:11:58,720 --> 00:11:59,690
!هنا

132
00:12:00,410 --> 00:12:01,370
!أمسكتُها

133
00:12:38,410 --> 00:12:39,530
أحبّها

134
00:12:49,670 --> 00:12:52,650
بصراحة، لم أكن أجيد التّعامل
مع الفتيات يوماً

135
00:12:53,630 --> 00:12:56,440
ربّما بسبب طبيعة العلاقة بين أمّي وأبي

136
00:12:57,450 --> 00:13:01,280
منحني ذلك نظرة تشاؤميّة حول العلاقة
بين الرّجال والنّساء

137
00:13:02,730 --> 00:13:08,090
لهذا لم أقع في حُبّ أحد من قبل الآن

138
00:13:10,060 --> 00:13:11,080
...ومع ذلك

139
00:13:12,250 --> 00:13:17,650
هذه العاطفة، هذا الإحساس الّذي يعتبره
...معظم النّاس مُقدّساً ومجيداً

140
00:13:19,160 --> 00:13:21,530
كيف تسلّل إليّ هكذا؟

141
00:13:23,170 --> 00:13:24,470
ولماذا الآن؟

142
00:13:25,550 --> 00:13:28,220
...ولماذا، من بين كلّ النّاس

143
00:13:30,340 --> 00:13:32,140
إنّها أختي الصّغرى

144
00:13:32,890 --> 00:13:36,180
لكنّها أيضاً أياسي-سان

145
00:13:37,940 --> 00:13:39,000
...أختي

146
00:13:40,330 --> 00:13:41,740
غير الشّقيقة الصّغيرة

147
00:13:44,690 --> 00:13:47,050
أنت ومايا أصبحتُما ودودين معاً

148
00:13:47,050 --> 00:13:52,560
ماذا؟ أجل، أردتُ أن أشكرها على الدّعوة

149
00:13:53,210 --> 00:13:57,660
اهتمّتْ بكلّ شيء حقّاً. قضيتُ وقتاً رائعاً

150
00:13:58,340 --> 00:14:00,500
ناراساكا-سان مُبهرة جدّاً

151
00:14:01,130 --> 00:14:02,190
شكراً لك

152
00:14:02,760 --> 00:14:03,910
ماذا؟

153
00:14:03,910 --> 00:14:07,540
إنّها صديقتي. ويسرّني أن أسمع
بأنّ النّاس يقدّرونها

154
00:14:11,480 --> 00:14:13,020
هل استمتعتِ؟

155
00:14:13,570 --> 00:14:15,200
أجل، بفضلك

156
00:14:24,050 --> 00:14:27,020
منذ كنتُ طفلة، أحببتُ السّباحة في المسابح

157
00:14:27,740 --> 00:14:32,020
،لم أتمكّن من التمتّع بالسّباحة منذ مدّة
لذا كان هذا مُمتعاً حقّاً

158
00:14:33,790 --> 00:14:37,260
أنا مسرورة حقّاً لأنّني أصغيت
إليك يا أسامورا-كن

159
00:14:42,180 --> 00:14:44,480
لم أفعل شيئاً يُذكَر

160
00:14:48,830 --> 00:14:49,490
—أياسي-سا

161
00:15:05,070 --> 00:15:06,600
أفزعني ذلك حقّاً

162
00:15:07,690 --> 00:15:10,620
رأيتُ كثيراً من النّاس باليوكاتا اليوم

163
00:15:22,110 --> 00:15:26,200
أسامورا-كن، أعتقد بأنّك لطيف ومُراعٍ للمشاعر

164
00:15:27,110 --> 00:15:28,030
ماذا؟

165
00:15:28,650 --> 00:15:30,140
أنا مُعجبة بذلك حقّاً

166
00:15:34,250 --> 00:15:36,220
حقّاً؟

167
00:15:36,940 --> 00:15:39,640
أجل، هذا ما أعتقده

168
00:15:41,060 --> 00:15:44,000
أدركتُ أنّ هذه هي فُرصتي لقولها

169
00:15:44,590 --> 00:15:46,750
تعلم كم يُحاول النّاس جاهدين

170
00:15:47,350 --> 00:15:53,210
أعلم بأنّني قلتُ هذا في المسبح، لكن
أعتقد أنّ هذا الجانب فيك رائع حقّاً

171
00:15:53,940 --> 00:16:00,260
.إنّه نجمة ساطعة في حياتي
يبدو رائعاً جدّاً في نظري

172
00:16:01,300 --> 00:16:02,990
...أنت عظيم

173
00:16:04,170 --> 00:16:05,060
...لهذا السّبب

174
00:16:09,870 --> 00:16:10,990
أخي

175
00:16:17,940 --> 00:16:21,020
آسفة. هل فاجأتُك؟

176
00:16:21,020 --> 00:16:26,790
دائماً ما تعتني بي وتفعل المستحيل لأجلي

177
00:16:27,480 --> 00:16:31,740
.أنت شخص يمكنني الاعتماد عليه حقّاً
كأخٍ حقيقيّ

178
00:16:33,460 --> 00:16:35,390
يسرّني ذلك يا أياسي-سان

179
00:16:37,320 --> 00:16:40,180
لكن يبقى هذا غريباً بعض الشّيء، صحيح؟

180
00:16:41,640 --> 00:16:43,730
لا أعتقد ذلك

181
00:16:43,730 --> 00:16:45,100
لا تعتقد؟

182
00:16:47,290 --> 00:16:49,480
يا إلهي، كان ذلك وشيكاً

183
00:16:50,440 --> 00:16:56,700
،مُناداتها لي بذلك، بصورة غير مُتوقَّعة
أعادتني إلى رشدي

184
00:16:57,900 --> 00:17:04,330
...سلوك أياسي-سان الودود، ومديحها
كان كلّ ذلك لأجل أخيها

185
00:17:06,270 --> 00:17:08,390
إنّها تثق بي

186
00:17:08,970 --> 00:17:14,720
بينما هنا أنا كنتُ أحاول خرق كلّ قواعدنا

187
00:17:24,900 --> 00:17:26,140
لا أستطيع فعل هذا

188
00:17:27,550 --> 00:17:30,470
كيف يُفترض بي أن أتصرّف
عندما أعود إلى المنزل؟

189
00:17:32,580 --> 00:17:36,660
آمل ألّا يكون قد لاحظ بأنَّ يدَي كانتا ترتجفان

190
00:17:37,640 --> 00:17:40,400
يجب عليّ تكرار ذلك على نفسي

191
00:17:41,270 --> 00:17:44,500
!كلاكما أخوان يا فتاة

192
00:17:46,070 --> 00:17:48,980
...لكن ربّما، أقول ربّما

193
00:17:49,820 --> 00:17:56,000
إذا أحبّني أسامورا-كن واختار
،مُشاركتي مشاعره

194
00:17:57,160 --> 00:18:01,080
فهل سأتمكّن من رفض
تلك المشاعر تماماً؟

195
00:18:02,810 --> 00:18:03,960
أنا خائفة

196
00:18:05,570 --> 00:18:11,050
،إذا خطى حتّى خطوة واحدة للأمام
...فأنا متأكّدة بأنّني سوف

197
00:18:13,730 --> 00:18:15,510
سوف أنهار تماماً

198
00:18:16,860 --> 00:18:21,740
الجمعة، 28 أغسطس

199
00:18:24,190 --> 00:18:26,660
أمّي؟ ماذا عن العمل؟

200
00:18:26,660 --> 00:18:28,440
أخذتُ يوم إجازة

201
00:18:28,440 --> 00:18:31,020
هل ما زال يوتا في السّرير؟

202
00:18:31,020 --> 00:18:34,800
لا بُدّ أنّه مُرهق. لِمَ لا تدعه
ينام فترة أطول؟

203
00:18:35,200 --> 00:18:37,370
ساكي-تشان، هل لديك عمل ثانية اليوم؟

204
00:18:38,210 --> 00:18:40,610
أخذتُ إجازة في الأمس واليوم

205
00:18:40,610 --> 00:18:42,090
ويوتا-كن أيضاً؟

206
00:18:42,090 --> 00:18:42,720
أجل

207
00:18:43,010 --> 00:18:46,100
عظيم! إذاً يمكننا جميعاً قضاء
!بعض الوقت معاً

208
00:18:46,100 --> 00:18:47,910
!العائلة بأكملها

209
00:18:49,240 --> 00:18:50,570
يسرّني أنّها سعيدة

210
00:18:51,210 --> 00:18:55,450
أريدها أن تكون سعيدة بما يكفي
للتّعويض عن كلّ الأوقات العصيبة

211
00:18:56,970 --> 00:18:59,100
لذا أنا... أجل

212
00:18:59,990 --> 00:19:03,790
لهذا سوف أكتم هذه المشاعر

213
00:19:04,610 --> 00:19:07,950
لا أريد إفساد سعادة والدينا

214
00:19:09,030 --> 00:19:12,080
لا أريد أن أُسبّب مشكلة لأسامورا-كن

215
00:19:28,100 --> 00:19:32,790
عسى ألّا يكتشف أحدٌ مشاعري

216
00:19:39,590 --> 00:19:43,430
أخبرتنا ساكي بأنّ لديك عطلة من العمل

217
00:19:44,110 --> 00:19:44,990
هذا صحيح

218
00:19:44,990 --> 00:19:48,200
وبهذا تكون قد أصبحتَ مُتغيِّباً
!عن مدرسة حشو رسميّاً أيضاً

219
00:19:50,370 --> 00:19:53,420
تقصد بأنّك كنت تعلم ذلك
ورغم هذا لم توقظني؟

220
00:19:54,010 --> 00:19:56,580
مثل هذه الأمور جيّدة لك بين الحين والآخر

221
00:19:59,630 --> 00:20:01,870
شكراً لك يا يوتا-كن

222
00:20:01,870 --> 00:20:02,590
ماذا؟

223
00:20:03,460 --> 00:20:06,110
على أخذ ساكي إلى المسبح

224
00:20:08,500 --> 00:20:12,810
في الحقيقة، كانت صديقة أياسي-سان من دعتنا

225
00:20:14,740 --> 00:20:20,820
لكن لو لم تضغط عليها، ما كانت
الفتاة لتذهب غالباً

226
00:20:24,050 --> 00:20:26,550
لعلّكِ على حقّ هنا

227
00:20:27,870 --> 00:20:31,580
يسرّني أنّك أخوها الأكبر

228
00:20:34,930 --> 00:20:38,170
!هذا صحيح يا يوتا-كن
!الشّيء المُفضّل لساكي

229
00:20:38,170 --> 00:20:40,610
ما ذكرتِه من قبل؟

230
00:20:40,610 --> 00:20:43,090
أجل. سأُريك ما هو

231
00:20:43,090 --> 00:20:43,870
تفضّل

232
00:20:46,390 --> 00:20:48,220
ماذا؟ هذا هو؟

233
00:20:48,220 --> 00:20:49,490
عُدت

234
00:20:49,490 --> 00:20:53,070
!أهلاً بعودتكِ! هذا جديد

235
00:20:53,800 --> 00:20:55,340
—مرحباً بعو

236
00:20:55,340 --> 00:20:58,360
!تبدين مختلفة تماماً

237
00:20:58,360 --> 00:20:59,740
!يليق بكِ كثيراً

238
00:20:59,740 --> 00:21:00,860
!أجل

239
00:21:03,450 --> 00:21:06,860
أهلاً بعودتكِ يا أياسي-سان

240
00:21:11,390 --> 00:21:13,420
شكراً لك يا أخي

241
00:21:21,650 --> 00:21:25,710
أخرجتُ مفكّرتي وأعدتُ قراءة
ما كتبتُه حتّى الآن

242
00:21:26,950 --> 00:21:32,780
أدركتُ بأنّني كنتُ أكثر صراحة
وصدقاً في مفكّرتي ممّا توقّعت

243
00:21:34,440 --> 00:21:39,820
كلّ أفكاري حول الانجذاب له أكثر فأكثر

244
00:21:39,820 --> 00:21:41,870
عُبِّرَ عنها هناك في الصّفحة

245
00:22:14,720 --> 00:22:20,640
لكن مُدخَلات مُفكّرتي لهذا الأسبوع
ستبقى فقط في ذهني

246
00:22:21,250 --> 00:22:23,490
،إذا كتبتُ شيئاً

247
00:22:23,490 --> 00:22:26,570
فهناك دوماً احتمال أن يجدها يوماً ما

248
00:22:53,820 --> 00:22:58,710
لن أدوّن أبداً مشاعري الحقيقيّة

249
00:23:01,170 --> 00:23:04,880
،عندما أريد أن أعيش ذكرياتي من جديد
فسأفعل ذلك داخل رأسي

250
00:23:06,100 --> 00:23:11,990
يجدر بي أن أقضي أيّامي أحاول
التّواصل معه كمجرّد فتاة فحسب

251
00:23:15,610 --> 00:23:17,680
أنا أخته الصّغرى الوحيدة

252
00:23:19,150 --> 00:23:21,510
يجب أن أعيش معه كأخته غير الشّقيقة

253
00:23:23,210 --> 00:23:25,100
،وفي حياتي كأخته غير الشّقيقة

254
00:23:26,520 --> 00:23:28,510
لا أحتاج مفكّرة بعد الآن

255
00:23:46,480 --> 00:23:49,990
الحلقة 10: علاقات وحسرات