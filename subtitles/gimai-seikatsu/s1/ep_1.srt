1
00:00:25,680 --> 00:00:28,790
الأخ غير الشّقيق ليس أكثر من مجرّد غريب

2
00:00:34,870 --> 00:00:37,970
وهذا طبيعيّ جدّاً، لأنّنا حتّى لو أصبحنا
ذات يوم أشقاء فجأة

3
00:00:38,460 --> 00:00:42,660
لا نملك تجربة مُشتركة في العيش معاً

4
00:00:54,360 --> 00:00:58,070
الأخت غير الشّقيقة ليست أكثر من مجرّد غريبة

5
00:00:59,310 --> 00:01:01,150
الرّوايات والأفلام تحبّ أن تنغمس

6
00:01:01,150 --> 00:01:03,420
في فكرة أنّ السّبب هو لأنّه
،لا يوجد رابط دم

7
00:01:03,780 --> 00:01:08,010
وأنّهما ببساطة يستطيعان أن يقعا في الحُب
ويعيشا علاقة طبيعيّة بين ذكر وأنثى

8
00:01:09,860 --> 00:01:14,000
لكن الأشياء الّتي تحدث في الخيال والأشياء
...الّتي تحدث في الواقع مختلفتان تماماً

9
00:01:18,660 --> 00:01:21,470
يقول النّاس بأنّ الغرباء جميعهم
،يبدؤون كأشقاء أوّلاً

10
00:01:22,430 --> 00:01:26,080
،لكن في حالة الأخوة غير الأشقاء
يبدؤون كغُرباء

11
00:01:26,370 --> 00:01:28,690
ويبقون غُرباء حتّى النّهاية

12
00:02:50,760 --> 00:02:53,090
أتعلم؟ قرّرتُ أن أتزوّج من جديد

13
00:02:53,580 --> 00:02:54,400
ماذا؟

14
00:02:54,690 --> 00:02:58,050
إنّها فتاة تعمل في حانة
أخذني إليها مُديري

15
00:02:58,370 --> 00:03:01,110
اعتنتْ بي عندما كنتُ غارقاً في الثّمالة

16
00:03:01,460 --> 00:03:03,660
يبدو هذا احتيالاً

17
00:03:04,060 --> 00:03:07,560
لا تقلق. أكيكو-سان ليست كذلك إطلاقاً

18
00:03:09,420 --> 00:03:11,380
سترى ذلك عندما تلتقي بها اللّيلة يا يوتا

19
00:03:12,310 --> 00:03:13,110
اللّيلة؟

20
00:03:13,110 --> 00:03:14,640
!أجل. مؤلم

21
00:03:15,880 --> 00:03:17,000
سأعرّفك عليها

22
00:03:17,300 --> 00:03:18,670
سنلتقي بعد عملك

23
00:03:21,550 --> 00:03:23,270
قرار طائش آخر

24
00:03:30,290 --> 00:03:31,300
!مؤلم

25
00:03:30,290 --> 00:03:31,300
هل أنت مستعدّ لذلك؟

26
00:03:34,840 --> 00:03:36,320
ماذا قلت؟

27
00:03:38,350 --> 00:03:39,570
!ساخن جدّاً

28
00:03:39,570 --> 00:03:41,780
ما دام هذا يُسعدك، فلا مانع لديّ

29
00:03:42,360 --> 00:03:44,440
سأستمرّ في القيام بعملي المعتاد

30
00:03:45,200 --> 00:03:47,030
لكن عملك المعتاد ليس كفيلاً بحلّ الأمر

31
00:03:47,380 --> 00:03:49,020
سوف تحظى بأخت صغرى جديدة

32
00:03:50,130 --> 00:03:51,080
أخت صغرى؟

33
00:03:51,530 --> 00:03:53,050
أجل، أخت صغرى

34
00:03:53,560 --> 00:03:55,030
ابنة أكيكو-سان

35
00:04:05,030 --> 00:04:08,200
سررتُ بلقائك. اسمي أياسي أكيكو

36
00:04:08,200 --> 00:04:11,480
شكراً على الخروج. أعلم بأنّك
مشغول في عملك

37
00:04:11,730 --> 00:04:13,720
ماذا؟ لا عليكِ

38
00:04:14,730 --> 00:04:16,800
أنا الابن، أسامورا يوتا

39
00:04:19,200 --> 00:04:21,240
تفضّل وعرّف عن نفسك

40
00:04:22,220 --> 00:04:23,470
سررتُ بلقائك

41
00:04:24,020 --> 00:04:25,360
اسمي أياسي ساكي

42
00:04:25,820 --> 00:04:26,610
ماذا؟

43
00:04:27,230 --> 00:04:28,210
...أبي

44
00:04:28,480 --> 00:04:31,850
أجل. ساكي-تشان هي في مثل سنّك

45
00:04:32,350 --> 00:04:34,900
.ستبلغ السّابعة عشر في هذا العام
سنة ثانية في الثّانوية

46
00:04:35,500 --> 00:04:38,720
لكن يوم ميلادك قبل يوم ميلادها بأسبوع

47
00:04:39,090 --> 00:04:41,700
أعتذر عن الإرباك

48
00:04:41,700 --> 00:04:46,010
الآن بعد أن أصبحت أكبر سنّاً، لن تدعني
ساكي ألتقط أي صورة لها فحسب

49
00:04:46,410 --> 00:04:50,550
ربّما هكذا أبدو، لكن لا أظهر
جذّابة جدّاً في الصّور

50
00:04:54,050 --> 00:04:55,770
لكنّني مُطمئنّة بصراحة

51
00:04:56,190 --> 00:04:56,790
ماذا؟

52
00:04:57,310 --> 00:05:00,250
،بما أنّنا سنبدأ بالعيش معاً

53
00:05:00,250 --> 00:05:03,220
كنتُ قلقة من أن تكون شخصاً مُخيفاً

54
00:05:05,310 --> 00:05:06,830
أتساءل حول ذلك

55
00:05:06,830 --> 00:05:09,910
الأشخاص المُخيفون فعلاً يبدو لطيفين غالباً

56
00:05:10,490 --> 00:05:14,690
سمعتُ بأنّك تعمل يوميّاً للادّخار
من أجل الكلّية

57
00:05:14,950 --> 00:05:17,430
وبأنّك تُحرِز درجات جيّدة

58
00:05:17,770 --> 00:05:20,310
كثير من المجرمين هم أذكياء في الواقع

59
00:05:28,420 --> 00:05:31,240
،قبل خروج أمّي وأبيك معاً

60
00:05:31,240 --> 00:05:33,700
هناك شيء أريد أن أناقشه

61
00:05:34,040 --> 00:05:35,450
شيء لا تريدينهما أن يسمعاه؟

62
00:05:35,670 --> 00:05:39,850
أجل. أو بعبارة أدقّ، كلام
لا يمكنني قوله إلّا لك

63
00:05:40,460 --> 00:05:44,160
هل اكتسبتُ ثقتكِ خلال فترة
قصيرة كهذه فعلاً؟

64
00:05:44,970 --> 00:05:46,300
أنا مندهش من نفسي

65
00:05:50,400 --> 00:05:54,640
،حسّ الدّعابة ذاك، طريقة كلامك
...وطريقة تصرّفاتك

66
00:05:55,360 --> 00:05:58,180
كلّها ليّنة حقّاً

67
00:05:59,130 --> 00:06:00,420
،لذا ارتأيت

68
00:06:01,040 --> 00:06:04,880
أنّك ستتمكّن ربّما من فهم ما أنا
على وشك أن أقوله

69
00:06:17,800 --> 00:06:20,410
،لا أتوقّع شيئاً منك

70
00:06:21,280 --> 00:06:24,100
لذا لا أريدك أن تتوقّع شيئاً منّي أيضاً

71
00:06:26,680 --> 00:06:30,820
تفهم ما أعنيه بذلك، أليس كذلك؟

72
00:06:37,930 --> 00:06:39,160
هذا جيّد

73
00:06:42,150 --> 00:06:43,450
أنا مُطمئنّ حقّاً

74
00:06:44,100 --> 00:06:45,360
للمرّة الأولى اللّيلة

75
00:06:52,860 --> 00:06:53,800
أجل، أنا أيضاً

76
00:06:54,520 --> 00:06:56,120
للمرّة الأولى

77
00:06:57,010 --> 00:07:00,010
لنُحافظ على هذا الموقف فحسب يا أياسي-سان

78
00:07:02,370 --> 00:07:04,390
شكراً لك يا أسامورا-كن

79
00:07:11,740 --> 00:07:12,740
يوتا؟

80
00:07:13,210 --> 00:07:15,090
هل رأيت البخّاخ؟

81
00:07:15,090 --> 00:07:16,090
للرّوائح الكريهة؟

82
00:07:16,600 --> 00:07:17,840
إنّه بجانب التّلفزيون

83
00:07:18,320 --> 00:07:20,830
تركتَه هناك بعد استخدامه
على السّتارة البارحة

84
00:07:20,830 --> 00:07:22,930
حقّاً؟

85
00:07:24,350 --> 00:07:25,290
شكراً

86
00:07:26,100 --> 00:07:28,410
لماذا تتصرّف بتوتُّر في هذه الفترة؟

87
00:07:28,410 --> 00:07:33,720
،في الواقع، أجّلتُ تنظيف غرفة النّوم
لكن سرعان ما بدأتُ أقلق

88
00:07:34,540 --> 00:07:36,570
سأحزن حقّاً إذا قالتْ لي أنّ رائحته كريهة

89
00:07:36,570 --> 00:07:37,800
أنت حسّاس جدّاً

90
00:07:37,800 --> 00:07:41,000
عندما تصبح في سنّي، ستكون
!مثل هذه الأشياء هامّة بالنّسبة لك

91
00:07:43,740 --> 00:07:44,570
!يوتا

92
00:07:44,930 --> 00:07:45,740
نعم

93
00:07:49,340 --> 00:07:54,240
أحضرتُ بعض الأشياء للتّعبير عن شكري
!لك على ضيافتك

94
00:07:56,200 --> 00:07:57,600
...المعذرة

95
00:07:57,600 --> 00:07:59,120
ليس عليك القلق بشأن ذلك

96
00:07:59,460 --> 00:08:04,120
أمّي لا تقول "لا" أبداً، لذا اشترَتْ
كلّ شيء نصحوها به

97
00:08:04,400 --> 00:08:05,950
مهلاً يا ساكي

98
00:08:05,950 --> 00:08:08,780
تجعلينني أبدو وكأنّني فاشلة كبالغة

99
00:08:08,780 --> 00:08:10,230
لكن هذا صحيح، أليس كذلك؟

100
00:08:12,050 --> 00:08:15,000
!يا لها من رائحة ليمون جميلة

101
00:08:15,240 --> 00:08:17,390
أنت تُحافظ على نظافة المنزل حقّاً

102
00:08:17,390 --> 00:08:19,480
—قضينا آخر بضعة أيّام نُنظّف

103
00:08:19,480 --> 00:08:21,850
كأنّ تايشي-سان أخبرني

104
00:08:21,850 --> 00:08:24,230
!أنت أنيق ومُرتّب حقّاً

105
00:08:24,800 --> 00:08:26,860
،يُقال أنّه لتنمية عقل صحّي

106
00:08:26,860 --> 00:08:29,400
يجب تنمية بيئة صحّية أوّلاً

107
00:08:29,810 --> 00:08:34,060
إنَّ التّنظيف للتخلّص من كلّ ذرّة غُبار
هو من تقاليد عائلة أسامورا

108
00:08:34,500 --> 00:08:36,610
يبدو لي تقليداً عائليّاً مشؤوماً

109
00:08:37,580 --> 00:08:39,430
!تايشي-سان رجل مُبهر

110
00:08:40,520 --> 00:08:43,000
.أجل، أنا بخير. يمكنني فعلها
!ها أنا ذا

111
00:08:43,350 --> 00:08:45,370
!أكيكو-سان! ساكي-سان

112
00:08:50,130 --> 00:08:51,700
!أهلاً بكما في منزلنا المُتواضع

113
00:08:53,390 --> 00:08:57,760
مـ-من الآن فصاعداً، لنعِش بسعادة
!تحت نفس السّقف

114
00:09:06,990 --> 00:09:08,820
!شكراً جزيلاً لك

115
00:09:12,770 --> 00:09:13,610
إنّها هنا

116
00:09:14,830 --> 00:09:17,030
،حضّرنا سريراً وستارة لك

117
00:09:17,370 --> 00:09:21,160
،لكن لم نكن متأكّدين من اللّون الّذي تحبّينه
لذا يمكننا تغييره عند الضّرورة

118
00:09:21,930 --> 00:09:24,840
وضعنا المقعد بجانب النّافذة حاليّاً

119
00:09:25,110 --> 00:09:27,000
إذا أردتِ نقله، فأبلغينا رجاء

120
00:09:28,030 --> 00:09:29,050
شكراً

121
00:09:29,930 --> 00:09:31,140
إنّها غرفة كبيرة

122
00:09:31,700 --> 00:09:33,420
أعتقد بأنّها عاديّة جدّاً

123
00:09:35,400 --> 00:09:38,020
كان منزلي القديم شقّة مُتَضَعضِعة

124
00:09:38,280 --> 00:09:39,750
غرفة بمساحة ستّة تاتامي فقط

125
00:09:40,480 --> 00:09:42,380
لم تكن لديّ غرفة نوم خاصّة حتّى

126
00:09:42,380 --> 00:09:43,390
هكذا إذاً

127
00:09:43,390 --> 00:09:47,220
إذاً هل كنتُما تمدّان الفِراش وتنامان
في نفس الغرفة... ربّما؟

128
00:09:47,390 --> 00:09:52,550
لا. كانت أمّي تعمل ليلاً، لذا كنّا
نعيش جدولين زمنيّين متعاكسين

129
00:09:52,690 --> 00:09:54,440
عندما كنتُ أنام، المكان كلّه لي

130
00:09:54,860 --> 00:09:56,130
هكذا إذاً

131
00:09:56,540 --> 00:09:59,550
لكن أنا متأكّد بأنّ هذا مُريح من ناحية

132
00:10:00,080 --> 00:10:03,120
أعتذر لأنّه يترتّب عليكِ الآن مُشاركة
منزل مع رجلين

133
00:10:04,160 --> 00:10:05,690
،لا أبالي لذلك

134
00:10:06,860 --> 00:10:08,180
لكن ثمّة أمر واحد

135
00:10:09,640 --> 00:10:10,600
ما هو؟

136
00:10:11,460 --> 00:10:12,330
هذا

137
00:10:13,420 --> 00:10:14,960
لماذا تتكلّم معي بلطف؟

138
00:10:17,270 --> 00:10:18,950
...لماذا؟ لأنّ

139
00:10:19,440 --> 00:10:22,760
نحن في نفس السنّ، لِذا لِمَ
لا يمكنك أن تكون أكثر رخاء؟

140
00:10:23,370 --> 00:10:25,710
ربّما السّبب بالتّحديد هو لأنّنا في نفس السنّ

141
00:10:26,290 --> 00:10:29,600
لكن أقصد إذا كنت تتكلّم مع زُملاء
،في الصفّ وأصدقاء

142
00:10:29,600 --> 00:10:31,440
أليس من الغريب التكلّم بتلك
الرّسميّة طوال الوقت؟

143
00:10:32,310 --> 00:10:34,500
ربّما من وجهة نظر رابح

144
00:10:35,690 --> 00:10:36,840
أوتظنّ ذلك؟

145
00:10:37,480 --> 00:10:40,680
،لا يحقّ لي أن أنتقدك

146
00:10:41,180 --> 00:10:44,000
،لكن إذا كنت تحاول أن تكون لطيفاً معي فحسب

147
00:10:44,000 --> 00:10:45,720
فلستُ بحاجة ذلك إطلاقاً

148
00:10:46,950 --> 00:10:49,140
...هذا ليس ما أحاول فعله بالضّبط

149
00:10:53,470 --> 00:10:58,190
لكن يبدو هذا وكأنّه شيء ينبغي لنا
،أن نستوضحه، لذا سأسأل

150
00:10:59,890 --> 00:11:03,810
هل تفضّلين ألّا أتكلّم معك بلغة رسميّة؟

151
00:11:05,250 --> 00:11:10,560
أجل. بصراحة، أعتقد أنّ الكلام
العفويّ مُريح أكثر بكثير

152
00:11:11,510 --> 00:11:15,130
لستُ شخصاً يستحقّ كلّ هذا
الاحترام على أيّ حال

153
00:11:17,440 --> 00:11:18,350
حسناً

154
00:11:19,020 --> 00:11:20,230
سوف أتخلّى عن الرّسميّات إذاً

155
00:11:21,860 --> 00:11:23,190
بهذه الطّريقة، أجل

156
00:11:24,010 --> 00:11:27,050
قد يكون من الصّعب عليّ أن أعاملكِ
،نفس معاملة صديق مُقرّب

157
00:11:27,530 --> 00:11:30,390
لكن أقدِّر صراحتكِ معي واتّخاذ الأمور ببساطة

158
00:11:31,330 --> 00:11:32,700
هذا أسهل بالنّسبة لي أيضاً

159
00:11:33,760 --> 00:11:34,580
حسناً

160
00:11:38,260 --> 00:11:40,130
هذا ما توقّعتُه بالضّبط

161
00:11:40,930 --> 00:11:44,260
من النّافع حقّاً أن نستطيع تلطيف
الأمور بهذه السّلاسة

162
00:11:45,350 --> 00:11:47,240
تلطيف الأمور؟

163
00:11:47,870 --> 00:11:49,310
هذه طريقة جيّدة للتّعبير عن الأمر

164
00:11:50,030 --> 00:11:52,900
عندما تكلّمتُ مع صديقاتي عن هذا
في المدرسة، سخروا منّي

165
00:11:53,220 --> 00:11:56,260
"ما هذا؟ عقد من نوع ما؟"

166
00:11:56,260 --> 00:11:58,650
لم يتّخذنني على محمل الجدّ

167
00:11:59,500 --> 00:12:01,440
لا بدّ أنّكِ تعانين من ذلك

168
00:12:03,100 --> 00:12:03,940
أجل

169
00:12:04,450 --> 00:12:07,360
لذا قطعتُ روابطي معهن جميعاً ما عدا واحدة

170
00:12:07,750 --> 00:12:09,150
يؤسفني سماع ذلك

171
00:12:09,420 --> 00:12:10,360
لا عليك

172
00:12:10,360 --> 00:12:13,000
أنا أقطع علاقتي مع الأشخاص الّذين
لا يستحقّون الاحتفاظ بهم على أيّ حال

173
00:12:14,620 --> 00:12:16,880
لا يمكنني قراءة عقولهم

174
00:12:16,880 --> 00:12:19,120
،وإذا لم يبذلوا أي جهد لمُحاولة إخباري

175
00:12:19,120 --> 00:12:21,060
فلا أستطيع تحليل مشاعرهم طوال الوقت

176
00:12:21,350 --> 00:12:22,400
هذه مضيعة للوقت

177
00:12:26,890 --> 00:12:29,110
أتريدين مساعدة في توضيب أمتعتكِ؟

178
00:12:34,470 --> 00:12:35,840
هذا لطف منك حقّاً

179
00:14:04,840 --> 00:14:05,740
لحظة

180
00:14:07,090 --> 00:14:09,450
أياسي-سان، هل تذهبين إلى سيسي؟

181
00:14:09,850 --> 00:14:10,840
أجل

182
00:14:11,720 --> 00:14:15,040
هل أنت متفاجئ من أنّ فتاة مُبهرجة
مثلي تذهب إلى مدرسة تحضيريّة؟

183
00:14:15,430 --> 00:14:16,840
...لا

184
00:14:17,910 --> 00:14:19,370
في الواقع، أنا في تلك المدرسة أيضاً

185
00:14:20,380 --> 00:14:21,230
فهمت

186
00:14:21,970 --> 00:14:23,290
آسف بشأن ذلك

187
00:14:24,080 --> 00:14:26,700
لا سبب يدفعك للاعتذار

188
00:14:27,580 --> 00:14:31,520
لكن في المدرسة، سأبذل قصارى
جهدي في التّظاهر بأنّني لا أعرفك

189
00:14:33,200 --> 00:14:34,310
لا أكترث

190
00:14:34,310 --> 00:14:36,130
أنا بخير في كلتا الحالتين

191
00:14:39,080 --> 00:14:44,190
رغم ذلك، قد يكون من الأفضل لك
أن نفعل ذلك يا أسامورا-كن

192
00:14:44,890 --> 00:14:46,800
...ماذا؟ هل تقصدين

193
00:14:49,410 --> 00:14:51,150
...آسف. المعذرة

194
00:14:51,150 --> 00:14:52,110
أجِب فحسب

195
00:14:52,370 --> 00:14:55,760
لا أنزعج عندما تتكلّم على الهاتف

196
00:14:56,470 --> 00:14:57,290
شكراً لكِ

197
00:15:01,610 --> 00:15:02,440
مرحباً؟

198
00:15:03,570 --> 00:15:04,590
أجل. حسناً

199
00:15:07,800 --> 00:15:10,170
اليوم؟

200
00:15:14,190 --> 00:15:15,690
يا زميلي الكوهاي في العمل

201
00:15:16,080 --> 00:15:19,240
لاحظتُ بأنّ رائحة فتاة تفوح
منك طوال اليوم

202
00:15:19,240 --> 00:15:19,820
ماذا؟

203
00:15:20,320 --> 00:15:22,370
هل حصلت على حبيبة أو ما شابه؟

204
00:15:22,370 --> 00:15:24,900
كفاك سخافة

205
00:15:25,420 --> 00:15:27,030
لكن هل رائحتي تفوح بذلك حقّاً؟

206
00:15:27,030 --> 00:15:28,700
أجل، إنّها رائحة قويّة

207
00:15:28,700 --> 00:15:32,650
كم تعانقتما حتّى علقت بك كلّ هذه
الكمّية من الرّوائح؟

208
00:15:32,650 --> 00:15:34,150
أعتقد ينبغي أن أغادر باكراً

209
00:15:34,150 --> 00:15:37,350
!لم أقصد ذلك! لا تتركني هنا بمفردي

210
00:15:39,700 --> 00:15:41,860
كنتُ أمزح على أيّ حال

211
00:15:42,440 --> 00:15:45,380
أخبرتني من قبل، صحيح؟
عن أختك الصّغرى الجديدة

212
00:15:45,750 --> 00:15:47,560
توقّعتُ بأنّها انتقلَتْ إلى منزلك
خلال هذه الفترة

213
00:15:47,560 --> 00:15:49,510
وبعد؟ هل هي ظريفة؟

214
00:15:49,920 --> 00:15:52,380
في الواقع... إنّها جميلة

215
00:15:54,880 --> 00:15:56,800
الإقامة مع فتاة جميلة

216
00:15:56,800 --> 00:15:58,530
أنت تعيش ريعان شبابك

217
00:15:58,530 --> 00:16:00,310
لن يحدث شيء

218
00:16:00,310 --> 00:16:02,910
لكن قد تحدث أمور شقيّة، صحيح؟

219
00:16:03,290 --> 00:16:06,380
لديكِ عادة إطلاق دعابات عجائزيّة سيّئة

220
00:16:06,380 --> 00:16:08,050
أنصحكِ بالتخلّص من هذه العادة

221
00:16:08,800 --> 00:16:12,160
بعد ارتياد مدرسة إعداديّة وثانويّة
وكلّية خاصّة بالإناث، ما باليد حيلة

222
00:16:12,790 --> 00:16:15,910
يا لها من طريقة فظيعة للافتراء
على مدارس الإناث

223
00:16:17,910 --> 00:16:19,130
،لكن بصراحة

224
00:16:19,130 --> 00:16:22,610
الوقت غير مناسب لي لتراودني
مثل هذه الأفكار حقّاً

225
00:16:24,370 --> 00:16:25,870
هذا يُجهد تفكيري

226
00:16:26,490 --> 00:16:29,490
كيف يُفترض بنا أن نتصرّف كأخ وأخت؟

227
00:16:32,060 --> 00:16:35,690
بالنّسبة لك يا كوهاي، قد يكون من الأفضل
التصرُّف بشكل طبيعيّ فحسب

228
00:16:37,220 --> 00:16:38,320
!عمت مساء

229
00:18:06,670 --> 00:18:07,540
عُدت

230
00:18:11,850 --> 00:18:13,340
آسفة

231
00:18:13,820 --> 00:18:17,400
،لم يقل أحد لي "عُدت" من قبل

232
00:18:18,090 --> 00:18:21,070
لذا لم أعرف كيف أردّ

233
00:18:25,680 --> 00:18:27,590
ثمّة نظرة جادّة في وجهك

234
00:18:30,050 --> 00:18:31,280
لا داعي للقلق

235
00:18:31,610 --> 00:18:35,440
ليس وكأنّني عوملت بشكل سيّئ

236
00:18:40,010 --> 00:18:46,250
كانت أمّي تعود إلى المنزل عندما أكون
في المدرسة للنّوم ولأداء الأعمال المنزليّة

237
00:18:46,250 --> 00:18:48,850
وتذهب إلى العمل عندما أعود إلى المنزل

238
00:18:50,780 --> 00:18:53,780
كان هذا شكل حياتنا اليوميّة

239
00:18:57,300 --> 00:18:59,580
بدا وكأنّكما منسجمتان

240
00:18:59,850 --> 00:19:03,550
ماذا؟ بالطّبع، فنحن عائلة

241
00:19:06,290 --> 00:19:08,830
اليوم ذهبنا للتسوّق للمرّة الأولى
منذ مدّة طويلة

242
00:19:09,770 --> 00:19:11,380
كان ذلك مُمتعاً للغاية

243
00:19:13,480 --> 00:19:14,500
حقّاً؟

244
00:19:14,760 --> 00:19:15,520
أجل

245
00:19:17,270 --> 00:19:19,170
لم تستحمّي بعد، صحيح؟

246
00:19:19,440 --> 00:19:20,230
لا

247
00:19:21,060 --> 00:19:22,760
من ينبغي أن يستحمّ أوّلاً؟

248
00:20:07,080 --> 00:20:08,280
يمتلئ الحمّام بالماء الآن

249
00:20:17,140 --> 00:20:19,600
تغيّرت درجة حرارة الماء

250
00:20:46,860 --> 00:20:47,580
نعم؟

251
00:20:49,650 --> 00:20:50,560
انتهيت

252
00:20:51,670 --> 00:20:53,630
الحمّام كلّه لك

253
00:20:59,270 --> 00:21:01,040
تصبحين على خير يا أياسي-سان

254
00:21:02,880 --> 00:21:03,820
شكراً لك

255
00:21:05,060 --> 00:21:07,080
تصبح على خير يا أسامورا-كن

256
00:23:22,520 --> 00:23:23,200
ماذا؟

257
00:23:46,550 --> 00:23:49,990
الحلقة 2: صفقة وبيضة مقليّة