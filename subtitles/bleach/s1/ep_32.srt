1
00:01:34,850 --> 00:01:36,270
!ببغاءٌ ملعون؟

2
00:01:36,520 --> 00:01:37,980
...نعم، وبشأن هذا

3
00:01:38,520 --> 00:01:41,730
.فقد سمعتُ  أنَ مالكهُ السابق أصابهُ الحظ السيئ، ثم مات

4
00:01:42,360 --> 00:01:43,070
!حقًا؟

5
00:01:43,610 --> 00:01:44,480
.هذا فظيع

6
00:01:46,450 --> 00:01:47,650
شيجو"هل تُريد أن تحتفظ به ؟"

7
00:01:48,450 --> 00:01:51,070
!بعد سماعي ذلك، بالطبع لا

8
00:01:51,950 --> 00:01:54,290
لماذا لم تتخلص منهُ سابقًا؟

9
00:01:54,750 --> 00:01:56,540
.لكن... ذلك سيكون قاسٍ جدًا

10
00:01:57,120 --> 00:01:58,080
ماذا عنك يا شادو سان؟

11
00:01:58,290 --> 00:01:59,330
.إنهُ ببغاءٌ لطيف

12
00:02:01,420 --> 00:02:02,670
.كُفَّ عن ذلك أيُّها الأحمق

13
00:02:02,800 --> 00:02:04,590
.فشادو لا ينجرف للأشياء اللطيفة

14
00:02:09,350 --> 00:02:09,760
...ماذا

15
00:02:21,190 --> 00:02:23,770
...نحنُ سنُواصل الالتهام

16
00:02:24,820 --> 00:02:31,530
،لكي نملئ الفراغ الذي يُسيطر على وُجودنا
!يجب أن نُواصل الالتهام

17
00:02:32,450 --> 00:02:37,540
.إنَ الشينيجامي هُم الوحيدون الذينَ يمنعوننا من فعلِ ذلكَ أحيانًا

18
00:02:37,920 --> 00:02:42,540
.عندما يقع أحدٌ بالطُعم، فسيقع في شباكنا حتمًا

19
00:02:55,560 --> 00:02:56,350
...شادو سان

20
00:02:58,560 --> 00:02:59,850
هل أنتَ بخيرٍ يا شادو؟

21
00:03:00,730 --> 00:03:01,100
.أجل

22
00:03:02,110 --> 00:03:02,900
.هذا لا شيء

23
00:03:03,940 --> 00:03:04,980
!هل هذا لا شيء؟

24
00:03:05,610 --> 00:03:06,650
! أنتَ تنزف

25
00:03:07,610 --> 00:03:09,610
.شكرًا لكَ لحمايتي

26
00:03:10,610 --> 00:03:13,030
.إنَ اسمي هوُ شيباتا يويتشي

27
00:03:13,280 --> 00:03:14,780
ما اسمكَ أيُّها السيد ؟

28
00:03:15,740 --> 00:03:16,990
!ما هذا الطير؟

29
00:03:17,540 --> 00:03:19,200
.يبدو وكأنهُ يفهمُ كُل ما يحدثُ حوله

30
00:03:19,790 --> 00:03:21,660
.إنهُ ببغاءٌ ملعون حقًا

31
00:03:22,210 --> 00:03:23,750
ما اسمُكَ أيُّها السيد ؟

32
00:03:26,000 --> 00:03:27,710
سادو ياستورا

33
00:03:29,050 --> 00:03:30,460
.عمري 15 عامًا

34
00:03:30,760 --> 00:03:31,590
!هذا سيئ

35
00:03:31,840 --> 00:03:33,590
.شادو لُعنَ بواسطته

36
00:03:36,930 --> 00:03:38,220
...هذا غريب

37
00:03:38,930 --> 00:03:41,650
.أنا لا أستطيع أن أُصدق بأنَ جراحي شُفيت بيوم واحد

38
00:03:42,480 --> 00:03:43,240
هل أنتَ مُندهش؟

39
00:03:43,810 --> 00:03:46,740
"الكيدو ينقسم إلى قسميْن: "الباكودو
.أسلوب الحجز، و"الهادو" أسلوب التدمير

40
00:03:43,810 --> 00:03:46,740
.فقد كُنتُ أنا الأعلى في درجات الكيدو، في فصلي

41
00:03:47,190 --> 00:03:48,990
.العلاج عندي كأكل قطعةٍ من الكعك

42
00:03:49,320 --> 00:03:49,940
درجات؟

43
00:03:50,820 --> 00:03:51,150
...ماذا

44
00:03:51,990 --> 00:03:53,450
هل الشينيجامي يذهبون إلى المدرسة ؟

45
00:03:54,580 --> 00:03:55,320
.هذا صحيح

46
00:03:55,990 --> 00:03:56,910
...على أي حال يا إيتشيغو

47
00:03:57,950 --> 00:03:59,330
كيفَ تشربون هذا؟

48
00:04:01,120 --> 00:04:01,700
كيف؟

49
00:04:02,420 --> 00:04:04,170
اثقبي هذهِ الدائرة ومن ثم اشربيه، هل هذا واضح؟

50
00:04:04,840 --> 00:04:05,540
الدائرة ؟

51
00:04:07,630 --> 00:04:08,040
أهـ

52
00:04:08,260 --> 00:04:09,090
أنتما معًا مرةً أُخرى؟

53
00:04:10,760 --> 00:04:12,340
.أنتما كعشيقيْن أو شيئٌ من هذا القبيل

54
00:04:13,140 --> 00:04:13,840
!ميزيرو

55
00:04:14,930 --> 00:04:17,800
أيُّها الغبي، هل يبدو ذلك كالحُبّ بالنسبة لك؟

56
00:04:19,350 --> 00:04:20,010
هل أنا مُخطئ؟

57
00:04:21,020 --> 00:04:23,390
.حسنًا، إن كان ذلك رأيك، فهذا لا يعني لي شيئًا أيضًا

58
00:04:24,310 --> 00:04:28,480
لا أعرف كيفَ أقول لكَ هذا يا إيتشيغو ، ولكن يتوجب
.عليك أن تتقبل ما أنتَ عليهِ حينما يقولونهُ الناس

59
00:04:29,030 --> 00:04:29,820
.أيُّها الأبله

60
00:04:30,400 --> 00:04:34,320
لو كنتُ أُبالي بما يُثرثر بقية الناس؛ لكنتُ قد
.صبغتُ شعري لللون الأسود قبل سنوات

61
00:04:34,870 --> 00:04:35,740
.في هذهِ أنتَ مُحق

62
00:04:36,120 --> 00:04:37,240
هكذا إذًا تُشرب؟

63
00:04:38,830 --> 00:04:41,830
ولكن أينَ يتوجب علي إدخالُها ؟

64
00:04:43,370 --> 00:04:44,710
.كوتشكي سان، مرحبًا

65
00:04:46,080 --> 00:04:49,420
.مرحبًا... كويجما كُن

66
00:04:50,210 --> 00:04:50,920
.صحيح

67
00:04:51,590 --> 00:04:53,340
فأنا لم أُقدم نفسي بعد، أليس كذلك؟

68
00:04:54,130 --> 00:04:55,380
.أنا "كوجيما ميزور"، أبلغ من العمر خمسة عشر عامًا

69
00:04:55,800 --> 00:04:56,340
-هواياتي هي

70
00:04:56,350 --> 00:04:57,130
.صيد الفتيات

71
00:04:57,470 --> 00:04:57,840
ماذا؟

72
00:04:58,100 --> 00:04:58,800
.لا ليسَ هذا

73
00:04:58,890 --> 00:04:59,600
.أنتَ قاسٍ جدًا

74
00:05:00,140 --> 00:05:02,470
.إنهُ يبدو وكأنهُ بريء ولكنهُ مُتصيد فتيات

75
00:05:02,810 --> 00:05:03,390
.كوني حذرة

76
00:05:04,020 --> 00:05:04,930
.كفَ عن ذلك

77
00:05:05,350 --> 00:05:07,020
!فأنتَ تُشوّه صورتي

78
00:05:08,070 --> 00:05:11,070
.بالإضافة إلى أنّني مُهتمٌ بالنساء الكبيرات في السنّ فقط

79
00:05:11,150 --> 00:05:12,900
.لهذا أخبرتها أن تكون حذرة

80
00:05:13,400 --> 00:05:13,690
هاهـ ؟

81
00:05:13,940 --> 00:05:16,330
أقدم من

82
00:05:13,940 --> 00:05:16,330
الجحيم

83
00:05:17,620 --> 00:05:18,280
.لا عليك

84
00:05:19,030 --> 00:05:19,700
!ما هذا؟

85
00:05:20,080 --> 00:05:22,660
!إنّني أرى طالبة فصلنا الجميلة، كوتشكي سان

86
00:05:23,080 --> 00:05:23,870
ما الذي تفعلينهُ هنا ؟

87
00:05:24,710 --> 00:05:26,750
.إنَ إيتشيغو هو من استدرجها إلى هنا

88
00:05:27,170 --> 00:05:27,790
.غير صحيح

89
00:05:27,920 --> 00:05:28,620
ماذا ؟

90
00:05:29,000 --> 00:05:29,960
.إيتشيغو أيُّها اللقيط

91
00:05:30,590 --> 00:05:31,590
.أحسنتَ عملًا

92
00:05:32,920 --> 00:05:34,760
أتبكِ من شدة السعادة ؟

93
00:05:37,470 --> 00:05:41,180
شكرًا لكِ لقدومكِ لهذهِ الحديقة المُكونة
.من الرجال الشجعان أيتُها القائدة

94
00:05:41,810 --> 00:05:42,510
.مرحبًا

95
00:05:42,850 --> 00:05:43,760
.حسنًا، يا رفاق

96
00:05:44,020 --> 00:05:46,430
!غدًا سنُقيم حفلة

97
00:05:46,430 --> 00:05:48,300
.وسوفَ نُحضر قهوةً بالحليب وشطائر الياكوسوبا

98
00:05:48,400 --> 00:05:49,230
.اخرس

99
00:05:49,610 --> 00:05:50,730
! يالكَ من مُقزز

100
00:05:51,320 --> 00:05:55,280
بالمُناسبة يا كوتشكي سان ، إن احتجتِ إلى
.أيّ مُساعدة، فأرجو أن تطلُبيها منّي

101
00:05:56,410 --> 00:05:56,940
!حقًا؟

102
00:05:57,240 --> 00:05:59,360
.أجل، بالطبع

103
00:06:00,120 --> 00:06:01,030
!هويـ، شادو

104
00:06:03,540 --> 00:06:05,660
أنتَ... مُصاب؟

105
00:06:06,580 --> 00:06:07,620
.إنكَ مُحق

106
00:06:07,880 --> 00:06:08,710
ما الذي حدثَ لك ؟

107
00:06:09,420 --> 00:06:12,380
الجُرح الذي على رأسي كانَ سببهُ وقوع
.إنذار شؤمٍ عليّ ليلة أمس

108
00:06:13,050 --> 00:06:13,960
إنذار شؤم؟

109
00:06:14,380 --> 00:06:18,300
.أما الجُرح الذي على يدي هو أثر اصطدامي مع دراجةٍ ناريّةٍ اليوم

110
00:06:19,600 --> 00:06:25,100
.الراكب قد تأذى بشكٍل سيئ، لذا ذهبتُ بهِ إلى المُستشفى

111
00:06:25,850 --> 00:06:27,600
.إذًا فهذا هو سبب تأخركَ اليوم

112
00:06:27,700 --> 00:06:31,060
على أي حال، ما زلتُ أتساءل، مما صُنعتَ يا رجل؟

113
00:06:32,860 --> 00:06:34,610
أوهـ، ما هذا الطير؟

114
00:06:35,900 --> 00:06:39,400
."مرحبًا، اسمي هو "شيباتا يوتشي

115
00:06:39,740 --> 00:06:41,070
ما هي أسمائكم؟

116
00:06:42,910 --> 00:06:44,080
! أوهــ! هذا رهيب

117
00:06:44,250 --> 00:06:45,990
! هذا الشيء يُمكنهُ أن يتكلم بطلاقة

118
00:06:46,000 --> 00:06:48,170
"إن اسمي هو "آسانو كيجو

119
00:06:48,460 --> 00:06:48,830
هل بإمكانكَ قوله؟

120
00:06:50,290 --> 00:06:52,580
شادو، من أين حصلتَ على هذا الببغاء؟

121
00:06:53,420 --> 00:06:54,000
...بالأمس

122
00:07:00,090 --> 00:07:00,670
.حصلتُ عليه...

123
00:07:01,260 --> 00:07:02,260
ماذا؟

124
00:07:02,890 --> 00:07:05,930
أنتَ أردتَ أن تروي لنا القصة كاملة
لكنّك تكاسلت، أليس كذلك؟

125
00:07:06,480 --> 00:07:07,350
.إنها عادةٌ سيئّة

126
00:07:07,600 --> 00:07:08,890
.أخبرنا، أخبرنا بكلِّ شيء

127
00:07:09,230 --> 00:07:10,060
.هذهِ هي القصة كاملة

128
00:07:10,270 --> 00:07:11,770
.لا هذا مُستحيل

129
00:07:12,520 --> 00:07:13,350
.أنت تعرف

130
00:07:14,070 --> 00:07:14,730
.لا تقلقْ

131
00:07:16,150 --> 00:07:17,860
...هنالكَ شيءٌ ما بداخل هذا الطير بالتأكيد، ولكن

132
00:07:18,450 --> 00:07:19,400
.لكنهُ غير مُؤذٍ

133
00:07:20,410 --> 00:07:22,240
.منَ المُحتمل أنها روح ٌوحيدة لا أكثر

134
00:07:23,280 --> 00:07:25,780
.ولكن، حتى معَ هذا فلا يُمكننا تركه هكذا

135
00:07:27,620 --> 00:07:30,870
.يتوجب علينا في هذهِ الليلة دفن روحهُ

136
00:07:31,920 --> 00:07:32,790
.حسنًا

137
00:07:33,250 --> 00:07:35,500
.سوفَ أتأخر في النوم مُجددًا

138
00:07:36,460 --> 00:07:37,550
.توقف عن التذمر

139
00:07:38,300 --> 00:07:39,340
.حسنًا، حسنًا

140
00:07:40,880 --> 00:07:44,970
لكنه... بدأ فورًا بالقلق بشأن الآخرين
.بمُجرد أن ذلك الببغاء شبح

141
00:07:45,680 --> 00:07:49,350
.ربما هو بدأ يفهم أخيرًا عمل الشينيجامي

142
00:07:49,810 --> 00:07:50,310
.خُذي

143
00:07:51,850 --> 00:07:52,440
.شكرًا

144
00:07:54,230 --> 00:07:55,150
...المرحلة الثامنة، أي ثالث مُتوسط

145
00:07:54,230 --> 00:07:55,150
...عندما كُنتُ في المرحلة الثامنة

146
00:07:57,030 --> 00:07:58,400
...عندما التقيتُ بشادو لأول مرّة

147
00:08:01,570 --> 00:08:05,200
.في ذلكَ الوقت، كانَ البعض يتشاجر معي بسبب لون شعري الغريب

148
00:08:06,120 --> 00:08:07,280
لقد كنتُ أتشاجر دائمًا

149
00:08:08,750 --> 00:08:11,420
ثمَّ أصبحت الأمور تأخذ طابعًا جديًّا

150
00:08:25,970 --> 00:08:27,600
!مَن أنتَ بحق الجحيم؟

151
00:08:38,400 --> 00:08:39,440
!فلتمت

152
00:08:58,050 --> 00:09:00,210
.ظلَّ شادو واقفًا دون قتال، ولم يكن هنالك أملٌ لهزيمته

153
00:09:02,430 --> 00:09:03,260
.إنهُ أمرٌ غير طبيعي

154
00:09:03,760 --> 00:09:04,130
.أجل

155
00:09:07,050 --> 00:09:08,090
! هذا العصير لذيذ

156
00:09:08,930 --> 00:09:09,550
...هذا صحيح

157
00:09:15,940 --> 00:09:16,640
.لقد عُدت

158
00:09:17,150 --> 00:09:18,480
!ابتعد! ابتعد! ابتعد

159
00:09:20,440 --> 00:09:21,320
ما الأمر يا كارين ؟

160
00:09:21,360 --> 00:09:22,150
-ما كُلُّ هذه الضجّة

161
00:09:23,780 --> 00:09:25,030
.أهـ، مرحبًا بعودتك يا أخي

162
00:09:26,160 --> 00:09:27,490
ما كُلُّ هذا الإزعاج؟

163
00:09:28,280 --> 00:09:31,080
.كانَ هُنالكَ حادث مُرورٍ في التقاطع المُجاور

164
00:09:31,500 --> 00:09:32,370
حادث مُرور؟

165
00:09:33,000 --> 00:09:34,080
!لا يُمكنكَ نقلهم؟

166
00:09:34,710 --> 00:09:35,450
.افعل شيئًا حيال ذلك

167
00:09:35,920 --> 00:09:38,710
!لقد جلبنا المُصابين، ولكننا لسنا مُجهزين تمامًا بالمُعدات اللازمة

168
00:09:39,210 --> 00:09:43,050
!أنصت، أخبر رئيس الوحدة الصحيّة بأن هذا طلبٌ من كوروساكي

169
00:09:47,050 --> 00:09:47,630
هل فهمت؟

170
00:09:49,470 --> 00:09:50,010
.أبي

171
00:09:51,060 --> 00:09:53,720
!اللعنة، غبيٌ يتلكأ

172
00:09:53,880 --> 00:09:55,500
هل هُنالكَ ما أستطيع فعلهُ؟

173
00:09:55,400 --> 00:09:56,190
.لا شيء

174
00:09:57,610 --> 00:10:00,020
! اذهب إلى تلكَ الزاوية ولا تقف عائقًا في طريقي

175
00:10:05,070 --> 00:10:06,820
.هُنالكَ شخصٌ آخر يا أبي

176
00:10:09,080 --> 00:10:10,990
.هذا أضخم شخصٍ دَخلَ إلى عيادتنا

177
00:10:11,640 --> 00:10:13,240
.إيتشيغو، لقد حان وقت العمل

178
00:10:14,080 --> 00:10:14,540
.حسنًا

179
00:10:17,750 --> 00:10:18,120
شادو؟

180
00:10:35,890 --> 00:10:36,890
!يا لهُ من جُرحٍ مُروع

181
00:10:37,020 --> 00:10:38,850
.كم هذا مُؤلم

182
00:10:39,520 --> 00:10:41,270
.يبدو وكأنه حرق

183
00:10:41,650 --> 00:10:42,730
ما الذي ضربكَ يا تُرى؟

184
00:10:43,030 --> 00:10:43,900
...هذا الشعور

185
00:10:44,900 --> 00:10:47,110
...يجب عليكَ أن تدخلَ المُستشفى

186
00:10:47,150 --> 00:10:47,570
.لا

187
00:10:49,870 --> 00:10:51,530
.أنا بخيرٍ الآن

188
00:10:52,580 --> 00:10:53,530
!لا تكُن مُضحكًا

189
00:10:53,660 --> 00:10:56,200
.من المُستحيل أن تكون بخيرٍ مع كلِّ هذا الدم الذي فقدتَّه

190
00:10:58,870 --> 00:10:59,660
أرأيتَ ذلك؟

191
00:11:00,460 --> 00:11:01,370
.يوزو، كارين

192
00:11:01,790 --> 00:11:02,630
.فلتُجهّزا السّرير

193
00:11:03,050 --> 00:11:03,540
.حاضر

194
00:11:03,840 --> 00:11:05,960
كُن هادئًا واذهب إلى السرير، حسنًا؟

195
00:11:09,510 --> 00:11:10,090
هل شعرتِ بذلك؟

196
00:11:10,970 --> 00:11:11,590
.بالطبع

197
00:11:12,140 --> 00:11:13,590
.لقد شعرتُ بهِ من هُنا

198
00:11:15,060 --> 00:11:16,890
.أنا لم أشعر بشيءٍ من ذلكَ الطير

199
00:11:17,440 --> 00:11:18,470
...ولكن من جراحه

200
00:11:20,310 --> 00:11:21,480
!شممتُ رائحة هولو...

201
00:11:59,020 --> 00:11:59,850
.صباح الخير

202
00:12:00,160 --> 00:12:02,270
.إنهُ وقت الفطور يا أخي

203
00:12:02,770 --> 00:12:03,190
هاهـ؟

204
00:12:03,650 --> 00:12:04,440
أينَ كارين؟

205
00:12:04,980 --> 00:12:06,440
.قالت بأنها لا تُريد أيّ شيء

206
00:12:07,150 --> 00:12:09,570
.يبدو بأنها ليست بصحةٍ جيدة

207
00:12:10,650 --> 00:12:11,990
هل هي مريضة ؟

208
00:12:12,820 --> 00:12:14,160
-هذا غريب، فهي بالأمس

209
00:12:14,120 --> 00:12:15,110
.إيتشيغو

210
00:12:15,450 --> 00:12:16,030
!هُنالكَ مُشكلة

211
00:12:16,200 --> 00:12:18,030
.لقد اختفى شادو كُن من غُرفته

212
00:12:22,830 --> 00:12:23,370
.إيتشيغو

213
00:12:25,340 --> 00:12:25,830
.روكيا

214
00:12:26,960 --> 00:12:28,920
ماذا حدث معك ؟ هل وجدتَ لهُ أثرًا؟

215
00:12:28,910 --> 00:12:30,590
لا، ماذا عنكِ؟

216
00:12:31,010 --> 00:12:31,760
.وأنا مثلكَ، أيضًا

217
00:12:32,510 --> 00:12:34,970
.مُجتمع الأرواح يقول بأنَ مجموع الهولو حاليًا هو صفر

218
00:12:35,550 --> 00:12:36,590
.ولا شيء على الرادار

219
00:12:37,150 --> 00:12:38,320
عالم الأحياء

220
00:12:37,680 --> 00:12:45,440
،في الحقيقة، الهولو عندما لا يتواجد في العالَم الحيّ
.فإنه يختبئ في فراغ العالَم الحيّ و مُجتمع الأرواح

221
00:12:37,820 --> 00:12:42,110
الهولو

222
00:12:38,110 --> 00:12:42,110
الشينيجامي

223
00:12:38,320 --> 00:12:42,200
عالم الأحياء

224
00:12:42,250 --> 00:12:46,030
غير قابلٍ للكشف

225
00:12:42,410 --> 00:12:46,030
قابلٌ للكشف

226
00:12:53,280 --> 00:12:53,740
هل فهمت؟

227
00:12:54,160 --> 00:12:56,160
.بهذا الرسم القبيح، لا يُمكنني فهم أيّ شيء

228
00:12:57,610 --> 00:13:00,700
.هُنالكَ هولو يُطارد شادو

229
00:13:01,120 --> 00:13:03,870
.فإذا تأخرنا في إيجادهُ فسوفَ يهجم عليهِ

230
00:13:04,370 --> 00:13:05,330
...يجب علينا بطريقةٍ ما

231
00:13:07,420 --> 00:13:08,000
! هذا صحيح

232
00:13:08,090 --> 00:13:09,210
.شادو يحمل الببغاء معهُ

233
00:13:10,130 --> 00:13:12,590
.سأحاول تتبع تلكَ الروح التي يمتلكُها

234
00:13:13,550 --> 00:13:14,510
هذا مُستحيل

235
00:13:14,720 --> 00:13:15,720
...حسنًا

236
00:13:29,400 --> 00:13:30,820
.إيتشيغو...

237
00:13:31,650 --> 00:13:33,690
ما هذا الشعور الغريب؟

238
00:13:43,080 --> 00:13:43,740
.أيُّها العم

239
00:13:44,210 --> 00:13:45,750
.أيُّها العم، أنتَ شخصٌ طيب

240
00:13:46,710 --> 00:13:50,170
.أيُّها العم، يجب عليّ أن أعتذر

241
00:13:51,010 --> 00:13:54,920
.في الحقيقة، كلُّ مَن يمتلكني سوف يكون ذو حظٍ سيئ

242
00:13:55,930 --> 00:13:56,300
.أجل

243
00:13:57,350 --> 00:13:57,840
.أنا أعرف

244
00:14:00,640 --> 00:14:02,810
.أعتذر لعدم إخباري لك بشأن هذا

245
00:14:03,520 --> 00:14:03,890
...أنا

246
00:14:04,100 --> 00:14:04,890
.هذا لا يُهم

247
00:14:05,480 --> 00:14:09,270
.أيُّها العم، لا تكترث لأمري

248
00:14:09,440 --> 00:14:10,310
.اتركني

249
00:14:12,690 --> 00:14:13,360
...أيُّها العم

250
00:14:14,110 --> 00:14:14,980
.لن أفعل ذلك

251
00:14:25,040 --> 00:14:25,870
...إيتشي ني

252
00:14:31,420 --> 00:14:32,710
...يجب أن أخبره بذلك

253
00:14:34,510 --> 00:14:35,000
...مُستحيل أن يكون

254
00:14:35,340 --> 00:14:36,130
هذا مُستحيل

255
00:14:36,930 --> 00:14:40,300
حتى أنا لا يُمكنني الشعور بروحٍ ما من مكانٍ بعيد

256
00:14:41,180 --> 00:14:43,260
.ثمَ يتبعهُ من هذا المكان البعيد

257
00:14:51,690 --> 00:14:52,190
...هذا

258
00:14:52,730 --> 00:14:53,440
.لقد وجدته

259
00:14:54,820 --> 00:14:55,520
.ذلكَ الطريق

260
00:14:59,560 --> 00:15:01,530
الريكو، هي الخطوط الروحيّة

261
00:14:59,560 --> 00:15:01,530
أكانَ ذلكَ الـ"ريكو"؟

262
00:15:02,280 --> 00:15:03,530
...طاقة الروح البصرية

263
00:15:03,950 --> 00:15:05,870
الشينيجامي ذو المهارات العالية هم فقط من يستطيعون فعلِ ذلك

264
00:15:06,510 --> 00:15:10,250
!إنهُ يتطور بسرعةٍ في وقتٍ قصير كهذا؟

265
00:15:12,840 --> 00:15:14,210
هل فقدناه؟

266
00:15:14,500 --> 00:15:16,960
أيُّها العم، فلتَكفَّ عن هذا، ليس
...من الضروريّ أن تفعل هذا

267
00:15:17,300 --> 00:15:19,090
.لا تقلق، هذا لا شيء

268
00:15:20,550 --> 00:15:22,930
.فأنا جيدٌ في مثل هذهِ الأمور القاسية

269
00:15:32,020 --> 00:15:32,520
.لقد وجدنا

270
00:15:32,940 --> 00:15:33,400
!علينا أن نهرب

271
00:15:34,070 --> 00:15:34,690
...أيُّها العم

272
00:15:35,570 --> 00:15:37,020
.لا بأس، فأنا بخير

273
00:15:45,660 --> 00:15:46,080
.إنهُ هُناك

274
00:15:47,330 --> 00:15:47,870
.إنهُ شادو

275
00:15:52,000 --> 00:15:53,750
أيُّها الأبله، لماذا أنت تهرب ؟

276
00:15:54,300 --> 00:15:55,420
!ستكون في خطرٍ إن بقيتَ وحيدًا

277
00:15:55,670 --> 00:15:56,420
.إيتشي ني

278
00:15:58,670 --> 00:15:59,130
!كارين؟

279
00:15:59,840 --> 00:16:01,840
!ماذا بكِ؟ أنتِ بالكاد تستطيعين الوقوف

280
00:16:04,260 --> 00:16:04,720
!كارين

281
00:16:06,060 --> 00:16:06,430
!إيتشيغو

282
00:16:07,430 --> 00:16:09,640
.خُذها للبيت الآن

283
00:16:10,810 --> 00:16:12,180
.وأنا سأذهب لكي أنقذهُ

284
00:16:13,770 --> 00:16:14,850
ما الذي تتحدثين عنهُ؟

285
00:16:15,020 --> 00:16:16,110
...لن أدعكِ تفعلين ذلك

286
00:16:16,440 --> 00:16:17,520
.لا تُجادل

287
00:16:18,690 --> 00:16:25,200
،لن أدعكَ تُقاتل الهولو وأنتَ فاقدٌ تركيزك
.بسبب أنكَ تركتها هنا وذهبت

288
00:16:27,950 --> 00:16:29,240
.الآن بدأتَ تفهم

289
00:16:29,830 --> 00:16:30,240
.الآن

290
00:16:32,120 --> 00:16:32,750
!روكيا

291
00:16:34,560 --> 00:16:38,670
أنتِ لم تسترجعي قواكِ بعد لكي تتمكني من قتال الهولو ، أليسَ كذلك ؟

292
00:16:41,380 --> 00:16:42,970
.لذلك لا تتهوري كثيرًا

293
00:16:43,640 --> 00:16:44,260
.لا تكُن أحمقًا

294
00:16:45,430 --> 00:16:48,930
هل تعتقد بأنني سأفعل شيئًا طائشًا؟

295
00:16:52,060 --> 00:16:52,520
.إلى اللقاء

296
00:16:53,810 --> 00:16:54,190
.أجل

297
00:16:58,440 --> 00:16:59,520
هل أنتِ بخيرٍ يا كارين؟

298
00:16:59,820 --> 00:17:00,520
.تماسكي

299
00:17:00,860 --> 00:17:01,860
!هذا ليسَ من عادتكِ

300
00:17:02,700 --> 00:17:03,490
...إيتشي ني

301
00:17:04,200 --> 00:17:06,110
...لقد رأيتُها

302
00:17:06,780 --> 00:17:09,370
!ذكرياتُ تلكَ الروح التي بداخل ذلك الببغاء

303
00:17:10,200 --> 00:17:13,080
.أعتقد أنّ السبب كوني الأقرب لعمره

304
00:17:14,170 --> 00:17:20,240
...لقد دخلت جميع ذكريات ذلكَ الولد بداخلي بكلِ وضوحٍ

305
00:17:21,630 --> 00:17:23,940
.مُباشرةً من عيناه

306
00:17:24,720 --> 00:17:26,890
.ذلكَ الولد قد رأى أمهُ تُقتل أمامه

307
00:17:28,390 --> 00:17:30,300
...أرجوكَ يا إيتشي ني

308
00:17:32,060 --> 00:17:34,310
...أرجوك... ذلك الولد

309
00:17:36,190 --> 00:17:37,190
...ساعدهُ

310
00:17:38,270 --> 00:17:39,150
.أرجوك

311
00:17:43,610 --> 00:17:44,900
.اللعنة، لا يُمكنني اللّحاق به

312
00:17:45,700 --> 00:17:49,120
الجيجاي: هو الجسد المُّزيف

313
00:17:45,700 --> 00:17:49,120
لو لم أكُن بهذا الـ"جيجاي"لكنتُ قادرةً على اللحاق به بسهولة

314
00:17:49,790 --> 00:17:54,080
لماذا الجيجاي لهُ قدرةٌ مُماثلةٌ للإنسان العادي؟

315
00:17:54,620 --> 00:17:56,530
.اللعنة على أولئكَ الدجالين في قسم التطوير

316
00:17:57,340 --> 00:17:57,830
...هذا سيئ

317
00:17:58,210 --> 00:17:59,580
.أشعر بأنني أصبحتُ أثقل من ذي قبل

318
00:18:01,800 --> 00:18:03,960
.إنني أشتمُّ رائحةً جيدة

319
00:18:22,780 --> 00:18:25,480
.إنَ رائحتكِ لذيذة حقًا

320
00:18:26,450 --> 00:18:28,110
...دعيني أتذوق القليل

321
00:18:29,160 --> 00:18:30,360
.من روحكِ

322
00:18:34,290 --> 00:18:36,120
أنتِ لم تموتي من الضربة الأولى؟

323
00:18:36,750 --> 00:18:40,920
.ويبدو بأنكِ تستطيعين رؤيتي، أيضًا

324
00:18:41,550 --> 00:18:43,380
-مَن أنتِ ياتُرى

325
00:18:49,010 --> 00:18:49,630
...الحاكم العظيم

326
00:18:50,680 --> 00:18:54,310
...لتكُن قناعًا من الوميض وعظمًا ترِف...

327
00:18:55,140 --> 00:18:56,100
...الحقيقة والاعتدال...

328
00:18:56,440 --> 00:18:59,100
.عندما يقوم الشرُّ بإغضاب نور الخير، يُطلَق عنان الغضب

329
00:19:00,110 --> 00:19:01,270
طريق الدمار

330
00:19:01,500 --> 00:19:02,480
النار الزرقاء

331
00:19:06,030 --> 00:19:06,480
لقد فعلتُها

332
00:19:07,360 --> 00:19:09,320
جيد، استعدتُ بعض السلطات

333
00:19:15,540 --> 00:19:16,790
ما كانَ ذلكَ الصوت؟

334
00:19:17,670 --> 00:19:18,830
.يبدو بأنهُ هاجمها

335
00:19:19,670 --> 00:19:25,630
تلكَ الفتاة التي كانت تُطاردُنا ، إنها تُقاتل
.لوحدها ذاك الذي هاجمنا مُسبقًا

336
00:19:28,220 --> 00:19:28,710
...أنت

337
00:19:29,260 --> 00:19:29,840
.ابقى هُنا...

338
00:19:30,510 --> 00:19:31,220
ما الذي ستفعله؟

339
00:19:32,050 --> 00:19:32,760
.سوفَ أُساعدُها

340
00:19:33,590 --> 00:19:34,890
!لا يُمكنكَ فعلُ ذلك، أيُّها العم

341
00:19:35,060 --> 00:19:35,890
.هذا خطير

342
00:19:40,940 --> 00:19:42,100
!ليسَ هذا ما قصدتهُ

343
00:19:42,440 --> 00:19:48,190
فأنا لم أقصد بأنهُ لو تركتني في الطريق
.فسأُضرَب بسيارةٍ أو شيئًا من هذا القبيل

344
00:19:48,490 --> 00:19:49,820
.أهـ، لا تفعل ذلك أيُّها العم

345
00:19:50,280 --> 00:19:51,820
.لا يُمكنكَ رؤية الأشباح

346
00:19:51,990 --> 00:19:52,610
.لا تذهب

347
00:19:52,780 --> 00:19:54,280
!ذلكَ الشيء سيقتُلكَ

348
00:19:54,490 --> 00:19:55,160
!انتظر

349
00:19:55,330 --> 00:19:55,990
!أيُّها العم

350
00:19:56,660 --> 00:19:57,790
!!أيُّها العم

351
00:19:59,620 --> 00:20:00,080
...مُستحيل

352
00:20:00,460 --> 00:20:01,290
لمَ يتأذى؟

353
00:20:03,290 --> 00:20:04,920
!أعرفُ تلك التقنية

354
00:20:05,300 --> 00:20:06,630
.إنها تقنيةٌ تخصُّ الشينيجامي

355
00:20:06,960 --> 00:20:07,800
أليسَ كذلك؟

356
00:20:08,380 --> 00:20:10,590
.ولكنكِ ضعيفةٌ جدًا

357
00:20:11,090 --> 00:20:12,220
.إنهُ غير مؤذٍ إطلاقًا

358
00:20:14,100 --> 00:20:14,550
.اللعنة

359
00:20:14,930 --> 00:20:18,930
إذًا فأنا لم أسترجع قواي بعد لدرجة أنّني
.لم أستطع استخدام ذلك المُستوى من الكيدو

360
00:20:19,270 --> 00:20:20,350
.هكذا إذًا

361
00:20:20,600 --> 00:20:22,520
أنتِ من الشينيجامي؟

362
00:20:23,060 --> 00:20:26,110
.لا عجب في ذلكَ، فرائحتكِ لذيذةٌ جدًا

363
00:20:27,780 --> 00:20:29,190
شينيجامي إذًا؟

364
00:20:29,360 --> 00:20:30,690
.هذا يجعلُني سعيدًا

365
00:20:31,450 --> 00:20:38,790
في الحقيقة، لقد أكلتُ اثنان من الشينيجامي الذين
.أرادوا أن يُرسلوا ذلك الطفل إلى السماء

366
00:20:41,000 --> 00:20:43,250
.لقد كان مذاقهم لذيذًا جدًا

367
00:20:45,040 --> 00:20:48,340
عندما ذكرتَ الطفل، هل تقصد تلكَ الروح التي في داخل الببغاء؟

368
00:20:48,670 --> 00:20:49,840
.هذا صحيح

369
00:20:50,050 --> 00:20:53,590
.يبدو بأنكَ تستمرُّ في مُلاحقة تلكَ الروح

370
00:20:54,100 --> 00:20:54,510
لماذا؟

371
00:20:54,760 --> 00:20:56,090
...دعينا نرى الآن

372
00:20:56,350 --> 00:21:01,100
.إذا أحسنتِ التصرُّف وتركتيني ألتهمكِ؛ فسأخبركَ بذلك

373
00:21:01,270 --> 00:21:02,100
...أيُّها اللعين

374
00:21:11,610 --> 00:21:12,320
...أنتِ

375
00:21:14,990 --> 00:21:16,160
...أخبره بذلك

376
00:21:17,030 --> 00:21:19,410
.إذا ذهب للجانب الآخر، سوف يُمكنه رؤية أمه مُجددًا

377
00:21:19,750 --> 00:21:21,330
.أخبر الطفل بذلك

378
00:21:22,670 --> 00:21:25,620
.لا تدعهُ يكون لوحدهُ أكثر

379
00:21:26,590 --> 00:21:28,830
أرجوكَ يا إيتشي ني