1
00:01:42,720 --> 00:01:45,160
والآن الـروكيا الخاص بي

2
00:01:45,280 --> 00:01:48,250
يمتلك قوة الـريوجينكا الخاص بك

3
00:01:48,410 --> 00:01:50,570
وأيضًا يمتلك قوة
الـغيتسوغتنشو الخاصة

4
00:01:50,690 --> 00:01:53,250
بحاصد الأرواح البديل

5
00:01:54,770 --> 00:01:57,380
فرغم قوتك يا كبير القادة

6
00:01:58,020 --> 00:02:02,540
لن تتمكن أبدًا من التصدي
لجميع هذه القوى التي أمتلكها

7
00:02:10,190 --> 00:02:14,350
ها قد حان الوقت
لننه هذا الآن

8
00:02:20,960 --> 00:02:23,640
كلا -
كبير القادة -

9
00:02:31,450 --> 00:02:33,290
أيتها الفتاة

10
00:02:36,900 --> 00:02:39,300
ماذا؟ مستحيل

11
00:02:42,300 --> 00:02:45,860
نوزومي

12
00:02:46,140 --> 00:02:48,670
"الحلقة 334"

13
00:03:14,050 --> 00:03:16,450
هذا خطير
توقفي

14
00:03:22,340 --> 00:03:27,350
هذه الفتاة ماذا تفعل؟
هل حقًا تحاول حمايتي؟

15
00:03:32,630 --> 00:03:35,510
لا يمكنك امتصاص الكثير
من الطاقة

16
00:03:36,960 --> 00:03:38,840
ابتعدي نوزومي

17
00:03:45,160 --> 00:03:48,410
توقفي ستموتين

18
00:03:52,730 --> 00:03:55,130
ابتعدي من هنا

19
00:04:17,520 --> 00:04:19,280
نوزومي

20
00:04:29,010 --> 00:04:31,450
كبير القادة -
معلمي -

21
00:04:35,610 --> 00:04:38,180
فلتتمالك نفسك أيها القائد

22
00:04:42,900 --> 00:04:44,940
نوزومي

23
00:04:48,430 --> 00:04:49,950
تجاهلتني

24
00:04:51,150 --> 00:04:52,470
لماذا؟

25
00:04:53,150 --> 00:04:57,480
ماذا تقصدين؟ -
لماذا قمت بحمايتي؟ -

26
00:04:58,280 --> 00:05:01,480
لن تفهمي ما فعلته أيتها الغبية

27
00:05:02,000 --> 00:05:06,080
تحتاجين إلى آلاف السنين
قبل أن تحميني

28
00:05:06,200 --> 00:05:11,410
لعلك روح معدلة
ولكنك مجرد فتاة صغيرة

29
00:05:13,770 --> 00:05:18,500
كن صادقًا معها قليلًا
أيها العجوز

30
00:05:21,500 --> 00:05:22,900
كبير القادة

31
00:05:24,260 --> 00:05:26,500
أيها العجوز أنت بخير؟

32
00:05:26,750 --> 00:05:33,030
كبير القادة مستحيل
روكيا احذري

33
00:05:33,470 --> 00:05:34,710
أجل

34
00:05:46,810 --> 00:05:51,610
أين كاغيروزا؟ -
إشيغو إنه هناك -

35
00:06:13,510 --> 00:06:15,190
كاغيروزا

36
00:06:15,910 --> 00:06:18,040
لم يمت ذلك الوغد

37
00:06:19,000 --> 00:06:23,120
نوزومي أنت بخير؟
حمدًا لله

38
00:06:30,650 --> 00:06:36,250
لا جدوى من ذلك لا يمكنك
أن تقاتلي بالـزنباكوتو

39
00:06:50,390 --> 00:06:52,270
حاصد الأرواح البديل

40
00:06:55,470 --> 00:06:59,320
لماذا تحاول صدّي وإيقافي
عما ينبغي علي فعله؟

41
00:07:00,120 --> 00:07:05,120
نوزومي لا تريد الذهاب معك
يجب أن تفهم هذا هو السبب

42
00:07:06,560 --> 00:07:12,970
لا تريد ذلك؟! لماذا؟
هل أنت واثق من حقيقة مشاعرها؟

43
00:07:13,530 --> 00:07:14,530
ماذا تقول؟

44
00:07:15,290 --> 00:07:19,420
ما بك بحقك؟
بالطبع هي لا تريد الذهاب معك

45
00:07:21,140 --> 00:07:26,220
أنا الذي صنع نوزومي
بمعنى آخر أنا والدها

46
00:07:28,990 --> 00:07:31,990
والبحث الذي أجريه
على وشك الاكتمال

47
00:07:32,630 --> 00:07:34,110
الاكتمال؟

48
00:07:34,510 --> 00:07:37,640
أتعني السيطرة على
عالم الأحياء وعالم الأرواح؟

49
00:07:38,000 --> 00:07:42,240
ولكن لن نسمح لك بهذا -
هذا لن يجعل نوزومي سعيدة -

50
00:07:42,800 --> 00:07:44,560
أصحيح كلامه؟

51
00:07:45,640 --> 00:07:50,730
لكنه يسعدني لذلك
نوزومي ستكون سعيدة أيضًا

52
00:07:51,210 --> 00:07:55,810
توقف عن سرد التفاهات -
لكن نوزومي ليست مثلك -

53
00:08:02,220 --> 00:08:03,220
المعذرة

54
00:08:04,660 --> 00:08:06,260
ما المضحك في ذلك؟

55
00:08:06,580 --> 00:08:11,190
أنت حقًا تتكلم وكأنك تفهم
نوزومي وتعرف ماذا تريد

56
00:08:14,190 --> 00:08:19,280
ولسوء حظك لا أحد يفهم
نوزومي أكثر مني

57
00:08:19,400 --> 00:08:20,640
لذا توقف عن ذلك

58
00:08:30,170 --> 00:08:31,850
عمَ تتحدث؟

59
00:08:32,450 --> 00:08:34,090
إنه لأمر سهل

60
00:08:35,170 --> 00:08:37,140
ببساطة أنا ونوزومي

61
00:08:37,300 --> 00:08:39,180
قد صنعنا من ريشي
حاصد أرواح واحدًا

62
00:08:39,300 --> 00:08:41,140
هل فهمتم الآن؟

63
00:08:48,630 --> 00:08:52,510
ما الذي يقصده؟ -
كلامي معروف مقصده -

64
00:08:53,030 --> 00:08:58,640
نوزومي عما يتحدث؟
لم أفهم شيئًا من ذلك

65
00:09:02,880 --> 00:09:06,730
على الأقل قولي لنا شيئًا
هيا نوزومي

66
00:09:10,650 --> 00:09:13,210
ما بك؟ ردي علي

67
00:09:23,500 --> 00:09:26,500
يبدو أنك لم تنسين

68
00:09:27,710 --> 00:09:30,230
أنت، توقف عن الضحك

69
00:09:30,350 --> 00:09:37,760
رأيت؟ إن نوزومي تعرف دائمًا
أنه إذا قبض عليها سنصبح شخصًا واحدًا

70
00:09:38,640 --> 00:09:44,760
وستكون أيضًا عدوتكم
ولهذا تحاول أن تبقى بعيدةً عني

71
00:09:45,520 --> 00:09:51,890
وحاولت ذلك دائمًا
أليس كذلك يا نوزومي؟

72
00:09:52,490 --> 00:09:54,730
ولكن من المؤسف حقًا

73
00:09:54,850 --> 00:09:59,940
بدأت تشعرين بمشاعر تجاه
أولئك الذين يحاولون حمايتك

74
00:10:00,980 --> 00:10:04,380
قولي لي ما اسمك؟
ومن أين أنت؟

75
00:10:04,980 --> 00:10:09,710
لن أخبرك ابتعد عني
أيها المنحرف

76
00:10:11,150 --> 00:10:12,670
ليس من شأنك

77
00:10:13,350 --> 00:10:14,750
لا تقلقي نوزومي

78
00:10:16,350 --> 00:10:23,520
من الآن سوف نقوم بحمايتك -
لا يهم لن أجعله يضطر لمساعدتي -

79
00:10:25,240 --> 00:10:29,690
إن دخلت هنا وأغلقت البوابة
حينها لن يجدني أحد

80
00:10:30,010 --> 00:10:33,290
إشيغو قال إنه سيقوم
بحمايتك مع البقية

81
00:10:33,810 --> 00:10:36,450
هل هذا ما تريدينه حقًا يا نوزومي؟

82
00:10:36,780 --> 00:10:39,540
ستحظين بأشياء جميلة
إن استمررت بالعيش

83
00:10:39,940 --> 00:10:42,940
حقًا أنتم جميعًا متشابهون منحرفون

84
00:10:43,940 --> 00:10:45,980
لا تشبهيني بهذا بأي حال

85
00:10:46,990 --> 00:10:50,030
لا أعرف حقًا لما أريد حمايتك

86
00:10:50,790 --> 00:10:55,030
لكنني سمعت ذلك الصوت
يقول لي إنه يجب أن أحميك

87
00:10:59,320 --> 00:11:02,240
ولكن بأي حال أنت غبي

88
00:11:03,600 --> 00:11:08,250
أنا عبء عليكم
فالجميع يحاولون حمايتي

89
00:11:08,570 --> 00:11:11,410
لكنني لا أستطيع رد الجميل

90
00:11:12,490 --> 00:11:18,780
لكن حين فكرت في حمايتكم فجأةً
وجدت سيفي

91
00:11:25,260 --> 00:11:28,550
لهذا السبب لم تستطع
أن تقول لكم شيئًا

92
00:11:28,670 --> 00:11:32,590
تبًا توقف عن الكلام
وكأنك تعرف كل شيء

93
00:11:32,950 --> 00:11:35,950
لا تقل لـنوزومي
كيف يجب عليها أن تشعر

94
00:11:36,110 --> 00:11:41,520
الروح المعدلة يعني أن نوزومي
هي أنا، وأنا هو نوزومي

95
00:11:42,200 --> 00:11:45,240
يمكنكم الآن أن تسألوا
نوزومي بأنفسكم

96
00:11:45,680 --> 00:11:48,050
إن كان ما أقوله لكم صحيحًا

97
00:11:48,730 --> 00:11:50,290
نوزومي

98
00:12:08,980 --> 00:12:11,900
تبًا قلت لك توقف
عن الضحك

99
00:12:14,220 --> 00:12:15,220
إشيغو

100
00:12:15,340 --> 00:12:20,030
كاغيروزا
يبدو أنك لا تفهم شيئًا، حسنًا

101
00:12:21,390 --> 00:12:22,870
إشيغو

102
00:12:23,990 --> 00:12:25,830
أيها الغبي

103
00:12:26,120 --> 00:12:28,520
هل ستقاتلني في حالتك هذه؟

104
00:12:30,760 --> 00:12:32,400
حسنًا

105
00:12:34,480 --> 00:12:36,930
قتالك هذا لن يجدي نفعًا

106
00:12:38,090 --> 00:12:40,930
اللعنة

107
00:13:13,600 --> 00:13:19,810
نوزومي لنعد أدراجنا
حيث يجب أن نكون

108
00:13:20,690 --> 00:13:22,610
إلى حيث ننتمي

109
00:13:25,610 --> 00:13:27,060
هيا لنذهب

110
00:13:44,590 --> 00:13:47,920
لا أريد لن أذهب

111
00:13:48,840 --> 00:13:55,760
فهمت، لسوء الحظ في هذه الحالة
سآخذك بالقوة

112
00:13:56,770 --> 00:14:01,090
اللعنة أيها اللعين أيها الغبي
قف أنت اللعنة، خذ هذه يا غبي

113
00:14:01,210 --> 00:14:02,250
هيا

114
00:14:02,370 --> 00:14:06,100
لا أريد، لا

115
00:14:06,780 --> 00:14:08,700
أيها الغبي

116
00:14:13,420 --> 00:14:15,100
نوزومي -
ماذا؟ -

117
00:14:15,340 --> 00:14:17,670
الآن فرصتك اهربي

118
00:14:18,310 --> 00:14:23,470
ماذا؟
ابتعد من طريقي

119
00:14:26,000 --> 00:14:29,440
ماذا تنتظرين؟
اهربي هيا نوزومي

120
00:14:29,560 --> 00:14:32,160
تبًا لك

121
00:14:32,880 --> 00:14:38,290
وأنت روح معدلة
ولكنك روح فاسدة لم تضبَط بعد

122
00:14:49,940 --> 00:14:55,220
أيها الغبي سأمحيك من كلا العالمين
من تظن نفسك حتى توقفني هكذا؟

123
00:14:56,190 --> 00:14:58,270
غبيّ مثير للشفقة

124
00:15:03,110 --> 00:15:04,910
تينران

125
00:15:08,360 --> 00:15:09,360
كون

126
00:15:13,680 --> 00:15:15,930
نوزومي

127
00:15:26,100 --> 00:15:27,460
ماذا؟

128
00:15:30,780 --> 00:15:35,910
جينروساي يماموتو
آسف لا أمتلك الوقت الآن

129
00:15:36,990 --> 00:15:38,630
ارجع

130
00:16:16,350 --> 00:16:22,310
شكرًا لك، لقد أنقذت حياتي
أنت رائعة كنت مرعوبًا جدًا

131
00:16:25,070 --> 00:16:28,080
حتى الآن تتصرفي هكذا

132
00:16:29,120 --> 00:16:33,360
خلفك -
يا للحماقة -

133
00:16:56,310 --> 00:16:57,630
ما الأمر؟

134
00:16:57,790 --> 00:17:04,110
اهرب الآن اهرب بسرعة -
ما الذي تقولينه؟ سوف نذهب معًا -

135
00:17:05,470 --> 00:17:09,720
لا يمكنني الركض
ولكن أنت يمكنك

136
00:17:10,040 --> 00:17:15,640
لا تقولي هذا لن أذهب من دونك
هيا انهضي واركضي معي

137
00:17:18,130 --> 00:17:24,890
هيا بنا أسرعي تعالي معي
هيا يا إلهي! أنت ثقيلة

138
00:17:25,530 --> 00:17:26,820
كون

139
00:17:29,860 --> 00:17:33,380
أخبرتني يومًا أن أعيش

140
00:17:35,580 --> 00:17:38,630
والآن جاء دوري
لأقول لك ذلك

141
00:17:40,030 --> 00:17:41,190
عش

142
00:17:41,790 --> 00:17:48,400
حسنًا، ولكن ماذا عنك أنت؟
اسمعي سنذهب معًا

143
00:17:48,720 --> 00:17:55,120
أعدك سأكون بخير
لن أموت سأحيا

144
00:17:57,410 --> 00:18:02,050
ولكن لن نفعلها بهذه الطريقة
لن أتركك سوف أذهب معك

145
00:18:15,910 --> 00:18:20,350
يا لك من أحمق -
نوزومي -

146
00:18:24,590 --> 00:18:26,920
شيتوتسوسنسين

147
00:18:30,120 --> 00:18:31,120
لماذا؟

148
00:18:34,160 --> 00:18:37,810
نوزومي
لمَ تفعلين هذا؟

149
00:18:45,570 --> 00:18:47,260
...هذا

150
00:19:01,150 --> 00:19:07,120
ضغطي الروحي تماسك فقط
من أجل هجوم واحد

151
00:19:20,570 --> 00:19:23,330
نوزومي أنت لي

152
00:19:28,660 --> 00:19:30,620
نوزومي

153
00:19:30,820 --> 00:19:33,140
انحني نوزومي

154
00:19:37,310 --> 00:19:39,230
اختفى

155
00:19:42,310 --> 00:19:49,840
رجاء مرة واحدة فقط ساعدني
في الهجوم غيتسو تينشو

156
00:20:11,980 --> 00:20:13,260
أنت بخير؟

157
00:20:14,180 --> 00:20:15,580
إشيغو

158
00:20:19,350 --> 00:20:25,790
إنني بخير هيا نعد -
أجل إلى حيث ننتمي بالطبع هيا -

159
00:20:30,240 --> 00:20:32,960
مستحيل
كيف؟

160
00:20:34,080 --> 00:20:37,170
لقد قمت بتأمين نفسي يا فتاتي

161
00:20:38,130 --> 00:20:41,650
حينما انزلقت عندما
كنت على تلك الحافة

162
00:20:47,340 --> 00:20:49,700
الـروكيا الخاص بي

163
00:20:49,860 --> 00:20:53,500
قادر دائمًا على نسخ نفسي
في مثل هذه الحالات

164
00:20:53,820 --> 00:20:55,020
ماذا؟

165
00:20:55,380 --> 00:20:59,790
وبالنظر إلى ذلك يمكنك القول
إنك هزمت نسخة مني

166
00:21:03,710 --> 00:21:05,590
الوداع الآن

167
00:21:13,080 --> 00:21:14,600
إشيغو

168
00:21:21,370 --> 00:21:27,300
نوزومي لنعد إلى ذاك
المكان الذي ننتمي إليه

169
00:21:30,380 --> 00:21:33,220
نوزومي

170
00:21:36,190 --> 00:21:39,150
نوزومي

171
00:21:41,710 --> 00:21:45,710
نوزومي

172
00:21:58,130 --> 00:22:00,610
"يتبع"