!كُفْ عن هذا، توسين

34
00:02:07,650 --> 00:02:10,020
!أَلِهذه الدرجة قد انحدرت، توسين

35
00:02:31,730 --> 00:02:32,500
!هيساغي

36
00:02:37,340 --> 00:02:39,430
كَيف يُمكن أن يَكون بِهذه القوّة؟

37
00:02:50,720 --> 00:02:51,520
.بانكاي

38
00:02:53,200 --> 00:02:55,860
.كوكوجو تينغين ميو

39
00:03:05,010 --> 00:03:06,060
!توسين

40
00:03:06,900 --> 00:03:11,960
!سَأجعلك ترى الحقيقة مهما كلّفْ الأمر

41
00:03:30,100 --> 00:03:31,640
.يا لها من حماقة

42
00:03:32,830 --> 00:03:35,420
،لقد شهدت قوّتي

43
00:03:35,590 --> 00:03:38,860
وما زِلتَ تَعتقد أن بإمكانك هزمي بِمُجرّد بانكاي؟

44
00:03:40,990 --> 00:03:42,860
مُجرّد بانكاي؟

45
00:03:43,800 --> 00:03:46,740
.تبدو كَإيسبادا

46
00:03:47,160 --> 00:03:49,690
.لا تُقارنّي بالإيسبادا الضعفاء

47
00:03:49,940 --> 00:03:52,710
.تجاوزت حدود قوّتهم بالفعل

48
00:03:53,020 --> 00:03:56,000
.وبالطبع، قد تجاوزتكم أنتم الشينيغامي أيضًا

49
00:03:57,370 --> 00:04:00,210
أنَسيت أنَّكَ كُنت من الشينيغامي أيضًا؟

50
00:04:00,520 --> 00:04:01,900
شينيغامي؟

51
00:04:08,480 --> 00:04:10,180
...شينيغامي

52
00:04:13,800 --> 00:04:17,000
.هو شيء لم أُرد أن أكونه أبدًا

53
00:04:22,510 --> 00:04:23,600
...توسين

54
00:04:25,890 --> 00:04:27,170
متى كان ذلك؟

55
00:04:27,720 --> 00:04:31,380
متى أخترت هذا الطريق؟

56
00:04:38,050 --> 00:04:39,890
هل... هل أنتَ بِخَير؟

57
00:04:40,670 --> 00:04:43,990
.عُذرًا، لم أدرك أن هُناك شخص آخر موجود هُنا

58
00:04:44,300 --> 00:04:45,130
.هُنا

59
00:04:48,850 --> 00:04:50,700
.غَريب

60
00:04:50,700 --> 00:04:53,880
.أعني، آسف. لم أعرف أنَّكَ هُنا

61
00:04:58,500 --> 00:05:00,820
.توسين كانامي، سُعدت بلقائك

62
00:05:04,700 --> 00:05:07,280
.أنت جيّد في إخفاء وجودك حقًّا

63
00:05:09,640 --> 00:05:11,240
.كبيرٌ جدًّا أيضًا

64
00:05:14,010 --> 00:05:18,760
.لا أستطيع الرؤية، لكن بإمكاني الشعور بوجود الناس دومًا حتى الآن

65
00:05:19,040 --> 00:05:21,290
.عُذرًا، إنَّها عادة لدي

66
00:05:21,960 --> 00:05:24,880
كومامورا... هل هذا أنت؟

67
00:05:25,530 --> 00:05:29,220
أنضممت لِلغوتي الـ13 أيضًا؟

68
00:05:29,890 --> 00:05:32,220
إن كُنتَ ترغب بِذلك، لِمَ لا تَنضم لِفرقتي؟

69
00:05:32,850 --> 00:05:37,200
.لدَيَّ مسؤولٌ رائع... أنا متأكد مِن أنَّهُ سيُعجِبُك

70
00:05:40,310 --> 00:05:44,120
.أنتَ كومامورا إذن؟ سَمعت الكثير عنك مِن توسين

71
00:05:47,350 --> 00:05:52,840
.سُعدت بلقائك، أنا آيزن سوسكي، نائب قائد الفرقة الخامسة

72
00:05:56,810 --> 00:06:01,190
لِمَ قررت أن تَكون شينيغامي، كومامورا؟

73
00:06:01,490 --> 00:06:05,760
.لِأرد الدَين للشخص الذي أنقذني

74
00:06:07,140 --> 00:06:10,140
.تَرُدَّ دَين؟ هذه من خصالك

75
00:06:11,420 --> 00:06:14,220
ماذا عنك، توسين؟

76
00:06:14,730 --> 00:06:18,130
...أنا؟ حسنٌ، أنا

77
00:06:38,340 --> 00:06:39,960
!سَأبدأ إذن

78
00:06:56,000 --> 00:06:57,930
.سحبته أخيرًا إذن

79
00:06:59,010 --> 00:07:01,390
.أنت تُحب أن تَأخذ وقتك حقًّا

80
00:07:06,840 --> 00:07:08,120
خائف؟

81
00:07:10,020 --> 00:07:12,160
.أَدعي كما يحلو لك

82
00:07:12,160 --> 00:07:16,100
.قد تَكون قويًّا، لكن أُراهن على إنَّكَ قَلِق

83
00:07:16,890 --> 00:07:20,600
.قُلتها بِنفسك قبل مِئة عام

84
00:07:22,680 --> 00:07:26,970
...لم أفتح قلبي لك، ولم أُخبرك بِشَيء

85
00:07:26,970 --> 00:07:29,030
.لم أُحاول التفاعل معك على الإطلاق

86
00:07:30,120 --> 00:07:36,410
.لِذا أنت لا تَعرف شيئًا عن قُدرة الزانباكتو خاصَّتي على الإطلاق

87
00:07:37,430 --> 00:07:42,690
وتَظُنْ لِأنَّني لا أعرف قُدرته سَأكون عاجزًا أمامه؟

88
00:07:42,850 --> 00:07:45,150
...من يعلم، ولكن

89
00:07:45,310 --> 00:07:48,280
أعرف أن الزانباكتو خاصَّتك يَجعلك

90
00:07:48,270 --> 00:07:52,110
.تَتَحّكم بِالجهاز العصبي الخاص بالعدو في القتال

91
00:07:53,320 --> 00:07:55,550
وتَعتقد أن بإمكانك استخدام ذلك في قتالك ضِدّي؟

92
00:07:55,780 --> 00:07:57,990
.هذا لَيس ما أقول

93
00:07:59,490 --> 00:08:01,220
.سَأقول لك هذا فقط، آيزن

94
00:08:02,100 --> 00:08:06,000
إن كُنت تَعتقد أن الكيوكا سويغيتسو هو الزانباكتو الوحيد

95
00:08:06,250 --> 00:08:08,840
...الذي يُمكنه التَحكّم بالجهاز العصبي الخاص بالشخص بالكامل

96
00:08:08,860 --> 00:08:10,120
.فأنت مُخطأ

97
00:08:16,480 --> 00:08:17,660
...تاوريرو

98
00:08:21,980 --> 00:08:23,560
.ساكانادي

99
00:08:37,380 --> 00:08:38,710
هل هذا كُل شيء؟

100
00:08:41,020 --> 00:08:45,210
هل نَسيت أنَّني أعرف حدود قُوّة البانكاي خاصَّتك؟

101
00:09:24,850 --> 00:09:29,330
.أنا أعترف بِقوّته التَدميريّة الهائلة

102
00:09:30,540 --> 00:09:33,020
.لا جروح تُذكر

103
00:09:34,020 --> 00:09:36,220
هل أمتص الضربة بالزانباكتو خاصَّته؟

104
00:09:37,290 --> 00:09:41,640
ألم تَقُلْ لي بأنَّني لَنْ أستَطيع هزمك بِمُجرّد بانكاي؟

105
00:09:42,520 --> 00:09:44,100
ماذا بِشأن ذلك؟

106
00:09:44,640 --> 00:09:51,320
.مع ذلك، بالنسبة للقوّة، فـ تينغين ميو يَجعلك تبدو كَطفلٍ عاجز

107
00:09:53,630 --> 00:09:55,780
.كُفْ عن مُحاولة فِعل المُستَحيل

108
00:09:57,020 --> 00:09:59,150
طفلٌ عاجز؟

109
00:10:00,060 --> 00:10:04,460
.هذا الفخر الكَبير يَصدر فقط قبل السقوط

110
00:10:07,060 --> 00:10:08,290
.حسنٌ، كومامورا

111
00:10:09,670 --> 00:10:13,110
.اسمح لي بأن أُعيدك للأرض

112
00:10:16,010 --> 00:10:17,670
!أرتفعتْ سُرعته في لحظة

113
00:10:34,170 --> 00:10:35,800
!أنتَ تَنظُر في الجهة الخطأ

114
00:10:42,320 --> 00:10:42,950
!ميو

115
00:10:58,460 --> 00:11:02,980
.كُل تَحَرُّكاته تَعكس تَحرُّكاتك

116
00:11:03,890 --> 00:11:09,140
.إذا جُرِحَ العملاق سَتُجرح أنت أيضًا

117
00:11:10,100 --> 00:11:12,770
بانكاي مُزعج، أليس كذلك، كومامورا؟

118
00:11:13,930 --> 00:11:17,560
،بالنسبةِ لِشخصٍ رأى البانكاي خاصَّتك مرّات لا تُحصى

119
00:11:17,560 --> 00:11:20,700
.العثور على نقاط ضعفه سهل للغاية

120
00:11:22,900 --> 00:11:25,440
،بِفضل هذه القوّة التَدميريّة الهائلة

121
00:11:25,870 --> 00:11:28,360
،لم يَخطُر لك بأنَّكَ لَنْ تَهزم عدو بِضربة واحدة

122
00:11:28,950 --> 00:11:33,420
.أو أن تَكون عرضةً لِهجومٍ مُضاد

123
00:11:34,650 --> 00:11:39,870
،حتى لو لم أُصبْ أعضائك الحيويّة المُميتة، طالما أستمر في جرح العملاق

124
00:11:45,370 --> 00:11:48,100
.هذا الكلام يَنطبق علَيكَ أيضًا

125
00:11:49,050 --> 00:11:50,320
أنا؟

126
00:11:55,090 --> 00:11:58,230
.لا تُقارن بَيننا

127
00:12:05,310 --> 00:12:07,060
...تَجددٌ سَريع

128
00:12:15,400 --> 00:12:21,380
.لقد تَركت الشينيغامي حقًّا إذن، توسين

129
00:12:22,040 --> 00:12:27,430
.كلماتك مشوبه بِمرارة الهزيمة، كومامورا

130
00:12:30,420 --> 00:12:32,180
...دعوتني بالمُنحط

131
00:12:32,800 --> 00:12:38,450
أنحططت مِن النَعمة لِأنَّني حصلت على قوّة بِخداعي لِأصدقائي وأتباعي

132
00:12:39,630 --> 00:12:41,140
.دعني أسألك هذا إذن

133
00:12:42,190 --> 00:12:45,160
...إن أنضم شخص لِمُنظّمة سعيًا للانتقام

134
00:12:45,200 --> 00:12:51,050
...وعندها غفل عن هدفه وعاش بِسلام أثناء أتباعه لتلك المنظّمة

135
00:12:51,050 --> 00:12:52,570
ألَنْ تَعتبره مُنحط أيضًا؟

136
00:12:55,060 --> 00:12:57,050
...حتى بِعَينَيّ اللتَين لا تُبصران

137
00:12:57,050 --> 00:13:00,550
.أرى هذا هو الإنحطاط الحقيقي من النعمة

138
00:13:02,010 --> 00:13:06,890
...توسين... أتعنى أنَّكَ أصبحت شينيغامي من أجل

139
00:13:09,650 --> 00:13:11,150
.الانتقام

140
00:13:21,890 --> 00:13:24,490
.أُحب سماء الليل، كانامي

141
00:13:25,380 --> 00:13:28,580
.أعتقد أنَّها تَعكس الحياة الحقيقيّة

142
00:13:29,290 --> 00:13:34,000
...كُل شيء مُغلّف بالظلام، وهُناك أضواء صغيرة عديدة

143
00:13:35,330 --> 00:13:39,080
.لكن، هُناك غيومٌ تُحاول أن تَمنع الضوء من الإشراق

144
00:13:40,090 --> 00:13:44,670
.أوتَعلم، كانامي... أريد أن أكون شخصًا يُطارد الغيوم

145
00:13:45,610 --> 00:13:48,340
...سَأتخلّص من الغيوم

146
00:13:49,140 --> 00:13:52,210
.كَي لا يَغرُب أيِ جُزءٍ من الضوء

147
00:13:58,290 --> 00:14:00,480
!سَأتزوّج، كانامي

148
00:14:01,170 --> 00:14:07,100
.أنَّهُ شينيغامي، حَصلت على رسالة قبولي في الأكاديميّة ليلة البارحة أيضًا

149
00:14:07,710 --> 00:14:09,200
!سَأكون شينيغامي

150
00:14:09,820 --> 00:14:14,410
.سَأكون شينيغامي وأُقاتل الهولو. وأجلُبَ السلام لِلعالم

151
00:14:15,390 --> 00:14:18,350
.أَردتُ أن تَكون أوّل مَن يَعلم

152
00:14:19,880 --> 00:14:21,150
.مُبارك

153
00:14:21,510 --> 00:14:25,420
هل هُناك طَريقة تُمكنني مِن مُساعدتكِ فيها؟

154
00:14:26,050 --> 00:14:30,550
.شُكرًا لك، لكن، سَأكون سَعيدة إن بَقيت كما أنت

155
00:14:30,930 --> 00:14:34,890
.وأُحب أن تَستَمع لِقصَصي بَين الحين والآخر عندما أعود

156
00:14:36,140 --> 00:14:42,810
.أخبرتني بأنَّهُ وعد، وضَحِكَت

157
00:14:43,900 --> 00:14:47,900
.وبعدها... لم تَعُدْ مُطلقًا

158
00:14:58,950 --> 00:15:01,460
.قُتِلَتْ مِن قِبَل زوجها نفسه

159
00:15:02,510 --> 00:15:05,340
...قَتل شخصًا في مُشاجرة مُثيرة للشفقة

160
00:15:06,230 --> 00:15:08,860
.ولامها على الأمر، وقتلها كذلك

161
00:15:10,630 --> 00:15:16,100
،المرأة التي أرادت سلام العالم أكثر من أيِ شخص، التي آمنت بالعدالة أكثر من أيِ شخص

162
00:15:16,390 --> 00:15:19,270
...من أختار أن يُقاتل من أجل هذه المبادئ

163
00:15:20,070 --> 00:15:22,560
.لم يَحصل على فرصة للقتال على الإطلاق

164
00:15:28,690 --> 00:15:30,680
إلى ماذا افتَقَدتْ؟

165
00:15:31,570 --> 00:15:36,110
ألم يَكُنْ كافيًا أنَّها آمنت بالعدالة وتمنّت سلام العالم؟

166
00:15:37,330 --> 00:15:39,830
.إن كان الأمر كذلك، فَأُريد القوّة

167
00:15:40,440 --> 00:15:42,750
.أُريد القوّة لِأُحل السلام

168
00:15:43,930 --> 00:15:49,210
.إن كان ما يَنقُص هو العدالة، سَأكون العدالة نفسها

169
00:15:50,260 --> 00:15:56,500
.وأتخلّص مِن شرور هذا العالم حتى لو كانت غيومًا

170
00:15:57,480 --> 00:16:00,470
...بِكُل عدلي

171
00:16:13,240 --> 00:16:15,640
الانتقام؟

172
00:16:16,080 --> 00:16:17,250
.أجل

173
00:16:18,260 --> 00:16:21,190
.تبدو مُتفاجئًا، كومامورا

174
00:16:22,390 --> 00:16:27,250
أصبحت تَعتمد على بصر عَينَيك

175
00:16:28,190 --> 00:16:29,850
.كسولٌ لِترى الحَقيقة

176
00:16:29,840 --> 00:16:33,220
!عيناك عاجزة عن إدراك ظل الحقيقة التي أراها واضحة

177
00:16:37,610 --> 00:16:38,050
!بطيئ

178
00:16:57,520 --> 00:16:59,300
ما الخطب، كومامورا؟

179
00:17:00,580 --> 00:17:03,000
لا تَقُلْ لي أنَّكَ خسرت القوّة للقتال؟

180
00:17:23,180 --> 00:17:24,830
.دَعني أسألك هذا إذن

181
00:17:25,920 --> 00:17:30,330
ألم تَتَسائل عن الأمر مُطلقًا؟

182
00:17:33,630 --> 00:17:36,570
الرجل الذي خسر أقرب أصدقائه

183
00:17:36,910 --> 00:17:39,530
يَنضم للمُنظّمة التي قتلته؟

184
00:17:40,410 --> 00:17:43,330
لِمَ لم تَتَسائل عن الأمر مُطلقًا؟

185
00:17:44,770 --> 00:17:48,040
.أعتقدتُ بأنَّ ذلك نابع من حس العدالة

186
00:17:49,000 --> 00:17:54,550
.آمنتُ بأنَّ ذلك كان تنفيذًا لرغبة العدالة التي عجز صديقك الراحل عن تحقيقها

187
00:17:54,920 --> 00:17:58,010
!بالضبط، هدفي هو العدالة

188
00:18:01,090 --> 00:18:03,890
إذن... ماذا تَعني "العدالة" هذه؟

189
00:18:06,050 --> 00:18:08,980
هل تَعني أن أُسامح قاتل صَديقي العَزيز؟

190
00:18:09,270 --> 00:18:11,360
"بالتأكيد هذا "طاهر

191
00:18:11,360 --> 00:18:15,070
.بالفعل، جميل. الأمر جميل كَكلمات

192
00:18:15,650 --> 00:18:19,280
لكن حتى إذا كان الأمر طاهرًا، أهذه هيَ العدالة؟

193
00:18:19,280 --> 00:18:26,160
!خطأ، عيش حياة مُسالمة دون الانتقام لِصَديق راحل... هو الشر

194
00:18:38,190 --> 00:18:39,430
.فهمت

195
00:18:42,510 --> 00:18:48,120
.يبدو أنَّني أخطأت فهم مشاعرك بالكامل

196
00:18:48,750 --> 00:18:54,520
.أهكذا تَشعُر حقًّا، مبادئنا لا تتوافق على الإطلاق منذ البداية

197
00:18:54,740 --> 00:18:58,080
ولِأنَّنا لا نَتشارك المَبادئ، سَتقوم بِقَتلي؟

198
00:18:58,080 --> 00:19:00,990
.هل هذه هي العدالة أيضًا؟ شَيءٌ مُضحك

199
00:19:01,420 --> 00:19:03,500
.أجل، إنَّها العدالة

200
00:19:03,790 --> 00:19:08,310
إن كانت مبادئنا مُختلفة مِن الأساس، فأقناعك سَيَكون دون معنى

201
00:19:08,580 --> 00:19:12,960
.يَجب أن أَهزِمك من أجل مُجتمع الأرواح

202
00:19:13,750 --> 00:19:15,170
...لَيس لِأنَني أُريد ذلك

203
00:19:16,250 --> 00:19:19,760
.سعيدٌ لسماع مشاعرك الحقيقيّة

204
00:19:20,940 --> 00:19:26,390
.لقد سامحتك بالفعل مِن أعماق قلبي

205
00:19:30,770 --> 00:19:34,860
سامحتني بالفعل؟

206
00:19:36,240 --> 00:19:39,530
!كُفْ عن غرورك هذا، كومامورا

207
00:19:40,350 --> 00:19:43,200
متى طَلبتُ السماح؟

208
00:19:43,200 --> 00:19:44,930
.إن كُنتَ تُريد القتال، فقاتل فقط

209
00:19:44,930 --> 00:19:50,500
.إن كُنت ما زِلت تَستَطيع الكلام بعد رؤيَة أطلاقَتي

210
00:19:53,830 --> 00:19:55,960
.سوزوموشي هياكوشيكي

211
00:19:58,840 --> 00:20:00,590
.غريجال غريجو

212
00:20:54,340 --> 00:20:55,470
...يُمكنني أن أرى

213
00:20:57,810 --> 00:20:59,120
.يُمكنني أن أرى

214
00:21:01,400 --> 00:21:03,950
!يُمكنني أن أرى، كومامورا

215
00:21:07,820 --> 00:21:10,870
!يُمكنني أن أرى، يُمكنني أن أرى، يُمكنني أن أرى كُل شيء

216
00:21:11,540 --> 00:21:13,080
!هذه هيَ السماء إذن

217
00:21:14,250 --> 00:21:15,540
!هذه هيَ الدماء إذن

218
00:21:16,750 --> 00:21:19,040
!هذا هو العالم إذن

219
00:21:19,790 --> 00:21:20,840
...وأيضًا

220
00:21:22,670 --> 00:21:24,840
.هذا هو أنت إذن

221
00:21:26,040 --> 00:21:27,380
...كومامورا

222
00:21:31,490 --> 00:21:35,690
.أنت أبشع مِمّا تصوّرت

223
00:23:37,640 --> 00:23:39,770
.اليوم سَنَتحدّث عن توسين كانامي

224
00:23:40,750 --> 00:23:43,520
.أطلاقة سَيف كانامي هي غريجال غريجو

225
00:23:44,270 --> 00:23:48,650
.لكن يبدو بأنَّه لا يُريد أن يَأتي إلى هُنا وهو بِهذا المظهر

226
00:23:48,650 --> 00:23:49,740
!إنَّهُ هنا

227
00:23:49,740 --> 00:23:52,200
.لا يَجدُر بك أن تَحكُمَ على الكتاب من غلافه

228
00:23:54,480 --> 00:23:57,230
.يا له من صوت مُريح

229
00:23:57,240 --> 00:24:01,500
.بالمُناسبة، إن قُمت بإصدار هذا الصوت، الحلفاء الذين يَصدرون مِثل هذا الصوت سَيَظهرون