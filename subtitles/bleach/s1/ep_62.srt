1
00:01:54,860 --> 00:01:58,220
.مر وقتٌ طويل مُنذ آخر مرّة رَأَيتُ فيها وجهك

2
00:01:58,960 --> 00:02:02,920
لِمَ هذا التَغيير، كومامورا؟

3
00:02:03,270 --> 00:02:07,730
!كَيف يُمكنك الإبتسام هكذا، آيزن؟

4
00:02:08,270 --> 00:02:11,100
!خُنتَنا جَميعًا

5
00:02:11,510 --> 00:02:13,410
!لَنْ أُسامحك

6
00:02:13,740 --> 00:02:15,000
...وأنتَ كذلك

7
00:02:15,740 --> 00:02:16,940
!توسين

8
00:02:35,930 --> 00:02:37,230
...عُذرًا

9
00:02:38,030 --> 00:02:39,900
...لم أعتقد أنَّ هُناك أحد هُنا

10
00:02:40,440 --> 00:02:41,200
.هنا

11
00:02:46,310 --> 00:02:47,330
...غَريب

12
00:02:47,510 --> 00:02:48,770
...عُذرًا، أعني

13
00:02:49,510 --> 00:02:50,980
.لم أعتقد أنَّكَ كُنتَ هُنا

14
00:02:52,680 --> 00:02:55,120
.أنا توسين كانامي. سُعدت بِلقائك

15
00:02:57,390 --> 00:02:59,910
.أنت جيّد في إخفاء وجودك حقًّا

16
00:03:00,760 --> 00:03:04,920
...لا يُمكنني الرؤية، لكن لَيستْ هُناك مرّة لم أستَطع فيها الشعور بِوجود شخص

17
00:03:06,400 --> 00:03:07,290
كومامورا؟

18
00:03:08,060 --> 00:03:11,590
!أنتَ كومامورا، صَحيح؟ مر وقتٌ طويل

19
00:03:12,470 --> 00:03:15,630
.فهمت. أنضممتَ لِفرق الحماية الثلاثة عشر أيضًا

20
00:03:16,570 --> 00:03:19,010
هل تُريد الإنضمام لِفرقتي؟

21
00:03:19,840 --> 00:03:21,370
!لي قائدٌ رائع

22
00:03:21,840 --> 00:03:23,400
.أنا مُتأكد مِن أنَّه سَيُعجِبُك أيضًا

23
00:03:24,410 --> 00:03:25,940
أنت كومامورا، صَحيح؟

24
00:03:26,280 --> 00:03:28,010
.سَمِعتُ عنَكَ مِن توسين

25
00:03:30,420 --> 00:03:33,250
سُعدت بلقائك. أنا نائب قائد الفرقة الخامسة

26
00:03:33,860 --> 00:03:35,150
.آيزن سوسكي

27
00:03:36,760 --> 00:03:39,350
لِمَ أصبحت شينيغامي؟

28
00:03:40,600 --> 00:03:44,620
.لِأرُدَ الدَين لِرجل مُعيّن قام بِإنقاذي

29
00:03:45,300 --> 00:03:47,860
.دَين عِرفان؟ هذه هيَ طريقتك

30
00:03:49,170 --> 00:03:50,730
ماذا عنك، توسين؟

31
00:03:51,110 --> 00:03:53,630
...أنا؟ حسنٌ

32
00:04:12,090 --> 00:04:12,990
!توسين

33
00:04:13,260 --> 00:04:15,750
!فسّر ما تفعل في الحال

34
00:04:17,430 --> 00:04:19,230
أم لا تَستَطيع ذلك؟

35
00:04:20,400 --> 00:04:22,030
!كم هذا مؤسف، توسين

36
00:04:24,610 --> 00:04:25,570
!بانكاي

37
00:04:30,550 --> 00:04:31,410
...مُستَحيل

38
00:04:32,250 --> 00:04:34,880
...ما زال آيزن واقف بِجانب توسين

39
00:04:37,090 --> 00:04:38,380
.هادو نو كيوجو

40
00:04:39,660 --> 00:04:40,620
.كوروهيتسوغي

41
00:04:54,370 --> 00:04:55,840
...كِلاهما مِن القادة

42
00:04:57,510 --> 00:05:00,630
.مع ذلك، هذا الفرق في القوّة

43
00:05:01,940 --> 00:05:04,780
.تَنويم كيوكا سويغيتسو المغناطيسي خال من العيوب

44
00:05:05,550 --> 00:05:08,980
.لا يُمكنك الهرب منه حتى لو عرفت بأمره

45
00:05:09,920 --> 00:05:13,850
.هادو نو كيوجو دون تَرنيمة، كَم هذا مُخيف

46
00:05:14,190 --> 00:05:17,350
متى تَعلّم كَيف يَفعل هذا؟

47
00:05:17,890 --> 00:05:19,520
...لا، كان فشلاً

48
00:05:20,430 --> 00:05:23,360
.لم أَتَمكّنْ مِن الوصول إلى ثُلث قوّته

49
00:05:24,100 --> 00:05:26,800
.كيدو الـ90 مِن الصعب التَحكُّم به

50
00:05:28,200 --> 00:05:28,830
...الآن

51
00:05:30,610 --> 00:05:34,060
عُذرًا، لم انتهي مِن الشرح، أليس كذلك؟

52
00:05:35,440 --> 00:05:36,240
!كوروساكي

53
00:05:37,880 --> 00:05:39,580
!لا تَقتربوا

54
00:05:48,890 --> 00:05:49,790
!كوتشيكي-سان

55
00:05:50,390 --> 00:05:53,690
.لا يَجب أن تَقتربي

56
00:05:58,770 --> 00:06:00,060
!إينوي! إيشيدا

57
00:06:01,700 --> 00:06:03,670
!يا لها من رياتسو

58
00:06:06,880 --> 00:06:08,070
...كوتشيكي روكيا

59
00:06:09,380 --> 00:06:11,710
،عندما عَلِمت أنَّكِ في عالم الأحياء

60
00:06:11,750 --> 00:06:13,720
...أول ما قُمتُ به

61
00:06:14,650 --> 00:06:16,910
.هو القضاء على الأعضاء الـ46

62
00:06:19,960 --> 00:06:20,720
ماذا؟

63
00:06:21,760 --> 00:06:25,590
إيساني-كن أخبرتكم بالفعل

64
00:06:26,860 --> 00:06:30,660
".آيزن سوسكي زيّف موته وأخفى مكان تواجده"

65
00:06:30,700 --> 00:06:34,600
".بعد ذلك، قام بِقتل الـ46"

66
00:06:35,340 --> 00:06:36,860
.لكن ذلك لَيس صَحيح

67
00:06:38,240 --> 00:06:42,200
فور عِلمي بِكِ، قُمت بِقتل الـ46

68
00:06:42,240 --> 00:06:43,840
.واستَخدمت الكيوكا سويغيتسو

69
00:06:43,880 --> 00:06:45,710
.على كامل قاعة التَجمّع المركزية

70
00:06:46,480 --> 00:06:51,220
.لِكَي تَبدو كما لو كان الـ46 مازالوا أحياء ويَجتَمَّعون

71
00:06:52,650 --> 00:06:57,110
.كان أحدنا دائمًا موجود في قاعة التَجمّع السُفليّة

72
00:06:58,360 --> 00:07:02,300
مُنذ ذلك الحين، كُنّا نَتَصرّف كَأعضاء الـ46

73
00:07:02,430 --> 00:07:04,560
.وكُنّا نُرسل جَميع الأوامر

74
00:07:06,070 --> 00:07:08,260
،لِنَتأكد من اعتقالكِ

75
00:07:08,300 --> 00:07:11,000
.جَعلتُ الاثنَين من الفرقة السادسة يَذهبون إلَيكِ

76
00:07:11,940 --> 00:07:14,100
...مِن أجل عزلكِ عن البشر

77
00:07:14,140 --> 00:07:17,110
.أمرت بِعودتكِ سريعًا وتَدمير الغيغاي خاصَّتُك

78
00:07:18,250 --> 00:07:20,510
لِتَتَبخّر روحكِ بالكامل

79
00:07:20,920 --> 00:07:23,440
،ولِآخذ الهوغيوكو مِن داخلك

80
00:07:24,150 --> 00:07:27,350
.قرّرتُ أن أعدمكِ باستخدام السوكيوكو

81
00:07:28,520 --> 00:07:31,320
...الوقت الوحيد الذي لَم نَكُنْ فيه في قاعة التَجمّع السُفليّة

82
00:07:31,360 --> 00:07:34,820
.كان الساعات القليلة خِلال اجتماعات القادة

83
00:07:37,530 --> 00:07:41,400
.زَيَّفتُ موتي بعد ذلك وعُدت لِلأسفل

84
00:07:42,770 --> 00:07:44,530
لِأنَّني عَلِمت أنَّ هُناك إحتمالية

85
00:07:44,570 --> 00:07:47,770
.أنَّ الإعدام قد يَفشل بِسَبَبِكُم

86
00:07:51,310 --> 00:07:52,970
هُناك طَريقتان فقط

87
00:07:53,020 --> 00:07:56,180
.لِنَزع الشَيء الغَريب المزروع في الروح

88
00:07:58,020 --> 00:08:01,820
باستخدام مُكثّف حراري مِثل السوكيوكو

89
00:08:01,860 --> 00:08:05,090
...والذي سَيُبخّر الروح التي سَيُغطّيها

90
00:08:07,700 --> 00:08:11,560
أو بِطَريقة أُخرى تَدخُل بِترابط الروح

91
00:08:11,600 --> 00:08:13,530
...وَتفصلهما بالقوّة

92
00:08:15,500 --> 00:08:18,770
،الأعدام بالسوكيوكو قد فَشِل

93
00:08:19,140 --> 00:08:21,870
.كان يَجب أن أعثر على تِلك الطريقة الأخرى

94
00:08:22,950 --> 00:08:25,180
من أجل ذلك، أحتجت المعلومات

95
00:08:25,210 --> 00:08:29,620
.الموجودة في أرشيف قاعة الاجتماعات السُفليّة

96
00:08:31,290 --> 00:08:35,550
.بَحث عبر أبحاث أوراهارا كيسكي الماضية

97
00:08:36,690 --> 00:08:38,890
كان هو من طوّر التقنيّة

98
00:08:38,930 --> 00:08:40,790
.لِزرع الغرض الغَريب داخل الروح

99
00:08:44,070 --> 00:08:48,400
لِذا عرفت... أن التقنيّة اللازمة لِنزعه

100
00:08:48,440 --> 00:08:51,030
.يَجب أن تَكون مَخفيّة في أبحاثه

101
00:08:51,610 --> 00:08:52,270
.أجل

102
00:08:54,080 --> 00:08:56,700
.هذه هي... الإجابة

103
00:08:56,750 --> 00:08:57,340
!مهلاً

104
00:09:15,700 --> 00:09:16,860
.أنا مُتفاجئ

105
00:09:17,730 --> 00:09:19,700
.إنَّه صَغير

106
00:09:21,040 --> 00:09:22,260
...هذا هو الهوغيوكو

107
00:09:25,140 --> 00:09:25,830
.فهمت

108
00:09:28,340 --> 00:09:30,280
.الروح سليمة

109
00:09:31,380 --> 00:09:32,850
.يا لها مِن تقنيّة رائعة

110
00:09:34,620 --> 00:09:35,670
.لكن، مؤسف

111
00:09:36,990 --> 00:09:39,780
...لا حاجة لي بكِ بعد الآن

112
00:09:41,090 --> 00:09:42,180
.اقتُلها، غين

113
00:09:45,630 --> 00:09:47,190
.حسنٌ

114
00:09:49,260 --> 00:09:51,490
!اقتُلهم، شينسو

115
00:10:05,050 --> 00:10:06,950
!ني-ساما

116
00:10:12,390 --> 00:10:13,510
!ني-ساما

117
00:10:15,160 --> 00:10:16,950
ني-ساما... لماذا؟

118
00:10:18,230 --> 00:10:19,890
!لِمَ أنقَذتَني؟

119
00:10:28,740 --> 00:10:30,140
!لِنَنطلق، جيدانبو

120
00:10:30,470 --> 00:10:31,340
!حسنٌ

121
00:10:32,510 --> 00:10:34,530
عظام الوحوش تَناثري بشكلٍ واسع وبَعيد

122
00:10:34,580 --> 00:10:37,270
!قُبّة مِن الكريستال القُرمُزي! عجلة من الحَديد

123
00:10:37,780 --> 00:10:40,040
!الرياح تَتَحرّك! والسماء تَرتاح

124
00:10:40,580 --> 00:10:42,810
!صوت السهام الطائرة، تَغمر القلعة الفارغة

125
00:10:43,450 --> 00:10:46,580
!هادو نو روكوجو سان، رايكوهو

126
00:10:50,830 --> 00:10:52,320
!أوني-سان -
!جيدانبو-سان -

127
00:10:57,730 --> 00:11:01,100
.هذا وجهٌ آخر لم أره مُنذ وقت طويل

128
00:11:01,440 --> 00:11:02,370
!لا تَتَحرّك

129
00:11:02,570 --> 00:11:04,560
...إن تَحرّكت

130
00:11:04,940 --> 00:11:06,600
!سَنَقطع رأسك

131
00:11:08,210 --> 00:11:09,180
.فهمت

132
00:11:13,080 --> 00:11:14,010
!كوكاكو

133
00:11:14,480 --> 00:11:18,010
...يورويتشي! كان لديَّ الكثير من وقت الفراغ

134
00:11:18,050 --> 00:11:20,820
!وبِما أنَّني كُنت أَتَمشّى، قررت المَجيئ وتفقد الأمور هنا

135
00:11:29,340 --> 00:11:30,600
.كان ذلك برّاقًا حقًّا

136
00:11:30,980 --> 00:11:31,900
ماذا عليَّ أن أفعل؟

137
00:11:34,410 --> 00:11:35,210
.لا تَتَحرّك

138
00:11:39,020 --> 00:11:42,390
.عُذرًا، أيُّها القائد آيزن، لقد قُبِضَ عليَّ

139
00:11:44,590 --> 00:11:45,680
.انتهى الأمر

140
00:11:46,960 --> 00:11:47,950
ماذا قُلتِ؟

141
00:11:48,230 --> 00:11:49,860
ألا تَفهم، آيزن؟

142
00:11:50,400 --> 00:11:52,090
...لم يَبقَ مكان

143
00:11:53,270 --> 00:11:55,430
.لك

144
00:12:00,740 --> 00:12:01,500
...آيزن

145
00:12:02,340 --> 00:12:03,500
!قائد آيزن

146
00:12:08,850 --> 00:12:10,540
!انتهى الأمر، آيزن

147
00:12:15,890 --> 00:12:17,220
ما المُضحك؟

148
00:12:17,890 --> 00:12:20,220
.عُذرًا، حان الوقت

149
00:12:21,590 --> 00:12:22,650
!ابتَعدي عنه، سوي فون

150
00:12:34,940 --> 00:12:36,530
!مُستَحيل

151
00:12:42,580 --> 00:12:43,810
!مينوس غراند

152
00:12:48,290 --> 00:12:50,980
!الغيليان! كم عَدَدَهُم هُناك؟

153
00:12:51,160 --> 00:12:51,950
...لا، مهلا

154
00:12:52,260 --> 00:12:53,890
!هُناك شيء آخر

155
00:13:02,840 --> 00:13:05,000
...الأمر مؤسف قليلاً

156
00:13:05,940 --> 00:13:09,670
...لم أُمانع أن أكون سَجينك لِوقتٍ أطول

157
00:13:10,780 --> 00:13:12,640
.وداعًا، رانغيكو

158
00:13:13,910 --> 00:13:15,010
.أنا آسف

159
00:13:21,790 --> 00:13:23,150
...سَتهربون؟ أنتم

160
00:13:23,420 --> 00:13:24,320
!توقف

161
00:13:25,360 --> 00:13:26,290
!القائد العام

162
00:13:27,260 --> 00:13:30,390
"هذا الضوء يُدعى بِـ"نيغاشيون

163
00:13:30,630 --> 00:13:34,230
.يَستَخدمه المينوس لِإنقاذ رفاقهم الهولو

164
00:13:35,100 --> 00:13:37,590
،ما أن يُحيط بِك هذا الضوء

165
00:13:37,640 --> 00:13:41,070
.من المُستَحيل تَدخُّل مَن هُم داخله أو خارجه

166
00:13:41,110 --> 00:13:43,170
.عالمٌ مَعزول

167
00:13:43,740 --> 00:13:47,700
...كُل من قاتلوا المينوس يَعرفون هذا

168
00:13:48,820 --> 00:13:51,220
اللحظة التي وقع الضوء على آيزن سوسكي

169
00:13:51,250 --> 00:13:55,150
.أصبح الوصول إلَيه مُستَحيل

170
00:13:57,320 --> 00:13:58,290
!توسين

171
00:13:59,260 --> 00:14:00,950
!عُد هُنا، توسين

172
00:14:01,900 --> 00:14:02,790
!أنا لا أفهم

173
00:14:03,100 --> 00:14:05,220
!لِمَ أصبحت شينيغامي؟

174
00:14:06,030 --> 00:14:07,900
!ألم يَكُنْ من أجلِ صَديقك الراحل؟

175
00:14:08,330 --> 00:14:10,630
!ألم يَكن من أجل تَطبيق عدالتك؟

176
00:14:11,240 --> 00:14:14,330
!أَين ذهب حِسّك بالعدالة؟

177
00:14:14,840 --> 00:14:16,240
.قُلت لك، كومامورا

178
00:14:16,880 --> 00:14:21,070
.الشَيء الوحيد الذي يُمكن أن أراه هو أقل الطُرق أراقةً للدماء

179
00:14:21,810 --> 00:14:23,750
.العداله هُناك دائمًا

180
00:14:24,350 --> 00:14:27,440
!الطريق الذي أتبعه هو العداله

181
00:14:29,390 --> 00:14:30,290
!توسين

182
00:14:37,200 --> 00:14:39,500
...انضممت لِلمينوس

183
00:14:42,500 --> 00:14:43,730
لماذا؟

184
00:14:43,940 --> 00:14:45,400
.لِأصل لِما هو أعلى

185
00:14:46,370 --> 00:14:48,840
!هل سقطت لِلحَضيض لِهذا القدر، آيزن؟

186
00:14:49,910 --> 00:14:52,140
.أنت ساذج جدًّا، أوكيتاكي

187
00:14:53,210 --> 00:14:55,680
.لم يَقف أحد في الأعلى مِن الأصل

188
00:14:56,580 --> 00:14:59,280
.لا أنت، أو أنا، أو الآلهة

189
00:15:00,720 --> 00:15:04,850
.لكن المكان الخالي في عرش السماء سَيَنتهي الآن

190
00:15:08,090 --> 00:15:09,080
...من الآن فصاعدًا

191
00:15:12,530 --> 00:15:14,230
.سَأقف فوق السماوات

192
00:15:16,040 --> 00:15:18,470
.وداعًا، أيُّها الشينيغامي

193
00:15:24,680 --> 00:15:27,670
.ووداعًا، فتى الريوكا

194
00:15:29,450 --> 00:15:33,080
.بالنسبةِ لِبَشَري، كُنت مُمتعًا

195
00:15:40,130 --> 00:15:42,120
!الفرقة الثانية والثالثة عالجوا كوتشيكي

196
00:15:42,360 --> 00:15:44,560
المجموعات سبعة وعشرة وأحد عشرة وثلاثة عشر

197
00:15:44,600 --> 00:15:46,900
!عالجوا القائد كومامورا

198
00:15:47,430 --> 00:15:50,270
.نال النائب آباراي عناية مِن المستوى السادس

199
00:15:50,740 --> 00:15:52,570
!المجموعتان ثمانية وتسعة تَجهزوا للنقل

200
00:15:52,940 --> 00:15:53,770
!لِنَنطلق

201
00:15:54,710 --> 00:15:57,640
!جَميعهم جرحى! لِنُشرع بالعمل

202
00:15:58,780 --> 00:16:01,410
!ني-ساما

203
00:16:01,450 --> 00:16:03,210
!تراجعي من فضلك. يَتِمْ علاجه الآن

204
00:16:05,320 --> 00:16:06,650
.أنا بِخَير

205
00:16:06,890 --> 00:16:08,440
...اهتموا بالبقيّة

206
00:16:09,090 --> 00:16:11,080
!أرجوك، أيُّها القائد كومامورا

207
00:16:11,660 --> 00:16:13,560
...جيّد. بِبُطئ

208
00:16:13,760 --> 00:16:15,990
.عُذرًا... الضابط الثالث يومورا

209
00:16:16,200 --> 00:16:17,560
ماذا يَجب أن نَفعل؟

210
00:16:17,730 --> 00:16:20,320
.ساعدوا في علاج الريوكا

211
00:16:20,570 --> 00:16:22,860
...لكن

212
00:16:23,340 --> 00:16:25,630
.لابُد أنَّكم قد أدركتم الآن

213
00:16:26,810 --> 00:16:29,870
!لقد أنقذوا مُجتمع الأرواح، تحرّكوا الآن

214
00:16:29,940 --> 00:16:31,200
حاضر

215
00:16:32,880 --> 00:16:34,180
...لكن

216
00:16:34,510 --> 00:16:35,910
...فتاة الريوكا تِلك

217
00:16:37,420 --> 00:16:39,320
!ما هيَ قُدرتها؟

218
00:16:42,590 --> 00:16:43,580
!عملٌ جيّد

219
00:16:45,390 --> 00:16:46,620
!أيَّتُها القائد أونوهانا

220
00:16:47,330 --> 00:16:50,260
ما حالة القائد هيتسوغايا والنائب هيناموري؟

221
00:16:50,900 --> 00:16:53,230
.هربا من الموت

222
00:16:53,870 --> 00:16:55,930
.يَعود الأمر لهما الآن

223
00:16:56,770 --> 00:16:59,640
.تَستَمر إيساني في علاجهما

224
00:17:00,610 --> 00:17:01,900
من بقي؟

225
00:17:02,080 --> 00:17:04,870
!القائد كوتشيكي وفتى الريوكا

226
00:17:07,410 --> 00:17:11,140
.لا يَبدو أنَّ الريوكا يَحتاجون مُساعدتنا

227
00:17:11,320 --> 00:17:13,310
حقًّا؟

228
00:17:15,520 --> 00:17:18,820
.كُنتَ متهورًا... أيُّها القائد كوتشيكي

229
00:17:24,600 --> 00:17:25,790
...كوتشيكي روكيا

230
00:17:26,530 --> 00:17:27,400
.تعالي هُنا

231
00:17:27,830 --> 00:17:29,270
.القائد كوتشيكي يَطلُبك

232
00:17:31,270 --> 00:17:34,210
روكيا... هل أنتِ هُنا؟

233
00:17:37,710 --> 00:17:39,770
...أجل، ني-ساما

234
00:17:40,550 --> 00:17:43,950
.هُناك شَيء أُريد أن أقوله لك

235
00:17:44,950 --> 00:17:47,780
.قصّة قَديمة... مُنذ خمسون عام

236
00:17:50,020 --> 00:17:53,460
...في ذلك العام، قبل أن يُزهر أول برعم لِشجرة الخوخ

237
00:17:55,230 --> 00:17:57,420
.خسرت زوجتي

238
00:17:58,060 --> 00:18:00,230
.أعرف. هيسانا-ساما

239
00:18:00,900 --> 00:18:03,770
.قيل لي أنَّني أُشبه زَوجَتك

240
00:18:03,800 --> 00:18:06,070
.لِهذا أُعجِبتَ بي

241
00:18:06,110 --> 00:18:09,600
.ورَحبت بي كأُختك الصغرى في عالة كوتشيكي

242
00:18:10,410 --> 00:18:11,210
.صَحيح

243
00:18:12,080 --> 00:18:17,640
.أمرت الجَميع في المنزل أن يُخبرك بِهذه الكِذبة

244
00:18:21,320 --> 00:18:23,950
.هيسانا... هيَ أُختكِ الكُبرى

245
00:18:26,190 --> 00:18:28,350
ماتت هيسانا في عالم الأحياء

246
00:18:28,390 --> 00:18:31,300
،وأُرسِلت معك

247
00:18:32,970 --> 00:18:36,060
...لكن الحياة كانت صعبة هُناك

248
00:18:37,500 --> 00:18:42,870
.قالت أنَّها تركت أُختها الصغرى وهربت

249
00:18:44,380 --> 00:18:46,280
.نَدِمت هيسانا على ذلك كثيرًا

250
00:18:47,180 --> 00:18:49,380
،حتى بعد أن أصبحت زوجتي

251
00:18:49,980 --> 00:18:53,040
.كان تَبحث عنكِ كُل يوم تقريبًا

252
00:18:57,090 --> 00:18:59,320
...وفي ربيع عامنا الخمسين معًا

253
00:19:00,230 --> 00:19:04,390
...بياكيا-ساما... اُعثر على أُختي الصغرى أرجوك

254
00:19:05,400 --> 00:19:07,560
،وإن عثرت علَيها

255
00:19:07,600 --> 00:19:10,760
...لا تَقُل لها أنَّني أُختها الكُبرى

256
00:19:10,970 --> 00:19:13,370
...وفّري قوّتَكِ، لا تَتَحدّثي بعد الآن

257
00:19:13,440 --> 00:19:16,000
.لا... لا تَدعها تعرف أرجوك

258
00:19:16,040 --> 00:19:20,270
...احمِ أُختي الصغرى بِقوّتك

259
00:19:22,220 --> 00:19:24,880
...تركت أُختي الصغرى

260
00:19:25,590 --> 00:19:26,570
...هيسانا

261
00:19:28,020 --> 00:19:30,680
.لا يَحق لي أن أُدعى بِأُختها الكُبرى

262
00:19:31,690 --> 00:19:38,220
.لكن اسمح لها بِأن تُناديك "أخي" أرجوك

263
00:19:40,200 --> 00:19:43,570
.أزهر بُرعم خوح... انظُر

264
00:19:44,300 --> 00:19:47,830
...آسفة لِاعتمادي علَيك حتى النهاية

265
00:19:48,940 --> 00:19:53,400
...آسفة لِعَدم قُدرَتي على رَد الحُب الذي أعطَيتَهُ لي

266
00:19:54,550 --> 00:19:57,210
الأعوام الخمسون الماضية التي كُنّا فيها مع بعض

267
00:19:57,250 --> 00:19:59,480
...كانت مِثل الحُلُم الرائع

268
00:20:01,550 --> 00:20:02,680
...بياكيا-ساما

269
00:20:10,530 --> 00:20:13,160
.عثرتُ علَيكِ في العام التالي

270
00:20:14,570 --> 00:20:17,730
.ورحبت بكِ في العائلة

271
00:20:20,970 --> 00:20:22,700
.كان الأمر مُماثل مع هيسانا

272
00:20:23,680 --> 00:20:26,700
أعضاء العائلة رفضوا، بِقولهم أنَّ السماح لِشخصٍ

273
00:20:26,750 --> 00:20:29,870
من منطقة روكون بأن يَكون أحد أعضاء منزل نَبيل كان ضِد قوانينهم

274
00:20:29,920 --> 00:20:32,480
...وسَيُلطّخ اسم عائلة كوتشيكي

275
00:20:33,490 --> 00:20:36,110
.لكنّي تَحدَّيت الجَميع

276
00:20:37,020 --> 00:20:41,590
...أردت أن أُوفي بِوعدي لِهيسانا مهما كان الثمن

277
00:20:43,260 --> 00:20:46,530
...لكن، لقد واجهت قوانين العائلة

278
00:20:47,330 --> 00:20:50,230
،لِذا أقسمت أمام قبر والِدَيَّ

279
00:20:50,900 --> 00:20:52,960
.من أجل لوم نفسي

280
00:20:53,840 --> 00:20:56,870
،أقسمت بألّا أكسر القانون أبدًا

281
00:20:57,140 --> 00:21:02,640
.من الآن فصاعدًا، مهما كان الثمن، سَأتمسّك بالقانون

282
00:21:04,180 --> 00:21:07,480
،كُنت يائسًا لِتَحقيق أُمنيّة هيسانا

283
00:21:08,320 --> 00:21:12,190
...أقسمت قَسَمَين ما كان يَجدُر بي قسمُهما

284
00:21:13,260 --> 00:21:18,320
...عندما حُكِمَ علَيكِ بالموت، لم أعرف ماذا أفعل

285
00:21:19,530 --> 00:21:22,400
،قسمي لِوالِدَّيَ بِحماية القانون

286
00:21:22,700 --> 00:21:25,760
...وقسمي لِهيسانا في حماية أُختها الصغرى

287
00:21:25,910 --> 00:21:28,200
..لم أعرف أيِ القَسَمَين يَجب أن أُنفّذ

288
00:21:35,050 --> 00:21:40,540
من سَيُنفّذ قوانينَنا لو لَم نتَمسّك بِهُا؟

289
00:21:42,090 --> 00:21:49,550
.لو كُنت مكانك، لَكُنت قاتلت القانون

290
00:21:55,200 --> 00:21:56,790
.كوروساكي إيتشيغو

291
00:21:58,270 --> 00:21:59,460
.شُكرًا لك

292
00:22:02,940 --> 00:22:03,740
...روكيا

293
00:22:11,950 --> 00:22:12,940
...أنا آسف