كان

5
00:00:19,830 --> 00:00:20,750
!ساي؟

6
00:00:21,790 --> 00:00:23,320
ما الذي يجري هنا؟

7
00:00:27,490 --> 00:00:29,160
كيف حدثَ هذا؟

8
00:00:38,430 --> 00:00:40,770
استدعَتْ كان مفتوحة وطرحَتِ القرميدَ الذي سحبَتْه؟

9
00:00:43,150 --> 00:00:46,930
لم تفعل ذلك لتربح أو لتعزّز يدها؟

10
00:00:46,930 --> 00:00:51,020
ربّما أرادَتْ إذاً تعزيز عدد الدورا؟

11
00:00:53,950 --> 00:00:55,490
...كان دورا

12
00:00:57,390 --> 00:01:01,360
لا، هدفها ليسَ الدورا

13
00:01:01,360 --> 00:01:05,660
مياناغا ساكي من كيوسومي نادراً ما تُضيف مزيداً
من الدورا إلى يدِها عبرَ الـ كان

14
00:01:06,210 --> 00:01:09,710
في الواقع، لديّ اثنتان من الدورا
التي كوّنَتْها بتِلك الـ كان

15
00:01:10,430 --> 00:01:13,460
غايتها إذاً هي على الأرجح تغيير ترتيب السّحب

16
00:01:14,470 --> 00:01:16,700
إن ذهبَ سحبُ كيوسومي إلى إيسي

17
00:01:16,700 --> 00:01:19,150
وذهبَ سحبُ إيسي إلى مياموري

18
00:01:19,150 --> 00:01:21,930
سيتوقُّفُ تخلُّص إيسي ومياموري من مجموعة واحدة

19
00:01:21,930 --> 00:01:23,800
وبالتالي ستتعرقلُ حركة أيديهما مؤقّتاً

20
00:01:26,370 --> 00:01:29,440
لن يتغيّر شيء بالنسبة لي ولكيوسومي
لهذا سنحظى بالأفضلية

21
00:01:29,440 --> 00:01:31,650
ألستِ خائفة منّي إذاً؟

22
00:01:32,230 --> 00:01:34,150
أنتِ تستهينين بي حقّاً

23
00:01:50,850 --> 00:01:52,750
انظري إلى ذلك يا كيوسومي

24
00:01:53,120 --> 00:01:56,010
هذا ما تنالينه لاستهانتك بي

25
00:01:58,800 --> 00:02:00,300
!تعالي إليّ

26
00:02:14,990 --> 00:02:15,990
سأتجاهلُ ذلك

27
00:02:16,440 --> 00:02:20,450
لو ربحتُ بهذه لحققتُ 7.700

28
00:02:21,350 --> 00:02:24,560
هل كان يجدرُ بي أن أعلن رييتشي
أملاً بدورا عكسيّة وإيبّاتسو؟

29
00:02:25,360 --> 00:02:29,500
لا أريد من مياموري أن تطاردني مجدداً

30
00:02:41,210 --> 00:02:42,140
!فعلتُها

31
00:02:42,830 --> 00:02:43,720
تسومو

32
00:02:43,720 --> 00:02:45,080
‏4.000/8.000

33
00:02:49,990 --> 00:02:52,110
لم تربح كيوسومي؟

34
00:02:55,320 --> 00:02:59,820
أريدُ أن أقول "ليتني أعلنتُ عن رييتشي
"لكن سيصيبُني إحراجٌ كبير

35
00:03:01,390 --> 00:03:03,780
بـ ريانبيكو، إنها تسومو بايمان

36
00:03:03,780 --> 00:03:05,240
تفوّقَتْ عليها

37
00:03:06,370 --> 00:03:10,280
لهذا لا يجدرُ بكِ أن تستبعديني
فقط لافتقاري لقوى خارقة

38
00:03:10,280 --> 00:03:11,920
سأدافع عن المركزِ الثاني بكلّ كياني الآن

39
00:03:12,870 --> 00:03:15,420
كنتُ في المركز الثّاني حتّى اليد الشرقية الثالثة

40
00:03:15,420 --> 00:03:18,670
على هذا المنوال، سنُقصَى إن لم أحقّق
بايمان أو تسومو هانيمان

41
00:03:23,000 --> 00:03:25,850
سينتهي مهرجانُ الجميع

42
00:03:32,730 --> 00:03:38,190
كنتُ أعلمُ أنني لا أستطيع تغيير الإله
...حالما ينزلُ إليّ، لكن

43
00:03:39,510 --> 00:03:45,040
حتّى الرغبة بيدٍ رخيصة وسريعة فيها شيء
من المُبالغة الآن على ما أظن

44
00:03:45,040 --> 00:03:49,000
ليتَني أكونُ معها أو تكون هارو معها الآن

45
00:03:49,000 --> 00:03:50,320
مع الأسف

46
00:03:50,320 --> 00:03:51,480
ستسيرُ الأمورُ على ما يُرام

47
00:03:52,530 --> 00:03:54,710
لنؤمن بكاسومي-تشان

48
00:03:58,630 --> 00:04:00,970
لن أستسلم بعد

49
00:04:05,050 --> 00:04:07,980
أريدُ متابعة اللّعب مع الجميع أطول فترة مُمكنة

50
00:04:08,390 --> 00:04:11,770
لهذا لا أريدُ أن أخسر

51
00:04:14,230 --> 00:04:16,310
آي-تشان؟

52
00:04:16,650 --> 00:04:17,740
...للتو

53
00:04:17,740 --> 00:04:18,880
...تويوني

54
00:04:18,880 --> 00:04:21,340
تعطي الأولوية للسرعة

55
00:04:21,340 --> 00:04:23,340
...هذا خطيرٌ في النصف الثاني

56
00:04:23,340 --> 00:04:25,340
إنها تعي ذلك أيضاً

57
00:04:25,700 --> 00:04:30,240
على أي حال، لعلَّها تكون قد راهنَتْ بكلّ شيء
...على هذا النصف الأوَّل من المباراة

58
00:04:32,400 --> 00:04:35,040
لمتابعة هذا المهرجان

59
00:04:38,510 --> 00:04:42,200
قد نكون في الثاني، لكن إيسي متأخِّرة بـ100 نقطة فقط

60
00:04:42,200 --> 00:04:46,020
إن ربِحَتْ إيسي بيد واحدة
أو إن أصبحتُ مطية لتشكيل يدِ إحداهن

61
00:04:46,020 --> 00:04:47,970
سيتمُّ إقصاؤنا

62
00:04:48,390 --> 00:04:51,970
عليّ الانتباه من إيسي والتقدُّم بحذر

63
00:05:49,650 --> 00:05:50,640
...الآن

64
00:05:54,290 --> 00:05:55,920
كانَ لديها قرميد خيزران إضافي

65
00:05:56,870 --> 00:05:58,060
!افعلها قبلَ فوات الأوان

66
00:06:00,480 --> 00:06:02,880
عليّ إنهاء هذا الأمر خلال النصف الأوّل

67
00:06:07,260 --> 00:06:08,300
قرميد دائري واحد؟

68
00:06:09,480 --> 00:06:12,200
تحتاجُ مياموري إلى إصابة بايمان مُباشَرة
أو تسومو هانيمان

69
00:06:12,200 --> 00:06:14,000
بما أنّها تخلّصَتْ من مجموعة واحدة أيضاً

70
00:06:14,000 --> 00:06:16,880
فقد تكون يدها مُؤلَّفة من قراميد دائرية
فقط مع بعض من الدورا

71
00:06:17,640 --> 00:06:19,400
لا أستطيع طرح أي قراميد تشريفيّة

72
00:06:20,510 --> 00:06:21,270
،إذاً

73
00:06:22,890 --> 00:06:23,840
...هذا

74
00:06:24,280 --> 00:06:25,150
بون

75
00:06:26,150 --> 00:06:27,280
بون؟

76
00:06:27,280 --> 00:06:28,820
ليس كان؟

77
00:06:31,660 --> 00:06:33,220
!كيوسومي تتحرَّك؟

78
00:06:33,660 --> 00:06:37,120
ستفوزُ إن لم تُصبِح مطية لتشكيلِ يد لاعبة أخرى

79
00:06:38,050 --> 00:06:40,040
!ما الذي تفكِّرُ به بالضبط؟

80
00:06:49,370 --> 00:06:52,300
احتجتُ لسَحب، وها هو ذا

81
00:07:07,330 --> 00:07:08,030
كان

82
00:07:20,690 --> 00:07:21,420
تسومو

83
00:07:22,510 --> 00:07:24,160
‏400/800

84
00:07:33,380 --> 00:07:35,840
وبهذا تنتهي اللّعبة الثالثة من مباراة الجولة الثانية

85
