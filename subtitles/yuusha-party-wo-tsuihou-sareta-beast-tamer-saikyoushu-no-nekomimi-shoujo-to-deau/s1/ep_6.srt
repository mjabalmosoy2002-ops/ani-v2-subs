1
00:00:03,010 --> 00:00:05,440
هذه هي غابة الضّياع إذاً؟

2
00:00:07,880 --> 00:00:08,860
...هذا بعض الشيء

3
00:00:09,230 --> 00:00:11,570
كئيب، أليس كذلك؟

4
00:00:11,570 --> 00:00:14,620
بالفعل. إنّها مُظلمة حتّى في منتصف النّهار

5
00:00:15,160 --> 00:00:18,480
ما رأيكما بحرق المكان بأكمله؟

6
00:00:18,480 --> 00:00:19,990
!تعلمين أنّنا لا نستطيع فعل ذلك

7
00:00:20,280 --> 00:00:23,560
!هذه الغابة هي نِظام بيئي مأهول تماماً

8
00:00:23,560 --> 00:00:25,080
لم أكن جادّة

9
00:00:25,400 --> 00:00:28,350
إنّه في عمق هذه الغابة إذاً؟

10
00:00:28,350 --> 00:00:29,050
أجل

11
00:00:29,050 --> 00:00:33,050
...ترس الحقيقة والّذي لا يستطيع سوى البطل حمله

12
00:02:09,400 --> 00:02:13,650
يُقال بأنّ غابة الضّياع في حالة نموّ دائم وسريع

13
00:02:14,330 --> 00:02:18,870
سأراهن بأنّ الخريطة الّتي رسمَها
فريق آريوس عديمة القيمة الآن

14
00:02:19,710 --> 00:02:22,070
لكن علينا إيجاد الأداة الّتي بداخلها قطعاً؟

15
00:02:22,430 --> 00:02:23,820
علينا ذلك قطعاً

16
00:02:23,820 --> 00:02:25,790
فهذا هو عملنا الحالي

17
00:02:26,870 --> 00:02:27,960
...نـ

18
00:02:28,300 --> 00:02:30,000
نحن آسفون

19
00:02:30,000 --> 00:02:32,810
أتعتبرون هذا اعتذاراً؟

20
00:02:32,810 --> 00:02:34,130
!لا تبدون آسفين بالنسبة لي

21
00:02:34,130 --> 00:02:36,220
أرى أنّكم من الأفضل أن تحاولوا
!أن تبدوا أكثر صدقاً

22
00:02:36,220 --> 00:02:38,140
!نـ-نحن آسفون

23
00:02:38,140 --> 00:02:39,820
!ما زلتُ لا أسمعكم

24
00:02:39,820 --> 00:02:42,090
!نحن آسفون

25
00:02:42,090 --> 00:02:43,790
هل ينبغي أن نسامحهم؟

26
00:02:43,790 --> 00:02:44,520
أجل

27
00:02:44,520 --> 00:02:46,300
لقد تجاوزتُ الأمر نفسيّاً

28
00:02:46,300 --> 00:02:48,540
يمكننا وضع هذا خلفنا

29
00:02:48,540 --> 00:02:49,440
موافق؟

30
00:02:51,030 --> 00:02:52,760
حسناً

31
00:02:52,760 --> 00:02:54,970
أقبل بطلبك

32
00:02:54,970 --> 00:02:56,950
والآن لندخل صلب الموضوع

33
00:02:57,450 --> 00:03:00,120
يبدو أنّ ترس الحقيقة بحوزة الوحوش

34
00:03:00,120 --> 00:03:02,600
الّتي تقطن في أعماق غابة الضّياع

35
00:03:02,600 --> 00:03:05,120
إنّه أساسيّ لهزيمة ملك الشّياطين

36
00:03:05,450 --> 00:03:08,380
يجب أن نحصل عليه في أسرع وقت

37
00:03:08,380 --> 00:03:10,710
بالنسبة لي أنا، البطل

38
00:03:11,180 --> 00:03:13,580
مصير العالم على المحكّ

39
00:03:13,580 --> 00:03:16,190
لا أفهم كيف أمكنكم الرّفض

40
00:03:16,190 --> 00:03:17,880
هل يحاول أن يأمرنا؟

41
00:03:17,880 --> 00:03:19,980
!أنا واثقة بأنّه ليس آسفاً فعلاً

42
00:03:20,670 --> 00:03:22,550
اهدآ

43
00:03:23,390 --> 00:03:25,580
لنقبل بالعمل

44
00:03:29,690 --> 00:03:31,990
...قلتُ بأنّنا سنقبل بالعمل، لكن

45
00:03:32,720 --> 00:03:36,380
هل ستساعد ذلك البطل فعلاً؟

46
00:03:36,380 --> 00:03:38,720
!لا يروقني هذا البتّة

47
00:03:38,720 --> 00:03:40,150
!أتّفق تماماً

48
00:03:40,520 --> 00:03:45,120
!لستُ بحاجة لمساعدة أولئك الحمقى
!بمقدوري هزيمة ملك الشّياطين بمُفردي

49
00:03:45,680 --> 00:03:48,290
!لا أقول هذا لأنّني قلقة عليك يا رين

50
00:03:48,290 --> 00:03:50,750
رين، هل أنت متأكّد من قبولك بهذا؟

51
00:03:57,290 --> 00:03:59,950
!لماذا بدأت بفرك رأسينا فجأة؟

52
00:03:59,950 --> 00:04:01,930
!آ-آسف، كنتُ شارداً

53
00:04:01,930 --> 00:04:03,880
...لـ-لا مشكلة

54
00:04:03,880 --> 00:04:08,140
سُعِدتُ برؤيتكما تغضبان لأجلي

55
00:04:09,190 --> 00:04:10,300
...رين

56
00:04:10,300 --> 00:04:12,650
لكن أعتقد نحن بحاجة آريوس

57
00:04:12,650 --> 00:04:15,100
إنّه الشّخص الوحيد القادر على
هزيمة ملك الشّياطين

58
00:04:16,690 --> 00:04:19,340
لكن آسف لإقحامكما في هذا الخِلاف

59
00:04:19,340 --> 00:04:21,370
لا مشكلة بعد أن قطعتُ كلّ هذا الشّوط معك

60
00:04:21,370 --> 00:04:27,370
أنت لطيف زيادة عن اللّزوم، لذا
من واجبي أن أعتني بك

61
00:04:27,370 --> 00:04:28,680
!أجل، أجل

62
00:04:28,680 --> 00:04:31,080
!يسرّني تصرّفك بكلّ صدق وأمانة

63
00:04:31,500 --> 00:04:33,790
شكراً يا كانادي وتانيا

64
00:04:35,840 --> 00:04:38,920
!في هذه الحالة، لندخل ونخرج

65
00:04:38,920 --> 00:04:41,020
يجب علينا رسم استراتيجيّة أوّلاً

66
00:04:41,020 --> 00:04:42,890
لا يمكننا استخدام الخريطة، صحيح؟

67
00:04:44,100 --> 00:04:47,680
...حبّذا ألّا نتعثّر في الطريق أيضاً

68
00:04:47,680 --> 00:04:49,720
لنغيّر نهجنا

69
00:04:55,940 --> 00:04:59,040
سأندمج مع طائر كما السّابق

70
00:04:59,040 --> 00:05:01,950
يمكنني فهم معالِم الغابة من الأعلى

71
00:05:01,950 --> 00:05:04,990
احميا جسدي وراقبا مُحيطنا

72
00:05:04,990 --> 00:05:06,030
!حاضرة

73
00:05:07,990 --> 00:05:10,320
!حاضرة، عُد بسرعة

74
00:05:10,700 --> 00:05:12,840
!بالتوفيق

75
00:05:12,840 --> 00:05:13,660
!شكراً

76
00:05:17,580 --> 00:05:20,150
...إنّها غابة ضخمة حقّاً

77
00:05:20,800 --> 00:05:24,760
لكن رغم أنّه مخفيّ، يمكنني تحديد طريق

78
00:05:25,100 --> 00:05:27,990
ينبغي أن أتمكّن من إيجاد طريق
إلى أعمق نقطة فيها

79
00:05:35,760 --> 00:05:36,670
!عُدت

80
00:05:36,670 --> 00:05:38,230
!أهلاً بعودتك يا رين

81
00:05:38,540 --> 00:05:40,490
ماذا؟ هل وجدت طريقاً؟

82
00:05:40,940 --> 00:05:42,150
!أجل، سار الأمر بصورة مثاليّة

83
00:05:42,150 --> 00:05:43,930
!مرحى

84
00:05:43,930 --> 00:05:46,010
!إذاً لننطلق

85
00:05:46,010 --> 00:05:47,310
!انتظري

86
00:05:47,310 --> 00:05:48,950
!لا تعرفين الطريق يا كانادي

87
00:05:49,310 --> 00:05:51,190
!هذا صحيح

88
00:05:56,620 --> 00:05:59,000
...مضى وقت طويل منذ بدأنا المشي

89
00:05:59,000 --> 00:06:01,160
كم بقي حتّى نصل يا رين؟

90
00:06:05,680 --> 00:06:06,720
...ذلك الحجر

91
00:06:06,720 --> 00:06:09,820
وضعناه هناك لتحديد طريق العودة، أليس كذلك؟

92
00:06:09,820 --> 00:06:11,430
...أ-أجل

93
00:06:12,030 --> 00:06:13,630
عدنا للمُربّع الأوّل

94
00:06:13,630 --> 00:06:14,890
هكذا يبدو

95
00:06:14,890 --> 00:06:17,600
أ-أتعتقد بأنّك حدّدتَ الطريق الخاطئ؟

96
00:06:17,600 --> 00:06:19,480
لا أرجّح ذلك

97
00:06:20,080 --> 00:06:23,560
شاركتُ المعلومات التي جمعتُها
من الأعلى مع الطيور الأخرى

98
00:06:24,020 --> 00:06:28,320
حتّى لو أخطأتُ الطريق، مُحال أن يخطئوا جميعهم

99
00:06:28,320 --> 00:06:31,490
أظنّنا سلكنا الطريق الصّحيح كذلك

100
00:06:31,490 --> 00:06:34,230
أعتقد هناك سرّ أكبر في هذه الغابة

101
00:06:35,680 --> 00:06:37,750
اسمحا لي بالتحرّي

102
00:06:39,560 --> 00:06:41,160
البحث المادّي

103
00:06:45,250 --> 00:06:48,920
ما... ما هذه الأضواء؟

104
00:06:48,920 --> 00:06:49,980
من هنا

105
00:07:00,520 --> 00:07:01,750
وجدتُه

106
00:07:02,710 --> 00:07:06,200
تبعث هذه الشّجرة سحراً إيهاميّاً

107
00:07:06,200 --> 00:07:07,900
هذا هو سبب ضياعنا عن الطريق

108
00:07:08,640 --> 00:07:10,400
سـ-سحر إيهاميّ؟

109
00:07:10,400 --> 00:07:11,480
أجل

110
00:07:11,480 --> 00:07:16,040
ينشئ حقلاً سحريّاً توسُّعياً يتغلغل إلى عقل الهدف

111
00:07:16,040 --> 00:07:19,770
...ثمّ بالكشف عن مركز المُعالجة السّمعبصرية للدماغ للتأثير به

112
00:07:21,800 --> 00:07:22,750
،بصيغة أخرى

113
00:07:23,390 --> 00:07:29,880
أُطلِقَتْ تعويذة علينا تمنعنا من فعل
أيّ شيء عدا المشي بشكل دائري

114
00:07:29,880 --> 00:07:33,510
رغم أنّ نِطاقه يمثّل حاجزاً أكثر من كونه تعويذة

115
00:07:34,160 --> 00:07:35,850
هكذا إذاً

116
00:07:36,200 --> 00:07:39,390
حسناً يا كانادي، هل يمكنكِ إسقاط هذه الشّجرة؟

117
00:07:39,390 --> 00:07:40,300
لماذا؟

118
00:07:40,300 --> 00:07:41,630
تنفيس عن الإحباط؟

119
00:07:41,630 --> 00:07:42,570
!قطعاً لا

120
00:07:42,570 --> 00:07:44,440
!من تعتقدينني بالضبط؟

121
00:07:44,440 --> 00:07:45,940
!لا تتشاجرا رجاء

122
00:07:46,720 --> 00:07:49,310
الشّجرة تُسلّط الحاجز

123
00:07:49,310 --> 00:07:51,950
إزالتها سيسمح لنا بمُتابعة التقدُّم

124
00:07:51,950 --> 00:07:53,040
!فهمت

125
00:07:53,040 --> 00:07:54,160
...تانيا

126
00:07:54,160 --> 00:07:54,780
نعم؟

127
00:07:55,210 --> 00:07:58,010
ألا يمكنكِ إزالة الحاجز فحسب؟

128
00:07:58,010 --> 00:07:59,200
...دون تدمير الشّجرة

129
00:08:00,340 --> 00:08:02,160
إنّه قويّ جدّاً

130
00:08:02,560 --> 00:08:05,690
أستطيع فعلها، لكن قد يستغرق هذا وقتاً طويلاً

131
00:08:05,690 --> 00:08:06,970
هكذا إذاً

132
00:08:06,970 --> 00:08:10,080
!إذا تأخّرنا، سيسخر ذلك البطل من رين

133
00:08:10,080 --> 00:08:11,320
!لن أسمح بحدوث ذلك

134
00:08:11,320 --> 00:08:12,880
!رين، دعني أفعلها

135
00:08:12,880 --> 00:08:13,630
—انتظري يا كانادي

136
00:08:15,490 --> 00:08:17,140
غادروا هذا المكان

137
00:08:17,140 --> 00:08:19,720
!ما-ماذا كان هذا الصّوت؟

138
00:08:19,720 --> 00:08:23,310
غادروا هذا المكان. غادروا هذا المكان

139
00:08:23,310 --> 00:08:29,360
غادروا هذا المكان

140
00:08:29,790 --> 00:08:30,820
...مستحيل

141
00:08:39,210 --> 00:08:40,660
جنّية

142
00:08:41,000 --> 00:08:43,910
إحدى الأنواع الأقوى مثل كانادي وتانيا

143
00:08:44,520 --> 00:08:47,630
مُختصّو إطلاق تعويذات بقوّة سحريّة
!أعظم حتّى من أشباه التنّين

144
00:08:47,930 --> 00:08:52,600
لكن لم يرَ البشر جنّية منذ عامين

145
00:08:53,400 --> 00:08:56,810
،كمُقيمين في الجبال والغابات

146
00:08:56,810 --> 00:09:00,580
اعتبروا البشر الّذين حصدوا الغابات للحصول
على موارد، أعداءهم الأزليّين

147
00:09:01,250 --> 00:09:04,270
،ثمّ سرعان ما اندلع صِراع بين المجموعتين

148
00:09:04,270 --> 00:09:08,360
وانسحبت الجنّيات إلى مناطق داخليّة
لا يستطيع البشر الوصول إليها

149
00:09:09,160 --> 00:09:14,030
بسبب ذلك، تضمر الجنّيات ضغينة شديدة تجاه البشر

150
00:09:14,480 --> 00:09:15,570
...ا-المعذرة

151
00:09:16,030 --> 00:09:16,780
--مرحباً

152
00:09:16,780 --> 00:09:17,740
غادروا هذا المكان

153
00:09:17,740 --> 00:09:20,330
—المعذرة... كنتُ آمل أن نتحدّث

154
00:09:20,330 --> 00:09:21,410
غادروا هذا المكان

155
00:09:21,410 --> 00:09:24,460
...أنا رين. وهاتان زميلتايّ

156
00:09:24,460 --> 00:09:25,960
غادروا هذا المكان

157
00:09:25,960 --> 00:09:28,360
—هناك شيء حقّاً علينا فعله في هذه

158
00:09:28,360 --> 00:09:29,520
غادروا هذا المكان

159
00:09:29,520 --> 00:09:31,420
...إن لم تغادروا هذا المكان

160
00:09:32,000 --> 00:09:34,130
سأزيلكم عنه

161
00:09:34,130 --> 00:09:35,560
!سـ-سنعود لاحقاً

162
00:09:35,560 --> 00:09:36,840
!حسناً

163
00:09:41,480 --> 00:09:43,530
لـ-لم تلحق بنا؟

164
00:09:43,530 --> 00:09:45,100
لا، أظنّنا بخير

165
00:09:45,940 --> 00:09:48,080
!يا لها من صدمة

166
00:09:48,080 --> 00:09:49,450
ماذا كان ذلك بالتّحديد؟

167
00:09:49,450 --> 00:09:51,950
...تُهدّدنا فجأة هكذا

168
00:09:51,950 --> 00:09:55,950
ألا يُفترض أن تكون الجنّيات أنواعاً لطيفة وودودة؟

169
00:09:55,950 --> 00:09:56,570
...بلى

170
00:09:57,150 --> 00:10:00,200
من الغريب أن تكشف عن نفسها هكذا حتّى

171
00:10:00,200 --> 00:10:02,480
،ستختلف المسألة لو كنتُما أنتُما فقط

172
00:10:02,480 --> 00:10:04,160
لكن بوجود بشريّ مثلي؟

173
00:10:04,160 --> 00:10:06,540
ما كانت لتكشف عن نفسها في العادة

174
00:10:06,540 --> 00:10:08,730
هل تلمّح إلى أنّ هناك ما هو أكبر من ذلك؟

175
00:10:08,730 --> 00:10:09,500
أجل

176
00:10:09,500 --> 00:10:13,150
أعتقد لأنّنا اقتربنا من الحاجز

177
00:10:13,150 --> 00:10:16,210
بالفعل، كشفَتْ عن نفسها عندما
...حاولت كانادي كسره

178
00:10:16,210 --> 00:10:20,080
!لأنّكِ قلتِ بأنّها كانت الطريقة الوحيدة للمُتابعة

179
00:10:20,080 --> 00:10:21,190
ماذا؟

180
00:10:21,190 --> 00:10:26,380
ألم تقل بأنّ هناك وحش معه ترس
الحقيقة داخل ذلك الحاجز؟

181
00:10:26,380 --> 00:10:30,330
...لكن عندما حاولتُ كسر الحاجز، خرجت تلك الفتاة ثمّ

182
00:10:30,330 --> 00:10:31,560
يبدو ذلك غريباً

183
00:10:32,040 --> 00:10:36,010
هل كانت لتتعاون مع وحوش نتيجة
كراهية خالصة تجاه البشر؟

184
00:10:36,010 --> 00:10:38,830
...حسناً، بغضّ النّظر عن دافعها

185
00:10:38,830 --> 00:10:40,750
نحن على عجلة من أمرنا، أليس كذلك؟

186
00:10:40,750 --> 00:10:43,540
أعتقد ينبغي أن نُسقط الحاجز ونتابع

187
00:10:44,260 --> 00:10:46,490
،أخذَتْنا بَغتة من قبل

188
00:10:46,490 --> 00:10:48,800
لكن يمكنني التصدّي لتعويذاتها

189
00:10:48,800 --> 00:10:51,840
بينما أفعل يا كانادي، دمّري الشّجرة

190
00:10:51,840 --> 00:10:53,050
!هكذا إذاً

191
00:10:53,050 --> 00:10:55,160
حينها لن نؤذيها فعليّاً

192
00:10:55,160 --> 00:10:56,250
تتّفق معي، صحيح؟

193
00:11:00,130 --> 00:11:03,140
في الحقيقة... أفضّل أن أتكلّم معها مرّة أخرى

194
00:11:04,640 --> 00:11:05,630
!لا يمكنك

195
00:11:05,630 --> 00:11:08,400
!من الواضح أنّها غير مُهتمّة بالكلام

196
00:11:08,400 --> 00:11:11,470
!أجل! هذا ليس آمناً

197
00:11:11,470 --> 00:11:13,690
...أفضّل استعمال القوّة إن أمكن

198
00:11:14,430 --> 00:11:18,990
بالإضافة إلى ذلك، كنّا نتّخذ وضعاً
دفاعيّاً آنذاك، أليس كذلك؟

199
00:11:18,990 --> 00:11:22,700
إذا اقتربنا من دون عِدائيّة، فأظنّنا نستطيع تدبُّر الأمر

200
00:11:24,400 --> 00:11:25,560
...إنّ رين

201
00:11:25,560 --> 00:11:26,750
...حقّاً

202
00:11:26,750 --> 00:11:29,130
!لطيف زيادة عن اللّزوم...

203
00:11:44,180 --> 00:11:45,640
غادروا هذا المكان

204
00:11:45,640 --> 00:11:47,800
لسنا أعداءكِ

205
00:11:47,800 --> 00:11:49,450
نريد أن نتكلّم معكِ

206
00:11:50,270 --> 00:11:51,810
غادروا هذا المكان

207
00:11:51,810 --> 00:11:54,590
لم نأتِ إلى هنا لإفساد الغابة

208
00:11:54,590 --> 00:11:56,520
!لدينا عمل في الدّاخل فحسب

209
00:11:56,910 --> 00:11:58,780
...إن لم تغادروا هذا المكان

210
00:11:58,780 --> 00:12:00,660
هاجميني إذا أردتِ

211
00:12:01,240 --> 00:12:04,190
إذا كان هذا سيبني ثِقة بيننا، سأقبل بذلك

212
00:12:04,190 --> 00:12:07,120
لكن أرجوكِ لا تؤذي اللّتين تقِفان خلفي

213
00:12:07,120 --> 00:12:08,270
!انتظر

214
00:12:08,270 --> 00:12:10,960
...حقّاً؟ في هذه الحالة

215
00:12:10,960 --> 00:12:12,540
سأطهّرك الآن

216
00:12:15,000 --> 00:12:15,880
!رين

217
00:12:15,880 --> 00:12:17,050
لا عليكما

218
00:12:17,050 --> 00:12:18,840
يمكنني تحمّل هجمة واحدة

219
00:12:19,320 --> 00:12:21,090
لكن لن أستسلم مهما حصل

220
00:12:22,160 --> 00:12:24,130
أنا مُروِّض وحوش

221
00:12:24,570 --> 00:12:28,250
واجهتُ عدداً كبيراً من الظّروف الّتي
لم أستطع فيها التّواصل بكلمات

222
00:12:28,680 --> 00:12:29,900
...ومع ذلك

223
00:12:30,680 --> 00:12:33,890
بالاحتكاك بإيمان راسخ، يمكن لمشاعرك أن تصل

224
00:12:35,330 --> 00:12:36,700
أعلم ذلك

225
00:12:38,720 --> 00:12:40,570
!سهم الوهم

226
00:12:45,240 --> 00:12:47,150
لماذا لا تهرب؟

227
00:12:47,150 --> 00:12:47,990
هل نسيتِ؟

228
00:12:48,270 --> 00:12:50,200
!كلّ ما أريده هو الكلام

229
00:12:50,610 --> 00:12:54,920
تركتَ هجمتي تُصيبك فقط كي تكسب ثِقتي؟

230
00:12:56,840 --> 00:12:58,380
لستُ أفهم

231
00:12:58,800 --> 00:13:01,110
هل أنت بشريّ حقّاً؟

232
00:13:01,530 --> 00:13:07,760
كأولئك الّذين سرقوا ودنّسوا وداسوا على أراضينا؟

233
00:13:08,610 --> 00:13:09,950
أنا كذلك

234
00:13:09,950 --> 00:13:12,170
لكن ليس جميعنا هكذا

235
00:13:12,720 --> 00:13:15,230
يوجد كثير من البشر الأخيار

236
00:13:16,180 --> 00:13:18,700
،لا أعِدُكِ بأنّني واحد منهم

237
00:13:18,700 --> 00:13:20,220
لكن آمل أن تثقي بي

238
00:13:20,220 --> 00:13:22,250
...أنا... أنا

239
00:13:24,120 --> 00:13:25,650
!لن أنخدع

240
00:13:31,330 --> 00:13:33,660
!أنتما... لماذا؟

241
00:13:33,660 --> 00:13:35,160
!لم نستطع الوقوف مكتوفتي اليدين والمُراقبة فحسب

242
00:13:35,160 --> 00:13:37,870
،حتّى لو طلبت منّا أن نترك الأمر لك
!هذا لا يعني أنّنا غير قلقتين

243
00:13:38,200 --> 00:13:39,920
أجل، بالغتَ كثيراً

244
00:13:39,920 --> 00:13:41,960
!من الواضح أنّ مشاعرك لم تصلها

245
00:13:42,680 --> 00:13:44,100
!اسمعيني

246
00:13:44,670 --> 00:13:48,120
!رين ليس شخصاً سيّئاً صدّقيني

247
00:13:48,120 --> 00:13:51,160
أنقذني عندما وقعتُ في مأزق

248
00:13:51,160 --> 00:13:55,400
...وساعدَ النّاس في المدينة و

249
00:13:55,400 --> 00:13:59,050
تماماً! أنا، كشبيهة تنّين، أدعمه كذلك

250
00:13:59,050 --> 00:14:03,280
!أتتذكّرين؟ كان رين مُعارضاً لتدمير الغابة منذ البداية

251
00:14:03,640 --> 00:14:04,890
!أجل

252
00:14:04,890 --> 00:14:07,950
!عندما أرادت تانيا حرق المكان، غَضِبَ كثيراً

253
00:14:07,950 --> 00:14:09,630
!لـ-لم أكن جادّة بشأن ذلك

254
00:14:09,630 --> 00:14:13,120
!لكن عندما حاولتِ تدمير الشّجرة، منعَكِ رين

255
00:14:13,520 --> 00:14:16,350
!أنت من طلب منّي فعل ذلك

256
00:14:16,350 --> 00:14:18,710
لكن رغم هذا أردتِ فعلها، صحيح؟

257
00:14:19,000 --> 00:14:21,800
!لكن تبقى فكرتكِ

258
00:14:20,000 --> 00:14:22,760
!لا وقت للشِجار أنتما

259
00:14:21,950 --> 00:14:23,420
يا له من بشريّ غريب

260
00:14:24,040 --> 00:14:27,380
...روح قطّة فضوليّة وشبيهة تنّين أيضاً

261
00:14:30,640 --> 00:14:35,430
لم ألتقِ بمخلوقات مثلكم من قبل

262
00:14:36,500 --> 00:14:37,660
ما اسمك؟

263
00:14:38,100 --> 00:14:40,000
رين شراود

264
00:14:40,000 --> 00:14:41,400
أنا سورا

265
00:14:42,280 --> 00:14:44,870
سأصغي إلى ما لديك لتقوله

266
00:14:47,320 --> 00:14:49,000
هكذا إذاً

267
00:14:49,000 --> 00:14:54,110
تبحث عن ترس الحقيقة بدلاً من ذلك البطل

268
00:14:54,110 --> 00:14:55,770
هل هذا صحيح؟

269
00:14:55,770 --> 00:14:56,880
أجل

270
00:14:56,880 --> 00:14:58,790
لكن الحاجز يصدّنا

271
00:14:59,180 --> 00:15:01,500
كنتُ أنا من نصب الحاجز

272
00:15:01,880 --> 00:15:04,200
--هل يمكنكِ إزالته كي تدعينا

273
00:15:04,200 --> 00:15:05,590
لا أستطيع

274
00:15:06,030 --> 00:15:10,940
يقطع الحاجز الطريق إلى قرية الجنّيات

275
00:15:10,940 --> 00:15:13,430
يجب ألّا أعرّض زميلاتي للخطر

276
00:15:13,430 --> 00:15:16,920
يبدو لي أنّكِ تتستّرين على وحش

277
00:15:16,920 --> 00:15:17,920
غير صحيح

278
00:15:17,920 --> 00:15:22,150
لا وحش في هذه الغابة يمتلك ترس الحقيقة

279
00:15:22,670 --> 00:15:26,460
كلّ ما يوجد في أعماقها هو الطريق
المؤدّي إلى قرية الجنّيات

280
00:15:26,460 --> 00:15:29,740
الجنّيات هُنَّ من يحمين ترس الحقيقة

281
00:15:29,740 --> 00:15:31,200
!حقّاً؟

282
00:15:31,600 --> 00:15:33,980
ماذا؟ لكن ماذا عن الوحش؟

283
00:15:33,980 --> 00:15:37,410
أنا متأكّدة بأنّ شخصاً أوصل معلومة
خاطئة لذلك البطل السّخيف

284
00:15:39,220 --> 00:15:42,490
إذا كان ضروريّاً للقضاء على ملك
الشّياطين، سأعطيكم إيّاه

285
00:15:42,490 --> 00:15:44,000
أمهلوني قليلاً من الوقت

286
00:15:52,080 --> 00:15:53,260
خُذه

287
00:15:53,260 --> 00:15:55,260
هـ-هل أنتِ متأكّدة من هذا؟

288
00:15:55,260 --> 00:15:56,200
أجل

289
00:15:56,200 --> 00:15:58,040
،مع أنّني أمقت البشر

290
00:15:58,040 --> 00:16:00,700
إلّا أنّ حقدي على الوحوش أكبر

291
00:16:02,260 --> 00:16:05,510
...بـ-بدا ذلك سهلاً للغاية

292
00:16:06,290 --> 00:16:07,440
!لكن فعلناها

293
00:16:07,440 --> 00:16:10,220
هل من شيء نستطيع فعله لشكركِ؟

294
00:16:10,220 --> 00:16:11,900
لا حاجة

295
00:16:12,440 --> 00:16:14,480
توريث ترس الحقيقة

296
00:16:14,480 --> 00:16:19,640
كان ميثاقاً قديماً تمّ إنشاؤه بين الجنّيات والبطل السّابق

297
00:16:19,640 --> 00:16:21,870
وأنا حافظتُ على هذا الميثاق فقط

298
00:16:21,870 --> 00:16:23,120
حـ-حقّاً؟

299
00:16:23,120 --> 00:16:25,100
أجل. لا أستحقّ امتناناً

300
00:16:25,100 --> 00:16:27,960
،تقول أنّك لست بحاجة لشكرها
لذا أنا متأكّدة بأنّه لا داعي

301
00:16:28,300 --> 00:16:30,590
!حسناً، أتممنا العمل

302
00:16:30,590 --> 00:16:33,240
!لنعُد إلى المدينة ونُسلّمه

303
00:16:33,240 --> 00:16:35,610
أ-أجل، بالتأكيد

304
00:16:35,610 --> 00:16:37,160
شكراً يا سورا

305
00:16:37,160 --> 00:16:39,760
الآن بعد أن انتهيتم من عملكم، غادروا هذا المكان

306
00:16:39,760 --> 00:16:41,220
...أ-أجل

307
00:16:42,100 --> 00:16:43,530
!رين، رين

308
00:16:43,530 --> 00:16:45,800
هل يمكنني إمعان النّظر أكثر إلى ذلك التّرس؟

309
00:16:45,800 --> 00:16:46,520
!بكلّ تأكيد

310
00:16:46,520 --> 00:16:48,080
لا تكسريه فحسب

311
00:16:48,080 --> 00:16:49,570
!لن أفعل

312
00:16:54,170 --> 00:16:55,370
ما الأمر؟

313
00:16:55,960 --> 00:16:57,280
...سورا

314
00:16:57,280 --> 00:16:59,440
ثمّة شيء يؤرقك، أليس كذلك؟

315
00:17:01,200 --> 00:17:05,040
لا أعرف بالسّبب. إنّه مجرّد إحساس انتابني

316
00:17:05,040 --> 00:17:07,540
حتّى لو كان أمراً صغيراً، يسرّني سماعك

317
00:17:08,080 --> 00:17:11,250
...وجلبتِ لنا ترس الحقيقة، لذا

318
00:17:11,530 --> 00:17:14,730
هناك احتمال أن أستطيع مساعدتكِ يا سورا

319
00:17:17,040 --> 00:17:19,000
...المعذرة... الحقيقة

320
00:17:19,000 --> 00:17:21,480
...أنا... أنا

321
00:17:22,950 --> 00:17:24,990
لا، يجب ألّا أكشف عن ذلك

322
00:17:24,990 --> 00:17:26,510
...إذا كشفتُ الحقيقة

323
00:17:27,150 --> 00:17:29,650
...سيساعدني غالباً

324
00:17:30,650 --> 00:17:33,180
وقد يتأذّون جميعهم

325
00:17:33,900 --> 00:17:36,570
لا... لا شيء

326
00:17:36,570 --> 00:17:37,550
لا أمانع

327
00:17:38,320 --> 00:17:40,670
حتّى لو كان هذا خطيراً، لا أمانع

328
00:17:40,670 --> 00:17:42,760
إن كنتِ في مأزق، أريد تقديم المُساعدة

329
00:17:43,390 --> 00:17:45,020
لماذا لا تدعيني؟

330
00:17:45,430 --> 00:17:46,650
...لـ-لكن

331
00:17:46,650 --> 00:17:48,150
هذه هي طبيعته

332
00:17:48,500 --> 00:17:51,240
إنّه لطيف زيادة عن اللّزوم لدرجة
أنّ هذا مُقرف بصراحة

333
00:17:51,240 --> 00:17:53,450
"إنّه لا يقبل جواباً مثل "لا

334
00:17:53,450 --> 00:17:56,800
حسناً؟ لمَ لا تمنحيننا فُرصة؟

335
00:17:56,800 --> 00:17:57,630
—ما

336
00:17:57,630 --> 00:18:01,260
!أظنّكِ ينبغي أن تفعليها أيضاً

337
00:18:01,260 --> 00:18:03,120
!لا تقلقي

338
00:18:03,120 --> 00:18:05,930
!نحن أقوى بكثير ممّا نبدو

339
00:18:06,600 --> 00:18:09,650
!أرى حقّاً بأنّنا نستطيع مساعدتكِ

340
00:18:13,350 --> 00:18:14,570
...إذاً

341
00:18:14,570 --> 00:18:19,030
نظراً إلى أنّني اعتبرتُكم جديرون
بثِقتي، سوف أكشف عن كلّ شيء

342
00:18:20,070 --> 00:18:22,240
لديّ أخت توأم صغرى

343
00:18:23,140 --> 00:18:25,100
اسمها رونا

344
00:18:25,100 --> 00:18:29,580
شخصيّتها مُعاكِسة لشخصيّتي، ومع ذلك نحن مُقرّبتان

345
00:18:31,700 --> 00:18:34,010
إنّها عزيزةٌ عليّ

346
00:18:35,300 --> 00:18:39,840
في الحقيقة، هناك أكثر من طريق إلى قرية الجنّيات

347
00:18:39,840 --> 00:18:42,460
هناك طُرُقات كثيرة في كلّ أنحاء العالم

348
00:18:42,940 --> 00:18:48,150
معاً، رونا وأنا حافظنا على الحاجز
ضمن غابة الضّياع

349
00:18:49,110 --> 00:18:51,860
كان في الحقيقة عملاً مُمِلّاً

350
00:18:54,840 --> 00:18:59,610
لكن في صُحبة رونا، كانت هناك بهجة كبيرة

351
00:19:00,360 --> 00:19:01,320
...لكن

352
00:19:01,860 --> 00:19:07,370
في ذلك اليوم، أُجبِرنا على ترك الحاجز
لبعض الوقت، لأسباب مُعيّنة

353
00:19:07,870 --> 00:19:08,780
...وهناك

354
00:19:10,120 --> 00:19:13,630
واجهنا وحشاً يعمل لصالح جيش ملك الشّياطين

355
00:19:14,210 --> 00:19:16,360
،حاولنا سريعاً العودة من حيث أتينا

356
00:19:16,360 --> 00:19:19,300
لكنّه طاردَنا، وأُجبِرنا على المُقاومة

357
00:19:21,870 --> 00:19:24,300
لكن فشِلنا في هزيمته

358
00:19:25,050 --> 00:19:25,850
...ثمّ

359
00:19:31,760 --> 00:19:34,020
أُسِرَتْ رونا

360
00:19:34,020 --> 00:19:36,620
وحش حتّى الجنّيات لم يستطِعن هزيمته؟

361
00:19:36,620 --> 00:19:39,500
كان اسم الوحش فارس الظلّ

362
00:19:39,500 --> 00:19:42,080
هكذا إذاً... فهمت

363
00:19:42,080 --> 00:19:43,490
ما-ماذا تقصد؟

364
00:19:44,160 --> 00:19:46,590
،فارس الظلّ هو وحش برتبة ج

365
00:19:46,590 --> 00:19:49,520
لذا لا ينبغي أن يكون قادراً على
هزيمة نوع أقوى

366
00:19:49,520 --> 00:19:51,990
لكن لديه ميزة يصعب التّعامل معها

367
00:19:52,670 --> 00:19:55,840
يُبطِل كلّ الهجمات السحريّة

368
00:19:55,840 --> 00:19:59,550
بصيغة أخرى، وحدها الهجمات الجسديّة
ما يؤثّر على فارس ظلّ

369
00:19:59,550 --> 00:20:03,070
من جانب آخر، تختصّ الجنّيات بالسّحر بشكل خاص

370
00:20:03,070 --> 00:20:05,010
كانت معركة غير مُتكافئة بالنسبة لهما

371
00:20:05,370 --> 00:20:09,210
وأنا التي كنتُ أتساءل ما الّذي استطاع
هزيمة هاتان الجنّيتان

372
00:20:09,720 --> 00:20:11,030
بَطُلَ العجب

373
00:20:11,030 --> 00:20:11,730
أجل

374
00:20:12,280 --> 00:20:16,190
كان هدف فارس الظلّ القضاء على الأنواع
الأفضل الّذين قد يعترضون طريقه

375
00:20:16,930 --> 00:20:21,400
أمرَني بإزالة الحاجز لِقاء إطلاق سراح رونا

376
00:20:21,400 --> 00:20:26,620
لكن رفضتُ تعريض أصدقائي الآخرين لخطر

377
00:20:27,300 --> 00:20:31,830
ولأنّني عاجزة عن إنقاذها بمُفردي، توسّلتُ
قائد القرية للحصول على مساعدة

378
00:20:32,530 --> 00:20:36,130
لكن شجّعني بدلاً من ذلك على التخلّي عنها

379
00:20:37,040 --> 00:20:40,810
"يجب أن نحتفل بحقيقة أنّ الآخرين ضمن الحاجز بأمان"

380
00:20:40,810 --> 00:20:43,560
"كنتُما أنتما من أخطأتُما بمغادرة الحاجز الحامي"

381
00:20:43,560 --> 00:20:46,750
"يجب أن تقبلي عواقب تصرّفكما"

382
00:20:47,600 --> 00:20:49,070
...هذا فظيع

383
00:20:49,070 --> 00:20:50,180
!غير مقبول

384
00:20:50,600 --> 00:20:52,680
أتفهّم منطِق قائدنا

385
00:20:53,140 --> 00:20:59,110
يضع الأولويّة لأرواح كلّ الجنّيات على روح أختي

386
00:20:59,880 --> 00:21:03,320
...أتفهّم ذلك... ومع هذا

387
00:21:03,800 --> 00:21:05,070
...ومع هذا أنا

388
00:21:05,880 --> 00:21:10,630
أنا عاجزة عن التخلّي عن أختي ببساطة

389
00:21:17,160 --> 00:21:19,250
كنتِ تعملين بجدّ

390
00:21:19,860 --> 00:21:22,780
كنتِ تتحمّلين كلّ هذا الألم بمفردكِ

391
00:21:23,300 --> 00:21:25,220
لكن يمكنكِ أن تسترخي الآن

392
00:21:25,610 --> 00:21:26,910
سأقطع عليكِ هذا الوعد

393
00:21:26,910 --> 00:21:28,780
سوف ننقذ أختكِ

394
00:21:29,680 --> 00:21:32,300
لن نعرّض شعبكِ لخطر

395
00:21:32,960 --> 00:21:35,140
وسوف نهزم فارس الظلّ

396
00:21:35,140 --> 00:21:36,140
كلّ هذا

397
00:21:36,790 --> 00:21:40,030
سوف نمنحكِ كلّ هذا معاً

398
00:23:36,440 --> 00:23:39,420
"الحلقة القادمة: "الجنّية الأسيرة