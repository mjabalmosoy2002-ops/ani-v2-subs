1
00:00:19,140 --> 00:00:22,000
...آمل أن تُصبح تلك الغرفة الإضافيّة مُتاحة قريباً

2
00:01:52,920 --> 00:01:54,960
عتاد جديد لي؟

3
00:01:54,960 --> 00:01:57,880
أجل

4
00:01:55,630 --> 00:01:56,860
ذكرتَ ذلك من قبل، أنسيت؟

5
00:01:57,880 --> 00:02:01,640
أصبحتَ أقوى بكثير منذ إنشاء
...عقدك معي، ولكن

6
00:02:01,640 --> 00:02:04,430
لا أستطيع الاستفادة منه لأقصى
درجة وأنا أعزل، صحيح؟

7
00:02:05,760 --> 00:02:06,890
!مُذهل

8
00:02:06,890 --> 00:02:10,090
!تُبرِز هذه التّوابل نكهة الخضار

9
00:02:10,090 --> 00:02:12,360
!أختي! هذا حساء لذيذ

10
00:02:12,360 --> 00:02:15,860
رونا، تفرض عليكِ آداب السّلوك
ألّا تصرخي أثناء الوجبات

11
00:02:16,190 --> 00:02:18,540
...وانظري إلى هذه الفوضى الفظيعة الّتي سبّبتِها

12
00:02:18,540 --> 00:02:23,540
،أجل. ولديّ مال وفير منذ العمل مع آريوس

13
00:02:24,090 --> 00:02:25,450
!لذا لنشترِ بعض العتاد الجديد

14
00:02:28,270 --> 00:02:31,330
!لديّ صديقات أكثر لحمايتهن في نهاية المطاف

15
00:02:34,740 --> 00:02:36,490
!الكثير من البشر

16
00:02:36,490 --> 00:02:39,000
لا أستطيع أن أدعهم يكتشفون بأنّنا جنّيات

17
00:02:39,000 --> 00:02:40,090
!ابقي يقظة يا أختي

18
00:02:40,600 --> 00:02:43,050
لـ-لا داعي للقلق

19
00:02:43,050 --> 00:02:47,630
!أقسم أن أحميكِ هذه المرّة يا رونا مهما كلّف الأمر

20
00:02:47,630 --> 00:02:48,960
أنتما بأمان

21
00:02:48,960 --> 00:02:51,400
أخبرتُكما، ليس كلّ البشر سيّئين

22
00:02:51,920 --> 00:02:54,120
...رغم طمأنتك لنا، لكن

23
00:02:54,120 --> 00:02:57,320
أجل، كنّا منعزلتين لفترة طويلة
بسبب اختلاف النّوع

24
00:02:57,320 --> 00:02:59,720
!نحتاج وقتاً حتّى نعتاد على كلّ هذا

25
00:02:59,720 --> 00:03:01,800
"أقدّم اعتراضي ثانية على مُصطلح "مُنعزل

26
00:03:01,800 --> 00:03:02,870
!آنسة تانيا

27
00:03:03,290 --> 00:03:04,970
!أهلاً بعودتكِ

28
00:03:04,970 --> 00:03:07,740
أنتما ثانية؟ أليس لديكما شيء أفضل تفعلانه؟

29
00:03:07,740 --> 00:03:08,330
!صحيح

30
00:03:08,970 --> 00:03:14,250
ظللتُ مُكتئباً لفترة بعد تحطيم
...أنفي في جسر الخطوة الواسعة

31
00:03:14,250 --> 00:03:16,220
—لكن حالما اكتشفتُ بأنّكِ تنّينة

32
00:03:16,220 --> 00:03:17,560
!آنسة تانيا

33
00:03:17,560 --> 00:03:19,970
أن أتعرّض لضرب بواسطتكِ هو علامة
على الكبرياء لأيّ مُغامر

34
00:03:19,970 --> 00:03:23,510
!لذا ارتأينا أن نُظهِر احترامنا

35
00:03:24,270 --> 00:03:25,630
حسنٌ إن كنتُما مُصرّين

36
00:03:25,630 --> 00:03:28,180
حالما تصبحان أقوى، سأكلّف
!نفسي عناء مقاتلتكما ثانية

37
00:03:28,180 --> 00:03:30,000
!حاضر يا آنسة تانيا

38
00:03:30,000 --> 00:03:31,640
!مرحباً يا عمّتي

39
00:03:31,640 --> 00:03:32,800
!يا للمفاجأة

40
00:03:32,800 --> 00:03:34,610
تتمتّعين بطاقة اليوم يا كانادي

41
00:03:35,000 --> 00:03:36,280
خذي هذه

42
00:03:36,280 --> 00:03:37,580
!شكراً

43
00:03:37,580 --> 00:03:38,570
لكن هل أنتِ متأكّدة؟

44
00:03:38,570 --> 00:03:41,150
على حسابي، مقابل مساعدتكم

45
00:03:41,150 --> 00:03:43,260
!آمل أن أتمكّن من طلب مساعدتكم ثانية

46
00:03:43,810 --> 00:03:44,870
!يمكنكِ بالتأكيد

47
00:03:44,870 --> 00:03:47,310
كانادي وتانيا مُندمجتان تماماً

48
00:03:47,310 --> 00:03:49,950
...أجل، رغم أنّهما من النّوع الأقوى مثلنا

49
00:03:52,290 --> 00:03:54,240
هـ-هل تريدون منّا شيئاً؟

50
00:03:54,240 --> 00:03:56,860
!لـ-لن أتحفّظ فقط لكونكم أطفالاً

51
00:03:56,860 --> 00:03:59,880
!رين، حصلتَ على مزيد من الزيجات

52
00:04:00,380 --> 00:04:02,220
!إنّهما الرّقم ثلاثة والرّقم أربعة

53
00:04:02,220 --> 00:04:04,860
!نـ-نحن أيّ شيء عدا زيجاته

54
00:04:04,860 --> 00:04:06,550
!انظري إلى نفسكِ وأنتِ خجلة يا أختي

55
00:04:06,960 --> 00:04:08,560
!كلتاكما حسناوتان

56
00:04:08,560 --> 00:04:10,030
هل أنتما روحا زهرة؟

57
00:04:10,030 --> 00:04:11,070
...حـ-حسناء

58
00:04:11,070 --> 00:04:13,830
أشكرك على كلماتك اللّطيفة

59
00:04:16,650 --> 00:04:19,940
!لديكِ عين ثاقبة يا فتاة

60
00:04:19,940 --> 00:04:23,100
...لكنّنا بعيدات عن روح زهرة

61
00:04:23,100 --> 00:04:26,410
!فلتشهدي أعماق سحري الواسعة

62
00:04:28,370 --> 00:04:31,550
—أنا مُستخدمة السّحر العظمى، الجـ

63
00:04:32,780 --> 00:04:34,620
!لماذا أوقفتماني؟

64
00:04:34,620 --> 00:04:37,800
!عندما يطلبُ أحدٌ استعراضاً، فإنّني ألبّي طلبه

65
00:04:37,800 --> 00:04:43,000
هل نسيتِ بأنّ استخدام السّحر
يسبّب ظهور أجنحتنا؟

66
00:04:43,000 --> 00:04:47,220
ستقع مشاكل من تسليط الضّوء على هويّتنا
الحقيقيّة هنا في هذه المدينة

67
00:04:48,030 --> 00:04:51,860
رويداً رويداً، آمل أن تعتادا على الحياة هنا

68
00:04:52,460 --> 00:04:54,230
إذاً... هل هذا هو المكان؟

69
00:04:54,230 --> 00:04:57,190
...يُقال بأنّه أفضل متجر أسلحة في المدينة

70
00:04:57,190 --> 00:04:59,870
ومن المهمّ السّعي خلف الأفضل في كلّ شيء

71
00:04:59,870 --> 00:05:01,030
!لنتابع

72
00:05:03,400 --> 00:05:04,950
أهلاً

73
00:05:07,200 --> 00:05:08,430
ماذا؟

74
00:05:08,430 --> 00:05:10,620
الأقزام ليسوا منظراً نادراً، أليس كذلك؟

75
00:05:10,910 --> 00:05:12,650
بالطبع لا

76
00:05:12,650 --> 00:05:15,230
أبحث عن أسلحة ودرع فحسب

77
00:05:15,230 --> 00:05:17,210
الخدمة ذاتيّة. اختر ما تشاء

78
00:05:17,210 --> 00:05:20,280
!البائع مُخيف قليلاً

79
00:05:20,280 --> 00:05:22,800
الأقزام مشهورون بأنّهم نزِقون

80
00:05:24,260 --> 00:05:28,410
حدّاد قزم؟ أفهم لماذا هو الأفضل في المدينة

81
00:05:28,410 --> 00:05:29,850
!رين! رين

82
00:05:29,850 --> 00:05:31,580
ماذا عن هذه؟

83
00:05:31,580 --> 00:05:32,310
سوط؟

84
00:05:32,590 --> 00:05:33,550
رونا

85
00:05:33,550 --> 00:05:35,760
لا أعتقد بأنّ رين لديها خبرة مع السّياط

86
00:05:35,760 --> 00:05:38,270
ماذا؟ لكنّه مُلائم جدّاً لـ"مُروّض"، أليس كذلك؟

87
00:05:38,270 --> 00:05:42,210
"!افعلي ما أقوله أو تعرفين ماذا سأفعل"

88
00:05:42,210 --> 00:05:45,020
!وقد تكون هناك طرق أخرى لاستخدامه

89
00:05:45,020 --> 00:05:46,860
!مُختلف الأشياء الّتي لا مجال للتفكير فيها

90
00:05:46,860 --> 00:05:49,400
...أ-أشياء لا مجال للتفكير فيها

91
00:05:50,140 --> 00:05:51,550
!كـ-كم هذا فاضح

92
00:05:51,550 --> 00:05:53,370
!مُحال أن يفعل رين أشياء كهذه

93
00:05:53,370 --> 00:05:54,960
ما الّذي يدور في عقلكِ هذا؟

94
00:05:54,960 --> 00:05:56,790
!عقلكِ قذر حقّاً يا أختي

95
00:05:56,790 --> 00:05:59,450
!رونا

96
00:05:59,450 --> 00:06:02,000
!أنتِ تُؤلمينني يا أختي

97
00:06:02,400 --> 00:06:05,710
!بـ-بجدّية، بدأ يؤلمني هذا حقّاً

98
00:06:06,010 --> 00:06:07,670
!يبدو هذا جيّداً

99
00:06:07,670 --> 00:06:08,570
خنجر؟

100
00:06:08,570 --> 00:06:11,800
تستحقّ بالتأكيد أكثر من سلاح مدهش يا رين

101
00:06:11,800 --> 00:06:14,110
لكن هذا ما اعتدتُ عليه

102
00:06:15,320 --> 00:06:17,140
!ما أجمله

103
00:06:17,870 --> 00:06:19,290
...أشعر بشيء غريب في هذا

104
00:06:19,290 --> 00:06:21,230
...رغم أنّه يبدو جيّداً من الخارج

105
00:06:21,800 --> 00:06:25,610
أنت أفضل محلّ أسلحة في البلدة، صحيح؟

106
00:06:25,920 --> 00:06:28,730
!أريد أجود سلاح يمكن للمال أن يشتريه

107
00:06:28,730 --> 00:06:30,320
!لديّ الكثير لإنفاقه في نهاية المطاف

108
00:06:32,180 --> 00:06:33,280
مال؟

109
00:06:37,110 --> 00:06:38,830
ما رأيك بهذا؟

110
00:06:38,830 --> 00:06:39,800
!مُذهل

111
00:06:39,800 --> 00:06:41,920
!يبدو حادّاً

112
00:06:41,920 --> 00:06:43,500
!أجل، لا يوجد ما يهزم هذا السّيف

113
00:06:43,930 --> 00:06:45,180
!سوف آخذه

114
00:06:45,180 --> 00:06:46,460
أشكرك

115
00:06:48,920 --> 00:06:51,930
!كان سيفاً جميلاً جدّاً

116
00:06:52,670 --> 00:06:53,640
رين؟

117
00:06:54,720 --> 00:06:56,350
المعذرة

118
00:06:56,780 --> 00:06:58,700
...ذلك السّلاح الّذي بعتَه للتو

119
00:06:58,700 --> 00:07:00,960
هل كان أفضل ما لديك؟

120
00:07:02,350 --> 00:07:03,770
ما الّذي ترمي إليه؟

121
00:07:04,170 --> 00:07:09,740
إنّه قطعة استعراضيّة جميلة، لكن
يبدو أنّه ضعيف في المعارك الفعليّة

122
00:07:09,740 --> 00:07:11,900
وليس هذا فقط

123
00:07:11,900 --> 00:07:14,450
ينطبق ذات الأمر على كلّ شيء في هذا المتجر

124
00:07:16,410 --> 00:07:17,870
...هل يُعقَل

125
00:07:18,200 --> 00:07:19,830
أنّك تُخفي شيئاً؟

126
00:07:26,590 --> 00:07:29,440
لديك عين ثاقبة يا فتى

127
00:07:29,440 --> 00:07:30,380
أجل، هذا صحيح

128
00:07:31,040 --> 00:07:35,480
،كلّ هذه الأسلحة صنعتُها في أوقات فراغي

129
00:07:35,480 --> 00:07:37,850
دون وجود شيء أوصي به غير حدّ وتحمُّل جيّدين

130
00:07:38,200 --> 00:07:40,960
بعبارة أخرى، غشّ حقيقيّ

131
00:07:40,960 --> 00:07:44,060
قد أكون مُضطرّة لإعادة النّظر
...في تقييمي للأقزام

132
00:07:44,060 --> 00:07:46,760
!احفظا لسانيكما يا فتاتان

133
00:07:46,760 --> 00:07:48,940
مهما كانت سيّئة، تبقى من صناعة الأقزام

134
00:07:48,940 --> 00:07:51,600
لكنّني لا أتقاضى ثمنها أكثر من قيمتها

135
00:07:51,990 --> 00:07:53,340
...لكن

136
00:07:57,480 --> 00:08:02,580
إنّها لا شيء مُقارنة بالأسلحة
الّتي أكرّس قلبي فيها

137
00:08:02,580 --> 00:08:05,540
من الواضح من الوهلة الأولى أنّها بمستوى مُختلف

138
00:08:05,930 --> 00:08:09,880
،إذا كنتَ تستطيع صنع أسلحة مُبهرة كهذه
فلماذا عاملتَ زبونك بتلك الطريقة؟

139
00:08:10,920 --> 00:08:15,590
كان ذلك اختباراً لحماسته

140
00:08:15,950 --> 00:08:20,720
في هذه الأيّام، الجميع يكسبون مالهم
،ويطلبون سلاحاً جيّداً

141
00:08:20,720 --> 00:08:23,630
دون اهتمام بمهاراتهم الفرديّة وميولهم

142
00:08:24,650 --> 00:08:30,160
،حتّى الأسلحة الّتي أكرّس قلبي فيها
يرمونها حالما يجدون نموذجاً جديداً

143
00:08:30,610 --> 00:08:34,070
بدأتُ أفقد إيماني مع الوقت

144
00:08:38,040 --> 00:08:42,650
بالنسبة لحدّاد أسلحة، الأسلحة الّتي
نصنعها هي بمثابة أولادنا

145
00:08:42,650 --> 00:08:47,700
هل من الأنانيّة الرّغبة في أن
يحملها شخص جدير بها؟

146
00:08:50,980 --> 00:08:52,880
!أتفهّم مشاعرك تماماً

147
00:08:54,010 --> 00:08:58,060
!مُنتجات نخب أوّل تتطلّب مُستخدِمين نخب أوّل حتماً

148
00:08:58,560 --> 00:08:59,810
!تفهمينني؟

149
00:08:59,810 --> 00:09:01,040
!بكلِّ تأكيد

150
00:09:00,770 --> 00:09:03,040
يبدوان كروحين شقيقتين

151
00:09:01,040 --> 00:09:03,080
!أنا نخب أوّل بحدِّ ذاتي

152
00:09:03,040 --> 00:09:06,270
كبرياؤهما الفطريّ يخلق تفاهماً مُتبادَلاً على ما أعتقد

153
00:09:04,000 --> 00:09:06,270
!أنتِ مثيرة جدّاً للاهتمام يا آنسة

154
00:09:07,510 --> 00:09:10,440
حسناً، سؤال لك

155
00:09:11,110 --> 00:09:14,640
كيف ميّزتَ اختلاف الأسلحة؟

156
00:09:15,580 --> 00:09:20,870
في نظري، ينبغي أن تكون جيّدة
بما يكفي لتضليل مُعظم النّاس

157
00:09:20,870 --> 00:09:23,440
،في الحقيقة، لستُ مُتيقّناً تماماً

158
00:09:23,440 --> 00:09:24,590
،لكن إذا كان لا بدَّ أن أجيب

159
00:09:24,590 --> 00:09:27,060
ربّما لأنّني مُروِّض وحوش

160
00:09:28,470 --> 00:09:33,130
عندما نروّض حيواناً، علينا مُراقبته عن كثب

161
00:09:33,130 --> 00:09:34,080
،ربّما بسبب ذلك

162
00:09:34,080 --> 00:09:37,310
اكتسبتُ عادة لا شعوريّة وهي مُراقبة كلّ شيء حولي

163
00:09:37,310 --> 00:09:39,390
لذا قد يكون للأمر صِلة بذلك

164
00:09:40,280 --> 00:09:42,650
إذاً ينبع هذا من مهنتك؟

165
00:09:42,650 --> 00:09:45,530
مُروِّضو الوحوش مُدهشون كالمعتاد

166
00:09:45,530 --> 00:09:47,480
أو رين على الأقلّ

167
00:09:47,910 --> 00:09:49,940
لمَ هذه النّبرة الغريبة؟

168
00:09:49,940 --> 00:09:51,820
!ستكتشفين قريباً

169
00:09:51,820 --> 00:09:53,400
!ابتسامتكما مُخيفة

170
00:09:53,710 --> 00:09:55,240
!تروقني يا فتى

171
00:09:55,240 --> 00:09:58,450
أنت من الأشخاص الّذين أصنع سلاحاً مُخصّصاً لهم

172
00:09:58,910 --> 00:10:00,120
حقّاً؟

173
00:10:00,120 --> 00:10:01,560
أليس هذا جميلاً يا رين؟

174
00:10:01,560 --> 00:10:02,120
أجل

175
00:10:02,120 --> 00:10:04,480
!سلاح نخب أوّل لرجل نخب أوّل

176
00:10:04,480 --> 00:10:06,220
!ليُمهّد ذلك لمُغامرات أعظم حتّى

177
00:10:06,220 --> 00:10:06,960
!مُذهل للغاية

178
00:10:06,960 --> 00:10:09,550
!وحالما تحصل على سيفك، لنذهب ونقتل شيئاً

179
00:10:08,610 --> 00:10:11,420
...لكن ثمّة مشكلة واحدة وصغيرة

180
00:10:09,550 --> 00:10:10,300
!فكرة سديدة

181
00:10:10,300 --> 00:10:11,420
!موافقة

182
00:10:12,380 --> 00:10:15,090
لا أملك أيّ مادّة

183
00:10:20,260 --> 00:10:22,830
إنّه مزدحم أكثر من المعتاد

184
00:10:22,830 --> 00:10:25,530
ويبدون جميعهم مُتحمّسين جدّاً

185
00:10:26,660 --> 00:10:27,980
!ناتالي

186
00:10:27,980 --> 00:10:30,190
!كانادي! طاب يومك

187
00:10:30,190 --> 00:10:31,420
!طاب يومك

188
00:10:31,420 --> 00:10:34,520
لمَ الجميع مُتحمّسون اليوم؟

189
00:10:34,520 --> 00:10:36,220
...في الحقيقة

190
00:10:36,220 --> 00:10:38,720
،البطل، والّذي يقيم في هورايزن حاليّاً

191
00:10:38,720 --> 00:10:41,370
يجنّد أعضاء داعمين للفريق

192
00:10:41,370 --> 00:10:43,620
ما زالوا هنا، أليس كذلك؟

193
00:10:43,620 --> 00:10:45,080
،حتّى لو انحصر تواجدك في الدّعم

194
00:10:45,080 --> 00:10:47,000
أن تكون جزءاً من الفريق الّذي
يهزم ملك الشّياطين

195
00:10:47,000 --> 00:10:48,810
،يعني أن تكسب الشّهرة والثّروة

196
00:10:48,810 --> 00:10:51,190
!لذا جميعهم مُتحمّسون جدّاً لذلك

197
00:10:54,080 --> 00:10:55,140
!رين

198
00:11:02,720 --> 00:11:04,110
!ألم أخبركما؟

199
00:11:04,110 --> 00:11:05,180
أنا بخير الآن

200
00:11:06,280 --> 00:11:07,510
...حسناً

201
00:11:11,100 --> 00:11:14,010
بالمناسبة، من هاتان الفتاتان؟

202
00:11:14,010 --> 00:11:15,560
طـ-طاب يومكِ

203
00:11:15,560 --> 00:11:17,710
اسمي سورا

204
00:11:17,710 --> 00:11:19,020
!وأنا رونا

205
00:11:19,020 --> 00:11:20,780
أقبل بكِ من معارفي

206
00:11:21,200 --> 00:11:23,120
اسمي ناتالي

207
00:11:23,470 --> 00:11:25,290
هل أنتما صديقتا رين؟

208
00:11:25,290 --> 00:11:25,930
...في الواقع

209
00:11:25,930 --> 00:11:28,620
!لا، علاقتنا تتعدّى الصّداقة

210
00:11:28,620 --> 00:11:32,290
!إنّها أعمق بكثير، علاقة أكثر حميميّة

211
00:11:33,160 --> 00:11:35,250
!رين! تبنّيت فتيات أكثر جمالاً؟

212
00:11:35,250 --> 00:11:37,280
...وصغيرتان فوق ذلك

213
00:11:37,280 --> 00:11:41,240
!نـ-ناتالي، لا تفهمي الأمر بشكل خاطئ

214
00:11:41,240 --> 00:11:43,480
!البشر طريفون للغاية

215
00:11:41,630 --> 00:11:44,040
!ناتالي

216
00:11:43,480 --> 00:11:44,760
!رونا

217
00:11:44,760 --> 00:11:48,850
ا-المقصد، أودّ التكفُّل بهذا العمل اليوم

218
00:11:48,850 --> 00:11:50,670
دعني أرى

219
00:11:50,670 --> 00:11:53,060
...طلب رسميّ

220
00:11:53,400 --> 00:11:56,760
"جِد معدن الميثريل الخاما لحدّاد الأسلحة غانتز"

221
00:11:56,760 --> 00:11:59,670
وعنونَه باسمِك بشكل خاص يا رين؟

222
00:12:01,140 --> 00:12:05,920
لصنع أسلحة خاصّة، أحتاج معدناً خامّاً يُدعى ميثريل

223
00:12:05,920 --> 00:12:06,870
ميثريل؟

224
00:12:06,870 --> 00:12:07,770
أجل

225
00:12:07,770 --> 00:12:11,710
قيل بأنّ الأسلحة المصنوعة من ميثريل
!ممتازة جدّاً لدرجة أنّها تدوم للأبد

226
00:12:12,170 --> 00:12:14,170
رغم أنّه شديد النّدرة

227
00:12:15,140 --> 00:12:19,850
،لحسن الحظّ، تركَ لي سلَفي منجمَ ميثريل

228
00:12:19,850 --> 00:12:21,960
لذا لم ينقصني من قبل

229
00:12:21,960 --> 00:12:23,260
!رجل ثريّ

230
00:12:23,530 --> 00:12:28,680
لكن مؤخّراً، لم أعد أجد ولا حتّى ذرّة من الميثريل فيه

231
00:12:28,680 --> 00:12:30,920
تقصد بأنّك استخرجته كلّه؟

232
00:12:30,920 --> 00:12:33,020
لا، يبدو هذا غير مُرجَّح

233
00:12:33,020 --> 00:12:36,980
،لو كان يستهلك من الوريد فحسب
لكان الانحسار تدريجيّاً

234
00:12:37,360 --> 00:12:39,770
ما كان ليختفي فجأة فحسب

235
00:12:40,880 --> 00:12:42,600
!هكذا إذاأً

236
00:12:42,600 --> 00:12:46,840
أعتقد بأنّ شيئاً حدث للمنجم

237
00:12:47,320 --> 00:12:51,410
لا أستطيع صنع أسلحتي ذات الجودة
العالية دون معدن الميثريل

238
00:12:52,280 --> 00:12:53,870
أنا آسف

239
00:12:54,900 --> 00:12:58,250
لمَ لا تكون صادقاً بما تفكّر فيه الآن يا قائد؟

240
00:12:58,870 --> 00:13:00,340
!هذا واضح في جبينك

241
00:13:00,680 --> 00:13:02,800
ما تريد فعله جليّ تماماً

242
00:13:03,280 --> 00:13:05,530
!سنبقى معك، لذا افعلها فحسب

243
00:13:05,530 --> 00:13:08,470
لا أحد سيعترض على مُرافقتك

244
00:13:13,760 --> 00:13:14,980
شكراً

245
00:13:15,280 --> 00:13:16,690
لمَ كلّ هذا التّهامس؟

246
00:13:16,690 --> 00:13:20,730
هلّا سمحت لنا بالتحرّي عن مُشكلة المنجم لأجلك؟

247
00:13:20,730 --> 00:13:21,900
ماذا؟

248
00:13:21,900 --> 00:13:25,310
،إذا كان هناك سبب أعمق وراء اختفاء الميثريل

249
00:13:25,310 --> 00:13:27,510
فقد نتمكّن من اكتشاف ماهيّته

250
00:13:28,500 --> 00:13:31,870
لكن لا أحد يعلم ما قد يحدث هناك

251
00:13:32,220 --> 00:13:35,450
لا تقلق. نحن مُغامرون، أنسيت؟

252
00:13:35,450 --> 00:13:36,080
ما رأيك؟

253
00:13:39,500 --> 00:13:42,460
ربّما هذا ما شاءه القدر

254
00:13:43,200 --> 00:13:45,420
سأوظّفكم إذاً

255
00:13:45,690 --> 00:13:46,820
!شكراً

256
00:13:47,400 --> 00:13:48,640
أنا رين شراود

257
00:13:48,640 --> 00:13:51,100
وأنا غانتز ستولوف

258
00:13:51,400 --> 00:13:53,540
سررتُ بالحصول على مساعدتك يا رين

259
00:13:54,060 --> 00:13:59,950
كم تريد من الذّهب بالمقابل؟

260
00:14:01,000 --> 00:14:01,860
...في الواقع

261
00:14:02,250 --> 00:14:03,980
أريد سلاحاً من صنعك

262
00:14:08,200 --> 00:14:11,320
تريد سلاحي أكثر من مال؟

263
00:14:12,150 --> 00:14:13,690
وهل هذا أمر سيّئ؟

264
00:14:15,320 --> 00:14:16,750
...لا

265
00:14:17,640 --> 00:14:19,860
!إنّها أفضل إجابة يمكنني أن أحلم بها

266
00:14:21,890 --> 00:14:25,560
،ظننتُ أنّ غانتز مجرّد عجوز نَكِد

267
00:14:25,560 --> 00:14:27,760
!لكنّه يهتمّ حقّاً بالأسلحة

268
00:14:27,760 --> 00:14:28,800
أجل

269
00:14:28,800 --> 00:14:31,920
،وقال بأنّه سيصنع لي سلاحاً خاصّاً

270
00:14:31,920 --> 00:14:34,140
!لذا لنحرص على إنجاح هذا العمل

271
00:14:34,140 --> 00:14:36,100
!أجل

272
00:14:40,560 --> 00:14:42,910
المنجم أقرب ممّا توقّعت

273
00:14:42,910 --> 00:14:45,030
لذا ليس علينا أخذ الكثير من الأغراض

274
00:14:45,030 --> 00:14:46,110
!أجل، أجل

275
00:14:46,110 --> 00:14:49,230
!هذا ممتع جدّاً! أقرب إلى نزهة منه إلى مغامرة

276
00:14:49,230 --> 00:14:50,440
!أجل

277
00:14:50,440 --> 00:14:51,340
...لكن

278
00:14:52,120 --> 00:14:54,200
يبدو أنّ سورا ورونا تُعانيان

279
00:14:54,850 --> 00:14:56,250
لـ-لا تقلق بشأني

280
00:14:56,250 --> 00:14:59,450
يمكنني بسهولة... تولّي هذا الأمر

281
00:14:59,450 --> 00:15:02,090
كفّي عن التّظاهُر يا أختي

282
00:15:02,600 --> 00:15:04,920
!أنا على وشك أن يُغمى عليّ هنا

283
00:15:06,600 --> 00:15:08,130
!هل أنتما بخير؟

284
00:15:09,090 --> 00:15:10,910
آسفة يا رين

285
00:15:10,910 --> 00:15:15,040
رغم السّحر القويّ الّذي نمتلكه نحن
الجنّيات، نفتقر للّياقة

286
00:15:15,040 --> 00:15:17,260
لهذا أرهِقتُما

287
00:15:17,260 --> 00:15:19,600
!أجل، إنّه يوم حارّ بالفعل

288
00:15:20,370 --> 00:15:21,310
!فهمت

289
00:15:21,850 --> 00:15:23,610
...أنا واثق بأنّنا قريبون من

290
00:15:25,380 --> 00:15:26,820
!بُحيرة

291
00:15:26,820 --> 00:15:29,080
!إنّها جميلة

292
00:15:29,080 --> 00:15:30,330
!وباردة

293
00:15:30,330 --> 00:15:32,040
اكتشاف ممتاز يا رين

294
00:15:32,040 --> 00:15:33,820
رأيتُها في خريطة الطريق إلى المنجم

295
00:15:33,820 --> 00:15:36,040
ارتأيتُ بأنّها قد تكون مكاناً جيّداً لاستراحة

296
00:15:36,040 --> 00:15:39,310
إذاً ما رأيك أن نسبح يا رين؟

297
00:15:39,310 --> 00:15:40,940
!يا لها من فكرة حسنة

298
00:15:40,940 --> 00:15:42,140
!يبدو هذا مُنعشاً للغاية

299
00:15:42,140 --> 00:15:42,910
!تماماً

300
00:15:42,910 --> 00:15:44,200
أيمكننا ذلك يا رين؟

301
00:15:44,200 --> 00:15:45,630
رين؟

302
00:15:46,170 --> 00:15:48,860
...حسناً، من المهمّ أخذ قسط من الرّاحة

303
00:15:48,860 --> 00:15:51,090
حسناً. لنصفِّ أذهاننا

304
00:15:51,090 --> 00:15:52,940
!مرحى

305
00:15:52,940 --> 00:15:55,510
—إذاً سأذهب وأتفقّد الأمتعة و

306
00:15:55,510 --> 00:15:57,100
!انتظري يا كانادي

307
00:15:57,100 --> 00:15:59,060
!لا تنسي بأنّ رين ما زال هنا

308
00:16:00,020 --> 00:16:01,520
!آسفة يا رين

309
00:16:00,520 --> 00:16:01,890
استمتعن

310
00:16:02,900 --> 00:16:03,850
بئساً

311
00:16:04,250 --> 00:16:07,180
لماذا كانادي لا تُبالي لأيّ شيء؟

312
00:16:08,370 --> 00:16:09,070
هذا صحيح

313
00:16:11,900 --> 00:16:15,000
هلّا أخبرتُماني إذا تعرّضت الفتيات لأيّ خطر؟

314
00:16:17,720 --> 00:16:20,370
والآن سآخذ قسطاً من الرّاحة أيضاً

315
00:16:26,290 --> 00:16:28,250
!هذا بارد ولطيف

316
00:16:28,680 --> 00:16:29,710
أليس كذلك يا تانيا؟

317
00:16:30,010 --> 00:16:32,670
بالفعل، إنّه شعور جميل

318
00:16:33,600 --> 00:16:35,180
هل من مشكلة؟

319
00:16:35,180 --> 00:16:38,140
...في الواقع، أنا ببساطة

320
00:16:38,140 --> 00:16:41,310
كلتاكما لديكما... صدر ضخم

321
00:16:41,310 --> 00:16:42,460
حقّاً؟

322
00:16:42,460 --> 00:16:44,270
!أجل، يا لها من أثداء

323
00:16:44,640 --> 00:16:46,360
...بينما نحن

324
00:16:47,000 --> 00:16:48,480
ما الّذي أدّى إلى هذا الاختلاف؟

325
00:16:48,480 --> 00:16:50,940
!علّميني كيف أجعلهما أكبر

326
00:16:50,940 --> 00:16:52,320
!أتوسّل إليكِ

327
00:16:52,320 --> 00:16:54,350
!ستكبرين وتنمين مع الوقت

328
00:16:54,350 --> 00:16:55,960
!أجل! أو لا

329
00:16:57,130 --> 00:16:58,920
!تانيا

330
00:16:59,370 --> 00:17:02,140
!رونا! اكبحي جِماح نفسكِ

331
00:17:02,140 --> 00:17:03,780
!ستُغرقين نفسكِ في الحزن أكثر فأكثر

332
00:17:06,920 --> 00:17:09,200
!رونا

333
00:17:10,870 --> 00:17:12,560
!لا تنسيني

334
00:17:17,390 --> 00:17:18,550
!كانادي؟

335
00:17:19,010 --> 00:17:21,350
...لا استجابة من الحيوانات

336
00:17:22,870 --> 00:17:24,630
ماذا يجري في البُحيرة؟

337
00:17:28,850 --> 00:17:30,170
!كانادي! الجميع

338
00:17:30,170 --> 00:17:31,020
—هل أنتنّ بخـ

339
00:17:34,990 --> 00:17:35,950
ماذا؟

340
00:17:46,000 --> 00:17:47,170
!آ-آسف

341
00:17:54,550 --> 00:17:56,090
أنا آسف حقّاً

342
00:17:56,090 --> 00:17:58,720
لم أقصد رؤية شيء حقّاً

343
00:17:58,720 --> 00:18:01,320
!تمالكي نفسكِ يا أختي! الأمر ليس بذلك السّوء

344
00:18:01,320 --> 00:18:03,840
...تعرّيي... تعرّيي

345
00:18:02,210 --> 00:18:04,470
تبدو مُستاءة جدّاً

346
00:18:04,960 --> 00:18:06,310
أنا آسف حقّاً

347
00:18:06,860 --> 00:18:08,890
!سأفعل أيّ شيء لأكسب غفرانكن

348
00:18:10,610 --> 00:18:12,490
أتقول أيّ شيء؟

349
00:18:12,490 --> 00:18:14,040
لا مُفاوضات؟

350
00:18:14,040 --> 00:18:15,490
...أ-أجل

351
00:18:15,490 --> 00:18:17,320
...في هذه الحالة

352
00:18:18,660 --> 00:18:20,490
تصرّف كما تتصرّف في العادة فحسب

353
00:18:21,590 --> 00:18:24,490
...لـ-لا أنكر أنّه من المُحرج أن نُرَى بهذا الشّكل

354
00:18:24,490 --> 00:18:27,460
لكن أتيتَ مُسرِعاً لأنّك سمعتني أصرخ، صحيح؟

355
00:18:27,460 --> 00:18:29,660
لذا من الواضح أنّ الذنب ليس ذنبك

356
00:18:29,660 --> 00:18:32,140
تُؤرقني أكثر فكرة أنّ هذا يجعل
الأمور غير مُريحة بيننا

357
00:18:32,140 --> 00:18:32,920
!أجل، أجل

358
00:18:32,920 --> 00:18:35,420
!لا أمانع هذا البتّة

359
00:18:35,420 --> 00:18:38,380
!قد أشعر بالإحراج، لكن يجب ألّا تدع هذا يُزعجك

360
00:18:38,760 --> 00:18:42,090
أفضّل أن تكون الأجواء مُريحة بين أعضاء فريقنا

361
00:18:43,930 --> 00:18:45,600
!شكراً للجميع

362
00:18:45,600 --> 00:18:46,880
!وجدتُها

363
00:18:46,880 --> 00:18:49,270
لمَ لا تسبح أيضاً يا رين؟

364
00:18:50,200 --> 00:18:52,080
!إنّه بارد ولطيف

365
00:18:52,080 --> 00:18:54,910
!وقد نُشبِع أنظارنا

366
00:18:54,910 --> 00:18:57,490
...ر-رين... عارٍ

367
00:18:57,880 --> 00:18:59,770
أظنّني سأرفض

368
00:19:00,960 --> 00:19:04,970
،بالرّغم من التّلهية البسيطة، سارت الأمور كما هو مُخطَّط

369
00:19:04,970 --> 00:19:07,720
ووصلنا إلى منجم الميثريل

370
00:19:09,710 --> 00:19:12,590
رين. ألن ندخل؟

371
00:19:12,590 --> 00:19:16,960
أتتذكّرنَ ما قلتُه بشأن غرابة اختفاء الميثريل المُفاجئ؟

372
00:19:18,120 --> 00:19:19,970
...السّبب الأرجح هو

373
00:19:19,970 --> 00:19:21,310
سرِقة

374
00:19:22,160 --> 00:19:24,330
لهذا نراقب المدخل؟

375
00:19:24,330 --> 00:19:27,770
!أجل، من المؤكّد أنّ اللّصوص في الدّاخل الآن

376
00:19:28,190 --> 00:19:30,410
هذا ما أرجّحه

377
00:19:32,710 --> 00:19:34,420
...الطريقة التي يتحرّك بها الطائر

378
00:19:36,610 --> 00:19:37,580
!مهلاً

379
00:19:38,000 --> 00:19:39,280
!لنُخفض أصواتنا

380
00:19:39,610 --> 00:19:40,800
ماذا كان ذلك؟

381
00:19:40,800 --> 00:19:42,120
هل من أحد هناك؟

382
00:19:42,120 --> 00:19:42,920
...رين

383
00:19:42,920 --> 00:19:43,950
!اكشفوا عن أنفسكم

384
00:19:44,600 --> 00:19:45,740
سوف نقاتلهم

385
00:19:46,060 --> 00:19:47,690
،لكن أريد أن أسألهم بعد ذلك

386
00:19:47,690 --> 00:19:49,440
لذا لا تستخدمن العنف ضدّهم

387
00:19:49,440 --> 00:19:50,290
!عُلِم

388
00:19:52,710 --> 00:19:55,990
...أنا متأكّد بأنّني طلبتُ منكم عدم اللّجوء للعنف

389
00:19:56,640 --> 00:19:58,120
!لـ- لم أفعل

390
00:19:58,120 --> 00:20:01,180
!الرّجل هو من ضرب نفسه بقبضتي

391
00:20:01,180 --> 00:20:01,880
...يا إلهي

392
00:20:02,440 --> 00:20:04,430
لا أستطيع الحصول على أيّ معلومة منهم الآن

393
00:20:04,430 --> 00:20:05,130
...المعذرة

394
00:20:05,600 --> 00:20:09,180
هل تريدنا أن نستخدم سحرنا للدخول إلى ذاكرته؟

395
00:20:09,970 --> 00:20:11,560
!يـ-يمكنكما فعل ذلك؟

396
00:20:11,560 --> 00:20:12,250
أجل

397
00:20:12,250 --> 00:20:15,290
لدى الجنّيات سحر خاصّ

398
00:20:15,290 --> 00:20:16,980
!أجل، لدينا هذا

399
00:20:18,750 --> 00:20:20,250
لنتابع

400
00:20:23,000 --> 00:20:24,950
البحث في الذّاكرة

401
00:20:40,180 --> 00:20:42,200
كان تخمين رين صحيحاً

402
00:20:42,800 --> 00:20:45,760
أرى الرّجال يسرقون المعدن

403
00:20:46,170 --> 00:20:48,400
...الاثنان اللّذان قضينا عليهما للتو

404
00:20:48,400 --> 00:20:49,470
وخمسة آخرون

405
00:20:50,080 --> 00:20:52,460
يبدو أنّهم مجموعة من المُغامرين

406
00:20:52,460 --> 00:20:55,060
إذاً السّرقة هي سبب اختفاء الوريد

407
00:20:55,440 --> 00:20:57,720
...وهم مُغامرون أمثالنا

408
00:20:57,720 --> 00:20:58,710
...المعذرة

409
00:20:59,560 --> 00:21:02,740
هل كنّا مُفيدتين لك؟

410
00:21:02,740 --> 00:21:04,780
!أجل، بالتأكيد

411
00:21:04,780 --> 00:21:06,040
!شكراً لكما

412
00:21:06,040 --> 00:21:07,200
...فـ-في هذه الحالة

413
00:21:07,200 --> 00:21:09,930
!اربت على رأسنا

414
00:21:11,150 --> 00:21:12,620
ر-ربت على الرأس؟

415
00:21:12,620 --> 00:21:17,450
شهِدَتْ كانادي وتانيا على الشّعور الجميل
الّذي يراودهما عند الرّبت على رأسهما

416
00:21:17,450 --> 00:21:20,750
!لا نريد أن نفوّت هذا الشّعور

417
00:21:20,750 --> 00:21:23,460
...أظنّ أنّ أملكما سيخيب، لكن

418
00:21:23,460 --> 00:21:24,970
ها أنا ذا

419
00:21:25,430 --> 00:21:27,420
أحسنتُما صنعاً

420
00:21:29,390 --> 00:21:30,750
!هذا شعور رائع

421
00:21:30,750 --> 00:21:32,510
!ويملؤني بالسّرور لسبب ما

422
00:21:32,510 --> 00:21:34,170
!قلبي يخفق

423
00:21:34,170 --> 00:21:35,680
حـ-حقّاً؟

424
00:21:36,440 --> 00:21:38,690
حسناً، لنستعدّ

425
00:21:39,210 --> 00:21:41,150
سوف ندخل المنجم الآن

426
00:21:41,150 --> 00:21:44,400
لكن ينبغي أن نفترض بأنّهم يعلمون بوجودنا هنا

427
00:21:44,400 --> 00:21:45,500
بالفعل

428
00:21:45,500 --> 00:21:47,360
لكن كيف علِموا بأنّنا هنا؟

429
00:21:48,180 --> 00:21:51,060
كان العدوّ يُراقبنا من الأعلى

430
00:21:53,010 --> 00:21:55,880
...الحركات المشبوهة لذلك الطائر قبل قليل

431
00:21:57,600 --> 00:21:58,880
...غالباً

432
00:22:00,070 --> 00:22:02,410
هناك مُروِّض وحوش بينهم

433
00:23:36,500 --> 00:23:40,060
!"الحلقة القادمة: "مُروّض وحوش ضدّ مُروّض وحوش