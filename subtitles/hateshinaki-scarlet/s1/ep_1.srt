619
01:00:38,720 --> 01:00:44,060
♪ ،أَريني كُلّ ما يُمكن للحُبّ أن يكون ♪

620
01:00:44,180 --> 01:00:47,940
♪ ،لا بُدّ مِن مفتاحٍ لأسرارٍ غير مَرئية ♪

621
01:00:48,060 --> 01:00:49,770
♪ ،لحقيقةٍ مَخبوءة ♪

622
01:00:49,900 --> 01:00:53,650
♪ ...يُراودني شعورٌ بأنّ الإجابة هِي أنتِ ♪

623
01:00:53,770 --> 01:00:55,230
!هِيجيري

624
01:01:02,780 --> 01:01:04,620
♪ ،دروبٌ لا تُحصى تَتقاطع ♪

625
01:01:04,740 --> 01:01:08,370
،وزَمنٌ لا يَنتهي يَنساب ♪
♪ .يا لسُخف القَدر

626
01:01:10,580 --> 01:01:12,380
♪ ،في السّاعة المَوعودة ♪

627
01:01:12,500 --> 01:01:15,380
♪ ...سأَلتفتُ وأَجدكِ ♪

628
01:01:15,500 --> 01:01:17,590
!هذه... أنا

629
01:01:17,710 --> 01:01:21,590
♪ ،يَتحوّل العَالم إلى ضياءٍ مُتلألئ ♪

630
01:01:21,720 --> 01:01:24,640
♪ ،كُلّ شيءٍ يغدو جديدًا ♪

631
01:01:24,760 --> 01:01:28,140
♪ ...بعد أن أَيقظتني ♪

632
01:01:28,600 --> 01:01:30,890
!نسخةٌ أُخرى... عنّي

633
01:01:31,020 --> 01:01:36,360
،تلك الرّياح والأَمطار ♪
♪ .وأقواسُ قُزحٍ البَعيدة

634
01:01:36,480 --> 01:01:40,610
♪ ،تَستحيلُ لحنًا بينما نُغنّي معًا ♪

635
01:01:40,740 --> 01:01:46,660
♪ ،لم أَكُن أعلم قطّ كم هُو جميلٌ ♪

636
01:01:46,790 --> 01:01:50,540
♪ ،أَزهري كما أنتِ ♪

637
01:01:50,710 --> 01:01:54,420
♪ ،يا قلبي ♪

638
01:01:54,540 --> 01:01:58,010
♪ ،لا شيء ♪

639
01:01:58,130 --> 01:02:02,510
♪ ...بمَقدوره إيقافي الآن ♪

640
01:02:05,890 --> 01:02:11,190
،عَلّميني عن الحُبّ ♪
♪ .أَرجوكِ دَعيني أَعرف

641
01:02:11,310 --> 01:02:17,020
،تلك المُعجزة الّتي تَقبعُ في داخلكِ ♪
♪ .ونَراها جميعًا

642
01:02:17,150 --> 01:02:21,200
♪ أَلا تُلوّنين قلبي اليوم؟ ♪

643
01:02:21,320 --> 01:02:26,740
،أَريني الحُبّ بأَسره ♪
♪ .أَرجوكِ مرّةً أُخرى

644
01:02:26,870 --> 01:02:30,370
♪ ،مرّةً أُخرى، أَريني سبب الحياة ♪

645
01:02:30,500 --> 01:02:32,330
♪ ،قبل أن تَنسى رُوحي ♪

646
01:02:32,500 --> 01:02:36,750
♪ ،تلك الأصوات الّتي تَهتفُ باسمي ♪

647
01:02:36,880 --> 01:02:42,380
،عَلّميني عن الحُبّ ♪
♪ .أَرجوكِ دَعيني أَعرف

648
01:02:42,510 --> 01:02:48,310
،تلك المُعجزة الّتي تَقبعُ في داخلكِ ♪
♪ .ونَراها جميعًا

649
01:03:12,660 --> 01:03:15,290
.فَقدتِ وعيكِ فجأةً

650
01:03:16,630 --> 01:03:17,790
...رَأيته

651
01:03:17,920 --> 01:03:20,420
.العَصر الّذي تَعيش فيه -
ماذا؟ -

652
01:03:20,550 --> 01:03:22,970
...سافرتُ عبر الزّمن

653
01:03:26,510 --> 01:03:28,010
...وبعدها

654
01:03:28,140 --> 01:03:30,310
...هِيجيري، أنت رقصتَ

655
01:03:30,430 --> 01:03:31,470
...ببراعةٍ فَائقة

656
01:03:33,480 --> 01:03:34,940
.رُبّما أنّ ذلك ليس أنا

657
01:03:35,310 --> 01:03:38,900
.كلا، بل أنتَ مَن أَخذ بيدي

658
01:03:39,020 --> 01:03:41,780
...كُنت في غاية السّعادة

659
01:03:44,780 --> 01:03:48,240
،لو أنّي ولدتُ في عَصرٍ مُختلف

660
01:03:48,950 --> 01:03:51,660
هل كان بمَقدوري أن أَكون
شخصًا آخر؟

661
01:03:52,950 --> 01:03:56,750
...هل كان بمَقدوري تجنّب الاستسلام

662
01:03:56,920 --> 01:04:01,670
لكُلّ هذا العَناء والإحباط؟

663
01:04:02,800 --> 01:04:05,090
.سكارليت، لا تَبكي

664
01:04:05,220 --> 01:04:06,430
.أنا هُنا بجانبكِ

665
01:04:06,970 --> 01:04:10,600
.لم تَعودي بحاجةٍ للبُكاء بعد الآن

666
01:05:46,530 --> 01:05:47,650
.مرحبًا

667
01:05:49,150 --> 01:05:50,820
هل أنتِ أميرةٌ؟

668
01:05:53,200 --> 01:05:54,280
.كلا

669
01:05:54,410 --> 01:05:57,240
،أنتِ جميلةٌ للغاية
...كُنت واثقةً

670
01:05:59,500 --> 01:06:02,880
.أَتمنّى لو ولدتُ أميرةً

671
01:06:03,040 --> 01:06:05,420
أُراهن أنّكّ تتمنّين ذلك
أيضًا، أَليس كذلك؟

672
01:06:07,920 --> 01:06:11,630
لو كُنت أميرةً، فثمّة رغبةٌ
.واحدة أودّ تَحقيقها

673
01:06:12,220 --> 01:06:13,050
ما هِي؟

674
01:06:13,180 --> 01:06:16,390
أودّ أن أجعل العَالم مكانًا
.لا يُضطرّ فيه الأطفال مثلي إلى الموت

675
01:06:25,610 --> 01:06:26,730
...أجل

676
01:06:39,450 --> 01:06:40,950
...الأرض السّرمدية

677
01:06:41,290 --> 01:06:46,130
مكانها يَقع فوق قمّة
!الجبال المُقدّسة

678
01:06:46,290 --> 01:06:50,590
الأقوياء وحدهم هُم مَن
!يستحقّون دُخولها، اسمعوا

679
01:06:50,710 --> 01:06:55,220
!لا تَسمحوا لأَحدٍ بتدنيس أَرجائها

680
01:07:02,560 --> 01:07:05,520
اترك مُهمّة العُثور على
...الأميرة لي، جِيلدنستيرن

681
01:07:05,650 --> 01:07:08,070
!ولي أنا، رُوزنكرانتز...

682
01:07:09,730 --> 01:07:11,780
.ونَمضي إلى الأرض السّرمدية...

683
01:07:13,950 --> 01:07:15,410
!ياهو

684
01:07:34,340 --> 01:07:37,010
!دَعونا نَعبر إلى الأرض السّرمدية

685
01:07:37,140 --> 01:07:38,890
!خُذونا إلى القمّة

686
01:07:39,010 --> 01:07:41,470
!إلى القمّة

687
01:07:41,600 --> 01:07:43,480
!حطّموا الجدار

688
01:07:43,980 --> 01:07:46,140
!تراجعوا -
!وإلّا سنُطلق النّار -

689
01:08:18,010 --> 01:08:21,310
هيّا، الأرض السّرمدية
!أمامنا مُباشرةً

690
01:08:36,400 --> 01:08:38,320
!اهزموا فُرسان كُلوديوس

691
01:08:38,450 --> 01:08:40,450
!الأرض السّرمدية ليست ملكًا لهُم

692
01:08:40,570 --> 01:08:41,830
!هجومٌ

693
01:09:52,900 --> 01:09:55,320
.أَرجوكم -
.لا تَقتلونا -

694
01:09:55,440 --> 01:09:57,990
.لا تَقلقوا -
.نحن نَبحث فحسب -

695
01:09:58,110 --> 01:10:00,610
تَبحثون؟ عمّن تَبحثون؟

696
01:10:00,740 --> 01:10:02,570
!الأميرة -
!ماذا؟ -

697
01:10:04,530 --> 01:10:06,030
هل رآها أَحدكم؟

698
01:10:06,160 --> 01:10:09,040
.شَعرُها مَضفورٌ للخلف

699
01:10:10,790 --> 01:10:12,170
!هكذا

700
01:10:12,290 --> 01:10:14,960
!توقّف -
!شَعرُها هكذا -

701
01:10:15,090 --> 01:10:15,920
...هذا يُؤلم

702
01:10:16,040 --> 01:10:18,460
!دَعها وشأنها -
!اخرسي -

703
01:10:18,590 --> 01:10:21,630
!مَن يَدلّنا على الأميرة سيَنال حُريّته

704
01:10:22,050 --> 01:10:25,930
!بل سيُرافقنا إلى الأرض السّرمدية

705
01:10:26,050 --> 01:10:27,310
!هذه أَكاذيب

706
01:10:27,430 --> 01:10:30,100
.لن أكون عبدًا لكُم أبدًا

707
01:10:30,600 --> 01:10:34,230
إذًا، تِيهُوا في العَالم
.الآخر إلى الأبد

708
01:10:34,900 --> 01:10:36,320
.لنَبحث في مكانٍ آخر

709
01:10:38,230 --> 01:10:39,900
.ماذا؟ مهلًا

710
01:10:41,610 --> 01:10:42,990
ما هذه؟

711
01:10:44,620 --> 01:10:49,240
...عملةٌ ذهبيّة مِن الدّنمارك
لماذا تَملكينها؟

712
01:10:52,000 --> 01:10:56,210
...أنتِ تعرفين شيئًا
عن الأميرة، أَليس كذلك؟

713
01:10:56,340 --> 01:10:58,050
!لا أعرف شيئًا

714
01:10:58,170 --> 01:11:00,550
،لا تُخفِي الأمر عنّي
!تَكلّمي

715
01:11:00,670 --> 01:11:02,090
...إن لم تَفعلي

716
01:11:02,220 --> 01:11:04,890
!توقّف، لا تُؤذِها

717
01:11:06,600 --> 01:11:07,720
!الأميرة؟

718
01:11:07,850 --> 01:11:09,600
!وَجدنا الأميرة

719
01:11:14,480 --> 01:11:15,850
...الأميرة

720
01:11:16,270 --> 01:11:18,070
!أيّتها الأميرة

721
01:11:18,190 --> 01:11:21,030
،أَسرعي واهربي
.ارحلوا جميعًا

722
01:11:21,150 --> 01:11:23,280
!أَمسكنا بالأميرة

723
01:11:23,400 --> 01:11:25,320
!المَلك كُلوديوس سيُثني علينا

724
01:11:25,450 --> 01:11:26,660
...وبهذا

725
01:11:26,780 --> 01:11:29,200
!سيَأخذنا إلى الأرض السّرمدية...

726
01:11:33,500 --> 01:11:35,040
!سكارليت

727
01:11:41,380 --> 01:11:44,090
مَن أنت بحقّ الجحيم؟ -
!دَعوها وشأنها -

728
01:11:47,010 --> 01:11:48,180
هل أنت عاجزٌ عن الإطلاق؟

729
01:11:49,510 --> 01:11:51,140
ما الّذي يَمنعك؟

730
01:11:51,270 --> 01:11:52,890
هل تَحمل لُعبةً في يدك؟

731
01:11:53,020 --> 01:11:55,600
رُبّما لا يَعرف الفتى
كيف يستخدم القَوس؟

732
01:11:58,980 --> 01:12:02,900
لماذا جِئت إلى هُنا؟

733
