1
00:01:19,620 --> 00:01:21,540
،في هذا المكان

2
00:01:21,660 --> 00:01:25,210
.يَقترنُ الموت والحياة

3
00:01:25,790 --> 00:01:28,630
.يَقفان جنبًا إلى جنبٍ

4
00:01:29,040 --> 00:01:31,670
.والزّمن ليس بمُختلفٍ

5
00:01:31,960 --> 00:01:34,300
،هُنا، في العَالم الآخر
...يكون المَاضي والمُستقبل

6
00:01:34,420 --> 00:01:38,390
.مَنسوجين معًا

7
00:02:00,820 --> 00:02:03,240
هل هذه هِي الجنّة...؟

8
00:04:02,070 --> 00:04:03,570
.أنتِ هُناك

9
00:04:06,410 --> 00:04:07,830
.أنتِ

10
00:04:09,330 --> 00:04:12,920
أين تَحسبين نفسكِ الآن؟

11
00:04:45,450 --> 00:04:47,530
...هذا المكان هُو

12
00:04:47,870 --> 00:04:49,370
.العَالم الآخر

13
00:04:52,040 --> 00:04:55,420
.أجل، هذا صحيحٌ، مُتّ

14
00:04:56,500 --> 00:04:59,500
...فَشلتُ في الانتقام مِن عدوّي اللّدود

15
00:04:59,630 --> 00:05:01,090
.ومُتّ

16
00:06:07,030 --> 00:06:08,360
!أَبي

17
00:06:08,490 --> 00:06:09,990
!سكارليت

18
00:06:10,490 --> 00:06:13,660
.أُمّي! عاد أَبي

19
00:06:19,710 --> 00:06:20,630
!أَبي

20
00:06:21,000 --> 00:06:23,300
!سكارليت -
!اشتقتُ إليك -

21
00:06:23,880 --> 00:06:27,630
.بفَضل دعواتكِ، عُدنا سالمين

22
00:06:30,470 --> 00:06:32,680
.انشر قُوّاتك يا أَمليث

23
00:06:32,800 --> 00:06:33,810
...كُلوديوس

24
00:06:33,930 --> 00:06:35,970
.إمّا نحن أو هُم

25
00:06:36,100 --> 00:06:38,350
.هَوّن عليك يا أَخي

26
00:06:38,890 --> 00:06:41,230
.الحَرب لا تنفعُ أيّ طرفٍ

27
00:06:41,360 --> 00:06:44,190
،سنَسعى لتَحقيق التّوازن عبر المُفاوضات

28
00:06:44,320 --> 00:06:46,360
.وبِناء الثّقة لا العَداوة

29
00:06:46,490 --> 00:06:49,280
.هذه هِي سبيلنا للبَقاء

30
00:06:50,820 --> 00:06:53,410
!إنّك أحمق

31
00:06:58,370 --> 00:07:00,710
.مَلكنا أَمليث حاكمٌ صَالح

32
00:07:00,830 --> 00:07:02,420
،يَحظى بمَحبّة شعبه

33
00:07:02,540 --> 00:07:05,630
.وثِقة الدّول المُجاورة

34
00:07:05,750 --> 00:07:08,260
سكارليت... ما هُو المُهمّ؟

35
00:07:08,380 --> 00:07:10,340
.أن نَختار الإخاء بدلًا مِن العَداء

36
00:07:11,010 --> 00:07:13,600
سأُصبح الأميرة الّتي تُريدني
!أن أَكونها

37
00:07:13,720 --> 00:07:16,560
،قبل أن تَكوني أميرةً
.أنتِ فتاةٌ صَغيرة

38
00:07:16,680 --> 00:07:18,810
.عليكِ أن تَكبُري دُون خوفٍ

39
00:07:18,930 --> 00:07:20,310
!انتهيت

40
00:07:23,060 --> 00:07:25,940
،أَبدو وسيمًا جدًا
.هذا يُسعدني

41
00:07:50,550 --> 00:07:53,390
...أُمّي، سأُصبح

42
00:07:53,510 --> 00:07:55,140
...يا لهَاتين اليَدين القَذرتين

43
00:08:07,400 --> 00:08:09,650
...زوجي يفيضُ حُبًا لابنته

44
00:08:10,240 --> 00:08:13,530
.لكنّه جبانٌ يرتدي قِناع الفَضيلة

45
00:08:13,660 --> 00:08:17,410
،زوجي يملكُ كُلّ شيءٍ
.وأنت لا تملكُ شيئًا

46
00:08:17,530 --> 00:08:19,950
أَلستما أَخوين؟ -
.بالفِعل -

47
00:08:20,080 --> 00:08:25,080
حلمتُ طويلًا بسَكب السّم
.في أُذنيه

48
00:08:25,250 --> 00:08:28,920
.لن أَدعه يجعل منّي أُضحوكةً

49
00:08:29,050 --> 00:08:30,050
.تَذكّري كلماتي جيّدًا

50
00:08:31,050 --> 00:08:34,430
.أنا مِلكٌ لمَن سيَكون مَلِكًا

51
00:08:35,470 --> 00:08:39,890
إن كان عَزمك على اعتلاء
.العَرش حقيقيًا، فأَرني ذلك

52
00:08:45,730 --> 00:08:46,980
!خَبرٌ مُفزع

53
00:08:47,110 --> 00:08:49,110
!ثمّة خونةٌ في القَصر

54
00:08:49,980 --> 00:08:52,440
!اقبضوا عليهم
!إيّاكم أن يَلوذوا بالفِرار

55
00:08:52,950 --> 00:08:55,910
!أَصغوا إليّ بإمعانٍ
!لا تَدعوهم يهربون

56
00:09:01,330 --> 00:09:02,870
.رُويدك

57
00:09:12,710 --> 00:09:13,800
.هيّا، تَقدّم

58
00:09:21,640 --> 00:09:24,060
.أَمليث، يا أخي

59
00:09:25,810 --> 00:09:30,070
هل تَتآمر مع دولةٍ مُجاورة
وتَخون وطنك؟

60
00:09:30,190 --> 00:09:32,400
يا أخي، أَلم تُدرك بعد؟

61
00:09:32,530 --> 00:09:34,610
...إنّ ظَمأك الّذي لا يَرتوي للسّلطة

62
00:09:34,740 --> 00:09:37,110
.سيُحوّلك إلى قاتلٍ

63
00:09:37,240 --> 00:09:38,450
!اصمت

64
00:09:38,570 --> 00:09:40,780
!أيّها الرّعايا المُخلصون

65
00:09:40,910 --> 00:09:43,580
!لا بُدّ مِن مُعاقبة الخائن

66
00:09:43,700 --> 00:09:45,660
،وحِينها فحسب

67
00:09:45,830 --> 00:09:49,040
،بمَشيئة الرّب
!سأَكون المَلك الجديد

68
00:09:49,170 --> 00:09:51,590
!محالٌ أن يَخوننا المَلك

69
00:09:51,710 --> 00:09:52,960
!لا بُدّ مِن وجود خطأٍ

70
00:09:59,090 --> 00:10:00,890
!أَعدموه

71
00:10:03,560 --> 00:10:05,770
!أَبي -
!سكارليت -

72
00:10:06,190 --> 00:10:07,850
!...لا يُمكن أن يكون هذا

73
00:10:09,810 --> 00:10:11,480
ما الّذي تَقوله؟

74
00:10:13,070 --> 00:10:14,990
!ماذا؟! ما الّذي تَقوله؟

75
00:10:16,740 --> 00:10:18,200
!انتظروا

76
00:10:28,250 --> 00:10:29,460
!أَبي

77
00:11:03,160 --> 00:11:05,910
.ليُبارك الرّب مَلكنا الجديد

78
00:11:08,830 --> 00:11:11,290
!المَجد للمَلك كُلوديوس

79
00:11:11,750 --> 00:11:13,040
!المَجد له

80
00:11:13,170 --> 00:11:16,210
.انشروا الجيش وأَخمدوا تمرّدهم

81
00:11:22,140 --> 00:11:24,430
!هيّا أَسرعا، تحرّكا -
.لا تَكونا بطيئين هكذا -

82
00:11:24,560 --> 00:11:27,180
يُفترض أنّ هذه الإجراءات
...لوَقف التمرّد

83
00:11:27,310 --> 00:11:31,350
.لكنّهم يُعذّبون أُناسًا لا صِلة لهُم بالأمر

84
00:12:09,270 --> 00:12:11,440
.رسالةٌ للأَميرة

85
00:12:11,730 --> 00:12:15,480
،رَعاياكِ يموتون جُوعًا

86
00:12:15,610 --> 00:12:18,690
ومع ذلك يرفضُ المَلك
.إرسال المَعونات

87
00:12:34,710 --> 00:12:39,090
،أيّتها الأميرة
...لِمَ لا تُنهين دراستكِ في فيتنبرغ

88
00:12:39,210 --> 00:12:42,760
.وتُمتّعي أنظارنا بجمالكِ البَديع

89
00:13:18,500 --> 00:13:19,750
.أيّتها الأميرة

90
00:14:26,110 --> 00:14:29,950
أَلم تَضعي في حُسبانكِ احتمال
أن تَكوني مسمومةً؟

91
00:14:30,070 --> 00:14:32,200
.إنّك ساذجةٌ كطفلٍ رَضيع

92
00:14:35,250 --> 00:14:36,160
!ستَدفع الثّمن

93
00:14:36,960 --> 00:14:38,670
!تذكّر كلماتي جيّدًا

94
00:14:44,590 --> 00:14:45,800
أيّتها الأميرة؟

95
00:14:45,920 --> 00:14:48,050
!لا يُعقل
أيّتها الأميرة؟

96
00:14:48,760 --> 00:14:51,180
ماذا عَسانا نفعل؟
!أيّتها الأميرة

97
00:15:14,030 --> 00:15:16,500
،إن كانت هذه هِي الحياة الآخرة

98
00:15:16,620 --> 00:15:19,080
فهَل سأَلتقي بأَبي مُجدّدًا؟

99
00:15:19,250 --> 00:15:21,120
.لن تَفعلي

100
00:15:22,330 --> 00:15:24,380
مَن أنتِ؟

101
00:15:24,500 --> 00:15:27,510
.أصبح والدكِ عَدمًا بالفِعل

102
00:15:27,630 --> 00:15:28,590
عَدمًا؟

103
00:15:28,720 --> 00:15:32,390
،ستَلقين مَصيرهُ نفسه
.إن كُنتِ ضعيفةً

104
00:15:35,890 --> 00:15:39,230
لم تكُن حياتي سِوى سلسلةٍ
.مِن النّدم

105
00:15:39,350 --> 00:15:42,190
.أُريد التّلاشي في هذه اللّحظة

106
00:15:42,900 --> 00:15:45,520
.عِشتُ حياةً بلا معنى

107
00:15:45,650 --> 00:15:47,610
...العمّ كُلوديوس لا يزال حيًا

108
00:15:47,730 --> 00:15:49,780
.ولن يُؤخذ بثَأر أَبي

109
00:15:50,200 --> 00:15:51,360
.تمهّلي

110
00:15:51,990 --> 00:15:54,700
.كُلوديوس هُنا، في العَالم الآخر -
ماذا؟ -

111
00:15:54,830 --> 00:15:58,660
،لم يُصبح عدمًا بعد
.إنّه في مكانٍ ما... يَضحك

112
00:16:45,580 --> 00:16:46,920
...أُقسم

113
00:16:47,040 --> 00:16:48,170
،أنّي سأَعثر عليه

114
00:16:48,630 --> 00:16:50,170
!وأَنتقم لأَبي

115
00:16:53,430 --> 00:16:56,390
.يا لحَماقة البَشر

116
00:16:57,220 --> 00:16:59,520
.أنت تَتوشّح شِعار إلسينور

117
00:17:00,180 --> 00:17:01,890
أين كُلوديوس؟

118
00:17:02,020 --> 00:17:03,390
!لا تَقتليني

119
00:17:03,890 --> 00:17:05,900
!أين هُو؟ -
!لا أُريد الموت -

120
00:17:06,020 --> 00:17:08,400
،ماتوا بالفِعل

121
00:17:08,520 --> 00:17:10,650
إلّا أنّهم لا يَزالون يَرغبون
.في الحياة

122
00:17:10,780 --> 00:17:13,780
!أرجوكِ، انتظري فضلًا -
ماذا؟ -

123
00:17:13,900 --> 00:17:16,200
.نحن حُلفاؤكِ يا صاحبة السّمو

124
00:17:17,070 --> 00:17:18,120
ماذا؟

125
00:17:18,240 --> 00:17:20,870
.يُمكنكِ الاطمئنان واتّباعنا

126
00:17:22,080 --> 00:17:24,410
...إنّ رغبتهم في الكَراهية

127
00:17:24,580 --> 00:17:28,250
وقَتل بعضهم البعض لا تزالُ
.طاغيةً، حتّى في العَالم الآخر

128
00:17:28,380 --> 00:17:30,630
هل كُلوديوس هُنا حقًا؟

129
00:17:32,380 --> 00:17:33,880
!تبًا لهؤلاء الحُلفاء

130
00:17:34,010 --> 00:17:35,680
...أميرةٌ رَثّة

131
00:17:37,640 --> 00:17:39,390
!لا تَستحق الخَلاص...

132
00:17:40,180 --> 00:17:41,640
!اقبضوا عليها

133
00:17:47,940 --> 00:17:49,730
!يُمكنني الآن دُخول الأرض السّرمدية

134
00:17:50,480 --> 00:17:53,860
.إنّها مصمّمةٌ على الانتقام

135
00:17:53,990 --> 00:17:57,240
.يا لضَعفكِ... أيّتها المرأة

136
00:18:01,290 --> 00:18:02,870
!مـ-ما هذا؟

137
00:18:05,040 --> 00:18:07,500
!اختفت؟
!ابحثوا عنها

138
00:18:07,960 --> 00:18:09,250
.انظروا

139
00:18:09,380 --> 00:18:13,630
!انظروا إليها وهِي تنبض بالحَيويّة

140
00:18:13,760 --> 00:18:17,300
!وكأنّها لا تزالُ في أرض الأَحياء

141
00:18:17,430 --> 00:18:19,640
!إذن، ما مَعنى أن تكون بشرًا؟

142
00:18:19,760 --> 00:18:20,930
!ما هُو الموت؟

143
00:18:21,050 --> 00:18:23,930
!وما هِي الحياة؟

144
00:18:32,150 --> 00:18:33,360
...آه

145
00:18:34,820 --> 00:18:36,200
...لا أَستطيع فِعل هذا

146
00:18:38,360 --> 00:18:44,950
،عَلّميني عن الحُبّ ♪
♪ .أَرجوكِ دَعيني أَعرف

147
00:18:46,000 --> 00:18:51,340
♪ ،تلك المُعجزة الّتي تَقبعُ في داخلكِ ♪

148
00:18:51,460 --> 00:18:53,210
♪ ،ونَراها جميعًا ♪

149
00:18:53,750 --> 00:18:58,720
♪ أَلا تُلوّنين قلبي اليوم؟ ♪

150
00:19:00,010 --> 00:19:02,010
♪ ...أَريني ♪

151
00:19:05,970 --> 00:19:08,350
!...أنتِ مصابةٌ في كُلّ جسدكِ

152
00:19:08,480 --> 00:19:09,650
!كُفّ عن هذا

153
00:19:09,770 --> 00:19:11,150
!لا تَلمسني

154
00:19:11,270 --> 00:19:12,360
ماذا حَدث؟

155
00:19:12,480 --> 00:19:14,730
هل أنت راهبٌ؟ -
.أنا مسعفٌ -

156
00:19:14,860 --> 00:19:17,530
!اذهب إلى الدّير إذن -
.أَخبرتكِ إنّي مسعفٌ -

157
00:19:17,650 --> 00:19:18,780
أَلا تَعرفين؟

158
00:19:18,900 --> 00:19:21,160
نحن نَعتني بالمرضى حتّى
.يَتماثلوا للشّفاء

159
00:19:21,530 --> 00:19:22,820
ومع ذلك أنت ميّتٌ؟

160
00:19:23,240 --> 00:19:26,750
.لستُ ميتًا -
.أنت مخطئٌ -

161
00:19:26,870 --> 00:19:30,370
سأَموت يومًا ما، هذا ممّا لا شكّ
.فيه، لكن قلبي لا يزال يَخفق

162
00:19:30,540 --> 00:19:32,460
،إذن
.ما كان لكَ أن تكون هُنا

163
00:19:32,580 --> 00:19:34,000
ماذا تَقصدين بـ "هُنا"؟

164
00:19:40,050 --> 00:19:41,680
...سهمٌ يُطلق صفيرًا

165
00:19:43,680 --> 00:19:45,640
هل كانت هذه ساحة معركةٍ؟

166
00:19:48,100 --> 00:19:51,810
،تجرّدوا مِن كُلّ أملٍ"
".يا مَن دخلتم هُنا

167
00:19:52,440 --> 00:19:53,860
أبوابُ الجحيم"؟"

168
00:19:53,980 --> 00:19:56,480
هل هذا هُو الجحيم؟
.يا لطَرافة هذا

169
00:19:56,610 --> 00:19:58,690
هل خاب أَملُك لأنّك لست في الجنّة؟

170
00:19:58,820 --> 00:20:00,650
.إنّك لواثقٌ للغاية مِن نفسك

171
00:20:00,780 --> 00:20:05,450
الجميع يظنّ أنّنا نذهب إلى الجنّة
.أو الجحيم حين نموت

172
00:20:05,580 --> 00:20:08,790
لكنّنا نأتي إلى هُنا جميعًا
.دُون استثناءٍ

173
00:20:08,910 --> 00:20:11,870
.ليست هذه الآخرة الّتي تخيّلناها

174
00:20:12,040 --> 00:20:13,420
!تمهّلي لحظةً

175
00:20:13,540 --> 00:20:15,290
.أُقسم أنّي لم أَمُت

176
00:20:15,920 --> 00:20:19,210
...تلقّينا نِداء طوارئٍ

177
00:20:24,340 --> 00:20:27,060
...لذا غَادرت المُستشفى و

178
00:20:33,650 --> 00:20:35,230
هل أنا في حُلمٍ؟

179
00:20:35,860 --> 00:20:38,360
،إن كُنت حيًا
فلماذا أنا هُنا؟

180
00:20:38,480 --> 00:20:40,070
!لا بُدّ أنّ هذا خطأٌ

181
00:20:40,440 --> 00:20:41,990
كيف وَصلت إلى هُنا؟

182
00:20:42,110 --> 00:20:44,620
!أنا مسعفٌ، بحقّ السّماء

183
00:20:44,740 --> 00:20:46,120
.مَن يَعلم

184
00:20:46,240 --> 00:20:49,040
،انتظري
هل يَعني هذا أنّكِ ميّتةٌ أيضًا؟

185
00:20:49,450 --> 00:20:50,500
.هذا صحيحٌ

186
00:20:50,620 --> 00:20:52,160
هل مُتِّ حقًا؟

187
00:20:52,330 --> 00:20:53,420
.أجل

188
00:20:53,710 --> 00:20:55,130
.لا يَبدو عليكِ ذلك

189
00:20:55,250 --> 00:20:57,130
...رُبّما جريحةٌ

190
