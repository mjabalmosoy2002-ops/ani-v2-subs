1
00:00:01,930 --> 00:00:06,270
سيكون درس اليوم عبارة عن نقاش
.حول مشكلة معيّنة

2
00:00:06,590 --> 00:00:11,510
أريدكم أيّها المرشّحون لاعتلاء العرش
.أن تجيبوا وكأنّكم الملك

3
00:00:11,920 --> 00:00:12,980
.لنبدأ

4
00:00:13,290 --> 00:00:15,950
.لديّ بعض الدّانتيل الجميل من البندقيّة

5
00:00:15,950 --> 00:00:18,010
المتجر الوحيد في هذه المملكة
الّذي يصنع هذا الدّانتيل

6
00:00:19,870 --> 00:00:25,010
.ولكنّ صاحبه لا يملك النّفقات الكافية لفعل ذلك

7
00:00:25,250 --> 00:00:30,000
لذلك عليه أن يأتي ويطلب من الدّولة
.أن تعطيه قرضًا لتمويل عمليّة البناء

8
00:00:30,000 --> 00:00:32,000
بصفتكم ملكًا، ماذا سيكون جوابكم؟

9
00:00:33,260 --> 00:00:34,540
.سأدينه المال

10
00:00:34,540 --> 00:00:36,250
.يبدو أنّه سيكون مبلغًا قليلاً في كلّ الأحوال

11
00:00:36,250 --> 00:00:37,520
.كلاّ، لا يمكنك فعل ذلك

12
00:00:38,220 --> 00:00:38,890
لِمَ لا؟

13
00:00:39,170 --> 00:00:43,810
وفق القانون، لا تستطيع الدّولة
.منح قروض لمواطنين

14
00:00:43,810 --> 00:00:44,670
.هذا صحيح

15
00:00:44,670 --> 00:00:47,010
إذًا لماذا لا يحلّون المشكلة جميعهم؟

16
00:00:47,710 --> 00:00:51,990
يستطيع سكّان البلدة أن يجمعوا بعض
،المال كلّ شهر بغرض التّوفير

17
00:00:51,990 --> 00:00:54,160
.ثمّ يقرضونه لشخص ما بحاجة إليه

18
00:00:54,430 --> 00:00:57,460
،أستطيع تناول كعكة واحدة في اليوم
لذلك أقوم بتوفيرها لعشرة أيّام

19
00:00:57,460 --> 00:00:59,900
.لأستطيع تناولها جميعها دفعة واحدة

20
00:01:00,250 --> 00:01:01,960
سيكون الأمر هكذا، صحيح؟

21
00:01:03,740 --> 00:01:06,200
.هذا هو أخي ليو ومخيّلته المجنونة

22
00:01:06,440 --> 00:01:08,120
.كلاّ. أظنّها فكرة جيّدة

23
00:01:08,840 --> 00:01:09,940
أبي؟

24
00:01:10,340 --> 00:01:15,020
في الحقيقة، أنظمة التّأمين هي شيء
.دارج في البلدان المجاورة لنا سلفًا

25
00:01:15,340 --> 00:01:19,340
قد يكون الوقت قد حان لتقوم
.غلانزرايخ بالتّفكير في نظام أيضًا

26
00:01:19,860 --> 00:01:23,050
ليونهارد، على الأرجح أنّي سأقوم
.بتقديم هذا الرّأي إلى المجلس

27
00:01:23,050 --> 00:01:25,520
هل يمكنك أن تنجز تقريرًا عنه من أجلي؟

28
00:01:27,070 --> 00:01:30,650
.أحسنت يا صاحب السّموّ
.لقد حصلتَ على ثناء والدك

29
00:01:31,190 --> 00:01:33,190
.رائع يا ليونهارد

30
00:01:33,190 --> 00:01:34,530
.تهانيّ

31
00:01:34,750 --> 00:01:37,510
...أخي برونو... نجحت

32
00:01:38,170 --> 00:01:40,410
!حصلتُ على ثناء كثير

33
00:01:42,640 --> 00:01:43,280
!شكرًا

34
00:01:44,740 --> 00:01:49,150
...فجأة، تعود لي كلّ ذكريات الطّفولة

35
00:01:52,840 --> 00:01:58,020
المدرّس الملكيّ
هايني

36
00:03:20,710 --> 00:03:24,910
أحببتُ مشاهدة أبي وهو يعمل
.عندما كنتُ صغيرًا

37
00:03:24,910 --> 00:03:27,000
أنت هنا ثانية يا برونو؟

38
00:03:28,450 --> 00:03:31,310
!أنا آسف. أستأذن

39
00:03:31,900 --> 00:03:34,980
.يمكنك أن تنضمّ لي لبعض الوقت

40
00:03:34,980 --> 00:03:37,150
!هل يمكنني ذلك بالفعل؟

41
00:03:37,660 --> 00:03:38,770
.نعم. تعال

42
00:03:39,490 --> 00:03:42,000
هل يمكنك قراءة هذا لي؟

43
00:03:42,000 --> 00:03:43,900
نعم! أيمكنني ذلك؟

44
00:03:44,450 --> 00:03:45,920
.أبي رائع

45
00:03:45,920 --> 00:03:47,860
.هذا هو العمل الّذي يقوم به كلّ اليوم

46
00:03:48,540 --> 00:03:53,510
كانت هذه هي اللّحظة الّتي جعلتني
أرغب أن أكون ملكًا عظيمًا مثل والدي

47
00:03:53,510 --> 00:03:55,170
.عندما أكبر

48
00:03:55,830 --> 00:04:00,700
.الأمير الأكبر أينس رائع. إنّه عبقريّ حقيقيّ

49
00:04:01,550 --> 00:04:05,670
قيل أنّه درس ما يدرسه من في السّابعة
.عشر وهو في عمر العاشرة

50
00:04:05,990 --> 00:04:08,510
،إنّه الأوّل في صفّه في الأكاديميّة العسكريّة
...وماهر في الأدب وفنون الحرب

51
00:04:08,850 --> 00:04:11,650
،إنّه يقول أشياء مربكة أحيانًا

52
00:04:11,860 --> 00:04:15,650
لكن لديه مخيلة مدهشة
...وقدرات مُقنِعة وجاذبيّة

53
00:04:15,880 --> 00:04:19,000
.سيكون الملك التّالي بدون أدنى شكّ

54
00:04:20,250 --> 00:04:21,520
...مستحيل

55
00:04:21,940 --> 00:04:25,770
.عليّ أن أدرس أكثر. عليّ هزيمة أخي أينس

56
00:04:25,770 --> 00:04:28,590
!أنا لا أؤمن بالعبقريّة

57
00:04:30,720 --> 00:04:33,160
.بدأت أدرس وكأنّ حياتي تعتمد على ذلك

58
00:04:33,880 --> 00:04:36,050
.بدأ الآخرون يثنون عليّ

59
00:04:36,410 --> 00:04:42,180
لكنّ افتراض أنّ أينس سيصبح
.الملك التّالي لم يتغيّر أبدًا

60
00:04:42,890 --> 00:04:48,560
أتساءل في كلّ مرّة إن كان هنالك
،شيء مثل العبقريّة

61
00:04:48,560 --> 00:04:51,610
هل سيكون أيّ نوع من الجهد
المبذول بلا فائدة أمامها؟

62
00:04:51,930 --> 00:04:56,700
،حتّى إن لحقت بعبقريّة أخي
.فسأنادى بالعبقريّ أنا أيضًا فحسب

63
00:04:56,700 --> 00:04:59,480
...لم ألاحظ ذلك من قبل، لكن ليونهارد

64
00:04:59,810 --> 00:05:05,780
...إن وُلدتَ عبقريًّا مثل أينس، فأنا

65
00:05:07,330 --> 00:05:08,370
.أيّها الأمير برونو

66
00:05:08,880 --> 00:05:10,010
هل كلّ شيء بخير؟

67
00:05:10,010 --> 00:05:10,610
...معلّمي

68
00:05:11,000 --> 00:05:13,200
هل تشعر بتوعّك؟

69
00:05:13,200 --> 00:05:15,200
.كلاّ، الأمر ليس كذلك

70
00:05:15,200 --> 00:05:19,000
.هكذا إذًا. لم تبدُ على طبيعتك
.كنتُ قلقًا

71
00:05:19,440 --> 00:05:20,670
قلقًا؟

72
00:05:20,670 --> 00:05:22,760
—جعلتُك تقلق

73
00:05:22,760 --> 00:05:24,490
!أعتذر بشدّة

74
00:05:24,490 --> 00:05:28,390
كيف لي أن أسبّب المشاكل لمعلّمي
!بأيّ شكل من الأشكال؟ أكره نفسي

75
00:05:32,580 --> 00:05:33,640
.أنا آسف

76
00:05:34,060 --> 00:05:36,650
.والآن، بشأن هذه المقالة

77
00:05:37,030 --> 00:05:38,400
كيف وجدتها؟

78
00:05:38,400 --> 00:05:42,240
سوف أقدّمها في المؤتمر الأكاديميّ
.بعد أسبوعين من الآن في الجامعة

79
00:05:42,620 --> 00:05:45,650
فعلاً؟ ترتاد الجامعة يا صاحب السّموّ؟

80
00:05:45,650 --> 00:05:48,080
.كـ-كلاّ، ليس بشكل رسميّ

81
00:05:48,500 --> 00:05:53,250
زرتُ الجامعة عندما سمعتُ
أنّ باحثًا أحترمه

82
00:05:53,250 --> 00:05:56,960
،وهو الدّكتور دميتري من أوروسز
.سيُلقي محاضرة هناك

83
00:05:58,080 --> 00:06:02,080
لسوء الحظّ أنّ جدول مواعيده
.قد تغيّر وألغيت المحاضر

84
00:06:02,690 --> 00:06:07,930
لكنّي كنتُ أتلقّى إرشادًا خاصًّا من أساتذة
.الجامعة الّذين قابلتُهم حينها

85
00:06:07,930 --> 00:06:09,260
.يا للعجب

86
00:06:10,720 --> 00:06:15,810
.هذا لتوسيع أفق تفكيري فحسب
.دروسك أكثر أهمّيّة عندي بالطّبع

87
00:06:15,810 --> 00:06:18,580
!أنت هو معلّمي الوحيد والأوحد

88
00:06:18,580 --> 00:06:20,220
شكرًا لك... على ما أظنّ؟

89
00:06:20,480 --> 00:06:22,270
...لم يكن بحاجة لتوضيح الأمر بشدّة

90
00:06:22,270 --> 00:06:27,550
.لدى بحثي الحاليّ موضوع صعب
.أرحّب بنصيحتك الصّريحة

91
00:06:29,220 --> 00:06:30,200
...حسنًا إذًا

92
00:06:30,590 --> 00:06:32,070
.إنّه غير مكتمل بشكل عامّ

93
00:06:32,660 --> 00:06:36,680
،بالكاد قمتَ بالتّطرّق لبحوث سابقة
.بشأن المشاكل العرقيّة

94
00:06:36,680 --> 00:06:38,420
.لا توجد وجهة نظر جديدة هنا

95
00:06:38,890 --> 00:06:41,460
.كما أنّ الأخطاء الإملائيّة المتكرّرة لا تصرّ النّاظر لها

96
00:06:41,460 --> 00:06:42,790
.لقد قمتُ بالتّأشير لها من أجلك

97
00:06:44,790 --> 00:06:46,570
...هذا مخزٍ

98
00:06:46,930 --> 00:06:50,210
أيّها الأمير برونو. هل كنتَ متوتّرًا مؤخّرًا؟

99
00:06:50,210 --> 00:06:52,890
لستَ على طبيعتك. هل حدث أمر ما؟

100
00:06:53,290 --> 00:06:55,880
...أ-أنا... حسنًا

101
00:06:56,440 --> 00:06:58,140
.لن أجبرك على إخباري بشيء

102
00:06:58,710 --> 00:07:02,050
.أفهم أنّ شيئًا ما يشتّت انتباهك

103
00:07:02,050 --> 00:07:05,630
.ولكنّك تحتاج للتّركيز على هذا البحث

104
00:07:05,940 --> 00:07:07,160
...أنا مُحرَج

105
00:07:07,780 --> 00:07:09,150
.لنقم بهذا إذًا

106
00:07:10,160 --> 00:07:12,750
ستكمل هذا البحث وتقدّمه لي

107
00:07:12,750 --> 00:07:14,920
.قبل موعد إلقائك له بعد أسبوعين

108
00:07:16,050 --> 00:07:20,210
فكّر جيّدًا ما المملكة الّتي تأمل
.أن تنشئها في المستقبل

109
00:07:20,450 --> 00:07:23,880
...وأيضًا، إن لم يرضني بحثك

110
00:07:23,880 --> 00:07:26,920
.فلن تظلّ متمرّنًا عندي

111
00:07:28,500 --> 00:07:31,560
رغم أنّي لا أذكر أنّي قبلتُ بأخذك
.كمتمرّن عندي من الأساس

112
00:07:32,280 --> 00:07:33,560
...هذه أوّل مرّة

113
00:07:34,140 --> 00:07:37,060
!هذه أوّل مرّة تدعوني فيها بمتدرّبك

114
00:07:38,060 --> 00:07:40,440
...لا أصدّق أنّ آمالك فيّ كانت عالية

115
00:07:40,870 --> 00:07:44,180
لن أكون نادمًا على أيّ شيء إن
!لقيت حتفي في هذه اللّحظة

116
00:07:45,660 --> 00:07:48,800
.مهلاً، لا. عليّ إنهاء البحث أوّلاً

117
00:07:48,800 --> 00:07:50,130
!انتظر فحسب يا معلّمي

118
00:07:50,130 --> 00:07:51,990
!أقسم أنّي لن أخذلك

119
00:07:51,990 --> 00:07:54,510
!حسنًا! يمكنني فعلها

120
00:07:54,900 --> 00:07:58,490
...جيّد ما دام قد حفّزه ذلك

121
00:07:58,960 --> 00:08:01,380
.ابذل جهدك أيّها الأمير برونو

122
00:08:05,920 --> 00:08:07,590
.سأنسى أمر العرش في الوقت الحاليّ

123
00:08:08,050 --> 00:08:11,560
،سأركّز على المهمّة الّتي بين يديّ
.وسأعمل بكلّ جهدي

124
00:08:14,720 --> 00:08:16,540
.هذا ليس جيّدًا

125
00:08:18,410 --> 00:08:19,740
.ولا هذا أيضًا

126
00:08:24,690 --> 00:08:25,690
!وجدتُها

127
00:08:26,620 --> 00:08:31,780
سآخذ تصوّري عن المملكة المستقبليّة المثاليّة
.في عين الاعتبار بشكل شامل كما قال معلّمي

128
00:08:48,100 --> 00:08:50,130
!صباح الخير يا أبي

129
00:08:50,370 --> 00:08:52,090
.صباح الخير يا ليونهارد

130
00:08:52,590 --> 00:08:57,050
،أ-أعرف أنّه ليس ممتازًا
.لكنّي جهّزتُ تقريرًا عن رأيي

131
00:08:57,310 --> 00:08:59,810
.فهمت. أتطلّع قُدمًا لقراءته

132
00:09:00,210 --> 00:09:00,800
!حسنًا

133
00:09:01,610 --> 00:09:04,310
.هذا هو يوم الحساب للأمير برونو

134
00:09:04,830 --> 00:09:06,440
...مـ-معلّمي

135
00:09:06,440 --> 00:09:09,280
.صاحب السّموّ! تبدو في حالة فظيعة

136
00:09:09,280 --> 00:09:11,340
.اعذر مظهري الفظيع

137
00:09:12,070 --> 00:09:17,120
معلّمي. سأثبت لك بهذا البحث
.أنّي متمرّن يمكنك أن تفخر به

138
00:09:17,410 --> 00:09:19,490
.فعلاً؟ تبدو واثقًا من نفسك

139
00:09:20,010 --> 00:09:22,750
.كلاّ... لستُ كذلك في الحقيقة

140
00:09:23,590 --> 00:09:27,300
لكنّي أستطيع أن أقول بكلّ
.ثقة أنّي بذلت كلّ جهدي

141
00:09:28,790 --> 00:09:30,790
.سألقي نظرة عليه إذًا

142
00:09:33,880 --> 00:09:35,130
...عـ-عفوًا

143
00:09:35,730 --> 00:09:37,140
كيف كان؟

144
00:09:38,740 --> 00:09:39,840
.ممتازًا

145
00:09:40,450 --> 00:09:42,730
.بصراحة، لقد تجاوز توقّعاتي

146
00:09:43,100 --> 00:09:45,360
،إنّ أفكارك أكثر عمقًا من السّابق

147
00:09:45,360 --> 00:09:49,610
وتحليلك من وجهات نظر مختلفة
.علّمني بضعة أشياءٍ أيضًا

148
00:09:49,850 --> 00:09:52,610
تـ-علّمتَ منّي؟

149
00:09:52,780 --> 00:09:56,110
.بالفعل. قدّم بحثك بكلّ فخر

150
00:09:56,310 --> 00:09:58,860
.أنا فخور بأن أناديك متمرّني

151
00:10:00,230 --> 00:10:03,720
.وبالطّبع، ذلك مرادف واضح لكلمة تلميذ

152
00:10:03,720 --> 00:10:07,130
"لذلك، إن أردتَ مناداتي "أستاذ
—من الآن فصاعدًا كما يفعل

153
00:10:06,470 --> 00:10:07,130
!معلّمي

154
00:10:07,130 --> 00:10:08,740
!شكرًا جزيلاً لك

155
00:10:08,740 --> 00:10:11,000
!لن يحرجك متمرّنك أبدًا

156
00:10:14,190 --> 00:10:17,460
.يا إلهي. عاد لطبيعته بالكامل

157
00:10:22,320 --> 00:10:25,380
.ما زلت متوتّرًا من وقوفي على الخشبة

158
00:10:25,990 --> 00:10:27,980
.جهّز نفسك لو سمحت

159
00:10:28,430 --> 00:10:29,310
.حاضر

160
00:10:29,520 --> 00:10:34,600
سيكون أخي العبقريّ آينس واثقًا
من نفسه حتّى في وقت كهذا، صحيح؟

161
00:10:34,600 --> 00:10:36,680
.أدركتُ شيئًا منذ وقت بعيد

162
00:10:37,160 --> 00:10:42,780
لولا لقبي كالأمير الثّالث، لكنتُ
.رجلاً عاديًّا وُلد من دون أيّ شيء

163
00:10:43,250 --> 00:10:46,960
لذلك السّبب عليّ بذل جهد بعشرات
،الأضعاف ممّا يبذله الآخرون

164
00:10:46,960 --> 00:10:51,540
وإلاّ ما كنتُ أبدًا لأصبح شخصًا
.مميّزًا كفاية لإلهام الآخرين

165
00:10:51,760 --> 00:10:54,040
...لكن في الوقت الحاليّ، كأمير

166
00:10:54,510 --> 00:10:56,170
...كمتمرّن لدى معلّمي

167
00:10:56,170 --> 00:10:57,720
.ليس عليّ إحراج نفسي

168
00:10:58,420 --> 00:11:02,260
أولن يصبح ذلك ضرورة لمملكتنا؟

169
00:11:02,260 --> 00:11:05,140
.هذا كلّ شيء. شكرًا على انتباهكم

170
00:11:10,350 --> 00:11:13,780
هل رجل عاديّ مثلي ليس كافيًا في النّهاية؟

171
00:11:14,100 --> 00:11:16,770
...عليّ أن أكون عبقريًّا مثل أخي آينس لكي

172
00:11:34,250 --> 00:11:36,370
...نجحت. نجحت

173
00:11:36,740 --> 00:11:38,490
!لقد نجحت

174
00:11:39,580 --> 00:11:42,370
.كان ذلك بحثًا رائعًا أيّها الأمير برونو

175
00:11:42,370 --> 00:11:44,640
أيّها الأمير، هل يمكنك تقديم
محاضرة في جامعتي؟

176
00:11:44,640 --> 00:11:45,770
.شكرًا لكم

177
00:11:46,320 --> 00:11:48,770
.بالدّور رجاءً

178
00:11:51,160 --> 00:11:52,820
لا نقصد الإهانة، ولكن من تكون؟

179
00:11:52,820 --> 00:11:55,640
!يا له من شرف لي أن أقابلك يا برونو

180
00:11:56,640 --> 00:11:59,980
.تبدو وسيمًا عن قرب

181
00:11:59,980 --> 00:12:02,340
المعذرة، لكن من تكون؟

182
00:12:03,250 --> 00:12:07,020
.شعرك أيّها الدّكتور. ونظّاراتك ليست في محلّها

183
00:12:07,020 --> 00:12:07,890
!ويحي

184
00:12:07,890 --> 00:12:11,360
.هذا غريب. سمعتُ أنّك معجب بي

185
00:12:11,360 --> 00:12:14,260
أ-أيعقل أنّك... الدّكتور دميتري من أوروسز؟

186
00:12:14,260 --> 00:12:18,290
!نعم! وهذا هو مساعدي سميردياكوف. مرحبًا

187
00:12:19,140 --> 00:12:22,010
لم أرغب في أن أكون رجلاً عجوزًا غريبًا

188
00:12:22,010 --> 00:12:25,180
...بقولي أنّ أشخاصًا غرباء عنّي هم معجبون لي

189
00:12:25,180 --> 00:12:30,770
لا أصدّق أنّي أقابل الدّكتور
.دميتري العظيم هكذا

190
00:12:31,680 --> 00:12:35,120
.تحدّق في الدّكتور دميتري؟ يا لوقاحتك

191
00:12:35,120 --> 00:12:35,980
...على رسلك

192
00:12:36,240 --> 00:12:38,960
.سمعتُ كلّ شيء عنك من أحد معارفي

193
00:12:38,960 --> 00:12:42,630
راودني الفضول، لذلك أتيتُ
.إلى هناك لحضور إلقائك لبحثك

194
00:12:42,630 --> 00:12:44,760
أ-أتيتَ من أجلي؟

195
00:12:44,760 --> 00:12:46,360
.نعم، وقد كان رائعًا

196
00:12:46,360 --> 00:12:48,830
هل تريد تناول العشاء معًا؟

197
00:12:48,830 --> 00:12:49,860
!نعم، بكلّ تأكيد

198
00:12:51,780 --> 00:12:55,960
لذلك يا برونو— هل من المسموح لي
ألاّ أناديك الأمير برونو؟

199
00:12:56,210 --> 00:13:00,860
أنا لستُ من مواطني هذا البلد
.ولستُ هنا للتّحدّث في السّياسة أيضًا

200
00:13:00,860 --> 00:13:02,360
.لا أمانع

201
00:13:02,360 --> 00:13:04,000
.لن أتردّد إذًا

202
00:13:05,970 --> 00:13:09,610
في الحقيقة، كان لي شرف قراءة
.الكثير من بحوثك

203
00:13:09,610 --> 00:13:12,190
.رأيي فيك ممتاز

204
00:13:12,190 --> 00:13:13,490
.شكرًا لك

205
00:13:13,490 --> 00:13:16,110
.لذلك لديّ عرض لك

206
00:13:16,340 --> 00:13:20,980
ما رأيك في مغادرة غلانزرايخ
والدّراسة لتصبح باحثًا مثلي؟

207
00:13:24,380 --> 00:13:26,770
.لقد تأخّر الأمير برونو

208
00:13:27,230 --> 00:13:29,930
.أنا واثق أنّه بخير مع الحرس، لكنّ هذا غريب

209
00:13:33,210 --> 00:13:34,540
...الأمير برونو

210
00:13:36,600 --> 00:13:37,550
الأمير...؟

211
00:13:39,790 --> 00:13:43,390
عاد الأمير برونو متأخّرًا، صحيح؟

212
00:13:47,620 --> 00:13:49,900
.سررت بلقائك أيّها الأستاذ هايني

213
00:13:50,250 --> 00:13:56,850
.أنا إرنست روزنبرغ، الخادم الأعلى لوليّ العهد أينس

214
00:13:57,940 --> 00:13:59,190
...هذا الرّجل

215
00:14:01,820 --> 00:14:07,720
.تحدّثتُ عن الأمير برونو مع أحد معارفي
.إنّه أستاذ في الجامعة

216
00:14:07,720 --> 00:14:12,720
لقد كان مهتمًّا بالأمير وأتى كلّ
.هذه المسافة من أوروسز للقائه اللّيلة

217
00:14:12,720 --> 00:14:14,710
ولهذا السّبب عاد متأخّرًا؟

218
00:14:14,950 --> 00:14:21,140
نعم. يجدر بي العودة إلى
.مسكن الأمير أينس أنا أيضًا

219
00:14:21,140 --> 00:14:22,220
.المعذرة

220
00:14:30,640 --> 00:14:35,790
ما رأيك في مغادرة غلانزرايخ
والدّراسة لتصبح باحثًا مثلي؟

221
00:14:36,460 --> 00:14:39,450
سيكون هنالك ملك واحد فقط، صحيح؟

222
00:14:39,450 --> 00:14:44,610
،لا أقول أنّ عمل الباحث سهل
.لكنّه واقعيّ على الأقلّ

223
00:14:45,200 --> 00:14:48,240
.يمكنك أن تصبح باحثًا واعدًا

224
00:14:48,510 --> 00:14:52,340
.عليك أن تجول العالم وتوسّع آفاقك

225
00:14:52,340 --> 00:14:55,300
.اجعل موهبتك تتفتّح في الخارج

226
00:14:55,610 --> 00:15:01,050
أشعر بالإطراء، لكن بصفتي أميرًا
...من عائلة غلانزرايخ الملكيّة

227
00:15:01,050 --> 00:15:02,630
،لكنّك الابن الثّالث

228
00:15:02,630 --> 00:15:06,600
وأخوك الأكبر مرشّح ممتاز ليصبح الملك، صحيح؟

229
00:15:06,920 --> 00:15:10,760
احتمال أن تصبح ملكًا معدوم، صحيح؟

230
00:15:12,500 --> 00:15:14,610
.هذا عنوان الفندق الّذي أقيم فيه

231
00:15:14,810 --> 00:15:17,030
.سنغادر إلى أوروسز مساءً بعد أسبوع من الآن

232
00:15:17,030 --> 00:15:18,150
.عليك مرافقتنا

233
00:15:18,150 --> 00:15:19,700
.هذا طلب مفاجئ

234
00:15:19,920 --> 00:15:22,050
.سأكون بانتظار موافقتك

235
00:15:22,910 --> 00:15:24,500
.أعلم

236
00:15:24,740 --> 00:15:28,340
.أعرف أنّ احتمال أن أصبح ملكًا غير واقعيّ

237
00:15:28,340 --> 00:15:30,080
...ولكن مع ذلك

238
00:15:33,060 --> 00:15:34,760
ماذا عليّ أن أفعل؟

239
00:15:34,760 --> 00:15:35,800
!أبي

240
00:15:36,330 --> 00:15:38,660
كيف كان تقريري؟

241
00:15:38,660 --> 00:15:42,370
،كانت هنالك أخطاء إملائيّة عديدة وهفوات
.لكنّك أحسنت العمل عليه

242
00:15:43,340 --> 00:15:46,760
.لديك مخيّلة مرنة للغاية

243
00:15:46,760 --> 00:15:49,430
.أظنّ أنّ هذه أفضل المواهب

244
00:15:50,270 --> 00:15:52,050
.واصل كما أنت

245
00:15:52,840 --> 00:15:55,360
!حاضر يا أبي! شكرًا جزيلاً

246
00:15:59,030 --> 00:16:01,070
.لقد مرّ أسبوع

247
00:16:02,560 --> 00:16:07,710
ربّما سيهدّئ الهواء العليل قلبي
.ويجعلني أرى الأمور كما يجب

248
00:16:11,150 --> 00:16:12,030
!معلّمي

249
00:16:12,030 --> 00:16:13,330
.الأمير برونو

250
00:16:13,770 --> 00:16:18,080
كنت أمشّي شادو. الكلاب ظريفة، صحيح؟

251
00:16:18,360 --> 00:16:21,160
بدا الأمر لي وكأنّ الكلب هو
...من كان يمشّيك

252
00:16:21,750 --> 00:16:23,080
.لا. لا شيء

253
00:16:23,510 --> 00:16:27,010
.كان ذهنك مشتّتًا ثانية أيّها الأمير برونو

254
00:16:27,320 --> 00:16:29,160
أهنالك ما يشغل بالك؟

255
00:16:29,160 --> 00:16:33,810
.حـ-حسنًا... لا، هذا أمر عليّ أن أقرّره بنفسي

256
00:16:34,560 --> 00:16:36,830
.قد يكون هذا صحيحًا في عدّة حالات

257
00:16:36,830 --> 00:16:41,610
ولكنّ الحديث مع الآخرين يمكن
.أن يساعدك أحيانًا على ترتيب أفكارك

258
00:16:42,630 --> 00:16:46,580
،قد لا أستطيع منحك نصيحة جيّدة
.لكنّي سأستمع لك إن أردتَ ذلك

259
00:16:46,970 --> 00:16:48,860
...أنا... في الحقيقة

260
00:16:49,270 --> 00:16:51,690
...لستُ واثقًا من أنّه يجب عليّ السّعي للعرش

261
00:16:52,310 --> 00:16:54,690
.باحث؟ فكرة ممتازة

262
00:16:55,210 --> 00:16:55,910
...لا مبالاة

263
00:16:56,170 --> 00:16:59,790
الدّراسة على يد أستاذ في الجامعة
.ستكون فرصة ممتازة لك

264
00:16:59,790 --> 00:17:03,940
...لـ-لكنّك تعلّمني لتجهيزي للعرش

265
00:17:03,940 --> 00:17:08,650
لا يوجد أيّ سبب لي لكي أمانع
.ما دام الأمر في صالحك

266
00:17:08,650 --> 00:17:09,590
هكذا إذًا؟

267
00:17:09,860 --> 00:17:15,330
هذا صحيح. بصراحة، أفكّر أيضًا
.أنّه عليّ أن أصبح باحثًا

268
00:17:16,010 --> 00:17:19,970
.درستُ للتّجهيز للعرش لأنّي أتطلّع لوالدي

269
00:17:19,980 --> 00:17:23,270
لكنّي أتساءل إن كان من الأفضل للمملكة

270
00:17:23,270 --> 00:17:25,230
.إن أصبح أخي الأكبر المميّز الملك التّالي

271
00:17:25,400 --> 00:17:27,960
.لكنّك مميّز أيضًا

272
00:17:27,960 --> 00:17:28,810
...هذا

273
00:17:29,230 --> 00:17:32,940
.هذا لأنّي أردتُ ذلك، وتصرّفتُ وفق ذلك

274
00:17:33,760 --> 00:17:36,390
.أنا لستُ مميّزًا

275
00:17:37,050 --> 00:17:41,540
لطالما حملتُ الضّغينة وغرتُ
.من الآخرين. لا أظهر ذلك فحسب

276
00:17:42,980 --> 00:17:47,830
.أنا لستُ حتّى أخًا أكبر جيّدًا
.لا أستحقّ احترام ليونهارد

277
00:17:50,150 --> 00:17:51,270
.أيّها الأمير برونو

278
00:17:51,660 --> 00:17:53,420
.تحتاج لدرس

279
00:17:54,420 --> 00:17:56,920
.لنقل أنّك على فراش الموت

280
00:17:57,340 --> 00:18:01,600
،بينما يختفي وعيك، قد تفكّر وتقول
."ليتني قمتُ بهذا حينها"

281
00:18:01,600 --> 00:18:04,550
.لكنّ الزّمن لن يعود للوراء

282
00:18:05,270 --> 00:18:07,640
.لديك حياة واحدة، وهي حياتك أنت

283
00:18:07,640 --> 00:18:10,950
هل تحتاج لسبب لتعيشها كما تريد؟

284
00:18:11,690 --> 00:18:12,520
...باختصار

285
00:18:13,200 --> 00:18:15,290
.يعتمد الأمر على عزيمتك فحسب

286
00:18:17,480 --> 00:18:23,060
مهما كان قرارك، فسأتمنّى لك
.دوام العافية. يومًا طيّبًا

287
00:18:24,190 --> 00:18:25,540
!مهلاً رجاءً

288
00:18:26,780 --> 00:18:30,170
.أظنّ أنّك ساعدتني على ترتيب أفكاري

289
00:18:30,430 --> 00:18:33,050
.أنا ممتنّ يا معلّمي

290
00:18:36,300 --> 00:18:37,810
!برونو

291
00:18:39,540 --> 00:18:41,810
.آسف لأنّي جعلتك تنتظر

292
00:18:41,810 --> 00:18:44,340
هل اتّخذتَ قرارك؟

293
00:18:44,610 --> 00:18:48,360
نعم. فكّرتُ في الأمر مليًّا كلّ يوم
...أيّها الدّكتور دميتري

294
00:18:48,980 --> 00:18:54,480
!خذني إلى جامعتك في أروسز رجاءً

295
00:18:56,660 --> 00:18:58,710
...جيّد! ولكن

296
00:18:59,750 --> 00:19:00,710
...لكن

297
00:19:01,070 --> 00:19:02,200
.كصديق، في المستقبل

298
00:19:05,730 --> 00:19:06,800
ما هذه؟

299
00:19:06,800 --> 00:19:09,760
.نسخ عن البحوث الّتي كتبتُها حتّى الآن

300
00:19:09,760 --> 00:19:12,500
.ألقِ نظرة عليها رجاءً إن سمح لك الوقت

301
00:19:12,800 --> 00:19:16,010
،في المرّة القادمة الّتي تزور فيها غلانزرايخ

302
00:19:16,010 --> 00:19:20,520
.فسيسرّني إن زرت القصر وتحدّثت معي

303
00:19:22,770 --> 00:19:25,510
.تريد أن تصبح ملكًا بالفعل

304
00:19:25,760 --> 00:19:29,520
.نعم. كان ذلك حلمي مذ كنتُ صغيرًا

305
00:19:30,400 --> 00:19:31,470
.سفسطة

306
00:19:31,470 --> 00:19:36,040
على مهلك. بالمناسبة، ما الّذي
ستفعله إن لم تصبح الملك؟

307
00:19:36,040 --> 00:19:38,900
.سيكون من الصّعب تغيير طريقك لاحقًا

308
00:19:40,770 --> 00:19:42,330
.أنا مدرك لذلك

309
00:19:42,330 --> 00:19:44,560
.باختصار، يعتمد الأمر على عزيمتي

310
00:19:44,560 --> 00:19:50,410
اتّخذتُ هذا القرار. إن كانت الهزيمة
.وخيبة الأمل في انتظاري، فسأتجاوزهما

311
00:19:51,010 --> 00:19:54,700
،أنا لستُ والدي الّذي أتطلّع إليه
.أو حتّى أخي الموهوب

312
00:19:54,720 --> 00:19:57,090
،لأنّي واجهتُ عقبات أنا أيضًا

313
00:19:57,090 --> 00:20:00,510
.سأكون ذا فائدة أيضًا لشعبنا الّذي يعاني

314
00:20:01,810 --> 00:20:03,520
،بهذه المشاعر في قلبي

315
00:20:03,520 --> 00:20:07,230
.سأصل للعرش بالعمل الجادّ الّذي آمنتُ به دائمًا

316
00:20:07,610 --> 00:20:10,570
.هذه هي عزيمتي لملاحقة أحلامي

317
00:20:11,700 --> 00:20:15,310
فهمت. إن كانت مشاعرك قويّة حيال
.هذا، فأظنّ أنّ الأمر مقضيّ

318
00:20:15,310 --> 00:20:18,480
.رغم أنّنا كنّا لنحبّ العمل معك
أليس كذلك؟

319
00:20:19,310 --> 00:20:24,530
لديه لسان سليط، لكنّ سميردياكوف
.معجب بك أيضًا. لقد قرأ بحوثك

320
00:20:24,530 --> 00:20:25,650
!د-دكتور

321
00:20:25,960 --> 00:20:29,950
زر أوروسز يومًا ما. سنأخذك إلى مكان
.يقدّم أفضل حساء بورش

322
00:20:29,950 --> 00:20:30,710
.أجل

323
00:20:35,120 --> 00:20:37,710
.صحيح، وبشأن بحثك الّذي قدّمتَه

324
00:20:38,130 --> 00:20:39,760
،كان المحتوى ممتازًا

325
00:20:39,760 --> 00:20:42,200
لكن أظنّ أنّ التّصفيق أتى أيضًا

326
00:20:42,200 --> 00:20:45,230
من الجمهور الّذين رأوا كم أنّك
.حكيم كفرد من العائلة الملكية

327
00:20:45,840 --> 00:20:50,050
.قد يتوقّعون الكثير منك أكثر ممّا تظنّ

328
00:20:50,050 --> 00:20:53,830
.دعني أتبجّح بكونك صديقًا لي في يوم ما

329
00:20:53,830 --> 00:20:56,570
.حاضر. لقد شرّفتني دعوتك

330
00:20:57,390 --> 00:20:59,110
!شكرًا لك

331
00:20:59,660 --> 00:21:01,940
.سيدور بيننا حديث رائع ولطيف في المرّة القادمة

332
00:21:11,660 --> 00:21:13,620
معلّمي! ما الّذي تفعله هنا؟

333
00:21:14,260 --> 00:21:16,700
.ظننتُ أنّ عليّ حمايتك من أيّ مخاطر في الطّريق

334
00:21:17,430 --> 00:21:20,580
هل سمعتَ حديثي مع الدّكتور دميتري؟

335
00:21:20,580 --> 00:21:23,590
.سمعتُه، رغم أنّي لم أقصد استراق السّمع

336
00:21:24,560 --> 00:21:26,130
.كم هذا محرج

337
00:21:26,130 --> 00:21:31,350
.ولكنّ ذلك جعلني أعجب بمدى إخلاصك

338
00:21:31,960 --> 00:21:36,400
لنعمل بجدّ معًا لنجعلك مرشّحًا
.يستحقّ العرش

339
00:21:42,050 --> 00:21:43,150
!حاضر يا معلّمي

340
00:21:43,420 --> 00:21:44,960
!سأتبعك لبقيّة حياتي

341
00:21:44,960 --> 00:21:46,720
.ليس لبقيّة حياتك

342
00:21:48,740 --> 00:21:50,160
هكذا إذًا؟

343
00:21:50,160 --> 00:21:53,300
لم يتخلّ الأمير برونو عن العرش أيضًا؟

344
00:21:53,300 --> 00:21:57,170
.ربّما علينا التّحرّك لاستبعاده هو

345
00:21:57,710 --> 00:22:00,800
.المدرّس الملكيّ هايني ويتغنستاين

346
00:22:01,150 --> 00:22:04,470
.أحضر لي تقريرًا شاملاً عن أصوله

347
00:23:36,430 --> 00:23:39,310
لماذا أنت صارم معي دائمًا مثل أخي برونو؟

348
00:23:39,310 --> 00:23:41,360
.لأنّك غير محترم دائمًا كما هو واضح

349
00:23:41,360 --> 00:23:43,070
!لا تنسَ أنّك من العائلة الملكية

350
00:23:43,070 --> 00:23:44,400
.ممتاز، محاضرة أخرى

351
00:23:44,400 --> 00:23:46,410
!"في الحلقة القادمة: "قلب خجول

352
00:23:44,490 --> 00:23:50,940
الحلقة القادمة
قلب خجول

353
00:23:46,410 --> 00:23:48,190
لن تأكل فطيرة التّفّاح تلك؟

354
00:23:48,190 --> 00:23:49,000
!سآكلها إذًا

355
00:23:49,000 --> 00:23:51,300
!ألم أخبرك للتّو...؟