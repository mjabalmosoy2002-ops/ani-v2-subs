1
00:00:14,370 --> 00:00:17,740
هل نزعتَ الضّمادات يا موك؟

2
00:00:17,740 --> 00:00:21,120
.لم تكن إصابتي خطيرة إلى هذا الحدّ أصلاً

3
00:00:21,120 --> 00:00:22,710
.أنا بخير الآن

4
00:00:23,890 --> 00:00:25,080
!بيرو

5
00:00:26,310 --> 00:00:29,680
مهلاً يا بيرو، ما الّذي أصابك؟

6
00:00:29,680 --> 00:00:32,390
لحظة، ما اسم ذلك المكان مجدّدًا؟

7
00:00:32,390 --> 00:00:33,660
.أيريس

8
00:00:33,660 --> 00:00:35,540
...أقصد هل

9
00:00:35,540 --> 00:00:38,580
.من الواضح أنّه فخّ

10
00:00:38,580 --> 00:00:41,130
.لا أرغب في قتالهم مجدّدًا

11
00:00:41,530 --> 00:00:46,350
،لو كانوا يريدون قتلنا حقًّا
.لما احتاجوا إلى نصب فخّ لنا

12
00:00:47,040 --> 00:00:49,060
.أظنّ أنّك محقّ

13
00:00:51,040 --> 00:00:52,950
.لقد وُلدتُ هناك

14
00:00:53,690 --> 00:00:56,250
.وهذا سببٌ إضافيّ لعدم الذّهاب

15
00:00:56,250 --> 00:00:59,150
لا أعرف ما الّذي يريدون
...إظهاره لك، ومع ذلك

16
00:00:59,150 --> 00:01:01,990
.آسف، فقدتُ أعصابي

17
00:01:01,990 --> 00:01:05,730
أنت محقّ، فمن الممكن
.ألاّ يكون هناك شيء مريب

18
00:01:05,730 --> 00:01:07,940
.لم يفت الأوان بعد للذّهاب إلى مكان آخر

19
00:01:07,940 --> 00:01:10,480
يمكننا زيارة ذلك الشّخص
...الّذي تعرفه لإزالة القناع

20
00:01:10,480 --> 00:01:13,150
عذرًا، هل هذا المقعد شاغر؟

21
00:01:13,150 --> 00:01:15,670
.يشعر ابني بدوار السّفر

22
00:01:15,670 --> 00:01:18,800
.تفضّلا، يمكنه الجلوس قرب النّافذة

23
00:01:18,800 --> 00:01:20,520
.شكرًا لك

24
00:01:20,520 --> 00:01:22,600
.هيّا، قل شكرًا

25
00:01:22,600 --> 00:01:24,310
.شكرًا لك

26
00:01:32,820 --> 00:01:35,030
.سأخرج لأدخّن

27
00:01:35,390 --> 00:01:39,180
.عذرًا... أنا آسفة، شكرًا لك

28
00:01:39,180 --> 00:01:42,810
هل أنتم ذاهبون أيضًا إلى مهرجان أيريس؟

29
00:01:42,810 --> 00:01:43,900
مهرجان؟

30
00:01:44,130 --> 00:01:48,910
،نعم، للاحتفال بعيد ميلاد غاستون
.أحد أعظم ثلاثة صانعي أقنعة

31
00:01:48,910 --> 00:01:50,770
حقًّا؟

32
00:01:51,340 --> 00:01:53,450
كيف هو هذا المهرجان؟

33
00:01:53,450 --> 00:01:56,130
.يرتدي النّاس الأقنعة ويمرحون

34
00:01:56,130 --> 00:01:58,970
.ينتظره ابني بفارغ الصّبر كلّ عامّ

35
00:02:02,040 --> 00:02:03,430
.إنّه يتوهّج

36
00:02:03,750 --> 00:02:05,150
!رائع

37
00:02:07,690 --> 00:02:09,870
!قناع كانّا يتوهّج

38
00:02:10,350 --> 00:02:13,560
إنّها أصغر عبقريّة في صناعة
!الأقنعة على الإطلاق

39
00:02:14,110 --> 00:02:19,580
كانّا، قد يقع عليك الاختيار للانضمام إلى
.معلّمنا في مهرجان عيد ميلاده هذا العام

40
00:02:23,320 --> 00:02:25,530
...لم أفكّر في الأمر منذ وقت طويل

41
00:02:27,030 --> 00:02:30,860
.لكنّه كان ذكرى مهمّة بالنّسبة إليّ

42
00:04:20,090 --> 00:04:22,730
.آسف لأنّ المطاف انتهى بنا هنا

43
00:04:22,730 --> 00:04:26,520
لا بأس، أردتَ رؤية مسقط
رأسك مجدّدًا، صحيح؟

44
00:04:28,200 --> 00:04:29,560
.لستُ متأكّدًا من ذلك

45
00:04:30,560 --> 00:04:33,500
...بيرو، هل هذا هو المكان الّذي

46
00:04:33,500 --> 00:04:34,420
.أجل

47
00:04:35,120 --> 00:04:39,330
.هنا ارتديتُ قناع إله الحرب

48
00:04:39,330 --> 00:04:42,980
.وقتلتُ معلّمي وزملائي المتدرّبين

49
00:04:44,010 --> 00:04:49,140
سألتُ بعض النّاس، ولم يحدث
.هنا أيّ شيء مهمّ مؤخّرًا

50
00:04:49,140 --> 00:04:52,470
.حقًّا؟ أوّلاً، علينا إيجاد نُزل

51
00:04:52,470 --> 00:04:54,230
.يمكننا بدء التّحقيق غدًا

52
00:04:56,590 --> 00:04:59,370
.يبدو أنّ بيرو منشغل بأمر ما

53
00:04:59,370 --> 00:05:01,460
.إنّه شخص جادّ للغاية

54
00:05:03,080 --> 00:05:05,750
من يدري ما الّذي يدور في ذهنه؟

55
00:05:09,100 --> 00:05:12,750
.لا شكّ أنّ هذا القناع يمتلك قوّة

56
00:05:13,090 --> 00:05:17,460
،أحسنت يا كانّا
.خصوصًا لمن هي في مثل سنّك

57
00:05:19,910 --> 00:05:21,990
.لكنّ العمل الحقيقيّ يبدأ الآن

58
00:05:22,470 --> 00:05:27,390
تتطلب صناعةُ أقنعةٍ تمتلكُ قدرات
.مزيدًا من الدّراسة

59
00:05:27,690 --> 00:05:29,670
هل فهمت يا تانان؟

60
00:05:29,670 --> 00:05:34,420
،أعلم أنّك متحمّس
.لكنّ كانّا لم تصبح صانعة أقنعة بعد

61
00:05:34,420 --> 00:05:36,340
.إنّها على وشك أن تصبح واحدة فحسب

62
00:05:36,340 --> 00:05:38,060
!آسف

63
00:05:38,460 --> 00:05:45,190
كما تعلمون، سيكون مهرجان عيد
.ميلادي لهذا العام مختلفًا قليلاً

64
00:05:45,190 --> 00:05:50,790
طلب منّي العمدة
.تقديم متدربيّ في عرضي

65
00:05:50,790 --> 00:05:52,120
!سيّد غاستون

66
00:05:52,120 --> 00:05:56,620
لكن لا يمكنني اصطحاب
.سوى عدد قليل منكم

67
00:05:56,620 --> 00:05:59,380
من ستصطحب؟ زينت؟

68
00:05:59,380 --> 00:06:01,730
.اهدأ يا تانان

69
00:06:01,730 --> 00:06:03,430
.لم أقرّر بعد

70
00:06:03,710 --> 00:06:11,010
لكنّني أنوي اصطحاب أولئك الّذين
.اجتهدوا أكثر في التّدريب

71
00:06:11,650 --> 00:06:15,060
ستكون هذه أوّل مرّة أعرض فيها
.متدربيّ على العالم أجمع

72
00:06:15,630 --> 00:06:19,150
.آمل ألاّ تخيّبوا أملي

73
00:06:20,440 --> 00:06:23,020
.حسنًا، لن يقع الاختيار على بيرو

74
00:06:23,020 --> 00:06:25,270
.لم يتوهّج أيٌّ من أقنعته حتّى الآن

75
00:06:27,710 --> 00:06:31,310
.كفى يا تانان، لا يزال بيرو صغيرًا

76
00:06:31,310 --> 00:06:32,850
.ما زال أمامه وقت ليتعلّم

77
00:06:36,970 --> 00:06:39,930
.أراك الأسبوع المقبل يا معلّمي

78
00:06:39,930 --> 00:06:41,720
.أراك حينها

79
00:06:45,490 --> 00:06:50,130
هل ستطلب من المعلّم صنع
.قناع جديد لك؟ هذا غير عادل

80
00:06:50,130 --> 00:06:50,990
—لن أفعل

81
00:06:50,990 --> 00:06:55,970
أراهن أنّك ستذهب إلى المهرجان
.حتّى إن لم يقع عليك الاختيار

82
00:06:55,970 --> 00:06:59,920
.ليتني تُركتُ وحيدًا وربّاني المعلّم

83
00:07:00,620 --> 00:07:04,680
أيّها الأحمق، ستقتلك أمّك
.لو سمعتك تقول ذلك

84
00:07:04,680 --> 00:07:06,310
...زينت

85
00:07:06,310 --> 00:07:09,900
.بيرو، أنت دائمًا عابس

86
00:07:10,270 --> 00:07:13,270
.لأنّني فاشل

87
00:07:15,520 --> 00:07:18,410
.نحتُك لهذا القناع جميل، أحسنت

88
00:07:18,820 --> 00:07:20,430
.يجدر بك أن تتعلّم منه يا تانان

89
00:07:20,430 --> 00:07:22,050
أحقًّا؟

90
00:07:23,030 --> 00:07:25,790
.لن تستجيب أقنعتك لوجه كهذا

91
00:07:25,790 --> 00:07:27,210
وجهي؟

92
00:07:32,420 --> 00:07:34,720
.صانع الأقنعة لا يكون جبانًا

93
00:07:35,760 --> 00:07:39,060
.لا تدع الآخرين يستضعفونك

94
00:07:39,060 --> 00:07:43,030
حدّق في عينيْ كلّ من يحاول
.معاملتك كالأحمق

95
00:07:47,310 --> 00:07:50,350
لقد صُدمتَ لأنّ قناع كانّا
توهّج، أليس كذلك؟

96
00:07:50,840 --> 00:07:53,770
.نحن في العمر نفسه

97
00:07:53,770 --> 00:07:57,160
.بل حتّى أنّي بدأتُ التّدريب قبلها

98
00:07:58,600 --> 00:08:01,060
،هل تعلم أنّ أقنعة دارما

99
00:08:01,060 --> 00:08:04,750
،وهو أحد أعظم ثلاثة صانعي أقنعة
معروضة في البلدة المجاورة؟

100
00:08:04,750 --> 00:08:07,760
يفكّر بعضنا في ركوب القطار
.للذّهاب ورؤيتها

101
00:08:07,760 --> 00:08:09,080
هل تريد المجيء معنا؟

102
00:08:09,080 --> 00:08:11,570
ماذا؟ أأنت جادّ يا زينت؟

103
00:08:11,570 --> 00:08:14,920
.قال المعلّم أنّه لا يزال يتعلّم

104
00:08:14,920 --> 00:08:17,580
.لكنّني لا أملك ثمن تذكرة القطار

105
00:08:17,580 --> 00:08:23,780
لا تقلق، يمكننا شراء التّذاكر
إذا جمعنا مالنا معًا، اتّفقنا؟

106
00:08:25,310 --> 00:08:28,370
.إذًا اتّفقنا، لا تخبر المعلّم

107
00:08:30,770 --> 00:08:32,840
هل ستصطحب بيرو حقًّا؟

108
00:08:32,840 --> 00:08:36,750
لن نجمع ما يكفي من المال
.إن لم نُشرك بيرو

109
00:08:36,750 --> 00:08:38,720
.وعليك دعوة المزيد من الأشخاص أيضًا

110
00:08:38,720 --> 00:08:39,460
!ماذا؟

111
00:08:40,510 --> 00:08:44,300
كان زينت متدرّبًا موهوبًا
.بدرجة استثنائيّة

112
00:08:44,910 --> 00:08:49,960
...كان مشاغبًا محبوبًا ومهرّجًا مخيفًا

113
00:08:50,630 --> 00:08:52,270
.لكنّه كان لطيفًا أحيانًا

114
00:08:56,010 --> 00:08:58,090
إلى أين تذهب يا بيرو؟

115
00:08:58,570 --> 00:09:01,800
.ماذا؟ كانّا؟ لستُ ذاهبًا إلى أيّ مكان

116
00:09:01,800 --> 00:09:04,530
.كاذب، لقد سمعتُ حديثكم

117
00:09:04,530 --> 00:09:06,690
.سأذهب معكم، أخبرني

118
00:09:06,690 --> 00:09:07,610
.مستحيل

119
00:09:07,610 --> 00:09:08,760
!سأذهب

120
00:09:08,760 --> 00:09:11,020
!سأذهب معكم أيضًا

121
00:09:56,440 --> 00:09:58,680
.هيّا، استيقظي

122
00:09:58,680 --> 00:10:00,580
.ستؤذين نفسك إن تعثّرت

123
00:10:02,270 --> 00:10:05,360
...بيرو؟ وكانّا أيضًا

124
00:10:05,360 --> 00:10:08,340
استيقظتما مبكّرًا، هل ستذهبان إلى مكان ما؟

125
00:10:08,340 --> 00:10:10,160
...كنّا... نحن

126
00:10:10,160 --> 00:10:11,480
!أكاني

127
00:10:11,480 --> 00:10:16,220
سنركب القطار إلى البلدة المجاورة
!مع زينت وتانان

128
00:10:16,220 --> 00:10:18,900
أنتم الأربعة فقط؟
ألن يرافقكم أيّ بالغ؟

129
00:10:18,900 --> 00:10:21,050
.لم نخبر السّيّد غاستون، إنّه سرّ

130
00:10:28,540 --> 00:10:30,320
.يا لكم من أطفال مشاغبين

131
00:10:32,490 --> 00:10:34,660
.مُدّا أيديكما

132
00:10:35,600 --> 00:10:36,490
.تفضّلا

133
00:10:38,040 --> 00:10:39,900
!شكرًا يا أكاني

134
00:10:40,180 --> 00:10:43,710
.كونا حذرين وعودا سالمين

135
00:10:43,710 --> 00:10:48,500
.بيرو، أنت رجل
.ومن واجبك حماية كانّا

136
00:10:52,280 --> 00:10:53,550
هل ستذهب إلى مكان ما؟

137
00:10:53,930 --> 00:10:56,370
لزيارة بعض القبور. لا أظنّك
مهتمّة بالمجيء، أليس كذلك؟

138
00:10:56,950 --> 00:10:59,560
بيرو، هل أنت بخير؟

139
00:10:59,560 --> 00:11:01,890
ليس عليك الذّهاب
.إن كان الأمر يؤلمك كثيرًا

140
00:11:02,320 --> 00:11:08,350
كنتُ أرى وجوه الجميع في أحلامي
.كلّ ليلة، وكان ذلك يمنعني من النّوم

141
00:11:08,680 --> 00:11:11,190
.لكنّ ذلك توقّف مؤخّرًا

142
00:11:12,730 --> 00:11:14,820
.بما أنّني عدت إلى هنا، فعليّ الذّهاب

143
00:11:14,820 --> 00:11:17,010
.سيغضبون منّي إن لم أفعل

144
00:11:17,700 --> 00:11:18,740
.سأعود لاحقًا

145
00:11:19,580 --> 00:11:22,190
.حسنًا، أراك لاحقًا

146
00:11:23,900 --> 00:11:26,050
ماذا؟ أهذا كلّ ما لدينا؟

147
00:11:26,050 --> 00:11:28,450
.هذا لا يكفي لركوب القطار

148
00:11:28,770 --> 00:11:31,510
تانان، ألن يأتي أحد غيرنا؟

149
00:11:31,510 --> 00:11:34,480
.أخبرتك يا زينت، قال الجميع أنّهم مشغولون

150
00:11:35,300 --> 00:11:37,510
ماذا نفعل؟ أنعود إلى المنزل؟

151
00:11:38,350 --> 00:11:39,990
.فلنذهب سيرًا على الأقدام

152
00:11:41,400 --> 00:11:43,110
عمّ تتحدّث؟

153
00:11:43,110 --> 00:11:45,340
هل لديك أدنى فكرة عن بُعد المسافة؟

154
00:11:48,520 --> 00:11:50,730
.لا، هيّا بنا

155
00:11:50,730 --> 00:11:52,520
.بيرو محقّ

156
00:11:52,520 --> 00:11:55,020
يمكننا الوصول سيرًا في نصف يوم
.إذا اتّبعنا مسار السّكّة الحديديّة

157
00:11:55,020 --> 00:11:56,900
.وسنتمكّن من العودة قبل حلول اللّيل

158
00:11:56,900 --> 00:11:58,300
أحقًّا؟

159
00:11:59,080 --> 00:12:00,780
!حسنًا، هيّا بنا

160
00:12:24,120 --> 00:12:26,930
بيرو، هل سبق أن رأيتها؟

161
00:12:27,130 --> 00:12:31,850
هناك امرأة ذات صدر ضخم
.في المقهى أسفل التّلّ

162
00:12:32,190 --> 00:12:36,430
.لم أرها قطّ، فأنا لا أخرج كثيرًا

163
00:12:36,430 --> 00:12:39,130
ألا يصطحبك المعلّم إلى أيّ مكان؟

164
00:12:39,130 --> 00:12:42,930
يذهب السّيّد غاستون دائمًا
.إلى مكان ما في أيّام عطلتنا

165
00:12:42,930 --> 00:12:47,490
.حقًّا؟ إذًا فلنذهب معًا في وقت ما

166
00:12:47,770 --> 00:12:49,940
.في الواقع، لم أذهب إليها أنا أيضًا

167
00:12:50,580 --> 00:12:54,380
أتذكّر أنّني كنت أظنّ أنّ تانان
.مجرّد متدرّب أكبر سنًّا ولئيم

168
00:12:54,380 --> 00:12:57,410
لكنّني كنت أشعر أحيانًا
.أنّه قد لا يكون كذلك

169
00:12:57,670 --> 00:13:00,130
ماذا؟ هل صادفتما الآنسة أكاني؟

170
00:13:00,130 --> 00:13:00,750
.نعم

171
00:13:01,040 --> 00:13:03,490
.تبًّا، ستخبر معلّمنا

172
00:13:03,490 --> 00:13:05,140
.علينا العودة بسرعة

173
00:13:37,510 --> 00:13:38,710
!سأسبقكم

174
00:13:39,330 --> 00:13:41,400
!مهلاً، انتظرا

175
00:13:48,720 --> 00:13:49,810
!كانّا

176
00:13:56,190 --> 00:13:58,240
!هذا مؤلم

177
00:14:21,430 --> 00:14:24,430
،لم يُرِد زينت الوقوع في المتاعب مع الكبار

178
00:14:24,430 --> 00:14:29,370
لذا قرّرنا مغادرة مسار السّكّة الحديديّة
.وسلك طريق مختصر إلى البلدة المجاورة

179
00:14:33,860 --> 00:14:35,790
!قناع التّنّين النّاريّ

180
00:14:37,840 --> 00:14:40,180
!أجل! لقد اشتعلت النّار

181
00:14:40,180 --> 00:14:43,740
تنّين السّيّد غاستون النّاريّ
.أكثر إبهارًا من هذا

182
00:14:44,030 --> 00:14:47,690
.آسف، لقد أفسدتُ الأمر
.لم أتوقّع أن نضلّ الطّريق

183
00:14:48,510 --> 00:14:52,350
عندما يطلع الفجر، سنتتبّع
.خطواتنا ونعود إلى أيريس

184
00:14:52,350 --> 00:14:53,150
.حسنًا

185
00:14:54,620 --> 00:14:56,440
.أنا جائعة

186
00:14:58,110 --> 00:14:59,600
.يمكنك تناول هذه

187
00:14:59,600 --> 00:15:00,540
.لا أريدها

188
00:15:00,540 --> 00:15:01,110
ماذا؟

189
00:15:01,110 --> 00:15:02,700
.كُلها أنت

190
00:15:04,230 --> 00:15:06,400
تانان، من أين حصلت على ذلك الخبز؟

191
00:15:06,400 --> 00:15:10,000
ماذا؟ أحضرته معي من المنزل
.تحسّبًا لشعوري بالجوع

192
00:15:10,000 --> 00:15:11,520
!أعطني بعضًا منه

193
00:15:11,520 --> 00:15:12,470
!مستحيل

194
00:15:12,970 --> 00:15:15,230
!قلت لك مستحيل

195
00:15:23,570 --> 00:15:26,280
كانّا، تُقيمين في السّكن الدّاخليّ، صحيح؟

196
00:15:26,650 --> 00:15:27,900
هل منزلك بعيد؟

197
00:15:27,900 --> 00:15:30,530
.نعم، يستغرق الوصول إليه يومين بالقطار

198
00:15:30,530 --> 00:15:34,200
.حقًّا؟ لا أصدّق أنّ والديك سمحا لك بذلك

199
00:15:34,200 --> 00:15:40,720
،كان أبي يحلم بأن يصبح صانع أقنعة
.لذا يريدني أن أصبح كذلك

200
00:15:40,720 --> 00:15:42,220
.يبدو أنّ مستقبلك واعد

201
00:15:44,590 --> 00:15:45,660
ما كان ذلك؟

202
00:15:45,660 --> 00:15:46,840
.ربّما كان كلبًا ضالاًّ

203
00:15:46,840 --> 00:15:48,700
.إنّها تخاف من النّار

204
00:15:48,700 --> 00:15:50,340
.لن يصيبنا مكروه ما دمنا نبقي النّار مشتعلة

205
00:15:54,780 --> 00:15:59,470
،لم أخبر أحدًا بهذا من قبل
لا تخبروا الآخرين، اتّفقنا؟

206
00:15:59,760 --> 00:16:00,920
ما الأمر؟

207
00:16:00,920 --> 00:16:04,910
حلمي هو أن أصبح
.أفضل صانع أقنعة في العالم

208
00:16:04,910 --> 00:16:06,760
مثل السّيّد غاستون؟

209
00:16:06,760 --> 00:16:09,590
.أيّها الأحمق، عندها لن أكون الأفضل

210
00:16:11,120 --> 00:16:13,170
.سأتفوّق حتّى عليه

211
00:16:13,170 --> 00:16:18,230
سأتفوّق على العظماء الثّلاثة جميعًا
.وأصبح صانع الأقنعة الأوّل في العالم

212
00:16:18,230 --> 00:16:22,680
هذا مذهل، أراهن أنّ لا أحد
.غيرك فكّر في ذلك

213
00:16:23,940 --> 00:16:28,340
،وبدءًا من زينت
.شرعنا نخبر بعضنا بأحلامنا

214
00:16:28,670 --> 00:16:32,190
لم يسبق لي أن سمعت أحدًا
،يتحدّث عن أحلامه

215
00:16:32,190 --> 00:16:36,300
لذا تمنّيت لو تدوم تلك اللّحظة
.لأطول وقت ممكن

216
00:16:36,830 --> 00:16:40,380
.أريد صنع تنّين وأستخدمه للطّيران

217
00:16:40,380 --> 00:16:42,480
!هذا رائع يا تانان

218
00:16:42,480 --> 00:16:45,460
حينها، سأتمكّن من الهرب
.عندما تغضب أمّي منّي

219
00:16:45,460 --> 00:16:48,650
لن تنجح في صنعه حتّى بعد مائة
.عام إن كان هذا هو دافعك

220
00:16:49,100 --> 00:16:50,020
ماذا عنك يا بيرو؟

221
00:16:50,020 --> 00:16:51,000
ماذا؟

222
00:16:55,570 --> 00:16:58,160
.في الواقع، حلمي يشبه حلمك يا زينت

223
00:16:58,160 --> 00:17:02,370
أريد أن أتفوّق على معلّمنا وأصبح
.أفضل صانع أقنعة في العالم

224
00:17:02,370 --> 00:17:03,650
حقًّا؟

225
00:17:03,650 --> 00:17:05,290
.إذًا فنحن منافسان

226
00:17:09,990 --> 00:17:12,010
.سنتناوب نحن الثّلاثة على الحراسة

227
00:17:12,880 --> 00:17:14,000
هل تستطيع ذلك؟

228
00:17:14,340 --> 00:17:15,380
.نعم

229
00:17:25,720 --> 00:17:28,000
زينت، هل أنت مستيقظ؟

230
00:17:28,000 --> 00:17:29,800
ألا تستطيع النّوم؟

231
00:17:29,800 --> 00:17:33,050
.أشعر بأنّ رأسي مشوّش

232
00:17:36,610 --> 00:17:40,190
آسف، كنت تريد رؤية
أقنعة دارما، أليس كذلك؟

233
00:17:42,650 --> 00:17:46,560
بماذا تفكّر عندما تصنع الأقنعة؟

234
00:17:46,560 --> 00:17:49,130
ماذا؟ أتريد معرفة أسراري؟

235
00:17:49,330 --> 00:17:51,160
.لا توجد طرق مختصرة

236
00:17:51,160 --> 00:17:54,640
،أنا بارع في ذلك فحسب
.هذا كلّ ما في الأمر

237
00:17:55,050 --> 00:17:59,510
وأظنّ أنّني أراقب الكائنات
.الحيّة عن كثب أيضًا

238
00:17:59,510 --> 00:18:01,640
.فذلك يسهّل عليّ تخيّل أشكالها

239
00:18:01,640 --> 00:18:04,820
.أنت مذهل يا زينت

240
00:18:04,820 --> 00:18:07,190
.أثنى عليك المعلّم قبل أيّام أيضًا

241
00:18:15,640 --> 00:18:16,700
!زينت

242
00:18:46,060 --> 00:18:47,500
.حمدًا على هذا

243
00:18:47,500 --> 00:18:48,780
...زينت

244
00:18:48,780 --> 00:18:52,790
.كلّ ما يفعله هذا الشّيء هو إحداث ضجيج

245
00:18:52,790 --> 00:18:54,770
.لكُنّا متنا لو هاجمنا

246
00:18:57,230 --> 00:19:00,020
مـ-مهلاً، لماذا تبكي؟

247
00:19:00,020 --> 00:19:05,580
أنا في الحقيقة لا أريد
.أن أصبح أفضل صانع أقنعة

248
00:19:05,580 --> 00:19:07,770
.ليس لديّ أيّ أحلام عظيمة

249
00:19:07,770 --> 00:19:10,590
كلّ ما أريده هو أن ينال عملي
!إعجاب السّيّد غاستون

250
00:19:10,590 --> 00:19:11,900
.بيرو

251
00:19:11,900 --> 00:19:14,640
.لا أجيد فعل أيّ شيء

252
00:19:15,040 --> 00:19:21,180
.ربّما لهذا السّبب تخلّى عنّي والداي

253
00:19:23,340 --> 00:19:27,290
،ستتعلّم صنع الأقنعة أنت أيضًا
.وأراهن أنّ ذلك سيحدث قريبًا

254
00:19:28,050 --> 00:19:30,410
.لذا لا تبكِ يا بكّاء

255
00:19:32,020 --> 00:19:37,190
،علاقتي بأمّي ليست على ما يرام
.ونادرًا ما نتحدّث معًا

256
00:19:37,770 --> 00:19:41,950
.لكنّها أثنت عليّ مرّة وأنا أصنع قناعًا

257
00:19:42,860 --> 00:19:46,700
إيّاك أن تخبر أحدًا، مفهوم؟
.سأقتلك إن فعلت

258
00:19:48,490 --> 00:19:50,700
تفضّل، كان إزميلك مكسورًا، صحيح؟

259
00:19:53,010 --> 00:19:54,190
أأنت متأكّد؟

260
00:19:54,750 --> 00:20:00,090
بعد انتهاء الدّروس، تتسلّل دائمًا لتُخرج
أقنعة المعلّم وتتدرّب على نحتها، صحيح؟

261
00:20:00,940 --> 00:20:05,200
،من بين جميع تلاميذه
.أنت أكثر من يتأمّل أقنعته ويدرسها

262
00:20:05,200 --> 00:20:08,010
.لذا ستتوهّج أقنعتك أنت أيضًا

263
00:20:08,640 --> 00:20:10,800
.أضمن لك ذلك

264
00:20:12,620 --> 00:20:13,740
.نعم

265
00:20:19,430 --> 00:20:24,270
في النّهاية، لم نبتعد عن البلدة سوى
.بضعة كيلومترات قبل أن نعود

266
00:20:24,650 --> 00:20:26,420
.كانت مغامرة صغيرة

267
00:20:27,090 --> 00:20:32,630
.لكنّ ذلك اليوم غيّر حياتي

268
00:20:33,040 --> 00:20:35,590
.كان المعلّم غاضبًا منّا بشدّة

269
00:20:36,220 --> 00:20:41,410
كانت تلك المرّة الوحيدة الّتي
.رأيتُه فيها بهذا القدر من الغضب

270
00:20:44,460 --> 00:20:47,930
،عندما أفكّر في الأمر الآن
أظنّ أنّ زينت لم يرني

271
00:20:47,930 --> 00:20:51,520
.إلاّ كمتدرّب أصغر سنًّا لا أكثر

272
00:20:52,310 --> 00:20:56,430
.لكنّ زينت هو من عثر عليّ في ذلك اليوم

273
00:21:02,520 --> 00:21:03,930
!زينت

274
00:21:13,350 --> 00:21:15,500
.عليّ شراء بعض الزّهور

275
00:21:17,200 --> 00:21:18,710
.تبًّا

276
00:21:43,520 --> 00:21:45,780
.لقد جاء شخص آخر

277
00:21:47,440 --> 00:21:49,090
من يكون يا تُرى؟

278
00:23:20,800 --> 00:23:23,020
.وصلنا إلى أيريس

279
00:23:23,020 --> 00:23:27,460
كان مهرجان عيد ميلاد غاستون
،قد أضفى البهجة على البلدة بأكملها

280
00:23:27,460 --> 00:23:30,330
.لكنّ بيرو كان منشغل البال بأمر ما

281
00:23:30,820 --> 00:23:35,280
ظهرت أمامنا مجموعة غامضة
،ترتدي ملابس سوداء

282
00:23:35,280 --> 00:23:37,590
...لكن خلف أقنعتهم

283
00:23:37,590 --> 00:23:40,930
ماذا؟ بيرو، هل تعرف تلك المرأة؟

284
00:23:41,310 --> 00:23:45,590
:في الحلقة السّابعة القادمة
."قناع أرواح الموتى"

285
00:23:46,030 --> 00:23:48,470
!وتبدأ رحلة الأقنعة