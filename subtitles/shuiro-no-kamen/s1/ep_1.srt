1
00:00:29,170 --> 00:00:30,820
.لا فائدة يا فتى

2
00:00:30,820 --> 00:00:33,480
.لا يمكنك قتلي بتلك الطّريقة

3
00:02:22,950 --> 00:02:25,910
!تفضّلوا بالاقتراب لمشاهدة بضائعي

4
00:02:25,910 --> 00:02:30,120
!أنا صانع أقنعة نادرة وغريبة

5
00:02:30,120 --> 00:02:32,790
...قناع اليوم المميّز هو

6
00:02:32,790 --> 00:02:35,420
!ها هو ذا! قناع الابتسامات

7
00:02:35,420 --> 00:02:38,880
.ارتدوه، ولن تصدّقوا ما تراه أعينكم

8
00:02:38,880 --> 00:02:41,970
...إنّه يلتصق بالرّأس

9
00:02:43,550 --> 00:02:46,600
!ويرسم ابتسامة على وجه أيّ شخص

10
00:02:48,020 --> 00:02:52,650
،طريقة التصاقه مثيرة للإعجاب
.لكنّك كنت تبتسم طوال الوقت

11
00:02:53,860 --> 00:02:55,400
!أنت أصلع

12
00:02:56,860 --> 00:02:58,110
.هيّا بنا

13
00:02:58,110 --> 00:03:00,310
!انتظروا! لا تذهبوا

14
00:03:02,530 --> 00:03:08,330
هذا غريب. ظننتُ أنّ الطّلب سيكون
.كبيرًا على هذا القناع في هذه المدينة

15
00:03:08,330 --> 00:03:11,040
.فالجميع يبدون محبطين وكئيبين

16
00:03:11,290 --> 00:03:13,000
.ربّما يكون الوضع الاقتصاديّ سيّئًا

17
00:03:13,250 --> 00:03:17,210
شخصيًّا، أعتقد أنّ هذا هو الوقت
.الّذي يحتاج فيه النّاس إلى الابتسامات

18
00:03:17,800 --> 00:03:19,510
.اعذرنا

19
00:03:19,760 --> 00:03:22,470
هل أنت صانع أقنعة أيّها الشّابّ؟

20
00:03:22,470 --> 00:03:24,140
ما الّذي يمكنني فعله من أجلكم يا صغار؟

21
00:03:24,140 --> 00:03:27,720
.نعتقد أنّ صُنّاع الأقنعة رائعون للغاية

22
00:03:27,720 --> 00:03:30,390
هل يمكننا الحصول على توقيعك؟

23
00:03:30,640 --> 00:03:34,480
.لا بأس بذلك، يمكنكم الحصول عليه إن أردتم

24
00:03:34,480 --> 00:03:36,110
!مـ-مرحى

25
00:03:37,070 --> 00:03:39,530
.صنّاع الأقنعة مذهلون حقًّا

26
00:03:39,530 --> 00:03:43,410
تمنح الأقنعة الّتي يصنعونها
قوىً خاصّة، أليس كذلك؟

27
00:03:43,410 --> 00:03:48,030
سمعتُ أنّ صنع أقنعة ذات قوىً
.يتطلّب سنوات من التّدريب

28
00:03:48,030 --> 00:03:50,120
.مهلاً، يبدو أنّك خبير في هذا

29
00:03:50,120 --> 00:03:52,410
.نعم، نحن نحبّ صُنّاع الأقنعة

30
00:03:52,410 --> 00:03:55,880
أتعرف ذلك الصّانع مشهور، أليس كذلك؟

31
00:03:55,880 --> 00:03:58,750
.أعتقد أنّ اسمه غاستون رو

32
00:04:00,340 --> 00:04:03,300
.عذرًا، لقد غيّرت رأيي
.لن أعطي توقيعي لأيّ أحد اليوم

33
00:04:03,300 --> 00:04:04,050
ماذا؟

34
00:04:05,510 --> 00:04:08,260
!ماذا؟! لقد اختفى! أحدهم سرقه

35
00:04:08,260 --> 00:04:10,220
!أين هو؟

36
00:04:10,930 --> 00:04:13,560
أتظنّان أنّ سونا قد هربت؟

37
00:04:13,560 --> 00:04:15,690
.لنلتقِ في مكاننا المعتاد

38
00:04:16,560 --> 00:04:18,190
.أيّها الأطفال

39
00:04:28,370 --> 00:04:33,160
!إنّه مغلّف بإحكام، فلا بدّ أن بداخله كنزًا

40
00:04:33,160 --> 00:04:37,750
،لا يبدو القفل معقّدًا للغاية
.لذا ينبغي أن أتمكّن من فتحه

41
00:04:39,500 --> 00:04:43,010
.أشعر وكأنّني رأيت هذا من قبل

42
00:04:43,420 --> 00:04:46,180
...عفوًا... عفوًا

43
00:04:44,630 --> 00:04:46,590
ماذا؟ ماذا؟

44
00:04:46,590 --> 00:04:47,550
!عفوًا

45
00:04:48,760 --> 00:04:51,350
عذرًا، هل يمكنك فتح هذا؟

46
00:04:51,350 --> 00:04:52,720
.أنا أرجوك

47
00:04:52,970 --> 00:04:56,060
.لم أسمع قطّ عن كنز يتحدّث

48
00:04:56,060 --> 00:04:57,600
...لا بدّ أنّه

49
00:04:57,600 --> 00:05:00,110
!باهظ الثّمن

50
00:05:00,110 --> 00:05:01,730
.لا تحاولي حتّى

51
00:05:02,030 --> 00:05:03,190
ماذا؟

52
00:05:03,860 --> 00:05:06,820
.هذا الشّيء مهمّ جدًّا بالنّسبة لي

53
00:05:06,820 --> 00:05:09,410
.كانت سرقته تصرّفًا جريئًا جدًّا منك

54
00:05:09,660 --> 00:05:11,620
متى وصل إلى هنا؟

55
00:05:11,620 --> 00:05:15,000
.اهدأ. عثرتُ عليه في الشّارع فحسب

56
00:05:15,000 --> 00:05:17,000
.لا تتظاهري بالغباء معي يا فتاة

57
00:05:17,670 --> 00:05:21,840
هل ستؤذي طفلة صغيرة؟
.أنت شخصٌ حقير

58
00:05:22,300 --> 00:05:24,170
.لا تحاولي خداعي

59
00:05:24,170 --> 00:05:27,050
،تلك الحيلة تنطلي على الطّيّبين فقط

60
00:05:27,050 --> 00:05:29,930
.وأنا الأسوأ بين الأسوأ هنا

61
00:05:32,720 --> 00:05:33,810
!هذا مؤلم

62
00:05:33,810 --> 00:05:38,190
حسنًا، من الأفضل أن آخذك
.إلى حيث يجب أن تكوني

63
00:05:38,190 --> 00:05:41,770
أيّها الشّابّ، هل لديك بعض الوقت؟

64
00:05:42,020 --> 00:05:42,860
من أنت؟

65
00:05:42,860 --> 00:05:43,730
...تبًّا

66
00:05:43,730 --> 00:05:46,190
.أنا توتوك من فيلق الإدارة

67
00:05:46,740 --> 00:05:48,530
.تشرّفت بلقائك

68
00:05:51,370 --> 00:05:53,370
أي أنّك شرطيّ، صحيح؟

69
00:05:53,370 --> 00:05:55,290
—ممتاز. خذ هذه اللّصّة و

70
00:05:55,290 --> 00:06:01,380
قبل ذلك، بيع الأقنعة في الشّارع
.ممنوع في مدينة ليسبلان

71
00:06:01,380 --> 00:06:04,590
هل يمكنك إيداع أغراضك والمجيء معي؟

72
00:06:04,880 --> 00:06:06,300
وإذا قلتُ لا؟

73
00:06:08,010 --> 00:06:09,720
.مهلاً، هذا مبالغ فيه بعض الشّيء

74
00:06:09,720 --> 00:06:11,220
ماذا كنت تتوقّع؟

75
00:06:11,220 --> 00:06:17,140
بيرو داريست، أنت مجرم
.مطلوب في عدّة دول

76
00:06:17,140 --> 00:06:19,430
.أرى أنّك قمتَ ببحثك جيّدًا

77
00:06:19,430 --> 00:06:22,230
.كنتَ آخر تلميذ لغاستون رو

78
00:06:22,230 --> 00:06:24,770
والآن صرتَ رجلاً مطلوبًا يتنقل هنا وهناك

79
00:06:24,770 --> 00:06:27,570
.محطّمًا الأقنعة الّتي توزّعت في أنحاء العالم

80
00:06:27,570 --> 00:06:30,450
ما الّذي تسعى إليه؟ قناع مملكتنا؟

81
00:06:31,410 --> 00:06:34,780
،إذا لاحظتُ أيّ حركة لا تعجبني
.فسأقطع حنجرتها

82
00:06:34,780 --> 00:06:35,790
!جبان

83
00:06:35,790 --> 00:06:37,040
.سيّدي، لقد نال منّا

84
00:06:37,040 --> 00:06:37,830
.صوّبوا

85
00:06:40,250 --> 00:06:41,880
.سيطلق توتوك بكلّ تأكيد

86
00:06:41,880 --> 00:06:44,000
.لن يجدي ذلك نفعًا ضدّه

87
00:06:44,290 --> 00:06:47,460
!انتظروا رجاءً! سونا صديقتنا

88
00:06:49,760 --> 00:06:54,930
،تمامًا كما أنّ بعض الشّرور ضروريّة
.فكذلك بعض التّضحيات

89
00:06:54,930 --> 00:06:58,220
.آه يا فتى، أنا أدرك ألمك تمامًا

90
00:06:58,220 --> 00:06:59,890
.أنت على وشك فقدان صديقة

91
00:06:59,890 --> 00:07:02,940
.قد يجعلك الألم ترغب في الموت

92
00:07:02,940 --> 00:07:05,650
!لكنّ هذا هو ما يجعل النّاس أقوى

93
00:07:05,650 --> 00:07:08,900
.عليك أن تشكر صديقتك لمنحك هذه الفرصة

94
00:07:09,190 --> 00:07:10,480
.والآن ادعُ لها

95
00:07:10,480 --> 00:07:13,700
هذا كلّ ما بوسعنا فعله
.لأولئك الّذين يوشكون على الموت

96
00:07:14,370 --> 00:07:19,570
مع وجود أمثالك في السّلطة، لا عجب
.أنّ الجميع في المدينة مكتئبون

97
00:07:19,570 --> 00:07:21,210
.تشبّثي بظهري

98
00:07:22,120 --> 00:07:22,870
.أطلقوا

99
00:07:24,130 --> 00:07:25,670
.قناع العنكبوت

100
00:07:26,040 --> 00:07:27,380
!ا-اختفى؟

101
00:07:30,670 --> 00:07:32,760
!ما هو هذا؟

102
00:07:33,010 --> 00:07:34,220
!مذهل

103
00:07:34,510 --> 00:07:35,430
!عجبًا

104
00:07:46,650 --> 00:07:49,480
.عليّ إبلاغ مولاي غوون بهذا

105
00:07:49,480 --> 00:07:50,400
!توتوك

106
00:07:51,780 --> 00:07:52,570
!إيّاك

107
00:07:52,570 --> 00:07:54,660
!لم يعد بإمكاني اتّباع أوامرك

108
00:07:54,660 --> 00:07:57,120
!البلد الّذي لا يحمي أطفاله لا مستقبل له

109
00:07:57,120 --> 00:07:58,700
ما اسمك؟

110
00:07:58,700 --> 00:07:59,450
!غلين

111
00:07:59,740 --> 00:08:01,080
.غلين

112
00:08:04,960 --> 00:08:06,710
.أنت رجل شجاع

113
00:08:06,710 --> 00:08:11,090
.لن أنسى اسمك أبدًا

114
00:08:14,430 --> 00:08:17,300
!الشّرطة العسكريّة في هذا البلد مجنونة

115
00:08:17,300 --> 00:08:19,140
ما الّذي يحدث هنا؟

116
00:08:19,510 --> 00:08:23,270
،منذ تغيير النّظام قبل بضعة أشهر
.باتوا يعتمدون على سياسة التّرهيب

117
00:08:23,270 --> 00:08:26,190
.عجبًا. أنت تجيدين استخدام كلمات منمّقة

118
00:08:26,190 --> 00:08:27,980
!لا-لا تسخر منّي

119
00:08:30,070 --> 00:08:33,650
هل صحيح أنّك هنا من أجل قناع المملكة؟

120
00:08:33,650 --> 00:08:37,990
.نعم. جئت إلى هذا البلد لأدمرّ قناع غاستون

121
00:08:37,990 --> 00:08:41,410
.لكن يبدو أنّ الوضع معقّد

122
00:08:41,410 --> 00:08:44,120
.أنا أعرف مكان القناع

123
00:08:45,580 --> 00:08:47,080
ماذا تريدين؟

124
00:08:47,580 --> 00:08:49,750
.اشترِ لي العشاء

125
00:08:51,210 --> 00:08:54,260
تلميذ غاستون؟

126
00:08:54,260 --> 00:08:57,260
.يبدو أنّه قادر على صنع أقنعة قويّة

127
00:08:57,260 --> 00:09:00,390
.أمرتُ رجالي بتحديد مكان اختبائه

128
00:09:00,390 --> 00:09:01,760
.لن تكون هناك حاجة لذلك

129
00:09:02,140 --> 00:09:08,230
إذا كان إصراره حقيقيًّا، فسيأتي
.إلى هنا للحصول على كنزنا

130
00:09:08,230 --> 00:09:10,690
هل سيتحدّى أقوى محارب في العالم؟

131
00:09:10,690 --> 00:09:13,690
.لن يكون جديرًا بغاستون إن لم يفعل ذلك

132
00:09:14,530 --> 00:09:20,240
اجمع كلّ المعلومات الممكنة عن
.هذا المدعو بيرو خدمةً لهدفنا

133
00:09:21,870 --> 00:09:25,160
.كما تشاء يا مولاي غوون

134
00:09:28,000 --> 00:09:31,090
.نعم، هذا هو بالتّأكيد

135
00:09:31,090 --> 00:09:32,750
.أتذكّره لأنّه كان ذا شكل غريب

136
00:09:35,720 --> 00:09:37,550
.قناع تنّين النّار

137
00:09:37,550 --> 00:09:39,720
.إنّه أحد أعمال غاستون رو

138
00:09:39,720 --> 00:09:43,970
غاستون هو أحد أعظم ثلاثة
صُنّاع أقنعة في العالم، أليس كذلك؟

139
00:09:44,430 --> 00:09:47,730
،يُقال أنّ جميع أقنعته تمتلك قوىً مذهلة

140
00:09:47,730 --> 00:09:51,360
.وتبلغ قيمتها ما يكفي لشراء دولة صغيرة

141
00:09:51,360 --> 00:09:52,820
لماذا تقوم بتحطيمها؟

142
00:09:53,780 --> 00:09:55,690
.لستُ مضطرًّا لإخبارك بذلك

143
00:09:55,690 --> 00:09:58,360
سأعفيك من العقاب
،إن أخبرتني بمكان القناع

144
00:09:58,360 --> 00:10:00,120
.لذا ارحلي بمجرد انتهائك من الأكل

145
00:10:00,120 --> 00:10:02,620
.لا أظنّ أنّ هذه فكرة جيّدة

146
00:10:06,250 --> 00:10:09,370
.غدًا موعد الحفل السّنويّ للأقنعة

147
00:10:09,370 --> 00:10:11,910
وستكون الإجراءات الأمنيّة
.في القلعة صارمة للغاية

148
00:10:11,910 --> 00:10:15,800
ستواجه صعوبة في الوصول
.إلى قاعة العرش حيث يوجد القناع

149
00:10:16,460 --> 00:10:20,720
،امتنانًا لمساعدتك لي
.سأطلعك على أرجاء القلعة

150
00:10:20,720 --> 00:10:23,050
.لا، شكرًا. أنا لا أثق بك

151
00:10:23,050 --> 00:10:25,470
،علاوة على ذلك
لماذا تعرفين الكثير عن القلعة؟

152
00:10:25,470 --> 00:10:27,810
ولماذا تريدين مساعدتي؟

153
00:10:29,520 --> 00:10:31,680
.أنا هاربة

154
00:10:33,610 --> 00:10:36,030
.أنا أكره الملك الحاليّ

155
00:10:36,610 --> 00:10:39,240
.وأريد إجباره على الاعتراف بالهزيمة

156
00:10:39,490 --> 00:10:42,240
.أرجوك، خذني معك

157
00:10:44,410 --> 00:10:46,540
.تتمتّعين بجرأة كبيرة

158
00:10:46,540 --> 00:10:49,960
...قد أستخدمك كطُعم إذا اضطررت لذلك يا

159
00:10:49,960 --> 00:10:53,420
.سوناروي. الجميع ينادونني سونا

160
00:10:53,420 --> 00:10:54,590
.وأنا بيرو

161
00:10:55,250 --> 00:11:00,720
غدًا ليلاً، سنتسلّل إلى حفل الأقنعة
.ونستولي على قناع غاستون

162
00:11:18,690 --> 00:11:20,860
كيف تخطّط لدخول القلعة؟

163
00:11:20,860 --> 00:11:22,070
.كما أفعل دائمًا

164
00:11:22,320 --> 00:11:23,910
.قناع الحرباء

165
00:11:29,910 --> 00:11:30,830
!اختفيت؟

166
00:11:30,830 --> 00:11:31,750
.تمسّكي بي

167
00:11:38,880 --> 00:11:40,550
.دخلنا بسهولة بالغة

168
00:11:40,550 --> 00:11:42,340
.كان يجدر بي سرقة ذلك القناع

169
00:11:42,340 --> 00:11:43,340
.لا يمكنك الحصول عليه

170
00:11:45,810 --> 00:11:48,760
هل يوجد ممرّ سرّيّ هنا؟

171
00:11:48,760 --> 00:11:50,850
.اعتدتُ استخدامه كثيرًا وأنا طفلة

172
00:11:51,180 --> 00:11:54,940
اصعد إلى هنا، وستكون قريبًا
.من قاعة العرش حيث يوجد القناع

173
00:11:55,690 --> 00:11:59,110
على الأرجح أنّ غوون سيكون
.في مكان آخر، يُسلّي النّبلاء

174
00:11:59,110 --> 00:12:03,490
شكرًا. لستُ متحمّسًا لمواجهة
.أقوى محارب في العالم

175
00:12:06,200 --> 00:12:07,830
.الهدوء هنا مريب

176
00:12:13,370 --> 00:12:14,370
!مِن هنا

177
00:12:14,370 --> 00:12:15,210
!مهلاً

178
00:12:23,510 --> 00:12:26,510
.هذا هو المتوقّع من صانع الأقنعة بيرو

179
00:12:27,510 --> 00:12:28,970
كمين؟

180
00:12:28,970 --> 00:12:33,060
.لا تتسرّع. أودّ عقد صفقة

181
00:12:34,730 --> 00:12:36,190
صفقة؟

182
00:12:37,940 --> 00:12:39,650
!لماذا هو بحوزتك؟

183
00:12:39,860 --> 00:12:43,650
.لدينا اثنان من أقنعة غاستون

184
00:12:43,650 --> 00:12:47,320
.قناع تنّين النّار، وقناع الشّجاعة هذا أيضًا

185
00:12:47,320 --> 00:12:49,530
!كان هذا آخر أعمال معلّمي

186
00:12:49,530 --> 00:12:50,200
!أعده في الحال

187
00:12:53,160 --> 00:12:56,000
،تساءلتُ أيّ نوعٍ من الأشقياء أنت

188
00:12:56,000 --> 00:13:00,590
.لكنّك مجرّد صبيّ يلاحق ظلّ معلّمه المحبوب

189
00:13:00,880 --> 00:13:07,340
احتفظ غاستون رو
.بأخطر أعماله داخل منزله

190
00:13:07,340 --> 00:13:10,550
لكنّ لصوصًا سرقوها بعد وفاته

191
00:13:10,550 --> 00:13:15,430
.وتفرّقت في أنحاء العالم، باستثناء واحد

192
00:13:16,060 --> 00:13:17,770
إنّه بحوزتك، أليس كذلك؟

193
00:13:17,770 --> 00:13:23,230
،أروع تحفة فنّيّة لغاستون
.قناع إله الحرب بورنارت

194
00:13:23,820 --> 00:13:28,320
أُخفيت تلك التّحفة الفنّيّة
.لأنّها كانت ببساطة خطيرة للغاية

195
00:13:28,320 --> 00:13:32,660
وقعت مأساة مروّعة عندما
.ارتداه أحد تلاميذه

196
00:13:32,660 --> 00:13:38,370
هل كرهك للقناع الّذي أودى بحياة
معلّمك الحبيب هو ما يدفعك؟

197
00:13:38,370 --> 00:13:42,630
ما رأيك في هذا؟
—إذا انضممت إلينا، فهذا القناع

198
00:13:42,630 --> 00:13:43,800
!لست بحاجة إليك

199
00:13:43,800 --> 00:13:46,540
!سأسرقه كما يفعل أيّ شقيّ حقيقيّ

200
00:13:47,220 --> 00:13:50,260
.لن أسمح لتلك المأساة أن تتكرّر

201
00:13:50,260 --> 00:13:55,220
،سأدمّر كلّ أقنعة معلّمي
!واحدًا تلو الآخر

202
00:14:01,810 --> 00:14:03,320
.قناع القطّ

203
00:14:05,570 --> 00:14:07,490
.القطط حيوانات ليليّة

204
00:14:07,490 --> 00:14:11,700
إنّه الوحيد القادر على التّحرّك
.وسط هذا الظّلام

205
00:14:17,660 --> 00:14:20,460
!رائع! هذا مذهل فعلاً

206
00:14:20,460 --> 00:14:21,540
...ولكن

207
00:14:25,250 --> 00:14:26,880
كيف ستتعامل مع هذا؟

208
00:14:32,800 --> 00:14:37,640
،قناع القطّ هو الأسرع بين أقنعتي
.لكن لا تستطيع عيناي مواكبة سرعته

209
00:14:39,270 --> 00:14:40,140
!بيرو

210
00:14:46,320 --> 00:14:50,700
.أعتذر، لكنّني تلقّيتُ أمرًا بالقبض عليك حيًّا

211
00:14:55,410 --> 00:14:57,080
!غبيّة! اهربي

212
00:14:59,250 --> 00:15:03,580
.يا للعجب، إنّها الأميرة السّابقة

213
00:15:03,580 --> 00:15:04,540
ماذا؟

214
00:15:07,710 --> 00:15:09,970
هل جئتِ طلبًا للانتقام؟

215
00:15:09,970 --> 00:15:13,180
تريدين ضربي بذلك
حتّى الموت، أليس كذلك؟

216
00:15:17,310 --> 00:15:22,940
لا أدري، لكنّني لا أظنّ
.أنّ أبي أو أمّي كانا ليرغبا في ذلك

217
00:15:24,610 --> 00:15:28,110
!يا للنُّبْل! لقد تأثّرتُ حقًّا

218
00:15:33,320 --> 00:15:35,280
.قناع المحارب

219
00:15:35,280 --> 00:15:38,620
.أنتَ صلب وقويّ. يا لجمال هذا

220
00:15:38,620 --> 00:15:41,740
ولكن، ماذا بوسعك أن تفعل
وذراعك على تلك الحال؟

221
00:15:41,740 --> 00:15:44,210
.أنا معطوب

222
00:15:44,210 --> 00:15:46,880
.كنتُ الوحيد الّذي لم أكن تلميذًا حقيقيًّا

223
00:15:49,130 --> 00:15:52,130
!رسبت! أنت الوحيد الّذي لم ينجح يا بيرو

224
00:15:52,380 --> 00:15:55,340
المتدّربون المكتملون فقط
!هم من يُسمح لهم بدخول الورشة

225
00:15:55,800 --> 00:15:57,760
.مهلاً، هذا يكفي

226
00:15:57,760 --> 00:15:58,970
.سيّد غاستون

227
00:15:59,770 --> 00:16:00,970
.هيّا بنا

228
00:16:05,140 --> 00:16:08,570
،يا بيرو، ربّما فشلت هذه المرّة
.لكنّ الفرصة ستأتي مجدّدًا

229
00:16:08,570 --> 00:16:11,070
.على أيّة حال، أحسنتَ صنعًا

230
00:16:11,070 --> 00:16:13,900
—إنّ التّحلّي بشجاعة عدم الرّدّ بالمثل هي

231
00:16:19,740 --> 00:16:22,120
.لم أختر عدم الرّدّ بالمثل

232
00:16:22,410 --> 00:16:25,080
.بل لم أمتلك الشّجاعة للقيام بذلك وحسب

233
00:16:25,580 --> 00:16:27,540
لماذا أنا الوحيد؟

234
00:16:34,970 --> 00:16:37,510
ماذا؟ ألا تزال مستيقظًا؟

235
00:16:37,510 --> 00:16:39,010
.اذهب للنّوم

236
00:16:50,730 --> 00:16:52,280
!فقد بيرو صوابه

237
00:16:52,280 --> 00:16:53,940
هل دخل تلك الغرفة؟

238
00:16:53,940 --> 00:16:56,660
!اسمعوا، ذلك الشّيء ليس بشرًا

239
00:16:58,070 --> 00:16:59,530
!توقّف يا بيرو

240
00:16:59,530 --> 00:17:01,370
!لا أستطيع! يتحرّك جسدي من تلقاء نفسه

241
00:17:01,370 --> 00:17:02,370
—توقّف

242
00:17:03,290 --> 00:17:07,620
!يا رفاق! لا! ليساعدني أحدكم

243
00:17:12,920 --> 00:17:15,000
!سيّد غاستون

244
00:17:17,550 --> 00:17:21,810
.أردت فقط دراسة قناع معلّمي

245
00:17:21,810 --> 00:17:27,020
.أردتُ فقط أن يجعلني تلميذًا حقيقيًّا

246
00:17:27,730 --> 00:17:30,230
.لكنّ ذلك اليوم لن يأتي أبدًا الآن

247
00:17:32,440 --> 00:17:37,150
صنعتُ قناع المحارب هذا استنادًا
.إلى قناع إله الحرب

248
00:17:37,150 --> 00:17:39,410
.إذا دخلتَ نطاقي، فسأقضي عليك

249
00:17:39,410 --> 00:17:40,780
.يا له من كلامٍ سخيف

250
00:17:41,030 --> 00:17:43,660
.أنت لا تحمل شيئًا في يدك

251
00:17:43,660 --> 00:17:45,950
وتتحدّاني في مبارزةٍ تعتمد
على سرعة استلال السّيف؟

252
00:17:45,950 --> 00:17:47,960
.لا بدّ أنّك تظنّني أحمق

253
00:17:55,170 --> 00:17:57,010
.هذا القناع ليس مثاليًّا

254
00:17:57,010 --> 00:18:00,220
إذ لا يمكنه استحضار النّصل
.إلاّ لبضع ثوانٍ

255
00:18:00,720 --> 00:18:04,220
.لكنّه يظلّ أعظم تُحفي

256
00:18:08,640 --> 00:18:09,600
!بيرو

257
00:18:10,730 --> 00:18:13,190
عذرًا. هل يمكنك حمل حقيبتي؟

258
00:18:13,190 --> 00:18:14,980
...ماذا؟ لكن

259
00:18:14,980 --> 00:18:17,860
.لنأخذ القناع ونغادر من هنا

260
00:18:17,860 --> 00:18:20,410
أردت إجبارهم على الاعتراف
بالهزيمة، أليس كذلك؟

261
00:18:20,410 --> 00:18:21,360
.نعم

262
00:18:21,360 --> 00:18:23,830
.لا داعي للاستعجال

263
00:18:30,250 --> 00:18:31,540
!غوون

264
00:18:31,920 --> 00:18:33,290
!قناع القطّ

265
00:18:42,800 --> 00:18:44,260
!سونا

266
00:18:45,220 --> 00:18:46,760
!قناع العنكبوت

267
00:18:52,560 --> 00:18:53,940
أين غوون؟

268
00:19:02,030 --> 00:19:02,740
ما الّذي يحدث؟

269
00:19:02,450 --> 00:19:03,530
!لا أستطيع الحراك

270
00:19:02,740 --> 00:19:03,990
!النّجدة

271
00:19:05,910 --> 00:19:07,660
!هرب عبر النّافذة

272
00:19:09,370 --> 00:19:10,790
!مولاي غوون

273
00:19:10,790 --> 00:19:12,620
.عباءتي متّسخة

274
00:19:13,670 --> 00:19:17,170
.أحضر لي واحدة جديدة. سألاحقه

275
00:19:18,300 --> 00:19:20,800
هذا ليس شخصًا يمكنني
!التّغلّب عليه في قتال

276
00:19:20,800 --> 00:19:22,220
ماذا عن القناع؟

277
00:19:22,220 --> 00:19:25,430
ستكون فرصنا أفضل
!لو انتظرنا موته بسبب الشّيخوخة

278
00:19:25,430 --> 00:19:27,060
!على أيّة حال، فلنهرب

279
00:19:30,720 --> 00:19:31,690
!بيرو

280
00:19:34,020 --> 00:19:38,230
.لم أخسر سباق جريٍ قطّ

281
00:19:50,120 --> 00:19:53,290
لا يستطيع الكثير من صُنّاع الأقنعة
.منح أقنعتهم قوىً خاصّة

282
00:19:53,830 --> 00:19:55,590
هلاّ انضممتَ إلينا؟

283
00:19:55,590 --> 00:19:57,790
هل تريد منّي... أن أنضمّ إليكم؟

284
00:19:57,790 --> 00:20:03,550
نعم. لم تكن السّيطرة على
.ليسبلان سوى بداية خطّتي

285
00:20:03,550 --> 00:20:06,050
.هذه المملكة البائسة لا تكفي

286
00:20:06,050 --> 00:20:09,510
.سأمتلك كلّ شيء

287
00:20:09,510 --> 00:20:11,520
.يا صانع الأقنعة بيرو

288
00:20:11,520 --> 00:20:14,730
.انضمّ إليّ، وسنحكم العالم معًا

289
00:20:14,730 --> 00:20:19,070
.ساعدني، وسأجعلك خادمًا لي

290
00:20:15,730 --> 00:20:17,940
هل يُعقل هذا؟

291
00:20:19,070 --> 00:20:21,860
.سأمنحك كلّ ما قد ترغب به

292
00:20:20,650 --> 00:20:22,440
بائسة؟

293
00:20:30,080 --> 00:20:32,580
.أشمّ رائحة الكراهية

294
00:20:33,000 --> 00:20:38,210
.افتحي الصّندوق، وسأخلّصك منها

295
00:20:39,040 --> 00:20:44,670
هناك أشياء يمكنك رؤيتها
.لأنّك من يجمع أقنعة غاستون

296
00:20:45,010 --> 00:20:45,880
!لا تفعلي

297
00:20:57,100 --> 00:21:01,570
.هذا ساطع للغاية. أكره هذا العالم السّاطع

298
00:21:02,400 --> 00:21:06,530
.لا بدّ أنّك من فتح الصّندوق

299
00:21:07,990 --> 00:21:10,740
.يا له من تعبيرٍ رائع

300
00:21:10,740 --> 00:21:15,120
.تروقين لي. سأساعدك

301
00:21:15,870 --> 00:21:16,920
...إيّاكِ

302
00:21:17,250 --> 00:21:20,630
!إيّاكِ

303
00:21:23,130 --> 00:21:24,130
...السّماء

304
00:21:24,130 --> 00:21:25,050
ما الّذي يحدث؟

305
00:21:28,970 --> 00:21:30,930
ما هذا؟

306
00:21:46,530 --> 00:21:49,950
!تبًّا

307
00:23:22,610 --> 00:23:25,180
.تُبرم سونا عقدًا مع قناع إله الحرب

308
00:23:25,180 --> 00:23:28,680
يتبع قناع إله الحرب، بعد عودته للحياة، نزواته

309
00:23:28,680 --> 00:23:30,970
.ويتصرّف دون أيّ رادع

310
00:23:30,970 --> 00:23:35,160
في تلك الأثناء، يبتسم غوون
.مترقّبًا عدوًّا قويًّا

311
00:23:35,540 --> 00:23:39,410
،ولكن في مواجهة تلك القوّة السّاحقة

312
00:23:39,410 --> 00:23:41,180
.ليس بوسعي فعل أيّ شيء

313
00:23:41,180 --> 00:23:45,500
:تاليًا، في الحلقة الثّانية
."قناع إله الحرب"

314
00:23:46,050 --> 00:23:48,490
!وتبدأ رحلة الأقنعة