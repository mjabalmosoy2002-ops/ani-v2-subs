1
00:01:37,670 --> 00:01:39,040
.أيتها الآنسة قبّعة الزّهور

2
00:01:39,990 --> 00:01:43,660
.أنا آسفة. تمكّن ذلك الرّجل من الهرب

3
00:01:43,660 --> 00:01:46,360
.كنتُ آمل أن أسأله من أين أتى

4
00:01:46,360 --> 00:01:50,250
صحيح أنّه ما كان ليكون لديّ ما أشكو
،منه لو تمكّنتِ من فعل ذلك أيضًا

5
00:01:50,650 --> 00:01:56,010
لكنّك نجحت في الدّفاع عن
.المدينة بكلّ قوّتك

6
00:01:56,630 --> 00:01:59,170
...إضافة لذلك، فإنّ أرغوس ذاك

7
00:01:59,170 --> 00:02:01,010
.أوقع هذه

8
00:02:01,010 --> 00:02:02,370
وما هذه؟

9
00:02:02,370 --> 00:02:03,760
.إنّها تميمة

10
00:02:03,760 --> 00:02:07,380
.أداة صُنعت في حضارة زيليم القديمة

11
00:02:07,380 --> 00:02:08,500
...القديمة

12
00:02:08,500 --> 00:02:12,270
ذلك صحيح. إنّ كلّ نقش يمثّل
.تأثيرًا مماثلاً لمهارة ما

13
00:02:12,270 --> 00:02:16,530
.لا يوجد منها إلاّ دزّينة تقريبًا في العالم

14
00:02:16,530 --> 00:02:19,410
ماذا يعني نقش الوطواط المقلوب ذاك؟

15
00:02:19,410 --> 00:02:23,160
.العكس". وذلك يفسّر كلّ شيء"

16
00:02:23,670 --> 00:02:28,710
استعمل قوّة هذه التّميمة لعكس
.التّأثير المطهِّر لحجر الجنّيّات

17
00:02:28,710 --> 00:02:33,300
ثمّ استعمل الوبالة الّتي جمعها
.لاستدعاء التّنّين الشّرّير وبقيّة الوحوش

18
00:02:33,840 --> 00:02:37,300
هذا مذهل. لم تحتاجي حتّى
.إلى الرّجوع لكتاب ما

19
00:02:38,640 --> 00:02:40,470
،وبما أنّ هذا هو الأمر

20
00:02:40,850 --> 00:02:43,780
!فسأحتفظ بها بصفتي خبيرة

21
00:02:44,350 --> 00:02:46,610
!هذا الغرض القيّم لي أنا

22
00:02:46,610 --> 00:02:51,850
،عفوًا... في كلّ الأحوال
اختفى الخطر الآن، صحيح؟

23
00:02:51,850 --> 00:02:54,860
أظنّ ذلك. السّؤال الّذي يطرح نفسه الآن

24
00:02:54,860 --> 00:02:58,500
هو ما كانت تلك القوّة الّتي
.أعطتك القدرة على الطّيران

25
00:02:59,840 --> 00:03:05,640
صحيح. أعتقد أنّ هذا الصّغير هو الّذي
.تحوّل إلى تلك أجنحة وذلك السّيف

26
00:03:06,370 --> 00:03:09,170
.بربّك. يبدو ذلك كقصّة خرافيّة

27
00:03:15,380 --> 00:03:20,130
.كنتَ في الذّكرى الّتي رأيتُها

28
00:03:21,150 --> 00:03:22,640
ملك الجنّيّات؟

29
00:03:23,140 --> 00:03:25,520
!ملك الجنّيّات؟ غير ممكن

30
00:03:25,520 --> 00:03:27,510
من الأسطورة؟

31
00:03:28,500 --> 00:03:30,270
.اسمي أوبيل

32
00:03:30,550 --> 00:03:36,160
هذا الشّكل هو فكرة ملموسة
.تركتها خلفي تشبه السّراب

33
00:03:36,160 --> 00:03:37,800
!مذهل، مذهل، مذهل

34
00:03:37,800 --> 00:03:41,550
لا أصدّق أنّنا نتحدّث إلى ملك
!الجنّيّات بعد ألف سنة

35
00:03:41,550 --> 00:03:43,950
!إنّه حلم هواة التّاريخ القديم وقد تحقّق

36
00:03:43,950 --> 00:03:47,120
ما هي هواياتك؟ ومهاراتك؟
وطعامك المفضّل؟

37
00:03:47,120 --> 00:03:50,080
هل لدينا وقت لمثل تلك الأسئلة غير المفيدة؟

38
00:03:50,080 --> 00:03:53,100
.هوايتي هي كتابة الشّعر
...ومهاراتي هي

39
00:03:53,100 --> 00:03:54,580
!هل تجيبها بالفعل؟

40
00:03:55,610 --> 00:03:57,340
.عفوًا، أخبرنا

41
00:03:57,760 --> 00:04:00,840
...أجنحة الفضّة الخضراء وسيف التّطهير تلك

42
00:04:00,840 --> 00:04:04,530
هل أنت من منح تلك القوّة للينا؟

43
00:04:04,530 --> 00:04:06,870
.لم يكن أنا بالتّحديد

44
00:04:06,870 --> 00:04:13,520
شارك سيروندوروس بنفسه
.القوّة الّتي منحتُها مرّة لتابعي

45
00:04:13,520 --> 00:04:15,100
سيروندوروس؟

46
00:04:15,960 --> 00:04:19,860
إنّه اسم أحاديّ القرن المختوم
.داخل حجر الجنّيّات

47
00:04:20,720 --> 00:04:25,320
،عندما حصلتُ على تلك القوّة
.تدفّقت الذّكريات إلى ذهني

48
00:04:25,320 --> 00:04:28,990
.كنتما أنت وسيروندوروس تقاتلان الوحوش

49
00:04:28,990 --> 00:04:32,620
بالضّبط. بعد العديد من التّضحيات
،والمعارك اليائسة

50
00:04:32,620 --> 00:04:35,750
.حقّقت الجنّيّات انتصار صعبًا على الشّياطين

51
00:04:36,590 --> 00:04:40,750
ولكن في مقابل نصرنا، احترقت
.هذه الأرض واستحالت رمادًا

52
00:04:41,370 --> 00:04:44,880
.لم تعد مناسبة ليعيش عليها أيّ كائن حيّ

53
00:04:44,880 --> 00:04:47,910
واحتاجت لسنوات عديدة حتّى
.تعود لسابق عهدها

54
00:04:48,390 --> 00:04:51,520
من أجل الحفاظ على الطّاقة
،المتجّددة اللاّزمة

55
00:04:51,520 --> 00:04:54,090
.كان لا بدّ من تثبيت حياة داخل الحجر

56
00:04:54,090 --> 00:04:58,520
.وتطوّع سيروندوروس لتأدية ذلك الدّور

57
00:05:04,530 --> 00:05:09,280
لذلك السّبب هنالك أحاديّ قرن
.مختوم داخل حجر الجنّيّات

58
00:05:09,280 --> 00:05:12,450
...كان وحيدًا طوال ألف سنة

59
00:05:13,830 --> 00:05:17,790
،بعد إدراكه لمصيره ومصير حجر الجنّيّات

60
00:05:17,790 --> 00:05:20,400
.أرسل سيروندوروس نسخة عنه خارج الحجر

61
00:05:23,540 --> 00:05:25,800
.إنّه هذا المهر

62
00:05:26,530 --> 00:05:31,310
.لا بدّ أنّه استجاب لعزيمتك وحمى هذه الأرض

63
00:05:31,900 --> 00:05:35,430
أيّتها الفارسة الّتي حصلت
،على بركتي ورفاقها

64
00:05:35,760 --> 00:05:40,190
أنا أشكركم على إبعاد الشّياطين
عن هذه الأرض

65
00:05:40,190 --> 00:05:42,690
.وحماية شعبها

66
00:05:42,690 --> 00:05:48,210
أنا واثق أنّ سيروندوروس مسرور
.لرؤيته لهذا المشهد في النّهاية

67
00:05:48,210 --> 00:05:49,700
النّهاية؟

68
00:05:50,240 --> 00:05:53,080
،بعد أن أدّى حجر الجنّيّات دوره

69
00:05:53,490 --> 00:05:55,730
.سيعود سيروندوروس للرّياح

70
00:05:55,730 --> 00:05:58,480
بتعبير آخر، سيختفي؟

71
00:05:58,480 --> 00:05:59,210
ماذا؟

72
00:06:02,210 --> 00:06:04,920
مرّت ألف سنة منذ آخر مرّة رأيتُ
.فيها هذه البحيرة

73
00:06:05,690 --> 00:06:09,720
أعتقد أنّ هذه الأرض قد عادت
.لطبيعتها بشكل كافٍ

74
00:06:10,480 --> 00:06:12,720
.شكرًا لك يا سيروندوروس

75
00:06:13,130 --> 00:06:15,470
.هذه هي ثمار تفانيك

76
00:06:16,220 --> 00:06:19,980
.لا، هذا ليس كلّ شيء

77
00:06:20,400 --> 00:06:25,840
إنّ النّاس الّذي عاشوا هنا وبنوا
،هذا المشهد الجميل لأجيال

78
00:06:25,840 --> 00:06:31,990
وحتّى يومنا هذا، فإنّ عملهم
.يعطي معنى لمعاركنا

79
00:06:32,400 --> 00:06:38,250
سنترك المستقبل بين أيديهم بينما
.نختفي نحن الحرّاس القدامى

80
00:06:38,250 --> 00:06:40,540
ستختفي أيضًا؟

81
00:06:41,050 --> 00:06:43,660
.لكن لديّ طلب قبل ذلك

82
00:06:44,380 --> 00:06:49,380
هلاّ أريتم رقصة الجنّيّات لسيروندوروس؟

83
00:06:49,380 --> 00:06:55,010
سيكون قادرًا حينها على الرّحيل
.بسلام مع تلك الذّكرى القديمة

84
00:06:58,060 --> 00:06:59,020
.سأقوم بذلك

85
00:06:59,310 --> 00:07:01,950
،قد لا يكون هذا وقتًا مناسبًا لمهرجان

86
00:07:01,950 --> 00:07:04,380
،وقد يكون مسرح السّاحل قد دُمّر

87
00:07:05,150 --> 00:07:09,170
.لكنّي أعتقد أنّها تستحقّ أن نؤدّيها

88
00:07:10,050 --> 00:07:13,920
.نعم. أعتقد أنّها فكرة جيّدة
.حظًّا سعيدًا

89
00:07:13,920 --> 00:07:15,570
.سترقصين معي

90
00:07:15,570 --> 00:07:16,410
ماذا؟

91
00:07:16,410 --> 00:07:18,660
.إنّك ترتدين الزّيّ سلفًا

92
00:07:19,780 --> 00:07:20,900
!ماذا؟

93
00:07:23,380 --> 00:07:24,540
!انظروا

94
00:07:25,320 --> 00:07:27,060
!راقصات

95
00:07:30,090 --> 00:07:32,830
!لـ-لكنّي لا أعرف الرّقصة

96
00:07:32,830 --> 00:07:35,180
!كما أنّي لستُ راقصة بارعة مثلك أيضًا

97
00:07:35,680 --> 00:07:39,380
،بمجرّد أن تتعلّمي روتينًا واحدًا منها
.سيكون الباقي مجرّد تكرار لنفس الحركات

98
00:07:39,380 --> 00:07:40,810
.إنّها ليست صعبة

99
00:07:40,810 --> 00:07:42,560
!بل ذلك صعب

100
00:07:42,560 --> 00:07:45,600
هل ينوون تأدية الرّقصة في ظلّ هذه الظّروف؟

101
00:07:45,600 --> 00:07:46,820
...لا

102
00:07:46,820 --> 00:07:49,150
.ربّما سيؤدّونها لذلك السّبب بالتّحديد

103
00:08:04,330 --> 00:08:05,960
.هذا لطيف

104
00:08:05,960 --> 00:08:07,490
...أعتقد أنّ الوقت قد حان

105
00:08:08,090 --> 00:08:10,060
.لالتقاط زهرة

106
00:08:16,640 --> 00:08:20,320
.تلك الرّاقصة هي ابنة بيلبوري الملعونة

107
00:08:20,320 --> 00:08:24,390
.لا تقولي ذلك. لقد قاتلوا الوحوش لحمايتنا

108
00:08:24,650 --> 00:08:25,710
...إضافة لذلك

109
00:08:25,710 --> 00:08:29,620
.نعم. إنّها رقصة مذهلة بالفعل

110
00:08:39,540 --> 00:08:41,290
مهلاً، إلى أين تذهبين؟

111
00:08:41,970 --> 00:08:44,290
.أريد المشاهدة أيضًا

112
00:08:47,040 --> 00:08:48,860
!رقصة الرّاقصة الأولى المنفردة

113
00:09:39,200 --> 00:09:42,760
.شكرًا يا ذات الشّعر الأحمر

114
00:09:43,100 --> 00:09:45,020
.كانت تلك رقصة جميلة

115
00:09:45,970 --> 00:09:48,400
.نعم. كنتِ رائعة

116
00:09:49,280 --> 00:09:51,950
.كنتِ أفضل ممّا توقّعتُ أيضًا

117
00:09:51,950 --> 00:09:53,900
لستِ صريحة جدًّا، صحيح؟

118
00:09:54,410 --> 00:09:56,940
.لقد اختفى تابعك

119
00:09:56,940 --> 00:10:01,660
نعم، لكنّ ذكرياته وروحه
ستعيش في ذلك النّسخة

120
00:10:02,010 --> 00:10:04,310
.وسيعيش حياة جديدة

121
00:10:04,310 --> 00:10:07,950
إذًا فقد وُلد من جديد على هيئة ذلك القصير؟

122
00:10:08,420 --> 00:10:11,220
.يا له من موضوع تجارب قيّم

123
00:10:12,020 --> 00:10:13,050
.لينا

124
00:10:13,920 --> 00:10:18,550
خذي سيروندوروس الجديد هذا
.معك وأريه العالم

125
00:10:18,940 --> 00:10:23,810
أريده أن يركض بحرّيّة في السّهول
.ويشعر بالرّياح في حياته الجديدة

126
00:10:23,810 --> 00:10:28,080
.ستصير أجنحة الجنّيّات والسّيف قوّتك

127
00:10:29,370 --> 00:10:30,310
.حاضرة

128
00:10:31,070 --> 00:10:34,960
،إن كنتَ قد وُلدتَ من جديد
فما رأيك باسم جديد؟

129
00:10:34,960 --> 00:10:37,440
...ليكن مشتقًّا من اسمك القديم

130
00:10:37,440 --> 00:10:39,290
ما رأيك بسيرون؟

131
00:10:41,850 --> 00:10:43,580
.أتطلّع للعمل معك يا سيرون

132
00:10:56,530 --> 00:10:59,260
.أتمنّى لو استطعتُ طرح أسئلة أكثر عليه

133
00:10:59,260 --> 00:11:02,220
أنت المخطئة بإضاعتك للوقت
.في سؤاله عن طعامه المفضّل

134
00:11:04,140 --> 00:11:08,270
...ماذا؟ إنّ جسدي

135
00:11:11,770 --> 00:11:12,810
!لينا

136
00:11:19,280 --> 00:11:20,700
سيرون؟

137
00:11:25,700 --> 00:11:27,870
.يا له من غروب جميل

138
00:11:28,520 --> 00:11:30,720
بقيت معي؟

139
00:11:30,720 --> 00:11:32,580
.شكرًا يا سيرون

140
00:11:37,130 --> 00:11:39,600
.يبدو أنّك قد استيقظتِ

141
00:11:39,600 --> 00:11:41,010
.الآنسة قبّعة الزّهور

142
00:11:41,010 --> 00:11:42,380
أين نحن؟

143
00:11:42,380 --> 00:11:44,390
.غرفة الشّخصيّات المهمّة في الفندق

144
00:11:44,390 --> 00:11:46,770
.قاتلتِ التّنّين الشّرّير ليلة الأمس

145
00:11:46,770 --> 00:11:49,140
.ونحن الآن في مساء اليوم التّالي لذلك

146
00:11:49,140 --> 00:11:51,490
نمت طوال ذلك الوقت؟

147
00:11:51,490 --> 00:11:54,040
.استعملتِ قوّة هائلة

148
00:11:54,040 --> 00:11:56,370
.من الطّبيعيّ الشّعور بتأثير ذلك لاحقًا

149
00:11:56,370 --> 00:11:57,400
فعلاً؟

150
00:11:57,400 --> 00:12:00,030
قاتلت هذه الآنسةُ التّنّينَ الشّرّير؟

151
00:12:00,030 --> 00:12:03,170
!أنت منقذة أثينا

152
00:12:03,170 --> 00:12:04,530
...نـ-نعم

153
00:12:04,530 --> 00:12:08,790
قامت السّيّدة القدّيسة للتّوّ بتزويد
.فرقة الحراسة اللّيليّة بالأسلحة

154
00:12:08,790 --> 00:12:11,660
.لا نكنّ إلاّ الامتنان للنّقابة

155
00:12:11,660 --> 00:12:12,490
ماذا؟

156
00:12:12,910 --> 00:12:14,420
فعلت القدّيسة ذلك؟

157
00:12:16,170 --> 00:12:20,800
ماذا؟ زوّدتكم قدّيسة مكتب
التّفتيش بذلك الدّعم؟

158
00:12:20,800 --> 00:12:25,930
نعم. أوصلتها مجموعة تجّار
.الطّائر الأسود اليوم

159
00:12:25,930 --> 00:12:27,640
،بعد زوال حجر الجنّيّات الآن

160
00:12:27,640 --> 00:12:31,690
فعلينا تجهيز أنفسنا لتهديد
،الوحوش في المنطقة

161
00:12:31,690 --> 00:12:33,560
.لذلك فنحن نقدّر ذلك

162
00:12:33,560 --> 00:12:35,770
.أستأذن للذّهاب الآن

163
00:12:41,360 --> 00:12:42,610
.هذا غريب

164
00:12:43,150 --> 00:12:46,740
ما الغريب؟ ألا تقوم السّيّدة
القدّيسة بخدمتهم فحسب؟

165
00:12:46,740 --> 00:12:50,620
،لا. مهما بلغت سرعة انتشار الأخبار
يظلّ من المستحيل للأسلحة

166
00:12:50,990 --> 00:12:55,590
أن تصل إلى أثينا من المدينة المقدّسة
.في اليوم الّذي تلا أحداث الأمس

167
00:12:55,590 --> 00:12:58,130
.ليس ما لم تُجهّز لذلك من قبل

168
00:12:58,130 --> 00:13:03,130
هل تقترحين أنّ السّيّدة القدّيسة
عرفت أنّ حجر الجنّيّات سيُدمَّر؟

169
00:13:04,130 --> 00:13:07,450
.ربّما الأمور أكثر خطورة ممّا ظننت

170
00:13:07,450 --> 00:13:09,140
عمّ تتحدّثين؟

171
00:13:09,140 --> 00:13:13,140
أتعرفين ما مهارة القدّيسة؟

172
00:13:13,140 --> 00:13:16,270
إنّها مهارة تقييم، أليس كذلك؟

173
00:13:16,270 --> 00:13:17,770
.رسميًّا، نعم

174
00:13:17,770 --> 00:13:18,870
رسميًّا؟

175
00:13:18,870 --> 00:13:23,680
هناك تفاهم ضمنيّ بين كبار
المسؤولين في النّقابة

176
00:13:23,680 --> 00:13:28,280
.مفاده أنّ مهارة القدّيسة مرتبطة بالاستبصار

177
00:13:28,280 --> 00:13:29,530
استبصار؟

178
00:13:29,860 --> 00:13:31,770
.القدرة على رؤية المستقبل

179
00:13:31,770 --> 00:13:34,330
.إنّها تتلقّى وحيًا من السّماء

180
00:13:34,330 --> 00:13:37,780
يُقال أنّ ذلك هو سبب تسميتها
.بالسّيّدة القدّيسة

181
00:13:38,330 --> 00:13:43,710
،لكن عندما أكلتُ فاكهة المهارات
.قيّمت مهارتي على أنّها قدّيس السّيف

182
00:13:43,710 --> 00:13:46,720
.قيّمت مهارتي أيضًا

183
00:13:46,720 --> 00:13:53,220
،ربّما لم تُقيّم مهارتيكما
بل رأت مستقبليكما وخمّنت ما هما؟

184
00:13:53,900 --> 00:13:55,480
أذلك ممكن؟

185
00:13:55,480 --> 00:13:58,230
،هذه معلومات سرّيّة للغاية

186
00:13:58,230 --> 00:14:01,540
ولكنّني شعرت أنّه يجب عليّ كفشها
.لكما بغضّ النّظر عن ذلك

187
00:14:01,980 --> 00:14:05,550
حادثة التّنّين الشّرّير في قصر
.الكونت مونتيس السّابق

188
00:14:05,550 --> 00:14:08,220
.مدينة أثينا

189
00:14:08,910 --> 00:14:12,870
حلّ خطر غير مسبوق على الواحد
..."تلو الآخر، و"بالمصادفة

190
00:14:12,870 --> 00:14:14,800
...نجد في مركز الحادثتين

191
00:14:16,000 --> 00:14:20,250
.لينا ودراتينا. أنتما معًا

192
00:14:20,660 --> 00:14:25,840
تقصدين أنّ القدّيسة استعملت
استبصارها لجعل ذلك يحدث؟

193
00:14:26,290 --> 00:14:28,880
.أنا محظوظة لأنّك سريعة البديهة

194
00:14:29,280 --> 00:14:36,270
أعتقد أنّ معركتيكما ضدّ التّنّينين
.الشّرّيرين كانتا جزءًا من خطّة فظيعة

195
00:14:36,270 --> 00:14:39,500
—هذا مجرّد تخمين! السّيّدة القدّيسة

196
00:14:39,500 --> 00:14:41,400
.دراتينا بيلبوري

197
00:14:42,090 --> 00:14:46,400
إلى متى ستواصلين السّماح
للقدّيسة باستغلالك هكذا؟

198
00:14:47,700 --> 00:14:52,530
.لا يهمّ. ستأتين معي في كلّ الأحوال

199
00:14:53,290 --> 00:14:55,410
ستعتقلينني؟

200
00:14:55,410 --> 00:14:58,450
،لا. بدل أخذك إلى المدينة المقدّسة

201
00:14:58,450 --> 00:15:00,720
.فسأذهب إلى مكان آخر للتّحقيق

202
00:15:00,720 --> 00:15:02,670
.وكذلك أنت يا لينا

203
00:15:02,670 --> 00:15:05,540
.كلتاكما تحت مراقبتي

204
00:15:05,540 --> 00:15:10,800
هل تقصدين أنّك تظهرين الرّحمة
وتضعينهما تحت حمايتك؟

205
00:15:10,800 --> 00:15:12,410
.نوعًا ما

206
00:15:15,810 --> 00:15:18,640
،بعد التّفكير في الأمر
،ففي يوم حصولي على مهارتي

207
00:15:18,640 --> 00:15:21,000
.أُجبرتُ على الذّهاب إلى المدينة المقدّسة

208
00:15:22,090 --> 00:15:25,600
ومنذ تلك اللّحظة، كنتُ أتصرّف
.حسب استبصارها سلفًا

209
00:15:25,600 --> 00:15:30,070
ربّما تكون مجهوداتها للتّخلّص
.من لايت جزءًا من ذلك أيضًا

210
00:15:32,830 --> 00:15:33,990
.لا بأس

211
00:15:35,190 --> 00:15:38,260
.سأذهب معك أيّتها الآنسة قبّعة الزّهور

212
00:15:38,260 --> 00:15:43,080
لا أريد لطُرقي وطُرق أصدقائي
.أن تظلّ من تخطيط القدّيسة

213
00:15:43,080 --> 00:15:44,960
.ذلك ما أردتُ سماعه

214
00:15:44,960 --> 00:15:50,180
...لا يمكننا خيانة السّيّدة القدّيسة

215
00:15:53,250 --> 00:15:56,720
لم أعرف بشأن استبصارها
.والتّنّينين الشّرّيرين

216
00:15:57,120 --> 00:16:01,850
أجهل ما تفكّر فيه السّيّدة
.القدّيسة الآن أيضًا

217
00:16:04,230 --> 00:16:07,610
.لذلك سأذهب معك

218
00:16:07,610 --> 00:16:10,990
.فعلاً؟ لم أعتقد أنّك ستكونين بهذه الوداعة

219
00:16:10,990 --> 00:16:14,230
.لكنّي لستُ حليفتك

220
00:16:14,230 --> 00:16:17,620
.سأستعملك لمعرفة المزيد فحسب

221
00:16:17,620 --> 00:16:20,120
،وحسب الظّروف

222
00:16:20,120 --> 00:16:23,940
.قد تصير الأمور متوتّرة بيني وبين القدّيسة

223
00:16:29,250 --> 00:16:34,010
حسنًا، بإمكانك أن تقرّري
.إلى جانب من ستقفين حينها

224
00:16:34,780 --> 00:16:35,760
.حسنًا

225
00:16:35,760 --> 00:16:36,900
...المعذرة

226
00:16:37,890 --> 00:16:43,050
قبل مغادرتنا، أودّ المساعدة
.في إعادة بناء أثينا

227
00:16:43,050 --> 00:16:47,710
،عندما دمّرتُ حجر الجنّيّات
.عزمتُ أن أتحمّل هذا العبء

228
00:16:47,710 --> 00:16:49,760
.ومساعدتهم هو أقلّ ما يمكنني فعله

229
00:16:51,780 --> 00:16:54,670
.أريد بعضة أيّام لأستريح

230
00:16:54,670 --> 00:16:56,910
.عليك أيضًا قضاء وقتك كما تشائين

231
00:16:56,910 --> 00:17:00,290
في تلك الحالة، أودّ التّواصل
.مع أعضاء لوكسيريا الآخرين

232
00:17:00,830 --> 00:17:02,430
.بإمكاني المساعدة في ذلك

233
00:17:05,210 --> 00:17:09,710
.بيتزا، بيتزا. بيتزا لحم الخنزير

234
00:17:10,020 --> 00:17:10,840
.حسنًا

235
00:17:12,000 --> 00:17:13,260
.انتهيت

236
00:17:13,600 --> 00:17:14,990
.تفضّلي يا سيّدتي

237
00:17:14,990 --> 00:17:17,760
.شكرًا على المساعدة يا أيلا

238
00:17:18,180 --> 00:17:21,640
.إنّهم يأكلون الكثير، لذلك أقدّر مساعدتك

239
00:17:21,640 --> 00:17:24,010
.أنا متحمّسة لبيتزا اليوم

240
00:17:24,010 --> 00:17:25,980
!يا أيلا

241
00:17:28,320 --> 00:17:29,750
!سيّد لايت

242
00:17:30,270 --> 00:17:30,950
.حسنًا

243
00:17:32,280 --> 00:17:34,030
ما الّذي كنت تفعله؟

244
00:17:34,030 --> 00:17:35,520
.أتدرّب

245
00:17:36,010 --> 00:17:40,780
عليّ أن أصير أقوى لإتقان
.مهارة شعلة اللّهب الجديدة

246
00:17:40,780 --> 00:17:43,060
.يبدو أنّك استعدت عافيتك بالكامل

247
00:17:43,060 --> 00:17:43,900
.نعم

248
00:17:46,920 --> 00:17:48,040
ما هذا؟

249
00:17:48,040 --> 00:17:49,840
لايت! أيمكنك سماعي؟

250
00:17:49,840 --> 00:17:52,550
ماذا؟ لينا؟ أين أنت؟

251
00:17:52,550 --> 00:17:55,300
.يصدر صوت الآنسة لينا من هذا الشّيء

252
00:17:55,300 --> 00:17:57,490
.ذلك النّور عبارة عن يراعة سلطعون

253
00:17:57,490 --> 00:18:00,660
يسمح لنا اثنان من هذه الكائنات
.النّادرة بنقل أصواتنا

254
00:18:00,660 --> 00:18:02,180
.هذا مذهل

255
00:18:02,490 --> 00:18:04,000
.بإمكاننا سماعك يا لينا

256
00:18:04,000 --> 00:18:05,140
هل أنت بخير؟

257
00:18:05,140 --> 00:18:07,940
نعم. وأنت يا لايت؟

258
00:18:07,940 --> 00:18:09,910
،أتينا إلى هنا للحصول على سيف

259
00:18:09,910 --> 00:18:13,280
لكن انتهى بنا المطاف نقاتل
.شحنة البرق زامدو بدل ذلك

260
00:18:13,280 --> 00:18:15,920
.لكنّ السّيّد لايت فاز عليه

261
00:18:15,920 --> 00:18:18,700
.أنا مسرورة لأنّكما بخير

262
00:18:18,700 --> 00:18:24,200
أردتُ إبلاغكما أنّي ما زلتُ منشغلة بالكثير
.ولا أستطيع العودة، لذلك أنا آسفة

263
00:18:24,200 --> 00:18:26,230
ماذا؟ فعلاً؟

264
00:18:26,230 --> 00:18:30,220
،لكن بمجرّد أن أبلغ هدفي التّالي
.أعد أن أعود

265
00:18:30,930 --> 00:18:31,960
.مفهوم

266
00:18:31,960 --> 00:18:33,140
.لا بأس

267
00:18:33,140 --> 00:18:36,840
سيعثر كلانا على طريقة
لتولّي مهمّتنا التّالية، صحيح؟

268
00:18:36,840 --> 00:18:38,880
.نعم. سنبذل جهدنا

269
00:18:38,880 --> 00:18:39,970
.شكرًا

270
00:18:41,260 --> 00:18:43,100
.إنّهم لطفاء وبسطاء جدًّا

271
00:18:43,590 --> 00:18:46,600
.ماذا؟ إنّ النّور يخفت

272
00:18:46,600 --> 00:18:49,620
.ثمّة حدود للمدّة الّتي يدوم فيها النّور

273
00:18:49,620 --> 00:18:51,600
.لن يدوم لوقت طويل

274
00:18:52,130 --> 00:18:55,360
.لايت، أعد أنّي سأعود، فانتظرني

275
00:18:55,360 --> 00:18:58,490
.أكيد. سنغادر نحن غدًا

276
00:18:58,490 --> 00:19:02,810
سنتولّى أمر مهمّة الرّتبة س
.تلك في لمح البصر وسننتظرك

277
00:19:02,810 --> 00:19:03,620
.حسنًا

278
00:19:06,200 --> 00:19:08,540
.لا تقومي بأيّ شيء متهوّر يا لينا

279
00:19:08,540 --> 00:19:09,860
.وكذلك أنت

280
00:19:18,630 --> 00:19:21,690
يا سيّدتي القدّيسة، ما الّذي تنظرين إليه؟

281
00:19:21,690 --> 00:19:25,350
.سارت الأمور في أثينا كما هو متوقّع

282
00:19:25,350 --> 00:19:27,020
أذلك شيء جيّد؟

283
00:19:27,020 --> 00:19:30,270
.نعم. النّقطة التّالية هي غابات فورميدو

284
00:19:30,600 --> 00:19:34,800
.يجب إزاحة سيّد الفواكه قريبًا

285
00:19:35,770 --> 00:19:40,150
لأنّه سيعترض طريق خطّتك المدمّرة للقدر؟

286
00:19:40,820 --> 00:19:46,150
نوا، لا يجب عليك التّفوّه بتلك
.الكلمات خارج هذه الغرفة

287
00:19:46,150 --> 00:19:47,160
.حسنًا

288
00:19:48,900 --> 00:19:52,140
.وقت البداية وشيك

289
00:19:54,420 --> 00:19:55,670
!ها هو ذا

290
00:19:55,670 --> 00:20:00,920
انتهى هومورا، سيف لايت
!الجديد الّذي صنعتُه بكلّ حرص

291
00:20:02,740 --> 00:20:03,470
!أجل

292
00:20:04,430 --> 00:20:06,470
.هذا السّيف رائع

293
00:20:06,470 --> 00:20:08,540
.هذا هو المتوقّع من الآنسة مونيكا

294
00:20:09,880 --> 00:20:11,350
.قمتُ بهذا أيضًا

295
00:20:11,350 --> 00:20:12,350
!انظروا

296
00:20:12,790 --> 00:20:16,310
.تمزّق معطفك بالكامل، لذلك أصلحته

297
00:20:17,860 --> 00:20:23,360
شكرًا لك على صنع كلّ هذه الأشياء
.رغم انشغالكم بإعادة بناء الورشة

298
00:20:23,360 --> 00:20:26,730
.كان أمر ورشة بولست لينتهي بدونك

299
00:20:26,730 --> 00:20:29,490
.ما زال هذا غير كافٍ لردّ جميلك

300
00:20:30,770 --> 00:20:33,120
.حسنًا، سنغادر

301
00:20:33,120 --> 00:20:33,790
ماذا؟

302
00:20:36,320 --> 00:20:37,460
مهلاً، ماذا؟

303
00:20:37,460 --> 00:20:38,750
!آنسة مونيكا؟

304
00:20:38,750 --> 00:20:42,700
.فكّرتُ في الذّهاب معكما

305
00:20:42,700 --> 00:20:44,010
!ماذا؟

306
00:20:44,300 --> 00:20:47,100
.أدركتُ أمرًا عندما رأيتك تقاتل

307
00:20:47,100 --> 00:20:48,280
وما هو؟

308
00:20:48,280 --> 00:20:52,230
إنّ رؤيتي لكيفية استعمالك لسيفي بنفسي

309
00:20:52,230 --> 00:20:55,770
.هو طريق مختصر لصنع السّيف الأقوى

310
00:20:56,250 --> 00:20:57,520
...مونيكا

311
00:20:57,520 --> 00:21:00,010
.ما زال هومورا مجرّد نموذج أوّليّ

312
00:21:00,010 --> 00:21:04,070
أعلم أنّي أستطيع صنع سيف أفضل من شأنه
.أن يجعل استخدام قدراتك أكثر فعاليّة

313
00:21:04,660 --> 00:21:05,530
ألا يمكنني مرافقتكما؟

314
00:21:05,790 --> 00:21:07,280
.بالطّبع يمكنك

315
00:21:08,530 --> 00:21:10,830
.لنذهب معًا يا مونيكا

316
00:21:10,830 --> 00:21:14,290
.واثقة أنّنا سنستمتع أكثر بوجودك معنا

317
00:21:14,290 --> 00:21:17,600
حسنًا! بإمكانكما الاعتماد عليّ
.لإضفاء بعض الحيويّة على الرّحلة

318
00:21:17,600 --> 00:21:19,540
.هذا هو اختصاصي

319
00:21:19,540 --> 00:21:22,530
.حسنًا، لا رادع لها الآن

320
00:21:22,530 --> 00:21:25,050
.ستكون بخير رفقة لايت

321
00:21:25,050 --> 00:21:27,050
...حسنًا، لنقم بهذا مرّة أخرى

322
00:21:27,350 --> 00:21:29,550
!هيّا بنا

323
00:21:29,550 --> 00:21:31,360
.انتظري فحسب يا لينا

324
00:21:31,360 --> 00:21:34,830
سأصير المغامر الأقوى على الإطلاق

325
00:21:34,830 --> 00:21:37,260
!وسأترك بصمتي في التّاريخ

326
00:23:15,910 --> 00:23:18,290
عفوًا، من أنت؟

327
00:23:33,600 --> 00:23:35,930
!مفهوم. حسنًا، لننطلق

328
00:23:36,290 --> 00:23:37,620
!هيّا بنا

329
00:23:37,620 --> 00:23:38,790
!أجل