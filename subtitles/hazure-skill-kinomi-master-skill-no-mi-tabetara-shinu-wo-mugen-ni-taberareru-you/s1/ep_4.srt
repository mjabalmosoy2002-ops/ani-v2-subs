1
00:00:03,400 --> 00:00:07,360
،أنا جناح من البجعة السّوداء
.قوّات نخبة الظّلام

2
00:00:08,100 --> 00:00:12,360
.اسمي دراتينا يا لايت أندروود

3
00:00:12,360 --> 00:00:16,490
.أنا مسرور لأنّي التقيتُ شخصًا حيًّا أخيرًا

4
00:00:16,490 --> 00:00:17,500
...لكن

5
00:00:18,140 --> 00:00:21,460
.لا تبدين لي كناجية

6
00:00:27,190 --> 00:00:30,240
.ما تحاولين فعله ليس خاطئًا

7
00:00:30,240 --> 00:00:31,730
.شكرًا لك

8
00:00:31,730 --> 00:00:34,460
.يبدو أنّ مغامرتنا تنتهي هنا

9
00:00:34,460 --> 00:00:37,650
.مستقبل أحلامنا بين يديك الآن

10
00:00:37,650 --> 00:00:42,520
أفضل تكريم يمكنني أن أقدّمه لهما
.الآن هو أن أضع حدًّا لهما بنفسي

11
00:00:44,200 --> 00:00:45,520
.زهرة جنائز

12
00:00:55,870 --> 00:00:58,010
.يا لها من خطوات خرقاء

13
00:00:58,010 --> 00:00:59,780
.يبدو أنّك تعاني للرّقص

14
00:00:59,780 --> 00:01:03,830
الطّريقة الوحيدة للخروج من
!هذا الوضع هي هذه

15
00:01:04,320 --> 00:01:05,290
!أيلا

16
00:01:05,290 --> 00:01:06,330
!نعم

17
00:01:08,790 --> 00:01:10,290
ماذا؟

18
00:01:10,290 --> 00:01:13,120
.تمسّكي جيّدًا يا أيلا

19
00:01:13,120 --> 00:01:13,800
.مفهوم

20
00:01:14,160 --> 00:01:16,090
سترقصان معًا؟

21
00:01:16,800 --> 00:01:18,190
.أشعر بالغيرة

22
00:01:18,800 --> 00:01:21,340
.اضحكي بينما ما زال باستطاعتك ذلك

23
00:02:59,310 --> 00:03:01,490
.عليّ الوصول إلى لايت وأيلا بسرعة

24
00:03:02,600 --> 00:03:05,240
أيمكنك اكتشاف الأمر يا أيلا؟

25
00:03:05,530 --> 00:03:08,820
لماذا يستمرّ الموتى الأحياء بالظّهور؟

26
00:03:10,610 --> 00:03:13,250
.هناك الكثير منهم ويصعب الجزم بذلك

27
00:03:13,250 --> 00:03:17,250
علينا الذّهاب إلى مكان ما
.سيمنحك نظرة واسعة عليهم

28
00:03:17,500 --> 00:03:18,390
.حسنًا

29
00:03:20,660 --> 00:03:22,690
.ستحصلين الآن على نظرة واسعة

30
00:03:22,690 --> 00:03:24,760
.نعم، بإمكاني رؤيتهم جميعًا بوضوح

31
00:03:24,760 --> 00:03:27,770
...لنرَ

32
00:03:27,770 --> 00:03:30,460
...لكن ذراعي

33
00:03:30,460 --> 00:03:32,870
!لستُ ثقيلة لتلك الدّرجة

34
00:03:32,870 --> 00:03:36,020
أعلم أنّي أكلتُ الكثير من الوجبات
...الخفيفة والبيتزا، ولكن

35
00:03:36,020 --> 00:03:38,360
!استعملي مهارة التّقييم خاصّتك فحسب

36
00:03:39,620 --> 00:03:43,160
!"ذلك الميت الحيّ يستعمل مهارة "استدعاء

37
00:03:43,410 --> 00:03:45,840
أذلك هو الكونت مونتيس؟

38
00:03:45,840 --> 00:03:47,660
.إذًا فقد تحوّل إلى ميت حيّ

39
00:03:47,660 --> 00:03:50,160
.يبدو أنّهم يوشكون على اكتشاف الأمر

40
00:03:51,590 --> 00:03:53,980
أيلا، ما ذلك هناك؟

41
00:03:53,980 --> 00:03:55,290
...يكاد يبدو مثل

42
00:03:56,330 --> 00:03:57,740
إله الموت؟

43
00:03:57,740 --> 00:03:59,550
.إنّه حاصد الأرواح

44
00:03:59,550 --> 00:04:03,550
إنّه وحش خطير جدًّا
.يحوّل الأحياء إلى موتى أحياء

45
00:04:03,830 --> 00:04:07,740
،إن لمس أحد ذلك الحاصود أو الوحل
.فسيتحوّل إلى ميت حيّ

46
00:04:07,740 --> 00:04:08,560
!كلاّ

47
00:04:20,860 --> 00:04:26,870
إنّ دراتينا تسيطر على حاصد الأرواح
.والموتى الأحياء الّذين ينشئهم

48
00:04:28,540 --> 00:04:32,870
.كان الكونت هو من استدعى حاصد الأرواح

49
00:04:34,100 --> 00:04:36,130
.هذا مثير للاشمئزاز

50
00:04:37,610 --> 00:04:43,040
تحوّل البطل الّذي كان شهيرًا ذات يوم إلى
.ميت حيّ بواسطة الوحش الّذي استدعاه

51
00:04:43,040 --> 00:04:45,130
يا لها من نهاية حزينة، أليس كذلك؟

52
00:04:45,130 --> 00:04:47,040
.فهمت

53
00:04:47,040 --> 00:04:52,520
بدأ النّاس بالاختفاء لأنّ الكونت
.استدعى حاصد الأرواح

54
00:04:52,520 --> 00:04:54,390
.هذا صحيح

55
00:04:54,390 --> 00:04:58,720
وقع جميع المغامرين المتوسّطين
الّذين زاروا هذا المكان

56
00:04:58,720 --> 00:05:01,780
جاهلين لما سيواجهونهم
.ضحيّة لحاصد الأرواح

57
00:05:01,780 --> 00:05:06,160
استدعى الوحش الّذي يتغذّى
.على هؤلاء المغامرين الواعدين

58
00:05:06,440 --> 00:05:08,780
.كان بطلاً حقيقيًّا

59
00:05:08,780 --> 00:05:14,540
ولكن لماذا يقوم مغامر ناجح مثل
الكونت باستدعاء وحش كهذا؟

60
00:05:16,530 --> 00:05:19,370
أنت ساذج، صحيح؟

61
00:05:19,370 --> 00:05:24,740
.لا ترى سوى الأجزاء الجميلة والبرّاقة في العالم

62
00:05:24,740 --> 00:05:26,300
ما الّذي تحاولين قوله؟

63
00:05:26,300 --> 00:05:28,310
أتعرف ما هي المهارات المحرّمة؟

64
00:05:28,310 --> 00:05:29,550
المهارات المحرّمة؟

65
00:05:29,810 --> 00:05:34,460
إنّها المهارات الّتي تجعل الآخرين ينبذونك
.ويكرهونك لمجرّد امتلاكك لواحدة منها

66
00:05:37,870 --> 00:05:41,280
كانت مهارة الاستدعاء الخاصّة
.بالكونت واحدة منها

67
00:05:41,280 --> 00:05:45,660
في البداية، أشاد به النّاس باعتباره
.بطلاً يتمتّع بمهارة قويّة

68
00:05:46,520 --> 00:05:50,910
ولكن ماذا لو ظهر وحش مرعب
في البلدة ذات يوم؟

69
00:05:50,910 --> 00:05:52,800
ماذا لو غيّر البطل رأيه

70
00:05:52,800 --> 00:05:57,330
ووجّه تلك القوّة الهائلة المرعبة ضدّ النّاس؟

71
00:05:57,790 --> 00:06:02,990
،وبسبب الخوف الّذي تملّك الشّعب والحكومة
.بدأ كلّ من الجانبين ينأى بنفسه عنه

72
00:06:02,990 --> 00:06:07,340
.في النّهاية، تمّ اتّهام الكونت حتّى بالخيانة

73
00:06:08,300 --> 00:06:09,590
...مستحيل

74
00:06:10,170 --> 00:06:13,850
لذلك السّبب هرب إلى هذا
.المكان البائس البعيد

75
00:06:14,850 --> 00:06:19,850
نعم، لكنّ المغتالين الّذين تمّ
.إرسالهم خلفه لم يتوقّفوا

76
00:06:20,190 --> 00:06:24,380
،وفي الآونة الأخيرة
تمّ إرسال مجموعة من القتلة

77
00:06:24,380 --> 00:06:26,860
.تحت ستار إجراء مسح لكثافة الوحوش

78
00:06:27,680 --> 00:06:34,830
ويبدو أنّ الكونت استدعى هذا
.الوحش بهدف إبعاد الدّخلاء

79
00:06:35,610 --> 00:06:39,770
.ربّما قرّر أنّه يجب القضاء على الجميع معًا

80
00:06:39,770 --> 00:06:44,500
وذلك ما حدث في هذا القصر
.للكونت السّابق لمونتيس

81
00:06:44,870 --> 00:06:46,690
فرقة من القتلة المغتالين؟

82
00:06:46,690 --> 00:06:49,510
.لم تخبرنا النّقابة بذلك

83
00:06:51,810 --> 00:06:54,260
.كفانا دردشة الآن

84
00:06:54,260 --> 00:06:56,700
.لنواصل رقصنا

85
00:06:57,190 --> 00:07:00,860
.إنّ إرسالي إلى هذا المكان أشبه بالحلم

86
00:07:00,860 --> 00:07:04,020
إنّ أسوأ الظّروف تكون مثاليّة
!من أجل أفضل عرض

87
00:07:06,210 --> 00:07:09,490
إن استعملتُ مهارة استحضار الأرواح
،للسّيطرة على مستعمل مهارة الاستعداء

88
00:07:09,490 --> 00:07:13,130
!بإمكاني اللّعب بدُماي بلا نهاية

89
00:07:17,910 --> 00:07:20,280
مهارات محرّمة؟

90
00:07:20,800 --> 00:07:25,380
ماذا إن وجّه تلك القوّة المرعبة ضدّ النّاس؟

91
00:07:25,690 --> 00:07:30,630
بإمكان استعمال سيّد الفواكه
.للحصول على عدد لا نهائيّ من المهارات

92
00:07:30,930 --> 00:07:36,130
هل كان العالم ليحتفل بمهارة
غير عاديّة كهذه؟

93
00:07:40,950 --> 00:07:45,450
قد يتمّ نبذي يومًا ما وأسير على
.نفس المسار الّذي سلكه الكونت

94
00:07:46,390 --> 00:07:48,930
سيّد لايت، هل أنت بخير؟

95
00:07:48,930 --> 00:07:51,150
.نعم. لا داعي للقلق

96
00:07:51,570 --> 00:07:55,800
هذا صحيح. عليّ الآن التّركيز
!على حماية أيلا والقتال

97
00:08:00,200 --> 00:08:03,980
أيلا، لاحظتُ شيئًا بينما كنت
.أراقب حركات الموتى الأحياء

98
00:08:03,980 --> 00:08:09,960
تستعمل دارتينا استحضار الأرواح لتحديد
الأهداف وطرق الهجوم، أليس كذلك؟

99
00:08:09,960 --> 00:08:15,280
نعم. تكرّر الوحوش الّتي تحت
سيطرتها نفس الهجمات فحسب

100
00:08:15,280 --> 00:08:18,160
.حتّى تحصل على تعليمات جديدة

101
00:08:18,160 --> 00:08:19,470
...في تلك الحالة

102
00:08:19,470 --> 00:08:24,350
فهمت. إذًا فكُلّك عزم على
.التّسبب بالمشاكل لهم

103
00:08:24,350 --> 00:08:26,610
عمّن تتحدّثين؟

104
00:08:26,610 --> 00:08:29,320
.سأقصي عليك في الحال

105
00:08:29,320 --> 00:08:31,110
!حان وقت المشهد الأخير

106
00:08:32,610 --> 00:08:35,360
!لا، سأنهي هذا

107
00:08:35,360 --> 00:08:38,120
!أسلوب سيف الإله، موجة السّيف

108
00:08:38,120 --> 00:08:39,240
—لن ينفع ذلك ضدّ

109
00:08:39,540 --> 00:08:40,870
.أمزح فحسب

110
00:08:40,870 --> 00:08:42,050
!ماذا؟

111
00:08:44,580 --> 00:08:45,960
هل قفز؟

112
00:08:46,340 --> 00:08:48,960
.لستُ خصمك

113
00:08:51,940 --> 00:08:53,970
قدّيسة السّيف؟ متى وصلت إلى هنا؟

114
00:08:54,250 --> 00:08:56,800
!غيّر هدفك يا حاصد الأرواح

115
00:08:56,800 --> 00:08:58,970
!استعمل كلّ قوّتك لقضاء على لينا

116
00:08:59,340 --> 00:09:01,060
!حسنًا. لقد تأخّرت

117
00:09:07,650 --> 00:09:09,940
هل الوقت غير المنتظم ليس من نقاط قوّتك؟

118
00:09:14,710 --> 00:09:17,450
.دراتينا، لن أقتلك

119
00:09:17,760 --> 00:09:20,330
.لديّ العديد من الأسئلة لطرحها عليك

120
00:09:20,330 --> 00:09:22,620
.مذهل يا آنسة لينا

121
00:09:22,620 --> 00:09:24,440
.لم يبقَ الآن إلاّ الكونت

122
00:09:28,330 --> 00:09:30,150
.حان الوقت لترتاح بسلام الآن

123
00:09:31,280 --> 00:09:34,210
.أكره... المهارات

124
00:09:34,670 --> 00:09:38,960
.يومًا ما... ستكرهها... أيضًا

125
00:09:42,560 --> 00:09:44,490
.لن ينتهي بي المطاف مثلك

126
00:09:46,120 --> 00:09:47,230
...في تلك الحالة

127
00:09:48,490 --> 00:09:50,650
!لايت! ابتعد من هناك

128
00:09:52,750 --> 00:09:55,990
!يحاول ذلك الميت الحيّ استدعاء شيء ما

129
00:09:55,990 --> 00:09:59,620
!أرهم آخر دفعة من قوّتك

130
00:09:59,620 --> 00:10:00,990
!التّحريض

131
00:10:05,330 --> 00:10:08,080
!ذلك ضخم! هذا سيّئ للغاية

132
00:10:14,590 --> 00:10:16,090
ما الّذي يحدث؟

133
00:10:33,680 --> 00:10:35,860
ما هذا الشّيء؟

134
00:10:40,720 --> 00:10:42,620
!إنّه أفضل حتّى ممّا تخيّلت

135
00:10:42,810 --> 00:10:46,120
...وأخيرًا، فإنّكم

136
00:10:48,390 --> 00:10:51,900
!سيّد لايت، إنّه تنّين شرّير

137
00:10:59,010 --> 00:11:02,570
.تنّين شرّير؟ لم أكن أعلم أنّه موجود بالفعل

138
00:11:02,570 --> 00:11:03,760
أتعرفين شيئًا عنه؟

139
00:11:03,760 --> 00:11:05,830
.سمعتُ عنها فحسب

140
00:11:05,830 --> 00:11:10,520
إنّها أهداف للمطاردات عالية المستوى الّتي
.لا يخرج إليها كثيرًا حتّى مغامرو الرّتبة س

141
00:11:10,850 --> 00:11:14,320
لـ-لكنّنا سنتدبّر أمرنا بطريقة ما
إن جمعنا مهاراتنا معًا، صحيح؟

142
00:11:14,320 --> 00:11:17,030
!لا-لا يجب عليكما القيام بذلك إطلاقًا

143
00:11:17,280 --> 00:11:20,610
ذلك التّنّين الشّرّير منيع ضدّ
.الهجمات القاطعة

144
00:11:20,610 --> 00:11:24,780
.ستصّد حراشفه الصّلبة كلّ هجمات سيفيكما

145
00:11:24,780 --> 00:11:28,270
...لكن بالقوّة القصوى لسيف الإله

146
00:11:29,780 --> 00:11:30,370
!لايت

147
00:11:30,790 --> 00:11:33,670
!أسلوب إله السّيف، تقطيع الشّيطان

148
00:11:38,210 --> 00:11:38,960
!كلاّ

149
00:11:40,430 --> 00:11:41,720
أهذا معقول؟

150
00:11:41,720 --> 00:11:45,120
!ألم أحذّرك من هذا للتّوّ

151
00:11:45,120 --> 00:11:46,720
ماذا نفعل يا لينا؟

152
00:11:47,080 --> 00:11:50,330
.بمجرّد أن ندير بظهرنا له، سنهلك

153
00:11:52,230 --> 00:11:56,980
،حتّى إن كان لا يمكننا الفوز
.عليّ ضمان نجاة هذين الاثنين

154
00:11:57,280 --> 00:12:00,650
.سيّد لايت، لديّ فكرة

155
00:12:01,550 --> 00:12:02,650
.استعمل هذه

156
00:12:04,150 --> 00:12:07,870
.فهمت. علينا اغتنام تلك الفرصة

157
00:12:11,300 --> 00:12:13,870
.أحسنت يا صاحب السّعادة

158
00:12:14,140 --> 00:12:17,380
استدعيتَ تنّينًا شرّيرًا، أحد أقوى
.الوحوش الموجودة على الإطلاق

159
00:12:17,760 --> 00:12:21,260
.حتّى أنا لا أستطيع السّيطرة عليه

160
00:12:24,150 --> 00:12:28,010
.انتهى أمركم

161
00:12:46,030 --> 00:12:49,030
أيلا، لماذا لديك فاكهة مهارات؟

162
00:12:49,880 --> 00:12:53,040
أحضرتُ بعضها معي عندما
.فكّرتُ في أنّها قد تفيدنا

163
00:12:53,600 --> 00:12:57,540
إنّ ذلك أفضل بكثير من مواجهة
.التّنّين الشّرّير في وضعنا الحاليّ

164
00:13:04,500 --> 00:13:06,220
.هذا خيارنا الوحيد

165
00:13:06,480 --> 00:13:09,340
إن كان بإمكان مهارتي الجديدة
...أن تساعدنا على قتاله

166
00:13:09,340 --> 00:13:12,220
هل أنت جادّ بخصوص أكل
فاكهة مهارات أخرى؟

167
00:13:12,560 --> 00:13:14,880
.أنا منيع ضدّ سمّ الفاكهة

168
00:13:14,880 --> 00:13:17,850
سأكون قادرًا على أكل العدد
.الّذي أريد من فواكه المهارات

169
00:13:17,850 --> 00:13:21,910
.لكن لا ضمانة أنّها ستكون مهارة جيّدة

170
00:13:21,910 --> 00:13:25,860
قد تحصل على مهارة
.قد تتعارض مع إله السّيف

171
00:13:25,860 --> 00:13:27,660
.ذلك ممكن

172
00:13:27,660 --> 00:13:30,680
.كما هنالك مهارات محرّمة أيضًا

173
00:13:30,680 --> 00:13:34,870
ولكن هل هنالك أيّ طريقة أخرى لنفوز؟

174
00:13:38,120 --> 00:13:39,490
.لا بأس

175
00:13:39,490 --> 00:13:41,700
.لن تسمح لي مهارة سيّد الفواكه بالموت

176
00:13:43,760 --> 00:13:45,170
!سيّد لايت

177
00:13:45,170 --> 00:13:45,880
!لايت

178
00:13:46,330 --> 00:13:48,670
...إنّه ذلك الشّعور ثانية

179
00:13:55,120 --> 00:13:57,730
لايت، هل تعاني من آثار جانبيّة؟

180
00:13:58,000 --> 00:14:00,980
.أنا بخير. أيلا، استعملي التّقييم

181
00:14:02,180 --> 00:14:03,480
...هذه المهارة هي

182
00:14:04,880 --> 00:14:06,490
!"مقاومة الحشرات"

183
00:14:07,690 --> 00:14:08,490
ماذا؟

184
00:14:08,800 --> 00:14:11,760
أهنالك فرصة أن يكون التّنّين الشّرّير حشرة؟

185
00:14:11,760 --> 00:14:12,470
.لا

186
00:14:12,470 --> 00:14:14,240
!سُحقًا! الفاكهة التّالية

187
00:14:14,240 --> 00:14:16,750
ما الّذي تفعلانه؟

188
00:14:22,420 --> 00:14:23,210
!لينا

189
00:14:23,210 --> 00:14:24,250
!آنسة لينا

190
00:14:24,250 --> 00:14:27,920
!أنا بخير! سأجذب انتباه التّنّين الشّرّير

191
00:14:28,310 --> 00:14:30,390
.سيّد لايت، هذه فرصتك

192
00:14:30,720 --> 00:14:33,890
.أيلا، أعطني فاكهتين
.سآكلهما معًا في نفس الوقت

193
00:14:34,140 --> 00:14:38,100
ماذا؟ إنّنا نجهل ما قد يحدث
.لجسدك إن فعلت ذلك

194
00:14:38,370 --> 00:14:40,320
.إنّنا في سباق ضدّ الوقت هنا

195
00:14:40,320 --> 00:14:42,890
.لن تتحمّل لينا طويلاً

196
00:14:42,890 --> 00:14:44,650
.حا-حاضرة

197
00:14:51,920 --> 00:14:53,030
...إنّها

198
00:14:57,740 --> 00:14:59,040
!"مروّض قطط"

199
00:14:59,320 --> 00:15:01,740
.أنا أحسدك، لكنّها غير مفيدة على الإطلاق

200
00:15:01,740 --> 00:15:04,040
.إنّها تجعل القطط تحبّك أكثر فحسب

201
00:15:04,040 --> 00:15:06,800
ماذا عن المهارة الأخرى؟

202
00:15:07,350 --> 00:15:09,530
!"معزّز صلابة الأسلحة"

203
00:15:09,530 --> 00:15:12,050
.إنّها تقلّل من فرص انكسار أسلحتك

204
00:15:12,050 --> 00:15:16,650
.فعلاً؟ لكنّ سيفي كُسر للتّوّ

205
00:15:16,650 --> 00:15:18,430
.ليتني أكلتها قبل ذلك

206
00:15:20,580 --> 00:15:21,940
!سيّد لايت

207
00:15:21,940 --> 00:15:24,430
.جسدي يشتعل

208
00:15:24,430 --> 00:15:27,940
.إنّ أكل فاكهتين يضاعف الآثار الجانبيّة

209
00:15:28,460 --> 00:15:32,450
،إن لم تكن الفاكهة التّالية مفيدة
.فلن أستطيع التّحرّك

210
00:15:42,420 --> 00:15:45,170
هذا أقصى ما يمكنني القيام به
!بالهجمات القاطعة

211
00:15:56,230 --> 00:15:57,680
!لينا

212
00:15:57,680 --> 00:16:00,700
!علينا المراهنة بكلّ شيء على هذه

213
00:16:07,320 --> 00:16:08,820
!سيّد لايت

214
00:16:08,820 --> 00:16:10,260
ما هذا؟

215
00:16:25,280 --> 00:16:26,290
.لايت

216
00:16:28,520 --> 00:16:30,770
.آسف لجعلك تنتظرين يا لينا

217
00:16:40,520 --> 00:16:42,250
!آنسة لينا

218
00:16:42,250 --> 00:16:45,950
ما المهارة الّتي حصل عليها لايت؟

219
00:16:45,950 --> 00:16:47,270
...إنّها

220
00:16:47,860 --> 00:16:49,070
!روح النّوم

221
00:16:50,510 --> 00:16:55,280
إنّ أيّ كائن يستنشق
.تلك القشور سيخلد للنّوم

222
00:16:58,780 --> 00:17:01,120
!هيّا يا روح النّوم

223
00:17:08,290 --> 00:17:09,650
ما رأيك؟

224
00:17:16,180 --> 00:17:18,810
!إنّه يهيج ليظلّ مستيقظًا

225
00:17:19,360 --> 00:17:20,930
لماذا لا ينام؟

226
00:17:20,930 --> 00:17:24,840
إنّ القشور تنتشر قبل أن تصل
.إلى التّنّين الشّرّير

227
00:17:24,840 --> 00:17:28,590
لكنّنا قريبون جدًّا. ماذا علينا أن نفعل؟

228
00:17:33,150 --> 00:17:37,700
أيلا، ما أبعد مسافة منّي
تستطيع روح النّوم الطّيران إليها؟

229
00:17:38,080 --> 00:17:40,450
.الحدّ الأقصى هو ثلاثة أمتار

230
00:17:40,450 --> 00:17:42,450
ثلاثة أمتار؟

231
00:17:42,450 --> 00:17:46,260
،إن أردتُ منه أن يستنشقها
.فعليّ الصّعود للأعلى

232
00:17:47,720 --> 00:17:48,710
ماذا؟

233
00:17:50,090 --> 00:17:52,710
.من الجيّد أنّ سيفي قد كُسر

234
00:17:52,710 --> 00:17:56,220
ما الّذي ستفعله بسيف مكسور؟

235
00:17:56,220 --> 00:17:58,680
.لا يزال السّيف المكسور سيفًا

236
00:17:58,680 --> 00:18:00,970
.بإمكاني تشغيل مهارة إله السّيف بينما أحمله

237
00:18:00,970 --> 00:18:02,220
ماذا؟

238
00:18:02,520 --> 00:18:04,320
.سأحصل على فرصة واحدة فقط

239
00:18:04,320 --> 00:18:05,680
!خذ هذا

240
00:18:07,860 --> 00:18:09,960
...لقد استعمل نصله الأكثر صلابة الآن

241
00:18:09,960 --> 00:18:11,610
!لتدمير السّقف؟

242
00:18:15,850 --> 00:18:16,870
أيُعقل؟

243
00:18:16,870 --> 00:18:20,380
فعل ذلك ليستطيع القفز
على الحطام المتساقط؟

244
00:18:21,690 --> 00:18:22,660
!سيّد لايت

245
00:18:22,660 --> 00:18:23,450
!لايت

246
00:18:26,050 --> 00:18:29,770
لا بدّ أنّي قريب جدًّا الآن
ولن تستطيع تفادي هذا، صحيح؟

247
00:18:52,110 --> 00:18:53,690
.لقد نام

248
00:18:54,810 --> 00:18:56,240
!نجحنا

249
00:18:56,240 --> 00:18:57,490
!أجل

250
00:18:58,450 --> 00:19:00,490
.حسنًا، هذه فرصتنا

251
00:19:01,020 --> 00:19:02,330
لينا، أيمكنك الوقوف؟

252
00:19:02,330 --> 00:19:04,300
.نعم، لكن بالكاد

253
00:19:04,300 --> 00:19:06,430
.من الأفضل أن نخرج من هنا بسرعة

254
00:19:35,290 --> 00:19:36,900
.كان ذلك وشيكًا

255
00:19:39,020 --> 00:19:41,100
لايت، هل أنت بخير؟

256
00:19:41,100 --> 00:19:48,160
نعم. لنعد للمنزل ونأخذ مكافأتنا
.ونأكل بعض الطّعام اللّذيذ

257
00:19:56,560 --> 00:19:59,170
.البلدة بعد هذه الغابة

258
00:20:01,670 --> 00:20:05,180
.لن أترك اللّجام

259
00:20:15,680 --> 00:20:16,690
...تلك

260
00:20:16,690 --> 00:20:18,690
الآنسة لينا، قدّيسة السّيف؟

261
00:20:18,690 --> 00:20:21,190
!أدخلونا رجاءً

262
00:20:21,440 --> 00:20:23,950
!حا-حاضر، في الحال

263
00:20:24,200 --> 00:20:25,660
!افتحوا البوّابة

264
00:20:28,450 --> 00:20:30,310
...أنوار البلدة

265
00:20:32,200 --> 00:20:36,330
.نجحنا بفضلك يا أيلا. شكرًا لك

266
00:20:36,330 --> 00:20:38,710
.لا، على الإطلاق

267
00:20:39,010 --> 00:20:40,960
...وأنت أيضًا يا لينا... كنت

268
00:20:47,030 --> 00:20:47,970
لايت؟

269
00:20:48,240 --> 00:20:49,470
!سيّد لايت

270
00:20:49,810 --> 00:20:51,980
ما-ما الخطب؟

271
00:20:52,450 --> 00:20:54,580
!لايت

272
00:22:37,930 --> 00:22:39,340
.حسنًا، عليّ الذّهاب

273
00:22:40,150 --> 00:22:41,700
كيف بدا لك؟

274
00:22:42,380 --> 00:22:45,050
تقصدين سيّد الفواكه؟

275
00:22:45,280 --> 00:22:46,310
.نعم

276
00:22:46,310 --> 00:22:50,030
كنتُ متفاجئًا قليلاً عندما سمعت
،أنّه هزم التّنّين الشّرّير

277
00:22:50,550 --> 00:22:53,550
لكنّه لا يشكّل أيّ تهديد لنا
.نحن البجعة السّوداء

278
00:22:54,330 --> 00:22:57,490
.هكذا إذًا. شكرًا لك

279
00:22:58,450 --> 00:22:59,340
.أستأذن بالذّهاب

280
00:23:03,620 --> 00:23:05,930
.لا أصدّق أنّه بهذه القوّة

281
00:23:06,400 --> 00:23:10,100
.هذه هي قوّة الأبريوري

282
00:23:11,520 --> 00:23:15,660
.لا، ربّما يمتلك شيئًا مميّزًا آخر

283
00:23:16,550 --> 00:23:20,160
.في كلّ الأحوال، إنّ وقت لقائهم يقترب

284
00:23:25,620 --> 00:23:27,510
!انهار السّيّد لايت

285
00:23:27,510 --> 00:23:31,160
.لنأخذ هذه الفرصة ونذهب للتّسوّق

286
00:23:31,160 --> 00:23:34,240
!فكرة جيّدة. هيّا بنا

287
00:23:34,240 --> 00:23:36,340
!ماذا؟ مهلاً

288
00:23:36,340 --> 00:23:39,240
ضع هدف أن تصبح أعظم مغامر
!على الإطلاق نصب عينيك