1
00:00:18,740 --> 00:00:20,300
!لقد نجح

2
00:00:25,630 --> 00:00:26,930
.إنّها من الآنسة لينا

3
00:00:27,380 --> 00:00:30,790
".سأصل إلى أثينا قريبًا"

4
00:00:30,790 --> 00:00:34,090
.يبدو أنّ الأمر يأخذ وقتًا أطول ممّا توقّعت

5
00:00:34,090 --> 00:00:37,100
لينا؟ تقصدين قدّيسة السّيف
الّتي صارت مشهورة مؤخّرًا؟

6
00:00:37,100 --> 00:00:41,270
نعم. إنّها في نفس الفرقة
.معي ومع السّيّد لايت

7
00:00:41,270 --> 00:00:43,870
.إنّها عضوة يُعتمد عليها في لوكسيريا

8
00:00:46,510 --> 00:00:48,210
.بإمكاني رؤيتها أخيرًا

9
00:00:48,210 --> 00:00:52,830
.تلك هي عاصمة البحيرة، أثينا

10
00:00:58,450 --> 00:01:03,580
".مرحبًا في مدينة الجنّيّات والبحيرة، أثينا"

11
00:01:09,520 --> 00:01:12,680
!تعالوا للاستمتاع بحدث يُقام مرّة في السّنة

12
00:01:12,680 --> 00:01:15,840
!مهرجان جنّيّات أثينا التّقليديّ

13
00:01:16,080 --> 00:01:20,600
اشربوا وغنّوا واحتفلوا حتّى
!رقصة الجنّيّات" بعد ثلاثة أيّام"

14
00:01:20,980 --> 00:01:24,460
.مرحبًا بك أيّتها المسافرة
.لتحلّ عليك بركات الجنّيّات

15
00:01:24,460 --> 00:01:25,100
ماذا؟

16
00:01:28,490 --> 00:01:30,990
.يبدو أنّ الجميع مستمتع بوقته

17
00:01:30,990 --> 00:01:33,730
.لا، لا. ليس لديّ وقت للاحتفال

18
00:03:07,450 --> 00:03:14,210
،إن كان سرّ القدّيسة هنا
.فربّما تكون قد أرسلت قاتلاً سلفًا

19
00:03:14,650 --> 00:03:16,210
.عليّ البقاء منتبهة

20
00:03:16,640 --> 00:03:18,340
.المعذرة

21
00:03:18,710 --> 00:03:22,220
.أنا أتحرّى أمر فتاة تُدعى دراتينا بلبوري

22
00:03:22,220 --> 00:03:25,860
ماذا؟! ما علاقتك بعائلة بلبوري؟

23
00:03:25,860 --> 00:03:28,720
لا أصدّق أنّي أسمع بذلك الاسم
.في مثل هذا اليوم السّعيد

24
00:03:31,640 --> 00:03:33,230
ما ردّة الفعل تلك؟

25
00:03:33,660 --> 00:03:35,800
—المعذرة، هل دراتينا بلبو

26
00:03:35,800 --> 00:03:38,230
!ماذا؟! بلبوري؟

27
00:03:38,230 --> 00:03:40,490
!دراتينا؟ ارحلي، ارحلي

28
00:03:40,490 --> 00:03:42,490
!لا-لا أعرف شيئًا

29
00:03:45,780 --> 00:03:49,250
إنّ كلّ من أسأله يتجهّم
.ويرفض إخباري بأيّ شيء

30
00:03:49,500 --> 00:03:52,720
.ماذا أفعل؟ أنا عالقة سلفًا

31
00:03:56,580 --> 00:03:59,850
هل كان ذا القلنسوة ذاك ينظر إليّ؟

32
00:04:05,010 --> 00:04:07,150
أيعقل أنّه قاتل أرسلته القدّيسة؟

33
00:04:08,420 --> 00:04:09,770
...في تلك الحالة

34
00:04:13,270 --> 00:04:15,270
.سأنال منه قبل أن ينال منّي

35
00:04:22,690 --> 00:04:23,830
اختفى؟

36
00:04:28,000 --> 00:04:30,040
!كلاّ! إنّه خلفي

37
00:04:33,210 --> 00:04:35,120
!سواط كرمة؟

38
00:04:38,020 --> 00:04:39,630
...بالنّظر إلى المهارة البغيضة

39
00:04:41,460 --> 00:04:43,520
،والطّريقة الّتي يتصرّف بها

40
00:04:43,520 --> 00:04:45,720
!فإنّه سيكون من الرّتبة س إن كان مغامرًا

41
00:04:46,290 --> 00:04:48,260
.هذا المتوقّع من قدّيسة السّيف

42
00:04:48,260 --> 00:04:50,100
.تعاملك بالسّيف مذهل بالفعل

43
00:04:50,100 --> 00:04:53,350
من أنت؟ لن أظهر لك ذرّة
.رحمة إن كنت لا تنوي على خير

44
00:04:53,350 --> 00:04:57,420
لا يمكنني السّماح لهاوية بالبحث
.في الأرجاء كأنّها جاسوسة

45
00:04:58,110 --> 00:05:00,720
.سأريك أنّي لستُ هاوية على الإطلاق

46
00:05:00,720 --> 00:05:02,740
.توقّفا

47
00:05:02,740 --> 00:05:04,810
.هذا يكفي الآن

48
00:05:04,810 --> 00:05:06,530
.كلاّ. أنا محاصرة

49
00:05:06,900 --> 00:05:09,030
!مكانك، وإلاّ قطعتك بهذا السّيف

50
00:05:09,730 --> 00:05:12,370
.على رسلك
.لا تكوني متعطّشة للدّماء هكذا

51
00:05:14,190 --> 00:05:18,040
.مرحبًا. سررت بلقائك ثانية يا قدّيسة السّيف

52
00:05:18,040 --> 00:05:20,440
الآنسة قبّعة الزّهور؟

53
00:05:23,800 --> 00:05:25,840
.هذا هو تابعي يوان

54
00:05:25,840 --> 00:05:27,130
.سررت بلقائك

55
00:05:27,930 --> 00:05:32,680
طلبتُ منه القيام بالاستطلاع
.بما أنّك كنتِ تسألين بغباء صريح

56
00:05:33,210 --> 00:05:34,810
بغباء"؟"

57
00:05:34,810 --> 00:05:37,470
ما الّذي يفعله مكتب التّحقيقات
في هذه المدينة؟

58
00:05:37,470 --> 00:05:38,810
.نفس ما تفعلينه أنت

59
00:05:38,810 --> 00:05:41,320
.إنّنا نبحث عن دراتينا أيضًا

60
00:05:42,240 --> 00:05:45,820
لماذا؟ ألست إلى جانب القدّيسة؟

61
00:05:45,820 --> 00:05:48,200
.أنا لستُ إلى جانب أيّ أحد

62
00:05:48,200 --> 00:05:50,570
.أنا أجمع المعلومات فحسب

63
00:05:50,910 --> 00:05:53,830
العثور على دراتينا جزء من
.مهمّة إيقاف التّنّين الشّرّير

64
00:05:56,720 --> 00:06:01,300
ما زلنا نحلّل الحرشف الّذي أعطيتنا
.إيّاه في اجتماع التّنّين الشّرّير

65
00:06:01,960 --> 00:06:08,070
دليلنا الوحيد الآخر الآن هو دراتينا
.الّتي كانت متورّطة في استدعائه

66
00:06:08,070 --> 00:06:10,840
لذلك السّبب أتت رئيسة المكتب
.إلى هنا شخصيًّا

67
00:06:10,840 --> 00:06:13,850
.إنّ إيقاف التّنّين الشّرّير مسألة ملحّة بالفعل

68
00:06:13,850 --> 00:06:17,950
ستحلّ كارثة إن ظهر ذلك التّهديد
.في المدينة فجأة

69
00:06:17,950 --> 00:06:21,360
.ذلك صحيح. سيؤثّر ذلك على الكثير من النّاس

70
00:06:21,360 --> 00:06:25,270
،يبدو أنّ لديك صلة شخصيّة مع القدّيسة

71
00:06:25,270 --> 00:06:29,740
،ولكن من وجهة نظر المكتب
.للتّنّين الشّرّير أولويّة أعلى

72
00:06:29,990 --> 00:06:34,920
من الصّعب علينا القيام بعملنا
،إن كنتِ تجذبين الانتباه بأسئلتك تلك

73
00:06:34,920 --> 00:06:37,750
.لذلك توقّفي عن التّجوّل في الأرجاء

74
00:06:38,070 --> 00:06:39,260
.مع السّلامة

75
00:06:39,260 --> 00:06:41,130
!مـ-مهلاً

76
00:06:41,380 --> 00:06:44,380
.ولكنّي لا أستطيع العودة خالية الوفاض

77
00:06:44,830 --> 00:06:47,140
.لديّ شيء أريد حمايته أيضًا

78
00:06:47,630 --> 00:06:50,880
!دعاني أرافقكما رجاءً

79
00:06:52,390 --> 00:06:56,140
الآنسة قبّعة الزّهور رئيسة
.مكتب مثل القدّيسة

80
00:06:56,500 --> 00:07:00,020
.في الأمر مخاطرة، لكنّها خبيرة تحقيقات

81
00:07:00,240 --> 00:07:03,400
أتأملين استغلال مجهوداتنا؟

82
00:07:03,720 --> 00:07:07,650
نعم. أنا يائسة للحصول على
.أيّ معلومة عن دراتينا

83
00:07:09,200 --> 00:07:10,650
.يا لصراحتك

84
00:07:10,650 --> 00:07:12,460
.لا بأس. يمكنك أن تتبعينا

85
00:07:12,460 --> 00:07:13,440
!أجل

86
00:07:13,440 --> 00:07:15,410
.ولكن تحت شرط واحد

87
00:07:15,410 --> 00:07:18,790
.لا أريدك أن تقولي أيّ شيء عن أساليبنا

88
00:07:18,790 --> 00:07:20,790
.مـ-مفهوم

89
00:07:21,280 --> 00:07:23,960
هل أنت واثقة؟ كيف سيفيدنا هذا؟

90
00:07:23,960 --> 00:07:26,450
.سبق ورأت هذه الفتاة وجه دراتينا

91
00:07:26,450 --> 00:07:28,840
.حتّى مكتب التّحقيقات لا يملك تلك المعلومة

92
00:07:28,840 --> 00:07:30,300
.فهمت

93
00:07:30,300 --> 00:07:34,050
.حسنًا. لنذهب للأكل أوّلاً

94
00:07:34,050 --> 00:07:34,870
ماذا؟

95
00:07:43,310 --> 00:07:45,060
.طاب يومكم

96
00:07:45,500 --> 00:07:47,070
.مرحبًا

97
00:07:47,070 --> 00:07:50,690
ثلاث طلبات لمونيير سمك طازج
.تمّ الإمساك به مساءً يا سيّدتي

98
00:07:50,690 --> 00:07:52,950
ألن تقومي بالتّحقيق؟

99
00:07:52,950 --> 00:07:55,320
أيّ صلصة تريدين معه؟

100
00:07:55,320 --> 00:07:58,670
.صلصة بيضاء مع طماطم طُبخت طوال اللّيل

101
00:07:59,520 --> 00:08:01,330
.يا لها من محادثة غريبة

102
00:08:05,370 --> 00:08:07,340
.من هنا لو سمحتم

103
00:08:10,590 --> 00:08:12,590
غرفة في القبو؟

104
00:08:13,520 --> 00:08:16,600
.مرحبًا. شكرًا على الانتظار أيّها المخبر

105
00:08:20,880 --> 00:08:22,480
.إليك العشرين ألف غولد

106
00:08:22,860 --> 00:08:26,100
لن يكون عليك القلق حيال
.الطّعام لعدّة شهور

107
00:08:26,100 --> 00:08:30,480
نريد أن نعرف التّفاصيل
.عن دراتينا بلبوري ومكانها

108
00:08:30,480 --> 00:08:34,610
لا أصدّق أنّ هنالك من قد
.يسأل عن مصدر الإزعاج ذاك

109
00:08:34,930 --> 00:08:39,060
دراتينا ابنة عائلة بلبوري المرموقة
.سابقًا في هذه المدينة

110
00:08:39,060 --> 00:08:39,870
سابقًا؟

111
00:08:40,110 --> 00:08:44,060
.نعم. لقد انهارت بسببها

112
00:08:45,820 --> 00:08:50,830
حصلت فتاة صغيرة تحبّ الرّقص
على مهارة استحضار الأرواح

113
00:08:51,260 --> 00:08:52,950
.في سنّ السّادسة

114
00:08:53,630 --> 00:08:57,570
وبالصّدفة، شهدت الأسرة سلسلةً
،من الأحداث المؤسفة في نفس الوقت

115
00:08:57,570 --> 00:09:00,770
مثل تراجع أعمالهم التّجاريّة
.والموت المفاجئ لوالدة دراتينا

116
00:09:00,770 --> 00:09:04,890
انتشرت إشاعة في المدينة تقول
.أنّ عائلتهم كانت ملعونة

117
00:09:05,210 --> 00:09:09,470
ألقى والدها لومَ سوءِ حظّهم
،على مهارتها المحرّمة

118
00:09:09,470 --> 00:09:13,650
.لذلك تبرّأ منها وأرسلها للعيش في فيلاّ

119
00:09:13,970 --> 00:09:15,030
ماذا؟

120
00:09:15,030 --> 00:09:21,030
مذّلك الحين، نبذها أهل المدينة
.باعتبارها شخصًا سيّئ الحظّ

121
00:09:22,000 --> 00:09:25,290
.لا عجب أنّ سكّان المدينة يرفضون الحديث عنها

122
00:09:25,290 --> 00:09:30,220
.داعمة دراتينا الوحيدة هي السّيّدة القدّيسة

123
00:09:31,200 --> 00:09:34,430
ربّما أشفقت على دراتينا لأنّها كانت حاضرة
،عندما حصلت على مهارتها المحرّمة

124
00:09:34,430 --> 00:09:39,800
لكنّ السّيّدة القدّيسة تبادلت الرّسائل
.معها ودعتها إلى المدينة المقدّسة

125
00:09:39,800 --> 00:09:46,310
بالنّسبة للسّيّدة القدّيسة، ربّما كانت واحدة
.من عدّة أطفال غير محظوظين دعمتهم

126
00:09:48,310 --> 00:09:50,720
قامت القدّيسة بكلّ ذلك؟

127
00:09:50,720 --> 00:09:54,440
هكذا إذًا. لكن أين دراتينا الآن؟

128
00:09:54,840 --> 00:09:56,360
.في هذه المدينة

129
00:09:56,610 --> 00:09:58,110
أتقصد أنّها حيّة؟

130
00:09:58,110 --> 00:10:00,370
.يا له من أمر غريب تقولينه

131
00:10:00,670 --> 00:10:02,710
أهنالك إشاعات تقول أنّها ماتت؟

132
00:10:04,740 --> 00:10:07,320
إذًا فقد هربت من القصر المنهار؟

133
00:10:15,510 --> 00:10:22,260
أعتقد أنّنا تفاوضنا على هذا السّعر مسبقًا
.للحصول على تفاصيل عن دراتينا ومكانها

134
00:10:22,260 --> 00:10:25,270
.أذلك صحيح؟ لقد نسيت

135
00:10:25,270 --> 00:10:27,270
.أرى أنّ هذه مشكلة

136
00:10:27,270 --> 00:10:32,000
.أودّ إخباركم بالفعل، لكنّي أدير عملاً هنا

137
00:10:32,000 --> 00:10:33,020
...يوان

138
00:10:34,720 --> 00:10:37,300
تكلّم! أين دراتينا؟

139
00:10:38,570 --> 00:10:40,070
!تجاوزتما الحدود

140
00:10:40,070 --> 00:10:42,200
.أخبرتك أن تبقي فمك مغلقًا

141
00:10:42,200 --> 00:10:45,080
.هو من خرق اتّفاقنا أوّلاً

142
00:10:45,330 --> 00:10:48,930
كانت حماقة منك أن تحاول
.استغلال مكتب التّحقيقات

143
00:10:50,460 --> 00:10:53,090
.سـ-سأتكلّم. إنّها في حيّ المسرح

144
00:10:53,350 --> 00:10:57,010
.إنّها تستعدّ لرقصة الجنّيّات هناك

145
00:10:57,010 --> 00:11:00,050
.كان عليك قول ذلك من البداية

146
00:11:01,840 --> 00:11:03,840
.حصلتما على المعلومة منه بالتّعذيب تقريبًا

147
00:11:03,840 --> 00:11:06,100
.إنّك لطيفة جدًّا يا قدّيسة السّيف

148
00:11:06,100 --> 00:11:10,100
لا يمكن العثور على المعلومات
.القيّمة على قارعة الطّريق

149
00:11:10,100 --> 00:11:12,770
.سأفعل كلّ ما يتطلّبه الأمر للحصول عليها

150
00:11:12,770 --> 00:11:15,110
.ذلك هو أسلوبي

151
00:11:21,570 --> 00:11:25,340
هل ستحرجين اليوم ثانية يا سيّدتي دراتينا؟

152
00:11:29,080 --> 00:11:31,240
.نعم. سأعود سريعًا

153
00:11:32,610 --> 00:11:34,650
،يمكنك الخروج متى تشائين

154
00:11:34,650 --> 00:11:38,340
لكن إن لم ترتاحي، فستسوء
.إصاباتك الّتي تكبّدتِها ذلك اليوم

155
00:11:38,340 --> 00:11:40,590
.لا وقت لديّ لذلك

156
00:11:41,030 --> 00:11:45,120
.رشّحتني السّيّدة القدّيسة لأكون راقصة

157
00:11:45,120 --> 00:11:47,220
.أريد أن أكون مستعدّة بالكامل من أجل أدائي

158
00:11:47,760 --> 00:11:51,730
،حسنًا إذًا. في تلك الحالة
.سأحضّر العربة لك

159
00:11:54,730 --> 00:12:01,320
رقصة الجنّيّات تقليد مقدّس
.يُقام في اليوم الأخير لمهرجان الجنّيّات

160
00:12:01,320 --> 00:12:02,490
مقدّس؟

161
00:12:02,770 --> 00:12:08,150
نعم. قبل ألف سنة، حمى ملك الجنّيّات
.هذه البحيرة من جيش من الوحوش

162
00:12:08,150 --> 00:12:11,500
التّقليد هو إعادة تمثيل للأسطورة
.وصلاةٌ من أجل السّلام

163
00:12:11,500 --> 00:12:13,330
إعادة تمثيل للأسطورة؟

164
00:12:13,330 --> 00:12:20,120
يُقال أنّ القوّة المُطهِّرة لحجر الجنّيّات
،تحمي هذه المدينة من كارثة

165
00:12:20,120 --> 00:12:22,630
.لذلك لا بدّ أنّه حدثٌ مهمّ

166
00:12:23,000 --> 00:12:27,390
في كلّ سنة، يتمّ اختيار بنات من
.عائلات مرموقة لتكنّ راقصات

167
00:12:31,640 --> 00:12:35,900
لذلك تمّ اختيار دراتينا
.لتكون راقصةً هذه السّنة

168
00:12:36,330 --> 00:12:42,150
لا بدّ أنّها ليست مرتاحة بتواجدها
في هذه المدينة، لذلك لماذا تظلّ هنا؟

169
00:12:42,150 --> 00:12:45,500
.سنكتشف ذلك عن طريق التّسلّل لهذا المكان

170
00:12:48,340 --> 00:12:54,540
حسب المُخبر، فإنّ الرّاقصات
.والفرقة يتدرّبون هنا

171
00:12:54,540 --> 00:12:56,630
.ودراتينا واحدة منهم

172
00:13:01,880 --> 00:13:04,800
.لا يُسمح إلاّ لمن لديهم إذن بالدّخول

173
00:13:04,800 --> 00:13:06,640
.عودوا من حيث أتيتم رجاءً

174
00:13:06,640 --> 00:13:09,890
...لدينا إذن بالطّبع. نحن

175
00:13:17,050 --> 00:13:20,270
.الأختان الرّاقصتان وعازف النّاي

176
00:13:20,270 --> 00:13:22,600
أأنتما من الرّاقصات بالفعل؟

177
00:13:22,600 --> 00:13:24,530
.لم أسمع بهما من قبل

178
00:13:24,530 --> 00:13:28,340
يبدو أنّهم كانوا بحاجة لراقصات
.أكثر بأجساد رشيقة

179
00:13:28,340 --> 00:13:31,160
.لذلك تمّ اختيارنا لاحقًا

180
00:13:31,560 --> 00:13:34,600
.فهمت. إنّكما ظريفتين بكلّ تأكيد

181
00:13:34,600 --> 00:13:36,410
ماذا عن السّيوف الّتي تحملونها؟

182
00:13:36,410 --> 00:13:39,010
.إنّها مجرّد أدوات للرّقصة

183
00:13:39,010 --> 00:13:42,380
.إنّنا نؤدّي عرض الفرسان الجنّيّات

184
00:13:43,420 --> 00:13:46,020
.لكنّ سيفي حقيقيّ

185
00:13:49,570 --> 00:13:51,560
.يمكنكم المرور

186
00:13:51,560 --> 00:13:55,310
.حسنًا. نجح الأمر. كان ذلك سهلاً

187
00:13:55,560 --> 00:13:59,940
.لكنّي لا أستطيع الرّقص
ماذا عليّ أن أفعل؟

188
00:14:00,190 --> 00:14:01,760
.سنكتشف حلاًّ ما

189
00:14:01,760 --> 00:14:04,060
.لا يستطيع يوان عزف أيّ آلات أيضًا

190
00:14:04,060 --> 00:14:05,690
.كلّ ما يمكنني فعله هو التّظاهر

191
00:14:05,690 --> 00:14:07,430
فعلاً؟

192
00:14:07,430 --> 00:14:09,320
أرأيت تلك الرّاقصة؟

193
00:14:09,550 --> 00:14:12,750
.إنّها ابنة بلبوري ذات المهارة المحرّمة

194
00:14:12,750 --> 00:14:16,000
.عليك البقاء بعيدة عنها، وإلاّ ستُلعنين

195
00:14:16,000 --> 00:14:19,960
أخبرني أبي بألاّ أقترب
.من آل بلبوري مهما كلّف الأمر

196
00:14:20,860 --> 00:14:23,710
،قد يكونون عائلة مرموقة
.لكنّ كلماتهم ليست لطيفة

197
00:14:24,400 --> 00:14:28,470
أيّ حياة عاشتها دراتينا يا ترى؟

198
00:14:36,220 --> 00:14:39,730
ما رأيك؟ أتعرّفت إلى أيّ أحد؟

199
00:14:52,470 --> 00:14:54,370
.إنّها حيّة بالفعل

200
00:14:56,270 --> 00:14:58,870
ما الّذي تفعلينه هنا؟

201
00:15:01,370 --> 00:15:02,250
!يوان

202
00:15:07,710 --> 00:15:10,650
قدّيسة السّيف ورئيسة مكتب؟

203
00:15:10,650 --> 00:15:12,720
ما الّذي تفعلانه معًا؟

204
00:15:12,960 --> 00:15:15,960
.دراتينا، سأكون صريحة معك

205
00:15:15,960 --> 00:15:18,850
هل لديك أدنى فكرة عن مكان
التّنّين الشّرّير حاليًّا؟

206
00:15:19,560 --> 00:15:24,860
لا. لم يكن تحت سيطرتي منذ
.اللّحظة الّتي استُدعي فيها

207
00:15:25,110 --> 00:15:26,750
.إذًا لم يوصلنا الدّليل لأيّ مكان

208
00:15:27,680 --> 00:15:30,110
.في تلك الحالة، سآخذك إلى المدينة المقدّسة

209
00:15:30,110 --> 00:15:32,640
.أودّ استعمال مهارة تعقّب السّحر عليك

210
00:15:32,640 --> 00:15:33,870
الآن؟

211
00:15:33,870 --> 00:15:36,870
.نعم. إنّنا في سباق ضدّ الزّمن

212
00:15:37,200 --> 00:15:40,660
،سأذهب إلى المدينة المقدّسة
!لكن بعد يومين من الآن

213
00:15:40,660 --> 00:15:43,120
!أريد البقاء هنا حتّى رقصة الجنّيّات

214
00:15:43,120 --> 00:15:45,880
.لسوء الحظّ، لا يمكنني التّنازل

215
00:15:45,880 --> 00:15:48,900
!أردتُ أن أكون راقصة مذ كنتُ صغيرة

216
00:15:48,900 --> 00:15:50,510
!اسمحي لي بهذا على الأقلّ

217
00:15:52,380 --> 00:15:55,060
،أيّتها الآنسة قبّعة الزّهور
.بإمكاننا تأجيل الأمر ليومين

218
00:15:55,060 --> 00:15:57,390
.وعدتني بألاّ تتدخّلي في الأمر

219
00:16:00,310 --> 00:16:01,430
!هذا مؤلم

220
00:16:02,390 --> 00:16:03,810
...إنّ ساقها

221
00:16:04,160 --> 00:16:06,820
الإصابة الّتي تكبّدَتها في قصر
.الكونت لم تُشف بعد

222
00:16:06,820 --> 00:16:10,620
إنّك تتجاهلين تهديدًا لتكوني
راقصة كما كنت تحلمين؟

223
00:16:10,620 --> 00:16:12,950
ألا ترين أنّ تصرّفك أنانيّ بعض الشّيء؟

224
00:16:13,250 --> 00:16:16,200
إن قاومتِ، فسأجرّك إلى العاصمة
.المقدّسة بالقوّة إن اضطررت

225
00:16:18,760 --> 00:16:21,580
ستفعل كلّ ما يتطلّبه الأمر
.للحصول على المعلومات

226
00:16:21,580 --> 00:16:24,080
.هذا هو حسّ عدالة الآنسة قبّعة الزّهور

227
00:16:25,280 --> 00:16:26,850
ماذا عنّي؟

228
00:16:27,480 --> 00:16:28,590
...أنا

229
00:16:43,560 --> 00:16:44,560
!تعالي معي

230
00:16:44,560 --> 00:16:45,310
ماذا؟

231
00:16:47,310 --> 00:16:49,840
.لم أتوقّع هذا

232
00:16:49,840 --> 00:16:51,110
.فتاة حمقاء

233
00:16:57,210 --> 00:16:58,060
!اقفزي

234
00:17:06,250 --> 00:17:08,700
أتنويان الهرب عبر أسطح المنازل؟

235
00:17:26,520 --> 00:17:30,770
.نزلتا في الحال. لقد نالتا منّي

236
00:17:31,620 --> 00:17:34,440
.أنا آسف. سمحتُ لهما بالهرب

237
00:17:35,170 --> 00:17:36,800
.هذه ليست مشكلة

238
00:17:36,800 --> 00:17:39,450
،بما أنّ دراتينا مهووسة بالرّقصة

239
00:17:39,450 --> 00:17:43,170
فلن تغادرا المدينة بينما
.المهرجان لا يزال قائمًا

240
00:17:46,370 --> 00:17:52,340
،ظننتُ أنّ تلك الفتاة مطواعة
.لكنّها جريئة للغاية

241
00:17:53,180 --> 00:17:54,840
.يا للشّباب

242
00:18:05,840 --> 00:18:07,360
.أعتقد أنّنا أضعناهما

243
00:18:07,360 --> 00:18:09,600
ما الّذي تفعلينه؟

244
00:18:10,550 --> 00:18:12,110
.لا أدري

245
00:18:12,110 --> 00:18:13,610
ماذا؟

246
00:18:14,240 --> 00:18:15,950
أأنت جادّة؟

247
00:18:26,790 --> 00:18:29,340
أسمعتما بهذه الأسطورة؟

248
00:18:31,170 --> 00:18:37,520
خُتم خادم مخلص لملك الجنّيّات
.في قاعدة حجر الجنّيّات الضّخم

249
00:18:37,520 --> 00:18:41,740
ولمدّة ألف عام، حافظ على
.السّلام في بحيرة أثينا

250
00:18:42,260 --> 00:18:45,440
.فعلاً؟ لذلك السّبب يلمع

251
00:18:45,440 --> 00:18:48,020
.يبدو سحريًّا جدًّا في اللّيل

252
00:18:48,610 --> 00:18:52,680
يُقال أنّ رقصة الجنّيّات تقليدٌ هدفه تهدئته

253
00:18:52,680 --> 00:18:58,440
بما أنّه ترك عالم الجنّيّات
.وأصبح حارسًا لعالمنا

254
00:18:58,440 --> 00:19:00,360
.يا لها من قصّة جميلة

255
00:19:00,360 --> 00:19:06,830
نعم، لكن ماذا قد يحدث لهذه
المدينة إن ظهرت صدوع في الحجر؟

256
00:19:06,830 --> 00:19:09,030
ماذا؟ ماذا قلت؟

257
00:19:09,030 --> 00:19:12,000
.لا شيء، لا تعيراني اهتمامًا

258
00:19:12,000 --> 00:19:15,590
،سيّدي الشّاعر
أيمكنك عزف أغنية لنا أيضًا؟

259
00:19:15,840 --> 00:19:17,590
.بالطّبع

260
00:19:21,550 --> 00:19:28,390
...مائة واثنا عشر...مائة وثلاثة عشر
...مائة وأربعة عشر

261
00:19:29,230 --> 00:19:32,090
...مائة وخمسة عشر

262
00:19:33,680 --> 00:19:36,230
ما الأمر يا روح النّوم؟

263
00:19:36,230 --> 00:19:40,060
.سيّد لايت، إنّك متعب بسبب القتال

264
00:19:40,060 --> 00:19:41,990
.عليك أن ترتاح

265
00:19:41,990 --> 00:19:45,000
.لكنّ إصاباتي شفيت سلفًا

266
00:19:45,000 --> 00:19:46,990
.لا يمكنني الجلوس بلا حراك

267
00:19:48,260 --> 00:19:54,210
.علينا تولّي أمر مهمّة الرّتبة س قريبًا أيضًا

268
00:19:54,680 --> 00:19:59,630
.إضافة لذلك، أنا أعلم أنّ لينا تعمل بجدّ الآن

269
00:20:00,140 --> 00:20:02,380
.ستكون الآنسة لينا بخير

270
00:20:02,680 --> 00:20:04,670
.إنّها قدّيسة السّيف قبل كلّ شيء

271
00:20:04,670 --> 00:20:07,560
.بإمكانها تولّي أيّ وضع بسهولة

272
00:20:07,560 --> 00:20:10,770
.معك حقّ. إنّها الأقوى

273
00:20:11,990 --> 00:20:14,270
.ستكون كذلك أيضًا

274
00:20:19,150 --> 00:20:24,090
سأفعل كلّ ما يتطلّبه الأمر لصنع
.السّيف الأقوى المثاليّ للايت

275
00:20:29,200 --> 00:20:31,390
.باستعمال مهارتي

276
00:20:34,460 --> 00:20:37,210
!والآن، طيري

277
00:20:38,780 --> 00:20:41,600
طلبتُ من كلّ الطّيور الّتي لديّ
.البحث عنهما الآن

278
00:20:41,600 --> 00:20:44,090
.إنّها تملك رؤية ليليّة أفضل منّا

279
00:20:47,670 --> 00:20:50,640
.ماذا؟ لقد عادت سلفًا

280
00:20:50,640 --> 00:20:51,600
ماذا؟

281
00:20:54,600 --> 00:20:57,520
.إنّها خائفة بشدّة

282
00:21:03,280 --> 00:21:04,490
.لقد ذبلت

283
00:21:04,490 --> 00:21:08,280
.هذا سيّئ. هذا سيّئ للغاية

284
00:21:09,120 --> 00:21:10,540
!عين العالِمة

285
00:21:12,910 --> 00:21:14,500
ما الّذي يحدث؟

286
00:21:14,500 --> 00:21:17,820
...إنّها استجابة لوضع جوّيّ معيّن

287
00:21:17,820 --> 00:21:19,690
...ركود فوريّ

288
00:21:19,690 --> 00:21:21,880
...ضروريّ للحياة

289
00:21:22,160 --> 00:21:25,380
قد يكون "المصدر" الّذي كنّا
.نبحث عنه قادمًا من هناك

290
00:21:25,690 --> 00:21:28,510
...وإن حدث ذلك، فعلينا المراهنة

291
00:21:31,010 --> 00:21:32,910
.عليهما

292
00:23:26,030 --> 00:23:29,390
،تمكّنّا أنا ودراتينا من الهرب معًا
!لكنّ الوضع خطير جدًّا

293
00:23:29,390 --> 00:23:31,050
!إنّ المدينة تعجّ بالوحوش

294
00:23:31,050 --> 00:23:32,690
!المدينة في خطر

295
00:23:32,690 --> 00:23:34,680
!لنحمِ النّاس

296
00:23:34,680 --> 00:23:35,810
!أجل

297
00:23:35,810 --> 00:23:38,780
ضع هدف أن تصبح أعظم مغامر
!على الإطلاق نصب عينيك