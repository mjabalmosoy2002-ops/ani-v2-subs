1
00:00:04,480 --> 00:00:11,870
مهمّتي هي إبادة الأنواع الأقلّ
.خطورة واستعادة هذه الأرض

2
00:00:11,870 --> 00:00:12,990
استعادة؟

3
00:00:13,600 --> 00:00:17,520
!إنّه السّبب لاستدعائي لهذه الشّياطين

4
00:00:43,420 --> 00:00:47,430
كيف يفترض بنا هزيمة هذا الشّيء؟

5
00:00:54,640 --> 00:00:55,630
،دراتينا

6
00:00:57,720 --> 00:00:59,670
.قدّمي لنا المساعدة

7
00:01:00,410 --> 00:01:02,750
.سنحمي المدينة معًا

8
00:01:08,770 --> 00:01:13,210
أنا مندهشة من قدرتك على
.قول ذلك بينما ترتجف يداك

9
00:01:15,550 --> 00:01:17,530
.سيتوقّف الارتجاف إن واصلتُ الحركة

10
00:01:19,010 --> 00:01:20,780
.آمل أن تكوني محقّة

11
00:01:36,780 --> 00:01:41,060
آمل أن نكون آمنين بالفعل
.في هذه الكاتدرائيّة

12
00:01:41,060 --> 00:01:42,810
.اهدأ رجاءً

13
00:01:42,810 --> 00:01:46,790
.كان يفترض بحجر الجنّيّات أن يحمينا

14
00:01:47,340 --> 00:01:48,500
.الأمر نفسه

15
00:01:48,500 --> 00:01:49,290
ماذا؟

16
00:01:50,090 --> 00:01:52,290
هذا نفس ما حدث في كتاب
.صور ملك الجنّيّات هذا

17
00:01:52,960 --> 00:01:58,550
في قديم الزّمان، هزمت الجنّيّات
.وأمثالها الكثير من الوحوش الشّرّيرة

18
00:01:58,550 --> 00:02:01,430
.هذه مجرّد قصّة خرافيّة

19
00:02:01,430 --> 00:02:04,560
.كن فتى مطيعًا واذهب للدّاخل

20
00:02:09,520 --> 00:02:11,480
ما الّذي سيحدث لنا؟

21
00:02:12,530 --> 00:02:16,390
.سيأتي منقذُنا

22
00:03:54,000 --> 00:03:57,080
.يوان، اقتلهم بينما الفرصة سانحة

23
00:03:57,080 --> 00:03:58,380
.مفهوم

24
00:04:10,290 --> 00:04:15,150
أيّتها الرّئيسة، إنّك تُجهدين نفسك
.باستعمال غريمو ماغيا باستمرار

25
00:04:16,700 --> 00:04:19,280
.لكنّ ذلك ممتع

26
00:04:21,440 --> 00:04:23,280
هل تعبتم سلفًا؟

27
00:04:33,500 --> 00:04:36,140
.يا له من هيجان

28
00:04:36,640 --> 00:04:39,680
.علينا إيقاف هجماته بطريقة ما

29
00:04:40,250 --> 00:04:44,000
الطّريقة الوحيدة لحماية المدينة
.هي بهزيمة التّنّين الشّرّير

30
00:04:44,000 --> 00:04:45,340
.دراتينا

31
00:04:45,340 --> 00:04:50,040
أيمكنك إيقاف التّنّين الشّرّير عن الحركة
لحوالي عشر— بل، خمس ثوان؟

32
00:04:51,350 --> 00:04:53,640
لا تخطّطين للاندفاع نحوه، أليس كذلك؟

33
00:04:53,930 --> 00:04:58,400
،نعم. إن استطعتُ الاقتراب منه
.فسأتمكّن من القيام بشيء ما بسيفي

34
00:05:00,210 --> 00:05:02,900
.ثمّة خيط رفيع بين الغباء والشّجاعة

35
00:05:03,430 --> 00:05:08,280
،أيّتها الوحوش المهزومة
!سأسمح لك بالقتال مرّة أخرى

36
00:05:14,620 --> 00:05:18,140
!اندماج الرّاحلين، الكراكن

37
00:05:20,330 --> 00:05:23,800
لمعلوماتك فحسب، سيدوم
.هذا لبضعة ثوانٍ فقط

38
00:05:30,660 --> 00:05:31,810
!ماذا؟

39
00:05:35,970 --> 00:05:37,810
.جهّزتُ الخشبة من أجلك

40
00:05:42,870 --> 00:05:45,190
.لا توجد حراشف تحمي عنقه

41
00:05:45,550 --> 00:05:47,260
!ترابيزيستا

42
00:05:51,050 --> 00:05:52,450
.نالت منه

43
00:05:52,770 --> 00:05:54,200
.أحسنت

44
00:05:57,330 --> 00:05:58,710
ما رأيك بذلك؟

45
00:06:07,650 --> 00:06:10,180
تعفّنت المجسّات؟

46
00:06:10,180 --> 00:06:11,820
.إنّه تأثيرُ انحلال

47
00:06:11,820 --> 00:06:15,220
كوني حذرة. سيحدث لك نفس
.الشّيء إن لمسته

48
00:06:28,150 --> 00:06:32,160
لا يمكن لهذا التّنّين أن يُهزم
!بسيف ضعيف كهذا

49
00:06:32,160 --> 00:06:35,910
ماذا؟ لكن كان يجب أن يكون
.الهجوم على عنقه مميتًا

50
00:06:45,670 --> 00:06:49,770
ما رأيكم في شكل هذا التّنّين المثير للدّهشة؟

51
00:06:49,770 --> 00:06:52,680
!ارتعدوا خوفًا أيّها الدّنيئون

52
00:06:52,680 --> 00:06:59,560
سأُنهي هذا العرض بتدمير هذه
!المدينة السّخيفة الّتي تسمّونها أثينا

53
00:07:06,490 --> 00:07:09,590
.ذلك النّور الأبيض... إنّها مهارة

54
00:07:09,590 --> 00:07:12,070
استعمل مهارة لإعادة إحياء التّنّين الشّرّير؟

55
00:07:12,380 --> 00:07:13,570
...لا

56
00:07:15,920 --> 00:07:18,730
إنّ نوع المهارة الّتي يتماشى مع
...هذا الوضع هو

57
00:07:19,580 --> 00:07:22,070
.على الأرجح مهارة من نوع الاستحواذ

58
00:07:22,070 --> 00:07:23,830
!لينا، دراتينا

59
00:07:23,830 --> 00:07:28,090
!اندمج التّنّين الشّرّير مع ذلك المدعوّ أرغوس

60
00:07:28,090 --> 00:07:31,590
!لن يتوقّف حتّى يُهزم

61
00:07:31,920 --> 00:07:34,210
أكيد، لكن كيف يفترض بنا فعل ذلك؟

62
00:07:34,210 --> 00:07:36,350
.لا يمكننا استعمال نفس الطّريقة السّابقة

63
00:07:36,650 --> 00:07:38,740
.جدي طريقة لجذب انتباهه

64
00:07:38,740 --> 00:07:40,600
.سأحرص على قطعه بينما هو مشتّت

65
00:07:41,010 --> 00:07:45,610
.أجد طريقة؟ حسنًا، أظنّه خيارنا الوحيد

66
00:07:45,960 --> 00:07:49,360
،لكن في تلك الحالة
فإنّ عكسَ حجر الجنّيّات

67
00:07:49,360 --> 00:07:53,360
واستدعاء الوحوش والتّنّين الشّرّير
.ليست بسبب مهارات معيّنة

68
00:07:55,550 --> 00:07:59,370
.يجب القضاء على الأذكياء أمثالك أوّلاً

69
00:07:59,370 --> 00:08:02,060
.حان وقت رحيلك

70
00:08:02,060 --> 00:08:03,250
!نفَس الضّباب

71
00:08:05,420 --> 00:08:07,000
!كتاب اللّهب

72
00:08:07,750 --> 00:08:09,130
!الفصل الثّاني

73
00:08:11,010 --> 00:08:11,760
!نار الشّيطان

74
00:08:11,010 --> 00:08:11,760
نار الشّيطان

75
00:08:14,260 --> 00:08:16,170
.هذا ليس سيّئًا أيّها التّنّين الشّرّير

76
00:08:16,170 --> 00:08:19,770
.لكان أيّ أحد آخر مكاني ليُمزّق لأشلاء

77
00:08:19,770 --> 00:08:22,270
.يا لها من قوّة مذهلة

78
00:08:28,080 --> 00:08:30,530
.لكنّه ما زال يفوقها قوّة

79
00:08:38,030 --> 00:08:39,790
!أيّتها الآنسة قبّعة الزّهور

80
00:08:47,240 --> 00:08:49,760
.استطعنا تحويل مساره

81
00:08:49,760 --> 00:08:53,710
.لكنّنا ابتعدنا عن مركز القتال

82
00:08:54,870 --> 00:08:58,880
.علينا أن نثق بهما لهزيمته

83
00:09:02,110 --> 00:09:05,600
!تُركتما في الخلف! ما الّذي بوسعكما فعله؟

84
00:09:05,600 --> 00:09:07,350
!نفَس النّدم

85
00:09:08,840 --> 00:09:10,910
!كولد أون فاس

86
00:09:19,830 --> 00:09:22,290
!ستتعفّنون مع المدينة

87
00:09:22,290 --> 00:09:24,290
!نفَس العفن

88
00:09:24,290 --> 00:09:25,700
.لن أسمح له

89
00:09:28,210 --> 00:09:29,660
!بوكليي

90
00:09:34,130 --> 00:09:36,970
إنّها تستعمل سحر قدّيسة
.السّيف المقاوم للتّصدّي له

91
00:09:48,500 --> 00:09:51,960
.جيّد. لم يصب المدينة

92
00:09:54,580 --> 00:09:58,490
.من الممتع جدًّا مشاهدة الضّعفاء يعانون

93
00:09:58,890 --> 00:10:00,800
ما الّذي يفترض بنا فعله؟

94
00:10:04,880 --> 00:10:08,870
.وقتها، لم أستطع حتّى إصابته بهجوم واحد

95
00:10:10,380 --> 00:10:12,000
.لكنّ الأمور مختلفة الآن

96
00:10:14,170 --> 00:10:15,800
...إنّ سيفي

97
00:10:18,030 --> 00:10:19,050
.سيصل إليه

98
00:10:21,550 --> 00:10:27,060
،أرى أنّك هادئ تمامًا
!لا تقلّل من شأن قدّيسة سيف

99
00:10:29,060 --> 00:10:32,190
كلمات كبيرة بالنّسبة لفتاةٍ
.البؤس بادٍ عليها بشدّة

100
00:10:34,350 --> 00:10:36,610
!نفَس الكارثة

101
00:10:56,650 --> 00:10:59,130
ما هذا النّور؟

102
00:11:02,140 --> 00:11:04,590
.ثمّة ما يدخل إلى ذهني

103
00:11:04,590 --> 00:11:08,340
.أقسم أن أحمي هذه الأرض للأبد

104
00:11:09,550 --> 00:11:11,900
أهذه ذكرى أحد ما؟

105
00:11:43,930 --> 00:11:46,680
ما ذلك النّور؟

106
00:11:54,440 --> 00:11:56,310
!ماذا يحدث؟

107
00:11:56,630 --> 00:11:58,890
.عجبًا، يا لها من مفاجأة

108
00:11:59,910 --> 00:12:03,070
...هل تطوّرت مهارة قدّيس السّيف؟ لا

109
00:12:03,440 --> 00:12:05,070
...ذلك المظهر

110
00:12:05,360 --> 00:12:06,320
هل يُعقل؟

111
00:12:16,640 --> 00:12:19,180
بركة الجنّيّات؟

112
00:12:42,430 --> 00:12:45,490
لماذا هاذين النّجمين؟

113
00:12:46,260 --> 00:12:47,750
ماذا حدث؟

114
00:12:57,260 --> 00:12:59,630
،عندما تحلّ كارثة على الأرض

115
00:13:00,080 --> 00:13:02,380
يمنح الملك لفرسانه المحبوبين

116
00:13:02,630 --> 00:13:07,760
.أجنحة فضّة خضراء وسيوف تطهير

117
00:13:08,080 --> 00:13:12,770
هذا تمامًا مثل أسطورة أثينا
.عن ملك الجنّيّات

118
00:13:12,770 --> 00:13:14,410
.مذهل

119
00:13:16,890 --> 00:13:18,210
لكن كيف؟

120
00:13:27,940 --> 00:13:29,410
.فتاة حمقاء

121
00:13:30,020 --> 00:13:33,660
ما فائدة السّيف والأجنحة الجديدين؟

122
00:13:33,660 --> 00:13:36,270
.التّنّين الشّرّير هو أعظم الشّياطين

123
00:13:36,270 --> 00:13:41,290
!سيُدمَّر الأنواع الأدنى مثلك بالكامل

124
00:13:43,670 --> 00:13:45,050
!إكليريس

125
00:13:49,930 --> 00:13:51,810
هل لديك وقت لتضيّعه في الكلام؟

126
00:13:52,160 --> 00:13:53,180
!ماذا؟

127
00:13:54,190 --> 00:13:56,090
.لقد تغلّبت على التّنّين الشّرّير

128
00:13:56,090 --> 00:13:57,780
.بإمكانها هزيمته

129
00:13:57,780 --> 00:14:00,680
تلك القدرة على الطّيران
...وسرعة تقنيّاتها

130
00:14:00,680 --> 00:14:03,190
.لقد تجاوزت قدرات مهارة قدّيس السّيف

131
00:14:03,660 --> 00:14:05,530
ما مصدر تلك القوّة؟

132
00:14:08,570 --> 00:14:10,820
!أحتاج لإلقاء نظرة أعمق

133
00:14:10,820 --> 00:14:11,700
!ماذا؟

134
00:14:11,700 --> 00:14:14,710
.يوان، حان الوقت لاستعمال سِواطك

135
00:14:14,710 --> 00:14:18,400
.لكنّك متعبة. من الخطر عليك الاقتراب

136
00:14:18,400 --> 00:14:21,500
!أنعشتني رغبتي في المعرفة بالكامل

137
00:14:21,500 --> 00:14:22,960
.ذلك سخيف

138
00:14:28,080 --> 00:14:30,720
.يبدو الطّيران شعورًا غريبًا

139
00:14:31,240 --> 00:14:32,840
...لكنّ هذه القوّة

140
00:14:34,560 --> 00:14:36,220
.أعرف كيف أستعملها

141
00:14:37,070 --> 00:14:40,980
وكأنّ هنالك شخصًا ما
.في رأسي يعلّمني كيف

142
00:14:40,980 --> 00:14:44,540
!كفّي عن التنّقل في الأرجاء

143
00:14:46,980 --> 00:14:47,600
ماذا؟

144
00:14:48,320 --> 00:14:52,280
.هذا السّيف كبير جدًّا، لكنّه خفيف

145
00:14:54,870 --> 00:14:57,910
.مذهل. تتلاعب بالتّنّين الشّرّير كالخاتم في إصبعها

146
00:14:58,150 --> 00:15:01,440
.مذهل، مذهل. لقد ضربته بسطح سيفها

147
00:15:01,440 --> 00:15:04,010
.يوان، أتمنّى أن تكون قد شاهدت ذلك

148
00:15:04,010 --> 00:15:06,550
.أنا مشغول بصنع شيء لنقف عليه

149
00:15:08,560 --> 00:15:13,300
،ماذا؟ بالتّفكير في الأمر
أين هو ذلك الصّغير الأبيض؟

150
00:15:16,420 --> 00:15:17,880
لماذا؟

151
00:15:17,880 --> 00:15:22,310
كان الجمع بين التّنّين الشّرّير
.واستحواذي الخطّةَ المثاليّة

152
00:15:22,680 --> 00:15:26,350
.وجدتُها. لستُ بحاجة للتّعامل معها

153
00:15:26,350 --> 00:15:27,940
...مهمّتي هي

154
00:15:28,630 --> 00:15:32,450
!دمارُ حمقى أثينا

155
00:15:32,770 --> 00:15:34,700
!نفَس الكارثة

156
00:15:35,040 --> 00:15:38,200
هذا سيّئ. هل يحاول تدمير
حاجز الكاتدرائيّة؟

157
00:15:46,050 --> 00:15:47,590
.لستُ خائفًا

158
00:15:47,920 --> 00:15:49,090
!لن يحدث ذلك

159
00:15:51,000 --> 00:15:53,340
.مذهل، لقد قطعت النّفَس

160
00:15:56,650 --> 00:15:59,150
.سأواصل إطلاقها فحسب

161
00:15:59,150 --> 00:16:00,190
.كلاّ

162
00:16:01,380 --> 00:16:03,100
.سينتهي هذا الآن

163
00:16:08,960 --> 00:16:13,200
هل سأُهزَم على يد هذه الفتاة الصّغيرة؟

164
00:16:14,490 --> 00:16:15,700
.النّقاء

165
00:16:22,780 --> 00:16:24,960
...على هذا الحال، فإنّ استحواذي

166
00:16:28,880 --> 00:16:32,220
.الوبالة الّتي تحيط بالتّنّين تتلاشى

167
00:16:33,110 --> 00:16:35,870
.الوبالة في الهواء تختفي أيضًا

168
00:16:47,840 --> 00:16:50,320
.مذهل يا قدّيسة السّيف

169
00:16:50,320 --> 00:16:52,710
.لا أصدّق أنّك هزمته بالفعل

170
00:16:53,740 --> 00:16:56,400
...تحطّم حجر الجنّيّات

171
00:16:59,430 --> 00:17:01,740
.لكنّك استطعتِ حمايته

172
00:17:13,130 --> 00:17:15,380
...هزمتني فتاة صغيرة

173
00:17:18,440 --> 00:17:21,900
سُحقًا! لماذا؟ لماذا؟ لماذا؟

174
00:17:21,900 --> 00:17:24,370
.كانت خطّتي مثاليّة

175
00:17:25,120 --> 00:17:28,270
.ستُخبرنا بكلّ شيء تعرفه

176
00:17:30,150 --> 00:17:37,740
سمعتُ أنّ هذه الفتاة كانت جزءًا من فرقة
.السّيف المقدّس وخدمتْ تلك المرأة

177
00:17:38,180 --> 00:17:45,000
هل تلك المرأة اللّعينة، القدّيسة، تعرف
أنّ مهارة قدّيس السّيف ستستيقظ؟

178
00:17:45,000 --> 00:17:48,420
.قد نكون أعوانًا، لكنّي ما زلت لا أثق بها

179
00:17:48,710 --> 00:17:51,380
أيُعقل أنّها استغلّتني؟

180
00:17:51,900 --> 00:17:55,550
،بما أنّي أعرف ذلك الآن
.فلا سبب يدفعني للبقاء هنا

181
00:17:57,440 --> 00:18:00,080
.إنّ حقد أسلافنا أبديّ

182
00:18:00,080 --> 00:18:02,700
.لا تنسوا ذلك أيّها الدّنيئون

183
00:18:07,280 --> 00:18:08,540
.لقد هرب

184
00:18:13,650 --> 00:18:16,660
.لكنّنا فزنا في كلّ الأحوال

185
00:18:16,660 --> 00:18:19,820
.اختفت أجنحتي وعاد سيفي لطبيعته أيضًا

186
00:18:34,330 --> 00:18:35,630
.فهمت

187
00:18:35,630 --> 00:18:38,580
.أرى أنّك قاتلت معي

188
00:18:41,120 --> 00:18:43,760
تكبّدت إصابات كثيرة. هل أنت بخير؟

189
00:18:43,760 --> 00:18:45,640
.نعم، بالكاد

190
00:18:45,960 --> 00:18:49,370
.كتاب المودّة، الفصل الثّالث

191
00:18:49,370 --> 00:18:50,800
.خراف الرّغوة

192
00:18:51,340 --> 00:18:53,010
ما هذه الفقاعات؟

193
00:18:57,120 --> 00:18:59,030
.شفيت كلّ إصاباتنا

194
00:18:59,030 --> 00:19:04,280
لا يمكنني السّماح بحصول فتاتين
.يافعتين على ندوب

195
00:19:04,660 --> 00:19:07,830
.كم سررت لأنّ كلاكما بخير

196
00:19:07,830 --> 00:19:09,630
لديك قدرات شفاء أيضًا؟

197
00:19:09,630 --> 00:19:11,670
.هذا هو المتوقّع من رئيسة مكتب في النّقابة

198
00:19:13,040 --> 00:19:16,830
أكانت تلك معجزة البحيرة؟ أو سرّ الجنّيّات؟

199
00:19:16,830 --> 00:19:19,740
.مهما كانت، كانت منظرًا يسرّ النّاظر

200
00:19:19,740 --> 00:19:21,050
.أنت متحمّسة كثيرًا

201
00:19:21,440 --> 00:19:24,010
!أحسنتما عملاً يا لينا ودراتينا

202
00:19:24,010 --> 00:19:27,560
.كنتُ محقّة بالمراهنة عليكما

203
00:19:27,920 --> 00:19:29,620
مع من قمتِ بذلك الرّهان؟

204
00:19:29,620 --> 00:19:30,630
.مع يوان

205
00:19:30,630 --> 00:19:32,880
.لم يجر بيننا أيّ رهان

206
00:19:32,880 --> 00:19:36,120
أتصدّقان أنّه لم يكن يدعمكما؟

207
00:19:36,120 --> 00:19:38,320
.بل كنتُ أشجّعهما

208
00:19:39,690 --> 00:19:44,000
هذا ما تقولينه، لكنّي كنتُ
.بلا حول ولا قوّة أمامهم تقريبًا

209
00:19:44,590 --> 00:19:46,450
.قامت لينا بكلّ شيء

210
00:19:46,680 --> 00:19:50,710
.لا، ما كنت لأستطيع هزيمتهم وحدي

211
00:19:58,590 --> 00:20:00,750
.شكرًا لك يا دراتينا

212
00:20:01,990 --> 00:20:03,900
.شكرًا على وقوفك إلى جانبي والقتال معي

213
00:20:17,090 --> 00:20:19,680
.وهكذا أكون قد انتهيت من مائة تمرين

214
00:20:19,680 --> 00:20:21,870
.سيّد لايت

215
00:20:24,960 --> 00:20:25,990
أيلا؟

216
00:20:27,200 --> 00:20:28,620
ماذا هنالك؟

217
00:20:29,070 --> 00:20:34,870
عرفتُ أنّك ستنتهي من التّدريب
.قريبًا، لذلك أحضرتُ بيتزا للعشاء

218
00:20:34,870 --> 00:20:39,310
.شكرًا لك. حان وقت الأكل

219
00:20:42,380 --> 00:20:45,080
—بمجرّد أكل ذلك، لنذهب للنّوم

220
00:20:45,080 --> 00:20:47,010
!جاهز للتّدريب ثانية

221
00:20:47,010 --> 00:20:49,760
ماذا؟ ستواصل التّدريب؟

222
00:20:49,760 --> 00:20:52,020
.سأقوم بمائة تمرين آخر فحسب

223
00:20:53,670 --> 00:20:55,020
...سيّد لايت

224
00:20:55,020 --> 00:20:57,330
!تشجّع! تشجّع

225
00:20:57,330 --> 00:20:58,900
.قد تتقيّأ البيتزا الّتي أكلت للتّوّ

226
00:21:05,710 --> 00:21:08,160
!هذا ليس جيّدًا كفاية

227
00:21:09,230 --> 00:21:12,040
ما الّذي يضحكك يا أبي؟

228
00:21:12,040 --> 00:21:15,020
إنّ من يقترفون الكثير من الأخطاء

229
00:21:15,020 --> 00:21:19,540
ويأخذون وقتهم لبناء شيء ما
.يُبلون بلاءً أفضل

230
00:21:20,100 --> 00:21:22,170
لماذا تقول ذلك؟

231
00:21:23,130 --> 00:21:24,170
.مونيكا

232
00:21:24,480 --> 00:21:26,470
ما الّذي ستفعلينه الآن؟

233
00:21:27,340 --> 00:21:29,180
ماذا تقصد؟

234
00:21:29,180 --> 00:21:31,780
".يُعثَر على طريقِ السّيف في النّاس"

235
00:21:31,780 --> 00:21:34,780
،لا يمكنك صناعة السّيف المثاليّ لأحد ما

236
00:21:34,780 --> 00:21:39,440
،ناهيك عن السّيف الأقوى
.إلاّ إن عرفتِ ما في قلب حامله

237
00:21:39,680 --> 00:21:42,940
.أعلم ذلك. ليس عليك إخباري

238
00:21:43,200 --> 00:21:47,510
إن كنت تعرفين أنّ هدفك
،هو صنع سيف من أجل لايت

239
00:21:47,510 --> 00:21:50,350
إذًا فليس لديك سبب للبقاء
.في هذه البلدة

240
00:23:26,750 --> 00:23:28,580
.حان دوري أخيرًا

241
00:23:28,580 --> 00:23:29,780
.آسفة يا لايت

242
00:23:29,780 --> 00:23:31,600
.كنت رائعة يا آنسة لينا

243
00:23:31,600 --> 00:23:34,560
.حسنًا. لننطلق في رحلتنا التّالية

244
00:23:34,560 --> 00:23:36,460
.الحلقة القادمة هي الأخيرة

245
00:23:36,460 --> 00:23:39,430
ضع هدف أن تصبح أعظم مغامر
!على الإطلاق نصب عينيك