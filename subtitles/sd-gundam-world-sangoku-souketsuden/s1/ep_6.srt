1
00:00:16,320 --> 00:00:18,950
!فلنفعل ذلك يا شباب

2
00:02:12,480 --> 00:02:14,860
!انطلقوا! لا تهتمّوا لأمر الضعفاء

3
00:02:17,280 --> 00:02:19,070
!لا تتوقفوا! واصلوا التقدّم

4
00:02:19,910 --> 00:02:22,160
!ابتعدوا عن طريقي

5
00:02:23,240 --> 00:02:24,510
.انظروا إليه

6
00:02:24,510 --> 00:02:26,290
.إنه متحمّس للغاية

7
00:02:26,910 --> 00:02:28,630
،لا أعرف من يكون ذلك الشخص اليافع

8
00:02:28,630 --> 00:02:31,330
.لكن يمكنني أن أرى بأنه يملك إمكانيات عالية

9
00:02:31,880 --> 00:02:34,710
،قد تكون شخصياتهما مختلفة تمامًا

10
00:02:34,710 --> 00:02:37,800
.لكنه يذكّرني بشخصٍ ما عندما كان صغيرا

11
00:02:46,850 --> 00:02:47,730
ماذا؟

12
00:02:55,310 --> 00:02:56,610
!ساو ساو-ساما

13
00:03:09,160 --> 00:03:11,170
.يجدر بك الذهاب أنت أيضًا

14
00:03:15,380 --> 00:03:16,710
!شكرا جزيلا لك

15
00:03:20,170 --> 00:03:21,340
.حسنًا إذا

16
00:03:24,550 --> 00:03:26,220
.أنا هو المسؤول حاليا، لذا فلتنصتوا لي

17
00:03:26,640 --> 00:03:27,850
.سنخرج من هذه المهمّة على قيد الحياة

18
00:03:39,740 --> 00:03:41,230
.عرفت ذلك

19
00:03:41,230 --> 00:03:43,570
.السيّد الصغير لديه رهبة المسرح

20
00:03:44,700 --> 00:03:46,120
!سون كين

21
00:03:46,330 --> 00:03:48,160
لمَ تشعر بالتوتّر؟

22
00:03:48,490 --> 00:03:49,830
أنت رجل، أليس كذلك؟

23
00:03:49,830 --> 00:03:53,780
.كلا أيها العجوز، قد يخسر حياته في هذه المعركة

24
00:03:53,780 --> 00:03:55,850
.لا تلمه على كونه متوتّرًا

25
00:03:55,850 --> 00:03:57,870
.غان نين على حقّ

26
00:03:57,870 --> 00:03:59,960
...علينا أن نريه كيفية القيام بالأمر أوّلًا

27
00:03:59,960 --> 00:04:01,760
!اِخرس

28
00:04:05,200 --> 00:04:06,800
!أيها السيّد الصغير

29
00:04:06,800 --> 00:04:09,630
ما الذي تفعله أيها العجوز؟

30
00:04:09,630 --> 00:04:11,810
.سيكون على ما يرام

31
00:04:20,110 --> 00:04:21,450
.هذا مذهل

32
00:04:21,450 --> 00:04:26,120
.قد يملك رهبة المسرح لكنه يتصرّف دائمًا عندما نحتاجه

33
00:04:26,120 --> 00:04:27,830
!تبّا لكم

34
00:04:27,830 --> 00:04:29,330
!سأدمّركم جميعا

35
00:04:29,330 --> 00:04:31,160
!أروني ما لديكم

36
00:04:33,620 --> 00:04:35,250
...قد يبدو ما سأقوله بديهيّا لكن

37
00:04:35,830 --> 00:04:38,000
.إنه يبدو كشخص مختلف تمامًا

38
00:04:38,750 --> 00:04:39,750
.هذا صحيح

39
00:04:49,050 --> 00:04:52,270
...كنت آمل ألّا تتقاطع طرقنا

40
00:04:57,060 --> 00:04:58,230
.ليو بو

41
00:04:58,940 --> 00:05:00,570
.جرحت مشاعري

42
00:05:01,110 --> 00:05:03,320
.كنت آمل في لقائك يا ساو ساو

43
00:05:04,030 --> 00:05:08,620
.لا شيء أروع من الحماس الذي أشعر به لدى مقاتلتك

44
00:05:10,870 --> 00:05:12,900
...ذلك هو ليو بو إذًا

45
00:05:12,900 --> 00:05:14,540
.تراجع أيها الفتى

46
00:05:33,220 --> 00:05:35,370
!المزيد! المزيد

47
00:05:35,370 --> 00:05:37,520
!فلتجعل هذا الأمر يستحقّ العناء

48
00:06:08,300 --> 00:06:12,880
!أخيرا نظرت إليّ يا ليو بو

49
00:06:18,020 --> 00:06:18,980
!تبّا

50
00:06:20,730 --> 00:06:22,650
من يكون ذلك الفتى؟

51
00:06:23,150 --> 00:06:25,260
من تنعته بالفتى يا هذا؟

52
00:06:25,260 --> 00:06:28,060
!أنا أدعى ليو بي غاندام وحيد القرن

53
00:06:28,060 --> 00:06:29,360
!فلتتذكّر ذلك

54
00:06:32,990 --> 00:06:35,640
.لا يهمّني إن كان يلقّب نفسه بالمطلق أو ما شابه

55
00:06:35,640 --> 00:06:38,040
!سنقضي عليه يا ساو ساو-سان

56
00:06:40,210 --> 00:06:41,330
.حسنًا إذًا

57
00:06:42,130 --> 00:06:44,630
.لا ترخي دفاعاتك يا ليو بي

58
00:06:47,130 --> 00:06:48,420
نحن متّجهتان في الطريق الصحيح، أليس كذلك؟

59
00:06:48,800 --> 00:06:54,980
أجل. على حسب معلومات شو يا-ساما، فإنّ هذا هو
.الطريق المختصر نحو غرفة العرش

60
00:06:54,980 --> 00:06:56,240
.علينا أن نسرع

61
00:06:56,240 --> 00:07:00,190
.سنستغلّ الفوضى للإطاحة بدونغ شو وإنهاء الأمر

62
00:07:05,360 --> 00:07:07,820
.لن أسمح لكما بالمرور

63
00:07:09,990 --> 00:07:10,900
...مستحيل

64
00:07:11,490 --> 00:07:12,700
دياو-تشان؟

65
00:07:13,660 --> 00:07:16,040
كنتِ على علم بقدومنا من هنا؟

66
00:07:16,910 --> 00:07:17,960
.أجل

67
00:07:17,960 --> 00:07:20,870
.لكن لست أنا من اكتشف ذلك وإنما ليو بو-ساما

68
00:07:21,250 --> 00:07:24,810
.إنه عبقريّ عندما يتعلّق الأمر بأرض المعركة

69
00:07:26,550 --> 00:07:29,380
.شو يو-ساما هو العبقريّ الأكبر

70
00:07:29,380 --> 00:07:30,880
ما هي مشكلتك على أية حال؟

71
00:07:31,220 --> 00:07:33,930
.لا يعجبني سلوكك. توقّفي عن التصرف بغرور

72
00:07:33,930 --> 00:07:35,670
شو كيو؟

73
00:07:35,670 --> 00:07:38,880
.شو يو-ساما يعرف بلقب عبقريّ النمر الأحمر

74
00:07:38,880 --> 00:07:41,560
.إنه ذكيّ ووسيم على عكس ليو بو

75
00:07:41,560 --> 00:07:43,940
!كما أنه خبير موسيقيّ أيضًا

76
00:07:43,940 --> 00:07:46,150
...لسنا هنا لهذا السبب

77
00:07:47,150 --> 00:07:50,530
.لكنّ ليو بو-ساما اكتشف خدعة شو يو-سان

78
00:07:50,530 --> 00:07:52,860
.عرف بأنكما ستأتيان من هذا الطريق

79
00:07:53,160 --> 00:07:57,030
.هذا يعني أنّ ليو بو-ساما هو العبقريّ الأكبر

80
00:07:57,030 --> 00:07:58,400
دياو تشان؟

81
00:07:58,400 --> 00:08:01,570
!ماذا؟ ليو بو هو مجرّد غوريلا غبيّ

82
00:08:01,570 --> 00:08:04,860
.أنت تشبّهين غرائز الغوريلا خاصته بالذكاء الحقيقيّ

83
00:08:04,860 --> 00:08:07,540
.أشعر بالأسى عليك لتحمّلك لنخيره طيلة هذا الوقت

84
00:08:07,540 --> 00:08:11,410
،ماذا عن شو يو-سان؟ قد يبدو شخصًا ذكيّا

85
00:08:11,410 --> 00:08:14,260
.لكنه دون فائدة على أرض المعركة

86
00:08:14,260 --> 00:08:17,760
.أشعر بالأسى عليك لتحمّلك لبرعم فاصولياء ضعيف مثله

87
00:08:27,190 --> 00:08:29,150
.هذا غريب للغاية

88
00:08:32,240 --> 00:08:33,280
!شو كيو

89
00:08:37,660 --> 00:08:38,620
ما الذي يحدث؟

90
00:08:42,330 --> 00:08:43,410
.لقد تمّ تسميمكما

91
00:08:43,750 --> 00:08:47,920
.لم تتوقّف عن التحدّث لذلك أصابها السمّ بسرعة أكبر

92
00:08:53,380 --> 00:08:54,970
.وداعًا

93
00:08:59,760 --> 00:09:01,060
.هذا يكفي

94
00:09:01,720 --> 00:09:05,270
يا إلهي، أليس هذا هو برعم الفاصولياء الذي سمعت الكثير عنه؟

95
00:09:11,230 --> 00:09:14,030
أين هو؟ أين دونغ شو؟

96
00:09:21,700 --> 00:09:23,250
...طريق سرّي

97
00:09:24,410 --> 00:09:26,620
!أبي، اُنظر

98
00:09:27,420 --> 00:09:28,670
...أإنها

99
00:09:32,800 --> 00:09:33,950
!أغبياء

100
00:09:33,950 --> 00:09:36,720
.سأدعهم يضيّعون وقتهم في البحث عنّي

101
00:09:36,720 --> 00:09:41,100
في الوقت الذي يدركون فيه أنّني قد اختفيت سأكون
!قد فجّرتهم إلى أشلاء

102
00:09:43,970 --> 00:09:47,900
...وحده ملك لاكيونغ ومجموعة من الحرّاس

103
00:09:47,900 --> 00:09:49,940
.ممّن يعرفون بشأن هذا الطريق السرّي

104
00:09:50,690 --> 00:09:52,110
من هناك؟

105
00:09:52,780 --> 00:09:57,230
.عرفت بأنّ جبانًا مثلك سيحاول الهرب من هنا

106
00:09:57,230 --> 00:09:59,070
!أظهر نفسك

107
00:10:03,830 --> 00:10:06,500
ماذا؟ من تكون يا هذا؟

108
00:10:07,120 --> 00:10:09,570
.كنا نعمل تحت إمرة لاكيونغ

109
00:10:09,570 --> 00:10:11,920
!لن نسمح لك بالهرب يا دونغ شو

110
00:10:13,670 --> 00:10:18,390
.بمعنى آخر، فقد تخلّيتما عن لاكيونغ وهربتما

111
00:10:18,390 --> 00:10:19,870
لم تقومان بهذا الآن؟

112
00:10:19,870 --> 00:10:22,320
لتغفرا عن ذنوبكما؟

113
00:10:22,320 --> 00:10:23,350
!اِخرس

114
00:10:23,350 --> 00:10:25,560
.تريدان الشعور بالأهميّة لا غير

115
00:10:25,930 --> 00:10:28,520
.فات الأوان على إنقاذ لاكيونغ

116
00:10:28,520 --> 00:10:29,560
!فلتتحرّكا الآن

117
00:10:37,650 --> 00:10:39,290
.معك حقّ

118
00:10:39,290 --> 00:10:42,570
.لا يمكنني استرجاع الأرواح التي فقدت

119
00:10:42,830 --> 00:10:46,070
،لو أنّنا كنا أقوياء حينها

120
00:10:46,070 --> 00:10:48,120
.لتمكنّا من إيقافك

121
00:10:48,870 --> 00:10:51,170
!لا يزال ضميري يؤنّبني على ذلك يوميّا

122
00:10:51,960 --> 00:10:53,130
...أخي

123
00:10:54,040 --> 00:10:55,390
...ولهذا السبب

124
00:10:55,780 --> 00:10:58,670
!علينا إيقافك الآن

125
00:11:27,240 --> 00:11:30,250
لماذا؟ لماذا لم تنفجر؟

126
00:11:35,380 --> 00:11:37,380
!تايشي، كان ذلك رائعًا

127
00:11:37,710 --> 00:11:38,920
!هذا مذهل

128
00:11:39,260 --> 00:11:42,840
.هذا لا شيء. كانت القنبلة سهلة

129
00:11:45,510 --> 00:11:47,640
!دونغ شو أيها الجبان

130
00:11:52,480 --> 00:11:55,730
أكنت تعتقد أننا سنسمح لك بالفرار؟

131
00:11:56,150 --> 00:11:59,570
!سنجعلك تدفع ثمن ما فعلته للاكيونغ

132
00:12:06,200 --> 00:12:07,490
ما المضحك؟

133
00:12:09,700 --> 00:12:13,110
.لم تنفجر القنبلة وطريق هروبي قد سدّ

134
00:12:13,110 --> 00:12:15,240
.لقد انتهى أمري

135
00:12:15,540 --> 00:12:17,670
.تمامًا

136
00:12:18,340 --> 00:12:19,630
.أيها الأغبياء

137
00:12:20,590 --> 00:12:24,430
هل اعتقدتم أنه في إمكانكم هزيمتي فقط لأنني بمفردي؟

138
00:12:35,440 --> 00:12:36,900
!إنه وحش

139
00:12:38,150 --> 00:12:43,280
لم أرغب في التحوّل لهذا الشيء مجدّدًا
!لكنكم أجبرتموني على ذلك

140
00:12:52,160 --> 00:12:53,870
أهذا أنت يا زو ليانغ؟

141
00:12:55,210 --> 00:12:56,250
معلّمي؟

142
00:13:01,840 --> 00:13:03,220
!معلّم زانغ جو

143
00:13:13,770 --> 00:13:15,640
...مـ-معلّمي

144
00:13:17,400 --> 00:13:19,610
ما الذي يحدث؟

145
00:13:20,940 --> 00:13:23,030
...يبدو أنك قد وصلت

146
00:13:24,240 --> 00:13:25,740
.زو ليانغ

147
00:14:59,460 --> 00:15:01,420
!لقد فعلناها! لقد نجحنا

148
00:15:01,710 --> 00:15:03,130
...لكن ما لم نكن نعرفه

149
00:15:03,790 --> 00:15:06,920
.عالم إس دي غاندام سانغوكو سوكيتسودن

150
00:15:06,920 --> 00:15:09,740
."في الحلقة القادمة "الوباء الأصفر

151
00:15:09,740 --> 00:15:12,240
!الآن هو الوقت المناسب للانضمام للمعركة