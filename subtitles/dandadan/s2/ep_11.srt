1
00:00:43,730 --> 00:00:45,900
...آنسة أياسي، السّماء

2
00:00:46,520 --> 00:00:48,360
!هذا يعني... مخلوقات فضائيّة؟

3
00:00:48,360 --> 00:00:49,820
بجدّية؟

4
00:00:49,820 --> 00:00:54,150
!مخلوق فضائي! إنّه كايجو فضاء

5
00:00:54,150 --> 00:00:55,910
كيف نهزم ذلك الشّيء؟

6
00:00:55,910 --> 00:00:57,620
!لا أدري

7
00:00:57,620 --> 00:00:58,490
هل من نقاط ضعف؟

8
00:00:58,490 --> 00:01:01,620
!لا أعلم

9
00:01:08,880 --> 00:01:10,420
مخلوق فضائيّ؟

10
00:01:10,420 --> 00:01:12,130
!آيرا

11
00:01:13,300 --> 00:01:14,670
هذا مُطمئن

12
00:01:15,090 --> 00:01:18,510
!اختفى الجميع فجأة

13
00:01:18,680 --> 00:01:20,680
هل فعلتُ شيئاً ثانية؟

14
00:01:20,680 --> 00:01:22,390
هذه ليست غلطتك

15
00:01:22,390 --> 00:01:25,270
يبدو أنّه من الأفضل أن نُعيد لمّ
!شملنا مع مومو أياسي

16
00:01:25,270 --> 00:01:26,980
!السّماء حالكة السّوداء

17
00:01:31,770 --> 00:01:34,070
!إنّه كايجو

18
00:01:34,070 --> 00:01:36,490
!اهربوا

19
00:01:53,590 --> 00:01:56,380
!هذا سخيف

20
00:01:58,260 --> 00:02:00,970
!المُنحرف -
!النّجدة -

21
00:02:01,140 --> 00:02:05,430
!لا أستطيع الجري للأبد

22
00:02:14,690 --> 00:02:17,780
هل يمكنك عدم فعل ذلك بينما
نرتدي الزيّ المدرسيّ؟

23
00:02:17,780 --> 00:02:19,660
!بالفعل

24
00:03:51,500 --> 00:03:56,460
الحلقة 23
انظر، إنّه كايجو

25
00:03:52,750 --> 00:03:54,830
!جيجي! احمل هذا الرّجل وغادرا

26
00:03:54,830 --> 00:03:57,630
!مهلاً! أنا القائدة

27
00:03:58,130 --> 00:04:01,220
!إينجوجي، خذ هذا الرّجل واهربا

28
00:04:01,760 --> 00:04:02,840
!عُلِم

29
00:04:03,930 --> 00:04:07,890
!سنُعيد تجميع أنفسنا في منزلي لاحقاً

30
00:04:15,310 --> 00:04:18,400
!أيّها البغيض المُقرف! خُذ هذه

31
00:04:20,070 --> 00:04:21,570
!يا لها من قوّة

32
00:04:23,280 --> 00:04:26,280
قبل أن يتضخّم، كان من النّوع السّريع الخفيّ

33
00:04:26,280 --> 00:04:28,910
بعد أن تضخّم، تحوّل إلى النّوع القويّ؟

34
00:04:31,540 --> 00:04:35,750
عندما ينمو حجمه، فإنّه لا يستخدم إلّا
هجمات عن كثب تستغلّ قوّتَه

35
00:04:40,670 --> 00:04:43,670
إذاً، ما رأيك بهذا؟

36
00:04:58,110 --> 00:04:59,150
!حذارِ

37
00:05:13,790 --> 00:05:15,540
إنّها ليست قوّة فحسب

38
00:05:15,790 --> 00:05:17,290
هذا ليس مُنصِفاً، أليس كذلك؟

39
00:05:17,460 --> 00:05:19,500
هل مثل هذه القذائف مسموحة؟

40
00:05:20,290 --> 00:05:22,000
كايجو فضاء

41
00:05:40,940 --> 00:05:44,360
اسمع! يجدر بك أن تكون أكثر تنبُّهاً
!للزّمان والمكان

42
00:05:45,860 --> 00:05:47,360
...إن لم تفعل ذلك

43
00:05:47,950 --> 00:05:49,820
!فلن تصبح مشهوراً أبداً

44
00:05:55,000 --> 00:05:56,120
!ضربة مُوفّقة يا آيرا

45
00:05:56,410 --> 00:05:59,210
!البليدة مومو أياسي، استهدفي السّاقين

46
00:05:59,290 --> 00:06:02,290
!"وعليكِ أن تُناديني بـ"القائدة

47
00:06:02,710 --> 00:06:06,880
!اصمتي فحسب! آيرا البلهاء

48
00:06:14,810 --> 00:06:16,140
ما رأيك بهذا؟

49
00:06:20,810 --> 00:06:22,270
!أيّتها الحمقاء

50
00:06:22,270 --> 00:06:24,860
!هذا لأنّكِ لم تُناديني بالقائدة

51
00:06:25,440 --> 00:06:27,650
...فلتشهدي حركات القائد

52
00:06:27,950 --> 00:06:30,240
!وراقبي عن كثب

53
00:06:47,210 --> 00:06:49,090
ما رأيكِ بهذا يا مومو أياسي؟

54
00:06:49,090 --> 00:06:50,800
!هكذا يتحرّك القائد

55
00:06:53,350 --> 00:06:54,100
!خلفكِ

56
00:07:01,230 --> 00:07:04,440
!قائد، قائد! اِخرسي فحسب

57
00:07:09,530 --> 00:07:11,200
!أفلتني

58
00:07:13,570 --> 00:07:15,660
!أنتِ لا تُلحقين ضرراً به

59
00:07:15,870 --> 00:07:18,370
!لا مُشكلة! الاهمّ، ساعديني هنا

60
00:07:18,660 --> 00:07:20,960
ماذا؟ ولِمَ أُساعدكِ؟

61
00:07:21,040 --> 00:07:24,250
أتقصدين بأنّ القائد لا يستطيع أن يُظهِر لي
بعضاً من روح التّعاون كفريق؟

62
00:07:27,590 --> 00:07:29,170
!أعتقد بأنّه يجب عليّ ذلك

63
00:08:14,590 --> 00:08:15,970
!الأمر يخرج عن السّيطرة

64
00:08:16,470 --> 00:08:18,060
مَن هو هدفه؟

65
00:08:30,780 --> 00:08:33,200
،ربّما يكون هذا الكايجو سليل ديناصور

66
00:08:33,200 --> 00:08:35,610
وتطوّرَ لينجو في الفضاء

67
00:08:35,820 --> 00:08:40,330
ربّما يُحوِّل طاقة كونيّة مجهولة إلى
طاقة كهربائيّة بذلك القرن؟

68
00:08:40,330 --> 00:08:43,210
هذا يُفسِّر التّمويه البصريّ أيضاً

69
00:08:43,210 --> 00:08:46,830
،إذا استطعنا الوصول إلى مصدر الضّوء
فقد نتمكّن من إيقافه

70
00:08:47,130 --> 00:08:50,340
في هذه الأثناء، سأستمرّ في صرف
!انتباه هذا الشّيء

71
00:08:59,100 --> 00:09:00,140
!لا بأس بها

72
00:09:01,470 --> 00:09:03,560
!والآن، لنقُم بهذا

73
00:09:06,350 --> 00:09:07,770
!حسناً

74
00:09:15,910 --> 00:09:17,910
!خُذ هذه

75
00:09:24,830 --> 00:09:26,540
عمل مُتقَن

76
00:09:31,250 --> 00:09:34,010
حان دوري لأتألّق أخيراً

77
00:09:39,140 --> 00:09:43,720
ما هذا؟ خافَ من جنديّة جميلة وقويّة وهرب

78
00:09:43,970 --> 00:09:46,600
!أيّتها الحمقاء، لم يهرب! إنّه قادم

79
00:09:46,810 --> 00:09:49,560
!عمّاذا تتكلّمين؟ إنّه ليس هنا

80
00:09:53,360 --> 00:09:54,650
!آيرا -
!آيرا-تشان -

81
00:09:59,160 --> 00:10:01,080
!آيرا-تشان، اقفزي

82
00:10:05,750 --> 00:10:07,210
!مُؤلم

83
00:10:07,410 --> 00:10:08,620
ما الّذي يجري هنا؟

84
00:10:09,580 --> 00:10:10,840
لا ترخي دفاعكِ

85
00:10:11,130 --> 00:10:15,300
إنّه هناك. لا يمكنكِ رؤيته لأنّه خفيّ

86
00:10:16,090 --> 00:10:18,840
أتقول خفيّ؟

87
00:10:23,890 --> 00:10:26,680
!لا أرى إلّا سحابة غباريّة

88
00:10:33,110 --> 00:10:34,320
!آيرا

89
00:10:39,530 --> 00:10:40,530
!آيرا-تشان

90
00:10:53,420 --> 00:10:57,300
!هيّا بنا

91
00:10:57,630 --> 00:11:01,010
اللّعنة! ما الخطب بالضّبط؟

92
00:11:01,010 --> 00:11:03,600
ما الّذي يجري هنا؟

93
00:11:03,600 --> 00:11:07,270
!مـ-من فضلك لا تدع عرقك يذرف عليّ

94
00:11:07,270 --> 00:11:10,560
كـ-كم هذا فظيع! هذا الشّابّ الوسيم
!سيّئ للغاية

95
00:11:10,560 --> 00:11:14,150
إنّه يُخفي مشاعره الحقيقيّة، لكنّه
!يستخفّ بالآخرين في واقع الأمر

96
00:11:14,150 --> 00:11:15,610
!الأمر ليس كذلك

97
00:11:15,610 --> 00:11:18,900
!اللّعنة، خُذ عرَقي ومخاطي

98
00:11:18,900 --> 00:11:21,240
!انتظر! توقّف! بجدّية

99
00:11:21,240 --> 00:11:24,450
!وإلّا أصبحتُ أسوأ من ذي قبل

100
00:11:28,330 --> 00:11:30,460
!مُؤلم! أنت سيّئ للغاية

101
00:11:30,460 --> 00:11:32,210
!هذا الشّابّ الوسيم سيّئ للغاية

102
00:11:48,680 --> 00:11:50,520
كان ذلك وشيكاً

103
00:11:50,520 --> 00:11:52,520
لا، بجدّية. لا تفعل ذلك أرجوك

104
00:12:06,530 --> 00:12:09,830
من أنت؟ أتريد أن تُقتَل؟

105
00:12:11,000 --> 00:12:12,500
تغيّر وجهك؟

106
00:12:15,380 --> 00:12:18,460
لماذا تقف أمامي؟

107
00:12:22,130 --> 00:12:26,680
هل أنت شخص مثل تاكاكورا؟

108
00:12:31,680 --> 00:12:33,690
لحظة! إلى أين أنت ذاهب؟

109
00:12:33,690 --> 00:12:35,690
عليك أن تأخذني كي نهرب، أليس كذلك؟

110
00:12:36,060 --> 00:12:38,980
هل ستتركني وحيداً؟ هل هذا مقبول؟

111
00:12:38,980 --> 00:12:43,200
ماذا ستقول الآنسة مومو أياسي
إذا فعلتَ شيئاً كهذا؟ هاه؟

112
00:12:43,200 --> 00:12:44,780
أين مومو؟

113
00:12:44,950 --> 00:12:48,370
!عمّاذا تتكلّم؟ طلبَتْ منك قبل قليل الهرب

114
00:12:48,370 --> 00:12:50,660
!قالت أن نُعيد تجميع أنفسنا في منزلها

115
00:12:50,660 --> 00:12:52,200
إعادة تجميع؟

116
00:12:53,040 --> 00:12:56,790
هل اليوم هو اليوم الّذي أستطيع
فيه مُقاتلته؟

117
00:12:57,920 --> 00:12:59,210
!رائع

118
00:13:00,000 --> 00:13:01,710
!انتظر لحظة

119
00:13:01,710 --> 00:13:04,300
!لا تتركني وترحل

120
00:13:11,020 --> 00:13:11,770
!أوكارون

121
00:13:15,560 --> 00:13:16,940
استخدام الطّاقة القصوى

122
00:13:21,190 --> 00:13:22,530
!أحسنت يا أوكارون

123
00:13:22,610 --> 00:13:23,740
!بئساً

124
00:13:23,860 --> 00:13:26,450
!استخدمتُ "الطّاقة القصوى" الثّانية خاصّتي

125
00:13:26,450 --> 00:13:28,530
ماذا؟

126
00:13:30,120 --> 00:13:32,200
!أنا أهوي

127
00:13:34,620 --> 00:13:36,960
!آنسة أياسي، شكراً جزيلاً لكِ

128
00:13:36,960 --> 00:13:39,080
!هذا ليس وقت الدّهشة

129
00:13:39,080 --> 00:13:41,550
!ماذا سنفعل؟ لا يمكنك التحوُّل بعد الآن

130
00:13:41,710 --> 00:13:43,800
!لا يسعني فعل شيء حيال الأمر

131
00:13:57,600 --> 00:13:59,610
!تراجعوا

132
00:13:59,610 --> 00:14:00,980
!آنسة أياسي

133
00:14:00,980 --> 00:14:03,400
!أسلاك الكهرباء! سنصطدم بأسلاك الكهرباء

134
00:14:03,400 --> 00:14:04,940
!اصمت

135
00:14:05,110 --> 00:14:06,610
!اهرب بمفردك إذاً

136
00:14:06,610 --> 00:14:09,740
!هذا مستحيل! الآنسة شيراتوري غائبة عن الوعي

137
00:14:09,740 --> 00:14:12,160
أيقظها. إنّها القائدة، أليس كذلك؟

138
00:14:12,160 --> 00:14:15,080
!لكن هذا فظيع جدّاً

139
00:14:18,750 --> 00:14:23,170
!بئساً! أنا الوحيد الّذي يقوم بكلّ هذا الجري

140
00:14:23,420 --> 00:14:26,380
.أنا آسف جدّاً يا آنسة أياسي
!شكراً جزيلاً لكِ

141
00:14:26,970 --> 00:14:30,180
لدينا حاجز حاليّاً، لذا سيكون
منزلنا بخير، أليس كذلك؟

142
00:14:30,180 --> 00:14:33,140
ماذا؟ آنسة شيراتوري، هل أنتِ بخير؟

143
00:14:33,350 --> 00:14:34,890
ماذا؟ إنّها لا تفلتني

144
00:14:34,890 --> 00:14:35,890
!آنسة شيراتوري

145
00:14:37,140 --> 00:14:39,310
!مهلاً! إنّها تتظاهر بذلك

146
00:14:39,520 --> 00:14:40,810
!ابتعدي، اللّعنة عليكِ

147
00:14:41,190 --> 00:14:43,520
فظيعة جدّاً! ماذا تفعلين بالضّبط؟

148
00:14:43,770 --> 00:14:45,440
منذ متى كنتِ تتظاهرين بذلك أيّتها السّافلة؟

149
00:14:45,610 --> 00:14:48,530
!أعيدي إليّ الخطوات الّتي أوصلَتْكِ إلى هنا

150
00:14:48,530 --> 00:14:49,660
!كيف يمكنني إعادتها؟

151
00:14:49,660 --> 00:14:53,370
!أصابَتْني هجمة لأنّكِ بليدة من الأساس

152
00:14:53,370 --> 00:14:55,620
!أنتم هنا

153
00:14:56,750 --> 00:14:58,500
!تـ-تحوّل إلى عين الشّرّ

154
00:14:58,500 --> 00:14:59,750
ماذا؟

155
00:15:00,960 --> 00:15:04,090
!لنُسرع ونتقاتل! سئمتُ من انتظارك

156
00:15:04,090 --> 00:15:06,510
اليوم ليس يوم القتال، لذا مرفوض

157
00:15:06,510 --> 00:15:08,970
هذا صحيح يا عين الشّرّ. ليس اليوم

158
00:15:08,970 --> 00:15:10,510
يرتدي ثياباً

159
00:15:16,100 --> 00:15:19,270
ماذا يجدر بنا أن نفعل؟ هل نطلب
من عين الشّرّ أن يُقاتل معنا؟

160
00:15:19,270 --> 00:15:20,850
لا نستطيع فعل ذلك

161
00:15:21,190 --> 00:15:23,690
الوعد هو أن يُقاتلني فقط

162
00:15:23,690 --> 00:15:29,200
،إذا أصبح من المسموح له أن يُقاتل الآخرين
فلا أحد يعلم ما الّذي سيُفكّر فيه لاحقاً

163
00:15:34,530 --> 00:15:36,790
أليست السّيّدة سيكو في المنزل؟

164
00:15:36,790 --> 00:15:39,870
إنّها في مُحافظة مُختلفة اليوم
من أجل برنامج تلفزيونيّ

165
00:15:39,870 --> 00:15:43,750
تبّاً! لا يمكننا فعل هذا إذا كنتُ
أنا وآيرا فقط، صحيح؟

166
00:15:43,830 --> 00:15:46,750
حبّذا لو نعرف نقاط ضعفه أو ما شابه

167
00:15:46,750 --> 00:15:48,880
هذا سيّئ

168
00:15:49,800 --> 00:15:51,510
آنسة أياسي، ما هذا؟

169
00:15:52,720 --> 00:15:54,510
ذلك الجزء يتوهّج

170
00:15:55,350 --> 00:15:56,810
هل يمكنني رؤيته قليلاً؟

171
00:15:56,930 --> 00:15:58,180
ما الأمر؟

172
00:16:18,870 --> 00:16:20,870
!إنّه هنا، هنا، هنا، هنا

173
00:16:20,870 --> 00:16:23,170
!الكايجو قادم إلى هنا

174
00:16:23,170 --> 00:16:24,750
!آنسة أياسي! إنّه قادم

175
00:16:24,750 --> 00:16:25,630
!تبّاً

176
00:16:25,630 --> 00:16:26,920
!أعتقد يجب علينا القيام بهذا

177
00:16:34,340 --> 00:16:37,810
!أوكارون، اهتمّ بعين الشّرّ والمُنحرف هنا أيضاً

178
00:16:37,810 --> 00:16:41,980
!بئساً! هذا حلم فظيع! إنّه ليس حقيقة

179
00:16:41,980 --> 00:16:43,190
من هذا الشّخص بالتّحديد؟

180
00:16:51,490 --> 00:16:53,740
!آنسة أياسي! لنستخدم هذه

181
00:16:54,030 --> 00:16:55,660
!النّانكوسكين

182
00:16:55,660 --> 00:16:57,950
!أصلحنا هذا المنزل بالنّانوسكين

183
00:16:58,080 --> 00:17:00,160
!لهذا كان يلمع

184
00:17:00,160 --> 00:17:02,790
...لحظة، هذا ليس وقت

185
00:17:03,080 --> 00:17:06,210
إذا استخدمنا هذا النّانوسكين، فقد نتمكّن من

186
00:17:06,670 --> 00:17:08,210
!من هزيمة كايجو الفضاء ذاك

187
00:17:24,730 --> 00:17:28,230
!بئساً، بئساً، بئساً! خُطوات الأقدام تقترب

188
00:17:28,230 --> 00:17:32,360
أوكارون، ما هي خطّتك؟ كيف سنستخدم
هذا من أجل هزيمته؟

189
00:17:33,320 --> 00:17:35,070
أنت، ماذا تفعل؟

190
00:17:35,280 --> 00:17:36,740
أريد أن أقتل

191
00:17:37,240 --> 00:17:40,580
هذا المنزل بُني من النّانوسكين بالكامل تقريباً

192
00:17:41,830 --> 00:17:43,750
...كان السّيّد لودريس قد قال بأنّ

193
00:17:44,040 --> 00:17:47,830
النّانوسكين مُكوّن من جُزيئات نانويّة
فائقة الكثافة

194
00:17:48,290 --> 00:17:54,800
تلتقط الجزيئات النّانويّة الإشارات الكهربائيّة
الخاصّة بأدمغتنا وتمنح شكلاً لما نتخيّله

195
00:17:56,800 --> 00:17:58,590
إذاً، هذا ما يعنيه ذلك؟

196
00:17:58,590 --> 00:18:00,220
!سأجرّبه مبدئيّاً

197
00:18:00,430 --> 00:18:01,760
أريد أن أقتل

198
00:18:01,760 --> 00:18:03,020
!لا تعترض طريقنا

199
00:18:03,020 --> 00:18:04,390
هل قلت جُزيئات نانويّة؟

200
00:18:06,690 --> 00:18:07,730
اسمعوا

201
00:18:07,730 --> 00:18:11,650
تخيّلوا بأنّ هذا المنزل بأكمله
،هو نانوسكين واحد

202
00:18:11,650 --> 00:18:14,280
!وسنُعيد صياغة شكل الشّيء برمّته

203
00:18:17,070 --> 00:18:18,780
مهلاً، ما هذا؟

204
00:18:18,780 --> 00:18:21,030
هل سنكون بخير؟ لن يتحطّم المنزل، صحيح؟

205
00:18:21,280 --> 00:18:23,790
!بئس الأمر! لا أستطيع تخيُّله بشكل صحيح

206
00:18:23,790 --> 00:18:25,620
ما الّذي تحاول تخيّله؟

207
00:18:25,620 --> 00:18:28,040
مُجرّد شيء ضخم

208
00:18:29,420 --> 00:18:31,040
!الجدران تنطبق على بعضها

209
00:18:31,040 --> 00:18:33,840
!آنسة شيراتوري، ابتعدي رجاء
!لا أستطيع التّركيز

210
00:18:33,840 --> 00:18:36,590
!شيراتوري! أبعدي مؤخّرتكِ من هنا

211
00:18:37,630 --> 00:18:39,680
!أوكارون! أعِد كلّ شيء حاليّاً

212
00:18:39,680 --> 00:18:41,970
!وإلّا سنُسحَق بواسطة المنزل

213
00:18:41,970 --> 00:18:43,510
!عُلِم

214
00:18:43,510 --> 00:18:47,850
،تاكاكورا، إذا كانت صورة لشيء ضخم
!فدَع الأمر لي

215
00:18:47,850 --> 00:18:48,850
من أنت بالتّحديد؟

216
00:18:49,140 --> 00:18:54,400
الجُزيئات النّانويّة هي من الخيال العلميّ، وعندما
!نتحدّث عن خيال علميّ، فيمكنكم الاعتماد عليّ

217
00:18:56,320 --> 00:18:58,860
!أنا كينتا ساكاتا

218
00:19:04,240 --> 00:19:06,500
ماذا؟ ماذأ؟ ماذا؟

219
00:19:06,660 --> 00:19:08,250
!مـ-مذهل

220
00:19:08,250 --> 00:19:09,870
نجحنا بطريقة ما؟

221
00:19:10,170 --> 00:19:11,540
أريد أن أقتل

222
00:19:11,540 --> 00:19:16,380
!والآن، هيّا! تعال يا خيالي

223
00:19:16,710 --> 00:19:18,170
!ها هو

224
00:19:26,060 --> 00:19:27,180
!آنسة شيراتوري

225
00:19:27,680 --> 00:19:28,600
...سأقتل

226
00:19:35,820 --> 00:19:38,150
!أوكارون

227
00:19:43,240 --> 00:19:44,530
دورة المياه

228
00:19:47,450 --> 00:19:48,660
!لا، لا، لا، لا

229
00:19:48,830 --> 00:19:50,460
!أيّ شيء عدا السّقوط

230
00:19:52,420 --> 00:19:54,500
لحظة، صعود؟

231
00:19:54,500 --> 00:19:57,000
!أغبياء لعينون

232
00:19:57,090 --> 00:20:00,340
!مهلاً، ما هذا؟

233
00:20:00,800 --> 00:20:04,010
!أشعر بأنّ كتِفَي سيُخلَعان

234
00:20:05,100 --> 00:20:07,930
أريد... أن أقتل

235
00:20:20,240 --> 00:20:21,450
!مُؤلم

236
00:21:06,530 --> 00:21:08,830
!لماذا؟

237
00:21:09,540 --> 00:21:11,410
حسناً، مهلاً لحظة، ما الّذي يجري؟

238
00:21:11,410 --> 00:21:12,710
هل يسمعني الجميع؟

239
00:21:12,710 --> 00:21:13,710
!أستطيع سماعكِ

240
00:21:13,710 --> 00:21:15,460
أسمعكِ

241
00:21:15,460 --> 00:21:18,960
ساكاتا، من المُذهل أن تتمكّن
من تخيُّل شيء كهذا

242
00:21:18,960 --> 00:21:20,880
!هذا ليس ما تخيّلتُه

243
00:21:21,130 --> 00:21:22,920
أنا آسفة، قد تكون هذه غلطتي

244
00:21:22,920 --> 00:21:25,800
قلتَ شيئاً كبيراً، لذا خطرتَ
"على ذهني "بوذا

245
00:21:25,800 --> 00:21:27,010
!اللّعنة

246
00:21:27,010 --> 00:21:30,810
!لكن لا مُشكلة لأنّني أركب روبوتاً حاليّاً

247
00:21:30,810 --> 00:21:33,270
!اصمت! كُفّ عن الصُّراخ

248
00:21:33,270 --> 00:21:37,610
لستُ ناضجاً بما يكفي لالتزام الصّمت
!بينما يتواجد روبوت أمامي

249
00:21:37,610 --> 00:21:39,520
أريد أن أقتل

250
00:21:40,190 --> 00:21:44,820
أعلن هاهنا عن تسمية هذا ببوديساتفا
!كينتا العظيم, نسخة زيتا

251
00:21:44,990 --> 00:21:49,490
!منحتُك اسماً. أجل، كان أنا

252
00:21:49,700 --> 00:21:52,580
...والآن هيّا بنا، يا كين العظيم

253
00:21:54,330 --> 00:21:58,380
والآن، كيف نُحرّك هذا الشّيء؟

254
00:23:37,470 --> 00:23:38,520
...هل هذه الآلة

255
00:23:38,520 --> 00:23:40,270
!لا أُبالي، أسرع وحرّكها فحسب

256
00:23:40,270 --> 00:23:41,520
!أنت مُذهل يا ساكاتا

257
00:23:41,520 --> 00:23:42,560
أريد أن أقتل

258
00:23:42,560 --> 00:23:44,110
تاكاكورا، هل أنت واقع في حُبّ أحد؟

259
00:23:44,110 --> 00:23:45,440
هل يمكنكِ طرح هذا السّؤال عليّ أيضاً؟

260
00:23:45,440 --> 00:23:46,230
من هذا الشّخص؟

261
00:23:46,230 --> 00:23:47,400
!هيّا بنا جميعاً

262
00:23:47,070 --> 00:23:50,200
الحلقة 24
!اشتباك! كايجو الفضاء ضدّ الرّوبوت العملاق

263
00:23:47,400 --> 00:23:50,490
"!اشتباك! كايجو الفضاء ضدّ الرّوبوت العملاق"

264
00:23:50,490 --> 00:23:51,780
!شاهدوها رجاء