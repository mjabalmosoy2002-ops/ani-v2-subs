1
00:00:15,410 --> 00:00:17,950
!عديم الكفاءة

2
00:00:18,120 --> 00:00:23,580
من يخلق مثل هذه الأصوات
القذرة بالأوركسترا خاصّتي؟

3
00:00:25,040 --> 00:00:28,500
لسنا نحن، لذا لنذهب إلى المنزل

4
00:00:28,500 --> 00:00:30,750
أجل

5
00:00:30,750 --> 00:00:32,340
!إنّهما هذان

6
00:00:35,760 --> 00:00:37,010
!إنّهما هذان

7
00:00:37,890 --> 00:00:40,180
!أنتما إذاً

8
00:00:42,520 --> 00:00:44,440
ماذا كانت تلك الهجمة للتو؟

9
00:00:44,440 --> 00:00:45,600
...يا لخيبة الأمل

10
00:01:13,670 --> 00:01:14,840
تاكاكورا-ساما؟

11
00:01:17,680 --> 00:01:18,930
!أيّها الأحمق

12
00:01:18,930 --> 00:01:20,680
!عليك مُراوغتها جيّداً

13
00:01:20,680 --> 00:01:22,890
!تلك النّوتات الموسيقيّة هي قنابل

14
00:01:23,350 --> 00:01:25,890
لا سيّما رموز الصّمت، لا تدعها تُصيبك

15
00:01:25,890 --> 00:01:28,230
ستدعك ترقد بسلام حرفيّاً

16
00:01:28,690 --> 00:01:30,860
...تقولين أن نُراوغها

17
00:01:31,360 --> 00:01:35,530
لكن كيف يُفترض بنا مُراوغة
وابل الجحيم هذا؟

18
00:03:07,240 --> 00:03:11,540
!السّمفونيّة السّادسة، الرّعويّة، اللّعنة

19
00:03:16,500 --> 00:03:17,710
!إنّه حقل أرزّ

20
00:03:16,840 --> 00:03:22,050
الحلقة 20
!يمكنك فعلها يا أوكارون

21
00:03:17,710 --> 00:03:19,260
...أريد العودة إلى المنزل

22
00:03:19,550 --> 00:03:22,050
!ركّز! ستنقضّ النّوتات علينا

23
00:03:22,340 --> 00:03:24,760
!هذا ليس حقل أرزّ

24
00:03:24,760 --> 00:03:27,100
!موتوا أيّها الخنازير اللّعينون

25
00:03:27,100 --> 00:03:28,810
!وابل الجحيم قادم

26
00:03:33,560 --> 00:03:36,900
مهلاً. قدمايّ تعلقان لذا
!لا أستطيع الرّكض جيّداً

27
00:03:37,190 --> 00:03:38,320
يا لها من خيبة أمل

28
00:03:39,360 --> 00:03:40,860
!عديم الكفاءة

29
00:03:41,820 --> 00:03:43,950
!فلتموتوا، اللّعنة

30
00:03:46,030 --> 00:03:48,450
يدخل القطارُ المنصّة ستّة

31
00:03:48,450 --> 00:03:50,410
!براز! براز

32
00:03:50,580 --> 00:03:54,040
!أبي. أبي. أبي

33
00:03:54,040 --> 00:03:58,300
!لا تتكلّم عن الآباء! أنا مُذهل أيضاً

34
00:03:58,300 --> 00:04:05,220
!بطيء للغاية! بحاجة لاندفاع أكبر
!عزّزوا الإيقاع

35
00:04:13,440 --> 00:04:14,940
!موتوا

36
00:04:15,310 --> 00:04:17,900
!موتوا، موتوا، موتوا

37
00:04:18,230 --> 00:04:20,990
!آيرا-تشان مُدهشة! إنّها تُراوغها كلّها

38
00:04:20,990 --> 00:04:25,660
!لا وقت للإعجاب! عليك أن تُراوغ هكذا أيضاً

39
00:04:26,240 --> 00:04:27,070
مؤلم

40
00:04:27,870 --> 00:04:29,370
!صوتي غريب

41
00:04:29,580 --> 00:04:31,410
!كم هذا مُزعج

42
00:04:34,960 --> 00:04:36,170
!لا توجد ثغرة

43
00:04:40,380 --> 00:04:43,510
!موتوا! موتوا! موتوا! موتوا

44
00:04:43,760 --> 00:04:45,720
!موتوا، اللّعنة

45
00:04:49,850 --> 00:04:51,930
لـ-لا أستطيع الحركة

46
00:04:52,180 --> 00:04:53,600
!يا كتلة الغائط

47
00:04:53,600 --> 00:04:55,560
!حذّرتُك أن تنتبه من رموز الصّمت

48
00:04:59,270 --> 00:05:01,190
!موتي

49
00:05:01,690 --> 00:05:02,820
!تاكاكورا-ساما

50
00:05:10,120 --> 00:05:13,910
!تبّاً، أيّها المُخادع! انزل إلى هنا

51
00:05:20,540 --> 00:05:23,510
!أنت مُجرّد نكرة -
الآنسة شيراتوري مُذهلة -

52
00:05:23,510 --> 00:05:25,470
!فلتموتي، اللّعنة

53
00:05:25,470 --> 00:05:27,720
إلى أيّ حدٍّ أنا جبان؟

54
00:05:28,050 --> 00:05:30,180
،قاتلتُ الكثير من الخصوم الأقوياء

55
00:05:30,180 --> 00:05:32,890
لذا ظننتُ بأنّني أصبحتُ أقوى
بقليل على الأقلّ

56
00:05:33,470 --> 00:05:37,270
لكن لم أصبح كذلك إطلاقاً

57
00:05:38,690 --> 00:05:41,770
إن كان لديك الوقت للتذمُّر، فحرّك مؤخّرتك

58
00:05:41,770 --> 00:05:44,030
!حسّ الإيقاع! الإيقاع

59
00:05:48,700 --> 00:05:50,950
ما زال سيستمرّ هذا لبعض الوقت

60
00:05:50,950 --> 00:05:55,000
ولا نعلم إلى متى ستظلّ تلك العاهرة
تستطيع أن تُراوغ

61
00:05:55,410 --> 00:05:58,250
ليس عليك أن تفهم أداءهم

62
00:05:58,370 --> 00:06:02,130
لا يهمّني ما يكون. تذكّر فقط أيّ نوع
!من الموسيقى الّتي تعرفها

63
00:06:02,550 --> 00:06:06,130
!واستخدم ذلك الإيقاع لتحريك جسدك

64
00:06:06,340 --> 00:06:08,470
الكلام أسهل من الفعل

65
00:06:08,880 --> 00:06:12,720
،لا أستمع للموسيقى إطلاقاً
لذا لا أعرف أي أُغنية

66
00:06:18,810 --> 00:06:19,600
تذكّرتُ شيئاً

67
00:06:20,060 --> 00:06:22,270
استمعتُ للموسيقى مؤخّراً فحسب

68
00:06:23,610 --> 00:06:25,400
...تأثّرتُ كثيراً وقتها

69
00:06:26,530 --> 00:06:28,150
وانخرطتُ مع الإيقاع

70
00:06:31,660 --> 00:06:34,410
كفى هرولة من مكان لآخر
!أيّتها النّكرة التّافهة

71
00:06:36,700 --> 00:06:38,580
ماذا يُفترض بي أن أفعل؟

72
00:06:38,830 --> 00:06:42,920
إذا مددتُ شعري، فسيصطدم بالنّوتات
!ولن يصل إليهم

73
00:07:01,190 --> 00:07:04,480
يبدو أنّ جزءاً كبيراً من الحقل
قد حُرِثَ بالفعل

74
00:07:06,030 --> 00:07:08,570
!بفضل جريكِ في الأرجاء

75
00:07:09,400 --> 00:07:10,990
!فلتموتي

76
00:07:13,660 --> 00:07:17,660
!سخّر بعض المعنويّات في الأمر أيّها السّافل

77
00:07:19,160 --> 00:07:20,620
تاكاكورا-ساما؟

78
00:07:21,250 --> 00:07:23,460
!أيّها الصّاغر اللّعين

79
00:07:23,460 --> 00:07:26,300
!مُت، مُت، مُت، مُت

80
00:07:28,510 --> 00:07:30,760
!مُت، اللّعنة

81
00:07:38,060 --> 00:07:43,350
روح صائدة، تتجوّل في البلاد بنهم
تبحث عن قربان دماء

82
00:07:43,850 --> 00:07:48,320
روح صائدة، ليلة تلو اللّيلة
لذا اخلد إلى النّوم إن تجرأت

83
00:07:44,650 --> 00:07:48,320
!أجل! أحسنت يا كتلة الغائط

84
00:07:48,570 --> 00:07:53,410
!إيقاع الصّاغر هذا... أكرهه! وغد صغير لعين

85
00:07:49,240 --> 00:07:54,410
روح صائدة، تتوهّج ناراً تحرق
الأرض بينما تمرّ عبر السّماوات

86
00:07:54,740 --> 00:08:01,040
روح صائدة، تفقد السّيطرة
تُطاردك حتّى أبعد أصقاع الأرض

87
00:08:05,290 --> 00:08:10,670
روح صائدة

88
00:08:08,050 --> 00:08:09,510
!يا صغيري

89
00:08:10,670 --> 00:08:13,340
!حان وقت الحفلة

90
00:08:25,400 --> 00:08:27,150
!اقضي عليهم بسرعة

91
00:08:27,150 --> 00:08:31,030
!لا تأمريني يا كُرة الفراء القيئيّة التّافهة

92
00:08:31,030 --> 00:08:32,110
!اللّعنة عليكِ

93
00:08:32,110 --> 00:08:35,530
كيف تجرئين على الردّ عليّ
!أيّتها الصّغيرة التّافهة؟

94
00:08:35,530 --> 00:08:36,910
...يا لخيبة الأمل

95
00:09:22,410 --> 00:09:23,830
!لا جدوى

96
00:09:23,830 --> 00:09:26,210
وابل جحيم الصّوت الخاصّ بكم
!لن يفلح بعد الآن

97
00:09:27,500 --> 00:09:30,040
!عديم الكفاءة

98
00:09:32,550 --> 00:09:37,300
!لقد أغضبتموني

99
00:09:37,550 --> 00:09:39,680
!سأحرص على قتلكم

100
00:09:40,220 --> 00:09:42,640
!السّمفونيّة رقم 9

101
00:09:42,970 --> 00:09:44,730
!فِرقة الجوقة

102
00:11:36,340 --> 00:11:37,880
ما هم بالضّبط؟

103
00:11:37,880 --> 00:11:41,090
!إنّها أوهام! لا تلقيا بالاً لهم

104
00:11:41,260 --> 00:11:42,930
!اضربا الموسيقيّين

105
00:11:42,930 --> 00:11:45,180
أجل، لكن أين هم؟

106
00:11:54,650 --> 00:11:57,900
!أعلى خشبة المسرح خلف ذلك العملاق

107
00:11:58,610 --> 00:12:00,860
!أبعدوا أيديكم القذرة عنّي

108
00:12:01,400 --> 00:12:03,990
لا أستطيع الحركة إطلاقاً

109
00:12:04,160 --> 00:12:06,580
!إن لم تُسرِعا، فسوف تُسحَقان حتّى الموت

110
00:12:07,120 --> 00:12:09,290
!تاكاكورا-ساما، يدك

111
00:12:52,250 --> 00:12:53,410
!آيرا-تشان

112
00:12:53,660 --> 00:12:56,710
!دع هؤلاء لي! عليك بالموسيقيّين

113
00:15:16,020 --> 00:15:19,270
!بسرعة! وإلّا حوصِرت من جديد

114
00:15:19,270 --> 00:15:20,270
!أعلم

115
00:15:23,650 --> 00:15:25,480
لكن لا يمكنني استخدام "الطّاقة
القصوى" إلّا مرّتين

116
00:15:25,820 --> 00:15:27,940
!اندفاعة واحدة لكلّ شخص لن تكفي

117
00:15:30,360 --> 00:15:32,530
خمسة تنفيذات لكلّ نبضة إيقاع

118
00:15:34,070 --> 00:15:35,950
سيكون ذلك سهلاً جدّاً بالنّسبة لي

119
00:15:41,330 --> 00:15:43,500
!هذا ما تقصدينه إذاً

120
00:15:56,060 --> 00:15:59,350
!توقّف

121
00:16:41,890 --> 00:16:43,440
هل هزمناهم؟

122
00:16:45,900 --> 00:16:47,190
آنسة شيراتوري

123
00:16:47,730 --> 00:16:49,110
هل أنتِ بخير؟

124
00:16:49,940 --> 00:16:52,900
أجل، أنا بخير

125
00:16:53,320 --> 00:16:56,410
تمكّنتُ من هزيمتهم بطريقة ما بفضلكِ

126
00:16:57,700 --> 00:16:59,200
!شكراً جزيلاً لكِ

127
00:17:01,910 --> 00:17:03,080
ماذا؟

128
00:17:03,080 --> 00:17:07,590
!هذا غير صحيح! كنتَ مُبهراً جدّاً أيضاً

129
00:17:09,250 --> 00:17:12,970
...يا ذاتي الطّبيعيّة... اخرجي بسرعة

130
00:17:20,260 --> 00:17:24,810
كان كلّ ذلك يعزو لمُحاضرتي. يجدر
!بكما أن تشعرا بالامتنان

131
00:17:26,150 --> 00:17:29,940
كنتِ معنا؟ يا له من حضور رديء

132
00:17:29,940 --> 00:17:34,030
هيّا بنا إلى الخارج! رحيلكِ مُقدّر ومكتوب

133
00:17:34,490 --> 00:17:39,070
بفضل العجوز تاربو، أظنّني فهمتُ
معنى الإيقاع هذا

134
00:17:39,330 --> 00:17:40,240
شكراً لكِ

135
00:17:40,240 --> 00:17:42,620
!لا تغترّ

136
00:17:42,950 --> 00:17:47,460
!ما تفهمه الآن لا يعدو كونه صملاخاً

137
00:17:47,920 --> 00:17:51,210
قوّتي لا تُقارَن بهذا

138
00:17:53,130 --> 00:17:56,760
حسناً، ما كان أولئك على أيّ حال؟

139
00:17:57,090 --> 00:17:59,220
مُجرّد أفكار مُنِحَتْ شكلاً

140
00:17:59,470 --> 00:18:06,230
الخوف الجماعيّ من لوحات الأشخاص
في غرفة الموسيقى اتّخذ شكلاً ببساطة

141
00:18:06,310 --> 00:18:10,060
،إذا عزفت البيانو على السّاعة 2 صباحاً
فسوف يظهرون من جديد

142
00:18:10,060 --> 00:18:12,690
لكن إن قتلوك، فستموت أيضاً في
الحياة الواقعيّة

143
00:18:13,110 --> 00:18:14,900
!لن نفعلها ثانية أبداً

144
00:18:15,240 --> 00:18:18,990
الأهمّ، ما أدراكِ بالأطياف في هذه الغرفة؟

145
00:18:18,990 --> 00:18:21,330
أنتِ لا تُخطّطين لشيء، أليس كذلك؟

146
00:18:21,330 --> 00:18:24,790
...أفكّر دوماً في كيفيّة

147
00:18:25,960 --> 00:18:26,710
...قتلكم...

148
00:18:28,290 --> 00:18:29,420
جميعاً

149
00:18:36,800 --> 00:18:39,470
!لنستدعِ فرقة هاياشي من جديد

150
00:18:39,680 --> 00:18:43,060
من المُؤكّد أنّ عين الشّرّ يفعل
شيئاً للردّ علينا

151
00:18:43,510 --> 00:18:45,430
لا نستطيع الصّمود فترة أطول

152
00:18:45,850 --> 00:18:47,140
...لا أريد التّفكير في الأمر

153
00:18:48,100 --> 00:18:49,770
لكن سيموت شخصٌ ما

154
00:18:54,860 --> 00:18:59,200
سيّد جيجي، أنت لا تُريد أن تقتل
السّيّدة سيكو أو الآنسة مومو، صحيح؟

155
00:18:59,450 --> 00:19:03,370
على هذا المنوال، لن تتمكّن من العيش
مع والديك أيضاً

156
00:19:05,330 --> 00:19:08,120
سوف نُؤدّي طرد الأرواح غداً

157
00:19:10,580 --> 00:19:13,920
طلبتُ بالفعل من هاياشي العودة

158
00:19:14,130 --> 00:19:17,260
!انتظر لحظة! لا تتصرّف من تلقاء نفسك

159
00:19:17,510 --> 00:19:20,130
سوف أتلو صلوات الطّقوس

160
00:19:23,470 --> 00:19:25,470
!جدّتي، قولي شيئاً

161
00:19:25,600 --> 00:19:27,680
!قلتِ بأنّكِ ستجعلينه فرداً من العائلة

162
00:19:27,680 --> 00:19:30,640
!كان جيجي يُصقل قوّته الرّوحيّة أيضاً

163
00:19:30,940 --> 00:19:33,310
رُدّي، أليس كذلك يا جدّتي؟

164
00:19:35,900 --> 00:19:39,320
!جين إينجوجي! اخرج إلى هنا

165
00:19:39,820 --> 00:19:41,660
ماذا؟ أوكارون؟

166
00:20:01,130 --> 00:20:03,010
أوكارون، ما الّذي يجري؟

167
00:20:03,260 --> 00:20:07,100
الأهمّ، ما الّذي كنتُما تفعلانه في هذا
المتأخّر من اللّيل؟

168
00:20:07,560 --> 00:20:09,520
آنسة شيراتوري، الماء لو سمحتِ

169
00:20:09,520 --> 00:20:10,350
!حسناً

170
00:20:11,980 --> 00:20:14,480
مهلاً، ماذا تنويان أن تفعلا؟

171
00:20:14,860 --> 00:20:17,150
!أرجو ألّا يتدخّل أحد في هذا

172
00:20:17,150 --> 00:20:20,820
!سأرسل عين الشّرّ الآن إلى الحياة الأُخرى

173
00:20:21,400 --> 00:20:25,160
.بربّك يا أوكارون، سأغضب حقّاً
هذه ليست لعبة، مفهوم؟

174
00:20:26,950 --> 00:20:31,790
استشطتُ غضباً عندما هاجمكِ عين الشّرّ

175
00:20:33,210 --> 00:20:35,130
!كنتُ غاضباً للغاية

176
00:20:36,250 --> 00:20:38,750
لفترة من الزّمن، ظننتُ بأنّنا سنتمكّن
من تجاوز هذا بطريقة ما

177
00:20:38,920 --> 00:20:41,090
!لكن عين الشّرّ خطير حقّاً

178
00:20:41,380 --> 00:20:45,050
إنّه همجيّ وماكر وليس شخصاً
يمكننا تجاهله

179
00:20:45,340 --> 00:20:49,520
لكن يا آنسة أياسي، تحاولون أنتم
تقبُّل عين الشّرّ

180
00:20:49,850 --> 00:20:52,020
هذا أمرٌ عبثيّ حقّاً

181
00:20:52,850 --> 00:20:54,600
...وهو بلا شكّ

182
00:20:55,730 --> 00:20:57,610
!صعب المراس

183
00:20:58,770 --> 00:21:02,990
لذا أنا غاضب من ضعفي

184
00:21:03,110 --> 00:21:08,080
انتظر فحسب يا جيجي. إرادتك
...لحماية عين الشّرّ

185
00:21:08,990 --> 00:21:10,740
!سأحرص على حمايته

186
00:21:12,450 --> 00:21:14,920
سيّد تاكاكورا، اهدأ من فضلك

187
00:21:14,920 --> 00:21:17,880
!قرّرنا بالفعل أن يتمّ تطهير السّيّد جيجي

188
00:21:18,210 --> 00:21:20,590
!لا حاجة لمُقاتلة عين الشّرّ

189
00:21:20,590 --> 00:21:21,760
!مانجيرو

190
00:21:24,010 --> 00:21:26,180
كلماته تحمل في طيّاتها ناراً

191
00:21:27,050 --> 00:21:28,720
لا تُحرجه

192
00:21:30,640 --> 00:21:31,850
!تاكاكورا

193
00:21:33,060 --> 00:21:34,270
!ها نحن أولاء

194
00:21:34,850 --> 00:21:36,480
مومو-تشان، تنحّي جانباً

195
00:21:43,990 --> 00:21:46,240
!أوكارون، أأتمنك على عين الشّرّ

196
00:21:46,910 --> 00:21:48,070
حسناً

197
00:23:37,890 --> 00:23:39,480
!لا تستهينوا بي

198
00:23:39,480 --> 00:23:41,850
يمكنني قتلكم في أيّ لحظة زمنيّة

199
00:23:41,850 --> 00:23:43,860
وأسحقكم وأجعلكم أشلاء كهذا المنزل

200
00:23:43,860 --> 00:23:47,280
أنتِ جائعة، صحيح؟ كُلي هذا
ريثما يجهز العشاء

201
00:23:47,280 --> 00:23:48,240
!يا سلام

202
00:23:48,240 --> 00:23:50,030
الحلقة 21
أريد إعادة إعمار المنزل

203
00:23:48,240 --> 00:23:51,740
"الحلقة القادمة، "أريد إعادة إعمار المنزل
ستُقدّمون المُساعدة أيضاً