1
00:00:07,060 --> 00:00:13,810
هنالك نوعٌ جديدٌ من الأمراض
ينتشر بين الشباب

2
00:00:14,370 --> 00:00:17,290
،بعدَ الفترات المطوّلة من استخدام الإنترنت

3
00:00:17,660 --> 00:00:21,440
يصبح للمصابين به اتّكالٌ باثولوجيّ على الإنترنت

4
00:00:21,440 --> 00:00:27,880
"وقد وصف الخبراء هذا المرض بـ"إدمان الإنترنت

5
00:00:28,960 --> 00:00:34,890
ومن أجل إعادة هؤلاء الشباب المدمنين
إلى الطّريق الصّحيح

6
00:00:34,890 --> 00:00:39,130
وإعادة تأهليهم إلى أشخاصٍ راشدين
ومُستقلّين ومُحترمين لذاتهم

7
00:00:39,730 --> 00:00:45,900
تمّ إنشاء منشأة تعليميّة مدنيّة
تُدعى بأكاديمية إعادة تعليم النخبة

8
00:00:46,940 --> 00:00:53,740
مكانٌ يساعد الشباب ليكبروا بطريقةٍ صحيحة

9
00:03:16,880 --> 00:03:18,390
اتركه

10
00:03:25,560 --> 00:03:27,880
...بأن تضع يدك عليّ

11
00:03:27,880 --> 00:03:29,100
هل تريد أن تموت؟

12
00:03:29,600 --> 00:03:32,300
هذا حارسي الشخصيّ

13
00:03:32,300 --> 00:03:34,600
أملكُ إذنًا من المديرة أيضًا

14
00:03:35,100 --> 00:03:36,550
...دعني أحدّرك

15
00:03:36,550 --> 00:03:39,980
لستَ أنت من يُقرّر متى أموت

16
00:03:41,160 --> 00:03:42,280
...أيها الـ

17
00:03:42,280 --> 00:03:43,630
مدرّس ريو

18
00:03:43,630 --> 00:03:45,900
أريد أن أتفادى المشاكل أيضًا

19
00:03:45,900 --> 00:03:47,960
إنّما أريد أن أعيش بحريّة

20
00:03:48,610 --> 00:03:51,300
—لا أملك هاتف جون

21
00:03:51,300 --> 00:03:52,130
!اخرس

22
00:03:52,130 --> 00:03:53,450
!أخرجه حالًا

23
00:03:53,450 --> 00:03:55,180
اهدأ

24
00:03:55,180 --> 00:03:58,970
كلبي العاصي قد هرب به في فمه

25
00:04:00,000 --> 00:04:02,130
،إن كانت معلومات شين صحيحة

26
00:04:02,130 --> 00:04:03,970
...يُجدر بهذا أن يكون المكان

27
00:04:04,810 --> 00:04:06,490
لكن لا أحد هنا

28
00:04:06,680 --> 00:04:08,650
هل أتيت إلى المكان الخاطئ؟

29
00:04:09,190 --> 00:04:12,480
يجب أن تكون شجاعًا لتتسكّع هنا لوحدك

30
00:04:12,700 --> 00:04:15,610
رأيناك تركض في الجوار ليلة البارحة

31
00:04:15,610 --> 00:04:20,980
أتساءل كم سيركض جيدًا بعد أن نكسر ساقيه

32
00:04:21,720 --> 00:04:23,370
،فور أن نتخلّص من هيبيكي

33
00:04:23,370 --> 00:04:26,390
نستطيع أن نجهز على قمامة الفصل أربعة أيضًا

34
00:04:26,390 --> 00:04:28,010
،فور أن يخرج وودو

35
00:04:28,010 --> 00:04:31,960
"بـ"أخي الكبير أنا سأجعله يناديني

36
00:04:33,520 --> 00:04:35,900
يجب أن تتوقّفوا عن هذا على الأرجح

37
00:04:35,900 --> 00:04:37,210
تنحّوا عن طريقي

38
00:04:37,210 --> 00:04:39,970
وإلّا لن أظهر لكم أيّة رحمة

39
00:04:42,220 --> 00:04:44,520
أنت غبيّ بالفعل

40
00:04:44,520 --> 00:04:46,520
ألا تدرك الوضع الذي أنت فيه؟

41
00:04:46,520 --> 00:04:47,960
هذا ليس الوقت المناسب لتتصرّف كشخصٍ صلب

42
00:04:52,070 --> 00:04:54,680
هل تصرّون على معارضتي إذًا؟

43
00:04:54,680 --> 00:04:55,980
لن تفلتوا بسهولة

44
00:04:56,320 --> 00:04:57,480
!ماذا؟

45
00:04:59,290 --> 00:05:01,990
تذكّروا الوقت الرّاهن

46
00:05:13,590 --> 00:05:15,710
ما الذي تفعله؟

47
00:05:17,370 --> 00:05:19,190
تريدون ضربي، صحيح؟

48
00:05:19,190 --> 00:05:20,560
لذا أضربُ نفسي

49
00:05:20,930 --> 00:05:23,520
!لقد جنّ هذا الفتى

50
00:05:23,520 --> 00:05:25,800
أتظنّون أنّه جُنّ من الخوف؟

51
00:05:25,800 --> 00:05:27,520
...لم أرَ شخصًا يبرح نفسه ضربًا من قبل

52
00:05:27,520 --> 00:05:28,450
!تابع

53
00:05:28,450 --> 00:05:30,490
!أكمل، اضرب نفسك حتّى الموت

54
00:05:30,970 --> 00:05:32,460
من الأفضل أن نبدأ

55
00:05:32,460 --> 00:05:33,500
سنبدأ بقاعة الطعام

56
00:05:33,500 --> 00:05:35,760
أجل، فلننتهِ منها ثمّ نأخذ قيلولة

57
00:05:35,760 --> 00:05:37,340
الاعتناء بهؤلاء الأشقياء طوال اليوم متعب

58
00:05:37,340 --> 00:05:38,740
!حدّث ولا حرج

59
00:05:49,200 --> 00:05:50,950
ما تلك؟

60
00:05:51,810 --> 00:05:53,910
،إن انضممتِ لنا

61
00:05:53,910 --> 00:05:56,750
تستطيعين أن تملكي الهاتف
وتستعملي الإنترنت كيفما تشائين

62
00:05:56,750 --> 00:05:59,850
!حينها تستطيعين أن تتحدّثي إلى أخيك الصغير أيضًا

63
00:05:59,850 --> 00:06:02,800
كيف تعلمين بشأن أخي الصغير؟

64
00:06:02,800 --> 00:06:05,460
أستطيع اكتشاف مثل تلك الأمور بسهولة

65
00:06:05,460 --> 00:06:09,000
لقد قرصنتُ قاعدة بيانات المدرسة ونظرتُ إلى بياناتك

66
00:06:09,000 --> 00:06:12,330
كما أنّني تفقّدتُ سجلّ عائلتك
باستخدام بيانات الشرطة

67
00:06:13,480 --> 00:06:15,120
أبواك متوفيان

68
00:06:15,120 --> 00:06:17,020
وأخوك الصغير لا يذهب إلى المدرسة

69
00:06:17,020 --> 00:06:20,490
!لذا بدا لي أنّه في المستشفى على الأغلب

70
00:06:20,490 --> 00:06:22,720
ثمّ وجدتُ أنّ أخاك البالغ من العمر 11 سنة

71
00:06:22,720 --> 00:06:27,440
محجوزٌ في مستشفى مركزية أولى
في جناح العناية التاجية، الغرفة 13، الطابق الثامن

72
00:06:27,440 --> 00:06:28,980
!لذا أظنّني كنتُ محقّة

73
00:06:30,100 --> 00:06:31,300
فهمت

74
00:06:31,300 --> 00:06:34,780
تستطيعين الاتّصال بالإنترنت وكذا القرصنة

75
00:06:34,780 --> 00:06:37,460
إن أردتني أن أنضمّ إليك فأعطيني هاتفًا

76
00:06:38,530 --> 00:06:40,320
!لا داعي للعجلة

77
00:06:40,320 --> 00:06:41,960
هذا الوحيد الذي أملك الآن

78
00:06:42,190 --> 00:06:44,610
إنّه جهازٌ عدّلتُه شخصيًّا

79
00:06:47,340 --> 00:06:48,460
لا عليك

80
00:06:48,710 --> 00:06:51,120
،إلّم تعطيني هاتفًا
اعتبري هذا النقاش منتهٍ

81
00:06:51,120 --> 00:06:53,480
انتظري! أنت شحيحة جدًّا، تبًّا

82
00:06:53,480 --> 00:06:54,490
،باستخدام هذا

83
00:06:54,490 --> 00:06:57,460
يمكنني إيجاد معلوماتٍ عن أماكن تواجد
الهواتف المتّصلة بالإنترنت

84
00:06:57,660 --> 00:06:59,210
،يوميًّا ما بين الظهيرة واللّيل

85
00:06:59,210 --> 00:07:02,410
تجتمع الكثير من الهواتف في مكانٍ واحد

86
00:07:03,480 --> 00:07:05,490
أتعرفين أين توجد الهواتف؟

87
00:07:05,490 --> 00:07:06,690
!أجل

88
00:07:06,690 --> 00:07:08,240
،إن لاحقنا شخصًا واحدًا

89
00:07:08,240 --> 00:07:11,950
!يمكننا العمل معًا لأخذ هاتفه

90
00:07:16,300 --> 00:07:18,260
هل انتهيت؟

91
00:07:18,260 --> 00:07:19,980
لقد كان عرضًا مسليًا بالفعل

92
00:07:19,980 --> 00:07:20,960
يجب أن تواصل

93
00:07:26,460 --> 00:07:27,970
ماذا؟

94
00:07:35,000 --> 00:07:36,290
مـ-ما الذي يفعله؟

95
00:07:36,290 --> 00:07:36,970
لا أدري

96
00:07:43,640 --> 00:07:45,500
!اضربوني كما شئتم

97
00:07:45,500 --> 00:07:47,260
!لن أضعف حتّى لو قتلتموني

98
00:07:47,260 --> 00:07:50,480
!لن أنتهك القوانين بتهريب الهواتف

99
00:07:50,480 --> 00:07:52,600
!أنتم من ضربتموني أوّلًا

100
00:07:52,600 --> 00:07:55,950
!لن أضعف مهما ضربتموني

101
00:07:56,410 --> 00:07:58,850
...حتّى إن قتلتموني ضربًا

102
00:07:58,850 --> 00:08:01,960
!لن أخون كبير المدرّسين شيان أبدًا

103
00:08:02,960 --> 00:08:04,660
!لقد نصب لنا فخًّا

104
00:08:04,650 --> 00:08:05,880
!كبير المدرّسين شيان

105
00:08:04,660 --> 00:08:05,890
!فلنذهب

106
00:08:09,450 --> 00:08:11,610
...كبير المدرّسين شيان! أنا

107
00:08:12,290 --> 00:08:14,310
ما الذي تفعلونه هنا؟

108
00:08:15,100 --> 00:08:16,470
...نـ-نحن

109
00:08:16,470 --> 00:08:18,000
!كبير المدرّسين شيان

110
00:08:18,000 --> 00:08:20,500
!لم أستسلم

111
00:08:20,500 --> 00:08:22,480
!أيها المدرس، ا-الأمر ليس كما يبدو

112
00:08:22,480 --> 00:08:24,500
!إنه يكذب

113
00:08:24,500 --> 00:08:27,540
!لـ-لم نضربه

114
00:08:30,810 --> 00:08:33,020
...تسبّب المشاكل كلّ يوم

115
00:08:33,020 --> 00:08:34,940
أتريد أن تُضرب بشدّة؟

116
00:08:35,170 --> 00:08:37,960
خذوا زعيم العصابة كون إلى الانفرادية لثلاثة أيّام

117
00:08:38,210 --> 00:08:40,150
أمّا بقيّتكم، لن تحصلوا على أيّ وجبة اليوم

118
00:08:40,150 --> 00:08:41,900
تستطيعون التفكير بما اقترفتموه بمعدةٍ فارغة

119
00:08:42,460 --> 00:08:46,470
هل تمزح؟ ولا أيّ وجبة؟

120
00:08:46,470 --> 00:08:48,570
تبًّا، يا لها من خدعةٍ دنيئة

121
00:08:48,570 --> 00:08:50,250
لا أصدّق أنّنا وقعنا بها

122
00:08:50,250 --> 00:08:52,290
...لقد أبرح نفسه ضربًا

123
00:08:52,290 --> 00:08:53,600
لا بدّ أنّه مجنون

124
00:08:53,600 --> 00:08:54,330
ما العمل؟

125
00:08:54,330 --> 00:08:56,300
قد يلاحقنا المرّة القادمة

126
00:08:58,000 --> 00:08:59,600
لا تقلقوا

127
00:08:59,600 --> 00:09:01,980
لقد ذهب هدفي

128
00:09:01,980 --> 00:09:04,400
لا أضمر أيّ ضغينة تجاه بقيّتكم

129
00:09:08,290 --> 00:09:10,980
فقط جزءٌ صغير من النّاس مخطئون

130
00:09:11,200 --> 00:09:14,200
بقيّتكم سجناء تعانون في هذه المدرسة، صحيح؟

131
00:09:14,200 --> 00:09:16,200
يجب أن نساعد بعضنا بعضًا

132
00:09:16,200 --> 00:09:19,950
إن كنتم تريدون، سأعزمكم على العشاء الليلة

133
00:09:21,210 --> 00:09:23,000
أطباق اللحوم

134
00:09:26,450 --> 00:09:27,960
!أجل رجاءً

135
00:09:27,960 --> 00:09:29,700
!أطعمنا

136
00:09:29,700 --> 00:09:31,700
!أريد أن آكل اللحم

137
00:09:31,700 --> 00:09:32,970
!أجل، رجاءً

138
00:09:35,000 --> 00:09:36,470
إذًا؟

139
00:09:36,470 --> 00:09:39,600
أتريدين أن تري ما إن كان هنالك هاتفٌ حقًّا؟

140
00:09:39,600 --> 00:09:40,800
!الوقت من ذهب

141
00:09:40,800 --> 00:09:43,480
!فلنذهب لسرقة هاتفٍ معًا

142
00:09:48,300 --> 00:09:49,480
حسنًا

143
00:09:49,700 --> 00:09:51,540
،سأرى بأمّ عينيّ

144
00:09:51,540 --> 00:09:53,280
وسأقرّر وفقَ ذلك ما إن كنتُ سأنضم لكما

145
00:09:53,280 --> 00:09:55,690
!أجل! أنا مسرورةٌ حقًّا لأنك وافقت

146
00:09:55,690 --> 00:09:58,200
!فلنعمل سويًّا يا شيوري-تشان

147
00:10:04,220 --> 00:10:05,490
بان

148
00:10:05,490 --> 00:10:07,460
حان وقت التقدّم

149
00:10:08,000 --> 00:10:11,420
بالمناسبة، أين يجري الفصل ستّة أعمالهم؟

150
00:10:11,420 --> 00:10:12,560
الفصل ستة؟

151
00:10:12,560 --> 00:10:15,470
خلف المسكن وفي بناية الفصل اثنان

152
00:10:16,410 --> 00:10:17,750
...هذا غريب

153
00:10:17,750 --> 00:10:20,470
قال شين في قاعة الطعام

154
00:10:21,080 --> 00:10:24,210
لا يجب عليك البحث عن
أولئك الأشخاص على الأغلب

155
00:10:24,210 --> 00:10:24,900
لمَ لا؟

156
00:10:24,900 --> 00:10:27,220
من الأفضل ألّا تغضب أشخاص الفصل ستة

157
00:10:27,220 --> 00:10:27,950
!أجل

158
00:10:27,950 --> 00:10:30,900
زعيمهم، يوه قويّ حقًّا

159
00:10:30,900 --> 00:10:33,270
كما أنّ مدرّسهم اليوميّ أسوأ

160
00:10:33,270 --> 00:10:34,980
لا يجب أن تغضبهم حقًّا

161
00:10:35,490 --> 00:10:39,460
أيقصدون أنّ هنالك مدرّس أسوأ من شيان؟

162
00:10:39,460 --> 00:10:40,610
...أيضًا

163
00:10:40,610 --> 00:10:45,450
وردتنا معلومات أنّك ستكون هنا نحو الظهيرة

164
00:10:46,810 --> 00:10:50,000
لا أعلم من نشر الشائعة

165
00:10:50,460 --> 00:10:52,650
لكن من الأفضل لك أن تحذر

166
00:10:52,650 --> 00:10:56,470
يجب أن تجد كلّ تلميذٍ يملك هاتفًا وتبلغ له عنه

167
00:10:53,240 --> 00:10:56,470
لقد اشتريتُ بعض التحديثات، هذا كلّ شيء

168
00:10:56,470 --> 00:10:57,750
،إن فعلتَ ذلك فستكسب ثقته

169
00:10:56,470 --> 00:10:59,970
إذًا؟ هل تريد أن تعيش معي؟

170
00:10:57,750 --> 00:10:59,980
كما سيعترف التلاميذ الآخرون بتفوّقك

171
00:10:59,980 --> 00:11:02,440
هيبيكي-تشان، أنت غبيّ حقًّا

172
00:11:02,790 --> 00:11:04,440
...أيعقل

173
00:11:12,530 --> 00:11:13,650
شيوري؟

174
00:11:30,090 --> 00:11:31,510
...هيبيكي

175
00:11:46,700 --> 00:11:48,010
...هيبيكي

176
00:11:49,020 --> 00:11:51,000
!عجبًا، يا له من جذاب

177
00:11:51,000 --> 00:11:53,150
!نوعي المفضل تمامًا

178
00:11:52,020 --> 00:11:53,150
من أنت؟

179
00:11:53,520 --> 00:11:55,420
!توقفي! تراجعي

180
00:11:54,010 --> 00:11:55,410
!أنت رائع

181
00:11:55,410 --> 00:11:57,750
!دعني أحضنك

182
00:11:56,490 --> 00:11:57,750
ماذا تفعلين؟

183
00:11:57,750 --> 00:11:58,440
!ابتعدي عنّي

184
00:11:58,440 --> 00:12:00,860
!لا بدّ أنّ القدر شاء أن نلتقي هنا

185
00:12:00,860 --> 00:12:01,700
!عزيزي

186
00:12:01,700 --> 00:12:03,980
!أرجوك ضمّني بين ذراعيك

187
00:12:01,950 --> 00:12:03,970
هل أنت مجنونة أو هكذا شيء؟

188
00:12:03,970 --> 00:12:06,030
!فليساعدني أحدكم

189
00:12:06,030 --> 00:12:07,740
!لا داعي لأن تخجل هكذا

190
00:12:07,740 --> 00:12:10,690
!انظر، حتّى أنّنا نملك نفس الخصلة

191
00:12:11,000 --> 00:12:13,300
عمّاذا تتحدّثين أساسًا؟

192
00:12:13,300 --> 00:12:16,130
هل "أختك الكبرى" بخير؟

193
00:12:16,770 --> 00:12:18,870
إنّها مستميتة للحبّ قليلًا

194
00:12:18,870 --> 00:12:20,760
!هيا، فلنمرح قليلًا

195
00:12:20,760 --> 00:12:21,810
!لا! ابتعدي عنّي

196
00:12:21,810 --> 00:12:22,410
!توقفي

197
00:12:22,410 --> 00:12:24,480
!هذا مؤلم

198
00:12:23,550 --> 00:12:24,490
!يكفي

199
00:12:24,490 --> 00:12:26,090
هل أنت هيبيكي؟

200
00:12:26,090 --> 00:12:30,100
تملك الهواتف التي كان يهرّب وودو، صحيح؟

201
00:12:31,010 --> 00:12:32,350
نعلم كلّ شيء

202
00:12:32,350 --> 00:12:34,520
سلّمنا الهواتف

203
00:12:34,520 --> 00:12:36,520
وإلّا سأوسعك ضربًا

204
00:12:36,520 --> 00:12:38,210
هل سمعتم ما قلت؟

205
00:12:38,210 --> 00:12:39,970
تلك المرأة تظنّ نفسها ذا شأن كبير

206
00:12:39,970 --> 00:12:41,540
توسعينه ضربًا؟

207
00:12:41,540 --> 00:12:42,820
يبدو هذا ممتعًا

208
00:12:42,820 --> 00:12:44,020
أودّ مشاهدة ذلك

209
00:12:44,020 --> 00:12:46,030
!امنحينا وقتًا ممتعًا

210
00:12:47,040 --> 00:12:49,540
!أكاني، صِدقًا! توقّفي عن ولعك

211
00:12:49,760 --> 00:12:50,930
!تبًّا

212
00:12:50,450 --> 00:12:52,490
تريدين أن تحكمي المدرسة، أليس كذلك؟

213
00:12:52,490 --> 00:12:53,900
هل هذا لائق حقًّا؟

214
00:12:54,290 --> 00:12:55,300
!صحيح

215
00:12:55,300 --> 00:12:57,380
!أخرج كلّ الهواتف

216
00:12:57,380 --> 00:12:59,480
حينها سأدعك تنضمّ إلى عصابتي

217
00:13:00,100 --> 00:13:02,050
يكفي عبثًا

218
00:13:03,540 --> 00:13:04,540
أنا آسف

219
00:13:04,540 --> 00:13:06,790
،أنتِ جذابة بحق

220
00:13:06,790 --> 00:13:08,740
لكن ليس مقدّر لنا أن نكون مع بعضنا

221
00:13:08,740 --> 00:13:10,010
...يا للحسرة

222
00:13:10,010 --> 00:13:14,440
!وسيمٌ حقًّا

223
00:13:17,170 --> 00:13:19,540
تلك الفتاة مجنونة أو ما شابه

224
00:13:19,540 --> 00:13:22,030
إذًا؟ لمَ لا تلعبن معنا بدلًا من ذلك؟

225
00:13:27,770 --> 00:13:30,540
!بعد أن فعلتِ هذا... نالوا منها

226
00:13:35,190 --> 00:13:36,540
!أيتها الحقيرة

227
00:13:43,620 --> 00:13:45,200
...شيوري

228
00:13:48,110 --> 00:13:49,360
إذًا؟

229
00:13:49,360 --> 00:13:52,890
تستطيع أن تتجنّب قتالًا لا طائل منه إن فعلتَ ما أخبرناك

230
00:13:52,890 --> 00:13:54,020
أليس كذلك؟

231
00:13:54,920 --> 00:13:56,090
شيوري

232
00:13:56,090 --> 00:13:58,590
آسفٌ لأنّي ورّطتكِ في ذلك سابقًا

233
00:13:58,590 --> 00:14:00,070
لكنّ الأوضاع مختلفة الآن

234
00:14:00,070 --> 00:14:02,020
لن يتمّ إغاظتك بعد الآن

235
00:14:02,020 --> 00:14:04,690
لديّ هاتفٌ أيضًا

236
00:14:04,690 --> 00:14:08,020
ومتى طلبتُ حمايتك؟

237
00:14:08,020 --> 00:14:10,400
سلّمني الهاتف وانقلع

238
00:14:10,400 --> 00:14:12,030
أنا هنا مع أكاني

239
00:14:12,030 --> 00:14:13,690
...شيوري... أنت

240
00:14:13,690 --> 00:14:15,540
كفّ عن المماطلة وسلّمه

241
00:14:15,540 --> 00:14:16,880
هيّا

242
00:14:16,880 --> 00:14:18,780
أم عليّ أن أجرّدك من ملابسك وأنا أفتّشك؟

243
00:14:18,780 --> 00:14:21,050
!دعيني أفعل ذلك! أرجوك

244
00:14:26,320 --> 00:14:30,220
لا يجب أن تغيظي كلبًا إلى أن تعرفي مالكه

245
00:14:31,100 --> 00:14:32,220
من أنت؟

246
00:14:35,790 --> 00:14:37,010
...شين

247
00:14:38,960 --> 00:14:41,220
يجب أن نسوّي الأمور العالقة من قبل

248
00:14:41,220 --> 00:14:44,400
الهاتف الذي أعطيتني لا يستقبل الإشارة

249
00:14:44,400 --> 00:14:46,940
...بأن تعطيني قطعةً من الخردة

250
00:14:47,040 --> 00:14:49,160
أنت مقرف تمامًا

251
00:14:50,610 --> 00:14:51,680
ماذا؟

252
00:14:51,680 --> 00:14:53,450
شين، عمّاذا تتحدّث؟

253
00:14:54,520 --> 00:14:56,470
إذًا، أنتم تعرفون بعضكم جميعًا؟

254
00:14:56,470 --> 00:14:57,410
...في تلك الحالة

255
00:14:57,410 --> 00:14:59,040
!سأنهي أمركم جميعًا فورًا

256
00:15:01,550 --> 00:15:04,360
شيوري. هل أنت غبية؟

257
00:15:04,360 --> 00:15:07,060
هل ستهاجمينني دون معرفة الوضع؟

258
00:15:07,680 --> 00:15:10,700
المدرسة تحجب موجات الراديو

259
00:15:10,700 --> 00:15:12,620
الهواتف لا تلتقط الإشارة

260
00:15:12,620 --> 00:15:14,300
وتحتاجين إلى كلمة السرّ لاستعمال الإنترنت

261
00:15:14,300 --> 00:15:16,090
الجميع مدركون لذلك

262
00:15:16,490 --> 00:15:19,520
على بقيّتكنّ الهدوء أيضًا

263
00:15:19,800 --> 00:15:21,810
...أظن أنّكنّ قد سمعتنّ عن هذا بالفعل

264
00:15:21,810 --> 00:15:25,330
،لم يمضِ عن مجيئه إلى هنا سوى بضعة أيّام

265
00:15:25,330 --> 00:15:29,020
إلّا أنّه عزلَ وودو هذا الصباح

266
00:15:29,920 --> 00:15:31,810
:وتحذيرٌ آخر

267
00:15:31,810 --> 00:15:33,530
إنّه كلبي

268
00:15:33,530 --> 00:15:37,220
،إن اتبعتنّني
سأحرص على ألّا تندمن

269
00:15:37,220 --> 00:15:41,690
،أمّا إن واجهتنّني
تستطعن أن تصبحن وودو القادم

270
00:15:42,240 --> 00:15:44,070
،إن تصرّفت بذكاء

271
00:15:44,070 --> 00:15:46,410
فلستُ بحاجة لقول المزيد، أليس كذلك؟

272
00:15:47,050 --> 00:15:48,260
!يا إلهي

273
00:15:48,260 --> 00:15:50,710
كم أنا محظوظة اليوم

274
00:15:50,710 --> 00:15:53,050
!رجلٌ آخر من نوعي المفضل

275
00:15:55,010 --> 00:15:57,520
شيوري، أظنّ أنّ هنالك سوء فهم بسيط بيننا

276
00:15:57,520 --> 00:16:00,300
...لكن صحيحٌ أنّ شين أقوى شخصٍ في المدرسة

277
00:16:00,300 --> 00:16:01,360
!اخرس

278
00:16:02,660 --> 00:16:03,780
...هكذا إذًا

279
00:16:03,780 --> 00:16:05,860
أرى أنّك بارعٌ في التذلّل على الأقل

280
00:16:06,080 --> 00:16:07,890
هذا يشعرني بالاشمئزاز

281
00:16:07,890 --> 00:16:08,860
هيبيكي

282
00:16:09,100 --> 00:16:11,560
أنت ميؤوسٌ حقًّا

283
00:16:11,560 --> 00:16:13,370
...بعد أن أصبحت كلب شين

284
00:16:13,370 --> 00:16:15,370
!لا تجرؤ على الحديث معي بانتقاص

285
00:16:17,500 --> 00:16:18,380
...لا

286
00:16:18,380 --> 00:16:20,000
ليس كذلك

287
00:16:21,090 --> 00:16:21,870
...أنا

288
00:16:21,870 --> 00:16:22,690
يكفي

289
00:16:22,690 --> 00:16:25,030
...السيّد الحثالة وكلبه الحثالة

290
00:16:25,030 --> 00:16:26,210
!فتّشنهما جيّدًا

291
00:16:26,210 --> 00:16:27,520
!أنا على وشك أن أبرحكما ضربًا

292
00:16:30,960 --> 00:16:32,150
!اهرب

293
00:16:35,330 --> 00:16:36,400
!أيها الكلب اللعين

294
00:16:36,400 --> 00:16:37,490
!لن تهربا

295
00:17:13,060 --> 00:17:15,180
...يختبئون في مرحاض الفتيان

296
00:17:15,180 --> 00:17:17,000
ما هذا؟ الروضة؟

297
00:17:17,000 --> 00:17:18,360
!يا له من أمرٍ مضحك

298
00:17:19,190 --> 00:17:20,200
!سنقتلكما

299
00:17:20,200 --> 00:17:21,750
!سنجرّدكما من ملابسكما

300
00:17:26,880 --> 00:17:28,020
يكفي

301
00:17:28,850 --> 00:17:30,940
هل هدأتنّ قليلًا الآن؟

302
00:17:31,410 --> 00:17:33,860
لم أرد حلّ هذا الأمر بالعنف

303
00:17:34,160 --> 00:17:36,340
،لكن إن واجهتنّني بالعنف

304
00:17:36,340 --> 00:17:37,720
فسأردّ لكنّ الصاع بالصاع

305
00:17:37,720 --> 00:17:40,880
هلّا خضنا محادثة لائقة الآن؟

306
00:17:41,790 --> 00:17:43,450
مع كلّ هؤلاء؟

307
00:17:43,450 --> 00:17:44,380
أتريدون القتال؟

308
00:17:54,920 --> 00:17:56,380
بالكاد تستحقّين العناء

309
00:18:12,090 --> 00:18:13,850
...قـ-قويّ للغاية

310
00:18:29,400 --> 00:18:33,040
،لم أرد أن أعنّف امرأة

311
00:18:33,650 --> 00:18:35,960
لكن ما دمتنّ لا تعرفن مكانكنّ

312
00:18:35,960 --> 00:18:37,490
اضطررتُ للجوء إلى هذا

313
00:18:39,560 --> 00:18:42,520
شين. لمَ تفعل هذا؟

314
00:18:43,880 --> 00:18:48,000
إنّهم رفاقك الجدد

315
00:18:48,880 --> 00:18:51,020
يوه، زعيم الفصل ستة

316
00:18:51,530 --> 00:18:53,490
بان من الفصل عشرون

317
00:18:55,510 --> 00:18:56,980
ماذا؟

318
00:18:56,980 --> 00:19:00,130
يوه من الفصل ستة؟

319
00:19:00,710 --> 00:19:02,030
...أخبرتني أن أجده

320
00:19:02,030 --> 00:19:03,360
فعلت

321
00:19:03,360 --> 00:19:06,190
كنتُ أنوي أن أدع الفصل ستة لك

322
00:19:06,190 --> 00:19:09,550
لكنّ يوه رجلٌ حكيم لذا قد أتى إليّ

323
00:19:09,970 --> 00:19:12,550
ما الضير من التحالف مع شخصٍ قويّ؟

324
00:19:12,930 --> 00:19:14,040
ماذا قلت؟

325
00:19:14,050 --> 00:19:19,900
لكن يبدو أنّك قد تركتَ المهمّة التي وكّلتك بها

326
00:19:19,900 --> 00:19:22,560
لأجل أن تستمتع بوقتك مع الفتيات

327
00:19:23,020 --> 00:19:24,340
...هـ-هذا غير صحيح

328
00:19:24,340 --> 00:19:26,010
...فعلتُ كما أخبرتني تمامًا

329
00:19:37,780 --> 00:19:39,620
!أنت، اتركهما

330
00:19:39,620 --> 00:19:40,840
سبق وأخبرتك

331
00:19:41,520 --> 00:19:46,500
كلّ من يعاديني سيلقى نهايةً سيّئة

332
00:19:46,780 --> 00:19:48,060
هيبيكي

333
00:19:48,060 --> 00:19:50,810
،لقد خيّبت أملي حقًّا هذه المرّة

334
00:19:51,130 --> 00:19:53,790
لذا سأمنحك فرصةً أخيرة

335
00:19:55,660 --> 00:19:56,800
ما الذي تفعله؟

336
00:19:57,300 --> 00:19:59,540
جرّدهما من ملابسهما

337
00:19:59,540 --> 00:20:01,540
!والتقط صورًا عارية لهما

338
00:20:03,050 --> 00:20:05,410
،إن عادياني مرّةً أخرى

339
00:20:05,410 --> 00:20:07,620
!سأرسل الصور إلى الجميع في المدرسة

340
00:20:07,620 --> 00:20:08,520
...لا

341
00:20:09,240 --> 00:20:11,000
هيّا، بادر

342
00:20:12,020 --> 00:20:13,400
عمّاذا تتحدّث؟

343
00:20:13,400 --> 00:20:14,570
!هذا سخيف

344
00:20:14,570 --> 00:20:16,240
تفعل شيئًا كهذا لفتاة؟

345
00:20:16,240 --> 00:20:17,020
—أنت

346
00:20:25,230 --> 00:20:28,030
هيبيكي، لا أصدّقك

347
00:20:28,030 --> 00:20:30,910
،ظننتُ أنّك كلبٌ وفيّ

348
00:20:30,910 --> 00:20:33,690
لكنّ لا تستطيع حتّى التكفّل باختبارٍ صغيرٍ كهذا؟

349
00:20:34,000 --> 00:20:36,810
...وتعصي أوامر سيّدك

350
00:20:36,810 --> 00:20:40,400
مع أنّ هذه ثاني مرّةٍ تعاديني

351
00:20:42,690 --> 00:20:45,180
هل ظننتَ أنّني لم أعلم؟

352
00:20:45,180 --> 00:20:47,500
أنّك لم تفعلها مع شيوري بعد

353
00:20:49,600 --> 00:20:51,970
...لا، أنا

354
00:20:53,520 --> 00:20:56,190
،إن كانت شيوري امرأتك بالفعل

355
00:20:56,190 --> 00:20:59,020
لما كانت تتصرّف هكذا الآن

356
00:20:59,020 --> 00:21:01,440
،إن كنتَ لا تدرك ذلك حتّى

357
00:21:01,440 --> 00:21:05,010
فأنت غبيّ ميؤوسٌ منه بالفعل

358
00:21:05,010 --> 00:21:06,170
...أنت

359
00:21:07,990 --> 00:21:09,020
اسمع

360
00:21:09,020 --> 00:21:11,050
هذه فرصتك الأخيرة

361
00:21:11,380 --> 00:21:13,040
التقط صورًا عارية لهما

362
00:21:14,700 --> 00:21:16,540
،إن أبيتَ أن تكون كلبي

363
00:21:17,390 --> 00:21:19,120
فستكون عدوّي

364
00:21:19,550 --> 00:21:21,610
اختر ما تفضّل

365
00:21:22,080 --> 00:21:23,640
...أنا

366
00:21:47,000 --> 00:21:48,990
سألتقط واحدةً فحسب

367
00:21:48,990 --> 00:21:51,040
أسيفي ذلك بالغرض؟

368
00:21:54,210 --> 00:21:55,540
حسنًا

369
00:23:25,960 --> 00:23:39,970
عرض مسبق للحلقة القادمة

370
00:23:28,000 --> 00:23:28,930
هيبيكي

371
00:23:29,520 --> 00:23:31,480
لقد ولدتُ من جديد اليوم

372
00:23:30,210 --> 00:23:32,810
أيها الحثالة الميؤوس منه

373
00:23:31,970 --> 00:23:34,280
لا أكترث إن كلّفني هذا حياتي

374
00:23:34,280 --> 00:23:36,470
!لا أكترث إن كان يجب أن أبيع روحي

375
00:23:35,290 --> 00:23:36,460
!هذه غلطتك

376
00:23:36,460 --> 00:23:39,320
!لمَ قد أعهد بولائي لشخصٍ مثلك؟

377
00:23:36,680 --> 00:23:39,980
لدي هدفٌ وحيدٌ فحسب