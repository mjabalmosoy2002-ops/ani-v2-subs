1
00:00:07,210 --> 00:00:13,800
هنالك نوعٌ جديدٌ من الأمراض
ينتشر بين الشباب

2
00:00:14,360 --> 00:00:17,280
،بعدَ الفترات المطوّلة من استخدام الإنترنت

3
00:00:17,530 --> 00:00:23,420
يصبح للمصابين به اتّكالٌ باثولوجيّ على الإنترنت

4
00:00:23,820 --> 00:00:28,210
"وقد وصف الخبراء هذا المرض بـ"إدمان الإنترنت

5
00:00:29,000 --> 00:00:34,890
ومن أجل إعادة هؤلاء الشباب المدمنين
إلى الطّريق الصّحيح

6
00:00:34,890 --> 00:00:39,130
وإعادة تأهليهم إلى أشخاصٍ راشدين
ومُستقلّين ومُحترمين لذاتهم

7
00:00:39,720 --> 00:00:45,890
تمّ إنشاء منشأة تعليميّة مدنيّة
تُدعى بأكاديمية إعادة تعليم النخبة

8
00:00:47,000 --> 00:00:53,740
مكانٌ يساعد الشباب ليكبروا بطريقةٍ صحيحة

9
00:02:27,540 --> 00:02:29,130
ذلك بسيط

10
00:02:29,130 --> 00:02:31,500
سأخبركم الآن

11
00:02:33,010 --> 00:02:35,000
راقبوا جيّدًا

12
00:02:36,880 --> 00:02:38,820
اشهدوا ما يحدث لأيّ أحد

13
00:02:38,820 --> 00:02:43,010
يعارضني أو يسخر منّي من الآن فصاعدًا

14
00:02:46,030 --> 00:02:47,580
انتظر فحسب يا شين

15
00:02:47,970 --> 00:02:51,100
سيحين دورك... في المرّة القادمة

16
00:03:00,410 --> 00:03:01,490
اتّخذوا مواقعكم

17
00:03:01,860 --> 00:03:03,120
...استعداد

18
00:03:04,300 --> 00:03:27,590
!أنتم لها! أنتم لها

19
00:03:27,590 --> 00:03:29,300
!هيا يا شيوري

20
00:03:50,790 --> 00:03:53,180
!أنتم لها! إنه العدْوُ الأخير

21
00:03:56,420 --> 00:03:57,680
!أجل

22
00:03:57,680 --> 00:03:59,420
!أحسنت يا هيبيكي

23
00:03:59,420 --> 00:04:01,800
!أنت مذهل! كان ذلك رائعًا

24
00:04:07,760 --> 00:04:08,900
!فزنا

25
00:04:16,610 --> 00:04:18,260
اشهدوا ما يحدث لأيّ أحد

26
00:04:18,260 --> 00:04:22,150
يعارضني أو يسخر منّي من الآن فصاعدًا

27
00:04:34,530 --> 00:04:36,240
من أنا؟

28
00:04:36,240 --> 00:04:37,490
...هذا ليس أنا

29
00:04:37,490 --> 00:04:40,010
!يستحيل أن يكون أنا

30
00:04:40,010 --> 00:04:41,500
هيبيكي؟

31
00:04:45,390 --> 00:04:46,740
ماذا تفعل؟

32
00:04:46,740 --> 00:04:48,310
فلنعد إلى الفصل

33
00:04:49,790 --> 00:04:51,380
...شيوري

34
00:05:00,750 --> 00:05:03,410
أتريد أن تصبح جبانًا؟

35
00:05:03,410 --> 00:05:05,490
...ربّما يجب أن أعلّمك

36
00:05:05,960 --> 00:05:09,490
عن الطريق الصحيح

37
00:05:11,530 --> 00:05:14,310
!لا... لا أريد أن أكون مثلك

38
00:05:14,310 --> 00:05:15,240
!ابتعد عنّي

39
00:05:15,240 --> 00:05:16,860
كفّ عن ادّعاء الغباء

40
00:05:16,860 --> 00:05:20,900
!هذه هي نفسك الحقيقية

41
00:05:24,520 --> 00:05:26,010
!شيوري

42
00:05:32,730 --> 00:05:33,970
مـ... موكو؟

43
00:05:34,530 --> 00:05:36,250
...هيبيكي-كُن

44
00:05:36,520 --> 00:05:37,740
هل استيقظت؟

45
00:05:37,740 --> 00:05:39,190
لقد أفزعتني

46
00:05:39,190 --> 00:05:41,890
ربّما يجب أن تنام أكثر

47
00:05:41,890 --> 00:05:43,800
أنا أفضل حالٍ الآن

48
00:05:44,820 --> 00:05:47,050
...أ-أخي الكبير هيبيكي

49
00:05:47,050 --> 00:05:49,170
ماذا؟ ماذا تريدون؟

50
00:05:49,820 --> 00:05:51,860
...أخي الكبير هيبيكي

51
00:05:51,860 --> 00:05:55,950
لقد عاملناك بوقاحة كبيرة في الماضي

52
00:05:55,950 --> 00:05:58,510
لكن أرجو أن تسامحنا

53
00:05:58,510 --> 00:06:01,360
!سنفعل أيّ ما تقول من الآن فصاعدًا

54
00:06:01,360 --> 00:06:03,360
!نحن آسفون يا أخانا الكبير

55
00:06:07,890 --> 00:06:08,840
أنت، سي

56
00:06:08,840 --> 00:06:11,870
ماذا؟ لمَ يجب أن أعتذر بينما لم أقترف أيّ شيء؟

57
00:06:13,080 --> 00:06:18,020
هيبيكي، خلتُكَ لا تجيد سوى الكلام لكنّي كنتُ مخطئًا

58
00:06:18,020 --> 00:06:21,420
لن أعتذر لكنّي سأتّبعك من الآن فصاعدًا

59
00:06:23,210 --> 00:06:26,240
سخرتم منّي كثيرًا في الماضي

60
00:06:26,240 --> 00:06:28,350
لقد غيّرتم موقفكم بشكلٍ مفاجئ بحق

61
00:06:28,350 --> 00:06:29,840
...فـ-في الواقع

62
00:06:29,840 --> 00:06:33,890
لمَ تريدون منّي أن أقبلكم الآن؟

63
00:06:35,700 --> 00:06:36,960
!أنت، هيبيكي

64
00:06:36,960 --> 00:06:38,400
ماذا تعني بقبولنا؟

65
00:06:38,400 --> 00:06:39,750
!لا تتغطرس

66
00:06:40,800 --> 00:06:42,500
ما هذه الطريقة التي تحدّثني بها؟

67
00:06:42,890 --> 00:06:44,810
أم يعقل أنّك تعارضني؟

68
00:06:47,400 --> 00:06:48,190
تنحّوا عن الطريق

69
00:06:50,170 --> 00:06:51,600
هنالك خطب غريب يجري

70
00:06:52,510 --> 00:06:56,370
في الماضي، لطالما حاولوا كسب رضى شين

71
00:06:56,370 --> 00:06:58,010
لقد تخلّصتُ من يوه فحسب

72
00:06:58,300 --> 00:07:02,690
إن كانوا يطلبون منّي العون
...بدل ضربي بينما كنتُ مستلقيًا

73
00:07:02,690 --> 00:07:04,940
ألم يعودوا يخافون شين؟

74
00:07:05,920 --> 00:07:08,500
لا أحد يتحدّث عن شين

75
00:07:08,500 --> 00:07:12,520
في المقابل، أتى يوه لمواجهتي فجأةً

76
00:07:13,150 --> 00:07:14,270
أذاك هيبيكي؟

77
00:07:14,270 --> 00:07:16,990
أنت الفاشل الذي أوسعه يوه-سان ضربًا

78
00:07:16,990 --> 00:07:17,800
!هـ-هيبيكي

79
00:07:17,800 --> 00:07:19,390
هـ-هل ضربت يوه-سينباي؟

80
00:07:19,380 --> 00:07:22,250
،إن ساعدتموه الآن
!سيعود كلّ شيءٍ إلى مجراه الطبيعيّ

81
00:07:19,390 --> 00:07:20,460
!أتريد أن تموت؟

82
00:07:22,250 --> 00:07:24,640
نائب كبير المدرّسين ريو بجانب يوه-سينباي

83
00:07:24,640 --> 00:07:26,920
فعل ما يقوله يوه-سينباي هو السبيل الآمن

84
00:07:27,710 --> 00:07:30,640
أيعقل أنّ شين وضع يوه في الجبهةِ عمدًا

85
00:07:30,640 --> 00:07:32,840
لكي يستنّى له التلاعب بالأوضاع خلف الستار؟

86
00:07:32,840 --> 00:07:37,690
،لكن، مع أنّه قد انتشر في اللأرجاء خبر هزيمتي ليوه

87
00:07:37,690 --> 00:07:40,430
إلّا أنّ المدرسة صامتة مجدّدًا

88
00:07:40,430 --> 00:07:43,850
وما يدعو للحيرة أكثر، ريو لم يعاديني أيضًا

89
00:07:44,330 --> 00:07:47,120
إن انضممت لي، سأحرص أنّك لن تندم

90
00:07:47,120 --> 00:07:49,840
كنتُ أنوي ترك الفصل ستّة لك

91
00:07:49,840 --> 00:07:53,200
لكنّ يوه ذكيّ، لذا فقد أتى إليّ

92
00:07:53,200 --> 00:07:56,070
إن أبيتَ أن تكون كلبي فستكون عدوّي

93
00:07:56,490 --> 00:07:58,310
اختر ما تفضّل

94
00:08:03,160 --> 00:08:06,820
شين... ما الذي يفكّر فيه؟

95
00:08:09,000 --> 00:08:10,050
بالمناسبة جميعًا

96
00:08:10,050 --> 00:08:12,050
هل سمعتم أيّ شيء عن شين مؤخرًا؟

97
00:08:12,510 --> 00:08:14,170
عن شين؟

98
00:08:14,170 --> 00:08:16,080
...لا، لا شيء مؤخرًا

99
00:08:16,080 --> 00:08:18,510
لم أره كما أنّه لم يتسبّب في أيّ مشاكل

100
00:08:18,510 --> 00:08:19,580
فهمت

101
00:08:19,580 --> 00:08:22,660
إن قام بأيّ شيء من الآن فصاعدًا، أبلغوني على الفور

102
00:08:22,660 --> 00:08:24,790
...حـ-حاضر. مفهوم

103
00:08:25,020 --> 00:08:27,910
،إن أردتم أن تعوّلوا عليّ من الآن فصاعدًا

104
00:08:27,910 --> 00:08:29,700
،إذًا، كوني زميلكم

105
00:08:29,700 --> 00:08:32,650
فسأعتبركم عائلتي جميعًا

106
00:08:33,030 --> 00:08:34,530
أ-أحقًّا؟

107
00:08:34,530 --> 00:08:38,850
،وإن اعتدى أيّ منكم على موكو

108
00:08:38,850 --> 00:08:41,490
سأجعله يندم

109
00:08:42,220 --> 00:08:44,160
!مـ-مفهوم

110
00:08:44,560 --> 00:08:46,500
...معذرةً

111
00:08:46,800 --> 00:08:48,210
اسمع يا شين

112
00:08:48,500 --> 00:08:50,970
لم نسوِّ الأمور بيننا بعد

113
00:08:50,970 --> 00:08:55,000
،أينما كنتَ تختبئ
سأسحبك إلى العراء

114
00:08:55,510 --> 00:08:58,570
أخي الكبير، نحن على وشك أن نصل

115
00:08:58,570 --> 00:09:00,650
كما أنّ الشحنة ستصل في غضون يومين

116
00:09:01,010 --> 00:09:03,210
،سمعتُ أنّ التلاميذ يسيئون التصرّف

117
00:09:03,210 --> 00:09:05,020
وأنّ المدرّسين يماطلون

118
00:09:05,020 --> 00:09:06,880
سأنهي المشكل من أصله

119
00:09:06,880 --> 00:09:09,010
راقب شين

120
00:09:10,370 --> 00:09:13,130
أنتَ أدرى بأخاك الصغير

121
00:09:14,400 --> 00:09:15,920
غريبُ الأطوار ذاك

122
00:09:15,920 --> 00:09:18,370
...لا أعلم أبدًا فيمَ يفكّر

123
00:09:18,370 --> 00:09:22,140
حتّى أنّه طلب من أبي أن يدعه
يلتحق بتلك المدرسة القذرة

124
00:09:22,140 --> 00:09:24,480
أيًّا كان، نحن أخوان

125
00:09:25,510 --> 00:09:28,820
أوتظنّ حقًّا أنّني قد أؤذي أخي الصغير؟

126
00:09:30,560 --> 00:09:32,400
لم يعد يملك الكثير من الوقت

127
00:09:32,400 --> 00:09:34,510
بينما تتكفّل بالأمر، أعده إلى البيت أيضًا

128
00:09:34,720 --> 00:09:36,450
،إلّم أقم أنا، أخاه

129
00:09:36,450 --> 00:09:38,510
،بالاعتناء به حتّى النهاية

130
00:09:38,890 --> 00:09:40,960
سيحزن أبي

131
00:09:42,110 --> 00:09:43,870
اترك الأمر لي

132
00:09:43,870 --> 00:09:47,020
،أنا على وشك أن أفقد الإشارة
لذا فلنتحدّث لاحقًا

133
00:09:53,120 --> 00:09:55,190
ماذا تفعلين؟

134
00:09:56,500 --> 00:09:58,990
هلّا أعرتني هذا الهاتف؟

135
00:09:59,870 --> 00:10:03,810
تعلمين أنّ نائب كبير المدرّسين
ريو إلى جانب الفصل ستّة، صحيح؟

136
00:10:03,810 --> 00:10:07,110
أتريدين أن تكسبي ثقته بسرقة هاتفي؟

137
00:10:08,310 --> 00:10:10,010
...فهمت الآن

138
00:10:10,010 --> 00:10:12,420
لقد كانت تحاول استعارته لفترةٍ صغيرة فحسب

139
00:10:12,820 --> 00:10:15,500
أيجب أن أرسلك إلى المستشفى؟

140
00:10:15,690 --> 00:10:17,510
بوسعك أن تنضمّ إلى يوه هناك

141
00:10:18,260 --> 00:10:20,020
...مـ-مهلًا، أنتما

142
00:10:20,020 --> 00:10:22,140
أختي الصغرى حادّة الطّبع

143
00:10:22,140 --> 00:10:24,350
من مصلحتك أن تستسلم

144
00:10:24,350 --> 00:10:26,210
!إنّما أريد أن أستعيره لفترةٍ قصيرة

145
00:10:26,210 --> 00:10:28,270
!سأعيده إليك بعد أن ينتهي مرحنا

146
00:10:31,080 --> 00:10:34,520
أيّ كبير مدرّسين أنت؟

147
00:10:53,250 --> 00:10:56,000
لا يمكنك حتّى أن تسيطر على التلاميذ كما يجب

148
00:10:56,000 --> 00:10:58,740
إلّا أنّك ستتحدّى من أعلى منك؟

149
00:10:58,740 --> 00:11:00,870
مهلًا يا هيو. ما الذي تفعله؟

150
00:11:00,870 --> 00:11:03,690
شجار التلاميذ أمرٌ شائع بالفعل

151
00:11:03,690 --> 00:11:06,260
وليس سببًا لضرب كبير المدرّسين

152
00:11:06,260 --> 00:11:10,540
لقد حذّرتُ كبير المدرّسين من شين مرّات عديدة

153
00:11:12,180 --> 00:11:15,390
بسببه، تدهور وضع المدرسة

154
00:11:16,050 --> 00:11:18,740
!لقد تجاهلتَ كلّ ما أخبرتك

155
00:11:29,760 --> 00:11:31,570
يا لشيان الأحمق

156
00:11:31,570 --> 00:11:35,000
أكان يظنّ أنّه في مأمن فقط لأنّ جين إلى جانبه؟

157
00:11:35,000 --> 00:11:37,480
الضبّاط يطردون طوال الوقت

158
00:11:37,480 --> 00:11:39,160
...يا لك من أحمقٍ وضيع

159
00:11:40,900 --> 00:11:43,220
هيو، هذا يكفي

160
00:11:43,220 --> 00:11:46,060
أنتَ من أرغمتنا على الاعتراف بشين، أليس كذلك؟

161
00:11:46,060 --> 00:11:48,670
لقد اعتنينا به كما أردتَ تمامًا

162
00:11:48,670 --> 00:11:51,920
!فكيف تجرؤ على إذانتنا بعد ذلك؟

163
00:11:51,920 --> 00:11:55,520
أيتها المديرة، أتعارضين كيف يسيّر أخي الكبير الأمور؟

164
00:11:56,260 --> 00:12:00,400
هل تذكّرتَ أنّني المديرة أخيرًا؟

165
00:12:00,400 --> 00:12:02,020
أظهر بعض الاحترام

166
00:12:02,020 --> 00:12:02,800
اسمع

167
00:12:02,800 --> 00:12:05,990
لا تؤدّي تفاهاتك في هذه المدرسة

168
00:12:05,990 --> 00:12:09,000
أنت من سيقع في مأزق حال
حدوث مشكلة ما، أليس كذلك؟

169
00:12:17,100 --> 00:12:18,480
أيتها المديرة جين

170
00:12:18,480 --> 00:12:20,550
أنتِ مميّزةٌ حقًّا، أليس كذلك؟

171
00:12:20,550 --> 00:12:23,430
سأترك الإشراف على المدرّسين عليك

172
00:12:23,430 --> 00:12:25,230
ويا كبير المدرّسين شيان

173
00:12:25,230 --> 00:12:29,560
يجب أن تستريح وتعتني بجراحك

174
00:12:29,560 --> 00:12:33,430
سأعتني بالتلاميذ أثناء غيابك

175
00:12:34,500 --> 00:12:36,500
لا توجد معارضة على هذا، صحيح؟

176
00:12:37,440 --> 00:12:39,330
...إذًا

177
00:12:39,330 --> 00:12:41,310
أيها المدرّس ريو، هيّا بنا

178
00:12:45,780 --> 00:12:49,060
أصبح كبير المدرّسين شيان مغترًّا بذاته كثيرًا

179
00:12:53,490 --> 00:12:55,930
لقد كان ذلك رائعًا يا أخي الكبير

180
00:12:55,930 --> 00:12:58,080
توجّب إلزام كبير المدرّسين شيان حدّه

181
00:12:58,080 --> 00:13:00,170
لقد تسبّب في الكثير من المتاعب لي أيضًا

182
00:13:00,170 --> 00:13:04,500
،كلٌّ من وودو ويوه هزما من قبل هيبيكي
تلميذٌ جديد في فصل شيان

183
00:13:04,500 --> 00:13:07,310
يجب أن نضع حدًّا لهيبيكي أيضًا

184
00:13:08,010 --> 00:13:11,020
مدرّس ريو، يجب أن أسألك شيئًا

185
00:13:11,890 --> 00:13:13,020
أين الهاتف؟

186
00:13:14,500 --> 00:13:16,980
إنّه يتطلّب كلمة سر

187
00:13:16,980 --> 00:13:20,290
،كما أنّه مرّ عليه بضع أيّام
...لا بدّ أنّه قد فرغَ شحنه

188
00:13:20,730 --> 00:13:22,220
لـ-لا أظنّه سيشكّل مشكلًا كبيرًا

189
00:13:22,220 --> 00:13:25,610
،اسمع يا ريو. لا أكنّ المودّة لشيان

190
00:13:26,010 --> 00:13:27,990
لكنّي واثقٌ من أمرٍ واحد

191
00:13:28,550 --> 00:13:31,490
لم يضرب تلميذًا حتّى الموت أبدًا

192
00:13:32,220 --> 00:13:34,990
هل ستلقي اللّوم على وودو رغم ذلك؟

193
00:13:35,320 --> 00:13:38,500
وأين شين بالضبط؟

194
00:13:39,680 --> 00:13:42,590
ا-اسمع... لا أعلم أيّ شيء عن شين

195
00:13:42,820 --> 00:13:45,010
لم أره منذ ذلك الحين

196
00:13:45,010 --> 00:13:48,010
كما أنّ خادمه بان قد اختفى هو الآخر

197
00:13:48,660 --> 00:13:50,430
اختفى؟

198
00:13:52,520 --> 00:13:55,010
لمَ لا تخبرني ما كان يجري هنا بالضبط؟

199
00:13:55,520 --> 00:13:58,180
أخبرني بالتفصيل الممل

200
00:13:59,160 --> 00:14:00,610
حـ-حاضر

201
00:14:01,690 --> 00:14:03,550
لا توجد إشارة؟

202
00:14:03,550 --> 00:14:05,530
أتقصدين أنّك تستطيعين ولوج
بعض الصفحات المعيّنة فحسب؟

203
00:14:05,530 --> 00:14:06,710
بدون شك

204
00:14:06,710 --> 00:14:10,490
الهواتف المتداولة حول المدرسة
هي في الأساس أنظمة ألعاب

205
00:14:18,990 --> 00:14:21,060
أنتِ ثرثارة عندما يتعلّق الأمر بالإنترنت على الأقل

206
00:14:21,060 --> 00:14:22,030
لا عجب أنّكِ جئت إلى هنا

207
00:14:22,030 --> 00:14:23,260
!أنت

208
00:14:23,770 --> 00:14:27,010
هذا الهاتف متّصلٌ بشبكة المدرسة

209
00:14:27,010 --> 00:14:29,510
،وبما أنّ صلاحية الولوج محدودة

210
00:14:29,510 --> 00:14:31,530
كلّ ما يمكننا هو النظر فحسب

211
00:14:31,530 --> 00:14:35,210
وعدتني بأن تدعيني أتّصل بأخي الصغير

212
00:14:35,210 --> 00:14:38,420
أخبرتك، هذا المكان يمنع إشارة الهواتف

213
00:14:38,420 --> 00:14:41,140
لن تستطيعي أبدًا استخدام هاتفٍ للاتّصال

214
00:14:41,140 --> 00:14:44,020
...ومع ذلك، أنا عبقريّة بالفعل

215
00:14:44,020 --> 00:14:47,660
!أستطيع أن أخترق أيّ قيودٍ موضوعة بأيّ هاتفٍ كان

216
00:14:47,660 --> 00:14:52,440
كما أنّني أعددتُ شبكتي الخاصة التي شفّرتها بنفسي

217
00:14:52,440 --> 00:14:54,720
،إن استرجعنا جهازي الذي يتّصل بتلك الشبكة

218
00:14:54,720 --> 00:14:56,850
بوسعنا إجراء الاتّصالات كما
!استخدام الإنترنت كما نشاء

219
00:14:56,850 --> 00:14:58,870
،لدينا الهاتف
!فلنسترجع جهازي الآن

220
00:14:58,870 --> 00:15:01,200
!فور أن أسترجعه، سيكون كلّ شيءٍ جاهز

221
00:15:02,210 --> 00:15:04,250
شيوري؟ ما الخطب؟

222
00:15:04,250 --> 00:15:08,010
،اقتربنا كثيرًا من تحقيق هدفنا
...إلّا أنّكِ لا تبدين سعيدة

223
00:15:10,590 --> 00:15:14,010
هل سمعتما أيّ شيءٍ عن شين مؤخرًا؟

224
00:15:14,690 --> 00:15:17,060
لقد توارى عن الأنظار في الآونة الأخيرة على ما أظنّ

225
00:15:17,060 --> 00:15:18,960
لا شيء يدعو للغرابة

226
00:15:18,960 --> 00:15:22,420
التلاعب بالآخرين خلف الظلال
هو أسلوب شين المعتاد

227
00:15:24,360 --> 00:15:26,360
أظنّ أنّ هنالك ما هو أكثر من ذلك

228
00:15:30,800 --> 00:15:32,470
هل تعرفان فتاة تدعى جون؟

229
00:15:32,470 --> 00:15:33,510
جون؟

230
00:15:33,510 --> 00:15:36,990
أليست تلك الفتاة التي تنمّر عليها وودو في الملعب سابقًا؟

231
00:15:36,990 --> 00:15:38,160
أجل

232
00:15:38,160 --> 00:15:40,880
قالت أنّها تستطيع الاتّصال بحبيبها

233
00:15:41,620 --> 00:15:44,500
أظنّ أنّ ما خفي عنها كان أعظم

234
00:15:44,870 --> 00:15:47,080
،إلّم نهزم شين الآن

235
00:15:47,080 --> 00:15:49,950
يجب أن نغيّر من استراتيجيتنا ونستجوب جون

236
00:15:49,950 --> 00:15:51,060
شيوري

237
00:15:51,060 --> 00:15:52,510
هلّي أن أسألك شيئًا؟

238
00:15:52,510 --> 00:15:56,100
كيف انتهى المطاف بتلميذة مشرّفة مثلك هنا؟

239
00:15:56,100 --> 00:15:57,570
والداك متوفيان

240
00:15:57,570 --> 00:15:59,100
وأخوك الصغير في المستشفى

241
00:15:59,100 --> 00:16:00,540
فمن أرسلك إلى هنا؟

242
00:16:01,940 --> 00:16:03,050
!سؤالٌ سديد

243
00:16:03,050 --> 00:16:05,780
فكّرتُ أنّ الأمر بدا غريبًا منذ أن جئتِ هنا

244
00:16:05,780 --> 00:16:07,070
انظر إلى تلك الفتاة

245
00:16:07,070 --> 00:16:09,100
فتاة جديدة؟ ما اسمها؟

246
00:16:09,100 --> 00:16:10,610
يقال أنه شيوري

247
00:16:11,030 --> 00:16:12,300
تبدو كتلميذة مُشرّفة

248
00:16:12,300 --> 00:16:14,110
هل تملك إدمانًا على الإنترنت حقًّا؟

249
00:16:14,620 --> 00:16:17,380
!تلميذة الشهر هي شيوري

250
00:16:17,380 --> 00:16:19,100
أريدكم جميعًا أن تأخذوا العبرة منها

251
00:16:19,980 --> 00:16:24,500
كبير المدرّسين، إن فعلتُ كلّ ما
يطلب منّي، هل سأخرج من هنا مبكّرًا؟

252
00:16:24,500 --> 00:16:26,420
سأفعل ما بوسعي

253
00:16:26,420 --> 00:16:29,510
سأُبلغ المديرة ومشرفك عن ذلك

254
00:16:30,090 --> 00:16:31,210
حسنًا

255
00:16:31,990 --> 00:16:33,010
شيوري

256
00:16:33,190 --> 00:16:35,510
أنتِ تلميذة ممتازة

257
00:16:35,510 --> 00:16:37,000
لا تنسي الاجتهاد في العمل

258
00:16:37,840 --> 00:16:38,720
!حاضر

259
00:16:39,600 --> 00:16:43,010
شيوري، لقد خيّبتِ ظنّي فيك

260
00:16:44,450 --> 00:16:47,850
شيوري، أهكذا تردّين كرامتي؟

261
00:16:47,850 --> 00:16:49,020
...أيتها الشقيّة

262
00:16:49,500 --> 00:16:52,610
من اعتنى بك بعد موت والديك؟

263
00:16:52,610 --> 00:16:54,480
...حتّى أنّني دفعتُ تكاليف علاج أخيك

264
00:16:54,480 --> 00:16:56,250
...كيف تجرئين على عصياني

265
00:16:56,250 --> 00:17:00,140
وجدتها... سأجعلك تعرفين الشعور الحقيقيّ للوحدة

266
00:17:00,140 --> 00:17:02,000
!لن تري أخاك مجدّدًا

267
00:17:06,420 --> 00:17:07,970
أنتنّ هنا

268
00:17:10,510 --> 00:17:13,500
!عزيزي، لقد أتيت

269
00:17:13,500 --> 00:17:15,160
تبدو مثابرًا

270
00:17:15,160 --> 00:17:16,500
هنالك تغييرٌ في الخطط

271
00:17:16,690 --> 00:17:18,500
تعالَين معي

272
00:17:18,500 --> 00:17:19,900
سأغادر

273
00:17:29,520 --> 00:17:30,780
بالتوفيق

274
00:17:33,760 --> 00:17:36,100
عجبًا، لقد ذهبت فعلًا

275
00:17:36,610 --> 00:17:41,000
،إن عرفوا ما حدث
سيكرهونني حتمًا

276
00:17:41,700 --> 00:17:45,680
يجب أن أتكفّل بالأمور بنفسي في النهاية

277
00:17:53,520 --> 00:17:55,410
أعلم يا أخي الكبير

278
00:17:55,410 --> 00:17:57,270
لا تقلق

279
00:17:57,270 --> 00:17:59,270
أملك فكرةً

280
00:17:59,270 --> 00:18:01,490
سأجد شين مهما كان

281
00:18:01,490 --> 00:18:05,020
.لا يزال إنسانًا
لا يمكنه أن يتلاشى في الهواء

282
00:18:07,590 --> 00:18:11,300
هيو، ستنتقم لأجلي، أليس كذلك؟

283
00:18:11,300 --> 00:18:13,620
،لقد كنتُ فتاةً مطيعةً كما أخبرتني

284
00:18:13,620 --> 00:18:16,030
...لكنّهم اعتدوا عليّ مع ذلك

285
00:18:18,710 --> 00:18:20,710
أنت تبلين جيّدًا

286
00:18:21,300 --> 00:18:24,040
لن أدعك تعانين أكثر

287
00:18:24,460 --> 00:18:25,670
...هيبيكي

288
00:18:25,670 --> 00:18:27,610
لمَ تبحث عن شين فجأةً؟

289
00:18:27,610 --> 00:18:29,040
أظنّ أنّ أمرًا مريبًا يجري

290
00:18:29,660 --> 00:18:31,710
،بعد خروج يوه عن الموضوع

291
00:18:31,710 --> 00:18:33,540
هذه فرصتنا للهجوم على شين

292
00:18:34,880 --> 00:18:38,050
إذًا... هذا مخبأ شين؟

293
00:18:38,050 --> 00:18:39,520
أهو حقًّا؟

294
00:18:40,180 --> 00:18:42,020
شين! هل أنت هنا؟

295
00:18:42,020 --> 00:18:43,450
!اخرج الآن

296
00:18:43,450 --> 00:18:45,900
!أعد إليّ جهازي الثمين

297
00:18:50,020 --> 00:18:51,530
...ما الذي

298
00:18:51,530 --> 00:18:53,400
ما بال ذلك التعبير المنفر؟

299
00:18:54,610 --> 00:18:55,520
!مهلًا

300
00:19:02,410 --> 00:19:03,540
...هذا

301
00:19:09,690 --> 00:19:12,990
عجبًا، أليس هذا جناحًا صغيرًا فاخرًا؟

302
00:19:13,410 --> 00:19:14,930
أين شين؟

303
00:19:14,930 --> 00:19:18,170
!لا، أوّلًا... يجب أن أجد جهازي

304
00:19:27,710 --> 00:19:29,300
...هنالك الكثير

305
00:19:32,500 --> 00:19:34,000
من الشوكولاتة...

306
00:19:38,910 --> 00:19:39,940
...هذا

307
00:19:57,110 --> 00:19:58,600
لا يعقل

308
00:20:01,390 --> 00:20:02,710
...أهو

309
00:20:08,520 --> 00:20:12,520
سأحاول أن أجعل جون تصارحني

310
00:20:16,910 --> 00:20:19,020
هل كنتِ تبحثين عنّي؟

311
00:20:19,020 --> 00:20:20,600
هذا رائع

312
00:20:20,600 --> 00:20:22,530
هذا يوفّر عنّي الوقت للبحث عنك

313
00:20:24,850 --> 00:20:26,030
...أنت

314
00:20:27,700 --> 00:20:31,350
فلنرَ ما إن كنت أستطيع أن أحزر ما ستسألنني

315
00:20:31,350 --> 00:20:32,490
...فلنرَ

316
00:20:32,490 --> 00:20:35,130
لمَ أنتِ الوحيدة التي تستطيع"
"استخدام هاتفٍ للاتّصال بالنّاس؟

317
00:20:35,130 --> 00:20:37,530
"كيف هرّبتِ هاتفًا إلى هنا؟"

318
00:20:37,530 --> 00:20:39,460
"ما الذي جرَّ بكِ إلى هنا؟"

319
00:20:39,460 --> 00:20:41,520
"أين ذهب زملائي؟"

320
00:20:41,520 --> 00:20:43,040
ما الذي ترمين إليه؟

321
00:20:45,460 --> 00:20:47,700
...أخوك الصغير، شو

322
00:20:47,700 --> 00:20:50,850
سمعتُ أنّه ليس بخيرٍ مؤخرًا

323
00:20:51,520 --> 00:20:52,520
!ابتعدي عنّي

324
00:20:52,520 --> 00:20:55,190
!لا أملك الوقت للعب

325
00:20:55,970 --> 00:20:57,810
تفقّدتُ سجلّك

326
00:20:57,810 --> 00:20:59,440
ظروفٌ خاصّة؟

327
00:20:59,440 --> 00:21:01,520
فترة علاجك من إدمان الإنترنت

328
00:21:01,930 --> 00:21:03,010
لا نهائية

329
00:21:03,530 --> 00:21:04,690
أليس كذلك؟

330
00:21:05,290 --> 00:21:08,030
،كيفما عملتِ بجدّ
،أو تصرّفتِ جيّدًا

331
00:21:09,180 --> 00:21:13,480
لن تخرجي من هنا ما لم يأذن مشرفك

332
00:21:13,480 --> 00:21:15,540
!يا له من مصيرٍ محزن

333
00:21:15,860 --> 00:21:18,630
لا تحدّقي بي هكذا

334
00:21:18,630 --> 00:21:20,540
أريد أن أساعدك فحسب

335
00:21:20,540 --> 00:21:23,440
تريدين أن تسمعي صوت أخاك
الصغير مجدّدًا، أليس كذلك؟

336
00:21:23,440 --> 00:21:24,550
...أنت

337
00:21:24,550 --> 00:21:27,550
،إن فعلتِ كلّ ما أقول

338
00:21:27,550 --> 00:21:31,010
أستطيع أن أخرجك من هنا في ظرف يومين

339
00:21:31,600 --> 00:21:32,990
ما رأيك؟

340
00:21:33,520 --> 00:21:34,700
...شو

341
00:21:50,040 --> 00:21:52,010
...اللعنة عليك يا شين

342
00:21:52,690 --> 00:21:55,080
ما الذي تخطّط إليه؟

343
00:23:25,960 --> 00:23:39,980
عرض مسبق للحلقة القادمة

344
00:23:26,560 --> 00:23:27,290
!أمّي

345
00:23:27,300 --> 00:23:28,930
أرى أنّك تملكين درجاتٍ جيّدة بالفعل

346
00:23:28,930 --> 00:23:32,470
لكن لا تحسبي أنّك سترين أخاك مجدّدًا

347
00:23:29,100 --> 00:23:31,460
سيعالجون مرضه، أليس كذلك؟

348
00:23:31,710 --> 00:23:33,540
سيُشفى، أليس كذلك؟

349
00:23:34,100 --> 00:23:35,720
!ابكي وترجّيني

350
00:23:36,860 --> 00:23:38,400
!أيتها الامرأة الحمقاء

351
00:23:38,400 --> 00:23:39,720
...هيبيكي