1
00:00:20,870 --> 00:00:25,290
الشّخصيّات والأحداث مِن وحي تأليف : آراكي هيروهيكو

2
00:00:20,870 --> 00:00:25,290
(نشرتها مجلة شوويشا جامپ للقصص المصوَّرة)

3
00:00:26,380 --> 00:00:30,800
الرّئيس التّنفيذيّ  :         توريومي هيسايوكي

4
00:00:31,650 --> 00:00:48,390
باوه

5
00:00:40,370 --> 00:00:48,390
الـضّـيـف

6
00:01:08,310 --> 00:01:09,420
"نوتسو"

7
00:02:22,700 --> 00:02:28,120
درجة حرارة الجسم: 15,7 درجة مئوية
معدّل نبضات القلب: نبضة واحدة لكلّ 68 دقيقة

8
00:02:29,770 --> 00:02:32,040
يَظهر أنّكم تواجهون بعض المتاعب

9
00:02:33,000 --> 00:02:37,000
!"باوه" هكذا ينبغي أنْ تكون حالة ،"كاسومينومي" دكتور

10
00:02:37,010 --> 00:02:40,220
أشرتُ إلى الفتاة الفارّة مِن العربة رقم 8

11
00:02:40,550 --> 00:02:42,970
أَلمْ ترد أيّ أنباءٍ عن أَسْرِها؟

12
00:02:42,990 --> 00:02:48,990
،نعم، فتلك الفتاة تملك قوّة غريبة
!المتاعب "سوفين" مُرجّح أنْ تواجه

13
00:02:49,100 --> 00:02:53,920
منظّمتنا في أمسّ الاِحتياج إليها؛
!لاِمتلاكها تلك القوّة الغريبة

14
00:02:54,000 --> 00:03:00,290
؛"منظّمة دوريس" بأكفأ أعضاء "سوفين" وليست
!إنْ أوقعتْها ذات التّاسعة في حَيْص بَيْص

15
00:03:01,050 --> 00:03:02,450
مَنْ دخل دون إذنٍ؟

16
00:03:03,000 --> 00:03:04,370
!إنّها أنتِ

17
00:03:06,330 --> 00:03:10,190
،أُعربُ عن أسفي الشّديد
!لأنّي حسبتُها طفلة عاديّة

18
00:03:10,860 --> 00:03:15,250
،"سوميري-تشان" انتهتْ فترة تجوالنا يا
دعينا نعُد إلى عربة الرّكاب

19
00:03:15,270 --> 00:03:16,800
حانَ وقت تناول وجبة خفيفة

20
00:03:16,810 --> 00:03:17,920
!لا

21
00:03:18,620 --> 00:03:23,210
،لنْ أُبلغ المقرّ الرّئيسيّ بذلك
!أبعِديها عن هنا بسرعة

22
00:03:25,360 --> 00:03:26,640
!لا

23
00:03:26,950 --> 00:03:33,140
باب العربة كان موصدًا بإحكام مهما حَدَث
،حتّى نَصِلَ إلى وجهتنا

24
00:03:33,150 --> 00:03:35,280
،ولكنّها استطاعتْ فَتحه بلا أيّ عناء

25
00:03:35,290 --> 00:03:38,770
!لقد قَرَأَتْ أرقام قفل الباب إذًا

26
00:03:39,450 --> 00:03:43,280
،فهمتُ الآن مَقصد المقرّ الرّئيسيّ منها كمادةٍ بحثيّة

27
00:03:43,290 --> 00:03:45,650
!ستكون نِعْمَ العون للعمليّات الاِستخباراتيّة

28
00:03:50,800 --> 00:03:52,540
!"الكپسولة" المياه تتسرّب مِن

29
00:03:53,950 --> 00:03:56,170
!أغلِقي ذلك الصِّمام

30
00:03:58,700 --> 00:04:00,990
،هذا ليس بالقَدْرِ الكافي مِن المياه
!أضيفوا المزيد

31
00:04:15,250 --> 00:04:18,120
!استمرّوا بالضّغط، اضغطوا على الغِطاء

32
00:04:18,130 --> 00:04:19,990
!وإلّا وقعتْ بنا نائِبة

33
00:04:23,100 --> 00:04:25,740
هل أغلقتِ الصِّمام كما أمرتُ؟

34
00:05:21,550 --> 00:05:23,000
!وَيْلاه

35
00:05:23,010 --> 00:05:24,410
!اغلقي الباب

36
00:05:24,420 --> 00:05:26,660
!يجدر بنا ألّا يغادر عربة الشّحن هذه

37
00:05:26,680 --> 00:05:27,700
!أَمسِكوا به

38
00:05:33,500 --> 00:05:35,940
!أيّتها الحقيرة
!لقد فَكَكْتِ العربات

39
00:06:10,010 --> 00:06:12,460
!أوقِـفـــوه
!عن هنا "باوه" إيّاكم أنْ يبتعد

40
00:06:20,000 --> 00:06:23,370
!إنّه لأمرٌ مُريع
!"باوه" فلقد أيقظنا

41
00:06:23,750 --> 00:06:28,280
!؛ كإطلاق قنبلةٍ ذريّة"باوه" وصحوة

42
00:06:29,000 --> 00:06:30,850
!إنّه يتأهّب للقفز

43
00:06:31,070 --> 00:06:32,720
ليس لدينا خيارٌ سوى قتله

44
00:06:32,730 --> 00:06:35,190
مصدر اهتمام للعامّة "باوه" يجب ألّا يكون

45
00:06:35,200 --> 00:06:37,870
!لنْ يصعب عليكم قتله بهيئته الحاليّة، فأَرْدُوه

46
00:07:29,970 --> 00:07:32,730
حسنٌ، هل تذكّرتَ أيّ شيء؟

47
00:07:33,530 --> 00:07:37,220
،وَصلاتٌ مفكّكة
،عربة شحنٍ انحرفتْ عن مسارها

48
00:07:37,240 --> 00:07:40,730
،تعطّل جداول القطارات
،هذا ما كُتِبَ في الصّحف

49
00:07:40,770 --> 00:07:45,030
!حتّى الجثّة على القضبان تكتّموا أمرها

50
00:07:46,780 --> 00:07:47,650
!تفضل

51
00:07:53,060 --> 00:07:56,440
ماذا يريدون منّا؟

52
00:07:57,170 --> 00:08:01,140
:كما أخبرتك آنفًا
..."دوريس" اسم منظّمتهم

53
00:08:01,880 --> 00:08:06,060
،أجهَلُ ما يوارونه
لكنّهم مُنكَبُّون على إجراء التّجارب المُريبة

54
00:08:06,880 --> 00:08:09,550
؟"إكورُو" أَلا تذكر حقًّا أيّ شيء يا

55
00:08:09,800 --> 00:08:10,950
نعم، لا أذكر

56
00:08:34,370 --> 00:08:37,120
أليس كذلك؟ ،"سوميري-تشان" قلتِ إنّ اسمكِ

57
00:08:37,140 --> 00:08:39,630
،بلى
!أعلَم أنّ وقعه يبدو غريبًا

58
00:08:39,640 --> 00:08:43,220
ما كان لي اسم؛
فأَسمَتْنيه إحدى سيداتِ دار الأيتام

59
00:08:43,270 --> 00:08:44,060
!ماذا؟

60
00:08:44,330 --> 00:08:48,990
وَاْ! أَلمْ أخبرك بأنّي ترعرعتُ في دار الأيتام؟

61
00:08:49,300 --> 00:08:52,090
،كانت تفوح مِن حديقة دار الأيتام رائحة البنفسج

62
00:08:52,100 --> 00:08:54,950
!"سو .. ميـ .. ـري" اسم "زهرة البنفسج" ويُرادف

63
00:08:55,140 --> 00:08:58,880
كيف إذنْ آلَ بكِ الحال مِن دار الأيتام إلى المنظّمة؟

64
00:08:59,100 --> 00:09:01,540
،حسنٌ، بكلّ وِدٍّ أرسلني مدير دار الأيتام إليهم

65
00:09:01,550 --> 00:09:04,910
"قائلًا: "ستُنَعَّمين برَغدِ العيش في كَنفِهم

66
00:09:04,920 --> 00:09:07,570
وكذلك أعطاني بعض المال

67
00:09:18,800 --> 00:09:20,330
ما الخطب؟

68
00:09:23,300 --> 00:09:26,170
!بإمكاني التَّبَصُّر
...أستطيع تَبَصُّر الأمر

69
00:09:41,140 --> 00:09:42,270
!"باوه"

70
00:09:42,350 --> 00:09:48,600
بالحقّ، أَلمْ يكُن ذلك ما يدعونك به
؟"إكورُو" في القطار يا

71
00:09:48,620 --> 00:09:49,690
!"باوه"يدعونني بـ

72
00:09:52,600 --> 00:09:58,330
،"الإدراك السَّبقيّ" وُهِبتُ قدرة
مِن دار الأيتام طمعًا فيها "منظّمة دوريس" فأخذتْني

73
00:09:59,000 --> 00:10:00,950
...إنّهم على مقرُبة منّا

74
00:10:00,980 --> 00:10:01,660
!"إكورُو"

75
00:10:13,550 --> 00:10:15,960
!"إكورُو" احترس .. يا

76
00:10:22,370 --> 00:10:23,760
!"نوتسو"

77
00:10:30,200 --> 00:10:32,100
!يا هذا

78
00:10:32,230 --> 00:10:33,400
ماذا؟

79
00:10:33,600 --> 00:10:35,670
...هذه الدرّاجة

80
00:10:37,110 --> 00:10:39,360
!أَعِرْنِيها...

81
00:10:44,950 --> 00:10:48,290
!أسرِعي واركبي .. "سوميري"

82
00:10:53,500 --> 00:10:55,150
...إنّها لـ

83
00:10:57,800 --> 00:10:59,450
!ـدرّاجتي...

84
00:11:02,170 --> 00:11:03,190
!بئسًا

85
00:11:15,590 --> 00:11:19,580
ماذا قلت؟
أَتلك الفتاة معه؟ وماذا في ذلك؟

86
00:11:19,620 --> 00:11:23,160
إنْ مَثّلتْ عقبةً لإكمالك المهمّة؛

87
00:11:21,000 --> 00:11:23,160
فاُقتلها أيضًا

88
00:11:23,300 --> 00:11:26,590
!أَصغِ إليّ، لقد نجا مِن صعقٍ كهربائيّ لخطوط القطار

89
00:11:26,600 --> 00:11:28,350
!فلا نعلَم يقينًا ماذا سيحدث تاليًا

90
00:11:28,370 --> 00:11:31,930
التَّسلُّح الظّاهِرة

91
00:11:28,370 --> 00:11:31,930
"قَبل أولى تحوُّلاته؛ "التَّسلُّح الظّاهِرة "باوه" يتحتّم تصفية

92
00:11:31,940 --> 00:11:35,630
وفور قتلك إيّاه؛
!اُحرق جثّته حتّى تصير رمادًا

93
00:11:36,150 --> 00:11:38,030
أَأحرقه حتّى تصير عظامه رمادًا؟

94
00:11:38,050 --> 00:11:41,120
!أطنَبتَ في الحديث عن .. ذلك الفتى

95
00:11:46,430 --> 00:11:47,480
،"دوردو" العقيد

96
00:11:47,490 --> 00:11:50,880
؟"إكورُو" أَبوسع رجلٌ واحد مطاردة

97
00:11:50,900 --> 00:11:52,360
،لا تشتدّ بك الهواجس

98
00:11:52,370 --> 00:11:58,040
الأبرع في وحدتنا "رقم 22" يُعدّ
باستخدام جميع أنواع التّقنيّات

99
00:11:58,050 --> 00:12:01,960
،ثِقْ أنّه سيعثر عليه
!ومِن ثَمَّ سيمحقه في الوقت المحدّد

100
00:12:01,990 --> 00:12:03,550
،حالنا يُرثى له

101
00:12:03,560 --> 00:12:08,270
"باوه" لنخسر أحدَث النّسخ المكتملة مِن
ونحن في طريقنا إلى المقرّ الرّئيسيّ

102
00:12:08,290 --> 00:12:12,900
،طالما سنبقي أمورنا في طيّ الكتمان
فقتْله أمرٌ حتميّ

103
00:12:12,910 --> 00:12:14,510
،"كاسومينومي" يا

104
00:12:14,520 --> 00:12:17,290
،انسَ موضوع الفتى الهارب

105
00:12:17,850 --> 00:12:22,400
"باوه"اجتمعنا لكيْ نتحقّق مِن ابتكارك لـ

106
00:12:22,420 --> 00:12:25,400
فواصل الإدلاء ببراهينك

107
00:12:30,770 --> 00:12:33,180
؟"باوه" أَهذا الكلب أيضًا نُسخة مِن

108
00:12:33,700 --> 00:12:35,290
!فَرِّغي الخزان مِن المياه

109
00:12:38,070 --> 00:12:43,310
بتسريع تطوّره تحت ظروفٍ معيّنة "باوه" ابتكرتُ

110
00:12:43,320 --> 00:12:45,340
رغم ذلك، لا يزال في المرحلة التّجريبيّة

111
00:12:45,350 --> 00:12:51,950
أمّا إنْ استطعنا التّحكّم في شكلهِ الحيويّ؛
سنتبوّأ منزلةً أمام العالَم برمّته طبيًّا لا سيّما عسكريًّا

112
00:12:51,960 --> 00:12:56,490
برأس المال "دوريس" ولذلك تحديدًا نمدّ

113
00:12:59,070 --> 00:13:03,320
منذ يومَين "باوه" إلى "إكورُو هاشيزاوا" صارَ الصّبيّ

114
00:13:03,340 --> 00:13:08,280
"باوه" في حين، قد مضى شهرٌ مُذْ حوّلنا هذا الكلب إلى

115
00:13:08,290 --> 00:13:09,810
وهل هنالك فَرق؟

116
00:13:09,820 --> 00:13:13,330
إذْ تعظُم قوّته بمرور الأيّام

117
00:13:13,450 --> 00:13:16,860
،لنْ تروها بسبب الفراء
إنّما تشوبه تشوّهات على جلده

118
00:13:16,870 --> 00:13:21,690
،حسبما أتصوّر، فإنّ وجه الفتى وأطرافه مغطاةٌ بالتّقرّحات

119
00:13:21,710 --> 00:13:27,570
في إفرازاته "باوه" إذْ يكمن سرّ

120
00:13:21,710 --> 00:13:27,570
إفرازاته

121
00:13:25,100 --> 00:13:27,570
وتأثيراتها

122
00:13:25,100 --> 00:13:27,570
تأثيراتها

123
00:13:35,430 --> 00:13:37,170
!ها قد استيقظ الكلب

124
00:13:45,880 --> 00:13:48,090
![E-13] افتحي الباب

125
00:13:48,380 --> 00:13:50,270
!عُلم ويُنفّذ

126
00:14:22,630 --> 00:14:25,750
ما هذا؟
!تهاوى بلا أدنى مقاومة

127
00:14:25,780 --> 00:14:27,700
،رجاءً راقبوا بعناية

128
00:14:27,710 --> 00:14:33,410
،فور تعرّض جسده للهجوم
"باوه"فتتجلّى القوّة التّدميريّة لـ

129
00:14:33,430 --> 00:14:34,470
!ماذا؟

130
00:14:48,850 --> 00:14:55,400
،بصدد تحوّل التّسليح "باوه" إنّ
!"ألا وهو "التَّسلُّح الظّاهِرة

131
00:14:48,950 --> 00:14:55,400
التَّسلُّح الظّاهِرة

132
00:15:12,400 --> 00:15:13,900
نحن بأمان

133
00:15:13,960 --> 00:15:17,000
!"نوتسو" لا تنفّض ذيلك عليَّ يا

134
00:15:18,200 --> 00:15:19,830
أَمعكِ .. مال؟

135
00:15:21,700 --> 00:15:23,250
هذا ما لديّ

136
00:15:23,270 --> 00:15:24,870
وهذا سيَفِي بالغرض

137
00:15:25,240 --> 00:15:26,280
!"إكورُو"

138
00:15:26,700 --> 00:15:29,400
كيف حال جُرح معدتك؟

139
00:15:32,400 --> 00:15:33,620
!لقد اختفى

140
00:15:33,640 --> 00:15:34,580
!ماذا؟

141
00:15:45,560 --> 00:15:48,140
...بَعد إذنكم، هل لديكم وقود

142
00:16:06,110 --> 00:16:07,230
!"إكورُو"

143
00:16:17,250 --> 00:16:18,210
!"إكورُو"

144
00:16:18,230 --> 00:16:19,540
!حسبك

145
00:16:24,110 --> 00:16:26,800
لماذا .. أنا؟

146
00:16:29,250 --> 00:16:34,770
،متبقي حرق جثّته
!يا له مِن أمرٍ غاية في السّهولة

147
00:17:13,140 --> 00:17:14,930
!ما هذا؟

148
00:17:21,140 --> 00:17:22,170
!مستحيل

149
00:17:35,500 --> 00:17:39,280
"باوه"هذا ما يُعرف بـتحوّل التّسليح لـ

150
00:17:35,500 --> 00:17:39,280
تحوّل التّسليح

151
00:18:05,250 --> 00:18:07,600
...هذا لا يُعقل

152
00:19:23,100 --> 00:19:26,400
،"دوردو" كما المعتاد مِن
نَسَفَ رأسه بطلقةٍ واحدة

153
00:19:26,410 --> 00:19:30,780
:"باوه" أول خطوةٍ لمَحق

154
00:19:28,850 --> 00:19:30,780
الفتك بدماغه

155
00:19:30,810 --> 00:19:35,000
.. ومِن بَعدها

156
00:19:55,710 --> 00:19:57,100
،وَضح الأمر

157
00:19:57,110 --> 00:20:00,450
،كيفما نشاء "باوه" إذا سخّرنا قوّة

158
00:20:00,460 --> 00:20:04,910
لنتغلَّبنّ على بلدان العالَم أجمع بلا ريْب

159
00:20:04,940 --> 00:20:09,180
!استعدّوا وراقبوا يا سادة
!فإنّها تكاد تَظهر أخيرًا

160
00:20:09,190 --> 00:20:11,990
!ماذا؟
ما التي ستظهر؟

161
00:20:30,020 --> 00:20:35,070
الدّودة الطّفيليّة ؛"باوه" يا سادة إنّها
التي كانت تعيش في دماغ الكلب

162
00:20:35,080 --> 00:20:40,330
"دودة باوه" فالقوّة التّدميريّة المرعبة تنبعث مِن

163
00:20:43,480 --> 00:20:47,380
؛ حرقها حتّى الموت"دودة باوه" السّبيل الوحيد للتخلّص مِن

164
00:20:48,300 --> 00:20:54,270
"إكورُو هاشيزاوا" أمّا الفتى الهارب مِن القطار؛
فما برأسه لا تزال يَرقةً

