1
00:01:20,070 --> 00:01:21,980
.توفيّ شقيقي التّوأم

2
00:01:44,280 --> 00:01:46,290
أنت، ماذا حدث لك؟

3
00:01:50,160 --> 00:01:51,790
هل أنت بخير؟

4
00:01:57,850 --> 00:01:59,740
.أنا بخير

5
00:01:59,740 --> 00:02:01,500
.تبدو أجشّ الصّوت

6
00:02:02,750 --> 00:02:05,300
.قد نكون في فصل الصّيف، لكنّ اللّيالي ما تزال باردة

7
00:02:05,900 --> 00:02:07,560
ما هو اسمك؟

8
00:02:08,000 --> 00:02:10,460
.لا أعرف

9
00:02:10,460 --> 00:02:12,470
.يجب أن آخذك إلى المستشفى أولاً

10
00:02:13,480 --> 00:02:16,570
!مهلاً، تماساك أيّها الفتى

11
00:02:57,380 --> 00:02:59,320
.لا ينبغي أن تنام هكذا

12
00:03:02,440 --> 00:03:03,240
.صباح الخير

13
00:03:09,760 --> 00:03:11,930
.يبدو أنّ الحقنة قد أتت مفعولها

14
00:03:11,930 --> 00:03:14,960
إن تحسّنت حالتك قليلاً فربّما سترغب بتناول شيءٍ ما؟

15
00:03:14,960 --> 00:03:16,750
.أ-أجل

16
00:03:26,890 --> 00:03:29,280
.لديّ الخبز أيضًا إن رغبت بأكله

17
00:03:29,280 --> 00:03:31,120
.شكرًا لك، هذا يكفيني

18
00:03:31,120 --> 00:03:32,400
.فهمت

19
00:03:39,050 --> 00:03:42,710
.المعذرة، ذاكرتي مشوّشة

20
00:03:42,710 --> 00:03:44,650
هل أخذتني إلى المستشفى؟

21
00:03:44,650 --> 00:03:45,640
.أجل

22
00:03:45,640 --> 00:03:48,520
.آسفٌ لجعلك تقوم بذلك

23
00:03:48,520 --> 00:03:51,380
.من الطبيعيّ مدّ يد المساعدة لمن يحتاجها

24
00:03:57,650 --> 00:03:58,810
.إنّه لذيذ

25
00:03:59,640 --> 00:04:00,640
.جيّد

26
00:04:11,210 --> 00:04:12,830
.لستَ مجبرًا على أكله

27
00:04:12,830 --> 00:04:15,100
.لا، سآكله على مهل

28
00:04:17,100 --> 00:04:20,020
أهناك شيءٌ تستطيع تذكّره؟

29
00:04:20,020 --> 00:04:24,120
،حسنٌ، أخذتني إلى المستشفى

30
00:04:24,120 --> 00:04:27,370
...وقبل ذلك كنتُ نائمًا على الشّاطئ

31
00:04:28,000 --> 00:04:31,120
ولماذا كنتَ مستلقيًا هناك أساسًا؟

32
00:04:32,020 --> 00:04:35,220
...أتساءل لماذا

33
00:04:35,220 --> 00:04:38,510
إذًا فأنت لا تتذكّر أيّ شيءٍ سبق ذلك؟

34
00:04:38,510 --> 00:04:40,930
...حسنٌ

35
00:04:46,390 --> 00:04:47,260
.أجل

36
00:04:48,310 --> 00:04:49,640
...ربّما

37
00:04:49,920 --> 00:04:53,030
.من المزعج عدم تذكّرك لاسمك

38
00:04:53,030 --> 00:04:54,610
!أراشي-كُن

39
00:05:01,650 --> 00:05:03,200
.شكرًا

40
00:05:03,200 --> 00:05:05,350
مهلاً، من هذا؟

41
00:05:05,350 --> 00:05:08,100
.التقطته البارحة على الشّاطئ

42
00:05:08,100 --> 00:05:09,450
.ولا يملك اسمًا بعد

43
00:05:09,450 --> 00:05:15,120
...التقطته"؟ إنّه ليس قِطًا بلا مأوى كما تعلم"

44
00:05:18,150 --> 00:05:20,290
أنت، من أين أتيت؟

45
00:05:20,610 --> 00:05:21,830
...حسنًا

46
00:05:23,250 --> 00:05:26,340
.لقد فقد ذاكرته يا ناتسكو-سان

47
00:05:27,430 --> 00:05:30,060
فقد ذاكرته؟ هل أخذته إلى المستشفى؟

48
00:05:30,060 --> 00:05:32,310
...فعلت، لكن

49
00:05:32,310 --> 00:05:35,940
.حسنٌ، سأستضيفه إلى أن يتعافى من الزّكام

50
00:05:35,940 --> 00:05:38,250
...ماذا عساي أقول

51
00:05:38,250 --> 00:05:40,850
.يبدو أنّك قاسيت الكثير

52
00:05:40,850 --> 00:05:43,120
.تناول طعامك لتتحسّن

53
00:05:43,120 --> 00:05:44,030
.أجل

54
00:05:47,410 --> 00:05:50,820
إذًا فهو لا يتذكّر اسمه؟

55
00:05:50,820 --> 00:05:55,200
.أجل، لذا كنتُ أفكّر بتسميّته

56
00:05:55,200 --> 00:05:58,040
.كما سبق وقلت، إنّه ليس قِطًا بلا مأوى

57
00:05:58,040 --> 00:05:59,440
.اعتبري ذلك كلقب

58
00:05:59,440 --> 00:06:01,470
...وإن يكن

59
00:06:01,470 --> 00:06:03,060
ما رأيكِ بالغراب؟

60
00:06:03,060 --> 00:06:05,490
.إن كنّا نتحدّث عن الطّيور فالنّورس سيكون أفضل

61
00:06:06,860 --> 00:06:09,140
.أنت. مهلاً أنت

62
00:06:10,340 --> 00:06:14,010
كاسمٍ لك، أنت تفضّل "النّورس" على "الغراب"، صحيح؟

63
00:06:14,010 --> 00:06:17,800
.نورس؟ حسنًا، إنّه أفضل من الغراب على الأقل

64
00:06:17,800 --> 00:06:20,880
أهكذا تجازيني على إحساني لك؟

65
00:06:20,880 --> 00:06:22,140
.آسف

66
00:06:22,790 --> 00:06:24,990
لكن لماذا تختاران من بين الطّيور أساسًا؟

67
00:06:24,990 --> 00:06:27,310
لماذا يا ترى؟

68
00:06:27,310 --> 00:06:28,330
.حسنًا، كفانا من هذا

69
00:06:28,330 --> 00:06:32,870
هل تفضّل الحساء مع الميسو أم صلصة الصّويا أم الملح؟

70
00:06:32,870 --> 00:06:34,620
.ا-الملح

71
00:06:34,620 --> 00:06:36,410
.فهمت

72
00:06:36,410 --> 00:06:38,410
.إذًا اسمك سيكون شييو

73
00:06:38,410 --> 00:06:41,560
!ماذا؟! من المحال أن يرغب بذلك

74
00:06:41,560 --> 00:06:43,180
.إنّه أفضل من الغراب على الأقل

75
00:06:43,180 --> 00:06:44,300
ماذا؟

76
00:06:58,290 --> 00:07:01,810
.يُدير أراشي-سان هذا المطعم بنفسه

77
00:07:04,390 --> 00:07:07,680
وناتسكو-سان تسلّم له الخضروات

78
00:07:07,680 --> 00:07:10,650
.التي يبيعها أبواها في منطقة التّسوّق

79
00:07:13,440 --> 00:07:16,650
.هذا المكان يدعى مطعم قناديل البحر

80
00:07:20,460 --> 00:07:22,980
.سأظلّ مقيمًا معه لفترةٍ أطول قليلاً

81
00:07:24,300 --> 00:07:25,750
.لبعض الوقت فقط

82
00:08:04,590 --> 00:08:05,900
أتستمتع بوقتك؟

83
00:08:06,540 --> 00:08:08,450
.مرحبًا بعودتك

84
00:08:09,350 --> 00:08:10,550
.لقد عدت

85
00:08:23,920 --> 00:08:24,970
كيف تشعر؟

86
00:08:24,970 --> 00:08:27,580
.أفضل بكثير

87
00:08:28,340 --> 00:08:29,690
.شكرًا جزيلاً لك

88
00:08:31,000 --> 00:08:32,080
.فهمت

89
00:08:36,510 --> 00:08:37,430
...معذرة

90
00:08:37,430 --> 00:08:38,250
ماذا؟

91
00:08:39,660 --> 00:08:43,040
أيمكنني مساعدتك في المطعم اليوم؟

92
00:08:44,670 --> 00:08:48,610
.لقد اعتنيتَ بي، لذا أريد ردّ الجميل

93
00:08:50,020 --> 00:08:53,920
.أستطيع التّنظيف أو حمل الصّحون أو غسلها

94
00:08:54,670 --> 00:08:55,860
.حسنًا

95
00:09:02,130 --> 00:09:03,560
.رائع

96
00:09:05,860 --> 00:09:07,060
.مـ-مرحبًا

97
00:09:10,570 --> 00:09:12,160
.عجّة البيض مع الأرز

98
00:09:12,160 --> 00:09:12,950
.وأنا أيضًا

99
00:09:12,950 --> 00:09:15,070
.طبق اليوم، السّمك مع الخضار

100
00:09:37,350 --> 00:09:39,220
.هذا المكان أصبح مزدحمًا

101
00:09:39,960 --> 00:09:41,050
هل تفاجأت؟

102
00:09:41,680 --> 00:09:43,350
.لم أعد كذلك

103
00:09:44,060 --> 00:09:45,090
.فهمت

104
00:10:10,930 --> 00:10:13,840
.هذا ممتعٌ نوعًا ما

105
00:10:15,880 --> 00:10:17,400
.أقصد العمل هنا

106
00:10:19,590 --> 00:10:20,610
.هكذا إذًا

107
00:10:28,410 --> 00:10:30,320
.شييو-كُن

108
00:10:30,920 --> 00:10:32,300
أتشعر بتحسّن؟

109
00:10:32,300 --> 00:10:33,650
.أجل

110
00:10:34,200 --> 00:10:36,930
أنتم اليوم تعدّون عجّة البيض مع الأرز، صحيح؟

111
00:10:36,930 --> 00:10:39,910
.في الواقع أنا أيضًا كنتُ أفكّر بأنّ البيض يبدو لذيذًا

112
00:10:42,000 --> 00:10:43,800
.يجب أن تأكل شيئًا ما أيضًا

113
00:10:44,360 --> 00:10:45,530
هل ترغب بنفس الطّبق أيضًا؟

114
00:10:45,530 --> 00:10:46,490
.أجل

115
00:10:46,490 --> 00:10:49,420
.فلنتناول الطّعام معًا يا شييو-كُن

116
00:11:08,930 --> 00:11:10,840
إلى أين أنت ذاهبٌ في هذا الوقت المتأخّر؟

117
00:11:15,550 --> 00:11:18,240
هل أنت عائدٌ إلى منزلك؟

118
00:11:18,240 --> 00:11:20,270
.أ-أنت مخطئ

119
00:11:20,270 --> 00:11:21,380
...لن أعود للمنزل

120
00:11:22,260 --> 00:11:26,740
.لا أعلم حتى أين سأذهب

121
00:11:28,840 --> 00:11:30,160
.هكذا إذًا

122
00:11:53,120 --> 00:11:54,140
.أراشي-سان

123
00:11:55,210 --> 00:11:56,170
ما الأمر؟

124
00:11:57,320 --> 00:12:01,440
أنا آسف. لقد كذبت

125
00:12:02,900 --> 00:12:06,010
.لم أفقد ذاكرتي

126
00:12:08,220 --> 00:12:10,180
.أجل، أعلم ذلك

127
00:12:15,010 --> 00:12:18,920
هل هربتَ من المنزل وحاولتَ إغراق نفسك في المحيط؟

128
00:12:22,200 --> 00:12:23,550
.لا أعلم

129
00:12:23,550 --> 00:12:26,810
.لكنّي أردتُ تجربة شعورٍ معيّن

130
00:12:26,810 --> 00:12:29,220
.شعور طبيعيّ من شأنه أن يجعلني أرغب بالاستمرار في الحياة

131
00:12:29,220 --> 00:12:32,220
،لكي أدرك أنّ الحياة أكثر من مجرّد محاولةٍ للنّجاة

132
00:12:32,220 --> 00:12:34,440
.لكنّي لم أشعر بذلك إطلاقًا

133
00:12:35,310 --> 00:12:36,520
.فهمت

134
00:12:43,390 --> 00:12:48,140
.في الشّهر الماضي انتحر شقيقي التّوأم

135
00:12:48,140 --> 00:12:51,250
.طعن نفسه في معدته بسكيّن مطبخ

136
00:12:53,540 --> 00:12:57,450
.كنّا متشابهان. حتى أنّنا كنّا نمتلك نفس الملامح

137
00:12:59,840 --> 00:13:03,600
.لم أستطع تفهّم لماذا أقدم على الانتحار

138
00:13:04,950 --> 00:13:11,480
.أعلم أنّ الهرب من المنزل قد يبدو أمرًا سخيفًا بالنّسبة لك

139
00:13:12,170 --> 00:13:14,870
.وربّما تعتقد أنّه سببٌ واهٍ للهرب بعيدًا

140
00:13:17,490 --> 00:13:20,090
،حتى لو كان ذلك سيبدو سخيفًا لغريبٍ مثلي

141
00:13:20,090 --> 00:13:23,240
فهو قارارٌ مهم بالنّسبة لك، صحيح؟

142
00:13:23,500 --> 00:13:26,240
.حسنًا، أنت محقّ

143
00:13:26,590 --> 00:13:29,740
إذًا لماذا تهتمّ بما يعتقده الآخرون؟

144
00:13:42,430 --> 00:13:43,780
سمعتُ

145
00:13:43,780 --> 00:13:45,260
.ما قالته والدتي

146
00:13:46,320 --> 00:13:49,760
.أنّ النّظر إليّ يجعلها تتألّم لأن ذلك يذكّرها بأخي

147
00:13:50,580 --> 00:13:55,220
.لا أعرف لماذا، لكنّي شعرتُ أنّ تلك الكلمات طعنت قلبي

148
00:13:56,230 --> 00:13:59,520
.كان ذلك مؤلمًا لدرجةٍ جعلتني أهرب من المنزل

149
00:14:00,630 --> 00:14:03,360
.ليس وكأنّ الحزن لم يعتريني أيضًا

150
00:14:06,960 --> 00:14:09,940
لكن سماع شيءٍ من ذلك القبيل

151
00:14:11,120 --> 00:14:14,070
.جعلني أشعر أنّي مثيرٌ للشّفقة

152
00:14:18,800 --> 00:14:22,580
،شعرتُ كما لو أنّ حزني لم يكن خالصًا

153
00:14:23,440 --> 00:14:25,300
.ولم أستطع تحمّل ذلك

154
00:14:26,340 --> 00:14:32,010
.معرفتي بأنّه لن يعود أبدًا جعلني في غاية الحزن

155
00:14:43,140 --> 00:14:45,360
ألستَ تنحب الآن حزنًا عليه؟

156
00:14:50,380 --> 00:14:52,890
.أنت حزينٌ بما يكفي

157
00:15:08,520 --> 00:15:10,100
،إن كنتَ تتساءل لِم أتيتُ إلى هنا

158
00:15:10,690 --> 00:15:12,220
.فما من سببٍ محدّد

159
00:15:12,220 --> 00:15:14,130
.نزلت فقط من القطار لأنّني رأيتُ البحر

160
00:15:14,860 --> 00:15:16,430
.كان بالإمكان أن يكون أيّ مكان

161
00:15:17,650 --> 00:15:19,820
.في البدأ تقبل تواجدك بأيّ مكان

162
00:15:20,830 --> 00:15:26,380
.لكن سرعان ما تبدأ في التّعلّق بالمكان الذي انتهى بك المطاف إليه

163
00:15:26,380 --> 00:15:28,890
.إنّه شيءٌ مبهجٌ جدًا

164
00:15:30,250 --> 00:15:34,740
.في الحقيقة، أنا مثلك أيضًا، انتهى بي المطاف هنا لأنّ أحدهم استضافني عنده

165
00:15:34,740 --> 00:15:35,450
ماذا؟

166
00:15:36,520 --> 00:15:38,460
أنا وأخي

167
00:15:38,460 --> 00:15:41,710
.استيقظنا مستلقيان على الشّاطئ

168
00:15:41,980 --> 00:15:46,100
.وجدنا رجلٌ مسنّ يدير هذا المطعم

169
00:15:46,100 --> 00:15:48,120
...مثلي تمامًا

170
00:16:01,060 --> 00:16:02,550
ما الذي تفعله؟

171
00:16:08,830 --> 00:16:10,030
.شاهد فحسب

172
00:16:35,990 --> 00:16:39,220
ما... هذا؟

173
00:16:44,590 --> 00:16:47,390
ما... هذا؟

174
00:16:49,050 --> 00:16:50,240
.قنديل بحر

175
00:16:51,110 --> 00:16:53,520
.أنا مصابٌ بمتلازمة قناديل البحر

176
00:16:54,250 --> 00:16:56,500
،عندما تلامس بشرتي الماء

177
00:16:56,500 --> 00:16:59,120
.يصبح جسدي مثل قنديل البحر

178
00:17:00,640 --> 00:17:03,120
.على الرّغم من أنّه يؤثر فقط على الجانب الأيسر من صدري في الوقت الرّاهن

179
00:17:03,650 --> 00:17:06,920
.فقد يصل تدريجيًا إلى ذراعاي وساقاي أيضًا

180
00:17:06,920 --> 00:17:08,740
داء!؟

181
00:17:08,740 --> 00:17:11,420
!لم أسمع بداءٍ مثل هذا من قبل

182
00:17:12,510 --> 00:17:15,130
انتهى الأمر بأخي أن غطىّ الدّاء سائر جسده

183
00:17:15,130 --> 00:17:16,680
.وفي النّهاية اختفى

184
00:17:18,930 --> 00:17:21,680
اختفى؟

185
00:17:21,680 --> 00:17:25,900
.أفترض من ردّ فعلك أنّك لستَ مثلي

186
00:17:28,550 --> 00:17:31,290
.أردتُ التّأكّد فحسب

187
00:17:31,290 --> 00:17:34,920
.بعد طلوع الشّمس، استقلّ القطار وعُد إلى منزلك

188
00:17:35,810 --> 00:17:36,950
!لا أريد ذلك

189
00:17:38,510 --> 00:17:39,660
لماذا؟

190
00:17:39,890 --> 00:17:42,340
.أودّ البقاء هنا

191
00:17:42,340 --> 00:17:45,410
.لأنّني بدأتُ أتعلّق بهذا المكان

192
00:17:47,010 --> 00:17:50,060
.أنت تقول هذا ارتجالاً فقط

193
00:17:50,060 --> 00:17:52,380
!ومع ذلك، هذا ما أشعر به حقًا

194
00:18:02,200 --> 00:18:07,230
.على أيّ حال، ينبغي أن تُعلم عائلتك أنّك بخير

195
00:18:07,230 --> 00:18:09,230
...هذا

196
00:18:09,230 --> 00:18:13,310
.أنا لن أسمح لشخصٍ يهتمّ بنفسه فقط بالبقاء هنا

197
00:18:24,820 --> 00:18:26,920
هل تدخل إلى البحر كلّ صباح؟

198
00:18:29,060 --> 00:18:30,580
هل اتّصلت بهم؟

199
00:18:31,100 --> 00:18:32,760
.مازال الوقت مبكّرًا

200
00:18:34,130 --> 00:18:38,340
.يميل النّاس إلى مماطلة الأمور المزعجة

201
00:18:39,050 --> 00:18:41,640
إذًا لن أُجبر على العودة إلى المنزل إذا اتّصلتُ بهم؟

202
00:18:41,640 --> 00:18:46,640
.عودتك إلى المنزل من عدمها ليس شيئًا أستطيع ارغامك عليه

203
00:18:47,060 --> 00:18:48,140
...إذًا

204
00:18:48,140 --> 00:18:52,310
.لكن أنا لا أقول أنّي سأسمح لك بالبقاء هنا أيضًا

205
00:18:58,450 --> 00:18:59,990
!صباح الخير

206
00:19:06,460 --> 00:19:08,250
هل قطعتُ حديثكما؟

207
00:19:08,250 --> 00:19:10,800
.لا، لقد انتهينا تقريبًا

208
00:19:10,800 --> 00:19:11,850
إذًا، ماذا ستفعل؟

209
00:19:12,470 --> 00:19:13,890
.رسالة

210
00:19:13,890 --> 00:19:15,340
.سأكتب رسالة

211
00:19:20,610 --> 00:19:23,300
ماذا حدث؟ هل تشاجرتما؟

212
00:19:23,300 --> 00:19:25,340
...ليس شجارًا، لكن

213
00:19:25,340 --> 00:19:26,430
لكن؟

214
00:19:26,430 --> 00:19:31,310
...حسنًا، لكن أولاً يجب أن أعتذر عن شيء

215
00:19:31,310 --> 00:19:32,500
ما هو؟

216
00:19:34,470 --> 00:19:37,100
.لقد كذبتُ بشأن فقداني لذاكرتي

217
00:19:40,130 --> 00:19:42,630
ماذا!؟ حقًا!؟

218
00:19:42,630 --> 00:19:45,110
.أنا آسفٌ حقًا

219
00:19:45,110 --> 00:19:47,770
!فسّر الأمر قليلاً على الأقل

220
00:19:47,770 --> 00:19:51,250
مهلاً، أهذا ما جعل أراشي-كُن مستاءً؟

221
00:19:51,520 --> 00:19:54,930
...حسنٌ، تلك قضيّةٌ أخرى

222
00:19:54,930 --> 00:19:58,540
،أردتُ البقاء في مسكنه لفترةٍ أطول

223
00:19:58,540 --> 00:20:01,510
.لكنّه طلب منّي الاتصال بعائلتي لأبلغهم بأنّي بخير

224
00:20:01,510 --> 00:20:03,670
ألهذا السّبب ستكتب رسالة؟

225
00:20:03,670 --> 00:20:07,010
.إذًا سأفترض أنّك هربت من المنزل يا شييو-كُن

226
00:20:07,340 --> 00:20:10,360
.أودّ البقاء في هذه البلدة لفترةٍ أطول

227
00:20:10,360 --> 00:20:12,800
.في ذلك المطعم بالذّات

228
00:20:12,800 --> 00:20:13,980
.فهمت

229
00:20:16,570 --> 00:20:18,780
...ناتسكو-سان

230
00:20:18,780 --> 00:20:19,580
ماذا؟

231
00:20:20,980 --> 00:20:23,710
أتحبّين قناديل البحر يا ناتسكو-سان؟

232
00:20:27,660 --> 00:20:29,510
.أجل، أحبّها

233
00:20:29,510 --> 00:20:32,580
.إنّها جذّابة وجميلةٌ جدًا

234
00:20:34,830 --> 00:20:36,590
.إذًا فقد رأيتَ ذلك

235
00:20:36,830 --> 00:20:37,630
.أجل

236
00:20:39,970 --> 00:20:43,090
.أراني إيّاه أراشي-سان

237
00:20:48,910 --> 00:20:52,180
أتمانع إن أحضرتُ الخضار أولاً؟

238
00:20:52,180 --> 00:20:53,480
.سأساعدكِ

239
00:20:56,160 --> 00:20:59,680
.هذا الرّجل يساعد أراسي-كُن في مطعمه حاليًا

240
00:20:57,740 --> 00:21:01,490
أيمكنكِ أن تحدّثيني قليلاً عن شقيق أراشي-سان؟

241
00:20:59,680 --> 00:21:01,490
!إذًا فهذا هو

242
00:21:01,820 --> 00:21:04,400
.إذًا سأبدأ من البداية

243
00:21:05,340 --> 00:21:11,240
.ذلك المطعم كان في الأصل مِلكًا لرجلٍ مسنّ يدعى موتو تيتسوجي

244
00:21:11,240 --> 00:21:13,410
.شكرًا على الطّعام

245
00:21:11,970 --> 00:21:15,870
أعتقد أن ذلك مضى عليه عشرون سنةً تقريبًا

246
00:21:15,870 --> 00:21:19,000
.عندما ظهر أولئك الشّقيقان

247
00:21:20,150 --> 00:21:24,710
،أثناء عرضٍ للألعاب النّاريّة تسلّلتُ إلى المطعم

248
00:21:24,710 --> 00:21:28,010
.لأنّني أردتُ مشاهدة العرض من الطّابق الثّاني

249
00:21:28,780 --> 00:21:33,100
لكن ما شاهدته هناك كان حوض أسماكٍ ضخم

250
00:21:33,100 --> 00:21:35,700
.وصبيّ نائم يتمايل داخل الماء

251
00:21:36,730 --> 00:21:38,960
.كان أخ أراشي-كُن

252
00:21:38,960 --> 00:21:40,450
.كان اسمه ناغيسا-كُن

253
00:21:41,130 --> 00:21:45,280
،على الرّغم من أنّي كنتُ صغيرة إلا أنّني أدركتُ أنّه لم يكن طبيعيًا

254
00:21:45,520 --> 00:21:47,820
.لِذا لم أخبر أحدًا إطلاقًا

255
00:21:51,030 --> 00:21:56,970
.في البداية لم تظهر على ناغيسا-كُن أيّ أعراضٍ كالبشرة الشّفافة

256
00:21:57,600 --> 00:22:00,140
،لكن خلال الصيّف قبل عشر سنوات

257
00:22:00,140 --> 00:22:02,050
،توفيّ تيتسوجي

258
00:22:02,050 --> 00:22:04,050
.وورث ناغيس-كُن المطعم

259
00:22:04,870 --> 00:22:10,330
.في تلك المرحلة أصبحت بشرته بالفعل مثل قنديل البحر كلّما لامست الماء

260
00:22:09,700 --> 00:22:11,370
إلى أين نحن ذاهبان؟

261
00:22:11,370 --> 00:22:12,310
.إلى مكانٍ جميل

262
00:22:13,290 --> 00:22:15,310
،في البداية كان حول قلبه فقط

263
00:22:15,870 --> 00:22:19,310
.لكن في غضون ثلاث سنوات انتشر على كامل جسده

264
00:22:21,060 --> 00:22:27,040
.في النّهاية لم يستطع العيش خارج حوض الأسماك

265
00:22:28,320 --> 00:22:31,320
.أغلق المطعم لفترة من الزّمن

266
00:22:38,330 --> 00:22:42,020
،كان جسده كما لو كان مصنوعًا من الماء

267
00:22:42,670 --> 00:22:45,090
.لكنّي مازلتُ قادرةً على رؤية تعابير وجهه

268
00:22:46,070 --> 00:22:50,340
.اعتاد الابتسام كلّما جئتُ لرؤيته في حوض الأسماك

269
00:22:54,670 --> 00:22:58,970
.لقد كان ناغيسا-كُن الشّخص الذي وقعتُ في حبّه

270
00:22:59,610 --> 00:23:03,780
.وقد بادلني نفس الشّعور أيضًا

271
00:23:05,940 --> 00:23:10,590
،توفيّ ناغيسا، وتولّى أراشي إدارة المطعم

272
00:23:10,590 --> 00:23:13,370
...والآن نفس الأمر يحدث لأراشي-كُن

273
00:23:16,430 --> 00:23:20,630
.ليس وكأنّه لا يرغب ببقائك هنا

274
00:23:20,630 --> 00:23:22,010
.بل على النّقيض تمامًا

275
00:23:22,010 --> 00:23:25,080
.إنّه يحبّ أن يحاط به النّاس

276
00:23:26,440 --> 00:23:33,230
.لكن ربّما هو يعتقد أنّه من الطبيعيّ أن يتخلّى عنه النّاس

277
00:23:54,160 --> 00:23:56,190
هل أقفل مبكّرًا؟

278
00:23:56,190 --> 00:23:57,600
.إنّه حالك الظّلمة

279
00:23:57,600 --> 00:23:58,660
.بالفعل

280
00:24:07,670 --> 00:24:09,780
.سأتفقّد الطّابق الثّاني

281
00:24:11,680 --> 00:24:14,930
هل أنت هنا يا أراشي-سان؟

282
00:24:25,700 --> 00:24:26,940
ما الأمر؟

283
00:24:26,940 --> 00:24:28,450
.لا أعلم

284
00:24:28,450 --> 00:24:31,110
.لكنّني رأيتُ شيئًا أشبه بشخصٍ في البحر

285
00:24:40,420 --> 00:24:42,870
!أراشي-كُن! أراشي

286
00:24:45,630 --> 00:24:46,750
!ناتسكو-سان

287
00:24:46,940 --> 00:24:49,230
!الصّخور تملأ المكان، من الخطير أن تذهبي حافيّة القدمين

288
00:24:50,200 --> 00:24:52,260
!لا أهتمّ لأقدامي

289
00:24:52,260 --> 00:24:54,130
!سأخسر أراشي أيضًا

290
00:24:54,130 --> 00:24:55,050
.انتظري

291
00:24:55,390 --> 00:24:56,740
.انتظري رجاءً

292
00:24:56,740 --> 00:24:58,050
.سأذهب

293
00:24:59,410 --> 00:25:00,400
.انتظري فقط

294
00:25:14,030 --> 00:25:15,070
.أراشي-سان

295
00:25:16,330 --> 00:25:18,070
أهذا أنت؟

296
00:25:18,300 --> 00:25:20,080
ما الذي تفعله هنا؟

297
00:25:21,110 --> 00:25:22,940
ألا ترى؟

298
00:25:22,940 --> 00:25:24,080
.كنتُ نائمًا

299
00:25:24,910 --> 00:25:26,580
كنتَ نائمًا؟

300
00:25:27,720 --> 00:25:28,590
ما الخطب؟

301
00:25:28,590 --> 00:25:31,970
.فلتخرج من البحر رجاءً

302
00:25:44,740 --> 00:25:47,850
لماذا تبكين؟

303
00:25:51,290 --> 00:25:52,580
.هذا مؤلم

304
00:25:54,340 --> 00:25:55,740
.أيّها الأحمق

305
00:25:59,380 --> 00:26:03,960
.أنا لن أختفي بعد في البحر أيضًا كما تعلمين

306
00:26:04,580 --> 00:26:05,620
.أراشي-سان

307
00:26:07,080 --> 00:26:09,260
.سأسألك مجدّدًا

308
00:26:09,260 --> 00:26:11,560
.هلا سمحت لي بالبقاء في مسكنك رجاءً

309
00:26:12,490 --> 00:26:15,010
.أو بالأحرى سأبقى هناك حتى لو لم تسمح لي بذلك

310
00:26:16,750 --> 00:26:20,260
.يجب أن أتأكّد من أنّك لن تقدم على أمرٍ خطير

311
00:26:20,690 --> 00:26:22,350
...أنت

312
00:26:22,350 --> 00:26:24,880
.جزءٌ من ذلك مجرّد مزحة

313
00:26:25,380 --> 00:26:27,880
.لكنّني أرغب حقًا في البقاء هنا

314
00:26:28,450 --> 00:26:33,510
.وما كنتُ لأستطيع نسيان ما أريتني إيّاه

315
00:26:34,330 --> 00:26:36,720
.إنّه شيءٌ مهم جدًا بالنّسبة لي

316
00:26:38,420 --> 00:26:39,550
.لِذا رجاءً

317
00:26:43,440 --> 00:26:44,450
ماذا عن الرّسالة؟

318
00:26:44,870 --> 00:26:46,700
.أرسلتها اليوم

319
00:26:48,310 --> 00:26:49,670
.إنًه يقول الحقيقة

320
00:26:51,130 --> 00:26:53,420
إذًا ما هو اسمك؟

321
00:26:54,420 --> 00:26:55,920
اسمي؟

322
00:26:56,150 --> 00:26:59,350
ألم أخبرك أنّه من غير الملائم عدم امتلاكك لاسم؟

323
00:27:00,710 --> 00:27:02,080
.أنا ميساكي

324
00:27:02,880 --> 00:27:04,560
.ميساكي يوتارو

325
00:27:04,560 --> 00:27:07,120
.فهمت، ميساكي إذًا

326
00:27:07,760 --> 00:27:09,560
.إنّه بالتّأكيد أفضل من شييو

327
00:27:10,960 --> 00:27:12,770
.سأخلد للنّوم بعد الاستحمام