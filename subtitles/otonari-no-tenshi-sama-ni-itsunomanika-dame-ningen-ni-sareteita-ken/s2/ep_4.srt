1
00:00:21,400 --> 00:00:25,300
هذا صحيح. نمتُ بجانب ماهيرو
في اللّيلة الماضية

2
00:00:28,990 --> 00:00:30,160
إنّها ظريفةٌ للغاية

3
00:00:38,270 --> 00:00:40,190
أماني، ألم تستيقظ بعد؟

4
00:00:41,030 --> 00:00:43,120
في الواقع، هذا مُحرج

5
00:00:43,120 --> 00:00:44,350
سأدخل

6
00:00:44,350 --> 00:00:45,850
حـ-حسناً

7
00:00:56,670 --> 00:00:59,940
آمل فحسب ألّا يُسيء الفهم

8
00:01:12,010 --> 00:01:16,220
جارتي الملاك
تُدلّلني كثيراً الجزء الثّاني

9
00:02:37,180 --> 00:02:39,200
آسف. هل أيقظتُكِ؟

10
00:02:42,510 --> 00:02:46,070
أنتِ ناعمةٌ حقّاً عندما تكونين
شبه نائمة يا ماهيرو

11
00:02:49,660 --> 00:02:53,740
ماذا؟ أماني-كن؟ لـ-لماذا؟

12
00:02:53,740 --> 00:02:54,680
صباح الخير

13
00:02:58,000 --> 00:02:59,780
تقصدين بأنّكِ لا تتذكّرين؟

14
00:02:59,780 --> 00:03:03,240
قضينا وقتاً جامحاً معاً في اللّيلة الماضية

15
00:03:03,240 --> 00:03:04,870
ماذا؟

16
00:03:05,380 --> 00:03:08,970
أمزح فقط. لم نفعل شيئاً

17
00:03:08,970 --> 00:03:10,820
حـ-حسناً

18
00:03:10,820 --> 00:03:13,780
حسناً، أعتقد بأنّني قبّلتُكِ
في الخدّ قبل لحظات

19
00:03:13,780 --> 00:03:16,630
!من المُبكّر جدّاً على هذا الحماس

20
00:03:16,630 --> 00:03:18,790
يبدو أنّكِ نمتِ جيّداً

21
00:03:18,790 --> 00:03:23,740
أجل، أشعر بالاسترخاء عندما
أكون بين ذراعيك

22
00:03:23,740 --> 00:03:26,030
لا أجعل نبضات قلبكِ تتسارع؟

23
00:03:26,030 --> 00:03:29,550
بلى... تفعل ذلك

24
00:03:30,120 --> 00:03:32,970
لكن مع ذلك هذا يبعث على الاسترخاء

25
00:03:33,570 --> 00:03:36,570
لكن قلبي يخفق قليلاً الآن

26
00:03:36,570 --> 00:03:38,950
أتعتقدين بأنّنا ينبغي أن ننام
معاً في كلّ ليلة؟

27
00:03:38,950 --> 00:03:41,180
...قـ-قد يكون هذا بعض الشّيء

28
00:03:42,550 --> 00:03:44,900
ر-ربّما بين الحين والآخر

29
00:03:44,900 --> 00:03:46,580
هل أنتِ جادّة؟

30
00:03:46,580 --> 00:03:49,240
،بـ-بما أنّنا حبيبان

31
00:03:49,580 --> 00:03:54,340
أليس من المقبول أن نقضي اللّيل معاً؟

32
00:03:54,340 --> 00:03:58,050
أ-أجل، هذا ما أعتقده

33
00:03:59,720 --> 00:04:03,940
لكن إذا نمنا معاً، فإنّ شيئاً
...قد يجرّ شيئاً آخر

34
00:04:03,940 --> 00:04:09,270
أنا لا أحاول بالضّرورة اقتراح ذلك

35
00:04:09,620 --> 00:04:15,150
سأكون سعيدة إذا كان ذلك يعني بأنّني
أستطيع قضاء المزيد من الوقت معك

36
00:04:15,150 --> 00:04:16,190
حسناً

37
00:04:16,190 --> 00:04:18,390
...لكن إذا كنت لا تريد ذلك

38
00:04:18,390 --> 00:04:22,240
بالطّبع أريد ذلك. بل هذا يروقني في الواقع

39
00:04:22,640 --> 00:04:27,390
حسناً، ربّما في وقت لاحق. ينبغي أن ننهض

40
00:04:42,200 --> 00:04:47,670
كنت تُضايقني طوال الوقت، لذا هذا هو الردّ

41
00:04:49,250 --> 00:04:52,570
هل حدث شيء عندما خرجتُما البارحة؟

42
00:04:53,530 --> 00:04:55,520
ما الّذي يجعلكِ تعتقدين ذلك؟

43
00:04:55,520 --> 00:04:58,680
بدوتَ مُختلفاً بعد أن عدنا إلى المنزل

44
00:04:58,680 --> 00:05:00,780
لا ينبغي أن تستهين بوالديك

45
00:05:01,030 --> 00:05:02,380
هذا ليس بالأمر الجلل

46
00:05:02,380 --> 00:05:06,540
صادفنا توجو أثناء سيرنا، وتجاذبنا
أنا وهو أطراف الحديث

47
00:05:06,540 --> 00:05:09,410
أجل، هذا يُفسّر الأمر

48
00:05:10,390 --> 00:05:13,550
لكن يبدو أنّك عالجت الأمر بشكل جيّد

49
00:05:15,070 --> 00:05:16,640
أجل، هذا ما أعتقده

50
00:05:16,640 --> 00:05:20,610
،لكن أكثر من مُجرّد مُعالجة الأمر
أظنّني تجاوزتُ الأمر برمّته

51
00:05:21,300 --> 00:05:24,550
لا أعتقد بأنّه سيزعجني أكثر من ذلك

52
00:05:27,310 --> 00:05:30,110
أنت تنضج حقّاً. هذا أمر رائع

53
00:05:30,110 --> 00:05:33,810
لكن يبدو وكأنّ الفتى توجو لم يتغيّر بعد

54
00:05:33,810 --> 00:05:36,730
لا أُبالي. إنّه ليس مُشكلتي

55
00:05:36,730 --> 00:05:38,990
أشكّ في أنّني سأراه كثيراً على أيّ حال

56
00:05:40,530 --> 00:05:41,760
هذا شهيّ

57
00:05:41,760 --> 00:05:44,040
الحُبّ يجعلك أقوى

58
00:05:44,040 --> 00:05:45,930
لا داعي لهذه النّصائح المُبتذلة

59
00:05:45,930 --> 00:05:47,990
لكن ألا تعتقد بأنّها صحيحة؟

60
00:05:47,990 --> 00:05:49,870
أجل، رُبّما

61
00:05:50,330 --> 00:05:54,620
نحن مسروران لأنّك عثرت أخيراً
على الشّخص المُناسب لك يا أماني

62
00:05:54,620 --> 00:05:57,370
مثلما هي شيهوكو-سان بالنّسبة لي

63
00:05:57,370 --> 00:05:57,920
!يا إلهي

64
00:05:57,920 --> 00:05:59,210
أ-أجل

65
00:05:59,210 --> 00:06:01,960
احرصي على أن يعاملكِ أماني
بشكل جيّد أيضاً يا ماهيرو

66
00:06:01,960 --> 00:06:05,470
أخشى أن تكوني أنتِ من يعتني به دوماً

67
00:06:05,470 --> 00:06:09,840
لـ-لا، أنا أعتمد على أماني-كن في كلّ شيء

68
00:06:10,250 --> 00:06:12,210
إنّه يقف بجانبي دوماً لمُساندتي

69
00:06:12,210 --> 00:06:13,580
يسرّني سماع ذلك

70
00:06:14,260 --> 00:06:17,500
مهلاً يا أماني، لا تستغلّ لطف شينا-سان

71
00:06:17,500 --> 00:06:19,110
يجب أن تدعما بعضكما الآخر

72
00:06:19,410 --> 00:06:22,320
أعلم ذلك. نحن معاً دوماً

73
00:06:22,320 --> 00:06:23,860
نحن ندعم بعضنا الآخر بالطّبع

74
00:06:24,260 --> 00:06:26,860
!يا إلهي، كم أنتما ظريفان

75
00:06:26,860 --> 00:06:30,620
،لو لم يكن لديّ دوام في العمل
!لقضيتُ اليوم كلّه أدلّلكما

76
00:06:30,620 --> 00:06:32,500
إذاً أسرعي واذهبي إلى العمل

77
00:06:32,500 --> 00:06:35,250
وذلك كي تتداعبا في غيابنا؟

78
00:06:35,250 --> 00:06:37,160
هذا صحيح. هل لديكِ اعتراض على ذلك؟

79
00:06:38,500 --> 00:06:42,500
مُواعدة منزليّة مع الملاك

80
00:06:40,140 --> 00:06:41,970
...إ-إذاً

81
00:06:42,510 --> 00:06:46,840
ما الّذي تشمله "المُداعبة" بالضّبط؟

82
00:06:46,840 --> 00:06:48,310
تقبيل وما شابه

83
00:06:48,310 --> 00:06:49,670
تقبيل وما شابه؟

84
00:06:50,600 --> 00:06:51,840
تقبيل و... ما شابه؟

85
00:06:52,270 --> 00:06:54,600
إنّه مُجرّد تقبيل إذاً

86
00:06:54,600 --> 00:06:57,890
في الواقع، لستُ مُتيقّناً بحدّ ذاتي

87
00:06:57,890 --> 00:07:01,870
إذا أردنا مُتابعة المُداعبة، فما الّذي
سيأتي تالياً؟

88
00:07:02,900 --> 00:07:05,500
أعتقد مُعانقة بعضنا الآخر

89
00:07:05,500 --> 00:07:06,660
حسناً

90
00:07:08,760 --> 00:07:10,330
يروقني هذا أكثر

91
00:07:12,000 --> 00:07:12,900
أتريدين التوقُّف؟

92
00:07:12,900 --> 00:07:15,150
لـ-لا، لم أقل ذلك

93
00:07:16,140 --> 00:07:22,210
المعذرة، عندما نكون هكذا، أشعر
وكأنّني ملفوفة بداخلك

94
00:07:26,150 --> 00:07:27,400
!أماني-كن

95
00:07:27,400 --> 00:07:29,630
آسف، آسف لم يكن بالأمر بيدي

96
00:07:29,630 --> 00:07:34,060
يا له من تصرُّف فظيع تقوم به
لشخص تعرفه وهو الدّغدغة

97
00:07:34,650 --> 00:07:38,380
ربّما ينبغي أن أخبرك أكثر عمّا
سمعتُه عن طفولتك

98
00:07:38,380 --> 00:07:40,570
لا نريد فعل ذلك الآن

99
00:07:42,870 --> 00:07:46,060
أماني-كن، يداك كبيرتان

100
00:07:47,170 --> 00:07:49,470
أحبّ يديك الكبيرتين

101
00:07:50,300 --> 00:07:53,330
أحبّهما عندما تلمسانني

102
00:07:54,810 --> 00:07:57,660
،إذا بدأتِ في التكلُّم بهذه الطّريقة
فسوف ألمسكِ بكلّ تأكيد

103
00:07:57,660 --> 00:07:59,790
لن أُمانع ذلك

104
00:08:04,340 --> 00:08:10,220
إن كنتِ تعنين ذلك حقّاً، فهل هذا
يعني أنّه يمكنني الارتفاع أكثر؟

105
00:08:13,990 --> 00:08:16,430
هذا جزء من المُداعبة أيضاً

106
00:08:18,010 --> 00:08:20,470
المعذرة... أماني-كن؟

107
00:08:21,230 --> 00:08:24,300
أقول لكِ بأنّني شابّ في نهاية
المطاف، لذا احذري

108
00:08:24,300 --> 00:08:25,900
—كما قلتُ في السـ

109
00:08:27,360 --> 00:08:30,780
...إذا أردت لمسي بهذا الإلحاح

110
00:08:31,780 --> 00:08:33,540
...هذا مُحرج قليلاً

111
00:08:33,970 --> 00:08:35,990
لكن سأسمح لك

112
00:08:43,130 --> 00:08:44,920
سأؤجّل الأمر حاليّاً

113
00:08:45,380 --> 00:08:48,530
لا أعتقد بأنّني سأتمكّن من منع نفسي

114
00:08:56,470 --> 00:09:00,560
ماذا؟ ماهيرو-تشان، وجهكِ أحمر
برّاق. هل حدث شيء؟

115
00:09:00,560 --> 00:09:03,730
لـ-لا، لا شيء

116
00:09:04,020 --> 00:09:06,110
...أماني! هل يُعقل أنّك

117
00:09:06,110 --> 00:09:08,190
!صدّقيني لم أمسّها حتّى بإصبعي

118
00:09:08,190 --> 00:09:10,460
...ربّما ليس إصبعاً، لكن

119
00:09:10,460 --> 00:09:12,700
قلتَ بأنّكما ستتداعبان

120
00:09:12,700 --> 00:09:16,240
كنّا نُعانق بعضنا فحسب. لا ينبغي
أن تكون هناك مُشكلة في ذلك

121
00:09:16,240 --> 00:09:21,120
.حسناً، هذا ليس عدلاً يا أماني
!أريد مُعانقة ماهيرو-تشان أيضاً

122
00:09:21,120 --> 00:09:23,310
!مستحيل. ماهيرو مُلكي

123
00:09:23,310 --> 00:09:24,430
!يا إلهي

124
00:09:23,560 --> 00:09:24,840
مُلكي"؟"

125
00:09:25,100 --> 00:09:28,570
حسناً إذاً، لِمَ لا نُخصّص وقتاً
لفعل شيء كعائلة؟

126
00:09:28,570 --> 00:09:29,340
ماذا؟

127
00:09:29,610 --> 00:09:33,830
أجل. ألم تقولي بأنّكِ أردتِ الخروج
إلى مكان ما يا شينا-سان؟

128
00:09:34,310 --> 00:09:35,550
هذا صحيح

129
00:09:35,550 --> 00:09:39,730
بما أنّكِ هنا، لِمَ لا نخرج معاً
في يوم عطلتنا المُقبلة؟

130
00:09:40,050 --> 00:09:41,420
ما رأيكِ؟

131
00:09:41,420 --> 00:09:44,440
أجل. شكراً جزيلاً لكِ

132
00:09:44,440 --> 00:09:45,890
هذا لطف منكما

133
00:09:52,700 --> 00:09:55,320
أنا مُبتلّ تماماً

134
00:09:55,320 --> 00:09:57,160
أهلاً بعودتك يا أماني-كن

135
00:09:57,160 --> 00:09:59,660
يبدو أنّها بدأتْ تُمطر بغزارة

136
00:09:59,660 --> 00:10:00,660
عدتُ بالسّلامة

137
00:10:04,550 --> 00:10:08,790
لعلّه مُجرّد مطر خفيف عابر، لكنّه
اشتدّ أكثر ممّا توقّعت

138
00:10:08,790 --> 00:10:13,510
يجدر بك أن تستحمّ. كلّ شيء جاهز

139
00:10:13,510 --> 00:10:15,560
أجل. شكراً

140
00:10:18,540 --> 00:10:19,850
أتعلمين؟ هذا لطيف بعض الشّيء

141
00:10:19,850 --> 00:10:20,970
ماذا؟

142
00:10:20,970 --> 00:10:25,080
أن تُجهّزي الحمّام ثمّ تأتي للتّرحيب بي

143
00:10:26,150 --> 00:10:28,480
شكراً. سوف أستحمّ

144
00:10:31,610 --> 00:10:35,690
أغار من امتلاكك شعراً حريريّاً كهذا

145
00:10:35,690 --> 00:10:37,770
رغم أنّك لا تبذل جهداً في الاعتناء به

146
00:10:37,770 --> 00:10:42,110
حقّاً؟ لكن الوقت الّذي تبذلينه
في الاعتناء بشعركِ يُثمر

147
00:10:42,110 --> 00:10:44,630
إنّه حريريّ جدّاً ولامع دوماً

148
00:10:44,630 --> 00:10:48,390
لكن قد يكون مُزعجاً لأنّه طويل جدّاً

149
00:10:48,390 --> 00:10:52,090
أجل، يستغرق وقتاً عندما يكون بهذا الطّول

150
00:10:52,090 --> 00:10:56,340
أحياناً أُفكّر حتّى في قصّه

151
00:10:56,680 --> 00:11:01,600
أيُّهما تُحبّ أكثر يا أماني-كن؟
الشّعر الطّويل أم القصير؟

152
00:11:01,600 --> 00:11:06,860
لا أعتقد بأنّ هناك ما أُفضّله. أعتقد
بأنّكِ تبدين ظريفة في كلتا القصَّتين

153
00:11:07,290 --> 00:11:10,700
لكن أحبّ أن أراكِ مُستمتعة بتصفيف شعركِ

154
00:11:10,700 --> 00:11:13,860
أعتقد ينبغي أن تعتمدي الطّولَ
الّذي يروقكِ أكثر

155
00:11:14,430 --> 00:11:16,740
أهذا ما تعتقده؟

156
00:11:17,000 --> 00:11:21,500
حسناً، هل من طريقة مُعيّنة تريدين
منّي أن أُصفِّف شعري بها؟

157
00:11:21,500 --> 00:11:24,740
تُعجبني كيفما كان شعرك

158
00:11:24,740 --> 00:11:27,000
رأيتِ؟ هذا ما أعنيه

159
00:11:27,000 --> 00:11:29,740
...أجل. رغم ذلك

160
00:11:31,160 --> 00:11:35,840
عندما أراك تدفع غرّتك للخلف عندما
...تبتلّ، فأنا حقّاً

161
00:11:35,840 --> 00:11:37,260
أنتِ حقّاً...؟

162
00:11:37,540 --> 00:11:42,640
أعتقد يبدو ذلك مُثيراً. يجعلك
ذلك تبدو رائعاً حقّاً

163
00:11:42,640 --> 00:11:43,890
أتريدين أن أفعل ذلك الآن؟

164
00:11:43,890 --> 00:11:46,600
!لـ-لا، لا داعي! قد يُغمى عليّ

165
00:11:46,600 --> 00:11:49,350
من السّهل استفزاز ماهيرو حقّاً

166
00:11:50,190 --> 00:11:54,550
لكن عندما أراكِ تنظرين إليّ
،عند خروجكِ من الحمّام

167
00:11:54,550 --> 00:11:56,830
فهذا يشلّ حركتي تماماً

168
00:11:56,830 --> 00:12:00,690
لكن أعتقد بأنّك رأيت ذلك في كلّ
يوم كنّا فيه هنا

169
00:12:00,690 --> 00:12:03,540
أسعى ألّا أنظر إليكِ بشكل مُباشر

170
00:12:03,540 --> 00:12:07,000
فهمت. هذه بعض المعلومات المُفيدة

171
00:12:07,000 --> 00:12:08,560
مهلاً

172
00:12:09,590 --> 00:12:11,210
ربّما ينبغي أن أحبس نفسي
في غرفتي إذاً

173
00:12:11,480 --> 00:12:13,100
!لن يكون ذلك مُنصِفاً

174
00:12:13,100 --> 00:12:14,980
بل هو مُنصف تماماً

175
00:12:14,980 --> 00:12:20,090
لا، إنّه ليس كذلك! أعتقد أنّه من حقوقي
!أن أتمكّن من إغرائك

176
00:12:24,060 --> 00:12:28,270
بينهما، أيّهما تعتقد بأنّه سيليق
أكثر بماهيرو-تشان؟

177
00:12:28,570 --> 00:12:32,400
سأكون مسروراً بما تختاره ماهيرو

178
00:12:32,660 --> 00:12:36,900
ر-رغم ذلك، أودّ أن أعرف أيُّهما
تُفضّل يا أماني-كن

179
00:12:40,270 --> 00:12:41,150
إذاً هذا

180
00:12:41,150 --> 00:12:42,400
!هذا إذاً

181
00:12:42,400 --> 00:12:44,620
ستبدو جميلة حقّاً به

182
00:12:44,620 --> 00:12:45,950
أدرك ذلك تماماً

183
00:12:45,950 --> 00:12:48,940
!أنت لا تُحاول حتّى إخفاء ذلك اليوم

184
00:12:48,940 --> 00:12:50,240
لا تقولي ذلك

185
00:12:50,810 --> 00:12:53,080
!يليق كلّ شيء بك يا شوتو-سان

186
00:12:55,170 --> 00:12:57,590
...مـ-ماهيرو، اسمعي

187
00:12:57,590 --> 00:12:58,460
نعم؟

188
00:12:58,460 --> 00:13:01,590
...أنا... فـ-في الواقع

189
00:13:01,590 --> 00:13:03,220
ما الأمر؟

190
00:13:04,470 --> 00:13:09,080
كنتُ أقول لنفسي، هل ارتديتِ الفستان
الّذي اشتريتِه أثناء الأسبوع الذّهبيّ؟

191
00:13:09,860 --> 00:13:14,060
كنتُ أؤجّله للوقت الّذي نخرج
فيه بمُفردنا في مُواعدة

192
00:13:14,060 --> 00:13:15,970
كـ-كنت كذلك؟

193
00:13:15,970 --> 00:13:17,980
ألن تأخذني ونخرج؟

194
00:13:18,270 --> 00:13:21,810
بالتّأكيد. اليوم هو أشبه بنزهة عائليّة

195
00:13:22,420 --> 00:13:24,370
في المرّة المُقبلة سنكون بمفردنا فقط

196
00:13:24,370 --> 00:13:25,530
أجل

197
00:13:25,530 --> 00:13:27,070
إلى أين تريدين الذّهاب؟

198
00:13:27,070 --> 00:13:29,910
سأذهب إلى أيّ مكان معك يا أماني-كن

199
00:13:33,470 --> 00:13:35,200
إنّها تُمطر

200
00:13:36,280 --> 00:13:38,350
بالفعل

201
00:13:39,030 --> 00:13:43,220
لا تحزني كثيراً. ستسنح لنا
فُرصة أُخرى للخروج

202
00:13:43,220 --> 00:13:50,020
أعلم ذلك، لكن كنّا نُخطّط لهذا

203
00:13:50,290 --> 00:13:52,520
هل كنتِ تتطلّعين لمُواعدتنا إلى هذا الحدّ؟

204
00:13:52,520 --> 00:13:54,270
كنتُ كذلك بالطّبع

205
00:13:54,270 --> 00:13:56,340
حـ-حسناً

206
00:13:56,790 --> 00:14:00,450
إذا كان ذلك يعنيكِ الكثير، فإنّني
أشعر بتأنيب الضّمير حيال الأمر

207
00:14:01,450 --> 00:14:06,690
سواء كانت مُواعدة أم لا، ما زلتُ
أستمتع بالرّخاء معك يا أماني-كن

208
00:14:07,530 --> 00:14:11,790
رغم أنّني مسرورة أنّك لا تستهدف
أُذنَي كما في ذلك اليوم

209
00:14:11,790 --> 00:14:15,150
ماذا؟ بما أنّكِ ذكرتِ ذلك، فسوف أفعل

210
00:14:15,150 --> 00:14:20,510
لا! طريقتك في لمسهما والهمس فيهما
!مُضرّة بصحّتي

211
00:14:22,010 --> 00:14:26,220
يوماً ما، سأبحث عن طريقك تجعل
ركبتيك تضعفان تماماً

212
00:14:26,220 --> 00:14:28,470
إذاً ذلك يجعل ركبتيكِ تضعفان

213
00:14:30,150 --> 00:14:35,310
على هذا المُعدّل، سألجأ لاستخدام أي وسيلة
مُتاحة لأجعلك مُغرماً بي

214
00:14:35,310 --> 00:14:38,960
أنا مُتيّم بكِ بالفعل. ماذا عساكِ
تفعلين غير ذلك؟

215
00:14:38,960 --> 00:14:42,650
اعتاد لسانك على مثل هذه
الكلمات، أليس كذلك؟

216
00:14:42,940 --> 00:14:45,510
،لا أقول بأنّه ليس من المُحرج قولها

217
00:14:45,510 --> 00:14:48,340
لكن سمعتُ أنّه إن لم نزرع
،مشاعرنا في كلماتنا

218
00:14:48,340 --> 00:14:49,740
فقد يؤدّي ذلك إلى سوء فهم

219
00:14:50,060 --> 00:14:52,910
أحبّ أسلوبك العمليّ

220
00:14:53,840 --> 00:14:55,350
شكراً

221
00:14:55,350 --> 00:14:56,880
هل أحرجتُك؟

222
00:14:57,390 --> 00:14:58,330
أين المُشكلة في ذلك؟

223
00:14:58,330 --> 00:15:01,800
لا شيء. أشعر فقط بأنّني
أحرزتُ نقطة أخيراً

224
00:15:02,010 --> 00:15:05,630
مفكّرة النموّ

225
00:15:02,010 --> 00:15:05,630
أماني في الثّالثة

226
00:15:18,980 --> 00:15:22,280
،حسناً، انتهينا من المهام المنزليّة
—لذا ما ينبغي أن نفعـ

227
00:15:25,110 --> 00:15:26,660
...أنا، في الواقع

228
00:15:26,980 --> 00:15:30,520
،ارتأيتُ أنّه وبالرّغم من أنّنا في المنزل

229
00:15:31,130 --> 00:15:34,910
أنّه ينبغي أن أرتدي الفستان الّذي
كنتُ قد ادّخرتُه لمُواعدتنا

230
00:15:35,820 --> 00:15:38,790
ما رأيك؟ هل يليق بي؟

231
00:15:40,570 --> 00:15:44,490
أجل. يبدو رائعاً عليكِ

232
00:15:45,010 --> 00:15:47,180
شكراً على كلامك هذا

233
00:15:47,460 --> 00:15:50,530
هل ينبغي أن أحاول أن أكون أكثر تحديداً؟

234
00:15:50,530 --> 00:15:52,310
لديكِ بشرة جميلة يا ماهيرو

235
00:15:52,310 --> 00:15:55,520
عندما أراها بهذا الشّكل، فإنّها
تبدو وكأنّها تتوهّج

236
00:15:55,780 --> 00:15:59,740
بما أنّكِ نحيلة، فإنّ هذا الفستان
يبرز قوامكِ حقّاً

237
00:15:59,740 --> 00:16:02,640
وكأنّكِ تنفخين روحاً في الفستان

238
00:16:02,640 --> 00:16:06,320
وأيضاً هذا يجعلكِ تبدين أطول من المعتاد

239
00:16:06,320 --> 00:16:09,990
الخطوط البارزة في الفستان تجعلكِ
أيضاً تبدين ناضجة جدّاً

240
00:16:09,990 --> 00:16:13,050
!حـ-حسناً، هذا يكفي

241
00:16:13,370 --> 00:16:16,430
ما الّذي ترمي إليه بمُغازلتي إلى هذا الحدّ؟

242
00:16:18,270 --> 00:16:21,290
ا-المعذرة، أماني-كن

243
00:16:21,290 --> 00:16:26,050
.مهلكِ، لا ينبغي أن يكون هذا كثيراً
أنا لا ألمسكِ في أماكن حرِجة

244
00:16:28,610 --> 00:16:32,940
!أخبرتُك بأنّني لا أريدك أن تلعب بأُذنَي

245
00:16:32,940 --> 00:16:34,580
لأنّكِ تشعرين بضعف في الرّكبتين؟

246
00:16:34,580 --> 00:16:37,500
،ما كنتُ لأقول ذلك

247
00:16:37,500 --> 00:16:39,810
،لكن هذا يجعلني أشعر بوخز مُثير
لذا لا تفعل من فضلك

248
00:16:40,200 --> 00:16:43,200
إذاً سأؤجّل ذلك إلى مُناسبة خاصّة

249
00:16:43,200 --> 00:16:47,240
تبدو تلك المُناسبة وكأنّها
قد تخرج عن نِطاق السّيطرة

250
00:16:50,160 --> 00:16:55,270
لكن على الأقلّ أعرف الآن بأنّ
هذا هو نمط الفستان الّذي تُحبّ

251
00:16:55,270 --> 00:16:59,670
إنّه ليس نمطي تماماً. أعتقد فقط
بأنّكِ تبدئين رائعة فيه

252
00:16:59,670 --> 00:17:01,820
حسناً، يسرّني سماع ذلك

253
00:17:01,820 --> 00:17:05,170
فقد اشتريتُه لأُريك

254
00:17:05,170 --> 00:17:08,210
إذاً أعتقد أودّ إلقاء نظرة أعمق

255
00:17:18,600 --> 00:17:20,800
تبدين رائعة حقّاً. أنتِ جميلة للغاية

256
00:17:21,870 --> 00:17:28,360
أ-أعلم بالفعل بأنّك تعتقد بأنّني
أبدو جميلة يا أماني-كن

257
00:17:29,760 --> 00:17:34,240
من المُحرج قليلاً قول ذلك، لكنّكِ
أجمل فتاة أعرفها

258
00:17:35,050 --> 00:17:42,000
.تتصرّف بصراحة أكبر اليوم يا أماني-كن
أجرأ بكثير من المعتاد

259
00:17:42,300 --> 00:17:45,700
لأنّنا نقضي مُواعدة، ولو كان ذلك في المنزل

260
00:17:46,210 --> 00:17:51,860
،متى اقتربت منّي بهذه الشدّة
أشعر بالضّعف والاستسلام

261
00:17:51,860 --> 00:17:53,900
إذاً هل ينبغي أن أكون هكذا دوماً؟

262
00:17:53,900 --> 00:17:58,010
لـ-لا! لا يتحمّل قلبي ذلك

263
00:17:58,010 --> 00:18:02,020
وإن لم تشعر بنفس حماسي، فهذا ليس عدلاً

264
00:18:04,000 --> 00:18:06,260
أنا مُتحمّس للغاية

265
00:18:06,260 --> 00:18:07,760
هل أنت كذلك حقّاً؟

266
00:18:13,330 --> 00:18:14,840
أنت كذلك حقّاً

267
00:18:17,740 --> 00:18:21,750
فكّرتُ في الأمر ثانية، وإذا كانت
،هذه مُواعدة

268
00:18:21,750 --> 00:18:24,890
إذاً نحن نتصرّف حقّاً كما نفعل
دوماً أثناء مُواعدة

269
00:18:25,830 --> 00:18:27,250
هذا ما أعتقده

270
00:18:27,510 --> 00:18:31,950
في إحدى هذه الأيّام، أريد تجربة
الذّهاب إلى منزلكِ أيضاً يا ماهيرو

271
00:18:31,950 --> 00:18:34,720
منزلي؟

272
00:18:34,720 --> 00:18:38,450
حسناً، مهلاً. ليس لديّ أي دوافع خفيّة

273
00:18:38,880 --> 00:18:40,990
يُراودني فضول فحسب

274
00:18:40,990 --> 00:18:45,150
حسناًن لا أُمانع. لكن لا يوجد
الكثير يستحقّ الرّؤية

275
00:18:45,150 --> 00:18:50,110
،يُراودني فضول فحسب. وأيضاً
أردتُ التحقُّق من شيء

276
00:18:50,110 --> 00:18:51,530
التحقُّق من شيء؟

277
00:18:51,840 --> 00:18:54,580
أردتُ رؤية صورتي تلك على مكتبكِ

278
00:18:54,580 --> 00:18:57,240
كنتُ أتساءل ما طبيعة تلك الصّورة؟

279
00:18:58,660 --> 00:19:00,000
!أنت...؟

280
00:19:00,000 --> 00:19:03,300
تـ-تعلم بشأن ذلك؟

281
00:19:03,300 --> 00:19:08,040
في الواقع، استنتجتُ ذلك بعد أن بدأنا نتواعد

282
00:19:08,750 --> 00:19:11,330
ولم تعتقد بأنّ هذا مُريب؟

283
00:19:11,330 --> 00:19:12,840
ولِمَ أراه مُريباً؟

284
00:19:16,910 --> 00:19:20,050
إنّها صورة لك وأنت تبتسم

285
00:19:20,370 --> 00:19:27,220
.التُقِطت الصّورة بواسطة أكازاوا-سان
لم أكن أراك تبتسم هكذا كثيراً

286
00:19:27,220 --> 00:19:30,570
إذاً كان ذلك الوغد يُمرّر لكِ
أشياء دون علمي؟

287
00:19:30,870 --> 00:19:32,190
أنا مسرورة للغاية

288
00:19:32,570 --> 00:19:35,140
كنتُ متأكّدة بأنّك ستكرهني على ذلك

289
00:19:35,140 --> 00:19:36,930
ذلك من جديد؟

290
00:19:36,930 --> 00:19:39,760
أنت من قال بأنّني أستطيع
مُعانقتك يا أماني-كن

291
00:19:39,760 --> 00:19:42,650
أظنّكِ على حقّ. يمكننا أن
نتعانق قدر ما تشائين

292
00:19:43,400 --> 00:19:48,050
على هذا المُعدّل، سوف ينتهي المطاف
بإفسادك لي كثيراً

293
00:19:49,140 --> 00:19:53,250
لقد أفسدتِني بالفعل، لذا أعتقد
سأفعل المثل لكِ

294
00:19:53,250 --> 00:19:57,510
هذا ليس شيئاً تحتاج لردّ اعتباره. عجباً لك

295
00:20:02,730 --> 00:20:05,980
أحياناً أشعر وكأنّك تحاول تغيير الموضوع

296
00:20:05,980 --> 00:20:07,250
هل ينبغي أن أتوقّف؟

297
00:20:07,250 --> 00:20:09,210
لم أقل بأنّك ينبغي أن تتوقّف

298
00:20:09,850 --> 00:20:11,630
هذا ليس عدلاً فحسب

299
00:20:17,390 --> 00:20:20,040
والآن أنت من يُعانق يا أماني-كن

300
00:20:20,510 --> 00:20:21,660
اسكتي

301
00:20:22,870 --> 00:20:25,950
يمكنكِ أن تُتابع وتُعانق كما تشاء

302
00:20:25,950 --> 00:20:28,080
سأدلّلك حتّى أُفسدك

303
00:20:28,580 --> 00:20:30,220
قمتِ بذلك سلفاً

304
00:20:30,890 --> 00:20:35,230
عندما أمسك بك هكذا، فإنّك تبدو
أصغر حجماً بالنّسبة لي

305
00:20:35,230 --> 00:20:39,050
في العادة تبدو شخصاً ضخماً ويُعتمَد عليه

306
00:20:39,050 --> 00:20:40,190
أنا؟

307
00:20:40,860 --> 00:20:45,780
،بينما أنتِ صغيرة الحجم ورقيقة
لدرجة أشعر بأنّني أستطيع تطويقكِ بالكامل

308
00:20:45,780 --> 00:20:49,230
لكن أنا من يطوّقك الآن

309
00:20:49,560 --> 00:20:53,760
لكن رُبّما وُلِدتُ هكذا فقط كي
أتّسع بين أحضانك

310
00:20:53,760 --> 00:20:56,520
أجل، وكأنّكِ خُلِقتِ لأجلي فقط يا ماهيرو

311
00:20:56,520 --> 00:20:59,740
أجل. كما خُلِقتَ لأجلي يا أماني-كن

312
00:21:02,140 --> 00:21:04,910
لكن من فضلك لا تترك أي علامة

313
00:21:04,910 --> 00:21:07,440
لن أترك أي علامة، لكن سأُقبّلكِ

314
00:21:07,840 --> 00:21:10,650
بدأ هذا يُدغدغني قليلاً

315
00:21:10,650 --> 00:21:13,460
إن لم يُعجبكِ ذلك، فينبغي
أن تدفعيني عنكِ

316
00:21:13,460 --> 00:21:14,830
أنت لئيم

317
00:21:16,890 --> 00:21:18,920
أشعر بالرّاحة هنا

318
00:21:18,920 --> 00:21:24,390
أقضي هذه الأيّام الهادئة معك في منزلك

319
00:21:24,390 --> 00:21:27,660
أشعر وكأنّكِ جزء من عائلتي من الآن

320
00:21:27,660 --> 00:21:32,590
أجل. أحزن بعض الشّيء لأنّنا
سنضطرّ للمُغادرة قريباً

321
00:21:32,590 --> 00:21:34,230
يسرّني سماع ذلك؟

322
00:21:34,230 --> 00:21:35,020
ماذا؟

323
00:21:35,020 --> 00:21:38,230
هذا يعني بأنّكِ مرتاحة هنا حقّاً، صحيح؟

324
00:21:38,230 --> 00:21:40,610
حـ-حسناً، أجل

325
00:21:40,610 --> 00:21:43,110
سنعود ثانية في وقت لاحق

326
00:21:43,440 --> 00:21:46,620
مثلاً في عطلة العام الجديد، أو رُبّما
في الصّيف المُقبل

327
00:21:47,380 --> 00:21:48,860
من جديد

328
00:21:48,860 --> 00:21:49,670
ألا تريدين ذلك؟

329
00:21:50,070 --> 00:21:52,140
!لم أقل هذا

330
00:21:52,140 --> 00:21:53,040
جيّد

331
00:21:53,620 --> 00:21:57,450
أرديكِ أن تعتبري هذا وكأنّه منزلكِ

332
00:22:01,310 --> 00:22:02,310
أجل

333
00:23:34,980 --> 00:23:39,980
الحلقة القادمة