160
00:11:39,180 --> 00:11:40,870
!ما الّذي تعتزمون فعله بشأن هذا ؟

161
00:11:41,980 --> 00:11:43,780
هوي ، هذا يكفي

162
00:11:48,340 --> 00:11:51,520
هذا ليس دمًا ، بل عصير طماطم

163
00:11:51,980 --> 00:11:54,780
يبدو أنّ السّيّد اليافع يحرص على تناول خضرواته

164
00:11:54,780 --> 00:11:56,270
لقد اطمأنَنت

165
00:11:56,270 --> 00:11:57,380
! "آنيكي"

166
00:11:58,160 --> 00:11:59,140
من ذاك ؟

167
00:11:59,140 --> 00:12:02,560
إنّه الزّعيم الشّاب (ناكامورا كيوجيرو)

168
00:12:02,700 --> 00:12:06,560
أوتسوزو) كان يعتبره كأخ له حينما كان لا يزال بالأرجاء)

169
00:12:06,560 --> 00:12:09,460
إنّه مُلِمّ بـ(أوتسوزو) أكثر منّي

170
00:12:10,240 --> 00:12:16,270
زعيم ، إنّه لمن المروّع رؤية
كلّ هؤلاء البالغين المحتشدين يتحامقون بصنيع طفل

171
00:12:16,600 --> 00:12:20,800
أنا .. قد حمست أمري بمقابلة ابني وجهًا لوجه

172
00:12:22,160 --> 00:12:23,620
فات الأوان

173
00:12:24,100 --> 00:12:26,640
من الأحسن لك أن تترك (أوتسوزو) وشأنه

174
00:12:27,060 --> 00:12:29,660
حين يحين الوقت المناسب سيخرج بمحض إرادته

175
00:12:30,040 --> 00:12:32,540
لا تجرحه أكثر ممّا فعلت

176
00:12:32,540 --> 00:12:36,190
أنت لم تنسى ما قد فعلتَه له ، صحيح ؟

177
00:12:43,640 --> 00:12:45,500
! زعيم

178
00:12:45,500 --> 00:12:46,910
! أيّها الزّعيم ، تماسك

179
00:12:54,520 --> 00:12:56,610
! (هانزو) ، اجلب عربة النّقل حالًا

180
00:12:56,610 --> 00:12:57,500
! حـ-حاضر

181
00:12:58,220 --> 00:13:00,490
! هوي ، تماسك يا زعيم

182
00:13:00,490 --> 00:13:01,370
! زعيم

183
00:13:01,370 --> 00:13:02,250
! (جين-سان)

184
00:13:02,250 --> 00:13:04,000
رافقاه إلى المستشفى

185
00:13:04,000 --> 00:13:05,760
ماذا عنك يا (جين-تشان) ؟

186
00:13:06,420 --> 00:13:09,140
... أنا ؟ أنا

187
00:13:16,170 --> 00:13:20,490
هكذا إذًا .. كلاّ
فلتبقوا بجواره هذه اللّيلة

188
00:13:21,000 --> 00:13:23,740
أجل ، أنا سأتولّى الأمور هنا لذا لا داعي للقلق

189
00:13:24,580 --> 00:13:26,880
أنا سأحظّر طعام السّيّد اليافع

190
00:13:28,020 --> 00:13:29,630
الطّفلان مزعجان ؟

191
00:13:29,940 --> 00:13:33,260
تقصد تلك الشّرذمة الّتي استأجرها الزّعيم ؟ تجاهلهما

192
00:13:46,240 --> 00:13:48,310
يال قساوة الأمر

193
00:13:48,940 --> 00:13:51,700
! رغم أنّ والده انهار ساقطًا إلاّ أنّه لم يتزحزح

194
00:13:52,880 --> 00:13:54,800
زبونك قد انهار

195
00:13:55,240 --> 00:13:57,100
مكوثك هنا مضيعة للوقت

196
00:13:57,920 --> 00:13:59,920
أودّ رؤية وجهه وحسب

197
00:14:00,280 --> 00:14:03,860
وجه الابن المتعنّت
الّذي يأبى الحراك حتّى و أبوه على شفير الموت

198
00:14:04,980 --> 00:14:06,670
أنت ترتاب للأمر

199
00:14:10,740 --> 00:14:13,060
ما قام به الزّعيم قد كان جللًا

200
00:14:13,380 --> 00:14:14,530
خذ

201
00:14:14,660 --> 00:14:18,220
هوي ألا بأس بهذا ؟
أليس هذا من أجل الابن الغبيّ ؟

202
00:14:18,240 --> 00:14:22,840
"لا بأس ، المُجدّون في عملهم وحدهم من يستلذّون مذاق الـ"سّاكي

203
00:14:23,400 --> 00:14:27,380
أنا أعرف السّيّد اليافع مذ أن كان طفلًا صغيرًا

204
00:14:27,860 --> 00:14:32,660
كان وديعًا و لطيفًا ، و كرِه عالم الإجرام هذا حتّى حينها

205
00:14:33,320 --> 00:14:36,840
فهو لم يمتلك مؤهّلات تسمح له بالعيش فيه

206
00:14:37,440 --> 00:14:41,340
عاكس رغبات الزّعيم و قرّر عيش حياةٍ مستقيمة

207
00:14:42,080 --> 00:14:44,580
... لقد بدى سعيدًا أثناء عمله لكن

208
00:14:45,100 --> 00:14:47,320
لم يدم ذلك طويلًا

209
00:14:49,280 --> 00:14:50,400
لقد كان الزّعيم

210
00:14:51,160 --> 00:14:54,880
... الزّعيم حاول إعادة وريثه (أوتسوزو) إلى عالم الإجرام

211
00:14:54,880 --> 00:15:00,540
بظهوره في مكان عمل السّيد اليافع و مضايقته مرارًا و تكرارًا

212
00:15:01,380 --> 00:15:05,300
حالما أدرك النّاس أنّهما على قرابة ، طُرِد على الفور

213
00:15:06,260 --> 00:15:10,540
الوضع الّذي آل إليه السّيّد اليافع كلّه بسبب الزّعيم

214
00:15:11,180 --> 00:15:17,280
قيامه بهذه الجلبة الآن حول إخراجه
... بعد تجاهله له طوال ذاك الوقت

215
00:15:17,800 --> 00:15:23,140
هو لإدراكه بقرب منيّته
و سعيًا لأن يورّثه من بعده قبل موته

216
00:15:24,500 --> 00:15:26,640
ألا تبدو لك أنّها قصّة ذات مصلحة شخصيّة ؟

217
00:15:30,300 --> 00:15:33,300
أنا لا أفهم التفاصيل غير المنتظمة

218
00:15:33,300 --> 00:15:38,060
... و لكن ، حين يريد الأب رؤية ابنه قبل أن يموت

219
00:15:38,060 --> 00:15:40,450
أيحتاج إلى ذرائع ؟

220
00:15:46,560 --> 00:15:49,830
أيحتاج الابن إلى ذريعة كي يرى والده ؟

221
00:15:57,650 --> 00:16:01,300
(أوتسوزو) .. ألا يوجد (أوتسوزو) ؟

222
00:16:01,820 --> 00:16:04,000
أيحتاج الأب و ابنه ذرائع ؟

223
00:16:04,000 --> 00:16:07,400
إنّهما يودّان رؤية وجهي بعضهما ، أوليس هذا كافيًا ؟

224
00:16:09,300 --> 00:16:12,140
أنت .. رجلٌ صالح

225
00:16:12,460 --> 00:16:15,360
هه ، سماع هذا من رجلٍ لا يسعدني

226
00:16:15,980 --> 00:16:19,470
... آسف و لكن بغضّ النّظر عن إن كان قلبه بصدفة أو غيرها

227
00:16:19,470 --> 00:16:22,120
سأجرّ صدفته هذه و آخذه إلى والده

228
00:16:22,260 --> 00:16:26,700
هيّا اخرج ، سنذهب للكم وجه والدك المحتضر

229
00:16:38,100 --> 00:16:39,330
! لقد فُتِح

230
00:16:39,330 --> 00:16:43,340
حقًّا ، لست رجلًا عاديًّا إذ جعلتني أفتح الباب

231
00:17:01,230 --> 00:17:03,000
ماذا ؟ أحان وقت المناوبة ؟

232
00:17:03,000 --> 00:17:04,400
أليس الوقت مبكّرًا ؟

233
00:17:04,760 --> 00:17:05,920
امرأة ؟

234
00:17:06,730 --> 00:17:09,180
من أنتِ ؟ ماذا عن (أوتسوزو) ؟

235
00:17:09,540 --> 00:17:11,120
ليس موجودًا

236
00:17:11,120 --> 00:17:14,500
هذا الشّخص لم يعد له وجود منذ زمن

237
00:17:30,720 --> 00:17:32,450
أنتِ .. من تكونين ؟

238
00:17:32,740 --> 00:17:34,150
ماذا عن (أوتسوزو) ؟

239
00:17:34,150 --> 00:17:35,720
ليس موجودًا

240
00:17:36,180 --> 00:17:39,090
هذا الشّخص لم يعد له وجود منذ زمن

241
00:17:56,750 --> 00:18:00,780
اللّعنة ، حتّى إنّك بارع المهارة

242
00:18:00,780 --> 00:18:03,880
يبدو أنّي قد علقت مع الرّجل الخطأ

243
00:18:04,020 --> 00:18:06,680
أيّها الوغد ، ما الّذي يعنيه هذا ؟

244
00:18:07,000 --> 00:18:12,180
لقد أسلفت آنفًا
بأنّ الأوان قد فات على إخراج الابن الغبيّ

245
00:18:12,500 --> 00:18:14,780
كلّكم جميعًا بلهاء

246
00:18:15,200 --> 00:18:17,930
... لم يرَوه أو يسمعوا صوته طوال 5 سنوات

247
00:18:17,930 --> 00:18:19,960
فأنّى له أن يكون حيًّا ؟

248
00:18:21,360 --> 00:18:23,120
اللّوم يقع على الزّعيم

249
00:18:23,120 --> 00:18:27,360
... حين خلت أنّ الابن اعتزم الاستقامة و لم تعد صوبي أيّ عقبة

250
00:18:27,360 --> 00:18:29,860
قام بتكبّد عناء إرجاعه

251
00:18:29,860 --> 00:18:33,620
إن ظلّ بالأرجاء
فلن أحظى بفرصتي قط

252
00:18:34,220 --> 00:18:38,620
لم يكن باليد حيلة
لذا حرصت على ألاّ يخرج من صدفته مجدّدًا

253
00:18:40,510 --> 00:18:46,000
مهما ناديتم أو هدَرتم
لم يعد في وسع سيّدي اليافع الخروج

254
00:18:46,000 --> 00:18:49,140
لأنه لم يتبقّى بالداخل سوى عظامه

255
00:18:49,560 --> 00:18:52,670
... سيظلّ السّيد اليافع بداخل صدَفتِه للأبد

256
00:18:52,670 --> 00:18:54,950
حتّى و إن مات الزّعيم

257
00:18:55,400 --> 00:19:00,380
هذا من سوء حظّ الزّعيم و لكن
سيتمكّن من ملاقاة ابنه العزيز في العالم الآخر

258
00:19:01,450 --> 00:19:02,580
أكان أنت ؟

259
00:19:03,600 --> 00:19:07,150
أنا أسألك إن كنت أنت من قتل (أوتسوزو)

260
00:19:15,120 --> 00:19:18,620
في الماضي ، كنتُ حسنَ عونٍ لسيّدي اليافع

261
00:19:18,780 --> 00:19:22,560
... حتّى عندما أغلق على نفسه لم يكن يرى أحدًا سواي

262
00:19:22,560 --> 00:19:24,860
ما يسّر تدبير الأمور

263
00:19:25,140 --> 00:19:28,140
لأنّه سيكون من المزعج إن حدثَت جلبة

264
00:19:28,140 --> 00:19:32,180
... الابن الغبيّ لن يخرج حتّى لو مات الزّعيم

265
00:19:32,180 --> 00:19:34,680
في المقابل فإنّ العصابة بحاجة لمن يتزعّمها

266
00:19:35,140 --> 00:19:38,820
أجل ، لا يمكن تَولية الأمور لوريثٍ غير كفء

267
00:19:38,820 --> 00:19:41,030
بل يحتاج الأمر شخصًا رفيعًا في العقل و المهارة

268
00:19:43,370 --> 00:19:45,570
أي مجرمًا حقيقيًّا

269
00:19:49,270 --> 00:19:51,320
... أنت لست مجرمًا

270
00:19:53,120 --> 00:19:54,540
بل مجرّد نذل

271
00:20:00,590 --> 00:20:01,530
!.. هذا الوغد

272
00:20:02,410 --> 00:20:05,420
يبدو أنّ السّم استهلّ مفعوله أخيرًا

273
00:20:05,420 --> 00:20:08,020
لقد بدأت أتساءل ما إن كان التّسميم يؤثّر في الحمقى

274
00:20:10,260 --> 00:20:15,500
يبدو أنّ مذاق الساكي لم يكن سيّئًا لمجرّد أنّه قد صُبّ من طرف رجل

275
00:20:16,300 --> 00:20:17,660
أنهوا أمره

276
00:20:17,660 --> 00:20:18,400
! حاضر

277
00:20:18,400 --> 00:20:19,980
! أجهزوا عليه

278
00:20:33,360 --> 00:20:34,920
! تمهّل عندك

279
00:21:01,650 --> 00:21:03,220
! لقد فعلتها

280
00:21:04,020 --> 00:21:05,750
! فلتمت يا هذا

281
00:21:51,690 --> 00:21:52,870
! اعثروا عليه

282
00:21:52,870 --> 00:21:54,970
! اعثروا عليه حتّى لو قطّرتم النّهر بأسره

283
00:21:54,970 --> 00:21:56,090
! حسنًا

284
00:22:04,030 --> 00:22:04,850
... "آنيكي"

285
00:22:06,320 --> 00:22:08,500
لقد وردنا اتّصال من المستشفى للتّو

286
00:22:09,280 --> 00:22:10,380
.. الزّعيم قد

287
00:22:10,940 --> 00:22:12,800
الزّعيم قد مات

288
00:22:15,760 --> 00:22:17,140
هكذا إذًا

289
00:22:17,420 --> 00:22:20,570
لقد فعلتها ، هكذا صارت الزعامة بيديك

290
00:22:20,570 --> 00:22:24,000
— إنّها بداية عصابة "ماشيروي" الجديدة
"بل بداية عصابة "ناكامورا

291
00:22:24,140 --> 00:22:25,430
سنغادر

292
00:22:26,400 --> 00:22:29,580
أنتم ، يكفي غطسًا بحثًا عن الأوحال

293
00:22:29,580 --> 00:22:32,860
فلنعد ، لن ينجو و هو مثخن بتلك الجراح

294
00:22:33,140 --> 00:22:36,120
!آنيكي" ، ماذا عن الطّفلان اللّذان رافقا الزّعيم ؟"

295
00:22:36,120 --> 00:22:39,160
دعك منهما ، فلا يسعهما فعل شيء بأيّ حال

296
00:22:39,160 --> 00:22:42,860
لكن يا "آنيكي" ، إن سمعَت فئة الزّعيم بكل هذا فستنشب فوضى

297
00:22:42,860 --> 00:22:45,330
! "آنيكي"

298
00:24:29,930 --> 00:24:35,440
مكان جينتوكي يظّل مجهولًا

299
00:24:30,080 --> 00:24:35,440
(شينباتشي) و (كاجورا) قلقان للغاية

300
00:24:35,440 --> 00:24:39,900
بينما (كيوجيرو) يهتمّ بمراسم التّنصيب

301
00:24:35,440 --> 00:24:39,900
... أيّ سرٍّ يقوم بإخفائه

302
00:24:39,900 --> 00:24:44,920
نراكم في المّرة القادمة