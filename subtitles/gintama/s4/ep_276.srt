1
00:01:42,690 --> 00:01:46,180
،بينما هي ضائعةٌ بين رغبتها في العيش كرجل أو امرأةٍ

2
00:01:46,690 --> 00:01:52,740
!التقت كيوبي ـ سان بقارئة طالع حوّلتها إلى رجلٍ

3
00:01:53,720 --> 00:01:56,660
.والأكثر من ذلك، فإنّ هذه الظاهرة قد أثّرت على جميع الأشخاص في مقاطعة كابوكي

4
00:01:57,270 --> 00:01:58,750
،وجين ـ سان أصبح هكذا

5
00:01:59,150 --> 00:02:00,640
،وكاغورا ـ تشان أصبحت هكذا

6
00:02:01,350 --> 00:02:03,750
.وأنا شيمورا شينباتشي، انتهى بي المطاف على هذا الوضع

7
00:02:03,990 --> 00:02:05,380
!لحظة، لماذا؟

8
00:02:06,190 --> 00:02:09,130
،والمتسبّبون في هذا هم طائفة دينيَّة متطرّفة يدعون بالديكوبوكيين

9
00:02:09,700 --> 00:02:12,640
وقد صرّحوا أنّ الذين لم يبقوا أوفياء لجنسهم الجديد

10
00:02:12,640 --> 00:02:14,970
،فذلك من شأنه أن يعرّضهم للعقاب الإلهي

11
00:02:14,970 --> 00:02:17,980
.وقد حاولوا إجبارنا على اتّخاذ معتقداتهم كدينٍ خاصٍ بنا

12
00:02:18,880 --> 00:02:21,900
،لكن بسبب الغوريلا، جميلة "تاراكازوكا ريفو" عديمة الجدوى

13
00:02:21,900 --> 00:02:23,650
انتهى الأمر بنا بلفت انتباههم

14
00:02:23,950 --> 00:02:24,650
.وتمت محاصرتنا

15
00:02:25,210 --> 00:02:28,280
.وبعد ذلك ظهروا الشينسينغومي الذين تحولوا إلى المهبلسينجومي

16
00:02:28,900 --> 00:02:30,900
،وكما كان متوقّعًا، حصل أوكيتا ـ سان على جمالٍ مبهرٍ

17
00:02:31,850 --> 00:02:33,240
...لكن هيجيكاتا ـ سان

18
00:02:48,010 --> 00:02:50,740
ما الخطب مع هؤلاء الأشخاص؟

19
00:02:51,160 --> 00:02:51,970
أيعقل أنّ

20
00:02:52,730 --> 00:02:56,390
كلاب الحكومة قد تسلّلوا إلى هذه البلدة؟

21
00:02:56,660 --> 00:02:59,150
ماذا؟ أأولئك كلابٌ، يا باتشي؟

22
00:02:59,150 --> 00:03:01,580
.أحدهنّ تبدو كخنزيرةٍ بالنسبة لي

23
00:03:01,580 --> 00:03:03,860
.تبدو مثل طوكيو ـ إكس

24
00:03:03,860 --> 00:03:05,660
ماذا يكون طوكيو ـ إكس هذا؟

25
00:03:05,660 --> 00:03:07,710
.سلالة خنازير محلّية من طوكيو

26
00:03:08,650 --> 00:03:10,350
!ذلك ليس بخنزيرةٍ، إنّه شيطان

27
00:03:10,350 --> 00:03:12,690
!إنّه هيجيكاتا ـ توشيرو ـ سان، النائب الشيطاني

28
00:03:14,130 --> 00:03:17,050
أنت تقصدين أنه ليس توشيرو ـ سان  وإنما طوكيو ـ إكس ـ شيرو ـ سان؟

29
00:03:17,050 --> 00:03:18,660
!من يكون إكس ـ شيرو هذا؟

30
00:03:18,660 --> 00:03:21,190
.فلتهدأ من فضلك، يا تينشيرو ـ سان

31
00:03:21,190 --> 00:03:22,620
!ما الذي تقصده بتينشيرو؟

32
00:03:22,620 --> 00:03:24,080
!ولمَ تحوّل إلى رقمٍ رومانيٍّ؟

33
00:03:24,620 --> 00:03:26,630
.فلتُرحه من فضلك، يا سيّد

34
00:03:27,420 --> 00:03:30,340
،في اللحظة التي تحول إليها تينشيرو ـ سان إلى امرأةٍ

35
00:03:30,340 --> 00:03:34,110
،كلّ سعرات المايونيز الحرارية المتراكمة بداخله قد فُرزت

36
00:03:34,110 --> 00:03:35,680
.مما جعلته ينتهي بهذا الشكل

37
00:03:35,680 --> 00:03:38,210
!كما لو أنّ تحولي لامرأة ليس كافٍ

38
00:03:38,210 --> 00:03:39,840
!لمَ أنا الوحيد الذي يبدو هكذا؟

39
00:03:39,840 --> 00:03:41,830
.لا داعي للقلق، يا تينكو

40
00:03:41,830 --> 00:03:43,370
ألسنا في نفس الحالة جميعًا؟

41
00:03:43,370 --> 00:03:47,060
.فأنا أيضًا، كلّ الغوريلا المتراكمة بداخلي قد فُرزت للخارج

42
00:03:47,060 --> 00:03:49,600
.على الرغم من مظهري هذا، إلاّ أن شعر مؤخرتي مستمرٌّ في الانتشار

43
00:03:49,600 --> 00:03:51,360
!ماذا تقصد بـ"الغوريلا المتراكمة"؟

44
00:03:51,360 --> 00:03:52,990
!ماذا تقول بهذا الوجه الجميل؟

45
00:03:53,210 --> 00:03:54,440
.هذا صحيح، يا تينكو

46
00:03:54,440 --> 00:03:57,910
،جميع الفتيات يبذلن ما بوسعهنّ في الخفاء

47
00:03:57,910 --> 00:03:59,890
.إذا كنت ترغبين باتّباع حمية، فسأنضم إليكِ

48
00:03:59,890 --> 00:04:01,470
.حسنٌ، يا فتيات

49
00:04:01,470 --> 00:04:03,590
.لدينا لحم خنزير مشويّ اليوم

50
00:04:03,590 --> 00:04:05,920
!كلّ السادية المتراكمة بداخلك قد فرزت للخارج

51
00:04:05,920 --> 00:04:08,610
!يا إلهي، لقد مضت فترة طويلة منذ أن تناولت الشواء

52
00:04:08,610 --> 00:04:10,090
.أعتقد أنني سآكل حتّى التّخمة

53
00:04:10,090 --> 00:04:12,390
.ولكن علينا التأكد من أن لا نحصل على رائحة فم كريهة

54
00:04:12,390 --> 00:04:13,250
!أوي

55
00:04:13,250 --> 00:04:14,790
!ما الذي تفعلونه أيّها المتحولون جنسيًا؟

56
00:04:14,790 --> 00:04:16,510
!أهذا هو الوقت لفعل ذلك؟

57
00:04:17,360 --> 00:04:20,050
،إذا كنتم تنوون الوقوف في طريقنا

58
00:04:20,910 --> 00:04:23,270
.فسوف نلقي القبض عليكم جميعًا رفقة الزنادقة

59
00:04:23,540 --> 00:04:28,770
.للأسف، فأنتم هم الزنادقة في نظرنا

60
00:04:28,770 --> 00:04:32,530
!لن نسمح لكم بفعل ما تريدونه بهذه البلدة

61
00:04:35,780 --> 00:04:36,770
...أيّها

62
00:04:36,770 --> 00:04:37,990
!الزنادقة اللعينين...

63
00:04:40,370 --> 00:04:43,090
.لا داعي للقلق، أيّها الديكوبوكيون

64
00:04:43,090 --> 00:04:45,510
،إذا تجرّأ أحدٌ ما على تحدي الإله ديكوبوكو

65
00:04:45,510 --> 00:04:49,480
!فنحن المهبلسينجومي، سنلقي بهم في السجن

66
00:04:51,240 --> 00:04:52,880
...مستحيل، أنتم

67
00:04:53,280 --> 00:04:58,510
.آسفةٌ، ولكننا قد قدمنا لحماية هذه البلدة من الزنادقة أمثالكم

68
00:04:58,930 --> 00:05:03,170
.إنّ الحكومة تخطط بالفعل للاعتماد على العقيدة الديكوبوكية كدينٍ للدّولة

69
00:05:03,170 --> 00:05:04,520
!مـ..مستحيل

70
00:05:04,920 --> 00:05:10,730
.وقد أُرسلنا إلى هنا أساسًا لاتخاذ إجراءات صارمة ضد الزنادقة الذين يتحدون دين الدولة

71
00:05:11,040 --> 00:05:14,420
،إذا لم تستطيعوا فهم مدى روعة هذه التعاليم

72
00:05:14,420 --> 00:05:16,020
.فسأشعر بالأسف عليكم

73
00:05:16,820 --> 00:05:18,100
،حتّى تتم تسوية الأمور

74
00:05:18,100 --> 00:05:21,420
.فنحن المهبلسينجومي سنهتمّ بأمر الزنادقة

75
00:05:21,420 --> 00:05:23,370
أيمكنكم ترك الأمر لنا؟

76
00:05:24,400 --> 00:05:26,880
.حسناً، أيّتها الرفيقات

77
00:05:28,080 --> 00:05:29,800
بهذا التفكير الرائع

78
00:05:29,800 --> 00:05:33,170
.فأنا متأكّدة من أنّ الإله ديكوبوكو يبتسم من أجلكم من السماوات

79
00:05:35,290 --> 00:05:39,430
.دعونا نعمل معًا لتصحيح أدوار الجنسين بانتظامٍ في هذا الكوكب

80
00:06:01,640 --> 00:06:03,580
.لقد اكتمل الاختراق

81
00:06:04,070 --> 00:06:07,020
.والآن كاميرات المراقبة في هذه المنطقة لن تسبب لنا أيّ مشاكلٍ

82
00:06:07,020 --> 00:06:08,080
.حسنٌ

83
00:06:08,570 --> 00:06:10,210
ماذا عن تلك؟

84
00:06:10,210 --> 00:06:11,380
كما ترين

85
00:06:11,670 --> 00:06:15,380
.فلقد استولوا على جميع كاميرات المراقبة في هذه البلدة

86
00:06:15,730 --> 00:06:17,970
،حاولوا فعل أيّ شيءٍ مضحكٍ مثلما فعلتم مسبقًا

87
00:06:17,970 --> 00:06:19,880
.وسوف يأتون إليكم على الفور

88
00:06:20,670 --> 00:06:22,950
،إذا أُقحمنا في معركة كبيرةٍ

89
00:06:22,950 --> 00:06:26,890
.فكلّ من في الأرض سينتهي به المطاف مثل مقاطعة كابوكي

90
00:06:26,890 --> 00:06:28,740
ما الذي ترغب بقوله؟

91
00:06:28,740 --> 00:06:33,550
.إذا واصلت في أفعالك الغبية، فنحن لن نكون قادرين على التغطية عليك

92
00:06:33,550 --> 00:06:36,420
فقط للتوضيح، فكلّ ما حدث كان

93
00:06:36,420 --> 00:06:38,130
...بسبب رئيسكم المغفل الذي تغوط في الخلاء

94
00:06:38,130 --> 00:06:40,930
...لم يكن تغوّطًا في الخلاء! وإنمّا كان تغوّط حرّ طليق

95
00:06:40,930 --> 00:06:41,910
تغوّط في الخلاء، أليس كذلك؟

96
00:06:42,460 --> 00:06:46,200
هل كنتم تتعقبون هذه الطائفة قبل أن يحدث هذا؟

97
00:06:46,940 --> 00:06:50,680
لقد تلقّينا تقارير حول جماعة دينيّة على قوائم المطلوبين الفضائية

98
00:06:50,680 --> 00:06:52,730
.حيث كانت تخطط الولوج إلى الأرض

99
00:06:53,220 --> 00:06:57,050
،وحين اكتشفنا أنّهم جعلوا من هذه البلدة قاعدة لهم

100
00:06:57,390 --> 00:07:01,760
.ولكننا لم نتوقع منهم استخدام "الإله" بشكلٍ مبكّرٍ

101
00:07:01,760 --> 00:07:04,150
.وبهذا انتهى بنا المطاف نحن أيضًا وسط هذه الفوضى

102
00:07:04,150 --> 00:07:05,050
الإله"؟"

103
00:07:05,460 --> 00:07:09,560
.هناك قمرٌ اصطناعيٌّ يدور حول الأرض في الفضاء

104
00:07:10,230 --> 00:07:13,560
.وذلك هو "الإله" الذي يعبدونه

105
00:07:14,290 --> 00:07:17,570
ولتعزيز مذهبهم، فالديكوبوكيون كانوا يبحثون

106
00:07:17,570 --> 00:07:21,070
.عن عقارٍ من شأنه يؤثّر في توازن هرمونات الجسم البشري

107
00:07:21,610 --> 00:07:28,510
.بعبارةٍ أخرى، هو عقارٌ بإمكانه أن يجعل من الرّجال أكثر رجولة، ومن النساء أكثر أنوثة

108
00:07:28,510 --> 00:07:31,660
لكن انتهى المطاف بتجاربهم بصناعة شيء غير متوقّعٍ

109
00:07:31,990 --> 00:07:35,130
.وهو الفيروس الذي أُصبنا به الآن

110
00:07:35,570 --> 00:07:37,230
!عقارٌ يحوّل البشر إلى خنازير؟

111
00:07:37,230 --> 00:07:38,300
!ليس هذا ما أقصده

112
00:07:39,050 --> 00:07:44,230
.بدؤوا عملياتهم التبشيريّة المتطرّفة الإرهابية بعد ذلك

113
00:07:44,840 --> 00:07:46,010
.صحيح

114
00:07:46,010 --> 00:07:48,790
.لكن ذلك النور لم يكن عقابًا إلهيًا

115
00:07:49,350 --> 00:07:54,350
.بل كان فيروسًا عاكسًا للهرمونات أُطلق من قمر صناعيٍّ

116
00:07:55,310 --> 00:07:59,680
.في النّهاية، فإنّ كلّ هذه الفوضى قد تسبّب فيها بعض البشر القذرين

117
00:07:59,680 --> 00:08:02,720
ولكن، لماذا قاموا بتحويلك إلى خنزيرٍ قذرٍ؟

118
00:08:02,720 --> 00:08:04,360
من الذي تدعينه بالخنزير القذر؟

119
00:08:05,320 --> 00:08:08,450
،الباكفو وضع هذه البلدة تحت الحجر الصحيّ

120
00:08:08,450 --> 00:08:11,550
.لكن الفيروس لا يبقى في الهواء طويلاً

121
00:08:11,550 --> 00:08:14,370
.إضافةً لذلك، فهو ليس مُعدٍ حتّى

122
00:08:14,680 --> 00:08:19,800
بمعنى أنّ تاي ـ تشان لن تُصاب بالفيروس وتتحول إلى شيمورا تاي ـ إكس؟

123
00:08:20,630 --> 00:08:21,840
.حمدًا لله

124
00:08:21,840 --> 00:08:23,140
،جيوبي ـ سان

125
00:08:23,140 --> 00:08:24,880
.شكرًا على قلقكَ

126
00:08:26,390 --> 00:08:28,920
والمشكلة هي كيفية إيقاف ذلك القمر الصناعيّ

127
00:08:28,920 --> 00:08:31,600
.وطريقة الحصول على لقاحٍ يمكّن من إعادة أجسادنا إلى الوضع الطبيعي

128
00:08:32,350 --> 00:08:35,390
.لكن على الأرجح أننا لن نتمكّن من فعل شيءٍ تجاه القمر الصناعيّ

129
00:08:35,960 --> 00:08:37,610
على ما يبدو فإنّه يملك نظامًا

130
00:08:37,610 --> 00:08:41,440
.يمكّنه من إطلاق فيروس تلقائيٍّ نحو الأرض كلّما كشف أي مخالفات

131
00:08:43,960 --> 00:08:45,730
.ليس بيدنا حيلة

132
00:08:46,850 --> 00:08:51,850
أتقصد أنه علينا مواجهة الطائفة بشكٍل مباشرٍ لإصلاح الأمور؟

133
00:08:52,300 --> 00:08:56,330
ونحن الوحيدون الذين بإمكانهم فعل هذا بهذه الأجساد؟

134
00:08:56,330 --> 00:08:57,630
.أجل

135
00:08:57,630 --> 00:09:01,540
،علينا أن نفلت من رقابتهم، ونعثر على قاعدتهم

136
00:09:01,540 --> 00:09:05,550
.ونلقي القبض عليهم جميعًا قبل أن يضغطوا على زر الدمار

137
00:09:05,550 --> 00:09:07,880
.إذا كان هذا ممكنًا من الأساس

138
00:09:08,140 --> 00:09:09,780
...مستحيل! هذا غير ممكـ

139
00:09:09,780 --> 00:09:10,930
.بل ممكن

140
00:09:11,260 --> 00:09:13,510
،"بغض النظر عن مدى القوة التي تملكها "واي

141
00:09:11,260 --> 00:09:15,230
واي .. تشوو .. وو:  الممالك الثلاث التي كانت تتنافس على حكم الصين بعد سقوط سلالة الهان

142
00:09:13,510 --> 00:09:15,220
"فإذا تعاون كلٌّ من "تشوو" و "وو

143
00:09:15,220 --> 00:09:16,730
!فبإمكانهما مجابهتها بكل تأكيدٍ

144
00:09:17,190 --> 00:09:18,450
!إنّها معركة المنحدرات الحمراء

145
00:09:18,450 --> 00:09:20,940
!لنقضي على تساو تساو معًا

146
00:09:20,940 --> 00:09:22,880
!من الذي تقاتلين ضده؟

147
00:09:22,880 --> 00:09:25,030
!أيضًا، أليس من المفترض أن تكوني في معسكر تساو تساو؟

148
00:09:25,830 --> 00:09:28,690
.حسنٌ، إذا كانت هذه هي الطريقة لعودة جسدي لوضعه الطبيعي، فلا خيار لديّ

149
00:09:28,690 --> 00:09:31,070
.ويمكنني الاستعانة بمساعدة الخنازير حتّى

150
00:09:31,070 --> 00:09:32,510
ما الذي تقصده بكلامك؟

151
00:09:32,510 --> 00:09:33,800
.ما باليد حيلة

152
00:09:33,800 --> 00:09:35,880
.لكننا سنتخلّى عنك إن كنت عديمة الفائدة

153
00:09:35,880 --> 00:09:38,140
.من الأفضل ألا تعرقلنا بحوافر الخنزير خاصتك

154
00:09:38,140 --> 00:09:41,920
!أيمكنكما أيها الساديان اللعينان أن تتحدثا بدون إضافة "خنزير" في كل شيء؟

155
00:09:42,040 --> 00:09:42,920
!حسنٌ

156
00:09:42,920 --> 00:09:45,250
!من الآن، نحن رفيقاتٌ في القتال

157
00:09:45,250 --> 00:09:46,380
...ومن أجل الاحتفال بتحالفنا

158
00:09:47,140 --> 00:09:49,150
!سنعدّ خنزير مشويٌّ

159
00:09:49,150 --> 00:09:50,740
"عهد حديقة الخنزير: تهكم على "عهد حديقة الخوخ" وهو حدث وهمي في رواية تتحدث عن حقبة الممالك الثلاثة في الصين تحت عنوان "رومانسية الممالك الثلاث

160
00:09:49,150 --> 00:09:50,740
!وسيكون بمثابة عهد حديقة الخنزير

161
00:09:50,740 --> 00:09:52,430
!عدنا لهذا مجدّدًا؟

162
00:10:03,430 --> 00:10:08,350
.أولاً، علينا أن نهتمّ بأمر كاميرات المراقبة المتواجدة في كلّ مكانٍ

163
00:10:08,350 --> 00:10:10,530
.بهذا الوضع، لا يمكننا القيام بأيّ شيءٍ

164
00:10:10,760 --> 00:10:13,780
.سنوصل هذا بكلّ كاميرا نعثر عليها

165
00:10:14,510 --> 00:10:20,290
.سوف يخترق الكاميرا، ويجعها تبدأ في بثّ مقطعٍ مسجلٍ سابقًا

166
00:10:20,570 --> 00:10:21,460
.أنصتوا

167
00:10:21,460 --> 00:10:24,540
.إذا لاحظونا، سوف ينتهي كلّ شيءٍ

168
00:10:24,540 --> 00:10:25,870
،تصرّفا بشكلٍ طبيعيٍّ قدر الإكمان

169
00:10:25,870 --> 00:10:28,300
،وحاولا التصرّف بالأخذ بتعاليم العقيدة الديكوبوكية في الحسبان

170
00:10:28,650 --> 00:10:29,800
.وتصرّفا بأنوثةٍ

171
00:10:34,920 --> 00:10:36,090
.هيّا بنا

172
00:10:38,590 --> 00:10:41,500
!أنتما، سوكو، جينكو

173
00:10:38,590 --> 00:10:41,500
"ملاحظة المترجم: غالباً ما تنتهي الأسماء اليابانية للإناث بـ"كو

174
00:10:41,950 --> 00:10:44,400
...لم لا نذهب إلى مقهى ونتناول بعضًا من أطباق المايونـ

175
00:10:44,910 --> 00:10:46,940
.لا وجود لفتياتٍ هكذا

176
00:10:47,510 --> 00:10:50,000
ما الذي تقومين به، يا جينكو؟

177
00:10:50,000 --> 00:10:52,330
ردّكِ كان عنيفًا للغاية. ألستِ فتاة؟

178
00:10:52,330 --> 00:10:53,260
!آسفة

179
00:10:53,260 --> 00:10:57,540
!لكنها كانت غلطتكِ يا تينكو لتحدّثك عن أطباق المايونيز بعدما قررتِ اتّباع حمية

180
00:10:57,540 --> 00:10:59,410
.صـ..صحيح

181
00:10:59,410 --> 00:11:01,690
الفتيات يتّبعن حمية طوال السنة، أليس كذلك؟

182
00:11:01,690 --> 00:11:02,620
!صحيح

183
00:11:02,620 --> 00:11:06,330
.دائما ما تتجهين إلى تناول المزيد من السعرات الحرارية حينما يتشوش رأيكِ

184
00:11:06,330 --> 00:11:08,800
...حسنٌ، دعونا نستمتع جميعًا بطبق أوجيجينتوكي

185
00:11:08,800 --> 00:11:10,550
.لا وجود لفتياتٍ هكذا أيضًا

186
00:11:11,430 --> 00:11:13,090
ما الذي تفعلينه، يا تينكو؟

187
00:11:13,090 --> 00:11:15,610
ألا تعلمين أن جميع الفتيات يحبون الحلويات؟

188
00:11:16,380 --> 00:11:18,930
!هذه ليست بحلوياتٍ، بل هي وحش حلويات

189
00:11:18,930 --> 00:11:20,440
!وحش السعرات الحرارية

190
00:11:20,440 --> 00:11:22,570
!وحش السعرات الحرارية هو أنتِ

191
00:11:22,570 --> 00:11:24,700
،كما ترين، فأنا أملك جسدًا جميلاً

192
00:11:24,700 --> 00:11:26,280
.لذا لستُ بحاجة إلى حميةٍ

193
00:11:26,280 --> 00:11:28,560
ماذا؟ تملكين جسدًا جميلاً؟

194
00:11:28,560 --> 00:11:30,350
كفاكِ هراءً

195
00:11:30,350 --> 00:11:34,360
.الجسد الجميل يكون فاتنًا بقليلٍ من اللحم على العظام، يا جينكو

196
00:11:34,360 --> 00:11:36,910
.جسدك أقرب للبشاعة، يا تينكو

197
00:11:36,910 --> 00:11:39,700
.لا تغترّي بنفسكِ فقط لأنك نحيلة

198
00:11:39,700 --> 00:11:42,730
.تذكّري كلماتي، سأفوقك جمالاً حين أفقد الوزن

199
00:11:42,730 --> 00:11:48,650
ما الذي تقولينه؟ جينكو خاصَّتي أجمل ولها
.أثداءٌ أكبر وبإمكانها فعل كل الأمور المنحرفة

200
00:11:48,650 --> 00:11:52,180
لو كنت رجلًا، لتجنَّبت عاهرةً مثلك

201
00:11:52,180 --> 00:11:53,680
!وسأختار تينكو بالتأكيد

202
00:11:54,000 --> 00:11:55,970
!لا بأس إذًا، أيَّتها الوغدة

203
00:11:55,970 --> 00:11:58,440
أترغبين بإقامة منافسةٍ لمعرفةٍ من أكثر شعبيِّةً بين الرجال؟

204
00:11:58,440 --> 00:11:59,680
!هلمِّي بما لديك

205
00:11:59,960 --> 00:12:02,590
!لنحسم هذا بمنافسةٍ يختار الرجال فيها أحدنا

206
00:12:02,590 --> 00:12:05,270
!أوي! ما الذي تفعلانه؟

207
00:12:05,270 --> 00:12:09,050
!ما هدفهما من المجيء إلى هنا؟ لقد اختلفت أولوياتهما تمامًا

208
00:12:09,050 --> 00:12:11,640
!سوكو-سان، عليكِ إخبارهما بشيءٍ ما

209
00:12:11,640 --> 00:12:15,340
.يا إلهي، لا يملكان أدنى فكرةٍ عن معنى الأنوثة

210
00:12:15,340 --> 00:12:17,140
...فتيات هذه الأيام

211
00:12:18,200 --> 00:12:19,480
!سيّدي

212
00:12:19,480 --> 00:12:21,360
أتودُّ المرح مع فتاة في المرحلة الثانوية؟

213
00:12:21,360 --> 00:12:24,620
!أي أنوثةٍ هذه؟ لقد تحوَّلتِ لعاهرةٍ كبيرة وحسب

214
00:12:24,940 --> 00:12:28,670
أنت تملك الكثير من المال يا سيِّدي، أليس كذلك؟

215
00:12:29,860 --> 00:12:30,670
،آسف

216
00:12:31,690 --> 00:12:33,030
.ولكنِّي فتاة ثانويِّةٍ أيضًا

217
00:12:33,030 --> 00:12:34,570
!أي فتاةٍ ثانويَّةٍ هذه؟

218
00:12:34,570 --> 00:12:35,930
فتاةُ مفلسة

219
00:12:35,930 --> 00:12:37,680
!هذا ليس ممتعًا

220
00:12:39,400 --> 00:12:42,180
.آمل أن يحالف جينكو-سان والرفاق التوفيق

221
00:12:42,530 --> 00:12:46,070
.الشينسنغومي برفقتهم لذلك لا داعي للقلق

222
00:12:46,070 --> 00:12:48,690
.ما يقلقني هو الشينسغومي بذاتهم

223
00:12:49,270 --> 00:12:53,640
...ولكن، التعامل بأنثويَّةٍ لادِّعاء اتبعاهم التعاليم

224
00:12:53,640 --> 00:12:55,700
قد يكون هذا غير لائقٍ، ولكن بوسعي تعلٌّم الكثير منهم

225
00:12:56,100 --> 00:12:59,350
.فأنا لا أفكٍّر أبدًا بمثل هذه الأمور

226
00:13:00,120 --> 00:13:01,750
تاي-تشان

227
00:13:01,750 --> 00:13:02,950
.لا بأس بما أنتِ عليه

228
00:13:04,090 --> 00:13:07,980
.فأنتِ تتحلِّين بأنوثةٍ كافية

229
00:13:07,980 --> 00:13:09,780
،لا حاجة لتتغيَّري

230
00:13:09,780 --> 00:13:11,240
.ولا أريدك أن تتغيَّري كذلك

231
00:13:11,240 --> 00:13:12,960
شكرًا لك

232
00:13:14,990 --> 00:13:17,970
...يا إلهي، كلامك أربكني قليلاً

233
00:13:18,830 --> 00:13:20,910
،أعلم بأنَّه أنتِ يا كيو-تشان

234
00:13:20,910 --> 00:13:23,840
.ولكن، أشعر وكأنِّي أتحدث مع رجلٍ

235
00:13:26,880 --> 00:13:28,470
آسفة

236
00:13:28,470 --> 00:13:30,710
!هناك كاميرا مراقبة هناك

237
00:13:30,710 --> 00:13:32,320
!سأعتني بها

238
00:13:32,990 --> 00:13:33,610
!تاي-تشان

239
00:13:34,100 --> 00:13:35,820
!لا حاجة لأن تفعلي أي شيءٍ

240
00:13:39,010 --> 00:13:40,020
!انتظري يا تاي-تشان

241
00:13:51,150 --> 00:13:51,970
هل ذهبوا؟

242
00:13:54,170 --> 00:13:56,010
!تاي-تشان

243
00:13:56,010 --> 00:13:57,490
آسف

244
00:13:57,490 --> 00:13:58,810
...لا

245
00:13:58,810 --> 00:14:02,930
...أنا ... آسفة... أيضًا

246
00:14:02,930 --> 00:14:05,720
...لقد فزعت وأصابني الهلع

247
00:14:06,150 --> 00:14:09,520
...انظر، هنالك كاميرا مراقبة أخرى

248
00:14:09,770 --> 00:14:10,520
تاي-تشان

249
00:14:13,190 --> 00:14:15,760
لا بأس

250
00:14:19,210 --> 00:14:21,160
...فهكذا

251
00:14:21,880 --> 00:14:25,490
،لو ادَّعينا أننا عاشقين

252
00:14:25,490 --> 00:14:27,090
.فلن نثير الشبهات

253
00:14:29,690 --> 00:14:32,270
ما الذي أهذي به؟

254
00:14:32,270 --> 00:14:34,290
ما الذي أفعله؟

255
00:14:35,730 --> 00:14:39,620
.أنا من تسببت بهذه الفوضى

256
00:14:40,270 --> 00:14:44,850
مهمَّتي ومسؤوليَّتي هي تنظيفها

257
00:14:45,640 --> 00:14:48,000
...إذًا، لمَ هذا الوضع

258
00:14:48,000 --> 00:14:49,450
...لمَ التحوُّل لرجل

259
00:14:49,450 --> 00:14:51,310
يُشعرني بالبهجة؟

260
00:14:51,960 --> 00:14:54,820
.أعلم أنَّ هذا ليس بالوقت ولا المكان المناسب

261
00:14:54,820 --> 00:14:58,190
!ولكن، لم يعد بوسعي تفادي النظر لها

262
00:15:08,510 --> 00:15:09,600
،أعني

263
00:15:09,600 --> 00:15:12,570
!كوني رجلاً يسمح لي بمواعدة تاي-تشان

264
00:15:16,760 --> 00:15:17,890
عاشقين؟

265
00:15:17,890 --> 00:15:19,340
.ربما تكون هذه فكرةٌ حسنة

266
00:15:19,920 --> 00:15:21,260
...ولكن

267
00:15:21,260 --> 00:15:26,200
أليس ادِّعاء الأشقاء حبُّهم لبعض أمرٌ يثير الشائعات؟

268
00:15:26,200 --> 00:15:27,640
ما رأيك يا كوندو-سان؟

269
00:15:28,060 --> 00:15:29,370
.يا إلهي

270
00:15:29,370 --> 00:15:33,760
.ولكن، لا أمانع أن أكون مادةً للشائعات مع وسيمٍ كهذا

271
00:15:33,760 --> 00:15:35,900
.كن لطيفًا معي يا عزيزي

272
00:15:59,440 --> 00:16:00,770
يا أخي

273
00:16:00,770 --> 00:16:02,160
...أترغب ببعض القهوة مع

274
00:16:02,160 --> 00:16:03,650
!لست بأخيكِ

275
00:16:03,650 --> 00:16:05,010
!أنا عجوز

276
00:16:08,350 --> 00:16:09,710
.أيُّها الأخ

277
00:16:09,710 --> 00:16:11,500
...أترغب ببعض القهوة معـ

278
00:16:10,800 --> 00:16:12,310
اخرسي، أيَّتها السمينة

279
00:16:16,270 --> 00:16:20,770
.لقد نسيت أنَّ كل الرجال في هذه المدينة حاليًا أصلهم نساء

280
00:16:20,770 --> 00:16:23,780
.لقد نسيت أنِّي سمينةٌ حاليًا

281
00:16:23,780 --> 00:16:24,810
!تبًّا

282
00:16:24,810 --> 00:16:28,050
!سأُظهر لك بالتأكيد أنَّ جينكو أكثر شعبيةً منك

283
00:16:28,050 --> 00:16:28,940
!كفاكِ هراءً

284
00:16:28,940 --> 00:16:31,080
.العاهرات المجنونات مثلكِ هم من يُهجرون في النهاية

285
00:16:31,080 --> 00:16:35,660
!فالرجال دائمًا يعودون للمنزل راغبين في حنان تينكو

286
00:16:36,320 --> 00:16:37,400
!يا أخي

287
00:16:37,400 --> 00:16:38,880
!أترغب بتناول القهوة معي؟

288
00:16:39,120 --> 00:16:43,380
.سُحقًا، لقد سئمت تمامًا من رجال هذه البلدة

289
00:16:43,600 --> 00:16:47,380
تحاولان مواعدة الرجال متجاهلين إيجاد حلٍّ لهذه الأزمة؟

290
00:16:49,730 --> 00:16:51,190
...كاميرات المراقبة

291
00:16:51,760 --> 00:16:54,570
...لقد أدركت الأمر بعدما تحوَّلت لرجل

292
00:16:54,570 --> 00:16:58,270
.بأن رجال هذا العالم مثيرون للشفقة وعديمي الفائدة

293
00:17:00,090 --> 00:17:02,300
فلتغربوا، أيَّتها الخنازير

294
00:17:05,150 --> 00:17:06,820
كيف سار الأمر، جينكو-سان؟

295
00:17:07,220 --> 00:17:10,220
،استطعنا التخلص ممَّا يعادل عشرون كاميرا تقريبًا

296
00:17:10,220 --> 00:17:12,780
.ولكن، عدد الكاميرات يفوق ما تصوَّرناه

297
00:17:12,780 --> 00:17:15,830
.لا يُمكننا تحديد عدد الكاميرات المنتشرة في مقاطعة كابوكي

298
00:17:16,300 --> 00:17:18,570
.حقًا، لا أعلم إن كان بمقدورنا التخلص منها كلَّها

299
00:17:19,270 --> 00:17:23,750
.ليس بوسعنا البحث عن قاعدة الطائفة حتَّى نعطِّل مراقبتهم لنا

300
00:17:23,750 --> 00:17:26,760
.لا نملك خيارًا آخر سوى متابعة ما نفعله يا عزيزي

301
00:17:26,760 --> 00:17:28,210
!من الذي تدعوه  بعزيزك؟

302
00:17:28,210 --> 00:17:31,950
ألسنا زوجًا من الملاحقين اعتادوا على تتبُّع نفس الشخص؟

303
00:17:31,950 --> 00:17:34,360
.أعتقد أنَّه بإمكاننا بناء علاقةٍ خصبة طويلة الأمد

304
00:17:34,360 --> 00:17:35,220
!وكأن هذا سيحدث

305
00:17:35,220 --> 00:17:36,540
إيَّاك ولمسي بعد الآن

306
00:17:36,540 --> 00:17:37,870
!سأمزقك إربًا لو حاولت ذلك

307
00:17:37,870 --> 00:17:39,350
يكفي

308
00:17:39,910 --> 00:17:41,770
.لقد سبق وحُلَّ الأمر

309
00:17:42,890 --> 00:17:44,830
...ماذا تعني بـ"لقد سبق و

310
00:17:47,140 --> 00:17:48,750
كما قالت

311
00:17:48,750 --> 00:17:52,780
لم يتبقَّ هناك كاميرا مراقبةٍ واحدة في هذه البلدة

312
00:17:53,570 --> 00:17:57,060
،بينما كنتم تلهون بعدما تحوَّلتم لنساء

313
00:17:57,060 --> 00:18:01,290
!فنحن الرجال، اعتنينا بكل شيء

314
00:18:01,840 --> 00:18:03,290
...إنَّ الكاميرات

315
00:18:03,290 --> 00:18:04,130
...ما

316
00:18:08,220 --> 00:18:10,970
!من هذه الشخصيَّة ذو النظارات التي تحاول سرقة دوري؟

317
00:18:11,470 --> 00:18:14,090
...فعل شيءٍ واضحٍ كهذا سيجذب انتبهاهم وحسب

318
00:18:14,090 --> 00:18:15,470
.لا حاجة للقلق

319
00:18:16,630 --> 00:18:19,590
،إن لم ترغب بأن يكشفك أحدٌ، فالتخلص من أعينهم غير كافٍ

320
00:18:19,590 --> 00:18:23,900
!عليك القضاء على كل شيءٍ متضمنًا آذانهم وأفواههم وأيديهم وأقدامهم مرةً واحدة

321
00:18:24,510 --> 00:18:26,520
،وبالتالي أولئك الأوغاد المختبئون تحت الأرض

322
00:18:26,520 --> 00:18:30,400
.ستنقطع عنهم مصادر معلوماتهم

323
00:18:33,120 --> 00:18:34,910
والآن علينا الانتظار وحسب

324
00:18:35,220 --> 00:18:37,790
!حتَّى يُخرجون رؤوسهم سعيًا لاستنشاق الهواء

325
00:18:40,080 --> 00:18:42,470
لا أحتاج للجبناء

326
00:18:42,470 --> 00:18:44,780
!فليأتي الرجال الحقيقيون وحسب

327
00:18:52,930 --> 00:18:53,760
ماذا؟

328
00:18:54,310 --> 00:18:56,630
تم تدمير كل كاميرات المراقبة؟

329
00:18:56,630 --> 00:18:57,250
نعم

330
00:18:57,250 --> 00:18:59,190
.لقد تم تدميرهم جميعًا من نقطةٍ عمياء

331
00:18:59,580 --> 00:19:02,330
.ولم تسجِّل أي كاميرا الفاعل الحقيقي

332
00:19:02,330 --> 00:19:06,520
.وفقدنا الاتصال تمامًا مع دوريتنا التي في الخارج في نفس الوقت

333
00:19:07,100 --> 00:19:09,610
.مستحيل. ليس بوسع أحدٍ فعل هذا

334
00:19:09,610 --> 00:19:11,900
.على أي حال، ليس بوسعنا تجاهل الوضع

335
00:19:12,120 --> 00:19:12,960
!انتظري

336
00:19:12,960 --> 00:19:16,050
!أمرنا رئيس الأساقفة بعدم ترك مراكزنا مهما حدث

337
00:19:16,050 --> 00:19:17,180
!هذه حالةٌ طارئة

338
00:19:17,180 --> 00:19:18,840
...هذا ليس وقت القلق

339
00:19:24,540 --> 00:19:25,750
اطمئنوا

340
00:19:26,560 --> 00:19:29,750
.نحن رفاقٌ نتبع العقيدة الديكوبوكيَّة

341
00:19:30,030 --> 00:19:33,890
.على الرجال الاتصاف بالرجولة وعلى الإناث الاتصاف بالأنوثة

342
00:19:33,890 --> 00:19:38,430
.وأتينا هنا لنثبت إخلاصنا للعقيدة الديكوبوكيَّة

343
00:19:39,650 --> 00:19:43,940
!راقبوا وتمعَّنوا! فنحن رجال هذا الكوكب

344
00:19:44,180 --> 00:19:46,410
!أيُّها الأوغاد

345
00:19:47,150 --> 00:19:48,860
!فلننطلق

346
00:19:49,070 --> 00:19:53,950
!اجعلهم يندمون على تحويلنا لرجال

347
00:20:00,830 --> 00:20:02,050
...حسنٌ

348
00:20:02,690 --> 00:20:04,500
ما خطب أولئك الفتية؟

349
00:20:04,500 --> 00:20:07,570
...أعني، بالرغم من أنَّهم كانوا فيتاتٍ مسترجلاتٍ قبل التحوُّل

350
00:20:11,390 --> 00:20:13,720
!لكنّهم ذوي مواصفاتٍ فائقة الآن

351
00:20:15,790 --> 00:20:20,100
!إنَّهم أكثر رجولةٌ منَّا عندما كنَّا رجالًا

352
00:20:20,490 --> 00:20:24,100
!إنَّهم يملكون الحلول لكل شيء والمصاعب أمامهم ليست سوى مجرَّد مزحة

353
00:20:24,510 --> 00:20:27,600
!إنَّهم يستولون على الأضواء بالكامل

354
00:20:27,930 --> 00:20:31,090
.أنتم، لا يُمكننا السماح للنساء بهزيمتنا

355
00:20:31,090 --> 00:20:32,570
!لا تخسروا أمامهم

356
00:20:32,570 --> 00:20:36,280
!مهبلسينجومي، تحرَّكوا

357
00:20:45,450 --> 00:20:47,550
.سأدافع عن هذا المكان حتَّى النهاية

358
00:20:47,550 --> 00:20:49,660
.اسبقوني واعتمدوا علي

359
00:20:49,660 --> 00:20:51,340
!نسبقك إلى أين؟

360
00:20:51,340 --> 00:20:53,750
!أتعتقد أن بإمكانك تبرير الأمر بهذه السهولة؟

361
00:20:53,750 --> 00:20:56,180
!ابتعد عن الفتحة

362
00:20:56,180 --> 00:20:58,060
.لقد انتهى أمري

363
00:20:58,060 --> 00:21:00,770
.أعلم جسدي أكثر من أي أحدٍ آخر

364
00:21:00,770 --> 00:21:01,730
!اتركوني واذهبوا

365
00:21:01,730 --> 00:21:02,890
!أنت لا تفهم الأمر

366
00:21:02,890 --> 00:21:04,630
!لقد علقت لأنك لا تفهم

367
00:21:04,630 --> 00:21:07,460
!لن تتمكّن أبدًا من سرقة الأضواء وأنت تسدُّ الطريق

368
00:21:07,460 --> 00:21:08,930
.اهدأ يا هيجيكاتا ـ سان

369
00:21:08,930 --> 00:21:10,470
.سأساعدك على الخروج

370
00:21:10,470 --> 00:21:11,980
."تنفَّس بهذا الشكل "هي، هي، هو

371
00:21:11,980 --> 00:21:12,830
.هيًّا معًا

372
00:21:12,830 --> 00:21:14,490
"هي، هي، هو"

373
00:21:14,490 --> 00:21:16,860
!أنا لست بامرأةٍ حاملٍ، أيُّها الأحمق

374
00:22:51,960 --> 00:22:53,250
...علِّمينا

375
00:22:53,250 --> 00:22:55,380
!يا جينكو-سينسي

376
00:22:55,860 --> 00:22:59,750
حسنٌ، لقد حان وقت
"علِّمينا يا جينكو-سينسي"

377
00:22:59,750 --> 00:23:02,170
وليس كمانجا "الآنسة ماتشيكو" أو
."انتبهي! لونا-سينسي"

378
00:23:02,170 --> 00:23:04,440
.لا تتوقعوا شيئًا كهذا هنا

379
00:23:04,440 --> 00:23:08,190
."لدينا سؤالٌ من صاحبة الاسم المستعار "فتاة المسدس

380
00:23:08,190 --> 00:23:13,460
"حاليًا، جين-سان وكيوبي والجميع تبدلت أجناسهم"

381
00:23:13,460 --> 00:23:17,320
"لذلك، كيف سيبدو هاسيجاوا ـ سان بعدما تحوَّل لامرأةٍ؟"

382
00:23:17,320 --> 00:23:20,360
"أعلم بأنَّكِ لا تملكين الكثير من الوقت ولكن أجبيني رجاءً"

383
00:23:20,780 --> 00:23:21,440
حسنٌ

384
00:23:21,440 --> 00:23:24,250
.لا نملك وقتًا كافيا ولكن سنجيبك

385
00:23:24,250 --> 00:23:26,140
...الشكل الأنثوي لهاسيجاوا ـ سان

386
00:23:27,810 --> 00:23:30,820
الوداع، جميعكم

387
00:23:32,410 --> 00:23:33,810
سيكون هكذا...

388
00:23:34,410 --> 00:23:37,300
ماذا؟ أترغب برؤية وجهها؟

389
00:23:37,300 --> 00:23:38,640
ما باليد حيلة

390
00:23:38,640 --> 00:23:39,630
.هذه المرة فقط

391
00:23:40,570 --> 00:23:44,250
!الوداع، جميعكم

392
00:23:45,480 --> 00:23:46,910
.شيءٌ مشابهٌ لهذا

393
00:23:53,100 --> 00:23:54,180
...أنا

394
00:23:55,720 --> 00:23:56,670
...أنا

395
00:24:03,900 --> 00:24:08,570
أيُّ جنسٍ ستختاره كيوبي؟

396
00:24:03,900 --> 00:24:08,570
وهل ستستطيع تينكو الهروب من الفتحة؟

397
00:24:08,570 --> 00:24:14,750
وهل سيعود سوغيتا-سان؟

398
00:24:08,570 --> 00:24:14,750
!سيتضح كل شيءٍ في الأسبوع المقبل في نهاية آرك التحوُّل