1
00:00:03,040 --> 00:00:04,620
".أقوى رجل في الكون"

2
00:00:05,180 --> 00:00:09,360
النّاس الّذين ينادونني بذلك اللّقب
.ليسوا سوى ضفادع في بئر

3
00:00:10,170 --> 00:00:11,830
.الكون مكان كبير

4
00:00:12,400 --> 00:00:15,750
لا يشكّل كوكب ما إلاّ حبّة واحدة
،من بين حبّات رملٍ لا تحصى

5
00:00:16,250 --> 00:00:20,440
والعالم الّذي يمكن للمرء رؤيته في حياته
.ما هو إلاّ جزء صغير من الكلّ

6
00:00:21,000 --> 00:00:23,620
أتقصد أنّ هناك أناسًا كثرًا أقوى منك؟

7
00:00:24,180 --> 00:00:29,130
.لكن لا بدّ أنّك كنت الأقوى في العالم الّذي رآه أبي

8
00:00:29,130 --> 00:00:30,670
...وإلاّ فما كان

9
00:00:30,670 --> 00:00:35,890
قائد قراصنة الفضاء تشيدوري
بائتمانك على ابنته العزيزة

10
00:00:35,890 --> 00:00:37,120
.يا أوميبوزو

11
00:00:37,120 --> 00:00:41,390
أم هل عليّ القول، يا صديق أبي القديم كانكو؟

12
00:00:41,390 --> 00:00:43,200
.لا داعي لأن تقول أيّ شيء

13
00:00:43,200 --> 00:00:47,050
.سأسحب أنا موتسو طلبنا بنفسي

14
00:00:47,050 --> 00:00:50,030
.فأنت رجل أعظم بكثير من أن تعلّم شخصًا مثلي

15
00:00:50,430 --> 00:00:52,280
،لكن متى شعرت برغبة في ذلك

16
00:00:52,280 --> 00:00:57,300
هلاّ أتيت وحادثت هذا العصفور
الجاهل المحميّ في قفص؟

17
00:00:59,150 --> 00:01:02,720
وأخبرني بحبّات الرّمل الّتي لا تحصى
والّتي رأيتها بعينيك؟

18
00:02:52,720 --> 00:02:55,560
لطالما شعرت من البداية

19
00:02:55,930 --> 00:02:58,740
.أنّ الأمر سينتهي بنا هكذا

20
00:02:59,300 --> 00:03:02,070
...وبلقائك، أظنّني وجدت جوابي

21
00:03:02,660 --> 00:03:06,660
عن سبب عدم توقّفنا عن القتال رغم بنائنا

22
00:03:06,660 --> 00:03:10,230
.لحضارة نجميّة متقدّمة

23
00:03:10,230 --> 00:03:15,030
.لا علاقة للأمر بوجهات النّظر أو الآراء أو العقائد

24
00:03:15,030 --> 00:03:18,210
.بل سبب ذلك هو طبيعتنا الأساسيّة ككائنات حيّة

25
00:03:18,960 --> 00:03:21,010
،مهما تطوّرنا

26
00:03:21,010 --> 00:03:23,270
سترغمنا نفوسنا على تحديد

27
00:03:23,270 --> 00:03:27,450
.من منّا المفترِس، ومن منا الفريسة

28
00:03:28,460 --> 00:03:32,980
وعندما يتعلّق الأمر بكائنين على رأس
...السّلسلة الغذائيّة

29
00:03:34,220 --> 00:03:35,620
أقوى رجل في الكون؟

30
00:03:36,300 --> 00:03:39,360
هل أنت أحد الحمقى الّذين يواصلون
الحديث عن ذلك الهراء أيضًا؟

31
00:03:40,250 --> 00:03:43,480
.أنا آسف، لكنّي لست مهتمًّا بذلك اللّقب

32
00:03:44,150 --> 00:03:44,990
!اختفِ

33
00:03:46,130 --> 00:03:48,390
.لا أهتمّ لِمَا سيحدث لهذا العالم

34
00:03:48,890 --> 00:03:50,360
،حتّى إن كنتُ ضفدعًا

35
00:03:50,360 --> 00:03:53,830
،فسأحمي البئر الّذي أعيش فيه
.حتّى إن كلّفني ذلك حياتي

36
00:03:56,220 --> 00:03:58,240
.وأنا راضٍ بأن أكون ذلك النّوع من الضّفادع

37
00:03:59,460 --> 00:04:03,170
.أنت لست ضفدعًا في بئر على الإطلاق

38
00:04:03,520 --> 00:04:09,190
أضمن لك ذلك بصفتي شخصًا شهد
.نشأة وسقوط العديد من الأجناس

39
00:04:09,870 --> 00:04:11,900
لكن لهذا السّبب بالضّبط أعرف

40
00:04:11,900 --> 00:04:16,180
،أنّه رغم أنّك محارب يظهر مرّة كلّ ألف سنة

41
00:04:16,180 --> 00:04:19,600
.لا يمكنك الهرب من مبادئ الحياة

42
00:04:19,600 --> 00:04:22,730
.سوف تسقط يومًا ما بكلّ تأكيد

43
00:04:24,530 --> 00:04:27,390
،لأنّني هربت من مبادئ الحياة بالفعل

44
00:04:27,390 --> 00:04:30,200
.وانتهى بك المطاف معترضًا طريقي

45
00:04:33,060 --> 00:04:35,330
!أسرعي يا موتسو

46
00:04:39,280 --> 00:04:41,000
شخص أقوى منّي؟

47
00:04:41,000 --> 00:04:42,220
.نعم

48
00:04:42,220 --> 00:04:45,520
،إن قلتَ أنّه حتّى أنت لا يمكن مناداتك بالأقوى

49
00:04:45,520 --> 00:04:47,750
فهل التقيتَ بشخص أقوى منك؟

50
00:04:48,110 --> 00:04:51,930
.هوسِن الّذي قاتلتُه عندما كنت شابًّا، كان قويًّا

51
00:04:51,930 --> 00:04:55,260
.لكن هذا فقط إنّ تحدّثنا عن كائنات مثلنا

52
00:04:56,040 --> 00:04:58,560
الأشياء الّتي قاتلتها في حياتي كصيّاد

53
00:04:58,560 --> 00:05:01,200
.كانت تفوق المفاهيم الّتي يمكن مقارنتها كالقوّة

54
00:05:01,650 --> 00:05:04,520
هل يمكنك تحدّي إعصار أو تسونامي في القوّة؟

55
00:05:04,520 --> 00:05:06,830
.لا حاجة لذلك

56
00:05:06,830 --> 00:05:10,900
.فلا أحد يمكنه إيقاف كارثة طبيعيّة بمفرده

57
00:05:13,090 --> 00:05:14,530
.لقد سمعت بذلك

58
00:05:14,890 --> 00:05:17,850
كيف حصلت على لقب الأقوى

59
00:05:18,320 --> 00:05:21,540
.والسّبب الّذي يجعل الياتو يهلّلون لك كبطل لهم

60
00:05:22,490 --> 00:05:26,070
.سمعتُ عن المعركة الّتي استعاد فيها أوميبوزو ديارنا

61
00:05:27,080 --> 00:05:29,090
،تعرّض الكوكب الأمّ للياتو، كووان

62
00:05:29,090 --> 00:05:32,490
لهجوم مكثّف من قِبل اتّحاد
الكواكب خلال الحرب العظيمة

63
00:05:32,490 --> 00:05:34,980
.ودُمّر إلى جانب العديد من الياتو

64
00:05:37,300 --> 00:05:40,210
،بدأت ألتانا تتسرّب من الأرض

65
00:05:40,210 --> 00:05:44,190
.وأصبح الكوكب المدمّر عشًّا للكائنات المتحوّلة

66
00:05:47,560 --> 00:05:51,170
ومن بينها كان هناك شيء جعل النّاس
...يسمّون كووان بكوكب الموت

67
00:05:55,730 --> 00:05:59,590
.الطّفيليّ الكوكبيّ أوروتشي الّذي يُعتَبر سيّدَ كووان

68
00:05:59,590 --> 00:06:03,880
،تغذّى على ألتانا ونمّى 108 رؤوس

69
00:06:03,880 --> 00:06:06,460
.وقضى على أيّ شخص تجرّأ على الاقتراب من عشّه

70
00:06:07,110 --> 00:06:08,550
تخلّى الجميع على المكان

71
00:06:08,550 --> 00:06:12,840
ولم يقتربوا منه لقرون، لكنّ رجلاً واحدًا
انطلق إلى عشّه وحيدًا

72
00:06:12,840 --> 00:06:15,470
...واستعاد ديار الياتو

73
00:06:15,870 --> 00:06:18,420
كان ذلك أنت يا أوميبوزو، أليس كذلك؟

74
00:06:19,850 --> 00:06:22,210
استعدت ديارنا؟

75
00:06:22,210 --> 00:06:24,850
.كنت قد خسرت رهانًا مع صديق فحسب

76
00:06:25,180 --> 00:06:29,860
قلت أنّي سأذهب إلى مكان مهجور وأتغزّل
.بامرأة ما إن خسرت تحديًّا في الشّرب

77
00:06:34,950 --> 00:06:37,450
.لم أكن قد اختبرت شيئًا كذاك من قبل

78
00:06:37,970 --> 00:06:39,910
،في اللّحظة الّتي رأيتها فيها

79
00:06:41,700 --> 00:06:42,950
.انتصب

80
00:06:45,330 --> 00:06:46,580
انتصب؟

81
00:06:46,580 --> 00:06:47,330
ما الّذي انتصب؟

82
00:06:47,330 --> 00:06:49,600
.أظنّ أنّ الوقت لا يزال مبكرًّا عليك يا فتاة

83
00:06:49,600 --> 00:06:51,730
.يمكنك القول أنّها غريزتي

84
00:06:52,340 --> 00:06:53,590
،في اللّحظة الّتي رأيتها فيها

85
00:06:53,590 --> 00:06:56,640
.توّصلت جيناتي إلى استنتاج في الحال

86
00:06:56,640 --> 00:06:58,350
."قالت لي "سوف تموت

87
00:06:58,350 --> 00:07:00,350
".أسرع وأنجب أطفالاً"

88
00:07:07,520 --> 00:07:11,020
،سعيت خلفها مرارًا وتكرارًا
.لكنّي لم أستطع الوصول إليها

89
00:07:12,400 --> 00:07:15,440
.شعرت أنّي كنت أقاتل الأرض الّتي كنت واقفًا عليها

90
00:07:16,340 --> 00:07:20,120
.كما لو أنّي كنت مجرّد حشرة تواجه كوكبًا بأكمله

91
00:07:21,000 --> 00:07:24,870
اعترفت جيناتك بالهزيمة قبلك؟

92
00:07:24,870 --> 00:07:29,050
.ببساطة، شعرت بالخوف لأوّل مرّة في حياتي

93
00:07:29,050 --> 00:07:32,400
،لكن مهما صرخت هذه الجينات خوفًا

94
00:07:32,400 --> 00:07:35,520
.لا يمكن لرجلٍ أن يصرخ إلى أن تنتهي معركته

95
00:07:35,520 --> 00:07:37,880
...لذا قلت لخصيتي اليمنى

96
00:07:38,370 --> 00:07:39,890
.كفّي عن الصّليل

97
00:07:40,720 --> 00:07:42,390
.وأنت أيّتها اليسرى، اخرسي وشاهدي أنتِ أيضًا

98
00:07:42,810 --> 00:07:44,910
.لقد زرعت بذوري منذ وقت طويل

99
00:07:45,580 --> 00:07:47,020
.وقد كانت أفضلها في الواقع

100
00:07:47,020 --> 00:07:51,640
!لذا دعاني أقاتل! دعاني أحمي عائلتي

101
00:08:07,890 --> 00:08:09,450
.لا أصدّق ذلك

102
00:08:09,450 --> 00:08:12,830
كبحت غرائزك بالقوّة؟

103
00:08:13,170 --> 00:08:15,120
،همدت رغباتي الدّنيويّة بفضل ذلك

104
00:08:15,120 --> 00:08:17,740
.وتمكّنت من مغازلة المرأة بذهنٍ صافٍ

105
00:08:17,740 --> 00:08:18,960
المرأة؟

106
00:08:18,960 --> 00:08:20,930
هل كانت أوروتشي أنثى؟

107
00:08:20,930 --> 00:08:22,710
ما الّذي تتحدّثين عنه؟

108
00:08:22,710 --> 00:08:24,850
لِمَ قد أسحق إحدى خصيتيّ
لأقاتل ذلك الكائن الحقير؟

109
00:08:27,030 --> 00:08:30,230
هل تلك الذّراع تتجدّد؟

110
00:08:30,570 --> 00:08:31,950
،كما قلت

111
00:08:31,950 --> 00:08:34,480
.لقد كنت على ذلك الكوكب لأغازل امرأة

112
00:08:34,480 --> 00:08:36,040
.فهمت

113
00:08:36,040 --> 00:08:36,980
...عرفت ذلك

114
00:08:38,340 --> 00:08:40,490
...أنت حقًّا مثلها. كائن من ألتانا

115
00:08:41,410 --> 00:08:42,970
عمّن تتحدّث؟

116
00:08:53,300 --> 00:08:56,950
.أنا أتحدّث عن المرأة الّتي جازفت بحياتي لمغازلتها

117
00:09:13,670 --> 00:09:16,310
على كوكب الياتو الأمّ الّذي لحقه
،الخراب منذ وقت طويل

118
00:09:16,800 --> 00:09:18,070
...على كوكب الموت

119
00:09:20,260 --> 00:09:23,070
.كانت هناك امرأة منتصبة

120
00:09:36,920 --> 00:09:38,590
.وأنا أيضًا انتصبت

121
00:09:41,710 --> 00:09:45,200
.لا أصدّق أنّ أحدًا هنا بالفعل

122
00:09:46,500 --> 00:09:47,830
!مهلاً، انتظري

123
00:09:48,650 --> 00:09:50,850
.هذا الكوكب ليس ميتًا أو ما شابه

124
00:09:51,430 --> 00:09:53,340
،لربّما أصبح غير قابل للعيش بالنّسبة للنّاس

125
00:09:53,340 --> 00:09:55,850
لكنّ هذه الوحوش ما تزال تقاتل على الأرض
،الفاسدة وتعيش هنا

126
00:09:56,280 --> 00:09:58,850
،وهي ما زالت تشرب المياه الفاسدة هنا وتعيش هنا

127
00:10:00,020 --> 00:10:01,740
.وأنا لا أزال أعيش هنا

128
00:10:02,420 --> 00:10:07,070
كلّ ما حدث هو أنّ جنسًا واحد من بين العديد
.من الأجناس الّتي تعيش هنا قد انقرض

129
00:10:07,950 --> 00:10:10,910
لا يجدر بك أن تحكم على كوكب
.بأكمله بمعاييرك الخاصّة

130
00:10:11,480 --> 00:10:12,910
.غادر

131
00:10:13,290 --> 00:10:17,670
لا أريد قتل المزيد من الأرواح
.على هذا الكوكب لإنقاذ دخيل

132
00:10:18,680 --> 00:10:20,550
.عليّ أن أهدّئها

133
00:10:21,130 --> 00:10:23,380
علمتُ حينها

134
00:10:24,010 --> 00:10:25,880
"أنّ "سيّدَ كووان

135
00:10:29,560 --> 00:10:31,400
.كانت تلك المرأة

136
00:10:32,540 --> 00:10:33,770
—مهلاً، انتـ

137
00:10:43,670 --> 00:10:45,950
!قلت مهلاً

138
00:10:47,150 --> 00:10:48,200
!ابتعد عن طريقي

139
00:10:52,390 --> 00:10:54,500
!استمعي إليّ

140
00:10:58,220 --> 00:11:00,100
".تلك المرأة خطيرة"

141
00:11:00,100 --> 00:11:02,460
.كان ذلك ما قالته لي غرائزي

142
00:11:02,460 --> 00:11:05,220
...لكن في نفس الوقت، كانت تقول لي أيضًا

143
00:11:05,780 --> 00:11:08,510
.ا-اسمعي يا آنستي

144
00:11:08,510 --> 00:11:10,470
إن لم يكن لديك مانع، ما رأيك
أن ننسى أمر أوروتشي هذا

145
00:11:10,470 --> 00:11:13,930
ونذهب للقضاء على الأوروتشي الّذي بداخل سروالي؟

146
00:11:16,590 --> 00:11:18,560
".إنّها المرأة الأنسب لي"

147
00:11:19,060 --> 00:11:22,830
.قاتلتْ لثلاثة أيّام وليالٍ لتهدّئ الأوروتشي

148
00:11:24,090 --> 00:11:29,450
وتابعتُ محاولة التّودّد لها لكي تهدّئ
.الأوروتشي الّذي بداخل سروالي

149
00:11:32,690 --> 00:11:34,330
لِمَ لا نذهب لاحتساء فنجان قهوة؟

150
00:11:35,830 --> 00:11:39,710
.لكنّها لم تكترث لي أبدًا

151
00:11:45,980 --> 00:11:50,760
بهزيمتها للرّأس التّاسع والخمسين
،وبدء الأوروتشي بالتّراجع

152
00:11:54,890 --> 00:11:57,370
.كبحت آخر أوروتشي لي أنا أيضًا

153
00:11:58,850 --> 00:12:02,940
كان هناك شيء أردت إخبارها ليس بدافعٍ
.من غرائزي، بل بكلماتي الخاصّة

154
00:12:03,790 --> 00:12:05,570
.اسمي كانكو

155
00:12:06,020 --> 00:12:08,580
سأسألك عن اسمك في المرّة المقبلة
.الّتي آتي فيها إلى هنا أو ما شابه

156
00:12:09,320 --> 00:12:12,450
.هذا إن سمحت لي سيّدة كووان بالمجيء

157
00:12:13,880 --> 00:12:17,330
هل رافقتني لكلّ هذه المدّة لتقول هذا؟

158
00:12:17,330 --> 00:12:19,100
،عند زيارة منزل أحد ما

159
00:12:19,100 --> 00:12:22,080
.فمن الأدب أن نطرق بابه ونعرّف بأنفسنا

160
00:12:22,720 --> 00:12:24,420
.آسف على التّسبّب بالإزعاج

161
00:12:24,420 --> 00:12:28,010
.قولي لعائلتك أنّي أعتذر أيّتها السّيدة

162
00:12:30,030 --> 00:12:31,720
.هذا ليس منزل أحد ما

163
00:12:32,110 --> 00:12:34,150
.إنّها دياركم

164
00:12:34,150 --> 00:12:36,720
.إن كنت تريد العودة، فأنت حرّ في ذلك

165
00:12:37,390 --> 00:12:39,490
،مع أنّه على حدّ علمي

166
00:12:39,490 --> 00:12:46,230
أنت غريب الأطوار الوحيد الّذي عاد
.إلى هنا أساسًا، ناهيك عن طرق الباب

167
00:12:46,930 --> 00:12:49,450
.لم يكن الأوروتشي يحاول التّخلّص منك

168
00:12:49,450 --> 00:12:51,550
.لقد تحمّس فقط وأراد اللّعب

169
00:12:52,160 --> 00:12:54,620
،ظننّا أنّ الجميع قد نسوا أمرنا وأمر هذا الكوكب

170
00:12:54,620 --> 00:12:57,540
.لكن كان هنالك من تذكّر

171
00:12:57,540 --> 00:12:59,190
.وربّما أسعده ذلك

172
00:13:00,720 --> 00:13:03,630
.وأيضًا، أنا لست سيّدة كووان

173
00:13:04,950 --> 00:13:05,860
.أنا كوكا

174
00:13:07,760 --> 00:13:11,010
.وبعد ذلك بدأت أذهب إلى الدّيار بشكل منتظم

175
00:13:11,470 --> 00:13:14,020
.وفي مرحلة ما، توقّف الأوروتشي عن مهاجمتي

176
00:13:17,730 --> 00:13:20,770
،ربّما قبل بك كجزء من هذا الكوكب

177
00:13:21,110 --> 00:13:23,960
.أو ربّما قبلك كسيّده الجديد

178
00:13:24,610 --> 00:13:26,990
.قد تكون مناسبًا لذلك الدّور

179
00:13:27,540 --> 00:13:29,280
.لا يوجد شيء جيّد للأكل

180
00:13:29,820 --> 00:13:32,350
.كل ما يمكنك إيجاده هنا هو أرض وماء فاسدين

181
00:13:32,350 --> 00:13:34,030
.لن أصمد حتّى لعشرة أيّام

182
00:13:34,450 --> 00:13:37,390
لِمَ تبقين هنا يا كوكا؟

183
00:13:37,840 --> 00:13:39,860
.أنا مثلكم جميعًا

184
00:13:43,600 --> 00:13:47,370
تخلّيتم عن الكوكب لأنّكم لم تعودوا
.قادرين على العيش هنا

185
00:13:48,460 --> 00:13:51,110
.وأنا لا يمكنني العيش في مكانٍ آخر غير هذا

186
00:13:51,110 --> 00:13:52,670
.لهذا السّبب أبقى هنا

187
00:13:53,790 --> 00:13:58,980
انتشر الياتو القلّة الّذين نجوا من الحرب
.العظيمة في كواكب أخرى

188
00:13:59,710 --> 00:14:04,190
.لكن كان هناك بعض ممّن اختاروا الموت مع منزلهم

189
00:14:04,660 --> 00:14:07,880
.مات أغلبهم أبكر ممّا يفترض لهم

190
00:14:08,650 --> 00:14:12,440
لكنّ تمكّن بعضهم من التّأقلم
.مع هذه البيئة الصّعبة

191
00:14:13,200 --> 00:14:16,220
،وأنا سليلة تلك العشيرة الرّائعة

192
00:14:16,220 --> 00:14:17,680
.النّاجية الوحيدة

193
00:14:18,170 --> 00:14:22,450
إن اقتضى الأمر ذلك، يمكنني حتّى
.أكل حذائك القذر لكي أنجو

194
00:14:23,450 --> 00:14:25,740
.لكنّني أفضّل الموت على ذلك

195
00:14:25,740 --> 00:14:28,070
،إن لم يكن لديك عائلة أو أصدقاء هنا

196
00:14:28,070 --> 00:14:32,050
فلا سبب يدفعك للعيش هنا بمفرك
.تأكلين الأحذية من أجل البقاء

197
00:14:32,050 --> 00:14:34,920
لكنّي لا أملك سببًا للمغادرة أيضًا، أليس كذلك؟

198
00:14:35,360 --> 00:14:38,380
.أيّ مكان آخر سيعتبر جنّة مقارنة بهذا

199
00:14:38,860 --> 00:14:40,180
،وأيضًا

200
00:14:40,180 --> 00:14:41,690
ألا تشعرين بالوحدة؟

201
00:14:42,680 --> 00:14:44,010
الوحدة؟

202
00:14:44,010 --> 00:14:46,190
.لم أفكر في ذلك أبدًا

203
00:14:46,900 --> 00:14:50,030
هل يمكن لشيء كهذا أن يكون سببًا للرّحيل؟

204
00:14:51,390 --> 00:14:52,730
،حتّى وإن كان كذلك

205
00:14:52,730 --> 00:14:58,070
نسيت منذ وقت طويل متى عليّ
.أن أحسّ بذلك الشّعور

206
00:14:58,700 --> 00:15:01,480
.وُلِدتُ وترعرعت على هذا الكوكب

207
00:15:01,480 --> 00:15:05,580
لا يوجد طفل يكره المهد الّذي نام عليه، صحيح؟

208
00:15:06,150 --> 00:15:08,920
،لا أعرف كيف تبدو في عينيك

209
00:15:08,920 --> 00:15:14,580
لكنّي أستمتع كثيرًا بهذه الحياة، حيث
.أمتلك هذا الكوكب وأفعل ما يحلو لي

210
00:15:15,020 --> 00:15:18,090
.وأيضًا، ليس وكأنّي لا أستطيع الاستمتاع هنا

211
00:15:18,590 --> 00:15:20,950
،يمكنني قراءة جميع الكتب الّتي على هذا الكوكب

212
00:15:20,950 --> 00:15:23,600
،وأغنّي بأعلى صوت دون الاكتراث لأحد

213
00:15:24,360 --> 00:15:28,600
.وألهو مع دخيل يأتي من حين لآخر

214
00:15:31,900 --> 00:15:36,360
.لطالما أخبرتها عن الكواكب الّتي زرتها

215
00:15:36,800 --> 00:15:41,320
ظننت أنّها ستجدها مثيرة للاهتمام
.بما أنّها لم تغادر كووان أبدًا

216
00:15:42,350 --> 00:15:45,650
.ولطالما استمعت إليّ بنظرة ملل على وجهها

217
00:15:55,330 --> 00:15:57,010
...لكن في يوم ما

218
00:15:57,850 --> 00:15:58,970
.كانكو

219
00:15:59,480 --> 00:16:01,450
.يكفي

220
00:16:01,450 --> 00:16:04,260
.لقد سئمت من الاستماع

221
00:16:05,920 --> 00:16:08,770
.أريد رؤية كوكب آخر بعينيّ

222
00:16:08,770 --> 00:16:11,020
...لـ-لكنّك

223
00:16:11,390 --> 00:16:12,960
.لا أمانع إن رأيته من بعيد

224
00:16:14,570 --> 00:16:16,160
هلاّ أخذتني؟

225
00:16:19,670 --> 00:16:21,690
،حدّقت به دون أن تتفوّه بكلمة

226
00:16:22,110 --> 00:16:24,420
.ونفس نظرة الملل على محيّاها كما اعتادت

227
00:16:25,340 --> 00:16:28,030
.لكنّها حدّقت به باهتمام شديد دون أن تحرّك ساكنًا

228
00:16:29,860 --> 00:16:30,860
هل هو جميل؟

229
00:16:31,360 --> 00:16:34,290
.هكذا تبدو أغلب الكواكب المأهولة بالنّاس

230
00:16:35,090 --> 00:16:36,990
هل سمعت بالأرض؟

231
00:16:36,990 --> 00:16:38,300
الأرض؟

232
00:16:38,300 --> 00:16:41,300
،يبدو أنّه كوكب بعيد في طور النّمو

233
00:16:41,300 --> 00:16:44,380
،لكنّ فيه مياهًا صافية وأرضًا خصبة

234
00:16:44,380 --> 00:16:46,310
.ويقال أنّه كوكب جميل جدًّا

235
00:16:48,360 --> 00:16:52,310
هل تريدين رؤية الأرض معي؟

236
00:16:54,340 --> 00:16:56,340
.لا، ليس الأرض فقط

237
00:16:56,340 --> 00:16:58,020
،إن كان هناك مكان تريدين الذّهاب إليه

238
00:16:58,020 --> 00:17:03,910
فسيحضرك أوميبوزو العظيم من ذلك
.الكوكب الفاسد ويأخذك إليه

239
00:17:03,910 --> 00:17:07,540
...لذا كوني... كو-كوني

240
00:17:09,400 --> 00:17:12,310
!كوني... شريكتي

241
00:17:12,310 --> 00:17:14,370
!أ-أجل! شريكتي في العمل

242
00:17:14,370 --> 00:17:17,510
!إن اتّحدنا، فسنصبح أقوى صيّاديْ فضائيّين على الإطلاق

243
00:17:17,510 --> 00:17:18,420
ألا توافقينني الرّأي؟

244
00:17:19,190 --> 00:17:20,930
شريكة؟

245
00:17:21,500 --> 00:17:23,430
.لا يبدو ذلك سيّئًا

246
00:17:23,990 --> 00:17:26,230
،إن كان ذلك ممكنًا

247
00:17:27,140 --> 00:17:30,000
.فسيكون الأمر ممتعًا حقًّا

248
00:17:33,190 --> 00:17:34,500
...في ذلك اليوم

249
00:17:34,940 --> 00:17:37,560
،ومع أنّها لم تعتد وداعي

250
00:17:37,560 --> 00:17:39,930
.إلاّ أنّها لم تشح بنظرها عن سفينتي وهي تنطلق

251
00:18:01,280 --> 00:18:03,340
.لم أدرك الأمر قبل ذلك الحين

252
00:18:03,910 --> 00:18:06,840
.سبب عدم توديعها لي من قبل

253
00:18:07,580 --> 00:18:09,360
.وسبب توديعها لي حينها

254
00:18:10,580 --> 00:18:12,860
،أمضيت اثنا عشر يومًا كاملة أبحث في كلّ مكان

255
00:18:12,870 --> 00:18:14,540
.لكنّي لم أجدها

256
00:18:22,160 --> 00:18:24,760
.وحينها رأيت الأوروتشي واقفًا في صمت

257
00:18:32,400 --> 00:18:34,190
.هذه مشكلة

258
00:18:35,580 --> 00:18:38,630
متى روّضت الأوروتشي إلى هذا الحدّ؟

259
00:18:41,210 --> 00:18:43,880
.لم أكن سأراك من جديد

260
00:18:44,600 --> 00:18:46,630
لِمَ أتيتَ إلى هنا؟

261
00:18:47,730 --> 00:18:52,140
ألم أقل لك أنّي أنتمي إلى العشيرة
الّتي ستموت مع هذا الكوكب؟

262
00:18:53,000 --> 00:18:55,140
.عشت حياتي كاملة بمفردي

263
00:18:55,140 --> 00:18:57,810
.عليّ أن أعيش بمفردي

264
00:19:00,910 --> 00:19:01,900
لذا لماذا؟

265
00:19:04,680 --> 00:19:09,160
لِمَ تذكّرني بهذه المشاعر؟

266
00:19:10,190 --> 00:19:11,560
.أنا آسف يا كوكا

267
00:19:12,320 --> 00:19:14,520
.لكنّي مثلك تمامًا

268
00:19:15,830 --> 00:19:17,890
،حتّى عندما أكون في كوكب يعجّ بالحياة

269
00:19:18,520 --> 00:19:20,610
،حتّى وإن كان آلاف النّاس يحيطونني

270
00:19:22,230 --> 00:19:25,350
.فمع ذلك أشعر بالوحدة وأنت لستِ بجانبي

271
00:19:32,620 --> 00:19:35,310
.لا أريد أن أدعك تموتين وحيدة

272
00:19:35,900 --> 00:19:39,720
.إن أردتِ البقاء هنا، فسأبقى أنا أيضًا

273
00:19:40,430 --> 00:19:42,890
،إن أردتِ الذّهاب إلى مكان ما

274
00:19:42,890 --> 00:19:44,530
.فسأذهب إلى أيّ مكان معك

275
00:19:45,210 --> 00:19:46,050
...لذا

276
00:19:46,860 --> 00:19:48,650
.موتي معي يا كوكا

277
00:19:53,930 --> 00:19:58,160
.أنا أخون عشيرتي

278
00:19:58,840 --> 00:20:03,670
أشعر وكأنّ الكوكب يسألني ما
.إن كنت سأتخلّى عنه أيضًا

279
00:20:06,850 --> 00:20:07,780
حقًّا؟

280
00:20:18,650 --> 00:20:19,810
،إن طلبت رأيي

281
00:20:20,650 --> 00:20:22,810
.فهو يبدو وكأنّه يشكرك

282
00:20:24,140 --> 00:20:26,030
."كما لو أنّه يقول لك "شكرًا على كلّ شيء

283
00:20:36,380 --> 00:20:37,830
.فهمت

284
00:20:37,830 --> 00:20:44,840
تدعوك الأسطورة بالبطل الّذي استعاد ديار
،ياتو من سيد كووان المتوحّش

285
00:20:44,840 --> 00:20:51,110
بينما كنت عاشقًا غازلها وأخذها من الكوكب الميّت؟

286
00:20:51,870 --> 00:20:54,160
.لست أسطورة

287
00:20:54,610 --> 00:20:58,060
يمكن إيجاد أعظم كائن واجهه أوميبوزو العظيم

288
00:20:58,060 --> 00:20:59,680
...عبر الكون بأكمله

289
00:21:01,400 --> 00:21:02,850
.الزّوجة

290
00:21:03,350 --> 00:21:06,980
،وأنا مثل أيّ رجل مثير للشّفقة في الكون

291
00:21:06,980 --> 00:21:10,950
.انتهى بي المطاف خاضعًا لزوجتي

292
00:21:10,950 --> 00:21:12,720
.هذا مضحك

293
00:21:12,720 --> 00:21:16,770
أقوى رجل في الكون كان الأضعف في منزله؟

294
00:21:16,770 --> 00:21:18,110
.لا تضحكي

295
00:21:18,130 --> 00:21:20,230
.البيت كون آخر تمامًا

296
00:21:21,000 --> 00:21:23,370
.لكنّها أسطورة جيّدة

297
00:21:23,370 --> 00:21:27,460
،بدل قصص الوحوش الوحيدة الّتي تموت بمفردها

298
00:21:27,980 --> 00:21:34,890
أُفضّل القصص العاديّة الّتي تتحدّث
.عن إيجاد الرّفقة والأبوّة والعائلة

299
00:21:38,790 --> 00:21:40,140
.معك حقّ

300
00:21:40,470 --> 00:21:43,160
.بناء أسطورة عن الأقوى لا يعني شيئًا

301
00:21:43,700 --> 00:21:48,150
.بناء سعادة عاديّة كتلك، أثمن بكثير

302
00:21:50,650 --> 00:21:53,610
.لم أعرف شيئًا حينها

303
00:21:55,160 --> 00:21:58,530
.لا يمكنني العيش في مكان آخر غير هذا الكوكب

304
00:21:59,640 --> 00:22:01,930
.ولا حتّى ما عنته كلماتها بالفعل

305
00:22:03,830 --> 00:22:07,540
.لست ببطلٍ ولا بأب

306
00:22:08,440 --> 00:22:10,300
.إنّه قاتل

307
00:22:10,770 --> 00:22:15,150
.لقد قتل ذلك الرّجل أمّنا

308
00:23:51,420 --> 00:23:53,690
.سأهتمّ بمرض أمّي بطريقة ما

309
00:23:53,690 --> 00:23:56,220
.يا إلهي. لقد ورث غباءك كاملاً

310
00:24:00,820 --> 00:24:06,700
.سعى كاموي الصّغير لشيء ما لحماية عائلته

311
00:24:00,820 --> 00:24:06,700
...تصبح رغبته الصّريحة ملتوية مع الوقت

312
00:24:06,700 --> 00:24:12,000
هل يمكن للأصلع العجوز إصلاح ابنه الغبيّ؟

313
00:24:06,700 --> 00:24:12,000
وكيف ستنتهي معركته مع الوحش الّذي تدخّل؟