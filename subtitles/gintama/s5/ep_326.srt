1
00:00:08,960 --> 00:00:11,610
.تريد كاغورا إنقاذه

2
00:00:13,530 --> 00:00:15,620
،رغم كلّ الشّتائم الّتي قالتها

3
00:00:16,230 --> 00:00:19,870
.تتمنّى لأخيها أن يعود لسابق عهده

4
00:00:21,100 --> 00:00:25,320
حتّى إن انتهى المطاف بكما
...تواجهان بعضكما، فأنا واثق

5
00:00:28,390 --> 00:00:30,830
.الأرضيّون غريبون

6
00:00:31,380 --> 00:00:33,380
.يضعون قبورًا للأشخاص الّذين يكرهونهم

7
00:00:34,600 --> 00:00:36,500
ربّما تستطيع العثور

8
00:00:38,790 --> 00:00:40,610
.على حلّ مختلف عن حلّي

9
00:02:32,710 --> 00:02:33,750
أخ غبيّ؟

10
00:02:34,200 --> 00:02:39,170
،حتّى إن ظلّ جزء منّي كذلك

11
00:02:39,670 --> 00:02:41,040
!فقد مات اليوم

12
00:02:41,040 --> 00:02:44,670
!مات والأخ الغبيّ من الأرض

13
00:02:47,750 --> 00:02:48,680
.إنّه مجنون

14
00:02:49,360 --> 00:02:50,680
.لا يمكن لأرضيّ أن يهزم أحد الياتو أبدًا

15
00:02:51,900 --> 00:02:53,810
.لا يستطيع أرضيّ هزيمته أبدًا

16
00:02:54,580 --> 00:02:57,090
.إنّه الآن أقوى حتّى من هوسين

17
00:03:00,180 --> 00:03:03,070
.لقد أفرغتُ نفسي من إرادتي الخاصّة

18
00:03:04,960 --> 00:03:10,450
لقب "الأقوى" أكبر بكثير ليناسب
.شخصًا ليس فارغًا

19
00:03:11,240 --> 00:03:16,770
،وجب عليك البقاء في كوكبك الصّغير
.وتحمي عائلتك الصّغيرة

20
00:03:18,290 --> 00:03:22,670
لماذا واجهتني وأنت تفتقر للعزيمة لتُفرغ نفسك؟

21
00:03:23,100 --> 00:03:25,820
.ستموت دون أن تقدر على حماية أيّ شيء

22
00:03:25,820 --> 00:03:28,470
وستخسر هي كلّ شيء

23
00:03:28,470 --> 00:03:29,970
،بسببك وبسببي

24
00:03:29,970 --> 00:03:32,240
!أخويها الغبيّين

25
00:03:32,240 --> 00:03:34,310
!غين-تشان

26
00:03:48,500 --> 00:03:52,030
.لا تحتاج للعزيمة لتُصبح فارغًا

27
00:03:52,780 --> 00:03:54,010
...كاموي

28
00:03:54,010 --> 00:03:58,460
.كما قلت، أنا بعيد كلّ البعد عن أن أكون الأقوى

29
00:03:59,640 --> 00:04:03,790
.قد تكون أقرب بكثير إليه منّي

30
00:04:06,290 --> 00:04:09,370
.لكنّي ما أزال لا أرى نفسي خاسرًا

31
00:04:12,460 --> 00:04:14,860
القوّة الّتي ليس لديها شيء لتخسره

32
00:04:15,270 --> 00:04:17,810
.هي نفسها الضّعف العاجز عن حماية أيّ شيء

33
00:04:18,580 --> 00:04:21,810
.لا يمكنك أخذ أيّ أحد أو أيّ شيء منّي

34
00:04:23,950 --> 00:04:26,190
!أنت عاجز حتّى عن حماية نفسك

35
00:04:26,190 --> 00:04:28,250
ما الّذي قد يمكنك حمايته منّي؟

36
00:04:28,250 --> 00:04:29,850
،وإن كنت عاجزًا عن حماية شيء ما

37
00:04:29,850 --> 00:04:32,860
!فأبعد يديك عنه من لأساس

38
00:04:40,990 --> 00:04:42,040
هل ذلك خوف؟

39
00:04:42,040 --> 00:04:45,400
...كلاّ، إنّه ضائع

40
00:04:46,200 --> 00:04:49,590
ضائعٌ بسبب عينيْ ذلك الرّجل
.اللّتين تعاودان الرّجوع للحياة

41
00:04:55,710 --> 00:04:57,850
.بسبب سيف ذلك الرّجل

42
00:05:03,570 --> 00:05:05,060
...ذلك الرّجل

43
00:05:05,880 --> 00:05:08,310
.إنّه يشبه كاموي-سان

44
00:05:09,440 --> 00:05:13,920
فكما يواصل كاموي-سان القتال
،للحصول على لقب الأقوى

45
00:05:15,070 --> 00:05:17,330
،يواصل هو أيضًا القتال

46
00:05:17,840 --> 00:05:21,370
.من أجل اسم مختلف تمامًا

47
00:05:22,450 --> 00:05:25,580
علام تركّز عيناك؟

48
00:05:26,520 --> 00:05:28,590
.أنت لا تنظر إليّ

49
00:05:28,590 --> 00:05:31,720
،حتّى عندما واجهتَ هوسين وشينسكي

50
00:05:32,090 --> 00:05:34,510
.كنت تقاتل معركة مختلفة تمامًا بمفردك

51
00:05:36,590 --> 00:05:38,350
مَن تقاتل؟

52
00:05:38,940 --> 00:05:40,570
ما الاسم الّذي تقاتل من أجله؟

53
00:05:42,350 --> 00:05:44,540
،كما هو حالك أنت

54
00:05:45,530 --> 00:05:47,150
.كنتُ فارغًا أيضًا

55
00:05:48,180 --> 00:05:52,110
بمجرّد أن فقدتُ كلّ شيء وعرفتُ
،كم يمكن لذلك أن يكون مرعبًا

56
00:05:52,810 --> 00:05:54,660
،واصلتُ عيش حياة فارغة

57
00:05:55,370 --> 00:05:57,100
.دون أيّ معنى أو اسم من أيّ نوع

58
00:05:59,630 --> 00:06:04,060
لكنّ من منح معنى لنفسي الفارغة مرّة أخرى

59
00:06:04,060 --> 00:06:06,750
كانوا الأشخاص الّذين سيصبحون
،جزءًا منّي في مرحلة ما

60
00:06:07,210 --> 00:06:09,630
.أختك والآخرون

61
00:06:10,690 --> 00:06:15,310
لقد دخلت تلك الأوبئة المتهوّرة إلى حياتي عنوة

62
00:06:15,310 --> 00:06:17,640
.وأعطوني اسمًا جديدًا

63
00:06:18,190 --> 00:06:20,050
وأدركتُ حينها

64
00:06:20,620 --> 00:06:23,390
.أنّي لم أخسر أيّ شيء في الحقيقة

65
00:06:24,060 --> 00:06:26,900
.وأنّي كنتُ خائفًا وهاربًا من كلّ شيء

66
00:06:29,060 --> 00:06:30,820
...لن أهرب بعد الآن ثانية

67
00:06:31,430 --> 00:06:34,900
.لن أهرب من حماية شيء أو خسارته

68
00:06:35,640 --> 00:06:37,990
"لا أحتاج لقبًا فاخرًا مثل "الأقوى

69
00:06:38,400 --> 00:06:42,410
."أو لقبًا مثل "الأخ الغبيّ من الأرض

70
00:06:43,130 --> 00:06:46,420
.أنا غين-تشان من الأعمال الحرّة

71
00:06:47,120 --> 00:06:49,420
أقسم بهذا الاسم الّذي منحوني إيّاه

72
00:06:49,820 --> 00:06:51,180
...أنّي لن أخسر

73
00:06:52,660 --> 00:06:55,670
.لا أمامك أو أمام نفسي

74
00:06:56,400 --> 00:06:57,600
،لذلك يا كاموي

75
00:06:58,070 --> 00:06:59,450
.ليس عليك أن تخسر أيضًا

76
00:07:00,310 --> 00:07:01,010
.تذكّر

77
00:07:02,010 --> 00:07:04,930
تذكّر ذلك الشّيء الّذي يرقد
...في غيابات نفسك الفارغة

78
00:07:05,850 --> 00:07:08,990
!اسمك الحقيقيّ

79
00:07:14,930 --> 00:07:16,050
.هذا صحيح

80
00:07:16,540 --> 00:07:20,330
.هكذا هم... هكذا هم السّاموراي

81
00:07:21,930 --> 00:07:24,330
،إن كان لديهم ما يحمونه

82
00:07:24,330 --> 00:07:29,140
.فلن يتردّدوا لمواجهة أعداء أقوى من أنفسهم

83
00:07:30,080 --> 00:07:33,320
،أعينهم ليست مثبّتة على الجدار الّذي أمامهم

84
00:07:33,920 --> 00:07:37,280
.بل على الجدار الّذي بداخلهم، حدود قوّتهم الخاصّة

85
00:07:38,640 --> 00:07:42,220
،وبهدف تجاوز حدود قوّتهم هم وليس أعداءهم

86
00:07:42,220 --> 00:07:46,390
.يواصلون قتال أكبر عدوّ قد يواجهه المرء، أنفسهم

87
00:07:47,430 --> 00:07:49,970
.ويصبحون أقوى في كلّ مرّة

88
00:07:49,970 --> 00:07:50,890
...كاموي

89
00:07:51,430 --> 00:07:54,400
،كلّما ارتفعتَ في تحليقك فوقه

90
00:07:55,080 --> 00:07:57,150
.قفز هو أعلى من ذلك

91
00:07:59,000 --> 00:08:01,910
كم ظَلّ هنالك من جدران؟

92
00:08:27,100 --> 00:08:30,480
.هذا أقصى ما يمكنك أن تبلغه

93
00:08:30,480 --> 00:08:33,730
!توقّف يا كاموي

94
00:08:38,320 --> 00:08:42,100
وهذا هو أقصى ما يمكنك أنت أن تبلغه

95
00:08:42,100 --> 00:08:43,450
.أيّها الأخ الغبيّ

96
00:08:52,610 --> 00:08:54,960
...للحظة، كان

97
00:08:55,690 --> 00:08:59,460
هل ألقيت نظرة على غيابات فراغك؟

98
00:09:00,630 --> 00:09:02,820
.ما رأيتَه هناك كان اسمك الحقيقيّ

99
00:09:10,880 --> 00:09:15,220
أما زلت لم ترمِ ذلك الاسم بعيدًا؟

100
00:09:16,930 --> 00:09:20,470
.لذلك السّبب ستخسر أمام شخص مثله

101
00:09:21,190 --> 00:09:22,990
،إن كنت لا تستطيع فعلها بنفسك

102
00:09:23,770 --> 00:09:25,510
.فسأفعلها أنا من أجلك

103
00:09:26,110 --> 00:09:28,280
أختك ووالدك

104
00:09:28,280 --> 00:09:31,250
...والشّخص الّذي كنتَه في الماضي

105
00:09:32,490 --> 00:09:35,920
.سأمحو كلّ شيء من أجلك

106
00:09:49,380 --> 00:09:51,350
كا-كاموي؟

107
00:09:51,350 --> 00:09:52,850
...أنت

108
00:09:53,570 --> 00:09:57,360
.يبدو مثلما كانت كاغورا-تشان حينها

109
00:09:58,140 --> 00:10:01,800
.تمادى ذلك المغفّل وسمح لنفسه أن تُلتهم

110
00:10:02,230 --> 00:10:05,860
.لم يعد الآن الأخ الغبيّ لأيّ أحد أو قائدًا

111
00:10:06,200 --> 00:10:09,870
.ما هو إلاّ وحش نسي حتّى اسمه

112
00:10:14,620 --> 00:10:16,120
!كاغورا-تشان

113
00:10:23,090 --> 00:10:25,030
فقد ما يحدّه؟

114
00:10:30,750 --> 00:10:32,850
!توقّف يا كاموي

115
00:10:32,850 --> 00:10:35,770
...إن واصلت هذا، فإنّ جسدك

116
00:10:40,340 --> 00:10:42,090
!غين-تشان

117
00:10:46,850 --> 00:10:48,190
.اهربي

118
00:10:48,190 --> 00:10:50,160
.خذي ذلك الأصلع واهربي في الحال

119
00:10:50,700 --> 00:10:53,760
.لا اهتمام لديّ بمشاكل عائلتك

120
00:10:53,760 --> 00:10:57,670
إن كنت تريد قتل أختك
.أو والدك، فلا يوجد ما يمنعك

121
00:10:57,670 --> 00:11:01,210
.لكن اقتلهما وأنت أنت أيّها القائد

122
00:11:01,640 --> 00:11:09,010
هل تُؤلم لكمات والدك لدرجة أنّك خسرت
نفسك لصالح دماء الياتو خاصّتك؟

123
00:11:09,380 --> 00:11:11,820
هل لكمُ أختك يُؤلم لتلك الدّرجة؟

124
00:11:12,620 --> 00:11:14,310
.إنّهم متشابهون

125
00:11:14,920 --> 00:11:18,080
.إنّهم يواصلون تحمّل الألم لقتالك

126
00:11:18,080 --> 00:11:19,810
وها أنت ذا تهرب؟

127
00:11:20,580 --> 00:11:24,150
إن كنت ستهرب من قتالٍ أنت بدأته
،جارًّا أذيال الخيبة خلفك

128
00:11:26,710 --> 00:11:29,830
.إن كنتَ ستقاتل، فقاتل بيديك أنت

129
00:11:30,870 --> 00:11:34,580
،وإن رفضتَ الاستماع لنصيحة نائبك

130
00:11:35,460 --> 00:11:36,540
.فليكن ذلك

131
00:11:37,640 --> 00:11:41,330
.أنا معتاد على أن أُرغَم على مرافقة قائدي الغبيّ

132
00:11:42,120 --> 00:11:45,110
،إن كنتَ ستواصل القتال حتّى تموت

133
00:11:45,110 --> 00:11:48,840
.فسيقاتل القسم السّابع معك حتّى النّهاية

134
00:11:48,840 --> 00:11:50,840
!انطلق

135
00:11:50,840 --> 00:11:52,730
!أبوتو-سان

136
00:11:57,670 --> 00:11:59,940
.حان الوقت للانطلاق

137
00:12:08,090 --> 00:12:09,670
أين والدتك؟

138
00:12:11,020 --> 00:12:17,440
علّقتُ آمالاً عليك كشرّير منذ أن أردتَ
.خطفها باستعمال سفينة قراصنة

139
00:12:17,440 --> 00:12:19,840
.لكن يبدو أنّي بالغتُ في تقديرك

140
00:12:19,840 --> 00:12:20,840
.اغرب عن وجهي

141
00:12:20,840 --> 00:12:23,670
.هذا العالم ليس مكانًا لأطفال مثلك

142
00:12:23,670 --> 00:12:24,990
وماذا عنك؟

143
00:12:24,990 --> 00:12:28,670
هل يمكنك فعلاً أن تسمّي نفسك قرصانًا
بينما عجزتَ حتّى عن خطف طفل تافه؟

144
00:12:29,790 --> 00:12:32,680
في أعماقك، أردتَ أن يوقفك أحد ما، صحيح؟

145
00:12:33,930 --> 00:12:38,930
أليس لهذا السّبب أردتَ خطف أمّك أبوك موجود؟

146
00:12:39,660 --> 00:12:42,370
.لم يفت الأوان بعد. يمكنك التّوقّف الآن

147
00:12:48,320 --> 00:12:52,950
،حينها، بدأت تمشي للأمام دون تردّد

148
00:12:52,950 --> 00:12:55,200
.ولم أستطع إيقافك

149
00:12:55,610 --> 00:12:58,750
.لأنّي كنتُ مثلك

150
00:12:59,870 --> 00:13:03,370
.لا مكان أعود إليه. وطريقي الوحيدة هي للأمام

151
00:13:03,370 --> 00:13:06,040
.امتلأ القسم السّابع بأمثالك

152
00:13:06,970 --> 00:13:10,490
لهذا السّبب عندما تقدّمتَ لأمام
،دون النّظر للخلف

153
00:13:10,490 --> 00:13:13,240
،عندما تقدّمت وتجاوزتنا

154
00:13:13,240 --> 00:13:15,640
.انجذبنا لك

155
00:13:15,970 --> 00:13:18,220
،سواء كنتَ فارغًا أم لا

156
00:13:18,220 --> 00:13:22,520
،منظرك وأنت تتقدّم للأمام بلا هوادة سعيًا للقوّة

157
00:13:23,150 --> 00:13:27,730
،منظر ابتسامتك في وجه الموت وأنت تقاتل

158
00:13:27,730 --> 00:13:30,030
.كان فخرنا وفرحنا

159
00:13:32,310 --> 00:13:34,210
،إن كانت تلك خطيئة

160
00:13:34,210 --> 00:13:38,280
.فسأكفّر عنها بصفتي الرّجل الّذي لم يستطع إيقافك

161
00:13:38,690 --> 00:13:39,540
...لذلك

162
00:13:40,870 --> 00:13:42,540
.ابتسم أيّها القائد

163
00:13:43,680 --> 00:13:48,130
.لا تقاتل بتعبير لا يشبهك أبدًا أيّها المغفّل

164
00:14:03,440 --> 00:14:05,730
!لن نسمح بموت أيّ أحد بعد الآن

165
00:14:06,060 --> 00:14:09,480
!أقسم باسمنا... باسم الأعمال الحرّة

166
00:14:10,040 --> 00:14:11,480
.كا-كاموي

167
00:14:12,280 --> 00:14:14,490
.لن تسلب أيّ شيء بعد الآن

168
00:14:15,060 --> 00:14:17,200
.لن تخسر أيّ أحد بعد الآن

169
00:14:17,200 --> 00:14:18,800
...أنا

170
00:14:18,800 --> 00:14:23,250
،نحن سنحمي ذلك الاسم
...آخر شيء متبقٍّ داخلك

171
00:14:23,250 --> 00:14:25,520
!سنحميك يا أخي الغبيّ

172
00:14:25,520 --> 00:14:29,880
!لذلك لا تسمح لغرائزك الغبيّة أن تهزمك

173
00:14:56,020 --> 00:14:57,200
...هؤلاء الأشقياء

174
00:14:59,230 --> 00:15:00,990
!سأحمي كاغورا-تشان

175
00:15:00,990 --> 00:15:03,540
!سأحمي كاغورا-تشان الّتي أؤمن بها

176
00:15:11,400 --> 00:15:14,460
...أريد أن أصبح أقوى

177
00:15:15,430 --> 00:15:17,470
.أقوى كفاية لحماية الجميع

178
00:15:18,590 --> 00:15:20,850
.قويّة كفاية لكي لا أخسر نفسي

179
00:15:21,670 --> 00:15:22,720
.يساورني نفس الشّعور

180
00:15:23,420 --> 00:15:25,490
،في كلّ مرّة نحمي فيها شيئًا

181
00:15:25,900 --> 00:15:29,610
نصبحُ أقوى قليلاً، صحيح؟

182
00:15:31,180 --> 00:15:33,980
.لذلك لنمسح دموعنا ونذهب

183
00:15:35,930 --> 00:15:39,240
.أنا واثق أنّنا سنصبح أقوى قليلاً

184
00:15:46,310 --> 00:15:47,620
!لن أبكي بعد الآن

185
00:15:48,550 --> 00:15:50,250
!لن أخسر بعد الآن

186
00:15:50,250 --> 00:15:52,250
...حمينا أشياء كثيرة

187
00:15:52,570 --> 00:15:54,170
!وخسرنا الكثير

188
00:15:54,880 --> 00:15:56,630
هل أصبحنا أقوى؟

189
00:15:57,070 --> 00:15:58,880
هل أحرزنا أيّ تقدّم؟

190
00:15:59,190 --> 00:16:00,390
!لا نعرف

191
00:16:01,850 --> 00:16:02,600
...لكن

192
00:16:04,710 --> 00:16:05,890
الأرض؟

193
00:16:06,620 --> 00:16:10,400
.نعم. أخبرني والدك عنها منذ وقت بعيد

194
00:16:10,800 --> 00:16:14,400
.أخبرني أنّ هنالك كوكبًا أزرقًا جميلاً

195
00:16:15,290 --> 00:16:18,410
،في الحقيقة، بالنّظر إلى كونه رجلاً متهوّرًا

196
00:16:18,410 --> 00:16:22,410
فعلى الأرجح أنّه فقد كلّ ذكرى
.له عنه مع فقدانه لشعره

197
00:16:22,900 --> 00:16:25,460
.لنذهب للأرض يا ماما

198
00:16:25,460 --> 00:16:28,500
.لنذهب مع بابا وكاموي عندما تتحسّنين

199
00:16:28,500 --> 00:16:31,900
.لذهب جميعًا كعائلة

200
00:16:31,900 --> 00:16:36,420
.أراهن أنّه سيأتي مسرعًا بمجرّد تحسّنك

201
00:16:37,200 --> 00:16:38,510
فعلاً؟

202
00:16:38,510 --> 00:16:40,430
.أظنّ أنّ عليّ أن أتحسّن قريبًا إذًا

203
00:16:40,820 --> 00:16:44,420
.نعم. عليك النّوم الآن

204
00:16:44,420 --> 00:16:45,720
.حسنًا، حسنًا

205
00:16:50,440 --> 00:16:51,270
...كاغورا

206
00:16:53,550 --> 00:16:54,690
.شكرًا لك

207
00:16:55,670 --> 00:16:57,570
.شكرًا لتواجدك معي دائمًا

208
00:16:58,820 --> 00:17:03,070
ستكون عائلتنا على ما يرام
.ما دمتِ موجودة معنا

209
00:17:04,330 --> 00:17:07,380
حتّى عندما يحين اليوم الّذي ستنشئين
،فيه عائلتك الخاصّة

210
00:17:07,380 --> 00:17:09,560
.حاولي أن تنشئينها على ذلك الحال

211
00:17:10,800 --> 00:17:13,910
،لا يهمّ إن كانوا حمقى أو أغبياء

212
00:17:14,580 --> 00:17:20,840
،ما داموا معك في السّرّاء والضّرّاء معًا

213
00:17:20,840 --> 00:17:22,720
.إلى جانبك دائمًا

214
00:17:23,550 --> 00:17:25,730
.اعثري على أشخاص هكذا

215
00:17:28,090 --> 00:17:29,090
...ماما

216
00:17:29,550 --> 00:17:33,750
،لم نذهب للأرض كعائلة في النّهاية

217
00:17:34,540 --> 00:17:38,730
لكنّي عثرتُ في ذلك الكوكب الأزرق

218
00:17:46,930 --> 00:17:48,490
،على أكبر مغفّل

219
00:17:49,830 --> 00:17:53,410
.وأكبر غبيّ والأعمال الحرّة

220
00:17:56,830 --> 00:17:58,840
.لذلك السّبب لن أخسر

221
00:17:59,610 --> 00:18:02,840
وما داما يضحكان إلى جانبي

222
00:18:05,530 --> 00:18:07,740
،ويبكيان إلى جانبي

223
00:18:08,290 --> 00:18:10,950
.سأضحك وأبكي معك أيضًا

224
00:18:11,710 --> 00:18:15,370
،سأقاتل إلى جانبك

225
00:18:15,980 --> 00:18:20,070
.كما قاتلتَ دائمًا إلى جانبنا

226
00:19:01,720 --> 00:19:02,900
.يا لك من إزعاج

227
00:19:04,070 --> 00:19:05,780
.ابتعدي عن طريقي

228
00:19:07,130 --> 00:19:09,780
.اغربي عن وجهي يا دماء الياتو خاصّتي

229
00:19:11,070 --> 00:19:12,660
.هذا مجرّد شجار أشقّة

230
00:19:14,260 --> 00:19:17,210
.دعيني أقاتل بيديّ أنا

231
00:19:18,000 --> 00:19:23,460
.لا أستطيع تحمّل خسارتك بعد الآن

232
00:19:29,890 --> 00:19:31,600
.وكأنّي أستطيع أن أخسر

233
00:19:33,510 --> 00:19:37,600
لا يستطيع الأخ الأكبر مواصلة الخسارة
.أمام أخته الصّغيرة هكذا

234
00:19:41,400 --> 00:19:44,730
.دعيني أفوز يا أختي الصّغيرة

235
00:20:03,330 --> 00:20:05,440
.انتهى هذا القتال سلفًا

236
00:20:06,090 --> 00:20:08,050
سواء اخترتَ أن تلكمني أم لا

237
00:20:08,430 --> 00:20:10,050
،أو لم تستطع ذلك فحسب

238
00:20:13,030 --> 00:20:17,390
.لا يمكن لقبضتيك أن تهزماني

239
00:20:18,820 --> 00:20:21,860
.لا يمكنك إبعاد ذراع أختك الصّغيرة

240
00:20:24,810 --> 00:20:27,630
!ماما! ماما

241
00:20:29,320 --> 00:20:30,830
!بابا

242
00:20:35,240 --> 00:20:36,080
كوكا؟

243
00:20:36,080 --> 00:20:37,130
!كوكا

244
00:20:40,650 --> 00:20:42,050
،أهلاً بعودتك

245
00:20:44,300 --> 00:20:45,500
...كانكو

246
00:20:47,390 --> 00:20:48,600
...كاموي

247
00:20:52,570 --> 00:21:00,230
كلّ أفراد عائلتنا الأربعة مجتمعون
...أخيرًا يا كاغورا

248
00:21:01,600 --> 00:21:05,900
.يجب أن نكون نحن الأربعة معًا

249
00:21:07,170 --> 00:21:11,280
الآن، يمكننا أخيرًا أن نذهب

250
00:21:14,510 --> 00:21:15,750
.إلى الأرض

251
00:21:20,730 --> 00:21:25,190
.حينها، كنتَ إلى جانب ماما أيضًا

252
00:21:26,400 --> 00:21:30,180
،لا يهمّ كم هربت

253
00:21:30,180 --> 00:21:33,130
،لا يهمّ كم ابتعدت

254
00:21:33,940 --> 00:21:35,520
.لا يمكنك التّخلّص منّا

255
00:21:38,300 --> 00:21:41,630
...كاموي، أنت ما وصفته ماما

256
00:21:42,270 --> 00:21:44,430
.عائلتنا

257
00:21:46,920 --> 00:21:53,160
لم تستطع آلاف اللّكمات هزيمة
،أقوى رجال الهاروسامي أبدًا

258
00:21:53,990 --> 00:21:57,800
لكن استطاعت دمعة واحدة
.من أخته أن تطيح به

259
00:22:01,300 --> 00:22:06,790
بدا وجهه وكأنّه بكى حتّى النّوم
...على حضن والدته

260
00:22:07,700 --> 00:22:09,410
.كولد صغير

261
00:23:46,640 --> 00:23:50,310
.حصلتُ على جناحيّ من نفس الرّجل، لذلك أنا أعلم

262
00:23:50,310 --> 00:23:52,820
،سأقاتل أيضًا

263
00:23:52,820 --> 00:23:54,570
.مع الحاصد الّذي بداخلي

264
00:23:57,870 --> 00:23:59,560
.يبدو هذا رائعًا

265
00:24:00,820 --> 00:24:05,580
.لم ينتهِ الأمر بعد

266
00:24:00,820 --> 00:24:05,580
.في الحلقة القادمة، سنلقي نظرة على ماضي أوبورو

267
00:24:05,580 --> 00:24:10,880
سنشاهد بعض الأشياء المهمّة للغاية

268
00:24:05,580 --> 00:24:10,880
.مثل ما الّذي جعل يوشيدا شويو كما كان