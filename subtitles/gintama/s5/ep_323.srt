1
00:00:01,600 --> 00:00:05,860
أظنّ أنّ البشر لا يتغيّرون بتلك السّهولة، أليس كذلك؟

2
00:00:06,310 --> 00:00:08,050
،حتّى بعد الموت

3
00:00:08,050 --> 00:00:10,000
،وحتّى بعد عشر سنوات

4
00:00:10,000 --> 00:00:13,240
.ما زال الجميع يعبثون

5
00:00:14,480 --> 00:00:15,870
.لا أظنّ ذلك

6
00:00:16,350 --> 00:00:18,980
.فقد كنت لأقتلك قبل عشر سنوات

7
00:00:18,980 --> 00:00:20,250
.فهمت

8
00:00:20,250 --> 00:00:24,160
تعلّمتما أن توفّرا المرح إلى وقت لاحق إذًا؟

9
00:00:24,160 --> 00:00:26,480
.لقد نضجتما

10
00:00:26,480 --> 00:00:27,880
.اخرس

11
00:02:15,470 --> 00:02:20,040
.يبدو أنّ الأوضاع تغيّرت بشكل جذريّ عندما كنت ميتًا

12
00:02:21,250 --> 00:02:24,900
الأشخاص الّذين كانوا يدافعون عن البلاد ضدّي قبل أيّام

13
00:02:25,560 --> 00:02:27,660
.يُستَهدَفون من قِبلها

14
00:02:27,660 --> 00:02:29,890
.لم يتغيّر شيء

15
00:02:29,890 --> 00:02:32,590
،بمجرّد أن نقضي عليهم، سيحين دورك

16
00:02:32,590 --> 00:02:33,290
.يا تاكاسوغي

17
00:02:33,620 --> 00:02:37,620
.حاول أن تبقى حيًّا إلى ذلك الحين

18
00:02:38,160 --> 00:02:41,630
.هذا إن كنت لا تزال تستحقّ الاستخدام

19
00:02:41,630 --> 00:02:45,430
مهلاً، عمّاذا يتحدّثان؟

20
00:02:45,430 --> 00:02:47,510
...ببساطة، هما يقصدان

21
00:02:48,400 --> 00:02:51,010
".لا تمت يا صديقي"

22
00:02:51,330 --> 00:02:54,890
حدث الكثير، لكن انسَ كلّ ذلك"
"—في الوقت الرّاهن وتصرّف بلـ

23
00:02:54,890 --> 00:02:57,210
من قال أيّ شيء من ذلك؟
!هذا المترجم سيّئ

24
00:02:57,210 --> 00:02:58,490
!أحضروا لنا تودا ناتسوكو

25
00:02:58,490 --> 00:03:01,120
!متى تصرّفنا بلطف تجاه ذلك الغبيّ؟

26
00:03:01,120 --> 00:03:04,630
.سنقولها ببساطة، لذا ترجم بشكل جيّد

27
00:03:04,630 --> 00:03:06,550
".تبًّا لك"

28
00:03:06,550 --> 00:03:08,490
لم تحوّلت إلى شخص أجنبيّ؟

29
00:03:08,950 --> 00:03:12,230
...تاكاسوغي، إنّه يقول

30
00:03:12,230 --> 00:03:14,210
.أنّه يريد مضاجعتك

31
00:03:14,210 --> 00:03:15,890
!لا تترجم ذلك حرفيًّا

32
00:03:15,890 --> 00:03:17,940
.تعال للحظة يا سيّد ساكاموتو

33
00:03:17,940 --> 00:03:20,790
.ما خطبكما؟ أخبراه ما تريدان بنفسيكما فحسب

34
00:03:22,860 --> 00:03:26,070
.أنا آسف. لكنّي استجمعت بعض البصاق

35
00:03:26,070 --> 00:03:29,160
!أردت أن تبصق فحسب؟ أنا لست مبصقة

36
00:03:29,160 --> 00:03:31,010
.لا داعي لأن تترجم ذلك

37
00:03:31,010 --> 00:03:33,050
.ابصق عليه أو ما شابه

38
00:03:33,050 --> 00:03:35,180
!لِمَ لم تبصق عليه مباشرة؟

39
00:03:35,180 --> 00:03:37,060
...سيّد تاكاسوغي

40
00:03:37,060 --> 00:03:40,520
.أخبره أنّي أردّ له ذلك البصاق

41
00:03:40,520 --> 00:03:42,330
!أعده إليه هو إذًا

42
00:03:42,330 --> 00:03:43,580
!لا تستعملني كوسيط

43
00:03:43,580 --> 00:03:45,150
!فأنا لست مترجم بصاق

44
00:03:45,430 --> 00:03:46,680
!تبًّا، مقزّز

45
00:03:46,680 --> 00:03:48,460
!رائحة بصاق أحدكم مقزّزة

46
00:03:48,460 --> 00:03:51,200
قل له أنّه لا يمكن أن يكون له بصاق
.بعد أن استيقظ للتّوّ

47
00:03:51,740 --> 00:03:56,760
قل له ألاّ يلومني أنا، بل الرّجل الّذي
.يعيش ويتنفّس السّكر طوال الوقت

48
00:03:57,390 --> 00:04:01,790
،أخبره أنّي تناولت رامن بثوم إضافيّ
.لكنّي نظّفت أسناني

49
00:04:01,790 --> 00:04:03,750
!توقّفوا

50
00:04:03,750 --> 00:04:07,300
!هم من عليكم أن تبصقوا عليهم الآن

51
00:04:08,510 --> 00:04:11,050
إذًا تلاميذ مدرسة شوكا سونجوكو المحترمة

52
00:04:11,050 --> 00:04:13,550
جميعهم أعداء للدّولة الآن؟

53
00:04:13,550 --> 00:04:15,430
.تلك ليست بدولة

54
00:04:15,870 --> 00:04:18,520
.إنها ليست بلادًا على الإطلاق

55
00:04:22,380 --> 00:04:24,070
...إنّهم متعطّشون

56
00:04:24,070 --> 00:04:28,190
.إلى اللّحم والدّم بداخلي واللّذين شكّلا ذلك الرّجل

57
00:04:29,110 --> 00:04:31,740
هل أنت سعيد أم حزين؟

58
00:04:37,770 --> 00:04:40,730
،تلاميذك الّذين افترقوا بسببك ذات مرّة

59
00:04:40,730 --> 00:04:43,460
...اجتمعوا هنا مجدّدًا من أجلك

60
00:04:44,190 --> 00:04:47,530
.لكي تبيدهم يا شويو

61
00:04:49,000 --> 00:04:51,590
هل صنعوا شيئًا كهذا أيضًا؟

62
00:04:52,020 --> 00:04:53,450
.فهمت

63
00:04:53,450 --> 00:04:58,380
تمّ جرّ ذلك الغراب الوحش أخيرًا
.إلى مكان يمكنني أن أطاله فيه

64
00:04:58,910 --> 00:05:00,480
...تاكاسوغي، هل

65
00:05:00,480 --> 00:05:03,260
هل كنت تعلم بشأن أوتسورو؟

66
00:05:04,230 --> 00:05:05,230
.ربّما نعم وربّما لا

67
00:05:06,310 --> 00:05:12,740
لكن إن وُجد من هو قادر على إمساك
،شخص بتلك القوّة وقتله بسهولة

68
00:05:13,320 --> 00:05:14,870
.فسيكون سينسي بنفسه

69
00:05:15,310 --> 00:05:19,750
.لا، لا بدّ أن يكون شيئًا آخر كان بداخله

70
00:05:19,750 --> 00:05:23,960
انتهى بك الأمر هنا بعد أن ضللت
طريقك أيضًا، أليس كذلك؟

71
00:05:23,960 --> 00:05:25,520
.أنا مثلك

72
00:05:25,520 --> 00:05:27,250
.ما زلت تائهًا

73
00:05:27,690 --> 00:05:28,600
.لكن لا بأس

74
00:05:29,420 --> 00:05:30,760
،شكّ في نفسك، وته عن طريقك

75
00:05:31,580 --> 00:05:34,760
.وأصبح السّاموراي الّذي تريده

76
00:05:35,400 --> 00:05:37,680
...كان سينسي يقاتل شيئًا ما

77
00:05:38,260 --> 00:05:42,020
.وربمّا كان ذلك الشّيء بداخله

78
00:05:42,840 --> 00:05:44,610
،لكنّه خسر

79
00:05:44,610 --> 00:05:46,640
.وبقي ذلك الشّيء فقط

80
00:05:47,260 --> 00:05:53,150
،وما زال يتصرّف وكأنّ العالم ملك له
.ويعيد بناء البلدان كما يشاء

81
00:05:53,490 --> 00:05:56,660
.في تلك الحالة، عليّ أن أواصل القتال أيضًا

82
00:05:57,480 --> 00:06:00,560
.لا أكترث لِمَ ستفعلونه من الآن فصاعدًا

83
00:06:00,560 --> 00:06:04,040
.فقد حسمت قراري منذ وقتٍ طويل

84
00:06:06,880 --> 00:06:12,670
!سأدمّر هذا العالم الفاسد الّذي بناه بكلّ بساطة

85
00:06:17,090 --> 00:06:19,300
!شينسكي-ساما

86
00:06:23,780 --> 00:06:26,770
.وكأنّهم سيتوقّفون الآن

87
00:06:27,520 --> 00:06:29,980
.لا يمكن إيقاف أولئك الرّجال بعد الآن

88
00:06:34,650 --> 00:06:36,490
!أعيقوا الغربان

89
00:06:36,490 --> 00:06:38,280
!سنسحق نحن تلك الخردة

90
00:06:44,020 --> 00:06:44,830
،في ذلك اليوم

91
00:06:45,770 --> 00:06:48,820
.حفرنا قبورًا عدّة

92
00:06:48,820 --> 00:06:51,590
،ليس لسينسي ورفاقنا فقط

93
00:06:52,710 --> 00:06:55,200
.لكن لأنفسنا أيضًا

94
00:06:56,720 --> 00:07:01,140
.عندما مات يوشيدا شويو، مات تلاميذه معه

95
00:07:02,550 --> 00:07:05,980
...ولن تلتقي دروبهم مجدّدًا أبدًا

96
00:07:05,980 --> 00:07:07,600
.هذا ما ظننته

97
00:07:11,230 --> 00:07:14,540
،لكن، رغم أنّنا سلكنا دروبًا مختلفة

98
00:07:14,540 --> 00:07:17,650
.لم ننحرف عن تعاليم سينسي أبدًا

99
00:07:19,950 --> 00:07:22,450
،باحثين عن نوع السّاموراي الّذي نريد أن نكونه

100
00:07:23,000 --> 00:07:24,950
،شككنا في أنفسنا وضللنا طريقنا

101
00:07:24,950 --> 00:07:26,830
،لكنّنا لم نكفّ عن المشي

102
00:07:27,290 --> 00:07:29,580
.ولهذا السّبب التقت دروبنا مجدّدًا

103
00:07:41,540 --> 00:07:43,320
والشّخص الّذي جمعها

104
00:07:43,320 --> 00:07:45,310
.هو سينسي لا غير

105
00:07:59,820 --> 00:08:03,530
.قد يكون مجرّد لقاء عابر بالصّدفة

106
00:08:22,120 --> 00:08:25,180
،لكن حتّى وإن كان مؤقّتًا

107
00:08:26,530 --> 00:08:30,190
إن استطعنا العودة لكوننا تلاميذ
،يوشيدا شويو من جديد

108
00:08:30,860 --> 00:08:33,130
،إن استطعنا العودة لكوننا أصدقاء مجدّدًا

109
00:08:33,130 --> 00:08:35,130
.فذلك وحده أكثر من كافٍ

110
00:08:42,790 --> 00:08:46,700
كيف تشعر وأنت تشكّل عائقًا بالنّسبة
لرجل غادر فراش المرض للتّوّ؟

111
00:08:46,700 --> 00:08:51,960
وكيف تشعر وأنت مضطرّ للاعتماد
على ذلك العائق لتعيش؟

112
00:08:54,700 --> 00:08:55,670
.شعور سيّئ للغاية

113
00:09:02,220 --> 00:09:03,590
!مستحيل

114
00:09:03,590 --> 00:09:06,380
دمّروا تلك الأسلحة بأنفسهم؟

115
00:09:08,750 --> 00:09:10,460
!هذه هي فرصتنا

116
00:09:12,890 --> 00:09:14,520
!قاتلوهم

117
00:09:14,520 --> 00:09:16,520
!سوف نعود إلى الأرض أحياءً

118
00:09:16,520 --> 00:09:20,240
!لدينا أولئك الأربعة معنا

119
00:09:21,060 --> 00:09:22,620
.يا إلهي

120
00:09:22,620 --> 00:09:25,700
.لا تعظّمونا فقط عندما تحتاجوننا

121
00:09:26,570 --> 00:09:28,740
.لكن عليّ أن أعتذر للجميع

122
00:09:29,190 --> 00:09:36,250
فقد بدأت أشعر أنّ الفوز
.في هذه المعركة من عدمه لا يهمّ

123
00:09:37,380 --> 00:09:43,840
يمكنني التّخلّي عن أفكار الفوز والهزيمة
.وأثير الفوضى مع أولئك الأوغاد

124
00:09:44,880 --> 00:09:48,740
إن علمتم أنّ أفكارًا مثيرة للشّفقة
،مثل تلك تساورني

125
00:09:48,740 --> 00:09:53,760
.لما تركتموني على الأرجح أقف إلى جانبكم

126
00:09:54,820 --> 00:09:56,100
!تاتسوما

127
00:09:56,100 --> 00:09:56,790
!قادم

128
00:09:56,790 --> 00:09:58,440
!زورا! تاكاسوغي

129
00:09:58,440 --> 00:10:01,440
!ادّعيا التّراجع واستدرجا العدوّ

130
00:10:01,780 --> 00:10:03,320
!غينتوكي

131
00:10:03,320 --> 00:10:06,410
!استغلّ تلك الفرصة وتجاوزهم

132
00:10:08,240 --> 00:10:12,000
.نحن لم نأتِ إلى هنا فقط لمساعدة صديق قديم

133
00:10:12,000 --> 00:10:13,500
...غينتوكي

134
00:10:13,500 --> 00:10:18,260
استعمل أصدقاءك القدامى لمساعدة
الأصدقاء الجدد الّذين عثرت عليهم

135
00:10:18,260 --> 00:10:20,400
!الّذين سيدعمون مستقبل بلادنا

136
00:10:21,600 --> 00:10:25,060
.سيواجه أصدقاؤك القدمى البلاد القديمة

137
00:10:25,060 --> 00:10:28,760
.وأنت قد أصدقاءك الجدد إلى البلاد الجديدة

138
00:10:28,760 --> 00:10:31,770
.سنكون بخير الآن

139
00:10:31,770 --> 00:10:35,960
!اذهب من أجل الّذين تريد حمايتهم حقًّا الآن

140
00:10:36,790 --> 00:10:39,520
هل فقدتم صوابكم جميعًا؟

141
00:10:41,160 --> 00:10:42,150
.أيّها الولد

142
00:10:42,810 --> 00:10:46,380
.أنا لم أنقذك من أجل هذا الهراء

143
00:10:47,630 --> 00:10:50,020
.لا تدع أحدًا يقتله

144
00:10:51,840 --> 00:10:54,800
مئتان وستّة وأربعون فوزًا مقابل
مئتين وستّ وأربعين خسارةً

145
00:10:54,800 --> 00:10:55,910
...وتعادل واحد

146
00:10:56,690 --> 00:10:59,280
.في المرّة المقبلة، لن تهمّ البلاد أو أيّ شيء آخر

147
00:10:59,280 --> 00:11:00,920
سأمحو كلّ شيء آخر

148
00:11:00,920 --> 00:11:03,170
.وآتي من أجل رقبته فحسب

149
00:11:03,640 --> 00:11:05,670
...لذا إلى ذلك الحين

150
00:11:08,140 --> 00:11:09,790
...اهتمّ

151
00:11:09,790 --> 00:11:10,670
.بصديقنا

152
00:11:13,930 --> 00:11:15,430
!حاضر

153
00:11:28,110 --> 00:11:30,490
.لا بأس بهذا

154
00:11:30,490 --> 00:11:33,310
،حتّى وإن لم نلتقِ مجدّدًا

155
00:11:34,450 --> 00:11:41,880
سنبقى أصدقاء يمكنهم الوقوف
.بشموخ حتّى اللّحظة الأخيرة

156
00:11:43,850 --> 00:11:45,590
.استعدّوا للهبوط

157
00:11:46,040 --> 00:11:50,550
.يبدو أنّ عليّ إصلاح عيوب تلاميذي بنفسي

158
00:11:50,550 --> 00:11:51,180
.حاضر

159
00:11:51,920 --> 00:11:53,300
.أوتسورو-ساما

160
00:11:53,750 --> 00:11:58,560
.أعدك بأن أحضر لك رقابهم

161
00:12:00,230 --> 00:12:04,190
.فأنا أوبورا، تلميذك أيضًا

162
00:12:04,600 --> 00:12:07,780
.دعني أثبت ولائي لك لآخر مرّة

163
00:12:09,490 --> 00:12:11,020
!أجيبوا

164
00:12:11,020 --> 00:12:12,490
!هذا القسم التّاسع

165
00:12:12,490 --> 00:12:14,550
!نطلب الدّعم في الحال

166
00:12:14,550 --> 00:12:19,530
ألحق هجوم العدوّ المعاكس ضررًا
!كبير للقسمين التّاسع والعاشر

167
00:12:19,530 --> 00:12:21,080
أكان أوميبوزو؟

168
00:12:21,080 --> 00:12:22,330
.ليس وحده

169
00:12:22,740 --> 00:12:25,120
.قد يكون هنالك شخص آخر

170
00:12:25,120 --> 00:12:30,250
وصلتنا معلومات عن تعرّض حرسنا
!الخلفيّين للهجوم من قبل وحدة مجهولة

171
00:12:31,220 --> 00:12:32,990
،ومع أنّنا لم نتحقّق من الأمر

172
00:12:32,990 --> 00:12:35,350
.وصلنا أيضًا أنّه رجل واحد

173
00:12:36,420 --> 00:12:37,650
—على أيّ حال أرسلوا المسـ

174
00:12:42,800 --> 00:12:43,950
.أنت

175
00:12:48,260 --> 00:12:49,900
أين أنا؟

176
00:12:49,900 --> 00:12:51,070
هل هذه الجحيم؟

177
00:12:51,070 --> 00:12:55,380
أنا متأكّد أنّ هناك مقعد محجوز لي
،في الجحيم بعد هذا

178
00:12:55,810 --> 00:12:58,140
.لكن ما زلت أملك ساقيّ وشعري

179
00:12:58,140 --> 00:13:00,000
.أنت لا تملك أيّ شعر

180
00:13:02,330 --> 00:13:04,630
.إنّها مسألة وقت فقط

181
00:13:04,630 --> 00:13:07,290
.وسيلة نقلنا على وشك أن تصل

182
00:13:08,420 --> 00:13:11,630
إن كنت تملك الوقت لمحادثة تافهة فلِمَ لا تهرب؟

183
00:13:13,870 --> 00:13:18,780
أوميبوزو، هل أنت هنا لقتل ابنك الغبيّ حقًّا؟

184
00:13:20,350 --> 00:13:24,100
إن كنت كذلك، فلِمَ تحمينا؟

185
00:13:24,780 --> 00:13:28,110
لِمَ أتيت إلى هنا لتقاتل؟

186
00:13:29,310 --> 00:13:30,360
من يدري؟

187
00:13:31,090 --> 00:13:32,720
هذا مثير للشّفقة، أليس كذلك؟

188
00:13:33,290 --> 00:13:36,370
،مع أنّي أستطيع هزيمة آلاف الأعداء أمامي

189
00:13:36,370 --> 00:13:39,890
.إلاّ أنّي لا أملك فكرة عن كيفية قتال ابني كما ينبغي

190
00:13:41,410 --> 00:13:45,530
الطّريقة الوحيدة الّتي أعرفها لإظهار
.حبّي وكرهي هي بهذا الشّيء

191
00:13:46,660 --> 00:13:48,340
!أحضروا سلاحي

192
00:13:48,340 --> 00:13:51,340
.أوميبوزو، الأسطورة الحيّة

193
00:13:51,340 --> 00:13:53,910
.خصمٌ جديرٌ بالفعل

194
00:13:53,910 --> 00:13:58,100
أنا قائد القسم الأوّل الّذي حافظ
،على هاروسامي لوقت طويل

195
00:13:58,100 --> 00:13:59,220
!ملك الوحوش، شيري

196
00:13:59,710 --> 00:14:01,850
...هل يمكنك أن تحتمل هجومي

197
00:14:10,540 --> 00:14:14,090
.تمالك نفسك أيّها القائد

198
00:14:14,090 --> 00:14:17,320
كيف لك أن تفسد استلامك لسلاحك؟

199
00:14:17,640 --> 00:14:19,770
.لكن لا تقلق

200
00:14:19,770 --> 00:14:22,620
.سأنهي عملك من أجلك

201
00:14:23,730 --> 00:14:25,920
.أوميبوزو، الأسطورة الحيّة

202
00:14:26,240 --> 00:14:28,490
.خصمٌ جديرٌ بالفعل

203
00:14:28,490 --> 00:14:32,300
بديل قائد القسم الأوّل شيري كخصمٍ لك

204
00:14:32,940 --> 00:14:34,730
،هو قائد القسم السّابع

205
00:14:35,400 --> 00:14:37,270
.ابنك الغبيّ

206
00:14:54,370 --> 00:14:57,070
...أ-أنت

207
00:14:57,070 --> 00:14:58,780
!كاموي

208
00:14:59,910 --> 00:15:02,080
!اقتلوه

209
00:15:05,500 --> 00:15:06,830
ألم تسمعوني؟

210
00:15:06,830 --> 00:15:11,850
!قلت لكم أنّي سأنجز عمل قائدكم بدلاً عنه

211
00:15:15,170 --> 00:15:16,720
.العدوّ هناك

212
00:15:17,550 --> 00:15:19,890
.هيّا، هاجموا

213
00:15:31,040 --> 00:15:33,820
.لا ترمِ بالأشياء على النّاس

214
00:15:39,990 --> 00:15:43,220
.ولا تشهر أشياءً حادّة على النّاس

215
00:15:47,350 --> 00:15:49,920
لقد عدت من الجحيم

216
00:15:49,920 --> 00:15:52,290
،لأقاتلك

217
00:15:52,950 --> 00:15:54,460
!أيّها الأصلع

218
00:15:55,650 --> 00:15:57,470
.لا تنادني بالأصلع

219
00:15:57,990 --> 00:16:01,220
!نادني بأبيك الهادئ

220
00:16:06,100 --> 00:16:09,140
!أيّها القائد! أوميبوزو

221
00:16:09,140 --> 00:16:10,690
!اهدآ

222
00:16:10,690 --> 00:16:12,940
!هذا ليس الوقت المناسب لذلك

223
00:16:24,700 --> 00:16:26,240
...لقد بدأ

224
00:16:33,880 --> 00:16:37,090
.قتال الأب وابنه الأسوأ في الكون

225
00:16:41,340 --> 00:16:44,050
!لا يمكن لأحد إيقافه الآن

226
00:16:50,680 --> 00:16:51,570
.كاموي

227
00:16:53,970 --> 00:16:55,270
.كن قويًّا

228
00:16:55,640 --> 00:16:59,150
.واحمِ أمّك وكاغورا

229
00:17:03,070 --> 00:17:05,840
.انظر إليّ يا أوميبوزو

230
00:17:06,440 --> 00:17:09,540
.لقد أصبحت قويًّا

231
00:17:11,640 --> 00:17:15,330
.حاولت يائسًا اتّباع خطواتك منذ ذلك الحين

232
00:17:15,330 --> 00:17:19,340
.واصلت القتال منذ ذلك الحين فقط لأتفوّق عليك

233
00:17:20,840 --> 00:17:23,110
.انظر إلي يا أوميبوزو

234
00:17:23,110 --> 00:17:26,920
لقد أصبحت قويًّا بما يكفي لقتلك

235
00:17:31,290 --> 00:17:36,270
!لذا عد وحشًا مجدّدًا

236
00:17:36,860 --> 00:17:41,110
.نحن الآن لسنا أبًا وابنه تربطهما قرابة دمويّة

237
00:17:41,900 --> 00:17:45,030
...كلانا نريد أن نثبت أننّا أقوى من الآخر

238
00:17:45,280 --> 00:17:47,660
!نحن مجرّد وحشين ذكرين

239
00:17:47,660 --> 00:17:50,700
...لا يمكن لأحد أن يوقفنا الآن

240
00:18:02,380 --> 00:18:07,680
.مهما بدأتما بهذا الهراء، سأوقفكما في كلّ مرة

241
00:18:08,310 --> 00:18:09,430
فلنعد

242
00:18:10,800 --> 00:18:12,320
.عائلة فحسب

243
00:18:14,890 --> 00:18:16,410
!ابتعدوا عن طريقي

244
00:18:17,190 --> 00:18:19,690
!أين أنتِ يا كاغورا-تشان؟

245
00:18:19,690 --> 00:18:22,070
!أجيبيني إن كنت هنا

246
00:18:22,670 --> 00:18:23,950
.باتسان

247
00:18:23,950 --> 00:18:29,050
هناك رجل واحد قادر على القيام بهكذا
.شيء ضدّ كلّ هذا العدد من النّاس

248
00:18:29,580 --> 00:18:31,220
...أوميبوزو-سان

249
00:18:31,220 --> 00:18:36,870
إنّه يريد حقًّا حماية كاموي-سان من
.هاروسامي وليس إيقافه فحسب

250
00:18:37,450 --> 00:18:38,660
.لا أدري

251
00:18:38,660 --> 00:18:39,750
،مهما كان ما يريده العجوز

252
00:18:40,230 --> 00:18:42,930
.فلن يتوقّف ذلك الابن الغبيّ بعد الآن

253
00:18:43,540 --> 00:18:45,760
.إن كان حيًّا، فسيأتي من أجل حياته بالتّأكيد

254
00:18:46,080 --> 00:18:49,260
.وستكون كاغورا هناك بالتّأكيد

255
00:18:49,260 --> 00:18:50,300
.فلنسرع

256
00:18:50,300 --> 00:18:53,520
.بدأ جنود هاروسامي بالانسحاب الآن

257
00:18:53,520 --> 00:18:57,470
عائلة الوحوش تلك هي آخر
،من أتوقع أن تسقط بسهولة

258
00:18:57,470 --> 00:19:00,680
.لكن ما كان هاروسامي ليتجاهلوها وينسحبوا

259
00:19:03,350 --> 00:19:05,190
.يساورني شعور سيّئ حيال الأمر

260
00:19:07,470 --> 00:19:10,420
.أبعدا قبضاتكما أنتما الاثنان

261
00:19:10,880 --> 00:19:12,200
.لم يفت الأوان بعد

262
00:19:13,100 --> 00:19:15,200
.ما زال بإمكاننا العودة

263
00:19:16,230 --> 00:19:17,330
.كاغورا

264
00:19:17,330 --> 00:19:19,750
.لا، لقد فات الأوان

265
00:19:25,260 --> 00:19:27,180
!كاغورا

266
00:19:29,840 --> 00:19:32,750
!لم يعد لعائلتك وجود

267
00:19:33,670 --> 00:19:37,140
!لم يعد لأخيك الكبير الّذي عرفته وجود

268
00:19:37,600 --> 00:19:39,900
!ولن يبقى لأبيك الّذي عرفتَه وجودٌ قريبًا أيضًا

269
00:19:40,280 --> 00:19:42,650
.شكرًا لك يا أختي

270
00:19:43,040 --> 00:19:45,300
،إن ماتت ابنته أمام عينيه

271
00:19:45,300 --> 00:19:48,280
!فقد يستيقظ ذلك الوحش مرّة أخرى

272
00:19:48,280 --> 00:19:50,240
!كاموي

273
00:19:54,290 --> 00:19:58,560
.أختك الصّغيرة الّتي عرفتها لم يعد لها وجود أيضًا

274
00:20:02,280 --> 00:20:06,670
.أنت الوحيد الّذي لم يتغيّر يا كاموي

275
00:20:07,170 --> 00:20:10,220
!لم تصبح قويًّا على الإطلاق

276
00:20:14,820 --> 00:20:17,880
ما زلت نفس الفتى البكّاء
.الّذي بكى عندما تخلّى عنّا بابا

277
00:20:18,540 --> 00:20:21,400
.نفس الفتى الّذي ادّعى الشّجاعة أمام ماما

278
00:20:23,360 --> 00:20:24,900
.لم يتغيّر شيء أبدًا

279
00:20:26,880 --> 00:20:30,780
،تركتك ماما والجميع

280
00:20:31,170 --> 00:20:33,560
.لذا أنت تبكي وتدّعي الشّجاعة

281
00:20:33,560 --> 00:20:36,900
.أنت نفس أخي البكّاء الكبير القديم

282
00:20:41,670 --> 00:20:43,320
!أيّها الأخ الغبيّ

283
00:20:43,320 --> 00:20:49,050
لم أعد الأخت الّتي كنت تعرفها والّتي
!كانت تذرف الدّموع إلى جانبك

284
00:20:49,050 --> 00:20:53,300
يمكنني أن أقف جنبًا إلى جنب معك
!وأقاتل وأنزف الدّماء معك

285
00:20:57,640 --> 00:20:58,570
...لذا

286
00:20:59,230 --> 00:21:01,980
!عد إلينا يا كاموي

287
00:21:08,100 --> 00:21:09,870
!عليك أن تشرهما في مكان آخر

288
00:21:14,620 --> 00:21:17,820
...سأقاتل معك، لذا

289
00:21:19,850 --> 00:21:20,790
...توقّفا

290
00:21:23,150 --> 00:21:24,040
...توقّفا

291
00:21:26,320 --> 00:21:27,600
.هذا يكفي

292
00:21:27,600 --> 00:21:30,300
!توقّفا رجاءً

293
00:21:30,640 --> 00:21:32,210
...أوميبوزو

294
00:21:41,730 --> 00:21:45,230
!أوميبوزو

295
00:22:00,700 --> 00:22:02,290
!بابا

296
00:22:07,960 --> 00:22:10,550
!بابا

297
00:24:00,910 --> 00:24:06,290
.الفتاة المثيرة الغامضة الّتي ظهرت في أغنية البداية

298
00:24:00,910 --> 00:24:06,290
...سيتمّ الكشف عن هويّتها الأسبوع القادم

299
00:24:06,290 --> 00:24:12,000
،في الواقع، يبدو أن أغنية النّهاية قد أفسدت الأمر تمامًا بالفعل

300
00:24:06,290 --> 00:24:12,000
.لكنّنا سنبذل جهدنا لندّعي أنّ لا أحد لاحظ الأمر