1
00:00:03,110 --> 00:00:09,870
كانت أمنا متحوّلة أنجبها سيل الألتانا
...على كوكب كووان

2
00:00:10,650 --> 00:00:14,900
خالدةً ما كانت لتموت
.لو أنّها بقيت على ذلك الكوكب

3
00:00:15,870 --> 00:00:20,330
.لا يعرف أحد إلى متى كانت لتعيش هناك بمفردها

4
00:00:23,000 --> 00:00:24,420
،لكن هناك شيء واحد مؤكّد

5
00:00:25,050 --> 00:00:29,630
.جعل ذلك الرّجل تلك الزّهرة اليتيمة تذبل وتموت

6
00:00:30,740 --> 00:00:33,140
ما قَتل أمَّنا

7
00:00:33,860 --> 00:00:35,720
.هو والدنا

8
00:02:28,030 --> 00:02:30,600
.لا تهاجموني بكلام بذيء مجدّدًا

9
00:02:30,600 --> 00:02:32,540
.لن تفلتوا بهذه السّهولة إن فعلتم

10
00:02:32,920 --> 00:02:34,590
!سنقولها مرارًا وتكرارًا

11
00:02:34,590 --> 00:02:36,940
!اخرج من هذه البلدة بسرعة

12
00:02:36,940 --> 00:02:37,790
!أنتما

13
00:02:37,790 --> 00:02:39,710
!ما الّذي تفعلانه؟

14
00:02:39,710 --> 00:02:41,200
!تبًّا، إنّه أوميبوزو

15
00:02:41,200 --> 00:02:41,880
!اهربوا

16
00:02:42,320 --> 00:02:43,270
!أبي

17
00:02:44,540 --> 00:02:46,510
!لا تعتدِ على الضّعيف

18
00:02:48,260 --> 00:02:50,040
.لقد كان قِتالَ ثمانية ضدّ واحد

19
00:02:50,040 --> 00:02:52,110
.أنا من كان يُعتَدى عليه

20
00:02:52,110 --> 00:02:54,270
.لا يمكن لثمان نملات الاعتداء على فيل

21
00:02:54,790 --> 00:02:56,890
.لا تستعمل قوّة الياتو المتوارثة من دون سبب

22
00:02:56,890 --> 00:02:58,480
.قلت لي أن أصبح أقوى

23
00:02:58,820 --> 00:03:02,970
أيّ نوع من الإخوة يورّط أخته في قتال؟

24
00:03:02,970 --> 00:03:04,320
أليس كذلك يا كاغورا-تشان؟

25
00:03:05,590 --> 00:03:08,150
!لقد كنت مخطئًا! كان هناك فيلان

26
00:03:08,150 --> 00:03:12,620
لكنّ أولئك الأشخاص نعتوا أمّي بالممراض
.مع أنّهم لا يعرفون شيئًا

27
00:03:15,190 --> 00:03:18,160
أبي، ما هو مرض أمّي؟

28
00:03:18,600 --> 00:03:19,860
هل ستتحسّن حقًّا؟

29
00:03:20,950 --> 00:03:23,800
ألا يوجد شيء يمكنني فعله للمساعدة؟

30
00:03:25,670 --> 00:03:26,790
.لا تقلق

31
00:03:26,790 --> 00:03:29,890
هل تعلم كم تساعدها فقط ببقائك إلى جانبها؟

32
00:03:30,310 --> 00:03:33,100
.سأهتمّ بأمر مرض أمّك

33
00:03:33,100 --> 00:03:34,940
.لذا كفّ عن التّهوّر

34
00:03:37,800 --> 00:03:39,900
.شعرت أنّي لم أُؤخَذ على محمل الجدّ

35
00:03:41,150 --> 00:03:43,160
،وظننت أنّ أمّي لا تتعافى من مرضها

36
00:03:43,160 --> 00:03:45,420
،وأنّه كفّ عن المجيء مرارًا

37
00:03:46,000 --> 00:03:48,040
.لأنّي كنت أفتقر للقوّة

38
00:03:50,420 --> 00:03:51,570
.كن أقوى

39
00:03:53,910 --> 00:03:56,790
.لذا حاولت أن أصبح أقوى

40
00:04:08,080 --> 00:04:10,530
كاموي، تشاجرت مجدّدًا، أليس كذلك؟

41
00:04:10,530 --> 00:04:11,930
!لـ-لا، لم أفعل

42
00:04:11,930 --> 00:04:13,620
.بدأتَ تشبهه

43
00:04:13,620 --> 00:04:15,030
.أنت لا تجيد الكذب

44
00:04:15,030 --> 00:04:16,700
.تابع ذلك وستصبح أصلعًا

45
00:04:16,700 --> 00:04:17,900
!مستحيل

46
00:04:17,900 --> 00:04:19,300
.تعال

47
00:04:19,300 --> 00:04:20,440
.لـ-لا

48
00:04:20,440 --> 00:04:22,940
.هناك شيء لم ترثه إذًا

49
00:04:22,940 --> 00:04:25,380
لم يمانع ذلك الأصلع أن أعامله
.كطفل صغير متى احتاج ذلك

50
00:04:26,440 --> 00:04:27,490
.هذا جيّد

51
00:04:27,490 --> 00:04:29,320
!أنا أيضًا

52
00:04:29,320 --> 00:04:31,780
.اليوم دور أخيك الكبير

53
00:04:31,780 --> 00:04:34,870
.يا إلهي. لقد ورثت غباءه كلّه

54
00:04:37,740 --> 00:04:39,070
...أنا آسفة

55
00:04:39,580 --> 00:04:42,830
.لجعلك تتحمّل عبئًا كبيرًا على هذا العاتق الصّغير

56
00:04:43,830 --> 00:04:48,290
.أصبحتُ زوجته لأنّي أردت أن أبقى إلى جانبه

57
00:04:49,680 --> 00:04:53,280
.أردتُ أن أبقى معكم بعد أن ولدتما

58
00:04:54,950 --> 00:04:56,510
،لذا يا كاموي

59
00:04:56,510 --> 00:04:59,220
.ابقيا كما أنتما

60
00:05:02,100 --> 00:05:05,650
.بدأ يتعذّر عليّ فهم معنى أن أكون قويًّا

61
00:05:06,120 --> 00:05:07,380
...هؤلاء

62
00:05:07,380 --> 00:05:08,920
.إنّهم هاروسامي

63
00:05:11,790 --> 00:05:13,360
.ها قد أتى كيس التّمرين

64
00:05:16,350 --> 00:05:17,120
!كاغورا

65
00:05:17,120 --> 00:05:18,700
!لا تعتدوا على كاموي

66
00:05:19,130 --> 00:05:22,710
!وعدنا ماما ألاّ نقلقها مجدّدًا

67
00:05:22,710 --> 00:05:25,210
!وعدناها أن نبقى معًا دائمًا

68
00:05:25,210 --> 00:05:26,630
!اخرسي أيّتها الصّغيرة

69
00:05:28,000 --> 00:05:29,630
!كاغورا

70
00:05:35,760 --> 00:05:40,350
لا يعلّم النّاس على هذا الكوكب
.أولادهم الأشقياء جيّدًا

71
00:05:40,350 --> 00:05:42,640
.كان عليّ أن ألقّنهم درسًا

72
00:05:43,060 --> 00:05:44,140
.أيّها الأرنب الصّغير

73
00:05:44,880 --> 00:05:46,940
،إن كنت لا تريد أن تصبح شرّيرًا

74
00:05:46,940 --> 00:05:49,780
.فتعلّم أن تحمي أختك الصّغيرة

75
00:05:51,500 --> 00:05:53,580
ما الّذي تفعله يا أبوتو؟

76
00:05:54,330 --> 00:05:55,650
.لا شيء

77
00:05:55,650 --> 00:05:58,660
حاولتُ أن أتغوّط في الخارج، لكنّي وجدت
.المكان مليئًا بالبراز سلفًا

78
00:06:06,490 --> 00:06:07,670
...ظننتني أخبرتك

79
00:06:08,160 --> 00:06:10,550
.أنّ القوّة تنقضها القوّة

80
00:06:11,080 --> 00:06:13,660
.أنت محتار بشأن ما تعنيه القوّة بالفعل

81
00:06:14,670 --> 00:06:16,140
.لست أفهم

82
00:06:17,220 --> 00:06:18,710
ما هي القوّة؟

83
00:06:19,150 --> 00:06:21,160
أن أسمح للآخرين بضربي؟

84
00:06:21,160 --> 00:06:24,180
أن أؤذي الآخرين لحماية عائلتي؟

85
00:06:25,830 --> 00:06:30,070
أن أذهب لأقاتل وحيدًا دون أن أهتمّ لعائلتي؟

86
00:06:31,730 --> 00:06:35,070
.لم أعد أفهم أبدًا

87
00:06:41,230 --> 00:06:42,710
.أنا أيضًا لا أفهم

88
00:06:45,930 --> 00:06:47,480
لكنّك ستذهب رغم ذلك؟

89
00:06:48,490 --> 00:06:50,130
.أجل يا كوكا

90
00:06:50,930 --> 00:06:55,130
،تمامًا كما جازفت بحياتك آملة أن تكوني معنا

91
00:06:55,500 --> 00:06:59,980
.سأبقيكم أحياءً حتّى وإن كلّفني ذلك ترككم

92
00:07:01,480 --> 00:07:05,520
سأحمي عائلتي حتّى وإن خسرت
.حقّ اعتبار نفسي أبًا

93
00:07:06,170 --> 00:07:11,270
بصفتي الرّجل الّذي جعل الزّهرة
،المتفتّحة على كوكب الموت تذبل

94
00:07:11,270 --> 00:07:13,480
.سأتحمّل ذلك العبء

95
00:07:14,460 --> 00:07:16,610
.يا له من كون واسع هذا الّذي نعيش فيه

96
00:07:17,120 --> 00:07:19,870
،أنا مندهش أنّه كان هناك كائن مثلي

97
00:07:19,870 --> 00:07:23,620
.وآخرون رأوها تموت

98
00:07:24,430 --> 00:07:26,840
ما كان التّعبير الّذي اعتلى وجهها؟

99
00:07:27,330 --> 00:07:30,000
تعبير بالارتياح لنهاية سنوات فراغها؟

100
00:07:30,860 --> 00:07:34,250
أم تعبير كراهيّة تجاه أحبّائها الّذين قتلوها؟

101
00:07:35,960 --> 00:07:36,760
لماذا؟

102
00:07:38,050 --> 00:07:40,910
لِمَ أحببت أمّي؟

103
00:07:41,590 --> 00:07:44,390
...لو لم تحضرها من ذلك الكوكب

104
00:07:44,880 --> 00:07:47,040
.أنت من يسبّب لها المعاناة

105
00:07:47,630 --> 00:07:49,140
.هذا صحيح

106
00:07:50,090 --> 00:07:52,540
.كانت بمفردها، ولم أتمكّن من تجاهل ذلك

107
00:07:53,020 --> 00:07:54,470
.أردت حمايتها

108
00:07:55,040 --> 00:07:58,780
.لكن أنا من تلقّيت الحماية

109
00:07:59,330 --> 00:08:01,520
.لا يمكنني العيش على ذلك الكوكب

110
00:08:01,520 --> 00:08:05,290
.لكنّ أمّك لا تستطيع العيش في كوكب عداه

111
00:08:06,080 --> 00:08:08,160
.لهذا السّبب أتت معي دون أن تقول شيئًا

112
00:08:08,910 --> 00:08:11,930
،بدل العيش بمفردها إلى الأبد

113
00:08:11,930 --> 00:08:14,770
.اختارت أن تعيش معنا وتموت

114
00:08:15,990 --> 00:08:17,860
.لُمني إن اقتضى الأمر

115
00:08:18,320 --> 00:08:21,930
،لكن حتّى وإن أدركتُ ذلك حينها

116
00:08:22,280 --> 00:08:26,060
.كنت لأسلك نفس الطّريق

117
00:08:26,710 --> 00:08:29,940
.لأنّ ذلك أحضركما إلى حياتي

118
00:08:33,350 --> 00:08:37,190
واصلت الخطوات الّتي كنت أحاول
.اتّباعها دائمًا الابتعاد

119
00:08:37,930 --> 00:08:39,950
كان المتسبّبون في معاناة أمّي

120
00:08:40,590 --> 00:08:42,210
.هم نحن الثّلاثة، عائلتها

121
00:08:44,170 --> 00:08:46,070
.إنّه ذلك الرّجل. فلنفعل هذا

122
00:08:52,010 --> 00:08:53,120
.أنت

123
00:08:59,200 --> 00:09:03,460
.هذه ليست عينا أخ أتى للانتقام لأخته الصّغيرة

124
00:09:04,020 --> 00:09:07,510
قد يكون لديك الإمكانيّات لتصبح
.شرّيرًا أكبر من هؤلاء

125
00:09:07,830 --> 00:09:09,380
...لا أهتمّ

126
00:09:09,980 --> 00:09:12,480
!ما دمت سأصبح أقوى

127
00:09:13,350 --> 00:09:15,440
مهلاً، ما سبب هذا؟

128
00:09:15,440 --> 00:09:18,880
هل أتيتَ حقًّا لدرس كي تعرف كيف تصبح شرّيرًا؟

129
00:09:18,880 --> 00:09:20,540
.انظر إلى أبوتو

130
00:09:20,540 --> 00:09:21,790
.هذا ليس مضحكًا

131
00:09:21,790 --> 00:09:23,360
!نل منه يا فتى

132
00:09:23,360 --> 00:09:25,240
!هذا الفتى

133
00:09:28,450 --> 00:09:30,580
.إنّها ركلة جيّدة يا فتى

134
00:09:31,150 --> 00:09:34,920
.يقبل قائد القسم السّابع لهاروسامي تحدّيك

135
00:09:35,990 --> 00:09:37,100
.أنت أيّها الضعيف

136
00:09:37,750 --> 00:09:41,590
،أيّ شخص يُلقي بلكمة جادّة نحوك
،سواء كان طفلاً أو أيًّا كان

137
00:09:42,090 --> 00:09:44,290
.عليك أن تردّ عليه بلكمة جادّة أيضًا

138
00:09:44,760 --> 00:09:46,940
.هذه من الآداب الأساسيّة للرّجال

139
00:09:53,890 --> 00:09:55,840
هل تريد أن تكون قويًّا؟

140
00:09:55,840 --> 00:09:58,700
.اعرف مدى ضعفك إذًا

141
00:09:59,700 --> 00:10:00,400
.تعال مجدّدًا

142
00:10:02,410 --> 00:10:03,900
...ذلك الفتى

143
00:10:07,010 --> 00:10:09,030
.لديه نفس عينيْ ذلك الرّجل

144
00:10:10,320 --> 00:10:13,270
أردتُ أن أعرف شكلاً آخر للقوّة
.يختلف عمّا يعرفه هو

145
00:10:14,740 --> 00:10:18,670
.لكن في نفس الوقت الّذي أدركت فيه مدى ضعفي

146
00:10:19,140 --> 00:10:21,920
،أدركت أنّي وذاك الرّجل

147
00:10:22,700 --> 00:10:24,550
...عائلتنا

148
00:10:25,090 --> 00:10:27,050
.لن نستطع إنقاذها

149
00:10:29,430 --> 00:10:31,350
...إذًا سوف

150
00:10:38,370 --> 00:10:41,820
...إذًا... سوف

151
00:10:50,660 --> 00:10:52,330
.أيّها الأرنب اللّعين

152
00:10:52,330 --> 00:10:55,580
استطعت إصابة هوسين العظيم؟

153
00:10:56,160 --> 00:10:57,930
.أخبرني ماذا تريد

154
00:10:57,930 --> 00:11:01,880
...أن تتلقّى الضّرب حتّى الموت هنا والآن، أو

155
00:11:03,170 --> 00:11:04,710
.خذنا بعيدًا

156
00:11:05,660 --> 00:11:09,220
.خذني أنا وأمّي بعيدًا عن هذا الكوكب

157
00:11:09,700 --> 00:11:12,720
.أمّي، لنعد إلى كوكبك

158
00:11:13,870 --> 00:11:15,730
متى علمت بالأمر؟

159
00:11:16,420 --> 00:11:19,490
.أنا واثق أنّك ستتحسّنين إن عدنا

160
00:11:20,260 --> 00:11:23,810
حتّى الأزهار الذّابلة يمكن إنقاذها
...إن أعيد زرعها في الأرض

161
00:11:23,810 --> 00:11:24,730
.كاموي

162
00:11:25,460 --> 00:11:27,470
.دعني أبقى هنا

163
00:11:28,110 --> 00:11:29,740
.أريد أن أبقى إلى جانبكم

164
00:11:30,310 --> 00:11:32,570
.ليس عليك ذلك

165
00:11:33,030 --> 00:11:35,120
.لا أهتمّ إن لم ندعُ أنفسنا بالعائلة بعد الآن

166
00:11:35,660 --> 00:11:39,290
.أريدك أن تعيشي رغم ذلك

167
00:11:40,420 --> 00:11:43,340
لِمَ ورثتَ عنه ذلك الجانب أيضًا؟

168
00:11:46,330 --> 00:11:47,300
!ماما

169
00:11:47,300 --> 00:11:49,430
ما الّذي تفعله يا كاموي؟

170
00:11:49,430 --> 00:11:51,810
إلى أين ستأخذ ماما؟

171
00:11:52,310 --> 00:11:53,180
!بابا

172
00:11:54,400 --> 00:11:57,560
لِمَ اخترت القيام بهذا بعد عودتي؟

173
00:11:58,240 --> 00:11:59,770
...لأنّي أعرف

174
00:12:00,490 --> 00:12:04,400
.أنّه لإنقاذ أمّي، عليّ أن أتخلّى عن فكرة العائلة

175
00:12:05,630 --> 00:12:08,150
.وأنّ عليّ أن أدوس عليك لأفعل ذلك

176
00:12:10,490 --> 00:12:11,910
.هذا صحيح

177
00:12:11,910 --> 00:12:13,300
...لم أعد

178
00:12:16,580 --> 00:12:19,460
!ابتعدي عن طريقي

179
00:12:23,610 --> 00:12:24,870
.توقّف يا كاموي

180
00:12:24,870 --> 00:12:26,500
!سأنقذ والدتك

181
00:12:26,500 --> 00:12:27,840
!لقد وعدتك بذلك

182
00:12:29,750 --> 00:12:32,590
—انتظر! هناك شيء أريد أن أريه

183
00:12:33,540 --> 00:12:34,950
!انظر إلى هذا

184
00:12:34,950 --> 00:12:36,260
...بهذه يمكن لوالدتك

185
00:12:38,020 --> 00:12:41,570
.أصبحت أقوى لكي أحمي عائلتي

186
00:12:42,270 --> 00:12:44,400
.أنت من قال لي أن أفعل ذلك

187
00:12:44,400 --> 00:12:50,450
لذا سآخذ أمّي معي حتّى وإن اضطررت
.لقطع ذراعك الّتي توقفنا

188
00:12:51,010 --> 00:12:54,510
.سأحمي عائلتنا حتّى وإن لم نبقَ عائلة

189
00:12:58,790 --> 00:13:03,380
،مهما كان الّذي حاولنا حمايته

190
00:13:03,380 --> 00:13:05,290
.فلم يعد موجودًا

191
00:13:14,800 --> 00:13:18,810
...تخلّيت عن عائلتي وفشلت في حماية والدتنا

192
00:13:19,610 --> 00:13:22,670
.كلّ ما بقي لي هو أن أصبح أقوى

193
00:13:23,680 --> 00:13:26,600
.كلّ ما بقي لي هو أن أتخطّى ذلك الرّجل

194
00:13:28,980 --> 00:13:31,450
،لذا يا كاغورا

195
00:13:32,000 --> 00:13:33,200
.دعيني أذهب رجاءً

196
00:13:34,910 --> 00:13:36,700
.توقّفي عن اعتراض طريقي

197
00:13:37,180 --> 00:13:40,080
...ذلك الوجه وذلك الصّوت

198
00:13:43,080 --> 00:13:45,560
.لا ترغميني على مواصلة رؤيتهما وسماعهما

199
00:14:04,090 --> 00:14:06,560
.لا يمكنني التّحرّك

200
00:14:08,040 --> 00:14:10,530
.لم يساورني هذا الشّعور من قبل

201
00:14:10,530 --> 00:14:12,280
،عليّ أن أقاتله

202
00:14:14,400 --> 00:14:16,530
.وهذا الكوكب خشبة صغيرة لفعل ذلك

203
00:14:18,990 --> 00:14:21,240
.لا يمكن لسلاحي مجاراتي

204
00:14:21,240 --> 00:14:22,290
وجسدي

205
00:14:23,230 --> 00:14:24,290
.يشكّل عائقًا

206
00:14:27,430 --> 00:14:30,000
.أشعر أنّ كلّ شيء يعيقني

207
00:14:30,580 --> 00:14:31,950
،بمواجهة ذلك الشّيء

208
00:14:32,660 --> 00:14:34,330
!حتّى الحياة تبدو مقيّدة

209
00:14:37,440 --> 00:14:44,310
كوكا، أنا غبيّ من النّوع الّذي دفع
.خالدة مثلك إلى الموت

210
00:14:44,800 --> 00:14:47,190
لكن هناك أشياء وحدهم الأغبياء
.قادرون على فعلها

211
00:14:47,670 --> 00:14:49,440
...أعيريني قوّتك

212
00:14:49,440 --> 00:14:53,440
!ساعديني في حماية عائلتنا

213
00:14:58,120 --> 00:14:59,730
ما الّذي تنوي فعله؟

214
00:14:59,730 --> 00:15:02,960
.أنا أحاول إزهاق روح خالدة هنا

215
00:15:02,960 --> 00:15:05,200
عليّ أن أكون مستعدًّا للتّخلّي عن كل شيء

216
00:15:05,200 --> 00:15:08,100
.وأن أقاتل بروحي فقط أيضًا

217
00:15:11,760 --> 00:15:15,210
.سحقُ قلبي لن يجعلني أختفي

218
00:15:15,210 --> 00:15:18,220
.قلبك ليس الشّيء الوحيد هنا

219
00:15:18,220 --> 00:15:22,620
.هناك أيضًا هديّة كنت سأعطيها لزوجتي، بلّورة ألتانا

220
00:15:24,100 --> 00:15:27,240
.أنتما كائنان ولدتما من ألتانا

221
00:15:27,240 --> 00:15:30,730
لا يمكنكما أن تبقيا حيّين إن ابتعدتما
.عن كوكبيكما الأمّ

222
00:15:31,320 --> 00:15:33,710
،لكي أبقي على حياة زوجتي

223
00:15:33,710 --> 00:15:37,200
بحثت في جميع أرجاء الكوكب
.عن أيّ بقايا لبلّورات ألتانا

224
00:15:38,060 --> 00:15:40,740
.لم أتوقّع أن أستعمل إحداها بهذا الشّكل

225
00:15:41,320 --> 00:15:43,590
هل ولدت على الأرض؟

226
00:15:44,210 --> 00:15:48,000
أتساءل ما سيحدث إن سحقت
.هذه البلورة مع قلبك

227
00:15:49,010 --> 00:15:52,960
ماذا تظنّ سيحدث أوّلاً؟
فعلك لذلك، أم شطري لك نصفين؟

228
00:15:53,330 --> 00:15:54,690
.لا أدري

229
00:15:54,690 --> 00:15:56,570
،لكنّي أعلم على الأقلّ

230
00:15:57,470 --> 00:16:02,760
أنّي من النّوع الّذي يشتري الهدايا
!لزوجته قبل شهر كامل

231
00:16:10,840 --> 00:16:13,170
،بما أنّك ولدت على الأرض

232
00:16:13,170 --> 00:16:14,990
فتعرّضك لألتانا من كوكب آخر

233
00:16:14,990 --> 00:16:18,350
.يشبه ملء سيارة بنزين بوقود ديزِل

234
00:16:18,350 --> 00:16:19,900
.سيتعطّل محرّكك من دون شكّ

235
00:16:21,000 --> 00:16:24,140
.فلتمت مثلنا

236
00:16:27,110 --> 00:16:31,210
كوكا، أخيرًا تمكّنت من إيصال

237
00:16:33,700 --> 00:16:35,460
.هديّتي الأخيرة لك

238
00:16:39,730 --> 00:16:41,180
.اقبليها رجاءً

239
00:16:45,890 --> 00:16:49,750
!أوميبوزو

240
00:16:52,370 --> 00:16:56,440
إن كنت قادرًا على الموت من شيء كهذا
.فما كنت لأواجه كلّ هذه المتاعب

241
00:16:56,940 --> 00:16:58,440
.للأسف

242
00:16:59,170 --> 00:17:03,450
حتّى أنت لم تستطع قتلي إذًا؟

243
00:17:09,710 --> 00:17:10,960
...بابا

244
00:17:12,210 --> 00:17:13,710
!أوميبوزو

245
00:17:16,440 --> 00:17:18,710
لِمَ يوجد اثنان منه؟

246
00:17:19,520 --> 00:17:20,720
!لا يمكن

247
00:17:20,720 --> 00:17:23,760
هل تجدّد من ذراعه اليمنى المبتورة؟

248
00:17:24,360 --> 00:17:27,990
.يبدو أنّ كلانا فكرّ في نفس الفكرة

249
00:17:30,110 --> 00:17:35,060
الفرق الوحيد هو أنّه كان يملك
.حياة واحدة ليضحّي بها

250
00:17:35,060 --> 00:17:36,870
!أيّها الوحش

251
00:17:39,040 --> 00:17:43,210
.لكن يبدو أنّ ألتانا نفدت مني

252
00:17:44,350 --> 00:17:45,740
،بفضلك

253
00:17:45,740 --> 00:17:47,670
تمكّنت من اختبار الموت، وهذا الشّعور بالحياة

254
00:17:47,670 --> 00:17:50,750
.لأوّل مرّة منذ قرون

255
00:17:51,330 --> 00:17:56,380
.لكن هذا أيضًا ليس سوى افتتاح للنّهاية القادمة

256
00:17:57,490 --> 00:18:00,760
.لنلتقِ مجدّدًا يومًا ما في الآخرة

257
00:18:04,510 --> 00:18:06,810
!تماسك

258
00:18:07,400 --> 00:18:10,770
.يبدو أنّه قد غادر

259
00:18:11,610 --> 00:18:15,020
.هذا يعني أنّي فزت

260
00:18:16,130 --> 00:18:19,240
،فقدت ذراعي اليسرى بالتّخلّي عن عائلتي

261
00:18:19,770 --> 00:18:24,780
.لكنّي فقدت ذراعي اليمني لحمايتها

262
00:18:25,410 --> 00:18:28,530
.كان هذا عملاً جيّدًا مفاجئًا بالنّسبة لي

263
00:18:29,020 --> 00:18:30,120
...أنت

264
00:18:30,120 --> 00:18:32,620
أيّ عمل جيّد؟

265
00:18:32,620 --> 00:18:38,170
ألم تحتفظ بذراعك اليمنى فقط لتهزم ابنك الغبيّ؟

266
00:18:38,170 --> 00:18:40,760
فلِمَ هي ملقاة هناك إذًا؟

267
00:18:40,760 --> 00:18:43,630
لِمَ سمحت لرجل مثله بإهانتك؟

268
00:18:44,150 --> 00:18:45,410
.قف

269
00:18:45,410 --> 00:18:48,130
.لم نسوِّ حسابنا بعد

270
00:18:48,130 --> 00:18:49,100
...أيّها القائد

271
00:18:49,390 --> 00:18:52,230
!أعلم أنّك أفضل من هذا

272
00:18:53,140 --> 00:18:54,390
!قف

273
00:18:54,390 --> 00:18:56,590
.توقّف أيّها القائد

274
00:18:56,590 --> 00:18:59,900
...أوميبوزو، أبوك قد

275
00:19:00,900 --> 00:19:03,770
!توقّف يا كاموي

276
00:19:14,910 --> 00:19:16,290
...غين-تشان

277
00:19:16,290 --> 00:19:18,040
...شينباتشي

278
00:19:18,800 --> 00:19:20,500
لِمَ أتيتما إلى هنا؟

279
00:19:20,500 --> 00:19:23,830
تريد أن تخبرنا ألاّ نتدّخل في شؤون عائلتك؟

280
00:19:23,830 --> 00:19:27,300
.صحيح أنّه لا تربطنا علاقة دمويّة

281
00:19:27,730 --> 00:19:31,690
،لكنّنا عشنا تحت سقف واحد وأكلنا نفس الطّعام

282
00:19:31,690 --> 00:19:35,130
.وضحكنا وبكينا وغضبنا على نفس الأشياء

283
00:19:35,730 --> 00:19:37,310
.نحن الأعمال الحرّة

284
00:19:39,250 --> 00:19:43,320
.لا نحتاج روابط دمويّة لمساعدتها

285
00:19:43,320 --> 00:19:44,750
.كاموي-سان

286
00:19:44,750 --> 00:19:46,630
.أرخِ قبضتك

287
00:19:47,180 --> 00:19:49,320
لا تجعل كاغورا-تشان وعائلتك

288
00:19:49,810 --> 00:19:52,310
.ونفسك تعاني بعد الآن

289
00:19:52,310 --> 00:19:55,540
.أنتما من تجعلانها تعاني

290
00:19:56,270 --> 00:19:59,180
.لقد وجدت منزلاً جديدًا أخيرًا

291
00:19:59,180 --> 00:20:01,710
هل تحاولان إرغامي على تحطيمه؟

292
00:20:02,760 --> 00:20:04,790
.لن نتحطّم

293
00:20:05,290 --> 00:20:07,880
،مثلما تأبى كاغورا-تشان أن تتخلّى عنك

294
00:20:08,570 --> 00:20:12,090
.فلن نتخلّى عنها أو عن أيّ أحد آخر أيضًا

295
00:20:12,090 --> 00:20:15,720
.لذا لا أنت ولا نحن سنتحطّم

296
00:20:16,630 --> 00:20:19,400
.فات الأوان. لا مجال للعودة

297
00:20:19,950 --> 00:20:21,730
.ماتت أمّي

298
00:20:22,480 --> 00:20:26,190
.لن ينتهي شيء بالنّسبة لنا إلى أن يسقط أحدنا

299
00:20:27,020 --> 00:20:28,490
حقًّا؟

300
00:20:28,490 --> 00:20:31,720
.سأنهي كلّ شيء من أجلك إذًا

301
00:20:34,090 --> 00:20:35,410
...ما الّذي

302
00:20:40,170 --> 00:20:43,380
.هذا يجعلني الشّخص الّذي قضى الأقوى

303
00:20:44,350 --> 00:20:45,880
.أنا الأقوى الآن

304
00:20:45,880 --> 00:20:47,520
!هل تمزح؟

305
00:20:47,520 --> 00:20:49,700
هل حطّت ذبابة على رأسي؟

306
00:20:49,700 --> 00:20:52,110
!لم تؤذه أبدًا! بل آذيت نفسك فحسب

307
00:20:52,110 --> 00:20:54,630
نطحُ رجل نصف ميّت والإصابة بالأذى جرّاء ذلك

308
00:20:54,630 --> 00:20:56,710
!يجعلك الأسوأ والأضعف

309
00:20:56,710 --> 00:20:58,550
،مهما قال الجميع

310
00:20:58,550 --> 00:21:01,480
.أنا الشّخص الّذي سدّد الضّربة القاضية

311
00:21:01,480 --> 00:21:03,600
."لقد ورثتُ لقب "الأقوى

312
00:21:03,600 --> 00:21:06,270
.إلى جانب واجب مجالستك يا كاموي

313
00:21:08,870 --> 00:21:11,990
.ما كنت تبحث عنه موجود هنا

314
00:21:11,990 --> 00:21:13,280
.إن كنت تريده، فتعال لأجله

315
00:21:13,920 --> 00:21:17,910
.جرّب مهاجمتي بكلّ ما تعلّمته لهزيمة ذلك الأصلع

316
00:21:19,440 --> 00:21:24,100
أحلامك وعملك الشّاق ورغبتك
...في أن تكون الأقوى

317
00:21:24,100 --> 00:21:27,940
.سأسحقها جميعها بصفتي غريبًا عنك تمامًا

318
00:21:28,640 --> 00:21:32,090
.هذه هي القيمة التّافهة للشّيء الّذي لطالما أردتَه

319
00:21:32,940 --> 00:21:34,550
ألم تسمعني؟

320
00:21:34,550 --> 00:21:37,970
!قلت لك ابتعد عن طريقي

321
00:21:37,970 --> 00:21:39,970
ألم تسمعني؟

322
00:21:39,970 --> 00:21:42,410
.قلت لك أن تهاجمني بكلّ ما لديك

323
00:21:46,350 --> 00:21:48,760
أهذا كلّ ما لديك؟

324
00:21:48,760 --> 00:21:51,940
.ما كنت لتستطيع هزيمة والدك بهذا

325
00:21:52,710 --> 00:21:54,310
،ظننت أنّك كنت تطارده

326
00:21:54,310 --> 00:21:56,950
.لكنّك بدأت بالهرب في مرحلة ما

327
00:21:57,660 --> 00:21:59,950
.هربت من أبيك وعائلتك

328
00:22:00,670 --> 00:22:02,470
.أنت قوقعة فارغة

329
00:22:02,470 --> 00:22:04,980
.لهذا السّبب أردت أن تجد لنفسك غايةً

330
00:22:05,670 --> 00:22:08,270
لكن بقبضتيك الضّعيفتين، ما كنت لتسقط

331
00:22:08,270 --> 00:22:10,340
.شعر أبيك المستعار، فما بالك بي أنا

332
00:22:12,880 --> 00:22:13,980
الأقوى؟

333
00:22:13,980 --> 00:22:16,240
.أنت لست بحاجة للقب كذاك

334
00:22:16,240 --> 00:22:18,800
...فأنت تملك واحدًا يناسبك تمامًا

335
00:22:20,510 --> 00:22:21,860
!أيّها الأخ الغبيّ

336
00:23:56,350 --> 00:23:57,990
ألم ترمِ ذلك بعد؟

337
00:23:59,360 --> 00:24:00,820
.هذا هو حدّك

338
00:24:00,820 --> 00:24:06,330
.استحوذ غينتوكي على لقب الأقوى بنطحة رأس

339
00:24:00,820 --> 00:24:06,330
!ويواجه كاموي، عضو من جنس المحاربين الياتو، ليحدّدا من الرّقم واحد

340
00:24:06,330 --> 00:24:12,000
،وبينما كاغورا وشينباتشي يشاهدان

341
00:24:06,330 --> 00:24:12,000
...يحدث شيء غريب لكاموي