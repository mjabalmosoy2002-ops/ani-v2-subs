1
00:00:09,070 --> 00:00:15,300
غينتاما

2
00:00:10,630 --> 00:00:15,300
معركة راكويو

3
00:01:48,390 --> 00:01:54,890
!!شاهدوا هذا البرنامج في غرفة مضيئة ومن مسافة آمنة عن التّلفاز

4
00:01:49,770 --> 00:01:52,400
إذًا فهذا هو "فنّ الحرب" الخاصّ بالسّاموراي؟

5
00:01:52,400 --> 00:01:57,630
.لقد صددتَ هجومي مباشرة
.هذا أشبه بسحر أو شعوذة

6
00:01:57,630 --> 00:02:00,380
.فنّ الحرب ليس سحرًا

7
00:02:00,380 --> 00:02:04,810
".إنّ عصًا واحدة كافية للتّخلّص من قرد شَبِق"

8
00:02:04,810 --> 00:02:08,300
!هذه هي الجملة الوحيدة في ذلك الكتاب اللّعين+

9
00:02:08,300 --> 00:02:09,930
!أعجبتني

10
00:02:09,930 --> 00:02:11,930
.لا أحبّ الخدع أيضًا

11
00:02:12,240 --> 00:02:14,880
.لقد وصلت لهذه المرحلة بعصاةٍ واحدة

12
00:02:14,880 --> 00:02:17,480
،حتّى بوجود السّفن الّتي تسافر عبر النّجوم

13
00:02:17,480 --> 00:02:22,480
فنحن نفضّل الوقوف على أجساد
!أعدائنا على الوقوف على القمر

14
00:02:23,320 --> 00:02:26,160
!لم يتغيّر شيء مذ أن كنّا نزحف على الأرض

15
00:02:26,160 --> 00:02:29,070
!كلّ الرّجال قِردة

16
00:02:29,070 --> 00:02:32,910
!والآن، لنكتشف من القرد الّذي سيقف على قمّة الجبل

17
00:02:40,510 --> 00:02:42,290
.يا لها من حركة قذرة

18
00:02:42,990 --> 00:02:46,090
!أنت من قلت أنّك لن تستعمل سوى عصاةٍ واحدة

19
00:02:48,240 --> 00:02:50,200
!فقدتُ سنًّا

20
00:02:50,200 --> 00:02:51,720
ألم تعلم؟

21
00:02:53,720 --> 00:02:56,390
.تأتي العصا برفقة كرات دائمًا

22
00:03:03,060 --> 00:03:04,990
!إليزابيث، اركض

23
00:03:08,360 --> 00:03:09,360
!عرفتُ هذا! إنّه كمين

24
00:03:11,620 --> 00:03:13,870
!واصل الرّكض تحت ستار الدّخان

25
00:03:14,270 --> 00:03:16,510
!واصل الرّكض مهما حدث

26
00:03:16,510 --> 00:03:18,660
!واصل النّظر للأمام وواصل الرّكض

27
00:03:18,660 --> 00:03:19,580
أيمكنك ذلك؟

28
00:03:29,590 --> 00:03:32,560
.سامحني يا إليزابيث ويا رفاقي أيضًا

29
00:03:32,560 --> 00:03:36,900
.لا يمكنني الفوز في هذه المعركة في وضعي الحاليّ

30
00:03:36,900 --> 00:03:39,840
،بصفتي قائدًا يدير منظّمة

31
00:03:40,810 --> 00:03:42,740
.فلا يمكنني هزيمة ذلك الشّيء

32
00:03:42,740 --> 00:03:45,840
.لذلك عليّ العودة

33
00:03:45,840 --> 00:03:48,320
...ليس من أجل منظّمتي، ولا من أجل رفاقي

34
00:03:49,320 --> 00:03:51,660
،عليّ سلّ سيفي من أجلي أنا

35
00:03:52,690 --> 00:03:55,660
.بصفتي قردًا وحيدًا

36
00:03:56,410 --> 00:03:58,160
.كوتارو الهارب

37
00:03:58,610 --> 00:04:01,170
أليس ذلك ما كنتَ عليه حسبما قلت؟

38
00:04:02,880 --> 00:04:07,460
لم أتوقّع منك أن تظلّ في الخلف
.ليتمكّن رفاقك من الهرب

39
00:04:07,460 --> 00:04:11,730
ما كان لأحد أن يصفني بذلك إن لم أستطع
،التّفريق بين من يمكنني الهرب منهم

40
00:04:11,730 --> 00:04:13,850
.ومن لا يمكنني

41
00:04:14,280 --> 00:04:15,570
.فهمت

42
00:04:15,570 --> 00:04:17,850
إذًا فقد تقبّلت مصيرك؟

43
00:04:17,850 --> 00:04:19,990
.هذا ليس تقبّلاً لمصيري

44
00:04:19,990 --> 00:04:21,190
.إنّها عزيمة

45
00:04:21,790 --> 00:04:24,560
.لن أهرب ثانية

46
00:04:35,600 --> 00:04:37,230
كلاّ، عمّاذا تتحدّث؟

47
00:04:37,230 --> 00:04:39,650
!لا بدّ أن يكون غينتوكي-سان

48
00:04:39,650 --> 00:04:43,360
لقد رأيتم كيف كان شجاعًا عندما نفّذ ذلك
.الهجوم المفاجئ على ذلك الجيش الضّخم

49
00:04:43,360 --> 00:04:45,000
!قاتل وكأنّه شيطان

50
00:04:45,320 --> 00:04:48,380
!ما كان لأحد أن يهزمه سواء كان عدوًّا أم حليفًا

51
00:04:48,380 --> 00:04:49,860
عمّاذا تتحدّث؟

52
00:04:49,860 --> 00:04:53,760
ما كان ذلك الهجوم المفاجئ لينجح
.من دون مساعدة الكيهيتاي

53
00:04:53,760 --> 00:04:56,190
!الخطط الّتي تغلّبت على قوّة الأسلحة الحديثة

54
00:04:56,190 --> 00:04:58,210
!القوّة للإطاحة بسفينة حربيّة

55
00:04:58,210 --> 00:05:02,520
!الرّجل الأقوى هو قائدنا تاكاسوغي شينسكي

56
00:05:02,520 --> 00:05:04,520
عمّاذا تتحدّثون؟

57
00:05:04,960 --> 00:05:08,930
من في رأيكم يجعل هذه الحرب ممكنة؟

58
00:05:08,930 --> 00:05:11,050
.الجنود والأسلحة والمال

59
00:05:11,050 --> 00:05:14,030
هذا لأنّ هنالك من يوفّر كلّ هذه الأشياء، صحيح؟

60
00:05:14,350 --> 00:05:17,510
،بعبارات أخرى، الرّجل الأقوى هو تنّين كاتسوراهاما

61
00:05:17,510 --> 00:05:19,000
—ساكاموتو تاتسوما

62
00:05:18,370 --> 00:05:19,530
.مستحيل

63
00:05:19,530 --> 00:05:21,870
.نعم، أعرف أنّ ذلك ليس صحيحًا مهما حدث

64
00:05:21,870 --> 00:05:25,760
.لكنّ هوسه بالمال وجهارة صوته كانا ليهزما أيّ أحد

65
00:05:27,710 --> 00:05:28,950
.نعم، صحيح

66
00:05:28,950 --> 00:05:30,760
.مع أنّه يمكنني الهمس أيضًا

67
00:05:31,070 --> 00:05:36,050
إذًا فالخيار إمّا بين غينتوكي-سان
أو تاكاسوغي-سان، صحيح؟

68
00:05:36,050 --> 00:05:37,760
في الواقع، ماذا عن كاتسورا-سان؟

69
00:05:39,690 --> 00:05:42,770
.صراحةً، أنا لا أفهمه بالكامل

70
00:05:43,680 --> 00:05:47,760
إنّه أشبه بقائدٍ للملوك السّماويّين الأربعة
الّذي هدّأ ثورات

71
00:05:47,760 --> 00:05:50,280
.غينتوكي-سان وتاكاسوغي-سان مذ كانوا صغارًا

72
00:05:50,280 --> 00:05:54,440
.صحيح أنّه مثاليّ كجنرال وكقائد

73
00:05:54,440 --> 00:05:58,080
...لكنّ قوّته في الحرب وقوّته الفرديّة

74
00:05:58,080 --> 00:05:59,030
.يصعب قياسها

75
00:05:59,030 --> 00:06:03,650
تكمن مواهبه في المعارك الدّفاعيّة الثّابتة
.بدل المعارك الهجوميّة الشّجاعة

76
00:06:03,650 --> 00:06:08,040
ولذلك السّبب، يظفر غينتوكي-سان
.في العادة بمجد المعركة

77
00:06:08,040 --> 00:06:10,770
.إنّه لا يهاجم ولا يقع ضحيّة للاستفزازات

78
00:06:10,770 --> 00:06:14,380
هل تعرفون بماذا يصف العدوّ طريقة قتاله؟

79
00:06:14,830 --> 00:06:16,800
"...كوتارو الهارب"

80
00:06:17,120 --> 00:06:19,470
،الثّابت" تبدو وصفًا جيّدًا أيضًا"

81
00:06:19,470 --> 00:06:21,600
...لكنّها قد تعني الجبن أيضًا

82
00:06:21,600 --> 00:06:23,490
زورا؟ جبان؟

83
00:06:24,060 --> 00:06:26,690
.أنتم لا تعرفون شيئًا بالفعل

84
00:06:26,690 --> 00:06:29,340
.سيضحك غينتوكي وتاكاسوغي عليكم

85
00:06:29,340 --> 00:06:31,910
سا-ساكاموتو-سان؟ متى ظهرت؟

86
00:06:33,050 --> 00:06:35,200
.حسنًا، وصلت للتّوّ

87
00:06:35,520 --> 00:06:38,580
تقولون أنّه حقّق أقلّ من غينتوكي
والآخرين في المعارك؟

88
00:06:38,580 --> 00:06:41,700
.هذا فقط لأنّكم لم تروا ما الّذي أنجزه

89
00:06:42,080 --> 00:06:46,210
.القتال في معركة خاسرة أصعب من القتال في معركة رابحة

90
00:06:46,210 --> 00:06:47,970
،إن كنتم لا تعرفون متى تتراجعون

91
00:06:47,970 --> 00:06:50,460
.فلن تكونوا قادرين أبدًا على إعادة بناء قوّاتكم

92
00:06:50,460 --> 00:06:55,220
معركة بلا مجد حيث تحمي فيها
...رفاقك بدل مهاجمة العدو

93
00:06:55,680 --> 00:07:00,430
.وحده سيّدُ حربٍ يُمكن أن يُعهد له بأمر كهذا

94
00:07:00,430 --> 00:07:04,720
.كنّا لنخسر الحرب منذ زمن بعيد من دون زورا

95
00:07:04,720 --> 00:07:08,870
إذًا فأنت تقول أنّ كاتسورا-سان هو الأقوى؟

96
00:07:08,870 --> 00:07:10,810
عدنا لنقاش من الأقوى الآن؟

97
00:07:11,430 --> 00:07:17,650
حسنًا، ما كنتم لتعرفوا إلى
.أن تجرّدوه من جلد الجبان

98
00:07:18,540 --> 00:07:22,050
.لقد فقد والديه بسبب المرض عندما كان صغيرًا

99
00:07:22,050 --> 00:07:23,680
،تمّت مصادرة قصره

100
00:07:23,680 --> 00:07:27,660
.حتّى أنّه وجدّته كانا مشرّدين في مرحلة معيّنة

101
00:07:28,380 --> 00:07:32,810
كوتارو، ماذا في رأيك هي أهمّ ميزة

102
00:07:32,810 --> 00:07:36,420
يحتاجها الجنرال ليقود جيشًا؟

103
00:07:37,150 --> 00:07:40,330
سواء أكان محاربًا قادرًا على هزيمة آلاف الأعداء

104
00:07:40,330 --> 00:07:43,420
،أو مخطِّطًا حكيمًا يعرف كيف يستعمل جنوده

105
00:07:43,420 --> 00:07:47,180
.إن هُزم الجنرال، فالمعركة خاسرة

106
00:07:47,600 --> 00:07:52,700
لا يمكنك حماية جنودك أو بلادك
.أو أيّ شيء آخر إن متّ

107
00:07:52,700 --> 00:07:57,570
وبالتّالي، على الجنرال أن يكون أعظم
.جبان في ساحة المعركة

108
00:07:58,650 --> 00:08:02,570
.لذلك يا كوتارو، ابكِ على راحتك

109
00:08:03,570 --> 00:08:06,720
.لا بأس بالبكاء. لا بأس بأن تكون ضعيفًا

110
00:08:06,720 --> 00:08:08,450
،ما دام الجنرال على قيد الحياة

111
00:08:08,450 --> 00:08:10,190
،ما دمتَ على قيد الحياة

112
00:08:10,190 --> 00:08:12,380
.لن تموت عشيرة كاتسورا

113
00:08:12,380 --> 00:08:15,210
.لا بأس إن نعتوك بالجبان

114
00:08:15,210 --> 00:08:17,260
.انجُ يا كوتارو

115
00:08:17,260 --> 00:08:21,450
،لا يهمّ ما يقولونه عنك

116
00:08:21,450 --> 00:08:24,260
.فنحن نعلم أنّك جنرال عظيم

117
00:08:24,260 --> 00:08:28,260
،فقد جدّته أيضًا، وأمسى وحيدًا في العالم

118
00:08:28,260 --> 00:08:31,440
.وأصبح قائد عشيرة كاتسورا في سنّ صغيرة

119
00:08:31,440 --> 00:08:35,770
،وبينما يحمل ذلك العبء الثّقيل
.لفّ نفسه في جلد جبان

120
00:08:36,220 --> 00:08:39,620
ذلك هو الفتى الّذي يصفه الجميع بالذّكاء، صحيح؟

121
00:08:39,620 --> 00:08:42,780
،سمعتُ أنّ هنالك حديثًا عن تبنّي شخص ما له

122
00:08:42,780 --> 00:08:46,910
لكنّه يقول أنّ على السّاموراي
.أن يربّي نفسه بنفسه

123
00:08:49,030 --> 00:08:52,410
جدّتي... منصب الجنرال صعب، صحيح؟

124
00:08:53,350 --> 00:08:55,350
حتّى إن ركضت من كلّ الأخطار

125
00:08:55,350 --> 00:08:57,420
،ونجوت بنفسي

126
00:08:57,420 --> 00:08:59,270
.لا يمكن الهروب من الوحدة

127
00:08:59,920 --> 00:09:02,890
.لا يمكن تجاوز اللّيل بكوني جبانًا فحسب

128
00:09:03,420 --> 00:09:08,070
لذلك سأكون ساموراي أقوى وأكثر
.جبنًا من أيّ أحد آخر

129
00:09:08,720 --> 00:09:10,400
وذلك لأتمكّن من حماية

130
00:09:10,400 --> 00:09:14,260
أصدقائي الّذين عليهم أن يجتازوا
،اللّيل معي وليس نفسي فقط

131
00:09:14,260 --> 00:09:16,650
...سأكون قويًّا، وجبانًا

132
00:09:18,640 --> 00:09:22,260
،لحماية سلالته، ولحماية رفاقه

133
00:09:22,260 --> 00:09:24,990
.واصل معركته الجبانة

134
00:09:25,320 --> 00:09:27,660
.حتّى بينما سخر منه النّاس ونعتوه بكوتارو الهارب

135
00:09:28,510 --> 00:09:32,590
...لكن إن ظهر جنرال يمكننه أن يعهد له بكلّ شيء

136
00:09:33,200 --> 00:09:36,500
إن ظهر عدوّ لا يمكنه هزيمته
...إلاّ إن راهن بكلّ شيء

137
00:09:36,910 --> 00:09:40,030
،بمجرّد أن يُنزع جلد الجبان عنه

138
00:09:40,030 --> 00:09:42,720
.حينها قد تعرفون اسمه الحقيقيّ

139
00:10:01,260 --> 00:10:03,780
...زورا... زورا

140
00:10:03,780 --> 00:10:05,310
...يا زورا

141
00:10:05,310 --> 00:10:07,700
هل تريد أن تحاول قتالي ولو لمرّة؟

142
00:10:08,560 --> 00:10:09,870
من هو زورا هذا؟

143
00:10:10,240 --> 00:10:11,790
.أنت بالطّبع

144
00:10:11,790 --> 00:10:13,770
.من المزعج مناداتك بكاتسورا

145
00:10:13,770 --> 00:10:15,250
!ستضيف "كا" فحسب

146
00:10:15,250 --> 00:10:16,780
!انطق أسماء الآخرين بشكل صحيح

147
00:10:16,780 --> 00:10:18,590
.لا يهمّ. لنتقاتل

148
00:10:18,590 --> 00:10:21,640
.سئمت من مقاتلة ذلك الغبيّ

149
00:10:21,640 --> 00:10:23,140
.من الواضح أنّي سأفوز

150
00:10:23,140 --> 00:10:23,890
.أنت

151
00:10:23,890 --> 00:10:26,720
.في سجلّي 57 انتصارًا و56 هزيمة. أنا الفائز

152
00:10:27,150 --> 00:10:30,010
.كما أنّه لا فائدة من دعوته

153
00:10:30,010 --> 00:10:34,230
إنّه يقول "ليس على الجنرال أن يدنّس
."اسمه بمعارك شخصيّة

154
00:10:34,230 --> 00:10:35,910
.هذا صحيح

155
00:10:35,910 --> 00:10:37,480
.أنا سعيد لأنّك لم تتأذّ

156
00:10:37,860 --> 00:10:41,730
.إذًا سأكون ذلك "الجنرال" لكي لا تضطر أنت لذلك

157
00:10:41,730 --> 00:10:42,690
ماذا؟

158
00:10:42,690 --> 00:10:47,490
لا يمكنك القيام بما تريده بسبب
مسألة "الجنرال" تلك، صحيح؟

159
00:10:47,490 --> 00:10:49,890
.سأكون جنرالك

160
00:10:49,890 --> 00:10:53,870
.لذلك عندما تكون معي، ستكون زورا فحسب

161
00:10:54,120 --> 00:10:55,720
—ما-ما الّذي تقو

162
00:10:55,720 --> 00:10:58,110
يمكنك الآن خوض معارك شخصيّة
أو مهما كان ما تريده، صحيح؟

163
00:10:58,110 --> 00:11:00,570
.وعندما تكون هنا، ستكون الجنرال

164
00:11:00,570 --> 00:11:02,950
!لا تجعل أحدًا آخر يقوم بالأمر بكلّ بساطة

165
00:11:02,950 --> 00:11:05,010
.سيكون من السّهل إن تشاركنا العمل

166
00:11:05,260 --> 00:11:06,930
.حسنًا، ستقوم بالأمر من الإثنين إلى الأربعاء

167
00:11:06,930 --> 00:11:08,180
.يمكن لزورا القيام به من الخميس إلى السّبت

168
00:11:08,180 --> 00:11:09,900
.وأنا سأقوم به يوم الأحد إن شعرت بالملل

169
00:11:09,900 --> 00:11:11,180
!لا تحوّل الأمر إلى نظام مناوبات

170
00:11:11,180 --> 00:11:12,510
!أنت بالكاد تقوم بأيّ شيء

171
00:11:12,880 --> 00:11:14,050
ما هو الجنرال إذًا؟

172
00:11:14,050 --> 00:11:15,280
كم سأتقاضى في السّاعة؟

173
00:11:15,280 --> 00:11:16,420
!لا يوجد أيّ أجر

174
00:11:16,420 --> 00:11:17,580
!بل أنت من يدفع للآخرين

175
00:11:17,580 --> 00:11:18,580
.مثل جنرال متجر

176
00:11:18,580 --> 00:11:19,580
ما هو جنرال المتجر؟

177
00:11:19,580 --> 00:11:21,020
!ألا تقصد مدير المتجر؟

178
00:11:21,020 --> 00:11:21,820
...لكن

179
00:11:21,820 --> 00:11:23,780
!أنت غبيّ، أليس كذلك؟ أنت غبيّ

180
00:11:23,780 --> 00:11:24,450
!ماذا قلت؟

181
00:11:24,450 --> 00:11:25,520
.استلّ سيفك

182
00:11:27,250 --> 00:11:29,450
.لا يمكنك أن تكون جنرالاً

183
00:11:29,870 --> 00:11:33,080
.سأوضّح مَن الجدير بأن يكون جنرالاً

184
00:11:36,040 --> 00:11:38,220
!يناسبني ذلك! لنقم بهذا يا زورا

185
00:11:38,220 --> 00:11:40,340
!لستُ زورا! أنا كاتسورا

186
00:11:43,300 --> 00:11:44,380
...فهمت

187
00:11:47,140 --> 00:11:49,050
.هذا صحيح

188
00:11:52,510 --> 00:11:53,810
.يا للخسارة

189
00:11:54,100 --> 00:11:58,310
كان بمقدورك أن تدير أحد الأقسام
.الإثني عشر بمواهبك هذه

190
00:11:59,150 --> 00:12:02,950
.لكنّي استمتعت بهذا يا كاتسورا كوتارو

191
00:12:07,780 --> 00:12:09,280
.أنا لستُ كاتسورا

192
00:12:10,160 --> 00:12:12,780
!أنا زورا

193
00:12:19,790 --> 00:12:21,030
.أنا لستُ كاتسورا

194
00:12:21,030 --> 00:12:22,330
!أنا زورا

195
00:12:34,490 --> 00:12:37,520
.إنّه مختلف تمامًا عن ذي قبل

196
00:12:38,220 --> 00:12:40,890
.إنّه يهاجم كوحش جامح تخلّى عن الدّفاع

197
00:12:41,350 --> 00:12:43,410
هل فقد رشده ونسي من كان؟

198
00:12:43,410 --> 00:12:44,650
...لكن

199
00:12:44,650 --> 00:12:48,570
بالنّسبة للضّربات، فلا يمكنه
!التّغلّب على وحش حقيقيّ

200
00:12:55,220 --> 00:12:57,290
!أيّها الوغد

201
00:13:01,280 --> 00:13:04,920
...لم ينسَ من كان

202
00:13:06,720 --> 00:13:08,920
،لقد وضع ذلك جانبًا فحسب

203
00:13:08,920 --> 00:13:10,300
!بإرادته الخاصّة

204
00:13:11,140 --> 00:13:15,370
!إنّه يضحّي بحياته الخاصّة ليسلبني حياتي

205
00:13:16,720 --> 00:13:18,590
.عزيمة مثيرة للإعجاب

206
00:13:19,220 --> 00:13:23,280
!لا يمكنك سلبي حياتي، لكنّك سلبتني قبلي

207
00:13:24,730 --> 00:13:26,860
!بدأت الحرب الحقيقيّة الآن

208
00:13:26,860 --> 00:13:28,140
!أنا أتوسّل إليك أيّها السّاموراي

209
00:13:28,140 --> 00:13:29,860
!لا تمت الآن

210
00:13:38,660 --> 00:13:43,630
.نحن نقاتل كقردين أخيرًا

211
00:13:44,290 --> 00:13:50,090
.الأسلحة الوحيدة الّتي بقيت لدينا هي أجسادنا

212
00:13:50,090 --> 00:13:52,800
.البساطة هي الأفضل بالنّسبة لنا نحن الرّجال

213
00:13:52,800 --> 00:13:54,570
جسدك فحسب؟

214
00:13:54,570 --> 00:13:58,140
.عمّاذا تتحدّث؟ بالكاد يمكنك تحريك أطرافك

215
00:13:58,140 --> 00:14:02,410
.لسوء حظّك، ما زال في جعبتي ما أستعمله

216
00:14:02,410 --> 00:14:03,520
.يا للمصادفة

217
00:14:03,520 --> 00:14:04,950
.وكذلك أنا

218
00:14:09,620 --> 00:14:11,130
.قُضي الأمر إذًا

219
00:14:11,130 --> 00:14:14,650
.أنا، كاتسورا كوتارو، الأنسب لأكون الجنرال

220
00:14:14,650 --> 00:14:17,490
.قف وافتح عينيك إن كنتَ ستتكلّم في نومك

221
00:14:17,810 --> 00:14:20,980
."يمكنك الحصول على لقب "صاحب الرّأس الأقسى

222
00:14:20,980 --> 00:14:25,290
أليس من المهمّ للجنرال الاعتراف
عندما يُهزم يا ذا الرّأس القاسي؟

223
00:14:26,210 --> 00:14:31,300
إن أردتما رأيي، لا يملك أيّ أحد منكما
.المظهر المرموق لجنرال

224
00:14:32,660 --> 00:14:33,800
.ربّما

225
00:14:34,250 --> 00:14:36,470
.لكن لا بأس بذلك

226
00:14:36,470 --> 00:14:41,510
حتّى إن أصبحنا كلّنا جنرالات يومًا ما
،ونقود جنودنا الخاصّين

227
00:14:41,910 --> 00:14:44,060
.فسنظلّ هكذا

228
00:14:44,510 --> 00:14:47,400
عندما نعود إلى هنا، سأنسى كلّ شيء

229
00:14:47,400 --> 00:14:49,310
.وأضحك معكما

230
00:14:49,310 --> 00:14:51,570
.سأبكي معكما

231
00:14:51,940 --> 00:14:54,170
...بصفتي زورا البسيط

232
00:14:55,550 --> 00:14:56,950
...معًا

233
00:14:59,940 --> 00:15:01,150
!لنقاتل

234
00:15:05,590 --> 00:15:07,060
.آسف

235
00:15:09,940 --> 00:15:12,020
،يمكنني التّخلّي عن لقب الجنرال

236
00:15:12,020 --> 00:15:15,670
.لكنّي لن أتخلّى عن لقب "صاحب الرأس الأقسى" لأيّ أحد

237
00:15:15,670 --> 00:15:17,010
!أيّها القائد

238
00:15:17,010 --> 00:15:18,760
!توقّفوا

239
00:15:20,410 --> 00:15:22,500
،لا يهمّ كم بقي من جنود

240
00:15:22,500 --> 00:15:25,730
.إن هُزم الجنرال، فالحرب قد انتهت

241
00:15:26,220 --> 00:15:29,730
.كما أنّ الحرب لا تُخاض بعقولنا

242
00:15:30,550 --> 00:15:32,610
.بل تُخاض بجباهنا

243
00:15:33,300 --> 00:15:35,070
.لقد خسرنا

244
00:15:35,440 --> 00:15:37,610
...شوكاكو... أنت

245
00:15:38,630 --> 00:15:42,010
.لم أحبّ أبدًا العمل ضمن مجموعة

246
00:15:42,010 --> 00:15:43,670
...القوانين والقواعد

247
00:15:43,670 --> 00:15:45,620
.لا أدري كم مرّة خرقتُها

248
00:15:46,000 --> 00:15:49,620
لكنّ الهاروسامي لا تملك القوانين
الّتي تحتاجها لدعم منظّمة

249
00:15:49,620 --> 00:15:52,380
.ولا الحرّيّة الّتي يحبّها القراصنة

250
00:15:52,770 --> 00:15:56,690
.لقد تحوّلت لمجرّد لعبة لرجل واحد

251
00:15:56,690 --> 00:16:01,510
.لذلك سأقاتل المعارك الّتي أريد قتالها

252
00:16:02,350 --> 00:16:05,010
ما الّذي ينوي ذلك الرّجل أن يفعه؟

253
00:16:05,480 --> 00:16:10,020
يريد الاستيلاء على الهاروسامي والقضاء
،على تاكاسوغي وبقيّتنا نحن الثّوّار

254
00:16:10,020 --> 00:16:12,270
وماذا بعد ذلك؟

255
00:16:12,610 --> 00:16:13,500
.لا أدري

256
00:16:13,500 --> 00:16:15,540
،كلّ ما أعرفه هو أنّه مهما كان

257
00:16:15,540 --> 00:16:18,700
.فلا نحن ولا أنتم قادرون على إيقافه

258
00:16:18,700 --> 00:16:23,320
على اللّعبة أن ترقص فحسب
.حتّى تسقط كلّ أطرافها

259
00:16:23,630 --> 00:16:26,860
.نحن هنا بملء إرادتنا

260
00:16:26,860 --> 00:16:29,790
.لا نيّة لي للرّقص بين يديّ أيّ كان

261
00:16:30,430 --> 00:16:31,710
.آمل ألا تفعل

262
00:16:32,530 --> 00:16:38,240
أظنّ أنّ الوقت قد حان لإرشاد
.أصدقائك إلى حفلة الرّقص

263
00:16:40,090 --> 00:16:42,060
.أصابت كلّ الطّلقات سفن العدوّ

264
00:16:42,060 --> 00:16:44,070
!كان الهجوم المفاجئ ناجحًا

265
00:16:44,070 --> 00:16:46,260
!حسنًا، واصلوا الهجوم

266
00:16:46,260 --> 00:16:47,810
!انتباه لكلّ سفن الكاينتاي

267
00:16:48,280 --> 00:16:50,020
!اهربوا من هناك

268
00:16:50,810 --> 00:16:54,910
أنا مندهش لقدرتك على إصدار أمر
.متشائم كهذا بكلّ هذا التّفاؤل

269
00:16:54,910 --> 00:16:57,820
.لا يمكننا هزيمة كلّ هذه الأعداد في قتال مباشر

270
00:16:58,430 --> 00:17:00,410
لذلك نحن بحاجة لوخزهم من الخلف

271
00:17:00,410 --> 00:17:02,700
.وإبعادهم عن القتال بقدر الإمكان

272
00:17:03,200 --> 00:17:07,830
لا يهمّ إن كانت وجهة نظرنا
.للخلف أو حتّى للجانبين

273
00:17:07,830 --> 00:17:11,070
الطّريق الّذي أسير فيه أنا ساكاموتو
.تاتسوما متّجه للأمام دائمًا

274
00:17:11,740 --> 00:17:12,830
...يا إلهي

275
00:17:13,380 --> 00:17:16,840
يبدو أنّ محتال الفضاء يُبلي حسنًا
.في ساحة المعركة

276
00:17:19,440 --> 00:17:20,580
!أيّها القبطان

277
00:17:20,580 --> 00:17:21,860
ما الّذي يحدث؟

278
00:17:21,860 --> 00:17:23,890
هل استدار العدوّ بهذه السّرعة؟

279
00:17:24,300 --> 00:17:25,950
!إنّه ليس العدوّ

280
00:17:25,950 --> 00:17:26,890
!إنّهم حلفاؤنا

281
00:17:29,390 --> 00:17:30,320
ماذا؟

282
00:17:30,320 --> 00:17:32,300
نُهاجَم من حلفائنا؟

283
00:17:32,300 --> 00:17:33,570
!هذا مستحيل

284
00:17:33,570 --> 00:17:35,080
هل هنالك خائن بيننا؟

285
00:17:35,080 --> 00:17:37,750
!على كلّ حال، أسرعوا أنتم أيضًا

286
00:17:38,220 --> 00:17:39,320
!من أنت؟

287
00:17:47,090 --> 00:17:48,960
.هذا ليس تشبيهًا

288
00:17:48,960 --> 00:17:52,830
الحلفاء والأعداء وساحة المعركة
...بحدّ ذاتها بالنّسبة له

289
00:17:52,830 --> 00:17:57,040
.كلّ ذلك ألعاب ليلعب بها

290
00:17:58,070 --> 00:18:00,170
.والآن، ارقصوا

291
00:18:03,370 --> 00:18:04,670
!أيّها القبطان، اهرب

292
00:18:04,670 --> 00:18:06,400
...سفينتنا لن

293
00:18:07,430 --> 00:18:09,360
!انقطعت الاتّصالات

294
00:18:09,360 --> 00:18:10,510
!أطلقوا قنابل ستائر الدّخان

295
00:18:10,510 --> 00:18:12,810
!ابتعدوا عن السّفن الأخرى بسرعة قدر الإمكان

296
00:18:12,810 --> 00:18:16,310
،اسمعوا، لا يهمّ كم مرّة سيهاجمون
!لا تردّوا الهجوم

297
00:18:16,310 --> 00:18:18,660
...علينا الانطلاق بأسرع ما

298
00:18:20,100 --> 00:18:22,720
آسف، هل يمكننا أن نبطئ قليلاً؟

299
00:18:22,720 --> 00:18:27,570
لا يبدو أنّهم قد سئموا
.من قبطانهم الغبيّ وبدؤوا ثورة

300
00:18:28,140 --> 00:18:30,580
ما الّذي يحدث على سفنهم؟

301
00:18:30,940 --> 00:18:34,990
.لا تُظهر الاتّصالات أيّ إشارة لاستيلاء العدوّ

302
00:18:34,990 --> 00:18:37,830
.وإن خانونا، ما كانوا ليخبرونا بأن نهرب أيضًا

303
00:18:38,160 --> 00:18:39,620
ماذا إذًا؟

304
00:18:39,620 --> 00:18:42,460
،ليس العدوّ أو حلفاءنا من يهاجموننا

305
00:18:42,460 --> 00:18:45,280
فهل تقوم السّفينة بذلك من تلقاء نفسها؟

306
00:18:45,280 --> 00:18:46,970
.هذا صحيح

307
00:18:47,470 --> 00:18:48,680
.إنه اختراق إلكترونيّ

308
00:18:48,680 --> 00:18:51,370
،فعن طريق الاستيلاء على أنظمة التّحكّم بالسّفينة

309
00:18:51,370 --> 00:18:53,640
استطاعوا أن يسيطروا على الكاينتاي وسفننا

310
00:18:53,640 --> 00:18:55,100
.دون استعمال جنديّ واحد

311
00:18:55,590 --> 00:19:00,890
يملك العدوّ مخترقًا ذو مستوى متوحّش
.من نوع ما إن كانوا قادرين على هذا

312
00:19:00,890 --> 00:19:02,730
.هذا صحيح

313
00:19:03,470 --> 00:19:07,240
.أسطولكم بين يديّ

314
00:19:07,810 --> 00:19:09,020
من أنت؟

315
00:19:09,700 --> 00:19:13,240
معذرة، هل تظنّ أنّك اتّصلت بالسّفينة الخطأ؟

316
00:19:13,700 --> 00:19:16,490
.نحن الكاينتاي، ولسنا القاعدة البيضاء

317
00:19:16,490 --> 00:19:18,250
.كلاّ، هذا ليس زاكو أيّها القبطان

318
00:19:18,820 --> 00:19:20,390
هل لديك مذكّرة؟

319
00:19:20,390 --> 00:19:22,590
.يمكنني أن أخبرك كيف تتّصل بالقوّات الفدراليّة

320
00:19:22,590 --> 00:19:25,590
.يخفق جيش زيون ويتّصل بنا طوال الوقت

321
00:19:25,590 --> 00:19:27,380
.أيّها القبطان، هذا ليس جيش زيون

322
00:19:27,380 --> 00:19:32,180
إذًا فهذه هي خدعة زاكو-زاكو
!الّتي سمعتُ عنها؟ لن تخدعني

323
00:19:32,180 --> 00:19:33,290
،كلاّ، لا يوجد شيء كهذا

324
00:19:33,290 --> 00:19:34,890
!كما أنّك اعتقدتَ أنّه زاكو في كلّ الأحوال

325
00:19:35,300 --> 00:19:37,820
،أنا معلّم الخداع هانكاي

326
00:19:37,820 --> 00:19:40,180
قائد القسم الثّالث للهاروسامي

327
00:19:40,180 --> 00:19:41,610
.وواحد من النّجوم الثّلاثة المجنونة

328
00:19:41,610 --> 00:19:43,660
.إنّه يعرف كيف يتفاخر بلقبه

329
00:19:43,660 --> 00:19:47,340
إذًا فكلّ هذا من صنعك يا زاكو؟

330
00:19:47,340 --> 00:19:50,110
كيف لك أن تسمعي كلّ هذا وتقرّرين
!أنّه زاكو رغم ذلك يا نائب القبطان؟

331
00:19:50,110 --> 00:19:51,380
.تمامًا

332
00:19:51,380 --> 00:19:56,970
إنّ من استولى على أسطولكم ولم يلمس
،سفينتكم الرّئيسيّة عن قصد

333
00:19:56,970 --> 00:19:59,460
.كان أنا الغاندام

334
00:19:59,460 --> 00:20:00,560
!لقد غيّره إلى غاندام

335
00:20:00,560 --> 00:20:02,790
هل فكّر في أنّه يفضّل أن يكون
!غاندام مِن أن يُنادى بزاكو؟

336
00:20:03,130 --> 00:20:06,400
،يمكنكم إمّا إطلاق النّار على سفن حلفائكم والنّجاة

337
00:20:06,400 --> 00:20:08,830
.أو أن تُهاجموا  هنا بكلّ بساطة

338
00:20:08,830 --> 00:20:12,550
.فكّرت في أن أترك لكم الخيار

339
00:20:12,550 --> 00:20:15,060
!أيّها الوغد! حسنًا، سنناديك زاكو

340
00:20:15,060 --> 00:20:16,450
!هل ذلك ما تختارينه؟

341
00:20:16,450 --> 00:20:20,540
.هزيمتكم مضمونة مهما كان خياركم

342
00:20:20,540 --> 00:20:23,550
،قطعتم شوطًا طويلاً لإنقاذ رفاقكم

343
00:20:23,550 --> 00:20:25,940
.وستتخلّون عن كلّ شيء من أجلهم

344
00:20:26,440 --> 00:20:30,330
.ستسجّل عين مونو خاصّتي تلك اللّحظة

345
00:20:30,330 --> 00:20:33,650
لقد استسلم! لقد قرّر أن يعيش
!بقيّة حياته كزاكو

346
00:20:34,580 --> 00:20:37,990
.ليس لديكم وقت طويل قبل أن تقرّروا

347
00:20:42,180 --> 00:20:43,460
!يا رفاق

348
00:20:43,460 --> 00:20:48,170
هل ظننتم أنّ معلّم الخداع يمكنه
التّحكّم في الآلات فقط؟

349
00:20:50,930 --> 00:20:52,850
ما الّذي تفعلونه؟

350
00:20:52,850 --> 00:20:53,930
!تمالكوا أنفسكم

351
00:20:53,930 --> 00:20:55,390
ما الّذي يحدث؟

352
00:20:55,390 --> 00:20:57,720
!لقد فقدوا عقولهم جميعًا

353
00:20:57,720 --> 00:21:02,730
.قيل أنّ القسم الثّالث هو الوحيد بدون جنود

354
00:21:03,490 --> 00:21:05,290
.لكنّ ذلك ليس صحيحًا

355
00:21:05,290 --> 00:21:07,100
.لا يمكنكم رؤيتهم فحسب

356
00:21:07,100 --> 00:21:10,150
،جنودي صغار للغاية لدرجة لا يمكن رؤيتهم

357
00:21:10,150 --> 00:21:13,610
.لكنّ أعدادهم وقوّتهم تتخطّى الأقسام الأخرى

358
00:21:14,070 --> 00:21:17,620
،يستطيع البعض التّسلّل لنظام العدوّ المركزيّ

359
00:21:17,620 --> 00:21:20,060
ويستطيع آخرون التّسلّل لأدمغة البشر

360
00:21:20,060 --> 00:21:22,120
.وإصابتهم

361
00:21:22,120 --> 00:21:27,280
نعم، يوجد داخل جسدي العديد
...من الفيروسات الآليّة الجزيئيّة

362
00:21:27,280 --> 00:21:29,790
!وأنتم ألعاب يسيطرون عليها

363
00:21:29,790 --> 00:21:34,140
!أنتم قسمي الثّالث

364
00:21:34,140 --> 00:21:35,390
!أيّها القبطان

365
00:21:35,890 --> 00:21:36,930
.آسف

366
00:21:37,350 --> 00:21:39,890
!تقبّلوا الوضع يا رفاق

367
00:21:40,300 --> 00:21:41,810
!اهتمّوا بالسّفينة

368
00:21:41,810 --> 00:21:43,640
!أقفلوا المدخل

369
00:21:43,640 --> 00:21:45,360
...لـ-لكن

370
00:21:46,400 --> 00:21:48,470
!أيّها القبطان

371
00:21:54,020 --> 00:21:56,070
لماذا تبعتِني؟

372
00:21:56,070 --> 00:21:58,580
.هنالك أكثر من خيارين

373
00:21:58,580 --> 00:22:00,820
،يمكننا العثور على زاكو وإيساعه ضربًا

374
00:22:00,820 --> 00:22:03,040
.وإصلاح كلّ شيء

375
00:22:03,430 --> 00:22:08,470
كما سأضطرّ لقتلك في الحال
.إذا ما أُصبتَ بصفتي نائب القبطان

376
00:22:08,470 --> 00:22:09,500
...يا إلهي

377
00:22:09,900 --> 00:22:13,540
وهل عليّ أن أقتلك إذا ما أُصبتِ أنت؟

378
00:22:13,540 --> 00:22:15,550
.سينتهي بي المطاف مقتولاً أيضًا

379
00:22:15,550 --> 00:22:17,840
.لا تقلق حيال تعرّضي للإصابة

380
00:22:17,840 --> 00:22:19,560
...لقد أُصبتُ منذ زمن بعيد

381
00:22:20,490 --> 00:22:22,640
!بغبائك

382
00:22:23,310 --> 00:22:25,830
يُـتـبـع

383
00:24:00,820 --> 00:24:05,870
المعركة التّالية بين تاجر الفضاء ساكاموتو تاتسوما

384
00:24:00,820 --> 00:24:05,870
!والبذلة المتنقلة... أعني، معلّم الخداع، هانكاي

385
00:24:05,870 --> 00:24:12,000
قلب نوبونوبو، الشّوغن الحاليّ، متردّد

386
00:24:05,870 --> 00:24:12,000
...وماضي ساكاموتو المجهول سيُكشف