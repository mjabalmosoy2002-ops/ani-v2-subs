1
00:00:16,650 --> 00:00:17,660
كوكا؟

2
00:00:19,480 --> 00:00:20,620
.فهمت

3
00:00:21,290 --> 00:00:24,500
.أظنّني أخفقت بشكل مروّع

4
00:00:25,540 --> 00:00:29,010
...لكن يمكنني أن أنضمّ لكِ الآن

5
00:00:31,490 --> 00:00:34,500
لن تدعيني أفعل ذلك، صحيح؟

6
00:00:35,750 --> 00:00:37,160
لقد أصبحتُ الآن

7
00:00:38,550 --> 00:00:43,410
.أبًا لا يستطيع لا ضرب ولا معانقة أبنائه المشاكسين

8
00:00:43,970 --> 00:00:45,980
ما الّذي يمكنني فعله الآن؟

9
00:00:47,790 --> 00:00:48,890
...هيّا يا كوكا

10
00:00:50,310 --> 00:00:51,450
.أخبريني

11
00:01:02,770 --> 00:01:04,960
.لطالما كنتُ ذلك النّوع من الرّجال

12
00:01:05,800 --> 00:01:08,640
،مهما ظننتُ أنّك لن تستطيع النّجاة من شيءٍ ما

13
00:01:08,640 --> 00:01:11,060
تعود للحياة وكأنّ شيئًا لم يكن

14
00:01:11,060 --> 00:01:14,360
.وتقصّ عليّ قصص مغامرات تهيّج قلبي

15
00:01:15,460 --> 00:01:18,350
.أتحرّق شوقًا لأسمع قصّتك هذه المرّة

16
00:01:22,560 --> 00:01:25,900
حتّى وإن كان تذمّرًا سيحرق قلبك؟

17
00:03:16,770 --> 00:03:19,710
.يا لهما من شقيقين مثيرين للمتاعب

18
00:03:20,070 --> 00:03:23,460
ما الّذي يجعلهما يظنّان أنّهما بحاجة
ليغمى عليهما أكثر منّا؟

19
00:03:24,010 --> 00:03:25,380
.معك حقّ

20
00:03:25,380 --> 00:03:27,480
إن كانت هناك امرأة مثيرة ستسمح
،لي بالاستلقاء على حضنها

21
00:03:27,480 --> 00:03:30,050
.فأودّ أن أقفز إلى هناك في الحال

22
00:03:30,760 --> 00:03:33,810
.لكن للأسف، يبدو أنّ على ذلك أن ينتظر

23
00:03:35,560 --> 00:03:38,940
.كلّ ما أراه حولي هو منفرج الرّجال المقزّز

24
00:03:38,940 --> 00:03:40,640
.سيسبّب هذا كوابيس لي على الأرجح

25
00:03:40,640 --> 00:03:43,940
.أشعر أنّنا نرى كابوسًا بالفعل

26
00:03:44,400 --> 00:03:48,450
.علينا إذًا أن نأمل حدوث نشاط مثير يوقظنا

27
00:03:49,350 --> 00:03:50,030
.مهلاً

28
00:03:51,200 --> 00:03:53,880
.لا تستبقوا الأمور

29
00:03:53,880 --> 00:03:57,200
.نحن لسنا أوغادًا نقاتل رجالاً مصابين

30
00:03:57,200 --> 00:03:59,560
!شوكاكو أحد النّجوم المجنونة الثّلاثة

31
00:03:59,560 --> 00:04:02,540
.كان كذلك قبل بعض الوقت

32
00:04:02,900 --> 00:04:04,680
بعد أن خسرنا الآن أمام السّاموراي

33
00:04:04,680 --> 00:04:07,040
،وتخلّى عنّا سيّدنا

34
00:04:07,040 --> 00:04:09,340
.أصبحنا مثلكم الآن

35
00:04:09,880 --> 00:04:11,430
تخلّى عنكم؟

36
00:04:11,430 --> 00:04:13,350
.تقصد أنّكم تخلّيتم عنه

37
00:04:13,350 --> 00:04:15,350
.هناك شيء واحد مؤكّد

38
00:04:15,820 --> 00:04:18,600
،لم يملك ذلك الرّجل أيّ فخر بصفته قرصانًا

39
00:04:19,070 --> 00:04:23,060
.ولم يكن لديّ ولاء أمنحه له

40
00:04:23,980 --> 00:04:26,730
.يفترض بالقراصنة أن يكونوا أرواحًا حرّة

41
00:04:27,420 --> 00:04:29,530
...هذا ما شعرت به بمراقبتكم

42
00:04:31,350 --> 00:04:34,030
.بدا أنّكم تستمتعون أكثر بكثير

43
00:04:34,790 --> 00:04:36,400
.دعونا نسألك الآن

44
00:04:36,400 --> 00:04:37,410
،أما زال القسم السّابع

45
00:04:37,960 --> 00:04:40,900
صاعقة هاروسومي، ثابتًا؟

46
00:04:41,710 --> 00:04:42,620
من يدري؟

47
00:04:43,080 --> 00:04:44,670
.أنا لا أدري

48
00:04:45,210 --> 00:04:48,140
لا أعرف حتّى ما إن كان ذلك الرّجل
.المستلقي هناك قائدنا

49
00:04:48,140 --> 00:04:51,170
.أم مجرّد أخ أكبر آخر

50
00:04:51,960 --> 00:04:54,930
...الشّيء الوحيد الّذي يمكنني قوله بالتّأكيد

51
00:04:55,980 --> 00:04:57,720
.هذا ليس من عادتك

52
00:04:58,270 --> 00:05:01,400
،سواء كنتَ على ساحة المعركة أو على حضن أختك

53
00:05:01,400 --> 00:05:03,190
.ليس من عادتك أن تبقى مستلقيًا

54
00:05:03,940 --> 00:05:08,190
ليس من عادتك أن تبقى مستلقيًا
.بعد أن تتلقّى الهزيمة

55
00:05:12,640 --> 00:05:15,320
.لن أُهزم مجدّدًا

56
00:05:16,140 --> 00:05:17,170
.أمام أيّ أحد

57
00:05:21,230 --> 00:05:22,200
...أنا

58
00:05:23,060 --> 00:05:26,380
،مهما كان الوقت الّذي أمضيته كابن وكأخ

59
00:05:26,820 --> 00:05:29,040
.فقد أمضيت وقتًا أطول كقرصان

60
00:05:30,360 --> 00:05:33,710
.لم أنوِ التّراجع على أيّة حال

61
00:05:34,260 --> 00:05:35,970
.يمكنني فقط أن أتقدّم

62
00:05:36,610 --> 00:05:40,270
.إلى مكان بعيد جدًّا لا يمكن لأختي اللّحاق بي فيه

63
00:05:40,950 --> 00:05:44,530
إلى مكانٍ عالٍ جدًّا يمكنني أن أنظر
.منه إلى أبي في الأسفل

64
00:05:45,650 --> 00:05:49,170
.وإلى مكان بعيد جدًّا يمكنني الوصول فيه إليها

65
00:05:50,880 --> 00:05:54,480
،إن لم أكن عازمًا على الوصول إلى ذلك الحدّ

66
00:05:54,480 --> 00:05:55,930
فلن أتمكّن من اللّحاق بها

67
00:05:57,720 --> 00:05:58,790
.أو العودة إلى هناك

68
00:06:04,620 --> 00:06:08,540
.أتيت إلى هنا لأوقف ذلك الوحش

69
00:06:08,900 --> 00:06:10,440
،كنت عازمًا حتّى على قتله

70
00:06:10,440 --> 00:06:13,170
.لأنّني ظننت أنّ ذلك واجبي كوالده

71
00:06:14,380 --> 00:06:16,980
.لكنّي لم أستطع ذلك

72
00:06:18,440 --> 00:06:20,090
.وربمّا انطبق عليه نفس الأمر

73
00:06:22,030 --> 00:06:25,460
.مهما ابتعدنا عن بعضنا، فقد كنّا عائلة

74
00:06:26,550 --> 00:06:32,440
.العزيمة الّتي احتجناها لم تكن لقطع علاقتنا كعائلة

75
00:06:33,070 --> 00:06:36,320
.تلك الرّوابط لم تكن لتنقطع مهما حدث

76
00:06:36,320 --> 00:06:40,290
،لذا حتّى وإن اشتبكنا بها وعانينا في بعض الأوقات

77
00:06:40,290 --> 00:06:44,830
.كنّا بحاجة للتّمسّك بتلك الرّوابط وتقريبها من بعضها

78
00:06:46,310 --> 00:06:51,090
جعلتني الفتاة الّتي لا تتخلّى عن تلك
.الرّوابط أبدًا أدرك ذلك

79
00:06:53,340 --> 00:06:58,340
.هي والرّوابط الغريبة الّتي دائمًا تأتي معها

80
00:07:01,850 --> 00:07:03,050
.مرحبًا

81
00:07:03,050 --> 00:07:04,600
هل تستمتعين بعطلتك؟

82
00:07:05,770 --> 00:07:07,850
.آسفة على تصرّفي الأنانيّ

83
00:07:08,280 --> 00:07:10,490
.لم أرد أن أورّطكما في هذا

84
00:07:11,000 --> 00:07:11,860
...لكن

85
00:07:15,030 --> 00:07:16,920
كنت دائمًا أتساءل أين على طفلٍ

86
00:07:16,920 --> 00:07:20,890
.أن يولد لينمو ويصبح شقيًّا فظًّا مثلك

87
00:07:21,340 --> 00:07:22,740
.وجدت جوابي الآن

88
00:07:23,710 --> 00:07:25,620
.يا لها من بلدة قذرة

89
00:07:26,060 --> 00:07:29,260
.لكّنها مثل بدلتنا تمامًا

90
00:07:30,400 --> 00:07:33,510
.تمكّنا من رؤية العائلة والبلدة اللّتان ترعرعت فيهما

91
00:07:34,090 --> 00:07:35,960
.ليست عطلة سيّئة

92
00:07:36,610 --> 00:07:40,640
.لذا أبعدي ذلك الشّيء

93
00:07:40,990 --> 00:07:44,350
لا يمكنك التّخلّي عن أوميبوزو-سان
والرّحيل، صحيح؟

94
00:07:44,930 --> 00:07:48,020
.ورغم ذلك، لا يمكننا قبول طلب استقالتك

95
00:07:48,950 --> 00:07:50,820
.طلب عطلة جيّد بما يكفي

96
00:07:52,200 --> 00:07:54,690
لذا عودي يومًا ما

97
00:07:55,160 --> 00:07:57,280
.إلى منزلك الآخر

98
00:07:58,870 --> 00:07:59,530
...لا

99
00:08:00,330 --> 00:08:02,440
.الأمر ليس كذلك

100
00:08:02,440 --> 00:08:05,490
هل يمكننا أن نجعل هذه العطلة عطلة
مدفوعة الأجر بدل عطلة عاديّة؟

101
00:08:08,910 --> 00:08:11,290
!ما الّذي تفعلانه لفتاة مصابة أيّها الوغدان

102
00:08:11,290 --> 00:08:14,500
في الأعمال الحرّة، طلب عطلة مدفوعة
.الأجر يشبه طلبًا للموت

103
00:08:14,500 --> 00:08:16,100
.وأنا قبلت طلبك

104
00:08:16,100 --> 00:08:18,180
!حقيبتي فارغة بفضل أجرتك التّافهة

105
00:08:18,180 --> 00:08:20,540
!يمكنك على الأقل أن تعرض مشاركة بعد أعبائي

106
00:08:20,540 --> 00:08:21,980
فيمَ أنفقتِ كلّ مالك؟

107
00:08:21,980 --> 00:08:25,420
في حجوزات الفنادق وشراء اللّوحات الفنيّة
.والفساتين الصّينية وفنون التّخطيط

108
00:08:25,420 --> 00:08:26,770
.كانت كلّها تكاليف ضروريّة

109
00:08:26,770 --> 00:08:28,130
!هل أنت حاكم سابق لطوكيو أم ماذا؟

110
00:08:28,130 --> 00:08:29,940
!سأحتاج لدفع تكاليف علاج ذلك الأصلع الآن

111
00:08:29,940 --> 00:08:31,890
!لذا ارحموني أيّها الغرباء

112
00:08:31,890 --> 00:08:33,530
أيّ علاج يحتاجه الأصلع بالضّبط؟

113
00:08:33,530 --> 00:08:36,770
ماذا إن فقد ذراعًا أو اثنتان؟
.سيكون ذلك الوحش بخير

114
00:08:36,770 --> 00:08:38,740
ادهني بعضًا من زيت الصّبار
.وستنمو من جديد

115
00:08:38,740 --> 00:08:39,580
!إنّها ليست شعرًا

116
00:08:39,580 --> 00:08:40,580
.لا أظنّ شعره سينمو مجدّدًا

117
00:08:40,580 --> 00:08:42,540
!ولِمَ أمر شعره مفروغ منه أكثر من ذراعيه؟

118
00:08:44,290 --> 00:08:45,240
!هذا صحيح

119
00:08:46,530 --> 00:08:47,700
!لقد نمت ذراعي من جديد

120
00:08:47,700 --> 00:08:51,330
أجل، فكّرت أنّ أطرافًا اصطناعيّة
.قتاليّة ستناسبك أكثر

121
00:08:51,330 --> 00:08:52,710
!معبد أسورا

122
00:08:52,710 --> 00:08:54,920
.أريد قوّة ناريةّ أكبر

123
00:08:54,920 --> 00:08:57,360
.وضعيها في حسابهما

124
00:08:57,360 --> 00:08:57,910
.أكيد

125
00:08:57,910 --> 00:08:58,560
!تبّا لك

126
00:08:58,560 --> 00:09:00,360
!إّنه في حالة جيّدة تمامًا

127
00:09:00,360 --> 00:09:04,220
!فليدفع أحد تكاليف علاجنا أيضًا

128
00:09:05,900 --> 00:09:08,560
!سأضع تكاليف إصلاح السّفينة في حسابكما أيضًا

129
00:09:09,020 --> 00:09:11,970
.حسنًا إذًا. انتهى كلام التّجارة الآن

130
00:09:11,970 --> 00:09:15,190
ما رأيك أن ننهي هذه الأمر أيضًا؟

131
00:09:17,230 --> 00:09:18,690
.يا أعضاء الكيهيتاي

132
00:09:19,120 --> 00:09:21,760
.لقد هربتهم في منتصف الطّريق دون قول أيّ شيء

133
00:09:22,270 --> 00:09:23,640
ما الّذي حدث؟

134
00:09:23,640 --> 00:09:24,950
أين تاكاسوغي؟

135
00:09:26,030 --> 00:09:28,700
.لديّ رسالة من شينسكي-دونو

136
00:09:38,170 --> 00:09:39,250
!هذا مزعج جدًّا

137
00:09:39,250 --> 00:09:41,460
إلى متى سيلاحقوننا؟

138
00:09:41,460 --> 00:09:44,480
.يبدو أنّنا افترقنا عن كاتسورا والكاينتاي

139
00:09:44,480 --> 00:09:45,470
...على هذا المعدّل

140
00:09:45,470 --> 00:09:49,060
.لا أذكر أنّي تحالفت معهم من الأساس

141
00:09:49,680 --> 00:09:51,850
.لا أريد أن أدين لهم أكثر من هذا

142
00:09:51,850 --> 00:09:55,100
.سأردّ لهم الدّين يومًا ما وبالفائدة أيضًا

143
00:09:55,930 --> 00:09:57,230
...بالطّبع

144
00:09:57,750 --> 00:09:58,860
سأردّه لك أنت أيضًا

145
00:09:59,750 --> 00:10:00,860
.يا أوبورو

146
00:10:00,860 --> 00:10:01,580
...ماذا

147
00:10:02,380 --> 00:10:04,610
.أحسنتم في استدراجهم إلى هنا

148
00:10:05,010 --> 00:10:06,930
.بدأت هاروسامي بالتّراجع

149
00:10:06,930 --> 00:10:08,340
.عليكم أن تغادروا أنتم أيضًا

150
00:10:08,870 --> 00:10:10,740
.اذهبوا بسرعة

151
00:10:12,450 --> 00:10:15,870
ما معنى هذا؟

152
00:10:16,420 --> 00:10:20,010
،نجاتكم لم تكن متوقّعة

153
00:10:20,010 --> 00:10:22,920
.لكنّ الهدف من هذه المعركة موجود في مكان آخر

154
00:10:23,530 --> 00:10:26,430
،مقارنة بتحقيق ذلك الرّجل لرغبته الطّويلة

155
00:10:26,430 --> 00:10:30,930
فإنّ ما يحدث لحياة الحشرات
.الّتي تزحف على الأرض لا تهمّ

156
00:10:30,930 --> 00:10:33,680
لِمَ أنت هنا إذًا؟

157
00:10:34,030 --> 00:10:36,960
لتختلق أعذارًا لخسارتك أمام حشرات؟

158
00:10:36,960 --> 00:10:39,190
.لأنّي أعرف

159
00:10:39,670 --> 00:10:42,010
،أعرف أنّ بعض الحشرات لن تستسلم أبدًا

160
00:10:42,010 --> 00:10:45,320
.وسترفرف بأجنحتها إلى أن تصل إلى السّماء

161
00:10:45,950 --> 00:10:50,330
.أنا أعرف ذلك لأني حصلت على أجنحتي من نفس الرّجل

162
00:10:50,330 --> 00:10:52,140
نفس الرّجل؟

163
00:10:52,600 --> 00:10:56,080
الغراب الوحش الّذي تتّبع أوامره ومعلّمي؟

164
00:10:56,750 --> 00:10:58,660
.يوشيدا شويو قد مات

165
00:10:59,420 --> 00:11:03,590
.وأحد الّذين قتلوه يقف أمامي الآن

166
00:11:03,590 --> 00:11:06,170
.لا أكترث في كلا الحالتين

167
00:11:06,760 --> 00:11:10,470
.كلّ ما أريده هو إماطة جميع العوائق عن طريقه

168
00:11:12,060 --> 00:11:16,850
!سأستعمل ما بقي من لهيب حياتي لأحرق أجنحتك

169
00:11:36,190 --> 00:11:37,500
هل قضينا عليهم جميعًا؟

170
00:11:37,500 --> 00:11:39,000
.نعم

171
00:11:40,790 --> 00:11:42,750
.انتهى كلّ شيء الآن

172
00:11:52,660 --> 00:11:55,990
أهذا ما يدعونه بالموت

173
00:11:57,960 --> 00:11:59,520
يا حاصد الأرواح؟

174
00:12:17,150 --> 00:12:20,790
.هذا كلّ ما يمكنني فعله لأجلك

175
00:12:26,670 --> 00:12:27,670
...ما الّذي

176
00:12:29,760 --> 00:12:30,700
.سامحني

177
00:12:31,170 --> 00:12:35,430
.لا يمكنني الموت كهدف لانتقامك

178
00:12:35,430 --> 00:12:37,090
لذا آمل على الأقلّ

179
00:12:38,460 --> 00:12:41,120
.أن تعيش وتواصل كرهي إلى الأبد

180
00:12:46,820 --> 00:12:49,440
.لقد متّ حينها

181
00:12:50,330 --> 00:12:52,570
.قرّرت أن أكرّس كلّ شيء لأجله

182
00:12:54,120 --> 00:12:59,830
كنتُ حشرة قُدّر لها الموت كعبد
.لا يملك أحدًا يحزن عليه

183
00:13:00,150 --> 00:13:05,840
لذا قرّرت أن أخدمه إلى أن أذرف آخر
.قطرة دم تبقيني على قيد الحياة

184
00:13:06,810 --> 00:13:09,340
.أخبرتك أن تغادر بمجرّد أن تشفى جراحك

185
00:13:09,870 --> 00:13:12,680
.لقد سلبناك منزلك

186
00:13:12,680 --> 00:13:15,420
،وإن بقيت هنا

187
00:13:15,420 --> 00:13:17,850
.فسينتهي بك المطاف قاتلاً

188
00:13:17,850 --> 00:13:19,650
.علّمني رجاءً

189
00:13:19,650 --> 00:13:23,250
.أنا عازم على فعل أيّ شيء لمساعدتك

190
00:13:23,250 --> 00:13:25,360
.أنا لست معلّمًا

191
00:13:25,360 --> 00:13:29,900
.في نظري، أنت معلّم أدين له بحياتي
.معلّم يستحقّ الاحترام

192
00:13:29,900 --> 00:13:32,400
.هذا ليس شيئًا تقوله لقائدِ قتلة

193
00:13:32,880 --> 00:13:36,120
.لا يمكنني أن أعطيَ أحدًا شيئًا

194
00:13:36,480 --> 00:13:40,540
...في الواقع، أتمنّى لو كنت طفلاً أتعلّم مع الأطفال

195
00:13:41,020 --> 00:13:44,870
.كيف أنظّف يديّ الملطّختين بالدّماء

196
00:13:46,040 --> 00:13:49,510
لِمَ لا تدير مدرسة إذًا؟

197
00:13:49,950 --> 00:13:52,980
...مدرسة يمكن للمعلّم والتّلاميذ التّعلم معًا

198
00:13:52,980 --> 00:13:54,630
.يبدو هذا رائعًا

199
00:13:54,630 --> 00:13:57,730
من قد يرتاد مدرسة يديرها قاتل؟

200
00:13:59,300 --> 00:14:03,180
.كلّ ما يمكنني تعليمه هو تقنيات للقتل

201
00:14:03,810 --> 00:14:06,880
.لكنّك ترفض تعليمي إيّاها

202
00:14:06,880 --> 00:14:11,690
.لو كنتَ شرّيرًا حقًّا، لكنتُ قاتلاً الآن

203
00:14:12,170 --> 00:14:15,670
،سأتوقّف عن محاولة تعلّم تقنيّات القتل

204
00:14:15,670 --> 00:14:19,910
لذا اجعلني أوّل تلميذ لك في تلك المدرسة، اتفقنا؟

205
00:14:30,210 --> 00:14:32,050
.لقد هرب الرّئيس

206
00:14:32,050 --> 00:14:35,050
.وكما تعلمون، الرّحيل ليس خيارًا لنا

207
00:14:35,050 --> 00:14:36,800
.يجب التّخلّص منه

208
00:14:39,430 --> 00:14:43,680
ماذا؟ هل قرّرت مغادرة ذلك المكان أخيرًا؟

209
00:14:43,680 --> 00:14:44,930
!معلّمي

210
00:14:44,930 --> 00:14:47,600
!ما الّذي تفعله هنا؟

211
00:14:47,600 --> 00:14:51,440
.لم أكن لأستدرجك إلى الخارج دون فعل هذا

212
00:14:51,880 --> 00:14:54,130
،إن أردت إخراجك من تلك المجموعة

213
00:14:54,130 --> 00:14:56,450
.فأفضل طريقة هي أن أغادرها

214
00:14:57,400 --> 00:14:59,690
...معلّمي، أنت لا تقصد

215
00:14:59,690 --> 00:15:04,190
.لا. كنت أخطّط لهذا قبل أن تأتي

216
00:15:04,190 --> 00:15:08,250
.لكن قد يكون حسمي لقراري بفضلك

217
00:15:08,250 --> 00:15:11,210
.لربّما أحمل آثامًا لن تزول حتّى بعد موتي

218
00:15:11,210 --> 00:15:14,460
.لكن يمكننا أن أواصل التّكفير عنها طالما حييت

219
00:15:15,170 --> 00:15:17,030
سأقاتل أنا أيضًا

220
00:15:17,030 --> 00:15:18,970
.رفقة حاصد الأرواح الّذي يعيش بداخلي

221
00:15:18,970 --> 00:15:21,050
...لـ-لكن

222
00:15:21,050 --> 00:15:23,540
.سيتمّ استهدافك بسببي

223
00:15:24,560 --> 00:15:26,520
.ينطبق الأمر عليك أنت أيضًا

224
00:15:26,520 --> 00:15:30,270
.هذا إن كان أحد ما يعتبرك عضوًا في ناراكو

225
00:15:30,800 --> 00:15:34,480
.لكنّي سأجعلك أحد أتباعي

226
00:15:58,510 --> 00:16:00,090
شوكا سونجوكو؟

227
00:16:00,410 --> 00:16:01,980
ما معنى هذا؟

228
00:16:01,980 --> 00:16:03,800
.اسم المدرسة

229
00:16:03,800 --> 00:16:05,350
وماذا يعني؟

230
00:16:05,350 --> 00:16:07,510
...مدرسة ولدت تحت شجرة الصّنوبر

231
00:16:08,060 --> 00:16:09,350
.للتّوّ

232
00:16:09,710 --> 00:16:12,230
،نحن وحدنا الآن

233
00:16:12,230 --> 00:16:15,730
لكن آمل أن ينضمّ لنا الكثير تحت
،شجرة الصّنوبر هذه يومًا ما

234
00:16:16,220 --> 00:16:19,490
.وأن يكون لديك الكثير من التّلاميذ الأصغر منك

235
00:16:20,050 --> 00:16:21,240
تلاميذ أصغر مني؟

236
00:16:21,570 --> 00:16:22,520
.نعم

237
00:16:22,520 --> 00:16:25,110
،في ناراكو كنت الأضعف

238
00:16:25,110 --> 00:16:27,870
لكن من الآن فصاعدًا، ستكون
.التّلميذ ذا المستوى الأكثر تقدّمًا

239
00:16:27,870 --> 00:16:31,500
.على كلينا أن نبذل جهدنا

240
00:16:31,930 --> 00:16:33,670
.أ-أجل

241
00:16:35,010 --> 00:16:36,600
تلاميذ أصغر مني إذًا؟

242
00:16:37,090 --> 00:16:38,560
.أنا أتحرّق شوقًا لرؤيتهم

243
00:16:44,880 --> 00:16:46,060
.لا يوجد مهرب

244
00:16:46,060 --> 00:16:48,100
،ولا حتّى لمعلّمي

245
00:16:48,610 --> 00:16:50,350
.إن أخذني معه

246
00:16:52,140 --> 00:16:54,710
.هذا فخّ لتعطيل ملاحقيك

247
00:16:54,710 --> 00:16:57,570
.لا يجب عليك استعماله للقتل أبدًا

248
00:17:13,330 --> 00:17:15,210
ألست غلام الرّئيس؟

249
00:17:15,770 --> 00:17:16,210
!مهلاً

250
00:17:16,650 --> 00:17:17,730
ما الّذي حدث؟

251
00:17:19,630 --> 00:17:23,090
...ساعدتُه على الهرب

252
00:17:23,090 --> 00:17:26,050
،لكن بمجرّد أن علم بعدد ملاحقيه

253
00:17:27,370 --> 00:17:29,890
.تخلّى عنّي، وقال أنّي سأعيقه

254
00:17:29,890 --> 00:17:31,850
من أين ذهب؟

255
00:17:35,400 --> 00:17:36,610
.مهلاً

256
00:17:36,610 --> 00:17:39,000
.هذا سيف الرّئيس بالتّأكيد

257
00:17:39,000 --> 00:17:43,210
لكن لِمَ لا تزال حيًّا إذًا؟

258
00:17:44,520 --> 00:17:47,410
.إن أراد قتل شخص ما، فلن يفشل في ذلك

259
00:17:47,980 --> 00:17:51,250
.خصوصًا إن كان طفلاً مثلك

260
00:17:56,820 --> 00:17:58,940
.هو لم يفشل في قتلي

261
00:17:58,940 --> 00:18:00,670
.بل اختار ألاّ يفعل

262
00:18:01,600 --> 00:18:03,880
.لن يقتل معلّمي أيّ شخص بعد الآن

263
00:18:05,130 --> 00:18:07,510
.وسأحرص على ألاّ يضطرّ لذلك أبدًا

264
00:18:13,230 --> 00:18:14,310
،معلّمي

265
00:18:14,650 --> 00:18:16,360
.أنا آسف حقًّا

266
00:18:17,100 --> 00:18:19,070
.لقد نكثت بوعدي

267
00:18:19,820 --> 00:18:22,070
.قرّرت منذ أن أنقذتني أنّ حياتي ليست ملكًا لي

268
00:18:22,550 --> 00:18:25,820
.وأنّي سأسخّرها لأجلك

269
00:18:26,280 --> 00:18:29,220
،إن لم يكن بمقدوري حماية مبدئك

270
00:18:29,220 --> 00:18:32,080
إن لم أتمكّن من حماية التّلاميذ
،الصّغار الّذين لم ألتق بهم بعد

271
00:18:32,520 --> 00:18:35,320
فكيف أعتبر نفسي أوّل تلميذ لك؟

272
00:18:36,790 --> 00:18:39,630
،معلّمي، أعلم أنّ مدرستنا

273
00:18:40,670 --> 00:18:42,350
...شوكا سونجوكو، سوف

274
00:18:46,200 --> 00:18:50,320
،ظنّ أنّي متّ حينها بالطّبع

275
00:18:50,890 --> 00:18:53,890
لكنّ دماءه الّتي تجري في عروقي

276
00:18:53,890 --> 00:18:58,400
.حثّتني على العيش ومتابعة خدمته

277
00:18:59,060 --> 00:19:00,900
،بالتّغطية على خيانتي

278
00:19:01,400 --> 00:19:05,030
.كافحت لإبعاد أنياب ناراكو عن معلّمي

279
00:19:05,520 --> 00:19:09,280
.عارضت تعاليمه ولم أتردّد في تلطيخ يديّ بالدّماء

280
00:19:10,170 --> 00:19:13,010
،لم أمانع ذلك مع أني لم أكن إلى جانبه

281
00:19:13,010 --> 00:19:15,790
...إن عنى ذلك أنّي سأستطيع حمايته ومبدأه

282
00:19:16,200 --> 00:19:18,830
.هذا ما ظننته

283
00:19:39,690 --> 00:19:42,310
...هذا ما ظننته

284
00:19:42,310 --> 00:19:43,520
.أو ما ظننتُني ظننتُه

285
00:19:54,830 --> 00:19:58,410
.أنا من تسبّب في إمساكه

286
00:19:59,960 --> 00:20:00,710
...ومع ذلك

287
00:20:02,450 --> 00:20:03,590
،ومع ذلك

288
00:20:06,090 --> 00:20:08,090
.وثقت في عودته

289
00:20:10,300 --> 00:20:12,470
.نحن متشابهان

290
00:20:13,110 --> 00:20:15,840
.فقدنا معلّمنا بسبب ضعفنا

291
00:20:16,800 --> 00:20:21,940
.أقسم أحدنا على ألاّ يخونه أبدًا

292
00:20:23,310 --> 00:20:24,440
وأقسم الآخر

293
00:20:25,060 --> 00:20:30,320
.على أن يعيده حتّى وإن عنى ذلك قتله مجدّدًا

294
00:20:33,030 --> 00:20:36,490
تابع القتال إلى أن تموت الرّوح

295
00:20:36,490 --> 00:20:38,060
.الّتي أعطاها لك معلّمك

296
00:20:38,060 --> 00:20:39,210
...هذا ما تعلّمناه

297
00:20:40,680 --> 00:20:42,860
.نحن تلاميذ يوشيدا شويو

298
00:20:46,590 --> 00:20:48,610
.اخرج. لقد حان الوقت

299
00:20:52,130 --> 00:20:54,140
هل يمكنك أن توصل كلماتي الأخيرة

300
00:20:54,670 --> 00:20:56,600
إلى تلاميذي؟

301
00:20:57,390 --> 00:21:01,120
.ما كنت لألتقيهم لولاك

302
00:21:01,720 --> 00:21:05,860
.ما كنت لأصبح يوشيدا شويو لولاك

303
00:21:06,250 --> 00:21:07,140
.شكرًا لك

304
00:21:07,640 --> 00:21:10,610
.وسامحني

305
00:21:11,740 --> 00:21:13,980
.كنت لأودّ لمّ شملكم معًا إن أمكن

306
00:21:14,920 --> 00:21:16,060
،أولئك الأطفال

307
00:21:17,450 --> 00:21:20,000
.وفخري ومصدر سعادتي، تلميذي الأوّل

308
00:21:26,770 --> 00:21:29,760
،لقد رأيت بأمّ عينيّ يا معلّمي

309
00:21:30,970 --> 00:21:33,120
.تلاميذي الأصغر منّي الّذي أفخر بهم

310
00:21:38,830 --> 00:21:40,810
جفّت أخيرًا؟

311
00:21:41,520 --> 00:21:44,270
...جفّت هذه الدّماء أخيرًا

312
00:21:46,270 --> 00:21:49,190
.يمكنني العودة الآن

313
00:21:49,930 --> 00:21:51,370
...مرّ وقت طويل

314
00:21:51,840 --> 00:21:54,170
.لكنّ هذا الألم لا يعني شيئًا

315
00:21:54,170 --> 00:21:57,660
،مقارنة بمعاناتك الأبديّة

316
00:21:57,660 --> 00:22:01,680
لا بدّ أنّ معاناتي ليست سوى
.ألم وخزة إبرة عابر

317
00:22:04,610 --> 00:22:06,920
.اسمعني يا تاكاسوغي

318
00:22:08,110 --> 00:22:10,140
،بدل كوني أحد أتباع أوتسورو

319
00:22:10,600 --> 00:22:17,050
هناك شيء أريد قوله لك بصفتي
...أوّل تلميذ ليوشيدا شويو

320
00:22:18,260 --> 00:22:20,180
...ماهية يوشيدا شويو

321
00:22:21,040 --> 00:22:23,930
.ماهية أوتسورو

322
00:23:56,430 --> 00:24:00,910
.ضع حدًّا له قبل أن ينتهي كلّ شيء

323
00:24:00,910 --> 00:24:06,290
فصل معركة راكويو الّذي حجز لنا
مكانًا في وقت متأخّر من الليل

324
00:24:00,910 --> 00:24:06,290
!وأخذنا إلى الفضاء الخارجيّ يقترب من نهايته

325
00:24:06,290 --> 00:24:12,000
!!!وأيضًا سيكون هناك إعلان هامّ الأسبوع القادم

326
00:24:06,290 --> 00:24:12,000
!احرصوا على أن تشاهدوا غينتاما حتّى النّهاية