202
00:10:50,030 --> 00:10:53,460
لكن لمَ اختارتْ تلك اللّحظة لاستئناف تدفّق الوقت؟

203
00:10:54,280 --> 00:10:55,960
،ربّما نفد منها السّحر

204
00:10:56,660 --> 00:11:01,330
أو ربّما هناك حدّ لمدّة إيقافها للوقت

205
00:11:01,870 --> 00:11:05,990
أو لأنّها أرجعتِ الوقت

206
00:11:05,990 --> 00:11:07,280
صحيح

207
00:11:07,810 --> 00:11:09,830
سبب تمكنّنا من رؤيتها في اللّقطة

208
00:11:09,830 --> 00:11:13,770
هو لأنّها أرجعتْ فقط الإصابات الّتي تسبّبتْ في موت الملك ليزي

209
00:11:14,200 --> 00:11:17,240
لست رياضيّة يا كيميرا

210
00:11:17,240 --> 00:11:21,240
لكنك بارعة في تقييم الأوضاع، وتحسنين استعمال حدسك

211
00:11:22,450 --> 00:11:24,200
لا أستحقّ هذا الثّناء

212
00:11:26,030 --> 00:11:29,330
لا يمكنها إيقاف وإرجاع الوقت في آنٍ واحد

213
00:11:29,330 --> 00:11:33,160
بالنّسبة لها لكي ترجع الوقت عليها أن تستأنف الوقت

214
00:11:33,160 --> 00:11:36,030
ما دامت ترجع الوقت لا تستطيع إيقافه

215
00:11:36,700 --> 00:11:39,170
هذه هي نقطة ضعف سحر التّحكّم بالوقت

216
00:11:39,700 --> 00:11:41,700
لنفترض أنّنا

217
00:11:41,700 --> 00:11:44,450
ترصّدنا بآلتيماتيا وقتلناها

218
00:11:44,450 --> 00:11:47,450
إن فعلنا ذلك فستستعمل تلقائيًّا سحر التّحكّم بالوقت خاصّتها

219
00:11:47,450 --> 00:11:51,400
وترجع الوقت على جسدها إلى أن تكون حيّة

220
00:11:51,400 --> 00:11:55,360
لكن بما أنّها ترجع الوقت لا تستطيع إيقافه

221
00:11:55,780 --> 00:11:59,700
قبل أن تنهيَ إرجاع الوقت على جسدها نقتلها مجدّدًا

222
00:11:59,700 --> 00:12:02,450
سيشتغل سحر التّحكّم بالوقت خاصّتها مرّة أخرى، وترجع الوقت

223
00:12:02,450 --> 00:12:04,160
نقتلها من جديد

224
00:12:04,160 --> 00:12:05,490
وسترجع الوقت مجدّدًا

225
00:12:05,490 --> 00:12:06,700
نقتل

226
00:12:06,700 --> 00:12:08,580
ترجع

227
00:12:08,910 --> 00:12:11,370
ماذا سيحدث لو تواصل تكرار هذا؟

228
00:12:11,370 --> 00:12:15,790
حتّى الموضع الأوّل سيحترق عبر كلّ سحرها

229
00:12:15,790 --> 00:12:17,050
وتموت

230
00:12:17,050 --> 00:12:20,050
لن تتمكّن من إرجاع الوقت

231
00:12:20,580 --> 00:12:24,490
سأتوقّع بطبيعة الحال أنّها ستشنّ هجومًا معاكسًا بطرائق

232
00:12:24,490 --> 00:12:26,830
،تستعمل مخازنها السّحريّة الهائلة

233
00:12:28,270 --> 00:12:34,950
لكنّني أتوقّع من راغنا أنّه سيصدّ هجومها المعاكس، ويتمكنّ من قتلها

234
00:12:35,450 --> 00:12:37,020
في الواقع

235
00:12:37,020 --> 00:12:39,580
،لهذا السّبب نحتاج إلى أن نبدأ في اصطياد كلّ التّنانين الموجودة على الأرض الآن

236
00:12:39,580 --> 00:12:43,030
لكن الأهمّ علينا مطاردة الملكة المجنّحة الّتي تقودها

237
00:12:43,030 --> 00:12:45,030
أنت تمزح، صحيح؟

238
00:12:45,030 --> 00:12:46,780
نجحتْ أنفسنا المستقبليّة في ذلك بصعوبة

239
00:12:48,580 --> 00:12:52,490
إن كان صحيحًا أنّنا نقتل الملكة المجنّحة في المستقبل كما قال راغنا

240
00:12:52,490 --> 00:12:55,120
فلا بدّ أنّها الطّريقة الّتي استخدمها لقتلها

241
00:12:55,120 --> 00:12:58,170
يملك سحر التّحكّم بالوقت حدودًا ونقاط ضعف

242
00:12:58,450 --> 00:13:02,380
جانبه المباشر المميت الوحيد هو عدم قابلية استعمال قدرات مختلفة في آنٍ واحد

243
00:13:02,950 --> 00:13:06,490
حاليًّا هذه هي الطّريقة العمليّة الوحيدة لقتلها

244
00:13:07,080 --> 00:13:08,350
...بمعنى آخر

245
00:13:08,990 --> 00:13:12,100
يستطيع راغنا هزيمتها في مواجهة فرديّة

246
00:13:12,530 --> 00:13:15,600
المشكلة هي نبيليم وبورغيوس

247
00:13:15,600 --> 00:13:19,530
لا يمكننا السّماح لهما بمساعدة الملكة المجنّحة

248
00:13:19,530 --> 00:13:22,990
أفترض أنّكما الآن فهمتما أهميّة دوركما

249
00:13:22,990 --> 00:13:24,830
توخّيا الحذر حين تؤدّيان مَهمّتكما

250
00:13:24,830 --> 00:13:26,240
أمرك

251
00:13:29,120 --> 00:13:31,660
ماذا حدث لك فجأة؟

252
00:13:32,700 --> 00:13:34,990
هلِ اتّخذتُ القرار الصّحيح؟

253
00:13:33,410 --> 00:13:35,910
هل تصغي إليّ؟

254
00:13:35,910 --> 00:13:37,450
لا بدّ أنّني فعلت

255
00:13:37,450 --> 00:13:40,130
،ما كانتْ لتتردّد نفسي المستقبليّة في قتالها

256
00:13:40,580 --> 00:13:46,340
لكن قلّة تردّده لم تفضِ دائمًا إلى نتائج جيّدة

257
00:13:47,080 --> 00:13:50,120
لست مثل نفسيَ المستقبليّة الّتي عاشتْ حياة خاسرة

258
00:13:50,120 --> 00:13:52,560
لم أخسر أيّ أحد بعد

259
00:13:52,560 --> 00:13:54,030
أتتجاهلني؟

260
00:13:54,030 --> 00:13:55,770
مقارنة بنفسيَ المستقبليّة

261
00:13:54,030 --> 00:13:55,770
!لديك بعض الجرأة

262
00:13:56,370 --> 00:13:58,490
لست مغتاظًا

263
00:13:59,700 --> 00:14:02,480
أجل، هذا صحيح يا راغنا

264
00:14:03,990 --> 00:14:06,700
لا تحتاج الغيظ

265
00:14:06,700 --> 00:14:09,950
ابقَ هادئًا، وأطع أوامري

266
00:14:10,240 --> 00:14:14,660
هذا هو الشّيء الفاصل بالنّسبة لنا لإبادة أمثال التّنانين

267
00:14:15,870 --> 00:14:18,630
تصرّفتُ بهدوء

268
00:14:19,160 --> 00:14:21,870
كان الانسحاب القرار الصّحيح

269
00:14:21,870 --> 00:14:23,340
...لكن مع ذلك

270
00:14:24,330 --> 00:14:28,030
ما هذا الشّعور الفظيع الّذي بداخلي؟

271
00:14:32,510 --> 00:14:36,410
ما رأيك بهذا؟ أيؤلمانك؟

272
00:14:36,410 --> 00:14:37,660
سلايم-سينباي

273
00:14:38,910 --> 00:14:41,400
ألدينا وسيلة للاتّصال بالقرمزيّ؟

274
00:14:41,700 --> 00:14:43,410
!نعم

275
00:14:45,860 --> 00:14:49,990
!يمكنني التّحدّث إلى السّيّدة كيرينيكا-ساما بهذا الجهاز

276
00:14:51,080 --> 00:14:52,950
إذن أخبره أمرًا نيابة عنّي

277
00:14:53,620 --> 00:14:55,740
"أخبره أنّني "وجدتُ الهدف

278
00:15:05,700 --> 00:15:09,050
!غادر بمفرده فحسب

279
00:15:11,240 --> 00:15:12,780
!يا للعجب

280
00:15:15,530 --> 00:15:18,910
هما مستعدّان للتّخلّي عن حياتيهما من أجلي

281
00:15:18,910 --> 00:15:22,440
ليس مفاجئًا عدم ثقتهما براغنا

282
00:15:22,700 --> 00:15:27,580
يلعب بشريّ جديد بلا ولاء دورًا أساسيًّا

283
00:15:27,580 --> 00:15:29,410
،لا يمكن إراضاؤهما به

284
00:15:30,160 --> 00:15:32,910
لكن هذا بالنّسبة للوقت الرّاهن فحسب

285
00:15:33,700 --> 00:15:36,910
إن شعرتَ بالتّردّد ابدأ بالتّفكير فيّ

286
00:15:36,910 --> 00:15:39,120
تذكّر أوامري

287
00:15:39,120 --> 00:15:42,080
ابقَ هادئًا، ابقَ هادئًا

288
00:15:42,080 --> 00:15:46,590
كنتُ أقول لراغنا كلامًا باطنيًّا منذ يوم لقائنا

289
00:15:46,590 --> 00:15:52,180
يومًا ما حين آمره سيقتل بشكل قاسٍ أيّ أحد أرغب في موته

290
00:15:52,180 --> 00:15:56,700
ففي النّهاية هو مجرّد رجل عاديّ يصادف أنّه يملك قوّة خارج عصبته

291
00:15:56,700 --> 00:15:58,680
سيكون جعله دميتي أمرًا في غاية السّهولة

292
00:16:00,660 --> 00:16:03,450
لنضعِ الآن خطّة محكمة

293
00:16:03,450 --> 00:16:04,660
أمرك

294
00:16:04,660 --> 00:16:07,780
ألو؟ ألووو؟

295
00:16:08,240 --> 00:16:09,780
كيرينيكا-ساما؟

296
00:16:09,780 --> 00:16:11,030
!هذا أنا

297
00:16:11,030 --> 00:16:13,660
!خادمك الأوثق سلايم

298
00:16:13,660 --> 00:16:14,740
!انتهى

299
00:16:15,160 --> 00:16:16,740
لمَ اتّصلت؟

300
00:16:28,630 --> 00:16:30,970
!خاننا ذلك البشريّ الغبيّ

301
00:16:31,370 --> 00:16:32,450
ماذا؟

302
00:16:39,240 --> 00:16:41,600
أشكرك يا نيبيليم-سان

303
00:16:42,080 --> 00:16:46,740
رغم أنّك لست بخير سايرتَ نزواتي

304
00:16:46,740 --> 00:16:48,820
!لـ-لم يكن شيئًا يذكر

305
00:16:48,820 --> 00:16:55,820
إنّه امتياز أن أساعد في أحد أفعال لطفك يا آلتيماتيا-ساما

306
00:16:56,910 --> 00:16:59,540
لست لطيفة

307
00:16:59,910 --> 00:17:02,000
!بل لطيفة يا آلتيماتيا-ساما

308
00:17:02,410 --> 00:17:05,580
—لقد أنقذتني، لذا لا شكّ أنّك

309
00:17:09,420 --> 00:17:12,120
أ-أنا آ-آ-آسف

310
00:17:12,120 --> 00:17:14,990
أخزيتُ نفسي مرّتين

311
00:17:17,160 --> 00:17:19,370
أشكرك يا نيبيليم-سان

312
00:17:21,120 --> 00:17:27,310
على الأقلّ لا تظنّ أنّ أفعالي إرضاء للنّفس

313
00:17:27,660 --> 00:17:29,780
أ-أجل

314
00:17:32,620 --> 00:17:33,860
...بالمناسبة

315
00:17:34,120 --> 00:17:37,990
هل تلك الأسرة ضمن قائمة اليوم؟

316
00:17:38,530 --> 00:17:39,870
أجل

317
00:17:39,870 --> 00:17:42,120
رُتّبَ كلّ الثّلاثة ليختفوا اليوم

318
00:17:42,120 --> 00:17:44,080
!هذا مطمئن

319
00:17:45,170 --> 00:17:48,080
فهمت الآن

320
00:17:49,350 --> 00:17:53,810
يـ-يمكنني إخفاء النّاس الّذين داخل حاجزي من دون أيّ ألم

321
00:17:53,810 --> 00:17:57,140
كما لو أنّهم لم يوجدوا قطّ في بادئ الأمر

322
00:17:57,790 --> 00:18:03,390
وطالما هم داخل الحاجز لن يلاحظ أيّ أحد أنّهم اختفوا

323
00:18:04,310 --> 00:18:06,960
يستحيل الهرب من الموت

324
00:18:06,960 --> 00:18:11,360
لكن يمكن الهرب من الألم والخوف

325
00:18:11,620 --> 00:18:17,780
يبقى النّاس السّعداء سعيدين حين يتمّ محوهم

326
00:18:17,780 --> 00:18:19,910
أعتقد أنّ هذا خلاص

327
00:18:24,290 --> 00:18:28,780
كان إظهار جثث أولئك التّنانين فعّالًا جدًّا

328
00:18:30,120 --> 00:18:33,460
بفعل المثل في كافّة أرجاء العاصمة من الآن فصاعدًا

329
00:18:33,780 --> 00:18:37,180
يمكننا منح النّاس الطّمأنينة

330
00:18:45,200 --> 00:18:47,030
أريد إعادته ثانية

331
00:18:47,810 --> 00:18:50,910
هذا أنت من وقت سابق

332
00:18:50,910 --> 00:18:52,740
ما الخطب؟

333
00:18:52,740 --> 00:18:55,330
عرفتُ سبب علّتي

334
00:18:56,780 --> 00:18:58,030
...أنا

335
00:18:58,480 --> 00:19:01,280
لم أكن أتجنّب قتالًا من خلال البقاء هادئًا

336
00:19:02,080 --> 00:19:03,740
كنتُ خائفًا

337
00:19:04,200 --> 00:19:07,080
خائفًا من طبيعتك الغامضة الدّائمة

338
00:19:07,080 --> 00:19:08,870
خائفًا من نفسي ومن عدم قدرتي

339
00:19:08,870 --> 00:19:11,120
على استخدام القوّة الّتي عُهدت إليّ بكفاءة

340
00:19:11,120 --> 00:19:13,990
لم يكن الأمر منوّطًا بصحّة قراري من عدمها

341
00:19:13,990 --> 00:19:18,430
كنتُ أخدع نفسي، وأتظاهر أنّني هادئ من خلال الانسحاب

342
00:19:18,950 --> 00:19:21,160
لهذا السّبب شعرتُ بالغثيان

343
00:19:22,240 --> 00:19:23,830
كلّ ذلك الغيظ

344
00:19:24,600 --> 00:19:26,830
كلّ عزم النّفس المعلن عنه ذاك

345
00:19:27,850 --> 00:19:30,120
!أنا خجل من نفسي

346
00:19:32,870 --> 00:19:34,400
أنا آسفة

347
00:19:34,400 --> 00:19:37,990
لا أفهم عمّا تتحدّث عنه

348
00:19:39,780 --> 00:19:41,030
نيبيليم-سان؟

349
00:19:42,580 --> 00:19:44,410
آسف يا قرمزيّ

350
00:19:44,740 --> 00:19:50,040
أنا واثق من أنّك وضعت خطّة ببهجة لاصطياد آلتيماتيا الآن

351
00:19:50,920 --> 00:19:54,160
أنا الآن على وشك تضييع كلّ جهودك

352
00:19:57,580 --> 00:19:59,780
...إن لم أتحدّاك الآن

353
00:20:00,410 --> 00:20:03,410
...فقسمي وعزمي على قتل كلّ التّنانين

354
00:20:04,080 --> 00:20:06,160
!سيكونان هباءً

355
00:20:08,160 --> 00:20:09,580
هكذا إذن

356
00:20:09,580 --> 00:20:12,580
أنت عدوّنا

357
00:20:15,700 --> 00:20:17,280
...أعطني اهتمامًا لـ

358
00:20:18,530 --> 00:20:20,530
—كلّ الخلق واسقط

359
00:20:24,450 --> 00:20:26,240
...أعطني اهتمامًا، الوقت

360
00:20:29,120 --> 00:20:30,530
وعد

361
00:20:32,670 --> 00:20:35,880
...أعطني اهتمامًا، الخلق

362
00:20:36,460 --> 00:20:37,420
—واسقط

363
00:20:45,100 --> 00:20:47,060
ما-ما كان ذلك؟

364
00:20:47,060 --> 00:20:48,240
!ذراع

365
00:20:52,030 --> 00:20:53,950
بدء إرجاع الوقت

366
00:20:54,440 --> 00:20:57,370
‫2.88 ثانية حتّى الاكتمال

367
00:21:00,240 --> 00:21:06,580
تراجع إدراكيّ بليغ بسبب نقص مادّة الدّماغ

368
00:21:06,580 --> 00:21:09,410
غير قادر على التّعبير عن مشاعر الحزن

369
00:21:09,410 --> 00:21:12,620
حزن، حزن، الكثير من الحزن

370
00:21:13,870 --> 00:21:15,370
سأشنّ هجومًا مضادًّا

371
00:21:15,830 --> 00:21:18,550
الهدف هو سحقه حتّى الموت

372
00:21:24,700 --> 00:21:25,880
موت

373
00:21:25,880 --> 00:21:27,040
مفاجأة ثالثة

374
00:21:27,040 --> 00:21:30,350
في السّماء فوق المدينة؟

375
00:21:30,350 --> 00:21:31,560
—ماذا حد

376
00:21:36,020 --> 00:21:37,770
أرجعي الوقت بقدر ما تشائين

377
00:21:38,280 --> 00:21:41,190
الدّمّ لهب

378
00:21:41,940 --> 00:21:43,200
السّيوف الفضّيّة

379
00:21:55,030 --> 00:21:56,080
تجنّب

380
00:21:56,080 --> 00:21:58,330
لا، لا، غير ممكن

381
00:21:59,120 --> 00:22:00,960
موتي أيّتها الملكة المجنّحة

382
00:22:01,660 --> 00:22:05,470
...أعظم لطف يمكنك فعله للنّاس

383
00:22:06,370 --> 00:22:08,120
هو أن تموتي هنا