200
00:13:16,660 --> 00:13:21,990
ما كنتُ لأوقفه لأقتل أحدًا ما يحتقر الإله بشكل وحشيّ

201
00:13:22,580 --> 00:13:25,780
حين عانيتُ نقصًا في مادّة الدّماغ

202
00:13:25,780 --> 00:13:29,950
كنت مراعيًا إزاء النّاس، وقاتلت من أجلهم

203
00:13:30,370 --> 00:13:31,910
بالمناسبة

204
00:13:31,910 --> 00:13:34,450
من ذاك الطّفل؟

205
00:13:34,450 --> 00:13:37,410
،لا بدّ أنّكما تعرفان بعضكما البعض

206
00:13:37,410 --> 00:13:39,210
—لكن قد يكون من الأفضل محوه

207
00:13:42,090 --> 00:13:44,830
أتحرّك توًّا؟

208
00:13:44,830 --> 00:13:47,120
!كلّا، هذا مستحيل

209
00:13:47,120 --> 00:13:49,780
لم أشعر برجوع الوقت

210
00:13:49,780 --> 00:13:51,780
لا يستطيع التّحرّك ببساطة

211
00:13:53,160 --> 00:13:55,020
أكانت مخيّلتي؟

212
00:13:58,990 --> 00:14:00,370
نبيليم-سان؟

213
00:14:02,870 --> 00:14:08,280
كيف تجرؤ؟

214
00:14:08,280 --> 00:14:11,240
كيف تجرؤ؟ كيف تجرؤ؟ كيف تجرؤ؟ كيف تجرؤ؟

215
00:14:13,030 --> 00:14:15,240
إنّه لا يتحرّك

216
00:14:15,910 --> 00:14:17,780
كما توقّعت، كانت مخيّلتي

217
00:14:17,780 --> 00:14:19,200
هذا مطمئن

218
00:14:19,200 --> 00:14:21,370
!يا له من أمر مريح

219
00:14:21,370 --> 00:14:25,130
بصفتي السّلف لا يمكنني السّماح بحدوث مثل هذه الأمور

220
00:14:26,330 --> 00:14:28,050
يمكنك التّوقّف الآن يا نبيليم-سان

221
00:14:30,160 --> 00:14:32,640
اُنظر لذراعيك

222
00:14:35,530 --> 00:14:40,490
يبدو أنّ ذلك السّائل حمض يذيب أجسادنا

223
00:14:40,490 --> 00:14:43,860
والظّاهر أنّها طبيعة ذاك الطّفل

224
00:14:44,410 --> 00:14:48,330
،سيضرّنا إن لمسناه سهوًا

225
00:14:48,330 --> 00:14:50,990
...لكنّ العدوّ لا يزال

226
00:14:50,990 --> 00:14:52,780
أعلم

227
00:14:52,780 --> 00:14:57,080
جرّبتُ أشياء متنوّعة أثناء المعركة سابقًا

228
00:14:57,450 --> 00:15:00,170
،اخترق كلًّا من دفاعاتي

229
00:15:00,170 --> 00:15:03,000
وكانت هجماتي عقيمة

230
00:15:04,950 --> 00:15:10,160
إلى غاية الآن ضربته بشدّة، لكن لا جرح من جراحه مميت

231
00:15:10,160 --> 00:15:14,580
كما لو أنّ جسده سيف فضّيّ قويّ

232
00:15:14,580 --> 00:15:17,700
،ليس مغطّى حاليًّا بالفضّة

233
00:15:17,700 --> 00:15:20,980
لكنّني أعتقد أنّ مصدر قوّته داخل جسده

234
00:15:21,830 --> 00:15:24,830
،هذه القوّة مقاومة بشكل لا يصدّق للسّحر

235
00:15:24,830 --> 00:15:28,990
ويبدو أنّ السّحر بقوّة تحطيم العالم فقط ما يجدي معه

236
00:15:29,450 --> 00:15:31,700
بما أنّنا نضعف بنور الشّمس

237
00:15:31,700 --> 00:15:35,200
أظنّ أنّ إلحاق إصابة مميتة به سيكون أمرًا صعبًا

238
00:15:35,200 --> 00:15:37,450
علينا استعمال طريقة أخرى

239
00:15:37,910 --> 00:15:40,080
أيمكنك سماعي أيّها الزّعيم؟

240
00:15:40,080 --> 00:15:42,710
يمكنني سماعك يا سلفي

241
00:15:43,120 --> 00:15:45,410
لديّ رسالة أريد منك إيصالها

242
00:15:45,410 --> 00:15:47,970
رسالة؟ إلى من؟

243
00:15:48,280 --> 00:15:54,620
ثمّة ثلاثة أشخاص سمحتُ لهم بالتّحرّك داخل هذا العالم الثّابت

244
00:15:54,620 --> 00:15:56,780
أنت ونبيليم اثنان منهم

245
00:15:56,780 --> 00:15:58,620
...والثالث

246
00:15:58,620 --> 00:16:00,640
الملك فيمود ليزي

247
00:16:01,120 --> 00:16:03,360
لديّ طلب منه

248
00:16:03,790 --> 00:16:08,110
أريد منه إطلاق "الضّوء" على ذلك الرّجل

249
00:16:10,350 --> 00:16:14,280
أتوقّع أنّ وظيفة الحاجز الهجوميّة

250
00:16:14,280 --> 00:16:19,210
ستكون ناجعة أكثر بكثير من هجوم سحريّ

251
00:16:19,210 --> 00:16:21,420
مفهوم

252
00:16:21,420 --> 00:16:23,780
لكن عليّ أن أحذّرك

253
00:16:23,780 --> 00:16:28,880
ثمّة على الأقلّ عدوّ آخر حاضر إلى جانب هذا الرّجل

254
00:16:29,330 --> 00:16:33,990
إذن سنجد حلفاءه بعد أن ننتهي منه

255
00:16:34,740 --> 00:16:37,100
لم يعد بإمكاننا التّهاون

256
00:16:39,310 --> 00:16:43,520
سيكون خطيرًا يا نبيليم، لذا لنبتعد عنه

257
00:16:43,910 --> 00:16:45,910
آلتيماتيا-ساما

258
00:16:45,910 --> 00:16:47,480
...أنا

259
00:16:47,480 --> 00:16:51,490
سأعتمد عليك دائمًا

260
00:16:51,490 --> 00:16:54,200
ما سيحدث مستقبلًا لن يغيّر ذلك

261
00:16:54,530 --> 00:16:58,880
أطلب منك في الوقت الحاضر أن تنشئ حاجزًا أوّلًا

262
00:16:58,880 --> 00:17:01,410
لحماية النّاس داخل المنطقة المحيطة

263
00:17:01,410 --> 00:17:05,450
قد يتجاوز هجوم الضّوء توقّعي

264
00:17:15,200 --> 00:17:16,810
هذا غريب

265
00:17:16,810 --> 00:17:21,210
رغم أنّني أعرف أنّه عدوّي الآن، إلّا أنّني أشعر ببعض الشّفقة عليه

266
00:17:22,290 --> 00:17:27,050
الأمر كما لو أنّها نسخة مخفّفة ممّا أشعر به اتّجاه أفراد سلالتي

267
00:17:27,050 --> 00:17:32,080
سأكون خائنة إن شعرتُ اتّجاهه هكذا في حين أنّه قتل الكثير منّا

268
00:17:32,690 --> 00:17:35,780
سأنسى ذلك الشّعور حين تموت

269
00:17:37,490 --> 00:17:40,120
فليكن موتك هادئًا ومسالمًا

270
00:17:40,450 --> 00:17:41,740
الوداع

271
00:17:43,790 --> 00:17:48,000
سأدخل نصل الدّمّ هذا في قلبك الآن

272
00:17:55,120 --> 00:17:59,140
لن... تفلتي... بفعلتك

273
00:18:00,350 --> 00:18:02,310
...لن تحصلي

274
00:18:02,580 --> 00:18:04,770
!على ثانية أخرى

275
00:18:07,330 --> 00:18:12,530
!لن ... أسمح لك... بالعيش

276
00:18:15,200 --> 00:18:16,450
أهو يتحرّك؟

277
00:18:16,450 --> 00:18:17,700
أهو قادم نحوي؟

278
00:18:17,700 --> 00:18:19,780
إنّه يتحرّك أبطأ من ذي قبل

279
00:18:19,780 --> 00:18:21,620
يمكنني تتبّع تحرّكاته

280
00:18:21,620 --> 00:18:24,250
!لكنّه يتحرّك

281
00:18:24,250 --> 00:18:25,870
!ابقَ بعيدًا رجاءً

282
00:18:28,660 --> 00:18:29,790
!آلتيماتيا-ساما

283
00:18:29,790 --> 00:18:34,510
أسحر التّحكّم بالوقت خاصّتي يعمل قليلًا فقط؟

284
00:18:35,080 --> 00:18:37,630
حاليًّا باستثناء الملك ليزي، الوحيدون في العالم

285
00:18:37,910 --> 00:18:42,010
!الّذين سمحتُ لهم بالتّحرك هم آخرون ممّن تشاركوا دمي

286
00:18:42,010 --> 00:18:44,220
،ليس التّتبّع نقطة ضعف

287
00:18:44,620 --> 00:18:47,030
لكنّه ميزة ساحقة لسحر التّحكّم بالوقت

288
00:18:47,030 --> 00:18:52,190
يمكنك اختيار تحرير النّاس من تأثيرات إيقاف وإرجاع الوقت

289
00:18:52,190 --> 00:18:59,410
،بشكل عام ستختار استبعاد أفراد من سلالتك

290
00:18:59,410 --> 00:19:02,660
لكن ربّما ستستفيد من ذلك

291
00:19:02,660 --> 00:19:05,120
!لا يمكنك التّحرّك إلّا إذا منحتك الإذن

292
00:19:08,000 --> 00:19:09,710
!حاجز الحماية المعزّز

293
00:19:10,030 --> 00:19:14,170
!أنشأتُ الآن أفضل إجراء حماية أستطيع تصوّره

294
00:19:14,170 --> 00:19:18,510
!لن أسمح بأذيّة آلتيماتيا-ساما مجدّدًا أبدًا

295
00:19:26,640 --> 00:19:29,120
أأنت خائفة منّي؟

296
00:19:32,270 --> 00:19:36,280
...بكلّ من مات على يديك

297
00:19:37,490 --> 00:19:43,530
كيف تجرئين على الشّعور بالخوف؟

298
00:19:49,240 --> 00:19:51,240
!أعطني اهتمامًا، الوقت، وعُد

299
00:19:56,530 --> 00:19:58,620
كيف يعقل هذا؟

300
00:19:58,620 --> 00:20:00,380
،أُرجع الوقت

301
00:20:00,380 --> 00:20:02,910
ومع ذلك يتحرّك من جديد

302
00:20:07,830 --> 00:20:09,940
بإمكاني إرجاع العالم ثانية، لكن حينها ماذا سأفعل؟

303
00:20:09,940 --> 00:20:11,990
أيجب أن أوقف الوقت أوّلًا؟

304
00:20:11,990 --> 00:20:14,860
حتّى لو أوقفته فلن يتوقّف بشكل كامل

305
00:20:15,120 --> 00:20:17,440
ما العمل؟ ماذا يمكنني أن أفعل؟

306
00:20:17,830 --> 00:20:20,660
لن يطول الأمر حتّى أموت، وأعجز عن العودة

307
00:20:20,660 --> 00:20:23,030
!سأموت، لا يمكنني الموت الآن

308
00:20:23,450 --> 00:20:25,030
!كاموي

309
00:20:25,030 --> 00:20:26,790
لمَ لست هنا؟

310
00:20:38,080 --> 00:20:40,300
كلّ شيء لونه أحمر

311
00:20:40,740 --> 00:20:43,760
إنّه مؤلم، لا أستطيع التّنفّس

312
00:20:44,580 --> 00:20:46,740
هل تضرّرتُ كثيرًا؟

313
00:20:46,740 --> 00:20:48,280
كلّا

314
00:20:48,280 --> 00:20:49,950
...هذه

315
00:20:49,950 --> 00:20:54,190
تبعات استعمال الكثير من قوّتي المستقبليّة

316
00:20:56,660 --> 00:20:58,150
تبًّا

317
00:21:04,080 --> 00:21:06,330
!احمِ سلفنا يا نبيليم

318
00:21:10,080 --> 00:21:11,790
اختفِ

319
00:21:12,740 --> 00:21:14,750
شعاع الفجر

320
00:21:23,090 --> 00:21:25,340
!عيناي، لا أستطيع الرّؤية

321
00:21:25,340 --> 00:21:26,050
دخان؟

322
00:21:26,050 --> 00:21:28,260
ماذا يجري؟

323
00:21:29,530 --> 00:21:31,980
كيف سار الأمر يا نبيليم؟ هل قتلناه؟

324
00:21:32,330 --> 00:21:33,950
كلّا أيّها الزّعيم

325
00:21:34,690 --> 00:21:36,900
ثمّة أعداء جدد

326
00:21:37,160 --> 00:21:38,620
ما ذلك؟

327
00:21:38,620 --> 00:21:40,330
قطّ ضخم؟

328
00:21:40,330 --> 00:21:41,700
...و

329
00:21:41,700 --> 00:21:43,740
امرأة بشريّة؟

330
00:21:43,740 --> 00:21:45,240
لا أستطيع رؤية وجهها

331
00:21:45,240 --> 00:21:48,530
!قد لا يكونان العدوّان الوحيدان يا نبيليم

332
00:21:49,030 --> 00:21:50,160
أيّتها السّلف

333
00:21:50,160 --> 00:21:52,660
!أوقفي الوقت مرّة أخرى

334
00:21:53,500 --> 00:21:55,580
أيّتها السّلف، أيّتها السّلف

335
00:21:55,580 --> 00:21:57,290
آلتيماتيا-ساما

336
00:21:58,120 --> 00:22:00,000
لقد خسرت

337
00:22:00,330 --> 00:22:04,240
عصيت أوامري، وانتهى بك المطاف في هذا الوضع المؤسف

338
00:22:05,010 --> 00:22:09,240
ماذا سأفعل بكما الآن؟