82
00:07:36,380 --> 00:07:38,000
‫توقّفَ

83
00:07:38,790 --> 00:07:40,000
‫الوضع مجهول

84
00:07:40,000 --> 00:07:41,730
‫استعدتُها

85
00:07:40,250 --> 00:07:42,480
‫أثمّة ناجين آخرين؟

86
00:07:41,710 --> 00:07:42,730
‫كاموي

87
00:07:42,460 --> 00:07:45,730
‫إن لم يتبقّ أحدٌ فسأنجز الأمر

88
00:07:42,750 --> 00:07:45,750
‫سينسي، نيبوليم-سان، زورا-سان

89
00:07:46,170 --> 00:07:48,000
‫كلّ شيء على ما يرام

90
00:07:48,000 --> 00:07:51,290
‫سأجعل الأمر كما لو أنّ هذه النّهاية لم تحدث قطّ

91
00:07:51,750 --> 00:07:55,080
‫لكن إن قامت بإرجاع الوقت..

92
00:07:56,040 --> 00:07:58,170
‫فسأتمكّن من رؤية الآخرين

93
00:07:59,330 --> 00:08:02,540
‫إن لم أسحب الزّناد

94
00:08:25,000 --> 00:08:26,540
‫لا

95
00:08:30,080 --> 00:08:31,500
‫استيقظي

96
00:08:39,290 --> 00:08:41,210
‫لن أفعل شيئًا

97
00:08:41,210 --> 00:08:44,040
‫أحضرتكِ لكي نتحدث قليلًا فحسب

98
00:08:46,000 --> 00:08:49,540
‫يا هذه، لا تبتعدي كثيرًا وإلّا سقطتِ

99
00:08:50,630 --> 00:08:52,210
‫لأنّنا في أعلى الجرف

100
00:08:54,040 --> 00:08:55,290
‫عالٍ للغاية

101
00:08:55,290 --> 00:08:57,630
‫سأُعيدكِ بعد إنهاء حديثنا

102
00:08:57,630 --> 00:08:58,710
‫لذلك..

103
00:08:58,710 --> 00:09:00,210
‫أخبريني بأمنيتكِ

104
00:09:00,750 --> 00:09:02,830
‫ما الذي تتحدّث عنه؟

105
00:09:02,830 --> 00:09:04,580
‫أتكلّم عن أمنيتكِ، أمنيّتكِ

106
00:09:05,540 --> 00:09:08,670
‫سأحقّق إحدى أمانيك

107
00:09:08,670 --> 00:09:09,960
‫لا بدّ أنكِ تملكينها

108
00:09:09,960 --> 00:09:13,000
‫قتل أحد ما، تدمير شيء ما،

109
00:09:13,000 --> 00:09:15,000
‫أو سرقة شيء ما

110
00:09:15,920 --> 00:09:18,500
‫لا أملك أمنيّة كتلك

111
00:09:19,040 --> 00:09:21,460
‫لماذا تسأل عن شيء كذلك؟

112
00:09:21,790 --> 00:09:24,210
‫لأنّكِ تدينين لي

113
00:09:25,920 --> 00:09:29,170
‫إذن توقّف عن مناداتي بالنّملة

114
00:09:29,420 --> 00:09:31,790
‫لن أناديكِ بذلك دون الحاجة للطّلب

115
00:09:33,500 --> 00:09:36,750
‫شكرًا جزيلًا

116
00:09:36,750 --> 00:09:38,710
‫ألا تملكين شيئًا آخر؟

117
00:09:38,710 --> 00:09:41,420
‫إذن سأقرّر بنفسي

118
00:09:42,290 --> 00:09:45,710
‫قلتِ إنّكِ تريدين إنقاذ من تريدين، أليس كذلك؟

119
00:09:46,380 --> 00:09:48,460
‫هذا جوهر الأمر، أليس كذلك؟

120
00:09:49,880 --> 00:09:51,380
‫اتّخذتُ قراري

121
00:09:51,380 --> 00:09:55,710
‫سأحرّركِ من الإله ذات يوم

122
00:10:04,670 --> 00:10:06,210
‫إنّه ساخن

123
00:10:07,460 --> 00:10:10,460
‫سأحترق

124
00:10:11,460 --> 00:10:14,630
‫عليّ الذّهاب إلى الظّلال

125
00:10:26,290 --> 00:10:31,830
‫أتملكين عذرًا يا ذات الرّقم التّسلسلي 19835؟

126
00:10:32,580 --> 00:10:34,250
‫لا، آسف

127
00:10:34,250 --> 00:10:36,830
‫يستحيل امتلاككِ شيئًا كذلك

128
00:10:37,170 --> 00:10:40,630
‫فبعد كلّ شيء، يقع الخطأ على عاتقي

129
00:10:42,330 --> 00:10:46,330
‫ظننتُ أنّكِ كائن ذو مهارة عالية للغاية

130
00:10:47,000 --> 00:10:51,670
‫قوّتكِ السحريّة ومدّة اشتغالكِ تتجاوز بكثير الأفراد العاديّين

131
00:10:51,670 --> 00:10:55,750
‫تذكّرينني بذاتكِ الأصلية حين كانت لا تزال حيّة

132
00:10:55,750 --> 00:10:58,880
‫لو تمكّنتُ من إنشاء أفراد مثلكِ،

133
00:10:58,880 --> 00:11:03,000
‫لَتضخّمت القوّة العسكريّة الخاصّة بالكنيسة بشكل كبير

134
00:11:03,170 --> 00:11:06,420
‫أنا آسفة

135
00:11:07,040 --> 00:11:13,900
‫لذلك أنشأتُ العديد من الأفراد غير
‫النّاضجين مثلكِ، وجعلتُكِ تتولّينَ تعليمهم

136
00:11:14,420 --> 00:11:16,420
‫وهذه هي النّتيجة

137
00:11:17,080 --> 00:11:19,830
‫جنّ جنون كلّ من تولّتْ منصب كارلا

138
00:11:20,170 --> 00:11:22,750
‫عصينَ أوامر لا تُعدّ ولا تحصى

139
00:11:22,750 --> 00:11:26,290
‫وتسبّب ذلك في انهيار العديد من قواعد الطّليعة

140
00:11:26,630 --> 00:11:30,670
‫بدا وكأنّكنّ تَقُلن للعالم التّالي:

141
00:11:30,670 --> 00:11:34,420
‫"لا يستحقّ إله الشّمس الإيمان به"

142
00:11:34,420 --> 00:11:36,630
‫ثمّ ظهر وحش الرّعد

143
00:11:38,000 --> 00:11:39,330
‫خلال السّنوات الثّمانية السّابقة،

144
00:11:39,330 --> 00:11:43,580
‫ألحق ذلك الوحش أضرارًا هائلة بالكنيسة

145
00:11:43,580 --> 00:11:48,420
‫تكبّد الأفراد والإمدادات والمرافق كمًّا لا يُصدّق من الخسائر

146
00:11:48,960 --> 00:11:52,380
‫لو لم ألحظ علاقتكِ بذلك الوحش،

147
00:11:52,380 --> 00:11:55,290
‫لَكانت الأضرار أكبر

148
00:11:55,500 --> 00:12:01,170
‫انظري، تمكّنتُ أخيرًا من القبض عليه من خلال استغلالكِ كطعم

149
00:12:01,170 --> 00:12:04,210
‫إنها نتيجة تعاون مبيدي التّنانين،

150
00:12:04,210 --> 00:12:07,920
‫حتّى ذلك الوحش لن يتمكّن من تفادي الموت

151
00:12:10,170 --> 00:12:14,460
‫سيموت وحش الرّعد، وسيتمّ التّخلّص من كارلا الملوّثات كلّهن

152
00:12:14,460 --> 00:12:18,580
‫وبهذا ستتمكّن أخيرًا الكنيسة من العودة إلى المسار الصّحيح

153
00:12:20,880 --> 00:12:22,170
‫لماذا..

154
00:12:22,630 --> 00:12:25,830
‫حدث شيئًا كهذا؟

155
00:12:26,880 --> 00:12:30,580
‫منذ ذلك اليوم، تقدّمتُ قليلًا للأمام

156
00:12:31,330 --> 00:12:34,670
‫حتّى لو كنّا كائنات بديلة،

157
00:12:34,670 --> 00:12:38,330
‫نستطيع مواساة أنفسنا

158
00:12:39,210 --> 00:12:40,960
‫نستطيع حبّ بعضنا

159
00:12:41,420 --> 00:12:43,420
‫هذا ما علّمتهنّ إيّاه

160
00:12:44,250 --> 00:12:50,130
‫أكانت الخطيئة بهذا الفظاعة يا إلهي؟

161
00:12:50,130 --> 00:12:52,330
‫هل ناديتِني؟

162
00:12:58,500 --> 00:13:00,420
‫من تكون؟

163
00:13:03,500 --> 00:13:06,130
‫أتوقّف الوقت؟

164
00:13:06,920 --> 00:13:11,040
‫أنا الذي لم يوجد بعد

165
00:13:11,040 --> 00:13:13,830
‫والذي سيولد ذات يوم

166
00:13:14,250 --> 00:13:19,250
‫أنا الذي تصفونه بإله التّنانين يا أختي الكبرى

167
00:13:19,540 --> 00:13:23,130
‫إله التّنانين؟

168
00:13:23,960 --> 00:13:27,830
‫أستطيع أن أغدو إلهك إن رغبتِ بذلك

169
00:13:28,420 --> 00:13:30,830
‫إن كنتَ إلهًا..

170
00:13:31,540 --> 00:13:34,210
‫فهلّا تنقذنا؟

171
00:13:34,580 --> 00:13:37,290
‫هلّا تنقذ ذلك الشّخص؟

172
00:13:39,130 --> 00:13:42,750
‫أستطيع إنشاء ذلك العالم إن رغبتِ بذلك

173
00:13:43,920 --> 00:13:45,630
‫سأمنحكِ اسمًا

174
00:13:45,630 --> 00:13:47,040
‫آلتيماتيا

175
00:13:48,420 --> 00:13:49,540
‫بسببكِ...

176
00:13:49,540 --> 00:13:51,320
‫لِمَ علينا المعاناة بسبب شيء كهذا؟

177
00:13:51,320 --> 00:13:52,250
‫إنّه مؤلم

178
00:13:52,250 --> 00:13:53,130
‫أنتِ المخطئة

179
00:13:53,130 --> 00:13:54,000
‫هذه مؤلم للغاية

180
00:13:54,000 --> 00:13:58,790
‫كفّري عن ذنوبكِ

181
00:13:59,170 --> 00:14:01,920
‫قومي بولادتي في هذا العالم

182
00:14:02,330 --> 00:14:05,330
‫إن رغبتِ بمعجزة فمدّي يدكِ

183
00:14:13,960 --> 00:14:16,420
‫يـ-يا إلهي..

184
00:14:17,630 --> 00:14:23,920
‫اسمع صوتي رجاءً

185
00:14:25,040 --> 00:14:29,080
‫امنحني الخلاص مرّة أخرى

186
00:14:36,420 --> 00:14:38,330
‫كما توقّعتُ

187
00:14:39,080 --> 00:14:42,250
‫لم تعد بحاجتي، أليس كذلك؟

188
00:14:42,960 --> 00:14:47,290
‫كما حدث لهذا البلد، أنا أيضًا...

189
00:14:48,670 --> 00:14:50,580
‫أبدو مثل الغبيّة

190
00:14:54,040 --> 00:14:55,830
‫ومع ذلك..

191
00:14:59,040 --> 00:15:00,880
‫سأنجو

192
00:15:01,880 --> 00:15:06,330
‫إن لم أنجُ...

193
00:15:11,540 --> 00:15:14,250
‫لِكَم من الوقت ستعيشين؟

194
00:15:15,290 --> 00:15:17,130
‫لـ-لا أعلم

195
00:15:17,710 --> 00:15:21,710
‫يبلغ متوسّط مدّة اشتغالنا حوالي أربع سنوات

196
00:15:22,210 --> 00:15:24,200
‫إذن تبقّى حوالي السّنة...

197
00:15:24,200 --> 00:15:26,670
‫قصير للغاية، عيشي لفترة أطول

198
00:15:27,420 --> 00:15:29,420
‫إلى حين سداد ديني،

199
00:15:29,420 --> 00:15:32,710
‫عليكِ العيش اعتمادًا على قوّة إرادتك أو أيّ شيء آخر

200
00:15:33,250 --> 00:15:36,040
‫إن متِّ فلن أسامحكِ حقًّا

201
00:15:37,630 --> 00:15:41,460
‫كنتُ أنوي تدمير الكنيسة لأجل الاستمتاع

202
00:15:41,460 --> 00:15:43,830
‫لكن من الآن فصاعدًا، سأقوم بذلك بجدّيّة

203
00:15:44,710 --> 00:15:48,040
‫حسنٌ، لن أدعكِ تنتظرين طويلًا

204
00:15:48,580 --> 00:15:51,290
‫فأنا سريع

205
00:15:52,170 --> 00:15:54,250
‫أنتَ بطيء

206
00:15:55,000 --> 00:15:57,460
‫أيّها المغفّل

207
00:15:59,000 --> 00:16:04,790
‫انتظرتُ طويلًا لدرجة إصابتي بالجنون

208
00:16:06,630 --> 00:16:11,580
‫لكنّني سأنتظرك قليلًا بعد

209
00:16:12,420 --> 00:16:18,630
‫لأنّني تذكّرتُ ما كان أهمّ شيء

210
00:16:24,420 --> 00:16:27,000
‫هذا مطمئن

211
00:16:27,000 --> 00:16:28,330
‫ظلّ

212
00:16:30,170 --> 00:16:35,630
‫سأرتاح قليلًا هنا، وحين ستُشفى جراحي،

213
00:16:36,580 --> 00:16:38,790
‫سأقوم بإرجاع الوقت

214
00:16:40,290 --> 00:16:43,710
‫ثمّ سأنتظر مجدّدًا

215
00:16:50,250 --> 00:16:54,420
‫كنتُ سعيدة بعد طلبكَ منّي العيش أطول..

216
00:16:54,420 --> 00:16:57,790
‫وعدم مسامحتي إن متُّ

217
00:16:58,830 --> 00:17:02,000
‫كنتُ سأنتظر حتّى لو اضطررتُ إلى الاعتماد على الإله

218
00:17:02,920 --> 00:17:08,540
‫إلى حين تحريركَ لي من الإله

219
00:17:13,830 --> 00:17:18,580
‫تمّ قفل الحواجز الأوّل والثّاني والثّالث والرّابع

220
00:17:18,750 --> 00:17:20,750
‫اكتمل الختم متعدّد الطّبقات

221
00:17:35,920 --> 00:17:37,830
‫يا له من انتصار فظيع!

222
00:17:54,040 --> 00:17:56,750
‫أتشعر بالنّدم؟

223
00:17:58,130 --> 00:17:59,500
‫لا

224
00:18:00,880 --> 00:18:02,880
‫لم أكن لأفوز بمفردي

225
00:18:04,500 --> 00:18:07,330
‫لو لم يوجد أيّ أحد لَما بلغتُ الفوز

226
00:18:08,630 --> 00:18:10,380
‫لا أشعر بالنّدم

227
00:18:12,960 --> 00:18:17,540
‫لأنّ فعل ذلك يُعتبر إهانة للآخرين...

228
00:18:18,500 --> 00:18:19,630
‫كلّ ما في الأمر..

229
00:18:20,000 --> 00:18:21,630
‫أشعر بالحزن فحسب

230
00:18:24,170 --> 00:18:26,210
‫ماذا سيحدث إن كنتَ حزينًا؟

231
00:18:28,170 --> 00:18:30,000
‫أهذا أقصى ما ستصل إليه؟

232
00:18:30,540 --> 00:18:33,170
‫أستتوقّف عن تدمير التّنانين؟

233
00:18:34,380 --> 00:18:35,790
‫لن أتوقّف

234
00:18:37,000 --> 00:18:39,330
‫عليّ تحمّل الحزن فحسب

235
00:18:40,790 --> 00:18:42,540
‫سأقضي على التّنانين

236
00:18:43,290 --> 00:18:45,710
‫حتّى لو كنتُ بمفردي

237
00:18:47,000 --> 00:18:48,210
‫حسنٌ

238
00:18:52,210 --> 00:18:53,960
‫حان وقت الاستيقاظ

239
00:19:01,170 --> 00:19:02,460
‫مرحبًا

240
00:19:03,040 --> 00:19:04,630
‫اتبعني

241
00:19:04,630 --> 00:19:06,500
‫ثمّة شيء عليك رؤيته

242
00:19:53,170 --> 00:19:54,880
‫اختفى السّمّ

243
00:19:54,880 --> 00:19:59,080
‫والأدهى من ذلك، تمّ شفاء كل الأضرار النّاجمة عن السّمّ

244
00:20:01,920 --> 00:20:05,750
‫من النّاحية الجسديّة، لا تعاني من أيّ مشاكل

245
00:20:16,540 --> 00:20:21,000
‫كان سحر أولتو زورا ينتج المخدّرات وليس السمّ

246
00:20:21,420 --> 00:20:22,750
‫إذن...

247
00:20:24,170 --> 00:20:30,670
‫عساني أستطيع منحكم شيئًا آخر غير حياتي كمكافأة

248
00:20:36,250 --> 00:20:38,330
‫الشّخص الذي عالج سموّها هو..

249
00:20:41,540 --> 00:20:42,830
‫يا راغنا..

250
00:20:42,830 --> 00:20:46,750
‫افترق عن ذلك الحثالة ورافقني من الآن فصاعدًا

251
00:20:47,210 --> 00:20:50,460
‫لن أدعك تواجه ذلك المستقبل!

252
00:20:52,130 --> 00:20:54,500
‫نجتْ

253
00:20:55,170 --> 00:20:58,080
‫لكن ليس هناك ما يضمن استيقاظها

254
00:20:58,420 --> 00:20:59,170
‫مؤلم

255
00:21:05,380 --> 00:21:08,040
‫لا بدّ أنّها ستستيقظ

256
00:21:09,130 --> 00:21:13,580
‫ثمّ ستصنع سيفًا آخر لي

257
00:21:53,130 --> 00:21:54,500
‫هل ستغادر؟

258
00:21:55,290 --> 00:21:56,540
‫صحيح

259
00:21:56,540 --> 00:21:58,750
‫لصيد السّلالة التّالية

260
00:22:00,830 --> 00:22:01,920
‫أنتَ

261
00:22:02,380 --> 00:22:03,920
‫سألحق بك سريعًا

262
00:22:04,380 --> 00:22:05,670
‫أجل

263
00:22:10,130 --> 00:22:11,830
‫سأكون بانتظارك