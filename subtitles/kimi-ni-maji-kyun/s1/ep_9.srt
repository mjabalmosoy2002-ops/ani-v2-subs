1
00:00:01,720 --> 00:00:03,480
إنّه يوم مهرجان هوشي

2
00:00:03,780 --> 00:00:06,710
أمّي، جاء اليوم أخيراً

3
00:00:06,710 --> 00:00:10,230
سوية، سنجعلُ هذه أفضل جلسة فنّية على الإطلاق

4
00:00:10,630 --> 00:00:11,680
شاهديني فحسب

5
00:00:20,380 --> 00:00:22,250
صباح الخير يا إتشيجوجي-كن

6
00:00:24,060 --> 00:00:25,250
صباح النُّور

7
00:00:30,530 --> 00:00:36,050
صباح الخير

8
00:00:36,050 --> 00:00:38,390
ماذا؟ أتيتم جميعاً إلى هنا باكراً

9
00:00:38,710 --> 00:00:39,770
صباح الخير

10
00:00:40,550 --> 00:00:42,380
سبقَني مونيـه إلى هنا

11
00:00:42,380 --> 00:00:43,640
اصمت

12
00:00:44,180 --> 00:00:46,710
سومينوميا-سينباي، صباح الخير

13
00:00:46,710 --> 00:00:50,650
رائع يا سومي. أليس هذه هي المرّة الأولى
التي لا تتأخّر فيها؟

14
00:00:50,970 --> 00:00:53,530
أتيتَ على الموعد في يوم المهرجان

15
00:00:53,530 --> 00:00:56,030
استيقظتُ بمحض الصدفة

16
00:00:56,370 --> 00:00:57,620
اقتربَ الوقت

17
00:00:57,970 --> 00:01:04,100
نعم، اليوم حتّى المحاربين المختارين السّبعة سيسلّطون
!ضوءاً إعجازيّاً على هوشيغي

18
00:01:04,740 --> 00:01:05,890
أبطال؟

19
00:01:05,890 --> 00:01:07,630
رين رين، أحسنت

20
00:01:07,630 --> 00:01:08,570
أنا أشتعل حماساً

21
00:01:08,570 --> 00:01:10,900
يبدو هذا سخيفاً لكن لا مانع لديّ

22
00:01:11,360 --> 00:01:12,500
أليس كذلك؟

23
00:01:13,190 --> 00:01:19,640
حقّقنا كلّ هذا الإنجاز بسبب التوجيه الصّارم
جدّاً للمدير جورجي

24
00:01:19,640 --> 00:01:20,960
مدير؟

25
00:01:20,960 --> 00:01:25,390
المدير إتشيجوجي، صرامتك كانت أفضل شيء
يمكن أن نطلبه على الإطلاق

26
00:01:25,620 --> 00:01:29,380
تدريب كُرة الطائرة كان حماسيّاً جدّاً

27
00:01:30,350 --> 00:01:32,400
شكراً يا إتشيجوجي

28
00:01:33,150 --> 00:01:35,880
فعلتُ فقط ما كان يُفترَض بي أن أفعله

29
00:01:36,400 --> 00:01:37,290
هل خجِلت؟

30
00:01:37,290 --> 00:01:38,950
!ما أظرفك

31
00:01:40,960 --> 00:01:45,200
يُرجى أن تفحصوا مناطقكم للمرّة الأخيرة رجاء

32
00:01:45,690 --> 00:01:49,460
سنلتقي في المرّة المُقبِلة قبل ساعة
من الجلسة الفنّية

33
00:01:49,890 --> 00:01:52,960
حينئذ سنُجري أي تعديلات أخيرة في غرفة
المؤتمر هذه

34
00:01:53,250 --> 00:01:54,310
!نعم

35
00:01:54,310 --> 00:01:56,500
جاء اليوم أخيراً

36
00:01:56,500 --> 00:01:57,970
لنفعلها يا تسوكوشي

37
00:01:57,970 --> 00:01:59,400
اهدأ يا هيبيكي

38
00:01:59,400 --> 00:02:01,220
لنذهب ونقوم بجولتنا

39
00:01:59,400 --> 00:02:01,220
لنفعل ما بوسعنا يا إتشيجوجي-كن

40
00:02:02,340 --> 00:02:03,940
بالطبع

41
00:02:03,940 --> 00:02:06,400
آنجو-سينباي، كيف أضعتَ قائمتك بهذه السرعة؟

42
00:02:06,400 --> 00:02:07,980
رينتارو، أنا جائع

43
00:02:20,910 --> 00:02:27,180
!ماجيك-كيون نهضة

44
00:03:42,770 --> 00:03:45,970
أتطلّعُ قُدماً للاستماعِ إلى غِناء تيكا-كن

45
00:03:45,970 --> 00:03:50,000
حريّ به ألّا يفعل شيئاً محرجاً
لاسم عائلة إتشيجوجي

46
00:03:52,930 --> 00:03:55,470
لم أرك منذُ وقتٍ طويل يا ماسانا-سينباي

47
00:03:55,470 --> 00:03:58,930
نعم، لم أرك منذُ زمن يا تودو

48
00:03:58,930 --> 00:04:02,130
المهرجان في هذا العام حيويٌّ أيضاً

49
00:04:02,130 --> 00:04:04,480
هل أتيتُما لحضور الجلسة الفنّية؟

50
00:04:04,480 --> 00:04:05,140
نعم

51
00:04:06,620 --> 00:04:08,470
يذكّركما هذا بالماضي، أليس كذلك؟

52
00:04:10,350 --> 00:04:12,730
القدَرُ شيء عجيب

53
00:04:13,100 --> 00:04:15,970
لا أصدّق أنّ فردين من عائلتَيْ
إتشيجوجي وآيغاساكي

54
00:04:15,970 --> 00:04:19,480
سيؤدّيان في الجلسةِ الفنّية مجدّداً

55
00:04:21,720 --> 00:04:23,680
إنّها محض صدفة

56
00:04:23,680 --> 00:04:28,580
على الأقلّ، إنّها فرصة لسحق عائلة آيغاساكي

57
00:04:28,580 --> 00:04:31,500
لا أحد يستطيع هزيمة تيكا-كن

58
00:04:33,000 --> 00:04:34,850
بالطبع

59
00:04:34,850 --> 00:04:37,000
استمتعا بالجلسة الفنّية

60
00:04:38,440 --> 00:04:39,630
ماذا يعني هذا؟

61
00:04:39,630 --> 00:04:42,280
لِمَ لا تريان ذلك بنفسكما؟

62
00:04:47,500 --> 00:04:51,200
سيبدأ مهرجان هوشينوموري الصيفيّ الآن

63
00:04:52,850 --> 00:04:55,890
لا تتدافعوا، تقدّموا ببطء رجاء

64
00:04:56,300 --> 00:04:58,900
شكراً لحضورك

65
00:04:58,900 --> 00:05:02,560
شكراً لحضوركِ أيّتها القطط الصغيرة

66
00:05:02,560 --> 00:05:06,590
وها أنا أقوم بتوزيع منشورات إغرائيّة لشكركم

67
00:05:10,660 --> 00:05:12,960
سينباي، زرِّر قميصك

68
00:05:12,960 --> 00:05:15,410
ماذا؟ لماذا؟

69
00:05:16,650 --> 00:05:17,890
طعام لذيذ

70
00:05:17,890 --> 00:05:18,980
طازج

71
00:05:18,980 --> 00:05:21,670
أهلاً بكم، تفضّلوا

72
00:05:22,160 --> 00:05:23,730
صباح الخير

73
00:05:23,730 --> 00:05:25,880
أتيتُ لتفقّد البضاعة

74
00:05:25,880 --> 00:05:27,180
أهلاً

75
00:05:27,490 --> 00:05:29,640
شكراً لعملكِ الدّؤوب. خذا هذه معكما

76
00:05:29,640 --> 00:05:32,390
رائع، شكراً

77
00:05:34,540 --> 00:05:35,270
...هذا

78
00:05:35,490 --> 00:05:37,770
ماذا؟ هل من مُشكلة؟

79
00:05:38,130 --> 00:05:41,190
هذه القهوة من كوستاريكا

80
00:05:41,190 --> 00:05:43,530
لها رائحة حلوة وحموضة لطيفة

81
00:05:43,530 --> 00:05:45,760
،لكن بطريقةِ تحميصها

82
00:05:45,760 --> 00:05:47,910
لا يمكن أن تكون فرشاة رسم جيّدة

83
00:05:48,390 --> 00:05:49,860
يبدو كلّ شيء على ما يُرام

84
00:05:49,860 --> 00:05:51,700
بالتوفيق لك اليوم

85
00:05:52,180 --> 00:05:53,670
رائع

86
00:05:53,670 --> 00:05:54,790
هنالك الكثير من الإضاءة الفنّية

87
00:05:54,790 --> 00:05:55,790
هذا ما أتوقّعه من هوشيغي

88
00:05:55,790 --> 00:05:56,540
ما أظرفه

89
00:05:56,540 --> 00:05:59,820
مذهل، هذه تحفة فنّية

90
00:05:59,820 --> 00:06:01,290
إنّه مُتقَن

91
00:06:01,760 --> 00:06:03,090
،بفضلِ اللّجنة التنفيذيّة

92
00:06:03,090 --> 00:06:04,970
لدينا ما يكفي من أشخاص لحملِ المزار

93
00:06:04,970 --> 00:06:07,610
لنفعل ما بوسعنا في الموكب

94
00:06:07,610 --> 00:06:08,300
!نعم

95
00:06:09,080 --> 00:06:11,310
حاولوا ألّا تسبّبوا أي حوادث

96
00:06:11,310 --> 00:06:12,830
بالتوفيق

97
00:06:14,180 --> 00:06:15,510
هذه لك

98
00:06:15,510 --> 00:06:16,290
ماذا؟

99
00:06:16,290 --> 00:06:17,310
أأنت متأكّد؟

100
00:06:17,310 --> 00:06:20,980
الجميع يعشقون الكريب الذي علّمتنا
كيفيّة تحضيره

101
00:06:20,980 --> 00:06:22,660
لا يسعنا إلّا أن نكون ممتنّين لك

102
00:06:23,210 --> 00:06:25,070
أهلاً

103
00:06:25,740 --> 00:06:29,030
شكراً، لا أعلم ماذا كنتُ سأفعل لولا هذه

104
00:06:30,550 --> 00:06:31,660
ليست جيّدة؟

105
00:06:31,660 --> 00:06:33,030
أظنُّني سأقليها إذاً

106
00:06:34,080 --> 00:06:37,540
لا، هذا ليس للبيع

107
00:06:39,630 --> 00:06:41,150
بورِك عملك

108
00:06:41,150 --> 00:06:44,300
هذا كلّ ما نحتاج لتفقّده في هذا الصّباح

109
00:06:44,300 --> 00:06:46,590
هل فات الأوان على تقديمِ نموذج طلب الآن؟

110
00:06:46,590 --> 00:06:49,720
لا، اسمحا لي أن أشرح التفاصيل

111
00:06:50,160 --> 00:06:52,740
هنالك طريقتان لقبول نموذج طلب

112
00:06:51,500 --> 00:06:54,220
هل تكلّمت مع تيكا؟

113
00:06:52,740 --> 00:06:54,220
...الأولى هي بخصوص اللّجنة التنفيذيّة

114
00:06:55,280 --> 00:06:57,310
قليلاً

115
00:06:57,810 --> 00:07:00,610
لم أرَ إتشيجوجي-كن بهذا الشكل من قبل

116
00:07:00,610 --> 00:07:03,320
كان يغنّي أغنيةً حزينة

117
00:07:04,070 --> 00:07:08,560
كان تيكا جيّداً في الغناء مُذ كان طفلاً

118
00:07:08,560 --> 00:07:12,820
يتوقّعُ أخواه الكثير منه

119
00:07:12,820 --> 00:07:13,870
يتوقّعان ماذا؟

120
00:07:14,080 --> 00:07:17,120
يتوقّعان منه أن يغنّي لأجل العائلة

121
00:07:18,810 --> 00:07:23,220
لم يسبق أن خذلَ أحداً

122
00:07:23,220 --> 00:07:30,010
لكن بات يتغيّرُ قليلاً منذُ التقى بكِ

123
00:07:30,420 --> 00:07:31,260
ماذا؟

124
00:07:31,920 --> 00:07:35,010
أنا أؤمن بتيكا

125
00:07:39,360 --> 00:07:42,510
لنرَ. إنّه هنا، صحيح؟

126
00:07:43,280 --> 00:07:47,020
...مقهى المسرح، مقهى المسرح

127
00:07:49,440 --> 00:07:50,170
احزري من أكون

128
00:07:50,170 --> 00:07:53,340
ماذا؟ مـ-من...؟

129
00:07:55,530 --> 00:07:56,530
جوري

130
00:07:56,760 --> 00:07:57,530
ماذا؟

131
00:07:59,120 --> 00:08:00,890
...هذا الزيّ

132
00:08:02,810 --> 00:08:05,420
أهلاً بعودتكِ يا آنسة

133
00:08:05,670 --> 00:08:07,490
ماذا؟

134
00:08:07,490 --> 00:08:09,510
أهلاً بكِ في مقهى المسرح

135
00:08:16,330 --> 00:08:18,680
جوري، هذا مذهل

136
00:08:19,690 --> 00:08:24,870
اشهدي قوّة التمثيل البليغة التي تستقرُّ في داخلي

137
00:08:25,910 --> 00:08:26,930
جوري-ساما

138
00:08:26,930 --> 00:08:28,320
إنّها وسيمةٌ للغاية

139
00:08:29,850 --> 00:08:31,770
كوهانا، سأدعوكِ لتناول بعض الكيك

140
00:08:31,770 --> 00:08:33,210
آسفة

141
00:08:33,210 --> 00:08:36,320
عليّ المغادرة عمّا قريب كي أتحضّر
للجلسةِ الفنّية

142
00:08:36,650 --> 00:08:39,580
هكذا إذاً. أتطلّعُ له كثيراً حقّاً

143
00:08:39,580 --> 00:08:42,020
نعم، شكراً. سأفعل ما بوسعي

144
00:08:46,650 --> 00:08:48,340
أمّي

145
00:08:48,340 --> 00:08:51,340
هل تهت؟

146
00:08:52,360 --> 00:08:54,550
لا تنسوا شيئاً يا شباب

147
00:08:55,640 --> 00:08:57,940
آيغاساكي-سينباي قد تأخّر

148
00:08:57,940 --> 00:09:01,930
غريب. زهرتي الصّغيرة لا تتأخّر أبداً

149
00:09:06,530 --> 00:09:08,390
أنتِ ابنةُ آيغاساكي

150
00:09:09,840 --> 00:09:12,940
أجل، اسمي آيغاساكي كوهانا

151
00:09:16,820 --> 00:09:20,050
اليوم لحظة تيكا-كن الهامّة

152
00:09:20,050 --> 00:09:24,500
حريّ بكِ ألّا تفعلي شيئاً يعرقله

153
00:09:26,210 --> 00:09:28,830
الجلسة الفنّية هي استعراض جماعي

154
00:09:29,990 --> 00:09:33,340
لم نأتِ إلى هنا إلّا لسماع غناء تيكا-كن

155
00:09:33,600 --> 00:09:34,210
...لكن

156
00:09:34,210 --> 00:09:38,650
عائلة آيغاساكي لا تدرك ذلك كعادتها

157
00:09:38,650 --> 00:09:39,220
ماذا؟

158
00:09:39,540 --> 00:09:43,920
ألا تدركين أنّ عائلتينا منافستان؟

159
00:09:43,920 --> 00:09:48,850
جلسة اليوم الفنّية هي أيضاً معركةٌ بينكِ وبين تيكا

160
00:09:50,830 --> 00:09:54,110
ماذا؟ هل لديكِ اعتراض على ذلك؟

161
00:09:54,110 --> 00:09:56,360
أخوايّ، توقّفا

162
00:09:57,370 --> 00:09:59,110
تيكا-كن

163
00:09:59,110 --> 00:10:00,240
هذا يكفي

164
00:10:00,240 --> 00:10:01,390
ماذا؟

165
00:10:01,390 --> 00:10:06,620
آيغاساكي لا يمكن أن تعتبر أحداً عدوّاً
أو حليفاً لها

166
00:10:06,900 --> 00:10:10,630
نحن نعيشُ في عالمَين مختلفَين تماماً

167
00:10:12,420 --> 00:10:13,880
عالم مختلف؟

168
00:10:17,730 --> 00:10:22,890
لقد عملتُ جاهداً لإنجاحِ الجلسة الفنّية

169
00:10:23,400 --> 00:10:30,520
تمكّنتُ من فعل ذلك بفضلِ وجودها
هي والآخرين بجانبي

170
00:10:31,210 --> 00:10:32,680
تيكا-كن

171
00:10:35,250 --> 00:10:38,280
آمل أن تستمتعا بالجلسةِ الفنّية

172
00:10:38,700 --> 00:10:39,940
نستأذن

173
00:10:41,410 --> 00:10:43,940
لنسرع. فالجميع ينتظروننا

174
00:10:51,650 --> 00:10:53,840
تيكا-كن، لماذا؟

175
00:10:54,740 --> 00:10:56,300
لا أصدِّق هذا

176
00:11:05,960 --> 00:11:07,060
إتشيجوجي-كن

177
00:11:09,400 --> 00:11:14,750
لستُ أدري ماذا قصدت بعالَمٍ مختلف

178
00:11:14,750 --> 00:11:19,400
لكن كلّنا نعملُ معاً، أليس كذلك؟

179
00:11:20,130 --> 00:11:24,160
ألا يعني هذا أنّنا في نفس العالم؟

180
00:11:34,080 --> 00:11:36,130
هيّا، لنذهب

181
00:11:39,210 --> 00:11:41,630
بسرعة

182
00:11:48,560 --> 00:11:49,390
لقد أتيا

183
00:11:49,700 --> 00:11:51,480
تأخّرتُما

184
00:11:51,480 --> 00:11:52,660
آسفة

185
00:11:52,660 --> 00:11:55,900
لم نكن نعلم ماذا نفعل من دون رئيسنا ونائبة رئيسنا

186
00:11:56,270 --> 00:11:59,130
لنقضِ بعضاً من المرح في الجلسة الفنّية

187
00:11:59,130 --> 00:12:02,990
هنالك أشياء لا يستطيع سوانا فعلها

188
00:12:06,000 --> 00:12:06,990
نعم

189
00:12:11,750 --> 00:12:14,250
حان الوقت

190
00:12:14,250 --> 00:12:16,130
أنا متوتّرةٌ للغاية

191
00:12:19,600 --> 00:12:22,840
يا زهرتي الصّغيرة، ثِقي بنفسكِ

192
00:12:22,840 --> 00:12:26,970
وثِقي بنا أيضاً يا سينباي

193
00:12:28,850 --> 00:12:30,960
،إذا تكاتفنا معاً

194
00:12:31,250 --> 00:12:32,810
فيمكننا صنع المُعجزات

195
00:12:33,540 --> 00:12:36,610
سنحميكِ على الدوام

196
00:12:37,120 --> 00:12:40,840
منحتِنا شيئاً ثميناً

197
00:12:40,840 --> 00:12:43,360
هذه المرّة، نحن من سيمنحكِ شيئاً

198
00:12:43,680 --> 00:12:46,360
لا عليكِ، أنا واثقٌ أنّكِ ستنجحين

199
00:12:48,280 --> 00:12:49,370
شكراً لكم

200
00:12:49,970 --> 00:12:53,500
قلوبنا متوحّدة الآن، أليس كذلك؟

201
00:12:54,630 --> 00:12:56,120
أعلم أنّنا نستطيع فعلها

202
00:15:54,900 --> 00:15:56,510
!كوهانا

203
00:16:09,820 --> 00:16:11,910
!ماجيك-كيون لأجلك

204
00:16:11,910 --> 00:16:13,910
سلام

205
00:16:14,480 --> 00:16:15,210
سحر

206
00:16:15,210 --> 00:16:16,460
كيون

207
00:16:16,460 --> 00:16:17,960
نهضة

208
00:16:20,770 --> 00:16:23,370
هل أبدو جيّدة؟ هل يبدو هذا غريباً؟

209
00:16:23,370 --> 00:16:26,320
عمّاذا تتكلّمين؟ أنتِ ظريفة

210
00:16:26,320 --> 00:16:27,800
يبدو هذا مذهلاً عليكِ

211
00:16:28,830 --> 00:16:32,130
شكراً. تبدين رائعة أيضاً

212
00:16:32,130 --> 00:16:32,920
بالتأكيد

213
00:16:41,690 --> 00:16:43,900
سينباي، نحن هنا

214
00:16:44,920 --> 00:16:46,400
يا له من فستان ظريف

215
00:16:47,700 --> 00:16:49,150
هيّا

216
00:16:49,670 --> 00:16:50,550
حسناً

217
00:16:52,530 --> 00:16:53,690
إنّها جوري-ساما

218
00:16:53,690 --> 00:16:55,410
هل نتكلّم معها؟

219
00:16:53,690 --> 00:16:55,410
!ما أروعها

220
00:16:57,520 --> 00:17:01,910
نور فنّكم الممزوج ما زال يتألّق

221
00:17:01,910 --> 00:17:06,450
مذهل، يا لها من جلسة فنّية مذهلة

222
00:17:06,450 --> 00:17:09,090
شكراً لك يا شينرا-نيسان

223
00:17:09,090 --> 00:17:14,420
اعتقدناك مجرّد طفل بحاجةٍ للعناية

224
00:17:14,420 --> 00:17:17,430
لكنّك نضجتَ وأصبحتَ رجلاً حقيقيّاً يا تيكا-كن

225
00:17:17,960 --> 00:17:20,430
بذلتَ مجهوداً كبيراً

226
00:17:22,800 --> 00:17:27,650
تعلم أنّني شاركتُ في الجلسةِ الفنّية سابقاً، أليس كذلك؟

227
00:17:27,650 --> 00:17:28,190
أجل

228
00:17:28,760 --> 00:17:32,320
كانت آيغاساكي ساكورا جزءاً من الجلسة آنذاك

229
00:17:33,380 --> 00:17:37,440
لم أكن أفكّرُ سوى بهزيمتها

230
00:17:37,440 --> 00:17:41,630
لكن لم تكن تهتمُّ بالفوز أو الخسارة

231
00:17:41,630 --> 00:17:44,090
كانت تجربتي مشابهة لتجربتك من هذه النّاحية

232
00:17:44,090 --> 00:17:50,310
لكن لم تكن العلاقة بيننا كالعلاقة بينكما

233
00:17:50,310 --> 00:17:52,590
عشنا في عالمَين منفصلَين حتّى النّهاية

234
00:17:53,360 --> 00:17:57,720
تيكا-كن، اعتنِ بعالمِك الجديد

235
00:17:59,610 --> 00:18:00,350
سأفعل

236
00:18:00,830 --> 00:18:04,600
من الآن فصاعداً، اسلك الطريق الذي تُؤمن به

237
00:18:04,600 --> 00:18:07,290
سأفعل. راقباني

238
00:18:07,290 --> 00:18:09,230
ويمكنكما أن تتأمّلا منّي أشياءً عظيمة أيضاً

239
00:18:11,200 --> 00:18:16,240
سأفوقُ توقّعاتكما وأبتعد أكثر فأكثر

240
00:18:33,850 --> 00:18:39,210
آيغاساكي-سينباي، لن أنسى مهرجان هوشي هذا العام ما حييت

241
00:18:39,210 --> 00:18:42,600
قضيتُ الكثير من أوقات المرح لأنّني خضتُه معكِ

242
00:18:43,620 --> 00:18:48,360
يا زهرتي الصّغيرة، ترقصين بخفّةٍ كريشة

243
00:18:48,960 --> 00:18:51,810
أبليتِ بلاء حسناً

244
00:18:52,900 --> 00:18:57,610
هانا-تشان-سينباي، تغيّر فيّ كلّ شيء
منذُ التقيتُكِ

245
00:18:57,610 --> 00:18:58,860
شكراً لكِ

246
00:18:59,800 --> 00:19:03,710
كان الجميع في الخيمةِ يبتسمون

247
00:19:03,710 --> 00:19:06,790
آيغاساكي، يعزو كلّ الفضل إليكِ

248
00:19:08,640 --> 00:19:11,800
من أعماقِ قلبي، شكراً لكِ

249
00:19:15,120 --> 00:19:18,870
كان ذلك أفضل مهرجان على الإطلاق

250
00:19:18,870 --> 00:19:20,730
شكراً يا جوري

251
00:19:20,730 --> 00:19:23,840
كوهانا، أنتِ مذهلة حقّاً

252
00:19:23,840 --> 00:19:26,930
أقنعتِ ستّة أشخاص مختلفين كلّياً
بالاجتماعِ معاً

253
00:19:26,930 --> 00:19:30,050
ماذا؟ لم أكن أنا

254
00:19:30,050 --> 00:19:32,150
لقد شاركَ الجميع

255
00:19:33,160 --> 00:19:34,280
حسناً، ها هُم

256
00:19:34,850 --> 00:19:36,570
أولئك الستّة

257
00:19:45,360 --> 00:19:47,330
حان دور الرّقصة الأخيرة

258
00:19:48,000 --> 00:19:49,580
عليكِ أن تقرّري

259
00:19:49,880 --> 00:19:52,080
حالاً

260
00:19:52,370 --> 00:19:55,210
أمسكي بيدٍ من أيدينا

261
00:19:55,970 --> 00:19:57,590
نحن ننتظر

262
00:19:59,650 --> 00:20:01,980
ماذا ستفعلين يا أميرة؟

263
00:20:01,980 --> 00:20:02,910
ماذا؟

264
00:20:08,050 --> 00:20:09,560
لنرقص

265
00:20:10,210 --> 00:20:11,330
!أنت

266
00:20:31,040 --> 00:20:34,280
خدعَنا إتشيجوجي حقّاً

267
00:20:34,880 --> 00:20:37,780
سنتركها له اللّيلة

268
00:20:37,780 --> 00:20:41,650
لم يرقص إتشيجوجي-سينباي إطلاقاً اللّيلة

269
00:20:41,650 --> 00:20:43,050
ليس باليد حيلة

270
00:20:43,620 --> 00:20:46,180
لقد تغيّرَ تيكا

271
00:20:55,890 --> 00:21:00,230
شكراً لكِ لقولكِ أنّكِ تحبّين غنائي

272
00:21:01,490 --> 00:21:03,240
إتشيجوجي-كن

273
00:21:04,750 --> 00:21:05,740
ناديني تيكا

274
00:21:28,260 --> 00:21:29,700
معقول؟

275
00:21:36,270 --> 00:21:38,420
ها نحن ذا

276
00:21:40,110 --> 00:21:41,490
بسرعة، بسرعة

277
00:21:42,620 --> 00:21:44,150
ابتسم

278
00:21:44,480 --> 00:21:45,330
ثلاثة

279
00:21:45,820 --> 00:21:46,650
اثنان

280
00:21:46,650 --> 00:21:47,910
واحد

281
00:23:25,550 --> 00:23:28,100
ليس من الجيّد الانفلات كثيراً في إجازة الصّيف

282
00:23:28,100 --> 00:23:29,760
لكنّهم بذلوا مجهوداً طيّباً

283
00:23:29,980 --> 00:23:32,500
حسناً، أظنُّني أهملتُ ذلك

284
00:23:32,500 --> 00:23:34,260
:الحلقة القادمة من ماجيك-كيون! نهضة

285
00:23:34,560 --> 00:23:35,930
"عطلة صيفيّة مسرِّعة حماسيّة"

286
00:23:36,600 --> 00:23:38,430
هل عليّ قولها أيضاً؟

287
00:23:38,430 --> 00:23:39,930
ماجيك-يكون لأجلك