1
00:00:00,730 --> 00:00:04,940
لعلّها كانت قلقة جدّاً لدرجة أنّها
أطبقَتْ على قلبِها

2
00:00:06,100 --> 00:00:08,230
،إن صحَّ ذلك

3
00:00:08,870 --> 00:00:11,320
فلن تستيقظ آيغاساكي ما لم تتحرّر من السّبب

4
00:00:12,290 --> 00:00:14,710
،إذا كنتُ لا أستطيع استخدام الفنون السحريّة

5
00:00:15,360 --> 00:00:17,410
...فإذاً لا أحد سوف

6
00:00:21,710 --> 00:00:25,460
،لو كانت آيغاساكي في مكاننا

7
00:00:26,120 --> 00:00:27,960
لما استسلمت

8
00:00:29,090 --> 00:00:31,340
،لكانت قالَتْ لنا وهي مُبتسِمة

9
00:00:31,750 --> 00:00:33,730
"أنا متأكّدةٌ أننا نستطيعُ فعلها"

10
00:00:35,950 --> 00:00:39,010
لن نستسلم أبداً

11
00:00:51,900 --> 00:00:53,900
!ماجيك-كيون نهضة

12
00:02:18,480 --> 00:02:20,990
آسفة يا كوهانا

13
00:02:21,650 --> 00:02:24,370
"أنا المخطئة عندما اقترحتُ أن نؤدِّي "الحسناء النّائمة

14
00:02:24,720 --> 00:02:26,560
لهذا نمتِ

15
00:02:26,560 --> 00:02:28,370
هذه ليسَتْ غلطتكِ

16
00:02:29,050 --> 00:02:32,360
أعلم، أعلم هذا

17
00:02:32,360 --> 00:02:38,080
لكن لا شيء أستطيعُ فعله لأجلِها رُغمَ أنّني صديقتها

18
00:02:38,080 --> 00:02:41,090
...رغم أنّني أحبُّها

19
00:02:41,090 --> 00:02:43,440
،رُغم أنّني أحبُّها كثيراً

20
00:02:43,440 --> 00:02:45,590
لا أستطيع فعل شيء لأجلِها

21
00:02:46,370 --> 00:02:49,350
...كوهانا... كوهانا

22
00:02:50,760 --> 00:02:52,970
ينتابُنا نفس الإحساس جميعاً

23
00:02:54,260 --> 00:02:57,780
لنتناوب اللّيلة على البقاءِ مع آيغاساكي

24
00:02:57,780 --> 00:03:02,910
معك حقّ، لنتكلّم معها طوال اللَّيل

25
00:03:04,570 --> 00:03:06,910
أنا متأكّدٌ أنَّ كلامنا سيصل إلى قلبها

26
00:03:07,180 --> 00:03:08,910
أجل

27
00:03:10,120 --> 00:03:13,160
كوهانا، سنكون في انتظارِك

28
00:03:18,560 --> 00:03:19,910
آيغاساكي

29
00:03:21,120 --> 00:03:22,290
سينباي

30
00:03:23,170 --> 00:03:24,730
يا زهرتي الصَّغيرة

31
00:03:25,470 --> 00:03:26,980
هانا-تشان-سينباي

32
00:03:28,560 --> 00:03:30,100
آيغاساكي-سان

33
00:03:31,700 --> 00:03:32,870
آيغاساكي

34
00:03:48,000 --> 00:03:50,250
هل تسمعينني يا آيغاساكي؟

35
00:03:50,990 --> 00:03:56,250
كلّ ما يمكننا فعله لكِ الآن هو التكلُّم معكِ

36
00:03:56,870 --> 00:03:59,720
آمل أن تتمكّني من سماعِ صوتي

37
00:04:01,420 --> 00:04:04,510
كنتُ قلقاً حقّا

38
00:04:05,290 --> 00:04:08,980
قرّرتُ عندما كنتُ طفلاً أن أعمل في النَّحت

39
00:04:08,980 --> 00:04:11,520
لكن لم تكن الأمور تسير على ما يُرام

40
00:04:12,020 --> 00:04:15,770
لم أكن أعلم ماذا أفعل

41
00:04:16,320 --> 00:04:21,280
لكن علّمتِني بابتسامتكِ الرَّائعة تلك

42
00:04:21,810 --> 00:04:24,280
تعلّمتُ أنَّ هناك أكثر من طريق واحد

43
00:04:26,420 --> 00:04:31,540
لعلّكِ لا تعلمين كم ابتسامتكِ مذهلة

44
00:04:31,810 --> 00:04:33,660
كم تشجِّع الناس

45
00:04:34,120 --> 00:04:36,170
كم تمدّهم بالطاقة

46
00:04:36,620 --> 00:04:39,420
أحبُّ ابتسامتكِ

47
00:04:40,020 --> 00:04:42,350
أحبُّكِ

48
00:04:50,100 --> 00:04:51,520
ابتسمي

49
00:04:52,100 --> 00:04:55,300
ليس لأجلِ أي شخص آخر، بل لأجلكِ

50
00:04:55,300 --> 00:04:58,190
أظهري ابتسامتكِ لنفسكِ

51
00:04:58,450 --> 00:05:01,690
ستتحسّنين أكثر حينئذ

52
00:05:08,770 --> 00:05:11,330
سينباي، لا تقلقي

53
00:05:11,330 --> 00:05:14,140
أحضرتُ بخّاخاً مُطهِّراً

54
00:05:14,140 --> 00:05:15,860
،كائناً من جاء

55
00:05:15,860 --> 00:05:17,710
سأحميكِ

56
00:05:19,360 --> 00:05:22,000
قضيتُ وقتاً ممتعاً جدّاً في حلِّ المُشكلات

57
00:05:22,000 --> 00:05:24,720
التي كانَتْ تُطرَح على لجنةِ مهرجانِ هوشي

58
00:05:25,890 --> 00:05:29,720
ركضنا في أرجاءِ المدرسة معاً أثناء الاستراحات
وبعد دوام المدرسة

59
00:05:29,720 --> 00:05:35,230
نمارس كلّ أنواع الأنشطة ونبتسم معاً

60
00:05:35,640 --> 00:05:42,520
سُعِدتُ كثيراً لأنَّني قضيتُ كلّ الوقت معكِ

61
00:05:44,010 --> 00:05:47,010
،مُذ كنتُ طفلاً

62
00:05:47,010 --> 00:05:49,740
وأنا أهتمُّ بأخوتي

63
00:05:50,160 --> 00:05:53,990
ظننتُ أنَّ عملي هو الاعتناء بالآخرين

64
00:05:54,400 --> 00:05:57,070
...لكن عندما

65
00:05:59,180 --> 00:06:01,440
،اعتنيتِ بي أنتِ

66
00:06:01,440 --> 00:06:04,190
أسعدَني ذلك كثيراً

67
00:06:04,650 --> 00:06:05,880
كانت المرّة الأولى لي

68
00:06:06,960 --> 00:06:08,380
سينباي

69
00:06:09,030 --> 00:06:12,690
لعلّكِ تريدين أن ترتاحي الآن، أليس كذلك؟

70
00:06:12,690 --> 00:06:15,390
لكن عودي قريباً

71
00:06:19,650 --> 00:06:22,150
سأكون في انتظاركِ

72
00:06:28,290 --> 00:06:31,240
يا زهرتي الصّغيرة، هل نرقص؟

73
00:06:32,240 --> 00:06:35,120
واحد، اثنان، ثلاثة. واحد، اثنان، ثلاثة

74
00:06:35,120 --> 00:06:37,930
...واحد، اثنان، ثلاثة. واحد

75
00:06:41,280 --> 00:06:45,170
لا جدوى، لا أستطيع الرَّقص من دونكِ

76
00:06:46,790 --> 00:06:51,390
جعلتِني أدرك كيف كان شعوري بالضبط

77
00:06:52,330 --> 00:06:56,270
لم أكن أدرِك شعوري حيال الرّقص

78
00:06:56,610 --> 00:06:59,770
كلّما رقصتُ أكثر، شعرَ قلبي بحرّية أكبر

79
00:07:00,340 --> 00:07:03,770
كلّما رقصتُ أكثر، ازددتُ حبّاً للرقص

80
00:07:04,370 --> 00:07:08,280
أنتِ دائماً في قلبي ترقصين معي

81
00:07:13,810 --> 00:07:18,460
أنتِ نائمة لأنّ هناك ما يجعلكِ حزينة

82
00:07:18,920 --> 00:07:22,390
هل تبكين؟ هل ترتجفين؟

83
00:07:22,840 --> 00:07:24,040
هل أنتِ خائفة؟

84
00:07:24,500 --> 00:07:26,130
لكن لا تقلقي

85
00:07:26,690 --> 00:07:28,790
كلّنا هنا لأجلكِ

86
00:07:29,370 --> 00:07:31,050
سنحميكِ

87
00:07:31,960 --> 00:07:38,340
يا حبيبتنا العزيزة، يا من لا نظير لها

88
00:07:42,560 --> 00:07:44,320
ألا تعتقدين أنّ هذا قاسٍ؟

89
00:07:44,320 --> 00:07:46,730
هانا-تشان-سينباي، هل أنتِ خرقاء؟

90
00:07:46,730 --> 00:07:49,570
ما هذا؟ ماذا تظنِّين نفسكِ فاعلة؟

91
00:07:49,570 --> 00:07:50,320
،أتعلمين

92
00:07:51,040 --> 00:07:56,330
أنتِ السّببُ بانضمامي إلى اللّجنة التنفيذيّة
على نحوٍ غير لائق

93
00:07:59,600 --> 00:08:05,460
لكن ليس عدلاً أن تخلدي إلى النوم

94
00:08:07,040 --> 00:08:10,050
عليكِ أن تتحمّلي مسؤوليّة

95
00:08:10,050 --> 00:08:13,470
إخراجي من عالمي أحادي اللَّون

96
00:08:19,330 --> 00:08:20,520
استيقظي

97
00:08:20,980 --> 00:08:24,020
أنا مستعدٌّ لفعلِ أي شيء كي تستيقظي فقط

98
00:08:24,450 --> 00:08:27,440
أنا مستعدٌّ أن ألعب بينغ بونغ بحذاء
أو أمارس تمارين قرفصان قصبة الخيزران

99
00:08:27,440 --> 00:08:29,140
أنا مستعدٌّ لأكلِ الجزر لأجلكِ

100
00:08:29,140 --> 00:08:31,530
ومستعدٌّ حتّى أن آكل جزرة نيّئة كاملة

101
00:08:31,530 --> 00:08:35,280
لا أمانع ألّا آكل سوى الجزر طوال حياتي

102
00:08:38,480 --> 00:08:39,540
رين

103
00:08:42,190 --> 00:08:45,840
هانا-تشان-سينباي، ما العالم الذي أنتِ فيه الآن؟

104
00:08:45,840 --> 00:08:49,940
هل هو مليء بالألوانِ المتألِّقة الرَّائعة؟

105
00:08:49,940 --> 00:08:50,920
هيّا

106
00:08:51,410 --> 00:08:52,670
عودي

107
00:08:53,090 --> 00:08:59,110
أنا متأكّدٌ أنَّ هذا العالم أكثر روعة بكثير

108
00:09:04,290 --> 00:09:09,780
آيغاساكي-سان، هنالك الكثير من الأشياء
التي أودُّ أن أقولها لكِ

109
00:09:09,780 --> 00:09:13,320
لكن قد لا أتمكَّن من التعبير عنها بشكلٍ جيّد

110
00:09:14,100 --> 00:09:19,320
كنتُ وحيداً في مكانٍ مظلمٍ إلى أن التقيتُ بكِ

111
00:09:19,810 --> 00:09:23,290
،كان تيكا هناك لأجلي عندما كنتُ صغيراً

112
00:09:23,290 --> 00:09:25,330
لكن حينها لم نعُد نستطيع أن نلعب معاً

113
00:09:25,330 --> 00:09:31,420
اعتدتُ على حياةِ الوحدة

114
00:09:32,450 --> 00:09:36,840
لكنّكِ أنرتِ عالمي

115
00:09:38,050 --> 00:09:41,600
.شكراً لكِ. أنتِ مهمّة

116
00:09:41,600 --> 00:09:43,100
مهمّة جدّاً

117
00:09:44,850 --> 00:09:48,150
لستِ وحيدة

118
00:09:49,060 --> 00:09:51,720
فنحن معكِ

119
00:09:55,890 --> 00:10:01,130
.آيغاساكي، لقد غيّرتِني. أنقذتِني

120
00:10:01,710 --> 00:10:06,000
أخرجتِني من الظلمات إلى النُّور

121
00:10:06,890 --> 00:10:08,750
...تِلك الكلمات التي قلتِها لي آنذاك

122
00:10:09,190 --> 00:10:11,500
...أنا... أنا

123
00:10:13,040 --> 00:10:15,630
!أحبُّ غناءك يا إتشيجوجي-كن

124
00:10:16,320 --> 00:10:18,630
لن أنساها ما حييت

125
00:10:18,900 --> 00:10:23,510
مُذ كنتُ طفلاً وأنا أتلقّى مديحاً
من أخوَيّ على الدَّوام

126
00:10:25,230 --> 00:10:31,400
لكنّهما قالا أنّني كنتُ جيّداً في الغناء
أو أنَّ غنائي كان مدهشاً

127
00:10:32,100 --> 00:10:35,530
أنتِ الوحيدةُ التي قالَتْ أنّكِ تحبِّينه

128
00:10:36,270 --> 00:10:39,860
اللِّقاء بكِ قد غيّرَني

129
00:10:46,870 --> 00:10:50,040
هذه المرّة، أنا من يريد أن ينقذكِ

130
00:10:50,680 --> 00:10:51,570
أجل

131
00:10:52,190 --> 00:10:56,880
أنا مستعدٌّ للتخلِّي عن أي شيء مُقابل إيقاظكِ

132
00:10:57,460 --> 00:11:00,120
،إذا كانت هذه مشيئة الربّ

133
00:11:00,120 --> 00:11:04,390
فلا أمانع حتّى ألّا أراكِ ثانية

134
00:11:05,410 --> 00:11:07,640
...ما دمتِ ستكونين سعيدة

135
00:11:15,790 --> 00:11:18,740
آيغاساكي، ماذا عسايّ أن أفعل؟

136
00:11:19,320 --> 00:11:21,280
كيف أنقذكِ؟

137
00:11:21,960 --> 00:11:24,780
كيف يا آيغاساكي؟

138
00:11:25,140 --> 00:11:26,210
آيغاساكي

139
00:11:29,470 --> 00:11:30,470
كوهانا

140
00:12:24,080 --> 00:12:26,390
أحبُّ هذه الأغنية

141
00:12:36,100 --> 00:12:37,240
!آيغاساكي

142
00:12:40,050 --> 00:12:42,390
ماجيك-كيون لأجلِك

143
00:12:44,640 --> 00:12:47,110
ماجيك-كيون! نهضة

144
00:12:49,250 --> 00:12:51,540
...تقول أنَّ الفنون السحريّة

145
00:12:51,860 --> 00:12:54,830
ستصِلُ إلى قلب هانا-تشان-سينباي؟

146
00:12:54,830 --> 00:12:55,290
أجل

147
00:12:55,600 --> 00:12:57,370
بالطبع

148
00:12:57,370 --> 00:13:00,580
زهرتي الصّغيرة هي ساقية البريق

149
00:13:00,580 --> 00:13:02,550
الكلام لا ينفع إذاً

150
00:13:02,930 --> 00:13:06,100
سننقلُ مشاعرنا باستخدامِ الفنون السحريّة

151
00:13:06,100 --> 00:13:07,220
أجل

152
00:13:08,540 --> 00:13:09,930
أنتم

153
00:13:10,260 --> 00:13:11,930
لنعقد جلسةً فنِّية

154
00:13:12,390 --> 00:13:16,940
لنعقد أعظم جلسة يمكننا عقدها لأجلِ آيغاساكي

155
00:15:08,560 --> 00:15:11,000
شخصيّتي

156
00:15:13,750 --> 00:15:18,600
ظننتُ أنَّه كان عليّ استخدام فنون سحريّة

157
00:15:19,250 --> 00:15:24,110
لكن حتّى لو أصبحتُ عاجزة عن تصفيفِ الزهور
أو لم أستطع أن أصبح مثل أمِّي

158
00:15:24,510 --> 00:15:26,150
أبقى أنا

159
00:15:26,560 --> 00:15:31,280
مهما فعلتُ أو أينما كنت، أبقى أنا

160
00:16:19,960 --> 00:16:21,960
إنِّي أسمع أصواتكم

161
00:16:22,370 --> 00:16:23,580
آنجو-سينباي

162
00:16:23,850 --> 00:16:24,830
كاناتو-كن

163
00:16:25,270 --> 00:16:26,080
تسوكوشي-كن

164
00:16:26,450 --> 00:16:27,590
تاتيواكي-سينباي

165
00:16:27,940 --> 00:16:28,600
أوي-كن

166
00:16:29,280 --> 00:16:30,340
تيكا-كن

167
00:16:30,820 --> 00:16:31,970
شكراً لكم

168
00:17:36,410 --> 00:17:38,530
!عيد هالوين سعيد

169
00:17:38,850 --> 00:17:40,530
خدعة أم حلوى

170
00:17:41,960 --> 00:17:43,840
هنالك الكثير من السكاكر

171
00:17:44,690 --> 00:17:46,860
سينباي، أريدُ القليل أيضاً

172
00:17:45,890 --> 00:17:46,860
رائع

173
00:17:46,860 --> 00:17:49,680
هيبيكي، حصلتَ للتو على بعض السكاكر

174
00:17:49,680 --> 00:17:54,050
!هذا ممتع. هذا مسلٍّ. هذا مثير

175
00:17:50,970 --> 00:17:54,050
خدعة أم حلوى

176
00:17:54,600 --> 00:17:57,300
اهدأوا جميعاً

177
00:17:57,300 --> 00:17:59,930
لا تنسوا أدواركم كأعضاء في اللّجنة التنفيذيّة

178
00:18:00,740 --> 00:18:01,680
آسفة

179
00:18:01,680 --> 00:18:04,280
عمّاذا تتكلّم يا إتشيجوجي؟

180
00:18:04,280 --> 00:18:07,350
إنّه الهالوين، من الطبيعي أن نحتفل

181
00:18:07,590 --> 00:18:10,060
ينبغي أن تستمتع اللّجنة أيضاً

182
00:18:10,060 --> 00:18:12,730
إتشيجوجي-سينباي، أنتَ لا تحتفل بما يكفي على الأقلّ

183
00:18:13,040 --> 00:18:15,270
هيّا يا جورجي

184
00:18:15,270 --> 00:18:17,390
لِمَ لا تحتفل معنا؟

185
00:18:17,390 --> 00:18:17,990
ماذا؟

186
00:18:25,370 --> 00:18:27,240
الحلقة صفر
تاكوياكي مرّيخية

187
00:18:27,640 --> 00:18:30,250
أليس هذا أكبر من السّابق؟

188
00:18:30,710 --> 00:18:32,830
إنّه أنيق جدّاً

189
00:18:33,970 --> 00:18:36,010
لنُلهب الأجواء بالاستعراض

190
00:18:36,010 --> 00:18:37,590
لنفعل ما بوسعنا

191
00:18:37,590 --> 00:18:38,610
!نعم

192
00:18:38,610 --> 00:18:40,810
بورك عملكم يا شباب. هذه لكم

193
00:18:40,810 --> 00:18:41,890
شكراً

194
00:18:42,240 --> 00:18:45,810
بالتأكيد. فالجميع يحبُّون كريب اليقطين الخاصّ بنا

195
00:18:46,550 --> 00:18:47,770
أهلاً وسهلاً

196
00:18:48,090 --> 00:18:50,900
هل استعراض الملابس مُتاح للجميع؟

197
00:18:50,900 --> 00:18:52,310
أجل

198
00:18:53,060 --> 00:18:54,480
نتمنّى انضمامكم

199
00:18:54,700 --> 00:18:57,860
!أمّي

200
00:18:58,450 --> 00:19:00,360
لا تقلقي

201
00:19:00,750 --> 00:19:01,670
تفضّلي

202
00:19:05,880 --> 00:19:06,910
فراشات

203
00:19:06,910 --> 00:19:08,120
أجل، يمكنكِ أخذها

204
00:19:08,440 --> 00:19:09,920
شكراً

205
00:19:11,680 --> 00:19:12,630
جميلة للغاية

206
00:19:13,250 --> 00:19:15,450
هذا مذهل

207
00:19:15,450 --> 00:19:18,000
،لم تستيقظ من نومها العميق فحسب

208
00:19:18,000 --> 00:19:19,790
بل استطاعَتْ أن تنتج هذا الضوء الجميل

209
00:19:20,960 --> 00:19:22,640
لم يعد هنالك ما يُقلِق بعد الآن

210
00:19:23,780 --> 00:19:26,140
أتطلّعُ قُدماً للمستقبل

211
00:19:28,620 --> 00:19:32,150
سيبدأ استعراض الهالوين الآن

212
00:19:32,530 --> 00:19:34,530
آنجيلو، سيبدأ

213
00:19:34,530 --> 00:19:36,150
ماذا؟ الآن؟

214
00:19:36,150 --> 00:19:38,030
بسرعة، بسرعة

215
00:19:38,380 --> 00:19:40,030
رين رين، انتظر

216
00:19:41,690 --> 00:19:44,450
مضى يوم المهرجان بلمح البصر

217
00:19:44,450 --> 00:19:47,410
مع أنَّنا قضينا وقتاً طويلاً نحضِّرُ له

218
00:19:47,410 --> 00:19:49,300
لماذا أنت جادٌّ هكذا؟

219
00:19:49,300 --> 00:19:52,040
لأنَّنا سنتخرَّج

220
00:19:52,040 --> 00:19:54,530
كم حدثاً سنتمكّنُ من القيامِ به؟

221
00:19:54,530 --> 00:19:57,070
نفس الأمر ينطبقُ علينا

222
00:19:57,070 --> 00:19:59,840
قد يتمّ اختيارنا لِلَّجنة مجدّداً في العام المقبل

223
00:19:59,840 --> 00:20:00,980
...لكن

224
00:20:00,980 --> 00:20:04,050
ليس بهؤلاء الأعضاء

225
00:20:05,750 --> 00:20:08,720
هذه هي المرّة الوحيدة التي اجتمعنا فيها نحن الستّة معاً

226
00:20:08,720 --> 00:20:10,060
،بأعضاء لجنة مختلفين

227
00:20:10,400 --> 00:20:12,740
لن تكون الأحداث والنشاطات نفسها

228
00:20:12,740 --> 00:20:15,490
الحاضر ثمينٌ حقّاً، أليس كذلك؟

229
00:20:15,490 --> 00:20:19,650
أوقات ثمينة، أصدقاء مهمّون

230
00:20:19,650 --> 00:20:22,960
جمعَتْنا آيغاساكي-سينباي معاً

231
00:20:22,960 --> 00:20:28,100
مدَّتْنا آيغاساكي-سان بالشجاعةِ لنخطو الخطوة الأولى

232
00:20:28,100 --> 00:20:32,930
وعلّمَتْنا كيف نُؤمن بأنفسنا

233
00:20:32,930 --> 00:20:34,920
إنَّها معجزة، أليس كذلك؟

234
00:20:34,920 --> 00:20:40,810
ينبغي أن نثمِّنَ كلّ لحظة قضيناها معاً

235
00:20:40,810 --> 00:20:43,680
معك حقّ، علينا أن نستمتع بها

236
00:20:43,680 --> 00:20:47,410
هيّا بنا، آيغاساكي تنتظرنا

237
00:20:47,410 --> 00:20:48,400
!نعم

238
00:20:49,940 --> 00:20:54,310
ستبدأ مسرحيّة حدث هوشيغي قريباً

239
00:20:54,770 --> 00:20:56,010
حان الوقتُ تقريباً

240
00:20:56,010 --> 00:20:56,560
نعم

241
00:20:56,960 --> 00:20:58,690
أحسُّ بشعور رائع

242
00:20:58,910 --> 00:21:01,440
سنكون معاً للأبد، صحيح؟

243
00:21:01,690 --> 00:21:04,570
هنالك الكثير من الأشياء التي نريدُ فعلها

244
00:21:05,000 --> 00:21:08,200
لنصنع كثيراً من الذكرياتِ الممتعة

245
00:21:08,770 --> 00:21:12,080
لنُضحكهم ونُبكِهم بملء قلوبهم

246
00:21:12,420 --> 00:21:15,580
سنبدأ باستعراض "الحسناء النّائمة" هذا

247
00:21:16,020 --> 00:21:19,840
نعم، أنا متأكّدةٌ أنَّنا سننجح

248
00:21:27,380 --> 00:21:29,350
والآن يا أميرة

249
00:21:31,020 --> 00:21:32,800
تفضّلي

250
00:23:03,530 --> 00:23:05,390
بورك عملُكم جميعاً

251
00:23:05,390 --> 00:23:07,120
بورك عملكِ

252
00:23:07,120 --> 00:23:09,040
كان ذلك ممتعاً

253
00:23:09,040 --> 00:23:10,410
ماذا سنفعل الآن؟

254
00:23:10,410 --> 00:23:13,240
أريد الاحتفال بعيد الميلاد المجيد معاً

255
00:23:13,240 --> 00:23:15,020
!فكرة سديدة

256
00:23:15,020 --> 00:23:16,700
كعكة عيد ميلاد مجيد؟

257
00:23:16,700 --> 00:23:18,190
هذا شيء يستحقُّ تحضيره

258
00:23:18,190 --> 00:23:21,010
لنقرِّر في اجتماعِ لجنتنا القادم

259
00:23:21,280 --> 00:23:22,570
!حسناً