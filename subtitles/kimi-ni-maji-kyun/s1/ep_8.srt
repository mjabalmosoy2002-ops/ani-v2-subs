1
00:00:08,880 --> 00:00:10,140
أنا أغرق

2
00:00:12,220 --> 00:00:15,130
أعمق وأعمق

3
00:00:20,100 --> 00:00:23,560
أنت مغنٍّ رائع يا تيكا-كن

4
00:00:23,560 --> 00:00:28,830
لطالما تميّزت عائلة إتشيجوجي بأنّها
عائلة مغنّيين منذُ عصر هيان

5
00:00:28,830 --> 00:00:32,800
تقاليدنا التي أفسدَتْها حركة ميجي التّصحيحيّة
تعودُ إلى الحياةِ الآن

6
00:00:35,440 --> 00:00:39,020
يجبُ أن تكرّس نفسك للغناء لأجل عائلة إتشيجوجي

7
00:00:39,020 --> 00:00:40,810
نتوقّعُ منك أموراً رائعة يا تيكا

8
00:00:41,160 --> 00:00:42,060
حسناً

9
00:00:42,380 --> 00:00:44,680
أحبُّ الغناء

10
00:00:46,260 --> 00:00:49,070
لماذا لا أستطيع التنفُّس؟

11
00:00:54,790 --> 00:00:58,020
لماذا؟

12
00:01:23,770 --> 00:01:30,140
!ماجيك-كيون نهضة

13
00:02:45,940 --> 00:02:48,520
بقي أسبوعان فقط على بدء مهرجان هوشي

14
00:02:53,680 --> 00:02:55,860
!إنّه الصّيف. جاء الصّيف

15
00:02:56,820 --> 00:02:58,080
بورك عملكم جميعاً

16
00:02:58,080 --> 00:03:00,260
بورك عملك

17
00:03:00,260 --> 00:03:02,020
الطقس حارٌّ جدّاً

18
00:03:02,020 --> 00:03:04,960
مكيّف الهواء داخل الخيمة لم يكن يعملُ بعد

19
00:03:04,960 --> 00:03:06,340
سيزدادُ الطقس حرّاً

20
00:03:06,340 --> 00:03:08,040
بدأنا بارتداءِ ملابسنا الصيفيّة

21
00:03:08,420 --> 00:03:11,920
على أي حال، النّاس في مُحيط المدرسة بدأوا يتحمّسون

22
00:03:11,920 --> 00:03:14,460
الجميع يعشقُ النجوم التي صنعتها يا رين رين

23
00:03:14,460 --> 00:03:16,000
شكراً

24
00:03:16,000 --> 00:03:19,020
لا أمانع أن تكون الأجواء حول المدرسة هكذا

25
00:03:19,360 --> 00:03:22,570
أشعرُ وكأنّ المهرجان قد بدأ أخيراً

26
00:03:22,570 --> 00:03:25,380
ستكونُ الأمور أفضل من المتوقَّع

27
00:03:25,380 --> 00:03:27,930
الجميع في صفوفي متحمّسون أيضاً

28
00:03:28,450 --> 00:03:30,680
بذلنا مجهوداً كبيراً حقّاً

29
00:03:31,060 --> 00:03:31,760
نعم

30
00:03:31,760 --> 00:03:34,190
ولماذا تقولها بصيغة الماضي؟

31
00:03:35,620 --> 00:03:37,910
الفترة الأهمّ هي الآن

32
00:03:37,910 --> 00:03:39,190
لقد استرخيتُم زيادة عن اللّزوم

33
00:03:39,900 --> 00:03:41,450
آ-آسفة

34
00:03:42,060 --> 00:03:46,880
ولأنّ تاتيواكي-سينباي غيّرَ اختصاصه من النّحت
إلى الخَبز

35
00:03:46,880 --> 00:03:49,080
فقد تغيّرت جلسة الفنّ كذلك

36
00:03:51,230 --> 00:03:52,580
لا وقت للاحتفال

37
00:03:55,040 --> 00:03:57,790
أنت قاسٍ دوماً يا جورجي

38
00:03:57,790 --> 00:03:59,010
لا تقلق

39
00:03:59,010 --> 00:04:00,990
سنواظبُ على عملنا حتّى بدء المهرجان

40
00:04:00,990 --> 00:04:04,340
معك حقّ. هل نتمرّن مجدّداً اليوم؟

41
00:04:04,790 --> 00:04:09,050
نعم، تلقّينا إذناً بتفقُّد خيمة الحدث الخاصّ

42
00:04:09,050 --> 00:04:10,330
لنذهب ونلقِ نظرة

43
00:04:10,330 --> 00:04:11,350
حسناً

44
00:04:13,940 --> 00:04:15,350
تيكا

45
00:04:15,640 --> 00:04:18,480
هل تنام ما يكفي من ساعات؟

46
00:04:19,110 --> 00:04:20,810
عمّاذا تتكلّم؟

47
00:04:20,810 --> 00:04:23,270
لم أرك في الصّباح أبداً

48
00:04:23,840 --> 00:04:26,050
لقد اقترب مهرجان هوشي

49
00:04:26,050 --> 00:04:27,490
ما باليدِ حيلة الآن

50
00:04:28,930 --> 00:04:29,990
حسناً

51
00:04:31,850 --> 00:04:33,500
أهذه هي خيمة الحدث الخاصّ؟

52
00:04:33,920 --> 00:04:36,710
أشعرُ حقّاً وكأنّ يوم الحادِثة قد اقترب

53
00:04:36,710 --> 00:04:38,250
!أنا أشتعلُ حماساً الآن

54
00:04:38,780 --> 00:04:42,610
سنبدأ بتفقُّد أماكننا خلال جلسة الفنّ

55
00:04:42,610 --> 00:04:43,790
حسناً

56
00:04:45,630 --> 00:04:47,010
آيغاساكي

57
00:04:47,380 --> 00:04:48,260
هيّا بنا

58
00:04:50,680 --> 00:04:51,770
حسناً

59
00:04:55,410 --> 00:04:59,670
يصبح الأمر عجيباً حقّاً عندما تجمعُ
أضواء الفنّانين السّبعة معاً

60
00:04:59,670 --> 00:05:01,910
هل توحّدت قلوبنا الآن؟

61
00:05:01,910 --> 00:05:03,310
لا أقول أنّها لم تتوحّد

62
00:05:03,760 --> 00:05:06,930
يعزو الفضلُ لقرفصاء قصبات الخيزران

63
00:05:06,930 --> 00:05:08,050
قصبات الخيزران؟

64
00:05:08,050 --> 00:05:10,210
إنّها حكاية طويلة

65
00:05:10,210 --> 00:05:13,440
كلّ بريقكم يسطع بشكلٍ مُبهر

66
00:05:13,440 --> 00:05:16,530
لنستمرّ في هذا إلى أن يحين الأداء الفعليّ

67
00:05:16,530 --> 00:05:18,850
لا داعي للقلق، أنا متأكّدةٌ أنّنا سننجح

68
00:05:29,380 --> 00:05:35,180
واحد، اثنان، ثلاثة

69
00:05:35,180 --> 00:05:37,520
نعم هكذا، أنتِ جيّدة

70
00:05:38,430 --> 00:05:40,020
عظيم، تابعي

71
00:05:42,400 --> 00:05:45,230
كان ذلك ممتازاً يا زهرتي الصّغيرة

72
00:05:45,230 --> 00:05:46,590
أحسنتِ صنعاً

73
00:05:46,590 --> 00:05:48,030
شكراً لك

74
00:05:48,460 --> 00:05:51,280
والآن أصبحتُ جاهزة تماماً لحفلةِ الرّقص

75
00:05:52,620 --> 00:05:55,090
،زهرتي الصّغيرة

76
00:05:55,090 --> 00:05:57,940
هلّا كنتِ شريكتي في الرّقصةِ الأخيرة؟

77
00:05:57,940 --> 00:05:58,500
ماذا؟

78
00:06:02,050 --> 00:06:04,000
أريدُ أن أرقص معكِ

79
00:06:04,320 --> 00:06:06,510
...المعذرة

80
00:06:06,720 --> 00:06:09,040
آنجيلو، رقصتَ معها كثيراً سابقاً

81
00:06:09,040 --> 00:06:10,690
ألم تشبع؟

82
00:06:10,690 --> 00:06:11,510
رين رين

83
00:06:12,250 --> 00:06:16,560
آيغاساكي، ارقصي معي أثناء الرّقصة الأخيرة

84
00:06:16,560 --> 00:06:18,140
كوني شريكتي

85
00:06:18,140 --> 00:06:18,840
ماذا؟

86
00:06:18,840 --> 00:06:21,230
رين رين، لا تتدخّل

87
00:06:21,230 --> 00:06:23,170
لقد بدأت بداية خاطئة يا آنجيلو

88
00:06:23,170 --> 00:06:25,010
ينبغي أن يكون قراراً مُنصِفاً

89
00:06:25,010 --> 00:06:26,400
سينباي

90
00:06:26,400 --> 00:06:28,500
هلّا رقصتِ معي الرّقصة الأخيرة؟

91
00:06:28,500 --> 00:06:29,350
ماذا؟

92
00:06:29,350 --> 00:06:30,500
أنا متأكّدٌ أنّنا سنستمتع

93
00:06:30,500 --> 00:06:31,920
كاناتو-كن، أنت أيضاً؟

94
00:06:31,920 --> 00:06:33,410
مستحيل يا هيبيكي

95
00:06:33,680 --> 00:06:36,990
سترقص هاتا-تشان-سينباي معي أنا

96
00:06:38,110 --> 00:06:39,380
أليس كذلك يا سينباي؟

97
00:06:39,380 --> 00:06:40,260
هانا-تشان؟

98
00:06:40,260 --> 00:06:41,780
انتظر لحظة يا تسوكوشي

99
00:06:41,780 --> 00:06:43,290
لا تمانعين، صحيح؟

100
00:06:43,290 --> 00:06:46,810
أنتُما طالبا سنة أولى

101
00:06:46,810 --> 00:06:48,700
يمكنُكما الرّقص معها في السنة المُقبلة

102
00:06:48,700 --> 00:06:49,360
نعم

103
00:06:49,880 --> 00:06:52,050
لستُما جاهزين لرقصةٍ أخيرة

104
00:06:52,300 --> 00:06:54,450
لا تستهينا بنا

105
00:06:54,450 --> 00:06:56,810
الرّقصة الأخيرة مهمّةٌ لنا أيضاً

106
00:06:57,230 --> 00:07:00,410
هذه آخر رقصة لنا في المدرسة الثانويّة

107
00:07:00,410 --> 00:07:02,550
أهي كذلك حقّاً؟

108
00:07:02,550 --> 00:07:04,370
قد تبقى هُنا في العام المقبل

109
00:07:04,370 --> 00:07:05,370
!مهلاً

110
00:07:05,370 --> 00:07:06,820
ينبغي أن يكون أنا إذاً

111
00:07:06,820 --> 00:07:09,170
لكن هذا العام لن يتكرّر مرّة أخرى

112
00:07:09,170 --> 00:07:10,820
لدى الجميع رقصة واحدة فقط

113
00:07:10,820 --> 00:07:12,180
،على أي حال

114
00:07:12,180 --> 00:07:14,900
سأرقصُ الرّقصة الأخيرة مع زهرتي الصّغيرة

115
00:07:14,900 --> 00:07:15,760
لا، أنا

116
00:07:15,760 --> 00:07:16,320
أنا

117
00:07:16,320 --> 00:07:17,490
بل أنا

118
00:07:17,490 --> 00:07:20,330
لماذا تصرخون؟

119
00:07:20,330 --> 00:07:23,580
...أوي-كن، بخصوص الرّقصة الأخيرة

120
00:07:23,910 --> 00:07:27,090
آيغاساكي، هلّا رقصتِ معي؟

121
00:07:27,090 --> 00:07:28,590
ماذا؟

122
00:07:28,850 --> 00:07:31,660
حقّاً؟ هنالك المزيد؟

123
00:07:31,660 --> 00:07:33,590
حسناً. كيف سنعالج هذه المسألة؟

124
00:07:34,000 --> 00:07:36,730
لا يهمّني من يتحدّاني

125
00:07:36,730 --> 00:07:38,270
سأكون أنا مهما حدث

126
00:07:38,270 --> 00:07:39,280
لا أظنُّ ذلك

127
00:07:39,280 --> 00:07:42,100
،لكن إذا زدنا الأمر حيرة

128
00:07:42,370 --> 00:07:44,550
أظنُّ أنّ سينباي ستفقدُ صوابها

129
00:07:44,550 --> 00:07:47,610
لماذا؟ لماذا؟ لماذا؟

130
00:07:49,320 --> 00:07:50,530
لا نملك خياراً

131
00:07:50,530 --> 00:07:52,360
سيتوجّبُ علينا عقد هدنة الآن

132
00:07:52,360 --> 00:07:54,030
لا نريد أحداً أن يغدر بالآخرين ويفعلها

133
00:07:55,360 --> 00:07:58,160
بالمناسبة، أين جورجي-سينباي؟

134
00:07:58,440 --> 00:08:00,420
ربّما يتدرّبُ بمفرده

135
00:08:00,420 --> 00:08:01,360
يتدرّب؟

136
00:08:01,360 --> 00:08:02,660
ماذا؟ ألا تعلم؟

137
00:08:03,020 --> 00:08:05,170
يذهبُ للركض طوال الوقت

138
00:08:06,640 --> 00:08:09,140
ما زال يتمرّن رُغم براعته؟

139
00:08:09,140 --> 00:08:12,230
إنّه يُتقِن الإتقان

140
00:08:12,230 --> 00:08:14,050
لهذا هو الملِك

141
00:08:14,370 --> 00:08:17,340
،لطالما كان شخصاً رصيناً

142
00:08:17,340 --> 00:08:19,600
لكنّه ازداد رصانة أكثر فأكثر مؤخّراً

143
00:08:19,600 --> 00:08:22,560
أشعر أنّه يبالغ في ذلك أحياناً

144
00:08:28,640 --> 00:08:31,710
اقترب مهرجان هوشي، أليس كذلك؟

145
00:08:31,710 --> 00:08:32,570
نعم

146
00:08:32,570 --> 00:08:36,820
أنا متحمّسة جدّاً لجلستِكم الفنّية

147
00:08:36,820 --> 00:08:38,790
جوري-تشان، أتديرين مقهى مسرحي؟

148
00:08:38,790 --> 00:08:40,510
نعم، هذا صحيح

149
00:08:40,510 --> 00:08:41,760
ما طبيعته؟

150
00:08:41,760 --> 00:08:43,940
ستكتشفين عندما تأتين

151
00:08:43,940 --> 00:08:45,000
!سآتي حتماً

152
00:08:53,270 --> 00:08:54,850
إتشيجوجي-كن

153
00:08:57,090 --> 00:08:58,970
آمل أن يكون بخير

154
00:09:03,480 --> 00:09:05,600
على غير العادة

155
00:09:05,600 --> 00:09:08,560
لم أرَ الملك يمسحُ العرق عن جبينه من قبل

156
00:09:09,170 --> 00:09:10,750
لطالما كان إتشيجوجي-كن الأكثر مواظبة

157
00:09:10,750 --> 00:09:13,490
على التمرُّنِ للجلسةِ الفنّية مقارنة بنا

158
00:09:13,490 --> 00:09:17,410
حقّاً؟ أعتقدُ أنّه يتحمّلُ مسؤوليةً كبيرة

159
00:09:22,180 --> 00:09:27,000
أتساءل لماذا يبدو إتشيجوجي-كن متألّماً كثيراً أحياناً

160
00:09:29,250 --> 00:09:32,250
بقي يوم واحد

161
00:09:30,080 --> 00:09:32,250
بقي يوم على بدءِ مهرجان هوشي

162
00:10:04,660 --> 00:10:08,420
لم أركما منذُ مدّة طويلة يا ماسانا-نيسان وشينرا-نيسان

163
00:10:08,750 --> 00:10:09,760
نعم

164
00:10:09,760 --> 00:10:12,170
أصبحتَ أطول يا تيكا-كن

165
00:10:14,560 --> 00:10:17,050
إنّهما أخوا إتشيجوجي

166
00:10:17,050 --> 00:10:18,720
إنّهما نادران جدّاً

167
00:10:18,720 --> 00:10:20,930
ذلكما أخوا إتشيجوجي-كن؟

168
00:10:21,140 --> 00:10:21,910
نعم

169
00:10:21,910 --> 00:10:25,780
كلاهما وصيّان مهمّان للمدرسة

170
00:10:25,780 --> 00:10:27,180
أخواه؟

171
00:10:35,570 --> 00:10:37,940
جاء غداً أخيراً يا تيكا-كن

172
00:10:37,940 --> 00:10:40,090
نعم يا شينرا-نيسان

173
00:10:40,090 --> 00:10:42,400
ما أخبار الجلسة الفنّية؟

174
00:10:42,400 --> 00:10:44,140
هل ستسيرُ بسلاسةٍ باعتقادك؟

175
00:10:44,140 --> 00:10:44,950
بالطبع

176
00:10:45,300 --> 00:10:50,710
لن تتفوّق فتاة آيغاساكي عليك ببريقها، أليس كذلك؟

177
00:10:51,910 --> 00:10:52,960
بالطبع لا

178
00:10:53,550 --> 00:10:59,560
تيكا-كن، ستكونُ أوّل من يُدخِل شركة إتشيجوجي
للترفيه في السُّوق العالميّة

179
00:11:00,360 --> 00:11:05,210
كان التّدريب الخاصّ الذي تتلقّاه لأجلِ تحقيق هذا الهدف

180
00:11:07,250 --> 00:11:11,480
النّجاح في الجلسةِ الفنّية سيقودُك إلى لقب
أمير الأرتيستا

181
00:11:13,580 --> 00:11:15,100
،قد تكون واثقاً

182
00:11:15,100 --> 00:11:17,030
لكن يجبُ أن تبقى يقظاً

183
00:11:17,030 --> 00:11:20,240
لا تخيّب أملنا

184
00:11:22,080 --> 00:11:23,740
أعلم

185
00:11:29,870 --> 00:11:30,740
تيكا

186
00:11:33,750 --> 00:11:38,260
هل قال أخواك شيئاً لك مجدّداً؟

187
00:11:39,920 --> 00:11:41,660
هذا ليس من شأنك

188
00:11:42,190 --> 00:11:44,440
أشعرُك أحياناً بالكاد تستطيع أن تتنفّس

189
00:11:45,510 --> 00:11:47,570
،لطالما كنتَ كذلك

190
00:11:47,570 --> 00:11:54,180
...لكن مُذ كادَ تاتيواكي-سينباي أن يُقصى

191
00:11:54,180 --> 00:11:56,950
،كعضو في عائلة إتشيجوجي

192
00:11:56,950 --> 00:11:59,020
كرّستُ كلّ كياني للغناء

193
00:11:59,780 --> 00:12:01,530
لا يوجدُ ما هو صعب أو مؤلم في ذلك

194
00:12:07,470 --> 00:12:12,890
بعد اللِّقاء بآيغاساكي-سان، تغيّرت

195
00:12:13,410 --> 00:12:15,170
وكذلك أنت يا تيكا

196
00:12:15,640 --> 00:12:17,340
لا علاقة لآيغاساكي بهذا الأمر

197
00:12:17,770 --> 00:12:19,970
أنا أغنّي الأغاني الخاصّة بي ببساطة

198
00:12:21,760 --> 00:12:22,840
تيكا

199
00:12:27,640 --> 00:12:29,280
لم تفهم

200
00:12:58,340 --> 00:13:03,260
نورها نقيّ جدّاً ودافئ

201
00:13:17,810 --> 00:13:22,680
بعد اللِّقاء بآيغاساكي، تغيّرت

202
00:13:23,290 --> 00:13:25,030
وكذلك أنت يا تيكا

203
00:13:31,960 --> 00:13:34,660
لا تخيّب أملنا

204
00:13:47,890 --> 00:13:50,430
ماجيك-كيون لأجلِك

205
00:13:53,280 --> 00:13:54,400
ماجيك-كيون

206
00:13:54,740 --> 00:13:56,090
نهضة

207
00:13:58,250 --> 00:13:59,980
انتهيت

208
00:14:00,480 --> 00:14:03,480
انتهينا من التّحضيراتِ لمهرجان هوشي

209
00:14:03,480 --> 00:14:05,500
أنا متحمّسةٌ جدّاً ليوم غد

210
00:14:05,500 --> 00:14:07,680
لقد أصبحَ اليوم تقريباً

211
00:14:08,490 --> 00:14:10,720
لنحتفل

212
00:14:10,720 --> 00:14:12,240
!نعم

213
00:14:12,240 --> 00:14:14,240
ليوم غد

214
00:14:14,660 --> 00:14:17,000
!بصحّتكم

215
00:14:18,500 --> 00:14:20,090
لذيذ جدّاً

216
00:14:20,090 --> 00:14:21,940
كاناتو-كن، شكراً جزيلاً لك

217
00:14:21,940 --> 00:14:22,780
هذا جيّد

218
00:14:22,780 --> 00:14:25,260
كانت أعمالاً كثيرة، لكن اقتربَ الوقت

219
00:14:25,470 --> 00:14:26,410
أجل

220
00:14:26,410 --> 00:14:28,760
عشر ساعات إضافيّة؟

221
00:14:29,320 --> 00:14:30,760
أنا متوتّرةٌ للغاية

222
00:14:31,050 --> 00:14:33,260
مضى الوقت بسُرعة

223
00:14:34,370 --> 00:14:36,020
أنت أيضاً يا رين؟

224
00:14:36,020 --> 00:14:40,240
أنا متحمّسٌ للغاية لدرجة أنّني لا أستطيع النّوم

225
00:14:40,240 --> 00:14:42,560
هل نرقصُ طوال اللّيل إذاً؟

226
00:14:42,560 --> 00:14:44,120
لنرقص

227
00:14:46,780 --> 00:14:52,530
أنا مسرورةٌ لأنّنا سنعقدُ الجلسة الفنّية معاً

228
00:14:52,760 --> 00:14:54,340
آيغاساكي-سينباي؟

229
00:14:54,340 --> 00:14:56,040
ما هذا الكلام فجأة؟

230
00:14:56,690 --> 00:14:58,810
،عندما أتيتُ إلى هذه المدرسة أوّل مرّة

231
00:14:58,810 --> 00:15:04,380
رأيتُ العديد من الأشياء البرّاقة تنبعثُ من الآخرين

232
00:15:05,190 --> 00:15:08,420
كانَتْ تنتمي إليكم

233
00:15:20,590 --> 00:15:22,640
لم أكن أعلمُ ذلك

234
00:15:22,640 --> 00:15:24,610
هل هذا يعني أنّنا التقينا آنذاك فعليّاً؟

235
00:15:24,820 --> 00:15:30,360
لهذا تفاجأتُ عندما أدركتُ أنّه أنتم السّبعة
كنتُم في اللّجنة

236
00:15:30,360 --> 00:15:32,800
ربّما يكون القدر

237
00:15:32,800 --> 00:15:33,620
نعم

238
00:15:36,000 --> 00:15:40,480
لا أصدِّق أنّ الشّرارات الرّائعة التي رأيتُها
آنذاك قد اجتمعَتْ في مكانٍ واحد

239
00:15:40,480 --> 00:15:43,910
أو أنّ بريقي سيكون جزءاً من ذلك

240
00:15:43,910 --> 00:15:45,880
مجرّد التّفكير بالأمر يحمّسُني

241
00:15:46,420 --> 00:15:48,580
بريق؟

242
00:15:48,580 --> 00:15:52,130
يا زهرتي الصّغيرة، أنتِ ساقية البريق

243
00:15:52,340 --> 00:15:55,510
ماذا؟ ساقية البريق؟

244
00:15:55,510 --> 00:15:57,620
أعلم ما تعنيه

245
00:15:57,990 --> 00:16:01,600
سينباي، أنتِ أفضل من الآخرين في تعريف
وتقييم نور الآرتيستا

246
00:16:02,690 --> 00:16:04,150
أجل

247
00:16:04,150 --> 00:16:06,590
وكأنّكِ لديكِ حساسيّة خاصّة لها

248
00:16:06,590 --> 00:16:08,650
أو قدرة على تمييزها بدقّة

249
00:16:08,960 --> 00:16:11,810
القدرة على رؤية قوى الأشخاص

250
00:16:12,650 --> 00:16:13,640
نعم

251
00:16:13,640 --> 00:16:17,410
وحتّى أنّكِ ترين أشياء لا ندركها عن أنفسنا

252
00:16:17,410 --> 00:16:18,840
...ماذا؟ في الواقع

253
00:16:18,840 --> 00:16:21,100
نحن مُمتنُّون لما فعلتِه لأجلِنا

254
00:16:23,610 --> 00:16:25,290
...ماذا؟ لكنّني

255
00:16:25,680 --> 00:16:32,880
حقّقنا هذه الإنجازات بفضلكِ وبفضل
إتشيجوجي-سينباي بالطبع

256
00:16:34,530 --> 00:16:37,390
أظنُّ علينا شكر إتشيجوجي-سينباي على نجاحنا أيضاً

257
00:16:37,390 --> 00:16:39,440
معكِ حقّ

258
00:16:39,920 --> 00:16:43,390
صرامة تيكا هي التي جمعَتْنا معاً

259
00:16:43,770 --> 00:16:47,020
لكن تكون مزعجاً قليلاً أحياناً

260
00:16:47,020 --> 00:16:49,080
جورجي-سينباي، شكراً لك

261
00:16:49,830 --> 00:16:52,150
نعم. شكراً يا إتشيجوجي

262
00:16:55,660 --> 00:16:57,660
لا تسيئوا الفهم

263
00:16:57,660 --> 00:17:01,410
كلّ ما فعلتُه كان لأجلِ نجاحي أنا

264
00:17:02,540 --> 00:17:04,160
توقّعتُ أن تقول ذلك يا إتشيجوجي-سينباي

265
00:17:04,610 --> 00:17:06,920
لستَ صادقاً كثيراً

266
00:17:07,360 --> 00:17:09,000
إنّه كذلك دوماً

267
00:17:09,000 --> 00:17:11,420
معك حقّ

268
00:17:11,420 --> 00:17:14,250
طبعه لا يتغيّر

269
00:17:14,250 --> 00:17:16,180
يجدرُ بك أن تكون صادقاً أحياناً

270
00:17:16,180 --> 00:17:16,930
بالفعل

271
00:17:18,880 --> 00:17:21,900
الجلسة الفنّية الهامّة ستبدأ غداً

272
00:17:21,900 --> 00:17:23,860
ابقوا يقظين

273
00:17:23,860 --> 00:17:25,160
حسناً

274
00:17:25,810 --> 00:17:26,810
أراكم غداً

275
00:17:29,980 --> 00:17:30,900
تصبح على خير

276
00:17:30,900 --> 00:17:32,690
بورك عملك اليوم

277
00:17:41,920 --> 00:17:45,950
ما خطبُ إتشيجوجي-كن؟ هل هو بخير؟

278
00:17:55,930 --> 00:17:57,720
أين ذهب؟

279
00:18:01,340 --> 00:18:02,770
إتشيجوجي-كن؟

280
00:18:29,260 --> 00:18:30,540
جميلة

281
00:18:31,630 --> 00:18:34,460
لكن ما خطب هذا البريق؟

282
00:18:34,830 --> 00:18:37,050
إنّه حزينٌ جدّاً

283
00:18:54,030 --> 00:18:54,900
لماذا؟

284
00:19:16,340 --> 00:19:17,710
إتشيجوجي-كن

285
00:19:50,870 --> 00:19:51,870
!تيكا-كن

286
00:20:16,180 --> 00:20:18,650
لماذا تبكي؟

287
00:20:20,230 --> 00:20:23,660
كان بريقك حزيناً جدّاً

288
00:20:27,330 --> 00:20:29,120
هذه هي المرّة الثّالثة

289
00:20:29,120 --> 00:20:31,410
التي تأتين فيها بينما أتمرّن

290
00:20:32,090 --> 00:20:33,160
تتمرّن؟

291
00:20:34,860 --> 00:20:37,420
أتمرّن أكثر من أي شخص آخر

292
00:20:38,760 --> 00:20:41,460
يظنُّني الجميعُ أعجوبة

293
00:20:41,460 --> 00:20:45,180
لهذا لا أدع أحداً يراني وأنا أعملُ بجدّ

294
00:20:46,290 --> 00:20:47,720
هل أنت بخير؟

295
00:20:48,290 --> 00:20:49,060
ماذا تقصدين؟

296
00:20:49,520 --> 00:20:52,900
هل أنتَ متأكّدٌ أنّك لا تضغط على نفسِك كثيراً؟

297
00:20:53,660 --> 00:20:54,940
أنا قلقةٌ عليك

298
00:20:54,940 --> 00:20:57,940
لا داعي لتقلقي عليّ

299
00:20:57,940 --> 00:21:02,320
لماذا بريقك حزين جدّاً إذاً؟

300
00:21:05,130 --> 00:21:08,320
سأرتقي لتوقُّعات أخوَيّ

301
00:21:08,320 --> 00:21:09,940
سأصبح أمير الأرتيستا

302
00:21:10,230 --> 00:21:12,340
وأحسّن سمعة عائلة إتشيجوجي

303
00:21:12,920 --> 00:21:14,580
لهذا أغنّي

304
00:21:15,490 --> 00:21:17,630
لا يساورني أدنى شكّ

305
00:21:17,630 --> 00:21:20,090
لستُ أتألّم البتّة

306
00:21:26,560 --> 00:21:29,600
لذا لا داعي للقلق

307
00:21:30,010 --> 00:21:35,570
كلّ ما عليكِ هو البقاء تحت الأضواء

308
00:21:36,180 --> 00:21:36,850
...عفواً، أنا

309
00:21:47,410 --> 00:21:49,740
...أنا... أنا

310
00:21:51,780 --> 00:21:54,330
أحبُّ غناءك يا إتشيجوجي-كن

311
00:23:25,990 --> 00:23:29,090
،حتّى لو كنتَ تعيشُ ليلاً حزيناً أو صباحاً صعباً

312
00:23:29,550 --> 00:23:31,460
،ما دمنا نعملُ معاً

313
00:23:31,460 --> 00:23:33,680
فلا شيء نعجزُ عن التغلُّبِ عليه

314
00:23:33,680 --> 00:23:36,260
:الحلقة القادمة من ماجيك-كيون! نهضة

315
00:23:36,260 --> 00:23:38,550
"مهرجان المُعجزات والسّحر"

316
00:23:38,550 --> 00:23:39,980
!أنا واثقة أنّنا نستطيعُ فعلها