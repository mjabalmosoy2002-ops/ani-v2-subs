!هزيمة الأميرة بريكيور

304
00:18:11,970 --> 00:18:14,390
!زيتسبورغ

305
00:18:14,390 --> 00:18:16,260
!لن أخسر هنا

306
00:18:16,260 --> 00:18:17,610
!زيتسبورغ

307
00:18:17,610 --> 00:18:19,290
.اغتنمي هذه الفرصة واختبئي

308
00:18:19,290 --> 00:18:20,290
.حـ-حسناً

309
00:18:20,290 --> 00:18:21,540
!زيتسبورغ

310
00:18:24,130 --> 00:18:25,840
!زيتسبورغ

311
00:18:30,590 --> 00:18:32,150
!زيتسبورغ

312
00:18:43,690 --> 00:18:45,040
!ميرميد

313
00:18:45,040 --> 00:18:46,570
!دعينا ننهي هذا يا فلورا

314
00:18:46,570 --> 00:18:47,610
!حسناً

315
00:18:48,660 --> 00:18:50,390
!التبادل

316
00:18:50,650 --> 00:18:52,620
!الوضع الأنيق

317
00:19:08,580 --> 00:19:10,450
!التبادل

318
00:19:11,510 --> 00:19:13,240
!الوضع الأنيق

319
00:19:29,440 --> 00:19:32,150
!رقصة الزهور

320
00:19:32,410 --> 00:19:38,610
!بريكيور دوامة الأزهار

321
00:19:41,890 --> 00:19:44,270
...الحلم

322
00:19:51,660 --> 00:19:53,320
.طاب يومك

323
00:19:53,320 --> 00:19:55,650
!ارتفع يا أيها البحر

324
00:19:58,620 --> 00:20:03,130
!حورية بريكيور المتموجة

325
00:20:07,240 --> 00:20:08,730
...الحلم

326
00:20:16,310 --> 00:20:17,870
.طاب يومك

327
00:20:21,210 --> 00:20:24,090
.يا لها من مجموعة مثيرة للاهتمام

328
00:20:24,090 --> 00:20:26,100
!سأهزمكما في المرة القادمة

329
00:20:26,100 --> 00:20:27,760
!تباً، هذه ثلاث خسائر متتالية

330
00:20:27,760 --> 00:20:29,250
!لا بد أنه الحظ

331
00:20:29,250 --> 00:20:31,090
!في المرة القادمة سأفوز

332
00:20:32,390 --> 00:20:33,520
!افتح

333
00:20:34,840 --> 00:20:36,330
!باب الأحلام

334
00:20:47,800 --> 00:20:49,530
من أنتما؟

335
00:20:50,460 --> 00:20:52,050
.شـ-شكرًا لك

336
00:20:59,770 --> 00:21:01,670
.لقد مر أسبوع

337
00:21:03,640 --> 00:21:04,720
...تلك

338
00:21:05,010 --> 00:21:06,810
كيساراغي، أليس كذلك؟

339
00:21:08,390 --> 00:21:10,650
.سأتحدث معها مرة أخرى

340
00:21:10,650 --> 00:21:12,520
.لن يكون ذلك ضروريا

341
00:21:12,710 --> 00:21:14,050
!كيساراغي

342
00:21:20,370 --> 00:21:22,020
!كيساراغي

343
00:21:28,240 --> 00:21:29,530
