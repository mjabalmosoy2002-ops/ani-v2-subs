1
00:00:07,730 --> 00:00:08,900
!توا

2
00:00:08,900 --> 00:00:10,490
الأميرة توا؟

3
00:00:10,490 --> 00:00:13,130
أخت الأمير كاناتا؟

4
00:00:13,130 --> 00:00:15,480
.أنا الأميرة السوداء

5
00:00:15,480 --> 00:00:19,250
.ابنة الساحرة العظيمة ديسبير، توايلايت

6
00:00:22,820 --> 00:00:24,220
!...إنه

7
00:00:25,300 --> 00:00:27,360
!العطر

8
00:00:52,180 --> 00:00:55,390
.نبيلة ومقدسة وجميلة

9
00:00:55,390 --> 00:00:56,760
...أنا

10
00:00:58,850 --> 00:01:01,270
!هي الأميرة الوحيدة...

11
00:01:12,170 --> 00:01:14,860
!أن تكوني قوية، لطيفة، وجميلة

12
00:01:14,860 --> 00:01:18,100
قصة الفتيات الثلاث اللاتي يهدفن إلى أن
!يصبحن أميرات حقيقيات

13
00:01:18,100 --> 00:01:19,850
!اسعوا خلف أحلامكم

14
00:01:19,850 --> 00:01:22,370
!انطلقي! أيتها الأميرة بريكيور

15
00:03:17,280 --> 00:03:19,010
.لقد فشلت مرة أخرى

16
00:03:19,750 --> 00:03:24,410
أحتاج إلى تحسين مستواي لكي أعزف
.بشكل جيد مثل أخي

17
00:03:24,410 --> 00:03:26,140
.وأصبح سيدة رائعة

18
00:03:26,140 --> 00:03:28,200
.وأميرة عظيمة

19
00:03:30,020 --> 00:03:31,990
.أريد و بشدة ان أصبح أميرة

20
00:03:33,100 --> 00:03:34,300
.يمكنك ذلك

21
00:03:37,340 --> 00:03:38,420
من هناك؟

22
00:03:38,830 --> 00:03:43,220
.دعيني أحقق حلمك الكبير والقوي

23
00:03:44,180 --> 00:03:45,840
حقاً؟

24
00:03:49,420 --> 00:03:53,470
.تعالي إلى جانبي

25
00:03:57,460 --> 00:03:58,920
.فهمت

26
00:03:58,920 --> 00:04:00,960
.ما باليد حيلة إذاً

27
00:04:01,920 --> 00:04:06,220
،ولكن إذا ضيعت هذه الفرصة الرائعة

28
00:04:06,220 --> 00:04:11,350
فأنا متأكدة من أن أخاك سيشعر
.بخيبة أمل كبيرة

29
00:04:14,740 --> 00:04:16,200
!مهلاً

30
00:04:18,790 --> 00:04:22,900
.أريد أن أصبح أميرة عظيمة

31
00:04:23,640 --> 00:04:26,210
!أريد أن أحقق حلمي

32
00:04:39,860 --> 00:04:43,940
.أنا الأميرة السوداء

33
00:04:43,940 --> 00:04:47,880
.سأجعل العالم مليئًا باليأس

34
00:04:50,470 --> 00:04:51,670
...توا

35
00:05:00,820 --> 00:05:02,880
...لقد تحولت

36
00:05:02,880 --> 00:05:05,690
هل هذه هي قوة المفتاح الأسود؟

37
00:05:06,020 --> 00:05:08,350
.توايلايت

38
00:05:08,350 --> 00:05:14,810
.ادفني الأميرة بريكيور والأمير كاناتا

39
00:05:15,070 --> 00:05:17,710
.حاضر يا أمي

40
00:05:18,550 --> 00:05:19,490
!توا

41
00:05:24,290 --> 00:05:25,440
!فلورا

42
00:05:27,380 --> 00:05:30,600
!أنت أخت كاناتا الصغرى

43
00:05:31,300 --> 00:05:33,460
ماذا حدث!؟

44
00:05:39,580 --> 00:05:40,820
!فلورا

45
00:05:40,820 --> 00:05:43,700
.يبدو أن كلماتنا لا تصل إليها

46
00:05:43,700 --> 00:05:45,170
.أنا آسف يا فلورا

47
00:05:45,170 --> 00:05:46,150
.كل هذا خطئي

48
00:05:46,150 --> 00:05:47,400
.لا

49
00:05:47,400 --> 00:05:53,090
أي شخص سيكون في حالة صدمة
.بعد هذا اللقاء

50
00:05:53,090 --> 00:05:56,060
.وعلى أية حال، يجب علينا أن نوقفها

51
00:05:56,060 --> 00:06:02,590
شعرت بقوة أكبر وأكثر رعبًا من أي
.مفتاح أسود واجهناه من قبل

52
00:06:02,930 --> 00:06:06,340
.لقد كان شعورًا خطيرًا للغاية

53
00:06:06,340 --> 00:06:11,280
.وكأنها تحاول أن تترك نفسها تحترق

54
00:06:12,410 --> 00:06:15,820
...قوة اليأس من العطر

55
00:06:15,820 --> 00:06:19,800
هل سيبتلع ذلك توا أيضًا؟

56
00:06:19,800 --> 00:06:22,800
...هذا يعني أن الأميرة توا سوف

57
00:06:23,900 --> 00:06:25,270
!لا تقلق

58
00:06:25,680 --> 00:06:28,680
!لن أدع ذلك يحدث

59
00:06:28,680 --> 00:06:31,130
،لا أعرف كل التفاصيل

60
00:06:31,490 --> 00:06:34,580
.لكن لا يمكننا أن نتركها

61
00:06:34,580 --> 00:06:39,720
حسناً، لم الشمل بين الأخ والأخت
.يجب أن يكون أكثر تأثيراً

62
00:06:39,720 --> 00:06:40,660
!يا رفاق

63
00:06:43,060 --> 00:06:47,620
،مع مفاتيح التأنق وقوة الأميرة بريكيور

64
00:06:47,620 --> 00:06:53,540
أنا متأكد من أننا سنقدر على هزيمة قوة
!اليأس وتحرير توا من المفتاح الأسود

65
00:06:53,590 --> 00:06:56,300
المفتاح ضد المفتاح، على ما أعتقد؟

66
00:06:56,300 --> 00:06:57,600
هل أنتن جميعا مستعدات؟

67
00:06:57,600 --> 00:06:58,540
!نعم

68
00:06:58,540 --> 00:07:00,360
.هذا ليس وقتا للتراجع الآن

69
00:07:00,360 --> 00:07:01,870
!لننطلق بكل قوتنا

70
00:07:04,580 --> 00:07:05,760
!الشهاب

71
00:07:07,440 --> 00:07:09,700
!تألق، أيها الشهاب

72
00:07:09,700 --> 00:07:13,850
!بريكيور طنين النيزك

73
00:07:19,870 --> 00:07:20,980
!الفقاعة

74
00:07:23,260 --> 00:07:25,370
!زمجري أيتها الفقاعات

75
00:07:25,370 --> 00:07:28,900
!بريكيور موجة الفقاعات

76
00:07:36,740 --> 00:07:37,800
!الزنبقة

77
00:07:39,860 --> 00:07:41,780
!رقصة الزنابق

78
00:07:41,780 --> 00:07:45,580
!بريكيور دوامة الزنابق

79
00:07:53,710 --> 00:07:56,040
الوضع الأنيق!؟

80
00:08:08,760 --> 00:08:10,560
!الوضع الأنيق؟

81
00:08:20,620 --> 00:08:22,250
!توقفي عن هذا يا توا

82
00:08:22,250 --> 00:08:24,550
...إذا واصلت هذا، فسوف

83
00:08:24,550 --> 00:08:25,870
!توا

84
00:08:26,140 --> 00:08:27,840
.لا فائدة من هذا

85
00:08:28,730 --> 00:08:33,790
.لم يعد بإمكان توايلايت سماع أصواتكم بعد الآن

86
00:08:35,160 --> 00:08:37,080
ما الأمر أيها الأمير كاناتا؟

87
00:08:37,920 --> 00:08:41,540
.هذه هي قوة اليأس

88
00:08:42,140 --> 00:08:43,320
!ديسبير

89
00:08:43,320 --> 00:08:47,060
.كان لدى أختك حلم

90
00:08:48,240 --> 00:08:54,530
بصفتها أميرة مملكة الأمل، أرادت أن
.ترقى إلى مستوى اسمها

91
00:08:54,530 --> 00:08:59,740
،لقد عملت بجد بنفسها كل يوم
.لتنمية هذا الحلم القوي

92
00:09:00,940 --> 00:09:06,620
ولكن كلما عملت أكثر لتحقيق هذا
.الحلم، بدا الأمر بعيد المنال

93
00:09:06,960 --> 00:09:13,060
.لقد كانت قلقة بشأن عدم نضجها وأيقظتني

94
00:09:13,060 --> 00:09:14,620
...وعندها

95
00:09:16,270 --> 00:09:19,250
!أريد أن أحقق حلمي

96
00:09:19,800 --> 00:09:26,620
!غاصت الأميرة في أعماق غابة اليأس بنفسها

97
00:09:27,650 --> 00:09:31,340
ذهبت توا بنفسها؟

98
00:09:31,800 --> 00:09:36,290
إذن لماذا!؟ لماذا أخذتها!؟

99
00:09:36,290 --> 00:09:42,580
!أريد أن أسلب منك رمز الأمل ذاته

100
00:09:42,840 --> 00:09:44,950
هل تعرف ذلك؟

101
00:09:44,950 --> 00:09:50,180
هل تعرف ما مدى أهمية الأميرة للمملكة؟

102
00:09:51,670 --> 00:09:56,380
.سقطت المملكة في حزن عميق منذ أن فقدت أميرتها

103
00:09:56,380 --> 00:09:58,970
.وتغلب عليهم اليأس

104
00:09:58,970 --> 00:10:04,180
.لقد أطعمني هذا اليأس وأصبح قوتي

105
00:10:09,190 --> 00:10:15,360
كان بإمكاني أن أترك الأميرة وحدها، لكنني فكرت
.في شيء أكثر إثارة للاهتمام

106
00:10:15,980 --> 00:10:23,930
.سأمحو ذكرياتها وقلبها وأحلامها

107
00:10:23,930 --> 00:10:26,470
.وأربيها على أنها أميرة ديسدارك

108
00:10:28,700 --> 00:10:32,280
.أميرة الأمل أصبحت أميرة اليأس

109
00:10:32,280 --> 00:10:34,610
.وسوف تقضي على الأمل بيديها

110
00:10:35,180 --> 00:10:40,540
.وليس هناك يأس أعظم بالنسبة لك من ذلك

111
00:10:40,540 --> 00:10:50,060
لكن في النهاية كانت الأميرة فاشلة لم تتمكن من
.الحصول على مفاتيح التنكر السحرية أو هزيمة بريكيور

112
00:10:50,350 --> 00:10:55,800
توايلايت، أريني على الأقل أنه يمكنك أن
.تكوني مفيدةً حتى النهاية

113
00:10:56,180 --> 00:11:03,500
.احرقي الأميرة بريكيور، آخر بصيص من الأمل

114
00:11:03,500 --> 00:11:05,930
!وضعي حياتك على المحك

115
00:11:06,890 --> 00:11:07,660
...توا

116
00:11:08,330 --> 00:11:12,460
.نعم كما تريدين يا أمي

117
00:11:12,460 --> 00:11:13,100
!توا

118
00:11:25,850 --> 00:11:27,650
...توا

119
00:11:43,490 --> 00:11:48,790
.النور الذي ينير مملكة الأمل يختنق في الظلام

120
00:11:48,790 --> 00:11:54,580
.لقد فقدت حلمك والآن، حتى أملك

121
00:11:54,940 --> 00:11:59,400
.لقد فقدت كل شيء

122
00:12:02,690 --> 00:12:06,000
.لم يبق سوى اليأس

123
00:12:10,730 --> 00:12:13,630
.الأحلام لا تزال موجودة

124
00:12:16,900 --> 00:12:22,870
!وما يزال الأمل والأحلام باقيان

125
00:12:24,380 --> 00:12:25,420
!فلورا

126
00:12:31,540 --> 00:12:33,500
!ضفائر شعر مزدوجة

127
00:12:39,070 --> 00:12:41,520
!جميل

128
00:12:41,520 --> 00:12:45,170
!آنسة توايلايت! ياله من شكل نبيل

129
00:12:45,170 --> 00:12:49,010
.حسنًا، يبدو أن الأمور أصبحت مثيرة للاهتمام

130
00:12:50,640 --> 00:12:58,580
آنسة توايلايت! إن مقابلتك هي أروع
!لحظة في حياتي

131
00:13:03,480 --> 00:13:05,780
.يا له من منظر حقير

132
00:13:05,780 --> 00:13:11,860
حتى بعد كل هذا، لماذا تقومين بالنهوض
مرة أخرى أيتها الأميرة بريكيور؟

133
00:13:15,980 --> 00:13:18,310
.لأن الأمل لا يزال موجودا

134
00:13:28,460 --> 00:13:31,660
!أمام عيني مباشرة

135
00:13:32,280 --> 00:13:36,530
إذاً ستقابلين نهايتك على يد أملك
!الذي تتحدثين عنه

136
00:13:39,000 --> 00:13:45,380
.لقد قلت أن الكمان هو آلة تغلق قلبك

137
00:13:45,380 --> 00:13:49,510
.لكنني تأثرت للغاية بأدائك

138
00:13:49,510 --> 00:13:53,040
!أردت أن أعزف مثلك تماما

139
00:13:56,350 --> 00:14:02,520
أنا متأكدة أن اللحن الذي تعزفينه هو حلم
!لا يمكن أن تحبسيه أبداً

140
00:14:02,810 --> 00:14:07,510
وهو مليء بالمشاعر التي كنتِ ترغبين في
!التعبير عنها لكاناتا، البعيد

141
00:14:07,510 --> 00:14:11,420
.أخبرتك. لقد اختفى قلب الأميرة

142
00:14:11,420 --> 00:14:15,410
شخص بلا قلب لا يمكن أن يقدم مثل
!هذا الأداء الجميل

143
00:14:16,390 --> 00:14:20,260
!قلبك مقفل بدون إرادتك

144
00:14:20,260 --> 00:14:25,060
!حلمك ومشاعرك تجاه كاناتا لا تزال موجودة

145
00:14:30,670 --> 00:14:33,700
اللعنة عليك! كيف تجرؤين على معاملة الآنسة
!توايلايت بهذه الطريقة

146
00:14:33,700 --> 00:14:35,950
!أنتِ مليئة بالثغرات يا كيور فلورا

147
00:14:41,710 --> 00:14:43,100
!انطلقي يا فلورا

148
00:14:43,100 --> 00:14:44,950
!هذه المرة، أنهي الأمر

149
00:14:44,950 --> 00:14:45,840
!حسنا

150
00:14:48,980 --> 00:14:51,620
!هيا بنا

151
00:14:52,030 --> 00:14:53,780
!التبادل

152
00:14:55,300 --> 00:14:57,220
!الوضع الأنيق

153
00:14:57,220 --> 00:14:58,060
!الزنبقة

154
00:14:58,060 --> 00:14:59,330
!الفقاعة

155
00:14:59,330 --> 00:15:00,380
!الشهاب

156
00:15:31,060 --> 00:15:34,440
!تألقي يا قوة الثلاثة

157
00:15:34,440 --> 00:15:41,400
!بريكيور ترينيتي إكسبلوزيون

158
00:15:58,560 --> 00:15:59,980
...المفاتيح السوداء

159
00:15:59,980 --> 00:16:02,590
!لم ينتهي الأمر بعد! لا تتوقفا

160
00:16:04,460 --> 00:16:05,860
.هذا غير مجد

161
00:16:06,670 --> 00:16:11,570
.لا يمكنكن تدمير اليأس الذي خلقته المفاتيح السوداء

162
00:16:11,570 --> 00:16:20,740
ليس لديكن حتى القدرة على استخدام
.جميع مفاتيح التأنق الـ 12

163
00:16:21,070 --> 00:16:23,420
.ليس نحن فقط

164
00:16:23,420 --> 00:16:25,030
...قوة الأمل

165
00:16:25,560 --> 00:16:27,650
.. والأحلام ...

166
00:16:28,010 --> 00:16:30,790
.موجودان بداخلك يا توا...

167
00:16:39,840 --> 00:16:43,680
توا، هل تتذكرين هذه الأغنية؟

168
00:16:44,210 --> 00:16:50,570
أردت أن أرى ابتسامتك وقمت بعزف
.هذه الأغنية مرات لا تحصى

169
00:16:51,190 --> 00:16:56,810
رؤيتك تتدربين عليها بكل قوتك
.ملأني بالفرح الكبير

170
00:16:57,410 --> 00:17:01,270
.أريد أن أعزف الكمان معك مرة أخرى

171
00:17:01,920 --> 00:17:04,870
.هذا هو حلمي

172
00:17:04,870 --> 00:17:08,140
إنه حلم لا يمكن أن يتحقق بدونك

173
00:17:08,140 --> 00:17:11,620
.توا، من فضلك تذكري

174
00:17:11,620 --> 00:17:15,740
.لقد أخبرتني بحلمك حينها

175
00:17:17,300 --> 00:17:21,310
طالما أنك ترغبين في ذلك، فأنا متأكد من
.أن حلمك سوف يتحقق

176
00:17:25,970 --> 00:17:27,140
ماذا؟

177
00:17:27,140 --> 00:17:28,130
...إنه

178
00:17:28,130 --> 00:17:29,950
نور الأحلام؟

179
00:17:30,190 --> 00:17:32,020
...مستحيل

180
00:17:32,020 --> 00:17:35,180
الحلم الذي مسحته يعود؟

181
00:17:49,270 --> 00:17:51,430
...أخي الأكبر

182
00:18:05,950 --> 00:18:07,490
...توا

183
00:18:12,120 --> 00:18:15,000
ما الذي يجري هنا!؟

184
00:18:15,000 --> 00:18:18,020
من هي تلك الفتاة!؟

185
00:18:18,020 --> 00:18:19,300
!مهلا يا لوك

186
00:18:19,300 --> 00:18:22,150
ماذا حدث للآنسة توايلايت!؟

187
00:18:23,620 --> 00:18:28,680
.اختفت الآنسة توايلايت وأصبحت فتاة عادية

188
00:18:30,100 --> 00:18:31,420
!مستحيل

189
00:18:31,420 --> 00:18:33,410
!هذا غير معقول

190
00:18:34,490 --> 00:18:36,740
.أصبحت الأمور مملة مرة أخرى

191
00:18:38,690 --> 00:18:43,100
.دعنا نخرج من هنا قبل أن ينهار كل شيء يا لوك

192
00:18:43,660 --> 00:18:48,430
.يبدو أن ديسبير غاضبة جدًا الآن

193
00:18:54,190 --> 00:18:56,420
.لدي شعور سيء حيال هذا

194
00:18:56,420 --> 00:18:59,280
.لا أعتقد أنهم سيسمحون لنا بالمغادرة بهذه الطريقة

195
00:18:59,640 --> 00:19:01,420
إلى أين نحن ذاهبون؟

196
00:19:01,420 --> 00:19:03,910
!هناك باب أمامك

197
00:19:03,910 --> 00:19:07,780
!لقد ذهبنا إلى عالمك من خلال هذا الباب

198
00:19:07,780 --> 00:19:12,050
.لا يمكننا مواجهة قوة ديسبير الآن

199
00:19:12,550 --> 00:19:15,910
لم يعد لديك أي طاقة متبقية بعد
.تلك المعركة الأخيرة

200
00:19:15,910 --> 00:19:18,740
.علينا أن نخرج من هنا أولا

201
00:19:19,060 --> 00:19:20,810
.لن تفلتوا أبداً

202
00:19:25,150 --> 00:19:28,920
.سأدمر أحلامك وأقضي على الأمل نفسه

203
00:19:28,920 --> 00:19:31,920
.سوف يصبح العالم غارقاً في اليأس

204
00:19:31,920 --> 00:19:33,820
ما هذا؟

205
00:19:33,820 --> 00:19:36,310
!قوى ديسبير السحرية

206
00:19:43,300 --> 00:19:44,500
!هناك

207
00:19:44,500 --> 00:19:46,440
!اسرعوا واقفزو

208
00:19:49,820 --> 00:19:51,720
.كان ذلك وشيكا

209
00:19:58,540 --> 00:20:00,940
...أخي الأكبر

210
00:20:04,700 --> 00:20:06,960
.مرحبًا بعودتك يا توا

211
00:20:06,960 --> 00:20:09,380
.ليس هناك ما يدعو للقلق بعد الآن

212
00:20:09,380 --> 00:20:12,580
.سأحميك بالتأكيد

213
00:20:15,140 --> 00:20:16,700
!اذهبوا إلى الباب! هيا

214
00:20:16,700 --> 00:20:17,900
!نعم

215
00:20:18,820 --> 00:20:21,360
!هيا بنا يا كاناتا

216
00:20:22,080 --> 00:20:23,420
.اذهبوا

217
00:20:28,200 --> 00:20:29,400
كاناتا؟

218
00:20:30,410 --> 00:20:36,530
.سأدمر هذا الباب بعد مغادرتكم

219
00:20:37,730 --> 00:20:46,420
ستتبعكم قوى ديسبير إلى عالمكم
.إذا لم أفعل ذلك

220
00:20:46,420 --> 00:20:49,300
.يجب أن أمنع ذلك من الحدوث

221
00:20:49,300 --> 00:20:52,220
!لا! هذا خطير جداً

222
00:20:52,220 --> 00:20:53,020
...سوف

223
00:20:53,020 --> 00:20:53,710
.هاروكا

224
00:20:55,010 --> 00:20:59,640
.بفضلك، تمكنت من مقابلة توا مرة أخرى

225
00:21:00,670 --> 00:21:04,030
.لقد وجدت الأمل الذي فقدته

226
00:21:06,480 --> 00:21:07,870
.سوف ألحق بك

227
00:21:07,870 --> 00:21:11,040
لا يزال لديك حلم تريدين تحقيقه، أليس كذلك؟

228
00:21:14,300 --> 00:21:15,840
!كاناتا

229
00:21:17,740 --> 00:21:21,340
.هاروكا، أرجو أن تعتني بتوا

230
00:21:24,480 --> 00:21:25,990
!كاناتا

231
00:21:34,270 --> 00:21:39,020
...طالما أن قلبي يشتاق للقاء مرة أخرى، أنا متأكد

232
00:21:39,740 --> 00:21:40,660
...يا هاروكا

233
00:21:41,260 --> 00:21:42,860
!من أننا سنلتقي مرة أخرى

234
00:21:50,230 --> 00:21:54,190
!كاناتا

235
00:22:11,710 --> 00:22:13,540
...أخي الأكبر

236
00:23:51,500 --> 00:23:54,600
طالما أن قلبك يشتاق لذلك، أنا واثقة
!من أن أحلامك سوف تتحقق

237
00:23:54,600 --> 00:23:56,830
!كاناتا أخبرني بذلك

238
00:23:56,830 --> 00:23:59,450
.الجميع يرتكب الأخطاء

239
00:23:59,450 --> 00:24:01,490
!إذا فشلت، فقط ابدئي من جديد

240
00:24:01,490 --> 00:24:03,790
!لهذا السبب لا يجب أن تيأسي

241
00:24:03,790 --> 00:24:06,190
!اطمحي إلى أن تصبحي أميرة عظيمة

242
00:24:06,190 --> 00:24:07,270
!توا

243
00:24:08,400 --> 00:24:10,820
!انطلقي! أيتها الأميرة بريكيور

244
00:24:10,820 --> 00:24:14,660
!نيران الأمل! اسمها العلاج القرمزي

245
00:24:15,260 --> 00:24:16,870
!هيا هيا! لتحقيق أحلامكم

246
00:24:16,870 --> 00:24:18,000
!طاب يومكم