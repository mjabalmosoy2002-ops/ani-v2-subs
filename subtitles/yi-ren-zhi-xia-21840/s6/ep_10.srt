1
00:02:18,000 --> 00:02:20,200
،وافق على شروطي الثّلاثة

2
00:02:20,200 --> 00:02:22,390
ويمكنك المُغادرة

3
00:02:24,410 --> 00:02:26,220
هل تُصدّقني؟

4
00:02:26,220 --> 00:02:28,020
!لم أكن أنا حقّاً

5
00:02:28,020 --> 00:02:29,730
أُصدّقك؟

6
00:02:29,730 --> 00:02:31,380
كيف لي أن أُصدّقك؟

7
00:02:31,380 --> 00:02:34,680
حتّى أولئك الّذين أيقظوا مهارة
الرُّوح المُشرقة لا يستطيع التّعامل معك

8
00:02:35,290 --> 00:02:38,100
لكن راقبتُكم وأنتم تكبرون أيّها الأطفال

9
00:02:38,530 --> 00:02:41,770
أعرف طبيعتك خير معرفة

10
00:02:42,160 --> 00:02:43,810
!لم أفعلها

11
00:02:44,660 --> 00:02:46,600
!إذاً أثبت لي ذلك

12
00:02:46,990 --> 00:02:49,250
ليس وكأنّني لم أمنحك فُرصة

13
00:02:49,250 --> 00:02:51,630
،عندما قبضتْ عليك العشيرةُ أوّل مرّة

14
00:02:51,630 --> 00:02:54,030
،لو لم يغضّ البعضُ الطّرف عنك

15
00:02:54,030 --> 00:02:57,190
فهل تعتقد أنّه كان بمقدورك الهرب
من القرية من تلقاء نفسك؟

16
00:02:57,190 --> 00:02:59,360
،لكن بعد هروبك

17
00:02:59,360 --> 00:03:02,540
هل ذهبت للبحث عن قاتل هوان الفعليّ؟

18
00:03:09,500 --> 00:03:10,750
لا، لم تفعل

19
00:03:11,430 --> 00:03:15,560
هربتَ واستمتعتَ بالتنزُّه مع أشقياء
!تشوان شينغ أولئك

20
00:03:16,380 --> 00:03:19,670
لم... لم يكن لديّ أيّ ملاذ
ألجأ إليه آنذاك

21
00:03:19,670 --> 00:03:20,810
!كلام فارغ

22
00:03:20,810 --> 00:03:25,600
تقصد بأنّ العشائر الصّالحة خشيتْ من عشيرتنا
ليو ولم تقبل بتبنّيك

23
00:03:25,600 --> 00:03:27,310
!دعني أُسمّي ثلاثة أشخاص

24
00:03:27,700 --> 00:03:29,320
زانغ زيوي من التّينشيفو

25
00:03:29,320 --> 00:03:32,520
لا أُقارَن به من حيث الشّخصيّة
أو القوّة أو التّأثير

26
00:03:32,520 --> 00:03:34,040
مو يو من شاوزان

27
00:03:34,040 --> 00:03:36,600
الأبرز في الجيل الأصغر سنّاً

28
00:03:36,600 --> 00:03:39,390
ولو جين، رئيس عشيرة لو

29
00:03:39,390 --> 00:03:41,120
لا أنسجم معه

30
00:03:41,120 --> 00:03:43,300
!لكن لا أنكر بأنّه رجل صالح

31
00:03:43,770 --> 00:03:46,350
!أكره فحسب نزاهته الزّائدة عن اللّزوم

32
00:03:46,350 --> 00:03:49,520
لم نلتقِ وجهاً لوجه منذ الطّفولة

33
00:03:49,520 --> 00:03:50,860
،إن ظُلِمتَ فعلاً

34
00:03:50,860 --> 00:03:52,900
!فكان يمكنك الذّهاب إلى أحدهم

35
00:03:52,900 --> 00:03:56,100
الثّلاثة جميعهم يعلمون بأنّني عديم
!الرّحمة، لكن لا أحد يخشاني

36
00:03:56,100 --> 00:04:01,470
!لن يصغوا لرواية القرية فحسب ويُسلّموك

37
00:04:01,470 --> 00:04:05,390
وجميعهم لديهم القدرة على مُساعدتك
!في تعقُّب وكشف القاتل الحقيقيّ

38
00:04:05,390 --> 00:04:09,250
إن كنتَ بريئاً حقّاً، فقد كان
!أولئك الثّلاثة خيارك الأمثل

39
00:04:09,250 --> 00:04:11,060
...لكنّك

40
00:04:11,060 --> 00:04:15,560
!اخترتَ أسفل السّفَلة، عشيرة تشوان شينغ

41
00:04:15,970 --> 00:04:19,140
حتّى أنت لا تعرف السّبب، أليس كذلك؟

42
00:04:19,830 --> 00:04:21,590
...دعني أُخبرك

43
00:04:21,590 --> 00:04:23,930
!الطّيور على أشكالها تقع

44
00:04:23,930 --> 00:04:27,100
،مُقارنة بالبقاء في القرية واتّباع قواعدي

45
00:04:27,100 --> 00:04:31,680
من الأمتع أكثر اللّهو مع أولئك المسوخ، صحيح؟

46
00:04:32,090 --> 00:04:34,460
،حتّى بوضع مسألة هوان جانباً

47
00:04:34,460 --> 00:04:36,800
...الضّرب الّذي تلقّيتَه في هذه الأيّام

48
00:04:36,800 --> 00:04:38,270
هل كانت ظالمة؟

49
00:04:39,120 --> 00:04:40,270
ليست ظالمة

50
00:04:40,270 --> 00:04:43,750
!حسناً، ثلاثة شروط

51
00:04:43,750 --> 00:04:47,750
الأوّل، من الآن فصاعداً، اقطع كلّ روابطك
،مع طائفة تشوان شينغ

52
00:04:47,750 --> 00:04:49,390
!لا مزيد من التّواصل

53
00:04:49,810 --> 00:04:53,850
ثانياً، من الآن فصاعداً، سوف تتبعني
وتتعلّم ريوي جين

54
00:04:55,910 --> 00:04:57,050
أنا؟

55
00:04:58,600 --> 00:05:00,350
كيف لي أن أتعلّمها؟

56
00:05:00,350 --> 00:05:01,770
حاولَ جدّي تعليمي

57
00:05:02,100 --> 00:05:06,430
إتقان القدرات الفطريّة والمُكتسَبة
في آن واحد صعبٌ للغاية

58
00:05:06,430 --> 00:05:08,060
!لكن ليس مُستحيلاً

59
00:05:08,650 --> 00:05:11,020
وألم تسمع ما قلتُه للتو؟

60
00:05:11,570 --> 00:05:13,400
!من الآن فصاعداً، ستتبعني

61
00:05:13,400 --> 00:05:14,810
!سأدرّبك أنا شخصيّاً

62
00:05:16,220 --> 00:05:17,640
والشّرط الأخير

63
00:05:17,640 --> 00:05:20,930
بعد أن تتعافى، استعدّ للزواج
من تشي من دونغكون

64
00:05:21,460 --> 00:05:24,340
تشي؟ تقصد ليو تشي؟

65
00:05:24,340 --> 00:05:25,560
...كيف يُعقَل

66
00:05:25,560 --> 00:05:29,310
لست راضياً؟ لا تُحبّ شكلها أو شخصيّتها؟

67
00:05:30,540 --> 00:05:33,190
أجل، الرّوي جين خاصّتها مُتقدّمة جدّاً

68
00:05:33,190 --> 00:05:34,830
هل تخشى تلقّي الضّرب لاحقاً؟

69
00:05:34,830 --> 00:05:38,220
!لا، إنّها قريبة ضمن الأجيال الخمسة

70
00:05:38,220 --> 00:05:40,000
!فليكُن

71
00:05:40,000 --> 00:05:43,360
آنذاك، عمّ والدك وجدّك وعمّة والدك الثّالثة

72
00:05:43,360 --> 00:05:45,560
جميعهم تزوّجوا ضمن عشيرتهم

73
00:05:46,600 --> 00:05:48,540
...لـ-لكن

74
00:05:49,020 --> 00:05:50,430
هل ترفض؟

75
00:05:51,140 --> 00:05:54,100
...لا، أنا... والد جدّي

76
00:05:55,330 --> 00:05:57,740
...مسألة هوان لم

77
00:05:58,460 --> 00:06:01,300
لماذا... لماذا تفعل هذا لأجلي؟

78
00:06:02,210 --> 00:06:04,580
لماذا أُعاملك مُعاملة حسنة؟

79
00:06:06,850 --> 00:06:09,440
مسألة هوان لم تنتهِ بالطّبع

80
00:06:09,440 --> 00:06:11,580
،إذا اكتشفتُ يوماً بأنّه أنت فعلاً

81
00:06:11,580 --> 00:06:13,270
فسأقتلك بيدي هاتين

82
00:06:13,730 --> 00:06:15,600
،إن لم تكن أنت

83
00:06:15,600 --> 00:06:18,000
!فيمكنك الذّهاب والتحرّي إذاً

84
00:06:18,000 --> 00:06:23,020
أتعتقد بأنّك تستطيع الهرب فقط
لأنّني أطلقتُ سراحك؟

85
00:06:27,070 --> 00:06:28,370
،ليو ليانغ

86
00:06:29,230 --> 00:06:31,760
في أعماقي، آمل ألّا تكون أنت

87
00:06:32,560 --> 00:06:35,630
جميعكم تعتقدون بأنّني ظالم وعديم الرّحمة

88
00:06:36,820 --> 00:06:38,850
حسناً، أنا بحدّ ذاتي أعتقد بأنّني قاسٍ

89
00:06:39,170 --> 00:06:41,190
،لكن عليك أن تفهم أيضاً

90
00:06:41,190 --> 00:06:44,140
الشّيء الوحيد الّذي يهمّني حقّاً هو السّلالة

91
00:06:44,140 --> 00:06:46,920
،حتّى شخصاً سخيفاً مثلك

92
00:06:46,920 --> 00:06:48,930
أقدّره وأعزّه بطريقتي الخاصّة

93
00:06:49,900 --> 00:06:51,310
...والد جدّي

94
00:06:52,270 --> 00:06:53,920
...بالمناسبة يا والد جدّي

95
00:06:53,920 --> 00:06:56,180
أردتُ أن أُخبرك بشيء

96
00:06:56,890 --> 00:06:59,770
هل تعرف ما هي "الأيادي المثاليّة"؟

97
00:07:11,370 --> 00:07:14,660
من أين سمعت هذا الاسم؟

98
00:07:19,310 --> 00:07:21,020
...لحظة

99
00:07:24,000 --> 00:07:26,680
لا تقلق، لن أؤذيك

100
00:07:26,680 --> 00:07:27,850
ستكون بخير

101
00:07:28,200 --> 00:07:32,220
تلك التقنيّة الّتي استخدمتَها عليّ
...قبل قليل... كانت

102
00:07:35,030 --> 00:07:36,100
هذه ذاكرتك

103
00:07:36,630 --> 00:07:39,600
،تقنيّة مُتوارثة في عشيرتنا ليو
مهارة الرُّوح المُشرقة

104
00:07:41,270 --> 00:07:43,640
إنّها مُصمّمة خصّيصاً للتّعامل مع هذا المكان

105
00:07:44,300 --> 00:07:48,620
...مهارة الرُّوح المُشرقة

106
00:07:50,730 --> 00:07:53,850
لا تملك فكرة عمّا تفعله

107
00:07:55,800 --> 00:07:59,430
بُني، دعني أسدي إليك بنصيحة أُخرى

108
00:07:59,430 --> 00:08:02,460
اترك طائفة تشوان شينغ في أسرع وقت

109
00:08:02,460 --> 00:08:03,560
ماذا؟

110
00:08:03,560 --> 00:08:08,550
إذا كانوا سيُعقّدون الأمور على زانغ
،تشولان بالنّسبة لتشي التّكوين

111
00:08:08,550 --> 00:08:11,640
فلستَ بأمان معهم أيضاً

112
00:08:12,140 --> 00:08:14,540
ماذا... تقصد؟

113
00:08:15,290 --> 00:08:18,960
رأيتُ تقنيّتك منذ زمن بعيد

114
00:08:18,960 --> 00:08:21,040
لطالما كانت نفسها تماماً

115
00:08:21,040 --> 00:08:25,350
"لكن آنذاك، لم تكن تُدعى "مهارة الرُّوح المُشرقة

116
00:08:25,350 --> 00:08:28,300
"بل تُدعى "الأيادي المثاليّة

117
00:08:31,300 --> 00:08:35,560
إنّها... إحدى الفنون السّرّية الثّمانية
من عام جياشين

118
00:08:35,560 --> 00:08:39,100
لماذا يقول تيان جينزهونغ ذلك؟

119
00:08:44,960 --> 00:08:45,900
!والد جدّي

120
00:08:46,640 --> 00:08:48,450
انتظر هنا

121
00:08:49,350 --> 00:08:50,440
والد جدّي

122
00:08:58,890 --> 00:09:00,020
!أبي

123
00:09:00,370 --> 00:09:02,180
أبي... كيف سار الأمر؟

124
00:09:02,180 --> 00:09:03,470
...ليو ليانغ، إنّه

125
00:09:07,310 --> 00:09:11,240
ليو زونغ، اذهب وخُذ ما بداخل رأس ليو ليانغ

126
00:09:15,060 --> 00:09:15,810
أبي؟

127
00:09:18,180 --> 00:09:21,290
اذهب وأحضر طبيب القرية

128
00:09:37,180 --> 00:09:39,060
-والد جدّي! والد

129
00:09:49,680 --> 00:09:50,830
!ادخلوا

130
00:10:14,210 --> 00:10:16,520
أريده حيّاً

131
00:10:16,520 --> 00:10:20,870
كلّ قطرة من دم عشيرتنا ثمينة

132
00:10:27,360 --> 00:10:29,570
الرّئيس تشو، من هنا لو سمحت

133
00:10:40,550 --> 00:10:44,600
مُجتمع ياوشينغ، تشو تونغ؟ سمعتُ عنكِ كثيراً

134
00:10:44,600 --> 00:10:46,380
سيّد مو يو من شاوزان

135
00:10:47,360 --> 00:10:49,100
الرّئيس زاو، ما الأمر؟

136
00:10:50,410 --> 00:10:51,140
هذا ليس بالكثير

137
00:10:51,850 --> 00:10:54,960
أحتاج كلا فريقيكِ للمُساعدة في شيء

138
00:11:09,770 --> 00:11:11,380
كيف وصلت الأمور إلى هنا؟

139
00:11:12,320 --> 00:11:14,400
...لماذا لم تخبرني مُسبقاً

140
00:11:14,400 --> 00:11:16,020
!تلقّيتُ الأنباء للتو بحدّ ذاتي

141
00:11:16,330 --> 00:11:20,530
لم يُناقش زاو فينغشو هذا الأمر
مع المجلس قبل اتّخاذ الإجراءات

142
00:11:20,530 --> 00:11:23,900
خطّطَ للتصرُّف أوّلاً والإبلاغ
لاحقاً منذ البداية

143
00:11:23,900 --> 00:11:27,250
،في الوضع الرّاهن، حتّى لو أبلغَ المجلس لاحقاً

144
00:11:27,250 --> 00:11:29,100
لن يرفضوه أبداً

145
00:11:29,670 --> 00:11:32,180
بدأ بالفعل باتّهام المجلس

146
00:11:32,540 --> 00:11:33,920
وماذا يعني؟

147
00:11:33,920 --> 00:11:36,810
!لن يسقط أحدٌ في فخّ خطّة غبيّة كهذه

148
00:11:37,270 --> 00:11:38,350
ليس بالضّرورة

149
00:11:38,680 --> 00:11:41,640
قد تكون مُشكلة هذه المرّة

150
00:11:41,640 --> 00:11:43,740
لا أستطيع رفض زاو فينغشو

151
00:11:43,740 --> 00:11:45,470
إذا رفضت، سيشتبهون بي

152
00:11:46,160 --> 00:11:48,540
حالفَ الحظُّ الشّركةَ هذه المرّة فعلاً

153
00:11:57,200 --> 00:11:58,160
باور

154
00:11:59,850 --> 00:12:01,560
لا تُمانعين زميل غرفة إضافيّاً، صحيح؟

155
00:12:06,470 --> 00:12:09,350
الرّقم المطلوب غير مُتاح مؤقّتاً

156
00:12:14,780 --> 00:12:15,950
...هذا الشّخص

157
00:12:16,510 --> 00:12:19,810
لم أتمكّن من التّوصُّل إليه منذ
افترقنا في قرية بيو

158
00:12:21,000 --> 00:12:21,720
!مرحباً

159
00:12:22,150 --> 00:12:23,280
!ترحيب دافئ جدّاً

160
00:12:23,280 --> 00:12:26,620
!باسم الشّركة، أُرحّب بالسّيّد لينغيو للانضمام لنا

161
00:12:28,890 --> 00:12:31,440
لديّ... شرط إضافيّ واحد

162
00:12:31,440 --> 00:12:31,890
ما هو؟

163
00:12:33,600 --> 00:12:34,990
هل يمكنني ألّا أقصّ شعري؟

164
00:12:34,990 --> 00:12:37,480
..أتفهّم بأنّ هناك تعليمات، لكن

165
00:12:39,100 --> 00:12:40,460
هل هذا مقبول؟

166
00:12:43,610 --> 00:12:45,870
!المُعلّم لينغيو، أنت تُبالغ في التّفكير في الأمر

167
00:12:45,870 --> 00:12:47,680
هيّا، فلتستقرّ أوّلاً

168
00:12:47,680 --> 00:12:49,520
توجد غرفة شاغرة في الطّابق السّفليّ

169
00:12:49,520 --> 00:12:51,180
يمكنك ترتيبها بنفسك

170
00:12:51,180 --> 00:12:54,090
العيش في نفس البناء مع فتاة؟

171
00:12:54,090 --> 00:12:55,550
هذا غير مُلائم

172
00:12:56,640 --> 00:12:58,390
ما الّذي ليس مُلائماً في ذلك؟

173
00:12:58,390 --> 00:13:01,350
لم أتوقّع أبداً أن يستخدم المُعلّم لينغيو
التّمييز الجنسيّ بهذه الجدّيّة

174
00:13:03,610 --> 00:13:04,200
!أخي سي

175
00:13:04,200 --> 00:13:04,880
نعم؟

176
00:13:05,970 --> 00:13:08,720
...هيّا الآن يا مُعلّم لينغيو، من هنا

177
00:13:12,880 --> 00:13:14,580
،الآن بعد أن حُلَّتْ مسألة زانغ لينغيو

178
00:13:14,580 --> 00:13:16,220
ماذا عن لو لينغلونغ ولو لين؟

179
00:13:16,220 --> 00:13:17,930
إنّهما في تيانجين

180
00:13:18,300 --> 00:13:20,850
مؤخّراً، هل لاحظتُم أنّكم مُراقَبون عند الخروج؟

181
00:13:21,230 --> 00:13:22,100
ماذا؟

182
00:13:26,800 --> 00:13:28,180
إنّهم من شاوزان

183
00:13:28,640 --> 00:13:30,140
ذلكما الصّاعدان استأجراهم

184
00:13:30,640 --> 00:13:34,330
شاوزان هي إحدى أكبر مُنظّمات الاستخبارات
في عالم المنبوذين

185
00:13:34,330 --> 00:13:36,870
كيف لهم ألّا يُحافظوا على علاقة
طيّبة مع الشّركة؟

186
00:13:36,870 --> 00:13:38,930
ذلكما الاثنان لم يكتشفا ذلك حتّى

187
00:13:38,930 --> 00:13:42,180
،حالما تلقّت شاوزان الطّلب
أبلَغوني بشكل مُباشر

188
00:13:42,490 --> 00:13:43,390
ماذا يجدر بنا أن نفعل؟

189
00:13:43,390 --> 00:13:45,570
هل ينبغي أن نستدرجهما ونُجابههما؟

190
00:13:48,460 --> 00:13:50,850
،لا حاجة. إن كانا مُتورّطين في هذا حقّاً

191
00:13:51,600 --> 00:13:53,220
فيستحقّان أيّ شيء يحدث

192
00:14:03,010 --> 00:14:04,220
!مُعلّم

193
00:14:04,570 --> 00:14:06,730
فكرة تعرّضك لخطر

194
00:14:06,730 --> 00:14:08,960
...بينما أبقى في الجبل مكتوف اليدين

195
00:14:09,600 --> 00:14:11,810
!لم أستطع تحمّلها ببساطة

196
00:14:12,460 --> 00:14:13,370
!مُعلّم

197
00:14:14,240 --> 00:14:16,470
سامحني هذه المرّة أرجوك

198
00:14:19,200 --> 00:14:22,600
هوانجين، هل سمعت ما قاله؟

199
00:14:22,600 --> 00:14:25,580
نزلَ من الجبل لأجلي إذاً

200
00:14:34,560 --> 00:14:37,950
مُعلّم، تكبّد لينغيو ما يكفي من إهانة

201
00:14:39,620 --> 00:14:42,180
أنا لا أسخر من زانغ لينغيو

202
00:14:42,180 --> 00:14:45,220
أنا سعيد لأجل زانغ هوايي

203
00:14:45,570 --> 00:14:47,570
،عمّك المُعلّم هذا

204
00:14:47,570 --> 00:14:52,020
بدا هادئاً جدّاً ومُنعزلاً عن العالم

205
00:14:52,360 --> 00:14:57,220
،لكن قبل أن يتحالف مع المُعلّم لخداعي

206
00:14:57,600 --> 00:15:01,790
لم أكن أدرك كم كان قويّاً

207
00:15:02,720 --> 00:15:06,430
،طوال حياتي كمُنمٍّ

208
00:15:06,430 --> 00:15:09,640
لطالما اعتقدتُ بأنّني أتفوّق عليه من كلّ ناحية

209
00:15:10,030 --> 00:15:12,370
لكن اليوم أدركتُ أنّه

210
00:15:12,370 --> 00:15:15,520
من حيث الخِلافة، خسرت

211
00:15:15,520 --> 00:15:19,240
انظروا إلى زانغ تشولان، الشّخص
الّذي تركَه خلفه

212
00:15:20,590 --> 00:15:23,290
حسناً يا زانغ لينغيو

213
00:15:23,290 --> 00:15:27,600
اعتباراً من الآن، لم تعُد تلميذاً لتينشيفو

214
00:15:28,660 --> 00:15:31,930
لم أعُد مُعلّمك

215
00:16:00,360 --> 00:16:06,720
...يُقال بأنّ فتيات يوزو جميلات

216
00:16:12,240 --> 00:16:14,310
...آنسة باو، ما الّذي

217
00:16:15,850 --> 00:16:16,970
سيّارة سان

218
00:16:16,970 --> 00:16:18,080
تحتاج صيانة

219
00:16:18,080 --> 00:16:19,640
عازل الصّدمات رخو قليلاً

220
00:16:20,000 --> 00:16:21,650
تُجيدين إصلاح السّيّارات؟

221
00:16:21,650 --> 00:16:23,000
...هذا مُذهل

222
00:16:23,000 --> 00:16:24,870
أجل، هذا ليس صعباً

223
00:16:24,870 --> 00:16:28,430
مواسير الوقود، الدّارات، الهوائيّات، قطع
التّحريك. هذا كلّ شيء

224
00:16:28,720 --> 00:16:30,930
مُبهر. مُبهر حقّاً

225
00:16:31,690 --> 00:16:34,180
حقّاً؟ كثير من النّاس يستطيعون فعل ذلك

226
00:16:37,650 --> 00:16:38,540
انتهيت

227
00:16:43,720 --> 00:16:44,630
أتريد أن تأكل؟

228
00:16:46,200 --> 00:16:47,060
شكراً لكِ

229
00:17:09,330 --> 00:17:12,520
آنسة باو، منذ متى كنتِ مع الشّركة؟

230
00:17:19,750 --> 00:17:22,780
...سنوات كثيرة

231
00:17:24,080 --> 00:17:26,160
هذا يجعلك تبدو عجوزاً

232
00:17:26,160 --> 00:17:27,840
ماذا تفعل في الشّركة؟

233
00:17:27,840 --> 00:17:31,600
ما يطلبه منّي سان، أو سي، أو زانغ تشولان فعله

234
00:17:29,430 --> 00:17:31,600
تشولان، ما رأيك؟

235
00:17:32,020 --> 00:17:33,050
تشولان؟

236
00:17:34,390 --> 00:17:35,100
هذا جيّد

237
00:17:35,420 --> 00:17:37,890
سأتّبع ترتيباتك يا حضرة الرّئيس زاو

238
00:17:38,160 --> 00:17:40,470
المعذرة... ماذا عن ذلك الشّخص؟

239
00:17:43,000 --> 00:17:45,640
عمّي، هل انسجمت مع باور؟

240
00:17:47,340 --> 00:17:49,470
زانغ تشولان، تعال إلى هنا

241
00:17:49,920 --> 00:17:51,810
،بحسب وصف الآنسة باو

242
00:17:51,810 --> 00:17:53,170
...يبدو أنّ الشّركة

243
00:17:53,860 --> 00:17:56,030
،حتّى لو أنا، زانغ لينغيو، مررتُ بأوقات عصيبة

244
00:17:56,030 --> 00:17:58,560
!مُحال أن أفعل شيئاً يُنافي ضميري

245
00:17:58,560 --> 00:18:00,720
إنّها مُميّزة! عملها مُميّز

246
00:18:01,090 --> 00:18:02,520
كيف للشّركة أن تتصرّف بهذا الطّيش؟

247
00:18:02,520 --> 00:18:05,430
إن كنت لا تثق بالشّركة، فينبغي
!أن تثق بي على الأقلّ

248
00:18:05,430 --> 00:18:06,680
أخالفك من هذه النّاحية

249
00:18:07,020 --> 00:18:09,560
إذاً ينبغي لك أن تثق بضميرك على الأقلّ

250
00:18:09,920 --> 00:18:13,090
من الآن فصاعداً، سيترتّب عليك تجربة
كلّ شيء بنفسك

251
00:18:13,090 --> 00:18:14,810
لا يستطيع أحدٌ أن يملي عليك ما يجب فعله

252
00:18:14,810 --> 00:18:17,380
كلّ ما يمكنني قوله هو أنّه
،من أجل البقاء

253
00:18:17,380 --> 00:18:21,060
لا أمانع ظروفاً مُبهَمة والقيام بأشياء
لا أفضّل القيام بها

254
00:18:21,910 --> 00:18:23,690
،لكن إذا تخطّى الأمر حدودي

255
00:18:24,610 --> 00:18:26,520
فاللّعنة على كلّ ذلك إذاً

256
00:18:27,940 --> 00:18:31,310
مُعلّم، أعتقد أيضاً بأنّ لديك حدود

257
00:18:31,710 --> 00:18:33,600
بالمناسبة، لديك عمل

258
00:18:34,050 --> 00:18:37,770
عملك الأوّل هو حمايتي

259
00:18:37,770 --> 00:18:39,180
ما رأيك بهذا؟

260
00:18:39,180 --> 00:18:41,060
هذا لا يُنافي ضميرك، صحيح؟

261
00:18:49,640 --> 00:18:53,660
ممتاز يا سيّد شاوشاو. تقنيّة
تنفّسك ممتازة

262
00:18:53,660 --> 00:18:56,060
كنتَ مُفيداً جدّاً. شكراً

263
00:18:56,460 --> 00:18:59,270
هذا لا يعني شيئاً. أسدت لي الرّئيسة
تشو معروفاً كبيراً

264
00:18:59,770 --> 00:19:01,240
،أيّاً كان الطّلب

265
00:19:01,240 --> 00:19:03,120
،ما دامت هي من تطلب

266
00:19:03,120 --> 00:19:04,600
فسوف أفعلها

267
00:19:04,600 --> 00:19:05,830
هذا صحيح

268
00:19:05,830 --> 00:19:09,270
تقريباً الجميع هنا قد ساعدتهم
أختاه في مرحلة ما

269
00:19:09,680 --> 00:19:12,570
لهذا السّبب غالباً لا يستطيع أحدٌ رفضها

270
00:19:12,570 --> 00:19:14,450
هذا هو مصدر سحرها

271
00:19:16,310 --> 00:19:20,180
هذا الأتون قد صُنِعَ بواسطة أختاه
باستخدام الحرفيّة القدسيّة

272
00:19:20,180 --> 00:19:21,870
،بالإضافة إلى سُبلِها الخاصّة

273
00:19:21,870 --> 00:19:24,520
لاستعادة ذكرياتي المفقودة

274
00:19:24,520 --> 00:19:27,220
لكن أريد استخدام ذلك لمُساعدة مزيد من النّاس

275
00:19:27,680 --> 00:19:29,500
أريد أن أصبح شخصاً مثل أختاه

276
00:19:31,060 --> 00:19:32,440
أنت تبقى أنت

277
00:19:32,440 --> 00:19:34,070
لماذا تريد أن تصبح أنا؟

278
00:19:36,720 --> 00:19:38,270
!أختاه، عدتِ

279
00:19:38,270 --> 00:19:40,700
شاوشاو، من فضلك اخرج قليلاً

280
00:19:49,050 --> 00:19:51,160
من جديد يا أختاه؟

281
00:19:51,160 --> 00:19:53,220
لم أحتج لتناول هذا منذ زمن بعيد

282
00:19:53,220 --> 00:19:55,470
تناوله. كُن مُطيعاً

283
00:19:55,920 --> 00:20:00,020
أختاه، آنذاك قلتِ بأنّ السّبب هو
...أنّ حالتي العقليّة غير مُستقرّة

284
00:20:00,020 --> 00:20:01,180
!تناوله

285
00:20:01,180 --> 00:20:03,270
...لكن الآن لا أشعر بأنّ عقلي

286
00:20:03,670 --> 00:20:05,280
!تناوله

287
00:21:03,840 --> 00:21:05,720
مرحباً يا حضرة الرّئيس زاو؟

288
00:21:06,400 --> 00:21:08,370
أبلغني عندما تكون جاهزاً

289
00:21:08,370 --> 00:21:10,300
يمكن إرسال المسودّة في أيّ وقت

290
00:21:12,410 --> 00:21:14,640
لِمَ لا تنجزين العمل؟

291
00:21:14,640 --> 00:21:17,710
!فقط أزيلي كلّ ذكرياته عن قرية بيو

292
00:21:17,710 --> 00:21:20,530
،إذا شعرتِ بأنّ ثِقته بكِ بدأت تهتزّ

293
00:21:20,530 --> 00:21:21,660
!فاغرسيه بشكل أعمق

294
00:21:21,660 --> 00:21:25,140
،يستطيع العقل السّليم إصلاح نفسه

295
00:21:25,140 --> 00:21:26,990
كما تعلم جيّداً

296
00:21:26,990 --> 00:21:28,430
،بعد علاجات مُتكرّرة

297
00:21:28,430 --> 00:21:31,470
أصبح عقله غير مُستقرّ إطلاقاً بالفعل

298
00:21:31,470 --> 00:21:36,180
إن استمررنا، فأنا أخشى من عواقب غير مُتوقَّعة

299
00:21:36,180 --> 00:21:37,660
وماذا يعني؟

300
00:21:38,190 --> 00:21:40,680
!إن أصبح عديم الفائدة، تخلّصي منه

301
00:21:41,120 --> 00:21:47,060
ماذا؟ منذ متى كنتَ تتكلّم معي بهذه الطّريقة؟

302
00:21:47,060 --> 00:21:48,320
!لا

303
00:21:48,320 --> 00:21:50,900
!كـ-كنتُ قلقاً جدّاً بشأنكِ فحسب

304
00:21:51,890 --> 00:21:53,720
أعطيتُه العقاقير بالفعل

305
00:21:53,720 --> 00:21:56,930
ما لم يوقظه أحدٌ، سينام لمدّة أسبوع على الأقلّ

306
00:21:56,930 --> 00:21:58,350
ما دمتِ تمتلكين خطّة

307
00:21:59,020 --> 00:22:00,750
دعيني أوضّح هذا لكِ

308
00:22:00,750 --> 00:22:03,020
أولئك الأشخاص القلّة يتحرّكون من جديد

309
00:22:03,020 --> 00:22:04,710
توخّي الحذر

310
00:22:07,330 --> 00:22:08,770
أغلق الخطّ

311
00:22:11,350 --> 00:22:15,010
رِفاق، هل تعتقدون بأنّ هذا سينجح حقّاً؟

312
00:22:15,010 --> 00:22:17,720
!تخلّيتُ عن عملٍ مُربح للمجيء إلى هنا