1
00:02:19,700 --> 00:02:21,850
...كقطّ ديسَ على ذيله

2
00:02:22,080 --> 00:02:23,750
...هذا مُثير للاهتمام

3
00:02:23,750 --> 00:02:25,720
احترقتُ نتيجة الاقتراب بشكل
طائش قبل قليل

4
00:02:25,960 --> 00:02:28,120
،بالنّظر بتمعُّن إلى هذا الضّوء الذّهبيّ

5
00:02:28,120 --> 00:02:30,920
يبدو أنّه عندما يظهر ذلك
،الشّريط الأبيض

6
00:02:33,470 --> 00:02:35,190
لا يهمّ

7
00:02:35,190 --> 00:02:37,770
تحسّستُه أوّل مرّة عندما اختبرتُه
بيدين عاريتين

8
00:02:38,100 --> 00:02:39,710
...هذا الإحساس

9
00:02:39,710 --> 00:02:41,100
أستطيع اختراقه

10
00:02:41,390 --> 00:02:43,770
...بالنّسبة للّحظة المُناسبة للهجوم

11
00:02:47,350 --> 00:02:50,560
مُعلّم وانغ، ما نوع الدّرس الخاصّ
الّذي سنحضره اليوم؟

12
00:02:50,860 --> 00:02:52,110
إنّه بسيط

13
00:02:52,110 --> 00:02:55,020
راوغي أو تصدّي لصفعتي الثّانية

14
00:03:06,880 --> 00:03:09,240
هل كنتُ سريعاً حقّاً للتو؟

15
00:03:09,240 --> 00:03:12,100
لو كانت معركة حقيقيّة، أما كنتِ
لتستجيبي في الوقت؟

16
00:03:13,470 --> 00:03:14,680
إطلاقاً

17
00:03:14,680 --> 00:03:16,440
انسي الصّفعة الأولى

18
00:03:16,440 --> 00:03:18,220
لماذا لم تُراوغي الثّانية؟

19
00:03:20,220 --> 00:03:24,100
اليوم، سأُعلّمكِ الوقتَ
الصّحيح للهجوم

20
00:03:24,520 --> 00:03:27,230
دعيني أشرح حالتكِ الآن

21
00:03:27,230 --> 00:03:30,000
عندما سمعتِني أقول "تصدّي
،"للصّفعة الثّانية

22
00:03:30,000 --> 00:03:32,850
ساورَتكِ لحظة إضافيّة من الشكّ

23
00:03:33,120 --> 00:03:36,390
إذاً، متى هاجمتُ فعليّاً؟

24
00:03:37,290 --> 00:03:39,180
!في اللّحظة الّتي فكّرتُ فيها بذلك

25
00:03:40,400 --> 00:03:42,560
اقتربتِ، لكن هذا ليس صحيحاً تماماً

26
00:03:42,860 --> 00:03:45,350
،ما لونغ موهوب في هذا المجال

27
00:03:45,350 --> 00:03:47,630
وبدأ هذا الدّرس قبلكِ

28
00:03:47,630 --> 00:03:49,210
سوف يُعلّمكِ

29
00:03:49,210 --> 00:03:51,830
اليوم، ستبقيان معاً

30
00:03:51,830 --> 00:03:54,460
استمرّا في البحث عن ثغرات
لمُهاجمة بعضكما الآخر

31
00:03:54,460 --> 00:03:56,640
!يدان مُجرّدتان، بلا أسلحة

32
00:03:58,320 --> 00:04:00,480
!أختي تاو، آسف بشأن هذا

33
00:04:00,480 --> 00:04:03,520
!أُستاذ ما، لا تتساهل معي

34
00:04:08,240 --> 00:04:09,180
...أختي تاو

35
00:04:11,520 --> 00:04:12,770
لن أضربكِ

36
00:04:13,120 --> 00:04:14,300
حقّاً؟

37
00:04:15,520 --> 00:04:17,630
لن أضربكِ خلال السّاعة المُقبلة

38
00:04:17,630 --> 00:04:20,180
أنتِ فقط من يستطيع ضربي، اتّفقنا؟

39
00:04:20,180 --> 00:04:21,220
!اتّفقنا

40
00:04:24,000 --> 00:04:25,610
!كنتَ تضربني طوال الصّباح

41
00:04:25,610 --> 00:04:27,230
!ولم أُصبك سوى بضربتين أو ثلاثة

42
00:04:27,230 --> 00:04:28,830
كيف فعلتها؟

43
00:04:28,830 --> 00:04:30,390
!أخبرني، وإلّا غضبت

44
00:04:30,660 --> 00:04:32,960
استخدام الهجوم الفوريّ هو غشّ

45
00:04:32,960 --> 00:04:36,220
فضلاً عن ذلك، ألم تصدّي العديد
من هجماتي أيضاً؟

46
00:04:36,620 --> 00:04:39,360
،حالما أقبض عليكِ فاقدةً للتّركيز
أستطيع إصابتكِ بضربة

47
00:04:39,360 --> 00:04:41,760
،إن لم أُلتقط هذه اللّحظة
،أو أسأتُ الحُكم

48
00:04:41,760 --> 00:04:42,850
حينها ستتصدّين لها

49
00:04:44,460 --> 00:04:46,170
تقبض عليّ فاقدةً للتّركيز؟

50
00:04:46,170 --> 00:04:47,390
ألديك قِوى قراءة الأفكار؟

51
00:04:47,390 --> 00:04:49,510
بالطّبع لا أملك قِوى قراءة الأفكار

52
00:04:49,510 --> 00:04:51,350
أنا حتماً لا أستطيع قراءة أفكاركِ

53
00:04:51,350 --> 00:04:55,120
لكن إذا لم أستطع رؤيتها، فتلك
الأفكار تنتمي لكِ فعلاً

54
00:04:55,120 --> 00:04:56,820
،إن لم تكن تنتمي لكِ

55
00:04:56,820 --> 00:04:58,590
فحينئذ تُعَدُّ مُجرّد إلهاء

56
00:04:58,590 --> 00:05:00,350
وقد أتمكّن من التقاطها

57
00:05:00,720 --> 00:05:01,780
...تابع

58
00:05:01,780 --> 00:05:03,600
تقريباً الجميع في هذا العالم

59
00:05:03,600 --> 00:05:05,770
لديهم مجموعتان من الأفكار

60
00:05:05,770 --> 00:05:08,890
،أفكار تنتمي لكِ فعلاً، وتتحكّمين بها

61
00:05:08,890 --> 00:05:10,810
وأفكار يُعتقَد بالخطأ بأنّها
،تنتمي لكِ

62
00:05:10,810 --> 00:05:13,560
لكنّها في الواقع مُجرّد أفكار قائمة بذاتها

63
00:05:14,750 --> 00:05:15,640
ما الفرق؟

64
00:05:15,640 --> 00:05:17,680
أفكاركِ تنتمي لكِ كُلّياً

65
00:05:17,680 --> 00:05:18,950
،أنتِ من يتحكّم بها

66
00:05:18,950 --> 00:05:21,470
ويمكنكِ تحويلها إلى أفعال
%طوال الوقت بنسبة 100

67
00:05:21,470 --> 00:05:23,060
يمكنكِ أيضاً إيقافها في أيّ لحظة

68
00:05:23,060 --> 00:05:25,070
..."لكن وحش "التّفكير

69
00:05:25,070 --> 00:05:27,780
هو في الواقع ما اعتمدتِ عليه دوماً

70
00:05:27,780 --> 00:05:29,220
أنتِ من تخضعين لسيطرته

71
00:05:29,220 --> 00:05:30,930
كلانا مُنمِّيان

72
00:05:30,930 --> 00:05:32,810
ينبغي أن تكوني قد فهمتِ الآن، صحيح؟

73
00:05:32,810 --> 00:05:34,880
تلك الأشياء الّتي لا يمكنكِ
مُقاطعتها بسهولة

74
00:05:34,880 --> 00:05:37,220
"جميعها إلهاءات وأوهام تُدعى "فكرة

75
00:05:37,220 --> 00:05:39,330
،"لو كانت ببساطة "أفكارك

76
00:05:39,330 --> 00:05:41,120
فلن أستطيع التّأثير بها بالطّبع

77
00:05:41,120 --> 00:05:43,350
،لكن إذا كانت أوهاماً فُرِضَتْ عليكِ

78
00:05:43,350 --> 00:05:46,220
،تلاعُبات بواسطة العالم الخارجيّ

79
00:05:46,220 --> 00:05:48,410
،فحينئذ أستطيع بالطّبع توجيهها واستغلالها

80
00:05:48,410 --> 00:05:51,850
أو حتّى إنشاء أفكار جديدة
للتحكُّم بسلوكك

81
00:05:51,850 --> 00:05:53,470
،حالما أكسب السّيطرة عليها

82
00:05:53,470 --> 00:05:55,310
...تظهر ثغرتكِ

83
00:06:06,180 --> 00:06:07,150
ماذا؟

84
00:06:07,890 --> 00:06:09,920
أفهم ما تقوله

85
00:06:09,920 --> 00:06:13,990
كلانا خضعنا لحالة التحكُّم الذّاتي
الكامل أثناء التّمرين

86
00:06:13,990 --> 00:06:18,920
حاولتُ للتو استخدام "أفكاري" للاستمرار
في مُراقبتكِ والأكل بشكل آنيّ

87
00:06:20,280 --> 00:06:21,100
كان ذلك صعباً

88
00:06:21,750 --> 00:06:24,000
،تمكّنتُ من فعلها لفترة قصيرة جدّاً

89
00:06:24,000 --> 00:06:28,480
لكن حينها أدركتُ بأنّني نسيتُ
مذاقَ الطّعام في فمي

90
00:06:28,480 --> 00:06:31,690
ثمّ يعقب ذلك حسّ الفخر
حيال إنجاز تلك الحالة

91
00:06:31,690 --> 00:06:35,100
"ثمّ لاحظتُ بأنّ تلك "الفكرة
...كانت قد نشأت بالفعل

92
00:06:35,100 --> 00:06:37,280
والآن هناك "حسرة بسيطة" أيضاً

93
00:06:38,740 --> 00:06:40,020
!هذا صعبٌ حقّاً

94
00:06:40,020 --> 00:06:42,720
،"يبدو وكأنّه كُلّما حاولتُ قمع "الأفكار
ازدادت أكثر فأكثر

95
00:06:42,720 --> 00:06:44,710
كُلّما زاد عدد الأشياء الّتي تُحاولين
،التّركيز عليها في آن واحد

96
00:06:44,710 --> 00:06:46,510
ازدادت سهولة إلهائكِ

97
00:06:46,510 --> 00:06:47,600
لا تقمعيها

98
00:06:47,600 --> 00:06:49,660
راقبيها كما هي فحسب

99
00:06:49,660 --> 00:06:51,390
،أخبرني المُعلّم وانغ ذات مرّة

100
00:06:51,390 --> 00:06:54,360
،"أنّه إذا حاول المرء قمع "الأفكار

101
00:06:54,360 --> 00:06:56,080
سيُصبح قويّاً جدّاً

102
00:06:56,080 --> 00:06:57,220
،إن لم تفعلي شيئاً

103
00:06:57,220 --> 00:06:59,200
،واكتفيتِ بمُراقبتها ومُواجهتها

104
00:06:59,200 --> 00:07:01,610
ستختفي تدريجيّاً

105
00:07:01,610 --> 00:07:03,430
"يُدعى هذا بـ"المُراقبة

106
00:07:03,430 --> 00:07:04,990
هذا أشبه بسطح الماء

107
00:07:04,990 --> 00:07:08,350
إذا عبثتِ بها، فستُشكّل موجة

108
00:07:08,350 --> 00:07:10,810
لكن إذا وقفتِ في مكانٍ مُرتفع
،وراقبتِ ببساطة

109
00:07:11,190 --> 00:07:14,350
فلن تملك الأفكار خياراً سوى
الهدوء من جديد

110
00:07:14,350 --> 00:07:17,680
في تلك اللّحظة، أنتِ في مأمن

111
00:07:17,680 --> 00:07:20,560
،بمُواجهة الأفكار التّضليليّة دون استجابة
تكسبين الحرّيّة

112
00:07:20,560 --> 00:07:23,320
الشّخص الحُرّ ليس قطعة خشب جامدة

113
00:07:23,320 --> 00:07:25,100
الشّخص الحُرّ قادر على أيّ شيء

114
00:07:25,380 --> 00:07:27,990
زانغ تشولان... مُدهش

115
00:07:27,990 --> 00:07:30,410
،من وميض الضّوء المُبهر حتّى الآن

116
00:07:30,410 --> 00:07:32,060
كان أداؤك يفوق توقُّعاتي

117
00:07:32,400 --> 00:07:35,600
تمكّنتَ من البقاء مُركِّزاً على هذا
النِّزال طوال هذا الوقت

118
00:07:35,600 --> 00:07:38,790
،إذا، في تلك اللّحظة الحاسِمة المُقبلة

119
00:07:38,790 --> 00:07:41,140
...ما زلتَ لا تُظهِر لي ثغرةً واضحة

120
00:07:41,140 --> 00:07:44,960
إذا تمكّنت من تجنُّب توليد
،تلك "الأفكار" المُضلِّلة

121
00:07:44,960 --> 00:07:46,810
فسأدعك تفلت هذه المرّة

122
00:07:47,260 --> 00:07:49,600
!تمّ استعادة... الرّؤية

123
00:07:56,710 --> 00:07:57,930
!لسوء حظّك

124
00:08:19,000 --> 00:08:22,390
متى اقتربتْ إلى هذا الحدّ؟

125
00:08:22,390 --> 00:08:23,850
...لولا باور

126
00:08:37,050 --> 00:08:39,510
!ولا حتّى فكرة مُضلِّلة في لحظة كهذه

127
00:08:39,510 --> 00:08:41,180
!إلحاح إنقاذ شخص

128
00:08:41,180 --> 00:08:43,420
!الرّاحة في لحظة إنقاذ ناجح

129
00:08:43,420 --> 00:08:44,940
لا شيء إطلاقاً؟

130
00:08:45,490 --> 00:08:47,350
،أثناء يقظتك العالية ضدّي

131
00:08:47,350 --> 00:08:49,500
تمكّنتِ من إيجاد شريككِ وإنقاذه

132
00:08:49,500 --> 00:08:52,890
البقاء في حالة تركيز على كلّ هذه الأشياء
...دون فكرة مُشتِّتة واحدة

133
00:08:54,020 --> 00:08:56,850
ألا... تشعرين بشيء إطلاقاً؟

134
00:09:00,440 --> 00:09:01,130
...أنت

135
00:09:02,450 --> 00:09:04,680
ما الّذي أُفكّر فيه حتّى؟

136
00:09:22,640 --> 00:09:23,970
!احذري من تلك الفُقاعات

137
00:09:51,800 --> 00:09:53,310
ما هذا؟

138
00:09:54,660 --> 00:09:56,380
!لا يمكنهم حتّى كسر فُقاعات تشي

139
00:10:01,650 --> 00:10:02,390
!انظر

140
00:10:07,500 --> 00:10:08,560
!باوباو

141
00:10:07,500 --> 00:10:08,560
!زانغ تشولان

142
00:10:17,040 --> 00:10:18,130
واحدة أُخرى

143
00:10:48,080 --> 00:10:50,180
شا ليوتشينغ، ألم تنتهِ بعد؟

144
00:10:57,860 --> 00:11:00,000
،أيّها الأطفال

145
00:11:00,000 --> 00:11:03,380
ماذا تنتظرون؟

146
00:11:07,810 --> 00:11:10,770
...تبّاً... إنّ شا

147
00:11:11,930 --> 00:11:12,600
!انظروا

148
00:11:15,220 --> 00:11:17,910
،ثمّة وادٍ عميق أمامنا

149
00:11:17,910 --> 00:11:20,720
!كما قال تشيوشان بالضّبط

150
00:11:20,720 --> 00:11:22,490
!اذهبوا! اذهبوا بسرعة

151
00:11:22,490 --> 00:11:27,100
!سيتصدّى لهم هذا الجِنرال لأجلكم

152
00:11:28,480 --> 00:11:31,640
!عُلِم. شا، لا تضغط على نفسك كثيراً

153
00:11:35,560 --> 00:11:37,810
!لماذا تقفان؟ هيّا

154
00:11:43,870 --> 00:11:46,810
...شا ليوتشنغ، أنت

155
00:11:55,040 --> 00:11:56,540
!زانغ تشولان

156
00:11:56,540 --> 00:12:00,600
!لا يهمّ، احرص على سلامة جينفينغ

157
00:12:00,600 --> 00:12:02,870
عُلِم! لا أعدك بأن أكون
،مُشرِّفاً جدّاً

158
00:12:02,870 --> 00:12:04,880
،لكن ما دام هذا لا يُكلّفنا أرواح أحدنا

159
00:12:04,880 --> 00:12:06,550
!فسأدفع أيّ ثمن آخر

160
00:12:07,540 --> 00:12:09,270
!عظيم

161
00:12:12,430 --> 00:12:14,220
!لن تتمكّنوا من تجاوزي

162
00:12:16,470 --> 00:12:19,850
!شا ليوتشينغ، لقد كشفتُ خدعك

163
00:12:19,850 --> 00:12:21,440
!تعال إليّ

164
00:12:21,440 --> 00:12:23,240
،حتّى لو أزحتَني جانباً الآن

165
00:12:23,240 --> 00:12:25,520
ستدفعني نحو الجهة حيث
أستطيع التصدّي لها

166
00:12:32,050 --> 00:12:33,640
!لم يفلح هذا أيضاً

167
00:12:34,270 --> 00:12:35,180
!هيّا

168
00:12:38,370 --> 00:12:39,350
!الجدّة

169
00:12:46,420 --> 00:12:46,970
!المعذرة

170
00:13:14,590 --> 00:13:15,970
!كيف هوجِمتُ؟

171
00:13:20,140 --> 00:13:22,160
الجدّة، لا تدعي ذلك يصرف
!انتباهكِ! بسرعة

172
00:13:22,160 --> 00:13:24,770
،كلّما وصلنا إلى ضريح تانغ أسرع
!خرج شا من دائرة الخطر أكثر

173
00:13:24,770 --> 00:13:27,240
هؤلاء القِلّة يصعب التّعامل معهم أصلاً

174
00:13:27,240 --> 00:13:29,220
حالما يصل الآخرون، سنكون جميعنا بخير

175
00:13:29,220 --> 00:13:31,520
،بما أنّ تانغ مياوشينغ منحنا هذه الفُرصة

176
00:13:31,520 --> 00:13:34,560
سنكتشف في ضريح تانغ سواء كان
!هذا برَكة أم لعنة

177
00:13:36,080 --> 00:13:37,470
...لا أستطيع تجنّبها

178
00:13:38,040 --> 00:13:39,290
...أرض وخشب

179
00:13:39,290 --> 00:13:40,040
!يانير

180
00:13:40,720 --> 00:13:42,880
ظننتُ بأنّ تلك الفتاة الّتي كنتُ أتعامل
معها شرِسة بما يكفي

181
00:13:42,880 --> 00:13:44,930
من عبث بك هكذا؟

182
00:13:44,930 --> 00:13:46,560
!يانير، هنا

183
00:13:46,560 --> 00:13:48,350
!اختبئ! اختبئ

184
00:13:49,690 --> 00:13:51,520
مظهره وتقنيّاته

185
00:13:51,520 --> 00:13:53,570
تُذكّرني بأسطورة

186
00:13:53,570 --> 00:13:54,930
هناك نسختان

187
00:13:54,930 --> 00:13:57,010
واحدة تُفيد بأنّ إمبراطور تايزونغ
،من تانغ، لي شيمين

188
00:13:57,010 --> 00:14:00,430
فشل في إنقاذ الملك التنّين الّذي قُطِع رأسه
في حلم بواسطة المُستشار وي زينغ

189
00:14:00,430 --> 00:14:03,700
والأُخرى تُفيد بأنّ والد لي شيمين أعدمَ
ظلماً الضّابط ليو وينجينغ

190
00:14:03,700 --> 00:14:07,770
ومنذ تلك اللّحظة، الأب والابن طورِدا بواسطة
أرواح شرّيرة في كلّ ليلة ولم يستطيعا النّوم

191
00:14:07,770 --> 00:14:10,140
لاحقاً، الجِنرالان يوتشي غونغ
وتشين تشيونغ تطوّعا

192
00:14:10,630 --> 00:14:12,800
للحِراسة عند بوّابة القصر لصالح الإمبراطور

193
00:14:12,800 --> 00:14:16,020
بعد ذلك، الإمبراطوران غاوزونغ وتايزونغ
تمكّنا أخيراً من النّوم بسلام

194
00:14:16,020 --> 00:14:17,930
منذ تلك اللّحظة، آمن النّاسُ بأنّ

195
00:14:17,930 --> 00:14:20,450
صُور هذين الجِنرالين تستطيعان
،طرد الأرواح الشّرّيرة

196
00:14:20,450 --> 00:14:21,890
وحماية الدِّيار

197
00:14:21,890 --> 00:14:24,920
!تقنيّة هذا العجوز مُشابهة جدّاً لتلك الأسطورة

198
00:14:24,920 --> 00:14:28,450
،حالما يكشف موقفك بالضّبط
يستطيع دفعك بعيداً

199
00:14:28,450 --> 00:14:30,900
،لا تنبعث قوّةُ الضّغط من اتّجاهه

200
00:14:30,900 --> 00:14:34,300
إنّما تُولَّد مُباشرة من داخل جسدك
!في لحظة رؤيته لك

201
00:14:34,300 --> 00:14:36,350
!ويستطيع التحكُّم بجهة هذه القوّة

202
00:14:36,730 --> 00:14:39,210
!ما لم يعجز عن رؤيتك، لا يمكن مُراوغته

203
00:14:39,690 --> 00:14:42,640
لحسن الحظّ، هذه القوّة الدّافعة
لا تؤذي الهدف

204
00:14:42,640 --> 00:14:44,560
!حتّى لو لم تؤذِ، تبقى مُزعجة

205
00:14:44,560 --> 00:14:46,740
بحسب وصفك، لا يملك هذا
العجوز نقطةَ ضعف

206
00:14:46,740 --> 00:14:48,430
!إنّه يسدّ طريقنا

207
00:14:49,250 --> 00:14:51,310
لا نستطيع نحن الاثنان تجاوزه حتماً

208
00:14:51,310 --> 00:14:53,060
...حتّى لو ذهبنا معاً، لا يمكننا

209
00:14:53,410 --> 00:14:55,340
...لكن إذا تعاونّا معاً، رُبّما

210
00:14:55,340 --> 00:14:57,340
،الهجوم بوضع نقاط الضّعف بعين الاعتبار

211
00:14:57,340 --> 00:14:59,720
ألم يُدرَّب كُلّ عضو في عشيرة
تانغ على ذلك؟

212
00:15:00,070 --> 00:15:01,200
عُلِم

213
00:15:01,200 --> 00:15:02,930
يانير، تولَّ القيادة

214
00:15:05,920 --> 00:15:07,390
...بهذا المجال من الرّؤية

215
00:15:07,390 --> 00:15:10,550
،أيّ كانت الجهة الّتي تأتون منها أيُّها الجرذان

216
00:15:10,550 --> 00:15:14,850
!لن تفلتوا من عيني الإلهيّة

217
00:15:36,180 --> 00:15:38,430
الإيهام بالتوجُّه شرقاً ثمّ
!الهجوم غرباً؟ سريع للغاية

218
00:15:38,680 --> 00:15:40,860
تبقى الفُقاعات فُقاعات، وأنا هو أنا

219
00:15:40,860 --> 00:15:43,160
ما دمت تعتقد ذلك ولو للحظة، فهذا يكفي

220
00:15:46,850 --> 00:15:48,430
!المسافة كافية

221
00:15:51,420 --> 00:15:52,350
!فرقعة

222
00:15:54,430 --> 00:15:55,300
!نلتُ منه

223
00:16:06,040 --> 00:16:07,720
!إذاً إنّه ليس بحاجة للرّؤية حتّى

224
00:16:10,340 --> 00:16:14,810
،لكن... إذا لم يتمّ تأكيد الهدف
!تغدو قوّةُ الدّفع أضعف

225
00:16:18,100 --> 00:16:22,390
تانغ مياوشينغ، تريدني أن أتساهل
مع هؤلاء الأطفال؟

226
00:16:22,390 --> 00:16:24,720
!أنت تحترمني كثيراً

227
00:16:25,970 --> 00:16:27,810
!إنّه الأخطبوط

228
00:16:29,470 --> 00:16:30,870
...فقط اصمد لثانيتين إضافّيتين

229
00:16:30,870 --> 00:16:32,620
!لا! ثانية واحدة كافية

230
00:16:32,620 --> 00:16:34,020
...ثانية واحدة من الرّؤية وقد أستطيع

231
00:16:37,470 --> 00:16:40,940
...تقنيّة السُّوط تلك منيعة يا عجوز

232
00:16:41,380 --> 00:16:44,600
،لكن حالما تُركِّز على دفع شخص بعيداً

233
00:16:45,140 --> 00:16:47,470
تصبح مليئاً بالثّغرات

234
00:16:52,820 --> 00:16:53,770
هل نلنا منه؟

235
00:16:58,140 --> 00:16:59,520
الحق به! ما لونغ؟

236
00:17:00,560 --> 00:17:02,180
!لِمَ أنت شارد؟ ما لونغ

237
00:17:02,470 --> 00:17:03,970
اسبقوني أنتم

238
00:17:24,330 --> 00:17:26,220
آسف بشأن هذا يا شا ليوتشينغ

239
00:17:26,220 --> 00:17:28,600
رغم أنّنا لا نضمر ضغينة
،تجاه بعضنا الآخر

240
00:17:28,600 --> 00:17:31,270
!أحتاجك لتُمثّل درساً لي

241
00:17:32,090 --> 00:17:33,470
هذا صحيح

242
00:17:33,470 --> 00:17:36,480
!درس عمليّ ممتاز

243
00:17:38,480 --> 00:17:41,200
عشيرة تانغ لم تتبارز مع أحد
،في الأيّام الخوالي

244
00:17:41,200 --> 00:17:44,800
لذا لم يكن هناك أي خصوم، بل أهداف فقط

245
00:17:44,800 --> 00:17:49,260
وحده الموت ما ينتظر أهداف
!عشيرة تانغ! لنفعلها

246
00:17:49,260 --> 00:17:49,850
عُلِم

247
00:17:50,420 --> 00:17:52,220
هل هذا مُناسب حقّاً يا مُعلّم وانغ؟

248
00:17:54,300 --> 00:17:57,470
يمكنك مُعاملة الآخرين
كما ترونه مُناسباً

249
00:17:57,470 --> 00:18:00,350
لكن شا ليوتشينغ وجينفينع
!من تشوان شينغ

250
00:18:00,900 --> 00:18:05,310
،أتذكّر بأنّني أكّدتُ لكم ذلك آنذاك

251
00:18:05,310 --> 00:18:07,270
بأنّ قتل هؤلاء لم يكن بالصّعب

252
00:18:07,270 --> 00:18:09,350
لن يستهدفكم أحدٌ بسبب ذلك

253
00:18:09,760 --> 00:18:14,230
شا ليوتشينغ ارتكبَ كثيراً
!من الأفعال الشّرّيرة في شبابه

254
00:18:16,020 --> 00:18:19,600
جميعكم تلقّيتُم أكثر تدريب
،تقليديّ لعشيرة تانغ

255
00:18:19,600 --> 00:18:24,600
لكنّكم لم تفعلوا أبداً أكثر
ما تبرع فيه عشيرةُ تانغ

256
00:18:24,600 --> 00:18:27,060
...لذا، افعلوها

257
00:18:27,060 --> 00:18:29,350
!ولا سيّما شا ليوتشينغ

258
00:18:29,820 --> 00:18:33,390
هذا صحيح! أدّيتُ كُلَّ التّدريب
،لأصبح مُغتالاً

259
00:18:33,820 --> 00:18:35,700
!لكن لم أتجاوز الباب

260
00:18:36,220 --> 00:18:40,140
!ما أفتقره هو عزيمة زهق روح

261
00:18:40,470 --> 00:18:42,370
أنت هو درسي

262
00:18:42,370 --> 00:18:43,930
،بعد هذا الدّرس

263
00:18:43,930 --> 00:18:48,310
الجانب البارد والقاسي والمُتعطّش
!للدّماء سيستيقظ في داخلي

264
00:18:48,310 --> 00:18:54,430
سأفتح الباب المُؤدّي إلى تلك القاعة
!القاتمة الدّمويّة، ومع ذلك الأنيقة والغامضة

265
00:18:57,350 --> 00:18:59,970
!افعلها يا ما لونغ

266
00:19:01,160 --> 00:19:02,600
،يا فتى

267
00:19:02,940 --> 00:19:05,430
لم تقتل أحداً من قبل، أليس كذلك؟

268
00:19:08,470 --> 00:19:13,470
شا ليوتشينغ، ألا ترى بأنّني أُشعّ
بهالة نيّة القتل الآن؟

269
00:19:18,280 --> 00:19:20,390
!لا تُثِرني على الضّحك

270
00:19:20,390 --> 00:19:24,070
أنت... أتحاول قتلي أثناء الضّحك؟

271
00:19:24,600 --> 00:19:28,210
حتّى لو تركتني وحيداً، سينتهي
أمري قريباً على أيّ حال

272
00:19:29,100 --> 00:19:31,440
،لا تُشعّ منك نيّة قتل

273
00:19:31,440 --> 00:19:33,430
!تُشعّ منك الحماقة

274
00:19:35,520 --> 00:19:37,480
هل تحسب بأنّني لن أجرؤ على قتلك؟

275
00:19:37,480 --> 00:19:40,430
أنت وغد لا يستطع التّمييز
!بين الصّواب والخطأ

276
00:19:40,430 --> 00:19:41,680
!سيكون قتلك بلا جدوى

277
00:19:42,840 --> 00:19:48,930
صحيح، لكنّني أعرف الفرق بين الصّواب
والخطأ، وبين الخير والشّرّ

278
00:19:48,930 --> 00:19:51,850
اخترتُ الشّرَّ فحسب، هذا كُلّ شيء

279
00:19:52,510 --> 00:19:56,950
،لا أعرف ما الّذي أصابك

280
00:19:56,950 --> 00:19:59,850
بالتّلويح بذراعيك نحوي هكذا

281
00:19:59,850 --> 00:20:05,210
!أنت... أرنب صغير لطيف

282
00:20:06,310 --> 00:20:08,270
!من تنعته بالأرنب؟

283
00:20:08,270 --> 00:20:11,930
ابن آوى يأكل النّاس لأنّه
جائع في نهاية المطاف

284
00:20:11,930 --> 00:20:15,000
لا حاجة للتّحضير النّفسيّ

285
00:20:15,000 --> 00:20:15,720
...أنت

286
00:20:18,770 --> 00:20:20,020
!مُعلّم وانغ

287
00:20:20,520 --> 00:20:23,430
متى... وصلتُما إلى هنا؟

288
00:20:23,720 --> 00:20:25,720
عندما كان يُناديك بالأرنب الصّغير

289
00:20:25,720 --> 00:20:27,370
هل أنت مُتوتّر جدّاً على الشُّعور بنا؟

290
00:20:27,370 --> 00:20:27,890
!اصمت

291
00:20:28,310 --> 00:20:29,700
!مُعلّم وانغ، راقب

292
00:20:29,700 --> 00:20:31,220
!سأتعامل مع شا ليوتشينغ الآن

293
00:20:33,440 --> 00:20:34,890
...انسَ الأمر

294
00:20:34,890 --> 00:20:36,670
أوقف نزيفَه أوّلاً

295
00:20:36,670 --> 00:20:38,600
سنأخذه معنا لاحقاً

296
00:20:38,600 --> 00:20:40,480
!لا بأس أيّها المُغتال الأرنب

297
00:20:40,480 --> 00:20:41,630
...أسقطتَ شا ليوتشينغ

298
00:20:41,630 --> 00:20:43,310
!انقلع! إلى أبعد مسافة مُمكنة

299
00:20:43,310 --> 00:20:46,100
كم شخصاً تعاملت معه؟

300
00:20:46,100 --> 00:20:48,070
،في الواقع... لو لم تُوقفني

301
00:20:48,070 --> 00:20:49,570
!لكنتُ قد قضيتُ على شا ليوتشينغ

302
00:20:49,570 --> 00:20:50,720
...بالنّسبة للآخرين

303
00:20:53,980 --> 00:20:57,470
لا أعلم ما إن كنتُ يجب
أن أكون سعيداً أو حزيناً

304
00:21:03,180 --> 00:21:07,250
شيطان الجثّة... ليو ليانغ... ودينغ
داوان يقودان المسير

305
00:21:07,250 --> 00:21:08,530
قاتلتُهما من قبل

306
00:21:08,530 --> 00:21:10,640
!إنّهما حتماً أقوى من شا ليوتشينغ

307
00:21:17,180 --> 00:21:18,850
...المُعلّم وانغ! هذا

308
00:21:19,440 --> 00:21:20,350
،دينغ داوان

309
00:21:20,350 --> 00:21:23,430
سأحتفظ بشا ليوتشينغ حيّاً

310
00:21:23,770 --> 00:21:25,570
ولِمَ أكترث إن كان حيّاً أو ميّتاً؟

311
00:21:25,570 --> 00:21:26,500
أين العجوز جينفينغ؟

312
00:21:26,500 --> 00:21:28,180
!دينغ

313
00:21:28,180 --> 00:21:30,350
لستَ مُخطئاً

314
00:21:30,350 --> 00:21:33,100
!لكن قول ذلك يُفقدني ماء وجهي

315
00:21:33,680 --> 00:21:35,360
،وأنت أيّها الطّفل

316
00:21:35,360 --> 00:21:37,260
لماذا أنت مُتحمّس دوماً
لرؤية عزيزتي جينفينغ؟

317
00:21:37,260 --> 00:21:38,560
!سألتني مرّات عديدة

318
00:21:38,560 --> 00:21:40,490
سمعتُ بأنّه بين أشرار تشوان
،شينغ آنذاك

319
00:21:40,490 --> 00:21:41,930
،كانت هناك فتاة لم ترتكب شرّاً يوماً

320
00:21:42,300 --> 00:21:45,510
وبأنّها رّوضَتِ الشّرسَ شا
ليوتشينغ كُلّياً

321
00:21:45,510 --> 00:21:48,220
من الطّبيعيّ أن أهتمّ بلقاء
عجوز مُثيرة للاهتمام كهذه

322
00:21:49,550 --> 00:21:52,220
جينفينغ الّتي يتكلّمون عنها
!مرّتْ من هنا

323
00:21:52,220 --> 00:21:53,540
!المُعلّم وانغ، بسرعة

324
00:21:53,540 --> 00:21:55,970
وإلّا قد يصل أولئك الأشخاص
!إلى ضريح تانغ

325
00:21:57,920 --> 00:21:59,020
...لا داعي للعجلة

326
00:21:59,020 --> 00:22:01,720
لا داعي؟ تلك هي الأرض
!المُقدّسة لعشيرة تانغ

327
00:22:01,720 --> 00:22:04,760
مُعلّم وانغ، لماذا يريدون أولئك الأشخاص
اقتحام ضريح تانغ؟

328
00:22:04,760 --> 00:22:07,090
بالنّسبة للغُرباء، أليست مُجرّد مقبرة؟

329
00:22:07,090 --> 00:22:08,560
سنتحدّث عن ذلك عندما نصل إلى هناك

330
00:22:08,560 --> 00:22:11,750
،بما أنّ الأمور وصلتْ إلى هنا
وجميعنا من عشيرة تانغ

331
00:22:11,750 --> 00:22:16,020
لا أعتقد بأنّهم سيدعون غُرباء
بالعيث فساداً في ضريح تانغ

332
00:22:16,350 --> 00:22:17,980
جميعنا من عشيرة تانغ؟

333
00:22:17,980 --> 00:22:19,580
...هل تقصد

334
00:22:19,580 --> 00:22:21,680
هناك أشخاص بالفعل في ضريح تانغ؟

335
00:22:22,090 --> 00:22:24,540
من "هُم"؟