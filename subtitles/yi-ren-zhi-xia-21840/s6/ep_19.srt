1
00:02:17,770 --> 00:02:21,060
تمّ التّخطيط لهذا الحرم السّكنيّ الجديد
ليكون كبيراً جدّاً

2
00:02:21,930 --> 00:02:23,600
،لكن حالما بدأ الالتحاق

3
00:02:23,600 --> 00:02:26,140
،لم يستطيعوا يضمّوا عدداً كبيراً
لذا توقّف الإنشاء

4
00:02:32,520 --> 00:02:34,470
تُرِكت هذه الأبنية القليلة مهجورة

5
00:02:34,470 --> 00:02:36,560
في العادة لا يُسمَح للتّلاميذ بالمجيء إلى هنا

6
00:02:36,940 --> 00:02:38,140
...أنتما

7
00:02:38,140 --> 00:02:39,650
...أتيتُ لأرى

8
00:02:39,650 --> 00:02:41,370
!نعلم، نعلم

9
00:02:41,370 --> 00:02:42,530
لِمَ العجلة؟

10
00:02:50,650 --> 00:02:52,060
!زانغ تشولان

11
00:02:52,060 --> 00:02:55,220
،سواء أردت رؤية العجوز أو أخي لونغ

12
00:02:55,220 --> 00:02:57,430
!سيترتّب عليك تجاوزنا أوّلاً

13
00:02:57,430 --> 00:03:00,240
!لا تُصوّر الأمر بهذا الشّكل المُخيف

14
00:03:00,920 --> 00:03:02,350
مرحباً يا زانغ تشولان

15
00:03:02,900 --> 00:03:05,220
أنا ليو فيشيونغ من عشيرة تانغ

16
00:03:09,770 --> 00:03:11,230
!مـ-مرحباً

17
00:03:15,520 --> 00:03:18,220
...يا لقلّة الاحترام

18
00:03:25,520 --> 00:03:27,270
!افتقدتُك كثيراً

19
00:03:28,550 --> 00:03:30,600
!اقترب أكثر

20
00:03:31,810 --> 00:03:33,580
لا تغترّ بنفسك

21
00:03:33,580 --> 00:03:35,390
أتينا لرؤية العجوز فعلاً

22
00:03:35,390 --> 00:03:37,440
،تصديقكم لنا من عدمه أمر عائد لكم

23
00:03:37,440 --> 00:03:40,770
لكن من التّمادي مُضايقتنا هكذا، أليس كذلك؟

24
00:03:41,210 --> 00:03:45,270
جميعكم؟ سمعتُ بأنّ زانغ تشولان
!فقط أراد رؤية العجوز

25
00:03:45,680 --> 00:03:48,760
زانغ تشولان، لماذا أحضرت الكثير من النّاس؟

26
00:03:48,760 --> 00:03:52,640
فضلاً عن ذلك، العجوز ليس شخصاً
يمكنك رؤيته متى أردت

27
00:03:52,640 --> 00:03:55,970
بما أنّكم هنا، فاتبعوا قواعد عشيرة تانغ

28
00:03:56,340 --> 00:03:57,970
حسناً، ماذا تريدون؟

29
00:03:57,970 --> 00:04:02,020
هذا بسيط. المخرج في النّهاية الأُخرى
من هذا البناء خلفي مُباشرة

30
00:04:02,320 --> 00:04:05,470
!اعبر من هنا بمفردك

31
00:04:05,470 --> 00:04:08,490
سينتظرك أحد جماعتنا عند المخرج

32
00:04:08,490 --> 00:04:09,720
سيصعد معك الجبل

33
00:04:09,720 --> 00:04:11,610
حسناً، ما رأيك يا زانغ تشولان؟

34
00:04:11,610 --> 00:04:14,970
،في حال وصلت إلى المخرج بأمان
ستكون مُؤهّلاً لرؤية العجوز

35
00:04:16,880 --> 00:04:17,850
حسناً

36
00:04:19,320 --> 00:04:20,640
راقب فحسب

37
00:04:20,640 --> 00:04:23,430
هذا التحدِّي مُخصّص لي

38
00:04:24,460 --> 00:04:27,640
!اسمعوا: كلمة الرّجل الشّهم بقيمة ذهب

39
00:04:27,640 --> 00:04:29,720
،أقبل بتحدّيك وحده

40
00:04:29,720 --> 00:04:31,320
لذا لا تتراجع عن كلامك

41
00:04:31,320 --> 00:04:34,600
لن أتراجع عن كلامي

42
00:04:39,230 --> 00:04:40,220
!سريع للغاية

43
00:04:42,100 --> 00:04:44,180
،يستطيع السُّمّ تشي اختراق الضّوء الذّهبيّ

44
00:04:44,180 --> 00:04:47,640
لكن يستطيع الضّوء الذّهبيّ عرقلة
السُّمّ تشي إلى درجة ما

45
00:04:47,640 --> 00:04:50,930
عليّ فقط تشتيت ذلك الجزء من الضّوء
الذّهبيّ قبل أن يدخل جسدي

46
00:04:50,930 --> 00:04:54,470
لن نتدخّل، لكن يمكننا المُراقبة، صحيح؟

47
00:04:54,470 --> 00:04:56,650
،فأساساً، إذا عبثتُم معه كثيراً

48
00:04:56,650 --> 00:04:58,240
فسنواجه وقتاً عصيباً في شرح الأمر

49
00:04:58,240 --> 00:04:59,350
!بالطّبع

50
00:05:17,430 --> 00:05:19,360
التّحريك الذّهنيّ؟

51
00:05:20,100 --> 00:05:22,310
ألا تستخدم عشيرة تانغ السُّمّ
والأسلحة الخفيّة؟

52
00:05:25,440 --> 00:05:27,300
أخي، ما رأيك؟

53
00:05:27,300 --> 00:05:30,050
إذا كان هذا كلّ ما لديه، فسيكون ذلك صعباً

54
00:05:30,050 --> 00:05:32,430
هناك حوالي ثلاثة في الظّلال، هذا مقبول

55
00:05:45,560 --> 00:05:47,060
يندفع للأمام مباشرة؟

56
00:06:00,350 --> 00:06:01,970
!باور! الجميع

57
00:06:02,330 --> 00:06:03,630
!هاجموا معاً

58
00:06:05,130 --> 00:06:06,020
!حسناً-
بالتّأكيد-

59
00:06:06,830 --> 00:06:08,600
!إذاً إنّها معركة جماعيّة في نهاية المطاف

60
00:06:08,600 --> 00:06:09,440
!سأُشارك

61
00:06:09,440 --> 00:06:10,270
!فينغ باوباو

62
00:06:18,480 --> 00:06:20,850
زانغ تشولان، ماذا قلت لي للتو؟

63
00:06:20,850 --> 00:06:23,310
كنّا قد اتّفقنا: كلمة الرّجل
!الشّهم من ذهب

64
00:06:23,310 --> 00:06:26,110
،كنتُ رجلاً شهماً من قبل
!لكن ليس بعد الآن

65
00:06:26,110 --> 00:06:29,640
أودّ أن أكون رجلاً شهماً، لكن
!لا أمتلك القدرة

66
00:06:29,640 --> 00:06:32,960
لو كنتُ رجلاً شهماً دوماً، هل كان أخي
لونغ ليخسر هذه الخسارة النّكراء؟

67
00:06:32,960 --> 00:06:34,670
هل كنتُم لتكرهونني إلى هذا الحدّ؟

68
00:06:36,820 --> 00:06:38,540
!أخي لو، أختي لو، المُعلّم

69
00:06:38,540 --> 00:06:39,610
هناك العديد منّا

70
00:06:39,610 --> 00:06:41,640
!إذا استمرّ في ذلك، لنتكاثر عليه

71
00:06:43,220 --> 00:06:46,320
ما هذه النّظرات؟

72
00:06:46,320 --> 00:06:48,350
مُعلّم، لماذا تتردّد؟

73
00:06:48,350 --> 00:06:51,990
،مُعظم الخطط في الحياة لا تفلح

74
00:06:51,990 --> 00:06:53,810
لكن تستمرّ الحياة، أليس كذلك؟

75
00:06:53,810 --> 00:06:56,890
ليو فيشيونغ، هل يمكنك التوقّف
عن إزعاج هذا الشّخص؟

76
00:06:56,890 --> 00:06:59,970
...رغم أنّه مُزعج أحياناً، لكن

77
00:06:59,970 --> 00:07:03,910
اصمت! زانغ تشولان، سمعتُ بأنّك
من جبل لونغو

78
00:07:03,910 --> 00:07:07,930
!لم أتوقّع أن تكون بغيضاً إلى هذا الحدّ
...حسناً، اليوم سوف

79
00:07:06,730 --> 00:07:07,930
...بئس الأمر

80
00:07:11,020 --> 00:07:13,520
صُعِقت بواسطة البرق وما زلت لا تتأدّب

81
00:07:14,500 --> 00:07:17,560
أخبرتُكِ، سيكون من الأفضل ألّا
تستعرضي هذا الشّيء

82
00:07:26,710 --> 00:07:29,880
أخي شيونغ! لا تغضب بعد، اسمعني

83
00:07:29,880 --> 00:07:32,020
هل تعرف سبب تجرُّؤي على التصرُّف
بطريقة مُخزية هنا؟

84
00:07:32,020 --> 00:07:34,060
،إن كنتَ تتّبع قواعد عشيرة تانغ فعلاً

85
00:07:34,060 --> 00:07:35,940
فما كنتُ لأجرؤ حتّى لو عشتُ
أكثر من حياة واحدة

86
00:07:35,940 --> 00:07:39,180
!أؤكّد بأنّ عشيرة تانغ ليست
لديها قاعدة كهذه

87
00:07:39,180 --> 00:07:43,600
من المُؤكَّد أنّ إيقافي لم يكن أمراً من قائد
العشيرة تانغ مياوشينغ، صحيح؟

88
00:07:43,600 --> 00:07:46,790
من أنا؟ مُجرّد نكرة

89
00:07:46,790 --> 00:07:49,090
،إذا لم يُرِد قائد العشيرة تانغ رؤيتي فعلاً

90
00:07:49,090 --> 00:07:50,900
فإنّ "لا" ببساطة ستكون كافية

91
00:07:50,900 --> 00:07:51,890
لِمَ القيام بكلّ هذا؟

92
00:07:52,370 --> 00:07:56,940
أعتقد بأنّه لم يُوضّح أبداً فيما
إذا كان يريد رؤيتي أو لا

93
00:07:57,690 --> 00:07:59,390
إذاً ما رأيك بهذا يا أخي شيونغ؟

94
00:07:59,390 --> 00:08:01,350
لِمَ لا تذهب وتسأله؟

95
00:08:01,350 --> 00:08:04,330
،إذا قال بشكل صريح بأنّه لن يراني
!فسوف أغادر فوراً

96
00:08:04,330 --> 00:08:05,100
أهي فكرة جيّدة؟

97
00:08:09,280 --> 00:08:10,390
تينغتينغ؟

98
00:08:13,620 --> 00:08:16,310
لا يهمّني ما يعتقده جدّي

99
00:08:16,310 --> 00:08:19,220
!سوف أشلّ هذا الوغد الوقح

100
00:08:34,140 --> 00:08:35,770
فوجدتِهم جميعهم بلمح البصر؟

101
00:08:35,770 --> 00:08:39,310
!لا أُبالي، سأمزِّقك إرباً

102
00:08:40,540 --> 00:08:41,420
!تينغتين

103
00:08:41,420 --> 00:08:42,250
ماذا؟

104
00:08:46,680 --> 00:08:47,590
!أخي لونغ

105
00:08:51,220 --> 00:08:54,400
أخي لونغ، زانغ تشولان أحضر تعزيزات

106
00:08:54,400 --> 00:08:55,390
!لنُواجهه معاً

107
00:08:56,130 --> 00:08:58,890
!لونغ، لا تقلق! سأردّ الاعتبار منه لأجلك

108
00:09:08,470 --> 00:09:10,180
أتيت لرؤية العجوز، صحيح؟

109
00:09:11,350 --> 00:09:13,560
هيّا، سآخذك إلى هناك

110
00:09:13,560 --> 00:09:14,400
ماذا؟

111
00:09:16,470 --> 00:09:18,220
!لا يا لونغ! اجعله يدفع الثّمن

112
00:09:18,220 --> 00:09:19,330
!سأُساعدك

113
00:09:20,390 --> 00:09:23,590
تينغتينغ، لا تتورّطي في هذا. أصغي إليّ

114
00:09:23,590 --> 00:09:28,180
!ماذا؟ يا إلهي، لا أتحمّل رقّة لونغ معي

115
00:09:27,390 --> 00:09:28,970
!مهلاً! مهلاً يا أختي تينغ

116
00:09:28,970 --> 00:09:31,770
أخي لونغ، هل ستدع زانغ
تشولان يفلت فحسب؟

117
00:09:31,770 --> 00:09:32,640
!أجل يا أخي لونغ

118
00:09:32,640 --> 00:09:35,190
اصمت. أخبرتُكم عن زانغ تشولان

119
00:09:35,190 --> 00:09:37,760
لكن لم أقل بأنّني أردتُ إزعاجه، صحيح؟

120
00:09:37,760 --> 00:09:40,600
ولم أطلب منكم فعل هذا حتماً

121
00:09:40,600 --> 00:09:42,640
!تبّاً

122
00:09:42,640 --> 00:09:45,810
!لا أتحمّل رؤية لونغ قاسياً أيضاً

123
00:09:44,240 --> 00:09:45,810
!مهلاً! مهلاً يا أختي تينغ

124
00:09:46,640 --> 00:09:47,900
زانغ تشولان

125
00:09:49,270 --> 00:09:51,600
!أخي لونغ، جرّب هذا الطّعام المحلّيّ

126
00:09:53,180 --> 00:09:55,330
!هناك ما يكفي لكم جميعاً

127
00:10:00,000 --> 00:10:01,470
!من يريد بضاعتك الرّديئة؟

128
00:10:02,190 --> 00:10:04,930
هيّا بنا يا زانغ تشولان. وبقيّتكم

129
00:10:11,350 --> 00:10:14,980
أخبرتُكم ألّا تخبروا لونغ بشأن
العبث مع زانغ تشولان

130
00:10:17,300 --> 00:10:19,590
عرفتُ بأنّه سيكون هكذا

131
00:10:19,590 --> 00:10:20,930
!هذا مُحبِط للغاية

132
00:10:20,930 --> 00:10:22,060
تينغتين

133
00:10:22,620 --> 00:10:24,120
مذاقه لذيذ جدّاً

134
00:10:24,120 --> 00:10:25,020
حقّاً؟

135
00:10:26,260 --> 00:10:28,490
زانغ تشولان، لا حاجة للتوتُّر

136
00:10:28,490 --> 00:10:31,020
أتعتقد بأنّني سأكرهك بسبب بطولة لوشيان؟

137
00:10:32,220 --> 00:10:34,640
،كنتُ مستاء قليلاً عندما عدتُ أوّل مرّة

138
00:10:34,640 --> 00:10:37,350
لكن لا تقلق، تجاوزتُ الأمر تماماً

139
00:10:37,350 --> 00:10:39,320
أنا مُمتنّ قليلاً لك

140
00:10:39,320 --> 00:10:41,430
لم أتوقّع أن تكون بهذا التّواضُع يا أخي لونغ

141
00:10:41,740 --> 00:10:44,100
تواضُع؟ ليس تماماً

142
00:10:44,440 --> 00:10:46,470
،خسرتُ أمامك فعلاً حينها

143
00:10:46,470 --> 00:10:47,770
هزيمة نكراء

144
00:10:48,310 --> 00:10:49,640
ربحتَ بنزاهة

145
00:10:49,640 --> 00:10:51,520
أعلم بشأن تلك البطولة

146
00:10:51,520 --> 00:10:54,270
رغم أنّه لم يستخدم أي خدعة
،ماكرة أثناء القتال

147
00:10:54,270 --> 00:10:56,120
،لكن نظراً إلى نِزالاته السّابقة

148
00:10:56,120 --> 00:10:58,980
لا تزال هزيمتك تتطلّب مقداراً
،مُعيّناً من الإستراتيجيّة

149
00:10:58,980 --> 00:11:00,430
لذا لم يكن ذلك نزيهاً تماماً

150
00:11:00,880 --> 00:11:03,390
هذا رأيكِ، لا رأيي

151
00:11:03,880 --> 00:11:04,970
أنا من عشيرة تانغ

152
00:11:05,350 --> 00:11:08,220
رغم أنّ جميعنا مُواطنون مُلتزمون
،بالقانون الآن

153
00:11:08,220 --> 00:11:12,030
في الماضي، كانت عشيرة تانغ تُوفّر
قوت يومها من خلال الاغتيالات

154
00:11:12,030 --> 00:11:15,540
التسلُّل والكفاءة والتّخطيط الحذر

155
00:11:16,170 --> 00:11:18,740
هي الصِّفات الّتي ينبغي لعضو
في عشيرة تانغ أن يمتلكها

156
00:11:19,430 --> 00:11:23,230
في ذلك النِّزال، كان زانغ تشولان كعضو
في عشيرة تانغ أكثر منّي

157
00:11:23,230 --> 00:11:24,680
،لكن بفضله

158
00:11:25,080 --> 00:11:27,340
تمكّنتُ من معرفة أخطائي وعيوبي

159
00:11:27,340 --> 00:11:29,020
في الواقع، لستُ أنا فقط

160
00:11:29,020 --> 00:11:32,800
جيلنا الشّابّ من عشيرة تانغ يفقد
لمسته في التسلُّل

161
00:11:32,800 --> 00:11:34,400
انظر إلى أولئك الآن

162
00:11:34,400 --> 00:11:37,180
أقرب إلى رجال عصابة، وليس مُغتالين

163
00:11:38,500 --> 00:11:41,350
أخي لونغ، أنت تُحرجني بكلّ هذا الإطراء

164
00:11:41,350 --> 00:11:42,970
أنت مُذهل

165
00:11:42,970 --> 00:11:45,930
ينبغي أن تكون كذلك، أن تكون
ذا حركات غير مُتوقَّعة

166
00:11:45,930 --> 00:11:48,860
لا تدع أحداً يعلم متى ستُهاجم

167
00:11:49,720 --> 00:11:52,100
...كما الآن

168
00:11:59,760 --> 00:12:01,310
ما الخطب؟ هيّا بنا

169
00:12:03,900 --> 00:12:07,020
تانغ وينلونغ... مُثير للاهتمام

170
00:12:10,720 --> 00:12:11,720
وصلنا

171
00:12:12,020 --> 00:12:13,340
تأخّرت الوقت اليوم

172
00:12:13,340 --> 00:12:14,520
سأوفّر غرفاً لكم

173
00:12:14,520 --> 00:12:17,470
ارتاحوا. غداً، سآخذكم لرؤية العجوز

174
00:12:24,570 --> 00:12:25,810
ادخل

175
00:12:29,500 --> 00:12:30,680
اخرج للحظة

176
00:12:35,810 --> 00:12:39,770
لم أحصل على فُرصة للحديث معك
بمفردنا أيّها الوغد

177
00:12:45,120 --> 00:12:47,770
ما الأمر؟ ألم يكن لديك شيء
لتحدّثني حوله؟

178
00:12:48,150 --> 00:12:50,350
هذا بسيط. ثمّة أمر واحد فقط

179
00:12:50,350 --> 00:12:52,180
هل يمكنك التّساهل معي هذه المرّة؟

180
00:12:52,180 --> 00:12:54,160
ما هذا الكلام فجأة؟

181
00:12:54,160 --> 00:12:56,020
مُحال أن أغدر بك

182
00:12:56,020 --> 00:12:58,890
الرّئيس زاو شخصيّاً طلب منّي حمايتك

183
00:12:58,890 --> 00:13:02,020
هذا يكفي! لنُوقِف الهزل واللّعب

184
00:13:02,020 --> 00:13:05,270
انسحابك من هذه المهمّة هو أفضل
!طريقة يمكنك حمايتي من خلالها

185
00:13:05,270 --> 00:13:07,350
!إن وافقت، فأنا مَدين لك بمعروف كبير

186
00:13:07,350 --> 00:13:10,220
ولا أريد سماع ذلك الهُراء حول عدم
!القدرة على الاستقالة بسبب العمل

187
00:13:10,220 --> 00:13:14,210
حسناً، سأعترف بذلك. لا أُبالي
سواء كنت حيّاً أو ميّتاً

188
00:13:14,210 --> 00:13:16,620
لذا أنا لا أبقى بسبب العمل

189
00:13:17,200 --> 00:13:19,300
لكن من الواضح أنّ شيئاً كبيراً
على وشك أن يحدث

190
00:13:19,300 --> 00:13:21,810
الطّلب منّي الانسحاب الآن
!هو طلب أكبر من أن أتحمّله

191
00:13:22,090 --> 00:13:24,880
هذا الشابّ صادق زيادة عن اللّزوم

192
00:13:24,880 --> 00:13:27,640
مهما كان كبيراً، ما علاقة ذلك بك؟

193
00:13:28,120 --> 00:13:30,510
أنا مُجرّد شخص يحبّ الاستعراضات المُمتعة

194
00:13:30,510 --> 00:13:31,930
ما علاقتك ذلك بك؟

195
00:13:36,070 --> 00:13:38,350
كما توقّعت. من تكون يا وانغ زينتشيو؟

196
00:13:38,350 --> 00:13:40,750
مُحال أن تتراجع بعد بضع كلمات منّي

197
00:13:41,760 --> 00:13:43,080
أهدرتُ أنفاسي

198
00:13:43,080 --> 00:13:44,880
آسف على إقلاق راحتك

199
00:13:47,740 --> 00:13:50,350
زانغ تشولان، هل هذا يُسبّب لك صُداعاً فعلاً؟

200
00:13:50,700 --> 00:13:52,780
وإلّا ما كنت لتأتيني ومعك هذا

201
00:13:53,600 --> 00:13:56,640
بما أنّك صريح جدّاً، سأكون صادقاً أيضاً

202
00:13:57,080 --> 00:13:58,930
هل تعرف لماذا كنتُ أُراقبك باستمرار؟

203
00:13:59,280 --> 00:14:00,200
ماذا؟

204
00:14:00,200 --> 00:14:02,310
أنا شخصٌ فضوليّ جدّاً

205
00:14:02,940 --> 00:14:04,610
الآن، أكثر ما يُراودني فضول بشأنه

206
00:14:04,610 --> 00:14:08,770
هو مَن تكون حقّاً تحت طبقات التنكُّر تلك

207
00:14:08,770 --> 00:14:10,050
حقّاً؟

208
00:14:15,250 --> 00:14:17,140
...من أكون حقّاً

209
00:14:17,810 --> 00:14:19,220
يُراودني فضول بشأن ذلك أيضاً

210
00:14:22,340 --> 00:14:23,690
هل ارتحت جيّداً؟

211
00:14:23,690 --> 00:14:25,140
أجل. شكراً يا أخي لونغ

212
00:14:25,520 --> 00:14:26,770
هيّا بنا، جميعاً

213
00:14:27,310 --> 00:14:29,060
أنا الوحيد الّذي سيُقابل العجوز

214
00:14:31,100 --> 00:14:33,770
ماذا؟ وغد، أنت بمفردك فقط؟

215
00:14:34,580 --> 00:14:36,430
ستكون الأمور بخير. لا تقلقا

216
00:14:36,430 --> 00:14:38,030
لن يحدث شيء بالتّأكيد

217
00:14:38,030 --> 00:14:40,310
مُعلّم، باور، راقبا هاتفيكما

218
00:14:40,310 --> 00:14:41,430
سأتواصل معكما

219
00:14:50,010 --> 00:14:50,830
تفضّل

220
00:14:53,220 --> 00:14:55,220
على اليسار المُعلّم تانغ، تانغ تشيوشان

221
00:14:55,220 --> 00:14:56,690
وعلى اليمين المُعلّم وانغ، زانغ وانغ

222
00:14:56,690 --> 00:14:58,940
كلاهما أخوَان الجدّ مياوشينغ

223
00:14:58,940 --> 00:15:02,100
والّذي يقف هو المُعلّم تانغ مينغ، مُعلّمي

224
00:15:02,430 --> 00:15:05,890
والّذي في الوسط هو المُعلّم تانغ مياوشينغ

225
00:15:07,200 --> 00:15:08,310
!قائد العشيرة تانغ

226
00:15:08,590 --> 00:15:10,660
ماذا يعني "قائد عشيرة"؟

227
00:15:10,660 --> 00:15:12,190
هذه مدرسن

228
00:15:12,190 --> 00:15:14,580
أنا المدير

229
00:15:14,580 --> 00:15:16,430
لونغ، يمكنك المُغادرة

230
00:15:16,430 --> 00:15:17,300
أجل

231
00:15:22,220 --> 00:15:24,560
تكلّم يا زانغ تشولان

232
00:15:24,560 --> 00:15:25,970
لماذا أتيت؟

233
00:15:30,770 --> 00:15:33,390
كم مضى على رحيل زانغ تشولان؟

234
00:15:33,390 --> 00:15:35,140
يوم كامل تقريباً

235
00:15:35,420 --> 00:15:37,210
غادر هذا الصّباح

236
00:15:37,210 --> 00:15:39,420
يكاد يُخيّم الظّلام

237
00:15:39,420 --> 00:15:42,120
باوباو، قال زانغ تشولان بأنّه
،سيتواصل معنا

238
00:15:42,120 --> 00:15:43,560
لكن لم نسمع عنه أي نبأ

239
00:15:43,560 --> 00:15:44,720
هل يُعقَل أن يكون في خطر؟

240
00:15:45,020 --> 00:15:46,060
لا أعلم

241
00:16:00,270 --> 00:16:01,080
حسناً

242
00:16:11,880 --> 00:16:13,270
لينغلونغ، انظري

243
00:16:23,770 --> 00:16:30,460
زانغ تشولان، قطعت كلّ هذه المسافة
فقط لتُخبرني بهذا؟

244
00:16:31,140 --> 00:16:36,310
إذاً لديّ كلمتان فقط لوصف
ما عليك فعله

245
00:16:36,850 --> 00:16:38,810
السّعي وراء الموت

246
00:16:42,240 --> 00:16:42,970
!يا للهول

247
00:16:44,470 --> 00:16:46,020
!زانغ تشولان في ورطة

248
00:16:52,890 --> 00:16:54,520
فينغ باوباو، ماذا تفعلين؟

249
00:16:57,140 --> 00:17:00,240
،إذا كنتُ في خطر غداً فعلاً
فاهربوا عندما أخبركم بذلك

250
00:17:00,240 --> 00:17:02,960
لا سيّما زانغ لينغيو. يجب عليكِ منعه

251
00:17:02,960 --> 00:17:03,930
عُلِم

252
00:17:14,820 --> 00:17:16,140
!هاجموا

253
00:17:19,280 --> 00:17:20,810
...فينغ باوباو، أنتِ

254
00:17:23,810 --> 00:17:25,390
لِمَ أنتم واقفون هكذا؟

255
00:17:26,430 --> 00:17:28,470
!فشلت المُفاوضات! هيّا بنا

256
00:17:31,220 --> 00:17:33,540
زانغ تشولان، هل أنت بخير؟

257
00:17:33,540 --> 00:17:35,410
!اعتقدنا بأنّهم فعلوا شيئاً لك

258
00:17:35,410 --> 00:17:36,890
هل أبدو إيثاريّاً إلى هذا الحدّ؟

259
00:17:36,890 --> 00:17:38,330
أضحّي بنفسي كي تتمكّنوا من المُغادرة؟

260
00:17:38,330 --> 00:17:40,600
!هربتُ أوّلاً بالطّبع، ثمّ راسلتُكم

261
00:17:40,600 --> 00:17:41,990
ما الّذي يجري؟

262
00:17:41,990 --> 00:17:44,000
تبّاً! انقلبوا عليّ بهذا الشّكل فحسب

263
00:17:44,000 --> 00:17:45,850
بالكاد تمكّنتُ من صدّ ضربة
من تانغ مياوشينغ

264
00:17:45,850 --> 00:17:48,640
لحسن الحظّ، العجائز الثّلاثة كبرياؤهم
لا يسمح لهم بمُلاحقتي

265
00:17:50,440 --> 00:17:51,560
دخلوا الغابة؟

266
00:17:52,070 --> 00:17:55,060
زانغ تشولان، قُضي عليك

267
00:17:55,920 --> 00:17:58,310
حسناً، بدؤوا بتحرّكاتهم

268
00:18:00,130 --> 00:18:01,970
لنذهب ونلقِ نظرة

269
00:18:02,260 --> 00:18:07,890
في هذه الأوقات المُسالمة، نادراً ما يحظى
صِغارنا من عشيرة تانغ ببعض التّمرين

270
00:18:27,310 --> 00:18:28,300
!زانغ تشولان

271
00:18:29,060 --> 00:18:31,580
لا أملك خياراً. إنّهم عازمون على تفريقنا

272
00:18:31,580 --> 00:18:32,810
!كلّ رجل عن نفسه

273
00:18:33,170 --> 00:18:34,240
!مُستحيل

274
00:20:18,310 --> 00:20:19,060
!تاو

275
00:20:19,420 --> 00:20:20,640
!الأستاذة تاو

276
00:20:21,060 --> 00:20:23,070
!بدأتْ تاو بتحرّكاتها! عودو

277
00:20:51,600 --> 00:20:54,000
يا للمكر! تختبئ بعيداً

278
00:20:54,000 --> 00:20:55,390
هل تؤرقك هذه إلى هذا الحدّ؟

279
00:20:55,820 --> 00:20:57,310
ما الغريب في ذلك؟

280
00:20:57,310 --> 00:20:59,760
!أيّ شخص عاديّ كان ليُلاحظ هذه الفُقاعات

281
00:20:59,760 --> 00:21:02,060
من المُؤكّد أنّ ما بداخلها ليس بالجيّد

282
00:21:02,430 --> 00:21:04,720
أنتِ حذِرة بشكل حريص بحدّ ذاتكِ

283
00:21:14,430 --> 00:21:18,560
خدعة بسيطة تقليديّة، إبر الدُّخن

284
00:21:21,600 --> 00:21:24,770
مُبهرة. أنتِ مُبهرة

285
00:21:25,470 --> 00:21:28,530
أفضل بكثير من أولئك الّذين واجهناهم
عندما وصلنا إلى هنا أوّلاً

286
00:21:28,530 --> 00:21:31,010
ويوجد المزيد هنا لم يكشفوا عن أنفسهم بعد

287
00:21:31,010 --> 00:21:32,610
لكن لستُ أفهم

288
00:21:32,610 --> 00:21:35,690
لماذا لا تقوم خبيرةٌ مثلكِ
باستهداف زانغ  تشولان؟

289
00:21:35,690 --> 00:21:37,890
إنّه هو من عبث مع عشيرة تانغ، صحيح؟

290
00:21:38,310 --> 00:21:41,190
لستُ مُهتمّة بذلك الرّجل أو تُرّهاته

291
00:21:41,190 --> 00:21:43,390
أنا أتّبع أوامر المُدير فحسب

292
00:21:43,900 --> 00:21:45,180
فهمت

293
00:21:45,770 --> 00:21:48,520
أداء ماكر يا زانغ تشولان

294
00:21:52,130 --> 00:21:53,220
أتهرب؟

295
00:21:58,470 --> 00:22:00,470
أتعتقد بأنّك تستطيع الإفلات؟