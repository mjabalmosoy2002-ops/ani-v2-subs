1
00:02:18,980 --> 00:02:21,850
!مكان حيث يمكنك الوقوف بثقة واعتزاز

2
00:02:22,280 --> 00:02:25,470
أيّها الوغد، ماذا تفعل؟ لماذا عدت إلى هنا؟

3
00:02:25,470 --> 00:02:27,810
!لأنّني اكتشفتُ معنى الصّدق

4
00:02:28,460 --> 00:02:29,470
ماذا؟

5
00:02:33,380 --> 00:02:36,210
"!هكذا يكون "الوقوف بثقة واعتزاز

6
00:02:36,210 --> 00:02:38,890
في الواقع، الأحجيات سهلة الحلّ
إذا كانت على حِدة

7
00:02:40,110 --> 00:02:42,720
تكمن الصّعوبة في دمجها معاً

8
00:02:43,410 --> 00:02:45,680
"يجب أن يكون الحرف في "صدق
"فوق "مَن هو بشريّ

9
00:02:45,680 --> 00:02:49,270
من الصّعب جدّاً مُعالجة القوّة المُكتسبة
من عبور الوادي

10
00:02:49,270 --> 00:02:53,600
بعد عبوره، تُغيّر القوّةُ الاستثنائيّة
،عقليّة المرء بشكل كبير

11
00:02:53,600 --> 00:02:56,220
ممّا يُصعّب التّركيز على فكرة الصّدق

12
00:02:56,220 --> 00:02:58,560
هذا خطأ شائع بالنّسبة لمُعظم
النّاس الّذين يمارسون نشاطاتهم

13
00:02:58,930 --> 00:03:01,150
،%نظريّاً، ينبغي أن نهدف لـ 100

14
00:03:01,150 --> 00:03:03,140
،لكنّها نُشتَّت بواسطة عوامل خارجيّة

15
00:03:03,570 --> 00:03:06,840
،مثل ظروف غير مُستحسَنة أو مقدرة غير كافية

16
00:03:06,840 --> 00:03:08,850
لتنخفض النّتيجة في نهاية
%المطاف إلى 80

17
00:03:09,170 --> 00:03:12,180
%رغم ذلك، قد نرضى فعلاً بنتيجة 60

18
00:03:12,180 --> 00:03:15,360
لكن المُعلّم هنا لا ينظر للأمر بهذه الطّريقة

19
00:03:15,360 --> 00:03:17,520
على الأقلّ عندما يتعلّق الأمر
،بما يعنيه أن تكون بشريّاً

20
00:03:17,520 --> 00:03:20,140
%لا يقبل إلّا 100

21
00:03:20,740 --> 00:03:22,810
لا يهمّ. هذه غلطتي

22
00:03:22,810 --> 00:03:26,060
باور، نسيتُ لحظات الوضوح
والشّفافيّة المُتقطّعة خاصّتكِ

23
00:03:26,420 --> 00:03:28,560
الجواب على الصّدق بسيط جدّاً

24
00:03:28,560 --> 00:03:30,930
الصّدق موثوقيّة

25
00:03:30,930 --> 00:03:33,310
الصّدق طريق السّماء

26
00:03:33,850 --> 00:03:35,880
طريق السّماء لا يتفاوض مع النّاس

27
00:03:35,880 --> 00:03:38,640
طريق السّماء لا يترك مجالاً للمُساومات

28
00:03:38,640 --> 00:03:42,140
الصّدق هو إحدى خصائص طريق السّماء

29
00:03:42,450 --> 00:03:45,720
المنبوذون الّذين يفهمون معنى
،الوقوف بين السّماء والأرض

30
00:03:45,720 --> 00:03:48,570
لا ينبغي أن يُشوّشهم ذلك الوادي في الخارج

31
00:03:48,570 --> 00:03:51,270
!%يجب أن نسعى خلف ذلك بنسبة 100

32
00:03:51,270 --> 00:03:54,560
ابحثوا عن المكان الّذي يقف فيها
!المرء باعتزاز فعلاً بين السّماء والأرض

33
00:03:55,500 --> 00:03:59,430
فهمت! الوقوف باعتزاز بين السّماء والأرض
!يشير إلى نقاط الوخز بالإبر بايهوي خاصّتي

34
00:03:59,430 --> 00:04:02,680
شا، لِمَ يجب أن نركّز على جزئيّة "السّماء"؟

35
00:04:02,680 --> 00:04:06,020
من أجل بلوغ السّماء، يجب الوقوف على الأرض

36
00:04:17,180 --> 00:04:20,770
هكذا هو الأمر إذاً

37
00:04:21,100 --> 00:04:25,390
أجل، هذا هو: الوقوف باعتزاز بين السّماء والأرض

38
00:04:25,390 --> 00:04:28,650
نقطة الوخز بالإبر الّتي تتّجه نحو السّماء
هي نقطة بايهوي في مُقدّمة الرّأس

39
00:04:28,650 --> 00:04:30,640
"لذا "الوقوف على الأرض

40
00:04:30,640 --> 00:04:33,140
سيكون هذا بالطّبع

41
00:04:33,140 --> 00:04:36,720
،إنّه يُمثّل خطّ طول كلية قدم شاوين
والمُتّجه للأسفل

42
00:04:36,720 --> 00:04:40,780
،إنّه معروف أيضاً بالكهف الّذي لا قاع له
!نقطة الوخز يونغتشوان

43
00:05:09,090 --> 00:05:11,430
إذاً يوجد مكانٌ كهذا بالفعل

44
00:05:19,300 --> 00:05:21,040
،لا شكّ في ذلك

45
00:05:21,040 --> 00:05:23,700
هذا هو الجواب على "الوقوف باعتزاز
"بين السّماء والأرض

46
00:05:31,430 --> 00:05:34,310
...يا جدّة، عثرنا عليه

47
00:05:48,390 --> 00:05:51,810
ماذا؟ إنّها غرفة فارغة أُخرى

48
00:06:00,880 --> 00:06:02,650
انظروا هناك

49
00:06:05,850 --> 00:06:08,040
...الكهف ذو الالتفافات التّسعة

50
00:06:09,080 --> 00:06:10,640
!هذا هو خطّ زعيم الطّائفة

51
00:06:10,640 --> 00:06:13,310
!أنا أعرف خطّ يد زعيم الطّائفة

52
00:06:13,310 --> 00:06:15,390
!أنتم! تعالوا وتفقّدوا هذا

53
00:06:16,910 --> 00:06:18,700
ثمّة شيء نُقِش في هذا الجدار هنا

54
00:06:18,700 --> 00:06:20,040
مُسِح لاحقاً

55
00:06:22,300 --> 00:06:23,480
!يوجد المزيد هنا أيضاً

56
00:06:23,480 --> 00:06:26,020
!يوجد البعض هنا أيضاً... إنّها كلمات

57
00:06:26,020 --> 00:06:29,950
إذا نظرنا عن كثب، فإنّ كثيراً
من سطح هذا الكهف قد تمّ تلميعه

58
00:06:29,950 --> 00:06:31,100
!هنا

59
00:06:33,280 --> 00:06:35,190
!توجد كلمات كاملة هنا

60
00:06:36,520 --> 00:06:41,410
،هذه الطّريقة صحيحة ورائعة

61
00:06:41,410 --> 00:06:45,810
لأنّني فريد ومختلف عن الآخرين

62
00:06:46,160 --> 00:06:50,290
،أعلم بأنّ العكس ينشأ عن لي وكان

63
00:06:50,290 --> 00:06:54,300
لكن من يميّز ذلك العَوم والغرق
يحدّد المُضيف والضّيف؟

64
00:06:55,000 --> 00:06:58,880
القِدر الذّهبيّ يأمل الاحتفاظ
بالزنجفر الّذي بداخله

65
00:06:58,880 --> 00:07:04,240
داخل بركة اليشم، الأوّل يضع
الفضّة في الماء

66
00:07:04,240 --> 00:07:05,630
عاصمة اليشم القدسيّ؟

67
00:07:05,630 --> 00:07:08,310
...ماذا؟ ألم يكن هذا بواسطة

68
00:07:08,900 --> 00:07:11,970
!زانغ بودوان... والمعروف أيضاً بالمُعلّم زيانغ

69
00:07:12,400 --> 00:07:14,470
زانغ بودوان؟

70
00:07:14,470 --> 00:07:16,360
من هو المُعلّم زيانغ؟

71
00:07:18,000 --> 00:07:22,270
جينفينغ! أنتِ من النّوع الّذي
!الّذي يمتلك مهارات فطريّة فعلاً

72
00:07:22,630 --> 00:07:25,960
زانغ بودوان، والمعروف بالمُعلّم
،وزهين أو المُعلّم زيانغ

73
00:07:25,960 --> 00:07:27,670
هو مُؤسّس مدرسة الخيمياء الجنوبيّة

74
00:07:27,670 --> 00:07:30,020
لا عجب في أنّ نابغة بالفطرة مثلكِ لا يعرفه

75
00:07:30,020 --> 00:07:32,480
،لكن بالنّسبة لأولئك الّذين تطوّروا لاحقاً في الحياة

76
00:07:32,480 --> 00:07:36,560
عدم معرفته هو أشبه بنجّار لا يعرف
لو بان، أليس كذلك يا زانغ؟

77
00:07:38,800 --> 00:07:41,100
!زانغ بودو؟ أعرفه بالطّبع

78
00:07:41,100 --> 00:07:42,940
!إنّه زانغ

79
00:07:42,940 --> 00:07:44,910
لا يملك هذا الشّخص فكرة

80
00:07:45,560 --> 00:07:49,240
إذا كان سيّد هذا المكان هو مُعلّم
،زيانغ الأسطوريّ

81
00:07:49,240 --> 00:07:52,720
فليس من المنطقيّ أن يكون شخص
...واحد قد صنع كلّ هذا

82
00:07:59,610 --> 00:08:06,480
فهمت. إذاً هذا هو الجواب الّذي لطالما أراد
زعيم الطّائفة منّي أن أعثر عليه بنفسي

83
00:08:06,480 --> 00:08:11,680
سيّد هذا المكان هو منبوذ استثنائيّ

84
00:08:11,680 --> 00:08:13,100
أجل ولا

85
00:08:13,100 --> 00:08:15,180
،زانغ بودو هو الجواب بالفعل

86
00:08:15,180 --> 00:08:18,740
لكن هناك المزيد خلف الجواب الّذي
أراد زعيم الطّائفة نقله

87
00:08:18,740 --> 00:08:20,220
ماذا؟

88
00:08:20,220 --> 00:08:23,890
لماذا برأيك عدّل أو غينشينغ الأشكالَ
في أسوار الوادي في الخارج؟

89
00:08:24,170 --> 00:08:25,480
لماذا؟

90
00:08:25,480 --> 00:08:29,310
...لا يمكننا أبداً أن نفهم سبب قيامه بما يفعله

91
00:08:29,590 --> 00:08:33,240
شا، كم من المساحة برأيك يستهلك
نحت فصل وزهين بأكمله؟

92
00:08:36,240 --> 00:08:38,200
ينبغي أن يكون هذا الجدار كافياً

93
00:08:39,530 --> 00:08:43,220
لكن انظر، هذا الكهف الحجريّ بأكمله
مليء بنقوش ممسوحة

94
00:08:43,220 --> 00:08:45,850
،بالإضافة إلى الكهف ذي الالتفافات التّسعة

95
00:08:45,850 --> 00:08:48,680
من الواضح أنّ أو غينشينغ يدحض المُعلّم زيانغ

96
00:08:52,890 --> 00:08:54,450
!كما هو مُتوقَّع من زعيم الطّائفة

97
00:08:54,450 --> 00:08:57,890
إنّه لا يعرف حتّى كيف يُظهر احتراماً
!لمؤسّس الخيمياء الأسطوريّ

98
00:08:57,890 --> 00:09:00,640
ما الّذي يدحضه زعيم الطّائفة بالضّبط
بخصوص المُعلّم زيانغ؟

99
00:09:00,990 --> 00:09:05,640
هذا الكهف ذو الالتفافات التّسعة
نشأ من قصّة أيضاً

100
00:09:07,080 --> 00:09:08,720
مُعلّم وأتباعه الثّلاثة

101
00:09:08,720 --> 00:09:10,920
مرّوا بمكان يُدعى يوهوا في رحلة التّنمية خاصّتهم

102
00:09:10,920 --> 00:09:13,970
،استقبلهم حاكم مدينة يوهوا باحترام وتوقير عظيم

103
00:09:13,970 --> 00:09:18,550
لذا نقلَ الأتباع الثّلاثة قدراتهم القدسيّة
إلى أبناء حاكم المدينة الثّلاثة

104
00:09:18,550 --> 00:09:21,380
أدّى هذا إلى تنبيه عرين أرواح
الأسد الموجود في مكان قريب

105
00:09:21,380 --> 00:09:25,480
وسلَف أرواح الأسد هذه كان يقطن
،في الكهف ذي الالتفافات التّسعة

106
00:09:25,480 --> 00:09:28,220
والمعروف بالحكيم الأصليّ ذي الأرواح التّسعة

107
00:09:28,660 --> 00:09:30,530
الحكيم الأصليّ ذو الأرواح التّسعة؟

108
00:09:30,530 --> 00:09:33,810
إذاً تقول بأنّ هذا المكان حيث تعيش الأرواح؟

109
00:09:33,810 --> 00:09:37,350
لا، يكمن المفتاح في "الحكيم الأصليّ
"ذو الأرواح التّسعة

110
00:09:37,350 --> 00:09:39,260
،تشير "الأرواح التّسعة" إلى السّماوات التّسعة

111
00:09:39,260 --> 00:09:41,200
"ويمكن أن تُفسَّر أيضاً كـ"شموس تسعة

112
00:09:41,200 --> 00:09:43,470
هذا الحكيم الأصليّ مُثير للاهتمام أيضاً

113
00:09:43,470 --> 00:09:45,610
،في حين أنّ كثيراً تمّ احترامهم كحُكماء

114
00:09:45,610 --> 00:09:50,100
واحد فقط تمّ توقيره كحكيم عظيم

115
00:09:50,640 --> 00:09:53,640
والشّخص الّذي يحترمه هذا الحكيم
...العظيم بشدّة

116
00:09:53,640 --> 00:09:55,390
كان الحكيم الأصليّ

117
00:09:55,390 --> 00:09:57,970
وحده الحكيم الأصليّ يستحقّ أن يُلقّب
"بمُعلّم المُعلّمين"

118
00:09:57,970 --> 00:10:01,130
القصّة تكشف أيضاً بأنّ الملك غوانغمو السّماويّ

119
00:10:01,130 --> 00:10:03,100
يخبر ملك القِردة بأصل الكارثة

120
00:10:03,100 --> 00:10:05,950
هذا لأنّك أردت أن تصبح مُعلّماً للآخرين

121
00:10:05,950 --> 00:10:09,220
قمتَ بإثارة عرين الأسود هذا

122
00:10:09,830 --> 00:10:13,770
هذه الحكاية المُعقّدة تؤدّي وظيعة
:تحذير للمُنمّيين المُستقبليّين

123
00:10:14,320 --> 00:10:16,310
!لا تصبحوا مُعلّمين بطيش وتهوُّر

124
00:10:20,970 --> 00:10:24,100
كانت الغاية من هذا المكان غالباً أن
يكون بمثابة غربلة لمثل هؤلاء

125
00:10:24,100 --> 00:10:28,180
يجب أن يمتلكوا حظّاً كافياً أو يُقدَّر لهم
فهم هذا المكان وأُحجياته

126
00:10:28,180 --> 00:10:31,430
بالإضافة إلى ذلك، لا بُدّ أنّ هذا الشّخص
يمتلك مقداراً كافياً من الصّدق

127
00:10:31,780 --> 00:10:34,280
وحدهم المُؤهّلون في نهاية المطاف
يستطيعون الوصول إلى هذا المكان

128
00:10:34,280 --> 00:10:36,600
ويتلقّون الرّسالة المنقوشة في الكهف الحجريّ

129
00:10:36,600 --> 00:10:41,440
إذاً هل تقصد بأنّه بعد أن حلّ زعيم
،الطّائفة الأُحجيات هنا

130
00:10:41,440 --> 00:10:45,140
ظنّ بأنّ طريقة زيانغ في نقل
،المعلومات كانت طائشة جدّاً

131
00:10:45,140 --> 00:10:47,350
لذا قام بمسح النّقوش في الكهف؟

132
00:10:47,350 --> 00:10:50,180
أجل. هل تعتقدون بأنّ هذا الوادي إعجازيّ؟

133
00:10:50,510 --> 00:10:54,130
إعجازيّ... مُجرّد عبوره مرّة يسمح
لك بفتح خطوط الطّول خاصّتك

134
00:10:54,130 --> 00:10:58,350
هذا مُدهش بقدر التحكُّم بالرُّوح
أو الحِرفيّة القدسيّة

135
00:10:58,710 --> 00:11:01,060
لكن أو غينشينغ لم يُعدّل سوى
ما كان في الخارج

136
00:11:01,060 --> 00:11:03,680
قام بمسح ما كان بداخل الكهف كُلّياً

137
00:11:09,240 --> 00:11:10,620
!وداعاً يا شا

138
00:11:10,620 --> 00:11:14,000
بفضلك، رأيتُ بعض الأشياء المُثيرة للاهتمام

139
00:11:14,000 --> 00:11:16,100
!إذا حدث شيء كهذا ثانية، فنادِني

140
00:11:16,410 --> 00:11:18,040
!حسناً، حسناً

141
00:11:18,880 --> 00:11:21,020
يا له من غريب أطوار

142
00:11:22,290 --> 00:11:26,260
حسناً، كنتُم خير مُعين هذه المرّة

143
00:11:26,260 --> 00:11:28,510
أشكركم بالنّيابة عن جينفينغ

144
00:11:28,510 --> 00:11:30,720
لنفترق هنا

145
00:11:31,090 --> 00:11:31,970
!يا جدّة

146
00:11:33,430 --> 00:11:35,640
سأزوركِ حتماً ثانية

147
00:11:39,240 --> 00:11:41,520
لن تفقدي الأمل من البحث عمّن
أخذَ مجموعة المقتنيات

148
00:11:42,000 --> 00:11:44,160
لن أفقد الأمل من البحث عن أدلّة
تقودني إلى تشي التّكوين

149
00:11:44,160 --> 00:11:48,930
لعلّ مجموعة المقتنيات تلك لا تمتلك
أي دليل يقود إلى تشي التّكوين

150
00:11:49,310 --> 00:11:51,760
،لا. حتّى لو لم تكن كذلك

151
00:11:51,760 --> 00:11:53,930
سأتعامل مع مَن أخذها رغم ذلك

152
00:11:54,310 --> 00:11:56,470
لماذا تساعدني؟

153
00:11:56,470 --> 00:11:58,610
،أنت من شركة التّوصيل السّريع

154
00:11:58,610 --> 00:12:00,390
وأنا من طائفة تشوان شينغ

155
00:12:00,390 --> 00:12:03,060
!كلانا شخصان من عائلة اللّصوص الـ 36

156
00:12:03,390 --> 00:12:05,790
عـ-عائلة؟

157
00:12:05,790 --> 00:12:06,870
أي عائلة؟

158
00:12:06,870 --> 00:12:08,970
!جينفينغ ليست من عائلة زعيم الطّائفة

159
00:12:08,970 --> 00:12:10,980
،سواء جلبوا المُعاناة أو البهجة

160
00:12:10,980 --> 00:12:14,720
لولا اللّصوص الـ 36، ما كان لأيّ شيء
مررنا به أن يحدث أصلاً

161
00:12:14,720 --> 00:12:17,720
ينبغي أن نخلف إرثهم

162
00:12:17,720 --> 00:12:20,470
ونكشف عن ألغازهم

163
00:12:20,470 --> 00:12:22,250
،إذا كان ما تركوه ضارّاً

164
00:12:22,250 --> 00:12:24,270
فينبغي أن نستأصله إذاً

165
00:12:24,560 --> 00:12:28,330
هذا كلّ ما في الأمر. سأتواصل مع شا
من خلال تشيو لاحقاً لإيجادك

166
00:12:28,970 --> 00:12:30,640
مهلاً

167
00:12:31,540 --> 00:12:33,180
إليك رقمي

168
00:12:33,180 --> 00:12:35,840
استمرّ في الاتّصال إذا لم يُجبك أحد

169
00:12:35,840 --> 00:12:38,320
...لستُ معتادة على حمل هاتف

170
00:12:39,430 --> 00:12:41,810
!أنا لا أثق بذلك الوغد زانغ تشولان فحسب

171
00:12:41,810 --> 00:12:43,270
!لا تصغي لهرائه

172
00:12:43,270 --> 00:12:46,650
جينفينغ! كيف لكِ أن تكوني
من عائلة زعيم الطّائفة؟

173
00:12:46,650 --> 00:12:48,920
إذاً... ماذا عنّي؟

174
00:12:48,920 --> 00:12:51,600
هل... هل أُعَدُّ كفرد من عائلتك أيضاً؟

175
00:12:51,600 --> 00:12:53,320
!كفى هراء

176
00:12:53,320 --> 00:12:55,720
ستعود إلى الكهف معي لاحقاً

177
00:12:55,720 --> 00:12:58,350
ماذا؟ خرجنا للتو وسنعود؟

178
00:12:58,350 --> 00:13:00,340
...هل لديك أي علاقات تُخوّلنا

179
00:13:00,340 --> 00:13:02,010
للحصول على مُتفجّرات؟

180
00:13:02,010 --> 00:13:03,280
مُتفجّرات؟

181
00:13:03,280 --> 00:13:06,430
أعرف بضعة أشخاص يستطيعون توفير بعضها

182
00:13:07,090 --> 00:13:10,920
أريد العودة لأنّني فهمتُ أخيراً
نوايا زعيم الطّائفة

183
00:13:48,880 --> 00:13:51,210
باور، كيف حال جرحك؟

184
00:13:51,210 --> 00:13:52,170
هل أنتِ بخير؟

185
00:13:54,830 --> 00:13:55,970
أنا بخير

186
00:13:56,320 --> 00:13:58,770
أنت بخير؟ كيف تأذّيت؟

187
00:13:58,770 --> 00:14:00,220
تلقّيتُ رصاصة

188
00:14:00,220 --> 00:14:02,500
كما قلت أنت، مُجرّد خدش

189
00:14:02,500 --> 00:14:03,810
هذا لا يؤثّر على تحرّكاتي

190
00:14:07,540 --> 00:14:09,040
ثمّة أمر آخر

191
00:14:09,040 --> 00:14:12,240
،إذا تقاتلتِ مع وانغ زينتشيو ثانية فعلاً
فابقي يقظة

192
00:14:12,240 --> 00:14:16,140
،بعد أن أعطيكِ هذه الإشارة
ابحثي عن فُرصة لتلقّي إصابة

193
00:14:16,430 --> 00:14:19,330
مُجرّد خدش، لا شيء يؤثّر على تحرّكاتك

194
00:14:20,540 --> 00:14:22,770
وضعني هذا الوغد ضمن أهدافه حتماً

195
00:14:23,140 --> 00:14:26,750
سيكون مُزعجاً للغاية داخل
الشّركة من الآن فصاعداً

196
00:14:26,750 --> 00:14:29,310
،من الأفضل الاستمرار في مُراقبته

197
00:14:29,310 --> 00:14:32,310
لكن لماذا أشعر بتضارُب مع هذه النّتيجة؟

198
00:14:34,170 --> 00:14:37,850
ربّما ضمنيّاً، لم أُرِد من وانغ
زينتشيو أن يختار هذا الاختيار

199
00:14:37,850 --> 00:14:41,520
ما الأمر؟ هل استمتعت إلى هذا الحدّ
في هذه المرّة؟

200
00:14:41,520 --> 00:14:44,020
لماذا تبدو وكأنّك تريد المزيد؟

201
00:14:44,020 --> 00:14:45,930
أريد المزيد؟

202
00:14:46,820 --> 00:14:49,200
لا، كيف ينبغي أن أعبّر عن الأمر؟

203
00:14:49,200 --> 00:14:51,000
،ذلكما الاثنان من النّخبة

204
00:14:51,000 --> 00:14:53,010
مختلفان تماماً عن أيّ شخص قابلتُه سابقاً

205
00:14:53,010 --> 00:14:54,790
!باور مُذهلة

206
00:14:54,790 --> 00:14:56,370
لكنّها ساذجة جدّاً

207
00:14:56,370 --> 00:14:58,940
زانغ تشولان هو المُثير للاهتمام

208
00:15:00,140 --> 00:15:01,820
،أظنّني رأيتُ عدّة جوانب منه

209
00:15:01,820 --> 00:15:03,480
،كلّ جانب بطابع مختلف تماماً

210
00:15:03,480 --> 00:15:05,410
لكن بدت جميعها حقيقيّة

211
00:15:05,410 --> 00:15:08,140
هناك الكثير من التّناقضات في هذا الشّخص

212
00:15:08,400 --> 00:15:12,420
بالمناسبة، ذو الشّعر الأجعد ذاك
،الّذي أحضرته فينغ باوباو

213
00:15:12,420 --> 00:15:14,470
لماذا تركته يذهب فحسب؟

214
00:15:14,820 --> 00:15:16,880
...هو

215
00:15:16,880 --> 00:15:18,640
مرحباً؟ هل يمكنك سماعي؟

216
00:15:18,640 --> 00:15:19,780
مرحباً؟ مرحباً؟

217
00:15:19,780 --> 00:15:22,680
أنا أفقد السّيطرة! ما الّذي يجري؟

218
00:15:26,350 --> 00:15:27,910
،بما أنّه لم يمنع التّنمية

219
00:15:27,910 --> 00:15:29,770
فإنّ النّتيجة ستكون نفسها

220
00:15:29,770 --> 00:15:31,310
سواء تركتُه أو لا

221
00:15:31,600 --> 00:15:34,370
أنت مُملّ للغاية

222
00:15:34,370 --> 00:15:38,020
إذاً النّاس مُعقّدون جدّاً ومُتناقضون فحسب

223
00:15:38,020 --> 00:15:39,890
لا تُقنعني وتُضلّلني هكذا

224
00:15:40,200 --> 00:15:42,220
زانغ تشولان هو الأكثر إثارة للاهتمام

225
00:15:42,220 --> 00:15:44,100
إنّه غالباً صاحب هدف

226
00:15:44,500 --> 00:15:46,560
لا بُدّ من وجود مبدأ إرشاد واضح

227
00:15:46,560 --> 00:15:49,430
خلف كلّ تلك التّناقضات فيه

228
00:15:52,120 --> 00:15:54,720
كم أتمنّى تشريح هذا الرّجل

229
00:15:55,190 --> 00:15:57,600
،إذا كان هذا الشّخص مُجرّد فظّ فعلاً

230
00:15:57,600 --> 00:15:59,470
فسأكون أكثر ارتياحاً

231
00:15:59,470 --> 00:16:05,680
ما نوع العمود الفقريّ الملفوف داخل
لحم هذا الشّخص الفاسد؟

232
00:16:09,920 --> 00:16:12,100
هل استخدمت تعويذة النُّور الذّهبيّ أو سحر الرّعد؟

233
00:16:12,100 --> 00:16:13,170
استخدمتُهما كليهما

234
00:16:17,220 --> 00:16:18,600
هل الأمر بذلك السّوء؟

235
00:16:18,600 --> 00:16:20,810
لن تموت، لكن المُعالجة صعبة

236
00:16:21,870 --> 00:16:23,170
لا يمكن مُقارنتي بك

237
00:16:23,170 --> 00:16:25,180
تلقّيتِ رصاصة وكنتِ بخير في الصّباح

238
00:16:25,180 --> 00:16:26,800
...ليس في الصّباح

239
00:16:26,800 --> 00:16:28,310
كنتُ بخير فوراً

240
00:16:29,680 --> 00:16:33,300
بالمناسبة، ماذا حدث بعد أن دخلتُ مُسرعاً؟

241
00:16:34,940 --> 00:16:36,390
لا أدري

242
00:16:36,390 --> 00:16:37,670
لا تدرين؟

243
00:16:37,670 --> 00:16:39,780
،سارعت تلك المرأة وعانقتني

244
00:16:39,780 --> 00:16:41,550
ثمّ مدّت يداً

245
00:16:41,550 --> 00:16:42,430
يد؟

246
00:16:42,800 --> 00:16:45,850
أجل، يد زرقاء

247
00:16:49,610 --> 00:16:50,720
...رأسي يؤلمني كثيراً

248
00:16:51,100 --> 00:16:55,020
آخر مرّة أتذكّر فيها ألماً بهذا
القدر كانت قبل سنوات

249
00:16:55,340 --> 00:16:58,240
،وريثما انحسر الألم واستطعتُ التّركيز

250
00:16:58,240 --> 00:16:59,890
كانت قد ماتت بالفعل

251
00:17:07,220 --> 00:17:07,980
!أخي سان

252
00:17:07,980 --> 00:17:08,760
!زانغ تشولان

253
00:17:09,300 --> 00:17:10,860
كيف حال باوباو؟ أين أنتما؟

254
00:17:10,860 --> 00:17:12,710
سنعود قريباً

255
00:17:12,710 --> 00:17:14,810
أريدك وأخي سي أن تُساعداني
في شيء أوّلاً

256
00:17:15,200 --> 00:17:19,430
أجل، سأخبرك بأفعال ليو تشي وعشيرة
ليو عندما نعود

257
00:17:19,430 --> 00:17:23,140
بالتّأكيد. بسرعة. لدينا أيضاً
بعض الأشياء لنخبرك بها

258
00:17:23,440 --> 00:17:25,200
ماذا؟ يتمّ استهدافي من جديد؟

259
00:17:25,200 --> 00:17:26,140
من يكون؟

260
00:17:26,140 --> 00:17:28,430
لو لينغلونغ؟ لو لين؟

261
00:17:33,250 --> 00:17:37,310
باور، هناك أشياء أريد أن أستشيرك حولها

262
00:17:39,880 --> 00:17:42,960
مرحباً؟ تشولان، كيف حالك؟

263
00:17:42,960 --> 00:17:45,560
هل فكّرت فيما طلبتُ منك فعله

264
00:17:45,560 --> 00:17:47,220
عندما كنتَ آخر مرّة في الشّركة؟

265
00:17:47,710 --> 00:17:50,290
تردي أن نتكلّم؟ حسناً

266
00:17:52,710 --> 00:17:54,720
...هكذا إذاً

267
00:17:55,280 --> 00:17:58,680
وانغ زينتشيو قد أبلغَ بالفعل
عن تفاصيل هذه الحادثة

268
00:17:59,000 --> 00:18:03,180
طلبنا من النّاس بالفعل إيجاد ليو مينغيوان

269
00:18:03,180 --> 00:18:05,520
،بالنّسبة لأولئك الأجانب

270
00:18:05,520 --> 00:18:07,220
تمّ استئجارهم غالباً

271
00:18:08,040 --> 00:18:10,500
زانغ، يمكنك التكلُّم بحرّية هنا

272
00:18:10,500 --> 00:18:12,220
أخبرني ما الّذي يدور في ذهنك

273
00:18:15,470 --> 00:18:18,140
...ما الّذي يمكنني قوله بشأن هذا

274
00:18:18,850 --> 00:18:21,100
ما رأي سان وسي؟

275
00:18:21,890 --> 00:18:23,260
لم أخبرهما بعد

276
00:18:24,430 --> 00:18:25,470
ليس بعد؟

277
00:18:26,040 --> 00:18:27,930
أتشكّ بهما أيضاً؟

278
00:18:29,890 --> 00:18:32,160
،من وجهة نظرك

279
00:18:32,160 --> 00:18:34,270
هذا مفهوم

280
00:18:34,270 --> 00:18:37,090
هذا يعني إذاً بأنّك تثق بي؟

281
00:18:39,770 --> 00:18:42,100
أتفوّه بكلام فارغ

282
00:18:42,100 --> 00:18:43,990
،ليست مسألة أنّك تثق بي

283
00:18:43,990 --> 00:18:46,240
إنّما لا تملك خياراً آخر

284
00:18:46,240 --> 00:18:48,480
،بوضع فينغ باوباو

285
00:18:48,480 --> 00:18:51,970
لو كنتُ العدوّ، فإنّك ستكون
في حالة يائسة تماماً

286
00:18:53,520 --> 00:18:54,590
أنت حكيم

287
00:18:55,270 --> 00:18:57,810
،حسناً يمكننا المُتابعة بهذا

288
00:18:57,810 --> 00:18:59,770
لكن لا أتأمّل كثيراً

289
00:19:01,680 --> 00:19:04,870
،لكن إذا أردت المُشاركة

290
00:19:04,870 --> 00:19:07,100
فيجب عليك مُناقشة الامر مع سان وسي

291
00:19:07,390 --> 00:19:10,350
رأيتُهما ينضجان ويكبران

292
00:19:10,350 --> 00:19:13,020
أعرف تماماً مَن يكونان

293
00:19:13,020 --> 00:19:14,640
وما الّذي يقدران عليه

294
00:19:15,120 --> 00:19:18,710
زانغ تشولان، هل تشعر بأنّك تحتاج
للسّيطرة على كلّ شيء

295
00:19:18,710 --> 00:19:22,200
بقبضتك قبل أن تشعر بالاطمئنان والرّاحة؟

296
00:19:22,200 --> 00:19:23,600
لا، ليس تماماً

297
00:19:23,920 --> 00:19:26,640
لا ينبغي أن تتحمّل عبء باوباو لوحدك

298
00:19:26,640 --> 00:19:28,080
لا يمكنك تحمُّل ذلك

299
00:19:28,080 --> 00:19:33,270
يجب أن تُوازن بين مخاطر ومكاسب
اختيارك لشخص موثوق

300
00:19:34,280 --> 00:19:35,380
أعلم ذلك

301
00:19:36,140 --> 00:19:38,320
!لكن هذه ليست غلطتي

302
00:19:38,320 --> 00:19:39,920
!فكّر في شخص مثل إيرزهوانغ

303
00:19:39,920 --> 00:19:42,970
في نهاية المطاف، هذا لأنّ هناك الكثير
...من عرباء الأطوار في عالم المنبوذين

304
00:19:43,270 --> 00:19:47,070
حسناً، لنعتمد خطّتك كما هي

305
00:19:47,070 --> 00:19:49,890
لذا، ماذا عن ذلك المعروف الّذي
طلبتُه منك في المرّة السّابقة؟

306
00:19:49,890 --> 00:19:51,940
...بخصوص ذلك

307
00:19:51,940 --> 00:19:53,440
أخبرني أين هو

308
00:19:53,440 --> 00:19:54,880
سأذهب إليه فوراً

309
00:19:55,680 --> 00:19:57,220
لكن لديّ شرطان

310
00:19:57,220 --> 00:19:59,080
الأوّل: أحتاج مُساعداً

311
00:19:59,080 --> 00:20:00,600
إذا نجحتُ، فسيكون هو

312
00:20:00,600 --> 00:20:03,470
الثّاني: بوجود تابع، سأكون قائداً

313
00:20:03,470 --> 00:20:05,390
ما رأيك بزيادة؟

314
00:20:06,270 --> 00:20:07,760
،لا بأس بالنّسبة للشّرط الأوّل

315
00:20:07,760 --> 00:20:10,540
لكن بالنّسبة للثّاني، اذهب وناقش
!الأمر مع سان وسي

316
00:20:10,540 --> 00:20:12,150
!لا تكن هكذا يا حضرة الرّئيس زاو

317
00:20:12,150 --> 00:20:13,600
!إنّهما شرطان بسيطان

318
00:20:19,320 --> 00:20:21,350
!هيّا يا مُعلّم، اقرأ بختي

319
00:20:24,170 --> 00:20:25,140
...هذا

320
00:20:28,970 --> 00:20:32,220
!ما خطبه؟ لم يقل شيئاً منذ زمن طويل

321
00:20:32,220 --> 00:20:33,680
!لهذا هو ظريف

322
00:20:33,680 --> 00:20:35,690
!إذاً هذا ليس تبصيراً

323
00:20:35,690 --> 00:20:37,900
!تبدين وكأنّكِ على وشك أن تأكليه

324
00:20:41,280 --> 00:20:42,220
...مُعلّم

325
00:20:42,970 --> 00:20:44,720
كان حظّي سيّئاً مؤخّراً

326
00:20:44,720 --> 00:20:46,140
هل يمكنك قراءة بختي؟

327
00:20:49,850 --> 00:20:51,180
!باور

328
00:20:51,450 --> 00:20:53,470
!أمسكي به! لا تدعيه يهرب

329
00:20:56,160 --> 00:20:57,790
!دعني يا زانغ تشولان

330
00:20:57,790 --> 00:20:59,690
!دع هذه الفتاة باو أن تفلتني

331
00:20:59,690 --> 00:21:02,010
أما زلت مُتغطرساً هكذا؟

332
00:21:02,010 --> 00:21:04,770
زانغ لينغيو، يا تلميذ التّينشيفو المُخزي

333
00:21:05,750 --> 00:21:07,920
،مضى وقت منذ افترقنا في جبل لونغو

334
00:21:07,920 --> 00:21:09,350
وسبّبت الكثير من المشاكل

335
00:21:09,350 --> 00:21:11,890
الّتي أدّتْ إلى طردك من الطّائفة

336
00:21:11,890 --> 00:21:13,180
،زانغ لينغيو

337
00:21:13,180 --> 00:21:15,280
نزلَ مُعلّمنا الجبل

338
00:21:15,280 --> 00:21:18,220
وأباد بسهولة كلّ أفراد طائفة
تشوان شينغ أولئك

339
00:21:18,220 --> 00:21:19,990
،وأنت أيضاً نزلت الجبل

340
00:21:19,990 --> 00:21:23,770
لكن تحالفت مع النّصل الكاشط للعِظام
،وبذرة الكارثة

341
00:21:23,770 --> 00:21:27,840
وقاتلتَ أولئك الّذين كانوا يُساعدون مُعلّمنا
في القضاء على طائفة تشوان شينغ

342
00:21:31,520 --> 00:21:34,140
هل أتيت لتعظني يا زانغ تشولان؟

343
00:21:35,350 --> 00:21:36,810
أوعظك؟

344
00:21:37,690 --> 00:21:42,150
،بصراحة، لم أعرف امرأة في حياتي

345
00:21:42,150 --> 00:21:43,850
ناهيك عن حبّ واحدة

346
00:21:43,850 --> 00:21:46,160
،لذا محال أن أفهم مشاعرك

347
00:21:46,160 --> 00:21:48,270
ولا أملك الحقّ في تقديم موعظة لك

348
00:21:48,790 --> 00:21:53,360
لكن أنا مُعجب برغبتك في التّضحية
بنفسك لأجل الآخرين

349
00:21:53,360 --> 00:21:57,390
ألم تقل في الأمس بأنّه مُجرّد غبيّ بلا مُستقبل؟

350
00:21:57,860 --> 00:21:59,730
الآنسة باو على حقّ

351
00:21:59,730 --> 00:22:01,820
لا أملك مستقبلاً

352
00:22:06,440 --> 00:22:07,680
ما مخطّطاتك؟

353
00:22:07,680 --> 00:22:10,480
لِمَ لا تأتي معي، وتعمل في الشّركة؟

354
00:22:10,480 --> 00:22:11,850
لا أحتاج شفقتك

355
00:22:11,850 --> 00:22:13,100
!أنت

356
00:22:13,100 --> 00:22:15,140
أتتذكّر كيف كنت تتبجّح أمامي؟

357
00:22:15,140 --> 00:22:18,640
!أشفق عليك؟ أتمنّى رؤيتك تفشل

358
00:22:19,290 --> 00:22:21,650
أنت غير مُثير للشّفقة، أنت مُفيد

359
00:22:21,650 --> 00:22:23,390
كلّ ما في الأمر أنّه لن يستأجرك أحدٌ الآن

360
00:22:23,390 --> 00:22:25,760
جبل لونغو قد طردك بالفعل

361
00:22:25,760 --> 00:22:28,220
،حتّى لو لم تُسبّب تلك الجلبة

362
00:22:28,220 --> 00:22:29,930
،كتلميذ للتينشيفو

363
00:22:29,930 --> 00:22:32,350
أولئك الصّالحون المزعومون لن يأخذوك أيضاً

364
00:22:33,240 --> 00:22:36,330
لكن لا تنسَ، لديك طلسم التّواصل السّماويّ

365
00:22:36,330 --> 00:22:38,770
في نهاية المطاف، سيأتي شخصٌ للبحث عنك

366
00:22:40,410 --> 00:22:41,900
...تبصير

367
00:22:42,970 --> 00:22:44,640
أما كان بمقدورك كتابة المزيد؟

368
00:22:44,640 --> 00:22:46,350
أجعلتها تبدو أكثر غموضاً؟

369
00:22:46,670 --> 00:22:51,720
لا يمكنك حتّى أن تنجح كمحتال بعد
مُغادرة جبل لونغو

370
00:22:52,340 --> 00:22:53,960
لا تبدو بحالة جيّدة

371
00:22:53,960 --> 00:22:54,770
ما الخطب؟

372
00:22:55,710 --> 00:22:57,350
،تلقّيتُ ضرباً مُبرحاً

373
00:22:57,350 --> 00:22:59,310
!لتنظيف مُخلّفاتك

374
00:23:00,850 --> 00:23:02,600
ليس وكأنّني ألومك

375
00:23:02,970 --> 00:23:06,290
لا تُسئ فهمي، أنا لا أعاملك بلطف

376
00:23:06,290 --> 00:23:09,470
المُعلّم زانغ، أتوسّل إليك أن تُساعدني

377
00:23:09,930 --> 00:23:12,970
أنت... تتوسّل إليّ؟

378
00:23:12,970 --> 00:23:15,710
،طائفة تشوان شينغ، جبل لونغو
،الرّابطة العالميّة

379
00:23:15,710 --> 00:23:18,300
...عشيرة وانغ، عشيرة ليو، عشيرة لو

380
00:23:18,300 --> 00:23:20,640
،منذ وطأت قدماي هذا العالم
أمسى الجميع يُراقبونني

381
00:23:20,640 --> 00:23:22,600
لا أستطيع الصّمود لوحدي فترة أطول

382
00:23:23,360 --> 00:23:26,220
مُعلّم، أنا مُرهَق جدّاً

383
00:23:27,850 --> 00:23:31,060
أريد فقط صديقاً أثق به ليدعمني

384
00:23:31,760 --> 00:23:34,360
،أعلم بأنّك لم تحبّني يوماً

385
00:23:34,360 --> 00:23:36,710
ونحن شخصان مُختلفاً تماماً

386
00:23:36,710 --> 00:23:40,060
حسناً يا مُعلّم، فكِّر في الأمر مليّاً

387
00:23:40,860 --> 00:23:43,280
أعطني جواباً فيما إذا كنت ستأتي أم لا

388
00:23:43,280 --> 00:23:45,320
باور، هيّا بنا

389
00:23:45,320 --> 00:23:46,060
حسناً

390
00:23:48,560 --> 00:23:51,680
،بالمناسبة، إذا انضممت لي في الشّركة

391
00:23:51,680 --> 00:23:54,620
سأعود مع ذلك وأزور المُعلّم
عندما يُسعفني الوقت

392
00:23:54,620 --> 00:23:58,890
لا يبدو أنّه من الملائم إحضار زميل معي