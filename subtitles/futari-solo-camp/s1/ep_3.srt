1
00:00:30,380 --> 00:00:31,300
!هذا لذيذ

2
00:00:31,870 --> 00:00:35,680
كيف يصبح اللّحم بهذه اللذة
بعد قليل من الشواء فقط؟

3
00:00:39,490 --> 00:00:42,780
.ويتماشى الطعم مع الجعة

4
00:00:42,780 --> 00:00:45,440
،الشواء على الشبكة جيّد أيضًا

5
00:00:45,830 --> 00:00:50,570
لكن طبخ اللّحم على صفيحة
.يوكوزاوا يرقى به إلى مستوى آخر

6
00:00:50,570 --> 00:00:52,380
!لا أستطيع التوقف عن الأكل

7
00:01:02,740 --> 00:01:07,370
...كان طبخها جيدًا أيضًا

8
00:01:37,460 --> 00:01:41,710
كان والدي يُحبّ صنع هذه
.الأعواد الريشية كثيرًا

9
00:01:45,310 --> 00:01:46,700
.ليس هكذا

10
00:01:46,700 --> 00:01:49,020
.عليك أن تُقطّع بسطحية ورفق أكثر

11
00:01:49,020 --> 00:01:49,880
ماذا؟

12
00:01:49,880 --> 00:01:53,330
.سئمتُ من هذا. افعلها أنت يا والدي

13
00:01:54,820 --> 00:01:56,600
.لا أستطيع فعلها من أجلك

14
00:01:56,600 --> 00:01:57,390
ماذا؟

15
00:01:57,390 --> 00:02:03,520
عندما تبدأ التخييم بمفردك، عليك
.أن تستطيع إنجاز كلّ شيء بنفسك

16
00:02:03,520 --> 00:02:09,020
كما أنّك ستذهب للتخييم رفقة
.شخص آخر يومًا ما

17
00:02:09,020 --> 00:02:12,650
.حينها سيتعيّن عليك أن تُعلّمه كما علّمتك

18
00:02:15,410 --> 00:02:18,530
.وستبدو رائعًا إن استطعت فعل ذلك كما ينبغي

19
00:02:18,530 --> 00:02:19,690
صحيح؟

20
00:02:21,910 --> 00:02:27,230
حتّى عندما حاولتُ الاستسلام، أصرّ
.والدي على أن أنجز كلّ شيء بنفسي

21
00:02:28,570 --> 00:02:32,900
.ربّما أدرك والدي أنّه سيموت في سن مبكرة

22
00:02:35,750 --> 00:02:37,310
ماذا أفعل؟

23
00:02:37,310 --> 00:02:40,600
أنا أفسد رحلة تخييمي المنفردة
.الأولى بعد انقطاع طويل

24
00:02:41,330 --> 00:02:42,930
...بصراحة

25
00:02:43,580 --> 00:02:46,170
.صرتُ أتصرف بشكل غريب منذ أن قابلتُها

26
00:02:50,850 --> 00:02:52,320
.يا شيزوكو

27
00:02:52,860 --> 00:02:55,160
.ماذا تفعلين؟ لنذهب

28
00:03:06,530 --> 00:03:10,040
هل ستذهبان للتخييم معًا مجددًا؟

29
00:03:10,320 --> 00:03:12,760
.لا بدّ أنّك تحبّين ذلك العجوز حقًا

30
00:03:12,760 --> 00:03:13,770
ماذا؟

31
00:03:14,560 --> 00:03:19,830
.لا، أنا... أحبّ التخييم فقط

32
00:03:19,830 --> 00:03:22,190
ستذهبين للتخييم مجددًا إذًا؟

33
00:03:22,190 --> 00:03:23,060
نهاية هذا الأسبوع؟

34
00:03:23,760 --> 00:03:25,060
،في الواقع

35
00:03:25,060 --> 00:03:31,190
قال غين-سان أنّه سيذهب إلى متجر
.معدات التخييم لشراء المزيد منها

36
00:03:31,820 --> 00:03:34,040
معدات تخييم إذًا؟

37
00:03:34,040 --> 00:03:37,450
.أودّ شراء خيمة خاصّة بي قريبًا

38
00:03:37,450 --> 00:03:39,780
.أجريت بعض الأبحاث

39
00:03:39,780 --> 00:03:41,540
،هناك عدّة خيارات

40
00:03:41,540 --> 00:03:45,770
أشعر أنّ زيارة ذلك المتجر
.قد يساعدني في اتخاذ القرار

41
00:03:54,480 --> 00:03:56,750
.قد تكون معدّات التخييم فخًا

42
00:03:56,750 --> 00:03:59,130
،بتقدّم التكنولوجيا وتغيّر الصيحات

43
00:03:59,130 --> 00:04:01,780
.تُطرَح منتجات جديدة تباعًا

44
00:04:01,780 --> 00:04:05,640
رغم أنَّنا نحبّ المعدات
،التي اعتدنا عليها

45
00:04:06,210 --> 00:04:10,150
إلّا أنّ رغبة البشر في اقتناء
.أشياء جديدة شيء طبيعي

46
00:04:12,350 --> 00:04:15,110
.ربَّما عليّ أن أبدأ بطحن قهوتي بنفسي

47
00:04:15,620 --> 00:04:18,750
.لا، سيزيد هذا من وزن حقيبتي كثيرًا

48
00:04:19,940 --> 00:04:21,600
.لكنّني أستطيع تجربها

49
00:04:22,620 --> 00:04:26,200
.وهكذا، يقع مخيِّم آخر في الفخ

50
00:04:26,760 --> 00:04:29,610
.أعدتُ تنظيم معداتي مؤخرًا

51
00:04:29,610 --> 00:04:30,930
.لا مشكلة

52
00:04:32,820 --> 00:04:34,170
...المعذرة

53
00:04:34,170 --> 00:04:35,170
نعم؟

54
00:04:35,170 --> 00:04:38,840
.يا-يا لها من مصادفة يا غين-سان

55
00:04:41,840 --> 00:04:46,100
.كما ظننت. إنّه ليس سعيدًا

56
00:04:46,100 --> 00:04:48,530
.ماذا؟ لا يبدو سعيدًا برؤيتها

57
00:04:48,530 --> 00:04:50,300
.كما أخبرتك

58
00:04:50,300 --> 00:04:52,740
في الواقع، ألا نتصرف كمطاردتين نوعًا ما؟

59
00:04:52,740 --> 00:04:53,740
حقًا؟

60
00:04:53,740 --> 00:04:57,610
هذا هو غين-سان الذي تكلّمت عنه إذًا؟

61
00:04:57,610 --> 00:05:00,890
هل يفترض أنّ ندع شيزوكو
تحت رعاية هذا الرجل؟

62
00:05:00,890 --> 00:05:03,120
.قد يكون وسيمًا إن حلق لحيته

63
00:05:03,120 --> 00:05:04,580
ماذا؟

64
00:05:04,580 --> 00:05:06,150
ماذا تفعلين هنا؟

65
00:05:07,160 --> 00:05:12,440
حسنًا... أتيتُ إلى هنا لشراء
.خيمة تخييم فردية

66
00:05:12,440 --> 00:05:13,740
.إنّها موجودة هنا

67
00:05:16,050 --> 00:05:18,900
كيف عرفتِ مكاني على أيّ حال؟

68
00:05:18,900 --> 00:05:21,540
.ذكرتَ الأمر في رسالتك

69
00:05:22,500 --> 00:05:24,940
.بدأتُ أعتاد على تصرفاتكِ الغريبة

70
00:05:26,410 --> 00:05:30,280
.وأنا مسؤول عن ما أنقذته

71
00:05:30,280 --> 00:05:32,450
.لا أمانع تخصيص بعض الوقت لك

72
00:05:32,450 --> 00:05:34,310
.أبلغيني مسبقًا فقط

73
00:05:34,810 --> 00:05:37,320
ما أنقذه"؟"

74
00:05:38,010 --> 00:05:40,900
هل يعتبرني كحيوان أليف؟

75
00:05:42,060 --> 00:05:43,060
هنا

76
00:05:43,660 --> 00:05:45,080
.الخيام هنا

77
00:05:45,590 --> 00:05:48,790
.الخيام الفردية موجودة هنا

78
00:05:52,360 --> 00:05:55,790
رأيتُ على الإنترنت أنَّ خيمة
لشخصين أو ثلاثة أسهل استخدامًا

79
00:05:56,170 --> 00:05:58,130
.ليست معلومة خاطئة

80
00:05:58,130 --> 00:06:02,550
تتيح لك حفظ معدّاتك داخل
.خيمتك كما أنّها أوسع

81
00:06:02,550 --> 00:06:07,080
لكن يسعك حلّ مشاكل المعدات
.باستخدام الرواق بفعالية

82
00:06:07,080 --> 00:06:08,760
.هذه المنطقة هنا

83
00:06:08,760 --> 00:06:11,060
.تقصد المنطقة الموجودة فور الدخول

84
00:06:11,060 --> 00:06:16,690
نعم. عادة ما تكون منفصلة عن
.مساحة المعيشة لذا انظري إليها جيدًا

85
00:06:16,690 --> 00:06:21,820
فهمت. إذًا ربّما لا أحتاج إلى
.خيمة كبيرة لشخصين

86
00:06:21,820 --> 00:06:25,700
النقاط الأساسية التي يجب
مراعاتها عند اختيار خيمة هي

87
00:06:26,070 --> 00:06:31,730
،الوزن، قابلية السكن، المتانة
.مقاومة الماء والرياح، وحجمها بعد الطي

88
00:06:32,180 --> 00:06:35,210
.تنقسم الخيام عمومًا إلى نوعين

89
00:06:35,210 --> 00:06:37,350
.أولًا، الخيام المُستقلة

90
00:06:37,350 --> 00:06:41,270
إنّها خيام لا تحتاج إلى تثبيتها
.بالأرض باستخدام الأوتاد

91
00:06:41,270 --> 00:06:45,040
وهناك أيضًا خيام شبه مستقلّة
.تُستخدم فيها الأوتاد فقط لتثبيت المدخل

92
00:06:45,040 --> 00:06:47,390
.ثانيًا، الخيام غير المستقلة

93
00:06:47,390 --> 00:06:52,060
.تُثبَّت بالأرض باستخدام الحبال والأعمدة

94
00:06:52,440 --> 00:06:56,150
واستخدامها أصعب عندما لا يمكن
.غرس الأوتاد في الأرض

95
00:06:56,150 --> 00:07:00,640
فهمت. هل كنتُ أستخدم
خيمة مستقلة ذلك اليوم؟

96
00:07:00,640 --> 00:07:06,320
نعم، ما إن تُقرري نوع الخيمة
.تنتقلين بعدها لاختيار تصميمها

97
00:07:06,740 --> 00:07:09,870
.الخيام ذات الجدارين هي الأكثر شيوعًا

98
00:07:09,870 --> 00:07:14,440
وهذا النّوع يعلوه طبقة
.خارجية مقاومة للماء

99
00:07:14,440 --> 00:07:16,830
،ولا يُحافظ ذلك على جفاف الداخل فقط

100
00:07:16,830 --> 00:07:20,420
بل يسعك أيضًا تخزين المعدات
.بين الخيمة وتلك الطبقة

101
00:07:20,420 --> 00:07:24,030
.ما يترك مساحة أكبر في الداخل

102
00:07:24,030 --> 00:07:26,400
.بعدها، لدينا خيام الجدار الواحد

103
00:07:26,400 --> 00:07:30,550
تكون الخيمة نفسها مقاومة
.للماء ونفّاذة للرطوبة

104
00:07:30,550 --> 00:07:33,820
.ما يجعل نصبها وفكّها سهلًا

105
00:07:33,820 --> 00:07:37,990
لكنّها لا تحتوي على مساحة أمامية
،ولا تسمح بمرور الهواء كالخيام ذات الجدارين

106
00:07:37,990 --> 00:07:41,020
ما يؤدي لتكاثف البخار داخلها
.لذا استخدامها أصعب

107
00:07:41,020 --> 00:07:42,400
.فهمت

108
00:07:42,400 --> 00:07:46,660
عند التخييم سيرًا، من المُهم
.مراعاة وزن الأمتعة وحجمها

109
00:07:46,660 --> 00:07:49,910
قد تشعرين بالنشاط في البداية
.لكن غالبًا ما سينال منك التعب عند المغادرة

110
00:07:50,610 --> 00:07:53,860
لذا من الأفضل أن تختاري خيمة
خفيفة، صغيرة ومتينة

111
00:07:53,860 --> 00:07:56,100
.ومقاومة للماء

112
00:07:56,100 --> 00:07:59,920
قد تزداد تكلفتها عند الحرص
على جودة المواد

113
00:08:00,440 --> 00:08:04,040
ورغم كلّ ما قلته، يظل
...العامل الأهم هو

114
00:08:04,040 --> 00:08:05,170
نعم؟

115
00:08:05,930 --> 00:08:07,170
.المظهر

116
00:08:07,170 --> 00:08:08,290
ماذا؟

117
00:08:08,290 --> 00:08:10,370
.المظهر مُهم

118
00:08:10,370 --> 00:08:12,730
،حتّى وإن توفّر لديك كلّ شيء آخر

119
00:08:12,730 --> 00:08:16,430
ستشعرين بعدم الرضا في النهاية
.إن لم يعجبك المظهر

120
00:08:16,430 --> 00:08:19,770
".كما يقال "الأناقة تتطلب تضحية

121
00:08:19,770 --> 00:08:21,310
.صحيح

122
00:08:21,770 --> 00:08:25,120
.بعبارة أخرى، لا شيء يفوق حُسن المظهر

123
00:08:25,120 --> 00:08:26,810
.فهمت

124
00:08:30,440 --> 00:08:32,740
.إن فهمتِ كلامي فاختاري واحدة بنفسك

125
00:08:32,740 --> 00:08:35,580
ماذا؟ ألن تختار معي؟

126
00:08:35,910 --> 00:08:38,560
.عليّ إنجاز تسوّقي

127
00:08:38,560 --> 00:08:39,960
!لئيم

128
00:08:50,400 --> 00:08:52,280
!بصحتك

129
00:08:56,990 --> 00:08:58,030
.أنت

130
00:08:58,660 --> 00:09:00,260
.سأغادر الآن

131
00:09:00,260 --> 00:09:01,590
.حسنًا

132
00:09:01,590 --> 00:09:02,780
ماذا؟

133
00:09:02,780 --> 00:09:04,770
هل تنتقين أغراضًا أخرى إضافة للخيمة؟

134
00:09:05,910 --> 00:09:07,960
.النظر إليها جعلني أرغب فيها

135
00:09:07,960 --> 00:09:10,270
.لكنّني محتارة بخصوص ما سأختار

136
00:09:10,270 --> 00:09:15,160
لا أفهم الفرق بين الموقد
.الغازي وموقد الطبخ

137
00:09:15,160 --> 00:09:18,420
.الكلمة الأولى ألمانية والثانية إنجليزية

138
00:09:18,420 --> 00:09:20,340
.لا فرق بينهما

139
00:09:20,340 --> 00:09:23,040
.كلاهما جهاز طبخ محمول

140
00:09:23,040 --> 00:09:25,570
.النقطة الأساسية هي المادة

141
00:09:25,570 --> 00:09:27,420
المادة؟

142
00:09:27,790 --> 00:09:32,680
تبقى مسألة تفضيل لكن الألمنيوم
.أفضل للطبخ البسيط والسهل

143
00:09:34,350 --> 00:09:37,730
.اشترِ ما تريدين فقط

144
00:09:37,730 --> 00:09:38,930
ماذا؟

145
00:09:38,930 --> 00:09:40,930
.ذلك من التيتانيوم

146
00:09:40,930 --> 00:09:44,020
.الذي استخدمته لتحضير القهوة

147
00:09:45,280 --> 00:09:47,440
.سأغادر فعلًا هذه المرة

148
00:09:47,440 --> 00:09:50,440
.حسنًا. شكرًا

149
00:09:59,840 --> 00:10:02,710
.سأبقى... على اتصال

150
00:10:02,710 --> 00:10:04,570
...حـ-حسنًا

151
00:10:08,880 --> 00:10:10,900
.أصبنا بالقدوم

152
00:10:10,900 --> 00:10:14,220
"ألن تختار معي؟"

153
00:10:14,220 --> 00:10:15,340
أسمعتِ؟

154
00:10:15,340 --> 00:10:17,320
.بدا أنّكما على وفاق

155
00:10:17,320 --> 00:10:19,320
.وغين-سان يتكلّم أكثر مما ذكرتِ

156
00:10:19,320 --> 00:10:22,100
.كنتما في موعد حرفيًا

157
00:10:22,100 --> 00:10:23,100
!ماذا؟

158
00:10:23,100 --> 00:10:27,290
لا يكف الأوتاكو عن الكلام
.عندما يُفتَح باب الحديث عن شغفهم

159
00:10:28,750 --> 00:10:33,490
.اللّعنة. من الممتع جدًا التحدث عن العتاد

160
00:10:51,000 --> 00:10:52,540
!غين-سان

161
00:10:58,170 --> 00:10:59,990
ما هذا التعبير؟

162
00:10:59,990 --> 00:11:02,770
.أنا سعيدة أنَّ هذا ليس حلمًا

163
00:11:03,130 --> 00:11:08,020
على أيّ حال يا غين-سان، أشكرك
.لذهابك لتخييم منفرد معي

164
00:11:09,110 --> 00:11:10,460
.نعم

165
00:11:10,460 --> 00:11:12,400
هل نبدأ بنصب خيامنا؟

166
00:11:12,710 --> 00:11:14,080
...قبل ذلك

167
00:11:14,610 --> 00:11:18,000
.لنراجع قواعد تخييمنا المنفرد لشخصين

168
00:11:18,000 --> 00:11:20,370
.سأحدّد المسافة بين خيمتينا

169
00:11:20,370 --> 00:11:25,470
وإن كنتُ معلّمك، لا يحق لكِ
.الاعتراض على قراراتي

170
00:11:26,290 --> 00:11:32,650
ما بعد المسافة التي
سيحدد لنصب خيامنا؟

171
00:11:34,760 --> 00:11:35,860
!أنت

172
00:11:36,910 --> 00:11:37,730
.هنا

173
00:11:37,730 --> 00:11:40,550
ماذا؟ ألا تمانع أن تكون بهذا القرب؟

174
00:11:40,930 --> 00:11:43,700
.نستطيع زيادة المسافة إن كان لديك مشكلة

175
00:11:43,700 --> 00:11:45,500
.ماذا؟ لا، المسافة مناسبة

176
00:11:47,100 --> 00:11:51,130
.لن أستطيع الاعتناء بك إن ابتعدتِ كثيرًا

177
00:11:51,130 --> 00:11:52,690
...نوعًا ما

178
00:11:52,770 --> 00:11:54,930
.أنت لا تتصرف على طبيعتك المعتادة

179
00:11:54,930 --> 00:11:57,300
!أستطيع الابتعاد جدًا إن أردتِ

180
00:11:58,500 --> 00:12:00,490
يمكنك فعلها بنفسك، صحيح؟

181
00:12:00,490 --> 00:12:02,780
.تعلّمتُ بمشاهدة فيديو هذه المرة

182
00:12:03,350 --> 00:12:06,790
سأريك أنّني أستطيع خيمتي
!الباندا الحمراء الصغيرة

183
00:12:07,170 --> 00:12:09,500
باندا... ماذا؟

184
00:12:07,590 --> 00:12:10,430
!تفقّدني بين الحين والآخر رجاء

185
00:12:10,430 --> 00:12:12,170
هل اقتنت خيمة باندا؟

186
00:12:27,560 --> 00:12:29,060
!نعم، نعم، نعم

187
00:12:29,060 --> 00:12:32,450
استغرق هذا وقتًا أطول ممّا
.توقعت لكن النتيجة جيدة

188
00:12:32,450 --> 00:12:35,820
واستطعتُ فعلها بنفسي
.بقراءة التعليمات

189
00:12:35,820 --> 00:12:38,190
.إنّها ظريفة حقًا

190
00:12:38,190 --> 00:12:41,990
.إنّها مثل قبعة مدبّبة واللّون الأحمر رائع

191
00:12:46,330 --> 00:12:47,580
.والآن

192
00:12:48,030 --> 00:12:50,080
.عذرًا على التطفل

193
00:12:50,080 --> 00:12:52,150
.إنّها فسيحة

194
00:13:00,500 --> 00:13:02,500
.المنظر رائع أيضًا

195
00:13:02,500 --> 00:13:04,280
.يسرني أنّني اخترتُ هذه

196
00:13:06,700 --> 00:13:08,680
.أحسنتِ صنعًا

197
00:13:08,680 --> 00:13:10,060
صحيح؟

198
00:13:10,060 --> 00:13:12,890
.لكن الظلام بدأ يحلّ بالفعل

199
00:13:14,460 --> 00:13:20,550
لكنّني أتيتُ مستعدة هذه المرة
.تحسبًا لأيّ تأخير في نصبها

200
00:13:20,550 --> 00:13:21,750
ماذا؟

201
00:13:24,370 --> 00:13:28,060
ماذا؟ لا موقد نار اليوم؟

202
00:13:28,060 --> 00:13:31,050
.نعم. يمكننا الطبخ مباشرة على نار مشتعلة

203
00:13:31,050 --> 00:13:32,120
نار مشتعلة؟

204
00:13:32,700 --> 00:13:37,040
بمعنى نار مشتعلة على الأرض
.دون حامل مُخصّص للموقد

205
00:13:37,040 --> 00:13:40,010
.لن تسمح معظم مواقع التخييم بهذا

206
00:13:40,010 --> 00:13:43,590
وهناك أيضًا بعض مواقع التخييم
.التي تحظر إشعال النيران بالكامل

207
00:13:43,590 --> 00:13:47,270
ماذا؟ لكن إشعال النار
.من أساسيات التخييم

208
00:13:47,270 --> 00:13:50,020
.هذا يعرف بالتخييم بأثر منخفض

209
00:13:50,020 --> 00:13:54,400
يعني ببساطة تقليل الضرر
.الواقع على الطبيعة

210
00:13:54,520 --> 00:13:59,040
مثلًا، إشعال النار مباشرة على الأرض
.يقتل الميكروبات في التربة

211
00:13:59,040 --> 00:14:02,150
.والعشب المحترق لا ينمو بسهولة مجددًا

212
00:14:02,150 --> 00:14:07,490
...هناك أيضًا مخاوف تتعلّق بالسلامة ولكن

213
00:14:08,290 --> 00:14:11,080
.هذه بعض الأسباب فقط

214
00:14:11,080 --> 00:14:15,010
.المشكلة الأكبر هي آداب المُخيّم

215
00:14:15,010 --> 00:14:16,540
آداب؟

216
00:14:16,820 --> 00:14:19,050
.انتبه لما يحيط بك

217
00:14:19,050 --> 00:14:21,550
.لا تحرق ما لا ينبغي حرقه

218
00:14:21,550 --> 00:14:24,150
.نظف ما خلّفته بعدك

219
00:14:24,150 --> 00:14:30,560
المُخيّمون الذين لا يلتزمون بأبسط الآداب
.يتسببون في اندثار عادة إشعال النار

220
00:14:31,230 --> 00:14:33,800
.لا تظنّي أنّك زبون ينتظر من يخدمه

221
00:14:33,800 --> 00:14:36,670
.لا أخبرك أن تكوني متواضعة

222
00:14:36,670 --> 00:14:38,060
.لا تكوني مغرورة فقط

223
00:14:38,880 --> 00:14:41,330
.لا يهم إن كنتِ مبتدئة أو خبيرة

224
00:14:41,330 --> 00:14:44,130
.التزمي بالقواعد واتبعي آداب السلوك السليم

225
00:14:44,130 --> 00:14:47,070
.افعلي ما هُو واضح

226
00:14:48,950 --> 00:14:54,710
من الغباء أن نُفسد مكان متعتنا بأيدينا
.حتّى لا نعود قادرين على استخدامه

227
00:14:55,200 --> 00:14:59,720
.فنحن ننتمي إلى هنا في النهاية

228
00:15:00,480 --> 00:15:01,860
هل تفهمين؟

229
00:15:01,860 --> 00:15:02,860
.نعم

230
00:15:03,720 --> 00:15:07,840
.أنتِ دائمًا ما تسببين لي مختلف المتاعب طبعًا

231
00:15:08,660 --> 00:15:10,680
أما زلت تقول هذا؟

232
00:15:10,680 --> 00:15:13,220
...لأنّك

233
00:15:15,150 --> 00:15:17,270
.معدتك تئن بشدة

234
00:15:17,270 --> 00:15:18,610
!اخرسي

235
00:15:18,610 --> 00:15:22,170
.لا بأس. سأشبع معدتك

236
00:15:22,170 --> 00:15:24,110
.حـ-حسنًا

237
00:15:25,480 --> 00:15:26,740
!أعددتُ وليمة من الأسياخ

238
00:15:28,370 --> 00:15:31,650
.سنشوي اليوم وليمة من الأسياخ

239
00:15:33,040 --> 00:15:34,010
.لنبدأ

240
00:15:34,010 --> 00:15:35,210
.مهلًا، مهلًا

241
00:15:35,210 --> 00:15:36,870
.ستحترق إن طبختِها هكذا

242
00:15:36,870 --> 00:15:38,000
ماذا؟

243
00:15:38,280 --> 00:15:41,910
النّار المتقدة شديدة الحرارة
.ولا تصلح للطبخ فوقها

244
00:15:41,910 --> 00:15:43,450
عليك استخدام جمر حي؟

245
00:15:43,450 --> 00:15:45,010
جمر حي؟

246
00:15:45,010 --> 00:15:47,240
.النيران الطبيعية كثيرًا ما تتقلّب

247
00:15:47,240 --> 00:15:49,630
.نحتاج إلى مصدر حرارة مستقر قدر الإمكان

248
00:15:49,630 --> 00:15:58,350
يُطلق على الحطب المتوهج المتبقي
".بعد انطفاء النار اسم "الجمر الحي

249
00:15:58,350 --> 00:16:03,700
السر هو إشعال النار بقوة أولًا
.بعدها ترك الحطب يتحول إلى فحم

250
00:16:04,410 --> 00:16:09,170
سيتوهج الفحم باللون الأحمر
.حين يسخن الحطب بالكامل

251
00:16:11,950 --> 00:16:16,290
إن لم تفعلي ذلك، ستُنتجين احتراقًا
.غير كامل ما يؤدي إلى تصاعد الدخان

252
00:16:16,290 --> 00:16:18,290
...عند حدوث ذلك

253
00:16:23,160 --> 00:16:28,050
استخدمي أنبوب النفخ لتقليل
.شدة اللهب وتحفيز التفحم

254
00:16:28,380 --> 00:16:31,740
يمكنك استخدام مروحة أيضًا
.لكن قد يؤدي ذلك لتطاير الرماد

255
00:16:28,760 --> 00:16:31,210
...تؤلمني عيناي

256
00:16:32,050 --> 00:16:35,620
.انظري، لم تعد تصدر دخانًا. إنّها جاهزة

257
00:16:44,190 --> 00:16:45,730
.إنّها جاهزة

258
00:16:46,630 --> 00:16:49,700
!أسياخ خضروات ملفوفة، شهية وصحية

259
00:16:57,600 --> 00:16:59,170
!لذيذ

260
00:17:00,510 --> 00:17:06,460
التالي لدينا ملفوف بلحم مقدد
!على الطريقة الفنلندية

261
00:17:10,150 --> 00:17:12,840
!الجبن محشو داخل الفطر

262
00:17:13,550 --> 00:17:16,310
!لذيذ

263
00:17:16,310 --> 00:17:18,170
!هناك المزيد

264
00:17:18,170 --> 00:17:20,020
!لنأكل ونشرب

265
00:17:20,020 --> 00:17:20,980
!نعم

266
00:17:26,720 --> 00:17:29,360
.شبعت

267
00:17:29,360 --> 00:17:31,320
.كان هذا لذيذًا. شكرًا على الطعام

268
00:17:31,820 --> 00:17:35,410
الطبخ هو المجال الوحيد
.الذي لا تخيبين فيه الظن

269
00:17:36,330 --> 00:17:37,830
!غين-سان

270
00:17:38,180 --> 00:17:39,830
ما الأمر؟

271
00:17:40,310 --> 00:17:42,770
...هلّا

272
00:17:43,260 --> 00:17:45,340
هلّا تبدأ بمناداتي باسمي؟

273
00:17:46,250 --> 00:17:47,340
ماذا؟

274
00:17:47,340 --> 00:17:49,710
"دائمًا ما تناديني بـ"أنتِ

275
00:17:49,710 --> 00:17:52,220
.لا تناديني باسمي أبدًا

276
00:17:52,220 --> 00:17:58,060
بما أنّنا بدأنا التخييم بمفردنا معًا
.فلا مانع في استخدام اسمي

277
00:17:58,590 --> 00:18:01,290
من يكترث بما أدعوك؟

278
00:18:01,290 --> 00:18:03,850
.ليس وكأنّنا سنخيم معًا للأبد

279
00:18:04,790 --> 00:18:08,360
أنا أنضم إليك حتّى تصيري
.قادرة على ذلك بمفردك فقط

280
00:18:08,360 --> 00:18:12,360
...لـ-لست مخطئًا

281
00:18:12,360 --> 00:18:18,010
.لكن التخييم معك أمر مميز بالنسبة لي

282
00:18:18,010 --> 00:18:22,750
حتّى لو تعلّمتُ التخييم بمفردي، أودّ منك
.التخييم المنفرد معي أحيانًا

283
00:18:24,460 --> 00:18:28,770
.التخييم رفقتك هو بداية مسيرتي

284
00:18:28,770 --> 00:18:34,250
تلك السماء المرصفة بالنجوم في
.ذلك اليوم الكارثي هي نقطة انطلاقي

285
00:18:34,250 --> 00:18:38,890
لولا ذلك، لقضيتُ وقتًا عصيبًا
.وربّما لم أعد للتخييم مجددًا

286
00:18:39,310 --> 00:18:43,060
.ما زلت أخيم بسببك

287
00:18:43,490 --> 00:18:45,660
،بسبب تلك السماء المرصعة بالنجوم

288
00:18:45,660 --> 00:18:50,820
فإنّ وجودي معك يمنحني الأمل
.في رؤية المزيد من المناظر الجميلة

289
00:18:50,820 --> 00:18:54,930
لا يزال هناك أمور كثيرة أريدك
.أن تُعلّمني إيّاها أيضًا

290
00:18:54,930 --> 00:18:57,780
...وكبشريين، فإنّ مناداة بعضنا بأسمائنا

291
00:18:57,780 --> 00:19:01,330
.حسنًا، حسنًا. علينا أن نذهب للنوم

292
00:19:01,330 --> 00:19:03,710
...ماذا؟ بالفعل؟ لكن

293
00:19:03,710 --> 00:19:07,030
.ينتظرنا صباح باكر
.يُستحسن أن تستيقظي باكرًا

294
00:19:07,030 --> 00:19:08,590
هل فهمت يا كوسانو؟

295
00:19:08,590 --> 00:19:11,530
.عفوًا، أفضّل أن تناديني شيزوكو

296
00:19:11,530 --> 00:19:14,090
.كوسانو ليس اسمًا ظريفًا

297
00:19:14,090 --> 00:19:16,470
أنتِ متطلبة حقًا

298
00:19:16,470 --> 00:19:19,230
ما خطبك؟

299
00:19:19,230 --> 00:19:20,640
.القاعدة 4

300
00:19:20,640 --> 00:19:23,470
.اخرسي وأطيعي معلّمك يا شيزوكو

301
00:19:23,470 --> 00:19:25,260
!ا-اسمي

302
00:19:25,260 --> 00:19:26,730
!اذهبي

303
00:19:28,760 --> 00:19:30,320
.تصبح على خير

304
00:19:46,320 --> 00:19:49,710
.صباح الخير

305
00:19:52,230 --> 00:19:54,280
.لا يزال الظلام مخيمًا

306
00:19:54,280 --> 00:19:57,380
لِم اخترت هذه الساعة؟

307
00:19:57,720 --> 00:20:00,460
.سنتأخر كثيرًا إن انتظرنا الضوء

308
00:20:00,460 --> 00:20:02,360
ماذا؟ لماذا؟

309
00:20:02,880 --> 00:20:05,980
،لا أعرف إن رأيتهِ من قبل

310
00:20:05,980 --> 00:20:09,480
.لكنّني أحب مشاهدة هذا

311
00:20:28,480 --> 00:20:29,740
ماذا؟

312
00:20:29,740 --> 00:20:31,960
.إنّه جميل

313
00:20:42,390 --> 00:20:44,340
.نظّفتِ بشكل أفضل بكثير مما توقعت

314
00:20:44,340 --> 00:20:47,580
نعم، رغبت في أن أترك
.المكان أنظف ممّا وجدته

315
00:20:48,580 --> 00:20:49,520
.نعم، هذا صحيح

316
00:20:49,800 --> 00:20:53,230
،لطالما أعجبتني هذه العبارة

317
00:20:53,230 --> 00:20:56,610
.لكنّني قبلتها دون تفكير عميق

318
00:20:58,240 --> 00:21:03,830
،لكن بعد التخييم عدّة مرات
،والاستماع إليك

319
00:21:04,470 --> 00:21:07,370
،ورؤية ذلك المنظر الجميل

320
00:21:07,890 --> 00:21:11,490
.أودّ أن أراه مجددًا هنا

321
00:21:11,990 --> 00:21:15,840
،أنا متأكد أنّ آخرين يبادلون الشعور

322
00:21:15,840 --> 00:21:20,340
.لذا عليّ أن أبقي هذا المكان نظيفًا من أجلهم

323
00:21:21,210 --> 00:21:23,270
.للأشخاص الذين سيزورون مستقبلًا

324
00:21:23,270 --> 00:21:27,100
للأشخاص الذين تأثروا برؤيته
.أول مرة كما حدث معي

325
00:21:27,100 --> 00:21:30,790
،وإن أحسّوا بنفس شعوري

326
00:21:30,790 --> 00:21:35,480
.سيتركون المكان نظيفًا لزيارتي القادمة أيضًا

327
00:21:36,480 --> 00:21:37,480
.على ما أظن

328
00:21:37,480 --> 00:21:39,990
أتعتقد أنّي أنانية؟

329
00:21:41,490 --> 00:21:44,350
.يبدو لي هذا رائعًا

330
00:21:44,350 --> 00:21:47,370
.لا يختلف كثيرًا عمّا أشعر به

331
00:21:51,000 --> 00:21:51,990
.غين-سان

332
00:21:53,730 --> 00:21:56,750
.آمل أن ترافقني في التخييم مجددًا

333
00:21:59,240 --> 00:22:01,440
.حسنًا. إلى اللقاء

334
00:23:37,620 --> 00:23:42,310
كيف يمكنني شرح متعة التخييم المنفرد؟

335
00:23:43,440 --> 00:23:47,240
الحلقة 4 ماذا تفعل أثناء التخييم؟