1
00:00:02,190 --> 00:00:03,360
.إخوة

2
00:00:04,230 --> 00:00:05,650
.رفقاء عمل

3
00:00:06,110 --> 00:00:09,280
.وهذان الاثنان اللذان التقيا صدفة

4
00:00:12,450 --> 00:00:15,830
أهذا وضع سيئ؟ أم فرصة؟

5
00:00:15,830 --> 00:00:19,120
!مهلًا، خليل شيزوكو طاعن في السن

6
00:00:19,120 --> 00:00:22,130
ماذا يفعلان هنا؟

7
00:00:23,000 --> 00:00:25,340
،غير مدركين لعلاقاتهم مع بعض

8
00:00:25,340 --> 00:00:27,870
.اجتمع هؤلاء الأربعة في رحلة تخييم

9
00:02:11,780 --> 00:02:14,490
.حسنًا، نصب الجميع خيامهم

10
00:02:18,260 --> 00:02:20,490
.سـ-سأذهب لأتمشّى قليلًا

11
00:02:20,490 --> 00:02:23,870
...ماذا؟ عفوًا، سأرافقك

12
00:02:23,870 --> 00:02:25,000
.سأرافقك

13
00:02:25,000 --> 00:02:26,000
!لا

14
00:02:27,710 --> 00:02:29,590
.نحن نقضي وقتًا منفردين

15
00:02:34,260 --> 00:02:36,390
!غضب غين-تشان وغادر

16
00:02:36,390 --> 00:02:39,640
!ماذا؟ هذا ليس خطئي

17
00:02:42,310 --> 00:02:43,640
...عفوًا

18
00:02:44,060 --> 00:02:45,520
ما الأمر؟

19
00:02:45,520 --> 00:02:48,900
هـ-هل تودّين الذهاب للصيد معًا؟

20
00:02:48,900 --> 00:02:51,150
.ليس لديّ وقت لذلك الآن

21
00:02:52,230 --> 00:02:54,400
حـ-حقًا؟

22
00:03:02,040 --> 00:03:04,080
كيف حدث هذا؟

23
00:03:04,080 --> 00:03:05,920
.هذا كلامي

24
00:03:07,080 --> 00:03:09,420
.أخ شيزوكو

25
00:03:09,710 --> 00:03:13,050
.مرحبًا. اسمي كوسانو كاي

26
00:03:13,440 --> 00:03:17,550
سيكون من المربك مناداتي
.كوسانو لذا نادِني كاي

27
00:03:18,970 --> 00:03:21,810
.أنا كينوكورا غين. تشرفت بلقائك

28
00:03:22,110 --> 00:03:23,470
غين-سان، صحيح؟

29
00:03:23,470 --> 00:03:25,520
.حدثتني شيزوكو عنك

30
00:03:25,520 --> 00:03:28,190
.لا داعي لتكون رسميًا
.تحدث بشكل طبيعي

31
00:03:29,270 --> 00:03:31,190
حـ-حقًا؟

32
00:03:34,740 --> 00:03:37,700
.أولًا، لنوضّح شيئًا

33
00:03:38,030 --> 00:03:40,950
ما علاقتك بهوشيزاكي-سان يا غين-سان؟

34
00:03:41,620 --> 00:03:43,770
ما علاقتنا؟

35
00:03:45,190 --> 00:03:48,080
.لا أعرف

36
00:03:48,080 --> 00:03:49,220
ماذا؟

37
00:03:49,960 --> 00:03:53,390
أعتقد أنّنا صديقان؟

38
00:03:53,390 --> 00:03:58,470
صادفنا بعضنا بعض المرّات
وذهبنا للتخييم مرّة مع شيزوكو

39
00:03:58,800 --> 00:04:00,840
هـ-هذا فقط؟

40
00:04:01,180 --> 00:04:03,260
.نعم، هذا فقط

41
00:04:03,260 --> 00:04:06,350
.لكنّني لا أعرف ما الذي تفكّر فيه هي

42
00:04:09,100 --> 00:04:10,810
هذا كلّ ما في الأمر؟

43
00:04:11,230 --> 00:04:16,650
عفوًا، هل تودّ الصيد سويًا؟

44
00:04:17,500 --> 00:04:18,860
.نعم

45
00:04:22,450 --> 00:04:23,870
!اصطدتُ واحدة

46
00:04:23,870 --> 00:04:24,790
هل علقت السمكة؟

47
00:04:24,790 --> 00:04:25,910
!هيّا، هيّا، هيّا

48
00:04:25,910 --> 00:04:27,000
!رائع

49
00:04:27,000 --> 00:04:28,630
!واصل السحب

50
00:04:30,920 --> 00:04:33,670
.أنت بارع. اصطدتَ واحدة

51
00:04:33,670 --> 00:04:37,920
...لأنّك علّمتني الطريقة. شكرًا

52
00:04:39,930 --> 00:04:43,930
أردتُ خوض هذه التجربة
.مع هوشيزاكي-سان

53
00:04:46,970 --> 00:04:48,680
.آسف حيال ذلك

54
00:04:49,140 --> 00:04:51,730
.لا بأس

55
00:04:52,020 --> 00:04:53,360
.لنُعد الكرّة

56
00:04:53,360 --> 00:04:55,730
.سنجعل اليوم يومًا للصيد

57
00:04:55,730 --> 00:04:58,240
.حسنًا

58
00:05:06,540 --> 00:05:07,700
.حسنًا

59
00:05:10,250 --> 00:05:11,620
.يوي-تشان

60
00:05:13,250 --> 00:05:15,420
ما رأيك بالتحدث قليلًا؟

61
00:05:16,250 --> 00:05:17,840
.حسنًا

62
00:05:19,090 --> 00:05:21,180
!إذًا، بصحتك

63
00:05:21,180 --> 00:05:22,220
!بصحتك

64
00:05:27,260 --> 00:05:28,850
.مضت فترة

65
00:05:29,430 --> 00:05:30,730
...نعم

66
00:05:31,560 --> 00:05:34,060
.لم أتوقع أن نلتقي هكذا

67
00:05:34,060 --> 00:05:36,690
.نعم. فوجئتُ أيضًا

68
00:05:37,320 --> 00:05:39,690
أين ذهبت للتخييم مؤخرًا؟

69
00:05:40,190 --> 00:05:43,330
.قرب جبل فوجي وتانزاوا

70
00:05:43,330 --> 00:05:45,570
.جميل

71
00:05:45,570 --> 00:05:48,330
.لا شك أنّك طبختِ وجبات شهية كالعادة

72
00:05:49,120 --> 00:05:51,250
لديّ صور. هل تودّين رؤيتها؟

73
00:05:54,960 --> 00:05:56,840
.يبدو هذا لذيذًا

74
00:05:57,960 --> 00:06:00,590
ماذا عنك يا يوي-تشان؟
هل ذهبتِ للتخييم مؤخرًا؟

75
00:06:00,880 --> 00:06:04,590
.لم أخيّم منذ رحلتنا الأخيرة نحن الثلاثة

76
00:06:05,220 --> 00:06:08,600
.يبدو أنّ علاقتكما جيّدة كالمعتاد

77
00:06:10,310 --> 00:06:12,350
.لستُ متأكدة من ذلك

78
00:06:13,350 --> 00:06:17,360
.آمل ألّا أكون الوحيدة التي تفكّر هكذا

79
00:06:17,820 --> 00:06:19,400
.الأمر واضح بمجرد النظر

80
00:06:19,400 --> 00:06:20,480
ماذا؟

81
00:06:25,360 --> 00:06:30,740
يوي-تشان، ما زلتِ... تحبّين غين-سان، صحيح؟

82
00:06:31,700 --> 00:06:36,230
.أظنني كذلك على الأرجح

83
00:06:37,000 --> 00:06:40,010
.لكنّني لستُ متأكدة

84
00:06:40,500 --> 00:06:44,840
،ارتبكت وغضبت سابقًا لأنّني تفاجأت

85
00:06:44,840 --> 00:06:48,010
لكنّني لم أعد أشعر برغبة
.قوية في الارتباط

86
00:06:50,470 --> 00:06:53,390
.سأصارحك الآن

87
00:06:53,390 --> 00:06:57,150
راسلت غين-سان في الواقع
.وطلبت منه أن نخرج في مواعيد

88
00:06:57,150 --> 00:06:59,400
مـ-مواعيد؟

89
00:06:59,400 --> 00:07:02,070
.لكنّه تجاهل كلّ ذلك

90
00:07:02,070 --> 00:07:05,150
.لم يرد إلّا حين سألتُ عن التخييم

91
00:07:06,320 --> 00:07:12,040
.في النهاية، أنتِ مميزة بالنسبة له

92
00:07:14,290 --> 00:07:20,880
ولو تنازعنا عليه، فأشك
.أنّه سيلتفت إليّ

93
00:07:20,880 --> 00:07:23,550
.لا يستحق الأمر الصراع عليه

94
00:07:23,840 --> 00:07:25,010
!سخيف

95
00:07:28,860 --> 00:07:34,560
.وأيضًا، أظنني أحبّك أيضًا

96
00:07:34,560 --> 00:07:39,710
لذا لم أعد مهتمة حقًا

97
00:07:40,310 --> 00:07:45,320
.أشعرني التحدث عن الأمر براحة أكبر

98
00:07:45,320 --> 00:07:46,860
...يوي-تشان

99
00:07:49,030 --> 00:07:50,280
.شيزوكو-تشان

100
00:07:50,700 --> 00:07:54,160
بما أنّنا هنا، لِم لا نذهب للصيد أيضًا؟

101
00:07:56,000 --> 00:08:00,540
قالت هوشيزاكي-سان أنّها
.مهتمة بالصيد والتخييم

102
00:08:00,540 --> 00:08:03,210
.كان عليك أن تحضرها معك إذًا

103
00:08:04,920 --> 00:08:08,720
.قالت أنّها لا تملك وقتًا لذلك الآن

104
00:08:10,510 --> 00:08:15,770
.حسنًا، تبدو كالنوع الذي يعجبها

105
00:08:15,770 --> 00:08:17,940
.أظنّ أنّ هذا منطقي

106
00:08:18,480 --> 00:08:20,520
...أخبرتك أنّني لست

107
00:08:20,520 --> 00:08:23,860
...نعم، أعلم ولكن

108
00:08:25,480 --> 00:08:29,610
قلتَ أنّك تذهب للتخييم
مع شيزوكو كثيرًا يا غين-سان، صحيح؟

109
00:08:29,610 --> 00:08:33,240
نعم. وماذا في ذلك؟

110
00:08:33,660 --> 00:08:40,500
حسنًا، لم أتوقع أن تكون هوشيزاكي من
.النّوع الذي يسرق رجلًا من أحد

111
00:08:41,500 --> 00:08:44,250
...في الواقع

112
00:08:44,620 --> 00:08:47,630
.لا نتواعد حقًا

113
00:08:47,630 --> 00:08:48,630
ماذا؟

114
00:08:52,220 --> 00:08:56,270
ومع ذلك كنتَ تصطحب فتاة أصغر منك
تحمل مشاعر تجاهك؟

115
00:08:56,270 --> 00:08:59,020
.لن أصف الأمر هكذا

116
00:09:03,560 --> 00:09:08,820
هل تفكّر بجدية في علاقتك
مع شيزوكو يا غين-سان؟

117
00:09:15,280 --> 00:09:18,580
.آسف. كان كلامي قاسيًا

118
00:09:18,580 --> 00:09:21,420
.أنا لا أعرف حتّى تفاصيل علاقتكما

119
00:09:22,540 --> 00:09:23,750
.لا بأس

120
00:09:25,380 --> 00:09:30,340
.حين تُقرّر أمرًا، لا ترى شيئًا سواه

121
00:09:30,340 --> 00:09:34,800
.أعلم أنّها قد تزعجك أحيانًا

122
00:09:35,430 --> 00:09:38,810
.لكنّني أقلق عليها دائمًا

123
00:09:39,310 --> 00:09:44,980
فارق العشر سنوات يجعلها تبدو
.أقل كأخت وأكثر كابنة

124
00:09:45,610 --> 00:09:49,990
ربّما من الغريب أن أقول هذا عن
.فرد من العائلة، لكنّها فتاة طيبة

125
00:09:50,940 --> 00:09:53,070
.إنّها صادقة وصريحة

126
00:09:56,580 --> 00:09:58,700
.لا تفعل أيّ شيء مشبوه

127
00:09:58,700 --> 00:10:01,620
.إنّها أخت أفضل ممّا أستحق

128
00:10:02,210 --> 00:10:07,840
إن اختارتك فلا بدَّ أنّها تعتقد
.أنّك لستَ شخصًا سيئًا أيضًا

129
00:10:09,960 --> 00:10:13,680
،أعلم أنّ الأمر ليس من شأني

130
00:10:14,300 --> 00:10:16,340
...لكن إن لم تكن مهتمًا بها

131
00:10:16,890 --> 00:10:20,000
.لا، علي أن أتوقف قبل أن أتفوه بحماقة

132
00:10:20,000 --> 00:10:24,730
أعتذر. لا أريد أن أرى
.أختي الصغيرة حزينة فقط

133
00:10:28,190 --> 00:10:29,480
...أنا

134
00:10:29,480 --> 00:10:32,990
!غين-سان! كاي

135
00:10:35,660 --> 00:10:39,870
فكّر في كلامي يا غين-سان، اتفقنا؟

136
00:10:39,870 --> 00:10:41,560
...حسنًا

137
00:10:42,370 --> 00:10:44,330
إذًا؟ هل اصطدتُما شيئًا؟

138
00:10:44,960 --> 00:10:46,630
.البعض

139
00:10:48,000 --> 00:10:50,090
.لا تركضي فجأة هكذا

140
00:10:51,220 --> 00:10:52,380
.آسفة

141
00:10:53,280 --> 00:10:54,510
هوشيزاكي-سان؟

142
00:10:54,890 --> 00:11:00,260
.عفوًا... آسفة على وقاحتي سابقًا

143
00:11:00,260 --> 00:11:02,770
.لا بأس

144
00:11:03,560 --> 00:11:06,060
.أودّ أن أجرّب الصيد أيضًا

145
00:11:06,060 --> 00:11:08,270
هل يمكنك أن تُعلّمني؟

146
00:11:08,990 --> 00:11:10,520
!بـ-بالطبع

147
00:11:10,520 --> 00:11:12,690
!تـ-تفضّلي من هنا

148
00:11:13,530 --> 00:11:16,320
.إنّه متوتر جدًا

149
00:11:16,320 --> 00:11:17,950
.علّمني أيضًا

150
00:11:19,320 --> 00:11:20,400
!هناك

151
00:11:25,540 --> 00:11:26,750
.شكرًا

152
00:11:26,750 --> 00:11:28,790
.لا مشكلة

153
00:11:28,790 --> 00:11:31,040
هل اصطدتما شيئًا؟

154
00:11:31,040 --> 00:11:31,800
!هناك

155
00:11:31,800 --> 00:11:35,470
حتّى الآن اصطدت واحدة
واصطاد غين-سان ثلاثًا

156
00:11:35,470 --> 00:11:38,550
.ماذا؟ كنت تتفاخر بمهاراتك في الصيد

157
00:11:38,550 --> 00:11:40,720
كيف تخسر؟

158
00:11:41,390 --> 00:11:42,560
...أنا

159
00:11:42,560 --> 00:11:43,640
.حمقاء

160
00:11:44,600 --> 00:11:46,690
.لقد كان يساعدني في الصيد

161
00:11:46,690 --> 00:11:47,810
ماذا؟

162
00:11:48,110 --> 00:11:52,440
لم يستطع كاي الصيد طبعًا
فقد كان منشغلًا بمساعدة مبتدئ مثلي

163
00:11:52,440 --> 00:11:57,190
كان بوسعه أن يصطاد بسهولة
.بمفرده لكنّه اختار مساعدتي

164
00:11:58,200 --> 00:12:01,370
.هذا ما حدث إذًا

165
00:12:01,370 --> 00:12:03,030
.آسفة يا أخي

166
00:12:03,030 --> 00:12:05,450
.لـ-لا داعي للاعتذار

167
00:12:06,040 --> 00:12:08,460
.أنا ممتن للدعم

168
00:12:08,840 --> 00:12:10,710
ماذا تقصد؟

169
00:12:10,710 --> 00:12:13,590
ماذا؟ ألم تكن...؟

170
00:12:14,840 --> 00:12:17,630
لم يكن ذلك عن قصد؟

171
00:12:20,510 --> 00:12:22,100
.أنت شخص طيّب حقًا

172
00:12:22,100 --> 00:12:23,140
ماذا؟

173
00:12:58,970 --> 00:13:00,880
!لذيذ

174
00:13:00,880 --> 00:13:04,140
من الممتع فعل شيء
.غير التخييم المنفرد أحيانًا

175
00:13:05,470 --> 00:13:07,560
.نعم، أحيانًا

176
00:13:08,980 --> 00:13:12,020
تذكرت. ماذا تطبخين للعشاء الليلة؟

177
00:13:12,020 --> 00:13:15,520
نحن نأكل الآن وأنت تسألين
عن وجبتنا التالية بالفعل؟

178
00:13:15,520 --> 00:13:19,860
لكن طبخ شيزوكو-تشان هو
.أبرز ما في أيّ رحلة تخييم

179
00:13:19,860 --> 00:13:22,030
ماذا؟ حقًا؟

180
00:13:24,160 --> 00:13:26,120
ما معنى هذه النظرة؟

181
00:13:26,120 --> 00:13:32,710
.أعلم أنّك تدرسين الطبخ لكنّني ما زلت قلقًا

182
00:13:32,710 --> 00:13:34,920
!لا يوجد ما يدعو للقلق

183
00:13:34,920 --> 00:13:37,420
!طبخ شيزوكو-تشان لذيذ

184
00:13:37,420 --> 00:13:40,920
ألم تأكل طعامها من قبل؟

185
00:13:40,920 --> 00:13:42,260
.إنّه لذيذ

186
00:13:43,180 --> 00:13:48,430
.لم أشاهدها تطبخ قبل أن أغادر البيت

187
00:13:48,430 --> 00:13:51,060
.عليك أن تتذوقه إذًا

188
00:13:51,060 --> 00:13:53,270
.سأذهب لبدء التحضير

189
00:13:53,730 --> 00:13:55,520
.سأساعدك يا شيزوكو-تشان

190
00:13:59,990 --> 00:14:04,570
.كنت قلقًا في البداية لكن لا داعي لذلك

191
00:14:04,570 --> 00:14:06,450
.الأمور بينهما جيّدة الآن

192
00:14:06,740 --> 00:14:09,830
.لنشعل نار المخيم

193
00:14:09,830 --> 00:14:11,410
.حسنًا

194
00:14:17,670 --> 00:14:19,250
هل سبق أن أشعلتَ نار مخيم يا كاي؟

195
00:14:19,250 --> 00:14:22,800
.في الواقع، لم أجرب إشعالها بمفردي من قبل

196
00:14:22,800 --> 00:14:25,510
.نعم، حامل حطبك يبدو جديدًا

197
00:14:26,680 --> 00:14:30,390
.كلّ ما أحضرته هذه المرة جديد

198
00:14:30,390 --> 00:14:34,060
.حسنًا، ساعدتني أثناء الصيد

199
00:14:34,520 --> 00:14:36,860
!سأساعدك إن احتجتَ لذا جرّب

200
00:14:36,860 --> 00:14:37,770
!حسنًا

201
00:14:38,190 --> 00:14:40,070
!سنبدأ بتقطيع الحطب

202
00:14:40,070 --> 00:14:41,280
!حسنًا

203
00:14:45,160 --> 00:14:49,030
لم أتصور أنّ إشعال نار
.المخيم يتطلب هذا الجهد

204
00:14:49,030 --> 00:14:51,540
.الأمر صعب على الجميع في البداية

205
00:14:51,540 --> 00:14:55,170
.واجهت شيزوكو صعوبة في إشعالها أيضًا

206
00:14:55,170 --> 00:14:56,790
.لكن انظر

207
00:14:58,340 --> 00:15:00,800
.أشعلتَ نارًا جيّدة

208
00:15:03,800 --> 00:15:06,840
.إنّها مستقرة الآن. هذا جيّد

209
00:15:06,840 --> 00:15:07,800
.شكرًا

210
00:15:09,510 --> 00:15:12,060
.أنا من أشعل هذه النار

211
00:15:12,560 --> 00:15:16,310
معرفة أنّني أشعلتُها بيديّ
.يشعرني بالرضا

212
00:15:17,210 --> 00:15:18,560
أليس كذلك؟

213
00:15:18,560 --> 00:15:21,780
.نعم والشعور بالحرارة مباشرة رائع

214
00:15:19,120 --> 00:15:22,070
.يبدوان متحمسان لسبب ما

215
00:15:21,780 --> 00:15:24,400
.بالضبط. هذا ما يجعلها مميزة

216
00:15:22,440 --> 00:15:26,820
.لكن يسرني أنّ أخي وغين-سان ينسجمان

217
00:15:25,240 --> 00:15:26,280
.شكرًا

218
00:15:27,490 --> 00:15:31,160
.كنتُ قلقة لكن لم يكن هناك داعٍ لذلك

219
00:15:31,160 --> 00:15:34,830
من أين أبدأ يا شيزوكو-تشان؟

220
00:15:36,160 --> 00:15:37,580
...لنرَ

221
00:15:37,960 --> 00:15:41,710
.غليت اللحم والخضار لذا سنقطّعها أولًا

222
00:15:41,710 --> 00:15:43,800
...ثم هناك كرات اللحم

223
00:15:48,350 --> 00:15:49,470
.حسنًا

224
00:15:49,890 --> 00:15:52,220
هل نأكل؟

225
00:15:53,010 --> 00:15:54,600
.أنا متحمسة

226
00:15:54,600 --> 00:15:58,270
سنترك القدر الساخن الذي ساعدتني
يوي-تشان في طبخه لوقت لاحق

227
00:15:59,350 --> 00:16:02,230
وجبتنا الأولى هي سلمون مرقط
!مطبوخ في ورق القصدير

228
00:16:02,230 --> 00:16:05,240
إذًا يا كاي؟ ما رأيك؟

229
00:16:07,360 --> 00:16:10,030
...شكله عادي ولكن

230
00:16:13,790 --> 00:16:15,710
!لذيذ

231
00:16:16,160 --> 00:16:21,670
إنّه ساخن، طري، وهذا المذاق المنعش
.الحلو والحامض لا يقاوم

232
00:16:21,670 --> 00:16:23,380
أهذا ميسو؟

233
00:16:23,380 --> 00:16:24,750
.صحيح

234
00:16:24,750 --> 00:16:27,510
إذًا يا أخي؟ لذيذ، صحيح؟

235
00:16:29,130 --> 00:16:30,970
.أعترف أنّه لذيذ

236
00:16:30,970 --> 00:16:33,890
.واضح أنّك كنتِ تدرسين

237
00:16:33,890 --> 00:16:36,770
.كانت طبّاخة بارعة حتّى قبل أن تبدأ المدرسة

238
00:16:36,770 --> 00:16:39,690
...ماذا؟ لكن في المنزل

239
00:16:39,690 --> 00:16:45,690
.كنتُ في سن العاشرة عندما غادرتَ المنزل

240
00:16:46,820 --> 00:16:51,070
كما أنّك أكلتَ طبخي مرّات
.عديدة عندما زرتَ المنزل

241
00:16:51,070 --> 00:16:51,950
!ماذا؟

242
00:16:52,740 --> 00:16:56,490
.حسبتُ أنّ طبخ أمّي تحسّن

243
00:16:56,490 --> 00:16:58,580
أكان ذلك طبخك؟

244
00:16:58,580 --> 00:17:02,580
لا أصدّق أنّك كنتَ تأكل دون
.أن تعرف من طبخ طعامك

245
00:17:02,580 --> 00:17:04,460
.آسف

246
00:17:05,460 --> 00:17:08,720
.أنتما إخوة حقًا

247
00:17:08,720 --> 00:17:12,340
.ولكنتكما تظهر عندما تتحدثان مع بعضكما

248
00:17:13,850 --> 00:17:16,260
.لا أصدق أنّك قلتَ هذا

249
00:17:17,520 --> 00:17:20,890
لا أستطيع التحكم بذلك
.عندما أتحدث مع العائلة

250
00:17:20,890 --> 00:17:22,350
.يا للإحراج

251
00:17:22,350 --> 00:17:24,400
حقًا؟

252
00:17:24,400 --> 00:17:27,400
.أشعر أنّها تتحدث بلكنة كثيرًا

253
00:17:27,730 --> 00:17:33,910
كما أنّ إجبار نفسي على التحدث باليابانية
الرسمية مع أخي يبدو غريبًا، صحيح؟

254
00:17:34,320 --> 00:17:36,120
...لن أقول غريبًا بل

255
00:17:36,660 --> 00:17:38,660
!مقرف

256
00:17:39,160 --> 00:17:41,660
من يهتم إن تكلّمت بلكنة؟

257
00:17:42,830 --> 00:17:45,670
لا تستطيع منع نفسها من الشعور
.بالإحراج على ما يبدو

258
00:17:46,040 --> 00:17:49,170
!هيّا، كلوا! سيبرد الطعام

259
00:17:49,170 --> 00:17:50,670
.حـ-حسنًا

260
00:17:49,170 --> 00:17:50,670
.حسنًا

261
00:17:57,680 --> 00:17:59,100
!لذيذ

262
00:17:59,100 --> 00:18:00,180
!شهي

263
00:18:01,600 --> 00:18:03,100
.أنا سعيدة

264
00:18:03,100 --> 00:18:06,440
هل ننتقل إلى القدر الساخن؟

265
00:18:08,650 --> 00:18:12,700
وصفة سرية لعائلة كوسانو، حساء
!خفيف مليء بكرات اللحم

266
00:18:15,410 --> 00:18:17,450
.هذا يشعرني بالحنين

267
00:18:17,450 --> 00:18:20,950
.لدي بونزو وفلفل يوزو لذا استخدموها كما تشاؤون

268
00:18:20,950 --> 00:18:24,580
.فهمت. نستخدمهما للغمس

269
00:18:24,580 --> 00:18:27,590
.تفضّلوا

270
00:18:34,090 --> 00:18:36,590
!لذيذ

271
00:18:36,590 --> 00:18:40,180
كرات اللحم غنية بالعصارة
والدجاج يذوب في فمي

272
00:18:40,180 --> 00:18:42,520
.والخضار امتصت الكثير من النكهة أيضًا

273
00:18:42,520 --> 00:18:44,730
.يسرني أنّه أعجبكم

274
00:18:45,020 --> 00:18:46,810
.هذه هي نكهة عائلة كوسانو

275
00:18:46,810 --> 00:18:48,900
.سأطبخها لك وقتما تشاء

276
00:18:49,650 --> 00:18:51,070
.شكرًا

277
00:18:52,070 --> 00:18:54,810
أم تفضّل أن تطبخ معي المرّة القادمة؟

278
00:18:56,000 --> 00:18:58,950
ليس صعبًا. اتفقنا؟

279
00:18:59,780 --> 00:19:02,870
...حسنًا، أودّ أن أعرف الوصفة

280
00:19:02,870 --> 00:19:05,670
.حسنًا. إنّه وعد

281
00:19:05,670 --> 00:19:07,000
.حسنًا، حسنًا

282
00:19:10,000 --> 00:19:12,760
.تبتسم بكل سعادة

283
00:19:13,340 --> 00:19:16,340
.لم أرها تظهر هذا التعبير من قبل

284
00:19:16,340 --> 00:19:19,260
.وكأنّهما مُتزوجان بالفعل

285
00:19:19,600 --> 00:19:22,140
وما زالا لا يتواعدان؟

286
00:19:24,060 --> 00:19:29,770
،لو نجحت علاقتهما وانتهت بالزواج

287
00:19:30,230 --> 00:19:32,400
...سيصبح غين-سان أخي الكبير

288
00:19:32,400 --> 00:19:33,780
.لا، مهلًا

289
00:19:34,650 --> 00:19:37,280
أخي الصغير بالزواج؟

290
00:19:37,280 --> 00:19:38,570
أخ أصغر؟

291
00:19:38,570 --> 00:19:40,830
.لا، الأكبر يبدو منطقيًا أكثر

292
00:19:44,920 --> 00:19:47,460
ما الذي أفكر فيه؟

293
00:19:47,460 --> 00:19:49,540
.هوشيزاكي-سان معجبة بغين-سان

294
00:19:50,000 --> 00:19:53,550
...في الواقع، الأمر معقّد ولكن

295
00:19:55,470 --> 00:19:57,220
.هـ-هذا لذيذ حقًا

296
00:19:59,090 --> 00:20:01,390
ما رأيك يا كوسانو-سينباي؟

297
00:20:01,390 --> 00:20:04,100
.أنا من أعددتُ كرات اللحم

298
00:20:04,100 --> 00:20:04,930
!ماذا؟

299
00:20:05,220 --> 00:20:09,350
طبخت هوشيزاكي-سان وصفة عائلتي؟

300
00:20:16,190 --> 00:20:17,950
.إنّها لذيذة حقًا

301
00:20:18,280 --> 00:20:19,740
حقًا؟

302
00:20:19,740 --> 00:20:22,830
نعم. معرفة أنّك من أعددتِها
...يجعلها أكثر

303
00:20:24,870 --> 00:20:27,710
آسف. كان كلامي منفرًا، صحيح؟

304
00:20:30,500 --> 00:20:33,210
.أظنّني أعددتُها بشكل جيّد

305
00:20:36,170 --> 00:20:38,930
.لا بأس به

306
00:20:38,930 --> 00:20:42,850
.المشكلة تكمن فيهما

307
00:20:48,350 --> 00:20:52,110
ألن تناما بعد؟
أستكونان بخير؟

308
00:20:52,110 --> 00:20:56,030
.نحن بخير. سأخبرك إن احتجنا شيئًا

309
00:20:56,610 --> 00:20:58,490
.سأظل مستيقظًا قليلًا أيضًا إذًا

310
00:20:58,490 --> 00:20:59,150
!لا

311
00:20:59,150 --> 00:21:00,110
ماذا؟

312
00:21:00,110 --> 00:21:02,070
.اذهبا إلى للنوم يا فتيان

313
00:21:02,070 --> 00:21:04,830
.لدى الفتيات أمور مهمة لمناقشتها

314
00:21:04,830 --> 00:21:08,120
.حسنًا. لا تدفعيني

315
00:21:08,120 --> 00:21:10,210
.ولا تجرؤا على التنصت

316
00:21:10,210 --> 00:21:11,920
.لن نفعل

317
00:21:11,920 --> 00:21:15,920
.تصبحون على خير

318
00:21:15,920 --> 00:21:17,340
.نعم، تصبحان على خير

319
00:21:17,340 --> 00:21:19,130
.تصبحان على خير

320
00:21:20,470 --> 00:21:22,140
.حسنًا

321
00:21:22,140 --> 00:21:25,350
.لديّ ما أريد إخبارك به يا شيزوكو-تشان

322
00:21:25,350 --> 00:21:27,430
.ماذا؟ حسنًا

323
00:21:28,100 --> 00:21:30,890
كيف لم تبدآ المواعدة بعد؟

324
00:21:30,890 --> 00:21:31,960
ماذا؟

325
00:21:32,400 --> 00:21:36,770
قلتُ أنّني لم أعُد أهتم لكن أكان
ضروريًا أن تتغازلا أمامي؟

326
00:21:36,770 --> 00:21:38,900
.لم نكن نتغازل

327
00:21:38,900 --> 00:21:44,610
على أيّ حال، عجز غين-تشان عن
،اتخاذ الخطوة الأخيرة مشكلة

328
00:21:45,030 --> 00:21:47,040
.لكنّك أيضًا مذنبة لقبولك بذلك

329
00:21:47,950 --> 00:21:51,490
.عليك أن تصلحي موقفكِ أيضًا

330
00:23:28,010 --> 00:23:33,500
هل صرتُ جديرة بلقب
مُخيّمة منفردة يا غين-سان؟

331
00:23:34,850 --> 00:23:37,980
"الحلقة 24: "نحن مخيّمان منفردان معًا