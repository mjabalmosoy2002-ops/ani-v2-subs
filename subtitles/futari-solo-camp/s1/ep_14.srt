1
00:00:09,430 --> 00:00:10,610
!لذيذ

2
00:00:13,220 --> 00:00:15,580
،اعتدتُ على التخييم المنفرد الثنائي

3
00:00:15,580 --> 00:00:19,000
.لكنّني أحتاج إلى أيام كهذه أيضًا

4
00:01:56,180 --> 00:01:58,140
سيّارة إذًا؟

5
00:01:58,140 --> 00:02:01,740
لستُ مهتمًا بإحضار الكثير
،من المعدّات الإضافية

6
00:02:02,140 --> 00:02:04,610
.لكنّها ستوسّع نطاق خياراتي

7
00:02:04,610 --> 00:02:05,900
.هذا مُهم

8
00:02:06,420 --> 00:02:11,150
إن أردتُ توسيع نطاق خياراتي
...دون تغيير أسلوبي، فالحل أن أقتني

9
00:02:12,210 --> 00:02:13,410
.درّاجة نارية

10
00:02:16,520 --> 00:02:18,450
.أو ربّما دراجة هوائية

11
00:02:18,970 --> 00:02:23,460
ليست فكرة سيئة لكنّني لا أتصور
.نفسي أقود واحدة

12
00:02:23,870 --> 00:02:28,460
على كلّ حال، أريد أن أجعل مخيّمي مريحًا

13
00:02:28,460 --> 00:02:31,840
.للتخييم على الرّاجلين

14
00:02:31,840 --> 00:02:37,160
إن كنتُ سأنشئ واحدًا، فالأجدر
.أن أجعله مكانًا أرغب بزيارته بنفسي

15
00:02:41,880 --> 00:02:44,730
،حتّى لو وجدتُ أرضًا جيّدة

16
00:02:44,730 --> 00:02:48,180
.فلا بدّ أن تستوفي جملة من الشروط

17
00:02:51,680 --> 00:02:53,820
.تطلّب هذا جهدًا معتبرًا

18
00:02:54,430 --> 00:02:58,990
وصفة شيزوكو لباقة من
.لفائف لحم البطن

19
00:02:59,370 --> 00:03:04,370
لكن هل مذاق خبز مشوي ملفوف
بلحم البطن بتلك اللذة؟

20
00:03:08,960 --> 00:03:10,630
!لذيذ

21
00:03:10,630 --> 00:03:11,870
.فهمت الآن

22
00:03:11,870 --> 00:03:16,010
يمتصّ الخبز دهن اللحم
.ويعزز النكهة

23
00:03:16,010 --> 00:03:17,980
ماذا عن هذه؟

24
00:03:18,970 --> 00:03:20,400
.جبن

25
00:03:21,390 --> 00:03:22,560
.بصل أخضر

26
00:03:27,620 --> 00:03:30,150
.لا بأس بي

27
00:03:32,770 --> 00:03:36,030
سأضطر للتحلّي بالصبر
.في بحثي عن أرض

28
00:03:36,500 --> 00:03:39,590
لكن هناك أمرًا آخر مهمًا
.لأخذه بعين الاعتبار

29
00:03:39,960 --> 00:03:41,280
...وهو

30
00:03:41,990 --> 00:03:43,640
.فكرة المشروع

31
00:03:43,640 --> 00:03:45,670
ما نوع المُخيّم الذي
أريد إنشاءه؟

32
00:03:45,670 --> 00:03:49,370
.مُخيّم مخصص للمُخيّمين المنفردين

33
00:03:49,370 --> 00:03:51,290
.كانت هذه فكرة مخيّمي المثالي

34
00:03:52,300 --> 00:03:55,490
.لكنّني لم أعد متأكدًا الآن

35
00:03:56,030 --> 00:03:58,380
،كنتُ أظنّ أنّ إرضاء أهل الخبرة يكفي

36
00:03:58,380 --> 00:04:01,390
.لكن لقائي بشيزوكو ذكّرني بشيء

37
00:04:02,360 --> 00:04:05,560
.كلّ إنسان بدأ هاويًا

38
00:04:06,480 --> 00:04:08,770
.حتّى أنا

39
00:04:09,960 --> 00:04:11,680
.كينوكورا-كن

40
00:04:13,070 --> 00:04:14,220
ما الأمر؟

41
00:04:14,590 --> 00:04:17,630
.كنّا نتحدث عن الخروج معًا

42
00:04:17,630 --> 00:04:20,840
تعرفين طباعه. لن يكون في
.صحبته أيّ متعة

43
00:04:20,840 --> 00:04:22,780
.إنّه متجهم دائمًا

44
00:04:23,800 --> 00:04:25,790
متجهم إذًا؟

45
00:04:26,250 --> 00:04:28,660
.بدا لي أنّه كان يبتسم

46
00:04:31,630 --> 00:04:35,300
.كنتُ متحمسًا مثل بقية زملائي في الفصل

47
00:04:36,000 --> 00:04:38,060
.تبدأ عطلة الأسبوع الذهبي غدًا

48
00:04:38,740 --> 00:04:41,550
.حزمتُ حقيبتي حتّى امتلأت

49
00:04:42,210 --> 00:04:45,530
أتذكر أنّني لم أستطع
.النّوم تلك الليلة

50
00:04:50,480 --> 00:04:53,360
كانت حقيبتي الثقيلة مريحة
.بغرابة على غير العادة

51
00:04:53,710 --> 00:04:55,500
.كانت خطواتي خفيفة

52
00:04:55,500 --> 00:04:59,860
.لم يقوَ فمي على كتمان سروري

53
00:05:00,120 --> 00:05:03,370
.منحتُك استثناءً اليوم كما وعدتُ

54
00:05:03,370 --> 00:05:05,340
.سأكون في مبنى الإدارة

55
00:05:05,340 --> 00:05:07,040
.تعالي إليّ إن احتجت أيّ شيء

56
00:05:07,040 --> 00:05:09,870
.حسنًا. شكرًا

57
00:05:11,190 --> 00:05:14,550
.سأكون بخير. فأنا معتاد على التخييم

58
00:05:15,360 --> 00:05:17,950
.حسنًا، لا سبب يدعوني للشكوى

59
00:05:18,600 --> 00:05:24,260
احتفالًا ببدء المدرسة الثانوية
.نلتُ إذنًا خاصًا للتخييم ليلًا

60
00:05:24,580 --> 00:05:28,640
.كان ذلك اليوم هو أوّل
.تجربة لي في التخييم المنفرد

61
00:05:30,050 --> 00:05:32,000
.شعرتُ بالثقة

62
00:05:32,520 --> 00:05:35,110
،ذهبتُ مرارًا للتخييم النهائي بمفردي

63
00:05:35,110 --> 00:05:39,890
والأهم أنّني كنتُ أستند
.إلى دروس والدي

64
00:05:40,590 --> 00:05:42,490
،أتيتُ مستعدًا

65
00:05:42,870 --> 00:05:47,100
.لكن كان هناك أمرًا لم أكُن أعلمه بعد

66
00:05:52,660 --> 00:05:54,170
!لذيذ

67
00:05:54,170 --> 00:05:57,490
.المعكرونة الفورية سهلة التحضير ولذيذة

68
00:05:57,490 --> 00:06:00,800
لكن يجدر بي تعلّم الطبخ
لئلا تظلّ مأكولاتي فاترة المذاق

69
00:06:01,130 --> 00:06:05,930
سأضيف الأرز والجبن إلى
الحساء المتبقّي

70
00:06:06,250 --> 00:06:08,430
.وأخلطهما معًا

71
00:06:08,780 --> 00:06:11,450
.المعكرونة وحدها لا تكفي

72
00:06:15,700 --> 00:06:17,820
.كاد يصبح جاهزًا

73
00:06:22,660 --> 00:06:23,820
.أبي

74
00:06:24,200 --> 00:06:28,160
أتظنُّ أنّ بوسعي أن أسمّي
.نفسي مخيّمًا منفردًا الآن؟

75
00:06:30,830 --> 00:06:33,240
.لا يوجد أحد آخر هنا

76
00:06:33,240 --> 00:06:35,580
.تبدأ الآن تجربتي الحقيقية في التخييم المنفرد

77
00:06:35,580 --> 00:06:37,080
.هذا رائع

78
00:06:37,390 --> 00:06:39,900
ماذا؟ هل تعطّل؟

79
00:06:39,900 --> 00:06:43,780
.كان هناك شيء لم أختبره بعد

80
00:06:44,280 --> 00:06:49,100
شيء لم يكن ممكنًا مع أبي
.أو أثناء التخييم النهاري

81
00:06:50,670 --> 00:06:54,420
.الوحدة في الظلام

82
00:06:55,560 --> 00:07:00,200
.يُسمَع صوت كلّ شيء بشكل عالي في الظلمة

83
00:07:01,250 --> 00:07:02,610
ما هذا الصوت؟

84
00:07:04,370 --> 00:07:06,020
ما هذا الصوت؟

85
00:07:07,880 --> 00:07:11,600
ر-ربّما سأخلد للنوم بما أنّني
.انتهيتُ من أكل الطّعام

86
00:07:11,600 --> 00:07:13,850
.ليس وكأنّني خائف

87
00:07:17,250 --> 00:07:21,370
لـ-لن أنسى البطاريات الاحتياطية
.في المرّة القادمة

88
00:07:22,130 --> 00:07:25,760
.ونار مخيّم. سأشعل نار مخيّم

89
00:07:27,760 --> 00:07:31,700
،بالتفكير في الأمر الآن
.ذلك ما جعلني مولعًا بنيران المخيم

90
00:07:32,630 --> 00:07:33,960
.الوحدة

91
00:07:33,960 --> 00:07:39,400
إنّها أعظم متعة وأكبر عقبة
.في التخييم المنفرد

92
00:07:39,960 --> 00:07:42,780
.نريد تجربته لكنّنا نشعر بالخوف قليلًا

93
00:07:43,400 --> 00:07:45,910
...أريد المساهمة في إزالة تلك العقبة

94
00:07:47,650 --> 00:07:49,980
.بمخيّمي الخاص

95
00:07:50,410 --> 00:07:53,630
.قد يكون ذلك مثيرًا للاهتمام

96
00:07:54,450 --> 00:07:57,040
مساعدة الآخرين إذًا؟

97
00:07:57,040 --> 00:08:00,680
ربّما عليّ الاستماع إلى
.مزيد من آراء الآخرين

98
00:08:00,680 --> 00:08:04,240
ما زلتُ أشعر بالحرج من
.سؤال شيزوكو رغم ذلك

99
00:08:09,950 --> 00:08:11,290
.عذرًا

100
00:08:12,530 --> 00:08:14,950
هل لي بدقيقة؟

101
00:08:16,650 --> 00:08:17,850
كيف أساعدك؟

102
00:08:17,850 --> 00:08:21,820
هل تكتفي اليوم بتخييم نهائي
أم أنّك ستبيت ليلة أخرى؟

103
00:08:21,820 --> 00:08:23,360
.سأبيت

104
00:08:23,360 --> 00:08:26,860
.رائع. أنا أنوي المبيت أيضًا في الحقيقة

105
00:08:26,860 --> 00:08:28,110
ماذا؟

106
00:08:28,110 --> 00:08:31,810
مع ذلك، أفكّر في زيارة
.عدّة مخيّمات

107
00:08:31,810 --> 00:08:35,240
.أنا مخيّمة بالدراجة وأحبّ التجوّل

108
00:08:35,240 --> 00:08:38,620
،بالتفكير في الأمر
.لمحتُها على عجل بالأمس

109
00:08:38,620 --> 00:08:43,530
على أيّ حال، شربتُ كثيرًا
.البارحة وغلبني النعاس

110
00:08:43,530 --> 00:08:47,660
لديّ حطب زائد لذا خطر
.ببالي أنّك قد ترغب به

111
00:08:47,660 --> 00:08:51,130
.بكل تأكيد. أشكرك

112
00:08:51,530 --> 00:08:56,140
جميل. يصعب حمل حطب
.إضافي على الدراجة

113
00:08:56,140 --> 00:09:00,060
.أنا أخيّم سيرًا لذا أفهمك

114
00:09:00,060 --> 00:09:01,690
سيرًا؟

115
00:09:03,850 --> 00:09:06,690
.حسنًا، سأحضر الحطب

116
00:09:06,690 --> 00:09:09,120
وبعدها ربّما أستطيع
.طرح بعض الأسئلة عليك

117
00:09:09,120 --> 00:09:11,200
.نعم، لا بأس

118
00:09:12,290 --> 00:09:13,550
أسئلة؟

119
00:09:15,690 --> 00:09:18,230
.شيء من هذا القبيل

120
00:09:19,160 --> 00:09:20,460
.فهمت

121
00:09:20,740 --> 00:09:22,600
.كان هذا مفيدًا

122
00:09:22,600 --> 00:09:26,560
خيّمتُ من قبل لكنّني لم أبدأ في
.إحضار درّاجتي إلّا مؤخرًا

123
00:09:26,560 --> 00:09:28,710
.الأمر مختلف كثيرًا عمّا توقعت

124
00:09:28,710 --> 00:09:31,460
لطالما أردتُ الحديث مع
.شخص يفهم الأمر

125
00:09:32,160 --> 00:09:37,470
مع ذلك، أنا لا أملك درّاجة لذا
.لستُ متأكدًا إن كان حديثي سيجدي نفعًا

126
00:09:37,470 --> 00:09:39,000
.لا بأس

127
00:09:39,000 --> 00:09:43,270
أصبحت لديّ فكرة أوضح
.الآن عن كيفية اختيار العتاد

128
00:09:43,270 --> 00:09:47,750
بحثتُ عن شتّى النصائح لكنّني
.أردتُ سماع رأي شخص مباشرة

129
00:09:47,750 --> 00:09:53,030
فأنا لا أعرف أحدًا يخيّم
.بالدراجة أو يخيّم أصلًا

130
00:09:53,030 --> 00:09:57,770
أهذا يعني أنّك مُخيّمة منفردة؟

131
00:09:57,770 --> 00:09:59,470
ماذا؟ أتسألني هذا الآن؟

132
00:10:00,180 --> 00:10:02,950
.كنتُ أخيّم بمفردي منذ زمن

133
00:10:02,950 --> 00:10:05,130
.أنا مخيّمة منفردة أصيلة حتّى النخاع

134
00:10:07,160 --> 00:10:10,040
.تبدو كمُخيِّم منفرد أيضًا

135
00:10:10,040 --> 00:10:11,320
هل تُخيّم بمفردك كثيرًا؟

136
00:10:12,380 --> 00:10:14,670
...أنا أيضًا مُخيِّم أصيل حـ

137
00:10:14,670 --> 00:10:16,530
!غين-سان

138
00:10:17,470 --> 00:10:19,890
.مُخيِّم منفرد أيضًا

139
00:10:20,560 --> 00:10:22,400
هل ترددتَ للتو؟

140
00:10:22,400 --> 00:10:23,390
!لا

141
00:10:23,390 --> 00:10:25,860
.التخييم المنفرد لشخصين يظل تخييمًا منفردًا

142
00:10:25,860 --> 00:10:27,770
.أنا لا أكذب

143
00:10:27,770 --> 00:10:29,900
.حسنًا، لا يهم

144
00:10:29,900 --> 00:10:33,030
.حسنًا، يُستحسن أن أستعد للذهاب

145
00:10:33,030 --> 00:10:34,780
.إلى اللقاء

146
00:10:35,370 --> 00:10:37,350
.آمل أن نلتقي مجددًا في مكان ما

147
00:10:37,780 --> 00:10:40,290
.نعم، بالتأكيد

148
00:10:42,160 --> 00:10:44,190
.كان رجلًا مثيرًا للاهتمام

149
00:10:44,190 --> 00:10:46,170
.يا لها من فتاةٍ غريبة

150
00:10:48,610 --> 00:10:51,300
!من كانت تلك المرأة؟

151
00:10:51,300 --> 00:10:53,920
هل يـ-يخون؟

152
00:10:53,920 --> 00:10:57,450
!يخونني

153
00:11:12,180 --> 00:11:15,450
.صباح الخير يا غين-سان

154
00:11:15,850 --> 00:11:18,950
مـ-من كانت تلك المرأة؟

155
00:11:19,830 --> 00:11:23,220
امرأة؟ تقصدين تلك؟

156
00:11:23,220 --> 00:11:28,240
،أعطتني بقايا حطبها
.وأعطيتُها بعض النصائح

157
00:11:28,240 --> 00:11:29,410
حقًا؟

158
00:11:29,410 --> 00:11:30,460
.نعم

159
00:11:31,870 --> 00:11:33,340
!لا بأس

160
00:11:33,340 --> 00:11:35,210
.سأذهب إذًا لنصب خيمتي

161
00:11:35,210 --> 00:11:36,350
.حسنًا

162
00:11:37,490 --> 00:11:39,850
لِم هي غاضبة؟

163
00:11:41,140 --> 00:11:44,790
من الطبيعي التفاعل
.مع بقية المُخيّمين

164
00:11:44,790 --> 00:11:49,070
مع ذلك، بين هذا وبين شأن
.كانا-سان، لا يسعني سوى القلق

165
00:11:49,880 --> 00:11:53,110
لا تعلم شيزوكو بعد أنّ
.كانا عادت إلى أمريكا

166
00:11:58,290 --> 00:12:00,050
.لا تُخيفيني هكذا

167
00:12:00,050 --> 00:12:02,700
لِم تواصلين الظهور خلفي اليوم؟

168
00:12:06,040 --> 00:12:08,090
!سأشعل نار مُخيّم اليوم أيضًا

169
00:12:08,090 --> 00:12:09,620
حـ-حقًا؟

170
00:12:09,620 --> 00:12:13,520
،بما أنَّ هذا الحطب أُعطِي لك
فلا تُمانع إن استخدمتُه، صحيح؟

171
00:12:13,520 --> 00:12:15,640
.براحتك

172
00:12:17,680 --> 00:12:21,400
.سأستهلك كلّ حطب تلك المرأة

173
00:12:21,890 --> 00:12:23,390
مهلًا، ماذا؟

174
00:12:23,390 --> 00:12:25,390
هل نسيتُ مُشعِل النّار؟

175
00:12:25,790 --> 00:12:27,770
.سيئ

176
00:12:28,350 --> 00:12:30,590
أنا لديّ. أتريدين استخدامه؟

177
00:12:31,650 --> 00:12:33,280
ألا بأس؟

178
00:12:33,280 --> 00:12:34,210
.نعم

179
00:12:34,650 --> 00:12:37,270
.خذي. استخدمي قدر ما تريدين

180
00:12:37,740 --> 00:12:39,970
.شكرًا

181
00:12:39,970 --> 00:12:42,530
مهلًا، ماذا ستستخدم اليوم؟

182
00:12:45,600 --> 00:12:48,950
سأجرّب استخدام مكبس
.إشعال النّار هذا

183
00:12:49,410 --> 00:12:51,800
مكبس... إشعال نار؟

184
00:12:51,800 --> 00:12:54,920
.صحيح. يُعرف أيضًا باسم محقنة النّار

185
00:12:54,920 --> 00:12:57,920
أهذه أداة لإشعال النّار أيضًا؟

186
00:12:58,500 --> 00:13:03,380
عندما يُضغط الهواء سريعًا في
حجرة مغلقة، ترتفع حرارته

187
00:13:03,380 --> 00:13:06,430
.فيُسخّن القداحة ويُشعلها

188
00:13:06,430 --> 00:13:11,440
كأيّ أداةٍ لإشعال النّار، هناك
.حيلة لتشغيل هذه الأدوات

189
00:13:12,030 --> 00:13:14,440
.لنجرّبها الآن

190
00:13:16,060 --> 00:13:16,880
ماذا؟

191
00:13:16,880 --> 00:13:19,440
.يبدو أنّك مستمتع

192
00:13:19,440 --> 00:13:21,460
!اصمتي

193
00:13:21,460 --> 00:13:24,570
.من المُحمّس استخدام شيء ما لأول مرّة

194
00:13:26,730 --> 00:13:30,960
.لا سيّما شيئًا لم تلمسه من قبل

195
00:13:32,960 --> 00:13:37,960
،قال أحدهم يومًا
"الأولاد يظلون أولادًا"

196
00:13:38,620 --> 00:13:42,340
لكن حتّى غين-سان يتصرف
.كصبي صغير أحيانًا

197
00:13:42,790 --> 00:13:47,120
ربّما لا ينبغي أن أقول هذا عن
...رجل يكبرني بأكثر من عقد ولكن

198
00:13:47,860 --> 00:13:49,660
.هذا ظريف نوعًا ما

199
00:13:49,660 --> 00:13:50,870
!ماذا؟

200
00:13:52,720 --> 00:13:54,050
.تجاهلها

201
00:13:54,050 --> 00:13:56,230
.شد حيلك وركّز على مكبس النار

202
00:13:56,600 --> 00:13:59,530
.ضع الوقيد في طرف المكبس

203
00:13:59,900 --> 00:14:03,240
...أمسك الأسطوانة

204
00:14:03,240 --> 00:14:05,370
!واضغط بقوة

205
00:14:10,310 --> 00:14:13,000
.لم يشتعل

206
00:14:18,630 --> 00:14:20,310
.لا يشتعل

207
00:14:20,310 --> 00:14:22,290
.هذا صعب

208
00:14:22,660 --> 00:14:24,720
.قد لا يكون محكم الإغلاق

209
00:14:24,720 --> 00:14:26,420
محكم؟

210
00:14:26,420 --> 00:14:31,850
.لا يعمل أحيانًا إن تسرّب الهواء للداخل

211
00:14:33,290 --> 00:14:35,890
هل ترين الحلقة في الطرف؟

212
00:14:35,890 --> 00:14:38,900
،عادة ما تبقيه محكمًا

213
00:14:38,900 --> 00:14:42,590
.لكن الهواء قد يتسرّب لأسباب شتّى

214
00:14:42,590 --> 00:14:45,490
،عندما يحدث ذلك
.تحتاج لمادة لزجة

215
00:14:45,490 --> 00:14:49,180
.أحضرتُ الفازلين لكنّ أيّ شيء يصلح

216
00:14:49,180 --> 00:14:51,430
.الشحم يفي بالغرض

217
00:14:51,430 --> 00:14:54,030
.نفركه على السطح كلّه هكذا

218
00:14:54,680 --> 00:14:56,960
.حسنًا، يمكننا المحاولة مجددًا الآن

219
00:14:56,960 --> 00:14:57,790
.حسنًا

220
00:14:58,540 --> 00:14:59,340
!هيّا

221
00:14:59,340 --> 00:15:00,920
هل اشتعل؟

222
00:15:03,500 --> 00:15:06,090
!ا-اشتعل هذه المرّة

223
00:15:07,430 --> 00:15:09,100
.هكذا تفعلها

224
00:15:09,100 --> 00:15:11,100
...كم تبدو متباهيًا

225
00:15:11,100 --> 00:15:13,240
.استوعبت الأمر

226
00:15:13,620 --> 00:15:15,940
.أستطيع نقل هذه لنيراني الآن

227
00:15:15,940 --> 00:15:19,610
لا يكفي هذا لإشعال الحطب
.لذا سأقوم ببعض التحضيرات أولًا

228
00:15:19,610 --> 00:15:22,650
هل تسمح بإلقاء نظرة
على مكبسك المُشعل؟

229
00:15:23,830 --> 00:15:26,160
هل تريدين أن تُجربي إذًا؟

230
00:15:26,160 --> 00:15:29,740
.اتضح أنّ بصحبته فتاة

231
00:15:29,740 --> 00:15:34,000
.آه، بدا شخصًا حسنًا

232
00:15:34,000 --> 00:15:35,500
.حسنًا، لا يهم

233
00:15:41,000 --> 00:15:42,500
والآن

234
00:15:42,500 --> 00:15:44,490
.حان وقت اللمسات الأخيرة

235
00:15:49,310 --> 00:15:52,470
!مقبّل وفير من الناتشوز المكسيكي

236
00:15:53,740 --> 00:15:57,640
.لا تُسقطه من رقاقة التورتيلا

237
00:16:03,480 --> 00:16:06,900
!لذيذ

238
00:16:07,200 --> 00:16:10,180
.أحضرتُ الغواكامولي أيضًا. تذوق منه

239
00:16:10,180 --> 00:16:11,280
غواكامولي؟

240
00:16:11,280 --> 00:16:14,250
.إنّها صلصة غمس مصنوعة من الأفوكادو

241
00:16:18,850 --> 00:16:21,420
!لذيذ

242
00:16:21,420 --> 00:16:24,150
.الغواكامولي لذيذ أيضًا

243
00:16:24,150 --> 00:16:27,360
أليس كذلك؟ كانت النتيجة رائعة

244
00:16:27,360 --> 00:16:31,700
يمكنك أكل هذه كوجبة خفيفة
.ريثما أشرع في إعداد الطبق الرئيسي

245
00:16:32,820 --> 00:16:34,180
.أنا متحمس له

246
00:16:37,180 --> 00:16:39,050
.لنصفّ هذه

247
00:16:40,960 --> 00:16:43,190
لِم كلّ هذا؟

248
00:16:43,190 --> 00:16:46,530
...بعد الناتشوز، موضوع الليلة هو

249
00:16:46,650 --> 00:16:50,660
!حفلة تاكو مكسيكية في الهواء الطلق

250
00:16:50,660 --> 00:16:52,360
!سنقيم حفلة تاكو

251
00:16:53,300 --> 00:16:56,840
تاكو؟ تقصدين تلك اللفائف المطوية؟

252
00:16:56,840 --> 00:17:00,120
كلّ طعام يصير تاكو
!إن قُدِّم في خبز تورتيلا

253
00:17:00,120 --> 00:17:02,380
.خذ تورتيلا محمّصة قليلًا

254
00:17:03,020 --> 00:17:05,250
.أضف أيّ مكوّنات تحبّها

255
00:17:07,370 --> 00:17:10,380
...وأخيرًا، ضع قليلًا من التوابل

256
00:17:10,670 --> 00:17:12,750
!وهكذا يكتمل التاكو

257
00:17:18,060 --> 00:17:19,770
!لذيذ وحار

258
00:17:19,770 --> 00:17:23,560
.مستوى التوابل مناسب جدًا

259
00:17:23,560 --> 00:17:26,150
مناسب؟ حقًا؟

260
00:17:26,150 --> 00:17:29,550
.أظنني رأيت شيئًا جنونيًا قبل قليل

261
00:17:29,550 --> 00:17:31,470
هل تقصد هذا؟

262
00:17:32,320 --> 00:17:34,030
!مـ-موت؟

263
00:17:35,140 --> 00:17:39,790
أحبّ الحارّ لذا دائمًا
.ما أستخدم أشياء كهذه

264
00:17:39,790 --> 00:17:43,040
،إن لم تستطِع تحمّل الحار
.فلديّ صلصة تاباسكو عادية أيضًا

265
00:17:43,040 --> 00:17:45,160
،إن لم تستطِع تحمّل الحار"
".فلديّ صلصة تاباسكو عادية أيضًا

266
00:17:49,370 --> 00:17:54,490
أكان هذا كثيرًا على طفل
لا يقوى على الحار؟

267
00:17:54,490 --> 00:17:56,380
!ظريف جدًا

268
00:17:54,760 --> 00:17:57,560
.لا حاجة لتجبر نفسك

269
00:17:58,810 --> 00:18:00,330
!لا تستخفي بي

270
00:18:05,790 --> 00:18:06,830
!حار جدًا

271
00:18:06,830 --> 00:18:08,470
.لا، لذيذ

272
00:18:09,860 --> 00:18:12,860
!لا، إنّه حار

273
00:18:17,060 --> 00:18:18,960
ماذا أفعل؟

274
00:18:18,960 --> 00:18:22,300
!شدّتني معاناة غين-سان

275
00:18:27,360 --> 00:18:29,250
.كان ذلك فظيعًا

276
00:18:29,250 --> 00:18:32,050
.ما كان عليّ التهور

277
00:18:32,500 --> 00:18:35,260
لكنّني استطعتُ الاستمتاع ببضع
.ليالٍ من التخييم المنفرد الحقيقي

278
00:18:35,570 --> 00:18:39,130
.كانت تلك رحلة تخييم أخرى رائعة

279
00:18:42,950 --> 00:18:45,640
.أظنني سأغادر أيضًا

280
00:18:45,640 --> 00:18:49,340
علي أيّ حال، يبدو أنَّ غين-سان
.لا يحبّ طعامه حارًا جدًا

281
00:18:49,340 --> 00:18:51,280
.يجدر بي تقليل الحار في المستقبل

282
00:18:51,280 --> 00:18:54,020
.هذا ليس كلّ ما عليّ التفكّر فيه

283
00:18:54,020 --> 00:18:59,540
مجرّد رؤية غين-سان يتحدث مع
.امرأة أخرى أشعلت غضبي

284
00:18:59,540 --> 00:19:01,550
.هذا ليس جيدًا

285
00:19:01,550 --> 00:19:05,850
لستُ متسلّطة لتلك الدرجة، صحيح؟

286
00:19:05,850 --> 00:19:08,320
.ليس وكأنّهما سيلتقيان مجددًا

287
00:19:08,320 --> 00:19:10,240
.لا ينبغي أن أقلق بشأن ذلك كثيرًا

288
00:19:11,790 --> 00:19:13,800
.مرحبًا! يا لها من مصادفة

289
00:19:13,800 --> 00:19:16,070
.أنت الفتاة من أمس

290
00:19:16,070 --> 00:19:17,300
.أهلًا

291
00:19:17,300 --> 00:19:18,840
هل أنت مغادرة أيضًا؟

292
00:19:18,840 --> 00:19:22,120
.نعم. أستقبل القطار من هنا

293
00:19:22,120 --> 00:19:24,850
ماذا؟ أين خليلتك؟

294
00:19:24,850 --> 00:19:26,060
أليست رفقتك؟

295
00:19:26,060 --> 00:19:27,660
!خليلتي؟

296
00:19:27,660 --> 00:19:30,410
.نعم. انضمت إليك بعد حديثنا

297
00:19:30,410 --> 00:19:31,980
لِم أنت متفاجئ جدًا؟

298
00:19:33,190 --> 00:19:35,070
...في الواقع، إنّها

299
00:19:35,070 --> 00:19:37,920
...ليست خليلتي... بعد

300
00:19:38,970 --> 00:19:40,450
.فهمت

301
00:19:42,580 --> 00:19:44,660
أيّ قطار ستستقل؟
هل نسلك نفس الطريق؟

302
00:19:44,660 --> 00:19:47,200
.لديّ بعض الأسئلة الأخرى

303
00:19:47,200 --> 00:19:48,830
نعم، ما الأمر؟

304
00:19:50,190 --> 00:19:54,050
كنت أتساءل كيف هي معدات
.تلك الشركة في الواقع

305
00:19:54,050 --> 00:19:56,560
...يستخدمها صديقي و

306
00:19:56,560 --> 00:19:58,930
...فهمت، إنّها إذًا

307
00:19:58,930 --> 00:20:01,050
.قرأتُ عن ذلك في مقال

308
00:20:01,050 --> 00:20:04,210
!أمسَكَت زمام الموقف

309
00:20:04,210 --> 00:20:07,270
هل أنا شخص سهل الانقياد؟

310
00:20:07,270 --> 00:20:10,280
.لا، مهلًا. هذه عينة قيّمة

311
00:20:10,280 --> 00:20:14,190
أشك أنّني سأراها مجددًا
.لذا يجدر بي أن أسمع رأيها أيضًا

312
00:20:17,910 --> 00:20:19,440
ماذا؟ ما هذا السؤال فجأة؟

313
00:20:19,440 --> 00:20:21,570
.أتساءل فقط

314
00:20:22,330 --> 00:20:28,340
حسنًا، أنا أحب الجبال لكن
يصعب حمل المعدات على الدراجة

315
00:20:28,340 --> 00:20:31,060
.لذا أفضّل مكانًا ليس مرتفعًا جدًا

316
00:20:31,060 --> 00:20:34,180
،قرب الأسواق مريح

317
00:20:34,180 --> 00:20:37,840
لكنّني لا أحبّ التخييم
.قرب المناطق السكنية

318
00:20:37,840 --> 00:20:40,680
كما لا يمكنك حمل الكثير
من المعدات على الدراجة

319
00:20:40,680 --> 00:20:46,350
لذا أشعر بأمان أكبر عندما تكون
.مواقع التخييم محدّدة وواضحة

320
00:20:46,640 --> 00:20:51,920
والزوايا الخفية تمنحك عزلة
جميلة لكنّ كثرتها مخيفة

321
00:20:51,920 --> 00:20:54,920
.وكذلك الأماكن التي تبدو مهجورة جدًا

322
00:20:54,920 --> 00:20:57,790
يعجبني أن يكون المشرف قادرًا
.على مراقبة الضيوف

323
00:20:57,790 --> 00:21:01,890
.أشعر بطمأنينة أكبر حين يكون حضوره دائمًا

324
00:21:02,420 --> 00:21:06,070
أعتقد أنّ النساء لديهن ما يقلقن بشأنه
.أكثر عند التخييم بمفردهن

325
00:21:06,490 --> 00:21:09,130
.حسنًا، ما باليد حيلة

326
00:21:09,130 --> 00:21:12,960
الأمر محزن لكن ليس كلّ شخص
.في العالم إنسانًا طيبًا

327
00:21:12,960 --> 00:21:18,260
لذا إن كنت ستُنشئ مُخيّمك الخاص
.فسيسرني لو أخذت كلامي في الحسبان

328
00:21:18,260 --> 00:21:19,000
.نعم

329
00:21:20,760 --> 00:21:23,690
.مهلًا، هذا ليس سبب سؤالي

330
00:21:23,690 --> 00:21:26,260
هل أنت متأكد حيال هذا؟

331
00:21:28,520 --> 00:21:30,440
.حسنًا، سأذهب من هنا

332
00:21:30,440 --> 00:21:33,150
.نعم. شكرًا على المعلومات

333
00:21:33,560 --> 00:21:36,650
تذكرت. هلّا تخبرني باسمك؟

334
00:21:37,240 --> 00:21:39,420
.كينوكورا غين

335
00:21:39,420 --> 00:21:40,400
.حسنًا

336
00:21:40,400 --> 00:21:43,130
.إلى اللقاء يا غين-تشان

337
00:21:43,130 --> 00:21:44,910
!غين-تشان

338
00:21:46,280 --> 00:21:48,860
.اسمي هوشيزاكي يوي

339
00:21:48,860 --> 00:21:50,970
.أحسّ أنّنا سنتقابل مجددًا

340
00:21:51,480 --> 00:21:54,180
.غالبًا ما يصدق حدسي

341
00:23:26,930 --> 00:23:31,280
.بدأتُ ممارسة التخييم بعد لقائي بغين

342
00:23:32,060 --> 00:23:34,760
.أتساءل إن كان مُخيّمًا اليوم أيضًا