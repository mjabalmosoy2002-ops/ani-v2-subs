1
00:00:06,800 --> 00:00:10,630
أتفهم أنّ العلاقات قد
تمنح راحة أو متعة

2
00:00:10,630 --> 00:00:14,750
بينما لا تزالين تفكّرين إن
،كنتِ تريدين المواعدة

3
00:00:15,530 --> 00:00:19,020
لكنّك لا تريدين أن يستمر
ذلك للأبد، صحيح؟

4
00:00:19,910 --> 00:00:20,920
.لا

5
00:00:21,250 --> 00:00:22,880
!عليك أن تتصرفي إذًا

6
00:00:24,880 --> 00:00:28,010
هل تستمتعين بهذا يا يوي-تشان؟

7
00:00:28,010 --> 00:00:34,490
لعلمك، كثير من الرجال ذوي
.الهوايات لا يمانعون البقاء عُزّابًا

8
00:00:35,910 --> 00:00:38,190
!أعلم ذلك

9
00:00:38,190 --> 00:00:40,470
!لهذا أنا قلقة حيال الأمر

10
00:00:42,460 --> 00:00:44,200
ما الذي يدعو للقلق؟

11
00:00:44,200 --> 00:00:46,130
.أنتما تتفاهمان جيدًا

12
00:00:47,570 --> 00:00:54,750
.أنا رفقته فقط ليعلّمني كيف أخيّم

13
00:00:55,310 --> 00:01:01,520
ماذا؟ لكن ألم يعترف غين-تشان أنّك
صرتِ خبيرة في التخييم؟

14
00:01:01,520 --> 00:01:02,600
.نعم

15
00:01:03,650 --> 00:01:10,630
،إن كان يواصل قضاء الوقت معك
.فلا بدّ أنّه يريد التخييم معك

16
00:01:12,630 --> 00:01:18,620
بدأنا التخييم المنفرد معًا
.لأنّني أجبرته على ذلك

17
00:01:20,030 --> 00:01:24,370
.أ-أمّا الآن فهو يسمح لي بالبقاء بجانبه

18
00:01:25,030 --> 00:01:28,890
.وأصبح الأمر عاديًا

19
00:01:29,990 --> 00:01:31,260
...لكن

20
00:01:31,570 --> 00:01:32,780
لكن؟

21
00:01:35,080 --> 00:01:37,720
.يحبّ غين-سان التخييم المنفرد

22
00:01:38,270 --> 00:01:41,790
.لا أظنّ أنّ ذلك تغيّر أبدًا

23
00:01:43,760 --> 00:01:45,710
.لا أمانع ذلك

24
00:01:46,130 --> 00:01:48,990
.لا أريد أن أعيقه

25
00:01:49,930 --> 00:01:55,720
أعلم أنّه يستمتع بالتخييم معي
.بشكل منفصل عن ذلك

26
00:01:56,200 --> 00:01:58,830
.نذهبُ معًا لكنّنا نخيّم منفصلين

27
00:01:59,310 --> 00:02:04,620
التعريف الدقيق ليس واضحًا بشكل
.جيّد لكن ذلك سهل ومريح

28
00:02:05,290 --> 00:02:09,110
.هذا هو أسلوبنا في التخييم

29
00:02:09,960 --> 00:02:16,980
أظنُّ أنّ علاقتنا تنجح
.لأنّها غامضة بنفس الأسلوب

30
00:02:17,820 --> 00:02:23,020
.أخشى أن تنهار إن حاولنا الاقتراب أكثر

31
00:02:25,600 --> 00:02:30,380
أخشى أن يعود غين-سان إلى حبّ
التخييم المنفرد فقط إن اقتربنا كثيرًا

32
00:02:30,380 --> 00:02:33,320
.ويبتعد عنّي

33
00:02:35,150 --> 00:02:37,730
.اسمعي يا شيزوكو-تشان

34
00:02:38,760 --> 00:02:40,740
.هذا ثقيل، ثقيل جدًا

35
00:02:40,740 --> 00:02:41,910
!ماذا؟

36
00:02:42,250 --> 00:02:44,280
.تفكيرك مثقل جدًا

37
00:02:44,280 --> 00:02:46,350
.عليك أن تنظري للحبّ بقلب أخف

38
00:02:46,350 --> 00:02:48,330
.ماذا؟ ليس ثقيلًا

39
00:02:48,330 --> 00:02:51,100
.أنا أفكّر بالموضوع بجدية فقط

40
00:02:51,100 --> 00:02:53,820
.أعلم أنّك جادّة بالطبع

41
00:02:54,300 --> 00:02:59,300
.لكنّكِ قضيت وقتًا طويلًا مع غين-تشان

42
00:02:59,570 --> 00:03:01,620
.ذهبتُما إلى أماكن كثيرة معًا

43
00:03:01,620 --> 00:03:06,630
أكلتما طعامًا لذيذًا وضحكتُما معًا، صحيح؟

44
00:03:08,180 --> 00:03:12,300
إن لم ينجح الأمر بعد كلّ ذلك
.فليس مُقدّرًا أن ينجح

45
00:03:12,580 --> 00:03:18,550
هذا يعني أنّ غين-تشان لا يصلح لذلك
.ولن يكوّن علاقة مع أحد

46
00:03:20,250 --> 00:03:23,810
.الأفضل إذًا أن أُبقي الأمور كما هي

47
00:03:24,110 --> 00:03:29,360
.جديًا؟ ستظلين عالقة في هذه الحالة للأبد

48
00:03:29,360 --> 00:03:31,460
...نعم ولكن

49
00:03:31,460 --> 00:03:34,620
.أظنّ أنّ بوسعك الوثوق بنفسك أكثر

50
00:03:34,620 --> 00:03:40,320
.وأعتقد أنّ بوسعك الثقة بغين-تشان أكثر أيضًا

51
00:03:42,980 --> 00:03:46,470
.ليس الأمر أنّني لا أثق به

52
00:03:46,470 --> 00:03:51,630
ما في الأمر أنّي لستُ واثقة
.أنّ غين-سان سيختارني

53
00:03:51,630 --> 00:03:55,590
.أنتِ تبالغين في تقديره

54
00:03:55,990 --> 00:04:01,550
أنت الفتاة الوحيدة التي يقبل
.غين-تشان أن يُخيّم معها منفردًا

55
00:04:02,780 --> 00:04:06,450
...أعلم ولكن

56
00:04:07,790 --> 00:04:11,740
.لا بدّ أنَّك تُحبّين غين-تشان كثيرًا

57
00:04:11,740 --> 00:04:12,840
.نعم

58
00:04:14,180 --> 00:04:19,630
ألا يجدرُ بكِ إذًا أن تقتربي خطوة؟

59
00:04:20,160 --> 00:04:24,490
.هكذا، لن تخمد علاقتكما

60
00:04:26,530 --> 00:04:27,780
...خطوة

61
00:04:29,780 --> 00:04:33,760
إلى متى تتصورين استمرار هذا الوضع؟

62
00:04:33,760 --> 00:04:35,550
...ماذا؟ حسنًا

63
00:04:37,050 --> 00:04:40,020
حتّى يبادر بالاقتراب منك؟

64
00:04:40,020 --> 00:04:43,560
أم حتّى يبتعد عنك؟

65
00:04:44,050 --> 00:04:48,690
ألا تظنين أنّك ستندمين
إن تركتِ الأمر كلّه له؟

66
00:04:53,390 --> 00:04:54,660
أندم؟

67
00:04:55,940 --> 00:05:02,710
،بالتفكير في الأمر الآن
.لم أخبر غين-سان قط بمشاعري

68
00:05:04,920 --> 00:05:07,930
.حسنًا، فكّري في الأمر

69
00:05:08,470 --> 00:05:11,110
.لستُ مسؤولة عن شيء هنا

70
00:05:11,110 --> 00:05:13,080
!ماذا؟

71
00:05:21,410 --> 00:05:24,270
.إلى اللقاء

72
00:05:24,270 --> 00:05:27,280
.شكرًا على كلّ شيء

73
00:05:27,280 --> 00:05:28,490
.نعم

74
00:05:28,490 --> 00:05:30,110
.إلى اللقاء يا شيزوكو

75
00:05:30,110 --> 00:05:31,520
.حسنًا

76
00:05:31,930 --> 00:05:33,570
.بالتوفيق

77
00:05:33,570 --> 00:05:35,500
!يوي-تشان

78
00:05:37,470 --> 00:05:40,140
.هيّا يا كوسانو-سينباي. لنذهب

79
00:05:40,140 --> 00:05:41,510
.حسنًا

80
00:05:46,030 --> 00:05:49,360
.غادرا مبكرًا

81
00:05:49,360 --> 00:05:53,040
.صـ-صحيح. يبدو أنّ لديهما غرضًا ما

82
00:05:57,010 --> 00:05:58,420
.سأذهب لأكل الفطور

83
00:06:00,400 --> 00:06:02,780
.سأعدّ شيئًا

84
00:06:02,780 --> 00:06:04,300
متأكدة؟

85
00:06:04,750 --> 00:06:08,590
أحضرتُ ما يكفي أربعة
لذا يسعنا أكل فطور فاخر

86
00:06:08,590 --> 00:06:09,930
هل لديك متسع لذلك؟

87
00:06:10,520 --> 00:06:12,050
.بكل تأكيد

88
00:06:12,050 --> 00:06:13,230
أتحتاجين أيّ مساعدة؟

89
00:06:13,230 --> 00:06:16,770
.لا. يمكنك الاسترخاء فقط يا غين-سان

90
00:06:16,770 --> 00:06:19,380
.حقًا؟ شكرًا

91
00:06:26,290 --> 00:06:31,180
سننصرف لنتركما وحدكما
.لذا استغلّي الفرصة

92
00:06:31,180 --> 00:06:33,430
ماذا؟

93
00:06:33,970 --> 00:06:37,200
.آمل أن تنجح الأمور لشيزوكو-تشان

94
00:06:37,200 --> 00:06:38,600
.صحيح

95
00:06:43,530 --> 00:06:46,540
أعلينا أن نجرّب التخييم المنفرد الثنائي أيضًا؟

96
00:06:46,920 --> 00:06:48,310
!ماذا؟

97
00:06:57,460 --> 00:06:58,440
.هذا لذيذ

98
00:07:01,350 --> 00:07:03,600
ماذا؟ هل حدث شيء ما؟

99
00:07:03,600 --> 00:07:05,100
!لـ-لا

100
00:07:05,100 --> 00:07:08,990
.رأيتُ شخصًا يبيع هذه من شاحنة

101
00:07:08,990 --> 00:07:12,050
.بدت مشبعة لذا أعددتُ بعضها

102
00:07:12,050 --> 00:07:15,010
تبحثين بعدّة أمور إذًا؟

103
00:07:15,010 --> 00:07:19,350
مثلما تقضي وقت فراغك في
.البحث عن معدات التخييم

104
00:07:19,350 --> 00:07:22,500
يتقن النّاس ما يحبونه إذًا؟

105
00:07:22,500 --> 00:07:24,610
.نـ-نعم

106
00:07:36,830 --> 00:07:39,330
!لا أستطيع  قول شيء

107
00:07:39,620 --> 00:07:43,820
حـ-حتّى أنّنا أنهينا التنظيف
.دون أن أقول شيئًا

108
00:07:45,430 --> 00:07:47,190
.آسفة يا يوي-تشان

109
00:07:47,190 --> 00:07:51,650
.ما زلتُ بحاجة إلى وقت لأستعد

110
00:07:53,390 --> 00:07:56,170
.لكنّني سأفعلها يومًا ما

111
00:07:56,640 --> 00:07:58,710
.حدث الكثير مجددًا هذه المرّة

112
00:07:59,010 --> 00:08:00,450
.أنا منهك

113
00:08:02,230 --> 00:08:05,360
.أعتذر لإرهاقك هكذا

114
00:08:05,360 --> 00:08:07,860
.لا عليك

115
00:08:08,260 --> 00:08:10,360
...لكن لعلمك

116
00:08:11,060 --> 00:08:13,470
.أنا أفضّل التخييم معك بمفردك

117
00:08:17,730 --> 00:08:19,250
.أحبّك

118
00:08:24,020 --> 00:08:27,810
!لـ-لا أصدق أنّني قلتُها

119
00:08:26,390 --> 00:08:28,880
ماذا؟ ما الأمر؟

120
00:08:29,250 --> 00:08:31,970
.لأنّ غين-سان قال ذلك

121
00:08:31,970 --> 00:08:33,980
.خرجت بلا قصد

122
00:08:36,850 --> 00:08:37,850
...غين-سان

123
00:08:37,850 --> 00:08:39,240
نـ-نعم؟

124
00:08:43,960 --> 00:08:46,900
.أنا أحبّك يا غين-سان

125
00:08:47,780 --> 00:08:53,530
كنتُ مسرورة جدًا بالاستمتاع بالتخييم
.المنفرد الثنائي طيلة السنة الماضية

126
00:08:54,120 --> 00:08:57,410
،قيل لي أنّ علاقتنا غير واضحة

127
00:08:57,410 --> 00:09:02,290
.لكنّني لم أمانع ما دمنا نستمر هكذا

128
00:09:02,780 --> 00:09:08,150
لكنّني في النهاية أغار حين
.أفكّر أنّك قد تُسلَب منّي

129
00:09:08,150 --> 00:09:16,420
.لا أجد جوابًا حين يسأل النّاس عن علاقتنا

130
00:09:16,860 --> 00:09:19,500
.لا أمانع ذلك بالضرورة

131
00:09:19,500 --> 00:09:25,540
لكنّه جعلني أتساءل
.كم ستدوم هذه العلاقة

132
00:09:25,870 --> 00:09:30,260
.ربّما ستنتهي يومًا ما

133
00:09:31,100 --> 00:09:34,480
.لكنّني أدركتُ شيئًا بعد حديثي مع يوي-تشان

134
00:09:34,480 --> 00:09:40,580
لم أستطع تطوير علاقتنا
...رغم شعوري بعدم الارتياح

135
00:09:42,100 --> 00:09:47,080
.لأنّني مدللة بعلاقتنا الحالية غير الواضحة

136
00:09:47,670 --> 00:09:51,960
.لذا فكّرتُ أنّ عليّ إخبارك بمشاعري

137
00:09:53,570 --> 00:09:55,880
.آسفة. أعلم أنّ هذا مفاجئ

138
00:09:55,880 --> 00:09:57,790
...في الواقع، أنا

139
00:10:06,850 --> 00:10:09,800
...إن كنتَ تشاركني نفس المشاعر

140
00:10:10,320 --> 00:10:13,820
،إن لم تمانع تطوير علاقتنا

141
00:10:17,230 --> 00:10:19,360
،وعندما تفعل

142
00:10:20,760 --> 00:10:23,110
.اجعلني خليلتك رجاء

143
00:10:41,410 --> 00:10:44,800
.أنا كوسانو شيزوكو، 21 سنة

144
00:10:46,820 --> 00:10:48,380
.التخييم هوايتي

145
00:10:48,380 --> 00:10:50,680
.ما زلتُ أتعلّم كيف أخيّم بمفردي

146
00:11:01,700 --> 00:11:03,520
.هذا مكان جميل

147
00:11:09,160 --> 00:11:11,330
.لكن هذا لا يقل جمالًا عنه

148
00:12:28,810 --> 00:12:30,760
.إنّه الصباح

149
00:12:31,530 --> 00:12:33,830
.لم أنم كثيرًا

150
00:12:36,060 --> 00:12:37,820
.أظنني سآكلُ الفطور

151
00:12:48,070 --> 00:12:49,640
!لذيذ

152
00:12:50,680 --> 00:12:54,390
ألم أجبره على الأكل ذلك الصباح؟

153
00:12:56,170 --> 00:12:59,460
.لكن بدا أنّ غين-سان استمتع به

154
00:13:01,110 --> 00:13:03,900
.مرّ أكثر من عام منذ ذلك الحين

155
00:13:04,330 --> 00:13:06,460
.انقضى الوقت سريعًا

156
00:13:07,430 --> 00:13:13,120
عندما قلتُ أنّني أريد الاستمتاع بالمناظر
.اصطحبني غين-سان إلى شتّى الأماكن

157
00:13:14,120 --> 00:13:18,440
.لم أكُن أعرف شيئًا وقد علّمني الكثير

158
00:13:19,600 --> 00:13:23,450
استمتعتُ بالطبخ واستطعتُ
.الأكل مع غين-سان

159
00:13:28,390 --> 00:13:33,960
تسرّعتُ حين أردتُ التخييم
ولم أستطع فعل شيء

160
00:13:35,110 --> 00:13:39,800
لكن شيئًا فشيئًا، تعلّمتُ
.الكثير تحت إرشاده

161
00:13:41,780 --> 00:13:46,460
.أستطيع أن أخيّم بمفردي الآن يا غين-سان

162
00:13:48,210 --> 00:13:52,100
...لكن لأنّه كان دائمًا معي

163
00:13:54,070 --> 00:13:57,270
،لأنّ وجوده بجانبي صار طبيعيًا

164
00:13:57,910 --> 00:14:01,560
.فإنّ غيابه الآن يشعرني بوحدة شديدة

165
00:14:09,140 --> 00:14:10,210
.غين-سان

166
00:14:13,950 --> 00:14:15,090
.غين-سان

167
00:14:16,150 --> 00:14:18,810
أين أنت الآن؟

168
00:14:20,270 --> 00:14:23,250
.وقعتُ في النهر في ذلك اليوم

169
00:14:23,250 --> 00:14:25,570
.شعرتُ بالعجز في الظلام

170
00:14:26,300 --> 00:14:30,930
بعدها وجدتُ مخيّم غين-سان
.بضوئه الساطع وناره الدافئة

171
00:14:30,930 --> 00:14:33,890
.أعتقد أنّني حاولتُ لتهور تبديل ملابسي

172
00:14:35,700 --> 00:14:38,350
...بعدها عاد غين-سان و

173
00:14:45,460 --> 00:14:46,840
...شيزو

174
00:14:58,190 --> 00:14:59,840
!تأخرتَ كثيرًا

175
00:15:01,630 --> 00:15:02,880
هل انتظرتِ طويلًا؟

176
00:15:24,610 --> 00:15:26,830
.آسف لأنّني جعلتكِ تقولينها أولًا

177
00:15:27,710 --> 00:15:30,620
.أنا أحبّك أيضًا

178
00:15:33,090 --> 00:15:35,370
.دعيني أقولها أيضًا

179
00:15:38,760 --> 00:15:41,980
.أريدكِ أن تكوني خليلتي

180
00:15:45,700 --> 00:15:46,980
.حسنًا

181
00:15:50,320 --> 00:15:52,440
.أتطلع لذلك

182
00:17:31,860 --> 00:17:35,260
عند الاستمتاع بأغانيك المفضّلة

183
00:17:35,740 --> 00:17:39,260
أو عند اختيار موسيقى
،تناسب أجواء التخييم

184
00:17:39,840 --> 00:17:44,170
تدخل الأصوات العذبة إلى
.أذنيك مع أصوات الطبيعة

185
00:17:44,960 --> 00:17:47,150
.انسجام بين الطبيعة والموسيقى

186
00:17:47,150 --> 00:17:51,020
.هذا أسلوب آخر للاستمتاع بالتخييم

187
00:17:52,020 --> 00:17:54,960
.من المهم أن تراعي من حولك طبعًا

188
00:17:54,960 --> 00:17:58,020
.تذكّر أنّ البعض قد يودّون الاستمتاع بالصمت

189
00:17:58,020 --> 00:18:01,590
.كما تودّ أنتَ الاستمتاع بالموسيقى

190
00:18:02,430 --> 00:18:05,200
.استمتع بالأصوات في نطاقك الشخصي

191
00:18:05,200 --> 00:18:08,690
هذه هي الطريقة الصحيحة للاستمتاع
.بالموسيقى أثناء التخييم

192
00:18:13,100 --> 00:18:15,610
.يفترض أن لدي عطلة اليوم

193
00:18:15,610 --> 00:18:20,540
حسنًا، لقد وافقتُ أن أردّ على
.الرسائل بأسرع وقت ممكن

194
00:18:20,910 --> 00:18:23,550
تأجيل موعد التأجيل"؟"

195
00:18:24,030 --> 00:18:26,930
.ماذا؟ هذا ليس ما اتفقنا عليه

196
00:18:29,420 --> 00:18:33,570
لا، كفى. أشعر أنّني سأكتب
.شيئًا لا ينبغي أن أكتبه

197
00:18:33,570 --> 00:18:34,970
.عليّ أن أصفّي ذهني

198
00:18:34,970 --> 00:18:38,270
...أريد أن أرتب أفكاري لذا أولًا

199
00:18:40,710 --> 00:18:42,270
.سأذهب في نزهة

200
00:18:45,650 --> 00:18:50,660
في هذه الأيام، صارت الشركات أكثر
تقبّلًا لفكرة العمل عن بُعد

201
00:18:50,660 --> 00:18:53,100
،وأشكال العمل التي لا تقيّد الموظف بالمكتب

202
00:18:53,100 --> 00:18:55,810
.بدأ النّاس يعملون من أماكن متنوعة

203
00:18:56,670 --> 00:19:02,130
رغم أنّ ذلك ليس السبب الوحيد إلّا
أنّ كثيرًا من المخيمات تقدم خدمة واي فاي مجانية

204
00:19:02,530 --> 00:19:06,940
.وبعض المخيمات توفر حتّى مساحات عمل مشتركة

205
00:19:12,190 --> 00:19:13,260
.نعم

206
00:19:13,740 --> 00:19:15,740
.سينجح كلّ شيء بطريقة ما

207
00:19:16,690 --> 00:19:20,480
.يفتح التخييم ذهني أكثر لسبب ما

208
00:19:22,890 --> 00:19:25,690
.لا عليك. هذا يحدث

209
00:19:26,220 --> 00:19:29,520
.نعم. نعم. مع السلامة

210
00:19:34,000 --> 00:19:37,530
.حسنًا، أستطيع أن أخيّم بجدية الآن

211
00:19:45,570 --> 00:19:49,630
حسبتُ أنّ هذا المكان مخصص للتخييم الفاخر

212
00:19:49,630 --> 00:19:52,120
.لكنّ لديهم مواقع تخييم عادية أيضًا

213
00:19:53,590 --> 00:19:56,730
.مرحبًا يا جارنا. آمل ألّا نكون مصدر إزعاج

214
00:19:57,510 --> 00:19:59,900
.لا إطلاقًا

215
00:20:01,070 --> 00:20:02,890
هل هُما مرتبطان؟

216
00:20:04,660 --> 00:20:06,660
ما-ما الأمر؟

217
00:20:06,660 --> 00:20:09,200
.جسده رائع حقًا

218
00:20:09,550 --> 00:20:11,110
!هوشيزاكي-سان؟

219
00:20:11,110 --> 00:20:14,330
.هيّا. لنذهب للتسجيل

220
00:20:14,330 --> 00:20:15,950
لِم ترتبك هكذا؟

221
00:20:15,950 --> 00:20:17,670
.أنا أمزح فقط

222
00:20:18,360 --> 00:20:20,510
ليسا مرتبطين إذًا؟

223
00:20:23,420 --> 00:20:24,800
.يبدو رائعًا

224
00:20:25,250 --> 00:20:28,280
.أعتذر لأنّني احتجتُ لمساعدتك في النهاية

225
00:20:28,280 --> 00:20:30,030
ماذا تقول؟

226
00:20:30,030 --> 00:20:32,310
.سنستخدمه سويًا. لذا سأساعد طبعًا

227
00:20:33,440 --> 00:20:35,670
.موقد النار هذا جديد أيضًا

228
00:20:35,670 --> 00:20:37,560
.أنت متحمس لهذا جدًا

229
00:20:37,560 --> 00:20:40,580
!بالطبع! نحن وحدنا معًا هذه المرّة

230
00:20:40,580 --> 00:20:44,770
إن كان لنا مستقبل فهو
.يعتمد على استمتاعها هذه المرّة

231
00:20:47,250 --> 00:20:49,350
.أنت تتقد حماسًا

232
00:21:05,310 --> 00:21:08,080
.يبدو الحساء جاهزًا. اجلسي

233
00:21:08,080 --> 00:21:09,220
.حسنًا

234
00:21:12,220 --> 00:21:14,440
!حساء طماطم ساخن

235
00:21:14,440 --> 00:21:16,360
!يبدو شهيًا

236
00:21:18,760 --> 00:21:21,590
!شهي

237
00:21:36,060 --> 00:21:37,120
.خذي

238
00:21:37,120 --> 00:21:38,500
.شكرًا

239
00:21:45,000 --> 00:21:46,860
!شهي

240
00:21:47,410 --> 00:21:49,020
.هذا لذيذ جدًا

241
00:21:49,020 --> 00:21:50,020
صحيح؟

242
00:21:50,400 --> 00:21:52,920
.كلّ شيء جيّد حتّى الآن

243
00:21:53,280 --> 00:21:56,590
.لا تتسرع. لا تتسرع بعد

244
00:22:00,070 --> 00:22:01,750
!أخبار رائعة! علينا أن نحتفل

245
00:22:01,750 --> 00:22:02,690
ماذا؟

246
00:22:03,330 --> 00:22:05,440
!مرحى

247
00:22:05,820 --> 00:22:08,440
.نخب مستقبل غين وشيزوكو-تشان

248
00:22:08,700 --> 00:22:10,800
!بصحتكم

249
00:22:20,770 --> 00:22:22,700
!هل خيّمتِ بمفردك؟

250
00:22:23,120 --> 00:22:25,730
أتقصدين أنّك نمتِ هنا ليلة أمس؟

251
00:22:25,730 --> 00:22:27,210
.نعم

252
00:22:27,500 --> 00:22:31,220
،حتّى لو لم تأتِ
أردتُ تجربة التخييم منفردة

253
00:22:31,220 --> 00:22:34,470
.وأخطو خطوة للأمام كمُخيِّمة

254
00:22:35,350 --> 00:22:40,230
أردتُ أن أقف بفخر إلى
.جانبك كمُخيّمة منفردة

255
00:22:42,630 --> 00:22:45,640
.لكنّني أدركتُ شيئًا بعد أن فعلتُ ذلك

256
00:22:45,640 --> 00:22:49,490
.أفضّل أن أخيّم معك

257
00:22:52,170 --> 00:22:56,670
هذا لأنّك لا تعرفين بعد
.كيف تستمتعين بالتخييم المنفرد

258
00:22:56,670 --> 00:23:01,330
.ماذا؟ لا داعي لتقولها بحدّة

259
00:23:01,330 --> 00:23:02,570
هل تصغين؟

260
00:23:02,570 --> 00:23:04,750
...التخييم المنفرد هو

261
00:23:06,800 --> 00:23:07,950
ماذا؟

262
00:23:08,580 --> 00:23:12,260
.تبقى كما أنت رغم أنّك أصبحتَ خليلي الآن

263
00:23:13,960 --> 00:23:15,750
.ما باليد حيلة

264
00:23:18,550 --> 00:23:21,770
.أنا مخيّم منفرد أصيل

265
00:23:22,320 --> 00:23:23,560
...وأيضًا

266
00:23:24,980 --> 00:23:26,960
.أنا مخيّم منفرد ثنائي

267
00:23:27,350 --> 00:23:28,410
.نعم