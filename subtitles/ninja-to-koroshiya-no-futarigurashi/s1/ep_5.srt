1
00:00:06,770 --> 00:00:09,350
.صباح الخير

2
00:00:13,120 --> 00:00:15,870
.حان وقت الاستيقاظ يا كونوها-سان

3
00:00:19,630 --> 00:00:22,160
.صباح الخير يا ساتوكو-تشان

4
00:00:22,160 --> 00:00:24,240
.صباح الخير

5
00:00:31,340 --> 00:00:33,260
لماذا يداك باردتان؟

6
00:00:33,260 --> 00:00:35,640
!هذه ليست المشكلة هنا

7
00:00:39,010 --> 00:00:40,260
قبل بضعة ساعات

8
00:00:48,730 --> 00:00:51,470
أهذه قمامة تركوها خلفهم؟

9
00:00:54,810 --> 00:00:55,910
ما هذا؟

10
00:01:00,670 --> 00:01:04,310
!كونوها-سان

11
00:01:09,410 --> 00:01:10,640
!انظري

12
00:01:10,910 --> 00:01:11,950
...كما هو متوقّع

13
00:01:11,950 --> 00:01:13,980
!روبوتي مثاليّة

14
00:01:13,980 --> 00:01:16,030
!ما كانت تلك الرّوبوت؟

15
00:01:16,380 --> 00:01:18,580
.أعتقد أنّ ما باليد حيلة

16
00:01:22,550 --> 00:01:24,190
!سأقوم بالشّرح

17
00:01:28,310 --> 00:01:32,290
روبوكو هي روبوت مُعدّة بالذّكاء
.الاصطناعيّ وهي مبنيّة عنك

18
00:01:32,290 --> 00:01:33,260
.هكذا إذًا

19
00:01:33,260 --> 00:01:37,490
.إنّها مصمّمة للقيام بالمهام المنزليّة مثلك

20
00:01:37,490 --> 00:01:38,440
.عجبًا

21
00:01:39,070 --> 00:01:39,760
...وأيضًا

22
00:01:39,760 --> 00:01:44,460
كانت تتعلّم مؤخّرًا وظائف جديدة
.من تلقاء نفسها لا أعرف عنها حتّى

23
00:01:44,990 --> 00:01:45,710
ماذا؟

24
00:01:46,150 --> 00:01:47,830
مهلاً، كونوها-سان؟

25
00:01:47,830 --> 00:01:49,830
!إنّها تأكل وكأنّ كلّ شيء بخير

26
00:01:49,830 --> 00:01:52,990
.يبدو أنّها غير قادرة على القدوم لمساعدتك

27
00:01:52,990 --> 00:01:55,150
ماذا؟ لماذا لا يمكنها إدراك الوضع؟

28
00:01:55,150 --> 00:01:56,840
!هذا غريب

29
00:02:06,520 --> 00:02:07,940
ما الخطب؟

30
00:02:07,940 --> 00:02:08,930
...أشعر أنّ

31
00:02:09,270 --> 00:02:12,450
.حساء الميسو هذا ليس جيّدًا كالمعتاد

32
00:02:14,300 --> 00:02:18,450
أشعر أنّ التّذمّر من شيء لم
.تُعدّيه أصلاً يُعدّ وقاحة

33
00:02:18,450 --> 00:02:19,700
.اعتقد أنّك محقّة

34
00:02:19,700 --> 00:02:21,340
!سمحت للرّوبوت بمجادلتها

35
00:02:21,340 --> 00:02:22,690
...إذًا عليّ الرّدّ هكذا

36
00:02:24,320 --> 00:02:27,340
!بهذا، ما عادت القاتلة نظّارات مشكلة

37
00:02:27,340 --> 00:02:32,090
!والآن، ستعملين من أجلي أيّتها المرأة النّينجا

38
00:02:32,090 --> 00:02:36,830
بالمناسبة، ما الّذي تنوين فعله
باختطافي وليس قتلي؟

39
00:02:39,430 --> 00:02:42,390
...أنا مثل نظّارات كما كانت في السّابق

40
00:02:52,690 --> 00:02:54,590
.أترك خلفي الكثير من الأدلّة

41
00:02:54,590 --> 00:02:57,190
.ولذلك السّبب انخفض ترتيبي

42
00:03:04,830 --> 00:03:06,070
.نحن متشابهتان

43
00:03:10,830 --> 00:03:13,710
.لذلك السّبب واصلتُ مراقبة منافستني سرًّا

44
00:03:13,710 --> 00:03:17,600
،لكن بالنّسبة لها
.واصلت الصّعود في التّرتيب

45
00:03:17,600 --> 00:03:21,230
.ذكرت مراجعاتها أنّها لاتترك أيّ أثر

46
00:03:24,460 --> 00:03:28,370
.قرّرتُ أن أتبعها بعد أن جذب ذلك انتباهي

47
00:03:32,340 --> 00:03:37,860
.وحينها استنتجت أنّها كانت تتعاون وتعمل معك

48
00:03:47,940 --> 00:03:51,630
إنّك تملكين مهارة تسمح لك
بالتّخلّص من أيّ دليل، صحيح؟

49
00:03:51,630 --> 00:03:52,620
.أظنّ ذلك

50
00:03:52,620 --> 00:03:55,630
.أستطيع تحويل الأشياء إلى أوراق شجر

51
00:03:55,870 --> 00:03:56,870
!ماذا؟ هذا مذهل

52
00:03:56,870 --> 00:03:58,610
!تستعملين السّحر؟

53
00:03:58,610 --> 00:04:00,370
.إنّه نينجتسو

54
00:03:59,650 --> 00:04:01,390
!هذا رائع

55
00:04:01,390 --> 00:04:04,760
هذا صحيح. لا تستطيع الرّوبوتات
.استعمال مهارات النّينجا

56
00:04:04,760 --> 00:04:06,710
لذلك... حتّى كونوها-سان ستلاحظ ذلك

57
00:04:06,710 --> 00:04:10,440
.عندما ستعملان معًا وستدرك أنّها مزيّفة

58
00:04:10,440 --> 00:04:12,510
.أنت مزيّفة

59
00:04:13,640 --> 00:04:15,610
!سأعتمد عليك في هذا يا كونوها-سان

60
00:04:15,610 --> 00:04:17,350
أيمكنك إعادة هذا الكرسيّ كما كان؟

61
00:04:17,700 --> 00:04:21,120
...أسرعي رجاءً ولاحظي أنّ الرّوبوت ليست أنا

62
00:04:23,730 --> 00:04:24,990
هل تستطيعين؟

63
00:04:24,990 --> 00:04:27,190
.لدينا عمل بعد هذا

64
00:04:27,190 --> 00:04:28,720
ماذا نفعل في العشاء؟

65
00:04:28,720 --> 00:04:30,880
هل ستعدّينه أم نأكل في الخارج؟

66
00:04:32,190 --> 00:04:33,120
...سأكون

67
00:04:33,330 --> 00:04:37,120
.بخير ما دام هنالك مقبس

68
00:04:37,120 --> 00:04:38,640
.إنّك ابنة هذا الجيل بالفعل

69
00:04:38,640 --> 00:04:40,890
.يبدو أنّهما متّجهان للعمل

70
00:04:40,890 --> 00:04:43,170
.علينا التّوجّه للعمل أيضًا

71
00:04:43,170 --> 00:04:46,010
.لذلك أريني ماذا لديك أيّتها الكونويتشي

72
00:04:46,880 --> 00:04:48,990
ما الّذي يقلقك؟

73
00:04:48,990 --> 00:04:51,010
.إنّه عمل لا يختلف عن عملك السّابق

74
00:04:51,410 --> 00:04:54,160
.لا سبب يدفعك للبقاء معها

75
00:04:54,160 --> 00:04:55,500
.انظري لنظّارات

76
00:04:55,500 --> 00:04:57,600
.إنّها لا تدرك حتّى أنّه تمّ استبدالك

77
00:04:57,600 --> 00:04:58,170
!كلاّ

78
00:04:58,170 --> 00:05:00,300
!ستلاحظ كونوها-سان ذلك بالفعل

79
00:05:00,300 --> 00:05:02,850
!سأتأكّد من ذلك بأمّ عينيّ

80
00:05:03,460 --> 00:05:05,040
!ماذا؟! مهلاً، انتظري

81
00:05:07,420 --> 00:05:08,370
.حسنًا

82
00:05:08,370 --> 00:05:09,610
.تمّ الأمر

83
00:05:09,610 --> 00:05:11,790
.انتهت المهمّة

84
00:05:11,790 --> 00:05:13,630
—ها هما هـ

85
00:05:14,480 --> 00:05:15,660
.ساتوكو-تشان

86
00:05:15,660 --> 00:05:17,030
.كالمعتاد رجاءً

87
00:05:17,030 --> 00:05:17,590
ماذا؟

88
00:05:17,590 --> 00:05:18,740
ماذا تقصدين بذلك؟

89
00:05:18,740 --> 00:05:19,680
.كالمعتاد

90
00:05:19,680 --> 00:05:22,330
أقصد تحويل الجثث إلى أوراق
.شجر ومحو أيّ أدلّة

91
00:05:22,330 --> 00:05:24,630
.حسنًا. محو

92
00:05:38,810 --> 00:05:41,800
!ما كانت تلك الخاصّيّة؟

93
00:05:41,800 --> 00:05:44,820
.لا أدري. صنعتها حسب إحساسي فحسب

94
00:05:44,820 --> 00:05:47,460
.ولكنّ هذا متوقّع منّي

95
00:05:47,460 --> 00:05:49,700
.إنّ ذلك شيء لا يستطيع بشر القيام به

96
00:05:49,700 --> 00:05:50,210
!أجل

97
00:05:50,470 --> 00:05:52,140
!ربّما ستدرك الآن

98
00:05:52,140 --> 00:05:53,340
!كونوها-سان

99
00:05:53,800 --> 00:05:55,200
.ساتوكو-تشان

100
00:05:55,200 --> 00:05:56,350
.لقد حسّنتِ مهاراتك

101
00:05:56,350 --> 00:05:57,720
لماذا لا تلاحظ الأمر؟

102
00:05:57,720 --> 00:05:58,770
!لماذا؟

103
00:05:58,770 --> 00:06:00,110
!أتقوم بعرض كوميديّ ما؟

104
00:06:00,110 --> 00:06:00,950
!مهلاً يا هذه

105
00:06:00,950 --> 00:06:02,280
!هذا غريب

106
00:06:02,280 --> 00:06:04,280
!خرجت أشعة ليزر من عينيها

107
00:06:04,280 --> 00:06:07,710
!أنا لستُ معدنيّة هكذا

108
00:06:07,710 --> 00:06:11,350
أيُعقل... أنّك كنت تتظاهرين
!بالغباء لاستدراجها؟

109
00:06:11,350 --> 00:06:12,500
!هذا صحيح

110
00:06:12,500 --> 00:06:15,850
!هذه هي القاتلة الّتي اختطفتني

111
00:06:15,850 --> 00:06:17,160
!ثمّة اثنتان من ساتوكو-تشان؟

112
00:06:17,160 --> 00:06:17,970
!كونوها-سان؟

113
00:06:17,970 --> 00:06:21,170
.حسنًا، ما باليد حيلة الآن بعد أن كشف أمري

114
00:06:21,170 --> 00:06:23,230
!اسمي إيزوتسومي مارين

115
00:06:23,230 --> 00:06:25,980
!أنا منافستك

116
00:06:25,980 --> 00:06:29,070
.أمعني النّظر أكثر يا كونوها-سان

117
00:06:31,990 --> 00:06:33,180
.مارين-سان

118
00:06:33,180 --> 00:06:37,610
.لا أطيق كون كونوها-سان مخدوعة تمامًا بهذا

119
00:06:37,610 --> 00:06:40,460
.لا يفترض أن تكون بهذا الغباء

120
00:06:40,460 --> 00:06:43,620
أيعقل أنّ جزءًا ما من الرّوبوت قد نوّمها

121
00:06:43,620 --> 00:06:45,500
لتعتقد أنّها تبدو مثلي؟

122
00:06:45,500 --> 00:06:46,720
.لا، لا يوجد أيّ جزء هكذا

123
00:06:46,720 --> 00:06:47,510
!لا يوجد؟

124
00:06:47,510 --> 00:06:48,480
.إنّكما صورتان طبق الأصل

125
00:06:48,480 --> 00:06:49,600
!طبق الأصل؟

126
00:06:49,600 --> 00:06:51,020
!طبق... الأصل؟

127
00:06:53,840 --> 00:06:55,020
.ابتسامة

128
00:06:57,140 --> 00:06:58,540
!اسمعا

129
00:06:58,540 --> 00:07:00,140
!انظرا لهذا

130
00:07:00,140 --> 00:07:01,900
!لا تستطيع الرّوبوت القيام بهذا

131
00:07:01,900 --> 00:07:03,530
!تقنية التّحويل لأوراق الشّجر

132
00:07:03,530 --> 00:07:05,900
!حوّلتُ هذا المكيّف إلى أوراق شجر في الحال

133
00:07:07,900 --> 00:07:09,800
أليس ذلك أفضل؟

134
00:07:09,800 --> 00:07:13,150
.رائع. ربّما سأعود وأستعيدها لاستعمالها بنفسي

135
00:07:14,990 --> 00:07:16,930
!لحظة! لحظة! وجدتُها

136
00:07:16,930 --> 00:07:18,040
!حساء الميسو هذا الصّباح

137
00:07:18,040 --> 00:07:19,170
!قلتِ أنّه ليس لذيذًا

138
00:07:19,170 --> 00:07:22,920
أستطيع إعداد وجبات أفضل
!من ذلك يا كونوها-سان

139
00:07:23,950 --> 00:07:25,200
.آسفة يا ساتوكو-تشان

140
00:07:25,200 --> 00:07:26,290
.أرى الأمور بوضوح الآن

141
00:07:26,560 --> 00:07:27,680
!كونوها-سان

142
00:07:27,680 --> 00:07:30,670
.حسنًا، لنهزم هاتين الاثنتين إذًا

143
00:07:31,940 --> 00:07:35,260
!لن ننسى هذا

144
00:07:38,180 --> 00:07:39,680
.شكرًا على الطّعام

145
00:07:46,440 --> 00:07:47,740
كيف كان؟

146
00:07:47,740 --> 00:07:49,950
هل كان حساء الميسو لذيذًا؟

147
00:07:51,190 --> 00:07:53,010
.كانت النّكهة خفيفة قليلاً

148
00:07:53,010 --> 00:07:53,830
...هذا حزين

149
00:07:54,560 --> 00:07:58,700
لكنّ هذه هي أوّل مرّة أتناول
.فيها حساء الميسو بالباذنجان

150
00:07:59,100 --> 00:08:00,340
.وقد كان لذيذًا

151
00:08:03,210 --> 00:08:04,700
.سُحقًا

152
00:08:04,700 --> 00:08:07,440
!انتظري فحسب أيّتها القاتلة نظّارات

153
00:08:07,440 --> 00:08:13,090
ألا تحتاجينني لأنّ روبوكو بإمكانها
إطلاق ليزر من عينيها؟

154
00:08:13,490 --> 00:08:17,130
.نينجا وقاتلة

155
00:08:36,210 --> 00:08:37,110
.ابتسامة

156
00:08:42,700 --> 00:08:43,710
.مرحبًا

157
00:08:43,710 --> 00:08:45,400
.اسمي كوساغاكوري ساتوكو

158
00:08:45,400 --> 00:08:47,530
،بعد هربي من قرية النّينجا دون علم منّي

159
00:08:47,530 --> 00:08:51,570
استقبلتني كونوها-سان عندها
.وكنّا نعيش معًا حتّى الآن

160
00:08:51,570 --> 00:08:55,570
ولكن، صرتُ أعيش الآن مع قاتلة
مأجورة أخرى تُدعى مارين لسبب ما

161
00:08:56,140 --> 00:08:57,850
.لحوال شهر كامل الآن

162
00:08:59,860 --> 00:09:03,230
.أيّتها الكونويتشي. الفطور جاهز

163
00:09:03,230 --> 00:09:04,730
.أنا قادمة

164
00:09:08,350 --> 00:09:10,280
.هذا لذيذ جدًّا

165
00:09:10,280 --> 00:09:12,250
ما هذا الطّعام؟

166
00:09:13,100 --> 00:09:15,360
.إنّه يُدعى كروك موسيو

167
00:09:15,650 --> 00:09:18,230
من اللّطيف تناول طعام على الأسلوب
الغربيّ من حين لآخر، صحيح؟

168
00:09:18,230 --> 00:09:19,320
!نعم

169
00:09:24,630 --> 00:09:26,260
.ساتوكو-تشان

170
00:09:26,260 --> 00:09:28,940
نعم. تريدين شايًا دافئًا، صحيح؟

171
00:09:31,620 --> 00:09:34,140
هذا مذهل. كيف عرفت؟

172
00:09:35,620 --> 00:09:38,160
.كانت درجة حرارتك تنخفض

173
00:09:38,160 --> 00:09:41,770
وكان قد مرّت مدّة منذ
.آخر مرّة شربتِ فيها شيئًا

174
00:09:41,770 --> 00:09:43,800
.أنت شديدة الانتباه

175
00:09:43,800 --> 00:09:45,410
.لكنّ ذلك يثير غثياني نوعًا ما

176
00:09:49,920 --> 00:09:51,170
.كونوها-سان

177
00:09:51,520 --> 00:09:54,400
هل أنا... مفيدة؟

178
00:09:55,070 --> 00:09:56,730
ما هذا السّؤال فجأة؟

179
00:09:58,150 --> 00:10:00,000
.نعم، أنت مفيدة

180
00:10:02,610 --> 00:10:04,730
.أنا مسرورة إذًا

181
00:10:06,160 --> 00:10:09,610
بالرّغم من ذلك، أصبح لجلوسك
مؤخّرًا تأثير غريب

182
00:10:09,610 --> 00:10:12,420
يُشبه إلى حدٍّ مقلق تأثير
.الأجهزة المنزليّة الضّخمة

183
00:10:13,300 --> 00:10:15,020
كنت تملكين سلفًا مجموعة من
.الأطباق اليابانيّة في جعبتك

184
00:10:15,020 --> 00:10:17,220
.وها قد وسّعت قائمة أطباقك أكثر فأكثر

185
00:10:17,220 --> 00:10:19,780
وقد صار مذاق حساء الميسو
.خاصّتك بشكل خاصّ ألذّ

186
00:10:20,180 --> 00:10:21,180
ماذا؟

187
00:10:21,180 --> 00:10:23,820
هل أخسر في مواجهة روبوت؟

188
00:10:25,060 --> 00:10:27,810
!مارين-سان

189
00:10:27,810 --> 00:10:30,440
.أخبرتك أن تطرقي الباب

190
00:10:30,440 --> 00:10:33,030
...عفوًا، بخصوص الكروك موسيو

191
00:10:33,030 --> 00:10:35,680
هلاّ علّمتني كيف أقوم بإعداده؟

192
00:10:35,970 --> 00:10:37,690
ما الغاية من هذا؟

193
00:10:41,770 --> 00:10:47,180
ربّما إن تعلّمتُ إعداد أطعمة
.غير يابانيّة، فقد تكون أسعد

194
00:10:47,960 --> 00:10:52,470
لا تبتسم كونوها-سان
.إلاّ عندما يحين وقت الأكل

195
00:10:52,470 --> 00:10:54,140
!هذا صحيح

196
00:10:54,140 --> 00:10:56,590
.تعلو وجهها في العادة ملامح جامدة

197
00:10:56,590 --> 00:10:59,350
.إنّها لا تبتسم في هذه الصّورة

198
00:10:59,350 --> 00:11:00,760
.لكن انظري كم تبدو رائعة

199
00:11:00,760 --> 00:11:02,980
...أيُعقل يا مارين-سان

200
00:11:02,980 --> 00:11:05,460
أنّك معجبة بكونوها-سان؟

201
00:11:05,470 --> 00:11:09,480
!أ-أنت مخطئة
!أنا أراقبها فقط لأنّها منافستي

202
00:11:11,220 --> 00:11:12,240
.حسنًا

203
00:11:12,520 --> 00:11:15,290
،بعد بحث حساء الميسو

204
00:11:15,290 --> 00:11:19,600
أعتقد أنّي سأصقل مهاراتي لأستطيع
.المساعدة في عمل كونوها-سان

205
00:11:20,900 --> 00:11:21,490
.رنّة

206
00:11:24,370 --> 00:11:26,210
.عثرتُ عليه أخيرًا

207
00:11:26,210 --> 00:11:27,940
.مخبأ النّينجا الهاربة

208
00:11:27,940 --> 00:11:30,500
سينتهي كلّ شيء بمجرّد
إبلاغ جميع من في القرية

209
00:11:30,500 --> 00:11:32,490
.والتّخطيط لكمين

210
00:11:34,250 --> 00:11:35,090
!ماذا؟

211
00:11:35,090 --> 00:11:36,250
!ما-ماذا؟

212
00:11:36,250 --> 00:11:37,670
!من أنت؟

213
00:11:38,470 --> 00:11:40,260
!مـ-مهلاً لحظة

214
00:11:40,260 --> 00:11:43,180
هذه لفيفة سرّيّة تمّ توارثها
.في عشيرة كوساغاكوري

215
00:11:43,180 --> 00:11:45,520
...إن أزلتُ هذا الختم

216
00:11:45,520 --> 00:11:47,620
.بإمكاني إخبارك بما حدث أنت فقط

217
00:11:47,620 --> 00:11:49,310
.لذلك حان وقت الصّمت والاستماع

218
00:11:49,310 --> 00:11:52,020
.كَشفتُ أنّك تماطلين لكسب الوقت

219
00:11:52,020 --> 00:11:52,570
!ماذا؟

220
00:11:59,620 --> 00:12:00,820
.لقد عدت

221
00:12:01,110 --> 00:12:03,580
!مهلاً. ما قصّة كلّ هذه الدّماء؟

222
00:12:03,580 --> 00:12:06,830
.قطعتُ إصبعي أثناء الطّبخ

223
00:12:06,830 --> 00:12:07,570
ماذا؟

224
00:12:08,320 --> 00:12:09,570
هل أنت بخير؟

225
00:12:10,550 --> 00:12:13,240
.لا يبدو أنّك مصابة في أيّ مكان

226
00:12:13,240 --> 00:12:16,300
.لا بدّ أنّ الجرح قد شفي سلفًا

227
00:12:16,300 --> 00:12:17,360
فعلاً؟

228
00:12:17,750 --> 00:12:19,620
.شكرًا على قلقك عليّ

229
00:12:19,860 --> 00:12:22,780
،لدينا عمل في الغابة غدًا
.لذلك سأخلد للنّوم باكرًا

230
00:12:22,780 --> 00:12:23,600
.حسنًا

231
00:12:30,770 --> 00:12:32,980
.أنا متعبة

232
00:12:32,980 --> 00:12:34,890
.أحسنت عملاً اليوم

233
00:12:35,170 --> 00:12:39,640
كنتُ لأضيع في الغابة لو لم تطيري
.بنا إلى هنا اليوم يا ساتوكو-تشان

234
00:12:41,530 --> 00:12:45,280
استطعتُ تقديم كلّ ما لديّ
.بالتّفكير بك يا كونوها-سان

235
00:12:59,290 --> 00:13:01,900
مهلاً. هل أنت بخير؟

236
00:13:01,900 --> 00:13:03,370
.أنا أعتذر

237
00:13:03,370 --> 00:13:06,550
.يبدو أنّي متعبة من الطّيران

238
00:13:08,010 --> 00:13:10,550
.لا بدّ أنّ مهارات النّينجا الطّائرة متعبة

239
00:13:10,550 --> 00:13:12,450
.شكرًا على عملك بجدّ يا ساتوكو-تشان

240
00:13:15,020 --> 00:13:18,090
هل يمكنك وصلي... بمقبس؟

241
00:13:18,090 --> 00:13:19,440
.بالطّبع

242
00:13:23,570 --> 00:13:25,320
ستنامين هناك اللّيلة؟

243
00:13:26,420 --> 00:13:27,960
.سأطفئ الأنوار إذًا

244
00:13:29,490 --> 00:13:31,330
.تصبحين على خير يا ساتوكو-تشان

245
00:13:32,340 --> 00:13:33,990
.تصبحين على خير

246
00:13:37,340 --> 00:13:38,820
.أشعر بالبرد

247
00:13:38,820 --> 00:13:40,670
...هذا صحيح، مؤخّرًا

248
00:13:41,090 --> 00:13:43,920
...كنّا ننام معًا مؤخّرًا، لذلك

249
00:13:43,920 --> 00:13:45,760
.ثمّة شعور بالوحدة

250
00:13:46,850 --> 00:13:48,490
.ساتوكو-تشان

251
00:13:56,350 --> 00:13:58,360
.كو-كونوها-سان

252
00:13:58,710 --> 00:14:00,350
ما قصّة تلك النّظرة؟

253
00:14:01,130 --> 00:14:04,040
.شعرتُ ببعض البرد أيضًا

254
00:14:05,410 --> 00:14:07,500
.تعالي، نامي هنا

255
00:14:15,500 --> 00:14:17,790
.مهلاً يا ساتوكو-تشان

256
00:14:19,490 --> 00:14:20,990
،ساتوكو-تشان

257
00:14:20,990 --> 00:14:24,120
.إنّك دافئة مثل هاتف يُشحن

258
00:14:27,510 --> 00:14:31,740
حساء الميسو الّذي تعدّينه هو الأفضل
.بالفعل يا ساتوكو-تشان

259
00:14:31,740 --> 00:14:37,270
،قلتِ من قبل أنّه كان لذيذًا
.لذلك حضّرتُ الكثير هذه المرّة

260
00:14:37,530 --> 00:14:39,270
.ذلك كثير جدًّا

261
00:14:39,880 --> 00:14:41,370
.أعتذر

262
00:14:42,260 --> 00:14:43,520
.مارين-سان

263
00:14:43,520 --> 00:14:45,280
.انتهيت

264
00:14:48,280 --> 00:14:50,620
!أيّتها الكونويتشي، هذا لذيذ

265
00:14:50,620 --> 00:14:52,850
!أبليتِ حسنًا بما أنّها محاولتك الأولى

266
00:14:52,850 --> 00:14:55,410
.كلّ هذا بفضلك إرشاداتك يا مارين-سان

267
00:14:55,410 --> 00:14:58,650
.سأقوم بإعداده لكونوها-سان في المرّة القادمة

268
00:15:00,920 --> 00:15:03,410
!حسنًا، انتهى العمل

269
00:15:03,410 --> 00:15:06,680
.بدأت أصعد في التّرتيب بفضلك أيّتها الكونويتشي

270
00:15:06,680 --> 00:15:08,200
!شكرًا لك

271
00:15:08,650 --> 00:15:11,680
.الحصول على الثّناء يسعدني كثيرًا

272
00:15:12,150 --> 00:15:17,160
ولكن بسبب روبوكو، لا يتغيّر
.ترتيب نظّارات كثيرًا

273
00:15:17,160 --> 00:15:19,050
.كما هو متوّقع من منافستي

274
00:15:19,810 --> 00:15:21,310
.هكذا إذًا

275
00:15:21,310 --> 00:15:25,160
.تُبلي كونوها-سان بخير بدوني

276
00:15:29,060 --> 00:15:31,290
.يمكنك الذّهاب للمنزل إذًا

277
00:15:31,290 --> 00:15:32,070
ماذا؟

278
00:15:32,070 --> 00:15:35,090
.لا يسعني سوى الشّعور بالأسف عليها

279
00:15:35,090 --> 00:15:40,070
لا يهمّ كم أنّ روبوتي مثاليّة
...في خداع نظّارات

280
00:15:40,930 --> 00:15:42,250
...الأمر لا يريحني

281
00:15:42,250 --> 00:15:45,490
...ذلك الشّعور كأنّك شخص لا حاجة إليه

282
00:15:46,920 --> 00:15:48,370
...مارين-سان

283
00:15:49,300 --> 00:15:52,560
.كانت لديّ أخت

284
00:15:52,560 --> 00:15:53,930
،على عكسي

285
00:15:53,930 --> 00:15:55,340
—كان بإمكانها القيام بأيّ شيء

286
00:15:53,940 --> 00:15:55,340
!شكرًا جزيلاً لك

287
00:15:55,340 --> 00:15:56,960
!سأعود للمنزل إذًا

288
00:15:56,960 --> 00:15:58,330
!ماذا؟ مهلاً

289
00:15:58,330 --> 00:15:59,340
!كنتُ في وسط الحديث

290
00:15:59,340 --> 00:16:00,590
!مع السّلامة

291
00:16:00,590 --> 00:16:02,210
!عودي إلى هنا

292
00:16:04,490 --> 00:16:06,320
.تمّ كلّ شيء

293
00:16:06,320 --> 00:16:09,140
.بدأت أشعر بالجوع
.لنعد للمنزل بعد الأكل

294
00:16:09,140 --> 00:16:11,160
أتفضّلين مكانًا فيه مقبس ثانية؟

295
00:16:11,160 --> 00:16:13,590
.نعم، شكرًا لك

296
00:16:17,110 --> 00:16:18,270
.طاولة لاثنتين

297
00:16:23,100 --> 00:16:26,250
،ارتفعت فاتورة الكهرباء مؤخّرًا

298
00:16:26,250 --> 00:16:29,510
لذا كوني واعية بالأشياء الأخرى الّتي
.تستهلك الكهرباء إلى جانب الشّحن

299
00:16:30,130 --> 00:16:32,640
هل تشكّل مصاريف المنزل عائقًا؟

300
00:16:32,640 --> 00:16:35,330
.ذلك ليس ما كنت أقصده بالضّبط

301
00:16:35,640 --> 00:16:39,800
.المكافآت الّتي تنالينها من أعمالك مجزية جدًّا

302
00:16:39,800 --> 00:16:41,670
...ولكن، بما أنّ الأصليّة

303
00:16:41,670 --> 00:16:45,400
،أعني، بما أنّي من حوّلتُ أثاثك لأوراق شجر

304
00:16:45,400 --> 00:16:48,380
،كنّا مقتصدتين في شراء الأجهزة الجديدة

305
00:16:48,380 --> 00:16:50,910
.ممّا جعل مستوى معيشتنا منخفضًا

306
00:16:52,520 --> 00:16:55,480
.يا لها من مفاجأة
استطعتِ كشف كلّ ذلك؟

307
00:16:57,770 --> 00:17:00,860
.بالطّبع. لأنّ الأمر يخصّك

308
00:17:01,280 --> 00:17:03,510
.ماذا؟ ذلك مخيف نوعًا ما

309
00:17:06,040 --> 00:17:08,580
إن لم تمانعي، هل بإمكانك إخباري

310
00:17:08,580 --> 00:17:12,130
عن السّبب الّذي دفعك لاختيار هذه
،المسيرة المهنيّة والصّعود في التّرتيب

311
00:17:12,130 --> 00:17:15,000
وهذه الحاجة لكسب الكثير من المال؟

312
00:17:22,540 --> 00:17:24,050
.أعتقد أنّ بإمكاني إخبارك

313
00:17:24,050 --> 00:17:26,050
.ولكن ليس كلّ شيء

314
00:17:26,050 --> 00:17:27,370
.لا أمانع ذلك

315
00:17:27,370 --> 00:17:30,060
بدلاً من مساعدتك في عملك
،دون المعرفة الكافية

316
00:17:30,060 --> 00:17:32,340
أعتقد أنّه من الأفضل لي

317
00:17:32,340 --> 00:17:35,070
.كزميلة في العمل أن أفهم أهدافك

318
00:17:35,070 --> 00:17:40,330
سيكون من المفيد أكثر لي
.إن ظللتِ مساعِدة جاهلة

319
00:17:40,330 --> 00:17:42,890
.قدّمت لك المساعدة حتّى الآن

320
00:17:42,890 --> 00:17:47,380
أتظنّين أنّ هناك ما قد يمنعني
من مساعدتك إن شرحتِ لي؟

321
00:17:47,720 --> 00:17:50,890
.بإمكانك إخباري بأيّ شيء

322
00:17:51,210 --> 00:17:52,830
.أفترض أنّك على حقّ

323
00:17:52,830 --> 00:17:56,020
.كنّا معًا لمدّة طويلة

324
00:17:56,020 --> 00:17:59,390
لا أظنّ أنّك ستتخلّين عنّي الآن
.لمجرّد أنّك تكرهين شيئًا فيّ

325
00:18:05,250 --> 00:18:06,380
.هكذا إذًا

326
00:18:06,380 --> 00:18:08,650
.ذلك هو السّبب إذًا

327
00:18:09,350 --> 00:18:10,790
...هذه أوّل مرّة

328
00:18:10,790 --> 00:18:13,120
.أخبر فيها شخصًا بهذا

329
00:18:13,380 --> 00:18:17,130
أعرف أنّك كنت تستعملين
،اسم "كوغا كونوها" المزيّف

330
00:18:17,130 --> 00:18:18,560
...لكنّي لا أصدّق أنّ لك ماضٍ كهذا

331
00:18:18,560 --> 00:18:22,310
،بعد أن أخبرتك الآن بأسبابي
هل ما زلت ستعملين معي؟

332
00:18:24,110 --> 00:18:25,600
.بالطّبع سأفعل

333
00:18:25,600 --> 00:18:30,130
.كما سبق أخبرتك، لن أرفضك أبدًا

334
00:18:32,880 --> 00:18:35,660
.ساتوكو-تشان، بشرتك باردة

335
00:18:39,630 --> 00:18:40,890
!مهلاً

336
00:18:40,890 --> 00:18:43,470
ما هذا الجوّ المليء بالعواطف؟

337
00:18:44,790 --> 00:18:47,020
!إنّها تتعانقان؟

338
00:18:47,310 --> 00:18:48,010
...أنت هنا

339
00:18:48,010 --> 00:18:49,640
.يا ساتوكو-تشان المزيّفة

340
00:18:49,640 --> 00:18:51,540
!أنت مخطئة

341
00:18:51,540 --> 00:18:52,570
!مخطئة تمامًا

342
00:18:52,570 --> 00:18:54,370
!تلك هي المزيّفة

343
00:18:54,370 --> 00:18:56,140
ألم تشعري أنّها صلبة وأنت تحضنينها؟

344
00:18:56,140 --> 00:18:58,420
!حتّى أنّك قلتِ أنّها كانت باردة

345
00:18:58,420 --> 00:18:59,810
!إنّها روبوت! وهي باردة

346
00:18:59,810 --> 00:19:01,700
!أمّا أنا، فأنا بشريّة! أنا دافئة

347
00:19:02,750 --> 00:19:04,200
.إنّك تشعرينني بالغثيان

348
00:19:04,200 --> 00:19:07,820
تهاونتُ في آخر مرّة لأنّك تشبهين
.ساتوكو-تشان كثيرًا

349
00:19:07,820 --> 00:19:09,390
!لا يبدو هذا جيّدًا أيّتها الكونويتشي

350
00:19:09,390 --> 00:19:10,330
!مارين-سان

351
00:19:10,330 --> 00:19:12,300
!نيّتها على القتل لا يُستهان بها

352
00:19:12,300 --> 00:19:12,950
!إنّها مخيفة

353
00:19:12,950 --> 00:19:17,050
تلك الفتاة هناك لم تزعجني
...بما أنّ ترتيبها أقلّ

354
00:19:17,050 --> 00:19:19,220
...لكنّ ترتيبها بدأ يتصاعد مؤخّرًا

355
00:19:19,220 --> 00:19:20,210
.بلع

356
00:19:20,210 --> 00:19:21,970
.لو سمحتِ يا ساتوكو-تشان

357
00:19:21,970 --> 00:19:22,720
.حالاً

358
00:19:22,970 --> 00:19:24,230
حالاً؟

359
00:19:30,220 --> 00:19:32,890
.أطلقتُ مسحوقًا خاصًّا

360
00:19:32,890 --> 00:19:35,890
.لا يستطيع أيّ أحد حولنا رؤيتنا الآن

361
00:19:35,890 --> 00:19:37,270
.شكرًا لك يا ساتوكو-تشان

362
00:19:37,270 --> 00:19:39,650
!ماذا؟! ذلك مفيد جدًّا

363
00:19:39,650 --> 00:19:42,280
!روبوكو، أنا من صنعك

364
00:19:42,280 --> 00:19:43,980
...رنّة، رنّة، رنّة، رنّة

365
00:19:43,980 --> 00:19:44,530
.استدارة

366
00:19:44,530 --> 00:19:46,960
!مهلاً! هل تتظاهر أنّها لا تسمعني؟

367
00:19:46,960 --> 00:19:48,450
ماذا؟ أين هي كونوها-سان؟

368
00:19:48,450 --> 00:19:49,790
!هذا سيّئ أيّتها الكونويتشي

369
00:19:49,790 --> 00:19:51,640
،رغم أنّنا شخصان ضدّ شخص وروبوت

370
00:19:51,640 --> 00:19:53,570
!لا يمكنني فعل أيّ شيء وأنا عزلاء

371
00:19:53,570 --> 00:19:55,010
هل لديك أيّ خطّة؟

372
00:19:55,010 --> 00:19:56,100
!مستحيل

373
00:19:56,100 --> 00:19:58,080
أعرف قوّة كونوها-سان أكثر
...من أيّ أحد آخر

374
00:19:58,840 --> 00:20:00,080
...روبوت

375
00:20:00,080 --> 00:20:01,210
!وجدتها

376
00:20:01,210 --> 00:20:03,340
ماذا هنالك أيّتها الكونويتشي؟

377
00:20:03,340 --> 00:20:04,420
!كونوها-سان

378
00:20:05,180 --> 00:20:06,490
!انظري

379
00:20:17,820 --> 00:20:21,450
يستطيع النّينجتسو خاصّتي
.تحويل "الأشياء" إلى أوراق شجر

380
00:20:21,450 --> 00:20:24,070
!"الرّوبوتات "أشياء" وليسوا "أشخاص

381
00:20:24,070 --> 00:20:27,830
!هل تدركين الآن أنّني الحقيقيّة؟

382
00:20:45,090 --> 00:20:46,440
كونوها-سان؟

383
00:20:51,760 --> 00:20:53,880
هل الأمر هكذا؟

384
00:20:54,760 --> 00:20:57,140
...هذه هي ساتوكو-تشان الحقيقيّة

385
00:20:57,980 --> 00:21:00,290
!كونوها-سان

386
00:20:59,120 --> 00:21:01,580
.لا أحتاج لذلك الآن

387
00:21:01,860 --> 00:21:04,040
!لنعد للمنزل إذًا

388
00:21:04,880 --> 00:21:05,900
.صحيح

389
00:21:07,750 --> 00:21:08,520
...حسنًا

390
00:21:09,130 --> 00:21:12,000
!مارين-سان، شكرًا لاعتنائك بي

391
00:21:14,630 --> 00:21:16,180
...روبوكو

392
00:21:19,240 --> 00:21:21,380
.عندنا للمنزل

393
00:21:21,740 --> 00:21:22,940
.حساء الميسو

394
00:21:23,380 --> 00:21:25,760
روبوكو أعدّته، صحيح؟

395
00:21:25,760 --> 00:21:28,170
هل أرميه وأعدّ واحدًا جديدًا؟

396
00:21:29,360 --> 00:21:31,230
.لا، سآكله

397
00:21:31,830 --> 00:21:32,760
.سآكله

398
00:21:52,660 --> 00:21:55,410
.إنّه لذيذ بالفعل

399
00:23:30,940 --> 00:23:33,100
.كونوها-سان، هذا عرض الحلقة القادمة

400
00:23:33,100 --> 00:23:34,380
.قوليها كما كانت لتقولها روبوكو

401
00:23:34,380 --> 00:23:35,930
.ماذا؟ مهلاً، مهلاً

402
00:23:35,930 --> 00:23:37,810
.كونوها-سان، هذا عرض الحلقة القادمة

403
00:23:37,810 --> 00:23:39,410
.واصلي هكذا لبعض الوقت