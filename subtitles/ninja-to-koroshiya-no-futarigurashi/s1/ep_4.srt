1
00:00:07,970 --> 00:00:10,570
.نحن مبلّلتان بالكامل

2
00:00:10,570 --> 00:00:12,800
.هطل المطر فجأة

3
00:00:12,800 --> 00:00:16,370
!لنأخذ حمّامًا قبل أن نصاب بالزّكام

4
00:00:17,230 --> 00:00:18,410
.معك حقّ

5
00:00:20,880 --> 00:00:22,520
.سأستحمّ أوّلاً

6
00:00:24,350 --> 00:00:26,570
لماذا دخلتِ معي؟

7
00:00:26,570 --> 00:00:29,140
أليس من الأفضل الاستحمام معًا؟

8
00:00:29,140 --> 00:00:30,000
ماذا؟

9
00:00:30,000 --> 00:00:31,040
.لا أريد ذلك

10
00:00:34,340 --> 00:00:35,810
...أ-أشعر بالبرد

11
00:00:42,280 --> 00:00:44,390
ما الّذي تشاهدينه؟

12
00:01:03,650 --> 00:01:05,680
.لقد أخافني ذلك

13
00:01:05,680 --> 00:01:07,640
هذا فيلم رعب، أليس كذلك؟

14
00:01:07,640 --> 00:01:09,180
.كفّي عن التّشبّث بي

15
00:01:09,180 --> 00:01:10,910
.آ-آسفة

16
00:01:13,410 --> 00:01:14,890
.سأخلد النّوم الآن

17
00:01:17,060 --> 00:01:18,500
...عفوًا

18
00:01:19,170 --> 00:01:21,580
أيمكنني النّوم هنا اللّيلة؟

19
00:01:21,580 --> 00:01:22,930
لِمَ هذا فجأة هكذا؟

20
00:01:22,930 --> 00:01:23,930
...إنّني

21
00:01:23,930 --> 00:01:26,430
...كان الفيلم الّذي شاهدناه مخيفًا

22
00:01:26,740 --> 00:01:30,440
...والمطبخ بارد قليلاً

23
00:01:31,260 --> 00:01:33,030
...إضافة لذلك

24
00:01:33,030 --> 00:01:37,320
!قالت القائدة قبل أيّام أنّ وضعنا غريب

25
00:01:37,320 --> 00:01:42,630
.أخبرتني أنّهما تستحمّان وتنامان معًا

26
00:01:42,630 --> 00:01:44,910
.يبدو أنّهما منسجمتان بالكامل

27
00:01:45,260 --> 00:01:46,750
...صحيح، لكن

28
00:01:46,750 --> 00:01:49,200
.ذلك وضع خاصّ بهما هما

29
00:01:49,200 --> 00:01:51,710
.أمّا أنت فمجرّد عالة هنا يا ساتوكو-تشان

30
00:01:51,710 --> 00:01:54,620
.إنّنا مجرّد زميلتان

31
00:01:54,620 --> 00:01:55,470
ماذا؟

32
00:01:57,230 --> 00:01:58,500
.تصبحين على غير

33
00:03:36,940 --> 00:03:38,340
!أيّتها القائدة

34
00:03:38,340 --> 00:03:40,450
!قالت لي أنّنا مجرّد زميلتين

35
00:03:40,450 --> 00:03:42,050
ما رأيك في ذلك؟

36
00:03:42,050 --> 00:03:43,780
...حسب رأيي

37
00:03:43,780 --> 00:03:45,680
.من الطّبيعيّ لتلك الفتاة أن تقول ذلك

38
00:03:45,680 --> 00:03:47,560
!أهذا كلّ شيء؟

39
00:03:47,560 --> 00:03:51,360
وتوقّفي أيضًا عن الاتّصال بي
.كلّما حصل شيء

40
00:03:51,360 --> 00:03:53,330
!أنا امرأة مشغولة

41
00:03:53,330 --> 00:03:54,560
...عجبًا

42
00:03:54,560 --> 00:03:57,830
ألا تستطيعين إخفاء تلك النّظرة
الّتي تقول: "لكنّك عاطلة عن العمل"؟

43
00:03:58,080 --> 00:03:59,340
.انسي الأمر. سأعود للمنزل

44
00:03:59,340 --> 00:04:00,840
!انتظري رجاءً

45
00:04:00,840 --> 00:04:03,580
أنت الوحيدة الّتي يمكنني
!الاعتماد عليها أيّتها القائدة

46
00:04:05,290 --> 00:04:06,620
ماذا قلت؟

47
00:04:06,620 --> 00:04:09,480
أنت الوحيدة الّتي يمكنني
!الاعتماد عليها أيّتها القائدة

48
00:04:13,320 --> 00:04:16,040
حسنًا، ما الّذي يزعجك؟

49
00:04:16,040 --> 00:04:19,300
،ما دمت تملك طعامًا وملبسًا ومأوى
.فكلّ شيء ينبغي أن يكون على ما يرام

50
00:04:19,300 --> 00:04:20,670
.ذ-ذلك صحيح

51
00:04:20,670 --> 00:04:22,190
.لقد وافقتني بسهولة

52
00:04:22,510 --> 00:04:24,000
!شكرًا جزيلاً

53
00:04:24,350 --> 00:04:25,870
!حُلّ الأمر الآن

54
00:04:25,870 --> 00:04:26,640
—إلى اللّقا

55
00:04:26,640 --> 00:04:28,820
.مهلاً، لا تحاولي المغادرة

56
00:04:30,310 --> 00:04:32,380
...بعبارة أخرى يا ساتوكو

57
00:04:32,380 --> 00:04:35,460
.أنت غير راضية عن علاقتكما
هل أنا محقّة؟

58
00:04:35,460 --> 00:04:37,380
!نعم! ذلك صحيح

59
00:04:38,480 --> 00:04:42,040
،عندما تحدّثتُ معك ومع حبيبتك قبل أيّام

60
00:04:42,040 --> 00:04:44,530
.بدوتما مقرّبتين جدًّا من بعضكما

61
00:04:44,530 --> 00:04:48,140
...مقارنة بذلك، نحن

62
00:04:48,910 --> 00:04:50,710
.جعلني الأمر أفكّر هكذا

63
00:04:50,710 --> 00:04:52,510
!أريد أن نكون أنا وكونوها-سان مثلكما

64
00:04:52,510 --> 00:04:53,410
ماذا؟

65
00:04:53,750 --> 00:04:55,670
...هل يعني ذلك

66
00:04:55,670 --> 00:04:57,950
أ-أنت جادّة؟

67
00:04:57,950 --> 00:04:59,520
...فهمت

68
00:05:00,580 --> 00:05:03,280
.لديك ذوق سيّئ في الفتيات

69
00:05:04,530 --> 00:05:06,280
!حسنًا إذًا

70
00:05:06,600 --> 00:05:09,040
!إن كان الأمر هكذا، سأساعدك

71
00:05:11,610 --> 00:05:13,550
!شكرًا جزيلاً لك

72
00:05:13,550 --> 00:05:15,420
!سأضع نفسي في رعايتك

73
00:05:15,420 --> 00:05:19,920
أتمنّى أن أستطيع العيش بسعادة
!مع كونوها-سان مثلكما أنتما

74
00:05:19,920 --> 00:05:21,930
!أكيد، دعي الأمر لي

75
00:05:21,930 --> 00:05:25,950
!لم أدري أنّك أردتِ أن تكونا ثنائيًّا مثلنا

76
00:05:28,660 --> 00:05:30,630
ما هذه؟

77
00:05:30,630 --> 00:05:36,440
حسنًا. يبدو أنّ الوضع من جانب
.واحد وهو جانبك يا ساتوكو

78
00:05:36,440 --> 00:05:39,570
.لذلك دعينا نبدأ بأمور ستُكسبك إعجابها

79
00:05:39,570 --> 00:05:42,300
أهذا ما تظنّين؟

80
00:05:42,300 --> 00:05:43,900
.لديّ عمل كثير سلفًا

81
00:05:43,900 --> 00:05:45,690
.لا داعي للقلق

82
00:05:45,690 --> 00:05:51,070
.قد تجهلين هذا، لكنّي أملك شعبيّة كبيرة

83
00:05:51,070 --> 00:05:52,220
!أيّتها القائدة

84
00:05:52,220 --> 00:05:55,670
.دعي الأمر لي فحسب

85
00:05:55,670 --> 00:05:56,580
!نعم

86
00:05:57,160 --> 00:05:58,820
.لنبدأ إذًا

87
00:05:58,820 --> 00:06:00,500
،بعد تحقيق معمّق

88
00:06:00,500 --> 00:06:04,840
إنّ الشّيء الأوّل الّذي يختاره الرّجال
...ذوي الشّعبيّة في شركاء حياتهم هو

89
00:06:04,840 --> 00:06:05,880
!الوجه

90
00:06:06,340 --> 00:06:10,540
،ذُكر هنا، "إن كان للفتاة وجه ظريف
."فإنّ كلّ ما تفعله سيكون ظريفًا

91
00:06:10,540 --> 00:06:13,460
.طبعًا، إنّ يوري ظريفة بالفعل

92
00:06:18,340 --> 00:06:19,010
.أنت عاديّة

93
00:06:19,010 --> 00:06:19,340
...ما

94
00:06:19,340 --> 00:06:20,730
...والشّيء الثّاني هو

95
00:06:20,920 --> 00:06:22,220
!الجسم

96
00:06:22,220 --> 00:06:24,580
".الأجساد الجميلة تُسعدني"

97
00:06:24,580 --> 00:06:26,740
.وهذا ينطبق على يوري أيضًا

98
00:06:29,270 --> 00:06:30,150
.أنت عاديّة

99
00:06:30,150 --> 00:06:30,880
...التّالي

100
00:06:31,240 --> 00:06:33,160
!الشّيء الثّالث هو الطّبخ

101
00:06:33,160 --> 00:06:35,950
".أقرب طريق للقلب هو عبر المعدة"

102
00:06:36,270 --> 00:06:39,120
.ساتوكو، بإمكانك النّجاح في هذا

103
00:06:39,120 --> 00:06:42,170
!نعم! أنا واثقة من مهاراتي في الطّبخ

104
00:06:44,750 --> 00:06:48,540
!شكرًا جزيلاً لك أيّتها القائدة

105
00:06:48,540 --> 00:06:51,450
!أكيد! حظًّا موفّقًا

106
00:06:57,300 --> 00:06:58,560
.لقد عدت

107
00:06:58,560 --> 00:07:00,440
!مرحبًا بعودتك يا كونوها-سان

108
00:07:00,440 --> 00:07:02,560
ماذا؟ ما قصّة هذه الملابس؟

109
00:07:03,110 --> 00:07:04,820
أليست ظريفة؟

110
00:07:08,810 --> 00:07:11,330
!نصيحة القائدة الأولى

111
00:07:11,330 --> 00:07:14,820
!من الممتع أن يراك الطّرف الآخر تطبخين

112
00:07:11,710 --> 00:07:13,080
.كُلي

113
00:07:14,830 --> 00:07:17,080
!نصيحة القائدة الثّانية

114
00:07:17,080 --> 00:07:19,580
يكون من الممتع أن يراك الطّرف
!الآخر بزيّ مثير

115
00:07:17,470 --> 00:07:19,580
.اختلسي نظرة

116
00:07:23,890 --> 00:07:25,450
.ستحترقين

117
00:07:26,430 --> 00:07:27,600
ماذا؟

118
00:07:27,600 --> 00:07:30,300
ماذا على العشاء اللّيلة؟

119
00:07:34,920 --> 00:07:36,330
!تنبورا

120
00:07:36,680 --> 00:07:38,270
.ستحترقين

121
00:07:40,190 --> 00:07:42,440
.انتهيت

122
00:07:42,770 --> 00:07:44,820
...جلدي يؤلم ويلسع

123
00:07:44,820 --> 00:07:47,440
.لقد حذّرتك، كلّ ذلك بسبب ما ترتدينه

124
00:07:47,900 --> 00:07:51,440
لن يكون مذاق وجباتي لذيذًا
.إن رأيتُ أنّ من طبخها احترق بسببها

125
00:07:51,440 --> 00:07:54,820
!إنّني أشعر وكأنّي غبيّة بارتدائي لهذا الزّيّ

126
00:07:54,820 --> 00:07:56,320
.أنت غبيّة بالفعل

127
00:07:56,320 --> 00:07:59,820
!أيّتها القائدة! لم ينجح الأمر أبدًا

128
00:07:57,650 --> 00:07:59,010
.سلام

129
00:07:59,010 --> 00:07:59,820
.أنت صاخبة

130
00:08:00,830 --> 00:08:03,200
!نصيحة القائدة الثّالثة

131
00:08:03,200 --> 00:08:05,580
!الفتيات اللاّتي تُجِدن الطّبخ محبوبات

132
00:08:06,290 --> 00:08:07,900
هل التّنبورا لذيذة؟

133
00:08:07,900 --> 00:08:09,050
.إنّها لذيذة

134
00:08:09,050 --> 00:08:11,160
.كم سرّني هذا

135
00:08:11,160 --> 00:08:13,090
،أنا سعيدة أيضًا بصفتي من طبخها

136
00:08:13,090 --> 00:08:15,210
!ولرؤيتك تبتسمين هكذا وأنت تأكلين

137
00:08:16,850 --> 00:08:19,600
هل أنا أبتسم الآن؟

138
00:08:19,600 --> 00:08:21,850
!نعم! من الضّرس للضّرس

139
00:08:22,190 --> 00:08:24,470
أيمكننا الأكل بشكل منفصل بعد الآن؟

140
00:08:24,470 --> 00:08:26,370
ماذا؟ لـ-لماذا؟

141
00:08:31,680 --> 00:08:34,180
!نصيحة القائدة الرّابعة

142
00:08:34,180 --> 00:08:36,550
.الفتيات اللاّتي تُجِدن الاستماع محبوبات

143
00:08:36,550 --> 00:08:37,860
...كونوها-سان

144
00:08:37,860 --> 00:08:40,350
كيف كان يومك في المدرسة؟

145
00:08:40,350 --> 00:08:42,380
.حسنًا، كان عاديًّا

146
00:08:42,380 --> 00:08:43,880
فعلاً؟

147
00:08:49,480 --> 00:08:50,760
!ماذا؟! ماذا هنالك؟

148
00:08:50,760 --> 00:08:53,770
قمتُ بمهمّة وحدي في طريقي
.للمنزل من المدرسة

149
00:08:53,770 --> 00:08:55,810
هل يمكنك الذّهاب للتّخلّص من الجثّة؟

150
00:08:56,530 --> 00:08:59,710
...نصيحة القائدة الخامسة

151
00:09:00,140 --> 00:09:03,230
!الفتيات اللاّتي يُعتمد عليهنّ محبوبات

152
00:09:04,350 --> 00:09:05,970
!دعي الأمر لي

153
00:09:14,450 --> 00:09:15,790
.هذه هي

154
00:09:16,560 --> 00:09:20,740
!كونوها-سان فوضويّة بالفعل

155
00:09:21,780 --> 00:09:25,920
أكانت هكذا قبل أن تبدأ العمل معي؟

156
00:09:26,780 --> 00:09:30,290
...إنّها لا تتحدّث عن نفسها معي

157
00:09:30,290 --> 00:09:31,450
.لا تتحرّكي

158
00:09:32,540 --> 00:09:34,430
.تركتِ الكثير من الثّغرات

159
00:09:34,430 --> 00:09:37,050
كيف لشخص مثلك أن يقتل
أختي الكبيرة والبقيّة؟

160
00:09:37,770 --> 00:09:39,460
...أنتِ مطارِدة نينجا

161
00:09:41,600 --> 00:09:43,920
.إنّ عليه دواءً يسبّب الشّلل

162
00:09:43,920 --> 00:09:45,060
.لن تستطيعي الحركة

163
00:09:46,310 --> 00:09:48,130
.سأدخل صلب الموضوع

164
00:09:48,670 --> 00:09:51,440
أيمكنك إعادتهنّ لطبيعتهنّ؟

165
00:09:52,230 --> 00:09:54,380
...أقصد النّينجا اللاّتي حوّلتهنّ لأوراق شجر

166
00:09:55,740 --> 00:09:58,580
أيمكنك إعادة أختي الكبيرة والبقيّة لطبيعتهنّ؟

167
00:09:59,440 --> 00:10:00,910
.أرى أنّك كنت تجمعيهنّ

168
00:10:00,910 --> 00:10:02,030
.هيّا، أجيبيني

169
00:10:02,030 --> 00:10:03,920
.لا-لا أدري

170
00:10:04,970 --> 00:10:06,440
.لا يهمّ

171
00:10:06,440 --> 00:10:08,740
.توقّعتُ الأمر

172
00:10:09,570 --> 00:10:11,300
،واثقة أنّك تعرفين سلفًا

173
00:10:11,300 --> 00:10:15,210
لكنّ جميع من في القرية يعرفون
.كيفية استعمال مهارات النّينجا الأساسيّة

174
00:10:15,530 --> 00:10:18,610
ولكن كما هو حال قدرتك
،على تحويل الأشياء لأوراق شجر

175
00:10:18,610 --> 00:10:22,230
فإنّ النّينجتسو الّذي يولد به
.النّاس يتغيّر من شخص لآخر

176
00:10:22,230 --> 00:10:25,730
وكانت النّينجا الّتي تستعمل تقنية
مشابهة لك في الماضي

177
00:10:25,730 --> 00:10:28,800
قادرة على تفكيك أيّ غرض
تحوّل إلى أوراق شجر

178
00:10:28,800 --> 00:10:32,240
.وإعادة تشكيله كجسم سليم

179
00:10:32,740 --> 00:10:37,020
،إن كنت تجهلين كيف تعيدينهنّ لطبيعتهنّ

180
00:10:37,020 --> 00:10:40,690
.بإمكاني إعادتك للقرية وتدريبك حتّى تتعلّمي

181
00:10:41,160 --> 00:10:44,600
.وبالطّبع، سأقتلك بعد ذلك

182
00:10:47,250 --> 00:10:52,000
هنالك نينجا بإمكانهم إعادة
.إحياء الموتى في القرية

183
00:10:52,320 --> 00:10:56,750
ما زال باستطاعة أختي الكبيرة
.والبقيّة أن يعدن للحياة

184
00:10:57,200 --> 00:10:59,780
أتقولين أنّك كنت تخطّطين لشيء كهذا؟

185
00:11:02,270 --> 00:11:03,900
.كونوها-سان

186
00:11:03,900 --> 00:11:06,100
.تركتك تخرجين وحدك عن طريق الخطأ ثانية

187
00:11:06,100 --> 00:11:07,240
هل أنت بخير؟

188
00:11:07,240 --> 00:11:08,640
...أنا بخير

189
00:11:09,310 --> 00:11:12,070
...لكنّي ما زلت عاجزة عن الحركة

190
00:11:12,070 --> 00:11:13,530
.أعطيني ساقك

191
00:11:13,530 --> 00:11:16,830
.لم أدري أنّ بإمكانك القلق يا كونوها-سان

192
00:11:16,830 --> 00:11:18,040
.بالطّبع بإمكاني

193
00:11:18,610 --> 00:11:20,920
.أنت زميلتي العزيزة

194
00:11:23,280 --> 00:11:26,650
هل بإمكان النّينجتسو خاصّتك
القيام بأمور مذهلة كهذه بالفعل؟

195
00:11:26,650 --> 00:11:29,250
.أقصد إعادة من حوّلتِ إلى طبيعتهم

196
00:11:29,250 --> 00:11:30,820
.لا أدري

197
00:11:31,290 --> 00:11:34,550
.لم أكن أعير الانتباه في الفصول

198
00:11:34,550 --> 00:11:35,600
.فهمت

199
00:11:36,050 --> 00:11:39,500
قد يكون ذلك مفيدًا إن تعلّمتِ
.كيف تقومين به

200
00:11:39,500 --> 00:11:42,450
حسنًا، حوّلي هذه إلى أوراق شجر
.الآن واهربي بسرعة

201
00:11:42,800 --> 00:11:44,370
...مهلاً

202
00:11:44,370 --> 00:11:46,750
.هناك احتمال عودتهنّ للحياة ثانية

203
00:11:49,400 --> 00:11:50,310
...في تلك الحالة

204
00:11:50,670 --> 00:11:52,080
.لنحرقهنّ

205
00:11:56,120 --> 00:11:57,380
.حسنًا

206
00:11:57,380 --> 00:11:58,830
.مرحبًا بكما

207
00:11:58,830 --> 00:12:01,360
.إنّهما ساتوكو-تشان والقاتلة-تشان

208
00:12:01,360 --> 00:12:03,820
.لا تناديني بالقاتلة-تشان لو سمحت

209
00:12:03,820 --> 00:12:05,670
ما الّذي حدث لك يا ساتوكو-تشان؟

210
00:12:05,670 --> 00:12:07,250
.لقد تأذّت بعض الشّيء

211
00:12:07,830 --> 00:12:09,320
.لكنّ ذلك ليس المهمّ الآن

212
00:12:09,790 --> 00:12:13,340
.قيل لي أنّها في رعايتك، لذلك أحضرتُ شيئًا

213
00:12:13,340 --> 00:12:15,160
!بطاطس حلوة مشويّة

214
00:12:15,160 --> 00:12:18,100
.إذًا فأنت قادرة على مثل هذه التّصرّفات

215
00:12:18,100 --> 00:12:20,100
.طبخنا الكثير منها

216
00:12:20,100 --> 00:12:22,960
.شكرًا لك. أحبّ البطاطس الحلوة المشويّة

217
00:12:22,960 --> 00:12:25,090
ما هذا يا ساتوكو؟

218
00:12:25,090 --> 00:12:27,090
.يبدو أنّكما تنسجمان معًا

219
00:12:27,090 --> 00:12:29,990
.كونوها-سان! أنزليني رجاءً

220
00:12:29,990 --> 00:12:32,820
!هذا محرج

221
00:12:33,700 --> 00:12:34,760
.نينجا وقاتلة

222
00:12:37,010 --> 00:12:37,970
.نينجا وقاتلة

223
00:12:39,480 --> 00:12:41,070
.لقد عدت

224
00:12:49,110 --> 00:12:50,110
ماذا؟

225
00:12:55,930 --> 00:12:57,080
ما هذا؟

226
00:12:57,080 --> 00:12:59,560
.مرحبًا بعودتك

227
00:13:00,130 --> 00:13:02,270
لا، ما هذا؟

228
00:13:02,620 --> 00:13:04,090
.لا يوجد شيء هنا

229
00:13:04,450 --> 00:13:07,500
أتذكرين ما قالته تلك النّينجا يومها؟

230
00:13:07,500 --> 00:13:12,270
قد أمتلك القدرة على إعادة أيّ شيء
...حوّلته لأوراق شجر إلى طبيعته

231
00:13:12,810 --> 00:13:14,760
ماذا؟ لماذا؟

232
00:13:15,040 --> 00:13:17,880
لماذا قد تفعلين ذلك لأثاثي
رغم أنّك تعجزين عن ذلك؟

233
00:13:19,310 --> 00:13:23,270
.لهذا السّبب طُردتِ وأتيت إلينا إذًا

234
00:13:23,270 --> 00:13:26,070
.لا. بل هربتُ من المنزل

235
00:13:26,070 --> 00:13:28,940
كنتُ أتدرّب من أجل صالح
...كونوها-سان ومع ذلك

236
00:13:28,940 --> 00:13:31,860
.الخطأ خطؤك هذه المرّة

237
00:13:32,820 --> 00:13:37,100
أعترف أنّني أشعر بالذّنب لتحويل
...أثاثها إلى أوراق من دون إذن

238
00:13:37,100 --> 00:13:39,960
.لا بأس. تكون الصّراعات ضروريّة أحيانًا

239
00:13:40,460 --> 00:13:43,100
.لا سيّما من أجل أن نحيا معًا بسلام

240
00:13:43,670 --> 00:13:46,260
.بإمكانك البقاء معنا حتّى تهدأ الأمور

241
00:13:46,260 --> 00:13:47,720
.مرحى

242
00:13:46,870 --> 00:13:48,670
!مستحيل

243
00:13:57,380 --> 00:14:00,920
.حلّ الصباح يا كورو-تشان وساتوكو-تشان

244
00:14:01,410 --> 00:14:02,770
.حسنًا

245
00:14:02,770 --> 00:14:04,240
هل نمتِ جيّدًا؟

246
00:14:04,240 --> 00:14:07,440
!نعم! نمتُ بشكل أفضل من المعتاد

247
00:14:07,440 --> 00:14:10,920
.ربّما ذلك لأنّك تنامين في المطبخ عادة

248
00:14:10,920 --> 00:14:12,120
!يوري

249
00:14:13,160 --> 00:14:15,140
ماذا على الفطور؟

250
00:14:15,140 --> 00:14:17,070
ماذا في رأيك؟

251
00:14:18,040 --> 00:14:19,920
.إنّه طعامك المفضّل يا كورو-تشان

252
00:14:20,670 --> 00:14:22,470
عجّة البيض؟

253
00:14:23,010 --> 00:14:24,180
.أصبتِ

254
00:14:24,180 --> 00:14:25,800
.يا لسعادتي

255
00:14:30,450 --> 00:14:33,810
.أحبّك يا يوري

256
00:14:33,810 --> 00:14:35,490
.يكفي يا كورو-تشان

257
00:14:35,490 --> 00:14:37,610
.ساتوكو-تشان معنا

258
00:14:38,350 --> 00:14:41,200
!مهلاً! لقد كانت تنظر إلينا بالفعل

259
00:14:41,200 --> 00:14:42,190
!لقد نسيت

260
00:14:42,190 --> 00:14:44,200
ماذا؟ هل ذلك ممكن؟

261
00:14:46,190 --> 00:14:48,230
...افتحي

262
00:14:50,440 --> 00:14:52,900
.حسنًا، أنا ذاهبة للعمل الآن

263
00:14:52,900 --> 00:14:54,700
.انتظري يا يوري

264
00:14:54,700 --> 00:14:56,930
.صحيح، لقد نسيت

265
00:14:58,370 --> 00:15:01,460
.تفضّلي. حظًّا سعيدًا في البحث عن العمل

266
00:15:01,460 --> 00:15:02,940
...شكرًا يا يوري

267
00:15:02,940 --> 00:15:04,840
.ساتوكو-تشان

268
00:15:04,840 --> 00:15:07,510
هلاّ ساعدتِ في إخراج القمامة؟

269
00:15:07,510 --> 00:15:08,720
!حسنًا، أكيد

270
00:15:08,720 --> 00:15:10,110
.بإمكاني فعل ذلك

271
00:15:10,110 --> 00:15:13,220
.لا حاجة لذلك
.أفضّل أن تفعلها ساتوكو-تشان

272
00:15:14,420 --> 00:15:17,410
.ساتوكو-تشان، لديّ خدمة أطلبها منك

273
00:15:17,410 --> 00:15:18,840
أكيد! ما هي؟

274
00:15:18,840 --> 00:15:23,610
هل يمكنك أن تتحقّقي ماذا تفعله
كورو-تشان بينما أنا في العمل؟

275
00:15:23,610 --> 00:15:24,950
القائدة؟

276
00:15:24,950 --> 00:15:26,070
.نعم

277
00:15:26,600 --> 00:15:28,100
.أنا قلقة بعض الشّيء

278
00:15:28,100 --> 00:15:30,940
...يسهل إغراء كورو-تشان

279
00:15:31,360 --> 00:15:33,250
.فهمت

280
00:15:33,540 --> 00:15:34,860
!سأبذل جهدي

281
00:15:39,880 --> 00:15:42,120
.انتهيت

282
00:15:42,120 --> 00:15:46,160
استطعتُ إنهاء واجبات المنزل باكرًا
.بفضل مساعدتك يا ساتوكو

283
00:15:46,810 --> 00:15:48,120
!يمكنك الاعتماد عليّ

284
00:15:48,770 --> 00:15:49,700
.أكيد

285
00:15:51,720 --> 00:15:55,740
.حسنًا. سأخرج لأبدأ بالبحث عن عمل

286
00:15:55,740 --> 00:15:57,650
.لكن لا تتبعيني يا ساتوكو

287
00:16:01,510 --> 00:16:04,020
.حسنًا! مفهوم

288
00:16:14,700 --> 00:16:17,420
هل تنوي على الخيانة؟

289
00:16:33,460 --> 00:16:35,680
.لقد دخلت مكانًا ما

290
00:16:43,050 --> 00:16:45,140
كيف سار الأمر يا ساتوكو-تشان؟

291
00:16:45,670 --> 00:16:48,640
هل ذهبت كورو-تشان إلى صالة باتشينكو؟

292
00:16:48,640 --> 00:16:50,130
!نعم، ذلك صحيح

293
00:16:50,130 --> 00:16:51,540
!كان مكانًا صاخبًا جدًّا

294
00:16:51,540 --> 00:16:53,330
!أخبرتك ألاّ تخبريها

295
00:16:54,230 --> 00:16:57,660
...وعَدتِ ألاّ تذهبي ثانية

296
00:16:57,660 --> 00:16:59,600
...حتّى أنّك كذبت عليّ

297
00:16:58,780 --> 00:17:00,160
!أسأت فهم الأمر

298
00:17:01,970 --> 00:17:03,400
كيف أسأت الفهم؟

299
00:17:03,400 --> 00:17:04,870
...لا، أعني

300
00:17:04,870 --> 00:17:07,670
.لم توجد أيّ وسائل ترفيه في القرية

301
00:17:07,670 --> 00:17:10,660
.مقارنة بذلك، توجد الكثير من الأشياء هنا

302
00:17:10,920 --> 00:17:14,080
لم أعرف أنّه توجد كلّ هذه
.الأشياء الممتعة في العالم

303
00:17:14,080 --> 00:17:18,510
هل كان ذلك المكان الصّاخب الذّي كنتِ
فيه هو نفسه الّذي رأينا فيه ذلك الرّجل؟

304
00:17:18,510 --> 00:17:19,570
!ماذا تقصدين؟

305
00:17:19,570 --> 00:17:21,010
!أيعقل أنّك... تخونينني؟

306
00:17:21,010 --> 00:17:21,410
ماذا؟

307
00:17:21,410 --> 00:17:23,280
...كنتُ أسأله عن الأحصنة فحسب

308
00:17:23,280 --> 00:17:24,000
أحصنة؟

309
00:17:24,000 --> 00:17:27,950
لا تقولي لي أنك تراهنين على سباقات
!الأحصنة أيضًا إلى جانب الباتشينكو؟

310
00:17:28,180 --> 00:17:29,680
ماذا عنك؟

311
00:17:29,680 --> 00:17:32,190
!استعملتِ ساتوكو لمراقبتي

312
00:17:32,190 --> 00:17:34,760
!أنت لست أفضل منّي يا كورو-تشان
!دفعتِ لها لكي تظلّ صامتة

313
00:17:34,760 --> 00:17:36,080
...ذلك

314
00:17:35,150 --> 00:17:36,480
...هذا غير مريح

315
00:17:36,080 --> 00:17:38,710
!أنت غبيّة! غبيّة

316
00:17:36,490 --> 00:17:38,710
!على أيّ حال، ثقي بي أكثر رجاءً

317
00:17:44,040 --> 00:17:45,720
ماذا الآن؟

318
00:17:45,720 --> 00:17:47,840
...صحيح. هذا النّمط

319
00:17:47,840 --> 00:17:49,500
!مطارِدة نينجا

320
00:17:50,970 --> 00:17:53,170
...وجدتك أخيرًا

321
00:17:53,170 --> 00:17:54,120
!أيّتها القائدة

322
00:17:54,120 --> 00:17:55,040
ماذا؟ أنا؟

323
00:17:55,740 --> 00:17:56,540
!ارتحت

324
00:18:01,060 --> 00:18:05,050
كيف أمكنك القيام بأمر فظيع
!كهذا بينما تملكين شخصًا مثلي؟

325
00:18:05,050 --> 00:18:05,850
ماذا؟

326
00:18:05,850 --> 00:18:09,310
!تركتُ القرية لأنّك قلت أنّك ستتركينها

327
00:18:09,310 --> 00:18:11,060
!أنت... سايوري

328
00:18:11,060 --> 00:18:12,950
!أنا أياكا

329
00:18:12,950 --> 00:18:15,760
هل نسيتِ اسمي؟

330
00:18:15,760 --> 00:18:16,880
...آسفة

331
00:18:16,880 --> 00:18:21,100
حتّى أنّك تعيشين مع هذه
...المرأة من العامّة

332
00:18:21,100 --> 00:18:22,460
!هذا أمر غير مسبوق

333
00:18:22,830 --> 00:18:25,520
لقد خُدعتِ، صحيح؟

334
00:18:25,520 --> 00:18:29,780
!سأنقذك الآن

335
00:18:30,230 --> 00:18:30,760
!مهلاً

336
00:18:30,760 --> 00:18:34,340
!موتي

337
00:18:40,240 --> 00:18:43,010
.كان ذلك وشيكًا

338
00:18:43,010 --> 00:18:44,180
!كونوها-سان

339
00:18:44,180 --> 00:18:46,390
لماذا تكبّدتِ عناء حمايتها؟

340
00:18:46,390 --> 00:18:48,300
...لأنّ

341
00:18:48,300 --> 00:18:50,210
.شكرًا يا ساتوكو-تشان

342
00:18:50,210 --> 00:18:52,670
.حميتني بوضع نفسك في خطر

343
00:18:52,670 --> 00:18:55,770
.كلاّ. بل كونوها-سان هي من أنقذتنا

344
00:18:55,770 --> 00:18:56,730
...إضافة لذلك

345
00:18:56,730 --> 00:18:57,400
!يوري

346
00:18:59,730 --> 00:19:02,160
.شكرًا أيّتها القاتلة-تشان

347
00:19:02,160 --> 00:19:06,160
ما كنتُ لأساعدك لو لم تقم
.ساتوكو-تشان بحمايتك

348
00:19:06,160 --> 00:19:07,030
ماذا؟

349
00:19:07,030 --> 00:19:10,720
أيعني ذلك أنّك أردتِ أن أموت؟

350
00:19:10,720 --> 00:19:12,040
.مخيفة

351
00:19:12,040 --> 00:19:14,690
...يا ساتوكو، ذلك

352
00:19:15,940 --> 00:19:20,090
كفاءتكما لا تصدّق، لم أستطع
...إيقافك عن تحويلها لأوراق شجر

353
00:19:20,460 --> 00:19:23,680
.لكنّها كانت زميلة غادرت القرية معنا

354
00:19:20,460 --> 00:19:23,680
هل هي حبيبتك السّابقة؟

355
00:19:23,960 --> 00:19:24,870
...هكذا

356
00:19:24,870 --> 00:19:26,860
.كانت تتصرّف بشكل مفرط قليلاً

357
00:19:26,860 --> 00:19:28,230
أليس هناك أيّ شيء يمكنك فعله؟

358
00:19:28,230 --> 00:19:29,970
...فهمت

359
00:19:29,970 --> 00:19:33,520
سأستعملها لتدريب إعادة
!الإحياء بدل حرقها إذًا

360
00:19:33,520 --> 00:19:35,530
...استعمالها" لا يبدو أخلاقيًّا"

361
00:19:37,030 --> 00:19:40,100
.حسنًا، لنذهب للمنزل يا ساتوكو-تشان

362
00:19:40,100 --> 00:19:42,860
...ماذا؟ لكنّي هربت من المنزل

363
00:19:42,860 --> 00:19:44,880
.اذهبي للمنزل يا ساتوكو

364
00:19:45,600 --> 00:19:47,370
ألا تفهمين؟

365
00:19:47,370 --> 00:19:52,290
أتت لمساعدتك في لمح البصر لأنّك
.وضعت نفس في خطر من أجل يوري

366
00:19:54,120 --> 00:20:00,720
ربّما كانت تراقبك لتتأكّد من
.أنّك لن تتعرّضين للخطر

367
00:20:02,640 --> 00:20:05,640
.إنّها تقلق عليك يا ساتوكو

368
00:20:07,830 --> 00:20:10,280
.هيّا. لنسرع بالعودة للمنزل

369
00:20:14,890 --> 00:20:16,150
...كونوها-سان

370
00:20:16,520 --> 00:20:18,170
.أنا آسفة بشأن ذلك

371
00:20:18,170 --> 00:20:19,400
.لا تقلقي حيال الأمر

372
00:20:19,690 --> 00:20:22,480
...وبشأن محادثتنا من قبل

373
00:20:22,480 --> 00:20:23,820
من قبل؟

374
00:20:24,200 --> 00:20:25,250
...عفوًا

375
00:20:25,250 --> 00:20:27,570
.بشأن حماية حبيبة القائدة

376
00:20:27,570 --> 00:20:28,460
ماذا؟

377
00:20:28,460 --> 00:20:32,590
.في الحقيقة، تعثّرتُ أمامها فحسب

378
00:20:33,410 --> 00:20:35,190
.كلاّ

379
00:20:37,020 --> 00:20:38,830
ماذا؟ هل ضحكتِ للتّوّ؟

380
00:20:38,830 --> 00:20:39,640
.لا

381
00:20:39,640 --> 00:20:41,430
.بل ضحكتِ بالفعل

382
00:20:41,430 --> 00:20:43,310
.يكفي. لنعد للمنزل

383
00:20:43,680 --> 00:20:45,290
.إلى منزلنا الفارغ

384
00:20:45,290 --> 00:20:47,290
ألم تشترِ أيّ أثاث؟

385
00:20:50,460 --> 00:20:52,180
.وجدتك

386
00:20:54,340 --> 00:20:56,610
.القاتلة نظّارات

387
00:22:27,780 --> 00:22:30,050
.خرج هذا عن السّيطرة

388
00:22:30,050 --> 00:22:33,490
ماذا علينا إخبار الشّرطة؟

389
00:22:33,490 --> 00:22:36,240
.أعتقد أنّ علينا الانتقال

390
00:22:36,240 --> 00:22:38,000
...لكنّنا سنحتاج للمال

391
00:22:39,120 --> 00:22:40,440
...ذلك صحيح

392
00:22:40,440 --> 00:22:43,010
لا يمكنك الذّهاب للباتشينكو
.أو سباقات الأحصنة بعد الآن أيضًا

393
00:22:43,010 --> 00:22:44,530
.سبق واعتذرت

394
00:22:46,400 --> 00:22:48,520
.لا تقومي بذلك ثانية

395
00:22:48,520 --> 00:22:51,220
في المرّة القادمة، سأجعلك
.تدفعين لقاء كلّ شيء

396
00:22:51,220 --> 00:22:52,100
...حاضرة

397
00:22:52,400 --> 00:22:55,900
.لا يوجد ما يمكن فعله، لذلك لنخلد للنّوم

398
00:23:01,430 --> 00:23:02,520
.ساتوكو-تشان

399
00:23:03,760 --> 00:23:05,130
أتريدين النّوم قربي؟

400
00:23:05,130 --> 00:23:07,470
!ماذا؟ أيمكنني ذلك؟

401
00:23:07,470 --> 00:23:09,630
.إنّ هذه الغرفة باردة

402
00:23:09,630 --> 00:23:12,540
...ليست جهاز التّكييف ما زال موجودًا

403
00:23:12,540 --> 00:23:13,950
...آسفة

404
00:23:13,950 --> 00:23:16,160
...حوّلتُ كلّ شيء لأوراق شجر

405
00:23:20,030 --> 00:23:21,240
.تصبحين على خير

406
00:23:21,240 --> 00:23:24,540
.نعم. تصبحين على خير يا كونوها-سان

407
00:23:30,390 --> 00:23:32,190
.أنت قويّة جدًّا يا كونوها-سان

408
00:23:32,190 --> 00:23:35,740
بإمكانك حملي بسهولة. أيمكنني المحاولة أيضًا؟

409
00:23:36,480 --> 00:23:37,380
.مستحيل

410
00:23:37,380 --> 00:23:38,520
.أنت ثقيلة يا كونوها-سان

411
00:23:38,520 --> 00:23:39,740
.أغضبني ذلك