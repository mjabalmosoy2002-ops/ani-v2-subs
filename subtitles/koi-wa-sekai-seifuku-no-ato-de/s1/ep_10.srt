لطيفة وطويلة معي؟

200
00:13:44,920 --> 00:13:47,380
أوقفيني إذا كنتِ تعتقدين بأنّكِ تستطيعين

201
00:13:49,050 --> 00:13:50,800
فتاة شقيّة

202
00:13:59,600 --> 00:14:03,860
يا للهول! أنتِ قويّة جدّاً، أليس كذلك؟

203
00:14:04,980 --> 00:14:07,820
!هذا لأنّني جزء من سلسلة الأميرة

204
00:14:09,010 --> 00:14:10,300
انفجار؟

205
00:14:10,300 --> 00:14:11,780
حدث من نوع ما؟

206
00:14:12,910 --> 00:14:15,840
أكسبني ذلك قليلاً من الوقت على الأقلّ

207
00:14:15,840 --> 00:14:17,420
!ظريف للغاية

208
00:14:18,330 --> 00:14:20,040
أليس هما ريد وبلو؟

209
00:14:20,040 --> 00:14:21,790
ماذا يفعلان؟

210
00:14:21,790 --> 00:14:22,790
ريد؟

211
00:14:22,790 --> 00:14:23,870
!فتى مُطيع

212
00:14:23,870 --> 00:14:25,540
!اركض، اركض

213
00:14:26,180 --> 00:14:27,990
ماذا يحدث هناك بالضبط؟

214
00:14:29,060 --> 00:14:30,220
!ديسومي-سان

215
00:14:30,220 --> 00:14:31,730
!وسيم

216
00:14:30,950 --> 00:14:32,310
فودو؟

217
00:14:33,000 --> 00:14:34,510
مرحباً يا ديسومي

218
00:14:35,010 --> 00:14:35,780
كيكي؟

219
00:14:35,780 --> 00:14:37,070
ليس لديكِ ما تفعلينه، صحيح؟

220
00:14:37,070 --> 00:14:39,730
تعالي وساعديني في البحث عن أزواج

221
00:14:39,730 --> 00:14:42,830
لم تدرك بأنّني كنتُ أنا في البيت المسكون؟

222
00:14:42,830 --> 00:14:44,260
هذا مُطمئن

223
00:14:44,730 --> 00:14:47,870
...فـ-في الواقع، لديّ بعض المخطّطات

224
00:14:47,870 --> 00:14:49,400
لكن وصلنا للنهائي

225
00:14:49,400 --> 00:14:51,230
ما المخطّطات التي لديكِ؟

226
00:14:51,750 --> 00:14:53,120
...انتظري لحظة

227
00:14:53,120 --> 00:14:57,610
ذكرتِ بأنّكِ مهتمّة بالعلاقات العاطفيّة في تلك المرّة

228
00:14:58,370 --> 00:15:00,970
!لا تقولي لي بأنّ لديكِ حبيب أيضاً

229
00:15:00,970 --> 00:15:02,600
!انتظري! اهدئي

230
00:15:03,590 --> 00:15:04,580
...ارتعاش

231
00:15:06,310 --> 00:15:08,190
...هـ-هذه الهالة المُخيفة

232
00:15:14,780 --> 00:15:16,850
التقينا ثانية

233
00:15:16,850 --> 00:15:19,350
...إ-إنّه

234
00:15:16,850 --> 00:15:20,060
التقينا من جديد. التقينا من جديد. التقينا من جديد

235
00:15:22,630 --> 00:15:24,560
!لم أركِ منذ الشاطئ

236
00:15:25,050 --> 00:15:27,160
!هاياتو

237
00:15:31,460 --> 00:15:32,410
!فودو

238
00:15:33,160 --> 00:15:34,370
!هذه فرصتنا

239
00:15:34,370 --> 00:15:35,830
!أ-أجل

240
00:15:51,780 --> 00:15:53,220
!الوقت يداهمنا

241
00:15:53,220 --> 00:15:54,500
أعلم ذلك

242
00:15:54,500 --> 00:15:57,720
...لكن جميعهم يعرفونك

243
00:15:57,720 --> 00:16:00,260
وعضوات سلسلة الأميرة جميعهن حولنا

244
00:16:12,910 --> 00:16:18,710
اختراق الازدحام والجلوس هناك
...دون أن يرانا أحد

245
00:16:21,160 --> 00:16:23,550
!نفدت أفكاري

246
00:16:25,050 --> 00:16:26,680
من أنت بالضبط؟

247
00:16:28,070 --> 00:16:30,110
!ظننتُك دبّ-ساما

248
00:16:30,110 --> 00:16:32,920
!مهلاً! أنتِ من تمسّك بي

249
00:16:32,920 --> 00:16:35,710
!ماذا تحاول أن تفعل بهذا الزيّ المُفصّل تفصيلاً؟

250
00:16:35,710 --> 00:16:37,980
!أحبّ الدببة فحسب، مفهوم؟

251
00:16:37,980 --> 00:16:40,570
!إذاً أين دبّ-ساما الحقيقيّ؟

252
00:16:40,570 --> 00:16:42,200
!وما أدراني؟

253
00:16:42,200 --> 00:16:43,250
!يا إلهي

254
00:16:43,250 --> 00:16:45,140
!الأزواج يشوّشون الأمور

255
00:16:47,650 --> 00:16:49,020
!فودو! ما زالت لدينا فرصة

256
00:16:49,020 --> 00:16:50,860
!لا يمكننا الاستسلام بعد

257
00:16:50,860 --> 00:16:52,190
ديسومي-سان؟

258
00:17:02,450 --> 00:17:04,960
هـ-هل أنتِ متأكّدة بأنّنا يمكننا فعلها؟

259
00:17:04,960 --> 00:17:07,000
أجل، أنا متأكّدة من قدرتنا على ذلك

260
00:17:07,000 --> 00:17:08,710
!لا شيء نعجز عن فعله

261
00:17:09,180 --> 00:17:10,090
صحيح؟

262
00:17:11,400 --> 00:17:12,270
بالفعل

263
00:17:13,720 --> 00:17:14,940
،معكِ حقّ

264
00:17:15,930 --> 00:17:17,080
!يا ديسومي-سان

265
00:17:22,380 --> 00:17:23,680
!تغيير التّجميد

266
00:17:26,170 --> 00:17:28,150
!رحّب بالشرّ! عاقب الخير

267
00:17:29,320 --> 00:17:34,670
!واحد! تغيير جيلاتو

268
00:17:36,470 --> 00:17:38,160
!تغيير حاصدة الأرواح

269
00:18:01,380 --> 00:18:03,520
!هيّا بنا يا ديسومي-سان

270
00:18:03,900 --> 00:18:05,500
!أجل يا فودو

271
00:18:06,270 --> 00:18:07,890
بقي زوجان فقط؟

272
00:18:08,490 --> 00:18:10,230
!انظر هناك

273
00:18:12,520 --> 00:18:13,660
!هذا رائع للغاية

274
00:18:13,660 --> 00:18:15,330
!ذوق رفيع

275
00:18:15,900 --> 00:18:18,400
!جودة عالية أيضاً

276
00:18:18,650 --> 00:18:20,720
لكنّه خيال المُعجبين

277
00:18:20,720 --> 00:18:21,660
تماماً

278
00:18:21,660 --> 00:18:25,320
ريد جيلاتو والأميرة حاصدة الأرواح منسجمان معاً؟

279
00:18:54,980 --> 00:18:57,130
،عندما نعمل أنا وأنتِ

280
00:18:57,130 --> 00:18:59,700
لا شيء نعجز عن تحقيقه

281
00:18:59,700 --> 00:19:03,700
أجل. لأنّنا الزوجان اللّذان لا يُقهَران

282
00:19:05,170 --> 00:19:08,160
ربّما اليوم الّذي يمكننا فيه رؤية بعضنا
الآخر برأس مرفوع

283
00:19:08,160 --> 00:19:11,600
ليس ببعيد في نهاية المطاف يا فودو

284
00:19:11,600 --> 00:19:13,710
أجل، بالفعل يا ديسومي-سان

285
00:19:15,150 --> 00:19:20,140
وحتّى يأتي ذلك اليوم، سوف أستمتع
!بهذا السرّ الصّغير

286
00:19:21,460 --> 00:19:22,250
أجل

287
00:21:19,230 --> 00:21:20,670
هل سمعت؟

288
00:21:20,910 --> 00:21:25,430
!الدبّ الكالفاري وفولاذيّة-تشان يتواعدان

289
00:21:25,430 --> 00:21:28,170
مهلاً، بجدّية؟

290
00:21:28,170 --> 00:21:30,390
!لكن كان ينتابني إحساس بذلك

291
00:21:30,650 --> 00:21:35,120
سمعتُ بأنّهما كانا معاً في مهرجان
الثانويّة الثّقافي

292
00:21:35,120 --> 00:21:37,180
!أهداف حُبّ الشّباب

293
00:21:37,180 --> 00:21:40,400
!موعد في مهرجان ثقافي هو هدف حُبّ الشّباب حقّاً

294
00:21:39,500 --> 00:21:40,730
أليس كذلك؟

295
00:21:40,730 --> 00:21:42,830
لكن العلاقات العاطفيّة داخل الشّركات منافٍ للقوانين

296
00:21:42,830 --> 00:21:46,910
لذا يبدو أنّ مُمارستها غير مناسبة بعض الشيء

297
00:21:46,910 --> 00:21:50,050
!لكن هذا ما يجعلها جميلة وممتعة

298
00:21:50,050 --> 00:21:51,160
...مهلاً

299
00:21:51,430 --> 00:21:55,010
لو أردتِ مواعدة أحد، فمن تختارين؟
نسر البندقيّة الفتيليّة؟

300
00:21:55,010 --> 00:21:56,290
!لا

301
00:21:56,290 --> 00:21:58,790
إنّه مُبجّل زيادة عن اللّزوم

302
00:21:58,790 --> 00:22:01,910
ماذا عن أسد المدفع الطويل إذاً؟

303
00:22:01,910 --> 00:22:02,980
...لا أعتقد ذلك

304
00:22:02,980 --> 00:22:05,510
لا أتحمّل أنواع "أورا-أورا" تلك

305
00:22:05,510 --> 00:22:06,630
!مثلكِ

306
00:22:06,630 --> 00:22:08,550
ذئب الرشّاش السّريع إذاً؟

307
00:22:08,550 --> 00:22:11,160
إنّه عصبيّ جدّاً ونيّق

308
00:22:11,160 --> 00:22:12,760
لا أظنّني أستطيع مواعدته أبداً

309
00:22:16,600 --> 00:22:19,190
من الصّعب إيجاد رجل جيّد، أليس كذلك؟

310
00:22:19,190 --> 00:22:20,910
!أجل، وهذا أمر جنونيّ

311
00:22:20,910 --> 00:22:24,580
!لا أصدّق بأنّ فولاذيّة معجبة بالدبّ الكالفاري

312
00:22:24,580 --> 00:22:27,170
لكنّها لا تزال صغيرة

313
00:22:27,170 --> 00:22:30,170
!ربّما تميل لمعانقة الأشياء فحسب

314
00:22:30,170 --> 00:22:33,690
أشكّ في أنّ هناك أيّ عضوة أخرى من سلسلة
!الأميرة تمارس العلاقات العاطفيّة

315
00:22:33,690 --> 00:22:35,290
ماذا عن حاصدة-تشان؟

316
00:22:42,290 --> 00:22:45,100
حاصدة؟ مستحيل

317
00:22:45,100 --> 00:22:46,010
أتعتقدين ذلك؟

318
00:22:46,010 --> 00:22:46,590
!قطعاً لا

319
00:22:46,590 --> 00:22:48,090
أجل، معكِ حقّ

320
00:22:50,490 --> 00:22:51,760
!عُدت

321
00:22:52,080 --> 00:22:53,510
هل كنتِ فتاة مهذّبة؟

322
00:22:54,670 --> 00:22:57,910
عاشت سيّدتي يوماً سعيداً آخر على ما أعتقد

323
00:22:58,490 --> 00:23:00,760
!جاهزة لحمّامي السّاخن

324
00:23:01,980 --> 00:23:05,310
بسبب ذلك الأبله

325
00:23:05,310 --> 00:23:08,490
مع أنّني لا أحبّ الاعتراف بذلك

326
00:23:11,960 --> 00:23:16,940
لكن إذا كانت سيّدتي سعيدة، أظنّني سأسمح بذلك

327
00:23:20,460 --> 00:23:23,210
ما هي العدالة؟ ما هو السّلام؟

328
00:23:23,210 --> 00:23:27,460
!كجليد ساخن جدّاً، يخترق فوضى العصر

329
00:23:27,460 --> 00:23:30,700
!اسمهم، سينتاي جيلاتو 5 المتجمّد

330
00:23:31,470 --> 00:23:32,740
!تابعونا في الأسبوع المقبل

331
00:23:32,740 --> 00:23:35,680
"الحلقة القادمة، الحلقة 11: "ما الغاية من الاقتراب؟

332
00:23:35,680 --> 00:23:37,430
!أيُّها البشر، أبشروا بالحبّ

333
00:23:37,720 --> 00:23:39,890
أهذا ما يحكي عنه هذا البرنامج؟