1
00:01:40,570 --> 00:01:41,990
!ديسومي

2
00:01:42,370 --> 00:01:44,350
!امشي معنا إلى المنزل

3
00:01:45,780 --> 00:01:46,660
!حسناً

4
00:01:47,770 --> 00:01:49,400
!اسمحوا لي أن أشرح

5
00:01:49,400 --> 00:01:52,420
،الأميرة حاصدة الأرواح، ديسومي ماغاهارا

6
00:01:52,650 --> 00:01:56,050
هي فتاة مُراهقة تُخفي هويّتها الشرّيرة

7
00:01:56,050 --> 00:01:58,090
!للحضور إلى المدرسة الثانويّة في المدينة

8
00:02:01,630 --> 00:02:03,060
أليس لديك نادي حِرفيّات يدويّة اليوم يا ديسومي؟

9
00:02:03,710 --> 00:02:05,830
لدينا إجازة للتحضير للاختبار اليوم

10
00:02:05,830 --> 00:02:08,020
ما رأيكِ بالذّهاب للغناء في الكاراوكي إذاً؟

11
00:02:08,300 --> 00:02:10,630
آسفة، لديّ عمل اليوم

12
00:02:10,630 --> 00:02:12,280
من جديد؟

13
00:02:12,280 --> 00:02:14,190
أنتِ مُدمنة على العمل يا ديسومي

14
00:02:14,930 --> 00:02:19,110
!لن تحصلي على حبيب هكذا

15
00:02:19,110 --> 00:02:23,940
...حبيب

16
00:02:23,940 --> 00:02:25,830
!سنرى

17
00:02:27,170 --> 00:02:29,630
ما هذا الكلام فجأة؟

18
00:02:29,630 --> 00:02:32,210
هل حاز شخص على إعجابكِ؟

19
00:02:32,210 --> 00:02:33,700
!لن أخبركِ

20
00:02:33,700 --> 00:02:35,590
!إنّه ريد جيلاتو

21
00:02:36,670 --> 00:02:37,990
!فودو

22
00:02:39,910 --> 00:02:42,180
فـ-فودو؟

23
00:02:43,660 --> 00:02:44,890
فودو؟

24
00:02:46,770 --> 00:02:49,310
!فودو؟

25
00:02:50,170 --> 00:02:52,340
...أ-أليست هذه

26
00:02:53,070 --> 00:02:55,800
أليست هذه الّتي معه هي بينك الجديدة؟

27
00:02:55,800 --> 00:02:58,070
!أجل! إنّها ظريفة جدّاً

28
00:02:58,650 --> 00:03:01,150
هل يتواعدان أو ما شابه يا تُرى؟

29
00:03:01,150 --> 00:03:02,570
!لعلّهما كذلك

30
00:03:02,850 --> 00:03:05,200
يبدوان ملائمين معاً

31
00:03:05,200 --> 00:03:07,740
!تماماً! زوجان مثاليّان

32
00:03:07,740 --> 00:03:08,830
أليس كذلك يا ديسومي؟

33
00:03:09,620 --> 00:03:11,580
!ما مُشكلة وجهكِ؟

34
00:03:13,990 --> 00:03:15,650
!ماذا؟ ديسومي

35
00:03:15,650 --> 00:03:16,710
ديسومي؟

36
00:03:17,020 --> 00:03:21,720
نادراً ما تدْعينني للخروج هكذا يا هارو-كن

37
00:03:21,720 --> 00:03:24,410
أ-أنا آسفة جدّاً يا فودو-سينباي

38
00:03:24,410 --> 00:03:25,890
...أعلم بأنّك مشغول جدّاً

39
00:03:25,890 --> 00:03:27,220
لا مشكلة

40
00:03:27,750 --> 00:03:30,340
حسناً، ما الّذي أردتِ أن تسأليني عنه؟

41
00:03:31,420 --> 00:03:33,550
...فـ-في الواقع

42
00:03:38,680 --> 00:03:42,240
من الوقاحة السّؤال عن هذا، أليس كذلك؟

43
00:03:43,130 --> 00:03:45,990
!لكن لا أستطيع التوقّف عن التّفكير في تلك الصّورة

44
00:03:46,660 --> 00:03:49,660
هل كان ذلك فودو-سينباي حقّاً؟

45
00:03:49,660 --> 00:03:52,250
...إن كان كذلك، فتلك الفتاة التي بجانبه

46
00:03:52,940 --> 00:03:55,630
هل يُعقل أن تكون... حبيبته؟

47
00:03:56,380 --> 00:04:01,980
لكن هل من المناسب حقّاً أن أسأل
!حول حياته الخاصّة؟

48
00:04:04,010 --> 00:04:04,990
فهمت

49
00:04:05,420 --> 00:04:08,530
أظنّني أعلم ما تريدين السّؤال عنه

50
00:04:10,650 --> 00:04:13,380
!أعتقد ينبغي لهذا أن يفي بالغرض

51
00:04:13,380 --> 00:04:14,230
...المعذرة

52
00:04:15,480 --> 00:04:18,230
المعذرة! ما هذا الشيء؟

53
00:04:18,470 --> 00:04:21,660
مضى على وجودكِ مع الفرقة حوالي
ستّة أشهر الآن، أليس كذلك؟

54
00:04:21,660 --> 00:04:23,300
...أ-أجل

55
00:04:23,300 --> 00:04:27,760
ستصطدمين بجدار بتدريب القوّة الخاص
بكِ خلال هذه الفترة

56
00:04:27,760 --> 00:04:28,240
ماذا؟

57
00:04:28,470 --> 00:04:29,910
لا شيء يدعو للقلق

58
00:04:29,910 --> 00:04:31,200
حدث ذات الأمر معي

59
00:04:32,460 --> 00:04:33,710
ماذا؟

60
00:04:34,020 --> 00:04:36,990
من نظام التّدريب هذا على مدى
،الأشهر الستّة المقبلة

61
00:04:36,990 --> 00:04:39,100
ستحصلين على جسد فولاذيّ سيجعلكِ

62
00:04:39,100 --> 00:04:40,440
!تتجاوزين أيّ معركة

63
00:04:39,510 --> 00:04:41,130
!ا-انتظر لحظة يا سينباي

64
00:04:41,130 --> 00:04:44,620
—ما أنا قلقة بشأنه في الواقع هو الصّور

65
00:04:47,570 --> 00:04:49,470
أنتِ كثيرة القلق

66
00:04:50,140 --> 00:04:51,220
!لا تقلقي

67
00:04:51,220 --> 00:04:54,810
يحتوي الكتاب على صور لشرح
!أصعب تمرينات النّظام

68
00:04:55,350 --> 00:04:57,410
وهذا النّوع من تدريب القوّة التزايُديّ

69
00:04:57,410 --> 00:05:00,220
مُصمّم خصّيصاً لتقليص الجهد

70
00:05:00,220 --> 00:05:02,960
ينبغي أن يكون اتّباعه سهلاً حتّى
بالنسبة لشخص صغير الحجم مثلكِ

71
00:05:02,960 --> 00:05:05,820
باعتبار أنّ التّدريب الّذي يُضرّ بجسدكِ
هو تدريب عقيم، أليس كذلك؟

72
00:05:09,660 --> 00:05:12,440
المُخطّط البياني حول هذا الأمر هنا
ينبغي أن يكون سهل الفهم

73
00:05:12,440 --> 00:05:15,830
،وهذا سيساهم في تعزيز مرونة عضلاتك

74
00:05:15,830 --> 00:05:19,030
!بل وحتّى تحفيز التّعافي السّريع من الجروح

75
00:05:19,030 --> 00:05:22,340
،أنا لا أدّعي بأنّكِ سترين نتائج بين ليلة وضُحاها

76
00:05:21,370 --> 00:05:23,620
...الآن أيقنتُ تماماً

77
00:05:22,340 --> 00:05:27,130
لكن يستطيع أيّ شخص الحصول على الجسد
الّذي يريده بالتطبيق الكافي للجهد

78
00:05:24,340 --> 00:05:27,670
!بأنّ سينباي لا يملك حبيبة

79
00:05:27,670 --> 00:05:29,350
لا حاجة للقلق

80
00:05:29,580 --> 00:05:32,970
!عندما تُطلقين نداء الجهد، تستجيب عضلاتكِ دوماً

81
00:05:33,450 --> 00:05:34,350
سيَفي هذا بالغرض

82
00:05:34,570 --> 00:05:37,670
هذا ما أردتِ السّؤال عنه، صحيح؟

83
00:05:37,670 --> 00:05:38,820
!أجل

84
00:05:38,820 --> 00:05:40,360
!شكراً جزيلاً لك

85
00:05:40,970 --> 00:05:43,400
!آسفة لأنّني شككتُ بك يا سينباي

86
00:05:45,700 --> 00:05:46,860
!إنّهم يستدعوننا

87
00:05:47,460 --> 00:05:49,400
!هيّا بنا يا فودو-سينباي

88
00:05:50,300 --> 00:05:52,090
!لا تنسي كتابكِ يا هارو-كن

89
00:05:56,120 --> 00:05:57,920
!ها نحن ذا

90
00:05:57,920 --> 00:06:00,630
!مِدفع كالفارن

91
00:06:07,960 --> 00:06:09,630
!يكفي من هذا يا غيكّو

92
00:06:13,210 --> 00:06:16,640
!وصل سينتاي جيلاتو 5 المُتجمّد

93
00:06:19,480 --> 00:06:22,370
!استهينوا بنا على ألم من النّار

94
00:06:23,650 --> 00:06:26,040
!حان الوقت يا جيلاتو 5

95
00:06:26,040 --> 00:06:28,650
!اليوم هو اليوم الّذي سأزيحكم فيه عن الطريق

96
00:06:28,660 --> 00:06:30,160
!اقضوا عليهم

97
00:06:36,120 --> 00:06:36,950
!هيّا بنا

98
00:06:36,950 --> 00:06:37,860
!حسناً

99
00:06:38,910 --> 00:06:40,210
!حسناً يا ديسومي-سان

100
00:06:40,210 --> 00:06:42,340
—ما سوف نتحادث بشأنه

101
00:06:46,260 --> 00:06:47,310
!ريد

102
00:06:53,350 --> 00:06:55,970
لا بأس. تحدث مثل هذه الأمور

103
00:06:55,970 --> 00:06:58,520
—لننسّق حركاتنا يا ديسومي-سا

104
00:07:06,950 --> 00:07:10,030
سأراوغ هجمتكِ الأولى ثمّ أثِب للخلف

105
00:07:10,320 --> 00:07:11,740
...تجاهل

106
00:07:13,710 --> 00:07:14,790
!هذا مؤلم

107
00:07:17,790 --> 00:07:18,910
ديسومي-سان؟

108
00:07:19,420 --> 00:07:20,180
...ديسو

109
00:07:21,920 --> 00:07:24,130
لـ-لننقل المعركة إلى مكان آخر
!أيّتها الأميرة حاصدة الأرواح

110
00:07:24,130 --> 00:07:24,750
!لا

111
00:07:26,630 --> 00:07:27,750
...خذ هذه

112
00:07:30,030 --> 00:07:32,050
!زوبعة حاصدة الأرواح

113
00:07:33,050 --> 00:07:35,470
!لـ... لم أرَ هذه الحركة من قبل

114
00:07:51,820 --> 00:07:52,900
!ديسومي-سان

115
00:07:57,850 --> 00:08:00,160
رأيتِ؟ لا ينبغي أن تستخدمي حركات
لم تُتقنيها جيّداً بعد

116
00:08:02,580 --> 00:08:04,760
!مـ-مهلاً يا ديسومي-سان

117
00:08:04,760 --> 00:08:06,070
ماذا أصابكِ؟

118
00:08:06,070 --> 00:08:07,670
!أخبريني ما الّذي يجري

119
00:08:07,670 --> 00:08:10,880
!رأيتُكما في المقهى

120
00:08:17,480 --> 00:08:19,080
!ا-الأمر ليس كذلك يا ديسومي-سان

121
00:08:19,080 --> 00:08:19,970
!أسأتِ الفهم

122
00:08:20,770 --> 00:08:23,020
—كنتُ أعلّم بينك بناء الأجسام

123
00:08:23,020 --> 00:08:24,230
!أعلم ذلك

124
00:08:25,110 --> 00:08:30,730
أعلم أكثر من أيّ شخص بأنّك لا يمكن أن تخونني

125
00:08:31,320 --> 00:08:35,630
ومع ذلك، رؤيتكما معاً

126
00:08:36,180 --> 00:08:37,880
أشعل هذه الغيرة القبيحة داخلي

127
00:08:39,250 --> 00:08:41,510
،وجدتُ نفسي أُفكّر

128
00:08:43,450 --> 00:08:45,580
...لعلّك لا تنتمي لمُجرمة فارّة مثلي

129
00:08:45,580 --> 00:08:47,500
!إنّما لأنثى حقيقيّة مثلها

130
00:08:47,720 --> 00:08:49,000
!هذا غير صحيح

131
00:08:49,650 --> 00:08:53,590
!أنتِ أكثر فتاة أنثى أعرفها

132
00:08:53,590 --> 00:08:54,840
!لستُ كذلك

133
00:08:55,080 --> 00:08:58,600
لم أكن يوماً من الأشخاص الحريصين
!في مثل هذه الأمور

134
00:09:03,700 --> 00:09:06,440
!جعلني الحبّ ضعيفة

135
00:09:08,010 --> 00:09:10,450
...المواعدة معك جعلتني

136
00:09:11,360 --> 00:09:17,450
!امرأة ضعيفة ومثيرة للشفقة

137
00:09:17,450 --> 00:09:19,870
!هذا غير صحيح يا ديسومي-سان

138
00:09:28,620 --> 00:09:29,860
...فودو

139
00:09:30,690 --> 00:09:32,550
...الشّخص الّذي أنا عليه

140
00:09:33,820 --> 00:09:35,180
...ربّما أنا لستُ مؤهّلة

141
00:09:36,760 --> 00:09:38,650
للحبّ فحسب

142
00:09:57,790 --> 00:09:59,750
أنا رجل خجول جدّاً

143
00:10:00,230 --> 00:10:01,930
،لكن حالما أقرّر شيئاً

144
00:10:01,930 --> 00:10:04,140
فإنّني أنفّذه على أكمل وجه

145
00:10:05,140 --> 00:10:09,340
سأحبّك ولن أحبّ أحداً آخر طيلة حياتي

146
00:10:13,580 --> 00:10:16,950
هل ستثقين بي وتشاركينني هذا الشّعور؟

147
00:10:21,330 --> 00:10:24,710
أجل، أثق بك

148
00:10:31,560 --> 00:10:33,950
كان ذلك قاسياً

149
00:10:37,530 --> 00:10:39,950
لماذا تضحك فجأة؟

150
00:10:40,520 --> 00:10:43,490
رأيتُ جانباً جديداً كلّياً منكِ

151
00:10:44,030 --> 00:10:46,180
!يمكنكِ أن تكوني سلبيّة بصورة مفاجئة أحياناً

152
00:10:47,000 --> 00:10:52,770
فودو، ما زلتُ لم أسامحك على
موعد ما بعد المدرسة ذاك

153
00:10:52,770 --> 00:10:55,870
فـ-في الواقع، لم يكن ذلك موعداً بالمعنى الحرفيّ

154
00:10:55,870 --> 00:10:57,130
...كان فقط

155
00:10:58,650 --> 00:11:01,180
عِدني بأن تخرج في موعد بعد دوام المدرسة أيضاً

156
00:11:01,180 --> 00:11:02,640
زيّ مدرسيّ وما إلى هنالك

157
00:11:02,640 --> 00:11:04,640
!حينئذ سأسامحك

158
00:11:04,640 --> 00:11:06,950
!حسناً! أعِدُك بأنّني سأفعل

159
00:11:15,180 --> 00:11:16,200
المعذرة

160
00:11:22,200 --> 00:11:25,080
انتهى كلّ شيء يا سينباي

161
00:11:29,290 --> 00:11:30,960
!اسمحوا لي أن أشرح

162
00:11:31,290 --> 00:11:33,230
!افتُضِحَ أمرهما تماماً

163
00:11:35,700 --> 00:11:37,970
!الحبّ بعد الهيمنة على العالم

164
00:11:54,830 --> 00:11:56,310
...فـ-في الواقع

165
00:11:56,970 --> 00:11:58,090
...هذا فقط

166
00:11:59,160 --> 00:12:00,070
هيّا

167
00:12:00,490 --> 00:12:02,220
لنعُد يا سينباي

168
00:12:03,410 --> 00:12:04,820
...حـ-حسناً

169
00:12:15,770 --> 00:12:17,500
هذا غريب

170
00:12:17,880 --> 00:12:19,810
لم تقل شيئاً

171
00:12:20,730 --> 00:12:24,260
هل من الممكن أنّها لم تكشفنا؟

172
00:12:24,260 --> 00:12:26,410
...بـ-بالمناسبة يا هارو-كن

173
00:12:26,750 --> 00:12:30,220
كم سمعتِ من محادثتنا؟

174
00:12:30,590 --> 00:12:33,090
بعد، "رأيتِ؟ لا ينبغي أن تستخدمي حركات
"...لم تُتقنيها جيّداً بعد

175
00:12:33,730 --> 00:12:35,730
أو نحو ذلك

176
00:12:37,530 --> 00:12:39,180
جوهريّاً، كلّ شيء

177
00:12:40,730 --> 00:12:46,750
انتهى الأمر

178
00:12:48,090 --> 00:12:51,500
!كيف أمكنك فعل هذا يا فودو-كن؟

179
00:12:52,730 --> 00:12:54,990
!هذا لا يُصدَّق حرفيّاً

180
00:12:54,990 --> 00:12:56,750
كيف تنوي التّكفير عن هذا؟

181
00:12:57,030 --> 00:12:58,750
!خاب أملي تماماً يا فودو

182
00:13:00,250 --> 00:13:03,730
!كيف أمكنك فعل هذا يا فودو-كن؟

183
00:13:00,250 --> 00:13:03,730
!هذا لا يُصدَّق حرفيّاً

184
00:13:00,250 --> 00:13:03,730
كيف تنوي التّكفير عن هذا؟

185
00:13:00,250 --> 00:13:03,730
!خاب أملي تماماً يا فودو

186
00:13:11,800 --> 00:13:14,430
...إن كان هذا هو الظرف الّذي ينتظرني هناك

187
00:13:15,060 --> 00:13:16,650
فماذا سأفعل؟

188
00:13:17,310 --> 00:13:19,190
ماذا تفعل يا سينباي؟

189
00:13:26,540 --> 00:13:28,550
الاجتماع على وشك أن يبدأ

190
00:13:28,870 --> 00:13:30,410
حـ-حسناً

191
00:13:30,410 --> 00:13:33,210
صباح الخير يا فودو-كن وهارو-كن

192
00:13:33,210 --> 00:13:34,410
!مرحباً

193
00:13:34,410 --> 00:13:38,630
يرغب هارو-كن أن يستهلّ الاجتماع بإعلان

194
00:13:40,250 --> 00:13:41,430
أجل

195
00:13:41,430 --> 00:13:43,960
إنّه متعلّق بي وبفودو-سينباي

196
00:13:43,960 --> 00:13:45,010
...الأمر

197
00:13:45,500 --> 00:13:47,470
،اختبارات نهاية الفصل خاصّتنا ستبدأ هذا الأسبوع

198
00:13:47,470 --> 00:13:48,390
لذا علينا المغادرة باكراً

199
00:13:48,620 --> 00:13:49,460
!لم ينتهِ

200
00:13:50,140 --> 00:13:52,290
!اختبارات؟ يعيدني هذا للذكريات

201
00:13:52,290 --> 00:13:54,020
اعتنيا بنفسيكما

202
00:13:55,980 --> 00:13:56,850
لماذا؟

203
00:14:00,010 --> 00:14:01,000
لماذا فعلتْ ذلك؟

204
00:14:02,570 --> 00:14:03,490
...لماذا

205
00:14:05,270 --> 00:14:06,440
لماذا حقّاً؟

206
00:14:09,110 --> 00:14:11,030
!لماذا لم تقل شيئاً؟

207
00:14:12,490 --> 00:14:16,000
ما الّذي يجري بالتّحديد؟

208
00:14:16,220 --> 00:14:18,060
لا أعلم أيضاً

209
00:14:18,060 --> 00:14:21,020
،كان هارو-كن يتصرّف بشكل طبيعي في الأسبوع الماضي

210
00:14:21,020 --> 00:14:23,500
في العمل وفي المدرسة

211
00:14:24,700 --> 00:14:27,750
!ما الّذي تخطّطين له يا بينك جيلاتو؟

212
00:14:27,750 --> 00:14:30,550
!أنا واثقة بأنّها تراقبنا في هذه اللّحظة

213
00:14:30,910 --> 00:14:33,720
لا تقلقي. لهذا نحافظ على مسافة بيننا

214
00:14:38,760 --> 00:14:40,690
إنّه سنّور زباد فحسب

215
00:14:42,700 --> 00:14:45,440
!هذا تعذيب! تقطّعت بي الأسباب

216
00:14:45,820 --> 00:14:47,470
...إذا أصرّت على مُحاصرتي

217
00:14:48,200 --> 00:14:50,360
!فسأضطرّ لإسكاتها للأبد

218
00:14:50,360 --> 00:14:51,770
!مـ-مهلاً

219
00:14:51,770 --> 00:14:53,020
!انتظري يا ديسومي-سان

220
00:14:53,020 --> 00:14:55,660
لا داعي للقلق. لن أفشل

221
00:14:55,660 --> 00:14:57,120
!لـ-ليس هذا ما أقصده

222
00:14:57,120 --> 00:15:00,670
أنا متأكّد بأنّ هارو-كن لديها أسبابها لفعل هذا

223
00:15:00,670 --> 00:15:02,340
لننتظر ونراقب فترة أطول قليلاً

224
00:15:10,700 --> 00:15:11,620
...فودو

225
00:15:12,670 --> 00:15:15,230
هلّا اشتريت لي شراباً؟

226
00:15:16,300 --> 00:15:20,390
أريد فانيلا موتشا مع حليب خالي الدّسم
بخفقة إضافيّة ولوز

227
00:15:21,540 --> 00:15:23,100
...فانيلا موتشا وحليب خالي الدّسم

228
00:15:23,100 --> 00:15:24,200
!مهلاً لحظة

229
00:15:24,200 --> 00:15:25,310
دعيني أدوّن طلبكِ

230
00:15:25,650 --> 00:15:29,970
فانيلا موتشا مع حليب خالي الدّسم
بخفقة إضافيّة ولوز

231
00:15:30,830 --> 00:15:33,070
حـ-حسناً. سأذهب لإحضاره

232
00:15:33,070 --> 00:15:34,110
شكراً

233
00:15:39,030 --> 00:15:41,190
كشفتِ عن نفسكِ أخيراً، صحيح؟

234
00:15:44,510 --> 00:15:49,460
لا بدّ من وجود سبب يمنعكِ من
الإفشاء لأحد عن علاقتنا

235
00:15:50,460 --> 00:15:52,830
هل تمانعين أن تخبريني ما هو؟

236
00:16:00,570 --> 00:16:02,600
!قاتليني

237
00:16:04,100 --> 00:16:06,860
!هذا ما أريده

238
00:16:06,860 --> 00:16:09,970
ستقبلين تحدّيي، أليس كذلك
!أيّتها الأميرة حاصدة الأرواح؟

239
00:16:12,860 --> 00:16:13,700
...لا

240
00:16:13,700 --> 00:16:15,120
،في السّنة الثانيّة في مدرسة كوكوتي الثانويّة

241
00:16:15,660 --> 00:16:17,370
!ديسومي ماغاهارا

242
00:16:17,370 --> 00:16:19,870
مـ-ما أدراكِ بي؟

243
00:16:20,170 --> 00:16:20,890
!ها أنا قادمة

244
00:16:20,890 --> 00:16:24,330
!تغيير، جيلاتو

245
00:16:40,590 --> 00:16:43,640
تحتاج تقنيّتها في القتال لكثير من التّطوير

246
00:16:43,640 --> 00:16:47,310
هذا صحيح. لم يمضِ على وجودها
في الفريق مدّة طويلة

247
00:16:49,590 --> 00:16:51,660
هل يمكننا إيقاف هذا الآن؟

248
00:16:53,020 --> 00:16:54,030
...ليس بعد

249
00:16:54,890 --> 00:16:56,150
!لم أنتهِ بعد

250
00:16:57,570 --> 00:17:01,330
...لماذا هي مستميتة كي

251
00:17:13,570 --> 00:17:15,940
يسرّني أنّكِ استيقظتِ

252
00:17:17,480 --> 00:17:19,350
ينبغي أن تبقي مستلقية فترة أطول

253
00:17:21,030 --> 00:17:22,710
خسِرت

254
00:17:23,790 --> 00:17:26,850
أنتِ حقّاً قويّة يا ديسومي-سان

255
00:17:27,660 --> 00:17:31,360
أخبريني من فضلكِ. ما غايتكِ؟

256
00:17:32,710 --> 00:17:35,380
سبب انضمامي للفريق

257
00:17:35,780 --> 00:17:38,300
كان لأنّني واقعة في حبّ فودو-سينباي

258
00:17:40,740 --> 00:17:44,870
لهذا بدأتُ أشكّ بأنّ لديه حبيبة

259
00:17:45,340 --> 00:17:50,170
لكن لم أتخيّل يوماً أن تكون حبيبته هي قائدة عدوّ

260
00:17:52,350 --> 00:17:53,770
هكذا إذاً

261
00:17:54,090 --> 00:17:56,410
لا عجب في كرهها لي

262
00:17:57,370 --> 00:18:02,970
لكن تبيّن أيضاً بأنّها شخص أعرفه

263
00:18:05,670 --> 00:18:07,980
...كانت

264
00:18:13,160 --> 00:18:16,440
...في تلك اللّيلة، عندما هوجِمت بواسطة عصابة

265
00:18:19,950 --> 00:18:21,480
هي من أنقذني

266
00:18:27,400 --> 00:18:28,690
كوني قويّة

267
00:18:32,040 --> 00:18:37,030
الشّخص الّذي أنقذني وقال تلك الكلمات لي

268
00:18:43,100 --> 00:18:44,730
!كانت أنتِ؟

269
00:18:46,060 --> 00:18:49,980
لم أتخيّل يوماً بأنّكِ ستصبحين الأميرة
حاصدة الأرواح أيضاً

270
00:18:51,770 --> 00:18:57,080
بصراحة... ظننتُ أنّه إذا كان الوقوع
،في الحبّ جعلكِ ضعيفة حقّاً

271
00:18:57,460 --> 00:18:59,960
فقد أسرقه منكِ

272
00:19:01,090 --> 00:19:02,240
...لكن

273
00:19:02,980 --> 00:19:05,990
لكنّكِ قويّة كما كنتِ في السّابق

274
00:19:05,990 --> 00:19:07,670
لـ-لماذا؟

275
00:19:07,670 --> 00:19:11,500
!كان بمقدوركِ تدمير علاقتنا دون أيٍّ من هذا

276
00:19:13,170 --> 00:19:18,520
رأيتُ فودو-سينباي يبتسم بطريقة
لم أشهدها من قبل

277
00:19:23,290 --> 00:19:25,260
لذا لا أستطيع فعلها فحسب

278
00:19:26,520 --> 00:19:33,430
لا أملك الحقّ لسرقة السّعادة منكما

279
00:19:47,560 --> 00:19:50,150
...أ-أنتِ

280
00:19:56,950 --> 00:19:58,090
لماذا؟

281
00:20:00,310 --> 00:20:04,050
لماذا تبكين أيضاً؟

282
00:20:33,090 --> 00:20:34,660
أنا آسفة يا ديسومي-سان

283
00:20:35,330 --> 00:20:38,950
لم أجد فانيلا باللّوز الّذي كنتِ تتحدّثين عنه

284
00:20:40,290 --> 00:20:42,530
هارو-كن؟

285
00:20:43,290 --> 00:20:45,470
...ماذا

286
00:20:46,280 --> 00:20:47,930
...صه

287
00:20:51,390 --> 00:20:53,700
مرّت بينك جيلاتو

288
00:20:57,020 --> 00:20:58,420
إنّها نائمة الآن

289
00:20:58,940 --> 00:21:00,300
!هل أسكتّها للأبد؟

290
00:22:44,740 --> 00:22:49,180
سوف أشجّعكما، اتّفقنا؟

291
00:22:56,810 --> 00:23:00,270
!لكن إذا منحتِني الفُرصة، فقد أنتزعه منكِ

292
00:23:04,200 --> 00:23:07,400
!لذا حريّ بكما أن تنسجما معاً

293
00:23:10,060 --> 00:23:12,660
أعلم. سنفعل

294
00:23:16,530 --> 00:23:17,570
!إلى اللّقاء

295
00:23:21,370 --> 00:23:22,670
أنا سنّور زباد

296
00:23:24,670 --> 00:23:25,750
هذه هي فقرة الحلقة القادمة

297
00:23:32,750 --> 00:23:36,430
"الحلقة القادمة: "كما أنت

298
00:23:37,390 --> 00:23:39,420
!لماذا سنّور زباد؟