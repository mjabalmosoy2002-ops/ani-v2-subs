1
00:00:22,770 --> 00:00:24,040
!يا إلهي، الحرّ شديد

2
00:00:24,040 --> 00:00:26,870
أجل، الصّيف بذروته

3
00:00:27,370 --> 00:00:28,860
بالمناسبة يا ديسومي-سان

4
00:00:28,860 --> 00:00:31,360
هناك الكثير لنفعله في الصّيف، أليس كذلك؟

5
00:00:31,360 --> 00:00:33,130
هل من شيء ترغبين في فعله كزوجين؟

6
00:00:34,120 --> 00:00:35,680
!فكرة عظيمة يا فودو

7
00:00:36,470 --> 00:00:39,590
لنرَ... ما هو الأنسب يا تُرى؟

8
00:00:40,690 --> 00:00:42,890
...مشويّات، مشاهدة الألعاب الناريّة

9
00:00:42,890 --> 00:00:44,940
...لنرَ

10
00:00:44,940 --> 00:00:46,190
،رحلة إلى الجبال فكرة جيّدة

11
00:00:46,190 --> 00:00:47,650
!لكن أعتقد لا بدّ أن يكون الشّاطئ

12
00:00:47,910 --> 00:00:48,730
!الشّاطئ؟

13
00:00:52,010 --> 00:00:53,280
فودو؟

14
00:00:54,890 --> 00:00:56,150
!ملابس سباحة؟

15
00:00:56,670 --> 00:00:58,570
!فودو

16
00:02:39,780 --> 00:02:42,320
!أصبحتِ مُنافستي حقّاً أيّتها الأميرة حاصدة الأرواح

17
00:02:42,320 --> 00:02:45,790
!ينبعث منها هالة مُحرّمة حتّى أثناء الغداء

18
00:02:48,240 --> 00:02:52,400
من هو المسكين الّذي يسبّب
هذه النّظرة النّارية في عينيها؟

19
00:02:53,810 --> 00:02:55,320
!خذلتِني أيّتها النّاجحة

20
00:02:55,920 --> 00:02:57,920
ألا تعلمين بأنّ لديكِ سمعة يجب الحفاظ عليها؟

21
00:02:57,920 --> 00:03:02,120
كنتِ الوحيدة هنا ذات الشّراسة
التي حازت على إعجابي

22
00:03:03,950 --> 00:03:06,970
وانظري إلى نفسكِ الآن، تأكلين الباستا
!بهذا الوجه الأخرق

23
00:03:06,970 --> 00:03:09,710
لماذا أردتِ الانضمام لغيكّو من الأساس؟

24
00:03:09,710 --> 00:03:11,850
لم أفعل. عائلتي هي من سجّلتني

25
00:03:11,850 --> 00:03:13,830
!هل أنتِ آيدول؟

26
00:03:14,370 --> 00:03:17,960
لكن امتحان الدّخول ذاك ليس سهلاً. كيف نجحتِ إذاً؟

27
00:03:20,900 --> 00:03:23,550
،بذلتُ ما بوسعي فحسب

28
00:03:23,550 --> 00:03:25,530
فمنحني ذلك دوراً قياديّاً

29
00:03:26,640 --> 00:03:31,060
لم تكن تريد الالتحاق؟ ألهذا لا تأخذ
الأمر على محمل الجدّ؟

30
00:03:32,420 --> 00:03:33,580
!أيّتها الوحش

31
00:03:33,580 --> 00:03:36,970
ألا تعتقدين بأنّ الشّاطئ سيكون مكاناً
ممتازاً لهجومنا التّالي؟

32
00:03:40,490 --> 00:03:49,870
إلى كافّة قادة الفِرق وأعضاء سلسلة
الأميرة، احضرو إلى غرفة المؤتمر حالاً

33
00:03:44,410 --> 00:03:45,800
أكرّر

34
00:03:44,720 --> 00:03:47,620
لا يستدعوننا في وقت كهذا عادة

35
00:03:55,030 --> 00:03:55,630
!أنتِ

36
00:03:56,840 --> 00:03:59,190
!اتركي الباستا وتحرّكي

37
00:04:02,040 --> 00:04:04,890
!الأميرة الوحش والأميرة حاصدة الأرواح حاضرتان الآن

38
00:04:10,170 --> 00:04:11,890
!اسمحوا لي بالشّرح

39
00:04:11,890 --> 00:04:16,990
المُجتمع السرّي غيكّو يتّبع تسلسلاً
هرميّاً ثابتاً لا يلين

40
00:04:17,550 --> 00:04:21,330
أسرابه العسكريّة الستّة بقيادة أقوى
،ستّة وحوش لديهم

41
00:04:21,330 --> 00:04:24,920
مع سلسلة الأميرات الّتي تخدم
!دونهم كقادة ثانويّين

42
00:04:26,580 --> 00:04:29,890
اسمحوا لي بالكشف عن السّبب الّذي
دفعني لاستدعائكم جميعاً إلى هنا اليوم

43
00:04:30,170 --> 00:04:35,790
قرّرتُ صنع وحش جديد وتأسيس
!سرب عسكري جديد

44
00:04:38,170 --> 00:04:41,070
!الأميرة حاصدة الأرواح، تقدّمي

45
00:04:44,390 --> 00:04:46,930
!مُبارك

46
00:04:47,370 --> 00:04:51,050
!الأميرة حاصدة الأرواح، ديسومي ماغاهارا

47
00:04:52,010 --> 00:04:52,880
أرقّيكِ

48
00:04:53,430 --> 00:04:57,440
!من سلسلة الأميرات إلى وحش

49
00:04:58,540 --> 00:05:00,180
،ستخضعين لعمليّة جراحيّة تطويريّة

50
00:05:00,180 --> 00:05:01,840
،وتنصهرين مع حيوان

51
00:05:01,840 --> 00:05:04,190
!وتحصلين على قوّة أعظم من السّابق

52
00:05:04,190 --> 00:05:06,720
تريد... تريد أن تجعلني وحشاً؟

53
00:05:06,720 --> 00:05:08,950
!اللّعنة! فضّلوها عليّ؟

54
00:05:08,950 --> 00:05:10,720
—مـ-مهلاً لحظة

55
00:05:10,720 --> 00:05:12,340
!ترتقين في هذا العالم أخيراً

56
00:05:12,830 --> 00:05:15,620
!لطالما عرفتُ بأنّكِ تمتلكين المقوّمات

57
00:05:15,620 --> 00:05:18,080
!أهلاً بكِ في عالم الوحوش

58
00:05:18,080 --> 00:05:20,460
!هذا الجسد رائع يا فتاة

59
00:05:22,130 --> 00:05:24,480
!هذا مُحبِط، لكن سوف ألحق بكِ قريباً

60
00:05:24,480 --> 00:05:26,830
!انتظري وسترين

61
00:05:26,830 --> 00:05:28,680
!تهانينا أيّتها الحاصدة-تشان

62
00:05:28,680 --> 00:05:31,330
!ستكونين مثلنا فحسب

63
00:05:31,330 --> 00:05:33,180
الطائرة بلا طيّار أرنب-سينباي؟

64
00:05:33,420 --> 00:05:34,840
...إنّها جميلة جدّاً

65
00:05:34,840 --> 00:05:38,790
،إذا استطعتُ أن أصبح وحشاً ظريفاً مثلها
فلا أرى مانعاً من ذلك

66
00:05:38,790 --> 00:05:40,520
!الأميرة حاصدة الأرواح

67
00:05:41,820 --> 00:05:45,000
!أردتُ دمجكِ مع غوريلّا جبليّ

68
00:05:46,070 --> 00:05:49,190
!اندماج بين أفضل كائنين رئيسيّين

69
00:05:49,190 --> 00:05:52,330
!إعجاز كيميائي حقيقيّ

70
00:05:52,330 --> 00:05:53,290
!انتظر لحظة

71
00:05:53,290 --> 00:05:55,700
!ستُجرى العمليّة الجراحيّة التطويريّة غداً

72
00:05:56,180 --> 00:05:57,150
...ا-انتظر

73
00:05:56,180 --> 00:05:57,150
!هذا كلّ شيء

74
00:05:57,150 --> 00:05:58,110
!انصراف

75
00:06:04,120 --> 00:06:05,740
،إذا أصبحتُ وحشاً

76
00:06:05,740 --> 00:06:08,650
فهذا يعني أنّه ستطرأ تغيّرات كبيرة للحياة الّتي أعرفها

77
00:06:09,460 --> 00:06:11,740
لا مواعيد في الشّاطئ أيضاً على الأغلب

78
00:06:14,790 --> 00:06:16,930
...لكن لا أستطيع الرّفض

79
00:06:21,670 --> 00:06:23,160
!ديسومي

80
00:06:23,160 --> 00:06:24,550
كيف حالكِ؟

81
00:06:24,550 --> 00:06:25,780
...أبي

82
00:06:26,170 --> 00:06:29,200
تلقّيتُ رسالة من بوسلار-ساما

83
00:06:29,200 --> 00:06:31,620
!قال بأنّه سيرقّيكِ

84
00:06:31,620 --> 00:06:34,490
!هذه فتاتي المثاليّة الّتي أعرفها

85
00:06:34,920 --> 00:06:36,250
...واحد، اثنان

86
00:06:36,250 --> 00:06:38,620
!تهانينا يا أختي

87
00:06:38,620 --> 00:06:43,410
لم أتوقّع أن يكون هناك وحش في
!عائلتنا... وكأنّه حلم تحقّق

88
00:06:43,410 --> 00:06:45,990
...مهلاً يا عزيزي، لا تبكِ

89
00:06:45,990 --> 00:06:48,630
،كنتُ مُقاتلاً حتّى تقاعدت

90
00:06:48,630 --> 00:06:49,630
...لهذا هذا يُسعدني حقّاً

91
00:06:49,900 --> 00:06:52,450
!ابذلي قصارى جهدكِ يا ديسومي

92
00:06:52,450 --> 00:06:53,510
...أمّي

93
00:06:53,510 --> 00:06:55,930
...الحقيقة هي... لا أعرف ماذا أريد

94
00:06:56,150 --> 00:06:58,590
،وبعد أن رأتْ كم تبذلين من جهود كبيرة

95
00:06:58,590 --> 00:07:01,290
بدأت أختكِ تخرج من قوقعتها

96
00:07:02,190 --> 00:07:02,820
هيّا

97
00:07:02,820 --> 00:07:05,020
تكلّمي مع أختكِ الكبرى

98
00:07:05,950 --> 00:07:07,030
أختي الكبرى

99
00:07:07,030 --> 00:07:08,140
...أورامي

100
00:07:08,140 --> 00:07:11,440
سوف ألتحق بغيكّو عندما أتخرّج

101
00:07:11,440 --> 00:07:14,660
من الأفضل أن تستمرّي في القتال
حتّى بعد أن تصبحي وحشاً

102
00:07:14,660 --> 00:07:17,660
أنتِ مثَلي الأعلى يا أختي الكبرى

103
00:07:20,020 --> 00:07:21,940
حسناً يا أورامي

104
00:07:21,940 --> 00:07:23,670
لا تقلقي

105
00:07:23,970 --> 00:07:25,660
!إلى اللّقاء يا ديسومي

106
00:07:25,660 --> 00:07:27,810
!اعتني بنفسكِ

107
00:07:27,810 --> 00:07:30,110
!إلى اللّقاء! واصلي القتال يا أختي الكبرى

108
00:07:36,180 --> 00:07:40,770
...زملائي في غيكّو وعائلتي جميعهم سعداء لأجلي

109
00:07:41,360 --> 00:07:45,670
سيمتعضون حقّاً إذا رفضتُ التّرقية، صحيح؟

110
00:07:50,750 --> 00:07:53,330
أتساءل ما هو رأي فودو

111
00:07:55,790 --> 00:07:57,480
!أ-أنت

112
00:07:58,310 --> 00:07:59,790
!فـ-فودو؟

113
00:08:00,470 --> 00:08:02,410
!ما-ماذا تريد؟

114
00:08:02,410 --> 00:08:04,550
لهجة هاكاتا الظريفة تلك

115
00:08:04,550 --> 00:08:09,600
كنتُ أفكّر فيكِ، وأحببتُ أن أسمع صوتكِ

116
00:08:09,600 --> 00:08:12,110
هل من مشكلة؟

117
00:08:12,110 --> 00:08:15,040
كان سلامكِ مختلفاً قليلاً عن المعتاد

118
00:08:18,060 --> 00:08:20,450
لا، أنا متأكّد بأنّني توهّمت

119
00:08:20,450 --> 00:08:21,750
لا تقلقي بشأن ذلك

120
00:08:24,040 --> 00:08:25,860
!أمهليني ساعة واحدة

121
00:08:44,250 --> 00:08:45,500
فودو؟

122
00:08:56,430 --> 00:08:57,660
هكذا إذاً

123
00:08:57,660 --> 00:08:59,620
يريدون أن يجعلوكِ وحشاً

124
00:08:59,620 --> 00:09:02,160
أجل، ودمجي مع غوريلّا

125
00:09:02,160 --> 00:09:04,480
!ستكونين الغوريلّا الأظرف في العالم

126
00:09:04,700 --> 00:09:06,730
!هذا أمر جادّ بالنسبة لي، مفهوم؟

127
00:09:10,740 --> 00:09:12,190
فودو

128
00:09:12,190 --> 00:09:13,990
ماذا ينبغي أن أفعل برأيك؟

129
00:09:14,280 --> 00:09:15,760
لا يهمّ ما أفكّر فيه

130
00:09:16,200 --> 00:09:17,970
بل ما تريدين أنتِ أن تفعليه؟

131
00:09:19,910 --> 00:09:22,640
...ما أريد أن أفعله

132
00:09:24,240 --> 00:09:26,710
،بالتفكير في الأمر، طوال هذا الوقت

133
00:09:26,710 --> 00:09:30,970
لم أفكّر في الأمر حتّى

134
00:09:32,920 --> 00:09:33,950
...ديسومي-سان

135
00:09:34,450 --> 00:09:39,120
لطفك تجاه الجميع حولكِ هو أحد
أكثر الأشياء الّتي أحبّها فيكِ

136
00:09:39,570 --> 00:09:44,890
لكن ينبغي أن تحوّلي قليلاً من ذلك اللّطف
تجاه نفسكِ بين الفيّنة والأخرى

137
00:09:46,430 --> 00:09:49,290
والآن، ماذا تريدين أن تفعلي؟

138
00:09:51,520 --> 00:09:54,010
هذا صحيح

139
00:09:54,900 --> 00:09:57,180
لا مانع أن أختار، أليس كذلك؟

140
00:09:58,660 --> 00:10:00,660
،إذا أصبحتُ غوريلّا

141
00:10:01,040 --> 00:10:04,210
سيكون تقليم أظافري أصعب وكذلك
...الطبخ والحِرف اليدويّة

142
00:10:06,310 --> 00:10:09,170
وسيُصعّب ذلك من رؤيتك أيضاً يا فودو

143
00:10:09,930 --> 00:10:11,920
أريد العودة إلى مدينة الملاهي معك

144
00:10:11,920 --> 00:10:13,810
أريد أن نتواعد بعد دوام المدرسة

145
00:10:13,810 --> 00:10:16,880
ولن أشعر بالرّاحة عند الذّهاب إلى
الشّاطئ فأيّ جسد غير هذا

146
00:10:17,400 --> 00:10:20,180
لا أريد التخلّي عن أيّ من هذا

147
00:10:21,970 --> 00:10:23,200
...فودو

148
00:10:23,200 --> 00:10:27,810
اللّقاء بك جعلني أرغب في القيام
بأمور عديدة جديدة

149
00:10:28,680 --> 00:10:30,560
،لو كنتُ لا أزال أنا قبل أن أعرفك

150
00:10:30,560 --> 00:10:33,520
لرُبّما تماشيتُ مع ما يريده الجميع لأجلي

151
00:10:34,480 --> 00:10:35,780
...لكن

152
00:10:37,450 --> 00:10:38,970
أنا آسفة جميعاً

153
00:10:39,310 --> 00:10:41,750
!لا أستطيع أن أصبح غوريلّا بعد

154
00:10:42,880 --> 00:10:48,370
أريد أن أتمكّن من الاستمرار في الاستناد
على فودو بهذا الشّكل

155
00:10:51,980 --> 00:10:54,240
!ما-ماذا؟

156
00:10:54,240 --> 00:10:57,300
!ماذا تقصدين بأنّكِ لا تريدين أن تصبحي وحشاً؟

157
00:10:57,550 --> 00:10:59,510
هذا قراري

158
00:10:59,510 --> 00:11:00,860
لستُ متحسّرة على شيء

159
00:11:00,860 --> 00:11:02,800
!هل جُننتِ يا حاصدة الأرواح؟

160
00:11:02,800 --> 00:11:05,140
!هذه هي فرصتكِ للحصول على القوّة الحقيقيّة

161
00:11:05,140 --> 00:11:09,660
!ترفضين عرض قائدكِ العظيم السّخيّ؟

162
00:11:09,660 --> 00:11:10,270
أجل

163
00:11:19,490 --> 00:11:21,210
!مدهش

164
00:11:21,210 --> 00:11:23,620
!أنتِ حقّاً أعجوبة أيّتها الأميرة حاصدة الأرواح

165
00:11:24,120 --> 00:11:28,310
!أسلوبك هو القتال فقط بمواهبك الفطريّة

166
00:11:28,310 --> 00:11:31,370
!تمتلكين حقّاً قلب مُمارسة فنون قتاليّة

167
00:11:31,650 --> 00:11:36,130
ترين أنّ القبول بقوّة حيوان سوف
!يحدّد نقطة ضعفكِ

168
00:11:38,380 --> 00:11:41,240
!حسناً! صفّقوا للأميرة حاصدة الأرواح بحرارة

169
00:11:41,240 --> 00:11:43,340
!يجب عليكم أن تتعلّموا منها جميعاً

170
00:11:54,820 --> 00:11:57,050
!إنّها الأميرة حاصدة الأرواح

171
00:11:57,050 --> 00:11:59,270
لا بدّ أنّها خضعت للعمليّة الجراحيّة التطويريّة

172
00:11:59,270 --> 00:12:03,060
إذاً هذا هو شكلها بعد اندماجها مع الغوريلّا؟

173
00:12:03,060 --> 00:12:05,740
!أجل! إنّها أكثر رعباً من أيّ وقت سبق

174
00:12:08,750 --> 00:12:10,970
!الحبّ بعد الهيمنة على العالم

175
00:12:22,310 --> 00:12:24,840
!الطقس رائع

176
00:12:26,750 --> 00:12:28,850
!أنا جاهزة! هيّا بنا

177
00:12:29,180 --> 00:12:31,120
لحظة واحدة أيّتها الأميرة حاصدة الأرواح

178
00:12:32,170 --> 00:12:34,520
ماذا تفعلين بأغراض الشاطئ هذه؟

179
00:12:34,520 --> 00:12:37,220
فقط لكوننا في الشّاطئ لا يعني بأنّها إجازة

180
00:12:38,620 --> 00:12:39,480
تبّاً

181
00:12:39,480 --> 00:12:42,550
هل أنتِ متأكّدة من المعلومة السرّية التي تلقّيتِها؟

182
00:12:42,550 --> 00:12:43,400
!أجل

183
00:12:43,400 --> 00:12:44,740
!متأكّدة تماماً

184
00:12:45,860 --> 00:12:47,240
هل أنت جادّ يا فودو؟

185
00:12:47,240 --> 00:12:48,110
أجل

186
00:12:48,110 --> 00:12:54,250
السّبت المقبل، سوف نجري تجربة للملك
جيلاتو روبو في شاطئ شونان

187
00:12:54,800 --> 00:12:56,480
!اسمحوا لي بالشّرح

188
00:12:56,480 --> 00:13:03,500
الملك جيلاتو روبو هو روبوت مُكوّن من 12
قطعة مُصمّم لمقاتلة الوحوش العملاقة

189
00:13:03,930 --> 00:13:05,750
...الشّاطئ

190
00:13:05,750 --> 00:13:06,890
...هل هذا يعني

191
00:13:06,890 --> 00:13:07,850
!أجل

192
00:13:07,850 --> 00:13:09,890
!إنّها فُرصتنا لموعد على الشّاطئ أخيراً

193
00:13:11,200 --> 00:13:12,640
!هذا رائع يا فودو

194
00:13:12,640 --> 00:13:15,430
!أنا متحمّسة ليوم السّبت

195
00:13:20,180 --> 00:13:22,150
مرحباً؟ هل معي دبّ-ساما؟

196
00:13:22,150 --> 00:13:25,030
حصلتُ على معلومة سرّية عن نشاطات الأبطال للتو

197
00:13:25,490 --> 00:13:29,490
لكن يبدو أنّ الأبطال لم يصلوا بعد

198
00:13:30,720 --> 00:13:33,500
إذاً ينبغي أن تستعدّي جيّداً لوصولهم

199
00:13:33,500 --> 00:13:38,360
مهمّتنا هي التحرّي وهدم روبوت الأبطال

200
00:13:38,360 --> 00:13:41,170
من المهمّ التصرّف بحذر وتروٍّ

201
00:13:41,170 --> 00:13:44,230
هذه مهمّة مشتركة بين أسرابنا العسكريّة الثّلاثة

202
00:13:44,230 --> 00:13:47,540
—لنعمل جميعاً معاً يا حاصدة-سان ووحش-سان

203
00:13:50,000 --> 00:13:53,430
ماذا؟ لماذا تختبئين خلف تلك الصّخور؟

204
00:13:53,430 --> 00:13:55,520
!أ-أنا لا أختبئ

205
00:13:56,160 --> 00:13:57,180
...أنا فقط

206
00:13:58,260 --> 00:13:59,730
...كلّ ما في الأمر

207
00:14:00,500 --> 00:14:03,000
ألا يبدو زيّي مختلفاً قليلاً عمّا لديكما؟

208
00:14:03,000 --> 00:14:04,120
قطعاً لا

209
00:14:04,120 --> 00:14:05,750
يليق بكِ حقّاً

210
00:14:05,750 --> 00:14:06,730
!أجل

211
00:14:06,730 --> 00:14:08,510
أ-أوتظنّان ذلك؟

212
00:14:10,900 --> 00:14:12,120
فولاذيّة

213
00:14:12,120 --> 00:14:13,080
لا تقفي بجانبي

214
00:14:13,080 --> 00:14:13,870
!انقلعي

215
00:14:14,180 --> 00:14:16,500
!لكن لماذا؟ ينبغي أن نتعاون معاً

216
00:14:16,500 --> 00:14:18,000
!اغربي عن وجهي فحسب

217
00:14:40,730 --> 00:14:43,480
!انسحاب! انسحاب

218
00:14:45,690 --> 00:14:46,810
!آسف

219
00:14:46,810 --> 00:14:49,140
!أطلقتُ الصّواريخ بالخطأ

220
00:14:49,610 --> 00:14:51,490
لم تُصِب أحداً

221
00:14:51,710 --> 00:14:53,280
لا أعتقد... ذلك

222
00:14:53,630 --> 00:14:54,740
غالباً

223
00:14:55,630 --> 00:14:58,460
توقّعوا مهمّة العرقلة خاصّتنا

224
00:14:58,700 --> 00:15:00,560
...غوّاصة

225
00:15:00,560 --> 00:15:02,960
أهذا جزء من الرّوبوت العملاق الخاص بهم؟

226
00:15:04,820 --> 00:15:07,960
!الأجواء هنا ألطف من الدّاخل

227
00:15:10,330 --> 00:15:11,990
!ميساكي-سان، البيرة ممنوعة

228
00:15:11,990 --> 00:15:13,010
استرخي

229
00:15:13,010 --> 00:15:14,890
...ما دمنا في الشّاطئ

230
00:15:14,890 --> 00:15:15,940
!مستحيل

231
00:15:15,940 --> 00:15:17,790
!لم نأتِ إلى هنا للتسلية

232
00:15:17,790 --> 00:15:18,860
مهلاً، مهلاً

233
00:15:18,860 --> 00:15:21,020
لا شيء من هذا القبيل يا ميساكي-كن

234
00:15:21,450 --> 00:15:24,090
ما زالت هذه دافئة

235
00:15:24,090 --> 00:15:26,260
عليكِ تجربتها

236
00:15:26,260 --> 00:15:27,230
...بروفسور

237
00:15:27,230 --> 00:15:29,210
مهلكِ يا هارو-كن

238
00:15:29,210 --> 00:15:30,490
،أعلم بأنّني نقوم بتجربة

239
00:15:30,780 --> 00:15:33,990
لكن هذا لأجل غوّاصة جيلاتو فقط

240
00:15:33,990 --> 00:15:37,530
،وهذه الجزئيّة تمثّل ربلة ساق الرّوبوت فحسب

241
00:15:37,530 --> 00:15:39,450
لذا الأمر ليس بتلك الأهمّية

242
00:15:39,450 --> 00:15:41,520
!لماذا صنعتها إذاً؟

243
00:15:41,520 --> 00:15:43,500
!ريد قادم إلى هنا

244
00:15:50,320 --> 00:15:52,190
ما الخطّة يا حاصدة الأرواح؟

245
00:15:52,190 --> 00:15:54,140
أتعتقدين بأنّنا نستطيع تولّي المهمّة بمفردنا؟

246
00:15:54,140 --> 00:15:55,680
!أ-أنتِ

247
00:15:57,990 --> 00:15:59,910
!وجدتُك يا فودو

248
00:16:00,750 --> 00:16:02,730
—ديسومي-سا

249
00:16:11,090 --> 00:16:12,780
ما-ما الأمر يا فودو؟

250
00:16:12,780 --> 00:16:14,030
!أنت

251
00:16:15,200 --> 00:16:18,120
!أخذني حبّكِ بعيداً لدرجة أنّني نسيتُ التنفّس

252
00:16:18,120 --> 00:16:19,910
!هذا يكفي! أخفتَني

253
00:16:22,890 --> 00:16:25,080
!لا تحدّق بي هكذا

254
00:16:25,080 --> 00:16:28,770
...لم أختر الزيّ بنفسي، لكنّه مُحرج قليلاً

255
00:16:28,770 --> 00:16:30,170
!ثمين للغاية

256
00:16:36,800 --> 00:16:40,250
!والآن، لنبدأ بموعد الشّاطئ، موعد أحلامنا

257
00:16:41,650 --> 00:16:45,040
تذكّرت... ثمّة شيء أردتُ تجربته

258
00:16:45,040 --> 00:16:46,560
!حسناً! لنفعلها

259
00:16:47,000 --> 00:16:50,490
تنوي تنفيذ الخطّة بمفردها

260
00:16:50,490 --> 00:16:52,890
الأميرة حاصدة الأرواح مدهشة حقّاً

261
00:16:52,890 --> 00:16:55,820
...بينما أنا عالقة دوماً أحلّل المخاطر

262
00:16:57,940 --> 00:17:00,660
هذا الفرق بيننا

263
00:17:00,660 --> 00:17:03,540
!لكن... ذلك ينتهي اليوم

264
00:17:03,540 --> 00:17:06,260
،أنا، الأميرة الوحش، كيكي ماجيما

265
00:17:06,260 --> 00:17:08,190
—سوف نكسب بعض الاحترام

266
00:17:18,430 --> 00:17:20,430
!إنّها تعذّبه

267
00:17:20,430 --> 00:17:21,550
ما رأيك؟

268
00:17:21,550 --> 00:17:23,230
لا تستطيع التحرّك الآن، صحيح؟

269
00:17:23,230 --> 00:17:24,180
!لا أستطيع

270
00:17:24,180 --> 00:17:27,780
!الأميرة حاصدة الأرواح... إنّها عديمة الرّحمة حقّاً

271
00:17:27,780 --> 00:17:29,790
!وهناك أمر آخر أردتُ فعله حقّاً

272
00:17:29,790 --> 00:17:32,190
!لـ-لم تنتهِ بعد؟

273
00:17:33,050 --> 00:17:34,600
جاهز؟

274
00:17:43,750 --> 00:17:46,000
!سوف تشقّ رأسه

275
00:17:48,730 --> 00:17:51,590
!حطّمته

276
00:17:53,840 --> 00:17:55,840
!أيّتها الظريفة

277
00:17:56,620 --> 00:17:57,640
!مهلاً

278
00:17:57,640 --> 00:17:59,600
أليس هذا هو القدر؟

279
00:17:59,600 --> 00:18:00,840
تـ-تمهّل

280
00:18:00,840 --> 00:18:02,430
...أعرفك

281
00:18:02,700 --> 00:18:04,320
!أنت بلو جيلاتو

282
00:18:04,320 --> 00:18:06,680
مذهل! تعرفينني؟

283
00:18:06,680 --> 00:18:08,210
!هذا رائع

284
00:18:08,210 --> 00:18:11,320
!تعالي واستمتعي بصيفكِ مع نجم

285
00:18:11,910 --> 00:18:14,250
أنت خنزير بكل ما تحمله الكلمة
...من معنى كما سمعت

286
00:18:14,250 --> 00:18:15,710
!أبعد يدك

287
00:18:17,220 --> 00:18:18,460
أين حاصد الأرواح؟

288
00:18:21,950 --> 00:18:24,700
!اخترقت عمق صفوفهم

289
00:18:25,130 --> 00:18:25,830
أنتِ

290
00:18:25,830 --> 00:18:27,890
اعترفي فقط أنّكِ تريدين قطعة من هذه

291
00:18:29,260 --> 00:18:32,580
!عودي يا عزيزتي الحلوة

292
00:18:39,590 --> 00:18:41,090
...لا بدّ أن أتكلّم

293
00:18:41,090 --> 00:18:45,220
ديسومي-تشان، قلتِ بأنّكِ صديقة
...فودو أو ما شابه

294
00:18:45,220 --> 00:18:47,230
لكن يبدو لي وكأنّكما تتواعدان

295
00:18:49,650 --> 00:18:51,750
!كـ-كلّا

296
00:18:52,530 --> 00:18:53,940
!ظريفة لأبعد الحدود

297
00:18:56,760 --> 00:18:58,150
أعددتُ معكرونة باردة

298
00:18:58,800 --> 00:19:00,040
!أحسنت

299
00:19:00,040 --> 00:19:01,240
!لنأكل

300
00:19:02,090 --> 00:19:03,140
شاركينا

301
00:19:03,140 --> 00:19:05,370
شكراً

302
00:19:15,310 --> 00:19:16,090
!ألعاب ناريّة

303
00:19:19,100 --> 00:19:20,840
!مفاجأة

304
00:19:38,440 --> 00:19:39,930
!إنّها جميلة جدّاً

305
00:19:39,930 --> 00:19:41,490
!أحسنت يا بروفسور

306
00:19:43,420 --> 00:19:44,870
!الكثير من الدّخان

307
00:19:47,400 --> 00:19:49,620
إذاً أنت من عليّ أن أشكره؟

308
00:19:50,070 --> 00:19:51,000
تشكرينني؟

309
00:19:51,770 --> 00:19:57,050
أصبح فودو أفضل من السّابق

310
00:19:57,050 --> 00:19:59,630
ويكشف عن المزيد من جوانبه

311
00:20:00,130 --> 00:20:02,950
أعتقد أنّ السّبب هو أنتِ يا ديسومي-تشان

312
00:20:08,560 --> 00:20:10,160
هل تشاهدين يا ديسومي-سان؟

313
00:20:10,160 --> 00:20:11,890
أليس هذا جميلاً؟

314
00:20:11,890 --> 00:20:14,400
!أجل، إنّه كذلك يا فودو

315
00:20:18,170 --> 00:20:19,900
!انظروا ماذا اشترينا

316
00:20:19,900 --> 00:20:21,660
!لنشعلها معاً

317
00:20:21,660 --> 00:20:22,400
!حسناً

318
00:20:22,400 --> 00:20:23,860
!فكرة سديدة

319
00:20:29,370 --> 00:20:30,600
...فودو

320
00:20:30,600 --> 00:20:33,330
...أنت حقّاً رجل مذهل

321
00:20:34,470 --> 00:20:36,810
،منذ بدأتُ الخروج معك

322
00:20:37,120 --> 00:20:39,770
!كانت أيّامي كلّها جميلة ورائعة

323
00:20:43,960 --> 00:20:47,200
آمل أن يستمتع الشّباب

324
00:20:47,200 --> 00:20:50,180
والآن حان الوقت لإشعال المُفرقعات الختاميّة

325
00:20:56,290 --> 00:20:58,030
...نجوتُ منه أخيراً

326
00:20:58,030 --> 00:20:59,770
!يا لإصراره

327
00:20:59,770 --> 00:21:02,300
!يا وحش

328
00:21:02,300 --> 00:21:03,490
حاصدة؟

329
00:21:04,150 --> 00:21:07,410
بعد كلّ ما فعلته لريد، وكأنّ شيئاً لم يكن

330
00:21:07,740 --> 00:21:09,140
،لكن بالطبع

331
00:21:09,140 --> 00:21:11,060
—لم تستطع حتّى تدمير الرّوبوت بأكمله

332
00:21:14,000 --> 00:21:16,920
!فعلَتْها حقّاً

333
00:21:16,920 --> 00:21:19,000
!كانت المُفرقعات الأخيرة هائلة حقّاً

334
00:21:19,000 --> 00:21:22,510
!لا حدود لقدراتها

335
00:21:24,180 --> 00:21:26,420
!كم كان يوماً رائعاً

336
00:23:15,130 --> 00:23:16,360
...إنّها

337
00:23:29,970 --> 00:23:31,840
!يبدو هذا شهيّاً

338
00:23:31,840 --> 00:23:33,340
!كاذب

339
00:23:33,730 --> 00:23:37,430
الحلقة 7 ستكون
"ديسومي ماغاهارا هي الوحش الّذي صنعتُه"

340
00:23:37,430 --> 00:23:39,480
لذا شاهدوها، اتّفقنا؟