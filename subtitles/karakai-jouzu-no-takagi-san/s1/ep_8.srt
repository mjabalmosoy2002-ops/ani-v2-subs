1
00:00:04,060 --> 00:00:05,720
.تشبّثي جيدًا

2
00:00:05,720 --> 00:00:06,520
.حسنًا

3
00:00:10,260 --> 00:00:12,960
،عندما بدأنا التّمرّن على ركوب الدّرّاجة بشخصين

4
00:00:12,960 --> 00:00:15,750
.كان هذا "التّشبّث" صعبًا

5
00:00:26,580 --> 00:00:29,230
!هذا خطير! لا تدغدغيني

6
00:00:29,230 --> 00:00:32,530
.أنا لا أدغدغك، تمسّكت بك قليلاً

7
00:00:35,250 --> 00:00:37,680
.نيشيكاتا، أضلاعك حسّاسة للدّغدغة

8
00:00:38,020 --> 00:00:40,660
.يداكِ هي الّتي تدغدغها

9
00:00:40,660 --> 00:00:42,060
.غيّري طريقة إمساككِ به

10
00:00:42,720 --> 00:00:43,520
هكذا؟

11
00:00:45,240 --> 00:00:47,090
!أنتِ قريبة جدًّا

12
00:00:48,420 --> 00:00:49,750
.لكنّ هذا خطير

13
00:00:51,020 --> 00:00:53,140
هل انتبهتَ للتّوّ لمدى قربنا؟

14
00:00:54,150 --> 00:00:55,670
!كـ-كلاّ

15
00:00:55,670 --> 00:00:58,500
!كلّ ما في الأمر أنّني أشعر بالحرّ بقربكِ كثيرًا

16
00:00:58,980 --> 00:01:02,070
.على أيّ حال، لا تمسكيني بقوّة

17
00:01:02,070 --> 00:01:04,670
.لكن قلت قبل قليل أن أتشبّث جيّدًا

18
00:01:07,980 --> 00:01:11,550
.أرني كيف ينبغي أن أتمسّك بك إذًا

19
00:01:21,130 --> 00:01:23,940
.بسرعة. وقت تمريننا ينفد

20
00:01:27,710 --> 00:01:30,380
!هـ-هكذا

21
00:01:31,170 --> 00:01:34,100
...التّغلّب على عقبات مختلفة، والآن

22
00:01:41,940 --> 00:01:44,290
.أتقنّا ركوب الدرّاجة بشخصين

23
00:01:44,700 --> 00:01:46,750
.نعم، انتهينا

24
00:01:50,050 --> 00:01:55,270
،حسنًا، يمكننا ركوب الدّرّاجة بشخصين الآن
.لذا ما عدنا بحاجة للتّمرّن

25
00:01:55,270 --> 00:01:57,170
...أ-أجل

26
00:01:58,000 --> 00:01:59,350
هل أنت

27
00:02:00,680 --> 00:02:02,120
حزين قليلاً؟

28
00:02:02,970 --> 00:02:03,970
...لا

29
00:02:04,350 --> 00:02:05,380
أم مرتاح؟

30
00:02:07,130 --> 00:02:10,200
،إذا قلتُ لستُ حزينًا، فهذا قاسٍ قليلاً

31
00:02:10,200 --> 00:02:13,820
.وإذا قلتُ أنّني حزين، فسوف تسخر منّي أكثر

32
00:02:13,820 --> 00:02:15,800
...كـ-كلاهما

33
00:02:15,800 --> 00:02:17,640
.هذا ليس منصفًا

34
00:02:17,640 --> 00:02:20,140
ما-ماذا عنك؟

35
00:02:20,140 --> 00:02:20,940
أنا؟

36
00:02:21,690 --> 00:02:24,240
.لستُ حزينة إلى ذاك الحدّ

37
00:02:25,790 --> 00:02:27,410
.هـ-هكذا إذًا

38
00:02:34,480 --> 00:02:37,300
.لنكمل واجبنا المدرسيّ في المكتبة غدًا

39
00:02:41,620 --> 00:02:43,180
.لنتفقّد أجوبتنا

40
00:02:43,180 --> 00:02:44,790
...نعم

41
00:02:49,340 --> 00:02:51,280
.ستنتهي عطلة الصّيف قريبًا

42
00:02:51,630 --> 00:02:52,400
...نعم

43
00:02:53,850 --> 00:02:56,250
.لكن سيبدأ الفصل الدّراسيّ الثّاني

44
00:02:57,140 --> 00:02:57,940
.نعم

45
00:02:59,460 --> 00:03:01,800
.أتساءل ما إن كان سيهبُّ إعصار

46
00:04:37,340 --> 00:04:38,320
".إعصار"

47
00:04:44,430 --> 00:04:46,300
...عاصفة قويّة

48
00:04:51,150 --> 00:04:54,150
!ارتفاع شاهق

49
00:04:54,730 --> 00:04:56,680
!الإعصار العظيم

50
00:04:57,960 --> 00:05:00,860
!أشعر بالحماس لسبب ما

51
00:05:03,050 --> 00:05:05,290
!هبّي أكثر أيّتها الرّياح

52
00:05:07,190 --> 00:05:10,410
!أشعر وكأنّني أنا من يصنع هذه الرّياح

53
00:05:10,750 --> 00:05:11,920
!مذهل للغاية

54
00:05:13,700 --> 00:05:15,740
—والآن أيّتها الرّياح، أنا

55
00:05:23,530 --> 00:05:25,010
.صباح الخير يا نيشيكاتا

56
00:05:26,230 --> 00:05:28,330
!صـ-صباح الخير يا تاكاغي-سان

57
00:05:28,330 --> 00:05:29,830
رياح جنونيّة، صحيح؟

58
00:05:30,510 --> 00:05:32,560
كان ينبغي أن أصفّف شعري
.على طريقة ذيل الفرس

59
00:05:33,130 --> 00:05:35,280
...نعم

60
00:05:36,610 --> 00:05:39,690
.كـ-كنتُ أتفقّد جهة الرّياح

61
00:05:39,690 --> 00:05:41,860
.لم أسأل

62
00:05:43,200 --> 00:05:47,530
!تبًّا! لماذا تراني دومًا في أسوأ الأوقات؟

63
00:05:48,130 --> 00:05:49,680
حسنًا، ماذا كنتَ تفعل؟

64
00:05:49,680 --> 00:05:52,110
.كما قلت، كنتُ أتفقّد جهة الرّياح

65
00:05:52,110 --> 00:05:54,240
،حسبتُك تقول

66
00:05:57,330 --> 00:06:00,000
"!هبّي أكثر أيّتها الرّياح"

67
00:06:01,040 --> 00:06:03,050
.أو شيء من هذا القبيل

68
00:06:03,050 --> 00:06:05,460
لـ-لمَ أفعل؟

69
00:06:06,030 --> 00:06:09,150
.بالنّظر إلى ذلك موضوعيًّا، هذا محرج للغاية

70
00:06:09,950 --> 00:06:12,890
لكن لماذا كنت تتفقّد جهة الرّياح؟

71
00:06:13,100 --> 00:06:17,800
فـ-في الواقع، رأيت أنّه من الآمن
،أكثر أن أعرف جهة هبوبها

72
00:06:17,800 --> 00:06:19,850
.لأنّ الرّياح شديدة جدًّا

73
00:06:21,130 --> 00:06:23,820
.لكنّ كلتا يديك كانتا مرفوعتين عاليًا

74
00:06:24,560 --> 00:06:25,360
،كان وكأنّك تقول

75
00:06:25,360 --> 00:06:29,020
"!أشعر وكأنّني أنا من يصنع هذه الرّياح"

76
00:06:29,020 --> 00:06:30,450
"!مذهل للغاية"

77
00:06:31,510 --> 00:06:33,110
.أو شيء من هذا القبيل

78
00:06:33,810 --> 00:06:35,290
...مـ-محرج للغاية

79
00:06:35,700 --> 00:06:39,120
على أيّ حال، هل لاحظت شيئًا مختلفًا بشأني؟

80
00:06:45,530 --> 00:06:48,840
لـ-لا تركبين درّاجتك، صحيح؟

81
00:06:48,840 --> 00:06:49,820
.صحيح

82
00:06:50,730 --> 00:06:53,720
حسنًا، ولماذا تعتقد أنّني لا أركب درّاجتي اليوم؟

83
00:06:53,720 --> 00:06:55,260
—بسبب الإعـ

84
00:06:55,690 --> 00:07:00,440
إن خمّنتَ بشكل صحيح، فلن أخبر أحدًا
.بشأن مرحك وسط الرّياح قبل قليل

85
00:07:01,790 --> 00:07:04,400
!قلتُ أنّني كنت أتفقّد جهة الرّياح

86
00:07:05,500 --> 00:07:07,690
لديك من الوقت إلى أن يصل
.ذلك الكيس إلى هنا

87
00:07:07,690 --> 00:07:09,860
!هـ-هل هذا حدّ زمنيّ؟

88
00:07:10,220 --> 00:07:12,320
.يـ-يجب أن تكون إجابتي صحيحة

89
00:07:12,700 --> 00:07:15,850
،بما أنّها تسألني هذا السّؤال
.فلا بدّ من حدوث تطوّر مفاجئ

90
00:07:16,310 --> 00:07:21,190
لن يكون شيئًا بسيطًا مثل "قيادة
."الدّرّاجة خطير وسط إعصار

91
00:07:21,790 --> 00:07:24,180
!فكّر، فكّر

92
00:07:24,180 --> 00:07:27,120
...مشكلة أخرى بسبب الرّياح الشّديدة

93
00:07:27,120 --> 00:07:29,460
...درّاجة... رياح

94
00:07:31,330 --> 00:07:33,400
هل يعقل أن تكون... تنّورتها؟

95
00:07:35,290 --> 00:07:37,440
—تـ

96
00:07:39,100 --> 00:07:43,060
!لا أستطيع قول كلمة محرجة كهذه

97
00:07:45,260 --> 00:07:47,480
.صافرة، انتهى الوقت

98
00:07:47,940 --> 00:07:51,930
الإجابة هي أنّ ركوب الدّرّاجة
.خطير وسط إعصار

99
00:07:53,410 --> 00:07:55,650
حـ-حقًّا؟

100
00:07:55,650 --> 00:07:57,510
.أنت تبالغ جدًّا في التّفكير

101
00:08:00,470 --> 00:08:02,220
.هيّا بنا نذهب

102
00:08:11,110 --> 00:08:12,960
رياح جنونيّة، صحيح؟

103
00:08:12,960 --> 00:08:13,800
.نعم

104
00:08:17,240 --> 00:08:19,640
ألا يجعلك هذا متحمّسًا بعض الشّيء؟

105
00:08:19,950 --> 00:08:24,130
.نعم— لا أعتقد ذلك

106
00:08:25,740 --> 00:08:28,630
ألا يجعلك هذا تريد أن تصرخ؟

107
00:08:31,630 --> 00:08:33,780
"!هبّي أكثر أيّتها الرّياح"

108
00:08:34,740 --> 00:08:38,190
"!أنا أصنع هذه الرّياح الآن"

109
00:08:40,180 --> 00:08:43,910
"!أنا ملك الرّياح العظيم الّذي يحكم هذا العالم"

110
00:08:43,910 --> 00:08:47,030
"!سأقذف المدرسة إلى أبعد أصقاع الأرض"

111
00:08:49,880 --> 00:08:52,070
!لم أكن أفكّر إلى هذا الحدّ

112
00:08:57,500 --> 00:08:59,480
.إذًا لم تكن تتفقّد جهة الرّياح

113
00:09:01,040 --> 00:09:01,860
.لا بأس

114
00:09:03,790 --> 00:09:05,950
!لنركض إلى المدرسة يا نيشيكاتا

115
00:09:06,620 --> 00:09:08,200
!الرّياح شديدة جدًّا

116
00:09:09,170 --> 00:09:13,010
!انتظري يا تاكاغي-سان! أنت غشّاشة دومًا

117
00:09:12,170 --> 00:09:16,020
لسبب ما، كانت تاكاغي-سان حيويّة
.جدًّا في هذا الصّباح

118
00:09:20,140 --> 00:09:21,240
".ماراثون"

119
00:09:22,760 --> 00:09:24,660
!حسنًا، لنقم بهذا

120
00:09:25,020 --> 00:09:28,600
.أنتِ مفعمة بالحيويّة
ألا تكرهين سباقات الماراثون؟

121
00:09:28,600 --> 00:09:30,630
!أتطلّع قدمًا لها

122
00:09:31,150 --> 00:09:32,870
!لنتسابق يا ساناي-تشان

123
00:09:32,870 --> 00:09:33,970
،حسنًا

124
00:09:33,970 --> 00:09:37,150
.لكن إذا فزتُ، فلن تأكلي الغداء

125
00:09:37,500 --> 00:09:40,220
!حسنًا! سأبذل قصارى جهدي

126
00:09:40,580 --> 00:09:44,880
.هل أنتِ متأكّدة؟ ساناي عدّاءة سريعة

127
00:09:44,880 --> 00:09:46,590
!لا أظنّني سأخسر

128
00:09:50,650 --> 00:09:52,900
لِمَ الجري في ماراثون؟

129
00:09:53,390 --> 00:09:57,200
لن نركض هذه المسافة الطّويلة
،في حياتنا اليوميّة

130
00:09:57,200 --> 00:10:00,280
فلِمَ علينا القيام بهذا؟

131
00:10:00,280 --> 00:10:01,620
...بالفعل

132
00:10:02,880 --> 00:10:05,350
.تبدو متحمّسًا يا نيشيكاتا

133
00:10:08,240 --> 00:10:09,140
.نيشيكاتا

134
00:10:12,620 --> 00:10:13,670
هل أنت مستعدّ لهذا حقًّا؟

135
00:10:14,960 --> 00:10:17,880
.بالطّبع. كانت فكرتي أساسًا

136
00:10:18,270 --> 00:10:20,380
.حسنًا، أراك لاحقًا

137
00:10:23,530 --> 00:10:25,790
.أنتما مقرّبان

138
00:10:27,580 --> 00:10:29,100
هل تتواعدان؟

139
00:10:29,100 --> 00:10:32,410
!ما-ماذا تقول؟! لا تسِئ الفهم

140
00:10:32,410 --> 00:10:36,360
أنا أنافسها فقط لأنّ الرّابح يستطيع
!أن يأمر الخاسر

141
00:10:37,130 --> 00:10:39,580
...تتنافسان في الماراثون؟ لكن

142
00:10:39,580 --> 00:10:40,870
!ليس من شأنك

143
00:10:42,800 --> 00:10:46,630
.حسنًا، لا أعتقد أنّهما يتواعدان

144
00:10:47,100 --> 00:10:49,090
...نعم، فلو كانا كذلك

145
00:10:49,500 --> 00:10:50,790
!ناكاي-كن

146
00:10:51,210 --> 00:10:52,500
كيف حالك؟

147
00:10:52,500 --> 00:10:56,840
.بأحسن حال! هذا لأنّك تدرّبت معي كلّ يوم

148
00:10:57,690 --> 00:10:59,300
.لنفعل ما بوسعنا

149
00:10:59,760 --> 00:11:00,760
!نعم

150
00:11:00,760 --> 00:11:01,670
.نعم

151
00:11:03,890 --> 00:11:06,090
.لتصرّفا بهذا الشّكل

152
00:11:07,050 --> 00:11:08,930
!حسنًا، تجمّعوا

153
00:11:10,930 --> 00:11:14,010
لِمَ علينا أن نركض؟

154
00:11:14,010 --> 00:11:16,030
.استسلم يا كيمورا

155
00:11:24,870 --> 00:11:28,330
.فرّع عقلك. نعم، اركض بعقل فارغ

156
00:11:29,260 --> 00:11:32,980
.فرّغ عقلك وتجنّب هدر الطّاقة بلا ضرورة

157
00:11:36,940 --> 00:11:39,300
.نلتُ منك هذه المرّة يا تاكاغي-سان

158
00:11:39,300 --> 00:11:43,670
لقد هرولتُ كلّ مساء لأكثر من أسبوعين
!فقط لأجل هذا اليوم

159
00:11:44,340 --> 00:11:47,430
!سواء أكان هناك مطر أو رياح

160
00:11:48,030 --> 00:11:51,390
.لذا من المُحال أن أخسر

161
00:11:53,230 --> 00:11:56,360
.عقل فارغ... فرّغ عقلك

162
00:11:59,580 --> 00:12:00,470
.نيشيكاتا

163
00:12:01,720 --> 00:12:04,290
.ظننتُك قد سبقتني بكثير

164
00:12:04,690 --> 00:12:05,620
.لا

165
00:12:06,390 --> 00:12:08,740
.يكمن المفتاح في التّحكّم بسرعتك

166
00:12:08,740 --> 00:12:10,750
.إنّها لا تعي ذلك

167
00:12:12,170 --> 00:12:14,710
تبدين هادئة، لكنّكِ أسرعت لأنّك ارتعدتِ

168
00:12:14,710 --> 00:12:17,410
عندما لم تستطيعي رؤيتي
لبعض الوقت، صحيح؟

169
00:12:17,410 --> 00:12:18,460
،لا

170
00:12:18,460 --> 00:12:21,670
كنتُ أجري ببطء حتّى الآن لأنّني
.أردتُ أن أعطيك أفضليّة

171
00:12:22,550 --> 00:12:23,420
!أفضليّة؟

172
00:12:23,420 --> 00:12:25,430
!لحظة، هل قرأت ما أفكّر به للتّوّ؟

173
00:12:25,920 --> 00:12:27,640
.حسنًا، سأسبقك

174
00:12:35,740 --> 00:12:37,810
...غـ-غداء

175
00:12:37,810 --> 00:12:39,780
.لا أستطيع تناول الغداء

176
00:12:40,410 --> 00:12:42,260
.ركضتُ بسرعة شديدة

177
00:12:43,210 --> 00:12:45,000
.هذا صحيح. سترين يا تاكاغي-سان

178
00:12:45,000 --> 00:12:48,950
،إذا ظللتِ تركضين بهذه السّرعة
.فسوف تصبحين أبطأ

179
00:12:49,170 --> 00:12:51,690
.عليّ أن أواظب على هذه السّرعة فحسب

180
00:12:53,480 --> 00:12:54,290
...لحظة

181
00:12:54,790 --> 00:12:58,420
هل يُعقل أنّ تاكاغي-سان بارعة
!في الجري في ماراثون؟

182
00:12:58,770 --> 00:12:59,810
،إن كان كذلك

183
00:13:00,300 --> 00:13:01,250
!فهذه مشكلة

184
00:13:02,280 --> 00:13:04,250
!لا وقت لديّ لأقضيه في تفريغ عقلي

185
00:13:06,800 --> 00:13:10,760
!إنّها تعود؟! أهي أسرع من الفتيان؟

186
00:13:21,950 --> 00:13:24,600
.تزعزعت وتيرتي، لكن لحقتُ بها

187
00:13:26,110 --> 00:13:28,950
إن استطعت لمسي، فيمكنك أن تكون
.الرّابح يا نيشيكاتا

188
00:13:37,250 --> 00:13:41,930
!لا أستطيع لمسها أمام كلّ هؤلاء النّاس

189
00:13:42,210 --> 00:13:45,930
!يا إلهي! تبًّا لكِ يا تاكاغي-سان

190
00:13:45,930 --> 00:13:48,180
!تعمّدتِ إفساد وتيرة سرعتي

191
00:13:52,970 --> 00:13:54,070
،تاكاغي-سان

192
00:13:55,550 --> 00:13:59,810
،إن استطعتِ أن تسبقيني بخمسين مترًا
.فيمكنكِ أن تكوني الفائزة

193
00:14:00,190 --> 00:14:01,090
حقًّا؟

194
00:14:01,090 --> 00:14:02,290
!وقعت في الفخّ

195
00:14:02,290 --> 00:14:03,270
.نعم

196
00:14:03,870 --> 00:14:07,230
!سأدمّر وتيرة سرعتك هذه المرّة

197
00:14:07,230 --> 00:14:08,990
!تستحقّين هذا يا تاكاغي-سان

198
00:14:09,550 --> 00:14:10,950
.فزتُ إذًا

199
00:14:11,740 --> 00:14:13,950
.فالفتيات يعُدن من هنا

200
00:14:14,900 --> 00:14:16,660
على الفتيان أن يركضوا مسافة أطول
بكيلومترين، صحيح؟

201
00:14:17,190 --> 00:14:18,340
.حظًّا سعيدًا

202
00:14:18,930 --> 00:14:20,800
!هذا ليس منصفًا يا تاكاغي-سان

203
00:14:22,130 --> 00:14:24,220
.سألتُك مرارًا لأتأكّد من أنّك أردت فعل هذا

204
00:14:24,220 --> 00:14:26,870
نيشيكاتا. لماذا توقّفت؟

205
00:14:35,340 --> 00:14:40,320
أرأيت؟ تبدأ بالإحساس بالألم
.في جوانبك وتشعر بالجوع

206
00:14:40,320 --> 00:14:43,520
.لا شيء حميد تجنيه من ماراثون

207
00:14:43,830 --> 00:14:47,460
إذا استهلكتَ طاقتك للجري
،بدلاً من التّذمّر

208
00:14:47,460 --> 00:14:49,440
.فقد تتمكّن من الجري أسرع قليلاً

209
00:14:49,440 --> 00:14:51,750
لِمَ أفعل شيئًا عديم الجدوى؟

210
00:14:52,080 --> 00:14:55,190
الجري أم التّذمّر، أيّهما بلا جدوى أكثر؟

211
00:14:56,650 --> 00:14:58,250
...غداء

212
00:14:58,640 --> 00:15:01,000
.أنا جائع

213
00:15:01,000 --> 00:15:02,710
...جائعة للغاية

214
00:15:11,080 --> 00:15:12,050
".أضلاع"

215
00:15:14,060 --> 00:15:17,550
.سخرت منّي تاكاغي-سان كثيرًا اليوم من جديد

216
00:15:18,380 --> 00:15:21,390
.تبًّا... سترين يا تاكاغي-سان

217
00:15:21,390 --> 00:15:22,460
ماذا؟

218
00:15:22,460 --> 00:15:23,440
هل من مشكلة؟

219
00:15:26,030 --> 00:15:28,760
.نيشيكاتا، أضلاعك حسّاسة جدًا للدّغدغة

220
00:15:29,140 --> 00:15:31,240
.تفعل هذا كلّما سنحت لها الفرصة

221
00:15:31,620 --> 00:15:35,700
،تقول أن أضلاعي حسّاسة للدّغدغة
لكن أليست أضلاع الجميع هكذا؟

222
00:15:38,400 --> 00:15:39,380
...تاكاغي-سان

223
00:15:40,850 --> 00:15:41,940
ما رأيكِ بنزال؟

224
00:15:42,260 --> 00:15:44,830
.من يضحك أوّلاً يخسر

225
00:15:45,500 --> 00:15:46,340
.حسنًا

226
00:15:47,070 --> 00:15:49,570
.سنبدأ فورًا

227
00:15:50,060 --> 00:15:50,920
.حسنًا

228
00:15:51,690 --> 00:15:55,460
نلتُ منك الآن! فشلتِ في تقييم
!الوضع يا تاكاغي-سان

229
00:15:56,990 --> 00:16:01,460
أكسب الأفضليّة عليكِ لأنّ كلتا يديك
!مشغولتان بالإمساك بدرّاجتك

230
00:16:02,440 --> 00:16:06,710
أتعتقدين أنّك قادرة على حماية
!أضلاعك هكذا؟

231
00:16:07,270 --> 00:16:08,570
،بالمناسبة

232
00:16:09,440 --> 00:16:12,530
.أضلاعي ليست حسّاسة للدّغدغة

233
00:16:15,380 --> 00:16:15,950
.خدعتك

234
00:16:24,700 --> 00:16:26,130
.مذهل، تحمّلتها

235
00:16:26,630 --> 00:16:28,330
!كان ذلك وشيكًا

236
00:16:28,330 --> 00:16:30,700
!لكن قالت أنّها لا تتدغدغ؟

237
00:16:30,700 --> 00:16:32,090
.إنّها تتحايل

238
00:16:33,390 --> 00:16:35,550
!إنّها مكشوفة

239
00:16:36,520 --> 00:16:39,510
هل يعقل أنّها تقول الحقيقة؟

240
00:16:40,720 --> 00:16:41,730
...لا

241
00:16:42,650 --> 00:16:46,550
.كلّ ما عليّ هو دغدغتها وسأعرف

242
00:16:50,650 --> 00:16:51,650
ما الأمر؟

243
00:16:53,450 --> 00:16:56,400
.لـ-لا شيء

244
00:16:57,880 --> 00:17:00,760
.هذا محرج... بعض الشّيء

245
00:17:01,130 --> 00:17:03,490
هل أستطيع أن أوخزها حقًّا؟

246
00:17:04,480 --> 00:17:06,690
ألن يكون تحرّشًا جنسيًّا؟

247
00:17:11,050 --> 00:17:13,340
.إن لم تفعل، فسأهاجم ثانية

248
00:17:16,760 --> 00:17:18,290
...يا إلهي

249
00:17:18,290 --> 00:17:22,800
ظننتُها خطّة مثاليّة، لكن لم أدرك
.وجود عقبة فجائيّة كهذه

250
00:17:23,730 --> 00:17:25,620
.هذا خطير جدًّا

251
00:17:25,620 --> 00:17:28,780
ينبغي أن أحافظ على مسافة
.بيني وبينها لننتهي بتعادل

252
00:17:39,420 --> 00:17:42,550
!تاكاغي-سان! وجهك غير طبيعيّ

253
00:17:44,030 --> 00:17:44,970
.ضحكت

254
00:17:48,210 --> 00:17:50,740
هذا صحيح. نسيت أنّ

255
00:17:50,740 --> 00:17:54,920
لدى تاكاغي-سان حركة خاصّة حيث تقوم
...رسم تعابير مضحكة على وجهها

256
00:17:55,780 --> 00:17:56,730
،حسنًا إذًا

257
00:17:58,240 --> 00:18:00,570
ماذا ينبغي أن أجعلك تفعل؟

258
00:18:00,570 --> 00:18:02,760
ماذا؟! يوجد جزاء؟

259
00:18:03,390 --> 00:18:06,230
.بالطّبع. فهذا نزال

260
00:18:08,190 --> 00:18:09,630
.دعني أرى

261
00:18:11,790 --> 00:18:13,650
.ممنوع أكل الأرزّ طيلة حياتك

262
00:18:14,890 --> 00:18:16,610
!هذا قاسٍ

263
00:18:17,420 --> 00:18:19,160
.أمزح فحسب

264
00:18:22,780 --> 00:18:25,280
أنت ممنوع من قراءة
."%حبّ من طرف واحد 100"

265
00:18:28,380 --> 00:18:29,990
.هذا قاسٍ أيضًا على ما أعتقد

266
00:18:35,400 --> 00:18:38,080
ما رأيك أن توخز أضلاعي؟

267
00:18:43,450 --> 00:18:45,480
أهذا هو الجزاء؟

268
00:18:45,480 --> 00:18:46,270
.نعم

269
00:18:47,060 --> 00:18:47,980
...حسنًا، إذًا

270
00:18:57,430 --> 00:18:59,570
!فهمت

271
00:18:59,570 --> 00:19:03,990
تريد أن تستمتع وهي تشاهدني
.مُحرجًا وأسعى جاهدًا للمسها

272
00:19:04,500 --> 00:19:05,950
!من المستحيل أن يحدث هذا

273
00:19:08,250 --> 00:19:10,280
،على ذكر الأمر

274
00:19:10,280 --> 00:19:14,960
أظنّها المرّة الأولى الّتي سألمس
.فيها تاكاغي-سان

275
00:19:15,880 --> 00:19:20,840
.لا، لا تفكّر في الأمر. فأنا أوخزها فحسب

276
00:19:21,500 --> 00:19:22,640
ما الأمر؟

277
00:19:31,320 --> 00:19:34,980
.أرأيت؟ أضلاعي غير حسّاسة للدّغدغة

278
00:19:35,870 --> 00:19:36,600
...نعم

279
00:19:44,470 --> 00:19:46,330
.لكن إبطي كذلك

280
00:19:49,550 --> 00:19:51,930
!لا أستطيع لمس هذا المكان

281
00:19:57,860 --> 00:19:58,660
".حسرة"

282
00:20:00,130 --> 00:20:01,420
!نسيت

283
00:20:02,010 --> 00:20:02,730
ماذا؟

284
00:20:02,730 --> 00:20:04,750
!هذا فظيع

285
00:20:04,750 --> 00:20:05,640
ما هو؟

286
00:20:06,310 --> 00:20:09,350
!لم نقم باختبار الشّجاعة أثناء عطلة الصّيف

287
00:20:12,010 --> 00:20:13,280
.هذا صحيح

288
00:20:14,020 --> 00:20:16,550
!لنذهب بعد المدرسة! يجب أن نفعل ذلك

289
00:20:16,550 --> 00:20:18,580
حقًّا؟

290
00:20:25,060 --> 00:20:27,880
!هذا المكان مسكون

291
00:20:29,210 --> 00:20:30,830
هل سنذهب حقًّا؟

292
00:20:31,080 --> 00:20:33,170
!هيّا بنا

293
00:20:35,390 --> 00:20:37,970
.لا يبدو أنّ هذا سيكون اختبارًا لشجاعتنا

294
00:20:40,430 --> 00:20:42,350
!الظّلام حالك

295
00:20:45,240 --> 00:20:46,450
!فجوة

296
00:20:50,320 --> 00:20:51,180
!تعويذة

297
00:20:51,720 --> 00:20:52,850
!يبدو هذا سيّئًا

298
00:20:54,760 --> 00:20:55,810
!طبل فولاذيّ؟

299
00:20:55,810 --> 00:20:57,830
!ماذا؟، ماذا؟ لماذا، لماذا؟

300
00:20:59,040 --> 00:21:00,610
.هذا ليس مخيفًا إطلاقًا

301
00:21:00,610 --> 00:21:04,320
حقًّا؟ ليس مخيفًا جدًّا؟

302
00:21:04,660 --> 00:21:05,760
.إطلاقًا

303
00:21:10,810 --> 00:21:12,000
!انظرا

304
00:21:13,050 --> 00:21:15,600
!صحن طائر! مذهل

305
00:21:15,600 --> 00:21:17,390
ما الّذي جاء به إلى هنا؟

306
00:21:17,390 --> 00:21:20,240
!هذا مخيف بعض الشّيء! هل هو شبح؟

307
00:21:20,240 --> 00:21:22,860
.هذا لأنّنا في الظّلّ، وهناك تأثير نفق الرّياح

308
00:21:25,820 --> 00:21:27,720
!هذا مسلٍّ للغاية

309
00:21:28,590 --> 00:21:30,630
!لا تطارديني

310
00:21:37,370 --> 00:21:38,680
رضيتِ؟

311
00:21:39,190 --> 00:21:40,020
!نعم

312
00:21:40,020 --> 00:21:40,860
.نعم

313
00:21:41,430 --> 00:21:44,320
!شعرت الآن بعطلة الصّيف جيّدًا

314
00:21:44,620 --> 00:21:46,160
.هـ-هكذا إذًا

315
00:21:46,990 --> 00:21:47,870
...لكن

316
00:21:51,430 --> 00:21:54,680
.لن تعود عطلة الصّيف

317
00:21:55,980 --> 00:21:56,660
...نعم

318
00:21:58,320 --> 00:22:02,330
.أصبحتِ محبطة فجأة الآن
...كم هذا مزعج