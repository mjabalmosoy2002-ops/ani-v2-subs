1
00:00:03,450 --> 00:00:04,550
...أخيرًا

2
00:00:05,150 --> 00:00:06,560
!أخيرًا

3
00:00:08,520 --> 00:00:11,530
!أخيرًا، حصلتُ على أوّل هاتف نقّال لي

4
00:01:44,140 --> 00:01:44,960
".هاتف نقّال"

5
00:01:47,730 --> 00:01:49,570
.حسنًا، أضفتُ رقمك

6
00:01:50,050 --> 00:01:50,960
.شكرًا

7
00:01:51,220 --> 00:01:52,020
.العفو

8
00:02:00,860 --> 00:02:02,180
حصلت على هاتف نقّال؟

9
00:02:02,180 --> 00:02:03,050
!ها هي ذي

10
00:02:03,920 --> 00:02:05,710
أهذا أحدث نموذج؟

11
00:02:06,180 --> 00:02:08,630
.كنتُ أفكّر بالتّحديث لذلك أيضًا

12
00:02:08,630 --> 00:02:09,920
هل يمكنني رؤيته؟

13
00:02:09,920 --> 00:02:10,720
.بالتّأكيد

14
00:02:13,070 --> 00:02:14,690
.إنّه خفيف جدًّا

15
00:02:16,330 --> 00:02:17,940
.كنتُ أنتظر هذا اليوم

16
00:02:17,940 --> 00:02:20,700
.خطّتي لاستفزاز تاكاغي-سان بهاتفي النقّال

17
00:02:20,700 --> 00:02:24,480
!سأستخدمها... سأفوز على تاكاغي-سان

18
00:02:25,820 --> 00:02:27,970
.هكذا يعمل إذًا

19
00:02:29,770 --> 00:02:31,260
.شكرًا يا نيشيكاتا

20
00:02:31,260 --> 00:02:32,060
.لا عليكِ

21
00:02:41,650 --> 00:02:42,450
ماذا؟

22
00:02:43,600 --> 00:02:45,320
...لا شيء

23
00:02:57,880 --> 00:03:01,170
ظننتُ أنّ تاكاغي-سان ستسألني
.عن عنوان بريدي الإلكترونيّ

24
00:03:02,020 --> 00:03:02,880
ماذا الآن؟

25
00:03:03,820 --> 00:03:04,920
هل من مشكلة؟

26
00:03:04,920 --> 00:03:05,980
...لا

27
00:03:06,780 --> 00:03:07,580
.لا شيء

28
00:03:09,850 --> 00:03:10,710
...تبًّا

29
00:03:11,370 --> 00:03:13,990
،إن كنت لا أستطيع الاتّصال بها
.فلا أستطيع تنفيذ خطّتي

30
00:03:18,910 --> 00:03:21,470
لِمَ لا أسألها فحسب إذًا؟

31
00:03:22,010 --> 00:03:25,140
!لماذا لم أفكّر بشيء بهذه البساطة سابقًا؟

32
00:03:25,920 --> 00:03:27,010
.تاكاغي-سان

33
00:03:27,010 --> 00:03:27,810
ما الأمر؟

34
00:03:28,400 --> 00:03:29,700
...ا-المعذرة

35
00:03:31,420 --> 00:03:34,510
...عـ-عنوانك

36
00:03:37,660 --> 00:03:39,300
!آ-آسف، لا شيء

37
00:03:40,760 --> 00:03:43,940
!لـ-لماذا؟! لماذا أنا متوتّر جدًّا؟

38
00:03:43,940 --> 00:03:45,070
!اهدأ

39
00:03:45,450 --> 00:03:48,390
أنا أسأل تاكاغي-سان عن عنوان
!بريدها الإلكترونيّ فحسب

40
00:03:50,530 --> 00:03:54,710
هل أنا على وشك أن أطلب من فتاة
!أن تمنحني عنوان بريدها الإلكترونيّ؟

41
00:03:56,650 --> 00:03:59,490
...هذا... نوعًا ما

42
00:04:00,460 --> 00:04:01,860
!أليس كذلك؟

43
00:04:03,530 --> 00:04:04,550
.أخبرني يا نيشيكاتا

44
00:04:05,230 --> 00:04:07,550
هل تريد أن تسألني عن شيء ما؟

45
00:04:07,550 --> 00:04:08,760
!لـ-لا، لا، لا

46
00:04:08,760 --> 00:04:10,770
!لا، لا شيء! صدّقيني

47
00:04:15,280 --> 00:04:18,770
كنتُ متأكّدة أنّك أردت أن تسألني
.عن عنوان بريدي الإلكترونيّ

48
00:04:19,700 --> 00:04:20,670
!إنّها تعلم

49
00:04:21,690 --> 00:04:24,280
!لحظة! أليست هذه فرصتي؟

50
00:04:24,280 --> 00:04:28,510
أستطيع الحصول على عنوانها
!بالإجابة بـ"نعم" الآن

51
00:04:28,510 --> 00:04:30,410
.لقد أصبحتِ مستهترة يا تاكاغي-سان

52
00:04:33,550 --> 00:04:35,850
...فـ-في الحقيقة، نعم

53
00:04:35,850 --> 00:04:37,710
لماذا كذبت قبل قليل؟

54
00:04:38,070 --> 00:04:39,820
هل لأنّك انحرجت؟

55
00:04:40,390 --> 00:04:41,190
.أخبرني

56
00:04:41,960 --> 00:04:43,420
!تـ-تبًّا لكِ يا تاكاغي-سان

57
00:04:44,120 --> 00:04:47,390
.لـ-لا... الأمر ليس هكذا

58
00:04:51,310 --> 00:04:52,560
حقًّا؟

59
00:04:52,970 --> 00:04:55,160
.من المفيد امتلاكه في حال حدث شيء

60
00:04:55,540 --> 00:04:56,760
مثل ماذا؟

61
00:04:56,760 --> 00:04:57,740
.شيء ما

62
00:04:58,540 --> 00:05:01,040
ممّن طلبت أيضًا؟

63
00:05:03,130 --> 00:05:06,770
.كيمورا وتاكاو وناكاي-كن

64
00:05:06,770 --> 00:05:07,650
وأيضًا؟

65
00:05:08,530 --> 00:05:10,250
.لم أطلب من عدد كبير بعد

66
00:05:11,960 --> 00:05:15,660
!نعم، معك حقّ! أنتِ أوّل فتاة طلبت منها

67
00:05:15,660 --> 00:05:18,930
!لذا أسرعي! أعطيني عنوان بريدك الإلكترونيّ

68
00:05:20,690 --> 00:05:23,060
تريد مبادلتي الرّسائل؟

69
00:05:26,320 --> 00:05:27,440
!لـ-لا

70
00:05:27,440 --> 00:05:30,890
،أطلبه لتنفيذ خطّتي في استفزازك بالرّسائل

71
00:05:30,890 --> 00:05:32,810
!لذا الأمر ليس هكذا صدّقيني

72
00:05:32,810 --> 00:05:35,640
!لا يوجد أيّ شيء غريب، أقسم

73
00:05:45,510 --> 00:05:47,580
.عرفت أنّه كان شيئًا كهذا

74
00:05:54,050 --> 00:05:57,000
،خطّتك لاستفزازي قد أفسِدت

75
00:05:57,370 --> 00:05:59,010
.لكن لنتبادل عناوين البريد الإلكترونيّ

76
00:06:06,440 --> 00:06:07,240
...نعم

77
00:06:10,270 --> 00:06:11,730
،اعتذارًا عن استفزازك لي

78
00:06:11,730 --> 00:06:14,210
ساعدني في التّنظيف الأسبوع المقبل
،عندما يحين واجبي النّهاريّ

79
00:06:14,850 --> 00:06:16,270
.لم أستفزّك

80
00:06:16,610 --> 00:06:18,220
!كنتُ على وشك أن أستفزّك

81
00:06:19,030 --> 00:06:22,290
لكن لو لم أكتشف لفعلتَ ذلك، صحيح؟

82
00:06:22,290 --> 00:06:23,620
...نـ-نعم

83
00:06:24,000 --> 00:06:25,000
.تقرّر الأمر إذًا

84
00:06:28,740 --> 00:06:29,700
...لكن قبل ذلك

85
00:06:30,070 --> 00:06:31,440
.سأتكلّم معك عندما أصل إلى المنزل

86
00:06:36,760 --> 00:06:38,420
قبل ذلك؟

87
00:06:40,710 --> 00:06:45,260
هل هذا يعني... سوف تستفزّني
حتّى عندما أكون في المنزل أيضًا؟

88
00:06:49,060 --> 00:06:50,630
.أريد هاتفًا نقّالاً

89
00:06:52,670 --> 00:06:57,770
،لكن عندما طلبت من أمّي البارحة
.قالت أنّني ما زلت صغيرة جدًّا

90
00:06:57,770 --> 00:07:00,440
من الطّبيعيّ أن تقول ذلك عندما
.تطلبينه منها فجأة

91
00:07:00,440 --> 00:07:02,400
.دائمًا ما تقولين أشياء فجأة

92
00:07:02,400 --> 00:07:04,420
.هذا غير صحيح

93
00:07:04,420 --> 00:07:06,900
.لقد أردته منذ مدّة

94
00:07:07,180 --> 00:07:08,700
منذ متى بالضّبط؟

95
00:07:08,700 --> 00:07:10,150
...في الواقع

96
00:07:10,730 --> 00:07:13,940
حوالي أسبوع؟

97
00:07:15,260 --> 00:07:18,120
أي حوالي ثلاثة أيّام إذًا، صحيح؟

98
00:07:18,490 --> 00:07:20,820
.على كلّ حال، هذا يعني فجأة

99
00:07:22,830 --> 00:07:25,410
!ما هذا؟! هذا ليس عدلاً

100
00:07:25,410 --> 00:07:26,410
!فظيع

101
00:07:26,410 --> 00:07:28,390
!بونبوكو الخارق

102
00:07:28,390 --> 00:07:31,310
!بون، بون، بون

103
00:07:31,970 --> 00:07:34,560
لكنّ كثيرًا من الأطفال لديهم واحد
.في هذه الأيام

104
00:07:35,130 --> 00:07:37,010
.ربّما أحتاج لواحد أيضًا

105
00:07:37,010 --> 00:07:39,920
!أليس كذلك؟! تريدين واحدًا أيضًا، صحيح؟

106
00:07:39,920 --> 00:07:42,940
!لنطلب من أمّهاتنا جميعًا

107
00:07:43,200 --> 00:07:45,220
تريدين واحدًا أيضًا، أليس كذلك
!يا ساناي-تشان؟

108
00:07:45,220 --> 00:07:46,900
.لا، لا أريد

109
00:07:47,180 --> 00:07:48,900
!لِمَ لا؟

110
00:07:48,900 --> 00:07:51,010
.لنتبادل الرّسائل وما شابه

111
00:07:51,010 --> 00:07:52,820
...لأنّني

112
00:07:53,980 --> 00:07:55,290
.أملك واحدًا بالفعل

113
00:07:56,580 --> 00:07:58,180
!كيف حدث هذا؟

114
00:07:58,880 --> 00:08:02,640
أعطاني والداي واحدًا لأنّني أتأخر أحيانًا
.عن المنزل من ناديّ بعد المدرسة

115
00:08:04,840 --> 00:08:07,270
.مع ذلك، كان ينبغي أن تخبرينا

116
00:08:07,270 --> 00:08:08,340
!وجدتها

117
00:08:08,990 --> 00:08:12,180
إذا أخبرت والديّ أن ساناي-تشان تملك
.واحدًا، فربّما سيشتريانه لي حينها

118
00:08:12,540 --> 00:08:14,300
.هذه فكرة جيّدة

119
00:08:14,570 --> 00:08:15,750
.سأخبرهما بذلك أيضًا

120
00:08:15,750 --> 00:08:17,720
!سنحصل على هاتف نقّال حتمًا

121
00:08:17,720 --> 00:08:19,810
!لنتبادل رسائل كثيرة فيما بيننا

122
00:08:19,810 --> 00:08:23,110
أريد أن ألعب شيريتوري وكلمات
!متقاطعة حتّى أخلد إلى النّوم

123
00:08:23,950 --> 00:08:25,340
...يبدو هذا مزعجًا

124
00:08:25,340 --> 00:08:28,750
لهذا لا يريد والداك شراء واحد
.لكِ على الأرجح

125
00:08:29,300 --> 00:08:30,940
!لنروِ روايات مخيفة إذًا

126
00:08:31,650 --> 00:08:34,320
.ستكونين أوّل من ينسحب على الأرجح

127
00:08:36,450 --> 00:08:38,120
!سـ-سأكون بخير

128
00:08:38,120 --> 00:08:39,640
.هيّا. اِروي لي واحدة حالاً

129
00:08:41,310 --> 00:08:45,670
في إحدى اللّيالي، تتلقّين مكالمة
.من رقم مجهول

130
00:08:45,670 --> 00:08:50,050
.تجيبين عليه لتسمعي أحدًا ينوح

131
00:08:51,930 --> 00:08:55,770
تغلقين السّمّاعة بسرعة ولا تتلقّين
.مكالمة من ذلك الرّقم ثانية

132
00:08:55,770 --> 00:08:56,570
—هذا جيّـ

133
00:08:56,210 --> 00:08:59,530
.لكن ينتابك الفضول وتتّصلين به

134
00:08:59,530 --> 00:09:00,970
!ماذا؟! لماذا؟

135
00:09:00,970 --> 00:09:04,310
...فلا تسمعين شيئًا

136
00:09:04,570 --> 00:09:06,130
.هذا مريح

137
00:09:06,710 --> 00:09:10,550
لكن تتلقّين فاتورة مكالمات هاتفيّة

138
00:09:10,550 --> 00:09:12,290
.بمائة ألف ينّ

139
00:09:13,820 --> 00:09:16,660
!الفواتير المزيّفة مخيفة

140
00:09:17,500 --> 00:09:19,830
!أنت أكثر رعبًا يا يوكاري-تشان

141
00:09:24,140 --> 00:09:24,940
".رعب"

142
00:09:31,910 --> 00:09:33,220
.صباح الخير يا نيشيكاتا

143
00:09:33,680 --> 00:09:35,010
.صباح الخير

144
00:09:35,430 --> 00:09:38,980
.التزمت بوعدك ذاك

145
00:09:39,410 --> 00:09:40,310
...نعم

146
00:09:46,810 --> 00:09:47,770
.دعيني أساعدك

147
00:09:48,060 --> 00:09:49,060
.شكرًا

148
00:09:57,440 --> 00:09:58,920
.تبدو متعبًا

149
00:09:59,900 --> 00:10:01,590
...ليس تمامًا

150
00:10:02,740 --> 00:10:07,210
هل سهرت لمشاهدة
حبّ من طرف واحد 100%"؟"

151
00:10:07,550 --> 00:10:08,890
!لا

152
00:10:08,890 --> 00:10:09,740
حقًّا؟

153
00:10:11,340 --> 00:10:12,630
ماذا إذًا؟

154
00:10:12,630 --> 00:10:13,810
...لا شيء مميّز

155
00:10:14,510 --> 00:10:16,610
هل كنت تراسل زملاءك في الفصل؟

156
00:10:17,340 --> 00:10:18,960
...نـ-نعم، أعتقد

157
00:10:18,960 --> 00:10:19,760
حول ماذا؟

158
00:10:21,120 --> 00:10:21,920
ماذا؟

159
00:10:22,230 --> 00:10:24,750
ليس من عادة تاكاغي-سان
.أن تكون فضوليّة هكذا

160
00:10:25,610 --> 00:10:26,680
...هذا

161
00:10:28,230 --> 00:10:33,570
من الممتع جدًّا مراسلة النّاس عندما
.تحصل على أوّل هاتف نقّال لك

162
00:10:33,900 --> 00:10:35,560
.كنتُ قد أدمنت على ذلك أيضًا

163
00:10:37,050 --> 00:10:40,410
.ومن ثمّ ينتهي المطاف بك في ورطة

164
00:10:40,410 --> 00:10:44,270
...شخص ما يتبادل الرّسائل مع تاكاغي-سان

165
00:10:44,700 --> 00:10:45,600
من هو؟

166
00:10:47,240 --> 00:10:50,220
فتاة من فصلنا؟

167
00:10:50,220 --> 00:10:51,020
.لا

168
00:10:53,970 --> 00:10:57,170
.هدّئ من روعك. حدث شيء كهذا من قبل

169
00:10:58,420 --> 00:11:01,930
آخر مرّة ركبت فيها درّاجة
.مع شخص آخر كانت مع أبي

170
00:11:03,790 --> 00:11:06,590
عرفت! أبوك؟

171
00:11:06,590 --> 00:11:09,260
ولِمَ أفعل ذلك مع أبي؟

172
00:11:09,760 --> 00:11:11,190
...أ-أصبت

173
00:11:12,190 --> 00:11:13,060
أينتابك فضول؟

174
00:11:15,470 --> 00:11:16,270
...ليس تمامًا

175
00:11:17,330 --> 00:11:22,270
إذا أخبرتني بما تتبادل الرّسائل حوله
.مع الفتيان، فسوف أخبرك أنا

176
00:11:23,250 --> 00:11:24,630
.لا يهمّني

177
00:11:27,550 --> 00:11:31,090
.لحظة. يمكنني ضرب عصفورين بحجر واحد

178
00:11:32,410 --> 00:11:36,100
!يتوقّف مرحكِ هنا يا تاكاغي-سان

179
00:11:37,890 --> 00:11:38,800
،في الحقيقة

180
00:11:39,400 --> 00:11:43,730
.كنّا نتبادل مقاطع فيديو طريفة البارحة

181
00:11:45,330 --> 00:11:46,350
مثل ماذا؟

182
00:11:46,350 --> 00:11:48,850
.نعم، نجح الأمر

183
00:11:53,460 --> 00:11:56,530
...الرّابط الّذي أرسله لي كيمورا

184
00:12:11,420 --> 00:12:14,830
.لم أستطع النّوم جيّدًا بسبب هذا

185
00:12:19,580 --> 00:12:20,870
هل أرسلت لي شيئًا؟

186
00:12:20,870 --> 00:12:24,420
.نعم، فيديو لحيوان ظريف

187
00:12:26,620 --> 00:12:27,760
!ليس كذلك

188
00:12:31,520 --> 00:12:32,670
.سنرى

189
00:12:34,940 --> 00:12:38,320
إنه مخيف جدًّا لدرجة أنّ الكلمات قد
ضاعت منك، صحيح يا تاكاغي-سان؟

190
00:12:40,540 --> 00:12:41,850
.نيشيكاتا

191
00:12:41,850 --> 00:12:43,410
ما الأمر يا تاكاغي-سان؟

192
00:12:44,780 --> 00:12:47,540
هل هذا شيء تشاهده دومًا؟

193
00:12:50,720 --> 00:12:51,890
!لـ-لماذا؟

194
00:12:51,890 --> 00:12:53,710
!لحظة. ما هذا؟

195
00:12:53,710 --> 00:12:55,500
.ليس هذا ما أرسلته

196
00:12:56,040 --> 00:12:56,840
ماذا؟

197
00:12:57,250 --> 00:12:58,770
.مجرّد سؤال وددت طرحه

198
00:13:00,490 --> 00:13:03,760
.حسنًا إذًا، سنرى ما أرسله لي نيشيكاتا

199
00:13:05,710 --> 00:13:08,580
!خـ-خدعتني مجدّدًا! تبًّا

200
00:13:11,240 --> 00:13:12,560
.إنّه فيديو لحيوان فعلاً

201
00:13:13,210 --> 00:13:16,130
هذا ظريف. أهو ماعز؟

202
00:13:16,510 --> 00:13:18,910
.جيّد، جيّد. إنّها غير متأهّبة

203
00:13:19,500 --> 00:13:20,640
.سيبدأ ذلك قريبًا

204
00:13:23,930 --> 00:13:26,850
!نعم، هيا! ارتعدي خوفًا يا تاكاغي-سان

205
00:13:30,440 --> 00:13:31,490
.مخيف

206
00:13:34,270 --> 00:13:36,460
أليس مخيفًا؟

207
00:13:36,460 --> 00:13:38,080
...إنّه مخيف، لكن

208
00:13:38,750 --> 00:13:41,030
.لا يكون كذلك عند مشاهدته في الصّباح

209
00:13:45,270 --> 00:13:46,120
.معها حقّ

210
00:13:48,360 --> 00:13:50,260
إذًا هذه هي الأشياء الّتي يهتمّ
.بها أنتم الصّبيان

211
00:13:50,720 --> 00:13:52,490
.أنتم الصّبيان مُضحكون

212
00:13:53,130 --> 00:13:57,570
مـ-ماذا عنك؟ عمّاذا تتحدّثين ومع من؟

213
00:13:59,040 --> 00:14:00,610
.أتحدّث عن أمور طبيعيّة

214
00:14:01,360 --> 00:14:03,580
!هذا ليس جوابًا

215
00:14:03,580 --> 00:14:04,680
ليس كذلك؟

216
00:14:05,340 --> 00:14:10,040
."أتكلم مع شخص يبدأ بـ"إي

217
00:14:10,040 --> 00:14:11,810
...إي؟ إي

218
00:14:12,510 --> 00:14:15,760
إي... إيشي-سان؟

219
00:14:15,760 --> 00:14:16,660
.خطأ

220
00:14:17,600 --> 00:14:19,310
."بعد "إي" يأتي "تو

221
00:14:19,310 --> 00:14:21,480
إيتو... إيتو؟

222
00:14:21,480 --> 00:14:24,020
ماذا؟ إيتو؟ ذاك الفتى؟

223
00:14:25,040 --> 00:14:26,740
.لا، ليس إيتو-كن من فصلنا

224
00:14:27,320 --> 00:14:29,940
."الأخير هو "كو

225
00:14:30,800 --> 00:14:33,220
إيتو... كو؟

226
00:14:33,220 --> 00:14:36,470
ماذا؟

227
00:14:45,150 --> 00:14:49,250
،سبع وتسعون، ثمان وتسعون

228
00:14:49,250 --> 00:14:51,250
...تسع وتسعون

229
00:14:52,260 --> 00:14:53,920
.تبًّا لك يا تاكاغي-سان

230
00:14:53,920 --> 00:14:57,150
،ظننت أنّني سأنتقم منها اليوم

231
00:14:57,950 --> 00:15:00,400
.لكن انهزمتُ من جديد

232
00:15:03,900 --> 00:15:06,530
.لا، لم ينته اليوم بعد

233
00:15:07,820 --> 00:15:11,010
،إن لم ينجح في الصّباح
.فسأرسل واحدًا لها في اللّيل

234
00:15:11,950 --> 00:15:16,140
مقطع فيديو أكثر رعبًا أخبرني به
.كيمورا بعد الدّوام المدرسيّ اليوم

235
00:15:17,310 --> 00:15:19,380
...إنّه مخيف، لهذا لم أشاهده، لكن

236
00:15:19,900 --> 00:15:21,600
—هذا حتمًا سوف

237
00:15:23,740 --> 00:15:24,880
تاكاغي-سان؟

238
00:15:26,460 --> 00:15:30,390
ينتابني إحساس بأنّني سأؤدّي مزيدًا
.من تمارين الضّغط بعد هذا

239
00:15:33,910 --> 00:15:35,320
مرحبًا، نيشيكاتا؟

240
00:15:35,320 --> 00:15:36,120
...نعم

241
00:15:36,840 --> 00:15:38,780
.رأيت أن الوقت قد اقترب

242
00:15:38,780 --> 00:15:40,270
و-وقت ماذا؟

243
00:15:40,940 --> 00:15:42,710
.وقت إرسال فيديو مخيف لي

244
00:15:43,690 --> 00:15:45,610
عـ-عمّ تتحدثين؟

245
00:15:47,520 --> 00:15:52,120
أتعتقدين أنّني سأكشف
عن خطّتي بهذه البساطة؟

246
00:15:52,120 --> 00:15:53,200
—المعركة هي

247
00:15:53,200 --> 00:15:56,290
...سترى بعد أن تنهي المكاملة

248
00:15:59,020 --> 00:16:00,190
أهذا ما كنت تفكّر فيه؟

249
00:16:00,690 --> 00:16:02,690
.لـ-لا... لم أكن كذلك

250
00:16:03,370 --> 00:16:04,310
حقًّا؟

251
00:16:04,310 --> 00:16:05,980
...حقًّا

252
00:16:09,310 --> 00:16:10,760
حسنًا، هل ستنام قريبًا؟

253
00:16:11,910 --> 00:16:14,810
...نعم... على الأرجح

254
00:16:15,460 --> 00:16:16,280
.هكذا إذًا

255
00:16:17,160 --> 00:16:19,360
.كنت على وشك فعل ذلك أيضًا

256
00:16:20,280 --> 00:16:21,540
.هكذا إذًا

257
00:16:25,830 --> 00:16:27,170
.هذا شعور غريب

258
00:16:29,200 --> 00:16:31,920
.هذه أوّل مرة أتكلّم معك فيها ليلاً

259
00:16:32,950 --> 00:16:34,360
.هذا يجعل قلبي يخفق بعض الشّيء

260
00:16:36,920 --> 00:16:38,900
.أراك غدًا إذًا. تصبح على خير

261
00:16:39,610 --> 00:16:41,650
...تصبحين على خير

262
00:16:48,960 --> 00:16:49,840
نيشيكاتا؟

263
00:16:50,370 --> 00:16:51,250
ما-ماذا؟

264
00:16:52,180 --> 00:16:53,300
ألم تغلق بعد؟

265
00:16:54,670 --> 00:16:55,470
.الهاتف

266
00:16:56,370 --> 00:16:58,370
أغلقي أنت أولاً

267
00:16:58,780 --> 00:17:01,730
.أنا من اتّصل بك، لذا أغلق أنت

268
00:17:02,540 --> 00:17:03,490
لماذا؟

269
00:17:05,000 --> 00:17:06,970
.إذًا لنغلق معًا

270
00:17:06,970 --> 00:17:08,160
.حسنًا

271
00:17:08,160 --> 00:17:09,300
...واحد، اثنان

272
00:17:12,980 --> 00:17:13,800
.كاذب

273
00:17:14,730 --> 00:17:16,550
!أ-أنتِ أيضًا

274
00:17:34,800 --> 00:17:37,930
.ما هذا؟! لا أستطيع النّوم اللّيلة أيضًا

275
00:17:40,500 --> 00:17:41,380
".صورة"

276
00:17:46,250 --> 00:17:47,440
.إنّه شجار قطط

277
00:17:48,380 --> 00:17:50,250
.انتظري هنا يا تاكاغي-سان

278
00:17:51,090 --> 00:17:52,050
ماذا ستفعل؟

279
00:17:52,360 --> 00:17:56,440
.حسنًا، جيّد. ابقيا مكانكما

280
00:17:59,210 --> 00:18:00,610
!حسنًا! لحظة مثاليّة لصورة

281
00:18:02,940 --> 00:18:05,900
.تبًّا... لم أصوّر سوى الجدار

282
00:18:05,900 --> 00:18:08,400
لِمَ الصّور فجأة؟

283
00:18:10,370 --> 00:18:15,500
أتنافس مع الشّباب الآن كي نرى
.من يستطيع التقاط أفضل صورة

284
00:18:16,570 --> 00:18:18,300
ومن في الصّدارة الآن؟

285
00:18:22,050 --> 00:18:23,940
.صورة كيمورا هذه لا تُقهر

286
00:18:25,270 --> 00:18:27,350
.هذه قويّة

287
00:18:29,180 --> 00:18:31,290
صورة مُضحكة؟

288
00:18:33,230 --> 00:18:36,650
تاكاغي-سان! دعيني ألتقط
.صورة لوجهك الغريب

289
00:18:37,480 --> 00:18:40,430
!أستطيع هزيمة بونبوكو الخارق تمامًا

290
00:18:41,700 --> 00:18:44,890
.إن فعلتَ أيّ شيء أطلبه، فأنا موافقة

291
00:18:46,020 --> 00:18:47,210
أيّ شيء؟

292
00:18:47,730 --> 00:18:49,350
.أيّ شيء يعني أيّ شيء

293
00:18:51,350 --> 00:18:52,480
!هذا مخيف

294
00:18:54,650 --> 00:18:58,010
.لديها المقوّمات الّتي تجعلني أفوز

295
00:18:58,010 --> 00:18:59,340
...يا نيشيكاتا

296
00:19:02,890 --> 00:19:05,190
!تاكاغي-سان! هذا الوجه

297
00:19:10,250 --> 00:19:12,260
.منحتك للتّوّ فرصة للتّصوير

298
00:19:12,730 --> 00:19:14,400
!مـ-مرّة أخرى

299
00:19:14,400 --> 00:19:15,460
.على الإطلاق

300
00:19:17,610 --> 00:19:20,300
.لحظة، هذه تاكاغي-سان في نهاية المطاف

301
00:19:20,300 --> 00:19:22,950
.إنّها تستمتع بما تقوم به
!سوف تفعلها ثانية

302
00:19:24,120 --> 00:19:26,940
...سأتصرّف وكأنّني منزعج و

303
00:19:27,890 --> 00:19:28,760
.نيشيكاتا

304
00:19:28,760 --> 00:19:31,160
!توقّعت! هذه فرصتي

305
00:19:38,910 --> 00:19:40,420
دمية أفعى؟

306
00:19:40,420 --> 00:19:41,800
.هذه صورة جيّدة

307
00:19:42,670 --> 00:19:43,990
!التقطتِ صورة لي؟

308
00:19:44,790 --> 00:19:46,800
!ا-انتظري، احذفيها

309
00:19:46,800 --> 00:19:49,200
.مستحيل. إنّها صورة رائعة

310
00:19:49,780 --> 00:19:53,170
.سأحذفها إذا فعلت أيّ شيء أطلبه

311
00:19:54,880 --> 00:19:58,590
!تبًّا لك يا تاكاغي-سان! يا لها من لقطة رخيصة

312
00:19:58,590 --> 00:20:01,670
.التقطت صورة رائعة

313
00:20:01,670 --> 00:20:02,870
أتريد رؤيتها؟

314
00:20:03,250 --> 00:20:04,680
.لا، لا أريد

315
00:20:04,680 --> 00:20:05,610
.انظر، انظر

316
00:20:09,770 --> 00:20:11,080
!نمط التّصوير المتتالي؟

317
00:20:11,080 --> 00:20:12,160
رائع، صحيح؟

318
00:20:12,800 --> 00:20:14,320
...تغيّر تعابير وجهك

319
00:20:20,270 --> 00:20:23,250
!تبًّا لك يا تاكاغي-سان

320
00:20:24,380 --> 00:20:25,590
!وجدتها

321
00:20:25,590 --> 00:20:29,580
.سألتقط صورة لها وهي تضحك وفمها مفتوح

322
00:20:30,170 --> 00:20:32,160
.ستشعر بالإحراج بالتّأكيد

323
00:20:36,490 --> 00:20:37,630
هل أبدو جميلة؟

324
00:20:39,310 --> 00:20:40,590
.تعادلنا الآن

325
00:20:40,590 --> 00:20:43,640
!لم نتعادل على الإطلاق

326
00:20:45,170 --> 00:20:48,300
!سـ-سأحذف هذه، لذا احذفي خاصّتكِ أيضًا

327
00:20:48,910 --> 00:20:50,640
.لا، لن أحذفها

328
00:20:51,050 --> 00:20:53,440
.لذا لا داعي لتحذف صورتي أيضًا

329
00:20:54,390 --> 00:20:57,920
.لا، ليس هذا مقصدي

330
00:21:03,110 --> 00:21:03,930
.إلى اللّقاء

331
00:21:03,930 --> 00:21:04,730
...نعم

332
00:21:06,750 --> 00:21:08,280
.إنّها بمزاج ممتاز

333
00:21:08,880 --> 00:21:12,590
.لكن لم ألتقط أيّ صورة مضحكة

334
00:21:14,490 --> 00:21:15,500
،نيشيكاتا

335
00:21:15,910 --> 00:21:18,850
.لا تعرض صورتي لأحد

336
00:21:20,880 --> 00:21:22,010
.هذا محرج

337
00:21:31,380 --> 00:21:34,390
!مستحيل. لا أستطيع عرضها على أحد

338
00:21:34,940 --> 00:21:37,380
!ماذا سيقول النّاس؟

339
00:21:38,050 --> 00:21:40,270
...هذا خطير! احذف، احذف

340
00:21:45,710 --> 00:21:48,230
.قالت بالفعل أنّ ذلك محرج

341
00:21:48,960 --> 00:21:52,290
.ربّما يمكنني استخدامها في صفقة ما

342
00:21:55,440 --> 00:21:56,640
.سأحتفظ بها على ما أعتقد