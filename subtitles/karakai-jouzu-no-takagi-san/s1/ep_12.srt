1
00:00:32,170 --> 00:00:34,050
!ساناي-تشان

2
00:00:34,630 --> 00:00:35,590
.خذي

3
00:00:35,590 --> 00:00:36,490
.هذه لكِ

4
00:00:38,030 --> 00:00:38,900
ما هذه؟

5
00:00:39,530 --> 00:00:40,510
رسالة حبّ؟

6
00:00:40,510 --> 00:00:43,190
.كلاّ! إنّها رسالة عاديّة

7
00:00:43,190 --> 00:00:44,940
.الجميع يفعل هذا في هذه الأيّام

8
00:00:44,940 --> 00:00:46,270
ألم تعلمي؟

9
00:00:46,270 --> 00:00:47,420
.لا

10
00:00:47,420 --> 00:00:48,480
.يا إلهي

11
00:00:48,940 --> 00:00:51,300
.سأكتب واحدة لكِ لاحقًا أيضًا يا يوكاري-تشان

12
00:00:51,300 --> 00:00:55,210
أشكرك، لكن ينبغي أن تركّزي على
.الدّراسة وأنت في الفصل يا مينا

13
00:00:55,210 --> 00:00:57,740
.الصّداقة أهمّ من الدّراسة

14
00:00:58,270 --> 00:01:01,450
هل تنتشر نزعة كتابة الرّسائل
بين الفتيات في هذه الأيّام؟

15
00:01:01,450 --> 00:01:03,110
.هكذا يبدو

16
00:01:03,110 --> 00:01:05,460
.تخيّل لو يكتبن رسائل حبّ أيضًا

17
00:01:06,670 --> 00:01:08,960
يصبحن عاطفيّات جدًّا عندما
.يتعلّق الأمر بالرّسائل

18
00:01:09,210 --> 00:01:10,520
.بالفعل

19
00:01:10,520 --> 00:01:12,090
رسائل حبّ؟

20
00:01:12,090 --> 00:01:13,730
.بمقدورهنّ قول ما يردن بوضوح فحسب

21
00:01:13,730 --> 00:01:16,930
لِمَ يتعبن أنفسهنّ بكتابة رسائل؟

22
00:01:17,210 --> 00:01:19,050
.لا بدّ وأنّ لديهنّ كثير من وقت الفراغ

23
00:01:26,610 --> 00:01:28,710
!أنا آسف! أنا آسف! أنا آسف

24
00:01:28,710 --> 00:01:31,120
.يكفي يا ساناي. يكفيه هذا

25
00:01:31,120 --> 00:01:32,660
.ركلة واحدة تكفي

26
00:01:33,090 --> 00:01:34,970
لكن هل يستحقّ ركلة واحدة فقط؟

27
00:01:37,170 --> 00:01:38,990
.سنبدأ الدّرس

28
00:01:39,450 --> 00:01:42,080
.افتحوا كتابكم على الصّفحة 76

29
00:01:47,610 --> 00:01:49,780
تاكاغي-سان تكتب رسائل أيضًا؟

30
00:01:51,970 --> 00:01:55,540
.أعتقد أنّ تاكاغي-سان فتاة عاديّة أيضًا

31
00:02:10,960 --> 00:02:11,760
ماذا؟

32
00:03:43,880 --> 00:03:44,780
".رسالة"

33
00:03:51,960 --> 00:03:53,510
ما الخطب يا نيشيكاتا؟

34
00:03:54,350 --> 00:03:56,840
!لـ-لا شيء على الإطلاق

35
00:03:56,840 --> 00:03:58,970
رسالة؟ ممّن؟

36
00:03:58,970 --> 00:04:00,130
لماذا أنا؟

37
00:04:00,660 --> 00:04:03,130
.تخيّل لو يكتبن رسائل حبّ أيضًا

38
00:04:03,340 --> 00:04:06,110
!لا، لا، لا، هذا مستحيل

39
00:04:06,110 --> 00:04:07,460
.أحدهم يجهّز مقلبًا لي

40
00:04:08,130 --> 00:04:09,590
!تذكّرت

41
00:04:11,060 --> 00:04:13,730
.قد يكون هذا من صنيع تاكاغي-سان

42
00:04:13,730 --> 00:04:15,630
.لا، بل أنا متأكّد من أنّها هي

43
00:04:17,330 --> 00:04:18,350
...تاكاغي-سان

44
00:04:19,020 --> 00:04:20,230
.لحظة

45
00:04:20,230 --> 00:04:23,570
ماذا لو كان أحدًا آخر؟
ماذا لو لم تكن تاكاغي-سان؟

46
00:04:23,570 --> 00:04:27,300
،إذا اكتشفت بأنّني تلقّيت رسالة
.فسوف تسخر منّي من جديد

47
00:04:28,160 --> 00:04:29,620
نعم يا نيشيكاتا؟

48
00:04:31,300 --> 00:04:32,220
...لا

49
00:04:37,930 --> 00:04:40,090
.الطّقس جميل اليوم

50
00:04:40,580 --> 00:04:41,800
هل تخفي شيئًا؟

51
00:04:43,210 --> 00:04:45,330
.بالطّبع لا

52
00:04:47,270 --> 00:04:49,640
.لكن أشعر بشيء مريب

53
00:04:50,030 --> 00:04:51,210
.وجهك أحمر أيضًا

54
00:04:51,210 --> 00:04:53,490
.أ-أنتِ تتوهّمين

55
00:04:53,950 --> 00:04:55,230
،لا مشكلة

56
00:04:55,780 --> 00:04:57,560
لكن لماذا كتابك مغلق؟

57
00:04:57,830 --> 00:05:00,180
...فـ-في الحقيقة

58
00:05:00,520 --> 00:05:02,990
هل لهذا علاقة بوجهك الأحمر؟

59
00:05:03,320 --> 00:05:04,180
!غير صحيح

60
00:05:04,180 --> 00:05:05,950
!ووجهي ليس أحمرًا

61
00:05:06,630 --> 00:05:08,160
أما من شيء حقًّا؟

62
00:05:08,160 --> 00:05:10,120
!ما من شيء حقًّا

63
00:05:13,730 --> 00:05:15,620
.أعتقد أنّني كنتُ أتوهّم

64
00:05:18,140 --> 00:05:20,510
...والرّسالة في كتابك

65
00:05:21,150 --> 00:05:22,000
.أنا من وضعتها هناك

66
00:05:23,340 --> 00:05:26,630
!توقّعت هذا

67
00:05:30,170 --> 00:05:33,380
.كنت أعلم تمامًا. بالطّبع

68
00:05:34,750 --> 00:05:35,750
.كاذب

69
00:05:36,190 --> 00:05:39,860
.كنت في الواقع أستمتع بدفعك للتّفكير

70
00:05:40,800 --> 00:05:42,370
ألن تقرأ محتواها؟

71
00:05:42,880 --> 00:05:44,060
هل كتبت شيئًا؟

72
00:05:44,740 --> 00:05:46,210
.بالطّبع

73
00:05:48,690 --> 00:05:51,410
تسخرين منّي من جديد، أليس كذلك؟

74
00:05:54,690 --> 00:05:56,600
!لماذا لا تقول أيّ كلمة؟

75
00:05:57,350 --> 00:06:00,480
.حـ-حسنًا، سأقرؤها في المنزل

76
00:06:01,390 --> 00:06:02,340
.اقرأها الآن

77
00:06:03,740 --> 00:06:04,850
لـ-لماذا؟

78
00:06:05,490 --> 00:06:08,810
سينتهي الدّوام بعد هذه الحصّة، صحيح؟

79
00:06:08,810 --> 00:06:10,640
.أريد الحصول على إجابة حينها

80
00:06:10,640 --> 00:06:12,030
إ-إجابة؟

81
00:06:15,560 --> 00:06:19,370
،إن كانت رسالة تتطلّب إجابة
.فهذا يعني أنّها رسالة تطرح سؤالاً

82
00:06:19,370 --> 00:06:22,210
أي أنّها ليست شيئًا للسّخرية منّي؟

83
00:06:22,870 --> 00:06:25,110
.تخيّل لو يكتبن رسائل حبّ أيضًا

84
00:06:26,050 --> 00:06:28,940
!إ-إذًا قد تكون رسالة حبّ؟

85
00:06:28,940 --> 00:06:31,070
!لحظة، معقول؟

86
00:06:33,030 --> 00:06:36,540
هلّي أن أعرف إن كانت رسالة حبّ؟

87
00:06:39,930 --> 00:06:41,450
!المعاملة الصامتة من جديد؟

88
00:06:41,980 --> 00:06:43,130
ألن تقرأها؟

89
00:06:43,130 --> 00:06:45,610
.سـ-سأفعل. سأقرؤها

90
00:06:45,940 --> 00:06:47,430
كلّ ما عليّ فعله هو قراءتها، صحيح؟

91
00:06:48,370 --> 00:06:53,070
.معنى هذا أنّه مهما كتب فيها غايته استفزازي

92
00:06:53,430 --> 00:06:56,560
لذا أيًّا كان محتواها، يجب أن أحافظ
.على هدوئي كي لا تسخر منّي

93
00:06:56,560 --> 00:06:58,880
.يجب أن أكون جريئًا

94
00:06:59,770 --> 00:07:02,110
...لكن ماذا لو

95
00:07:02,780 --> 00:07:06,740
.ذلك غير ممكن حقًّا

96
00:07:07,190 --> 00:07:09,140
...لكن إذا كانت رسالة حبّ

97
00:07:09,790 --> 00:07:12,720
...إذا كانت، حينها أنا

98
00:07:34,500 --> 00:07:36,500
.كان بمقدورك أن تطلبي منّي مباشرة

99
00:07:37,040 --> 00:07:38,930
.اشتهرت كتابة الرّسائل في الآونة الأخيرة

100
00:07:40,180 --> 00:07:45,020
.إضافة إلى أنّني أردت رؤية ردّة فعلك

101
00:07:47,820 --> 00:07:50,110
!كنتِ تستفزّينني إذًا

102
00:07:50,850 --> 00:07:52,950
!اصمت يا نيشيكاتا

103
00:08:08,130 --> 00:08:09,270
".اليوم الأوّل في المدرسة"

104
00:08:17,050 --> 00:08:20,160
.شكرًا جزيلاً لك

105
00:08:20,160 --> 00:08:22,010
.العفو. أستأذن

106
00:08:23,390 --> 00:08:24,570
.بالمناسبة

107
00:08:26,230 --> 00:08:28,110
ما اسمك أيّها الفتى الجديد؟

108
00:08:28,900 --> 00:08:29,980
أنا؟

109
00:08:31,060 --> 00:08:32,180
.اسمي نيشيكاتا

110
00:08:33,400 --> 00:08:34,600
.نيشيكاتا-كن

111
00:08:34,600 --> 00:08:35,910
.مبروك التحاقك

112
00:08:39,430 --> 00:08:40,230
.شكرًا

113
00:08:42,590 --> 00:08:45,750
.ستدرسون مع بعضكم بعضًا خلال العام المقبل

114
00:08:46,430 --> 00:08:49,020
.لن أجبركم على الانسجام مهما حدث

115
00:08:49,020 --> 00:08:52,490
لكن ضعوا في الحسبان أن تفعلوا
.ما بوسعكم لنمضي قدمًا معًا

116
00:08:53,380 --> 00:08:55,090
هل أضعتها في مكان ما؟

117
00:08:56,150 --> 00:08:59,680
حسنًا، لا أريد بدء العام
...بخطاب طويل، لذا

118
00:09:01,310 --> 00:09:03,310
نمت حتّى وقت متأخّر من الآن؟

119
00:09:03,850 --> 00:09:05,560
...لا، أنا

120
00:09:05,560 --> 00:09:07,970
.أثني على جرأتك

121
00:09:08,470 --> 00:09:09,270
...لا

122
00:09:09,270 --> 00:09:10,480
ما اسمك؟

123
00:09:11,860 --> 00:09:13,230
.نيشيكاتا

124
00:09:13,910 --> 00:09:16,010
.حسنًا. اجلس

125
00:09:16,010 --> 00:09:17,360
.حاضر

126
00:09:24,730 --> 00:09:26,280
.الجميع يحدّقون بي

127
00:09:26,280 --> 00:09:28,740
عليّ أن أتعرّف على الجميع
وأوضّح سوء الفهم

128
00:09:28,740 --> 00:09:31,640
.قبل أن أشتهر بالفتى كثير التّأخّر

129
00:09:34,710 --> 00:09:36,670
.المعذرة يا أستاذ تانابي

130
00:09:39,270 --> 00:09:41,390
.تأخّرت السّيّارة

131
00:09:41,390 --> 00:09:42,820
تأخّرت؟

132
00:09:42,820 --> 00:09:44,420
كذلك مراسم الدّخول أيضًا؟

133
00:09:44,420 --> 00:09:46,050
.شكرًا لتفهّمك

134
00:09:46,960 --> 00:09:50,440
.بلغني للتّوّ أنّ مراسم الدّخول ستتأخّر

135
00:09:50,440 --> 00:09:52,940
،يبدو أنّها ستستغرق بعضًا من الوقت

136
00:09:52,940 --> 00:09:54,600
...لذا في هذه الأثناء

137
00:09:55,580 --> 00:09:57,290
.سنوزّعكم على مقاعدكم

138
00:10:05,370 --> 00:10:06,820
.يا إلهي

139
00:10:06,820 --> 00:10:10,080
.أنا في أقصى الزّاوية الخلفيّة

140
00:10:10,430 --> 00:10:14,180
أكون سعيدًا في العادة، لكن
.لا أستحقّ هذا الآن على الإطلاق

141
00:10:14,620 --> 00:10:16,930
.لا أعرف أحدًا حتّى في الوقت الحاليّ

142
00:10:17,550 --> 00:10:20,300
.لا يوجد أحد خلفي أو على يساري

143
00:10:20,300 --> 00:10:22,270
.والأسوأ، أجلس بجانب فتاة

144
00:10:25,030 --> 00:10:26,310
هل نمتَ حتّى وقت متأخّر فعلاً؟

145
00:10:27,880 --> 00:10:29,520
.إنّها تتكّلم معي

146
00:10:29,520 --> 00:10:31,610
.كنت على وشك أن تقول شيئًا للأستاذ

147
00:10:32,370 --> 00:10:33,660
...أ-أجل

148
00:10:34,310 --> 00:10:36,280
...لا، في الحقيقة

149
00:10:37,700 --> 00:10:39,450
...ليتني وصلت على الموعد

150
00:10:39,450 --> 00:10:41,990
...وصلت إلى المدرسة على الموعد، لكن

151
00:10:43,020 --> 00:10:45,460
.كلّ هذا بسبب تاكاغي-سان تلك

152
00:10:47,210 --> 00:10:49,730
.حسنًا يا تلاميذ، توجّهوا إلى الصّالة الرّياضيّة

153
00:10:50,120 --> 00:10:52,660
.لا تثيروا ضجّة ولا تركضوا

154
00:10:52,660 --> 00:10:54,090
.حاضر

155
00:10:55,840 --> 00:10:56,640
،أنتِ

156
00:10:58,470 --> 00:10:59,710
.لنذهب معًا

157
00:11:06,290 --> 00:11:07,390
هل يعقل هذا؟

158
00:11:09,360 --> 00:11:15,260
.ستحظون جميعًا بكنز عظيم يُعرف بحقّ التّصويت

159
00:11:16,430 --> 00:11:20,550
.من المهمّ اختيار سياسيّين أهل للثّقة

160
00:11:20,790 --> 00:11:25,080
...وكذلك، بالنّسبة لأمّهاتكم وآبائكم

161
00:11:28,080 --> 00:11:30,210
.كان خطابًا طويلاً

162
00:11:30,210 --> 00:11:31,230
أليس كذلك؟

163
00:11:30,540 --> 00:11:33,720
.ذلك العجوز لا يكفّ عن الثّرثرة

164
00:11:33,720 --> 00:11:36,880
لم يختلف شيء في المدرسة
.الإعداديّة عن الابتدائيّة

165
00:11:38,330 --> 00:11:41,000
لكن أنت رائع للغاية بمجيئك
.متأخّرًا في اليوم الأوّل

166
00:11:41,000 --> 00:11:42,290
...لا، أنا

167
00:11:42,290 --> 00:11:44,260
.كفّوا عن الثّرثرة واجلسوا في مقاعدكم

168
00:11:50,820 --> 00:11:51,620
ماذا؟

169
00:11:56,310 --> 00:11:57,980
.آسفة لتأخّري

170
00:11:58,550 --> 00:12:00,270
.اجلسي

171
00:12:01,220 --> 00:12:04,950
.يكفي لليوم، لكن تبدأ الدّروس غدًا

172
00:12:05,170 --> 00:12:08,660
.لا تتهاونوا فقط لأنّها مراسم الدّخول
.عودوا إلى المنزل مباشرة

173
00:12:09,450 --> 00:12:11,120
...يا نيشيكاتا-كن

174
00:12:12,460 --> 00:12:16,550
أتريدني أن أخمّن سبب تأخّرك اليوم؟

175
00:12:18,140 --> 00:12:20,620
إذا استطعت التّخمين
.في محاولتي الأولى، أربح

176
00:12:21,570 --> 00:12:22,590
.بالتّأكيد

177
00:12:23,070 --> 00:12:25,880
لحظة، كيف ستخمّن في محاولتها الأولى؟

178
00:12:28,810 --> 00:12:31,390
.كنت تسلّم شيئًا ضائعًا

179
00:12:31,390 --> 00:12:32,750
!ماذا؟! كيف؟

180
00:12:32,750 --> 00:12:35,630
.أنت، اصمت يا نيشيكاتا

181
00:12:35,630 --> 00:12:36,850
.آسف

182
00:12:39,010 --> 00:12:39,970
كيف؟

183
00:12:47,300 --> 00:12:48,620
كيف يا ترى؟

184
00:12:54,850 --> 00:12:55,970
تاكاغي-سان؟

185
00:12:56,670 --> 00:12:59,190
.لم تكن حاضرًا أثناء التّعريف عن أنفسنا

186
00:13:08,660 --> 00:13:10,130
لماذا تستجيب بهذه الطّريقة؟

187
00:13:10,130 --> 00:13:12,140
!اهدآ أنتما

188
00:13:12,490 --> 00:13:13,810
.آسف

189
00:13:21,790 --> 00:13:23,820
.شكرًا على التقاطها

190
00:13:26,910 --> 00:13:28,650
.سررت بلقائك

191
00:13:32,450 --> 00:13:33,910
.سررت بلقائك

192
00:13:35,660 --> 00:13:36,610
".تغيير أماكن الجلوس"

193
00:13:38,210 --> 00:13:42,740
،اثنان وسبعون، ثلاثة وسبعون

194
00:13:43,290 --> 00:13:48,450
.أربعة وسبعون، خمسة وسبعون

195
00:13:55,530 --> 00:13:57,820
.أحقّق نتيجة

196
00:14:08,410 --> 00:14:09,930
...هذا مؤلم

197
00:14:39,260 --> 00:14:40,760
.لم تصل إلى هنا بعد

198
00:14:44,690 --> 00:14:45,850
.صباح الخير يا نيشيكاتا

199
00:14:46,460 --> 00:14:48,320
.صباح الخير يا تاكاغي-سان

200
00:14:52,050 --> 00:14:53,740
هل سمعت يا نيشيكاتا؟

201
00:14:55,320 --> 00:14:57,580
.سيجري تغيير لأماكن جلوسنا اليوم

202
00:15:03,550 --> 00:15:04,820
متى؟

203
00:15:05,430 --> 00:15:06,460
.أثناء الحصّة الأساسيّة

204
00:15:06,460 --> 00:15:07,990
الحصّة الأساسيّة؟

205
00:15:07,990 --> 00:15:09,640
.أي في الحصّة الأولى

206
00:15:21,940 --> 00:15:23,010
—تاكا

207
00:15:21,940 --> 00:15:23,010
ما الأمر؟

208
00:15:28,840 --> 00:15:30,600
حقًّا؟

209
00:15:30,600 --> 00:15:31,800
.سيكون هذا مسليًّا

210
00:15:32,780 --> 00:15:33,420
حقًّا؟

211
00:15:35,750 --> 00:15:38,710
لا، أعني، لم يتمّ تغيير أماكن
.جلوسنا منذ مدّة

212
00:15:46,900 --> 00:15:49,610
حسنًا، أعتقد أنّ ذلك سيكون مسليًّا
.من أكثر من ناحية

213
00:15:50,670 --> 00:15:54,350
.لكن أردت أن أجلس بجانبك لمدّة أطول

214
00:15:58,370 --> 00:16:01,100
.سوف تسخر منّي من جديد

215
00:16:01,500 --> 00:16:03,410
.نجوت في آخر لحظة

216
00:16:18,700 --> 00:16:21,160
هل سحب الجميع؟

217
00:16:21,160 --> 00:16:24,850
.حسنًا، انتقلوا إلى مقاعدكم بحسب أرقامكم

218
00:16:25,440 --> 00:16:27,020
نيشيكاتا، ما رقمك؟

219
00:16:27,020 --> 00:16:28,100
.تسعة وعشرون

220
00:16:29,410 --> 00:16:30,230
.هكذا إذًا

221
00:16:30,770 --> 00:16:32,470
.في أقصى الخلف ثانية إذًا

222
00:16:32,470 --> 00:16:33,460
ماذا عنك؟

223
00:16:34,540 --> 00:16:37,560
.أنا في الوسط في المقدّمة

224
00:16:37,910 --> 00:16:39,350
.هكذا إذًا

225
00:16:41,390 --> 00:16:43,140
.سنكون بعيدين جدًّا

226
00:16:43,670 --> 00:16:44,470
.نعم

227
00:16:44,970 --> 00:16:45,770
.وداعًا

228
00:16:48,570 --> 00:16:49,550
!مرحى

229
00:16:49,550 --> 00:16:52,070
انقلي لي الأجوبة أثناء الاختبارات
.يا يوكاري-تشان

230
00:16:52,070 --> 00:16:53,970
.لا، هذا غشّ صريح

231
00:16:53,970 --> 00:16:55,540
.يدعى هذا بالمساعدة المتبادلة

232
00:16:55,540 --> 00:16:57,500
وبماذا ستساعدينني في المقابل إذًا؟

233
00:16:57,500 --> 00:16:59,420
.سأشجّعك من الخلف

234
00:17:01,410 --> 00:17:02,820
.يا نيشيكاتا

235
00:17:02,820 --> 00:17:04,220
هل ستجلس أنت هنا؟

236
00:17:04,220 --> 00:17:05,280
.لا، هناك

237
00:17:05,540 --> 00:17:06,860
.هكذا إذًا

238
00:17:06,860 --> 00:17:09,040
.يؤسفني أنّنا لسنا أقرب

239
00:17:09,040 --> 00:17:10,000
.نعم

240
00:17:12,850 --> 00:17:15,180
.انحسر نظري مؤخّرًا

241
00:17:15,180 --> 00:17:17,390
.آمل أن أتمكّن من رؤية السّبّورة

242
00:17:33,350 --> 00:17:37,440
.أنا بجانب نيشيكاتا-كن

243
00:17:38,330 --> 00:17:39,580
مانو-سان؟

244
00:17:39,580 --> 00:17:42,190
.هكذا إذًا

245
00:17:44,310 --> 00:17:46,340
ما ردّة الفعل هذه؟

246
00:17:47,160 --> 00:17:50,300
.لا شيء. لا تبالِ لي

247
00:17:50,780 --> 00:17:56,370
أنا مكتئبة فقط لأنّني لن أكون
.بالقرب من ناكاي-كن

248
00:18:00,180 --> 00:18:02,140
ناكاي-كن؟

249
00:18:02,690 --> 00:18:04,320
.مرحبًا

250
00:18:04,320 --> 00:18:05,830
!النّجدة

251
00:18:06,140 --> 00:18:09,100
!فليتبادل أحد مقعده معي أرجوكم

252
00:18:09,100 --> 00:18:13,110
كيف ينبغي لي أن أتناول غدائي باكرًا
!إذا كنت أمام منصّة الأستاذ؟

253
00:18:13,110 --> 00:18:16,570
لن تبدّل مقعدك ما لم يكن
.لديك سبب مشروع

254
00:18:16,780 --> 00:18:20,170
وأيضًا يا كيمورا، دعني أراك في مكتب
.المدرّسين لاحقًّا

255
00:18:22,500 --> 00:18:24,490
أمام منصّة الأستاذ؟

256
00:18:25,220 --> 00:18:28,920
.لكن أردت أن أجلس بجانبك لمدّة أطول

257
00:18:46,310 --> 00:18:47,910
،كـ-كيمورا-كن

258
00:18:47,910 --> 00:18:49,890
.نظري سيّئ. لنتبادل

259
00:18:50,120 --> 00:18:53,270
.لا، لقد وجدت من أتبادل معه

260
00:19:02,190 --> 00:19:04,220
.لا يهمّني

261
00:19:08,650 --> 00:19:09,490
.نيشيكاتا

262
00:19:10,500 --> 00:19:11,300
.اسمع

263
00:19:22,450 --> 00:19:24,460
.سأجلس هنا الآن

264
00:19:25,030 --> 00:19:25,860
لماذا؟

265
00:19:26,680 --> 00:19:31,190
تبادل ناكاي-كن مع ميكورا-كن لأنّه
.لم يستطع رؤية السّبّورة بوضوح

266
00:19:31,710 --> 00:19:33,820
،وأتى ناكاي-كن إلى المقدّمة

267
00:19:33,820 --> 00:19:37,170
وأرادت مانو-تشان مبادلتي بما
.أنّني كنتُ أجلس بجانبه

268
00:19:37,790 --> 00:19:40,640
مانو-تشان ضئيلة الحجم
.لذا تفضّل المقعد الأماميّ

269
00:19:41,410 --> 00:19:43,580
.هـ-هكذا إذًا

270
00:19:44,750 --> 00:19:48,370
نيشيكاتا، حاولت الجلوس بجانبي، صحيح؟

271
00:19:50,770 --> 00:19:54,570
.لا، لم أستطع رؤية السّبّورة

272
00:19:57,400 --> 00:19:58,300
حقًّا؟

273
00:20:03,670 --> 00:20:05,110
!أقسم

274
00:20:05,350 --> 00:20:08,310
.سيبدأ الدّرس. افتحوا كتبكم

275
00:20:08,810 --> 00:20:12,220
تذكّرت، ما الّذي كنت ستقوله؟

276
00:20:13,330 --> 00:20:16,150
بدا وكأنّك أردت قول شيء منذ
.وصولك إلى هنا هذا الصّباح

277
00:20:24,310 --> 00:20:27,430
.آسف لأنّني تأخّرت حتّى أعدتُ لك هذا

278
00:20:27,940 --> 00:20:28,790
.شكرًا

279
00:20:30,060 --> 00:20:31,610
من استراحة الصّيف؟

280
00:20:31,610 --> 00:20:34,680
...نعم، و

281
00:20:35,090 --> 00:20:36,460
ومن يوم مراسم الدّخول؟

282
00:20:36,790 --> 00:20:37,930
تذكّرت؟

283
00:20:38,230 --> 00:20:40,280
تذكّرت أيضًا، صحيح؟

284
00:20:42,150 --> 00:20:42,960
.نعم

285
00:20:45,580 --> 00:20:46,420
.شكرًا

286
00:20:47,200 --> 00:20:48,960
.غسلتُه جيّدًا

287
00:20:54,170 --> 00:20:55,250
...لا

288
00:20:55,770 --> 00:20:57,870
.لكن أنا مسرور

289
00:20:59,140 --> 00:21:01,190
.لأسباب مختلفة

290
00:21:01,860 --> 00:21:06,430
لأنّني تمكّنت من إعادة منديلك ولأنّنا
.جلسنا بجانب بعضنا بعضًا مجدّدًا

291
00:21:06,430 --> 00:21:09,090
...لا، أعني

292
00:21:10,610 --> 00:21:12,000
.أتطلّع قدمًا لذلك

293
00:21:16,820 --> 00:21:17,630
.نعم