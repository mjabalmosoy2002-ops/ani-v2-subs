1
00:00:06,910 --> 00:00:12,110
أما من طريقة تجعلني أحسم
أمر تاكاغي-سان؟

2
00:00:14,620 --> 00:00:19,010
لا أستطيع تركها تستمرّ في السّخرية
.منّي هكذا كلّ يوم

3
00:00:20,040 --> 00:00:21,750
!آ-آسف

4
00:00:27,210 --> 00:00:28,670
.يا نيشيكاتا

5
00:00:29,120 --> 00:00:30,280
.صباح الخير

6
00:00:32,420 --> 00:00:33,630
...صباح الخير

7
00:00:34,050 --> 00:00:35,740
هل من مشكلة؟

8
00:00:35,740 --> 00:00:37,590
...لا، لا شيء

9
00:00:39,470 --> 00:00:41,020
.لنذهب إلى المدرسة معًا

10
00:00:41,020 --> 00:00:43,790
...حـ-حسنًا

11
00:02:16,980 --> 00:02:18,160
"من أطول؟"

12
00:02:22,490 --> 00:02:24,030
هل رأت ذلك؟

13
00:02:24,030 --> 00:02:26,230
هل رأت ما حدث للتّوّ؟

14
00:02:27,690 --> 00:02:28,490
.نيشيكاتا

15
00:02:28,490 --> 00:02:29,920
ما-ماذا؟

16
00:02:30,780 --> 00:02:32,030
هل تركب الدّرّاجة معي؟

17
00:02:32,650 --> 00:02:36,460
.لا. سنقع في ورطة إذا رآنا أحد

18
00:02:37,040 --> 00:02:38,670
.أنت محرج فحسب

19
00:02:38,670 --> 00:02:40,410
.الأمر ليس كذلك

20
00:02:40,410 --> 00:02:41,590
.حسنًا، حسنًا

21
00:02:42,670 --> 00:02:47,060
.لا يبدو أنّها رأتني أصطدم بعمود الكهرباء

22
00:02:50,780 --> 00:02:53,480
.أخيرًا بدّلتَ زيّك المدرسيّ إلى الزّيّ الشّتويّ أيضًا

23
00:02:53,770 --> 00:02:57,940
نعم، الجوّ بارد مؤخّرًا، لهذا رأيت
.أن الوقت قد حان

24
00:02:59,790 --> 00:03:01,140
ما-ماذا؟

25
00:03:01,890 --> 00:03:03,160
هل أصبحتَ أطول؟

26
00:03:04,900 --> 00:03:08,280
أعتقد أنّ هذا الزّيّ بدا أكبر قليلاً
.عليك في الرّبيع الماضي

27
00:03:08,940 --> 00:03:10,000
.معها حقّ

28
00:03:10,960 --> 00:03:12,000
،الآن

29
00:03:12,000 --> 00:03:15,650
!أشعر وكأنّ الزّيّ يلائم مقاسي تمامًا

30
00:03:16,630 --> 00:03:20,060
هل يُعقل... أنّني أمرّ بمرحلة طفرة النّموّ؟

31
00:03:22,990 --> 00:03:27,130
.أنا أنمو سريعًا، هذا مزعج بعض الشّيء

32
00:03:27,130 --> 00:03:29,460
هل هذا ما يطلق عليه النّاس
بـ"طفرة نموّ" يا ترى؟

33
00:03:30,070 --> 00:03:33,150
.لكن أنت لم تتغيّري كثيرًا يا تاكاغي-سان

34
00:03:37,940 --> 00:03:40,150
.هذا تحرّش جنسيّ

35
00:03:40,450 --> 00:03:41,290
!ماذا؟

36
00:03:41,950 --> 00:03:43,170
..."لم تتغيّري كثيرًا"

37
00:03:45,180 --> 00:03:46,830
!لـ-لا

38
00:03:47,230 --> 00:03:50,540
.لـ-ليس هذا ما كنتُ أتحدّث عنه

39
00:03:50,830 --> 00:03:53,810
.كـ-كنتُ أتحدّث عن الطّول

40
00:03:54,450 --> 00:03:56,500
.وأنا كنتُ أتحدث عن الطّول أيضًا

41
00:03:57,190 --> 00:03:58,900
ماذا ظننتَ أنّني قصدت؟

42
00:04:02,060 --> 00:04:04,180
...لـ-لا شيء

43
00:04:07,470 --> 00:04:08,390
ماذا؟

44
00:04:11,960 --> 00:04:15,050
.انسَ الأمر. ربّما لم تنمُ إلى ذلك الحدّ الكبير

45
00:04:16,250 --> 00:04:18,590
!لا، لا، لقد نموْت

46
00:04:18,590 --> 00:04:21,600
أنا أطول منكِ على الأغلب
!الآن يا تاكاغي-سان

47
00:04:23,820 --> 00:04:26,130
.إذًا لنرَ من أطول

48
00:04:32,950 --> 00:04:34,750
لماذا هنا؟

49
00:04:34,750 --> 00:04:36,820
لا يمكننا أن نعرف ونحن نرتدي أحذية، صحيح؟

50
00:04:39,160 --> 00:04:40,980
.سنتأخّر عن المدرسة

51
00:04:40,980 --> 00:04:43,720
.سيكون ذلك سريعًا. هيّا، استدر

52
00:04:52,640 --> 00:04:54,390
...لنرَ

53
00:04:54,980 --> 00:04:58,390
.دافئ... بعض الشّيء

54
00:05:01,530 --> 00:05:03,730
.المعذرة يا تاكاغي-سان

55
00:05:04,780 --> 00:05:09,440
ألا يقف المرء عادة مقابل جدار
ويضع علامة؟

56
00:05:09,440 --> 00:05:12,370
.الأمر أكثر دقّة إذا وقفنا معًا هكذا

57
00:05:18,000 --> 00:05:19,340
.نحن بنفس الطّول تقريبًا على ما أعتقد

58
00:05:19,340 --> 00:05:20,840
!ماذا؟ حقًّا؟

59
00:05:22,050 --> 00:05:24,660
لِمَ لا تتأكّد بنفسك؟

60
00:05:31,200 --> 00:05:32,320
.معك حقّ

61
00:05:32,770 --> 00:05:33,890
أليس كذلك؟

62
00:05:34,630 --> 00:05:37,560
أنتِ لا تقفين على أطراف أصابع قدميكِ، صحيح؟

63
00:05:37,870 --> 00:05:39,920
ألا تثق بي؟

64
00:05:41,220 --> 00:05:42,020
...إذًا

65
00:05:47,150 --> 00:05:50,190
،إن وقفنا في مواجهةِ بعضنا
.ستعرف ما إن كنت أغشّ

66
00:05:50,880 --> 00:05:53,910
...حسنًا، إذًا

67
00:06:03,690 --> 00:06:07,410
.يـ-يبدو أنّني أطول... قليلاً

68
00:06:07,410 --> 00:06:09,540
.وقفتُ على أطراف أصابع قدميّ قبل قليل

69
00:06:10,340 --> 00:06:13,010
!كنتِ تغشّين إذًا! كاذبة

70
00:06:14,460 --> 00:06:16,240
.لم أقل أنّني لم أكن أفعل

71
00:06:16,670 --> 00:06:18,900
.أنا مسرورة لك، أنت ربحت

72
00:06:21,550 --> 00:06:23,830
.تاكاغي-سان، تتصرّفين بكلّ هدوء ظاهريًّا

73
00:06:23,830 --> 00:06:26,480
.لكن ضمنيًّا، أنا واثق أنكِ مستاءة

74
00:06:28,390 --> 00:06:31,650
.وبالمناسبة، لست مستاءة

75
00:06:32,900 --> 00:06:35,890
،فعندما ينمو المرء أكثر

76
00:06:35,890 --> 00:06:38,410
،فقد يصطدم بعمود كهرباء وما شابه
.وذلك يبدو مؤلمًا

77
00:06:47,460 --> 00:06:49,840
ر-رأيت ذلك؟

78
00:06:49,840 --> 00:06:51,470
.لنذهب إلى المدرسة

79
00:06:51,470 --> 00:06:52,610
.تاكاغي-سان

80
00:06:53,600 --> 00:06:56,320
يا تاكاغي-سان؟

81
00:07:07,690 --> 00:07:09,140
...البرد شديد

82
00:07:11,360 --> 00:07:12,930
هل البرد شديد إلى هذه الدّرّجة؟

83
00:07:12,930 --> 00:07:15,450
.أنتِ حسّاسة جدًّا للبرد يا يوكاري-تشان

84
00:07:15,780 --> 00:07:16,580
.خذي هذه

85
00:07:17,230 --> 00:07:19,010
!مينا، يدكِ باردة للغاية

86
00:07:25,930 --> 00:07:27,010
".أكره البرد"

87
00:07:29,280 --> 00:07:30,880
...تبًّا

88
00:07:31,400 --> 00:07:33,810
.إذا فعلت ذلك ثانية، فلن أسامحك

89
00:07:34,850 --> 00:07:35,650
.لمس

90
00:07:38,090 --> 00:07:39,310
!توقّفي

91
00:07:40,810 --> 00:07:43,950
!لماذا يداكِ باردتان جدًّا؟

92
00:07:45,220 --> 00:07:46,520
،يوكاري-تشان

93
00:07:47,320 --> 00:07:49,230
...أصحاب الأيدي الباردة

94
00:07:49,720 --> 00:07:52,070
!قلوبهم دافئة

95
00:07:52,550 --> 00:07:56,460
لا أعتقد أنّ شخصًا يمتلك قلبًا دافئًا
.سيفعل ما فعلته للتّوّ

96
00:07:56,460 --> 00:07:59,780
.اهدئي، اهدئي، لا تكنّي ضغينة

97
00:08:01,560 --> 00:08:04,610
.إن فعلتها ثانية، فسوف أغضب كثيرًا

98
00:08:04,610 --> 00:08:06,060
.أنتِ غاضبة بالفعل

99
00:08:06,060 --> 00:08:06,760
.لمس

100
00:08:06,760 --> 00:08:10,010
!بارد للغاية! مهلاً

101
00:08:10,440 --> 00:08:12,410
!توقّفي عن ذلك يا ساناي-تشان

102
00:08:12,410 --> 00:08:14,740
."هجوم "قلبي دافئ جدًّا

103
00:08:15,450 --> 00:08:17,480
!ساعديني يا يوكاري-تشان

104
00:08:18,680 --> 00:08:20,180
!خذا هذه

105
00:08:20,440 --> 00:08:21,770
!هذا لقاء ما فعلتماه قبل قليل

106
00:08:25,330 --> 00:08:26,230
ماذا؟

107
00:08:26,810 --> 00:08:29,590
.يوكاري-تشان، يدكِ دافئة

108
00:08:30,480 --> 00:08:32,400
.لا بدّ وأنّكِ تمتلكين قلبًا باردًا

109
00:08:33,120 --> 00:08:34,880
!لماذا تقولان هذا؟

110
00:08:34,880 --> 00:08:37,140
.لا تقتربي منّي يا باردة القلب

111
00:08:37,140 --> 00:08:39,740
."هجوم "قلبي بارد جدًّا

112
00:08:43,290 --> 00:08:44,350
!خذ هذه

113
00:08:44,350 --> 00:08:45,170
!هذا بارد

114
00:08:45,740 --> 00:08:46,880
!لماذا فعلتِ ذلك؟

115
00:08:50,910 --> 00:08:52,240
.يمكنك أن تردّ الاعتبار منّي

116
00:08:56,960 --> 00:08:58,100
!توقّفي عن ذلك

117
00:09:02,900 --> 00:09:04,560
!محال أن أتمكّن من فعل ذلك

118
00:09:08,720 --> 00:09:09,520
!خذ هذه

119
00:09:11,050 --> 00:09:13,550
!قلتُ توقّفي! هذا بارد

120
00:09:14,530 --> 00:09:17,650
.صاحب اليدين الباردتين يمتلك قلبًا دافئًا

121
00:09:18,190 --> 00:09:19,230
!غير صحيح

122
00:09:22,940 --> 00:09:25,120
...تاكاغي-تشان ونيشيكاتا-كن

123
00:09:25,120 --> 00:09:27,730
.أتيا إلى المدرسة معًا اليوم

124
00:09:27,730 --> 00:09:29,280
.إنّهما مقرّبان جدًّا

125
00:09:30,310 --> 00:09:32,460
.ربما يتواعدان بالفعل

126
00:09:36,990 --> 00:09:38,100
".دعوة"

127
00:09:39,870 --> 00:09:43,860
أتساءل ما إن كان نيشيكاتا-كن
.وتاكاغي-تشان يتواعدان

128
00:09:44,270 --> 00:09:45,310
من يدري؟

129
00:09:45,620 --> 00:09:49,800
.لستِ مهتمّة؟ يبدوان مقرّبين جدًّا

130
00:09:49,800 --> 00:09:52,020
يوكاري، هل تغارين؟

131
00:09:52,350 --> 00:09:56,530
...لا... ليست مسألة غيرة، لكن

132
00:09:57,100 --> 00:10:01,730
مينا، تقول يوكاري أنّها تريد فتى
!تتبادل الغزل معه

133
00:10:01,730 --> 00:10:03,490
!ليس هذا ما قلته

134
00:10:03,490 --> 00:10:05,640
مينا، هل تسمعينني؟

135
00:10:06,770 --> 00:10:07,790
مينا؟

136
00:10:08,120 --> 00:10:11,450
!تبًّا يا ساناي-تشان، لا تكلّميني الآن

137
00:10:11,450 --> 00:10:14,130
!كنت على وشك أن أتبول، لكن لا أستطيع الآن

138
00:10:14,650 --> 00:10:15,320
ماذا؟

139
00:10:15,320 --> 00:10:17,810
.أنتِ لا تُحتملين حقًّا يا ساناي

140
00:10:18,330 --> 00:10:20,810
.ينبغي أن تشاهديه. إنّه ممتع

141
00:10:20,810 --> 00:10:22,480
.حقًّا؟ سأشاهده إذًا

142
00:10:22,480 --> 00:10:23,590
.تاكاغي-تشان

143
00:10:29,060 --> 00:10:31,770
!لقد توصّلت للتّوّ للخطّة العظمى

144
00:10:32,540 --> 00:10:34,000
إنّها الخطّة العظمى الّتي لا شائبة فيها

145
00:10:34,000 --> 00:10:36,870
لاستفزاز تاكاغي-سان في طريق
.عودتنا من المدرسة

146
00:10:41,360 --> 00:10:43,550
لِمَ تبتسم بتكلّف هكذا يا نيشيكاتا؟

147
00:10:44,620 --> 00:10:46,410
تفكير منحرف؟

148
00:10:46,410 --> 00:10:49,250
!ا-الأمر ليس كذلك

149
00:10:49,610 --> 00:10:50,860
ليس كماذا؟

150
00:10:50,860 --> 00:10:52,190
...ما-ما قصدتُه كان

151
00:10:52,810 --> 00:10:53,890
.وجهك أحمر

152
00:10:56,240 --> 00:10:58,630
...تبًّا لك يا تاكاغي-سان. سترين

153
00:10:58,970 --> 00:11:00,270
...بالمناسبة يا نيشيكاتا

154
00:11:01,500 --> 00:11:03,100
هل تريد أن نمشي للمنزل معًا اليوم؟

155
00:11:03,100 --> 00:11:04,290
!بالتّأكيد

156
00:11:09,090 --> 00:11:12,830
يا للهول! هل أدركت أنّني أخطّط لشيء؟

157
00:11:15,540 --> 00:11:17,250
.نعم، بالتّأكيد

158
00:11:17,630 --> 00:11:19,280
لماذا كرّرت كلامك؟

159
00:11:19,610 --> 00:11:21,760
.بلا سبب

160
00:11:24,160 --> 00:11:27,660
،قد تغيّر رأيك بعد دوام المدرسة

161
00:11:28,490 --> 00:11:30,710
.لذا يمكنك أن تعطيني إجابة أكيدة حينها

162
00:11:31,760 --> 00:11:32,560
.إلى اللّقاء

163
00:11:38,220 --> 00:11:40,340
ماذا كان ذلك؟

164
00:11:40,340 --> 00:11:42,880
.لا يهمّ ما دامت لا تدرك ما أخطّط له

165
00:11:42,880 --> 00:11:44,700
.يا نيشيكاتا

166
00:11:45,780 --> 00:11:49,620
.سنلعب "سوبّر-برو" في منزلي اليوم
أتريد الانضمام إلينا؟

167
00:11:51,910 --> 00:11:53,860
.آسف، لا أستطيع اليوم

168
00:11:53,860 --> 00:11:56,260
ماذا؟ أهي حبيبتك ثانية؟

169
00:11:56,260 --> 00:11:57,200
!حبيبة"؟"

170
00:11:57,730 --> 00:11:59,400
إنّها تاكاغي-سان، صحيح؟

171
00:11:59,700 --> 00:12:02,100
!ماذا؟! عمّ تتكلّم؟

172
00:12:02,100 --> 00:12:03,400
.لسنا كذلك

173
00:12:03,400 --> 00:12:06,670
.تاكاغي-تشان ونيشيكاتا-كن لا يتواعدان

174
00:12:07,710 --> 00:12:09,830
!سألناها في دورة المياه قبل قليل

175
00:12:10,220 --> 00:12:11,150
حقًّا؟

176
00:12:11,150 --> 00:12:12,010
!نعم

177
00:12:12,010 --> 00:12:14,840
.والآن أريد أن أتبوّل

178
00:12:14,840 --> 00:12:16,790
...دورة مياه، دورة مياه

179
00:12:17,530 --> 00:12:21,630
إذًا ماذا كانت تفعل في دورة
المياه قبل قليل؟

180
00:12:24,700 --> 00:12:26,010
،بغض النّظر عن ذلك يا نيشيكاتا

181
00:12:26,320 --> 00:12:30,220
،إن كنت لا تتواعد مع تاكاغي-سان
فلماذا تمشي معها إلى المنزل؟

182
00:12:30,220 --> 00:12:32,680
.في الواقع، هي من طلبت منّي

183
00:12:32,680 --> 00:12:35,830
أليس هذا لأنّكما تتواعدان؟

184
00:12:35,830 --> 00:12:36,630
،لا

185
00:12:37,370 --> 00:12:40,050
.لا أعتقد ذلك

186
00:12:43,160 --> 00:12:44,320
.حسنًا، أيًّا يكن

187
00:12:45,020 --> 00:12:47,000
أليست الحصّة التّالية في غرفة العلوم؟

188
00:12:47,000 --> 00:12:48,330
!تبًّا، لنسرع

189
00:12:48,330 --> 00:12:49,160
.نعم

190
00:12:56,350 --> 00:13:01,280
.لا، أعتقد... تاكاغي-سان تريد استفزازي فحسب

191
00:13:04,130 --> 00:13:05,470
بأيّ شخصيّة ستلعب؟

192
00:13:04,450 --> 00:13:05,640
.لنذهب إلى المنزل

193
00:13:05,470 --> 00:13:06,850
.هيروميتسو على ما أعتقد

194
00:13:06,850 --> 00:13:09,020
.سنذهب مباشرة إلى المنزل اليوم

195
00:13:09,020 --> 00:13:09,880
!ماذا؟

196
00:13:09,880 --> 00:13:13,760
!أريد مصّاصة ثلج بونكان
!أريد مصّاصة ثلج بونكان

197
00:13:13,760 --> 00:13:15,910
تريدين مصّاصة ثلج في هذا البرد القارس؟

198
00:13:15,910 --> 00:13:18,470
!أكل مصّاصة ثلج تحت الكوتاتسو هو الأفضل

199
00:13:18,470 --> 00:13:19,360
.أتفهّمك

200
00:13:21,530 --> 00:13:24,070
،تريد إجابة

201
00:13:24,070 --> 00:13:27,410
معنى هذا أنّها تريدني أن أسألها، صحيح؟

202
00:13:28,710 --> 00:13:31,380
.هذا محرج بعض الشّيء

203
00:13:32,200 --> 00:13:35,430
لم يسبق أن كنتُ أنا من يسألها
.المشي معي إلى المنزل

204
00:13:35,800 --> 00:13:36,730
.نيشيكاتا

205
00:13:37,370 --> 00:13:39,000
!ما-ما الأمر يا تاكاغي-سان؟

206
00:13:39,220 --> 00:13:43,480
جيّد! إذا سألت تاكاغي-سان فكلّ
.ما علي قوله هو نعم

207
00:13:44,490 --> 00:13:48,930
سألتني إحداهن اليوم ما
.إن كنت أتواعد معك

208
00:13:50,540 --> 00:13:55,350
.وتعتقد أنّني أنا الواقعة في حبّك

209
00:13:55,770 --> 00:14:00,390
أتعتقد أنّ السّبب هو أنّني أكون دومًا
من أسألك المشي معي إلى المنزل؟

210
00:14:01,710 --> 00:14:05,630
!تبًّا لك يا تاكاغي-سان! كانت هذه غايتك إذًا

211
00:14:06,950 --> 00:14:09,600
خلقتِ موقفًا بحيث أضطرّ لسؤالك

212
00:14:09,600 --> 00:14:13,310
!فقط لتستمتعي بمشاهدتي وأنا مرتبك

213
00:14:14,660 --> 00:14:15,880
هل من مشكلة؟

214
00:14:15,880 --> 00:14:17,990
.حاول أن تبدو هادئًا

215
00:14:18,740 --> 00:14:20,830
"قل مثلاً "حقًّا؟

216
00:14:21,130 --> 00:14:24,800
حـ-حقًّا؟

217
00:14:25,270 --> 00:14:26,070
!جيّد

218
00:14:27,360 --> 00:14:30,990
...على أيّ حال، بخصوص طلبكِ هذا الصّباح

219
00:14:32,740 --> 00:14:35,560
...أ-أنا متفرّغ تمامًا، لذا

220
00:14:35,560 --> 00:14:38,140
...لذا، دعينا

221
00:14:41,390 --> 00:14:42,310
دعينا"؟"

222
00:14:43,110 --> 00:14:44,770
!تماسك يا أنا

223
00:14:45,240 --> 00:14:49,700
،إذا استطعت تخطّي هذا
!يمكنني استفزاز تاكاغي-سان

224
00:14:51,860 --> 00:14:52,660
...دعينا

225
00:14:53,380 --> 00:14:55,590
.نمشي للمنزل معًا

226
00:15:02,170 --> 00:15:03,900
.دعني أفكّر

227
00:15:04,200 --> 00:15:05,000
!ماذا؟

228
00:15:06,940 --> 00:15:08,900
.أمزح فحسب. لنذهب إلى المنزل

229
00:15:10,830 --> 00:15:12,740
،أنا متحمّسة

230
00:15:14,720 --> 00:15:17,730
.يبدو وكأنّك تخطّط لشيء ما

231
00:15:18,590 --> 00:15:19,740
!تعرف؟

232
00:15:26,540 --> 00:15:29,860
إذا كانت تعرف، فهل ينبغي
أن أمتنع عن تنفيذ خطّتي؟

233
00:15:30,300 --> 00:15:33,120
.لكن توصّلتُ لمثل هذه الفكرة الجيّدة

234
00:15:33,550 --> 00:15:37,500
لكن لم أفكّر حتّى بكيفية تنفيذ
.الخطّة من الأساس

235
00:15:43,070 --> 00:15:44,260
أتريد شراء عصير؟

236
00:15:44,720 --> 00:15:48,210
.نعم، أنا عطشان

237
00:15:52,130 --> 00:15:53,410
.نفدت معظم الكمّيّة

238
00:15:55,140 --> 00:15:58,470
أردت شيئًا باردًا لكن كلّ ما لديهم

239
00:15:59,500 --> 00:16:00,520
حساء فاصولياء حمراء حلوة

240
00:16:01,460 --> 00:16:02,820
!وبعض الأشياء الغريبة

241
00:16:03,140 --> 00:16:04,240
ما خيارك؟

242
00:16:05,340 --> 00:16:08,070
.أشعر بأنّني سأندم على ما سأختاره

243
00:16:09,820 --> 00:16:11,590
سأندم على ما سأختاره"؟"

244
00:16:14,030 --> 00:16:15,960
هل ينبغي أن نبحث عن آلة بيع أخرى؟

245
00:16:15,960 --> 00:16:18,290
...لا

246
00:16:18,870 --> 00:16:21,850
...أنا عطشان، لذا أعتقد

247
00:16:28,960 --> 00:16:30,970
...مقرف

248
00:16:33,610 --> 00:16:35,180
ألم يتبيّن لك هذا من شكله؟

249
00:16:35,660 --> 00:16:38,020
!أنا نادم تمامًا على شرائه

250
00:16:38,980 --> 00:16:42,280
!لكن أستطيع الآن تنفيذ خطّتي

251
00:16:43,310 --> 00:16:44,770
.يا تاكاغي-سان

252
00:16:46,110 --> 00:16:49,350
،لنقل أنّ هناك عصيرًا لذيذًا لكن يصيبكِ بحمّى

253
00:16:49,350 --> 00:16:51,690
.والعصير الآخر هو عصير مقرف فحسب

254
00:16:52,290 --> 00:16:53,250
أيّهما تختارين؟

255
00:16:59,490 --> 00:17:00,710
".سؤال الخيارين"

256
00:17:02,430 --> 00:17:05,450
،عصير لذيذ جدًّا يصيبني بحمّى

257
00:17:05,450 --> 00:17:07,960
أم عصير مقرف فحسب؟

258
00:17:09,670 --> 00:17:12,420
ما رأيك يا تاكاغي-سان؟
لا يمكنك أن تختاري، صحيح؟

259
00:17:12,860 --> 00:17:16,510
اشعري بالقلق، دعيني أرى وجهك
!القلق هذا يا تاكاغي-سان

260
00:17:17,330 --> 00:17:18,140
.نيشيكاتا

261
00:17:20,270 --> 00:17:25,560
إذا شربت العصير اللّذيذ وأصبت
بحمّى، فهل ستأتي لزيارتي؟

262
00:17:26,060 --> 00:17:30,300
ماذا؟ هـ-هل لهذا أيّ علاقة بإجابتك؟

263
00:17:30,300 --> 00:17:31,520
.علاقة كبيرة

264
00:17:32,710 --> 00:17:33,990
ألن تأتي وتراني؟

265
00:17:36,890 --> 00:17:42,310
.إ-إذا أصبت بحمّى، فأظنّني سأزورك

266
00:17:42,800 --> 00:17:44,500
.إذًا أختار اللّذيذ

267
00:17:47,930 --> 00:17:48,730
ماذا؟

268
00:17:49,730 --> 00:17:52,630
هذا غريب. ما هذا؟

269
00:17:53,430 --> 00:17:56,590
.تاكاغي-سان غير متضايقة إطلاقًا

270
00:17:57,260 --> 00:18:01,730
الشّخص المضطرب الوحيد هنا... هو أنا؟

271
00:18:03,150 --> 00:18:05,570
.خطّة "سؤال الخيارين" قد فشلت

272
00:18:05,980 --> 00:18:08,770
!لا، لا! الوقت مبكّر جدًّا على الاستسلام

273
00:18:09,240 --> 00:18:10,810
!السّؤال التّالي إذًا

274
00:18:11,390 --> 00:18:12,320
.حسنًا

275
00:18:12,320 --> 00:18:16,150
،لا مصروف مدى الحياة
أم عدم السّخرية منّي بعد الآن؟

276
00:18:16,150 --> 00:18:18,070
.لا مصروف مدى الحياة

277
00:18:18,070 --> 00:18:19,070
!إجابة سريعة

278
00:18:20,030 --> 00:18:24,380
،كنت أدّخر مال السّنة الجديدة
.لذا سأكون على ما يرام لبعض الوقت

279
00:18:24,380 --> 00:18:26,600
،حالما أدخل المدرسة الثّانويّة
.سأبدأ بعمل بدوام جزئيّ

280
00:18:27,010 --> 00:18:30,080
.لهذا أفضّل الاستمرار في السّخرية منك

281
00:18:31,460 --> 00:18:35,050
!استهنت بها! عليّ أن أطرح سؤالاً أفضل

282
00:18:35,360 --> 00:18:36,340
.نيشيكاتا

283
00:18:36,340 --> 00:18:37,140
ماذا؟

284
00:18:37,630 --> 00:18:39,840
،طرحت أسئلة غريبة

285
00:18:40,720 --> 00:18:43,660
لكن هل تحاول أن تعكّر صفوي؟

286
00:18:47,360 --> 00:18:48,940
...لا، ليس تمامًا

287
00:18:49,780 --> 00:18:51,940
.سأسألك أنا هذه المرّة إذًا

288
00:18:52,250 --> 00:18:54,070
هل تفضّل اختفائي

289
00:18:54,070 --> 00:18:56,840
أم استمراري في السّخرية منك للأبد؟

290
00:18:56,840 --> 00:18:57,910
أيّهما تفضّل؟

291
00:18:59,340 --> 00:19:00,900
اختفاء"؟"

292
00:19:01,900 --> 00:19:02,820
.سأختفي

293
00:19:05,020 --> 00:19:06,240
ماذا؟

294
00:19:06,240 --> 00:19:10,080
لا أريدها أن تسخر منّي، لكن أن تختفي؟

295
00:19:10,510 --> 00:19:12,540
...هذا نوعًا ما

296
00:19:13,230 --> 00:19:15,750
.أختار أن أتعرّض للسّخرية

297
00:19:18,300 --> 00:19:20,850
تحبّ أن يُسخر منك إذًا؟

298
00:19:20,850 --> 00:19:23,960
!لا، بالطّبع لا

299
00:19:23,960 --> 00:19:28,760
.لكن... اختفاءكِ ليس ما أريده فعلاً

300
00:19:30,060 --> 00:19:31,870
تقصد أنّك تريد أن تكون معي؟

301
00:19:33,310 --> 00:19:34,430
...ليس كذلك

302
00:19:35,120 --> 00:19:36,610
!وجهك أحمر

303
00:19:36,610 --> 00:19:42,070
تبًّا لك يا تاكاغي-سان! هل رؤيتي
مرتبكًا ممتعة إلى هذا الحدّ؟

304
00:19:42,560 --> 00:19:45,410
!عليّ أن أبحث عن سؤال جيّد

305
00:19:45,410 --> 00:19:46,430
.السّؤال التّالي

306
00:19:46,430 --> 00:19:48,040
!أما زلنا نفعل هذا؟

307
00:19:48,350 --> 00:19:50,950
الحصول على صفر في كلّ
،امتحاناتك مدى الحياة

308
00:19:51,540 --> 00:19:53,370
أم تقبيلي؟

309
00:19:53,370 --> 00:19:54,630
أيّهما تختار؟

310
00:19:54,630 --> 00:19:55,880
!ماذا؟

311
00:19:55,880 --> 00:19:57,380
—قـ-قـ

312
00:20:00,670 --> 00:20:01,750
أيّهما؟

313
00:20:03,310 --> 00:20:05,790
الحصول على صفر حتّى لو درست؟

314
00:20:05,790 --> 00:20:07,760
.نعم. صفر مهما فعلت

315
00:20:08,990 --> 00:20:10,900
.هذا مستحيل

316
00:20:10,900 --> 00:20:15,870
هذا يعني أن أنحرم من المصروف
!ولا أستطيع دخول مدرسة ثانويّة

317
00:20:16,260 --> 00:20:20,400
!وإذا اخترت القبلة، فسوف تستهزئ بي قطعًا

318
00:20:20,760 --> 00:20:22,500
لا تستطيع الاختيار، صحيح؟

319
00:20:22,500 --> 00:20:26,850
،تبًّا... كلّما تردّدت في الاختيار أكثر
!زادت سعادتها

320
00:20:27,850 --> 00:20:29,540
!عليّ أن أختار بسرعة

321
00:20:29,540 --> 00:20:32,630
الحصول على صفر في كلّ الامتحانات
...أمر مبالغ فيه! لكن

322
00:20:33,410 --> 00:20:34,460
!لا أملك خيارًا

323
00:20:35,150 --> 00:20:39,210
.إ-إذًا، أختار ما لا يمنحني صفرًا في الامتحانات

324
00:20:39,210 --> 00:20:41,040
والّذي هو؟

325
00:20:44,350 --> 00:20:46,920
...خـ-خيار القبلة

326
00:20:52,500 --> 00:20:54,680
.هكذا إذًا. حسنًا

327
00:20:57,180 --> 00:20:58,860
!ماذا؟

328
00:21:08,470 --> 00:21:10,100
.إذًا أنت

329
00:21:11,420 --> 00:21:13,730
.أطول منّي بقليل

330
00:21:16,160 --> 00:21:19,110
.ما الأمر يا نيشيكاتا؟ كنت أرى من أطول فقط

331
00:21:32,600 --> 00:21:35,630
.لقد استهزأت بي كثيرًا اليوم

332
00:21:38,910 --> 00:21:40,620
.لكن كشفتُ الأمر برمّته

333
00:21:40,620 --> 00:21:43,380
سأحرص على أن يكون أحد الخيارين
،تعجز هي عن اختياره

334
00:21:43,380 --> 00:21:46,140
.والآخر هو الاستهزاء بها ببساطة

335
00:21:46,650 --> 00:21:48,400
!بهذا الشّكل، سأربح قطعًا

336
00:21:48,990 --> 00:21:50,220
—تاكاغي-سان، السّؤال التّـ

337
00:21:50,220 --> 00:21:51,740
.إذًا السّؤال التّالي

338
00:21:51,740 --> 00:21:52,870
!ماذا؟

339
00:21:53,550 --> 00:21:56,370
الدّوران حول المدرسة بالوقوف
—على اليدين، أم نحن الاثنان

340
00:21:56,370 --> 00:21:59,570
!ا-انتظري! لا أستطيع الوقوف على يديّ

341
00:21:59,570 --> 00:22:02,340
!ومتى يمكنني طرح الأسئلة؟

342
00:22:02,340 --> 00:22:04,180
.عليك أن تجيب عن سؤالي أوّلاً

343
00:22:04,180 --> 00:22:04,980
...لـ-لكن