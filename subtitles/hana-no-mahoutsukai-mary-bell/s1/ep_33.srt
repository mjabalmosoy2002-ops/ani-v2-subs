."نعم هناك زهرة لكل شخص كوّن صداقة مع "ماري بيل

204
00:12:26,450 --> 00:12:29,910
.مذهل، انظروا! هذه لـ "روز-سان" وهذه لأبي وأمي

205
00:12:30,370 --> 00:12:32,120
!"وهنالك زهور لـ"بونغو" و"تاب أيضًا

206
00:12:32,450 --> 00:12:33,210
ماذا؟

207
00:12:33,660 --> 00:12:35,170
!"هل هذه زهرة "فيفيان

208
00:12:35,330 --> 00:12:36,630
!لا تزال صغيرة

209
00:12:36,750 --> 00:12:38,130
!إنها ظريفة جدًا

210
00:12:39,460 --> 00:12:43,470
أنا واثقة من أن حديقتها ستكون أجمل
.حديقة في عالم الزهور السحري

211
00:12:43,840 --> 00:12:45,430
."تطلعي لذلك يا "ماري بيل

212
00:12:45,680 --> 00:12:47,760
.أجل! سأبذل كل جهدي

213
00:12:48,010 --> 00:12:49,890
."فقط دعوا الأمر لـ"ماري بيل

214
00:13:10,240 --> 00:13:16,920
يا رجل، لم أكن أعلم أن والديها
.هما "بابا بيل فان ديكاسي" وزوجته

215
00:13:17,080 --> 00:13:20,540
."أنا أيضًا، في الواقع، أنا من كبار معجبي "ماما بيل فان ديكاسي

216
00:13:20,750 --> 00:13:22,750
.وأنا أيضًا

217
00:13:28,220 --> 00:13:31,890
."مرحبًا بكم، حان وقت برنامج "صني بيل تايم

218
00:13:32,100 --> 00:13:35,600
.والآن، معنا ضيفان رائعان من أجلكم

219
00:13:36,020 --> 00:13:39,600
المشعوذ الذي يظهر مرة كل قرن، "بابا فان ديكاسي-سان" و

220
00:13:39,600 --> 00:13:43,730
!"زوجته، الطباخة المحترفة "ماما بيل فون ديكاسي

221
00:13:51,490 --> 00:13:52,700
.مرحبًا

222
00:14:00,130 --> 00:14:04,880
...كما تعلمون، إنهما يسافران دائمًا حول العالم

223
00:14:04,880 --> 00:14:09,590
...ويحققان أحلام الناس من خلال استخدام السحر والطبخ

224
00:14:16,390 --> 00:14:20,560
.أراهن على أن "بابا بيل" و"ماما بيل" أيضًا مستخدمي سحر

225
00:14:20,560 --> 00:14:23,190
.سأحصل بالتأكيد على دليل قوي على ذلك

226
00:14:23,190 --> 00:14:23,980
!أجل، أجل

227
00:14:24,520 --> 00:14:30,700
.الآن، لنرَ مدى روعة عروضهما

228
00:14:39,790 --> 00:14:41,120
!الآن

229
00:15:00,440 --> 00:15:01,020
!ثلاثة

230
00:15:02,020 --> 00:15:02,650
!اثنان

231
00:15:03,690 --> 00:15:04,610
!واحد

232
00:15:14,450 --> 00:15:16,660
...نحن نبث مباشرة من لندن وهنا

233
00:15:16,950 --> 00:15:22,040
،أمام السور العظيم المعروف بأكبر مبنى حول العالم

234
00:15:22,210 --> 00:15:24,790
ماذا سوف يحدث الآن؟

235
00:15:25,460 --> 00:15:27,090
!نقل آني

236
00:15:34,720 --> 00:15:38,720
(ملاحظة: استخدمت تعبير صيني "آيا" يوحي بالدهشة أو الشعور بالإحباط)

237
00:15:35,220 --> 00:15:37,430
!هذا مفاجئ

238
00:15:42,390 --> 00:15:45,310
!بابا رين بيرو رون ران ران ران

239
00:15:53,610 --> 00:15:58,080
لقد نجح، تمكنت المروحية من العبور
!من خلال الجزء المتلاشي من المبنى

240
00:15:58,080 --> 00:16:00,910
!لقد اختفى منتصف المبنى

241
00:16:01,410 --> 00:16:03,290
.لقد شاهدت هذا العرض من قبل

242
00:16:03,960 --> 00:16:08,130
.ظننت أنها خدعة رائعة، ولكنه سحر حقيقي

243
00:16:08,920 --> 00:16:12,300
!هيا يا "تاكورو-سان" لا تكشف الخدعة

244
00:16:12,300 --> 00:16:12,760
ماذا؟

245
00:16:12,760 --> 00:16:14,930
.أنتِ على حق

246
00:16:15,340 --> 00:16:20,390
التالي، تفقدوا الكعكة المذهلة
."التي ستصنعها "ماما بيل فان ديكاسي

247
00:16:27,190 --> 00:16:28,900
!هذا جميل

248
00:16:28,900 --> 00:16:30,110
!تبدو لذيذة

249
00:16:30,110 --> 00:16:31,820
،اليوم ولأول مرة في بلادنا

250
00:16:31,820 --> 00:16:35,700
!سيرينا الاثنان سحر الحلوى

251
00:16:46,500 --> 00:16:50,130
!بابا رين بيرو رون، ران ران ران

252
00:16:50,130 --> 00:16:51,840
!هناك

253
00:17:12,610 --> 00:17:16,280
!ماما رين بيرو رون رون رون

254
00:17:16,490 --> 00:17:17,200
!هناك

255
00:17:29,080 --> 00:17:31,040
!هذا رائع، إنه حقيقي

256
00:17:31,290 --> 00:17:33,710
...يبدو وكأنه سحر حقيقي

257
00:17:35,010 --> 00:17:37,050
ما الذي تشاهدينه يا "فيفيان"؟

258
00:17:37,680 --> 00:17:41,640
."إنه عرض سحري رائع في برنامج "صني بيل تايم

259
00:17:42,430 --> 00:17:45,430
.سحر؟ يا للسخافة

260
00:17:45,980 --> 00:17:46,730
!الآن

261
00:17:51,480 --> 00:17:52,650
!مدهش

262
00:17:52,650 --> 00:17:55,030
!ماري بيل"، أبيك وأمك لطيفان للغاية"

263
00:17:55,610 --> 00:17:57,820
أليس كذلك؟

264
00:18:07,660 --> 00:18:09,330
!"ماما بيل"، "بابا بيل"

265
00:18:09,540 --> 00:18:14,500
سأسكب هذا الطلاء على رؤوسكما
.لإجباركما على استخدام السحر

266
00:18:14,500 --> 00:18:15,510
!أجل، أجل

267
00:18:17,970 --> 00:18:19,970
!الآن، استخدموا السحر

268
00:18:24,680 --> 00:18:25,560
!"بابا بيل"

269
00:18:26,680 --> 00:18:28,890
."سحر أزهار "ماري بيل

270
00:18:30,150 --> 00:18:33,230
!ماري رين بيرو رون، رين رين رين

271
00:18:33,230 --> 00:18:35,940
!تحوّل إلى فراشات أيها الطلاء

272
00:18:50,870 --> 00:18:53,340
!"جدي، انظر إلى هذا، إنه "جيتو

273
00:18:53,340 --> 00:18:53,880
ماذا؟

274
00:18:54,880 --> 00:18:56,420
!ما هذا

275
00:18:56,960 --> 00:19:00,010
!"ذلك الأحمق "جيتو

276
00:19:00,430 --> 00:19:02,590
ماذا يفعل على أي حال؟

277
00:19:06,510 --> 00:19:08,020
،استمعوا جميعًا

278
00:19:08,100 --> 00:19:11,770
."السحر الذي رأيتموه للتو كان سحر ابنتي "ماري بيل

279
00:19:11,940 --> 00:19:13,150
ماذا؟

280
00:19:16,610 --> 00:19:20,740
.فهمت! إذن خططا لظهور ابنتهما الأول

281
00:19:20,900 --> 00:19:26,120
.تذكرت، طلب "بابا بيل-سان" من "جيتو" أن يفعل ذلك

282
00:19:27,370 --> 00:19:28,870
...لقد تم خداعي

283
00:19:29,160 --> 00:19:30,410
."الآن، ألقي التحية عليهم يا "ماري بيل

284
00:19:30,500 --> 00:19:31,080
.حسنًا

285
00:19:31,750 --> 00:19:35,000
،"كما يفعل "بابا بيل" و"ماما بيل

286
00:19:35,000 --> 00:19:38,210
سأبذل قصارى جهدي لتحقيق العديد
."من الأحلام والابتسامات في "صني بيل

287
00:19:38,460 --> 00:19:39,710
!جميعًا

288
00:19:39,710 --> 00:19:41,300
!تشرفت بمقابلتكم

289
00:19:45,680 --> 00:19:46,720
.شكرًا لكم

290
00:19:47,310 --> 00:19:48,850
."حسنًا يا "ماري بيل

291
00:19:48,850 --> 00:19:49,350
.ها نحن ذا

292
00:19:49,350 --> 00:19:49,970
.حسنًا

293
00:19:50,520 --> 00:19:53,520
!ماري رين بيرو رون رين رين

294
00:19:53,520 --> 00:19:56,230
!أيها الجنيات، ساعدونا

295
00:19:56,360 --> 00:19:57,150
!الآن

296
00:20:06,950 --> 00:20:07,740
!هنا

297
00:20:08,280 --> 00:20:09,040
!أجل

298
00:20:18,000 --> 00:20:19,710
...أشعر وكأنني أحلم

299
00:20:20,000 --> 00:20:22,050
!"هذا رائع يا "ماري بيل

300
00:20:22,050 --> 00:20:23,470
!إن "ماري بيل" مذهلة

301
00:20:31,890 --> 00:20:33,890
."لقد قضيت وقتًا ممتعًا يا "ماري بيل

302
00:20:34,020 --> 00:20:36,020
!"وأنا أيضًا يا "بابا بيل" و"ماما بيل

303
00:20:36,350 --> 00:20:41,440
عليكِ أن تستمري في زرع الزهور
."في قلوب العديد من الناس يا "ماري بيل

304
00:20:41,650 --> 00:20:42,240
!حسنًا

305
00:20:42,650 --> 00:20:45,110
!"فقط دعوا الأمر لـ"ماري بيل

306
00:20:46,660 --> 00:20:48,620
!"الآن، سنغادر يا "ماما بيل

307
00:20:48,780 --> 00:20:49,330
.أجل

308
00:20:53,120 --> 00:20:55,290
!وداعًا

309
00:21:02,880 --> 00:21:04,470
،"يوري"، "كين"

310
00:21:04,470 --> 00:21:06,050
!سأسبقكما إلى الحديقة

311
00:21:06,130 --> 00:21:08,010
!"أجل، لنذهب يا "ماري بيل

312
00:21:08,010 --> 00:21:09,470
!أجل، هيا

313
00:21:11,060 --> 00:21:12,640
!استعداد، انطلاق

314
00:21:26,150 --> 00:21:28,360
."أهلًا، أنا "ماري بيل

315
00:21:28,570 --> 00:21:32,450
ظهر منزل الحلوى من العدم بجوار منزل الزهور الخاص بيّ

316
00:21:32,990 --> 00:21:37,000
أعلم، أن جدي وجدتي "جيليبيل" و"بابا بيل" من فعلا ذلك

317
00:21:37,330 --> 00:21:40,920
ماذا؟ هل نسيا استخدام السحر لجعل بيت الحلوى يختفي؟

318
00:21:41,170 --> 00:21:43,710
!حسنًا، لنأكله معًا

319
00:21:44,460 --> 00:21:49,970
:"في الحلقة القادمة من "ساحرة الأزهار ماري بيل
"منزل الحلوى والزوجان المضحكان"

320
00:21:50,220 --> 00:21:52,180
!"فقط دعوا الأمر لـ"ماري بيل

321
00:22:03,320 --> 00:22:10,320
...هل الأمر صعب للغاية ولا يمكن الوصول إليه

322
00:22:11,320 --> 00:22:17,370
حتى إنك تشعر بالحيرة؟...

323
00:22:19,370 --> 00:22:26,840
،إذا اخترت الاستسلام الآن

324
00:22:27,630 --> 00:22:33,260
هل ستكون الأسعد؟

325
00:22:34,810 --> 00:22:38,100
،يوم طويل جدًا

326
00:22:38,730 --> 00:22:42,230
.بعد عام ولكنه قصير جدًا

327
00:22:42,770 --> 00:22:50,610
...إنك مرهق، تشعر بالتعب شيئًا فشيئًا

328
00:22:52,740 --> 00:22:58,750
...أنت لا تتذكر هذا، ولكن

329
00:23:00,750 --> 00:23:08,050
أنت الأحب إلى قلبي

330
00:23:08,670 --> 00:23:16,220
أشعر بهذه القوة الخفية

331
00:23:16,720 --> 00:23:24,190
ابقَ قويّ الذهن