1
00:00:02,810 --> 00:00:05,670
مذكّرات فريق التحرِّي ك.زد

2
00:00:07,200 --> 00:00:08,530
اسمي تاتشيبانا أيا

3
00:00:09,140 --> 00:00:16,000
لم أتخيّل أبداً أن يغيِّرَ لِقائي بأربعة فتيان
غريبي الأطوار حياتي إلى هذا الحدّ الكبير

4
00:00:12,510 --> 00:00:15,980
مذكّرات قضيّة فريق التحرِّي ك.زد

5
00:00:17,920 --> 00:00:23,530
سأروي لكم قصّة القضايا المُثيرة التي نحلُّها
نحن، فريق التحرِّي ك.زد

6
00:00:25,960 --> 00:00:28,840
،مهووس الأرقام أويسوغي-كون

7
00:00:28,840 --> 00:00:34,500
لا يبلي بلاءً حسناً في الرياضيات
ويتعثّرُ عند الدرج، ويتصرّفُ بغرابة بشكل عام

8
00:00:34,500 --> 00:00:36,010
مما أثارَ قلقي

9
00:00:36,220 --> 00:00:39,490
بالإضافة إلى حادِثة مكبّ النفايات
في الباحة الخلفية

10
00:00:39,490 --> 00:00:40,970
حيثُ كان واكاتاكي الضحية

11
00:00:41,350 --> 00:00:47,000
لكن أويسوغي-كون وكوروكي-كون
ينسحبان من التحقيق في هذه الحادثة

12
00:00:47,000 --> 00:00:48,240
ماذا أفعل؟

13
00:00:48,680 --> 00:00:54,770
لكن حينئذ سُرعان ما شهدتُ
الجريمةَ بنفسي

14
00:00:58,340 --> 00:01:00,090
"الباحة الخلفية تعلم"

15
00:01:00,090 --> 00:01:01,950
"الجزء 2"

16
00:01:08,700 --> 00:01:09,880
...تاكاني

17
00:01:09,880 --> 00:01:11,960
عثرتُ على المشتبه به

18
00:01:13,720 --> 00:01:17,290
اتصلتُ بخبيرنا في الشؤون الداخلية، كوروكي-كون

19
00:01:17,290 --> 00:01:21,890
لعلَّه يكتشف شيئاً عن هذا الشخص
المدعو تاكاني

20
00:01:21,890 --> 00:01:23,470
لكن ظهر لي المُجيبُ الآلي

21
00:01:24,650 --> 00:01:28,480
أعلمُ أنك لن تُشارك في هذا التحقيق

22
00:01:28,940 --> 00:01:32,480
لكن هلّا ساعدتَني قليلاً؟

23
00:01:34,590 --> 00:01:37,990
لا أدري إن تلقَّى كوروكي-كون رسالتي

24
00:01:38,860 --> 00:01:41,490
وفي فترة العصر تلك

25
00:01:42,070 --> 00:01:44,860
إنه هو، من فريق ك.زد لكرة القدم

26
00:01:44,860 --> 00:01:45,480
إنه رائع جداً

27
00:01:45,480 --> 00:01:47,500
من ينتظر يا تُرى؟

28
00:01:47,500 --> 00:01:50,000
ماذا؟ أأتيتَ إلى المدرسة؟

29
00:01:51,500 --> 00:01:52,380
آيا

30
00:01:55,230 --> 00:01:57,010
هلّا منحتِني من وقتكِ خمس دقائق؟

31
00:02:01,590 --> 00:02:03,470
يحدِّقُ الناسُ بي مجدداً

32
00:02:05,770 --> 00:02:08,480
تاكاني مشاغبٌ بعض الشيء

33
00:02:08,480 --> 00:02:10,670
مشاغب؟

34
00:02:10,670 --> 00:02:13,170
يسيِّرُ كلبَه بلا قيود

35
00:02:13,170 --> 00:02:16,120
ويقودُ بشكلٍ عكسي في طريق
أُحادي الاتّجاه بدرّاجته

36
00:02:16,120 --> 00:02:16,990
تبّاً

37
00:02:16,990 --> 00:02:20,830
والأسوأ، يجمعُ عُلَبَ الألمنيوم من مواقع النفايات

38
00:02:20,830 --> 00:02:23,340
ويبيعها لمدوِّري النفايات

39
00:02:23,340 --> 00:02:26,390
يرتكبُ كل هذه الجرائم دون أن تجفل له عين

40
00:02:26,390 --> 00:02:28,000
إنه ليسَ مواطناً سوياً

41
00:02:28,000 --> 00:02:32,400
لهذا فهو من الأشخاص الذين يرمون
القمامةَ في غير مكانها المخصّص في المدرسة

42
00:02:32,400 --> 00:02:34,590
ويبدو أن جيرانه يتجنّبونه أيضاً

43
00:02:36,160 --> 00:02:37,010
آيا؟

44
00:02:37,010 --> 00:02:39,140
آ..آسفة

45
00:02:39,790 --> 00:02:45,970
خطرَتْ في ذهني فكرة للتو وهي
أن هذه قد تكون حادثة فظيعة

46
00:02:45,970 --> 00:02:50,480
أتعلمُ كيف تتراكمُ الأحداث في حياتنا اليومية
حتّى تبلغ ذروتها؟

47
00:02:50,480 --> 00:02:52,550
أظنُّ أنه من المهم أن

48
00:02:52,550 --> 00:02:56,990
،نحمي حياتنا اليومية بحلِّ هذه القضايا

49
00:02:56,990 --> 00:02:59,490
وذلك كي نعيش بسعادة

50
00:02:59,920 --> 00:03:01,790
أظنُّكِ على حقّ

51
00:03:05,270 --> 00:03:08,660
اتُّهِمَ واكاتاكي بشيء فعلَه تاكاني
وقد تأذّى منه

52
00:03:09,270 --> 00:03:11,500
وربَّما سيستمرُّ في فعل الشيء ذاته

53
00:03:11,950 --> 00:03:15,320
علينا أن نفعل شيئاً كي نتمكّن
من حماية حياتنا اليومية

54
00:03:15,770 --> 00:03:16,500
نعم

55
00:03:16,860 --> 00:03:18,720
نحتاجُ لدليل ما

56
00:03:19,300 --> 00:03:21,510
ما رأيك أن نلتقط صورةً للجريمة؟

57
00:03:21,510 --> 00:03:22,640
صورة؟

58
00:03:22,640 --> 00:03:26,560
قد تصغي الشرطة إلينا إن قدّمنا إليهم الدليل

59
00:03:26,560 --> 00:03:28,760
يستطيعُ واكاتاكي استعادة سمعته

60
00:03:28,760 --> 00:03:30,820
إن تمكنَّا من إبرازه لمعلّمه أيضاً

61
00:03:30,820 --> 00:03:32,350
نعم، معك حقّ

62
00:03:32,350 --> 00:03:33,480
شكراً

63
00:03:34,350 --> 00:03:36,550
ألا يجدر بكِ مغادرة مدرسة الدورات المكثّفة الآن؟

64
00:03:36,550 --> 00:03:37,480
ستتأخَّرين

65
00:03:38,290 --> 00:03:40,490
ألن تأتي يا كوروكي-كون؟

66
00:03:41,620 --> 00:03:42,740
أنا مشغول

67
00:03:45,080 --> 00:03:47,870
أنتِ واضحة المعالم يا آيا

68
00:03:47,870 --> 00:03:50,000
مكتوب في جبينكِ أنّكِ تريدينني أن آتي

69
00:03:52,050 --> 00:03:53,980
أنتِ ظريفة هكذا

70
00:03:55,270 --> 00:03:57,500
!ظ-ظريفة؟

71
00:03:58,260 --> 00:04:02,010
بصِفتي عضو في فريق التحرِّي
يجدرُ بي تقديم المساعدة

72
00:04:02,010 --> 00:04:04,510
لكنني قلِق حقاً على أويسوغي

73
00:04:06,280 --> 00:04:08,470
لا بدّ وأن شيئاً قد أصابه

74
00:04:08,470 --> 00:04:10,060
مثل ماذا؟

75
00:04:10,060 --> 00:04:11,040
لا أدري

76
00:04:11,040 --> 00:04:13,500
لكن لا بدّ وأنه يتألَّم

77
00:04:13,500 --> 00:04:15,980
لهذا أريدُ أن أستمرَّ في مراقبته

78
00:04:16,670 --> 00:04:18,480
أودُّ أن أفعلَ له شيئاً

79
00:04:18,930 --> 00:04:21,370
أتهتمُّ به حقاً؟

80
00:04:22,110 --> 00:04:24,490
صداقة الصبيان لطيفة جداً

81
00:04:25,070 --> 00:04:27,990
بالإضافة إلى أن أويسوغي قد يأتي لزيارتك

82
00:04:29,920 --> 00:04:31,500
سألَني عن عنوانكِ

83
00:04:31,970 --> 00:04:33,500
لماذا؟

84
00:04:34,180 --> 00:04:36,500
لعلَّه يريدُ شخصاً أن يسمعه

85
00:04:36,870 --> 00:04:39,500
لكن لا يستطيعُ أن يتحدّثَ حتّى معك

86
00:04:39,880 --> 00:04:41,980
لأن كِلينا شابّان

87
00:04:41,980 --> 00:04:43,440
ربَّما يشعرُ بالمُنافَسة

88
00:04:43,440 --> 00:04:45,510
أخالُه لا يريدُ الكشف عن نقطةِ ضعف

89
00:04:46,090 --> 00:04:50,690
بينما أنتِ فتاة، لِذا قد يكشف عن ما يدور في ذهنه

90
00:04:51,030 --> 00:04:52,520
اسمعيه إن فعلَ ذلك

91
00:04:52,520 --> 00:04:53,900
حسناً

92
00:04:53,900 --> 00:04:57,980
أويسوغي-كون، سأستمعُ إليك
يمكنُك دوماً اللجوء إليّ

93
00:04:58,990 --> 00:05:02,400
في الصباح التالي، أنا وواكاتاكي وكوزوكا-كون

94
00:05:02,400 --> 00:05:05,090
اجتمعنا عند البوّابة الخلفية لمدرسة
واكاتاكي الإعدادية

95
00:05:05,090 --> 00:05:10,990
قرَّرنا أن نعمل على نصيحةِ كوروكي-كون
ونحاول التقاط صورة للجريمة

96
00:05:10,990 --> 00:05:12,160
...و

97
00:05:18,460 --> 00:05:20,520
كوزوكا-كون، هل التقطت صورة؟

98
00:05:20,520 --> 00:05:22,090
إنها بعيدة قليلاً

99
00:05:22,090 --> 00:05:24,010
علينا أن نقتربَ أكثر

100
00:05:24,010 --> 00:05:26,910
،ولكي أستردَّ سمعتي الطيّبة

101
00:05:26,910 --> 00:05:30,010
نحتاجُ لصورة له وهو يرمي القمامة
في الباحةِ الخلفية

102
00:05:32,400 --> 00:05:33,970
إلى أين هو ذاهب؟

103
00:05:37,980 --> 00:05:39,730
لقد دخلَ للتو

104
00:05:39,730 --> 00:05:41,630
أليس ذلك مرآب جاره؟

105
00:05:41,630 --> 00:05:42,980
أ-أجل

106
00:05:49,470 --> 00:05:52,140
أتساءلُ ما إن كان تاكاني يملكُ هذا المنزل أيضاً

107
00:05:53,450 --> 00:05:55,290
يجدرُ بنا العودة لتبديل ملابسنا

108
00:05:55,290 --> 00:05:56,720
سنتأخّرُ عن المدرسة

109
00:05:57,480 --> 00:05:58,370
نعم

110
00:05:58,370 --> 00:06:01,500
لا يزالُ هنالِك الكثير مما أريدُ معرفته
لكن علينا الذهاب إلى المدرسة

111
00:06:02,300 --> 00:06:06,820
حسناً، سنضطرُّ للانتظار حتّى يوم غد
لجمع دليل مكبّ النفايات في الباحة الخلفية

112
00:06:09,130 --> 00:06:11,510
حسبتُ أنني سمعتُ شيئاً للتو

113
00:06:18,980 --> 00:06:21,430
ثـ-ثمّة شيء في المنزل

114
00:06:21,430 --> 00:06:22,960
سمعتُ لُهاثاً

115
00:06:22,960 --> 00:06:24,530
بدا كصوت حيوان

116
00:06:24,530 --> 00:06:25,860
حيوان؟

117
00:06:25,860 --> 00:06:28,990
لكن ليس من الغريب أن تتواجد
الحيوانات الأليفة داخل منزل

118
00:06:29,490 --> 00:06:31,690
...أ... أعلم، لكن

119
00:06:31,690 --> 00:06:32,990
هذا مريب

120
00:06:33,420 --> 00:06:34,490
هيّا، لنذهب

121
00:06:34,490 --> 00:06:36,400
حـ-حسناً

122
00:06:38,500 --> 00:06:41,230
لم يكُن هنالك حاجة لإيصالي إلى المنزل

123
00:06:41,230 --> 00:06:44,480
أنا أمرُّ من نفس الاتِّجاه أثناء ذهابي
إلى المنزل يا سخيفة

124
00:06:44,480 --> 00:06:46,630
وليسَتْ بمُشكلة لي بما أنني أركبُ درَّاجة

125
00:06:46,630 --> 00:06:48,730
إلى اللقاء

126
00:06:54,760 --> 00:06:56,510
لقد تأخرتِ يا آيا

127
00:06:56,510 --> 00:06:58,480
لقد ابتعدت

128
00:06:58,480 --> 00:07:00,860
لا تخيفيني هكذا

129
00:07:00,860 --> 00:07:04,840
لقد قلقتُ من أن تكوني قد تعرضتِ
لحادِثة أثناء هروَلتكِ

130
00:07:04,840 --> 00:07:06,480
آ-آسفة يا أمي

131
00:07:06,960 --> 00:07:09,570
آيا، زاركِ أحدُ أصدقاؤكِ

132
00:07:09,570 --> 00:07:11,000
من؟

133
00:07:11,000 --> 00:07:12,990
صبي يُدعى أويسوغي-كون

134
00:07:14,170 --> 00:07:15,360
جاءَ منذُ لحظات

135
00:07:15,360 --> 00:07:16,810
ألم تلتقي به؟

136
00:07:16,810 --> 00:07:19,000
لا أدري ماذا أرادَ في هذا الوقت
المبكِّر من الصباح

137
00:07:19,560 --> 00:07:22,350
لا بدّ وأنه أرادني أن أستمع إليه

138
00:07:22,350 --> 00:07:25,300
ربّما يكونُ قد رآني مع واكاتاكي

139
00:07:27,000 --> 00:07:28,960
ماذا لو انتابَه الانطباع الخاطئ؟