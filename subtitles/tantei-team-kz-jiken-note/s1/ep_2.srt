1
00:00:02,690 --> 00:00:05,520
مذكّرات قضيّة فريق التحرِّي ك.زد

2
00:00:07,060 --> 00:00:08,400
اسمي تاتشيبانا أيا

3
00:00:09,020 --> 00:00:15,860
لم أتخيّل أبداً أن يغيِّرَ لِقائي بأربعة فتيان
غريبي الأطوار حياتي إلى هذا الحدّ الكبير

4
00:00:12,360 --> 00:00:15,860
مذكّرات قضيّة فريق التحرِّي ك.زد

5
00:00:17,780 --> 00:00:23,410
سأروي لكم قصّة القضايا المُثيرة التي نحلُّها
نحن، فريق التحرِّي ك.زد

6
00:00:26,470 --> 00:00:31,090
كانَ لِقائي بهم أثناء عودتي من المدرسة
إلى المنزلِ لوحدي فظيعاً

7
00:00:31,090 --> 00:00:35,510
لا أصدقُ أنني التقيتُ بهم ثانيةً
في مدرسة دورات مكثّفة

8
00:00:35,770 --> 00:00:38,850
هذه تاتشيبانا أيا، ستنضمُّ إليكم في الصفّ
الخاصّ اعتباراً من اليوم

9
00:00:38,850 --> 00:00:40,510
إنها مُمتازة في الأدب

10
00:00:41,260 --> 00:00:42,330
أويسوغي

11
00:00:42,330 --> 00:00:43,280
كوروكي

12
00:00:43,280 --> 00:00:44,210
كوزوكا

13
00:00:44,210 --> 00:00:45,620
وواكاتاكي

14
00:00:46,050 --> 00:00:47,140
انسجِموا معاً

15
00:00:47,780 --> 00:00:52,190
تفاجأتُ بما طلبَه منِّي واكاتاكي-كون أن أفعله

16
00:00:53,010 --> 00:00:55,010
أريدُكِ أن تدلي بتصريح

17
00:00:55,010 --> 00:00:56,530
تصريح؟

18
00:00:56,530 --> 00:00:57,400
أجل

19
00:00:57,400 --> 00:00:59,450
سُرِقَتْ درّاجتي الجبليّة

20
00:01:02,720 --> 00:01:04,870
"الدرّاجة المفقودة تعلَم"

21
00:01:04,870 --> 00:01:06,540
"الجزء 2"

22
00:01:06,940 --> 00:01:09,040
سُرِقَتْ؟ متى؟ أين؟

23
00:01:09,480 --> 00:01:10,640
قبل قليل، هناك

24
00:01:11,280 --> 00:01:14,550
ماذا؟ لا يُسمَحُ لنا بركوبِ درّاجة في المدرسة

25
00:01:14,550 --> 00:01:17,390
أنتِ خبيرةٌ في الأدب، ألستِ كذلك؟

26
00:01:17,390 --> 00:01:19,050
اكتبي رسالةَ تصريح حالاً

27
00:01:19,460 --> 00:01:20,410
!تبّاً

28
00:01:20,410 --> 00:01:21,470
يتعجرَفُ من جديد

29
00:01:22,260 --> 00:01:23,170
لماذا؟

30
00:01:23,170 --> 00:01:25,370
ما علاقة هذا الأمر بي؟

31
00:01:25,370 --> 00:01:27,600
أعني ظننتُكِ واحدة منّا

32
00:01:31,400 --> 00:01:32,570
آسف

33
00:01:34,660 --> 00:01:35,790
يمكنُكِ الذهاب إلى المنزل

34
00:01:36,260 --> 00:01:37,240
كانَتْ غلطتي

35
00:01:39,220 --> 00:01:40,610
ما رأيكِ بيوم غد إذاً؟

36
00:01:40,610 --> 00:01:41,400
موافقة

37
00:01:42,260 --> 00:01:46,470
ربّما هكذا يخسرُ الناسُ أصدقائهم

38
00:01:47,280 --> 00:01:50,580
ربّما حدثَ هذا من قبل أيضاً

39
00:01:51,370 --> 00:01:55,590
ربّما كنتُ أفعلُ هذا طوال الوقت دون شعور

40
00:01:56,010 --> 00:01:58,750
ربّما لهذا أنا وحيدة تماماً الآن

41
00:02:00,590 --> 00:02:04,220
اعتبرَني واكاتاكي-كون صديقة

42
00:02:04,600 --> 00:02:08,600
لم يقلْ أحدٌ ذلك عنّي من قبل

43
00:02:14,690 --> 00:02:16,610
هل تشعرين برغبةٍ في كتابة التصريح الآن؟

44
00:02:18,090 --> 00:02:18,610
ماذا؟

45
00:02:19,110 --> 00:02:22,180
واكاتاكي هو أُستاذٌ في تحريض الناس

46
00:02:22,180 --> 00:02:24,510
!لقد نالَ منِّي

47
00:02:25,010 --> 00:02:27,690
لكن مع ذلك، يعترفُ واكاتاكي-كون أنني أمتلِكُ موهبة

48
00:02:27,690 --> 00:02:29,550
ويقبلُني كصديقة

49
00:02:30,120 --> 00:02:32,490
كيف تريدُني أن أكتبها؟

50
00:02:32,490 --> 00:02:34,130
...لنرَ

51
00:02:34,130 --> 00:02:35,400
"حذارِ أيها اللصّ"

52
00:02:35,400 --> 00:02:38,300
"تُبْ وأعد درّاجتي الجبلية، وسأعفو عنك"

53
00:02:38,300 --> 00:02:40,130
"إن لم تفعَلْ ستُعاقَب"

54
00:02:40,580 --> 00:02:42,140
هل أنتَ جادّ؟

55
00:02:42,370 --> 00:02:44,750
وسأُعلِمُكِ بالتفاصيل والفروقات البسيطة

56
00:02:44,750 --> 00:02:45,960
لا جدوى من ذلك على ما أظن

57
00:02:45,960 --> 00:02:48,640
من المُحال أن يُعيد لك درّاجتك

58
00:02:49,110 --> 00:02:51,520
لقد أقنعتُ والديّ أخيراً بشراءِ درّاجة لي

59
00:02:51,520 --> 00:02:53,780
واستلمتُها البارحة

60
00:02:53,780 --> 00:02:56,140
سأجدُها مهما كلّفَ الأمر

61
00:02:57,060 --> 00:02:58,440
إلى أين أنت ذاهِب؟

62
00:02:58,440 --> 00:02:59,740
إلى مسرحِ الجريمة

63
00:03:02,060 --> 00:03:03,010
أين هُم؟

64
00:03:03,010 --> 00:03:03,940
تأخّروا

65
00:03:03,940 --> 00:03:05,240
أجل

66
00:03:07,890 --> 00:03:10,250
واكاتاكي، أين تركتَ درّاجتك؟

67
00:03:10,250 --> 00:03:11,200
هنا تقريباً

68
00:03:12,640 --> 00:03:16,170
استخدمتُ جنزيرَ درّاجة وقفلاً تسلسلياً وكل شيء

69
00:03:16,760 --> 00:03:18,990
ما كان ينبغي أن تتركها هُنا

70
00:03:18,990 --> 00:03:20,210
أيّاً يكن، آسف

71
00:03:20,210 --> 00:03:22,430
،كان الطلاء الفينيلي في الجنزير أصفراً

72
00:03:24,010 --> 00:03:25,220
أليس كذلك؟

73
00:03:25,710 --> 00:03:26,680
كيف عرَفْت؟

74
00:03:27,520 --> 00:03:30,550
اقتلعَ اللصُّ الجنزيرَ دون فتح القفل التسلسلي

75
00:03:31,000 --> 00:03:32,850
هنالِك آثار لطلاء الجنزير

76
00:03:32,850 --> 00:03:33,590
وجدتُه

77
00:03:35,220 --> 00:03:35,770
انظروا

78
00:03:36,200 --> 00:03:37,190
فظيع

79
00:03:37,190 --> 00:03:39,690
لا يستطيع أي شخص عادي قطعه

80
00:03:39,690 --> 00:03:41,150
من إذاً؟

81
00:03:41,150 --> 00:03:44,240
كائناً من كان هذا الشخص، سأُمسِكُ به

82
00:03:44,700 --> 00:03:47,700
من المُستحيل أن نتمكّن من القبضِ على اللصّ
بتوفُّرِ هذا المعلومات فقط

83
00:03:48,110 --> 00:03:50,370
عليك أن تستسلم وتقدِّم بلاغاً

84
00:03:50,910 --> 00:03:52,570
ينبغي أن تكون مؤمَّنة

85
00:03:52,570 --> 00:03:54,180
بمقدورك شراء درّاجة جديدة بمالِ التأمين

86
00:03:54,180 --> 00:03:55,020
لا أستطيع

87
00:03:55,020 --> 00:03:58,850
إن عَلِمَ والدايّ بذهابي إلى مدرسة الدورات
المكثّفة بدرّاجة فلن يشتروا لي درّاجةً جديدة

88
00:03:58,480 --> 00:04:00,710
!مال

89
00:03:58,850 --> 00:04:00,710
ناهيك عن أنّهما سيقطعان عنِّي مصروفي

90
00:04:01,030 --> 00:04:02,560
هذه مصيبة

91
00:04:03,540 --> 00:04:05,150
سأقومُ بهذا في كافّة الأحوال

92
00:04:05,150 --> 00:04:06,680
افعل ما يحلو لك بمفردِك

93
00:04:06,680 --> 00:04:08,220
لا، لا أستطيع فعل هذا بمُفردي

94
00:04:09,400 --> 00:04:13,330
ما كنتُ لأُلاحِظ أمرَ السلسلة لولاك يا أويسوغي

95
00:04:13,330 --> 00:04:17,020
أنتَ المُلقَّب بـ"الحاذق بالأرقام"، رجل الأرقام أويسوغي

96
00:04:17,020 --> 00:04:18,570
أحتاجُ لمهاراتك التحليليّة

97
00:04:19,880 --> 00:04:22,130
وأحتاجُ لارتباطاتك يا كوروكي

98
00:04:23,200 --> 00:04:24,490
كوزوكا الاجتماع والعلوم

99
00:04:24,490 --> 00:04:26,810
لا أحد يفوقك في مجال الاجتماعِ والعلوم

100
00:04:26,810 --> 00:04:28,600
أحتاجُ لمُساعدتك

101
00:04:28,970 --> 00:04:30,600
وتاتشيبانا، أنتِ بارعة في الأدب

102
00:04:30,600 --> 00:04:32,250
أريدُكِ أن تكتبي رسالةً للصّ

103
00:04:34,810 --> 00:04:35,880
نعم

104
00:04:35,880 --> 00:04:38,120
سنقبضُ على اللصّ الذي سرقَ درّاجتي الجبليّة

105
00:04:38,120 --> 00:04:39,790
وسنسترجعُها

106
00:04:40,200 --> 00:04:42,170
لا تخذلوني يا جماعة

107
00:04:42,690 --> 00:04:43,820
لا نملك خياراً آخر على ما أظن

108
00:04:44,270 --> 00:04:47,260
واكاتاكي عبقريٌّ في تحريض الناس

109
00:04:48,060 --> 00:04:51,210
لا أدري ما إن كنتُ واحدة منهم

110
00:04:51,740 --> 00:04:54,010
حسناً، لنعقد اجتماع التخطيط

111
00:04:54,440 --> 00:04:57,120
عجباً! أنتَ واكاتاكي الموجة فعلاً

112
00:04:57,120 --> 00:04:58,690
واكاتاكي الموجة؟

113
00:04:59,600 --> 00:05:01,900
لا يُمكِن إيقافه حالما ينطلق

114
00:05:01,900 --> 00:05:05,200
علاماته متقلِّبة أيضاً

115
00:05:05,200 --> 00:05:08,280
كفّ عن الثرثرة، لنبدأ باجتماع التخطيط

116
00:05:08,700 --> 00:05:10,220
هل سنبدأ فوراً؟

117
00:05:10,220 --> 00:05:13,290
لا يجدرُ بنا العودة إلى المنزل متأخِّرين
قد يتّصلوا بالمنزل

118
00:05:13,680 --> 00:05:14,820
هذا صحيح

119
00:05:14,820 --> 00:05:15,820
غداً إذاً

120
00:05:15,820 --> 00:05:18,290
لنلتقِ في الصفّ الخاص قبل بدء الحصص الدراسيّة

121
00:05:18,600 --> 00:05:19,670
موافقون

122
00:05:20,680 --> 00:05:23,300
تأخرَ الوقتُ يا تاتشيبانا، هل أوصلكِ للمنزل؟

123
00:05:24,530 --> 00:05:26,690
"تأخرَ الوقتُ يا تاتشيبانا، هل أوصلكِ للمنزل؟"

124
00:05:26,690 --> 00:05:28,300
حقاً؟ ما هذا؟

125
00:05:28,610 --> 00:05:29,560
هيّا بنا

126
00:05:29,560 --> 00:05:31,040
حسناً، إلى اللقاء

127
00:05:34,500 --> 00:05:36,310
انتظر يا كوروكي-كون

128
00:05:38,310 --> 00:05:40,200
ما خطبُ تِلك النظرة؟

129
00:05:40,200 --> 00:05:41,790
بمقدوري الذهاب إلى المنزلِ بمفردي

130
00:05:41,790 --> 00:05:44,780
أنا واثقٌ بأن عائلتكِ قلِقة أيضاً

131
00:05:46,240 --> 00:05:48,450
لستِ ظريفة جداً، صحيح؟

132
00:05:49,950 --> 00:05:51,670
قلتُ أنني سأوصلُكِ للمنزل

133
00:05:51,670 --> 00:05:52,910
بمقدوركِ أن تدعيني أدلّلكِ فحسب

134
00:05:53,780 --> 00:05:57,330
لكن سأتوقّفُ إن كنتِ لا تُريدين ذلك فعلاً

135
00:05:58,200 --> 00:05:59,210
ما رأيكِ؟

136
00:06:02,920 --> 00:06:07,340
إن لم يكُن لديك مانع، أريدُك أن توصلني للمنزل

137
00:06:07,620 --> 00:06:09,340
جيّد، سأوصلكِ للمنزل

138
00:06:09,840 --> 00:06:10,790
تعالي

139
00:06:15,110 --> 00:06:17,630
لطالما شاهدتُ حلماً

140
00:06:17,630 --> 00:06:24,040
يقومُ فيه حبيبٌ بهيّ واثِق ذكيّ
حسن المظهر بحمايتي

141
00:06:24,040 --> 00:06:27,860
هل ذلك الحبيبُ هو كوروكي-كون؟

142
00:06:28,590 --> 00:06:29,860
هنا، صحيح؟

143
00:06:30,670 --> 00:06:32,200
كـ..كلّا

144
00:06:32,200 --> 00:06:33,400
كلّا؟

145
00:06:33,400 --> 00:06:36,130
منزلكِ هنا وفقاً للخريطة

146
00:06:36,130 --> 00:06:38,870
نعم، أنا هنا

147
00:06:39,140 --> 00:06:40,230
حسناً

148
00:06:40,230 --> 00:06:41,080
إلى اللقاء

149
00:06:42,150 --> 00:06:43,070
ماذا؟

150
00:06:43,660 --> 00:06:45,840
...انتظر لحظة، كان من المُفترَض أن تقول هنا

151
00:06:45,840 --> 00:06:47,700
كان اليوم ممتعاً للغاية

152
00:06:47,700 --> 00:06:48,540
...أو

153
00:06:48,540 --> 00:06:50,120
تصبحين على خير، أحلام سعيدة

154
00:06:50,120 --> 00:06:52,430
أو شيء من هذا القبيل

155
00:06:53,480 --> 00:06:55,810
كنتُ أخلطُ ما بين الحقيقة والخيال

156
00:06:56,130 --> 00:06:57,390
شكراً لك

157
00:06:58,080 --> 00:06:59,050
تصبحين على خير

158
00:07:02,190 --> 00:07:03,120
نعم؟

159
00:07:03,120 --> 00:07:03,980
هذه أنا

160
00:07:04,840 --> 00:07:06,490
تأخرتِ

161
00:07:06,490 --> 00:07:07,570
أمِّي

162
00:07:08,260 --> 00:07:09,740
قلقتُ عليكِ كثيراً

163
00:07:09,740 --> 00:07:12,750
وقعَتْ عمليةُ سرِقة في المتجر
جِوار مدرستكِ

164
00:07:12,750 --> 00:07:13,910
عمليّة سرِقة؟

165
00:07:14,830 --> 00:07:17,500
،هدّدوا العامِلين بسكِّين وسرقوا أموالهم

166
00:07:17,500 --> 00:07:19,440
ومن ثمّ هربوا بسيَّارة

167
00:07:19,440 --> 00:07:21,960
لم يقبضوا على اللصوصِ بعد

168
00:07:21,960 --> 00:07:23,960
انتظرتُك بقلق شديد