1
00:00:02,810 --> 00:00:05,670
!مذكّرات فريق التحرِّي ك.زد

2
00:00:07,200 --> 00:00:08,530
اسمي تاتشيبانا أيا

3
00:00:09,140 --> 00:00:16,000
لم أتخيّل أبداً أن يغيِّرَ لِقائي بأربعة فتيان
غريبي الأطوار حياتي إلى هذا الحدّ الكبير

4
00:00:12,510 --> 00:00:15,980
مذكّرات قضيّة فريق التحرِّي ك.زد

5
00:00:17,740 --> 00:00:23,530
سأروي لكم قصّة القضايا المُثيرة التي نحلُّها
نحن، فريق التحرِّي ك.زد

6
00:00:25,770 --> 00:00:29,920
مارسوا الابتزاز والسرقة وحتّى التلاعُب بالحوالات المصرفية

7
00:00:29,920 --> 00:00:34,590
وأمّا قائدهم، الشبح أكس، فقد كان شخصاً يُدعى أونوزكا على ما يبدو

8
00:00:34,590 --> 00:00:39,680
وتبيّنَ أن زميلي السّابِق في الصفّ، سوناهارا
يعملُ في المجموعة

9
00:00:39,680 --> 00:00:44,810
...أردنا إنقاذ سوناهارا من المجموعةِ بشكل ما، لكن

10
00:00:45,360 --> 00:00:47,960
لن نتمكّن من رؤيةِ بعضنا الآخر بعدَ الآن

11
00:00:48,350 --> 00:00:49,550
وداعاً

12
00:00:49,550 --> 00:00:54,990
بعد فترة قصيرة، تلقّينا أنباء من أويسوغي-كن
بأنَّ مجموعتهم ستعقدُ اجتماعاً

13
00:00:54,990 --> 00:00:59,370
سوناهارا على وشك أن يبدأ بشيء
لا يستطيعُ التراجع عنه أبداً

14
00:01:04,860 --> 00:01:06,100
!سوناهارا

15
00:01:06,100 --> 00:01:07,650
!توقّعتُ ذلك

16
00:01:12,120 --> 00:01:15,420
توقّعتُ أن تكون الشخص الذي يطعنني
من الخلف يا سوناهارا

17
00:01:16,640 --> 00:01:18,560
"عيد الحبّ يعلم"

18
00:01:18,560 --> 00:01:19,930
"الجزء 4"

19
00:01:21,660 --> 00:01:22,760
أونوزكا

20
00:01:22,760 --> 00:01:25,850
أعد الـ6 مليون ين التي سلبتَها من السيّد أويهارا

21
00:01:26,490 --> 00:01:27,600
ستّة مليون؟

22
00:01:28,460 --> 00:01:30,980
يبدو أنّهم غارقون في الديون

23
00:01:31,590 --> 00:01:34,820
سمعتُ أنّهم تعرّضوا لعملية احتيال

24
00:01:35,120 --> 00:01:36,500
وماذا لو رفضت؟

25
00:01:36,500 --> 00:01:38,730
سأفضحُ كلّ جرائمك

26
00:01:39,620 --> 00:01:41,700
لديّ الدليل برمّتِه هنا

27
00:01:42,040 --> 00:01:43,660
أيا، أأتيتِ؟

28
00:01:44,060 --> 00:01:45,230
كوزوكا-كن

29
00:01:45,680 --> 00:01:46,960
الآخرون قادمون أيضاً

30
00:01:46,960 --> 00:01:48,620
لقد استدعينا الشرطة كذلك

31
00:01:48,620 --> 00:01:50,960
هل أنت متأكِّدٌ من قرارِك هذا؟

32
00:01:50,960 --> 00:01:54,130
لقد ارتكبتَ بعض الجرائم تحت قيادتي أيضاً

33
00:01:54,130 --> 00:01:55,700
لا تستهِن بي

34
00:01:55,700 --> 00:02:00,590
لم أتقرّبْ منك إلّا لأحصل على دليلٍ يُدينك

35
00:02:00,900 --> 00:02:03,450
إذاً الشبح أكس كان أونوزكا

36
00:02:04,990 --> 00:02:08,450
كلّ الأموال التي قلتُ أنني سرقتُها لأجلِك كانَتْ أموالي

37
00:02:08,450 --> 00:02:11,360
لم أرتكِب أي جريمة تُذكَر

38
00:02:11,670 --> 00:02:12,920
أحسنت

39
00:02:12,920 --> 00:02:14,980
عرفتُ أنّك ذو قيمة كبيرة

40
00:02:15,860 --> 00:02:17,860
ما رأيك أن تنضمّ إلينا رسمياً؟

41
00:02:17,860 --> 00:02:18,950
!أنت مجنون

42
00:02:19,360 --> 00:02:20,790
حسناً

43
00:02:20,790 --> 00:02:22,910
سأعطيك الـ6 مليون خاصّتك، لِذا أعطِني هذا الدليل

44
00:02:27,800 --> 00:02:29,290
انتظري ريثما يصِلُ الآخرون إلى هنا

45
00:02:30,290 --> 00:02:31,350
!اتركوني

46
00:02:31,350 --> 00:02:32,730
خذوا الهاتف

47
00:02:34,210 --> 00:02:37,670
سأعلّمُك ماذا يحدثُ عندما تعترضُ طريقي

48
00:02:47,220 --> 00:02:48,280
!إنَّه لي

49
00:02:53,210 --> 00:02:54,320
واكاتاكي

50
00:02:54,800 --> 00:02:57,780
أستطيعُ أن أكون حارس مرمى جيّد

51
00:02:57,780 --> 00:02:59,670
أحسنتَ الإمساك

52
00:02:59,670 --> 00:03:00,990
...طمأنتَني

53
00:03:01,070 --> 00:03:03,700
أنتَ من فريق ك.زد لكرةِ القدم

54
00:03:04,700 --> 00:03:06,010
أونوزكا-سان

55
00:03:06,010 --> 00:03:09,300
أم أناديك الشبح أكس؟

56
00:03:09,300 --> 00:03:11,670
يبدو أنّك لا تزالُ سيّئاً

57
00:03:13,260 --> 00:03:15,210
!أمسِكوا به، خذوا منه الهاتف

58
00:03:22,090 --> 00:03:23,080
!سوناهارا

59
00:03:32,210 --> 00:03:33,440
!ابتعدا

60
00:03:38,940 --> 00:03:40,740
تأخّرت الشرطة

61
00:03:41,240 --> 00:03:42,150
الشرطة...؟

62
00:03:44,890 --> 00:03:47,780
كوزوكا-كن، اتّصِل بهاتف واكاتاكي الخليوي

63
00:03:47,780 --> 00:03:48,740
لماذا؟

64
00:03:49,410 --> 00:03:50,370
!من فضلك

65
00:03:50,870 --> 00:03:51,710
حسناً

66
00:03:59,100 --> 00:04:00,390
نغمة هاتفه

67
00:04:00,390 --> 00:04:01,620
أحسنتِ يا أيا

68
00:04:02,590 --> 00:04:03,380
!هيّا بنا

69
00:04:04,500 --> 00:04:06,640
الحقوا به، الصافِرة مزيّفة

70
00:04:18,900 --> 00:04:20,120
!استسلِموا

71
00:04:22,790 --> 00:04:24,070
سوناهارا

72
00:04:26,940 --> 00:04:29,640
سأسلِّمُ هذا الدليل للشرطة

73
00:04:36,920 --> 00:04:40,950
اعتُقِلَ الشبح أكس، أونوزكا، مع الجانحين

74
00:04:40,950 --> 00:04:43,960
كانوا يخطِّطون لعمليةِ سطو على بنك

75
00:04:43,960 --> 00:04:46,640
تمكنّا من إيقافِها قبلَ وقوعها

76
00:04:48,320 --> 00:04:50,660
،استجوِبَ سوناهارا

77
00:04:50,660 --> 00:04:53,640
،لكن عندما علِموا أنّه لم يتورّط في أي جريمة

78
00:04:53,640 --> 00:04:55,560
لم تتم إدانته

79
00:04:56,250 --> 00:05:00,600
تبّاً! لم يحظَ الفريق ك.زد بأي شهرة مجدّداً

80
00:05:00,600 --> 00:05:03,030
منَعْنا وقوع جريمة، هذا كافٍ بحدِّ ذاته

81
00:05:03,360 --> 00:05:05,530
وحمينا البلدة

82
00:05:05,530 --> 00:05:07,860
وأخرجنا صديقاً من مأزِق

83
00:05:07,860 --> 00:05:08,990
صديق؟

84
00:05:11,290 --> 00:05:12,410
معك حقّ

85
00:05:16,050 --> 00:05:19,810
لنستدعِ سوناهارا إلى اجتماعِ فريق ك.زد المُقبِل

86
00:05:19,810 --> 00:05:22,030
أنا متأكِّدة أننا سنكون فريقاً رائعاً

87
00:05:22,030 --> 00:05:22,640
إلى اللِّقاء

88
00:05:22,640 --> 00:05:23,590
وداعاً

89
00:05:30,110 --> 00:05:31,220
ألو؟

90
00:05:31,220 --> 00:05:33,230
هذا أنا، سوناهارا

91
00:05:34,830 --> 00:05:36,620
صديقتها؟

92
00:05:36,620 --> 00:05:37,480
نعم

93
00:05:37,860 --> 00:05:39,740
النّجوم جميلة اللّيلة

94
00:05:40,210 --> 00:05:41,440
هل يمكنُكِ رؤيتها؟

95
00:05:41,760 --> 00:05:43,070
انتظر

96
00:05:45,510 --> 00:05:46,770
نعم

97
00:05:47,420 --> 00:05:49,030
إنّها جميلة

98
00:05:49,760 --> 00:05:55,490
تاتشيبانا، أكرهُ نفسي لأنني آذيتُكِ

99
00:05:55,490 --> 00:05:57,180
قلبي يُؤلمني كثيراً

100
00:05:57,180 --> 00:05:59,000
لا عليك يا سوناهارا

101
00:05:59,610 --> 00:06:03,140
لِمَ لا تحضر اجتماعَ فريق التحرِّي ك.زد المُقبِل؟

102
00:06:03,140 --> 00:06:04,790
سيُسَرُّ الجميعُ برؤيتك

103
00:06:05,360 --> 00:06:07,090
آسف، لا أستطيع

104
00:06:07,090 --> 00:06:11,560
قد أضطرّ لمُغادرة البلدة مجدّداً بعدما حدثَ كلّ شيء

105
00:06:13,380 --> 00:06:14,700
...تاتشيبانا

106
00:06:14,700 --> 00:06:16,900
يمكنُنا رؤية بعضنا الآخر مجدداً، صحيح؟

107
00:06:19,200 --> 00:06:20,770
يمكنُنا، صحيح؟

108
00:06:23,840 --> 00:06:24,820
نعم

109
00:06:24,820 --> 00:06:25,840
أعِدُكِ بذلك

110
00:06:33,110 --> 00:06:34,360
يبدو لذيذاً

111
00:06:34,360 --> 00:06:36,520
وضعت كثيراً من قشدة الحليب يا واكاتاكي

112
00:06:36,520 --> 00:06:37,730
من يأبه؟

113
00:06:37,730 --> 00:06:39,330
لا تحلِّيه كثيراً أرجوك

114
00:06:40,060 --> 00:06:43,790
قرّرنا أن نقيمَ حفلةَ عيد الحبّ سوية

115
00:06:44,380 --> 00:06:48,150
هل يمكنُنا اعتبار هذا الكيك شوكولاتة واحدة؟

116
00:06:48,150 --> 00:06:50,800
حصَلْنا على الكثير من الفتياتِ في المدرسة

117
00:06:50,800 --> 00:06:52,800
أريدُ الحصول على أكبر قدر مُمكِن

118
00:06:53,570 --> 00:06:57,120
أفضِّلُ الحصول على شوكولاتة من الفتاة التي أحبُّها حتّى لو كانَتْ واحدة

119
00:06:57,120 --> 00:06:59,310
ينبغي أن تتعلّمَ من كوزوكا يا واكاتاكي

120
00:07:04,630 --> 00:07:09,140
لم أتعرّفْ على أصدقاء في المدرسة أو مدرسة الدورات المكثَّفة من قبل

121
00:07:09,140 --> 00:07:12,830
إلى أن التقيتُ بهؤلاء الفتيان وأصبح لديّ مكاناً رائعاً الآن

122
00:07:14,150 --> 00:07:15,120
أيا

123
00:07:15,630 --> 00:07:16,760
ما الأمر؟

124
00:07:16,760 --> 00:07:18,080
ما الخطب يا أيا؟

125
00:07:18,660 --> 00:07:19,600
أيا

126
00:07:27,520 --> 00:07:28,960
لذيذ