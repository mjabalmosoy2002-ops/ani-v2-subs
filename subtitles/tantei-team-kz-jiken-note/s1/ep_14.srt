1
00:00:02,810 --> 00:00:05,670
!مذكّرات فريق التحرِّي ك.زد

2
00:00:07,200 --> 00:00:08,530
اسمي تاتشيبانا أيا

3
00:00:09,140 --> 00:00:16,000
لم أتخيّل أبداً أن يغيِّرَ لِقائي بأربعة فتيان
غريبي الأطوار حياتي إلى هذا الحدّ الكبير

4
00:00:12,510 --> 00:00:15,980
مذكّرات قضيّة فريق التحرِّي ك.زد

5
00:00:17,740 --> 00:00:23,530
سأروي لكم قصّة القضايا المُثيرة التي نحلُّها
نحن، فريق التحرِّي ك.زد

6
00:00:25,710 --> 00:00:27,500
،مع اقتراب عيد الحبّ

7
00:00:27,500 --> 00:00:30,770
لا نفكِّرُ نحنُ الفتيات سِوى بالشوكولاتة

8
00:00:30,770 --> 00:00:33,080
،لكن جاءت مجموعة من الجانِحين لتُفسِد الأجواء

9
00:00:33,080 --> 00:00:36,240
عندما هاجمَتْنا ونحنُ في طريقِنا
من المدرسة إلى المنزل

10
00:00:36,240 --> 00:00:38,840
...تمكنّا من الهرب، لكن

11
00:00:40,010 --> 00:00:42,890
كان سوناهارا من بين الجانحين

12
00:00:44,270 --> 00:00:46,120
"عيد الحبّ يعلم"

13
00:00:46,120 --> 00:00:47,020
"الجزء 2"

14
00:00:49,840 --> 00:00:52,530
ما الذي يفعله سوناهارا بالضبط؟

15
00:00:55,830 --> 00:00:57,660
أنا متأكِّد أن لديه أسبابه

16
00:00:57,660 --> 00:00:59,360
يجدرُ بنا أن نستمعَ إليه

17
00:00:59,360 --> 00:01:02,160
وعلينا أن نقنعه بمغادرة المجموعة

18
00:01:03,090 --> 00:01:03,950
حسناً

19
00:01:05,190 --> 00:01:08,620
لسنا الضحايا الوحيدين لأولئك الجانحين

20
00:01:08,620 --> 00:01:10,420
تأذّى آخرون بواسطتهم

21
00:01:10,970 --> 00:01:12,940
أيا، دوِّني ذلك في سجلَّات القضية

22
00:01:13,300 --> 00:01:17,430
هدفنا هو إنقاذُ سوناهارا وهزيمة مجموعة الجانحين

23
00:01:18,150 --> 00:01:19,430
حسناً

24
00:01:21,030 --> 00:01:22,740
أويسوغي وكوزوكا، عليكما بالبحث

25
00:01:22,740 --> 00:01:24,930
عن معلومات حول الحوادِث التي سبّبوها

26
00:01:24,930 --> 00:01:28,440
بينما سنتقصّى أنا وكوروكي عن الأشخاص في المجموعة

27
00:01:29,840 --> 00:01:30,940
أمّا أيا

28
00:01:32,570 --> 00:01:35,940
عليها بالتواصُل من سوناهارا واستخراج بعض المعلومات منه

29
00:01:36,780 --> 00:01:38,740
هل أنت متأكّد من سلامة ذلك؟

30
00:01:38,740 --> 00:01:41,950
معه حقّ، قد يكون سوناهارا جانحاً حقيقياً الآن

31
00:01:42,460 --> 00:01:44,700
ماذا لو أصابَ أيا مكروه؟

32
00:01:45,070 --> 00:01:46,750
ستكونُ أيا بخير

33
00:01:46,750 --> 00:01:47,760
كيف؟

34
00:01:48,340 --> 00:01:49,920
!الشوكولاتة

35
00:01:49,920 --> 00:01:52,070
أعطِ أي شابّ شوكولاتة في عيد الحبّ

36
00:01:52,070 --> 00:01:55,550
فلن يؤذيك حتّى لو كان جانحاً

37
00:01:55,550 --> 00:01:58,050
هل الفتيان بهذه البساطة حقاً؟

38
00:01:58,600 --> 00:02:00,380
بمقدوركِ الاستحواذ عليّ بشكلٍ فوري

39
00:02:00,810 --> 00:02:02,550
صحيح، قد أكون كذلك أيضاً

40
00:02:03,010 --> 00:02:04,260
وأنا كذلك

41
00:02:05,450 --> 00:02:06,170
أرأيتِ؟

42
00:02:06,170 --> 00:02:09,700
انتهزي هذه الفُرصة لتتعلّمي أكبر قدر
مُمكن من المعلومات منه

43
00:02:10,410 --> 00:02:11,830
حسناً، عُلِم

44
00:02:11,830 --> 00:02:12,690
سأحاول

45
00:02:13,350 --> 00:02:17,610
ناهيكم عن أنني لا أمانع تقديم
الشوكولاتة لسوناهارا

46
00:02:20,770 --> 00:02:22,190
حقاً؟

47
00:02:22,190 --> 00:02:25,370
مع أنّكِ قلتِ أنكِ لا تعطينني شوكولاتة

48
00:02:25,940 --> 00:02:27,650
حـ-حسناً

49
00:02:27,650 --> 00:02:30,270
سأعطيكِ رقمَ هاتف سوناهارا إذاً

50
00:02:30,860 --> 00:02:34,230
لا مُشكلة، فقد حصلتُ على رقمِ هاتفه

51
00:02:34,810 --> 00:02:37,880
ما الذي يجري بينكما؟

52
00:02:38,390 --> 00:02:39,840
آملُ أن تعجبه

53
00:02:39,840 --> 00:02:40,840
سيكونُ الأمرُ على ما يُرام

54
00:02:42,750 --> 00:02:44,300
تبدو هذه لذيذة

55
00:02:44,600 --> 00:02:48,380
ثمانون بالمئة من شوكولاتة الكاكاو مع مِطرقة صغيرة

56
00:02:48,380 --> 00:02:50,890
إنها رائعة وتُلائمُ سوناهارا

57
00:02:51,310 --> 00:02:52,540
المعذرة

58
00:02:52,540 --> 00:02:53,180
نعم؟

59
00:02:53,180 --> 00:02:54,400
أريدُ واحدة من تِلك

60
00:02:54,400 --> 00:02:56,440
شكراً لكِ

61
00:02:56,440 --> 00:02:59,570
أظنُّ أنها ستحوزُ على إعجابِ سوناهارا

62
00:03:01,800 --> 00:03:05,710
فكّرتُ ملياً بما يجدرُ بي كتابته في البطاقة

63
00:03:06,060 --> 00:03:11,080
عبّرتُ عن مشاعري بأحسن طريقة مُمكِنة
واضِعة سوناهارا في ذهني

64
00:03:14,490 --> 00:03:15,340
حسناً

65
00:03:19,530 --> 00:03:20,280
نعم؟

66
00:03:21,920 --> 00:03:22,690
من المتّصِل؟

67
00:03:23,770 --> 00:03:24,600
من؟

68
00:03:25,840 --> 00:03:27,600
أنا تاتشيبانا

69
00:03:29,470 --> 00:03:31,320
سمعتُ أنّك عدت

70
00:03:31,650 --> 00:03:32,900
كيف حالُك؟

71
00:03:32,900 --> 00:03:34,100
لم أرك منذُ مدّة

72
00:03:35,640 --> 00:03:40,980
أردتُ أن أعطيك الشوكولاتة في عيد الحبّ

73
00:03:40,980 --> 00:03:41,740
...أنا

74
00:03:43,690 --> 00:03:48,910
انقطعَتْ أنفاسي لوهلة عندما سمعتُ اسمكِ

75
00:03:50,150 --> 00:03:54,030
،ومن ثمّ ذكرتِ عيدَ الحبّ

76
00:03:54,030 --> 00:03:56,270
فانقطعَتْ أنفاسي كلّياً

77
00:03:58,890 --> 00:04:01,170
هل تستوعبين هذه السعادة؟

78
00:04:04,100 --> 00:04:05,000
...لكن

79
00:04:06,030 --> 00:04:06,800
آسف...

80
00:04:06,800 --> 00:04:09,770
أنا سعيد للغاية، لكن لا أستطيع

81
00:04:11,410 --> 00:04:13,720
لا يجدر بكِ أن تقتربي منِّي

82
00:04:13,720 --> 00:04:14,770
فهذا خطير

83
00:04:15,440 --> 00:04:19,150
هذا مؤسف، لكن يجدرُ بكِ أن تعطي
الشوكولاتة لشخص آخر

84
00:04:19,590 --> 00:04:20,280
إلى اللقاء

85
00:04:29,700 --> 00:04:31,250
...بعد بضعة أيّام

86
00:04:31,730 --> 00:04:32,770
آسف لتأخُّري

87
00:04:37,570 --> 00:04:39,750
تبدو متحمِّساً للغاية يا كوروكي

88
00:04:41,250 --> 00:04:42,620
سألعبُ دورَ عميل سرّي

89
00:04:42,620 --> 00:04:45,770
لا يمكن أن أحقّقَ بشكل عفوي

90
00:04:45,770 --> 00:04:47,340
أنا متأكّدٌ تماماً أنّك تريدُ التأنُّق فحسب

91
00:04:48,660 --> 00:04:50,640
حسناً، أبلغ تقريرك

92
00:04:51,310 --> 00:04:53,310
لنستمع إلى ما لدى كوروكي-سينسي

93
00:04:54,060 --> 00:04:56,560
إنهم مجموعة جديدة من الجانحين

94
00:04:56,560 --> 00:04:59,320
تعمل على الابتزازِ والسرقة وحتّى اختراق البنوك

95
00:04:59,830 --> 00:05:02,730
تبّاً! أرى أن الأمر يتوسّعُ كثيراً

96
00:05:02,730 --> 00:05:05,870
لكن لا تمتلك المجموعة قائداً بحدّ ذاته

97
00:05:06,410 --> 00:05:08,320
كيف ينظِّمون أنفسهم إذاً؟

98
00:05:09,010 --> 00:05:10,930
بيدَ أن لديهم قائد غامض

99
00:05:10,930 --> 00:05:12,830
اسمه الطّيف أكس

100
00:05:14,050 --> 00:05:15,580
الطّيف أكس؟

101
00:05:16,040 --> 00:05:18,840
يصدرُ الطّيف أكس الأوامر هاتفياً

102
00:05:18,840 --> 00:05:21,060
ولا يستطيع إلّا بضعة أعضاء مُنتقاة اللِّقاء به

103
00:05:21,060 --> 00:05:24,230
سيستغرقُ اكتشاف هويّة الطّيف أكس وقتاً

104
00:05:25,340 --> 00:05:26,420
شكراً لك

105
00:05:26,420 --> 00:05:27,840
هذا هو بطلُنا كوروكي

106
00:05:28,260 --> 00:05:29,600
واظِب على ذلك

107
00:05:30,580 --> 00:05:32,150
ماذا عنكِ يا أيا؟

108
00:05:32,150 --> 00:05:33,850
هل تواصلتِ مع سوناهارا؟

109
00:05:35,050 --> 00:05:36,350
نعم

110
00:05:36,800 --> 00:05:37,710
وماذا حدث؟

111
00:05:38,410 --> 00:05:40,610
قال أنه مُمتنّ على الشوكولاتة

112
00:05:40,610 --> 00:05:41,820
!جيّد إذاً

113
00:05:41,820 --> 00:05:43,730
لكنّه رفضَني على أي حال

114
00:05:44,300 --> 00:05:45,110
ماذا تقصدين؟

115
00:05:45,650 --> 00:05:47,390
قال أنه كان سعيداً لكن لا يستطيعُ رؤيتي

116
00:05:48,380 --> 00:05:49,520
لِمَ لا؟

117
00:05:49,520 --> 00:05:51,860
وطلبَ منّي الابتعاد نظراً لخطورةِ الأمر

118
00:05:52,270 --> 00:05:53,450
خطورة؟

119
00:05:53,450 --> 00:05:55,660
يبدو أنه سيجري شيء ما

120
00:05:56,010 --> 00:05:58,010
إنه لا يعيش مع والديه حالياً

121
00:05:58,010 --> 00:05:59,920
بل يعيشُ مع بعض من الأقارب البعيدين

122
00:05:59,920 --> 00:06:01,710
أنا متأكّدٌ أنه يُعاني من أمور كثيرة

123
00:06:02,100 --> 00:06:05,130
أعتقدُ أن شركة أقربائه تُدعى متعهّدي أويهارا للدهانات

124
00:06:07,090 --> 00:06:08,340
هكذا إذاً

125
00:06:11,670 --> 00:06:14,010
ما الذي يمكنني فعله الآن؟

126
00:06:21,620 --> 00:06:24,410
أظنُّني سأقدِّمُ الشوكولاتة لسوناهارا

127
00:06:24,410 --> 00:06:26,380
سأفعلُ ما يمكنني فعله

128
00:06:28,270 --> 00:06:29,470
ها هي ذي

129
00:06:29,470 --> 00:06:30,660
حسناً

130
00:06:32,820 --> 00:06:34,050
...لِذا

131
00:06:34,880 --> 00:06:36,160
ما خطبكِ؟

132
00:06:40,780 --> 00:06:42,300
قلتُ لكِ لا تأتين إلى هنا

133
00:06:42,700 --> 00:06:46,550
سوناهارا

134
00:06:46,960 --> 00:06:49,170
ما الأمر؟ شجار؟

135
00:06:50,260 --> 00:06:51,180
لا شيء

136
00:06:53,350 --> 00:06:56,900
هل هذه شوكولاتة عيد الحبّ؟

137
00:06:56,900 --> 00:06:58,450
هل هي لسوناهارا؟

138
00:06:59,760 --> 00:07:01,670
قلتُ لكِ لن آخذها

139
00:07:02,160 --> 00:07:03,310
عودي بها إلى المنزل

140
00:07:03,700 --> 00:07:06,620
مهلاً يا سوناهارا، لا تكُن قاسياً

141
00:07:06,620 --> 00:07:08,550
سآخذها أنا إذاً

142
00:07:09,330 --> 00:07:11,870
فأنا شابٌّ لطيف

143
00:07:13,490 --> 00:07:15,200
أعدْها يا أونوزكا

144
00:07:16,860 --> 00:07:19,710
قُلْ أونوزكا-سان يا سوناهارا

145
00:07:22,210 --> 00:07:23,710
!غادري فحسب