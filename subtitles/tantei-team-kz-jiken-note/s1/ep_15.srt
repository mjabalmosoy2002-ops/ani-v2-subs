1
00:00:02,810 --> 00:00:05,670
!مذكّرات فريق التحرِّي ك.زد

2
00:00:07,200 --> 00:00:08,530
اسمي تاتشيبانا أيا

3
00:00:09,140 --> 00:00:16,000
لم أتخيّل أبداً أن يغيِّرَ لِقائي بأربعة فتيان
غريبي الأطوار حياتي إلى هذا الحدّ الكبير

4
00:00:12,510 --> 00:00:15,980
مذكّرات قضيّة فريق التحرِّي ك.زد

5
00:00:17,740 --> 00:00:23,530
سأروي لكم قصّة القضايا المُثيرة التي نحلُّها
نحن، فريق التحرِّي ك.زد

6
00:00:25,660 --> 00:00:27,880
،بقي يوم واحد على عيدِ الحبّ

7
00:00:27,880 --> 00:00:31,730
تعرّضَ فريقُنا ك.زد لهجوم بواسطة مجموعة من الجانحين

8
00:00:31,730 --> 00:00:32,860
...لكن

9
00:00:33,220 --> 00:00:35,510
كان سوناهارا من بين الجانحين

10
00:00:36,280 --> 00:00:39,760
كان سوناهارا زميلي في الصفّ قبل
أن ينتقلَ إلى مدرسة أخرى

11
00:00:39,760 --> 00:00:45,730
رحتُ لأقدّم إليه الشوكولاتة لجمعِ المعلومات عن العصابة

12
00:00:45,730 --> 00:00:47,390
سآخذُ هذه

13
00:00:48,250 --> 00:00:49,440
!غادري فحسب

14
00:00:52,290 --> 00:00:54,200
"عيد الحبّ يعلم"

15
00:00:54,200 --> 00:00:55,240
"الجزء 3"

16
00:00:57,350 --> 00:00:59,770
،أغضبتُ سوناهارا

17
00:00:59,770 --> 00:01:02,760
ولم أستطِع أن أكون مُفيدة لفريق التحرِّي ك.زد

18
00:01:02,760 --> 00:01:05,120
أليسَتْ هذه بِطاقة عيد حبّ؟

19
00:01:05,120 --> 00:01:06,680
لا بدّ وأنها سقطَتْ من أحد

20
00:01:07,720 --> 00:01:08,840
حقاً؟

21
00:01:08,840 --> 00:01:09,920
رائع

22
00:01:11,650 --> 00:01:15,920
تِلك هي البطاقة التي كتبتُها لسوناهارا

23
00:01:16,510 --> 00:01:19,970
عزيزي سوناهارا-كون، أريدُ أن أؤمن بك"

24
00:01:19,970 --> 00:01:23,560
لديك المقوِّمات الكافية لإيجادِ السعادة

25
00:01:23,560 --> 00:01:25,640
أقدِّمُ إليك هذه الشوكولاتة بملء مشاعري

26
00:01:25,640 --> 00:01:29,970
"لا تنسَ أنني أشجِّعُك دوماً، لا تستسلم

27
00:01:29,970 --> 00:01:32,390
هذا اعتراف صريح

28
00:01:32,390 --> 00:01:35,610
أتعرفُ من وضعَها؟ إنه سوناهارا بنفسِه

29
00:01:35,610 --> 00:01:37,160
هل أنت جادّ؟

30
00:01:42,310 --> 00:01:43,950
هل أنتِ مريضة؟

31
00:01:52,000 --> 00:01:53,530
يبدو أن هذا هو السبب

32
00:01:54,060 --> 00:01:55,090
أنتِ من كتبَها

33
00:01:55,480 --> 00:01:57,320
بطاقة عيد حبّ؟

34
00:01:57,320 --> 00:02:00,050
أيا، هل ذهبتِ لتقديمِ الشوكولاتة إلى سوناهارا؟

35
00:02:02,450 --> 00:02:04,830
قلتِ أنه رفضكِ

36
00:02:04,830 --> 00:02:08,020
أردتُ أن أساعده

37
00:02:08,020 --> 00:02:10,770
"وأردتُ أن أجعل من نفسي مُفيدة لـ"ك.زد

38
00:02:11,360 --> 00:02:13,190
كيف وصلَت البطاقة إلى هناك؟

39
00:02:13,720 --> 00:02:17,030
أحدهم رأى سوناهارا وهو يضعُها

40
00:02:17,850 --> 00:02:19,490
ولماذا يفعلُ شيئاً كهذا؟

41
00:02:19,740 --> 00:02:21,370
عيد الحبّ هو أشبه بمُنافَسة على جمع الشوكولاتة بين الشباب

42
00:02:21,370 --> 00:02:23,560
يُفترَضُ أن تملأك السعادة عندما تحصلُ على شوكولاتة

43
00:02:24,020 --> 00:02:28,660
لا يمكِن أن يفعل الشابُّ شيئاً فظيعاً
بفتاة أعطَتْه الشوكولاتة

44
00:02:29,160 --> 00:02:30,100
...لكن

45
00:02:30,100 --> 00:02:34,630
إن كان سوناهارا هو من وضعَها هكذا فلا بدّ
من وجود سبب وجيه وراء ذلك

46
00:02:35,020 --> 00:02:36,320
سبب؟

47
00:02:38,050 --> 00:02:43,050
حتّى لو كان لديه سبب، لن ندعَه يفلتُ بفعلتِه هذه

48
00:02:43,550 --> 00:02:44,730
بالطبع لا

49
00:02:44,730 --> 00:02:49,020
سنبحثُ في كلّ صغيرة وكبيرة عن سوناهارا وتِلك العصابة

50
00:02:50,210 --> 00:02:52,450
هل يمكنني استعارة هذه؟

51
00:02:52,450 --> 00:02:54,520
فقد أتوصّل إلى شيء من خلالها

52
00:02:59,490 --> 00:03:00,930
ما الذي تنوون فعله؟

53
00:03:00,930 --> 00:03:01,850
ستتأخّرون

54
00:03:01,850 --> 00:03:02,570
!تبّاً

55
00:03:02,570 --> 00:03:04,370
أيا، هل أنتِ بخير؟

56
00:03:04,370 --> 00:03:06,190
نعم، شكراً

57
00:03:06,190 --> 00:03:07,830
لنُسرِع، سنتأخّر

58
00:03:09,130 --> 00:03:11,170
ما حدثَ بخصوصِ البطاقة كانَ صدمة

59
00:03:11,170 --> 00:03:13,750
لكن لديّ ك.زد... أصدقائي

60
00:03:14,580 --> 00:03:16,840
لستُ وحيدة

61
00:03:18,250 --> 00:03:21,960
في يوم السبت المُقبِل، اجتمعنا في منزلِ واكاتاكي

62
00:03:22,550 --> 00:03:23,540
أيا

63
00:03:23,960 --> 00:03:25,210
أين كوزوكا-كون؟

64
00:03:25,210 --> 00:03:26,040
لم يأتوا بعد

65
00:03:28,430 --> 00:03:29,580
هذه نغمةُ هاتفي

66
00:03:29,980 --> 00:03:31,100
مرحباً، واكاتاكي يتكلّم

67
00:03:31,100 --> 00:03:31,810
نعم

68
00:03:32,380 --> 00:03:33,680
!لقد أخافَني ذلك

69
00:03:33,680 --> 00:03:35,870
صدرَ صوتُ الصافِرة فجأة

70
00:03:35,870 --> 00:03:39,150
إنَّ واكاتاكي شخص مُتفاخِر، حتّى عندما
يتعلّقُ الأمرُ بنغمةِ جهازه

71
00:03:40,510 --> 00:03:42,200
سيتأخّرُ كوزوكا قليلاً

72
00:03:42,200 --> 00:03:43,300
لنبدأ من دونه

73
00:03:43,300 --> 00:03:45,360
سأسردُ تقريري أولاً إذاً

74
00:03:45,360 --> 00:03:46,540
أيا، السجلّ من فضلكِ

75
00:03:47,560 --> 00:03:49,590
لديّ بعض المعلومات المُقلِقة

76
00:03:50,500 --> 00:03:54,080
يبدو أنَّ الطيف أكس يخطِّطُ لأمر كبير

77
00:03:54,340 --> 00:03:56,450
أمر كبير؟ ما الذي يخطِّطُ له؟

78
00:03:56,450 --> 00:03:57,260
لا أحد يدري

79
00:03:57,260 --> 00:04:00,430
لكن تفيدُ الإشاعة إلى أنّهم يشكِّلون
فرقة من النّخبة

80
00:04:00,430 --> 00:04:03,140
فريق مُختار بعناية داخل عصابة الجانحين؟

81
00:04:03,700 --> 00:04:04,630
نعم

82
00:04:04,630 --> 00:04:08,500
وحتّى أنَّ هُنالِك اختبارات تُقام لمعرِفة
ولاء الشخص للطيف أكس

83
00:04:08,500 --> 00:04:11,720
على سبيلِ المثال، الالتفاف حول المحطّة
بمؤخِّرة عارية

84
00:04:12,950 --> 00:04:17,440
بما أنَّ الطيف أكس يُعِدُّ اختبارات
فهذا يعني أنّه شخص حذِر جداً

85
00:04:17,800 --> 00:04:20,360
أيا، قلتِ أن سوناهارا كانَ برفقةِ بعض الجانحين

86
00:04:20,360 --> 00:04:22,320
عندما رحتِ لتقديمِ الشوكولاتة إليه

87
00:04:22,320 --> 00:04:23,700
هل لاحظتِ أي شيء؟

88
00:04:23,700 --> 00:04:25,110
أعدها يا أونوزكا

89
00:04:25,110 --> 00:04:28,030
قُلْ أونوزكا-سان يا سوناهارا

90
00:04:28,030 --> 00:04:32,040
"سوناهارا نادى الرجلَ الذي كان معه بـ"أونوزكا

91
00:04:32,380 --> 00:04:33,500
أونوزكا؟

92
00:04:33,500 --> 00:04:34,770
هل كان في العشرين من عمره تقريباً؟

93
00:04:34,770 --> 00:04:35,670
قويّ البنية؟

94
00:04:35,970 --> 00:04:37,280
أ-أجل

95
00:04:37,280 --> 00:04:38,190
إنه هو

96
00:04:38,190 --> 00:04:38,630
نعم

97
00:04:39,000 --> 00:04:40,820
لاعب سابِق في فريق ك.زد لكرة القدم

98
00:04:41,350 --> 00:04:42,090
ماذا؟

99
00:04:42,360 --> 00:04:44,200
كان ذا سمعة سيّئة

100
00:04:44,200 --> 00:04:46,000
ويلعبُ كرةَ القدم بأسلوبٍ رخيص

101
00:04:46,000 --> 00:04:47,510
كان فريقُه يكرهه

102
00:04:47,510 --> 00:04:50,720
وقد طُرِدَ من الفريقِ في نهاية المطاف

103
00:04:50,720 --> 00:04:53,310
هل الطّيف أكس هو أونوزكا إذاً؟

104
00:04:53,310 --> 00:04:54,730
...لسنا متأكِّدين من ذلك، لكن

105
00:04:54,730 --> 00:04:56,310
لا عجب في أن يكون هو

106
00:04:58,530 --> 00:04:59,540
آسف لتأخُّري

107
00:04:59,540 --> 00:05:00,730
كشفتُها

108
00:05:01,380 --> 00:05:04,820
عثرتُ على لُعابٍ في هذا القسم المُمزَّق

109
00:05:05,830 --> 00:05:09,080
كان اسمكِ مكتوباً عليها، أليس كذلك؟

110
00:05:09,080 --> 00:05:09,950
نعم

111
00:05:09,950 --> 00:05:13,730
والأجزاء الأخرى من الرّسالة قد اختلطَتْ
بها بصمات عديدة من الأصابِع

112
00:05:14,160 --> 00:05:15,910
،هذه نظريّتي فحسب

113
00:05:15,910 --> 00:05:19,220
لكن لا بدَّ وأن البِطاقة انتقلَتْ من يد
إلى أخرى بشكلٍ فوضويّ

114
00:05:19,840 --> 00:05:22,670
وربّما يكون سوناهارا مزّقَها بفمِه في خِضَمِّ ذلك

115
00:05:24,350 --> 00:05:25,540
مزّقها؟

116
00:05:25,540 --> 00:05:26,790
ولماذا يفعلُ ذلك؟

117
00:05:26,790 --> 00:05:31,170
يبدو أنَّ ذلك قد حدثَ في المحطّة كجزء من اختبار الطيف أكس

118
00:05:32,140 --> 00:05:35,360
فعلَ سوناهارا ما كان عليه أن يفعل لاجتيازِ الاختبار

119
00:05:35,710 --> 00:05:39,550
لكنّه مزّقَها بفمِه ليُخفي اسمكِ

120
00:05:39,950 --> 00:05:42,020
أحسنت يا سوناهارا

121
00:05:42,390 --> 00:05:45,730
ولماذا يفعلُ كلّ هذا للنجاحِ في الاختبار؟

122
00:05:45,730 --> 00:05:50,220
لا أدري ما إن كان هذا هو السبب، لكن
...الأقرباء الذي يُرافقُهم سوناهارا

123
00:05:50,220 --> 00:05:52,030
متعهِّدو أويهارا للدهانات؟

124
00:05:52,630 --> 00:05:54,490
يبدو أنّهم غارقون في الديون

125
00:05:54,490 --> 00:05:56,190
سمعتُ أنّهم تعرّضوا لعملية احتيال

126
00:05:59,920 --> 00:06:02,220
يجدرُ بي أن أتكلّمَ مع سوناهارا بطريقة لائقة

127
00:06:02,220 --> 00:06:04,380
قد أكون قادِرة على مُساعدته

128
00:06:06,960 --> 00:06:07,970
ألو؟

129
00:06:07,970 --> 00:06:09,560
أنا سوناهارا

130
00:06:11,240 --> 00:06:13,640
هل رأيت المحطّة؟

131
00:06:14,340 --> 00:06:15,430
نعم

132
00:06:16,140 --> 00:06:17,270
آسف

133
00:06:17,270 --> 00:06:19,730
أنا في ورطة حقيقيّة الآن

134
00:06:20,480 --> 00:06:22,520
لذا لا أستطيعُ حمايتكِ

135
00:06:23,320 --> 00:06:25,550
لكن كنتُ سعيداً حقّاً

136
00:06:25,920 --> 00:06:27,600
بالشوكولاتة والبطاقة

137
00:06:27,600 --> 00:06:29,490
أنتِ جادّة، أليس كذلك؟

138
00:06:29,730 --> 00:06:32,070
تروقينني كثيراً

139
00:06:32,930 --> 00:06:35,870
لدرجة أنني أشعرُ بالإحراج

140
00:06:36,780 --> 00:06:38,520
سُعِدتُ برؤيتكِ

141
00:06:38,960 --> 00:06:39,930
...لكن

142
00:06:41,020 --> 00:06:43,360
لن نتمكّنَ من رؤيةِ بعضنا الآخر بعد الآن...

143
00:06:43,830 --> 00:06:44,880
وداعاً

144
00:06:47,110 --> 00:06:48,400
وداعاً

145
00:06:52,140 --> 00:06:54,280
ألو؟ سوناهارا؟

146
00:06:54,840 --> 00:06:56,310
هذا أنا، أويسوغي

147
00:06:56,990 --> 00:06:57,890
أويسوغي-كون

148
00:06:58,490 --> 00:07:00,290
حصلتُ على بعض المعلومات من أويسوغي

149
00:07:00,290 --> 00:07:03,310
ستجتمعُ العصابة في الحديقة في الحي-10

150
00:07:04,120 --> 00:07:07,280
قال سوناهارا "وداعاً" لي للتو

151
00:07:07,280 --> 00:07:09,800
إنه بمثابة النداء الأخير

152
00:07:09,800 --> 00:07:13,620
سوناهارا على وشك أن يبدأ بشيء لا يستطيعُ الرجوع عنه

153
00:07:13,980 --> 00:07:16,660
هل هو "الشيء الكبير" الذي كنّا نتحدّثُ عنه؟

154
00:07:16,660 --> 00:07:17,840
مُمكِن

155
00:07:17,840 --> 00:07:19,510
سنتفقّدُ ذلك

156
00:07:19,510 --> 00:07:20,740
أغلقي السمّاعة الآن

157
00:07:20,740 --> 00:07:21,990
سأتّصِلُ بكِ لاحقاً

158
00:07:24,250 --> 00:07:25,000
وداعاً

159
00:07:26,090 --> 00:07:27,070
سوناهارا