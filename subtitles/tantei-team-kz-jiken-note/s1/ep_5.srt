1
00:00:02,810 --> 00:00:05,670
مذكّرات فريق التحرِّي ك‏.‏زد

2
00:00:07,200 --> 00:00:08,530
اسمي تاتشيبانا أيا

3
00:00:09,140 --> 00:00:16,000
لم أتخيّل أبداً أن يغيِّرَ لِقائي بأربعة فتيان
غريبي الأطوار حياتي إلى هذا الحدّ الكبير

4
00:00:12,510 --> 00:00:15,980
مذكّرات قضيّة فريق التحرِّي ك‏.‏زد

5
00:00:17,920 --> 00:00:23,530
سأروي لكم قصّة القضايا المُثيرة التي نحلُّها
نحن‏،‏ فريق التحرِّي ك‏.‏زد

6
00:00:25,530 --> 00:00:28,450
لا أصدِّق أن حادِثة سرقة درّاجة
واكاتاكي الهوائيّة

7
00:00:28,450 --> 00:00:31,510
كانت ستؤدِّي إلى اعتقال لصّ متجر

8
00:00:31,510 --> 00:00:32,950
!يا لها من صدمة

9
00:00:33,380 --> 00:00:40,020
وبثِقة واكاتاكي المُكتسَبة حديثاً
شكَّلنا فريقَ التحرِّي ك.زد

10
00:00:43,880 --> 00:00:45,790
اقتربَتْ امتحانات المدرسة الإعدادية

11
00:00:45,790 --> 00:00:47,790
دراسة، دراسة، دراسة

12
00:00:48,710 --> 00:00:52,400
عُلِّقَتْ أعمال فريق التحرِّي ك.زد
بعد الافتتاح مُباشرة

13
00:00:52,740 --> 00:00:56,350
...وبعد العاصِفة والتي هي امتحانات المدرسة الإعدادية

14
00:00:57,310 --> 00:00:59,870
كوروكي-كون، أويسوغي-كون، وكوزوكا-كون

15
00:00:59,870 --> 00:01:03,610
أصبحوا مؤهَّلين لدخول المدارس النّخبة
الخاصّة التي كانوا يطمحون إليها

16
00:01:04,290 --> 00:01:09,640
بالكاد تمكّنتُ من الالتحاق بثالث مدرسة
في قائمة ترتيب خياراتي

17
00:01:10,680 --> 00:01:12,910
أتسألون عن واكاتاكي؟

18
00:01:12,910 --> 00:01:15,090
فشِلَ واكاتاكي

19
00:01:15,090 --> 00:01:18,930
رسبَ في كافّة المدارس الخاصّة
وانتهى المطافُ به بدخول مدرسة حكوميّة

20
00:01:19,210 --> 00:01:20,980
استطاعَ حقّاً بقدراته

21
00:01:20,980 --> 00:01:24,730
الدخول إلى نفس المدارس
التي راحَ كوروكي-كون والآخرون إليها

22
00:01:24,730 --> 00:01:28,580
لكن هذا فقط عندما يُبدِع، أما عندما
لا يُبدِع فهُنا يبرزُ الفرق

23
00:01:28,580 --> 00:01:30,270
واكاتاكي الموجة

24
00:01:30,270 --> 00:01:32,590
آمل ألّا يكون مكتئباً

25
00:01:34,060 --> 00:01:37,240
شريحة لحم الهامبرغر مع البيض تعلم الجزء 1

26
00:01:38,630 --> 00:01:41,280
لقد مضى بعض الوقت مُذ بدأنا
بالدوام في المدرسة الإعدادية

27
00:01:41,280 --> 00:01:44,660
لكنني لم أتواصل بعد مع شباب فريق التحرِّي

28
00:01:44,660 --> 00:01:47,250
قرّرتْ أمّي أنني لستُ مُضطرّة

29
00:01:47,250 --> 00:01:50,370
للذهاب إلى مدرسة الدورات المكثَّفة
حتّى تبدأ دروس الصيف

30
00:01:50,370 --> 00:01:52,530
لأن ذلك يكلِّفُ ثمناً باهظاً

31
00:01:53,020 --> 00:01:56,810
لا أحمل هاتفاً خلوياً، لهذا لا أستطيع
مُراسلتهم أيضاً

32
00:01:56,810 --> 00:01:58,930
ولأنني أتوتّرُ على الهاتف

33
00:01:59,650 --> 00:02:01,620
كيف حالهم يا تُرى؟

34
00:02:01,870 --> 00:02:04,770
أنا قلِقةٌ على واكاتاكي كذلك

35
00:02:05,080 --> 00:02:06,930
بسُرعة يا آيا

36
00:02:06,930 --> 00:02:09,350
ناكو ويوكي غادرا إلى المدرسة
منذُ مدّة طويلة

37
00:02:09,350 --> 00:02:10,750
حسناً

38
00:02:11,620 --> 00:02:14,190
تبّاً، أمِّي مزعجة جداً

39
00:02:15,450 --> 00:02:19,950
ولا يجوز أن أقلق على واكاتاكي طوال الوقت

40
00:02:21,300 --> 00:02:23,520
...حياتي في المدرسة الإعدادية

41
00:02:28,860 --> 00:02:29,920
صباح الخير

42
00:02:30,980 --> 00:02:35,050
حتّى في المدرسة الإعدادية، لم أنسجم مع الصفّ

43
00:02:35,430 --> 00:02:37,220
شعركِ جميل جداً يا ناهو

44
00:02:37,220 --> 00:02:38,800
رائحته زكية أيضاً

45
00:02:38,800 --> 00:02:40,050
حقاً؟

46
00:02:40,360 --> 00:02:42,770
أجرِّبُ شامبو جديد

47
00:02:42,770 --> 00:02:44,370
حقاً؟ ما هو؟

48
00:02:44,370 --> 00:02:45,260
أخبريني

49
00:02:46,680 --> 00:02:48,880
لا أستطيع مُسايَرة هذا النوع من الأشخاص

50
00:02:49,280 --> 00:02:51,260
ولا أريد حتّى

51
00:02:52,500 --> 00:02:54,230
هل وصلتُم إلى هذا الحدّ؟

52
00:02:54,230 --> 00:02:55,380
...حسناً، الآن

53
00:02:55,380 --> 00:02:57,920
افتحوا على الصفحة 17 في كتُبِكم

54
00:02:58,980 --> 00:03:01,820
لم يكن ذلك السبب الوحيد الذي يحبطُني

55
00:03:03,100 --> 00:03:06,700
سمعتُ أن هناك سوناهارا كاكيرو في صفِّكِ

56
00:03:06,890 --> 00:03:09,150
لا تتقرَّبي منه كثيراً

57
00:03:09,150 --> 00:03:10,220
لِمَ لا؟

58
00:03:10,530 --> 00:03:12,130
سمعتُ أنه جانح

59
00:03:12,130 --> 00:03:12,990
جانِح؟

60
00:03:12,990 --> 00:03:15,600
قيلَ أنه اعتُقِلَ سابقاً أيضاً

61
00:03:16,530 --> 00:03:20,750
هذا ما تقوله أمِّي، لكن سوناهارا يجلسُ
بجانبي مباشرة

62
00:03:21,800 --> 00:03:23,010
سوناهارا

63
00:03:24,550 --> 00:03:26,790
ممنوع النوم أثناء الدرس

64
00:03:29,310 --> 00:03:30,680
آسف

65
00:03:33,050 --> 00:03:35,270
عليّ أن أحاول ألَّا أتدخَّل

66
00:03:37,290 --> 00:03:40,210
سيطرأ تغيير لبرنامج المواعيد

67
00:03:40,210 --> 00:03:43,050
كي يتوفَّر الوقت للتطوير المِهَني

68
00:03:43,050 --> 00:03:44,730
لا أحد يسمعني

69
00:03:44,730 --> 00:03:45,600
مرحباً

70
00:03:45,950 --> 00:03:49,540
وليزيد الطينُ بلّة، تمَّ تعييني عرِّيفة الصفّ

71
00:03:49,920 --> 00:03:52,430
انتشرَتْ إشاعة بأن عرِّيف الصف
يتمُّ اختياره

72
00:03:52,430 --> 00:03:54,830
بناء على إحرازه أفضل درجات
في امتحان القبول

73
00:03:55,210 --> 00:03:57,840
ممّا زادَني انعزالاً

74
00:03:58,230 --> 00:03:59,300
...المعذرة

75
00:04:07,500 --> 00:04:09,180
اصمتوا أيُّها الأوغاد

76
00:04:12,890 --> 00:04:14,400
اسكتوا

77
00:04:14,400 --> 00:04:15,550
مفهوم؟

78
00:04:19,440 --> 00:04:23,200
عرِّيفة الصف، تابعي

79
00:04:24,920 --> 00:04:26,270
حسناً

80
00:04:26,850 --> 00:04:28,580
سيطرأ تغييرٌ على جدول

81
00:04:28,580 --> 00:04:30,700
المواعيد يوم الإثنين كي يتوفّر
وقت للتطوير المهني

82
00:04:31,150 --> 00:04:35,560
بفضل سوناهارا، تمكّنتُ من اجتياز حصّة
الغرفة الصفِّية

83
00:04:36,470 --> 00:04:39,310
غضِبَ سوناهارا لأجلي

84
00:04:39,670 --> 00:04:42,710
لم يقف أحدٌ في الصفِّ إلى جانبي

85
00:04:42,710 --> 00:04:44,280
لكنّه فعَل

86
00:04:46,640 --> 00:04:49,830
،يتجنّبُه الجميع لأنه يُزعَمُ بأنه جانِح

87
00:04:49,830 --> 00:04:52,640
لكن لعلّه ليسَ شخصاً سيئاً

88
00:04:54,870 --> 00:04:55,840
إنه ك.زد

89
00:04:55,840 --> 00:04:58,030
إنه فريق كُرة القدم ك.زد

90
00:04:58,030 --> 00:05:00,690
سمعتُ أنَّ صفوف المدرسة الإعدادية
تتمرّنُ في الميدان

91
00:05:03,810 --> 00:05:05,030
سيكون سهلاً

92
00:05:07,960 --> 00:05:08,920
آيا

93
00:05:11,330 --> 00:05:12,660
كوروكي-كون

94
00:05:13,530 --> 00:05:16,160
آه تذكّرت، أنتِ تداومين في هذه المدرسة

95
00:05:16,450 --> 00:05:18,370
تبدين جميلة بذلك الزيّ المدرسي

96
00:05:19,700 --> 00:05:21,070
!نـ..نعم

97
00:05:21,070 --> 00:05:22,420
شكراً

98
00:05:24,000 --> 00:05:25,510
ها هو ذا مجدداً

99
00:05:25,510 --> 00:05:27,250
لنرَ ما لديهم

100
00:05:28,240 --> 00:05:29,210
تاتشيبانا

101
00:05:30,100 --> 00:05:31,270
أويسوغي-كون

102
00:05:31,270 --> 00:05:32,360
ممتاز

103
00:05:32,360 --> 00:05:33,670
غداً هو يوم السبت، صحيح؟

104
00:05:33,670 --> 00:05:35,800
يقولُ واكاتاكي أن نلتقي في منزله

105
00:05:38,650 --> 00:05:40,360
...هل تعني

106
00:05:42,400 --> 00:05:43,690
أراكِ غداً

107
00:05:43,690 --> 00:05:44,710
إلى اللقاء

108
00:05:50,570 --> 00:05:53,200
الجميعُ يحدِّقون بي

109
00:05:57,640 --> 00:05:59,570
تعرفين ك.زد إذاً؟

110
00:05:59,880 --> 00:06:01,210
أنتِ لا تستحقِّين ذلك

111
00:06:03,810 --> 00:06:06,090
سيستهدفونني مجدداً

112
00:06:06,750 --> 00:06:08,050
...في اليوم التالي

113
00:06:09,120 --> 00:06:11,880
لكن لا يهمّني

114
00:06:12,290 --> 00:06:14,350
سيجتمعُ فريق التحرِّي ك.زد

115
00:06:14,350 --> 00:06:16,060
سأرى الجميعَ مجدداً

116
00:06:17,050 --> 00:06:19,060
أهذا منزلُ واكاتاكي؟

117
00:06:21,430 --> 00:06:22,900
ما هذه الشجرة يا تُرى؟

118
00:06:22,900 --> 00:06:24,580
هذه شجرةُ زيتون

119
00:06:25,890 --> 00:06:28,070
إنها من منطِقة البحر المتوسِّط

120
00:06:28,070 --> 00:06:32,570
قيل أنها زُرِعَتْ في اليونان
منذُ حوالي 3000 قبل الميلاد

121
00:06:33,580 --> 00:06:37,580
هذا هو عبقريّ العلوم والاجتماع، كوزوكا-كون

122
00:06:38,140 --> 00:06:39,640
لم أرك منذُ وقت طويل يا آيا

123
00:06:40,020 --> 00:06:41,030
كيف حالكِ؟

124
00:06:41,950 --> 00:06:44,050
بخير، ماذا عنك؟

125
00:06:45,410 --> 00:06:46,590
أين واكاتاكي؟

126
00:06:48,390 --> 00:06:49,630
...في الواقع

127
00:06:50,180 --> 00:06:52,590
إنه طريح الفِراش منذُ البارحة

128
00:06:52,910 --> 00:06:55,100
ماذا؟ لماذا؟

129
00:06:57,550 --> 00:06:59,870
من الصدمة الناجِمة عن تركِ فتاة له

130
00:06:59,870 --> 00:07:00,840
تركَتْه فتاة؟

131
00:07:01,440 --> 00:07:03,640
!هل كان لديه صديقة؟

132
00:07:04,510 --> 00:07:06,540
،أشعرُ بالشفقةِ عليه بعدما تركَتْه فتاة

133
00:07:06,540 --> 00:07:09,750
لكن يبدو بأنه يستمتِع بحياته في المدرسة الإعدادية

134
00:07:09,750 --> 00:07:11,110
أنا مطمئنّة قليلاً

135
00:07:12,130 --> 00:07:13,430
...لكن

136
00:07:13,430 --> 00:07:16,250
لماذا أنا منزعجة قليلاً؟

137
00:07:17,610 --> 00:07:19,950
على أي حال، تفضَّلي بالدخول

138
00:07:19,950 --> 00:07:21,120
نعم

139
00:07:21,120 --> 00:07:25,500
بدأتْ أوَّل قضية لفريق التحرِّي ك.زد في حياة

140
00:07:25,500 --> 00:07:28,960
المدرسة الإعدادية باضطجاع واكاتاكي على الفراش