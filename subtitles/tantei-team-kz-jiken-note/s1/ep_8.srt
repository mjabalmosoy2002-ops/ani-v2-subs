1
00:00:02,810 --> 00:00:05,670
مذكّرات فريق التحرِّي ك.زد

2
00:00:07,200 --> 00:00:08,530
اسمي تاتشيبانا أيا

3
00:00:09,140 --> 00:00:16,000
لم أتخيّل أبداً أن يغيِّرَ لِقائي بأربعة فتيان
غريبي الأطوار حياتي إلى هذا الحدّ الكبير

4
00:00:12,510 --> 00:00:15,980
مذكّرات قضيّة فريق التحرِّي ك.زد

5
00:00:17,920 --> 00:00:23,530
سأروي لكم قصّة القضايا المُثيرة التي نحلُّها
نحن، فريق التحرِّي ك.زد

6
00:00:25,840 --> 00:00:30,500
طفحَتْ حساسيّة واكاتاكي من اللحم بعدما
تناولَ لحمَ هامبرغر بقري صافٍ

7
00:00:30,810 --> 00:00:34,060
لعلَّ شريحة الهامبرغر كانَتْ مخلوطة
بلحم خنزير أيضاً

8
00:00:34,060 --> 00:00:39,390
وبالتالي بدأ فريق التحرِّي ك.زد بقضيّته الأولى
في المدرسة الإعدادية

9
00:00:45,230 --> 00:00:47,310
لهذا وجبَ عليّ التحقيق

10
00:00:47,620 --> 00:00:52,030
لكن واكاتاكي والآخرون عدوانيّون جداً اتجاه سوناهارا

11
00:00:52,770 --> 00:00:56,030
لا أظنُّه بذلك السوء أبداً

12
00:00:56,030 --> 00:00:58,370
اسمعي، ابتعدي عنه

13
00:00:58,560 --> 00:00:59,870
سأذهبُ إلى المنزل

14
00:01:00,260 --> 00:01:02,020
لن أعود مجدداً أبداً

15
00:01:02,410 --> 00:01:05,570
فقدتُ رباطة جأشي وتشاجرتُ معهم

16
00:01:05,570 --> 00:01:08,450
"أعتقدُ بأن هذا ما يُطلِقون عليه بـ"العين بالعين

17
00:01:08,450 --> 00:01:12,500
لم يتّصِل بي أحدٌ من فريق التحرِّي منذ ذلك الحين

18
00:01:14,830 --> 00:01:16,920
"شريحة لحم الهامبرغر مع البيض تعلم"

19
00:01:16,920 --> 00:01:18,050
"الجزء 3"

20
00:01:22,120 --> 00:01:24,060
آيا، مكالمة لكِ

21
00:01:26,060 --> 00:01:27,740
آيا، هذا أنا

22
00:01:27,740 --> 00:01:28,870
كوزوكا-كون

23
00:01:28,870 --> 00:01:30,060
هل تريد شيئاً؟

24
00:01:30,060 --> 00:01:31,940
دعا واكاتاكي إلى اجتماع

25
00:01:31,940 --> 00:01:33,770
سيُعقَدُ في منزل واكاتاكي غداً، يوم السبت

26
00:01:33,770 --> 00:01:34,570
هل يمكنكِ حضوره؟

27
00:01:34,930 --> 00:01:36,970
أظنُّني أستطيع

28
00:01:36,970 --> 00:01:38,070
عظيم

29
00:01:38,070 --> 00:01:39,520
سيُسعَدُ الجميعُ بذلك

30
00:01:39,520 --> 00:01:41,080
حقاً؟

31
00:01:42,390 --> 00:01:45,830
قال كوزوكا-كون أن الجميع سيُسعَدون

32
00:01:45,830 --> 00:01:48,580
لكنني كنتُ أكثر سعادة من أي شخص

33
00:01:49,260 --> 00:01:50,330
!مرحى

34
00:01:50,330 --> 00:01:53,060
!مرحى! مرحى

35
00:01:56,140 --> 00:01:57,980
!رائع

36
00:01:57,980 --> 00:02:00,470
هل يُسمَحُ لنا باستعمال هذه الغرفة؟

37
00:02:00,470 --> 00:02:02,350
أبي في نيويورك

38
00:02:02,350 --> 00:02:05,540
سيكونُ هذا مكتب فريق التحرِّي ك.زد
من الآن فصاعداً

39
00:02:05,920 --> 00:02:08,990
تابَعنا التحقيقات أثناء غيابكِ

40
00:02:08,990 --> 00:02:10,980
نريدُكِ أن تدوِّنيها كي نقدِّمها

41
00:02:10,980 --> 00:02:13,030
ماذا؟ هل كنتُم تحقِّقون؟

42
00:02:13,030 --> 00:02:15,830
كنّا نفعلُ ذلك ريثما تهدئين

43
00:02:17,220 --> 00:02:20,300
قال كوروكي أن أسبوعاً يكفي

44
00:02:21,270 --> 00:02:25,240
كوروكي-كون يكشفُ حركاتي البنّاتية

45
00:02:26,190 --> 00:02:30,620
لكن إن كنتُم قد انتهيتُم من تحقيقاتكم
فلماذا استدعيتموني؟

46
00:02:31,000 --> 00:02:32,420
على رسلكِ

47
00:02:32,420 --> 00:02:35,630
من سيدوِّن التقريرَ في غيابكِ؟

48
00:02:35,630 --> 00:02:37,530
أنتِ خبيرة اللغات، ألستِ كذلك؟

49
00:02:37,530 --> 00:02:39,630
أنتِ مدوّنة الملاحظات الوحيدة يا آيا

50
00:02:39,630 --> 00:02:41,170
...أنتم

51
00:02:41,170 --> 00:02:42,170
نعم

52
00:02:42,170 --> 00:02:45,000
سأفعلُ ما يجب عليّ فعله

53
00:02:45,000 --> 00:02:47,570
هذا ما يعنيه أن أكون مقبولة كصديقة

54
00:02:47,570 --> 00:02:51,150
يجبُ أن أبذل قصارى جهدي لحماية مركزي

55
00:02:52,120 --> 00:02:53,780
بالتأكيد، لنمضِ في ذلك

56
00:02:54,580 --> 00:02:57,510
نشكّ أن بعضاً من لحم الخنزير قد امتزج
بلحم البقر الصافي

57
00:02:57,510 --> 00:03:01,410
في شرائح الهامبرغر التي شُحِنَتْ
من مصنع سوناهارا للحوم

58
00:03:01,410 --> 00:03:04,160
لهذا أجرينا بحثاً ميدانياً

59
00:03:04,620 --> 00:03:06,160
بحث ميداني؟

60
00:03:06,510 --> 00:03:11,200
اشترينا بعضاً من اللحوم من مصنع سوناهارا
للحوم من عدّة متاجر

61
00:03:11,200 --> 00:03:12,540
،لا نستطيع شرائها كلّها

62
00:03:12,540 --> 00:03:15,170
لكن ستكونُ مئة عيّنة كافية لإجراء الحسابات

63
00:03:15,450 --> 00:03:16,550
!مئة؟

64
00:03:16,550 --> 00:03:19,620
قرَّرنا أن نأخذَ العيّنات إلى مخبر
صديق والدي

65
00:03:19,620 --> 00:03:22,180
لاستخراج الحمض النووي الريبي

66
00:03:22,180 --> 00:03:23,330
ما هذه؟

67
00:03:23,330 --> 00:03:25,180
نتائج تحليل الحمض النووي الريبي

68
00:03:25,180 --> 00:03:26,940
لستُ أفهم

69
00:03:26,940 --> 00:03:30,450
كانَتْ كافّة العيّنات المئة تقريباً
من لحم البقر الصافي

70
00:03:30,450 --> 00:03:31,190
تقريباً؟

71
00:03:32,180 --> 00:03:34,690
بعضها بدَتْ مختلِفة

72
00:03:34,690 --> 00:03:36,180
...هل تعني

73
00:03:36,180 --> 00:03:36,690
نعم

74
00:03:36,690 --> 00:03:39,190
كانتْ تحتوي على بعض من لحم الخنزير
رغم قلّة الكمّية

75
00:03:39,800 --> 00:03:41,850
مرِضَ واكاتاكي بسبب ذلك

76
00:03:41,850 --> 00:03:44,180
أرأيتِ؟ جسدي لا يكذب

77
00:03:44,180 --> 00:03:48,340
تقريباً كافّة شرائح الهامبرغر المُنتَجة
في المصنع تحتوي على 100% من لحم البقر

78
00:03:48,340 --> 00:03:52,710
لكننا تأكَّدنا الآن من احتوائها على كمّية
ضئيلة غير معروفة من لحم الخنزير

79
00:03:53,130 --> 00:03:54,630
لكن لماذا؟

80
00:03:54,630 --> 00:03:55,820
حادِثة عرَضيّة؟

81
00:03:55,820 --> 00:03:58,660
لا، تحدّثنا إلى الموظَّفين في المصنع

82
00:04:01,000 --> 00:04:03,240
من المُحال أن تكون أي مؤونات أخرى
قد اختلطَتْ معها من خطّ آخر

83
00:04:03,240 --> 00:04:04,650
...إذاً

84
00:04:04,650 --> 00:04:05,720
إذاً؟

85
00:04:06,140 --> 00:04:09,680
اختلطَ اللحمُ بها قبل أن تصل إلى المصنع

86
00:04:10,720 --> 00:04:12,190
منطِق جيّد يا آيا

87
00:04:12,190 --> 00:04:14,600
معكِ حقّ، كان هنالِك شخصاً واحداً مشبوهاً

88
00:04:14,600 --> 00:04:15,730
شخص مشبوه؟

89
00:04:17,380 --> 00:04:21,250
ينقلُ لحماً إلى المصنع ليُستخدَم
في صنع شرائح الهامبرغر

90
00:04:21,250 --> 00:04:22,810
إنه كسولٌ كثيراً

91
00:04:22,810 --> 00:04:24,620
وسمعته ليسَتْ بالجيّدة

92
00:04:25,040 --> 00:04:29,520
تعقَّبنا الطريقَ الذي يسلكُه
لنقل اللّحم إلى المصنع

93
00:04:29,520 --> 00:04:31,250
قضينا أيّاماً ونحن نُراقب

94
00:04:31,750 --> 00:04:35,250
كان ذلك الرّجل دائماً ما يُوقف الشاحنة ليسترخي

95
00:04:35,690 --> 00:04:39,190
وأحياناً يدخلُ الحمولةَ ليفعل شيئاً ما

96
00:04:39,190 --> 00:04:41,260
،لم تُسعفنا المسافة البعيدة من تحديد ما يفعله

97
00:04:41,260 --> 00:04:44,260
لكن ربَّما كان يخلطُ لحمَ الخنزير مع لحم البقر

98
00:04:44,260 --> 00:04:45,760
أنتُم مذهلون

99
00:04:45,760 --> 00:04:48,260
لا أصدِّق أنكم فعلتُم كل ذلك
خلال هذه الفترة القصيرة

100
00:04:48,760 --> 00:04:49,680
هل فهمتِ؟

101
00:04:49,680 --> 00:04:51,270
نعم

102
00:04:53,280 --> 00:04:55,240
هذا لطيفٌ وسهل الفهم

103
00:04:55,240 --> 00:04:56,420
هذه هي آيا التي نعرفُها

104
00:04:58,060 --> 00:05:01,780
لكن أتساءلُ ما سبب قيام ذلك الرجل
بخلطِ لحم الخنزير

105
00:05:01,780 --> 00:05:02,850
لا أدري

106
00:05:02,850 --> 00:05:04,870
لن نعرف ما إن كان يفعلُ ذلك للضحك

107
00:05:04,870 --> 00:05:06,820
أم للأذى ما لم نقبض عليه

108
00:05:06,820 --> 00:05:08,980
سأسلِّم هذا التقرير للشرطة

109
00:05:08,980 --> 00:05:10,900
أنا متأكِّدٌ أنهم سيطّلعون عليه

110
00:05:10,900 --> 00:05:11,790
معك حقّ

111
00:05:12,130 --> 00:05:15,790
وأيضاً سنجمعُ الإعلامَ هنا ونقيم مؤتمراً صحفياً

112
00:05:15,790 --> 00:05:17,390
مؤتمر صحفي؟

113
00:05:17,390 --> 00:05:20,300
"القضيّة قد حُلَّتْ على يدِ فريق التحرّي ك.زد"

114
00:05:20,300 --> 00:05:22,800
سنظهرُ في التلفزيون والصحف

115
00:05:23,830 --> 00:05:25,030
...سوناهارا

116
00:05:26,370 --> 00:05:28,800
ما الذي سيحلُّ بمصنع سوناهارا للحوم يا تُرى؟

117
00:05:29,060 --> 00:05:31,920
سينالُ الفاعلُ جزاءه المناسب على ما أعتقد

118
00:05:31,920 --> 00:05:35,380
وبالنسبة لمصنع سوناهارا للحوم، هنالِك ما يُدعى
...إجراء الإصحاح الغذائي، لِذا

119
00:05:35,380 --> 00:05:37,180
قد تُعلَّق أعماله

120
00:05:37,180 --> 00:05:39,740
في تِلك الحالة، قد يُفلِس أيضاً

121
00:05:39,740 --> 00:05:40,730
يُفلِس؟

122
00:05:41,180 --> 00:05:44,550
بعد إلقاء نظرة، تبيّن أن الديون
متراكمة على مصنع سوناهارا للحوم

123
00:05:44,550 --> 00:05:45,670
إنه بالكاد مستمرّ

124
00:05:46,120 --> 00:05:48,820
فإن عُلِّقَتْ أعماله سيبقى بِلا دخل

125
00:05:48,820 --> 00:05:52,030
يُفلِس؟ أليس هذا أمراً سيئاً؟

126
00:05:52,030 --> 00:05:53,980
أشفقُ على سوناهارا

127
00:05:53,980 --> 00:05:55,830
لم يرتكب أي خطأ

128
00:05:55,830 --> 00:05:58,460
لا داعي للشعورِ بالشفقةِ على ذلك الفتى

129
00:05:58,460 --> 00:05:59,710
إنه جانح

130
00:05:59,710 --> 00:06:00,830
...إنَّ سوناهارا

131
00:06:00,830 --> 00:06:05,840
مرِضَ صديقي بسببِ حساسية من لحم الخنزير

132
00:06:06,230 --> 00:06:08,630
تمنَّى سوناهارا الشفاء لك

133
00:06:08,630 --> 00:06:10,320
لا أظنُّه بذلك السوء

134
00:06:10,320 --> 00:06:12,180
لا تدافعي عن ذلك الرجل السيئ

135
00:06:12,180 --> 00:06:13,390
...لـ..لكن

136
00:06:13,390 --> 00:06:15,280
لعلَّها كانَتْ مجرّد مزحة

137
00:06:15,280 --> 00:06:16,570
لا يستحقُّون الإفلاس

138
00:06:16,570 --> 00:06:20,450
قد تحسبينها مزحة صغيرة، لكنها جريمة

139
00:06:20,450 --> 00:06:23,690
فقد انتهى الحالُ بي بالمرضِ بردّ فعل تحسُّسي

140
00:06:23,690 --> 00:06:25,860
كان من المُمكن أن يسوء أكثر

141
00:06:26,320 --> 00:06:32,160
لكن سوناهارا ساعدَني في الوقتِ
الذي لم يُساعدني أحد

142
00:06:33,300 --> 00:06:35,130
أمهلوني قليلاً من الوقت

143
00:06:35,690 --> 00:06:38,870
أريدُ إبلاغه على الأقل قبل أن يحدث ذلك

144
00:06:38,870 --> 00:06:40,580
أظنُّه سينصدم

145
00:06:42,300 --> 00:06:43,290
أرجوكم

146
00:06:44,880 --> 00:06:46,900
حسناً إن كنتِ مصرّة يا آيا

147
00:06:46,900 --> 00:06:47,880
نعم

148
00:06:47,880 --> 00:06:49,880
حسناً، تبّاً

149
00:06:50,130 --> 00:06:51,240
شكراً

150
00:06:51,240 --> 00:06:55,050
لكننا سنرافقكِ عندما تلتقين بسوناهارا

151
00:06:56,330 --> 00:06:59,080
فأنا بخلافكِ، لا أثِق بسوناهارا

152
00:06:59,690 --> 00:07:02,230
إن حدثَ شيء، سأحميكِ

153
00:07:03,410 --> 00:07:04,590
ماذا؟

154
00:07:06,030 --> 00:07:08,900
يجبُ على الرجل أن يحفظَ ماءَ وجهه

155
00:07:12,410 --> 00:07:14,410
أودُّ أن أقول لك شيئاً

156
00:07:14,410 --> 00:07:16,410
هل يمكننا أن نلتقي؟

157
00:07:21,540 --> 00:07:22,930
هل انتظرتِ طويلاً؟

158
00:07:24,060 --> 00:07:25,190
لا