1
00:00:02,810 --> 00:00:05,670
مذكّرات فريق التحرِّي ك.زد

2
00:00:07,200 --> 00:00:08,530
اسمي تاتشيبانا أيا

3
00:00:09,140 --> 00:00:16,000
لم أتخيّل أبداً أن يغيِّرَ لِقائي بأربعة فتيان
غريبي الأطوار حياتي إلى هذا الحدّ الكبير

4
00:00:12,510 --> 00:00:15,980
مذكّرات قضيّة فريق التحرِّي ك.زد

5
00:00:17,920 --> 00:00:23,530
سأروي لكم قصّة القضايا المُثيرة التي نحلُّها
نحن، فريق التحرِّي ك.زد

6
00:00:25,480 --> 00:00:29,440
توجّهتُ إلى منزل واكاتاكي وأنا سعيدة برؤية ك.زد

7
00:00:29,440 --> 00:00:32,550
للمرّة الأولى مُذ دخولنا المدرسة الإعدادية

8
00:00:33,040 --> 00:00:35,510
كان طريحُ السرير منذُ البارحة

9
00:00:35,900 --> 00:00:38,010
ماذا؟ لماذا؟

10
00:00:38,390 --> 00:00:40,630
من الصدمة الناجِمة عن تركِ فتاة له

11
00:00:43,440 --> 00:00:45,610
"شريحة لحم الهامبرغر مع البيض تعلم"

12
00:00:45,610 --> 00:00:47,020
"الجزء 2"

13
00:00:47,020 --> 00:00:49,020
لا، هذا ليس الترتيبُ الصحيح

14
00:00:49,380 --> 00:00:50,920
أي ترتيب؟

15
00:00:50,920 --> 00:00:53,510
لستُ طريحاً في السرير بسببِ ترك فتاة لي

16
00:00:53,510 --> 00:00:55,530
تركَتْني فتاةٌ لأنني انطرحتُ في السرير

17
00:00:55,530 --> 00:00:57,170
وما الفرق؟

18
00:00:57,170 --> 00:00:58,400
هنالِك فرق؟

19
00:01:01,610 --> 00:01:04,040
كيف لي أن أواعدَ فتاة وأنا بهذا المظهر؟

20
00:01:04,040 --> 00:01:06,440
مـ..ماذا حلَّ بوجهك؟

21
00:01:07,040 --> 00:01:09,530
نظرتُ إلى المرآة في صباح البارحة فوجدتُ نفسي هكذا

22
00:01:10,170 --> 00:01:13,280
لهذا اتصلتُ وقلتُ أنني لن أتمكّن
...من الذهاب إلى الموعد في عطلة ذلك الأسبوع و

23
00:01:13,280 --> 00:01:13,880
وداعاً

24
00:01:13,880 --> 00:01:16,050
"لم تسألتي حتّى عن السبب، إنَّما قالَتْ "وداعاً

25
00:01:17,690 --> 00:01:19,450
هل قال الطبيبُ شيئاً؟

26
00:01:19,450 --> 00:01:20,840
حساسيّة

27
00:01:20,840 --> 00:01:21,560
اللّعنة

28
00:01:21,960 --> 00:01:24,240
الحساسيّة مخيفة

29
00:01:24,240 --> 00:01:27,300
بإمكانها أن تُشعرك بصدمة وتقتلك فوراً

30
00:01:27,300 --> 00:01:28,750
حقاً؟

31
00:01:28,750 --> 00:01:29,690
نعم

32
00:01:29,690 --> 00:01:31,920
،لِذا إن أصابتكِ أعراضُ حساسيّة

33
00:01:31,920 --> 00:01:35,530
عليكِ الحرص على تحديدِ الأسباب وتجنّبها

34
00:01:36,050 --> 00:01:37,570
تجنّبيها مهما كلّفَ الأمر

35
00:01:37,570 --> 00:01:39,130
أعلمُ ذلك

36
00:01:40,840 --> 00:01:43,080
أنا ضعيفٌ أمام لحم الخنزير

37
00:01:43,430 --> 00:01:44,550
لحم الخنزير

38
00:01:45,830 --> 00:01:49,670
حاولتُ تذكُّر كل ما تناولتُه، لكن لم أتناول لحم خنزير

39
00:01:49,670 --> 00:01:50,840
أنا حذرٌ جداً حيال ذلك

40
00:01:50,840 --> 00:01:52,340
لنبحث عن السبب

41
00:01:52,710 --> 00:01:54,640
آيا، هل يمكنُكِ أن تدوِّني معنا؟

42
00:01:54,640 --> 00:01:55,590
نعم

43
00:01:58,250 --> 00:01:59,710
إنه دفترٌ جديد

44
00:02:00,590 --> 00:02:01,990
أنتِ حماسيّة

45
00:02:01,990 --> 00:02:04,600
...ليس تماماً، لكن

46
00:02:04,600 --> 00:02:05,730
أنا أكذب

47
00:02:05,730 --> 00:02:07,540
أنا حماسيّة جداً

48
00:02:07,540 --> 00:02:11,060
عليّ أداء عملي كمدوِّنة ملاحظات جيّداً

49
00:02:11,060 --> 00:02:15,530
هذا ما يجعلُني مقبولة كصديقة

50
00:02:16,090 --> 00:02:18,470
حسناً، أخبرني ما الطعام الذي تناولتَه

51
00:02:19,380 --> 00:02:24,120
اطّلعنا على كلّ الأطعمة التي أكلَها واكاتاكي

52
00:02:24,580 --> 00:02:27,900
والدُ واكاتاكي محامٍ

53
00:02:27,900 --> 00:02:29,850
إنه مسافرٌ إلى نيويورك الآن بداعي العمل

54
00:02:29,850 --> 00:02:35,300
لهذا ثمّة مُساعدة تُدعى شيمازاكي-سان
تعينُ واكاتاكي-كون حالياً

55
00:02:35,920 --> 00:02:38,630
شيمازاكي-سان لا تستخدم لحمَ الخنزير

56
00:02:39,010 --> 00:02:41,140
...لهذا لا يبقى إلّا

57
00:02:41,540 --> 00:02:43,640
لحم هامبرغر مع البيض

58
00:02:43,640 --> 00:02:46,510
أتأكلُ من بقالة المأكولات الخفيفة بعد مدرسة الدورات المكثّفة؟

59
00:02:46,510 --> 00:02:49,200
كنتُ جائعاً، ماذا أفعل؟

60
00:02:49,540 --> 00:02:53,270
ذلك الشيء الوحيد الذي قد يغطِّي طعمَ لحم الخنزير

61
00:02:53,650 --> 00:02:57,150
لكن كُتِبَ عليه 100% لحم بقر

62
00:02:57,520 --> 00:03:00,800
لكن تعرضتَ لردّة فعل حساسيّة بلا شكّ

63
00:03:00,800 --> 00:03:03,660
ما يعني أنه من المؤكَّد أنه كان يحتوي على لحم خنزير

64
00:03:04,120 --> 00:03:08,660
إن كانوا يبيعون لحمَ خنزير على أنه 100% لحم بقر
فتِلك مُشكلة

65
00:03:10,040 --> 00:03:12,790
لنكتشف من المسؤول بالضبط

66
00:03:12,790 --> 00:03:15,040
حسناً، لنبدأ بالتحرِّي

67
00:03:15,040 --> 00:03:16,670
قضية شريحة لحم الهامبرغر مع البيض

68
00:03:17,370 --> 00:03:19,620
سأنتقمُ منهم لتسبّبهم بتركِ فتاة لي

69
00:03:24,290 --> 00:03:25,860
حسناً، شكراً

70
00:03:27,970 --> 00:03:30,220
بقالة المأكولات الخفيفة التي أكلَ واكاتاكي منها اشترَتْ

71
00:03:30,220 --> 00:03:33,190
شرائح هامبرغر من مصنع أطعمة مُثلَّجة

72
00:03:33,630 --> 00:03:36,480
فإن وصلَ لحمُ الخنزير إليها
لا بدّ أنه قد حصلَ هناك

73
00:03:40,110 --> 00:03:41,740
الأطعمة المختلفة

74
00:03:41,740 --> 00:03:43,750
أتعني بأنه من المستحيل أن تكون قد امتزجَتْ؟

75
00:03:43,750 --> 00:03:45,480
تقولُ ذلك، لكن من الواضح أنه امتزج

76
00:03:45,480 --> 00:03:47,900
وأنا مثالٌ حيّ

77
00:03:47,900 --> 00:03:49,790
وروكي، هلّا تحرّيتَ عن ذلك المصنع؟

78
00:03:50,330 --> 00:03:53,290
شركة سوناهارا للحوم

79
00:03:54,370 --> 00:03:56,720
رائع، كوروكي-كون مذهل للغاية

80
00:03:56,720 --> 00:03:57,830
سوناهارا؟

81
00:03:57,830 --> 00:03:59,300
هل يُعقَلُ أن يكون سوناهارا ذاك؟

82
00:03:59,820 --> 00:04:00,800
نعم

83
00:04:02,700 --> 00:04:03,800
سوناهارا؟

84
00:04:04,210 --> 00:04:05,550
آيا؟

85
00:04:05,550 --> 00:04:09,310
ثمّة شابّ في صفِّي يُدعى سوناهارا

86
00:04:09,650 --> 00:04:11,660
سوناهارا كاكيرو؟

87
00:04:11,660 --> 00:04:13,170
نعم، لماذا؟

88
00:04:13,170 --> 00:04:16,270
أبوه هو رئيسُ سوناهارا للحوم

89
00:04:17,900 --> 00:04:21,710
كان سوناهارا كاكيرو لاعباً في فريق كرة القدم
ك.زد حتّى العام الماضي

90
00:04:22,630 --> 00:04:23,990
حتّى العام الماضي؟

91
00:04:23,990 --> 00:04:25,400
أيا

92
00:04:27,570 --> 00:04:29,530
ابتعدي عن سوناهارا

93
00:04:31,920 --> 00:04:33,500
إنه جانح

94
00:04:34,260 --> 00:04:35,420
إنه خطير

95
00:04:35,920 --> 00:04:37,420
بالفعل

96
00:04:38,010 --> 00:04:42,920
لكن لا يُوحي لي بأنه شخص سيئ

97
00:04:43,380 --> 00:04:47,960
أرسلَ شخصاً بالغاً يكبره بسنوات إلى المشفى

98
00:04:47,960 --> 00:04:49,420
تدخّلَت الشرطة

99
00:04:51,920 --> 00:04:54,690
،وتورّطَ فريقُ كُرة القدم الخاص بنا في الفوضى

100
00:04:54,690 --> 00:04:57,270
واضطررنا أن نتخلّى عن عدد من المُباريات

101
00:04:57,570 --> 00:05:02,500
وانتهى الحالُ بسوناهارا معتزِلاً كرة القدم
وتاركاً مدرسة الدورات المُكثَّفة

102
00:05:02,500 --> 00:05:04,530
مفهوم؟ ابتعدي عنه

103
00:05:04,530 --> 00:05:05,360
...لكن

104
00:05:05,360 --> 00:05:08,920
ذلك لا يغيِّر من حقيقة أنه حماني
في ذلك اليوم

105
00:05:08,920 --> 00:05:11,370
لا تعقِّبوا على حياتي الخاصة

106
00:05:12,110 --> 00:05:13,650
!اسمعيني

107
00:05:13,650 --> 00:05:14,620
!دعني وشأني

108
00:05:15,060 --> 00:05:17,600
كانَتْ لديك مخطَّطات لمواعدة فتاة أيضاً

109
00:05:17,600 --> 00:05:20,380
ما الذي يمنحُك الحقّ للتذمُّر منّي؟

110
00:05:20,380 --> 00:05:23,390
لم أكن أواعدُ جانحاً مثل سوناهارا

111
00:05:23,390 --> 00:05:24,380
!هنالِك فرق

112
00:05:24,380 --> 00:05:26,430
هنالِك فرقٌ بالنسبةِ لي أيضاً

113
00:05:26,430 --> 00:05:28,770
زميلي في الصفّ ليس نفس الحسناء الغبيّة

114
00:05:28,770 --> 00:05:31,490
التي تركَتْك دون حتّى أن تُعلِمك بالسبب

115
00:05:31,490 --> 00:05:33,490
هل تغارين؟

116
00:05:33,490 --> 00:05:34,870
ما الذي يعنيه هذا؟

117
00:05:36,100 --> 00:05:39,200
أنتُما، انفعلتُما كثيراً

118
00:05:39,560 --> 00:05:40,900
سأعودُ إلى المنزل

119
00:05:41,300 --> 00:05:43,110
لن أعود مجدداً

120
00:05:46,400 --> 00:05:48,830
سأعتزلُ فريقَ التحرِّي

121
00:05:48,830 --> 00:05:50,630
سأعتزلُ كلّياً

122
00:05:50,630 --> 00:05:51,410
غبيّ

123
00:06:04,660 --> 00:06:09,600
مضَت الأيَّام، لكن لم يتّصل الشبابُ بي

124
00:06:12,310 --> 00:06:14,680
انتهى درسُ الغرفة الصفّية اليوم

125
00:06:14,680 --> 00:06:15,790
المعذرة

126
00:06:15,790 --> 00:06:16,930
تاكيدا-سان؟

127
00:06:17,690 --> 00:06:22,070
أرى أن درس الغرفة الصفِّية يصعبُ فهمه
بالطريقة الحالية المُتّبَعة

128
00:06:25,910 --> 00:06:30,380
إذاً اقترحي أسلوباً أحسِّن من خلاله الدرس لو سمحتِ

129
00:06:30,380 --> 00:06:33,450
أظنُّنا ينبغي أن نفكِّر بذلك سويةً

130
00:06:35,530 --> 00:06:36,410
سأفكِّرُ بالأمر

131
00:06:38,320 --> 00:06:39,590
!ناهو

132
00:06:41,960 --> 00:06:44,810
كان رأسي

133
00:06:44,810 --> 00:06:47,590
كان فريقُ التحرِّي هو المكان الذي انتميتُ إليه

134
00:06:47,590 --> 00:06:49,090
وقد خسرتُه

135
00:06:49,090 --> 00:06:49,880
تاتشيبانا

136
00:06:51,100 --> 00:06:52,210
أحسنتِ

137
00:06:52,210 --> 00:06:55,470
تركتِ تاكيدا مذهولة

138
00:06:56,550 --> 00:06:57,390
هل من مُشكلة؟

139
00:06:57,670 --> 00:06:59,500
...عفواً، في الحقيقة

140
00:06:59,500 --> 00:07:03,160
مرِضَ صديقي بسببِ حساسية من لحم الخنزير

141
00:07:03,160 --> 00:07:05,530
سمعتُ أنّ الحساسية قد تكون مضرّة

142
00:07:05,530 --> 00:07:06,940
آملُ أن يتعافى صديقُكِ بسرعة

143
00:07:07,460 --> 00:07:09,140
شكراً

144
00:07:09,140 --> 00:07:12,490
سوناهارا ليس شخصاً سيّئاً في نهاية المطاف

145
00:07:13,280 --> 00:07:14,450
قبل أن أنسى

146
00:07:17,510 --> 00:07:19,210
هذا هو رقمُ هاتفي الخليوي

147
00:07:21,580 --> 00:07:23,700
اتّصلي بي إن احتجتِ لأي شيء

148
00:07:23,700 --> 00:07:24,450
إلى اللقاء