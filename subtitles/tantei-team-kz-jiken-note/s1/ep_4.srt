1
00:00:02,690 --> 00:00:05,520
مذكّرات فريق التحرِّي ك‏.‏زد

2
00:00:07,060 --> 00:00:08,400
اسمي تاتشيبانا أيا

3
00:00:09,020 --> 00:00:15,990
لم أتخيّل أبداً أن يغيِّرَ لِقائي بأربعة فتيان
غريبي الأطوار حياتي إلى هذا الحدّ الكبير

4
00:00:12,490 --> 00:00:15,990
مذكّرات قضيّة فريق التحرِّي ك‏.‏زد

5
00:00:17,780 --> 00:00:23,410
سأروي لكم قصّة القضايا المُثيرة التي نحلُّها
نحن‏،‏ فريق التحرِّي ك‏.‏زد

6
00:00:25,590 --> 00:00:28,340
عثَرنا على درّاجة واكاتاكي الجبليّة‏.‏

7
00:00:28,340 --> 00:00:32,030
بدأ واكاتاكي يقولُ أنه أرادنا أن نقبضَ على اللصّ بأنفسنا‏،‏

8
00:00:32,030 --> 00:00:34,460
لكن لم أوافق على ذلك

9
00:00:34,880 --> 00:00:39,600
فحسبتُ أنها كانَتْ نهاية صداقتنا‏،‏ لكن‏.‏‏.‏‏.‏

10
00:00:39,600 --> 00:00:42,570
أحضرَ كوروكي قائمةَ مكوِّنات الطلاء‏.‏

11
00:00:42,570 --> 00:00:43,680
لكن لا نستطيعُ قراءتها‏.‏

12
00:00:44,430 --> 00:00:45,300
من فضلكِ

13
00:00:46,070 --> 00:00:47,910
أنتِ ضليعةٌ في اليابانيّة‏،‏ صحيح؟

14
00:00:47,910 --> 00:00:48,770
قد تكتشفينها‏.‏

15
00:00:48,770 --> 00:00:52,030
لا أريدُ إجباركِ على القيام بشيء
لا تقدرين عليه

16
00:00:52,030 --> 00:00:54,250
لكن هذا اختصاصكِ

17
00:00:54,250 --> 00:00:55,990
أريدُ أن أتعاون معكِ

18
00:00:57,380 --> 00:00:59,530
‏"‏الدرّاجة المفقودة تعلم‏"‏

19
00:00:59,530 --> 00:01:00,990
‏"‏الجزء 4‏"‏

20
00:01:01,870 --> 00:01:04,430
استعرتُ قاموساً ألمانياً وبحثت

21
00:01:04,430 --> 00:01:06,460
عن معلومات حول الطلاء الأخضر

22
00:01:07,000 --> 00:01:09,740
وفقاً لتحرِّيات كوزوكا‏-‏كون وأويسوغي‏-‏كون‏،‏

23
00:01:09,740 --> 00:01:14,560
الطلاء الذي وُجِدَتْ آثاره في الدرّاجة الجبلية
استُخدِمَ على سيّارة مُستورَدة

24
00:01:14,840 --> 00:01:18,300
إن استطعنا قراءة قائمة المكوّنات‏،‏
بمقدورنا معرِفة ما تتألّف منه السيَّارة

25
00:01:18,300 --> 00:01:20,360
بمقدورنا الاقتراب خطوة من اللصّ

26
00:01:20,760 --> 00:01:24,480
لكنني لم أتعلّم الألمانية أبداً‏،‏
لذلك كان ذلك صعباً للغاية

27
00:01:24,860 --> 00:01:26,480
هيّا‏،‏ هل انتهيتِ؟

28
00:01:27,080 --> 00:01:27,980
اصمت

29
00:01:28,330 --> 00:01:30,480
ألا ترى أن تاتشيبانا تفعلُ ما بوسعها؟

30
00:01:30,970 --> 00:01:33,070
لِمَ لا تنتظر في الخارج إن كان ذلك يوتِّرُك؟

31
00:01:34,010 --> 00:01:35,990
نفدَ صبري

32
00:01:35,990 --> 00:01:36,960
آسف

33
00:01:37,390 --> 00:01:37,990
لا عليك

34
00:01:39,340 --> 00:01:40,850
أسرعي أكثر‏.‏

35
00:01:40,850 --> 00:01:41,490
حسناً‏.‏

36
00:01:42,870 --> 00:01:43,970
هل كشفتِها؟

37
00:01:43,970 --> 00:01:45,450
نعم‏،‏ وجدتُها

38
00:01:50,100 --> 00:01:51,460
بعد بضعة أيّام‏.‏‏.‏‏.‏

39
00:01:53,720 --> 00:01:58,470
لنلخِّص ما نعرفه حتّى الآن عن لصّ الدراجة الجبلية

40
00:01:58,940 --> 00:02:00,000
ما هذا؟

41
00:02:00,000 --> 00:02:01,860
سأدوّنُ القضيةَ في هذا الدفتر‏.‏

42
00:02:01,860 --> 00:02:03,970
فكّرتُ في أن نحتفظَ بسجلّ كي لا ننسى‏.‏

43
00:02:04,540 --> 00:02:05,910
فكرة سديدة

44
00:02:05,910 --> 00:02:08,980
لندع الخبيرة في اليابانية تاتشيبانا
تحفظ السجلّ‏.‏

45
00:02:09,390 --> 00:02:11,480
حسناً يا جماعة‏،‏ تقرير عن الوضع

46
00:02:11,480 --> 00:02:13,810
من خلال الطلاء‏،‏ علِمنا أنها ألمانية

47
00:02:13,810 --> 00:02:16,550
باور مولر طراز 1990

48
00:02:16,550 --> 00:02:17,820
خضراء داكنة

49
00:02:18,210 --> 00:02:21,660
تقعُ تِلك السيارة في نيتّا‏-‏تشو 5‏-‏26

50
00:02:22,070 --> 00:02:25,460
والعائلة مؤلَّفة من طالب في الكلّية ووالديه‏.‏

51
00:02:25,460 --> 00:02:28,090
الأبُ خارج المنزل بداعي العمل
ابتداء من هذا العام

52
00:02:28,090 --> 00:02:29,460
لا يوجد في المنزل إلّا الابن

53
00:02:29,870 --> 00:02:31,060
ذلك هو‏.‏

54
00:02:31,060 --> 00:02:33,630
لا بدّ وأنه الشخص الذي سرقَ درّاجتي‏.‏

55
00:02:34,210 --> 00:02:37,210
هذا ليس دليلاً كافياً للجزم في الأمر

56
00:02:37,920 --> 00:02:42,910
حاولتُ اللحاق بتلميذ الكلّية‏،‏
وسجّلتُ محادثتَه عبر الهاتف

57
00:02:43,320 --> 00:02:44,950
حقّاً؟

58
00:02:44,950 --> 00:02:46,370
اسمعوا فحسب‏.‏

59
00:02:47,070 --> 00:02:49,620
لنستهدف المحلّ الكائن بعد المحطّة هذه المرّة‏.‏

60
00:02:49,620 --> 00:02:53,370
لا مُشكلة‏،‏ سنحدّدُ طريقَ الهرب أولاً هذه المرة‏.‏

61
00:02:53,370 --> 00:02:55,980
كانَت الدرّاجة في آخر مرّة سيّئة للغاية‏.‏

62
00:02:57,120 --> 00:02:58,990
نعم‏،‏ يوم الجمعة المُقبل

63
00:02:58,990 --> 00:03:01,640
ستكونُ السيّارة قد أُصلِحَتْ ريثما يحين ذلك‏.‏

64
00:03:01,640 --> 00:03:02,810
أعلمُ ذلك

65
00:03:02,810 --> 00:03:06,500
لا أريد أن يقبضَ عليّ رجال الشرطة
لأجل شيء رخيص كهذا‏.‏

66
00:03:07,870 --> 00:03:10,370
هذا دليلٌ كافٍ

67
00:03:10,650 --> 00:03:12,440
ماذا نفعلُ الآن إذاً؟

68
00:03:12,440 --> 00:03:15,350
سنُطلِعُ الشرطة على هذا بالطبع

69
00:03:15,350 --> 00:03:16,240
!كلّا

70
00:03:16,240 --> 00:03:18,310
علينا أن نهدّدَ اللصَّ بهذا الدليل

71
00:03:18,310 --> 00:03:20,010
وندعه يسدّدُ ثمنَ الدرَّاجة

72
00:03:20,630 --> 00:03:22,660
هذا جنونٌ يا واكاتاكي

73
00:03:23,010 --> 00:03:25,450
يحاولُ سرِقة متجر آخر

74
00:03:25,450 --> 00:03:28,270
كيف لا تزالُ تتكلّم عن نفسِك في وقتٍ كهذا؟

75
00:03:28,600 --> 00:03:32,200
حسناً‏،‏ في يوم الجمعة‏،‏ سننصبُ كميناً للقبضِ عليه‏.‏

76
00:03:32,200 --> 00:03:34,020
سنقتادُه للشرطة

77
00:03:34,400 --> 00:03:36,280
ونظهر في التلفزيون والصُّحف

78
00:03:36,770 --> 00:03:37,910
هذا خطيرٌ جداً

79
00:03:37,910 --> 00:03:40,490
بحوزتِه سلاح

80
00:03:40,490 --> 00:03:44,490
يجدرُ بنا تسليم هذا التسجيل مع مذكّرة للشرطة

81
00:03:44,490 --> 00:03:45,810
هذا خيارُنا الوحيد

82
00:03:46,730 --> 00:03:47,530
أجل

83
00:03:49,860 --> 00:03:53,830
أتقولون لي أن كلّ ما فعلناه ذهبَ أدراج الرياح؟

84
00:03:53,830 --> 00:03:56,920
لن يفهم أحدٌ ما حدث‏.‏ لن أستعيد درّاجتي‏.‏

85
00:03:56,920 --> 00:03:58,270
هذا ليس عدلاً

86
00:03:58,900 --> 00:04:01,680
هكذا هي الحياة أحياناً

87
00:04:01,680 --> 00:04:05,080
لا ضير من القيامِ بعملِ الخير متخفّياً
بين الفيّنة والأخرى

88
00:04:05,080 --> 00:04:08,730
من الرّائع رؤيتك تفعلُ شيئاً جيّداً
دون علم أحد

89
00:04:08,730 --> 00:04:10,890
ستكونُ الحادِثة الأبرز في القرن

90
00:04:11,410 --> 00:04:14,440
كفَّ عن الثرثرة يا غبي

91
00:04:17,240 --> 00:04:19,910
سأسلِّمُ الدليلَ للشرطة في صباح الغد

92
00:04:29,020 --> 00:04:30,530
الحمدُلله

93
00:04:30,530 --> 00:04:33,000
انتهت القضية

94
00:04:39,110 --> 00:04:41,960
قد يتصرَّف واكاتاكي على هواه

95
00:04:43,720 --> 00:04:46,300
نيتّا‏-‏تشو 5‏-‏26

96
00:04:53,350 --> 00:04:55,120
أتظنُّ أنك تمتلك الدليل؟

97
00:04:55,690 --> 00:04:59,200
نعم‏،‏ بأنّك أنت الشخص الذي سطا على المتجر

98
00:04:59,750 --> 00:05:02,570
آثار طِلاء سيّارتك موجودة في درّاجتي

99
00:05:03,200 --> 00:05:06,530
وقد سجّلنا المُحادثة التي أجريتَها
مع الذي تواطأ معك

100
00:05:07,870 --> 00:05:09,360
‏.‏‏.‏‏.‏أنت

101
00:05:15,540 --> 00:05:16,830
واكاتاكي‏!‏

102
00:05:23,510 --> 00:05:25,550
يسرُّني أنني أجيدُ كرةَ القدم

103
00:05:36,330 --> 00:05:37,880
ألو؟ وقعَ حادث

104
00:05:37,880 --> 00:05:40,400
نحن في نيتّا‏-‏تشو 5‏-‏26

105
00:05:40,400 --> 00:05:41,190
...السرقة

106
00:05:47,370 --> 00:05:48,530
أنباء سارّة؟

107
00:05:48,530 --> 00:05:51,240
المُتواطِئون معه في السرقة قد اعتُقِلوا
للتو أيضاً

108
00:05:51,950 --> 00:05:54,200
نحنُ من فعلنا ذلك

109
00:05:54,200 --> 00:05:56,500
تخيّل لو أعطَتْنا الشرطة جائزة أو ما شابه

110
00:05:56,840 --> 00:06:00,040
ما الذي كان سيحدثُ برأيك لو لم نلحق بك؟

111
00:06:00,370 --> 00:06:03,300
شعَرنا أنّك ستُقدِمُ على ذلك يا واكاتاكي

112
00:06:03,670 --> 00:06:06,260
صداقتك مُتعِبة

113
00:06:06,530 --> 00:06:08,710
آيا هي من أنقذَتْك

114
00:06:08,710 --> 00:06:09,720
آيا؟

115
00:06:09,720 --> 00:06:11,770
نعم‏،‏ تاتشيبانا أيا

116
00:06:11,770 --> 00:06:12,510
آيا‏.‏

117
00:06:12,510 --> 00:06:15,180
أمّي هي الشخص الوحيد الذي يُناديني آيا

118
00:06:15,540 --> 00:06:18,290
بهذا الاسم يُطلِقُ معظم الناس على الفتيات
اللَّاتي تُدعى أيا أو أياكو

119
00:06:18,660 --> 00:06:20,520
مع أنه اسم جيّد يا آيا

120
00:06:21,060 --> 00:06:23,480
حسناً‏،‏ أنصِتوا يا آيا والجميع

121
00:06:23,890 --> 00:06:27,650
هنالِك كثيرٌ من الأمور التي نتعلّمها من هذه القضية

122
00:06:27,650 --> 00:06:31,950
من بينها أننا نمتلِكُ قدرات
لم نكن نتصوّرُ أننا نمتلكها

123
00:06:31,950 --> 00:06:34,990
لِذا إليكم الفكرة‏:‏ لنفتح مكتبَ تحقيق

124
00:06:35,350 --> 00:06:37,000
مكتب تحقيق؟

125
00:06:37,530 --> 00:06:39,570
نعم‏،‏ وقد ألّفتُ الاسم أيضاً

126
00:06:39,570 --> 00:06:40,500
ك‏.‏زد

127
00:06:41,170 --> 00:06:44,170
أليس هذا اسم فريقنا لكرة القدم؟

128
00:06:44,170 --> 00:06:46,070
مع أن حفظه سهل‏،‏ يروقُني الاسم

129
00:06:46,070 --> 00:06:47,800
فريق التحرِّي ك‏.‏زد

130
00:06:48,220 --> 00:06:49,130
لا بأس به

131
00:06:49,790 --> 00:06:51,140
قد يكون الأمر ممتعاً

132
00:06:51,480 --> 00:06:54,260
إن ادّخرنا مالاً‏،‏ أستطيعُ شِراء درّاجة جديدة

133
00:06:55,120 --> 00:06:58,680
صداقة واكاتاكي متعِبة حقّاً

134
00:06:59,050 --> 00:07:02,440
أصبحَ لدي مجموعة من الأصدقاء للمرّة
الأولى في حياتي

135
00:07:02,440 --> 00:07:06,820
واثِقة بأن أيّامي التي أقضيها معهم
ستكونُ ممتعة

136
00:07:07,080 --> 00:07:11,990
ما الذي ينتظرُنا في مكتب التحقيق الخاص بنا يا تُرى؟

137
00:07:13,990 --> 00:07:17,830
قضيّتُنا التالية هي قضيّة شريحة
الهامبرغر مع البيض

138
00:07:17,830 --> 00:07:20,170
ما الرابط بين الغموض المحيط

139
00:07:20,170 --> 00:07:22,950
بشريحة الهامبرغر مع البيض وسوناهارا‏-‏كون
الذي التقينا به للتو؟

140
00:07:23,420 --> 00:07:25,630
مذكّرات فريق التحرِّي ك‏.‏زد

141
00:07:25,630 --> 00:07:28,090
"الحلقة القادمة: "شريحة لحم الهامبرغر مع البيض

142
00:07:28,090 --> 00:07:29,420
نراكم الأسبوع المقبل