1
00:00:07,740 --> 00:00:09,130
.الرّياح قويّة

2
00:00:10,990 --> 00:00:13,990
.حمدًا لله على انتهاء الاجتماع سريعًا

3
00:00:13,990 --> 00:00:16,340
.قد أستطيع الانصراف في الوقت اليوم

4
00:00:18,740 --> 00:00:21,450
.لعلّي سآخذ استراحةً قصيرة قبل العودة للمكتب

5
00:02:12,570 --> 00:02:15,190
.تعمّ الفوضى شعري بسبب الرّياح

6
00:02:16,750 --> 00:02:19,290
...أقوم بهذا لأجل المظهر العامّ فقط

7
00:02:19,820 --> 00:02:22,930
.ليس لأنّ أماكوسا كان موجودًا بالتّحديد

8
00:02:30,540 --> 00:02:31,850
.ماذا؟ أماكوسا

9
00:02:32,970 --> 00:02:35,090
يا للمصادفة، أأنت في استراحتك؟

10
00:02:35,090 --> 00:02:37,760
.مرحبًا. شيء من ذاك القبيل

11
00:02:38,520 --> 00:02:39,640
أتتهرّبين من العمل يا ماتسوشيما؟

12
00:02:40,580 --> 00:02:43,240
.كلاّ، رجعت من اجتماع لتوّي

13
00:02:43,240 --> 00:02:44,140
.هكذا إذًا

14
00:02:44,140 --> 00:02:45,210
.شكرًا

15
00:02:50,150 --> 00:02:51,150
...ماتسوشيما

16
00:02:51,730 --> 00:02:52,540
ما الأمر؟

17
00:02:52,540 --> 00:02:54,110
.توجد أوراق ميتة على معطفك

18
00:02:54,680 --> 00:02:55,340
ماذا؟

19
00:02:55,820 --> 00:02:57,280
!أنت محقّ

20
00:02:58,480 --> 00:03:00,430
...يا لروعتي

21
00:03:06,560 --> 00:03:10,190
ينجز عمله على حاسوبه المحمول
...في مقهى لا أكثر، ومع ذلك

22
00:03:10,190 --> 00:03:13,090
.صورته مثاليّة جدًّا، غير مُنصف

23
00:03:13,620 --> 00:03:14,540
.صحيح

24
00:03:15,170 --> 00:03:15,990
ماذا؟

25
00:03:15,990 --> 00:03:17,430
هل انتبه لتحديقي به؟

26
00:03:17,910 --> 00:03:20,380
.هنالك ما أريد سؤالك عنه يا ماتسوشيما

27
00:03:20,380 --> 00:03:21,680
ماذا؟

28
00:03:21,680 --> 00:03:25,180
ما هي الأنميات الّتي توصين بها للموسم القادم؟

29
00:03:25,180 --> 00:03:25,820
ماذا؟

30
00:03:26,560 --> 00:03:30,430
،عددها كبير جدًّا ولا أستطيع معرفة أيّها أشاهد

31
00:03:30,720 --> 00:03:32,870
.فأردتُ رأيك

32
00:03:34,930 --> 00:03:38,960
،بافتراض تشابه ذوقيْ ماتسوشيما وإيتشيكا-سان

33
00:03:38,960 --> 00:03:41,530
يمكنني الوصول لصورة مناسبة
.عن الأنمي الّذي ستتابعه

34
00:03:41,530 --> 00:03:43,640
عندها سأتمكّن من مشاهدته باكرًا

35
00:03:43,640 --> 00:03:45,950
!وأن أجري محادثةً حيويّة مع إيتشيكا-سان

36
00:03:45,950 --> 00:03:50,160
أما تستطلعه الآن هي أنميات الموسم التّالي؟

37
00:03:50,160 --> 00:03:50,790
.صحيح

38
00:03:53,960 --> 00:03:54,780
ماذا؟

39
00:03:55,960 --> 00:03:58,300
.آسفة، لم أكن أتوقّع ذلك وحسب

40
00:03:59,470 --> 00:04:03,050
.حسنًا... قد أختار هذا شخصيًّا

41
00:04:04,660 --> 00:04:07,600
،كان العمل الأصليّ رائعًا
.فأظنّ مشاهدته ستكون سهلة

42
00:04:07,600 --> 00:04:08,930
لِمَ تهمسين؟

43
00:04:09,320 --> 00:04:11,590
.لأنّه قد يوجد هنا أحدٌ من الشّركة

44
00:04:12,180 --> 00:04:13,930
.هكذا إذًا... فهمت

45
00:04:14,560 --> 00:04:15,810
هذا إذًا؟

46
00:04:16,520 --> 00:04:17,210
...نعم

47
00:04:18,060 --> 00:04:20,070
.فهمت... حسنًا

48
00:04:21,280 --> 00:04:22,040
.شكرًا لك

49
00:04:23,310 --> 00:04:26,210
.قد يكون أماكوسا رائعًا حقًّا

50
00:04:27,530 --> 00:04:30,260
.الكلام معه أسهل من السّابق

51
00:04:28,300 --> 00:04:30,620
.أظنّني رأيت اسم ممثل الصّوت هذا قبلاً

52
00:04:30,620 --> 00:04:34,780
كما ألا يملك أماكوسا حبيبةً واقعٌ في غرامها الآن؟

53
00:04:34,780 --> 00:04:36,920
.نعم، أظنّني سمعت تلك الشّائعة

54
00:04:36,920 --> 00:04:39,960
.يُقال أنّها معلّمة أكبر سنًّا منه

55
00:04:39,960 --> 00:04:43,160
.صحيح، كانت هناك تلك الشّائعة

56
00:04:45,450 --> 00:04:46,470
...أيمكن

57
00:04:46,680 --> 00:04:49,450
،أجل، لم أكن مُهتمًّا

58
00:04:49,450 --> 00:04:54,690
لكنّ أحد معارفي يهوى مشاهدة
.الأنمي، فبدأتُ مشاهدته بسببه

59
00:04:54,690 --> 00:04:57,620
الشّخص الّذي تكلّم عنه قبلاً كانت حبيبته إذًا؟

60
00:04:57,620 --> 00:05:00,280
.أصبح كلّ شيء منطقيًّا

61
00:05:00,710 --> 00:05:05,160
لكن كلّ ما سمعتُه عن حبيبته
.كان من الشّائعات

62
00:05:05,160 --> 00:05:07,770
ويبدو أنّ هذه الشّائعة تأخذ
.مجراها الخاصّ أيضًا

63
00:05:08,200 --> 00:05:11,220
.أريد معرفة الحقيقة من الشّخص نفسه

64
00:05:11,220 --> 00:05:12,950
!هل أسأله؟ أسأله؟

65
00:05:13,200 --> 00:05:15,350
...توجد الكثير من أنميات الفنّانات حقًّا

66
00:05:15,350 --> 00:05:16,660
...أخبرني يا أماكوسا

67
00:05:17,670 --> 00:05:18,410
—ألديك

68
00:05:19,500 --> 00:05:21,690
.يبدو أنّ رسالة وصلتك

69
00:05:22,210 --> 00:05:22,710
...نعم

70
00:05:23,200 --> 00:05:24,520
...يا للتّوقيت

71
00:05:27,740 --> 00:05:30,400
.لديّ اجتماع، لذا عليّ العودة

72
00:05:30,400 --> 00:05:31,160
.حسنًا

73
00:05:39,100 --> 00:05:40,320
.أخبرني يا أماكوسا

74
00:05:41,360 --> 00:05:45,160
اتّفقت مجموعة منّا في العمل على
.الخروج للشّرب في الجمعة القادمة

75
00:05:45,160 --> 00:05:47,460
إذا كنتَ متفرّغًا، فما رأيك بالقدوم؟

76
00:05:48,280 --> 00:05:50,490
...الجمعة القادمة

77
00:05:50,490 --> 00:05:52,330
.يبدو ذلك مسليًّا

78
00:05:53,480 --> 00:05:55,420
.سأراجع جدولي وأتواصل معك

79
00:05:55,420 --> 00:05:56,080
.حسنًا

80
00:05:56,620 --> 00:05:58,260
!أجل، أجل

81
00:05:58,260 --> 00:06:01,060
حسنٌ، سأسأله عن حبيبته عندما
!نذهب للشّرب جميعًا

82
00:06:01,060 --> 00:06:02,220
!بالتّأكيد

83
00:06:06,100 --> 00:06:08,840
يا إلهي، أهذه لي يا رْيو-كن؟

84
00:06:08,840 --> 00:06:13,180
قد يكون هذا تقليديًّا قليلاً، لكن بما أنّ اسمك
.يعني السّوسن، فظننتُها ستكون ملائمة

85
00:06:13,180 --> 00:06:14,730
!يا إلهي

86
00:06:14,730 --> 00:06:16,320
.جلبتُ بودينغ أيضًا

87
00:06:16,320 --> 00:06:18,520
.آمل أن ينال إعجابكم

88
00:06:19,420 --> 00:06:22,090
،قلتُ أنّي سأمشي

89
00:06:19,420 --> 00:06:24,130
يا إلهي! من لا يحب التّقليديّات؟
!وجلبت بودينغ أيضًا

90
00:06:22,090 --> 00:06:25,040
.لكنّه أصرّ على أن يقلّني إلى منزلك

91
00:06:24,130 --> 00:06:25,760
.يسرّني سماع ذلك

92
00:06:25,040 --> 00:06:27,170
.أجل، راودني حدس

93
00:06:27,170 --> 00:06:29,910
.آمل ألاّ تضايقكم أختي كثيرًا إذًا

94
00:06:30,190 --> 00:06:31,620
.شكرًا لاستضافتي

95
00:06:32,060 --> 00:06:35,220
.بالطّبع، تفضّلي يا ريو-تشان

96
00:06:35,220 --> 00:06:38,610
ورْيو-كن، لِمَ لا تدخل لشرب الشّاي وأنت هنا؟

97
00:06:39,290 --> 00:06:43,770
.المعذرة، يتوجّب عليّ الذّهاب للشّركة الآن

98
00:06:43,770 --> 00:06:45,450
.هكذا إذًا، مؤسف

99
00:06:45,450 --> 00:06:48,720
.كما سمعتِه، فلتدخلي المنزل وحسب يا أمّي

100
00:06:45,800 --> 00:06:46,740
.مهلك

101
00:06:48,720 --> 00:06:49,500
.إيتشيكا-سان

102
00:06:51,120 --> 00:06:52,390
ماذا؟

103
00:07:00,810 --> 00:07:04,620
أتظنّين إن طلبتُ من يوريكو-سان
—أن أبيتَ تاليًا عندكم

104
00:07:04,620 --> 00:07:07,420
!بالتّوفيق في عملك! مع السّلامة

105
00:07:11,370 --> 00:07:13,990
.أمقتُ جبني

106
00:07:14,740 --> 00:07:17,140
عليّ الامتناع عن سؤال إيتشيكا-سان عمَّ حصل

107
00:07:17,140 --> 00:07:19,370
.في رحلتها المدرسيّة مع تامارو

108
00:07:20,290 --> 00:07:21,670
،إذا كنتُ سأهدر وقتًا بالقلق

109
00:07:21,670 --> 00:07:24,730
فحريّ بي أن أمضيه على اكتشاف
.كيفيّة إسعاد إيتشيكا-سان

110
00:07:27,300 --> 00:07:30,170
،بالكاد أستطيع مقابلتها الآن

111
00:07:30,170 --> 00:07:33,250
وسيكون من المهدر لو أشغلني شيء
.بعدما يتسنّى لي لقاؤها أخيرًا

112
00:07:35,140 --> 00:07:36,300
...مع أنّ

113
00:07:36,780 --> 00:07:40,390
إذا جرى شيءٌ ما بالفعل بين
...إيتشيكا-سان وتامارو

114
00:07:40,910 --> 00:07:43,190
.فسأتّخذ الإجراءات اللاّزمة لذلك

115
00:07:45,050 --> 00:07:49,180
.سأبدأ الطّهو الآن، لذا سيتأخّر العشاء قليلاً

116
00:07:49,180 --> 00:07:51,270
.سأساعدك يا يوريكو-سان

117
00:07:51,270 --> 00:07:55,910
لِمَ أنتِ تنادين أمّي باسمها الآن أيضًا؟

118
00:07:51,450 --> 00:07:53,020
ماذا؟ حقًّا؟

119
00:07:55,910 --> 00:07:58,540
هلاّ أعددتِ السّلطة مع إيتشيكا إذًا؟

120
00:07:58,540 --> 00:07:59,400
.حاضرة

121
00:07:59,910 --> 00:08:02,910
أتطهين في منزلكم يا ريو-تشان؟

122
00:08:02,910 --> 00:08:07,040
.حسنًا... كثيرًا ما أحضّر وجباتي بنفسي

123
00:08:07,040 --> 00:08:08,800
!مثير للإعجاب

124
00:08:08,800 --> 00:08:13,180
.والدانا كثيرا الغياب لعملهما، فآكل وحدي باستمرار

125
00:08:13,440 --> 00:08:17,160
صحيح، زرت منزل ريو عدّة مرّات

126
00:08:17,160 --> 00:08:19,930
.لكن لم أقابل والديها قطّ

127
00:08:19,930 --> 00:08:23,010
لا تأكلين مع رْيو-كن؟

128
00:08:23,010 --> 00:08:26,810
نأكل سويًّا من حينٍ لآخر عندما
.ينتهي من عمله باكرًا

129
00:08:26,810 --> 00:08:31,010
هكذا إذًا، من يطهو عندما تأكلان معًا؟

130
00:08:31,010 --> 00:08:35,450
.أخي، فطهيه يتفوّق عليّ بالتّأكيد

131
00:08:32,070 --> 00:08:35,990
.لم تنته بعد؟ أتضوّر جوعًا

132
00:08:35,990 --> 00:08:38,040
.ضعي الأطباق وانتظري فحسب

133
00:08:38,620 --> 00:08:41,440
.رْيو-سان طاهٍ بارع بالفعل

134
00:08:42,880 --> 00:08:45,170
.أنتما شقيقان مقرّبان حقًّا

135
00:08:45,170 --> 00:08:48,750
.لكن بدأتُ مؤخّرًا فقط بالأكل رفقة أخي

136
00:08:49,200 --> 00:08:54,600
كان لديه منزل مستقلّ، وكان يعيش
.هناك حتّى قبل 6 أشهر

137
00:08:54,600 --> 00:08:57,170
ماذا؟ لرْيو-سان منزل مستقلّ؟

138
00:08:57,170 --> 00:08:59,390
.نعم، بالقرب من شركته

139
00:08:59,390 --> 00:09:01,560
.هكذا إذًا

140
00:09:01,560 --> 00:09:06,430
.لكنّه أصبح يرجع لبيتنا باستمرار مذ التقى بك

141
00:09:06,430 --> 00:09:07,900
ماذا؟ لِمَ؟

142
00:09:08,230 --> 00:09:11,230
.لمعرفة معلومات عنك منّي بالطّبع

143
00:09:11,230 --> 00:09:12,780
!مهلاً

144
00:09:13,130 --> 00:09:16,390
ولأنّ أبي يعيش منفردًا
.لعمله أيضًا على الأرجح

145
00:09:16,390 --> 00:09:17,660
أبوك؟

146
00:09:17,660 --> 00:09:21,340
.أبي وأخي في خصام دائم

147
00:09:22,660 --> 00:09:24,410
.لا يتوافقان حقًّا

148
00:09:24,660 --> 00:09:25,250
—رجعت

149
00:09:25,250 --> 00:09:26,320
!يكفي هذا

150
00:09:26,320 --> 00:09:27,060
ماذا؟

151
00:09:27,060 --> 00:09:31,600
.لطالما كان أبي قاسيًا لحدّ مفرط على أخي

152
00:09:28,220 --> 00:09:30,960
!ما الّذي قد تفهمه؟ أنت مجرّد صبيّ

153
00:09:30,960 --> 00:09:33,260
!دعني أختر الجامعة الّتي أريدها على الأقلّ

154
00:09:33,260 --> 00:09:35,000
.كانا يتشاجران باستمرار

155
00:09:33,580 --> 00:09:35,880
لِمَ لا تصغي لي وحسب؟

156
00:09:36,200 --> 00:09:41,000
.لذا استأجر منزله المستقلّ كي لا يقابل أبي كثيرًا

157
00:09:41,390 --> 00:09:45,770
.فهمت... أذكر أنّك تكلّمتِ عن أبيك قبلاً

158
00:09:46,390 --> 00:09:50,340
،لعلّه استأجر منزله كي يستطيع دعوة الفتيات

159
00:09:50,340 --> 00:09:51,770
.لكن يُستحسن ألاّ أخبرها

160
00:09:52,360 --> 00:09:54,170
.لم يجلب أيًّا منهنّ مؤخّرًا

161
00:09:54,170 --> 00:09:56,100
.الطماطم الصّغيرة جاهزة

162
00:09:56,100 --> 00:09:58,740
أتمانعين لو أضفت اللّمسات النّهائيّة؟

163
00:09:58,740 --> 00:09:59,360
.كلاّ

164
00:09:59,360 --> 00:10:03,320
.لم يكن أبي صارمًا معي البتّة في النّاحية الأخرى

165
00:10:03,780 --> 00:10:06,500
كيف علاقة رْيو-كن مع أمّكما؟

166
00:10:07,520 --> 00:10:11,520
أمّي وأخي منسجمان، يتكلّمان مع
.بعضهما بشكل عاديّ

167
00:10:11,520 --> 00:10:13,630
.أي مع أبيك فحسب

168
00:10:13,630 --> 00:10:16,670
.كلاهما عنيدان، ذلك مُتعب حقًّا

169
00:10:13,630 --> 00:10:16,680
،جزءٌ من ذلك لأنّ أمّي تواصل طرح الأسئلة

170
00:10:16,670 --> 00:10:18,010
.ذلك شاق بالتأكيد

171
00:10:16,680 --> 00:10:19,010
.لكنّ ريو تتكلّم أكثر من العادة

172
00:10:19,650 --> 00:10:23,340
.لا بدّ أنّ ريو قلقة حيال أخيها وأبيها

173
00:10:23,760 --> 00:10:27,090
.لا تتكلّم عن هذه الأمور عادةً

174
00:10:23,760 --> 00:10:27,640
.لنضف فلفلاً أحمرًا... ولحمًا نيئًا مُقدّدًا

175
00:10:27,640 --> 00:10:29,960
.صحيح، بالفعل

176
00:10:31,000 --> 00:10:34,350
.أنتِ ورْيو-سان شقيقان وعائلة

177
00:10:34,350 --> 00:10:35,910
ماذا؟ لِمَ هذا الكلام فجأةً؟

178
00:10:35,910 --> 00:10:39,530
.لم أفكّر بالأمر بعمق قبلاً

179
00:10:39,530 --> 00:10:44,160
!ماذا؟ تشكّلين ورودًا باللّحم يا ريو-تشان
.أنتِ موهوبة حقًّا

180
00:10:44,370 --> 00:10:46,160
.كلاّ، هذا عاديّ

181
00:10:46,160 --> 00:10:51,750
.البتّة، إيتشيكا ليست موهوبة وخرقاء

182
00:10:51,750 --> 00:10:57,130
،عندما كانت في الروضة
.سكبت العصير على فستانها الجديد

183
00:10:52,560 --> 00:10:56,370
!أمّي، سكبتُ العصير

184
00:10:57,130 --> 00:10:59,090
.فورما ارتدته فعليًّا

185
00:10:57,130 --> 00:11:00,180
!مهلاً، كان ذلك في صغري يا أمّي

186
00:10:59,090 --> 00:11:04,110
حقًّا؟ أذكر عندما مرّرت إحداهنّ الكرة
إلى إيتشيكا في حصّة التربية البدنيّة

187
00:11:04,110 --> 00:11:06,280
.وأمسكتها بوجهها

188
00:11:04,410 --> 00:11:05,610
...إيتشيكا، الكرة

189
00:11:07,140 --> 00:11:09,020
!لحظة، لِمَ تشاركين يا ريو؟

190
00:11:09,020 --> 00:11:11,090
!حقًّا يا إيتشيكا؟

191
00:11:11,090 --> 00:11:11,850
...وفي ذاك اليوم

192
00:11:11,500 --> 00:11:12,750
!توقّفي

193
00:11:11,850 --> 00:11:14,980
لم تكن تعلم أنّها ارتدت حذاءها في القدم الخطأ

194
00:11:12,750 --> 00:11:17,210
!ولِمَ أنتِ وأمّي متوافقتان هكذا؟ يكفي! يا إلهي

195
00:11:14,980 --> 00:11:16,430
.حتّى انتهت دروسنا الصّباحيّة

196
00:11:16,430 --> 00:11:18,220
.خرقاء بحقّ

197
00:11:19,930 --> 00:11:21,660
.استمتعتُ بوقتي

198
00:11:21,970 --> 00:11:23,560
.شكرًا لك يا إيتشيكا

199
00:11:23,560 --> 00:11:26,420
...ريو، بخصوص كلامك سابقًا

200
00:11:26,420 --> 00:11:28,980
.عن رْيو-سان ووالدك

201
00:11:28,980 --> 00:11:34,660
نعم... كنت أتمنّى أن يصبحا
.على وفاق منذ صغري

202
00:11:34,660 --> 00:11:37,520
.فهمت، لا عجب أن تقلقي

203
00:11:40,270 --> 00:11:41,610
!نمتِ بسرعة

204
00:12:05,490 --> 00:12:08,490
.تبقّت 30 دقيقة على مباراة ريو

205
00:12:08,710 --> 00:12:12,510
،لا يزال لدينا وقت
.لنذهب للتّشجيع في مكانٍ آخر

206
00:12:12,510 --> 00:12:18,260
يستمرّ فريقنا في الفوز والتّقدّم
.بفضل جهود ريو وساتّشان

207
00:12:18,260 --> 00:12:21,010
.إنّهما بارعتان في الرّياضة

208
00:12:21,880 --> 00:12:25,320
.لنبذل جهدنا في تشجيعهنّ

209
00:12:25,320 --> 00:12:27,880
.علينا مواكبة ساتسوكي وريو

210
00:12:29,090 --> 00:12:29,810
ماذا؟

211
00:12:30,650 --> 00:12:34,060
يبدو أنّ فريق كرة قدم الفتيان
.لفصلنا يواصل انتصاراته أيضًا

212
00:12:34,060 --> 00:12:35,020
.معكِ حقّ

213
00:12:35,350 --> 00:12:37,300
هل بدأ نصف النّهائيّ الآن يا ترى؟

214
00:12:37,300 --> 00:12:38,950
.لنذهب لتشجيعهم

215
00:12:38,950 --> 00:12:39,900
.معكِ حقّ

216
00:12:45,450 --> 00:12:47,370
!إيتشيكا! روري

217
00:12:49,220 --> 00:12:51,040
.كاي، انظر يا كاي

218
00:12:51,550 --> 00:12:53,330
أليس هذا رائعًا؟

219
00:12:53,330 --> 00:12:53,930
ماذا؟

220
00:12:53,930 --> 00:12:56,460
!انظر لقسم التّشجيع، هناك

221
00:12:56,460 --> 00:12:58,090
.أتت آريما

222
00:12:59,090 --> 00:13:00,280
وما في ذلك؟

223
00:12:59,610 --> 00:13:01,420
.سيبدؤون الآن

224
00:13:01,250 --> 00:13:03,500
.لا داعي للإحراج

225
00:13:03,500 --> 00:13:08,350
.تجوّلتما معًا في المربى المائيّ أثناء رحلة فصلنا

226
00:13:03,880 --> 00:13:06,860
.أتى الكثير من طلاّب فصلنا لتشجيعهم

227
00:13:08,350 --> 00:13:11,400
إذًا، هل تتواعدان الآن؟

228
00:13:11,400 --> 00:13:14,900
!أنتما! ستبدأ المباراة

229
00:13:14,900 --> 00:13:16,180
.هيّا بنا

230
00:13:17,000 --> 00:13:18,190
.حسنًا، حسنًا

231
00:13:18,190 --> 00:13:20,400
...ليكن في علمك

232
00:13:21,440 --> 00:13:24,360
.لم أخبر آريما بمشاعري بعد

233
00:13:24,890 --> 00:13:28,200
.سأخبرك متى فعلت، لذا ابقَ صامتًا حتّى حينها

234
00:13:29,330 --> 00:13:31,030
!يا إلهي، رائع

235
00:13:31,030 --> 00:13:33,810
.لنركّز على المباراة الآن وحسب

236
00:13:33,810 --> 00:13:35,130
.حسنًا

237
00:13:35,990 --> 00:13:36,980
!ابذلوا جهدكم

238
00:13:36,980 --> 00:13:37,730
.بدأت

239
00:13:39,420 --> 00:13:40,310
!كاي

240
00:13:41,740 --> 00:13:43,150
!تقدّموا

241
00:13:45,130 --> 00:13:46,730
!أنتَ لها

242
00:13:45,130 --> 00:13:46,730
!انطلق

243
00:13:45,130 --> 00:13:46,730
!كاواغوتشي

244
00:13:51,890 --> 00:13:52,920
ماذا؟

245
00:13:51,890 --> 00:13:52,920
...إنّه

246
00:14:01,400 --> 00:14:03,070
...إنّه

247
00:14:03,070 --> 00:14:05,740
.تامارو-كن رائع

248
00:14:05,740 --> 00:14:07,200
!أجل

249
00:14:07,700 --> 00:14:11,450
.لم يبد عليه أنّه بارع في الرّياضة، فهذا مُفاجئ

250
00:14:11,450 --> 00:14:14,200
.سترتفع شعبيّة تامارو الآن

251
00:14:14,200 --> 00:14:17,200
إيتشيكا، أكنتِ تعرفين ببراعة
تامارو في كرة القدم؟

252
00:14:17,200 --> 00:14:19,640
ماذا؟ لِمَ تسأليني؟

253
00:14:19,640 --> 00:14:21,590
ألستِ مقرّبةً منه؟

254
00:14:21,590 --> 00:14:23,620
.لم أكن أعرف

255
00:14:26,800 --> 00:14:28,020
!أجل

256
00:14:27,180 --> 00:14:29,050
!أحسنتَ يا كاي

257
00:14:29,050 --> 00:14:31,800
.يبدو تامارو-كن رائعًا حقًّا

258
00:14:32,020 --> 00:14:33,470
.يا إيتشيكا

259
00:14:33,990 --> 00:14:38,250
.ربّما ستزيد منافِساتك بعد بطولة اليوم

260
00:14:38,250 --> 00:14:40,730
منافِساتي؟ في ماذا؟

261
00:14:41,810 --> 00:14:43,250
.تعرفين قصدي

262
00:14:43,250 --> 00:14:46,490
!مهلك، لا شيء بيني وتامارو-كن

263
00:14:46,490 --> 00:14:47,240
ماذا؟

264
00:14:47,240 --> 00:14:48,930
!إنّها الحقيقة

265
00:14:51,020 --> 00:14:53,490
.تظنّني خجلةً على أن أعترف

266
00:14:57,000 --> 00:15:00,750
هل رْيو-سان بارع في كرة القدم أيضًا يا ترى؟

267
00:14:57,270 --> 00:15:00,750
!أنتَ لها! أجل! هكذا! سدّد

268
00:15:03,240 --> 00:15:04,970
أليس هذا رائعًا يا إيتشيكا؟

269
00:15:04,970 --> 00:15:06,720
.ماذا؟ أجل

270
00:15:07,130 --> 00:15:08,940
!سيشاركون في النّهائيّ تاليًا

271
00:15:08,940 --> 00:15:10,300
!مذهل

272
00:15:10,300 --> 00:15:12,630
!قد يستطيعون الفوز بالبطولة

273
00:15:10,300 --> 00:15:13,300
.كان خصومهم من السّنة الثّالثة، وغلبوهم

274
00:15:12,630 --> 00:15:15,200
!بالفعل! هذا مثير

275
00:15:13,300 --> 00:15:16,310
.أجل، آمل أن يفوزوا باللّقب

276
00:15:16,310 --> 00:15:20,310
.ستبدأ مباراة ريو والبقيّة قريبًا

277
00:15:20,890 --> 00:15:23,190
.علينا التّوجّه للصّالة

278
00:15:23,560 --> 00:15:25,700
.سنذهب لتشجيع فريق كرة السّلّة الآن

279
00:15:25,700 --> 00:15:26,290
.حسنًا

280
00:15:26,290 --> 00:15:27,820
كاي، كيف كانت؟

281
00:15:27,820 --> 00:15:31,240
أقصد تمريرتي الطّويلة المذهلة، ألم تكن رائعة؟

282
00:15:31,240 --> 00:15:34,010
.مرّرتَ الكرة لي كثيرًا

283
00:15:34,010 --> 00:15:36,560
.كنتُ أحاول تسليط الأضواء عليك

284
00:15:38,450 --> 00:15:42,490
.أردتُ سماع رأيها بالمباراة نوعًا ما

285
00:15:58,320 --> 00:15:59,580
!فازتا

286
00:16:08,330 --> 00:16:11,270
لعلّك لم تكن بأفضل مستواك
.دون تشجيع آريما

287
00:16:11,700 --> 00:16:12,820
!ليس هكذا

288
00:16:17,330 --> 00:16:20,060
.سيكون الأكثر نجاحًا بلا شكّ

289
00:16:20,060 --> 00:16:22,270
.لا تنساني لاحقًا

290
00:16:23,270 --> 00:16:24,500
ما الّذي تقوله؟

291
00:16:29,740 --> 00:16:33,260
...لم تسنح لي فرصة لسؤال أماكوسا عن حبيبته

292
00:16:34,080 --> 00:16:35,640
.لا عجب

293
00:16:35,640 --> 00:16:40,100
.كلّنا من أقسام متفرّقة، فنتكلّم عنها لا أكثر

294
00:16:35,990 --> 00:16:37,430
...لذا، موظّفو المبيعات لدينا

295
00:16:37,430 --> 00:16:40,100
...كلاّ، انتظر حتّى تسمع

296
00:16:40,580 --> 00:16:43,140
.سيكون من الغريب أن أسأله فجأةً

297
00:16:44,240 --> 00:16:45,750
.ها أنتِ

298
00:16:45,750 --> 00:16:49,770
آريتّي، كنّا على وشك الإنهاء هنا
—والتّوجّه لمكان الجولة الثّا

299
00:16:50,100 --> 00:16:52,170
!أرجوك! ساعديني

300
00:16:52,170 --> 00:16:52,840
ماذا؟

301
00:16:54,330 --> 00:16:55,110
.حسنًا

302
00:16:55,110 --> 00:16:58,860
...انتهت الجولة الأولى، والآن

303
00:16:58,860 --> 00:16:59,890
ماذا عن الجولة الثّانية؟

304
00:16:59,890 --> 00:17:01,620
.اعذروني، سأرجع

305
00:17:01,620 --> 00:17:04,430
.حسنًا، حسنًا. ارجع لبيتك أيّها الزّوج الحديث

306
00:17:04,430 --> 00:17:06,020
.صحيح، إنّه كذلك

307
00:17:04,430 --> 00:17:06,990
.انصرف، انصرف

308
00:17:06,020 --> 00:17:07,750
.بكلامكم أشواك

309
00:17:06,990 --> 00:17:08,320
...زوج حديث

310
00:17:08,320 --> 00:17:09,250
...إذًا

311
00:17:09,570 --> 00:17:12,260
.ستأتيان للكاراوكي معي

312
00:17:13,260 --> 00:17:16,060
!ستُرافقاني، امشيا

313
00:17:18,730 --> 00:17:19,640
.أماكوسا

314
00:17:20,220 --> 00:17:24,320
.يبدو أنّ آريتّي تريد الشّرب أكثر، لذا لتصاحبها

315
00:17:24,980 --> 00:17:26,230
.نستأذنكما إذًا

316
00:17:26,510 --> 00:17:28,570
!هيّا! انطلقا

317
00:17:27,770 --> 00:17:30,110
...يا إلهي، أنتم الثّملون

318
00:17:31,600 --> 00:17:33,350
...إ-إذًا يا أماكوسا

319
00:17:33,860 --> 00:17:37,870
.توجد حانة أردت زيارتها بالقرب

320
00:17:37,870 --> 00:17:42,370
ما رأيك بأن نشرب قليلاً هناك؟
.من الصّعب أن أذهب بمفردي

321
00:17:43,180 --> 00:17:45,620
.حسنًا، لا أمانع. لنذهب

322
00:17:46,460 --> 00:17:47,240
.أجل

323
00:17:47,240 --> 00:17:48,070
!رائع

324
00:17:48,070 --> 00:17:53,340
...بالمناسبة، هنالك ما يحيّرني
هل "آريتّي" هو لقبك؟

325
00:17:53,340 --> 00:17:57,810
.نعم. اسمي آريي، فيناديني أصدقائي وزملائي بذلك

326
00:17:57,810 --> 00:17:59,580
.هكذا إذًا، فهمت

327
00:17:59,580 --> 00:18:03,550
!من المحرج جدًّا شرح لقبي

328
00:18:07,990 --> 00:18:09,220
!رائع

329
00:18:12,610 --> 00:18:16,930
ذاك الصّوت الّذي سمعناه في الاجتماع
كان قرقرة معدة رئيس القسم إذًا؟

330
00:18:16,930 --> 00:18:22,160
.أجل. كنتُ أجلس بجواره، وكان عاليًا

331
00:18:23,840 --> 00:18:25,910
.كان يتردّد في أرجاء قاعة الاجتماع

332
00:18:26,140 --> 00:18:29,130
.ضاعت منك التّعابير للحظة يا أماكوسا

333
00:18:29,130 --> 00:18:34,180
كنتِ تضحكين بدورك، فأنا أتذكّر
.اهتزاز الأوراق الّتي كانت بيديك

334
00:18:34,180 --> 00:18:36,010
.انتبهتَ لي إذًا

335
00:18:37,050 --> 00:18:40,040
...بالمناسبة، اعذرني على تغيير الموضوع

336
00:18:40,040 --> 00:18:41,510
ماذا؟ ما هناك؟

337
00:18:41,510 --> 00:18:44,280
.سأسأل مباشرةً

338
00:18:44,280 --> 00:18:47,520
هل الشّائعات عن حبيبتك صحيحة؟

339
00:18:47,520 --> 00:18:49,120
الشّائعات عن حبيبتي؟

340
00:18:49,120 --> 00:18:54,270
.أ-أقصد عن كونها معلّمة وأكبر سنًّا... وما شابه

341
00:18:54,270 --> 00:18:59,370
هذا؟ من أين خرجت تلك الشّائعة بالأصل؟

342
00:19:00,030 --> 00:19:01,740
!ماذا؟ يبتسم؟

343
00:19:01,740 --> 00:19:03,530
!ما-ما معنى هذا؟

344
00:19:05,430 --> 00:19:07,040
.لا حبيبة لديّ بتلك المواصفات

345
00:19:08,240 --> 00:19:09,790
حقًّا؟

346
00:19:10,200 --> 00:19:14,250
.انتشرت تلك الشّائعة في جهل تامّ منّي

347
00:19:14,250 --> 00:19:16,920
.ولم يسألني أحد عنها، فلم أُدلِ بشيء

348
00:19:16,920 --> 00:19:18,380
....هكذا إذًا

349
00:19:20,630 --> 00:19:22,480
ألديك حبيبة الآن إذًا؟

350
00:19:22,480 --> 00:19:23,390
.لا

351
00:19:23,390 --> 00:19:24,700
.ليس لديه

352
00:19:24,700 --> 00:19:26,810
!أي أنّه... أعزب

353
00:19:29,650 --> 00:19:31,390
.لديّ من تثير إعجابي مع ذلك

354
00:19:34,140 --> 00:19:35,420
تثير إعجابك؟

355
00:19:35,420 --> 00:19:36,330
.نعم

356
00:19:38,000 --> 00:19:39,780
.هكذا إذًا

357
00:19:40,990 --> 00:19:43,030
...هذا مجرّد تخمين

358
00:19:43,030 --> 00:19:47,910
لكن هل الشّخص المعجب بالأنمي الّذي
تعرفه هو نفسه من يثير إعجابك؟

359
00:19:47,910 --> 00:19:49,600
.أنتِ فطنة

360
00:19:49,600 --> 00:19:50,910
.صحيح، إنّه هو

361
00:19:51,190 --> 00:19:55,200
.بغضّ النّظر عن دافعي، أصبحتُ أحبّ الأنمي الآن

362
00:19:55,870 --> 00:19:58,050
.لم أكن أشكّ بذلك

363
00:19:58,300 --> 00:20:00,050
...بصراحة

364
00:20:00,480 --> 00:20:05,480
كلّما تكلّمتْ عن الأنمي، تصبح
.تشبهك كثيرًا يا ماتسوشيما

365
00:20:05,480 --> 00:20:07,630
الحلقة الثّامنة؟ أعرف، صحيح؟

366
00:20:07,630 --> 00:20:10,760
أقراص بلوري الإصدار المحدود
!للدّفعة الأولى؟! كيف؟

367
00:20:11,810 --> 00:20:13,050
حقًّا؟

368
00:20:13,820 --> 00:20:15,810
.لا أظنّ أنّي أريد سماع البقيّة

369
00:20:15,810 --> 00:20:17,810
.لديّ من تثير إعجابي مع ذلك

370
00:20:18,540 --> 00:20:20,540
ماذا؟ من تثير إعجابه؟

371
00:20:22,090 --> 00:20:27,230
اعذرني على التّطفّل، لكنّ هذا حبّ
غير متبادل بشكل عامّ، صحيح؟

372
00:20:27,700 --> 00:20:28,950
.نعم، معكِ حقّ

373
00:20:32,750 --> 00:20:33,620
...إذًا

374
00:20:33,620 --> 00:20:35,750
.إذًا قد لا تزال لديّ فرصة

375
00:20:36,380 --> 00:20:38,960
...نحن متشابهتان، صحيح؟ في تلك الحالة

376
00:20:36,380 --> 00:20:39,250
ما الخطب؟ ما الّذي أردتِ شربه تاليًا؟

377
00:20:38,960 --> 00:20:41,650
يعني أنّي لا أزال أملك فرصة، أليس كذلك؟

378
00:20:43,760 --> 00:20:44,790
صحيح؟

379
00:20:46,260 --> 00:20:49,540
.شربتِ الكثير، لكن تبدين بخير

380
00:20:49,540 --> 00:20:52,060
.نعم، تحمّلي للخمر قويّ

381
00:20:53,100 --> 00:20:55,560
.شكرًا على دعوتكِ لي اللّيلة

382
00:20:55,560 --> 00:20:58,750
.سعد الجميع بقدومك معنا

383
00:20:58,750 --> 00:21:00,670
.لا بأس من الخروج سويًّا هكذا من حينٍ لآخر

384
00:21:01,620 --> 00:21:03,950
.نخطّط لتكرار الأمر الشّهر القادم

385
00:21:03,950 --> 00:21:05,580
.فلترافقنا إذا أحببت

386
00:21:05,580 --> 00:21:06,780
.حسنًا

387
00:21:08,090 --> 00:21:09,550
...سأودّعك إذًا

388
00:21:13,840 --> 00:21:14,790
ما الأمر؟

389
00:21:15,770 --> 00:21:17,720
.لا، لا شيء

390
00:21:21,100 --> 00:21:24,760
.شكرًا على مرافقتك لي إلى المحطّة، إلى اللّقاء

391
00:21:24,760 --> 00:21:26,170
.أجل، إلى اللّقاء

392
00:21:27,370 --> 00:21:29,720
لكنّ هذا حبّ غير متبادل بشكل عامّ، صحيح؟

393
00:21:40,110 --> 00:21:43,900
.مرحبًا، إنّه رْيو. أعتذر على الاتّصال في وقتٍ متأخّر

394
00:21:45,380 --> 00:21:46,040
ماذا؟

395
00:21:47,890 --> 00:21:51,130
.شعرتُ برغبة بسماعك صوتك فجأةً لا أكثر

396
00:21:53,100 --> 00:21:56,600
.كالعادة"؟ ربّما معك حقّ"

397
00:21:59,130 --> 00:22:03,420
"...كيف تلفت انتباه شاب يحبّ غيرك"

398
00:22:04,150 --> 00:22:05,080
!بحث

399
00:23:36,030 --> 00:23:38,410
."الحلقة القادمة: "حبّ شخصيّتك المفضّلة