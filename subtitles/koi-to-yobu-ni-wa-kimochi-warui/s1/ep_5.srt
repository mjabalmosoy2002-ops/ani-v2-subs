1
00:00:02,330 --> 00:00:07,110
اسمحوا لي بتقديم المصوّرين اللّذين
.سينضمّان لنا في هذه الّرحلة

2
00:00:07,110 --> 00:00:09,860
.تانيغوتشي-سان وماسودا-سان

3
00:00:09,860 --> 00:00:10,900
.مرحبًا

4
00:00:10,900 --> 00:00:13,380
.يسرّنا لقاؤكم

5
00:01:55,230 --> 00:01:56,290
.ريو

6
00:01:58,060 --> 00:01:59,820
ألن تشتري تذكارات؟

7
00:01:59,820 --> 00:02:02,930
،لا أملك الكثير ممّن قد أهديهم إيّاها

8
00:02:02,930 --> 00:02:05,520
.فكنت أنوي شراءها كلّها في اليوم الأخير

9
00:02:05,520 --> 00:02:06,700
تريدين القليل؟

10
00:02:06,700 --> 00:02:07,840
.شكرًا لك

11
00:02:12,910 --> 00:02:14,280
،يا سيّدي المصوّر

12
00:02:14,490 --> 00:02:16,230
.لا يمكنك تصورينا بغتةً هكذا

13
00:02:16,230 --> 00:02:18,110
.لدينا حقّ الرّفض

14
00:02:18,110 --> 00:02:21,700
—المعذرة، لكنّ هذا عملي

15
00:02:21,700 --> 00:02:24,290
!انتبهي! لا تسحبي! هذه الكاميرا باهظة

16
00:02:24,290 --> 00:02:27,880
!هذا مؤلم! ستنزعينها

17
00:02:25,560 --> 00:02:30,080
لكن لم يخطر لي أن تكون مصوّر
.رحلتنا المدرسيّة يا ماسودا-سان

18
00:02:30,870 --> 00:02:36,520
حسنًا، أصاحب أحد زملائي الأكبر لالتقاط
،الصّور في الرّحلات المدرسيّة من حين لآخر

19
00:02:36,520 --> 00:02:39,080
،وعندما سمعتُ اسم المدرسة اليوم
"!قلتُ لنفسي "مستحيل

20
00:02:39,080 --> 00:02:40,980
!لكن تبيّن أنّها الحقيقة

21
00:02:41,530 --> 00:02:44,670
هل أخبرت أخي أنّك سترافقنا كمصوّر؟

22
00:02:44,670 --> 00:02:46,370
.رْيو؟ كلاّ

23
00:02:46,370 --> 00:02:47,680
لم تفعل؟

24
00:02:47,920 --> 00:02:49,320
...إذا فعلت

25
00:02:49,320 --> 00:02:53,300
فأنا متأكّد أنّه سيخبرني بالتقاط
صور كثيرة لكِ يا إيتشيكا-تشان

26
00:02:53,300 --> 00:02:56,600
وقد يصرّ على مرافقتي كمساعد
.أيضًا على الأرجح

27
00:02:56,600 --> 00:02:57,920
!أنا آسفة

28
00:02:58,220 --> 00:03:01,030
ماسودا-سان، هلاّ التقطتَ صورةً لنا؟

29
00:03:01,700 --> 00:03:05,350
.قادم، أراكما لاحقًا إذًا

30
00:03:07,520 --> 00:03:09,640
.ماسودا-سان ذو شعبيّة

31
00:03:09,640 --> 00:03:12,380
.من السّهل التّفاهم معه

32
00:03:12,380 --> 00:03:14,770
.علينا التقاط صور بدورنا

33
00:03:14,770 --> 00:03:15,450
.أجل

34
00:03:16,290 --> 00:03:18,130
!"حسنًا، "شيسا

35
00:03:22,730 --> 00:03:24,490
...يا لظرافتها

36
00:03:24,490 --> 00:03:26,850
،أنا متأكّد أنّها ستكون بخير رفقة ريو

37
00:03:27,270 --> 00:03:30,230
.لكن هنالك ما أقلق حياله

38
00:03:32,260 --> 00:03:33,550
.آسفة

39
00:03:34,690 --> 00:03:35,810
ماتسوشيما؟

40
00:03:35,810 --> 00:03:37,360
.هذا أنت يا أماكوسا

41
00:03:37,840 --> 00:03:39,290
.أسقطتُ الكثير

42
00:03:39,290 --> 00:03:40,360
.شكرًا لك

43
00:03:40,360 --> 00:03:42,780
.يبدو أنّي تركتُ حقيبتي مفتوحة

44
00:03:44,100 --> 00:03:46,330
أهذا لكِ؟

45
00:03:49,020 --> 00:03:52,160
!ماذا؟! لِمَ؟

46
00:03:52,160 --> 00:03:56,130
كيف انتهى المطاف بحمّالة المفاتيح الّتي
يُفترض أنّها في غرفتي في حقيبة يدي؟

47
00:03:56,130 --> 00:03:56,920
!ما الّذي يجري؟

48
00:03:57,590 --> 00:04:01,420
صحيح، ارتطمتُ باللّوح الفلّيني
...صباح اليوم لأنّي كنت في عجلة

49
00:04:01,420 --> 00:04:03,800
!هل سقطت آنذاك؟

50
00:04:03,800 --> 00:04:07,360
ولِمَ كان أماكوسا سريع الحُكم
الّذي من رآني؟

51
00:04:07,360 --> 00:04:08,820
هل جنيتُ على نفسي؟

52
00:04:09,100 --> 00:04:12,390
.أخفيتُ الأمر عن زملائي وحتّى عن أصدقائي

53
00:04:12,600 --> 00:04:14,510
.عليّ التّمويه على الموضوع بشكلٍ ما

54
00:04:15,320 --> 00:04:18,760
أظنّ أنّ حمّالة مفاتيح أختي
...دخلت حقيبتي بالخطأ

55
00:04:18,760 --> 00:04:21,640
أليست هذه توهو من "فورورد ورلد"؟

56
00:04:23,440 --> 00:04:25,110
.أنتِ تحبّينها أيضًا إذًا

57
00:04:25,110 --> 00:04:26,990
أ-أتعرفها؟

58
00:04:26,990 --> 00:04:31,010
أجل، كانت توهو مذهلة
.في الحلقة الثّامنة من الأنمي

59
00:04:31,010 --> 00:04:33,460
الحلقة الثّامنة؟ أعرف، صحيح؟

60
00:04:33,460 --> 00:04:35,580
!بكيتُ طوال الحلقة

61
00:04:36,810 --> 00:04:40,000
.ظننتُ أنّك لا تشاهد أشياء كتلك يا أماكوسا

62
00:04:40,430 --> 00:04:43,150
،صحيح، لم أكن مهتمًّا

63
00:04:43,150 --> 00:04:48,050
لكنّ أحد معارفي يهوى مشاهدة
.الأنمي، فبدأتُ مشاهدته بسببه

64
00:04:48,590 --> 00:04:51,970
أجريتُ بحثًا شاملاً عنه بما
.أنّ إيتشيكا-تشان تحبّه كثيرًا

65
00:04:51,970 --> 00:04:54,900
.لم أكن أعلم أنّكِ تحبّين الأنمي

66
00:04:54,900 --> 00:04:56,580
...نعم، أنا

67
00:04:56,580 --> 00:05:02,900
أيمكنك إخفاء حقيقة حبّي للأنمي
عن زملائنا في العمل؟

68
00:05:03,180 --> 00:05:05,080
لا أمانع، لكن لِمَ؟

69
00:05:05,730 --> 00:05:10,600
.أفضّل إبقاء الهواية خفيّةً... شيء من هذا القبيل

70
00:05:10,600 --> 00:05:12,570
.حسنًا، فهمت

71
00:05:12,910 --> 00:05:16,150
.إذا أردتِ الكلام عن الأنمي مُجدّدًا، فحادثيني

72
00:05:17,110 --> 00:05:20,130
.لا بدّ أنّ كبح شيءٍ تحبّينه أمرٌ صعب

73
00:05:22,000 --> 00:05:23,020
.إلى اللّقاء

74
00:05:23,020 --> 00:05:24,410
.حـ-حسنًا

75
00:05:31,950 --> 00:05:34,140
،كان هذا آخر ما توقّعته

76
00:05:34,140 --> 00:05:37,100
.لكنّي أظنّه سيتكتّم على الأمر على الأقلّ

77
00:05:38,100 --> 00:05:40,960
.لا بدّ أنّ كبح شيءٍ تحبّينه أمرٌ صعب

78
00:05:42,430 --> 00:05:46,440
.أعتقد أنّ انطباعي عن أماكوسا تحسّن نوعًا ما

79
00:05:50,970 --> 00:05:53,450
،انفصلتُ عن ريو والآخرين تمامًا

80
00:05:54,160 --> 00:05:58,040
.ونفدت بطّارية هاتفي، فلا أستطيع الاتّصال بهم

81
00:06:00,150 --> 00:06:01,040
!آسفة

82
00:06:02,800 --> 00:06:04,340
ماذا؟ تامارو-كن؟

83
00:06:04,340 --> 00:06:06,880
ما الّذي تفعلينه بمفردك يا آريما؟

84
00:06:06,880 --> 00:06:08,440
.انفصلتُ عن البقيّة

85
00:06:08,440 --> 00:06:13,390
صحيح، هل تعرف بيانات التّواصل
مع ريو أو ساتّشان أو رو-تشان؟

86
00:06:13,390 --> 00:06:15,340
...كلاّ، لا أحد منهنّ

87
00:06:15,340 --> 00:06:16,770
.فهمت

88
00:06:18,140 --> 00:06:22,040
طريقنا محدّد، فستلتقين بهنّ
.في نهاية المطاف على الأرجح

89
00:06:22,040 --> 00:06:24,980
.أرى أنّه حريّ بك التّجوّل والاستمتاع بوقتك الآن

90
00:06:25,290 --> 00:06:27,590
.نعم، معك حقّ

91
00:06:27,900 --> 00:06:28,910
.شكرًا لك

92
00:06:30,560 --> 00:06:32,470
أيمكن أنّك بمفردك أيضًا؟

93
00:06:32,470 --> 00:06:35,130
...كلاّ، أنا مع مجموعة

94
00:06:35,950 --> 00:06:37,640
لِمَ لم تقل لنا يا كاي؟

95
00:06:37,640 --> 00:06:38,700
!نحن ندعمك

96
00:06:39,860 --> 00:06:42,660
.كنتُ في مجموعة، لكنّهما تركاني للتّوّ

97
00:06:42,660 --> 00:06:44,140
ماذا؟ لا تمانع هذا؟

98
00:06:44,140 --> 00:06:46,690
لا مشكلة، أستطيع التّواصل معهما
.متى احتجتُ لذلك

99
00:06:47,760 --> 00:06:50,020
.تبدو مرهقًا نوعًا ما يا تامارو-كن

100
00:06:50,960 --> 00:06:56,030
.حسنًا، لا أحبّ أن أكون في حشدٍ كبير لا أكثر

101
00:06:57,130 --> 00:07:00,600
،أخبرني يا تامارو-كن
ما رأيك بأن نتفقّد الحوض الكبير؟

102
00:07:00,600 --> 00:07:01,690
.لا أمانع

103
00:07:09,400 --> 00:07:11,280
.إنّه كبيرٌ بالفعل

104
00:07:11,280 --> 00:07:14,350
عندما تقترب هكذا، لا يكون
،في مجال رؤيتك سوى السّمك

105
00:07:14,350 --> 00:07:16,910
.فكأنّنا تحت الماء دون تواجد أحد

106
00:07:20,380 --> 00:07:23,880
!انظر يا تامارو-كن! إنّه قرش حوتيّ! مذهل

107
00:07:23,880 --> 00:07:27,800
!إنّه أكبر مما ظننت! وظريف

108
00:07:31,510 --> 00:07:34,380
!يا للتّعبير الجميل يا إيتشيكا-تشان

109
00:07:34,380 --> 00:07:36,370
.لا تلتقط الصّور بلا تنبيه

110
00:07:36,370 --> 00:07:40,140
آسف، آسف، كنتِ ظريفةً جدًّا
.وأنتِ متحمسّة

111
00:07:41,280 --> 00:07:44,180
هل لديك بيانات التّواصل
مع ريو يا ماسودا-سان؟

112
00:07:44,180 --> 00:07:45,570
.ماذا؟ نعم

113
00:07:45,570 --> 00:07:48,600
.نفدت بطّارية هاتفي، فلم أستطع الاتّصال بها

114
00:07:48,600 --> 00:07:51,650
.يمكنك استعمال هاتفي، تواصلي معها

115
00:07:51,650 --> 00:07:53,230
.شكرًا جزيلاً

116
00:07:53,230 --> 00:07:56,070
آريما، أتعرفين هذا الرّجل؟

117
00:07:56,070 --> 00:07:59,160
.ماسودا-سان صديقٌ لرْيو-سان، التقيتُه مؤخّرًا

118
00:07:59,380 --> 00:08:04,360
.تعرف رْيو إذًا؟ سُررت بلقائك يا صبيّ

119
00:08:04,360 --> 00:08:06,890
.لستُ صبيًّا، اسمي تامارو

120
00:08:06,890 --> 00:08:08,920
إنّه يعرف ذاك الشّخص إذًا؟

121
00:08:09,310 --> 00:08:10,880
مرحبًا؟ ريو؟

122
00:08:10,880 --> 00:08:13,220
.استعرتُ هاتف ماسودا-سان

123
00:08:11,910 --> 00:08:14,650
أيمكن أنّي قاطعت شيئًا؟

124
00:08:13,220 --> 00:08:19,620
.نعم، حسنًا. يمكننا الالتقاء لاحقًا
.حسنًا، لنتقابل عند المربى المائيّ

125
00:08:14,650 --> 00:08:17,860
.ماذا؟ ليس الأمر هكذا

126
00:08:17,860 --> 00:08:18,810
حقًّا؟

127
00:08:19,620 --> 00:08:25,080
،بدا أنّ رْيو قلقٌ على إيتشيكا-تشان
.قد يكون هذا السّبب

128
00:08:25,790 --> 00:08:28,150
اشتريتُ هدايا! أليست ظريفة؟

129
00:08:28,370 --> 00:08:30,240
!إنّها ظريفة

130
00:08:30,240 --> 00:08:32,750
تردن التّخطيط لوقتنا الحرّ غدًا؟

131
00:08:32,750 --> 00:08:33,820
.لا بأس

132
00:08:38,000 --> 00:08:39,910
ما الخطب؟ اتّصال من أحد؟

133
00:08:39,910 --> 00:08:41,470
...نعم

134
00:08:41,470 --> 00:08:42,790
لا داعي لتجيبي؟

135
00:08:45,000 --> 00:08:46,620
لِمَ لا تجيبي عليه في الرّواق؟

136
00:08:46,620 --> 00:08:49,050
.حـ-حسنًا، سأفعل

137
00:08:55,380 --> 00:08:58,260
تعرف أنّي في رحلتي المدرسيّة
الآن، أليس كذلك؟

138
00:08:58,470 --> 00:09:01,850
أعتذر، كان هنالك ما عليّ
.التّأكّد منه بعجالة

139
00:09:02,070 --> 00:09:03,190
التأكّد منه؟

140
00:09:03,190 --> 00:09:07,770
اتّصلتُ بماسودا قبل قليل
...لموضوعٍ ما، وقال

141
00:09:08,450 --> 00:09:13,890
أنا في أوكيناوا حاليًّا مع إيتشيكا-تشان
!وفصلها كمصوّر لرحلتهم الميدانيّة

142
00:09:13,890 --> 00:09:20,400
،وهكذا، قد تكون مزحةً بمعرفتي به
.فأردتُ التّأكّد منك

143
00:09:20,400 --> 00:09:23,160
.حسنًا... ماسودا-سان موجودٌ بالفعل

144
00:09:24,620 --> 00:09:26,960
!ذاك الوغد! أشعر بالغيرة

145
00:09:28,010 --> 00:09:29,870
...إنّه يعمل

146
00:09:29,870 --> 00:09:32,250
!أعرف، لكن... تبًّا

147
00:09:32,640 --> 00:09:35,190
عمومًا، كيف رحلتك؟

148
00:09:36,120 --> 00:09:39,650
.مسلّية، ذهبتُ للمربى المائيّ اليوم

149
00:09:39,650 --> 00:09:41,630
.كان القرش الحوتيّ ظريفًا جدًّا

150
00:09:41,630 --> 00:09:45,100
.القرش الحوتيّ؟ لم يسبق وأن رأيته

151
00:09:45,100 --> 00:09:47,040
أصحّتكِ بخير بالمناسبة؟

152
00:09:47,040 --> 00:09:50,770
.يا إلهي، أنت تقلق كثيرًا، لستَ أمّي

153
00:09:52,150 --> 00:09:53,900
أأبدو مثل يوريكو-سان؟

154
00:09:53,900 --> 00:09:56,600
هلاّ امتنعت عن مناداة أمّي باسمها؟

155
00:09:56,600 --> 00:10:02,160
وإن كنتَ تريد التّأكّد من تواجد
ماسودا-سان، فلمَ لم تتّصل بريو؟

156
00:10:02,160 --> 00:10:05,720
.إذًا كنت سأتّصل بإحداكما، فستكون أنت

157
00:10:05,720 --> 00:10:07,540
،وإذا أصاب حدسي

158
00:10:07,540 --> 00:10:10,040
فلا بدّ أنّك أصبحتِ مشتاقةً
—لسماع صو

159
00:10:10,040 --> 00:10:11,040
!لم أشتق

160
00:10:11,400 --> 00:10:12,790
—أو تشتاقين لي

161
00:10:12,790 --> 00:10:15,090
.لم أشتق، لا تشغل بالك

162
00:10:15,870 --> 00:10:17,690
.آسف، كنتُ أداعبك

163
00:10:18,980 --> 00:10:22,170
،اتّصلتُ للسّؤال عن ماسودا

164
00:10:23,150 --> 00:10:27,330
.لكنّ السّبب الأكبر هو لأنّي أردت سماع صوتك

165
00:10:32,070 --> 00:10:34,900
بوجود ريو وماسودا-سان

166
00:10:35,690 --> 00:10:38,030
...لكن دونك

167
00:10:38,500 --> 00:10:40,160
...يجعلني أفتقدك

168
00:10:41,770 --> 00:10:43,430
.قليلاً

169
00:10:45,480 --> 00:10:46,480
حقًّا؟

170
00:10:46,480 --> 00:10:50,540
!قـ-قليلاً! مِلءَ ملعقة! حفنة

171
00:10:51,040 --> 00:10:53,860
!سعادتي بسعة المحيط

172
00:10:54,310 --> 00:10:56,230
.هذا كبيرٌ وعميق

173
00:10:57,660 --> 00:11:03,040
بالمناسبة، إحدى زميلاتي في العمل
."معجبة بـ"فورورد ورلد

174
00:11:03,040 --> 00:11:04,700
!ماذا؟ حقًّا؟

175
00:11:05,190 --> 00:11:09,240
،أخبرتني بألاّ أذكر الأمر لزملائنا في العمل
.لكن لا مشكلة بإخبار إيتشيكا-سان

176
00:11:10,030 --> 00:11:12,110
.يبدو أنّها معجبة بتوهو أيضًا

177
00:11:12,110 --> 00:11:13,900
!لدينا حتّى نفس الشّخصيّة المفضّلة

178
00:11:14,310 --> 00:11:17,600
الشّخصيّة المفضّلة؟
.أظنّها معجبة أنمي بشكلٍ عامّ

179
00:11:17,600 --> 00:11:20,160
حقًّا؟ أيّ أنميات أخرى تحبّها؟

180
00:11:20,160 --> 00:11:21,700
.سأسألها المرّة القادمة

181
00:11:21,700 --> 00:11:23,860
.نعم، إذا استطعت

182
00:11:23,860 --> 00:11:28,510
تتحمّس إيتشيكا-سان عند كلامها
.عن الأنمي، يا لظرافتها

183
00:11:28,510 --> 00:11:30,670
.سأرجع الآن إذًا

184
00:11:31,090 --> 00:11:33,860
.حسنًا، استمتعي بوقتكِ غدًا

185
00:11:33,860 --> 00:11:34,840
.عمتِ مساءً

186
00:11:35,210 --> 00:11:36,560
.عمتَ مساءً

187
00:11:40,500 --> 00:11:41,530
تامارو-كن؟

188
00:11:41,530 --> 00:11:43,390
.اليوم يوم المصائب

189
00:11:43,620 --> 00:11:44,850
ما الخطب؟

190
00:11:44,850 --> 00:11:49,120
كنتُ أمرّ فحسب في طريقي
...لشراء مشروب

191
00:11:49,120 --> 00:11:51,200
أيمكنني مرافقتك؟

192
00:11:51,200 --> 00:11:53,150
...ماذا؟ لا أمانع

193
00:11:53,150 --> 00:11:55,600
.كنتُ سأشتري مشروبات للجميع

194
00:11:55,600 --> 00:11:58,800
.الجميع؟ تقصدين أماكوسا والبقيّة

195
00:11:58,800 --> 00:12:02,800
.نعم، سنخطّط لجدولنا في وقتنا الحرّ غدًا

196
00:12:03,290 --> 00:12:04,870
...الوقت الحرّ

197
00:12:10,880 --> 00:12:13,250
...لكن دونك

198
00:12:13,720 --> 00:12:15,560
...يجعلني أفتقدك

199
00:12:15,560 --> 00:12:17,320
.قليلاً

200
00:12:19,640 --> 00:12:20,590
.آريما

201
00:12:21,880 --> 00:12:23,480
...بخصوص وقتكِ الحرّ غدًا

202
00:12:24,470 --> 00:12:26,280
لِمَ لا ترافقيني؟

203
00:12:42,200 --> 00:12:43,860
.أظنّه بالقرب من هنا

204
00:12:44,180 --> 00:12:47,370
.نعم، إنّه هنا. هذه الزّاوية

205
00:12:47,370 --> 00:12:49,680
.مذهل! إنّها الزّاوية نفسها

206
00:12:49,680 --> 00:12:51,210
...أ-أجل

207
00:12:51,210 --> 00:12:53,460
.عليّ إعادة مشاهدة الفيلم عند عودتي

208
00:12:54,300 --> 00:12:56,020
!هذا مثير

209
00:12:54,500 --> 00:12:56,020
.يبدو أنّكِ مُستمعة

210
00:12:56,020 --> 00:12:58,210
!نعم! أنا متأثّرة كثيرًا

211
00:12:58,660 --> 00:13:00,210
.يُسعدني ذلك

212
00:13:01,370 --> 00:13:02,250
.آريما

213
00:13:02,250 --> 00:13:03,550
ما-ماذا؟

214
00:13:03,900 --> 00:13:08,180
سأذهب لشراء مشروبات، هلاّ انتظرتِ هنا؟

215
00:13:08,400 --> 00:13:11,100
.حـ-حسنًا، سأكون بانتظارك

216
00:13:13,660 --> 00:13:16,100
.فاجأني البارحة

217
00:13:16,750 --> 00:13:18,590
...بخصوص وقتكِ الحرّ غدًا

218
00:13:18,590 --> 00:13:20,430
لِمَ لا ترافقيني؟

219
00:13:23,650 --> 00:13:25,410
...أنا، في الواقع

220
00:13:25,410 --> 00:13:27,470
.يمكننا الذّهاب في رحلة مقدّسة

221
00:13:28,870 --> 00:13:32,170
"مكان أحداث فيلم "فورورد ورلد
.بالقرب من هنا

222
00:13:32,790 --> 00:13:36,090
!معك حقّ! ذهبوا إلى أوكيناوا

223
00:13:36,090 --> 00:13:37,850
.أفزعني قليلاً

224
00:13:38,470 --> 00:13:44,370
حسنًا، أودّ الذّهاب! لكن هل تمانع
لو سألتُ ريو والبقيّة أوّلاً؟

225
00:13:44,370 --> 00:13:46,510
.كلاّ... لا مشكلة

226
00:13:47,420 --> 00:13:50,220
،عندما أخبرتهنّ أنّي سأتجوّل مع تامارو-كن

227
00:13:50,220 --> 00:13:53,720
.تحمّست ساتّشان ورو-تشان لحدٍّ غريب

228
00:13:53,720 --> 00:13:56,250
!حقًّا؟ أحسنت يا تامارو

229
00:13:56,250 --> 00:13:57,940
!ما أروع الشّباب

230
00:13:59,240 --> 00:14:03,280
.لكن كانت ملامح ريو غريبة

231
00:14:06,910 --> 00:14:10,030
أأنتِ قلقة بشأن إيتشيكا وتامارو-كن؟

232
00:14:10,370 --> 00:14:14,460
.البتّة"... قد تكون مجرّد كذبة"

233
00:14:14,460 --> 00:14:17,120
.صحيح، فأنتِ صديقتها العزيزة

234
00:14:17,340 --> 00:14:21,000
.أخبرني تامارو أنّه لم يكنّ أيّة مشاعر لها حقًّا

235
00:14:21,930 --> 00:14:25,360
.لعلّ شيئًا ما تغيّر داخله

236
00:14:25,360 --> 00:14:26,340
.ربّما

237
00:14:26,590 --> 00:14:31,720
لكنّ دعوتها لرحلة مهووسي أنمي
.بادرة ظريفة حقًّا من تامارو-كن

238
00:14:31,720 --> 00:14:34,560
.روري، تتصرّفين كأمّ مُجدّدًا

239
00:14:35,040 --> 00:14:40,360
،لستُ قلقةً بصفتي صديقتها العزيزة فحسب
.بل كشقيقة أحدهم الصّغيرة أيضًا

240
00:14:42,720 --> 00:14:45,470
.أشعر بالعطش الشّديد لسببٍ ما

241
00:14:52,650 --> 00:14:53,450
!آريما

242
00:14:58,730 --> 00:15:01,020
!الصّبيّ تامارو

243
00:15:02,670 --> 00:15:05,060
.ماذا؟ كان أنت وحسب يا ماسودا-سان

244
00:15:05,060 --> 00:15:07,550
ماذا؟! لِمَ؟! أهنالك عيبٌ بي؟

245
00:15:07,790 --> 00:15:11,140
—كلاّ، ظننتُ شخصًا يتقرّب من آريما لا أكثـ

246
00:15:11,140 --> 00:15:11,850
ماذا؟

247
00:15:15,450 --> 00:15:19,810
فهمت، ظننت أحدًا يتقرّب من
.إيتشيكا-تشان، فأتيت لإنقاذها

248
00:15:19,810 --> 00:15:21,760
!يا الشّهامة، تعجبني

249
00:15:21,760 --> 00:15:23,440
...أنت تؤلمني

250
00:15:24,170 --> 00:15:27,190
.سأذهب لالتقاط صور لبقيّة الصّغار إذًا

251
00:15:27,640 --> 00:15:33,130
.يا للعجب، فهمت الآن. لدى رْيو منافس حقًّا

252
00:15:33,130 --> 00:15:35,470
.ما أروع الشّباب

253
00:15:35,470 --> 00:15:37,980
.منعش وحلوٌ مرّ مثل الحوامض

254
00:15:37,980 --> 00:15:39,600
...لم يرد التّدخّل

255
00:15:39,600 --> 00:15:41,320
...إذًا، تامارو-كن

256
00:15:42,420 --> 00:15:43,400
...ذراعي

257
00:15:45,400 --> 00:15:48,000
.آسف، لم أقصد سحب ذراعك

258
00:15:48,000 --> 00:15:49,500
.لا بأس، أنا بخير

259
00:15:49,930 --> 00:15:51,810
.هـ-هاكِ الشّاي

260
00:15:51,810 --> 00:15:54,490
شكرًا لك، كم كلّف؟

261
00:15:54,490 --> 00:15:57,480
لا تهتمّي، بما أنّي في الثّانويّة

262
00:15:57,480 --> 00:15:59,680
.فهذا أقصى ما أستطيع تقديمه لك

263
00:16:02,060 --> 00:16:05,450
.آريما، شكرًا لك على مرافقتي اليوم

264
00:16:05,450 --> 00:16:08,440
.أنا بالمقابل، شكرًا لك على دعوتي

265
00:16:08,730 --> 00:16:11,340
!تضاعف الحماس بما أنّنا ذهبنا معًا

266
00:16:13,140 --> 00:16:14,570
ما هذا؟

267
00:16:17,730 --> 00:16:20,520
.أ-أتوقّع أنّه وقت الالتقاء بالجميع

268
00:16:20,520 --> 00:16:22,020
.أجل، لنذهب

269
00:16:25,300 --> 00:16:26,420
...لا أدري ما الأمر بالضّبط، لكن

270
00:16:26,420 --> 00:16:30,930
أكان تامارو-كن يُظهر ملامح كهذه قبلاً؟

271
00:16:34,830 --> 00:16:37,360
.لا أصدّق أنّ رحلتنا المدرسيّة انتهت بهذه السّرعة

272
00:16:37,360 --> 00:16:40,220
.ربّما يمكننا العودة في رحلة تخرّجنا

273
00:16:40,620 --> 00:16:44,770
أخبريني يا ريو، أيكره رْيو-سان الحلويّات؟

274
00:16:44,770 --> 00:16:47,310
.أظنّه يحبّها

275
00:16:47,660 --> 00:16:49,630
.هكذا إذًا، حمدًا لله

276
00:16:49,630 --> 00:16:52,230
أهذه هديّة لأخي؟

277
00:16:52,230 --> 00:16:54,950
.نعم، اشتريتُ له حلويّات بنهاية المطاف

278
00:16:55,360 --> 00:16:57,700
أهذا اعتياديّ جدًّا؟

279
00:16:59,020 --> 00:17:01,690
.ربما كان عليّ اختيار شيء غير الطّعام

280
00:17:01,690 --> 00:17:04,410
أنا متأكّدة أنّ أخي سيُسرّ باستلام

281
00:17:04,410 --> 00:17:06,340
.أيّ هديّة فكّرتِ مليًّا في اختيارها له

282
00:17:06,340 --> 00:17:07,530
ماذا؟

283
00:17:07,530 --> 00:17:09,460
.سنصعد الطّائرة قريبًا

284
00:17:09,460 --> 00:17:11,370
.حاضر

285
00:17:15,180 --> 00:17:16,840
...إذًا يا إيتشيكا-سان

286
00:17:17,100 --> 00:17:18,320
أيّ فيلم نشاهد؟

287
00:17:18,320 --> 00:17:20,030
.لا تقل ذلك

288
00:17:20,030 --> 00:17:20,580
ماذا؟

289
00:17:20,580 --> 00:17:24,340
.أتيتُ لتسليمك الهديّة من رحلي المدرسيّة فقط

290
00:17:25,340 --> 00:17:30,240
أثارت رغبتك في أن نلتقي عند
.صالة السّينما غرابتي نوعًا ما

291
00:17:30,240 --> 00:17:32,840
ألديكِ مخطّطات لبعد هذا يا ترى؟

292
00:17:32,840 --> 00:17:36,740
.كلاّ للأسف، لكنّي سأرجع للبيت بأيّ حال

293
00:17:36,740 --> 00:17:39,960
...انتظري رجاءً يا إيتشيكا-سان، بما أنّنا هنا

294
00:17:42,870 --> 00:17:43,710
إيتشيكا-سان؟

295
00:17:45,010 --> 00:17:47,930
.فهمت، دع يدي وحسب

296
00:17:51,220 --> 00:17:54,350
هل تريد أن تسحبك الشّرطة؟

297
00:17:54,760 --> 00:17:57,590
.آسف، تماديتُ قليلاً

298
00:17:58,430 --> 00:18:01,180
إذًا، أيّ فيلم تريدين مشاهدته؟

299
00:18:03,470 --> 00:18:05,880
.حسنًا، لنشاهد ما تريده أنت

300
00:18:05,880 --> 00:18:07,230
أنا؟

301
00:18:07,230 --> 00:18:12,440
.تعرف ما يعجبني، قدر ما يغيظني ذلك

302
00:18:13,660 --> 00:18:16,400
.لديّ معلومات داخليّة

303
00:18:16,710 --> 00:18:21,280
.لكن أظنّ أنّي لا أعرف شيئًا عمَّ يعجبك

304
00:18:23,490 --> 00:18:26,080
—ما يعجبني هو أنت يا إيتشيكـ

305
00:18:25,360 --> 00:18:27,800
.يكفي من ذلك، اختر وحسب

306
00:18:30,090 --> 00:18:32,720
.سأذهب لشراء مشروبات إذًا

307
00:18:32,720 --> 00:18:33,420
.حسنًا

308
00:18:34,550 --> 00:18:39,050
.ذكّرني بتامارو-كن عندما أمسك بذراعي قبل قليل

309
00:18:39,900 --> 00:18:43,260
استطعتُ الإحساس بأنّه كان متوتّرًا
.وليس معتادًا على الأمر

310
00:18:43,670 --> 00:18:47,390
.لا بدّ أنّ فتيان المرحلة الثّانويّة هكذا

311
00:18:47,980 --> 00:18:51,090
كان مختلفًا تمامًا عن رْيو-سان
.البالغ الواثق بنفسه

312
00:18:51,730 --> 00:18:54,770
...أمسك بيدي... لحظة

313
00:18:55,530 --> 00:18:57,620
لِمَ أقارنهما؟

314
00:18:57,620 --> 00:19:00,330
...هذا فظيع، يا إلهي

315
00:19:00,330 --> 00:19:01,280
.إيتشيكا-سان

316
00:19:01,280 --> 00:19:02,390
نـ-نعم؟

317
00:19:02,390 --> 00:19:03,840
.أعتذر على الإطالة

318
00:19:03,840 --> 00:19:06,640
اشتريتُ فشارًا، لِمَ لا نتشاركه؟

319
00:19:06,640 --> 00:19:08,290
!يبدو ذلك رائعًا

320
00:19:08,290 --> 00:19:10,300
!لم أتناول الفشار لوقتٍ طويل

321
00:19:10,300 --> 00:19:14,320
يا إلهي... أودّ أكله لكنّ
يداي مشغولتان كما ترين

322
00:19:14,320 --> 00:19:16,730
هلاّ أطعمتِني؟

323
00:19:16,730 --> 00:19:19,240
.سأحملها مكانك إذًا

324
00:19:20,020 --> 00:19:21,670
.سأضعها هنا وحسب

325
00:19:22,460 --> 00:19:27,190
،تشتدّ البرودة في هذه الصّالة أيضًا
.لذا اشتريتُ لحافًا

326
00:19:27,190 --> 00:19:28,090
.هاكِ

327
00:19:28,090 --> 00:19:29,830
.شكرًا جزيلاً

328
00:19:29,830 --> 00:19:32,790
،لزوّارنا بتذاكر المسرح رقم 3

329
00:19:32,790 --> 00:19:34,930
.توجّهوا لمدخل المسرح رجاءً

330
00:19:33,140 --> 00:19:34,570
.علينا الذّهاب

331
00:19:39,100 --> 00:19:41,140
إذًا... أهذا هو؟

332
00:19:42,030 --> 00:19:42,870
.إيتشيكا-سان

333
00:19:43,570 --> 00:19:46,890
.ستكون رؤيتكِ أفضل في هذا المقعد، خذيه

334
00:19:46,890 --> 00:19:48,540
.حسنًا

335
00:19:50,810 --> 00:19:53,140
.هاكِ شرابك والفشار

336
00:19:53,140 --> 00:19:54,300
.شكرًا

337
00:19:56,250 --> 00:19:59,880
.بادل مكانه معي لأنّ هناك شبّانًا يجلسون هناك

338
00:20:02,120 --> 00:20:03,260
.إنّه معتاد على هذا

339
00:20:03,580 --> 00:20:07,510
من الجليّ بوضوح أنّ رْيو-سان
.معتاد على المواعيد

340
00:20:07,510 --> 00:20:10,270
.لا عجب، فهو رْيو-سان

341
00:20:10,660 --> 00:20:14,540
،لا بد أنّه قد أتى لهذه الصّالة قبلاً
.ورفقة امرأة أخرى

342
00:20:19,500 --> 00:20:22,820
.ربّما كان عليّ ارتداء ثياب ناضجة أكثر

343
00:20:23,980 --> 00:20:28,790
أريد سؤالها عمَّ حصل مع تامارو
.في رحلتها المدرسيّة، لكن لا أقدر

344
00:20:29,930 --> 00:20:33,500
قضت إيتشيكا-سان وتامارو
!وقتهما الحرّ معًا؟

345
00:20:33,500 --> 00:20:36,830
.نعم، كانا سويًّا في المربى المائيّ أيضًا

346
00:20:36,830 --> 00:20:42,730
،اسمعني، أخبرتك بكلّ ما أعرفه
.يمكنك سؤالها عن البقيّة بنفسك

347
00:20:43,880 --> 00:20:48,010
أأخاف أنّ شيئًا ما قد دار بينهما؟

348
00:20:49,180 --> 00:20:50,400
.يا لسخافتي

349
00:21:44,500 --> 00:21:45,360
إيتشيكا-سان؟

350
00:21:45,940 --> 00:21:48,240
.ماذا؟ أجل، صحيح

351
00:21:48,600 --> 00:21:52,280
.كانت البطلة ناضجةً وجميلة

352
00:21:54,280 --> 00:21:59,420
.لا يبدو أنّكِ بخير، سأرافقك للمنزل اليوم

353
00:21:59,420 --> 00:22:00,890
...ماذا؟ كلاّ

354
00:22:00,890 --> 00:22:03,040
...لستُ متوعّكة حقًّا

355
00:22:05,930 --> 00:22:06,990
رْيو-سان؟

356
00:22:06,990 --> 00:22:08,570
نعم؟ ما الأمر؟

357
00:22:08,570 --> 00:22:11,010
ألا تشعر بخير؟

358
00:22:11,010 --> 00:22:13,080
.كلاّ، أنا بخير

359
00:22:13,080 --> 00:22:14,960
...حسنًا

360
00:22:17,770 --> 00:22:20,610
.ملامحه جادّة، هذا جديدٌ عليّ

361
00:23:36,000 --> 00:23:38,460
."الحلقة القادمة: "حبّ غير متبادل