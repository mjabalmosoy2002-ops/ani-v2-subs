1
00:00:07,420 --> 00:00:08,980
.أريد إثارةً في حياتي

2
00:00:09,220 --> 00:00:11,700
ما خطبكِ فجأةً يا ساتسوكي؟

3
00:00:11,700 --> 00:00:14,500
،عيد الميلاد المجيد يقترب

4
00:00:14,500 --> 00:00:17,260
.ولدينا رحلتنا المدرسيّة بعده

5
00:00:17,260 --> 00:00:18,740
،أريد الاستفادة من شبابي

6
00:00:18,740 --> 00:00:20,120
!أريد الانغماس فيه

7
00:00:20,120 --> 00:00:23,180
.أي أنّكِ تريدين حبيبًا ببساطة

8
00:00:23,180 --> 00:00:25,200
.حسنًا، نوعًا ما

9
00:00:25,200 --> 00:00:28,320
ما صنفكِ المفضّل يا ساتسوكي؟

10
00:00:28,320 --> 00:00:29,750
...حسنًا

11
00:00:29,750 --> 00:00:31,970
.أفضّل شابًّا قريبًا من عمري

12
00:00:31,970 --> 00:00:36,010
كما يُستحسن أن يكون رياضيًّا
وأطول قامةً منّي

13
00:00:36,010 --> 00:00:39,450
ومظهره جميلٌ وهو يحمل مشروبًا
فوّارًا في أوائل الصّيف

14
00:00:39,450 --> 00:00:42,560
وقصير الشّعر وودودٌ جدًّا
وذو شعبيّة بين الجميع

15
00:00:42,560 --> 00:00:46,400
ومحطّ أنظار الكلّ في بطولة
.المدرسة الرّياضيّة

16
00:00:46,400 --> 00:00:48,920
.حسنًا، فهمنا، فلترجعي للواقع الآن

17
00:00:48,920 --> 00:00:51,780
.يا إلهي، لا أستطيع التّوقّف بعدما أبدأ

18
00:00:51,780 --> 00:00:53,170
ما صنفكِ أنت يا روري؟

19
00:00:52,510 --> 00:00:55,840
.تهوى الفتيات الكلام في هذه المواضيع حقًّا

20
00:00:53,170 --> 00:00:56,240
.أنا؟ أفضّل الرّجال المحترمين الأكبر سنًّا

21
00:00:56,240 --> 00:01:00,980
،"تحيّته "صباحكِ سعيدٌ يا آنسة
.ويجيد إعداد الشّاي

22
00:01:00,980 --> 00:01:03,410
.يٌستحسن أن يكون طويل القامة

23
00:01:03,410 --> 00:01:08,630
،لا يرتدي نظّارات قراءة في العادة
،لكن عندما ترينها عليه

24
00:01:08,630 --> 00:01:11,030
"—يحمرّ ويقول "كم هذا محرج

25
00:01:11,030 --> 00:01:13,280
.حسنًا، فهمناكِ أيضًا يا رو-تشان

26
00:01:13,280 --> 00:01:14,670
ماذا عن صنفكِ يا إيتشيكا؟

27
00:01:17,240 --> 00:01:19,730
.شـ-شخص طبيعيّ ربّما

28
00:01:19,730 --> 00:01:21,910
.ماذا؟ حدّدي أكثر

29
00:01:21,910 --> 00:01:23,640
.نريد تفاصيل

30
00:01:24,620 --> 00:01:27,140
...شخص... ليس طويل القامة

31
00:01:27,140 --> 00:01:30,000
لا يبرع لذاك الحدّ في الدّراسة أو الرّياضة

32
00:01:30,000 --> 00:01:32,180
.وبنفس عمري أو أصغر

33
00:01:32,180 --> 00:01:34,540
،ولا يكون شعره فاتح اللّون

34
00:01:34,540 --> 00:01:37,400
.ولا يتقرّب بإلحاح

35
00:01:37,400 --> 00:01:40,150
.وقليل الكلام أيضًا

36
00:01:41,180 --> 00:01:43,050
ما-ماذا يا ريو؟

37
00:01:43,050 --> 00:01:44,330
.لا شيء

38
00:01:44,330 --> 00:01:48,990
.أعرف شخصًا يناقض كلّ ما قلتِه لا أكثر

39
00:01:48,990 --> 00:01:51,540
ماذا؟ حقًّا؟

40
00:01:52,480 --> 00:01:55,590
الصّنف الّذي وصفتِه

41
00:01:55,590 --> 00:01:57,850
.يشبه تامارو لحدٍّ كبير

42
00:01:58,220 --> 00:02:01,290
أيمكن أنّك مُغرمة بتامارو-كن يا إيتشيكا؟

43
00:02:00,490 --> 00:02:03,250
.لا، لا، كانت تلك مصادفةً وحسب

44
00:02:03,250 --> 00:02:05,140
.سيسمعكنّ تامارو-كن

45
00:02:05,140 --> 00:02:07,000
.لا تقلقي، يبدو أنّه نائم

46
00:02:07,470 --> 00:02:08,640
.لا، لا، لا

47
00:02:08,640 --> 00:02:10,300
.لننهِ هذا الكلام

48
00:02:10,300 --> 00:02:13,400
ماذا عنكِ أنت يا ريو؟ ما صنفك المفضّل؟

49
00:02:13,400 --> 00:02:14,420
.مصارعو السّومو

50
00:02:17,150 --> 00:02:20,440
.يتحلّون بالقوّة، وأظنّهم مُنفتحي التّفكير

51
00:02:20,440 --> 00:02:22,150
...ربّما

52
00:02:22,150 --> 00:02:24,660
.كان ذلك آخر ما توقّعت سماعه

53
00:02:25,220 --> 00:02:28,510
.أتابع بطولة كيوشو أيضًا

54
00:04:09,790 --> 00:04:11,160
.أجل، لا بأس به

55
00:04:12,500 --> 00:04:15,210
أيمكنكِ إضافة هذه لوثائق اجتماع الغد؟

56
00:04:18,400 --> 00:04:21,070
ما الخطب؟ أهنالك شيءٌ على وجهي؟

57
00:04:21,070 --> 00:04:24,780
!ماذا؟ كلاّ، البتّة

58
00:04:24,780 --> 00:04:26,280
.سنُلحقه ببقيّة الوثائق إذًا

59
00:04:27,920 --> 00:04:31,450
ألا تعتقدان أنّ نائب رئيس القسم
يبدو مختلفًا مؤخّرًا؟

60
00:04:32,620 --> 00:04:35,960
.ليس بحدّته المعتادة

61
00:04:35,960 --> 00:04:37,280
.أجل، تمامًا

62
00:04:37,280 --> 00:04:40,730
.لا بدّ أنّ للأمر علاقة بحياته الخاصّة

63
00:04:40,730 --> 00:04:43,220
.قد تكون حبيبته

64
00:04:43,440 --> 00:04:46,110
ماذا؟ لديه حبيبة؟

65
00:04:46,110 --> 00:04:49,350
أهو من الصّنف الّذي يختار فتاة واحدة بالأصل؟

66
00:04:50,910 --> 00:04:53,850
...تلك الشّائعات صحيحة إذًا على الأرجح

67
00:04:54,410 --> 00:04:57,280
لنكتفِ بالاستمتاع بالنّظر لنائب"
"رئيس القسم أماكوسا

68
00:04:57,280 --> 00:05:00,010
.هي قاعدة الموظّفات غير المنطوقة هنا

69
00:05:00,010 --> 00:05:01,610
.بالفعل

70
00:05:01,610 --> 00:05:05,290
.إنّه أشبه بأحد المشاهير لي

71
00:05:05,290 --> 00:05:07,720
.أشاهده فقط

72
00:05:07,720 --> 00:05:11,210
.كنتِ تحاولين لفت انتباهه بشدّة قبل عام

73
00:05:11,210 --> 00:05:14,290
كنتُ قد التحقت بالشّركة للتّوّ
!ولم أكن أعلم

74
00:05:14,290 --> 00:05:18,380
.صحيح، تلك هي صورته

75
00:05:18,380 --> 00:05:22,000
.لكن وصلتني معلومة

76
00:05:22,000 --> 00:05:22,700
ماذا؟

77
00:05:24,420 --> 00:05:25,670
تريدان أن تسمعا؟

78
00:05:29,690 --> 00:05:33,850
.يا إلهي، أريد العودة للمنزل وحسب
أين ذهب؟

79
00:05:35,930 --> 00:05:37,940
—ها هو، نائب رئيس القسم أماكوسا

80
00:05:37,940 --> 00:05:39,300
.نعم، صحيح

81
00:05:39,730 --> 00:05:41,260
يتكلّم على الهاتف؟

82
00:05:41,260 --> 00:05:43,310
إيتشيكا-سان، كيف هو زكامك؟

83
00:05:46,920 --> 00:05:49,930
إيتشيكا-سان؟ هذا اسمها الأوّل، صحيح؟

84
00:05:49,930 --> 00:05:51,660
أهي حبيبته يا ترى؟

85
00:05:51,660 --> 00:05:53,580
.حمدًا لله

86
00:05:53,580 --> 00:05:57,290
.لكن لا يزال الزّكام منتشرًا، انتبهي لصحّتك

87
00:05:57,290 --> 00:06:01,790
.يتكلّم باحترام... لا بدّ أنّها تكبره سنًّا. هذا مُفاجئ

88
00:06:01,790 --> 00:06:04,990
بالمناسبة، كيف كان اختبارك الأخير في المدرسة؟

89
00:06:05,630 --> 00:06:10,060
!مدرسة؟ اختبار؟ أي أنّها معلّمة

90
00:06:10,490 --> 00:06:14,560
عجبًا يا ريو-كن، لم تكن تنصت لمعلّمتك؟

91
00:06:14,560 --> 00:06:16,300
حقًّا؟

92
00:06:17,380 --> 00:06:18,160
ماذا؟

93
00:06:18,160 --> 00:06:21,060
...صنعتُه بنفسي، لذا

94
00:06:21,570 --> 00:06:24,620
حتّى أنّه يصنع أشياء لها؟

95
00:06:25,450 --> 00:06:27,850
...صنعتُ هذا لكِ، إذا أردتِ

96
00:06:27,850 --> 00:06:31,100
.لا أريده، أشعر ببعض الإرهاق

97
00:06:32,780 --> 00:06:34,150
حقًّا؟

98
00:06:34,150 --> 00:06:37,540
...حسنًا، إلى اللّقاء. لحظة يا إيتشيكا-سان

99
00:06:39,350 --> 00:06:40,670
.أحبّك

100
00:06:42,790 --> 00:06:44,940
!ماذا؟ صدقًا؟

101
00:06:44,940 --> 00:06:48,170
قال نائب رئيس القسم ذلك بابتسامة؟

102
00:06:48,470 --> 00:06:53,080
.قالها بملامح صبيّ في الإعداديّة مسحور بمحبوبته

103
00:06:53,080 --> 00:06:55,460
.شعرتُ بالإحراج مكانه

104
00:06:55,460 --> 00:06:58,560
!لا يمكنني تصوّره كذلك أبدًا

105
00:06:58,830 --> 00:07:01,740
.شعرتُ بالغيرة بمجرّد المشاهدة

106
00:07:02,910 --> 00:07:05,820
.أريد أن أشعر بذاك الشّعور، وأكون مصدره

107
00:07:05,820 --> 00:07:09,480
.بدوتِ كامرأة غارقة في الكلام في حانة

108
00:07:10,490 --> 00:07:12,140
.تكاد استراحة الغداء تنتهي

109
00:07:12,140 --> 00:07:12,820
ماذا؟

110
00:07:12,820 --> 00:07:14,680
.لنحاول تجاوز ما بقي الظّهيرة

111
00:07:14,680 --> 00:07:16,950
.سأمرّ بدورة المياه

112
00:07:16,950 --> 00:07:18,700
.وأنا

113
00:07:21,350 --> 00:07:24,380
معلّمة... أكبر سنًّا؟

114
00:07:40,410 --> 00:07:41,970
لأين ستحملينها؟

115
00:07:41,970 --> 00:07:43,640
.شـ-شكرًا

116
00:07:44,730 --> 00:07:46,860
.للمخزن وراء الصّالة الرّياضيّة

117
00:07:52,850 --> 00:07:54,610
.آسفة يا تامارو-كن

118
00:07:54,610 --> 00:07:57,600
.كنت متّجهًا للمنزل، لكن توقّفت لمساعدتي

119
00:07:57,600 --> 00:07:58,940
.لا بأس، لا أمانع

120
00:07:59,730 --> 00:08:04,370
ما يُدعى هذا الشّيء؟ "يودل" أو ما شابه؟

121
00:08:05,230 --> 00:08:06,400
تقصد الحامل؟

122
00:08:06,400 --> 00:08:07,310
.صحيح

123
00:08:07,920 --> 00:08:10,150
أأنتِ في نادي الفنّ؟

124
00:08:10,150 --> 00:08:14,960
نعم، لكنّي لا أعرف في أيّ نادٍ أنت. ما هو؟

125
00:08:14,960 --> 00:08:16,150
.نادي الأدب

126
00:08:16,150 --> 00:08:17,840
.يلائمك

127
00:08:17,840 --> 00:08:20,060
.يعتبرني النّاس شخصيةً نادرة

128
00:08:21,340 --> 00:08:22,980
.أي أنّهم يكادون لا يرونك هناك

129
00:08:23,230 --> 00:08:25,980
.أنا متراخيةٌ مع ناديّ أيضًا

130
00:08:27,920 --> 00:08:29,690
هل ترسمين شيئًا الآن؟

131
00:08:29,690 --> 00:08:33,150
.أرسم لوحةً زيتيّة لقطّةٍ حاليًّا

132
00:08:33,150 --> 00:08:35,850
.أرسم قطّة جدّي

133
00:08:35,850 --> 00:08:37,820
.اسمها آنّا

134
00:08:38,270 --> 00:08:41,500
.تبدو لئيمة، لكنّ ذلك ما يجعلها ظريفة

135
00:08:42,790 --> 00:08:46,670
.حسنًا، انتهينا. أعنتني كثيرًا يا تامارو-كن

136
00:08:47,440 --> 00:08:49,620
.عليّ إعادة المفتاح لغرفة المعلّمين

137
00:08:51,100 --> 00:08:52,300
...بالمناسبة

138
00:08:53,550 --> 00:08:54,800
...أتذكرين

139
00:08:55,470 --> 00:08:58,050
عندما التقينا في تلك اللّيلة مصادفةً
.عند متجر التّموينات

140
00:08:58,050 --> 00:09:01,180
.أجل، كانت مصادفة حقًّا

141
00:09:02,020 --> 00:09:05,810
أكان تواجدك مع أخي أماكوسا
محض مصادفة أيضًا؟

142
00:09:07,840 --> 00:09:08,690
...ذلك

143
00:09:09,210 --> 00:09:13,430
كنتُ قد تأخّرت في العودة للبيت
من النّادي عندما اتّصل بي ريو-سان

144
00:09:13,430 --> 00:09:16,950
،وقال أنّه سيرافقني للبيت
.فاتّفقتُ على اللّقاء معه هناك

145
00:09:16,950 --> 00:09:18,700
.تبدوان مقرّبين

146
00:09:20,320 --> 00:09:21,630
،بالتّفكير في الأمر الآن

147
00:09:21,630 --> 00:09:24,000
لا يتحدّث المرء مع الأخ الأكبر
لصديق على الهاتف

148
00:09:24,000 --> 00:09:26,680
!وينتظره ليتمكّن من مرافقته للبيت

149
00:09:26,680 --> 00:09:29,050
!صحيح، لا يفعل أحدٌ ذلك! لا أحد

150
00:09:29,720 --> 00:09:31,840
.كلاّ، لسنا مقرّبين حقًّا

151
00:09:32,140 --> 00:09:37,090
ألم تقولي قبلاً أنّكِ لا تواعدين أخا أماكوسا؟

152
00:09:37,090 --> 00:09:38,970
!أجل! لا أواعده

153
00:09:38,970 --> 00:09:40,220
...إذًا

154
00:09:42,480 --> 00:09:46,070
ما شعورك تّجاه... أخي أماكوسا؟

155
00:09:49,910 --> 00:09:53,720
...لا أظنّ بإمكاني وصفه بكلمة واحدة

156
00:09:54,910 --> 00:09:56,070
!انسي كلامي

157
00:09:56,070 --> 00:09:56,850
ماذا؟

158
00:09:57,320 --> 00:10:01,060
.آسف، انسي ما قلتُه، سأرجع للبيت. إلى اللّقاء

159
00:10:02,830 --> 00:10:03,950
—تامارو-كن

160
00:10:07,260 --> 00:10:08,650
...رحل

161
00:10:09,210 --> 00:10:12,010
ما شعوري حياله؟

162
00:10:12,880 --> 00:10:15,550
...مُتعب ومثير للاشمئزاز

163
00:10:15,910 --> 00:10:18,430
...لكنّي لا أكرهه

164
00:10:18,880 --> 00:10:19,980
.كما أظنّ

165
00:10:21,390 --> 00:10:23,330
كيف سألتُها ذلك؟

166
00:10:23,740 --> 00:10:27,250
لكن ما كان معنى ملامحها المتضايقة؟

167
00:10:30,400 --> 00:10:33,660
.بعد إمعان النّظر، يشبه الشّقيقان بعضهما حقًّا

168
00:10:34,650 --> 00:10:35,450
...مرحبًا

169
00:10:35,450 --> 00:10:36,480
.مرحبًا

170
00:10:36,990 --> 00:10:38,600
...أخبرني يا تامارو

171
00:10:38,600 --> 00:10:39,400
ماذا؟

172
00:10:39,400 --> 00:10:42,090
هل قابلتَ أخي قبل اختبارنا؟

173
00:10:42,710 --> 00:10:44,450
.قابلتُه عند متجر التّموينات

174
00:10:44,450 --> 00:10:46,200
أكانت إيتشيكا برفقته أيضًا؟

175
00:10:47,160 --> 00:10:48,470
كيف عرفتِ؟

176
00:10:48,470 --> 00:10:52,460
.تكلّم أخي عن لقاء شخص يُدعى تامارو

177
00:10:52,460 --> 00:10:53,890
.هكذا إذًا

178
00:10:54,810 --> 00:10:56,900
...بالمناسبة، لديّ ما أريد سؤالك عنه

179
00:10:57,340 --> 00:11:01,110
هل أخوكِ وآريما مقرّبان؟

180
00:11:01,110 --> 00:11:03,330
...لستُ واثقة من اعتبارهما مقرّبين حقًّا

181
00:11:03,330 --> 00:11:06,350
لكن ما هنالك هو أنّ أخي مغرمٌ
.بإيتشيكا الآن لا أكثر

182
00:11:10,530 --> 00:11:12,490
.هكذا إذًا

183
00:11:12,490 --> 00:11:13,250
.نعم

184
00:11:13,250 --> 00:11:15,360
أمسموح لك إخبار النّاس بذلك؟

185
00:11:15,360 --> 00:11:19,780
وأين المشكلة؟ لا يبدو أنّ أخي
.يحاول إخفاء الأمر أصلاً

186
00:11:19,780 --> 00:11:22,490
.إنّه يتقرّب إليها بإلحاح أمام العامّة

187
00:11:22,490 --> 00:11:24,670
.هكذا الوضع إذًا

188
00:11:24,670 --> 00:11:27,330
.أظنّ أنّي فهمت مُجمل الصّورة

189
00:11:27,990 --> 00:11:30,830
وما موقفك؟

190
00:11:32,510 --> 00:11:35,870
.سيكون الأمر مسلّيًّا لو تواعدا

191
00:11:35,870 --> 00:11:37,630
مسلّيًّا؟

192
00:11:37,630 --> 00:11:40,660
أخبرني، أتحبّ إيتشيكا أيضًا؟

193
00:11:41,660 --> 00:11:43,100
ماذا؟ لِمَ تظنّين ذلك؟

194
00:11:43,900 --> 00:11:45,170
.مجرّد تخمين

195
00:11:45,740 --> 00:11:47,810
.فأنت تتحدّث كثيرًا مع إيتشيكا مؤخّرًا

196
00:11:47,810 --> 00:11:49,900
...الأمر ليس هكذا حقًّا

197
00:11:51,360 --> 00:11:52,550
.لا بأس إذًا

198
00:11:53,410 --> 00:11:56,510
.إذا كنت تحبّها حقًّا، فكنتُ سأحذرك

199
00:11:56,510 --> 00:11:57,980
ماذا؟ تحذريني؟

200
00:11:57,980 --> 00:12:02,640
.أخي إنسانٌ خطر من أكثر من ناحية، فخذ حذرك

201
00:12:03,290 --> 00:12:05,160
.لكن إذا لم يكن الأمر كذلك، فانس كلامي

202
00:12:07,150 --> 00:12:08,900
.سأرجع للنّادي

203
00:12:08,900 --> 00:12:09,820
.إلى اللّقاء

204
00:12:13,990 --> 00:12:16,170
إنسانٌ خطر؟

205
00:12:16,470 --> 00:12:20,460
.آمل أن تبقى على وفاق مع إيتشيكا-سان كزميلٍ لها

206
00:12:20,460 --> 00:12:25,210
.بدا أنّه يحاول رسم حدود لي بالفعل

207
00:12:25,210 --> 00:12:27,270
أتحبّ إيتشيكا أيضًا؟

208
00:12:31,580 --> 00:12:35,020
ما شعوري حيال آريما حقًّا؟

209
00:12:53,430 --> 00:12:56,700
.ريو، أحتاج مساعدتكِ في أمر

210
00:12:56,700 --> 00:12:58,230
.لن أقرضك مالاً

211
00:12:58,230 --> 00:13:01,870
ليس ذلك، عيد الميلاد يقترب، أليس كذلك؟

212
00:13:01,870 --> 00:13:04,050
.بلى، صحيح

213
00:13:04,690 --> 00:13:05,860
...فكنتُ أفكّر

214
00:13:07,580 --> 00:13:11,640
...بإعطاء ريو-سان هديّة

215
00:13:12,360 --> 00:13:14,800
،لكن لا فكرة لديّ عمَّ أهديه أبدًا

216
00:13:14,800 --> 00:13:17,010
.فأردتُ استشارتك

217
00:13:17,670 --> 00:13:20,520
فهمت، متى أصبحتما مقرّبين لهذا الحدّ؟

218
00:13:20,740 --> 00:13:22,950
!لسنا مقرّبين! على الإطلاق! توقّفي عن ذلك

219
00:13:24,060 --> 00:13:27,000
أردتُ شكره على زيارتي عندما كنتُ مريضة

220
00:13:27,000 --> 00:13:29,780
،وعلى إعداده لدليل الدّراسة

221
00:13:29,780 --> 00:13:31,960
...لكنّ عيد الميلاد قريبٌ أيضًا

222
00:13:35,620 --> 00:13:37,160
لِمَ تبتسمين؟

223
00:13:37,160 --> 00:13:41,290
لا سبب، أنت تعرفين أنّ هناك
.شيئًا واحدًا فقط يريده أخي

224
00:13:41,730 --> 00:13:43,550
.أنتِ كهديّة

225
00:13:43,550 --> 00:13:44,380
.مرفوض

226
00:13:44,380 --> 00:13:45,510
.حسنًا

227
00:13:45,510 --> 00:13:48,150
لنذهب لتفقّد بعض الهدايا
.بعد انتهائنا هنا إذًا

228
00:13:48,150 --> 00:13:50,630
.يمكننا مناقشة ميزانيّتك أثناء بحثنا

229
00:13:50,630 --> 00:13:52,960
.حسنًا، شكرًا لك

230
00:14:03,530 --> 00:14:05,130
.شكرًا جزيلاً

231
00:14:06,610 --> 00:14:09,510
.شكرًا لكِ يا ريو، ساعدتِني كثيرًا

232
00:14:10,220 --> 00:14:12,530
كيف أهديها لريو-سان؟

233
00:14:13,080 --> 00:14:14,070
...عليكِ

234
00:14:19,000 --> 00:14:19,880
نعم؟

235
00:14:20,890 --> 00:14:21,670
ما الأمر؟

236
00:14:22,880 --> 00:14:25,840
أردتُ استشارتك في أمر، أأنتِ متفرّغة؟

237
00:14:25,840 --> 00:14:29,340
أتريد أن أساعدك في اختيار هديّة
عيد ميلاد لإيتشيكا يا ترى؟

238
00:14:29,340 --> 00:14:31,600
ماذا؟ كيف عرفتِ؟

239
00:14:31,840 --> 00:14:33,170
.مجرّد تخمين

240
00:14:33,170 --> 00:14:36,750
.بدأ أخي وإيتشيكا يفكّران بالشّكل نفسه

241
00:14:37,370 --> 00:14:41,150
،لكنّك كنت تهديدها الكثير من الهدايا

242
00:14:41,150 --> 00:14:42,930
فلمَ تحتاج استشارةً الآن؟

243
00:14:43,680 --> 00:14:47,660
،أرسلتُ لها دمىً محشوّة وأزهارًا حتّى الآن

244
00:14:47,660 --> 00:14:50,740
.لكن بدا لي أنّني الوحيد المستمتع بإهدائها إيّاها

245
00:14:50,740 --> 00:14:51,540
ماذا؟

246
00:14:52,290 --> 00:14:53,950
تدرك ذلك لتوّك؟

247
00:14:53,950 --> 00:14:55,810
.كلاّ، كنت مدركًا لذلك

248
00:14:55,810 --> 00:14:59,830
لكنّي كنت أجد ردّة فعل إيتشيكا-سان
،على هداياي الخادمة للذّات ظريفة

249
00:14:59,830 --> 00:15:01,470
.فواصلت إرسالها

250
00:15:02,590 --> 00:15:05,060
أنت فظيع، ما مصابك؟

251
00:15:05,060 --> 00:15:09,890
لكنّي أردت أن أهديها شيئًا
.سيسعدها في عيد الميلاد

252
00:15:09,890 --> 00:15:12,300
...تبدو ظريفةً عند تضايقها، لكن

253
00:15:12,530 --> 00:15:14,710
.سأجلب لك السّلسلة الفرعيّة غدًا

254
00:15:14,710 --> 00:15:17,210
.حقًّا؟ شكرًا لك

255
00:15:17,210 --> 00:15:19,730
.أريد رؤية ملامحها السّعيدة

256
00:15:25,690 --> 00:15:26,760
.حسنًا

257
00:15:27,420 --> 00:15:29,910
أرسلتُ لهاتفك مُلخّصًا للأشياء

258
00:15:29,910 --> 00:15:31,760
.الّتي ستريدها إيتشيكا بلا شكّ

259
00:15:31,760 --> 00:15:34,310
.أنا متأكّدة أنّها ستسعد إذا أهديتها إيّاها

260
00:15:34,310 --> 00:15:35,200
.شكرًا

261
00:15:35,750 --> 00:15:36,830
.أنت مدين لي

262
00:15:37,870 --> 00:15:41,140
.أنتِ ماكرة من نواحٍ عدّة

263
00:15:44,140 --> 00:15:46,920
هذا ما تريد إيتشيكا-سان إذًا؟

264
00:15:46,920 --> 00:15:48,250
...ما تبقّى

265
00:15:50,010 --> 00:15:51,190
...ما تبقّى

266
00:15:51,190 --> 00:15:53,090
.هديّة ريو

267
00:15:53,090 --> 00:15:54,760
ماذا أهديها؟

268
00:15:56,950 --> 00:16:00,140
...اليوم الأخير... لبطولة السّومو

269
00:16:04,350 --> 00:16:05,290
.أماكوسا

270
00:16:06,150 --> 00:16:07,470
.نسيتَ قلمك

271
00:16:08,030 --> 00:16:10,740
.ماتسوشيما، شكرًا لك

272
00:16:16,010 --> 00:16:17,510
!مهلك

273
00:16:17,510 --> 00:16:19,370
ما الّذي يجري يا آريتّي؟

274
00:16:19,370 --> 00:16:21,360
هلاّ امتنعتِ عن مناداتي بهذا؟

275
00:16:21,360 --> 00:16:24,890
.اسمك ماتسوشيما آري، فلقبكِ أريتّي. إنّه ظريف

276
00:16:24,890 --> 00:16:28,210
ذلك جانبًا، لِمَ تنادين رئيس نائب
القسم باسمه الأوّل؟

277
00:16:28,210 --> 00:16:29,800
.لأنّنا بدأنا العمل في الوقت ذاته

278
00:16:29,800 --> 00:16:32,140
لم أكن أعلم! أأنتما مقرّبان؟

279
00:16:32,140 --> 00:16:33,710
،نعمل في قسمين مختلفين

280
00:16:33,710 --> 00:16:36,870
لكنّنا نتبادل أطراف الحديث
.عندما نتقابل في الاجتماعات

281
00:16:36,870 --> 00:16:39,180
ليس لديكِ حبيبٌ الآن، صحيح؟

282
00:16:39,180 --> 00:16:40,860
ما رأيكِ في نائب رئيس القسم؟

283
00:16:40,860 --> 00:16:42,560
.دعيكِ من ذلك

284
00:16:42,560 --> 00:16:44,720
،لم يسبق لي أن نظرتُ له من تلك النّاحية

285
00:16:44,720 --> 00:16:48,720
كما ألا يملك أماكوسا حبيبةً واقعٌ في غرامها الآن؟

286
00:16:48,720 --> 00:16:50,810
.أجل، أظنّني سمعت تلك الشّائعة

287
00:16:50,810 --> 00:16:53,930
.يُقال أنّها معلّمة أكبر سنًّا منه

288
00:16:55,150 --> 00:16:56,650
.حسنًا، لا مشاكل

289
00:16:58,010 --> 00:16:59,670
.شكرًا جزيلاً

290
00:16:59,670 --> 00:17:00,570
.عمل مُوفّق

291
00:17:01,020 --> 00:17:04,460
.أعتذر على جعلك تطيل في العمل معي

292
00:17:04,900 --> 00:17:06,240
.يا نائب رئيس القسم

293
00:17:06,240 --> 00:17:10,180
.تناقَش بعضُنا في الذّهاب للشّرب بعد الانتهاء

294
00:17:10,180 --> 00:17:12,050
ما رأيك بمرافقتنا؟

295
00:17:12,050 --> 00:17:13,670
...ماذا؟ أنا

296
00:17:13,670 --> 00:17:15,680
...ربّما تأخّر الوقت على ذلك اليوم

297
00:17:16,540 --> 00:17:20,090
تعرف أنّه من المستحيل أن يكون
.بلا مواعيد محدّدة لعيد الميلاد

298
00:17:20,090 --> 00:17:24,520
...حسنًا، لا مواعيد لديّ بالفعل... لذا قد

299
00:17:25,770 --> 00:17:26,990
.آسف، إنّه هاتفي

300
00:17:33,930 --> 00:17:37,820
!آسف! طـ-طرأ أمرٌ عاجل
.سأغادر! عمل موفّق جميعًا

301
00:17:39,150 --> 00:17:40,460
أكانت حبيبته؟

302
00:17:40,460 --> 00:17:41,610
.لا بدّ أنّه موعد عاطفيّ

303
00:17:41,610 --> 00:17:43,950
أكانت حبيبته المعلّمة الأكبر سنًّا؟

304
00:17:54,890 --> 00:17:55,870
!إيتشيكا-سان

305
00:17:58,090 --> 00:17:59,540
.آسفٌ على الإطالة

306
00:17:59,540 --> 00:18:01,410
.أعتذر على طلب لقائك فجأةً

307
00:18:01,410 --> 00:18:04,650
.البتّة، كنت قد انتهيت من العمل

308
00:18:05,500 --> 00:18:09,270
ما الأمر إذًا؟ قلتِ أنّ لديكِ
ما تريدين إعطائي إيّاه؟

309
00:18:09,870 --> 00:18:11,150
...حسنًا

310
00:18:11,820 --> 00:18:14,420
أثناء انتظارك، ألم يشتبه على أحد بأنّك

311
00:18:14,420 --> 00:18:19,300
ملاك هبط على الأرض في هذه اللّيلة
المقدّسة، فحاول خطفك؟

312
00:18:19,300 --> 00:18:21,160
!بالطّبع لا

313
00:18:21,530 --> 00:18:25,630
.كنتُ رفقة ريو حتّى اتّصالي بك

314
00:18:25,630 --> 00:18:26,600
ريو؟

315
00:18:26,600 --> 00:18:29,020
...لكن بعدما أجبت

316
00:18:29,020 --> 00:18:32,780
.سأرجع لمشاهدة برامج عيد ميلاد الخاصّة إذًا

317
00:18:32,780 --> 00:18:33,880
.بالتّوفيق

318
00:18:34,500 --> 00:18:35,970
...إنّها

319
00:18:39,090 --> 00:18:39,940
.خذ

320
00:18:40,460 --> 00:18:43,470
،قمتَ بزيارتي في مرضي

321
00:18:43,470 --> 00:18:45,690
...وأعددت لي دليل الدّراسة، لذا

322
00:18:46,250 --> 00:18:47,980
...هـ-هذه

323
00:18:48,880 --> 00:18:52,450
...هديّة عيد ميلاد

324
00:19:00,090 --> 00:19:02,490
أ-أتمانعين لو فتحتُها؟

325
00:19:02,490 --> 00:19:03,980
.تـ-تفضّل

326
00:19:06,870 --> 00:19:09,270
.أنت تعاملها بحذرٍ زائد

327
00:19:09,270 --> 00:19:11,380
.عليّ أن أنتبه من عدم تمزيق شيء

328
00:19:14,630 --> 00:19:16,370
مشبك ربطة عنق؟

329
00:19:17,150 --> 00:19:20,230
...إ-إذا لم يعجبك التّصميم، فيمكنك إلقاؤه

330
00:19:20,230 --> 00:19:20,880
!اسمحي لي

331
00:19:20,880 --> 00:19:22,880
!أيمكنني تركيبه؟

332
00:19:22,880 --> 00:19:27,140
!لا تفتح معطفك ككاشف متحرّش فجأةً

333
00:19:27,140 --> 00:19:28,270
.أفزعتني

334
00:19:38,060 --> 00:19:39,740
.شكرًا جزيلاً

335
00:19:42,450 --> 00:19:43,740
.سأهتمّ به

336
00:19:44,450 --> 00:19:45,900
.سأضعه في مكان مقدّس فورما أرجع

337
00:19:46,360 --> 00:19:48,620
.علّقه على ربطة عنقك وحسب

338
00:19:49,030 --> 00:19:52,170
.إيتشيكا-سان، لديّ ما أهديكِ إيّاه إذًا

339
00:19:52,170 --> 00:19:54,240
.ماذا؟ لا داعٍ

340
00:19:54,240 --> 00:19:56,340
.هذه الهديّة مميّزة

341
00:19:56,340 --> 00:19:57,540
.فلتفتحيها رجاءً

342
00:20:02,340 --> 00:20:03,020
...فو

343
00:20:03,550 --> 00:20:04,470
فو؟

344
00:20:04,990 --> 00:20:09,600
أقراص بلوري للإصدار المحدود لدفعة
!فورورد ورلد" الأولى؟! كيف؟"

345
00:20:09,600 --> 00:20:13,600
معها حمّالة مفاتيح المحلّ الأكريليكيّة
الحصريّة أيضًا... ولتوهو؟

346
00:20:13,600 --> 00:20:16,450
!فقدتُ الأمل فيها لأنّي مُفلسة

347
00:20:16,450 --> 00:20:21,010
!يا إلهي! هذا كثير! أنا... سعيدة

348
00:20:25,600 --> 00:20:27,240
.شكرًا جزيلاً

349
00:20:30,230 --> 00:20:32,090
لِمَ تضحك؟

350
00:20:32,090 --> 00:20:37,160
.آ-آسف، أسعدتِك أكثر ممّا توقّعت

351
00:20:39,390 --> 00:20:43,360
لكن كيف عرفت أنّي أريدها؟

352
00:20:43,360 --> 00:20:45,760
.استشرتُ ريو في الواقع

353
00:20:45,760 --> 00:20:48,940
،طلبتُ نصحها في شراء شيء قد يسعدك

354
00:20:48,940 --> 00:20:50,280
.واقترحت هذه

355
00:20:50,770 --> 00:20:55,270
...ماذا؟ استشرتها فيما أهديك أيضًا

356
00:20:55,270 --> 00:20:56,940
حقًّا؟

357
00:21:00,280 --> 00:21:04,450
من ناحية، من الطّريف جدًّا أنّي كنت من اقترحت

358
00:21:04,450 --> 00:21:06,040
.كلتا الهديتيّن عليهما

359
00:21:06,040 --> 00:21:07,180
.رجعت

360
00:21:08,620 --> 00:21:12,300
أخي؟ ألم يرجع باكرًا؟

361
00:21:14,690 --> 00:21:16,240
...كيف مضى إهداؤك

362
00:21:16,870 --> 00:21:20,380
.مرحبًا، أحضرنا كعكًا

363
00:21:20,380 --> 00:21:22,460
ماذا؟ لِمَ؟

364
00:21:22,460 --> 00:21:27,090
أردنا إقامة حفلة عيد ميلاد سويًّا
نحن الثّلاثة، أتمانعين؟

365
00:21:29,960 --> 00:21:31,690
.لا أمل منكما

366
00:21:32,930 --> 00:21:35,190
!أنتَ طاهٍ بارع يا ريو-سان

367
00:21:40,510 --> 00:21:41,690
.لذيذ

368
00:21:41,690 --> 00:21:44,400
.أليس كذلك؟ يثير الأعصاب نوعًا ما

369
00:21:44,400 --> 00:21:47,190
ما قصدك يثير الأعصاب؟

370
00:21:49,740 --> 00:21:52,960
.بالمناسبة يا ريو، تأكلين دجاجًا كثيرًا بمفردك

371
00:21:52,960 --> 00:21:54,880
.لكنّي كنت أشعر بالضّجر

372
00:21:54,880 --> 00:21:58,390
.هذه مجموعة الحفلات العائليّة، ستبدنين

373
00:21:58,390 --> 00:22:00,960
.لا بأس، سأنحف في النّادي

374
00:22:01,510 --> 00:22:02,980
حقًّا؟

375
00:23:36,030 --> 00:23:38,540
."الحلقة القادمة: "رحلة مقدّسة