1
00:00:21,100 --> 00:00:23,130
.تروقني الأشياء كهذه

2
00:00:24,510 --> 00:00:27,330
.الجميع يرسمون رسومات خاصّة بيوم الفالنتاين

3
00:00:29,500 --> 00:00:31,850
.يا للخدمة الرّائعة

4
00:00:35,460 --> 00:00:38,880
،كنتُ أحاول تهدئة نفسي بالنّظر لبعض الرّسومات

5
00:00:39,390 --> 00:00:43,000
.لكن أظنّ أنّ توتّري ارتفع بالمقابل

6
00:02:21,720 --> 00:02:23,870
...اسمع يا أخي

7
00:02:26,570 --> 00:02:28,710
أعليك الانتظار عند الباب؟

8
00:02:28,710 --> 00:02:30,850
،بالطّبع! أريد الانتظار في الخارج

9
00:02:30,850 --> 00:02:33,780
،لكن سيراني الجيران شخصًا مشبوهًا
!لذا أنتظر هنا فحسب

10
00:02:33,780 --> 00:02:34,890
.حسنًا، حسنًا

11
00:02:35,250 --> 00:02:36,770
.كما يحلو لك

12
00:02:40,930 --> 00:02:43,510
أصبح يبدو كحيوان أليف
.ينتظر عودة مالكه

13
00:02:51,310 --> 00:02:51,920
!مرحبًا

14
00:02:54,660 --> 00:02:56,950
...صـ-صباح الخير

15
00:02:57,570 --> 00:02:59,080
.صباح الخير

16
00:03:00,550 --> 00:03:03,710
.إيتشيكا-سان، تبدين شاحبةً نوعًا ما

17
00:03:03,710 --> 00:03:05,490
.مجرّد قلّة نوم

18
00:03:05,490 --> 00:03:07,240
.تـ-تفضّلي بالدّخول

19
00:03:10,230 --> 00:03:12,290
هل تريدين الجلوس قليلاً؟

20
00:03:12,290 --> 00:03:13,130
.ما من داعٍ

21
00:03:13,130 --> 00:03:15,170
.يمكنكِ الاستلقاء على الأريكة

22
00:03:15,170 --> 00:03:17,170
.أنا بخير حقًّا

23
00:03:18,510 --> 00:03:22,600
...أ-أتيتُ لإعطائك هديّة يوم الفالنتاين فقط

24
00:03:26,030 --> 00:03:28,100
ما وضعيّة اليدين هذه؟

25
00:03:28,100 --> 00:03:30,740
.استعداد لاستسلام الشّوكولاتة

26
00:03:30,740 --> 00:03:33,580
.أنت مزعجٌ لحدّ يبعث الانتعاش

27
00:03:34,280 --> 00:03:37,530
.ما سأهديك إيّاه ليست شوكولاتة

28
00:03:37,530 --> 00:03:40,570
،أمضيتُ بضعة أيام أفكّر فيما أعطيك

29
00:03:40,810 --> 00:03:45,450
وفكّرت أكثر فأكثر، وحلّ يوم الفالنتاين
.قبل أن أدرك حتّى

30
00:03:46,240 --> 00:03:48,640
...أعلم أنّي سأندم على هذا

31
00:03:49,450 --> 00:03:51,960
.لكن أنوي فعله

32
00:03:55,830 --> 00:03:57,590
.هذا ما قرّرتُه

33
00:04:05,130 --> 00:04:08,560
!حسنًا! هذه هديّة الفالنتاين منّي

34
00:04:08,950 --> 00:04:12,250
!حاولتُ تفادي الشّوكولاتة، وهذا ما آلت إليه الأمور

35
00:04:12,860 --> 00:04:15,760
لن أستقبل أيّ أفكار أو تعليقات
!على الأمر بتاتًا

36
00:04:15,760 --> 00:04:17,800
!اعذرني الآن

37
00:04:22,780 --> 00:04:25,070
ماذا؟ هل غادرت إيتشيكا؟

38
00:04:25,070 --> 00:04:26,760
—كنت أنوي مرافقتها للمد

39
00:04:29,560 --> 00:04:31,130
ما الّذي تفعله؟

40
00:04:32,280 --> 00:04:34,000
هل أطاحت بك؟

41
00:04:35,320 --> 00:04:38,050
.بل كان شيئًا مدمّرًا أكثر

42
00:04:39,230 --> 00:04:41,340
،بناءً على ردّة فعلك

43
00:04:41,590 --> 00:04:43,530
.لا بدّ أنّها أسعدتك كثيرًا

44
00:04:43,960 --> 00:04:45,050
.فعلاً

45
00:04:49,450 --> 00:04:50,900
...يا لظرافتها

46
00:04:53,100 --> 00:04:56,350
.سأذهب إذًا، لا تنس إقفال الباب

47
00:04:53,490 --> 00:04:54,900
...يا لظرافتها

48
00:05:00,940 --> 00:05:03,900
،بدت ممانعةً لإعطائي الشّوكولاتة

49
00:05:03,900 --> 00:05:07,850
.فلا بدّ أنّ ماسودا باح بشيءٍ لها

50
00:05:17,920 --> 00:05:21,860
.احتجت لحظةً فقط لتغيير رأيي بالفالنتاين

51
00:05:26,010 --> 00:05:27,800
.آسفة يا ريو

52
00:05:28,010 --> 00:05:30,780
.كان علينا المشي معًا

53
00:05:30,780 --> 00:05:32,010
.لا مشكلة

54
00:05:32,530 --> 00:05:35,290
.بالمناسبة، بدا أخي سعيدًا جدًّا

55
00:05:35,840 --> 00:05:37,810
.كان يتقلّب عند الباب

56
00:05:38,800 --> 00:05:40,840
...هـ-هكذا إذًا

57
00:05:40,840 --> 00:05:42,190
لِمَ تتكلّمين بهذا التّصلّب؟

58
00:05:42,190 --> 00:05:45,290
.سأموت من الإحراج بمجرّد التّفكير بالأمر

59
00:05:45,290 --> 00:05:46,780
.صحيح

60
00:05:46,780 --> 00:05:49,490
.هذه لكِ يا ريو، شوكولاتة الصّديقة العزيزة

61
00:05:49,490 --> 00:05:51,350
.رائع، شكرًا لك

62
00:05:49,490 --> 00:05:52,420
.شخير أمّي عالٍ جدًّا

63
00:05:52,420 --> 00:05:56,880
.أسمعه من الغرفة المجاورة، إنّه مزعج حقًّا

64
00:05:53,740 --> 00:05:55,830
.رو-تشان وساتّشان، هاكما

65
00:05:55,830 --> 00:05:57,380
.رائع، شكرًا لك

66
00:05:57,380 --> 00:05:58,330
!مرحى

67
00:05:57,380 --> 00:05:59,960
.لم أحظ بأيّ نوم البارحة

68
00:06:00,780 --> 00:06:02,430
.وهذه منّي

69
00:06:02,430 --> 00:06:04,970
رائع، تبدو لذيذة! هل صنعتِها بنفسك؟

70
00:06:02,910 --> 00:06:05,420
.يبدو أنّ الفتيات مستمتعات

71
00:06:04,970 --> 00:06:06,040
.وهذه منّي

72
00:06:06,930 --> 00:06:08,280
.التّغليف ظريفٌ جدًّا

73
00:06:06,930 --> 00:06:08,280
.تبدو لذيذة

74
00:06:08,280 --> 00:06:13,720
أليس كذلك؟ شكل الشّوكولاتة
.بالدّاخل ظريفٌ جدًّا أيضًا

75
00:06:13,720 --> 00:06:17,230
فأثار الأمر أعصابي أخيرًا

76
00:06:17,440 --> 00:06:19,220
.وتشاجرنا

77
00:06:22,110 --> 00:06:23,450
ما الّذي تنظر له؟

78
00:06:24,300 --> 00:06:25,190
...لا شيء

79
00:06:25,190 --> 00:06:26,880
.أرى ابتسامةً مخفيّة

80
00:06:26,880 --> 00:06:29,000
.ماذا؟ لا أبتسم

81
00:06:29,000 --> 00:06:29,640
!أرني

82
00:06:29,640 --> 00:06:31,490
!أحمق! ابتعد

83
00:06:31,490 --> 00:06:33,210
تنظر لشيءٍ منحرف، أليس كذلك؟

84
00:06:33,210 --> 00:06:34,990
!كلاّ

85
00:06:34,990 --> 00:06:37,900
!هيّا! فلترني

86
00:06:42,950 --> 00:06:45,500
.أعتذر على طلب مقابلتك في استراحة الغداء

87
00:06:45,770 --> 00:06:48,370
،كنتُ أنوي إعطاءك إيّاها في الفصل

88
00:06:48,370 --> 00:06:50,680
.لكن ظننتُ أنّ الأمر لن يروقك

89
00:06:51,790 --> 00:06:55,470
هذه تعبير عن امتناني لإعارتك
.لي تلك الكتب أيضًا

90
00:06:55,780 --> 00:06:57,350
.آمل أن تقبلها

91
00:06:59,450 --> 00:07:01,590
.إذًا... أراك لاحقًا

92
00:07:01,980 --> 00:07:03,330
.انتظري قليلاً

93
00:07:03,690 --> 00:07:06,670
أيمكن أنّك لا تحبّ الشّوكولاتة؟

94
00:07:06,670 --> 00:07:08,940
.ليس ذلك

95
00:07:10,430 --> 00:07:13,450
تعطيني هذه كصديق... صحيح؟

96
00:07:17,660 --> 00:07:19,510
حقًّا؟

97
00:07:19,510 --> 00:07:23,250
.هذا سرّ، لا تبوحي للآخرين

98
00:07:23,250 --> 00:07:24,250
.حسنًا، حسنًا

99
00:07:24,250 --> 00:07:26,670
.ردّ غير مقنع

100
00:07:26,670 --> 00:07:28,610
.ستبوحين لأحد على الأرجح

101
00:07:28,610 --> 00:07:30,310
.لا تقلقي

102
00:07:30,310 --> 00:07:32,560
...أ-أنا

103
00:07:32,560 --> 00:07:37,140
...لو قلتُ أنّي أريد شيئًا خاصًّا بي وليس إلزاميًّا

104
00:07:37,140 --> 00:07:38,430
فهل ستغضبين؟

105
00:07:38,430 --> 00:07:42,720
...هـ-هل... أتقصد

106
00:07:43,780 --> 00:07:45,060
...ما أعنيه

107
00:07:45,690 --> 00:07:48,450
.أريدكِ أن تواعديني

108
00:07:51,100 --> 00:07:54,070
...أ-أنا... في الواقع

109
00:07:54,440 --> 00:07:59,310
...لم أفكّر بك من تلك النّاحية... لذا

110
00:07:59,310 --> 00:08:01,080
هلاّ بدأتِ إذًا؟

111
00:08:02,050 --> 00:08:03,330
هلاّ أعدتِ التّفكير؟

112
00:08:06,090 --> 00:08:09,380
.يمكنكِ أخذ وقتك للرّدّ، سأنتظر

113
00:08:10,410 --> 00:08:12,840
.سأرجع للفصل الآن

114
00:08:13,310 --> 00:08:15,170
.شكرًا على الشّوكولاتة

115
00:08:30,490 --> 00:08:33,350
متى عليّ أن أعطي أماكوسا الشّوكولاتة؟

116
00:08:33,350 --> 00:08:35,470
.استراحة الغداء تكاد تنتهي

117
00:08:35,470 --> 00:08:38,100
أتسمعيني يا آريتّي؟

118
00:08:39,250 --> 00:08:42,090
.ماذا؟ آسفة، لم أسمعك

119
00:08:42,090 --> 00:08:48,080
قلتُ أنّ نائب رئيس القسم أماكوسا
.لا يقبل شوكولاتة من أحد

120
00:08:48,080 --> 00:08:49,860
ماذا؟ صدقًا؟

121
00:08:49,860 --> 00:08:50,590
.أجل

122
00:08:50,590 --> 00:08:55,780
في العام الفائت، حاولت إحدى الفتيات الجديدات
.إهداءه شوكولاتة ورفض قبولها

123
00:08:55,780 --> 00:08:59,720
وهذا العام، حاولت فتاة أخرى الأمر
،عينه وحصلت على نفس الرّدّ

124
00:08:59,930 --> 00:09:01,570
.فلا بدّ أنّ الشّائعة حقيقيّة

125
00:09:01,570 --> 00:09:03,500
...هـ-هكذا إذًا

126
00:09:03,500 --> 00:09:05,610
أليس مفاجئًا؟

127
00:09:05,610 --> 00:09:10,400
.لطالما اعتقدتُ أنّه يتلقّى الكثير في الفالنتاين

128
00:09:10,400 --> 00:09:12,350
.لعلّه لا يحبّ الشّوكولاتة

129
00:09:12,350 --> 00:09:14,320
.لا أدري حقًّا

130
00:09:14,720 --> 00:09:17,070
لا-لا يقبلها؟

131
00:09:17,070 --> 00:09:19,340
!لم أسمع بهذا قبلاً

132
00:09:20,580 --> 00:09:22,330
...أ-أيمكن أنّكِ يا آريتّي

133
00:09:22,330 --> 00:09:25,600
نويتِ إهداءه شوكولاتة؟

134
00:09:25,600 --> 00:09:28,300
!ماذا؟ مـ-مستحيل

135
00:09:29,340 --> 00:09:30,740
.أجل، بالطّبع لا

136
00:09:30,740 --> 00:09:34,140
...ربما سأرجع هذه الشّوكولاتة للمنزل معي

137
00:09:34,140 --> 00:09:36,860
...ذهبتُ لمائدة الحلويات ذاك اليوم بالمناسبة

138
00:09:37,640 --> 00:09:38,540
!كلاّ

139
00:09:39,660 --> 00:09:42,230
!عقدتُ عزيمتي ذاك اليوم

140
00:09:42,230 --> 00:09:44,450
!لا بأس إذا رفضني، سأعطيه إيّاها

141
00:09:42,380 --> 00:09:44,450
!كانت لذيذةً حقًّا

142
00:09:44,450 --> 00:09:45,530
.حلوى موس الخوخ الّتي تناولتها تحديدًا

143
00:09:44,450 --> 00:09:47,260
!أريد أن يعرف أماكوسا أنّي حاولتُ على الأقلّ

144
00:09:45,530 --> 00:09:46,760
.عليكِ تجربتها بالّتأكيد

145
00:09:46,760 --> 00:09:48,350
.كانت الأطباق فاخرة أيضًا

146
00:09:48,350 --> 00:09:50,540
.زاهيةً وبغاية الجمال

147
00:09:48,860 --> 00:09:53,030
.لحظة، ربما سيقبل شيئًا ليس شوكولاتة

148
00:09:50,540 --> 00:09:55,240
لنذهب سويًّا المرّة القادمة، لا شيء
.أروع من تناول الحلويات

149
00:09:53,550 --> 00:09:55,240
!قد أملك وقتًا إذا ذهبتُ لشراء شيء

150
00:09:55,240 --> 00:09:57,740
!تبًّا! تأخّر الوقت

151
00:09:58,310 --> 00:09:59,160
ماذا؟

152
00:09:59,390 --> 00:10:01,410
!آريتّي، علينا العودة سريعًا

153
00:10:01,410 --> 00:10:03,730
!لا يمكن! لديّ اجتماع

154
00:10:03,730 --> 00:10:05,180
!أسرعي! أسرعي

155
00:10:10,970 --> 00:10:12,920
...لم يتسنّ لي أن أهديه

156
00:10:13,430 --> 00:10:14,930
،فوق الاجتماعات الكثيرة

157
00:10:14,930 --> 00:10:18,010
.كانت لديّ أمور روتينيّة كثيرة عليّ إتمامها

158
00:10:19,530 --> 00:10:24,040
فقدتُ أثر أماكوسا بينما كنت
.أعمل في الدّوام الإضافي أيضًا

159
00:10:24,510 --> 00:10:27,390
.يبدو أنّي انفعلت بلا فائدة هذا الفالنتاين

160
00:10:31,710 --> 00:10:33,650
...ذاك الطّول والأسلوب

161
00:10:34,090 --> 00:10:36,410
أهو... أماكوسا؟

162
00:10:36,900 --> 00:10:38,760
!ا-انتظر

163
00:10:40,930 --> 00:10:42,040
!إنّه يذهب

164
00:10:42,530 --> 00:10:43,590
!أماكوسا

165
00:10:50,080 --> 00:10:52,040
في هذا الوقت بالتّحديد؟

166
00:10:52,590 --> 00:10:54,300
!يا لحماقتي

167
00:10:54,300 --> 00:10:55,190
ماتسوشيما؟

168
00:10:56,270 --> 00:10:58,150
ما الخطب؟ أأنتِ بخير؟

169
00:11:00,170 --> 00:11:01,550
.سآتي لك هناك

170
00:11:02,220 --> 00:11:03,160
!ا-انتظر

171
00:11:04,720 --> 00:11:06,540
.تـ-تعال هنا

172
00:11:07,100 --> 00:11:08,530
.سينتهي الأمر سريعًا

173
00:11:14,460 --> 00:11:17,030
.هذه شوكولاتة يوم الفالنتاين

174
00:11:17,030 --> 00:11:18,630
.أردتُ إعطاءك إيّاها بشدّة

175
00:11:19,050 --> 00:11:21,910
،سمعتُ أنّك لا تقبل الشّوكولاتة

176
00:11:22,230 --> 00:11:25,090
...ففكّرتُ بإهدائك شيئًا آخرًا، لكن

177
00:11:25,090 --> 00:11:28,160
،آسفة، لم يكن لديّ وقت
.فلم أستطع تحضير شيء

178
00:11:28,490 --> 00:11:32,040
...وأردتُ إهداءك إيّاها ولو رفضتها

179
00:11:32,470 --> 00:11:35,230
.لكن لم أستطع مقابلتك اليوم البتّة

180
00:11:35,230 --> 00:11:39,800
.والآن حصل هذا... لا أستطيع ترتيب أفكاري

181
00:11:44,740 --> 00:11:48,130
.شكرًا على ركضك لتهديني هذه

182
00:11:52,060 --> 00:11:55,560
سيصل القطار المتوجّه إلى شيبويا وشينجوكو
.على السّكّة الثّانية قريبًا

183
00:11:55,890 --> 00:11:59,320
.التزموا البقاء وراء الخطّ الأصفر لسلامتكم

184
00:12:09,260 --> 00:12:11,980
.أريدك أن تواعديني

185
00:12:12,600 --> 00:12:14,370
هلاّ بدأتِ إذًا؟

186
00:12:14,620 --> 00:12:16,150
هلاّ أعدتِ التّفكير؟

187
00:12:19,450 --> 00:12:21,340
ماذا أفعل؟

188
00:12:35,820 --> 00:12:37,270
.المعذرة

189
00:12:39,310 --> 00:12:41,340
.آسفةٌ على مقاطعة نشاطكم

190
00:12:41,340 --> 00:12:43,620
.اسمي أماكوسا

191
00:12:45,360 --> 00:12:49,080
أودّ محادثة تامارو قليلاً، أيمكنني؟

192
00:12:49,490 --> 00:12:51,190
...حسنًا

193
00:12:51,190 --> 00:12:53,520
...سمعتها يا تامارو-كن

194
00:12:53,520 --> 00:12:55,760
أيمكنني الذّهاب قليلاً أيّها الرّئيس؟

195
00:12:55,760 --> 00:12:57,320
.أ-أجل

196
00:13:07,260 --> 00:13:09,220
!لا بدّ من وجود شيء وراء هذا

197
00:13:09,220 --> 00:13:11,060
.هنالك ما يجري

198
00:13:11,300 --> 00:13:12,950
هل ستطلب مواعدته؟

199
00:13:12,950 --> 00:13:14,380
.لعلّهما يتشاجران

200
00:13:17,180 --> 00:13:19,820
!أشعر بالفضول

201
00:13:28,310 --> 00:13:29,610
ألن تجلس؟

202
00:13:29,610 --> 00:13:31,330
.ما من داعٍ

203
00:13:31,670 --> 00:13:32,860
.سأقف

204
00:13:32,860 --> 00:13:33,910
.حسنًا

205
00:13:39,450 --> 00:13:43,710
حال إيتشيكا غريبٌ منذ استراحة
.الغداء يوم الفالنتاين

206
00:13:45,290 --> 00:13:49,920
،حتّى لو سألتُها ما إن جرى شيء
.تتفادى الموضوع وترفض إخباري

207
00:13:51,100 --> 00:13:53,600
.فظننتُ أنّك قد تعرف شيئًا

208
00:13:55,760 --> 00:13:57,770
،أعرف

209
00:13:58,320 --> 00:14:00,020
.أنا السّبب بالأحرى

210
00:14:00,870 --> 00:14:03,010
.فقد طلبتُ مواعدتها

211
00:14:04,130 --> 00:14:05,120
.كما ظننت

212
00:14:05,820 --> 00:14:06,730
...هل

213
00:14:06,730 --> 00:14:09,440
استدعيتِني إلى هنا لأنّك اكتشفتِ
أنّ ذلك ما حصل؟

214
00:14:09,440 --> 00:14:10,480
.نوعًا ما

215
00:14:14,610 --> 00:14:17,540
.قلتَ أنّك لم تشعر بذاك الشّكل قبلاً

216
00:14:18,690 --> 00:14:21,160
!لم أفهم شعوري حقًّا آنذاك

217
00:14:21,690 --> 00:14:23,000
...لكن الآن

218
00:14:28,230 --> 00:14:31,240
.أعرف طبيعة مشاعري

219
00:14:32,710 --> 00:14:33,680
.فطلبتُ مواعدتها

220
00:14:35,580 --> 00:14:36,690
.هكذا إذًا

221
00:14:39,120 --> 00:14:41,230
.أخبريني يا أماكوسا

222
00:14:41,720 --> 00:14:45,310
هل سألتني عن ذلك لأنّكِ قلقة على آريما؟

223
00:14:45,930 --> 00:14:47,490
صحيح، لِمَ؟

224
00:14:47,820 --> 00:14:49,550
ما الّذي تلمّح له؟

225
00:14:49,550 --> 00:14:53,120
،سأتكلّم بصراحة إذًا. من وجهة نظري

226
00:14:53,120 --> 00:14:55,170
.أنتِ متطفّلة يا أماكوسا

227
00:14:56,920 --> 00:15:00,480
ماذا؟ كنتُ قلقةً لأنّ إيتشيكا
.مختلفة عن العادة فقط

228
00:15:02,080 --> 00:15:05,830
...دائمًا ما تخبرني بكلّ شيء، لكن هذه المرّة

229
00:15:05,830 --> 00:15:06,940
...لعلّكِ

230
00:15:08,690 --> 00:15:09,950
وحيدة في الواقع، صحيح؟

231
00:15:26,940 --> 00:15:31,150
.طلب مواعدتي آريما لا يخصّك بشيء

232
00:15:31,740 --> 00:15:32,530
...لا

233
00:15:34,470 --> 00:15:35,910
يخصّني؟

234
00:15:38,990 --> 00:15:41,910
.أجل... معك حقّ

235
00:15:43,080 --> 00:15:46,300
،أيّ ما تقرّر إيتشيكا فعله يعود لها

236
00:15:46,300 --> 00:15:48,550
.فالأمر لا يخصّني

237
00:15:50,650 --> 00:15:56,020
ربما يكفي أن تكوني متواجدة بجوارها
.متى طلبت مساعدتك

238
00:15:56,020 --> 00:15:59,530
.أنت صريح لحدّ مفاجئ يا تامارو

239
00:16:00,430 --> 00:16:01,900
.ليس بقدرك

240
00:16:03,040 --> 00:16:06,870
.أي ستصبح منافس أخي

241
00:16:06,870 --> 00:16:07,720
.أجل

242
00:16:16,140 --> 00:16:19,690
حقًّا؟ أتظنّ أنّك تقدر بالفعل؟

243
00:16:21,180 --> 00:16:24,620
.أشعر بثقتي تتداعى، فتوقّفي

244
00:16:32,430 --> 00:16:33,290
إيتشيكا-سان؟

245
00:16:34,220 --> 00:16:37,220
...آسفة، أنا

246
00:16:37,220 --> 00:16:40,260
.كنّا نتكلّم عن درس الرّياضة الّذي ذكرتِه بالأمس

247
00:16:41,080 --> 00:16:43,660
كنتِ تلعبين كرة السّلّة اليوم، صحيح؟

248
00:16:43,660 --> 00:16:47,680
.أجل، لعبتُ في فريق مختلف عن ريو اليوم

249
00:16:47,680 --> 00:16:50,070
...ولم أستطع مجاراتها البتّة

250
00:16:52,370 --> 00:16:54,400
.عمتَ مساءً إذًا

251
00:17:03,520 --> 00:17:08,670
.تامارو-كن لطيفٌ ورائع، وأظنّه شخصًا صالحًا

252
00:17:09,140 --> 00:17:14,370
كما أنّنا سنتمكّن من الكلام عن الأشياء
.الّتي نتشارك إعجابها، وحتّى التّفاهات

253
00:17:14,370 --> 00:17:16,780
.ولا أمقته بالطّبع

254
00:17:17,790 --> 00:17:21,530
.أشعر بسرور بصراحة لطلبه مواعدتي

255
00:17:22,200 --> 00:17:26,410
.لكن... لا أظن أنّي أحبّه من تلك النّاحية

256
00:17:28,300 --> 00:17:31,990
أذلك لأنّي أعتبره كصديق في داخلي؟

257
00:17:35,760 --> 00:17:40,400
...أم... هل الشّخص الّذي أحبّه

258
00:17:45,290 --> 00:17:47,160
أتترصّدني مُجدّدًا؟

259
00:17:47,160 --> 00:17:51,340
بدا صوتكِ متغيّرًا على الهاتف
...خلال الأيّام الفائتة

260
00:17:51,340 --> 00:17:53,110
.فشعرتُ بالقلق وأتيتُ لتفقّد أمورك

261
00:17:53,110 --> 00:17:57,860
ولو، هلاّ امتنعت عن انتظاري بجوار المدرسة؟

262
00:17:57,860 --> 00:18:01,690
.آسف، تملّكني القلق ولم أستطع ضبط نفسي

263
00:18:02,860 --> 00:18:04,600
أهناك ما يضايقك؟

264
00:18:05,210 --> 00:18:07,180
.سيسرّني الاستماع لك

265
00:18:07,870 --> 00:18:09,310
الاستماع؟

266
00:18:09,820 --> 00:18:16,060
أتساءل لو طلبت إحدى الفتيات اللّواتي
يعتبرهنّ صديقات مواعدته؟

267
00:18:17,260 --> 00:18:21,220
.لا... لا أريد أن أعرف

268
00:18:21,790 --> 00:18:23,540
.كلاّ، أنا بخير

269
00:18:23,770 --> 00:18:26,090
.أقدّر قلقك

270
00:18:26,090 --> 00:18:31,540
.يسهل عليكِ التّعامل مع ما يقلقك إذا أفصحتِ عنه

271
00:18:31,540 --> 00:18:35,080
.وقد يكون أمرًا أستطيع إفادتك به

272
00:18:35,820 --> 00:18:37,720
.أنا بخير حقًّا

273
00:18:37,940 --> 00:18:38,470
—لكن

274
00:18:38,470 --> 00:18:39,470
!رْيو-سان

275
00:18:40,310 --> 00:18:42,310
هلاّ توقّفت؟

276
00:18:42,310 --> 00:18:44,420
،هنالك ما يشغلني بالفعل

277
00:18:44,420 --> 00:18:46,680
لكن ألم تستوعب أنّي لا أريد الكلام؟

278
00:18:47,740 --> 00:18:49,350
!أنت هكذا دومًا

279
00:18:50,030 --> 00:18:53,720
.تتجاهل شعوري، وكلّ شيء ينصبّ لطرف واحد

280
00:18:54,520 --> 00:18:55,610
...كما

281
00:18:56,110 --> 00:18:59,880
.هذه مشكلتي، فلا تخصّك يا رْيو-سان

282
00:19:02,550 --> 00:19:04,780
.لا أستطيع قبول ذلك

283
00:19:04,780 --> 00:19:08,300
!لذا قلتُ أنّه من طرف واحد

284
00:19:08,910 --> 00:19:12,770
،من الصّحيح أنّي لا أستمع كثيرًا لآرائك

285
00:19:14,040 --> 00:19:16,550
!لكن دعيني أقلق عليكِ على الأقلّ

286
00:19:17,840 --> 00:19:19,890
.كلاّ، هذا ظاهرٌ فقط

287
00:19:20,770 --> 00:19:23,780
.أريد أن تخصّني مشاكلك أيضًا

288
00:19:27,090 --> 00:19:30,780
لِمَ أنت... أنانيّ لهذا الحدّ؟

289
00:19:31,940 --> 00:19:34,840
.لأنّي أحبّك يا إيتشيكا-سان

290
00:19:40,300 --> 00:19:43,450
.أنت لحوح كبائع منزليّ

291
00:19:43,990 --> 00:19:46,250
.تشبيهكِ في محلّه كالعادة

292
00:19:48,030 --> 00:19:50,500
.آسفة، قسوتُ قليلاً

293
00:19:50,970 --> 00:19:53,880
.أظهرتُ قسوةً بدوري

294
00:19:54,540 --> 00:19:57,100
لكن أتمنّى أن تفهمي

295
00:19:57,890 --> 00:19:59,130
.أنّي لا أكذب أو أمزح

296
00:20:00,790 --> 00:20:05,510
،هذه مشكلةٌ عليّ حلّها بنفسي

297
00:20:05,960 --> 00:20:08,330
لذا هلاّ راقبت وانتظرت فحسب؟

298
00:20:14,130 --> 00:20:14,730
.حسنًا

299
00:20:26,410 --> 00:20:30,000
هلاّ... أبعدت يدك؟

300
00:20:31,080 --> 00:20:33,460
!لا أستطيع، قوّة الحبّ المغناطيسيّة قويّة جدًّا

301
00:20:42,500 --> 00:20:46,550
...سبب عدم استطاعتي التّقدّم مع تامارو-كن

302
00:20:46,850 --> 00:20:49,220
.يعود له بالفعل

303
00:20:52,380 --> 00:20:56,400
ينظر للأمور من منظوره فقط وأنانيّ
.ومبهرج لحدٍّ مزعج

304
00:20:57,070 --> 00:21:00,970
.إنّه غير منطقيّ، ولا يراعي الآخرين

305
00:21:00,970 --> 00:21:03,860
...يضيف درجةً لكلّ ما يفعله

306
00:21:04,400 --> 00:21:08,620
.ويحاول تبرير كلّ شيءٍ بالحبّ

307
00:21:09,300 --> 00:21:11,120
...نحن متباعدان سنًّا

308
00:21:13,290 --> 00:21:15,120
...وهو بالغ سيّئ

309
00:21:15,440 --> 00:21:17,380
...أعتقد كلّ ذلك بالفعل

310
00:21:19,980 --> 00:21:24,810
،"لكن متى فكّرت بكلمة "حُبّ
.لا أفكّر إلاّ به

311
00:21:25,440 --> 00:21:27,740
.أهنالك خطبٌ ما؟ أراك توقّفتِ

312
00:21:28,370 --> 00:21:29,820
.لا شيء

313
00:21:32,060 --> 00:21:34,090
.لا يمكنني أن أقع في حبّه مع ذلك

314
00:21:34,560 --> 00:21:38,920
...أعرف أنّ تامارو-كن يناسبني أكثر منطقيًّا، لكن

315
00:21:39,910 --> 00:21:42,070
.يا لحماقتي

316
00:21:42,540 --> 00:21:43,770
.صدقًا

317
00:21:46,850 --> 00:21:50,670
سيكون من الفظاظة أن أبقي
.تامارو-كن ينتظر هكذا

318
00:21:51,770 --> 00:21:54,260
.عليّ إخباره بشعوري

319
00:21:55,790 --> 00:22:00,030
فقد أخبرني بما يشعر به بصدق
.وهو ينظر في عينيّ

320
00:23:36,060 --> 00:23:38,450
."الحلقة القادمة: "إجابتي