1
00:00:05,520 --> 00:00:11,610
هذا هو ملِكُ العالم السّفلي ساتون، أحد
الآلهة الّذين كانوا على وشك الانقراض

2
00:00:11,610 --> 00:00:14,530
كانَ قد انغمسَ في إجراء أبحاث حول الخلود

3
00:00:14,530 --> 00:00:18,410
وأزهقَ أرواح الكثير من شعبه

4
00:00:18,410 --> 00:00:21,200
كان يؤمن بأنّ هناك طرف خيط يقوده للخلود

5
00:00:21,200 --> 00:00:25,620
،في حقيقة إنجاب الكائنات الحيّة أطفالاً لإطالة أعمارهم

6
00:00:25,620 --> 00:00:27,250
،ولهذا اتّخذ لنفسه زوجة بشريّة

7
00:00:27,250 --> 00:00:29,670
فأنجبت منه ثلاثة أطفال

8
00:00:30,750 --> 00:00:36,010
وكان الابن الأكبر، ديسها، رجلاً
،خارقاً ورثَ قِوى أبيه

9
00:00:36,010 --> 00:00:39,300
بينما ورثَ ابنه الثّاني، ديسبا، قليلاً من قوّته فقط

10
00:00:39,300 --> 00:00:41,560
وكان كائناً بشريّاً ضعيفاً

11
00:00:43,020 --> 00:00:44,810
،بينما ابنه الثّالث، أوكين

12
00:00:44,810 --> 00:00:47,270
،تمتّعَ بقدرة جسديّة عظيمة

13
00:00:47,270 --> 00:00:50,440
لكنّه لم يرِث أيّ جزء من القوى الخارقة

14
00:00:52,150 --> 00:00:53,530
...مع الوقت

15
00:00:57,570 --> 00:01:01,540
،هُزِمَ ساتون القاسي على يدِ أبنائه الثّلاثة

16
00:01:01,540 --> 00:01:04,160
وعمَّ السّلام في المملكة

17
00:01:06,710 --> 00:01:08,170
...لكن حينئذ

18
00:01:19,930 --> 00:01:26,440
،عندما بلغَ أوكين الخامسة والعشرين من العمر
نهضَتْ قوّةُ الخلود داخله

19
00:01:26,440 --> 00:01:31,520
!أخي، لا أريد أن أخسر طبيعتي

20
00:01:31,520 --> 00:01:36,150
!ساعدني! ساعدني أرجوك

21
00:01:38,360 --> 00:01:39,910
...لكن

22
00:02:03,890 --> 00:02:06,680
...وهكذا أُسِرَ أوكين

23
00:02:09,940 --> 00:02:12,610
وأصبح مُجرماً من مُجرمي العالم السّفلي

24
00:02:34,340 --> 00:02:44,720
الآن هناك شخص يحبس دموعه

25
00:02:44,720 --> 00:02:50,850
انفض عنك القوّة التي مصدرها الحقد والكراهيّة

26
00:02:50,850 --> 00:02:53,860
بالتأكيد، لا يمكنك أن تسمع

27
00:02:53,860 --> 00:02:59,780
لكنّ البطل الآن لا يحتاج للقوّة

28
00:02:59,780 --> 00:03:02,700
حرّر نفسك

29
00:03:02,700 --> 00:03:08,080
راقب هاتين اليدين الصّغيرتين

30
00:03:08,080 --> 00:03:13,710
كلّ شيء وقعتُ في حبّه

31
00:03:13,710 --> 00:03:19,630
واللّعنة التي حلّت عليّ أيضاً

32
00:03:19,630 --> 00:03:25,760
كلّ مشاعر الوقوع في الحبّ

33
00:03:25,760 --> 00:03:31,730
تمدّني بنور كافٍ لحمايتها

34
00:03:31,730 --> 00:03:37,940
انفض عنك القوّة التي مصدرها الحقد والكراهيّة

35
00:03:37,940 --> 00:03:40,940
بالتأكيد، لا يمكنك أن تسمع

36
00:03:40,940 --> 00:03:46,780
لكنّ البطل الآن لا يحتاج للقوّة

37
00:03:46,780 --> 00:03:49,790
حرّر نفسك

38
00:03:49,790 --> 00:03:54,790
"تدنو الظّلال وتسأل "ما أنت؟

39
00:03:53,210 --> 00:03:57,340
"تصنيف الملوك"

40
00:03:57,800 --> 00:04:00,800
"الحلقة 17: لعنة الخلود"

41
00:04:01,050 --> 00:04:03,720
ربحتُ ذلك السّباق بفارق كبير

42
00:04:04,760 --> 00:04:08,350
لا تختلق الأعذار. ما زال أمامك الكثير لتتعلّمه يا بوجّي

43
00:04:11,770 --> 00:04:14,350
!هذا ليس عدلاً يا بوجّي

44
00:04:20,360 --> 00:04:22,110
!ثمّة شخص مُلقى هناك

45
00:04:26,450 --> 00:04:28,870
...إنّه

46
00:04:28,870 --> 00:04:31,540
الرّجل الّذي أنقذَك من قبل...

47
00:04:34,040 --> 00:04:37,670
يبدو لا يزال على قيد الحياة، لكن ماذا حلَّ به؟

48
00:04:37,670 --> 00:04:41,170
حسناً، أيّاً يكن، لنأخذه إلى المرأة العجوز

49
00:04:48,510 --> 00:04:50,640
تعال إليّ يا أوكين

50
00:05:07,410 --> 00:05:09,070
!كسّرَ عِظامه؟

51
00:05:09,070 --> 00:05:10,280
!هذه مُشكلة

52
00:05:13,700 --> 00:05:14,790
!تبّاً

53
00:05:14,790 --> 00:05:16,620
!شيراسامبي

54
00:05:25,220 --> 00:05:26,800
!لا أستطيع الحركة

55
00:05:30,970 --> 00:05:32,850
!...أوكين

56
00:05:36,600 --> 00:05:38,520
!اسحب بقوّة أكبر يا بوجّي

57
00:05:42,650 --> 00:05:45,490
هل أنت بخير؟ ماذا حدث؟

58
00:05:49,200 --> 00:05:52,160
والأهمّ، ما الّذي يجري هنا؟

59
00:05:52,160 --> 00:05:55,580
كان هناك وحوش سحريّة ومجرمون من العالم
السّفلي يعيثون فساداً

60
00:05:55,580 --> 00:05:57,960
هل اعتدوا عليك أيضاً؟

61
00:05:59,500 --> 00:06:02,710
بوجّي، ألا يستطيع هذا الرّجل التكلّم أيضاً؟

62
00:06:04,250 --> 00:06:05,960
!ماذا؟

63
00:06:05,960 --> 00:06:11,890
بوجّي-ساما، ينبغي أن تهرب من هنا

64
00:06:11,890 --> 00:06:13,680
عمّاذا تتكلّم؟

65
00:06:15,270 --> 00:06:19,020
يسير كلّ شيء وفقما تتمنّاه ميرانجو-ساما

66
00:06:20,810 --> 00:06:26,360
...تريد أن تموت هيلينغ-ساما و

67
00:06:26,360 --> 00:06:28,780
...تسقط المملكة...

68
00:06:30,660 --> 00:06:33,370
لماذا تريد ذلك؟

69
00:06:33,370 --> 00:06:38,000
...والد بوجّي-ساما، بوسّو-ساما

70
00:06:38,000 --> 00:06:42,380
قد عاد إلى الحياة باستخدام جسد دايدا-ساما

71
00:06:42,380 --> 00:06:44,380
!عاد إلى الحياة؟

72
00:06:44,380 --> 00:06:47,670
...كلّ هذا لتحقيق حلم ميرانجو-ساما

73
00:06:47,670 --> 00:06:49,590
حلم؟

74
00:06:49,590 --> 00:06:54,600
...جُلَّ ما تريده هو البقاء بجانب بوسّو-ساما

75
00:06:54,600 --> 00:06:56,680
أن تكون مع بوسّو-ساما مرتاح البال

76
00:06:56,680 --> 00:07:00,020
وتخوض معه رحلة أخرى بمفردهما

77
00:07:00,940 --> 00:07:02,860
ألِهذا يحدث هذا؟

78
00:07:02,860 --> 00:07:07,530
هذا شيء ثمين بالنسبة لميرانجو-ساما

79
00:07:07,530 --> 00:07:10,150
،سامحني يا بوجّي-ساما

80
00:07:10,150 --> 00:07:15,160
لكن لا أستطيع مُعارضة رغبتها

81
00:07:15,160 --> 00:07:18,080
!ولهذا تحاول أن تقتل المرأة العجوز؟

82
00:07:18,080 --> 00:07:21,370
أنا مَدين لميرانجو-ساما بالكثير

83
00:07:21,370 --> 00:07:23,130
!من يأبه لذلك؟

84
00:07:23,130 --> 00:07:24,670
...في هذه الحالة

85
00:07:28,130 --> 00:07:31,680
أنا مُضطرٌّ لمواجهتك يا بوجّي-ساما...

86
00:07:46,730 --> 00:07:52,030
بوجّي-ساما، ماذا فعلتَ بالضبط؟

87
00:07:52,030 --> 00:07:56,030
لقد تغيّرَ بوجّي. أصبح أقوى بشكل لا يُصدَّق

88
00:07:56,030 --> 00:08:00,830
تجاوزَ كثيراً من الصِّعاب وطلبَ من ديسبا
من العالم السّفلي أن يدرّبه

89
00:08:00,830 --> 00:08:02,540
!لا تستهِن ببوجّي

90
00:08:02,540 --> 00:08:04,250
...ديسبا

91
00:08:04,250 --> 00:08:05,920
أحقّاً هذا؟

92
00:08:07,210 --> 00:08:10,380
يمكنني الشّعور بثقتك بنفسك الآن

93
00:08:10,380 --> 00:08:13,010
قوّة الإيمان بنفسك

94
00:08:13,010 --> 00:08:14,550
،وأيضاً

95
00:08:14,550 --> 00:08:18,430
التقيتَ بشخصٍ يجعلك تؤمن بنفسك

96
00:08:22,020 --> 00:08:24,900
يا له من أمر رائع

97
00:08:24,900 --> 00:08:27,770
لديّ شخص كهذا أيضاً

98
00:08:27,770 --> 00:08:32,990
اذهب الآن... اسلك الدرب الّذي تؤمن به

99
00:08:34,910 --> 00:08:36,320
...بوجّي

100
00:08:41,290 --> 00:08:48,000
أجل يا بوجّي-ساما. تحمّلتَ الكثير من الأحزان بمفردك

101
00:08:48,790 --> 00:08:54,170
استمدتُ كثيراً من الشّجاعة منك

102
00:08:58,510 --> 00:09:03,680
والآن قد أمسيتَ أقوى بكثير

103
00:09:04,980 --> 00:09:09,440
يمكنك أن تكون أمل هذه المملكة

104
00:09:14,240 --> 00:09:17,360
...بوجّي-ساما، أرجوك

105
00:09:17,360 --> 00:09:24,040
...احتضنهم جميعاً، بمن في ذلك ميرانجو-ساما، وأنقذهم

106
00:09:24,750 --> 00:09:26,540
...لم

107
00:09:26,540 --> 00:09:29,340
...لم أستطع فعل شيء

108
00:09:35,090 --> 00:09:37,720
من هنا يا هيلينغ-ساما

109
00:09:37,720 --> 00:09:41,430
إنّه مبنى حرس قديم، لكنّه المكان المثالي للاختباء

110
00:09:51,860 --> 00:09:54,400
بوجّي، لنبدأ بهزيمة أولئك المجرمين

111
00:09:55,280 --> 00:09:58,740
!وإنهاء الأمر بتولّي أمر والدك وميرانجو

112
00:09:58,740 --> 00:10:00,870
!سنُنجز هذا الأمر بسرعة وسهولة

113
00:10:12,170 --> 00:10:14,760
لا وقت لدينا للتردّد يا بوجّي

114
00:10:15,670 --> 00:10:16,920
!حسناً

115
00:10:21,720 --> 00:10:23,220
!أوكين؟

116
00:10:23,220 --> 00:10:26,430
!أيُعقَل أنّ القائد ورجاله قد أُبِيدوا؟

117
00:10:33,860 --> 00:10:36,820
هذا هو المدخل إلى العالم السّفلي

118
00:10:37,780 --> 00:10:39,660
...كما ذلك الصّغير

119
00:10:39,660 --> 00:10:41,490
عشيرة الظلّ

120
00:10:42,200 --> 00:10:46,660
يا لهم من شعب بائس. يتمّ استغلالهم
من جديد حتّى بعد وفاتهم

121
00:10:58,300 --> 00:11:00,430
ذاك الصّغير هو ناجٍ من تلك العشيرة، أليس كذلك؟

122
00:11:00,430 --> 00:11:04,970
تمّ استغلالهم والغدر بهم ثمّ تدميرهم
بشكل شبه كامل

123
00:11:04,970 --> 00:11:09,600
،ولم تبقَ سوى سمعتهم السيّئة. لكن حسبما سمعت

124
00:11:09,600 --> 00:11:11,850
يبدو أنّهم شعب طيّب القلب

125
00:11:13,270 --> 00:11:15,440
ينتابني إحساس سيّئ حيال هذا الأمر

126
00:11:15,440 --> 00:11:18,740
لقد التزمنا بوعدنا لبوسّو-ساما

127
00:11:18,740 --> 00:11:20,900
لنسرع بالعودة إلى بوجّي-ساما

128
00:11:20,900 --> 00:11:22,240
حسناً

129
00:11:24,070 --> 00:11:26,040
ماذا تنوي أن تفعل بي؟

130
00:11:26,040 --> 00:11:29,200
حسناً، سوف أرتجل فحسب

131
00:11:29,200 --> 00:11:31,120
،لن أفعل أيّ شيء بكِ

132
00:11:31,120 --> 00:11:34,000
لكن أرغب في معرفة ما تريدينه حقّاً

133
00:11:34,000 --> 00:11:36,000
لا حاجة لتعرف

134
00:11:36,000 --> 00:11:39,920
ما دمت لا تمسّني بضرّ، لك حرّية التصرّف

135
00:11:39,920 --> 00:11:43,300
وماذا لو قلتُ بأنّني سأضرّكِ؟

136
00:11:43,300 --> 00:11:44,760
حينئذ سأقتلك

137
00:11:44,760 --> 00:11:49,640
كم هذا مخيف. الرّجل الّذي كان يرافقكِ قد مات

138
00:11:49,640 --> 00:11:54,060
ماذا ستفعلين؟ أنتِ عاجزة عن إيقافي

139
00:11:55,110 --> 00:11:56,270
أتيت

140
00:12:08,910 --> 00:12:12,410
ماذا تفعل؟ هل أنت معها؟

141
00:12:15,250 --> 00:12:16,880
توقّف يا بوجّي

142
00:12:17,500 --> 00:12:19,550
ثمّة أمر مريب هنا

143
00:12:21,630 --> 00:12:26,050
!تـ-توقّف! هذا الرّجل فظيع! لا نريده أن ينقلِب ضدّنا

144
00:12:26,050 --> 00:12:29,060
فظيع؟ هذا الرّجل؟

145
00:12:29,060 --> 00:12:31,770
هـ-هل تتحكّمين به؟

146
00:12:31,770 --> 00:12:37,730
من السّهل التحكّم بمَن فقدوا صوابهم. هذا خادمي

147
00:12:37,730 --> 00:12:39,690
المرآة تنطق

148
00:12:41,030 --> 00:12:43,650
هل أثبِت ذلك بقتلك؟

149
00:12:43,650 --> 00:12:46,370
ماذا؟ لماذا؟

150
00:12:46,370 --> 00:12:50,580
لأنّ جريمتك بقتل أحد تلاميذي المُفضّلين
هي جريمة نكراء

151
00:12:50,580 --> 00:12:52,040
...أوكين

152
00:12:53,910 --> 00:12:56,540
ما هذا؟ هل ينقلبون على بعضهم الآخر؟

153
00:13:01,260 --> 00:13:03,090
!هـ-هذا فظيع

154
00:13:08,050 --> 00:13:09,300
حسناً

155
00:13:20,650 --> 00:13:22,570
!ماذا تظنّ أنّك تفعل يا فتى؟

156
00:13:22,570 --> 00:13:24,450
!إذا اعترضتَ طريقي فسوف أقتلك

157
00:13:29,830 --> 00:13:31,620
ماذا...؟

158
00:13:31,620 --> 00:13:34,040
!أنت فظيع أيضاً

159
00:13:34,040 --> 00:13:35,370
...مـ

160
00:13:35,410 --> 00:13:39,880
مهلاً! مهلا! أستسلم! لن أقاوم

161
00:13:39,880 --> 00:13:43,380
!لكن الشّخص الآخر قادم من الخلف

162
00:13:43,380 --> 00:13:48,720
!بحقّ السّماء، ساعدني

163
00:13:54,480 --> 00:13:55,890
!ما هذا؟

164
00:13:58,980 --> 00:14:00,400
!ما رأيك بذلك؟

165
00:14:02,110 --> 00:14:06,570
ماذا؟ لم يؤثّر ذلك بك؟

166
00:14:06,570 --> 00:14:09,870
!ما الّذي يجري هنا؟! إنّه شديد السُمّية

167
00:14:09,870 --> 00:14:12,330
!ذلك الوغد! يا لها من خدعة رخيصة

168
00:14:13,410 --> 00:14:17,290
السّموم البشريّة لا تؤثّر بالعمالقة

169
00:14:17,290 --> 00:14:22,290
على ذكر الأمر، قال ديسبا بأنّ معدة
بوجّي متينة ومُقاومة

170
00:14:23,550 --> 00:14:26,010
!بوجّي هو الأعظم حقّاً

171
00:14:37,770 --> 00:14:39,100
!اللّعنة

172
00:14:50,820 --> 00:14:52,070
!خذ هذه

173
00:14:56,450 --> 00:15:02,380
هذا صديقي بوجّي! وأنا كاغي. من تكونين؟

174
00:15:02,380 --> 00:15:04,210
أنت واحد من عشيرة الظلّ؟

175
00:15:04,210 --> 00:15:07,260
شعرتُ بنفحة مأساة منك

176
00:15:07,260 --> 00:15:09,340
ماذا قلتِ للتو؟

177
00:15:13,300 --> 00:15:14,640
!أوكين

178
00:15:17,060 --> 00:15:22,230
!كاغي، يجب ألّا تدع بوجّي يقاتل أوكين

179
00:15:22,230 --> 00:15:25,650
!لا يستطيع بوجّي هزيمته أبداً

180
00:15:25,650 --> 00:15:27,650
!سوف يُقتَل

181
00:15:34,410 --> 00:15:37,120
ما الّذي يريده هذا الفأر؟

182
00:15:52,470 --> 00:15:55,470
!بوجّي! اهزم أوكين أيضاً

183
00:16:26,040 --> 00:16:28,960
كان يرمي الأشياء نحوكِ؟

184
00:16:28,960 --> 00:16:31,220
إنّه بمستوى خارق الآن

185
00:16:31,220 --> 00:16:33,840
!هذا صحيح! إنّه مدهش

186
00:16:33,840 --> 00:16:37,100
!إنّه الأعظم حقّاً! لا يستطيع أحد اعتراضه

187
00:16:37,100 --> 00:16:40,270
حقّاً؟ هل أيقظتَ هذه القوّة فيه؟

188
00:16:40,270 --> 00:16:43,940
لا، لا. من فعلَ ذلك هو رجل يُدعى ديسبا

189
00:16:45,150 --> 00:16:49,570
يستطيع المرء فعل أيّ شيء إذا كان
لديه شخص يؤمن به

190
00:16:49,570 --> 00:16:54,150
بصورة نقيّة صافية

191
00:16:54,150 --> 00:16:56,240
...لكن في بعض الأوقات

192
00:16:56,240 --> 00:16:58,490
ينقلب ذلك ضدّهم...

193
00:17:15,180 --> 00:17:18,720
!ماذا؟ لم يسقط

194
00:17:18,720 --> 00:17:22,980
بوجّي! هل تعثّرت؟

195
00:17:40,830 --> 00:17:42,910
!لـ-ليس ثانية

196
00:17:46,290 --> 00:17:49,170
ما هذا؟ هل يضحك؟

197
00:17:49,170 --> 00:17:52,380
يبدو وكأنّه أدرك بأنّ مهارات الفتى
بالسّيف لن تنجح ضدّه

198
00:17:52,380 --> 00:17:56,430
لن تنجح؟ ما سرّ هذا الرّجل؟

199
00:17:56,430 --> 00:18:01,890
لا مشكلة. ما زال بوجّي يمتلك حركة
!خاصّة. سوف يتفاجأ كثيراً

200
00:18:01,890 --> 00:18:03,810
!هيّا يا بوجّي

201
00:18:04,600 --> 00:18:07,980
لكن هل ستنجح ضدّ أوكين؟

202
00:18:16,490 --> 00:18:19,660
!اقضِ عليه! هكذا يكون القتال

203
00:18:28,250 --> 00:18:30,250
!ماذا كان ذلك؟

204
00:18:57,240 --> 00:18:59,700
!بوجّي! تـ-تماسك

205
00:19:02,280 --> 00:19:04,200
ينبغي أن يهرب

206
00:19:04,200 --> 00:19:07,000
!أجل. معكِ حقّ! شكراً

207
00:19:07,000 --> 00:19:08,960
!بوجّي

208
00:19:08,960 --> 00:19:12,250
لماذا أسديتُ تلك النّصيحة؟

209
00:19:17,550 --> 00:19:19,220
!يكفي يا بوجّي

210
00:19:19,220 --> 00:19:20,760
!اهرب

211
00:19:23,550 --> 00:19:25,180
...بوجّي

212
00:19:25,180 --> 00:19:29,440
!إنّه واثق جدّاً من نفسه وسيلقى حتفه. يا للحماقة

213
00:19:29,440 --> 00:19:32,150
...مخطئة! يرى بوجّي

214
00:19:32,150 --> 00:19:36,820
يرى بوجّي بأنّه إذا لم يوقفه، سيُقتَل الآخرون جميعهم

215
00:19:36,820 --> 00:19:40,950
لا يفكّر بوجّي في نفسه

216
00:19:40,950 --> 00:19:44,870
يفكّر بوجّي في الآخرين دوماً

217
00:19:46,540 --> 00:19:48,580
!غبيّة

218
00:20:04,600 --> 00:20:06,760
!بوجّي! بوجّي

219
00:20:06,760 --> 00:20:08,180
ما الأمر؟

220
00:20:08,180 --> 00:20:11,560
!ينوي بوجّي مُهاجمة نقاطه الحيويّة وقتله

221
00:20:11,560 --> 00:20:12,810
لن يفلح ذلك

222
00:20:12,810 --> 00:20:14,190
أوكين خالد

223
00:20:14,190 --> 00:20:17,070
خالد؟ تقصدين بأنّه لا يموت؟

224
00:20:17,070 --> 00:20:21,820
من المُحال أن يهزمه. ينبغي أن تخبر صديقك

225
00:20:21,820 --> 00:20:23,410
...غير ممكن

226
00:20:23,410 --> 00:20:27,620
!بوجّي! بوجّي! بوجّي! هذا الرّجل خالد

227
00:20:27,620 --> 00:20:33,040
عليك أن ترتاح! اصعد إلى قمّة الجدار
!حيث لا يستطيع أوكين اللّحاق بك

228
00:20:37,380 --> 00:20:39,250
!تماماً يا بوجّي

229
00:20:44,590 --> 00:20:48,850
!ا-النّجدة

230
00:20:50,430 --> 00:20:52,140
!بوجّي

231
00:20:56,730 --> 00:21:01,240
أنتِ! أنتِ! أما من طريقة لهزيمته؟

232
00:21:01,240 --> 00:21:05,240
وأيضاً، ما أدراكِ بأنّه خالد أصلاً؟

233
00:21:05,240 --> 00:21:08,160
من تكونين؟

234
00:21:09,870 --> 00:21:13,210
أنا... ميرانجو

235
00:21:15,290 --> 00:21:18,210
هل أنتِ العقل المُدبّر لكلّ هذا؟

236
00:21:25,720 --> 00:21:32,140
حاولتُ اليوم البقاء صامداً لا أن تجرفني الهموم

237
00:21:32,140 --> 00:21:36,900
لكن غرقتُ في الأمس

238
00:21:36,900 --> 00:21:43,650
،يؤجّل اليوم مشاعره إلى وقت لاحق بتنهيدة

239
00:21:43,650 --> 00:21:48,030
لكن مثلما تبادر دوماً بابتسامة

240
00:21:48,030 --> 00:21:53,580
كذلك أنا أؤجّل الميعاد النّهائي الذي
كنتُ قد حدّدتُه وقرّرتُه

241
00:21:53,580 --> 00:21:58,580
...إذا تغيّر المشهد بعد خطوة إضافيّة

242
00:21:58,580 --> 00:22:01,750
...إذا تغيّر شيء

243
00:22:01,750 --> 00:22:08,800
،فكُن أوّل من يتألّق، حتّى لو سخرَ الآخرون

244
00:22:08,800 --> 00:22:12,970
لأنّني سأمسك بيدك

245
00:22:12,970 --> 00:22:19,900
لا يمكن أن يكون أيّ شخص، لا بدّ أن يكون أنت

246
00:22:19,900 --> 00:22:24,070
وحدك من يستطيع مسح هذه الدّموع

247
00:22:24,070 --> 00:22:32,370
أشرِق نحو غدٍ لم يُرَ بعد

248
00:22:34,370 --> 00:22:38,120
سأغنّي لك وأنتظرك

249
00:22:45,380 --> 00:22:50,630
سأغنّي هنا لأجلك وأنتظرك