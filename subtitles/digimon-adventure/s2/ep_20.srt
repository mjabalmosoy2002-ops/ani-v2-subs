213
00:15:47,590 --> 00:15:50,290
كان كلّ ما استطعنا فِعله هو المُراقَبة بهدوء

214
00:15:50,780 --> 00:15:53,150
لا أريد أن أرى ذلك من جديد

215
00:15:53,430 --> 00:15:57,170
!لن أدعَهم يفعلون ما يشاؤون

216
00:15:57,930 --> 00:15:59,410
سأذهبُ بمُفردي

217
00:15:59,800 --> 00:16:01,740
لن أستسلِمَ الآن

218
00:16:02,210 --> 00:16:04,880
الآن بعدما وصلتُ إلى هنا، سأستمرُّ في شقِّ طريقي

219
00:16:08,620 --> 00:16:10,240
!هيَّا بنا يا دايسكي

220
00:16:10,620 --> 00:16:11,730
تشيبيمون

221
00:16:11,730 --> 00:16:13,830
!إن كنتَ ستذهبُ يا دايسكي، سأذهب أنا

222
00:16:13,830 --> 00:16:14,820
!حسناً

223
00:16:14,820 --> 00:16:16,860
!تشيبيمون، تمسَّك

224
00:16:29,010 --> 00:16:30,850
!كانَ ذلك وشيكاً

225
00:16:30,850 --> 00:16:32,300
!كُنْ حذِراً يا دايسكي

226
00:16:32,780 --> 00:16:34,360
!لنذهَب أيضاً

227
00:16:34,360 --> 00:16:35,170
!حسناً

228
00:16:35,590 --> 00:16:38,440
لا يُمكِن أن يكون دايسكي الوحيد
!الّذي يظهر بمظهرٍ رائع

229
00:16:38,440 --> 00:16:41,160
إنَّه يقودُ الهجومَ حقّاً

230
00:16:44,040 --> 00:16:46,050
!كيميرامون! اِبدأ الهجوم

231
00:16:46,320 --> 00:16:47,740
!قيصر الدِّيجيمون؟

232
00:16:58,900 --> 00:17:00,370
إلى أين أنت ذاهِب يا كيميرامون؟

233
00:17:01,050 --> 00:17:02,270
!كيميرامون

234
00:17:07,550 --> 00:17:08,770
صَوت من هذا؟

235
00:17:11,930 --> 00:17:12,890
!كين-تشان

236
00:17:12,890 --> 00:17:14,200
!تمالَك نفسك

237
00:17:14,200 --> 00:17:15,320
!اخرس

238
00:17:15,610 --> 00:17:16,800
لستُ خائفاً

239
00:17:16,800 --> 00:17:19,190
لستُ خائفاً من قوّةِ الظَّلام

240
00:17:19,190 --> 00:17:21,590
أنا أحكمُ هذا العالم

241
00:17:21,590 --> 00:17:24,280
سأُتقِن قوّةَ الظّلام

242
00:17:25,010 --> 00:17:28,680
كان ينبغي أن أسعى أكثر لإيقافِه

243
00:17:28,680 --> 00:17:30,830
عندما كان يجمع بياناتٍ عن الظَّلام

244
00:17:31,260 --> 00:17:34,800
!أنا الشّخصُ الوحيدُ القادِرُ على حمايةِ كين-تشان

245
00:17:35,380 --> 00:17:37,590
،حاولَ استخدامَ الظَّلام

246
00:17:37,590 --> 00:17:39,510
لكن انتهى المطافُ بوقوعِه تحت الاستغلال

247
00:17:39,910 --> 00:17:43,270
!حسناً! لنذهب جميعاً إلى غرفةِ المُحرِّك الآن

248
00:17:46,190 --> 00:17:47,910
تِلك هي غرفةُ المُحرِّك

249
00:17:53,960 --> 00:17:54,990
...ألست

250
00:17:55,330 --> 00:17:56,280
الخاص بالقيصر؟

251
00:17:56,780 --> 00:17:57,960
تعالَ معي

252
00:17:57,960 --> 00:17:58,920
ماذا؟

253
00:17:58,920 --> 00:17:59,960
بسرعة

254
00:17:59,960 --> 00:18:01,660
تريد التوجُّه إلى غرفةِ المُحرِّك، صحيح؟

255
00:18:01,660 --> 00:18:03,530
ولماذا تُساعدنا؟

256
00:18:03,530 --> 00:18:04,730
!حضّرت لنا فخَّاً

257
00:18:04,730 --> 00:18:05,400
!غير صحيح

258
00:18:05,830 --> 00:18:08,370
أريدُ فقط إنقاذ كين-تشان

259
00:18:08,850 --> 00:18:10,630
كيميرامون مُرعِب

260
00:18:10,630 --> 00:18:12,560
،لأنّه أعادَه إلى الحياة

261
00:18:12,560 --> 00:18:16,370
لا يسعني سِوى الشُّعور بأنَّ كين-تشان
سيَنتهي في مكانٍ لا أطاله فيه

262
00:18:16,700 --> 00:18:18,830
،إن لم نُوقِف كيميرامون حالاً

263
00:18:18,830 --> 00:18:21,450
سنصِل إلى نقطةِ اللَّا عودة

264
00:18:22,000 --> 00:18:23,200
!أرجوك

265
00:18:23,200 --> 00:18:24,380
صدِّقني

266
00:18:26,810 --> 00:18:27,810
حسناً

267
00:18:27,810 --> 00:18:28,490
ماذا؟

268
00:18:29,150 --> 00:18:31,460
سوف أثِقُ بك

269
00:18:31,940 --> 00:18:33,450
!شكراً لك

270
00:18:33,450 --> 00:18:34,930
!تعالَ معي

271
00:18:40,480 --> 00:18:41,670
ما هذا...؟

272
00:18:41,670 --> 00:18:44,710
وكأنَّ هذا المكان مليءٌ بالطّاقة

273
00:18:44,710 --> 00:18:45,840
ما الّذي يجري؟

274
00:18:46,260 --> 00:18:48,310
مصدرُه ذاك الشَّيء الأسود

275
00:18:48,940 --> 00:18:50,650
وجدَه كين-تشان

276
00:18:50,650 --> 00:18:52,780
إنَّه يتحكّمُ بهذه القلعة

277
00:18:53,170 --> 00:18:56,750
أي إذا أزلناه، ينبغي أن تتوقّفَ القلعة، صحيح؟

278
00:18:57,300 --> 00:18:59,060
لكن كيف؟

279
00:19:06,650 --> 00:19:07,730
!المُحرِّك

280
00:19:09,480 --> 00:19:11,160
!فعلتَها يا دايسكي-كن

281
00:19:13,640 --> 00:19:15,100
ما-ما الّذي يجري؟

282
00:19:21,230 --> 00:19:22,470
!دايسكي، انظُر

283
00:19:29,310 --> 00:19:31,350
تطوّرت! لكن لماذا؟

284
00:19:42,600 --> 00:19:43,460
...هذه

285
00:19:44,020 --> 00:19:46,070
!بيضةٌ رقميّةٌ ذهبيّة

286
00:19:48,010 --> 00:19:50,310
سمعتُ صوتاً للتو

287
00:19:51,220 --> 00:19:53,400
هل هذه بيضتي الرَّقميّة؟

288
00:19:54,550 --> 00:19:55,610
!فيمون

289
00:19:55,610 --> 00:19:56,710
هل ينبغي أن نُجرِّب ذلك؟

290
00:19:57,200 --> 00:19:58,180
!نعم

291
00:19:59,450 --> 00:20:01,640
!ترقِّي أيّتُها البيضة الرقميّة

292
00:20:02,930 --> 00:20:05,620
...فيمون، تطوَّر درعيّاً إلى

293
00:20:08,620 --> 00:20:11,590
!التألُّق الإعجازيّ: ماغنامون

294
00:20:11,820 --> 00:20:14,060
!تـ-تطوَّر

295
00:20:14,980 --> 00:20:16,030
!مُذهِل

296
00:20:16,330 --> 00:20:18,000
ماذا حدث؟

297
00:20:21,620 --> 00:20:23,650
كان تطوُّراً إعجازيّاً

298
00:20:26,810 --> 00:20:29,220
،كانَ جميلاً كشروقِ الشّمس

299
00:20:30,400 --> 00:20:33,420
كما لو أنَّه كان يسلّط ضوءه على العالم

300
00:22:01,470 --> 00:22:04,790
!بقوّةِ العدالة، يسطع ماغنامون ببريق

301
00:22:04,790 --> 00:22:07,460
،لكن أمامَ كيميرامون الظّلاميّ

302
00:22:07,460 --> 00:22:09,680
هل سينطفِئ السُّطوع؟

303
00:22:10,210 --> 00:22:12,230
،لحمايةِ محبوبه كين إتشيجوجي

304
00:22:12,230 --> 00:22:16,610
!يُفجِّر وارمون مشاعِره أمام كيميرامون

305
00:22:16,610 --> 00:22:19,170
!الحلقة القادمة من مغامرة الدّيجيمون 02

306
00:22:19,650 --> 00:22:21,700
"...وداعاً يا كين-تشان"

307
00:22:21,700 --> 00:22:24,360
!البوّابة المؤدّية إلى المغامرة مفتوحة الآن