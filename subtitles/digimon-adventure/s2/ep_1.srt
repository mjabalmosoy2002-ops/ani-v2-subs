1
00:00:01,580 --> 00:00:04,950
...كانَ ذلك صيفاً لا يُنسى

2
00:00:06,590 --> 00:00:08,820
منذُ ذلك الحين، مضَتْ ثلاث سنوات

3
00:01:51,380 --> 00:01:54,220
اهربوا، إنَّه قيصر الدّيجيمون

4
00:02:31,760 --> 00:02:33,680
ذلك الّذي يرِثُ الشَّجاعة

5
00:02:45,830 --> 00:02:47,480
لقد انتهيت

6
00:02:47,480 --> 00:02:52,160
آسفة لأنّني لا أستطيع الذهاب معك في أوّل
...يوم دوام لك في المدرسة، لكن

7
00:02:52,160 --> 00:02:55,750
...عليّ إنهاء هذه المقالة اليوم

8
00:02:55,750 --> 00:02:57,720
لا تقلقي، أستطيعُ الذهاب بمفردي

9
00:02:59,450 --> 00:03:00,720
سأُغادر

10
00:03:04,040 --> 00:03:04,970
صباح الخير

11
00:03:05,370 --> 00:03:06,780
...صباح الخير

12
00:03:06,780 --> 00:03:10,100
لقد انتقلتُ حديثاً إلى هذا البناء

13
00:03:10,100 --> 00:03:12,450
اسمي تاكايشي تاكيرو، الصفّ الخامس

14
00:03:12,450 --> 00:03:13,150
سُرِرتُ بلقائك

15
00:03:13,800 --> 00:03:16,410
وأنا إينوي مياكو، الصفّ السَّادس

16
00:03:16,410 --> 00:03:19,550
يُكتَبُ اسمي مثل "كيو" في "كيوتو"، ولكن يُلفَظ مياكو

17
00:03:19,550 --> 00:03:20,430
سُرِرتُ بمعرفتك

18
00:03:21,060 --> 00:03:22,680
وهذا إيوري

19
00:03:22,680 --> 00:03:24,770
اسمي هيدا إيوري، الصفّ الثالث

20
00:03:24,770 --> 00:03:26,520
سُرِرتُ بلقائك

21
00:03:26,520 --> 00:03:27,530
وكذلك أنا

22
00:03:30,170 --> 00:03:34,680
حسناً يا مياكو-سان، هل يمكنكِ المجيء إلى منزلي
بعد الدوام المدرسيّ لإصلاح حاسوبي؟

23
00:03:34,680 --> 00:03:35,800
لا أمانع

24
00:03:35,800 --> 00:03:37,020
هلّا حضّرت والدتك بعض الأوهاغي؟

25
00:03:37,020 --> 00:03:40,360
حسناً، سأُخبرها برسالة لاحقاً

26
00:03:40,340 --> 00:03:41,300
!يا سلام

27
00:03:46,800 --> 00:03:47,900
تايتشي-سان؟

28
00:03:54,630 --> 00:03:56,040
آسف، آسف

29
00:04:00,070 --> 00:04:02,670
!ناظورك رائع جدّاً

30
00:04:03,640 --> 00:04:06,830
دايسكي، ماذا تفعل؟

31
00:04:09,670 --> 00:04:10,960
دايسكي؟

32
00:04:11,460 --> 00:04:13,790
سيكون تايتشي-سان في المرحلة الإعداديّة الآن

33
00:04:20,160 --> 00:04:22,140
نحن في نفس الصفّ مُجدّدًا يا هيكاري-تشان

34
00:04:23,610 --> 00:04:25,100
تسرُّني رؤيتك من جديد

35
00:04:25,800 --> 00:04:29,370
لقد قالَ شخصٌ للتوّ بأنَّ ناظوري رائع

36
00:04:29,370 --> 00:04:31,330
...لكنّني لا أعرفه حتّى

37
00:04:33,080 --> 00:04:34,020
...تايتشي

38
00:04:34,520 --> 00:04:36,910
!تايتشي

39
00:04:40,260 --> 00:04:44,410
دعوني أُعرّفَكم على تلميذٍ جديد لهذا الفصل الدراسيّ

40
00:04:44,410 --> 00:04:45,200
تفضَّل

41
00:04:46,070 --> 00:04:47,510
تاكايشي تاكيرو-كن

42
00:04:47,510 --> 00:04:50,090
اسمي تاكايشي تاكيرو. سُرِرتُ بلقائكم جميعاً

43
00:04:50,090 --> 00:04:51,450
...إنّه

44
00:04:51,450 --> 00:04:54,030
مقعدُك .. بجانبِ ياغامي

45
00:04:56,660 --> 00:04:57,750
لم أركَ منذُ وقتٍ طويل

46
00:04:57,750 --> 00:04:59,300
أصبحتَ طويلاً، أليس كذلك؟

47
00:04:59,910 --> 00:05:04,190
ما خطب هذا الفتى؟ كيف يعرف هيكاري-تشان بهذا القرب؟

48
00:05:08,380 --> 00:05:12,450
سونيمون، ديجيمون ضارٍ بمُستوى بالِغ على شكل فرس نبي

49
00:05:12,450 --> 00:05:15,560
هجمته، مِنجل الظلّ، تقطع أي شيء بسرعة فائقة

50
00:05:20,070 --> 00:05:21,950
...بيومون، تينتومون

51
00:05:22,590 --> 00:05:23,760
آغومون

52
00:05:23,760 --> 00:05:24,850
تايتشي

53
00:05:26,730 --> 00:05:28,420
تطوَّر يا آغومون

54
00:05:31,790 --> 00:05:35,080
لا جدوى...لا أستطيع التطوّر يا تايتشي

55
00:05:35,810 --> 00:05:37,170
لماذا؟

56
00:05:37,170 --> 00:05:39,420
لماذا لا تستطيع التطوّر؟

57
00:05:42,830 --> 00:05:44,300
لا فائدة

58
00:05:44,300 --> 00:05:46,670
تِلك المنطِقةُ تحت سيطرتي بالفعل

59
00:05:47,360 --> 00:05:51,350
لِذا الأملُ من تطوُّرك هُناك...منعدم

60
00:05:54,890 --> 00:05:56,060
!من هنا

61
00:06:02,090 --> 00:06:05,660
أرجوكم، أيّ شخص يتلقَّى هذه الرّسالة، ساعدونا

62
00:06:06,500 --> 00:06:09,010
،غريب! هناك رسالة لإيزومي-سينباي

63
00:06:09,010 --> 00:06:10,770
...لكنّه تخرّج بالفعل

64
00:06:12,510 --> 00:06:13,770
ما هذا؟

65
00:06:13,770 --> 00:06:16,700
أتساءل إن كان ياغامي هذا بالنسبة
...لطالبة الصفّ الخامس تلك

66
00:06:18,180 --> 00:06:20,700
هل انتهيت من تفريغ أمتعتك؟

67
00:06:20,700 --> 00:06:22,110
تقريباً

68
00:06:22,800 --> 00:06:24,360
!أنت

69
00:06:24,360 --> 00:06:26,360
"اسمه تاكيرو-كن، ليس "أنت

70
00:06:26,840 --> 00:06:31,090
تاكيرو، ما علاقتك بهيكاري-تشان؟

71
00:06:31,540 --> 00:06:33,410
عمّاذا تتحدّث؟

72
00:06:34,400 --> 00:06:36,580
دايسكي-كن، أنت طريف جداً

73
00:06:36,580 --> 00:06:38,690
!لا أتصرّف بطرافة على الإطلاق

74
00:06:38,690 --> 00:06:40,050
!ها أنت ذي

75
00:06:40,050 --> 00:06:41,400
مياكو-سان

76
00:06:42,720 --> 00:06:44,990
لا بدّ أنكِ ياغامي هيكاري-سان، صحيح؟

77
00:06:44,990 --> 00:06:46,750
...أجل، هذا صحيح

78
00:06:46,750 --> 00:06:48,740
هل تعرفين ياغامي تايتشي؟

79
00:06:50,730 --> 00:06:51,790
أخي الكبير

80
00:06:55,270 --> 00:06:56,750
!إيزومي-سينباي

81
00:06:57,100 --> 00:07:00,700
مياكو-كن، هل يمكنني استخدام مختبر الحاسوب؟

82
00:07:00,700 --> 00:07:02,150
بالطّبع

83
00:07:02,150 --> 00:07:05,430
يسرُّني أنَّك في زيارةٍ لمدرستنا بعد التخرّج

84
00:07:05,430 --> 00:07:06,750
كوشيرو-سان

85
00:07:06,750 --> 00:07:08,180
...تلقّينا رسالة من أخي

86
00:07:08,900 --> 00:07:11,320
تاكيرو-كن، هيكاري-سان

87
00:07:13,020 --> 00:07:15,250
تلقّيتُ رسالتَه بدوري

88
00:07:15,250 --> 00:07:19,730
وعندما كنتُ سأردّ، نفدت البطّارية

89
00:07:20,950 --> 00:07:25,070
مجيئي إلى هنا من مدرستي أسرع من ذهابي إلى المنزل

90
00:07:25,590 --> 00:07:26,920
أتى رد

91
00:07:26,920 --> 00:07:30,650
!إنّه من كوشيرو! هيكاري وتاكيرو معه

92
00:07:30,650 --> 00:07:32,900
تايتشي، تعالَ إلى هُنا يا تايتشي

93
00:07:32,900 --> 00:07:35,770
بالمناسبة، أين العالم الرقميّ؟

94
00:07:35,770 --> 00:07:37,520
هل هو مدينة ملاهٍ جديدة؟

95
00:07:37,940 --> 00:07:42,890
...أتذكر تايتشي-سينباي يتكلّم عن شيء يدعى ديجيمونات أو

96
00:07:42,890 --> 00:07:44,650
هل تعرف تايتشي-سان؟

97
00:07:44,650 --> 00:07:47,470
كلاهما ينتميان لنفس نادي كرة القدم

98
00:07:47,940 --> 00:07:50,830
وما هو هذا؟ المدعو بالدّيجيمون؟

99
00:07:50,830 --> 00:07:54,830
...مياكو-سان، بخصوص إصلاح حاسوبي

100
00:07:54,830 --> 00:07:56,740
كدتُ أنسى

101
00:07:56,740 --> 00:07:57,970
كما توقّعت

102
00:07:58,370 --> 00:07:59,850
البوّابة الرقميّة مفتوحة

103
00:08:03,350 --> 00:08:04,740
...هل هذه

104
00:08:04,740 --> 00:08:07,080
شارة الشّجاعة؟

105
00:08:07,080 --> 00:08:09,320
يبدو أنها كانت هنا لوقت طويل

106
00:08:09,920 --> 00:08:13,410
...إنها شارة الشّجاعة، لكن

107
00:08:20,730 --> 00:08:22,290
ما هذه بالضبط؟

108
00:08:24,980 --> 00:08:26,760
...ينتابني فضول

109
00:08:27,230 --> 00:08:30,510
أريد أن أذهب أيضاً، تايتشي-سينباي في ورطة، صحيح؟

110
00:08:30,510 --> 00:08:34,850
لا يمكننا...إنّه ليس مكاناً يستطيع أيّ أحدٍ الذهاب إليه

111
00:08:36,230 --> 00:08:38,930
...لا يهمّني! أريد الذهاب معكم! لأنّ

112
00:08:48,440 --> 00:08:49,550
ما هذا؟

113
00:08:49,550 --> 00:08:51,060
جهاز رقميّ؟

114
00:08:51,060 --> 00:08:53,480
لكنّه مختلف عن جهازنا

115
00:08:55,580 --> 00:08:59,090
...فُتِحت البوّابة الرقميّة في هذه الشّاشة

116
00:09:00,050 --> 00:09:02,820
هل يمكننا الذهاب إلى العالم الرقميّ من هنا؟

117
00:09:02,820 --> 00:09:05,120
علينا مساعدة أخي الكبير بسرعة

118
00:09:05,120 --> 00:09:06,070
سأذهبُ أيضاً

119
00:09:06,070 --> 00:09:07,300
ستقودني هذه إلى هناك، صحيح؟

120
00:09:07,300 --> 00:09:08,780
أجل

121
00:09:08,780 --> 00:09:12,060
إذا كانَ هذا جهازاً رقميّاً حقيقيّاً

122
00:09:14,610 --> 00:09:15,760
سأذهب الآن

123
00:09:21,100 --> 00:09:22,140
أنا أيضاً

124
00:09:26,320 --> 00:09:28,570
ماذا عنك يا دايسكي-كن؟

125
00:09:30,030 --> 00:09:31,030
سأذهب أيضاً

126
00:09:39,290 --> 00:09:40,630
إيزومي-سينباي

127
00:09:42,210 --> 00:09:44,000
ما كان ذلك الضوء؟

128
00:09:44,000 --> 00:09:46,040
...في  الواقع، لا أدري

129
00:09:57,920 --> 00:10:00,020
أهذا هو العالمُ الرَّقميّ؟

130
00:10:01,750 --> 00:10:03,480
تغيّرَتْ ملابسي

131
00:10:06,000 --> 00:10:08,570
...الدّخولُ إلى حديقتي من دون إذن

132
00:10:08,570 --> 00:10:10,900
لا يتمتّعُ هؤلاء النَّاس بأيّ آداب سلوك، صحيح؟

133
00:10:29,000 --> 00:10:33,130
...هذا هو العالم الرقميّ إذاً؟ غير مختلف كثيراً عن عالمنا

134
00:10:37,700 --> 00:10:39,470
ماذا يفعل هذا هنا؟

135
00:10:49,500 --> 00:10:50,830
!كفّا عن الضحك

136
00:10:52,080 --> 00:10:54,090
هل كانت تلك الأشياء ديجيمونات؟

137
00:10:54,090 --> 00:10:57,150
هنالك الكثيرُ من الأنواع، بعضُها أظرف بكثير

138
00:10:57,150 --> 00:10:58,930
وبعضُها أكثر رُعباً

139
00:11:02,760 --> 00:11:03,840
لقد اقتربنا

140
00:11:05,160 --> 00:11:06,540
تاكيرو

141
00:11:06,540 --> 00:11:07,680
باتامون

142
00:11:08,290 --> 00:11:09,830
!لم أرك منذ وقت

143
00:11:11,270 --> 00:11:14,240
يا شباب، شكراً لقدومِكم للمُساعدة

144
00:11:14,240 --> 00:11:15,810
تايتشي-سينباي

145
00:11:15,810 --> 00:11:17,130
!يسرّني أنّك لم تتأذّ

146
00:11:18,960 --> 00:11:20,600
لماذا أتى دايسكي إلى هُنا؟

147
00:11:21,280 --> 00:11:22,270
هيكاري

148
00:11:22,270 --> 00:11:23,590
تيلمون

149
00:11:27,220 --> 00:11:28,230
ماذا حدث لك؟

150
00:11:42,950 --> 00:11:45,590
...تمكَّنتُ بطريقةٍ ما من الهرب

151
00:11:46,300 --> 00:11:52,090
بشريّ يطلق على نفسه "قيصر الديجيمون" كان
يغسل أدمغة الديجيمونات الأخرى

152
00:11:52,090 --> 00:11:53,790
بشريّ؟

153
00:11:53,790 --> 00:11:57,550
هل يوجدُ بشريٌّ غيرنا في العالمِ الرّقمي؟

154
00:11:57,920 --> 00:12:02,510
أجل، لديه جهاز رقميّ غير جهاز هيكاري

155
00:12:02,850 --> 00:12:03,960
...هل يبدو

156
00:12:05,210 --> 00:12:06,880
كهذا؟

157
00:12:06,880 --> 00:12:09,220
نعم، يُشبه هذا كثيراً

158
00:12:09,220 --> 00:12:13,080
!لكن خرج هذا للتوّ من الحاسوب

159
00:12:14,110 --> 00:12:18,400
كان هذا إحدى الأنوار الثلاثة
التي طارت من هنا

160
00:12:18,980 --> 00:12:21,370
...ودايسكي قد

161
00:12:22,500 --> 00:12:26,920
هل هذا يعني أنّه طفل مختار جديد؟

162
00:12:27,910 --> 00:12:29,790
إلى أين ذهبَ الجميع؟

163
00:12:30,050 --> 00:12:32,550
...أخبرتك، رجعوا للمنزل

164
00:12:32,550 --> 00:12:35,890
كاذِب، أنتَ تخفي عنِّي شيئاً

165
00:12:35,890 --> 00:12:39,600
ما هو العالمُ الرَّقمي؟ ما هو الدِّيجيمون؟

166
00:12:39,600 --> 00:12:41,260
...في الواقع

167
00:12:41,730 --> 00:12:43,670
ما هذا؟

168
00:12:43,670 --> 00:12:45,600
من أين حصلتِ عليه؟

169
00:12:45,600 --> 00:12:47,120
إيوري لديه واحد أيضاً

170
00:12:47,120 --> 00:12:50,000
...نعم، لقد تغيّرَتْ مُخطّطاتنا

171
00:12:50,000 --> 00:12:53,080
لا، سآخذُ الأوهاغي بما أنَّك عملت على تحضيرها

172
00:12:54,630 --> 00:12:59,040
بسببِ ذلك الجهاز الرّقمي، لا نستطيعُ التطوّر

173
00:13:00,120 --> 00:13:01,810
هكذا إذاً

174
00:13:01,810 --> 00:13:04,620
إذا تمكَّنتُ من التطوُّر فسأوسِعُه ضرباً

175
00:13:05,350 --> 00:13:09,840
فقدتُ خاتمي المُقدَّس، لِهذا فقدتُ نصف قوَّتي

176
00:13:09,840 --> 00:13:14,290
وقد انفصلنا عن بيومون وتينتومون

177
00:13:14,800 --> 00:13:18,700
بشريّ يصطادُ الدِّيجيمونات وأصبحَ ملكها؟

178
00:13:18,700 --> 00:13:19,670
!هذا هراء

179
00:13:22,170 --> 00:13:25,680
كلامٌ كبير. ولكن هذه لُعبة

180
00:13:26,380 --> 00:13:30,810
وأكرهُ النَّاسُ الّذين لا يعرفون كيفَ يستمتِعون

181
00:13:33,360 --> 00:13:35,110
!لنحذفهم

182
00:13:37,890 --> 00:13:39,700
انطلِق يا مونوكرومون

183
00:13:51,400 --> 00:13:54,480
هذا... أليست هذه شارة الشّجاعة؟

184
00:13:54,480 --> 00:13:56,770
أجل، وهي ثقيلة جداً

185
00:13:59,310 --> 00:14:00,760
!معك حقّ

186
00:14:00,760 --> 00:14:02,670
لكنّها صغيرة جداً

187
00:14:04,110 --> 00:14:06,510
ماذا؟ لا أستطيع تحريكها إطلاقاً

188
00:14:06,710 --> 00:14:09,140
حسناً، اتركوا الأمرَ لي

189
00:14:19,830 --> 00:14:22,190
ماذا؟ إنَّها ليسَتْ ثقيلة على الإطلاق

190
00:14:23,030 --> 00:14:24,150
!دايسكي

191
00:14:38,870 --> 00:14:40,380
أخيراً، أخيراً

192
00:14:40,380 --> 00:14:42,090
حرّكتَ البيضةَ الرَّقميّة

193
00:14:43,280 --> 00:14:46,090
اسمي فيمون، ما اسمك؟

194
00:14:46,090 --> 00:14:47,510
د-دايسكي

195
00:14:49,120 --> 00:14:53,250
فيمون، ديجيمون من نوع تنّين صغير مشاكس
...وشقيّ، لكن يمتلك حسّ عدالة قويّ

196
00:14:53,250 --> 00:14:57,170
هجمتُه الخاصّة هي نطحة قويّة تُدعى بنطحة بفيمون

197
00:14:57,170 --> 00:15:01,250
سُرِرتُ بلقائك يا دايسكي، كنتُ أنتظرك منذ فترة طويلة

198
00:15:01,250 --> 00:15:02,840
تنتظرني أنا؟

199
00:15:02,840 --> 00:15:07,450
أجل، انتظرتُ الطفل الذي سيحرّك البيضة
الرقميّة هذه التي تمثّل الشّجاعة

200
00:15:08,070 --> 00:15:09,820
بيضة الشَّجاعة؟

201
00:15:10,860 --> 00:15:13,280
...أزاحَها دايسكي، ما يعني

202
00:15:15,350 --> 00:15:16,910
ماذا؟ زلزال؟

203
00:15:16,910 --> 00:15:18,590
لا، انظروا هُناك

204
00:15:22,670 --> 00:15:24,730
إنَّه وحش

205
00:15:24,730 --> 00:15:26,020
هذا ديجيمون آخر

206
00:15:26,020 --> 00:15:26,930
إنَّه مونوكرومون

207
00:15:31,580 --> 00:15:35,960
مونوكرومون، ديجيمون بالغ بدرع وقرون صُلبة كالألماس

208
00:15:35,960 --> 00:15:39,150
هجمتُه الخاصّة هي هجومُ البُركان

209
00:15:39,150 --> 00:15:40,920
طلقةُ الهواء

210
00:15:40,920 --> 00:15:42,480
اللّهبُ الصَّغير

211
00:15:48,210 --> 00:15:49,980
!هذا لم ينفع، اهربوا

212
00:15:49,980 --> 00:15:51,020
دايسكي

213
00:15:56,090 --> 00:15:58,290
دايسكي، ماذا تفعل؟

214
00:15:58,290 --> 00:16:00,130
استخدِم شجاعتَك بسُرعة

215
00:16:00,130 --> 00:16:01,540
ماذا؟

216
00:16:13,240 --> 00:16:14,420
ماذا حدث؟

217
00:16:14,420 --> 00:16:16,350
دايسكي، هُنا

218
00:16:17,520 --> 00:16:18,250
دايسكي

219
00:16:20,980 --> 00:16:22,700
هل أنتَ بخير يا دايسكي؟

220
00:16:23,350 --> 00:16:24,590
...شكراً

221
00:16:24,590 --> 00:16:29,070
..."إذا استخدمتَ شجاعتَك... وقلتَ فقط "ترقّي أيّتها البيضة الرّقميّة

222
00:16:29,300 --> 00:16:31,530
دايسكي، هل أنتَ بخير؟

223
00:16:31,530 --> 00:16:32,380
...أجل

224
00:16:32,890 --> 00:16:37,230
قُلْ " ترقّي أيّتها البيضة الرقميّة"، حينها سأكونُ قادراً على التطوُّر

225
00:16:37,230 --> 00:16:38,360
ماذا؟

226
00:16:38,360 --> 00:16:39,630
تايتشي

227
00:16:39,630 --> 00:16:41,020
أصيب كاحل هيكاري-تشان

228
00:16:41,020 --> 00:16:41,870
...هيكاري

229
00:16:41,870 --> 00:16:42,960
إنّه مُجرَّد التواء بسيط

230
00:16:49,030 --> 00:16:49,990
بسُرعة

231
00:16:49,990 --> 00:16:51,130
!دايسكي

232
00:16:51,130 --> 00:16:52,350
...هيكاري-تشان

233
00:16:55,070 --> 00:16:56,130
سأُجرِّب

234
00:16:57,290 --> 00:16:59,850
!ترقّي أيّتها البيضة الرّقميّة

235
00:17:03,870 --> 00:17:07,390
فيمون، تطوَّرْ درعياً

236
00:17:22,860 --> 00:17:26,030
الشّجاعةُ المُلتهِبة، فليدرامون

237
00:17:34,750 --> 00:17:36,600
هل استطاع التطوّر؟

238
00:17:38,270 --> 00:17:39,770
!مذهل

239
00:17:41,640 --> 00:17:45,980
فليدرامون، ديجيمون من صنف الدرع، شكل مُتطوّر
من فيمون بشارة البيضة الرقميّة

240
00:17:45,980 --> 00:17:50,240
هجمته الخاصّة هي صاروخ النّار، حيث
يُطلِق نفسه على خصمه مُطوّقاً باللّهب

241
00:17:50,880 --> 00:17:52,550
تطوُّر درعيّ؟

242
00:17:53,060 --> 00:17:57,150
...كانَ ينبغي لجهازي الرَّقميّ الظلاميّ أن يمنعه من التطوّر

243
00:17:59,650 --> 00:18:01,310
لا بأس بهم

244
00:18:33,320 --> 00:18:36,490
صاروخ النَّار

245
00:18:38,510 --> 00:18:40,240
!صوّب على خاتمه الظلاميّ

246
00:19:04,950 --> 00:19:06,690
كلّ شيء على ما يُرام الآن

247
00:19:09,860 --> 00:19:12,800
...يبدو بأنّ عليّ اللعب بجديّة معكم

248
00:19:15,630 --> 00:19:16,610
...كين-تشان

249
00:19:20,130 --> 00:19:25,100
كم من القسوة أن يتحوّل ديجيمون مُسالم
...كهذا إلى خادمٍ عنيف

250
00:19:25,100 --> 00:19:27,350
يسرُّني تشكيل فريقٍ معك يا دايسكي

251
00:19:27,350 --> 00:19:28,080
نعم

252
00:19:28,080 --> 00:19:31,270
كانَ التطوُّر الدرعيّ مُذهِلاً حقَّاً

253
00:19:31,270 --> 00:19:34,080
...لا نستطيعُ التطوُّر، ولكن

254
00:19:34,080 --> 00:19:37,970
يمكنك هزيمة قيصر الدّيجيمون بالتأكيد

255
00:19:37,970 --> 00:19:39,750
أجل، اعتمِدوا علينا

256
00:19:40,150 --> 00:19:45,000
دايسكي... أنت طفل مُختار جديد بالتأكيد

257
00:19:45,000 --> 00:19:49,070
من الآن فصاعداً، آمل أن تحمي العالمَ الرَّقمي

258
00:19:49,070 --> 00:19:50,590
تفضَّل

259
00:19:50,590 --> 00:19:52,920
يمكنك أن تأخذ ناظوري

260
00:19:58,480 --> 00:20:00,070
إنَّه يليقُ بك

261
00:20:00,070 --> 00:20:01,040
حقَّاً؟

262
00:20:01,610 --> 00:20:03,820
الوضع آمنٌ الآن

263
00:20:04,310 --> 00:20:05,370
لماذا؟

264
00:20:05,370 --> 00:20:08,420
قيصر الدّيجيمون لا يظهر ليلاً

265
00:20:08,890 --> 00:20:12,960
تايتشي... ألم يحن الوقت للذهاب إلى المنزل؟

266
00:20:12,960 --> 00:20:16,540
أجل... آمل أن تكون البوّابة لا تزال مفتوحة

267
00:20:16,540 --> 00:20:18,980
من أين أتيتُم يا شباب؟

268
00:20:18,980 --> 00:20:21,990
...إيوري، تأخرت

269
00:20:21,990 --> 00:20:25,710
لم يكن باليد حيلة، فقد اضطررتُ الذهاب
إلى المنزل لأخذ الأوهاغي

270
00:20:25,710 --> 00:20:28,310
...هذه الأوهاغي لذيذةٌ حقّاً

271
00:20:29,370 --> 00:20:30,690
كان ذلك شهياً

272
00:20:30,690 --> 00:20:31,810
هل نذهب الآن؟

273
00:20:31,810 --> 00:20:33,100
أين؟

274
00:20:33,100 --> 00:20:35,790
أليس واضحاً؟ العالم الرَّقمي

275
00:20:38,090 --> 00:20:40,740
هذا أنا، دايسكي

276
00:20:45,190 --> 00:20:47,000
...لقد اُمتصّوا

277
00:20:56,260 --> 00:21:00,570
وهكذا عادَ دايسكي والبقيّة إلى العالمِ الحقيقيّ

278
00:21:00,970 --> 00:21:05,160
لكن من هو قيصر الدّيجيمون يا ترى؟

279
00:21:05,900 --> 00:21:09,980
والآن، مُغامرة جديدة على وشك أن تبدأ

280
00:22:37,110 --> 00:22:39,950
يعود دايسكي والآخرون إلى العالم الرقميّ

281
00:22:40,350 --> 00:22:42,530
هذه المرّة، رفقة مياكو وإيوري

282
00:22:42,530 --> 00:22:44,480
أرعبهم هذا العالم الجديد

283
00:22:44,480 --> 00:22:47,900
!ثمّ يهاجمهم قيصر الدّيجيمون بشراسة

284
00:22:47,900 --> 00:22:54,410
لكن عندما يُورث الحبّ والمعرفة، يظهر ديجيمون
بتطوّر درعي جديد لمواجهة ديجيمونات جديدة

285
00:22:54,410 --> 00:22:56,750
!الحلقة القادمة من مغامرة الدّيجيمون 02

286
00:22:56,750 --> 00:22:58,630
"البوّابة الرقميّة تُفتَح"

287
00:22:58,630 --> 00:23:01,180
!البوّابة المؤدّية إلى المغامرة مفتوحة الآن