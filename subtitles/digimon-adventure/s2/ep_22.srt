1
00:01:31,760 --> 00:01:34,550
...تطوّر ماغنامون درعيّاً بإعجازٍ واستخدم

2
00:01:34,550 --> 00:01:37,530
قوّةَ وارمون الّذي أدركَ أنَّه على ضلال

3
00:01:37,530 --> 00:01:39,530
وسوية، هزَموا كيميرامون

4
00:01:43,180 --> 00:01:46,980
انتهَتِ المعركةُ وأدركَ قيصر الدِّيجيمون عمقَ خطاياه

5
00:01:46,980 --> 00:01:49,330
وعادَ إلى كونِه كين إتشيجوجي

6
00:01:50,360 --> 00:01:53,680
...وفي تِلك اللَّحظة، ترتّبَ عليه أن يقول وداعاً

7
00:01:53,680 --> 00:01:56,020
لوارمون المُخلِص

8
00:01:56,600 --> 00:01:58,110
،بعدَ أن خَسِرَ كلّ شيء

9
00:01:58,110 --> 00:02:01,440
غادرَ كين إتشيجوجي العالمَ الرَّقميّ

10
00:02:05,330 --> 00:02:08,110
"التطوُّر الشُّجاع! أكس فيمون"

11
00:02:10,800 --> 00:02:13,130
"وهكذا أُنقِذَ البلد"

12
00:02:13,990 --> 00:02:17,690
"أُسقِطَ الملِك، وأُنقِذَ البلد"

13
00:02:17,690 --> 00:02:21,330
"حزِنَ النّاسُ كثيراً من سقوطِ الملِك"

14
00:02:21,330 --> 00:02:24,650
،ولازمَ الحِزنُ النّاسَ للأبد"

15
00:02:24,650 --> 00:02:27,480
"وأمسى أسطورة

16
00:02:28,880 --> 00:02:31,980
!يحثُّني هذا الدّرسُ على البُكاء

17
00:02:33,290 --> 00:02:34,800
،نأخذ هذا السّائل

18
00:02:35,490 --> 00:02:38,250
،ونضيفُه إلى سائلٍ آخر في دورق

19
00:02:38,250 --> 00:02:41,240
،ونُسخّنُه باستخدامِ مِصباح كحوليّ

20
00:02:41,240 --> 00:02:43,430
!وننتظِر ثلاث دقائق

21
00:02:45,430 --> 00:02:48,210
...يبدو هذا خطيراً قليلاً

22
00:02:57,820 --> 00:02:58,890
!احذروا

23
00:03:05,970 --> 00:03:07,060
كنتُ مُخطِئة إذاً

24
00:03:07,700 --> 00:03:08,770
...يا إلهي

25
00:03:16,290 --> 00:03:18,000
!أريد الرَّقص أيضاً

26
00:03:18,000 --> 00:03:19,110
لمَ لا نفعل؟

27
00:03:19,110 --> 00:03:19,920
!هيَّا

28
00:03:21,830 --> 00:03:23,890
!اسبقاني أنتُما واستمتعا

29
00:03:36,140 --> 00:03:38,990
!مُباراة كُرة السلّة للذكور على وشكِ أن تبدأ

30
00:03:50,950 --> 00:03:52,720
!عليكَ بهم يا تاكيرو

31
00:03:58,120 --> 00:03:59,420
!ارمِ

32
00:04:01,550 --> 00:04:02,670
!دخلَتْ

33
00:04:02,670 --> 00:04:03,880
!رمية مُمتازة

34
00:04:03,880 --> 00:04:06,030
!يستطيع دايسكي فعل ذلك على الأقلّ

35
00:04:06,360 --> 00:04:07,490
!تاكيرو-كن

36
00:04:07,880 --> 00:04:09,970
!مرحى! فعلناها

37
00:04:10,660 --> 00:04:13,290
!تاكيرو يظنُّ نفسه رائعاً

38
00:04:13,290 --> 00:04:14,360
!سأُريك

39
00:04:16,710 --> 00:04:18,400
!دايسكي! ارمِ

40
00:04:25,540 --> 00:04:27,180
!لا تضحكا

41
00:04:30,520 --> 00:04:33,330
لنُجرِّب ذلك من البداية

42
00:04:33,900 --> 00:04:36,040
دايسكي-كن، هل أنتَ بخير؟

43
00:04:36,040 --> 00:04:38,080
!بالطبعِ لا

44
00:04:38,540 --> 00:04:40,260
لماذا أنتَ غاضِب؟

45
00:04:49,080 --> 00:04:50,350
!مياكو-سان

46
00:04:49,460 --> 00:04:50,450
!إيوري

47
00:04:55,160 --> 00:04:56,380
!تأخَّرتُما

48
00:04:57,540 --> 00:05:01,260
مياكو-سان، دايسكي-كن بمزاجٍ سيّئ

49
00:05:01,260 --> 00:05:02,930
لِذا افتحي البوّابةَ بسُرعة

50
00:05:02,930 --> 00:05:03,750
حسناً

51
00:05:05,250 --> 00:05:06,810
!أيتُّها البوَّابة الرقميّة، افتحي

52
00:05:05,450 --> 00:05:06,820
مفتوحة

53
00:05:05,450 --> 00:05:06,820
اعرض
هنا

54
00:05:05,450 --> 00:05:06,820
حسَّاس البوَّابة

55
00:05:05,450 --> 00:05:06,820
الوضع الرَّاهن

56
00:05:05,450 --> 00:05:06,820
البوَّابة
حاليّاً

57
00:05:07,190 --> 00:05:09,290
!أيُّها الأطفال المُختارون، انطلاق

58
00:05:24,110 --> 00:05:26,110
،حتَّى من دون قيصر الدِّيجيمون

59
00:05:26,110 --> 00:05:28,450
!ما زلنا نستطيع المجيء إلى العالمِ الرَّقميّ

60
00:05:28,450 --> 00:05:29,980
!ماذا تعني؟

61
00:05:29,980 --> 00:05:33,110
!أمسى العالمُ الرّقميّ بسلامٍ أخيراً

62
00:05:33,110 --> 00:05:36,040
يُمكننا التمتُّع بالعالمِ الرّقميّ فحسب من الآن

63
00:05:36,040 --> 00:05:37,370
...صحيح

64
00:05:37,370 --> 00:05:39,110
ألا تعتقِدين ذلك يا هيكاري-تشان؟

65
00:05:39,390 --> 00:05:40,700
...أجل... صحيح

66
00:05:40,700 --> 00:05:45,820
مياكو على حقّ، لكننا لسنا هُنا لِلّعبِ اليوم

67
00:05:46,150 --> 00:05:47,540
أعلمُ ذلك

68
00:05:47,540 --> 00:05:50,790
سنتطوّعُ للمُساهمة في إصلاحِ واستعادة العالم الرَّقميّ

69
00:05:51,250 --> 00:05:56,300
نحن مسؤولون قليلاً عن الأضرارِ الّتي وقعَتْ هنا أيضاً

70
00:05:56,960 --> 00:06:00,230
مياكو-سان، ما حجمُ الأضرارِ هُنا؟

71
00:06:00,690 --> 00:06:03,200
دعوني أرى... سأتفقّد المحطَّة الطرفيّة-د

72
00:06:04,110 --> 00:06:06,190
تِلك المنطِقة الجبليّة

73
00:06:15,210 --> 00:06:17,570
سنذهبُ لتقديمِ المُساعدة هُناك

74
00:06:17,570 --> 00:06:18,820
!حسناً يا تاكيرو

75
00:06:18,820 --> 00:06:21,540
إذاً، سنتركُ المنطِقةَ الجبليّةَ لتاكيرو

76
00:06:21,540 --> 00:06:23,130
المدينة هي التَّالية

77
00:06:23,520 --> 00:06:24,970
يوجدُ كثيرٌ من الأضرار هُناك

78
00:06:36,530 --> 00:06:37,720
!سأذهب، سأذهب

79
00:06:37,720 --> 00:06:39,430
!هيَّا بنا يا إيوري، داغيا

80
00:06:39,430 --> 00:06:41,040
!ا-انتظِر يا أرماجيمون

81
00:06:41,040 --> 00:06:43,210
!تبّاً، سبقونا لذلك

82
00:06:43,410 --> 00:06:45,350
التَّالي هي المنطِقة الريفيّة

83
00:06:58,740 --> 00:07:00,490
!أعتقِد حانَ دورُنا الآن

84
00:07:00,490 --> 00:07:01,350
انتظِر

85
00:07:01,740 --> 00:07:03,090
أريدُ الذّهاب أيضاً

86
00:07:03,090 --> 00:07:03,770
أجل

87
00:07:03,770 --> 00:07:06,410
لنُقرِّر بواسطة حجر ورقة مِقصّ

88
00:07:06,410 --> 00:07:07,570
!حسناً

89
00:07:07,570 --> 00:07:09,070
...نبدأ بحجر

90
00:07:09,070 --> 00:07:10,630
!حجر ورقة مِقصّ

91
00:07:10,990 --> 00:07:13,240
!تبّاً، خسِرنا

92
00:07:13,670 --> 00:07:14,940
التّالي، البُحيرة

93
00:07:14,940 --> 00:07:16,910
!سأذهبُ أنا وفيمون إلى هُناك

94
00:07:17,210 --> 00:07:19,170
لم يبقَ إلَّا ساحل البحر

95
00:07:19,170 --> 00:07:21,630
مياكو-سان، سيكون هذا لنا

96
00:07:44,320 --> 00:07:46,470
!لا تستطيع قدمايّ الوصول للأرض

97
00:07:53,900 --> 00:07:56,960
!لا يمكنُك أن تأكل إن لم تعمل، داغيا

98
00:08:04,140 --> 00:08:06,400
!ابتعِدا، ابتعِدا! أنتُما تعترِضان طريقنا يا نوميمون

99
00:08:13,010 --> 00:08:14,970
!تيلمون

100
00:08:14,970 --> 00:08:16,420
!هيكاري-تشان

101
00:08:17,180 --> 00:08:18,380
تاكيرو-كن

102
00:08:18,720 --> 00:08:20,130
باتامون، ما الأمر؟

103
00:08:20,130 --> 00:08:23,350
كانَ تاكيرو قلِقاً بشأنِ شيء

104
00:08:23,600 --> 00:08:25,130
بشأنِ ماذا؟

105
00:08:25,130 --> 00:08:28,320
لماذا نستطيعُ المجيء إلى العالمِ الرّقميّ؟

106
00:08:29,280 --> 00:08:33,290
لأنَّ العالم بحاجتِنا هنا

107
00:08:33,530 --> 00:08:36,110
كانَ ذلك قبل ثلاث سنوات

108
00:08:36,110 --> 00:08:37,840
ماذا عن الآن إذاً؟

109
00:08:37,840 --> 00:08:39,500
هل نحن مطلوبون هُنا حقَّاً؟

110
00:08:39,830 --> 00:08:45,280
لكنَّنا مطلوبون هُنا لإصلاح المناطِق المُدمَّرة، صحيح؟

111
00:08:45,720 --> 00:08:49,980
نحن نتطوَّعُ للمُساعدة فقط

112
00:08:50,340 --> 00:08:55,790
سببُ قُدرتِنا على المجيء إلى العالمِ الرَّقميّ
يعني أنَّ العالمَ الرّقميّ بحاجتِنا

113
00:08:55,790 --> 00:08:57,100
الخطرُ يدنو

114
00:08:57,640 --> 00:08:59,480
عدوٌّ جديد؟

115
00:08:59,950 --> 00:09:01,330
لا أعرِف بالتَّحديد

116
00:09:01,330 --> 00:09:04,840
لكن أعتقِد يجب أن نُخبرَ الجميع عن هذا

117
00:09:05,310 --> 00:09:06,110
أجل

118
00:09:07,060 --> 00:09:10,100
!لا أحد هُنا

119
00:09:10,340 --> 00:09:13,060
هذا غريب. إلى أين ذهبَ الجميع؟

120
00:09:13,530 --> 00:09:18,040
!أنتم! لا تختبِئوا واخرجوا

121
00:09:18,350 --> 00:09:20,010
!دايسكي-كن

122
00:09:20,010 --> 00:09:21,220
!فيمون

123
00:09:23,590 --> 00:09:25,270
مرحباً يا فيمون

124
00:09:25,780 --> 00:09:28,060
...رُبَّما لاحظتَ سلفاً، لكن

125
00:09:28,970 --> 00:09:33,660
كيف لتاكيرو وهيكاري-تشان أن ينسجِما معاً لذاك الحد؟

126
00:09:34,570 --> 00:09:35,650
!تاكيرو-كن

127
00:09:36,270 --> 00:09:38,130
!مرحى! فعلناها

128
00:09:38,130 --> 00:09:40,020
باتامون وتيلمون أيضاً

129
00:09:40,370 --> 00:09:41,890
إنَّهما صديقان حميمان

130
00:09:45,130 --> 00:09:46,040
!فيمون

131
00:09:46,040 --> 00:09:47,550
ما الأمر يا دايسكي؟

132
00:09:47,870 --> 00:09:50,600
علينا أن نعملَ معاً

133
00:09:50,600 --> 00:09:51,530
نعمل معاً؟

134
00:09:51,810 --> 00:09:53,720
نفعل شيئاً رائعاً

135
00:09:53,720 --> 00:09:55,040
نفعل شيئاً رائعاً؟

136
00:09:55,040 --> 00:09:57,200
ونتقرَّب من هيكاري-تشان

137
00:10:09,470 --> 00:10:11,320
!أريدُ التقرُّب من تيلمون

138
00:10:14,450 --> 00:10:16,860
!تيلمون

139
00:10:21,670 --> 00:10:23,270
...الطريقةُ الوحيدةُ لإثارةِ إعجابهما هي

140
00:10:23,270 --> 00:10:25,650
!أن تتطوَّر إلى مُستوى بالغ

141
00:10:25,650 --> 00:10:27,450
تتطوَّر إلى مُستوى بالغ؟

142
00:10:27,450 --> 00:10:29,830
!إلى ألترانجيمون مثلاً

143
00:10:35,830 --> 00:10:37,220
!حسناً إذاً

144
00:10:37,220 --> 00:10:39,510
!لمَ لا أتحوَّل إلى ألترانجيمون؟

145
00:11:21,270 --> 00:11:22,890
!فيمون، النَّجدة

146
00:11:22,890 --> 00:11:24,230
!دايسكي

147
00:11:27,000 --> 00:11:29,490
!فيمون، تطوَّر إلى مُستوى بالغ حالاً

148
00:11:29,490 --> 00:11:32,990
...حسناً... فيمون تطوَّر

149
00:11:34,640 --> 00:11:37,300
!يا للهول، لا يستطيع التطوُّر

150
00:11:36,560 --> 00:11:37,870
...المعذِرة

151
00:11:37,870 --> 00:11:40,180
لكن أليس هذا جيّداً بما يكفي؟

152
00:11:40,180 --> 00:11:42,160
!أجل، لا مُشكلة. شكراً

153
00:11:42,160 --> 00:11:44,080
على الرَّحب

154
00:11:48,790 --> 00:11:51,700
!تكبّدتُم كلَّ هذا العناء. آسِف بشأنِ ذلك

155
00:11:52,250 --> 00:11:53,090
!إلى اللِّقاء

156
00:11:53,860 --> 00:11:56,060
!فيمون، هذه غلطتُك

157
00:11:56,060 --> 00:11:57,860
لماذا غلطتي؟

158
00:11:57,860 --> 00:11:58,750
!بِلا سبب

159
00:11:58,750 --> 00:11:59,570
!هذا مُؤلم

160
00:11:59,570 --> 00:12:00,400
!أنا غاضِب

161
00:12:01,010 --> 00:12:02,310
!أنا غاضبٌ حقَّاً الآن

162
00:12:02,310 --> 00:12:03,100
!أنا آسف

163
00:12:03,100 --> 00:12:04,680
!دايسكي، انتظِر

164
00:12:17,810 --> 00:12:19,230
!حان الوقتُ لخُطَّتي التّالية

165
00:12:19,230 --> 00:12:22,560
.إثارة غضب فيمون
...سأجعل هذا الجسر يسقُط

166
00:12:22,560 --> 00:12:25,000
وأُعرِّض نفسي لخطرٍ مُهدِّد للحياة

167
00:12:25,520 --> 00:12:28,970
...بِهذا الشَّكل، سيتطوَّر فيمون إلى مُستوى بالِغ

168
00:12:28,970 --> 00:12:30,920
!ستكون خُطَّة مُذهِلة

169
00:12:33,550 --> 00:12:35,710
!فيمون، النَّجدة

170
00:12:35,710 --> 00:12:36,930
!دايسكي

171
00:12:38,620 --> 00:12:39,800
!فيمون

172
00:12:39,800 --> 00:12:42,010
!دايسكي

173
00:12:43,810 --> 00:12:47,510
!فيمون، تطوَّر إلى مُستوى بالغ الآن

174
00:12:48,240 --> 00:12:50,530
...فيمون... تطوَّر

175
00:13:04,340 --> 00:13:07,620
كنتَ تُدرِّبُني لأتطوَّر إلى مُستوى بالغ؟

176
00:13:07,620 --> 00:13:11,770
ظننتُ أنَّني إذا وقعتُ في ورطة، ستتطوَّر
،إلى مُستوى بالغ

177
00:13:11,770 --> 00:13:14,120
وتُنقذني. تِلك كانت الخطّة

178
00:13:14,120 --> 00:13:15,980
أعتقِد لم يفلحْ ذلك

179
00:13:15,980 --> 00:13:17,490
أنا آسفٌ يا دايسكي

180
00:13:17,860 --> 00:13:19,840
فيمون، هذه ليسَتْ غلطتك

181
00:13:19,840 --> 00:13:20,610
حقّاً؟

182
00:13:20,610 --> 00:13:23,530
!لنلتقِ من جديد مع الآخرين

183
00:13:23,530 --> 00:13:24,230
حسناً

184
00:13:27,270 --> 00:13:28,050
!لنهرُب يا فيمون

185
00:13:28,940 --> 00:13:32,520
أليس هذا مُخطَّطاً آخر أعددتَه كي أتطوَّر؟

186
00:13:32,820 --> 00:13:34,420
!ليسَ كذلك

187
00:13:57,770 --> 00:13:58,520
!مُذهِل

188
00:13:58,520 --> 00:14:00,010
...لكن أنا متأكّدٌ أنَّنا رأيناه

189
00:14:00,010 --> 00:14:01,350
يتبوَّل

190
00:14:02,720 --> 00:14:04,430
!أظنُّه قد غضِب

191
00:14:05,410 --> 00:14:13,360
تورتامون

192
00:14:05,410 --> 00:14:13,360
بالغ
ديجيمون زاحِف

193
00:14:05,410 --> 00:14:13,360
:الحركة الخاصّة
سُلامَى القشرة

194
00:14:05,910 --> 00:14:06,910
!تورتامون

195
00:14:06,910 --> 00:14:11,150
ديجيمون زاحِف بصنف السُّلحفاة بقشرةٍ مُدبَّبة حادّة

196
00:14:11,150 --> 00:14:13,390
تقنيّتُه الخاصَّة هي سُلامَى القشرة

197
00:14:13,660 --> 00:14:15,650
!إنَّه غاضِبٌ جدّاً

198
00:14:15,650 --> 00:14:17,860
...من الطبيعيّ لأي شخص أن يغضَب

199
00:14:17,860 --> 00:14:21,130
!إذا رآه أحدٌ يتبوَّل

200
00:14:21,130 --> 00:14:23,870
...لكن لم نفعل ذلك عمداً

201
00:14:23,870 --> 00:14:26,550
ألا تعتقِد أنَّه سيُسامحنا إذا اعتذرنا يا فيمون؟

202
00:14:28,020 --> 00:14:29,250
لا، لا أعتقِد

203
00:14:29,250 --> 00:14:32,200
لكن هل هذا مُخطَّط لدفعي للتطوُّر؟

204
00:14:32,830 --> 00:14:34,360
!ليسَ كذلك

205
00:14:34,360 --> 00:14:36,160
!لنهرُب

206
00:14:36,680 --> 00:14:39,230
ماذا؟ دايسكي-كن وفيمون

207
00:14:39,230 --> 00:14:41,650
يتمرنَّان للتطوُّر إلى مُستوى بالغ؟

208
00:14:42,640 --> 00:14:45,720
ما الذي يُفكِّرُ دايسكي فيه بالضبط؟

209
00:14:44,180 --> 00:14:46,360
!النَّجدة

210
00:14:48,340 --> 00:14:49,450
!دايسكي-كن

211
00:14:49,450 --> 00:14:50,300
!فيمون

212
00:14:51,780 --> 00:14:54,120
ما الأمر؟ لماذا أنتُما مُرتعِدان جدّاً؟

213
00:14:59,060 --> 00:15:03,250
رأيتُما تورتامون وهو يتبوَّل؟

214
00:15:03,510 --> 00:15:04,440
أجل

215
00:15:04,440 --> 00:15:07,200
!هذه غلطتُكما يا دايسكي-كن وفيمون

216
00:15:07,200 --> 00:15:09,010
أعتقِد ذلك أيضاً

217
00:15:09,010 --> 00:15:10,410
!أنا أيضاً

218
00:15:10,410 --> 00:15:12,380
هذا ما توقّعتُه

219
00:15:12,380 --> 00:15:15,110
ولكن لم يكن الأمرُ بإرادتِنا

220
00:15:15,110 --> 00:15:17,530
من يريدُ رؤيةَ أحدٍ يتبوَّل؟

221
00:15:18,430 --> 00:15:20,260
...كانَ ينبغي أن نُغمِض أعيننا

222
00:15:31,160 --> 00:15:34,340
الجميع لديهم شيء لا يُريدون من الآخرين أن يروه

223
00:15:34,340 --> 00:15:35,670
لكن هل سيكونان بخير؟

224
00:15:35,670 --> 00:15:36,330
ماذا؟

225
00:15:36,330 --> 00:15:38,040
هل نتركهما هكذا؟

226
00:15:38,400 --> 00:15:40,470
لا داعي للقلق

227
00:15:40,860 --> 00:15:44,030
لا يبدو تورتامون شرِّيراً

228
00:15:51,920 --> 00:15:57,760
!مين

229
00:15:57,150 --> 00:15:58,610
!إيوري

230
00:15:58,610 --> 00:16:00,640
دايسكي-سان وفيمون؟

231
00:16:00,640 --> 00:16:02,200
!النَّجدة

232
00:16:02,200 --> 00:16:03,560
اتركا الأمرَ لي

233
00:16:07,430 --> 00:16:11,000
لا... لا أعتقِد أني أستطيع هزيمته بالكيندو خاصَّتي

234
00:16:11,000 --> 00:16:12,490
!آسِف، لا أستطيع التّعامُل مع هذا

235
00:16:23,300 --> 00:16:24,710
يسرُّني أنَّني لم أتدخَّل

236
00:16:24,710 --> 00:16:27,100
ليس خصماً سهلاً بالتأكيد

237
00:16:27,100 --> 00:16:28,490
!تماماً

238
00:16:28,490 --> 00:16:31,300
!النَّجدة يا هوكمون ومياكو

239
00:16:31,300 --> 00:16:33,460
!أرسل إيوري رسالةً لي

240
00:16:38,650 --> 00:16:41,160
!لا نملك وقتاً لِلّهو واللَّعب

241
00:16:41,390 --> 00:16:43,730
!نحن لا نلعب

242
00:16:43,730 --> 00:16:45,610
!لا نلعب

243
00:16:46,060 --> 00:16:49,310
!أنتُما تُزعجاننا، لِذا غادِرا... غادِرا فحسب

244
00:16:50,610 --> 00:16:51,830
!كيف تقولين "غادِرا فحسب"؟

245
00:16:51,830 --> 00:16:53,320
!يا لبرودة أعصابك

246
00:17:04,470 --> 00:17:06,710
!النَّجدة! لا تُطاردنا أرجوك

247
00:17:04,810 --> 00:17:06,710
!النَّجدة

248
00:17:20,680 --> 00:17:21,890
!هذه هي النِّهاية

249
00:17:25,230 --> 00:17:26,550
انتظِر يا تورتامون

250
00:17:28,440 --> 00:17:31,450
قبلَ أن تُهاجِمنا، أريدُ أن أقول شيئاً

251
00:17:31,450 --> 00:17:33,010
ككلِمات أخيرة؟

252
00:17:34,380 --> 00:17:38,240
أنا آسفٌ لأنَّنا رأيناك تتبوَّل

253
00:17:38,240 --> 00:17:41,000
!فاتَ الأوانُ على الاعتذارِ الآن

254
00:17:41,000 --> 00:17:43,540
...لكن قبلَ أن تُهاجِمَنا

255
00:17:43,540 --> 00:17:44,640
...قبلَ أن تفعل

256
00:17:44,640 --> 00:17:46,030
هل يُمكنك أن تغسل يديك؟

257
00:17:46,030 --> 00:17:46,770
ماذا؟

258
00:17:49,070 --> 00:17:51,410
هاجمْنا بعد أن تغسل يديك

259
00:17:51,410 --> 00:17:53,630
دايسكي، ما الّذي تقوله؟

260
00:17:53,630 --> 00:17:56,680
ألا تعتقِد أنَّ هذا صحّيٌ أكثر يا فيمون؟

261
00:17:56,680 --> 00:17:57,220
أجل

262
00:17:57,220 --> 00:18:00,670
!لـ-لكن من يأبه بشانِ النَّظافة الآن؟

263
00:18:03,900 --> 00:18:06,340
!انظُر، لقد أغضبتَه أكثر

264
00:18:18,400 --> 00:18:19,310
!فيمون

265
00:18:19,310 --> 00:18:20,380
!دايسكي

266
00:18:21,020 --> 00:18:21,870
!فيمون

267
00:18:22,190 --> 00:18:24,060
!فيمون! تطوَّر الآن

268
00:18:27,140 --> 00:18:28,310
...دايسكي

269
00:18:47,150 --> 00:18:49,610
...فيمون، تطوَّر

270
00:18:54,250 --> 00:18:56,170
!أكس فيمون

271
00:19:00,310 --> 00:19:02,780
!تطوّرَ فيمون أخيراً إلى مُستوى بالِغ

272
00:19:03,770 --> 00:19:10,720
أكس فيمون

273
00:19:03,770 --> 00:19:10,720
:الحركة المُميّزة
القضم القويّ
:الحركة الخاصَّة
اللّيزر-أكس

274
00:19:04,020 --> 00:19:05,310
!أكس فيمون

275
00:19:05,310 --> 00:19:07,310
...استخدمَ فيمون قِواه الأصليّة للتطوُّر

276
00:19:07,310 --> 00:19:09,000
إلى ديجيمون بالِغ تنّين طَيفيّ

277
00:19:09,000 --> 00:19:10,750
تقنيّتُه الخاصَّة هي اللّيزر أكس

278
00:19:27,360 --> 00:19:29,700
!سُلامَى القشرة

279
00:19:41,180 --> 00:19:43,690
!اللّيزر أكس

280
00:19:57,190 --> 00:19:59,000
!فعلتَها يا أكس فيمون

281
00:19:59,000 --> 00:20:00,120
!أبليتَ حسناً

282
00:20:11,070 --> 00:20:12,130
!لا تنظُر

283
00:20:17,950 --> 00:20:19,990
!نحن لا ننظُر

284
00:20:24,800 --> 00:20:27,530
!غسلَ تورتامون يديه

285
00:20:27,530 --> 00:20:29,620
إنَّه عقلانيٌّ إذا تكلّمنا معه وحسب

286
00:20:29,620 --> 00:20:30,470
أجل

287
00:20:36,070 --> 00:20:38,190
هل انتهيتُما من اللّعِب؟

288
00:20:38,190 --> 00:20:40,410
!أخبرتُك لم نكُن نلعب

289
00:20:40,950 --> 00:20:41,820
ما رأيك؟

290
00:20:41,820 --> 00:20:44,880
!تطوّرَ فيمون إلى أكس فيمون بمُستوى بالِغ

291
00:20:45,120 --> 00:20:48,600
هذا يعني أنَّ مشروعنا الإصلاحيّ يُمكن
!أن ينتهي في وقتٍ أبكر

292
00:20:48,600 --> 00:20:52,260
علينا أن ندع أكس فيمون ودايسكي
!يبذلان جهداً إضافيّاً في العمل

293
00:20:52,260 --> 00:20:52,580
!صحيح

294
00:20:52,580 --> 00:20:53,940
!ماذا؟

295
00:22:36,790 --> 00:22:38,320
تعوم فُقاعة بعيداً

296
00:22:38,640 --> 00:22:42,100
ذِكريات كين مع أخيه الأكبر أوسامو

297
00:22:42,100 --> 00:22:45,300
والِدا كين لا يُركِّزان سوى على ابنهما الموهوب أوسامو

298
00:22:45,920 --> 00:22:48,100
الوحدة. الحزن

299
00:22:48,100 --> 00:22:49,140
ثمَّ الغضب

300
00:22:49,650 --> 00:22:51,430
،في أحلامِه

301
00:22:51,430 --> 00:22:53,690
الماضي السرِّي الخاص بكين إتشيجوجي
يتردَّد مِراراً وتِكراراً

302
00:22:53,920 --> 00:22:56,250
!الحلقة القادمة من مغامرة الدّيجيمون 02

303
00:22:56,250 --> 00:22:58,480
"عندما يتلوّثُ الجهازُ الرقميّ بواسطة الظَّلام""

304
00:22:58,480 --> 00:23:00,990
!البوّابة المؤدّية إلى المغامرة مفتوحة الآن