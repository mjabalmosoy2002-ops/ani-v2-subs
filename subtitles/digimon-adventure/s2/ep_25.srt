1
00:01:35,130 --> 00:01:38,250
ديجيمون غامض أنقذَ إيوري وأنكيلومون من الخطر

2
00:01:38,620 --> 00:01:42,860
كان ذلك الدِّيجيمون ستينغمون، شكل
بالغ من وارمون

3
00:01:54,150 --> 00:01:59,320
تفاجأ الأطفالُ وارتبَكوا عندما عَلِموا بهذا

4
00:02:05,310 --> 00:02:08,180
"أكويلامون - فارِسُ السّماء

5
00:02:16,450 --> 00:02:19,350
لكن لدى كين إتشيجوجي بعضُ الإيجابيّات

6
00:02:19,350 --> 00:02:20,390
أتعتقِد ذلك؟

7
00:02:20,390 --> 00:02:22,860
أجل، فقد أنقذَنا

8
00:02:22,860 --> 00:02:24,260
في النِّهاية، هذا ما حدَث

9
00:02:25,630 --> 00:02:28,550
إذاً تعتقِدين أنَّه كانَ يُخفي نوايا أُخرى؟

10
00:02:28,550 --> 00:02:29,700
لا أعلم

11
00:02:29,700 --> 00:02:31,090
ماذا تقصُدين بذلك؟

12
00:02:31,720 --> 00:02:33,150
...في الواقِع

13
00:02:33,150 --> 00:02:35,560
أعتقِد علينا مُراقبته أكثر

14
00:02:39,540 --> 00:02:43,690
حدثَتْ أمور كثيرة، لكن علينا نسيان الماضي

15
00:02:48,890 --> 00:02:50,590
أعتقِد أن الأمر ليسَ بتِلك السُّهولة

16
00:02:54,880 --> 00:02:57,020
!ليسَ كذلك بالطّبع

17
00:02:57,020 --> 00:03:01,500
لا سيّما إذا تذكّرنا أنَّ الدِّيجيمونات تأذَّتْ منه

18
00:03:01,850 --> 00:03:04,970
لكنّه لم يعُد إتشيجوجي السّابِق

19
00:03:05,230 --> 00:03:06,500
أتعتقِد ذلك؟

20
00:03:06,500 --> 00:03:07,640
!أجل

21
00:03:07,640 --> 00:03:10,050
...أظنُّه أدركَ أخيراً

22
00:03:10,050 --> 00:03:13,930
أنَّ الدِّيجيمونات هي كائنات حيّة
عندما ماتَ وارمون

23
00:03:14,180 --> 00:03:17,640
،لكن قبلَ أيّامٍ في المعركة، رُغمَ أنّه كانَ عدوّاً

24
00:03:17,640 --> 00:03:18,900
قتلَ ديجيموناً

25
00:03:26,550 --> 00:03:28,450
الأمر يُحيّرني

26
00:03:29,020 --> 00:03:32,080
هل يمكنُك أن تجزم حقّاً أنّه تغيَّر؟

27
00:03:34,650 --> 00:03:35,400
!تبَّاً

28
00:03:36,960 --> 00:03:38,330
!دايسكي

29
00:03:38,890 --> 00:03:40,590
ما خطبُ دايسكي-كن؟

30
00:03:40,590 --> 00:03:43,590
يريد أن ينضمَّ كين إتشيجوجي معنا

31
00:03:43,590 --> 00:03:45,270
أنا مُعارضٌ لذلك

32
00:03:45,270 --> 00:03:50,220
وأنا أيضاً. لا أعتقِد أنَّ إتشيجوجي-كن يريدُ الانضمام

33
00:03:50,220 --> 00:03:52,530
النّاسُ لا يتغيّرون بتلك السُّهولة

34
00:03:52,820 --> 00:03:57,030
لا، أعتقد أنَّ إتشيجوجي قد تغيّرَ
مثلما قالَ دايسكي-كن

35
00:03:57,900 --> 00:04:01,790
بالمناسبة، لماذا برأيك عادَت الأبراج
الظلاميّة للعملِ من جديد؟

36
00:04:01,790 --> 00:04:04,160
ولماذا اختفى ذاك البرج؟

37
00:04:07,920 --> 00:04:10,130
ماذا أصابَ إتشيجوجي-كن؟

38
00:04:10,130 --> 00:04:11,890
انخفضَتْ درجاتُه

39
00:04:11,890 --> 00:04:14,750
لعلّه لم يعُد يأبه لامتحانات المدرسة

40
00:04:11,900 --> 00:04:15,870
أعلى الدّرجات

41
00:04:14,750 --> 00:04:15,860
هل يتكاسَل؟

42
00:04:15,860 --> 00:04:18,510
لكن لا يَبدو لي كذلك

43
00:04:18,940 --> 00:04:19,830
الأمرُ غامِض

44
00:04:29,260 --> 00:04:30,070
!مرحباً

45
00:04:33,040 --> 00:04:35,130
حسناً، عمَّاذا أردتَ أن تتكلَّم؟

46
00:04:35,950 --> 00:04:40,330
أتعتقِد أنَّه يُمكِن الاعتِذار من الجميع والدِّيجيمونات؟

47
00:04:40,610 --> 00:04:43,960
بالطبع، هذا إذا أردتَ فقط

48
00:04:43,960 --> 00:04:46,460
سأرتِّب للأمر. ما رأيُك؟

49
00:04:47,070 --> 00:04:48,110
مُوافِق

50
00:04:48,110 --> 00:04:49,030
حقّاً؟

51
00:04:49,400 --> 00:04:50,130
نعم

52
00:04:50,130 --> 00:04:52,320
!مُمتاز! يسرُّني أنَّنا تكلّمنا

53
00:04:53,790 --> 00:04:57,680
لكن... أتعتقِد أنَّهم سيُسامحونني إذا اعتذرت؟

54
00:04:58,410 --> 00:05:03,620
لا أعلمُ ما إن كانَ سيحدثُ ذلك فوراً، لكن
أنا متأكّدٌ أنَّهم سيتفهَّمون

55
00:05:04,350 --> 00:05:05,750
أتظنُّ ذلك؟

56
00:05:05,750 --> 00:05:11,170
بالطبع! جميعُنا أطفالٌ مُختارون، صحيح؟

57
00:05:12,720 --> 00:05:14,500
أطفال مُختارون؟

58
00:05:14,770 --> 00:05:17,260
!أجل! جميعُنا أصدقاء

59
00:05:17,760 --> 00:05:18,950
...أصدقاء

60
00:05:20,620 --> 00:05:25,120
أنا آسف. لا أستطيع الاِنضمام لمجموعتِكم

61
00:05:25,120 --> 00:05:26,810
ماذا؟ لمَ لا؟

62
00:05:26,810 --> 00:05:28,230
!على أي حال، أنا آسِف

63
00:05:29,340 --> 00:05:30,710
...إتشيجوجي

64
00:05:35,480 --> 00:05:39,420
عظيم أنّه يعتذِر، لكن لماذا لا يُريد أن
يكون جزءاً من المجموعة؟

65
00:05:40,790 --> 00:05:44,670
أظنُّه يحتاج وقتاً حتّى تستقرّ مشاعِرُه

66
00:05:44,670 --> 00:05:45,670
هكذا إذاً

67
00:05:47,300 --> 00:05:49,490
!حاولَ دايسكي جاهِداً

68
00:05:49,490 --> 00:05:50,630
أجل

69
00:05:51,450 --> 00:05:56,820
لم تعُد نظرته مُزدرية كما كانَ من قبل

70
00:05:56,820 --> 00:05:59,100
بدا وكأنَّه عازِم

71
00:06:00,230 --> 00:06:01,640
لكن لماذا؟

72
00:06:02,060 --> 00:06:05,760
نعم. بكلِّ الأحوال، أتفهَّم ما كان دايسكي يُحاول قوله

73
00:06:06,130 --> 00:06:07,010
حسناً

74
00:06:09,370 --> 00:06:11,350
مياكو، ما الأمر؟

75
00:06:13,410 --> 00:06:15,950
أظنُّه صادِقاً

76
00:06:16,410 --> 00:06:17,640
أوتظنِّين ذلك؟

77
00:06:17,640 --> 00:06:21,600
أجل، لكن الأهمّ هي مشاعِرك

78
00:06:21,940 --> 00:06:23,460
مشاعري؟

79
00:06:23,460 --> 00:06:27,400
هل ستتمكَّنين من مُسامحةِ حبيبكِ؟

80
00:06:27,880 --> 00:06:33,820
في هذا الأسبوع، سيكون بِرج الجوزاء صاحِب
زمرة الدم أ-ب ذا حظٍّ سعيد إذا أفصح عن مشاعِره

81
00:06:33,820 --> 00:06:37,540
!لا تُسيئي الفهم! إنَّه ليس حبيبي

82
00:06:37,540 --> 00:06:42,200
في كلِّ الأحوال، لا تتحسَّري على قراركِ وحسب

83
00:06:43,990 --> 00:06:45,680
مشاعري؟

84
00:06:46,900 --> 00:06:48,880
مشاعري إذاً؟

85
00:06:49,130 --> 00:06:50,600
،إذا كان هذا يُؤرقكِ كثيراً

86
00:06:50,600 --> 00:06:53,830
فلِمَ لا تسألين كين إتشيجوجي بنفسكِ؟

87
00:06:53,830 --> 00:06:58,950
لكن لا أعرف رقمَه ولا عنوان بريده الإلكترونيّ

88
00:06:58,950 --> 00:07:03,320
كان عنوان بريده الإلكتروني مكتوباً في مجلَّة

89
00:07:03,320 --> 00:07:05,860
...معك حقّ! لكن

90
00:07:06,210 --> 00:07:10,350
ما الّذي يُفكِّرُ فيه يا تُرى؟

91
00:07:12,160 --> 00:07:13,770
!الآن يا ستينغمون

92
00:07:22,890 --> 00:07:28,360
ستينغمون

93
00:07:22,890 --> 00:07:28,360
