196
00:14:05,600 --> 00:14:08,600
لكن لِماذا؟

197
00:14:08,830 --> 00:14:09,850
!هيَّا بنا

198
00:14:10,800 --> 00:14:13,040
يُحاول تدمير البلدة

199
00:14:13,040 --> 00:14:16,420
ليسَ البلدة فقط، لكن الدِّيجيمونات تعيشُ هُناك أيضاً

200
00:14:16,420 --> 00:14:20,400
أعلمُ ذلك، لكن لِماذا؟

201
00:14:20,760 --> 00:14:23,000
لمَ يقومُ بفعلٍ شنيعٍ كهذا؟

202
00:14:23,000 --> 00:14:25,970
إن كانَ جادّاً، فعلينا استخدام قوّتنا
بلا تحفُّظٍ إذاً أيضاً

203
00:14:26,390 --> 00:14:28,460
ماذا تقصِد، دون تحفُّظ؟

204
00:14:28,920 --> 00:14:30,280
!نستخدِم كاملَ قوّتِنا ونهزمُه

205
00:14:30,620 --> 00:14:33,480
!تقصدُ قتله؟ لا يجوزُ لكَ ذلك

206
00:14:33,770 --> 00:14:36,950
!دايسكي، اِهدأ! علينا أن نهدأ ونُفكِّر

207
00:14:36,950 --> 00:14:38,920
نهدأ ونفعل ماذا؟

208
00:14:38,920 --> 00:14:43,090
نفعل ماذا...؟ أولويّتُنا هي حِمايةُ السَدّ

209
00:14:43,090 --> 00:14:44,510
دون تدمير العدوّ؟

210
00:14:44,510 --> 00:14:46,900
!إن أمكنَنا. لا بل يجب علينا ذلك

211
00:14:46,900 --> 00:14:51,160
هذا مُستحيل. قد نتمكَّن من إيقافِه

212
00:14:51,160 --> 00:14:52,930
لكن بشكلٍ مُؤقَّت فقط

213
00:14:54,170 --> 00:14:55,950
لِذا خيارُنا الوحيدُ هو تدميرُه؟

214
00:14:56,290 --> 00:14:59,650
مثلما فعلَ ستينغمون وكين إتشيجوجي-كن؟

215
00:15:00,700 --> 00:15:02,010
كيفَ استطاعَ ذلك؟

216
00:15:02,320 --> 00:15:04,270
لأنَّه كان يعلمُ أنَّها كانت الطريقة الوحيدة؟

217
00:15:04,270 --> 00:15:06,470
هل نحن ساذجون جدّاً؟

218
00:15:07,270 --> 00:15:12,460
!لن أفعلَ هذا! إذا فعلنا هذا، فلن نختلف عن شرورِه

219
00:15:12,760 --> 00:15:13,720
!معكَ حقّ

220
00:15:13,720 --> 00:15:15,920
لا! إيوري، أنت مُخطئ بشأنِه

221
00:15:16,220 --> 00:15:20,730
لا بُدَّ أنَّه كان هُناك سبب دفعَه لتدميرِ العدوّ

222
00:15:22,200 --> 00:15:27,290
لماذا تعتقِد ذلك؟ لأنَّك تُؤمِن بأنَّه تغيَّر؟

223
00:15:27,290 --> 00:15:29,130
لا أستطيع التَّفكير مثلك هكذا

224
00:15:30,000 --> 00:15:33,170
هل يعرِفُ أحدُكم عنوانَ البريدِ الإلكتروني
الخاص بكين إتشيجوجي؟

225
00:15:33,170 --> 00:15:33,770
ماذا؟

226
00:15:33,770 --> 00:15:35,670
أعرِفُه

227
00:15:35,950 --> 00:15:37,010
أعطِيني إيّاه

228
00:15:38,570 --> 00:15:40,120
ماذا تفعلين؟

229
00:15:40,120 --> 00:15:43,790
...لا بُدّ أنَّ لديه جهاز طرفيّ د أيضاً. لِهذا

230
00:15:43,790 --> 00:15:45,170
ستطلُبين مُساعدتَه؟

231
00:15:45,170 --> 00:15:46,670
أجل، أذلك خطأ؟

232
00:15:46,670 --> 00:15:49,630
لا، لكن هل سيأتي؟

233
00:15:49,970 --> 00:15:52,150
،أريدُه أن يأتي

234
00:15:52,150 --> 00:15:53,830
لكن لا أستطيع أن أكونَ صادِقة مع نفسي

235
00:16:01,700 --> 00:16:02,780
!هوكمون

236
00:16:04,240 --> 00:16:05,300
!تبَّاً

237
00:16:19,900 --> 00:16:22,360
،هذا سيّئ! إذا دُمِّرَ السَدّ

238
00:16:22,660 --> 00:16:24,440
!قُضي على تِلك البلدة

239
00:16:29,760 --> 00:16:31,100
!ستينغمون

240
00:16:32,940 --> 00:16:34,530
!هيَّا يا ستينغمون

241
00:16:36,200 --> 00:16:37,800
!أتى لإنقاذِنا

242
00:16:38,060 --> 00:16:41,120
!إتشيجوجي، شكراً

243
00:16:41,120 --> 00:16:43,780
!رأيتُم؟ إنَّه صديقٌ مُؤتمَن

244
00:16:43,780 --> 00:16:44,780
...أجل

245
00:16:45,290 --> 00:16:49,010
لعلَّ دايسكي كانَ على حقّ. يعرِفُ شيئاً

246
00:16:49,010 --> 00:16:50,750
...لِهذا... لِهذا

247
00:16:56,020 --> 00:16:58,350
!بالمون، أنتِ بخير

248
00:16:58,350 --> 00:17:01,160
ميمي، أين أنا؟

249
00:17:01,700 --> 00:17:05,570
ستينغمون يحمي السَدَّ من غوليمون

250
00:17:05,970 --> 00:17:10,800
ليس غوليمون. ذاك ليس غوليمون

251
00:17:10,800 --> 00:17:12,040
ماذا تقولين؟

252
00:17:12,310 --> 00:17:15,520
...يبدو كديجيمون

253
00:17:24,210 --> 00:17:27,190
لكنّه برجٌ ظلاميّ بالفعل

254
00:17:27,800 --> 00:17:29,570
!حُلَّ اللّغز

255
00:17:29,570 --> 00:17:32,300
،عندما ظهرَ ثاندربولمون

256
00:17:32,300 --> 00:17:35,170
بدا اختِفاء برجُ الظَّلام منطقيّاً

257
00:17:35,170 --> 00:17:38,590
!كانَ ذلك الشَّكل المُتحوِّل عن برجِ الظَّلام

258
00:17:38,590 --> 00:17:40,570
...صحيح! لِهذا السَّبب

259
00:17:40,570 --> 00:17:43,500
!لِهذا تمكّنَ من قتلِ العدوّ

260
00:17:43,920 --> 00:17:44,980
!ستينغمون

261
00:17:45,380 --> 00:17:49,170
أخطأتُ بشأنِه. أسأتُ فهمه

262
00:17:49,170 --> 00:17:51,340
لم يعُد نفس الشَّخص

263
00:17:51,340 --> 00:17:53,690
لم يعُد قيصر الدِّيجيمون

264
00:17:53,690 --> 00:17:55,930
!إنَّه صديقٌ الآن

265
00:17:59,590 --> 00:18:01,090
ماذا؟ ماذا؟

266
00:18:02,100 --> 00:18:03,780
ما الّذي يحدث داغيا؟

267
00:18:03,780 --> 00:18:05,840
...لا أدري

268
00:18:08,490 --> 00:18:11,760
!كين-كن... أنا آسفة

269
00:18:30,620 --> 00:18:35,220
...هوكمون، تطوَّر

270
00:18:36,990 --> 00:18:38,780
!أكويلامون

271
00:18:44,510 --> 00:18:52,470
أكويلامون

272
00:18:44,510 --> 00:18:52,470
بالغ
ديجيمون طائر عملاق

273
00:18:44,510 --> 00:18:52,470
:الحركات الخاصّة
قرنُ الانسياب
اللّيزر المُتفجِّر

274
00:18:44,830 --> 00:18:45,920
!أكويلامون

275
00:18:45,920 --> 00:18:48,160
ديجيمون طائر عملاق يستطيع
...التَّحليق بسرعةِ الصّوت

276
00:18:48,160 --> 00:18:50,480
ولديه القدرة على رؤيةِ الأعداء من بَعيد

277
00:18:50,480 --> 00:18:52,460
!تقنيّتُه الخاصَّة هي القرنُ الانسيابيّ

278
00:18:55,280 --> 00:19:00,210
!أكويلامون! إنّه برجٌ ظلاميّ. لا، ديجيمون

279
00:19:00,500 --> 00:19:04,060
!هكذا إذاً! لا تحفُّظ إذاً

280
00:19:12,160 --> 00:19:13,400
!اللّيزر الانفجاريّ

281
00:19:19,730 --> 00:19:21,320
!هيَّا بنا يا ستينغمون

282
00:19:22,280 --> 00:19:25,180
!النِّهاية المُدبَّبة

283
00:19:35,280 --> 00:19:36,910
!اقضِ عليه يا أكويلامون

284
00:19:39,120 --> 00:19:40,940
!القرنُ الانسيابيّ

285
00:19:46,820 --> 00:19:50,120
!نجحوا

286
00:19:53,220 --> 00:19:56,980
لن أختلِقَ أي عذر. أنا آسِفٌ حقَّاً

287
00:20:00,670 --> 00:20:03,910
بالمُناسَبة، من كانَتْ تِلك المرأة؟

288
00:20:04,350 --> 00:20:07,770
...لا أعلم أيضاً. كلُّ ما أعرفه

289
00:20:07,770 --> 00:20:10,900
أنَّها تصنع ديجيمونات من أبراج الظَّلام

290
00:20:10,900 --> 00:20:15,590
وأنَّ تِلك الأبراج يمكنها العمل من جديد
عندما تقترِبُ هي منها

291
00:20:15,590 --> 00:20:19,460
لماذا لم تُخبرْنا من قبل إن كنتَ تعلمُ ذلك؟

292
00:20:19,460 --> 00:20:20,670
...هذا لأنَّ

293
00:20:20,670 --> 00:20:23,600
اعتقدنا أنّني وكين-تشان نستطيع
تولِّي هذا الأمر

294
00:20:23,920 --> 00:20:26,510
!ليسَ عليكما أن تكونا هكذا

295
00:20:26,510 --> 00:20:29,630
لكن... هذه غلطتي أنا

296
00:20:29,630 --> 00:20:32,610
ألِهذا رفضتَ الانضمام لنا؟

297
00:20:34,970 --> 00:20:37,110
سأذهبُ الآن

298
00:20:37,110 --> 00:20:38,820
!انتظِر، إتشيجوجي

299
00:21:01,570 --> 00:21:03,940
.سأنتظِر اليوم الّذي تنضمُّ فيه لنا

300
00:21:03,940 --> 00:21:06,610
.شكراً جزيلاً لكَ على اليوم

301
00:21:06,610 --> 00:21:07,580
من مياكو

302
00:22:37,430 --> 00:22:39,450
تخرجُ طاقةٌ ظلاميّةٌ عن السَّيطرة

303
00:22:39,450 --> 00:22:41,880
...قد يقعُ الانفجارُ في أيّ لحظة

304
00:22:42,300 --> 00:22:45,100
يقِفُ كين وحيداً للتكفيرِ عن خطاياه

305
00:22:45,660 --> 00:22:47,630
يحاولُ دايسكي أن يُقاتِلَ بجانبِه

306
00:22:48,080 --> 00:22:52,630
عندما يتقاطعُ إيمانهما معاً، يُصبِح
أكس فيمون وستينغمون واحداً

307
00:22:52,630 --> 00:22:54,840
!الحلقة القادمة من مغامرة الدّيجيمون 02

308
00:22:54,840 --> 00:22:57,950
"تطوُّر اتّحادي، اتِّحاد القلوب"

309
00:22:57,950 --> 00:23:00,190
!البوّابة المؤدّية إلى المغامرة مفتوحة الآن