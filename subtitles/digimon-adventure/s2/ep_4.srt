1
00:01:30,930 --> 00:01:32,700
يُعادي دايسكي وأصدقاءه

2
00:01:32,700 --> 00:01:34,550
إنّه الفتى الغامض، قيصر الدّيجيمون

3
00:01:35,490 --> 00:01:38,000
والدّيجيمونات التي وقعت تحت تأثير
تعويذته الشرّيرة

4
00:01:38,000 --> 00:01:39,940
هاجمت الأطفال

5
00:01:46,370 --> 00:01:49,330
...لكن عندما تأزّمت الأمور

6
00:01:49,330 --> 00:01:52,100
تاكيرو وهيكاري، اللّذان اكتشفا بيضة
،رقميّة جديدة

7
00:01:52,100 --> 00:01:54,680
،جعلا باتامون وتيلمون يتطوّران تطوُّراً درعيّاً

8
00:01:54,680 --> 00:01:57,570
وأحبطا مخطّط قيصر الدّيجيمون

9
00:02:05,680 --> 00:02:08,290
"قيصر الدّيجيمون ، ملِك الظّلام"

10
00:02:10,360 --> 00:02:12,060
اللّهبُ الصَّغير

11
00:02:13,080 --> 00:02:14,190
نطحة فيمون

12
00:02:14,190 --> 00:02:15,450
اهربوا جميعاً

13
00:02:16,150 --> 00:02:18,150
بسُرعة، من هُنا يا جماعة

14
00:02:24,320 --> 00:02:25,810
نجحَتْ خطَّتُنا

15
00:02:25,810 --> 00:02:28,440
أحسنتُم صنعاً جميعاً

16
00:02:28,440 --> 00:02:33,670
أودُّ رؤية وجه ذلك المدعو قيصر الدّيجيمون عندما يعلم بهذا

17
00:02:33,670 --> 00:02:34,980
ولكن هذا غريب

18
00:02:34,980 --> 00:02:36,110
ما هو؟

19
00:02:36,110 --> 00:02:40,220
الحراسةُ الأمنيّة هُنا كانَتْ سيّئة. ولم يكُن موجوداً أيضاً

20
00:02:40,220 --> 00:02:44,100
رُبَّما كانت له خطط أخرى وذهب لمكانٍ آخر

21
00:02:44,100 --> 00:02:47,160
ماذا؟ لقد خافَ منَّا فقط وهرب

22
00:02:47,160 --> 00:02:49,040
أليسَ كذلك يا هيكاري-تشان؟

23
00:02:49,840 --> 00:02:52,600
أتَّفِقُ مع تاكيرو-كن

24
00:02:53,560 --> 00:02:57,280
ولكن ماذا سيحاولُ أن يفعلَ برأيكم؟

25
00:02:57,280 --> 00:03:00,270
على أيّ حال، لنعد إلى المدرسة

26
00:03:00,760 --> 00:03:03,490
لا بدَّ وأنَّ كوشيرو ومياكو-تشان قلقان

27
00:03:18,630 --> 00:03:20,840
أصبح واحد آخر لي

28
00:03:24,540 --> 00:03:28,580
هل ترون ذلك البرج الأسود؟ إنَّه برجُ ظلام

29
00:03:28,580 --> 00:03:31,830
أينما يتواجدُ، تكونُ مُستوطنتي

30
00:03:31,830 --> 00:03:34,440
وكلّكم خدمي

31
00:03:35,020 --> 00:03:36,230
مفهوم؟

32
00:03:37,410 --> 00:03:40,190
جميعهم تحت سيطرة الحلقات

33
00:03:43,480 --> 00:03:46,450
لماذا أحضرتُم الغوتسومون إلى هُنا أيضاً؟

34
00:03:46,450 --> 00:03:48,120
لم يكن أمامنا خيار

35
00:03:48,120 --> 00:03:51,420
...فنحنُ لا نعرفُ متى سيعودُ قيصر الدّيجيمون

36
00:03:51,420 --> 00:03:52,160
أليسَ كذلك؟

37
00:03:52,160 --> 00:03:52,830
نعم

38
00:03:53,080 --> 00:03:56,550
كيف سأشرح الأمر لفوجياما-سينسي إذا كشفنا؟

39
00:03:56,550 --> 00:04:00,500
لا بأس، فقد تمرنّا على شيءٍ تحسُّباً لهذا

40
00:04:00,500 --> 00:04:01,820
جاهزون؟

41
00:04:03,250 --> 00:04:05,810
حسناً؟ ألا يُشبهون التّماثيل هكذا؟

42
00:04:07,610 --> 00:04:11,830
مياكو-كن، هل يُمكنني أن أستعيرَ جهازكِ الرَّقمي قليلاً؟

43
00:04:12,580 --> 00:04:13,840
لماذا؟

44
00:04:13,840 --> 00:04:19,260
لا بُدَّ وأنَّ أجهزتَكم الرَّقميّة لها القدرة على فتحِ البوَّابة، صحيح؟

45
00:04:19,260 --> 00:04:22,530
أجل، ينبغي ذلك، لأنّ أجهزتنا لا تفعل ذلك

46
00:04:23,050 --> 00:04:27,240
يمكننا أن ندع دايسكي والبقيّة يفتحون البوّابة
...ثمّ نتبعهم، لكن

47
00:04:27,510 --> 00:04:30,950
أريد أن أرى ما يجري فقط. هل لديكِ مانع؟

48
00:04:33,750 --> 00:04:36,210
هيّا، إلى المنطقةِ التالية، بسُرعة

49
00:04:40,420 --> 00:04:43,860
حسناً، إنَّه يُغادر. حانَ وقتُ الهرب

50
00:04:43,860 --> 00:04:45,890
نار صغيرة

51
00:04:53,720 --> 00:04:58,250
هل ظننتُم أنَّكم قادرون على الهرب؟ هذا مُستحيل

52
00:04:58,250 --> 00:04:59,230
...أنت

53
00:04:59,230 --> 00:05:02,690
النّبتة الناضجة المُخيفة ريدفيجيمون

54
00:05:04,240 --> 00:05:07,940
ريدفيجيمون، ديجيمون ماكر وناضج كليّاً

55
00:05:07,940 --> 00:05:11,660
تقنيّته الخاصّة هي نَفسه السيّئ جدّاً، النَفس الخطر

56
00:05:11,910 --> 00:05:13,200
ماذا ستفعل؟

57
00:05:13,200 --> 00:05:15,170
مُحاولةُ الهرب جريمةٌ خطيرة

58
00:05:15,170 --> 00:05:18,210
والعقوبةُ هي مئة جلدة

59
00:05:19,380 --> 00:05:20,800
ستّة وستّون

60
00:05:21,770 --> 00:05:23,450
سبعة وستّون

61
00:05:23,860 --> 00:05:25,760
ثمانية وستّون

62
00:05:25,760 --> 00:05:26,700
تسعة وستّون

63
00:05:27,250 --> 00:05:28,740
سبعون

64
00:05:28,740 --> 00:05:30,640
واحد وسبعون

65
00:05:30,640 --> 00:05:32,310
اثنان وسبعون

66
00:05:33,000 --> 00:05:34,640
ثلاثة وسبعون

67
00:05:44,940 --> 00:05:49,200
انتهيتُ عندَ الثَّالثة والسَّبعين، أشكُّ في أنّه حيّ

68
00:05:55,660 --> 00:05:57,450
...لن أموت

69
00:05:57,620 --> 00:06:00,580
...عليّ تحذيرهم بطريقةٍ ما

70
00:06:00,910 --> 00:06:03,130
...الجميع... وياماتو

71
00:06:07,750 --> 00:06:15,410
لا أستطيع استخدامه كدرع

72
00:06:15,410 --> 00:06:21,500
أنا بخير من تلقاء نفسي

73
00:06:21,500 --> 00:06:34,370
سأمشي حتّى على حدّ سكّين

74
00:06:34,380 --> 00:06:39,370
إذاً علينا إيجاد مكانٍ اختباء لغوتسومون وأصدقائه

75
00:06:39,790 --> 00:06:42,110
هل تعرفُ أيّ مكانٍ جيّد يا أخي الكبير؟

76
00:06:42,110 --> 00:06:43,410
...ليسَ تماماً

77
00:06:43,410 --> 00:06:44,950
هل يمكنني الحصول على توقيعك؟

78
00:06:44,950 --> 00:06:45,820
أكيد

79
00:06:46,550 --> 00:06:47,850
اسمك؟

80
00:06:47,850 --> 00:06:49,950
موتوميا، موتوميا جون

81
00:06:49,950 --> 00:06:51,900
ماذا؟ موتوميا جون؟

82
00:06:51,900 --> 00:06:54,220
هل أنتِ أختُ دايسكي-كن الكبرى؟

83
00:06:54,220 --> 00:06:56,220
نعم، ولكن... من أنت؟

84
00:06:56,490 --> 00:06:58,590
إنَّه أخي الصَّغير تاكيرو

85
00:06:58,590 --> 00:07:02,060
سُرِرتُ بلقائك. دايسكي-كن هو زميلي في الصفّ

86
00:07:02,060 --> 00:07:04,970
!حقّاً؟ أنت ظريف جدّاً

87
00:07:04,970 --> 00:07:06,100
أيمكنك التّوقيع هنا أيضاً؟

88
00:07:06,900 --> 00:07:09,400
دايسكي ليس ظريفاً على الإطلاق

89
00:07:09,800 --> 00:07:12,340
ليتَ لديّ أخ مثلكما

90
00:07:13,830 --> 00:07:16,160
غابومون

91
00:07:17,240 --> 00:07:18,790
محطَّتي الطرفيّة أيضاً

92
00:07:19,200 --> 00:07:22,790
تمّ تلقّي إشارة نجدة. توجّهوا"
"إلى مختبر الحاسوب... مياكو

93
00:07:23,190 --> 00:07:24,200
أخي

94
00:07:24,200 --> 00:07:25,580
هل هو غابومون يا تُرى؟

95
00:07:33,270 --> 00:07:35,120
...أيُّها الأطفال المُختارون

96
00:07:35,120 --> 00:07:35,970
انطلِقوا

97
00:07:52,280 --> 00:07:53,320
غابومون

98
00:07:54,910 --> 00:07:56,080
ياماتو؟

99
00:07:56,080 --> 00:07:58,220
...تماسك يا غابومون

100
00:08:00,240 --> 00:08:01,500
أردتُ رؤيتك

101
00:08:01,760 --> 00:08:03,960
ما الأمر؟ ماذا حدث؟

102
00:08:03,960 --> 00:08:05,710
...في الواقع

103
00:08:06,140 --> 00:08:07,270
يا جماعة

104
00:08:07,270 --> 00:08:11,110
سأذهبُ إلى منزلِ إيزومي-سينباي
للحصول على جهازي الرّقميّ

105
00:08:11,110 --> 00:08:15,110
بينما أنا سأعملُ هُنا كمسؤول تواصل

106
00:08:15,670 --> 00:08:16,580
حسناً

107
00:08:17,100 --> 00:08:21,140
يمكنُ استخدام هذا التلفزيون لإرسالِ إشارة نجدة للعالمِ الآخر

108
00:08:21,140 --> 00:08:25,070
قالَ آغومون بأنَّه قد اتَّصلَ بتايتشي عبرَ تلفزيون

109
00:08:25,850 --> 00:08:27,190
حقَّاً؟

110
00:08:31,300 --> 00:08:33,280
كان ذلك في بلدة سانتا غيريا

111
00:08:33,750 --> 00:08:39,470
كانَتْ بلدة مُسالِمة، ولكن... عندما ظهر قيصر
الدّيجيمون، حُبِسَت كلّ ديجيمونات البلدة

112
00:08:40,460 --> 00:08:41,850
...ذلك البرج

113
00:08:41,850 --> 00:08:44,100
يشبه البرج الذي كان في المكان الّذي فيه الغوتسومون

114
00:08:44,100 --> 00:08:45,740
يُدعى برج ظلام

115
00:08:45,740 --> 00:08:47,450
شيَّدَه قيصر الدِّيجيمون

116
00:08:47,450 --> 00:08:48,320
حسناً، هيَّا بنا

117
00:08:48,320 --> 00:08:49,090
انتظر

118
00:08:49,670 --> 00:08:55,110
أريد تذكيرك أنّ هدفنا هو تحرير الدّيجيمون

119
00:08:55,110 --> 00:08:56,600
أعلمُ ذلك

120
00:08:56,600 --> 00:08:59,410
سيكونُ هذا سهلاً مع التطوُّرِ الدرعيّ

121
00:08:59,410 --> 00:09:00,260
لا يُمكنُنا فعل ذلك

122
00:09:00,960 --> 00:09:05,190
إن فعلنا هذا فقد يستخدمون الدِّيجيمون المأسورين كدروع

123
00:09:05,190 --> 00:09:06,230
هذا صحيح

124
00:09:06,230 --> 00:09:10,140
لن نستفيدَ شيئاً حينها، فقد أتينا لتحرير الرّهائن

125
00:09:11,280 --> 00:09:13,290
الحُرَّاسُ هم فيجيمون، صحيح؟

126
00:09:13,840 --> 00:09:15,740
سأجهّز هجوم فضلات

127
00:09:16,340 --> 00:09:18,880
ذكّرني من كان ريدفيجيمون؟

128
00:09:18,880 --> 00:09:19,700
...في الواقع

129
00:09:19,700 --> 00:09:22,210
إنَّهم يستبعِدوننا من الحديث

130
00:09:22,210 --> 00:09:24,180
إيوري، ليس علينا تحمّل هذا

131
00:09:24,180 --> 00:09:25,990
لا، هناك الكثير ممّا يمكننا تعلّمه منهم

132
00:09:28,800 --> 00:09:31,240
حسناً إذاً، سنتسلّلُ إلى داخل السّجن

133
00:09:31,240 --> 00:09:32,880
انتظروا

134
00:09:32,880 --> 00:09:36,270
هيكاري-تشان ستأتي معنا؟ أُعارضُ ذلك

135
00:09:36,270 --> 00:09:38,390
...بوجودِ هجمات فضلات وما شابه

136
00:09:38,390 --> 00:09:39,860
...لا تقلق

137
00:09:39,860 --> 00:09:43,260
شهدتِ هجمات فضلات في المُغامرة السابقة، صحيح؟

138
00:09:43,260 --> 00:09:43,850
نعم

139
00:09:44,330 --> 00:09:48,060
تاكيرو، ألا تملك ذرّة سياسة؟

140
00:09:48,060 --> 00:09:49,280
سياسة؟

141
00:09:49,280 --> 00:09:51,420
أظنّه يقصد كياسة

142
00:09:56,510 --> 00:10:00,200
توقّفوا، من أنتُم؟

143
00:10:00,670 --> 00:10:04,160
لقد قبضنا على الدِّيجيمون الّذي هربَ هو وأصدقاؤه

144
00:10:04,420 --> 00:10:06,500
سنزجُّكم في السّجنِ حالاً

145
00:10:06,500 --> 00:10:08,810
هيّا، أسرعوا

146
00:10:15,960 --> 00:10:18,260
لم يلحظوا بأنّها حلقات مُزيّفة

147
00:10:18,260 --> 00:10:20,790
ولكن ينبغي أن نظلَّ حذرين

148
00:10:20,790 --> 00:10:24,710
فنحن متوجّهون إلى وسط معقل العدوّ

149
00:10:45,540 --> 00:10:47,670
هيّا، كفى تباطؤاً

150
00:10:47,670 --> 00:10:50,970
ستُعاقَبون بمئةِ جلدة غداً

151
00:10:52,500 --> 00:10:54,400
أحسنتُم صنعاً جميعاً

152
00:10:56,070 --> 00:10:57,920
أحسنتم صنعاً أيضاً

153
00:10:57,920 --> 00:10:59,090
لكمةُ القطّ

154
00:11:05,730 --> 00:11:06,800
توقَّفوا

155
00:11:08,440 --> 00:11:11,340
انتشرَ الحرسُ في كلّ مكانٍ فجأة

156
00:11:11,340 --> 00:11:13,040
حانَ دورُنا الآن

157
00:11:13,040 --> 00:11:17,410
لحظة. هل تريدُ أن تخسرَ الدِّيجيمونات الّتي أنقذناها للتوّ؟

158
00:11:19,420 --> 00:11:22,790
لنصعد، حيثُ يوجدُ البرجُ الأسود

159
00:11:22,790 --> 00:11:23,740
أنا مُوافق

160
00:11:27,490 --> 00:11:28,970
!لماذا، لماذا؟

161
00:11:28,970 --> 00:11:29,710
...دايسكي

162
00:11:32,870 --> 00:11:34,670
...بالمناسبة يا دايسكي-كن

163
00:11:34,670 --> 00:11:36,970
التقيتُ بأختِك الكبرى اليوم

164
00:11:36,970 --> 00:11:39,840
وبعد؟

165
00:11:40,060 --> 00:11:42,890
تكلّمتْ عنّي بسوء، صحيح؟

166
00:11:42,890 --> 00:11:43,840
ليسَ تماماً

167
00:11:43,840 --> 00:11:45,710
بلى، لقد فعلَتْ

168
00:11:45,710 --> 00:11:49,440
فهي دائماً ما تُسيء الكلام عنِّي أمام الجميع

169
00:11:49,440 --> 00:11:54,890
إنّها لا تحبّني... وكذلك أنا، لذا نحن مُتعادِلان

170
00:11:54,890 --> 00:11:56,830
عمّاذا تتكلّم؟

171
00:11:56,830 --> 00:11:57,820
ماذا؟

172
00:11:57,820 --> 00:12:01,050
لو كنتَ أخي الصَّغير، لما سامحتُك على ذلك

173
00:12:01,050 --> 00:12:02,280
!كنتُ لأضربك

174
00:12:02,280 --> 00:12:05,120
!مُثير! تعال واضربني إذاً

175
00:12:05,310 --> 00:12:06,550
توقَّف

176
00:12:06,550 --> 00:12:09,690
لن تضربَه. ما كنتَ لتفعل ذلك، صحيح؟

177
00:12:10,320 --> 00:12:14,710
لن أفعل. لكن انتبه لكلامك

178
00:12:14,710 --> 00:12:17,210
لِمَ لا يصمت فحسب؟

179
00:12:17,210 --> 00:12:21,280
يحقُّ لي أن أقولَ ما أُريد عن تِلك الفتاةِ الغبيّة

180
00:12:21,760 --> 00:12:23,370
توقَّف يا دايسكي-كن

181
00:12:24,500 --> 00:12:27,640
أكرهُ النَّاسَ الّذين يتكلَّمون بسوءٍ عن شقيقاتهم

182
00:12:27,640 --> 00:12:28,890
تكرهين؟

183
00:12:29,880 --> 00:12:33,810
كره

184
00:12:33,810 --> 00:12:35,060
مَقت

185
00:12:41,310 --> 00:12:42,240
...دايسكي

186
00:12:42,240 --> 00:12:46,240
...إنّها تكرهني... هيكاري-تشان تكرهني

187
00:12:46,850 --> 00:12:49,850
...هذه أوَّل مرَّة أرى فيها دايسكي هكذا

188
00:12:50,300 --> 00:12:51,590
عليّ الرَّفع من معنوياتِه

189
00:12:52,010 --> 00:12:52,990
دايسكي

190
