1
00:01:32,190 --> 00:01:35,910
مفاعل الطاقة الّذي كان يغذِّي
...قاعِدة قيصر الدِّيجيمون سابِقاً

2
00:01:35,910 --> 00:01:38,320
كان على وشك أن ينفجِر في أيّ لحظة

3
00:01:40,890 --> 00:01:44,360
وامرأةٌ غامِضةٌ أرسلَتْ ديجيموناً بمُستوى مِثالي

4
00:01:47,910 --> 00:01:52,110
يتحالفُ دايسكي وكين في القِتال
مُواجِهَين الخطر المُضاعَف

5
00:01:52,920 --> 00:01:55,750
،تتوحُّدِ مشاعرهما

6
00:01:55,750 --> 00:01:58,220
الدِّيجيمونان يتّحِدان ويُصبحان واحداً

7
00:02:05,510 --> 00:02:08,060
".المزيج الّذي لا نظير له! بايلدرامون"

8
00:02:14,080 --> 00:02:15,560
!أكس فيمون

9
00:02:18,020 --> 00:02:19,400
!ستينغمون

10
00:02:21,370 --> 00:02:23,250
...تطوُّر جوغريس

11
00:02:26,210 --> 00:02:27,900
!بايلدرامون

12
00:02:33,030 --> 00:02:40,000
بايلدرامون

13
00:02:33,030 --> 00:02:40,000
مِثاليّ
ديجيمون إنسان تنّين

14
00:02:33,310 --> 00:02:34,360
!بايلدرامون

15
00:02:34,360 --> 00:02:37,780
ديجيمون إنسان تنّين تطوّر تطوُّر
جوغريس من أكس فيمون وستينغمون

16
00:02:37,780 --> 00:02:40,000
تقنيّتُه الخاصّة هي ناسِف اليأس

17
00:02:42,310 --> 00:02:43,540
!بايلدرامون

18
00:02:46,090 --> 00:02:47,590
اندمجا

19
00:02:47,590 --> 00:02:49,270
!تطوُّر جوغريس؟

20
00:02:56,440 --> 00:02:58,360
أوكوامون، اقضِ عليه

21
00:03:06,840 --> 00:03:08,120
!يا لها من قوّة

22
00:03:24,010 --> 00:03:25,810
!يا لها من معركة

23
00:03:25,810 --> 00:03:29,360
يُقاتِلُ أوكوامون ذا المُستوى المِثالي بشكلٍ مُتكافئ

24
00:03:29,800 --> 00:03:34,130
لكن ليتنا نستطيعُ التطوُّر للمُستوى المِثالي

25
00:03:34,420 --> 00:03:36,830
يستطيعُ بايلدرامون هزيمته بكلِّ تأكيد

26
00:03:37,160 --> 00:03:41,130
لكن لم يكُن عليه الاتّحاد مع ديجيمون كين إتشيجوجي

27
00:03:45,830 --> 00:03:46,770
!يا لها من سرعة

28
00:03:49,190 --> 00:03:50,980
ألا تعتقِد أنَّ هذا مُذهِل؟

29
00:03:50,980 --> 00:03:51,920
لا أعلم

30
00:03:51,920 --> 00:03:54,450
!إنَّه ديجيموننا الشَّريك

31
00:03:54,680 --> 00:03:55,730
هل هو...؟

32
00:04:00,280 --> 00:04:03,310
ديجيموني وموتوميا-كن الشَّريك؟

33
00:04:01,020 --> 00:04:03,770
!أجل، هكذا. أحسنت صُنعاً

34
00:04:04,340 --> 00:04:06,250
!أجهِز عليه

35
00:04:06,960 --> 00:04:08,720
!استخدِما شارةَ الحنان بسُرعة

36
00:04:09,150 --> 00:04:10,130
!حسناً

37
00:04:10,790 --> 00:04:12,000
!عُلِم

38
00:04:12,570 --> 00:04:13,930
ينبغي أن نلحقَ بهما

39
00:04:13,930 --> 00:04:15,050
!ما زال بمقدورِنا فعلها

40
00:04:16,590 --> 00:04:18,540
لن أدعكم تفلَتون

41
00:04:18,930 --> 00:04:22,000
!أوكوامون، اقضِ على الأطفال

42
00:04:24,990 --> 00:04:26,870
لن أدعَك تبتعِد أكثر

43
00:04:36,890 --> 00:04:39,020
لا يُمكننا المُواصلة أكثر

44
00:04:44,480 --> 00:04:47,650
يبدو أن ذلكما الاثنين يُشكِّلان الثُّنائي المِثاليّ

45
00:05:03,430 --> 00:05:04,550
!اجلب الشّارة

46
00:05:04,550 --> 00:05:05,370
حسناً

47
00:05:22,600 --> 00:05:23,680
!جيّد

48
00:05:25,800 --> 00:05:27,160
!فعلتُماها

49
00:05:27,450 --> 00:05:28,310
!أجل

50
00:05:32,810 --> 00:05:35,090
!مُمتاز! زالَ التشوُّه

51
00:05:35,510 --> 00:05:37,220
وردَتْ رِسالةٌ من كوشيرو-سان

52
00:05:37,940 --> 00:05:40,040
زالَ التشوُّه

53
00:05:40,280 --> 00:05:42,820
!مُمتاز! كلُّ شيء على ما يُرام الآن

54
00:05:42,820 --> 00:05:46,760
كنتُ خائفة قليلاً لأنّني ظننتُها ستنفجِر

55
00:05:46,760 --> 00:05:48,060
وكذلك أنا

56
00:05:48,410 --> 00:05:50,490
!بفضلِك، نجونا

57
00:05:55,970 --> 00:05:56,990
!ماذا؟

58
00:06:03,790 --> 00:06:04,870
لماذا؟

59
00:06:04,870 --> 00:06:06,440
!ستنفجِر

60
00:06:09,350 --> 00:06:12,820
لا! ألم نُعِد شارة الحنان؟

61
00:06:13,200 --> 00:06:14,810
!هذا سيّئ

62
00:06:16,630 --> 00:06:21,160
"هذه حالة طارئة. لقد عاد التشوُّه"

63
00:06:21,660 --> 00:06:23,600
!هذا غير منطقيّ البتّة

64
00:06:24,200 --> 00:06:26,480
،حالما أعيدَتْ شارة إتشيجوجي

65
00:06:26,480 --> 00:06:29,220
كان ينبغي أن يكونَ كلّ شيءٍ على ما يُرام

66
00:06:29,220 --> 00:06:33,070
...شارَتي نكِرة. إنَّها عديمةُ القيمة

67
00:06:33,360 --> 00:06:36,210
،لا، ليسَتْ كذلك. بسببِ شارة الحنان

68
00:06:36,210 --> 00:06:39,040
لم ينفجِرْ مفاعل الطّاقة

69
00:06:42,540 --> 00:06:44,500
أنا أقولُ الحقيقةَ فحسب

70
00:06:44,500 --> 00:06:48,750
هذا ما بيّنَه حاسوب كوشيرو-سان بوضوح

71
00:06:53,430 --> 00:06:55,550
إذاً ما الّذي سبّبَ هذا الانفجار؟

72
00:06:55,550 --> 00:06:59,460
!لا بُدَّ من وجودِ سبب... سبب آخر

73
00:06:59,910 --> 00:07:01,930
مع الأسف

74
00:07:02,970 --> 00:07:04,400
هل أنتِ من فعلَ هذا؟

75
00:07:04,400 --> 00:07:06,660
لا تلوموني

76
00:07:06,660 --> 00:07:10,050
هذا يُثبِت أنَّ الشَّارة الصّغيرة عديمةُ الجدوى

77
00:07:10,050 --> 00:07:12,680
لأنَّ قوّة الظّلام قد نمَتْ ببساطة

78
00:07:13,870 --> 00:07:15,130
ماذا تقصدين؟

79
00:07:15,360 --> 00:07:18,280
لا أحد يستطيعُ منع الانفِجار

80
00:07:20,180 --> 00:07:21,990
!هذا مُضحِك

81
00:07:29,340 --> 00:07:30,440
...هل هذه

82
00:07:34,470 --> 00:07:36,500
...فهمت. هذه الأنابيب

83
00:07:37,020 --> 00:07:38,410
إلى أين أنتَ ذاهِب؟

84
00:07:39,240 --> 00:07:41,570
لا يعرفون متى عليهم الاستسلام

85
00:07:41,570 --> 00:07:44,920
اذهبوا وفجِّروا أنفسكم مع تِلك الدُمية المعطوبة

86
00:07:44,920 --> 00:07:48,380
والآن كلّ ما بقي هو القضاءُ عليك يا بايلدرامون

87
00:07:51,340 --> 00:07:52,610
!إيسغريما

88
00:07:58,070 --> 00:08:00,260
ماذا يوجدُ هناك؟

89
00:08:00,260 --> 00:08:04,220
أعتقِد أنَّ الطاقة تنتقِلُ عبر هذه الأنابيب

90
00:08:05,650 --> 00:08:06,220
...لِهذا السّبب

91
00:08:06,520 --> 00:08:10,700
بتعقُّبِ مسارها، يمكننا أن نحدِّد ما يسبِّب الانفجار

92
00:08:21,210 --> 00:08:23,670
أين هو؟ إلى أينَ ذهب؟

93
00:08:24,770 --> 00:08:27,150
ينتابُني إحساسٌ سيّئ

94
00:08:27,760 --> 00:08:30,240
شعَرنا بشيءٍ كهذا من قبل

95
00:08:42,740 --> 00:08:44,470
!علِقنا

96
00:08:44,470 --> 00:08:46,340
يا للهول! ماذا نفعل؟

97
00:08:47,950 --> 00:08:50,320
!دعوا الأمرَ لي داغيا

98
00:08:50,320 --> 00:08:52,680
!الحجر المُتدحرِج

99
00:08:53,820 --> 00:08:55,270
!ضربة الرّيشة القاطِعة

100
00:09:01,770 --> 00:09:03,340
والآن يمكِنُنا العبور

101
00:09:04,200 --> 00:09:05,650
!أين أنت؟ اكشفْ عن نفسِك

102
00:09:16,210 --> 00:09:17,710
حسناً، انتهى الأمر

103
00:09:20,140 --> 00:09:21,320
!هذه هي

104
00:09:26,340 --> 00:09:28,850
ما هذا الإحساسُ المُخيف؟

105
00:09:29,280 --> 00:09:30,890
...أعرِفُ هذا الإحساس

106
00:09:30,890 --> 00:09:34,810
تذكَّرت، هذا أشبه باللحظةِ الّتي كنَّا قريبين
فيها من تِلك الدوّامة

107
00:09:40,290 --> 00:09:41,890
أعرِفُ هذا الشُّعور أيضاً

108
00:09:53,410 --> 00:09:54,980
فهمتُ الآن

109
00:09:56,090 --> 00:09:59,240
ذاك المدخل مُتّصِلٌ بعالمِ الظَّلام

110
00:10:00,250 --> 00:10:03,700
،تتدفّقُ طاقةُ الظّلامِ عبرَ ذاك المدخل

111
00:10:03,700 --> 00:10:05,780
وتتحكّم بهذه القاعِدة

112
00:10:11,260 --> 00:10:12,780
!أسرِعوا من فضلِكم

113
00:10:17,490 --> 00:10:18,790
!الوقتُ يُداهِمُنا

114
00:10:18,790 --> 00:10:20,960
إن لم نُسرِع، سينفجِر

115
00:10:21,200 --> 00:10:23,170
ماذا عسانا أن نفعل يا إتشيجوجي؟

116
00:10:23,170 --> 00:10:26,240
علينا إيقاف تدفُّق طاقة الظَّلام

117
00:10:26,240 --> 00:10:30,030
!لا بُدَّ من وجودِ أداة في مكانٍ ما لإيقافِ التدفُّق

118
00:10:35,170 --> 00:10:37,010
!ما زالَ دايسكي والآخرون في الدَّاخل

119
00:10:37,010 --> 00:10:38,390
!كين والأطفال في خطر

120
00:10:41,180 --> 00:10:43,470
!ناسِف اليأس

121
00:10:55,660 --> 00:10:56,420
!دايسكي

122
00:10:56,420 --> 00:10:57,300
!كين-تشان

123
00:11:01,290 --> 00:11:02,960
هل الجميعُ بخير؟

124
00:11:03,340 --> 00:11:06,100
...نحن بخير، لكن

125
00:11:06,100 --> 00:11:07,780
!انظروا هُناك

126
00:11:13,220 --> 00:11:15,420
!سوف تنفجِر! اهربوا جميعاً

127
00:11:15,730 --> 00:11:17,850
!لن... لن نلحق

128
00:11:23,750 --> 00:11:25,960
!ناسِف اليأس

129
00:11:39,660 --> 00:11:41,180
!بايلدرامون

130
00:11:44,930 --> 00:11:46,470
!نجَحوا

131
00:11:48,610 --> 00:11:52,760
"تمَّ إصلاح التشوُّه. ينبغي أن يكونَ كلّ شيء بخير الآن"

132
00:11:59,230 --> 00:12:02,340
!يا لهم من أطفالٍ مُزعجين! لم ينتهِ الأمر

133
00:12:02,740 --> 00:12:07,590
!لا تُثيروا غضَبي وإلّا أدفعتُكم الثّمن غالياً

134
00:12:25,510 --> 00:12:27,970
!ناسِف اليأس

135
00:12:37,320 --> 00:12:39,000
...دمِّرها

136
00:12:39,000 --> 00:12:40,440
...ولا تترُك أثراً

137
00:12:44,950 --> 00:12:46,880
هل أبلينا حسناً يا كين-تشان؟

138
00:12:47,620 --> 00:12:49,660
أجل. شكراً يا ليفمون

139
00:12:49,660 --> 00:12:51,850
أنتَ فيمون، صحيح؟

140
00:12:52,310 --> 00:12:56,330
أنا تشيكومون الآن. ألم نكُن قويّين؟

141
00:12:56,580 --> 00:12:58,300
!بلى. كنتُما عظيمَين

142
00:12:59,480 --> 00:13:01,050
لنُساعِد بعضنا الآخر

143
00:13:01,050 --> 00:13:02,270
أجل، دوماً

144
00:13:02,740 --> 00:13:04,570
نجَحنا يا إتشيجوجي

145
00:13:05,950 --> 00:13:07,150
ما الأمر؟

146
00:13:07,150 --> 00:13:10,260
لا أفهمُ لماذا اندمجَ الدِّيجيمونان معاً

147
00:13:10,740 --> 00:13:11,730
لماذا؟

148
00:13:11,730 --> 00:13:13,080
ما الّذي تتحدّثُ عنه؟

149
00:13:13,080 --> 00:13:15,360
هذا لأنَّنا صديقان

150
00:13:15,360 --> 00:13:16,250
صديقان؟

151
00:13:16,650 --> 00:13:19,770
...ألم تشعُر بذلك؟ اندمجَ ديجيموني مع ديجيمونك

152
00:13:19,770 --> 00:13:24,240
مشاعِرُنا وأفكارُنا تدفّقَتْ عبر جسدينا

153
00:13:24,510 --> 00:13:28,340
كان قلبانا ينبُضان كقلبٍ واحد. شعرتُ
!أنّنا جسدٌ واحد بكُل معنى الكلِمة

154
00:13:28,340 --> 00:13:31,110
كانَتِ اللَّحظةُ الّتي شعرتُ فيها أنَّنا صديقان

155
00:13:32,410 --> 00:13:36,600
...لستُ مُؤهَّلاً لأكون صديقَك بعد

156
00:13:36,960 --> 00:13:38,620
ماذا تقصد بـ"مُؤهَّل"؟

157
00:13:38,620 --> 00:13:41,470
أليسَ الشُّعور بالاتّحاد كافياً؟

158
00:13:41,770 --> 00:13:42,800
أنا آسِف

159
00:13:44,680 --> 00:13:47,060
هلّا منحتَني بعضاً من الوقتِ للتفكير؟

160
00:13:47,060 --> 00:13:47,950
ماذا؟

161
00:13:47,950 --> 00:13:49,670
!انتظِر يا إتشيجوجي

162
00:13:51,780 --> 00:13:53,240
لستُ أفهم

163
00:13:53,240 --> 00:13:55,520
أنتَ صريحٌ زيادة عن اللُّزوم يا دايسكي-كن

164
00:13:55,520 --> 00:13:59,380
عندما تضغطُ عليه هكذا، لا يَستطيعُ
الإجابة فوراً

165
00:14:00,080 --> 00:14:03,260
لكن قاتَلنا معاً قبل قليل

166
00:14:03,260 --> 00:14:06,930
...رُبَّما كانَ مُنغمِساً أثناء القِتال، ولكن بعدَ ذلك

167
00:14:06,930 --> 00:14:09,720
!عندما استعادَ هدوءه، ارتبكَ وارتعد

168
00:14:09,720 --> 00:14:11,300
على الأقلّ، هذا ما أعتقِد أنَّه يشعرُ به

169
00:14:11,300 --> 00:14:15,200
حتَّى أنا لا أملك فكرة عمَّا حدث

170
00:14:15,200 --> 00:14:18,820
يجب علينا أن ننتظِر ونرى ما الّذي
يُقرِّرُه إتشيجوجي-كن

171
00:14:18,820 --> 00:14:20,280
حسناً، لنعُد إلى المنزِل

172
00:14:21,150 --> 00:14:23,640
يُواجِه صعوبةً في إيجادِ طريقة للمضيّ قُدماً

173
00:14:24,410 --> 00:14:26,100
...هذه المُعاناة

174
00:14:26,100 --> 00:14:29,260
آمل ألَّا تقود إلى إجابةٍ لا تُرضي سِواه

175
00:14:29,580 --> 00:14:33,560
!أجل، هذا صحيح. اندمجَ الدِّيجيمونان الخاصّان بهما

176
00:14:34,200 --> 00:14:35,900
ماذا قالَ كوشيرو-سان؟

177
00:14:35,900 --> 00:14:40,680
يريدُ شرحَ تطوُّر جوغريس للجميع

178
00:14:40,680 --> 00:14:43,120
دعانا إلى منزلِه غداً

179
00:14:43,120 --> 00:14:44,510
ماذا يريدُ أن يشرح؟

180
00:14:44,510 --> 00:14:47,530
لم أسألْه عن التَّفاصيل

181
00:14:48,830 --> 00:14:50,560
دايسكي-سان، ما قولُك؟

182
00:14:50,560 --> 00:14:51,500
لا أعلم

183
00:14:52,270 --> 00:14:53,590
...رُبَّما

184
00:14:54,460 --> 00:14:56,910
هل تعرِفان شيئاً؟

185
00:14:58,230 --> 00:15:00,630
!دايسكي، أنا أتضوّرُ جوعاً

186
00:15:00,630 --> 00:15:03,440
!أجل! أنا أيضاً! أتضوّرُ جوعاً

187
00:15:04,260 --> 00:15:06,490
تأخَّرَ الوقت، لنتكلَّم عن هذا غداً

188
00:15:06,490 --> 00:15:08,100
!لكنّه يُحيِّرُني

189
00:15:08,620 --> 00:15:12,440
إيوري، ينبغي أن نعود قبلَ العشاء

190
00:15:12,440 --> 00:15:13,890
أجل، معك حقّ

191
00:15:14,890 --> 00:15:17,300
أراكم جميعاً غداً في منزلِ كوشيرو-سان

192
00:15:17,300 --> 00:15:18,350
!وداعاً

193
00:15:17,300 --> 00:15:18,350
!إلى اللِّقاء

194
00:15:18,740 --> 00:15:20,870
...أنا متأكّدٌ أنَّني شعرتُ

195
00:15:21,330 --> 00:15:23,020
أنَّنا صديقان

196
00:15:23,020 --> 00:15:24,510
!وكذلك أنا

197
00:15:24,510 --> 00:15:25,330
ماذا؟

198
00:15:25,980 --> 00:15:29,200
،عندما تطوَّرنا تطوُّر جوغريس، فهِمتُه كُلِّياً

199
00:15:29,200 --> 00:15:32,160
!وأسعدَني ذلك

200
00:15:32,160 --> 00:15:34,320
!رأيت؟ لستُ أنا فقط

201
00:15:35,740 --> 00:15:38,370
...أتساءل إن لم يشعرْ كين بشيء

202
00:15:40,650 --> 00:15:43,840
ظننتُ أنَّ كلّ ما لديّ هو أنت

203
00:15:43,840 --> 00:15:46,770
...ثُمَّ اندمجتَ بديجيمون موتوميا

204
00:15:46,770 --> 00:15:49,440
،لكن كنتُ سعيداً في ذلك الوقت

205
00:15:49,870 --> 00:15:53,740
لأنَّني شعرتُ وكأنَّه لا تزال هناك حاجة لنا

206
00:15:53,740 --> 00:15:56,680
لكن فعلتُ أشياء سيِّئة كثيرة

207
00:15:57,740 --> 00:15:59,230
فكِّر مليّاً في الأمر

208
00:15:59,230 --> 00:16:01,750
وجِد إجابتَك يا كين-تشان

209
00:16:01,750 --> 00:16:02,910
طابَتْ ليلتُك

210
00:16:08,160 --> 00:16:10,150
تأخَّر... أين دايسكي-سان؟

211
00:16:10,720 --> 00:16:12,120
!مرحباً

212
00:16:12,470 --> 00:16:14,580
!تأخّرتَ يا دايسكي-سان

213
00:16:14,580 --> 00:16:15,870
!آسِف

214
00:16:15,870 --> 00:16:18,050
!عدتَ كتشيبيمون

215
00:16:18,050 --> 00:16:20,820
!ساهمَ النّومُ الهانئ في ذلك

216
00:16:20,820 --> 00:16:22,580
!أنت مشغولٌ دوماً

217
00:16:23,010 --> 00:16:26,120
بسُرعة، لنذهب ونرَ كوشيرو-سان

218
00:16:26,880 --> 00:16:30,040
...لم أعرف ماذا يعني جوغريس، فبحثتُ حولَ الأمر

219
00:16:30,350 --> 00:16:34,510
لكن لم أجِد أي مُرادِف آخر لكلمةِ جوغريس

220
00:16:35,240 --> 00:16:38,050
وبالتَّالي، وثلت لتفسير خاصّ من عندي

221
00:16:38,050 --> 00:16:40,310
جوينت" تعني مُشترَك"

222
00:16:40,310 --> 00:16:42,840
و"بروغريس" تعني التطوُّر

223
00:16:42,840 --> 00:16:46,490
أعتقِد أنَّ الكلِمة مُستمَدّة من دمج الكلِمتَين

224
00:16:46,490 --> 00:16:49,950
أهذا ما أردتَ شرحه؟

225
00:16:50,170 --> 00:16:51,070
لا

226
00:16:51,420 --> 00:16:56,680
ثمّة أمر عليّ إخباركم به أنتُم الثَّلاثة

227
00:16:57,380 --> 00:16:59,430
!نحن الثَّلاثة؟

228
00:16:59,820 --> 00:17:03,400
كان ينبغي أن أخبرَكم مُسبَقاً

229
00:17:03,400 --> 00:17:06,860
ما الأمر؟ كُفَّ عن المُماطَلة وأخبرْنا من فضلِك

230
00:17:08,360 --> 00:17:12,650
اندماج ديجيمونين... حدثَ هذا من قبل

231
00:17:13,810 --> 00:17:15,300
!أعلمُ بشأنِ ذلك

232
00:17:15,300 --> 00:17:18,780
بعد فترةٍ من ذلك

233
00:17:19,620 --> 00:17:24,520
طلبَ غينّاي-سان المُساعدة لِذا عدنا
إلى العالَمِ الرَّقميّ

234
00:17:25,420 --> 00:17:28,000
،بما أنَّنا هزمنا أبوكاليمون

235
00:17:28,000 --> 00:17:32,360
اعتقَدنا أنَّ تشوُّه العالمِ الرّقميّ عادَ إلى طبيعتِه

236
00:17:32,660 --> 00:17:34,440
لكن كُنَّا مُخطئين

237
00:17:35,410 --> 00:17:38,780
،لإصلاحِ تشوُّه العالم الرَّقميّ بشكلٍ كامل

238
00:17:38,780 --> 00:17:42,680
"توجّبَ علينا تحرير "القوّة الحامية للعالمِ الرَّقميّ

239
00:17:42,680 --> 00:17:45,010
والّتي كانَتْ قوّة الظَّلام تحبسُها

240
00:17:45,390 --> 00:17:48,100
القوّة الحامية للعالمِ الرَّقميّ"؟"

241
00:17:48,100 --> 00:17:50,820
أجل، لكن لا أعلَم بالضّبط ما هي

242
00:17:50,820 --> 00:17:55,350
عندما تضعُف تِلك القوّة، تتعزَّزُ قوّةُ الظَّلام

243
00:17:55,350 --> 00:17:59,320
كانَتْ قوّة الشَّارات مَطلوبة لمنعِ ذلك

244
00:18:18,330 --> 00:18:23,820
كلُّ شارةٍ من شاراتِنا أعادَت العالمَ
الرَّقميّ إلى طبيعتِه

245
00:18:25,300 --> 00:18:28,820
قوّةُ شاراتِنا الثَّمانية كسرَتْ ختمَ العالمِ الرَّقميّ

246
00:18:28,820 --> 00:18:32,280
كانَ ذلك السّبب الحقيقيّ وراء اختيارِنا

247
00:18:32,760 --> 00:18:37,270
لكن، لأنَّنا استهلَكنا كلّ القوى
،التي تمتّعَتْ بها شاراتُنا

248
00:18:37,910 --> 00:18:41,920
...شُركاؤنا الدِّيجيمون مثل أغومون وتينتومون

249
00:18:41,920 --> 00:18:45,790
واجَهوا صعوبةً في التطوُّرِ إلى مُستوى
مِثالي منذُ ذلك الحين

250
00:18:51,660 --> 00:18:56,330
لكن ما زالَتْ قلوبنا قادِرة على منحِ القوّة للشّارات

251
00:18:56,330 --> 00:18:59,650
ما زالَتْ لدينا فُرصة للتطوُّر

252
00:18:59,920 --> 00:19:02,610
ألِهذا قلتُم أنَّكم لم تستطيعوا بلوغَ
المُستوى المِثاليّ في الأمس؟

253
00:19:02,610 --> 00:19:03,640
أجل

254
00:19:04,790 --> 00:19:07,420
لماذا لم تُخبِرونا مُسبَقاً؟

255
00:19:07,420 --> 00:19:10,060
لم نقصد إخفاءَ الأمر

256
00:19:10,970 --> 00:19:15,310
كانَ من الصّعبِ أن نقول أنَّنا لم نستطِع
التطوُّر إلى مُستوى مِثاليّ

257
00:19:15,310 --> 00:19:18,870
في الواقع، لم تكن القضيّة أنّنا لن
نتمكَّن من التطوُّر مُجدَّداً

258
00:19:19,300 --> 00:19:24,030
تمنَّينا أن نتطوَّر إلى المُستوى المِثاليّ كما السَّابِق

259
00:19:24,250 --> 00:19:26,010
هكذا إذاً

260
00:19:24,260 --> 00:19:25,180
أجل

261
00:19:26,010 --> 00:19:29,470
،عندما اندمجَ ميتلغارورمون ووارغريمون معاً

262
00:19:29,990 --> 00:19:32,990
أصبحا أوميغامون وامتلكا عشرات
...أضعاف القوّة السَّابِقة

263
00:19:32,990 --> 00:19:35,960
هزما خصوماً لم يكونا يستطيعان هزيمتهم
عندما كانا على حدة

264
00:19:35,960 --> 00:19:38,430
!كان قويّاً جدّاً ورائعاً

265
00:19:38,650 --> 00:19:41,390
،نفس الأمر حدثَ مع تطوُّر جوغريس في الأمس

266
00:19:41,390 --> 00:19:44,570
...اندمجَ أكس فيمون وستينغمون كبايلدرامون

267
00:19:44,570 --> 00:19:49,620
وسحقا المُستوى المِثاليّ أوكوامون، المهمّة
المستحيلة فرديّاً

268
00:19:50,560 --> 00:19:52,510
معنى هذا بأنّهما لا يستطيعان التطوُّر
...إلى مُستوى مِثاليّ

269
00:19:52,510 --> 00:19:54,160
يستطيعان أن يتطوَّرا تطوُّر جوغريس فقط؟

270
00:19:54,160 --> 00:19:55,170
،إذا كان كذلك

271
00:19:55,170 --> 00:19:56,950
فلا نملك وقتاً إذاً، صحيح؟

272
00:19:56,950 --> 00:20:00,330
!لا بُدَّ أنَّ تِلك المرأة المُزعِجة هي عدوّتُنا الجديدة

273
00:20:00,660 --> 00:20:03,670
صنعَتْ ديجيمونات بمُستوى مِثالي
...من أبراج الظَّلام

274
00:20:03,670 --> 00:20:05,310
وأرسلَتْها لمُهاجمتِنا

275
00:20:05,310 --> 00:20:07,790
من تكونُ يا تُرى؟

276
00:20:07,790 --> 00:20:09,740
يجب أن نتوخَّى الحذر

277
00:20:09,740 --> 00:20:12,740
!لنعُد إلى العالمِ الرَّقميّ بسُرعة

278
00:20:12,740 --> 00:20:15,540
لا نعلمُ ما ستفعلُه تالياً

279
00:20:15,790 --> 00:20:17,770
!معكَ حقّ. هيَّا بنا

280
00:20:18,110 --> 00:20:20,840
!إيزومي-سينباي، ابتعِد

281
00:20:19,900 --> 00:20:20,840
!مهلاً

282
00:20:21,160 --> 00:20:22,790
!أيّتُها البوَّابة الرقميّة، افتحي

283
00:20:25,480 --> 00:20:28,070
...أُمِّي قادِمة

284
00:20:29,520 --> 00:20:30,980
...الأطفال المُختارون

285
00:20:30,980 --> 00:20:32,830
تفضَّلوا بعض الطعام الخفيف

286
00:20:32,830 --> 00:20:34,870
...انطِلاق

287
00:20:35,790 --> 00:20:37,350
!إنّها دونات

288
00:20:40,480 --> 00:20:42,250
!شكراً على الطعام

289
00:20:49,470 --> 00:20:51,750
كانَ ذلك وشيكاً

290
00:20:51,750 --> 00:20:52,560
ماذا؟

291
00:20:54,580 --> 00:20:57,100
أليس تينتو-سان هُنا اليوم؟

292
00:20:59,800 --> 00:21:01,450
تينتو-سان؟

293
00:21:02,510 --> 00:21:03,730
...تينتو-سان

294
00:21:04,780 --> 00:21:07,240
...في الواقع

295
00:22:37,500 --> 00:22:40,550
تحدٍّ لدايسكي والآخرين من المرأةِ الغامِضة

296
00:22:40,820 --> 00:22:44,370
يتوجّهُ الأطفالُ إلى بيتِ غيغا العملاق

297
00:22:44,610 --> 00:22:46,070
يُهاجمهم سربٌ من غوكيمون

298
00:22:46,300 --> 00:22:48,930
كين يُهاجَم بواسطةِ كونيمون وتجرفُه دوَّامة

299
00:22:49,330 --> 00:22:54,080
يدوي صدى أصوات مُخيفة من مزمار
!المرأة داخِل بيت الرُّعب

300
00:22:54,080 --> 00:22:56,570
!الحلقة القادمة من مغامرة الدّيجيمون 02

301
00:22:56,570 --> 00:22:58,180
"!!فخّ خبيرة الحشرات"

302
00:22:58,180 --> 00:23:00,320
!البوّابة المؤدّية إلى المغامرة مفتوحة الآن