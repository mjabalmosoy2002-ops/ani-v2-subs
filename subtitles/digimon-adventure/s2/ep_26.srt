1
00:01:31,830 --> 00:01:34,630
ظهرَتْ امرأةٌ غامضةٌ أمامَ الأطفال

2
00:01:35,090 --> 00:01:37,750
حوّلَت أبراجَ الظّلام إلى ديجيمون وهاجمَتهم

3
00:01:38,500 --> 00:01:40,510
قاتلَ الأطفالُ ببسالة

4
00:01:40,990 --> 00:01:42,270
ساهمَ ستينغمون في المعركة

5
00:01:43,320 --> 00:01:45,170
...عادَتْ مياكو إلى رشدِها أخيراً

6
00:01:45,170 --> 00:01:47,320
!وتطوّرَ هوكمون إلى أكويلامون

7
00:01:51,680 --> 00:01:55,680
اعتذرَ كين إتشيجوجي عن أفعاله الشرِّيرة
عندما كانَ القيصر

8
00:01:56,180 --> 00:02:01,070
لكنّه لم يتصالحْ مع نفسه بعد

9
00:02:04,120 --> 00:02:08,150
،تطوُّر جوغريس
"اتِّحاد القلوب

10
00:02:17,430 --> 00:02:19,780
لنأخذ استراحةً

11
00:02:19,780 --> 00:02:20,810
فكرة جيّدة

12
00:02:24,270 --> 00:02:25,080
!لذيذ

13
00:02:25,790 --> 00:02:30,150
...ثمّة أمر كنتُ أتساءلُ حوله

14
00:02:30,150 --> 00:02:31,130
ما هو؟

15
00:02:31,480 --> 00:02:36,500
من كانَتْ تِلك المرأة التي كانَتْ
بالمون تتحدّث عنها؟

16
00:02:41,000 --> 00:02:42,700
ما الّذي تنظر إليه؟

17
00:02:43,730 --> 00:02:45,900
لماذا تتحوّلُ هذه إلى ديجيمونات؟

18
00:02:45,900 --> 00:02:47,530
هل تعرِفُ شيئاً؟

19
00:02:51,750 --> 00:02:53,830
...لا، لا أعرف

20
00:02:55,420 --> 00:02:57,280
...لو كنتُ بذاتي القديمة

21
00:02:57,940 --> 00:03:00,960
لو كنتُ لا أزال القيصر، لتمكَّنتُ رُبّما من الفهم

22
00:03:01,860 --> 00:03:07,260
لكن الآن، أنا عاجزٌ عن فهم آليّة عمل هذه

23
00:03:07,670 --> 00:03:11,260
تريدُ العودةَ إلى كونِك قيصر الدِّيجيمون يا كين-تشان؟

24
00:03:11,720 --> 00:03:14,250
لا، ليسَ هذا مقصدي

25
00:03:15,410 --> 00:03:19,340
آنذاك، كان هُناك وضوح في عقلي

26
00:03:19,340 --> 00:03:22,880
جعلَني أشعر وكأنَّني أستطيع فهم أيّ شيء

27
00:03:25,530 --> 00:03:29,960
...لكن أعتقِد أنّي لم أفهم الشيء الأهمّ

28
00:03:31,620 --> 00:03:35,130
يمكنني أن أقول شيئاً واحداً وكلِّي ثِقة

29
00:03:35,520 --> 00:03:36,750
كين-تشان؟

30
00:03:39,230 --> 00:03:40,780
هذا شيء بنيتُه بنفسي

31
00:03:42,250 --> 00:03:45,600
...أنا آسِف. لو كنتُ أقوى فقط

32
00:03:45,600 --> 00:03:47,660
لما حدثَ هذا لك

33
00:03:50,570 --> 00:03:54,050
الذنبُ ليسَ ذنبك يا وارمون. أنا المُلام

34
00:03:54,670 --> 00:04:00,040
كين-تشان، سنستعيدُ العالمَ الرّقميّ معاً

35
00:04:01,560 --> 00:04:03,310
شكراً لك يا وارمون

36
00:04:04,360 --> 00:04:09,030
!سأدمِّر كلّ أبراجَ الظّلام إذا اضطررت

37
00:04:10,160 --> 00:04:11,510
!فعلناها

38
00:04:11,510 --> 00:04:13,050
!فعلناها بالتأكيد

39
00:04:13,390 --> 00:04:16,350
عمِلنا بجدّ، لِذا يمكنُ القول أنّ النتائج
كانت حَميدة. صحيح؟

40
00:04:16,350 --> 00:04:17,510
أتَّفِق

41
00:04:17,510 --> 00:04:20,160
...الآن بعد أن انتهينا هنا

42
00:04:20,390 --> 00:04:22,320
!دعونا نُواصِل

43
00:04:22,320 --> 00:04:23,520
!حسناً

44
00:04:23,520 --> 00:04:26,400
...في الوقتِ الّذي كان العالمُ الرَّقمي آيلاً للدّمار

45
00:04:26,400 --> 00:04:28,730
...أشعر بالاشمئزازِ الشّديد

46
00:04:28,730 --> 00:04:33,120
الأطفال البشريّون عديمو الجدوى ببساطة
...لتدخُّلهم في شؤونِ غيرهم

47
00:04:38,950 --> 00:04:40,220
نهاية مُتقصِّفة؟

48
00:04:42,950 --> 00:04:43,920
غضبتُ الآن

49
00:05:00,430 --> 00:05:02,430
دمِّر ذاك الجسر

50
00:05:10,430 --> 00:05:11,250
...هذا

51
00:05:11,820 --> 00:05:13,170
ماذا الآن؟

52
00:05:13,170 --> 00:05:16,240
،إنَّه مُتوجّهٌ نحو الجسر الذي رمّمناه للتو

53
00:05:16,590 --> 00:05:18,500
هل يَنوي تدميرَه؟

54
00:05:18,500 --> 00:05:20,200
!ماذا؟! هذا غير مُمكِن

55
00:05:20,810 --> 00:05:21,670
!دايسكي

56
00:05:22,620 --> 00:05:23,400
!حسناً

57
00:05:24,480 --> 00:05:26,690
!تطوَّري أيّتُها البيضة الرقميّة

58
00:05:28,040 --> 00:05:31,930
...فيمون، تطوَّر درعيّاً

59
00:05:38,000 --> 00:05:40,810
!عاصِفة الصَّداقة الرعديّة: ليدرامون

60
00:05:43,320 --> 00:05:47,690
مينوتارومون

61
00:05:43,320 --> 00:05:47,690
بالغ
ديجيمون إنسان وحش

62
00:05:43,320 --> 00:05:47,690
:الحركة الخاصّة
زلزال الظّلام

63
00:05:43,770 --> 00:05:45,590
مينوتارومون! ديجيمون بمُستوى بالِغ

64
00:05:45,590 --> 00:05:47,690
تقنيّتُه الخاصّة هي زلزالُ الظّلام

65
00:05:50,160 --> 00:05:52,030
!ماذا تظنُّ نفسك فاعلاً؟

66
00:05:52,300 --> 00:05:54,290
!سيفُ البرق

67
00:05:57,690 --> 00:05:58,740
!دايسكي-كن

68
00:05:59,240 --> 00:06:00,310
هل أنت بخير؟

69
00:06:00,310 --> 00:06:03,930
تاكيرو! يُحاولُ تدمير الجسر حقّاً

70
00:06:04,330 --> 00:06:06,670
!لمَ يفعلُ شيئاً كهذا؟

71
00:06:06,670 --> 00:06:07,640
!هوكمون

72
00:06:07,640 --> 00:06:08,620
!حسناً

73
00:06:10,300 --> 00:06:14,170
...هوكمون، تطوَّر

74
00:06:15,980 --> 00:06:17,590
!أكويلامون

75
00:06:20,110 --> 00:06:21,470
!توقّفْ عن ذلك

76
00:06:26,650 --> 00:06:27,480
!يا إلهي

77
00:06:27,480 --> 00:06:28,460
...هذا

78
00:06:31,160 --> 00:06:32,780
!برج ظلام

79
00:06:32,780 --> 00:06:34,640
!إنّه مصنوعٌ من برجِ الظَّلام أيضاً

80
00:06:35,110 --> 00:06:35,750
!تيلمون

81
00:06:37,560 --> 00:06:38,100
!باتامون

82
00:06:38,380 --> 00:06:39,240
!حسناً

83
00:06:39,930 --> 00:06:42,250
!ترقَّي أيّتُها البيضة الرقميّة

84
00:06:43,900 --> 00:06:47,190
...تيلمون، تطوَّري درعيّاً

85
00:06:43,900 --> 00:06:47,190
...باتامون، تطوَّر درعيّاً

86
00:06:51,000 --> 00:06:54,450
!نور البسمات: نيفيرتيمون

87
00:06:58,880 --> 00:07:01,480
!الأمل الصّاعد: بيغاسمون

88
00:07:03,010 --> 00:07:04,510
!الرّبط المُقدَّس

89
00:07:07,440 --> 00:07:09,880
!الرَّعدُ الأزرق

90
00:07:12,790 --> 00:07:14,530
!مرحى، قضينا عليه

91
00:07:22,470 --> 00:07:24,380
...بعد كلّ هذا الجهد

92
00:07:24,380 --> 00:07:26,040
أظنُّنا علينا ترميمه من جديد

93
00:07:26,040 --> 00:07:28,720
إذا تعاونَّا معاً جميعاً، سنتمكّن من ذلك

94
00:07:28,720 --> 00:07:30,250
يُمكن ترميمه

95
00:07:30,250 --> 00:07:33,890
ما زلتُ أنا وأرماجيمون قادرين على العمل

96
00:07:33,890 --> 00:07:36,660
!أنا أيضاً! علينا أن نُحاول

97
00:07:38,460 --> 00:07:41,090
إذا تعاونّا معاً؟

98
00:07:42,260 --> 00:07:45,580
لندع كين إتشيجوجي يُعيننا

99
00:07:45,580 --> 00:07:46,500
ماذا؟

100
00:07:46,910 --> 00:07:50,390
أنا متأكِّدٌ أنَّه سيرغبُ في المُساعدة إذا طلبنا

101
00:07:50,750 --> 00:07:53,640
هل... تعتقِد ذلك حقَّاً؟

102
00:07:54,320 --> 00:07:57,120
ألا تتّفِق معي يا إيوري؟

103
00:07:57,760 --> 00:08:02,600
لا. أنا عاجزٌ عن فهمِ منطِقك

104
00:08:05,000 --> 00:08:08,400
...لكن، سمعتُ آنذاك

105
00:08:09,140 --> 00:08:10,240
سمعتَ ماذا؟

106
00:08:12,130 --> 00:08:15,530
آنذاك، عندما تحوّلت شارةُ الحنان الخاصَّة بإتشيجوجي

107
00:08:15,530 --> 00:08:17,680
...إلى بيضةٍ رقميّةٍ ذهبيّة

108
00:08:21,030 --> 00:08:23,800
،لم أفهمْ تماماً ما الّذي كان يقوله

109
00:08:24,440 --> 00:08:27,640
لكن بدا وكأنَّه كان يتوسّلُ لشيء ما

110
00:08:32,040 --> 00:08:35,950
...لا أعرِف كيف أصِفُ الأمر، لكن

111
00:08:36,500 --> 00:08:37,940
كيف أُعبِّر عن الأمر؟

112
00:08:38,320 --> 00:08:41,990
شعرتُ فقط أنَّ بمقدوري الوثوق بتِلك الشَّارة

113
00:08:43,140 --> 00:08:50,070
لستُ متأكداً، لكن أعتقِد أنَّ تِلك الشَّارة
هي قلبُ إتشيجوجي بنفسِه

114
00:08:50,290 --> 00:08:54,540
بعبارةٍ أخرى، تفهمُ قلبَ إتشيجوجي-كن يا دايسكي-كن؟

115
00:08:54,820 --> 00:08:57,010
...مُمكِن إن وصفتِ الأمر بهذه الطريقة

116
00:08:57,640 --> 00:09:02,980
،لعلَّك تمكّنتَ من فهمِ ذلك يا دايسكي
لكن ما زلتُ أنا لم أفهم

117
00:09:04,970 --> 00:09:08,450
ألا يُمكننا أن نتكلّم بطريقةٍ أبسط؟

118
00:09:08,450 --> 00:09:11,950
شارات وقلوب، لمَ علينا تعقيد الأمور؟

119
00:09:14,290 --> 00:09:15,230
...هذا

120
00:09:16,560 --> 00:09:18,230
:رِسالة من كوشيرو-سان

121
00:09:18,450 --> 00:09:21,170
"!هناك نشاطٌ غريب قريب"

122
00:09:21,170 --> 00:09:23,200
"الرّجاء التحقُّق بسُرعة"

123
00:09:23,200 --> 00:09:26,540
يبدو وكأنَّ قوّة الظّلام تنمو

124
00:09:26,540 --> 00:09:27,610
!هيَّا بنا

125
00:09:33,540 --> 00:09:36,190
شكراً لك. لا بُدَّ أنَّك مُتعَب

126
00:09:36,190 --> 00:09:38,580
لا، ما زالَ بمقدوري المُتابعة

127
00:09:39,400 --> 00:09:41,120
ولكن يمكنُك تأجيل ذلك ليومِ غد

128
00:09:41,360 --> 00:09:43,250
أعتقِد سنكتفي بهذا القدرِ اليوم

129
00:09:44,550 --> 00:09:45,680
هل أنتَ بخير؟

130
00:09:45,680 --> 00:09:49,070
أنا بخير يا كين-تشان. أنتَ تقلقُ كثيراً

131
00:09:49,410 --> 00:09:52,030
ليتَني أستطيع فعل أكثر من ذلك

132
00:09:52,310 --> 00:09:55,400
ما كنتُ لأستطيع التطوُّر لولاك

133
00:09:55,400 --> 00:09:56,740
لا شيء يَدعو للقلق

134
00:09:57,390 --> 00:10:00,370
!لنعُد إلى المنزلِ ونأكلُ الكثير من الأطعمة الخفيفة

135
00:10:00,370 --> 00:10:00,950
!حسناً

136
00:10:08,390 --> 00:10:10,370
إذاً هذا هو المكانُ الّذي علينا تفقُدّه

137
00:10:10,370 --> 00:10:13,370
هُناك تركيزٌ للطاقةِ السلبيّة

138
00:10:13,370 --> 00:10:16,320
سيقعُ انفجارٌ هائلٌ على نطاق مِئات
الكيلومترات إذا استمرّ هذا

139
00:10:16,550 --> 00:10:17,980
!انفجار؟

140
00:10:17,000 --> 00:10:17,930
!ماذا؟

141
00:10:18,470 --> 00:10:20,500
!يجبُ علينا إيقافه بطريقةٍ ما

142
00:10:21,070 --> 00:10:23,230
إيقافه؟ كيف؟

143
00:10:25,550 --> 00:10:29,180
لا بُدَّ أنَّ السّبب هو شارة الحنان المفقودة

144
00:10:29,420 --> 00:10:32,660
إذا استطعنا استبدالها، يُمكننا
إيقاف الانفجار على الأرجح

145
00:10:33,140 --> 00:10:34,510
...لكن سيَعني ذلك

146
00:10:34,930 --> 00:10:36,950
دايسكي، ماذا تفعل؟

147
00:10:36,950 --> 00:10:37,980
!سوف أتَّصِل به

148
00:10:38,690 --> 00:10:42,600
!سأطلبُ من إتشيجوجي أن يُحضِر شارةَ الحنانِ لنا

149
00:11:00,370 --> 00:11:01,470
!كين-تشان

150
00:11:01,730 --> 00:11:03,650
لنقسِم هذا إلى نصفين

151
00:11:03,650 --> 00:11:04,750
حسناً

152
00:11:05,730 --> 00:11:06,950
ما الأمر؟

153
00:11:07,680 --> 00:11:10,780
مرحباً، كيف حالُك؟

154
00:11:11,380 --> 00:11:12,570
!أنتِ؟

155
00:11:12,570 --> 00:11:15,350
!كين-تشان، لا تُزعِج نفسك بأمثالِها

156
00:11:15,350 --> 00:11:19,410
ماذا؟ أظنُّني غير مُرحَّب بي، لِذا أستأذن

157
00:11:19,750 --> 00:11:20,510
!انتظِري

158
00:11:21,280 --> 00:11:25,010
هل ناديتَني؟

159
00:11:25,420 --> 00:11:28,980
من أنتِ بالتّحديد؟! ماذا تعرفين عنِّي؟

160
00:11:30,240 --> 00:11:31,930
كم هذا خانِق

161
00:11:32,230 --> 00:11:36,400
!لماذا أنتِ هنا؟ ماذا تنوين أن تفعلي بالعالمِ الرَّقمي؟

162
00:11:36,400 --> 00:11:39,480
ماذا؟ وما يهمُّك أنت؟

163
00:11:39,480 --> 00:11:41,880
هذا ليسَ من شأنِك

164
00:11:43,770 --> 00:11:44,810
...كان ذلك

165
00:11:44,810 --> 00:11:48,510
!إنَّه نذيرٌ للانفجار. الوقتُ يُداهمنا

166
00:11:48,710 --> 00:11:51,500
!تبَّاً! لماذا لا يردّ؟

167
00:11:52,210 --> 00:11:54,320
كيف تقولين أنَّ هذا ليس من شأني؟

168
00:11:54,320 --> 00:11:55,100
...أنا

169
00:11:57,380 --> 00:12:01,420
...لماذا... لماذا كنتُ

170
00:12:01,800 --> 00:12:05,390
"لماذا كنتُ قيصر الدِّيجيمون؟"

171
00:12:07,640 --> 00:12:10,830
يمكنني بسهولة أن أتوقَّع ما تُريد معرِفته

172
00:12:12,030 --> 00:12:13,830
!كين-تشان، مُكالَمة هاتفيّة

173
00:12:13,830 --> 00:12:16,590
...إذا أردت أن تعرِف حقَّاً

174
00:12:17,010 --> 00:12:18,940
...فيُمكنني أن أخبرك

175
00:12:19,490 --> 00:12:20,780
أن أعرف؟

176
00:12:20,780 --> 00:12:21,940
أجل

177
00:12:21,940 --> 00:12:24,310
!حسناً، إذاً دُر ثلاث مرَّات واِنبح

178
00:12:24,310 --> 00:12:25,370
!ماذا؟

179
00:12:26,150 --> 00:12:30,850
سخافة، كان يمكن أن يكون أيّ شخصٍ ما دامَتِ
الأبراج الظلاميّة قد شُيِّدَت

180
00:12:30,850 --> 00:12:35,410
معك تحديداً، كانَتْ هُناك فُرصة للاغتنام

181
00:12:35,410 --> 00:12:37,120
استغللتِني إذاً

182
00:12:39,930 --> 00:12:44,320
مرحباً، كين إتشيجوجي لا يستطيع
!الردّ على مُكالمتك في الوقت الحاضر

183
00:12:44,700 --> 00:12:47,470
اتّصل في وقتٍ لاحق من فضلك

184
00:12:47,470 --> 00:12:49,820
مرحباً؟ هل هذه رسالةُ مُجيب آليّ؟

185
00:12:49,820 --> 00:12:52,950
لا، هذه ليسَتْ رِسالة مُجيب آلي. هذه رِسالة ديجيمون

186
00:12:53,590 --> 00:12:56,300
!لا بُدَّ أنّك ديجيمون إتشيجوجي-كن

187
00:12:56,300 --> 00:13:00,000
...أجل، هذا أنا. إنَّ كين-تشان حاليّاً

188
00:13:00,700 --> 00:13:04,220
!إنَّها حالةٌ طارئة ويجب أن أتكلّم مع إتشيجوجي-كن

189
00:13:04,580 --> 00:13:08,800
البشر الّذين لديهم نقاط ضعف يسهُل التحكُّم بهم

190
00:13:08,800 --> 00:13:10,510
أنت نموذجٌ مِثاليّ

191
00:13:10,510 --> 00:13:14,300
!لماذا؟ لماذا أنا بالتّحديد؟

192
00:13:14,300 --> 00:13:17,710
ألم تسمعني؟ كان من المُمكِن أن يكون أيّ شخص

193
00:13:17,710 --> 00:13:19,520
...مُجرَّد صدفة

194
00:13:19,850 --> 00:13:23,680
أنا غير راضٍ. هذه ليسَتْ إجابة مُرضية

195
00:13:24,000 --> 00:13:26,320
يا لك من طفل عنيد

196
00:13:26,320 --> 00:13:28,450
توقّفْ وإلّا ستُثير غضبي

197
00:13:28,990 --> 00:13:30,880
!كين-تشان! كين-تشان

198
00:13:30,880 --> 00:13:33,620
مُكالمة هاتفيّة من كوشيرو إيزومي-سان

199
00:13:33,920 --> 00:13:39,600
!يقولُ أنَّ العالمَ الرّقميّ في خطر. يحتاجون مُساعدتك

200
00:13:41,780 --> 00:13:44,530
!أنت! ماذا فعلت؟

201
00:13:45,350 --> 00:13:46,990
ماذا تقصِد؟

202
00:13:47,360 --> 00:13:49,060
هل إتشيجوجي-كن معي؟

203
00:13:49,060 --> 00:13:52,960
أعتقِد أنَّ دايسكي-كن راسلَك بالتّفاصيل

204
00:13:53,370 --> 00:13:56,610
يُمكنك الدُّخول إلى العالمِ الرَّقمي بمُفردك، صحيح؟

205
00:13:56,610 --> 00:13:58,100
!اِذهب إلى هُناك بسُرعة من فضلِك

206
00:13:58,100 --> 00:14:00,120
ما هذه النَّظرة؟

207
00:14:00,120 --> 00:14:02,450
كنتِ تُحاولين إلهائي فحسب

208
00:14:05,210 --> 00:14:08,100
!فتانا الصّغير هُنا رقيقٌ جدّاً

209
00:14:08,100 --> 00:14:09,360
!كين-تشان

210
00:14:10,920 --> 00:14:15,510
ها هو ذا من جديد! ليسَتْ سِوى مسألة
وقت قبل أن يقع الانفِجار

211
00:14:17,980 --> 00:14:19,430
!تمَّ التّلاعُب بي

212
00:14:19,430 --> 00:14:21,400
ذلك الأمر انتهى وولَّى

213
00:14:22,170 --> 00:14:24,670
ظننتُ نفسي الأعظم

214
00:14:24,670 --> 00:14:26,100
اغتررتُ بنفسي

215
00:14:26,100 --> 00:14:28,170
أجل، أنا من فعلتُ ذلك

216
00:14:28,170 --> 00:14:31,500
كنتُ وحيداً واخترتُ الهرب من الأمور

217
00:14:31,900 --> 00:14:35,440
حسناً، سأكون الشّخص الذي يضعُ
!حدَّاً لهذا الأمر

218
00:14:38,950 --> 00:14:40,360
!من جديد

219
00:14:40,360 --> 00:14:42,680
!ألم يصِل إتشيجوجي-كن إلى هنا بعد؟

220
00:14:42,680 --> 00:14:44,100
!إنَّه قادِم! أجزم أنَّه سيأتي

221
00:14:45,170 --> 00:14:46,560
...أشكُّ في ذلك

222
00:14:47,380 --> 00:14:48,550
...لا بُدَّ وأنَّ تِلك

223
00:14:48,550 --> 00:14:51,110
...المرأة التي كانَتْ بالمون تتحدّثُ عنها

224
00:14:51,730 --> 00:14:56,280
لا أريدُ أيّ صِغارٍ يعبثون بانفجاري

225
00:15:12,670 --> 00:15:13,990
!أبراج الظّلام

226
00:15:14,470 --> 00:15:16,190
!يتحوَّلون إلى ديجيمونات

227
00:15:16,190 --> 00:15:18,160
!هذه هي آليّة عملها إذاً

228
00:15:19,150 --> 00:15:26,000
أوكوامون

229
00:15:19,150 --> 00:15:26,000
مثالي
ديجيمون حشرة

230
00:15:19,750 --> 00:15:21,580
أوكوامون! ديجيمون بمُستوى مثالي

231
00:15:21,580 --> 00:15:26,000
ذِراعا مقصّ أوميغا خاصّته حادَّتان بما
يكفي لتقطيع حتّى الألماس

232
00:15:26,420 --> 00:15:27,620
إنَّه بمُستوى مِثاليّ

233
00:15:34,010 --> 00:15:36,210
...فيمون، تطوَّر

234
00:15:38,410 --> 00:15:40,480
!أكس فيمون

235
00:15:43,680 --> 00:15:46,260
...هوكمون، تطوَّر

236
00:15:47,950 --> 00:15:49,870
!أكويلامون

237
00:15:52,790 --> 00:15:55,820
...أرماجيمون، تطوَّر

238
00:15:57,690 --> 00:15:59,790
!أنكيلومون

239
00:16:02,190 --> 00:16:04,540
!اللّيزر أكس

240
00:16:04,930 --> 00:16:06,670
!اللّيزر الانفجاريّ

241
00:16:12,850 --> 00:16:13,990
!أنكيلومون

242
00:16:13,990 --> 00:16:16,590
ليتنا نستطيعُ التطوُّر إلى مُستوى مِثاليّ الآن

243
00:16:16,590 --> 00:16:17,570
...لتمكنَّا من

244
00:16:17,810 --> 00:16:21,030
ليس الأمر بأيدينا، يتوجّبُ علينا
فعل ما يُمكننا فعله

245
00:16:21,310 --> 00:16:22,270
أجل

246
00:16:23,140 --> 00:16:25,460
!تطوَّري أيّتُها البيضة الرّقميّة

247
00:16:26,690 --> 00:16:29,880
...تيلمون، تطوَّري درعيّاً

248
00:16:32,960 --> 00:16:36,550
!نور البسمات: نيفيرتيمون

249
00:16:38,150 --> 00:16:40,140
...باتامون، تطوَّر

250
00:16:41,920 --> 00:16:43,400
!أنجيمون

251
00:16:47,920 --> 00:16:49,070
!هوكمون

252
00:16:50,040 --> 00:16:52,120
!بُرجُمة السَّماء

253
00:16:56,660 --> 00:16:57,890
!باتامون

254
00:16:57,890 --> 00:17:01,220
هجماتُ أنجيمون أقلّ فعاليّة ضدّ
!الأعداء غير الظلاميّين

255
00:17:04,650 --> 00:17:06,040
...الحجر... الحجر

256
00:17:09,120 --> 00:17:10,570
!تيلمون

257
00:17:15,830 --> 00:17:16,860
!كين-تشان

258
00:17:17,140 --> 00:17:18,820
!وارمون، لنتطوَّر

259
00:17:38,390 --> 00:17:42,040
...وارمون، تطوَّر

260
00:17:46,520 --> 00:17:48,340
!ستينغمون

261
00:17:55,940 --> 00:17:58,370
!النِّهاية المُدبَّبة

262
00:17:59,410 --> 00:18:00,660
!ستينغمون

263
00:18:01,710 --> 00:18:03,060
آسِف لتأخُّري

264
00:18:03,060 --> 00:18:05,620
عرفتُ أنَّك ستأتي! أين الشَّارة؟

265
00:18:07,110 --> 00:18:09,290
هذه هي! لنُسرِع

266
00:18:09,680 --> 00:18:11,580
يجب أن تُغادِروا جميعاً

267
00:18:11,580 --> 00:18:12,580
ماذا؟

268
00:18:14,550 --> 00:18:18,710
!الوقتُ يُداهمنا. سنتولَّى أمر هذا

269
00:18:19,110 --> 00:18:20,670
!اخرجوا جميعاً من هُنا بسُرعة

270
00:18:21,850 --> 00:18:23,650
!ستأتي معنا

271
00:18:23,650 --> 00:18:25,120
!لا أستطيع

272
00:18:25,120 --> 00:18:28,770
!عمّاذا تتحدَّث؟ ماذا تنوي أن تفعل؟

273
00:18:29,150 --> 00:18:33,120
!لا أستطيع أن أدع النّاسَ يُعانون بسببِ ما فعلتُه

274
00:18:33,630 --> 00:18:34,850
!يَكفي إلى هُنا

275
00:18:34,850 --> 00:18:36,080
إتشيجوجي

276
00:18:36,350 --> 00:18:40,070
لمَ كان عليّ أن أصبِح قيصر الدِّيجيمون؟

277
00:18:40,370 --> 00:18:43,540
لم أتمكَّن من إيقافِ كين-تشان

278
00:18:43,900 --> 00:18:45,220
ستينغمون

279
00:18:45,510 --> 00:18:48,750
!أريدُ استعادة العالم الرّقميّ بيدَيّ هاتين

280
00:18:48,750 --> 00:18:52,410
!لكن تزدادُ الأمور سوءاً ولا أستطيع تحمُّل ذلك

281
00:18:52,410 --> 00:18:55,050
!لا أريد مزيداً من الدَّمارِ في هذا العالم

282
00:18:56,300 --> 00:18:57,200
...أنت

283
00:18:57,490 --> 00:19:01,700
إن كانَتْ هُناك طريقة للتكفيرِ عن
...الخطايا الّتي ارتكبتُها

284
00:19:02,450 --> 00:19:04,480
!فلا يهمُّني ما يحلُّ بي

285
00:19:04,480 --> 00:19:07,170
!الآن، علينا إيقاف هذا المفاعل

286
00:19:07,170 --> 00:19:07,850
!أحمق

287
00:19:09,090 --> 00:19:10,830
!كيف تقولُ هذا الكلام؟

288
00:19:10,830 --> 00:19:11,990
!لا تخدعْ نفسك

289
00:19:12,550 --> 00:19:16,260
!فكِّر بمن سيحزن إذا رحلتَ أنت

290
00:19:16,960 --> 00:19:20,700
،إذا تركتُك تذهبُ الآن ولم تعُد

291
00:19:20,700 --> 00:19:22,230
!سأعيشُ مُتحسِّراً على ذلك للأبد

292
00:19:22,480 --> 00:19:24,200
!لِذا لن أدعك تذهب

293
00:19:24,240 --> 00:19:28,340
أتظنُّ أنَّك تستطيع تَرك شريكك يسقطُ هكذا فحسب؟

294
00:19:28,890 --> 00:19:31,860
!حتّى لو كنتَ راضياً بذلك، لن أرضى أنا

295
00:19:31,860 --> 00:19:33,140
...موتوميا

296
00:19:33,830 --> 00:19:34,580
!عِش

297
00:19:36,200 --> 00:19:40,020
من واجبِك كشريكٍ أن تعيشَ مع شُركائك مهما كلَّفَ الأمر

298
00:19:40,370 --> 00:19:43,500
إن أردتَ التَّكفير عن خطاياك فعليك أن تُحافِظَ على حياتِك

299
00:19:43,710 --> 00:19:48,460
معك حقّ. لا أستطيع التّكفير ما لم أعِش

300
00:19:48,650 --> 00:19:52,950
!إذا سقطت الآن فلن تتمكَّن من إنجازِ شيء

301
00:19:52,950 --> 00:19:54,430
!لستُ راضياً بذلك

302
00:19:56,010 --> 00:19:57,390
...ولا أنا أيضاً

303
00:19:57,900 --> 00:20:01,390
ما زالَتْ هناك الكثير من الأمورِ الّتي عليّ فعلها

304
00:20:02,150 --> 00:20:04,850
لا ينبغي أن أسقط هنا

305
00:20:05,180 --> 00:20:05,860
...بالإضافة

306
00:20:06,290 --> 00:20:09,230
لا أريد أن أشعر عائلتي بالحزن بعدَ الآن

307
00:20:19,400 --> 00:20:22,170
أهذا نبضُ قلب كين؟

308
00:20:24,140 --> 00:20:28,110
أستطيع الشُّعور بنبضِ دايسكي

309
00:20:32,240 --> 00:20:33,580
!أكس فيمون

310
00:20:36,200 --> 00:20:37,510
!ستينغمون

311
00:20:39,370 --> 00:20:41,570
...تطوُّر جوغريس

312
00:20:44,390 --> 00:20:45,990
!بايلدرامون

313
00:20:52,750 --> 00:20:54,130
!بايلدرامون؟

314
00:20:58,670 --> 00:21:00,200
اندمجا

315
00:21:01,010 --> 00:21:02,850
!تطوُّر جوغريس؟

316
00:22:37,490 --> 00:22:39,290
...القوّةُ القاهِرة لبايلدرامون

317
00:22:39,290 --> 00:22:40,870
تُبيدُ العدوّ

318
00:22:40,870 --> 00:22:42,570
...لكن طاقة الظَّلام تكسبُ القوّة

319
00:22:42,570 --> 00:22:44,370
وتستمرُّ في الانتشار

320
00:22:44,370 --> 00:22:46,650
الأطفالُ يشقّون طريقَهم عبر القلعة المُحترِقة

321
00:22:46,650 --> 00:22:48,300
...يقترِب الانفجار شيئاً فشيئاً

322
00:22:48,960 --> 00:22:52,240
وتنكشِف أسرارُ العالمِ الرّقميّ

323
00:22:52,240 --> 00:22:54,990
ماذا حدثَ لتايتشي والآخرين خلال
السّنوات الثّلاث الماضية؟

324
00:22:54,990 --> 00:22:57,190
!الحلقة القادمة من مغامرة الدّيجيمون 02

325
00:22:57,190 --> 00:22:59,330
"المزيج الّذي لا نظير له! بايلدرامون"

326
00:22:59,330 --> 00:23:01,730
!البوّابة المؤدّية إلى المغامرة مفتوحة الآن