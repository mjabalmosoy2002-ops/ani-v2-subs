1
00:01:33,410 --> 00:01:35,780
...تحكّم قيصر الدّيجيمون بآندرومون

2
00:01:35,780 --> 00:01:37,870
في مُحاولة منه لهزيمة دايسكي والأصدقاء

3
00:01:45,390 --> 00:01:48,480
لكن لم تستطع حلقة الشرّ التحكّم بشكل كامل

4
00:01:48,480 --> 00:01:51,210
بآندرومون ذي المستوى المطلق

5
00:01:54,810 --> 00:01:56,530
...المعركة بين الأطفال المُختارين

6
00:01:56,530 --> 00:01:58,760
...وقيصر الدّيجيمون تستعرّ

7
00:02:05,650 --> 00:02:08,020
"وحدة قيصر الدّيجيمون"

8
00:02:20,080 --> 00:02:21,970
دايسكي، أحسنتَ اللّعِب

9
00:02:24,710 --> 00:02:25,880
تجمَّعوا

10
00:02:27,110 --> 00:02:29,540
هذا الأحد، سنُجري مُباراةً تمرينيّة

11
00:02:29,860 --> 00:02:34,860
،خصمُنا هو بطلُ بطولة شباب طوكيو لكرةِ القدم
فريق فتيان تاماتشي لكرة القدم

12
00:02:35,710 --> 00:02:40,300
حضرة المُدرِّب، هل ذلك الفريقُ هو الذي
يلعب فيه ذلك الفتى العبقريّ؟

13
00:02:40,760 --> 00:02:43,260
نعم، إتشيجوجي كين-كن

14
00:02:43,450 --> 00:02:51,700
إتشيجوجي كين من فريق فتيان تاماتشي يحمل سجلّ 45 هدفاً
في البطولة السّابقة، وهذا ما جعلهم أبطالاً

15
00:02:51,700 --> 00:02:54,610
مذهل! هذا ضعفَي السجلّ السّابق

16
00:02:54,610 --> 00:02:57,180
يبدو أنّ لقبه، العبقريّ، لم يكن عبثاً

17
00:02:57,180 --> 00:02:58,980
سيكونُ خصماً عظيماً

18
00:02:58,980 --> 00:03:02,070
لم نتواجه في البطولةِ السَّابِقة

19
00:03:02,070 --> 00:03:04,770
لو وصلتُم للنِّهائي لكنتُم قد واجهتموه، صحيح؟

20
00:03:04,770 --> 00:03:06,320
...لا تقل ذلك

21
00:03:06,320 --> 00:03:07,700
هل يُمكنكم الفوز؟

22
00:03:07,700 --> 00:03:09,540
المسألةُ ليسَتْ مسألة فوز أو خسارة

23
00:03:09,840 --> 00:03:13,160
بل أنَّ كلّ الفتيان الذين يلعبون كرة القدم
الآن في هذا البلد يريدون أن يكونوا مثله

24
00:03:13,160 --> 00:03:15,660
مُجرَّد التَّفكير باللّعبِ ضدّه يجعلُني أتحمَّس

25
00:03:15,660 --> 00:03:17,070
أخبرني يا داي-تشان

26
00:03:17,070 --> 00:03:18,500
داي-تشان؟

27
00:03:19,470 --> 00:03:23,040
إن التقيتَ بإتشيجوجي كين-كن، هل يمكنك
أن تحضر لي توقيعه؟

28
00:03:23,040 --> 00:03:26,190
أذكرُ أنَّكِ قلتِ أنَّكِ لا تُحبِّين الأولادَ الأصغر سنَّاً

29
00:03:26,190 --> 00:03:31,080
كلّها عام واحد؟ أمِّي أكبر من أبي بثلاث سنوات على أيّ حال

30
00:03:31,790 --> 00:03:34,250
لماذا لا تحصلين عليه بنفسكِ؟

31
00:03:34,760 --> 00:03:36,300
معكَ حقّ

32
00:03:36,300 --> 00:03:38,340
إذاً سنذهبُ كلّنا ونُشجِّعُك

33
00:03:38,860 --> 00:03:39,820
حقّاً؟

34
00:03:40,600 --> 00:03:42,600
سنذهبُ أيضاً يا دايسكي

35
00:03:43,020 --> 00:03:46,400
...حسناً، سأُري ذلك الفتى العبقريّ

36
00:03:46,400 --> 00:03:48,040
!قوّتي

37
00:03:58,240 --> 00:03:59,480
افعل ما بوسعِك

38
00:03:59,480 --> 00:04:00,550
أجل

39
00:04:00,550 --> 00:04:02,130
بالتوفيق يا دايسكي

40
00:04:03,410 --> 00:04:04,300
ها هم

41
00:04:07,670 --> 00:04:09,560
...إتشيجوجي كين وأنا أخيرًا سوف

42
00:04:09,960 --> 00:04:12,010
!سألتقي به

43
00:04:20,920 --> 00:04:23,110
ماذا؟ أين كين-كن؟

44
00:04:23,110 --> 00:04:24,240
لم يأتِ؟

45
00:04:25,960 --> 00:04:27,170
ماذا؟

46
00:04:27,170 --> 00:04:29,100
يبدو أنّه لم يأتِ

47
00:04:29,100 --> 00:04:29,940
لماذا؟

48
00:04:30,350 --> 00:04:32,340
لماذا لم يأتِ كين-كن إلى هنا؟

49
00:04:32,340 --> 00:04:34,450
و-وما أدراني؟

50
00:04:34,450 --> 00:04:35,740
!لماذا؟

51
00:04:35,740 --> 00:04:37,630
لا تسأليني أيضاً

52
00:04:39,460 --> 00:04:40,590
...عفواً

53
00:04:40,990 --> 00:04:42,940
هل سيلعبُ إتشيجوجي-كن اليوم؟

54
00:04:42,940 --> 00:04:46,730
يُفترضُ أنه يعرِفَ بشأنِ المُباراة، لكنَّني
لا أعرف فيما إذا كان سيأتي

55
00:04:46,730 --> 00:04:49,470
إنَّه مشغولٌ جدّاً بخلافِنا نحن

56
00:04:49,780 --> 00:04:51,050
...هذا مُؤسِف

57
00:04:51,560 --> 00:04:52,560
دايسكي

58
00:04:53,040 --> 00:04:54,010
تعالَ إلى هُنا للحظة

59
00:04:55,990 --> 00:04:59,000
حتَّى ولو لم يأتِ إتشيجوجي، يظلّون أبطالاً

60
00:04:59,000 --> 00:05:00,480
توخَّ الحذر

61
00:05:00,810 --> 00:05:01,780
...حسناً

62
00:05:01,780 --> 00:05:06,250
دايسكي-كن، فرصتك اليوم لهزيمةِ الأبطال

63
00:05:06,250 --> 00:05:07,930
نعم، افعل ما بوسعِك

64
00:05:08,660 --> 00:05:10,410
نعم، اعتمِدوا عليّ

65
00:05:11,950 --> 00:05:17,280
لماذا لم يأتِ كين-كن إلى هنا؟ لماذا قطعتُ
!كلّ هذه المسافة إلى هنا؟

66
00:05:16,700 --> 00:05:17,920
...مياكو-سان

67
00:05:59,110 --> 00:06:00,980
لقطة ممتازة

68
00:06:01,780 --> 00:06:03,740
تبدو رائعاً يا دايسكي

69
00:06:03,740 --> 00:06:05,210
بالطَّبع

70
00:06:05,210 --> 00:06:06,690
بالتوفيق لك في الشوط الثاني أيضاً

71
00:06:07,580 --> 00:06:10,090
تقدّمتُم بهدف، ولكن هذا لا يعني أن تنتقِلوا للأسلوبِ الدِّفاعي

72
00:06:10,090 --> 00:06:11,810
سيُلاحِظون ذلك ويستغلُّون الأمر

73
00:06:12,160 --> 00:06:15,920
لا تقلق، لا تقلق، شاهدوني فحسب وأنا أُحرِزُ ثُلاثيّة

74
00:06:21,300 --> 00:06:22,690
أتى أخيراً

75
00:06:25,320 --> 00:06:27,590
إنّه هو حقّاً

76
00:06:27,590 --> 00:06:29,460
!إتشيجوجي كين

77
00:06:53,300 --> 00:06:55,730
يسرُّني أنَّك أتيت يا إتشيجوجي-كن

78
00:06:55,730 --> 00:07:00,310
أعتذِرُ عن تأخَّري. اضطررتُ للقيام ببعض الأعمال

79
00:07:00,610 --> 00:07:03,430
لا ، لا. أنا حقَّاً مسرورٌ بمجيئك

80
00:07:03,430 --> 00:07:05,160
هل ستلعبُ في الشَّوطِ الثَّاني؟

81
00:07:05,550 --> 00:07:06,570
سيكون هذا من دواعي سروري

82
00:07:10,980 --> 00:07:13,570
سُرِرتُ بلقائك. أنا موتوميا دايسكي

83
00:07:17,980 --> 00:07:22,930
إنَّه أفضل شخصيّاً منه في التّلفزيون، لا أصدّق
أنّه أصغر منّي

84
00:07:22,930 --> 00:07:24,340
إنّه خالٍ من الفجوات، أليس كذلك؟

85
00:07:24,340 --> 00:07:26,710
حظَّاً سعيداً يا دايسكي-كن

86
00:07:26,730 --> 00:07:28,050
!قاتل

87
00:07:28,050 --> 00:07:31,550
دايسكي، إنَّه مُجرَّد تلميذ ابتدائيّة آخر، لا تخسر

88
00:07:33,140 --> 00:07:34,920
سُرِرتُ بلقائك أيضاً

89
00:07:38,270 --> 00:07:39,310
إتشيجوجي

90
00:07:51,100 --> 00:07:51,890
...إنّه سريع

91
00:07:52,780 --> 00:07:54,380
أحسنتَ اللّعب يا كين-كن

92
00:07:54,380 --> 00:07:56,350
...لكنّه عادلَ النّتيجةَ فحسب

93
00:07:56,350 --> 00:07:59,390
أجل، لكن كين-كن أوسم من دايسكي

94
00:07:59,390 --> 00:08:01,420
مستواه مختلف تماماً

95
00:08:01,420 --> 00:08:04,500
إنَّه ليسَ بمُستوى مرحلة ابتدائيّة

96
00:08:04,500 --> 00:08:07,550
تقنيتُه أقرب لنجمٍ في دوري الشّباب

97
00:08:07,550 --> 00:08:11,160
معك حقّ... تحرّكاته مختلفةٌ تماماً عن الآخرين

98
00:08:11,160 --> 00:08:13,380
لديه رؤيةٌ شامِلة للملعب

99
00:08:13,380 --> 00:08:15,050
هل لاحظت يا تاكيرو-كن؟

100
00:08:15,050 --> 00:08:17,700
كما في كرةِ السلّة

101
00:08:17,700 --> 00:08:22,030
يعرف تحرّكات خصومه وزُملائه في الفريق، لهذا
يستطيع التّهديف بسهولة

102
00:08:22,030 --> 00:08:23,830
كين-كن رائع كما توقّعت

103
00:08:23,830 --> 00:08:24,980
...مياكو-سان

104
00:08:28,920 --> 00:08:31,490
تبّاً... هذا صعب

105
00:08:34,990 --> 00:08:36,820
!التّشكيلة الأخيرة د

106
00:08:44,480 --> 00:08:46,160
أحرِزوا العاشر

107
00:08:46,540 --> 00:08:47,570
ماذا؟

108
00:08:49,930 --> 00:08:52,920
لا خطأ، أحسنتَ يا دايسكي

109
00:08:57,510 --> 00:09:00,600
النّتيجة 9-1، الرّابِحُ هو فريق فتيان تاماتشي

110
00:09:00,600 --> 00:09:02,480
شكراً لكم

111
00:09:02,970 --> 00:09:04,750
المعذرة يا إتشيجوجي-كن

112
00:09:05,590 --> 00:09:08,780
...هل أنتَ بخير؟ بشأنِ ساقِك اليمنى

113
00:09:10,650 --> 00:09:12,950
ليسَتْ بمُشكلة

114
00:09:12,950 --> 00:09:17,040
يسرّني هذا... لكنّك ترتقي حقّاً لسمعتِك

115
00:09:17,040 --> 00:09:18,620
لا أُقارَنُ بك إطلاقاً

116
00:09:19,100 --> 00:09:21,860
كان تدّخلك في النِّهاية ممتازًا

117
00:09:21,860 --> 00:09:24,570
...ظننتُك ستأتي من الطرفِ المُقابِل

118
00:09:24,570 --> 00:09:29,880
في الواقع، خسارتنا بهذا الشّكل جعلتني أفكّر
أنّي لا أستطيع إلّا استهداف القائد

119
00:09:31,360 --> 00:09:34,750
لكنّها المرّة الأولى التي نعجزُ فيها عن الإحراز
باستخدام تلك التّشكيلة

120
00:09:34,750 --> 00:09:36,080
ماذا؟ حقَّاً؟

121
00:09:36,080 --> 00:09:38,630
موتوميا دايسكي-كن، صحيح؟

122
00:09:38,630 --> 00:09:40,110
أتطلّع للقائنا القادم

123
00:09:41,630 --> 00:09:43,050
وأنا كذلك

124
00:09:46,690 --> 00:09:49,860
لقد خسرت، لكنّك لا تبدو مُحبَطاً

125
00:09:49,860 --> 00:09:54,740
قال "دايسكي-كن"... ذلك العبقريّ قد تذكّرَ اسمي

126
00:09:54,740 --> 00:09:56,460
قد أستطيع التفاخر بذلك مستقبلاً

127
00:09:57,660 --> 00:09:59,760
...لم أحصلْ على توقيعِ كين-كن

128
00:09:59,460 --> 00:10:00,450
...مياكو-سان

129
00:10:00,930 --> 00:10:03,780
ولكن كانَتْ تِلك الانزلاقة الأخيرة رائعة

130
00:10:03,780 --> 00:10:04,660
نعم

131
00:10:04,660 --> 00:10:06,150
اندهشتُ أيضاً

132
00:10:06,150 --> 00:10:11,280
حقّاً؟ رُبَّما سيتمُّ اختياري لمُنتخب اليابان
الوطني لكرةِ القدم في المستقبل

133
00:10:11,280 --> 00:10:14,830
يُمكنك أن تقول ذلك بعد أن تقدّموا نتيجة مُشرّفة

134
00:10:14,830 --> 00:10:17,420
كانَتْ مُباراتكم من طرفٍ واحد
إذا ما استثنينا تلك الانزلاقة

135
00:10:18,270 --> 00:10:20,860
تايتشي-سان، أنت صارم

136
00:10:53,890 --> 00:10:56,300
دايسكي. أعطِني يدَك اليُمنى

137
00:10:57,660 --> 00:10:58,890
هكذا؟

138
00:10:59,380 --> 00:11:03,510
إن أمسكتُ بيدِك فسأكونُ أقرب إلى كين-كن

139
00:11:07,520 --> 00:11:09,140
...لا... لا أستطيع

140
00:11:09,690 --> 00:11:13,900
حسِّي الجمالي لا يسمحُ لي بمُصافحةِ دايسكي

141
00:11:13,900 --> 00:11:15,500
ماذا تفعلين؟

142
00:11:15,500 --> 00:11:16,630
...هذا

143
00:11:16,630 --> 00:11:18,150
ما الأمر يا إيوري؟

144
00:11:18,570 --> 00:11:19,630
انظروا إلى هذه

145
00:11:19,630 --> 00:11:21,620
يوجد برج ظلام هنا

146
00:11:21,620 --> 00:11:23,080
لم يكن موجوداً هنا البارحة

147
00:11:23,080 --> 00:11:25,590
لا بُدَّ وأنَّه بُني في الليلةِ الماضيّة

148
00:11:25,590 --> 00:11:27,410
أيّ نوعٍ من الأماكنِ هو؟

149
00:11:27,410 --> 00:11:30,980
إنّه "ديث فالي" بمعنى وادي الموت

150
00:11:30,980 --> 00:11:33,060
ولكن لا يوجدُ شيءٌ في ذلك المكان، داغيا

151
00:11:33,060 --> 00:11:35,060
لماذا في مكان قصيّ كهذا؟

152
00:11:35,060 --> 00:11:37,840
ما الذي يخطّط له قيصر الدّيجيمون؟

153
00:11:38,160 --> 00:11:43,300
رُبَّما يُؤمّنُ موطئ قدمٍ كي يتوسَّعَ من هُناك
تدريجيّاً للتحكّم بالمنطقة

154
00:11:43,300 --> 00:11:45,870
ينبغي أن نفعلَ شيئاً حيالَ ذلك حالاً

155
00:11:45,870 --> 00:11:46,640
أجل

156
00:11:47,610 --> 00:11:49,100
هيّا بنا يا دايسكي-كن

157
00:11:52,230 --> 00:11:54,690
هلّا أسرعتِ وقرَّرتِ؟

158
00:12:05,290 --> 00:12:07,660
لا يوجد شيء في هذا المكان حقّاً

159
00:12:07,940 --> 00:12:09,120
!ها هو

160
00:12:09,460 --> 00:12:14,030
ولكن علينا أن نكونَ حذرين. فنحنُ لا نعرفُ فيما
إذا كان هُناك أعداء يختبئون في مكان ما

161
00:12:14,030 --> 00:12:15,080
هذا صحيح

162
00:12:22,850 --> 00:12:23,820
مياكو-سان

163
00:12:23,820 --> 00:12:24,800
هوكمون

164
00:12:26,660 --> 00:12:27,970
...ماذا

165
00:12:28,520 --> 00:12:29,990
!ما الذي يجري؟

166
00:12:29,990 --> 00:12:32,770
كُن حذِراً يا دايسكي، قد يكون فخَّاً

167
00:12:37,100 --> 00:12:38,220
!أين نحن؟

168
00:12:45,040 --> 00:12:47,770
دايسكي، ألا ينبغي أن نستدعي تايتشي والآخرين؟

169
00:12:47,770 --> 00:12:50,550
لا، سيستغرِقُ ذلك وقتاً طويلاً

170
00:12:50,830 --> 00:12:52,770
...تبَّاً لقيصر الدّيجيمون

171
00:12:52,770 --> 00:12:54,580
...تبدو في ورطةٍ كبيرة

172
00:12:55,430 --> 00:12:58,170
!قيصر الدّيجيمون! هل أنت الفاعل؟

173
00:12:58,170 --> 00:13:03,450
أنا أحتجز أصدقاءك الأعزّاء، إن أردتَ رؤيتهم
فالأفضل أن تسرع بالمجيء إلى هنا

174
00:13:03,890 --> 00:13:04,640
تبّاً

175
00:13:12,320 --> 00:13:13,980
تبَّاً

176
00:13:17,630 --> 00:13:18,940
قيصر الدّيجيمون

177
00:13:21,450 --> 00:13:22,860
...أحسنتَ صنعاً

178
00:13:23,510 --> 00:13:24,820
!أين الجميع؟

179
00:13:24,820 --> 00:13:26,590
أمامك مباشرة

180
00:13:26,590 --> 00:13:27,620
ماذا؟

181
00:13:31,550 --> 00:13:33,190
!يا شباب، هل أنتم بخير؟

182
00:13:34,150 --> 00:13:36,270
!دايسكي-كن، أنا آسفة

183
00:13:36,270 --> 00:13:37,890
كنّا مُستهترين

184
00:13:37,890 --> 00:13:39,920
!دايسكي-سان، كن حذراً

185
00:13:39,920 --> 00:13:42,230
ساعدنا بسُرعة يا دايسكي

186
00:13:43,120 --> 00:13:44,490
أنا قادم في الحال

187
00:13:44,490 --> 00:13:45,970
توقّف مكانك

188
00:13:46,540 --> 00:13:49,300
ألا تهمّك أرواح أصدقائك؟

189
00:13:49,300 --> 00:13:50,250
ماذا؟

190
00:13:50,860 --> 00:13:52,630
اخرج يا ديلتامون

191
00:14:00,900 --> 00:14:05,220
ديلتامون، ديجيمون تنّين برأس معدنيّ على ذراعِه
اليُمنى ورأس جمجمة على ذراعِه اليُسرى

192
00:14:05,220 --> 00:14:07,320
هجمتُه الخاصَّة هي القوّةُ الثُلاثيّة

193
00:14:07,770 --> 00:14:13,410
!حان وقت إطعام ديلتامون! وسيكون أصدقاؤك وجبته

194
00:14:13,410 --> 00:14:15,250
لا

195
00:14:15,250 --> 00:14:18,430
توقَّف، لن أدعَك تفعلُ ذلك

196
00:14:18,430 --> 00:14:21,800
تدعني؟ مع من تظنُّ نفسك تتكلَّم؟

197
00:14:21,800 --> 00:14:24,920
...حياةُ أصدقائك بين يديّ الآن

198
00:14:25,420 --> 00:14:28,030
...إن أردتَ إنقاذهم... فدعنا نرى

199
00:14:28,750 --> 00:14:30,390
انحنِ لي

200
00:14:30,790 --> 00:14:31,890
!ماذا؟

201
00:14:33,870 --> 00:14:35,080
...دايسكي

202
00:14:35,120 --> 00:14:37,150
أرجوك، دعهم وشأنهم

203
00:14:37,150 --> 00:14:40,110
ألا ينبغي أن تتوسّل إليّ؟

204
00:14:41,950 --> 00:14:44,270
أتوسّل إليك... دعهم وشأنهم

205
00:14:44,300 --> 00:14:47,070
فيمون، دُسْ على رأسِه

206
00:14:48,850 --> 00:14:51,060
هذا لا يهمّ. افعلها يا فيمون

207
00:14:51,390 --> 00:14:52,280
...ولكن

208
00:14:52,790 --> 00:14:55,690
!علينا أن ننقذ الجميع. بسرعة

209
00:14:58,710 --> 00:15:00,880
...آسف... أنا آسف يا دايسكي

210
00:15:02,000 --> 00:15:05,130
...يا له من مشهد مُثير للشَّفقة. قد أُحرّرهم

211
00:15:05,130 --> 00:15:06,060
!حقّاً؟

212
00:15:06,060 --> 00:15:08,630
...ولكن ليسَ الجميع

213
00:15:09,770 --> 00:15:13,220
فديلتامون جائعٌ جدَّاً بعدَ الانتظارِ لهذه الفترة الطَّويلة

214
00:15:16,860 --> 00:15:20,020
يُمكنُك إنقاذ شخصٍ واحدٍ فقط... اختر واحداً

215
00:15:20,440 --> 00:15:21,870
!ماذا؟

216
00:15:23,880 --> 00:15:26,010
...أختار... واحداً فقط

217
00:15:27,010 --> 00:15:30,860
أمنحُك مدّة هذه السّاعة الرمليّة لتُقرِّر

218
00:15:30,860 --> 00:15:34,780
إن لم تُجبْ قبل أن تنتهي المدّة... سيموتون جميعاً

219
00:15:36,290 --> 00:15:39,370
دايسكي-كن، لا داعي لي، اختر شخصاً آخر

220
00:15:39,890 --> 00:15:42,250
سأُضحِّي بنفسي، اختر شخصاً آخر

221
00:15:42,520 --> 00:15:46,220
لا أريدُ للجميعِ أن يموتوا، لا أريدُ أن أكونَ الوحيدة الّتي تنجو

222
00:15:46,220 --> 00:15:49,910
دايسكي-سان، سنقبل بقرارك

223
00:15:50,230 --> 00:15:52,570
...ماذا... ينبغي أن أفعل

224
00:15:54,470 --> 00:15:56,600
من أختار؟

225
00:15:59,470 --> 00:16:02,400
!إن لم تُسرع فإنّ وقتك سينفد

226
00:16:03,300 --> 00:16:06,020
...أنا... أنا

227
00:16:06,320 --> 00:16:10,490
...هل ستُخاطِرُ بهم جميعاً؟ أنتَ لا تستحِقُّ الأصدقاء

228
00:16:11,590 --> 00:16:12,610
...أنا

229
00:16:20,950 --> 00:16:23,160
تبّاً، تبّاً

230
00:16:23,460 --> 00:16:28,420
أهنتَ كرامتي. تستحِقُّ هذه المُعاناة بأقل تقدير

231
00:16:29,490 --> 00:16:30,570
انتهى الوقت

232
00:16:31,540 --> 00:16:33,010
الأطفالُ المُختارون

233
00:16:33,010 --> 00:16:36,670
موتوا وأنتُم حاقدين على موتوميا دايسكي

234
00:16:38,000 --> 00:16:40,520
...لحظة، بدلاً من الجميع

235
00:16:40,520 --> 00:16:42,400
اخترني بدلاً عنهم

236
00:16:43,820 --> 00:16:47,540
هذا سهلٌ كثيراً، لكنَّني سأمنحُك تِلك الأُمنيّة

237
00:16:47,540 --> 00:16:48,560
ديلتامون

238
00:17:01,410 --> 00:17:02,310
!ماذا؟

239
00:17:05,430 --> 00:17:06,450
ديغمون؟

240
00:17:07,220 --> 00:17:08,570
فيمون

241
00:17:09,650 --> 00:17:10,560
هولسمون

242
00:17:10,560 --> 00:17:11,820
نيفيرتيمون

243
00:17:11,820 --> 00:17:12,920
بيغاسمون

244
00:17:12,920 --> 00:17:13,970
دايسكي-كن

245
00:17:14,480 --> 00:17:15,730
نحنُ بخير

246
00:17:15,730 --> 00:17:17,760
رفاق! إذاً هؤلاء...؟

247
00:17:24,760 --> 00:17:28,330
باكيمون، ديجيمون شبح بقُماشة رأس

248
00:17:28,330 --> 00:17:30,260
هويّتُه مُطوَّقةٌ بالغموض

249
00:17:30,260 --> 00:17:32,170
هجمتُه الخاصّة هي يد الجحيم

250
00:17:32,170 --> 00:17:33,740
كانوا مُجرَّد باكيمون

251
00:17:34,260 --> 00:17:38,330
أغبياء! ألم تستطيعوا الحفاظ على أشكالهم
فترة أطول؟

252
00:17:38,330 --> 00:17:39,700
...أنا آسف كين-تشان

253
00:17:40,160 --> 00:17:42,390
...يجرؤ على استخدام خدعةً رخيصةً كهذه

254
00:17:42,600 --> 00:17:44,080
هيَّا بنا يا فيمون

255
00:17:44,080 --> 00:17:45,660
حسناً يا دايسكي

256
00:17:49,370 --> 00:17:51,340
ترقّي أيّتها البيضة الرّقميّة

257
00:17:57,880 --> 00:18:01,240
فيمون، تطوّر درعيّاً

258
00:18:16,220 --> 00:18:19,360
الشّجاعةُ المُلتهِبة، فليدرامون

259
00:18:22,340 --> 00:18:23,050
هاجموا يا باكيمون

260
00:18:24,050 --> 00:18:25,330
!التّشكيلة أ

261
00:18:27,070 --> 00:18:28,540
!التّشكيلة ج

262
00:18:33,310 --> 00:18:34,380
هاجموا

263
00:18:40,460 --> 00:18:46,550
إنّه قيصر الدّيجيمون. يفهم تحرّكات العدوّ
والحليف ويصدر الأوامر وفق ذلك

264
00:18:47,350 --> 00:18:48,810
...قيصر الدّيجيمون الحقير

265
00:18:48,980 --> 00:18:51,230
!نارُ البُرجمة

266
00:18:51,230 --> 00:18:53,150
اندفاعةُ الذَّهب

267
00:18:54,780 --> 00:18:56,300
التّشكيلة ف

268
00:18:57,800 --> 00:18:59,490
...والتَّالي

269
00:19:01,330 --> 00:19:02,580
كين-تشان

270
00:19:04,650 --> 00:19:09,230
لن نخسرَ أمامَ جبانٍ مثلك يأسر الآخرين

271
00:19:09,230 --> 00:19:12,630
أنا بمستوى مُختلِفٍ عنكم جميعاً. أنا عبقريّ

272
00:19:12,630 --> 00:19:13,460
أيّاً يكن

273
00:19:16,610 --> 00:19:18,880
ديلتامون، القوّة الثلاثيّة

274
00:19:22,090 --> 00:19:24,350
الوداع يا موتوميا دايسكي-كن

275
00:19:24,700 --> 00:19:25,990
لن أسمح بذلك

276
00:19:26,420 --> 00:19:27,350
فليدرامون

277
00:19:28,810 --> 00:19:31,740
نحن... لن نخسر أمام أحد

278
00:19:37,230 --> 00:19:39,050
صاروخ النَّار

279
00:19:45,730 --> 00:19:48,910
من دون أوامرِ القيصر، الباكيمون في حالة هلع

280
00:19:48,910 --> 00:19:51,950
اتركوا هذا الأمرَ لي، استهدِفوا برجَ الظَّلام

281
00:19:51,950 --> 00:19:52,880
عُلِم

282
00:19:53,420 --> 00:19:55,380
!شِهاب

283
00:19:59,320 --> 00:20:01,090
جناح العاصِفة

284
00:20:01,930 --> 00:20:03,790
الحجرُ الرّشيد

285
00:20:04,550 --> 00:20:06,360
الشقُّ الكبير

286
00:20:10,540 --> 00:20:11,920
رائع

287
00:20:13,770 --> 00:20:17,860
لم أتوقّع أن أسقط بنفس الطريقة مرّتين

288
00:20:17,860 --> 00:20:18,730
مرّتان؟

289
00:20:19,850 --> 00:20:26,870
سوء حساباتي. عندما تشتدّ الأمور عليك، فإنّك
تستهدف القائد بلا تفكير. نسيتُ ذلك تماماً

290
00:20:27,260 --> 00:20:28,770
ماذا تعني؟

291
00:20:29,100 --> 00:20:31,030
!ذلك الجرح في ساقك

292
00:20:34,010 --> 00:20:36,460
...مستحيل... هذه صدفة بالتأكيد

293
00:20:37,300 --> 00:20:40,960
إنَّها ليسَتْ صدفة. كما تظنُّ تماماً

294
00:20:40,960 --> 00:20:42,760
...غـ... غير ممكن

295
00:20:43,230 --> 00:20:44,970
!إتشيجوجي كين

296
00:20:45,440 --> 00:20:50,800
ربّما ربحتم المعركة، لكن من الآن
فصاعداً، سأقاتل بجدّية

297
00:20:55,240 --> 00:20:59,100
...لقد... لقد احترمتُك

298
00:20:59,850 --> 00:21:04,030
...لكونك في نفس السنّ وكونك عظيماً، لكن

299
00:21:04,600 --> 00:21:07,060
!لماذا؟

300
00:22:36,900 --> 00:22:39,530
تهبُّ عاصفة الغزو على العالم الرقميّ

301
00:22:39,840 --> 00:22:43,750
الفتى الذي غادر العالم الواقعيّ أصبح قيصر الدّيجيمون الحقيقيّ

302
00:22:44,570 --> 00:22:47,170
قوّته الهائلة تتيح له إمكانيّة التحكُّم بغريمون

303
00:22:47,840 --> 00:22:49,360
...لكن تيقظ هذه القوّة

304
00:22:49,360 --> 00:22:52,730
!تطوّراً رقميّاً ظلامياً شرّيراً ما كان ينبغي أن يُثار

305
00:22:52,730 --> 00:22:55,110
!الحلقة القادمة من مغامرة الدّيجيمون 02

306
00:22:55,110 --> 00:22:57,770
"!فرط نشاط سحر حلقة الشرّ"

307
00:22:57,770 --> 00:23:00,220
!البوّابة المؤدّية إلى المغامرة مفتوحة الآن