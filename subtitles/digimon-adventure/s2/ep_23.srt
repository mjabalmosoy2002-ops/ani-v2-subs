1
00:01:31,940 --> 00:01:33,690
،بعدَ رحيلِ قيصر الدِّيجيمون

2
00:01:33,690 --> 00:01:37,180
استمتعَ دايسكي بالعالمِ الرّقميّ الحقيقيّ لأقصى حدّ

3
00:01:41,550 --> 00:01:46,260
لكن هيكاري وتاكيرو كانا يعلَمان
أنَّ هذه لم تكُن نهاية الأمر

4
00:01:47,680 --> 00:01:51,440
في هذه الأثناء، كانَ كين إتشيجوجي
في حالةِ نومٍ عميق

5
00:01:51,440 --> 00:01:55,560
كان عقلُه المُنهَك بحاجةٍ لراحةٍ طويلة

6
00:01:56,180 --> 00:01:59,220
،والِداه فرِحان بعودتِه

7
00:01:59,220 --> 00:02:02,020
لكن حزِنا من جديد بسببِ وضعه

8
00:02:05,690 --> 00:02:08,290
"عندما يتلوّثُ الجهازُ الرقميّ بواسطة الظَّلام"

9
00:02:10,010 --> 00:02:13,480
شقق تاماتشي تي إم

10
00:02:24,540 --> 00:02:26,350
كين... كيف حالُه؟

11
00:02:33,030 --> 00:02:36,520
لكن أنا متأكّدةٌ أنَّه سيستيقظ يوماً ما

12
00:02:51,030 --> 00:02:55,580
سأبقى نائماً كي أجِدَ قلبي

13
00:02:56,200 --> 00:02:58,980
إلى أين ذهبَ قلبي؟

14
00:02:59,940 --> 00:03:04,190
عندما كنتُ أصغر... كنتُ أنفخ فُقاعات

15
00:03:04,660 --> 00:03:06,920
...أكبر فأكبر

16
00:03:08,260 --> 00:03:10,510
لم أكُن عبقريّاً إطلاقاً

17
00:03:11,240 --> 00:03:13,230
كان العبقريُّ هو أخي الأكبر أوسامو

18
00:03:13,830 --> 00:03:17,250
...كان أوسامو يستطيع فعلُ كلَّ شيء. كلّ شيء حرفيّاً

19
00:03:17,680 --> 00:03:19,320
كنتُ دوماً ما أتفاخرُ به

20
00:03:20,740 --> 00:03:21,920
إنّها جارتُنا

21
00:03:21,920 --> 00:03:26,280
أوسامو-تشان صبيٌ ذكيّ

22
00:03:26,280 --> 00:03:28,110
كم أحسدُك

23
00:03:28,110 --> 00:03:29,910
إنَّه ليس مثل طفلنا أبداً

24
00:03:30,280 --> 00:03:33,400
،ليتَ طفلي يُصبِح مثله أكثر

25
00:03:33,400 --> 00:03:37,430
ماذا فعلتُما حتَّى أصبح صبياً ذكيّاً هكذا؟

26
00:03:37,430 --> 00:03:40,250
ورِثَ منكما كثيراً من الصِّفات الحميدة

27
00:03:40,250 --> 00:03:41,900
!يا له من عبقريّ

28
00:03:42,450 --> 00:03:45,320
سُحِرَتْ أمِّي بكلماتهم

29
00:03:47,150 --> 00:03:48,170
أمِّي؟

30
00:03:48,170 --> 00:03:52,050
...أوسامو-تشان، مدحَني النّاسُ من جديدٍ اليوم

31
00:03:52,050 --> 00:03:54,790
قائلين أنَّك فتى صالح

32
00:03:55,250 --> 00:03:58,150
كين-تشان، أنت فتى صالح أيضاً

33
00:03:58,150 --> 00:04:00,780
كانَتْ دائماً ما تذكُرني بشكلٍ عابِر

34
00:04:01,460 --> 00:04:06,040
لا تهتمِّين سوى بأوسامو لأنَّ الجميع يمدحونه

35
00:04:06,470 --> 00:04:08,100
وجودي هُنا من عدمِه لا يُشكِّل فرقاً

36
00:04:08,620 --> 00:04:12,190
لولا وجوده هنا، هل كنتُ لأحلّ مكانه؟

37
00:04:12,650 --> 00:04:15,560
...لولا وجوده. لولا

38
00:04:16,720 --> 00:04:20,250
!هكذا إذاً. كلّ ما عليه فِعله هو أن يختفي

39
00:04:21,880 --> 00:04:24,070
!اختفِ يا أخي الكبير

40
00:04:26,480 --> 00:04:29,660
ظهرَ الجِهازُ الرقميّ أمامنا

41
00:04:30,290 --> 00:04:33,750
لا بُدَّ أنّه ينتمي لأوسامو

42
00:04:33,750 --> 00:04:38,500
أقصِد أنَّه يستطيع فعل كلّ شيء. لديه كلّ شيء

43
00:04:44,270 --> 00:04:46,510
لكن لم يحدثْ شيء

44
00:04:47,850 --> 00:04:50,580
كان الجِهاز الرقميّ هُناك فحسب

45
00:04:51,890 --> 00:04:54,440
بدا أوسامو حزيناً حقّاً

46
00:05:04,340 --> 00:05:10,750
لا أعرِف ما هذا، لكن من الواضِح أنَّه مُميّز

47
00:05:11,180 --> 00:05:13,800
تحمّستُ لمُجرَّد رؤيته

48
00:05:39,490 --> 00:05:40,500
كين

49
00:05:42,910 --> 00:05:44,410
ماذا تفعل؟

50
00:05:45,470 --> 00:05:46,670
...هذا

51
00:05:46,670 --> 00:05:48,410
!ماذا تفعل؟

52
00:05:50,300 --> 00:05:52,300
!لا تلمس أغراضي بِلا إذني

53
00:05:52,500 --> 00:05:54,090
...أ... أنا آسف

54
00:05:54,900 --> 00:05:57,740
هذا لي

55
00:05:58,100 --> 00:05:59,380
أنا آسف

56
00:05:59,380 --> 00:06:01,980
...تبحثُ في مكتب شخصٍ دون أن تسأل

57
00:06:03,550 --> 00:06:05,740
وحدهم السيّئون من يفعَلون شيئاً كهذا

58
00:06:06,120 --> 00:06:06,870
...أنا

59
00:06:06,870 --> 00:06:11,180
هذا لي. لا تلمسْه أبداً دون إذني. مفهوم؟

60
00:06:12,170 --> 00:06:13,140
أنا آسف

61
00:06:13,740 --> 00:06:16,130
!أنتَ تُلهيني عن دِراستي. اخرج

62
00:06:22,200 --> 00:06:27,090
يكرهُني لأنّني لستُ فتى صالحاً

63
00:06:27,090 --> 00:06:28,960
لأنَّني أسوأ كائن بشريّ

64
00:06:29,510 --> 00:06:33,240
لكن لماذا؟ أنا حَزين

65
00:06:34,090 --> 00:06:38,770
لديه كلّ شيء. بينما أنا فلا

66
00:06:39,640 --> 00:06:41,090
...أتمنَّى لو أنَّه

67
00:06:41,990 --> 00:06:44,190
!يختفي فحسب

68
00:06:54,590 --> 00:06:56,010
أخي؟

69
00:06:57,600 --> 00:07:00,320
هل كانَ ذلك لأنَّني تمنّيتُ أن يختفي؟

70
00:07:05,660 --> 00:07:09,760
إلى أينَ ينبغي أن أذهب؟ إلى أين أنتمي؟

71
00:07:10,440 --> 00:07:15,750
ذاتَ يوم، بحثتُ في حاسوبِه ووجدتُ
رسالةً إلكترونيةً لي

72
00:07:16,000 --> 00:07:17,420
رسالة إلكترونية لي

73
00:07:17,750 --> 00:07:20,020
رِسالة كتبَها شخصٌ خصِّيصاً لي

74
00:07:20,350 --> 00:07:22,260
شخص... خصِّيصاً لي

75
00:07:22,850 --> 00:07:24,860
:هذا ما وردَ فيها

76
00:07:24,860 --> 00:07:28,300
كانَتْ وفاة أخيك حادِثة مُؤسِفة

77
00:07:28,300 --> 00:07:33,830
لا بدَّ أنَّها كانَتْ مأساويّة، لكن لا تقلق

78
00:07:34,190 --> 00:07:37,890
راحَ أخوك إلى مكانٍ أفضل

79
00:07:37,890 --> 00:07:40,230
ليسَ عليك الشُّعور بتأنيبِ الضَّمير إطلاقاً

80
00:07:40,730 --> 00:07:43,000
،لم أفهم المعنى تماماً

81
00:07:43,000 --> 00:07:46,250
لكن أردتُ تصديقَ كُلّ ما كُتِب

82
00:07:46,640 --> 00:07:49,450
جعلَني ذلك أشعر براحة

83
00:07:50,030 --> 00:07:55,180
رحل أخوك جسديّاً فقط، ويستريح في مكانٍ أفضل

84
00:07:55,180 --> 00:07:57,690
بِذلك، تحرَّرَ عقلُه للأبد

85
00:07:58,540 --> 00:08:03,700
لكن ما زالَ عليك أن تعيشَ تِلك
الحياة المُمِلّة العاديّة

86
00:08:04,510 --> 00:08:09,810
هذا يعني موت إرادتك الحُرّة. مِسكين أنت

87
00:08:10,170 --> 00:08:12,120
أشفقُ عليك

88
00:08:12,580 --> 00:08:17,570
النتيجةُ النّهائيةُ هي أنَّ عالمَك الحاليّ ليسَ لك

89
00:08:17,570 --> 00:08:22,210
لا يسعني سِوى أن أقولَ أنَّ هُناك عالم يلائمُك أكثر

90
00:08:23,170 --> 00:08:25,110
عالم يُلائمني أكثر؟

91
00:08:25,970 --> 00:08:29,800
عالم سيُحرِّر عقلك

92
00:08:31,680 --> 00:08:33,550
اِفتح الدّرج

93
00:08:34,200 --> 00:08:35,470
الدّرج؟

94
00:08:45,100 --> 00:08:46,490
...أوسامو

95
00:08:47,190 --> 00:08:49,670
استخدِم ذلك الجِهاز الرّقميّ

96
00:09:08,560 --> 00:09:09,740
أين أنا؟

97
00:09:25,640 --> 00:09:27,260
هذا هو

98
00:09:27,840 --> 00:09:29,920
هذا جِهازي الرّقميّ

99
00:09:29,920 --> 00:09:33,630
!لا جِهاز أحد آخر، لكن لي وحدي

100
00:09:57,040 --> 00:10:00,770
إنَّه يتأوَّه. هل يرى كابوساً؟

101
00:10:01,130 --> 00:10:02,310
عزيزي؟

102
00:10:02,950 --> 00:10:07,020
بعدَ فترةٍ طويلةٍ من رحيلِ أوسامو-تشان
وعندما صار كين-تشان

103
00:10:07,020 --> 00:10:11,390
،يُشبِه أخاه في لحظةِ وفاته

104
00:10:11,390 --> 00:10:15,430
بدأ يُبدِع فجأةً في المدرسة

105
00:10:15,430 --> 00:10:16,400
صحيح

106
00:10:16,970 --> 00:10:21,830
كُنَّا مُتشوِّقين، مُعتقدين أنَّ أوسامو-تشان
،قد عادَ إلينا

107
00:10:21,830 --> 00:10:24,920
لكن كانَ ينبغي أن نُفكِّر أكثر

108
00:10:24,920 --> 00:10:27,530
بمدى تأثيرِ ذلك على مشاعِر كين-تشان

109
00:10:28,580 --> 00:10:32,590
لدى كين كثيرٌ من الصِّفاتِ الحميدة التي تخصُّه وحده

110
00:10:32,590 --> 00:10:37,180
تكبَّرنا كثيراً بعد أن لقبَّنَا النّاسُ بوالدَي العبقريّ

111
00:10:37,180 --> 00:10:38,800
ليسَ كين-تشان فقط

112
00:10:38,800 --> 00:10:39,510
ماذا؟

113
00:10:39,780 --> 00:10:43,610
هل أحبَّ أوسامو-تشان الدِّراسة حقّاً؟

114
00:10:44,980 --> 00:10:48,440
،لا أظنُّه كان يكرهها، لكن كنتُ أقولُ لنفسي مُؤخّراً

115
00:10:48,440 --> 00:10:52,810
أنَّه أراد أن يلعب أكثر رُبَّما

116
00:10:52,810 --> 00:10:56,460
لعلَّنا حرمناه من الاستمتاع

117
00:10:56,880 --> 00:10:59,190
فشِلنا كأبوين

118
00:10:59,190 --> 00:11:00,150
معكَ حقّ

119
00:11:02,020 --> 00:11:04,430
كين، استيقِظ أرجوك

120
00:11:04,430 --> 00:11:07,610
كين، اِمنحْني فُرصة للاعتذارِ إليك

121
00:11:08,150 --> 00:11:10,810
إلى أين ذهبَ قلبي؟

122
00:11:11,630 --> 00:11:14,950
عندما كنتُ أصغر سنّاً... كنتُ أنفُخ فُقاعات

123
00:11:15,350 --> 00:11:17,980
...أكبر فأكبر

124
00:11:18,880 --> 00:11:21,670
كنتُ دائماً ما أنفُخ فُقاعات

125
00:11:22,020 --> 00:11:27,170
في شرفتِنا، صنعت ماءً صابونيّاً وقطعت طرف قشّة

126
00:11:28,110 --> 00:11:33,900
من أعدَّ مائي الصَّابونيّ؟ من قطّع طرف القشّة

127
00:11:33,900 --> 00:11:34,570
أمِّي؟

128
00:11:35,520 --> 00:11:38,550
لا، كانَ أخي الكبير

129
00:11:39,150 --> 00:11:43,540
لم أكُن لأستطيع نفخ فُقاعاتٍ لولا
إعداده لماءِ الصَّابون والقشّة

130
00:11:44,500 --> 00:11:46,360
كين، حاوِل النَّفخ

131
00:11:46,360 --> 00:11:47,430
!حسناً

132
00:11:54,220 --> 00:11:55,940
!اِفعلْها أنتَ أيضاً

133
00:11:55,940 --> 00:11:58,760
حسناً، لكن لستُ جيِّداً في ذلك

134
00:11:58,760 --> 00:12:01,180
هُناك شيء لا تستطيع فعله يا أخي؟

135
00:12:01,180 --> 00:12:06,950
بالتأكيد! أنتَ أفضل في نفخِ الفُقاعات لأنّك
تنفخ بشكلٍ رقيق

136
00:12:06,950 --> 00:12:09,230
أنا لستُ بارِعاً. دائماً ما تنفجِر الفُقاعة

137
00:12:13,970 --> 00:12:17,780
!أخي! أخي، عُد

138
00:12:17,770 --> 00:12:19,320
لن يعود

139
00:12:19,320 --> 00:12:22,390
هذا صحيح. فأخي أوسامو رحلَ للأبد

140
00:12:25,980 --> 00:12:26,700
!كين

141
00:12:26,700 --> 00:12:27,820
!استيقَظ

142
00:12:28,220 --> 00:12:28,800
من أنتُما؟

143
00:12:30,560 --> 00:12:31,220
من أنتُما؟

144
00:12:31,710 --> 00:12:33,530
لا تعرِف من نكون؟

145
00:12:33,530 --> 00:12:34,690
فقدَ ذاكِرتَه؟

146
00:12:35,150 --> 00:12:37,710
لا، لم أفقد ذاكِرتي

147
00:12:37,710 --> 00:12:43,000
ما قصدتُه هو من أنتما بالنسبة لي شخصياً؟

148
00:12:43,000 --> 00:12:45,550
لا أُصدِّق أنَّه لم يعُد يعرفنا

149
00:12:46,480 --> 00:12:49,230
أنتُما لا تعرِفان من أكونُ أيضاً

150
00:12:49,230 --> 00:12:51,000
من أنتُما؟

151
00:12:51,000 --> 00:12:52,900
ومن أنا؟

152
00:12:52,900 --> 00:12:54,690
من؟ من أنا؟

153
00:12:54,690 --> 00:12:57,540
لا عليك، لا تضغطْ على نفسِك يا كين-تشان

154
00:12:57,540 --> 00:12:59,880
نحن سَعيدان لأنَّك بأمانٍ على الأقلّ

155
00:12:59,880 --> 00:13:05,470
كين، لعلّنا أجبرناك على أن تكون
مثل أوسامو دون إدراكِ ذلك

156
00:13:06,630 --> 00:13:09,560
نحن آسِفان. أنتَ تبقى أنت

157
00:13:09,560 --> 00:13:11,660
،لديك العديد من الإيجابيّات

158
00:13:11,660 --> 00:13:13,060
لكن لم نلحَظْ أبداً

159
00:13:13,060 --> 00:13:16,380
سامحْنا أرجوك. وأرجو أن تتعافى قريباً

160
00:13:16,380 --> 00:13:20,010
ما الّذي يقوله هذان؟ لا أفهمهما

161
00:13:20,010 --> 00:13:21,670
لا أفهم ما الّذي تعنيه هذه الكلِمات

162
00:13:21,670 --> 00:13:24,140
رحلَ أوسامو، صحيح؟

163
00:13:24,140 --> 00:13:26,790
هذا صحيح. أخي الكبير أوسامو رحَل

164
00:13:26,790 --> 00:13:30,390
تُوفِّي. أوسامو-تشان قد رحَل

165
00:13:30,390 --> 00:13:33,760
!ونريدُك أن تكون على طبيعتِك

166
00:13:34,220 --> 00:13:35,890
هذه المرأة تَبكِي

167
00:13:35,890 --> 00:13:38,800
لِماذا؟ أنا الحَزين هُنا

168
00:13:39,690 --> 00:13:40,930
دموع؟

169
00:13:40,930 --> 00:13:44,020
دموعٌ في عَينَي أيضاً؟ لِماذا؟

170
00:13:44,020 --> 00:13:46,350
لِماذا أبكي؟

171
00:13:46,950 --> 00:13:49,500
قد أكونُ قادِراً على مُشاركةِ حزن خسارة

172
00:13:49,500 --> 00:13:53,200
أخي الكبير أوسامو مع هذين

173
00:13:54,510 --> 00:13:56,280
أنا فارِغ

174
00:13:56,660 --> 00:13:59,680
لا أعرِف أين اختفى قلبي

175
00:14:00,030 --> 00:14:01,860
كين-تشان، حانَ وقتُ العشاء

176
00:14:02,640 --> 00:14:03,660
كين-تشان؟

177
00:14:07,710 --> 00:14:09,830
لستَ مُضطرّاً لكتم الأمر

178
00:14:16,460 --> 00:14:20,620
أنت أكثر من تأثّرَ بوفاتِه

179
00:14:37,140 --> 00:14:38,250
وارمون

180
00:14:40,590 --> 00:14:42,900
كين-تشان، ما رأيك؟

181
00:14:45,070 --> 00:14:45,850
!كين-تشان؟

182
00:14:52,160 --> 00:14:53,930
أينَ قلبي؟

183
00:14:54,620 --> 00:14:57,070
أريدُ إيجاد قَلبي

184
00:14:57,700 --> 00:14:59,710
أريدُ البحثَ عن قَلبي

185
00:15:05,390 --> 00:15:06,350
أينَ أنا؟

186
00:15:06,350 --> 00:15:07,940
هذه قرية بريماري

187
00:15:07,940 --> 00:15:11,910
هُنا حيثُ تُصبِح الدِّيجيمونات الميّتة
بيوضاً رقميّة وتتجدّد

188
00:15:11,910 --> 00:15:14,230
!تتجدّد؟ حتَّى وارمون؟

189
00:15:14,230 --> 00:15:17,190
تُصبِح كلّ الدِّيجيمونات بيوضاً رقميّة وتتجدّد

190
00:15:25,170 --> 00:15:28,090
لا أعرِف أيُّهم هو وارمون

191
00:15:29,270 --> 00:15:31,570
مثلما لا أعرِف من أكون

192
00:15:31,570 --> 00:15:34,660
لا أعرِف أيّ البيوض الرقميّة هي لوارمون

193
00:15:34,660 --> 00:15:37,120
!أنتَ قيصر الدِّيجيمون

194
00:15:38,140 --> 00:15:40,570
ماذا ستفعلُ ببيضةِ وارمون الرّقميّة؟

195
00:15:41,900 --> 00:15:43,330
قيصر الدِّيجيمون؟

196
00:15:43,860 --> 00:15:48,580
أجل، أنا قيصر الدِّيجيمون. قمتُ بأفعالٍ شنيعة

197
00:15:48,930 --> 00:15:51,180
قتلتُ وارمون

198
00:15:51,180 --> 00:15:55,180
لكن ما الّذي أُحاولُ إنجازه بالبحثِ
عن بيضتِه الرّقميّة؟

199
00:15:55,420 --> 00:15:58,440
إذا استطعتَ إيجاد بيضته الرّقميّة، سيعودُ وارمون

200
00:15:58,440 --> 00:16:01,200
حينئذٍ ستتحرَّر من نفسك، النّفس الّتي قتلَتْ وارمون

201
00:16:01,200 --> 00:16:04,650
ستتحرَّر من ذنبِ قتله. أليسَ كذلك؟

202
00:16:04,650 --> 00:16:06,530
أنتَ شخصٌ شرِّير

203
00:16:06,530 --> 00:16:10,260
!لن يتجدَّدَ وارمون لأجلِ شخصٍ فظيعٍ مثلك

204
00:16:10,260 --> 00:16:12,390
لن يعود وارمون؟

205
00:16:12,390 --> 00:16:15,460
معكَ حقّ. لم يعُد أوسامو أيضاً

206
00:16:15,890 --> 00:16:18,140
كانَتْ تِلك حقيقة لم أرد تقبّلها

207
00:16:18,140 --> 00:16:19,980
ماتَ أخي أوسامو

208
00:16:19,980 --> 00:16:23,170
ماتَ وارمون أيضاً. قتلتُهما معاً

209
00:16:23,170 --> 00:16:25,470
أخي الّذي كان أكثر شخصٍ أكرهه

210
00:16:25,470 --> 00:16:28,720
ووارمون الّذي ظننتُه عديم القيمة

211
00:16:29,490 --> 00:16:31,600
أنا عديمُ القيمةِ هُنا

212
00:16:32,210 --> 00:16:35,450
أنا عديمُ القيمة. أنا تافِه

213
00:16:35,450 --> 00:16:39,200
لكن دمَّرَني موتُ وارمون

214
00:16:39,200 --> 00:16:40,830
ماذا عندما أموت؟

215
00:16:41,260 --> 00:16:43,780
سيحزنُ وارمون عليّ بكُلِّ تأكيد

216
00:16:43,780 --> 00:16:46,170
قد يكونُ وارمون الشّخص الوحيد الّذي يحزنُ عليّ

217
00:16:46,170 --> 00:16:47,600
...لكن أنا

218
00:16:47,980 --> 00:16:53,570
خسِرتُ وارمون بسببِ أساليبي المُدمِّرة

219
00:17:04,130 --> 00:17:07,770
ما فعلتَه كان لا يُغتفَر

220
00:17:07,770 --> 00:17:11,080
لا يُمكِنُك التّراجُع عمَّا فعلتَه

221
00:17:11,080 --> 00:17:13,600
لا يُمكِنُك مسح الماضي

222
00:17:13,600 --> 00:17:18,050
كلّ شيء. الخير والشرّ. كلّ شيء هو من صنيعك

223
00:17:18,710 --> 00:17:22,120
يجبُ أن أقبلَ كلّ شيء في داخلي وأعيش

224
00:17:22,520 --> 00:17:24,760
حقيقة أنَّني كنتُ قيصر الدِّيجيمون

225
00:17:24,760 --> 00:17:26,440
حقيقة وفاة أخي

226
00:17:26,440 --> 00:17:28,040
حقيقة أنَّني تركتُ وارمون يموت

227
00:17:28,620 --> 00:17:32,190
...لا مُشكِلة. سأتمكَّن من فعلِها لأنَّ وارمون

228
00:17:32,190 --> 00:17:35,990
ذِكريات تواجدي معك ستُقوِّيني

229
00:17:36,320 --> 00:17:39,980
!أجل! وارمون، لطالما كُنتَ معي

230
00:17:40,250 --> 00:17:42,770
،باستخدامِ جِهاز أخي الرَّقميّ

231
00:17:42,770 --> 00:17:45,590
...استكشفتُ العالمَ الرَّقميّ معك

232
00:17:46,050 --> 00:17:47,790
ذاكِرتي المَنسيّة

233
00:17:47,790 --> 00:17:51,730
لا، الذّاكرة التي أقفلتُ عليها. لكن لِماذا؟

234
00:17:51,730 --> 00:17:54,990
لمَ كان عليّ أن أنسى هذا؟

235
00:17:58,710 --> 00:18:00,330
!كين-تشان، اِحذر

236
00:18:01,490 --> 00:18:02,810
!وارمون

237
00:18:03,460 --> 00:18:05,620
!وارمون! وارمون

238
00:18:05,620 --> 00:18:09,290
لا تقلق. كانَ ذلك بسيطاً

239
00:18:09,290 --> 00:18:10,170
!وارمون

240
00:18:10,170 --> 00:18:14,200
أنا مسرورٌ جدّاً لأنّني شريكُك الدِّيجيمون

241
00:18:14,460 --> 00:18:16,920
لأنَّك رقيق لِلغاية يا كين-تشان

242
00:18:17,690 --> 00:18:18,860
رقيق؟

243
00:18:19,340 --> 00:18:24,570
أنتَ الأفضل في نفخِ الفُقاعات لأنَّك تنفخُ برِقّة

244
00:18:24,570 --> 00:18:27,040
لكن الرقّة لا تكفي

245
00:18:27,040 --> 00:18:29,990
...عليكَ أن تُصبِح أقوى وإلَّا

246
00:18:29,990 --> 00:18:31,260
وإلّا ماذا؟

247
00:18:31,260 --> 00:18:35,050
ستُسيطرُ عليك رِقّتك

248
00:18:35,380 --> 00:18:36,430
كين-تشان

249
00:18:37,030 --> 00:18:40,560
هذا الجِهاز الرّقميّ لك يا كين-تشان

250
00:18:40,560 --> 00:18:43,500
لا لأحدٍ آخر، لكن لك وحدك

251
00:18:44,080 --> 00:18:49,550
...مثلما قلبُك لك. لا تنسَ ذلك. وأيضاً

252
00:18:49,550 --> 00:18:50,210
وأيضاً؟

253
00:18:50,210 --> 00:18:51,660
لا تهرُب

254
00:18:53,310 --> 00:18:55,780
كنتُ أكذِبُ عندما قلتُ لنفسي
أنّني لم أملك شيئاً

255
00:18:56,280 --> 00:18:58,220
كانَ ذلك أسهل بالنسبةِ لي

256
00:18:58,790 --> 00:19:01,100
كانَ أسهل أن أكرهَ أخي الكبير

257
00:19:02,140 --> 00:19:04,320
أنا آسفٌ يا أوسامو

258
00:19:04,520 --> 00:19:06,590
أنا آسفٌ يا وارمون

259
00:19:06,590 --> 00:19:11,380
سأعيشُ مُتقبِّلاً كلَّ الأشياء الّتي
لا تُغتفَر الّتي فعلتُها

260
00:19:15,490 --> 00:19:16,460
ما هذا؟

261
00:19:16,460 --> 00:19:18,130
هذه شارتُك

262
00:19:18,130 --> 00:19:19,910
شارتي؟

263
00:19:20,850 --> 00:19:24,530
كين-تشان، جِدْني. بسرعة، جِدني

264
00:19:27,010 --> 00:19:28,470
!بسرعة! بسرعة

265
00:19:28,820 --> 00:19:30,860
هذه البيضة الرّقميّة؟

266
00:19:31,870 --> 00:19:33,860
لماذا تتوهّجُ كثيراً؟

267
00:19:39,440 --> 00:19:40,750
وار... مون؟

268
00:19:42,850 --> 00:19:43,950
كين-تشان

269
00:19:45,650 --> 00:19:47,870
بحثتَ عن بيضتي؟

270
00:19:48,810 --> 00:19:49,520
أجل

271
00:19:50,150 --> 00:19:52,430
بحثتُ عنها باجتهاد

272
00:19:52,430 --> 00:19:57,020
هذا جيّد. عرفتُ أنَّك ستتمكّنُ من إيجادي

273
00:19:57,020 --> 00:19:58,010
وارمون؟

274
00:19:58,320 --> 00:19:59,470
ما الأمر يا كين-تشان؟

275
00:20:00,680 --> 00:20:02,960
شكراً لك لأنَّك وُلِدت

276
00:20:08,380 --> 00:20:10,970
أنا سعيدٌ جدَّاً بحياةِ وارمون

277
00:20:11,410 --> 00:20:15,150
هل وارمون الوحيد المسرور بشأنِ حياتي؟

278
00:20:15,500 --> 00:20:17,410
أنا متأكّدٌ أنَّ ذلك غير صحيح

279
00:20:17,770 --> 00:20:20,590
!قد لا يعودُ أبداً هذه المرّة

280
00:20:20,590 --> 00:20:23,300
!لا تقولي ذلك! سيعودُ بالتأكيد

281
00:20:25,010 --> 00:20:26,080
!كين-تشان؟

282
00:20:26,080 --> 00:20:26,880
أين كنت؟

283
00:20:26,880 --> 00:20:29,370
اعتقدناك اختفيت ثانية

284
00:20:30,620 --> 00:20:35,590
إنَّها تبكي. أمِّي تبكي لأنَّني اختفيت

285
00:20:36,070 --> 00:20:36,990
!أمِّي

286
00:20:37,850 --> 00:20:39,210
ماذا قلتَ للتو؟

287
00:20:39,210 --> 00:20:42,960
ماذا قلت؟ أمِّي؟ هل ناديتَني "أمِّي" للتو؟

288
00:20:43,710 --> 00:20:47,080
أمِّي! شكراً لكِ على إنجابك لي

289
00:20:51,980 --> 00:20:54,860
آسف لأنَّني أقلقتُك يا أبي

290
00:20:57,530 --> 00:21:00,970
أوسامو، يُمكنني قول هذا للمرّةِ الأولى

291
00:21:01,400 --> 00:21:04,000
شكراً لك على كلِّ شيء

292
00:22:37,490 --> 00:22:40,360
يُبدِي إيوري غضبَه على الضّررِ الّذي سبّبَه القيصر

293
00:22:41,000 --> 00:22:43,750
ينشأ ظلامٌ جديدٌ في العالمِ الرَّقميّ

294
00:22:43,750 --> 00:22:45,720
هجومُ ثانديربالمون

295
00:22:45,720 --> 00:22:47,470
...تختفي أبراج الظلّام فجأة

296
00:22:47,470 --> 00:22:50,410
ويظهر ديجيمون أخضر غامِض

297
00:22:50,410 --> 00:22:53,440
ما الّذي سيفعلُه إيوري بشأنِ
هذه الحوادِث غير المُتوقَّعة؟

298
00:22:53,720 --> 00:22:56,070
!الحلقة القادمة من مغامرة الدّيجيمون 02

299
00:22:56,070 --> 00:22:58,050
"أنكيلومون، مُحارِب الأرض"

300
00:22:58,710 --> 00:23:01,140
!البوّابة المؤدّية إلى المغامرة مفتوحة الآن