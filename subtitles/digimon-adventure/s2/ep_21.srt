1
00:01:31,480 --> 00:01:34,690
،لإيقافِ غزو القلعة المُتنقِّلة

2
00:01:34,690 --> 00:01:36,370
،بمُساعدةِ أغومون والآخرين

3
00:01:36,370 --> 00:01:38,450
شنّ دايسكي والأصدقاء من جديد هجوماً

4
00:01:40,340 --> 00:01:45,330
لكن هُزِموا بواسطةِ القوّة القاهِرة لكيميرامون

5
00:01:47,160 --> 00:01:51,970
غير أنَّ دايسكي المُثابِر اكتشفَ بيضةً رقميّةً ذهبيّة

6
00:01:52,280 --> 00:01:54,960
تطوَّرَ فيمون إلى ماغنامون

7
00:01:55,720 --> 00:01:58,770
!كانَتْ مُعجِزة تطوُّر بكُل معنى الكلِمة

8
00:02:06,030 --> 00:02:08,240
"...وداعاً يا كين-تشان"

9
00:02:11,100 --> 00:02:13,300
!تطوَّري أيّتُها البيضة الرقميّة

10
00:02:14,300 --> 00:02:17,240
...فيمون، تطوَّر درعيّاً

11
00:02:20,330 --> 00:02:23,210
!التألُّق الإعجازيّ: ماغنامون

12
00:02:23,590 --> 00:02:25,160
!تـ-تطوُّر

13
00:02:30,280 --> 00:02:32,110
مـ-ماغنامون؟

14
00:02:33,100 --> 00:02:41,070
ماغنامون

15
00:02:33,100 --> 00:02:41,070
درع
ديجيمون فارِس مُقدَّس

16
00:02:33,610 --> 00:02:34,510
!ماغنامون

17
00:02:34,510 --> 00:02:37,500
فيمون مُصفَّح مُتطوِّر باستخدامِ البيضة الرقميِّة الإعجازية

18
00:02:37,500 --> 00:02:41,070
!تقنيّتُه الخاصَّة هي لمعان من درعِه، الحملة المُتشدِّدة

19
00:02:48,780 --> 00:02:50,160
...هـ-هذه القوّة

20
00:02:50,160 --> 00:02:52,050
!قوّتي تعود

21
00:02:52,050 --> 00:02:54,040
...بورومون تطوّر

22
00:02:54,040 --> 00:02:56,220
...أوبامون تطوَّر

23
00:02:56,490 --> 00:02:57,330
!هوكمون

24
00:02:57,330 --> 00:02:58,740
!أرماجيمون

25
00:03:01,680 --> 00:03:04,610
!ما هذا؟ لم أرَ ديجيموناً بهذا الشَّكل من قبل

26
00:03:04,610 --> 00:03:06,700
تطوُّر درعيّ جديد؟

27
00:03:06,700 --> 00:03:10,030
غير مُمكِن، لأنَّ ليس هُناك المزيد من الشَّارات

28
00:03:10,030 --> 00:03:13,270
لا بدَّ أنَّه نوع خاص من التطوُّر

29
00:03:26,810 --> 00:03:30,590
كم مرّةً سوف تعترِضون طريقي؟

30
00:03:31,090 --> 00:03:35,300
!قيصر الدِّيجيمون! حان الوقتُ لإنهاءِ هذا

31
00:03:40,530 --> 00:03:42,160
...قوّةُ الظَّلام

32
00:03:43,490 --> 00:03:44,500
!عادَتْ

33
00:03:50,830 --> 00:03:52,080
كيميرامون

34
00:03:57,430 --> 00:03:58,350
!دايسكي

35
00:04:04,640 --> 00:04:07,060
دايسكي، دعْ هذا الأمر لي

36
00:04:07,060 --> 00:04:08,100
حسناً، فهِمت

37
00:04:08,810 --> 00:04:10,560
...كلُّ هذا

38
00:04:10,840 --> 00:04:12,650
!سينتهي اليوم

39
00:04:13,270 --> 00:04:14,860
!يجب أن نذهبَ أيضاً

40
00:04:23,590 --> 00:04:26,980
!المكانُ خطيرٌ هنا. يجب علينا الهرَب

41
00:04:27,380 --> 00:04:30,450
!اصمُت! عادَ كيميرامون

42
00:04:31,010 --> 00:04:34,860
لن يصغي إلى ما ستقولُه يا كين-تشان

43
00:04:34,860 --> 00:04:35,890
!اِخرس

44
00:04:39,710 --> 00:04:40,850
...كيميرامون

45
00:04:45,350 --> 00:04:47,330
!لكمةُ ماغنوم

46
00:04:51,690 --> 00:04:52,740
!رِفاق

47
00:04:53,370 --> 00:04:54,200
!دايسكي-كن

48
00:04:56,500 --> 00:04:58,070
!ركلةُ ماغنوم

49
00:05:05,680 --> 00:05:07,090
الوقتُ يُداهِمُنا

50
00:05:07,430 --> 00:05:10,120
هذه القلعةُ تنهار

51
00:05:10,120 --> 00:05:13,050
!لنُسرِع قبلَ أن يهرب القيصر

52
00:05:13,490 --> 00:05:14,960
!حسناً! هيَّا بنا

53
00:05:26,810 --> 00:05:29,270
إلى أين تُصوِّب يا كيميرامون؟

54
00:05:49,200 --> 00:05:51,470
هل ترى الآن يا كين-تشان؟

55
00:05:52,170 --> 00:05:53,300
!دعْني

56
00:05:53,660 --> 00:05:56,080
كُنَّا مُخطئين

57
00:05:56,490 --> 00:05:58,430
مُخطئين؟ يا للحماقة

58
00:05:58,430 --> 00:06:02,870
!مُحال أن أخطئ. أنا مِثاليٌّ دوماً

59
00:06:02,870 --> 00:06:06,390
هذه المرّة مُختلِفة يا كين-تشان

60
00:06:06,900 --> 00:06:08,450
!اِخرس

61
00:06:09,570 --> 00:06:13,110
!هذه لُعبة، وسوف أربح في النِّهاية

62
00:06:13,800 --> 00:06:15,590
أما زلتَ تتكلّمُ هكذا؟

63
00:06:20,700 --> 00:06:25,160
كيميرامون الذي صنعتُه لن يخسرَ أمامكم أبداً

64
00:06:25,740 --> 00:06:29,620
!الوقتُ ليس مُناسِباً للحديثِ عن فوز أو خسارة لُعبة

65
00:06:29,930 --> 00:06:32,170
!أتظنُّ نفسك قادِراً على صِناعة ديجيمون؟

66
00:06:32,170 --> 00:06:33,610
هل تعتقِد حقَّاً أنَّ بمقدورِك الإفلات بفِعلتك؟

67
00:06:34,200 --> 00:06:38,570
...أخذ كلّ بيانات الدِّيجيمون واعتِبارها مِلكك

68
00:06:39,340 --> 00:06:42,700
!هذه حماقة! الدِّيجيمون ليسوا دُمية

69
00:06:43,650 --> 00:06:45,640
!انظُر إلى هذه الدِّيجيمونات

70
00:06:47,040 --> 00:06:50,750
!للديجيمونات أرواح أيضاً! إنَّها حيّة

71
00:06:51,170 --> 00:06:54,770
!إنَّهم شُركاؤنا المُهِمُّون الّذين لا بديل لهم

72
00:06:56,060 --> 00:07:00,630
أنت طفلٌ مُختارٌ ولا تعلمُ ذلك حتَّى؟

73
00:07:00,630 --> 00:07:03,470
هذا الدِّيجيمون شريكُك، صحيح؟

74
00:07:06,160 --> 00:07:07,430
...كين-تشان

75
00:07:08,690 --> 00:07:10,870
...شَريكي المُناسِب هو

76
00:07:13,200 --> 00:07:15,840
!كيميرامون

77
00:07:35,080 --> 00:07:39,990
!انتهى أمرُ هذه القلعة. ابقوا هُنا إذا أردتُم الموت

78
00:07:40,900 --> 00:07:43,010
!انتظِر، قيصر الدِّيجيمون

79
00:07:43,500 --> 00:07:45,370
!كين إتشيجوجي

80
00:07:50,610 --> 00:07:52,990
!مياكو-سان، لنهرُب

81
00:07:53,250 --> 00:07:56,110
حسناً، لكن ألم تتعب؟

82
00:07:56,110 --> 00:07:58,590
أنا بخير. يمكنُكم الاعتِماد عليّ

83
00:07:58,590 --> 00:07:59,960
هل الجميع بخير؟

84
00:08:00,220 --> 00:08:00,970
أجل

85
00:08:00,970 --> 00:08:01,940
!أنا كذلك

86
00:08:02,280 --> 00:08:04,210
!حسناً، لنفعلها

87
00:08:08,290 --> 00:08:10,780
!ترقِّي أيّتُها البيضة الرقميِّة

88
00:08:14,050 --> 00:08:18,940
...أرماجيمون، تطوَّر درعيّاً

89
00:08:28,890 --> 00:08:32,630
!مِثقاب المعرِفة الفولاذيّ: ديغمون

90
00:08:35,250 --> 00:08:38,550
...هوكمون، تطوَّر درعيّاً

91
00:08:46,890 --> 00:08:50,060
!خفقة جناح الحبّ: هولسمون

92
00:08:52,390 --> 00:08:55,580
...تيلمون، تطوَّر درعيّاً

93
00:09:04,040 --> 00:09:07,250
!النّور الباسِم: نيفيرتيمون

94
00:09:10,370 --> 00:09:13,960
...باتامون، تطوَّر درعيّاً

95
00:09:22,160 --> 00:09:25,040
!الأمل الصَّاعِد: بيغاسمون

96
00:09:26,920 --> 00:09:28,980
!اندِفاعةُ الذّهب

97
00:09:37,200 --> 00:09:39,000
!طلقةُ البلازما

98
00:09:46,130 --> 00:09:48,260
!اندِفاعةُ الذّهب

99
00:09:58,970 --> 00:10:00,440
...كين إتشيجوجي

100
00:10:12,350 --> 00:10:15,320
!الحملة المُتشدِّدة

101
00:10:23,930 --> 00:10:28,140
لا جدوى... لا أملك قُوّة متبقية

102
00:10:29,740 --> 00:10:30,940
!تبّاً

103
00:10:36,690 --> 00:10:39,690
!جيِّد! اِسحقْه يا كيميرامون

104
00:10:39,690 --> 00:10:41,430
...لا تستسلِم يا ماغنامون

105
00:10:41,430 --> 00:10:42,430
ماذا؟

106
00:10:44,420 --> 00:10:47,140
كين-تشان، أما زلتَ لم تفهم؟

107
00:10:49,370 --> 00:10:52,580
لم تكُن هكذا من قبل

108
00:10:53,470 --> 00:10:58,570
في أوِّل زيارةٍ لنا للعالمِ الرقميِّ، لم تكُن هكذا

109
00:10:59,460 --> 00:11:02,730
...ضحِكنا معاً... بكَينا معاً

110
00:11:03,590 --> 00:11:06,510
!كين-تشان عاديٌّ لطيف

111
00:11:14,410 --> 00:11:15,520
...ثُمّ

112
00:11:15,520 --> 00:11:19,250
عندما التقينا في المرَّةِ التّالية، أخبرتَني
أن أُناديك بقيصر الدِّيجيمون

113
00:11:19,250 --> 00:11:20,800
!لا أستطيع فِعلها فحسب

114
00:11:20,800 --> 00:11:25,590
لأنَّك تبقى كين-تشان كيفما بدَوت

115
00:11:25,590 --> 00:11:30,480
بصفتِك قيصر الدِّيجيمون، مهما فعلتَ
...من أفعال سيِّئة

116
00:11:30,480 --> 00:11:33,600
آمنتُ أنَّك ستعودُ إلى كين-تشان القديم

117
00:11:34,760 --> 00:11:37,320
!آمنتُ بِذلك منذ البِداية ولِهذا بقيتُ معك

118
00:11:39,540 --> 00:11:41,310
ما-ما هذا؟

119
00:11:42,050 --> 00:11:45,890
لطالما آمنتُ بك

120
00:11:45,890 --> 00:11:49,130
كين-تشان الحقيقيّ ليس قيصر الدِّيجيمون

121
00:11:49,550 --> 00:11:51,460
...كين-تشان الحقيقيّ هو

122
00:11:56,800 --> 00:11:59,500
!كين-تشان رقيق

123
00:12:13,200 --> 00:12:14,670
...وارمون، أنت

124
00:12:14,970 --> 00:12:17,150
أنقِذ كين-تشان

125
00:12:19,690 --> 00:12:20,760
!وارمون

126
00:12:20,760 --> 00:12:23,030
أرجوك يا ماغنامون

127
00:12:23,030 --> 00:12:25,430
!أنقِذ كين-تشان

128
00:12:27,770 --> 00:12:31,750
!تتدفّقُ قوّة وارمون في كلِّ أنحاء جسدي

129
00:12:37,330 --> 00:12:40,310
!الحملة المُتشدِّدة

130
00:12:51,120 --> 00:12:52,680
!مرحى

131
00:12:54,580 --> 00:12:56,520
...كيميرامون الخاص بي

132
00:12:58,030 --> 00:12:59,250
...قد خَسِر

133
00:13:01,140 --> 00:13:01,960
هل أنت بخير؟

134
00:13:05,540 --> 00:13:07,000
!تشيبيمون

135
00:13:32,480 --> 00:13:35,380
...خسِرت

136
00:13:36,740 --> 00:13:40,320
!لِماذا؟ كان كلُّ شيء مِثاليّاً

137
00:13:41,300 --> 00:13:46,890
!هذه... هذه مُصيبة! هذه أسوأ نهاية على الإطلاق

138
00:13:47,720 --> 00:13:50,610
!سأضطرُّ لبدءِ كلّ شيء من الصِّفر

139
00:13:50,610 --> 00:13:54,450
سأعيدُ ضبط العالم الرقميّ

140
00:13:54,870 --> 00:13:57,930
تُعيد ضبط العالم الرقميّ؟

141
00:13:57,930 --> 00:14:02,760
لِذا... لِذا سأذهبُ للمنزلِ وأمسحُ كلَّ
...البيانات من حاسوبي

142
00:14:02,760 --> 00:14:05,880
وأبدأ كلَّ شيء من الصِّفر

143
00:14:06,430 --> 00:14:08,430
عمَّاذا تتحدّث؟

144
00:14:08,990 --> 00:14:14,390
هل أنتَ جادّ؟ تمسح البيانات وتُعيد
ضبطَ العالمِ الرَّقميّ؟

145
00:14:15,020 --> 00:14:19,360
أنتَ مجنون! ماذا تظنُّ العالمَ الرَّقمي؟

146
00:14:19,620 --> 00:14:20,490
ماذا...؟

147
00:14:21,270 --> 00:14:27,290
هذه ليسَتْ لُعبة. لا يُمكِنُك إعادة ضبط العالم الرَّقميّ

148
00:14:27,600 --> 00:14:28,310
ماذا؟

149
00:14:37,260 --> 00:14:41,990
كنتُم جميعاً في ملعبِ كُرة القدم في ذلك اليوم؟

150
00:14:41,990 --> 00:14:45,660
لسنا مُجرَّد بيانات حاسوب

151
00:14:46,050 --> 00:14:48,250
هُم مِثلنا تماماً

152
00:14:48,250 --> 00:14:50,470
!جميعُهم كائنات حيّة

153
00:14:51,140 --> 00:14:53,720
...الدِّيجيمونات... كائنات حيَّة

154
00:14:57,550 --> 00:15:00,890
...إذاً، ما كنتُ أفعلُه

155
00:15:10,970 --> 00:15:14,410
...ما كنتُ أفعلُه

156
00:15:15,180 --> 00:15:18,880
العالمُ الرَّقميّ ليس وهماً أو حلماً

157
00:15:18,880 --> 00:15:22,910
إنَّه مثلُ عالمنا الحقيقيّ، مُجرَّد حقيقة مُختلِفة فقط

158
00:15:40,620 --> 00:15:41,890
!وارمون

159
00:15:43,800 --> 00:15:45,080
وارمون؟

160
00:15:47,980 --> 00:15:49,430
ما زالَ يتنفَّس

161
00:15:54,570 --> 00:15:57,920
...عُدتَ إلى كين-تشان القديم

162
00:15:58,690 --> 00:15:59,840
القديم؟

163
00:16:00,420 --> 00:16:02,440
هذا يُلائمُك أكثر

164
00:16:02,910 --> 00:16:04,660
كين القديم؟

165
00:16:10,600 --> 00:16:15,350
في غرفةِ التَّغذية الكهرُبائيّة، سمعتُ
صوتاً من تِلك الشَّارة

166
00:16:15,970 --> 00:16:19,360
قال أنَّه أراد العودة إلى مالكِه الحقيقيّ

167
00:16:19,670 --> 00:16:21,680
مالكه الحقيقيّ؟

168
00:16:25,110 --> 00:16:27,010
...هذه لكين-تشان

169
00:16:28,210 --> 00:16:30,260
شارةُ الحنان

170
00:16:30,810 --> 00:16:33,750
إنّها شارتي... شارةُ الحنان؟

171
00:16:33,750 --> 00:16:36,870
"الحنانُ سيطلِقُ عنان نور ذهبيّ"

172
00:16:36,870 --> 00:16:40,100
هذا ما كان ويزارمون يتحدّثُ عنه إذاً

173
00:16:40,630 --> 00:16:43,390
لأنَّ كين-تشان حنون

174
00:16:47,030 --> 00:16:48,200
...وارمون

175
00:16:49,800 --> 00:16:53,660
هل كنتَ نحيلاً هكذا من قبل؟

176
00:16:54,410 --> 00:16:58,400
...وداعاً... كين... تشان

177
00:17:03,110 --> 00:17:04,100
وارمون...؟

178
00:17:04,670 --> 00:17:06,130
...مات

179
00:17:07,170 --> 00:17:08,710
مات؟

180
00:17:14,480 --> 00:17:15,920
!مات

181
00:17:19,400 --> 00:17:21,870
!أوسامو-تشان! أوسامو-تشان

182
00:17:21,870 --> 00:17:23,910
!أوسامو-تشان

183
00:17:28,050 --> 00:17:29,820
...لم يُفترَض أن يحدث هذا

184
00:17:30,630 --> 00:17:34,610
لم آتِ إلى هنا للشعورِ هكذا من جديد

185
00:17:43,880 --> 00:17:45,910
عُد إلى المنزِل

186
00:17:52,940 --> 00:17:55,630
هناك أشخاصٌ قلِقون ينتظرون عودتَك للمنزِل

187
00:18:00,420 --> 00:18:02,050
!اِذهب إلى المنزِل

188
00:18:12,530 --> 00:18:14,330
!ياماتو-كن

189
00:18:14,860 --> 00:18:18,450
!يا للهول! لا أُصدِّق أنَّها لحِقَتْ بي

190
00:18:18,450 --> 00:18:22,480
!كم أنتَ لئيم! ياماتو-كن، لقد تركتَني

191
00:18:23,000 --> 00:18:26,450
...كان ذلك... في الواقِع

192
00:18:26,450 --> 00:18:27,390
ماذا؟

193
00:18:27,390 --> 00:18:29,420
أين دايسكي والآخرون؟

194
00:18:30,360 --> 00:18:34,150
!تايتشي! أين الجميع؟

195
00:18:34,150 --> 00:18:38,900
الجميع؟ كوشيرو! أين كانوا ذكِّرني؟

196
00:18:38,900 --> 00:18:40,940
...ماذا

197
00:18:41,520 --> 00:18:44,380
...سـ-سأذهب لأبحث عنهم

198
00:18:50,590 --> 00:18:52,680
حسناً، ماذا يجب أن أفعل؟

199
00:18:55,000 --> 00:18:56,720
!فُتِحَت البوَّابة

200
00:19:02,450 --> 00:19:04,220
لستُم معاً؟

201
00:19:04,220 --> 00:19:06,460
بلى، نحن كذلك

202
00:19:06,460 --> 00:19:09,500
غالباً يلعبون هُناك في تِلك الغابة

203
00:19:09,500 --> 00:19:11,140
صحيح، صحيح، هُناك

204
00:19:13,600 --> 00:19:15,180
!انظري

205
00:19:15,180 --> 00:19:16,070
أخبرتُكِ بذلك

206
00:19:16,350 --> 00:19:18,530
لماذا أختي الكُبرى هنا؟

207
00:19:18,530 --> 00:19:19,920
!مرحباً

208
00:19:21,500 --> 00:19:23,730
!انتظِروا

209
00:19:26,690 --> 00:19:28,140
ما المُشكِلة؟

210
00:19:28,140 --> 00:19:30,800
بعد أن أتيتُ إلى هُنا أخيراً، ستُغادرون من الآن؟

211
00:19:31,210 --> 00:19:33,820
نحن مُرهَقون

212
00:19:33,820 --> 00:19:36,300
!أتيتِ بِلا دعوة، لِذا كُفِّي عن التذمُّر

213
00:19:36,300 --> 00:19:37,920
...أنا نعسان

214
00:19:38,310 --> 00:19:39,890
!مُستحيل

215
00:19:40,200 --> 00:19:43,350
هذا سيّئ. لن نتّسِع جميعنا

216
00:19:43,570 --> 00:19:47,420
ماذا؟ ألم تقولوا أنَّ هُناك سيَّارة أخرى؟

217
00:19:47,420 --> 00:19:50,790
أجل، غادرَت البارِحة

218
00:19:50,790 --> 00:19:52,850
ياماتو، استقلّ الحافِلة

219
00:19:52,850 --> 00:19:54,800
ماذا؟ هل أنتَ جادّ؟

220
00:19:55,340 --> 00:19:56,770
...خُذْ هذه

221
00:19:57,040 --> 00:19:58,650
آسف يا ياماتو

222
00:19:58,650 --> 00:20:00,440
حسناً، بالتوفيق

223
00:20:00,940 --> 00:20:02,720
!انتظِروا لحظة

224
00:20:02,970 --> 00:20:05,830
إذاً سأذهبُ للمنزلِ رِفقةَ ياماتو-كن

225
00:20:05,830 --> 00:20:07,680
!ماذا؟

226
00:20:08,960 --> 00:20:11,420
!دعوا ياماتو-كن لي

227
00:20:11,860 --> 00:20:14,590
!أرجوكم دعوني أركبُ معكم

228
00:20:13,780 --> 00:20:15,400
!إلى اللِّقاء

229
00:20:20,080 --> 00:20:21,610
لا أُصدِّقُ هذا

230
00:20:22,340 --> 00:20:24,070
في أنباءِ اليوم

231
00:20:24,570 --> 00:20:28,310
الطّفلُ العبقريّ كين إتشيجوجي-كن الّذي
...اختفى منذ مايو

232
00:20:28,310 --> 00:20:30,340
عُثِر عليه في منزلِه قبلَ لحظات

233
00:20:30,960 --> 00:20:37,140
لا تفاصيل عن سببِ تواجدِ الطّفل في منزلِه
بعدَ اختفاءٍ دامَ ثلاثة أشهر

234
00:20:36,150 --> 00:20:39,740
أعتقِد أنَّ العالمَ الرقميّ آمِن حاليّاً

235
00:20:40,340 --> 00:20:43,470
أجل، بالفعل. أبليتُم حسناً جميعاً

236
00:20:44,550 --> 00:20:47,840
وهكذا، انتهت المعركةُ مع قيصر الدِّيجيمون

237
00:20:48,620 --> 00:20:52,430
وتمَّت المُهمّة الأولى للأطفالِ المُختارين الجدُد

238
00:20:53,170 --> 00:20:54,130
...لكن

239
00:20:55,620 --> 00:20:57,940
...أنا سعيدةٌ جدّاً... عزيزي

240
00:21:02,060 --> 00:21:06,910
... ما زالَ أمامَ إتشيجوجي كين شيئاً يفعلُه

241
00:22:37,000 --> 00:22:41,850
يُساهِمُ الأطفالُ في إعادةِ بِناء
العالم الرَّقميّ المُسالِم الآن

242
00:22:41,850 --> 00:22:44,990
دايسكي قلِقٌ بشأنِ علاقة هيكاري وتاكيرو

243
00:22:45,350 --> 00:22:46,330
!لا يُمكِن أن يستمرَّ الأمرُ هكذا

244
00:22:46,330 --> 00:22:49,480
توجَّبَ عليه أن يُثبِت كم هو رائع
!ويقترب من هيكاري

245
00:22:49,480 --> 00:22:53,090
تبدأ المهمّةُ السرِّيةُ الخاصَّة بدايسكي وهي
!اكتِساب تطوُّر فيمون بمُستوى بالغ

246
00:22:53,360 --> 00:22:55,600
!الحلقة القادمة من مغامرة الدّيجيمون 02

247
00:22:55,600 --> 00:22:58,220
"التطوُّر الشُّجاع! أكس فيمون"

248
00:22:58,220 --> 00:23:00,420
!البوّابة المؤدّية إلى المغامرة مفتوحة الآن