1
00:04:28,710 --> 00:04:33,560
.وهكذا كانت قبلتي الأولى مع فتاة

2
00:04:37,290 --> 00:04:40,150
.كان اسمها يوري-تشان

3
00:04:42,330 --> 00:04:44,560
.قد يبدو الأمر مزحة لكنّها الحقيقة

4
00:04:52,240 --> 00:04:56,620
كانت في فريق البيسبول
.ومشهورةً بين الطلّاب الأكبر سنًا

5
00:04:57,430 --> 00:05:00,250
.تلقّت الكثير من الشوكولا في الفالنتاين

6
00:05:07,490 --> 00:05:10,090
.والآن ستتزوّج يوري-تشان

7
00:05:25,030 --> 00:05:26,400
.قادمة

8
00:05:27,740 --> 00:05:29,040
!مرحبًا، منزل هوشينو

9
00:05:29,040 --> 00:05:29,930
إي-تشان؟

10
00:05:33,980 --> 00:05:35,530
!صاخبة جدًا

11
00:05:35,530 --> 00:05:38,420
!أنا تاكيدا! تاكيدا يوري

12
00:05:39,550 --> 00:05:40,490
.أجل

13
00:05:40,880 --> 00:05:43,860
أوصلتك البطاقة البريدية؟

14
00:05:44,930 --> 00:05:46,340
.رددت عليها بالفعل

15
00:05:46,340 --> 00:05:46,920
ماذا؟

16
00:05:49,290 --> 00:05:52,160
إذًا، هل ستحضرين؟

17
00:05:53,850 --> 00:05:55,170
.سأحضر بالتأكيد

18
00:05:55,950 --> 00:05:57,020
.الحمد

19
00:05:57,850 --> 00:06:00,000
!الحــــمـــــد

20
00:06:02,030 --> 00:06:03,140
.تهانيّ لكِ

21
00:06:07,250 --> 00:06:09,890
...وهكذا وفي يومِ الزفاف

22
00:06:19,440 --> 00:06:21,820
.سحقًا، لا أصدّق أنّني بكيت

23
00:06:46,270 --> 00:06:47,920
.أتساءل لو سمعتني

24
00:06:53,250 --> 00:06:54,730
تبًا، إنّها تتبعني

25
00:07:09,030 --> 00:07:11,160
.شكرًا

26
00:07:11,160 --> 00:07:12,290
.لا عليكِ

27
00:07:13,240 --> 00:07:15,090
!يا له من وضعٍ مثير

28
00:07:18,280 --> 00:07:20,230
.إنّها جذّابةٌ بعض الشيء

29
00:07:21,080 --> 00:07:23,130
أنتِ تحبين يوري، أليس كذلك؟

30
00:07:23,130 --> 00:07:23,740
ماذا؟

31
00:07:27,160 --> 00:07:28,820
.وأنا مثلك أيضًا

32
00:07:28,820 --> 00:07:32,220
أتصدقين أنّها طلبت منّي أن أكتب لها خُطبة؟

33
00:07:37,660 --> 00:07:38,980
أتودين الشرب في مكانٍ ما؟

34
00:07:38,980 --> 00:07:40,890
.أ- أجل

35
00:07:43,360 --> 00:07:44,700
.سمعتني بالتأكيد

36
00:07:52,470 --> 00:07:56,290
.تعالي إلى منزلي

37
00:07:56,290 --> 00:07:57,950
...حسنٌ

38
00:07:57,950 --> 00:08:00,630
.لن أقوم بأيّ فعلٍ غير لائق

39
00:08:00,630 --> 00:08:02,530
.منزلي في ذلك الاتجاه

40
00:08:02,530 --> 00:08:03,940
.تعالي

41
00:08:03,940 --> 00:08:05,340
...لكن

42
00:08:05,340 --> 00:08:06,540
!لن أفعل شيئًا

43
00:08:07,240 --> 00:08:08,800
!كاذبة

44
00:08:09,100 --> 00:08:10,270
!من هنا

45
00:08:10,270 --> 00:08:12,470
!مرحى

46
00:08:13,820 --> 00:08:16,090
.ها هي، الشقة 502

47
00:08:23,440 --> 00:08:24,530
.بئسًا

48
00:08:27,010 --> 00:08:29,420
.إنّها في فوضى عارمة

49
00:08:34,180 --> 00:08:39,770
.المعذرة، آسفة، بدأت أشعر بالتوعك

50
00:08:39,770 --> 00:08:41,400
تريدين التقيّؤ؟

51
00:08:41,400 --> 00:08:42,830
.لا أدري

52
00:08:43,470 --> 00:08:45,810
.لكنني أريد الاستلقاء

53
00:08:58,300 --> 00:08:59,030
كيف أصبحت؟

54
00:09:01,840 --> 00:09:05,960
.يبدو أنّ الاستلقاء أفادني حقًا

55
00:09:13,000 --> 00:09:14,550
.لمست ثدييك

56
00:09:25,690 --> 00:09:27,830
.كذبتِ كما توقّعت

57
00:09:44,300 --> 00:09:45,540
!لنخلعها

58
00:09:45,540 --> 00:09:46,520
.توقفي

59
00:09:47,010 --> 00:09:48,780
.تأخرتِ كثيرًا

60
00:09:48,780 --> 00:09:50,240
...لكن

61
00:10:10,760 --> 00:10:13,380
كيف كانت يوري في الثانوية؟

62
00:10:13,380 --> 00:10:15,520
.كانت مشهورةً جدًا

63
00:10:15,520 --> 00:10:17,000
أكانت كذلك أيضًا في الكليّة؟

64
00:10:17,000 --> 00:10:19,090
.حسنٌ، كانت عادية

65
00:10:19,090 --> 00:10:21,240
.كانت تخرج مع الفتية وحسب

66
00:10:21,850 --> 00:10:24,390
.تكلّمت عنك كثيرًا يا إي-تشان

67
00:10:25,170 --> 00:10:27,620
.كيف كنتِ حبيبتها في الثانوية

68
00:10:27,620 --> 00:10:31,360
...في الثانوية

69
00:10:34,970 --> 00:10:37,660
.لا تبكي، أنا آسفة

70
00:10:38,280 --> 00:10:42,180
.وأنا أيضًا حبيبتها السابقة من الكلية

71
00:10:49,140 --> 00:10:51,120
.كانت تثير غيظي حقًا

72
00:10:51,120 --> 00:10:53,420
.أنتِ محقة

73
00:10:53,920 --> 00:10:57,020
.رغم أنّ ظنّنا أنّها مرهفة الحس كان خطأنا

74
00:10:57,020 --> 00:10:59,540
.بالفعل، فهمت ما تقصدين

75
00:11:04,690 --> 00:11:05,880
.تذكرتان لبالغتين

76
00:11:05,880 --> 00:11:08,240
.عجبًا! لا بأس، يمكنني الدفع عن نفسي

77
00:11:08,240 --> 00:11:10,150
.إنّها على حسابي

78
00:11:10,560 --> 00:11:12,840
.سأدفع ثمن الغداء إذًا

79
00:11:12,840 --> 00:11:14,100
.حسنٌ

80
00:12:05,960 --> 00:12:08,280
!البرد قارس

81
00:12:08,280 --> 00:12:10,040
أتنوين الذهاب لمكانٍ ما؟

82
00:12:10,760 --> 00:12:12,500
ما رأيك أن تأتي إلى منزلي؟

83
00:12:14,490 --> 00:12:15,650
.صحيح

84
00:12:16,270 --> 00:12:18,560
.أظنّنا لم ننهي حديثنا عن يوري

85
00:12:18,560 --> 00:12:20,400
.أليس كذلك؟ بالفعل

86
00:12:31,680 --> 00:12:33,650
.شكرًا على استضافتك لي

87
00:12:33,650 --> 00:12:37,360
.ليس فارهًا كمنزلك يا آيا-سان

88
00:12:37,990 --> 00:12:40,070
.أعجبني، إنّه ظريفٌ حقًا

89
00:12:48,990 --> 00:12:50,900
ألديك كتابٌ سنوي؟

90
00:12:50,900 --> 00:12:53,290
تريدين رؤية يوري-تشان، أليس كذلك؟

91
00:12:55,010 --> 00:12:57,010
!عجبًا! شعرها قصيرٌ جدًا

92
00:12:57,330 --> 00:12:59,250
.تشبه الفتية

93
00:12:59,250 --> 00:13:03,920
.بدأت بإطالة شعرها قريب نهاية الثانوية

94
00:13:04,630 --> 00:13:08,650
.اعترفت لي قريب وقت التقاط هذه الصورة

95
00:13:08,650 --> 00:13:09,540
حقًا؟

96
00:13:09,540 --> 00:13:11,600
.قبّلتني فجأةً

97
00:13:12,030 --> 00:13:13,360
.وهربت بعدها

98
00:13:16,160 --> 00:13:19,030
.دومًا ما كانت متهورة

99
00:13:20,250 --> 00:13:22,030
أين أنتِ يا إي-تشان؟

100
00:13:22,030 --> 00:13:24,260
.لا تهتمّي لأمري

101
00:13:24,260 --> 00:13:26,220
!ألم تكوني جيدة؟

102
00:13:28,890 --> 00:13:30,290
.وجدتك

103
00:13:30,290 --> 00:13:31,940
!كم أنتِ ظريفة

104
00:13:31,940 --> 00:13:33,880
!بئسًا! فلتشربي شايك حالًا

105
00:13:35,850 --> 00:13:37,160
.فهمت

106
00:13:38,360 --> 00:13:41,180
...في هذه المرحلة كنتما كلاكما

107
00:13:43,380 --> 00:13:44,610
.فهمت

108
00:13:47,090 --> 00:13:48,100
.كم هذا رائع

109
00:14:16,110 --> 00:14:17,410
.إي-تشان

110
00:14:20,910 --> 00:14:22,240
.ثدياكِ

111
00:14:26,500 --> 00:14:28,400
أيعيقك شعري؟

112
00:14:29,550 --> 00:14:30,840
.أجل، قليلًا

113
00:14:53,860 --> 00:14:57,520
.تبدين أجمل بشعرٍ منسدلٍ يا آيا-سان

114
00:14:57,520 --> 00:14:59,100
أحقًا هذا؟

115
00:15:01,640 --> 00:15:04,710
.سأبقيه منسدلًا إن كان يعجبك هكذا إذًا

116
00:15:10,110 --> 00:15:14,170
ماذا عنت يوري لنا؟

117
00:15:20,280 --> 00:15:21,660
وهم؟

118
00:15:21,660 --> 00:15:23,910
.عاهرة، عاهرة لعينة

119
00:15:27,500 --> 00:15:29,280
.لكنّها قادتني إليكِ يا إي-تشان

120
00:15:32,650 --> 00:15:33,840
.أخجلتني

121
00:15:59,020 --> 00:16:01,160
.كان أمرًا طائشًا جدًا

122
00:16:09,570 --> 00:16:13,540
سأسلمكم شهاداتكم بالترتيب الأبجدي
.لذا تقدّموا إلي عند سماع اسمكم

123
00:16:16,350 --> 00:16:18,440
.الأوّل: أداتشي تاكاهيرو

124
00:16:18,440 --> 00:16:19,160
.حاضر

125
00:16:22,240 --> 00:16:24,210
أحقًا هذا؟

126
00:16:24,510 --> 00:16:28,320
.يجب أن يقام التخرج في الصالة الرياضية

127
00:16:28,320 --> 00:16:30,250
.وأن يكون عاطفيًا

128
00:16:31,050 --> 00:16:32,780
.الثاني: أراموتو ماساكي

129
00:16:32,780 --> 00:16:33,220
.حاضر

130
00:16:33,530 --> 00:16:36,040
...وأن تكون معلّمةً لا معلّمًا

131
00:16:38,000 --> 00:16:39,350
!وداعًا

132
00:16:39,660 --> 00:16:40,820
!سلام

133
00:16:44,470 --> 00:16:46,860
أتريد الذهاب إلى شيموكيتا؟
ما رأيك بـ كيتشيوجي؟

134
00:16:46,860 --> 00:16:48,230
.لا بأس بها، لنذهب

135
00:16:55,780 --> 00:16:58,620
.لا مشاعر مطلقًا

136
00:16:59,870 --> 00:17:02,960
.سيكون رائعًا لو تلقيت رسالة حبّ

137
00:17:02,960 --> 00:17:04,290
.لكنّها مدرسة للذكور

138
00:17:07,180 --> 00:17:08,390
.ساوا-سينسي

139
00:17:08,390 --> 00:17:09,290
أجل؟

140
00:17:09,290 --> 00:17:10,840
.يقول أنّه من فصلك

141
00:17:13,110 --> 00:17:15,450
ما بك؟ لمَ أنت مرتبك؟

142
00:17:17,930 --> 00:17:20,790
.لست مرتبكًا أبدًا

143
00:17:23,380 --> 00:17:25,360
هل أتيت لتخبرني هذا؟

144
00:17:25,360 --> 00:17:26,570
.لا

145
00:17:36,840 --> 00:17:40,830
ألديك حبيبة يا معلّم؟

146
00:17:42,370 --> 00:17:43,740
ألديّ رصاصٌ للقلم؟

147
00:17:46,960 --> 00:17:48,620
.كلّا، بل حبيبة

148
00:17:49,810 --> 00:17:51,570
أهذا ما أتيت لتسألني إياه؟

149
00:17:51,570 --> 00:17:54,300
...لا، لا، حسنٌ

150
00:17:55,850 --> 00:18:00,420
.قيل لي أنّ عليّ أن أستقرّ

151
00:18:00,420 --> 00:18:02,540
أتعني الزواج؟

152
00:18:03,190 --> 00:18:06,100
.صحيح، الزواج

153
00:18:06,100 --> 00:18:08,350
.لنكفّ عن الحديث عن زوجتي غير الموجودة

154
00:18:08,350 --> 00:18:11,460
.لن أتحدث عن ذلك

155
00:18:21,090 --> 00:18:23,090
.لديك رقبة جميلة يا معلّم

156
00:18:26,360 --> 00:18:29,090
.إنّي أحبّك يا معلّم

157
00:18:40,310 --> 00:18:42,670
ما الأمر يا ياغازاكي؟

158
00:18:42,670 --> 00:18:44,940
،نسيت شيئًا وحسب

159
00:18:44,940 --> 00:18:46,150
.لكنني وجدته

160
00:18:50,900 --> 00:18:52,570
.وداعًا إذن

161
00:18:52,570 --> 00:18:53,610
.أجل

162
00:18:59,230 --> 00:19:02,040
.إنّه تدريب على الإحباط

163
00:19:02,500 --> 00:19:05,850
.ليس لدى طلّابي أيّ حافزٍ أبدًا

164
00:19:05,850 --> 00:19:08,000
،ليست مسألة خطيرة

165
00:19:08,510 --> 00:19:11,070
.الأمر أشبه بكونه لا مبالاة تامة

166
00:19:11,070 --> 00:19:12,210
.أفهمك

167
00:19:12,520 --> 00:19:14,680
!طابت ليلتكما

168
00:19:14,680 --> 00:19:16,260
!وداعًا

169
00:19:16,740 --> 00:19:18,520
أيجدر بنا الذهاب؟

170
00:19:23,210 --> 00:19:25,670
.شربت كثيرًا

171
00:19:27,010 --> 00:19:30,480
.انقضت السنة بلمح البصر

172
00:19:31,430 --> 00:19:33,020
...المعذرة يا أستاذ

173
00:19:33,020 --> 00:19:33,900
ماذا؟

174
00:19:39,440 --> 00:19:41,170
.لا شيء

175
00:19:41,170 --> 00:19:43,550
ما بالك؟

176
00:19:43,550 --> 00:19:45,830
!أخبرني رجاءً

177
00:20:00,200 --> 00:20:03,220
.إنّي أحبّك يا معلّم

178
00:20:05,350 --> 00:20:06,190
.بئسًا

179
00:20:07,140 --> 00:20:08,940
.يمكنني الموت الآن

180
00:20:18,990 --> 00:20:24,830
إنّني أشبه بطالبة مدرسة يافعة خجِلَة
.تحلم بمستقبلها الوردي

181
00:20:24,830 --> 00:20:27,910
.حلمٌ متلألئ

182
00:20:30,770 --> 00:20:34,420
.لكنّ هذا كان منذ سنة

183
00:20:36,880 --> 00:20:38,900
.لم يكن هنالك أيّ شيءٍ منذ البداية

184
00:20:45,680 --> 00:20:49,060
.سنفتتح الآن مهرجان التخرج

185
00:20:49,060 --> 00:20:49,550
.على جميع المتخرجين العودة إلى صفوفهم

186
00:20:49,550 --> 00:20:52,190
.لربّما لم يكن هنالك أيّ شيءٍ أصلًا

187
00:20:54,580 --> 00:20:56,340
.تهانيّ لكم

188
00:20:56,340 --> 00:20:58,990
،سأسلمكم شهاداتكم الآن

189
00:20:59,500 --> 00:21:01,070
.لذا تقدّموا نحوي رجاءً وفقًا للترتيب الأبجدي

190
00:21:01,070 --> 00:21:04,650
.أصبحت مهووسًا بياغاساكي وكثير التخيّل

191
00:21:04,650 --> 00:21:06,540
.هذا ما جرى

192
00:21:06,930 --> 00:21:08,870
.إنّه أنيق

193
00:21:09,220 --> 00:21:11,460
.تأثرت حقًا، أمزح

194
00:21:12,920 --> 00:21:16,170
.إن كان أحبّ فتىً آخر فما باليد حيلة

195
00:21:19,910 --> 00:21:22,350
.هذا هو المكان، إنّه في الطابق الخامس

196
00:21:23,320 --> 00:21:24,720
!أهلًا وسهلًا

197
00:21:32,350 --> 00:21:33,230
.طاولة لشخصين

198
00:21:33,230 --> 00:21:34,690
.بالطبع

199
00:21:34,690 --> 00:21:36,040
.ثمّة طاولة هناك

200
00:21:36,040 --> 00:21:38,640
ماذا؟ هي أختك يا ساوا-سينسي؟

201
00:21:38,640 --> 00:21:39,440
حقًا؟

202
00:21:39,440 --> 00:21:40,900
!عجبًا

203
00:21:40,900 --> 00:21:43,570
.لربّما أشتري لها بعض الجعة

204
00:21:45,320 --> 00:21:47,790
.تفاجأت برؤيتك

205
00:21:47,790 --> 00:21:48,940
.وأنا أيضًا

206
00:21:48,940 --> 00:21:50,000
أليس كذلك؟

207
00:21:59,030 --> 00:22:00,470
تانابي؟

208
00:22:00,470 --> 00:22:02,490
.إنّنا نعيش سويًا

209
00:22:02,490 --> 00:22:04,900
.أو بالأحرى يسمح لي بالبقاء عنده

210
00:22:04,900 --> 00:22:08,070
.كان هذا سابقًا فندق حبّ

211
00:22:08,070 --> 00:22:09,410
!عجبًا

212
00:22:09,410 --> 00:22:10,490
!عدت

213
00:22:11,230 --> 00:22:12,330
.مرحبًا بعودتك

214
00:22:16,810 --> 00:22:20,010
!وكنا خمستنا في الوقت عينه

215
00:22:20,010 --> 00:22:21,270
.كان هذا مستحيلًا

216
00:22:21,270 --> 00:22:22,490
!عجبًا

217
00:22:22,490 --> 00:22:25,340
هل رقبتي جميلة؟

218
00:22:25,340 --> 00:22:26,030
ماذا؟

219
00:22:27,750 --> 00:22:29,040
ما بها؟

220
00:22:29,040 --> 00:22:30,350
.تبدو عاديّة لي

221
00:22:30,350 --> 00:22:31,780
عمّ تتحدث؟

222
00:22:36,000 --> 00:22:37,500
!مرحاض أرضي

223
00:22:40,790 --> 00:22:43,830
.سيّدي، لا يمكنني التوقف عن التبوّل

224
00:22:44,730 --> 00:22:47,340
.يا لي من أحمق

225
00:22:47,340 --> 00:22:51,100
!أسرع بالخروج رجاءً

226
00:22:53,580 --> 00:22:54,610
.أختي

227
00:22:56,310 --> 00:22:58,980
.أحبّ فتيان الثانوية

228
00:22:58,980 --> 00:22:59,650
ماذا؟

229
00:23:00,840 --> 00:23:05,740
لكنّهم يعبثون معي، أولئك الفتية الأشرار

230
00:23:05,740 --> 00:23:07,740
.فهمت، اخلد إلى النوم

231
00:23:08,740 --> 00:23:10,070
.أرى اثنين منه

232
00:23:10,070 --> 00:23:10,760
ماذا؟

233
00:23:11,690 --> 00:23:12,450
ممّن؟

234
00:23:12,450 --> 00:23:13,830
.لا أدري

235
00:23:19,380 --> 00:23:21,170
كم مضى على الأمر؟

236
00:23:21,170 --> 00:23:22,170
.ثلاث سنوات

237
00:23:22,170 --> 00:23:24,090
.يبدو أنّه عانى جدًا

238
00:23:24,090 --> 00:23:25,390
.بالفعل

239
00:23:25,390 --> 00:23:29,310
.أختي ترقص وترقص وترقص

240
00:23:29,310 --> 00:23:33,250
.وأنا أتوسلها أن تتوقف لأنّ هذا محرج

241
00:23:53,790 --> 00:23:55,330
،فكّرت لبرهة

242
00:23:57,120 --> 00:24:00,470
.لا أشبهه إطلاقًا

243
00:24:01,720 --> 00:24:02,710
.صباح الخير

244
00:24:02,710 --> 00:24:05,280
.صباح الخير، يكاد الفطور يجهز

245
00:24:05,280 --> 00:24:06,500
.أراكِ لاحقًا

246
00:24:06,500 --> 00:24:07,300
.وداعًا

247
00:24:09,750 --> 00:24:10,460
...المعذرة

248
00:24:13,500 --> 00:24:16,060
اعتنِ بأختي رجاءً

249
00:24:26,100 --> 00:24:28,370
.كان هنالك رقصٌ البارحة

250
00:24:28,370 --> 00:24:29,650
من كان يرقص؟

251
00:24:29,650 --> 00:24:32,060
.أنتِ وحبيبك

252
00:24:32,060 --> 00:24:33,560
.توقف عن هذا

253
00:24:36,160 --> 00:24:38,200
.أريد أن أكون عاملًا بدوامٍ جزئي

254
00:24:40,540 --> 00:24:43,350
.ظننت أنّك أحببت فتية الثانوية

255
00:24:43,350 --> 00:24:45,480
.أريد أن أكون جزءًا من حلقة

256
00:24:45,480 --> 00:24:47,550
.أرقص وأستمرّ بالرقص

257
00:24:52,830 --> 00:24:56,330
.وانقضت سنةٌ أخرى

258
00:25:02,240 --> 00:25:04,680
.مراسم التخرج واهية حقًا

259
00:25:04,680 --> 00:25:06,860
.إنّه بسيطٌ على الأقل

260
00:25:22,820 --> 00:25:25,710
اسمعوا، لمَ لا تقيمون لي حفلة شكر؟

261
00:25:27,930 --> 00:25:30,920
لست مستعدًا للوداع؟

262
00:25:33,140 --> 00:25:38,320
.سأقدر لكم حقًا أن تقيموا لي حفلة

263
00:25:42,800 --> 00:25:44,440
ما هذا؟

264
00:25:49,150 --> 00:25:51,240
.حسنٌ

265
00:25:51,240 --> 00:25:53,480
.دعونا نفعل ذلك لأجل المعلّم

266
00:25:53,480 --> 00:25:55,620
.لكنها على حسابك يا معلّم

267
00:25:58,130 --> 00:26:00,640
.كانت السماء جميلة جدًا

268
00:26:03,150 --> 00:26:06,200
.لربّما هذا ما دفعني لقول ذلك

269
00:26:15,350 --> 00:26:17,470
!لنذهب إلى منزلك تاليًا يا معلّم

270
00:26:17,470 --> 00:26:19,110
.أجل

271
00:26:19,110 --> 00:26:21,020
.مستحيل، منزلي ضيق

272
00:26:21,020 --> 00:26:22,690
!لا بأس

273
00:26:22,690 --> 00:26:26,150
!بوسعنا أن ننحشرسويًا كلنا

274
00:26:28,180 --> 00:26:30,590
.حسنٌ، أظنّ أن لا بأس بالأمر

275
00:26:30,590 --> 00:26:32,280
.بل أكثر من جيد

276
00:26:33,620 --> 00:26:36,070
.ثمّة منزلٌ قديم وكبير أعرفه

277
00:26:36,070 --> 00:26:37,080
.يمكننا الذهاب إلى هناك

278
00:26:37,790 --> 00:26:39,870
!أجل

279
00:26:40,840 --> 00:26:44,690
.حين أخبرتهم أنّه كان فندق حب

280
00:26:44,690 --> 00:26:45,900
.صُدِموا بالأمر

281
00:27:12,230 --> 00:27:13,570
في أيّ مسألةٍ أنتِ؟

282
00:27:14,630 --> 00:27:15,820
.رقم ثلاثة

283
00:27:21,200 --> 00:27:23,120
أتحققان تقدمًا؟

284
00:27:24,490 --> 00:27:27,440
لمَ لا تأخذان قسطًا من الراحة
وتتناولان بعض البطيخ؟

285
00:27:33,550 --> 00:27:35,020
.شكرًا على الوجبة

286
00:27:36,680 --> 00:27:38,830
.الهواء منعش هنا

287
00:27:41,740 --> 00:27:43,040
.أراك غدًا

288
00:27:43,040 --> 00:27:43,900
.أجل

289
00:27:53,690 --> 00:27:56,370
.فلتنادي سايو-تشان، سيجهز العشاء قريبًا

290
00:27:56,370 --> 00:27:57,100
.حسنٌ

291
00:28:16,090 --> 00:28:17,930
.اخرجي يا سايوكو

292
00:28:21,350 --> 00:28:24,180
!الجو أشبه بالساونا هنا

293
00:28:25,420 --> 00:28:27,190
.بالطبع هو كذلك

294
00:28:27,460 --> 00:28:29,150
أتقومان بأمورٍ حميميّة سويًا؟

295
00:28:29,150 --> 00:28:30,360
!بالطبع لا أيّتها الحمقاء

296
00:28:30,970 --> 00:28:32,010
.إنّه موعد العشاء

297
00:28:35,480 --> 00:28:37,840
.أصبحت في الصف السادس بالفعل

298
00:28:37,840 --> 00:28:39,160
.الخامس

299
00:28:39,160 --> 00:28:41,970
.اجلسا كلاكما

300
00:28:48,720 --> 00:28:50,580
لمَ لا تذهب إلى منزلها؟

301
00:28:50,880 --> 00:28:53,700
.لأنّ سايو-تشان طُرِدَت

302
00:28:53,700 --> 00:28:56,200
.تستحق ما جرى لها

303
00:28:56,200 --> 00:28:58,060
.دعيني أرى الفيديو لاحقًا

304
00:28:58,060 --> 00:28:58,880
.بالتأكيد

305
00:28:58,880 --> 00:29:00,410
!عزيزي

306
00:29:00,410 --> 00:29:02,760
!عليك مشاهدته أيضًا يا شين-تشان

307
00:29:04,610 --> 00:29:06,600
.إنّك الأسوأ

308
00:29:07,210 --> 00:29:09,880
.آمل أن تبقي الليلة

309
00:29:09,880 --> 00:29:12,380
.سأكلّم والدك غدًا

310
00:29:12,380 --> 00:29:14,180
.آسفة جدًا

311
00:29:14,790 --> 00:29:15,970
.شكرًا على الطعام

312
00:29:15,970 --> 00:29:17,270
.بالهناء

313
00:29:19,070 --> 00:29:21,700
.عجبًا! إنّك تدرس بجد

314
00:29:22,250 --> 00:29:25,970
إنّني أبلي أفضل حاليًا قياسًا
.بالسابق حين درستني

315
00:29:25,970 --> 00:29:28,910
.هذا لأنني أسستك جيدًا

316
00:29:28,910 --> 00:29:30,900
!لا تدخني هنا

317
00:29:30,900 --> 00:29:32,350
!هذه غرفتي

318
00:29:35,950 --> 00:29:39,050
!بئسًا! حريّ بكِ أن تعيدي الأغراض إلى أمكنتها

319
00:29:39,800 --> 00:29:43,960
تكلّم أو تكلّمي مع أصدقائك حول
.أوّل استمناءٍ أو دورةٍ شهريّة

320
00:29:43,960 --> 00:29:46,030
أخبرني، أنمى الشعر على خصيتيك بعد؟

321
00:29:46,030 --> 00:29:47,270
!كلّا

322
00:29:47,270 --> 00:29:48,900
!دعني أرى بينما لا تزال ملسةً ناعمة

323
00:29:48,050 --> 00:29:49,560
!ابتعدي عنّي أيّتها المنحرفة

324
00:29:49,560 --> 00:29:50,190
!أمّي، إنّها تتحرّش بي جنسيًا

325
00:29:50,190 --> 00:29:51,630
!ناعمة جدًا

326
00:29:57,570 --> 00:29:59,100
أهذا هو الفيديو؟

327
00:29:59,100 --> 00:29:59,930
.أجل

328
00:30:00,870 --> 00:30:03,200
.تخرّجت من الكليّة وصوّرته بعدها

329
00:30:03,510 --> 00:30:05,270
.يا لها من حمقاء

330
00:30:07,260 --> 00:30:08,240
هل شاهدته؟

331
00:30:09,140 --> 00:30:10,620
!مستحيل

332
00:30:10,920 --> 00:30:11,460
.لنشاهده

333
00:30:11,460 --> 00:30:12,710
!ماذا؟

334
00:30:14,670 --> 00:30:18,300
توقفي يا ميكا-تشان
!لا يمكننا، سنقع في مشكلة

335
00:30:18,640 --> 00:30:20,000
.سأضعه على الصامت إذًا

336
00:30:20,000 --> 00:30:22,010
!لم أقصد هذا

337
00:30:26,700 --> 00:30:29,350
!أتريدين تناول بعض المعكرونة أيضًا يا ميكا-تشان؟

338
00:30:38,860 --> 00:30:41,600
.أخبرتك أنّه لا يجدر بنا هذا

339
00:30:48,330 --> 00:30:50,170
.ها أنتِ

340
00:31:05,090 --> 00:31:07,060
هل تشاجرتما؟

341
00:31:10,400 --> 00:31:11,680
!هذا ليس مضحكًا

342
00:31:11,680 --> 00:31:15,420
!فلتسرع بفعلها معها

343
00:31:16,110 --> 00:31:18,270
!لا يمكنني فعل شيءٍ مثل هذا

344
00:31:20,480 --> 00:31:24,160
.تتمنّع لكنّك تريد هذا في الواقع

345
00:31:24,160 --> 00:31:26,160
!ثدياكِ

346
00:31:26,160 --> 00:31:28,200
ما بهما؟

347
00:31:29,270 --> 00:31:30,210
.إنّهما كبيران

348
00:31:30,830 --> 00:31:33,000
!دعني أرى قضيبك

349
00:31:33,000 --> 00:31:35,220
ما الذي يجري فوق؟

350
00:31:36,060 --> 00:31:38,950
إذًا، هل رأيتِ والدها؟

351
00:31:38,950 --> 00:31:41,800
...رأيته ولكن

352
00:31:42,620 --> 00:31:46,720
لم أسمح لها أن تنتقل للعيش بمفردها لتصوّر
.فيديو سيئًا كهذا

353
00:31:47,100 --> 00:31:48,550
.لم يقل كلمة بعد ذلك

354
00:31:48,550 --> 00:31:51,080
.لا يمكنني لومه

355
00:31:51,820 --> 00:31:54,350
.حريّ بك ألا تكون شاهدته

356
00:31:54,350 --> 00:31:56,460
.لم أشاهده، أقسم لك

357
00:32:10,400 --> 00:32:13,260
!بئسًا، أيّتها الحمقاء ميكا

358
00:32:14,430 --> 00:32:16,250
هل سأنام في الخزانة مجدّدًا؟

359
00:32:20,670 --> 00:32:22,700
.سأنام فيها الليلة

360
00:32:23,600 --> 00:32:26,910
.لعلمك، يمكننا أن ننام سويًا في الخارج هنا

361
00:32:28,120 --> 00:32:29,360
.لا بأس، عمتِ مساءً

362
00:32:32,120 --> 00:32:33,330
.الجو حار

363
00:32:34,590 --> 00:32:38,120
.لن تتحمّل البقاء هناك

364
00:32:44,760 --> 00:32:45,970
.عمتَ مساءً

365
00:32:55,190 --> 00:32:56,490
.مرحبًا

366
00:32:58,960 --> 00:33:01,170
.أهلًا بكِ يا ميكا-تشان

367
00:33:02,670 --> 00:33:04,130
.اشتريت بعض الكرز

368
00:33:04,440 --> 00:33:06,960
.شكرًا

369
00:33:06,960 --> 00:33:09,220
.شين يغسل ملابسه الداخلية الآن

370
00:33:09,720 --> 00:33:12,260
!لا يجدر بك إخبارها بهذا

371
00:33:14,480 --> 00:33:15,960
هل بلّلت سريرك؟

372
00:33:15,960 --> 00:33:16,970
.لا

373
00:33:18,970 --> 00:33:20,400
!لم أبلله

374
00:33:20,400 --> 00:33:22,380
!لذا لا تنشري الشائعات

375
00:33:22,380 --> 00:33:23,870
.لن أفعل ذلك

376
00:33:26,380 --> 00:33:29,180
إلي أين وصلت البارحة؟

377
00:33:29,180 --> 00:33:30,700
...حسنٌ

378
00:33:30,700 --> 00:33:32,310
.إلى هنا

379
00:33:38,520 --> 00:33:41,690
هل سنتزوج أنا وأنت يا شين-تشان؟

380
00:33:42,620 --> 00:33:43,830
ماذا تقولين؟

381
00:33:44,950 --> 00:33:47,470
.هاكما بعض الكرز

382
00:33:47,470 --> 00:33:50,020
.جربت واحدة، إنّه كرزٌ حلو حقًا

383
00:33:50,020 --> 00:33:51,180
.هذا جيد

384
00:33:52,540 --> 00:33:54,200
.أنت أيضًا يا سايو-تشان

385
00:33:56,500 --> 00:33:59,590
!الجو حار جدًا هنا

386
00:33:59,590 --> 00:34:03,130
.إنّني الأخت في الفيديو ذاك

387
00:34:03,910 --> 00:34:06,100
.سررت بلقائك يا ميكا-تشان

388
00:34:07,400 --> 00:34:09,150
!سايو-تشان

389
00:34:09,150 --> 00:34:10,880
.فهمت

390
00:34:19,420 --> 00:34:21,200
.إنّها ابنة عمي

391
00:34:21,200 --> 00:34:24,070
!مذهل، إنّها هي حقًا

392
00:34:24,070 --> 00:34:25,790
!لا تخبري أحدًا في الفصل

393
00:34:31,200 --> 00:34:33,540
.عليك المجيء إلى منزلي غدًا

394
00:34:36,080 --> 00:34:36,810
.حسنٌ

395
00:34:42,640 --> 00:34:44,980
هل أنا مدعوّة؟

396
00:34:45,350 --> 00:34:46,900
.بالطبع لا

397
00:34:46,900 --> 00:34:50,570
من تظنّ نفسك يا طالب الابتدائيّة؟

398
00:34:57,790 --> 00:35:00,200
!يكفي هذا! ارتدي ملابسك

399
00:35:00,200 --> 00:35:02,410
!إننّا صغيران على هذا

400
00:35:03,030 --> 00:35:07,290
تاتيشي من الصف السادس سبق وفعلها
.مع طالبة في الصف الثامن

401
00:35:07,290 --> 00:35:08,880
حقًا؟

402
00:35:12,830 --> 00:35:17,430
أتحبّ سايوكو-سان يا شين-تشان؟

403
00:35:22,640 --> 00:35:25,320
أنّى لهذا أن يخطر لها؟

404
00:35:28,210 --> 00:35:31,540
.عدت

405
00:35:31,540 --> 00:35:33,290
أما تزالين هنا؟

406
00:35:33,290 --> 00:35:34,780
.سأغادر غدًا

407
00:35:37,020 --> 00:35:38,080
حقًا؟

408
00:35:38,080 --> 00:35:40,270
.أعلم أنّك ستفتقدني

409
00:35:42,200 --> 00:35:44,120
هل سامحك والدك؟

410
00:35:44,120 --> 00:35:45,170
.مستحيل

411
00:35:52,410 --> 00:35:53,760
أفعلتها مع ميكا-تشان؟

412
00:35:53,760 --> 00:35:54,800
.بالطبع لا

413
00:36:06,320 --> 00:36:07,270
.عمتِ مساءً

414
00:36:09,190 --> 00:36:12,290
.لم أنهي كلامي بعد

415
00:36:12,290 --> 00:36:13,980
.وعليك أن تبدل ملابسك

416
00:36:13,980 --> 00:36:14,830
.أجل

417
00:36:17,970 --> 00:36:21,620
.إن كنت وحيدًا فعليك قول هذا وحسب

418
00:36:22,250 --> 00:36:26,920
.اعتدت على تواجدك هنا، هذا كلّ ما في الأمر

419
00:36:29,880 --> 00:36:31,290
أتريد امتلاجَ ثديي؟

420
00:36:31,290 --> 00:36:33,300
.أنتِ الأسوأ

421
00:37:14,100 --> 00:37:15,980
أعادت سايوكو-سان إلى منزلها؟

422
00:37:20,330 --> 00:37:23,460
.ذهب ساساكي والآخرون إلى المسبح

423
00:37:23,460 --> 00:37:24,900
.سيضايقوننا

424
00:37:30,060 --> 00:37:31,440
.عدت

425
00:37:31,440 --> 00:37:34,060
!انظر إلى مجموعة الجعة هذه

426
00:37:34,060 --> 00:37:37,030
.إنّها عنيدة لكنها أرادت شكرنا

427
00:38:01,590 --> 00:38:02,720
.شين-تشان

428
00:38:03,780 --> 00:38:05,570
أتغسل ثيابك الداخلية مجدّدًا؟

429
00:38:08,470 --> 00:38:10,720
.كتب لي ساساكي رسالة حب

430
00:38:10,720 --> 00:38:12,910
.أخبرني أن أنفصل عنك

431
00:38:22,620 --> 00:38:26,630
.عديني ألّا تري شينتشي هذه الرسالة

432
00:38:26,630 --> 00:38:28,910
.إن فعلتِ، سيكون عليّ تحديه في مبارزة

433
00:38:29,250 --> 00:38:30,410
!مبارزة؟

434
00:38:38,670 --> 00:38:40,270
!لا أريد

435
00:38:40,270 --> 00:38:42,880
.شين-تشان، ستبدأ المدرسة اليوم

436
00:38:42,880 --> 00:38:44,590
!لا أريد الذهاب

437
00:38:59,090 --> 00:39:01,880
.سأحميك إن حصل شيء

438
00:39:03,340 --> 00:39:06,780
.لم أخطئ في شيء

439
00:39:07,990 --> 00:39:10,950
!لن أسمح لأحدٍ بالقتال في صفي

440
00:39:12,360 --> 00:39:14,640
.نجوت

441
00:39:17,030 --> 00:39:18,090
.عدت

442
00:39:18,360 --> 00:39:19,700
.شكرًا على استضافتكم لي

443
00:39:20,360 --> 00:39:22,150
ألديكما واجبات مدرسية؟

444
00:39:22,150 --> 00:39:25,300
.أجل

445
00:39:22,990 --> 00:39:24,090
.ابذلا جهدكما

446
00:39:55,710 --> 00:39:59,450
.يمكنني إخبارك الآن أنّني كنت وحيدًا

447
00:40:00,810 --> 00:40:03,250
ما الذي تتحدث عنه؟

448
00:40:27,590 --> 00:40:30,870
،جعلني شين-تشان أعده بألّا أخبر أحدًا

449
00:40:31,830 --> 00:40:34,080
.لم أقصد أن أخبر أحدًا

450
00:40:41,040 --> 00:40:41,730
.أخبرني

451
00:40:42,890 --> 00:40:45,940
أصحيح أنّ ابنة عمّك صورت فلمًا إباحيًا؟

452
00:40:45,940 --> 00:40:46,940
وماذا لو فعلت؟

453
00:40:46,940 --> 00:40:48,880
!هذا صحيح إذًا، مذهل

454
00:40:48,880 --> 00:40:50,410
.كان هذا منذ وقتٍ طويل

455
00:40:51,240 --> 00:40:52,720
هل شاهدته؟

456
00:40:57,110 --> 00:40:58,020
.لنعد إلى المنزل

457
00:40:58,020 --> 00:41:00,190
.أتمنّى لو يمكنني مشاهدته

458
00:41:01,330 --> 00:41:03,680
أكنتِ تعلمين أنّ ابنة عمّه صوّرت فلمًا إباحيًا؟

459
00:41:03,680 --> 00:41:04,740
.فلتمت

460
00:41:06,700 --> 00:41:07,770
.مخيفة

461
00:41:09,770 --> 00:41:11,820
أيفعلها هذان الاثنان؟

462
00:41:14,750 --> 00:41:17,410
.لأنّ هذا كان قبل زمنٍ بعيد

463
00:41:18,170 --> 00:41:20,370
.لا تزول الشائعات أبدًا

464
00:41:20,830 --> 00:41:24,670
.أخبرت إيمي-تشان ألا تخبر أحدًا

465
00:41:24,670 --> 00:41:28,110
.وأنا أخبرتك بذلك أيضًا

466
00:41:28,110 --> 00:41:30,340
...لكن

467
00:41:39,980 --> 00:41:41,540
.وداعًا

468
00:41:56,430 --> 00:41:57,430
.عدت

469
00:41:57,430 --> 00:41:59,290
.مرحبًا بعودتك

470
00:42:00,390 --> 00:42:01,480
أتعدين الكاري؟

471
00:42:01,480 --> 00:42:03,980
سيعود أخوك إلى المنزل
.لذا أعددته حارًا قليلًا

472
00:42:03,980 --> 00:42:04,890
أهو جيد؟

473
00:42:14,910 --> 00:42:16,430
.إنّني متحمسة

474
00:42:19,900 --> 00:42:23,900
.سيقوم فصل شين-تشان بعمل منزلٍ مسكون

475
00:42:26,170 --> 00:42:28,720
.ستغني ميكا-تشان أغنية منفردة في جوقتها

476
00:42:28,720 --> 00:42:30,380
.أحقًا هذا؟ مذهل

477
00:42:30,380 --> 00:42:32,320
.سنذهب جميعًا

478
00:42:32,320 --> 00:42:33,640
أيمكن لكَ الذهاب أيضًا؟

479
00:42:33,640 --> 00:42:34,700
متى موعد ذلك؟

480
00:42:34,700 --> 00:42:36,380
.سيبدأ في الواحدة ظهرًا

481
00:42:41,690 --> 00:42:44,970
.كان بالإمكان استخدام أزهارٍ أكثر

482
00:42:44,970 --> 00:42:46,710
أنضيف بعض الأزهار إذًا؟

483
00:42:47,190 --> 00:42:50,900
ألا يزال الفيديو لديك؟

484
00:42:50,900 --> 00:42:52,330
.أبدًا

485
00:43:27,770 --> 00:43:29,700
!شين-تشان يشاهدني

486
00:43:35,630 --> 00:43:37,840
.ظننت أنّني سأموت

487
00:43:37,840 --> 00:43:39,180
.لا زالت وجنتاك متوردتين

488
00:43:39,460 --> 00:43:41,380
.إنّ صوتي أجش

489
00:43:41,380 --> 00:43:43,290
.هذا محرجٌ جدًا

490
00:43:45,770 --> 00:43:46,780
.وداعًا

491
00:43:46,780 --> 00:43:47,610
.أجل

492
00:44:12,190 --> 00:44:14,570
.سئمت من مشاهدة هذه القذارة

493
00:44:30,950 --> 00:44:34,890
.لا فائدة، لا زلت لا أدري كيف أصل للنشوة

494
00:44:38,670 --> 00:44:41,020
.تظاهري بأنّها يد شين-تشان

495
00:44:48,810 --> 00:44:50,950
.أكره المطر حقًا

496
00:44:50,950 --> 00:44:52,920
.أما أنا فأحبه

497
00:44:53,560 --> 00:44:58,850
إن أمطرت بينما أشاهد التلفاز
.أضعه على الصامت وأستمع لصوت المطر

498
00:44:58,850 --> 00:45:00,220
.إنّه يهدئني

499
00:45:00,220 --> 00:45:02,990
.لربّما أنت متعبة جدًا وحسب

500
00:45:04,330 --> 00:45:07,890
.أو أنّك مهووسة بتخيل نفسك تستمعين إلى المطر

501
00:45:07,890 --> 00:45:09,100
!يا للفظاظة

502
00:45:12,180 --> 00:45:15,020
.تغيّرت يا شين-تشان

503
00:45:15,020 --> 00:45:15,820
ماذا؟

504
00:45:16,800 --> 00:45:20,130
.أحببتك أكثر حين كنت طفلًا

505
00:45:20,130 --> 00:45:21,690
ما معنى هذا؟

506
00:45:25,550 --> 00:45:27,460
.لكنني لا أزال أحبك

507
00:45:32,980 --> 00:45:35,020
.أنتِ ويابي مقرّبان جدًا

508
00:45:35,020 --> 00:45:35,810
أليس كذلك؟

509
00:45:35,810 --> 00:45:38,100
.صوتُّ لكما مرتين كأفضل ثنائي

510
00:45:38,100 --> 00:45:39,110
.وأنا أيضًا

511
00:45:41,570 --> 00:45:42,840
.إنّهم ينزلون اللافتة

512
00:45:43,340 --> 00:45:46,200
.كان هذا تخريبًا للأزهار

513
00:45:56,940 --> 00:45:59,210
أسناخذ كلّ الستائر؟

514
00:45:59,210 --> 00:46:00,540
.ثلاثٌ فقط

515
00:46:09,930 --> 00:46:13,520
.رأيت أشخاصًا يفعلونها هنا

516
00:46:14,600 --> 00:46:16,650
.شاهدناهم خفيةً أنا وإيمي-تشان

517
00:46:19,590 --> 00:46:22,450
.كثيرون يفعلونها هنا

518
00:46:22,450 --> 00:46:24,480
.ليس الكثير

519
00:46:33,580 --> 00:46:36,230
.سأفعلها معك يا شين-تشان

520
00:46:41,860 --> 00:46:42,580
!يستحيل هذا

521
00:46:42,580 --> 00:46:44,790
أين هي الستائر؟

522
00:46:44,790 --> 00:46:46,310
.سيحضرها شينتشي

523
00:46:46,310 --> 00:46:47,320
لوحده؟

524
00:46:47,320 --> 00:46:51,720
.في الواقع، ذهب مع توكوناغا من الفصل 6

525
00:46:51,720 --> 00:46:53,170
...كلاهما

526
00:46:57,520 --> 00:46:58,640
!هنا

527
00:47:02,760 --> 00:47:03,450
أفعلتماها؟

528
00:47:03,450 --> 00:47:04,600
فعلنا ماذا؟

529
00:47:12,150 --> 00:47:14,660
.لا بدّ أنّهما فعلاها

530
00:47:14,660 --> 00:47:15,870
.صحيح

531
00:47:23,800 --> 00:47:27,680
.أحبّ اليوم الذي يسبق يوم المهرجان

532
00:47:27,680 --> 00:47:28,370
ماذا؟

533
00:47:29,690 --> 00:47:30,830
.مهرجان المدرسة

534
00:47:31,610 --> 00:47:34,270
.أجل، أنا أيضًا

535
00:47:34,270 --> 00:47:37,920
.لا تشاهد غناءَ فصلي رجاءً

536
00:47:46,550 --> 00:47:48,510
.لقد ضغطتهما

537
00:47:51,020 --> 00:47:54,640
إنّك لا تدركين هذه الأمور حقًا
ها هما عادا

538
00:47:55,280 --> 00:47:56,230
.عدت

539
00:47:56,690 --> 00:47:59,310
!ستتزوج سايو-تشان السنة المقبلة

540
00:47:59,310 --> 00:48:01,070
أوليس هذا رائعًا؟

541
00:48:01,070 --> 00:48:02,730
.بالفعل

542
00:48:02,730 --> 00:48:04,300
أين سيقام الزفاف؟

543
00:48:04,300 --> 00:48:05,280
.ادخلي

544
00:48:14,770 --> 00:48:17,300
ألا زلت غاضبة حيال ما جرى؟

545
00:48:19,090 --> 00:48:21,290
.قلتِ أنّني أستطيع فعل ذلك

546
00:48:22,040 --> 00:48:25,760
.قلت أنّك تحب سايوكو-سان يا شين-تشان

547
00:48:26,120 --> 00:48:28,290
!لم أقل أنني أحبها

548
00:48:28,290 --> 00:48:30,600
.لكن يمكنني معرفة ذلك

549
00:48:30,920 --> 00:48:34,810
!يزعجني أنّ علينا أن نبقي أمرنا سرًا

550
00:48:47,590 --> 00:48:50,070
.أشعر براحة أكبر الآن

551
00:48:53,320 --> 00:48:55,890
.سأبدأ بكتابة مذكراتي الليلة

552
00:48:55,890 --> 00:48:59,360
.سيكون أوّل ما سأكتب هو: الحمقاء سايوكو

553
00:49:11,280 --> 00:49:16,560
.سيبدأ عزف جوقات الفصول في الواحدة

554
00:49:26,530 --> 00:49:29,480
.أظنّ أننا رُشِحنا كأفضل ثنائي في الصف الثامن

555
00:49:30,330 --> 00:49:31,050
.أجل

556
00:49:37,460 --> 00:49:43,080
الجائزة كانت واقيًا مع ملاحظةٍ مرفقة
.لا تدعا الأساتذة يكتشفون ذلك

557
00:49:44,120 --> 00:49:48,900
.نفخناه وكأنه بالون

558
00:49:50,200 --> 00:49:53,880
.أو ربّما لم نفعل ذلك