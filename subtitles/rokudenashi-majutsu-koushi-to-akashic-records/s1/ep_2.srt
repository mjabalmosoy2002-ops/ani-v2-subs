1
00:00:04,800 --> 00:00:07,670
.لا، لقد فهمتِ بشكلٍ خاطئ

2
00:00:09,610 --> 00:00:12,860
.إذًا فحصّة اليوم تصل لهذا مجدّدًا

3
00:00:12,860 --> 00:00:14,890
.اعتنوا بالباقي

4
00:00:16,290 --> 00:00:18,120
ما مشكلته؟

5
00:00:18,120 --> 00:00:21,450
لم يكن يفعل أيّ شيءٍ عدا هذا
.حتّى بعد خسارته للنّزال

6
00:00:21,450 --> 00:00:25,110
.لا أصدّق أنّه قد يتخلّى عن اتّفاقٍ بين ساحرين

7
00:00:26,290 --> 00:00:27,880
.مـ-معذرةً

8
00:00:28,440 --> 00:00:29,260
ماذا؟

9
00:00:29,260 --> 00:00:34,080
...هناك شيءٌ لم أفهمه بشأن التّرجمة الرّونية

10
00:00:34,080 --> 00:00:35,220
.إنّك تهدرين وقتك يا لين

11
00:00:35,520 --> 00:00:36,480
سيستي؟

12
00:00:36,480 --> 00:00:39,180
.لا يجب أن تسألي ذلك الرّجل

13
00:00:39,180 --> 00:00:44,700
.إنّه لا يفقه شيئًا عن عظمة أو قيمة السّحر

14
00:00:44,700 --> 00:00:45,870
...لـ-لكن

15
00:00:45,870 --> 00:00:46,690
.لا بأس

16
00:00:47,000 --> 00:00:48,640
.سأعلّمك

17
00:00:48,640 --> 00:00:52,740
هل السّحر بذلك النّبل والعظمة فعلاً؟

18
00:00:53,720 --> 00:00:56,200
.كنتُ أتساءل ما قد تقول

19
00:00:56,200 --> 00:00:59,740
.السّحر هو دراسة مبادئ هذا العالم

20
00:01:01,430 --> 00:01:06,040
...أصل وتكوين هذا العالم والقوانين الّتي تحكمه

21
00:01:06,040 --> 00:01:08,040
السّحر يكشف هذه الأشياء لنا

22
00:01:08,040 --> 00:01:13,500
كما يجيب عن السّؤال الأبديّ حول
.سبب وجودنا في هذا العالم

23
00:01:13,500 --> 00:01:18,510
إنّه الوسيلة الّتي تمكّن البشريّة من اكتشاف
.سبيلٍ إلى مستوى أعظم من الوجود

24
00:01:18,810 --> 00:01:22,400
.لهذا السّببِ السّحرُ عظيم ونبيل

25
00:01:22,400 --> 00:01:24,220
وما الفائدة من هذا؟

26
00:01:25,080 --> 00:01:29,810
كيف لدراسة مبادئ هذا العالم أن توفّر شيئًا مفيدًا؟

27
00:01:30,140 --> 00:01:33,580
كما أخبرتك، إنّه يساعدنا على
—التّقرّب من مستوى أعلى

28
00:01:33,580 --> 00:01:36,070
وماذا يوجد في مستوى أعلى من الوجود؟

29
00:01:36,360 --> 00:01:37,320
الآلهة؟

30
00:01:38,120 --> 00:01:39,690
...حسنٌ

31
00:01:39,690 --> 00:01:43,700
أيّ فائدة يعود السّحر بها للبشريّة على أيّ حال؟

32
00:01:44,360 --> 00:01:47,840
الطبّ مثلاً، هذا المجال يساعد
.على إنقاذ البشريّة من الأمراض

33
00:01:47,840 --> 00:01:49,960
،هناك الكثير من المجالات الّتي تفيد البشريّة

34
00:01:50,310 --> 00:01:52,810
.كالعلوم الزّراعيّة والهندسة المعماريّة

35
00:01:52,810 --> 00:01:57,630
لكن هل أنا أتصوّر وحسب، أم أنّ
السّحر لا يقدّم أيّ فائدة على الإطلاق؟

36
00:01:59,990 --> 00:02:06,350
.السّحر ليس مجالاً متدنيًّا حول إفادة البشريّة

37
00:02:06,350 --> 00:02:09,850
بل هو بقصد البحث عن الحقيقة الكامنة
.خلف هذا العالم والبشريّة بحدّ ذاتهما

38
00:02:08,910 --> 00:02:10,460
.آسف بشأن هذا

39
00:02:10,460 --> 00:02:11,730
.لقد كذبت

40
00:02:12,820 --> 00:02:15,730
...السّحر مفيدٌ بشكلٍ لا يصدّق

41
00:02:15,730 --> 00:02:17,240
.لأجل قتل النّاس

42
00:02:21,770 --> 00:02:24,750
،اسمعي، كما يستطيع السّيف أن يقتل شخصًا واحدًا

43
00:02:24,750 --> 00:02:27,440
.فالسّحر يستطيع قتل عشرة أشخاص

44
00:02:27,440 --> 00:02:30,640
.ما من مجالٍ آخر يتفوّق عليه في قتل النّاس

45
00:02:30,640 --> 00:02:31,500
!كفّ عن المزاح

46
00:02:31,500 --> 00:02:35,690
سواء الآن أو في الماضي، فللسّحر
.علاقة لا تُنسى مع القتل

47
00:02:35,690 --> 00:02:36,560
!لا

48
00:02:36,560 --> 00:02:40,840
.السّحر مجالٌ عديم النّفع تطوّر مع قتل النّاس

49
00:02:40,840 --> 00:02:42,640
!السّحر ليس لهذا الغرض

50
00:02:42,640 --> 00:02:45,260
.صدقًا لا أفهم ما يفكّر به أغلبيّتكم

51
00:02:45,260 --> 00:02:50,350
دراسة هذا المجال الّذي يفيد
...في قتل النّاس وحسب

52
00:02:50,350 --> 00:02:54,020
بدلاً من تكريس حياتكم الطّائشة
—لأجل هذا، حريٌّ بكم أن

53
00:03:02,470 --> 00:03:03,410
...أيّتها الـ

54
00:03:09,700 --> 00:03:10,860
!أكرهك

55
00:03:10,860 --> 00:03:12,060
!سيستي

56
00:03:19,120 --> 00:03:22,800
ما الهراء الّذي يجعل السّحر عظيمًا؟

57
00:03:22,800 --> 00:03:24,090
.تلك الشقية

58
00:03:26,370 --> 00:03:27,100
...لا

59
00:03:29,600 --> 00:03:31,600
.أنا من تصرّفت بصبيانيّة

60
00:03:32,100 --> 00:03:35,640
.حسنًا، لقد اكتفيتُ من هذا العمل

61
00:03:35,640 --> 00:03:37,630
.سأتدرّب على التّذلّل حالما أصل إلى المنزل

62
00:03:37,630 --> 00:03:40,780
،إن اعتذرتُ بشدّةٍ كفايةً
.يجدر بسيليكا أن تسامحني

63
00:03:44,760 --> 00:03:47,240
ما الّذي تفعله؟

64
00:03:48,480 --> 00:03:50,970
دائرة سحريّة؟

65
00:03:52,390 --> 00:03:54,410
أليس هذا غريبًا؟

66
00:03:55,190 --> 00:03:58,390
.الاستعمال الشّخصيّ لهذا المختبر ممنوعٌ كما تعلمين

67
00:03:58,390 --> 00:03:59,870
!معلّم غلين

68
00:03:59,870 --> 00:04:03,680
أنا آسفة، إنّما أردتُ أن أراجع كيفيّة
.إنشاء الدّوائر السّحريّة

69
00:04:03,960 --> 00:04:05,500
.سأنظّف المكان على الفور

70
00:04:05,500 --> 00:04:06,360
.لا بأس

71
00:04:06,360 --> 00:04:08,160
.أكملي ما بدأتِ به

72
00:04:08,160 --> 00:04:10,410
.فهو لا يسير على ما يرام

73
00:04:10,410 --> 00:04:11,520
.غبيّة

74
00:04:11,520 --> 00:04:13,230
.ينقصكِ الزّئبق فقط

75
00:04:13,230 --> 00:04:13,640
ماذا؟

76
00:04:13,960 --> 00:04:18,910
تنفعلون جميعكم بسرعة حول
،الأشياء الّتي لا تستطيعون رؤيتها

77
00:04:18,910 --> 00:04:21,900
،لكن ولأيّ سببٍ كان
.فأنتم لا تبصرون ما هو أمامكم

78
00:04:22,980 --> 00:04:26,280
وهذا دليلٌ أنّكم تتّخذون الأمر
.بشكلٍ مقدّس أكثر من اللاّزم

79
00:04:27,680 --> 00:04:30,030
.حسنًا. حاولي تفعيلها مجدّدًا

80
00:04:30,030 --> 00:04:31,880
،باستخدام خمس عبارات
.كما هو مذكور في مرجعك

81
00:04:31,880 --> 00:04:32,970
.لا تختزليها

82
00:04:32,970 --> 00:04:33,660
.حاضرة

83
00:04:35,170 --> 00:04:38,170
.حلقة، حلقة، يا أصل الحياة

84
00:04:38,440 --> 00:04:41,420
.شكّلي مسارك حول دائرة الحقيقة

85
00:04:55,380 --> 00:04:58,650
.لم أرَ دائرةً بهذا الجمال من قبل

86
00:04:58,650 --> 00:05:01,900
.لا تكوني غبيّة. أيّ أحد يستطيع فعل هذا

87
00:05:01,900 --> 00:05:04,440
.كما أنّك أنجزت أغلب العمل

88
00:05:10,370 --> 00:05:12,600
أرأيت؟ مذهل، أليس كذلك؟

89
00:05:20,710 --> 00:05:24,620
معلّم غلين، أنت تحبّ السّحر
في الواقع، أليس كذلك؟

90
00:05:24,620 --> 00:05:25,880
ولِمَ تظنّين هذا؟

91
00:05:26,380 --> 00:05:28,910
.لأنّك كنت تستمتع للتّوّ

92
00:05:29,620 --> 00:05:32,840
.محال. أكره السّحر

93
00:05:33,670 --> 00:05:34,850
هكذا إذًا؟

94
00:05:36,050 --> 00:05:40,040
ماذا كنت تفعل قبل أن تصبح معلّمًا هنا؟

95
00:05:40,040 --> 00:05:42,630
!لقد كنتُ مجرّد مستغلٍّ منعزل

96
00:05:43,300 --> 00:05:45,530
ماذا؟ منعزل؟ مستغِلّ؟

97
00:05:45,870 --> 00:05:49,500
هنالك امرأة مغرورة في الأكاديميّة
تدعى سيليكا، صحيح؟

98
00:05:49,990 --> 00:05:52,740
.لقد كنتُ أتّكل عليها في العام السّابق

99
00:05:53,300 --> 00:05:54,590
العام السّابق؟

100
00:05:54,590 --> 00:05:55,750
ماذا كنت تفعل قبل ذلك؟

101
00:05:58,660 --> 00:06:00,220
.يكفي، يكفي

102
00:06:00,220 --> 00:06:02,680
.يكفيك بحثًا في ماضيّ

103
00:06:02,680 --> 00:06:04,460
.حان دوري لأطرح الأسئلة

104
00:06:05,140 --> 00:06:08,880
لِمَ أنتم ثائرون بالسّحر؟

105
00:06:08,880 --> 00:06:11,540
أنتم تأخذون شيئًا غبيًّا كالسّحر
.على محمل الجدّ كثيرًا

106
00:06:12,500 --> 00:06:18,410
.أريد أن أجعل السّحر مفيدًا للبشريّة بمعنى حقيقيّ

107
00:06:19,230 --> 00:06:22,330
.ولتحقيق تلك الغايات، عليّ الآن أن أفهم السّحر أكثر

108
00:06:25,240 --> 00:06:27,370
.يجب أن أسدّد ديني لأحدهم

109
00:06:28,490 --> 00:06:29,880
ماذا تقصدين؟

110
00:06:31,160 --> 00:06:35,130
،قبال ثلاث سنوات، عندما نُفيت من الدّيار

111
00:06:35,130 --> 00:06:37,880
،عندما كنتُ على وشك أن أبدأ العيش مع سيستي

112
00:06:38,520 --> 00:06:42,500
.قُبضَ عليّ من قبل سحرةٍ أشرار وكدتُ أُقتل

113
00:06:43,600 --> 00:06:48,760
.حينها أتى ساحر عدالة لإنقاذي

114
00:06:50,290 --> 00:06:53,270
.لقد تخلّص من السّحرة الأشرار الواحد تلو الآخر

115
00:06:57,680 --> 00:06:59,290
.لقد كنتُ مرتعبة

116
00:07:01,220 --> 00:07:04,920
لكن بعد أن أنقذ ذلك الرّجل
...حياتي، أدركت أنّي

117
00:07:04,920 --> 00:07:10,180
،أريد أن أكون في وضعٍ يمكنّني من قيادة البشريّة
.حتّى لا تفقد سبيلها مع السّحر

118
00:07:12,320 --> 00:07:15,740
ولأجل تحقيق ذلك، يجب أن أفهم
.السّحر بشكلٍ أفضل

119
00:07:16,420 --> 00:07:18,780
،وإن سرتُ على ذلك الطّريق

120
00:07:21,880 --> 00:07:25,940
.لربّما أستطيع أن أشكره يومًا ما

121
00:07:26,980 --> 00:07:34,010
،عندما كنتُ أبكي وحيدةً في الظّلام
...وهبني ذلك الرّجل النّور

122
00:07:34,820 --> 00:07:36,010
...هل أنت

123
00:07:36,400 --> 00:07:37,670
ماذا؟

124
00:07:40,930 --> 00:07:43,020
.لا، انسي الأمر

125
00:07:48,830 --> 00:07:53,430
وأيضًا يا معلّم، أرجو منكَ
.أن تعتذر من سيستي لاحقًا

126
00:07:54,640 --> 00:08:00,540
.إنّها تشعر برابطة مع جدّها الرّاحل من خلال السّحر

127
00:08:01,050 --> 00:08:02,820
.لذا فهو مهمّ لها

128
00:08:05,280 --> 00:08:06,470
.خطوة واحدة

129
00:08:06,960 --> 00:08:08,960
...أتمنّى لو أنّي أستطيع أن أخطو

130
00:08:09,300 --> 00:08:14,660
.ولو خطوة واحدة في قلعة السّماء ميلغاليوس

131
00:08:16,370 --> 00:08:22,160
.لقد أصبحتُ ساحرًا لأجل ذلك السّبب لا غير

132
00:08:22,160 --> 00:08:24,020
!سأفعلها

133
00:08:24,020 --> 00:08:27,520
،سأصبح ساحرةً أفضل منك

134
00:08:28,110 --> 00:08:31,530
!وسأكشف أسرار قلعة السّماء ميلغاليوس

135
00:08:46,000 --> 00:08:47,880
.أنا آسف بشأن البارحة

136
00:08:47,880 --> 00:08:48,840
ماذا؟

137
00:08:49,590 --> 00:08:55,550
.ربّما أكره السّحر، لكن مع ذلك... بالغتُ كثيرًا

138
00:08:55,550 --> 00:08:58,600
.على كلّ حال، أنا آسف

139
00:08:59,050 --> 00:09:00,780
.حسنًا، حان الوقت لبدء الحصّة

140
00:09:03,270 --> 00:09:06,310
.لكن قبل ذلك، يجب أن أخبركم بشيء

141
00:09:06,980 --> 00:09:09,650
.أنتم أغبياء حقًّا

142
00:09:09,650 --> 00:09:11,400
!ماذا؟

143
00:09:11,400 --> 00:09:14,240
.لقد أدركتُ شيئًا بينما أراقبكم وأنتم تحضرون للقسم

144
00:09:14,240 --> 00:09:17,910
.لا تفقهون شيئًا عن السّحر

145
00:09:17,090 --> 00:09:17,910
!انظروا من يتكلّم

146
00:09:17,330 --> 00:09:18,170
!ماذا؟

147
00:09:17,910 --> 00:09:20,570
لا أريد أن أسمع هذا من ساحرٍ من الدّرجة الثّالثة

148
00:09:18,170 --> 00:09:19,470
!هذه غلطتك

149
00:09:19,470 --> 00:09:20,120
!تبًّا لك

150
00:09:20,120 --> 00:09:21,080
!هذا فظيع

151
00:09:20,570 --> 00:09:22,910
لا يستطيع حتّى أن يرتّل شيئًا
.سهلاً كصاعقة الصّدمة في سطرٍ واحد

152
00:09:22,910 --> 00:09:26,430
.صراحةً، أنت تحرجني بقولك هذا

153
00:09:26,430 --> 00:09:31,000
لا أملك أيّ فهمٍ للتّلاعب بقوى
.الطّبيعة أو اختزال التّراتيل

154
00:09:31,000 --> 00:09:34,480
لكن أقلت "سهلاً كصاعقة الصّدمة"؟

155
00:09:34,480 --> 00:09:36,090
.أنتم أغبياء فعلاً

156
00:09:36,090 --> 00:09:37,360
!ماذا؟

157
00:09:37,360 --> 00:09:41,020
.إذًا سأعلّمكم اليوم صاعقة الصّدمة تلك

158
00:09:41,590 --> 00:09:43,140
:التّرتيل الأساسيّ هو

159
00:09:43,510 --> 00:09:47,580
".يا أرواح الرّعد، أصغي إليّ واضربي بصدمتك الكهربائيّة"

160
00:09:48,980 --> 00:09:51,080
.عرفتُ أنّه سيستخدم ترتيلةً بثلاثة أسطر

161
00:09:51,080 --> 00:09:53,900
.لقد أتقنّا صاعقة الصّدمة قبل وقتٍ طويل

162
00:09:53,900 --> 00:09:57,930
وكما تعلمون جميعًا، بالنّسبة لمن يفهم
،تمامًا التّلاعب بالقوى الطّبيعيّة

163
00:09:57,930 --> 00:10:01,000
".بوسعكم أن تختزلوها إلى "يا أرواح الرّعد، صدمة

164
00:10:01,000 --> 00:10:01,910
،لكن ها هو سؤالكم

165
00:10:03,680 --> 00:10:07,930
".يا أرواح الرّعد، أصغي إليّ واضربي بصدمتك الكهربائيّة"

166
00:10:07,930 --> 00:10:11,710
ماذا سيحصل إن رتّلتم هذه التّرتيلة بأربعة أسطر؟

167
00:10:12,440 --> 00:10:14,960
.ما كانت تلك التّرتيلة لتعمل كما يجب

168
00:10:15,320 --> 00:10:18,030
.ستفشل بطريقةٍ أو بأخرى

169
00:10:18,030 --> 00:10:19,800
.أعلم ذلك أيّها الغبيّ

170
00:10:20,420 --> 00:10:23,890
.بل أسألك ما الشّكل الّذي سيتّخذه ذلك الفشل

171
00:10:24,160 --> 00:10:26,480
!من الواضح أنه سيكون عشوائيًّا

172
00:10:26,480 --> 00:10:30,500
ماذا؟ ظننتُ أنّكم أتقنتم هذا؟

173
00:10:30,980 --> 00:10:33,320
ماذا؟ هل انتهيتم جميعًا؟

174
00:10:33,320 --> 00:10:35,480
...حسنًا إذًا. الجواب هو

175
00:10:36,080 --> 00:10:37,690
.ستنعطف إلى اليمين

176
00:10:39,060 --> 00:10:44,250
،يا أرواح الرّعد، أصغي إليّ، واضربي
.بصدمتك الكهربائيّة

177
00:10:50,750 --> 00:10:51,580
!محال

178
00:10:51,580 --> 00:10:52,500
!هذا مستحيل

179
00:10:52,500 --> 00:10:55,750
،بالمناسبة، إن رتّلتموها بخمسة أسطر هكذا

180
00:10:56,370 --> 00:10:57,670
.ينقص مدى الإطلاق

181
00:10:57,670 --> 00:10:59,260
،وإن حذفتم جزءًا واحدًا

182
00:10:59,260 --> 00:11:01,550
.حينها يضعف نتاجها

183
00:11:01,550 --> 00:11:05,560
إن كنتم تدّعون أنّكم أتقنتموها، فيجدر
.بكم أن تكونوا قادرين على فعل هذا

184
00:11:06,200 --> 00:11:10,970
اسمعوا، السّحر باختصار مجرّد شكلٍ
.متقدّم من الإيحاء الذّاتيّ

185
00:11:10,970 --> 00:11:13,550
اللّغة الرّونية الّتي نستخدمها عند ترتيل التّعاويذ

186
00:11:13,550 --> 00:11:21,760
وإعادة تأليف اللاّوعي البشريّ
.بغرض التّدخّل بمبادئ هذا العالم

187
00:11:21,760 --> 00:11:26,400
قد تقولون جميعًا أنّ السّحر
،هو دراسة مبادئ هذا العالم

188
00:11:26,400 --> 00:11:27,990
.لكنّكم مخطئون

189
00:11:28,410 --> 00:11:32,000
.السّحر هو تقصّي العقل البشريّ

190
00:11:32,600 --> 00:11:37,660
يبدو أنّكم جميعًا ترفضون تصديق أنّ هذه
.الكلمات فقط قد تحمل مثل هذه القوّة

191
00:11:37,660 --> 00:11:38,880
...في تلك الحالة

192
00:11:38,880 --> 00:11:40,220
.أيّتها القطّة البيضاء

193
00:11:40,220 --> 00:11:41,340
!قطّة بيضاء؟

194
00:11:41,340 --> 00:11:43,320
هل تدعوني بالقطّة البيضاء؟

195
00:11:43,320 --> 00:11:45,530
—لديّ اسمٌ لائق، سيستين

196
00:11:45,530 --> 00:11:46,490
.أحبّك

197
00:11:46,490 --> 00:11:49,270
.وقعتُ في حبّك من أوّل نظرة

198
00:11:50,020 --> 00:11:51,480
!حسنًا، انتبهوا

199
00:11:51,480 --> 00:11:53,900
!لقد احمّر وجه القطّة البيضاء خجلاً الآن

200
00:11:53,900 --> 00:11:58,280
هذا عرض مذهل يظهر كيف
.أنّ كلماتٍ فقط أثّرت على عقلها

201
00:11:58,280 --> 00:12:00,830
...التّأثير على العالم من خلال استخدام اللّغة

202
00:12:00,830 --> 00:12:02,600
—ذلك هو أساس السّحـ

203
00:12:02,600 --> 00:12:04,360
!أيّتها الغبيّة! لا ترمي مرجعك

204
00:12:04,360 --> 00:12:05,800
!أنت الغبيّ

205
00:12:05,800 --> 00:12:07,700
!أيّها الغبيّ، الغبيّ، الغبيّ

206
00:12:07,700 --> 00:12:09,700
...على أيّ حال

207
00:12:09,700 --> 00:12:13,080
،لدى السّحر شيءٌ مماثل للنّحو والإعراب

208
00:12:13,080 --> 00:12:17,550
ممّا يساعده على إعادة تشكيل اللاّوعي
.خاصّتكم بالطّريقة الّتي تريدون

209
00:12:17,550 --> 00:12:20,090
...فور أن تعلموا ذلك، فعلى سبيل المثال

210
00:12:20,430 --> 00:12:23,080
.حسنٌ، لا يهمّ، شلل

211
00:12:26,090 --> 00:12:29,240
.ماذا؟ كان ذلك أضعف مما توقّعت

212
00:12:29,240 --> 00:12:32,100
.حينهما ستستطيعون تعديله بهذا الشّكل

213
00:12:32,100 --> 00:12:33,290
!مستحيل

214
00:12:33,290 --> 00:12:35,600
أيمكنه تفعيلها بمثل هذه التّرتيلة الفاترة؟

215
00:12:35,600 --> 00:12:39,850
".كلمات مفتاحيّة لتفعيل التّعويذة المغروسة بلاوعيكم"

216
00:12:39,850 --> 00:12:41,840
.تلك هي التّرتيلة

217
00:12:41,840 --> 00:12:43,610
.باختصار، إنّها مجرّد لعبة ترابط

218
00:12:43,920 --> 00:12:48,360
على سبيل المثال، ما أوّل شيء تفكّرون
به عندما تسمعون اسم القطّة البيضاء؟

219
00:12:48,360 --> 00:12:49,020
.قطّة

220
00:12:48,560 --> 00:12:49,600
.قطّة، أجل

221
00:12:49,600 --> 00:12:51,120
.تعمل التّرتيلات والتّعويذات بنفس الطّريقة

222
00:12:51,440 --> 00:12:55,660
فور أن تعلموا ذلك، فالتّعديل
.على التّرتيلات ليس بالشّيء الصّعب

223
00:12:58,600 --> 00:13:03,920
بهذا المرجع التافه كما لو أنّكم
...مطالبون بحفظها وحسب

224
00:13:03,920 --> 00:13:09,910
"تلك هي الحصص والدّراسات "سهلة التّعلّم
.الّتي كنتم ترتادونها حتّى الآن

225
00:13:10,900 --> 00:13:12,010
.يا للغباء

226
00:13:13,980 --> 00:13:18,990
حاليًّا، جميعكم مستعملو سحر
.يمكنهم استخدام التّرتيلات

227
00:13:18,990 --> 00:13:23,490
أمّا إن كنتم تريدون أن تعتبروا أنفسكم
.سحرة، فعليكم أن تفكّروا مليًّا فيما ينقصكم

228
00:13:23,910 --> 00:13:27,240
.والآن، سأعلّمكم أساس الأساسيّات

229
00:13:27,240 --> 00:13:29,420
.من غير مهتمّ، يستطيع أن ينام

230
00:13:33,010 --> 00:13:35,260
!كنت أعلم من البداية

231
00:13:35,260 --> 00:13:37,330
!بوسعه أن ينجح إن عزم على ذلك

232
00:13:37,320 --> 00:13:41,950
لقد أصبح قسمه ذا شعبية حتّى أنّ التّلاميذ
.الآخرين يتوقّفون عنده للمشاهدة

233
00:13:37,840 --> 00:13:41,950
.لطالما ظننتُ أنّ موهبته تكمن في تعليم الآخرين

234
00:13:41,950 --> 00:13:45,040
ذلك لأنّه تلميذي الّذي أفتخر به
!والّذي علّمته من الصّفر

235
00:13:45,040 --> 00:13:45,840
ماذا؟

236
00:13:45,840 --> 00:13:50,860
إنّه الوحيد الّذي قد أختاره بينما
.لا أتّخذ أيّ تلاميذ آخرين

237
00:13:46,310 --> 00:13:50,330
!عليك اللّعنة يا غلين ريدارس
!ستُطرد من هذه الأكاديميّة يومًا ما

238
00:13:51,680 --> 00:13:53,920
،وعلى عكس السّحر العامّ

239
00:13:53,920 --> 00:13:58,540
تميلون جميعكم لرؤية السّحر الفريد
.والأصليّ على أنّه مقدّس

240
00:13:58,540 --> 00:14:02,510
.بيد أنّ صنعه ليس بالأمر الجلل

241
00:14:02,510 --> 00:14:04,570
إذًا ما هو التّحدّي في هذا؟

242
00:14:04,890 --> 00:14:11,850
حقيقة أنّكم يجب أن تتجاوزوا السّحر العامّ
.الّذي يتّصف بالكمال من شكلٍ معيّن

243
00:14:12,630 --> 00:14:15,020
.وإلاّ ليس هنالك من فائدة من استخدامه

244
00:14:21,110 --> 00:14:22,500
...في الواقع

245
00:14:32,180 --> 00:14:34,220
.هذا ليس سيّئًا

246
00:14:34,220 --> 00:14:37,980
.ليتك ترى نفسك، متأمّلاً بالشّفق

247
00:14:38,380 --> 00:14:39,960
.وتستمتع بذلك الشّباب

248
00:14:39,960 --> 00:14:41,440
ماذا تقصدين؟

249
00:14:41,440 --> 00:14:46,230
.إنّما ظننت أنّك انتعشتَ بعض الشّيء مؤخرًا

250
00:14:46,230 --> 00:14:50,680
،بينما كنتَ تبدو في السّابق كسمكة ميّتة منذ شهر

251
00:14:50,680 --> 00:14:53,980
.بيد أنّك الآن تبدو كسمكة ميتة منذ يوم

252
00:14:53,980 --> 00:14:55,140
.أنت

253
00:14:57,960 --> 00:15:02,000
.آسفٌ على إقلاقك

254
00:15:04,450 --> 00:15:07,790
عليّ أن أتعامل مع اجتماع أكاديميّة
،السّحر بدءًا من الغد

255
00:15:07,790 --> 00:15:13,420
،لكن بما أنّ قسمك متأخّر بعد رحيل هيوي
فستقدّم حِصصًا تكميليّة، صحيح؟

256
00:15:14,000 --> 00:15:17,920
لا تقم بأيّ مقالب غريبة على تلميذاتك
.فقط لأنّ الجميع خرجوا في استراحة

257
00:15:17,920 --> 00:15:19,060
!وكأني سأفعل

258
00:15:19,060 --> 00:15:21,920
،وأيضًا، بعد أن اعتدتُ على رؤية امرأةٍ مثلك

259
00:15:21,920 --> 00:15:24,270
فكيف لي أن أهتمّ بنساء عاديّات؟

260
00:15:24,270 --> 00:15:27,800
أكنت تنظر لي بتلك الطّريقة أيّها المنحرف؟

261
00:15:27,800 --> 00:15:29,080
!بالطّبع لا

262
00:15:29,080 --> 00:15:29,930
!ابتعدي

263
00:15:29,930 --> 00:15:31,300
!لا تدسّي نهديك بي

264
00:15:31,750 --> 00:15:33,210
.لستَ ممتعًا

265
00:15:33,210 --> 00:15:34,660
!معلّم

266
00:15:35,000 --> 00:15:36,910
.الأستاذة أرفونيا

267
00:15:36,910 --> 00:15:38,910
ماذا هناك؟ أتحتاجين غلين لغرضٍ ما؟

268
00:15:38,910 --> 00:15:41,500
.نعم! هناك ما أريد أن أسألك عنه

269
00:15:41,500 --> 00:15:43,500
.حسنًا إذًا

270
00:15:43,500 --> 00:15:48,490
أظنّ أنّ الأستاذ العظيم غلين ريدارس
.سيسدي النّصيحة لتلامذته المساكين

271
00:15:48,490 --> 00:15:51,260
!لهذا أنت آخر شخصٍ أردتُ أن أسأله

272
00:15:54,610 --> 00:15:57,820
.لقد كان شرحه سهلاً جدًّا للفهم

273
00:15:57,820 --> 00:16:02,330
،إنّه مدهش كمعلّمٍ سحريّ
.لكنّه ما يزال نذلاً

274
00:16:03,190 --> 00:16:04,270
،أخبريني يا سيستي

275
00:16:04,930 --> 00:16:08,490
أتذكرين عندما أتينا لهذا المنزل أوّل مرّة؟

276
00:16:08,490 --> 00:16:10,120
ما هذا فجأةً؟

277
00:16:10,840 --> 00:16:15,330
لم نستطع أن ننسجم جيّدًا في البداية، صحيح؟

278
00:16:15,330 --> 00:16:16,660
...حسنٌ

279
00:16:18,000 --> 00:16:21,160
.لكنّنا صديقتان صدوقتان الآن

280
00:16:22,770 --> 00:16:25,920
...لذا أنا واثقة أنّك والمعلّم غلين سوف

281
00:16:25,920 --> 00:16:27,270
!لن يحدث

282
00:16:27,750 --> 00:16:29,000
.أنتِ خجولة جدًّا

283
00:16:31,940 --> 00:16:33,980
هل تسير الخطّة بسلاسة؟

284
00:16:33,980 --> 00:16:34,930
.نعم

285
00:16:35,410 --> 00:16:39,560
لكن هناك ذلك الرّجل، غلين
...الّذي أدخلته سيليكا أرفونيا

286
00:16:39,560 --> 00:16:41,450
.إنّه مجرد ساحر من الدّرجة الثّالثة

287
00:16:41,450 --> 00:16:43,440
.لا يشكلّ تهديدًا لنا

288
00:16:43,790 --> 00:16:47,130
.تابع وفق المقرّر، في بداية اجتماع أكاديميّة السّحر

289
00:16:47,130 --> 00:16:49,670
.إذًا سأدعو لنجاح الخطّة

290
00:16:50,470 --> 00:16:52,680
.المجد للحكمة الإلهيّة

291
00:16:58,450 --> 00:17:00,950
!تأخّرت! لقد تأخّرت

292
00:17:09,210 --> 00:17:10,350
.اخرج

293
00:17:10,350 --> 00:17:12,210
.من الواضح أنّك هناك

294
00:17:13,170 --> 00:17:16,060
،لقد كان حاجزًا سريعًا لتحاشي النّاس

295
00:17:16,060 --> 00:17:20,470
.لكنّك حاذق جدًّا بالنّسبة لساحر من الدّرجة الثّالثة

296
00:17:20,850 --> 00:17:23,160
ومن تكون أنت؟

297
00:17:23,160 --> 00:17:24,350
.أنا في عجلة من أمري

298
00:17:24,640 --> 00:17:26,350
.لا داعي لذلك

299
00:17:26,350 --> 00:17:29,360
!لأنّ وجهتك القادمة هي الحياة الأخرى

300
00:17:29,860 --> 00:17:32,150
!فساد، تفاقم

301
00:17:35,990 --> 00:17:38,990
.لقد كان ذا شعبية حقًّا مؤخرًا

302
00:17:38,990 --> 00:17:40,160
ماذا؟

303
00:17:40,160 --> 00:17:43,260
أنت تشعرين بالوحدة بما
.أنّ شعبيّة المعلّم أخذت تكبر

304
00:17:43,260 --> 00:17:45,920
—ماذا تقولين؟ أنا لست

305
00:17:47,120 --> 00:17:49,000
!مرحبًا

306
00:17:49,000 --> 00:17:50,250
!معذرةً

307
00:17:51,530 --> 00:17:53,960
!من أنتما؟

308
00:17:54,280 --> 00:17:57,880
.معلّمكم مشغول، لذا أتينا بدلاً منه

309
00:17:57,880 --> 00:17:58,970
!كفّ عن العبث

310
00:17:59,260 --> 00:18:01,560
!ممنوع وجود الغرباء هنا

311
00:18:01,560 --> 00:18:03,430
—إن لم تغادرا على الفور، فسأستدعي الأمـ

312
00:18:03,430 --> 00:18:04,350
.انفجار

313
00:18:11,410 --> 00:18:12,860
سحر من الدّرجة العسكريّة؟

314
00:18:12,860 --> 00:18:15,610
.إن تحدّيتنا مجدّدًا، فسأقتلك

315
00:18:17,400 --> 00:18:20,870
.نحن الاثنان نبحث عن فتاة تدعى روميا-تشان

316
00:18:24,470 --> 00:18:28,440
.ماذا؟ يفترض أن تكون في هذا القسم

317
00:18:28,440 --> 00:18:30,040
ربّما أنت هي روميا-تشان؟

318
00:18:30,040 --> 00:18:31,500
.لـ-لستُ أنا

319
00:18:31,500 --> 00:18:33,800
إذًا أتعرفين من تكون روميا-تشان؟

320
00:18:34,060 --> 00:18:35,170
.كلاّ

321
00:18:35,170 --> 00:18:38,740
.حقًّا؟ أكره الكاذبين

322
00:18:39,350 --> 00:18:43,160
ماذا تنويان فعله بروميا؟

323
00:18:43,160 --> 00:18:44,560
هل تعرفين روميا-تشان؟

324
00:18:44,920 --> 00:18:46,560
.أجب عن سؤالي

325
00:18:48,220 --> 00:18:49,230
.أنت ثرثارة

326
00:18:49,980 --> 00:18:50,440
—انفـ

327
00:18:50,440 --> 00:18:51,900
.أنا روميا

328
00:19:01,280 --> 00:19:03,510
إذًا أنت روميا-تشان؟

329
00:19:03,510 --> 00:19:05,450
.نعم، لقد كنّا نعرف في الواقع

330
00:19:05,450 --> 00:19:10,180
إنّما كنتُ ألعب لعبةً حيث نقتل أشخاصًا
.عشوائيّين إلى أن تكشفي عن نفسك

331
00:19:11,860 --> 00:19:14,040
.يكفي عبثًا

332
00:19:14,040 --> 00:19:15,000
.نعم، نعم

333
00:19:15,330 --> 00:19:16,060
.تعالي

334
00:19:16,770 --> 00:19:17,710
.لا يمكنك ذلك يا روميا

335
00:19:17,710 --> 00:19:22,060
لا بأس. أنا واثقة أنّ المعلّم غلين
.سيأتي لإنقاذ الجميع

336
00:19:22,060 --> 00:19:24,850
.ذاك المعلّم؟ لقد قتلناه سلفًا

337
00:19:24,850 --> 00:19:25,600
.كذب

338
00:19:25,600 --> 00:19:27,100
...مستحيل

339
00:19:28,580 --> 00:19:29,600
.تعالي الآن

340
00:19:35,080 --> 00:19:36,640
ما هدفكما؟

341
00:19:36,640 --> 00:19:37,740
ولماذا تريدانني؟

342
00:19:37,740 --> 00:19:41,600
...يجب أن تعرفي بما يكفي يا روميا تينغل

343
00:19:41,600 --> 00:19:43,880
.لا بالأحرى، أيتها الأميرة إرميانا

344
00:19:44,690 --> 00:19:47,850
.لا يفترض بك أن تكوني على قيد الحياة

345
00:19:47,850 --> 00:19:50,120
،إلاّ أنّك تظلّين بينما يجدر بك أن ترحلي

346
00:19:50,530 --> 00:19:53,370
.ممّا يجعل منكِ أهلاً للاستغلال

347
00:19:55,250 --> 00:19:57,240
،بما أنّك فتاةٌ جميلة

348
00:19:57,240 --> 00:19:59,550
.فستكون خسارةً ألاّ أستمتع بك

349
00:19:59,840 --> 00:20:02,380
!أنا ابنة عائلة فيبيل الفخورة

350
00:20:02,380 --> 00:20:04,050
وماذا إذًا؟ هل أنت شخصيّة هامّة؟

351
00:20:04,380 --> 00:20:08,960
لأصدقك القول، لا أجد متعةً في إجبار
.نفسي على فتياتٍ مثل روميا

352
00:20:08,960 --> 00:20:13,020
قد تكون ضعيفة، لكنّها من النّوع
.الّذي يأبى عقلها أن يخضع

353
00:20:13,290 --> 00:20:14,730
...بينما أنت

354
00:20:15,080 --> 00:20:16,840
،ربما تدّعين الصّلابة

355
00:20:16,840 --> 00:20:20,740
.لكنّك مجرّد صبيّة تخفي ضعفها خلف قناع

356
00:20:20,740 --> 00:20:25,240
أستمتع بكسر الفتيات الضّعيفات
!أمثالك أكثر من أيّ شيء

357
00:20:25,240 --> 00:20:27,740
!تبًّا لك! هل تظنّ أنّني سأستسلم لك؟

358
00:20:33,410 --> 00:20:34,000
ماذا؟

359
00:20:46,420 --> 00:20:48,690
!بشرتك جميلة جدًّا

360
00:20:48,690 --> 00:20:51,480
...هذا

361
00:20:51,480 --> 00:20:52,760
ماذا؟

362
00:20:53,590 --> 00:20:55,800
.توقّف أرجوك

363
00:20:56,210 --> 00:20:57,400
.أرجوك

364
00:20:58,470 --> 00:21:00,490
!لقد هويت بسهولة

365
00:21:00,490 --> 00:21:01,730
!أنت الأفضل

366
00:21:02,080 --> 00:21:04,240
!لا، فلينقذني أحد

367
00:21:04,240 --> 00:21:06,740
!حان الوقت لأبدأ

368
00:21:11,320 --> 00:21:12,250
ماذا؟

369
00:21:13,010 --> 00:21:14,750
من أنت؟

370
00:21:15,000 --> 00:21:16,330
.آسف على إزعاجكما

371
00:21:16,330 --> 00:21:17,250
!ساعدني

372
00:21:18,720 --> 00:21:20,110
.أنت

373
00:21:20,110 --> 00:21:23,920
،حتّى إن لم تكن ذا شعبيّة تمامًا
.فهذا الشّيء يعدّ جريمة

374
00:21:23,920 --> 00:21:25,510
!لا! اهرب يا معلّم

375
00:21:25,510 --> 00:21:28,860
أساعدك أم أهرب، أيّهما؟

376
00:21:28,860 --> 00:21:30,920
—انس ذلك وأسرع! أنت لستَ ندًّا

377
00:21:30,920 --> 00:21:32,020
!فات الأوان

378
00:21:33,600 --> 00:21:34,520
!انفجار

379
00:21:39,270 --> 00:21:40,910
!انفجار! انفجار

380
00:21:40,910 --> 00:21:42,810
.لن يتفعّل السّحر بعد الآن

381
00:21:44,600 --> 00:21:46,360
أركانا المحتال؟

382
00:21:48,570 --> 00:21:52,570
عن طريق قراءة التّعويذة السّحريّة
.المحوَّلة لهذه البطاقة بصوتٍ عالٍ

383
00:21:52,570 --> 00:21:58,740
بوسعي أن أبطل تفعيل أيّ سحرٍ
.موجود ضمن النّطاق المحيط بي

384
00:22:00,700 --> 00:22:05,670
.تلك هي تعويذتي الأصليّة، عالم المخادع

385
00:22:05,670 --> 00:22:07,500
!تعويذتك الأصليّة؟

386
00:22:07,500 --> 00:22:10,010
!أتقصد أنّك بذلك المستوى؟

387
00:22:10,710 --> 00:22:13,260
!إبطال السّحر؟ سيجعله ذلك منيعًا

388
00:22:13,260 --> 00:22:15,940
.هذا يعني أنّني لا أستطيع تفعيل السّحر أيضًا

389
00:22:16,860 --> 00:22:17,740
!ماذا؟

390
00:22:17,740 --> 00:22:21,350
...ذلك لأنّني ضمن النّطاق المؤثّر أيضًا، لذا

391
00:22:22,340 --> 00:22:25,780
!أنّى لساحرٍ أن يقاتل إن أبطل سحره؟

392
00:22:25,780 --> 00:22:27,100
!أنت غبيّ

393
00:22:27,100 --> 00:22:28,280
!نحن هالكون

394
00:22:28,770 --> 00:22:30,280
—لِمَ لا تسرع و

395
00:22:35,580 --> 00:22:37,380
!...أيّها الـ

396
00:22:50,010 --> 00:22:53,340
!قتال واحد ضد واحد العسكريّ الإمبراطوريّ؟

397
00:22:53,340 --> 00:22:54,850
!من أنت يا هذا؟

398
00:22:56,500 --> 00:22:58,980
.فلين ريدارس، معلّم بديل

399
00:22:59,880 --> 00:23:02,890
!إذًا هل هزمت كاريل؟

400
00:23:03,310 --> 00:23:04,650
!مستحيل

401
00:23:04,650 --> 00:23:07,920
...ليس من قبل ساحرٍ يتحدّى النّاس بقتالٍ باللّكمات

402
00:23:07,920 --> 00:23:09,110
.يا إلهي

403
00:23:09,370 --> 00:23:12,280
،إن كنت تكره أن تخسر بدون سحر بهذا القدر

404
00:23:12,280 --> 00:23:15,240
،فسأقضي عليك بالسّحر الخارق الأسطوريّ

405
00:23:15,240 --> 00:23:17,580
!قبضة السّحر الحديديّة، اللّكمة السّحريّة

406
00:23:18,000 --> 00:23:18,860
!ها أنا ذا

407
00:23:18,860 --> 00:23:26,070
!اللّكمة السّحريّة

408
00:23:32,960 --> 00:23:34,720
!هذه ركلة

409
00:23:35,560 --> 00:23:38,140
!ذلك الجزء الّذي يجعلها سحريّة

410
00:23:45,730 --> 00:23:47,940
،فجأةً، ظهرت منظّمة إرهابيّة في المدرسة

411
00:23:47,940 --> 00:23:49,680
!وهدفهم هو روميا لا غير

412
00:23:49,680 --> 00:23:50,830
!سيستي، أنت لها

413
00:23:50,830 --> 00:23:52,980
—لإنقاذ التّلاميذ، قام معلّمهم الوغد بـ

414
00:23:52,180 --> 00:23:54,200
!لا! بل قلعة السّماء ميلغاليوس

415
00:23:54,200 --> 00:23:59,510
...لإنقاذ التّلاميذ، قام معلّمهم الوغد بـ

416
00:23:55,060 --> 00:23:57,610
!لا يصدق! لِمَ القلعة تحلّق؟

417
00:23:58,720 --> 00:24:00,040
سيستي، هل أنت بخير؟

418
00:24:00,040 --> 00:24:01,920
!عجبًا، ينتابني الفضول

419
00:24:01,920 --> 00:24:02,750
!سيستي

420
00:24:02,750 --> 00:24:04,960
مياو! قلعة السّماء ميلغاليوس

421
00:24:04,960 --> 00:24:08,300
مدينةٌ غامضة حيث يقال أنّ القدماء
،عاشوا فيها قبل قديم الأزمان

422
00:24:08,300 --> 00:24:12,090
!وتحليقها غموضٌ يجهله الجميع

423
00:24:10,670 --> 00:24:13,850
!استمتعوا معنا في الحلقة القادمة