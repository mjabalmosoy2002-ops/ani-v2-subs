1
00:00:02,230 --> 00:00:03,760
!عجبًا

2
00:00:03,760 --> 00:00:06,160
!ها هو القسم 2 يتقدّم مجدّدًا بعد أن كان متخلّفًا

3
00:00:06,160 --> 00:00:09,930
من كان ليتصوّر هذا التّحوّل بالأحداث
!بمنافسة السّحر لهذا العام؟

4
00:00:09,930 --> 00:00:11,900
،المرشّح ذو الإمكانيّة المجهولة لهذا العام

5
00:00:11,900 --> 00:00:13,610
!نجحنا

6
00:00:11,900 --> 00:00:16,230
،القسم 2-2 الّذي يشرف عليه المعلّم غلين
!ما ينفكّ عن تسلّق التّرتيب

7
00:00:17,330 --> 00:00:19,240
.إنّه غلين

8
00:00:19,240 --> 00:00:21,500
.أجل، يبدو كغلين تمامًا

9
00:00:21,990 --> 00:00:25,120
،لقد رحل دون قول أيّ شيء

10
00:00:25,120 --> 00:00:27,000
.وها نحن نجده هنا

11
00:00:29,280 --> 00:00:31,380
ماذا تفعل يا ألبيرت؟

12
00:00:31,660 --> 00:00:33,680
ما الّذي تنوين فعله يا ريل؟

13
00:00:33,680 --> 00:00:35,850
.الذّهاب لأعاقب غلين

14
00:00:36,340 --> 00:00:37,720
.هذا مؤلم

15
00:00:37,720 --> 00:00:39,970
ألا تريد مقابلة غلين يا ألبيرت؟

16
00:00:40,280 --> 00:00:42,810
،ثمّة الكثير ممّا أريد قوله لذلك الرّجل

17
00:00:42,810 --> 00:00:45,400
.لكنّ مهمّتنا تأتي أوّلاً الآن

18
00:00:45,400 --> 00:00:46,300
مهمّة؟

19
00:00:46,850 --> 00:00:52,070
مهمّة مراقبة الحرس الإمبراطوريّ
.المكلّف بحماية جلالة الملكة

20
00:00:52,320 --> 00:00:53,240
لماذا؟

21
00:00:53,240 --> 00:00:54,950
.إنّهم حلفاؤنا

22
00:00:55,350 --> 00:01:00,170
لقد تلقّينا بلاغًا عن أنشطة مشبوهة
.ضمن صفوف الحرس الإمبراطوريّ

23
00:01:00,170 --> 00:01:03,910
هنالك فرصة أنّهم قد يحاولون
.ارتكاب شيءٍ ما ضدّ جلالتها

24
00:01:04,220 --> 00:01:06,000
.ذلك ما يحتاط منه زعماؤنا

25
00:01:06,330 --> 00:01:10,520
.بعبارات أخرى، يجب أن أعاقب غلين

26
00:01:10,520 --> 00:01:11,500
أهذا ما تقصده؟

27
00:02:54,860 --> 00:02:58,230
.تبًّا، يتباهون جميعهم بطعامهم

28
00:02:59,730 --> 00:03:02,650
.أظنّني سأتحاشى جوعي بغُصين شيروتي آخر

29
00:03:02,650 --> 00:03:04,900
معذرةً يا معلّم؟

30
00:03:08,930 --> 00:03:10,270
ماذا هناك يا لين؟

31
00:03:10,270 --> 00:03:13,670
.أنا جاهزٌ لمساعدتكِ في أيّ شيءٍ عدا المال

32
00:03:13,670 --> 00:03:17,390
...بشأن منافستي هذه الظّهيرة

33
00:03:17,390 --> 00:03:19,170
أبوسعي أن أتبادلها مع شخصٍ آخر؟

34
00:03:20,390 --> 00:03:23,360
أنتِ ضمن مسابقة التّحويل، صحيح؟

35
00:03:23,360 --> 00:03:24,260
.نعم

36
00:03:24,260 --> 00:03:29,150
،لقد تدرّبتُ على تعويذة الوهم الذّاتيّ قدر ما استطعت

37
00:03:29,150 --> 00:03:31,020
.لكن لا يمكنني أن أتقنها كما يجب

38
00:03:31,270 --> 00:03:33,530
.إذًا تريدين التّبادل مع أحدهم

39
00:03:33,990 --> 00:03:35,230
لكن ماذا تريدين أن تفعلي؟

40
00:03:35,230 --> 00:03:36,030
ماذا؟

41
00:03:36,030 --> 00:03:38,280
أنتِ ترغبين بالمشاركة، صحيح؟

42
00:03:38,280 --> 00:03:39,940
كما أنّكِ تحبّين سحر التّحويل، أليس كذلك؟

43
00:03:40,200 --> 00:03:41,500
.بـ-بلى، أحبّه

44
00:03:41,500 --> 00:03:45,410
.التّحويل... وكأنّه فرصةٌ لكي أصبح شخصًا آخرًا

45
00:03:46,930 --> 00:03:48,030
.تمرّني إذًا

46
00:03:48,030 --> 00:03:49,160
.لن يشكّل ذلك مشكلة

47
00:03:49,160 --> 00:03:50,620
...لـ-لكن

48
00:03:50,620 --> 00:03:53,800
،الجميع متحمّسون للظّفر بالفوز إلى جانبك

49
00:03:53,800 --> 00:03:55,710
...لذا إن سحبتُ الجميع بفشلي

50
00:03:55,710 --> 00:03:58,410
هذا سببُ انزعاجكِ إذًا؟

51
00:03:58,410 --> 00:04:01,340
.هذه منافسة السّحر. إنّه مهرجان

52
00:04:01,340 --> 00:04:04,560
.ما دمتم تستمتعون تمامًا، فهذا كلّ ما يهمّ

53
00:04:04,560 --> 00:04:05,760
...لـ-لكن

54
00:04:06,290 --> 00:04:09,180
.حسنٌ، سأسديكِ محاضرة خاصّة بعض الشّيء

55
00:04:09,750 --> 00:04:13,610
.أوّلاً، فلنراجع الوهم الذّاتيّ
ما خصائص تلك التّعويذة؟

56
00:04:13,610 --> 00:04:14,890
...ماذا؟ إنّها

57
00:04:14,890 --> 00:04:17,450
إنّها تعويذةٌ من السّحر الأسود تخوّل لك
.أن تغطّي نفسك بوهم

58
00:04:17,450 --> 00:04:18,540
.تمامًا

59
00:04:18,540 --> 00:04:22,030
إنّها ليست تعويذة كبيرة تعيد تشكيل
.جسدك المادّيّ لأجل التّحويل

60
00:04:23,110 --> 00:04:29,160
.اشهدي أوهامي الّتي شرعتُ فيها بنفسي
.لن أغنّي بصوتٍ آخر

61
00:04:34,120 --> 00:04:38,670
،كما ترين، إنّه مجرد عرضٍ فارغ
.لذا بوسعك أن تتحوّلي لأيّ شيء تتخيّلينه

62
00:04:38,670 --> 00:04:39,880
!مذهل

63
00:04:39,880 --> 00:04:43,420
باختصار، سببُ عدم نجاح الوهم الذاتيّ جيّدًا معكِ

64
00:04:43,420 --> 00:04:45,640
.هو لأنّكِ لا تملكين صورةً ثابتة في عقلك بعد

65
00:04:45,640 --> 00:04:47,440
ما الّذي تحاولين أن تتحوّلي إليه؟

66
00:04:47,440 --> 00:04:50,390
.ملاك الوقت، لا تيليكا-ساما

67
00:04:51,430 --> 00:04:53,920
.إذًا فلتذهبي وتستعيري كتابًا للرّموز

68
00:04:53,920 --> 00:04:56,650
.إن عزّزتِ رؤيتك، فستنجحين بالتّأكيد

69
00:04:57,020 --> 00:04:59,870
.أنت أكثر موهبةً ممّا تظنّين

70
00:04:59,870 --> 00:05:02,280
،كما أنّه حتى لو فشلت

71
00:05:02,280 --> 00:05:05,950
.فسأوقف أيّ من يحاول لومك بقبضتي الحديديّة

72
00:05:06,420 --> 00:05:08,200
!لذا اهدئي وافعليها

73
00:05:09,090 --> 00:05:10,200
ما المضحك؟

74
00:05:10,200 --> 00:05:13,870
سماعك تتفوّه بمثل هذا الكلام
...الرّجوليّ على هيئة روميا

75
00:05:14,150 --> 00:05:17,620
!حسنًا يا معلّم. سأحاول

76
00:05:17,900 --> 00:05:19,130
.أجل

77
00:05:23,800 --> 00:05:25,970
!روميا! ها أنت ذي

78
00:05:29,030 --> 00:05:30,390
.دعينا نسرع ونأكل غذاءنا

79
00:05:30,720 --> 00:05:32,720
.لقد أعددتُ لكِ حصّتك أيضًا يا روميا

80
00:05:33,970 --> 00:05:37,730
أيضًا، إلى أين ذهب ذاك الرّجل؟

81
00:05:37,730 --> 00:05:39,390
.اهدأ يا غلين

82
00:05:39,390 --> 00:05:43,230
ستكون من حثالةِ الأساتذة إن خدعتَ
!تلميذتك لأجل تناول غذائها

83
00:05:46,260 --> 00:05:48,460
بئسًا يا روميا، هل كنتِ جائعة إلى هذا الحدّ؟

84
00:05:48,460 --> 00:05:52,380
.أجل، قد أموتُ حقًّا إن لم آكل شيئًا قريبًا

85
00:05:53,010 --> 00:05:54,500
.تـ-تبدين يائسةً

86
00:05:55,750 --> 00:05:58,250
.لا بأس. لن آكله كلّه

87
00:05:58,250 --> 00:06:01,790
!فقط قضمة واحدة— لا، بل قضمتان فقط لأتذوّقه

88
00:06:01,790 --> 00:06:03,050
!شكرًا على الطّعام

89
00:06:03,050 --> 00:06:04,840
!سيستي، ها أنت

90
00:06:04,840 --> 00:06:06,470
...أعتذر عن التّأخّر

91
00:06:07,000 --> 00:06:07,870
ماذا؟

92
00:06:07,870 --> 00:06:09,720
!مـ-ما هذا؟

93
00:06:09,720 --> 00:06:13,200
!هنالك اثنتان رومـ— لا، بل اثنتان منّي

94
00:06:13,200 --> 00:06:14,850
.أيّتها القوّة، استمعي إليّ وأعديهم إلى الصّفر

95
00:06:19,190 --> 00:06:20,700
.أستأذنكما إذًا

96
00:06:21,360 --> 00:06:24,320
!أيّها النّذل

97
00:06:23,360 --> 00:06:25,840
!ماذا؟

98
00:06:24,320 --> 00:06:27,690
لا أصدّق أنّ معلّمًا قد يتحوّل إلى تلميذةٍ
!فقط ليسرق غذاءها

99
00:06:27,690 --> 00:06:29,150
...هـ-هوّني عليك

100
00:06:29,150 --> 00:06:32,040
...بعد أن استيقظتُ باكرًا حتّى أعدّها

101
00:06:33,280 --> 00:06:35,210
!ذاك الوغد

102
00:06:41,580 --> 00:06:45,210
.تلك القطّة البيضاء قد عصفت بي بالفعل

103
00:06:50,730 --> 00:06:56,020
.أشعر وكأنّي أنحدر شيئًا فشيئًا كإنسان

104
00:06:57,190 --> 00:06:58,700
!يا معلّم

105
00:07:07,250 --> 00:07:10,650
...لقد بدوتَ جائعًا، لذا إن أردت

106
00:07:10,650 --> 00:07:12,380
!أشكركِ جزيلَ الشّكر يا ملاكي

107
00:07:12,380 --> 00:07:14,660
!سأقبله بكلّ تواضعٍ وسرور

108
00:07:17,860 --> 00:07:20,260
...الحموضة الطّازجة واللّينة للطّماطم

109
00:07:20,260 --> 00:07:22,630
...هذا اللّحم الشّهيّ والمُملّحِ على نحوٍ ممتاز

110
00:07:23,280 --> 00:07:27,760
وهذه القطعة الرّقيقة من الجبن
!الّتي تخلقُ انسجامًا رائعًا

111
00:07:27,760 --> 00:07:29,670
!هل أعددته بنفسك؟

112
00:07:29,670 --> 00:07:33,920
.أنا خرقاء جدًّا، لذا لستُ ضليعةً بالطّبخ

113
00:07:33,920 --> 00:07:34,800
من أعدّه إذًا؟

114
00:07:35,090 --> 00:07:36,670
...هذا سرّ

115
00:07:36,670 --> 00:07:38,840
.بطلبٍ ممّن أعدّته

116
00:07:38,840 --> 00:07:43,530
،مع أنّها استيقظت باكرًا وأعدّت هذا الغذاء لرجلٍ مُعيّن

117
00:07:43,530 --> 00:07:46,060
.إلاّ أنّهما تشاجرا وفقدت فرصتها لتعطيه إيّاه

118
00:07:46,380 --> 00:07:50,400
،لذا فقد كانت على وشك أن ترميه
.لكنّي أفضّل ألاّ يُهدَر

119
00:07:50,820 --> 00:07:53,500
تبًّا، أنا آخذ مكان سلّة قمامة إذًا؟

120
00:07:54,820 --> 00:07:58,890
.تعازيّ لتلك الفتاة، لكن ذلك الرّجل سيّئ جدًّا

121
00:07:58,890 --> 00:08:02,680
.يجب عليه قبوله فقط إن أعدّتهُ فتاةٌ لأجله

122
00:08:02,680 --> 00:08:05,030
.يا له من وغد

123
00:08:09,800 --> 00:08:12,120
.لقد أكلتُ كثيرًا

124
00:08:12,120 --> 00:08:14,410
.شكرًا على الطّعام. لقد كان شهيًّا بشكلٍ لا يصدّق

125
00:08:14,410 --> 00:08:17,360
هذا جيد. أنا واثقةٌ أنّ الفتاة الّتي
.أعدّته ستسعدُ لذلك

126
00:08:17,360 --> 00:08:19,240
.حسنًا، حان وقت العودة

127
00:08:19,240 --> 00:08:21,680
أنتَ غلين ريدارس على ما أظنّ؟

128
00:08:22,020 --> 00:08:24,310
هلّي بلحظةٍ من وقتك؟

129
00:08:24,310 --> 00:08:27,050
.أنا الشّخص الّذي تبحثين عنه، لكنّي لا أملك وقتًا

130
00:08:27,050 --> 00:08:30,190
،لقد انتهيتُ من الأكل للتّوّ
—لذا سأكون مشغولاً جدًّا

131
00:08:31,160 --> 00:08:33,200
!جلالتك؟

132
00:08:37,720 --> 00:08:39,540
إلى أين ذهبت جلالتها؟

133
00:08:39,540 --> 00:08:42,200
...لقد غفلتُ عنها للحظة، و

134
00:08:42,200 --> 00:08:45,180
!أيّها الأبله. جدها فورًا

135
00:08:45,180 --> 00:08:46,250
!حاضر

136
00:08:47,430 --> 00:08:49,070
أرأيت يا حضرة المدير؟

137
00:08:49,070 --> 00:08:51,460
!كيف بدا ذلك الحارس الإمبراطوريّ مذعورًا

138
00:08:51,460 --> 00:08:54,410
.لا أصدّق أنّك قد تخفين جلالتها بالسّحر

139
00:08:54,410 --> 00:08:56,840
.إنّك امرأةٌ مخيفة كالعادة

140
00:08:58,550 --> 00:08:59,690
...سيليكا-ساما

141
00:09:00,160 --> 00:09:01,320
ماذا هناك يا إليانور؟

142
00:09:01,320 --> 00:09:05,460
.هناك ما أرغب مناقشتكِ فيه بينما جلالتها غائبة

143
00:09:09,000 --> 00:09:10,800
.لقد مضى عام

144
00:09:10,800 --> 00:09:12,030
هل كنتَ بصحّة جيّدة؟

145
00:09:12,030 --> 00:09:13,820
!أجل، بالطّبع

146
00:09:16,550 --> 00:09:19,580
.لطالما أردتُ أن أعتذر منك

147
00:09:22,200 --> 00:09:25,390
،لقد كرّستَ نفسك لهذه الدّولة

148
00:09:25,390 --> 00:09:29,690
إلاّ أنّك طُردتَ من هيئة سحرة
...البلاط بتلك الطّريقة

149
00:09:29,690 --> 00:09:30,920
!لا، لا، لا

150
00:09:30,920 --> 00:09:33,760
!إنّما انسحبتُ لأنّي كرهتُ ذلك العمل

151
00:09:33,760 --> 00:09:38,170
لا يمكنك أن تحني رأسكِ لفاشلٍ
!اجتماعيّ مثلي يا جلالتك

152
00:09:38,170 --> 00:09:39,090
.غلين

153
00:09:39,090 --> 00:09:40,840
،الـ-الأهم يا جلالتك

154
00:09:40,840 --> 00:09:43,500
ما الّذي أحضركِ إلى هنا بدون أيٍّ من خدمك؟

155
00:09:45,160 --> 00:09:48,100
.مضى وقت طويل يا إرميانا

156
00:09:48,100 --> 00:09:50,150
كيف حالك؟

157
00:09:50,490 --> 00:09:52,720
.لقد كبرتِ وأصبحتِ طويلة جدًّا

158
00:09:52,720 --> 00:09:55,440
كيف تسري حياتك مع عائلة فيبل؟

159
00:09:55,440 --> 00:09:57,950
.هذا أشبه بحلم

160
00:09:57,950 --> 00:09:59,930
...بأن أستطيع رؤيتك مجدّدًا

161
00:10:04,390 --> 00:10:05,320
...إرميانا

162
00:10:05,320 --> 00:10:07,160
...أستميحك عذرًا، لكن

163
00:10:07,160 --> 00:10:10,080
قد يكون هذا فظًّا، إلاّ أنّي أظنّكِ
.قد أخطأتني مع شخصٍ آخر

164
00:10:12,000 --> 00:10:13,340
.أنا روميا

165
00:10:13,340 --> 00:10:15,230
.روميا تينجل

166
00:10:15,230 --> 00:10:23,260
مع فائق الاحترام، أظنّ أنّ جلالتكِ قد أخطأتني
.مع الرّاحلة سموّ الأميرة إرميانا إيل كيل ألزانو

167
00:10:29,430 --> 00:10:31,450
.أجل، أنت محقّة

168
00:10:32,390 --> 00:10:33,760
...إرميانا

169
00:10:33,760 --> 00:10:37,490
لقد توفّيت تلك الفتاة جرّاء المرض
.قبل ثلاث سنوات

170
00:10:37,970 --> 00:10:42,030
أعتذر على وضعك في هذا الموقف
.غير السّار يا روميا-سان

171
00:10:42,030 --> 00:10:43,740
.لا داعي للاعتذار

172
00:10:43,740 --> 00:10:45,560
.والآن، عن إذنك

173
00:10:49,720 --> 00:10:52,420
.لن تقبل بي كما توقّعت

174
00:10:52,700 --> 00:10:54,950
.لا يمكنني أن أتصرّف كوالدتها الآن

175
00:10:57,620 --> 00:10:59,380
.سوف أعود الآن يا غلين

176
00:10:59,380 --> 00:11:00,950
.ماذا؟ أكيد

177
00:11:04,130 --> 00:11:06,520
.اعتنِ بها رجاءً

178
00:11:06,520 --> 00:11:07,590
.حاضر

179
00:11:17,410 --> 00:11:18,490
!يا جلالتك

180
00:11:20,810 --> 00:11:22,380
.يا إلهي يا زيلوس

181
00:11:22,380 --> 00:11:23,740
هل وجدتني؟

182
00:11:25,970 --> 00:11:28,560
.اغفري لي فظاظتي رجاءً يا مولاتي

183
00:11:28,560 --> 00:11:32,390
.يجب أن أحرس حضرتكِ لمدّة

184
00:11:34,390 --> 00:11:35,750
.لا أصدّق هذا

185
00:11:36,400 --> 00:11:39,690
.إنّ الحرس الإمبراطوريّ يقمع جلالتها

186
00:11:39,690 --> 00:11:41,880
.لا أصدّق أنّهم يبادروا بخطوتهم بالفعل

187
00:11:42,550 --> 00:11:44,940
.زيلوس، القائد العام للحرس الإمبراطوريّ

188
00:11:44,940 --> 00:11:51,000
إنّه مقاتل محنّك قيل أنّه قارع قدّيس السّيف
.يوهانيس أثناء الحرب المقدّسة قبل 40 سنة

189
00:11:51,590 --> 00:11:55,100
.لا يجدر به أن يكون ممّن يتصرّفون بطيش

190
00:11:58,480 --> 00:11:59,610
إلى أين تظنّين نفسك ذاهبة؟

191
00:12:00,400 --> 00:12:02,240
.سأقتل كلّ أعدائنا

192
00:12:02,240 --> 00:12:06,860
.الحرس الإمبراطوريّ هم الجنود الأكثر ولاءً لجلالتها

193
00:12:06,860 --> 00:12:09,940
.أجد من الصّعب تصديق أنّهم قد يؤذونها

194
00:12:09,940 --> 00:12:12,030
.لا بدّ أنّهم يخطّطون لأمرٍ آخر

195
00:12:12,030 --> 00:12:13,620
.لقد فكّرتُ في استراتيجيّة

196
00:12:13,900 --> 00:12:16,780
.سأهاجم العدوّ من المقدّمة

197
00:12:16,780 --> 00:12:19,590
.اتبعني من الخلف وهاجم من المقدّمة بعدي

198
00:12:35,340 --> 00:12:40,260
مُحي أيّ أثر للأميرة السّابقة بسبب قدرتها الخاصّة؟

199
00:12:42,500 --> 00:12:43,740
...يا معلّم

200
00:12:45,240 --> 00:12:47,580
!ما الأمر أيّتها القطّة البيضاء؟
هل ستعصفين بي مجدّدًا؟

201
00:12:47,580 --> 00:12:48,920
!كلاّ

202
00:12:48,920 --> 00:12:51,750
...لم تعد روميا بعد

203
00:12:52,230 --> 00:12:53,990
هل سمعت منها أيّ أخبار؟

204
00:12:55,890 --> 00:12:57,530
.أيّتها القطّة البيضاء، أعيريني أذنك

205
00:12:57,530 --> 00:12:59,270
مـ-ماذا هناك؟

206
00:13:02,790 --> 00:13:06,930
كان أيّ أحد ليريد أن يظلّ وحيدًا
لبعض الوقت بعد ذلك، صحيح؟

207
00:13:07,480 --> 00:13:09,160
.أظنّني سأذهب لأبحث عنها

208
00:13:09,160 --> 00:13:13,720
الاستمتاع مع أصدقائها سيساعد
.على صرف انتباهها أيضًا

209
00:13:13,720 --> 00:13:15,640
.اعتني بالقسم لأجلي

210
00:13:15,640 --> 00:13:16,780
.حـ-حاضرة

211
00:13:16,780 --> 00:13:18,680
!اعتنِ بروميا رجاءً

212
00:13:18,680 --> 00:13:19,790
.دعي الأمر لي

213
00:13:19,790 --> 00:13:23,800
بطني ممتلئة عن آخرها الآن ويمكنني
.البحث عنها اليوم بطوله

214
00:13:23,800 --> 00:13:24,360
ماذا؟

215
00:13:24,360 --> 00:13:28,560
الملاك العظيم روميا-ساما
.قد أحضرتِ لي بعض الشّطائر

216
00:13:28,560 --> 00:13:31,790
مع أنّها على ما يبدو أُعدّت لشخصٍ آخر
...وكانت ستُرمى في القمامة

217
00:13:34,660 --> 00:13:36,190
هل أكلتَ تلك؟

218
00:13:36,190 --> 00:13:38,630
.أحسنتَ عملاً في كونك مطرحَ نفايات مثير للشّفقة

219
00:13:38,630 --> 00:13:40,840
.ومع ذلك، كانت جدّ لذيذة

220
00:13:42,750 --> 00:13:47,100
لم تحتوي على أيّ شيء فاخر، لكنّها
،أُعِدّت باهتمامٍ كبيرٍ وكانت شهيّة جدًّا

221
00:13:47,100 --> 00:13:49,550
.ولا تناديها بالقمامة

222
00:13:49,550 --> 00:13:51,900
.هذا فظٌّ تجاه الشّخص الّذي أعدّها

223
00:13:51,900 --> 00:13:54,930
ظننتُ أنّك لطيفة مع الجميع عداي؟

224
00:13:54,930 --> 00:13:56,780
!أ-أعلم

225
00:13:56,780 --> 00:13:59,000
!تبًّا! فقط أسرع واذهب

226
00:14:13,810 --> 00:14:14,740
إلام تنظرين؟

227
00:14:15,980 --> 00:14:17,180
...المعلّم

228
00:14:19,080 --> 00:14:22,540
.لا شيء داخل هذه المدلاة

229
00:14:22,540 --> 00:14:26,900
...ظننتُ أنّ بداخلها صورة لشخصٍ عزيزٍ، لكن

230
00:14:28,300 --> 00:14:30,140
هذا غريب، صحيح؟

231
00:14:30,140 --> 00:14:33,310
أبقيها ضمن مقتنياتي الشّخصيّة
.طوال هذا الوقت

232
00:14:33,310 --> 00:14:34,570
.ليس تمامًا

233
00:14:34,570 --> 00:14:38,380
أواثقةٌ أنّها ليست ممتلئة بشيءٍ خاصّ؟

234
00:14:39,160 --> 00:14:42,110
يا معلّم... أنت تعلم، أليس كذلك؟

235
00:14:42,110 --> 00:14:44,130
...أنّ جلالتها وأنا

236
00:14:44,130 --> 00:14:45,280
.نعم

237
00:14:45,650 --> 00:14:49,350
ماذا كان يجب أن أفعل بظنّك الآن؟

238
00:14:50,040 --> 00:14:53,910
.أعلمُ لمَ تخلّت عنّي جلالتها

239
00:14:54,280 --> 00:14:58,080
.أنا تجسيد الشّيطان... كائن ملعون ومحرّم

240
00:14:58,080 --> 00:14:59,080
.إحدى الموهوبين

241
00:14:59,510 --> 00:15:02,720
،وبما أنّي ولدتُ بهذه القدرة الخاصّة

242
00:15:02,720 --> 00:15:06,630
يمكن استخدامي كقنبلةٍ للإضرار
.بوضعِ العائلة الملكيّة

243
00:15:07,690 --> 00:15:13,550
لذا أظنّ بالفعل أنّ التّخلّص منّي
.كان ضروريًّا لمستقبل هذه البلاد

244
00:15:15,060 --> 00:15:19,580
لكن ومع ذلك، جزءٌ منّي لا يمكنه
.أن يسامح جلالتها على فعل ذلك

245
00:15:20,050 --> 00:15:21,900
.أظنّني غاضبة عليها

246
00:15:22,320 --> 00:15:25,090
.لا مكان للمنطق في حالات كهذه في النّهاية

247
00:15:25,090 --> 00:15:31,320
"إلاّ أني أريد أيضًا أن أناديها بـ"أمّي
.مرّةً أخرى وأحضنها مُجدّدًا

248
00:15:32,030 --> 00:15:34,360
،لكنّ والدا سيستي قاما بإيوائي

249
00:15:34,360 --> 00:15:40,200
.وأشعر وكأني سأخونهما إن فعلتُ ذلك

250
00:15:41,000 --> 00:15:43,750
لذا ماذا كان يجب أن أفعل؟

251
00:15:45,300 --> 00:15:47,240
.هذه فلسفتي فحسب

252
00:15:47,240 --> 00:15:49,470
البشر كائنات دائمًا ما تتعرّض للأذى

253
00:15:49,470 --> 00:15:52,880
.وتشعر بالنّدم متى أقدمت على قرارٍ أو هكذا شيء

254
00:15:54,090 --> 00:15:59,720
،"من السّهل القول "اختر ولا تترك مجالاً للنّدم
.لكنّ ذلك مستحيل

255
00:16:00,460 --> 00:16:02,750
،مهما عانيتِ في طريقك

256
00:16:02,750 --> 00:16:05,160
.دائمًا ما ستندمين عن شيءٍ به لاحقًا

257
00:16:05,160 --> 00:16:09,110
.هكذا نحن البشر

258
00:16:11,490 --> 00:16:14,990
.لهذا أظنّ أنّ مشاعرنا الحقيقيّة مهمّة

259
00:16:14,990 --> 00:16:15,980
مشاعرنا الحقيقيّة؟

260
00:16:15,980 --> 00:16:16,970
.نعم

261
00:16:16,970 --> 00:16:19,230
،إن اخترت طريقك بناءً على مشاعرك الحقيقيّة

262
00:16:19,230 --> 00:16:21,940
فقدْر الألم يقلّ قليلاً عندما تشعرين
بنفس النّدم، صحيح؟

263
00:16:24,750 --> 00:16:25,960
،روميا

264
00:16:25,960 --> 00:16:27,630
ما الّذي تودّين فعله؟

265
00:16:28,260 --> 00:16:31,590
.لا أفهم مشاعري حيال هذا

266
00:16:33,700 --> 00:16:37,350
.قبل وقتٍ طويل، كنتُ ساحرًا أخدم الجيش اللإمبراطوريّ

267
00:16:38,570 --> 00:16:42,490
.باعتبار بيئة عملي، فقد زرتُ البلاط كثيرًا

268
00:16:42,490 --> 00:16:48,750
وعندما فعلت، رأيتُ الشّخص ذو القوّة الأكبر
.واقفًا هناك مرتديًا نفس مدلاتك

269
00:16:49,270 --> 00:16:52,790
لا بدّ أنّها لم تقوى على رميِ المدلاة
.الّتي كانت توافق مدلاتك

270
00:16:52,790 --> 00:16:55,570
ممّا يعني أن جوابك كان هناك لوقتٍ
طويل، أليس كذلك؟

271
00:16:55,900 --> 00:16:58,060
.لا يهمّ إن كان امتعاضًا مكبوتًا وحسب

272
00:16:58,060 --> 00:17:03,660
لِمَ لا تبدئين عبر مصارحتها بمشاعرك
الحقيقيّة بدلاً من التّهرّب منها؟

273
00:17:03,660 --> 00:17:05,110
...يا معلّم

274
00:17:05,670 --> 00:17:09,090
لستُ مؤهلاً للحديث هكذا بعد كلّ
.التّهرّب الّذي قمتُ به

275
00:17:10,930 --> 00:17:13,130
.مع ذلك، أنا خائفة

276
00:17:13,130 --> 00:17:16,510
...فكرة نظرها إليّ بتلك العينين الباردتين مجدّدًا

277
00:17:16,510 --> 00:17:18,730
...لذا

278
00:17:21,110 --> 00:17:23,770
هلاّ رافقتني يا معلّم؟

279
00:17:26,120 --> 00:17:29,360
.يا إلهي... حسنًا، سآتي معك

280
00:17:29,940 --> 00:17:31,400
!شكرًا جزيلاً

281
00:17:34,720 --> 00:17:36,570
الحرس اللإمبراطوريّ؟

282
00:17:40,200 --> 00:17:42,080
روميا تينجل، صحيح؟

283
00:17:42,080 --> 00:17:43,410
.ماذا؟ أ-أجل

284
00:17:46,500 --> 00:17:47,850
،نستميح منك كلّ العذر

285
00:17:47,850 --> 00:17:51,440
أنتِ متّهمة بالتّآمر لاغتيال جلالتها
.الملكة أليسيا السّابعة

286
00:17:51,440 --> 00:17:52,630
.لا داعي للتّفاوض

287
00:17:52,940 --> 00:17:56,630
!محكومٌ عليك بالإعدام لخيانتك وإهانتك الأسرة الملكيّة

288
00:17:56,630 --> 00:17:59,890
!أ-أنا؟ أغتال جلالتها؟

289
00:18:00,160 --> 00:18:02,890
.يا لها من نكتة سيّئة. أرونا دليلكم

290
00:18:02,890 --> 00:18:05,020
.لستُ مجبرًا على الإفصاح عن ذلك لغريب

291
00:18:05,020 --> 00:18:07,560
.لا يمكنكم إعدامها دون محاكمة أو مذكّرة

292
00:18:07,560 --> 00:18:10,060
.هذه أوامر جلالتها المباشرة

293
00:18:11,060 --> 00:18:11,940
!كفّ عن هذا الهراء

294
00:18:12,250 --> 00:18:13,880
.سلّمنا تلك الفتاة

295
00:18:13,880 --> 00:18:17,280
إن واصلتَ الدّفاع عنها، فسيتم
.إعدامك بداعي الخيانة أيضًا

296
00:18:18,780 --> 00:18:20,780
.سأفعل كما تطلبون

297
00:18:21,130 --> 00:18:22,200
!روميا؟

298
00:18:22,200 --> 00:18:28,730
.سأكفّر عن ذنبي لخيانة جلالتها بحياتي

299
00:18:28,730 --> 00:18:30,630
.لذا اصفحوا عن حياة المعلّم رجاءً

300
00:18:30,630 --> 00:18:32,220
—أيّتها الغبيّة! ماذا تقو

301
00:18:33,500 --> 00:18:34,730
!معلّم

302
00:18:34,730 --> 00:18:35,460
!تعالي

303
00:18:44,600 --> 00:18:46,970
.أغمضي عينيك ولا تتحرّكي

304
00:18:46,970 --> 00:18:49,730
،إن أخطأتُ نقطتك الحيوية
.فستُطيلين من معاناتك وحسب

305
00:18:50,320 --> 00:18:51,130
.حاضرة

306
00:18:52,720 --> 00:18:55,220
.لطالما ظننتُ أنّ هذا اليوم سيأتي في النّهاية

307
00:18:55,780 --> 00:18:58,990
.أنّ تلك المرأة ستُقرّر إنهاء حياتي يومًا ما

308
00:19:02,210 --> 00:19:04,440
.فهمت

309
00:19:05,040 --> 00:19:07,410
.لقد أتت لرؤيتي بما أنّها المرّة الأخيرة

310
00:19:07,790 --> 00:19:11,950
،كان يفترض بي أن أموت حينها
.لكنّي عشتُ لثلاث سنواتٍ أخرى

311
00:19:11,950 --> 00:19:14,540
.تمكّنتُ من صنعِ الكثير من الذّكريات الرّائعة

312
00:19:13,540 --> 00:19:14,540
!يمكنك النّجاح

313
00:19:17,000 --> 00:19:18,550
...لذا الآن

314
00:19:19,510 --> 00:19:21,470
!أبقي عينيك مغمضتين

315
00:19:25,010 --> 00:19:26,010
!عـ-عيناي

316
00:19:33,170 --> 00:19:35,690
.تبًّا، لقد ضربوني بقوّة

317
00:19:35,690 --> 00:19:36,480
!يا معلّم؟

318
00:19:36,480 --> 00:19:37,470
!ماذا فعلت...؟

319
00:19:37,470 --> 00:19:39,440
.ماذا؟ التّعويذة، النّور السّاطع

320
00:19:39,440 --> 00:19:40,990
.لقد أعمتهم وحسب

321
00:19:40,990 --> 00:19:43,320
!يا معلّم! لِمَ قد تنقذني؟

322
00:19:43,320 --> 00:19:45,950
.ستغضب القطّة البيضاء منّي إن تخلّيتُ عنك

323
00:19:45,950 --> 00:19:47,800
!هذا ليس وقت المزاح

324
00:19:47,800 --> 00:19:49,080
!على هذا المعدّل، ستتمّ إدانتك أيضًا

325
00:19:49,080 --> 00:19:51,210
.لأنّي قطعتُ وعدًا

326
00:19:52,330 --> 00:19:54,330
.لا تقلقي

327
00:19:54,330 --> 00:19:59,630
.ما كانت جلالتها لتتخلّص منك دون محاكمةٍ حتّى

328
00:19:59,630 --> 00:20:02,860
.لا بدّ من أمرٍ آخر خلف أمر الإعدام هذا

329
00:20:02,860 --> 00:20:04,730
...إن استطعنا أن نلتقي مع جلالتها

330
00:20:04,730 --> 00:20:05,720
!هناك

331
00:20:05,720 --> 00:20:07,560
!أيّها الخائنان

332
00:20:07,560 --> 00:20:09,810
!مـ-ما العمل يا معلّم؟

333
00:20:09,810 --> 00:20:11,270
ما العمل؟

334
00:20:11,660 --> 00:20:16,860
.حكم الوقت، اتّزان الميزان، ودع لوح النّظام ينقلب

335
00:20:19,320 --> 00:20:20,190
!وراءهما

336
00:20:20,190 --> 00:20:21,190
!لا تدعوا المتمرّدان يهربان

337
00:20:21,190 --> 00:20:22,800
...تبًّا

338
00:20:22,800 --> 00:20:25,560
لِمَ تستمرّ المتاعب في المجيء الواحدة تلو الأخرى؟

339
00:20:25,560 --> 00:20:27,950
.لهذا لم أرد أن أعمل

340
00:20:27,950 --> 00:20:29,000
...يا معلّم

341
00:20:29,000 --> 00:20:33,870
المشكلة تكمن في كيف نتسلّل من خلال
.الحرس الملكيّ ونلتقي بجلالتها

342
00:20:34,440 --> 00:20:35,540
...مهلاً

343
00:20:35,540 --> 00:20:39,900
بالتّفكير في الأمر، لسنا بحاجةٍ للالتقاء
بها مباشرةً، أليس كذلك؟

344
00:20:47,450 --> 00:20:48,360
غلين؟

345
00:20:48,360 --> 00:20:49,560
!سيليكا

346
00:20:49,560 --> 00:20:51,520
أنت مع جلالتها، صحيح؟

347
00:20:51,520 --> 00:20:52,770
...لدي معروفٌ لأطلبه منك

348
00:20:52,770 --> 00:20:54,440
.لا يمكنني أن أفعل أيّ شيء

349
00:20:55,280 --> 00:20:57,020
!تمهّلي، لم أقل شيئًا بعد

350
00:20:57,020 --> 00:21:00,390
.آسفة يا غلين. لا يمكنني أن أقول أيّ شيء

351
00:21:00,880 --> 00:21:02,440
.سأكرّر هذا

352
00:21:02,440 --> 00:21:05,660
.لا يمكنني أن أفعل أيّ شيء. أيّ شيء

353
00:21:05,970 --> 00:21:08,200
أنت لا تعبثين، أليس كذلك؟

354
00:21:08,200 --> 00:21:09,070
.لا

355
00:21:09,070 --> 00:21:10,660
وماذا عن وضعنا؟

356
00:21:10,660 --> 00:21:11,990
.أملك فكرة تقريبيّة

357
00:21:12,440 --> 00:21:15,200
لِمَ خرج الحرس الإمبراطوريّ عن السّيطرة؟

358
00:21:15,200 --> 00:21:18,020
ولِمَ أمرت جلالتها بإعدام روميا؟

359
00:21:19,280 --> 00:21:20,940
لا يمكنك أن تخبريني، أليس كذلك؟

360
00:21:20,940 --> 00:21:22,650
.غلين، أنت الوحيد

361
00:21:22,650 --> 00:21:23,420
ماذا؟

362
00:21:23,710 --> 00:21:26,670
.أنت الوحيد القادر على اختراق هذا الوضع

363
00:21:26,670 --> 00:21:28,930
."أجل، "وحدك أنت

364
00:21:29,210 --> 00:21:30,940
.فكّر مليًّا في معنى ذلك

365
00:21:30,940 --> 00:21:33,800
.وجد طريقةً لتقف أمام الملكة

366
00:21:33,800 --> 00:21:35,100
!مـ-مهلاً

367
00:21:35,100 --> 00:21:35,950
!سحقًا

368
00:21:35,950 --> 00:21:36,940
...يا معلّم

369
00:21:37,230 --> 00:21:40,180
لتقف أمام الملكة؟

370
00:21:40,180 --> 00:21:42,970
الملكة محميّة من قبل حرّاسٍ
.خضعوا لتدريبٍ مكثّف

371
00:21:42,970 --> 00:21:45,450
.إضافة إلى وجود قائدها زيلوس

372
00:21:45,450 --> 00:21:49,550
تبًّا، من الواضح أنّ هذا أكثر مما
.أستطيع التّعامل معه

373
00:21:49,550 --> 00:21:50,810
...كيف لي أن

374
00:22:01,000 --> 00:22:02,340
!أ-أنت

375
00:23:46,480 --> 00:23:47,790
!يا لظرافتها

376
00:23:47,790 --> 00:23:48,730
لِمَ تخلّوا عنها هنا؟

377
00:23:48,730 --> 00:23:51,630
!يا له من مالكٍ مستهتر

378
00:23:52,360 --> 00:23:54,530
لِمَ لا نجد مالكًا لها؟

379
00:23:54,880 --> 00:23:56,340
.يبدو هذا جيّدًا

380
00:23:57,030 --> 00:23:57,790
ماذا؟

381
00:23:58,600 --> 00:24:00,760
.سيستي، ثمّة شخص مريب هناك

382
00:24:00,760 --> 00:24:03,660
!أظنّ أنّ ذلك الرّجل كان يراقب قسمنا طوال المنافسة

383
00:24:03,660 --> 00:24:04,290
!لا، هذا مخيف

384
00:24:04,290 --> 00:24:06,170
!فلنذهب ونخبر المعلّم بهذا

385
00:24:07,140 --> 00:24:09,000
.طوبى لكِ أيّتها الهررة

386
00:24:10,480 --> 00:24:11,530
!أنت، أنت

387
00:24:11,530 --> 00:24:14,680
أين ذلك المنحرف الّذي يتخيّل أشياءً
!دنيئة بينما يسترق النّظر لتلامذتي؟

388
00:24:14,680 --> 00:24:16,140
!أ-أنت

389
00:24:16,140 --> 00:24:17,350
.مضى وقت طويل

390
00:24:19,830 --> 00:24:20,940
ذكّرني من أنت؟