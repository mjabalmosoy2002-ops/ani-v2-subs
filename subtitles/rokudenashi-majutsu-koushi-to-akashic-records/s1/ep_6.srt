1
00:00:01,720 --> 00:00:06,480
.لقد وضعتُ قلادة لعنة متفاعلة حول عنق جلالتها

2
00:00:10,510 --> 00:00:14,350
.سنستخدم حياة جلالتها

3
00:00:14,350 --> 00:00:18,360
.لأجل مهمّتنا النّبيلة كباحثي الحكمة الإلهيّة

4
00:00:18,360 --> 00:00:21,020
!ماذا؟! باحثو الحكمة الإلهيّة؟

5
00:00:25,570 --> 00:00:29,150
.هنالك طريقة وحيدة لتحرير لعنة الموت

6
00:00:29,150 --> 00:00:33,260
—إن أردتِ إنقاذ الملكة، عندما يحلّ المغيب

7
00:00:33,760 --> 00:00:36,200
!وها قد احتلّوا الصّدارة

8
00:00:36,200 --> 00:00:40,220
يرفض القسم 2 تحت إشراف المعلّم غلين
!أن يدع القسم 1 ينفرد بالتّقدّم

9
00:00:41,060 --> 00:00:42,100
...غلين

10
00:00:49,210 --> 00:00:50,730
هل أنت بخير يا روميا؟

11
00:00:50,730 --> 00:00:51,280
!أجل

12
00:00:56,410 --> 00:01:01,870
!ألتمس من الخلق، امنح يداي سيفًا عظيمًا

13
00:01:08,630 --> 00:01:10,460
أهذه... خيمياء؟

14
00:01:10,460 --> 00:01:13,050
.لم أتصوّر أنّ حتّى هيئة سحرة البلاط سيظهرون

15
00:01:13,360 --> 00:01:17,050
!يا ذئبَ الجليد الفضّيّ، سارع قدمًا وتدرّع بالعاصفة

16
00:01:18,300 --> 00:01:20,050
.لن يفلح هذا يا غلين

17
00:01:20,550 --> 00:01:21,470
.جهّز نفسك

18
00:01:23,640 --> 00:01:28,360
القتال القريب عبر الخيمياء وسحر
!القنص للمدى البعيد؟

19
00:01:28,360 --> 00:01:28,940
!بئسًا

20
00:01:28,940 --> 00:01:30,440
!لا أستطيع تفاديها

21
00:01:43,280 --> 00:01:45,660
.مضى وقتٌ طويل يا غلين

22
00:01:46,790 --> 00:01:48,410
!ألبيرت؟

23
00:02:07,770 --> 00:02:11,900
السّجلاّت الأكاشيّة
للمعلّم السّحريّ الوغد

24
00:03:19,460 --> 00:03:22,160
!ماذا كنت تفكّرين يا غبيّة؟

25
00:03:22,160 --> 00:03:23,720
.غلين، هذا مؤلم

26
00:03:23,720 --> 00:03:25,950
!كدتُ أموت

27
00:03:25,950 --> 00:03:29,350
معذرةً يا معلّم، من هذان الشّخصان؟

28
00:03:29,740 --> 00:03:32,350
.رفيقان من أيّامي في الجيش الإمبراطوريّ

29
00:03:33,300 --> 00:03:39,710
الجلاّد رقم 17 في هيئة سحرة البلاط
،والقوّات الخاصّة، النّجم ألبيرت

30
00:03:39,710 --> 00:03:42,540
.ورقم 7، المركبة ريل

31
00:03:43,350 --> 00:03:48,150
يمكنني أن أقول اطمئنّي بما أنّهما
.جديران بالثّقة، لكنّي لا أستطيع

32
00:03:48,150 --> 00:03:52,330
ألبيرت، من الطّائش أن تؤدّي التّعويذات
.ذات الدّرجة العسكريّة في هذه المدينة

33
00:03:52,330 --> 00:03:55,080
!نفس الكلام ينطبق عليك أيضًا

34
00:03:55,450 --> 00:03:57,390
.هذا ليس وقت العبث

35
00:03:58,120 --> 00:04:01,420
،الحرس الإمبراطوريّ يراقب جلالتها

36
00:04:01,820 --> 00:04:05,670
ويبدو أنّهم يتصرّفون من أنفسهم
.لأجل التّخلّص من الأميرة السّابقة هنا

37
00:04:06,390 --> 00:04:07,390
وسيليكا؟

38
00:04:07,680 --> 00:04:11,100
،إنّها جالسةٌ في منصّة الشّخصيّات الهامّة
.لكن لا يبدو أنّها تنوي فعل شيء

39
00:04:11,100 --> 00:04:12,600
.هذا غريب

40
00:04:12,600 --> 00:04:15,560
.بوسعها أن تتعامل مع حارسٍ أو اثنين بكل سهولة

41
00:04:16,380 --> 00:04:17,860
.لم أفهم

42
00:04:18,180 --> 00:04:22,230
لِمَ قد يلاحقون روميا الآن؟

43
00:04:22,640 --> 00:04:24,600
.هذا غير واضح في الوقت الحاضر

44
00:04:25,920 --> 00:04:27,760
.التّفكير لن يفيد

45
00:04:27,760 --> 00:04:31,080
.لقد توصلتُ لخطّة لاختراق هذا الوضع

46
00:04:31,080 --> 00:04:32,710
.أسمعينا إياها

47
00:04:32,990 --> 00:04:35,210
.أوّلاً، سأهاجم العدوّ من الأمام

48
00:04:35,600 --> 00:04:38,090
.حينها يا غلين، ستهاجمُ العدوّ من الأمام

49
00:04:38,450 --> 00:04:41,550
.وأخيرًا، سيهاجم ألبيرت العدوّ من الأمام

50
00:04:41,920 --> 00:04:43,370
!مؤلم! مؤلم

51
00:04:43,370 --> 00:04:47,980
!يجب أن تفعلي شيئًا بشأن عضلة دماغك أيّتها الغبيّة

52
00:04:49,710 --> 00:04:51,720
.أنتم منسجمون حقًّا

53
00:04:51,720 --> 00:04:53,310
ماذا؟ إنّك تمزحين، صحيح؟

54
00:04:53,940 --> 00:04:57,610
.حسنٌ، أنا مسرورٌ لأنّي لستُ مضطرًّا لقتالكما

55
00:04:58,470 --> 00:05:01,280
.أعيرانا عونكما رجاءً

56
00:05:02,610 --> 00:05:04,240
أين يجب أن نبدأ؟

57
00:05:04,240 --> 00:05:08,430
."قالت سيليكا، "جد طريقةً للوقوف أمام الملكة

58
00:05:08,430 --> 00:05:11,240
.لذا لا بدّ أنّ ذلك هو حلّ هذا الوضع

59
00:05:11,240 --> 00:05:12,290
وما أساس استنتاجك؟

60
00:05:12,790 --> 00:05:19,200
،الجلاّدة رقم 21 السّابقة في القوات الخاصّة
،العالَم سيليكا أرفونيا

61
00:05:19,200 --> 00:05:23,550
...سيبتيندي، أعظم ساحرة في القارّة

62
00:05:23,910 --> 00:05:28,360
،إنّها حقيرة وسيّئة المزاج
.لكنّها لا تقول شيئًا فارغًا أبدًا

63
00:05:28,360 --> 00:05:29,300
.صدّقني

64
00:05:30,020 --> 00:05:32,580
على أيّ حال، تزداد الأمور سوءًا
.وحسب على هذا المعدّل

65
00:05:32,580 --> 00:05:34,380
.سأضع رهاني عليها

66
00:05:34,380 --> 00:05:35,140
.حسنًا

67
00:05:35,620 --> 00:05:37,100
.سأثق بك

68
00:05:38,650 --> 00:05:42,890
يستعرض القسم 1 قوّته ويحقّق انتصارًا
!فائقًا في منافسة الكشف والفتح

69
00:05:42,890 --> 00:05:46,150
بينما التّقدم الثّابت للقسم 2 ينتهي
!هنا حيث رجعوا خطوة إلى الخلف

70
00:05:46,480 --> 00:05:48,720
...كنت أعلم! دون المعلّم غلين

71
00:05:48,720 --> 00:05:51,280
أين ذهب في هذا الوقت المهمّ؟

72
00:05:53,410 --> 00:05:55,000
.أعتذر على التّأخّر

73
00:05:58,970 --> 00:06:01,420
جميعكم من القسم 2، صحيح؟

74
00:06:01,420 --> 00:06:04,680
.أنا ألبيرت، صديقٌ قديم لغلين ريدارس

75
00:06:04,680 --> 00:06:06,420
.وهذه ريل

76
00:06:06,420 --> 00:06:10,940
،سمعتُ أنّه بدأ يُدرّس في هذه المدرسة
،لذا أتيتُ لأشاهد ذلك

77
00:06:10,940 --> 00:06:14,250
.لكن حدث أمر طارئ ولا يستطيع غلين الإفلات منه

78
00:06:15,300 --> 00:06:17,680
.لذا فقد وكّلني برسالةٍ لأبلّغها لكم جميعًا

79
00:06:17,980 --> 00:06:21,340
".سأدع ألبيرت يقود القسم"

80
00:06:22,330 --> 00:06:23,070
...وأيضًا

81
00:06:25,920 --> 00:06:27,900
".فوزوا، رجاءً"

82
00:06:28,920 --> 00:06:30,160
.هذا كلّ شيء

83
00:06:30,520 --> 00:06:32,400
فوزوا رجاءً"؟"

84
00:06:32,400 --> 00:06:34,950
...لكنّ سماع هذا من شخص غريب

85
00:06:36,640 --> 00:06:39,500
.ثقوا بنا رجاءً

86
00:06:41,520 --> 00:06:42,830
...أنت

87
00:06:47,010 --> 00:06:48,170
.مفهوم

88
00:06:48,800 --> 00:06:51,480
.قد قسمنا أرجوك يا ألبيرت-سان

89
00:06:51,480 --> 00:06:52,560
!سيستين؟

90
00:06:52,560 --> 00:06:54,640
هل أنت واثقة منهما؟

91
00:06:55,220 --> 00:06:59,500
أيًّا كان قائدنا، فحاجتنا لم تتغيّر، صحيح؟

92
00:06:59,500 --> 00:07:02,350
.سنهزم القسم 1 ونفوز سويًّا

93
00:07:02,350 --> 00:07:04,440
...هذا صحيح، لكن

94
00:07:04,440 --> 00:07:07,900
...أيضًا، إن خسرنا في غياب المعلّم، حينها

95
00:07:08,350 --> 00:07:12,670
أنتم يائسون من دوني حقًّا، أليس كذلك؟

96
00:07:12,670 --> 00:07:16,910
!آسفٌ لجعلكم تخسرون لأنّني انسحبتُ قبل النّهاية

97
00:07:16,910 --> 00:07:17,840
.سيقول ذلك حتمًا

98
00:07:17,840 --> 00:07:20,140
!هذا مزعج! مزعجٌ حقًّا

99
00:07:20,140 --> 00:07:23,420
سماع ذلك المعلّم الغبيّ يقول ذلك
.هو ما لا أستطيع احتماله

100
00:07:23,420 --> 00:07:26,170
!تبًّا! سنفعلها! سننجح بهذا

101
00:07:28,000 --> 00:07:30,170
.والآن، دخلت منافسة السّحر مراحلها النّهائيّة

102
00:07:30,560 --> 00:07:33,720
!الاستعراض القويّ للقسم 2 بدأ يفقد قوّته

103
00:07:33,720 --> 00:07:38,700
،وإن خسروا في المنافسة التّالية
!فسيفقد القسم 2 أيّ آمالٍ بالفوز

104
00:07:38,700 --> 00:07:41,560
.يبدو أنّ غلين ريدارس ليس هناك فعلاً

105
00:07:42,130 --> 00:07:45,940
.من دونه، فالقسم 2 ليس سوى جماعة غير منظّمة

106
00:07:46,520 --> 00:07:48,670
!سيتا، اسحقهم جميعًا في آنٍ واحد

107
00:07:48,670 --> 00:07:49,940
.حاضر يا معلّم هارلي

108
00:07:52,240 --> 00:07:56,640
!عجبًا! لقد تحوّل المتنافس سيتا إلى تنّين رائع

109
00:07:56,640 --> 00:07:57,520
...علاماته هي

110
00:07:57,520 --> 00:08:01,080
‫9 و9 و10 و9، المجموع هو 37!

111
00:08:01,080 --> 00:08:03,050
!هل حسمَ هذا النّزال؟

112
00:08:03,050 --> 00:08:05,630
...هـ-هذا مستحيل

113
00:08:06,920 --> 00:08:08,650
ألبيرت-سان؟

114
00:08:10,320 --> 00:08:13,500
.يبدو أنّك مارستِ تدريب التّصوّر بشدّة

115
00:08:14,250 --> 00:08:15,580
.لذا اهدئي واخرجي إليهم

116
00:08:15,580 --> 00:08:18,380
.هذه منافسة السّحر. إنّه مهرجان

117
00:08:18,380 --> 00:08:24,820
حتّى لو فشلتِ، فسأوقف كلّ من يحاول
.أن يلومك بقبضتي الحديديّة

118
00:08:25,380 --> 00:08:28,840
.إنّه يبدو كالمعلّم غلين

119
00:08:29,250 --> 00:08:29,820
مفهوم؟

120
00:08:30,340 --> 00:08:31,300
.أجل

121
00:08:31,780 --> 00:08:34,660
!والآن، التّالي هي لين-تشان من القسم 2

122
00:08:34,990 --> 00:08:37,620
!أيّ تحوّلٍ سترينا إيّاه يا ترى؟

123
00:08:39,410 --> 00:08:43,040
!اشهدوا وهمي الّذي شرعته بنفسي

124
00:08:43,960 --> 00:08:46,260
.راقبني يا معلّم

125
00:08:54,000 --> 00:08:55,500
!إنّها ملاك

126
00:08:55,500 --> 00:09:00,720
صورةٌ للا تيليكا من فنّ دراسة الأيقونات
!قد امتثلت أمامنا

127
00:09:01,140 --> 00:09:04,350
‫10، 10، 10، 10! علامة كاملة من 40 نقطة!

128
00:09:04,350 --> 00:09:06,100
!لقد هزمت المتنافس سيتا

129
00:09:06,100 --> 00:09:08,520
!تهديد القسم 2 قد عاد مدويًّا

130
00:09:11,020 --> 00:09:12,510
!التّالي هو غرانزيا

131
00:09:12,510 --> 00:09:14,700
!لقد صنعوا عودةً كبيرة بالتّعويذة التّفاعليّة

132
00:09:14,700 --> 00:09:18,140
!أكسبهم عملهم الجماعيّ الرّائع الفوز

133
00:09:18,140 --> 00:09:19,530
!يا معلّم، لقد نجحنا

134
00:09:19,530 --> 00:09:23,830
!وها قد لحق القسم 2 أخيرًا بالقسم 1

135
00:09:23,830 --> 00:09:26,830
فمن سيفوز بمنافسة السّحر هذا العام؟

136
00:09:27,730 --> 00:09:31,400
!ستُحسم النّتيجة عبر الحدث الأخير، نزالات السّحر

137
00:09:35,230 --> 00:09:36,840
ألم تلقوا القبض عليهما بعد؟

138
00:09:36,840 --> 00:09:41,470
فـ-في الواقع، ذلك المعلّم السّحريّ
.يساعدها على الهروب

139
00:09:41,470 --> 00:09:43,970
وما الّذي أخّركم أمام ساحرٍ واحد؟

140
00:09:44,600 --> 00:09:46,980
،جدوا الأميرة فورًا

141
00:09:47,990 --> 00:09:49,160
.واقتلوها

142
00:09:51,400 --> 00:09:54,900
،نحن في خضمّ المبارزة
!ولا أحد يتراجع خطوة واحدة

143
00:09:55,190 --> 00:10:00,700
إلاّ أنّ عنصر الأرض الّذي استدعاه المتنافس
!غيبول قد قبض على المتنافس كرايس

144
00:10:01,090 --> 00:10:02,460
!أ-أستسلم

145
00:10:02,980 --> 00:10:05,160
!المتنافس كرايس يستسلم

146
00:10:05,520 --> 00:10:07,320
،ثاني متنافس يساند القسم 2 هو غيبول

147
00:10:07,320 --> 00:10:11,240
!معوّضًا لهزيمة كراش ويعيد النّزال إلى نتيجة 1 مقابل 1

148
00:10:11,240 --> 00:10:13,760
!لقد أنقذتنا يا غيبول

149
00:10:13,760 --> 00:10:16,050
.لقد كانت النّتيجة الطّبيعيّة

150
00:10:16,050 --> 00:10:18,320
!لقد بات النّزال معتمدًا أخيرًا على المتنافسين الأخيرين

151
00:10:18,320 --> 00:10:22,140
،لدينا المتنافس هاينكل من القسم 1
.والمتنافسة سيستين من القسم 2

152
00:10:22,140 --> 00:10:25,150
،إنّها مواجهة بين هذان الاثنان
!كلّ منهما يمثّل عامهما الدّراسيّ

153
00:10:25,150 --> 00:10:26,640
.حان دوري أخيرًا

154
00:10:26,640 --> 00:10:28,890
.لقد جهّزتهم لك

155
00:10:28,890 --> 00:10:30,400
.فآمل ألاّ تهدريهم

156
00:10:30,880 --> 00:10:33,650
ألا يفترض بك أن تقول "أدع الباقي عليك"؟

157
00:10:33,950 --> 00:10:35,840
"،إن حقّقتم الانتصار"

158
00:10:35,840 --> 00:10:38,150
"!فسأدعكم تأكلون وتشربون كما شئتم"

159
00:10:38,590 --> 00:10:40,120
.هذا ما قاله غلين

160
00:10:41,640 --> 00:10:43,160
.إنّنا نعتمد عليكم

161
00:10:43,160 --> 00:10:45,660
!بوسعك أن تعتمد علينا

162
00:10:51,280 --> 00:10:55,670
المتنافسة سيستين تتعثّر بالجدار
!النّاريّ للمتنافس هاينكل

163
00:10:56,000 --> 00:10:57,850
!أجهز عليها يا هاينكل

164
00:10:57,850 --> 00:10:58,570
.حاضر

165
00:10:59,230 --> 00:11:01,010
!تماسكي يا سيستين

166
00:11:01,010 --> 00:11:05,010
!سنأكل على حساب المعلّم غلين إن فزتِ

167
00:11:05,600 --> 00:11:07,270
.فوزوا رجاءً

168
00:11:07,880 --> 00:11:10,190
.ثقوا بنا رجاءً

169
00:11:10,920 --> 00:11:14,730
!أعلم ذلك

170
00:11:15,980 --> 00:11:19,740
،اتركهم في منأى يا جدار الإعصار

171
00:11:19,740 --> 00:11:21,750
!وامنح السّلام لمن هم أسفلك

172
00:11:24,770 --> 00:11:27,240
!هل أنا مبروط بالرّياح؟ أيّ تعويذة هذه؟

173
00:11:27,240 --> 00:11:28,750
!جدار العاصفة

174
00:11:28,750 --> 00:11:30,670
تعويذة تحريف؟

175
00:11:30,670 --> 00:11:31,920
—أرواح الرّعد

176
00:11:31,120 --> 00:11:31,920
!بطيء

177
00:11:32,280 --> 00:11:33,790
!اسمعيني أيّتها الرّياح العاتية

178
00:11:39,130 --> 00:11:41,050
!ا-انتهى الأمر

179
00:11:41,050 --> 00:11:45,720
ضربة الإعصار الخاصّة بالمتنافسة سيستين
!قد عصفت بالمتنافس هاينكل خارج الحلبة

180
00:11:45,720 --> 00:11:47,160
!الفائزون هم القسم 2

181
00:11:47,160 --> 00:11:48,800
!القسم 2 يفوز

182
00:11:51,290 --> 00:11:52,580
!نجحنا

183
00:11:59,360 --> 00:12:00,360
.هذه نهاية طريقكما

184
00:12:03,890 --> 00:12:06,370
.والآن، حفل تتويج الفائز

185
00:12:06,930 --> 00:12:09,320
،الفائز، القسم 2 للسّنة الثّانية

186
00:12:09,320 --> 00:12:13,370
.سيتلقى ميداليّةً من جلالة الملكة أليسيا السّابعة

187
00:12:13,370 --> 00:12:16,230
!ها هم الفائزون، القسم 2 للسّنة الثّانية

188
00:12:17,400 --> 00:12:18,210
ماذا؟

189
00:12:19,730 --> 00:12:22,170
ألبيرت وريل؟

190
00:12:22,170 --> 00:12:23,390
.نجحت

191
00:12:24,630 --> 00:12:29,220
المعلّم الممثّل للقسم الفائز بمنافسة السّحر

192
00:12:29,650 --> 00:12:33,730
.سيحظى بفخر تلقّي الميداليّة مباشرةً من جلالتها

193
00:12:34,090 --> 00:12:36,960
.لقد كنت أنظر هذه اللّحظة

194
00:12:40,800 --> 00:12:43,240
!المعلّم غلين وروميا؟

195
00:12:43,560 --> 00:12:45,860
!مستحيل! يفترض بكما أن تكونا هاربين الآن

196
00:12:47,820 --> 00:12:50,480
.لقد تبادلنا الأماكن مع صديقين في الطّريق

197
00:12:50,480 --> 00:12:52,450
.باستخدام الوهم الذّاتيّ

198
00:12:53,040 --> 00:12:55,460
!كنت أعلم! لقد كنتِ روميا

199
00:12:56,210 --> 00:12:57,750
!نالوا منهما

200
00:12:57,750 --> 00:12:58,750
.تراجعوا

201
00:12:59,840 --> 00:13:00,800
...هذا

202
00:13:03,170 --> 00:13:04,550
حاجز عازل؟

203
00:13:05,060 --> 00:13:06,800
.كم أنتِ مراعية للآخرين يا سيليكا

204
00:13:06,800 --> 00:13:08,120
...سيليكا-دونو

205
00:13:08,120 --> 00:13:10,930
،والآن، قد تكون هذه جرأة منّي يا جلالتك

206
00:13:10,930 --> 00:13:17,690
لكنّ ذلك الرجل والحرس الإمبراطوريّ يستخدمون
.اسمكِ ظلمًا ويحاولون قتل فتاةٍ بريئة

207
00:13:17,690 --> 00:13:19,310
!اصمت أيّها الخائن

208
00:13:19,780 --> 00:13:24,550
لكنّي تمكّنتُ من حماية روميا والحرس
.الإمبراطوريّ خارج هذا الحاجز

209
00:13:24,950 --> 00:13:29,320
يا جلالتك، ألتمس منك أن تأمريهم
.بإيقاف هذا العنف الطّائش

210
00:13:29,810 --> 00:13:32,200
.لا يمكننا ذلك

211
00:13:32,200 --> 00:13:33,570
ماذا؟

212
00:13:33,570 --> 00:13:37,060
.عندما ينتهي كلّ هذا، سأتحمّل المسؤوليّة وأقتل نفسي

213
00:13:37,480 --> 00:13:38,710
...لكنّ جلالتها

214
00:13:39,360 --> 00:13:41,840
،جلالتها، الشّخص الّذي يحمل هذه البلاد على عاتقه

215
00:13:41,840 --> 00:13:44,210
!سيتمّ حمايتها بأيّ ثمن

216
00:13:44,660 --> 00:13:46,330
وجلاتها أيضًا

217
00:13:46,330 --> 00:13:50,970
!يجب أن تضحّي بالكثير من الأشياء لتحافظ على حياتها

218
00:13:51,480 --> 00:13:53,040
.ليس هنالك وقت

219
00:13:53,040 --> 00:13:56,310
.يا جلالتك، أرجوك أصدري قرارك، لأجل الّشعب

220
00:14:00,320 --> 00:14:01,640
.هذا أمرٌ مباشر

221
00:14:03,680 --> 00:14:08,250
.وجّهوا السّيف لعنق تلك الفتاة، روميا تينغل

222
00:14:09,190 --> 00:14:12,660
.لا يمكنني أن أسمح لتلك الفتاة أن تعيش

223
00:14:13,110 --> 00:14:14,970
.أتمنى لو أنّها لم تتواجد أبدًا

224
00:14:14,970 --> 00:14:17,410
.لم أحبّها إطلاقًا

225
00:14:18,180 --> 00:14:23,340
.وسأندم ما حييت على ولادتي لها

226
00:14:23,340 --> 00:14:27,180
!انتظري يا جلالتك
لِمَ قد تكذبين هكذا؟

227
00:14:27,180 --> 00:14:28,300
...أهكذا

228
00:14:29,880 --> 00:14:32,220
تشعرين حقًّا؟

229
00:14:34,090 --> 00:14:34,720
.نعم

230
00:14:38,270 --> 00:14:41,060
.أنا ممتنّ لحكمك السّريع يا جلالتك

231
00:14:43,800 --> 00:14:45,360
!سيليكا، ما الّذي يجري؟

232
00:14:46,740 --> 00:14:49,180
سحقًا! كيف حدث هذا؟

233
00:14:49,180 --> 00:14:52,660
.ظننتُ أنّ كلّ شيء سيتصلّح إن وقفنا أمام جلالتها

234
00:14:53,400 --> 00:14:56,080
.كنت أعرف أنّها ما كانت لتقبل بي

235
00:14:56,400 --> 00:14:58,620
.ما كانت لتراني كأمّها الآن

236
00:15:05,190 --> 00:15:08,880
لكن لِمَ تكذب الآن؟

237
00:15:08,880 --> 00:15:13,050
.إن أرادت أن تقتل روميا حقًّا لقالت "اقتلوها" وحسب

238
00:15:17,470 --> 00:15:19,890
إذًا هناك سببٌ يمنعها من البوح بالحقيقة؟

239
00:15:20,500 --> 00:15:23,650
،لا يمكنني أن أفعل أيّ شيء
.لا يمكنني أن أفعل أيّ شيء

240
00:15:24,150 --> 00:15:27,520
.وحدك تستطيع حلّ هذا الوضع

241
00:15:27,520 --> 00:15:28,610
...أيعقل

242
00:15:30,690 --> 00:15:34,570
.يا جلالتك، يا لها من قلادةٍ جميلة

243
00:15:37,590 --> 00:15:39,180
أليست كذلك؟

244
00:15:39,180 --> 00:15:41,580
.إنّها المفضّلة لديّ

245
00:15:41,850 --> 00:15:44,200
المفضّلة؟

246
00:15:44,740 --> 00:15:47,050
لكن أليست ثقيلةً على عنقك؟

247
00:15:47,050 --> 00:15:48,840
ألا يجب أن تنزعيها؟

248
00:15:49,160 --> 00:15:50,600
.على الإطلاق

249
00:15:50,600 --> 00:15:52,470
.لا أريد نزعها

250
00:15:53,760 --> 00:15:54,930
.فهمت

251
00:15:55,210 --> 00:15:57,430
ما الّذي تنوي إليه أيّها السّاحر؟

252
00:15:58,000 --> 00:15:59,000
،روميا

253
00:16:00,250 --> 00:16:04,900
.أمّك تحبّك حقًّا

254
00:16:06,190 --> 00:16:07,770
!لا تتحرّك

255
00:16:10,190 --> 00:16:11,360
!يا معلّم

256
00:16:13,920 --> 00:16:14,570
!فلتمت

257
00:16:15,070 --> 00:16:16,570
!لا

258
00:16:24,550 --> 00:16:26,870
!يا جلالتك، ما الّذي...؟

259
00:16:38,100 --> 00:16:41,720
.إذًا فقد كانت قلادةُ تعويذةَ لعنة متفاعلة

260
00:16:43,000 --> 00:16:45,710
.إن نزعتها، فسيموت مرتديها

261
00:16:45,710 --> 00:16:48,120
.إن مرّ وقتٌ مُحدّد، فسيموت

262
00:16:48,120 --> 00:16:50,400
.إن كشف كيف تُبطل اللّعنة، فسيموت

263
00:16:51,000 --> 00:16:54,150
إنّها حيلة كلاسيكيّة أمست واهنة
.من كثرة الاستعمال

264
00:16:54,580 --> 00:16:56,160
وطريقة تبديدها

265
00:16:57,490 --> 00:16:59,940
كانت عبر قتل روميا، أليس كذلك؟

266
00:17:02,370 --> 00:17:04,320
.لقد كنت مؤمنة بك يا غلين

267
00:17:04,320 --> 00:17:07,710
...كدتُ أموت! تبًّا

268
00:17:08,180 --> 00:17:10,590
لِمَ لم تُفعَّل اللّعنة؟

269
00:17:14,160 --> 00:17:16,220
أركانا المخادع؟

270
00:17:16,220 --> 00:17:20,890
ماذا؟! الختم التّامّ للسّحر ضمن منطقة معيّنة؟

271
00:17:21,280 --> 00:17:22,940
...أنت! هل كنتَ

272
00:17:24,100 --> 00:17:27,360
.والآن يا جلالتك، يجب أن تتوقّفي عن الكذب

273
00:17:27,360 --> 00:17:29,210
ماذا؟ كذب؟

274
00:17:30,360 --> 00:17:34,340
.أجل. إن زلّ لسانها بينما تتكلّم، لتفعّلت اللّعنة

275
00:17:34,860 --> 00:17:39,400
.لقد كان كلّ ذلك لغزًا لجعلي أدركُ أنّ هناك لعنة

276
00:17:40,930 --> 00:17:42,910
!أنا آسفة يا إرميانا

277
00:17:43,240 --> 00:17:46,090
!لقد آذيتك مجدّدًا

278
00:17:46,640 --> 00:17:47,920
جلالتك؟

279
00:17:48,310 --> 00:17:49,600
...أنا مسرورة

280
00:17:49,600 --> 00:17:51,030
.أنا مسرورة حقًّا لأنّك بخير

281
00:17:55,540 --> 00:17:56,940
!أمّي

282
00:18:06,520 --> 00:18:08,140
!جلالتها بخير

283
00:18:17,960 --> 00:18:20,700
.لقد عُيّنا بمهمّتين

284
00:18:21,160 --> 00:18:25,790
كانت الأولى مراقبة الحرس الإمبراطوريّ
.الّذي أظهر علاماتٍ للتّطرّف مؤخرًا

285
00:18:26,210 --> 00:18:30,290
.وكانت الثّانية التّحقيق في خلفية المقرّبين إلى جلالتها

286
00:18:30,680 --> 00:18:34,870
أيّتها السّاحرة الزّنديقة من باحثي
،الحكمة الإلهيّة، إليانور تشاليت

287
00:18:35,560 --> 00:18:39,800
.ستخبرينا لماذا حاولت قتل الأميرة السّابقة

288
00:18:40,160 --> 00:18:43,810
.أرى أنّ الإمبراطوريّة لا تعجّ بالحمقى وحسب

289
00:18:45,540 --> 00:18:47,560
."السّجلات الأكاشيّة"

290
00:18:49,230 --> 00:18:52,650
.سأخبركم فقط أنّ هذا هو الغرض من الأميرة

291
00:18:52,650 --> 00:18:53,780
!لن تهربي

292
00:19:02,520 --> 00:19:04,410
رئيسة خدم جلالتها؟

293
00:19:05,270 --> 00:19:08,300
هذا يدلّ أنَّ باحثي الحكمة الإلهيّة قد تسلّلوا

294
00:19:08,300 --> 00:19:10,170
.بهذا القدر داخل جوهر الإمبراطوريّة

295
00:19:10,710 --> 00:19:13,190
إذًا لا بدّ من وجود آخرين؟

296
00:19:13,650 --> 00:19:16,830
.يجب أن أعود وأتّخذ التّدابير المضّادة فورًا

297
00:19:16,830 --> 00:19:18,170
.توخّ الحذر أيضًا

298
00:19:19,350 --> 00:19:22,890
.شكرًا لكما على كلّ شيء يا ألبيرت ويا ريل

299
00:19:23,600 --> 00:19:25,930
.غلين، سنسوّي الأمر في المرّة القادمة

300
00:19:25,930 --> 00:19:27,230
.أكيد

301
00:19:27,230 --> 00:19:28,860
!مهلاً، مستحيل

302
00:19:30,770 --> 00:19:31,960
!يا معلّم

303
00:19:34,160 --> 00:19:35,230
كيف سار الأمر؟

304
00:19:40,440 --> 00:19:41,960
هل ستذهبين الآن؟

305
00:19:41,960 --> 00:19:46,330
.أجل. أشعر وكأنّها صارحتني بكافّة مشاعرها

306
00:19:46,850 --> 00:19:48,940
.كلّ هذا بفضلك يا سيليكا

307
00:19:49,600 --> 00:19:54,830
،أرجوك واصلي الاعتناء بها
.حتّى تستطيع الاستمتاع بصحّتها وسعادتها

308
00:19:55,110 --> 00:19:58,130
.أجل. آمني بغلين

309
00:19:58,820 --> 00:20:01,880
أشعر بحالٍ أفضل بكثير بعد
.أن صارحتُ أمّي بما كان بداخلي

310
00:20:02,240 --> 00:20:04,960
.كلّ ذلك بفضلك يا معلّم

311
00:20:04,960 --> 00:20:06,760
.لم أفعل شيئًا

312
00:20:08,280 --> 00:20:10,480
يا معلّم، كيف عرفت؟

313
00:20:11,240 --> 00:20:13,480
أنّ أمّي كانت تكذب؟

314
00:20:16,290 --> 00:20:19,570
،قبل ثلاث سنوات، عندما كنتِ مخطوفة

315
00:20:19,960 --> 00:20:21,700
.طلبت جلالتها مساعدتي

316
00:20:22,150 --> 00:20:24,220
.أرجوك يا غلين

317
00:20:24,220 --> 00:20:28,310
أعلم أنّني لستُ في موقفٍ يسمح لي
،بطلب هذا من أيّ أحد

318
00:20:28,880 --> 00:20:33,550
!لكن مع ذلك، أنقذها رجاءً! أنقذ إرميانا

319
00:20:34,660 --> 00:20:36,970
.رأيتُ دموعها بأمّ عينيّ

320
00:20:37,780 --> 00:20:39,750
.فهمت

321
00:20:40,240 --> 00:20:45,130
.إذًا لهذا تذكّرتَ وعدنا قبل ثلاث سنوات

322
00:20:45,860 --> 00:20:47,180
.ما زال هنالك أعداء

323
00:20:47,890 --> 00:20:50,270
،لكِ أن تخافي منّي كما تشائين

324
00:20:50,930 --> 00:20:54,340
...لكن إن توقّفت عن البكاء، فحينها

325
00:20:55,670 --> 00:20:59,030
".سأكون إلى جانبك بكل تأكيد"

326
00:20:59,480 --> 00:21:00,530
".أعدك"

327
00:21:01,030 --> 00:21:03,660
.لا أصدّق أنّ تلك الكلمات ما تزال صادقة

328
00:21:04,520 --> 00:21:06,570
.الوعد يبقى وعدًا في النّهاية

329
00:21:07,400 --> 00:21:10,600
.لقد ساعدتي مجدّدًا

330
00:21:10,600 --> 00:21:12,700
.أنت وأمّي

331
00:21:13,200 --> 00:21:15,560
.لقد عملوا بجدٍّ أيضًا

332
00:21:16,660 --> 00:21:20,640
.لقد كسبتُ الجائزة وراتب ثلاثة أشهر أيضًا

333
00:21:20,640 --> 00:21:22,510
.أفترض أنّي أستطيع مجازاتهم قليلاً

334
00:21:23,320 --> 00:21:26,380
!يا معلّم! لقد كنا بانتظارك

335
00:21:27,680 --> 00:21:31,100
!لقد تأخّرت كثيرًا

336
00:21:32,440 --> 00:21:33,810
!ما الّذي يجري يا سيستي؟

337
00:21:34,240 --> 00:21:38,190
!لقد أكلت الكثير من الكعك المخمّر في التّحلية

338
00:21:38,190 --> 00:21:43,680
يا معلّم، لقد ساعدتَ روميا-تشان مجدّدًا، أليس كذلك؟

339
00:21:43,680 --> 00:21:45,930
.أنا منبهرة

340
00:21:46,660 --> 00:21:48,510
!توقّفي أيّتها القطّة البيضاء

341
00:21:48,510 --> 00:21:50,010
!وجهك قريب

342
00:21:52,870 --> 00:21:57,350
مال الجائزة وراتب ثلاثة أشهر
!قد ذهب في طرفة عين؟

343
00:21:59,890 --> 00:22:02,030
!شكّلوا طابورًا جميعًا

344
00:22:02,030 --> 00:22:05,080
!سأضربكم جميعًا بشعاع الانقراض

345
00:22:05,080 --> 00:22:07,660
!مرحى

346
00:23:44,980 --> 00:23:47,920
!باحثو الحكمة الإلهيّة منظّمة مخيفة بحقّ

347
00:23:47,920 --> 00:23:50,240
ماذا يخطّطون بظنّك؟

348
00:23:51,570 --> 00:23:55,260
لستُ واثقة من السّبب، لكن أشعر وكأنّها
!تعلم شيئًا عن باحثي الحكمة الإلهيّة

349
00:23:55,260 --> 00:23:57,100
.لست واثقة من السّبب، لكن أظنّ ذلك أيضًا

350
00:23:57,100 --> 00:23:57,990
!سأسألها

351
00:23:57,990 --> 00:23:59,290
!روميا، ذلك خطير

352
00:23:59,290 --> 00:24:01,620
أيّ مجموعة هم باحثو الحكمة الإلهيّة؟

353
00:24:02,440 --> 00:24:03,880
أتسألينني هذا؟

354
00:24:03,880 --> 00:24:04,880
!بلع

355
00:24:04,880 --> 00:24:06,880
...باحثو الحكمة الإلهيّة

356
00:24:06,880 --> 00:24:10,190
هي مجموعة حيث نحظى بالمرح بأكل
!الوجبات الخفيفة والتّدرّب على السّحر سويًّا

357
00:24:10,190 --> 00:24:10,860
ماذا؟

358
00:24:10,460 --> 00:24:11,380
!مذهل

359
00:24:11,380 --> 00:24:13,200
!إنّنا نرحبّ بكلّ من يحبّ السّحر

360
00:24:13,200 --> 00:24:13,850
