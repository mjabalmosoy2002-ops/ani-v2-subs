1
00:00:05,640 --> 00:00:07,640
.يكفي يا معلّم

2
00:00:07,640 --> 00:00:08,820
.لا أستطيع المتابعة

3
00:00:09,220 --> 00:00:11,850
.أنتِ في أمان يا آنستي الصّغيرة

4
00:00:11,850 --> 00:00:13,780
أظنّ أنَّ هذا أفضل ما يمكن
.لشخص بلا تدريب أن يفعله

5
00:00:14,100 --> 00:00:17,850
أبوسعي أن أتحسّن حقًّا؟

6
00:00:17,850 --> 00:00:22,380
.أجل، لقد تحسّنتِ كثيرًا عن أوّل مرّة بدأتِ فيها

7
00:00:24,790 --> 00:00:26,640
.لا تتعرّضي للبردِ كثيرًا

8
00:00:26,640 --> 00:00:28,670
.أنتِ فتاة في النّهاية

9
00:00:29,860 --> 00:00:32,010
.إنّ به رائحة المعلّم

10
00:00:35,470 --> 00:00:37,930
...بالحديث عن الأمر يا معلّم، لِمَ نحن

11
00:00:39,180 --> 00:00:41,560
!نتدرّب على القتال القريب؟

12
00:00:42,950 --> 00:00:46,570
!عرفت أنّ الوقت قد حان لهذا الرّدِّ منك

13
00:01:06,790 --> 00:01:10,920
السّجلاّت الأكاشيّة
للمعلّم السّحريّ الوغد

14
00:02:26,630 --> 00:02:29,850
،لقد ذكرتَ تدريبًا خاصًّا
فظننتُ أنّنا سنتعلّم

15
00:02:29,850 --> 00:02:32,710
.تعاويذَ جديدة أو كيف نرفَعُ من طاقتنا السّحريّة

16
00:02:32,710 --> 00:02:34,640
،إن تدرّبتِ على القتال القريب

17
00:02:34,640 --> 00:02:38,010
فستشحذين من حواسكِ لتعرفي متى
.تهاجمين وتدافعين في النّزالات السّحريّة

18
00:02:39,060 --> 00:02:43,180
أشعر وكأنّك تنفّس عن إحباطك
.بسبب محاضراتي المستمرّة

19
00:02:43,180 --> 00:02:44,700
.بالطّبع، هذا جزءٌ من الأمر أيضًا

20
00:02:44,700 --> 00:02:45,560
!حقًّا؟

21
00:02:45,560 --> 00:02:48,620
،في الوقت الحاضر، سنركّز على القتال القريب

22
00:02:48,620 --> 00:02:52,400
،وفور أن تصبحي متمكّنةً كفايةً منه
.سأعلّمك السّحر العسكريّ

23
00:02:53,120 --> 00:02:55,020
السّحر العسكريّ؟

24
00:02:55,020 --> 00:02:56,650
هل أنت خائفة؟

25
00:02:56,650 --> 00:03:01,320
لكن إن أردتِ أن تحمي روميا حقًّا
.إن اقتضى الأمر، فسوف تحتاجين للقوّة

26
00:03:01,720 --> 00:03:03,020
.لا تقلقي

27
00:03:03,020 --> 00:03:08,520
إن كنتِ خائفة من السّحر العسكريّ
،فلن تتأثّري من الجانب الظّلاميّ للسّحر

28
00:03:08,520 --> 00:03:11,080
.وأعتقد أنّكِ تستطيعين أن تستعمليه كما يجب

29
00:03:15,870 --> 00:03:19,720
.وسيكون من الأفضل دائمًا إن لم يحن ذلك الوقت

30
00:03:21,860 --> 00:03:25,850
!أرجوكَ واصل توجيهي وتشجيعي

31
00:03:36,000 --> 00:03:38,350
!يا معلّم! صباح الخير

32
00:03:38,350 --> 00:03:39,650
.صباح الخير

33
00:03:39,960 --> 00:03:41,820
.يا معلّم، تبدو في حالة فظيعة

34
00:03:41,820 --> 00:03:43,280
ألم تحظى بقدرٍ كافٍ من النّوم؟

35
00:03:43,280 --> 00:03:44,660
،أنت قلقٌ على روميا

36
00:03:44,660 --> 00:03:47,980
لذا فقد كنتَ في انتظارها طوال
اليوم، أليس كذلك يا معلّم؟

37
00:03:47,980 --> 00:03:49,370
.الأمر ليس هكذا

38
00:03:49,370 --> 00:03:52,880
.فلتهوّن على نفسك ولا تقلق بشأني

39
00:03:52,880 --> 00:03:56,090
صودف فقط أنّني عبرتُ من نفس
.الشّارع وفي نفس الوقت

40
00:04:04,040 --> 00:04:05,970
.لقد كنتُ منتظرةً لقاءك يا غلين

41
00:04:05,970 --> 00:04:08,170
...ر-ري

42
00:04:08,170 --> 00:04:10,120
!ماذا تفعلين؟

43
00:04:10,120 --> 00:04:11,240
!هل تحاولين قتلي؟

44
00:04:12,770 --> 00:04:13,810
أحيّيك؟

45
00:04:15,020 --> 00:04:17,000
!كيف لهذه أن تكون تحيّة؟

46
00:04:17,000 --> 00:04:20,940
لكنّ ألبيرت قال أنّ هذا ما يجب عليّ
.فعله عندما أجتمع مع رفيقي في السّلاح

47
00:04:20,940 --> 00:04:22,840
!أهذه غلطته؟

48
00:04:22,840 --> 00:04:25,240
!هل يكرهني بذلك القدر؟

49
00:04:25,240 --> 00:04:28,080
.إنّها تلك الفتاة من منافسة السّحر

50
00:04:28,080 --> 00:04:29,770
رييل، صحيح؟

51
00:04:29,770 --> 00:04:31,330
...وذاك الزّيّ

52
00:04:31,750 --> 00:04:32,640
...لا يعقل أنّك

53
00:04:32,640 --> 00:04:34,210
!هل أنتِ التّلميذة المنتقلة؟

54
00:04:35,090 --> 00:04:36,710
ماذا تقصد؟

55
00:04:37,240 --> 00:04:41,960
يبدو أنّ الحكومة الإمبراطوريّة تريد
.تعيين حارسٍ رسميّ لروميا

56
00:04:41,960 --> 00:04:45,590
.لذا فقد أرسلوا أحد سحرتهم متخفّيًا كتلميذٍ منتقل

57
00:04:45,590 --> 00:04:47,960
...لكن لم أتوقّع أنّهم سيرسلونها من بين الجميع

58
00:04:47,960 --> 00:04:51,710
.هل أتيتِ إلى هنا فقط لأجلي؟ هذا مطمئن

59
00:04:51,710 --> 00:04:53,640
.آمل أن ننسجمَ جيّدًا سويًّا

60
00:04:53,640 --> 00:04:55,550
.أجل، اتركي الأمر لي

61
00:04:55,550 --> 00:04:57,150
.سأحمي غلين

62
00:04:57,900 --> 00:05:00,570
!ستحمين روميا وليس أنا

63
00:05:00,570 --> 00:05:03,280
!روميا-تشان الظّريفة والشّقراء

64
00:05:03,280 --> 00:05:04,110
!مفهوم؟

65
00:05:04,110 --> 00:05:08,870
.لم أفهم، لكن أفضّل أن أحمي غلين عن روميا

66
00:05:08,870 --> 00:05:11,100
!كفّي عن التّفوّه بالهراء

67
00:05:11,100 --> 00:05:12,490
.هذا مؤلم! توقّف

68
00:05:12,490 --> 00:05:16,760
فقط لأكون واضحًا، لا يمكنكِ
!أن تكشفي عن هويّتكِ أو مهمّتك

69
00:05:16,760 --> 00:05:17,600
!قطعًا

70
00:05:17,600 --> 00:05:18,960
!قطعًا، مفهوم؟

71
00:05:18,960 --> 00:05:20,960
...هل سنكون

72
00:05:20,960 --> 00:05:22,500
بخير؟

73
00:05:26,630 --> 00:05:31,610
اعتبارًا من اليوم، ستنضمّ إلينا زميلة
.جديدة، رييل رايفورد

74
00:05:31,610 --> 00:05:33,540
.كونوا لطفاء معها

75
00:05:34,400 --> 00:05:36,800
.بدايةً، عرّفي عن نفسك

76
00:05:36,800 --> 00:05:37,440
.هيّا

77
00:05:37,440 --> 00:05:39,180
.رييل رايفورد

78
00:05:41,190 --> 00:05:43,710
!أيّتها الغبيّة، لقد أخبرتهم باسمك للتّوّ

79
00:05:43,710 --> 00:05:47,280
حدّثيهم عن نفسك قليلاً، اذكري
.هواياتك مثلاً أو ما شابه

80
00:05:47,280 --> 00:05:48,320
.مفهوم

81
00:05:48,880 --> 00:05:50,950
.أنا رييل رايفورد

82
00:05:50,950 --> 00:05:53,300
،وأنا مجنّدة في الجيش الإمبراطوريّ

83
00:05:53,300 --> 00:05:55,830
كما أخدم في القوّات الخاصّة لهيئة
—البلاط السّحريّة اللإمبراطوريّة

84
00:05:57,750 --> 00:05:59,630
...وفي المستقبل أنا

85
00:05:59,630 --> 00:06:02,400
آمل الانضمام إلى الجيش الإمبراطوريّ؟

86
00:06:02,400 --> 00:06:07,380
وأتيت من منطقة إيتيريا؟
لأتعلّم السّحر في هذه المدرسة؟

87
00:06:03,460 --> 00:06:05,680
.إنّها فتاةٌ غريبة

88
00:06:05,680 --> 00:06:07,380
.ومع ذلك هي ظريفة

89
00:06:07,690 --> 00:06:09,440
أحسنوا التّعامل معها، حسنًا؟

90
00:06:09,440 --> 00:06:11,340
هلّي بسؤال؟

91
00:06:11,340 --> 00:06:11,890
.نعم

92
00:06:12,170 --> 00:06:16,100
،قلتِ أنّك أتيتِ من إيتيريا
لكن هل أنت هنا دون والديك؟

93
00:06:17,880 --> 00:06:20,020
...كان لي أخ أكبر، لكن

94
00:06:20,020 --> 00:06:21,550
.آسف

95
00:06:21,550 --> 00:06:24,410
.أرجو أن تتفادوا الأسئلة المتعلّقة بعائلتها

96
00:06:24,410 --> 00:06:25,940
.إنّها لا تملك أيّ أقاربٍ الآن

97
00:06:26,960 --> 00:06:29,610
.أنا حقًّا آسفة! لم أكن أعلم

98
00:06:31,480 --> 00:06:32,160
!عذرًا

99
00:06:32,470 --> 00:06:37,060
يبدو أنّكما تعرفان بعضكما، فما طبيعة علاقتكما؟

100
00:06:37,060 --> 00:06:38,920
علاقتي بغلين؟

101
00:06:38,920 --> 00:06:41,700
...بشأن ذلك

102
00:06:42,790 --> 00:06:44,760
.يمثّل غلين كلّ شيء لي

103
00:06:44,760 --> 00:06:47,380
.لقد قرّرتُ أن أعيش حياتي لأجل غلين

104
00:06:49,920 --> 00:06:51,140
!يا لجسارتها

105
00:06:51,140 --> 00:06:53,100
!فطرت قلبي من الآن

106
00:06:53,100 --> 00:06:55,850
!ماذا؟! ماذا... ما الّذي تقولين؟

107
00:07:02,920 --> 00:07:04,440
!أرواح الرّعد، صدمة

108
00:07:08,340 --> 00:07:09,370
!أجل

109
00:07:09,370 --> 00:07:11,450
.أصبحتِ أفضل بكثير مؤخرًا

110
00:07:11,450 --> 00:07:13,360
.أحسنت أيّتها القطّة البيضاء

111
00:07:13,360 --> 00:07:16,200
إصافة الهدف بكلّ الطّلقات السّتّ
.من هذه المسافة مذهل ببساطة

112
00:07:17,110 --> 00:07:18,660
!كا-كان ذلك طبيعيًّا

113
00:07:19,030 --> 00:07:22,890
.حسنًا... أنت التّالية يا رييل

114
00:07:33,640 --> 00:07:35,770
.والآن، فلنرَ ما تستطيع فعله

115
00:07:35,770 --> 00:07:38,600
قالت بالفعل أنّها تهدف للالتحاق
.بالجيش الإمبراطوريّ

116
00:07:41,010 --> 00:07:45,270
يا أرواح الرّعد، اسمعيني واضربي
.بصدمتك الكهربائيّة

117
00:07:48,400 --> 00:07:52,800
،لم أرَ رييل تستخدم صاعقة الصّدمة من قبل

118
00:07:52,800 --> 00:07:54,360
...لكن لم أتوقّع أنّها بهذا السّوء

119
00:07:56,410 --> 00:07:59,500
هل هي بهيئة سحرة الإمبراطوريّة حقًّا؟

120
00:07:59,500 --> 00:08:00,910
قد تكون متوتّرة؟

121
00:08:03,040 --> 00:08:03,950
ما الخطب؟

122
00:08:03,950 --> 00:08:05,720
.أمامك فرصة واحدة

123
00:08:05,720 --> 00:08:08,250
أيجب أن نستخدم صاعقة الصّدمة لأجل هذا؟

124
00:08:08,250 --> 00:08:09,850
،ليس لأنّك ملزمة بذلك

125
00:08:09,850 --> 00:08:13,130
بل لأنّها التّعويذة الوحيدة الّتي يستطيع التّلاميذ
.استخدامها للإصابة من هذه المسافة

126
00:08:13,130 --> 00:08:15,240
إذًا بوسعي استخدام أيّ تعويذة؟

127
00:08:15,240 --> 00:08:16,430
.إن أدركتْ الهدف

128
00:08:16,430 --> 00:08:17,560
.مفهوم

129
00:08:17,560 --> 00:08:19,140
!السّحر العسكريّ ممنوع

130
00:08:20,480 --> 00:08:25,240
.أناشد الخلق، امنح يداي سيفًا عظيمًا

131
00:08:32,600 --> 00:08:34,910
!رييل! تمهّلي

132
00:08:46,290 --> 00:08:47,700
.أصبتُ الأهداف السّتّة كلّها

133
00:09:00,350 --> 00:09:03,730
.لقد أصبحت الشّخص الأخطر تمامًا في القسم

134
00:09:05,350 --> 00:09:07,980
بالمناسبة يا رييل، ماذا ستأكلين على الغداء؟

135
00:09:08,470 --> 00:09:09,740
.الغداء غير ضروريّ

136
00:09:09,740 --> 00:09:12,070
.بوسعي أن أمتنع عن الطّعام لثلاثة أيّام

137
00:09:12,070 --> 00:09:15,650
لكن إن لم تأكلي ما يكفي، فمن شأن
ذلك أن يعيق عملك، صحيح؟

138
00:09:17,750 --> 00:09:18,740
.لديك وجهة نظر

139
00:09:18,740 --> 00:09:23,200
.إنّنا متّجهزات للمقصف الآن
هل تودّين الانضمام إلينا يا رييل؟

140
00:09:23,200 --> 00:09:24,440
المقصف؟

141
00:09:27,320 --> 00:09:29,290
وصلنا. ما رأيك به؟

142
00:09:30,050 --> 00:09:31,630
.هنالك العديد من الأشخاص

143
00:09:33,280 --> 00:09:34,780
.كما أنّ الرّائحة طيّبة

144
00:09:34,780 --> 00:09:37,220
!هيّا، فلنذهب لطلب الغداء

145
00:09:40,010 --> 00:09:43,340
سأطلب المعتاد، لكن ماذا عنك يا رييل؟

146
00:09:47,920 --> 00:09:49,230
أتريدين تلك؟

147
00:09:49,230 --> 00:09:51,470
أم تفضّلين أخذ نفس طلبي؟

148
00:09:54,050 --> 00:09:56,190
.يبدو أنّك تفضّلين كعكة الفراولة

149
00:10:01,120 --> 00:10:02,890
إذًا؟ أهي لذيذة؟

150
00:10:02,890 --> 00:10:03,680
.نعم

151
00:10:03,680 --> 00:10:06,080
.هذا يسعدني. سيستي تحبّها أيضًا

152
00:10:07,200 --> 00:10:09,830
.أتريدين بعضها؟ سأشاركك إيّاها

153
00:10:14,880 --> 00:10:18,470
!لـ-لا بأس! بوسعك أن تأكليها كلّها بنفسك! لا أمانع

154
00:10:19,720 --> 00:10:20,970
حقًّا؟

155
00:10:20,970 --> 00:10:22,340
.أ-أجل

156
00:10:27,310 --> 00:10:30,960
.بئسًا يا رييل، لديكِ قشدة على وجهك

157
00:10:30,960 --> 00:10:32,490
.حسنًا، اثبتي

158
00:10:33,480 --> 00:10:35,070
.اعتنيتُ بها

159
00:10:36,740 --> 00:10:37,930
.شكرًا

160
00:10:39,160 --> 00:10:41,420
.حاولي ألاّ تسكبي أيًّا منها

161
00:10:47,670 --> 00:10:50,680
متى أصبحتنّ أنتنّ الثّلاثة قريبات هكذا؟

162
00:10:50,680 --> 00:10:52,040
،عندما تراها هكذا

163
00:10:52,040 --> 00:10:55,920
يصعب تصوّر أنّها قد تُلوّح بسيفٍ
.كبيرٍ وتكسر غوليم

164
00:10:57,480 --> 00:10:59,420
.لن يأخذها أحد منك

165
00:11:02,360 --> 00:11:05,120
.لا بأس. بوسعكِ أن تأخذي وقتك

166
00:11:10,800 --> 00:11:13,850
...ترك مسألة حماية روميا إلى رييل

167
00:11:13,850 --> 00:11:16,360
ما الّذي يفكّر به الجيش؟

168
00:11:16,360 --> 00:11:18,840
.سمعتُ أنّها غريبة جدًّا

169
00:11:18,840 --> 00:11:23,160
أجل. آمل أن تأخذ هذا الأمر كفرصةٍ
.لتتعلّم كيف تتآلف بشكلٍ أفضل

170
00:11:23,910 --> 00:11:27,160
أليس هذا دور معلّمها؟

171
00:11:27,410 --> 00:11:28,460
.نعم

172
00:11:29,190 --> 00:11:33,580
آمل أن تستطيع رييل إدراكَ شيءٍ
.أثناء رحلتنا الميدانيّة القادمة

173
00:11:34,080 --> 00:11:35,920
.لا أدري إن كان الأمر سيسير على خيرٍ أم لا

174
00:11:37,540 --> 00:11:40,090
بِتَّ تشبه المعلّمين أكثر، أليس كذلك؟

175
00:11:40,090 --> 00:11:41,460
!اخرسي

176
00:11:42,230 --> 00:11:45,260
على أيّ حال، هل أنتِ هنا للبحث مجدّدًا؟

177
00:11:46,360 --> 00:11:49,210
.نعم

178
00:11:54,600 --> 00:11:58,780
أتمنّى لو أنّنا قصدنا منشأة
.كانتارلي لأبحاث سحرة الجيش

179
00:11:58,780 --> 00:12:00,990
.أفضّل الذّهاب لمكانٍ آخر أيضًا

180
00:12:01,320 --> 00:12:04,610
.قصدُ المكان الّذي تريد هو مسألة حظّ ليس إلاّ

181
00:12:04,610 --> 00:12:09,870
.اطمئّنوا، فأنتم يا رجال محظوظون حتمًا

182
00:12:10,820 --> 00:12:12,080
!فقط فكّروا

183
00:12:12,080 --> 00:12:14,620
أين يقع مختبر أبحاث الخيمياء؟

184
00:12:15,470 --> 00:12:18,210
!في جزيرة ساينيريا، منتجعٌ شاطئيّ شهير

185
00:12:18,210 --> 00:12:19,040
!صحيح

186
00:12:19,040 --> 00:12:21,870
،جزيرة ساينيريا ساخنة على مدار السّنة

187
00:12:21,870 --> 00:12:24,130
إنّها دافئة كفايةً حتّى الآن لنذهب
.ونسبح في ذلك المحيط

188
00:12:24,130 --> 00:12:27,140
!نـ-نسبح

189
00:12:27,140 --> 00:12:29,970
!كما أنّ جميع فتيات القسم بأفضل مستوى

190
00:12:35,240 --> 00:12:36,970
لديكم فرصة للاسترخاء، صحيح؟

191
00:12:36,970 --> 00:12:39,360
!لذا اصمتوا واتبعوني

192
00:12:39,360 --> 00:12:41,950
!أجل

193
00:12:44,360 --> 00:12:48,370
.الفتيان أغبياء للغاية، ومعلّمنا هو الأسوأ بينهم

194
00:12:55,290 --> 00:12:59,340
،أنتنّ ظريفات أيّتها الآنسات الصّغيرات
فما رأيكنّ بهذه البضائع النّادرة؟

195
00:12:59,340 --> 00:13:03,630
هلاّ توقّفت عن ترويج بضاعتك المشبوهة لتلامذتي؟

196
00:13:03,630 --> 00:13:04,800
!ارحلن

197
00:13:06,480 --> 00:13:07,970
.تُعتبر "مشبوهة" إهانة في حقّها

198
00:13:08,330 --> 00:13:12,220
!هذه مقالات نادرة من عائلة ألزانو الإمبراطوريّة

199
00:13:12,220 --> 00:13:14,460
.أجل، أجل، لا يهمّ

200
00:13:15,090 --> 00:13:18,560
إن كنت هنا، فرييل مجرّد طُعم؟

201
00:13:18,830 --> 00:13:20,030
.أجل

202
00:13:20,030 --> 00:13:22,320
.أنا هو الحارس الحقيقيّ وأراقب عن بعد

203
00:13:22,320 --> 00:13:23,930
.توقّعت

204
00:13:23,930 --> 00:13:27,820
إذًا لِمَ كلّفت نفسك عناء التّواصل معي؟

205
00:13:29,280 --> 00:13:30,970
.راقب رييل

206
00:13:31,440 --> 00:13:32,580
.إنّها خطيرة

207
00:13:32,580 --> 00:13:34,480
.هذه ليست مزحةً مضحكة

208
00:13:34,480 --> 00:13:37,040
.كلانا نعلم مسبقًا

209
00:13:38,660 --> 00:13:40,840
.لقد بات ذلك من الماضي

210
00:13:41,130 --> 00:13:43,090
.ساذج كما العادة

211
00:13:43,090 --> 00:13:44,460
.لقد حذّرتك

212
00:13:59,520 --> 00:14:01,560
.إذًا هذه جزيرة ساينيريا

213
00:14:08,030 --> 00:14:09,820
.يا معلّم، تماسك

214
00:14:09,820 --> 00:14:11,160
.غلين، تبدو غريبًا

215
00:14:11,470 --> 00:14:14,170
تبًّا، هل أنت بخير يا معلّم؟

216
00:14:14,170 --> 00:14:17,000
كان يجب عليك اختيار مكانٍ آخر
.إن كنتَ لا تتحمّل ركوب القوارب

217
00:14:17,490 --> 00:14:20,280
.كمختبر كانتورلي لأبحاث سحرة الجيش

218
00:14:21,090 --> 00:14:24,750
النّساء الحسناوات بزيّ السّباحة يأخذن
.الأوليّة على أيّ شيءٍ آخر

219
00:14:26,020 --> 00:14:27,510
أليس كذلك؟

220
00:14:28,350 --> 00:14:32,680
كنتُ سأختار هذا المكان
.ولو كانت الحرب مندلعة فيه

221
00:14:32,680 --> 00:14:34,930
!يا معلّم، سنتبعك دائمًا

222
00:14:35,780 --> 00:14:39,560
.كفّ عن التّفوّه بأشياء غبيّة ولنذهب

223
00:14:40,990 --> 00:14:44,320
.أردتَ أن تبعدنا عن السّحر العسكريّ

224
00:14:44,320 --> 00:14:45,940
لذلك اخترت هذا المكان، أليس كذلك؟

225
00:14:45,940 --> 00:14:47,630
.هذا ليس ما في الأمر

226
00:14:47,630 --> 00:14:50,410
.إنّما أردتُ أن أراكنّ جميعًا بزيّ السّباحة

227
00:14:53,640 --> 00:14:55,200
!مرحى

228
00:14:55,200 --> 00:14:58,710
!سيستي، رييل، تعاليا بسرعة

229
00:14:59,170 --> 00:15:00,570
!أنا آتية

230
00:15:02,130 --> 00:15:04,110
أتريدين أن تسبحي معنا يا رييل؟

231
00:15:04,110 --> 00:15:04,920
.نعم

232
00:15:09,930 --> 00:15:11,710
أرأيتم؟ ماذا قلت لكم؟

233
00:15:11,710 --> 00:15:13,470
.فقط اصمتوا واتبعوني

234
00:15:13,760 --> 00:15:14,830
!يا معلّم

235
00:15:14,830 --> 00:15:17,880
.أنتم أحرار حتّى حلول اللّيل
.اذهبوا واستمتعوا كما شئتم

236
00:15:17,880 --> 00:15:18,560
!أجل

237
00:15:18,560 --> 00:15:20,150
!مرحى

238
00:15:23,480 --> 00:15:25,730
.أنت صارم كالمعتاد

239
00:15:26,180 --> 00:15:28,250
.هذا ليس من شأنك

240
00:15:28,250 --> 00:15:30,610
.لم نأتِ إلى هنا لنلهو

241
00:15:31,840 --> 00:15:34,240
يا معلّم، كيف أبدو؟

242
00:15:34,240 --> 00:15:37,330
!إنّه يبدو جميلاً جدًّا عليك! أنت ظريفة للغاية

243
00:15:37,730 --> 00:15:40,290
شكرًا لك يا معلّم

244
00:15:40,770 --> 00:15:44,140
.أيّتها القطّة البيضاء، لديكِ أسلوبك أيضًا

245
00:15:44,140 --> 00:15:45,380
!في غاية الجمال

246
00:15:47,120 --> 00:15:50,380
.لا تحدّق بي هكذا

247
00:15:55,520 --> 00:15:57,080
.يا إلهي

248
00:15:59,280 --> 00:16:00,490
ما الخطب؟

249
00:16:00,490 --> 00:16:01,850
.لا شيء

250
00:16:03,480 --> 00:16:06,060
.ظننت أنّكن تلعبن جميعًا هناك

251
00:16:06,060 --> 00:16:08,830
.لقد أردنَ لعب الكرة الطّائرة

252
00:16:08,830 --> 00:16:10,650
أتريد أن تنضمّ إلينا أيضًا؟

253
00:16:10,650 --> 00:16:12,650
الكرة الطّائرة الشّاطئيّة؟

254
00:16:12,650 --> 00:16:14,990
.لكن سأصاب بسفعة

255
00:16:15,440 --> 00:16:16,870
!هيّا، أرونا ما لديكم

256
00:16:16,870 --> 00:16:18,280
ما الأمر؟

257
00:16:22,790 --> 00:16:24,500
!اليد الخفيّة

258
00:16:30,160 --> 00:16:31,300
!خذا هذه

259
00:16:42,300 --> 00:16:45,200
،والآن سنبدأ الحدث التّقليديّ لرحلتنا الميدانيّة

260
00:16:45,200 --> 00:16:47,690
"!عملية التّسلّل إلى غرفة الفتيات"

261
00:16:47,690 --> 00:16:49,280
ألا بأس بهذا؟

262
00:16:49,280 --> 00:16:52,650
لا تقلق. لقد استطلعتُ الطّريق
.المؤدّي لغرفة الفتيات بالفعل

263
00:16:52,650 --> 00:16:55,290
.أحسنت يا كاش! أنت متأهّبٌ دائمًا

264
00:16:55,290 --> 00:16:56,990
وماذا عن المعلّم غلين؟

265
00:16:57,360 --> 00:16:58,750
.حسبنا حسابه بالفعل

266
00:16:58,750 --> 00:17:02,700
احتمال أن يقوم المعلّم بدوريّة أثناء
.الثّلاثين دقيقة القادمة شبه منعدم

267
00:17:02,700 --> 00:17:04,840
.مذهل، هذا ممتاز

268
00:17:04,840 --> 00:17:08,480
حسنًا يا رفاق، هل أنتم مستعدّون
لصنع أفضل الذّكريات على الإطلاق؟

269
00:17:09,170 --> 00:17:12,550
.أجل، لن يكون الأمر بتلك السّهولة

270
00:17:12,550 --> 00:17:13,500
!لـ-لا يمكن

271
00:17:13,500 --> 00:17:15,130
!لمَ أنت هنا يا معلّم؟

272
00:17:15,130 --> 00:17:16,170
!يا لكم من أغبياء

273
00:17:16,170 --> 00:17:18,550
...إن كنتُ مكانكم، لكنتُ بالتّأكيد

274
00:17:18,550 --> 00:17:19,550
!لأستعين بهذا الطّريق

275
00:17:19,550 --> 00:17:20,860
!في هذه اللّحظة

276
00:17:20,860 --> 00:17:23,480
!واللّيلة للتّسلّل داخل غرفة الفتيات

277
00:17:24,650 --> 00:17:26,110
.أجل

278
00:17:26,110 --> 00:17:28,650
.لكنّ القوانين تبقى قوانين، لذا عودوا إلى غرفكم

279
00:17:29,680 --> 00:17:31,980
!هنالك أوقات لا يستطيع الرّجل أن يتراجع فيها

280
00:17:31,980 --> 00:17:33,230
!وهذا هو الوقت

281
00:17:33,230 --> 00:17:35,340
!فخرنا على المحك أيضًا

282
00:17:35,340 --> 00:17:36,780
!إنّنا أولاد في طور النّموّ في النّهاية

283
00:17:36,780 --> 00:17:39,790
.فهمت. إذًا فقد جهّزتم أنفسكم لهذا

284
00:17:39,790 --> 00:17:43,200
!إذًا وبصفتي معلّمكم، عليّ أن أزيحكم بالقوّة

285
00:17:44,950 --> 00:17:48,400
!سنهزمك ثمّ سنذهب إلى النّعيم

286
00:17:48,400 --> 00:17:49,500
!هيا بنا جميعًا

287
00:17:49,500 --> 00:17:51,500
!هلمّوا إليّ

288
00:17:54,960 --> 00:17:57,970
.صِدقًا، الفتيان أغبياء

289
00:17:58,520 --> 00:18:01,970
.لم أرَ غلين يستمتع بهذا القدر من قبل

290
00:18:01,970 --> 00:18:06,120
.حقًّا؟ إنّه هكذا طوال الوقت في المدرسة

291
00:18:06,120 --> 00:18:08,190
.لقد كان أكثر حزنًا في الماضي

292
00:18:08,480 --> 00:18:13,570
.لهذا فكّرتُ أنّه عليّ أن أبقى قُربه وأحميه

293
00:18:14,440 --> 00:18:15,720
رييل؟

294
00:18:17,000 --> 00:18:20,170
!يا فتيات، فلنلعب بالبطاقات

295
00:18:20,170 --> 00:18:22,960
!رييل، يجب أن تنضمّي إلينا أيضًا

296
00:18:22,960 --> 00:18:25,020
لعبة؟ البّطاقات؟

297
00:18:25,020 --> 00:18:25,700
أنا أيضًا؟

298
00:18:26,060 --> 00:18:26,880
!أجل

299
00:18:26,880 --> 00:18:30,000
.حسنًا. لم أفهم، لكن سألعب

300
00:18:30,530 --> 00:18:32,180
!فلنباشر

301
00:18:32,960 --> 00:18:35,920
.لقد اندمجت بالفعل

302
00:18:35,920 --> 00:18:37,920
.أجل، بالفعل

303
00:18:46,470 --> 00:18:48,480
...مؤلم

304
00:18:48,480 --> 00:18:51,260
ألا يعرف أولئك الأشخاص أيّ انضباط؟

305
00:18:58,190 --> 00:19:00,820
.حسنٌ، لقد كان ذلك جيّدًا كتغيير في الرّوتين

306
00:19:06,560 --> 00:19:07,840
!جميل

307
00:19:07,840 --> 00:19:09,430
.بالفعل

308
00:19:10,880 --> 00:19:12,040
ما رأيك؟

309
00:19:12,040 --> 00:19:14,600
هل تشعرين بالملل يا رييل؟

310
00:19:17,650 --> 00:19:20,070
...لستُ متأكّدة، لكن

311
00:19:20,520 --> 00:19:23,930
.ما كنتُ سأسأم أبدًا من هذا المظهر

312
00:19:24,320 --> 00:19:28,180
.نحن الاثنتان مسرورتان لمعرفتك يا رييل

313
00:19:28,640 --> 00:19:29,560
لماذا؟

314
00:19:30,000 --> 00:19:31,610
.لا يمكن شرح الأمر

315
00:19:33,020 --> 00:19:36,270
.نحن مسرورتان لأننّا صديقتاك

316
00:19:37,320 --> 00:19:38,530
صديقات؟

317
00:19:43,250 --> 00:19:44,920
...صديقات

318
00:19:44,920 --> 00:19:48,410
.لا أفهم، لكن هذا يروقني نوعًا ما

319
00:19:51,500 --> 00:19:53,900
لماذا أخبرني أن أراقبها؟

320
00:19:53,900 --> 00:19:55,960
.إنّها مجرّد فتاةٍ عاديّة

321
00:20:13,020 --> 00:20:15,360
رييل، ماذا تفعلين؟

322
00:20:16,520 --> 00:20:18,230
.أردتُ أن أراك

323
00:20:19,600 --> 00:20:21,850
.حسنًا، فلنرجع إذًا

324
00:20:22,640 --> 00:20:25,900
لِمَ غادرت؟

325
00:20:27,120 --> 00:20:29,190
...في الواقع

326
00:20:29,780 --> 00:20:34,670
أشعر بالنّدم بالفعل لأنّني اسنحبتُ فجأةً
.من هيئة سحرة الإمبراطوريّة

327
00:20:35,020 --> 00:20:37,210
،دونك يا غلين

328
00:20:38,050 --> 00:20:41,300
.لا أدري ما أعيش لأجله

329
00:20:41,300 --> 00:20:43,880
.رويدك، هذا ليس صحيحًا

330
00:20:43,880 --> 00:20:47,470
كنتِ اليوم تستمتعين باللّعب مع روميا
والقطّة البيضاء والأخريات، صحيح؟

331
00:20:47,470 --> 00:20:48,890
.لم أفهم

332
00:20:49,180 --> 00:20:52,200
.بوسعك أن تصبحي تلميذةً في هذه الأكاديميّة وحسب

333
00:20:52,200 --> 00:20:54,520
.اعفي نفسك من هيئة سحرة الإمبراطوريّة

334
00:20:54,520 --> 00:20:55,840
.هذا ليس ما في الأمر

335
00:20:55,840 --> 00:20:57,150
.إنّني أعيش لأجلك

336
00:20:57,150 --> 00:20:58,410
!كلاّ، غير صحيح

337
00:20:58,410 --> 00:21:01,700
—السّعي لسعادتك الخاصّة هو ما أراد أخوك

338
00:21:05,060 --> 00:21:06,440
.لا أفهم

339
00:21:07,450 --> 00:21:10,400
!لا أفهم ما تقوله إطلاقًا

340
00:21:10,400 --> 00:21:11,540
!وما الخطأ في ذلك؟

341
00:21:11,540 --> 00:21:14,030
.اهدئي يا رييل

342
00:21:14,030 --> 00:21:16,840
!وما الخطأ في القتال لحمايتك؟

343
00:21:16,840 --> 00:21:19,040
!لِمَ لا تبقى إلى جانبي؟

344
00:21:19,040 --> 00:21:20,400
!أكره هذا

345
00:21:20,400 --> 00:21:21,250
رييل؟

346
00:21:21,250 --> 00:21:23,210
...روميا، سيستين

347
00:21:23,210 --> 00:21:25,300
هل سلبتاكَ منّي؟

348
00:21:25,300 --> 00:21:27,140
ما الّذي يجعلك تفكّرين هكذا؟

349
00:21:27,140 --> 00:21:28,860
!اخرس، اخرس

350
00:21:28,860 --> 00:21:30,650
!كلّ هذا بسببهما

351
00:21:30,650 --> 00:21:31,720
!أكرههنّ جميعًا

352
00:21:31,720 --> 00:21:32,880
!أكرههن

353
00:21:31,720 --> 00:21:33,310
!رييل! انتظري

354
00:21:47,600 --> 00:21:49,690
.لا تسير الأمور كما أشاء أبدًا

355
00:21:52,480 --> 00:21:56,850
.تنظر منظّمتنا في هذا الأمر بشكلٍ استباقيّ

356
00:21:56,850 --> 00:22:00,960
.لقد انتهينا بالفعل من التّجهيزات لأجل المكبّر

357
00:22:02,840 --> 00:22:03,960
...حسنًا إذًا

358
00:22:04,350 --> 00:22:07,180
.لأجل ما يسعا كلانا إليه

359
00:23:45,980 --> 00:23:46,980
!لماذا؟

360
00:23:47,290 --> 00:23:49,930
!لا أفهم أيًّا ممّا تقول يا غلين

361
00:23:50,860 --> 00:23:53,610
لمَ لا أستطيع القيام بالعرض
المسبق للحلقة القادمة؟

362
00:23:53,610 --> 00:23:54,940
.لا تسأليني

363
00:23:54,940 --> 00:23:58,400
.رييل، القيام بالعرض المسبق أصعب ممّا تظنّين

364
00:23:58,080 --> 00:23:59,540
النّجمالمخادع و :القادمة في الحلقة

365
00:23:58,400 --> 00:23:59,880
.إنّها مسؤوليّة كبيرة

366
00:23:59,880 --> 00:24:00,710
!لكن أريد القيام به

367
00:24:00,710 --> 00:24:03,790
يا معلّم، هلاّ تركت رييل تجرّب؟

368
00:24:00,710 --> 00:24:05,540
النّجمالمخادع و :القادمة في الحلقة

369
