1
00:00:02,350 --> 00:00:04,670
.إنّه مشهد ثمينٌ بالفعل

2
00:00:04,670 --> 00:00:05,550
أليس كذلك؟

3
00:00:05,550 --> 00:00:07,500
.ملابس السّباحة هي الأفضل

4
00:00:07,500 --> 00:00:09,950
.ومعظمهنّ قد نضجنَ بشكلٍ جميل

5
00:00:09,950 --> 00:00:12,240
ومن كان يتحدّث عن ملابس السّباحة؟

6
00:00:12,640 --> 00:00:16,960
،هذا هو المشهد الّذي أردتَ أن تحميه
أليس كذلك يا غلين؟

7
00:00:16,960 --> 00:00:18,150
من يدري؟

8
00:00:21,550 --> 00:00:22,870
!معلّم

9
00:00:23,670 --> 00:00:25,430
!نعم أيّتها القطّة البيضاء

10
00:00:29,460 --> 00:00:31,240
!شكرًا جزيلاً لك

11
00:00:33,480 --> 00:00:34,580
.إنّهما متشابهتان

12
00:00:36,430 --> 00:00:38,410
.سيرا سيلفرس

13
00:01:05,790 --> 00:01:09,920
السّجلاّت الأكاشيّة
لمعلّم السّحر الوغد

14
00:02:23,740 --> 00:02:27,750
،انطلاقًا من حادثة مشروع إحياء الحياة

15
00:02:28,360 --> 00:02:32,750
هل يمكننا القول أنّ قوى الأميرة إرمينيا
أوشكت على الاكتمال؟

16
00:02:32,750 --> 00:02:38,260
أجل. ماذا يجب أن نفعل
بعد هذا يا زعيم؟

17
00:02:38,260 --> 00:02:41,260
.فلنراقب برويّةٍ لفترة

18
00:02:41,520 --> 00:02:43,180
.مفهوم

19
00:02:43,180 --> 00:02:48,360
لكن هنالك من هم داخل المنظّمة
.يُدبّرون لانبعاث الأميرة إرمينيا

20
00:02:48,360 --> 00:02:49,770
ماذا يجب أن نفعل حيالهم؟

21
00:02:49,770 --> 00:02:52,270
.تعاملي معهم بما ترينه مناسبًا

22
00:02:52,790 --> 00:02:53,560
.حاضرة

23
00:02:54,870 --> 00:03:00,260
.طريقتكم في الحياة ستُدوِّن قصّتي في النّهاية

24
00:03:05,910 --> 00:03:07,620
!نحن مسرورون لأنّك استطعتِ المجيء

25
00:03:07,900 --> 00:03:10,190
.تفضّلي، كلي قدر ما تشائين

26
00:03:10,190 --> 00:03:12,040
أتحبّين لحم البقر المشويّ؟

27
00:03:12,040 --> 00:03:14,630
،إن كنتِ تفضّلين أكل شيءٍ آخر
!ما عليك سوى أن تطلبي

28
00:03:16,380 --> 00:03:20,170
.أبي، أمي، رييل خجولة بعض الشّيء

29
00:03:20,170 --> 00:03:21,970
...إن تقرّبتما منها بشدّة كما تفعلان عادةً

30
00:03:21,970 --> 00:03:25,390
إذًا، تقصدين أنّ المسألة لا تعني
أنّها لم تحبّ الطّعام؟

31
00:03:25,390 --> 00:03:26,060
.نعم

32
00:03:26,060 --> 00:03:27,580
!هذا جيّد

33
00:03:27,580 --> 00:03:29,500
!لقد كنتُ قلقًا للغاية

34
00:03:29,500 --> 00:03:30,520
.عزيزي

35
00:03:32,720 --> 00:03:38,900
رييل-سان، سيستين وروميا دائمًا ما تتحدّثان
.بسعادة كبيرة عن المعلّم غلين

36
00:03:39,180 --> 00:03:42,110
أنت معجبةٌ بالمعلّم أيضًا، صحيح؟

37
00:03:42,120 --> 00:03:44,160
.لا شيء يبدأ دون غلين

38
00:03:44,160 --> 00:03:45,880
عجبًا، أهكذا إذًا؟

39
00:03:45,880 --> 00:03:48,190
!إنّه رجلٌ ممتازٌ حقًّا إذًا

40
00:03:48,190 --> 00:03:51,130
.لا، لا أظنّها عنت الأمر بتلك الطّريقة

41
00:03:51,890 --> 00:03:54,780
!باشري، تناولي بعض الحساء أيضًا
!وكُلي السّلطة خاصّتك

42
00:03:54,780 --> 00:03:57,630
.أبي، يستحيل عليها أن تأكل كلّ ذلك القدر

43
00:04:01,680 --> 00:04:02,830
.صحيح، صحيح

44
00:04:02,830 --> 00:04:06,410
،سنذهب إلى العاصمة الإمبراطوريةّ غدًا
.لذا اعتنيا بالمنزل

45
00:04:06,410 --> 00:04:08,260
.أكيد. كونا حذرين

46
00:04:08,260 --> 00:04:10,570
.ماذا؟ هذا يُذكّرني

47
00:04:11,110 --> 00:04:15,900
أشعر وكأنّ هناك شيئًا مهمًّا يجب
.أن أخبركِ إيّاه يا سيستين

48
00:04:15,900 --> 00:04:16,780
أحقًّا؟

49
00:04:27,120 --> 00:04:29,660
...سيستين

50
00:04:30,770 --> 00:04:32,500
...بشأن ما حدث سابقًا

51
00:04:33,200 --> 00:04:34,370
.لا بأس

52
00:04:34,370 --> 00:04:37,880
.لكنّي لم أعتذر منك كما يجب

53
00:04:37,880 --> 00:04:39,930
.الأمر بخير الآن

54
00:04:41,040 --> 00:04:42,520
.أنا آسفة

55
00:04:42,520 --> 00:04:43,880
.وشكرًا لكما

56
00:04:47,220 --> 00:04:51,100
.أنتما صديقتان عزيزتان

57
00:05:05,820 --> 00:05:07,240
...آسفة

58
00:05:07,530 --> 00:05:09,420
!أستاذة أرفونيا

59
00:05:09,420 --> 00:05:11,870
قلعة السّماء ميلغاليوس؟

60
00:05:12,330 --> 00:05:15,080
لقد كان جدّك باحثًا مشهورًا بدوره، أليس كذلك؟

61
00:05:15,080 --> 00:05:15,870
.نعم

62
00:05:15,870 --> 00:05:19,200
.أريد أن أواصل تحقيق أمانيه

63
00:05:19,200 --> 00:05:21,630
...مع أنّني قلقة ما إن كنتُ سأستطيع

64
00:05:21,630 --> 00:05:26,010
أولئك الّذين يُحقّقون شيئًا هم الحمقى
.الّذين يواصلون شقّ طريقهم

65
00:05:26,400 --> 00:05:30,040
وأولئك الّذين لا يُحقّقون شيئًا هم
.الحكماء الّذين يتوقّفون عن التّقدّم

66
00:05:30,040 --> 00:05:31,890
من قال هذا؟

67
00:05:31,890 --> 00:05:33,480
.أنا

68
00:05:33,480 --> 00:05:34,470
.ابذلي قصارى جهدك

69
00:06:05,620 --> 00:06:11,180
أولئك الّذين يُحقّقون شيئًا هم الحمقى"
الّذين يواصلون شقّ طريقهم"؟

70
00:06:11,990 --> 00:06:16,340
يجب أن أذهب إلى المتاهة
.تحت الأرض مُجدّدًا

71
00:06:20,270 --> 00:06:21,230
.مرحبًا

72
00:06:22,840 --> 00:06:23,440
!أنت

73
00:06:26,850 --> 00:06:29,320
.المكتبة لا تلائمك حقًّا يا معلّم

74
00:06:29,700 --> 00:06:31,290
.هذا ليس صحيحًا

75
00:06:31,290 --> 00:06:33,410
.أنا مجلّد حيّ ويمشي من المعرفة

76
00:06:33,410 --> 00:06:35,750
.لا جهد لديّ لأجادلك في ذلك

77
00:06:36,180 --> 00:06:37,850
.لستِ مضحكة

78
00:06:38,770 --> 00:06:39,960
...بالمناسبة

79
00:06:39,960 --> 00:06:41,000
ما الأمر؟

80
00:06:41,320 --> 00:06:43,440
،عندما كنتُ على شفير الموت ذلك اليوم

81
00:06:43,440 --> 00:06:47,760
أنتِ من أدّت تعويذة الإحياء عليّ، صحيح؟

82
00:06:52,000 --> 00:06:54,330
.أردتُ أن أشكرك على ذلك على الأقلّ

83
00:06:54,330 --> 00:06:55,390
.شكرًا

84
00:06:56,080 --> 00:06:58,120
لِمَ احمرّ وجهك هكذا؟

85
00:06:59,300 --> 00:07:00,490
سيستي؟

86
00:07:00,490 --> 00:07:02,080
ما الخطب؟

87
00:07:02,080 --> 00:07:03,440
هل دفعك غلين للبكاء؟

88
00:07:03,880 --> 00:07:06,820
!سأحميك وروميا منه

89
00:07:06,820 --> 00:07:08,000
!لا! لا

90
00:07:08,000 --> 00:07:12,240
.أناشد الخلق، امنح يداي سيفًا عظيمًا

91
00:07:12,930 --> 00:07:14,240
!الأمر ليس هكذا

92
00:07:15,950 --> 00:07:16,670
!انتظري

93
00:07:16,670 --> 00:07:17,440
!أصغي إليّ

94
00:07:17,440 --> 00:07:18,500
!أنت

95
00:07:18,500 --> 00:07:20,330
!ليس هذا

96
00:07:23,910 --> 00:07:24,590
!احترس

97
00:07:24,590 --> 00:07:26,460
!أيّها التّدفّق الرّائع للرّياح، اسمعني

98
00:07:37,840 --> 00:07:42,270
لم أتوقّع أن أصادفك أوّلاً بعد قدومي
.لهذه الأكاديميّة يا سيستين

99
00:07:42,560 --> 00:07:44,350
أ-أنت...؟

100
00:07:44,350 --> 00:07:46,730
ما هذا الجوّ الّذي أشعر به؟

101
00:07:46,730 --> 00:07:48,610
.أنا ليوس

102
00:07:48,610 --> 00:07:50,560
.ليوس كلايتوس

103
00:07:50,560 --> 00:07:53,660
.لقد دُعيت لهذه الأكاديميّة كمعلّم ضيف

104
00:07:53,660 --> 00:07:56,120
.وأنا خطيب سيستين

105
00:08:01,370 --> 00:08:03,080
!لقد تذكّرت

106
00:08:04,060 --> 00:08:07,770
.ليوس-كُن قادم! نسيتُ إخبار سيستي

107
00:08:07,770 --> 00:08:09,710
...صحيح، على ذكرك لهذا

108
00:08:09,710 --> 00:08:11,580
!ا-انتظر يا ليوس

109
00:08:11,580 --> 00:08:12,930
!ماذا تقول؟

110
00:08:14,660 --> 00:08:18,060
لقد تعاهدنا أنا وأنت سابقًا على تشارك
مستقبلنا سويًّا، أليس كذلك؟

111
00:08:18,060 --> 00:08:19,930
—ذ-ذلك عندما كنّا طفلين

112
00:08:19,930 --> 00:08:21,900
هل تقول هذا حقًّا؟

113
00:08:21,900 --> 00:08:26,880
توقّف عن ذلك. مواعدتها أشبه
.بحفرِ قبرك بيديك

114
00:08:26,880 --> 00:08:28,120
!ما قصدك بهذا؟

115
00:08:29,090 --> 00:08:33,700
هل يمكنك الكفّ عن إهانة
زوجتي المستقبليةّ ؟

116
00:08:34,840 --> 00:08:36,090
.انتظر يا ليوس

117
00:08:36,090 --> 00:08:39,660
.إنّ المعلّم غلين... يمزح وحسب

118
00:08:40,300 --> 00:08:41,950
المعلّم غلين؟

119
00:08:41,950 --> 00:08:43,040
.فهمت

120
00:08:43,460 --> 00:08:45,960
.إذًا أنت هو غلين ريدارس-سان

121
00:08:45,960 --> 00:08:48,000
كيف تعرفني؟

122
00:08:48,000 --> 00:08:54,130
هنالك أحاديث تشملك حتّى في أكاديميّة
.كلايتوس للسّحر حيثُ أُدرِّس

123
00:08:54,460 --> 00:08:59,140
معلّم جديد ظهر فجأةً في أكاديميّة
.ألزانو الإمبراطوريّة للسّحر

124
00:08:59,680 --> 00:09:03,890
على نقيض التّعليم السّحريّ الحاليّ الّذي
،يُركّز على تجميع معظم التّعاويذ

125
00:09:04,360 --> 00:09:06,460
،فأنت تفهم أساسيّات التّعاويذ

126
00:09:06,460 --> 00:09:08,830
.وتُركّز على استخدامها العمليّ

127
00:09:08,830 --> 00:09:11,750
.أنت بالأحرى نوعٌ نادرٌ من المدرّسين

128
00:09:12,280 --> 00:09:16,410
.سأُسرُّ بسماع إحدى محاضراتك في وقتٍ ما

129
00:09:16,760 --> 00:09:19,430
.لكنّي لستُ بتلك العظمة

130
00:09:20,400 --> 00:09:22,090
.ليوس كلايتوس

131
00:09:22,090 --> 00:09:24,620
.المرشّح القادم لاستلام قيادة الكونتيّة

132
00:09:25,020 --> 00:09:28,630
إنّه مشهورٌ في الجمعيّة الإمبراطوريّة
!السّحريّة المتّحدة

133
00:09:28,960 --> 00:09:36,220
مع ذلك، إنّ إرسال معلّم ممتاز كهذا ليحلّ
...مكان معلّمنا الّذي في إجازة طبّية ممتدّة

134
00:09:36,220 --> 00:09:38,550
!يا لحسن حظّنا

135
00:09:38,550 --> 00:09:41,770
لِمَ قمنا بتعيين شخصٍ بمثل موهبته؟

136
00:09:41,770 --> 00:09:42,990
أليس هذا غريبًا؟

137
00:09:42,990 --> 00:09:44,180
.أجل، بالفعل

138
00:09:44,480 --> 00:09:45,680
هل أنت قلقة؟

139
00:09:45,680 --> 00:09:49,770
قلقة من أن يخطفَ ليوس-دونو
منصب تلميذك الغبيّ؟

140
00:09:50,200 --> 00:09:53,510
ستكون المسألة أسهل بكثير
.إن كان الوضع كذلك

141
00:09:54,890 --> 00:09:58,160
.ما زلتُ جادًّا حول هذا يا سيستين

142
00:09:58,160 --> 00:10:00,300
.أنا أحبّك من صميم قلبي

143
00:10:02,530 --> 00:10:04,460
!طوبى لك أيّتها القطّة البيضاء

144
00:10:04,460 --> 00:10:09,040
إنّه من المستحيل عادةً على أحدهم
.أن يُعجب بفتاةٍ وقحةٍ مثلك

145
00:10:09,040 --> 00:10:12,670
بئسًا، لقد أصابوا عندما قالوا
.أنّ للبعض ذوقٌ غريب

146
00:10:12,670 --> 00:10:14,920
،بالمناسبة

147
00:10:14,920 --> 00:10:18,800
إن سار كلّ هذا على خير، فبوسعك
—أن تدعيني على حفل زفا

148
00:10:18,800 --> 00:10:21,880
!أيّها النّذل

149
00:10:21,880 --> 00:10:24,410
.سيستين، أنت غاضبة جدًّا

150
00:10:24,410 --> 00:10:25,270
لماذا؟

151
00:10:26,260 --> 00:10:29,900
.أ-أظنّ أنّ هذا بدأ يصبح مسألةً كبيرة

152
00:10:32,240 --> 00:10:38,030
وهكذا نستطيع تفسير صيغةِ زايسر
.لأداء توضيح الطّاقة السّحريّة

153
00:10:38,640 --> 00:10:43,410
حتّى وقتٍ قريب، معظم التّعاويذ الهجوميّة
أو الاعتدائيّة المستخدمة من الجيش

154
00:10:43,760 --> 00:10:48,170
في الإمبراطورية تضمّنت إحدى الأنواع
.الثّلاثة: الحرارة أو البرد أو الصّدمة

155
00:10:48,170 --> 00:10:50,620
.بينما أرجو الآن أنّكم ستفهمون جميعًا سبب ذلك

156
00:10:50,910 --> 00:10:54,170
يجدر بكم أن تستطيعوا الرّفع من مردود

157
00:10:54,170 --> 00:10:58,510
حتّى التّعاويذ الأساسيّة مثل عاصفة
.الصّدمة إن فهمتم محاضرتي

158
00:10:58,940 --> 00:11:02,010
تعاويذ الرّياح ضعيفة عندما يتعلّق
.الأمر بالسّحر العسكريّ

159
00:11:02,010 --> 00:11:03,840
.بيد أنّها تملك مزاياها كذلك

160
00:11:03,840 --> 00:11:06,500
.في المرّة المقبلة، سأناقشكم إيّاها

161
00:11:06,920 --> 00:11:08,090
.حان الوقت

162
00:11:08,090 --> 00:11:10,100
.شكرًا لكم على إصغائكم لمحاضرتي

163
00:11:11,560 --> 00:11:13,980
!أحبك يا معلّم ليوس

164
00:11:16,410 --> 00:11:17,980
.كان ذلك ممتازًا

165
00:11:18,350 --> 00:11:23,850
لقد ساعد التّلاميذ بسهولة على فهم
نظريّة القوّة الماديّة بشكلٍ ممتاز

166
00:11:23,850 --> 00:11:27,450
والّتي لا يفهمها أكثر من نصف
.سحرة الجيش المجنّدين بشكل كامل

167
00:11:27,740 --> 00:11:30,960
لكن مع ذلك، ما زال الوقتُ مبكّرًا
.عليهم ليتعلّموا ذلك

168
00:11:31,460 --> 00:11:34,710
يُجدر بالتّلميذ الذّكيّ أن يبدأ بإدراكِ

169
00:11:34,710 --> 00:11:38,360
أنَّ حتّى عاصفة الصّدمة من شأنها أن تقتل
.أحدهم، اعتمادًا على كيفيّة استخدامها

170
00:11:38,360 --> 00:11:43,720
لكنّ هؤلاء الأطفال لا يفهمون بعد معنى
.امتلاك قوّة عظيمة أو ما تستطيع إحداثه

171
00:11:43,720 --> 00:11:47,450
.يعرفون فقط أنّها موجودة

172
00:11:48,820 --> 00:11:52,680
أرى أنّك لا تريد أن تعترف بدرس من ذلك النّوع؟

173
00:11:52,680 --> 00:11:53,850
.ليس كثيرًا

174
00:11:53,850 --> 00:11:58,700
في كلّ يوم، أنتَ دائمًا ما تخبرنا
،أن نُفكّر بشأن معنى القوّة

175
00:11:58,700 --> 00:12:01,260
.وكيف نستخدمها وألاّ ندعها تستخدمنا

176
00:12:01,260 --> 00:12:03,360
.لكن أظنّني فهمتُ ما تقصده الآن

177
00:12:05,400 --> 00:12:06,730
.لا بأس

178
00:12:06,730 --> 00:12:11,480
على أقلّ تقدير، لن يقترف أيٌّ
.من تلاميذك ذلك الخطأ

179
00:12:11,480 --> 00:12:16,960
لا يهمّ. أشعر بالغيرة فقط لأنّه اتّضح أنّ ذلك
.الشّخص الوسيم متمكّنٌ أكثر مما توقعت

180
00:12:17,410 --> 00:12:19,180
.طوبى لك أيّها القطّة البيضاء

181
00:12:19,180 --> 00:12:20,900
.لديكِ شخصٌ لا يستهان به

182
00:12:21,330 --> 00:12:22,580
.أنت مُلحّ

183
00:12:23,970 --> 00:12:27,260
سيستين، كيف كانت؟

184
00:12:27,260 --> 00:12:29,220
.أريد أن أسمع رأيك الصّريح

185
00:12:29,220 --> 00:12:30,840
...في الواقع

186
00:12:30,840 --> 00:12:32,230
.لقد كانت رائعة جدًّا

187
00:12:32,230 --> 00:12:35,530
،هذا جيد. لأنّه في النّهاية

188
00:12:35,530 --> 00:12:37,630
.أنت مشهورة بجعل المعلّمين يبكون

189
00:12:37,630 --> 00:12:38,610
...ذلك

190
00:12:38,910 --> 00:12:43,390
إذًا فقد أزلتُ العقبة الأولى في طريقي
،لأصبح زوجًا يليقُ بك

191
00:12:43,390 --> 00:12:44,280
على ما أفترض؟

192
00:12:44,280 --> 00:12:47,050
!أخبرتك ألاّ تتحدّث عن ذلك علَنًا

193
00:12:48,400 --> 00:12:51,710
سيستين، أتمانعين أن تسيري معي في الخارج؟

194
00:12:51,710 --> 00:12:53,580
.أريد أن أسير إلى جانبك

195
00:12:54,550 --> 00:12:55,920
...حسنٌ

196
00:12:55,920 --> 00:12:57,580
أيجب أن نذهب الآن؟

197
00:12:57,870 --> 00:13:00,060
،لسنا بحاجة لفعل ذلك الآن

198
00:13:00,060 --> 00:13:03,090
.لكنّه أمرٌ مهمٌّ يجب أن نناقشه في النّهاية

199
00:13:05,060 --> 00:13:06,380
.آسفة يا روميا

200
00:13:06,380 --> 00:13:07,600
.سأعود في الحال

201
00:13:07,600 --> 00:13:08,600
.حـ-حسنًا

202
00:13:08,880 --> 00:13:09,800
...إذًا

203
00:13:15,300 --> 00:13:16,620
.يا معلّم

204
00:13:16,620 --> 00:13:17,350
ماذا؟

205
00:13:17,350 --> 00:13:20,110
.أريد أن أسألكَ معروفًا

206
00:13:27,580 --> 00:13:32,460
ألا يذكّرك مشينا معًا بماضينا؟

207
00:13:32,460 --> 00:13:33,870
.بلى

208
00:13:39,000 --> 00:13:42,060
إنّ مرور الوقت قاسٍ، أليس كذلك؟

209
00:13:42,060 --> 00:13:47,170
.لقد آمنتُ أنّ علاقتنا ستطول بشكلٍ متين دون ريب

210
00:13:47,170 --> 00:13:50,930
...نعم. إن تركنا الوقت يمضي

211
00:13:50,930 --> 00:13:56,640
فأنا واثقة أنّ علاقتنا ستصبح مجرّد ذكرى مضحكة

212
00:13:56,640 --> 00:13:59,140
.لم يعر أيّ منّا التّفكير لها

213
00:14:02,440 --> 00:14:06,170
لِمَ يجب أن أذهب وأسترقّ النّظر
على لحظة رومانسيّة لأحدهم؟

214
00:14:06,170 --> 00:14:07,280
.أنا آسفة

215
00:14:07,280 --> 00:14:10,530
.لستُ مهتمًّا بمثل هذه الأمور إطلاقًا

216
00:14:11,200 --> 00:14:15,540
أعتقد أنّ هناك طريقة لمنع تلك الذّكريات
.من أن تكون مجرّد ذكريات

217
00:14:17,120 --> 00:14:18,150
...سيستين

218
00:14:21,880 --> 00:14:24,800
.تزوّجيني أرجوكِ

219
00:14:26,920 --> 00:14:28,120
!عجبًا

220
00:14:28,120 --> 00:14:31,200
!هل تقدّم لزواجها فجأةً؟

221
00:14:31,200 --> 00:14:34,010
!بدأ هذا يصبح محمّسًا

222
00:14:35,790 --> 00:14:37,420
ماذا هناك يا روميا؟

223
00:14:37,990 --> 00:14:41,350
...لستُ متيقّنة تمامًا، لكن ينتابني شعورٌ سيّئ

224
00:14:41,350 --> 00:14:44,410
يا إلهي. أهو حدس المرأة؟

225
00:14:44,410 --> 00:14:47,570
.بغضّ النّظر عن ذلك، هذا مثيرٌ للاهتمام حقًّا الآن

226
00:14:48,360 --> 00:14:50,570
...أ-أنا

227
00:14:50,960 --> 00:14:54,700
أنا آسفة يا ليوس. لا أستطيع
.أن أقبل عرضك للزّواج بي

228
00:14:54,700 --> 00:14:56,620
ماذا؟

229
00:14:57,020 --> 00:14:58,300
لِمَ لا؟

230
00:14:58,300 --> 00:15:00,670
لقد قطعتُ وعدًا على جدّي

231
00:15:00,670 --> 00:15:03,630
.بأن أكشف سرّ قلعة السّماء ميلغاليوس

232
00:15:04,310 --> 00:15:09,240
.ولأجل تحقيق ذلك، يجب أن أتعلّم الكثير عن السّحر

233
00:15:09,240 --> 00:15:10,260
...لذا

234
00:15:12,070 --> 00:15:13,970
.لم تتغيّري

235
00:15:13,970 --> 00:15:17,140
أما زلت تتحدّثين عن ذلك الخيال؟

236
00:15:18,850 --> 00:15:20,600
...علم آثار السّحر

237
00:15:20,600 --> 00:15:24,280
.استكشاف الآثار القديمة وحفريات القطع الأثريّة

238
00:15:24,280 --> 00:15:29,240
الهدف النّهائيّ هو الكشف عن أسرار
.الحضارة القديمة وإحياء السّحر القديم

239
00:15:29,780 --> 00:15:33,150
.لكن لم يتمكّن أيّ أحدٍ من تحقيق ذلك

240
00:15:33,150 --> 00:15:35,740
.ممّا يعني أنّ ذلك مستحيل وبلا معنى

241
00:15:36,060 --> 00:15:38,450
...إنّ تضييع حياتك على شيءٍ كهذا

242
00:15:38,450 --> 00:15:40,060
.وا أسفاه

243
00:15:41,740 --> 00:15:43,420
شيء كهذا؟

244
00:15:43,420 --> 00:15:47,790
،لو أنّ جدّك لم يكن مركّزًا جدًّا على ذلك

245
00:15:47,790 --> 00:15:50,760
.لخلّف الكثير من الإنجازات عن تاريخ السّحر

246
00:15:52,460 --> 00:15:56,510
،سيستين، رجاءً هلاّ أعترني دعمك في تخصّصي

247
00:15:56,510 --> 00:15:59,390
بحث السّحر العسكريّ؟

248
00:16:03,110 --> 00:16:04,650
.أنا آسفة يا ليوس

249
00:16:04,650 --> 00:16:09,150
،مثلما تملك أنت أحلامك
.فلا يمكنني أن أتخلّى عن أحلامي

250
00:16:09,150 --> 00:16:13,410
.إنّما لا أريدك أن تهدري حياتك عبثًا

251
00:16:16,810 --> 00:16:19,410
!كفّ عن التّفوّه بالأكاذيب أيّها المعتوه

252
00:16:20,070 --> 00:16:21,120
!معلّم؟

253
00:16:21,120 --> 00:16:23,600
.يسير المرء في الطّريق الّذي يختاره

254
00:16:23,600 --> 00:16:27,540
!ولا تنسَ أنّك الشّخصيّة الرّئيسيّة في قصّة حياتك

255
00:16:28,850 --> 00:16:29,800
!ممتاز

256
00:16:29,800 --> 00:16:31,640
أنت مجدّدًا؟

257
00:16:31,640 --> 00:16:33,260
وتسترق السّمع علينا هذه المرّة؟

258
00:16:33,700 --> 00:16:36,040
.أستمسحك عذرًا، لكن لا علاقة لك بهذا الموضوع

259
00:16:36,040 --> 00:16:37,580
.أطلب منك أن تظلّ خارجه

260
00:16:37,580 --> 00:16:38,100
.تبًّا

261
00:16:41,990 --> 00:16:44,230
.لا، بل الأمر يعنيه

262
00:16:45,300 --> 00:16:46,480
القطّة البيضاء؟

263
00:16:47,000 --> 00:16:49,730
سيستين، ماذا تقصدين؟

264
00:16:49,730 --> 00:16:52,860
...لأنّ

265
00:16:53,350 --> 00:16:55,240
...المعلّم وأنا

266
00:16:56,820 --> 00:17:00,120
!حبيبان تعاهدنا على تشارك مستقبلينا معًا

267
00:17:04,430 --> 00:17:06,580
!لهذا لا أستطيع أن أتزوّج منك

268
00:17:11,920 --> 00:17:14,490
.إليك الحقيقة يا ليوس-سان

269
00:17:17,260 --> 00:17:20,640
كذب! ما كانت عزيزتي سيستين
!لتقع في حبّ شخصٍ بليدٍ مثلك

270
00:17:20,640 --> 00:17:22,040
!ليس كذبًا

271
00:17:22,040 --> 00:17:26,020
في النّهاية، ليلة البارحة، تشاركتُ سريري
.مع هذه القطّة البيضاء الصّغيرة الظّريفة

272
00:17:26,020 --> 00:17:28,430
!أيّها النّذل

273
00:17:28,430 --> 00:17:31,420
!لقد بالغتَ كثيرًا
—كما أنّنا تبادلنا القبل فقط

274
00:17:31,420 --> 00:17:32,170
!تبادلتما القبل؟

275
00:17:32,170 --> 00:17:33,420
!أهذا صحيح؟

276
00:17:33,420 --> 00:17:35,290
.ماذا؟ كـ-كانت كذبة

277
00:17:35,290 --> 00:17:37,820
...لكن ليس تمامًا، في الواقع

278
00:17:37,820 --> 00:17:40,730
.إليك الواقع. القطّة البيضاء زوجتي

279
00:17:40,730 --> 00:17:41,660
.تخلّ عنها

280
00:17:41,660 --> 00:17:43,070
.لن أفعل

281
00:17:43,070 --> 00:17:45,180
على أحدٍ أن يُري الحقيقة لسيستين

282
00:17:45,180 --> 00:17:47,630
.قبل أن يفوت الأوان، هذا إن كان يهتمّ بها حقًّا

283
00:17:47,630 --> 00:17:49,420
!لستَ مناسبًا لسيستين

284
00:17:49,420 --> 00:17:53,920
.مع ذلك، أنا من اختارته القطّة البيضاء

285
00:17:53,920 --> 00:17:56,090
!جهّز نفسك يا غلين ريدارس

286
00:17:56,090 --> 00:17:58,640
!ستندم على جعلي عدوّك

287
00:17:59,220 --> 00:18:00,720
.ا-انتظر يا ليوس

288
00:18:01,760 --> 00:18:03,400
.هذه هي طبيعتك الحقيقيّة إذًا

289
00:18:03,400 --> 00:18:05,020
.فهمتُ الآن حقًّا

290
00:18:05,290 --> 00:18:07,270
.لا يمكنني أن أسلّمك القطّة البيضاء

291
00:18:08,390 --> 00:18:09,520
معلّم؟

292
00:18:09,520 --> 00:18:13,020
.يبدو أنّه علينا توضيح هذا الأمر

293
00:18:13,020 --> 00:18:14,430
.نزال

294
00:18:14,430 --> 00:18:15,960
هل تقبل؟

295
00:18:16,400 --> 00:18:18,490
.ما كنتُ لأطلب أكثر من هذا

296
00:18:22,440 --> 00:18:25,960
.دعنا نناقش وقت وطبيعة نزالنا في وقتٍ لاحق

297
00:18:25,960 --> 00:18:27,110
.أستأذن

298
00:18:33,300 --> 00:18:34,430
!فعلتها

299
00:18:34,430 --> 00:18:36,270
!لا تقل لي فعلتها

300
00:18:36,270 --> 00:18:37,710
.فات الأوان الآن

301
00:18:37,710 --> 00:18:39,640
!لكن بالتّفكير في الأمر، هذه هي فرصتي

302
00:18:39,640 --> 00:18:42,160
!إن كنتِ زوجتي، فلن أضطرّ للعمل

303
00:18:42,160 --> 00:18:43,770
—سأتزوّج من فتاة غنيّة

304
00:18:43,770 --> 00:18:46,390
!أيّها النّذل

305
00:18:48,800 --> 00:18:52,860
بالتّالي يمكنني أن أكون على علاقة
،مع القطّة البيضاء وأصبح غنيًّا

306
00:18:52,860 --> 00:18:55,420
،وأعيش في منزلي دون الحاجة للعمل

307
00:18:55,420 --> 00:18:59,150
سأمنحكم جميعًا تدريبًا خاصًّا
!في قتال فِرق السّحرة

308
00:19:01,160 --> 00:19:03,060
سيستين، ما القصّة؟

309
00:19:03,490 --> 00:19:05,480
!لِمَ تقحمنا أيضًا؟

310
00:19:05,480 --> 00:19:07,080
!أنت من تحدّاه في نزالٍ يا معلّم

311
00:19:07,080 --> 00:19:09,130
.ما باليد حيلة

312
00:19:09,130 --> 00:19:13,590
ليوس اللّعين ذاك قد ألحّ على المنافسة
.بمهاراتنا كمعلّمَيْ سحر

313
00:19:13,590 --> 00:19:16,480
ألا يعني هذا أنّنا لا نملك فرصةً أمامه؟

314
00:19:16,480 --> 00:19:18,210
.هذا القسم ليس قويًّا بما يكفي

315
00:19:18,210 --> 00:19:20,340
!لهذا سنتدرب

316
00:19:22,170 --> 00:19:27,750
.لن أنساكم يا رفاق بعد أن أصبح فاحش الثّراء

317
00:19:35,720 --> 00:19:38,170
...تنافس على فتاةٍ لا تحبّها حتّى

318
00:19:38,170 --> 00:19:39,570
.أنت وضيع للغاية

319
00:19:39,570 --> 00:19:42,200
ألا تشعر بالأسى قليلاً عليها؟

320
00:19:42,200 --> 00:19:43,880
من يهتمّ؟

321
00:19:43,880 --> 00:19:46,200
.إن فزتُ فلن أضطرّ للعمل بعد الآن

322
00:19:47,270 --> 00:19:50,710
الأهمّ من هذا، لِمَ تواصلت معي مجدّدًا؟

323
00:19:52,070 --> 00:19:55,840
سمعتُ أنّ "غبار الملاك" قد هُرّب
.إلى هذه المدينة

324
00:19:57,800 --> 00:19:58,760
...غير معقول

325
00:19:58,760 --> 00:20:03,000
ظننتُ أن طريقة صنع غبار الملاك قد
دُمّرت في تلك الحادثة العام الماضي؟

326
00:20:03,000 --> 00:20:05,180
.أجل، يُفترض ذلك

327
00:20:05,600 --> 00:20:10,100
إنّ الّذين حُقنوا بذلك المخدّر يصبحون أجسادًا
...فارغة فاسدة ليسيطر عليها الآخرون

328
00:20:10,100 --> 00:20:12,190
.أشعرتني تلك الحادثة بالقرف

329
00:20:12,540 --> 00:20:13,680
.أرفض هذا

330
00:20:13,680 --> 00:20:15,420
.لم أقل أيّ شيء بعد

331
00:20:15,420 --> 00:20:16,730
.بوسعي أن أتوقّعك

332
00:20:16,730 --> 00:20:19,480
تريد أن تنضمّ إلى التّحقيق، صحيح؟

333
00:20:19,480 --> 00:20:21,740
.في الواقع، لقد أتيت إلى هنا لأخبرك ألاّ تتورّط

334
00:20:24,320 --> 00:20:26,220
سماع أنّهُ يُستخدم مجدّدًا

335
00:20:26,640 --> 00:20:29,910
يجعلني أتساءل بصدقٍ ما كان
.الدّافع من موتِ سيرا

336
00:20:29,910 --> 00:20:32,640
!لا أريد أن يحدث ذلك مجدّدًا

337
00:20:32,640 --> 00:20:33,670
...لهذا سوف

338
00:20:34,040 --> 00:20:35,970
مجدّدًا؟

339
00:20:37,620 --> 00:20:40,920
.أنت ترى سيرا حقًّا في تلك الفتاة

340
00:20:41,240 --> 00:20:42,300
!اصمت

341
00:20:53,240 --> 00:20:54,860
.أحبّ ذلك

342
00:20:55,550 --> 00:20:58,620
.حلمك رائعٌ حقًّا يا غلين-كُن

343
00:20:59,550 --> 00:21:03,070
...تحلم أن تكون ساحر عدالةٍ ينقذ الجميع

344
00:21:03,070 --> 00:21:06,530
.أحيانًا، أتمنّى وجود شخصٍ كهذا في الجوار

345
00:21:07,620 --> 00:21:11,770
.لذا أظنّك تستطيع الافتخار بهذا أكثر يا غلين-كُن

346
00:21:11,770 --> 00:21:14,230
.اصمتي أيّتها الكلبة البيضاء

347
00:21:16,370 --> 00:21:19,950
...باعتبار عملنا، فيومًا ما، أنا الأخرى

348
00:21:19,950 --> 00:21:21,310
.لا بأس

349
00:21:21,310 --> 00:21:22,830
.لا تقلقي يا سيرا

350
00:21:22,830 --> 00:21:23,880
—سأحمـ

351
00:21:24,760 --> 00:21:26,480
لا، لا شيء

352
00:21:26,480 --> 00:21:27,630
ماذا؟

353
00:21:27,630 --> 00:21:29,010
ماذا كنتَ على وشكِ قوله للتّوّ؟

354
00:21:29,640 --> 00:21:31,850
!قلت لا شيء

355
00:21:43,980 --> 00:21:45,900
كيف سار الأمر يا ليوس؟

356
00:21:46,270 --> 00:21:48,280
.كما قلتَ تمامًا

357
00:21:50,280 --> 00:21:56,090
.سار الأمر كما فكّرتَ بالضّبط
.لقد تحدّاني غلين في نزال

358
00:21:56,090 --> 00:21:58,480
هل أنت متنبّئٌ ما؟

359
00:21:58,480 --> 00:22:00,520
.لا، لستُ كذلك

360
00:22:01,400 --> 00:22:05,180
.ليوس، ارقص لأجلي أمام غلين

361
00:22:05,180 --> 00:22:08,600
.ستكون أساس عدالتي

362
00:23:45,680 --> 00:23:48,560
!إنّه حقًّا رجل غبيّ ومستهتر وساخر

363
00:23:48,560 --> 00:23:51,400
لم يتغيّر حتّى بعد أن أصبح معلّمًا؟

364
00:23:51,400 --> 00:23:53,800
."إنه يناديني "القطّة البيضاء

365
00:23:53,800 --> 00:23:55,310
!لا أ\به بالقطط البتّة

366
00:23:55,310 --> 00:23:57,790
.إنه يناديني "الكلبة البيضاء" أيضًا

367
00:23:57,790 --> 00:24:00,030
.كما قال أنّي أشبه الكلاب

368
00:24:00,030 --> 00:24:01,390
إنّه فظٌّ جدًّا، صحيح؟

369
00:24:01,390 --> 00:24:04,680
يتصرّف بصبيانيّة ولا يدركُ أنّه معلّم الآن؟

370
00:24:04,680 --> 00:24:08,160
كلّما فتح فمه، تجدينه يقول دائمًا
."أنا متعب"، "أنا منهك"، "لا أملك مزاجًا لذلك"

371
00:24:08,160 --> 00:24:09,770
إنه مزعجٌ بالفعل، أليس كذلك؟

372
00:24:09,770 --> 00:24:10,700
أليس كذلك؟

373
00:24:10,700 --> 00:24:12,840
—اسمعي هذا، إنّه

374
00:24:12,840 --> 00:24:16,220
أيّتها القطّة البيضاء، ما الّذي
كنت تحادثين الجدار بشأنه؟

375
00:24:16,970 --> 00:24:19,630
هل جننتِ من كثرة الدّراسة؟

376
00:24:17,180 --> 00:24:23,770
الهيئة السّحريّةمواجهة! قتال :القادمة في الحلقة

377
00:24:19,630 --> 00:24:23,770
!لكنّ فتاةً ذات شعرٍ أبيض تفهمني تمامًا كانت هنا للتّوّ

378
00:24:24,420 --> 00:24:25,350
ماذا؟

379
00:24:27,320 --> 00:24:29,540
.هذا غريب