!أجل

215
00:16:45,380 --> 00:16:56,680
لا توجد عودة إلى تلك اللّيلة

216
00:16:50,010 --> 00:16:51,550
!شكل نهائيّ

217
00:16:52,550 --> 00:16:54,140
!كم هذا مُزعج

218
00:16:54,310 --> 00:16:56,680
!هيّا بنا يا موناركيلازمون

219
00:16:56,970 --> 00:16:58,770
!أجل

220
00:16:57,600 --> 00:17:03,690
حتّى الآن هو المُستقبل

221
00:17:01,600 --> 00:17:04,070
!بئساً لك ولخدعك

222
00:17:05,190 --> 00:17:09,990
اصرخ، اركض، إلى ما وراء أحلامك

223
00:17:09,780 --> 00:17:13,570
!حدّ النّصل المُبيد

224
00:17:11,200 --> 00:17:16,990
حتّى تحت وابل الأمطار الغزيرة الهائجة
حتّى في السّواد الحالك

225
00:17:17,830 --> 00:17:21,870
اخترق الحدود
احرق روحك

226
00:17:19,000 --> 00:17:20,540
أهذا كلّ شيء؟

227
00:17:22,040 --> 00:17:23,130
!موناركيلازمون

228
00:17:22,040 --> 00:17:26,170
حرّر المُستقبل الّذي آمنت به

229
00:17:24,960 --> 00:17:26,170
!لا تقلق

230
00:17:26,340 --> 00:17:28,800
في خطّ الجبهة يبزغ الفجر

231
00:17:26,920 --> 00:17:31,680
!آمن بإيقاعيـ... بإيقاعنا

232
00:17:31,220 --> 00:17:35,350
فُكّ القيود
تحرّر وانطلق

233
00:17:37,680 --> 00:17:39,850
دعه يصدح الآن وغداً

234
00:17:38,350 --> 00:17:39,850
ماذا؟

235
00:17:40,020 --> 00:17:41,390
اتبع روحك

236
00:17:43,440 --> 00:17:47,400
امحُ كلّ شيء في طريقك

237
00:17:45,730 --> 00:17:46,520
!بروغانومون

238
00:17:47,230 --> 00:17:49,740
!الآن يا موناركليزامون

239
00:17:47,570 --> 00:17:50,490
أطلق عنانه
إلى أبعد أصقاع العالم

240
00:17:50,650 --> 00:17:53,410
انحته في روحك
دع الفجر يبزغ

241
00:17:53,860 --> 00:17:54,990
ماذا؟

242
00:18:00,250 --> 00:18:04,790
!الحُكم النّهائيّ

243
00:18:04,960 --> 00:18:07,250
!أنت نكِرة

244
00:18:23,350 --> 00:18:25,520
!مُستحيل

245
00:18:35,910 --> 00:18:37,160
...تمّت

246
00:18:38,160 --> 00:18:39,330
هزيمتي؟

247
00:18:42,250 --> 00:18:45,120
!أحسنت صنعاً يا موناركليزامون

248
00:18:54,760 --> 00:18:57,260
!تمّ العثور على عدد من النّاجين في التّوابيت

249
00:18:57,720 --> 00:18:59,810
سنحتاج شهادتهم

250
00:19:00,260 --> 00:19:01,680
أخرجوهم جميعاً

251
00:19:01,850 --> 00:19:02,850
عُلِم

252
00:19:03,560 --> 00:19:04,560
هيّا بنا

253
00:19:05,060 --> 00:19:06,100
!انتظر

254
00:19:06,560 --> 00:19:09,230
أنت تعرف الدّيجيمون القرد، أليس كذلك؟

255
00:19:09,520 --> 00:19:10,610
القرد؟

256
00:19:10,780 --> 00:19:13,360
سرق الإي-بولس الخاصّ بأخي

257
00:19:13,780 --> 00:19:16,320
أخذني إلى المُدرَّج

258
00:19:16,490 --> 00:19:18,280
!إنّه المسؤول عن كلّ شيء

259
00:19:20,160 --> 00:19:21,660
هذا غوكومون

260
00:19:22,620 --> 00:19:23,750
غوكومون؟

261
00:19:24,660 --> 00:19:28,920
!أين هو؟ من هو مالكه؟ أجبني

262
00:19:29,090 --> 00:19:30,420
لا تقلق

263
00:19:32,460 --> 00:19:36,340
أنا متأكّد بأنّك ستلتقي به ثانية يوماً ما

264
00:19:38,970 --> 00:19:43,180
تمّ اعتقال كاي أرسلان بواسطة الوزارة

265
00:19:43,520 --> 00:19:45,270
من أسقطَه؟

266
00:19:45,430 --> 00:19:47,940
وفقاً للتّقارير، كان غلوينغ داون

267
00:19:51,860 --> 00:19:53,190
كايتو-ساما

268
00:19:53,690 --> 00:19:57,410
سمعتُ بأنّ كلاي قد اعتُقِل

269
00:19:57,570 --> 00:19:58,860
من يأبه؟

270
00:19:59,700 --> 00:20:02,540
فهمت. فقد النّجوم الخمسة عضواً

271
00:20:02,830 --> 00:20:04,750
ستكون الأمور فوضويّة

272
00:20:05,160 --> 00:20:08,370
سأحتاجكما للتحرُّك

273
00:20:11,210 --> 00:20:13,630
شكراً على إنقاذنا

274
00:20:13,800 --> 00:20:16,550
وفّري شكركِ لغلوينغ داون

275
00:20:18,510 --> 00:20:24,600
قالوا بأنّ الفريق سبعة ليس مُتورّطاً
في الانقلاب، لذا لم نتلقّ أي تهمة

276
00:20:24,770 --> 00:20:25,640
ماذا؟

277
00:20:25,810 --> 00:20:28,770
ربّما تلقّى نايتو اللّوم عنّا جميعاً

278
00:20:29,230 --> 00:20:31,810
أتعتقدان بأنّه قد يفعل ذلك؟

279
00:20:34,320 --> 00:20:35,360
أنتم

280
00:20:35,530 --> 00:20:37,610
كيف حالكم؟

281
00:20:37,780 --> 00:20:41,240
أفضل بكثير. تسرّني رؤيتكم
على ما يُرام أيضاً

282
00:20:41,410 --> 00:20:43,030
ماذا ستفعلون الآن؟

283
00:20:43,200 --> 00:20:45,540
عليّ البحث عن مكان جديد أنتمي له

284
00:20:45,910 --> 00:20:48,660
تمّ تفكيك فريق التّكتيك

285
00:20:49,460 --> 00:20:50,920
ما رأيك بالعمل في منزلي؟

286
00:20:51,080 --> 00:20:52,040
ماذا؟

287
00:20:52,500 --> 00:20:58,050
،سيترتّب عليك أداء أعمال التّنظيف
لكن سيكون لديك مكان للإقامة فيه

288
00:20:58,630 --> 00:21:00,430
ليست صفقة سيّئة، صحيح؟

289
00:21:05,390 --> 00:21:07,390
...رايتو، ما الّذي

290
00:21:19,280 --> 00:21:21,070
!أنتم هنا

291
00:21:21,820 --> 00:21:23,280
!...إنّه السّيّد ساواشيرو

292
00:21:28,620 --> 00:21:29,500
!كيو

293
00:21:31,460 --> 00:21:32,500
أنتم

294
00:21:33,250 --> 00:21:34,420
هل أنتم بخير؟

295
00:21:35,710 --> 00:21:38,050
!هذا مُطمئن يا كيو

296
00:21:52,600 --> 00:21:53,940
جميعكم بأمان

297
00:21:55,310 --> 00:21:56,900
هذا مُطمئن

298
00:22:03,280 --> 00:22:05,700
لا تدع ما هو عاديّ عاديّاً

299
00:22:05,870 --> 00:22:08,450
العزف على المقطوعة لا يكفي

300
00:22:08,620 --> 00:22:13,370
نستقبل كلّ شيء، حتّى الضّجيج
ونجعله جلستنا الخاصّة

301
00:22:13,540 --> 00:22:17,170
لن تتغيّر الأمور بين أيدي الآخرين

302
00:22:17,340 --> 00:22:18,380
مُدّ يدك

303
00:22:18,550 --> 00:22:22,050
لا تخف من ارتكاب الخطأ، تابع

304
00:22:22,220 --> 00:22:23,380
بشجاعة

305
00:22:23,550 --> 00:22:26,220
قُل للقواعد لا

306
00:22:26,390 --> 00:22:28,600
توزيع الفائض؟ تعال إليّ

307
00:22:28,760 --> 00:22:31,100
شفرة غير مُتوقّعة

308
00:22:31,270 --> 00:22:36,230
لا تستطيع الإشارات التحكّم بهذه المشاعر

309
00:22:36,400 --> 00:22:37,400
أطلق صرخة

310
00:22:37,570 --> 00:22:39,860
شُجاع! لا مزيد من الخوف

311
00:22:40,030 --> 00:22:42,190
أُبقي رأسي عالياً

312
00:22:42,360 --> 00:22:47,320
لديّ شخص يدعمني

313
00:22:47,490 --> 00:22:49,660
إيقاع! لا يمكن إيقافنا

314
00:22:49,830 --> 00:22:52,290
نبضاتنا مُتآلفة

315
00:22:52,450 --> 00:22:56,540
سوف نُحدّث العالم

316
00:22:56,710 --> 00:22:58,210
بانفجار ضخم

317
00:23:03,670 --> 00:23:08,220
نركب سفينة فارهة فقط
لأنّنا تلقّينا أجراً جيّداً؟

318
00:23:08,390 --> 00:23:09,760
أهذه فكرة سديدة حقّاً؟

319
00:23:09,930 --> 00:23:11,430
لِمَ لا؟

320
00:23:11,600 --> 00:23:15,810
هناك مسبح خاصّ! عليّ أن
!أحضر زيّ سباحة

321
00:23:15,980 --> 00:23:18,610
!ماكوتو، هناك برنامج أبطال أيضاً

322
00:23:18,770 --> 00:23:23,740
!أجل. ربّما سنلتقي بذلك البطل الشّهير هناك

323
00:23:24,820 --> 00:23:30,530
،الحلقة القادمة من ديجيمون بيتبريك
"بطل ناقص"