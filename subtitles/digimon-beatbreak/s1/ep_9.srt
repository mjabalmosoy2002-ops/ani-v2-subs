151
00:10:22,410 --> 00:10:23,540
!لا تقلها

152
00:10:23,710 --> 00:10:26,920
!يا له من براز ضخم

153
00:10:27,840 --> 00:10:29,710
!قلتَها

154
00:10:32,130 --> 00:10:33,970
!أعرف ماذا أفعل

155
00:10:34,840 --> 00:10:36,640
!نفعل هذا

156
00:10:37,850 --> 00:10:38,760
نكزة

157
00:10:41,890 --> 00:10:43,770
!ماذا؟

158
00:10:48,940 --> 00:10:49,820
نكزة

159
00:10:53,110 --> 00:10:55,740
!ماذا؟

160
00:10:59,450 --> 00:11:00,330
ماذا؟

161
00:11:02,790 --> 00:11:04,290
