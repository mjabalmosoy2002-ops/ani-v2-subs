1
00:00:12,890 --> 00:00:17,020
في المستقبل القريب، يتمّ توليد إي-بولس
،بواسطة أفكار البشر ومشاعرهم

2
00:00:17,180 --> 00:00:20,810
واستخدام مصدر طاقة لأجهزة الذّكاء
الاصطناعيّ الّتي تُسمّى سابوتاما

3
00:00:20,980 --> 00:00:23,520
ما يؤدّي إلى تطوُّر جديد للبشريّة

4
00:00:24,610 --> 00:00:27,820
لكن انبثقتْ وحوشٌ مُرعبة من ظُلُمات هذه الظّاهرة

5
00:00:28,570 --> 00:00:31,160
وحوش تتطوّر بالتهامِ إي-بولس

6
00:00:31,620 --> 00:00:33,030
...إنّهم

7
00:00:33,450 --> 00:00:35,740
أشعر بنبضة مجنونة مدويّة

8
00:00:35,910 --> 00:00:38,660
حيث لا يمكن لأحد إيقافي بعدها

9
00:00:38,830 --> 00:00:42,710
سأشقّ طريقي إلى هناك بينما أبحث عن الإجابة

10
00:00:42,880 --> 00:00:44,920
انحت عاطفتك

11
00:00:46,210 --> 00:00:48,010
يتردّد صداه

12
00:00:48,170 --> 00:00:51,220
الإيقاع الّذي يتزامن

13
00:00:51,390 --> 00:00:55,640
هو نبضة تكشف رويداً عن العالم الخفيّ

14
00:00:55,810 --> 00:00:58,520
سجّل على قمّة خطّ الأساس الصّلب

15
00:00:58,680 --> 00:00:59,730
لا تعبث بالإيقاع

16
00:00:59,890 --> 00:01:01,440
العاديّ لا يكفي بالنّسبة لي

17
00:01:01,600 --> 00:01:04,770
!!!استمرّ في الصّراخ، صراخ
اصرخ كما لو أنّ هذا كلّ ما تملك

18
00:01:06,530 --> 00:01:11,740
حتّى لو بدأ ما تؤمن به يتشوّش

19
00:01:11,910 --> 00:01:14,490
الحقيقة الّتي تستحوذ عليها صامدة وحقيقيّة

20
00:01:14,660 --> 00:01:16,990
أَزِل ضابط الإيقاع وترجّل فحسب

21
00:01:17,160 --> 00:01:19,160
أشعر بنبضة مجنونة مدويّة

22
00:01:19,330 --> 00:01:21,870
النّبضة العاطفيّة الّتي تصدح

23
00:01:22,040 --> 00:01:25,630
هي مُعدّل الضّربات في الدّقيقة الّذي يستمرّ بلا توقُّف

24
00:01:25,790 --> 00:01:27,710
(لندع الإيقاع يقودنا)

25
00:01:27,880 --> 00:01:29,920
أمطار الغيم تبتلع المدينة

26
00:01:30,090 --> 00:01:33,680
حتّى لو تشوّه الإيقاع سأجعل ذلك جزءاً من روتيني

27
00:01:33,840 --> 00:01:36,260
اركبه كما ترى مُناسباً

28
00:01:36,430 --> 00:01:38,180
(لندع الإيقاع يقودنا)

29
00:01:38,350 --> 00:01:40,770
حتّى لو آلمني ذلك، لن أتوقّف

30
00:01:40,930 --> 00:01:43,600
استمرّ في نحت النّبضة
لا تتراجع أبداً

31
00:01:43,770 --> 00:01:47,320
يمكننا التغلّب على أيّ شيء

32
00:01:47,480 --> 00:01:49,280
اقرع بناء على عاطفتك

33
00:02:08,630 --> 00:02:10,460
موراساميمون، هل أنت بخير؟

34
00:02:10,630 --> 00:02:11,590
أجل

35
00:02:14,430 --> 00:02:18,260
!بسرعة! لن يدوم هذا الشّقّ

36
00:02:21,390 --> 00:02:22,230
!هل أنت بخير؟

37
00:02:33,900 --> 00:02:35,280
...أسوكا

38
00:02:58,100 --> 00:03:00,760
هذا مُطمئن... جميعكم بخير

39
00:03:02,470 --> 00:03:04,890
...لكن... موراساميمون قد

40
00:03:09,560 --> 00:03:10,690
...خاطر

41
00:03:11,320 --> 00:03:12,780
...بكُلّ شيء

42
00:03:14,570 --> 00:03:17,280
لحماية عائلتنا

43
00:03:24,660 --> 00:03:25,960
نامي قليلاً

44
00:03:26,540 --> 00:03:27,920
لا تضغطي على نفسكِ

45
00:03:51,060 --> 00:03:52,150
كيف حال كيو؟

46
00:03:54,070 --> 00:03:55,860
سيعيش

47
00:03:56,030 --> 00:03:58,240
فقط ليس كمُنظِّف

48
00:03:59,110 --> 00:04:00,280
...موراساميمون

49
00:04:01,910 --> 00:04:03,080
كان غلطتي أيضاً

50
00:04:06,040 --> 00:04:07,330
!حالة طارئة

51
00:04:07,500 --> 00:04:08,960
!التّلفزيون! تعالوا وانظروا

52
00:04:09,120 --> 00:04:10,040
ماذا؟

53
00:04:10,210 --> 00:04:13,340
هذه حقيقة مُكتشَفة حديثاً

54
00:04:13,500 --> 00:04:19,220
الأشخاص الّذين يبعثون إي-بولس شاذّة
يمكن أن يُسبّبوا خطأ في السّابوتاما خاصّتهم

55
00:04:19,680 --> 00:04:21,470
يخلق ذلك خللاً

56
00:04:22,100 --> 00:04:25,220
...الوحوش الّتي نشأت من خلال الإي-بولس

57
00:04:25,390 --> 00:04:26,810
الدِّيجيمون

58
00:04:28,230 --> 00:04:33,730
تمّ الحِفاظ على وجود الدِّيجيمون
عن الاتِّحاد العالميّ سرّاً

59
00:04:33,900 --> 00:04:38,450
استخدمتْ وزارةُ حماية المدنيّين
مُجرمين يُطلَق عليهم بالمُنظِّفين

60
00:04:38,610 --> 00:04:40,450
للتّغطية على هذا

61
00:04:41,240 --> 00:04:43,120
لكن لا تخافوا

62
00:04:43,280 --> 00:04:46,540
صحّحنا كافّة السّابوتاما الّتي تُعاني من خلل

63
00:04:46,700 --> 00:04:51,120
وسنُحدّثها بناء على نِظامٍ جديدٍ كُلّياً

64
00:04:51,630 --> 00:04:55,670
سترتبط السّابوتاما بمالكيها تلقائيّاً

65
00:04:55,840 --> 00:04:59,300
،ستكشف الإي-بولس الشّاذّ سلفاً

66
00:04:59,470 --> 00:05:06,390
وستتمكّن من استئصال الخلل الّذي
يؤدّي لصنع ديجيمون

67
00:05:07,020 --> 00:05:07,850
ماذا؟

68
00:05:08,310 --> 00:05:10,310
بدأ يتحدّث

69
00:05:20,280 --> 00:05:22,030
اكتملَ التّحديث

70
00:05:22,950 --> 00:05:24,530
تمّ الرّبط تلقائيّاً

71
00:05:25,450 --> 00:05:28,580
،سيمنع هذا أي أخطاء برمجيّة مُستقبليّة

72
00:05:28,750 --> 00:05:32,870
ويسمح لنا بإدارة الدِّيجيمونات كما ينبغي

73
00:05:33,380 --> 00:05:37,130
نُقدِّم لكم عالماً مثاليّاً

74
00:05:39,050 --> 00:05:41,470
هذه أنباءٌ سارّة

75
00:05:41,630 --> 00:05:43,890
!مهلاً. هذا كلام فارغ

76
00:05:44,050 --> 00:05:48,060
!هذا سيُميّز الأشخاص بحسب الإي-بولس خاصّتهم

77
00:05:48,890 --> 00:05:51,140
تمّ كشف إي-بولس شاذّ

78
00:05:51,310 --> 00:05:53,650
صنع ديجيمون مُحتمَل

79
00:05:53,810 --> 00:05:55,480
جاري إزالة الخلل

80
00:06:06,490 --> 00:06:09,370
لا بُدّ أنّه أُزيلَ لأنّه كان يُعاني من خلل

81
00:06:09,950 --> 00:06:12,790
لكن هذا خاطئ

82
00:06:12,960 --> 00:06:14,000
...أقصد

83
00:06:16,040 --> 00:06:18,250
تمّ كشف تقلُّب في الإي-بولس

84
00:06:18,420 --> 00:06:20,170
خُذي نفساً عميقاً

85
00:06:22,760 --> 00:06:24,840
هذا مُذهل

86
00:06:25,010 --> 00:06:29,010
أصبح الأمر برمّته بين يدَي الرّئيس وُنغ الآن

87
00:06:31,180 --> 00:06:32,890
ماذا فعلتم؟

88
00:06:33,390 --> 00:06:36,520
كولد هارت من دون ديجيمون

89
00:06:37,560 --> 00:06:41,650
هذه قدرة ألباتسومون الخاصّة

90
00:06:42,150 --> 00:06:43,860
كافّة السّابوتاما في العالم

91
00:06:44,030 --> 00:06:49,660
،مُتّصلة بشكل دائم بأبراكساس
الخادم المُضيف لعالم المرآة

92
00:06:49,830 --> 00:06:51,910
لا يمكن قطع اتِّصالهم

93
00:06:53,540 --> 00:06:57,580
ووضعنا ألباتسومون ضمن نُواته

94
00:06:58,920 --> 00:07:01,500
،عندما يكشف سابوتاما إي-بولس شاذّاً

95
00:07:01,670 --> 00:07:06,090
فإنّه يستخدم قدرةَ ألباتسومون لامتصاص
الإي-بولس بلا توقُّف

96
00:07:06,550 --> 00:07:07,680
جاري إزالة الخلل

97
00:07:07,840 --> 00:07:08,760
!...كلّا

98
00:07:10,470 --> 00:07:15,890
يُسحَب الإي-بولس بعدها من المالك المُرتبِط
من خلال بطاقته المزروعة

99
00:07:16,060 --> 00:07:17,980
ويُرسَل إلى ألباتسومون

100
00:07:19,940 --> 00:07:24,070
إذاً تستطيع إصابة أيّ شخص
...لديه سابوتاما بكولد هارت

101
00:07:25,280 --> 00:07:27,820
بحسب اختيارك

102
00:07:29,620 --> 00:07:34,000
من الآن فصاعداً، سأتحكّم بصنع الدِّيجيمونات

103
00:07:35,000 --> 00:07:38,170
سوف أسيطر على قوّة الإله

104
00:07:38,830 --> 00:07:41,460
هذا هو مشروع شانغري-لا الخاصّ بك إذاً

105
00:07:41,630 --> 00:07:44,170
المُشكلة المُتبقّية هي المُنظِّفون

106
00:07:44,880 --> 00:07:50,720
السّابوتاما خاصّتهم لا تعمل بشكل طبيعيّ
وغير مُتّصلة بأبراكساس

107
00:07:51,180 --> 00:07:52,260
روز

108
00:07:52,720 --> 00:07:55,390
اقضي على المُنظِّفين

109
00:07:59,940 --> 00:08:01,980
هذان من الشّخصين الآخرين

110
00:08:02,150 --> 00:08:05,570
نجما النّار والماء؟ سيستقيلان من النّجوم الخمس؟

111
00:08:06,400 --> 00:08:09,160
وهذه لي

112
00:08:15,700 --> 00:08:17,000
لا تخف

113
00:08:17,460 --> 00:08:21,130
أرسلتُ بالفعل نجمة الخشب الجديدة

114
00:08:23,750 --> 00:08:26,420
كايتو، ماذا تقصد؟

115
00:08:26,590 --> 00:08:29,050
لم أعُد من النُّجوم الخمس بعد الآن

116
00:08:29,220 --> 00:08:30,840
أنتم بمفردكم الآن

117
00:08:32,260 --> 00:08:36,350
!سأتبعك حتّى النّهاية يا كايتو-ساما

118
00:08:44,230 --> 00:08:46,070
ماذا يجدر بنا أن نفعل؟

119
00:08:46,230 --> 00:08:48,530
لا مزيد من جرائم الدِّيجيمونات

120
00:08:48,700 --> 00:08:50,240
لم يعُد كيو قادراً على القتال

121
00:08:50,950 --> 00:08:53,410
لا يسعنا فعل شيء

122
00:08:53,580 --> 00:08:56,700
!إذاً ستسمحون لهم بفعل ما يحلو لهم؟

123
00:08:57,200 --> 00:08:59,750
لسنا أبطالاً أو ما شابه

124
00:09:01,830 --> 00:09:02,880
أعلم

125
00:09:03,710 --> 00:09:05,670
أريد إنقاذ أسوكا أيضاً

126
00:09:07,420 --> 00:09:11,180
...لكن بسبب ما قلتُه

127
00:09:11,800 --> 00:09:13,930
!...كيو وموراساميمون

128
00:09:22,020 --> 00:09:24,440
!يا رِفاق، لدينا مُشكلة

129
00:09:36,660 --> 00:09:41,210
،أنا أحد النُّجوم الخمس الجديدة
!سينكا النّعيم

130
00:09:41,370 --> 00:09:45,340
!أيُّها المُنظِّفون! اخرجوا للّعب

131
00:09:51,380 --> 00:09:54,140
الجناح الخاصّ بوزارة حماية المدنيّين؟

132
00:09:54,550 --> 00:09:56,050
ماذا لديك هنا؟

133
00:09:56,220 --> 00:09:58,930
...فقدنا الاتّصال مع المقرّ. أعتقد

134
00:09:59,600 --> 00:10:01,850
تمّ كشف إي-بولس شاذّ

135
00:10:04,190 --> 00:10:05,730
جاري إزالة الخلل

136
00:10:07,520 --> 00:10:08,320
من هنا

137
00:10:10,030 --> 00:10:13,990
،إذاً الوزارة هي كبش فدائهم
ويُحاولون إسكاتك

138
00:10:14,700 --> 00:10:18,080
ثمّة شخص يجب أن تلتقي به
بينما ما زلتُ أملك وقتاً

139
00:10:24,080 --> 00:10:26,250
تاسوكو تينما، هو هو جاهز؟

140
00:10:27,000 --> 00:10:30,880
تمكّنتُ من إتمامه، لكن لا نملك ما يكفي

141
00:10:31,050 --> 00:10:32,590
ميهارو-
حسناً-

142
00:10:35,640 --> 00:10:40,220
هذا سيفصل بطاقتكِ عن السّابوتاما خاصّتكِ

143
00:10:44,140 --> 00:10:46,440
أنتِ... من غيفت؟

144
00:10:47,770 --> 00:10:49,860
وبـ"تينما"، تقصدين...؟

145
00:10:51,400 --> 00:10:53,490
تمّ كشف إي-بولس شاذّ

146
00:10:53,650 --> 00:10:56,490
أعطيني يدكِ. الوقتُ يُداهمنا

147
00:10:58,240 --> 00:10:59,870
جاري إزالة الخلل

148
00:11:02,700 --> 00:11:05,670
ماكي كوتسوادا، لديّ طلب

149
00:11:06,540 --> 00:11:09,920
...انقلي ذلك البخّاخ والبروفيسور تينما

150
00:11:10,800 --> 00:11:13,050
إلى غلوينغ داون

151
00:11:13,760 --> 00:11:14,880
سلّميهما

152
00:11:15,050 --> 00:11:16,010
!كاوارازاكي

153
00:11:17,010 --> 00:11:21,560
سيحتاجونهما

154
00:11:22,520 --> 00:11:23,350
...و

155
00:11:24,180 --> 00:11:28,060
هذا هو... عملي الأخير... لهم

156
00:11:34,030 --> 00:11:35,740
ما هؤلاء؟

157
00:11:36,400 --> 00:11:40,410
.براكيمون. فيرميليمون. تريسيرامون
ديجيمونات نهائيّة

158
00:11:40,580 --> 00:11:41,950
إنّها في حالة حمل زائد

159
00:11:42,120 --> 00:11:43,450
مثل غوغمامون؟

160
00:11:44,750 --> 00:11:47,250
!حان وقت صيد المُنظِّفين

161
00:11:47,790 --> 00:11:49,670
!والآن تولّوا أمرهم

162
00:11:49,830 --> 00:11:51,630
أتستهدفيننا؟

163
00:11:51,790 --> 00:11:53,250
!لن تنجحي

164
00:11:56,880 --> 00:11:58,010
!بريستيمون

165
00:11:59,930 --> 00:12:01,800
!الصّدى المُكثَّف

166
00:12:02,890 --> 00:12:04,100
!كيروبمون

167
00:12:13,730 --> 00:12:14,860
غيكّومون؟

168
00:12:15,240 --> 00:12:17,700
!سأحمي تومورو

169
00:12:19,820 --> 00:12:21,620
!عرقلة الأرجوحة

170
00:12:30,210 --> 00:12:31,920
!تومورو! حان وقت التطوُّر

171
00:12:35,590 --> 00:12:39,470
!ما الأمر؟! لا أستطيع الشُّعور بنبضاتك

172
00:12:45,810 --> 00:12:46,850
...ما

173
00:12:53,360 --> 00:12:56,110
ما الّذي نُقاتل لأجله أصلاً؟

174
00:13:00,150 --> 00:13:04,370
كم هذا مُضحك! جميعكم مُجرمون

175
00:13:04,530 --> 00:13:06,410
أنتم مُجرّد خلل برمجيّ

176
00:13:06,580 --> 00:13:08,080
!حان وقت اختفائكم

177
00:13:11,370 --> 00:13:14,460
كيو... ماذا يجدر بنا أن نفعل؟

178
00:13:15,250 --> 00:13:17,840
...في أوقات كهذه... كان هو دوماً

179
00:13:18,760 --> 00:13:20,680
!آسف لو تأخّرت، جميعاً

180
00:13:22,050 --> 00:13:23,140
!هيّا بنا

181
00:13:30,690 --> 00:13:31,980
!وداعاً

182
00:13:33,400 --> 00:13:35,150
!فريسبيكر

183
00:13:37,730 --> 00:13:39,030
!ما المُشكلة؟

184
00:13:42,030 --> 00:13:44,410
هوتاروكو؟ لماذا هي...؟

185
00:13:45,160 --> 00:13:46,530
!أنا من استدعاهم

186
00:13:46,740 --> 00:13:49,410
!ما تحتاجونه الآن هو أصدقاء

187
00:13:49,580 --> 00:13:52,500
أعضاء التّكتيك السّابقون. هذا مثاليّ

188
00:13:52,670 --> 00:13:55,130
!أنتم أخطاء برمجيّة أيضاً! لذا سأصطادكم

189
00:13:55,290 --> 00:13:57,250
!أنت من يجب اصطياده

190
00:14:04,090 --> 00:14:05,090
!غرانيت

191
00:14:12,270 --> 00:14:13,060
!لودومون

192
00:14:20,440 --> 00:14:24,660
!هوتاروكو، هذا جنون! إنّهم ديجيمونات نهائيّة

193
00:14:25,110 --> 00:14:28,200
!ولو كان كذلك، سأحميكم

194
00:14:30,240 --> 00:14:32,290
!هذه المرّة حان دورنا

195
00:14:32,460 --> 00:14:33,710
...غرانيت

196
00:14:35,460 --> 00:14:39,380
!بجدّية؟ كلمات فارغة من مجموعة ضُعفاء

197
00:14:44,220 --> 00:14:45,470
أنتم؟

198
00:14:47,050 --> 00:14:48,350
!ها أنا ذي

199
00:14:48,720 --> 00:14:51,720
ما الّذي تُفكِّرون فيه بالضّبط؟

200
00:14:51,890 --> 00:14:57,520
ديجيمونات تقف مع بشر؟
ستحمون الخلل البرمجيّ؟

201
00:15:00,020 --> 00:15:05,700
ماذا؟ هل العيش مع الأخطاء البرمجيّة
جعلكم تُعانون من خلل أيضاً؟

202
00:15:05,860 --> 00:15:07,660
هل أُصبتُم بحُمّى خفيفة؟

203
00:15:11,910 --> 00:15:13,450
أين المُشكلة إذا كنّا نُعاني من خلل؟

204
00:15:13,620 --> 00:15:14,330
ماذا؟

205
00:15:16,330 --> 00:15:18,460
من هؤلاء؟

206
00:15:23,970 --> 00:15:28,640
هذا صحيح. كنّا بائسين تماماً

207
00:15:29,140 --> 00:15:32,430
...لكن الرّجل الّذي بنى هذا المكان قال لنا

208
00:15:33,020 --> 00:15:35,520
!بأنّنا نستطيع البدء من الصّفر دوماً

209
00:15:36,730 --> 00:15:39,810
!يوماً ما، سيعيش البشر والدِّيجيمونات معاً

210
00:15:40,690 --> 00:15:43,230
!هذا المكان يحمي ذلك الحلم

211
00:15:44,400 --> 00:15:45,240
...لهذا السّبب

212
00:15:45,780 --> 00:15:47,160
!لن نسمح لكِ بتدمير ذلك

213
00:15:47,700 --> 00:15:49,120
!الفطر السّامّ

214
00:15:50,780 --> 00:15:53,120
!فطر

215
00:15:55,710 --> 00:15:58,920
،البدء من الصّفر أو عدم البدء
يبقى الخللُ خللاً

216
00:15:59,080 --> 00:16:01,460
البشر والدِّيجيمونات معاً؟

217
00:16:01,630 --> 00:16:04,420
!يا له من حلم عديم القيمة

218
00:16:05,170 --> 00:16:09,260
!أسرع واقضِ على هؤلاء

219
00:16:11,300 --> 00:16:14,270
!غيكّومون! بريستيمون! كيروبمون! تطوُّر

220
00:16:31,450 --> 00:16:33,330
!بيركاتمون

221
00:16:43,290 --> 00:16:45,510
!سكاورغيكيروبمون

222
00:16:48,090 --> 00:16:51,050
!موناركليزامون

223
00:17:04,610 --> 00:17:05,820
!هل أنتم بخير؟

224
00:17:08,400 --> 00:17:11,450
ماذا كان ذلك بالضّبط؟

225
00:17:13,530 --> 00:17:17,160
غلوينغ داون لا يحذفون الدِّيجيمونات

226
00:17:18,580 --> 00:17:21,960
هل يستحقّ الحذف فقط لأنّه خلل يا تومورو؟

227
00:17:24,290 --> 00:17:27,380
آنذاك، لم أستطع الإجابة

228
00:17:28,920 --> 00:17:29,760
...لكن

229
00:17:30,930 --> 00:17:32,220
!أستطيع الآن

230
00:17:32,550 --> 00:17:35,550
!لا، لا يستحقّ! بالطّبع لا يستحقّ

231
00:17:37,890 --> 00:17:40,480
مهما حدث... لا تضلّا طريقيكما

232
00:17:41,230 --> 00:17:44,400
ثِقا بنفسيكما... ثِقا بعائلتكما

233
00:17:45,560 --> 00:17:48,940
!أريد تحقيق حلم كيو

234
00:17:49,110 --> 00:17:52,910
مُستقبل حيث يستطيع الدِّيجيمونات
!والبشر يعيشون معاً

235
00:17:53,700 --> 00:17:54,700
...نحن

236
00:17:56,280 --> 00:17:58,240
!غلوينغ داون

237
00:18:05,580 --> 00:18:07,460
!أيّتها الخِلال المُزعجة

238
00:18:11,550 --> 00:18:13,720
!عصفة اليأس

239
00:18:26,150 --> 00:18:28,190
!الهجمة الفتّاكة

240
00:18:35,410 --> 00:18:36,870
...الحُكم

241
00:18:38,580 --> 00:18:41,330
!الأخير

242
00:18:41,500 --> 00:18:44,120
!افعلها

243
00:18:52,760 --> 00:18:56,930
هؤلاء عديمو الجدوى تماماً

244
00:18:57,090 --> 00:19:01,180
في المرّة المُقبلة، سأحضر جنوداً من المُختبر

245
00:19:01,680 --> 00:19:02,600
جنود"؟"

246
00:19:03,140 --> 00:19:04,310
لا يوجد مرّة مُقبلة

247
00:19:04,480 --> 00:19:06,850
ستذهبين إلى وزارة حماية المدنيّين

248
00:19:07,730 --> 00:19:09,770
وزارة حماية المدنيّين"؟"

249
00:19:09,940 --> 00:19:12,940
أُبيدَتْ بالفعل

250
00:19:13,110 --> 00:19:14,360
ماذا تقصدين؟

251
00:19:16,070 --> 00:19:17,410
!وداعاً

252
00:19:25,580 --> 00:19:26,620
الجميع

253
00:19:27,330 --> 00:19:28,630
يسرّني أنّكم بخير

254
00:19:30,340 --> 00:19:31,590
!هنا

255
00:19:33,710 --> 00:19:36,180
ميهارو! هل كنتِ بخير؟

256
00:19:36,510 --> 00:19:37,390
أجل

257
00:19:37,840 --> 00:19:39,140
بفضل هذا

258
00:19:39,300 --> 00:19:42,850
قد يكون هذا قادراً على استعادة أسوكا

259
00:19:43,020 --> 00:19:43,850
ماذا؟

260
00:19:44,020 --> 00:19:45,690
من يكون هذا؟

261
00:19:45,850 --> 00:19:48,060
البروفيسور تاسوكو تينما

262
00:19:48,230 --> 00:19:50,400
تومورو. إنّه جدُّك

263
00:19:50,560 --> 00:19:51,400
ماذا؟

264
00:19:51,940 --> 00:19:53,110
!جدِّي؟

265
00:19:53,280 --> 00:19:55,190
غالباً لا تتذكّرني

266
00:19:56,070 --> 00:19:58,530
سبّبتُ لكما الكثير من المتاعب

267
00:19:59,870 --> 00:20:05,290
بعد حادثة جزيرة كانو، احتججتُ
على الاستخدام التّجاريّ للإي-بولس

268
00:20:06,120 --> 00:20:09,630
حاولَ وُنغ إسكاتي

269
00:20:09,790 --> 00:20:12,500
وحتّى أنّه أمر باعتقال والديكِ
لأنّهما قاوماه

270
00:20:14,710 --> 00:20:18,800
بفضل زميلي الكوهاي في الكلّيّة
يوشيمورا وكاوارازاكي

271
00:20:18,970 --> 00:20:22,300
تمكّنتُ من النّجاة في الجناح الخاصّ بالوزارة

272
00:20:23,140 --> 00:20:26,140
كنتُ بعيداً عن قبضة وُنغ هناك

273
00:20:26,310 --> 00:20:28,850
يبدو أنّ والديك بأمان أيضاً

274
00:20:29,560 --> 00:20:30,810
هذا مُطمئن

275
00:20:34,320 --> 00:20:39,200
قد يفصل هذا سابوتاما عن بطاقة
مزروعة بشكلٍ قسريّ

276
00:20:40,200 --> 00:20:41,280
...هذا يعني

277
00:20:41,450 --> 00:20:44,490
يمكننا فصل أسوكا عن ألباتسومون

278
00:20:48,910 --> 00:20:51,580
انتبه. يُستعمَل لمرّة واحدة فقط

279
00:20:52,590 --> 00:20:55,670
أرِني العالمَ الجديد الّذي وعدتَ به

280
00:20:56,800 --> 00:20:57,670
حسناً

281
00:20:59,130 --> 00:21:02,720
أين كاوارازاكي؟ قيل لنا بأنّ
الوزارة قد زالت الآن

282
00:21:08,230 --> 00:21:10,140
لديّ طلب عمل منه

283
00:21:10,900 --> 00:21:11,810
طلبه الأخير

284
00:21:14,980 --> 00:21:18,610
...شانغري-لا المُزيّفة الخاصّة بالرّئيس وُنغ

285
00:21:20,240 --> 00:21:21,360
دمِّروها

286
00:21:30,710 --> 00:21:31,670
كيو

287
00:21:32,290 --> 00:21:33,880
لن أضلّ طريقي ثانية

288
00:21:35,040 --> 00:21:36,340
...سأثق بنفسي

289
00:21:36,800 --> 00:21:38,260
وسأثق بعائلتي

290
00:21:39,840 --> 00:21:40,930
إلى اللِّقاء

291
00:21:52,310 --> 00:21:53,230
!هيّا بنا

292
00:21:57,480 --> 00:21:59,190
!لنُحوّل العالم إلى خلَل

293
00:22:01,200 --> 00:22:07,370
اتّخذتُ قراري وسأعيش حياتي على طريقتي

294
00:22:07,870 --> 00:22:14,630
كُلّ شيء يبدو مُناسباً
سأجعل الغد هو الأفضل

295
00:22:14,790 --> 00:22:16,790
تعلم بأنّني لا أستطيع اصطناع ذلك

296
00:22:16,960 --> 00:22:18,750
لا أستطيع التحكُّم بهذه الطّاقة

297
00:22:18,920 --> 00:22:22,220
لا أنسجم، لكنّني على قيد الحياة

298
00:22:22,380 --> 00:22:28,850
يجب أن أُحوّل كُلّ ندبة إلى لحن
لذا ها أنا ذا

299
00:22:29,100 --> 00:22:34,560
سأكسر ما هو واضح، بهذا الصّوت

300
00:22:34,730 --> 00:22:36,650
سأكسره الآن، سأكسره الآن أجل

301
00:22:36,810 --> 00:22:41,070
الإيقاع الّذي ينبض في أعماق قلبي

302
00:22:41,240 --> 00:22:43,240
سأعيد كتابة حياتي

303
00:22:43,400 --> 00:22:45,990
أريد فقط أن أؤمن لأنّني أعلم
بأنّ هذا هو المفتاح

304
00:22:46,160 --> 00:22:48,450
سأجعل ذلك يصدح في كلّ أنحاء العالم

305
00:22:48,620 --> 00:22:51,040
هذه هي حقيقتي
"أريد فقط أن أكون "أنا

306
00:22:51,200 --> 00:22:52,580
وأريد أن أكون حُرّاً

307
00:22:52,750 --> 00:22:55,370
سأكسره الآن، سأكسره الآن

308
00:22:55,540 --> 00:22:57,170
وأجد نفسي

309
00:23:03,050 --> 00:23:04,720
لن أتردّد بعد الآن

310
00:23:04,880 --> 00:23:07,800
!هذه المرّة، أعِدُ بأنّني سأُنقذ أسوكا

311
00:23:07,970 --> 00:23:09,640
!أجل يا تومورو

312
00:23:09,810 --> 00:23:11,850
!على أيّ حال، حان وقت الأكل

313
00:23:12,020 --> 00:23:15,270
لدينا حُلفاء مُؤتمنون آخرون كذلك

314
00:23:15,520 --> 00:23:17,810
ستكون الأمور على ما يُرام. أنا متأكد
بأنّنا سوف ننجح

315
00:23:17,980 --> 00:23:22,030
أجل. لا يمكننا أن ندعهم يُغيِّرون
العالم كما يحلو لهم

316
00:23:22,440 --> 00:23:24,150
!هيّا بنا يا رِفاق

317
00:23:24,820 --> 00:23:30,530
،الحلقة القادمة من ديجيمون بيتبريك
"القوّة العُظمى"