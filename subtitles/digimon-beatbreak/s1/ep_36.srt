!حرّري نفسك

198
00:13:03,320 --> 00:13:06,200
!تطوُّر غيكّومون

199
00:13:23,260 --> 00:13:25,970
!موناركليزامون

200
00:13:31,560 --> 00:13:32,350
تومورو؟

201
00:13:32,520 --> 00:13:34,310
!هيّا يا موناركليزامون

202
00:13:35,690 --> 00:13:38,060
!دعي ميهارو تذهب

203
00:13:53,580 --> 00:13:54,950
هذه مُعضلة

204
00:13:55,120 --> 00:13:57,330
لا تدعي تلك السّحابة تلمسك

205
00:13:58,040 --> 00:14:00,340
!إذاً سوف نُبدّد السّحابة فحسب

206
00:14:08,130 --> 00:14:09,390
!لا

207
00:14:16,020 --> 00:14:18,190
تعالي يا ميهارو

208
00:14:23,860 --> 00:14:24,780
!ميهارو

209
00:14:26,780 --> 00:14:27,820
!موناركليزامون

210
00:14:27,990 --> 00:14:29,240
!حسناً

211
00:14:34,290 --> 00:14:35,700
!لا تفعل يا تومورو

212
00:14:36,870 --> 00:14:39,540
!لم ننتهِ من الكلام

213
00:14:43,000 --> 00:14:45,130
!هيّا يا تومورو

214
00:14:54,100 --> 00:14:55,520
!ميهارو

215
00:14:56,560 --> 00:14:57,600
!تومورو

216
00:15:03,730 --> 00:15:04,690
ماذا؟

217
00:15:34,760 --> 00:15:36,560
...ماذا؟ نحن

218
00:15:37,100 --> 00:15:39,180
إنّها تلك الغرفة

219
00:15:40,270 --> 00:15:43,230
أدوات جمعَتْها أمّي وأبي كهواية

220
00:15:44,440 --> 00:15:46,980
لم نُرِد التخلُّص منها عندما انتقلنا

221
00:15:47,400 --> 00:15:48,570
...آنذاك

222
00:15:49,070 --> 00:15:51,280
استخدمتُ هذه كغرفة لي

223
00:15:51,700 --> 00:15:52,660
آنذاك؟

224
00:15:54,740 --> 00:15:55,870
عُدت إلى المنزل

225
00:15:59,040 --> 00:15:59,830
ميهارو

226
00:16:00,580 --> 00:16:02,540
أهلاً بعودتك يا تشيفويو

227
00:16:02,710 --> 00:16:05,250
تركتِ الأضواء تعمل ثانية؟

228
00:16:05,420 --> 00:16:08,090
ما هذا؟ أتُبرمجين تطبيقاً من جديد؟

229
00:16:09,090 --> 00:16:10,470
غيفت"؟"

230
00:16:10,630 --> 00:16:12,180
تطبيق إهداء؟

231
00:16:12,340 --> 00:16:13,130
أجل

232
00:16:13,300 --> 00:16:17,390
كلّ هذا لإلقاء التّحيّة على شخص ما كُلّ يوم

233
00:16:18,760 --> 00:16:20,730
سيكون هذا تطبيقاً رائعاً

234
00:16:20,890 --> 00:16:22,850
لم أكمل نصفه بعد

235
00:16:24,060 --> 00:16:28,020
يمكن رؤية قلب الصّانع في شفرته

236
00:16:28,520 --> 00:16:31,440
شفرتكِ لطيفة جدّاً

237
00:16:33,950 --> 00:16:40,330
كانت أختي مُهندسة نُظُم تعمل على الذّكاء
الصّناعيّ لسابوتاما لحساب اتّحاد العالم

238
00:16:41,040 --> 00:16:44,750
لكنّها كانت لطيفة جدّاً

239
00:16:46,170 --> 00:16:51,010
فقدنا والدينا ولم أستطع التكيُّف مع المدرسة

240
00:16:51,170 --> 00:16:53,760
لكنّها كانت دائماً ما تدعمني بابتسامة

241
00:16:54,300 --> 00:16:55,260
!ميهارو

242
00:16:55,760 --> 00:16:58,550
ماذا؟ تبدين مُتحمّسة

243
00:16:59,260 --> 00:17:03,350
!أتعلمين؟ اكتشفتُ شيئاً مُذهلاً

244
00:17:06,520 --> 00:17:07,400
ماذا؟

245
00:17:15,910 --> 00:17:17,660
ما هذا المكان؟

246
00:17:17,820 --> 00:17:18,700
...في الواقع

247
00:17:18,870 --> 00:17:20,660
!أيّتها الزّهور، تفتّحي من هذه الأرض

248
00:17:27,790 --> 00:17:29,210
...مُذهل

249
00:17:38,510 --> 00:17:39,850
ما رأيكِ بذلك؟

250
00:17:40,010 --> 00:17:41,060
هل فاجأتُكِ؟

251
00:17:41,220 --> 00:17:42,010
!ماذا؟

252
00:17:42,180 --> 00:17:45,940
مهلاً يا ويزارمون. لا تُخيفيها

253
00:17:46,350 --> 00:17:48,350
آسف بشأن ذلك يا تشيفويو

254
00:17:50,690 --> 00:17:56,570
كانت ويزارمون ديجيموناً وُلِدت من سابوتاما
التّطوير الخاصّة بتشيفويو

255
00:17:57,570 --> 00:18:02,830
غداً، سأذهب إلى مقرّ اتّحاد
العالم رفقة ويزارمون

256
00:18:03,660 --> 00:18:07,000
سنطلب منهم الإعلان عن وجود الدّيجيمون

257
00:18:07,160 --> 00:18:09,080
سيُفاجئ ذلك الجميع

258
00:18:09,250 --> 00:18:11,880
قد يُعيد هذا صياغة قانون العالم

259
00:18:12,460 --> 00:18:14,760
إعادة صياغة القانون؟

260
00:18:14,920 --> 00:18:18,720
تأمّلي فقط الأشياء المُذهلة
الّتي يستطيعون فعلها

261
00:18:18,880 --> 00:18:23,390
أعرف بأنّ قوّة الدّيجيمون
ستُحقّق لنا السّعادة

262
00:18:23,760 --> 00:18:27,600
أريد تعلُّم المزيد عنك وعن البشر
!الآخرين أيضاً

263
00:18:27,770 --> 00:18:29,060
أسمعتِ ذلك؟

264
00:18:32,360 --> 00:18:33,520
...كانت بالفعل

265
00:18:33,980 --> 00:18:36,280
لطيفة جدّاً بالنّسبة لهذا العالم

266
00:18:41,620 --> 00:18:44,740
...تمّت مُصادرة ويزارمون بواسطة اتّحاد العالم

267
00:18:44,910 --> 00:18:45,950
...وتشيفويو

268
00:18:46,620 --> 00:18:49,250
!الدّيجيمونات موجودة فعلاً

269
00:18:49,420 --> 00:18:52,380
!سيقتلون ويزارمون

270
00:18:52,540 --> 00:18:55,250
!أرجوك! تكلّم مع رؤسائك

271
00:18:56,210 --> 00:18:58,630
كاغيموري، هل أنتِ بخير؟

272
00:18:58,800 --> 00:18:59,760
ماذا؟

273
00:19:00,220 --> 00:19:03,300
أعتقد يجدر بكِ رؤية طبيب

274
00:19:09,230 --> 00:19:10,230
...لماذا

275
00:19:10,900 --> 00:19:12,860
لماذا لا يُصدّقني أحد؟

276
00:19:13,730 --> 00:19:14,860
كاغيموري

277
00:19:15,780 --> 00:19:17,570
خذي إجازة

278
00:19:21,160 --> 00:19:24,330
أنا آسفة

279
00:19:25,240 --> 00:19:27,790
أنا آسفة يا ويزارمون

280
00:19:28,160 --> 00:19:29,410
أنا آسفة

281
00:19:32,670 --> 00:19:35,290
سأذهب لشراء العشاء

282
00:19:44,720 --> 00:19:45,810
!ويزارمون

283
00:19:46,510 --> 00:19:48,060
...ميـ... هارو

284
00:19:49,520 --> 00:19:50,560
...آسفة

285
00:19:51,730 --> 00:19:55,150
...ا-الإي... بولس خاصّتك

286
00:19:55,690 --> 00:19:56,690
!حسناً

287
00:20:03,320 --> 00:20:04,410
!تشيفويو

288
00:20:06,660 --> 00:20:08,450
!تشيفويو، إنّها ويزارمون

289
00:20:10,700 --> 00:20:11,660
ماذا؟

290
00:20:12,620 --> 00:20:13,750
تشيفويو؟

291
00:20:34,600 --> 00:20:35,730
لماذا؟

292
00:20:42,240 --> 00:20:44,660
!كيف أمكنك؟! تشيفويو

293
00:20:49,160 --> 00:20:51,830
ويزار... مون؟

294
00:20:54,420 --> 00:20:55,460
ميهارو

295
00:20:56,830 --> 00:20:58,920
...قانون هذا العالم

296
00:20:59,380 --> 00:21:00,920
مُشوَّه

297
00:21:01,090 --> 00:21:02,300
قانون؟

298
00:21:03,300 --> 00:21:04,880
...لنُعِد صياغته

299
00:21:05,930 --> 00:21:07,010
معاً

300
00:21:09,310 --> 00:21:10,430
تشيفويو؟

301
00:21:14,060 --> 00:21:15,640
ألا ترى؟

302
00:21:16,230 --> 00:21:19,610
...سوية مع تشيفويو... مع ميفيسمون

303
00:21:20,190 --> 00:21:22,280
!سنُحقّق حُلمها

304
00:21:22,780 --> 00:21:23,690
!ميهارو

305
00:21:24,650 --> 00:21:28,200
سنُعيد صياغة قانون هذا العالم

306
00:21:28,820 --> 00:21:31,240
هذا صحيح. هكذا ينبغي أن يكون الأمر

307
00:21:31,410 --> 00:21:32,910
!لا يمكنك! لا تذهبي

308
00:21:33,910 --> 00:21:35,120
...وداعاً

309
00:21:35,960 --> 00:21:36,830
تومورو

310
00:21:51,560 --> 00:21:52,390
!ميهارو

311
00:21:52,560 --> 00:21:54,730
!انتظري! عودي

312
00:21:56,560 --> 00:21:59,690
!ميهارو

313
00:22:00,900 --> 00:22:06,200
العين بالعين

314
00:22:06,360 --> 00:22:09,740
مُعجزة ميرا-ميرا

315
00:22:12,580 --> 00:22:14,950
عطست أيضاً

316
00:22:15,120 --> 00:22:17,960
ضحِكنا بنفس التّعابير

317
00:22:18,120 --> 00:22:23,920
ما تُفكِّر فيه
عِدنا بأن تخبرني بكلّ شيء

318
00:22:24,090 --> 00:22:29,300
نحن كمرآتين مُتقابلتين
سيكون هناك المزيد من البسمات

319
00:22:29,970 --> 00:22:32,050
"معاً... للأبد"

320
00:22:32,390 --> 00:22:35,270
مئات التّحديثات

321
00:22:35,430 --> 00:22:37,730
العين بالعين

322
00:22:37,890 --> 00:22:41,060
مرآة ميرا-ميرا
مُعجزات مُتضاعِفة

323
00:22:41,230 --> 00:22:46,570
أدخل في ورطة حقيقيّة
لكن مع ذلك أحبّ أن أتطوّر

324
00:22:46,740 --> 00:22:52,370
لنستمتع حتّى بفشلنا
أفضّل أن أكون واقعيّاً على أن أكون مثاليّاً

325
00:22:52,530 --> 00:22:55,160
استجمع نورك

326
00:22:55,330 --> 00:22:58,370
!المعي يا مرآة، مرآة

327
00:23:03,590 --> 00:23:07,260
ميهارو، يتمّ التحكُّم بكِ بواسطة
ميفيسمون، أليس كذلك؟

328
00:23:07,630 --> 00:23:10,180
...تعريض هذا العدد الكبير من النّاس لخطر

329
00:23:10,340 --> 00:23:14,470
هل تعتقدين حقّاً بأنّ هذا
سيُحقّق أُمنية تشيفويو؟

330
00:23:14,970 --> 00:23:18,730
،إذا رأتكِ تشيفويو تفعلين هذه الأشياء الفظيعة

331
00:23:18,890 --> 00:23:23,060
فهل تعتقدين بأنّ هذا سيجعلها تبتسم؟

332
00:23:24,860 --> 00:23:30,610
،الحلقة القادمة من ديجيمون بيتبريك
"سحر لطيف"