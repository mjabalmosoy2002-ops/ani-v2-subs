1
00:00:12,880 --> 00:00:17,000
في المستقبل القريب، يتمّ توليد إي-بولس
،بواسطة أفكار البشر ومشاعرهم

2
00:00:17,170 --> 00:00:20,790
واستخدام مصدر طاقة لأجهزة الذّكاء
الاصطناعيّ الّتي تُسمّى سابوتاما

3
00:00:20,960 --> 00:00:23,500
ما يؤدّي إلى تطوُّر جديد للبشريّة

4
00:00:24,580 --> 00:00:27,790
لكن انبثقتْ وحوشٌ مُرعبة من ظُلُمات هذه الظّاهرة

5
00:00:28,580 --> 00:00:31,170
وحوش تتطوّر بالتهامِ إي-بولس

6
00:00:31,630 --> 00:00:33,040
...إنّهم

7
00:00:33,460 --> 00:00:35,750
أشعر بنبضة مجنونة مدويّة

8
00:00:35,920 --> 00:00:38,660
حيث لا يمكن لأحد إيقافي بعدها

9
00:00:38,830 --> 00:00:42,710
سأشقّ طريقي إلى هناك بينما أبحث عن الإجابة

10
00:00:42,880 --> 00:00:44,920
انحت عاطفتك

11
00:00:46,210 --> 00:00:48,000
يتردّد صداه

12
00:00:48,170 --> 00:00:51,210
الإيقاع الّذي يتزامن

13
00:00:51,380 --> 00:00:55,620
هو نبضة تكشف رويداً عن العالم الخفيّ

14
00:00:55,790 --> 00:00:58,500
سجّل على قمّة خطّ الأساس الصّلب

15
00:00:58,670 --> 00:00:59,710
لا تعبث بالإيقاع

16
00:00:59,880 --> 00:01:01,410
العاديّ لا يكفي بالنّسبة لي

17
00:01:01,580 --> 00:01:04,750
!!!استمرّ في الصّراخ، صراخ
اصرخ كما لو أنّ هذا كلّ ما تملك

18
00:01:06,500 --> 00:01:11,750
حتّى لو بدأ ما تؤمن به يتشوّش

19
00:01:11,920 --> 00:01:14,500
الحقيقة الّتي تستحوذ عليها صامدة وحقيقيّة

20
00:01:14,670 --> 00:01:16,960
أَزِل ضابط الإيقاع وترجّل فحسب

21
00:01:17,170 --> 00:01:19,160
أشعر بنبضة مجنونة مدويّة

22
00:01:19,330 --> 00:01:21,870
النّبضة العاطفيّة الّتي تصدح

23
00:01:22,040 --> 00:01:25,620
هي مُعدّل الضّربات في الدّقيقة الّذي يستمرّ بلا توقُّف

24
00:01:25,790 --> 00:01:27,710
(لندع الإيقاع يقودنا)

25
00:01:27,880 --> 00:01:29,910
أمطار الغيم تبتلع المدينة

26
00:01:30,080 --> 00:01:33,660
حتّى لو تشوّه الإيقاع سأجعل ذلك جزءاً من روتيني

27
00:01:33,830 --> 00:01:36,250
اركبه كما ترى مُناسباً

28
00:01:36,420 --> 00:01:38,160
(لندع الإيقاع يقودنا)

29
00:01:38,330 --> 00:01:40,750
حتّى لو آلمني ذلك، لن أتوقّف

30
00:01:40,920 --> 00:01:43,580
استمرّ في نحت النّبضة
لا تتراجع أبداً

31
00:01:43,750 --> 00:01:47,290
يمكننا التغلّب على أيّ شيء

32
00:01:47,500 --> 00:01:49,250
اقرع بناء على عاطفتك

33
00:01:59,960 --> 00:02:01,960
الطّقس بارد

34
00:02:21,380 --> 00:02:22,670
ما هذا؟

35
00:02:25,000 --> 00:02:26,250
...هذا الصّوت

36
00:02:26,420 --> 00:02:28,000
درّاجة ناريّة كلاسيكيّة؟

37
00:02:28,540 --> 00:02:32,040
مهلاً، مهلاً... عضو عصابة درّاجات
في عصرنا هذا؟

38
00:02:32,210 --> 00:02:33,210
ماذا؟

39
00:02:37,420 --> 00:02:39,630
تمّ رصد مركبة تسلك اتّجاهاً خاطئاً

40
00:02:50,750 --> 00:02:54,460
تفضّل. استمتع بقهوتك المطحونة الطّازجة

41
00:02:59,210 --> 00:03:01,000
عائلة

42
00:03:01,170 --> 00:03:03,580
مُكافأة قدرها 50،000 نقطة؟

43
00:03:03,750 --> 00:03:06,120
إنّها النّصف فقط. هل هي صحيحة؟

44
00:03:06,290 --> 00:03:07,290
إنّها صحيحة

45
00:03:07,460 --> 00:03:12,080
ما لم نرغب في تسليم الدّيجيمون
،لوزارة حماية المدنيّين

46
00:03:12,250 --> 00:03:14,880
أو إن حُذِف، تنخفض المُكافأة

47
00:03:15,710 --> 00:03:16,750
...حذف

48
00:03:18,580 --> 00:03:22,500
غلوينغ داون لا يحذفون الدّيجيمون

49
00:03:23,330 --> 00:03:27,880
هذه هي... قاعدتنا الوحيدة

50
00:03:33,960 --> 00:03:36,290
حسناً، بخصوص العمل التّالي

51
00:03:36,460 --> 00:03:38,210
لن أتمكّن من الانضمام لكم

52
00:03:38,630 --> 00:03:40,210
عمل شخصيّ آخر؟

53
00:03:40,380 --> 00:03:42,520
آسف. سيترتّب عليكم تولّيه

54
00:03:42,690 --> 00:03:43,710
!ماذا؟

55
00:03:43,880 --> 00:03:45,460
..."بـ"يترتّب عليكم

56
00:03:47,420 --> 00:03:49,660
تقصدنا نحن الثّلاثة؟

57
00:03:49,830 --> 00:03:51,580
!أنا هنا أيضاً كما تعلم

58
00:03:51,750 --> 00:03:52,750
أنا أيضاً

59
00:03:52,960 --> 00:03:53,970
!وأنا

60
00:03:54,140 --> 00:03:56,250
في الواقع، ليس هذا ما قصدت

61
00:03:57,380 --> 00:03:59,870
يجب علينا الاهتمام بالمُبتدئ؟

62
00:04:00,040 --> 00:04:02,290
قضيتِ أطول فترة بيننا هنا

63
00:04:02,460 --> 00:04:03,630
...بصفتكِ القائدة

64
00:04:04,710 --> 00:04:05,960
اهتمّي بالجميع

65
00:04:08,710 --> 00:04:09,960
رينا؟

66
00:04:11,710 --> 00:04:15,080
!حسنٌ إن كنت مُصرّاً

67
00:04:15,250 --> 00:04:17,750
!ماكي، أيني المعلومات

68
00:04:17,920 --> 00:04:19,460
!هيّا! لنذهب

69
00:04:20,210 --> 00:04:22,790
!مهلاً! كفّي عن شدّي

70
00:04:23,630 --> 00:04:26,540
هذا ما أريدكم أن تتولّوه

71
00:04:29,250 --> 00:04:30,540
ماهامون؟

72
00:04:30,710 --> 00:04:34,000
مُشاغب يعشق السّباق والسّرعات العالية

73
00:04:34,210 --> 00:04:38,400
كان يصطدم بشاحنات الحمولة في الطّريق
السّاحلة في اللّيالي القليلة الماضية

74
00:04:38,570 --> 00:04:39,660
الحمولة؟

75
00:04:39,830 --> 00:04:41,710
شبه ناقلات سابوتاما

76
00:04:41,880 --> 00:04:45,620
إنّه يُدمِّر الشّاحنة والمالك يسرق الحمولة

77
00:04:45,790 --> 00:04:47,910
غالباً لبيعها في السّوق السّوداء

78
00:04:48,080 --> 00:04:50,580
!يجب علينا القبض عليهما فحسب إذاً

79
00:04:50,750 --> 00:04:55,210
أجل. لكن يظهران بشكل عشوائيّ
وليس من السّهل القبض عليهما

80
00:04:55,380 --> 00:04:56,460
أرفُض

81
00:04:57,000 --> 00:05:00,500
عمّاذا تتكلّم؟ لا تملك خياراً

82
00:05:00,670 --> 00:05:03,170
هذا مُجرّد لصّ

83
00:05:03,630 --> 00:05:07,210
أفضّل البحث عن أدلّة حول أخي
على القيام بهذا العمل السّخيف

84
00:05:07,380 --> 00:05:08,580
العمل السّخيف"؟"

85
00:05:08,750 --> 00:05:11,460
أنا متأكّدة بأنّ كيو يتحرّى حول ذلك أيضاً

86
00:05:11,630 --> 00:05:15,800
لكن لا يمكنك توفير قوت يومك
إذا كنتَ نيّقاً في العمل

87
00:05:16,010 --> 00:05:17,080
!قوت

88
00:05:17,250 --> 00:05:19,000
نحن عائلة

89
00:05:19,210 --> 00:05:22,790
أنت عضو الآن، لذا ساعدنا

90
00:05:24,710 --> 00:05:25,750
!قوت

91
00:05:30,250 --> 00:05:35,670
عقب الهجمات، مسؤولو الشّحن
يُقلّلون عدد الشّاحنات والطُّرُق

92
00:05:36,170 --> 00:05:38,540
لذا هذا هو الطّريق الوحيد اليوم

93
00:05:40,130 --> 00:05:41,210
!إنّه هنا

94
00:05:41,380 --> 00:05:42,580
لا بُدّ أنّه هذا

95
00:05:42,750 --> 00:05:43,830
!حسناً

96
00:05:46,720 --> 00:05:47,840
!عُلِم

97
00:05:48,010 --> 00:05:49,040
!رينا

98
00:05:49,210 --> 00:05:50,210
!حسناً

99
00:05:50,380 --> 00:05:52,660
!أنت، قُم بعملك

100
00:05:52,830 --> 00:05:54,130
أعلم

101
00:05:58,000 --> 00:05:59,040
هذا هو

102
00:06:00,500 --> 00:06:04,660
!رينا، صوّبي نحو النّواة في جسده
!هذه هي نقطة ضعف ماهامون

103
00:06:04,830 --> 00:06:06,580
!حسناً! ولفرمون

104
00:06:06,750 --> 00:06:08,750
!صاروخ سكاتر

105
00:06:11,500 --> 00:06:13,750
تمّ رصد انفجار. جاري التوقُّف

106
00:06:14,170 --> 00:06:16,080
!حان دوري الآن

107
00:06:17,040 --> 00:06:19,910
!أسقطيه! ثمّ استهدفي النُّواة

108
00:06:20,080 --> 00:06:21,080
!عُلم

109
00:06:22,750 --> 00:06:23,750
!مهلاً

110
00:06:24,380 --> 00:06:25,960
!ها هو ذا

111
00:06:26,960 --> 00:06:28,750
!النّبضة المُحطِّمة

112
00:06:29,750 --> 00:06:31,130
!اختفى

113
00:06:32,040 --> 00:06:35,130
هل أنت الشّخص الّذي ضربني؟

114
00:06:37,000 --> 00:06:38,710
!ابقَ مكانك

115
00:06:38,880 --> 00:06:40,910
!لم أُهزَم بعد

116
00:06:41,080 --> 00:06:42,210
!انتظر

117
00:06:42,380 --> 00:06:44,670
!الرّشقات السّر-- مهلاً

118
00:06:45,290 --> 00:06:49,330
!ماذا يفعلان بالضّبط؟! افعل شيئاً

119
00:06:49,500 --> 00:06:51,710
ماذا تقصدين بـ"شيء"؟

120
00:06:52,170 --> 00:06:53,420
لقد ابتعدا بسرعة فحسب

121
00:06:56,460 --> 00:06:58,500
!حان وقت القضاء عليك

122
00:07:01,330 --> 00:07:03,080
أنا جائع

123
00:07:05,080 --> 00:07:06,580
!نفد الوقود؟

124
00:07:06,750 --> 00:07:08,410
!أنت! تمالك نفسك

125
00:07:08,580 --> 00:07:10,880
!أيّها التّافهون المُزعجون

126
00:07:14,290 --> 00:07:16,460
!نار الجنون

127
00:07:19,380 --> 00:07:20,380
!ولفرمون

128
00:07:32,080 --> 00:07:33,380
!هل أنتما بخير؟

129
00:07:34,290 --> 00:07:35,460
!ماهامون؟

130
00:07:40,710 --> 00:07:42,460
تروّي من فضلكِ

131
00:07:42,630 --> 00:07:44,620
!ماكوتشان، أين المالك؟

132
00:07:47,580 --> 00:07:49,710
فشل... العمل

133
00:07:54,170 --> 00:07:55,170
...أنتِ

134
00:07:56,250 --> 00:07:57,880
!هذا لا يُصدَّق

135
00:07:59,040 --> 00:08:03,410
،فقدتَ السّيطرة على ديجيمونك
،وتجاهلت مُحيطك

136
00:08:03,580 --> 00:08:06,290
...وفشلت في تجنُّب هجوم العدوّ

137
00:08:09,420 --> 00:08:10,460
!لا مُبرّر لديك

138
00:08:10,630 --> 00:08:12,330
قلتُ بأنّني آسف

139
00:08:12,500 --> 00:08:16,040
وهذا السّلوك! أيّ اعتذار هو هذا؟

140
00:08:16,210 --> 00:08:20,960
سبب عدم قدرة قتال غيكّومون
!بكامل قوّته هو أنت

141
00:08:21,500 --> 00:08:25,580
الإي-بولس الخاصّ بمالِك يفتقر
!للحافز ينفد بسرعة

142
00:08:26,210 --> 00:08:27,630
فهمت؟

143
00:08:33,960 --> 00:08:36,460
كان الإي-بولس في الأمس ضعيفاً

144
00:08:37,290 --> 00:08:39,250
!لستَ مُؤهّلاً لتكون مُنظِّفاً

145
00:08:39,790 --> 00:08:41,460
!عجيب أمرك

146
00:08:41,630 --> 00:08:45,540
تُسبّب خطراً لعائلتك وتفتعل المشاكل

147
00:08:45,750 --> 00:08:49,080
لو لم أنقذك، فلا أحد يعلم
!ما كان ليحدث

148
00:08:49,250 --> 00:08:50,710
لم أطلب منكِ ذلك

149
00:08:50,880 --> 00:08:52,910
!ماذا؟ ماذا قلت؟

150
00:08:53,080 --> 00:08:57,040
!نحن عائلة! من الطّبيعيّ أن نعين بعضنا

151
00:08:57,210 --> 00:08:59,960
!رينا! اهدئي رجاء

152
00:09:01,880 --> 00:09:04,330
ماذا؟ هل ستصمت من جديد؟

153
00:09:05,540 --> 00:09:07,540
!أنت لا تفهم إطلاقاً

154
00:09:08,210 --> 00:09:11,380
!إنّك لا تفكّر سوى بأخيك، أليس كذلك؟

155
00:09:11,750 --> 00:09:12,920
!هذا طبيعيّ

156
00:09:13,710 --> 00:09:15,960
!أنا هنا وذلك كي أتمكّن من إنقاذ أسوكا

157
00:09:16,580 --> 00:09:19,330
!لا أتذكّر بأنّني أصبحتُ صديقكم

158
00:09:22,710 --> 00:09:24,500
!تبّاً لتُرّهات العائلة هذه

159
00:09:24,960 --> 00:09:26,830
!تومورو

160
00:09:38,040 --> 00:09:39,710
شكراً لك يا كيو

161
00:09:41,630 --> 00:09:43,210
ثمرة الورد

162
00:09:43,380 --> 00:09:46,330
لديك طريقة غريبة في الاستمتاع بالشّاي

163
00:09:49,000 --> 00:09:50,670
كيف حال كاحلك؟

164
00:09:52,380 --> 00:09:54,250
لِمَ تكترث له؟

165
00:09:57,460 --> 00:10:00,040
...أعلم بأنّه أخو صديقك، لكن

166
00:10:00,790 --> 00:10:02,250
هذا ليس كلّ شيء

167
00:10:05,960 --> 00:10:08,580
لا يملك تومورو مكاناً يذهب إليه

168
00:10:09,790 --> 00:10:11,830
إنّه كما كنتِ في السّابق

169
00:10:13,710 --> 00:10:15,670
ذو طبع عنيد

170
00:10:28,210 --> 00:10:29,380
...ماكوتو

171
00:10:29,830 --> 00:10:35,630
قد تكون رينا فظّة، لكنّها تهتمّ بأصدقائها كثيراً

172
00:10:36,380 --> 00:10:38,830
أشعر بالاستياء بشأن الأمس أيضاً

173
00:10:39,380 --> 00:10:45,000
لكن لا أتحمّل فرضها مسألة "العائلة" تلك

174
00:10:46,210 --> 00:10:48,000
!نبضاتنا غير مُتوافقة

175
00:10:50,540 --> 00:10:53,410
،لا أعرف التّفاصيل فعليّاً

176
00:10:53,580 --> 00:10:56,290
لكن لم يكن لدى رينا عائلة

177
00:10:57,290 --> 00:11:00,620
بشخصيّتها، غالباً ما تُسبّب مشكلات

178
00:11:00,790 --> 00:11:04,500
كانت تنتقل من فريق مُنظِّف لآخر

179
00:11:05,250 --> 00:11:10,370
بالنّسبة لها، كان غلوينغ داون
بمثابة المنزل الّذي قبِلَها

180
00:11:10,540 --> 00:11:12,210
"أعضاؤه هم "عائلتها

181
00:11:12,380 --> 00:11:18,040
،تعتبرك فرداً جديداً في العائلة
لهذا السّبب أذت نفسها لإنقاذك

182
00:11:19,460 --> 00:11:20,580
...عائلة

183
00:11:29,750 --> 00:11:32,750
انظر يا تومورو. غروب الشّمس جميل

184
00:11:35,210 --> 00:11:36,750
هل ما زلت تبكي؟

185
00:11:37,250 --> 00:11:40,960
!لكن تعرّضتَ لإصابة أثناء إيقافي

186
00:11:41,170 --> 00:11:44,330
...لأنّني تسبّبتُ بخطأ آخر في سابوتاما

187
00:11:51,710 --> 00:11:56,250
تومورو، أنت أخي الصّغير العزيز

188
00:11:56,420 --> 00:11:59,080
مُساعدة العائلة أمر طبيعيّ، صحيح؟

189
00:12:02,380 --> 00:12:05,360
ستقلق أمّي، لذا امسح دموعك ولنذهب

190
00:12:05,530 --> 00:12:06,620
حسناً

191
00:12:06,790 --> 00:12:11,040
يمكننا القول بأنّ لوح السّباحة انكسر
بسبب سوء تصنيع بواسطة أبي

192
00:12:12,380 --> 00:12:14,580
هذا سيظلم أبي

193
00:12:23,210 --> 00:12:25,160
أنت! من أين حصلت على هذا؟

194
00:12:25,330 --> 00:12:26,790
!إنّه لذيذ

195
00:12:28,790 --> 00:12:31,880
غيكّومون وتومورو يحبّان أكله

196
00:12:33,170 --> 00:12:37,660
يُقال بأنّ الدّيجيمون هو مرآة عاكسة
لشخصيّة المالك

197
00:12:37,830 --> 00:12:39,290
مرآة عاكسة؟

198
00:12:39,460 --> 00:12:44,460
إنّ شخصيّة الدّيجيمون تتجسّد من خلال
الإي-بولس الخاصّ بمالكه

199
00:12:44,630 --> 00:12:47,080
!لستُ شرِهاً إلى هذا الحدّ

200
00:12:47,250 --> 00:12:49,750
لم تسرق هذا، أليس كذلك؟

201
00:12:49,920 --> 00:12:51,750
أعطتني إيّاه رينا

202
00:12:52,330 --> 00:12:58,790
،عندما كنتُ جائعاً ولم أستطع النّوم
أعطتني إيّاه سرّاً

203
00:12:58,960 --> 00:13:01,750
إنّه ليس سرّاً إن أخبرتنا

204
00:13:04,080 --> 00:13:05,750
هل ما زلتم تتكاسلون؟

205
00:13:05,920 --> 00:13:08,880
مرحباً. أتينا للتّعويض

206
00:13:10,960 --> 00:13:12,540
تماديتُ بعض الشّيء

207
00:13:13,960 --> 00:13:19,790
هذه غلطتي كقائدة لأنّني
لم أوجّهك بشكل صحيح

208
00:13:20,710 --> 00:13:23,080
في المرّة المُقبلة، سنُنجز الأمر

209
00:13:23,250 --> 00:13:24,460
إنّه نِزال انتقام

210
00:13:32,210 --> 00:13:35,290
جاهزان؟ خطّتنا هي نفسها
كما المرّة السّابقة

211
00:13:35,500 --> 00:13:40,050
هذه المرّة، سنُنسّق مع بعضنا لضرب
نقطة ضعف ماهامون وإيجاد مالكه

212
00:13:40,260 --> 00:13:41,290
مفهوم؟

213
00:13:41,460 --> 00:13:42,460
!أجل -
!حسناً -

214
00:13:44,880 --> 00:13:46,290
!إنّه هنا -
!تشيروبمون -

215
00:13:48,960 --> 00:13:51,460
!صدى شلّ الحركة

216
00:13:53,210 --> 00:13:54,790
!حسناً! غيكّومون

217
00:14:04,040 --> 00:14:05,250
!أنت ثانية

218
00:14:05,420 --> 00:14:07,330
!هذا أنا ثانية

219
00:14:08,580 --> 00:14:09,580
!ولفرمون

220
00:14:16,580 --> 00:14:18,250
!ضربة الغُرير الجارحة

221
00:14:20,960 --> 00:14:22,170
!لا بأس

222
00:14:23,500 --> 00:14:26,460
!ماذا تفعل؟ قُم بعملك

223
00:14:28,080 --> 00:14:29,080
!وجدتُه

224
00:14:31,630 --> 00:14:33,630
!صدى شلّ الحركة

225
00:14:35,710 --> 00:14:39,130
!أنت المالك إذاً! سلّم نفسك

226
00:14:41,130 --> 00:14:44,880
قلتُ لك قُم بعملك

227
00:14:52,170 --> 00:14:55,210
!حافّة السّرعة القصوى

228
00:15:01,960 --> 00:15:02,960
!رينا

229
00:15:03,130 --> 00:15:06,210
!لا يستطيع أحدٌ إيقافي

230
00:15:07,250 --> 00:15:08,500
!تبّاً

231
00:15:22,880 --> 00:15:25,000
أنت... لماذا...؟

232
00:15:27,080 --> 00:15:29,420
أردّ لك جميل البارحة فحسب

233
00:15:29,960 --> 00:15:32,830
"بالإضافة إلى أنّنا "نُعين بعضنا الآخر

234
00:15:33,670 --> 00:15:34,670
صحيح؟

235
00:15:36,710 --> 00:15:38,160
!لأنّنا عائلة

236
00:15:38,330 --> 00:15:39,500
!اصمت

237
00:15:42,250 --> 00:15:45,880
!اتبعوني! سأسحقكم جميعاً

238
00:15:48,460 --> 00:15:49,580
...هذا

239
00:15:49,750 --> 00:15:51,500
مزلق هروب طارئ

240
00:15:51,670 --> 00:15:53,670
ماذا الآن؟ قد يكون فخّاً

241
00:15:54,460 --> 00:15:56,670
!سنتبعه بالطّبع-
!بالطّبع-

242
00:15:57,080 --> 00:15:58,710
!استعدّوا جميعاً

243
00:15:58,880 --> 00:16:00,670
!عُلم

244
00:16:02,380 --> 00:16:04,860
!هذا مدخل عالم مرآة

245
00:16:05,030 --> 00:16:06,080
في هذا المكان؟

246
00:16:06,250 --> 00:16:07,290
!هيّا بنا

247
00:16:15,460 --> 00:16:17,710
هذا مُختلف عن المرّة الماضية

248
00:16:17,880 --> 00:16:21,830
تلك المُكعّبات العائمة كلّها
منصّات افتراضيّة

249
00:16:22,290 --> 00:16:26,750
استُدرجنا إلى منصّة تمنح ماهامون أفضليّة

250
00:16:30,130 --> 00:16:32,170
!نار الجنون

251
00:16:36,330 --> 00:16:37,830
!يجب علينا تفريقهما

252
00:16:42,540 --> 00:16:46,170
!حسناً! سأبعد المالك عن ماهامون

253
00:16:46,670 --> 00:16:47,900
!ماكوتشان، سانديني

254
00:16:48,070 --> 00:16:49,080
!عُلِم

255
00:16:49,250 --> 00:16:51,790
وأنت هاجم نقطة ضعفه

256
00:16:53,040 --> 00:16:54,040
!حسناً

257
00:16:55,000 --> 00:16:57,160
سنضربه عند المُنعطف الثّالث

258
00:16:57,330 --> 00:16:59,040
!أعتمد عليك يا تومورو

259
00:16:59,670 --> 00:17:01,420
!ولفرمون -
!حسناً -

260
00:17:04,040 --> 00:17:05,960
!هيّا بنا يا غيكّومون

261
00:17:07,170 --> 00:17:09,710
!نبضة تومورو تأتي في مكانها دوماً

262
00:17:11,210 --> 00:17:15,710
!هذا مُذهل! لا يستطيع أحدٌ إيقافي أبداً

263
00:17:15,880 --> 00:17:17,590
أعتقد حان الوقت لإيقافك

264
00:17:17,760 --> 00:17:18,790
ماذا؟

265
00:17:18,960 --> 00:17:20,580
!هذا غشّ

266
00:17:20,750 --> 00:17:23,290
!أنت! أسرع أكثر

267
00:17:23,460 --> 00:17:25,660
!إذاً أعطِني مزيداً من الإي-بولس

268
00:17:25,830 --> 00:17:26,830
!تبّاً

269
00:17:33,000 --> 00:17:34,500
!الآن يا ولفرمون

270
00:17:34,960 --> 00:17:36,750
!الرّشقات السّريعة

271
00:17:45,960 --> 00:17:47,580
!أمسكتُ بالمالك

272
00:17:52,380 --> 00:17:54,130
!لن يُصيبني هذا

273
00:17:55,040 --> 00:17:57,130
!صدى شلّ الحركة

274
00:17:58,630 --> 00:17:59,630
!الآن

275
00:18:02,830 --> 00:18:04,000
!اقذفه بعيداً

276
00:18:05,580 --> 00:18:08,380
!هيّا

277
00:18:22,500 --> 00:18:24,580
!تمّ العمل

278
00:18:25,380 --> 00:18:28,000
!أجل -
لم ينتهِ الأمر بعد -

279
00:18:28,830 --> 00:18:32,580
ابقوا يقظين حتّى نُسلّمهما للوزارة

280
00:18:32,750 --> 00:18:34,500
لا ترخوا دفاعكم

281
00:18:36,710 --> 00:18:38,210
أنت جدير بالإطراء

282
00:18:39,580 --> 00:18:40,830
ماذا؟

283
00:19:04,290 --> 00:19:06,460
يوشّي، يعتمد الأمر عليك الآن

284
00:19:06,630 --> 00:19:07,880
حسناً

285
00:19:09,500 --> 00:19:11,540
إلى اللّقاء

286
00:19:13,250 --> 00:19:15,130
انتهينا أيضاً

287
00:19:15,960 --> 00:19:17,750
سلّمنا المالك

288
00:19:18,710 --> 00:19:22,210
أحسنتم صنعاً. هل كشف شيئاً عن جريمته؟

289
00:19:23,580 --> 00:19:25,040
...يبدو

290
00:19:25,210 --> 00:19:30,750
تمّ استغلالي! قيل لي بأنّني سأتقاضى
!أجراً جيّداً لقاء الأعمال

291
00:19:39,290 --> 00:19:43,170
تلقّيتُ رسالة بُعيد خروج وحش
من السّابوتاما خاصّتي

292
00:19:43,500 --> 00:19:48,580
مفادها بأنّني سأتقاضى مبلغاً كبيراً مُقابل
صدم الشّاحنات وسرقة شبه النّاقلات

293
00:19:50,540 --> 00:19:54,080
طُلِب منه حرق الرّسالة بعد قراءتها

294
00:20:00,580 --> 00:20:03,290
هذا يشبه تلك العروض الجانبيّة
غير القانونيّة القديمة؟

295
00:20:03,460 --> 00:20:04,460
مُخيف

296
00:20:10,580 --> 00:20:12,080
!إنّه لحم

297
00:20:12,630 --> 00:20:15,960
.ظننتُ بأنّنا لم نتقاضَ الكثير
هل أنت متأكّد؟

298
00:20:16,130 --> 00:20:18,750
للاحتفال معاً بأوّل عمل ناجح لك

299
00:20:19,500 --> 00:20:20,620
لنبدأ بالأكل

300
00:20:20,790 --> 00:20:21,910
...حسناً إذاً

301
00:20:22,080 --> 00:20:24,330
!لنأكل

302
00:20:29,710 --> 00:20:31,040
!شهيّ

303
00:20:34,920 --> 00:20:36,250
!إنّه لذيذ

304
00:20:39,710 --> 00:20:42,170
!افتقدتُ لأكل اللّحم

305
00:20:43,750 --> 00:20:44,880
بُرتقاليّ

306
00:20:47,380 --> 00:20:48,960
أجل. إنّه لذيذ

307
00:20:51,000 --> 00:20:52,250
!شهيّ

308
00:20:52,630 --> 00:20:56,110
كان هذا بفضل هجوم تومورو
!وغيكّومون المُذهل

309
00:20:56,280 --> 00:20:57,370
ماذا؟

310
00:20:57,540 --> 00:21:00,460
لا. يعزو الفضل لقيادة رينا

311
00:21:02,210 --> 00:21:03,540
!بالطّبع

312
00:21:03,710 --> 00:21:07,880
!في غياب كيو، أنا قائدة غلودينغ داون

313
00:21:09,250 --> 00:21:11,160
وأنت لا بأس بك

314
00:21:11,330 --> 00:21:14,750
أدركتَ أخيراً بأنّك جزء من العائلة

315
00:21:16,420 --> 00:21:17,960
يمكنك الحصول على بعض
من لحمي أيضاً

316
00:21:18,420 --> 00:21:19,830
...لا داعي

317
00:21:20,000 --> 00:21:21,500
ولحمي أيضاً

318
00:21:21,670 --> 00:21:23,160
!قلتُ لا داعي

319
00:21:23,330 --> 00:21:27,040
!تومورو، كان الإي-بولس البارحة مُذهلاً

320
00:21:28,460 --> 00:21:29,460
تومورو

321
00:21:31,080 --> 00:21:32,960
واظب على العمل الدّؤوب

322
00:21:36,000 --> 00:21:39,500
أظنّني أستطيع أن أُبلي بشكل
أفضل في المرّة المُقبلة

323
00:21:46,130 --> 00:21:49,170
يحبّ تومورو الأكل حقّاً

324
00:21:49,670 --> 00:21:56,120
بالمناسبة يا كيو، تركتَنا نتولّى هذا العمل
كي نُعزّز التّضامن بيننا، صحيح؟

325
00:21:56,290 --> 00:21:57,960
ربّما -
!قلتُ توقّف -

326
00:21:58,170 --> 00:22:00,250
!دعني! هذه لي

327
00:22:07,170 --> 00:22:10,170
أحاول أن أكون قويّاً

328
00:22:10,460 --> 00:22:16,290
أُخفي كلّ نُدَبي

329
00:22:17,710 --> 00:22:20,790
أدرك الآن

330
00:22:20,960 --> 00:22:26,380
ما هو الّذي لا أستطيع التخلّي عنه

331
00:22:27,130 --> 00:22:34,030
،أحياناً أشعر بأنّني أريد الاستسلام فحسب
بأنّها هذه هي النّهاية

332
00:22:34,580 --> 00:22:36,160
هل يمكنك سماعه؟

333
00:22:36,330 --> 00:22:39,660
صدى نبضة الرّوح هذه

334
00:22:39,830 --> 00:22:43,580
حرارة عاطفة خفيّة

335
00:22:43,750 --> 00:22:44,910
نبضة خلفيّة في داخلك

336
00:22:45,080 --> 00:22:50,250
في أعماقك، قصّة تنسجها أنت

337
00:22:50,420 --> 00:22:53,160
لم تعُد وحدك

338
00:22:53,330 --> 00:22:55,370
سوية سوف نستحوذ على ذلك

339
00:22:55,540 --> 00:22:59,960
ادّخر نبضتك للمستقبل

340
00:23:04,380 --> 00:23:08,420
أنا متفاجئ بأنّ مكاناً بهذه الأجواء
لا يزال موجوداً

341
00:23:10,250 --> 00:23:12,460
يبدو هذا شهيّاً للغاية

342
00:23:12,630 --> 00:23:16,330
!أظلّ أقول لك ألّا تذهب بمفردك

343
00:23:17,540 --> 00:23:19,960
ما خطب هذا الباندا؟

344
00:23:21,170 --> 00:23:24,000
تومورو، إنّه ديجيمون، صحيح؟

345
00:23:24,920 --> 00:23:29,750
،الحلقة القادمة من ديجيمون بيتبريك
"نصف ونصف"