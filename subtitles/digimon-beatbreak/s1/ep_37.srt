...مُحال أن

203
00:13:31,980 --> 00:13:32,810
ميهارو

204
00:13:35,020 --> 00:13:37,150
أنا هو أنتِ

205
00:13:37,980 --> 00:13:40,900
...كُلّ ما فعلتُ هو سماع أُمنيتكِ

206
00:13:42,200 --> 00:13:43,870
!وتلبيتها

207
00:13:49,910 --> 00:13:50,910
!ميهارو

208
00:13:52,420 --> 00:13:53,620
!الرّئيس وُنغ

209
00:14:51,850 --> 00:14:53,020
ما هذا؟

210
00:14:53,180 --> 00:14:54,390
!إنّه ميفيسمون

211
00:14:54,850 --> 00:14:57,060
!لكنّه... ضخمٌ جدّاً

212
00:14:58,020 --> 00:15:02,650
!تومورو! أشتمّ رائحة ميهارو من داخله

213
00:15:05,400 --> 00:15:07,200
أتسمعون ذلك جميعاً؟

214
00:15:08,320 --> 00:15:09,200
!أجل

215
00:15:09,370 --> 00:15:10,330
...جوهريّاً

216
00:15:10,490 --> 00:15:12,790
علينا إسقاطه بسرعة، صحيح؟

217
00:15:14,040 --> 00:15:15,000
!أجل

218
00:15:15,620 --> 00:15:17,040
!ها أنا ذا

219
00:15:22,170 --> 00:15:23,800
...تسوينوزان

220
00:15:24,840 --> 00:15:25,970
!كوكو

221
00:15:28,890 --> 00:15:30,760
!عصفة اليأس

222
00:15:33,350 --> 00:15:35,480
!الهجمة الفتّاكة

223
00:15:40,690 --> 00:15:43,940
!انتظري يا ميهارو! نحن قادمون

224
00:15:52,490 --> 00:15:55,160
!مهلاً! هذا إسرافٌ في التّدمير

225
00:15:58,370 --> 00:15:59,420
!ميهارو

226
00:16:03,050 --> 00:16:05,130
!هذا يكفي

227
00:16:08,180 --> 00:16:10,220
!يبدو هذا سيّئاً

228
00:16:10,760 --> 00:16:12,560
!ميهارو

229
00:16:23,860 --> 00:16:26,240
!انتهى الأمر

230
00:16:34,540 --> 00:16:36,080
!...هذا

231
00:16:38,210 --> 00:16:39,710
!سوف ندخل

232
00:16:43,750 --> 00:16:47,300
!حدّ النّصل المُبيد

233
00:16:56,720 --> 00:16:58,480
ماذا حدث؟

234
00:16:58,640 --> 00:17:01,600
...تومورو وموناركليزامون

235
00:17:01,770 --> 00:17:07,360
!تومورو

236
00:17:09,030 --> 00:17:10,030
!تومورو

237
00:17:10,740 --> 00:17:12,240
موناركليزامون؟

238
00:17:12,410 --> 00:17:14,370
!تومورو، انظر

239
00:17:20,920 --> 00:17:22,580
...هذه الشّفرة

240
00:17:23,960 --> 00:17:25,000
ميهارو

241
00:17:29,840 --> 00:17:31,380
تشيـ... فويو؟

242
00:17:35,510 --> 00:17:37,470
الحُرّية للدّيجيمونات

243
00:17:38,470 --> 00:17:40,810
البرَكة للنّاس

244
00:17:43,350 --> 00:17:44,440
...و

245
00:17:45,230 --> 00:17:49,150
مُستقبل حيث يستطيعون العيش معاً يداً بيد

246
00:17:50,860 --> 00:17:55,200
ألن يكون من الرّائع أن تُعاد صياغة
العالم بهذه الطّريقة؟

247
00:17:57,410 --> 00:17:59,790
أهذه هي أُمنيتكِ؟

248
00:17:59,950 --> 00:18:01,830
عالمكِ الجديد"؟"

249
00:18:02,000 --> 00:18:02,920
!أجل

250
00:18:07,880 --> 00:18:09,010
...تشيفويو

251
00:18:25,270 --> 00:18:26,480
...كيف

252
00:18:27,610 --> 00:18:30,030
...كيف لي أن أنسى

253
00:18:30,740 --> 00:18:32,740
أمراً مُهمّاً جدّاً كهذا؟

254
00:18:33,570 --> 00:18:35,030
أنا آسفة يا تشيفويو

255
00:18:35,780 --> 00:18:37,700
أنا آسفة يا ميفيسمون

256
00:18:38,450 --> 00:18:39,740
...أنا آسفة

257
00:18:41,000 --> 00:18:42,250
جميعاً

258
00:18:43,250 --> 00:18:44,620
هذا بسبب الكراهية

259
00:18:44,790 --> 00:18:45,710
ماذا؟

260
00:18:46,420 --> 00:18:47,750
حدثَ لي ذلك أيضاً

261
00:18:48,500 --> 00:18:51,170
لكنّه المنهج الخاطئ

262
00:18:51,840 --> 00:18:54,090
علّمَتْني عائلتي ذلك

263
00:18:54,260 --> 00:18:55,430
ميهارو

264
00:18:55,840 --> 00:18:57,970
قلتِ بأنّنا مُتشابهون

265
00:18:58,640 --> 00:18:59,600
...إذاً

266
00:18:59,930 --> 00:19:01,890
يمكننا أن نكون عائلة أيضاً

267
00:19:02,060 --> 00:19:03,140
!ميهارو

268
00:19:03,310 --> 00:19:07,020
!أريدكِ أن تكوني جزءاً من عائلتنا

269
00:19:08,110 --> 00:19:11,530
ليتني التقيتُ بكم جميعاً قبلاً

270
00:19:11,690 --> 00:19:12,860
ماذا؟

271
00:19:13,030 --> 00:19:16,280
ابتعدتُ كثيراً بالفعل

272
00:19:17,950 --> 00:19:19,490
لا أستطيع العودة

273
00:19:19,950 --> 00:19:23,160
!ألا تريدين رؤية "عالمك الجديد"؟

274
00:19:26,000 --> 00:19:27,120
سوف نفعلها

275
00:19:27,790 --> 00:19:30,290
سوف نُريكِ العالم

276
00:19:30,880 --> 00:19:32,510
الّذي تمنّتْه أختكِ

277
00:19:32,670 --> 00:19:34,170
!نعدكِ بذلك

278
00:19:36,260 --> 00:19:37,390
أرجوكِ

279
00:19:38,090 --> 00:19:39,430
أوقفي ميفيسمون

280
00:19:40,720 --> 00:19:42,100
أوقفيه أرجوك

281
00:19:42,680 --> 00:19:43,680
!حسناً

282
00:19:48,730 --> 00:19:49,980
ميفيسمون

283
00:19:50,860 --> 00:19:52,110
أنا آسفة

284
00:19:52,900 --> 00:19:54,070
...اصمد

285
00:19:55,320 --> 00:19:56,650
فترة أطول قليلاً

286
00:19:59,950 --> 00:20:04,290
!الحُكم الأخير

287
00:20:25,220 --> 00:20:26,520
...أنا آسفة

288
00:20:27,230 --> 00:20:28,350
يا ميفيسمون

289
00:20:43,780 --> 00:20:48,960
وفقاً للاتِّحاد العالميّ، استُرجِعت كافّة النُّظُم

290
00:20:49,120 --> 00:20:51,080
،بالنّسبة لبثّ الرّئيس وُنغ

291
00:20:51,250 --> 00:20:55,090
وردتنا تقارير بأنّه إعلان عن نِظام
تشغيل سابوتاما جديد

292
00:20:55,250 --> 00:20:57,340
--بسبب خلل في النّظام، اضطرّوا لـ

293
00:21:00,300 --> 00:21:03,260
ميهارو، لا تذهبي

294
00:21:12,650 --> 00:21:14,150
هل ستذهبين حقّاً؟

295
00:21:16,940 --> 00:21:19,030
الحُرّية للدّيجيمونات

296
00:21:19,610 --> 00:21:21,490
البرَكة للجميع

297
00:21:22,110 --> 00:21:23,070
...و

298
00:21:24,200 --> 00:21:27,450
مُستقبل حيث يستطيع الجميع
أن يعيشوا يداً بيد

299
00:21:34,920 --> 00:21:36,550
عالمكِ الجديد

300
00:21:37,210 --> 00:21:38,800
أتطلّع قُدماً له

301
00:21:39,470 --> 00:21:40,260
أجل

302
00:21:40,420 --> 00:21:41,470
!أجل

303
00:22:01,200 --> 00:22:07,370
اتّخذتُ قراري
سأعيش حياتي على طريقتي

304
00:22:07,870 --> 00:22:14,630
يبدو كُلّ شيء على ما يُرام
سأجعل الغد هو الأفضل

305
00:22:14,790 --> 00:22:16,790
تعلم بأنّني لا أستطيع تصنُّع ذلك

306
00:22:16,960 --> 00:22:18,750
لا أستطيع التحكُّم بهذه الطّاقة

307
00:22:18,920 --> 00:22:22,220
أنا لا أنسجم، لكنّني على قيد الحياة

308
00:22:22,380 --> 00:22:28,850
سأحوّل كُلّ نُدبة إلى لحن
لذا ها هو ذا

309
00:22:29,100 --> 00:22:34,560
سأحطّم ما هو واضح، بهذا الصّوت

310
00:22:34,730 --> 00:22:36,650
سأحطّمه الآن، سأحطّمه الآن أجل

311
00:22:36,810 --> 00:22:41,070
وفق الإيقاع الّذي في أعماق قلبي

312
00:22:41,240 --> 00:22:43,240
سأُعيد صياغة حياتي

313
00:22:43,400 --> 00:22:45,990
أريد أن أؤمن فحسب لأنّني
أعلم بأنّ هذا هو المفتاح

314
00:22:46,160 --> 00:22:48,450
فليسمعه العالم كُلّه

315
00:22:48,620 --> 00:22:51,040
هذه هي حقيقتي، أريد فقط
"أن أكون "أنا

316
00:22:51,200 --> 00:22:52,580
وأريد أن أكون حُرّة

317
00:22:52,750 --> 00:22:55,370
سأحطّمه الآن، سأُحطّمه الآن

318
00:22:55,540 --> 00:22:57,170
وأجد نفسي

319
00:23:03,590 --> 00:23:06,140
!كيو! تعال واجلس

320
00:23:06,300 --> 00:23:09,640
أعددنا الكعكة والطّعام بأنفسنا

321
00:23:09,810 --> 00:23:11,470
عملَ الجميع بجدّ

322
00:23:11,640 --> 00:23:13,980
!حسناً، فلنبدأ الحفلة

323
00:23:14,140 --> 00:23:16,350
!سأُشعل الشّموع

324
00:23:16,520 --> 00:23:19,060
!توقّفوا، هذا خطير

325
00:23:19,230 --> 00:23:22,740
الأجواء دافئة دوماً هنا، أليس
كذلك يا كيو؟

326
00:23:22,900 --> 00:23:23,740
أجل

327
00:23:24,740 --> 00:23:30,530
،الحلقة القادمة من ديجيمون بيتبريك
"عطش أجوف"