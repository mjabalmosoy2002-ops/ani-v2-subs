1
00:00:12,880 --> 00:00:17,010
في المستقبل القريب، يتمّ توليد إي-بولس
،بواسطة أفكار البشر ومشاعرهم

2
00:00:17,180 --> 00:00:20,810
واستخدام مصدر طاقة لأجهزة الذّكاء
الاصطناعيّ الّتي تُسمّى سابوتاما

3
00:00:20,970 --> 00:00:23,520
ما يؤدّي إلى تطوُّر جديد للبشريّة

4
00:00:24,600 --> 00:00:27,810
لكن انبثقتْ وحوشٌ مُرعبة من ظُلُمات هذه الظّاهرة

5
00:00:28,570 --> 00:00:31,150
وحوش تتطوّر بالتهامِ إي-بولس

6
00:00:31,610 --> 00:00:33,030
...إنّهم

7
00:00:33,450 --> 00:00:35,740
أشعر بنبضة مجنونة مدويّة

8
00:00:35,910 --> 00:00:38,660
حيث لا يمكن لأحد إيقافي بعدها

9
00:00:38,830 --> 00:00:42,700
سأشقّ طريقي إلى هناك بينما أبحث عن الإجابة

10
00:00:42,870 --> 00:00:44,920
انحت عاطفتك

11
00:00:46,210 --> 00:00:48,000
يتردّد صداه

12
00:00:48,170 --> 00:00:51,210
الإيقاع الّذي يتزامن

13
00:00:51,380 --> 00:00:55,630
هو نبضة تكشف رويداً عن العالم الخفيّ

14
00:00:55,800 --> 00:00:58,510
سجّل على قمّة خطّ الأساس الصّلب

15
00:00:58,680 --> 00:00:59,720
لا تعبث بالإيقاع

16
00:00:59,890 --> 00:01:01,430
العاديّ لا يكفي بالنّسبة لي

17
00:01:01,600 --> 00:01:04,770
!!!استمرّ في الصّراخ، صراخ
اصرخ كما لو أنّ هذا كلّ ما تملك

18
00:01:06,520 --> 00:01:11,730
حتّى لو بدأ ما تؤمن به يتشوّش

19
00:01:11,900 --> 00:01:14,490
الحقيقة الّتي تستحوذ عليها صامدة وحقيقيّة

20
00:01:14,650 --> 00:01:16,990
أَزِل ضابط الإيقاع وترجّل فحسب

21
00:01:17,160 --> 00:01:19,160
أشعر بنبضة مجنونة مدويّة

22
00:01:19,320 --> 00:01:21,870
النّبضة العاطفيّة الّتي تصدح

23
00:01:22,040 --> 00:01:25,620
هي مُعدّل الضّربات في الدّقيقة الّذي يستمرّ بلا توقُّف

24
00:01:25,790 --> 00:01:27,710
(لندع الإيقاع يقودنا)

25
00:01:27,870 --> 00:01:29,920
أمطار الغيم تبتلع المدينة

26
00:01:30,090 --> 00:01:33,670
حتّى لو تشوّه الإيقاع سأجعل ذلك جزءاً من روتيني

27
00:01:33,840 --> 00:01:36,260
اركبه كما ترى مُناسباً

28
00:01:36,430 --> 00:01:38,180
(لندع الإيقاع يقودنا)

29
00:01:38,340 --> 00:01:40,760
حتّى لو آلمني ذلك، لن أتوقّف

30
00:01:40,930 --> 00:01:43,600
استمرّ في نحت النّبضة
لا تتراجع أبداً

31
00:01:43,770 --> 00:01:47,310
يمكننا التغلّب على أيّ شيء

32
00:01:47,480 --> 00:01:49,270
اقرع بناء على عاطفتك

33
00:01:58,360 --> 00:02:00,280
مـ-من أنتم جميعاً؟

34
00:02:01,450 --> 00:02:03,370
!تلقّ حُكم ديجيمون-ساما

35
00:02:09,210 --> 00:02:11,630
أنت هينو، سمسار المعلومات

36
00:02:12,380 --> 00:02:13,590
ديجيمون؟

37
00:02:22,510 --> 00:02:26,600
!فوما نينجوتسو، تسوباكورو

38
00:02:31,730 --> 00:02:34,980
أنت الشّخص الّذي يقضي
!على سماسِرة المعلومات

39
00:02:35,150 --> 00:02:36,690
ماذا تريد؟

40
00:02:37,320 --> 00:02:39,150
الأسباب لا تعنيني

41
00:02:39,320 --> 00:02:42,490
أنا أنفّذ طلباً فحسب

42
00:02:53,090 --> 00:02:58,840
يُبلغ أعضاؤنا بأنّ الحُكم قد
أُنزِلَ على السّمسار الخامس

43
00:02:59,420 --> 00:03:01,800
تمّ تحديد السّادس

44
00:03:03,300 --> 00:03:06,850
أرشِد الأعضاء إلى هِداية ديجيمون-ساما

45
00:03:08,390 --> 00:03:10,060
...التّالي الّذي سيُحكَم عليه

46
00:03:10,230 --> 00:03:11,900
هو ماكي كاتسوادا

47
00:03:12,650 --> 00:03:14,610
،الحُرّيّة للدّيجيمون

48
00:03:15,360 --> 00:03:17,440
البرَكة للنّاس

49
00:03:58,900 --> 00:04:00,030
ديجيمون؟

50
00:04:00,900 --> 00:04:02,280
ألم تجدوا بانجيامون بعد؟

51
00:04:02,780 --> 00:04:04,570
!جِدوه واحذفوه

52
00:04:33,310 --> 00:04:34,350
هل كنتُ مُزعجة؟

53
00:04:35,060 --> 00:04:36,150
لا

54
00:04:38,770 --> 00:04:41,690
هل كنت أنتِ من شاركني الإي-بولس؟

55
00:04:42,690 --> 00:04:44,280
شعرتُ برغبة في ذلك فحسب

56
00:04:44,650 --> 00:04:47,990
...بما أنّ مظهري لم يُخفكِ

57
00:04:50,620 --> 00:04:53,870
كان لديّ ديجيمون يخصّني

58
00:04:55,870 --> 00:05:00,380
فعلنا كلّ ما بوسعنا للنّجاة

59
00:05:00,550 --> 00:05:03,170
لكن أصبحوا يُحذَفون بسهولة بالغة مؤخّراً

60
00:05:05,130 --> 00:05:09,510
لا أريد أن أتورّط مع ديجيمون
وتتلطّخ يدايّ ثانية

61
00:05:14,640 --> 00:05:16,600
لم تكن نيّتي توريطكِ

62
00:05:17,440 --> 00:05:18,440
سأذهب

63
00:05:26,660 --> 00:05:31,540
مسحتُ كثيراً من الدّيجيمونات بيدي هاتين

64
00:05:33,250 --> 00:05:37,420
لم نستطع تجاهل أولئك الّذين كانوا يُعانون

65
00:05:38,290 --> 00:05:42,170
لذا قاتلنا ضدّ أولئك الّذين يفعلون الشّرّ

66
00:05:43,340 --> 00:05:45,550
فعل "الخير" هكذا قد يضعك

67
00:05:45,720 --> 00:05:48,390
تحت نيران المجموعات الّتي تستخدم الدّيجيمون

68
00:05:50,100 --> 00:05:54,850
!استأجروا مُغتالاً، وقتلوا شريكي

69
00:06:02,860 --> 00:06:05,030
ما هذه الرّائحة؟

70
00:06:05,940 --> 00:06:06,990
قهوة؟

71
00:06:07,150 --> 00:06:10,570
أُفضّل الشّاي، لكن حتّى أنا أستطيع
التّمييز بأنّها رائحة زكيّة

72
00:06:10,740 --> 00:06:13,790
نادراً ما تُقدّمين قهوة هنا

73
00:06:15,000 --> 00:06:17,080
الأيّام الماطرة تُعيدنا للذّكريات

74
00:06:17,250 --> 00:06:22,340
أتذكّر بأنّهم كانوا يُحبّون رائحة القهوة

75
00:06:22,500 --> 00:06:24,630
الحديث عن حبيب سابق رُبّما؟

76
00:06:26,550 --> 00:06:28,550
!هذا مُرّ للغاية

77
00:06:28,720 --> 00:06:30,260
!لا تلعقها فحسب

78
00:06:32,600 --> 00:06:33,970
هذه رسالة طارئة

79
00:06:34,930 --> 00:06:39,980
عُثِر على سمسار معلومات خامس
مُصاب بكولد هارت

80
00:06:40,480 --> 00:06:43,060
تعرفينه. إنّه هينو

81
00:06:43,570 --> 00:06:45,400
كلّ هذا جديد بالنّسبة لنا

82
00:06:45,570 --> 00:06:47,860
السّابوتاما الخاصّة بهينو حصلتْ
على دليل مُسجَّل بالفيديو

83
00:06:52,120 --> 00:06:53,030
ما هذا؟

84
00:06:53,200 --> 00:06:54,410
لا يمكن التّحديد

85
00:06:54,580 --> 00:06:57,410
لا يزال مجهولاً، لكن هناك مُكافأة

86
00:06:58,040 --> 00:06:59,790
قدرها 2.2 مليون نقطة

87
00:06:59,960 --> 00:07:01,170
!يا للهول

88
00:07:01,330 --> 00:07:05,500
قد تُستهدَفون كذلك. ابقوا حذرين

89
00:07:05,670 --> 00:07:09,670
كيف لك أن تكون حذراً ضدّ خصم مجهول؟

90
00:07:11,800 --> 00:07:14,140
اقبضوا على الدّيجيمون الّذي في الفيديو

91
00:07:14,300 --> 00:07:16,060
هذه سلفة إضافيّة

92
00:07:16,640 --> 00:07:18,430
ما الّذي يجري يا ماكي؟

93
00:07:18,600 --> 00:07:20,440
...ذلك الدّيجيمون

94
00:07:21,020 --> 00:07:22,060
هو فومامون

95
00:07:22,810 --> 00:07:26,980
فومامون. ديجيمون نهائيّ. مُستخدم
فوما نينجوتسو

96
00:07:27,150 --> 00:07:30,360
إنّهم أحد أفضل القتَلة هناك

97
00:07:30,900 --> 00:07:33,110
أحضروه لي

98
00:07:33,280 --> 00:07:36,700
ماكي، تعرفين فومامون هذا، أليس كذلك؟

99
00:07:36,870 --> 00:07:41,830
تعاونتُ ذات مرّة مع ديجيمون يُدعى
بانجيامون لفترة قصيرة

100
00:07:42,420 --> 00:07:44,880
هل كان شريككِ المُنظِّف؟

101
00:07:46,000 --> 00:07:50,010
آنذاك، لم يكن نِظام التّنظيف موجوداً بعد

102
00:07:50,170 --> 00:07:54,220
سعى للانتقام من الشّخص
الّذي قتلَ مالكَه

103
00:07:56,010 --> 00:07:57,260
انتقام

104
00:07:58,100 --> 00:08:00,140
هذا كلّ ما بقي لديّ الآن

105
00:08:00,310 --> 00:08:03,900
وحالما تنتقم، ماذا بعد؟

106
00:08:04,060 --> 00:08:07,900
...حالما أحذف المغتال فومامون

107
00:08:08,320 --> 00:08:12,030
سأتوقّف عن استهلاك إي-بولس وأتلاشى

108
00:08:14,110 --> 00:08:15,450
...إلى ذلك الحين

109
00:08:26,630 --> 00:08:28,340
حسناً إذاً

110
00:08:32,340 --> 00:08:34,880
يمكننا أن نكون شريكين مُؤقّتين حاليّاً

111
00:08:39,430 --> 00:08:43,440
ماتوا وبقي فومامون على قيد الحياة

112
00:08:43,940 --> 00:08:47,440
هدف انتقام بانجيامون الّذي لم يكتمل

113
00:08:47,610 --> 00:08:49,770
ماذا ستفعلين عندما نُمسك به؟

114
00:08:52,820 --> 00:08:55,780
غالباً سوف أُصارحه بما يجول في خاطري

115
00:08:58,660 --> 00:09:00,410
!أحدهم يُراقب

116
00:09:02,620 --> 00:09:04,910
!أنتما! التجسُّس هكذا جريمة

117
00:09:05,080 --> 00:09:06,210
!ماكي كاتسوادا

118
00:09:06,370 --> 00:09:08,170
!سمسارة معلومات، ماكي كاتسوادا

119
00:09:08,330 --> 00:09:09,130
!عثرنا عليكِ

120
00:09:09,290 --> 00:09:13,470
!ماكي كاتسوادا! ستُواجهين عقوبة غيفت

121
00:09:13,630 --> 00:09:14,630
غيفت"؟"

122
00:09:19,850 --> 00:09:20,930
!ماكي

123
00:09:21,100 --> 00:09:21,970
!توقّفي

124
00:09:23,060 --> 00:09:25,690
!دعوا الأمر لي! اذهبوا

125
00:09:25,850 --> 00:09:27,230
!شكراً يا يوشّي

126
00:09:30,980 --> 00:09:32,900
!ماكي كاتسوادا، تمّ التّحديد

127
00:09:33,070 --> 00:09:35,110
!اتّصلوا بفومامون-ساما

128
00:09:36,990 --> 00:09:40,410
!إنّهم ينقلون حركات ماكي إلى فومامون

129
00:09:40,580 --> 00:09:42,160
من أولئك النّاس؟

130
00:09:47,420 --> 00:09:50,340
المهمّة التّالية، قُبِلَتْ

131
00:09:51,750 --> 00:09:54,630
!اتّصلوا بكيو! سألعب دور الطّعم

132
00:09:58,890 --> 00:10:01,220
أنتِ ماكي كاتسوادا

133
00:10:01,390 --> 00:10:03,060
ولديكِ مُنظِّفون

134
00:10:07,060 --> 00:10:08,100
!فومامون

135
00:10:08,850 --> 00:10:09,850
...هل

136
00:10:10,560 --> 00:10:11,770
تتذكّرني؟

137
00:10:24,950 --> 00:10:26,370
!مُحاولة مُوفَّقة

138
00:10:28,500 --> 00:10:29,460
هل الجميع بخير؟

139
00:10:29,620 --> 00:10:31,170
!تشبّثوا جيّداً

140
00:10:39,180 --> 00:10:43,010
إنّها نهاية مسدودة. حُذِفَ كلّ شيء
يتعلّق بفومامون

141
00:10:49,020 --> 00:10:53,270
بانجيامون، هناك مُذكّرة إعدام على رأسك

142
00:10:55,360 --> 00:10:58,490
!هيوجوكين

143
00:11:06,160 --> 00:11:09,410
!هيوغامون، جمّده بلكمة الثّلج خاصّتك

144
00:11:11,580 --> 00:11:13,080
!افعلها! اقضِ عليه

145
00:11:14,170 --> 00:11:16,340
ماذا تفعلين بالضّبط؟

146
00:11:16,500 --> 00:11:20,340
تراجع بينما لا أزال أشعر
برغبة في إطلاق سراحك

147
00:11:22,640 --> 00:11:24,100
!أفلتيني

148
00:11:29,350 --> 00:11:30,390
هل أنتِ بخير؟

149
00:11:30,560 --> 00:11:32,020
أنا بخير

150
00:11:33,230 --> 00:11:36,110
كم أكره هذا العالم

151
00:11:47,200 --> 00:11:48,950
لماذا جازفتِ مثل هذه المُجازفة؟

152
00:11:53,210 --> 00:11:59,710
أنت لا تُريد قتال أو حذف ديجيمون، أليس كذلك؟

153
00:12:02,880 --> 00:12:06,050
لم أقصد توريطك في معركتي

154
00:12:06,220 --> 00:12:07,390
أنا آسف

155
00:12:15,860 --> 00:12:17,480
رائحة عطِرة

156
00:12:19,030 --> 00:12:20,110
أتريد أن تُجرّبها؟

157
00:12:28,620 --> 00:12:30,410
ليست مُخصّصة للدّيجيمون على ما أعتقد

158
00:12:34,420 --> 00:12:37,170
لكن الرّائحة مُهدِّئة

159
00:12:37,790 --> 00:12:41,380
تبدو كافّة أيّامي في القتال حلماً بعيداً

160
00:12:41,840 --> 00:12:46,090
حقّاً؟ إذاً رُبّما سأفتتح مقهى

161
00:12:46,260 --> 00:12:49,390
مقهى حيث يستطيع الدّيجيمون
والبشر الاسترخاء

162
00:12:50,060 --> 00:12:51,350
ألا يبدو هذا لطيفاً؟

163
00:12:53,230 --> 00:12:58,110
كلّاً من الدّيجيمونات والبشر سيتمكّنون
من الضّحك في مكانٍ كهذا

164
00:12:58,900 --> 00:13:00,110
إنّه حُلم جيّد

165
00:13:01,230 --> 00:13:04,490
لكن لن أتمكّن أبداً من زيارة ذلك المقهى

166
00:13:17,420 --> 00:13:18,580
!صدى شلّ الحركة

167
00:13:18,750 --> 00:13:19,790
!طلقة بري

168
00:13:22,710 --> 00:13:24,260
!إيغامون وكوغامون

169
00:13:24,420 --> 00:13:25,930
لَعِبَ دور الطّعم؟

170
00:13:26,090 --> 00:13:27,470
أين فومامون الحقيقيّ؟

171
00:13:32,310 --> 00:13:34,100
!ماكي كاتسوادا-
!وجدتُك-

172
00:13:34,270 --> 00:13:36,560
هل هُما جزء من غيفت أيضاً؟

173
00:13:39,440 --> 00:13:40,690
!توقّفي

174
00:13:43,280 --> 00:13:45,320
!أرجوك يا ديجيمون-ساما

175
00:13:45,860 --> 00:13:48,280
!أنزل حُكم غيفت على هؤلاء الخوَنة

176
00:13:48,450 --> 00:13:49,870
ديجيمون-ساما"؟"

177
00:13:50,030 --> 00:13:51,990
ماذا يقولون؟

178
00:13:58,330 --> 00:13:59,710
مُنظِّف"؟"

179
00:13:59,880 --> 00:14:05,840
مع انتشار السّابوتاما، للتّعامل
،مع مُشكلة الدّيجيمون التّالية

180
00:14:06,260 --> 00:14:10,220
سوف تتبنّى وزارة حماية المدنيّين
زمام الأمور بالكامل

181
00:14:10,390 --> 00:14:12,890
قرّرت الحكومةُ هذا بشكلٍ سرّيّ

182
00:14:13,890 --> 00:14:17,980
،بعد أن استخدمونا لفترة طويلة
!يا لأنانيّتهم

183
00:14:18,140 --> 00:14:23,230
نعلم بأنّكِ كنتِ تعيشين مع ديجيمون
في الجانب السّفليّ من المُجتمع

184
00:14:23,400 --> 00:14:27,490
إذا أردتِ أن تبقيا معاً، فأمامكِ خياران

185
00:14:27,900 --> 00:14:30,370
،كوني مُنظِّفة واصطادي الدّيجيمونات

186
00:14:30,530 --> 00:14:34,580
أو كوني هدف مُكافأة ليتمّ اصطيادك
بواسطة مُنظِّفين

187
00:14:35,450 --> 00:14:36,750
الخيار لكِ

188
00:14:40,000 --> 00:14:41,710
...إذا أصبحنا مُنظّفين

189
00:14:43,500 --> 00:14:44,550
...يمكننا

190
00:14:46,460 --> 00:14:48,880
نحن شريكان مُؤقّتان فقط

191
00:14:49,050 --> 00:14:51,180
لن نُصبح مُنظّفين

192
00:14:55,140 --> 00:14:56,430
...فهمت

193
00:15:03,980 --> 00:15:06,400
!أعلم بأنّك هنا يا فومامون

194
00:15:11,990 --> 00:15:14,410
...تنتظر حتّى أصبح معزولة

195
00:15:14,780 --> 00:15:17,160
قبل أن تُهاجمني كجبان

196
00:15:17,330 --> 00:15:20,750
!لهذا تظاهرتُ بالمجيء إلى هنا بمُفردي

197
00:15:20,920 --> 00:15:22,960
هل تعرفينني؟

198
00:15:23,500 --> 00:15:25,630
هنا حدث الأمر

199
00:15:25,800 --> 00:15:28,710
حاصرناك هنا

200
00:15:29,630 --> 00:15:31,430
!هيوجوكين

201
00:15:35,100 --> 00:15:37,600
!فوما شاريهوتسو

202
00:15:40,430 --> 00:15:44,150
يمين؟ لا، يسار؟ هل يمكنك أن تتوقّع
من أين سأُهاجمك؟

203
00:15:54,990 --> 00:15:55,950
!ماكي

204
00:15:59,750 --> 00:16:03,500
!إنّها غير معنيّة! لا تلمسها

205
00:16:03,670 --> 00:16:04,580
!بانجيامون

206
00:16:04,750 --> 00:16:07,960
،ماذا؟ إن لم تكن معنيّة

207
00:16:08,130 --> 00:16:11,470
!فلماذا أنت مُستميت على حمايتها؟

208
00:16:15,680 --> 00:16:20,180
ورقتي الرّابحة هي نصلي الثّالث

209
00:16:26,730 --> 00:16:27,770
!بانجيامون

210
00:16:28,730 --> 00:16:30,900
تمّت المهمّة

211
00:16:35,030 --> 00:16:37,450
لماذا؟ ما السّبب...؟

212
00:16:39,370 --> 00:16:41,080
...إذا أصبحنا مُنظّفين

213
00:16:42,330 --> 00:16:45,920
...لكان بمقدورنا البقاء معاً غالباً

214
00:16:47,080 --> 00:16:47,920
للأبد

215
00:16:48,960 --> 00:16:51,840
إذاً لماذا رفضت ذلك؟

216
00:16:57,140 --> 00:17:01,390
لم أُرِدكِ أن تُلطّخي يديكِ بعد الآن

217
00:17:02,350 --> 00:17:03,770
...يداكِ

218
00:17:04,480 --> 00:17:07,730
خُصّصتا لصنع قهوة لذيذة

219
00:17:12,940 --> 00:17:15,240
!لا! لا ترحل

220
00:17:16,280 --> 00:17:17,320
...أنا

221
00:17:18,240 --> 00:17:19,410
...أردتُ

222
00:17:37,760 --> 00:17:40,220
أنت من استُدرِج إلى هنا

223
00:17:53,070 --> 00:17:54,990
تذكّرتُكِ

224
00:17:55,150 --> 00:17:59,620
كان بانجيامون الشّخص الّذي أهانَني

225
00:17:59,780 --> 00:18:02,200
أنتِ المرأة الّتي كانت تحميه

226
00:18:06,960 --> 00:18:09,880
فومامون، ما هو غيفت؟

227
00:18:10,040 --> 00:18:12,920
لماذا يستهدفون السّماسرة؟
لِمَ يستهدفون ماكي؟

228
00:18:13,090 --> 00:18:18,260
مهمّتي هي قبول المُكافآت وإصابة
الأهداف بكولد هارت. هذا كلُّ شيء

229
00:18:18,430 --> 00:18:19,550
...أيُّها الوغد

230
00:18:20,640 --> 00:18:22,930
سيفاه مُجرّد خدعة فقط

231
00:18:23,100 --> 00:18:25,060
السّيف الثّالث من الأعلى
هو الخطر الحقيقيّ

232
00:18:25,220 --> 00:18:26,140
...لكن

233
00:18:43,740 --> 00:18:46,000
!فوما شاريهوتسو

234
00:18:46,160 --> 00:18:48,750
!جيونوزان تسوكيشيغوري

235
00:19:00,630 --> 00:19:02,350
!الهجمة الثّالثة من الأعلى

236
00:19:02,850 --> 00:19:04,390
أخبرَتْك

237
00:19:04,560 --> 00:19:08,640
أردتَ تجنُّب الاثنين الأوّلين والردّ
على الهجمة الثّالثة

238
00:19:08,810 --> 00:19:09,730
!...لكن

239
00:19:11,100 --> 00:19:14,320
!ظننتَ بأنّها ستأتيك من الأعلى؟
!أيُّها الأحمق

240
00:19:16,400 --> 00:19:19,200
أخبرَتْني ماكي بهجمتك لهدف

241
00:19:19,900 --> 00:19:23,990
بمعرفتي لطبيعتك الجبانة، أعلم
بأنّك سوف تتذاكى علينا

242
00:19:24,160 --> 00:19:27,330
!لكن كان موراساميمون أذكى منك

243
00:19:28,540 --> 00:19:30,500
!موراشيغوري

244
00:19:42,470 --> 00:19:43,390
ماكي؟

245
00:19:51,940 --> 00:19:52,850
ماكي

246
00:19:53,690 --> 00:19:55,150
...لا أعرف السّبب

247
00:19:55,610 --> 00:19:56,440
...لكن

248
00:19:57,190 --> 00:19:59,150
لم يسعني سوى إيقافك

249
00:20:00,990 --> 00:20:01,820
لا تفعلي

250
00:20:03,660 --> 00:20:05,780
نجم خُماسي سابق؟

251
00:20:06,870 --> 00:20:09,540
لماذا اعتزلت؟

252
00:20:09,700 --> 00:20:14,960
يقول بأنّه يريد أن يتعايش الدّيجيمونات
!والبشر معاً

253
00:20:15,500 --> 00:20:18,340
فكرة مجنونة جدّاً، أليس كذلك؟

254
00:20:20,420 --> 00:20:22,380
أهي مجنونة إلى هذا الحدّ؟

255
00:20:26,140 --> 00:20:31,850
كلّاً من الدّيجيمون والبشر سيتمكّنون
من الضّحك في مكانٍ كهذا

256
00:20:53,960 --> 00:20:55,080
تومورو

257
00:20:55,500 --> 00:20:57,080
كنتُ مُحقّة بشأنك

258
00:20:57,670 --> 00:20:59,500
أنت تنتمي لهذا الطّرف

259
00:21:00,960 --> 00:21:04,090
أين كنت يا ميهارو-ساما؟

260
00:21:04,630 --> 00:21:07,550
سيأتي تومورو إلى هنا في نهاية المطاف

261
00:21:08,260 --> 00:21:10,770
أليس كذلك يا ميفيسمون؟

262
00:21:17,860 --> 00:21:21,320
الدّيجيمونات والبشر معاً؟

263
00:21:24,700 --> 00:21:30,240
هل من المُناسب أن أراقب حلمهم
لفترة أطول قليلاً؟

264
00:21:39,170 --> 00:21:41,000
!يا لها من رائحة عطِرة

265
00:21:41,170 --> 00:21:43,510
إنّها لا تُمطر، لكن أعددتِ قهوة؟

266
00:21:43,670 --> 00:21:44,670
!أريد فُنجاناً

267
00:21:44,840 --> 00:21:46,430
!أنا أيضاً! مع حليب

268
00:21:46,590 --> 00:21:47,720
!أنا أيضاً

269
00:21:47,890 --> 00:21:50,180
كلاهما لا يتحمّلان المرارة

270
00:21:51,220 --> 00:21:53,390
هل كان يوجد شخص آخر هنا؟

271
00:21:56,640 --> 00:21:57,770
...لا

272
00:22:00,900 --> 00:22:06,200
العين بالعين

273
00:22:06,360 --> 00:22:09,740
مُعجزة ميرا-ميرا

274
00:22:12,580 --> 00:22:14,950
عطست أيضاً

275
00:22:15,120 --> 00:22:17,960
ضحِكنا بنفس التّعابير

276
00:22:18,120 --> 00:22:23,920
ما تُفكِّر فيه
عِدنا بأن تخبرني بكلّ شيء

277
00:22:24,090 --> 00:22:29,300
نحن كمرآتين مُتقابلتين
سيكون هناك المزيد من البسمات

278
00:22:29,970 --> 00:22:32,050
"معاً... للأبد"

279
00:22:32,390 --> 00:22:35,270
مئات التّحديثات

280
00:22:35,430 --> 00:22:37,730
العين بالعين

281
00:22:37,890 --> 00:22:41,060
مرآة ميرا-ميرا
مُعجزات مُتضاعِفة

282
00:22:41,230 --> 00:22:46,570
أدخل في ورطة حقيقيّة
لكن مع ذلك أحبّ أن أتطوّر

283
00:22:46,740 --> 00:22:52,370
لنستمتع حتّى بفشلنا
أفضّل أن أكون واقعيّاً على أن أكون مثاليّاً

284
00:22:52,530 --> 00:22:55,160
استجمع نورك

285
00:22:55,330 --> 00:22:58,370
!المعي يا مرآة، مرآة

286
00:23:03,000 --> 00:23:07,720
يوجد شاطئ هنا؟-
!ومع أوكونومياكي الآن-

287
00:23:07,880 --> 00:23:10,840
!هوتاروكو، هذا مكان ممتاز بالنّسبة لمتجر

288
00:23:11,010 --> 00:23:13,350
!أريد القيام باختبار شجاعة

289
00:23:13,510 --> 00:23:16,430
سمعتُ بأنّ هناك قرية مهجورة قريبة

290
00:23:16,600 --> 00:23:22,150
ممتاز! لندعُ غرانيت والآخرين-
ليت رايتو كان هنا أيضاً-

291
00:23:22,310 --> 00:23:23,730
...أجل

292
00:23:24,940 --> 00:23:30,610
،الحلقة القادمة من ديجيمون بيتبريك
"شبح مُنتصف الصّيف"