1
00:00:12,890 --> 00:00:17,020
في المستقبل القريب، يتمّ توليد إي-بولس
،بواسطة أفكار البشر ومشاعرهم

2
00:00:17,180 --> 00:00:20,810
واستخدام مصدر طاقة لأجهزة الذّكاء
الاصطناعيّ الّتي تُسمّى سابوتاما

3
00:00:20,980 --> 00:00:23,520
ما يؤدّي إلى تطوُّر جديد للبشريّة

4
00:00:24,610 --> 00:00:27,820
لكن انبثقتْ وحوشٌ مُرعبة من ظُلُمات هذه الظّاهرة

5
00:00:28,570 --> 00:00:31,160
وحوش تتطوّر بالتهامِ إي-بولس

6
00:00:31,620 --> 00:00:33,030
...إنّهم

7
00:00:33,450 --> 00:00:35,740
أشعر بنبضة مجنونة مدويّة

8
00:00:35,910 --> 00:00:38,660
حيث لا يمكن لأحد إيقافي بعدها

9
00:00:38,830 --> 00:00:42,710
سأشقّ طريقي إلى هناك بينما أبحث عن الإجابة

10
00:00:42,880 --> 00:00:44,920
انحت عاطفتك

11
00:00:46,210 --> 00:00:48,010
يتردّد صداه

12
00:00:48,170 --> 00:00:51,220
الإيقاع الّذي يتزامن

13
00:00:51,390 --> 00:00:55,640
هو نبضة تكشف رويداً عن العالم الخفيّ

14
00:00:55,810 --> 00:00:58,520
سجّل على قمّة خطّ الأساس الصّلب

15
00:00:58,680 --> 00:00:59,730
لا تعبث بالإيقاع

16
00:00:59,890 --> 00:01:01,440
العاديّ لا يكفي بالنّسبة لي

17
00:01:01,600 --> 00:01:04,770
!!!استمرّ في الصّراخ، صراخ
اصرخ كما لو أنّ هذا كلّ ما تملك

18
00:01:06,530 --> 00:01:11,740
حتّى لو بدأ ما تؤمن به يتشوّش

19
00:01:11,910 --> 00:01:14,490
الحقيقة الّتي تستحوذ عليها صامدة وحقيقيّة

20
00:01:14,660 --> 00:01:16,990
أَزِل ضابط الإيقاع وترجّل فحسب

21
00:01:17,160 --> 00:01:19,160
أشعر بنبضة مجنونة مدويّة

22
00:01:19,330 --> 00:01:21,870
النّبضة العاطفيّة الّتي تصدح

23
00:01:22,040 --> 00:01:25,630
هي مُعدّل الضّربات في الدّقيقة الّذي يستمرّ بلا توقُّف

24
00:01:25,790 --> 00:01:27,710
(لندع الإيقاع يقودنا)

25
00:01:27,880 --> 00:01:29,920
أمطار الغيم تبتلع المدينة

26
00:01:30,090 --> 00:01:33,680
حتّى لو تشوّه الإيقاع سأجعل ذلك جزءاً من روتيني

27
00:01:33,840 --> 00:01:36,260
اركبه كما ترى مُناسباً

28
00:01:36,430 --> 00:01:38,180
(لندع الإيقاع يقودنا)

29
00:01:38,350 --> 00:01:40,770
حتّى لو آلمني ذلك، لن أتوقّف

30
00:01:40,930 --> 00:01:43,600
استمرّ في نحت النّبضة
لا تتراجع أبداً

31
00:01:43,770 --> 00:01:47,320
يمكننا التغلّب على أيّ شيء

32
00:01:47,480 --> 00:01:49,280
اقرع بناء على عاطفتك

33
00:01:57,740 --> 00:02:01,040
سمعتُ بأنّكم كنتُم مشغولين جدّاً

34
00:02:01,200 --> 00:02:04,500
انسَ ذلك. حدّثنا عن سوجي كوروشيو

35
00:02:05,420 --> 00:02:06,460
كوروشيو؟

36
00:02:06,630 --> 00:02:08,590
إنّه نجمٌ خامس سابق، صحيح؟

37
00:02:08,750 --> 00:02:11,420
تغيّر كيو بعد رؤيته

38
00:02:11,590 --> 00:02:12,880
من يكون؟

39
00:02:14,220 --> 00:02:19,260
.هذا مُثير للاهتمام. قيل لي بأنّه ميّت
يبدو أنّ وُنغ قد نال منّا

40
00:02:20,390 --> 00:02:23,810
لم يكن يمتلك ذرّة مشاعر

41
00:02:23,980 --> 00:02:29,110
مع ذلك استطاع استخدام الإي-بولس الخاصّ به
لتوجيه الدّيجيمون حسب مشيئته

42
00:02:29,270 --> 00:02:31,690
وهذا تميُّز بين النّجوم الخمس

43
00:02:31,860 --> 00:02:34,490
كان ذلك سوجي كوروشيو

44
00:02:40,660 --> 00:02:42,700
لا مشاعر؟

45
00:02:42,870 --> 00:02:46,880
إذاً كيف اتّصل بشريكه الدّيجيمون؟

46
00:02:47,040 --> 00:02:50,090
لم يكن لديه ديجيمون شريك مُخصَّص

47
00:02:50,960 --> 00:02:52,670
إي-بولس سوداء

48
00:02:53,800 --> 00:02:59,600
باستخدامها، استطاع الهيمنة على الدّيجيمونات
وتبديل الشّريك مراراً

49
00:02:59,760 --> 00:03:02,470
ماذا حدث بينه وبين كيو؟

50
00:03:02,640 --> 00:03:03,850
لا أعلم

51
00:03:04,020 --> 00:03:05,890
،لكن قبل خمس سنوات

52
00:03:06,060 --> 00:03:10,020
أثناء البحث عن كيو، الّذي كان قد حادَ
عن الطّريق، تعرّضَ لحادث

53
00:03:10,230 --> 00:03:11,400
واختفى

54
00:03:11,570 --> 00:03:12,230
ماذا؟

55
00:03:12,400 --> 00:03:17,030
لم يُعثَر عليه، وفي نهاية المطاف
صدرت شهادة وفاة

56
00:03:17,570 --> 00:03:21,950
بعد ذلك بفترة قصيرة، غادر كيو النّجوم الخمس

57
00:03:22,120 --> 00:03:24,620
!أتعني بأنّ كيو قتله؟ مُستحيل

58
00:03:25,710 --> 00:03:30,590
إنّه كيو ساواشيرو. لا أحد يُصدِّق بأنّه
كان قدّيساً كما هو الآن

59
00:03:32,000 --> 00:03:35,300
،منذ انضمامه للنّجوم الخمس عن عمر 11

60
00:03:35,470 --> 00:03:39,590
كانت تُحيط به هالة إي-بولس غاضبة دوماً

61
00:03:40,180 --> 00:03:44,100
كان كلباً مسعوراً يحذف أهدافه دوماً

62
00:03:44,520 --> 00:03:48,730
كان يُقارع مُنافسه أثناء تنفيذ عمله

63
00:03:51,270 --> 00:03:57,490
وقبل الحادث بعام، انضمّ سوجي
كوروشيو للنّجوم الخمس

64
00:03:59,570 --> 00:04:04,490
ولا أعرف ما حدث في جبل أيهوشي بأيّ شكل

65
00:04:04,660 --> 00:04:07,960
لكن كانا دوماً كالزّيت والماء

66
00:04:08,120 --> 00:04:09,420
جبل أيهوشي؟

67
00:04:09,580 --> 00:04:10,420
...هذا

68
00:04:10,580 --> 00:04:12,670
!الجبل بالقرب من نيرينسو

69
00:04:13,550 --> 00:04:14,500
سنذهب، صحيح؟

70
00:04:14,670 --> 00:04:15,510
!أجل-
أجل-

71
00:04:19,720 --> 00:04:24,220
ستُعيدون كيو؟ هل تعتقدون حقّاً
بأنّه يريد ذلك؟

72
00:04:25,720 --> 00:04:26,680
...بغضّ النّظر

73
00:04:45,540 --> 00:04:46,410
كيو؟

74
00:04:47,120 --> 00:04:48,210
هل أنت بخير؟

75
00:05:11,350 --> 00:05:14,610
!كيو الذّهبيّ-
!كلب الرّئيس وُنغ-

76
00:05:21,400 --> 00:05:22,450
!موراساميمون

77
00:05:28,330 --> 00:05:30,540
أنت كُلّ ما بقي

78
00:05:30,710 --> 00:05:32,120
!ا-انتظر

79
00:05:32,290 --> 00:05:35,630
!سامحني! لم أنوِ خيانة أحد أبداً

80
00:05:37,550 --> 00:05:38,340
!كيو

81
00:05:38,510 --> 00:05:39,760
!نلتُ منك

82
00:05:40,920 --> 00:05:43,220
!أنت مُستهتر جدّاً يا كيو الذّهبيّ

83
00:05:43,390 --> 00:05:45,220
!افعلها يا أركنيمون

84
00:05:47,510 --> 00:05:48,520
!موراساميمون

85
00:05:50,270 --> 00:05:51,100
!افعلها

86
00:05:59,530 --> 00:06:02,740
!غونوزان موراشيغوري

87
00:06:12,120 --> 00:06:15,250
!أ-أرجوك! سامحني

88
00:06:16,080 --> 00:06:19,380
--سـ-سامح... سا... سا... سا

89
00:06:24,050 --> 00:06:25,430
هل أنت بخير يا كيو؟

90
00:06:25,800 --> 00:06:26,720
أجل

91
00:06:34,390 --> 00:06:35,190
!كيو

92
00:06:58,630 --> 00:07:00,670
!من هنا! وجدتُ شخصاً

93
00:07:08,850 --> 00:07:10,850
!ماذا؟ أنت مُستيقظ

94
00:07:11,010 --> 00:07:12,310
!الجميع

95
00:07:13,310 --> 00:07:15,310
كيو، هل أنت بخير؟

96
00:07:17,350 --> 00:07:18,520
أين أنا؟

97
00:07:23,990 --> 00:07:27,030
!هذا مُطمئن! أنت مُستيقظ

98
00:07:31,030 --> 00:07:32,370
!لا ينبغي أن تتحرّك

99
00:07:33,450 --> 00:07:35,290
لديك عِظام مكسورة

100
00:07:36,460 --> 00:07:38,000
لكنّني مُطمئنّة

101
00:07:38,420 --> 00:07:43,380
عندما قال لوكسمون بأنّه عثر على جسد
في النّهر. انصدمت

102
00:07:43,550 --> 00:07:46,470
!لو لم أنقذك، لكنتَ في عداد الموتى

103
00:07:47,050 --> 00:07:49,180
إذاً، من تكون على أيّ حال؟

104
00:07:49,340 --> 00:07:52,560
لست مُجرماً، أليس كذلك؟

105
00:07:53,520 --> 00:07:55,480
يُفترض أن تقول شيئاً

106
00:07:55,640 --> 00:07:57,020
أنت لا تتكلّم كثيراً

107
00:07:58,230 --> 00:07:59,190
!مهلاً

108
00:07:59,600 --> 00:08:02,020
شكراً على إنقاذي

109
00:08:02,190 --> 00:08:05,110
...لكن ليس لديّ ما أقوله

110
00:08:05,860 --> 00:08:06,820
!كيو

111
00:08:06,990 --> 00:08:08,490
لا يجدر بك أن تنهض

112
00:08:10,030 --> 00:08:12,410
ابقَ هنا حتّى تُشفى جروحك

113
00:08:13,330 --> 00:08:16,000
نحن نُساعد بعضنا الآخر عند الحاجة

114
00:08:17,040 --> 00:08:18,580
هذا نيرينسو

115
00:08:18,920 --> 00:08:21,380
أنا مينورو. مسرور لرؤيتك

116
00:08:21,540 --> 00:08:23,250
وأنا كارينا

117
00:08:23,880 --> 00:08:25,340
سررتُ بلقائك يا كيو

118
00:08:32,180 --> 00:08:38,180
هذا المرصد كان مركز جامعة عملَ فيه أبي

119
00:08:38,730 --> 00:08:42,730
لكن هُجِر بعد كارثة جزيرة كانو

120
00:08:42,900 --> 00:08:45,280
لذا قرّر أبي العيش هنا

121
00:08:45,440 --> 00:08:49,070
أطلق عليه بأبي، لكنّه ليس أبي الّذي أنجبني

122
00:08:49,240 --> 00:08:53,160
تبنّاني بعد وفاة أمّي وأبي الحقيقيّين

123
00:08:53,320 --> 00:08:56,950
بعد ذلك بفترة قصيرة، عثر لوكسمون
والآخرون على هذا المكان

124
00:08:57,120 --> 00:09:01,080
بعد العيش معاً، أصبحنا جميعنا كعائلة

125
00:09:01,250 --> 00:09:03,130
...لذا-
أنتِ تتكلّمين كثيراً-

126
00:09:03,670 --> 00:09:06,550
هذا لأنّك لا تقول شيئاً

127
00:09:07,130 --> 00:09:08,630
حسناً. انتهيت

128
00:09:09,470 --> 00:09:10,680
تفضّل

129
00:09:11,470 --> 00:09:13,720
أرزّ خاصّ وعصيدة خضراوات

130
00:09:15,140 --> 00:09:16,010
تفضّل

131
00:09:16,180 --> 00:09:18,600
أبي ماهر في الطّبخ

132
00:09:21,100 --> 00:09:23,020
ليس عليك أن تأكل

133
00:09:23,190 --> 00:09:25,360
يمكنني طبخ المزيد عندما تجوع

134
00:09:25,730 --> 00:09:28,190
إذاً سآكل بأنا

135
00:09:28,360 --> 00:09:30,400
لِمَ لا تأكل أيضاً يا كوغارمون؟

136
00:09:38,410 --> 00:09:39,750
!يبدو هذا مُضحكاً للغاية

137
00:09:40,540 --> 00:09:41,330
!ماذا؟

138
00:09:42,670 --> 00:09:44,040
!مُخيف، مُخيف

139
00:09:44,210 --> 00:09:47,340
أنا آسف. ليس لديّ لِباس آخر بمقاسك

140
00:09:47,500 --> 00:09:49,380
هذا يليق بك يا كيو

141
00:10:04,900 --> 00:10:06,650
ما الأمر يا كيو؟

142
00:10:14,200 --> 00:10:16,200
...ها نحن أولاء. وجبة اليوم هي

143
00:10:16,370 --> 00:10:19,160
!اختصاص نيرينسو، الكاري الخاصّة بي

144
00:10:19,330 --> 00:10:21,120
!لنأكل

145
00:10:23,040 --> 00:10:27,210
!لذيذة! أُعشق هذا

146
00:10:27,380 --> 00:10:28,920
هيّا. كُل

147
00:10:35,550 --> 00:10:38,970
الأكل هو الحياة

148
00:10:40,220 --> 00:10:41,560
تفضّل وكُل

149
00:10:50,940 --> 00:10:52,820
ما رأيك؟ هل هو لذيذ؟

150
00:12:18,700 --> 00:12:20,620
هل أنت متأكّد من هذا؟

151
00:12:21,160 --> 00:12:22,740
شُفيَتْ جروحي

152
00:12:25,410 --> 00:12:26,450
هيّا بنا

153
00:12:34,170 --> 00:12:35,340
إلى أين أنت ذاهب؟

154
00:12:39,720 --> 00:12:42,430
تحسّنتُ كثيراً. سأُغادر

155
00:12:42,850 --> 00:12:43,810
شكراً على كلّ شيء

156
00:12:44,930 --> 00:12:48,060
يمكنكما أن تبقيا هنا للأبد

157
00:12:48,230 --> 00:12:51,310
إن بقينا، فسيُخيف ذلك الدّيجيمونات الأُخرى

158
00:12:51,480 --> 00:12:53,980
!لا تكُن هكذا! لستَ غريباً

159
00:12:54,150 --> 00:12:55,610
...حتّى لو كنت تبدو مُخيفاً

160
00:12:55,780 --> 00:12:57,400
...لوكسمون

161
00:12:58,110 --> 00:13:00,740
هل كانت الإقامة غير مُريحة لك؟

162
00:13:03,160 --> 00:13:04,080
!لا تلمسيني

163
00:13:06,330 --> 00:13:07,330
...لا ينبغي لنا

164
00:13:08,620 --> 00:13:10,370
أن نبقى في مكان كهذا

165
00:13:10,540 --> 00:13:11,420
ماذا؟

166
00:13:12,000 --> 00:13:13,080
...أنا

167
00:13:13,920 --> 00:13:15,090
مُنظِّف

168
00:13:15,840 --> 00:13:17,130
مُنظِّف؟

169
00:13:18,300 --> 00:13:20,050
،لصالح الاتّحاد العالميّ

170
00:13:20,510 --> 00:13:22,220
...الدّيجيمونات غير المُلائمة

171
00:13:22,840 --> 00:13:24,010
...والأشخاص أيضاً

172
00:13:27,020 --> 00:13:29,020
حذفتُهم جميعاً

173
00:13:30,770 --> 00:13:32,520
،أولئك الّذين قاوموا

174
00:13:32,690 --> 00:13:34,770
...وأولئك الّذين توسّلوا أن أعفو عنهم

175
00:13:35,060 --> 00:13:36,020
...مراراً

176
00:13:36,650 --> 00:13:37,690
!وتكراراً

177
00:13:38,570 --> 00:13:40,780
البشر والدّيجيمونات كعائلة؟

178
00:13:40,950 --> 00:13:42,450
العيش بسعادة معاً؟

179
00:13:44,200 --> 00:13:47,450
لا أملك الحقّ لأعيش هكذا

180
00:13:54,540 --> 00:13:55,750
!هذا غير صحيح

181
00:13:57,670 --> 00:13:59,260
هذا غير صحيح

182
00:13:59,880 --> 00:14:01,380
يمكنك بدء حياة جديدة

183
00:14:02,260 --> 00:14:03,970
...إذا تمنّيتَ ذلك فعلاً

184
00:14:04,640 --> 00:14:06,050
فستتحقّق

185
00:14:10,930 --> 00:14:13,190
كفى عِناداً أيّها الأحمق

186
00:14:13,900 --> 00:14:16,980
من يحتاج حقّاً لتكوين عائلة؟

187
00:14:17,150 --> 00:14:18,940
تريد البقاء، أليس كذلك؟

188
00:14:20,150 --> 00:14:24,780
الجميع يعلمون بأنّك لطيف ضمنيّاً

189
00:14:26,240 --> 00:14:31,120
وبأنّك لا تريد أذيّة أحد بعد الآن

190
00:14:32,290 --> 00:14:33,410
لا عليك

191
00:14:34,120 --> 00:14:36,830
نحن عائلة

192
00:14:37,590 --> 00:14:40,250
جميعنا... في صفِّك

193
00:15:07,200 --> 00:15:08,070
كيو

194
00:15:08,740 --> 00:15:11,410
!عيد ميلاد سعيد لك

195
00:15:12,200 --> 00:15:14,620
عملتُ بجدّ، لذا كُل بشغف

196
00:15:16,290 --> 00:15:17,460
شكراً لك

197
00:15:18,460 --> 00:15:23,210
،مهما كان ماضي المرء سوداويّاً
لا بُدّ للّيل أن ينتهي

198
00:15:23,880 --> 00:15:26,470
لم تعُد لوحدك بعد الآن

199
00:15:27,090 --> 00:15:29,100
من الآن فصاعداً، نحن معك

200
00:15:30,890 --> 00:15:32,720
تفضّل هديّتك

201
00:15:35,230 --> 00:15:36,770
دليل على أنّنا عائلة

202
00:15:39,900 --> 00:15:41,570
...من الآن فصاعداً

203
00:15:42,360 --> 00:15:45,280
عسى أن نعيش بسعادة معاً

204
00:15:58,620 --> 00:15:59,750
شكراً لكم

205
00:16:00,250 --> 00:16:01,290
سأقدّرها

206
00:16:02,000 --> 00:16:03,340
انفخها

207
00:16:10,970 --> 00:16:12,890
تأخّر الجميع

208
00:16:13,470 --> 00:16:14,350
أجل

209
00:16:22,440 --> 00:16:23,400
!لوكسمون

210
00:16:25,150 --> 00:16:27,280
!ما الأمر؟ ماذا حدث؟

211
00:16:28,280 --> 00:16:30,570
...ساعدنا... كيو

212
00:16:31,490 --> 00:16:34,200
الجميع... قد حُذِفوا

213
00:16:35,410 --> 00:16:37,370
...الجبل المُجاور

214
00:16:37,830 --> 00:16:40,540
أنقذ... هما

215
00:16:40,960 --> 00:16:42,960
!مهلاً! لوكسمون

216
00:16:49,380 --> 00:16:50,550
!لنُسرع

217
00:16:58,730 --> 00:17:00,770
!كارينا! مينورو

218
00:17:01,440 --> 00:17:03,360
هل أنتِ بخير يا كارينا؟

219
00:17:03,980 --> 00:17:05,020
كيف حال مينورو؟

220
00:17:07,940 --> 00:17:08,990
...لا

221
00:17:09,860 --> 00:17:10,950
...كيو

222
00:17:11,110 --> 00:17:14,410
...كارينا! تماسكي! سأنقلكِ إلى

223
00:17:21,500 --> 00:17:22,710
اهرب

224
00:17:23,290 --> 00:17:27,880
...رجل... كان لديه ديجيمون

225
00:17:28,340 --> 00:17:30,720
كان يبحث... عنك

226
00:17:30,880 --> 00:17:31,680
ماذا؟

227
00:17:33,470 --> 00:17:34,350
!كارينا

228
00:17:35,600 --> 00:17:36,970
...أرجوك

229
00:17:37,970 --> 00:17:39,640
اهرب

230
00:17:41,100 --> 00:17:43,650
كارينا؟

231
00:17:43,810 --> 00:17:46,940
!كارينا

232
00:17:51,400 --> 00:17:52,610
...هذه الرّائحة

233
00:17:53,240 --> 00:17:55,280
!كيو! إنّه هو

234
00:18:21,850 --> 00:18:25,480
كنت هنا إذاً؟

235
00:18:27,520 --> 00:18:30,740
ألحَّ عليّ وُنغ كي آتي وأبحث عنك

236
00:18:31,530 --> 00:18:34,570
ماذا كنت تفعل طوال هذا الوقت؟

237
00:18:35,410 --> 00:18:36,660
ماذا عنك؟

238
00:18:37,830 --> 00:18:39,160
ماذا فعلت؟

239
00:18:47,250 --> 00:18:50,210
...على ذكر الأمر

240
00:18:50,380 --> 00:18:55,550
وجدتُ ديجيموناً غير مُسجّل، وعندما
...حاولتُ حذفه

241
00:18:55,720 --> 00:18:59,010
حاول أبٌ وابنةٌ إيقافي

242
00:18:59,760 --> 00:19:02,980
اعترضا طريقي، لذا تخلّصتُ منهما

243
00:19:05,560 --> 00:19:06,480
وبعد؟

244
00:19:13,150 --> 00:19:14,150
ماذا؟

245
00:19:14,900 --> 00:19:17,030
لستُ أفهم

246
00:19:17,740 --> 00:19:20,120
لِمَ أنت غاضب؟

247
00:19:20,580 --> 00:19:21,540
...كيف تجرؤ

248
00:19:22,410 --> 00:19:26,170
كيف تجرؤ على قتل الأشخاص
!الّذين يهمّني أمرهم؟

249
00:19:32,630 --> 00:19:33,880
!أعدها

250
00:19:34,470 --> 00:19:37,260
!أعِد عائلتي

251
00:20:05,040 --> 00:20:06,960
ماذا؟

252
00:20:07,460 --> 00:20:09,420
هل سأموت؟

253
00:20:09,920 --> 00:20:11,340
أيُعقَل أنّه...؟

254
00:20:13,500 --> 00:20:15,050
أحقّاً ذلك؟

255
00:20:15,210 --> 00:20:16,010
!كُفّ عن الكلام

256
00:20:18,340 --> 00:20:22,300
ما هذا الإحساس بالقشعريرة الّذي يُراودني؟

257
00:20:23,310 --> 00:20:25,430
...ماذا؟ التعطُّش

258
00:20:25,890 --> 00:20:27,020
لقد زال

259
00:20:29,480 --> 00:20:31,690
ماذا فعلتَ يا كيو؟

260
00:20:31,860 --> 00:20:32,900
!اصمت

261
00:20:33,570 --> 00:20:37,070
!هيّا! أخبرني من فضلك

262
00:20:37,610 --> 00:20:40,070
!ماذا فعلتَ لي؟

263
00:21:17,740 --> 00:21:18,610
...كارينا

264
00:21:19,650 --> 00:21:20,570
...مينورو

265
00:21:21,950 --> 00:21:22,990
...الجميع

266
00:21:24,330 --> 00:21:26,370
...لو لم يلتقوا بي

267
00:21:29,870 --> 00:21:30,870
...كيو

268
00:21:35,380 --> 00:21:36,630
أنا بخير

269
00:21:37,920 --> 00:21:38,880
هيّا بنا

270
00:22:01,200 --> 00:22:07,370
اتّخذتُ قراري
سأعيش حياتي على طريقتي

271
00:22:07,870 --> 00:22:14,630
يبدو كُلّ شيء على ما يُرام
سأجعل الغد هو الأفضل

272
00:22:14,790 --> 00:22:16,790
تعلم بأنّني لا أستطيع تصنُّع ذلك

273
00:22:16,960 --> 00:22:18,750
لا أستطيع التحكُّم بهذه الطّاقة

274
00:22:18,920 --> 00:22:22,220
أنا لا أنسجم، لكنّني على قيد الحياة

275
00:22:22,380 --> 00:22:28,850
سأحوّل كُلّ نُدبة إلى لحن
لذا ها هو ذا

276
00:22:29,100 --> 00:22:34,560
سأحطّم ما هو واضح، بهذا الصّوت

277
00:22:34,730 --> 00:22:36,650
سأحطّمه الآن، سأحطّمه الآن أجل

278
00:22:36,810 --> 00:22:41,070
وفق الإيقاع الّذي في أعماق قلبي

279
00:22:41,240 --> 00:22:43,240
سأُعيد صياغة حياتي

280
00:22:43,400 --> 00:22:45,990
أريد أن أؤمن فحسب لأنّني
أعلم بأنّ هذا هو المفتاح

281
00:22:46,160 --> 00:22:48,450
فليسمعه العالم كُلّه

282
00:22:48,620 --> 00:22:51,040
هذه هي حقيقتي، أريد فقط
"أن أكون "أنا

283
00:22:51,200 --> 00:22:52,580
وأريد أن أكون حُرّة

284
00:22:52,750 --> 00:22:55,370
سأحطّمه الآن، سأُحطّمه الآن

285
00:22:55,540 --> 00:22:57,170
وأجد نفسي

286
00:23:02,920 --> 00:23:06,140
...توقّف يا كيو! لِمَ لا

287
00:23:06,300 --> 00:23:08,510
تثق بعائلتك؟

288
00:23:08,680 --> 00:23:10,760
،قولك بأنّك ستُغادر غلوينغ داون

289
00:23:10,930 --> 00:23:14,100
هل حسبتَ بأنّك تستطيع تركنا
بهذه البساطة فحسب؟

290
00:23:14,270 --> 00:23:16,150
!أنت من علّمنا

291
00:23:16,480 --> 00:23:20,940
هل كذبت بشأن الرّغبة في بناء مُستقبل
حيث نستطيع العيش مع ديجيمون؟

292
00:23:21,320 --> 00:23:22,280
...أنا فقط

293
00:23:22,860 --> 00:23:24,240
...لا أريدكم أن

294
00:23:24,900 --> 00:23:30,620
،الحلقة القادمة من ديجيمون بيتبريك
"الغد الذّهبيّ"