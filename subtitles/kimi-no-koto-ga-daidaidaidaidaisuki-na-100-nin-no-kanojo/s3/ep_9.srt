1
00:00:11,030 --> 00:00:13,210
المجموعة المُتشدّدة

2
00:00:13,210 --> 00:00:19,510
تجمُّع يديره أقرباء بعيدين لسوتو
إيكو لا تعلم حتّى بأنّهم لديها

3
00:00:19,510 --> 00:00:23,740
"شعار الشّركة هو، "مُنتجات مُتشدِّدة، جودة مُتشدِّدة

4
00:00:23,740 --> 00:00:25,590
!ساوِم ومُت

5
00:00:25,590 --> 00:00:26,550
!حاضر

6
00:00:26,830 --> 00:00:31,680
،والآن تفتتح المجموعة مركزها الأحدث
الينابيع المُتشدِّدة السّاخنة

7
00:00:31,680 --> 00:00:36,930
وربحت عائلةُ رينتارو دعوة مجّانيّة حصريّة
!ما قبل الافتتاح في عمليّة سحب

8
00:00:37,270 --> 00:00:38,770
!ربحنا

9
00:02:15,990 --> 00:02:18,140
!الكثير من الحمّامات

10
00:02:18,140 --> 00:02:20,620
"!عندما تكون في نبع ساخن مُنعزل، قُل آاااه"

11
00:02:25,410 --> 00:02:28,380
لا حاجة للّؤم في وجه الينابيع السّاخنة

12
00:02:28,380 --> 00:02:29,880
...طبق ينابيع ساخنة

13
00:02:29,880 --> 00:02:32,270
يسيل لُعابكِ يا عزيزتي

14
00:02:34,580 --> 00:02:36,140
...لُعابكِ المُزخرف يا مولاتي

15
00:02:36,140 --> 00:02:38,340
حان وقت زيارة كُلّ نبع ساخن هنا

16
00:02:38,340 --> 00:02:41,140
تبحثين عن كُلّ آثار الشّفاء؟ هذا كفؤ

17
00:02:41,140 --> 00:02:43,860
لنكتسب مزيداً من الجمال معاً

18
00:02:43,860 --> 00:02:45,260
تعالي معي يا ميمي-سان

19
00:02:45,260 --> 00:02:48,150
...ماذا؟ أ-أنا

20
00:02:48,150 --> 00:02:52,620
بما أنّ المكان كُلّه لنا، يُسمَح لنا
بارتداء زيّ سباحة وإدخال رينتارو-سان

21
00:02:52,620 --> 00:02:56,610
لا نظير لهذه الحرّية المُنعِشة
في أيّ مكان تحت الأرض

22
00:02:57,020 --> 00:03:01,840
لن يكون لِقاء عشّاق إذا انعزل
بطلُنا في حمّام الرّجال

23
00:03:02,250 --> 00:03:04,760
رينتارو-سان على قيد الحياة أيضاً

24
00:03:04,760 --> 00:03:07,250
يمكننا اعتباره حمّاماً عائليّاً

25
00:03:07,250 --> 00:03:09,600
لأجل "عائلة رينتارو"، صحيح؟

26
00:03:09,600 --> 00:03:12,880
أجل! إذاً لدينا اليوم كُلّه هنا

27
00:03:13,180 --> 00:03:15,060
!لنُزلزل الأرض

28
00:03:15,060 --> 00:03:16,880
!أجل

29
00:03:21,600 --> 00:03:24,890
!يا لهذه الفُقاعات المُتشدِّدة

30
00:03:27,650 --> 00:03:30,400
!يا إلهي

31
00:03:34,680 --> 00:03:37,530
!يجب استخدام رشّاش المياه لشطف الفُقاعات

32
00:03:41,860 --> 00:03:43,390
!اللّعنة، هذا مؤلم

33
00:03:43,390 --> 00:03:45,040
!ما هذا، قطّاع مائيّ؟

34
00:03:45,040 --> 00:03:46,310
!الشلّة في ورطة

35
00:03:46,790 --> 00:03:49,400
!أمسكتُ بك

36
00:03:47,860 --> 00:03:51,790
.هذه هي بطلتُنا يامامي-سينباي
وكأنّها تُصارع ثعباناً مُفترِساً

37
00:03:53,570 --> 00:03:56,140
لا يمكننا استخدام رشّاشات المياه
هذه. إنّها محفوفة بالمخاطر

38
00:03:56,140 --> 00:03:58,930
!لكن الفُقاعات لا تتوقّف

39
00:04:00,010 --> 00:04:01,930
!يـ-يا فتيات

40
00:04:09,560 --> 00:04:15,570
!قُذِفَتْ كوسوري فُقاعيّاً نحو حمّام
!لكنّها ثُبِّتَتْ الآن بواسطة ضغط نفّاث

41
00:04:16,710 --> 00:04:17,700
!مُؤلم

42
00:04:17,700 --> 00:04:20,570
!إ-إيكو! النّجدة

43
00:04:20,570 --> 00:04:22,070
!كوسوري-سينباي

44
00:04:29,520 --> 00:04:30,250
!إيكو

45
00:04:31,440 --> 00:04:35,660
!الآن! اخرجي بينما أحتوي الماء

46
00:04:45,300 --> 00:04:47,660
أحسنتِ صنعاً. يمكنكِ التوقُّف الآن

47
00:04:48,770 --> 00:04:50,380
!يوشيموتو شيزوكا

48
00:04:51,670 --> 00:04:53,520
أنا قادمة في الحال

49
00:05:00,520 --> 00:05:02,660
...هـ-هذا شاهق الارتفاع

50
00:05:04,040 --> 00:05:05,000
!أنا خائفة

51
00:05:05,410 --> 00:05:07,020
نانو-سان؟

52
00:05:07,020 --> 00:05:10,400
!تجمّدتْ بسبب الارتفاع

53
00:05:10,910 --> 00:05:16,170
ماذا أفعل؟ ماذا أفعل؟
!كانت تُحاول مُساعدتي

54
00:05:16,610 --> 00:05:20,420
!لا بُدّ من وجود شيء أستطيع فعله

55
00:05:23,310 --> 00:05:25,100
يوشيموتو شيزوكا

56
00:05:26,190 --> 00:05:28,270
تحاول أن تُواسيني

57
00:05:42,550 --> 00:05:44,440
لنذهب ونبحث عن الآخرين

58
00:05:46,150 --> 00:05:48,120
مؤلم... أين أنا؟

59
00:05:50,840 --> 00:05:53,500
هذا الصّوت... كاراني-سان؟

60
00:05:57,540 --> 00:06:00,220
آسفة، أخطأت الشّخص

61
00:06:02,030 --> 00:06:04,020
...ماذا؟ المعذرة

62
00:06:07,140 --> 00:06:09,050
لا، أنا متأكّدة بأنّني أخطأتُ الشّخص

63
00:06:11,020 --> 00:06:15,080
ما-ماذا حدث؟ هل تعرّضا لضرب أو ما شابه؟

64
00:06:21,870 --> 00:06:24,530
حـ-حقّاً؟

65
00:06:24,810 --> 00:06:28,230
على أيّ حال، ينبغي أن نذهب
ونبحث عن الآخرين

66
00:06:31,860 --> 00:06:32,790
ماذا؟

67
00:06:55,250 --> 00:06:58,520
!واجهي الحقائق يا كاراني-سان

68
00:06:59,910 --> 00:07:01,530
!هذا ليس إلّا محض وهم

69
00:07:02,280 --> 00:07:08,070
تذكّري كُلّ تلك اللّحظات الّتي تشاركناها
!هناك مع الجميع

70
00:07:08,400 --> 00:07:10,450
!أجل، لا ضير من حمّام نبع أبديّ

71
00:07:10,900 --> 00:07:13,330
!لكن لديكِ مُستقبل معنا

72
00:07:13,330 --> 00:07:17,080
!ما الأكثر واقعيّة بالنّسبة لكِ يا كاراني-سان؟

73
00:07:36,460 --> 00:07:38,730
!لا تركضي في الحمّامات

74
00:07:41,650 --> 00:07:45,990
!قوّة هذا الشلّال... لا أستطيع الحركة

75
00:07:47,020 --> 00:07:48,240
ميميمي-سينباي

76
00:07:49,600 --> 00:07:53,120
يمكنني الشّعور بالقوّة حتّى وهي تغطّيني

77
00:07:53,120 --> 00:07:57,870
لا بُدّ أنّ وضعها أسوأ بكثير لأنّها
!تتحمّل وقع الاصطدام كُلّه

78
00:07:59,450 --> 00:08:02,130
هل أنتِ بخير يا ميمي-سان؟

79
00:08:02,130 --> 00:08:04,630
ماذا؟ أ-أجل

80
00:08:04,630 --> 00:08:08,330
هذا جيّد. لكن كيف سنفلت من هذا؟

81
00:08:08,330 --> 00:08:09,510
...ميميمي-سينباي

82
00:08:09,940 --> 00:08:16,020
كيف لها أن تقلق بشأني رغم أنّها
تتألّم أكثر منّي؟

83
00:08:16,380 --> 00:08:18,790
يجب أن أفكِّر

84
00:08:18,790 --> 00:08:21,430
...وأكتشف ما يمكنني فعله

85
00:08:22,070 --> 00:08:25,400
!لمُساعدة ميميمي-سينباي

86
00:08:27,150 --> 00:08:29,570
!ميميمي-سينباي

87
00:08:30,380 --> 00:08:32,160
...هـ-هل يمكنك

88
00:08:32,160 --> 00:08:37,410
أن تـ-تقبّلي عنقي من فضلكِ؟

89
00:08:37,410 --> 00:08:39,310
!لمَ تطلبين هذا فجأة؟

90
00:08:39,310 --> 00:08:43,670
لحظة، أتفهّم هذه الرّغبة. فأنا جميلة جدّاً

91
00:08:44,750 --> 00:08:46,040
كما تشائين

92
00:08:54,640 --> 00:08:58,220
مستحيل... ما الّذي فعلتُه؟

93
00:08:58,220 --> 00:09:01,210
!لا

94
00:09:01,690 --> 00:09:02,940
!ميميمي-سينباي

95
00:09:02,940 --> 00:09:03,980
!ميمي-سان

96
00:09:03,980 --> 00:09:05,370
تحرّرت

97
00:09:05,730 --> 00:09:08,700
هل أنتِ بخير يا ميميمي-سينباي؟

98
00:09:08,700 --> 00:09:09,990
...ميمي-سان

99
00:09:10,450 --> 00:09:14,490
لا أصدّق بأنّ ميمي-سان طرحتْ
اقتراحاً جريئاً كهذا

100
00:09:17,420 --> 00:09:21,440
.هيّا بنا نذهب يا ميمي-سان
يجب أن نبحث عن الآخرين

101
00:09:21,440 --> 00:09:22,500
أجل

102
00:09:22,960 --> 00:09:26,000
كم نضجتِ يا عزيزتي ميمي-سان

103
00:09:28,130 --> 00:09:29,260
...ميمي

104
00:09:29,680 --> 00:09:32,690
!يا للهول! بشرتي ناعمة جدّاً

105
00:09:32,690 --> 00:09:34,300
!من رأسكِ حتّى أخمص قدميكِ؟

106
00:09:37,350 --> 00:09:38,520
،يجب ألّا تدخلي

107
00:09:38,520 --> 00:09:39,890
يا هاهاري-ساما

108
00:09:40,450 --> 00:09:43,460
،دفعَتْني الفُقاعات إلى هنا

109
00:09:43,460 --> 00:09:46,900
فتجمّدَ جسدي فوراً وشُلّتْ حركته

110
00:09:46,900 --> 00:09:49,880
لا يرفّ كجفني تماماً

111
00:09:49,880 --> 00:09:52,530
لحظة، هل كانت تلك مزحة؟
هل ينبغي أن أضحك؟

112
00:10:03,390 --> 00:10:04,670
هاهاري-ساما؟

113
00:10:06,080 --> 00:10:08,920
!هذا بارد بشكل قارس

114
00:10:08,920 --> 00:10:10,990
!لا تفعلي هذا يا هاهاري-ساما

115
00:10:10,990 --> 00:10:14,680
!لا تُخاطري بنفسكِ لمُجرّد خادمة مثلي

116
00:10:14,680 --> 00:10:18,840
أيّ سيّدة تعجز عن الحِفاظ على
سلامة خادمتها الخاصّة؟

117
00:10:19,590 --> 00:10:20,680
هيّا

118
00:10:26,070 --> 00:10:27,690
أتشعرين بأيّ دفء؟

119
00:10:32,380 --> 00:10:33,760
هل يمكنكِ الحركة الآن؟

120
00:10:36,050 --> 00:10:39,130
أجل يا هاهاري-ساما

121
00:10:40,580 --> 00:10:44,610
!لمحتُ المرأة هاهاري والفتاة مي

122
00:10:44,610 --> 00:10:45,830
هل الجميع هنا؟

123
00:10:45,830 --> 00:10:48,270
تشيو وموميجي وياكو-سان لم يصلنَ بعد

124
00:10:48,270 --> 00:10:50,100
ولا رينتارو-سان أيضاً

125
00:10:50,100 --> 00:10:53,470
قفز داخل الفُقاعات بحثاً عنهن

126
00:10:53,470 --> 00:10:59,460
ماذا؟ في داخل تلك الرّغوة الّتي تحجب
الرّؤية؟ هذا يُزيد الأمور سوءاً

127
00:10:59,460 --> 00:11:03,120
لا تقلقن. الثّلاثة جميعهن بخير

128
00:11:06,950 --> 00:11:09,110
!الثّلاثة، وليس الأربعة

129
00:11:09,110 --> 00:11:10,940
هل أنت بخير؟

130
00:11:10,940 --> 00:11:13,100
جروح الوجه خطيرة

131
00:11:13,100 --> 00:11:14,570
إنّها قصّة طويلة

132
00:11:16,090 --> 00:11:17,220
!تشيو-تشان

133
00:11:17,220 --> 00:11:19,830
!وجدتُ نظّارتكِ في الحمّام الرّئيسيّ

134
00:11:22,450 --> 00:11:24,780
!اغسل نفسك قبل الدّخول

135
00:11:24,780 --> 00:11:26,550
!تنطبق القواعد عليّ وعليكِ

136
00:11:26,550 --> 00:11:27,830
!رينتارو-سان؟

137
00:11:29,950 --> 00:11:32,390
...أنا أتجسّس

138
00:11:32,870 --> 00:11:33,950
...موميجي

139
00:11:33,950 --> 00:11:35,410
!مون دي رينغ

140
00:11:37,930 --> 00:11:41,230
!أحبُّ هذا الملمس المطّاطيّ

141
00:11:41,230 --> 00:11:43,280
!ملاك مُداعبة

142
00:11:43,280 --> 00:11:44,750
!رينتارو-سان؟

143
00:11:48,350 --> 00:11:51,310
هذه أشبه بغابة أمطار استوائيّة

144
00:11:51,310 --> 00:11:53,860
!حرب خنادق في حمّام ساونا؟

145
00:11:54,220 --> 00:11:58,060
!هل أنتِ بخير يا ياكو-سان؟! تماسكي

146
00:11:59,430 --> 00:12:01,750
شكراً جزيلاً لك

147
00:12:01,750 --> 00:12:06,120
جعلتَ آخر أيّامي في الأرض رائعة للغاية

148
00:12:06,120 --> 00:12:08,820
تستحقُّ مُكافأة

149
00:12:12,380 --> 00:12:14,870
مهلاً، أريد منحه مُكافأة أيضاً

150
00:12:14,870 --> 00:12:15,760
!أنا أيضاً

151
00:12:16,360 --> 00:12:20,260
!هجوم قبلة ثُلاثي اللّوليّات

152
00:12:20,260 --> 00:12:22,380
!أ-أريد ذلك أيضاً

153
00:12:22,380 --> 00:12:24,520
كلّ تلك الجروح كانت ذاتيّة؟

154
00:12:22,870 --> 00:12:25,270
كان من المُفترض أن تكون مُواعدتنا
...الأولى في الينابيع السّاخنة

155
00:12:33,500 --> 00:12:36,550
يبدو كحمّام عاديّ

156
00:12:36,550 --> 00:12:40,450
يمكننا دخول الحمّام العاديّ الّذي
عثرنا عليه أثناء وجودنا هنا

157
00:12:44,950 --> 00:12:47,450
...أُ-أُقرّ

158
00:12:47,450 --> 00:12:48,730
"...هذا حقّاً"

159
00:12:50,080 --> 00:12:54,710
!سماويّ

160
00:12:59,220 --> 00:13:02,140
!لا! أعدهم حيث وجدتهم

161
00:13:02,140 --> 00:13:03,390
حسناً

162
00:13:07,130 --> 00:13:09,480
يا فتى

163
00:13:09,480 --> 00:13:12,350
هذه سلاسل مفاتيح محدودة الكمّية؟

164
00:13:12,350 --> 00:13:15,230
كانت فتياتنا تسعى للحصول عليها

165
00:13:15,230 --> 00:13:17,360
،إن كنت لا تريد أن تتأذّى

166
00:13:17,360 --> 00:13:19,490
فسوف تُشاركنا بعضاً منها، أليس كذلك؟

167
00:13:19,770 --> 00:13:22,540
ماذا؟ لـ-لا، آسف

168
00:13:22,540 --> 00:13:26,490
،زرتُ الكثير من المتاجر للحصول عليها
—وهي لخليلاتي

169
00:13:26,490 --> 00:13:29,400
!مُحال! لديك الكثير منها

170
00:13:29,400 --> 00:13:30,870
كم خليلة لديك؟

171
00:13:31,290 --> 00:13:32,620
...في الواقع

172
00:13:32,620 --> 00:13:34,000
ستّة عشر

173
00:13:34,000 --> 00:13:36,220
أنت مُضارِب، أليس كذلك؟

174
00:13:36,220 --> 00:13:37,250
أبداً

175
00:13:37,250 --> 00:13:39,510
!أنتم! يا للخزيّ

176
00:13:39,510 --> 00:13:42,160
رجال بالغون يتكاثرون على فتى؟

177
00:13:42,160 --> 00:13:43,510
ماذا؟

178
00:13:43,510 --> 00:13:45,890
!هل لديكِ اعتراض؟ تعالي إليّ إذاً

179
00:13:47,870 --> 00:13:49,890
!هذا ليس آمناً! ينبغي أن تهربي

180
00:13:50,160 --> 00:13:51,270
لا

181
00:13:51,890 --> 00:13:55,340
لن ألوذ بالفرار من معركة

182
00:13:55,340 --> 00:13:56,570
!لكن لديه سكّين

183
00:13:56,570 --> 00:13:58,150
!اللّعنة عليكِ

184
00:13:58,150 --> 00:14:04,030
إذا هربتُ كالجبانة من هؤلاء العصابة
،الخسيسين بدلاً من القيام بالصّواب

185
00:14:04,030 --> 00:14:07,090
!فستذهب كافّة جهودي إلى الآن عبثاً حينها

186
00:14:09,310 --> 00:14:10,410
مُذهل

187
00:14:10,410 --> 00:14:14,540
!إنّها شُجاعة جدّاً وشهمة وقويّة

188
00:14:14,840 --> 00:14:18,070
!إنّها كفارِسة جاءت من حكاية خُرافيّة

189
00:14:18,800 --> 00:14:20,050
!لننتظر حتّى التّنزيلات المُقبلة

190
00:14:21,710 --> 00:14:23,110
هل أنت بخير؟

191
00:14:23,110 --> 00:14:24,800
أ... أجل

192
00:14:26,430 --> 00:14:29,810
!إنّها رائعة بشكل لا يُصدَّق

193
00:14:42,570 --> 00:14:44,040
إلى اللِّقاء

194
00:14:44,670 --> 00:14:49,330
هـ-هل يمكنكِ إخباري باسمكِ على الأقلّ؟
!اسمحي لي أن أردّ الجميل لكِ بطريقة ما

195
00:14:50,370 --> 00:14:53,080
إنّها رائعة بشكل لا يُصدَّق

196
00:14:53,840 --> 00:14:56,880
لا حاجة لذلك. لم أفعل إلّا الصّواب

197
00:14:56,880 --> 00:14:58,960
!إنّها رائعة بشكل لا يُصدَّق حقّاً

198
00:14:59,880 --> 00:15:01,210
!أرجوكِ! أتوسّل إليكِ

199
00:15:01,210 --> 00:15:02,460
!ماذا تفعل؟

200
00:15:02,850 --> 00:15:06,160
!أوقِف هذا حالاً! أليس لديك كبرياء؟

201
00:15:06,160 --> 00:15:06,970
!بلى

202
00:15:06,970 --> 00:15:09,770
!وهو لا يسمح لي بعدم تسديد ديوني

203
00:15:09,770 --> 00:15:12,720
بأيّ وجه سأقف أمام أحبّائي إن لم أفعل؟

204
00:15:14,150 --> 00:15:19,110
أهذا ميثاق الشّرف لديك؟ سألبّيك إذاً

205
00:15:23,360 --> 00:15:29,240
لستُ مرتاحة تماماً بجعل زميل أصغر في المدرسة
يدعوني لتناول طعام على حسابه

206
00:15:29,240 --> 00:15:31,900
ماذا؟ كيف عرفتِ بأنّني أصغر؟

207
00:15:31,900 --> 00:15:33,660
من مظهري؟

208
00:15:33,660 --> 00:15:38,000
لا، لم أرك ببساطة بين زملائي
في السّنة الثّالثة

209
00:15:38,420 --> 00:15:42,250
بالطّبع، لا أستطيع تحديد عمر شخص
بالضّبط من خلال مظهره

210
00:15:42,250 --> 00:15:43,130
،ففي نهاية المطاف

211
00:15:43,130 --> 00:15:47,900
إحدى زميلاتي في الصّفّ تبدو وكأنّها
في المدرسة الابتدائيّة

212
00:15:47,900 --> 00:15:50,180
هناك شخص آخر مثل كوسوري-سينباي؟

213
00:15:50,180 --> 00:15:52,370
وحتّى أنّها تذهب إلى نادي الكيمياء؟

214
00:15:52,370 --> 00:15:54,000
لا. إنّها كوسوري-سينباي فحسب

215
00:15:55,680 --> 00:15:57,440
!أنتِ ظريفة جدّاً يا كوسوري

216
00:15:57,440 --> 00:15:59,000
!يا لكِ من فتاة

217
00:16:00,670 --> 00:16:05,500
بينما أنتِ ناضجة جدّاً

218
00:16:05,500 --> 00:16:09,060
ليس من ناحية المظهر، بل من ناحية السّلوك

219
00:16:09,060 --> 00:16:12,450
يُقال لي كثيراً، لكن لا أعرف السّبب بالضّبط

220
00:16:13,280 --> 00:16:15,770
،رُبّما لأنّني الابنة الأكبر بين ستّة أطفال

221
00:16:15,770 --> 00:16:20,830
وكنتُ غالباً ما أعتني بأخوتي وأخواتي
بالنّيابة عن أمّي

222
00:16:21,210 --> 00:16:22,940
أحقّاً ذلك؟

223
00:16:24,420 --> 00:16:26,630
سينباي، هناك زغب على رأسكِ

224
00:16:26,890 --> 00:16:28,130
!لا تلمسني

225
00:16:32,870 --> 00:16:34,510
سـ-سامحيني

226
00:16:35,070 --> 00:16:38,630
أرى من المُهين أن أسمح لأحد آخر
يلمس رأسي، النّقطة الحيويّة

227
00:16:38,630 --> 00:16:41,020
!إنّها عزيزة نفس

228
00:16:41,020 --> 00:16:44,870
لا، أنا من ينبغي أن أعتذر على عدم لباقتي

229
00:16:46,170 --> 00:16:47,400
شكراً لك

230
00:16:48,160 --> 00:16:50,470
كانت وجبة لذيذة

231
00:16:50,470 --> 00:16:51,770
ينبغي أن أذهب الآن

232
00:16:51,770 --> 00:16:53,030
...مـ-مهلاً

233
00:16:54,270 --> 00:16:57,470
أنا آيجو رينتارو، سنة أولى

234
00:16:57,470 --> 00:17:00,170
هل يمكننا اللّقاء ثانية؟

235
00:17:02,460 --> 00:17:05,460
اسمي كيشيكا، سنة ثالثة من فريق الكيندو للإناث

236
00:17:05,460 --> 00:17:09,270
يمكنك أن تجدني دوماً في الدّوجو إذا احتجتني

237
00:17:17,310 --> 00:17:19,030
حقّاً؟

238
00:17:19,030 --> 00:17:22,940
لا عليكِ. يمكنكِ المجيء إليّ في أيّ وقت

239
00:17:23,260 --> 00:17:25,930
يا عزيزتي كيشيكا

240
00:17:25,930 --> 00:17:27,040
...أبي

241
00:17:29,690 --> 00:17:31,950
!خمسة! ستّة

242
00:17:32,320 --> 00:17:35,950
!سبعة! ثمانية! تسعة

243
00:17:35,950 --> 00:17:37,040
!عشرة

244
00:17:37,040 --> 00:17:38,040
!جيّد

245
00:17:38,040 --> 00:17:39,830
ما رأيكِ بذلك يا قائدة؟

246
00:17:40,090 --> 00:17:42,360
أنتِ تُفضّلين يدكِ اليمنى

247
00:17:42,360 --> 00:17:46,730
تذكّري أن تُمسكي بسيفكِ بخنصر
وبنصر يدكِ اليسرى

248
00:17:46,730 --> 00:17:48,430
اليد اليمنى هي للدّعم فقط

249
00:17:48,430 --> 00:17:49,300
!حاضرة

250
00:17:49,300 --> 00:17:51,780
هلّا أسديتِ إليّ بعض النّصائح أيضاً يا قائدة؟

251
00:17:51,780 --> 00:17:53,340
!وأنا من فضلكِ

252
00:17:53,340 --> 00:17:57,610
إنّها القائدة؟ والجميع يحترمونها

253
00:17:57,610 --> 00:18:01,180
لكن هذا منطقيّ. إنّها رائعة حقّاً في نهاية المطاف

254
00:18:01,180 --> 00:18:02,700
!يا قائدة

255
00:18:02,700 --> 00:18:06,190
حسناً، حسناً. سيأتي دوركن جميعاً

256
00:18:09,510 --> 00:18:11,520
آيجو؟ أتيت؟

257
00:18:11,520 --> 00:18:12,700
أ-أجل

258
00:18:20,200 --> 00:18:21,200
!احذري

259
00:18:25,550 --> 00:18:26,210
...لـ

260
00:18:26,210 --> 00:18:27,680
!لا

261
00:18:27,680 --> 00:18:30,340
!تمرنَّ بمُفردكن

262
00:18:30,340 --> 00:18:31,460
!يا قائدة

263
00:18:31,870 --> 00:18:33,240
سينباي؟

264
00:18:34,050 --> 00:18:35,020
ليس ثانية

265
00:18:35,020 --> 00:18:35,970
ثانية؟

266
00:18:35,970 --> 00:18:39,870
المعذرة، هل تعرف القائدة؟

267
00:18:39,870 --> 00:18:40,720
أجل

268
00:18:41,220 --> 00:18:43,880
تتصرّف بهذا الشّكل أحياناً

269
00:18:43,880 --> 00:18:46,850
وكأنّها تصطدم بحدّ من الحدود وتهرب

270
00:18:47,280 --> 00:18:50,860
لكنّها لا تخبرنا أبداً ما مُشكلتها

271
00:18:55,860 --> 00:18:58,360
فعلتُها من جديد

272
00:18:58,360 --> 00:19:02,570
لا بأس. الجميع خطّاؤون

273
00:19:02,570 --> 00:19:04,620
فهذه ليست غلطتكِ يا كيشيكا

274
00:19:04,620 --> 00:19:05,800
...أمّي

275
00:19:04,990 --> 00:19:08,940
أبليتِ حسناً. أنا فخورٌ بكِ يا كيشيكا

276
00:19:06,270 --> 00:19:07,250
سينباي؟

277
00:19:08,940 --> 00:19:13,170
شكراً على كلّ ما تفعلينه. يمكنكِ
تسخير نفسكِ لأمّكِ كما تشائين

278
00:19:13,170 --> 00:19:17,020
لا عليكِ. يمكنكِ المجيء إليّ في أيّ وقت

279
00:19:17,020 --> 00:19:19,180
يا عزيزتي كيشيكا

280
00:19:21,460 --> 00:19:24,460
،أنا آسف للِحاقي بكِ

281
00:19:24,460 --> 00:19:29,310
،لكن إذا كان هناك ما يُزعجكِ
فأردتُ أن أقدّم المُساعدة

282
00:19:29,910 --> 00:19:34,820
لا بُدّ أنّك خائب الأمل بعد رأيتني على حقيقتي

283
00:19:35,570 --> 00:19:38,780
،لا أعمل ما إن كان بسبب كبريائي أو شهامتي

284
00:19:38,780 --> 00:19:41,370
،أو عجزي عن تجاهل شخص محتاج

285
00:19:41,370 --> 00:19:46,210
لكن كانت العائلة والأصدقاء يعتمدون
عليّ منذ طفولتي

286
00:19:47,060 --> 00:19:50,710
لكن في الحقيقة، تمنّيتُ أن أعتمد على أحد أيضاً

287
00:19:51,050 --> 00:19:55,360
أردتُ أن أُدلَّل ويتمّ التملُّق لي

288
00:19:56,240 --> 00:20:02,010
وقد حملتُ تلك الرّغبة عن عمر صغير
وصولاً إلى اليوم الحاضر

289
00:20:02,910 --> 00:20:04,200
وهذه هي النّتيجة

290
00:20:05,000 --> 00:20:09,350
،في سنّ 18، أختبئ عن عائلتي وأصدقائي هنا

291
00:20:09,720 --> 00:20:12,110
،وأستمع إلى تسجيلاتي المُعدَّلة صوتيّاً

292
00:20:12,110 --> 00:20:16,680
وأدع هذا القفّاز المطّاطيّ بشكل مُثير للشّفقة
يتزلّف لي على أساس أنّه أمّي وأبي

293
00:20:17,750 --> 00:20:22,870
ورغبة في عدم انكشاف أمري، أتجنّب
لمس رأسي أمام العامّة

294
00:20:22,870 --> 00:20:27,000
كنتُ في حالة يقظة دائمة لأنّني أعلم بأنّ
...ذلك سينقلني إلى وضع التزلُّف، ومع ذلك

295
00:20:28,000 --> 00:20:29,000
!بئساً

296
00:20:29,000 --> 00:20:30,250
!اقتلني حالاً فحسب

297
00:20:30,540 --> 00:20:34,250
!لطّختُ نفسي! خلّصني من بؤسي

298
00:20:36,950 --> 00:20:41,260
فهمت يا سينباي. تريدين شخصاً تستندين عليه أيضاً

299
00:20:41,530 --> 00:20:45,680
لا أعلم ما إن كنتِ تعتقدين بأنّني
،جيّد بما يكفي لأجل ذلك

300
00:20:46,230 --> 00:20:50,270
لكن إن كنتِ تعتقدين ذلك، فأريدكِ أن تدعيني
أفعل هذا متى احتجتِ

301
00:20:50,270 --> 00:20:53,270
...مـ-مستحيل

302
00:20:53,270 --> 00:20:54,780
!هوااا

303
00:20:54,780 --> 00:20:55,960
!هواااا؟

304
00:20:55,960 --> 00:20:58,440
...آ-آيجو

305
00:20:58,440 --> 00:21:01,030
نعم؟ ما الأمر يا سينباي؟

306
00:21:01,030 --> 00:21:07,290
حقّاً؟ يمكنني الحصول على ربتة رأس؟

307
00:21:05,940 --> 00:21:07,290
!إنّها تبكي

308
00:21:10,310 --> 00:21:11,790
ربت ربت

309
00:21:12,680 --> 00:21:15,370
تاراتارا

310
00:21:16,080 --> 00:21:17,460
ربت ربت

311
00:21:17,460 --> 00:21:20,550
تاراتارا

312
00:21:20,910 --> 00:21:22,080
ربت ربت

313
00:21:22,080 --> 00:21:25,720
تاراتارا

314
00:21:29,670 --> 00:21:30,810
بابا

315
00:21:31,080 --> 00:21:33,310
تحوّلتْ إلى طفل رضيع

316
00:21:34,310 --> 00:21:36,300
أحبّك يا بابا

317
00:21:36,300 --> 00:21:40,450
كُن معي للأبد. كُن بابا

318
00:21:41,270 --> 00:21:44,770
لا أستطيع أن أكون أبيكِ

319
00:21:45,210 --> 00:21:49,700
لكن يمكنني أن أكون معكِ وأدلّلكِ
كُلّ يوم بهذا الشّكل

320
00:21:49,990 --> 00:21:54,670
!كيشيكا-سينباي، أريد أن أكون حبيبكِ

321
00:21:56,710 --> 00:21:59,840
!أحبّك يا بابا

322
00:21:58,750 --> 00:21:59,840
حبيب

323
00:21:59,840 --> 00:22:00,940
...لذا أرجوكِ

324
00:22:00,940 --> 00:22:03,790
ليس بابا؟ إذاً... ماما؟

325
00:22:03,790 --> 00:22:05,970
...حبيب. لذا من فضلكِ

326
00:22:08,220 --> 00:22:13,400
حسناً، في الواقع، هذا بمُناسبة
الأوقات السّعيدة وما إلى هنالك

327
00:22:13,400 --> 00:22:16,090
أنا توروتورو كيشيكا، سنة ثالثة

328
00:22:16,090 --> 00:22:17,480
حـ-حسناً