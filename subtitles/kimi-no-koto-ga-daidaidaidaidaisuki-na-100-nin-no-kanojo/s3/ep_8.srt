1
00:00:10,430 --> 00:00:14,130
ماذا كان ذلك؟ تعويذة دُوار؟

2
00:00:14,130 --> 00:00:19,620
يا إلهي، يحدث خطأ ما في كلّ
يوم عن عمر 89

3
00:00:19,900 --> 00:00:21,750
عمرها 89؟

4
00:00:21,750 --> 00:00:25,250
سررتُ بلقائك يا حبيب كوسوري

5
00:00:25,250 --> 00:00:29,260
...هذه... خليلة روحي الجديدة

6
00:00:29,730 --> 00:00:31,890
جدّة كوسوري-سينباي؟

7
00:00:33,280 --> 00:00:35,510
أنا ياكوزين ياكو، صحيح

8
00:00:35,510 --> 00:00:38,570
!من جديد، العائلة الكوسورويفانيّة

9
00:02:09,500 --> 00:02:10,700
كوسوري-هي

10
00:02:10,700 --> 00:02:15,080
اسم جدّتي جميل. إنّه رائع للغاية

11
00:02:13,470 --> 00:02:15,080
كوسوري-هي

12
00:02:15,080 --> 00:02:16,990
،كما أقول باستمرار

13
00:02:16,990 --> 00:02:21,950
سُمِّيتُ تيمُّناً بشجر الأرزّ ياكوسوغي
الّتي كانت والدة جدّتكِ مُولعة بها

14
00:02:21,950 --> 00:02:24,430
إنّهم مُدمِنون على شجر الأرزّ

15
00:02:22,530 --> 00:02:25,040
تبدوان كتوأمتين فحسب

16
00:02:25,400 --> 00:02:28,540
هل تناولتِ عقّار الخلود أيضاً؟

17
00:02:28,840 --> 00:02:31,750
بالفعل. لهذا أبدو في الثّامنة من عمري

18
00:02:31,750 --> 00:02:35,840
،والّذي تناولتُه كان شبه مُكتمل

19
00:02:35,840 --> 00:02:38,680
ليس حتّى الدّواء العاكس لا يستطيع إلغاءه

20
00:02:39,000 --> 00:02:40,930
ليس وكأنّني أُبالي

21
00:02:40,930 --> 00:02:44,580
السّبب الرّئيسيّ وراء صنع كوسوري
...لعقّار الخلود

22
00:02:44,580 --> 00:02:47,790
هو لأنّني لا أريد رؤية جدّتي الحبيبت تموت

23
00:02:47,790 --> 00:02:49,320
!الحفيدة النّموذجيّة

24
00:02:49,320 --> 00:02:51,400
!جدّتي

25
00:02:52,000 --> 00:02:54,610
أقرّ بأنّه عملٌ ممتاز يا كوسوري

26
00:02:54,610 --> 00:02:56,370
ماذا تقصدين؟

27
00:02:56,370 --> 00:02:59,950
كيف تمكّنتِ من الحصول على رجل
لطيف كهذا؟

28
00:02:59,950 --> 00:03:04,270
أي نعم، رينتارو هو الأفضل في العالم

29
00:03:04,270 --> 00:03:05,460
كوسوري-هي

30
00:03:05,740 --> 00:03:10,590
كم يُعيدني هذا إلى أيّام شبابي

31
00:03:10,590 --> 00:03:14,140
أيُّهما أفضل؟ رينتارو أم جدّي في الجنّة؟

32
00:03:14,140 --> 00:03:18,220
لا أدري. مضى وقت طويل على ذلك

33
00:03:18,700 --> 00:03:22,790
،كان زوجي فحلاً

34
00:03:22,790 --> 00:03:25,080
...لكن رُبّما إذا تمكّنتُ من معرفتك بشكل أفضل

35
00:03:25,080 --> 00:03:25,980
...ماذا؟ المعذرة

36
00:03:25,980 --> 00:03:29,660
ما رأيكِ بالانضمام لعائلة رينتارو يا جدّتي؟

37
00:03:29,660 --> 00:03:31,090
مات جدِّي على أيّ حال

38
00:03:31,090 --> 00:03:32,080
!ماذا؟

39
00:03:32,080 --> 00:03:33,940
عائلة رينتارو؟

40
00:03:33,940 --> 00:03:39,410
هل هذه المجموعة الّتي تشمل آيجو-كن
والحبيبات الّتي ذكرتِها؟

41
00:03:39,410 --> 00:03:40,580
!تماماً، أي نعم

42
00:03:40,580 --> 00:03:41,620
ماذا؟

43
00:03:41,620 --> 00:03:45,270
لا أُمانع ذلك إذاً

44
00:03:45,270 --> 00:03:46,120
ماذا؟

45
00:03:46,120 --> 00:03:49,680
!مرحى! مرحى

46
00:03:47,040 --> 00:03:48,930
بهذه البساطة؟

47
00:03:48,930 --> 00:03:52,110
لِمَ لا نذهب ونتمشّى كأوّل لِقاء رومانسيّ لنا؟

48
00:03:52,110 --> 00:03:54,140
ماذا؟ حـ-حسناً

49
00:03:54,140 --> 00:03:57,260
!كوسوري أيضاً! كوسوري أيضاً

50
00:03:56,150 --> 00:03:57,760
أحقّاً يا كوسوري؟

51
00:03:57,760 --> 00:03:59,010
اقترب الوقت

52
00:03:59,010 --> 00:04:02,510
!لا يهمّ! بينتارو على وشك أن يبدأ

53
00:04:21,280 --> 00:04:23,990
إذاً هل أنتِ كيميائيّة أيضاً؟

54
00:04:23,990 --> 00:04:28,290
بالطّبع، رغم أنّني لا أمتلك معرفة
كوسوري ولا موهبتها

55
00:04:29,230 --> 00:04:30,290
...عندما كنتُ صغيرة

56
00:04:38,550 --> 00:04:41,550
صنعتُ أدويةً طارئة في ساحة المعركة

57
00:04:41,550 --> 00:04:42,870
!في ساحة المعركة؟

58
00:04:45,180 --> 00:04:47,930
حينئذ التقيتُ بجدّ كوسوري

59
00:04:48,360 --> 00:04:53,190
صادفَ وجود وحدته في المنطقة
لإنقاذي عندما كنتُ في مأزق

60
00:04:53,560 --> 00:04:55,630
!كان فحلاً

61
00:04:56,630 --> 00:04:58,400
لـ-لكن لماذا كنتِ هنا؟

62
00:04:59,170 --> 00:05:02,410
يمكن الاحتفاظ ببعض التّفاصيل سرّاً

63
00:05:03,500 --> 00:05:07,910
وجود بعض الأسرار يُضيف جاذبيّة
للمرأة، أليس كذلك؟

64
00:05:09,590 --> 00:05:10,910
ماذا؟

65
00:05:11,180 --> 00:05:13,400
هل تلك الّتي هناك هي أوراق
حبَق الرّاعي؟

66
00:05:13,400 --> 00:05:15,590
لنقطف قليلاً

67
00:05:18,350 --> 00:05:21,180
أنتم الصّغار لا تفعلون هذا كثيراً، صحيح؟

68
00:05:21,180 --> 00:05:24,390
لا. هل هذه لأجل لُفافات كوساموتشي؟

69
00:05:24,390 --> 00:05:29,930
ويمكن استخدامها أيضاً لإعداد
تيمبورا وسلطة وحساء

70
00:05:30,700 --> 00:05:34,110
لم أكن أعلم بأنّ أوراق حبَق الرّاعي
طعام عمليّ هكذا

71
00:05:34,740 --> 00:05:38,650
انظري. هذه كبيرة حقّاً

72
00:05:38,650 --> 00:05:40,940
أجل، نوع مُدهش

73
00:05:41,550 --> 00:05:45,060
لكنّها تتيبّس عندما تصبح كبيرة الحجم

74
00:05:45,060 --> 00:05:49,200
الطّازجة، أو الّتي لها خمسة إلى ستّة
شموس، هي الأشهى

75
00:05:49,200 --> 00:05:53,130
أحقّاً ذلك؟ معلوماتكِ غزيرة

76
00:05:53,130 --> 00:05:57,090
كوسوري-هي. نكتسب المعلومات
مع تقدُّم العمر

77
00:05:57,390 --> 00:06:00,240
كان يجب علينا أكل ما يترتّب
...علينا أكله آنذاك

78
00:06:00,650 --> 00:06:07,920
تسرّني رؤيتك أنت وعزيزتي كوسوري
تنموان في زمن مُزدهر كهذا

79
00:06:08,610 --> 00:06:14,910
لكن يعزو الفضل كُلّه لكِ ولنظرائكِ بجعل
العالم مكاناً أفضل

80
00:06:16,760 --> 00:06:18,860
أجرحت نفسك بورقة؟

81
00:06:19,660 --> 00:06:21,290
أرِني

82
00:06:21,290 --> 00:06:22,000
ماذا؟

83
00:06:23,580 --> 00:06:27,870
أوراق حبَق الرّاعي تُمثّل مرهماً ممتازاً
عندما تُسحَق أيضاً

84
00:06:34,160 --> 00:06:36,000
لحظة، ماذا؟

85
00:06:36,000 --> 00:06:37,380
ما الأمر؟

86
00:06:38,510 --> 00:06:40,380
لا شيء

87
00:06:40,870 --> 00:06:45,630
رُبّما كان لأنّني اعتدتُ رؤية
كوسوري-سينباي يتغيّر حجمها

88
00:06:46,040 --> 00:06:50,390
،والآن تحتاج لمسة أخيرة فحسب
تعويذة تجعلك تشعر بتحسُّن

89
00:06:59,400 --> 00:07:01,940
ما رأيك؟ هل تشعر بأي تحسُّن؟

90
00:07:03,780 --> 00:07:05,570
أجل. شُفيتُ تماماً

91
00:07:06,230 --> 00:07:08,900
كان ذلك سريعاً جدّاً

92
00:07:10,790 --> 00:07:13,580
شكراً لك على وقتك يا آيجو-كن

93
00:07:14,010 --> 00:07:19,640
استمتعتُ كثيراً اليوم. احرص على
مُعاملة كوسوري مُعاملة حسنة

94
00:07:20,340 --> 00:07:24,750
ا-المعذرة، لا شكّ في ذلك

95
00:07:25,210 --> 00:07:29,950
لكن هل أستطيع الحصول على
رقم هاتفكِ أيضاً؟

96
00:07:29,950 --> 00:07:31,210
ماذا؟

97
00:07:31,730 --> 00:07:35,100
المعذرة، أو أي تطبيق مُراسلة على هاتفكِ؟

98
00:07:35,100 --> 00:07:37,410
الحمام الزّاجل؟ بالدُّخان والنّار؟

99
00:07:37,410 --> 00:07:39,980
ما-ماذا؟ هل كنتِ تستخدمين هذه التّطبيقات؟

100
00:07:40,550 --> 00:07:42,230
أتحدّث عن هذا الشّيء

101
00:07:43,050 --> 00:07:48,240
هذا الشّيء الّذي تلعب كوسوري به
دوماً أو تتكلّم معه

102
00:07:44,150 --> 00:07:48,240
!أي نعم. حسناً. أراك غداً

103
00:07:48,950 --> 00:07:49,810
تلك البلاطة؟

104
00:07:49,810 --> 00:07:50,790
!بلاطة؟

105
00:07:51,240 --> 00:07:57,070
أعتذر على تخلُّفي. أنا بائسة
في الأجهزة أو الكلمات الدّخيلة

106
00:07:57,070 --> 00:08:01,500
لا بأس. في هذه الحالة، يمكنني الاتّصال
بهاتفكِ الأرضيّ بدلاً من ذلك

107
00:08:01,500 --> 00:08:05,870
هاتف... أعرف كيفيّة استخدام
...العلبة القصديريّة

108
00:08:05,870 --> 00:08:08,010
انسي الهاتف الأرضيّ، دستُ
!على لغم أرضيّ

109
00:08:08,310 --> 00:08:12,140
إ-إذاً أستطيع إرسال رسائل أو زيارة
منزلكِ من جديد

110
00:08:12,140 --> 00:08:14,520
...انتظر

111
00:08:14,520 --> 00:08:19,770
هل اتّخذتَ ما قلتُه بشأن الانضمام
لعائلة رينتارو بجدّية؟

112
00:08:22,020 --> 00:08:26,630
أعتذر. لم أقصد أن أكون مُضلِّلة

113
00:08:26,630 --> 00:08:29,150
كنتُ أحاول تسلية كوسوري فحسب

114
00:08:29,640 --> 00:08:31,340
سامحني من فضلك

115
00:08:32,920 --> 00:08:35,910
هـ-هل يمكنكِ التّفكير في ذلك الآن؟

116
00:08:36,220 --> 00:08:40,850
من فضلك. عمري 89 وكبيرة جدّاً
على العلاقات الرّومانسيّة

117
00:08:40,850 --> 00:08:46,450
وكبيرة جدّاً بالنّسبة لشابّ مثلك

118
00:08:46,950 --> 00:08:53,560
يجب عليك إيجاد سعادتك مع كوسوري
وفتيات أُخريات في سنّك

119
00:08:53,560 --> 00:08:55,430
فهمتُ الآن

120
00:08:55,940 --> 00:09:01,440
طوال اليوم، كانت تُعاملني كطفل

121
00:09:02,150 --> 00:09:06,600
قد تبدو أصغر بالنّسبة لي، لكنّها
لا ترى نفسها كذلك

122
00:09:06,600 --> 00:09:09,880
لديها عقليّة ونضج شخص بسنّ 89

123
00:09:10,250 --> 00:09:12,950
...بالنّسبة لها، طالب ثانويّة مثلي

124
00:09:13,470 --> 00:09:14,950
هو مُجرّد طفل

125
00:09:15,820 --> 00:09:17,200
كيف؟

126
00:09:17,590 --> 00:09:20,650
ما الّذي يمكنني فعله لجعلها تراني رجلاً؟

127
00:09:24,190 --> 00:09:26,640
هلّا خصّصتِ لي مزيداً من وقتكِ؟

128
00:09:27,590 --> 00:09:33,720
قالت بأنّ زوجها الرّاحل رجلاً حقيقيّاً وفحلاً

129
00:09:34,200 --> 00:09:37,100
...لعلّ ذلك يعني بأنّها مُهتمّة

130
00:09:37,420 --> 00:09:38,560
...بالفتيان الأشقياء

131
00:09:43,380 --> 00:09:44,600
!النّموذجيّين

132
00:09:48,300 --> 00:09:49,760
ماذا أصابك؟

133
00:09:50,110 --> 00:09:52,270
...الجدّ—لا

134
00:09:52,270 --> 00:09:56,560
ياكو...سان، رجاء هل—لنُحدِث جلبة
!في الحديقة بعد ساعات

135
00:09:56,560 --> 00:09:57,620
!ما الّذي يجري؟

136
00:09:57,940 --> 00:10:00,620
ما الّذي يجعل الفتى الشّقيّ شقيّاً؟

137
00:10:00,870 --> 00:10:02,120
!الثِّقة بالنّفس

138
00:10:02,420 --> 00:10:04,630
!اصعدي النوّاسةَ معي

139
00:10:04,970 --> 00:10:09,250
أعتقد بأنّه يريد شخصاً أن يجلس
على الجانب الآخر لأجله

140
00:10:09,610 --> 00:10:11,940
!دعي ساقَي القويّتين تتولّيان هذا الأمر

141
00:10:11,940 --> 00:10:12,880
!قوّة

142
00:10:12,880 --> 00:10:14,260
يسرّني بأنّه مُستمتع

143
00:10:14,510 --> 00:10:15,760
!الحزم

144
00:10:16,320 --> 00:10:18,510
!أختار الأرجوحة الّتي في أقصى اليمين

145
00:10:18,970 --> 00:10:21,520
بكلّ تأكيد. اختر ما تشاء

146
00:10:22,120 --> 00:10:23,020
!سلوك العطاء

147
00:10:23,020 --> 00:10:26,630
،لكن يا ياكو... سان. إذا أردتِها
!فيمكنكِ الحصول عليها

148
00:10:26,630 --> 00:10:29,650
لا أُمانع على أيّ حال

149
00:10:29,900 --> 00:10:31,900
!أسلوب حياة البحث عن التّشويق

150
00:10:32,270 --> 00:10:34,660
!إن سقطتِ، فستُؤكَلين بواسطة القروش

151
00:10:34,660 --> 00:10:37,280
!لكنّني لستُ خائفاً، لذا ها أنا ذا

152
00:10:38,160 --> 00:10:39,530
!شجاعة

153
00:10:40,660 --> 00:10:42,540
ماذا تحاول أن تفعل؟

154
00:10:43,470 --> 00:10:46,920
هل أفعلها بشكل صحيح؟ هكذا هُم
الفتيان الأشقياء، صحيح؟

155
00:10:47,210 --> 00:10:49,170
لا، أعرف ما يكون هذا

156
00:10:49,610 --> 00:10:54,420
أنا مُجرّد فتى يستمتع في الحديقة
!بينما تُراقب جدّتُه

157
00:10:54,800 --> 00:10:59,580
!لا، هذا الجموح المُزيَّف لن يُؤثِّر بها أبداً

158
00:10:59,580 --> 00:11:01,810
...إذا أردتُها تشعر بذرّة حُبّ

159
00:11:05,230 --> 00:11:05,940
!ياكو

160
00:11:06,480 --> 00:11:08,190
!كوني فتاتي

161
00:11:20,500 --> 00:11:23,040
!لا... لا أستطيع فعلها

162
00:11:23,550 --> 00:11:28,790
.لا أستطيع تقبيل امرأة رغماً عن إرادتها
!هذا خاطئ فحسب

163
00:11:29,080 --> 00:11:34,180
لا يمكن أن أكون فتى شقيّاً! لا أملك
!ذرّة جموح في داخلي

164
00:11:47,550 --> 00:11:52,150
هل اعتقدتَ بأنّني سأبدأ باتِّخاذك على محمل
الجدّ إذا تصرّفتَ مثله؟

165
00:11:53,550 --> 00:11:55,400
أنت جاهلٌ جدّاً

166
00:11:55,400 --> 00:12:00,470
أحببتُ ذكراً رجوليّاً بالفعل، لذا
...إذا كنتُ سأفعلها من جديد

167
00:12:00,970 --> 00:12:04,910
فمن الواضح أنّني أريد تجربة
نوع مُختلف من الحُبّ

168
00:12:05,960 --> 00:12:10,020
حـ-حسناً، لكن لِمَ تغيير رأيكِ هذا؟

169
00:12:10,020 --> 00:12:11,420
لماذا، بالفعل؟

170
00:12:11,690 --> 00:12:14,980
رُبّما وجدتُ مُحاولاتك المُستميتة مُحبَّبة

171
00:12:14,980 --> 00:12:18,930
أو رُبّما وجدتُ شغفَك رجوليّاً

172
00:12:18,930 --> 00:12:24,500
على أيّ حال، لا تحاول أن تفهمني بينما
عشتُ فترة أطول بكثير

173
00:12:24,500 --> 00:12:28,020
اعتبرها نزوات مُتقلِّبة لقلب سيِّدة

174
00:12:31,540 --> 00:12:37,570
قُم بمُجاراة هذه العجوز اللّعوب في عدم
تصرّفها بما يُلائم سنّها، اتّفقنا؟

175
00:12:37,570 --> 00:12:41,540
—أُجاريكِ؟ أنا جادّ

176
00:12:41,540 --> 00:12:42,570
،في هذه الحالة

177
00:12:43,130 --> 00:12:46,700
آمل أن تجعلني جادّة أيضاً يوماً ما

178
00:12:47,130 --> 00:12:49,160
سأنتظر هذا اليوم بلهفة

179
00:12:51,330 --> 00:12:53,850
سوف... أبذل قصارى جهدي

180
00:12:53,850 --> 00:12:55,430
كوسوري-هي

181
00:12:57,130 --> 00:12:59,340
وهذا ما حدث

182
00:12:59,710 --> 00:13:05,350
هلّا حصلتُ على إذنكن للتّرحيب بياكوزين
ياكو-سان كأحدث خليلة لي؟

183
00:13:05,650 --> 00:13:08,540
قد لا أبدو كذلك، لكن عمري 89

184
00:13:09,480 --> 00:13:11,240
!كـ-كاراني-سان

185
00:13:11,240 --> 00:13:13,540
!الّذين أعمارهم 89 أحياء أيضاً

186
00:13:15,360 --> 00:13:18,200
إنّها جدّة كوسوري المحبوبة، أي نعم

187
00:13:18,200 --> 00:13:19,050
أجل، صحيح

188
00:13:19,050 --> 00:13:20,320
!جدّة خليلة؟

189
00:13:21,180 --> 00:13:23,700
قد تكون هذه إشكاليّة أخلاقيّة

190
00:13:23,700 --> 00:13:24,950
!لا داعي لتتكلّمي

191
00:13:24,950 --> 00:13:27,540
لماذا هي في المدرسة إذا لم تكن تلميذة؟

192
00:13:27,540 --> 00:13:30,080
منحتُها الإذن بالزّيارة

193
00:13:30,080 --> 00:13:34,140
!ظريفة مثلكِ مُرحَّب بها دوماً هنا

194
00:13:34,140 --> 00:13:36,090
!مواه، مواه

195
00:13:38,210 --> 00:13:41,460
!أرجوكِ سامحيني على وقاحتي

196
00:13:41,460 --> 00:13:43,470
لا ألومكِ، نظراً إلى شكلي

197
00:13:43,780 --> 00:13:48,270
أنا مُتقاعِدة ولا شيء أفعله، لذا
يمكنني المجيء والزّيارة في أيّ وقت

198
00:13:48,270 --> 00:13:50,230
،لكن بهذا العنفوان الّذي بلغتُه حديثاً

199
00:13:50,230 --> 00:13:53,000
قد أعيش لـ 80 عام آخر

200
00:13:55,110 --> 00:13:56,980
اسمحي لكوسوري بأن تعرّفكِ

201
00:13:56,980 --> 00:14:01,860
الجميع في عائلة رينتارو هم أعزّ
!أصدقاء لكوسوري

202
00:14:01,860 --> 00:14:03,370
أحقّاً ذلك؟

203
00:14:05,370 --> 00:14:06,940
لستُما صديقتين؟

204
00:14:06,940 --> 00:14:09,080
لسنا صديقتين؟

205
00:14:14,370 --> 00:14:16,640
!كاراني

206
00:14:18,630 --> 00:14:24,630
.شكراً لكُن على صداقتكن مع كوسوري
تفضّلن، سأعطيكن بعضاً من السّكاكر

207
00:14:24,630 --> 00:14:26,780
...جدّة مُوقَّرة

208
00:14:26,940 --> 00:14:29,130
شكراً

209
00:14:29,130 --> 00:14:30,390
هذا لذيذ

210
00:14:30,740 --> 00:14:32,740
تعالي وخذي واحدة أيضاً

211
00:14:32,740 --> 00:14:34,900
لـ-لا، أرفُض ذلك

212
00:14:34,900 --> 00:14:36,560
فأنا بالغة

213
00:14:37,490 --> 00:14:39,650
حسناً، تناولتُ السُّكَّر، السُّكَّر

214
00:14:39,940 --> 00:14:44,910
مهلكِ. من وجهة نظري، أنتِ
واحدة من الفتيات بحدّ ذاتكِ

215
00:14:45,220 --> 00:14:47,160
...الجدّة المُوقَّرة

216
00:14:48,910 --> 00:14:50,550
ما الّذي يجري؟

217
00:14:51,290 --> 00:14:56,270
المعذرة. أراني رينتارو صوركن
،في البلاطة الخاصّة به

218
00:14:56,270 --> 00:14:58,920
لكن لم أستطع تمييز كُلّ واحدة
منكن جميعاً بعد

219
00:14:58,920 --> 00:15:02,620
هذا لأنّ عددنا كبير

220
00:15:02,620 --> 00:15:04,670
هاتف، لا بلاطة

221
00:15:04,950 --> 00:15:08,930
!إذاً ستعطيكِ كوسوري مُقدِّمة مُختصرة

222
00:15:09,430 --> 00:15:11,500
إنّها خجولة

223
00:15:11,500 --> 00:15:13,110
إنّها تسونديري

224
00:15:13,110 --> 00:15:15,800
تريد أن تكون الأجمل في العالم

225
00:15:15,800 --> 00:15:17,680
إنّها ذكيّةٌ جدّاً

226
00:15:17,680 --> 00:15:19,480
إنّها الخادمة العُظمى

227
00:15:19,480 --> 00:15:21,690
إنّها تبكي بلا نظّارة

228
00:15:21,690 --> 00:15:23,660
تعصر الصُّدور وما شابه

229
00:15:23,660 --> 00:15:26,460
إمّا تأكل  أو تغضب

230
00:15:26,460 --> 00:15:27,960
إنّها مازوخيّة للغاية

231
00:15:27,960 --> 00:15:29,600
إنّها بذيئة جدّاً

232
00:15:29,600 --> 00:15:31,490
إنّها ضخمة وقويّة

233
00:15:31,490 --> 00:15:33,440
إنّها ضئيلة وضعيفة

234
00:15:33,440 --> 00:15:35,340
إنّها مهووسة بـ يو.أس.أي

235
00:15:35,340 --> 00:15:37,710
إنّها مسخ بصدر ضخم

236
00:15:39,380 --> 00:15:41,830
!من هو المسخ بصدر ضخم؟

237
00:15:41,830 --> 00:15:42,420
أنتِ

238
00:15:42,420 --> 00:15:44,170
!من هي البذيئة جدّاً؟

239
00:15:44,840 --> 00:15:48,070
!هذه أنا، المهووسة بـ يو.أس.أي

240
00:15:48,070 --> 00:15:51,170
"...قد أكون ضئيلة وضعيفة، لكن"

241
00:15:51,170 --> 00:15:53,980
هذه ليست إهانة. الرُّضّع والحيوانات
الصّغيرة هُم كذلك أيضاً

242
00:15:53,980 --> 00:15:55,180
!عصر

243
00:15:56,350 --> 00:16:01,230
كُلّ ما أنا عبارة عن خادمة عاديّة
وهبتْ حياتها لهاهاري-ساما

244
00:16:01,230 --> 00:16:04,450
الخادمات العاديّات لا يهِبنَ حياتهن

245
00:16:04,450 --> 00:16:07,630
كوسوري-سينباي، لستُ مازوخيّة أيضاً

246
00:16:07,630 --> 00:16:09,490
لا تعرفين ذلك أيضاً؟

247
00:16:09,880 --> 00:16:11,260
هل فهمتِ كُلّ ذلك؟

248
00:16:11,260 --> 00:16:13,740
أجل...  على ما أعتقد

249
00:16:13,740 --> 00:16:17,450
حسناً إذاً. أيّ فتاة هي إيكو؟

250
00:16:17,930 --> 00:16:19,370
...المعذرة

251
00:16:19,370 --> 00:16:21,020
...حسبما أذكر

252
00:16:21,020 --> 00:16:22,990
ضئيلة وضعيفة؟

253
00:16:22,990 --> 00:16:25,630
!لا! إنّها وحش عقليّ وجسديّ

254
00:16:25,980 --> 00:16:29,010
اصفعيني، وسترين. أستطيع تحمُّل ذلك

255
00:16:29,410 --> 00:16:31,310
ماذا عن هاهاري؟

256
00:16:31,310 --> 00:16:32,390
...المعذرة

257
00:16:33,190 --> 00:16:34,620
الخادمة العُظمى؟

258
00:16:34,620 --> 00:16:35,200
مُذهل

259
00:16:35,200 --> 00:16:37,390
!مع الأسف، إنّها ربّة العمل

260
00:16:37,820 --> 00:16:39,300
مع الأسف"؟"

261
00:16:40,080 --> 00:16:43,020
ماذا يعني "خادمة" بالمُناسبة؟

262
00:16:43,020 --> 00:16:43,900
علينا البدء من هناك؟

263
00:16:44,230 --> 00:16:46,860
تذكّرتُ الآن

264
00:16:46,860 --> 00:16:49,360
شخص تعرّض لإعاقة جسديّة؟

265
00:16:49,650 --> 00:16:50,350
...خا

266
00:16:50,350 --> 00:16:52,160
"هذا شخص "خامل

267
00:16:52,160 --> 00:16:55,160
ماذا عن ابنتها، هاكاري؟

268
00:16:55,160 --> 00:16:56,620
...لنرَ

269
00:16:57,100 --> 00:16:58,940
المهووسة بـ يو.أس.أي؟

270
00:16:59,750 --> 00:17:02,590
!أنا حُرّيّة

271
00:17:02,590 --> 00:17:04,290
للحُرّيّة حدود، مفهوم؟

272
00:17:04,290 --> 00:17:06,940
هل سيكون التحفُّظ قليلاً أكثر إغراء؟

273
00:17:04,790 --> 00:17:07,700
بالمُناسبة، ماذا يعني "يو.أس.أي"؟

274
00:17:07,700 --> 00:17:08,800
لا تعرفين هذا أيضاً

275
00:17:09,800 --> 00:17:10,920
أمريكا. بلاد البرغر

276
00:17:10,920 --> 00:17:13,020
هذا ما تعنيه؟

277
00:17:13,020 --> 00:17:15,810
إذاً هي لا تعرف الكلمات الدّخيلة
أو الاختصارات؟

278
00:17:15,810 --> 00:17:18,220
ماذا عن موميجي؟

279
00:17:18,220 --> 00:17:19,430
...المعذرة

280
00:17:21,780 --> 00:17:23,570
خجولة؟

281
00:17:24,020 --> 00:17:25,940
!نتمنّى لو أنّها كانت كذلك

282
00:17:25,940 --> 00:17:32,570
كورومي-سان، هلّا سمحتِ لي
بمُداعبة صدركِ النّامي؟

283
00:17:32,570 --> 00:17:33,700
اخرسي

284
00:17:34,050 --> 00:17:35,830
ماذا عن ميميمي؟

285
00:17:34,610 --> 00:17:36,540
سأمنحكِ صدراً تبكين عليه

286
00:17:35,830 --> 00:17:37,290
...في الواقع

287
00:17:37,560 --> 00:17:40,100
إمّا تأكل أو تغضب؟

288
00:17:37,920 --> 00:17:40,560
بالفعل

289
00:17:40,100 --> 00:17:42,380
!كومبو مُميت للجمال

290
00:17:42,380 --> 00:17:45,380
هل تقصدين بأنّني قبيحة؟

291
00:17:46,840 --> 00:17:51,280
ما الّذي تقولينه؟ أنتِ جميلة
!حتّى بشهيّتكِ وأسلوب حياتكِ

292
00:17:51,280 --> 00:17:54,220
كيف تُحافظين عليه؟ أتمنّى
!أن تخبريني بأسراركِ

293
00:17:54,220 --> 00:17:56,050
!لعِبَتْ بالبطاقة العكسيّة

294
00:17:56,420 --> 00:17:57,880
عمليّة الأيض؟

295
00:17:56,770 --> 00:17:58,280
ماذا عن نادّي إذاً؟

296
00:17:57,880 --> 00:17:59,930
!عضلات قويّة

297
00:17:58,280 --> 00:17:59,930
إنّه أنا

298
00:18:00,210 --> 00:18:01,940
ذكيّة؟

299
00:18:00,610 --> 00:18:01,940
"...في الرّبيع، الفجر"

300
00:18:04,150 --> 00:18:05,940
!رأسي ب-خير

301
00:18:06,230 --> 00:18:09,780
أيضاً، نادّي هو كنيتي في الواقع

302
00:18:09,780 --> 00:18:11,950
يبدو غربيّاً، لكنّني حفظتُه

303
00:18:12,300 --> 00:18:13,720
نادي-تشان، صحيح؟

304
00:18:13,720 --> 00:18:16,220
أوه... إنّه نادّي

305
00:18:16,220 --> 00:18:17,140
ناديـه؟

306
00:18:17,140 --> 00:18:23,740
!نادّي

307
00:18:18,580 --> 00:18:22,940
ناديـه

308
00:18:23,740 --> 00:18:24,830
...ناديـه

309
00:18:24,830 --> 00:18:28,340
!حسناً، افعلي ما تشائين
!جميعنا أحرار هنا

310
00:18:28,340 --> 00:18:30,050
ماذا عن كورومي؟

311
00:18:30,050 --> 00:18:31,340
...في الحقيقة

312
00:18:31,340 --> 00:18:33,540
تبكي بلا نظّارة؟

313
00:18:34,290 --> 00:18:37,580
"بطنها يبكي من دون قُبّعتها، رُبّما"

314
00:18:37,580 --> 00:18:38,850
"...لأوقات كهذه"

315
00:18:38,850 --> 00:18:42,600
"!اطمئنّي، انظري! أحضرتُ لكِ بسكويتاً"

316
00:18:43,850 --> 00:18:46,960
"يمكنكِ البُكاء بين ذِراعَي، يا آنسة"

317
00:18:50,210 --> 00:18:51,860
ماذا عن مي؟

318
00:18:51,860 --> 00:18:52,860
...في الواقع

319
00:18:52,860 --> 00:18:55,040
تعصر الأثداء وما شابه؟

320
00:18:55,040 --> 00:18:57,370
!مُحال أن تفعل مي-سان ذلك

321
00:18:57,370 --> 00:18:58,950
ما لم تُؤمَر بذلك

322
00:18:58,950 --> 00:19:00,990
!هذا ما أستحقّه لمُساندتي لها

323
00:19:00,990 --> 00:19:03,740
فكرة سديدة

324
00:19:03,740 --> 00:19:05,120
لا تفعلي رجاء

325
00:19:05,120 --> 00:19:06,760
ماذا عن يامامي؟

326
00:19:06,760 --> 00:19:07,880
...المعذرة

327
00:19:07,880 --> 00:19:08,940
تسونديري؟

328
00:19:08,940 --> 00:19:10,750
!يستميت النّاس على ذلك

329
00:19:10,750 --> 00:19:15,370
...يسرّني أنّني لستُ تسونديري

330
00:19:15,370 --> 00:19:17,760
لا بأس يا يامامي. أستطيع تقبُّل ذلك

331
00:19:18,770 --> 00:19:21,440
إيكو-سان... النّاس ليسوا خالدين

332
00:19:21,440 --> 00:19:22,140
ماذا؟

333
00:19:22,140 --> 00:19:24,520
حسناً، ماذا عن نانو؟

334
00:19:24,520 --> 00:19:25,640
...في الواقع

335
00:19:26,020 --> 00:19:28,290
تريد أن تكون الأجمل في العالم؟

336
00:19:28,290 --> 00:19:31,400
!ستُعميني إذا أصبحتْ أكثر إبهاراً

337
00:19:31,860 --> 00:19:35,150
أوتسوكوشيسوغي ميميمي، يبدو
وكأنّكِ تمزحين

338
00:19:35,600 --> 00:19:37,000
ماذا عن تشيو؟

339
00:19:37,000 --> 00:19:38,200
...المعذرة

340
00:19:41,270 --> 00:19:42,450
مازوخيّة للغاية؟

341
00:19:43,520 --> 00:19:45,460
!مُباشرة نحو قاعة الانحلال الأخلاقيّ

342
00:19:45,460 --> 00:19:47,960
لا يمكننا تصويرها بهذا الشّكل

343
00:19:47,960 --> 00:19:50,880
إنّها ليست مثل أمّي أو إيكو-سان

344
00:19:50,880 --> 00:19:53,280
ماذا تعتقديننا بالضّبط؟

345
00:19:57,510 --> 00:20:01,350
!قلب تشيو لوليتا الهائج على وشك أن ينفجر

346
00:20:01,350 --> 00:20:03,630
من الأفضل أن نُقيّدها قبل أن
!تخرج عن السّيطرة

347
00:20:03,630 --> 00:20:05,230
!لا تُقيّدوها

348
00:20:05,230 --> 00:20:06,950
ماذا عن ميمي؟

349
00:20:06,950 --> 00:20:08,100
...المعذرة

350
00:20:08,520 --> 00:20:10,190
بذيئة جدّاً؟

351
00:20:10,190 --> 00:20:12,110
!جسدها فقط

352
00:20:12,110 --> 00:20:14,020
هذا غير صحيح

353
00:20:14,020 --> 00:20:15,380
!موميجي-سان

354
00:20:15,380 --> 00:20:19,240
كوسوري-سان، جسد ميمي-سان
ليس بذيئًاً

355
00:20:19,670 --> 00:20:27,250
قد يكون صدرها ضخماً، بمُنحنيات جميلة
،وملمس سماويّ

356
00:20:27,250 --> 00:20:29,350
!"لكنّه ليس "بذيئاً

357
00:20:29,350 --> 00:20:30,630
!موميجي-سان؟

358
00:20:30,630 --> 00:20:32,950
آسفة بشأن ذلك

359
00:20:32,950 --> 00:20:38,100
قد يكون صدركِ ضخماً ومُقسَّماً
...وطريّاً وجميلاً

360
00:20:35,560 --> 00:20:38,510
حسناً، حسناً! هل يمكننا التوقُّف
!عن الحديث حول هذا؟

361
00:20:38,830 --> 00:20:42,890
بالفعل! وميمي-سان جميلة إلى
!درجة تُذهل العقول

362
00:20:41,170 --> 00:20:43,280
!ميميمي-سينباي

363
00:20:43,280 --> 00:20:44,910
ماذا عن شيزوكا؟

364
00:20:44,910 --> 00:20:47,640
المعذرة، ماذا بقي؟

365
00:20:48,270 --> 00:20:50,400
ضخمة وقويّة؟

366
00:20:48,270 --> 00:20:52,400
لماذا يحدث هذا؟

367
00:20:52,400 --> 00:20:55,900
شيزوكا الخاطئة! تلك مُقتبسة من
!ليتل ستار وورز الخاصّة بنوبيتا

368
00:20:55,900 --> 00:20:58,860
!أفسحوا المجال لشيزوكا-سان العملاقة

369
00:20:58,860 --> 00:21:00,440
"انحنوا لي أيّها العَوام"

370
00:21:00,780 --> 00:21:02,260
!مولاتي

371
00:21:02,260 --> 00:21:03,390
"!كنتُ أمزح"

372
00:21:03,780 --> 00:21:05,690
ماذا عن كاراني؟

373
00:21:05,690 --> 00:21:09,040
أقصد، لم يبقَ سوى واحدة

374
00:21:10,290 --> 00:21:12,460
المسخ ذات الصّدر الضّخم؟

375
00:21:12,460 --> 00:21:14,290
!تحتاجين نظّارة يا جدّة

376
00:21:15,150 --> 00:21:17,490
حفظَتْهن في نهاية المطاف

377
00:21:17,800 --> 00:21:20,880
...الأضخم هي يامامي

378
00:21:20,880 --> 00:21:22,010
!تلك هي أنا

379
00:21:22,010 --> 00:21:25,140
والأكثر صخباً هي... كاراني؟

380
00:21:26,560 --> 00:21:28,400
كنتُ على حقّ. كانت كاراني

381
00:21:29,770 --> 00:21:31,500
أنا مُرهَقة تماماً

382
00:21:31,500 --> 00:21:32,770
أحسنتِ صنعاً

383
00:21:32,770 --> 00:21:36,390
بالمُناسبة، هل تتذكّرنَ جميعاً اسم الجدّة؟

384
00:21:36,390 --> 00:21:37,100
ماذا؟

385
00:21:37,100 --> 00:21:37,930
أجل

386
00:21:37,930 --> 00:21:39,620
بكلّ تأكيد

387
00:21:39,620 --> 00:21:40,790
إنّه في ذاكرتي

388
00:21:41,400 --> 00:21:43,340
ما-ماذا كان؟

389
00:21:46,170 --> 00:21:49,030
كوسوري لوليتا قالت "جدّتي" فقط أيضاً

390
00:21:49,030 --> 00:21:51,540
أعتقد كان من أربعة أحرف، صحيح؟

391
00:21:51,540 --> 00:21:55,000
أعتقد كان بالكاتاكانيّة، مثل اسم جدّتي

392
00:21:55,000 --> 00:21:57,550
كان مُرتبطاً بالعقاقير بطريقة ما

393
00:22:00,260 --> 00:22:01,790
...أربعة أحرف

394
00:22:01,790 --> 00:22:02,840
...كاتاكانا

395
00:22:02,840 --> 00:22:03,850
...عقاقير

396
00:22:03,850 --> 00:22:05,470
...المعذرة

397
00:22:05,470 --> 00:22:07,170
...ياكوزين

398
00:22:13,180 --> 00:22:14,310
!جاهزات؟ هيّا

399
00:22:14,310 --> 00:22:15,310
!ميثا

400
00:22:15,740 --> 00:22:17,390
إنّه ياكو