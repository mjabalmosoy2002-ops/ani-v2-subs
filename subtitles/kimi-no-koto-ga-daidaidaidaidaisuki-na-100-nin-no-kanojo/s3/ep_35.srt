177
00:12:42,990 --> 00:12:47,200
أنا لا أستطيع النّظر إليكِ كتلميذة ثانويّة

178
00:12:47,520 --> 00:12:49,210
نحن مُتشابهان من هذه النّاحية

179
00:12:50,390 --> 00:12:52,960
إنّه الفتى الأظرف في العالم

180
00:12:53,300 --> 00:12:56,680
هـ... هاهاري-سان؟

181
00:13:22,540 --> 00:13:23,640
شيزوكا

182
00:13:32,030 --> 00:13:32,870
ماذا؟

183
00:13:33,370 --> 00:13:35,000
...هاتفك

184
00:13:36,890 --> 00:13:38,130
انكسر؟

185
00:13:38,850 --> 00:13:41,630
يحتاج وقتاً لإصلاحه

186
00:13:41,630 --> 00:13:46,090
إذا أردتِ بلاطةً جديدة، فأستطيع تعريفكِ
على حدّاد موهوب

187
00:13:46,090 --> 00:13:50,050
أيّ مُغامرة عظيمة تحاولين إرسال
شيزوكا-سينباي إليها؟

188
00:13:50,050 --> 00:13:52,640
لكن هذه حرّية التّعبير على الوضع الصّعب

189
00:13:53,910 --> 00:13:57,420
يمكنك تمثيل ما تريدين قوله؟

190
00:13:57,420 --> 00:14:00,030
حسناً، ماذا شاهدتِ في التّلفزيون
في اللّيلة الماضية؟

191
00:14:05,350 --> 00:14:06,660
طائر؟

192
00:14:10,660 --> 00:14:11,700
بطريق؟

193
00:14:11,700 --> 00:14:14,270
!عرفت! بينتارو

194
00:14:14,270 --> 00:14:15,920
!جرعة ظرافة قاتلة

195
00:14:20,110 --> 00:14:22,140
شاهدتِ غيبلي أيضاً، أي نعم؟

196
00:14:22,140 --> 00:14:24,430
!شيزوكا أواي؟

197
00:14:32,450 --> 00:14:33,870
يوشيموتو شيزوكا

198
00:14:35,020 --> 00:14:35,690
...اليوم

199
00:14:36,140 --> 00:14:38,900
سنكتب الواجب المدرسيّ في منزلي
،ثمّ نخرج للتنزُّه

200
00:14:38,900 --> 00:14:41,690
لكن يمكننا تغيير الموعد إذا
كان هذا لا يلائمكِ

201
00:14:44,970 --> 00:14:46,950
هكذا إذاً. حسناً

202
00:14:49,250 --> 00:14:50,950
هذه هي غرفتي

203
00:15:01,870 --> 00:15:02,710
صحيح

204
00:15:03,080 --> 00:15:06,720
هذه صورة لآيجو رينتارو وأنا
في مُواعدتنا الأولى

205
00:15:12,520 --> 00:15:13,730
...صديقتي

206
00:15:14,280 --> 00:15:16,980
يوشيموتو شيزوكا في غرفتي

207
00:15:17,880 --> 00:15:19,600
هذا إحساسٌ غريب

208
00:15:29,750 --> 00:15:35,500
،أجل. في البداية نحسب قيمة س
ثمّ نستخدم الصّيغة

209
00:15:59,580 --> 00:16:03,270
ما الّذي تشعر به الشّخصيّة
الرّئيسيّة في هذا المشهد؟

210
00:16:06,540 --> 00:16:07,690
هكذا إذاً

211
00:16:08,710 --> 00:16:09,530
شكراً لكِ

212
00:16:12,850 --> 00:16:16,040
"إذاً إنّه يشعر بـ"ظرافة غير مُتناهية

213
00:16:16,580 --> 00:16:19,700
لكن لماذا؟ هذا هو عدوّه اللّدود

214
00:16:20,820 --> 00:16:23,680
مشاعر البشر مُعقّدة حقّاً

215
00:16:33,640 --> 00:16:34,930
هذا غير فعّال

216
00:16:35,550 --> 00:16:38,200
لا أستطيع... تحمُّل ذلك

217
00:16:42,570 --> 00:16:44,080
يوشيموتو شيزوكا

218
00:16:46,090 --> 00:16:47,160
...تعالي معي

219
00:16:49,490 --> 00:16:51,410
ولنستحمّ

220
00:17:01,960 --> 00:17:05,920
يمكنكِ استخدام هاتفي للتّواصل

221
00:17:06,710 --> 00:17:09,680
شغّلتُ النصّ إلى كلام، لذا اكتبي فحسب

222
00:17:16,450 --> 00:17:19,710
لماذا. نحن. في. الحمّام؟

223
00:17:21,070 --> 00:17:24,760
تشعر الكائنات البشريّة بالتحرُّر عندما
في حالة التعرّي

224
00:17:24,760 --> 00:17:26,940
تجد سهولة أكبر في الكشف عن أفكارها

225
00:17:27,230 --> 00:17:30,700
"هذا ما يُطلقون عليه بـ"التّعرية

226
00:17:33,860 --> 00:17:35,200
يوشيموتو شيزوكا

227
00:17:36,620 --> 00:17:38,830
هل تُخفين شيئاً؟

228
00:17:41,410 --> 00:17:48,340
،هذا هو الإحساس الّذي يُراودني
رغم أنّني لا أستطيع وصفه بكلمات

229
00:17:48,910 --> 00:17:55,100
أنتِ مُختلفة ميلّيمتر... لا بل نانوميتر
عن ذاتكِ المعتادة

230
00:17:55,610 --> 00:17:59,060
أعتقد بأنّ آيجو رينتارو لاحظ هذا أيضاً

231
00:17:59,060 --> 00:18:03,300
،اختار احترام قراركِ بإخفاء الأمر

232
00:18:03,900 --> 00:18:09,540
لكن في نظري، يبدو أنّكِ تتألّمين الآن

233
00:18:10,420 --> 00:18:11,870
،إن كان ذلك مُمكناً

234
00:18:12,360 --> 00:18:14,130
أريد مُساعدتكِ

235
00:18:18,550 --> 00:18:20,640
ال. حقيقة

236
00:18:25,040 --> 00:18:26,000
شيزوكا

237
00:18:28,730 --> 00:18:30,460
أعطيني هاتفكِ

238
00:18:31,760 --> 00:18:34,390
أخبرني الجيران

239
00:18:35,030 --> 00:18:39,010
يبدو أنّكِ انتقلتِ من الكُتُب وبدأتِ
تستخدمين هاتفكِ للكلام

240
00:18:40,530 --> 00:18:46,040
وأنا هنا الّتي تأمّلتُ أن تبدئي بالكلام
إذا وجدتِ أشخاصاً تتّصلين بهم

241
00:18:46,640 --> 00:18:51,880
.لكن كُلّ ما تفعلينه هو القراءة، على أيّ حال
أخطأتُ بإعطائكِ هذا الشّيء

242
00:18:52,540 --> 00:18:56,280
،سأذهب لإلغاء العقد حالاً
لذا أعطيني هاتفكِ

243
00:19:01,020 --> 00:19:05,740
،لـ-لـ-لمُساعدتي فـ-في التكلُّم مع النّاس

244
00:19:05,740 --> 00:19:15,800
كـ-كـ-كتبَ رينتارو-كن الكثير
...من الكُتُب على ذلك الهاتف

245
00:19:15,800 --> 00:19:21,560
...كـ-كيف أ-أخبره بهذا الأمر

246
00:19:22,240 --> 00:19:24,310
لا بأس. فهمت

247
00:19:25,260 --> 00:19:28,340
لكن يجدر بنا التحدُّث مع آيجو
رينتارو حول الأمر

248
00:19:29,910 --> 00:19:33,700
ستكون الطّريقة الأكثر كفاءة
،لتخفيف همومكِ

249
00:19:33,700 --> 00:19:35,600
وأعتقد بأنّها الطّريقة الوحيدة للقيام بذلك

250
00:19:36,080 --> 00:19:39,600
،أعلم بأنّكِ قد تجدين ذلك مُرعباً

251
00:19:40,750 --> 00:19:44,700
لكن ألا يكفي أن أكون هنا معكِ؟

252
00:19:53,180 --> 00:19:53,980
مرحباً؟

253
00:19:54,550 --> 00:19:59,090
مرحباً يا آيجو رينتارو؟ هلّا
أتيت إلى منزلي حالاً؟

254
00:20:00,660 --> 00:20:02,870
سأسارع إليكِ ولو كنتُ في وسط
عمليّة جراحيّة

255
00:20:03,220 --> 00:20:05,630
لا تأتِ إذا كنتَ تخضع لعمليّة جراحيّة

256
00:20:23,690 --> 00:20:24,710
هكذا إذاً

257
00:20:25,220 --> 00:20:28,160
شكراً لكِ على إخباري يا شيزوكا-تشان

258
00:20:28,940 --> 00:20:32,790
هل يمكنني الذّهاب لمُقابلة أمّكِ؟

259
00:20:36,980 --> 00:20:42,330
أعدكِ بألّا يحدث شيء قد يؤذيكِ

260
00:20:50,470 --> 00:20:51,810
ماذا ستفعلين يا نانو؟

261
00:20:54,720 --> 00:20:57,780
التّواصل معها كمجموعة سيجعلها
،تتّخذ موقفاً دفاعيّاً

262
00:20:57,780 --> 00:21:00,760
وأنا لستُ ماهرة في التّواصل
الشّفهيّ والسّلوك الاجتماعيّ

263
00:21:00,760 --> 00:21:03,130
ستكون أفضل حالاً من دوني

264
00:21:03,900 --> 00:21:05,080
حسناً

265
00:21:10,370 --> 00:21:11,830
إذاً، أراكِ بعد قليل

266
00:21:12,390 --> 00:21:14,840
ساعدها أرجوك يا آيجو رينتارو

267
00:21:31,900 --> 00:21:36,110
!شـ-شـ-شـ... شكراً لكِ

268
00:21:41,130 --> 00:21:44,050
أتمنّى لك التّوفيق يا يوشيموتو شيزوكا

269
00:21:54,380 --> 00:21:55,530
شيزوكا؟

270
00:21:56,580 --> 00:21:58,330
من هذا الّذي معكِ؟

271
00:22:01,470 --> 00:22:04,790
!لا صعقة

272
00:22:04,790 --> 00:22:09,220
يا للهول! كنتُ أخشى أن نشهد
خليلة أمّ ثانية

273
00:22:10,180 --> 00:22:14,070
في الواقع، لعلّ هذا سهّلَ الأمر، صحيح؟

274
00:22:14,560 --> 00:22:16,950
ماذا ستفعل يا رينتارو؟

275
00:22:16,950 --> 00:22:19,440
!هل يمكنك إنقاذ شيزوكا من هذه الفوضى؟