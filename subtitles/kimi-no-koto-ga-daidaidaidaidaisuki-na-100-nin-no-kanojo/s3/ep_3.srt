168
00:12:20,470 --> 00:12:26,200
وهكذا، جلسنَ لتأمُّل كيف ستكون أشكالهن
في أكثر مستوى حرّية لهُن

169
00:12:26,850 --> 00:12:27,820
انتهيت

170
00:12:30,310 --> 00:12:33,820
!لنرَ ما تُسمّينه بالحرّية أيّتها الفتاة إياي

171
00:12:39,320 --> 00:12:40,730
!ممنوع

172
00:12:40,730 --> 00:12:41,950
!استناداً إلى ماذا؟

173
00:12:41,950 --> 00:12:44,980
!هذا تقليديّ جدّاً! لا حرّية

174
00:12:45,990 --> 00:12:47,540
أنا التّالية

175
00:12:47,540 --> 00:12:51,890
!ممنوع

176
00:12:51,890 --> 00:12:53,500
ماذا عنكم جميعاً؟

177
00:12:53,500 --> 00:12:57,070
تُحبّني الفتيات كما أنا، لذا
أُفضّل أن أبقى هكذا

178
00:12:57,070 --> 00:13:00,080
خصّصتْ لي هاهاري-ساما زيّ الخادمة هذا

179
00:13:00,080 --> 00:13:02,500
هذه الملابس تُعظّم مُستوى التخفِّي لديّ

180
00:13:02,500 --> 00:13:03,600
!لا

181
00:13:03,600 --> 00:13:09,230
!لا يمكن أن تُدعى هذه حرّية
!دعوا قلوبكن تشتعل

182
00:13:09,230 --> 00:13:10,190
!ممنوع

183
00:13:10,190 --> 00:13:11,350
!لكنّني ربّة عملك

184
00:13:11,350 --> 00:13:13,360
!الحقيقة على النّفوذ

185
00:13:13,360 --> 00:13:16,230
إنّها قاسية على الآخرين ومع نفسها

186
00:13:16,230 --> 00:13:18,970
!لكن أرفض الاستسلام

187
00:13:18,970 --> 00:13:21,340
!رسمتُ هذا بكُلّ جوارحي

188
00:13:21,340 --> 00:13:22,400
!ممنوع

189
00:13:22,400 --> 00:13:23,320
!مُؤلم

190
00:13:23,320 --> 00:13:24,900
!إمّا مُزدوجة أو فلا

191
00:13:24,900 --> 00:13:25,580
!تسخير كامل؟

192
00:13:25,580 --> 00:13:27,840
!رغباتكم العارية

193
00:13:27,840 --> 00:13:28,660
!رغبات؟

194
00:13:28,660 --> 00:13:30,600
!لا دفاع!  هجوم فقط

195
00:13:30,600 --> 00:13:31,540
!هجوم؟

196
00:13:31,540 --> 00:13:36,040
!ممنوع

197
00:13:41,110 --> 00:13:42,750
ما هي الحرّية؟

198
00:13:42,750 --> 00:13:44,100
!لستُ أفهم

199
00:13:44,100 --> 00:13:46,050
"سقطت منكِ نظّارتكِ يا آنسة"

200
00:13:50,140 --> 00:13:55,310
،يبدو وكأنّ مُعلّمة جديدة انضمّتْ للمجموعة
لا خليلة جديدة

201
00:13:55,310 --> 00:13:57,720
!ممنوع

202
00:13:58,140 --> 00:14:01,300
!وصل ملابسكم الجديدة

203
00:14:01,300 --> 00:14:02,570
!توصيل في اليوم التّالي؟

204
00:14:02,570 --> 00:14:07,180
ألا تعلمون؟ المال يجعل المُستحيلَ مُمكناً

205
00:14:07,180 --> 00:14:09,740
لماذا عدتِ إلى مظهر الشّرّير؟

206
00:14:09,740 --> 00:14:11,960
آنذاك عندما كانت لا تزال
تتمتّع بالفطرة السّليمة

207
00:14:11,960 --> 00:14:14,210
!دعي أمّكِ تُبدّل ملابسكِ

208
00:14:14,210 --> 00:14:17,060
!لماذا تأتين إليّ؟ كورومي-سان هناك

209
00:14:17,060 --> 00:14:18,960
!لا ترسليها إليّ

210
00:14:18,960 --> 00:14:20,710
حظيت ميمي بذكريات هائلة

211
00:14:20,710 --> 00:14:22,340
!ماذا؟ ما-ماذا؟

212
00:14:22,340 --> 00:14:24,470
!ميمي-سان قد هربت

213
00:14:25,590 --> 00:14:27,760
!هذا هو شكلكن وأنتن حرائر إذاً؟

214
00:14:27,760 --> 00:14:29,220
هدّئ من روعك يا فتى

215
00:14:30,970 --> 00:14:32,360
!لا أستطيع الوصول إليها

216
00:14:34,100 --> 00:14:36,980
أحظى بشرف البدء أوّلاً

217
00:14:39,590 --> 00:14:41,480
!سانريو سائر

218
00:14:41,480 --> 00:14:43,160
!ظـ-ظريف

219
00:14:43,160 --> 00:14:44,610
سأُصاب بنوبة قلبيّة

220
00:14:44,610 --> 00:14:47,370
مـ-من فضلكم، أنتم تُحرجونني

221
00:14:47,370 --> 00:14:50,590
!وتأتي مع ذيل يُلوّح استجابةً لمزاجها

222
00:14:50,590 --> 00:14:52,290
!هل تحاولين قتلي؟

223
00:14:52,290 --> 00:14:54,880
!هذه هي مي-سان في قمّة تحرّرها

224
00:14:54,880 --> 00:14:57,250
أليس هذا رائعاً يا نادي-سينسي؟

225
00:14:57,250 --> 00:14:58,200
ففف

226
00:14:59,670 --> 00:15:02,630
ما زلتِ تعتقدين بأنّ هذا ليس
حُرّاً بما يكفي؟

227
00:15:02,630 --> 00:15:04,540
"سأكمل من حيث توقّفتْ هي"

228
00:15:09,390 --> 00:15:10,970
!أميرة سائرة

229
00:15:10,970 --> 00:15:12,270
!الأميرات تسير بالطّبع

230
00:15:12,610 --> 00:15:13,680
هكذا إذاً

231
00:15:14,620 --> 00:15:18,040
هكذا هو شعور تمنّي أخذ
شخص إلى جيزنيلاند

232
00:15:19,650 --> 00:15:21,150
ففف

233
00:15:21,150 --> 00:15:23,150
حسناً، أنا التّالية

234
00:15:26,530 --> 00:15:28,740
!ضابطة شرطة بيضاء

235
00:15:29,040 --> 00:15:32,580
أيّتها الضّابطة الظّريفة! اعتقليني
!بتهمة ارتكاب جريمة ظريفة

236
00:15:32,580 --> 00:15:36,040
يمكننا أن نتمنّى فقط بأنّ تلك"
"الجملة ليست مُنذِرة

237
00:15:36,040 --> 00:15:38,540
أ-أنا التّالية على ما أعتقد

238
00:15:39,870 --> 00:15:42,050
!جنّية ماكارون

239
00:15:42,050 --> 00:15:46,520
مُذهل يا كورومي-تشان! أردتِ ارتداء فساتين
ظريفة كهذه منذ البداية؟

240
00:15:46,520 --> 00:15:48,050
...فـ-في الواقع

241
00:15:48,050 --> 00:15:52,120
رأيتُ مكواة ملابس في الأمس واشتهيتُ
الماكارون منذ ذلك الحين

242
00:15:52,120 --> 00:15:54,810
حسناً، يسرّني أنّكِ لم تبدئي
باشتهاء المكواة

243
00:15:55,140 --> 00:15:57,510
إنّها مصنوعة من ماكارون حقيقيّ

244
00:15:57,510 --> 00:15:59,440
مجاعة شديدة؟

245
00:15:59,440 --> 00:16:03,900
!لندع القطار يستمرّ في السّير
!سأكون التّالية

246
00:16:03,900 --> 00:16:06,190
!مُفاجأة بالفعل

247
00:16:11,780 --> 00:16:14,620
كُلني... ك... لّ... ي

248
00:16:14,620 --> 00:16:16,250
!مُبهرج

249
00:16:16,800 --> 00:16:17,840
شكل ووظيفة

250
00:16:17,840 --> 00:16:19,540
!زيّ سباحة سائقي السّيّارات

251
00:16:19,540 --> 00:16:20,890
مـ-مؤلم

252
00:16:20,890 --> 00:16:22,590
!ذلك الرّجل من نجم العمالقة

253
00:16:26,840 --> 00:16:32,300
اهدؤوا، حرصت كوروسي على ألّا
تكون ضارّة للبشر

254
00:16:33,980 --> 00:16:35,850
إنّه يجعل البول أكثر اصفراراً قليلاً

255
00:16:37,390 --> 00:16:39,980
أنا التّالية

256
00:16:42,610 --> 00:16:44,440
!هذه ميميمي-سينباي

257
00:16:44,440 --> 00:16:46,030
!يا له من جمال

258
00:16:46,030 --> 00:16:51,240
أريد أن أكون واثقة مثلها

259
00:16:51,590 --> 00:16:53,830
لا حاجة لقول المزيد

260
00:16:53,830 --> 00:16:56,240
الأمور بخير. فهمت

261
00:16:56,530 --> 00:16:58,120
!ميميمي-سينباي

262
00:16:58,120 --> 00:17:01,590
تريدين أن تكوني مثلي بكامل
!مجدي، أليس كذلك؟

263
00:17:01,590 --> 00:17:02,660
!بالفعل

264
00:17:02,660 --> 00:17:03,960
!ميميمي-سينباي

265
00:17:04,250 --> 00:17:08,500
لكنكِ الأجمل! متى ستُعلّمينني أسراركِ؟

266
00:17:08,500 --> 00:17:11,330
!لـ-لـ-لكنّني لستُ جميلة

267
00:17:11,330 --> 00:17:13,340
!هربتْ من جديد

268
00:17:13,620 --> 00:17:15,850
حان دوري الآن

269
00:17:19,350 --> 00:17:21,230
!رجل غومو-غومو؟

270
00:17:21,230 --> 00:17:26,400
،كي أحافظ على سعادة عائلتي العزيزة
!سوف أصبح ملِك الحُماة

271
00:17:28,410 --> 00:17:30,960
لكن لماذا زيّ ما قبل الفجوة الزّمنيّة؟

272
00:17:30,960 --> 00:17:34,620
في الواقع، لا أستطيع استخدام هاكي بعد

273
00:17:34,620 --> 00:17:36,440
لكن تنوي فعل ذلك؟

274
00:17:36,440 --> 00:17:39,410
لا عجب إذا فعل ذلك

275
00:17:40,990 --> 00:17:44,470
ما الأمر؟ إنّه دورك يا كاراني-سان

276
00:17:48,920 --> 00:17:52,680
كفّي عن المُماطلة للحصول على وقت
!شاشة أطول! لن يحدث هذا

277
00:17:56,050 --> 00:17:57,960
!فتاة ظريفة

278
00:17:58,430 --> 00:18:01,890
!كاراني-سان! ألستِ الأظرف؟

279
00:18:03,380 --> 00:18:05,690
!أنتِ الأظرف في العالم يا كاراني

280
00:18:07,470 --> 00:18:10,140
!حتّى لكماتها ظريفة

281
00:18:10,140 --> 00:18:12,820
"فعلَتْها بشكل مثاليّ، إنّها لا تشعر بأي ألم"

282
00:18:15,460 --> 00:18:20,170
أ-أقصد بأنّنا تمكنّا من رؤية ظرافتكن جميعاً

283
00:18:20,170 --> 00:18:22,280
لا أريد إفساد الأمر

284
00:18:27,840 --> 00:18:29,590
!هاهاري-سينباي

285
00:18:29,590 --> 00:18:33,520
ا-المعذرة، إذا كنتُ حُرّة في فعل
،أيّ شيء أريده

286
00:18:33,520 --> 00:18:38,600
فأعتقد سيكون من اللّطيف أن أكون
تلميذة ثانويّة مرّة أُخرى معك

287
00:18:38,600 --> 00:18:41,880
!لـ-لكن هذا كثير جدّاً

288
00:18:41,880 --> 00:18:44,760
!عمّاذا تتكلّمين؟ تبدين ظريفة جدّاً

289
00:18:44,760 --> 00:18:47,310
ما زال بإمكانكِ النّجاح كتلميذة
!ثانويّة، أي نعم

290
00:18:47,310 --> 00:18:49,360
أكثر منكِ، على الأقلّ

291
00:18:53,490 --> 00:18:57,790
أنتِ تلميذة ثانويّة مثلنا الآن
!فحسب يا هاهاري-سان

292
00:18:57,790 --> 00:19:00,020
!تبدين رائعة يا هاهاري-سان

293
00:19:00,020 --> 00:19:01,290
...أمّي

294
00:19:01,290 --> 00:19:03,510
،في أعماقها، قالت هاكاري لنفسها

295
00:19:03,510 --> 00:19:06,160
"ما هذا الكوزبلاي البغيض؟"

296
00:19:06,160 --> 00:19:09,450
لكنّها حلّلت الأجواء واحتفظت
بذلك لنفسها

297
00:19:10,560 --> 00:19:13,670
حسناً، هؤلاء هم جميعهم

298
00:19:14,000 --> 00:19:18,550
ما-ما رأيكِ بنسخنا المُحرّرة يا نادي-سينسي؟

299
00:19:22,490 --> 00:19:26,110
من المُؤكّد أنّ واحدة منّا على الأقلّ
كانت حُرّة بما يكفي في نظرك

300
00:19:26,110 --> 00:19:27,480
!بئساً

301
00:19:27,760 --> 00:19:29,910
لم أستطع تصديق عينَي

302
00:19:29,910 --> 00:19:34,490
أتيتُم من بعيد مختبئين خلف
تلك الأزياء المدرسيّة

303
00:19:34,490 --> 00:19:38,490
لم تعودوا مُجرّد مجموعة مُفكّرين
أحرار بعد الآن

304
00:19:39,600 --> 00:19:41,960
!أنتم ثائرو الحرّية

305
00:19:42,990 --> 00:19:47,000
!كان من الصّعب حبس الدّموع

306
00:19:48,160 --> 00:19:52,460
كانت صارمة جدّاً، لكنّها تعترف
!بالعمل الّذي نبذله

307
00:19:52,460 --> 00:19:53,650
!المُدرّبة نادي

308
00:19:53,650 --> 00:19:54,880
!تقصدين المُعلّمة

309
00:19:54,880 --> 00:19:58,640
جميعكم كافحتُم ببسالة

310
00:19:58,640 --> 00:20:03,140
حرّية رائعة جدّاً. أشكركم جزيل الشّكر

311
00:20:03,140 --> 00:20:05,910
لا، نحن من ينبغي أن نشكركِ

312
00:20:05,910 --> 00:20:08,850
"ساعدتِ نسخنا الأفضل"

313
00:20:08,850 --> 00:20:11,900
كان ذلك مُسلّياً، كمُنافسة أزياء في
!التّلفزيون، أي نعم

314
00:20:11,900 --> 00:20:16,800
...لـ-لو لم تكوني صارمة معنا

315
00:20:16,800 --> 00:20:22,270
ما كنّا لندرك ما أردنا أن نكون بالفعل...

316
00:20:22,270 --> 00:20:23,160
صحيح

317
00:20:23,160 --> 00:20:28,720
لم أكن أعلم بأنّه من الصّعب
جدّاً تحرير قلبك

318
00:20:28,720 --> 00:20:34,830
لم نُدرك حتّى بأنّنا كنّا نكبت رغباتنا

319
00:20:34,830 --> 00:20:37,550
أنتما عشتُما بحرّية كبيرة من الأساس

320
00:20:37,550 --> 00:20:41,300
شكراً جزيلاً لكِ أيضاً يا نادي-ساما

321
00:20:41,300 --> 00:20:45,720
!جميعكم لديكم قلوب جسورة

322
00:20:45,720 --> 00:20:48,420
أريدكم أن تروا هذه

323
00:20:48,420 --> 00:20:49,560
من هذه؟

324
00:20:49,560 --> 00:20:51,890
هذه رخصة قيادتي القديمة

325
00:20:54,740 --> 00:20:59,410
ظننتُ بأنّكِ أردتِ الاحتفاظ بهذا
السّرّ يا نادي-سينسي

326
00:21:00,200 --> 00:21:04,540
جميعكم أظهرتُم لي مشهدَ حرّية رائعاً

327
00:21:04,540 --> 00:21:10,460
وهذه طريقتي في الإثبات بأنّني
!أريد أن أكون جزءاً من عائلتكم

328
00:21:12,710 --> 00:21:14,640
!المُدرّبة نادي

329
00:21:14,640 --> 00:21:16,230
!مُعلّمة

330
00:21:19,430 --> 00:21:20,690
"تبدين رائعة"

331
00:21:20,690 --> 00:21:22,540
أنتِ أيضاً يا شيزوكا-سينباي

332
00:21:22,540 --> 00:21:23,730
أتريدين واحدة؟

333
00:21:23,730 --> 00:21:25,150
أجل، شكراً لكِ

334
00:21:26,180 --> 00:21:28,060
هل تستطيع ماما الحصول على عضّة أيضاً؟

335
00:21:28,060 --> 00:21:30,330
هذا كُلّه لرينتارو-كن

336
00:21:30,330 --> 00:21:32,730
كفّي عن التّدريب معي رجاء

337
00:21:35,120 --> 00:21:39,830
.رُفِع عبء عن كتفَي
أشعر بحرّية أكبر حتّى من السّابق

338
00:21:39,830 --> 00:21:40,610
ماذا؟

339
00:21:40,610 --> 00:21:44,550
كانت ليلة مُشوِّقة حافظتْ على سرّ
هويّتي اليابانيّة

340
00:21:44,550 --> 00:21:50,120
لم أتوقّع أن يأتي هذا
اليوم الجديد كلّياً

341
00:21:50,120 --> 00:21:54,540
يعزو كُلّ الفضل لكم بكشف سرّي

342
00:21:54,540 --> 00:21:57,490
وإخباري بأنّه ليس هناك ما أخجل منه

343
00:21:57,490 --> 00:21:58,590
لا عليكِ

344
00:22:00,070 --> 00:22:01,840
...الفتى رينتارو

345
00:22:02,510 --> 00:22:04,240
...نادي-سينسي

346
00:22:13,790 --> 00:22:17,150
قُبّعاتنا تُبقي مسافة بيننا
نحن أطفال القدر

347
00:22:17,150 --> 00:22:18,950
!قبلة