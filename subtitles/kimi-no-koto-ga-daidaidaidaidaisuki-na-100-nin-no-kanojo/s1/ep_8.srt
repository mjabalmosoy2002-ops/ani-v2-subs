1
00:00:03,680 --> 00:00:05,480
!أهلاً بك في نادي الكيم

2
00:00:05,960 --> 00:00:09,980
:خليلة الرّوح الأحدث لآيجو رينتارو

3
00:00:10,760 --> 00:00:14,240
،المُنكمِشة والنّامية

4
00:00:14,240 --> 00:00:16,490
،رئيسة نادي الكيمياء العاشقة للعقاقير

5
00:00:17,190 --> 00:00:19,240
ياكوزين كوسوري

6
00:00:19,990 --> 00:00:24,160
،لكن العقّار الّذي أعدّتْه لرينتارو

7
00:00:24,160 --> 00:00:28,750
الدّواء "حافز غير قابل للسّيطرة
،"لتقبيل العاشق

8
00:00:28,750 --> 00:00:36,260
تناولته بالخطأ كُل من هاكاري
...وكاراني وشيزوكا ونانو

9
00:00:37,760 --> 00:00:38,920
قبلة

10
00:00:39,800 --> 00:00:40,560
"قبلة"

11
00:00:41,490 --> 00:00:44,020
ليحوّلهن إلى زومبيّات تقبيل

12
00:00:45,200 --> 00:00:50,270
بالمناسبة، إذا لم يُمنَحنَ الدّواء العاكِس
،للدّواء قبل أن ينتشر العقّار بالكامل

13
00:00:51,000 --> 00:00:52,940
سيبقينَ هكذا طيلة حياتهن

14
00:00:52,940 --> 00:00:54,860
!تُمحى شخصيّتهن؟

15
00:00:55,610 --> 00:00:56,280
!قبلة

16
00:00:58,370 --> 00:01:06,040
،وهكذا بدأت لعبة الخطر المُقيم: تبويس
!بين رينتارو والفتيات

17
00:01:06,350 --> 00:01:08,040
!اهرب يا رينتارو

18
00:01:07,320 --> 00:01:08,590
...تقبيل

19
00:01:08,590 --> 00:01:09,150
...لكن

20
00:01:09,150 --> 00:01:10,520
!بسرعة

21
00:01:16,630 --> 00:01:18,300
...تقبيل... تقبيل

22
00:01:18,300 --> 00:01:22,140
لا يمكنني صنع أربع جرعات من المُحيِّد هنا

23
00:01:22,460 --> 00:01:27,910
عليّ الابتعاد من زومبيّات التّقبيل
!والتوجّه إلى مُختبر الكيم

24
00:01:27,910 --> 00:01:29,150
فهمت

25
00:01:29,150 --> 00:01:30,270
!بسرعة

26
00:01:30,780 --> 00:01:31,730
...يا فتيات

27
00:01:32,010 --> 00:01:33,960
!أعِدُ بأنّني سوف أرجِعكن

28
00:01:34,490 --> 00:01:38,490
...تقبيل

29
00:01:38,920 --> 00:01:39,990
تبويس

30
00:03:22,720 --> 00:03:24,510
الآن فرصتنا للوصول إلى مُختبر الكيمياء

31
00:03:27,300 --> 00:03:29,500
سبقنَنا بخطوة

32
00:03:29,880 --> 00:03:32,860
هل من شيء لإبطائهن؟

33
00:03:32,860 --> 00:03:34,540
...هذا

34
00:03:35,570 --> 00:03:38,700
!دواء إذابة الوجه

35
00:03:38,700 --> 00:03:39,940
!لن تستعمليه

36
00:03:41,880 --> 00:03:43,070
!لنسلك طريقاً التفافيّاً

37
00:03:43,070 --> 00:03:44,570
!عُلِم

38
00:03:47,140 --> 00:03:48,080
...تقبيل

39
00:03:56,160 --> 00:03:57,180
إنّهن سريعات

40
00:03:57,180 --> 00:04:00,560
لا بدّ أنّ هذا جزء من القدرات الخارقة
الّتي اكتسبنَها نظراً لفقدانهن العقلانيّة

41
00:04:00,560 --> 00:04:03,020
!جري في أروقتي؟

42
00:04:03,020 --> 00:04:04,090
!نائبة المدير؟

43
00:04:05,720 --> 00:04:07,680
!إنّه وقت التّقبيل

44
00:04:07,680 --> 00:04:10,680
!وحش

45
00:04:14,360 --> 00:04:15,690
!نائبة المدير

46
00:04:15,690 --> 00:04:17,120
أعتذر، أي نعم

47
00:04:17,120 --> 00:04:21,940
كريم الأساس الّذي قضيتُ ثلاث
!...ساعات أضعه على وجهي

48
00:04:22,270 --> 00:04:23,180
!إنّه يذوب

49
00:04:23,180 --> 00:04:25,310
!نظرة الهاوية

50
00:04:25,310 --> 00:04:30,450
!سينكشف شكلي الحقيقيّ للبشر

51
00:04:30,450 --> 00:04:31,950
لا أعتقد أنّ هذا يفلح

52
00:04:32,300 --> 00:04:35,830
تمّ إيقاف عقّار كوسوري بواسطة كريم أساس؟

53
00:04:35,830 --> 00:04:36,330
!مستحيل

54
00:04:36,330 --> 00:04:38,130
!هذا ما يزعجكِ؟

55
00:04:38,130 --> 00:04:45,760
!تبّاً! يجب أن أسترجع تجميلي

56
00:04:39,650 --> 00:04:42,520
.لا يستطيع العلمُ هزيمة الوحوش
هكذا هي طبيعة سَير العالم

57
00:04:42,520 --> 00:04:43,520
هيّا بنا

58
00:04:43,520 --> 00:04:46,400
!الأسيد... الكيمياء

59
00:04:46,400 --> 00:04:48,240
لو سمحت

60
00:04:48,240 --> 00:04:50,840
تقبيل تقبيل تقبيل

61
00:04:50,840 --> 00:04:51,640
قُبِل

62
00:04:55,400 --> 00:04:56,400
تفرّقن؟

63
00:04:56,760 --> 00:04:59,990
يُخطِّطن إذاً لمُحاصرتنا؟

64
00:05:01,810 --> 00:05:06,140
لحظة، تحاول الفتيات تقبيلي، صحيح؟

65
00:05:06,740 --> 00:05:09,880
كوسوري-سينباي، لنتفرّق أيضاً

66
00:05:10,550 --> 00:05:11,910
حسناً

67
00:05:16,920 --> 00:05:18,480
"قبلة. قبلة"

68
00:05:18,480 --> 00:05:20,920
توقّعت. إنّها تستهدفني

69
00:05:20,920 --> 00:05:24,030
شيزوكا-تشان ليست سريعة كالآخرين

70
00:05:24,030 --> 00:05:28,010
،حتّى لو تجاوزت حدودها نتيجة العقّار
يبقى الأمر مُعتمِداً على قدراتها الجسديّة الأصليّة

71
00:05:28,010 --> 00:05:30,980
سأبتعد عنها قبل أن تتمكّن الثّلاثة
الأُخريات من مُحاصرتي

72
00:05:32,040 --> 00:05:32,940
"قبلة"

73
00:05:34,520 --> 00:05:36,980
!شيزوكا-تشان

74
00:05:37,830 --> 00:05:41,930
يا للهول! جبهتكِ حمراء! يجب عليكِ
!التوجّه إلى عيادة المُمرِّضة حالاً

75
00:05:41,930 --> 00:05:42,610
"قبلة"

76
00:05:43,520 --> 00:05:45,990
لا عليكِ. ستكونين بخير

77
00:05:52,610 --> 00:05:54,830
حسناً، حان وقت مُعالجتكِ

78
00:05:56,320 --> 00:05:57,880
!إجازة؟

79
00:05:57,880 --> 00:06:00,080
!اللّعنة! هذه حالةٌ طارئة

80
00:06:06,000 --> 00:06:08,570
شكراً على تثبيت غرّتكِ

81
00:06:08,570 --> 00:06:11,870
برّدناها واستخدمنا رقعة مُسكِّنة
للألم. ستكونين بخير الآن

82
00:06:11,870 --> 00:06:14,280
يا ألم، يا ألم، ارحل

83
00:06:14,280 --> 00:06:15,160
"قبلة"

84
00:06:24,920 --> 00:06:28,920
!صحيح! نسيتُ بأنّنا كنّا في وسط الخطر المُقيم

85
00:06:28,920 --> 00:06:30,570
!أخطأتُ خطأ فادحاً

86
00:06:31,750 --> 00:06:34,040
...شـ-شيزوكا

87
00:06:33,230 --> 00:06:34,040
"قبلة"

88
00:06:43,630 --> 00:06:45,690
يـ-يستمرّ هذا

89
00:06:47,200 --> 00:06:48,840
...تـ-تبّاً

90
00:07:06,680 --> 00:07:08,760
ا-انتهى الأمر

91
00:07:09,190 --> 00:07:13,370
...لا أستطيع حتّى التّفكير بسويّة

92
00:07:16,620 --> 00:07:20,740
!لا! يجب أن أعيدكِ إلى طبيعتكِ

93
00:07:30,760 --> 00:07:32,680
آسف يا شيزوكا-تشان

94
00:07:32,680 --> 00:07:35,000
أعِدُكِ بأنّني سأُصلح هذا بطريقةٍ ما

95
00:07:36,640 --> 00:07:39,100
!لذا تمالكي نفسكِ

96
00:07:42,500 --> 00:07:45,300
"قبلة"

97
00:07:50,990 --> 00:07:52,110
!تقبيل

98
00:07:53,220 --> 00:07:54,760
عليّ تغيير المسار

99
00:07:56,050 --> 00:07:57,500
!قبلة

100
00:07:59,540 --> 00:08:00,540
!قبلة

101
00:08:04,670 --> 00:08:06,840
...تقبيل

102
00:08:09,610 --> 00:08:10,670
...كارانجنيق

103
00:08:10,670 --> 00:08:11,710
!قبلة

104
00:08:11,710 --> 00:08:13,430
!قذفكاري...

105
00:08:15,720 --> 00:08:21,050
لسنا في دوري مصارعة احترافيّة يابانيّة

106
00:08:22,800 --> 00:08:25,750
...هاكاري... كاراني

107
00:08:26,790 --> 00:08:27,820
قبلة

108
00:08:35,860 --> 00:08:36,980
...قبلة

109
00:08:39,460 --> 00:08:40,360
...قبلة

110
00:08:42,290 --> 00:08:46,540
...لا... أشعر بفراغ في عقلي ثانية

111
00:08:47,400 --> 00:08:49,340
،بخلاف شيزوكا-تشان

112
00:08:49,340 --> 00:08:52,640
...إنّهما قويّتان جدّاً ولا يمكن دفعهما

113
00:08:52,640 --> 00:08:53,950
!تقبيل

114
00:08:56,050 --> 00:08:58,540
!قبلة تقبيل قبلة تقبيل قبلة

115
00:09:00,320 --> 00:09:03,810
بئساً، إنّهما تتشاجران من جديد

116
00:09:03,810 --> 00:09:07,800
حتّى كزومبي تقبيل، إنّهما متشابهتان

117
00:09:09,410 --> 00:09:11,070
حتّى كزومبي تقبيل؟

118
00:09:11,460 --> 00:09:13,510
هاتان متشابهتان؟

119
00:09:15,480 --> 00:09:16,570
...معنى هذا

120
00:09:16,960 --> 00:09:18,120
!قبلة تقبيل

121
00:09:33,970 --> 00:09:35,300
...قبلة تقبيل

122
00:09:42,460 --> 00:09:44,350
!هيّا بنا

123
00:09:44,650 --> 00:09:50,360
هذا صحيح. شربت الفتيات دواء الحافز
غير القابل للسّيطرة لتقبيل العاشق

124
00:09:51,120 --> 00:09:55,790
وكلتاهما مُقرّبتان جدّاً لدرجة
...أنّهما تتشاجران يوميّاً

125
00:09:55,790 --> 00:09:57,340
!إنّهما عاشقتان حقيقيّتان

126
00:09:58,260 --> 00:10:01,380
!تشاركنا قبلة ثلاثيّة في نهاية المطاف

127
00:10:01,930 --> 00:10:04,650
!عرفتُ أنّني أستطيع الاعتماد عليكما

128
00:10:04,650 --> 00:10:08,120
لم يكن رينتارو مُحصَّناً من التسرُّع في الاستنتاج

129
00:10:09,220 --> 00:10:12,120
إ-إنّهما زومبي تقبيل حقّاً

130
00:10:12,120 --> 00:10:14,880
تزداد الأمور حرارة لحظة بعد لحظة

131
00:10:14,880 --> 00:10:19,590
!لحظة، هذا ليس وقت التّحديق
!عليّ الذّهاب إلى مُختبر الكيمياء

132
00:10:30,240 --> 00:10:32,770
جيّد، وصلتُ بطريقة ما

133
00:10:34,250 --> 00:10:36,150
—هل وصلت كوسوري إلى هنا بـ

134
00:10:36,150 --> 00:10:36,970
!خير؟

135
00:10:38,150 --> 00:10:40,660
!ماذا تفعل نانو في المُختبر؟

136
00:10:40,660 --> 00:10:42,320
!هذا سيّئ

137
00:10:42,320 --> 00:10:43,910
!لا أستطيع الإفلات

138
00:10:46,770 --> 00:10:47,660
!قبلة قبلة

139
00:10:51,170 --> 00:10:52,500
...قبلة

140
00:10:56,360 --> 00:10:58,170
،تمكّنتُ من الاختباء

141
00:10:58,720 --> 00:11:01,180
لكنّها ليست إلّا مسألة وقت
قبل أن تجدني

142
00:11:01,910 --> 00:11:03,930
!لكن ما زال هناك أمل

143
00:11:04,400 --> 00:11:06,600
تفرّقنا

144
00:11:06,600 --> 00:11:10,340
إذا انتهزتْ كوسوري-سينباي هذه
...الفُرصة للتسلُّل إلى المُختبر

145
00:11:10,690 --> 00:11:13,940
!لا أستطيع التنفُّس

146
00:11:13,940 --> 00:11:16,440
!كوسوري-سينباي

147
00:11:16,960 --> 00:11:18,970
ضاعت كلّ الآمال

148
00:11:22,160 --> 00:11:23,700
!كوسوري-سينباي

149
00:11:23,700 --> 00:11:26,200
ما-ماذا تفعلين هنا؟

150
00:11:26,200 --> 00:11:29,580
،حاولتُ دخول مختبر الكيم، لكن رأتْني نانو

151
00:11:29,580 --> 00:11:31,330
!لذا اختبأت كوسوري هنا

152
00:11:31,330 --> 00:11:37,690
.والآن هي تتجوّل بحثاً عن كوسوري
لا أستطيع الخروج

153
00:11:37,690 --> 00:11:39,150
لكن لماذا؟

154
00:11:39,150 --> 00:11:42,860
،ينبغي لنانو أن تبحث عنّي أنا
الشّخص الّذي تريد تقبيله

155
00:11:42,860 --> 00:11:48,470
ربّما أدركَتْ نانو بأنّنا في نفس الفريق

156
00:11:48,470 --> 00:11:52,480
أجل. كانت هي من أمرت بمُحاصرتنا أيضاً

157
00:11:52,880 --> 00:11:57,270
كونها زومبي قبلة لم يأخذ ذكاءها بالكامل

158
00:11:58,300 --> 00:12:02,880
اللّعنة! على هذا المُعدّل، سوف
!تكتشفنا وتأسرنا كِلينا

159
00:12:02,880 --> 00:12:04,240
وجدتُها

160
00:12:04,590 --> 00:12:07,000
رينتارو يركض ويستدرج نانو بعيداً

161
00:12:07,000 --> 00:12:11,120
ننتهز كوسوري الفُرصة للتسلُّل
إلى داخل مُختبر الكيم

162
00:12:11,450 --> 00:12:13,920
...فكّرتُ في ذلك أيضاً

163
00:12:13,920 --> 00:12:18,380
لكن االهرب بعد الاختباء سيبدو مشبوهاً جدّاً

164
00:12:18,800 --> 00:12:21,710
سيكون من الواضح أنّني إذا هربتُ
فسوف يُقبَض عليّ

165
00:12:21,710 --> 00:12:26,400
وستُدرك بأنّني ألعب دور طعم لاستدراجها بعيداً

166
00:12:26,400 --> 00:12:30,380
سيكون ذلك وكأنّني أخبرها بأنّكِ
هنا في الدّاخل

167
00:12:32,880 --> 00:12:34,010
!اللّعنة

168
00:12:34,010 --> 00:12:36,460
ماذا أفعل؟ ماذا يمكنني أن أفعل؟

169
00:12:36,460 --> 00:12:39,650
إن لم نتصرّف بسرعة، سيكون الأوان
!قد فات على عكس العقّار

170
00:12:39,980 --> 00:12:43,940
!عليّ أن أفعل شيئاً لإنقاذهن مهما كلّف الأمر

171
00:12:45,810 --> 00:12:48,550
...الأمر هكذا دوماً

172
00:12:49,850 --> 00:12:52,410
كوسوري دائماً هكذا

173
00:12:52,900 --> 00:12:58,750
لا تفكِّر سوى بالعقاقير، تفتعل
المشكلات للجميع

174
00:12:59,830 --> 00:13:04,420
...فقدَتْ بالفعل كلَّ أعضاء نادي الكيم، ومع ذلك

175
00:13:08,340 --> 00:13:09,660
...سينباي

176
00:13:09,660 --> 00:13:12,430
...الآخرون في كفّة، لكن

177
00:13:12,430 --> 00:13:20,440
لكن كوسوري تحبّك! لا أريد أن أُكرَه
!بواسطتك أو أسبّب مُشكلة لك

178
00:13:20,440 --> 00:13:23,940
...يكفي يعني يكفي. كوسوري سوف

179
00:13:23,940 --> 00:13:26,700
!توقف تطوير العقاقير للأبد

180
00:13:27,780 --> 00:13:28,450
...سينباي

181
00:13:28,450 --> 00:13:31,450
!لذا، لذا آسفة يا رينتارو

182
00:13:33,720 --> 00:13:38,040
رينتارو، انتهت لعبة الخطر المُقيم هذه

183
00:13:38,880 --> 00:13:42,840
،لا داعي للقلق. في حالات الطّوارئ
تمتلك كوسوري دوماً

184
00:13:43,350 --> 00:13:46,590
!جرعة واحدة من الدّواء العاكِس

185
00:13:46,590 --> 00:13:47,720
!هكذا إذاً

186
00:13:47,720 --> 00:13:51,970
في البداية، احتجنا أربع جرعات
من الدّواء العاكِس

187
00:13:52,470 --> 00:13:57,960
لكن الآن، جرعة واحدة كافية لقلب
نانو إلى طبيعتها ودخول المُختبر

188
00:13:52,820 --> 00:13:53,660
قبلة

189
00:13:58,780 --> 00:14:00,480
!أنتِ عبقريّة يا كوسوري-سينباي

190
00:14:00,940 --> 00:14:02,340
!بالفعل، أي نعم

191
00:14:02,340 --> 00:14:03,610
!لكن لماذا؟

192
00:14:03,610 --> 00:14:06,000
!لحظة، لحظة! توقّفي يا سينباي

193
00:14:06,000 --> 00:14:06,490
ماذا؟

194
00:14:07,740 --> 00:14:10,720
!ما-ماذا تفعل؟

195
00:14:10,720 --> 00:14:12,540
!هذا ما أريد معرفته أنا

196
00:14:12,540 --> 00:14:14,740
!ألم تكن هذه الجرعة لنانو؟

197
00:14:14,740 --> 00:14:16,720
!فكرة سديدة

198
00:14:16,720 --> 00:14:18,620
!بل الفكرة الوحيدة

199
00:14:19,430 --> 00:14:21,880
...في الواقع، كوسوري

200
00:14:22,220 --> 00:14:27,380
ارتأتْ أنّه سيكون من الأسهل دخول المُختبر
بهذه الهيئة لأنّ نانو لا تعلم به

201
00:14:28,820 --> 00:14:32,520
لِمَ وجهك أحمر يا رينتارو؟ هل من مشكلة؟

202
00:14:32,520 --> 00:14:34,950
...أ-أقصد

203
00:14:35,890 --> 00:14:39,390
...نحن مُتلاصِقان و

204
00:14:39,390 --> 00:14:43,420
لكن لديّ القليل فقط من الدّواء العاكِس

205
00:14:43,420 --> 00:14:45,310
سيزول مفعول التّأثير قريباً

206
00:14:45,310 --> 00:14:51,400
إذا عادت كوسوري إلى طفلة بينما
...تصنع المزيد، نانو قد تكشف الأمر

207
00:14:52,160 --> 00:14:55,540
قد أقيّد نانو وأشلّ حركتها

208
00:14:55,540 --> 00:14:58,560
هـ-هل يمكنكِ فعل ذلك حقّاً؟

209
00:14:58,560 --> 00:15:02,240
ربّما إذا فاجأتُها بهذه الهيئة

210
00:15:02,240 --> 00:15:06,300
يجب أن أتصرّف بسرعة قبل أن
يزول مفعول العقّار

211
00:15:10,120 --> 00:15:10,800
!قبلة

212
00:15:16,230 --> 00:15:17,560
لا قبلة

213
00:15:17,560 --> 00:15:20,480
جيّد. إنّها غير مهتمّة

214
00:15:20,480 --> 00:15:22,730
قد تتمكّن حقّاً من فعلها

215
00:15:23,990 --> 00:15:25,230
قبلة تقبيل؟

216
00:15:25,780 --> 00:15:27,730
...قبلة

217
00:15:28,240 --> 00:15:29,920
المعذرة

218
00:15:29,920 --> 00:15:32,240
كوسوري مجرّد عابرة، أي نعم

219
00:15:32,240 --> 00:15:33,910
!فضحتِ الأمر للتو

220
00:15:34,500 --> 00:15:37,290
!لكن ما أدراها؟

221
00:15:37,910 --> 00:15:39,110
!اللّعنة

222
00:15:39,110 --> 00:15:40,910
هل انتهى الأمر؟

223
00:15:41,290 --> 00:15:45,170
بالقبضِ على سينباي، لا نملك وسيلة
لصنع الدّواء العاكِس

224
00:15:45,170 --> 00:15:46,830
ماذا أفعل؟

225
00:15:46,830 --> 00:15:48,170
!ماذا أفعل؟

226
00:15:53,930 --> 00:15:54,680
قبلة قبلة

227
00:15:56,180 --> 00:15:57,520
!لا تدعها تُمسِك بك

228
00:15:57,520 --> 00:16:01,480
!اركض، اركض، اركض! ابذل جهدك

229
00:16:01,480 --> 00:16:04,350
وماذا يعني إذا كانتْ زومبي قبلة
بلا عقلانيّة أو مُحدِّد يكبح جماحها؟

230
00:16:04,350 --> 00:16:07,160
!سأكسر حدودي أيضاً

231
00:16:07,160 --> 00:16:10,940
!بحبّي الّذي لا ينتهي لهؤلاء الفتيات

232
00:16:37,570 --> 00:16:39,420
تفتح الباب بالقوّة؟

233
00:16:49,530 --> 00:16:52,240
قبلة قبلة

234
00:16:52,240 --> 00:16:55,030
!نانو

235
00:17:16,000 --> 00:17:16,900
قبلة

236
00:17:28,900 --> 00:17:29,830
قبلة

237
00:18:25,330 --> 00:18:26,300
!نانو

238
00:18:35,760 --> 00:18:38,970
الآن عندما تستيقظ، ستعود إلى طبيعتِها، أي نعم

239
00:18:39,590 --> 00:18:43,970
أنا مسرورٌ جدّاً... فعلتِها يا كوسوري-سينباي

240
00:18:44,270 --> 00:18:48,480
خطّطتَ لكلّ هذا يا رينتارو؟

241
00:18:48,800 --> 00:18:51,390
ما كنتُ لأسمّيها خطّة

242
00:18:51,390 --> 00:18:54,480
كان ذلك كلّ ما استطعتُ التّفكير به

243
00:18:55,330 --> 00:18:58,890
،استدرجتُ نانو بعيداً عن ذلك المكان

244
00:18:58,890 --> 00:19:02,840
...وركضتُ لكسب الوقت، وانتظرتُ

245
00:19:02,840 --> 00:19:07,720
انتظرتُ حتّى يزول مفعول الدّواء
العاكِس القليل الّذي تناولتِه

246
00:19:07,720 --> 00:19:10,000
حينئذ سينكمش جسدُكِ وتُفَكُّ القيود تلقائيّاً

247
00:19:10,320 --> 00:19:13,310
صحيح! هكذا استطاعَتْ كوسوري
!الخروج من هناك، أي نعم؟

248
00:19:13,310 --> 00:19:15,250
!لحظة، لم تكوني تُدركين؟

249
00:19:15,250 --> 00:19:20,260
ظننتُ أنّك ربّما استخدمتَ دواء ما لإذابة الحبل

250
00:19:20,260 --> 00:19:25,260
على أيّ حال، لنسرع ونعطي الثّلاثة
الأُخريات الدّواء العاكِس أيضاً

251
00:19:26,470 --> 00:19:27,640
!أجل، أي نعم

252
00:19:32,900 --> 00:19:34,150
أين أنا؟

253
00:19:38,150 --> 00:19:40,940
ماذا كنتُ أفعل؟

254
00:19:40,940 --> 00:19:43,580
لماذا فعلتُ ذلك لآيجو رينتارو؟

255
00:19:43,580 --> 00:19:45,850
"أعتذر أشدّ الاعتذار"

256
00:19:45,850 --> 00:19:46,910
!أنتن

257
00:19:47,600 --> 00:19:48,910
!رينتارو-كن

258
00:19:48,910 --> 00:19:50,910
!أنا آسفةٌ حقّاً

259
00:19:50,910 --> 00:19:52,890
—كيف أمكنَني فعل شيء

260
00:19:56,020 --> 00:19:58,220
ما-ماذا؟

261
00:19:58,220 --> 00:20:03,180
!آ-آسفة، لكن لا أستطيع تذكُّر شيء

262
00:20:03,180 --> 00:20:05,200
!أليس كذلك يا كاراني-سان؟

263
00:20:05,200 --> 00:20:07,660
لـ-لا تتذكّرين شيئاً أيضاً، أليس كذلك؟

264
00:20:13,370 --> 00:20:15,720
!تناولا الدّواء العاكِس

265
00:20:15,720 --> 00:20:17,820
!أنتما غارقتان في بعضكما الآخر

266
00:20:25,920 --> 00:20:28,090
!توقّعتُ هذا

267
00:20:28,090 --> 00:20:30,410
!لا أتذكّر شيئاً

268
00:20:31,400 --> 00:20:36,820
جيّد، جيّد. إنّ مُشاركتهما سرّاً
قرّبهما من بعضهما الآخر أكثر

269
00:20:36,820 --> 00:20:39,170
!كانت هذه غلطة كوسوري

270
00:20:40,760 --> 00:20:42,640
!آسفة للغاية، أي نعم

271
00:20:42,640 --> 00:20:49,010
...عقّار كوسوري حوّلكن جميعاً إلى زومبيّات

272
00:20:49,010 --> 00:20:52,800
!آسفة! آسفة

273
00:20:52,800 --> 00:20:55,520
!آسفة للغاية

274
00:20:56,510 --> 00:20:57,790
كوسوري-سينباي

275
00:20:57,790 --> 00:20:59,020
"مُحترِفة العقاقير"

276
00:20:59,670 --> 00:21:03,390
،أجل، عقّاركِ حوّلَهن إلى زومبي

277
00:21:03,390 --> 00:21:07,280
لكن كان عقّاركِ أيضاً ما أعادهن إلى طبيعتهن

278
00:21:07,810 --> 00:21:10,660
لذا كلّ شيء مُتوازن، صحيح؟

279
00:21:11,190 --> 00:21:13,350
...لكن... لكن

280
00:21:13,790 --> 00:21:15,700
سأصلح أيّ شيء معكِ

281
00:21:16,920 --> 00:21:20,670
،أيّ فوضى تُحدِثُها عقاقيركِ في المستقبل

282
00:21:21,020 --> 00:21:24,920
!سأُصلحها لأجلكِ مهما كلّفَ الأمر

283
00:21:25,760 --> 00:21:27,260
رينتارو؟

284
00:21:27,520 --> 00:21:32,680
لذا كفِّي عن الحديث حول التخلِّي
!عن بحثكِ فيما يخصُّ العقاقير

285
00:21:33,140 --> 00:21:34,140
...بالنّسبة لي

286
00:21:34,510 --> 00:21:36,640
الشّعف الّذي تُظهرينه للأشياء الّتي تحبّينها

287
00:21:37,650 --> 00:21:41,370
هو سببٌ من أسباب حُبِّي لكِ
!يا كوسوري-سينباي

288
00:21:42,150 --> 00:21:43,530
جميل

289
00:21:43,530 --> 00:21:45,150
ظريف للغاية

290
00:21:48,520 --> 00:21:49,660
أنا مُبتلّة الآن

291
00:21:50,000 --> 00:21:51,320
...رينتارو

292
00:21:52,180 --> 00:21:55,660
...كوسوري... كوسوري

293
00:21:56,890 --> 00:22:03,920
تحبُّ العقاقير وتُحبُّك حقّاً، حقّاً
!حقّاً، حقّاً، حقّاً