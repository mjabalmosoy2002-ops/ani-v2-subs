1
00:00:01,640 --> 00:00:02,810
...حسنًا

2
00:00:03,440 --> 00:00:06,310
،باتّباع الجهة التي أشار إليها كي-جا

3
00:00:06,310 --> 00:00:08,570
ينبغي أن يكون التنّين الأخضر في هذه المنطقة

4
00:00:08,570 --> 00:00:09,150
نعم

5
00:00:09,150 --> 00:00:13,740
سايكا

6
00:00:09,730 --> 00:00:11,240
،إذا واصلنا المسير في هذا الاتّجاه

7
00:00:11,240 --> 00:00:13,740
فسنمرُّ بسايكا وقلعة هيريو

8
00:00:14,820 --> 00:00:16,160
معك حقّ

9
00:00:20,830 --> 00:00:21,500
نعم

10
00:02:03,470 --> 00:02:05,730
شينها، هل يوجد أحدٌ هناك؟

11
00:02:10,400 --> 00:02:12,860
لا؟ لنذهب إذًا

12
00:02:17,150 --> 00:02:19,570
!نظرك عبر المسافات البعيدة مذهل

13
00:02:19,570 --> 00:02:21,450
يجعل ذلك البحث في الأماكن المهجورة سهلاً للغاية

14
00:02:22,870 --> 00:02:25,080
...أنت مفيد أيّها التنـ

15
00:02:27,660 --> 00:02:29,960
سمعت أنّ الأميرة قد منحتْك اسمًا يا شينها

16
00:02:30,670 --> 00:02:33,090
شينها"... إنّه اسمٌ جيّد"

17
00:02:33,590 --> 00:02:35,090
ينبغي أن تعتزّ به

18
00:02:38,220 --> 00:02:39,220
اسمع

19
00:02:39,220 --> 00:02:45,930
...تعود قصّة التنانين الأربعة إلى نشأة مملكة كوكا

20
00:02:41,800 --> 00:02:45,930
يبدو بأنّ كي-جا سعيد بوجود شينها معنا

21
00:02:47,390 --> 00:02:52,480
خلال سفرنا، دخلنا قريةً ما

22
00:02:59,530 --> 00:03:00,610
...هذا المكان

23
00:03:01,910 --> 00:03:05,410
هُجرتْ هذه القرية من طرف القادة والملك

24
00:03:06,910 --> 00:03:10,790
كانتْ هذه المنطقة قاحلة وجافّة لسنوات

25
00:03:11,420 --> 00:03:15,420
لا بدّ وأنّ الرجال قد أُخذوا إلى العاصمة ليتمّ تدريبهم كجنود

26
00:03:17,960 --> 00:03:19,590
،أصاب المرض القرية

27
00:03:19,590 --> 00:03:22,720
وقد أُجبِر أولئك الّذين لم يقدروا على الانتقال على الموت هنا

28
00:03:23,800 --> 00:03:24,760
كم هذا فظيع

29
00:03:26,720 --> 00:03:29,060
كانت القرية الّتي وُلدتُ فيها هكذا أيضًا

30
00:03:29,730 --> 00:03:33,150
،منطقة واسعة تابعة لقبيلة النّار
ولكن معظم الأراضي كانت غير خصبة

31
00:03:34,110 --> 00:03:39,240
،لكنّ زعيم القرية، القائد غانغ سو-جين
يستمرّ بإنفاق المال على الجيش

32
00:03:39,240 --> 00:03:40,280
يا له من أحمق

33
00:03:43,360 --> 00:03:44,570
هل أنت بخير؟

34
00:03:44,570 --> 00:03:47,580
تراجعي، ستمرضين أيضًا

35
00:03:47,580 --> 00:03:48,540
...ولكن

36
00:03:52,920 --> 00:03:56,130
قد لا يفيد كثيرًا، ولكن لديّ بعض من الدواء والماء

37
00:03:58,380 --> 00:03:59,800
وفاكهة كذلك

38
00:04:03,590 --> 00:04:04,430
تفضّل

39
00:04:11,980 --> 00:04:14,560
هل أنتم من سايكا؟

40
00:04:14,560 --> 00:04:16,690
لا، نحن مجرّد مسافرين

41
00:04:16,690 --> 00:04:18,190
هكذا إذًا

42
00:04:18,730 --> 00:04:21,400
هل مررتهم على كوتو إذًا؟

43
00:04:21,940 --> 00:04:24,990
يقولون أنّ ملِكًا جديدًا قد تمّ تتويجه

44
00:04:25,450 --> 00:04:27,410
...من يكون يا ترى

45
00:04:32,870 --> 00:04:36,330
الملك السّابق إل، كان ملكًا فظيعًا

46
00:04:37,420 --> 00:04:40,960
مملكة شين                                        مملكة ساي

47
00:04:38,090 --> 00:04:40,920
،لقد انهار تحت ضغط الممالِك الأخرى

48
00:04:40,920 --> 00:04:44,050
ولم يركّز إلاّ على تجنّب المشاكل

49
00:04:44,680 --> 00:04:49,720
انقسمت العشائر الخمسة ووقعت المملكة في فوضى

50
00:04:50,260 --> 00:04:53,270
لم ينقذْ حتّى عامّة الناس الضعفاء أمثالنا

51
00:04:53,850 --> 00:04:57,230
ملك من كان من المفترض أن يكون؟

52
00:04:58,400 --> 00:05:02,650
آمل أن يكون الملك الجديد جيّدًا

53
00:05:03,440 --> 00:05:07,620
...آمل أن يغيّر هذه المملكة

54
00:05:10,160 --> 00:05:12,200
شكرًا لك يا آنسة

55
00:05:12,950 --> 00:05:16,830
لقد مضتْ سنوات مذ لمسني أحد

56
00:05:17,460 --> 00:05:18,330
لا عليك

57
00:05:19,210 --> 00:05:21,340
انتبه لنفسك أرجوك

58
00:05:38,440 --> 00:05:40,820
...أريد استخدام دورة المياه

59
00:05:40,820 --> 00:05:42,400
لا تتبعوني

60
00:05:49,280 --> 00:05:52,120
لم أستطع قول شيء

61
00:05:53,830 --> 00:05:56,910
لم أحترم الملك إل كثيرًا أيضًا

62
00:05:57,670 --> 00:06:01,630
ولكن بالنسبة ليونا، كان الوحيد الّذي من لحمها ودمها

63
00:06:02,460 --> 00:06:06,010
لن  يحزن أحد على رحيل الملك على الأرجح

64
00:06:06,800 --> 00:06:10,300
سيُدوَّن في التاريخ على أنّه ملك أحمق

65
00:06:11,140 --> 00:06:15,140
لن يهتمّ أحدٌ بأميرةٍ واحدة

66
00:06:15,140 --> 00:06:16,350
معك حقّ

67
00:06:17,270 --> 00:06:19,520
،عالمٌ يخلو من السّلاح والحرب

68
00:06:19,520 --> 00:06:23,820
حيث لا يتأذّى فيه أحد هو مجرّد حلم أجوف

69
00:06:24,730 --> 00:06:29,200
ولكن لم أعتبر الملك أحمقًا يومًا بفضل إيمانه الرّاسخ

70
00:06:29,200 --> 00:06:31,740
بأنّ مثل هذا العالم كان مثاليًّا

71
00:06:33,120 --> 00:06:36,000
أخفى جراحه

72
00:06:36,500 --> 00:06:39,580
لم أره كجبانٍ على الإطلاق

73
00:06:41,330 --> 00:06:45,300
وإلاّ لَمَا خدمت أحمقًا أبدًا

74
00:06:47,800 --> 00:06:50,220
وقد أتحسّر على عجزي عن حمايته في قلعة هيريو

75
00:06:50,930 --> 00:06:52,720
طيلة حياتي

76
00:06:55,810 --> 00:06:57,730
اعترفتَ بالملك إل كسيّدٍ لك

77
00:06:58,140 --> 00:07:02,690
بصرف النّظر عن كونه والد يونا

78
00:07:03,270 --> 00:07:04,320
بالطبع

79
00:07:05,110 --> 00:07:06,480
...لا تنس

80
00:07:07,190 --> 00:07:12,410
أريدك أن تتذكّر أبي وابنته

81
00:07:13,370 --> 00:07:15,030
لا يمكن أن أنسى أبدًا

82
00:07:15,830 --> 00:07:20,160
إنّ الأميرة الّتي كانتْ أجمل فتاة
في المملكة صارت وحيدةً الآن

83
00:07:20,830 --> 00:07:23,420
ليس لديها إلاّ نفسها

84
00:07:24,460 --> 00:07:31,180
الفخر الوحيد الّذي بقي لها
هو ارتباطها بأبيها الّذي أحبّتْه

85
00:08:05,290 --> 00:08:07,420
...يجب أن أصبح أقوى

86
00:08:09,590 --> 00:08:10,970
يجب أن أصبح أقوى

87
00:08:13,340 --> 00:08:17,050
!وذلك كي لا أخسر هاك أو أيّ شخصٍ آخر

88
00:08:19,430 --> 00:08:21,020
ماذا يمكنني أن أفعل؟

89
00:08:22,230 --> 00:08:23,020
...يونا

90
00:08:25,690 --> 00:08:30,230
!لا، يجب ألاّ تستخدمي الأسلحة

91
00:08:41,620 --> 00:08:42,870
...أبي

92
00:08:49,210 --> 00:08:53,720
هذه هي تشيشين إذًا، عاصمة عشيرة الأرض

93
00:09:00,220 --> 00:09:02,100
!سيّد غون-تي

94
00:09:03,180 --> 00:09:04,850
!سيّد إي غون-تي

95
00:09:04,850 --> 00:09:08,190
ما الأمر؟ صوتك عالٍ جدًّا يا تشول-ران

96
00:09:08,560 --> 00:09:14,900
لا ينبغي لقائد التسكّع بلباسٍ كهذا خلال فترة النهار

97
00:09:14,900 --> 00:09:17,490
سأظلّ نفس الرّجل مهما ارتديت

98
00:09:17,490 --> 00:09:19,370
أنا لا أزعج أحدًا

99
00:09:19,530 --> 00:09:24,710
عش كما الرّياح

100
00:09:19,870 --> 00:09:21,790
،بالإضافة إلى ذلك، في قبيلة الرّياح

101
00:09:21,790 --> 00:09:26,000
يرتدي هاك والصّغار أيّ لباسٍ يشاؤون

102
00:09:24,710 --> 00:09:26,370
طموح؟ ما هو هذا؟

103
00:09:26,370 --> 00:09:28,630
هل طعمه لذيذ؟

104
00:09:26,540 --> 00:09:28,630
لا تقلق بشأنهم

105
00:09:30,710 --> 00:09:33,840
قبيلة الأرض مملّة جدًّا في الآونة الأخيرة

106
00:09:34,470 --> 00:09:37,970
،بالكاد أرى تجّارًا أو مسافرين من الممالك الأخرى

107
00:09:37,970 --> 00:09:40,510
وتتناقص مواردنا المعدنيّة

108
00:09:41,720 --> 00:09:44,430
!كانت الأمور على ما يرام خلال فترة حكم الملك جونام

109
00:09:44,890 --> 00:09:46,890
كانت العاصمة مليئة بالنّاس

110
00:09:46,890 --> 00:09:49,610
،أثناء الحروب، تحت راية مملكة كوكا

111
00:09:49,610 --> 00:09:52,780
!أسقطتُ المعتدين بقوّة إلهٍ شرس

112
00:09:52,780 --> 00:09:54,190
ليس باليد حيلة

113
00:09:55,320 --> 00:09:59,160
كانت الحرب محرّمة تحت حكم الملك إل

114
00:10:00,120 --> 00:10:02,490
،بالإضافة إلى ذلك، تطلق على نفسك إلهًا شرسًا

115
00:10:02,490 --> 00:10:07,460
لكنّك هُزمتَ على يد الصّغير المعروف بلقب وحش الرّعد

116
00:10:07,960 --> 00:10:10,590
!هذا مضحك للغاية يا تشول

117
00:10:10,590 --> 00:10:14,340
هذا صحيح، لقد صرت ضعيفًا لأنّني فقدتُ لياقتي

118
00:10:14,340 --> 00:10:17,380
...أنا آسف... بالغتُ كثيرًا

119
00:10:17,380 --> 00:10:19,680
!سيّد غون-تي، سيّد إي غون-تي

120
00:10:19,680 --> 00:10:22,760
ماذا الآن؟ هل ستطلب منّي أن أحلق؟

121
00:10:22,760 --> 00:10:24,470
...الملك

122
00:10:24,470 --> 00:10:26,730
!لقد وصل الملك سو-وون

123
00:10:32,020 --> 00:10:33,730
إنه هو بالفعل

124
00:10:33,730 --> 00:10:35,610
!لهذا حذّرتك

125
00:10:35,610 --> 00:10:37,740
!بدّل ملابسك بسرعة

126
00:10:37,740 --> 00:10:42,370
،لا ينبغي أن تبقى بهذه الملابس
قائد السّماء، السيّد هانغ جو-دو، هنا أيضًا

127
00:10:42,910 --> 00:10:46,700
لماذا أتوا لرؤيتي بهذا العدد القليل من النّاس؟

128
00:10:46,700 --> 00:10:48,080
!لا أدري

129
00:10:49,000 --> 00:10:52,080
لم أرك منذ التّتويج يا سيادة القائد غون-تي

130
00:10:52,630 --> 00:10:53,960
هل أنت بخير؟

131
00:10:53,960 --> 00:10:54,590
نعم

132
00:10:55,550 --> 00:10:56,420
...سو-وون

133
00:10:57,050 --> 00:11:01,050
الملك البالغ ثمانية عشر عامًا قد تمّ تتويجه حديثًا فقط

134
00:11:02,180 --> 00:11:06,520
...مع أنّ هناك بعض الغموض الّذي يحيط بموت الملك إل

135
00:11:06,520 --> 00:11:08,890
،واختفاء الأميرة يونا والقائد هاك

136
00:11:08,890 --> 00:11:12,480
إلاّ أنّه يبقى وريث السيّد يو-هونغ
الرّجل الّذي أحترمه كناصحٍ لي

137
00:11:12,860 --> 00:11:17,400
...أيّها القائد غون-تي، أودّ أن أطلب منك معروفًا

138
00:11:17,400 --> 00:11:18,360
حاضر

139
00:11:18,360 --> 00:11:20,570
يريد معروفًا من قائد

140
00:11:20,570 --> 00:11:22,620
!لا بدّ وأنّها مهمّة غاية في السرّية

141
00:11:22,910 --> 00:11:25,540
أنا عطشانٌ بسبب رحلتي الطويلة

142
00:11:25,540 --> 00:11:28,120
هل لي بقدحٍ من الشّاي؟

143
00:11:36,090 --> 00:11:38,380
هذا الشّاي رائعٌ بعطره

144
00:11:38,800 --> 00:11:42,130
الأوراق من مزرعة الشّاي القيّمة لدى زوجتي

145
00:11:42,130 --> 00:11:45,140
مع أنّ عطرها ثقيلٌ عليّ شخصيًّا

146
00:11:46,180 --> 00:11:47,720
رائحته كالزهور

147
00:11:47,970 --> 00:11:50,810
إنّها هواية زوجتي

148
00:11:50,810 --> 00:11:53,480
أرجوك سامحنا على أيّ نكهاتٍ غريبة

149
00:11:53,480 --> 00:11:56,770
حقًّا؟ لقد أعجبني

150
00:11:56,770 --> 00:11:58,690
ألا توافقني يا سيادة القائد جو-دو؟

151
00:11:58,690 --> 00:12:02,360
،نكهة الشّاي لا تعنيني

152
00:12:02,860 --> 00:12:08,120
ولكن يا غون-تي، كيف تجرؤ على تقديم
شاي منخفض الجودة للملك؟

153
00:12:09,290 --> 00:12:11,500
لم يقلْ أحدٌ أنّه منخفض الجودة

154
00:12:11,500 --> 00:12:13,830
أنت قاسٍ كعادتك

155
00:12:13,830 --> 00:12:16,630
لا زلتَ بلا امرأة تقدّم لك الشاي

156
00:12:16,630 --> 00:12:19,630
لأنّك تعقد حاجبيك طوال العام

157
00:12:19,090 --> 00:12:21,550
العمر 34
عازب

158
00:12:20,170 --> 00:12:22,050
!أيّها الوغد

159
00:12:22,050 --> 00:12:23,130
هل تريد أن تقاتل؟

160
00:12:23,130 --> 00:12:25,680
تشول، أحضر لي سيفي

161
00:12:25,680 --> 00:12:27,970
!يا سيّد غون-تي، أنت لا تريد إلاّ القتال

162
00:12:29,180 --> 00:12:30,350
...أيّها القائد غون-تي

163
00:12:32,600 --> 00:12:34,730
نـ-نعم؟

164
00:12:39,940 --> 00:12:43,860
كان لذيذًا، أودّ أن أرى مزرعة الشّاي الخاصّة بك لاحقًا

165
00:12:45,110 --> 00:12:49,200
!استرخاؤك الكبير هذا يجعل النّاس لا يتعاملون معك بجدّية

166
00:12:49,200 --> 00:12:51,410
!يجب أن تتحلّى بكرامة ملك ووعيه الذاتي

167
00:12:51,410 --> 00:12:53,460
...معك حقّ، أنا آسف

168
00:12:53,830 --> 00:12:56,540
أهذا هو وريث السيّد يو-هونغ؟

169
00:12:57,500 --> 00:12:59,710
يا له من رجل واهن وغير جدير بالثّقة

170
00:13:00,510 --> 00:13:03,670
لا أرى فيه خصلةً واحدة من خصال
السيّد يو-هونغ الّذي أُعجبتُ به

171
00:13:03,670 --> 00:13:06,840
بل على النّقيض، أشبّهه بالملك إل

172
00:13:06,840 --> 00:13:09,720
كان السيّد يو-هونغ محاربًا قويًا لا نظير له

173
00:13:09,720 --> 00:13:12,810
كان الملك الحقيقي الوحيد في ذهني

174
00:13:14,350 --> 00:13:17,150
هل سيكون هذا الرّجل ناجحًا؟

175
00:13:20,690 --> 00:13:23,320
هذه زيارتي الأولى لقلعة تشيشين، إنّها مذهلة

176
00:13:23,690 --> 00:13:27,660
...بدأتْ تظهر عليها علامات الزّمن هنا وهناك

177
00:13:28,030 --> 00:13:30,280
نودّ ترميمها قريبًا، أنا محرجٌ من رؤيتك لها

178
00:13:30,660 --> 00:13:33,040
لا نستطيع ترميمها الآن

179
00:13:34,330 --> 00:13:40,420
ولكن سمعت أنّ القلعة مهترئة بسبب هيجانك في شبابك

180
00:13:39,170 --> 00:13:40,420
!سيّد غون-تي

181
00:13:40,750 --> 00:13:43,210
ما الأمر أيّها الجد هي-دي؟

182
00:13:43,210 --> 00:13:45,880
انهار منجم أودو مجدّدًا

183
00:13:45,880 --> 00:13:48,140
ماذا؟ هل تأذّى أحد؟

184
00:13:48,140 --> 00:13:50,430
ما يزيد عن عشرة شُبّان بقليل

185
00:13:50,430 --> 00:13:52,680
ذلك المكان خطير

186
00:13:52,680 --> 00:13:54,350
هل اِسْتُهلك تمامًا؟

187
00:13:54,350 --> 00:13:55,140
يا جلالة الملك؟

188
00:13:55,140 --> 00:13:58,310
في الآونة الأخيرة، تراجع خام الحديد المستخرج

189
00:13:55,520 --> 00:13:56,100
!يا جلالة الملك

190
00:13:57,060 --> 00:13:58,310
نعم؟

191
00:13:58,310 --> 00:14:01,020
ما الّذي جاء بك إلى تشيشين؟

192
00:13:58,560 --> 00:14:01,020
ولكن كان عمّال المناجم يحفرون أنفاقًا جديدة

193
00:14:01,020 --> 00:14:03,820
في محاولةٍ منهم لإيجاد حلّ للوضع

194
00:14:01,440 --> 00:14:04,570
يشرّفنا حضورك إلى هنا بنفسك

195
00:14:03,820 --> 00:14:05,700
فارتدّ ذلك علينا

196
00:14:04,570 --> 00:14:07,360
لا بدّ وأنّ لديك أمرًا مهمًّا تودّ مناقشته

197
00:14:05,700 --> 00:14:07,360
أرسل حصانًا

198
00:14:07,820 --> 00:14:09,740
كلاّ، أقوم بجولةٍ سياحيّة فقط

199
00:14:08,030 --> 00:14:09,740
أغلقوا الأنفاق غير المكتملة

200
00:14:09,740 --> 00:14:11,370
سأزور الجرحى لاحقًا

201
00:14:10,240 --> 00:14:11,370
سياحيّة؟

202
00:14:11,370 --> 00:14:12,240
نعم

203
00:14:11,370 --> 00:14:12,240
حاضر

204
00:14:12,450 --> 00:14:18,040
مملكة كوكا في حالة اضطراب
والملك الجديد يقضي جولةً سياحيّة؟

205
00:14:18,040 --> 00:14:22,630
...بعض مناطق قبيلتنا غير مستقرّة مثل آوا

206
00:14:23,550 --> 00:14:25,010
صُن لسانك

207
00:14:25,010 --> 00:14:27,260
لا تتكلّمْ معه كما تتكلّم معي

208
00:14:27,260 --> 00:14:28,800
لا أمانع

209
00:14:33,220 --> 00:14:34,100
...يا جلالة الملك

210
00:14:35,430 --> 00:14:40,230
ما رأيك بالملك السّابق إل؟

211
00:14:40,690 --> 00:14:41,860
سيّد غون-تي؟

212
00:14:42,360 --> 00:14:46,940
اعذرني على هذا الكلام من فضلك، ولكن كانتْ
لديّ كثير من الاعتراضات على الملك السّابق

213
00:14:47,780 --> 00:14:52,280
لقد تجنّبَ الصّراعات وسلّمَ بعض
الأراضي وترك قوّة المملكة تنحسر

214
00:14:52,280 --> 00:14:57,210
،رغم ادّعائه أنّه يفعل ذلك لأجل الشعب
ولكن أينّ هؤلاء النّاس الّذين أنقذهم؟

215
00:14:57,830 --> 00:15:00,420
،مملكتا سي وشين الجنوبيّتان استخفّتا بنا

216
00:15:00,420 --> 00:15:03,960
وأخشى أن تهاجمنا امبراطوريّة كاي في أيّ وقت

217
00:15:04,500 --> 00:15:09,220
فإذا كنت تنوي أن تسمح بجلب المزيد
،من العار لمملكة كوكا وتعريضها للخطر

218
00:15:09,680 --> 00:15:14,060
فربّما سيكون أنا من يبدأ بتمرّد

219
00:15:15,220 --> 00:15:16,350
!سيّد غون-تي

220
00:15:16,600 --> 00:15:17,600
!غون-تي

221
00:15:17,600 --> 00:15:19,350
...مهلاً، المعذرة

222
00:15:19,980 --> 00:15:22,860
فقد أكون أنا من يبدأ بتمرّد بالفعل

223
00:15:22,860 --> 00:15:24,610
...هذا الرّجل

224
00:15:24,610 --> 00:15:26,780
!يـ-يجب ألاّ تفعل ذلك أيضًا

225
00:15:26,780 --> 00:15:28,240
!إنّه لا يعني ذلك يا جلالة الملك

226
00:15:28,240 --> 00:15:31,200
!لا-لا يمكن لقبيلتنا أن تبدأ تمرّدًا

227
00:15:31,200 --> 00:15:36,740
ما أعنيه هو سؤالي عن مدى اختلافك عن الملك إل

228
00:15:37,200 --> 00:15:42,330
إذ أراك تستمتع بالسياحة بشكلٍ عفويّ
وتشرب الشّاي خلال هذه الأزمة

229
00:15:42,330 --> 00:15:45,000
هل سينقذ ذلك مملكتنا؟

230
00:15:46,130 --> 00:15:47,630
،في مراسم التّتويج

231
00:15:47,630 --> 00:15:53,390
قلتَ أنّك ستعيد هذه المملكة
إلى دولةٍ قويةٍ كما كانتْ منذ جيلين

232
00:15:54,300 --> 00:15:57,520
هل يمكنك أن تخبرني باقتناعٍ أنّك لم تكن تكذب؟

233
00:16:03,190 --> 00:16:04,020
نعم

234
00:16:05,020 --> 00:16:07,150
أنا جادٌّ في ذلك

235
00:16:10,570 --> 00:16:12,530
...إنّه بلا طموح

236
00:16:14,370 --> 00:16:19,580
يقول أنّه جادّ ولكن لماذا يبدو واهنًا هكذا؟

237
00:16:24,330 --> 00:16:26,460
ما هذا الحجر؟

238
00:16:26,750 --> 00:16:29,170
من يأبه لِحجرٍ الآن؟

239
00:16:29,170 --> 00:16:34,050
ولكن يا سيادة القائد جو-دو، من كان
يتوقّع أن يُقدَّسَ حجرٌ هنا؟

240
00:16:34,050 --> 00:16:35,090
...لا جدوى

241
00:16:35,600 --> 00:16:37,430
إنه عديم الفائدة

242
00:16:37,430 --> 00:16:39,770
لا يشبه السيّد يو-هونغ إطلاقًا

243
00:16:39,770 --> 00:16:43,270
...لن يستطيع إعادة بناء هذه المملكة

244
00:16:43,980 --> 00:16:47,520
مصدر ذلك الحجر هو منجم أودو

245
00:16:48,980 --> 00:16:49,780
من المنجم؟

246
00:16:50,150 --> 00:16:54,490
من عادات قبيلتنا تقديس الحجارة طلبًا للثروة والسّعادة

247
00:16:54,490 --> 00:16:57,580
يبدو جميلاً جدًّا عند إمعان النّظر فيه

248
00:16:57,580 --> 00:16:59,290
هل هذا الحجر قيّم؟

249
00:16:59,580 --> 00:17:02,620
لا، الحجر بحدّ ذاته بلا قيمة

250
00:17:02,620 --> 00:17:04,670
ما نريده هو خام الحديد

251
00:17:05,920 --> 00:17:08,500
...المعذرة يا جلالة الملك

252
00:17:08,500 --> 00:17:11,880
أنا مشغول، يجب أن أعود إلى غرفتي

253
00:17:11,880 --> 00:17:14,970
إذا احتجتَ لأيّ شيء، تكلّم مع أحد
خدم القلعة من فضلك

254
00:17:15,180 --> 00:17:16,970
!يا غون-تي، أيّها الوغد

255
00:17:16,970 --> 00:17:19,970
كيف لك بالضّبك أن تكون مشغولاً؟

256
00:17:19,970 --> 00:17:20,890
حسنًا إذًا

257
00:17:20,890 --> 00:17:22,980
لنتكلّم في وقتٍ آخر يا سيادة القائد غون-تي

258
00:17:24,810 --> 00:17:27,020
...عـ-عفوًا يا جلالة الملك

259
00:17:27,480 --> 00:17:33,490
التمرّد الذي تكلّم عنه السيّد غون-تي
...كان مجرّد تعبير بلاغي

260
00:17:33,490 --> 00:17:38,780
يسبّب لنا كلّ أنواع المتاعب بأكاذيبه المبالغ بها

261
00:17:38,780 --> 00:17:41,700
...نعم، فهذا ليس شعوره الحقيقيّ

262
00:17:41,700 --> 00:17:43,120
لا مشكلة

263
00:17:43,580 --> 00:17:45,290
لن يُعاقب

264
00:17:47,250 --> 00:17:52,550
أنا آسف، السيّد غون-تي مكتئبٌ قليلاً

265
00:17:53,260 --> 00:17:57,300
كان معروفًا كقائدٍ عظيمٍ منذ حكم الملك جونام

266
00:17:57,300 --> 00:18:01,680
إنّه يؤمن بأنّه ينتمي لساحة المعركة

267
00:18:02,270 --> 00:18:08,310
أثناء هذا العصر، عجزه عن حماية
مملكة كوكا بقوّته قد أزعجه

268
00:18:09,560 --> 00:18:13,780
مع أنّ مظهره الرثّ يبدو مخالفًا لذلك

269
00:18:14,360 --> 00:18:19,490
أتفهّم القائد غون-تي، هذا واضحٌ من مشاهدتي لكما

270
00:18:20,530 --> 00:18:25,330
تتكلّمان إلى بعضكما الآخر دون أيّ اهتمام بالرّتبة

271
00:18:26,000 --> 00:18:28,750
لا بدّ وأنّ شخصيّته هي الّتي تسمح بذلك

272
00:18:30,630 --> 00:18:33,840
يذكّرني ذلك بأشخاصٍ أحبّهم

273
00:18:35,010 --> 00:18:37,930
تحبّ القائد غون-تي، أليس كذلك؟

274
00:18:38,840 --> 00:18:41,890
شعرك يشبه شعر القائد

275
00:18:43,430 --> 00:18:48,270
لقد رأيتُ تسريحة شعر ذيل الحصان هذه
في كل أنحاء قبيلة الأرض

276
00:18:48,940 --> 00:18:55,650
في الواقع، إنّه يبدو شهمًا وبطلاً في ساحة المعركة

277
00:18:55,650 --> 00:18:57,990
!الجميع معجبٌ به

278
00:18:58,860 --> 00:19:03,870
لأكون صريحًا، فقد كانت عملية
اختيار خادم له تنافسيّة للغاية

279
00:19:03,870 --> 00:19:07,080
ولكن لا تخبره بهذا

280
00:19:07,080 --> 00:19:08,830
...سيجعله ذلك يغترّ بنفسه فحسب

281
00:19:09,170 --> 00:19:12,590
ما الشيء العظيم فيه؟ لست أفهم

282
00:19:12,880 --> 00:19:19,090
إذا كان مذهلاً كما تقول، فأتمنّى
أن أرى القائد الشّهم غون-تي

283
00:19:19,430 --> 00:19:24,180
بالطبع، ولكن لا توجد حروب

284
00:19:24,680 --> 00:19:25,890
فهمت

285
00:19:27,060 --> 00:19:28,060
...في هذه الحالة

286
00:19:28,060 --> 00:19:30,350
!سيّد غون-تي! سيّد غون-تي

287
00:19:30,690 --> 00:19:33,060
!سيّد غون-تي! سيّد غون-تي! سيّد غون-تي

288
00:19:33,060 --> 00:19:35,320
ما الأمر؟ اصمت

289
00:19:35,320 --> 00:19:36,110
...جلالة الملك

290
00:19:36,530 --> 00:19:39,030
أرفض الكلام مع ذلك الولد المدلّل

291
00:19:39,280 --> 00:19:40,820
ليس كذلك

292
00:19:40,820 --> 00:19:43,990
!يبدو بأنّ الملك سو-وون يستعدّ لحرب

293
00:19:44,950 --> 00:19:49,120
!يا جلالة الملك سو-وون! يا جلالة الملك سو-وون

294
00:19:49,120 --> 00:19:51,080
!اخرس! سمعناك في المرّة الأولى

295
00:19:51,080 --> 00:19:53,630
هل قرّرتَ الذهاب للحرب؟

296
00:19:53,630 --> 00:19:54,710
من سنقاتل؟

297
00:19:54,710 --> 00:19:56,000
هل هي شين؟ سي؟

298
00:19:56,000 --> 00:19:56,840
هل هي كاي؟

299
00:19:57,920 --> 00:19:59,550
!اترك الأمر لي

300
00:19:59,550 --> 00:20:01,180
لا، أعلم ذلك

301
00:20:01,180 --> 00:20:02,930
...يجب علينا أوّلاً أن نعدّ الجنود والأسلحة

302
00:20:02,930 --> 00:20:03,970
،أيّها القائد غون-تي

303
00:20:04,350 --> 00:20:06,970
إنّها مجرّد ألعاب حرب

304
00:20:10,850 --> 00:20:13,600
،القادة متعطّشون للمعارك

305
00:20:13,600 --> 00:20:16,190
ويتمنّى الناس أن يروا أبطالهم الشّهام

306
00:20:17,110 --> 00:20:20,700
فكّرتُ في إقامة مهرجان في تشيشين

307
00:20:21,280 --> 00:20:26,450
عـ-عفوًا، أي بعبارات أخرى، معركة وهميّة؟

308
00:20:26,950 --> 00:20:28,790
لن تكون مسألة جدّيّة

309
00:20:28,790 --> 00:20:31,370
لن أدع أحدًا يموت في مهرجان

310
00:20:31,370 --> 00:20:32,870
لن نستخدم سيوفًا حقيقيّة

311
00:20:35,630 --> 00:20:39,010
...جو-دو، أيّها المتملّق

312
00:20:39,010 --> 00:20:41,420
هذا ما كنت أودّ قوله، ولكن ينبغي أن أشكرك

313
00:20:41,420 --> 00:20:43,840
انقبضتْ يدايَ من تلقاء نفسها

314
00:20:43,840 --> 00:20:46,050
...أيّها الوغد، كيف تجرؤ

315
00:20:46,050 --> 00:20:48,850
هذا ما كنتُ أودّ قوله، ولكن أتفهّم مشاعرك

316
00:20:48,850 --> 00:20:51,560
لو لم تفعلْها أنت لفعلتُها أنا

317
00:20:51,560 --> 00:20:52,520
!يا جلالة الملك

318
00:20:52,770 --> 00:20:56,860
!قلتُ لك أنّ الوقت ليس مناسبًا للألعاب

319
00:20:56,860 --> 00:21:00,320
ينبغي أن ترفّه عن نفسك بين الفيّنة
والأخرى يا سيادة القائد جو-دو

320
00:21:01,070 --> 00:21:03,700
سيُقام المهرجان خلال أسبوع

321
00:21:04,320 --> 00:21:05,280
،يا جلالة الملك

322
00:21:05,910 --> 00:21:10,950
لا تمتلك قبيلة الأرض ما يكفي
من الوقت لتلعب الألعاب معك

323
00:21:10,950 --> 00:21:12,960
ينبغي أن تعود إلى قلعة هيريو

324
00:21:14,460 --> 00:21:16,210
!لن نقوم بإقامتها؟

325
00:21:16,210 --> 00:21:18,710
كنّا متحمّسين لذلك سرًّا

326
00:21:19,340 --> 00:21:22,090
!ماذا؟ تريدان أن تلعبا الألعاب؟

327
00:21:22,720 --> 00:21:24,760
لا يريدون أن يلعبوا

328
00:21:26,140 --> 00:21:30,970
أيّها القائد غون-تي، تبدو غير مدرك لجاذبيّتك

329
00:21:32,520 --> 00:21:37,980
أودّ أن أزور الرجال الذين جُرحوا في منجم أودو لاحقًا

330
00:21:37,980 --> 00:21:39,650
سأدلّك إلى الطريق

331
00:21:40,610 --> 00:21:42,320
لا أفهم

332
00:21:42,320 --> 00:21:44,240
ما كان ينبغي أن أقارنه بالسيّد يو-هونغ

333
00:21:44,240 --> 00:21:47,320
...قد يكون حتّى أسوأ من الملك إل

334
00:21:49,030 --> 00:21:50,450
يا له من شاي لذيذ

335
00:21:50,830 --> 00:21:54,160
ما الّذي سيحلّ بهذه المملكة؟

336
00:23:25,090 --> 00:23:40,600
الحلقة القادمة

337
00:23:26,800 --> 00:23:31,220
لو كان هذا المكان ساحة معركة لكنت قد متّ دون شكّ

338
00:23:31,510 --> 00:23:33,850
إذًا، ماذا ستفعل؟

339
00:23:34,970 --> 00:23:37,770
:"لاحقا في الحلقة 16 من "يونا الفجر

340
00:23:38,390 --> 00:23:39,350
ألعاب الحرب