1
00:00:00,610 --> 00:00:02,270
،أنا موموميا إتشيغو

2
00:00:02,650 --> 00:00:05,440
،عندما كنتُ في موعد مع آوياما-كن الذي أحبه آخر مرة

3
00:00:05,570 --> 00:00:08,070
!ظهر غلام يدعى كيشو، إنه شخص فظيع

4
00:00:08,400 --> 00:00:10,950
.لكننا وجدنا العضوة الرابعة وهي بودينغ

5
00:00:11,320 --> 00:00:14,120
.إذا عثرنا على العضوة الأخيرة، فسيكون ذلك مثاليًا

6
00:00:43,440 --> 00:00:44,150
.هذا لا يكفي

7
00:00:45,110 --> 00:00:45,860
...شيءٌ ما

8
00:02:22,910 --> 00:02:24,250
...آوياما-كن

9
00:02:24,670 --> 00:02:26,130
.نجاح باهر

10
00:02:24,670 --> 00:02:26,130
.ابذل جهدك في المبارزة التالية

11
00:02:26,130 --> 00:02:27,250
.ستفوز بالتأكيد

12
00:02:28,380 --> 00:02:31,260
.لا يزال آوياما-كن يحظى بشعبية كما كان دائمًا

13
00:02:31,630 --> 00:02:34,050
إتشيغو، ألستِ قلقة؟

14
00:02:36,550 --> 00:02:37,600
بشأن ماذا؟

15
00:02:38,220 --> 00:02:40,220
،يبدو أن آوياما-كن مشغول

16
00:02:40,390 --> 00:02:43,350
.لذلك دعونا نتخطى إلقاء التحية عليه ونعد إلى المنزل اليوم

17
00:02:43,600 --> 00:02:45,190
،تبدو واثقة

18
00:02:45,310 --> 00:02:47,230
.وسعيدة أيضًا

19
00:02:47,360 --> 00:02:50,070
أهذا يبدو عليّ، مياو؟

20
00:02:50,980 --> 00:02:52,070
مياو؟

21
00:02:52,860 --> 00:02:53,950
...لأن، لأن

22
00:02:54,110 --> 00:02:55,860
.آوياما-كن قال لي

23
00:02:56,160 --> 00:02:57,570
.قال لي مياو

24
00:02:58,570 --> 00:03:00,490
،سأسمح لكِ بارتداءها لجرسها

25
00:03:02,700 --> 00:03:04,620
...لأن إتشيغو تكون قطتي

26
00:03:07,170 --> 00:03:08,130
إتشيغو؟

27
00:03:08,250 --> 00:03:09,040
.لا شيء

28
00:03:09,290 --> 00:03:10,590
.هيا بنا

29
00:03:10,840 --> 00:03:12,420
.لديّ دوام جزئي لأقوم به

30
00:03:19,640 --> 00:03:22,140
،آوياما-كن، من تلك المسافة

31
00:03:22,390 --> 00:03:23,680
.ما زال يلاحظني

32
00:03:27,190 --> 00:03:29,650
.أنا سعيدة

33
00:03:29,770 --> 00:03:31,360
.أنا سعيدة، أنا سعيدة

34
00:03:31,440 --> 00:03:32,570
!أنا سعيدة، مياو

35
00:03:37,990 --> 00:03:38,820
.عمتم مساءً

36
00:03:38,820 --> 00:03:39,660
!انتبهي

37
00:03:40,530 --> 00:03:42,450
.مرحبًا بكِ

38
00:03:42,620 --> 00:03:44,700
.انتظري، انتظري

39
00:03:42,620 --> 00:03:44,700
.هذا مؤلم

40
00:03:44,910 --> 00:03:46,330
أأنتِ بخير؟

41
00:03:46,370 --> 00:03:48,580
انتظري لحظة، ما الذي يجري؟

42
00:03:48,670 --> 00:03:49,880
...حسنٌ، هذا

43
00:03:50,040 --> 00:03:53,090
...قالت بودينغ إنها تريد المساعدة في المقهى أيضًا

44
00:03:54,090 --> 00:03:56,260
.يمكنني تناول الحلوى بقدر ما أريد

45
00:03:56,340 --> 00:03:58,800
.كُلْوا أولًا ثم ادفعوا لاحقًا

46
00:03:58,970 --> 00:04:01,180
.أنتِ مذهلة يا بودينغ

47
00:04:01,600 --> 00:04:02,760
.إنني معجبة بكِ كثيرًا

48
00:04:02,850 --> 00:04:04,930
.هذا ليس وقت الإعجاب

49
00:04:05,220 --> 00:04:05,850
.هذا شهي

50
00:04:06,020 --> 00:04:07,100
.أعتذر للتأخير

51
00:04:07,190 --> 00:04:08,190
أهنا؟

52
00:04:08,270 --> 00:04:09,560
.انتظري

53
00:04:08,270 --> 00:04:09,560
أم هناك؟

54
00:04:09,690 --> 00:04:13,360
لماذا نصبح أكثر انشغالًا بالرغم أن الأيدي العاملة قد زادت؟

55
00:04:13,360 --> 00:04:14,780
.أعتذر لجعلكم تنتظرون

56
00:04:15,070 --> 00:04:16,150
.يا له من عمل مربح

57
00:04:16,820 --> 00:04:19,280
.مهلًا يا بودينغ، انتظري عندكِ

58
00:04:19,490 --> 00:04:21,870
لقد أُغلقنا !نأسف

59
00:04:22,330 --> 00:04:23,910
...وأخيرًا انتهى

60
00:04:24,490 --> 00:04:28,790
من كان يصدق أن مقهى كهذا سيتعبنا لهذه الدرجة؟

61
00:04:29,330 --> 00:04:30,830
...انتظروا لحظة

62
00:04:30,960 --> 00:04:34,090
!على فكرة، أليس ذلك الشخص هو الملام؟

63
00:04:34,300 --> 00:04:36,380
،تحويل الناس إلى سلاح بيولوجي متى أراد

64
00:04:36,380 --> 00:04:38,010
!ويجبرنا على العمل

65
00:04:38,340 --> 00:04:40,840
أكاساكا، أين ذلك الفتى؟

66
00:04:41,090 --> 00:04:42,010
أتقصدين ريو؟

67
00:04:42,090 --> 00:04:43,260
.لا بد أنه في غرفته

68
00:04:43,300 --> 00:04:44,760
.شكرًا جزيلًا

69
00:04:44,760 --> 00:04:46,350
...لكن ربما هو الآن

70
00:04:46,810 --> 00:04:48,020
!اسمعني يا هذا

71
00:04:48,270 --> 00:04:49,520
!طيّب

72
00:05:06,580 --> 00:05:07,330
.بئسًا

73
00:05:07,450 --> 00:05:09,040
ماذا تفعلين؟

74
00:05:10,160 --> 00:05:11,830
حسنٌ، بم أساعدكِ؟

75
00:05:13,420 --> 00:05:14,840
...حسنٌ

76
00:05:17,380 --> 00:05:18,090
...غرفته

77
00:05:18,760 --> 00:05:21,130
...بطريقة ما تُشعرني بالوحدة

78
00:05:22,800 --> 00:05:24,050
...على هذا النحو، أنا

79
00:05:24,350 --> 00:05:26,260
...لا أعرف شيئًا عن هذا الشخص

80
00:05:27,180 --> 00:05:29,560
لماذا يعيش بمفرده في مكان كهذا؟

81
00:05:29,930 --> 00:05:31,810
ولماذا يمتلك مقهى؟

82
00:05:32,560 --> 00:05:35,820
ولماذا هو يعرف بشأن الفضائيين؟

83
00:05:45,240 --> 00:05:46,160
...أنا جائع

84
00:05:48,540 --> 00:05:48,950
.ها هو

85
00:05:50,710 --> 00:05:52,620
.أنا أجيد تحضير هذا فقط

86
00:05:53,080 --> 00:05:54,500
...كرات الأرز

87
00:05:55,750 --> 00:05:57,000
ماذا تعني؟

88
00:05:57,340 --> 00:05:59,920
...حسنٌ، إذا كنتَ لا تريدها فسآكلها أنا

89
00:06:06,140 --> 00:06:07,510
.إنها لذيذة

90
00:06:08,720 --> 00:06:11,270
...لا، فاجأني

91
00:06:11,680 --> 00:06:13,940
...رؤية ردة فعله

92
00:06:14,900 --> 00:06:16,650
.لا يسعني إلا الشعور بالسعادة

93
00:06:17,110 --> 00:06:18,230
أأنتِ بخير؟

94
00:06:18,360 --> 00:06:21,440
.معدل ضربات قلبكِ أعلى من المعتاد

95
00:06:21,860 --> 00:06:23,200
.مهلًا يا ماشا

96
00:06:23,320 --> 00:06:25,240
.لا تقل أشياء غير ضرورية

97
00:06:25,320 --> 00:06:27,240
.هناك فرصة

98
00:06:25,320 --> 00:06:27,240
!مهلًا

99
00:06:27,240 --> 00:06:29,160
.لا للعنف

100
00:06:29,160 --> 00:06:30,240
ماذا تفعلين عندكِ؟

101
00:06:30,410 --> 00:06:31,910
.أنا ما ينبغي عليه أن يسأل

102
00:06:32,460 --> 00:06:33,620
.لا تشغلي بالكِ

103
00:06:33,750 --> 00:06:37,920
.وأخيرًا وجدتُ فرصة لإيقاظ قوى العضوة الخامسة

104
00:06:38,920 --> 00:06:40,670
...العضوة الخامسة

105
00:06:42,670 --> 00:06:46,720
.هناك خمسة أنواع من الحيوانات المهددة بالانقراض التي حملتن جيناتها

106
00:06:47,430 --> 00:06:49,060
...جينات الوحيد المتبقي هو هذا

107
00:06:49,640 --> 00:06:50,430
،وأيضًا

108
00:06:50,890 --> 00:06:52,600
...الشخص الذي يطابقها هي

109
00:06:52,600 --> 00:06:54,520
.دعونا نغامر في الأدغال، إنها هي

110
00:06:54,640 --> 00:06:56,560
،ذات شعر أسود ذو لمعة

111
00:06:56,690 --> 00:06:59,070
.مضاءة كالعقيق الأسود

112
00:06:59,230 --> 00:07:00,780
حدقة عينها مليئة بالغموض والحكمة

113
00:07:00,860 --> 00:07:03,940
.التي تعطي إحساسًا بالعاطفة وتشبه الياقوت الأزرق

114
00:07:04,070 --> 00:07:05,400
،رشيقة وناعمة

115
00:07:05,490 --> 00:07:07,700
.ساقيها مثل البلاتين الأبيض

116
00:07:07,700 --> 00:07:10,530
.إنها رفيقتنا الأخيرة والفضلى

117
00:07:10,740 --> 00:07:13,040
.المحاربة الحقيقية لإنقاذ الأرض

118
00:07:13,200 --> 00:07:14,500
.أختي الكبرى فوجيوارا زاكورو

119
00:07:14,750 --> 00:07:16,710
.هي المنشودة

120
00:07:17,210 --> 00:07:18,540
أخت كبرى؟

121
00:07:18,750 --> 00:07:20,250
...العضوة الأخيرة

122
00:07:20,460 --> 00:07:23,050
هل تعنين بأنها أختكِ فعلًا؟

123
00:07:23,090 --> 00:07:24,130
.ليس هكذا

124
00:07:24,380 --> 00:07:25,550
...الأمر ليس كذلك

125
00:07:25,630 --> 00:07:27,590
...هذا لأنني أخاطبها بطريقة محترمة

126
00:07:27,800 --> 00:07:29,390
،بمعنى آخر، أنتِ معجبة بها

127
00:07:29,430 --> 00:07:30,260
زاكورو، صحيح؟

128
00:07:30,300 --> 00:07:32,350
أهناك خطأ حيال ذلك؟

129
00:07:33,810 --> 00:07:37,100
...لكنّي أشعر وكأنني رأيتُها في مكانٍ ما

130
00:07:37,270 --> 00:07:39,150
...بما أنكِ ذكرتِ ذلك، فأنا أيضًا

131
00:07:38,810 --> 00:07:44,320
قائمة فوجيوارا زاكورو المتعددة

132
00:07:39,270 --> 00:07:41,150
.لا عجب أنكما تشعران بهذا النحو

133
00:07:41,320 --> 00:07:44,490
.أحدثت الأخت الكبيرة زاكورو ضجة بصوتها الغنائي فقط

134
00:07:44,650 --> 00:07:46,110
،وهي نشطة في المجلات، على شاشة التلفزيون والمسرح

135
00:07:46,150 --> 00:07:48,490
.وغيرها من المجالات

136
00:07:48,700 --> 00:07:51,950
.الآن، تقوم بعمل رائع كآيدولز وعارضة

137
00:07:51,830 --> 00:07:54,870
قال الأمين العام للأمم المتحدة في الاجتماع

138
00:07:51,830 --> 00:07:54,870
.يعرض في عاشرة صباحًا برنامج خاص عن تسلق الجبال

139
00:07:51,830 --> 00:07:54,870
جبل إيفرست

140
00:07:52,950 --> 00:07:54,750
.إنها حقًا من المشاهير

141
00:07:55,330 --> 00:07:57,540
بفضل ذلك، حتى لو أردنا إيقاظها

142
00:07:57,580 --> 00:07:59,540
.ليس من السهل الاقتراب

143
00:07:59,920 --> 00:08:02,170
يمكننا مراقبتها سرًا

144
00:08:02,380 --> 00:08:05,300
.ونقضي وقتنا في الاتصال بها

145
00:08:05,550 --> 00:08:07,090
.وهنا تأتي فرصتنا

146
00:08:07,050 --> 00:08:13,560
إشعار: مسرحية موسيقية جديدة من بطولة فوجيوارا زاكورو

147
00:08:08,430 --> 00:08:10,930
.مسرحية موسيقية من بطولة فوجيوارا زاكورو

148
00:08:11,050 --> 00:08:13,760
.سيتم إجراء اختبارات الأداء للمشاركين

149
00:08:13,970 --> 00:08:15,850
.فهمتُ، من خلال تجارب الأداء

150
00:08:16,100 --> 00:08:19,730
،بصفتها الممثلة الرئيسية، يبدو أنها ستحضر بعض هذه الاختبارات

151
00:08:19,980 --> 00:08:21,690
.لذلك فهي فرصة نادرة

152
00:08:22,150 --> 00:08:22,610
.أجل

153
00:08:22,860 --> 00:08:25,530
بهذه الطريقة، يمكن أن يكون لدينا أسباب مشروعة

154
00:08:25,690 --> 00:08:29,070
.لمقابلة الأخت الكبيرة زاكورو وجه لوجه

155
00:08:29,360 --> 00:08:31,370
...وبعد ذلك، في صباح اليوم التالي

156
00:08:32,410 --> 00:08:35,080
...الشخص الذي تم اختياره كمؤدي مشارك لفوجيوارا زاكورو هي

157
00:08:36,000 --> 00:08:37,580
.آيزاوا مينت

158
00:08:40,170 --> 00:08:41,080
.تهانينا

159
00:08:41,580 --> 00:08:43,880
.أستطيع أن أشعر أن القدر قادكِ إلى هنا

160
00:08:44,380 --> 00:08:45,920
شاركتُ في الاختبار من أجل

161
00:08:46,210 --> 00:08:49,510
...أداء دوري لإنقاذ الأرض

162
00:08:50,300 --> 00:08:52,090
،الآن وقد تم اختياري

163
00:08:52,260 --> 00:08:54,470
.سأبذل قصارى جهدي لتقديم أداء جيد

164
00:08:55,430 --> 00:08:56,220
.آيزاوا

165
00:08:56,970 --> 00:08:57,890
...أختي الكبرى

166
00:09:00,560 --> 00:09:03,360
.حسنٌ في هذه الحالة، علينا اغتنام الفرصة بلا ريب

167
00:09:03,690 --> 00:09:05,270
إتشيغو، لتوسي، مينت

168
00:09:05,570 --> 00:09:06,230
.إنها مهمة

169
00:09:06,690 --> 00:09:09,110
.ثلاثتكن اذهبن للمشاركة في الاختبار

170
00:09:09,400 --> 00:09:11,530
.انتظر لحظة

171
00:09:09,400 --> 00:09:11,530
ماذا؟

172
00:09:11,860 --> 00:09:13,910
لماذا أنا الوحيدة التي تم استبعادها؟

173
00:09:14,280 --> 00:09:16,370
لأن هذه المرة، المؤدي المشارك الذي يقومون بتوظيفه

174
00:09:16,540 --> 00:09:18,620
.هو من طلاب المدارس الثانوية وما فوق

175
00:09:18,870 --> 00:09:20,410
.أنتِ ما زلتِ صغيرة

176
00:09:20,620 --> 00:09:22,210
.لا، لا، لا

177
00:09:22,210 --> 00:09:24,290
.أريد أيضًا أن آكل في الاختبار

178
00:09:24,340 --> 00:09:26,340
.لا يوجد طعام للأكل

179
00:09:27,710 --> 00:09:29,470
...أنا بالتأكيد أريد أن أذهب أيضًا

180
00:09:31,550 --> 00:09:32,840
.شكرًا لعملكن الشاق

181
00:09:34,850 --> 00:09:35,930
...حتى ولو

182
00:09:36,680 --> 00:09:38,640
.أنت سيئ يا ريو

183
00:09:40,850 --> 00:09:41,980
إذا كُنَّ

184
00:09:42,190 --> 00:09:44,860
تواصلن مع العضوة الخامسة

185
00:09:45,150 --> 00:09:47,570
يمكنك معرفة ما سيحدث، أليس كذلك؟

186
00:09:49,070 --> 00:09:49,940
.نعم

187
00:09:50,740 --> 00:09:51,360
،لكن

188
00:09:51,990 --> 00:09:53,530
.هذا السبب بالضبط

189
00:09:54,200 --> 00:09:56,870
.كما هو متوقع، كنت تنوي التزام الصمت حيال ذلك

190
00:09:59,500 --> 00:10:00,580
،من خلال المهمة هذه المرة

191
00:10:01,000 --> 00:10:02,750
.سيَكُنَّ أقوى

192
00:10:03,210 --> 00:10:05,580
.حسنٌ، فقط إذا سارت الأمور كما توقعتُ

193
00:10:08,210 --> 00:10:08,800
.ريو

194
00:10:09,340 --> 00:10:10,550
أنت لا تزال

195
00:10:10,920 --> 00:10:12,590
...سيئ قليلًا

196
00:10:15,140 --> 00:10:16,550
.هذا هو المكان

197
00:10:16,930 --> 00:10:17,640
.مدهش

198
00:10:17,930 --> 00:10:20,060
.قلبي يدق من الخوف بسبب الاختبار

199
00:10:20,980 --> 00:10:22,890
،إذا كنا مؤهلات حقًا

200
00:10:22,940 --> 00:10:24,100
ماذا عسانا نفعل؟

201
00:10:24,980 --> 00:10:26,150
...حسنٌ إذن

202
00:10:26,520 --> 00:10:29,690
.سأكون في مسرحية موسيقية وأصدم كل هؤلاء النقاد

203
00:10:29,980 --> 00:10:32,440
.وسأصبح نجمة من خلال الإعلانات التجارية والدراما التلفزيونية

204
00:10:32,820 --> 00:10:34,490
...وأظهر على أغلفة المجلات بالتتابع

205
00:10:34,490 --> 00:10:36,120
.سيتم اكتشاف مواهبي المتعددة

206
00:10:36,410 --> 00:10:38,120
...و... وأيضًا

207
00:10:39,080 --> 00:10:39,740
