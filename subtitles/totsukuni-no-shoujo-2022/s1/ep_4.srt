...ذاك الشخص

456
00:41:16,760 --> 00:41:18,310
.فهمت

457
00:41:18,310 --> 00:41:20,920
.هذا يعني أنهم جميعهم هكذا

458
00:41:22,570 --> 00:41:24,640
.الجميع كان هنا

459
00:41:25,280 --> 00:41:28,260
.بقوا رفقة بعض طيلة الوقت ولم يتفرقوا

460
00:41:32,870 --> 00:41:34,180
شيفا؟

461
00:41:34,590 --> 00:41:36,690
.أيها المعلم، يمكنك أن تستلقي أذنت أيضا

462
00:41:37,370 --> 00:41:38,440
ما هذا؟

463
00:41:38,800 --> 00:41:40,560
افعلها فحسب، اتفقنا؟

464
00:41:51,270 --> 00:41:54,110
.أيها المعلمأ أرجو أن تستمع لما سأقوله

465
00:41:56,330 --> 00:41:59,850
.قبل أن ألتقي بك، استيقظت ذات مرّة

466
00:42:00,540 --> 00:42:03,130
.كنت بمفردي وكان المكان مظلما

467
00:42:03,130 --> 00:42:07,230
.لذا فكّرت أنني غير قادرة على العودة للقرويّين الآخرين

468
00:42:07,820 --> 00:42:10,090
.عندما فكرت في ذلك، لم أستطع التحرّك

469
00:42:10,520 --> 00:42:11,900
،كنت خائفة

470
00:42:11,900 --> 00:42:14,340
.لذلك أغمضت عينيّ وتمنّيت أن يأتي أحدهم

471
00:42:15,450 --> 00:42:17,830
لكن عندما استيقظت مجددا

472
00:42:17,830 --> 00:42:20,140
.كنت أمامي

473
00:42:20,450 --> 00:42:22,650
.كما توقعت حينها

474
00:42:23,750 --> 00:42:28,220
،شيفا، قد يكون من الصعب العودة لقريتك

475
00:42:28,220 --> 00:42:30,150
...لكني واثق أنه من الداخل

476
00:42:30,850 --> 00:42:31,760
...شيفا

477
00:42:32,760 --> 00:42:34,270
.لا فائدة بعد الآن

478
00:42:35,700 --> 00:42:37,080
ما الذي تتحدثين عنه؟

479
00:42:37,890 --> 00:42:38,870
...لا تقولي لي

480
00:42:39,640 --> 00:42:42,200
.كلا، أنت بخير

481
00:42:43,890 --> 00:42:47,090
—كلا أيها المعلم أنا

482
00:42:47,090 --> 00:42:48,150
.لا عليك

483
00:42:48,630 --> 00:42:50,580
.سأهتمّ بالأمر بطريقة ما

484
00:42:50,770 --> 00:42:51,730
.ليس هذا ما في الأمر

485
00:42:52,080 --> 00:42:56,090
...قبل أن ألتقي بك، قبل وقت طويل

486
00:42:53,240 --> 00:42:54,420
...لا عليك

487
00:42:55,040 --> 00:42:56,090
!لا عليك

488
00:43:07,740 --> 00:43:09,550
.ستكونين على ما يرام

489
00:43:23,100 --> 00:43:25,730
هل سننام هنا الليلة؟

490
00:43:25,730 --> 00:43:27,070
.أجل

491
00:43:27,070 --> 00:43:29,200
.غربت الشمس سلفا

492
00:43:29,200 --> 00:43:31,300
.لا يعجبني شكل تلك الغيوم أيضا

493
00:43:31,300 --> 00:43:32,700
.فلنرتح هنا

494
00:43:33,370 --> 00:43:35,610
،إن تخصلنا من بعض هذا الغبار

495
00:43:35,610 --> 00:43:37,750
.فهذا المكان ليس سيئا

496
00:43:49,590 --> 00:43:50,650
.أجل

497
00:43:51,880 --> 00:43:53,540
.لا تطفئ النور

498
00:43:59,380 --> 00:44:02,410
.ليلة سعيدة

499
00:44:43,910 --> 00:44:46,200
من عساه يكون في هذا الوقت المتأخر؟

500
00:44:46,970 --> 00:44:49,380
.يسعدني أنك سمعتني

501
00:44:49,380 --> 00:44:52,090
،كنت في طريق العودة إلى القرية

502
00:44:52,090 --> 00:44:55,210
.وشاهدت أضواء في المنزل لذا أتيت لألقي نظرة

503
00:44:55,680 --> 00:44:56,610
ما رأيك؟

504
00:44:56,610 --> 00:44:59,160
هل تريد مغادرة هذا المكان والذهاب للداخل؟

505
00:44:59,160 --> 00:45:02,260
.حصلت قريتنا على إذن من الملك

506
00:45:02,710 --> 00:45:06,730
.أقدّر لك لطفك لكن لا بأس

507
00:45:06,730 --> 00:45:09,470
.لا تقلق، لم يأتِ الجنود بعد

508
00:45:09,470 --> 00:45:12,110
.إن غادرت الآن فستتمكن من الذهاب مع بقية القرويّين

509
00:45:09,510 --> 00:45:11,490
لمَ الآن؟

510
00:45:12,110 --> 00:45:14,480
يعلمون بخصوص لعنة شيفا؟

511
00:45:14,480 --> 00:45:15,520
كيف؟

512
00:45:17,900 --> 00:45:19,450
!لا عليك، اذهب فحسب

513
00:45:19,450 --> 00:45:21,570
.حسنا، فهمت

514
00:45:21,570 --> 00:45:23,120
،ربما لست مضطرا لإخبارك بهذا

515
00:45:23,120 --> 00:45:26,020
.لكن القرية في هذا الطريق إن اتجهت غربا

516
00:45:26,020 --> 00:45:28,810
.في الخلف، هنالك منزلان إلى جانب بعض

517
00:45:29,010 --> 00:45:31,300
...لولا اللعنة

518
00:45:32,160 --> 00:45:34,910
.سنغادر في ظهيرة الغد

519
00:45:34,910 --> 00:45:37,520
.تعال إن غيّرت رأيك

520
00:45:43,720 --> 00:45:47,040
هل من أمر يمكنني فعله؟

521
00:45:48,840 --> 00:45:53,130
هل ستعرف هي أيضا وحدة أن تكون ملعونة؟

522
00:45:54,540 --> 00:45:55,480
.هذا كثير

523
00:45:56,960 --> 00:46:00,560
...عدم معرفة شكل ما تبحث عنه

524
00:46:03,180 --> 00:46:05,850
...أن تتركك الحياة والزمن

525
00:46:08,200 --> 00:46:11,530
.كل شيء

526
00:46:17,800 --> 00:46:21,320
...أن تعاني تلك الفتاة من خلال كل هذا أيضا

527
00:46:31,080 --> 00:46:35,280
ما الذي سيبقى من أجلي يا ترى؟

528
00:46:38,820 --> 00:46:40,510
...ما الذي

529
00:46:46,400 --> 00:46:48,560
يمكنني فعله من أجل شيفا؟

530
00:46:53,490 --> 00:46:54,770
...روح

531
00:46:59,610 --> 00:47:02,740
...ليته كانت لديّ روح

532
00:47:29,000 --> 00:47:30,520
.سأذهب من الخلف

533
00:47:31,090 --> 00:47:32,630
.لا خيار آخر أمامي

534
00:47:32,630 --> 00:47:33,780
...هذا كل ما يمكنني فعله

535
00:47:38,960 --> 00:47:43,250
لكن هل هذا ما كانت لترغب فيه؟

536
00:47:45,220 --> 00:47:46,700
ما الذي أفكّر فيه؟

537
00:47:46,700 --> 00:47:49,330
—إن فعلت هذا، فسوف

538
00:47:50,200 --> 00:47:51,230
.سأعود

539
00:47:51,860 --> 00:47:52,860
—ما

540
00:47:53,060 --> 00:47:54,160
!كلا

541
00:47:55,820 --> 00:47:58,320
!أيها الوحش

542
00:47:58,320 --> 00:47:58,880
!انتظر

543
00:47:58,880 --> 00:47:59,980
!اهرب

544
00:47:58,880 --> 00:48:00,820
!توقف! أفلتني

545
00:47:59,980 --> 00:48:01,070
!إنه دخيل

546
00:48:01,070 --> 00:48:01,860
!اهربوا

547
00:48:01,860 --> 00:48:02,510
!توقف

548
00:48:02,510 --> 00:48:03,570
!ابتعد

549
00:48:03,950 --> 00:48:04,970
!اهربوا

550
00:48:04,970 --> 00:48:06,010
!توقف عن ذلك

551
00:48:11,530 --> 00:48:13,730
!ابتعد عني

552
00:48:19,490 --> 00:48:23,280
بهذه النيران، ستدرك القرى المحيطة
.أنّ أمرا ما ليس على ما يرام

553
00:48:25,630 --> 00:48:27,180
...لن أهاجم أيّ قرى

554
00:48:29,040 --> 00:48:30,880
...أخيرا

555
00:48:32,120 --> 00:48:34,660
...يمكننا الذهاب للداخل أخيرا

556
00:48:35,920 --> 00:48:39,320
ما دمت لن أنشر اللعنة

557
00:48:44,030 --> 00:48:45,490
—لحظة، ماذا

558
00:48:53,790 --> 00:48:54,830
!انتظر

559
00:48:54,830 --> 00:48:56,600
!لحظة، لم أقم بلمسك

560
00:48:58,680 --> 00:48:59,570
...كلا

561
00:49:01,830 --> 00:49:02,830
...كلا

562
00:49:04,910 --> 00:49:09,830
ما الذي... فعلته؟

563
00:49:18,120 --> 00:49:21,570
.يبدو أنّ تلك الروح دون فائدة الآن

564
00:49:22,630 --> 00:49:26,160
...أردت فقط أن تقوم شيفا

565
00:49:33,030 --> 00:49:37,740
.هنالك مكان أريدك أن تأخذني إليه

566
00:49:39,550 --> 00:49:41,760
.حسنا

567
00:50:26,190 --> 00:50:27,560
،شيفا

568
00:50:27,560 --> 00:50:29,600
أحضرت هذا من أجلي، صحيح؟

569
00:52:16,380 --> 00:52:17,610
.هذه هي

570
00:52:40,340 --> 00:52:42,520
.احتفظي بها من أجلي

571
00:54:03,460 --> 00:54:05,220
.أبعد بقليل

572
00:54:08,920 --> 00:54:10,820
.احرص على ألا تفقد أثرنا

573
00:54:11,260 --> 00:54:13,180
.لا تفقد أثرنا

574
00:54:44,720 --> 00:54:45,800
.ها نحن ذا

575
00:54:46,280 --> 00:54:47,600
.أجل، ها نحن ذا

576
00:55:00,870 --> 00:55:03,010
.هذه أقرب بقعة

577
00:55:05,380 --> 00:55:07,410
.لقد عدنا يا والدتي

578
00:55:08,970 --> 00:55:12,820
.لا نملك روحا لكننا سنعيد هذه

579
00:55:13,640 --> 00:55:16,180
.لدينا ضيف هذا اليوم

580
00:55:19,350 --> 00:55:21,500
...يمكنني سماع أمر ما

581
00:55:22,010 --> 00:55:23,690
.إنها والدتنا

582
00:55:23,690 --> 00:55:25,870
.إنه صوتها

583
00:55:25,870 --> 00:55:27,900
.إنه أشبه بصوت

584
00:55:28,640 --> 00:55:30,290
.لا تبدو مثل كلمات

585
00:55:31,090 --> 00:55:32,830
.إنها أشبه بأغنية

586
00:55:38,900 --> 00:55:42,650
.والآن، حاول التحدث إلى والدتنا

587
00:55:48,470 --> 00:55:50,080
.لديّ خدمة أطلبها منك

588
00:55:52,810 --> 00:55:53,920
،رجاءً

589
00:55:55,640 --> 00:55:57,190
.أرغب في مساعدتك

590
00:55:58,070 --> 00:56:00,980
.أرجوك أن تخبريني كيف أزيل اللعنة عن هذه الفتاة

591
00:56:04,160 --> 00:56:06,590
.سأقوم بكل ما يمكنني فعله

592
00:56:07,280 --> 00:56:09,280
.إنها نوري

593
00:56:14,270 --> 00:56:17,790
.كنت في الظلام دائما

594
00:56:19,040 --> 00:56:21,000
،من دون شيفا

595
00:56:21,880 --> 00:56:23,740
.كنت لأبقى هكذا للأبد

596
00:56:25,030 --> 00:56:26,800
،أنسى أن أتنفس

597
00:56:26,800 --> 00:56:28,560
..أن أحرّك قلبي

598
00:56:28,560 --> 00:56:31,020
...أنام، كل شيء

599
00:56:31,480 --> 00:56:34,440
...ألم نسيان وفقدان كل شيء

600
00:56:34,440 --> 00:56:35,700
...لا أريدها أن

601
00:56:38,710 --> 00:56:40,050
...رجاءً

602
00:56:40,440 --> 00:56:41,100
...لا يوجد

603
00:56:42,060 --> 00:56:45,640
.ما يمكنني فعله من أجلها

604
00:56:46,360 --> 00:56:48,750
...رجاءً، روح شيفا

605
00:56:50,760 --> 00:56:52,990
،إن استطعت سماع صوتي

606
00:56:54,190 --> 00:56:56,500
.أرجوك أن تكسري هذه اللعنة

607
00:57:01,760 --> 00:57:03,070
...شيفا

608
00:57:07,040 --> 00:57:09,950
...لم أستطع

609
00:57:10,830 --> 00:57:12,360
...فعل أيّ شيء

610
00:57:13,240 --> 00:57:14,180
...من أجلك

611
00:57:25,870 --> 00:57:28,220
...يمكنني فقط

612
00:57:31,650 --> 00:57:33,420
.البقاء إلى جانبك

613
00:57:45,710 --> 00:57:47,360
هل تفهم؟

614
00:57:47,360 --> 00:57:49,910
.كما قالت والدتنا تماما

615
00:57:50,950 --> 00:57:56,300
.كان يجدر بكم معرفة معناه أنتم أيضا

616
00:57:58,520 --> 00:58:00,280
...عرفت ذلك

617
00:58:01,070 --> 00:58:04,250
.أنّ لكلّ شيء حدود

618
00:58:08,830 --> 00:58:12,280
...شيفا، ألا يمكنني

619
00:58:14,840 --> 00:58:17,330
سوى أن أتلقى منك؟

620
00:59:49,020 --> 00:59:49,830
...كلا

621
00:59:55,980 --> 00:59:56,580
...كلا

622
00:59:57,120 --> 00:59:59,360
!معلمي، كلا

623
00:59:59,880 --> 01:00:01,600
!لا تذهب

624
01:00:01,990 --> 01:00:03,890
!ابقَ معي

625
01:00:06,160 --> 01:00:08,480
.حسنا. سأفعل ذلك

626
01:00:22,000 --> 01:00:23,570
حتى وإن استطاع شخصٌ مثلي

627
01:00:25,400 --> 01:00:28,070
...أن يصبح نورك

628
01:00:47,680 --> 01:00:49,030
.معلمي

629
01:00:51,270 --> 01:00:54,680
.أعتقد أنّ حلما راودني

630
01:00:55,400 --> 01:00:58,490
.كان حلما مخيفا للغاية

631
01:00:58,490 --> 01:01:03,080
كان مكانا هادئا ومظلما وظننت أنني سأصبح
.بمفردي مجددا

632
01:01:03,830 --> 01:01:06,460
.لا تقلقي، أنا هنا

633
01:01:16,700 --> 01:01:19,040
.آسفة على أخد هذه دون إذن

634
01:01:19,460 --> 01:01:22,210
.لا عليك. شكرا لك يا شيفا

635
01:01:22,770 --> 01:01:27,480
.بفضلك، تمكنت من الشعور بأهمية الاحتفاظ بها

636
01:01:27,480 --> 01:01:28,400
.فهمت

637
01:01:28,400 --> 01:01:29,680
هلا فتحتها؟

638
01:01:33,720 --> 01:01:35,840
شيـ.... فا"؟"

639
01:01:59,070 --> 01:02:02,120
.معلمي، يمكنني المشي

640
01:02:22,960 --> 01:02:23,790
،معلمي

641
01:02:26,420 --> 01:02:27,130
.تفضل

642
01:02:32,620 --> 01:02:34,550
.شكرا لك يا شيفا

643
01:02:56,560 --> 01:02:58,720
.معلمي، شكرا لك على الانتظار

644
01:02:58,720 --> 01:03:01,050
هلّا عدنا؟

645
01:03:01,050 --> 01:03:01,880
!حسنا