1
00:00:03,450 --> 00:00:05,090
إنّها بعيدة جدّاً الآن

2
00:00:05,090 --> 00:00:05,940
تين-ني

3
00:00:07,000 --> 00:00:08,010
ريكو

4
00:00:09,050 --> 00:00:10,400
مضى وقت طويل

5
00:00:10,400 --> 00:00:12,610
كنتُ أشاهدك في التّلفزيون

6
00:00:12,610 --> 00:00:15,630
رأيتُ فيديوهات لتريغر يغنّون أيضاً

7
00:00:16,380 --> 00:00:17,910
ولك وأنت تبكي

8
00:00:22,420 --> 00:00:27,040
أسعدني سماعك تقول بأنّك مسرور
باستمرارك في الغناء

9
00:00:30,280 --> 00:00:33,530
حالما تنتهي موب، ما رأيك أن تأتي إلى المنزل؟

10
00:00:33,530 --> 00:00:36,340
ألا تريد رؤية أبي وأمّي ثانية؟

11
00:00:36,810 --> 00:00:38,760
لم يعودا والدَي

12
00:00:40,430 --> 00:00:42,170
سوف نهزم تريغر اللّيلة

13
00:00:42,530 --> 00:00:45,810
سأريك وأري الجميع يشاهدون أفضل ما لدينا

14
00:00:46,050 --> 00:00:47,610
—لذا إذا ربحتُ، تعال إلى المنزل

15
00:00:47,610 --> 00:00:50,060
لا تُشكّل صفقات معي

16
00:00:50,060 --> 00:00:52,260
نحن نُغنّي للمُعجبين

17
00:00:52,260 --> 00:00:54,060
لا تُعطِ أي أهمّية أخرى للأمر

18
00:00:54,060 --> 00:00:54,400
—لكن

19
00:00:54,400 --> 00:00:57,650
،إذاً هل يمكنك أن تعدني بأنّك ستترك آيدوليش 7

20
00:00:57,650 --> 00:01:02,060
وتعتزل كنجم جماهير وتترك المجال إذا ربحت فرقة تريغر؟

21
00:01:02,060 --> 00:01:02,920
ماذا؟

22
00:01:03,240 --> 00:01:04,500
لا يمكنك، أليس كذلك؟

23
00:01:06,350 --> 00:01:09,420
أعجبتني قدرتي على تنفيذ أمنياتك

24
00:01:09,880 --> 00:01:15,710
أنت من علّمني جمال الشّعور عند إسعاد شخص

25
00:01:15,710 --> 00:01:16,930
...لكن

26
00:01:16,930 --> 00:01:21,680
أثناء يوم الأصدقاء، ظللتَ تُفكّر
حول تريغر بدلاً من المُعجبين

27
00:01:21,680 --> 00:01:23,460
—غير صحيح. أنا

28
00:01:23,460 --> 00:01:27,300
ماذا لو كان الجمهور في الاستديو
أنت عندما كنتَ طفلاً؟

29
00:01:27,750 --> 00:01:32,490
مُحال أن أفعل شيئاً لأزعجهم بحزني

30
00:01:33,190 --> 00:01:35,390
في الوضع الرّاهن، أنا وأنت لا نتّفق في الرّأي

31
00:01:35,390 --> 00:01:39,090
!ما الضير من الرّغبة في مساعدتك ومساعدة تريغر؟

32
00:01:39,090 --> 00:01:43,660
في كلّ الأحوال، ليس عملنا تأجيج المُعجبين

33
00:01:43,660 --> 00:01:46,960
!لماذا ترفض دوماً كلَّ شيء أفعله؟

34
00:01:46,960 --> 00:01:48,900
!أحاول مُساعدتك

35
00:01:48,900 --> 00:01:50,380
لا أريدك أن تساعدني

36
00:01:51,170 --> 00:01:55,840
لكن تخلّيتَ عن كلّ شيء لأجلي

37
00:01:55,840 --> 00:01:58,090
!أنا غاضب الآن

38
00:01:58,090 --> 00:02:01,020
سوف نحتلّ المركز الأوّل في موب
ونربح في أبيض أو أسود

39
00:02:01,020 --> 00:02:03,220
!ونتفوّق على ري:فالي لنكون الأفضل في اليابان

40
00:02:03,220 --> 00:02:06,090
سوف أصبح الاسم الألمع في مجال التّرفيه

41
00:02:06,090 --> 00:02:09,100
!وأستخدم علاقاتي لنشر تريغر بكثافة عبر التّلفزيون

42
00:02:11,440 --> 00:02:12,990
!لا تضحك

43
00:02:12,990 --> 00:02:16,150
سوف نهزم تريغر لذا يترتّب عليك الإصغاء لي

44
00:02:16,150 --> 00:02:17,820
حسناً، لن نخسر

45
00:02:17,820 --> 00:02:23,670
أقسم بمهنتي كنجم جماهير بأنّني سأرفض
طريقتك بكامل جسدي وروحي

46
00:02:23,670 --> 00:02:25,830
غنِّ يا ناناسي ريكو

47
00:02:25,830 --> 00:02:27,000
!أنا جاهز

48
00:02:32,350 --> 00:02:34,500
حسناً، تفضّلا واقرآها

49
00:02:34,500 --> 00:02:37,560
"نجوم الجماهير لا يضربون شركاءهم في الوجه"

50
00:02:37,560 --> 00:02:38,090
حسناً، التّالي

51
00:02:38,090 --> 00:02:40,800
"...إذا كنّا تحت خطر التورّط في شيء خطير"

52
00:02:40,800 --> 00:02:43,010
"اتّصل بالوكالة..."

53
00:02:43,010 --> 00:02:44,030
التّالي

54
00:02:44,030 --> 00:02:47,940
كُفَّ عنّا. وحتّى أنّنا قدّمنا اعتذاراً خطّياً

55
00:02:47,940 --> 00:02:51,940
...حسناً إذاً، لكن لا تنسَ هذا

56
00:02:51,940 --> 00:02:55,070
كلاكما ذو قيمة كبيرة لوكالتنا

57
00:02:55,070 --> 00:02:56,610
،في المرّة المقبلة الّتي تتهوّران فيها

58
00:02:56,610 --> 00:02:59,320
سأحبسكما في خزنة لليلة كاملة

59
00:02:59,320 --> 00:02:59,870
ماذا؟

60
00:02:59,870 --> 00:03:01,030
خزنة؟

61
00:03:01,300 --> 00:03:03,990
ينبغي أن تبدأ موب قريباً

62
00:03:03,990 --> 00:03:06,740
ستبدأ موسيقى الشّعب قريباً

63
00:03:06,740 --> 00:03:10,020
أنا قادمة إليكم من وراء الكواليس قبل الأداء

64
00:03:10,020 --> 00:03:11,960
موب إذاً؟

65
00:03:11,960 --> 00:03:14,610
بدأ السّباق المُتلاعَب به

66
00:03:14,610 --> 00:03:18,380
أجل، أجل. تريغر تفوز، يا لها من مُعجزة

67
00:03:18,660 --> 00:03:22,800
لا أنكر بأنّهم حقّقوا عدداً من المُعجزات بالفعل

68
00:03:22,800 --> 00:03:26,140
المال والعلاقات كانتا كافيّتين
لدفع النّاس للحديث عنهم

69
00:03:26,140 --> 00:03:30,520
لكن تذكّروا، مُشاهديكم لم يكونوا حمقى
لدرجة يتمّ التحكّم بكم فيها

70
00:03:30,520 --> 00:03:33,350
بواسطة شي عديم القيمة للأبد

71
00:03:34,100 --> 00:03:37,020
كنتُ أنا الأحمق، لا تريغر

72
00:03:37,580 --> 00:03:41,030
كانوا يتطلّعون نحو المستقبل دوماً

73
00:03:41,030 --> 00:03:42,920
نحن نجري مُقابلات ما قبل العرض

74
00:03:42,920 --> 00:03:47,690
مُغنّينا التّالي هو فرقة آيدوليش 7 الّتي
تحلّ في المركز الثّاني حاليّاً

75
00:03:47,690 --> 00:03:49,250
هلّا حصلنا على تعليق؟

76
00:03:49,250 --> 00:03:51,510
شرف لنا أن نُعلِن عن ظهورنا الأوّل في موب

77
00:03:51,510 --> 00:03:53,320
—سنبذل قصارى جهدنا كي

78
00:03:52,810 --> 00:03:57,550
—لطالما كنّا نفعل ما بوسعنا! هذا ليس تلاعباً

79
00:03:56,890 --> 00:03:58,840
لذا سوف نفعل ما بوسعنا اليوم، صحيح؟

80
00:03:59,510 --> 00:04:04,940
أجل. استمرّوا في مشاهدتنا كما تفعلون دوماً

81
00:04:04,940 --> 00:04:08,370
كدنا نُحلّ بشكل كامل مؤخّراً

82
00:04:08,370 --> 00:04:08,800
!ماذا؟

83
00:04:08,800 --> 00:04:09,590
!بجدّية؟

84
00:04:09,590 --> 00:04:12,310
بالأحرى، حاولتُ مغادرة المجموعة

85
00:04:12,310 --> 00:04:18,900
لكن أخبرني بعض المُعجبين حينها بأنّهم
يحبّون رؤية آيدوليش 7 منسجمين

86
00:04:18,900 --> 00:04:22,530
رغم أنّه كان من المستحيل أن يعرفوا أنّنا نتشاجر

87
00:04:22,530 --> 00:04:25,490
معنا، ما ترونه هو ما تفهمونه عنّا

88
00:04:25,490 --> 00:04:27,530
شكراً على دعم مجموعة تفتقر للخبرة

89
00:04:27,530 --> 00:04:31,330
وغير مُتحفّظة كمجموعتنا دائماً تعطي
مُعجبيها سبباً للقلق

90
00:04:31,330 --> 00:04:32,120
!سوف نبذل قصارى جهدنا

91
00:04:32,430 --> 00:04:34,250
وماذا يعني؟

92
00:04:34,250 --> 00:04:39,250
شعرتُ وكأنّنيب حمقاء في كلّ مرّة
يتمّ التحكّم بي فيها بواسطتهم

93
00:04:39,580 --> 00:04:43,010
وفنّاننا التّالي هي المجموعة الّتي تحتلّ
المركز الأوّل حاليّاً، تريغر

94
00:04:43,010 --> 00:04:45,070
كيف هو شعوركم الآن؟

95
00:04:45,070 --> 00:04:49,310
نحن مُمتنّون للجميع الّذين سمحوا
لنا الأداء في موب

96
00:04:49,310 --> 00:04:53,270
،ما دام لدينا أصواتنا وأجسادنا
لن نسمح لتريغر تنتهي

97
00:04:53,270 --> 00:04:57,610
شرف لنا دخول موب في المركز الأوّل

98
00:04:57,610 --> 00:05:00,650
ونحن آسفون على كلّ القلق الّذي سبّبناه

99
00:05:02,540 --> 00:05:06,490
،نظراً للظروف، من الصّعب قول هذا بصوتٍ عالٍ

100
00:05:06,490 --> 00:05:10,240
لكن لأجل مُستقبلنا، أريد المركز الأوّل حقّاً

101
00:05:10,240 --> 00:05:12,660
رغم ذلك، لهذه اللّيلة، أريد من النّاس أن يستمتعوا

102
00:05:12,660 --> 00:05:15,120
بأدائنا أكثر ممّا أرغب في أيّ جائزة

103
00:05:15,120 --> 00:05:17,170
أحبّ رؤية ابتسامة الجميع

104
00:05:17,530 --> 00:05:19,110
نحن بخير

105
00:05:19,110 --> 00:05:21,390
نعِدُكم بأنّنا سوف نُسعد الجميع

106
00:05:21,390 --> 00:05:23,760
ستبدأ موسيقى الشّعب عقب هذه الفقرة

107
00:05:24,030 --> 00:05:25,260
رائع للغاية

108
00:05:25,260 --> 00:05:25,670
ماذا؟

109
00:05:26,370 --> 00:05:29,730
ليس وكأنّني كنتُ أتوقّع منهم الانحناء

110
00:05:30,270 --> 00:05:34,930
ليس ذلك فحسب، لكن فهمتُ رسالتهم بوضوح

111
00:05:35,500 --> 00:05:39,940
هل تعتقد بأنّ صدقهم سيصل إلى الجمهور؟

112
00:05:39,940 --> 00:05:41,440
أجل

113
00:05:41,440 --> 00:05:45,700
هذه هي الغاية من أصواتهم الصّريحة

114
00:05:46,070 --> 00:05:49,670
هناك الكثير من الأشياء في هذا
العالم الّتي تُشوّش رؤيتنا

115
00:05:50,040 --> 00:05:56,410
لكن النّاس الّذين يعيشون حياة بصدق
يميّزون الآخرين الّذين يفعلون المثل

116
00:05:56,810 --> 00:05:58,400
الكلمات غير ضروريّة حتّى

117
00:05:58,400 --> 00:06:00,730
لا بُهتان يستطيع أن يحجب ذلك

118
00:06:01,080 --> 00:06:03,420
يحدث التّواصل كما لو أنّهم يمسكون بأيدي بعضهم

119
00:06:03,420 --> 00:06:06,420
"أنت وأنا بذلنا قصارى جهدنا"

120
00:06:06,420 --> 00:06:10,470
"كان ذلك صعباً جدّاً ومُمتعاً في نفس الوقت"

121
00:06:11,110 --> 00:06:15,970
أخبرني يوكي-سان أنّ ذلك سيكون
مؤلماً لكن سيكون ممتعاً أيضاً

122
00:06:15,970 --> 00:06:18,760
في البداية، لم أفهم ما قصدَه

123
00:06:18,760 --> 00:06:21,220
لكن هذا ممتع في نهاية المطاف

124
00:06:21,220 --> 00:06:23,420
،خضعتُ لأمور كثيرة

125
00:06:23,420 --> 00:06:26,130
لكن في هذه اللّحظة، أنا أستمتع كثيراً

126
00:06:26,130 --> 00:06:29,240
أنا أيضاً. أخشى أنّ القيام بما أردتُ

127
00:06:29,240 --> 00:06:32,990
والطريق الّذي اخترتُه سيُسبّب مشكلة للآخرين

128
00:06:32,990 --> 00:06:34,580
لكن الآن، لستُ قلقاً بشأن ذلك

129
00:06:34,580 --> 00:06:37,700
هذا صحيح. أتتذكّر ما يُفترَض أن تقوله؟

130
00:06:37,700 --> 00:06:39,420
"أجل. إنّها "شكراً لكم

131
00:06:40,280 --> 00:06:41,880
شكراً لكم على دعمي

132
00:06:41,880 --> 00:06:43,500
شكراً لكم على السّماح لي بفعل ما أحبّ

133
00:06:43,500 --> 00:06:46,190
شكراً لكم على الابتسام دوماً مهما كلّف الأمر

134
00:06:46,190 --> 00:06:49,880
يسرّني أنا عضو في آيدوليش 7

135
00:06:49,880 --> 00:06:53,600
!لنذهب ونجعل مُعجبينا ومُعجبي تريغر يبتسمون

136
00:06:53,600 --> 00:06:57,470
نحن الوحيدون في العالم الّذين نستطيع فعل ذلك

137
00:06:57,470 --> 00:06:58,680
اسمعوا

138
00:06:58,940 --> 00:07:00,710
لديّ طلب

139
00:07:01,090 --> 00:07:02,560
أريد حقّاً هزيمة تريغر

140
00:07:02,560 --> 00:07:03,710
!أيّها الأحمق

141
00:07:04,020 --> 00:07:06,400
جميعنا يراودنا نفس الشّعور بالطبع

142
00:07:10,010 --> 00:07:12,110
ناغي؟ ما الخطب؟

143
00:07:12,490 --> 00:07:15,780
لا شيء. لنهزم تريغر

144
00:07:15,780 --> 00:07:16,700
!أجل

145
00:07:16,970 --> 00:07:20,530
تين، ريو. ثمّة شيء مهمّ أريد
مناقشته حالما ينتهي هذا

146
00:07:20,530 --> 00:07:23,250
بالطبع. ثمّة شيء أريد مناقشته أيضاً

147
00:07:23,250 --> 00:07:25,120
أنا أوّلاً

148
00:07:25,120 --> 00:07:27,670
لديّ طلب أريد تحقيقه باستماتة

149
00:07:27,670 --> 00:07:29,630
أريد هزيمة آيدوليش 7

150
00:07:30,510 --> 00:07:35,470
لا أستطيع السّماح لأخي الأصغر المُنفصل
أن يستمرّ في المُجازفة

151
00:07:35,470 --> 00:07:39,600
ولو كان قد بلغ العلالي، سوف أوقفه هنا

152
00:07:39,600 --> 00:07:41,750
سأريه ما الّذي يستطيع أخوه الأكبر فعله

153
00:07:41,750 --> 00:07:42,810
شِجار أشقاء من جديد؟

154
00:07:42,810 --> 00:07:45,600
الحياة أشبه بشِجار أشقاء

155
00:07:45,600 --> 00:07:46,530
ليست كذلك حقّاً

156
00:07:46,530 --> 00:07:49,070
حياتكما فريدة من نوعها فحسب

157
00:07:49,450 --> 00:07:50,690
أنا مُبارَك

158
00:07:50,690 --> 00:07:52,770
ينبغي أن أشكر الربّ على ذلك

159
00:07:53,070 --> 00:07:58,120
في حين أنّني سعيد بأنّنا أصبحنا من ضمن
أفضل ثلاثة، مُنافسة تريغر تُوتّرني

160
00:07:59,870 --> 00:08:01,360
ميتسكي

161
00:08:01,360 --> 00:08:02,350
نعم؟

162
00:08:02,350 --> 00:08:06,380
ماذا تفعل عندما تضطرّ للتخلّص من شيء مهمّ؟

163
00:08:07,930 --> 00:08:12,510
أظنّني أقنع نفسي بأنّني ما زلتُ أملك
الذّكريات حتّى بعد التخلّص منه

164
00:08:13,390 --> 00:08:17,470
فهمت. إذاً سوف أتمسّك بالذّكريات وأتخلّص منه

165
00:08:19,500 --> 00:08:21,730
!ما الخطب؟

166
00:08:21,730 --> 00:08:24,730
لا داعي للتخلّص من شيء إذا كان
ثميناً جدّاً لدرجة تُبكيك

167
00:08:24,730 --> 00:08:26,760
يمكنك التمسّك به

168
00:08:29,850 --> 00:08:32,110
حان الوقت تقريباً

169
00:08:32,110 --> 00:08:32,900
!حسناً

170
00:08:37,700 --> 00:08:39,060
لا تفعل

171
00:08:39,060 --> 00:08:40,170
لا أفعل ماذا؟

172
00:08:40,170 --> 00:08:43,420
لا أدري، لكن لا تفعل فحسب

173
00:08:45,640 --> 00:08:48,380
بحر الأضواء يشبه الأضواء الشّماليّة

174
00:08:51,580 --> 00:08:53,760
في بلدي، يُقال بأنّ الأضواء الشّماليّة

175
00:08:53,760 --> 00:08:57,260
هي الضوء الّذي يعكس درع فالكيريا

176
00:08:57,260 --> 00:08:58,250
فا...؟

177
00:08:58,250 --> 00:09:02,200
تُعرَف أيضاً باسم فالكيري. إنّها إلاهات ساحة المعركة

178
00:09:02,200 --> 00:09:06,730
العديد من الإلاهات يبتسِمن لنا

179
00:09:07,810 --> 00:09:10,840
أحبّ هذا المشهد

180
00:09:10,840 --> 00:09:11,900
وكذلك أنا

181
00:09:12,240 --> 00:09:13,770
إنّه جميل

182
00:09:13,770 --> 00:09:17,280
ما كنتُ لأرى هذا المشهد لو لم أطارد تين-ني

183
00:09:17,970 --> 00:09:20,360
سئمتُ التّفكير في الأشياء الصّعبة

184
00:09:20,360 --> 00:09:22,540
بلغتُ هذا المكان

185
00:09:22,910 --> 00:09:25,940
وصلنا إلى هنا لأنّنا مُتكاتِفون

186
00:09:26,860 --> 00:09:33,400
لذا لنُرِ الجمهور جهودنا... بل جهود
الجميع الّذين يقفون في المسرح

187
00:09:33,400 --> 00:09:37,150
مهما كانت الظروف، هناك شيء
فقط يمكننا فعله

188
00:09:37,150 --> 00:09:40,050
لنمنح كلّ ما لدينا الآن

189
00:09:40,050 --> 00:09:41,890
!ها نحن ذا

190
00:09:41,890 --> 00:09:43,100
!أجل

191
00:09:45,540 --> 00:09:51,810
"تبقى مجموعتان في المُنافسة على "موسيقى الشّعب

192
00:09:51,810 --> 00:09:56,700
يُمنَح اللّقب إلى أكثر فنّان في العام إنجازاً

193
00:09:56,700 --> 00:10:02,150
كم شخصاً من بين الجمهور سيدعمنا
في المضيّ قُدماً؟

194
00:10:02,550 --> 00:10:07,310
قال ناناسي-سان أنّ قلوب النّاس وأجسامهم تتغيّر

195
00:10:07,310 --> 00:10:11,380
هذا يجعل التمسّك بنفس الحلم صعباً جدّاً

196
00:10:11,970 --> 00:10:14,700
عندما نُغلِق أفواهنا، تختفي أصواتنا

197
00:10:14,700 --> 00:10:17,450
النّهاية تقبع في الجوار دوماً

198
00:10:17,800 --> 00:10:19,730
إذا كانت الرّياح تهبّ بما نشتهي، فنحن لا نُدرك

199
00:10:20,090 --> 00:10:22,930
بأنّنا نترنّح على حافّة مُنحدَر

200
00:10:23,550 --> 00:10:25,820
المكان مُربك هنا في الأعلى

201
00:10:25,820 --> 00:10:28,690
خطوة وحدة فقط وسنسقط في هاوية

202
00:10:29,300 --> 00:10:30,270
...لكن رغم ذلك

203
00:10:30,270 --> 00:10:33,570
أوّلاً الفرقة الّتي احتلّت المركز الثّني

204
00:10:33,570 --> 00:10:35,700
لم يتراجع زخمها منذ مُشاركتها الأولى

205
00:10:35,700 --> 00:10:37,650
،في العام الماضي ربحوا جايما

206
00:10:37,650 --> 00:10:40,950
وربحوا جائزة نجم الجماهير الذّكَر في أسود أو أبيض

207
00:10:40,950 --> 00:10:43,620
في هذا العام أدّوا في الحفل الافتتاحي لحلبة زيرو

208
00:10:43,620 --> 00:10:46,620
!وحتّى أنّهم أتمّوا رحلة ذكراهم السّنويّة الأولى

209
00:10:46,850 --> 00:10:48,750
أريد أن أستمرّ في رؤية نفس الحلم معاً

210
00:10:48,750 --> 00:10:50,230
!آيدوليش 7

211
00:11:09,950 --> 00:11:12,530
لطالما كنتُ وحيداً

212
00:11:14,890 --> 00:11:16,690
أردتُ أن يعترف بي شخص

213
00:11:18,450 --> 00:11:20,990
أردتُ أن أعيش لأجل شخص

214
00:11:24,690 --> 00:11:27,470
لا أفعلها للحصول على مديح من شخصيّات هامّة

215
00:11:27,470 --> 00:11:30,380
أفعلها كي أحبّ نفسي

216
00:11:32,580 --> 00:11:35,600
أحبّ نفسي عندما أغنّي مع المجموعة

217
00:11:35,600 --> 00:11:38,390
ليس من الخطأ امتلاك هذه المشاعر

218
00:12:28,270 --> 00:12:33,000
ريكو-سان، أخبرتني من قبل أنّك
كنتَ مسروراً لأنّني كنتُ مديرك

219
00:12:33,690 --> 00:12:37,030
لكن أنا المسرور لأنّني تمكّنتُ
من أن أصبح مُديرك

220
00:12:37,880 --> 00:12:40,200
أحبّكم جميعاً حبّاً جمّاً

221
00:12:41,280 --> 00:12:45,780
كانت تلك آيدوليش 7 تؤدّي أغنيتها
"الجديدة، "ناناتسويرو ريالايز

222
00:12:42,780 --> 00:12:44,660
!شكراً جزيلاً

223
00:12:46,150 --> 00:12:48,230
كان ذلك رائعاً

224
00:12:46,540 --> 00:12:47,960
!شكراً

225
00:12:48,230 --> 00:12:50,140
ربّما لا يكون هذا سِباقاً مُتلاعَباً به

226
00:12:50,140 --> 00:12:52,660
حان الوقت أخيراً لتؤدّي هذه المجموعة

227
00:12:52,660 --> 00:12:55,740
هيّا بنا. لنحتفظ بوعدنا للمُعجبين

228
00:12:55,740 --> 00:12:58,770
أجل. اللّيلة هي ليلة الثّورة الّتي بدؤوها

229
00:12:59,000 --> 00:13:01,960
نحن نقف على الخطّ الحدودي بين المسرح والهاوية

230
00:13:01,960 --> 00:13:04,130
سأبقي ذلك في ذهني بينما أرقص

231
00:13:04,460 --> 00:13:06,030
غاكو، ريو

232
00:13:08,990 --> 00:13:10,390
أحبّكم

233
00:13:11,300 --> 00:13:12,640
نعلم

234
00:13:13,890 --> 00:13:15,270
!هيّا بنا يا تريغر

235
00:13:15,640 --> 00:13:16,770
!أجل

236
00:13:18,410 --> 00:13:23,650
من بعض النّواحي، لا فِرقة تستحقّ
"أكثر لقبَ "فِرقة السّاعة

237
00:13:23,650 --> 00:13:26,910
إنّهم أصحاب المركز الأوّل حاليّاً، تريغر

238
00:13:27,900 --> 00:13:31,580
!انسوا كلّ همومكم اللّيلة واستمتعوا بالعرض

239
00:13:32,170 --> 00:13:34,500
نعِدُكم بحلم لا ينتهي أبداً

240
00:13:49,400 --> 00:13:50,800
غِناء مثاليّ

241
00:13:50,800 --> 00:13:52,560
رقص مثاليّ

242
00:13:52,560 --> 00:13:55,810
سوف نترك نسختنا المثاليّة من أنفسنا في هذا لمسرح

243
00:13:55,810 --> 00:13:57,590
لأجل كبريائي

244
00:13:57,590 --> 00:13:58,910
لأجل المُعجبين

245
00:13:58,910 --> 00:14:01,580
لأجل زملاء الفرقة الّذين قاتلوا بجانبي

246
00:15:03,500 --> 00:15:06,710
أدؤهم طاهر دوماً

247
00:15:06,710 --> 00:15:10,130
سيكونون مُحبّبين أكثر إذا أخطؤوا قليلاً

248
00:15:10,250 --> 00:15:12,510
هؤلاء هم تريغر

249
00:15:13,110 --> 00:15:16,430
ماهرون وخرقى في نفس الوقت

250
00:15:17,490 --> 00:15:20,910
ريكو، كذبتُ

251
00:15:20,910 --> 00:15:23,510
أريد هذه الهُتافات

252
00:15:23,510 --> 00:15:27,480
أريد العودة إلى الوقت الّذي بكيتُ فيه لأنّني
كنتُ مغموراً جدّاً بواسطة تلك الهُتافات

253
00:15:27,930 --> 00:15:28,990
...توما

254
00:15:29,340 --> 00:15:31,740
سوف تُفسِد بصرك هكذا

255
00:15:31,740 --> 00:15:35,520
اصمت. ذلك الوغد كوجو تين يغنّي

256
00:15:35,520 --> 00:15:36,460
ماذا تتأمّل؟

257
00:15:36,460 --> 00:15:38,300
هل تكرهه إلى هذا الحدّ؟

258
00:15:38,300 --> 00:15:39,370
!أبغضه

259
00:15:39,370 --> 00:15:42,750
إذاً لماذا تبدو غيّوراً جدّاً؟

260
00:15:43,480 --> 00:15:45,170
!لستُ غيّوراً

261
00:15:45,390 --> 00:15:47,340
أنا غاضب فحسب

262
00:15:47,340 --> 00:15:50,630
فقدَ حقّه في الغناء عندما سئم مُعجبون منه

263
00:15:51,170 --> 00:15:54,190
فلماذا يبتسم بهدوء إذاً؟

264
00:15:54,190 --> 00:15:56,590
ينبغي أن تنجرح أيضاً

265
00:15:57,610 --> 00:15:59,890
أتساءل كيف يستطيعون أن يبتسموا

266
00:15:59,890 --> 00:16:02,640
سيُتقنون أداءهم ويلبّون رغبات المُعجبين

267
00:16:02,640 --> 00:16:06,710
قد يتّهمهم النّاس بأنّهم لا يعرفون النّدم

268
00:16:06,710 --> 00:16:08,820
هذا غير مهمّ

269
00:16:08,820 --> 00:16:12,990
يهتمّون لأمر المُعجبين أمامهم
أكثر ممّا قد يقوله العالم

270
00:16:13,220 --> 00:16:16,300
يعلمون أنّ هذا عملهم

271
00:16:16,990 --> 00:16:19,050
هذا ليس عدلاً يا تين-ني

272
00:16:19,420 --> 00:16:21,780
أنت دائماً رائع ولطيف

273
00:16:34,930 --> 00:16:39,730
إذا بدونا عابسين ولم نبتسم، فقد
نكسب شفقة أحدهم

274
00:16:39,730 --> 00:16:42,180
لكن هذا ليس عملنا

275
00:16:42,180 --> 00:16:43,890
هذه هي الطريقة الوحيدة الّتي نعرفها لنعيش

276
00:16:43,890 --> 00:16:46,980
سوف نواجه مُعجبينا مواجهة كاملة

277
00:16:46,980 --> 00:16:49,340
سوف نجعل عيونهم الجريحة تبتسم

278
00:16:49,340 --> 00:16:52,360
لا مُشكلة. حلمكم لن ينتهي

279
00:16:52,360 --> 00:16:54,060
لن نسمح بذلك

280
00:16:54,060 --> 00:16:58,380
استمرّوا في الابتسام. هذا ما وُجِدنا لأجله

281
00:17:58,390 --> 00:18:00,140
!شكراً جزيلاً لكم

282
00:18:00,140 --> 00:18:03,610
!أهلاً بعودتكم

283
00:18:01,980 --> 00:18:06,390
كانت تريغر تؤدّي أغنيتها الجديدة
"استراحة الفجر"

284
00:18:03,940 --> 00:18:06,390
!أهلاً بعودتكم يا تريغر

285
00:18:06,390 --> 00:18:11,070
لا يمكن أن يكون هذا تلاعُباً

286
00:18:07,570 --> 00:18:09,350
!شكراً لكم

287
00:18:09,350 --> 00:18:11,070
!شكراً جزيلاً لكم

288
00:18:11,420 --> 00:18:12,730
كان ذلك مُذهلاً

289
00:18:12,730 --> 00:18:14,970
هل نُصوّت لهم؟

290
00:18:19,610 --> 00:18:21,170
لا أستطيع أن أقرّر

291
00:18:21,170 --> 00:18:22,750
كانت تريغر مُدهشة

292
00:18:22,750 --> 00:18:24,620
!كنت آيدوليش 7 مُبهرة أيضاً

293
00:18:24,620 --> 00:18:27,220
حسناً، لِمَن ستصوّتين؟

294
00:18:28,820 --> 00:18:30,450
شكراً على الانتظار

295
00:18:30,450 --> 00:18:34,300
حان وقت إعلان النّتائج النّهائيّة

296
00:18:35,030 --> 00:18:42,020
في "موسيقى الشّعب" لهذا العام... الجائزة
...لأكثر فنّان حقّق إنجازاً هذا العام من نصيب

297
00:18:43,400 --> 00:18:44,470
!تريغر

298
00:18:49,730 --> 00:18:50,900
!مرحى

299
00:18:50,900 --> 00:18:51,870
!أجل

300
00:18:55,220 --> 00:18:56,360
أنا مسرور للغاية

301
00:18:58,280 --> 00:19:01,110
!فعلوها! تريغر ربحوا

302
00:19:01,110 --> 00:19:03,490
أنا آسف. لا أصدّق بأنّني فعلتُ ذلك

303
00:19:03,490 --> 00:19:05,790
لا مُشكلة. تهانينا

304
00:19:06,410 --> 00:19:09,500
أكره الاعتراف بذلك، لكن كان ذلك أداء مُمتازاً

305
00:19:09,500 --> 00:19:13,500
!أليس كذلك؟ أولئك الفتيان هم الأفضل

306
00:19:13,500 --> 00:19:15,830
أحسنتم صنعاً يا سادة

307
00:19:16,310 --> 00:19:17,840
تعابير وجوهكم مُدهشة

308
00:19:19,340 --> 00:19:21,060
كان أداء جيّداً

309
00:19:21,060 --> 00:19:24,510
!إنّها واحد ضدّ واحد الآن. سوف نربح المرّة المُقبلة

310
00:19:24,510 --> 00:19:27,350
!لن نخسر. تريغر هي الأفضل

311
00:19:27,350 --> 00:19:28,770
تهانينا

312
00:19:28,770 --> 00:19:32,460
—شكراً لكم. وصلنا إلى هنا بفضل مساعدتكم

313
00:19:32,460 --> 00:19:33,860
تهانينا

314
00:19:33,860 --> 00:19:35,610
مُدهشة كعادتكِ يا فرقة تريغر

315
00:19:36,210 --> 00:19:38,360
لا تقل كلاماً يجعل النّاس يسيئون الفهم

316
00:19:38,760 --> 00:19:39,630
هيّا

317
00:19:39,630 --> 00:19:40,280
ماذا؟

318
00:19:40,280 --> 00:19:42,410
مُصافحة يد القائد ستكون الصّورة المثاليّة، صحيح؟

319
00:19:49,270 --> 00:19:55,280
موسيقى الشّعب لهذا العام تلقّى أكبر
عدد جوائز في تاريخ الجائزة

320
00:19:55,280 --> 00:19:58,040
!الجائزة من نصيب تريغر

321
00:20:00,510 --> 00:20:03,050
استمتعوا ما دامت الفُرصة سانحة

322
00:20:03,050 --> 00:20:05,710
زول، سوف نربج جايما

323
00:20:05,710 --> 00:20:08,510
سيدمّرمون آيدوليش 7 في أسود أو أبيض

324
00:20:08,880 --> 00:20:12,520
عقب ذلك، سوف نعيش في عالمي

325
00:20:12,520 --> 00:20:16,020
أجل، فهمت. شكراً لك

326
00:20:17,370 --> 00:20:21,160
ذكرَ الرّئيسُ أنّه ستنتشر الإشاعات
،إذا زرت المكتب

327
00:20:21,160 --> 00:20:22,820
لذا ليس عليكم المجيء والزيارة

328
00:20:22,820 --> 00:20:23,890
هكذا إذاً

329
00:20:24,430 --> 00:20:27,120
على ذكر الأمر، أليس لديكِ شيء أهمّ تقوله؟

330
00:20:27,120 --> 00:20:30,330
أجل. أعلنتُ الحرب على كوجو

331
00:20:32,440 --> 00:20:36,130
تين سيتفوّق على زيرو، لكنّه
لن يصبح زيرو مُلكك أنت

332
00:20:36,380 --> 00:20:39,550
هذا ليس ما أريد أيضاً

333
00:20:39,550 --> 00:20:41,510
هل تكره زيرو؟

334
00:20:42,280 --> 00:20:45,730
هل ظننت أنّ بوسعي الاستمرار في حبّ نجم جمهير

335
00:20:45,730 --> 00:20:48,210
اختفى وسطَ حلمنا؟

336
00:20:48,210 --> 00:20:53,070
خانَني زيرو. هاروكي خانَ زيرو

337
00:20:53,070 --> 00:20:55,870
إنّه يفرّق أغاني زيرو في كلّ أنحاء العالم

338
00:20:55,870 --> 00:20:59,920
لذا سأحقّق حلمي مع تين بدلاً من ذلك

339
00:20:59,920 --> 00:21:01,720
حرّره

340
00:21:01,720 --> 00:21:04,590
أنتم من يبقونه حبيساً

341
00:21:05,000 --> 00:21:06,870
إنّه لطيف جدّاً

342
00:21:06,870 --> 00:21:09,990
لا يمكنه أن يتخلّى عنكم ولو كنتُم درجة ثانية

343
00:21:09,990 --> 00:21:12,210
نحن مجرّد درجة ثانية وفقاً لمعاييركم

344
00:21:12,210 --> 00:21:14,000
إذا سألتني، أعيش حياة درجة أولى

345
00:21:14,290 --> 00:21:16,820
،رغم اكتشاف شخص يُدعى تين

346
00:21:16,820 --> 00:21:19,720
ما زلتَ تردّد اسم زيرو

347
00:21:19,720 --> 00:21:20,920
!أنت نخب ثانٍ

348
00:21:20,920 --> 00:21:22,980
أنا نخب ثاني؟

349
00:21:22,980 --> 00:21:25,960
أنا، الرّجل الّذي صنعَ دُمية أسطوريّة؟

350
00:21:25,960 --> 00:21:28,200
حلمك ولّى منذ زمن بعيد

351
00:21:28,200 --> 00:21:32,720
كلّ ما تملكه هو الخبرة والمعرفة ورماد هوَسك

352
00:21:32,720 --> 00:21:33,930
نحن مختلفون

353
00:21:33,930 --> 00:21:36,690
،نحن نشتعل شغفاً بينما نجري

354
00:21:36,690 --> 00:21:38,730
!ولن أدع أحداً يعترض طريقنا

355
00:21:39,020 --> 00:21:41,980
إنّه ليس زيرو الخاص بك، مفهوم؟

356
00:21:41,980 --> 00:21:43,950
!إنّه كوجو تين من تريغر

357
00:21:45,050 --> 00:21:48,010
كُفّ عن العيش لأجل كوجو وناناسي

358
00:21:48,010 --> 00:21:51,520
لستَ زيرو، ولا أنت بطل خارق

359
00:21:51,520 --> 00:21:53,960
ابدأ بعيش حياتك الخاصّة يا تين

360
00:21:55,630 --> 00:21:58,540
حلمي لم ينتهِ

361
00:21:58,540 --> 00:22:02,920
صنعتُ تين. إنّه مُلهمي

362
00:22:02,920 --> 00:22:08,220
سوية سوف نُحقّق الحلم الّذي
فَشِل زيرو في تحقيقه

363
00:22:08,670 --> 00:22:13,700
!سأدع تين يغنّي أغنية هاروكي الأخيرة

364
00:22:14,390 --> 00:22:16,940
وجدَ مومو-سان مكاناً لنا

365
00:22:16,940 --> 00:22:18,600
!حسناً، لنشرب

366
00:22:18,850 --> 00:22:22,860
يبدو من الغريب الاحتفال مع خصم

367
00:22:22,860 --> 00:22:26,070
استمتعوا، لكن لا تُبالغوا كثيراً

368
00:22:23,320 --> 00:22:24,440
ناغي؟

369
00:22:24,940 --> 00:22:26,070
هل من مُشكلة؟

370
00:22:26,070 --> 00:22:27,690
لا شيء

371
00:22:27,690 --> 00:22:31,050
كنتَ مُبهراً اللّيلة

372
00:22:31,050 --> 00:22:32,920
سيُشكّل ذلك ذكرى رائعة

373
00:22:32,920 --> 00:22:34,120
شكراً

374
00:22:34,120 --> 00:22:38,170
أنت بريء ولطيف، كملاك

375
00:22:38,170 --> 00:22:40,840
آمل أن تستمرّ في دعم الآخرين

376
00:22:40,840 --> 00:22:43,470
ماذا؟ ما الّذي أصابك؟

377
00:22:43,470 --> 00:22:45,180
نظر إللى هذا

378
00:22:45,930 --> 00:22:47,270
اسمي؟

379
00:22:47,270 --> 00:22:48,930
"يُدعى "دايجي

380
00:22:48,930 --> 00:22:52,580
تلك الشخصيّات المُبهرجة الّتي يستخدمونها
لأجل المال وما شابه ذلك

381
00:22:53,030 --> 00:22:57,770
،أخبرني ياماتو من قبل أنّه بدايجي
"الستّة الموجودة في "روكويا ناغي

382
00:22:57,770 --> 00:23:00,140
"تُكتَب باستخدام الحرب في "ريكو

383
00:23:00,140 --> 00:23:07,100
،حقّاً؟ عرفتُ أنّ كلّنا لدينا أرقام في أسمائنا
لكن لدى أسمائنا شيء مُشترَك

384
00:23:07,100 --> 00:23:12,040
لذا ما دمتَ موجوداً، تسلسنا لن يُقطَع أبداً

385
00:23:12,040 --> 00:23:12,740
ماذا؟

386
00:23:15,510 --> 00:23:17,950
سيبقى مثاليّاً وكاملاً