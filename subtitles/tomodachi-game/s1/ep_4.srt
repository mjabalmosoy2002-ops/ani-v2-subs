1
00:00:07,070 --> 00:00:11,790
...لستُ من أفشى سرّ يوتوري-تشان حقًّا

2
00:00:11,790 --> 00:00:12,950
...شيهو-تشان

3
00:00:12,950 --> 00:00:15,820
رجاءً، هلّا تصدّقني يا تينجي-سان؟

4
00:00:16,570 --> 00:00:18,190
.بالطّبع

5
00:00:19,060 --> 00:00:22,460
.في النّهاية، أنا من أفشاه

6
00:00:22,460 --> 00:00:25,040
ساواراغي شيهو تحبّ
.كاتاغيري يويتشي
ونفس ساواراغي
شيهو كانت تواعد
.ميكاسا تينجي

7
00:00:22,460 --> 00:00:27,900
.كتبتُ السّرّ الأوّل وحتّى الثّاني

8
00:00:22,460 --> 00:00:27,960
النّميمة

9
00:00:24,120 --> 00:00:27,960
في الواقع، خضعت ساواراغي
.شيهو إلى عمليّة تجميليّة

10
00:00:27,420 --> 00:00:37,930
النّميمة

11
00:00:27,420 --> 00:00:37,930
كان شيبي ماكوتو يستحمّ
.مع أمّه حتّى الإعداديّة

12
00:00:27,420 --> 00:00:37,930
لم يستحمّ كاتاغيري
.يويتشي ذات مرّة لأسبوع

13
00:00:27,900 --> 00:00:31,190
،أمّا بالنّسبة للآخرين، يحبّ شيبي شيهو-تشان

14
00:00:31,190 --> 00:00:34,110
،وقال يويتشي أنّه سيتعاون معها

15
00:00:34,110 --> 00:00:37,930
لذا لا بدّ أنّ الاثنين اغتابا بعضهما
.من أجل إخراجها من المركز الأوّل

16
00:00:37,930 --> 00:00:41,430
النّميمة حتّى الآن

17
00:00:37,930 --> 00:00:41,430
.ساواراغي شيهو تحبّ كاتاغيري يويتشي
.ونفس ساواراغي شيهو كانت تواعد ميكاسا تينجي

18
00:00:37,930 --> 00:00:41,430
.في الواقع، عضت ساواراغي شيهو إلى عمليّة تجميليّة

19
00:00:37,930 --> 00:00:41,430
.كان شيبي ماكوتو يستحمّ مع والدته حتّى الإعداديّة

20
00:00:37,930 --> 00:00:41,430
.لم يستحمّ كاتاغيري يويتشي ذات مرّة لأسبوع

21
00:00:37,930 --> 00:00:41,430
.كوكوروغي يوتوري كانت تمارس المواعدة بالمقابل في الإعداديّة

22
00:00:37,930 --> 00:00:42,060
،لكن أنا من كشف أكبر الأسرار

23
00:00:42,060 --> 00:00:46,640
!وفعلت كلّ ذلك لأدمّر صداقتها

24
00:01:06,670 --> 00:01:11,340
لصّ

25
00:01:06,670 --> 00:01:11,340
الآباء والأطفال محتالون

26
00:02:21,280 --> 00:02:23,490
.لقد توقّفوا جميعًا

27
00:02:23,490 --> 00:02:27,960
.أجل، لكن هكذا يفترض أن تُلعب لعبة سوغوروكو النمّام

28
00:02:28,450 --> 00:02:32,460
.بذور الشّكّ الّتي زرعت في المباراة الأولى بدأت تنبت

29
00:02:32,460 --> 00:02:34,840
.قريبًا، سيكرهون بعضهم بعضًا

30
00:02:35,150 --> 00:02:37,720
،وإن كان هناك خائن في المجموعة

31
00:02:37,720 --> 00:02:40,500
.فسيكون من المستحيل تقريبًا إعادة صداقتهم

32
00:02:41,050 --> 00:02:44,180
ما الّذي يؤخّركم؟

33
00:02:41,050 --> 00:02:44,180
صوتوا بسرعة

34
00:02:41,050 --> 00:02:44,180
أسرعوا اللعنة

35
00:02:41,050 --> 00:02:44,180
أسرعوا هاهاها

36
00:02:41,050 --> 00:02:44,180
مرحبًا

37
00:02:41,050 --> 00:02:44,180
الفتيات الغيورات مخيفات

38
00:02:41,050 --> 00:02:44,180
أين النمام

39
00:02:41,050 --> 00:02:44,180
لا شيء بعد؟

40
00:02:41,050 --> 00:02:44,180
أسمع

41
00:02:41,050 --> 00:02:44,180
أشعر بالقشعريرة هاهاها

42
00:02:41,050 --> 00:02:44,180
اتضح أنها فوضى عارمة هاهاها

43
00:02:41,050 --> 00:02:44,180
!أصدق شيهو-ساما

44
00:02:41,050 --> 00:02:44,180
غوغوغو

45
00:02:41,050 --> 00:02:44,180
بطيئون جدًا

46
00:02:41,050 --> 00:02:46,930
تينجي-سان، هل صدّقتني عندما قلت أنّني لم أغتب يوتوري؟

47
00:02:46,930 --> 00:02:48,640
.أجل، صدّقتك

48
00:02:48,970 --> 00:02:52,900
من اغتابها برأيك إذًا؟

49
00:02:53,770 --> 00:02:55,160
!شيهو-تشان

50
00:02:55,160 --> 00:02:57,920
،إن بدأت تبحثين عن الفاعل أيضًا

51
00:02:57,920 --> 00:03:00,400
!فلن نستطيع استعادة صداقتنا أبدًا

52
00:03:00,800 --> 00:03:02,530
.أ-أنا آسفة

53
00:03:04,130 --> 00:03:08,280
.كنت أتوقّع هذا السّؤال بالفعل

54
00:03:08,630 --> 00:03:12,610
.مشاعر كوكوروغي-سان تجاه شيهو-تشان دُمّرت بالفعل

55
00:03:12,610 --> 00:03:16,550
،تاليًا، عليّ أن أدمّر مشاعر شيهو-تشان تجاه كوكوروغي-سان

56
00:03:17,530 --> 00:03:23,040
.لكن بما أنّك وقعت في فخّ، أفهم لمَ أنت قلقة بشأن ذلك

57
00:03:23,040 --> 00:03:27,810
،أقول هذا فقط لأنّني إلى جانبك

58
00:03:29,600 --> 00:03:33,240
لكن ماذا إن كتبت كوكوروغي-سان هذا بنفسها؟

59
00:03:34,260 --> 00:03:35,810
!مـ-مستحيل

60
00:03:35,810 --> 00:03:40,740
،يبقى هذا مجرّد تخمين بالطّبع، ولا أريد تصديقه أيضًا

61
00:03:41,090 --> 00:03:45,760
.لكن إن نظرت إلى ذلك، فستتساءلين

62
00:03:50,500 --> 00:03:57,220
ربّما لاحظت بالفعل، لكن أظنّ أنّ
.كوكوروغي-سان تحبّ يويتشي أيضًا

63
00:03:57,730 --> 00:04:01,310
.والآن عرفت أنّك تحبّينه أيضًا

64
00:04:01,890 --> 00:04:04,680
،كوكوروغي-سان لا تثق في نفسها بتاتًا

65
00:04:04,680 --> 00:04:07,850
.وتعلم أنّ شيبي وأنا نحبّك أيضًا

66
00:04:08,310 --> 00:04:11,450
.وتعلم أنّها لن تكسب حبّ يويتشي أبدًا إن كانت خصمك

67
00:04:11,450 --> 00:04:14,100
لذا ربّما كشفت سرّها بنفسها

68
00:04:14,100 --> 00:04:17,420
.وبكت بتلك الطّريقة لتثير عاطفة يويتشي

69
00:04:18,230 --> 00:04:23,360
.ثمّ اتّهمتك بكتابة ذلك لتجعل منك تبدين في مظهر سيّئ

70
00:04:23,360 --> 00:04:26,400
.بالغت في التّفكير حقًّا

71
00:04:26,400 --> 00:04:28,030
.أجل، معك حقّ. آسف

72
00:04:28,820 --> 00:04:34,160
.لكن هذا صحيح، أشعر بالأسف على يويتشي

73
00:04:34,160 --> 00:04:35,170
ماذا؟

74
00:04:35,170 --> 00:04:38,630
يويتشي بريء ولطيف حقًّا، صحيح؟

75
00:04:38,630 --> 00:04:43,880
،إن بدأت فتاة ضعيفة في طلب مساعدته، أشكّ أنّه سيرفضها

76
00:04:44,210 --> 00:04:48,580
.حتّى إن كان يحبّ أحدًا آخر

77
00:04:49,720 --> 00:04:53,710
.بالنّسبة ليويتشي، سيكون ذلك بغيضًا حقًّا

78
00:04:53,710 --> 00:04:56,000
،قد تكون محقًّا

79
00:04:56,000 --> 00:04:59,610
لكن لمَ قد تفضح سرًّا كذلك؟

80
00:05:00,050 --> 00:05:01,860
.أخبرتك لماذا

81
00:05:01,860 --> 00:05:04,670
.أنا إلى جانبك يا شيهو-تشان

82
00:05:04,670 --> 00:05:09,320
.لا أريد أن أراك تتأذّين بعد الآن. هذا كلّ شيء

83
00:05:10,140 --> 00:05:13,000
.حسنًا. سأفكر في الأمر

84
00:05:15,250 --> 00:05:19,850
،قد يكون ذلك ليس كافيًا لإفساد صداقتك مع كوكوروغي-سان

85
00:05:19,850 --> 00:05:22,840
.لكن أظنّه سيُشعل فتيلها على الأقلّ

86
00:05:22,840 --> 00:05:28,430
.مع ذلك، يويتشي، أنت شرّير بحقّ

87
00:05:28,430 --> 00:05:31,150
،فلم تضع شيهو-تشان في هذا فقط

88
00:05:31,150 --> 00:05:33,800
!بل ترغمني أيضًا على أن أشعر هكذا

89
00:05:34,270 --> 00:05:38,150
!يكفي من العاطفة. أسرعوا وعودوا إلى اللّعبة

90
00:05:38,150 --> 00:05:40,650
.أجل، معك حقّ

91
00:05:42,500 --> 00:05:45,230
أعتذر يا تينجي، لكن هلّا تذهب أوّلًا؟

92
00:05:45,230 --> 00:05:47,950
.ماذا؟ أكيد

93
00:05:51,030 --> 00:05:55,330
.حسنًا. سأجذب الشّكّ فقط إن بدوت معارضًا

94
00:05:56,200 --> 00:05:59,880
لنرَ، ماذا أكتب تاليًا؟

95
00:05:59,880 --> 00:06:04,700
بما أنّنا أشعلتُ الفتيل، ربّما أكتب
شيئًا يؤجّج غضب شيهو-تشان أكثر

96
00:06:04,700 --> 00:06:08,090
...ويدمّر صداقتها تمامًا بكوكوروغي-سان

97
00:06:09,160 --> 00:06:10,800
—لا، مهلًا

98
00:06:10,800 --> 00:06:15,180
الفترة 05    الفضاءات المتحرّكة       مقدار الدّين      (المباراة 2 فقط)

99
00:06:10,800 --> 00:06:15,180
شيهو

100
00:06:10,800 --> 00:06:15,180
يوتوري

101
00:06:10,800 --> 00:06:15,180
يويتشي

102
00:06:10,800 --> 00:06:15,180
شيبي

103
00:06:10,800 --> 00:06:15,180
تينجي

104
00:06:10,800 --> 00:06:15,180
‏13 فضاء  - 1,800,000 ين

105
00:06:10,800 --> 00:06:15,180
‏9 فضاء  - 1,000,000 ين

106
00:06:10,800 --> 00:06:15,180
‏8 فضاء  - 1,200,000 ين

107
00:06:10,800 --> 00:06:15,180
‏7 فضاء  - 1,200,000 ين

108
00:06:10,800 --> 00:06:15,180
‏5 فضاء  - 700,000 ين

109
00:06:10,800 --> 00:06:15,180
،أنا متخلّف كثيرًا حاليًّا وأجذب الانتباه

110
00:06:15,980 --> 00:06:20,330
.وقد يشكّون في شيء ما لأنّه لم يغتبني أحد بعد

111
00:06:20,330 --> 00:06:23,350
هل أكتب شيئًا عن نفسي هذه المرّة؟

112
00:06:23,820 --> 00:06:27,650
،ما دمتُ أتعقّب ترتيبنا وأكتب النّميمة بحذر

113
00:06:27,650 --> 00:06:30,450
.لن أجذب الشّكوك نحوي

114
00:06:30,450 --> 00:06:34,540
...وربّما أستطيع أن أستغلّ هذه النّميمة في صالحي

115
00:06:41,810 --> 00:06:45,090
.لم تنته الدّقائق الثّلاث بعد

116
00:06:45,090 --> 00:06:46,960
تُلعب اللّعبة على فترات  -
عليك أن تكشف سرًّا لصديق في كلّ فترة -
قم بتدوينها في بطاقة النّميمة في الغرفة الخاصّة -
فور أن تدخلوا إلى الغرفة الخاصّة، لا يمكنكم مغادرتها لثلاث دقائق -
يمكنكم تدوين قدر ما تريدون عن أيّ شخص -
يمكنكم تقديم بطاقة نميمة فارغة -
يمكنكم الكذب - (إن فُضحت الكذبة، ستعودون إلى الصّفر)
عدد الفضاءات الّتي تنتقلون فيها يُحدّد من قبل استطلاع الرّبّ -

117
00:06:50,890 --> 00:06:51,620
—انتهيت

118
00:06:51,620 --> 00:06:52,870
!يكفي

119
00:06:56,850 --> 00:07:00,390
!يويتشي... صفع شيهو-تشان؟

120
00:07:00,710 --> 00:07:05,980
.آ-آسف يا ساواراغي، لكنّه خطؤك

121
00:07:07,310 --> 00:07:10,360
كيف أمكنك أن تقولي أنّ كوكوروغي كتبت ذلك بنفسها؟

122
00:07:10,750 --> 00:07:12,410
!ذلك مستحيل

123
00:07:12,830 --> 00:07:16,570
هل أخبرت كوكوروغي-سان ما قلت لها؟

124
00:07:17,890 --> 00:07:20,140
.لا تفهم يا يويتشي

125
00:07:22,090 --> 00:07:26,840
.عندما تريد امرأة شيئًا ما بشدّة، ستلعب بدناءة لتحصل عليه

126
00:07:27,730 --> 00:07:30,150
أليس كذلك يا يوتوري؟

127
00:07:30,780 --> 00:07:32,560
.معك حقّ

128
00:07:33,030 --> 00:07:36,600
!كما يخضع بعض النّاس لجراحات تجميليّة ليصبحوا جميلين

129
00:07:39,880 --> 00:07:41,980
!انظر لهذا

130
00:07:41,980 --> 00:07:45,320
ستواصلين ذكر ذلك إذًا؟

131
00:07:46,480 --> 00:07:49,490
،أبقيت الأمر سرًّا لأنّني لم أرد تذكّره حقًّا

132
00:07:51,510 --> 00:07:55,840
".لكنّني لم أخضع لجراحة تجميليّة "لأصبح أجمل

133
00:07:55,840 --> 00:07:58,650
.دخلت في مشكلة قبل وقت طويل وأصبت بندبة في وجهي

134
00:07:58,650 --> 00:08:00,450
.وخضعت لعمليّة للتستّر عليها

135
00:08:01,330 --> 00:08:03,250
أ-أهذا ما حدث؟

136
00:08:03,250 --> 00:08:08,130
.يوتوري، إن كنت لا تصدّقينني، فلا أهتمّ

137
00:08:08,130 --> 00:08:11,510
ماذا عن الأصوات؟

138
00:08:08,130 --> 00:08:11,510
!نميمة دنيئة

139
00:08:08,130 --> 00:08:11,510
أنت مجنونة

140
00:08:08,130 --> 00:08:11,510
بدأت الأمور تصبح حماسية الآن هاها

141
00:08:08,130 --> 00:08:11,510
لكن ما هي النتائج؟

142
00:08:08,130 --> 00:08:11,510
نالي منها هاهاها

143
00:08:08,130 --> 00:08:11,510
أسرعوا وصوتوا

144
00:08:08,130 --> 00:08:11,510
هل نسوا اللعبة؟

145
00:08:08,130 --> 00:08:11,510
بادروا

146
00:08:08,130 --> 00:08:11,510
أراهن أن الحركة القادمة ستكون كبيرة هاها

147
00:08:08,130 --> 00:08:11,510
!أسرعوا اللعنة

148
00:08:08,130 --> 00:08:14,090
!لكن إن واصلت مهاجمتي هكذا، فسأكفّ عن الوثوق بك أيضًا

149
00:08:15,090 --> 00:08:16,720
حسنًا. لا أهتمّ

150
00:08:16,720 --> 00:08:20,430
.ما دام يويتشي يصدّقني

151
00:08:21,950 --> 00:08:26,810
وعدتني أن تصدّقني مهما كان، أليس كذلك يا يويتشي؟

152
00:08:27,230 --> 00:08:29,320
.نعم

153
00:08:29,690 --> 00:08:31,240
!يويتشي

154
00:08:31,810 --> 00:08:33,820
.انتهى الأمر الآن

155
00:08:33,820 --> 00:08:38,370
.انهارت صداقة كوكوروغي-سان وشيهو-تشان تمامًا

156
00:08:38,370 --> 00:08:42,610
.وبدأت تتوتّر علاقة يويتشي وشيهو-تشان أيضًا

157
00:08:42,610 --> 00:08:45,940
.لم أتوقّع حدوث هذا وأنا غافل

158
00:08:45,940 --> 00:08:47,500
!يا لحظّي

159
00:08:48,410 --> 00:08:52,710
.آسف يا شيهو-تشان. ما كان يجب أن أقول ذلك

160
00:08:52,710 --> 00:08:54,880
.لا، ليس كذلك

161
00:08:54,880 --> 00:08:56,050
...لكن

162
00:08:56,390 --> 00:08:59,030
،أردت الحديث إليها لتوضيح الأمور

163
00:08:59,030 --> 00:09:02,930
.لكنّها لم تتقبّل الأمر وأزعجتني

164
00:09:02,930 --> 00:09:06,880
.لكن لا بأس. لا أريد الحديث إلى يوتوري أو يويتشي بعد الآن

165
00:09:07,310 --> 00:09:09,000
!شيهو-تشان

166
00:09:09,000 --> 00:09:12,440
،بما أنّ يويتشي يقول أنّه سيصدّق كوكوروغي-سان مهما كان

167
00:09:12,770 --> 00:09:15,110
!إذًا سأصدّقك مهما كان

168
00:09:16,240 --> 00:09:17,650
!لذا ابتهجي

169
00:09:17,650 --> 00:09:22,370
.لكن أعلم أنّني لا أستطيع تعويض يويتشي

170
00:09:23,130 --> 00:09:26,580
.هذا غير صحيح. أنا ممتنّة حقًّا

171
00:09:28,860 --> 00:09:30,470
!هذا عظيم

172
00:09:30,470 --> 00:09:34,750
!بدأ قلب شيهو-تشان يبتعد عن يويتشي ويتفتّح لي

173
00:09:34,750 --> 00:09:38,470
