1
00:00:03,020 --> 00:00:04,490
أحسنت عملًا

2
00:00:04,490 --> 00:00:06,330
وأنت أيضًا، أراك غدًا

3
00:00:06,330 --> 00:00:07,360
أجل

4
00:00:11,630 --> 00:00:13,020
...صحيح

5
00:00:16,810 --> 00:00:19,100
تبدو بخيرٍ يا أوياما

6
00:00:21,750 --> 00:00:24,910
كوراتا كوزو، ما الذي تفعلينه في اليابان؟

7
00:00:31,380 --> 00:00:34,010
أتساءل من كانت تلك المرأة

8
00:00:34,010 --> 00:00:38,510
.لا أملك أدنى فكرة
فأوياما لا يتحدّث عن نفسه أبدًا

9
00:00:38,510 --> 00:00:43,850
،لا نعلم أيّ شيءٍ عنه
ولا عن مكان إقامته حتّى

10
00:00:43,850 --> 00:00:47,770
أظنّه متحفّظًا جدًّا كي يبقى بعيدًا عن الناس

11
00:00:48,270 --> 00:00:52,030
!أوياما-كُن، أحسنت عملًا

12
00:00:52,970 --> 00:00:55,870
يبدو أنّ أوياما لديه أكثر من سرٍّ واحد

13
00:02:31,020 --> 00:02:32,710
حسنًا، لقد غادر

14
00:02:34,040 --> 00:02:35,130
!فلنذهب

15
00:02:35,130 --> 00:02:38,620
!فريق كشف أسرار أوياما، انطلقوا

16
00:02:43,050 --> 00:02:44,570
...فقط لأوضّح الأمور

17
00:02:44,570 --> 00:02:48,310
لقد أتيتُ معكم فقط لأنّني قلقٌ
من أنّكم الثلاثة قد تتسبّبون بالمتاعب

18
00:02:48,310 --> 00:02:51,130
لستُ مهتمًّا بحياة أوياما الشخصية

19
00:02:51,130 --> 00:02:52,810
أكيد، أكيد

20
00:02:53,220 --> 00:02:56,610
سوف ننتهي فور أن نكتشف أين يعيش أوياما

21
00:02:57,890 --> 00:03:00,320
!لا تتوانوا أيتها الوحدة 2

22
00:03:00,310 --> 00:03:01,970
!هيا، هيا، هيا

23
00:03:02,730 --> 00:03:04,660
!لا بد أنّك تمزح

24
00:03:05,820 --> 00:03:08,310
!هذا غير منصفٍ أبدًا

25
00:03:15,350 --> 00:03:17,660
إنها غلطتك لأنك خسرت
في لعبة حجر ورقة مقص

26
00:03:17,660 --> 00:03:20,100
!إن كان لديكَ نفسٌ للتذمّر، فلتدعس أكثر

27
00:03:20,100 --> 00:03:21,590
!تبًّا

28
00:03:21,590 --> 00:03:25,050
لكن أتساءل حقًّا أين يعيش أوياما

29
00:03:25,050 --> 00:03:28,050
أتخيّله يعيش في غرفةٍ نموذجية في شقّة شاهقة الارتفاع

30
00:03:28,050 --> 00:03:30,810
شيءٌ غير مريحٍ تمامًا

31
00:03:30,810 --> 00:03:34,940
لا، بل أظنّه يعيش في مكانٍ أشبه
بقصرٍ مع وجود خادمٍ وعمّال

32
00:03:34,940 --> 00:03:43,230
بوسعي أن أتخيّله يقول ليلة هنيئة لصورةٍ
مؤطّرةٍ لأبيه وأخته قبل خلوده للنوم

33
00:03:43,820 --> 00:03:47,060
!هل تتحدّث عن منزلي؟
!كيف تعلم ذلك حتّى؟

34
00:03:47,060 --> 00:03:50,410
ماذا؟ أتفعل كلّ ذلك حقًّا؟

35
00:03:50,950 --> 00:03:53,830
أين ذهب أوياما؟

36
00:03:54,740 --> 00:03:56,750
المكان مكتظٌ حقًّا

37
00:03:56,750 --> 00:03:58,840
أجل، إنّنا في شارعٍ للتسوق

38
00:04:01,330 --> 00:04:05,090
!هناك، لقد ترجّل عن دراجته ويسير بين الحشد

39
00:04:06,630 --> 00:04:07,970
!إنه سريع

40
00:04:07,970 --> 00:04:11,850
إنّه يتحرّك بسرعةٍ كبيرة لدرجة
!أنّ بقيّة الناس يبدون وكأنهم لا يتحرّكون

41
00:04:11,850 --> 00:04:14,440
!هل أدركَ أنّنا نلاحقه؟

42
00:04:14,440 --> 00:04:15,600
!لا تفقدوا أثره

43
00:04:16,250 --> 00:04:17,940
!معذرةً يا آنسة

44
00:04:17,940 --> 00:04:19,600
!أجل، أعتذر

45
00:04:19,600 --> 00:04:20,990
هذا اللحم لذيذٌ جدًّا

46
00:04:21,420 --> 00:04:23,490
!لا تجعل نفسك أثقل

47
00:04:26,570 --> 00:04:28,310
!ها هو، إنه أوياما

48
00:04:28,310 --> 00:04:29,990
!لقد وصل إلى هناك بالفعل

49
00:04:34,370 --> 00:04:36,390
!لقد حلّق؟

50
00:04:41,090 --> 00:04:42,220
لا يعقل

51
00:04:42,220 --> 00:04:43,760
!أحقًّا ما فعله؟

52
00:04:47,190 --> 00:04:48,430
!هل نجى من ذلك؟

53
00:04:48,430 --> 00:04:50,010
أيها الوحش

54
00:04:58,450 --> 00:05:00,140
أظنّ أنّ هذا يعني أنّنا لا يجب أن نتبعه

55
00:05:02,910 --> 00:05:07,450
لكن لمَ تراه يتمادى إلى هذا الحدّ ليخفي وجهاته؟

56
00:05:07,450 --> 00:05:10,900
لعلّ منزله مكانٌ آمن؟

57
00:05:10,900 --> 00:05:14,540
مكانٌ آمن، حيث تمّ حذف كلّ المعلومات

58
00:05:14,980 --> 00:05:18,850
لهذا لا يريد من أيّ أحد أن يدخل حيزه الشخصي

59
00:05:19,950 --> 00:05:22,670
...لا يبدو هذا غريبًا عليه، لكن

60
00:05:24,550 --> 00:05:27,490
!لقد وصلنا إلى هذا الحد لذا لا يمكننا التراجع الآن

61
00:05:27,490 --> 00:05:28,800
!زايزن

62
00:05:35,310 --> 00:05:38,670
هل أنت غبيّ يا زايزن؟
!ثمّة درج هناك

63
00:05:41,810 --> 00:05:44,450
هلّا ساعدتني؟ لا أستطيع النهوض

64
00:05:44,450 --> 00:05:46,820
!لأنّك تحمّست كثيرًا وقفزت

65
00:05:58,330 --> 00:06:02,330
مضى وقتٌ طويل مذّ فقدنا أثره

66
00:06:02,330 --> 00:06:04,840
لعلّه وصل إلى بيته بالفعل

67
00:06:07,490 --> 00:06:09,840
أتودّون أن نذهب إلى ذلك المتجر هناك؟

68
00:06:10,340 --> 00:06:14,270
أنا جائع، فلمَ لا؟ سنأكل على حساب زايزن

69
00:06:14,270 --> 00:06:15,850
يبدو أنّي مضطرٌ لذلك

70
00:06:21,690 --> 00:06:22,980
!أوياما

71
00:06:31,700 --> 00:06:34,310
ذلك كثيرٌ بالنسبة له وحده

72
00:06:34,310 --> 00:06:35,740
بل يكفي لإطعام عائلة

73
00:06:35,740 --> 00:06:36,700
...مما يعني

74
00:06:37,010 --> 00:06:38,850
!الهدف قريب...

75
00:06:40,210 --> 00:06:41,630
أهناك؟

76
00:06:48,270 --> 00:06:49,220
ماذا؟

77
00:07:00,530 --> 00:07:02,800
أهذا منزل أوياما؟

78
00:07:02,800 --> 00:07:05,180
إنه لا يشبه ما تخيّلناه مطلقًا

79
00:07:05,830 --> 00:07:07,230
...حسنًا إذًا

80
00:07:07,230 --> 00:07:11,230
!وكأنّ أوياما سيدعنا ندخل إن استأذنّاه

81
00:07:12,860 --> 00:07:14,380
!سوف نقتحم المكان

82
00:07:14,990 --> 00:07:16,990
!هيا، هيا، هيا

83
00:07:20,820 --> 00:07:22,130
!أوياما

84
00:07:27,380 --> 00:07:30,010
!أنت...؟

85
00:07:30,010 --> 00:07:32,370
!إيبوكي سيغو؟

86
00:07:33,730 --> 00:07:37,510
!لديك عقدٌ مع الفريق الرديف لنادٍ إسبانيّ مشهور

87
00:07:37,510 --> 00:07:39,530
!ما الذي تفعله في بيت أوياما؟

88
00:07:40,870 --> 00:07:42,520
لا، بل هذا بيتي

89
00:07:44,370 --> 00:07:46,570
!إذًا، لمَ أوياما هنا يعدّ الطعام؟

90
00:07:47,890 --> 00:07:50,180
لأنّني هزمته في مباراة

91
00:08:06,230 --> 00:08:07,540
شكرًا على الطعام

92
00:08:14,310 --> 00:08:17,060
إنه لذيذ

93
00:08:19,580 --> 00:08:24,060
هل خسرت؟ لا أصدّق

94
00:08:24,780 --> 00:08:28,760
،لقد كان يطبخ لنفسه منذ أن التحق بالمنتخب الوطني

95
00:08:28,760 --> 00:08:31,070
حيث بدأ يتراهن على الطعام المطبوخ منزليًّا

96
00:08:31,070 --> 00:08:33,990
وهكذا تمكنتُ من أكل طعامه في كل مرة

97
00:08:35,700 --> 00:08:38,390
لكنك أصبحت قويًّا حقًّا

98
00:08:38,390 --> 00:08:45,630
زلّةٌ واحدة وما كنتُ لأستطيع تناول
الأوياكودو اليوم

99
00:08:54,350 --> 00:08:56,670
هل سيخوضان مباراةً أخرى؟

100
00:08:57,420 --> 00:09:00,430
صحيح، أين منزل أوياما؟

101
00:09:01,600 --> 00:09:03,490
...إنها مسألةُ يومٍ آخر

102
00:09:16,410 --> 00:09:17,850
!أوياما

103
00:09:23,370 --> 00:09:27,060
أوياما-كُن، أين أنت ذاهب؟
التمرين على وشك أن يبدأ

104
00:09:35,170 --> 00:09:37,700
!أوياما! لن تتغيب عن التدريب، أليس كذلك؟

105
00:09:37,700 --> 00:09:38,740
زايزن-سان

106
00:09:39,610 --> 00:09:41,890
!أيها الجد! أحضر السيارة إلى الأمام

107
00:09:46,660 --> 00:09:49,330
!اتبع تلك الدراجة، أقصد أوياما

108
00:09:49,330 --> 00:09:50,310
!سنعيده

109
00:09:50,310 --> 00:09:51,650
...المعذرة

110
00:09:52,010 --> 00:09:53,180
!اركبي أيضًا

111
00:09:55,010 --> 00:09:58,510
أين يتجه أوياما-كُن؟

112
00:09:58,510 --> 00:09:59,670
لا أدري

113
00:09:59,670 --> 00:10:02,080
ليس وكأنه ذاهبٌ إلى منزله

114
00:10:03,660 --> 00:10:06,200
إنه منزل إيبوكي

115
00:10:07,620 --> 00:10:09,530
ليس ذاهبًا إلى هناك أيضًا

116
00:10:14,380 --> 00:10:19,260
انظروا ما لدينا هنا. وكأنّها معجزة
حيث تهوي فتاةٌ يافعة من السماء

117
00:10:20,340 --> 00:10:24,100
إذًا فقد قرّرتَ أن تنضمّ إلينا أخيرًا يا أوياما؟

118
00:10:26,190 --> 00:10:28,100
أتيت مجدّدًا

119
00:10:33,510 --> 00:10:38,110
.هذا ما يجري إذًا
!أنت من أرسل تلك الفتاة يا تاكيتشي

120
00:10:38,550 --> 00:10:39,410
ماذا؟

121
00:10:39,410 --> 00:10:40,480
ماذا الآن؟

122
00:10:40,480 --> 00:10:44,120
أوياما، لقد خسرتَ احترامي
!بعد أن وقعت في حبّ امرأة

123
00:10:44,460 --> 00:10:45,630
عمّاذا تثرثر؟

124
00:10:45,630 --> 00:10:47,170
!لا تدّعي الغباء

125
00:10:47,170 --> 00:10:48,580
كفّ عن افتعال الضجة

126
00:10:48,580 --> 00:10:49,290
!اخرس

127
00:10:49,290 --> 00:10:51,380
!أنت سبب المتاعب

128
00:10:50,610 --> 00:10:52,850
ما الذي يجري هنا؟

129
00:10:52,850 --> 00:10:54,800
...حسنٌ، هذا

130
00:10:54,800 --> 00:10:56,460
ماذا؟ تريد رؤية عضلات بطني؟

131
00:10:56,460 --> 00:10:58,410
!أيها المجنون المهووس بعضلات البطن

132
00:10:58,410 --> 00:11:01,640
تبًّا، لمَ لا تدخلان الملعب وحسب؟

133
00:11:01,960 --> 00:11:03,580
!هل تسمع يا سيغو؟

134
00:11:07,140 --> 00:11:09,730
لمَ أنت في أوشيغاميمينامي؟

135
00:11:09,730 --> 00:11:14,570
لا أدري لماذا، لكنّ إيبوكي سيلعب معنا الآن

136
00:11:14,570 --> 00:11:15,690
حقًّا؟

137
00:11:16,470 --> 00:11:20,790
مهلًا، أوياما، من الأفضل لكَ ألّا تفكّر في الانضمام
!إلى أوشيغاميمينامي فقط لأنّ إيبوكي هنا

138
00:11:20,790 --> 00:11:22,910
ماذا؟ أحقًّا يا أوياما؟

139
00:11:22,910 --> 00:11:24,290
!كفّ عن فعل ذلك

140
00:11:24,290 --> 00:11:28,900
...سمعتُ أنّ هنالك متجر سوبا بالجوار

141
00:11:28,900 --> 00:11:30,940
لا أستطيع رفض السوبا حقًّا

142
00:11:32,030 --> 00:11:35,470
لقد عاد لأنّه حنّ إلى الطعام الياباني كثيرًا

143
00:11:35,470 --> 00:11:36,550
!ماذا؟

144
00:11:36,550 --> 00:11:40,000
...كوزو عادت معي بالفعل، لكنّ طبخها

145
00:11:40,000 --> 00:11:42,550
!إن كان لديك تعقيب فلتخبرني به الآن

146
00:11:42,550 --> 00:11:45,570
!هـ-هل أنتما سويًّا؟

147
00:11:46,290 --> 00:11:48,100
!إننا صديقا طفولة وحسب

148
00:11:49,090 --> 00:11:51,780
تفضلي، جرّبي عصا السوبا هذه

149
00:11:52,220 --> 00:11:54,560
شـ-شكرًا جزيلًا

150
00:11:58,020 --> 00:11:59,570
عصي السوبا لذيذة

151
00:12:06,860 --> 00:12:07,870
...إيبوكي-سان

152
00:12:09,540 --> 00:12:12,300
أريد أن أتحداك في مباراة واحد ضد واحد

153
00:12:14,670 --> 00:12:17,830
،بعد تناول السوبا اللذيذة
أواجه شخصًا متعجرفًا

154
00:12:18,530 --> 00:12:21,260
ليس بشيءٍ سيئ بعد الوجبة

155
00:12:25,830 --> 00:12:27,830
إذًا، هذه عصا السوبا؟

156
00:12:29,420 --> 00:12:31,360
هل هما هكذا دومًا؟

157
00:12:31,360 --> 00:12:34,350
أجل، دائمًا ما يلعبان مباراةً

158
00:12:34,820 --> 00:12:37,900
إنهما منسجمان لأنهما شاركا في الفريق الوطني معًا

159
00:12:37,900 --> 00:12:39,650
!كنتُ هناك أيضًا

160
00:12:41,690 --> 00:12:44,460
!تاكيتشي-سان، أوقفهما رجاءً

161
00:12:44,460 --> 00:12:46,430
لا، بل فلندعهما يلعبان

162
00:12:47,120 --> 00:12:52,280
إن سار الأمر بخير، فقد نتمكّن من ضمّ
أوياما إلى أوشيغاميمينامي أيضًا

163
00:12:52,280 --> 00:12:58,250
وإن حدث ذلك فسوف نملك خطًّا هجوميًّا
خارقًا من تاكيتشي وأوياما وإيبوكي

164
00:12:58,250 --> 00:13:01,620
حينها لن يكون التتويج المزدوج من البطولة
!الوطنية الصيفية والشتوية مجرد حلم

165
00:13:01,620 --> 00:13:04,630
.لا أعلم بشأن هذا
إنك تفعل هذا فقط لأن المدرب غائب

166
00:13:05,450 --> 00:13:07,380
أوياما-كُن سيفوز، صحيح؟

167
00:13:07,380 --> 00:13:12,640
أجل، لا أتخيّل أنّ أوياما قد يخسر
أمام لاعبٍ آخر من المدرسة الثانوية

168
00:13:13,000 --> 00:13:15,140
أول من يحرز ثلاثة أهداف

169
00:13:15,990 --> 00:13:19,330
تعرف قواعدي إن خسرت

170
00:13:23,150 --> 00:13:26,300
بالنسبة لسيغو، فأوياما يعد فريسةً سهلة

171
00:13:33,670 --> 00:13:34,420
!ماذا؟

172
00:13:37,430 --> 00:13:38,770
أوياما؟

173
00:13:38,770 --> 00:13:39,670
مستحيل

174
00:13:43,210 --> 00:13:45,410
يبدو أنني ضمنتُ عشاء الليلة

175
00:13:49,070 --> 00:13:50,420
!الجولة 2

176
00:13:53,790 --> 00:13:57,560
...طاسة لحم البقر، طاسة التيمبورا، طاسة لحم الخنزير

177
00:13:58,810 --> 00:14:02,440
،أيًّا كان اختياري
!فتوابل أوياما مثالية

178
00:14:03,180 --> 00:14:04,590
فظيع

179
00:14:08,190 --> 00:14:09,740
لقد قررت

180
00:14:10,180 --> 00:14:11,450
!طاسة الكستلاتة

181
00:14:19,020 --> 00:14:20,530
فلنكتف بهذا اليوم

182
00:14:22,290 --> 00:14:24,370
هل انتهت المباراة؟

183
00:14:24,860 --> 00:14:29,000
.سيغو ليس في يومه بتاتًا
أوياما لاحظ ذلك أيضًا

184
00:14:29,000 --> 00:14:30,910
!هذا وهو ليس في يومه؟

185
00:14:31,870 --> 00:14:35,380
تاكيتشي-سان، يبدو أنّك ستخسر
مركزك كمهاجم

186
00:14:35,380 --> 00:14:36,470
!ماذا؟

187
00:14:38,260 --> 00:14:40,230
ما الذي تفعله؟

188
00:14:40,790 --> 00:14:46,580
.إيبوكي سيغو في مستوى آخر
كلّ قدراته تتفوق على أوياما

189
00:14:47,900 --> 00:14:50,620
بالمناسبة، هذا أنت

190
00:14:50,620 --> 00:14:53,240
!ماذا قلت؟ أتريد مواجهتي؟

191
00:14:53,240 --> 00:14:55,220
!لقد اكتفيتُ من هرائك

192
00:14:53,890 --> 00:14:56,240
زايزن-سان، توقف رجاءً

193
00:14:56,240 --> 00:14:57,300
!أنزلني

194
00:14:57,300 --> 00:14:57,840
!اخرس

195
00:14:57,840 --> 00:14:59,250
...أوياما-كُن

196
00:15:06,730 --> 00:15:07,740
!كوزو

197
00:15:11,110 --> 00:15:13,310
هذا أنت يا أوياما

198
00:15:13,310 --> 00:15:14,760
سأدخل

199
00:15:16,140 --> 00:15:17,270
أكيد

200
00:15:19,870 --> 00:15:21,540
هل حدث شيءٌ ما؟

201
00:15:24,530 --> 00:15:27,980
!لذيذ جدًّا! أنت طبّاخٌ عبقريّ بحق

202
00:15:27,980 --> 00:15:29,280
!المزيد رجاءً

203
00:15:30,590 --> 00:15:35,780
ابتهج رجاءً. لا معنى من الفوز هكذا

204
00:15:39,540 --> 00:15:40,610
!كوزو؟

205
00:15:44,430 --> 00:15:45,540
إنه تاكيتشي

206
00:15:46,010 --> 00:15:46,540
لا

207
00:15:50,030 --> 00:15:52,450
هل السبب هو كوراتا كوزو؟

208
00:15:53,190 --> 00:15:56,050
لقد وضعتُ المايونيز

209
00:15:56,940 --> 00:16:00,190
طعام كوزو دائمًا خفيفُ التوابل

210
00:16:03,140 --> 00:16:05,480
!نعيم المايونيز

211
00:16:06,070 --> 00:16:08,070
لقد اكتشفت

212
00:16:09,810 --> 00:16:12,490
!لمَ فعلت ذلك؟ هل أنت غبي؟

213
00:16:12,800 --> 00:16:16,390
!لقد وضعته لأنني أريد الاستمتاع بالوجبة بطريقتي

214
00:16:16,390 --> 00:16:19,240
!أيضًا، فعلتُ هذا لأنّ طبخك سيئ

215
00:16:27,810 --> 00:16:29,260
لقد تخلّصت منكَ إذًا

216
00:16:29,260 --> 00:16:32,720
!لم تفعل! إنما كانت في مزاجٍ سيئ

217
00:16:34,830 --> 00:16:40,830
أستطيع أن أفهم كلّ شيءٍ بوضوح عندما يتعلّق
!الأمر بكرة القدم، لكنّي لا أفهم الفتيات مطلقًا

218
00:16:40,830 --> 00:16:44,650
!أرجوك يا أوياما! ساعدني حتّى لا تظلّ كوزو غاضبةً عليّ

219
00:16:47,370 --> 00:16:48,360
حسنًا

220
00:16:48,700 --> 00:16:49,790
!حقًّا؟

221
00:16:50,230 --> 00:16:52,810
اتّصل بكوراتا كوزو رجاءً

222
00:16:52,810 --> 00:16:55,430
ماذا؟ لماذا؟

223
00:16:56,850 --> 00:16:57,990
موعد

224
00:17:01,340 --> 00:17:04,310
لمَ يريد الخروج في موعدٍ فجأةً؟

225
00:17:05,370 --> 00:17:09,070
ولمَ ارتديتُ هكذا؟ ما الذي أتوقعه حتّى؟

226
00:17:09,070 --> 00:17:10,630
آسف، هل تأخرت عليك؟

227
00:17:10,630 --> 00:17:12,130
لـ-ليس تمامًا

228
00:17:14,130 --> 00:17:15,020
مرحبًا

229
00:17:17,050 --> 00:17:21,610
،إن كانت كوراتا كوزو غاضبة منك
فعليك أن تلتقي بها بينما ترتدي هذا

230
00:17:22,640 --> 00:17:24,730
ماذا؟ ذلك؟

231
00:17:25,270 --> 00:17:27,650
لمَ تملك ذلك حتّى؟

232
00:17:27,650 --> 00:17:32,250
.القطط تشفي الناس
واثقٌ أنّ هذا سيهدّئ من غضبها أيضًا

233
00:17:34,670 --> 00:17:38,410
بدلًا من تهدئتها، أشعر وكأنّني جعلتها أشدّ غضبًّا

234
00:17:39,430 --> 00:17:40,900
...إ-إيبوكي

235
00:17:43,660 --> 00:17:47,380
،علم التغذية، وصفات من الدرجة الأولى

236
00:17:47,380 --> 00:17:51,150
،علم التغذية للرياضيين
...الطعام والتغذية

237
00:17:53,870 --> 00:17:54,730
كوزو

238
00:17:54,730 --> 00:17:56,020
مـ-ماذا؟

239
00:17:56,020 --> 00:17:58,290
أعتذر عن ذلك اليوم

240
00:17:58,290 --> 00:18:00,480
،لم يكن ذلك صائبًا منّي
بينما بذلتِ كلّ ذلك الجهد

241
00:18:00,480 --> 00:18:05,420
صحيح، طعامي ليس خفيف التوابل لأنّي سيئةٌ في الطبخ

242
00:18:05,420 --> 00:18:07,860
،بل لأنّني أحسبُ بعناية القيم الغذائية

243
00:18:07,860 --> 00:18:10,440
!لأجل مراعاة صحتك ومستقبلك

244
00:18:10,790 --> 00:18:13,180
،وإن قمت بشيءٍ كذاك
!فأنتَ تفسد كل تلك الحسابات

245
00:18:18,210 --> 00:18:20,950
...هذا ليس بكثير، لكن تفضلي

246
00:18:21,580 --> 00:18:23,700
سيغو أحضر لي هديةً؟

247
00:18:23,700 --> 00:18:26,420
أيفهم ما أقوم به إذًا؟

248
00:18:27,890 --> 00:18:29,480
هلّي أن أفتحها؟

249
00:18:29,480 --> 00:18:30,850
بالطبع

250
00:18:33,180 --> 00:18:34,910
هدية؟

251
00:18:34,910 --> 00:18:35,850
أجل

252
00:18:35,850 --> 00:18:39,570
أنت عبقري! وماذا يجب أن أهدي لها؟

253
00:18:39,570 --> 00:18:41,470
...فلنرَ

254
00:18:44,900 --> 00:18:46,050
ما هذا؟

255
00:18:47,870 --> 00:18:50,380
حتى إلّم يكن لذيذًا، تستطيعين
أن تتحسّني إن بذلتِ مجهود

256
00:18:50,380 --> 00:18:52,480
!لا أحتاج هذا! هل تسخر مني؟

257
00:18:53,350 --> 00:18:54,700
إنه كتابٌ جيد مع ذلك

258
00:18:59,250 --> 00:19:04,090
أوياما، أشعر أنّ مزاج كوزو يزداد سوءًا

259
00:19:04,090 --> 00:19:06,120
فلننتقل إلى المرحلة التالية

260
00:19:09,810 --> 00:19:11,370
ملعب كرة الصالات؟

261
00:19:12,620 --> 00:19:14,510
اذهبي وغيري ملابسك أيضًا

262
00:19:16,050 --> 00:19:17,130
...لكن

263
00:19:17,780 --> 00:19:19,630
!هيا بنا يا كوزو

264
00:19:20,190 --> 00:19:23,060
!وكأنّني أستطيع هزيمتك في كرة القدم

265
00:19:23,060 --> 00:19:24,220
إنها كرة الصالات

266
00:19:24,220 --> 00:19:26,110
!نفس الشيء

267
00:19:24,450 --> 00:19:29,020
إن تدرّبتما سويًّا فبوسعكما أن تصبحا
صديقين، هذه هي مقدرة الرياضة

268
00:19:29,450 --> 00:19:33,020
!يا مهووس كرة القدم الغبي
!ضقتُ بكَ ذرعًا

269
00:19:34,350 --> 00:19:37,610
!لمَ تظنّني رافقتك إلى إسبانيا؟

270
00:19:40,170 --> 00:19:43,110
!ولمَ تظنّني أعددتُ لكَ طعامًا خفيف التوابل؟

271
00:19:45,630 --> 00:19:48,120
!ولمَ تظنّ أنّني التحقتُ بنفس مدرستك؟

272
00:19:49,980 --> 00:19:52,870
،ذلك لأنّني أحبك

273
00:19:54,410 --> 00:19:57,380
ولأنّني أحبّ مدى حبّك لكرة القدم

274
00:19:59,190 --> 00:20:02,380
!ولأنّني أردتُ أن أساعدك على ذلك

275
00:20:03,460 --> 00:20:05,490
...لمَ لا تستطيع

276
00:20:08,740 --> 00:20:10,140
!أن تفهم ذلك؟...

277
00:20:15,890 --> 00:20:16,710
ماذا؟

278
00:20:18,810 --> 00:20:21,770
يبدو أنكما تشعران بتحسن قليل مجددًا

279
00:20:24,210 --> 00:20:25,420
...هذا الشخص

280
00:20:28,090 --> 00:20:30,820
دائمًا ما ينتهي الأمر هكذا

281
00:20:32,220 --> 00:20:33,670
عرفتُ هذا

282
00:20:34,300 --> 00:20:37,670
سيغو لا يفهمني بتاتًا

283
00:20:37,670 --> 00:20:41,170
لا بد أنه لن يتغير أبدًا

284
00:20:41,810 --> 00:20:44,180
!أجل، لقد فزت

285
00:20:45,660 --> 00:20:47,210
!ما زال الطريق طويلًا أمامك

286
00:20:49,270 --> 00:20:50,420
سيغو

287
00:20:52,310 --> 00:20:56,190
،لقد أحضرتُ معي بعض الطعام
بإمكانك أكله إن أردت

288
00:20:57,290 --> 00:20:59,060
...لعلمك، فالتوابل

289
00:20:59,900 --> 00:21:00,860
!لذيذ

290
00:21:02,070 --> 00:21:03,950
!كوزو، إنه لذيذ

291
00:21:07,460 --> 00:21:10,010
سيغو، آسفةٌ لأنني غضبت منك

292
00:21:10,010 --> 00:21:12,950
ما بالك الآن؟

293
00:21:14,080 --> 00:21:17,870
...إنّك تأكل طعامي بشراهة

294
00:21:20,990 --> 00:21:21,980
...كما تعلمين

295
00:21:22,730 --> 00:21:25,970
!عندما تكون جائعًا، أيّ شيءٍ يكون لذيذًا

296
00:21:27,470 --> 00:21:29,390
!أيها النذل

297
00:21:30,970 --> 00:21:33,410
!ماذا الآن؟ لم أفهم

298
00:21:33,410 --> 00:21:34,880
!سأفسخ علاقتنا

299
00:21:34,880 --> 00:21:36,570
إلى أين أنت ذاهبة؟

300
00:21:36,570 --> 00:21:38,790
!كوزو؟ كوزو-تشان؟

301
00:21:38,790 --> 00:21:40,480
سأفوز في المرة القادمة

302
00:21:41,790 --> 00:21:46,790
ليس بيته وحسب، كلّ شيءٍ
بشأن أوياما غامض

303
00:23:28,860 --> 00:23:36,540
!سا كا ئي! سا كا ئي

304
00:23:35,210 --> 00:23:36,290
بوسعي سماعهن

305
00:23:37,140 --> 00:23:41,500
في الحلقة القادمة