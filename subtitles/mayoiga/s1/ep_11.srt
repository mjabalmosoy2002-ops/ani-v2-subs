1
00:00:28,220 --> 00:00:31,050
!أرجوكِ سامحيني

2
00:02:07,160 --> 00:02:09,400
.عد إلى غرفتك رجاءً

3
00:02:09,710 --> 00:02:11,350
.ستصاب بنزلة برد

4
00:02:11,350 --> 00:02:13,360
.هيا، إليّ بيدك

5
00:02:13,890 --> 00:02:15,820
.لقد عضّت بعوضةٌ مؤخّرتي

6
00:02:15,820 --> 00:02:16,320
.أشعر بالحكّة

7
00:02:16,320 --> 00:02:19,030
.فلنتعانق يا سوي لاتي-سان

8
00:02:19,030 --> 00:02:20,860
!ما بالكم؟

9
00:02:20,860 --> 00:02:22,240
!لمَ أنتم شاردون؟

10
00:02:22,500 --> 00:02:23,960
.فالكانا-سان

11
00:02:23,960 --> 00:02:27,320
،حسنٌ، شعرنا أنّه عملٌ روتينيّ أن نعود إلى غرفنا وننام

12
00:02:27,320 --> 00:02:28,330
...لذا

13
00:02:29,210 --> 00:02:31,670
!هل تناولتم شيئًا سيّئًا أم ماذا؟

14
00:02:31,670 --> 00:02:34,110
...بدل تناول... شيءٍ سيّئ

15
00:02:34,110 --> 00:02:36,440
...أريد أن أنام

16
00:02:36,440 --> 00:02:39,930
...ليس من عادة دوزايمون ألّا يشعر بالجوع

17
00:02:39,930 --> 00:02:41,150
إنه يحافظ على طاقته

18
00:02:41,150 --> 00:02:42,850
...أحسنت عملًا

19
00:02:43,670 --> 00:02:45,200
...ذلك يشعرني بالخجل

20
00:02:45,200 --> 00:02:46,480
.هذا هو حالهم منذ فترة

21
00:02:46,480 --> 00:02:47,680
هل البقية كذلك؟

22
00:02:47,680 --> 00:02:50,690
.أجل، حتّى الذين يستريحون في غرفهم

23
00:02:50,690 --> 00:02:53,740
.ليس وكأنّهم مرضى مع ذلك

24
00:02:53,740 --> 00:02:54,640
،ليسوا مصابين بالحمّى

25
00:02:54,640 --> 00:02:56,260
.ونبضهم طبيعي

26
00:02:56,260 --> 00:02:57,740
.لا ندري ما الذي يجري

27
00:02:58,500 --> 00:02:59,200
!كما توقّعت

28
00:02:59,600 --> 00:03:00,340
...أنتن

29
00:03:00,340 --> 00:03:01,350
!اسمعوا جميعًا

30
00:03:01,350 --> 00:03:03,370
!ليس من الجيّد لنا أن نبقى في هذه القرية

31
00:03:03,910 --> 00:03:06,080
...إن بقيت وحوشنا في الخارج

32
00:03:06,080 --> 00:03:07,830
!فسنتوقّف عن كوننا بشرًا طبيعيين؟

33
00:03:08,210 --> 00:03:11,710
.أجل، "الوحوش" تُدعى ناناكي

34
00:03:11,710 --> 00:03:14,260
...أسمعتم ذلك؟ لسنا بشرًا

35
00:03:14,260 --> 00:03:16,440
...هذا رائعٌ نوعًا ما

36
00:03:17,630 --> 00:03:20,540
.يبدو داهارا-سان غير بشريّ نوعًا ما على ما أظن

37
00:03:20,540 --> 00:03:24,790
.يبدو هذا رائعًا أكثر

38
00:03:24,790 --> 00:03:26,620
.هذا قاسٍ يا نانا-سان

39
00:03:26,620 --> 00:03:28,410
.مع أنّك على حق

40
00:03:29,200 --> 00:03:31,500
ماذا تقصدين بأنّنا سنتوقّف عن العمل؟

41
00:03:31,500 --> 00:03:32,870
!كوني أكثر تحديدًا

42
00:03:32,870 --> 00:03:33,370
ماذا؟

43
00:03:33,370 --> 00:03:34,960
أكثر تحديدًا؟

44
00:03:34,960 --> 00:03:38,110
...مثل أنّ شعورك بذاتك يبدأ بالتلاشي

45
00:03:38,110 --> 00:03:39,650
.أو هكذا شيء

46
00:03:39,650 --> 00:03:40,230
ماذا؟

47
00:03:40,230 --> 00:03:42,020
نتلاشى؟

48
00:03:42,020 --> 00:03:45,060
حسنٌ، لدى مانبي-سان شعرٌ أسود خشن ولامعٌ جدًّا

49
00:03:45,060 --> 00:03:46,120
.لذا ربّما يكون كذلك جيّدًا أيضًا

50
00:03:46,380 --> 00:03:48,940
...هذا قاسٍ يا بيتان

51
00:03:48,940 --> 00:03:50,790
...لكن لا يهم، لا بأس، على ما أظن

52
00:03:51,130 --> 00:03:53,020
!أقلت لا يهم؟

53
00:03:53,020 --> 00:03:55,200
!لا، بل هناك بأس

54
00:03:55,200 --> 00:03:59,460
.يبدو أنّ ناناكي يملك جزءًا من مشاعرك

55
00:03:59,460 --> 00:04:01,370
،لذا إن بقي خارجًا عنك

56
00:04:01,370 --> 00:04:03,510
...فأنت تصبح لا مباليًا

57
00:04:03,510 --> 00:04:05,010
.وعاجزًا أيضًا

58
00:04:06,460 --> 00:04:09,180
!لمَ تركتنّ ريجي ذاك يذهب؟

59
00:04:09,180 --> 00:04:10,930
...حاولنا أن ندعوه لينضمّ إلينا، لكن

60
00:04:10,930 --> 00:04:14,140
!أخبركم بكل ذلك وتركتموه؟ إنكن عديمات الفائدة

61
00:04:14,140 --> 00:04:15,440
...لهذا السبب، النساء

62
00:04:15,440 --> 00:04:16,020
!ماذا؟

63
00:04:16,020 --> 00:04:18,150
لمَ تهين النساء الآن؟

64
00:04:18,360 --> 00:04:19,980
!حسنًا، سأصوغ الأمر بطريقة مختلفة

65
00:04:19,980 --> 00:04:22,360
!أنتِ عديمة الفائدة

66
00:04:24,220 --> 00:04:25,710
...اخرسا

67
00:04:25,710 --> 00:04:27,020
...لا يمكنني أن أنام هكذا

68
00:04:27,450 --> 00:04:29,010
ومن يهتم؟

69
00:04:29,010 --> 00:04:30,670
.دعوا الأمور على نصابها

70
00:04:30,670 --> 00:04:31,910
من يأبه لذلك؟

71
00:04:31,910 --> 00:04:34,160
!هذه ليست أنتِ

72
00:04:34,370 --> 00:04:37,550
...أريد أن أنام وحسب

73
00:04:37,550 --> 00:04:40,130
...إلى الأبد ودون أن يزعجني أي أحد

74
00:04:45,950 --> 00:04:48,740
!ستموتون بئسَ موتٍ جميعكم

75
00:04:49,530 --> 00:04:50,210
...لا

76
00:04:50,210 --> 00:04:51,490
!توقّف

77
00:04:51,490 --> 00:04:54,440
ماذا تظن نفسك فاعلًا؟

78
00:04:54,440 --> 00:04:55,440
...لا

79
00:04:55,440 --> 00:04:56,770
...سأتحوّل إلى خنزيرٍ مشويّ

80
00:04:56,770 --> 00:05:00,290
...أنت نحيلة، لا تقلقي

81
00:05:01,110 --> 00:05:03,840
...ربّما سأودّ شريحةً لو كان خنزيرًا مشويًّا بتوابل تشار سيو

82
00:05:03,840 --> 00:05:05,260
...سهمٌ ناريّ

83
00:05:05,260 --> 00:05:07,900
،ليس فعّالًا تمامًا كسلاحٍ قاتل

84
00:05:07,900 --> 00:05:11,510
...وليس كافٍ لافتعال حريقٍ من مسافةٍ بعيدة

85
00:05:11,510 --> 00:05:13,120
.لذا سأنام

86
00:05:13,360 --> 00:05:14,640
،إن كنتَ تودّ إخافتنا

87
00:05:14,640 --> 00:05:17,340
.فكان عليك أن تجلب شعيلةً مفرقعة على الأقل

88
00:05:17,340 --> 00:05:18,580
كيف لكِ أن تكوني غير مبالية؟

89
00:05:18,580 --> 00:05:20,300
!هراء

90
00:05:26,850 --> 00:05:27,760
!أليس هناك؟

91
00:05:30,620 --> 00:05:31,100
ليون

92
00:05:32,280 --> 00:05:33,890
أنتم لستم جاهزين للحالات الطارئة، أليس كذلك؟

93
00:05:33,890 --> 00:05:36,820
!في هذه الحياة، إمّا أن تكون الصّياد أو الفريسة

94
00:05:36,820 --> 00:05:38,840
!كيف تجرؤ على فعل هذا لامرأة؟

95
00:05:39,750 --> 00:05:42,570
.لا أتراجع فقط لأنّ خصمي امرأة

96
00:05:42,800 --> 00:05:43,960
،فور أن تقوم بسلخ الجلد

97
00:05:43,960 --> 00:05:46,530
.فالجميع يبدون متشابهين

98
00:05:46,530 --> 00:05:47,490
أليس كذلك؟

99
00:05:49,410 --> 00:05:50,890
!أفلتها

100
00:05:50,890 --> 00:05:53,240
!أفلتها، و... أجل، أنصت لما سنقوله

101
00:05:53,240 --> 00:05:54,320
لمَ ستقولونه؟

102
00:05:55,140 --> 00:05:58,460
حسنًا، هل أنصتم لما لديّ من قول؟

103
00:05:59,460 --> 00:06:00,720
!هذا صحيح

104
00:06:00,720 --> 00:06:04,110
!جميعكم قرّرتم أنّ جاك-سان مجرم

105
00:06:04,110 --> 00:06:08,130
أولستَ أنتَ من نعته كذلك أوّلًا؟

106
00:06:08,130 --> 00:06:10,040
.صحيح، لا تلعب دور البريء الآن

107
00:06:10,040 --> 00:06:11,880
.لقد تبت

108
00:06:11,880 --> 00:06:13,350
!تغيّرتُ بعد أن التقيتُ بالزعيم

109
00:06:13,350 --> 00:06:14,170
الزعيم؟

110
00:06:14,170 --> 00:06:16,930
.لقد أصغا لنا الزعيم معًا

111
00:06:17,320 --> 00:06:20,400
،كيفما كان ماضينا أو وضعنا

112
00:06:20,820 --> 00:06:23,900
.فقد تقبّل الزعيم صرخاتنا الصّادقة

113
00:06:23,900 --> 00:06:24,780
!صحيح

114
00:06:24,780 --> 00:06:27,860
...عندما هوجمتُ من قبل جاك-سان، أنقذني الزعيم

115
00:06:27,860 --> 00:06:29,090
.مهلًا

116
00:06:29,640 --> 00:06:32,330
،لأنّ جاك-سان صحّح أخطائي

117
00:06:32,330 --> 00:06:34,080
!استطعتُ أن أقترب من الزعيم

118
00:06:34,080 --> 00:06:36,680
.على كلّ حال، الزعيم هو الأعظم

119
00:06:36,680 --> 00:06:41,040
الزعيم هو السيّدة العذراء التي نزلت على
!هذا العالم الفاسد في آخر الزّمان

120
00:06:41,040 --> 00:06:42,410
السيّدة العذراء"؟"

121
00:06:42,410 --> 00:06:44,000
هل الزعيم امرأة؟

122
00:06:44,270 --> 00:06:44,910
!أجل

123
00:06:44,910 --> 00:06:47,270
!لا تندهشوا كثيرًا

124
00:06:47,270 --> 00:06:48,470
...فزعيمتنا

125
00:06:49,930 --> 00:06:52,450
.ميتسوموني، لا يعقل

126
00:06:53,380 --> 00:06:55,790
هل هربت مع ماساكي، لوحدك؟

127
00:06:59,830 --> 00:07:00,590
ما الأمر؟

128
00:07:01,600 --> 00:07:03,270
.لقد كنّا نبحث عنك

129
00:07:03,270 --> 00:07:05,570
.فلنعد إلى المجموعة

130
00:07:06,230 --> 00:07:07,440
!لا تلمسيني

131
00:07:08,590 --> 00:07:10,900
ألا يمكنك أن تثق بي؟

132
00:07:12,010 --> 00:07:13,030
ماذا؟

133
00:07:13,030 --> 00:07:15,520
ما قصّة الثّقة هذه فجأةً؟

134
00:07:15,520 --> 00:07:19,530
أنت تثق بميتسوموني فقط، صحيح؟

135
00:07:20,850 --> 00:07:21,940
.فهمت

136
00:07:21,940 --> 00:07:25,050
.لقد أتيتُ إلى هنا لذلك السبب أيضًا

137
00:07:25,970 --> 00:07:28,080
،كما شأنك مع ميتسوموني-كُن

138
00:07:28,080 --> 00:07:31,510
.أنا أيضًا كان لديّ شخصٌ أهتمّ له كثيرًا

139
00:07:32,030 --> 00:07:34,280
،هناك ما أودّ أن أقوم به لأجل ذلك الشخص

140
00:07:34,280 --> 00:07:35,310
.ولهذا أتيتُ إلى هنا

141
00:07:35,310 --> 00:07:36,520
ماذا؟

142
00:07:36,520 --> 00:07:38,890
ألم تأتي إلى هنا لبدء حياة جديدة؟

143
00:07:38,890 --> 00:07:42,730
...الأمر صعب عندما لا تثق بأحدٍ تهتم له بعد الآن

144
00:07:42,730 --> 00:07:44,350
ما بالك؟

145
00:07:44,580 --> 00:07:46,170
!أنت لستِ منطقية إطلاقًا

146
00:07:46,170 --> 00:07:47,820
...أجيبي عن سؤالي

147
00:07:51,540 --> 00:07:54,690
مهلًا، هل كانت كوهارون تعرف؟

148
00:07:54,690 --> 00:07:57,490
أكانت تعرف أنّ هذا مكانٌ سيدفع بناناكي للخروج؟

149
00:07:57,820 --> 00:08:00,200
!كانت تعرف إلّا أنّها أحضرتنا إلى هنا؟

150
00:08:00,200 --> 00:08:04,170
لكن لمَ احتاجت أن تحضرنا؟

151
00:08:05,300 --> 00:08:06,130
.سؤال سديد

152
00:08:06,850 --> 00:08:08,480
،إن أرادت أن تُحقّق بقرية ناناكي

153
00:08:08,480 --> 00:08:10,430
.لتمكّنت من فعل ذلك لوحدها

154
00:08:10,430 --> 00:08:14,090
.لا بدّ أنها تملك سببًا من جمع كلّ هذا الوفد إلى هنا

155
00:08:14,310 --> 00:08:16,050
.لربّما كانت خائفةً أن تذهب إليها لوحدها

156
00:08:16,050 --> 00:08:18,580
!الزعيمة ليست مثلكنّ أيتها الفتيات المضجرات

157
00:08:18,580 --> 00:08:20,030
!إنها ليست في مستواكنّ

158
00:08:20,030 --> 00:08:21,220
مضجرات"؟"

159
00:08:22,480 --> 00:08:26,020
.كانت الزعيمة تحاول صنع ناناكي أقوى

160
00:08:26,970 --> 00:08:30,190
.هذه القرية غريبةٌ حقًّا

161
00:08:30,190 --> 00:08:32,680
.هاياتو-كُن، لقد عانيتَ بشدّة

162
00:08:33,210 --> 00:08:36,230
.وقد تعرّضتَ للكثير من الندبات النفسية

163
00:08:36,790 --> 00:08:39,660
...الندبات... النفسية

164
00:08:39,660 --> 00:08:40,880
.أنا حقًّا آسفة

165
00:08:41,830 --> 00:08:44,180
،لقد تكبّدتَ ماضٍ صعب

166
00:08:44,180 --> 00:08:46,780
.وحدثت الكثير من الأمور الصعبة بعد أن أتيت إلى القرية

167
00:08:46,780 --> 00:08:47,130
ماذا؟

168
00:08:48,110 --> 00:08:50,680
.لا أظنّ أن هناك شيئًا أصعب لك من هذا

169
00:08:50,680 --> 00:08:54,090
.ماساكي-تشان سرقت الشخص الذي تكترث لأجله

170
00:08:58,920 --> 00:09:00,470
.أخبرتنا الزعيمة بذلك

171
00:09:00,810 --> 00:09:03,030
.قالت أنّنا مميزان

172
00:09:03,030 --> 00:09:06,190
.قالت أنّ بإمكاننا أن نجعل وحوشنا أقوى

173
00:09:06,590 --> 00:09:07,510
أليس كذلك؟

174
00:09:07,510 --> 00:09:08,150
.أجل

175
00:09:08,150 --> 00:09:12,290
،لقد كانت تحاول استغلال ذلك الأحمق

176
00:09:12,290 --> 00:09:14,690
!لكنّه إنسانٌ أفضل وجبانٌ أكثر مما توقّعت

177
00:09:14,690 --> 00:09:16,360
!قالت أنه سيكون بلا نفع

178
00:09:16,610 --> 00:09:17,230
ماذا؟

179
00:09:18,090 --> 00:09:19,280
...إنسانٌ أفضل

180
00:09:19,280 --> 00:09:21,240
بلا نفع؟

181
00:09:22,490 --> 00:09:26,990
أنت وميتسوموني-كُن قضيتما معًا
،العديد من الأعوام وكوّنتما صداقة قويّة

182
00:09:26,990 --> 00:09:30,710
...لكنّ ماساكي-تشان في أيّامٍ فقط

183
00:09:30,710 --> 00:09:33,230
.لا، هذه ليست غلطة ماساكي-تشان

184
00:09:33,230 --> 00:09:34,740
.إنها فتاةٌ طيبّة

185
00:09:34,740 --> 00:09:36,240
.أظن أنّ الجميع أساء فهمها

186
00:09:36,240 --> 00:09:37,840
هل تدافعين عنها؟

187
00:09:37,840 --> 00:09:38,990
.الأمر ليس كذلك

188
00:09:38,990 --> 00:09:42,400
.لكن أظنّني أستطيع أن أرى لمَ ميتسوموني-سان مهتمٌّ بها

189
00:09:42,400 --> 00:09:42,890
!توقّفي

190
00:09:42,890 --> 00:09:43,790
ماذا؟

191
00:09:43,790 --> 00:09:46,350
.لا أريد أن أسمع المزيد

192
00:09:47,650 --> 00:09:50,540
...توقّفي عن الكلام رجاءً

193
00:09:50,540 --> 00:09:52,210
.لا تتحدّثي عنها

194
00:10:02,650 --> 00:10:04,200
.إنّه قادم

195
00:10:10,890 --> 00:10:13,170
،لا بدّ أن يكون الوقت بين الواحدة والثانية

196
00:10:13,170 --> 00:10:19,020
ويُفترض أن يكون الضباب كثيفًا بحيث
.يكون وضوح الرؤية أقل من 100 متر

197
00:10:19,020 --> 00:10:22,090
.هذه اللّيلة تطابق الشروط اللازمة لدخول قرية ناناكي

198
00:10:22,090 --> 00:10:24,940
.كالليلة التي دخلتم فيها إليها

199
00:10:24,940 --> 00:10:27,170
أهنالك شروط؟

200
00:10:27,170 --> 00:10:27,880
.أجل

201
00:10:27,880 --> 00:10:33,860
سبب عيشي هنا هو أن أمنع الناس من
.الاقتراب من القرية عندما تكون الشروط سائرة

202
00:10:34,210 --> 00:10:36,100
،لأنّني قدّمتُ بحثي

203
00:10:36,100 --> 00:10:38,330
،وانتشرت الشائعات حول قرية ناناكي

204
00:10:38,330 --> 00:10:42,680
وظهر أشخاصٌ مثلكم يريدون تفقّد المكان، صحيح؟

205
00:10:42,680 --> 00:10:43,170
.أجل

206
00:10:43,170 --> 00:10:45,120
.أندم على ذلك

207
00:10:45,120 --> 00:10:47,800
...فقط قلّة مختارة تعرف بشأن الشروط اللازمة

208
00:10:47,800 --> 00:10:49,670
.ولكنها قد يدخل الناس أحيانًا عن طريق الصدفة

209
00:10:50,410 --> 00:10:52,170
...لكن في تلك الليلة

210
00:10:52,170 --> 00:10:55,050
...شعرتُ بنعاسٍ شديد لسببٍ ما و

211
00:10:57,130 --> 00:10:59,180
!يا إلهي، كان ذلك سيحدث في نهاية المطاف

212
00:10:59,180 --> 00:11:01,590
!إنّ الكبار ينامون مبكّرًا ويستيقظون مبكّرًا

213
00:11:02,060 --> 00:11:04,970
!يجب أن نعود قريبًا يا ميتسوموني

214
00:11:04,970 --> 00:11:06,420
،إن لم تستعد ناناكي الخاص بك

215
00:11:06,420 --> 00:11:09,140
!فأنت أيضًا ستشعر بالنعاس في السّابعة مساءً

216
00:11:09,140 --> 00:11:10,020
...أجل

217
00:11:10,020 --> 00:11:10,830
ماذا؟

218
00:11:10,830 --> 00:11:13,850
.لكنّ عمرك لم يزِد يا يوتسون-سان

219
00:11:13,850 --> 00:11:16,480
أهذا لأنّه لم يمضِ الكثير من الوقت؟

220
00:11:16,770 --> 00:11:17,380
ماذا؟

221
00:11:18,080 --> 00:11:20,450
.لقد أحضرتُ ناناكي الخاص بي معي، لا تقلق

222
00:11:20,450 --> 00:11:21,420
ماذا؟

223
00:11:21,420 --> 00:11:24,560
.لقد أردتُ أن أصنع شأنًا لنفسي

224
00:11:24,560 --> 00:11:26,410
،جرّبتُ العديد من الأشياء

225
00:11:26,410 --> 00:11:28,580
،لكن لا أحد قدّرني كثيرًا

226
00:11:28,580 --> 00:11:29,370
.لذا أصبتُ بالإحباط

227
00:11:30,630 --> 00:11:34,190
...ولكن عندما كان النهر يجرّني

228
00:11:35,600 --> 00:11:38,010
تبًّا، هل سأموت حقًّا؟

229
00:11:39,060 --> 00:11:41,360
.تبًّا، أردتُ أن أكون ذا شأن

230
00:11:43,570 --> 00:11:44,510
...أبي... أمي

231
00:11:44,510 --> 00:11:46,370
!مهلًا، لمَ أنتما هنا؟

232
00:11:46,370 --> 00:11:48,030
!لن أكون جيّدًا أبدًا في الموسيقى الكلاسيكية

233
00:11:48,030 --> 00:11:49,880
أنا مغنّي راب، اتّفقنا؟

234
00:11:49,880 --> 00:11:51,610
!لا تضحكا

235
00:11:57,860 --> 00:11:59,420
ما هذا؟

236
00:12:02,700 --> 00:12:04,750
،لا ذراعان ولا ساقان

237
00:12:05,800 --> 00:12:07,080
...فمٌ وحسب

238
00:12:09,660 --> 00:12:12,890
أهكذا كنت؟

239
00:12:13,650 --> 00:12:16,170
.لم أعرف حتى ما أريد فعله

240
00:12:16,170 --> 00:12:20,440
.لم أرد البقاء في الموسيقى الكلاسيكية لأنّي لا أملك موهبةً بها

241
00:12:20,440 --> 00:12:24,290
...أردتُ فقط أن أصنع اسمًا لنفسي

242
00:12:27,320 --> 00:12:30,310
...ذلك ليس جيّدًا أبدًا، أجل

243
00:12:32,410 --> 00:12:36,020
...لذا أدركتُ أخيرًا عندما كنتُ على شفا الموت

244
00:12:41,610 --> 00:12:45,810
!حينها أُلهِمت بي كلمات روحي

245
00:12:45,810 --> 00:12:47,570
كلمات ماذا؟

246
00:12:47,570 --> 00:12:52,050
،حينها أدركتُ أنّه مع أنّي كنتُ سيّئًا حتى الآن

247
00:12:52,050 --> 00:12:58,670
!إلّا أنّي ولدتُ لأكون مغنّي راب، حتّى لو لم أصبح مشهورًا

248
00:12:58,670 --> 00:12:59,640
.أجل

249
00:12:59,640 --> 00:13:02,190
.أجل، يجب أن تحاول حتّى الممات أحيانًا

250
00:13:02,190 --> 00:13:03,130
.أجل

251
00:13:03,130 --> 00:13:06,370
.لذا فقد استطاع يوتسون أن يتقبّل ناناكي الخاص به

252
00:13:06,370 --> 00:13:09,130
.لهذا استطاع أن يغادر قرية ناناكي

253
00:13:09,130 --> 00:13:10,270
!فهمت

254
00:13:10,270 --> 00:13:12,390
!لقد ولدتُ من جديد

255
00:13:12,390 --> 00:13:13,600
...إذًا فكاميساما

256
00:13:13,960 --> 00:13:16,640
،أنا تركتُ ناناكي الخاص بي

257
00:13:16,640 --> 00:13:18,860
.ولهذا آل بي الحال هكذا

258
00:13:19,220 --> 00:13:22,680
.لم أعد أشعر بمشاعر كالكراهية والغضب

259
00:13:22,680 --> 00:13:25,180
،استوعبها على كونها مفاهيم

260
00:13:25,180 --> 00:13:28,200
.لكنها تبدو بعيدة جدًّا

261
00:13:28,520 --> 00:13:33,310
.أشعر بالفعل بشيءٍ كالندم

262
00:13:33,310 --> 00:13:36,240
.ولهذا أبحث عمّا أستطيع فعله

263
00:13:36,240 --> 00:13:38,220
...شيءٌ تستطيع فعله

264
00:13:42,710 --> 00:13:43,890
.يجب أن أعود

265
00:13:44,340 --> 00:13:46,300
.يجب أن أعود مهما كلّف ذلك

266
00:13:55,710 --> 00:13:57,640
حسنًا يا ميتسوموني-كن؟

267
00:13:59,330 --> 00:14:02,110
.لا أرى أي شيء

268
00:14:02,430 --> 00:14:03,120
.كما توقعت

269
00:14:03,120 --> 00:14:04,170
.لن يفلح هذا

270
00:14:04,170 --> 00:14:07,250
.أنت لا تملك ندبات نفسية كافية الآن

271
00:14:07,250 --> 00:14:07,960
ماذا؟

272
00:14:07,960 --> 00:14:10,070
.أنت غريبٌ بالأحرى

273
00:14:10,070 --> 00:14:13,540
الأمر كما لو أنّك تملك جزءًا من ناناكي الخاص
.بك، ولا تملكه في نفس الوقت

274
00:14:13,540 --> 00:14:18,240
،ربّما عالجت ندباتك النفسية بوسائل أخرى

275
00:14:18,240 --> 00:14:19,500
وليس عبر تقبّل ناناكي الخاص بك؟

276
00:14:22,950 --> 00:14:23,920
...ناناكي

277
00:14:24,140 --> 00:14:24,890
ماذا؟

278
00:14:25,440 --> 00:14:28,380
إذًا فميتسوموني لا يمكنه أن يعود إلى قرية ناناكي بعد الآن؟

279
00:14:29,930 --> 00:14:37,310
.قالوا أنّ الماضي الصّعب يتجسّد في وحشٍ مرئيّ

280
00:14:38,050 --> 00:14:40,020
.لا بدّ أنّك واحدة منها

281
00:14:43,490 --> 00:14:46,070
.كنتُ أعرف، لأصدقك القول

282
00:14:46,070 --> 00:14:48,950
.أصبحتُ مدركًا لذلك في مرحلةٍ ما

283
00:14:49,720 --> 00:14:51,910
.لا بأس إن كنتِ لن تسامحينني

284
00:14:52,290 --> 00:14:55,180
.لا بأس إن قتلتني

285
00:15:02,260 --> 00:15:03,500
هذا مؤلم، أليس كذلك؟

286
00:15:06,210 --> 00:15:08,720
إنه حزينٌ ومؤلم، أليس كذلك؟

287
00:15:08,720 --> 00:15:12,180
!أنت تتألمين أكثر من هذا

288
00:15:16,600 --> 00:15:17,720
.فلنتوقف

289
00:15:17,720 --> 00:15:18,960
أنت تتألم، أليس كذلك؟

290
00:15:19,370 --> 00:15:21,520
!أنت تتألمين أكثر

291
00:15:21,520 --> 00:15:23,410
...أيضًا... بعد أن فقدتك

292
00:15:23,410 --> 00:15:26,130
،بعد أن حاولت الابتعاد عن تلك الحقيقة

293
00:15:26,130 --> 00:15:28,530
!شعرتُ بالمزيد من الألم منذ حينها

294
00:15:29,210 --> 00:15:31,120
.سأواجه الحقيقة من الآن فصاعدًا

295
00:15:31,540 --> 00:15:34,690
!لن أحاول أن أنكر أنّي فقدتك

296
00:15:34,690 --> 00:15:38,330
.لكن يا أبي، ستتألم إلى الأبد إن فعلت ذلك

297
00:15:38,330 --> 00:15:39,690
!لا أهتم

298
00:15:39,690 --> 00:15:44,610
!لن أنساك أبدًا

299
00:15:47,000 --> 00:15:47,880
.لقد عدت

300
00:15:49,900 --> 00:15:50,840
ميساتو؟

301
00:15:55,810 --> 00:15:56,760
...أنت

302
00:15:57,520 --> 00:15:59,980
.إذًا فقد استطاعت ميساتو-تشان أن تلتقي بوالدها

303
00:15:59,980 --> 00:16:00,790
.أجل

304
00:16:00,790 --> 00:16:01,430
ماذا؟

305
00:16:02,400 --> 00:16:06,900
.إذًا فقد تقبّلتَ ميساتو-تشان... ناناكي الخاص بك

306
00:16:07,250 --> 00:16:08,860
تقبّلتها؟

307
00:16:09,450 --> 00:16:11,820
.أريد أن أسألك معروفًا

308
00:16:13,450 --> 00:16:15,770
.فلنعد وحسب الآن

309
00:16:16,730 --> 00:16:17,960
...ميتسوموني

310
00:16:24,500 --> 00:16:25,630
!احترس

311
00:16:30,780 --> 00:16:31,770
...هذه الحافلة

312
00:16:31,770 --> 00:16:33,090
.إنها تلك الحافلة

313
00:16:33,090 --> 00:16:35,130
!من أين أتت هذه الحافلة؟

314
00:16:35,130 --> 00:16:36,050
...هذا الطريق يقود إلى

315
00:16:41,410 --> 00:16:42,390
!سيدي؟

316
00:16:42,680 --> 00:16:43,850
!سيدي

317
00:16:45,220 --> 00:16:46,020
!هل أنت بخير؟

318
00:16:46,410 --> 00:16:47,450
.أجل

319
00:16:47,990 --> 00:16:49,480
.أنا سعيدٌ لأجلك يا ميساتو

320
00:16:50,550 --> 00:16:50,940
ماذا؟

321
00:16:52,710 --> 00:16:53,900
...أنت

322
00:16:53,900 --> 00:16:56,270
.إنها... ناناكي الخاص بي

323
00:16:56,270 --> 00:16:56,610
ماذا؟

324
00:16:57,130 --> 00:17:00,710
.ماتت ابنتي بسبب طيشي

325
00:17:00,710 --> 00:17:02,810
.وأصبحت ناناكي

326
00:17:03,730 --> 00:17:05,580
.أنا ميساتو

327
00:17:07,830 --> 00:17:09,000
.مستحيل

328
00:17:09,000 --> 00:17:12,500
!ما رأيناه كانوا وحوشًا عملاقة

329
00:17:12,500 --> 00:17:14,970
.لكنّ الخاصّ بك عادي... ويتكلم

330
00:17:15,180 --> 00:17:18,280
.لستُ وحدي من أستطيع الكلام

331
00:17:18,280 --> 00:17:20,500
.ريجي كذلك

332
00:17:20,500 --> 00:17:21,180
!ريجي؟

333
00:17:21,570 --> 00:17:23,890
هل "ريجي" هذا ناناكي أيضًا؟

334
00:17:23,890 --> 00:17:25,690
!كلّا، ليس كذلك

335
00:17:25,690 --> 00:17:29,510
...قالت ماساكي-سان أنها أتت إلى قرية ناناكي مع ريجي-سان

336
00:17:29,510 --> 00:17:31,820
!ماساكي-سان لا تكذب

337
00:17:31,820 --> 00:17:33,850
.ولستُ بكاذبة أيضًا

338
00:17:34,410 --> 00:17:36,450
.أجل، آسف

339
00:17:36,450 --> 00:17:37,280
.لا بأس

340
00:17:37,280 --> 00:17:39,930
.أنا لستُ ميساتو الحقيقيّة

341
00:17:39,930 --> 00:17:40,370
ماذا؟

342
00:17:40,620 --> 00:17:47,220
.أنا ميساتو مزيّفة خُلِقت عندما اعتذر أبي من ميساتو الحقيقيّة

343
00:17:48,570 --> 00:17:54,140
.لكنّ أبي عانقني بشدّة مع أنّ ذلك آلمه

344
00:17:54,570 --> 00:17:58,260
.لقد عانق ميساتو المزيّفة ورحّب بعودتي

345
00:18:00,350 --> 00:18:02,220
أهذا وداع؟

346
00:18:02,220 --> 00:18:03,820
.ليس وداعًا يا أبي

347
00:18:03,820 --> 00:18:06,310
.أنا سأتّحد معك وحسب

348
00:18:08,040 --> 00:18:08,590
.حسنًا

349
00:18:08,590 --> 00:18:11,670
.لكن لا يمكننا أن نتكلّم مع بعضنا مجدّدًا

350
00:18:12,190 --> 00:18:14,560
.أبي، أنت شخصٌ عظيم

351
00:18:14,560 --> 00:18:18,660
.واثقةٌ أن ميساتو الحقيقية تحبّك

352
00:18:19,820 --> 00:18:22,620
.ميساتو المزيفة تحبّك كثيرًا أيضًا

353
00:18:27,100 --> 00:18:27,970
!اختفت؟

354
00:18:28,950 --> 00:18:30,850
أين ذهبت؟

355
00:18:30,850 --> 00:18:35,240
.لربّما حدث هذا لأنّه تقبّل ناناكي الخاص به

356
00:18:36,370 --> 00:18:38,620
.هذا المدعو ريجي طلب مني أن أسديه معروفًا

357
00:18:38,620 --> 00:18:39,420
ماذا؟

358
00:18:39,420 --> 00:18:42,220
.طلب مني أن أذهب بك إلى قرية ناناكي

359
00:18:42,740 --> 00:18:45,310
.أراد منك أن تنقذ ماساكي

360
00:18:45,770 --> 00:18:46,810
:كما أنّه قال

361
00:18:47,210 --> 00:18:49,770
"أنا هو ناناكي الخاص بماساكي"

362
00:18:49,770 --> 00:18:51,160
.مستحيل

363
00:18:51,160 --> 00:18:54,450
!لكن ماساكي-سان قالت أنّ ريجي ابن عمّها

364
00:18:54,450 --> 00:18:56,000
...وقالت أنهما أتيا إلى قرية ناناكي سويًّا

365
00:18:56,000 --> 00:18:57,240
.مرحبًا

366
00:18:57,830 --> 00:19:00,250
.حسنٌ، هذه هي حقيقة الأمر إذًا

367
00:19:00,250 --> 00:19:03,200
ما رأيك بشأن ريجي هذا يا كاميساما؟

368
00:19:03,580 --> 00:19:04,270
ماذا؟

369
00:19:04,270 --> 00:19:07,130
.لقد تركتُ جهاز الإرسال متّصلًا طوال الوقت

370
00:19:07,130 --> 00:19:08,480
.أنا بتلك الروعة

371
00:19:08,480 --> 00:19:10,920
لذا، هلّا أخبرتنا برأيك رجاءً يا كاميساما؟

372
00:19:10,920 --> 00:19:14,370
،حسنٌ، إن كان ذلك ما قالته ميساتو-سان

373
00:19:14,370 --> 00:19:15,880
.فهي ليست كذبة على الأقل

374
00:19:15,880 --> 00:19:16,430
ماذا؟

375
00:19:16,430 --> 00:19:19,670
.إننا نكذب لنتجنّب الأذى

376
00:19:19,670 --> 00:19:22,330
.بينما ولد ناناكي لأننا مصابون نفسيًا

377
00:19:22,330 --> 00:19:24,960
.من الصعب التصديق أنّ ناناكي سيكذب

378
00:19:24,960 --> 00:19:26,290
.أظن ذلك

379
00:19:26,290 --> 00:19:28,390
،لكن إن كان ذلك صحيحًا

380
00:19:28,800 --> 00:19:32,100
...ماساكي-سان تهتم كثيرًا لريجي-سان

381
00:19:32,100 --> 00:19:35,110
...لقد كانت تتوق لرؤيته

382
00:19:35,110 --> 00:19:37,200
لكن أليس هذا غريبًا؟

383
00:19:37,200 --> 00:19:40,320
لمَ قد يقول ناناكي أنقذ ماساكي؟

384
00:19:40,720 --> 00:19:46,280
.ماساكي-سان على الأرجح لم تدرك أن ريجي-سان هو ناناكي الخاص بها

385
00:19:46,790 --> 00:19:50,460
.إن كانت تعرف، لما كانت متحمّسةً جدًّا لإيجاده

386
00:19:50,460 --> 00:19:52,230
...ماذا؟ لكن

387
00:19:52,230 --> 00:19:54,400
.هذا محزنٌ جدًّا

388
00:19:54,400 --> 00:19:56,650
...إن عرفت الحقيقة

389
00:19:56,650 --> 00:19:59,200
...أنّ ريجي-سان من صنعها

390
00:19:59,200 --> 00:20:02,470
...أنّ لا وجود له في الحقيقة

391
00:20:02,910 --> 00:20:04,590
.ميتسوموني-كُن

392
00:20:04,590 --> 00:20:07,440
.لكن لا يمكنني أن أعود إلى قرية ناناكي

393
00:20:07,930 --> 00:20:10,200
.لا يمكنني أن أساعد ماساكي-سان

394
00:20:10,200 --> 00:20:12,420
!لا يمكنني أن أفعل أي شيء

395
00:20:16,300 --> 00:20:18,070
.فلنذهب إلى قرية ناناكي

396
00:20:20,960 --> 00:20:22,030
!انتظر

397
00:20:22,030 --> 00:20:22,890
!توقف

398
00:20:22,890 --> 00:20:24,000
.لا تستعجل هكذا

399
00:20:24,000 --> 00:20:25,930
...سأسقط

400
00:20:25,930 --> 00:20:27,050
!شكرًا لك

401
00:20:29,330 --> 00:20:31,040
،لا يمكنني أن أرى جيّدًا أمامي

402
00:20:31,250 --> 00:20:32,750
!لكنّ الطريق سيكون قاسٍ

403
00:20:33,530 --> 00:20:34,960
!تابع التقدم رجاءً ولا تتوقف

404
00:20:35,870 --> 00:20:37,790
!سأموت

405
00:20:41,760 --> 00:20:42,410
ماذا؟

406
00:20:43,300 --> 00:20:44,290
ليس هنا؟

407
00:20:47,220 --> 00:20:47,930
!مهلًا

408
00:20:47,930 --> 00:20:50,180
...إن كانت لعبة فالمُسرّع من هنا

409
00:20:56,530 --> 00:20:57,750
...ريجي

410
00:21:04,020 --> 00:21:05,900
.لا، ريجي

411
00:21:05,900 --> 00:21:07,440
.لا تتركني أرجوك

412
00:21:07,440 --> 00:21:09,490
.لطالما كنّا سويًّا

413
00:21:12,910 --> 00:21:14,410
...ريجي

414
00:21:16,050 --> 00:21:18,570
.وجدتك أخيرًا أيتها الساحرة

415
00:21:19,490 --> 00:21:23,160
.لقد تشتّت شملنا بسببك

416
00:21:23,160 --> 00:21:24,710
.وبدأنا نكره بعضنا بعضًا

417
00:21:24,710 --> 00:21:26,200
هذه كانت خطّتك من البداية، أليس كذلك؟

418
00:21:26,200 --> 00:21:26,830
...لا

419
00:21:26,830 --> 00:21:28,550
.يا لك من ساحرةٍ شيطانيّة

420
00:21:28,550 --> 00:21:30,270
!يجب أن تُعدم

421
00:21:30,270 --> 00:21:32,050
.معك حق

422
00:21:32,050 --> 00:21:34,180
.قتلها هو الخيار الوحيد، الآن

423
00:21:36,140 --> 00:21:37,770
!لا يمكنك أن تهربي

424
00:21:37,770 --> 00:21:38,650
!اهربي

425
00:21:38,650 --> 00:21:39,970
!اهربي وكأنّ حياتك مرهونة بذلك

426
00:21:39,970 --> 00:21:43,990
تلك المبيعات لا ترتفع لأنّك لا تقوم بالأمر
!وكأن حياتك مرهونة بذلك

427
00:21:46,340 --> 00:21:48,040
.ريجي، ساعدني

428
00:21:48,040 --> 00:21:49,200
!ريجي

429
00:21:49,680 --> 00:21:50,910
...ميتسوموني-كُن

430
00:21:53,030 --> 00:21:54,870
...سا... عدني

431
00:21:55,790 --> 00:21:58,450
!ميتسوموني-كُن

432
00:22:02,450 --> 00:22:03,340
!الحافلة؟

433
00:22:11,450 --> 00:22:13,540
.لا أملك رخصة قيادة حتّى

434
00:22:13,540 --> 00:22:14,390
.آمل أن الأمر سار بخير

435
00:22:15,600 --> 00:22:16,580
!ما الذي يجري؟

436
00:22:16,580 --> 00:22:17,270
!هو

437
00:22:17,270 --> 00:22:19,110
!إنه وكيلٌ لتلك الساحرة... ماساكي

438
00:22:19,110 --> 00:22:20,560
!لهذا يستطيع استخدام السحر الأسود

439
00:22:20,840 --> 00:22:21,260
ماذا؟

440
00:22:21,260 --> 00:22:22,540
...لا، أنا

441
00:22:23,020 --> 00:22:23,660
مجدّدًا؟

442
00:22:23,660 --> 00:22:25,230
جرّار هذه المرة؟

443
00:22:25,230 --> 00:22:26,680
...كلّا، إنّه

444
00:22:35,450 --> 00:22:37,010
نانا... كي...؟

445
00:24:08,450 --> 00:24:12,560
.مهما تألّمت، فإنّي لم أبالي

446
00:24:13,090 --> 00:24:14,930
،طالما كنت معي يا ريجي

447
00:24:15,180 --> 00:24:17,050
.أستطيع تحمّل ذرف أيّ كمية من الدموع

448
00:24:17,640 --> 00:24:21,060
...لقد كنت أخًا، صديقًا

449
00:24:21,490 --> 00:24:25,310
...لذا إن كان بإمكاني أن أبقى معك، فسوف