.فستواجهين ألمًا كبيرًا

416
00:17:05,320 --> 00:17:06,800
.يجب أن تتحمّليه

417
00:17:08,140 --> 00:17:10,410
،شكرًا على النصيحة

418
00:17:11,010 --> 00:17:14,010
.لكن الجميع يتحدّثون حول البقاء هنا

419
00:17:14,660 --> 00:17:18,470
.نحتاج لإقناعٍ كبير لتغيير رأيهم

420
00:17:18,470 --> 00:17:19,820
.أخبرنا

421
00:17:19,820 --> 00:17:22,930
لمَ ترفض هذا المكان بشدّة؟

422
00:17:24,020 --> 00:17:27,900
أتظنون أنه يمكن تشتيت ناناكي بسهولة؟

423
00:17:27,900 --> 00:17:28,600
ماذا؟

424
00:17:29,230 --> 00:17:33,490
،كنتُ أجري بحوثًا عن قرية ناناكي طوال هذا الوقت

425
00:17:33,490 --> 00:17:36,200
.ولكن تخصصي في علم النفس التجريبي

426
00:17:36,200 --> 00:17:37,570
علم النفس؟

427
00:17:37,570 --> 00:17:39,410
إذًا لمَ قرية ناناكي؟

428
00:17:39,410 --> 00:17:42,550
.كنتُ أبحثُ حول الندوب النفسية

429
00:17:42,550 --> 00:17:43,990
الندوب النفسية؟

430
00:17:43,990 --> 00:17:44,420
.أجل

431
00:17:44,420 --> 00:17:46,810
.لتبسيط الأمر، إنها صدمات

432
00:17:46,810 --> 00:17:50,490
،في السنوات الأخيرة، الغضب قد استولى على علم النفس تقريبًا

433
00:17:50,490 --> 00:17:54,080
.لذا فقد أصبح زملائي في البحث محتاطين جدًّا

434
00:17:54,080 --> 00:17:59,610
.التقينا أُناسًا بندوب نفسية مختلفة للبحث حول أعراضٍ مختلفة

435
00:17:59,610 --> 00:18:02,310
.هكذا عثرنا على قرية ناناكي

436
00:18:02,670 --> 00:18:07,270
.قرية ناناكي هي مكان حيث تتشكّل ندوبك النفسية ماديًّا

437
00:18:07,790 --> 00:18:10,840
.لم أستطع تصديق ذلك في البداية

438
00:18:10,840 --> 00:18:14,360
.لكني وجدتُ العديد من الناس الذي استطاعوا أن يعودوا من قرية ناناكي

439
00:18:14,360 --> 00:18:19,220
.جميعهم كانوا هناك في أوقات مختلفة ولم يتقابلوا أبدًا

440
00:18:19,220 --> 00:18:22,450
،إلا أن تصريحاتهم كانت تتشابه جميعًا

441
00:18:22,450 --> 00:18:24,660
.ممّا يعني أنّها حقيقة وليست كذبة

442
00:18:24,870 --> 00:18:27,570
،بات زملائي مهتمّين بالأمر، لذا

443
00:18:27,570 --> 00:18:30,000
.دعموا بحثي

444
00:18:30,000 --> 00:18:32,720
،تحمّستُ كثيرًا وقدّمتُ النتائج التي توصّلت إليها في مؤتمر

445
00:18:32,720 --> 00:18:34,630
.ولكَ أن تحزر الباقي

446
00:18:34,630 --> 00:18:35,260
ماذا؟

447
00:18:35,260 --> 00:18:37,870
.بالطّبع ظنّوا أنّك مجنون

448
00:18:37,870 --> 00:18:42,140
.أجل، أدار زملائي ظهرهم عليّ أيضًا

449
00:18:42,140 --> 00:18:44,930
.قالوا أنّ بحثي السابق كان ملفّقًا

450
00:18:44,930 --> 00:18:47,400
.وأنّني خُدعتُ من قبل مؤمنين آخرين

451
00:18:47,400 --> 00:18:49,800
لكن ألم يدعموا بحثتك؟

452
00:18:49,800 --> 00:18:51,550
.كلّا

453
00:18:51,550 --> 00:18:54,280
.لم يعودوا معجبين بي

454
00:18:54,280 --> 00:18:57,990
...لقد نِلتُ مرتبةً معيّنة في مرحلة ما، لذا لهذا السبب

455
00:18:57,990 --> 00:18:59,840
!يا إلهي! هذا مأساويّ جدًّا

456
00:18:59,840 --> 00:19:02,430
.أعدّوا لك كي تفشل

457
00:19:03,740 --> 00:19:06,750
ألا تحترمه يا يوتسون؟

458
00:19:06,750 --> 00:19:07,750
بالطّبع، وماذا؟

459
00:19:07,750 --> 00:19:08,450
.لا، لا بأس

460
00:19:08,450 --> 00:19:12,670
...كنتُ منزعجًا حينها، لكن

461
00:19:12,900 --> 00:19:18,130
.استطعتُ أن أصل إلى قرية ناناكي بفضل الكراهية التي شعرتُ بها

462
00:19:18,790 --> 00:19:24,120
،سمعتُ ما يحدث هناك من قبل الناجين

463
00:19:24,120 --> 00:19:26,470
.لذا فقد كانت آمنة نسبيًّا

464
00:19:26,470 --> 00:19:28,340
،لم يكن أي أحد هناك حينها

465
00:19:28,340 --> 00:19:31,320
.لذا فقد شعرتُ وكأنها جنّتي الخاصة

466
00:19:32,110 --> 00:19:35,530
.وقد قابلتُ ناناكي أيضًا بالطبع

467
00:19:35,530 --> 00:19:36,860
.كنتُ متحمّسًا جدًّا

468
00:19:36,860 --> 00:19:40,710
.لأني وجدتُ كل هذه الدلائل لأجل بحثي

469
00:19:40,710 --> 00:19:44,060
.لكني عدتُ عندما استعدتُ وعيي

470
00:19:44,060 --> 00:19:45,070
استدعتَ وعيك؟

471
00:19:45,340 --> 00:19:48,040
.أجل، حدث ذلك في طرفة عين

472
00:19:48,330 --> 00:19:52,080
...كنتُ أحاول أن ألتقط صورة للنباتات التي في منحدر الجبل، و

473
00:19:52,790 --> 00:19:54,330
...عندما عدتُ إلى وعيي

474
00:19:54,750 --> 00:19:56,210
!أكان الأمر بتلك السهولة؟

475
00:19:56,210 --> 00:19:58,920
.لأني خسرتُ ناناكي

476
00:19:58,920 --> 00:19:59,850
.أجل

477
00:19:59,850 --> 00:20:01,840
خسرت ناناكي؟

478
00:20:09,260 --> 00:20:10,820
كيف سارت الأمور من جانبك؟

479
00:20:10,820 --> 00:20:12,860
.لا، لقد أهملتُ دفاعي

480
00:20:12,860 --> 00:20:14,150
—فقد أثرهم بسرعة

481
00:20:17,460 --> 00:20:17,880
!آسف

482
00:20:17,880 --> 00:20:18,530
!توقف رجاءً

483
00:20:18,530 --> 00:20:20,260
!لا تضربني على وجهي أرجوك

484
00:20:20,260 --> 00:20:21,570
!جاك-كُن، رجاءً

485
00:20:21,570 --> 00:20:22,070
.اضربني

486
00:20:22,070 --> 00:20:22,650
ماذا؟

487
00:20:23,150 --> 00:20:25,180
.فقدتُ أثرهم أيضًا

488
00:20:25,180 --> 00:20:26,240
.لذا اضرني مرّةً

489
00:20:26,240 --> 00:20:27,100
...لكن

490
00:20:27,100 --> 00:20:28,040
.اضربني

491
00:20:28,920 --> 00:20:30,360
.حسنًا

492
00:20:32,930 --> 00:20:34,640
.سيغضب الزعيم علينا

493
00:20:34,950 --> 00:20:36,770
.سنُهجَر معًا

494
00:20:36,770 --> 00:20:37,610
...لكن

495
00:20:40,050 --> 00:20:44,330
.رحل ناناكي منذ أن غادر جسدي

496
00:20:44,330 --> 00:20:48,320
.هويته الحقيقية كان بحثي الذي سخر منه الجميع

497
00:20:48,320 --> 00:20:53,770
.لكنّي تخلّصتُ من الوحش الذي من شأنه أن يصادق عليه

498
00:20:53,770 --> 00:20:55,090
.آسف

499
00:20:55,090 --> 00:20:56,890
.لا أعي ما تفهمه حقًّا

500
00:20:56,890 --> 00:20:58,910
لكن بما أنّك هربت من ناناكي الخاص بك

501
00:20:58,910 --> 00:21:00,810
،وتستطيع أن تتقبّل أن بحثك صحيحًا

502
00:21:00,810 --> 00:21:02,490
أليست هذه نهاية سعيدة؟

503
00:21:02,490 --> 00:21:04,560
.ألق نظرة كثيفة بتلك الصورة

504
00:21:04,560 --> 00:21:05,010
ماذا؟

505
00:21:06,390 --> 00:21:06,860
حسنٌ؟

506
00:21:06,860 --> 00:21:08,660
هل أبدو رائعًا؟

507
00:21:08,660 --> 00:21:09,200
ماذا؟

508
00:21:09,200 --> 00:21:10,960
.تبدو رائعًا

509
00:21:10,960 --> 00:21:12,580
.انظر أكثر

510
00:21:12,580 --> 00:21:14,580
.انظر إلى اليمين السفلي للصورة

511
00:21:14,920 --> 00:21:19,290
...صورة حديثة للأستاذ المساعد، كامياما، أبريل 2013

512
00:21:19,290 --> 00:21:22,000
ماذا؟

513
00:21:20,010 --> 00:21:21,460
!قبل ثلاث سنوات؟

514
00:21:22,000 --> 00:21:23,600
!هذه صدمة

515
00:21:23,600 --> 00:21:25,930
!الإله ليس في الـ50 من عمره حتى

516
00:21:25,930 --> 00:21:27,890
...أجل، ناناكي

517
00:21:27,890 --> 00:21:32,350
.الندبة النفسية من أحداث الماضي لا يمكن إزالتها بتلك السهولة

518
00:21:32,660 --> 00:21:37,330
.يحتوي ناناكي على جزء من مشاعرك وروحك ونفسك

519
00:21:37,330 --> 00:21:41,460
.فقدان ناناكي يعني فقدان نفسك

520
00:21:41,460 --> 00:21:43,940
،منذ أن فقدتُ خاصتي

521
00:21:43,940 --> 00:21:46,530
.تقدّم جسدي في العمر بسرعة كبيرة

522
00:21:46,530 --> 00:21:47,720
!...لكن

523
00:21:47,720 --> 00:21:52,990
.هذا ليس الجانب المخيف الوحيد من عزل نفسك عن جراحك النفسية

524
00:21:53,240 --> 00:21:56,460
.لن تظلّ إنسانًا فِعليًّا

525
00:21:57,650 --> 00:22:00,470
.ميكاغي ولوفبون قد ذهبا

526
00:22:00,470 --> 00:22:02,130
.حسنًا

527
00:22:02,130 --> 00:22:03,490
ما العمل؟

528
00:22:03,490 --> 00:22:06,050
حسنٌ، من يأبه؟

529
00:22:06,050 --> 00:22:08,810
هل الجميع بخير حقًّا؟

530
00:22:08,810 --> 00:22:10,010
!أجل، أنتنّ كسولات

531
00:22:10,380 --> 00:22:13,640
!يجب أن نظلّ على استعداد الآن

532
00:22:13,640 --> 00:22:14,220
ماذا؟

533
00:22:14,500 --> 00:22:16,690
...حتى لو... لم نفعل

534
00:22:17,370 --> 00:22:19,170
...لن نواجه... المشاكل

535
00:22:19,170 --> 00:22:20,320
يونا-سان؟

536
00:22:20,320 --> 00:22:21,940
...لذا

537
00:22:22,370 --> 00:22:23,940
من يأبه الآن؟

538
00:22:25,550 --> 00:22:26,690
!أنا آسف جدًّا

539
00:22:26,690 --> 00:22:29,080
!سأجده

540
00:22:29,080 --> 00:22:29,650
!لذا، رجاءً

541
00:22:29,650 --> 00:22:31,480
!لا تهجرني رجاءً

542
00:22:31,480 --> 00:22:34,760
!أرجوك، أتوسّل إليك أيها الزعيم