1
00:00:11,230 --> 00:00:12,150
!ماساكي-سان

2
00:00:12,150 --> 00:00:14,800
!دعني وشأني! أنا بخير

3
00:00:14,800 --> 00:00:16,120
!فقط اذهب يا ميتسوموني-كُن

4
00:00:16,120 --> 00:00:17,280
!لا يُمكنني فعل ذلك

5
00:00:17,280 --> 00:00:18,260
!أسرعي

6
00:00:19,080 --> 00:00:21,530
...أنا بخير حقًّا

7
00:00:21,530 --> 00:00:22,680
...ففي النّهاية

8
00:00:31,290 --> 00:00:33,760
ميتسوموني، لقد أردت هذا، صحيح؟

9
00:00:36,300 --> 00:00:39,960
!ضربة البرق الألفيّ المُفْتَخَر

10
00:00:39,960 --> 00:00:42,290
!تريد دُمية محشوة مع أنّك فتى؟ يا لك من غريب

11
00:00:42,290 --> 00:00:43,560
!أنت فتاة

12
00:00:43,560 --> 00:00:44,610
!لستُ كذلك

13
00:00:44,610 --> 00:00:46,150
!البطريق البنوتيّ! خذ هذا

14
00:00:46,150 --> 00:00:48,010
.توقّف، أنت تؤلمه

15
00:00:48,010 --> 00:00:49,360
.حسنًا، حسنًا

16
00:00:49,360 --> 00:00:50,980
.هيّا يا توكيموني

17
00:00:50,980 --> 00:00:55,040
.هيّا، اعتذر من ميتسوموني وبطريق-سان

18
00:00:55,040 --> 00:00:56,950
ماذا؟

19
00:00:55,920 --> 00:00:56,950
.هيّا

20
00:00:57,610 --> 00:00:58,870
.آسف

21
00:00:58,870 --> 00:01:00,410
.حسنًا، ولدٌ مطيع، ولدٌ مطيع

22
00:01:00,830 --> 00:01:04,160
.إنّ توكيموني لولدٌ عنيد

23
00:01:04,530 --> 00:01:07,250
.ميتسوموني ولدٌ مُتّئِدٌ أيضًا

24
00:01:17,380 --> 00:01:19,850
شكرًا
لك

25
00:01:21,720 --> 00:01:23,600
شكرًا
لك

26
00:01:26,060 --> 00:01:27,250
!ميتسوموني

27
00:01:27,250 --> 00:01:28,610
!فلنذهب لاستكشاف ذلك المكان

28
00:01:28,610 --> 00:01:32,020
.آسف، عليّ أن أُطعمَ البطريق الآن

29
00:01:32,240 --> 00:01:33,900
.هيّا

30
00:01:33,900 --> 00:01:34,610
!لا

31
00:01:34,610 --> 00:01:35,360
!أعطنيه

32
00:01:35,360 --> 00:01:36,140
!أنت

33
00:01:36,140 --> 00:01:37,610
.هكذا

34
00:01:39,450 --> 00:01:40,650
!توقّف يا توكيموني

35
00:01:40,650 --> 00:01:42,890
قالت أمّي أنّه لا يمكننا أن نصعد إلى هناك

36
00:01:42,890 --> 00:01:45,660
!أنتَ أخرق جدًّا لتفعل هذا، لكنّي بخير

37
00:01:45,660 --> 00:01:47,290
!أمّي

38
00:01:47,290 --> 00:01:48,580
...إنّ توكيموني

39
00:01:48,580 --> 00:01:50,000
!ما الذي تفعله يا توكيموني؟

40
00:01:57,250 --> 00:01:58,440
!ميتسوموني-كُن

41
00:02:01,750 --> 00:02:03,860
...آسفة يا ميتسوموني-كُن

42
00:02:04,790 --> 00:02:05,790
.آسفة جدًّا

43
00:03:37,930 --> 00:03:40,250
.آسفة يا توكيموني

44
00:03:40,950 --> 00:03:42,800
...آسفة حقًّا

45
00:03:42,800 --> 00:03:44,640
.آسفة

46
00:03:44,640 --> 00:03:45,910
...آسفة جدًّا

47
00:03:46,470 --> 00:03:50,610
.ساكاي-سان، لقد أتت عائلتك

48
00:03:52,390 --> 00:03:53,760
...ميتسكو

49
00:03:53,760 --> 00:03:56,530
.لقد قمتُ بتوديع توكيموني

50
00:04:05,970 --> 00:04:07,130
...أمّي

51
00:04:08,110 --> 00:04:09,220
!أمّي

52
00:04:14,220 --> 00:04:16,650
.توكيموني. أيّها الولد الشقيّ

53
00:04:16,650 --> 00:04:17,280
ماذا؟

54
00:04:17,280 --> 00:04:18,140
!ميتسكو

55
00:04:18,140 --> 00:04:20,210
.لا يمكنك أن تختفي فجأةً هكذا

56
00:04:20,210 --> 00:04:22,610
اعتذر يا توكيموني، اتّفقنا؟

57
00:04:22,610 --> 00:04:24,000
.هيّا يا توكيموني

58
00:04:24,000 --> 00:04:25,110
!اهدئي

59
00:04:25,110 --> 00:04:27,070
!إنّه ليس توكيموني
—بل ميتسومو

60
00:04:32,660 --> 00:04:34,000
.أنا آسف

61
00:04:34,570 --> 00:04:36,960
.ولدٌ مطيع

62
00:04:36,960 --> 00:04:39,260
.أنتَ ولدٌ مطيع يا توكيموني

63
00:04:39,960 --> 00:04:41,210
...هل أنا

64
00:04:41,760 --> 00:04:43,410
ألستُ ميتسوموني؟

65
00:04:45,050 --> 00:04:45,880
ماذا؟

66
00:04:45,880 --> 00:04:48,310
ميتسوموني-كُن، هل أنت بخير؟

67
00:04:48,310 --> 00:04:49,630
.أجل، أنا بخير

68
00:04:49,630 --> 00:04:51,450
.لم أصب في أيّ مكان

69
00:04:51,450 --> 00:04:53,820
هل فقدت وعيي؟

70
00:04:53,820 --> 00:04:56,140
.كلّا، ليس هذا ما أقصد بسؤالي

71
00:04:56,140 --> 00:04:56,560
ماذا؟

72
00:04:56,800 --> 00:04:58,980
.لقد كنتَ تبكي

73
00:05:00,850 --> 00:05:03,120
ماساكي-تشان، شبح؟

74
00:05:03,120 --> 00:05:04,070
!لا بد أنّ هذه مزحة

75
00:05:04,070 --> 00:05:05,200
هل أنت جادة؟

76
00:05:05,200 --> 00:05:08,180
،حسنٌ، إن كان كلّ هذا من صنيع شبح

77
00:05:08,180 --> 00:05:10,190
.فهذه حجّة مقنعة جدًّا

78
00:05:10,190 --> 00:05:12,200
.فكّروا في ذلك الوحش الذي قال الجميع أنّهم رأوه

79
00:05:12,200 --> 00:05:13,660
أيّ وحش؟

80
00:05:13,660 --> 00:05:14,550
!ميكاغي-سان

81
00:05:14,550 --> 00:05:15,570
!أنت بخير

82
00:05:15,570 --> 00:05:17,880
أخبرني. ماذا تقصد بهذا الوحش؟

83
00:05:18,180 --> 00:05:18,560
ماذا؟

84
00:05:18,560 --> 00:05:20,370
ماذا؟ هل تعبث معنا؟

85
00:05:20,370 --> 00:05:22,460
.الوحوش تضلّ وحوشًا

86
00:05:22,460 --> 00:05:25,430
...بالطّبع، جميعكم تدعونه هكذا

87
00:05:25,430 --> 00:05:27,240
لكن كيف بدا؟

88
00:05:27,240 --> 00:05:30,080
.حتّى من لم يروه قد سمعوه دون ريب

89
00:05:30,080 --> 00:05:31,520
!كونوا أكثر تحديدًا

90
00:05:32,490 --> 00:05:34,300
،مع أنّ الجميع رأوا وسمعوا شيئًا مختلفًا

91
00:05:34,300 --> 00:05:37,560
إلّا أنّنا لم نتحدّث أبدًا بشأن ذلك. لماذا؟

92
00:05:37,970 --> 00:05:39,190
...لأنّه

93
00:05:39,190 --> 00:05:41,150
.لم يرد أيّ أحد أن يتحدّث بشأن ذلك

94
00:05:42,090 --> 00:05:46,280
.لقد كان الجميع يقاومون تلك الفكرة بالذّات

95
00:05:47,250 --> 00:05:50,240
...مايماي، أظنّك ناديتِ الوحش الذي رأيته

96
00:05:50,240 --> 00:05:52,650
بـ"ميتسوموني عملاق"، أليس كذلك؟

97
00:05:52,650 --> 00:05:53,890
ما كان ذلك؟

98
00:05:54,530 --> 00:05:55,830
...ذلك

99
00:05:57,690 --> 00:06:00,220
،لم نؤكّد حقيقة هذا

100
00:06:00,220 --> 00:06:01,790
...لكن أظنّ أنّ أولئك الوحوش

101
00:06:02,710 --> 00:06:05,260
.هي كلّ ما يقبع في أعماقنا...

102
00:06:05,490 --> 00:06:06,780
بديل؟

103
00:06:06,780 --> 00:06:09,720
.في البداية، قالوا أنّ ذلك للحفاظ على استقرار حالة أمّي

104
00:06:10,100 --> 00:06:13,560
.لكنّهم بدؤوا بمناداتي توكيموني في البيت

105
00:06:14,230 --> 00:06:15,010
...لكن

106
00:06:18,490 --> 00:06:19,600
!توكيموني

107
00:06:19,600 --> 00:06:21,010
!لقد تأخرت

108
00:06:21,010 --> 00:06:22,640
.آسفة يا سيّدتي

109
00:06:22,640 --> 00:06:24,360
...كان هناك ازدحام قليل في حركة المرور

110
00:06:24,360 --> 00:06:27,320
!كيف أمكنني أن أدع مكانًا غير منظمٍ أن يعتني بتوكيموني؟

111
00:06:27,320 --> 00:06:28,650
توكيموني؟

112
00:06:28,650 --> 00:06:29,880
.إنّه ليس توكيموني

113
00:06:29,880 --> 00:06:30,780
.إنّه ميتشان

114
00:06:30,780 --> 00:06:32,700
!ماذا قلت؟

115
00:06:32,700 --> 00:06:34,930
!اهدئي رجاءً يا سيّدتي

116
00:06:35,800 --> 00:06:38,980
ماذا ستفعل عندما يلتحق بالمدرسة الإعدادية؟

117
00:06:38,980 --> 00:06:42,640
.لدينا علاقة جيّدة مع مدير المدرسة في هذه المحافظة

118
00:06:42,640 --> 00:06:46,760
سأحاول أن أتحدّث معه لأرى إن كان سيسمح
.لميتسوموني أن يرتاد المدرسة على كونه توكيموني

119
00:06:48,190 --> 00:06:50,440
.أنا آسف جدًّا يا ميتسوموني

120
00:06:50,440 --> 00:06:51,940
...فقط لأجل المدرسة الإعدادية

121
00:06:51,940 --> 00:06:54,220
.إلى أن تتحسّن والدتك

122
00:06:55,520 --> 00:06:56,130
.حسنًا

123
00:06:57,560 --> 00:06:59,890
...لكن حتّى عندما التحقتُ بالمدرسة الثانوية

124
00:06:59,890 --> 00:07:02,890
.النيكوجاغا جاهز يا توكيموني

125
00:07:02,890 --> 00:07:03,360
.تعال وتذوّقه

126
00:07:04,810 --> 00:07:06,730
ما الأمر يا توكيموني؟

127
00:07:06,730 --> 00:07:07,610
...لا شيء

128
00:07:08,560 --> 00:07:10,150
.افتح فمك

129
00:07:12,260 --> 00:07:13,470
!إنّه ساخن

130
00:07:14,200 --> 00:07:16,330
.أنا حقًّا آسف

131
00:07:16,330 --> 00:07:20,380
أيمكنني أن أطلب منك أن تبقي على الأمر
هكذا إلى حين انتهاء المدرسة الثانوية؟

132
00:07:21,880 --> 00:07:22,820
.بالطبع

133
00:07:22,820 --> 00:07:24,520
.لقد كنتُ أتوقّع ذلك على كلّ حال

134
00:07:24,520 --> 00:07:26,040
.أنا آسف يا توكيموني

135
00:07:26,670 --> 00:07:28,010
.أعني، ميتسوموني

136
00:07:29,330 --> 00:07:30,180
.لا بأس

137
00:07:30,970 --> 00:07:32,360
...لكن

138
00:07:32,360 --> 00:07:35,430
،لقد كان والدي مُعلّمًا منذ وقتٍ طويل

139
00:07:35,430 --> 00:07:38,110
.لذا فقد ارتفعت رتبه في السّلم التدريسي

140
00:07:38,590 --> 00:07:41,890
.في مرحلةٍ ما، أصبحتُ توكيموني فقط

141
00:07:41,890 --> 00:07:46,320
،لهذا السّبب، عندما قلتِ أنّ اسمي أعجبك

142
00:07:46,320 --> 00:07:47,360
.لقد جعلني ذلك سعيدًا

143
00:07:48,460 --> 00:07:50,170
.سعيدًا جدًّا

144
00:07:50,590 --> 00:07:54,280
.لهذا السّبب التحقتُ بالجولة كما ترين

145
00:07:54,570 --> 00:07:56,240
.أنا لستُ توكيموني

146
00:07:56,240 --> 00:08:00,610
.أردتُ أن أعيش في مكانٍ لا يعرفه غيري، بمثابتي ميتسوموني

147
00:08:00,610 --> 00:08:02,620
.لهذا التحقتُ بالجولة

148
00:08:02,860 --> 00:08:04,530
...لكوني ميتسوموني

149
00:08:09,770 --> 00:08:10,570
.فلنذهب

150
00:08:11,440 --> 00:08:12,260
إلى أين؟

151
00:08:22,590 --> 00:08:24,080
...كم هذا غريب

152
00:08:24,080 --> 00:08:24,700
ماذا؟

153
00:08:25,790 --> 00:08:28,090
.لا، لا شيء

154
00:08:28,090 --> 00:08:30,070
.أنت غريب أيضًا يا ميتسوموني-كُن

155
00:08:31,810 --> 00:08:33,030
هل سمعتني؟

156
00:08:33,030 --> 00:08:36,990
.أشعر بالشّجاعة بطريقةٍ ما عندما أكون إلى جانبك

157
00:08:37,370 --> 00:08:39,830
.يديك أدفأ

158
00:08:40,600 --> 00:08:42,800
.وأنتِ أيضًا يا ماساكي-تشان

159
00:08:49,160 --> 00:08:50,470
.الظلام دامس

160
00:08:54,690 --> 00:08:57,110
،إن أردت أن تعود إلى حياتك السابقة

161
00:08:57,110 --> 00:08:59,320
.فعليك أن تمرّ من هذا النّفق أوّلًا

162
00:08:59,320 --> 00:09:00,800
حياتي السّابقة؟

163
00:09:00,800 --> 00:09:03,160
يمكنني أن أعود إن سلكتُ هذا النّفق؟

164
00:09:03,520 --> 00:09:05,600
.لا، لا يمكنك

165
00:09:06,090 --> 00:09:07,050
،إن أردتَ أن تعود حقًّا

166
00:09:07,050 --> 00:09:10,950
.فعليك أن تواجه نفسك

167
00:09:15,780 --> 00:09:16,840
!ها هو ذا مجدّدًا

168
00:09:16,840 --> 00:09:17,680
!ماساكي-سان، اهربي

169
00:09:17,680 --> 00:09:19,010
.سأمضي قُدمًا

170
00:09:21,160 --> 00:09:25,760
...ميتسوموني-كُن، أنت تملك يدين دافئين على خلاف أيّ أحد

171
00:09:25,760 --> 00:09:27,620
.وشخصيّةٌ دافئة ومُهتمّة على خلاف أيّ أحد

172
00:09:27,880 --> 00:09:29,160
.آمن بنفسك

173
00:09:29,160 --> 00:09:31,330
.وحافظ على طبيعتك يا ميتسوموني-كُن

174
00:09:31,330 --> 00:09:33,840
.على الجميع أن يتقبّلوك كما أنت

175
00:09:35,930 --> 00:09:36,760
!ماساكي-سان؟

176
00:09:37,740 --> 00:09:38,870
!ماذا؟

177
00:09:46,680 --> 00:09:50,270
...توكيموني

178
00:09:52,460 --> 00:09:54,690
ميتسوموني، أردتَ هذا، صحيح؟

179
00:09:56,690 --> 00:09:57,840
...صحيح

180
00:09:57,840 --> 00:09:59,570
!أنا ميتسوموني

181
00:10:17,450 --> 00:10:20,010
!ماساكي-سان، أنا آسف

182
00:10:20,450 --> 00:10:22,100
...إذًا أولئك الوحوش

183
00:10:22,330 --> 00:10:25,810
فتلك الشبح ماساكي هي من تأتي بهم في أعدادٍ كبيرة إلى هنا؟

184
00:10:25,810 --> 00:10:26,770
.أجل

185
00:10:26,770 --> 00:10:28,260
،وفقًا لكلمات الأغنية

186
00:10:28,260 --> 00:10:30,580
.ماتت ماساكي هنا وأصبحت شبحًا

187
00:10:30,580 --> 00:10:32,520
.وهي الآن تحاول أن تسحب معها الجميع

188
00:10:33,170 --> 00:10:36,070
هذا ليس تسرّعًا في الحكم، أليس كذلك؟

189
00:10:36,380 --> 00:10:39,530
.قد يكون ذلك... صحيحًا

190
00:10:39,740 --> 00:10:40,990
...لكن

191
00:10:40,350 --> 00:10:42,450
.بالكاد أتحمّل الكثير عنه

192
00:10:42,450 --> 00:10:43,720
.أردتُ أن أنساه

193
00:10:43,720 --> 00:10:44,700
.أردتُه أن يبتعد بعيدًا جدًّا

194
00:10:44,700 --> 00:10:46,090
.أردتُ أن أقتله

195
00:10:46,090 --> 00:10:48,540
.وها هو يظهر أمامي مجدّدًا

196
00:10:48,880 --> 00:10:51,210
،حسنٌ، إن كانت شبحًا

197
00:10:51,210 --> 00:10:53,880
.فقد تكون بارعةً في الهجمات النّفسية وما إلى ذلك

198
00:10:53,880 --> 00:10:55,000
.ليس وكأنّي أعلم

199
00:10:56,680 --> 00:10:59,730
.لكن ربّما هناك أمل الآن

200
00:11:00,200 --> 00:11:02,120
،إن كنّا نواجه وحوشًا حقيقيّة

201
00:11:02,120 --> 00:11:03,680
.ما كنّا لنستطيع هزيمتها

202
00:11:04,190 --> 00:11:06,120
.لكن إن كانت فتاةً ميّتة وحسب

203
00:11:06,120 --> 00:11:08,180
،إن كانت إنسانةً حيّة من قبل

204
00:11:08,180 --> 00:11:10,390
فسنستطيع هزيمتها، أليس كذلك؟

205
00:11:10,390 --> 00:11:11,150
!ماذا؟

206
00:11:11,150 --> 00:11:13,040
!الأشباح والوحوش سواء

207
00:11:13,040 --> 00:11:14,110
!لا يمكننا هزيمتها بالتّأكيد

208
00:11:14,110 --> 00:11:16,310
.حسنٌ، لكنّ الوحوش كبيرة

209
00:11:16,310 --> 00:11:17,320
!وماساكي صغيرة

210
00:11:17,320 --> 00:11:18,490
ماذا؟ هل الحجم هو كلّ ما يهم؟

211
00:11:18,490 --> 00:11:20,070
،لكن بالطّبع

212
00:11:20,070 --> 00:11:22,530
،لو كانت ماساكي-تشان هي من تتحكّم بالوحوش

213
00:11:22,530 --> 00:11:23,950
.فعلينا أن نعرف ما يجب أن نفعل حيالها

214
00:11:23,950 --> 00:11:24,930
!مهلًا

215
00:11:24,930 --> 00:11:27,800
،ربّما لدى ماساكي-تشان سرًّا تخفيه

216
00:11:27,800 --> 00:11:29,670
لكن هل علينا أن نهزمها؟

217
00:11:29,670 --> 00:11:31,480
...أنا

218
00:11:31,480 --> 00:11:33,730
.رأيتُ في صديقي الشّخص الذي أكننتُ له مشاعرًا

219
00:11:34,330 --> 00:11:37,150
.ذلك الشخص يُدعى كوياما-كُن

220
00:11:37,150 --> 00:11:38,760
.بدا كميتسوموني نوعًا ما

221
00:11:39,050 --> 00:11:40,330
...مايماي

222
00:11:40,330 --> 00:11:43,680
...وعدنا بعضنا أن نحظى بقتالٍ عادل

223
00:11:44,140 --> 00:11:46,640
كان يُفترض بنا أن نبقى صديقان صدوقان
.مع أنّي الفتاة التي أصبحت خليلة كوياما-كُن

224
00:11:47,030 --> 00:11:49,350
.لكنّها نزعت علاقتها بي

225
00:11:49,350 --> 00:11:52,370
.وكلّ أصدقائي انحازوا إلى جانبها أيضًا

226
00:11:52,370 --> 00:11:55,420
...ولم يقم كوياما-كُن بالدّفاع عنّي أيضًا

227
00:11:55,420 --> 00:11:56,570
.بل وفسخ علاقتنا

228
00:11:56,570 --> 00:11:57,760
!لا أريد أن أعود إلى الديار

229
00:11:57,760 --> 00:11:59,280
!لا أريد أن أعود

230
00:11:59,510 --> 00:12:01,810
!لذا ماذا لو كان هناك أشباح ووحوش هنا؟

231
00:12:01,810 --> 00:12:04,320
.لم يعد أحد في البيت أو المدرسة يحادثتي

232
00:12:04,320 --> 00:12:05,260
!جميعهم يتجاهلونني

233
00:12:05,260 --> 00:12:07,970
!وكأنّي لستُ موجودة بعد الآن

234
00:12:08,610 --> 00:12:10,400
.لا أريد أن أعود أيضًا

235
00:12:10,400 --> 00:12:11,710
الجميع يشعرون بنفس الطريقة، صحيح؟

236
00:12:12,360 --> 00:12:14,270
،بمثابتي منظّم هذه الجولة

237
00:12:14,270 --> 00:12:16,670
.سأتحمّل مسؤولية التحقّق منكم جميعًا في هذه المرحلة

238
00:12:16,670 --> 00:12:20,410
،سواءٌ أكانت ماساكي-سان شبحًا أم لا

239
00:12:20,410 --> 00:12:22,670
،إن كان بإمكاننا أن نتعامل مع الوحوش بطريقةٍ ما

240
00:12:22,670 --> 00:12:24,630
هل سترغبون بالبقاء؟

241
00:12:24,630 --> 00:12:25,800
!داهارا-سان

242
00:12:25,800 --> 00:12:27,920
.كما قلت، لا يهمّ ما تكون

243
00:12:29,100 --> 00:12:30,810
.لقد تحسّن تفكيري بك الآن يا داهارا

244
00:12:30,810 --> 00:12:32,560
.ذلك ما أردتُ أن أقوله

245
00:12:32,560 --> 00:12:34,330
،حسنٌ، لو تخلّصنا من الوحوش، فبالطّبع

246
00:12:34,330 --> 00:12:36,630
.أريد البقاء أيضًا

247
00:12:36,630 --> 00:12:37,470
.أجل

248
00:12:37,470 --> 00:12:40,530
...كنتُ أفكّر في الخروج من هنا والعودة إلى البيت، لكن

249
00:12:41,010 --> 00:12:42,540
...بعد أن رأيت ذلك الشّيء

250
00:12:43,200 --> 00:12:46,860
.تذكّرتُ أنّ الواقع أكثر رعبًا من أيّ وحش

251
00:12:46,860 --> 00:12:48,370
!فلمَ ترانا نتجنّب المشكلة؟

252
00:12:48,690 --> 00:12:51,120
!لا نملك الوقت لعقد جلسات الاعتماد على النّفس

253
00:12:51,390 --> 00:12:53,560
!لا بدّ أنّ ميتسوموني مع ماساكي

254
00:12:53,560 --> 00:12:54,580
هل نسيتم جميعكم بشأنه؟

255
00:12:54,580 --> 00:12:56,330
!هذا صحيح، ميتسوموني-كُن

256
00:12:56,330 --> 00:12:58,940
.لقد جعلته كخاتمٍ في إصبعها

257
00:12:58,940 --> 00:13:00,470
.لقد استحوذت عليه

258
00:13:00,470 --> 00:13:03,800
.يجب أن ننقذه بمثابتنا أصدقاءه

259
00:13:03,800 --> 00:13:05,660
.البقاء في هذه القرية

260
00:13:05,660 --> 00:13:07,260
.وعدم العودة إلى الواقع

261
00:13:07,470 --> 00:13:08,920
.إنقاذ صديقك

262
00:13:08,920 --> 00:13:13,180
.هناك سبيلٌ واحد لتحقيق رغباتنا

263
00:13:13,890 --> 00:13:15,640
نتخلّص من ماساكي؟

264
00:13:19,590 --> 00:13:23,130
.ميتسوموني

265
00:13:25,040 --> 00:13:26,400
...هاياتو

266
00:13:26,400 --> 00:13:28,870
!ماذا تفعل؟

267
00:13:28,870 --> 00:13:29,930
...أنا آسف يا هاياتو

268
00:13:29,930 --> 00:13:30,700
...أنا

269
00:13:31,090 --> 00:13:32,580
.حمدًا لله

270
00:13:32,580 --> 00:13:33,410
هل أنت بخير؟

271
00:13:35,170 --> 00:13:36,270
هل أنت مصاب؟

272
00:13:36,270 --> 00:13:37,070
.أنا بخير

273
00:13:37,070 --> 00:13:38,680
أين الجميع؟

274
00:13:40,250 --> 00:13:42,120
.إنّهم في انتظارك

275
00:13:42,120 --> 00:13:44,880
.الجميع وبمن فيفهم ميكاغي آسفون على ما فعلوه

276
00:13:44,880 --> 00:13:45,550
ماذا؟

277
00:13:46,010 --> 00:13:47,450
.ميتسوموني-كُن

278
00:13:47,450 --> 00:13:48,220
!مرحبًا بعودتك

279
00:13:48,570 --> 00:13:50,680
.آسفٌ لأنّي كنتُ قاسيًّا جدًّا معك

280
00:13:50,680 --> 00:13:51,740
أتريد أن تشرب أيّ شيء؟

281
00:13:51,740 --> 00:13:52,990
.شكرًا

282
00:13:52,990 --> 00:13:54,430
هل لي بكوبٍ من الماء؟

283
00:13:55,770 --> 00:13:57,350
!لقد عاد ميتسوموني

284
00:13:57,350 --> 00:13:58,520
!ماساكي ليست معه

285
00:13:58,920 --> 00:13:59,690
!إنّه بمفرده

286
00:13:59,690 --> 00:14:00,440
ما معنى كلّ هذا؟

287
00:14:00,440 --> 00:14:01,300
!ربّما لاذت بالفرار؟

288
00:14:01,300 --> 00:14:02,210
إلى أين؟

289
00:14:02,210 --> 00:14:05,240
.ربّما تستخدم ميتسوموني-سان كطعم

290
00:14:05,240 --> 00:14:07,690
،سنعرف بالتأكيد عندما نجعله يقرّ بما لديه

291
00:14:07,690 --> 00:14:10,130
لكن هل كانا سويًّا؟

292
00:14:10,130 --> 00:14:11,590
لم يرهما أيّ أحد سويًّا، صحيح؟

293
00:14:11,590 --> 00:14:12,830
!لا شكّ في ذلك

294
00:14:12,830 --> 00:14:15,370
.اسمعي، كوني حذرة بشأن ماساكي

295
00:14:15,830 --> 00:14:17,450
،كما قال سبيدستار

296
00:14:17,450 --> 00:14:20,830
.لربّما تلاعبت بدماغه

297
00:14:22,360 --> 00:14:24,570
.أنا آسف حيال كلّ شيء يا ميتسوموني

298
00:14:24,570 --> 00:14:26,300
.آسفٌ لأنّي شككتُ بك

299
00:14:26,800 --> 00:14:27,910
...هذا

300
00:14:27,910 --> 00:14:28,960
.سامحنا رجاءً

301
00:14:28,960 --> 00:14:31,110
،فعلنا ذلك لأجل حماية الفريق

302
00:14:31,110 --> 00:14:33,970
.لكنّنا اقترفنا خطأً جسيمًا

303
00:14:33,970 --> 00:14:37,180
.أنت واحدٌ منّا أيضًا يا ميتسوموني

304
00:14:37,720 --> 00:14:39,140
...ميكاغي-سان

305
00:14:39,430 --> 00:14:42,110
.يا لها من راحة

306
00:14:42,110 --> 00:14:43,370
...فلنرحّب بماساكي-سان

307
00:14:43,370 --> 00:14:44,690
.مهلًا

308
00:14:44,690 --> 00:14:46,540
بالمناسبة، أين هي ماساكي-سان؟

309
00:14:46,540 --> 00:14:46,930
...أنت

310
00:14:46,930 --> 00:14:48,440
.لم ألحظ غيابها

311
00:14:48,440 --> 00:14:51,450
أصودف وأن كنتَ معها؟

312
00:14:51,740 --> 00:14:53,040
...حسنٌ

313
00:14:53,040 --> 00:14:55,510
أيمكنك أن تخبرنا ما حصل؟

314
00:14:55,510 --> 00:14:57,370
.يجب أن ننقذها أيضًا

315
00:14:57,640 --> 00:14:59,080
ننقذ ماساكي-سان؟

316
00:14:59,080 --> 00:15:00,520
.بالطّبع

317
00:15:00,520 --> 00:15:02,540
.لقد شككنا بماساكي-أيضًا

318
00:15:02,980 --> 00:15:04,310
.لا بدّ أنّ ذلك جرح مشاعرها

319
00:15:06,200 --> 00:15:07,060
.أظنّ ذلك

320
00:15:08,240 --> 00:15:11,720
أيمكنك أن تخبرنا كيف كانت تُبلي؟

321
00:15:13,880 --> 00:15:15,890
هذا ما حدث إذًا؟

322
00:15:15,890 --> 00:15:18,850
.لم أعلم بوجود محطّات القطار والأنفاق

323
00:15:18,850 --> 00:15:20,670
لكن اجتياز الوحوش؟

324
00:15:20,670 --> 00:15:21,290
...كما ظنّنا

325
00:15:21,290 --> 00:15:21,810
!صه

326
00:15:22,030 --> 00:15:25,770
.قالت ماساكي-سان أنّها ستنتظرني في آخر النّفق

327
00:15:25,770 --> 00:15:27,100
في آخر النّفق؟

328
00:15:27,100 --> 00:15:28,860
!أقالت ما سيكون هناك؟

329
00:15:28,860 --> 00:15:29,460
ماذا؟

330
00:15:29,460 --> 00:15:30,950
أيمكنك أن تخبرنا بالمزيد؟

331
00:15:30,950 --> 00:15:31,410
!أنت

332
00:15:32,550 --> 00:15:33,870
.شكرًا لك

333
00:15:33,870 --> 00:15:36,160
.آسف على استجوابك بينما أنت متعب

334
00:15:36,160 --> 00:15:37,300
.يجب أن تنال قسطًا من الرّاحة

335
00:15:37,300 --> 00:15:38,610
...لكنّ ماساكي-سان

336
00:15:38,610 --> 00:15:39,610
.سبيدستار

337
00:15:40,470 --> 00:15:41,570
.لا بأس

338
00:15:41,570 --> 00:15:43,020
.لا داعي للقلق

339
00:15:43,020 --> 00:15:44,080
.نل ليلةً هنيئة

340
00:15:44,550 --> 00:15:49,030
.سنجد ماساكي-تشان ونحميها

341
00:15:49,030 --> 00:15:50,030
...كوهارون-سان

342
00:15:50,030 --> 00:15:51,880
.والآن، احظَ بليلة هنيئة

343
00:15:51,880 --> 00:15:54,470
!لقد وضعنا الأسرّة تحت أشعّة الشمس، لذا فهي ناعمة الآن

344
00:15:55,570 --> 00:15:58,430
.لا أحبّذ خداعه هكذا

345
00:15:59,010 --> 00:16:01,890
.سيكون من الأفضل أن نجعله يُقرّ باستخدام القوّة

346
00:16:01,890 --> 00:16:03,770
وهل من خيار أمامنا؟

347
00:16:03,770 --> 00:16:06,000
.لا بدّ أن البقية قد بدؤوا الآن

348
00:16:06,000 --> 00:16:07,230
.فلنذهب

349
00:16:07,230 --> 00:16:09,410
أنتِ غامضة حقًّا، أوتعلمين ذلك؟

350
00:16:09,410 --> 00:16:09,940
ماذا؟

351
00:16:09,940 --> 00:16:12,360
،تدّعين أنّك تهتمّين بماساكي

352
00:16:12,360 --> 00:16:14,990
.لكن ها أنت ذي تسايرين خطّة ميكاغي

353
00:16:14,990 --> 00:16:17,750
...أريد أن أساعد ميتسوموني-كُن

354
00:16:17,750 --> 00:16:19,370
.وماساكي-تشان أيضًا

355
00:16:19,980 --> 00:16:21,790
.حسنًا، احظ بقسطٍ من الرّاحة

356
00:16:21,790 --> 00:16:23,950
.سآتي لإيقاظك في الصّباح

357
00:16:23,950 --> 00:16:25,100
.هاياتو

358
00:16:25,100 --> 00:16:25,790
نعم؟

359
00:16:25,790 --> 00:16:29,750
لمَ الجميع قلقون جدًّا بشأني؟

360
00:16:29,750 --> 00:16:32,870
،حسنٌ، لقد أخطؤوا بحقّك

361
00:16:32,870 --> 00:16:35,200
.كما أنّك تبدو متعبًا

362
00:16:35,200 --> 00:16:36,300
.حسنًا

363
00:16:36,300 --> 00:16:39,680
.ربّما ما قالته ماساكي-سان صحيح

364
00:16:39,680 --> 00:16:40,680
ماساكي؟

365
00:16:40,680 --> 00:16:43,140
.أجل، لقد أخبرتني أن أؤمن بنفسي أكثر

366
00:16:43,400 --> 00:16:46,400
.قالت أنّه على النّاس أن يتقبّلوني كما أنا

367
00:16:48,910 --> 00:16:50,560
.حسنًا، ليلة هنيئة

368
00:16:52,330 --> 00:16:54,780
.لا داعي أن تؤمن أكثر بنفسك

369
00:16:55,110 --> 00:16:57,010
لا يمكنك أن تنجو

370
00:16:57,450 --> 00:16:59,490
.دون أن تفعل ما أقوله لك

371
00:17:01,530 --> 00:17:03,200
!لم تعد هناك مسامير كافية

372
00:17:03,410 --> 00:17:05,670
مرحبًا بعودتك. كيف حال ميتسوموني؟

373
00:17:05,670 --> 00:17:07,530
.بخير. إنّه غاطٌ في النّوم

374
00:17:07,530 --> 00:17:10,090
!مفهوم. جميعنا جاهزون هنا

375
00:17:10,570 --> 00:17:13,070
.لربّما سيُفلح معها المِلح إن كانت شبحًا

376
00:17:13,070 --> 00:17:14,530
ماذا؟ ألا يفلح ذلك مع الرخويات وحسب؟

377
00:17:14,530 --> 00:17:15,740
.سنستخدم المِلح للتنقية

378
00:17:15,740 --> 00:17:17,550
.أنت جاهلٌ تمامًا

379
00:17:17,550 --> 00:17:19,820
.أظنّ أنّه يجب أن نستخدمَ وتدًا

380
00:17:19,820 --> 00:17:21,330
.ونطعن به قلبها

381
00:17:21,330 --> 00:17:22,730
.ذلك لأجل الدراكولا

382
00:17:23,540 --> 00:17:25,430
.هذا يدغدغ

383
00:17:24,060 --> 00:17:25,430
ماذا تفعلان؟

384
00:17:26,080 --> 00:17:28,320
أتعرف قصّة هويتشي الذي لا يملك أذنين؟

385
00:17:28,320 --> 00:17:31,520
.إن كتبت السوترا على نفسك فلن تستطيع الوحوش إيجادك أبدًا

386
00:17:31,520 --> 00:17:34,030
.أنا منبهرة يا لوفبون
.أنتِ تجيدين كتابة السوترا

387
00:17:34,030 --> 00:17:38,760
.لقد أُرغمت على تعلّمها من قِبل شخصٍّ سيّئ محكوم عليه بالإعدام

388
00:17:38,760 --> 00:17:40,810
...أشعر بالغثيان عندما أكتبها

389
00:17:43,690 --> 00:17:45,250
!لقد تقيّأتِ عليّ

390
00:17:45,250 --> 00:17:48,850
،لدينا كلّ هذه الأمور الخاصّة بطرد الأشباح من جميع بقاع العالم

391
00:17:48,850 --> 00:17:50,630
.واثقٌ أنّ أحدها سيفلح

392
00:17:51,130 --> 00:17:53,520
.تبدو كلعبة أطفال بالنّسبة لي

393
00:17:53,520 --> 00:17:57,380
.لكن حتّى الأشباح بحدّ ذاتها هي مثل لعب الأطفال

394
00:17:57,380 --> 00:17:59,410
ألا تؤمن بالأشباح يا ياماوتشي-سان؟

395
00:17:59,410 --> 00:18:01,350
...حسنٌ، هذا ليس ما أقصده

396
00:18:01,350 --> 00:18:05,560
.ما في الأمر هو أنّي لم أتعامل مع الأمور الخارقة للطّبيعة في حياتي السّابقة

397
00:18:05,560 --> 00:18:06,850
.لستَ بحاجة أن تؤمن

398
00:18:06,850 --> 00:18:11,150
.علينا فقط أن نتصرّف حيال ماساكي لكي ننتهي من أمر تلك الوحوش

399
00:18:11,150 --> 00:18:13,570
.كلّ ما هو خارق للطبيعة سيرحل بعدها

400
00:18:14,000 --> 00:18:16,030
.حان الوقت لمطاردة السّاحرة... مطاردة ماساكي

401
00:18:25,450 --> 00:18:26,890
.لا يبدو أنّها هنا

402
00:18:26,890 --> 00:18:27,660
.صحيح

403
00:18:27,940 --> 00:18:29,360
.راقبوا أين تطأ أقدامكم

404
00:18:29,360 --> 00:18:32,130
أين ليون وناناكو؟

405
00:18:32,130 --> 00:18:33,810
.قالا أنّهما لا يشعران أنّهما بخير

406
00:18:33,810 --> 00:18:37,590
.أضف إلى ذلك، وجود المرأة هو عائق في مثل هذه الأوضاع

407
00:18:37,590 --> 00:18:39,340
.يا لبغض النّساء

408
00:18:39,670 --> 00:18:40,800
...لم يكن ذلك قصدي

409
00:18:41,030 --> 00:18:43,120
.يا ويحي، أظنّ أنّ وحشًا قد يظهر في أيّة لحظة

410
00:18:43,120 --> 00:18:45,080
،فقط لو أنّ ماساكي تُظهر نفسها

411
00:18:45,080 --> 00:18:46,780
.لانتهى البحث الآن

412
00:18:46,780 --> 00:18:48,220
.لا أظنّ أنّ ذلك سيحدث

413
00:18:51,710 --> 00:18:53,350
!إنّها ماساكي

414
00:18:55,090 --> 00:18:56,350
إلى أين أنت ذاهبة؟

415
00:18:57,770 --> 00:18:58,770
.هذا ما أريد أن أسألك

416
00:18:58,770 --> 00:19:02,620
.سأذهب لأخبر ميتسوموني أنّ ماساكي في خطر

417
00:19:03,300 --> 00:19:06,060
ألا تصدّقين أنّها شبح؟

418
00:19:06,060 --> 00:19:09,870
.المحقّق البارع يشكّ في كلّ شيء

419
00:19:10,900 --> 00:19:12,580
ولا تشكّين في ماساكي؟

420
00:19:13,430 --> 00:19:16,810
.المحقّق البارع يشكّ في كلّ شيءٍ يصدّقه الجميع

421
00:19:16,810 --> 00:19:19,550
أنتِ هكذا أيضًا، ألستِ كذلك؟

422
00:19:20,350 --> 00:19:22,630
.لا تظنّين أنّ ماساكي شبح

423
00:19:23,520 --> 00:19:24,510
...أنا

424
00:19:24,510 --> 00:19:26,540
.يمكنني أن أرى الأموات

425
00:19:27,570 --> 00:19:30,080
.ظننتُ أنّ ماساكي حيّة

426
00:19:30,080 --> 00:19:30,730
...لهذا

427
00:19:31,370 --> 00:19:32,450
.فهمت

428
00:19:34,810 --> 00:19:36,170
أتصدّقينني؟

429
00:19:36,680 --> 00:19:38,630
.لقد قمتُ بتحليل شخصيتك

430
00:19:39,110 --> 00:19:40,160
تحليلي؟

431
00:19:40,160 --> 00:19:42,320
،لا بدّ أنّك تعرّضت للأذى بسبب ذلك

432
00:19:42,320 --> 00:19:44,570
.ولهذا التحقتِ بالجولة

433
00:19:44,890 --> 00:19:45,900
.هذا هو تحليلي

434
00:19:49,450 --> 00:19:50,610
...ميتسوموني

435
00:19:50,610 --> 00:19:51,870
.ميتسوموني، استيقظ

436
00:19:53,210 --> 00:19:55,160
.ليون-سان

437
00:19:55,160 --> 00:19:56,320
نانكو-سان؟

438
00:19:56,320 --> 00:19:58,420
.ميتسوموني، فلنذهب لمساعدة ماساكي

439
00:19:58,420 --> 00:19:59,880
...ارحلي

440
00:20:00,100 --> 00:20:01,340
!ارحلي أيّتها الروح الشرّيرة

441
00:20:03,630 --> 00:20:04,860
.أرجوكم صدّقوني

442
00:20:05,940 --> 00:20:07,300
...أرجوكم

443
00:20:07,970 --> 00:20:09,850
.لستُ بشبح

444
00:20:09,850 --> 00:20:11,640
!لقد زاد الأمر عن حدّه

445
00:20:11,640 --> 00:20:13,210
!يجب أن نتحدّث معها أوّلًا

446
00:20:13,210 --> 00:20:15,330
.يجب أن تسايري الأمر يا كوهارون

447
00:20:15,330 --> 00:20:15,810
...لكن

448
00:20:16,090 --> 00:20:16,850
!حسنًا، التّالي

449
00:20:16,850 --> 00:20:18,270
!التعذيب بالماء! هيّا

450
00:20:18,270 --> 00:20:19,180
!مهلًا

451
00:20:22,810 --> 00:20:24,340
!لسنا بحاجةٍ للمبالغة إلى هذا الحد

452
00:20:24,340 --> 00:20:25,490
!لا بأس

453
00:20:25,490 --> 00:20:26,910
!إنّها شبح

454
00:20:26,910 --> 00:20:27,820
!هذا صحيح

455
00:20:27,820 --> 00:20:30,170
!أنت تصدّقين ذلك على الأقل، أليس كذلك؟

456
00:20:30,170 --> 00:20:31,550
.لكنّنا لسنا متيقّنين من ذلك

457
00:20:31,550 --> 00:20:32,870
...لهذا يجب أن نتحدّث إليها

458
00:20:32,870 --> 00:20:34,830
.لسنا بحاجةٍ لذلك

459
00:20:34,830 --> 00:20:37,100
!سنعرف كلّ شيء فور أن نطعنها بهذا

460
00:20:38,550 --> 00:20:39,610
،إنّها شبح

461
00:20:39,610 --> 00:20:41,510
،لذا ما لم نستخدم أشياءً مخصّصة للأشباح

462
00:20:41,510 --> 00:20:44,260
!فلن تموت مهمًا قمنا بطعنها

463
00:20:44,260 --> 00:20:44,900
!ماذا؟

464
00:20:44,900 --> 00:20:45,890
!هذا غير منطقي

465
00:20:45,890 --> 00:20:47,270
،إن لم تكن شبحًا

466
00:20:47,270 --> 00:20:48,220
!فستصبح هذه جريمة قتل

467
00:20:48,220 --> 00:20:50,720
إذًا لا تظنّ أنّها شبح؟

468
00:20:50,720 --> 00:20:52,210
—هذا ليس بيت القصيد

469
00:20:52,210 --> 00:20:53,450
.اهدئي رجاءً يا لوفبون

470
00:20:53,450 --> 00:20:55,100
.حسنٌ، هذا ما تقوله

471
00:20:55,100 --> 00:20:56,760
هل ستسمح لها بخداعك مجدّدًا؟

472
00:20:56,760 --> 00:20:57,850
،حتّى لو كانت شبحًا

473
00:20:57,850 --> 00:20:58,960
...فلا يجب مع ذلك أن نطعنها أو أيّ شيء

474
00:20:58,960 --> 00:21:00,070
ما الذي يجب أن نفعله إذًا؟

475
00:21:00,070 --> 00:21:03,190
.لا يجب أن نقوم بمثل هذه الأمور

476
00:21:03,190 --> 00:21:05,870
!رجاءً، فقط ارحلي من هذا المكان وعيشي بسلام

477
00:21:05,870 --> 00:21:06,740
...لكن

478
00:21:06,740 --> 00:21:07,700
.سأفعلها

479
00:21:07,700 --> 00:21:09,180
.سبيدستار

480
00:21:10,720 --> 00:21:11,620
.أعطنيه

481
00:21:12,090 --> 00:21:14,080
...لقد أغريتِ ميتسوموني

482
00:21:14,420 --> 00:21:15,540
!أيّتها الرّوح الشرّيرة

483
00:21:15,910 --> 00:21:16,750
!لا تفعل رجاءً

484
00:21:18,720 --> 00:21:20,630
!توقّف

485
00:21:20,970 --> 00:21:22,340
!أفلتني

486
00:21:31,760 --> 00:21:32,400
!إنّها تنزف

487
00:21:32,400 --> 00:21:32,960
.توقّفوا

488
00:21:32,960 --> 00:21:34,270
إنّها ليست شبح، أترون؟

489
00:21:34,650 --> 00:21:37,110
،إن كان بإمكانها أن تصوّر لنا الأشياء

490
00:21:37,110 --> 00:21:38,820
!فيمكنها أن تجعل نفسها تنزف

491
00:21:38,820 --> 00:21:40,730
.توقّف رجاءً

492
00:21:39,500 --> 00:21:40,730
!ما الذي تفعلونه يا رفاق؟

493
00:21:41,110 --> 00:21:42,190
...ميتسوموني

494
00:21:47,410 --> 00:21:49,840
!هايا— أنت

495
00:21:51,370 --> 00:21:52,800
!توقّف يا ميتسوموني

496
00:21:52,800 --> 00:21:53,580
لماذا؟

497
00:21:53,890 --> 00:21:55,150
!لمَ عساك تفعل شيئًا كهذا؟

498
00:21:55,150 --> 00:21:56,040
.اهدأ يا ميتسوموني

499
00:21:56,350 --> 00:21:59,920
.إنّها غلطة ماساكي لأنّنا هوجمنا من قِبل الوحوش

500
00:21:59,920 --> 00:22:02,000
.ماساكي تتحكّم بها

501
00:22:02,500 --> 00:22:03,960
—كلّا! أنا

502
00:22:03,960 --> 00:22:04,590
!اخرسي

503
00:22:04,590 --> 00:22:07,300
،لا أملك أدنى فكرة عمّا يجري

504
00:22:07,300 --> 00:22:11,010
لكن لمَ لا تستطيعون أن تُصدّقوا أحدًا عندما يقول أنّه لم يفعل شيئًا؟

505
00:22:11,010 --> 00:22:12,230
!ليست بأحد

506
00:22:12,230 --> 00:22:13,140
!إنّها شبح

507
00:22:13,140 --> 00:22:14,390
!ليست شبحًا

508
00:22:14,390 --> 00:22:16,020
!أنت لا تعلم أيّ شيء

509
00:22:16,020 --> 00:22:17,600
!ماساكي تخدعك

510
00:22:17,940 --> 00:22:19,240
!...إن ذهبت وحسب

511
00:22:19,240 --> 00:22:20,890
!لا

512
00:22:20,890 --> 00:22:21,770
!ثبّته على الأرض

513
00:22:22,080 --> 00:22:22,980
!ميتسوموني-كُن

514
00:22:23,940 --> 00:22:25,090
!توقّفوا

515
00:22:25,780 --> 00:22:28,740
.لا تؤذوه رجاءً

516
00:22:29,090 --> 00:22:32,200
.سأخبركم بالحقيقة

517
00:22:32,470 --> 00:22:33,990
...ماساكي-سان

518
00:24:07,570 --> 00:24:10,430
...ملاحقة ماساكي-تشان

519
00:24:10,430 --> 00:24:11,970
،هذا يشعرني نوعًا ما

520
00:24:11,970 --> 00:24:13,870
،مهمًا انتقلتُ إلى بيئة مختلفة

521
00:24:13,870 --> 00:24:16,370
.لم أستطع أن أتجنّب ملاحقتي

522
00:24:16,370 --> 00:24:20,350
...أولئك الأشخاص مقتنعون كلّ الاقتناع أنّهم على حق

523
00:24:20,350 --> 00:24:24,940
...أجل، رائحتهم كبياض البيض أيضًا

524
00:24:24,940 --> 00:24:26,370
.أتساءل لمَ ذلك