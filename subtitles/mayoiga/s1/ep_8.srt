1
00:00:00,620 --> 00:00:01,690
...إن رحلت وحسب

2
00:00:01,690 --> 00:00:03,530
!توقّف

3
00:00:03,530 --> 00:00:04,150
!ثبّتوه أرضًا

4
00:00:04,430 --> 00:00:05,350
!ميتسوموني-كُن

5
00:00:06,310 --> 00:00:07,590
!توقّفوا

6
00:00:08,520 --> 00:00:11,490
.أرجوكم لا تؤذوه أكثر

7
00:00:11,840 --> 00:00:14,950
.سأخبركم بالحقيقة

8
00:00:15,400 --> 00:00:16,660
!ماساكي-سان؟

9
00:00:18,340 --> 00:00:21,930
...سبق وأتيتُ إلى هنا
...إلى قرية ناناكي

10
00:00:22,580 --> 00:00:24,080
.ذات مرّة

11
00:00:26,040 --> 00:00:27,100
ماذا؟

12
00:02:07,760 --> 00:02:09,020
!هـ- ها هي ذي

13
00:02:10,990 --> 00:02:13,480
!إنّها الرّابعة يا ماساكي

14
00:02:13,480 --> 00:02:14,450
حقًّا؟

15
00:02:14,450 --> 00:02:15,620
.سعيدةٌ لأجلك

16
00:02:17,900 --> 00:02:20,090
.العلامة التالية قرب النّهر

17
00:02:20,090 --> 00:02:21,420
.فلنسترح هناك

18
00:02:21,940 --> 00:02:22,620
!حسنًا

19
00:02:26,540 --> 00:02:28,500
!ها هي! ها هي ذي

20
00:02:32,580 --> 00:02:35,170
!إن واصلنا على هذا النحو فسنصل قبل الظهيرة

21
00:02:35,170 --> 00:02:36,110
...أجل

22
00:02:36,110 --> 00:02:37,060
هل أنت متعبة؟

23
00:02:37,060 --> 00:02:38,510
أتريدين أن تستريحي أكثر؟

24
00:02:38,510 --> 00:02:40,130
.لا، أنا بخير

25
00:02:40,130 --> 00:02:41,390
.حسنًا

26
00:02:41,390 --> 00:02:46,100
أنا متفاجئ لأنّ عمّك وافق على أن تذهبي
.لتبحثي عن قريةٍ بمثابة أسطورة حضرية

27
00:02:46,100 --> 00:02:48,510
.قال أنّي سأكون بخير إن أتيت معي

28
00:02:48,510 --> 00:02:51,690
.لكنّه قال أيضًا أنّ علينا أن نعقد اجتماعًا عائليًّا كاملًا ما إن تأذّيت

29
00:02:52,090 --> 00:02:53,270
!مخيف

30
00:02:53,270 --> 00:02:57,690
.لطالما كان أبي يقول أنّ أخاه يُصبح أشدّ رعبًا من الوحش عندما يغضب

31
00:02:58,340 --> 00:03:01,290
أتظنّ أنّنا سنجدها حقًا؟

32
00:03:01,290 --> 00:03:03,340
...القرية التي تعدّ أسطورة حضرية

33
00:03:03,340 --> 00:03:04,230
!إنّها موجودة

34
00:03:04,230 --> 00:03:05,660
!إنها موجودة بهذا الجبل

35
00:03:06,490 --> 00:03:11,080
،لقد وجدنا علامات ثابتة تقود إلى قرية ناناكي

36
00:03:11,080 --> 00:03:13,860
.وقد قمنا بكل الاستعدادات اللازمة لإيجادها

37
00:03:14,290 --> 00:03:16,900
!العلامة الأخيرة كانت الخامسة، لذا علينا أن نجد علامتين أخرتين

38
00:03:16,900 --> 00:03:20,760
!إن اتّبعنا هذه العلامات فسنجد القرية

39
00:03:20,760 --> 00:03:24,010
...وإن كانت هذه العلامة في القرية التي وجدناها

40
00:03:26,700 --> 00:03:28,110
.هذا من صنيعي

41
00:03:28,110 --> 00:03:30,550
.بالتّفكير في الأمر، لم أتناول الفطور

42
00:03:30,550 --> 00:03:31,930
!أنا أتضوّر جوعًا

43
00:03:31,930 --> 00:03:33,230
...إذًا

44
00:03:33,230 --> 00:03:33,880
!جيّد

45
00:03:33,880 --> 00:03:34,690
هل أعددته بنفسك؟

46
00:03:35,000 --> 00:03:36,150
.أجل

47
00:03:38,610 --> 00:03:40,570
.يا له من ضبابٍ كثيف

48
00:03:45,280 --> 00:03:46,650
هل أُصبت؟

49
00:03:46,650 --> 00:03:47,980
.أجل، قليلًا

50
00:03:47,980 --> 00:03:49,810
.آسفٌ لأنّي لم أدرك ذلك

51
00:03:49,810 --> 00:03:52,290
.لا، بل إنّها غلطتي لأنّي لم أتحدّث

52
00:04:04,480 --> 00:04:06,430
إلى أين أنتما متوجهان؟

53
00:04:06,430 --> 00:04:07,580
ماذا؟

54
00:04:07,580 --> 00:04:09,170
—إلى الأمام

55
00:04:09,170 --> 00:04:11,390
.لا يجب أن تذهبا إلى هناك

56
00:04:11,390 --> 00:04:12,880
ولمَ لا؟

57
00:04:12,880 --> 00:04:14,860
.فقط عودا أدراجكما

58
00:04:14,860 --> 00:04:17,340
.سأرافقكما إلى المحطّة التي أسفل الجبل

59
00:04:17,340 --> 00:04:18,230
.انتظرا

60
00:04:22,720 --> 00:04:25,220
.ذلك الشخص كان مريبًا حقًا

61
00:04:25,220 --> 00:04:28,260
.أراهن أنّ قرية ناناكي أمامنا مباشرةً

62
00:04:28,260 --> 00:04:29,120
...ريجي

63
00:04:29,120 --> 00:04:30,500
.تماسكي يا ماساكي

64
00:04:30,500 --> 00:04:31,670
.كدنا نصل

65
00:04:41,870 --> 00:04:44,510
!إنّها قرية ناناكي— وجدناها أخيرًا

66
00:04:44,510 --> 00:04:45,530
!أحقًّا؟

67
00:04:46,030 --> 00:04:47,220
.انتظر

68
00:04:48,120 --> 00:04:49,090
!مذهل

69
00:04:49,090 --> 00:04:51,180
.إنّها كبيرة جدًّا وبها منازل عديدة

70
00:04:51,180 --> 00:04:52,390
!لكن ما من أحدٍ هنا

71
00:04:55,770 --> 00:04:57,600
!يا لها من قرية مهجورة رائعة

72
00:04:57,600 --> 00:05:00,110
!أراهن أنّ أعضاء النادي سيذهلون

73
00:05:04,650 --> 00:05:08,570
،كنت أتوقّع أسقفًا من القشّ ونمطًا قديمًا

74
00:05:08,570 --> 00:05:10,080
.لكن أظنّ أنّها عصريّة جدًّا

75
00:05:10,960 --> 00:05:12,600
...ريجي، علينا أن

76
00:05:12,600 --> 00:05:14,290
.لا تقلقي، سأنتهي قريبًا

77
00:05:15,200 --> 00:05:18,040
.أظنّ أن أحدًا ما كان يعيش هنا حديثًا

78
00:05:18,040 --> 00:05:21,000
.أجل، لكن يبدو منهمكًا قليلًا مع ذلك

79
00:05:21,260 --> 00:05:22,080
!ريجي

80
00:05:22,080 --> 00:05:26,370
.من المدهش أنّ لا أحد عثر على هذا المكان إلى الآن

81
00:05:26,370 --> 00:05:28,120
—لن ننتهي أبدًا من التحرّي حول هذا المكان

82
00:05:28,120 --> 00:05:28,970
!ريجي

83
00:05:34,850 --> 00:05:36,290
.آسف يا ماساكي

84
00:05:36,290 --> 00:05:37,880
...لقد نسيتُ نفسي

85
00:05:37,880 --> 00:05:38,810
.لا بأس

86
00:05:39,140 --> 00:05:41,320
...أملك مصباحًا يدويًا، لذا

87
00:05:44,550 --> 00:05:45,540
ما الأمر؟

88
00:05:45,540 --> 00:05:47,750
هل سمعتِ شيئًا للتّو؟

89
00:05:47,750 --> 00:05:48,410
ماذا؟

90
00:05:49,570 --> 00:05:50,080
.فلنسرع

91
00:05:53,990 --> 00:05:54,560
...اهربي

92
00:05:53,990 --> 00:05:54,900
!ريجي-كُن؟

93
00:05:54,560 --> 00:05:55,370
!اهربي

94
00:05:54,900 --> 00:05:55,980
لماذا؟

95
00:05:55,980 --> 00:05:57,080
!ألم تري ذلك الآن؟

96
00:05:57,080 --> 00:05:58,960
!ذلك الشيء الضخم الذي بدا كوحش؟

97
00:05:59,280 --> 00:06:00,420
...لا شيء

98
00:06:01,990 --> 00:06:02,380
!لا جدوى

99
00:06:02,610 --> 00:06:03,730
!تقدّمي

100
00:06:04,430 --> 00:06:05,210
!لا

101
00:06:06,170 --> 00:06:07,410
!ماساكي

102
00:06:15,270 --> 00:06:16,450
،وعندما استعدتُ وعيي

103
00:06:16,450 --> 00:06:18,810
.كان الطّريق أمامي

104
00:06:19,230 --> 00:06:23,090
،حاولت العودة وتسلّق الجبال مرّاتٍ عديدة

105
00:06:23,960 --> 00:06:26,900
.لكنّي لم أستطع أن أجد قرية ناناكي أبدًا

106
00:06:31,570 --> 00:06:33,450
.آسفة لأنّي لم أقل شيئًا

107
00:06:33,450 --> 00:06:35,830
،كنتُ أعرف بشأن الوحش الذي رأيتموه جميعًا

108
00:06:36,330 --> 00:06:37,790
.لكنّي لم أستطع قول أيّ شيء

109
00:06:37,790 --> 00:06:41,170
أنا فقط أردتُ أن أرى ريجي-كُن

110
00:06:41,170 --> 00:06:42,290
...وأنقذه

111
00:06:42,780 --> 00:06:44,750
.هذا كلّ شيء

112
00:06:44,750 --> 00:06:46,300
.فهمت

113
00:06:46,300 --> 00:06:49,090
.شخصٌ لطيف ينقذ فتاة

114
00:06:49,090 --> 00:06:50,820
...وكأنّ

115
00:06:50,820 --> 00:06:53,590
!وكأنّ أحدًا سيصدّق هذا

116
00:06:53,590 --> 00:06:56,350
!كيف لك أن تذهبي وتأتي كما تشائين؟

117
00:06:57,270 --> 00:06:58,820
...هذا صحيح

118
00:06:58,820 --> 00:07:02,710
.حتى نحن تمكنّا من العثور على هذه القرية صدفةً

119
00:07:02,710 --> 00:07:05,480
فكيف تمكّنتم من معرفة مكانها بشكلٍ صحيح؟

120
00:07:05,770 --> 00:07:09,600
.ريجي وجدها... أنا رافقته وحسب

121
00:07:09,600 --> 00:07:11,450
.لا أعلم كيف وجدها

122
00:07:12,900 --> 00:07:16,280
إذًا هل علمَ ريجي-سان ما تكون عليه هذه القرية؟

123
00:07:16,280 --> 00:07:17,330
.لا أدري

124
00:07:17,330 --> 00:07:22,080
.لكنّه قال أنّها مكانٌ حيث يتسنّى لنا نسيان كلّ شيء

125
00:07:23,050 --> 00:07:24,920
إذًا فقد كان خليلك؟

126
00:07:25,870 --> 00:07:29,710
...لا يبدو أنّه كان مجرّد صديق

127
00:07:30,620 --> 00:07:33,720
.لقد خاطر بحياته لأجل أن ينقذك من الوحش

128
00:07:34,490 --> 00:07:35,680
.إنه ابنُ عمّي

129
00:07:35,680 --> 00:07:37,140
.فهمت

130
00:07:37,140 --> 00:07:38,390
ابن عمّك؟

131
00:07:38,390 --> 00:07:39,350
...ماذا

132
00:07:39,350 --> 00:07:39,870
...إذًا

133
00:07:39,870 --> 00:07:42,220
إذًا فقد تكبّدتِ كلّ هذا الشقاء لتقابلي ابن عمّك مجدّدًا

134
00:07:42,220 --> 00:07:43,560
بعد أن خرجتِ من هنا أخيرًا؟

135
00:07:45,270 --> 00:07:47,710
هل استطعتِ مقابلته؟

136
00:07:48,430 --> 00:07:50,240
...لم يكن هنا

137
00:07:50,800 --> 00:07:52,490
.لربّما يكون في قرية أخرى

138
00:07:53,300 --> 00:07:54,900
!قرية أخرى؟

139
00:07:58,530 --> 00:07:59,170
ماذا؟

140
00:07:59,170 --> 00:08:00,250
هل من قرى أخرى؟

141
00:08:00,490 --> 00:08:02,610
إذًا فقرية ناناكي ليست الوحيدة؟

142
00:08:03,830 --> 00:08:06,290
!لمَ لمْ تذكري شيئًا بهذه الأهميّة من قبل؟

143
00:08:06,290 --> 00:08:07,190
!...حسنٌ

144
00:08:07,190 --> 00:08:09,000
!لقد كان مجرّد تخمين

145
00:08:09,530 --> 00:08:11,300
!لا أعلم عن وجود قرى أخرى

146
00:08:11,630 --> 00:08:13,300
لمَ فكّرت هكذا إذًا؟

147
00:08:13,570 --> 00:08:16,100
.أنا فقط تذكّرتُ أنّ ريجي-كُن ذكر شيئًا من هذا القبيل

148
00:08:16,100 --> 00:08:17,570
.لا أعلم حيال التفاصيل أيضًا

149
00:08:19,220 --> 00:08:22,520
ما هو أكثر أهمية، إن كنتِ تعلمين أين طريق الخروج

150
00:08:22,520 --> 00:08:23,250
.فأخبرينا

151
00:08:23,250 --> 00:08:24,970
!هذا صحيح، المخرج

152
00:08:24,970 --> 00:08:27,310
!كيف خرجت؟

153
00:08:27,530 --> 00:08:29,470
.لقد تهنا أيضًا

154
00:08:29,470 --> 00:08:32,480
...ربّما ذلك المكان... النفق

155
00:08:32,480 --> 00:08:34,820
حيث أمسكناها؟

156
00:08:34,820 --> 00:08:36,030
!لا تذهبوا إلى هناك

157
00:08:40,450 --> 00:08:42,410
.أعتقد أنّنا أصبنا

158
00:08:42,410 --> 00:08:43,750
!صحيح

159
00:08:43,750 --> 00:08:45,420
لا بدّ أنّه المخرج، صحيح؟

160
00:08:45,420 --> 00:08:47,060
!ليس المخرج

161
00:08:47,850 --> 00:08:51,240
.ظننتُه كذلك في البداية، لكنّي كنتُ مخطئة

162
00:08:51,240 --> 00:08:52,780
،لا يمكنني تفسير الأمر حقًّا

163
00:08:52,780 --> 00:08:55,880
.لكن أظنّ أنّه علينا أن نبقى بعيدين عن ذلك المكان

164
00:08:55,880 --> 00:08:57,260
ماذا؟ ماذا تقصدين بكلامك؟

165
00:08:57,260 --> 00:08:59,760
!لكن ألم ترين ما في الجانب الآخر؟

166
00:08:59,990 --> 00:09:02,520
...لقد انتابني شعورٌ سيّئ وحسب

167
00:09:02,520 --> 00:09:04,460
.لذا عدتُ أدراجي في منتصف الطريق

168
00:09:04,460 --> 00:09:06,980
!أين انتهى بك المطاف إذًا؟

169
00:09:06,980 --> 00:09:08,690
!لقد خرجت بالفعل، أليس كذلك؟

170
00:09:08,910 --> 00:09:10,320
.آسفة

171
00:09:10,320 --> 00:09:11,900
،لقد كان الطريق مظلمًا

172
00:09:12,200 --> 00:09:14,710
...وقد سقطتُ من الجرف، لذا

173
00:09:16,130 --> 00:09:17,780
.هناك شيءٌ لا أفهمه

174
00:09:18,040 --> 00:09:22,130
قلتِ أنك لم تري الوحش الذي رآه ذلك المدعو ريجي، صحيح؟

175
00:09:22,820 --> 00:09:23,540
...صحيح

176
00:09:23,540 --> 00:09:25,000
،مع أنّ الأمر اتّخذ أشكالًا مختلفة

177
00:09:25,310 --> 00:09:29,150
.إلّا أنّ الجميع رأوا أو سمعوا وحوشًا

178
00:09:29,150 --> 00:09:31,840
ألم تري شيئًا مختلفًا؟

179
00:09:32,490 --> 00:09:34,340
...لم أرَ أيّ شيء

180
00:09:34,340 --> 00:09:36,050
أما زلتِ لا ترين أي شيء؟

181
00:09:38,070 --> 00:09:39,170
،إن كانت لا ترى أي شيء

182
00:09:38,070 --> 00:09:39,170
لا ترين؟

183
00:09:39,170 --> 00:09:40,720
.فهذا يعني أنّها لن تتعرّض للهجوم أيضًا

184
00:09:39,170 --> 00:09:40,720
لماذا؟

185
00:09:41,050 --> 00:09:44,400
أيضًا، لمَ لا تزالين معنا؟

186
00:09:44,400 --> 00:09:47,440
.كان يمكنك أن تذهبي وتبحثي عن ابن عمّك وحسب

187
00:09:48,630 --> 00:09:49,860
...حسنٌ

188
00:09:49,860 --> 00:09:52,790
،حتّى لو كانت هناك قرية أخرى

189
00:09:52,790 --> 00:09:54,230
.لا أعلم كيف أصل إليها

190
00:09:54,500 --> 00:09:58,200
لكنّك أصبحت من المفقودين، أليس كذلك؟

191
00:09:58,200 --> 00:09:59,180
ماذا؟

192
00:09:59,180 --> 00:10:01,030
.عندما اختفيت مع يوتسون

193
00:10:01,240 --> 00:10:03,160
ربّما ذهبت لتبحثي عنه حينها؟

194
00:10:03,430 --> 00:10:05,290
هل كان يوتسون معك أثناء ذلك؟

195
00:10:05,550 --> 00:10:06,650
!لا

196
00:10:06,650 --> 00:10:07,540
...كان ذلك عندما

197
00:10:07,860 --> 00:10:10,080
،لم تريدي منه على الأغلب أن يعرف أين ذهبتِ

198
00:10:10,080 --> 00:10:11,920
!لذا فقد قتلته لتسكتيه

199
00:10:11,920 --> 00:10:13,150
!لا

200
00:10:13,150 --> 00:10:15,350
.أنا لا أعرف وحسب

201
00:10:15,350 --> 00:10:17,570
،أراهن أنّ ما قلته الآن كان محض كذب

202
00:10:17,570 --> 00:10:21,370
!وريجي هو مجرّد شخص سحبته معك إلى قرية ناناكي

203
00:10:21,930 --> 00:10:24,190
مهلًا! من أين لك بهذا الكلام؟

204
00:10:24,190 --> 00:10:25,970
.قصّتها مبهمة جدًّا

205
00:10:25,970 --> 00:10:29,240
.ربّما لم تكوني مدركةً لما تقومين به

206
00:10:29,580 --> 00:10:31,200
أتقصد أنّها شبح مقيّد بهذا المكان؟

207
00:10:31,200 --> 00:10:32,680
—ماذا؟ فقط أنصتوا لأنفسكم

208
00:10:32,680 --> 00:10:36,070
!وقد اخترتِنا الآن لنكون هدفك القادم

209
00:10:36,070 --> 00:10:37,010
!لا

210
00:10:37,010 --> 00:10:37,980
!هذا ليس صحيحًا

211
00:10:37,980 --> 00:10:41,800
إذًا هل عدتِ إلى بيتك بعد أن غادرت القرية؟

212
00:10:41,800 --> 00:10:42,880
ماذا؟

213
00:10:42,880 --> 00:10:46,290
لمَ لمْ تعودي إلى البيت إن لم تستطيعي العودة إلى القرية؟

214
00:10:46,290 --> 00:10:47,420
!هذا صحيح

215
00:10:47,420 --> 00:10:50,080
.ليس وكأنّك فررتِ إلى هنا على خلافنا

216
00:10:50,080 --> 00:10:52,790
.لا، لم أعد أبدًا

217
00:10:53,020 --> 00:10:53,980
ولمَ لا؟

218
00:10:53,980 --> 00:10:56,240
.إن لم تكوني شبحًا مقيّدًا بهذا المكان، كان بإمكانكِ أن تعودي

219
00:10:56,240 --> 00:10:57,950
.لا بدّ أنّ أبويك قلقان

220
00:10:57,950 --> 00:10:59,880
.لكنّ هذا ينطبق عليكِ أيضًا يا بيتان

221
00:10:59,880 --> 00:11:01,270
...حسنٌ

222
00:11:01,270 --> 00:11:05,100
.شعرتُ أنّي لن أستطيع العودة إلى هنا أبدًا إن عدتُ إلى الديار

223
00:11:05,100 --> 00:11:09,190
.كان بإمكانك أن تعودي إلى هنا خلسةً بعد أن تطمئني عائلتك عليك

224
00:11:09,190 --> 00:11:11,970
،لربّما لديك سرًّا فظيعًا
!ولهذا لم تعودي أبدًا

225
00:11:11,970 --> 00:11:12,940
!لا

226
00:11:13,240 --> 00:11:15,870
!أنا فقط أردتُ أن أعود إلى هنا بأسرع ما يمكن

227
00:11:16,410 --> 00:11:20,830
لقد كنتُ في بلدة مجاورة طوال هذا
!الوقت محاولةً إيجاد الطّريق إلى قرية ناناكي

228
00:11:20,830 --> 00:11:23,240
،عرفتُ بشأن هذه الجولة على الإنترنت

229
00:11:23,240 --> 00:11:26,590
.وفكّرتُ أنّه بإمكاني أن أذهب إلى قرية ناناكي إن التحقتُ بها

230
00:11:27,660 --> 00:11:29,110
بلدة مجاورة؟

231
00:11:29,110 --> 00:11:30,580
لكن ماذا فعلتِ لأجل جني المال؟

232
00:11:30,580 --> 00:11:32,990
.حسنٌ... لقد عملتُ بوظيفة بدوامٍ جزئي

233
00:11:32,990 --> 00:11:34,400
هل كنت تستعملين اسمك الحقيقي؟

234
00:11:35,470 --> 00:11:36,670
.نعم

235
00:11:44,680 --> 00:11:50,510
.إذًا فقد كنتِ تعملين بوظيفة بدوام جزئي قبل أن تلتحقي بهذه الجولة

236
00:11:50,510 --> 00:11:52,610
،بعد أن تمّ إدراجك مع المختفين

237
00:11:52,610 --> 00:11:54,150
لم تمانعي استخدام اسمك الحقيقي وما إلى ذلك؟

238
00:11:55,040 --> 00:11:57,450
كم من الوقت عشت هناك؟

239
00:11:57,450 --> 00:11:58,610
...هذا

240
00:11:58,610 --> 00:12:00,510
—واثقٌ أنّك استطعتِ متابعة الأخبار

241
00:12:00,510 --> 00:12:03,320
!أخبار اختفائك

242
00:12:03,530 --> 00:12:04,950
...أنا

243
00:12:06,620 --> 00:12:07,490
.هذا هو الدّليل الذي نحتاجه

244
00:12:07,760 --> 00:12:10,410
!لقد سحبتنا إلى هنا بالفعل

245
00:12:10,410 --> 00:12:11,130
!مخيفة جدًّا

246
00:12:11,130 --> 00:12:13,360
!أشعر بالقشعريرة

247
00:12:13,360 --> 00:12:15,680
!إنّها تستحقّ الإعدام بالتّأكيد

248
00:12:15,680 --> 00:12:19,840
!فلنعدمها— أعني، فلنطردها

249
00:12:19,840 --> 00:12:21,130
.هذا ليس صحيحًا

250
00:12:21,130 --> 00:12:24,760
.أردتُ أن أساعد ريجي وحسب

251
00:12:24,100 --> 00:12:25,540
!فقط توقّفوا جميعًا

252
00:12:25,540 --> 00:12:26,900
!ابتعد عن الطريق يا ميتسوموني

253
00:12:26,900 --> 00:12:28,290
سمعت ما قالته، أليس كذلك؟

254
00:12:28,290 --> 00:12:29,540
!إنّها خطيرة

255
00:12:29,540 --> 00:12:32,770
!ستكون متوتّرة بالطبع بعد أن عاملتموها هكذا

256
00:12:33,140 --> 00:12:35,590
.لا بدّ أنّها محتارة ولا تستطيع أن تفسّر نفسها كما يجب

257
00:12:35,590 --> 00:12:37,200
أليس كذلك يا ماساكي-سان؟

258
00:12:37,200 --> 00:12:38,480
.ميتسوموني-كُن

259
00:12:38,820 --> 00:12:41,300
لذا فلنهدأ وحسب، حسنًا؟

260
00:12:41,300 --> 00:12:43,900
.يمكننا أن نسألها عن كلّ هذا مجدّدًا غدًا

261
00:12:46,070 --> 00:12:47,070
!أعطنيه

262
00:12:49,000 --> 00:12:51,040
!قطع الرّأس

263
00:12:51,040 --> 00:12:53,000
!توقّف أيّها الغبي

264
00:12:53,000 --> 00:12:53,870
!توقفوا

265
00:12:53,870 --> 00:12:55,810
!توقفوا رجاءً

266
00:12:55,810 --> 00:12:57,470
!اربطوها مجدّدًا الآن

267
00:12:56,590 --> 00:12:58,790
!أعدموها الآن

268
00:12:57,470 --> 00:12:58,250
...توقّفوا

269
00:12:58,250 --> 00:12:58,790
!احذر

270
00:12:58,790 --> 00:13:00,090
!لا تطعنّي

271
00:13:00,090 --> 00:13:01,850
...توقّفوا

272
00:13:06,090 --> 00:13:06,970
!ماساكي-سان

273
00:13:18,480 --> 00:13:19,330
ماذا؟

274
00:13:19,330 --> 00:13:20,230
لمَ أتت الحافلة إلى هنا؟

275
00:13:20,230 --> 00:13:21,410
!السّائق؟

276
00:13:23,860 --> 00:13:25,110
!ميتسوموني

277
00:13:30,120 --> 00:13:31,120
!هاياتو؟

278
00:13:33,910 --> 00:13:34,540
!لا تدعوهم يهربوا

279
00:13:34,540 --> 00:13:36,120
!القول سهل

280
00:13:39,850 --> 00:13:40,590
!تبًّا

281
00:13:40,970 --> 00:13:42,050
!هاياتو

282
00:13:42,050 --> 00:13:43,330
!توقّف

283
00:13:43,330 --> 00:13:44,130
!توقّف رجاءً

284
00:13:44,130 --> 00:13:45,300
!اخرس

285
00:13:45,300 --> 00:13:46,590
!سأرميك إلى الخارج إن لم تطبق فمك

286
00:13:46,590 --> 00:13:48,530
...وإن واصلت، هاياتو سوف

287
00:13:48,530 --> 00:13:50,950
!لن نوقفك، لذا توقف للحظة رجاءً

288
00:13:50,950 --> 00:13:52,600
!"قلت "اخرس

289
00:13:55,810 --> 00:13:57,170
!الحقوا بالحافلة

290
00:13:57,170 --> 00:13:59,150
!ليس وكأنّهم يستطيعون المغادرة

291
00:13:59,730 --> 00:14:03,380
.أتساءل ماذا يُخطّط السائق أن يفعل مع ماساكي-سان

292
00:14:03,380 --> 00:14:06,200
.لعلّه يريدها أن تريه المخرج

293
00:14:06,200 --> 00:14:08,110
.لكنّ السائق لا يعرف هذا بشأنها

294
00:14:11,530 --> 00:14:14,030
كيف يمكننا أن نمسك بهم بعد أن نلاحقهم؟

295
00:14:14,030 --> 00:14:15,400
.إنّنا في مواجهة حافلة كبيرة

296
00:14:15,400 --> 00:14:17,660
.لا أريدها أن تدهسني وتحوّلني إلى عجينة

297
00:14:17,660 --> 00:14:18,560
،حتى لو وجدناهم

298
00:14:18,560 --> 00:14:20,250
.لا جدوى إن ابتعدت الحافلة مجدّدًا

299
00:14:20,250 --> 00:14:21,930
.علينا أن نمنع حدوث ذلك

300
00:14:21,930 --> 00:14:24,270
.ميتسوموني-كُن وسبيد ستار على متنها

301
00:14:24,270 --> 00:14:26,300
.ربّما يمكننا أن نتعاون معهما

302
00:14:26,300 --> 00:14:27,280
!صحيح

303
00:14:27,280 --> 00:14:28,470
!إنّهما على متن الحافلة

304
00:14:28,470 --> 00:14:29,870
،إن كان هناك شخصان على متنها

305
00:14:29,870 --> 00:14:32,910
.فسيستطيعان منع السّائق من فعل أيّ شيء لماساكي

306
00:14:32,910 --> 00:14:36,290
.كما أنّ ميتسوموني مهتمٌّ كثيرًا بماساكي

307
00:14:36,750 --> 00:14:41,730
...بشأن قدوم ماساكي-تشان إلى قرية ناناكي رفقة ابن عمّها

308
00:14:42,360 --> 00:14:44,440
...ما زلتُ لا أدري ما إن كان ذلك صحيحًا أم لا، لكن

309
00:14:44,440 --> 00:14:45,520
.لا بدّ أنّها كذبة

310
00:14:45,520 --> 00:14:46,940
.ذلك واضحٌ جدًّا

311
00:14:47,350 --> 00:14:49,280
،لو كان ما قالته صحيحًا

312
00:14:49,280 --> 00:14:52,980
.فماساكي-تشان مختلفةٌ عن بقيّتنا في نقطةٍ معيّنة

313
00:14:52,980 --> 00:14:55,240
.لا يمكنها أن ترى الوحوش

314
00:14:56,120 --> 00:14:58,200
،ريجي رآه

315
00:14:58,200 --> 00:15:00,700
.لكن ماساكي لم تره

316
00:15:00,700 --> 00:15:02,370
،لم نتيقّن من هذا بعد

317
00:15:02,370 --> 00:15:04,860
...لكن ما تزال لا ترى أيّ شيء. ممّا يعني

318
00:15:04,860 --> 00:15:06,510
ممّا يعني؟

319
00:15:06,510 --> 00:15:10,180
.ربّما لا تملك ماساكي أيّ ندبات نفسيّة تسبّب لها رؤية الوحوش

320
00:15:11,010 --> 00:15:14,890
.ربّما لا تملك ماساكي ماضيًّا يسبّب لها رؤية الوحوش

321
00:15:14,890 --> 00:15:16,250
ماضي؟

322
00:15:16,250 --> 00:15:20,600
إذًا فهي لا تملك ماضٍ سيّئ تشمئزّ للتّفكير به؟

323
00:15:20,920 --> 00:15:25,140
.جميعنا نرى ماضيًّا نأمل وكأنّه لم يحدث

324
00:15:25,140 --> 00:15:26,570
،إن لم يكن لدى أحد مثل هذا الماضي

325
00:15:26,800 --> 00:15:28,630
.فربّما لا توجد وحوشًا يرونها

326
00:15:29,050 --> 00:15:31,330
.لهذا استطاعت ماساكي أن تهرب

327
00:15:31,330 --> 00:15:32,320
مهلًا، ماذا؟

328
00:15:32,320 --> 00:15:33,150
...هذا يعني

329
00:15:33,150 --> 00:15:34,930
،إن كان يمكننا التوقّف عن رؤية الوحوش

330
00:15:34,930 --> 00:15:37,290
أيمكننا أن نغادر؟

331
00:15:37,600 --> 00:15:42,080
على كلّ حال، قد يكون من الصّعب كثيرًا
.علينا إيجاد الحافلة الآن بسبب الظلام الدّامس

332
00:15:42,080 --> 00:15:43,500
.ربّما يجب أن ننتظر حلول الفجر

333
00:15:43,500 --> 00:15:47,680
.إذًا دعونا نفكّر في طريقة لإيقاف الحافلة اللّيلة

334
00:15:48,420 --> 00:15:49,960
.كلّ هذه مجرّد فرضيّات

335
00:15:49,960 --> 00:15:53,390
.علينا أن نتأكّد ما إن كان ذلك ممكنًا مع ذلك

336
00:15:53,720 --> 00:15:54,590
.أجل

337
00:16:00,920 --> 00:16:01,590
!هاياتو

338
00:16:01,590 --> 00:16:02,440
!هل أنت بخير؟

339
00:16:06,060 --> 00:16:06,700
!هيّا

340
00:16:06,700 --> 00:16:07,310
!دعيني أراها

341
00:16:07,310 --> 00:16:08,020
!حالًا

342
00:16:08,020 --> 00:16:08,400
ماذا؟

343
00:16:08,750 --> 00:16:10,070
!أنت شبح، صحيح؟

344
00:16:10,070 --> 00:16:12,110
!دعيني إذًا أرى ابنتي

345
00:16:12,110 --> 00:16:13,950
...سيّدي، كما قلنا، ذلك

346
00:16:14,160 --> 00:16:16,260
.لستُ شبحًا

347
00:16:16,260 --> 00:16:18,580
—إنّما كنتُ هنا من قبل

348
00:16:18,820 --> 00:16:20,000
!أخبريني

349
00:16:20,000 --> 00:16:21,790
!تعرفين كيف يمكنني مقابلتها، صحيح؟

350
00:16:21,790 --> 00:16:23,440
!توقّف أرجوك

351
00:16:23,440 --> 00:16:25,630
!لا أعلم حقًّا

352
00:16:25,850 --> 00:16:27,900
!أريد أن أرى ابنتي

353
00:16:27,900 --> 00:16:28,930
!هذا كلّ شيء

354
00:16:28,930 --> 00:16:33,550
إن كنتِ شبحًا مثلها، فيمكنك أن تحضري ميساتو، صحيح؟

355
00:16:34,620 --> 00:16:36,760
...أرجوك

356
00:16:37,020 --> 00:16:39,060
!أتوسّل إليك

357
00:16:39,930 --> 00:16:42,860
.آسفة لأنّي لا أستطيع مساعدتك

358
00:16:43,410 --> 00:16:45,120
ماساكي-سان، هل أنت بخير؟

359
00:16:45,120 --> 00:16:47,530
.أجل، شكرًا لك يا ميتسوموني-كُن

360
00:16:48,570 --> 00:16:50,780
أيمكننا حقًّا أن نوقف الحافلة بهذه الأشياء؟

361
00:16:51,010 --> 00:16:53,670
.علينا أن نجدها فقط ونتسلّل داخلها

362
00:16:53,670 --> 00:16:56,330
.حسنًا، فلننزع عجلاتها قبل أن يدرك

363
00:16:56,330 --> 00:16:57,940
...لا نملك مثل تلك المعدّات

364
00:16:57,940 --> 00:17:00,560
ما رأيكم أن ننصب فخًّا لثقب الإطارات؟

365
00:17:00,560 --> 00:17:02,810
.حينها لن نستطيع استخدام الحافلة أيضًا عندما نحتاجها

366
00:17:02,810 --> 00:17:03,600
.صحيح

367
00:17:03,600 --> 00:17:05,630
أليس هناك إصلاح سريعٌ لذلك؟

368
00:17:05,630 --> 00:17:09,200
.إنّه ذلك النّوع حيث نقوم بإعادة نفخ العجلات وسدّ الثقب بصمغٍ ما

369
00:17:09,200 --> 00:17:11,200
.واثقٌ أنّ هناك إطارٌ احتياطيّ

370
00:17:11,200 --> 00:17:13,490
ما رأيكم أن نجعلها تعلق بالوحل؟

371
00:17:13,490 --> 00:17:15,510
ومن أين لنا بقدرٍ كافٍ من الوحل لفعل ذلك؟

372
00:17:15,510 --> 00:17:16,020
...حسنٌ

373
00:17:16,020 --> 00:17:17,520
.يمكننا صنعه عن طريق مزج التراب بالماء

374
00:17:17,520 --> 00:17:19,000
!ماذا؟

375
00:17:20,600 --> 00:17:21,880
إلى أين أنت ذاهب؟

376
00:17:21,880 --> 00:17:24,430
.سأجد شيئًا من شأنه أن يثقب الإطارات

377
00:17:24,430 --> 00:17:26,720
.سأذهب لمعرفة قطر البحث

378
00:17:26,720 --> 00:17:27,470
،لذا فور أن نجدها

379
00:17:27,470 --> 00:17:29,020
،سنقودها إلى الفخ

380
00:17:29,020 --> 00:17:30,520
.ونثقب إطاراتها

381
00:17:37,170 --> 00:17:38,620
.أنت متحمّس حقًّا حيال هذا

382
00:17:42,180 --> 00:17:44,490
فالكانا، ما رأيك مع ذلك؟

383
00:17:44,920 --> 00:17:45,730
ماذا؟

384
00:17:45,730 --> 00:17:48,280
،حيث أنّ كلّ شيء بدأ معي

385
00:17:48,280 --> 00:17:49,730
.لأنّي من خطّطتُ لهذه الجولة

386
00:17:50,210 --> 00:17:52,700
،إلّا أنّ الجميع يلوم ماساكي-تشان

387
00:17:52,700 --> 00:17:54,520
.وجعلها تخوض كلّ هذا الألم وحدها

388
00:17:55,040 --> 00:17:56,510
.لكنّها غلطتي أنا

389
00:17:58,330 --> 00:18:00,610
.أتينا إلى هنا لأننا أردنا ذلك

390
00:18:00,610 --> 00:18:04,720
.ظننّا أنّه يمكننا أن نتخلّص من حياتنا السيّئة إن أتينا إلى هنا

391
00:18:04,720 --> 00:18:06,430
.لذا فهي ليست غلطتك

392
00:18:06,430 --> 00:18:09,900
لكن ماذا لو كان كلّ ما قلته كذبًا أيضًا؟

393
00:18:11,090 --> 00:18:12,770
،قبل أن يبدؤوا بالشكّ بماساكي-تشان

394
00:18:12,770 --> 00:18:14,820
.أنا من كانوا يشكّون بها

395
00:18:16,890 --> 00:18:19,220
،بفضل إلقائهم لكلّ اللّوم على ماساكي

396
00:18:19,220 --> 00:18:21,830
.جميعهم نسوا أنّهم كانوا يشكّون بي

397
00:18:21,830 --> 00:18:24,070
.ماساكي-تشان بمثابة كبش الفداء الخاص بي

398
00:18:24,070 --> 00:18:26,750
ألا تشكّ بي على الإطلاق يا فالكانا؟

399
00:18:27,130 --> 00:18:28,490
.بالطّبع أشكّ

400
00:18:28,490 --> 00:18:30,030
.لكن ليس بك وحسب

401
00:18:30,030 --> 00:18:31,760
.بل أشكّ بجميع من بهذه الجولة

402
00:18:31,760 --> 00:18:33,710
.لا أثق في أيّ أحد

403
00:18:34,460 --> 00:18:38,220
.إنّها غلطتي لأنني التحقتُ بالجولة

404
00:18:38,220 --> 00:18:39,770
.هذا ساخرٌ حقًّا

405
00:18:39,770 --> 00:18:41,890
،خلتُني لن أؤمن بأيّ شيء

406
00:18:41,890 --> 00:18:46,270
.لكنّي آمنتُ بوجود مكانٍ حيث يمكنني أن أنسى كلّ ما كرهته

407
00:18:46,840 --> 00:18:49,020
.لكن لا يمكنني أن أعود للواقع الآن

408
00:18:49,020 --> 00:18:51,490
،إن كنتُ سأعيش هنا من الآن فصاعدًا

409
00:18:51,490 --> 00:18:53,790
.فعليّ أن أعرف ماهية هذا المكان

410
00:18:53,790 --> 00:18:57,870
.ولأجل ذلك، عليّ أن أمسك بماساكي لأنّها تعرف الكثير

411
00:18:57,870 --> 00:18:58,940
.هذا كلّ شيء

412
00:18:58,940 --> 00:19:00,000
.فهمت

413
00:19:01,530 --> 00:19:04,950
.أظنّني سأصدّق ما قالته

414
00:19:06,910 --> 00:19:09,530
.لا أظنّها كانت تكذب

415
00:19:09,530 --> 00:19:11,620
.أريد أن أساعدها

416
00:19:11,840 --> 00:19:13,370
،إن قام بقيتهم بالقبض عليها الآن

417
00:19:13,370 --> 00:19:15,540
.فسيحصل نفس ما حصل من قبل

418
00:19:15,540 --> 00:19:18,590
.أظنّني سأحاول إيجادها أوّلًا

419
00:19:18,590 --> 00:19:20,050
ما خطّتك؟

420
00:19:20,050 --> 00:19:23,510
.لذا أريد منك أن تساعدني

421
00:19:25,350 --> 00:19:28,160
،يمكنني أن أفهم لمَ لا تستطيع أن تثق بأيّ أحد

422
00:19:28,160 --> 00:19:31,730
.إنّما أحتاج أيّ مساعدة منك

423
00:19:32,570 --> 00:19:34,460
،حسنٌ... حتّى لو كنتُ لا أثق بك

424
00:19:34,460 --> 00:19:36,020
،إن كنّا نتشارك نفس الأهداف

425
00:19:36,020 --> 00:19:38,190
.فيمكننا أن نعمل سويًّا على الأقل

426
00:19:39,440 --> 00:19:40,430
.شكرًا

427
00:19:46,330 --> 00:19:47,800
ألم تستطيعي النوم؟

428
00:19:51,660 --> 00:19:53,980
كيف لأيّ أحدٍ أن ينام بعد يومٍ كهذا؟

429
00:19:54,400 --> 00:19:55,520
.صحيح

430
00:20:01,730 --> 00:20:03,320
...إن ارتدّت خمس مرّات

431
00:20:07,150 --> 00:20:08,490
!سأفعلها المرّة القادمة بالتّأكيد

432
00:20:08,810 --> 00:20:10,360
لمَ خمس مرّات؟

433
00:20:10,360 --> 00:20:11,580
!أتمنّى أمنية

434
00:20:11,580 --> 00:20:12,630
...إن ارتدّت

435
00:20:16,870 --> 00:20:18,120
و؟

436
00:20:18,120 --> 00:20:19,470
.لا أريد أن أفصح عن أمنيتي

437
00:20:19,470 --> 00:20:20,690
لمَ لا؟

438
00:20:21,180 --> 00:20:23,000
.حسنٌ، لم ترتد خمس مرّات

439
00:20:23,500 --> 00:20:25,120
.إذًا فلنحلّل هذا

440
00:20:25,120 --> 00:20:25,910
ماذا؟

441
00:20:27,130 --> 00:20:30,580
.مشهد مساء البارحة ذكّركِ بشيءٍ ما

442
00:20:31,500 --> 00:20:36,290
.لا أحد سيرضيه مشاهدة مطاردة الساحرات تلك

443
00:20:36,290 --> 00:20:41,440
...ربّما شاهدتِ شيئًا مشابهًا من قبل، أو

444
00:20:41,440 --> 00:20:42,420
!حسنًا

445
00:20:42,420 --> 00:20:43,510
!حسنًا، سأتحدّث

446
00:20:44,740 --> 00:20:47,720
...تعاون الجميع ضدّ تلك الفتاة

447
00:20:48,010 --> 00:20:50,680
.إنّهم مثل تلك العصابة التي كانت تتعاون ضدّي

448
00:20:51,630 --> 00:20:54,980
إذًا فقد خضت مطاردة ساحرات أيضًا؟

449
00:20:54,980 --> 00:20:57,290
...لا، لم يكن الأمر بذلك السّوء

450
00:20:57,940 --> 00:21:00,530
.لكنّ ذلك الشيء لم يعجبني
.لهذا أتيت إلى هنا

451
00:21:01,210 --> 00:21:02,480
.والآن أنا متعبة فقط

452
00:21:02,480 --> 00:21:03,700
ماذا تريدين أن تفعلي؟

453
00:21:04,290 --> 00:21:07,730
...فقط لو كان معي أحدٌ يحميني حينها

454
00:21:08,200 --> 00:21:12,660
،لو كان معي شخصٌ واحد فقط ليساعدني
.لربّما اتّخذت الأمور منحى مختلف

455
00:21:13,040 --> 00:21:15,370
.شخص مثل ميتسوموني

456
00:21:16,050 --> 00:21:18,950
،إنّه غبيٌّ نوعًا ما لحمايتها مع أنّه لا يملك أيّ دليل

457
00:21:18,950 --> 00:21:20,900
.لكن من الجميل أن يحميك أحدهم

458
00:21:21,330 --> 00:21:24,590
.أتساءل إن كان هناك أغبياء آخرون مثله

459
00:21:28,200 --> 00:21:30,640
.هناك شيء يجب أن أتفقّده

460
00:21:42,060 --> 00:21:42,900
حسنٌ؟

461
00:21:44,940 --> 00:21:47,170
.ما زالوا نيّام

462
00:21:47,170 --> 00:21:47,850
.فلنذهب

463
00:21:47,850 --> 00:21:48,410
.أجل

464
00:21:55,570 --> 00:21:56,290
.شكرًا

465
00:21:56,290 --> 00:21:58,000
.فقط أسرعي

466
00:22:02,380 --> 00:22:03,170
فالكانا؟

467
00:22:04,690 --> 00:22:05,600
!احترسي

468
00:22:07,730 --> 00:22:08,500
ماذا؟

469
00:22:09,490 --> 00:22:10,730
!أيها الوغد

470
00:22:10,730 --> 00:22:11,500
!لا تفعل

471
00:22:11,500 --> 00:22:12,140
!فلنهرب

472
00:22:14,100 --> 00:22:14,680
!فالكانا

473
00:22:14,680 --> 00:22:15,220
!اتركني

474
00:22:15,220 --> 00:22:16,600
!يمكنني أن أركض لوحدي

475
00:22:16,940 --> 00:22:17,680
!أنت

476
00:22:17,680 --> 00:22:19,340
!كيف تبدو لك؟

477
00:22:19,670 --> 00:22:20,860
سهام حجرية؟

478
00:22:20,860 --> 00:22:22,230
!هكذا كيف أراها أيضًا

479
00:22:22,970 --> 00:22:24,310
نحن نرى نفس الشيء؟

480
00:22:24,310 --> 00:22:25,190
—هذا يعني

481
00:22:27,850 --> 00:22:28,750
!فلتمت

482
00:22:33,990 --> 00:22:35,330
...أنتما

483
00:24:07,730 --> 00:24:10,820
ما الذي نخفيه في أعماقنا؟

484
00:24:10,820 --> 00:24:12,890
.لا أكترث لمثل هذه الأمور

485
00:24:12,890 --> 00:24:15,810
.بالطّبع، أخفيتُ الكثير من الأمور

486
00:24:15,810 --> 00:24:16,600
،كان أبي جيّدًا في الادّعاء

487
00:24:16,840 --> 00:24:19,380
لكنّه كان نذلًا لطالما فكّر أنّ الأمور ستسير على طريقته

488
00:24:19,380 --> 00:24:22,230
.ما دام يدّعي أنّه شخصٌ جيّد

489
00:24:22,230 --> 00:24:25,710
.ربّما سأشعر أنّي أفضل لو توقّفت عن إخفاء كلّ شيء