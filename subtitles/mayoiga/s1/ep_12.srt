1
00:00:04,500 --> 00:00:05,990
...إنّ ناناكي

2
00:00:07,860 --> 00:00:09,500
!من هذه العجوز؟

3
00:00:09,500 --> 00:00:11,480
.ناناكي الخاص بي لا يبدو هكذا

4
00:00:11,480 --> 00:00:12,180
ماذا؟

5
00:00:12,180 --> 00:00:14,450
هل تبدو لك كسيدة عجوز؟

6
00:00:14,450 --> 00:00:15,530
ماذا؟ أنت أيضًا؟

7
00:00:15,980 --> 00:00:17,010
.يمكنني أن أراه

8
00:00:17,010 --> 00:00:17,730
.أجل

9
00:00:24,170 --> 00:00:27,670
.كما توقعت، لقد كنتَ مع ماساكي

10
00:00:27,670 --> 00:00:28,690
!هاياتو

11
00:00:28,690 --> 00:00:30,670
مهلًا، أهذا الخاص بك؟

12
00:00:42,950 --> 00:00:43,890
...إنّ ناناكي

13
00:00:43,890 --> 00:00:45,280
!ينصت إليه؟

14
00:00:45,280 --> 00:00:46,200
لماذا؟

15
00:00:46,200 --> 00:00:48,270
!ألا يفترض به أن يهاجمك؟

16
00:00:48,480 --> 00:00:50,170
!أيتها العجوز البغيضة

17
00:00:50,170 --> 00:00:52,260
!تستطيعين فهمي، صحيح؟

18
00:00:52,260 --> 00:00:55,240
!اقتليهم

19
00:00:55,240 --> 00:00:56,450
!اهربوا

20
00:00:56,450 --> 00:00:58,910
!سنُعدم

21
00:00:58,910 --> 00:00:59,890
!ماساكي-سان

22
00:00:59,890 --> 00:01:02,500
"!إلى الآن ما زلتَ تُردّد "ماساكي، ماساكي، ماساكي

23
00:01:02,760 --> 00:01:05,600
!من أنت على أي حال؟ عبدها؟

24
00:01:08,080 --> 00:01:12,390
!لقد خُدعت بمظهر هذه الفتاة المتلاعِبة الشّريرة

25
00:01:12,780 --> 00:01:13,450
!توقف

26
00:01:13,450 --> 00:01:14,370
.لقد أسأت الفهم

27
00:01:14,370 --> 00:01:15,910
.ماساكي-سان ليست هكذا

28
00:01:15,910 --> 00:01:18,560
!كيف هي إذًا؟

29
00:01:18,560 --> 00:01:21,710
.حسنٌ، إنها تلاحظ على الفور إن قلق شخصٌ ما

30
00:01:21,710 --> 00:01:24,970
،إنّها مراعية وتبادر للقيام بالأشياء التي لا يودّ الآخرون القيام بها

31
00:01:24,970 --> 00:01:27,440
—كالتّنظيف و

32
00:01:26,530 --> 00:01:28,050
!لا أريد أن أسمع المزيد

33
00:01:33,870 --> 00:01:35,360
!لمَ أهجته؟

34
00:01:35,360 --> 00:01:36,990
!أنت غبيّ حقًّا

35
00:01:37,390 --> 00:01:38,700
لكن...؟

36
00:01:43,420 --> 00:01:45,320
!أهذا ناناكي الخاص بي؟

37
00:01:46,290 --> 00:01:48,590
هل يبدو ناناكي خاصتك هكذا؟

38
00:01:48,590 --> 00:01:49,710
!إنه ظريف بطريقة غريبة

39
00:01:49,710 --> 00:01:51,440
لكن لمَ هو هنا؟

40
00:01:51,440 --> 00:01:53,300
.ربما لا يريد أن ينفصل عنك

41
00:01:53,300 --> 00:01:54,190
ماذا؟

42
00:01:54,190 --> 00:01:55,560
!ما الذي تفعله؟

43
00:01:55,560 --> 00:02:01,260
.إنّها تحبسه في قفصٍ للعصافير لأنّها تريد أن تأخذ ميتسوموني-كُن

44
00:02:01,260 --> 00:02:06,680
!أنت لا تعلمين أيّ شيءٍ عنّي أيّتها الحقيرة

45
00:02:06,680 --> 00:02:07,700
...فهمت

46
00:02:07,700 --> 00:02:10,060
.هذا أنا

47
00:02:10,450 --> 00:02:11,770
.أنا ضعيف

48
00:02:11,770 --> 00:02:14,270
...لطالما حماني هاياتو

49
00:02:14,770 --> 00:02:18,490
.عن طريق إبقائي في قفص صنعه لي هاياتو كي لا أتأذّى

50
00:02:18,490 --> 00:02:19,750
!هذا صحيح

51
00:02:19,750 --> 00:02:22,630
!ستكون بخير ما دمت تصغي إليّ

52
00:02:22,630 --> 00:02:24,570
!قلت أنّني سأحميك

53
00:02:24,570 --> 00:02:26,480
—لمَ تأبى عن الإصغاء لي

54
00:02:26,480 --> 00:02:27,660
!هذا سيئ

55
00:02:29,570 --> 00:02:31,100
...لقد كنتُ ضعيفًا

56
00:02:31,100 --> 00:02:32,210
.ومثيرًا للشّفقة

57
00:02:33,100 --> 00:02:34,630
.كنتُ أعتمد عليك

58
00:02:35,510 --> 00:02:37,500
.ولطالما كنتَ تساعدني

59
00:02:38,250 --> 00:02:41,890
.أتيت إلى قرية ناناكي لأنّي أردتُ أنّ أغيّر من نفسي

60
00:02:41,890 --> 00:02:44,080
تغيّر نفسك؟

61
00:02:44,080 --> 00:02:46,140
تتغيّر حتّى تتحرّر مني؟

62
00:02:46,140 --> 00:02:47,050
!لا

63
00:02:47,050 --> 00:02:48,000
—أردتُ أن أتغير لكي

64
00:02:48,000 --> 00:02:48,810
!يكفي

65
00:02:49,200 --> 00:02:51,740
!إنّه لم يعد ميتسوموني الذي أعرفه

66
00:02:51,740 --> 00:02:53,330
!عليك به

67
00:02:54,050 --> 00:02:57,440
،أردتُ أن أتغير لأصبح شخصًا يستطيع مساعدتك

68
00:02:57,440 --> 00:02:59,860
!بدل أن تساعدني دومًا

69
00:03:01,480 --> 00:03:06,170
.عرفتُ نوعًا ما أنّك كنت قلقًا بسبب عائلتك

70
00:03:06,170 --> 00:03:06,830
.توقف

71
00:03:06,830 --> 00:03:10,460
لكن رؤيتك أنت بالذات تعاني بينما أنتَ قويّ دائمًا

72
00:03:10,460 --> 00:03:15,670
.جعلني أفكر أنّي لا أستطيع مساعدتك، لذا لم أستطع فعل أي شيء

73
00:03:15,970 --> 00:03:17,430
!إنّ ناناكي ينفعل

74
00:03:17,430 --> 00:03:18,510
!إنه يهتز

75
00:03:18,750 --> 00:03:21,840
!أريد أن أصبح متساويًا معك يا هاياتو

76
00:03:23,040 --> 00:03:27,180
—أريد أن أصبح صديقك الذي ينصت لك عندما تتألم

77
00:03:27,180 --> 00:03:28,690
!صديقٌ يستطيع مساعدتك

78
00:03:28,690 --> 00:03:31,320
!تلك هي الصداقة التي أريدها

79
00:03:31,320 --> 00:03:32,770
!الصديق الذي أريد أن أكون

80
00:03:37,170 --> 00:03:39,490
!هاياتو-كُن، لا تنصت إليه

81
00:03:39,900 --> 00:03:43,820
!إنه يقول مثل هذا الكلام فقط لأجل أن ينقذ ماساكي

82
00:03:44,150 --> 00:03:45,400
—كوهارون-سان، ما الذي

83
00:03:45,400 --> 00:03:46,350
تعلم ذلك، صحيح؟

84
00:03:46,350 --> 00:03:47,950
!إنه يخدعك

85
00:03:47,950 --> 00:03:50,870
!ميتسوموني-كُن لا يكترث لأجلك

86
00:03:51,210 --> 00:03:52,050
!لا

87
00:03:52,050 --> 00:03:53,450
!إنها مخطئة يا هاياتو

88
00:03:52,670 --> 00:03:53,960
!لا يمكنك أن تثق بأي أحد

89
00:03:53,960 --> 00:03:58,670
!إنّهم يتحدّثون بالجماليات بينما يتآمرون ليستغلّوك ويخونوك

90
00:04:07,330 --> 00:04:08,380
!هاياتو

91
00:04:13,520 --> 00:04:15,370
!هاياتو، أسرع

92
00:04:15,370 --> 00:04:16,790
...لكن ساقي

93
00:04:19,690 --> 00:04:21,010
...ميتسوموني، أنت

94
00:04:21,010 --> 00:04:21,980
!لا بأس

95
00:04:21,980 --> 00:04:23,310
!أسرع يا ميتسوموني-كُن

96
00:04:23,310 --> 00:04:23,900
!حسنًا

97
00:04:23,900 --> 00:04:26,070
!إنها قادمة من هذا الاتجاه

98
00:04:29,590 --> 00:04:31,380
لمَ أنا خائفة؟

99
00:04:31,380 --> 00:04:32,840
.هكذا يجب أن يكون الأمر

100
00:04:32,840 --> 00:04:35,350
.مستحيلٌ أن نتجنّب الخسائر

101
00:04:35,800 --> 00:04:36,580
...لا شكّ أن هذا سوف

102
00:04:39,420 --> 00:04:40,380
ماذا؟

103
00:04:40,380 --> 00:04:41,730
مرحبًا؟ مرحبًا؟

104
00:04:41,730 --> 00:04:43,590
أيمكنك سماعي يا ميتسوموني-كُن؟

105
00:04:44,190 --> 00:04:45,730
.مرحبًا

106
00:04:45,730 --> 00:04:47,550
.لستَ ميتسوموني-كُن

107
00:04:47,550 --> 00:04:50,610
هل أنت في قرية ناناكي؟

108
00:04:50,610 --> 00:04:52,550
.حسنًا، لقد دخلت، جيد

109
00:04:52,550 --> 00:04:54,180
.أظن أنّ الأمر كان يستحق المحاولة

110
00:04:54,180 --> 00:04:57,560
.لكن أتساءل لمَ توجد إشارة هنا

111
00:04:58,170 --> 00:04:59,230
لماذا؟

112
00:04:59,230 --> 00:05:00,570
...هذا الصوت

113
00:05:00,570 --> 00:05:01,800
أهذه أنت يا كوهارو؟

114
00:05:02,920 --> 00:05:05,450
.فهمت، أنت هنا

115
00:05:05,780 --> 00:05:07,300
.توقعت ذلك

116
00:05:07,300 --> 00:05:11,080
.أنت من جعلتني أنام تلك الليلة

117
00:05:11,320 --> 00:05:13,390
—كوهارو، لمَ أنت

118
00:05:13,390 --> 00:05:14,060
!هكذا وحسب

119
00:05:14,060 --> 00:05:16,760
...إن لم أفعل شيئًا فستواصل التقدم في السن يا أبي

120
00:05:16,760 --> 00:05:19,130
!ستموت

121
00:05:19,130 --> 00:05:20,200
...كوهارو

122
00:05:20,200 --> 00:05:22,900
لقد تركت صدمتك في القرية، صحيح؟

123
00:05:22,900 --> 00:05:25,460
لمَ لا تحاول البحث عنها معي؟

124
00:05:25,460 --> 00:05:27,130
...ذلك لأنّ

125
00:05:27,130 --> 00:05:28,340
،إن استعدت صدمتك

126
00:05:28,580 --> 00:05:31,000
!فسيمكنك أن تتوقف عن التقدم في السن

127
00:05:31,000 --> 00:05:34,560
!لكنك ترفض أن تعود وتواصل في بحثك

128
00:05:34,960 --> 00:05:38,980
.لهذا أتيت إلى هنا بدلًا عنك، لأجده

129
00:05:38,980 --> 00:05:40,150
...حسنٌ

130
00:05:40,370 --> 00:05:42,970
!لكني لم أستطع أن أجد ناناكي الخاص بك يا أبي

131
00:05:42,970 --> 00:05:46,050
!لربّما اختفى

132
00:05:46,750 --> 00:05:50,840
ألهذا أجريت تجربة باستعمال هاياتو-كُن؟

133
00:05:51,350 --> 00:05:52,690
!من أنت؟

134
00:05:53,290 --> 00:05:55,530
،فكّرتِ أنّه بإهاجة ناناكي

135
00:05:55,530 --> 00:05:58,930
...بإمكانك أن تجبري صدمة متلاشية لكي تتضخّم

136
00:05:59,370 --> 00:06:02,090
.ظننتِ أنّك تستطيعين أن تمنعي ناناكي من الاختفاء

137
00:06:02,090 --> 00:06:03,250
.انتظر

138
00:06:03,950 --> 00:06:06,120
.إنّ ناناكي ملازمٌ للذّات

139
00:06:06,120 --> 00:06:08,670
.لا يمكن أن تزيليه منك حتى لو حاولت

140
00:06:08,670 --> 00:06:10,530
...لهذا أنت

141
00:06:10,530 --> 00:06:13,260
أهذا ريجي-كُن؟

142
00:06:13,260 --> 00:06:13,970
.أجل

143
00:06:13,970 --> 00:06:14,880
!ريجي؟

144
00:06:14,880 --> 00:06:16,830
.مرحبًا، سعيد بمعرفتك

145
00:06:16,830 --> 00:06:18,900
.شكرًا لاعتنائك بكوهارو

146
00:06:18,900 --> 00:06:20,950
—سمعتُ عنك من ميتسوموني-كُن

147
00:06:20,950 --> 00:06:22,130
!كيف لك أن تكون غير مبالٍ هكذا؟

148
00:06:22,130 --> 00:06:24,320
!لمَ أنت هكذا دائمًا يا أبي؟

149
00:06:24,320 --> 00:06:25,230
دائمًا؟

150
00:06:25,230 --> 00:06:27,270
!قد تموت

151
00:06:27,270 --> 00:06:30,470
!لطالما احتذيتُ بكَ كباحث

152
00:06:30,470 --> 00:06:34,650
.يمكنك أن تستمر وتجري اختباراتٍ أعظم

153
00:06:34,650 --> 00:06:37,830
.لهذا أنّا راضٍ عن مكاني الآن

154
00:06:37,830 --> 00:06:42,080
،لأنّ صدمتي اكتسبت شكلًا مادّيًا وتركتني

155
00:06:42,080 --> 00:06:46,130
.يمكنني أن أفهم الكثير عن الندبات النفسية

156
00:06:46,130 --> 00:06:48,740
.كما أنّي أملك نظرةً شاملة على النفس البشرية

157
00:06:48,740 --> 00:06:53,290
.أظنّني أستطيع أن أرى حقيقة الأمور لأنّه يمكنني أن أكون موضوعيًّا الآن

158
00:06:53,290 --> 00:06:54,120
!ماذا؟

159
00:06:54,120 --> 00:06:57,720
أتقصد أنّك تحاول إجراء بحثٍ حول نفسك؟

160
00:06:57,720 --> 00:06:58,790
.صحيح

161
00:06:58,790 --> 00:07:01,810
.أنا موضوع تجربتي الخاصّة

162
00:07:01,810 --> 00:07:02,190
ماذا؟

163
00:07:02,410 --> 00:07:05,070
.أجد ذلك ممتعًا حقًّا

164
00:07:05,070 --> 00:07:10,930
يقال أنّه من الواجب أن تُحرّر نفسك من التوتّر
،لتحافظ على العقل السليم والجسم السليم

165
00:07:10,930 --> 00:07:13,050
.لكنّه العكس تمامًا

166
00:07:13,050 --> 00:07:15,510
.على سبيل المثال، ذلك يؤثّر بمعدّل النبض

167
00:07:15,510 --> 00:07:18,370
،مع أنّ تقدّمي في السن تسارع

168
00:07:18,370 --> 00:07:20,250
!إلّا أنّ نبضي عاديّ

169
00:07:20,250 --> 00:07:21,370
!سمعتُ ما يكفي

170
00:07:21,370 --> 00:07:23,290
!وهذا ليس ما أريد سماعه

171
00:07:23,290 --> 00:07:26,420
إذًا هل بإمكاني أن أقول ما أريد قوله في الحقيقة يا كوهارو؟

172
00:07:26,420 --> 00:07:27,230
ماذا؟

173
00:07:27,230 --> 00:07:29,180
.لقد رأيتِ ناناكي، لذا لا بدّ أنّك أدركتِ

174
00:07:29,180 --> 00:07:31,470
.الجميع يملكون مشاعر مختلفة

175
00:07:31,470 --> 00:07:33,890
...كلٌّ ونفسه، لذا

176
00:07:34,940 --> 00:07:37,220
.أريد منكِ أن تدعيني أتحرّر

177
00:07:38,710 --> 00:07:39,820
...أبي

178
00:07:39,820 --> 00:07:41,150
...أنت

179
00:07:43,270 --> 00:07:45,480
!أحمق

180
00:07:48,280 --> 00:07:49,740
ماذا ستفعلين الآن؟

181
00:07:50,940 --> 00:07:53,000
.سأجد الجميع

182
00:07:53,000 --> 00:07:54,840
من أنت؟

183
00:07:54,840 --> 00:07:56,100
.أتساءل حيال ذلك

184
00:07:56,590 --> 00:08:00,200
،لكن كما قال والدك، كُلٌّ ونفسه

185
00:08:01,130 --> 00:08:02,980
.لذا كلّ ناناكي مختلف عن الآخر

186
00:08:02,980 --> 00:08:03,580
ماذا؟

187
00:08:10,740 --> 00:08:12,640
.ميتسوموني، أنزلني واهرب

188
00:08:12,640 --> 00:08:13,530
!لا

189
00:08:13,530 --> 00:08:15,250
.لستَ بتلك القوّة

190
00:08:15,250 --> 00:08:16,850
،إن أنزلتك الآن

191
00:08:16,850 --> 00:08:19,020
!فسأكون نفس الشخص الذي كنتُ عليه من قبل

192
00:08:19,560 --> 00:08:20,770
!فقط القليل بعد

193
00:08:20,770 --> 00:08:22,740
،إن استطعنا أن نعبر النفق ونعود إلى قرية ناناكي

194
00:08:22,740 --> 00:08:24,460
!فلن تتبعنا

195
00:08:27,540 --> 00:08:28,610
!ميتسوموني-كُن

196
00:08:32,100 --> 00:08:32,860
!هاياتو؟

197
00:08:36,250 --> 00:08:37,740
.دع أحدًا يحميك بين الحين والآخر

198
00:08:37,740 --> 00:08:38,780
ماذا؟

199
00:08:38,780 --> 00:08:41,900
.لم أرد أحدًا يقوم بكلّ ما أريده وحسب

200
00:08:42,220 --> 00:08:46,610
لقد كسبتُ ثقةً في نفسي لأنّي ظننتُ أنّي أساعدك

201
00:08:46,610 --> 00:08:50,420
.أنت من كان يساعدني

202
00:08:51,090 --> 00:08:51,920
...هاياتو

203
00:08:54,290 --> 00:08:56,470
.شكرًا يا ميتسوموني

204
00:09:01,850 --> 00:09:02,760
!أكلته؟

205
00:09:02,760 --> 00:09:03,980
!لكن لمَ اختفيا؟

206
00:09:04,300 --> 00:09:05,410
.لا تقلقوا

207
00:09:05,410 --> 00:09:07,210
.لقد اتّحدا

208
00:09:10,450 --> 00:09:15,260
.لقد تقبّل هاياتو-كُن مشاعره وماضيه

209
00:09:16,520 --> 00:09:19,450
.سيكون على ما يرام
.لقد عاد إلى العالم الحقيقي

210
00:09:20,450 --> 00:09:23,270
.شكرًا لأجل عودتك إلى قرية ناناكي يا ميتسوموني-كُن

211
00:09:23,270 --> 00:09:24,160
!ريجي

212
00:09:24,160 --> 00:09:26,120
.ريجي، لقد أردتُ أن أراك

213
00:09:26,120 --> 00:09:28,330
.لقد كنتُ أبحث عنك منذ وقت طويل

214
00:09:31,220 --> 00:09:33,030
ريجي، ما الأمر؟

215
00:09:33,580 --> 00:09:35,250
،إن أردتِ إيجادي

216
00:09:35,250 --> 00:09:38,340
.فقد كان عليك فقط أن تنظري بنفسك يا ماساكي

217
00:09:38,340 --> 00:09:38,800
ماذا؟

218
00:09:39,500 --> 00:09:41,780
.أنا هو ناناكي الخاص بك

219
00:09:43,630 --> 00:09:45,980
عمّا تتحدّث؟

220
00:09:47,180 --> 00:09:49,730
.عندما كانت صغيرة، أرادت ماساكي أن تملك صديقًا بشدّة

221
00:09:50,680 --> 00:09:52,110
،صديقٌ يظلّ إلى جانبها

222
00:09:52,110 --> 00:09:53,690
،يشارك ضحكتها

223
00:09:53,900 --> 00:09:55,950
.ويحميها

224
00:09:55,950 --> 00:09:58,230
.شخصٌ يفعل كل ذلك

225
00:09:58,230 --> 00:09:59,780
.تفضل يا ريجي

226
00:10:02,360 --> 00:10:04,040
.كان ذلك أنا

227
00:10:06,230 --> 00:10:08,140
انتظر، ماذا تقصد؟

228
00:10:08,140 --> 00:10:11,510
أتقصد أن ماساكي اختلقتكَ بمخيّلتها؟

229
00:10:14,170 --> 00:10:16,640
مهلًا، كيف أمكن ذلك يا ريجي؟

230
00:10:16,640 --> 00:10:18,130
أنت هنا، صحيح؟

231
00:10:18,400 --> 00:10:20,110
والجميع يستطيعون رؤيتك، صحيح؟

232
00:10:20,110 --> 00:10:22,950
ريجي لا يتحدث بمنطقية، أليس كذلك؟

233
00:10:22,950 --> 00:10:23,840
...أجل

234
00:10:23,840 --> 00:10:25,650
.لا يمكنني تصديقه... بعد

235
00:10:26,320 --> 00:10:28,900
.لقد كبرت مع ماساكي

236
00:10:30,040 --> 00:10:33,190
،أصغيتُ لما يقلقها في أي وقت وأي مكان

237
00:10:33,530 --> 00:10:35,460
.ومنحتها عزاءً لوحدتها

238
00:10:35,900 --> 00:10:37,330
ولمَ لا؟

239
00:10:37,330 --> 00:10:42,120
.لطالما أخبرتها بما تريد أن تسمعه

240
00:10:42,120 --> 00:10:43,080
!توقف

241
00:10:43,080 --> 00:10:44,590
!توقف عن الكذب أرجوك

242
00:10:44,590 --> 00:10:46,760
!لطالما كنتَ إلى جانبي

243
00:10:46,760 --> 00:10:50,540
!أردتَ أن تبقى معي دومًا أيضًا

244
00:10:52,190 --> 00:10:54,040
.أترى؟ يمكنني أن ألمسك

245
00:10:54,040 --> 00:10:57,090
كيف لك أن تكون من نسج خيالي؟

246
00:10:57,860 --> 00:11:01,800
.تعرفين لماذا يا ماساكي

247
00:11:04,330 --> 00:11:06,140
.لا يا ريجي

248
00:11:09,170 --> 00:11:10,100
...لا

249
00:11:10,580 --> 00:11:12,400
!لا

250
00:11:11,030 --> 00:11:12,400
!ماساكي-سان

251
00:11:13,990 --> 00:11:16,650
.ميتسوموني-كُن، اذهب وراء ماساكي رجاءً

252
00:11:16,650 --> 00:11:17,280
ماذا؟

253
00:11:17,790 --> 00:11:22,280
،سأخبر البقية عن قرية ناناكي

254
00:11:22,920 --> 00:11:26,490
.لذا اذهب وراء ماساكي رجاءً

255
00:11:27,330 --> 00:11:29,500
.أعرف كيف تشعر ماساكي أكثر من الجميع

256
00:11:30,230 --> 00:11:32,960
.ففي النهاية، أنا ماساكي

257
00:11:32,960 --> 00:11:39,690
منذ أن كانت صغيرة، لطالما نادت
.باسمي عندما تشعر بالألم وتريد أن تبكي

258
00:11:40,180 --> 00:11:44,970
.لكنّها نادت باسمٍ آخر أخيرًا يا ميتسوموني-كُن

259
00:11:47,760 --> 00:11:48,950
.فهمت

260
00:11:48,950 --> 00:11:52,250
—أنت، لا يجب أن تقبل بسرعة

261
00:11:51,510 --> 00:11:53,900
!سأساعد ماساكي-سان

262
00:11:58,440 --> 00:12:00,530
!ماساكي-سان، انتظري

263
00:12:01,100 --> 00:12:06,490
.أشعر وكأنّي دائمًا ما كنتُ أبحث عنك، منذ أن وصت إلى هنا

264
00:12:14,290 --> 00:12:17,540
—إن كان ناناكي الخاص بي... البطريق الذي يمثّل ذكراي مع توكيموني

265
00:12:17,920 --> 00:12:20,340
،لو أني تقبّلته

266
00:12:20,340 --> 00:12:22,760
أين ناناكي الخاص بي الآن؟

267
00:12:28,480 --> 00:12:29,760
ماساكي-سان؟

268
00:12:29,760 --> 00:12:31,140
ما الأمر؟

269
00:12:31,140 --> 00:12:32,280
...انظر

270
00:12:33,550 --> 00:12:34,780
.فهمت

271
00:12:34,780 --> 00:12:37,480
.هذا على الأرجح ناناكي الجديد الخاص بي

272
00:12:37,830 --> 00:12:39,110
هذا؟

273
00:12:39,110 --> 00:12:43,720
.لقد عدت إلى هنا لأني عرفت من يكون ريجي-سان

274
00:12:43,720 --> 00:12:44,310
ماذا؟

275
00:12:44,720 --> 00:12:47,280
.لم أستطع أن أتركك

276
00:12:47,890 --> 00:12:49,990
.أردت أن أساعدك

277
00:12:51,200 --> 00:12:53,940
أنت وحش؟

278
00:12:54,390 --> 00:12:57,380
رجل هو صدمتها؟

279
00:12:57,380 --> 00:13:00,010
!ماساكي-تشان ليست بائسةً جدًّا

280
00:13:00,440 --> 00:13:03,470
من يكترث للرجال؟

281
00:13:03,470 --> 00:13:06,430
حسنٌ، من يكترث لأي شيء؟

282
00:13:06,430 --> 00:13:08,830
.جميعهم ساذجون

283
00:13:08,830 --> 00:13:11,020
ألا تُصدّقه؟

284
00:13:11,020 --> 00:13:14,330
،لا دليل يدعمه أو يخوّلني لأن أثق به

285
00:13:14,330 --> 00:13:16,300
!لذا لا خيار أمامي سوى أن أساير الأمر

286
00:13:16,300 --> 00:13:17,080
!يا جماعة

287
00:13:17,080 --> 00:13:17,820
!سحقًا

288
00:13:17,820 --> 00:13:18,790
!أفلتوني

289
00:13:18,790 --> 00:13:21,040
!قلت أفلتوني

290
00:13:21,040 --> 00:13:23,490
!فقط انتظروا وسترون ما سيحدث

291
00:13:23,490 --> 00:13:25,380
.أجل، حاول تهديدنا بسكّين

292
00:13:25,380 --> 00:13:29,560
!يمكنني ونانكو أن نتعامل معكما بسهولة أيها الضعيفان

293
00:13:29,560 --> 00:13:30,840
.لستُ ضعيفة

294
00:13:30,840 --> 00:13:31,910
!أجل، صحيح

295
00:13:32,260 --> 00:13:35,500
!جاك-سان لم يظهر لكم كلّ ما لديه بعد

296
00:13:35,500 --> 00:13:37,110
أليس كذلك يا جاك-سان؟

297
00:13:37,110 --> 00:13:39,990
—اقضي عليهم بضربة واحدة

298
00:13:39,000 --> 00:13:39,990
.لا أهتم

299
00:13:39,990 --> 00:13:40,750
!ماذا؟

300
00:13:40,750 --> 00:13:44,220
أجل، من يهتم، صحيح؟

301
00:13:44,220 --> 00:13:47,720
.لا أحد يمكنه أن يهرب من هنا لآن على أي حال

302
00:13:49,500 --> 00:13:51,530
.يمكنني أن أبقى هنا وحسب

303
00:13:52,150 --> 00:13:54,390
.لا أريد أن أعود إلى تلك الحياة البائسة

304
00:13:54,890 --> 00:13:57,290
،لا أهتم لقراركم الأخير

305
00:13:57,880 --> 00:14:00,020
.لكن لا تقرروا لوحدكم

306
00:14:00,530 --> 00:14:03,980
.تشاوروا مع ناناكي الخاص بكم رجاءً

307
00:14:04,680 --> 00:14:06,010
.مع جزءٍ منكم

308
00:14:06,010 --> 00:14:07,700
من هذا؟

309
00:14:07,700 --> 00:14:10,910
...إنه ريجي، وهو يقرب لماساكي كـ

310
00:14:17,080 --> 00:14:18,450
...ناناكي

311
00:14:18,450 --> 00:14:19,290
.لا بأس

312
00:14:19,610 --> 00:14:21,510
،أظنكم تعرفون هذا

313
00:14:21,510 --> 00:14:24,000
.لكنها لن تهجم عليكم إلا إن حاولتم المغادرة

314
00:14:25,060 --> 00:14:29,180
.إنها ناناكي الخاصة بكم، جزء منكم

315
00:14:29,830 --> 00:14:31,890
.إنها خائفة فقط من أن تُهجر

316
00:14:31,890 --> 00:14:34,300
خائفة من أن تُهجر؟

317
00:14:34,300 --> 00:14:36,160
لمَ أنتم هنا؟

318
00:14:36,160 --> 00:14:36,850
ماذا؟

319
00:14:37,350 --> 00:14:39,340
...تريدون بدء حياة جديدة

320
00:14:39,340 --> 00:14:42,100
هذا يعني أنكم ترفضون حياكم الماضية، صحيح؟

321
00:14:43,440 --> 00:14:48,490
.إنهم خائفون من أن يُرفضوا من قبلكم أكثر من أي أحد آخر

322
00:14:48,700 --> 00:14:52,200
ما هذا الهراء؟

323
00:14:52,450 --> 00:14:55,910
أهو معالِجٌ غامض؟

324
00:14:56,200 --> 00:14:59,410
،لكن إن فكّرتُ فيها كنفسي

325
00:14:59,410 --> 00:15:01,290
...أشعر أن صدمتي ظريفة نوعًا ما

326
00:15:01,290 --> 00:15:02,760
ظريفة؟

327
00:15:02,760 --> 00:15:03,790
...لكنها ناناكي

328
00:15:04,000 --> 00:15:06,250
...قد تكون ظريفة عن قرب

329
00:15:10,410 --> 00:15:11,560
هل تبكي؟

330
00:15:12,000 --> 00:15:14,680
هل تريد أن تعود لي؟

331
00:15:16,120 --> 00:15:18,840
،لأنه ناناكي الخاص بي

332
00:15:18,840 --> 00:15:19,850
.فهو خائف

333
00:15:20,310 --> 00:15:23,640
ميتسوموني-كُن، أكنت تعلم من يكون ريجي؟

334
00:15:23,640 --> 00:15:27,340
.أجل، سمعت عنه من شخصٍ يدرس قرية ناناكي

335
00:15:27,340 --> 00:15:31,520
.سمعتُ أنه قد يكون صدمتك

336
00:15:32,650 --> 00:15:35,110
.آسف، أعي لماذا لا تريدين تصديق ذلك

337
00:15:35,110 --> 00:15:36,130
...لكن يا ماساكي-سان

338
00:15:36,130 --> 00:15:37,490
.كنت أعلم

339
00:15:38,050 --> 00:15:40,460
.الجميع كاناو يقولون أنهم لا يرون ريجي

340
00:15:40,460 --> 00:15:42,570
.قالوا أني غريبة

341
00:15:43,060 --> 00:15:44,330
.كان ذلك صعبًا عليّ

342
00:15:45,020 --> 00:15:46,290
،لهذا في مرحلةٍ ما

343
00:15:46,510 --> 00:15:52,260
.بدأت أدّعي أنّي لا أستطيع رؤية ريجي أمام الآخرين

344
00:15:52,680 --> 00:15:54,970
...لكن ذلك أصبح أكثر صعوبة

345
00:15:55,740 --> 00:15:59,180
...كان ريجي يقول ما أريد سماعه، لكن

346
00:15:59,180 --> 00:16:01,430
ريجي، أنت موجود حقًّا، صحيح؟

347
00:16:01,890 --> 00:16:03,610
.بالطبع يا ماساكي

348
00:16:03,610 --> 00:16:05,600
كيف يمكنني أن ألقاك حقًّا إذًا؟

349
00:16:06,740 --> 00:16:08,930
.حسنٌ، لا أدري

350
00:16:08,930 --> 00:16:10,400
.لكني موجود

351
00:16:11,020 --> 00:16:11,940
...ريجي

352
00:16:14,210 --> 00:16:17,660
.ما كان يعطيني أبدًا الجواب الذي أردته حقًّا

353
00:16:18,330 --> 00:16:20,740
لذا أخذتُ أقوم بأبحاثي الخاصة

354
00:16:20,740 --> 00:16:24,310
...حينها صادفت شائعةً بشأن باحثٍ يدّعي وجود أشياء غريبة

355
00:16:24,940 --> 00:16:27,070
،وأن هناك مكانٌ يدعى بقرية ناناكي

356
00:16:27,070 --> 00:16:31,760
.حيث الصدمة التي نتحمّلها تتّخذ شكلًا وتظهر

357
00:16:32,070 --> 00:16:39,440
،خلتُ أنّني أستطيع أن أقابل ريجي أخيرًا إن ذهبت إلى قرية ناناكي

358
00:16:39,440 --> 00:16:41,270
.وأبقى معه إلى الأبد

359
00:16:42,290 --> 00:16:47,190
.حتى الآن، ظننتُ أني الوحيدة التي تواجه وقتًا عصيبًا

360
00:16:47,450 --> 00:16:52,130
.أجل، الجميع من حولي بدوا سعداء

361
00:16:52,130 --> 00:16:54,360
.ولأكون صادقة، فقد شعرتُ بالغيرة

362
00:16:54,360 --> 00:16:56,360
،لكن بما أني أتيتُ إلى هنا

363
00:16:56,360 --> 00:16:58,370
.أدركتُ أننا جميعًا متشابهون

364
00:16:58,370 --> 00:17:01,210
،أجل، الجميع واجهوا أوقاتًا عصيبة

365
00:17:01,210 --> 00:17:04,650
.شيء يمكنه أن يخلق ناناكي

366
00:17:04,650 --> 00:17:06,330
.ذلك بائس حقًّا

367
00:17:06,840 --> 00:17:15,050
من الأسهل أن نُفكّر أن الجميع يحظون
.بوقت رائع ويجعلوننا نتحمّل أشياء بائسة

368
00:17:15,290 --> 00:17:20,040
.لطالما كان ريجي-سان قلقًا عليك

369
00:17:20,610 --> 00:17:24,410
.أرادك أن تغادري هذا المكان

370
00:17:24,410 --> 00:17:28,090
إن كان ريجي-سان من ذلك النوع
،الذي يريد فقط أن يخبرك بما تريدين

371
00:17:28,090 --> 00:17:30,150
فهذا يعني أنّك تريدين أن تتغيّري، صحيح؟

372
00:17:32,230 --> 00:17:33,160
،إن كنت لا تمانعين

373
00:17:33,160 --> 00:17:34,880
.أريدك أن تتحدّثي إلي

374
00:17:35,360 --> 00:17:38,320
،عندما تريدين أن تسمعي شيئًا أو تحصلي على جواب

375
00:17:38,320 --> 00:17:39,380
!أريدك أن تتحدثي إلي

376
00:17:39,380 --> 00:17:42,470
.أنا مثير للشفقة ولستُ ذكي

377
00:17:42,470 --> 00:17:45,040
،قد لا أستطيع أن أخبرك بالكلام الذي تودّين سماعه

378
00:17:45,040 --> 00:17:47,850
...لكن سأحاول جاهدًا أن أُفكّر جيّدًا

379
00:17:47,850 --> 00:17:51,000
!سأحاول أن أفكّر بأشياء لا تتوقّعيها

380
00:17:55,120 --> 00:17:55,910
.تعال

381
00:17:55,910 --> 00:17:56,720
ماذا؟

382
00:18:00,160 --> 00:18:03,300
.هذا مكان رائع حقًّا

383
00:18:03,300 --> 00:18:03,940
ماذا؟

384
00:18:03,940 --> 00:18:06,520
،بما أنّ روحنا تتجسّد

385
00:18:06,520 --> 00:18:12,700
.فيمكننا أن نعرف ما يفكر به الغير وما إن كانوا يكذبون

386
00:18:16,680 --> 00:18:17,650
.هذا ظريف

387
00:18:19,770 --> 00:18:20,340
ريجي؟

388
00:18:20,340 --> 00:18:20,820
ماذا؟

389
00:18:23,310 --> 00:18:25,500
.لقد عاد ريجي

390
00:18:25,500 --> 00:18:26,160
ماذا؟

391
00:18:26,160 --> 00:18:26,770
ريجي-سان؟

392
00:18:26,770 --> 00:18:27,410
أين؟

393
00:18:27,410 --> 00:18:28,520
.هنا

394
00:18:28,520 --> 00:18:29,710
...هذا

395
00:18:30,800 --> 00:18:34,550
.ميتسوموني-كُن، سأمضي قدمًا

396
00:18:45,000 --> 00:18:51,210
.واثقٌ أنّي سأوافيكِ فورًا مع هذا

397
00:18:54,250 --> 00:18:56,970
لمَ اختفى ريجي؟

398
00:18:56,970 --> 00:18:58,990
.أشعر بالغيرة نوعًا ما

399
00:18:58,990 --> 00:18:59,280
ماذا؟

400
00:18:59,590 --> 00:19:01,870
.أظن أن ماساكي قد عادت

401
00:19:02,090 --> 00:19:03,560
ماذا يجب أن نفعل؟

402
00:19:03,560 --> 00:19:06,430
.بدأت أفكر أني أريد العودة أيضًا

403
00:19:06,430 --> 00:19:08,470
.أجل، نوعًا ما

404
00:19:08,470 --> 00:19:12,110
...بدأت أتعب من عيش حياة النجاة

405
00:19:12,110 --> 00:19:15,500
...هذا المكان يملك قضاياه الشخصية

406
00:19:15,500 --> 00:19:18,000
...أجل، إن كان سيكون مضطربًا على أي حال

407
00:19:18,000 --> 00:19:20,800
.فالواقع لديه وقعٌ أفضل وأكثر اهتمامًا

408
00:19:20,800 --> 00:19:22,780
.لا يمكنني مع ذلك

409
00:19:22,780 --> 00:19:26,520
.إن عدت، فسيحاول أشخاص مخيفون أن يقتلونني دون شك

410
00:19:26,520 --> 00:19:28,200
.سأبقى أيضًا

411
00:19:28,200 --> 00:19:30,590
...سيكون من المتعب جدًّا أن أعود

412
00:19:30,590 --> 00:19:31,670
!انتظروا

413
00:19:31,670 --> 00:19:34,200
!إن بقيتم فستختفون

414
00:19:34,200 --> 00:19:36,100
!أما زلتم تريدون البقاء هنا؟

415
00:19:36,100 --> 00:19:36,940
!أنت تهربين حقًّا إذًا

416
00:19:36,940 --> 00:19:38,650
وما الخطأ في ذلك؟

417
00:19:38,650 --> 00:19:39,220
ماذا؟

418
00:19:39,220 --> 00:19:41,010
ماذا؟ نتشبّث بمكاننا ونقاتل؟

419
00:19:41,010 --> 00:19:45,540
.كلٌّ ونفسه، لكن ليس الجميع يستطيعون فعل ذلك

420
00:19:45,540 --> 00:19:48,200
.لا أريد أن أعود

421
00:19:48,200 --> 00:19:50,210
.سأبقى. سأكون مع أشخاص آخرين على الأقل

422
00:19:50,550 --> 00:19:53,420
.قد أستطيع أن أساعد إذًا

423
00:19:53,420 --> 00:19:53,950
!الزعيمة

424
00:19:53,950 --> 00:19:54,380
!أيتها الزعيمة

425
00:19:54,380 --> 00:19:55,420
...كوهارون، أنت

426
00:19:55,420 --> 00:19:59,380
.سأبقى هنا وأواصل إجراء البحوث حول قرية ناناكي

427
00:20:00,190 --> 00:20:04,340
.سأجد طريقة ليعيش الناس هنا دون أن يفقدوا هويّتهم

428
00:20:04,990 --> 00:20:06,660
هل ستبقين أيتها الزعيمة؟

429
00:20:06,660 --> 00:20:07,810
!إذًا سأبقى أيضًا

430
00:20:07,810 --> 00:20:10,060
!يبدو ذلك جيّدًا أكثر من الواقع

431
00:20:10,060 --> 00:20:12,390
!أنت السبب في كل هذا أساسًا

432
00:20:12,390 --> 00:20:14,660
.كوهارون هي المجرمة

433
00:20:14,660 --> 00:20:17,130
...النساء الجميلات يمكنهن أن يكنّ مجرمات ماهرات

434
00:20:17,130 --> 00:20:19,770
.ها أنت تفسد المزاج مجدّدًا

435
00:20:19,770 --> 00:20:22,400
.أظنّك من هذا الصنف من الرجال

436
00:20:22,400 --> 00:20:25,560
.أظنّني سأفسخ الخطوبة فور أن أعود إلى الواقع

437
00:20:25,560 --> 00:20:27,030
ماذا؟ هل ستعودين؟

438
00:20:27,030 --> 00:20:28,420
أهذا ما يفاجئك؟

439
00:20:28,420 --> 00:20:32,210
.من الأفضل ألّا تخطّطي لشيء آخر مجدّدًا

440
00:20:32,210 --> 00:20:33,830
.لا أهتم لما تفكر

441
00:20:34,390 --> 00:20:36,490
.فأنا مثل أبي في النهاية

442
00:20:36,490 --> 00:20:39,760
.أريد أن أواصل إجراء البحوث حول قرية ناناكي

443
00:20:39,760 --> 00:20:44,970
.أيضًا، عليّ أن أكفّر عن أذيّتي للناس

444
00:20:46,880 --> 00:20:49,750
.إن كانت كوهارون ستبقى، فربما سأبقى أيضًا

445
00:20:49,750 --> 00:20:52,790
.لقد كنت تتحدّث عنها بالسّوء

446
00:20:52,790 --> 00:20:54,040
.صحيح

447
00:20:54,040 --> 00:20:55,200
.أظنني سأعود

448
00:20:55,200 --> 00:20:58,680
.عليّ أن أتحمل المسؤولية حتى النهاية كوني منظم الجولة

449
00:20:58,680 --> 00:21:00,600
داهارا-سان، أتملك حسّ المسؤولية؟

450
00:21:00,600 --> 00:21:02,030
.هذا جديدٌ بالنسبة لي

451
00:21:02,340 --> 00:21:04,000
.سأبقى أيضًا

452
00:21:04,000 --> 00:21:05,980
،لم أشعر بالخمول بعد

453
00:21:05,980 --> 00:21:08,480
.وأريد أن أساعد الذين لا يشعرون على ما يرام

454
00:21:08,480 --> 00:21:10,890
.إن كانت سوي لاتي-سان ستبقى فسأبقى أيضًا

455
00:21:10,890 --> 00:21:13,590
.لم أمانع ترتيب العيش الجماعي هذا

456
00:21:14,000 --> 00:21:15,970
.سأبقى أيضًا

457
00:21:16,760 --> 00:21:19,480
.لستُ ممّن يجيدون تقييم الناس

458
00:21:19,480 --> 00:21:22,710
.لا أدري إن كنتُ سأكون أفضل لو عدت

459
00:21:22,930 --> 00:21:30,360
سأتأكد بنفسي إن كان الشخص الذي أظنه
.جيّدًا هو كذلك في الواقع قبل أن أعود

460
00:21:32,020 --> 00:21:34,080
.حسنًا، فلنذهب

461
00:23:04,150 --> 00:23:05,570
.كنت في انتظارك

462
00:23:05,570 --> 00:23:06,830
!هاياتو

463
00:23:06,830 --> 00:23:07,820
.مرحبًا بعودتك

464
00:23:08,480 --> 00:23:09,780
!ماساكي-سان

465
00:23:11,170 --> 00:23:13,230
هل الجميع هنا؟

466
00:23:13,230 --> 00:23:14,870
!أجل

467
00:23:14,870 --> 00:23:16,950
.فلنغادر رجاءً

468
00:23:16,950 --> 00:23:18,060
.مفهوم

469
00:23:18,060 --> 00:23:20,890
.حسنًا، لا داعي للمقدّمات

470
00:23:20,890 --> 00:23:22,790
!الأمر كلّه بيدك يا سيّدي

471
00:23:23,130 --> 00:23:25,610
.لا أصدّق ما مررت به

472
00:23:25,610 --> 00:23:28,170
وعدتَ بأنْ تتحدّث مع ربّ عملي؟

473
00:23:28,170 --> 00:23:29,210
!بالطّبع

474
00:23:29,210 --> 00:23:31,400
!رئيس شركتك درس مع في نفس الصّف في الجامعة

475
00:23:31,400 --> 00:23:32,680
!ثق بي

476
00:23:32,680 --> 00:23:36,400
.بربّك، أنت آخر من نثق به في هذا الوقت

477
00:23:36,400 --> 00:23:37,270
.حقًّا

478
00:23:37,270 --> 00:23:39,950
!حسنًا يا جماعة، فلنغادر

479
00:24:04,670 --> 00:24:07,020
لمَ تغيّر الكلمات؟

480
00:24:07,020 --> 00:24:08,110
!تلك الجملة كان بها العديد من المقاطع

481
00:24:08,110 --> 00:24:09,020
!يجب أن يُعدم

482
00:24:09,020 --> 00:24:10,050
...بربّك