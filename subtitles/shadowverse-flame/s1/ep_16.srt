.كنت احاول إيجاد طريقة لفعل ذلك

206
00:13:56,100 --> 00:13:58,180
بلودكرافت؟

207
00:13:58,180 --> 00:14:02,510
.إنها فئة صعبة، لذا لا يوجد العديد من اللاعبين

208
00:14:02,510 --> 00:14:07,050
كان لدينا لاعب من فئة بلودكرافت
.لكنه توقف عن المجيء

209
00:14:07,050 --> 00:14:08,430
حقا؟

210
00:14:08,430 --> 00:14:10,740
!أجل، أصبح مشهورا الآن

211
00:14:11,310 --> 00:14:13,170
!صحيح! تذكرت

212
00:14:13,770 --> 00:14:20,270
هنالك إشاعة عن لاعب بلودكرافت قوي للغاية
.بالقرب من نهر نيكومي

213
00:14:20,270 --> 00:14:21,720
حقا؟

214
00:14:21,720 --> 00:14:23,010
!شكرا لك

215
00:14:23,010 --> 00:14:27,230
!لكنه قوي للغاية

216
00:14:27,230 --> 00:14:29,970
—وهو أيضا

217
00:14:31,950 --> 00:14:33,340
!لقد اختفى

218
00:14:34,150 --> 00:14:36,620
هل سيكون على ما يرام؟

219
00:14:49,320 --> 00:14:53,760
.ألعب مشعوذ الظلام وأنهي دوري

220
00:14:53,760 --> 00:14:54,710
.تفضلي

221
00:14:54,710 --> 00:14:57,260
!حسنا، دوري

222
00:14:58,950 --> 00:15:01,870
!بطاقة التعويذة: حلقة الجنية

223
00:15:04,330 --> 00:15:06,950
!تضيف جنيتين إلى يدي

224
00:15:08,000 --> 00:15:10,140
.ألعب الجنيات التي أضيفت ليدي

225
00:15:12,270 --> 00:15:14,500
.أنت أكثر عنفا مما توقعت

226
00:15:14,500 --> 00:15:17,600
.بطاقات فوريستكرافت ليست ظريفة فحسب

227
00:15:18,350 --> 00:15:20,100
.أجل هذا صحيح

228
00:15:20,100 --> 00:15:23,330
!أهاجم قائدك بجنية الماء وليزا

229
00:15:27,510 --> 00:15:28,950
!وأنهي دوري

230
00:15:31,280 --> 00:15:33,520
...هذه مشكلة

231
00:15:34,060 --> 00:15:35,900
.أنت على ما أعتقد

232
00:15:36,190 --> 00:15:37,560
.تريك دولاهان

233
00:15:47,560 --> 00:15:49,350
يملك عاصفة، صحيح؟

234
00:15:49,570 --> 00:15:51,260
.تعرفينها

235
00:15:51,260 --> 00:15:55,430
!أهاجم ليزا بمشعوذ الظلام والجنية بشبحي

236
00:16:04,570 --> 00:16:07,570
لم أقم سوى بالمماطلة، صحيح؟

237
00:16:07,570 --> 00:16:10,000
.سيكون من المخيف لو غمرتني كليا

238
00:16:10,000 --> 00:16:14,310
لكنّ شادوكرافت تصبح قوية جدا
.بعد أن تمتلئ مقبرتها

239
00:16:14,310 --> 00:16:16,680
.تعرفين الكثير يا آنسة

240
00:16:16,680 --> 00:16:18,090
كنت تلعبينها؟

241
00:16:18,090 --> 00:16:21,600
.كلا، ليس كذلك

242
00:16:21,600 --> 00:16:23,240
!حان دوري! سحب

243
00:16:24,670 --> 00:16:27,380
!أولا، أهاجم قائدك بجنيتي

244
00:16:30,260 --> 00:16:33,500
!جنية الماء تهاجم تريك دولاهان

245
00:16:46,570 --> 00:16:50,030
!ثمّ ألعب ساحر غوبلن وجنية

246
00:16:59,240 --> 00:17:01,270
.حسنا! تبدو الأمور جيدة

247
00:17:01,570 --> 00:17:03,100
.تبدو كذلك

248
00:17:03,100 --> 00:17:05,470
.لا تبدو قلقا يا سوبارو-كن

249
00:17:05,470 --> 00:17:07,700
.عدم القلق هو كل ما يمكنني فعله

250
00:17:09,000 --> 00:17:13,060
.يتني أستطيع القلق والهلع

251
00:17:13,060 --> 00:17:16,180
التأثير الذي كسبته من الكلمات الأخيرة
!لتريك دولاهان يتفعل

252
00:17:16,660 --> 00:17:21,270
من أجل بداية هذا الدور فقط، يمكنني خلق تريك دولاهان
!دون كلمات أخيرة

253
00:17:21,270 --> 00:17:24,450
،وبما انني لعبت تريك دولاهان سلفا
.فهذا يعني أنّ هنالك شبحا أيضا

254
00:17:25,020 --> 00:17:26,430
يملك تلك القوة؟

255
00:17:26,430 --> 00:17:29,760
!أهاجم جنيتك بشبحي والذي يملك عاصفة

256
00:17:32,790 --> 00:17:36,020
!ثمّ ألعب بطاقة التعويذة نيكروكارنيفال

257
00:17:38,520 --> 00:17:42,770
!تخلق زومبي، هيكلا عظميا وشبحين

258
00:17:43,020 --> 00:17:47,310
!أطوّر الزومبي وأهاجم ساحر الغوبلن

259
00:17:56,310 --> 00:17:58,680
!ثمّ أهاجم الجنية بالشبح

260
00:17:59,630 --> 00:18:02,860
!والشبح الآخر يهاجم قائدك

261
00:18:06,300 --> 00:18:07,680
أنهي دوري

262
00:18:08,400 --> 00:18:10,360
أنت قوي يا سوبارو

263
00:18:10,360 --> 00:18:12,420
.حسنا، هذا كل شيء

264
00:18:12,420 --> 00:18:15,720
ألا تستمتع بالمعارك با سوبارو-كن؟

265
00:18:15,720 --> 00:18:17,180
.لا أعلم

266
00:18:17,180 --> 00:18:22,670
.ليتني أشعر بالحماس أكثر لكني أمنع نفسي دائما

267
00:18:22,980 --> 00:18:24,820
.أعرف كيف هو ذلك الشعور

268
00:18:26,200 --> 00:18:28,400
،عندما يجدر بك فعل شيء ما

269
00:18:28,400 --> 00:18:30,650
.لكن جسدك يتراجع من تلقاء نفسه

270
00:18:30,650 --> 00:18:32,760
نحن جبناء، صحيح؟

271
00:18:33,360 --> 00:18:34,630
.أجل

272
00:18:35,000 --> 00:18:39,230
.لكنّ لعب شادوفيرس يمنحني الشجاعة

273
00:18:39,230 --> 00:18:43,370
.حتى شخص مثلي في إمكانه أن يصبح أقوى
!أن يصبح مميزا

274
00:18:43,370 --> 00:18:46,180
...ذلك الشعور يغمر جسدي بأكمله

275
00:18:46,640 --> 00:18:48,930
!لهذا السبب أحبّ شادوفيرس

276
00:18:51,110 --> 00:18:54,790
!ألعب ثعلب الزهرة وساحرة أميرة الإلف

277
00:18:54,790 --> 00:18:56,980
!أطوّر ساحرة أميرة الإلف

278
00:19:00,430 --> 00:19:05,720
يتفعل تأثير تطويرها ويضيف جنيتين
!بقيمة 0 إلى يدي

279
00:19:08,520 --> 00:19:10,590
.ليس سيئا

280
00:19:10,590 --> 00:19:11,850
!هذا ليس كل شيء

281
00:19:13,480 --> 00:19:15,990
!يتفعل تأثير ثعلب الزهرة أيضا

282
00:19:17,250 --> 00:19:21,940
!تضاعف عدد الجنيات اللواتي يضفن إلى يدي

283
00:19:22,790 --> 00:19:24,960
أربع جنيات في آن واحد؟

284
00:19:26,320 --> 00:19:29,920
!أهاجم الزومبي خاصتك بساحرة أميرة الإلف المطورة

285
00:19:36,910 --> 00:19:38,190
.أنهي دوري

286
00:19:38,440 --> 00:19:41,180
.يبدو أنك تستمتعين باللعب

287
00:19:41,480 --> 00:19:43,470
.أجل. لأنني أحبّ شادوفيرس

288
00:19:43,470 --> 00:19:45,980
.هذا ما جعلني قوية

289
00:19:45,980 --> 00:19:49,750
.وما قرّبني من الشخص الذي أهتمّ لأمره

290
00:19:50,100 --> 00:19:52,880
هل أنت واثقة أنه ليس حبيبا؟

291
00:19:54,910 --> 00:19:58,030
.لكن يعجبني ذلك

292
00:19:58,030 --> 00:20:00,280
.أشعر  بالغيرة في الحقيقة

293
00:20:00,810 --> 00:20:03,730
.ليتني أستطيع الاتصال بشادوفيرس مثلك

294
00:20:03,730 --> 00:20:07,240
.أشعر بالغيرة منك أنا أيضا

295
00:20:07,240 --> 00:20:11,590
لا أعرف إن كان في استطاعتي التحدث
.إلى شخص يواجه مشكلة

296
00:20:11,940 --> 00:20:14,440
.إنها بمثابة عادة بالنسبة لي

297
00:20:14,870 --> 00:20:18,310
.كنت أهتمّ بأخي الصغير طيلة الوقت

298
00:20:18,310 --> 00:20:20,230
.هذا أشبه بتصرف ناجم عن ذلك

299
00:20:20,470 --> 00:20:23,560
!أعتقد أنه أمر رائع

300
00:20:23,910 --> 00:20:26,880
.نحن جبناء إذا

301
00:20:26,880 --> 00:20:29,750
.تملك ما أريده

302
00:20:29,750 --> 00:20:32,820
.وأنت تملكين ما أريده

303
00:20:33,640 --> 00:20:35,330
أهذه هي؟

304
00:20:35,590 --> 00:20:38,320
إنها صدفة مذهلة، صحيح؟

305
00:20:39,620 --> 00:20:41,260
!ألعب المومياء الصغرى

306
00:20:41,570 --> 00:20:45,990
.يتفعل تأثيرها. استحضار الأرواح 4 يمنحها عاصفة

307
00:20:45,990 --> 00:20:48,530
!ثمّ أقوم بتطوير المومياء الصغرى

308
00:20:49,290 --> 00:20:52,190
!لم أنتهِ بعد. مشعوذ الظلام

309
00:20:52,190 --> 00:20:53,760
.إنها البطاقة السابقة

310
00:20:53,760 --> 00:20:56,370
.أجل. لعبتها في الدور الثاني

311
00:20:56,370 --> 00:20:58,660
.لكنها مختلفة قليلا الآن

312
00:20:58,660 --> 00:21:00,890
!يتفعل تأثير مشعوذ الظلام

313
00:21:01,270 --> 00:21:05,500
،إن كنت أملك تابعا متطورا في اللعب
.سيخلق ذلك شبحا

314
00:21:08,010 --> 00:21:10,520
،أهاجم ساحرة أميرة الإلف بالهيكل العظمي

315
00:21:10,520 --> 00:21:13,160
!وثعلب الزهرة بالشبح

316
00:21:18,560 --> 00:21:23,200
!ثمّ أهاجم قائدك بتريك دولاهان والمومياء الصغرى

317
00:21:30,370 --> 00:21:31,760
.أنهي دوري

318
00:21:32,380 --> 00:21:34,350
.أعتقد أنّ هذا يكفي

319
00:21:34,350 --> 00:21:35,680
ماذا ستفعلين يا آنسة؟

320
00:21:35,680 --> 00:21:38,280
!سأواصل اللعب طبعا

321
00:21:38,600 --> 00:21:42,220
!أريد أن أجعلك تتحمّس

322
00:21:43,160 --> 00:21:45,790
.لست ظريفة فحسب، بل رائعة أيضا

323
00:21:46,830 --> 00:21:48,370
.تجعلني أحمرّ خجلا

324
00:21:48,370 --> 00:21:50,030
.ها أنذا يا سوبارو

325
00:21:50,490 --> 00:21:53,320
!سأريك شادوفيرس الحقيقية

326
00:23:24,130 --> 00:23:25,880
!استعراض بطاقات شادوفيرس

327
00:23:26,120 --> 00:23:28,180
!بطاقة اليوم هي نيكروكارنيفال

328
00:23:28,180 --> 00:23:30,170
...تلعب زومبي وهيكلا عظميا

329
00:23:30,680 --> 00:23:32,030
ما الذي تفعله يا لايت؟

330
00:23:32,030 --> 00:23:34,990
!أدرس شادوكرافت حاليا! واصل

331
00:23:34,990 --> 00:23:37,300
!لن أفوت أيّ كلمة تقولها

332
00:23:37,300 --> 00:23:39,070
.هذا غريب

333
00:23:39,070 --> 00:23:42,070
.يبدو أنك مستمتعة بالقتال حقا يا آنسة

334
00:23:41,100 --> 00:23:42,060
عرضمســبق

335
00:23:42,070 --> 00:23:43,660
.حقا؟ شكرا لك

336
00:23:43,660 --> 00:23:46,350
.كنت هكذا أنا أيضا فيما مضى

337
00:23:46,350 --> 00:23:49,290
!فلنعثر على الإجابة إذا! خلال هذه المعركة

338
00:23:49,290 --> 00:23:51,800
:في الحلقة القادمة
"!أريد أن تحمّسني شادوفيرس"

339
00:23:51,800 --> 00:23:53,750
!معركة! شادوفيرس