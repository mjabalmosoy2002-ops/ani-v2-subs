1
00:00:04,350 --> 00:00:08,890
!إتسكي ميتسوتاغاوا من اللّهب السّابع يربح

2
00:00:12,620 --> 00:00:16,280
!المعركة مع حاصد الأرواح الأوّل هي التّالية

3
00:00:12,860 --> 00:00:16,280
حاصد الأرواح
الأوّل

4
00:00:16,610 --> 00:00:18,710
يبدو انّه دورك يا هاروما

5
00:00:18,710 --> 00:00:22,420
فاز اللّهب السّابع في خمس معارك
على التّوالي. قد تكون هذه مُشكلة

6
00:00:22,420 --> 00:00:23,600
مُشكلة؟

7
00:00:23,600 --> 00:00:25,910
مُشكلة لِمَن؟

8
00:00:27,720 --> 00:00:28,970
كم هذا مُملّ

9
00:00:28,970 --> 00:00:32,560
اللّهب السّابع في ورطة بالطبع

10
00:00:33,060 --> 00:00:36,140
سأعترف بأنّهم أقوى الآن

11
00:00:36,420 --> 00:00:37,500
...لكن

12
00:00:41,930 --> 00:00:44,560
إنّهم ليسوا سوى قمامة مقارنةً بي

13
00:00:45,890 --> 00:00:47,060
!إلى اللِّقاء

14
00:00:47,060 --> 00:00:48,430
بالتّوفيق

15
00:00:53,060 --> 00:00:54,500
مرحباً

16
00:00:54,960 --> 00:00:56,440
ماذا تريد؟

17
00:00:56,760 --> 00:01:01,190
لا شيء مُحدَّد. أردتُ فقط الاطمئنان على حالك

18
00:01:01,920 --> 00:01:04,260
لن تخسر، صحيح؟

19
00:01:04,260 --> 00:01:06,470
تكره الخسارة، أليس كذلك؟

20
00:01:06,470 --> 00:01:07,740
...كما في تلك المرّة

21
00:01:16,430 --> 00:01:18,930
!بدوت مستاء

22
00:01:19,460 --> 00:01:21,440
!اصمت! دعني وشأني

23
00:01:21,870 --> 00:01:23,570
أنت مُملّ للغاية

24
00:01:23,570 --> 00:01:25,160
حسناً، بالتّوفيق لك

25
00:01:25,890 --> 00:01:26,760
اللّعنة

26
00:01:27,840 --> 00:01:28,690
ما هذا الغباء؟

27
00:01:29,350 --> 00:01:32,160
مُحال أن أخسر

28
00:03:07,020 --> 00:03:09,960
"!سوف تُصاب باليأس أيضاً"

29
00:03:11,420 --> 00:03:14,460
لم أدرك بأنّ اللّهب السّابع كان بهذه القوّة

30
00:03:14,460 --> 00:03:16,730
!أظنُّني مُعجبة

31
00:03:16,730 --> 00:03:18,300
!أنا أيضاً

32
00:03:18,300 --> 00:03:21,550
هل يمكنهم هزيمة هاروما هازيورا؟

33
00:03:21,550 --> 00:03:23,250
حسناً، أشكُّ في ذلك

34
00:03:23,250 --> 00:03:25,130
!سيفوز اللّهب السّابع

35
00:03:25,490 --> 00:03:29,490
لايت تينريو، حافظ على الوعد الّذي
!قطعته لي في الحمّام

36
00:03:29,490 --> 00:03:31,730
!سيربح اللّهب السّابع بكلِّ تأكيد

37
00:03:31,730 --> 00:03:35,190
،حسناً، لقد خضنا خمس معارك
!وجميعها كانت مُبهِرة

38
00:03:35,190 --> 00:03:41,720
!لنُراجعها كلّها قبل أن نمضي في طريقنا

39
00:03:41,720 --> 00:03:45,320
الأولى، كانت مصنوعة الأحجار الرّونيّة ضدّ
مثيلتها مُتمثّلة بشينوبو ضدّ السيّد النّبيل

40
00:03:42,280 --> 00:03:45,200
السّحر السّادس
شينوبو ميكي

41
00:03:42,280 --> 00:03:45,200
مصنوعة الأحجار الرّونيّة

42
00:03:42,280 --> 00:03:45,200
اللّهب السّابع
السيّد النّبيل

43
00:03:47,670 --> 00:03:51,870
!أنهى السيّدُ النّبيل المعركة بموت الشّاه

44
00:03:54,490 --> 00:03:56,390
أتطلّع قُدماً للمرّة المقبلة

45
00:03:56,840 --> 00:03:58,660
...في المرّة المقبلة، أنا سوف

46
00:03:59,050 --> 00:04:02,930
!التّالية، كانت سيرا ضدّ تسوباسا

47
00:04:00,170 --> 00:04:02,930
الرّيشة الثّالثة
سيرا إيكومي

48
00:04:00,170 --> 00:04:02,930
مصنوعة الملاذ

49
00:04:00,170 --> 00:04:02,930
اللّهب السّابع
تسوباسا تاكاناشي

50
00:04:06,600 --> 00:04:10,470
!ازداد تسوباسا بريقاً

51
00:04:11,310 --> 00:04:14,020
!يمكنك فعلها يا تسوباسا

52
00:04:14,020 --> 00:04:15,470
!يمكنك فعلها

53
00:04:16,830 --> 00:04:17,860
شكراً

54
00:04:18,380 --> 00:04:21,700
!إذاً كانت تاتسومي ضدّ رين

55
00:04:19,400 --> 00:04:21,690
السّيف الخامس
تاتسومي رايدو

56
00:04:19,400 --> 00:04:21,690
مصنوعة السّيف

57
00:04:19,400 --> 00:04:21,690
اللّهب السّابع
رين كازانامي

58
00:04:25,270 --> 00:04:29,710
!رَبِحَتْ رين هذه المعركة المُحتدِمة بين الأتباع

59
00:04:30,240 --> 00:04:32,750
!خسرتُ، لكن لا يوجد ما أتحسّر عليه

60
00:04:32,750 --> 00:04:34,570
!إلى الأمام يا كازاماتسوري

61
00:04:35,000 --> 00:04:36,630
!حسناً يا تاتسومي

62
00:04:36,960 --> 00:04:40,500
!التّالية، كانت فواري ضدّ سوبارو

63
00:04:37,920 --> 00:04:40,750
الرّياح الرَّابعة
فواري هاهاجيما

64
00:04:37,920 --> 00:04:40,750
مصنوعة الغابة

65
00:04:37,920 --> 00:04:40,750
اللّهب السّابع
سوبارو ماكابي

66
00:04:37,920 --> 00:04:40,750
مصنوعة الظلّ

67
00:04:45,500 --> 00:04:49,420
كانت نقلات سوبارو المُعقّدة والخادعة
!مشهداً مُلفِتاً للأنظار

68
00:04:49,980 --> 00:04:51,940
!كانت معركة مُمتعة

69
00:04:52,280 --> 00:04:54,930
أجل، لم تكن سيّئة على ما أعتقد

70
00:04:54,930 --> 00:04:59,100
!وأخيراً، ريوغا قاتل إتسكي في نصف النّهائي

71
00:04:56,150 --> 00:04:59,110
الدّم الثّاني
ريوغا جاسي

72
00:04:56,150 --> 00:04:59,110
مصنوعة الدّم

73
00:04:56,150 --> 00:04:59,110
اللّهب السّابع
إتسكي ميتسوتاغاوا

74
00:04:56,150 --> 00:04:59,110
مصنوعة الغابة

75
00:05:03,910 --> 00:05:08,110
!كان هجوم إتسكي النّهائي وحشيّاً

76
00:05:16,620 --> 00:05:18,960
اللّهب
السّابع

77
00:05:16,620 --> 00:05:18,960
حاصد الأرواح
الأوّل

78
00:05:16,830 --> 00:05:18,540
...والآن، أخيراً

79
00:05:19,160 --> 00:05:22,460
!حان وقت الجولة الأخيرة

80
00:05:22,460 --> 00:05:27,850
يحقِّق اللّهب السّابع في المُحصِّلة
...خمس انتصارات، ويُدخِلون

81
00:05:28,150 --> 00:05:30,350
!لايت تينريو

82
00:05:30,350 --> 00:05:36,730
اللّهب السّابع
لايت تينريو

83
00:05:30,630 --> 00:05:34,630
التّلميذ المُنتقل الغامض المسؤول
!عن إحياء اللّهب السّابع

84
00:05:34,630 --> 00:05:36,730
!أنا متأكّد بأنّه يُخفي استعراضاً عظيماً لنا

85
00:05:36,980 --> 00:05:39,980
!وخصمه هو هاروما هازيورا

86
00:05:39,980 --> 00:05:46,490
حاصد الأرواح الأوّل
هاروما هازيورا

87
00:05:40,390 --> 00:05:45,920
يطلقون عليه اللّاعب الأقوى في كلّية
!شادوفارس لسبب وجيه

88
00:05:45,920 --> 00:05:49,250
ما الّذي يُخفيه لنا في جُعبته؟

89
00:05:52,400 --> 00:05:55,750
يسرّني أنّك وصلت إلى هنا

90
00:05:55,750 --> 00:05:59,200
شكراً. لم أصل إلى هنا إلّا بمساعدة أصدقائي

91
00:05:59,200 --> 00:06:03,340
!مـ-مهلاً! مهلاً! هاروما، اهدأ من فضلك

92
00:06:03,340 --> 00:06:08,200
أصدقاؤك ليسوا بذلك السّوء، أجل

93
00:06:08,200 --> 00:06:09,350
لكن ماذا عنك؟

94
00:06:09,940 --> 00:06:11,350
أصبحتُ أقوى أيضاً

95
00:06:11,350 --> 00:06:13,540
وتعتقد بأنّك تستطيع هزيمتي الآن؟

96
00:06:13,540 --> 00:06:17,740
سوف أفعل. وهذه المرّة يا هاروما، أريد أن أفهمك

97
00:06:18,730 --> 00:06:22,600
لستُ بحاجة فهم أيُّها الأحمق

98
00:06:22,600 --> 00:06:24,760
...سوف أريك

99
00:06:25,100 --> 00:06:27,140
...وأري الجميع هنا

100
00:06:27,460 --> 00:06:30,520
!كم أنّ الحقيقة قاسية

101
00:06:30,830 --> 00:06:31,960
ذاك الوغد

102
00:06:31,960 --> 00:06:33,160
...لايت

103
00:06:37,060 --> 00:06:40,670
إذا كان ما تسمّيه "حقيقة" هو
،ما يجعلك غير سعيد

104
00:06:40,670 --> 00:06:42,450
!فسوف أغيّر حقيقتك إذاً

105
00:06:47,250 --> 00:06:48,540
!جميل! جميل

106
00:06:48,930 --> 00:06:51,250
حسناً، ستكون بخير

107
00:06:51,250 --> 00:06:53,440
!لايت، يمكنك فعلها

108
00:06:53,440 --> 00:06:55,020
!إلى الأمام

109
00:06:55,020 --> 00:06:59,690
لا يوجد ما يُدعى بنصر أكيد، لكن سأقولها
على أيّ حال، يمكنك الفوز في هذه

110
00:07:02,260 --> 00:07:05,190
جـ-جميعهم متحمّسون قبل أن نبدأ حتّى

111
00:07:05,190 --> 00:07:07,860
!ستكون هذه المعركة الأخيرة مُذهلة

112
00:07:08,090 --> 00:07:12,230
تغيير الحقيقة؟ لا يمكنك فعل ذلك

113
00:07:12,820 --> 00:07:14,870
وأنصحك بألّا تحاول أصلاً

114
00:07:18,290 --> 00:07:21,930
.شادوفارس هي لعبة حيث الحكم للأقوى
هذا كلّ ما في الأمر

115
00:07:21,930 --> 00:07:24,630
وإذا نسيت ذلك، سأساعدك على التذكُّر

116
00:07:24,890 --> 00:07:27,730
...لم أنسَ، ولهذا سأقول

117
00:07:27,730 --> 00:07:29,720
هذا ليس كلّ شيء تتمحور حوله شادوفارس

118
00:07:30,030 --> 00:07:33,890
!حان الوقت أخيراً يا رِفاق

119
00:07:33,890 --> 00:07:38,150
!حان الوقت للجولة الأخيرة من بطولة نادي شادوفارس

120
00:07:38,300 --> 00:07:41,520
...انضمّوا جميعاً! ثلاثة

121
00:07:41,760 --> 00:07:43,020
...اثنان

122
00:07:43,020 --> 00:07:43,960
!واحد

123
00:07:44,280 --> 00:07:46,730
!قِتال! شادوفارس

124
00:08:08,820 --> 00:08:10,490
دوري

125
00:08:11,170 --> 00:08:12,330
!سحب

126
00:08:13,690 --> 00:08:15,930
اخرج يا وحش الجمجمة

127
00:08:15,930 --> 00:08:17,170
أنهي دوري

128
00:08:17,570 --> 00:08:19,600
!دوري. سحب

129
00:08:21,250 --> 00:08:22,510
أنهي دوري

130
00:08:22,790 --> 00:08:24,430
...إذاً، أنا سوف

131
00:08:25,030 --> 00:08:26,640
ما المُضحك في الأمر؟

132
00:08:26,910 --> 00:08:32,750
.لا، إنّه عكس المرّة الماضية، هذا كلُّ شيء
لعبتَ ببطاقة وأنهيتُ دوري فحسب

133
00:08:33,290 --> 00:08:34,150
—هذا طريف

134
00:08:34,150 --> 00:08:35,680
وماذا يعني؟

135
00:08:35,680 --> 00:08:38,220
تعتقد بأنّ هذا يعني بأنّك ستربح هذه المرّة؟

136
00:08:38,220 --> 00:08:41,580
اللّعنة، كم أنت أحمق

137
00:08:42,660 --> 00:08:44,690
ألعب بالمُفترس الجمجمة

138
00:08:47,170 --> 00:08:52,270
يتفعّل تأثيره، ليضيف هيكلاً عظميّاً إلى يدي

139
00:08:52,550 --> 00:08:55,270
ثمّ أهاجمك قائدك بوحش الجمجمة

140
00:09:00,530 --> 00:09:02,180
!دوري! سحب

141
00:09:04,020 --> 00:09:06,600
!ألعب بدراكونير، تنّين البُرجُمة

142
00:09:10,440 --> 00:09:15,360
يتفعّل تأثير دراكونير، إضافة سلاح
دراكونيّ إلى يدي

143
00:09:16,650 --> 00:09:19,330
تروقني النّظرة في وجهك يا لايت

144
00:09:19,610 --> 00:09:22,110
شكراً. دع الأمر لي

145
00:09:22,110 --> 00:09:23,370
!أنهي دوري

146
00:09:24,830 --> 00:09:27,670
!حان وقت الانخراط في العمل. سحب

147
00:09:29,670 --> 00:09:32,000
يتفعّل تأثير المُفترس الجمجمة

148
00:09:32,440 --> 00:09:39,130
في بداية دوري، إذا كانت هناك بطاقة هيكل
عظميّ في يدي، أطرحها وأسحب بطاقة

149
00:09:39,130 --> 00:09:43,220
زيادة عدّاد المقبرة الخاصّ بك أثناء سحب
البطاقات. هذا تابعٌ قويّ

150
00:09:44,390 --> 00:09:47,190
يبدو أنّك تعلّمت اللّعبة قليلاً

151
00:09:48,470 --> 00:09:52,160
لَعِبَ هاروما للتو بكيميرا العظميّ

152
00:09:52,160 --> 00:09:57,740
لديه هجوم ودفاع منخفضان، لكن كلمات أخيرة قويّة

153
00:09:58,110 --> 00:10:02,740
المُفترس الجمجمة يهاجم دراكونير، والوحش
الجمجمة يهاجم قائدك

154
00:10:08,170 --> 00:10:10,380
غالباً كدّستَ بطاقات في مجموعتك

155
00:10:10,380 --> 00:10:13,550
لهزيمة لاعب مصنوعة ظلّ بعد الخسارة أمامي، صحيح؟

156
00:10:13,550 --> 00:10:18,300
يحاول النّاس فعل ذلك أحياناً رغم أنّهم ضعفاء

157
00:10:18,300 --> 00:10:21,640
لن ينفع هذا. أنا أقوى بكثير

158
00:10:21,640 --> 00:10:28,070
بضعة معارك مع لاعبي مصنوعة ظلّ
ضعفاء لن تغيّر شيئاً

159
00:10:28,070 --> 00:10:28,990
!معركتان

160
00:10:29,620 --> 00:10:32,820
قاتلتُ مجموعة بطاقات مصنوعة الظلّ مرّتين

161
00:10:32,820 --> 00:10:35,110
—ماذا؟ وتعتقد بأنّ هذا يكفي لهزيمتي

162
00:10:35,110 --> 00:10:38,480
لم تكن إلّا معركتين، لكن تعلّمتُ الكثير

163
00:10:38,480 --> 00:10:40,360
!لقد نضجتُ يا هاروما

164
00:10:47,620 --> 00:10:48,510
!حسناً

165
00:10:48,720 --> 00:10:51,760
!بِطاقة التّميمة: السّلاح الدراكونيّ

166
00:10:58,510 --> 00:11:02,210
بطاقات أسلحة الآن؟ عظيم. أرِني ما لديك

167
00:11:02,470 --> 00:11:04,860
لا، سوف أنهي دوري

168
00:11:05,230 --> 00:11:10,990
ما هذا؟ أنهى لايت دوره بعد اللّعب
!بتميمة بكلفة 1 فقط

169
00:11:10,990 --> 00:11:13,110
هل يخطّط لشيء؟

170
00:11:14,220 --> 00:11:20,220
مُحال. إنّه مجرّد جديد يلعب بالبطاقات بشكل عشوائيّ

171
00:11:21,060 --> 00:11:24,080
!أمثالك يستفزّونني أكثر من أيّ شيء آخر

172
00:11:24,360 --> 00:11:29,520
استعدّ، لأنّني سوف أركل مؤخّرتك لدرجة
!أنّك لن تُريني وجهك ثانية

173
00:11:30,150 --> 00:11:34,380
!أُهاجم قائدك بوحش الجمجمة وكيميرا العظميّ

174
00:11:39,910 --> 00:11:44,870
هيّا. سأساعدك على استذكار ذكريات الهزيمة

175
00:11:44,870 --> 00:11:47,260
!ألعب بحاصدَي أرواح الظلّ

176
00:11:47,260 --> 00:11:50,840
!لعِبَ هاروما للتو بتابعَين قويّين

177
00:11:50,840 --> 00:11:54,940
حاصد أرواح الظلّ لديه كمين حتّى
...آخر الدّور المقبل للخصم! و

178
00:11:55,370 --> 00:12:00,350
في كلّ مرّة يُدمَّر فيها تابع آخر، يتعزّز
هجومه ودفاعه بمقدار 1

179
00:12:01,970 --> 00:12:05,080
تذكّرتَ؟ أمور مُخيفة، صحيح؟

180
00:12:05,080 --> 00:12:08,120
أجل. أكذب إذا قلتُ بأنّني لم أخف

181
00:12:08,120 --> 00:12:11,780
لكن لستُ لوحدي. لذا سأكون بخير

182
00:12:12,080 --> 00:12:13,830
!لا تكن أحمق

183
00:12:13,830 --> 00:12:17,660
.شادوفارس هي مباراة واحد ضدّ واحد
!هذه العبارات المُبتذلة لا تعني شيئاً

184
00:12:17,660 --> 00:12:19,050
!أنت مخطئ يا هاروما

185
00:12:19,050 --> 00:12:22,560
صحيح، شادوفارس تتمحور حول لاعب
يشتبك مع لاعب آخر

186
00:12:23,230 --> 00:12:28,530
لكنّك تلتقي بكثير من النّاس في طريقك
إلى تلك المعركة، وتشكّل روابطَ كثيرة

187
00:12:28,960 --> 00:12:31,560
!وكلّ ذلك موجود هنا، الآن

188
00:12:42,020 --> 00:12:45,900
!كلّ من قاتلني موجود هنا يدفعني للأمام

189
00:12:46,970 --> 00:12:48,660
!ألعب بالمُحارب التنّين

190
00:12:50,770 --> 00:12:52,860
يتفعّل تأثير السّلاح الدراكونيّ

191
00:12:53,110 --> 00:12:56,460
،يا له من تابع تنّين غير مُسلّح يدخل وضع اللّعب

192
00:12:56,460 --> 00:13:00,470
التّابع مُسلّح ويكتسب تأثيراً جديداً
!زائد دفاع بمقدار 1

193
00:13:01,360 --> 00:13:03,470
!يا مُحارب التنّين المُسلّح، تطوّر

194
00:13:12,730 --> 00:13:15,930
يتفعّل التأثير دائم التطوُّر الّذي اكتسبه
!المُحارب التنّين المُسلّح من التّسليح

195
00:13:15,930 --> 00:13:18,810
،أوّلاً، يلحق ضرراً بمقدار 3 بتابع عدوّ

196
00:13:18,810 --> 00:13:22,630
!ثمّ 1 ضرراً بكافّة أتباع العدوّ

197
00:13:25,020 --> 00:13:29,910
!تنشئ الكلمات الأخيرة للكيميرا العظميّ هيكلَين عظميّين

198
00:13:32,730 --> 00:13:34,040
!لم أنتهِ بعد

199
00:13:34,040 --> 00:13:37,260
المُحارب التنِّين المُسلَّح يهاجم
!الهيكل العظميّ الخاصّ بك

200
00:13:41,850 --> 00:13:47,960
فهمت. في دوره الثّالث، اختار اللّعب
ببطاقة التّميمة فقط

201
00:13:47,960 --> 00:13:50,870
لأنّه كان يحضّر نفسه لحاصدي أرواح الظلّ

202
00:13:50,870 --> 00:13:56,690
،إذا لم تتوخّ الحذر أثناء الّعب بأتباعك
فيمكن أن يُهاجَموا ويُقتَلوا

203
00:13:56,980 --> 00:14:00,480
وفي هذه الحالة، هذا سوف يقوّي
حاصدي أرواح الظلّ الخاصّين به

204
00:14:00,710 --> 00:14:05,150
بدلاً من ذلك، تجنّب هذا الأمر واستخدم المُحارب
التنّين المُسلّح لهزيمتهم جميعاً في آن واحد

205
00:14:05,150 --> 00:14:07,780
!أنقذَ ذلك الوضع بشكل بطوليّ

206
00:14:08,880 --> 00:14:10,660
هذا رائع للغاية

207
00:14:14,590 --> 00:14:15,820
فهمت

208
00:14:15,820 --> 00:14:17,860
فهمت. فهمت. فهمت

209
00:14:17,860 --> 00:14:19,460
لا بأس

210
00:14:19,460 --> 00:14:23,620
يبدو أنّني تلقّيتُ جزاء اعتقادي بأنّك مبتدئ

211
00:14:23,620 --> 00:14:24,920
مؤلم

212
00:14:24,920 --> 00:14:27,670
!هذا مؤلم كثيراً لدرجة أنّني غاضب حقّاً

213
00:14:28,140 --> 00:14:30,860
!الميّت الحيّ المُتجوِّل! هيكل المخلب العظميّ

214
00:14:32,000 --> 00:14:36,150
!ثمّ بطاقة التّعويذة: التّحويل الرّوحي

215
00:14:37,070 --> 00:14:42,290
!أدمّر تابعاً واحداً أتحكّم به وأسحب بطاقتين

216
00:14:50,380 --> 00:14:57,650
،ثمّ تتفعّل الكلمات الأخيرة للميّت الحيّ المُتجوّل
لتدمير تابع مختار للعدوّ بصورة عشوائيّة

217
00:14:59,890 --> 00:15:03,760
تأثير هيكل المخلب العظميّ يسحب بطاقة

218
00:15:04,630 --> 00:15:08,600
!ثمّ يهاجم الهيكلُ العظميّ قائدَك

219
00:15:12,920 --> 00:15:17,580
سيطر هاروما على الرّقعة ببطاقة التّعويذة
خاصّته ومزيج الكلمات الأخيرة

220
00:15:17,580 --> 00:15:21,660
!يقلّص دفاع لايت أيضاً

221
00:15:21,660 --> 00:15:25,450
،حتّى لو بذلَ لاعبٌ درجة ثالثة قصارى جهده
لا يمكنه أن يصبح إلّا درجة ثانية

222
00:15:25,450 --> 00:15:28,950
الحقيقة هي أنّك لا ينبغي أن تلعب
شادوفارس، ولن تتغيّر أبداً

223
00:15:29,410 --> 00:15:30,960
!وليس أنت فحسب

224
00:15:30,960 --> 00:15:32,200
!الأشخاص السيّئون

225
00:15:32,200 --> 00:15:33,280
!الضّعفاء

226
00:15:33,280 --> 00:15:35,190
!الأشخاص الّذين لا يستطيعون هزيمتي

227
00:15:35,190 --> 00:15:38,590
!لا جدوى من لعِب أيّ منكم لعبة شادوفارس

228
00:15:38,590 --> 00:15:41,940
إذاً بالنسبة لك، شادوفارس هي الفوز فقط

229
00:15:43,160 --> 00:15:46,220
بالطبع. هذا ينطبق على الجميع

230
00:15:46,220 --> 00:15:49,050
إذا ربحت، تكون سعيداً. وإذا خسرت، تغضب

231
00:15:49,050 --> 00:15:50,580
!هكذا هم البشر

232
00:15:50,880 --> 00:15:52,590
ربّما

233
00:15:52,590 --> 00:15:54,550
!لكن الهزيمة ليست بلا معنى

234
00:15:56,390 --> 00:16:00,360
!لدى الهزيمة معنى أيضاً... هذا ما أعتقده

235
00:16:00,670 --> 00:16:02,490
!دوري! سحب

236
00:16:04,160 --> 00:16:06,440
!ألعب بدراغونيت المِطرقة

237
00:16:07,530 --> 00:16:10,320
ثمّ بطاقة التّعويذة التّحطيم الدراكونيّ

238
00:16:12,450 --> 00:16:15,500
!يلحق 3 ضرراً بتابع عدوّ

239
00:16:19,720 --> 00:16:23,240
،التّالي، ألعب ببطاقة التّميمة السّلاح الدراكونيّ

240
00:16:25,560 --> 00:16:28,250
!مصحوباً ذلك بلوكسفانغ كيت

241
00:16:30,940 --> 00:16:33,200
!يتفعّل تأثير السّلاح الدراكونيّ

242
00:16:34,230 --> 00:16:37,530
،عندما يدخل تابع تنّين غير مُسلّح وضع اللّعب

243
00:16:37,980 --> 00:16:42,070
التّابع مُسلّح ويكتسب تأثيراً جديداً
!زائد دفاع بمقدار 1

244
00:16:44,160 --> 00:16:45,900
...أطوِّر لوكسفانغ كيت

245
00:16:47,320 --> 00:16:49,140
!وأُهاجم الهيكل العظميّ الخاص بك

246
00:16:54,730 --> 00:17:00,080
ثمّ يتفعّل التأثير الهجوميّ الّذي منحه إيّاه التّسليح
!ليجعلني أسحب بطاقتين

247
00:17:01,670 --> 00:17:06,330
هاروما، أعلم مدى أهمّية الخسارة

248
00:17:06,570 --> 00:17:09,790
تعلّمتُ شادوفارس بعد الخسارة أمام شينوبو

249
00:17:09,790 --> 00:17:13,300
تعلّمتُ مصنوعة الظلّ بعد الخسارة أمام آليس

250
00:17:13,640 --> 00:17:15,680
هكذا أصبحتُ أقوى

251
00:17:16,500 --> 00:17:18,620
!تجعلك الهزيمة أقوى

252
00:17:18,620 --> 00:17:23,100
عندما تنكر ذلك، ألا تنكر إمكانيّات البشر فحسب؟

253
00:17:26,730 --> 00:17:29,890
!اصمت، اصمت أيُّها الضّعيف

254
00:17:33,600 --> 00:17:35,750
الهزيمة تجعلك أقوى"؟"

255
00:17:35,750 --> 00:17:37,560
إمكانيّات البشر"؟"

256
00:17:37,560 --> 00:17:39,680
أنت ساذج جدّاً

257
00:17:39,680 --> 00:17:41,950
الهزيمة الحقيقيّة هي اليأس

258
00:17:41,950 --> 00:17:45,870
هذا النّوع من اليأس يبدّد كلّ تلك
!العبارات المُبتذلة السّخيفة

259
00:17:46,370 --> 00:17:49,470
!تعال أيّها المِنجل العظيم وقطِّع كلَّ شيء

260
00:17:49,890 --> 00:17:52,940
!تجلَّ يا ذئب صيد مِنجل الموت

261
00:18:01,810 --> 00:18:02,900
!ها هو

262
00:18:03,150 --> 00:18:05,310
!تطوّر يا ذئب صيد مِنجل الموت

263
00:18:18,600 --> 00:18:23,140
!هاجم! دمّرهم جميعاً يا ذئب صيد مِنجل الموت

264
00:18:25,570 --> 00:18:30,410
يتفعّل الزِّناد الهجوميّ لذئب صيد مِنجل
،الموت المُكتسَب بواسطة التطوّر

265
00:18:30,410 --> 00:18:34,620
!ليُلحِق 2 ضرراً بكافّة أتباع العدوّ وقائدهم

266
00:18:34,880 --> 00:18:39,140
!ومُستحضر الأرواح 10 يجعل الضّرر 10، لا 2

267
00:18:39,390 --> 00:18:42,510
!تذوّق اليأس

268
00:18:50,600 --> 00:18:56,140
الكلمات الأخيرة لدراغونيت المِطرقة تضيف
!التّحطيم الدراكونيّ إلى يدي

269
00:18:58,340 --> 00:19:00,870
!هاروما، الهزيمة ليس بالضّرورة أن تعني اليأس

270
00:19:01,330 --> 00:19:05,600
...أنت لا تعرف اليأس الحقيقيّ فحسب

271
00:19:05,600 --> 00:19:08,010
!ذلك الخوف من المعرفة بأنّك لن تربح أبداً

272
00:19:26,580 --> 00:19:29,270
!أنت مبتدئ فعلاً بالكاد قد لعِبَ اللّعبة

273
00:19:29,270 --> 00:19:31,310
!أنت لا تعرف شيئاً

274
00:19:31,310 --> 00:19:34,940
!سوف تشعر باليأس أيضاً! هنا والآن

275
00:19:34,940 --> 00:19:37,110
!لا، لن أفعل

276
00:19:39,360 --> 00:19:42,160
!لن أدع الأمر ينتهي هنا

277
00:19:45,200 --> 00:19:48,060
لأجل أصدقائك في اللّهب السّابع؟

278
00:19:48,060 --> 00:19:49,190
!ليس هم فقط

279
00:19:53,990 --> 00:19:56,210
!أنت يا هاروما

280
00:19:56,210 --> 00:19:58,220
!أريد أن أعرفك

281
00:20:01,140 --> 00:20:04,480
لماذا تؤذي الجميع في كلّية شادوفارس؟

282
00:20:04,480 --> 00:20:07,200
لماذا تقول بأنّك "سوف تعلّمهم الحقيقة"؟

283
00:20:07,200 --> 00:20:10,040
لماذا تسمّي الهزيمة يأساً؟

284
00:20:10,040 --> 00:20:11,670
!أريد أن أعرف

285
00:20:11,670 --> 00:20:14,690
بماذا سينفعك ذلك؟

286
00:20:16,020 --> 00:20:16,900
!لا أعلم

287
00:20:17,350 --> 00:20:19,180
!سأفكّر في ذلك بعد أن اكتشفتُ

288
00:20:19,850 --> 00:20:22,420
قائدنا رهيب

289
00:20:22,420 --> 00:20:23,550
أجل

290
00:20:23,550 --> 00:20:25,090
إنّه غبيّ

291
00:20:25,090 --> 00:20:28,110
ليس مجرّد غبيّ. غبيّ جدّاً

292
00:20:28,110 --> 00:20:30,340
!لكن هذا لايت الّذي أعرفه

293
00:20:31,760 --> 00:20:34,830
!لست سوى مجرّد نكتة متنقّلة

294
00:20:35,290 --> 00:20:39,760
!أنا لا أمزح! أنا جادٌّ دوماً

295
00:20:42,460 --> 00:20:46,520
!هذا ما قصدتُه عندما قلتُ بأنّك نكتة

296
00:21:12,670 --> 00:21:16,120
سحليّة رمح مُتطوِّرة لديها 5 دفاع

297
00:21:16,120 --> 00:21:20,430
كان ينبغي أن يموت مع كلب صيد مِنجل الموت

298
00:21:21,300 --> 00:21:22,170
...هكذا الأمر إذاً

299
00:21:22,480 --> 00:21:23,410
!هذا صحيح

300
00:21:23,410 --> 00:21:25,270
،عندما يشنُّ سحليّة الرّمح هجوماً

301
00:21:25,270 --> 00:21:29,110
،إذا كان سلاح دراكونيّ في وضع اللّعب
!فإنّه يكسب 2 دفاع

302
00:21:29,110 --> 00:21:31,560
لهذا السّبب كان قادراً على النّجاة

303
00:21:31,740 --> 00:21:35,430
!ولم يتحفّز تأثيره الهجوميّ بعد

304
00:21:35,820 --> 00:21:38,250
!يلحق ضرراً بحجم 2 بقائد العدوّ

305
00:21:41,580 --> 00:21:46,240
أصبحتُ أقوى. لهزيمتك. لمعرفتك

306
00:21:47,090 --> 00:21:49,700
...لذا أخبرني يا هاروما

307
00:21:49,700 --> 00:21:53,430
،ما نوع شادوفارس الّتي لعبتَها حتّى الآن
وكيف سوف تلعب في المستقبل؟

308
00:23:24,100 --> 00:23:25,740
!استعراض بطاقة شادوفارس

309
00:23:25,740 --> 00:23:26,670
...بطاقة اليوم هي

310
00:23:26,670 --> 00:23:28,150
المُفترس الجمجمة. وانتهينا

311
00:23:28,150 --> 00:23:29,920
...يـ-ينبغي أن نشرح أكثر قليلاً

312
00:23:29,920 --> 00:23:33,680
الأفضل أن تلعب مهام الأحجيّات أكثر
من شرح بطاقات ذلك الرّجل

313
00:23:33,680 --> 00:23:35,210
هيّا، لنتطرّق للأمر

314
00:23:35,210 --> 00:23:36,060
!حـ-حسناً

315
00:23:36,060 --> 00:23:39,010
...أعتقد حتّى لايت يصغي إليها

316
00:23:39,220 --> 00:23:41,440
!وصلنا إلى هذه النّقطة! علينا أن نفوز

317
00:23:41,060 --> 00:23:42,020
الحلقة القادمة

318
00:23:41,440 --> 00:23:42,850
!اقتربنا يا لايت

319
00:23:42,850 --> 00:23:45,810
!لا تكن غبيّاً. لن يكون الأمر بتلك السّهولة

320
00:23:45,810 --> 00:23:46,890
!سوف أربح

321
00:23:46,890 --> 00:23:48,470
!لا، أنا من سيربح

322
00:23:48,760 --> 00:23:51,580
"!الحلقة القادمة: "الآن أنا قويّ بما يكفي للوصول إليك

323
00:23:51,580 --> 00:23:53,610
!قِتال! شادوفارس