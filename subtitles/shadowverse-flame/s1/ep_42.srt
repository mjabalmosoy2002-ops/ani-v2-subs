1
00:00:04,410 --> 00:00:06,740
وبهذا يكون اليوم الأوّل قد انتهى

2
00:00:06,740 --> 00:00:08,720
!أحسنتم صنعاً جميعاً

3
00:00:09,480 --> 00:00:11,320
ماذا؟ أين شيون؟

4
00:00:11,320 --> 00:00:12,360
أنا هنا

5
00:00:15,070 --> 00:00:18,240
جيّد. كنتُ قلقة من حدوث شيء

6
00:00:18,240 --> 00:00:20,870
!لـ-لم يحدث شيء بالطبع

7
00:00:21,110 --> 00:00:23,120
كيف سارت الأمور بالنسبة لكم جميعاً؟

8
00:00:23,120 --> 00:00:24,250
لا بأس على ما أعتقد

9
00:00:24,250 --> 00:00:26,540
ربحتُ بعضاً وخسرتُ بعضاً

10
00:00:26,540 --> 00:00:30,590
كذلك هنا. في فترة ما انخفضت نقاطي
!إلى 500 وخفتُ كثيراً

11
00:00:30,590 --> 00:00:32,340
ربحتُ ثلاث مرّات على التَّوالي

12
00:00:32,340 --> 00:00:33,170
!مُذهل

13
00:00:33,170 --> 00:00:33,970
لا بأس

14
00:00:34,310 --> 00:00:37,170
بالنسبة لي، كانت النّتيجة المُتوقَّعة

15
00:00:37,170 --> 00:00:38,050
وأنت يا لايت؟

16
00:00:38,620 --> 00:00:40,810
أنا أبلي حسناً

17
00:00:42,070 --> 00:00:44,230
لكن ما زالت البداية فقط

18
00:00:44,230 --> 00:00:45,870
علينا أن نبقى مُركِّزين

19
00:00:45,870 --> 00:00:49,680
أجل، علينا أن نبذل قصارى جهدنا
...في اليوم الثّاني

20
00:00:49,680 --> 00:00:50,700
!من التّصنيف العالميّ

21
00:00:50,700 --> 00:00:52,180
!أجل

22
00:00:52,180 --> 00:00:55,110
ولماذا عدت كأرنب؟

23
00:00:55,110 --> 00:00:56,580
!هذا عملي

24
00:00:56,580 --> 00:00:58,030
!هذا ظريف

25
00:01:00,370 --> 00:01:03,040
"!سوف أتّخذ هذه الخطوة الواحدة بكامل قوّتي"

26
00:01:03,040 --> 00:01:05,580
!واحد-اثنان! واحد-اثنان

27
00:01:05,960 --> 00:01:07,370
!وواحد-اثنان، درا

28
00:01:12,000 --> 00:01:13,220
ما الأمر يا سوبارو؟

29
00:01:13,220 --> 00:01:18,640
أنا قلق عليك. لم تكن على طبيعتك هناك

30
00:01:19,300 --> 00:01:21,350
حدث شيء ما اليوم، أليس كذلك؟

31
00:01:23,270 --> 00:01:24,850
!واحد-اثنان! واحد-اثنان

32
00:01:23,520 --> 00:01:25,180
أنت فطِن يا سوبارو

33
00:01:25,600 --> 00:01:29,650
ماذا حدث إذاً؟ أخبرني

34
00:01:29,650 --> 00:01:31,360
قاتلتُ ميكادو

35
00:01:32,230 --> 00:01:33,530
ميكادو؟

36
00:01:33,530 --> 00:01:34,320
أجل

37
00:01:34,570 --> 00:01:37,360
لماذا قاتلته؟

38
00:01:37,360 --> 00:01:40,740
كنتُ محظوظاً بما يكفي للحصول
على فُرصة لتحدّيه، لذا فعلت

39
00:01:40,740 --> 00:01:42,370
تحدّيته؟

40
00:01:42,690 --> 00:01:46,750
بعدما حدث؟ هل أنت عاجز عن الشّعور
بالخوف أو ما شابه؟

41
00:01:46,750 --> 00:01:49,380
كنتُ خائفاً قليلاً قبل المعركة

42
00:01:49,790 --> 00:01:52,960
لكن كنتُ خائفاً أكثر بكثير من فكرة
عدم القيام بشيء

43
00:01:54,210 --> 00:01:56,170
هل أنت مختلف يا سوبارو؟

44
00:01:56,170 --> 00:01:57,970
لستُ متأكِّداً

45
00:01:58,720 --> 00:02:02,680
بدأتُ بالشُّعور أخيراً أنّني بحاجة تحدِّي شخص

46
00:02:03,180 --> 00:02:07,020
لكن لا أظنّني أستطيع أن أكون مثلك

47
00:02:07,310 --> 00:02:09,350
ليس عليك أن تكون مثلي

48
00:02:09,350 --> 00:02:12,560
أنت ما أنت عليه. كُن نفسك فحسب

49
00:02:12,560 --> 00:02:17,030
لا أعلم ما الّذي يزعجك، لكن
أعلم بأنّك ستكون بخير

50
00:02:17,030 --> 00:02:18,110
حقّاً؟

51
00:02:18,110 --> 00:02:19,910
بصفتي صديقك، أضمن لك ذلك

52
00:02:19,910 --> 00:02:21,370
شكراً

53
00:02:21,370 --> 00:02:25,490
آسف على مناداتك فجأة. لنبذل قصارى جهدنا

54
00:02:25,490 --> 00:02:27,040
أجل. لنفعل

55
00:02:31,000 --> 00:02:32,790
هذا الرّجل مذهل

56
00:02:37,160 --> 00:02:40,180
آسف، آسف. أنت مُرهَق، صحيح؟

57
00:02:44,010 --> 00:02:48,430
أنباء عاجلة! كاغويا ماكابي من الظِّلال
السّبعة سوف يظهر

58
00:02:48,430 --> 00:02:51,740
!في ملعب القِتال نيكومي-تشو غداً

59
00:02:58,190 --> 00:03:00,820
لا يمكنك هزيمتي بعد الآن يا أخي

60
00:03:01,410 --> 00:03:03,200
أنت ضعيفٌ جدّاً

61
00:03:04,530 --> 00:03:07,950
هذا هو الفرق بينك وبيني

62
00:03:08,890 --> 00:03:13,630
أيّ شخص يهزمه سوف يحصل
على كمّ كبير من نقاط التّصنيف

63
00:03:13,630 --> 00:03:15,910
!من أجل بطولة التّصنيف العالميّ

64
00:03:15,910 --> 00:03:18,460
!هذه هي فُرصتكم

65
00:03:19,970 --> 00:03:22,800
أن أكون نفسي فحسب؟

66
00:03:24,140 --> 00:03:27,100
الفوضى عارمة في اليوم الثّاني
!من بطولة التّصنيف العالميّ

67
00:03:27,100 --> 00:03:31,020
!كاغويا ماكابي من الظِّلال السّبعة هنا

68
00:03:31,390 --> 00:03:37,360
تُعامَل هذه كمعركة إضافيّة، والفوز
!سوف يُكسبكم نقاطاً كثيرة

69
00:03:37,360 --> 00:03:40,970
ما رأيكم بمعركة جميعاً؟

70
00:03:40,970 --> 00:03:43,240
كما سمعت. ما رأيك بالتّجربة؟

71
00:03:43,240 --> 00:03:46,830
لا، مُحال. لا أستطيع هزيمة أحد الظِّلال السَّبعة

72
00:03:52,000 --> 00:03:54,880
حسناً، أريد تجربة هذا لنفسي

73
00:03:55,830 --> 00:03:58,090
تحدِّيي" الخاصّ"

74
00:04:02,220 --> 00:04:04,590
ماذا تفعل هنا؟

75
00:04:04,590 --> 00:04:09,220
حسناً، بما أنّني أجلس هنا، فهذا
لا يعني إلّا شيء واحد، صحيح؟

76
00:04:09,680 --> 00:04:14,220
هلّا صنعت لي معروفاً بمُقاتلتي
يا كاغويا من الظِّلال السّبعة؟

77
00:04:15,520 --> 00:04:18,650
ستكون معركة معك مضيعة للوقت

78
00:04:18,650 --> 00:04:21,990
حقّاً؟ إذاً لماذا تحضِّر نفسك لمعركة؟

79
00:04:21,990 --> 00:04:24,000
أنا أحد الظِّلال السّبعة

80
00:04:24,000 --> 00:04:26,100
أقبل كلّ القادمين

81
00:04:26,100 --> 00:04:28,740
ولا يستطيع أحدٌ هزيمتي

82
00:04:35,040 --> 00:04:39,250
أنا بخير يا باكّيروس. لكنّي خائف قليلاً فحسب

83
00:04:39,590 --> 00:04:44,930
فكما تعلم، يُفترَض أن يكون الأشباح
ومصنوعة الظلّ الجيّدين في إخافة النّاس

84
00:04:44,930 --> 00:04:47,300
!مُتحدِّينا مُتّقد بالحماس

85
00:04:47,300 --> 00:04:50,810
هل يخفي لنا مفاجأة؟

86
00:04:50,810 --> 00:04:53,050
!انضمّوا لنا جميعاً

87
00:04:53,430 --> 00:04:55,930
!قِتال! شادوفارس

88
00:05:23,210 --> 00:05:28,260
إنّهم مليئون بالمفاجآت حقّاً، أليس كذلك؟

89
00:05:30,300 --> 00:05:32,430
ألعب بمُستحضر الأرواح يقطين

90
00:05:33,680 --> 00:05:37,230
يضيف تأثيرها شبحاً إلى يدي

91
00:05:39,730 --> 00:05:41,100
أنهي دوري

92
00:05:41,100 --> 00:05:41,930
سحب

93
00:05:43,730 --> 00:05:45,600
ألعب بإشادة مورياي

94
00:05:50,410 --> 00:05:54,500
يجعلني تأثيره أسحب بطاقة وأنهي دوري

95
00:05:54,500 --> 00:05:59,040
!لعِبَ كاغويا بتميمة عدّ تنازليّ

96
00:05:59,040 --> 00:06:03,130
—في بداية كلّ دور، العدُّ التّنازليّ عليه ينقص بمقدار واحد

97
00:06:03,130 --> 00:06:06,920
وعندما يبلغ الصّفر، يُدمَّر، ليفعّل
!تأثير كلمات أخيرة قويّ

98
00:06:06,920 --> 00:06:09,550
!هذه عبارتي أنا

99
00:06:09,550 --> 00:06:13,720
مُذيعتكم المُفضَّلة، ماي، سوف تساهم
!في التّعليق اليوم

100
00:06:14,180 --> 00:06:15,470
!تطلّعوا قُدماً لذلك

101
00:06:15,720 --> 00:06:17,270
حسناً، أسحب

102
00:06:18,730 --> 00:06:20,480
ألعب بخدعة دولّاهان

103
00:06:22,060 --> 00:06:26,530
عندما تدخل وضع اللّعب، تستدعي شبحاً مع عاصفة

104
00:06:28,430 --> 00:06:32,120
!مُستحضر الأرواح يقطين وشبح يهاجمان قائدك

105
00:06:35,740 --> 00:06:37,040
أُنهي دوري

106
00:06:43,340 --> 00:06:44,790
المزار المُطلَق

107
00:06:52,050 --> 00:06:53,260
ما هذا؟

108
00:06:53,680 --> 00:06:59,060
!يا إلهي! بطاقة تميمة تغيِّر شكل ساحة المعركة

109
00:06:59,060 --> 00:07:02,560
!لا أطيق انتظار رؤية ما ستفعله

110
00:07:02,560 --> 00:07:04,360
ألعب بالنصّ المُقدَّس المُشوّه

111
00:07:06,690 --> 00:07:09,700
ينفي تابعاً بدفاع 3 أو أقلّ

112
00:07:13,280 --> 00:07:14,550
أنهي دوري

113
00:07:14,550 --> 00:07:21,420
النّفي مؤلم. الدّمار يُحفِّز الكلمات
الأخيرة، لكن النّفي لا يفعل ذلك

114
00:07:21,880 --> 00:07:22,880
!سحب

115
00:07:23,540 --> 00:07:25,210
أوّلاً، ألعب بشبح

116
00:07:26,250 --> 00:07:29,880
!مُستحضر أرواح يقطين والشّبح يهاجمان قائدك

117
00:07:34,390 --> 00:07:36,140
!والتّالي هو هذا

118
00:07:36,140 --> 00:07:37,680
!حاصد أرواح التّرفيه

119
00:07:39,640 --> 00:07:42,440
،يتفعّل تأثير حاصد أرواح التّرفيه

120
00:07:42,440 --> 00:07:45,440
ليحوِّل التّابع ذي الهجوم الأدنى إلى شبح

121
00:07:46,190 --> 00:07:51,280
وإذا تمَّ استهداف شبح، يتحوّل
!إلى شبح هائل بدلاً من ذلك

122
00:07:52,240 --> 00:07:53,990
أنهي دوري

123
00:07:53,990 --> 00:07:58,290
!مُذهل! لَعِبَ سوبارو للتو بمزيج رائع

124
00:07:58,290 --> 00:08:02,690
!تابع بـ 4 هجوم و 4 دفاع قويّ

125
00:08:03,040 --> 00:08:04,080
سحب

126
00:08:04,080 --> 00:08:06,840
يبلغ العدُّ التّنازليُّ لإشادة مورياي صفراً

127
00:08:06,840 --> 00:08:11,760
تُدمَّر وتتحفّز كلماتها الأخيرة، لتُدمِّر
تابع عدوّ عشوائيّ

128
00:08:16,550 --> 00:08:20,770
يسبّب تأثير الشّبح الهائل نفيها بدلاً من تدميرها

129
00:08:22,690 --> 00:08:24,980
توقّعتُ حدوث هذا

130
00:08:24,980 --> 00:08:26,060
لا أبالي

131
00:08:26,400 --> 00:08:29,480
ألعب بالقس السفّاح والتّلميذ الهائم

132
00:08:30,320 --> 00:08:35,070
يتفعّل تأثير المزار المُطلق الخاص بي

133
00:08:35,070 --> 00:08:38,200
،عندما يدخل تابعٌ بتطوُّر خاصّ وضع اللّعب

134
00:08:38,200 --> 00:08:42,830
يتعزّز هجومه ودفاعه بمقدار 1 ويكسب فورة

135
00:08:43,290 --> 00:08:44,920
تطوُّر خاص؟

136
00:08:45,190 --> 00:08:49,500
تابعون بتطوُّر خاص لا يستطيع التطوّر
باستخدام نقطة تطوُّر

137
00:08:49,500 --> 00:08:52,170
لكن هذا سيّئ بالنسبة لك، صحيح؟

138
00:08:52,460 --> 00:08:55,830
تأثيراته القويّة تعوّض عن ذلك

139
00:08:56,300 --> 00:08:58,850
يتفعّل تأثير التّلميذ الهائم

140
00:08:58,850 --> 00:09:01,320
،إذا كان لديّ 2 أو أكثر من نقاط التطوُّر

141
00:09:01,850 --> 00:09:06,020
فإنّه يُلحق 3 ضرراً بعدوّ مختار بشكل
عشوائيّ وقائده

142
00:09:16,360 --> 00:09:21,120
أنهي دوري ويتفعّل تأثير القسّ السفَّاح

143
00:09:21,120 --> 00:09:23,420
،إذا كان لديّ 2 أو أكثر من نقاط التطوُّر

144
00:09:23,700 --> 00:09:29,440
فإنّ تأثيراً مختاراً بشكل عشوائي تحفّز
عندما دخلت بطاقةٌ وضع اللّعب في هذا الدّور

145
00:09:29,440 --> 00:09:32,670
يتحفّز لمرّة ثانية

146
00:09:32,670 --> 00:09:37,380
بالتّالي، يُلحِق ضرراً بمقدار 3 بتابع مختار
بصورة عشوائيّة وقائد العدوّ

147
00:09:40,220 --> 00:09:44,060
!مـ-مـ-مبهر

148
00:09:44,060 --> 00:09:48,100
!سيطر على اللّعبة دون حتّى استخدام أيّ نقطة تطوُّر

149
00:09:48,100 --> 00:09:49,810
...هل هذه... هل هذه

150
00:09:49,810 --> 00:09:53,760
هل هذه هي القوّة الحقيقيّة للظِّلال السّبعة؟

151
00:09:53,760 --> 00:09:56,610
القوّة الحقيقيّة؟ لا

152
00:09:56,610 --> 00:09:58,200
لن أتّخذ هذا الأمر بجدِّية

153
00:09:58,990 --> 00:10:02,530
هذا مُرعب حقّاً

154
00:10:05,620 --> 00:10:07,660
أنا مُثير للشّفقة

155
00:10:07,660 --> 00:10:09,940
انتهى دوري

156
00:10:09,940 --> 00:10:11,340
بسرعة

157
00:10:11,340 --> 00:10:13,550
أم أنّك ستنسحب؟

158
00:10:13,880 --> 00:10:16,380
هل ستستسلم كما تفعل دوماً؟

159
00:10:16,380 --> 00:10:18,630
هذا هو أنت

160
00:10:19,430 --> 00:10:22,680
بصراحة؟ كنتُ لأتمنّى ذلك

161
00:10:23,280 --> 00:10:25,770
...لكن الآن وبينما أنا واقف هنا

162
00:10:26,350 --> 00:10:30,850
،لا أملك خياراً سوى اللّعب حتّى النِّهاية
مهما اشتدّت صعوبة الأمر

163
00:10:42,300 --> 00:10:43,070
!سحب

164
00:10:45,540 --> 00:10:50,330
على الأقلّ يمكننا جعل الحياة الآخرة مُمتعة

165
00:10:50,330 --> 00:10:52,080
!شبح الحفلة التنكُّريّة

166
00:10:58,220 --> 00:11:02,260
يتفعّل تأثيره ليستدعي شبحاً
عندما يدخل وضعَ اللّعب

167
00:11:02,680 --> 00:11:06,930
،وفي كلّ مرّة يدخل فيها شبحٌ وضعَ اللّعب
فإنّ هجومه يتعزَّز بمقدار 1

168
00:11:07,270 --> 00:11:09,270
!شبح الحفلة التنكُّريّة، تطوّر

169
00:11:21,030 --> 00:11:23,950
!يُهاجم مع الشّبح

170
00:11:29,500 --> 00:11:33,540
يُنفَى الشَّبح، لكن يتفعّل تأثير
شبح الحفلة التنكُّريّة

171
00:11:33,960 --> 00:11:37,380
في كلِّ مرّة يُنفَى فيها شبح، يستدعي شبحاً هائلاً

172
00:11:37,960 --> 00:11:43,680
عمل مُتقَن! استخدمَ سوبارو نقطةَ
!تطوُّر لاتِّخاذ زمام المُبادرة

173
00:11:43,680 --> 00:11:47,640
حسناً، استخدمتُ أفضل بطاقاتي، لذا
أفترض أنَّ هذا طبيعيّ فحسب

174
00:11:47,640 --> 00:11:48,670
أنهي دوري

175
00:11:49,350 --> 00:11:50,970
هذه أفضل بطاقة لك؟

176
00:11:53,270 --> 00:11:55,190
تذكّرني بك، بالتّأكيد

177
00:11:55,190 --> 00:11:57,820
ترتدي قِناعاً وتتوارى عن الأنظار

178
00:11:57,820 --> 00:11:59,360
!كم هذا مُحرِج

179
00:12:00,840 --> 00:12:03,230
يتفعّل تأثير المزار المُطلَق

180
00:12:07,790 --> 00:12:10,660
تعزِّز هجومَ ودفاعَ تابع

181
00:12:10,660 --> 00:12:13,530
مع تطوُّر خاص بمقدار 1 وتمنحه فورة

182
00:12:13,530 --> 00:12:19,760
يتفعّل تأثير بيغاسوس العقوبة ليُلحِق ضرراً
،بمقدار 2 بقائد العدوّ

183
00:12:22,340 --> 00:12:24,680
ويسترجع 2 دفاع لصالح قائدي

184
00:12:24,680 --> 00:12:29,810
التّالي، بيغاسوس العقوبة يهاجم
الشّبح الهائل مع فورة

185
00:12:36,060 --> 00:12:37,610
ثمّ أنهي دوري

186
00:12:37,610 --> 00:12:42,350
وفي نهاية دوري، يتفعّل تأثير بيغاسوس العقوبة

187
00:12:42,350 --> 00:12:45,070
،إذا كان لديّ 2 أو أكثر من نقاط التطوُّر

188
00:12:45,070 --> 00:12:48,660
فإنّه يُنفي تابع العدوّ بالهجمة الأقوى

189
00:12:50,240 --> 00:12:53,870
!يا إلهي! تمَّ نفي شبح الحفلة التنكُّريّة

190
00:12:53,870 --> 00:12:56,380
!لم تتفعّل كلماته الأخيرة

191
00:12:57,080 --> 00:12:59,630
...وبهذه البساطة، يزول

192
00:13:00,130 --> 00:13:02,970
أتتذكّر الفرقَ بيننا الآن؟

193
00:13:03,380 --> 00:13:06,390
لا يمكنك هزيمتي

194
00:13:06,720 --> 00:13:08,600
الأمر كما سبقَ فحسب

195
00:13:08,600 --> 00:13:11,180
لا، بل أسوأ الآن حتّى

196
00:13:12,140 --> 00:13:14,640
أنت قاسٍ جدّاً، أليس كذلك؟

197
00:13:16,900 --> 00:13:18,110
!كيربيروس

198
00:13:19,610 --> 00:13:22,780
يضيف تأثيره ميمي وكوكو إلى يدي

199
00:13:25,040 --> 00:13:27,320
!التّالي، الضّغينة الضّخمة

200
00:13:27,320 --> 00:13:31,580
!تُلحِق 4 ضرراً بتابع عدوّ و 2 بقائد العدوّ

201
00:13:31,580 --> 00:13:35,940
عندما يُنفَى شبح ضخم، فإنَّ تكلفته
تُضبَط عند 1

202
00:13:36,290 --> 00:13:38,040
!لذا سوف أستفيد منه

203
00:13:40,380 --> 00:13:42,710
!يا له من لعِب صادم

204
00:13:42,710 --> 00:13:46,630
!استخدمَ نفي تابعه لصالحه

205
00:13:46,970 --> 00:13:51,810
!جمعَ سوبارو مجموعةَ بطاقات قويّة جدّاً

206
00:13:51,810 --> 00:13:55,190
!قد نشهد... قد نشهد هزيمة غير مُتوقَّعة هنا

207
00:13:55,190 --> 00:13:57,310
ولا في الأحلام

208
00:13:57,310 --> 00:13:58,810
لن أخسر أبداً

209
00:13:58,810 --> 00:14:00,440
لا سيّما أمامك

210
00:14:01,900 --> 00:14:04,490
ألعب بإيثير الجناح الأبيض

211
00:14:07,910 --> 00:14:10,320
،يتفعّل تأثير الإيثير

212
00:14:10,780 --> 00:14:16,620
ليضع تابعَ مصنوعة الملاذ الأعلى كلفة
بكلفة أدنى من نقاط لعِبي القصوى

213
00:14:16,620 --> 00:14:18,200
من مجموعة بطاقاتي في وضع اللّعب

214
00:14:19,170 --> 00:14:23,670
تعزِّزُ أيضاً دفاعَ كافّة أتباعي بمقدار 1

215
00:14:23,670 --> 00:14:25,620
ثمّ يتفعّل المزار المُطلَق

216
00:14:30,180 --> 00:14:32,180
لستُ بحاجة لمُهاجمتك حتّى

217
00:14:32,180 --> 00:14:36,140
في نهاية دوري، سيتفعّل تأثير بيغاسوس العقوبة

218
00:14:36,140 --> 00:14:38,230
...إذا كان لديّ 2 أو أكثر من نقاط التطوُّر

219
00:14:40,190 --> 00:14:43,860
فإنّه ينفي تابعَ العدوّ ذا الكلفة العُليا

220
00:14:47,530 --> 00:14:52,700
لا يمكن أن تكون مجموعة بطاقاتك بتلك
الجودة. أنا واثق أنّك لم تقضِ أيّ وقت عليها

221
00:14:53,530 --> 00:14:56,950
اسحب بِطاقتك. كُفَّ عن إضاعة وقتي

222
00:14:57,200 --> 00:14:59,790
لا تكُن هكذا

223
00:14:59,790 --> 00:15:02,670
!أبذل قصارى جهدي هنا

224
00:15:05,130 --> 00:15:07,670
ألعب بآركوس، المُدير الشّبحيّ

225
00:15:10,300 --> 00:15:16,020
!يتفعّل تأثيره ليمنح قائدي قدرةً جديدة

226
00:15:17,440 --> 00:15:18,890
!أُطوِّر آركوس

227
00:15:24,900 --> 00:15:27,530
!وأُهاجم بيغاسوس العقوبة

228
00:15:31,320 --> 00:15:32,660
هذا أفضل ما لديك؟

229
00:15:32,950 --> 00:15:37,040
أجل. أحاول بذل قصارى جهدي لأشتعل حماساً

230
00:15:37,620 --> 00:15:40,000
ساعدَني كثيرٌ من النّاس

231
00:15:40,000 --> 00:15:43,380
والآن، أحاول أخيراً مواجهتك

232
00:15:44,210 --> 00:15:45,500
كلام فارغ

233
00:15:46,090 --> 00:15:49,050
كثير من النّاس؟ ساعدوك؟

234
00:15:49,420 --> 00:15:52,220
لا يمكنك هزيمتي هكذا

235
00:15:52,220 --> 00:15:55,260
وصلتُ إلى هنا من تلقاء نفسي

236
00:15:55,260 --> 00:15:58,530
!أنت فاشل! كيف يمكنك الفوز؟

237
00:16:00,810 --> 00:16:03,020
!أنت المبعوث السّابع

238
00:16:03,020 --> 00:16:07,230
اهدِنا إلى القسَم المُقدَّس الّذي
!صنعته مع العظيم

239
00:16:07,900 --> 00:16:09,860
!المُتعاقِد الإلهيّ

240
00:16:25,960 --> 00:16:27,710
...هذه لك

241
00:16:28,130 --> 00:16:31,590
لدى المُتعاقد الإلهي تطوُّر خاصّ

242
00:16:31,590 --> 00:16:33,550
المزار المُطلَق يُعزِّزه

243
00:16:35,720 --> 00:16:40,350
وينفي أيضاً كافّة أتباع العدوّ ذوي الدّفاع 3 أو أقلّ

244
00:16:40,640 --> 00:16:42,970
،وإذا كان لديّ 2 أو أكثر من نقاط التطوُّر

245
00:16:42,970 --> 00:16:47,100
فإنّه يُنفي كافّة أتباع العدوّ، ليس
فقط ذوي الدّفاع 3 أو أقلّ

246
00:16:54,070 --> 00:16:56,370
!الإيثير تهاجم قائدك

247
00:17:03,040 --> 00:17:07,170
في نهاية دوري، يتفعّل التّأثير الثّاني للمُتعاقِد الإلهيّ

248
00:17:07,170 --> 00:17:09,170
،إذا كان لديّ 2 أو أكثر من نقاط التطوُّر

249
00:17:09,170 --> 00:17:14,840
حتّى نهاية الدّور المُقبِل من خصمي، كافّة
أتباعي لا يتلقّون ضرراً

250
00:17:16,390 --> 00:17:20,140
!يـ-يا له من تابع قويّ

251
00:17:20,140 --> 00:17:24,680
!يُبيد رقعةَ العدوّ ويحمي رقعتك

252
00:17:24,680 --> 00:17:27,780
!هذه هي قوّة الظِّلال السَّبعة

253
00:17:28,190 --> 00:17:32,110
بينما لا تزال تبرح مكانك، استمررتُ
في المضيّ قُدماً

254
00:17:32,400 --> 00:17:37,770
،بينما كنتَ تهدر وقتك مع الآخرين
ظللتُ أقاتل لوحدي

255
00:17:38,160 --> 00:17:40,780
!فات الأوان على كلِّ شيء

256
00:17:41,240 --> 00:17:44,580
ربّما. لا، هذا ما أعتقده أيضاً

257
00:17:44,580 --> 00:17:47,830
لا أعتقد بأنّي أملك الحقَّ في التّواجُد هنا

258
00:17:48,290 --> 00:17:50,420
...لكن حتّى لو كان كذلك

259
00:17:50,790 --> 00:17:54,340
!الآن، سوف أتّخذ هذه الخطوة الواحدة بكامل قوّتي

260
00:17:55,920 --> 00:17:58,010
!ألعب بباكّيروس، بيبّي غوستي

261
00:18:05,180 --> 00:18:09,150
!يتفعّل تأثير باكّيروس، ليستدعي شبحاً

262
00:18:09,660 --> 00:18:13,190
!ثمّ يتفعّل تأثير قائد أركوس

263
00:18:13,190 --> 00:18:15,990
عندما ألعب بتابعٍ ذي كلفة 3 أو أقلّ

264
00:18:15,990 --> 00:18:19,570
!فإنّه يُدمَّر ويُستدعى أشباح بعدد مُكافئ لكلفته

265
00:18:21,700 --> 00:18:27,540
تضيف الكلمات الأخيرة لباكّيروس باكّيروس
!بكلفة 1 دون كلمات أخيرة إلى يدي

266
00:18:28,080 --> 00:18:30,830
!شبح واحد يهاجم قائدَك

267
00:18:33,880 --> 00:18:35,130
!فيما يلي، ألعب بهذه

268
00:18:35,590 --> 00:18:39,930
!مُذهل! لَعِبَ سوبارو للتو بالتّحويل الرُّوحيّ

269
00:18:39,930 --> 00:18:43,640
دمّرَ الشّبحَ الّذي كان قد هاجمَ للتو
!لسحب بطاقتين

270
00:18:43,640 --> 00:18:45,810
هذا ما احتجتُه فحسب

271
00:18:45,810 --> 00:18:47,480
!النَّفي الشّبحيّ

272
00:18:49,650 --> 00:18:54,440
يمنح تأثيراً هجوميّاً لشبحَين ويضيف
!نفياً شبحيّاً إلى يدي

273
00:18:55,150 --> 00:18:59,320
!يمنحهما التّأثيرُ هجوماً بمقدار 2

274
00:19:00,240 --> 00:19:03,330
!كلاهما يهاجمان قائدك

275
00:19:07,120 --> 00:19:08,540
!ثمّ ألعب بباكّيروس

276
00:19:11,880 --> 00:19:17,260
!يستدعي تأثيرُه شبحاً، ثمّ يدمِّره تأثير أركوس

277
00:19:18,010 --> 00:19:20,470
!ما يستدعي أشباحاً مُكافئة لكلفته

278
00:19:22,090 --> 00:19:23,180
مضيَعة للوقت

279
00:19:23,180 --> 00:19:24,850
!والآن ألعب بكوكو وميمي

280
00:19:27,770 --> 00:19:29,940
!أُعزِّز قوّة شبح بكوكو وأهاجم

281
00:19:30,560 --> 00:19:32,770
!ويلحق ميمي 2 ضرراً بقائدك

282
00:19:41,820 --> 00:19:43,310
أنت تهدر وقتي

283
00:19:44,530 --> 00:19:47,660
!مزيج هجمات! مزيج هجمات! فيض من الهجمات

284
00:19:47,660 --> 00:19:52,620
اخترقَ سوبارو مُعظم تحصينات كاغويا

285
00:19:53,920 --> 00:19:56,590
إذاً، بقي 3 دفاع؟

286
00:19:57,000 --> 00:19:59,420
أتعتقد بأنّك اقتربت؟

287
00:20:01,340 --> 00:20:04,090
لا. لم أقترب البتّة حتّى

288
00:20:06,010 --> 00:20:08,470
أنا بعيد عنك

289
00:20:08,470 --> 00:20:10,480
بعيد جدّاً عنك

290
00:20:10,980 --> 00:20:13,020
لن يتغيّر هذا أبداً

291
00:20:13,730 --> 00:20:17,520
أيّ شيء تفعله لا يهمُّ الآن

292
00:20:19,150 --> 00:20:20,240
دارك جيان

293
00:20:34,750 --> 00:20:41,380
يسبِّب تأثير دارك جيان 2 ضرراً لكافّة
!أتباعي لكن يعزِّز هجومهم بمقدار 2

294
00:20:42,260 --> 00:20:43,760
انتهى الأمر

295
00:20:43,760 --> 00:20:46,510
!خسرت أمامي من جديد

296
00:20:51,600 --> 00:20:52,640
أجل، خسرتُ

297
00:20:54,900 --> 00:20:56,380
...هذا سيّئ

298
00:20:56,940 --> 00:20:59,520
كاغويا

299
00:21:02,320 --> 00:21:05,700
!يـ-يـ-يا لها من نهاية

300
00:21:05,700 --> 00:21:08,730
...عندما اعتقدنا بأنَّ الأمر انتهى

301
00:21:08,730 --> 00:21:11,460
!حقّقَ نصراً في دور واحد

302
00:21:11,460 --> 00:21:14,190
!لهذا هو واحد من أقوى اللَّاعبين في العالم

303
00:21:14,190 --> 00:21:16,710
!لهذا هو أحد الظِّلال السّبعة

304
00:21:16,710 --> 00:21:19,450
...الفائز هو

305
00:21:19,450 --> 00:21:22,630
!كاغويا ماكابي

306
00:21:22,630 --> 00:21:26,550
!لكن لعِبَ سوبارو أفضل بكثير ممّا توقَّعنا جميعاً

307
00:21:26,550 --> 00:21:31,040
أجل! من المُذهِل كيف اقتربَ من هزيمة
!أحد الظِّلال السَّبعة

308
00:21:31,040 --> 00:21:33,310
!لا أطيق انتظار رؤية ما سيفعله لاحقاً

309
00:21:33,310 --> 00:21:38,340
مضى وقتٌ طويلٌ منذ شعرتُ بإحباط
من الخسارةِ بهذا الشّكل

310
00:21:40,280 --> 00:21:43,190
لن أشعر بتحسُّن أبداً على هذا المُعدَّل

311
00:21:43,730 --> 00:21:45,630
ولا أنت، صحيح؟

312
00:21:46,230 --> 00:21:47,250
كاغويا

313
00:21:48,740 --> 00:21:54,080
فات الأوان... فات الأوان كثيراً يا أخي

314
00:23:24,080 --> 00:23:25,740
!استعراض بطاقة شادوفارس

315
00:23:24,090 --> 00:23:25,840
استعراض
بطاقة شادوفارس

316
00:23:26,370 --> 00:23:29,020
بطاقة اليوم هي المُتعاقِد الإلهيّ

317
00:23:29,020 --> 00:23:30,270
—حسناً، سوف أقدِّمها

318
00:23:30,270 --> 00:23:33,160
سوبارو! ساعدني في البحث عن خلفيّة
!متعلِّقة بهذا التَّابع

319
00:23:33,160 --> 00:23:35,140
—حسبما أرى، إنّها

320
00:23:35,140 --> 00:23:36,260
!فليأخذها أحدٌ إلى المنزل

321
00:23:36,260 --> 00:23:37,270
هيّا، سنغادر

322
00:23:37,270 --> 00:23:39,030
!لم أبدأ بعد

323
00:23:39,030 --> 00:23:43,350
.عديم الرّحمة كعادتك حسبما أرى
...لم ترَ أخاك منذ مدّة، صحيح؟ لذا

324
00:23:43,350 --> 00:23:45,730
يُفترَض بنا إذاً أن نتكلّم عن الأيّام
الخوالي؟ هذا سخيف

325
00:23:45,730 --> 00:23:48,440
أحترم هذا فيك

326
00:23:48,700 --> 00:23:51,690
الحلقة القادمة: "بعض المناظر لا يمكنك
"!رؤيتها إلّا لوحدك

327
00:23:51,690 --> 00:23:53,700
!قِتال! شادوفارس