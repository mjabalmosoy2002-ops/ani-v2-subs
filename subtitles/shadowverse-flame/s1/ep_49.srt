1
00:00:04,950 --> 00:00:08,880
!إنّه اليوم الرّابع من بطولة التّصنيف العالميّ

2
00:00:08,880 --> 00:00:15,250
إنّه اليوم الأخير وأفضل سبعة لاعبين جميعهم أقوياء

3
00:00:10,690 --> 00:00:12,700
كيباكورا سيا

4
00:00:10,690 --> 00:00:12,700
مصنوعة الأحجار الرّونيّة

5
00:00:12,700 --> 00:00:14,610
زو أونيزوكا

6
00:00:12,700 --> 00:00:14,610
مصنوعة التنّين

7
00:00:12,700 --> 00:00:14,610
كو هيبيغامي

8
00:00:12,700 --> 00:00:14,610
مصنوعة الدّماء

9
00:00:14,610 --> 00:00:16,490
ميابي زايزينجي

10
00:00:14,610 --> 00:00:16,490
مصنوعة السّيف

11
00:00:16,490 --> 00:00:18,370
شيرو كيرياما

12
00:00:16,490 --> 00:00:18,370
مصنوعة الغابة

13
00:00:19,150 --> 00:00:22,490
!لكن لا حاجة للاستسلام بعد

14
00:00:22,490 --> 00:00:25,540
!لليوم الأخير، هناك قاعدة خاصّة

15
00:00:25,500 --> 00:00:30,920
اللّاعبون الأعلى تصنيفاً

16
00:00:25,540 --> 00:00:34,810
تنصّ على أنّ أيّ شخص ضمن السّبعة
الأعلون يخسرون نقاطاً هائلة إذا خسروا مُباراة

17
00:00:30,710 --> 00:00:34,800
أفضل 50 لاعباً

18
00:00:36,120 --> 00:00:40,060
!ما يعني أنّه ما زالت أمامكم فُرصة لقلب الأمور

19
00:00:40,060 --> 00:00:42,800
!استمرّوا في المُشاهدة حتّى آخر لحظة

20
00:00:43,200 --> 00:00:46,930
دراكونير، سوف نستغلّ هذا أحسن استغلال

21
00:01:56,640 --> 00:01:59,010
"...بالنّسبة لي، أنت"

22
00:02:10,640 --> 00:02:12,450
سنلتقي من جديد

23
00:02:12,800 --> 00:02:13,700
أجل

24
00:02:14,010 --> 00:02:17,100
ظننتُ أنَّ مزيداً من النّاس سيأتون لأجلي

25
00:02:17,100 --> 00:02:19,450
أعتقد أنّ النّاس أجبن ممّا توقّعتُ

26
00:02:19,450 --> 00:02:21,530
إنّهم خائفون من الخسارة

27
00:02:22,060 --> 00:02:24,440
لكن هذا لا ينطبق عليك يا لايت

28
00:02:24,720 --> 00:02:27,250
أكذب إذا قلتُ بأنّني لم أكن خائفاً

29
00:02:27,250 --> 00:02:32,340
،لكن ما لم أهزمك وأتفوّق عليك
لا أستطيع المضيّ قُدماً

30
00:02:32,970 --> 00:02:34,650
المضيّ قُدماً؟

31
00:02:38,000 --> 00:02:39,680
هذا جيّد

32
00:02:39,680 --> 00:02:44,910
لم أكن أنوي القيام بهذا، لكن آلت
الأمور أفضل ممّا توقّعتُ

33
00:02:44,910 --> 00:02:47,890
أرغب في الحفاظ على نقاطي إن أمكن

34
00:02:48,390 --> 00:02:50,060
قاتلني من فضلك

35
00:02:50,640 --> 00:02:52,860
!قِتال! شادوفارس

36
00:02:53,410 --> 00:02:55,770
ماذا؟ ما هذا؟

37
00:02:55,780 --> 00:02:58,750
!يا إلهي! كم هذا ظريف

38
00:02:58,750 --> 00:03:03,710
كيف لشخص ضئيل كهذا أن يكون
واحداً من السّبعة الأفضل؟

39
00:03:05,040 --> 00:03:08,890
قد لا أكون طويلة مثلكما أيّتها الآنستان

40
00:03:08,890 --> 00:03:11,750
!لكن لديّ أحلام كبيرة

41
00:03:12,050 --> 00:03:16,290
لا أعتقد أنّني أحبُّ أمثالكِ

42
00:03:16,290 --> 00:03:18,750
عليكِ بها يا فيفيان

43
00:03:18,750 --> 00:03:20,140
!سأفعل يا أختي

44
00:03:21,860 --> 00:03:22,920
!لن أخسر

45
00:03:22,920 --> 00:03:25,930
!ستمدُّك الشّجاعةُ بالقوّة دوماً

46
00:03:32,100 --> 00:03:34,650
إذاً أتت فريستنا للعثور علينا؟

47
00:03:34,650 --> 00:03:37,170
أليس هذا رائعاً يا كو؟

48
00:03:37,170 --> 00:03:40,060
أجل. كان كسب كلّ تلك النّقاط مُستحَقّاً

49
00:03:40,390 --> 00:03:43,820
يبدو أنّهما زميلان أيضاً يا رئيس النّادي

50
00:03:43,820 --> 00:03:46,960
أجل. لكن هذا لا يغيّر من حقيقة ما يجب علينا فعله

51
00:03:47,230 --> 00:03:49,070
!لنربح يا سوبارو

52
00:03:49,070 --> 00:03:50,510
!أجل

53
00:03:53,240 --> 00:03:56,840
أما من عامّة يرغبون في تحدّيي؟

54
00:03:58,360 --> 00:03:59,560
ماذا نفعل؟

55
00:03:59,560 --> 00:04:01,290
مُحال أن نتمكّن من هزيمتها

56
00:04:07,430 --> 00:04:08,340
مرحباً

57
00:04:08,690 --> 00:04:10,150
يا إلهي

58
00:04:10,150 --> 00:04:12,650
يُقال بأنّ الفتيان يستطيعون إنجاز
،الكثير في غضون ثلاثة أيّام

59
00:04:12,650 --> 00:04:15,760
لكن يمكن أن تكون الفتيات مُختلِفات في كلّ يوم

60
00:04:17,390 --> 00:04:20,570
!أحبّ تلك النّظرة في وجهكِ! إنّها مُذهلة

61
00:04:20,570 --> 00:04:23,650
اسمي تسوباسا تاكاناشي

62
00:04:23,650 --> 00:04:25,360
تذكّريه بعد معركتنا من فضلكِ

63
00:04:26,770 --> 00:04:28,380
،إذا أردتِني أن أتذكّر ذلك

64
00:04:28,380 --> 00:04:30,860
!فاجعلي هذه المعركة معركةً لا أنساها إذاً

65
00:04:34,300 --> 00:04:36,290
...يبدو هذا غريباً

66
00:04:36,770 --> 00:04:39,210
أن يطاردني شخصٌ

67
00:04:39,720 --> 00:04:42,710
توقّعتُ من محترف أن يكون أجرأ

68
00:04:42,980 --> 00:04:47,420
ذاكرتي مُبهمة... عن خيانة شادوفارس

69
00:04:47,900 --> 00:04:52,370
لا أدري ما إن كان من المناسب أن أتواجد هنا

70
00:04:53,240 --> 00:04:54,800
هل يمكنني طرح سؤال عليك؟

71
00:04:54,800 --> 00:04:57,900
ماذا تعني شادوفارس بالنّسبة لك؟

72
00:04:59,320 --> 00:05:01,780
ربحتُ. هذا كلُّ شيء

73
00:05:02,260 --> 00:05:04,330
سأحذّرك بشأن أمر واحد

74
00:05:04,330 --> 00:05:09,070
تتطلّب شادوفارس الصّدق وإلّا فلن تستجيب لنا

75
00:05:11,610 --> 00:05:14,270
لن أكذب بشأن من أكون بعد الآن

76
00:05:14,270 --> 00:05:16,360
لن أكذب بشأن ضعفي

77
00:05:16,360 --> 00:05:18,370
ماذا عنك يا سيّد أرنب؟

78
00:05:18,640 --> 00:05:20,780
لستُ هنا لأجل جلسة سؤال وجواب

79
00:05:20,780 --> 00:05:24,210
!أنا هنا للفوز وأخذ نقاطك

80
00:05:24,480 --> 00:05:26,510
تتمتّع بالمعنويّات العالية

81
00:05:26,510 --> 00:05:29,090
لنرَ ما إن كنت تمتلك القوّة أيضاً

82
00:05:29,090 --> 00:05:34,840
في ملعب شادوفارس، المعركة بين لايت
!تينريو وسيا كيباكورا تستمرّ

83
00:05:34,840 --> 00:05:39,080
في الدّور 7، لايت الّذي حلّ ثانياً هو
من سيلعب! ما زال بكامل عافيته

84
00:05:39,080 --> 00:05:41,140
!أطوِّر مُحارب التنّين المُسلّح الخاصّ بي

85
00:05:45,350 --> 00:05:50,270
يتفعّل زِناده دائم التطوُّر، ثمّ
!يُهاجم السّاحرَ العظيم

86
00:05:55,030 --> 00:05:56,030
!ممتاز

87
00:05:58,270 --> 00:06:00,210
لقد تحسّنت

88
00:06:00,440 --> 00:06:03,880
،أجل! خضتُ معاركَ كثيرة عقب ذلك

89
00:06:03,880 --> 00:06:06,100
!وأنا أقوى بكثير ممّا كنتُ

90
00:06:06,410 --> 00:06:11,020
!هكذا يبدو. لكن لن أتخلّى عن فوز بتلك السّهولة

91
00:06:11,280 --> 00:06:15,750
!أهاجمك قائدك بتنّين نار الجحيم

92
00:06:17,560 --> 00:06:20,320
!انطلق يا خفّاش الغابة

93
00:06:27,020 --> 00:06:29,580
يبدو الصّيد ممتعاً للغاية، أليس كذلك يا كو؟

94
00:06:29,840 --> 00:06:31,960
لكن مللتُ

95
00:06:31,960 --> 00:06:33,400
إنّهم أقوياء

96
00:06:33,400 --> 00:06:37,580
أجل، لكن مُقارنةً به، يبدون ضعفاء

97
00:06:37,840 --> 00:06:40,230
لا نقبل بالخسارة

98
00:06:40,230 --> 00:06:42,500
!دوري

99
00:06:44,080 --> 00:06:45,050
!سحب

100
00:06:45,050 --> 00:06:47,580
!اركعي أمام قوّتي

101
00:06:47,580 --> 00:06:51,080
!بطاقة التّميمة: النّور الآرثريّ

102
00:07:02,200 --> 00:07:04,100
ها هو ذا

103
00:07:04,100 --> 00:07:06,890
!هذا هو نور ميابي زايزينجي

104
00:07:06,890 --> 00:07:10,060
نور ينتمي لمُحترِف شادوفارس حقيقيّ

105
00:07:15,480 --> 00:07:18,820
أنا هنا لأنّني لم أستطع التخلّي عن شادوفارس

106
00:07:18,820 --> 00:07:20,870
أنا هنا لأنّني أريد أن أكون هنا

107
00:07:21,220 --> 00:07:25,410
،لا يوجد شكّ في شادوفارس خاصّتي
لكن هناك كثير من الشكّ في خاصّتك

108
00:07:25,770 --> 00:07:28,910
هل تريد الفوز حقّاً؟

109
00:07:29,310 --> 00:07:32,340
أنت تلعب بشكل أفضل من السّابق بكثير

110
00:07:32,340 --> 00:07:34,350
من الواضح أنّك ترغب في الفوز بحقّ

111
00:07:38,770 --> 00:07:42,560
!لَعِبَ سيا للتو بكثير من الأتباع مع وارد

112
00:07:42,560 --> 00:07:45,710
يبدو أنّه يحاول حماية الغوليم المُطارد

113
00:07:45,710 --> 00:07:48,810
!إنّه قويٌّ حقّاً! هذه هي قوّةُ محترف

114
00:07:50,990 --> 00:07:55,510
ماذا تريد؟ مجد أن تكون واحداً من أفضل سبعة؟

115
00:07:55,510 --> 00:07:57,760
أو اكتساب حقّ مقاتلة الظّلال السّبعة؟

116
00:07:58,120 --> 00:08:01,540
إذا كنتُ سأفعل هذا، فأريد الاستمرار في الفوز

117
00:08:01,540 --> 00:08:04,890
وهناك شيء أريد أن أستردّه بمقاتلة الظّلال السّبعة

118
00:08:04,890 --> 00:08:08,580
هذا كثير جدّاً. أنت طمّاعٌ حقّاً

119
00:08:08,580 --> 00:08:11,120
...ربّما. لكن

120
00:08:11,120 --> 00:08:12,960
...أكثر ما أريده الآن هو

121
00:08:17,540 --> 00:08:21,520
الوصول إلى مكان وجود ميكادو ومقاتلته مرّة أخرى

122
00:08:21,520 --> 00:08:24,320
!هذا أكثر ما أريده الآن

123
00:08:26,650 --> 00:08:31,220
!وكي أفعل ذلك يا سيا، سوف أهزمك

124
00:08:34,080 --> 00:08:35,220
!تطوّر

125
00:08:46,640 --> 00:08:49,510
هذا مؤلم. أتقول بأنّني مجرّد سلّم؟

126
00:08:49,820 --> 00:08:52,250
!لا. أنت خصمٌ أنا ممتنٌّ له

127
00:09:06,550 --> 00:09:08,750
أنت صادقٌ حقّاً

128
00:09:09,130 --> 00:09:13,780
أنا بخلافك على ما أعتقد. لا أستطيع
التكلّم بالطريقة الّتي تتكلّم بها

129
00:09:14,960 --> 00:09:17,870
لكن لستُ طمّاعاً أيضاً

130
00:09:27,770 --> 00:09:30,870
أريد أن أكون الأخ الأكبر الرّائع دوماً

131
00:09:38,510 --> 00:09:42,330
حتّى لو كنتُ لا أستطيع أن أهزم الظّلال
،السّبعة أو أصبح الأقوى

132
00:09:42,330 --> 00:09:45,010
!هذا كلّ ما تعنيه القوّة بالنسبة لي

133
00:10:02,640 --> 00:10:05,510
!هـ-هـ-ها هي ذا

134
00:10:05,510 --> 00:10:09,780
هجمتان في دور واحد من إحدى أفضل
!بطاقات، غوليم الرّافض

135
00:10:09,780 --> 00:10:11,830
إنّها لا تُقهَر

136
00:10:15,090 --> 00:10:16,770
...لكن

137
00:10:20,540 --> 00:10:23,510
!ما زال لايت واقفاً

138
00:10:25,310 --> 00:10:26,670
!يمكنك فعلها

139
00:10:26,440 --> 00:10:27,650
!هيّا، هيّا

140
00:10:27,020 --> 00:10:28,980
!ما زالت لديك فُرصة

141
00:10:44,060 --> 00:10:45,140
سيا

142
00:10:45,850 --> 00:10:46,650
ماذا؟

143
00:10:47,000 --> 00:10:49,540
أعتقد بأنّك رائع

144
00:10:50,800 --> 00:10:51,880
شكراً

145
00:10:52,280 --> 00:10:55,160
لهذا أريد أن أهزمك هذه المرّة

146
00:10:56,100 --> 00:10:58,310
لهذا أريد أن أتفوّق عليك

147
00:11:05,310 --> 00:11:08,510
سيا، قلت بأنّك علّقت آمالاً كبيرة عليّ

148
00:11:08,510 --> 00:11:10,850
!وهذه هي إجابتي

149
00:11:31,850 --> 00:11:35,830
!أنا أقوى الآن... وهذه هي شادوفارس خاصّتي

150
00:11:37,160 --> 00:11:39,500
!ردّ الهجوم عليه يا غوليم الرّافض

151
00:11:48,440 --> 00:11:49,680
هكذا إذاً

152
00:11:49,680 --> 00:11:51,670
!هكذا إذاً. هكذا إذاً

153
00:11:53,400 --> 00:11:55,480
المُضلِّل السّحريّ

154
00:11:56,350 --> 00:11:57,810
...توقّعتُ

155
00:11:58,180 --> 00:11:59,690
...توقّعتُ ذلك، لكن

156
00:11:59,690 --> 00:12:02,450
رؤية ذلك عن كثب مؤلمة

157
00:12:02,450 --> 00:12:03,610
!لا تكُن هكذا

158
00:12:04,530 --> 00:12:08,660
كُفّ عن التصرُّف وكأنّها نهاية العالم
!أيُّها الأخ الغبيّ

159
00:12:08,660 --> 00:12:10,400
!هذا ليس من طباعك

160
00:12:12,910 --> 00:12:14,830
أنهي دوري يا لايت

161
00:12:14,830 --> 00:12:15,640
!حسناً

162
00:12:17,580 --> 00:12:20,190
شكراً لك يا سيا

163
00:12:20,190 --> 00:12:21,420
...بالنّسبة لليوم

164
00:12:21,770 --> 00:12:23,560
!ربحتُ

165
00:12:30,000 --> 00:12:32,020
لنتقاتل من جديد

166
00:12:35,990 --> 00:12:38,010
!وهذا كلُّ شيء

167
00:12:45,320 --> 00:12:47,780
أصبحت أقوى يا لايت

168
00:12:50,470 --> 00:12:52,730
!شكراً لك يا سيا

169
00:12:57,690 --> 00:13:01,790
كم ستصبح قوّتك فحسب يا لايت تينريو؟

170
00:13:01,800 --> 00:13:02,510
لايت تينريو

171
00:13:01,800 --> 00:13:03,590
ميكادو شيروغاني

172
00:13:01,800 --> 00:13:03,590
شيرو كيرياما

173
00:13:01,800 --> 00:13:03,590
سيا كيباكورا

174
00:13:01,800 --> 00:13:03,590
ميابي زايزينجي

175
00:13:01,800 --> 00:13:03,590
ريوغا جاسي

176
00:13:01,800 --> 00:13:03,590
رين كازاماتسوري

177
00:13:01,800 --> 00:13:03,590
كو هيبيغامي

178
00:13:02,510 --> 00:13:04,670
لايت تينريو

179
00:13:03,840 --> 00:13:04,670
ميكادو شيروغاني

180
00:13:03,840 --> 00:13:04,760
شيرو كيرياما

181
00:13:03,840 --> 00:13:04,760
سيا كيباكورا

182
00:13:03,840 --> 00:13:04,760
ميابي زايزينجي

183
00:13:03,840 --> 00:13:04,760
ريوغا جاسي

184
00:13:03,840 --> 00:13:04,760
رين كازاماتسوري

185
00:13:04,670 --> 00:13:05,470
ميكادو شيروغاني

186
00:13:04,670 --> 00:13:05,470
لايت تينريو

187
00:13:05,700 --> 00:13:08,150
حللتَ مكاني يا لايت

188
00:13:08,150 --> 00:13:12,590
اذهب واهزم الظّلالَ السّبعة الآن. اندفع
للأمام كما تفعل دوماً

189
00:13:12,830 --> 00:13:14,780
أجل، شكراً لك

190
00:13:14,780 --> 00:13:15,930
بالتّوفيق

191
00:13:16,850 --> 00:13:19,230
