198
00:13:34,790 --> 00:13:41,080
.ثم يخلق تأثيره بطاقة سلاح تميمة دراغو

199
00:13:46,990 --> 00:13:49,910
تستخدم تميمات أنت أيضا؟

200
00:13:49,910 --> 00:13:52,260
.بطاقات تميماتي قوية

201
00:13:52,260 --> 00:13:55,070
!أخيرا، أهاجم رينو باستخدام موشوسو

202
00:13:59,140 --> 00:14:03,680
.يتفعل تأثير القتال الخاص برينو ويسبب ضرر 1 لك

203
00:14:12,880 --> 00:14:13,980
هل انتهيت؟

204
00:14:13,980 --> 00:14:15,590
.حان دوري إذا

205
00:14:16,050 --> 00:14:17,080
.سحب

206
00:14:19,100 --> 00:14:23,490
.يتقدم العد التنازلي للذريعة المقدسة إلى الصفر

207
00:14:24,640 --> 00:14:28,770
.يتمّ تدمير الذريعة المقدسة وتتفعل كلماتها الأخيرة

208
00:14:29,010 --> 00:14:30,560
.أسحب بطاقتين

209
00:14:31,640 --> 00:14:33,010
.فهمت

210
00:14:33,010 --> 00:14:35,800
.تلك هي قوة تميمة عدّ تنازلي إذا

211
00:14:36,040 --> 00:14:38,570
.ألعب كاهنة الموشور

212
00:14:42,130 --> 00:14:47,540
.تأثيرها يضيف تميمة عدّ تنازلي عشوائية من مجموعتي ليدي

213
00:14:49,770 --> 00:14:52,790
.ثمّ ألعب دعاء الجناح

214
00:14:57,920 --> 00:15:00,130
تميمة عدّ تنازليّ أخرى؟

215
00:15:00,130 --> 00:15:04,910
.عندما تصل للصفر، ستخلق تابعا يحمل عاصفة

216
00:15:05,240 --> 00:15:07,260
.لا وقت للبقاء مكتوف الأيدي

217
00:15:07,260 --> 00:15:08,370
.أنهي دوري

218
00:15:08,370 --> 00:15:10,010
!لا أنوي ذلك

219
00:15:10,290 --> 00:15:10,900
!سحب

220
00:15:15,520 --> 00:15:18,890
!ألعب تابع التنين المدرّع، سحلية الرمح

221
00:15:26,510 --> 00:15:28,360
تملك تسارعا؟

222
00:15:28,360 --> 00:15:30,910
!أجل. لكنّ هذا ليس كل شيء

223
00:15:31,750 --> 00:15:34,810
!تهاجم سحلية الرمح كاهنة الموشور

224
00:15:34,810 --> 00:15:37,490
،إن كان هنالك سلاح دراغو وسط الملعب

225
00:15:37,490 --> 00:15:40,520
!يتفعل تأثير سحلية الرمح الهجوميّ

226
00:15:41,040 --> 00:15:42,720
.يرتفع دفاعه بمقدار 2

227
00:15:42,720 --> 00:15:46,370
!وفي إمكانها التسبب في ضرر 2 لقائد العدو

228
00:15:47,050 --> 00:15:50,230
!هيا! اخترقيه يا سحلية الرمح

229
00:15:58,010 --> 00:15:59,590
!أنهي دوري

230
00:15:59,590 --> 00:16:01,080
تسوباسا؟

231
00:16:01,080 --> 00:16:02,690
!هذه هي شادوفيرس خاصتي

232
00:16:04,640 --> 00:16:07,060
.لا أحد يهتمّ

233
00:16:08,250 --> 00:16:10,450
.تبدين وكأنك تتألمين أثناء لعب شادوفيرس

234
00:16:13,630 --> 00:16:15,410
.ما زلت مبتدئا

235
00:16:15,850 --> 00:16:20,180
لكن هنالك أمور تعلمتها عن طريق القتال
.ومشاهدة الآخرين يقاتلون

236
00:16:20,180 --> 00:16:23,760
.أحيانا، يمكن لشادوفيرس أن تربط قلبك

237
00:16:23,760 --> 00:16:26,880
.يمكنها أن تجعلك تعاني لأنك تأخذها على محمل الجدّ

238
00:16:27,830 --> 00:16:32,770
،لكن أن تتصرف على سجيتك وتكون صادقا مع مشاعرك

239
00:16:32,770 --> 00:16:34,090
.هو ما يجعل شادوفيرس رائعة

240
00:16:34,440 --> 00:16:39,130
.إن كنت تعانين يا تسوباسا، أريد معرفة السبب

241
00:16:39,130 --> 00:16:41,590
!أريد فهمك عن طريق مقاتلتك

242
00:16:41,590 --> 00:16:42,860
.هذا ما أفكر فيه

243
00:16:42,860 --> 00:16:44,020
تفهمني؟

244
00:16:44,290 --> 00:16:45,600
.هذا سخيف

245
00:16:45,600 --> 00:16:46,750
ما الذي تتحدث عنه؟

246
00:16:47,270 --> 00:16:49,520
...لا أريد تفهّمك

247
00:16:49,520 --> 00:16:50,940
!ليس في شادوفيرس

248
00:16:52,480 --> 00:16:53,950
!أو لي أنا

249
00:17:09,330 --> 00:17:10,980
ما هذا؟

250
00:17:10,980 --> 00:17:13,510
.بطاقة التميمة: ضريح الجوهرة

251
00:17:13,510 --> 00:17:18,440
.لا تملك عدا تنازليا لذا تبقى في الملعب حتى تتدمّر

252
00:17:19,050 --> 00:17:22,850
.عندما تدخل اللعب، أقوم بسحب بطاقة

253
00:17:22,850 --> 00:17:25,260
بالطبع فهذا ليس تأثيرها الوحيد

254
00:17:25,550 --> 00:17:27,550
.لكنه لن يقوم بتفعليها

255
00:17:28,300 --> 00:17:30,390
!ألعب طارد الأرواح ذو الإرزبة

256
00:17:32,150 --> 00:17:33,020
!تطوّر

257
00:17:36,540 --> 00:17:38,440
!يتفعل تأثير تطوّره

258
00:17:43,130 --> 00:17:45,720
!أقوم بتدمير تابع عدوّ

259
00:17:49,230 --> 00:17:50,180
!جميل

260
00:17:50,180 --> 00:17:52,010
.لم أنتهِ بعد

261
00:17:52,010 --> 00:17:54,060
.ـلعب روبي فالكون المتبلور

262
00:17:59,140 --> 00:18:00,190
متبلور"؟"

263
00:18:00,190 --> 00:18:06,080
التابعون المتبلورون يمكن لعبهم كبطاقات تميمة
.إن دفعت تكلفة تبلورهم

264
00:18:06,450 --> 00:18:09,960
.روبي فالكون هي تميمة عدّ تنازلي

265
00:18:10,360 --> 00:18:13,440
.لا تملك كلمات أخيرة لكنها تملك تأثيرا قويا

266
00:18:14,050 --> 00:18:16,570
...فهمت. إذا هذه

267
00:18:17,050 --> 00:18:19,200
.شادوفيرس خاصتك جميل جدا

268
00:18:20,270 --> 00:18:25,960
"اسمع. توقف عن قول هراء "شادوفيرس خاصتي
.و"شادوفيرس خاصتك" هذا

269
00:18:26,180 --> 00:18:28,580
.لا يوجد "خاصتك" أو "خاصتي" في شادوفيرس

270
00:18:28,580 --> 00:18:31,260
.يتعلق الأمر بمدى قوتك أو لا

271
00:18:31,260 --> 00:18:33,470
.وإن كنت ضعيفا، ستسحق فحسب

272
00:18:33,710 --> 00:18:36,510
هذا ما حدث للشعلة السابعة، صحيح؟

273
00:18:40,660 --> 00:18:44,020
!لا تعرفين أيّ شيءٍ عنّا

274
00:18:44,290 --> 00:18:45,380
.بلى

275
00:18:49,450 --> 00:18:52,420
.أعرف كل شيء عنكم

276
00:18:52,880 --> 00:18:53,810
...لأنّ

277
00:18:59,400 --> 00:19:02,910
،لأنّ ناديّ، الريشة الثالثة

278
00:19:04,710 --> 00:19:07,520
.تمّ سحقه من قبل هازيورا هاروما أيضا

279
00:19:09,370 --> 00:19:11,420
...لكن الريشة الثالثة

280
00:19:11,420 --> 00:19:13,410
.ما زلنا موجودين لكن هذا كل شيء

281
00:19:13,410 --> 00:19:15,880
.لا نعمل كنادي

282
00:19:16,470 --> 00:19:19,450
لا أعلم سبب غضب هاروما

283
00:19:19,450 --> 00:19:21,300
.لكني أعرف من يثير غضبه

284
00:19:21,550 --> 00:19:23,900
.الأشخاص الذين يحاولون بجدّ بالرغم من ضعفهم

285
00:19:23,900 --> 00:19:26,330
الأشخاص الذين لا يستسلمون بالرغم
.من عدم امتلاكهم لأيّ موهبة

286
00:19:27,480 --> 00:19:29,480
!أشخاص مثلك

287
00:19:30,690 --> 00:19:32,080
.أنا مختلف

288
00:19:32,490 --> 00:19:34,740
.لا تحاول بجدّ بعد الآن

289
00:19:34,740 --> 00:19:36,210
.لقد استسلمت

290
00:19:36,950 --> 00:19:39,390
.لذلك سمح للريشة الثالثة بالمواصلة

291
00:19:45,470 --> 00:19:47,080
ولا تمانعين ذلك؟

292
00:19:48,290 --> 00:19:49,570
!اخرس

293
00:19:51,890 --> 00:19:55,800
.دورك. اسحب بطاقتك يا طالب السنة الثانية

294
00:20:00,220 --> 00:20:02,930
.عيونك تلك تجعلني حزينة للغاية

295
00:20:02,930 --> 00:20:05,170
!سأعميها بضوئي

296
00:20:06,340 --> 00:20:10,550
!عندما أنظر إليك، أراك تلمعين ببريق

297
00:20:10,830 --> 00:20:14,870
.لكن تبدين... تبدين وكأنك تعانين كثيرا

298
00:20:16,360 --> 00:20:18,500
!لا ا‘تقد أنه يمكنني تركك هكذا

299
00:20:20,800 --> 00:20:21,940
!سحب

300
00:20:22,820 --> 00:20:25,200
!بطاقة التعويذة: حماس التنين

301
00:20:26,420 --> 00:20:29,530
!تزيد نقاط اللعب القصوى بمقدار 1

302
00:20:31,110 --> 00:20:33,970
...وتعيد دفاع قائدي بمقدار 3 نقاط

303
00:20:34,480 --> 00:20:36,020
!كما تسمح لي بسحب بطاقتين

304
00:20:36,890 --> 00:20:38,410
!أنهي دوري

305
00:20:38,410 --> 00:20:39,910
!هيا يا تسوباسا

306
00:20:40,220 --> 00:20:42,770
.لا داعي لتخبرني. ها أنذا

307
00:20:42,770 --> 00:20:43,610
!سحب

308
00:20:44,380 --> 00:20:46,890
.يتقدّم العدّ التنازلي خاصتي

309
00:20:46,890 --> 00:20:52,430
يصل العد التنازلي الخاص بدعاء الجناح إلى الصفر
.ويخلق صقرا مقدّسا

310
00:20:55,650 --> 00:20:57,640
!ألعب كاهنة الياقوت الأزرق

311
00:20:59,620 --> 00:21:02,180
!ثمّ أطور الصقر المقدّس والذي يملك عاصفة

312
00:21:08,410 --> 00:21:12,500
!يقوم هو وطارد الأرواح ذو الإرزبة بمهاجمة قائدك

313
00:21:28,870 --> 00:21:30,180
!لم أنتهِ بعد

314
00:21:30,180 --> 00:21:33,860
!يتفعل تأثير صقر روبي المتبلور

315
00:21:34,640 --> 00:21:37,580
،في كل مرة يهاجم فيها أحد أتباعي قائدك

316
00:21:37,580 --> 00:21:40,770
!يُمنح تابعٌ عشوائيّ لي عاصفة

317
00:21:41,110 --> 00:21:42,420
...وما اختارته هو

318
00:21:47,490 --> 00:21:49,880
!...الذي لعبته للتوّ

319
00:21:50,960 --> 00:21:52,870
.النعيم إلى جانبي على ما يبدو

320
00:21:53,190 --> 00:21:55,750
!كاهنة الياقوت الأزرق تملك عاصفة الآن

321
00:21:55,750 --> 00:21:57,220
!وتهاجم قائدك

322
00:22:06,960 --> 00:22:08,410
.أنهي دوري

323
00:22:08,410 --> 00:22:11,140
.كما يتفعل تأثير كاهنة الياقوت الأزرق

324
00:22:13,360 --> 00:22:18,140
!إن هاجم تابعيّ ثلاث مرّات، أقوم بسحب ثلاث بطاقات

325
00:22:28,330 --> 00:22:29,480
!مذهل

326
00:22:29,480 --> 00:22:33,320
جميع رؤساء النوادي كانوا أقوياء

327
00:22:33,320 --> 00:22:35,370
.لكنها من مستوى آخر كليا

328
00:22:35,370 --> 00:22:39,380
،تاكاناشي تسوباسا هي، من ناحية المهارة فقط
.من مستوى محترف

329
00:22:39,650 --> 00:22:42,830
.هي قوية فعلا

330
00:22:42,830 --> 00:22:46,140
...لكن... لكن لايت يمكنه أن

331
00:22:46,140 --> 00:22:51,140
.العبء الذي نحمله مختلف

332
00:22:51,140 --> 00:22:52,380
.إنه في مستوى مختلف تماما

333
00:22:53,200 --> 00:22:55,840
.لهذا اتخذت قراري

334
00:22:56,530 --> 00:22:58,400
...مهما قال أيّ شخص

335
00:22:58,820 --> 00:23:00,580
!الاستسلام كان الخيار الصائب

336
00:23:02,830 --> 00:23:04,230
هل حاولت؟

337
00:23:04,620 --> 00:23:05,990
حاولت مواصلة المحاولة؟

338
00:23:05,990 --> 00:23:07,520
حاولت عدم الاستسلام؟

339
00:23:08,050 --> 00:23:09,910
هل حاولت؟

340
00:23:11,510 --> 00:23:13,030
!لا تتحدّث معي هكذا

341
00:23:24,040 --> 00:23:25,800
!استعراض بطاقات شادوفيرس

342
00:23:26,050 --> 00:23:26,870
...بطاقة اليوم هي

343
00:23:26,870 --> 00:23:29,570
!بطاقة اليوم هي ضريح الجوهرة

344
00:23:29,570 --> 00:23:31,660
!تملك القدرة على تقوية أتباعك

345
00:23:31,660 --> 00:23:32,980
!كما أنها لامعة وجميلة

346
00:23:32,980 --> 00:23:35,190
!إنها البطاقة المثالية لك

347
00:23:35,190 --> 00:23:35,890
.لم يسألك أحد

348
00:23:35,890 --> 00:23:37,370
!البطاقة المثالية

349
00:23:37,370 --> 00:23:38,570
.اصمتي

350
00:23:38,970 --> 00:23:40,970
لماذا تبدو تسوباسا وكأنها تتألم كثيرا؟

351
00:23:40,970 --> 00:23:43,770
!عليك أن تسألها خلال المعركة

352
00:23:40,980 --> 00:23:41,980
عرضمســبق

353
00:23:43,770 --> 00:23:45,940
!في المرة القادمة، سترى أفضل بطاقاتها

354
00:23:45,940 --> 00:23:48,860
!بشادوفيرس، نفهم بعضنا البعض عن طريق القتال بكل قوتنا

355
00:23:48,860 --> 00:23:49,980
!تلك هي الروح المطلوبة

356
00:23:49,980 --> 00:23:51,960
:في الحلقة القادمة
"!ما يجعل شادوفيرس ممتعة"

357
00:23:51,960 --> 00:23:53,780
!معركة! شادوفيرس