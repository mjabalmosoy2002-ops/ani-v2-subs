1
00:00:04,600 --> 00:00:06,790
إنّها قويّةٌ حقّاً

2
00:00:07,920 --> 00:00:09,910
...لكن ما زال بمقدوري

3
00:00:09,910 --> 00:00:11,440
!تسوباسا

4
00:00:16,280 --> 00:00:19,030
أنتم... لكن كيف؟

5
00:00:19,030 --> 00:00:23,150
أخبرتنا شيون! لذلك نحن هنا لتشجيعكم
بكلّ ما أوتينا من قوّة

6
00:00:23,150 --> 00:00:24,720
!يمكنكِ فعلها يا تسوباسا

7
00:00:24,720 --> 00:00:27,230
!أعلم بأنّكِ تستطيعين الفوز يا سينباي

8
00:00:27,230 --> 00:00:29,660
!تساهلي معها قليلاً يا سينسي

9
00:00:29,660 --> 00:00:31,170
!وشيون هنا أيضاً

10
00:00:31,170 --> 00:00:32,210
أليس كذلك يا شيون؟

11
00:00:32,210 --> 00:00:33,760
!لـ-لستُ كذلك! لستُ كذلك

12
00:00:33,760 --> 00:00:36,180
...لستُ كذلك. ليس تماماً

13
00:00:34,960 --> 00:00:37,840
!كلّ اللّهب السّابع هنا

14
00:00:37,840 --> 00:00:41,000
،تبّاً. إذا كان لديكم الوقت لتشجيعي

15
00:00:41,000 --> 00:00:43,650
فينبغي أن تذهبوا وتكسبوا نقاطاً لأنفسكم

16
00:00:43,650 --> 00:00:45,840
كم أنتم حمقى

17
00:00:45,840 --> 00:00:48,610
جميعكم أنتم الصّغار لديكم مستقبل مُشرِق

18
00:00:48,610 --> 00:00:51,300
لكن لن أتساهل معكِ

19
00:00:51,550 --> 00:00:53,070
أعلم

20
00:00:53,640 --> 00:00:56,570
أريدكِ أن تبذلي كلّ جهدكِ في هذا

21
00:00:56,920 --> 00:00:59,770
لا أريد أن أخسر أمامي زملائي الكوهاي

22
00:01:00,520 --> 00:01:03,500
!سوف أتفوّق على غراند ماستر

23
00:02:37,620 --> 00:02:40,530
"ذلك الضّوء المُبهر سوف يتلاشى يوماً ما"

24
00:02:41,020 --> 00:02:43,320
دوري. سحب

25
00:02:43,640 --> 00:02:45,680
...ألعب بعذراء زُمُرّديّة مع وارد

26
00:02:47,940 --> 00:02:49,010
وأنهي دوري

27
00:02:49,350 --> 00:02:50,670
سحب

28
00:02:52,200 --> 00:02:53,780
،ألعب بروح التّجديد

29
00:02:56,060 --> 00:02:58,470
وأجري 3 إنشاز

30
00:03:01,320 --> 00:03:02,580
فيلق الرُّوح

31
00:03:04,450 --> 00:03:07,570
يمنح التّابعين الّذين يدخلون وضع
...اللّعب عن طريق إنشاز

32
00:03:11,750 --> 00:03:12,780
فورة؟

33
00:03:12,780 --> 00:03:15,310
ألعب بأندريالفوس

34
00:03:16,580 --> 00:03:21,470
وأرسل قنّاص الرُّوح الّذي دخل للتوّ وضع
اللّعب في هذا الدّور لمُهاجمة العذراء الزُمُرّديّة

35
00:03:22,290 --> 00:03:27,900
تأثيره الهجوميّ يلحق 1 ضرراً بقائد
العدوّ وجميع أتباعه

36
00:03:30,010 --> 00:03:30,900
إطلاق

37
00:03:39,010 --> 00:03:42,980
تعزّز الكلمات الأخيرة لقنّاص الرُّوح
من تعداد مقبرتي بمقدار 1

38
00:03:43,350 --> 00:03:47,400
قنّاص الرُّوح وفيلق الرُّوح يهاجمان قائدك

39
00:03:58,090 --> 00:03:59,340
!تسوباسا

40
00:04:01,610 --> 00:04:02,680
أنا بخير

41
00:04:03,240 --> 00:04:05,170
!إنّها البداية فقط

42
00:04:05,570 --> 00:04:08,600
،بالنّسبة للّاعب الّذي يحلُّ في المركز الثّاني
الدّور 4 هو حيث يبدأ المدّ بالانقلاب

43
00:04:11,650 --> 00:04:13,030
سوف أستخدم قوّتك

44
00:04:13,460 --> 00:04:15,730
!أيُّها النُّور النّبيل الّذي يُنزِل الحكم

45
00:04:17,580 --> 00:04:18,490
!تعال

46
00:04:19,990 --> 00:04:22,040
!تانزانيت كونفيكتور

47
00:04:29,150 --> 00:04:30,240
...هذا

48
00:04:30,240 --> 00:04:32,660
أجل. بطاقة سيرا

49
00:04:32,660 --> 00:04:35,130
التّالي، ألعب بوينغي، الحجر الكريم المرح

50
00:04:36,970 --> 00:04:38,410
أُطوِّر وينغي

51
00:04:42,210 --> 00:04:43,970
!ثمّ أُهاجم قنّاص الرُّوح

52
00:04:48,850 --> 00:04:50,760
تتحفّز كلماته الأخيرة

53
00:04:51,020 --> 00:04:53,080
وكذلك كلمات وينغي الأخيرة

54
00:04:53,080 --> 00:04:58,280
تابع عشوائيّ لي بهجوم 2 أو أقلّ
يحصل على وارد

55
00:04:59,680 --> 00:05:01,490
شكراً يا وينغي

56
00:05:04,190 --> 00:05:08,450
.تانزانيت كونفيكتور لديها عاصفة
تُهاجم أندريالفوس

57
00:05:12,920 --> 00:05:16,260
الكلمات الأخيرة. أسحب بطاقة

58
00:05:17,160 --> 00:05:18,560
أنهي دوري

59
00:05:18,560 --> 00:05:21,750
،تتفعّل أولى تأثيرات تانزانيت كونفيكتور

60
00:05:22,270 --> 00:05:24,620
لاستعادة دفاع القائدين بمقدار 1

61
00:05:25,970 --> 00:05:30,400
لا يمكن أن يعلو دفاع القائد عن 20

62
00:05:30,400 --> 00:05:33,550
لذا الآن هو وقت فعّال لاستخدامها

63
00:05:33,550 --> 00:05:35,600
أجل. وهذا ليس كلّ شيء

64
00:05:35,970 --> 00:05:38,420
،يتفعّل تأثير المزار المُرصّع بالمجوهرات

65
00:05:38,420 --> 00:05:43,560
ليعزّز هجوم ودفاع أيّ تابع لديه
عاصفة ووارد بمقدار 3

66
00:05:43,560 --> 00:05:46,860
...والآن بالنسبة للتّأثير الثّاني لتانزانيت كونفيكتور

67
00:05:47,350 --> 00:05:51,380
،عندما يتعزّز هجوم ودفاع تابع

68
00:05:51,380 --> 00:05:56,370
لا يمكن لتانزانيت كونفيكتور أن يُهاجَم
حتّى بداية دوري القادم

69
00:05:57,980 --> 00:05:59,630
هذا مزيج عظيم

70
00:05:59,630 --> 00:06:01,370
!أحسنتِ صنعاً يا تسوباسا

71
00:06:05,060 --> 00:06:08,340
هل كلّ الوقت الّذي تقضينه مع اللّهب السّابع ممتع؟

72
00:06:08,340 --> 00:06:10,760
أجل، على ما أعتقد

73
00:06:10,760 --> 00:06:12,090
إنّه ممتع

74
00:06:12,090 --> 00:06:13,830
جيّد

75
00:06:13,830 --> 00:06:15,460
ماذا عنكِ؟

76
00:06:16,690 --> 00:06:19,530
هل من الممتع التّواجد في كلّية شادوفارس؟

77
00:06:20,580 --> 00:06:23,160
لا أملك مستقبلاً

78
00:06:23,730 --> 00:06:26,270
لذا ليس تماماً على ما أعتقد

79
00:06:27,870 --> 00:06:33,860
المرح هو امتياز وحدكم أنتم النّاس الّذين
ما زلتُم لا تفقهون شيئاً لتتمتّعوا به

80
00:06:35,200 --> 00:06:38,390
يهبط الملاك السّادس علينا

81
00:06:38,390 --> 00:06:42,660
تعال يا جالب الدّمار، يا روح الكارثة

82
00:06:42,660 --> 00:06:45,050
تتطوّر روح الكارثة

83
00:06:59,260 --> 00:07:02,490
مهلاً، مهلاً. كم بطاقة قوية تمتلك هي؟

84
00:07:02,490 --> 00:07:04,640
تـ-تبدو قوية، أليس كذلك؟

85
00:07:04,640 --> 00:07:08,280
يتفعّل تأثيرها دائم التطوُّر. استحضار الأرواح 4

86
00:07:08,280 --> 00:07:12,400
تنقص كلفة بطاقة استحضار الأرواح بمقدار 1

87
00:07:12,830 --> 00:07:15,840
فيلق الرّوح يهاجم قائدكِ

88
00:07:23,710 --> 00:07:27,790
ماذا؟ ألم يملك تانزانيت كونفيكتور وارد؟

89
00:07:27,790 --> 00:07:33,220
عندما لا يمكن استهداف بطاقة مع وارد
بواسطة هجوم عاديّ، تُبطَل وارد

90
00:07:33,220 --> 00:07:34,470
الجميع يعلمون ذلك

91
00:07:34,470 --> 00:07:37,140
!فهمت! أنتِ خبيرة في شؤونكِ يا شيون

92
00:07:37,140 --> 00:07:38,620
!إنّه السيّد النّبيل

93
00:07:43,580 --> 00:07:46,630
...لكن لا يمكن مُهاجمة تانزانيت كونفيكتور

94
00:07:47,640 --> 00:07:50,770
يتفعّل تأثير روح الكارثة

95
00:07:50,770 --> 00:07:55,140
في نهاية دوري، دُمِّر تابعٌ عدوّ واحد

96
00:07:59,880 --> 00:08:01,580
محاولة جيّدة

97
00:08:01,580 --> 00:08:03,880
أنتِ قويّةٌ جدّاً يا سينسي

98
00:08:03,880 --> 00:08:05,870
من تكونين بالضبط؟

99
00:08:05,870 --> 00:08:07,340
مُدرِّسة

100
00:08:07,340 --> 00:08:11,540
لم أسمع بمُدرِّسة غراند ماستر من قبل

101
00:08:11,820 --> 00:08:16,080
لا يستحقُّ الأمر التّفكير. حياتي قد انتهت

102
00:08:16,420 --> 00:08:20,510
لا، سأفكّر في الأمر بالطبع

103
00:08:23,250 --> 00:08:25,670
!فنُّك هو وجه النُّور المُطلَق

104
00:08:26,010 --> 00:08:28,730
!تألّقي يا سيّدة الألماس

105
00:08:33,020 --> 00:08:36,460
تستخدمين بطاقات قويّة بمنتهى السّهولة

106
00:08:36,860 --> 00:08:40,040
وأنتِ غراند ماستر لكن لم يسمع أحدٌ بكِ

107
00:08:40,040 --> 00:08:42,700
كيف لي ألّا أتساءل حول ذلك؟

108
00:08:45,160 --> 00:08:46,700
...هذا

109
00:08:46,700 --> 00:08:48,540
أجل، بطاقة جديدة

110
00:08:48,540 --> 00:08:51,160
يتفعّل تأثير سورديان الزّبرجديّ

111
00:08:52,030 --> 00:08:55,340
تابع عشوائيّ لي يحصل على وارد

112
00:08:55,720 --> 00:08:58,170
يتفعّل تأثير سيّدة الألماس

113
00:08:58,480 --> 00:09:06,190
،متى استُهدِفَ تابع بشكل عشوائيّ
يتمّ اختيار سيّدة الألماس دوماً

114
00:09:06,760 --> 00:09:08,970
ألعب بالباز الياقوتيّ مع تبلوُر

115
00:09:11,970 --> 00:09:14,410
،يتفعّل تأثير سورديان الزّبرجديّ

116
00:09:14,410 --> 00:09:17,830
لمنحها عاصفة متى دخلَتْ بطاقةٌ
مُبلوَرة وضع اللّعب

117
00:09:17,830 --> 00:09:19,670
أطوِّر سورديان الزّبرجديّ

118
00:09:22,490 --> 00:09:24,070
،يتحفّز تأثيره دائم التطوُّر

119
00:09:24,540 --> 00:09:29,520
ليمنح تابعاً آخر لي القدرة على الهجوم
مرّتين في دور واحد

120
00:09:32,700 --> 00:09:34,010
!سلسلة هجمات مُبهرة

121
00:09:34,010 --> 00:09:36,050
!أظنّها قلبَتْ هذه المعركة رأساً على عقب

122
00:09:36,050 --> 00:09:39,550
أوّلاً، سورديان الزّبرجديّ يهاجم قائدك

123
00:09:42,420 --> 00:09:45,060
ويتفعّل تأثير الباز الياقوتيّ المُتبلور الخاصّ بي

124
00:09:45,910 --> 00:09:50,630
مرّة في كلّ دور، عندما يهاجم أحدُ
،أتباعي قائدَ العدوّ

125
00:09:50,630 --> 00:09:53,670
فإنَّ تابعاً عشوائيّاً من أتباعي يُمنَح عاصفة

126
00:09:53,670 --> 00:09:55,420
...والمُستهدَف هو

127
00:09:56,060 --> 00:10:00,480
!الآن، اسطعي بنوركِ يا سيّدة الألماس

128
00:10:01,100 --> 00:10:04,610
يتفعّل التّأثير الهجوميّ لسيّدة الألماس

129
00:10:04,610 --> 00:10:07,350
،إذا كان لديها كلّ من عاصفة ووارد

130
00:10:07,350 --> 00:10:10,860
تُدمِّر التّابعَ المُعارِض قبل أن يقع الضّرر القتاليّ

131
00:10:14,340 --> 00:10:15,630
!يهاجم من جديد

132
00:10:19,760 --> 00:10:21,780
!مـ-مذهل! فعلَها

133
00:10:21,780 --> 00:10:23,060
!أحسنتِ يا تسوباسا

134
00:10:25,970 --> 00:10:28,970
،ثمّ يتفعّل تأثير المزار المُرصَّع بالمُجوهرات

135
00:10:29,390 --> 00:10:32,320
ليُعزِّز أيّ تابع لديه عاصفة ووارد في نفس الوقت

136
00:10:34,080 --> 00:10:35,880
ما رأيكِ يا سينسي؟

137
00:10:35,880 --> 00:10:38,400
ممتاز على ما أعتقد

138
00:10:38,400 --> 00:10:43,130
تأثير المزار المُرصَّع بالمُجوهرات يصعب
تحفيزه، لكن أنتِ قد أتقنتِه

139
00:10:43,440 --> 00:10:45,540
ستكونين قويّة يوماً ما

140
00:10:47,360 --> 00:10:50,860
ينزل الملاك السّادس إلينا

141
00:10:50,860 --> 00:10:55,340
اكشف عن نفسك لنا، يا تجلّي إعادة
!الولادة! يا سيّد البعث

142
00:11:04,050 --> 00:11:07,370
هذا الّذي استخدمَتْه عندما قاتلتُها

143
00:11:07,370 --> 00:11:09,110
!أ-أجل، هذا هو

144
00:11:09,340 --> 00:11:12,470
يتفعّل تأثير سيّد البعث

145
00:11:14,360 --> 00:11:17,900
،باستحضار الأرواح 4، يُؤدِّي إنشاز 3

146
00:11:17,900 --> 00:11:20,030
ويمنح البطاقة الّتي تمَّ إنشازها عاصفة

147
00:11:20,830 --> 00:11:24,230
قنّاص الرُّوح يهاجم سيّدة الألماس

148
00:11:25,630 --> 00:11:30,320
يُلحِق تأثيره الهجوميّ 1 ضرراً بقائدك وكافّة أتباعك

149
00:11:38,130 --> 00:11:40,130
!ردّي بالمثل يا سيّدة الألماس

150
00:11:46,530 --> 00:11:51,060
أطوِّر سيّد البعث وأهاجم سيّدة الألماس

151
00:11:52,110 --> 00:11:54,930
يتحفّز تأثيره الهجوميّ

152
00:11:54,930 --> 00:12:00,220
باستحضار الأرواح 4، يُجري إنشاز 3، ثمّ
يمنح تلك البطاقة عاصفة

153
00:12:00,220 --> 00:12:01,450
من جديد؟

154
00:12:01,450 --> 00:12:02,860
هجوم

155
00:12:09,920 --> 00:12:14,660
ثمّ يهاجم قنّاصُ الرُّوح قائدَكِ

156
00:12:26,260 --> 00:12:28,880
يتطلّب كسري أكثر من ذلك

157
00:12:28,880 --> 00:12:31,790
فهمت. لكن سوف أربح

158
00:12:31,790 --> 00:12:35,570
أعتقد أنّ هذه كانت معركة جيّدة، لكن هذه هي النّهاية

159
00:12:35,570 --> 00:12:38,470
.لا جدوى من الاستمرار
هل ستتابعين مع ذلك؟

160
00:12:38,470 --> 00:12:39,670
أجل

161
00:12:40,440 --> 00:12:41,560
...سينسي

162
00:12:43,690 --> 00:12:47,270
،إذا قلتُ بأنّني أردتُ أن أكون مُحترِفة
فهل سوف تضحكين؟

163
00:12:49,010 --> 00:12:51,780
كنتُ قد استسلمتُ عن ذلك منذ زمن بعيد

164
00:12:52,720 --> 00:12:55,330
لكن ليس بعد الآن

165
00:12:55,330 --> 00:12:58,080
...إذا كان هناك فُرصة ولو واحد بالمئة

166
00:12:59,550 --> 00:13:00,750
...تسوباسا

167
00:13:01,760 --> 00:13:04,450
!لا أريد أن أستسلم

168
00:13:08,720 --> 00:13:11,830
!ألعب ببطاقة التّعويذة الصّلاة المُتألِّقة

169
00:13:13,220 --> 00:13:18,020
تابع مُستنسَخ من التّابع الّذي امتلك
كلّاً من وارد وعاصفة عندما دُمِّر

170
00:13:18,020 --> 00:13:19,430
أُضيفَ إلى يدي

171
00:13:19,850 --> 00:13:22,650
ألعب بسيّدة الألماس والعذراء اللّازورديّة

172
00:13:26,940 --> 00:13:32,900
يتفعّل تأثير العذراء اللّازورديّة، لمنح
تابع عشوائيّ لي وارد

173
00:13:33,540 --> 00:13:35,380
العذراء اللّازورديّة، تطوّري

174
00:13:36,780 --> 00:13:38,960
!هاجمي قنّاص الرُّوح

175
00:13:43,660 --> 00:13:46,630
سورديان الزّبرجديّ يهاجم قائدك

176
00:13:50,510 --> 00:13:53,500
،يتفعّل تأثير الباز الياقوتيّ المُتبلوِر الخاصّ بي

177
00:13:53,500 --> 00:13:57,470
ليمنح تابعاً عشوائيّاً لي عاصفة

178
00:13:59,020 --> 00:14:03,150
!سيّدة الألماس تهاجم سيّدَ البعث

179
00:14:03,930 --> 00:14:06,920
تأثيرها الهجوميّ يدمّره قبل أن يقع القتال

180
00:14:07,240 --> 00:14:10,080
أنهي دوري. أوّلاً، يتفعّل المزار المُرصَّع بالمُجوهرات

181
00:14:14,120 --> 00:14:16,090
التّالي، إنّه دور العذراء اللّازورديّة

182
00:14:16,090 --> 00:14:20,910
تضيف تابعاً كانت لديه عاصفة ووارد
،عندما دُمِّر إلى يدي

183
00:14:20,910 --> 00:14:23,410
وتعزّز هجومه ودفاعه بمقدار 3

184
00:14:27,240 --> 00:14:28,860
يا له من نور مُبهر

185
00:14:38,890 --> 00:14:41,430
...إنّه مُبهر حقّاً، لكن

186
00:14:42,090 --> 00:14:44,860
ذلك النّور المُبهر سوف يتلاشى يوماً ما

187
00:14:49,760 --> 00:14:50,990
سينسي؟

188
00:15:07,120 --> 00:15:08,920
...لأنّ العالم

189
00:15:15,910 --> 00:15:18,290
العالم مليء باليأس

190
00:15:31,230 --> 00:15:32,960
ما-ما هذا؟

191
00:15:32,960 --> 00:15:36,790
زائرة الجنازة. تلك الّتي تلوّن الحياة الآخرة

192
00:15:36,790 --> 00:15:40,870
في كلِّ مرّة أجري فيها إنشازاً، تنقص
كلفة هذا التّابع بمقدار 1

193
00:15:41,250 --> 00:15:43,250
كنتِ تهدفين لهذا منذ البداية؟

194
00:15:43,590 --> 00:15:47,760
المستقبل مُشرِق بشكل مُبهر، لكن كلّ هذا وهم

195
00:15:47,760 --> 00:15:50,320
لذا سوف أعلّمكِ

196
00:15:50,320 --> 00:15:53,050
سأنتزع منكِ يأسكِ

197
00:15:53,050 --> 00:15:56,340
،يتفعّل تأثير زائرة الجنازة

198
00:15:56,340 --> 00:16:01,150
لإلحاق 4 ضرر بقائد العدوّ وكافّة الأتباع

199
00:16:04,890 --> 00:16:06,440
لا حاجة للخوف

200
00:16:07,480 --> 00:16:10,150
لأنّ كلّ شيء سوف يتمّ تقبّله

201
00:16:26,690 --> 00:16:29,240
سيّدة... الألماس؟

202
00:16:38,450 --> 00:16:41,030
هل أنتِ بخير يا تسوباسا؟

203
00:16:41,030 --> 00:16:43,380
أجل. لكن خسرتُ

204
00:16:44,040 --> 00:16:46,700
كانت معركة مُدهشة حقّاً

205
00:16:46,700 --> 00:16:47,520
أجل

206
00:16:47,520 --> 00:16:50,000
...لذا، في الواقع

207
00:16:50,000 --> 00:16:52,350
سأعوّض ذلك لكِ في المرّة المقبلة

208
00:16:53,280 --> 00:16:54,870
ولكم أيضاً

209
00:16:54,870 --> 00:16:57,040
أجل. أتطلّع قدماً لذلك

210
00:16:57,470 --> 00:17:00,990
...إنقاذ... لإنقاذ

211
00:17:01,770 --> 00:17:04,590
ذلك كان هدف أمّي

212
00:17:05,370 --> 00:17:06,730
...لذلك أنا

213
00:17:06,730 --> 00:17:07,870
سينسي؟

214
00:17:08,690 --> 00:17:09,760
أنا آسفة

215
00:17:09,760 --> 00:17:12,250
لا... هل أنتِ بخير؟

216
00:17:15,050 --> 00:17:17,300
تأخّر الوقت. عودي إلى المنزل

217
00:17:17,720 --> 00:17:18,800
سينسي

218
00:17:19,810 --> 00:17:22,250
شكراً لكِ على مُقاتلتي

219
00:17:22,250 --> 00:17:23,690
سوف أربح في المرّة المقبلة

220
00:17:24,010 --> 00:17:27,440
أريد معرفة المزيد عنكِ

221
00:17:31,200 --> 00:17:34,030
بئس الأمر. إنّها غامضة جدّاً

222
00:17:34,030 --> 00:17:35,750
أجل، بالفعل

223
00:17:35,750 --> 00:17:37,970
لكن لا أظنّها شخصاً سيّئاً

224
00:17:37,970 --> 00:17:40,210
لحظة، التقيتُم جميعاً من دوني؟

225
00:17:40,210 --> 00:17:44,000
لا، انتهى المطاف بنا جميعاً في نفس المكان

226
00:17:45,410 --> 00:17:47,530
ماذا؟ هل خَجِلَتْ من جديد؟

227
00:17:47,530 --> 00:17:52,200
من يدري؟ لكن أنا واثق بأنّ هناك ما يدور في ذهنها

228
00:17:53,700 --> 00:17:57,460
!لديّ إعلان للجميع في بطولة التّصنيف العالميّ

229
00:17:57,460 --> 00:18:06,190
،السّاعة الآن هي 8 مساء! بالتّالي
!انتهى اليوم الثّالث من التّصنيف العالميّ

230
00:18:06,190 --> 00:18:09,920
!تهانينا إكمال يوم آخر من القتال أيُّها المُتنافِسون

231
00:18:09,920 --> 00:18:16,150
غداً هو اليوم الأخير. احرصوا على تجهيز
!مجموعة بطاقاتكم لأجل ذلك

232
00:18:16,150 --> 00:18:19,690
!لكن احرصوا على النّوم جيّداً أيضاً

233
00:18:19,690 --> 00:18:23,210
شارف التّصنيفُ العالميّ على الانتهاء

234
00:18:23,210 --> 00:18:25,380
لنأكل شيئاً بينما نخطِّط

235
00:18:25,380 --> 00:18:26,650
أجل، فكرة سديدة

236
00:18:26,650 --> 00:18:29,920
فكرة سديدة! ما رأيكم بمقهى ماروفوجي؟

237
00:18:29,920 --> 00:18:32,520
في المرّة السّابقة، ذهبنا بمفردنا

238
00:18:32,520 --> 00:18:36,040
بصراحة، أنا أتضوّر جوعاً

239
00:18:36,300 --> 00:18:38,730
!سوف آكل بنهم

240
00:18:38,730 --> 00:18:40,970
مهلاً، مهلاً، لا تفقد صوابك يا إتسكي

241
00:18:41,590 --> 00:18:44,430
بعض التّجارب لا يمكن خوضها إلّا لوحدنا

242
00:18:44,430 --> 00:18:46,730
بعض المشاهد لا يمكن أن نراها إلّا لوحدنا

243
00:18:47,270 --> 00:18:51,850
وبهذه الكلمات، أُنهي معركتي معك

244
00:19:02,950 --> 00:19:05,990
من اللّطيف الخروج بين الفيّنة والأخرى

245
00:19:09,240 --> 00:19:10,680
كيف كانت معركتك؟

246
00:19:10,680 --> 00:19:15,540
.في الواقع، التقيتُ بلاعب مُثير للاهتمام
لكن ما زال الطريق أمامه طويلاً

247
00:19:15,830 --> 00:19:18,860
خضتُ تجربة مُثيرة للاهتمام

248
00:19:18,860 --> 00:19:24,330
سأراقب إلى أين تصل، وكيف ستتطوّر

249
00:19:24,790 --> 00:19:26,640
—أتساءل ماذا سيكون جوابها

250
00:19:26,640 --> 00:19:30,900
اكتسبتُ الكثير من هذا. يسرّني أنّني اقترحتُ ذلك

251
00:19:31,960 --> 00:19:34,650
يبدو أنّ الآخرين لم يظهروا، لذا فلنبدأ

252
00:19:36,050 --> 00:19:39,840
اليوم الثّالث من التّصنيف العالميّ قد انتهى للتو

253
00:19:39,840 --> 00:19:45,500
،المراكز العليا تبدو تقريباً مثلما توقّعناها أن تكون

254
00:19:45,500 --> 00:19:49,540
مع حالتين شاذّتين: ريوغا جاسي ورين كازاماتسوري

255
00:19:50,030 --> 00:19:52,390
سيكون ذلك بفضلي

256
00:19:52,390 --> 00:19:54,950
تأخّرتِ 15 دقيقة يا آنسة سينكلير

257
00:19:55,240 --> 00:19:56,610
اصمت

258
00:19:56,610 --> 00:19:59,050
،منحتُها الكثير من النّقاط

259
00:19:59,050 --> 00:20:02,530
لذا حتّى لو خَسِرَتْ بقيّة مُبارياتها، أظنّها
أظنّها ستبقى من بين أفضل سبعة

260
00:20:03,360 --> 00:20:08,890
لم يبقَ إلّا يوم واحد، ما يعني أنّه على الأرجح
سيكون الفائزون هم هؤلاء السّبعة

261
00:20:08,890 --> 00:20:13,890
لكن لن يحدث ذلك. لدى المعارك الأخيرة
قاعدة سوف تغيِّر كلَّ شيء

262
00:20:13,890 --> 00:20:18,620
واسم الفتاة الّتي لفتت انتباهي ليست هناك

263
00:20:18,620 --> 00:20:20,700
أنا متأكّدٌ بأنّ أموراً غير مُتوقَّعة سوف تحدث

264
00:20:20,970 --> 00:20:25,610
أتّفق. لا أحد يعلم من سيربح معركة
شادوفارس ما لم تنتهِ

265
00:20:28,070 --> 00:20:29,460
أتطلّع قُدماً لذلك

266
00:20:29,460 --> 00:20:34,050
،لكن مهما كانت النّتيجة النّهائيّة
هدفنا لا يتغيّر

267
00:20:34,970 --> 00:20:39,380
كلّ ما نفعله، نفعله لأجل آرك

268
00:21:24,270 --> 00:21:28,110
سنحتاج لفعل شيء للوصول إلى أفضل سبعة

269
00:21:28,110 --> 00:21:32,030
أجل. مجرّد مقاتلة كلّ من نُصادفه
لن تكون كافية للوصول

270
00:21:32,030 --> 00:21:34,360
المعذرة، ماذا نفعل إذاً؟

271
00:21:34,360 --> 00:21:36,800
،لسنا من بين أفضل سبعة الآن

272
00:21:36,800 --> 00:21:40,220
لذا أعتقد علينا مقاتلة أشخاص لديهم نقاط كثيرة

273
00:21:40,220 --> 00:21:42,170
هذا سيُكسبنا الكثير من النّقاط

274
00:21:42,620 --> 00:21:47,040
نحتاج أيضاً لانتزاع نقاط من اللّاعبين
ذوي التّصنيف الأعلى أيضاً

275
00:21:49,150 --> 00:21:53,100
،سيكون ذلك صعباً، لكن إذا استطعنا هزيمتهم

276
00:21:53,760 --> 00:21:57,100
سيبدأ مزيدٌ من النّاس بتحدِّيهم كذلك

277
00:21:57,100 --> 00:21:57,900
...ثمّ

278
00:21:57,900 --> 00:22:00,390
...فهمت. ما يعني أنّني

279
00:22:00,390 --> 00:22:02,770
لا تقل لي بأنّك تريد مقاتلة ميكادو

280
00:22:02,770 --> 00:22:07,710
أجل، أعلم. لا أعتقد بأنّني قويٌّ
بما يكفي لهزيمة ميكادوح

281
00:22:07,710 --> 00:22:09,560
أوّلاً، أريد الانتقام من سيا

282
00:22:09,560 --> 00:22:13,230
خسرتَ أيضاً، صحيح؟ إنّه قويّ

283
00:22:13,230 --> 00:22:15,310
أجل. لكن في المرّة المُقبلة، سوف أفوز

284
00:22:15,310 --> 00:22:18,650
ثمّ سنذهب لمواجهة أعضاء القمّة السّبعة الآخرين

285
00:22:18,650 --> 00:22:19,760
...ورين

286
00:22:19,760 --> 00:22:22,870
!سأحرص على ألّا أخسر أمام أحد يتحدّاني

287
00:22:22,870 --> 00:22:23,860
جيّد

288
00:22:25,420 --> 00:22:27,200
هذا على حسابنا

289
00:22:27,200 --> 00:22:30,870
...شـ-شكراً لك. لكن لا يمكننا أكل كلّ هذه الكمّية

290
00:22:32,270 --> 00:22:34,690
سوف نقبلها. شكراً لك

291
00:22:34,690 --> 00:22:39,550
ستشاركون في التّصنيف العالميّ، صحيح؟
!كُلوا وصيروا أقوى

292
00:22:39,550 --> 00:22:40,830
!حسناً، سأفعل

293
00:22:40,830 --> 00:22:43,630
هل تلعب في التّصنيف العالميّ أيضاً يا رجل؟

294
00:22:43,630 --> 00:22:46,840
أنا؟ لا، لستُ كذلك

295
00:22:46,840 --> 00:22:51,060
أرغب في مقاتلة أولئك النّاس بما أنّه
مضت فترة، لكنّني مشغول بالمطعم

296
00:22:51,060 --> 00:22:53,650
!كازوكي! اللّحم المطبوخ مرّتين جاهز

297
00:22:53,650 --> 00:22:56,050
!بئساً! استمتعوا بطعامكم

298
00:22:56,050 --> 00:22:58,380
يبدو أنّه يعرف أكثر ممّا يكشف

299
00:22:58,380 --> 00:23:02,490
أجل. كان يتصرّف وكأنّه كان يعرف لوكا

300
00:23:02,490 --> 00:23:05,260
بجدّية؟ ما رأيك يا لايت؟

301
00:23:05,260 --> 00:23:08,710
أتّفق. كان ينبغي أن نطلب اللّحم المطبوخ مرّتين

302
00:23:08,710 --> 00:23:10,630
هل كنت تسمعنا أصلاً؟

303
00:23:10,630 --> 00:23:11,530
أجل

304
00:23:15,620 --> 00:23:19,550
غداً، سوف نتحدّى لاعبين أقوياء

305
00:23:19,550 --> 00:23:20,840
أنا متحمّس

306
00:23:20,840 --> 00:23:22,500
!أنا متحمّس حقّاً

307
00:23:23,990 --> 00:23:25,660
!استعراض بطاقة شادوفارس

308
00:23:25,660 --> 00:23:28,920
.بطاقة اليوم هي زائرة الجنازة
إنّها أفضل بطاقة للآنسة آندي

309
00:23:28,920 --> 00:23:32,390
،عندما تستخدم إنشاز، تنقص كلفتها
لذا هي أقوى ممّا تبدو

310
00:23:32,390 --> 00:23:35,680
انتهيت؟ لنلعب إذاً. أريد أن أعرف
كيفيّة هزيمة مصنوعة الظلّ

311
00:23:35,680 --> 00:23:36,720
—لا، أنا

312
00:23:36,720 --> 00:23:38,230
لا تشتكِ

313
00:23:39,150 --> 00:23:41,940
يبدو أنّني لن أتمكّن من تجنُّب مُقاتلتك يا لايت

314
00:23:41,940 --> 00:23:46,000
أجل، قاتلني من فضلك. أريد
أن أتفوّق عليك وأمضي قدماً

315
00:23:46,000 --> 00:23:49,380
!حسناً، فهمت. فلنفعلها

316
00:23:49,380 --> 00:23:51,640
"...الحلقة القادمة: "بالنّسبة لي، أنت

317
00:23:51,640 --> 00:23:53,500
!قِتال! شادوفارس