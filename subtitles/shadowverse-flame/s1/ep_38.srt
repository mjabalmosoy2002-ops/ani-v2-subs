1
00:00:23,540 --> 00:00:24,760
!لايت

2
00:00:26,780 --> 00:00:27,530
...لايت

3
00:00:27,530 --> 00:00:28,520
!لايت

4
00:00:28,520 --> 00:00:31,290
استيقظت. هذا مُطمئن

5
00:00:31,950 --> 00:00:33,300
ماذا حدث؟

6
00:00:33,300 --> 00:00:36,240
رُكِلت مؤخّرتك بواسطة ميكادو

7
00:00:36,240 --> 00:00:38,180
ثمّ غبت عن الوعي

8
00:00:40,080 --> 00:00:43,100
هل أنت بخير؟ هل هناك ما يؤلمك؟

9
00:00:43,100 --> 00:00:45,970
أظنّني بخير

10
00:00:48,870 --> 00:00:50,910
لا حمّى أيضاً

11
00:00:51,330 --> 00:00:56,240
نمتَ لمدّة ثلاثة أيّام. أنا مطمئن
جدّاً لأنّك استيقظت

12
00:00:56,980 --> 00:00:58,020
...إتسكي

13
00:00:59,700 --> 00:01:02,980
لا تُقلِق رئيس نادينا كثيراً، مفهوم؟

14
00:01:04,280 --> 00:01:06,610
أجل. آسف

15
00:01:07,600 --> 00:01:12,240
بالمناسبة! حدث أمر مذهل أثناء نومك

16
00:01:12,510 --> 00:01:14,060
أمر مذهل؟

17
00:01:14,530 --> 00:01:15,130
—إليك هذا

18
00:01:15,340 --> 00:01:16,840
انتظر يا سوبارو

19
00:01:17,630 --> 00:01:19,420
يجب أن نكون حذرين

20
00:01:19,420 --> 00:01:23,650
يبدو بخير، لكن أعتقد أنّ على الطبيب فحصه أوّلاً

21
00:01:24,010 --> 00:01:26,380
أجل، معك كلّ الحقّ

22
00:01:26,380 --> 00:01:29,290
حسناً، يمكننا الحديث عن التّفاصيل لاحقاً

23
00:01:29,290 --> 00:01:30,500
...و

24
00:01:31,790 --> 00:01:33,100
دراكونير؟

25
00:01:33,830 --> 00:01:37,570
جلس بجانبك طوال الوقت

26
00:01:37,570 --> 00:01:38,620
حقّاً؟

27
00:01:42,950 --> 00:01:45,490
لايت! استيقظت؟

28
00:01:45,990 --> 00:01:46,750
أجل

29
00:03:20,490 --> 00:03:22,720
"!تعال إلينا"

30
00:03:25,820 --> 00:03:28,430
لايت، أمتأكّد بأنّك بخير؟

31
00:03:28,740 --> 00:03:31,930
أنا بخير. كما ترى، تحسّنتُ كثيراً

32
00:03:32,220 --> 00:03:33,510
...لكن

33
00:03:33,510 --> 00:03:38,320
قال الطبيب بأنّني بخير أيضاً. لماذا أنت قلق؟

34
00:03:38,320 --> 00:03:44,570
لأنّ السّبب الوحيد وراء مقاتلتك ميكادو
...كان لاستعادة ذاكرتي

35
00:03:46,060 --> 00:03:48,120
هذه ليست غلطتك

36
00:03:48,120 --> 00:03:50,590
أنا المخطئ لأنّني خسرتُ أمامه

37
00:03:51,790 --> 00:03:55,920
...لم أستطع بلوغه إطلاقاً. لا قلبه ولا قوّته

38
00:03:56,330 --> 00:04:01,300
أعلم بأنّني ارتكبتُ أخطاء، لكن هل ستبقى
شريكي يا دراكونير؟

39
00:04:02,170 --> 00:04:04,280
!بـ-بالطبع

40
00:04:04,280 --> 00:04:06,540
!أنا صديقك الرّقميّ في نهاية المطاف

41
00:04:06,540 --> 00:04:08,720
!سأبذل قصارى جهدي

42
00:04:17,340 --> 00:04:22,560
أتعلم؟ سمعتُ من إتسكي بأنّك
معي طوال الوقت

43
00:04:23,510 --> 00:04:28,630
ليس طوال الوقت. أغادر الغرفة أحياناً

44
00:04:28,630 --> 00:04:30,340
...للذهاب إلى حمّام السّكن الدّراسي وما شابه

45
00:04:30,720 --> 00:04:31,630
الحمّام؟

46
00:04:32,840 --> 00:04:38,080
ماذا كنت تفعل في الحمّام؟ أنت
لا تحتاج للاستحمام، صحيح؟

47
00:04:38,890 --> 00:04:41,020
...سمعتُ إشاعة

48
00:04:41,550 --> 00:04:47,280
سمعتُ أنّه إذا رميت قطعة معدنيّة فوق
،كتِفك وإلى حمّام السّكن الدّراسي

49
00:04:47,280 --> 00:04:49,790
تتحقّق أمنيتك

50
00:04:49,790 --> 00:04:53,440
...لذا ارتأيتُ أنّ ذلك قد يساعدك على التّعافي أسرع

51
00:04:53,980 --> 00:04:56,170
فعلت ذلك لأجلي؟

52
00:04:58,860 --> 00:05:01,100
شكراً يا دراكونير

53
00:05:01,100 --> 00:05:04,100
حـ-حسناً على أيّ حال، سنكتفي من ذلك

54
00:05:09,150 --> 00:05:11,740
!أهلاً بعودتك يا لايت

55
00:05:12,210 --> 00:05:13,300
تسرّني العودة

56
00:05:14,370 --> 00:05:16,340
استغرقتَ وقتاً طويلاً حتّى استيقظت

57
00:05:16,740 --> 00:05:17,880
أنا آسف

58
00:05:19,080 --> 00:05:20,180
صباح الخير

59
00:05:20,860 --> 00:05:25,510
تسوباسا، أهذا كلّ ما لديك لقوله؟
ذهبتِ إلى العيادة كلّ يوم

60
00:05:25,510 --> 00:05:28,430
!ليس عليك إخباره بذلك

61
00:05:29,190 --> 00:05:33,080
لكن جلستِ بجانب سريره كلّ يوم
وقشّرتِ التفّاح له

62
00:05:33,080 --> 00:05:34,170
أليس كذلك يا شيون؟

63
00:05:36,520 --> 00:05:37,970
!وهذا الدّليل

64
00:05:40,390 --> 00:05:42,210
لحظة، متى التقطتِ هذه؟

65
00:05:42,210 --> 00:05:43,900
!انظري إلى هذه الأخرى الّتي التقطتُها

66
00:05:43,900 --> 00:05:49,060
صنعَتْ فطيرة تفّاح من التفّاح الّذي
قشّرَتْه أثناء نومك

67
00:05:50,550 --> 00:05:52,680
!كانت رائعة

68
00:05:52,680 --> 00:05:53,920
كانت شهيّة

69
00:05:53,920 --> 00:05:55,100
أجل

70
00:05:55,100 --> 00:05:56,990
أودُّ تجربتها في المرّة المقبلة

71
00:05:56,990 --> 00:05:58,980
"لن تكون هناك "مرّة مقبلة

72
00:05:58,980 --> 00:06:00,780
لمعلوماتك، أقلقتني كثيراً

73
00:06:01,010 --> 00:06:05,170
أنا آسف لأنّني أقلقتُكم

74
00:06:06,590 --> 00:06:11,650
حسناً، الآن يمكنني أن أخبرك عن ذلك الشّيء
المذهل الّذي ذكرتُه مسبقاً. جاهز؟

75
00:06:11,650 --> 00:06:12,450
تفضّل

76
00:06:15,580 --> 00:06:21,410
لعشّاق شادوفارس في كلّ مكان، والّذين
يقاتلون كلّ يوم للتحسُّن، لديّ رسالة

77
00:06:21,790 --> 00:06:26,020
أعلن عن إطلاق التّصنيف العالميّ لشادوفارس

78
00:06:28,980 --> 00:06:34,510
التّصنيف العالميّ هي بطولة عالميّة هائلة

79
00:06:35,130 --> 00:06:39,590
للمُشاركة، يجب عليكم تحميل تطبيق
خاصّ واستخدامه للقتال

80
00:06:40,370 --> 00:06:45,810
أثناء هذه الفترة، ستتمكّنون من التّنافس
في معارك واقع افتراضي حول العالم

81
00:06:46,540 --> 00:06:50,500
سيُعزِّز الفوز نقاط تصنيفكم. بينما الخسارة ستنقصها

82
00:06:50,500 --> 00:06:54,850
وبالطبع، مَن تصبح نقاطه سالبة، سوف يُقصى

83
00:06:55,100 --> 00:06:57,630
يُقام التّصنيف العالميّ على مدار أربعة أيّام

84
00:06:57,630 --> 00:07:03,350
عقب ذلك، سيُعلَن السّبعة الأفضل
،كأقوى لاعبين في العالم

85
00:07:03,350 --> 00:07:06,560
ويُمنَحون الفُرصة لتحدّينا نحن، الظِّلال السّبعة

86
00:07:07,320 --> 00:07:11,610
سيُمنَح اللّاعب ذو التّصنيف الأعلى
جائزة خاصّة رائعة

87
00:07:15,820 --> 00:07:19,480
،أنت يا من تعتقد وبلا شكّ بأنّك الأقوى

88
00:07:19,480 --> 00:07:22,150
!الآن حان الوقت لتُثبت قوّتك

89
00:07:22,150 --> 00:07:27,140
!شقّ طريقك عبر التّصنيف العالميّ وتعال إلينا

90
00:07:29,210 --> 00:07:31,130
التّصنيف العالميّ"؟"

91
00:07:31,480 --> 00:07:36,350
من أجل فترة التّصنيف العالميّ، تمّ
إلغاء الدّروس في كلّية شادوفارس

92
00:07:36,350 --> 00:07:38,590
!يمكننا لعِب ما نشاء من شادوفارس

93
00:07:38,590 --> 00:07:41,470
رأيت؟ هذا مبهر، أليس كذلك؟

94
00:07:41,850 --> 00:07:42,630
أجل

95
00:07:43,040 --> 00:07:45,310
هذه فرصتي لهزيمة ميكادو

96
00:07:45,590 --> 00:07:49,930
اتّفقنا بأن ندخل جميعنا معاً عندما تستيقظ

97
00:07:49,930 --> 00:07:53,120
كنتم تنتظرونني؟

98
00:07:54,120 --> 00:07:55,730
بالطبع كنّا كذلك

99
00:08:04,430 --> 00:08:05,880
!لنربح جميعاً

100
00:08:05,880 --> 00:08:08,470
...حسناً! اللّهب السّابع

101
00:08:08,470 --> 00:08:10,640
!هيّا... بنا

102
00:08:11,010 --> 00:08:12,500
!أجل

103
00:08:15,110 --> 00:08:24,060
التّصنيف العالميّ هو الفرصة المثاليّة
!لإعداد شيء مُميّز في مطبخي

104
00:08:33,030 --> 00:08:37,530
أنا أكولة جدّاً. أتعتقد بأنّك تستطيع إشباعي؟

105
00:08:37,780 --> 00:08:43,160
!المعارك تحتدّ بالفعل

106
00:08:43,160 --> 00:08:45,600
!التّصنيف العالميّ لشادوفارس

107
00:08:45,600 --> 00:08:50,760
مرحباً! أتستمتعون؟
!لأنّنا متأكِّدون

108
00:08:50,760 --> 00:08:55,350
ماذا؟ يبدو أنّ ماي لديها معركة
!رائعة لتُرينا إيّاها أيضاً

109
00:08:55,350 --> 00:08:58,260
!حسناً إذاً، أرينا ما عندك

110
00:08:58,540 --> 00:08:59,790
!بكلّ تأكيد

111
00:08:59,790 --> 00:09:04,810
!هذه معركة بين زو أونيزوكا وفواري هاهاجيما

112
00:09:05,740 --> 00:09:09,990
كلتاهما متعادلتان الآن، ولا أطيق
!انتظار ما سيحدث تالياً

113
00:09:09,990 --> 00:09:13,320
!غمضة واحدة وسيفوتكم كلّ الحماس

114
00:09:13,580 --> 00:09:15,570
!أجل، هذا صحيح

115
00:09:22,610 --> 00:09:24,150
يا إلهي

116
00:09:25,990 --> 00:09:27,800
!كم هذا شديد

117
00:09:27,800 --> 00:09:31,470
لعلّنا نشهد من الآن ذروة التّصنيف العالمي
!منذ يومنا الأوّل

118
00:09:31,470 --> 00:09:34,810
!سوف نريكم بقيّة المعركة لاحقاً

119
00:09:34,810 --> 00:09:36,630
!هذا كلّ شيء منّي

120
00:09:36,630 --> 00:09:39,040
!شكراً يا ماي

121
00:09:39,290 --> 00:09:43,080
الأشخاص من كافّة الأعمار مدعوّون
!للمشاركة! أيّ شخص يستطيع الفوز

122
00:09:43,080 --> 00:09:46,960
!أنا متحمّس جدّاً لأكون جزءاً من هذه البطولة المذهلة

123
00:09:46,960 --> 00:09:49,380
من سيُتوَّج بالأقوى؟

124
00:09:49,380 --> 00:09:55,740
ينتهي اليوم الأوّل من التّصنيف العالميّ
لشادوفارس في الثّامنة من هذه اللّيلة

125
00:10:10,290 --> 00:10:11,800
!مُذهل

126
00:10:11,800 --> 00:10:14,300
تحمّس لاحقاً. ادخل أوّلاً

127
00:10:14,530 --> 00:10:18,160
!أجل! لنفعلها جميعنا معاً

128
00:10:18,570 --> 00:10:22,270
عندما تشارك، تتمكّن من رؤية
نقاط تصنيفك الحالي

129
00:10:22,270 --> 00:10:26,070
يتمّ تحديدها بواسطة سجلّ الفوز
،الخاص بكلّ لاعب

130
00:10:26,070 --> 00:10:33,660
تصنيف شادوفارس الخاص بهم، فوزهم
!في البطولات وما شابه ذلك

131
00:10:33,870 --> 00:10:35,830
...حسناً. استعداد، هيّا

132
00:10:36,160 --> 00:10:37,310
!وضغط

133
00:10:53,040 --> 00:10:54,710
هكذا إذاً

134
00:10:54,710 --> 00:10:56,310
!انتظر يا لايت

135
00:10:58,730 --> 00:11:02,550
!صـ-صـ-صفر

136
00:11:02,800 --> 00:11:05,370
ماذا؟ هـ-هذا غير ممكن، صحيح؟

137
00:11:05,370 --> 00:11:08,680
كـ-كيف لعلامتك أن تكون أقلّ
من علامتي بعد أن هزمتني؟

138
00:11:08,970 --> 00:11:11,710
خضت معاركَ كثيرة، صحيح؟

139
00:11:11,710 --> 00:11:14,520
!لكنّه هزمَ غراند ماستر حتّى

140
00:11:16,920 --> 00:11:18,750
عليك أن تكون أكثر قلقاً

141
00:11:19,150 --> 00:11:23,140
صفر نقطة تعني بأنّ خسارة واحدة
سوف تجعلك نقاطك سالبة

142
00:11:23,140 --> 00:11:25,790
خسارة واحدة وستُقصى من البطولة

143
00:11:25,790 --> 00:11:28,740
بالتأكيد، لكن أحتاج للفوز فقط، صحيح؟

144
00:11:31,020 --> 00:11:33,820
لذا سوف أربح. هذا كلّ ما في الأمر

145
00:11:35,740 --> 00:11:38,250
هذا هو طبعك، صحيح؟

146
00:11:38,250 --> 00:11:43,500
،لكنّه على حقّ! إذا كان لا يملك نقاطاً
!فيجب أن يفوز فحسب

147
00:11:43,750 --> 00:11:46,420
!لنتفرّق إذاً

148
00:11:46,820 --> 00:11:50,840
لنخبر بعضنا الآخر جميعاً كيف أبلينا
بعد نهاية معارك اليوم

149
00:11:54,990 --> 00:11:57,870
شيون، أتريدين المجيء معي؟

150
00:11:57,870 --> 00:12:01,240
!لـ-لا! لا تعامليني كطفلة

151
00:12:01,550 --> 00:12:03,490
لكن لا يروقكِ كونكِ في الخارج، صحيح؟

152
00:12:03,490 --> 00:12:07,970
لا تستهيني بي. لقد كبرتُ قليلاً

153
00:12:09,320 --> 00:12:12,160
حسناً، كما سمعتِ. حسناً؟

154
00:12:12,160 --> 00:12:16,180
!أجل! حسناً، لا أطيق الانتظار

155
00:12:16,180 --> 00:12:17,240
ولا أنا

156
00:12:17,240 --> 00:12:18,090
!أجل

157
00:12:18,480 --> 00:12:19,840
بالتّوفيق للجميع

158
00:12:20,400 --> 00:12:21,470
وداعاً

159
00:12:21,990 --> 00:12:23,680
حاولوا ألّا تخطئوا

160
00:12:53,280 --> 00:12:55,790
بدأت العجلات تدور من جديد

161
00:13:07,630 --> 00:13:10,630
ألديك خطّة يا لايت؟

162
00:13:10,630 --> 00:13:15,410
أرغب في تحدّي لاعب قويّ إذا استطعتُ

163
00:13:15,410 --> 00:13:16,990
سيكون ذلك جيّداً

164
00:13:18,780 --> 00:13:22,840
تبدو نيكومي كبلدة رثّة صغيرة دوماً

165
00:13:22,840 --> 00:13:26,250
ما رأيك يا لايت تينريو؟

166
00:13:27,340 --> 00:13:30,540
وهنا لدينا فتى رثّ المظهر أيضاً

167
00:13:30,820 --> 00:13:34,790
إنّه هدفنا؟ بجدّية؟

168
00:13:35,130 --> 00:13:36,600
من أنتما؟

169
00:13:37,380 --> 00:13:40,720
فيفيان جوبيرت سيّئتا الصّيت

170
00:13:40,720 --> 00:13:42,910
وفانيسّا جوبيرت

171
00:13:42,910 --> 00:13:44,880
سررتُ بلقائك

172
00:13:49,020 --> 00:13:51,510
سررتُ بلقائكما أيضاً

173
00:13:51,780 --> 00:13:53,520
يا لك من طفل مزعج

174
00:13:53,520 --> 00:13:55,590
لا يملك فكرة عن الخطر الّذي يحدّق به

175
00:13:58,940 --> 00:14:03,740
ألا ينتابك فضول حيال سبب معرفتنا باسمك؟

176
00:14:03,740 --> 00:14:05,740
هذه وجهة نظر سديدة

177
00:14:06,230 --> 00:14:07,780
...لكن الآن

178
00:14:08,820 --> 00:14:13,120
أنا مهتمّ أكثر بنقاطكما الـ 4000

179
00:14:14,100 --> 00:14:16,160
نقاطك صفر

180
00:14:16,160 --> 00:14:21,700
إذا خسرت، سوف تصبح نقاطك سلبيّة
وتُقصى من التّصنيف العالمي

181
00:14:21,700 --> 00:14:23,660
ألا ينبغي أن تهرب؟

182
00:14:23,960 --> 00:14:27,580
أريد أن أكون ضمن أفضل سبعة
في التّصنيف العالمي

183
00:14:27,580 --> 00:14:29,500
وأريد هزيمة ميكادو هذه المرّة

184
00:14:29,900 --> 00:14:31,800
لذا لن أهرب

185
00:14:32,030 --> 00:14:35,900
أختي، أعتقد بأنّ الحظّ يبتسم لنا

186
00:14:35,900 --> 00:14:38,070
أجل، معك حقّ

187
00:14:38,300 --> 00:14:42,500
بصراحة، نريد أن نركل مؤخّرتك نحن الاثنتان

188
00:14:42,500 --> 00:14:47,360
لكن التّصنيف العالمي لا يسمح إلّا
بمعارك واحد ضدّ واحد

189
00:14:47,360 --> 00:14:50,200
وإن كنت في بلد، فافعل ما يفعل
أهلُها، كما يقولون

190
00:14:50,440 --> 00:14:53,070
لذا سوف ألتزم بالقواعد

191
00:14:54,310 --> 00:14:56,840
ما رأيك أن نتبارز؟

192
00:14:57,740 --> 00:14:58,960
حسناً، لنفعل

193
00:14:59,370 --> 00:15:02,080
!لن أخسر. سوف أربح هذه مهما حدث

194
00:15:02,080 --> 00:15:06,350
يا لها من روح مُبهرة. لا أطيق انتظار كسرها

195
00:15:06,750 --> 00:15:09,260
!قِتال! شادوفارس

196
