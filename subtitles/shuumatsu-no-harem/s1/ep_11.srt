185
00:12:09,890 --> 00:12:13,960
لكن أظنّ أنّه ينبغي لشخص يابانيّ أن يحكم اليابان

186
00:12:14,260 --> 00:12:18,080
أنتِ تضيّعين وقتي، قولي مرادكِ مباشرةً فحسب

187
00:12:19,710 --> 00:12:22,340
هلّا تعطيني ذلك المنصب؟

188
00:12:25,240 --> 00:12:27,850
منصب مديرة الشّؤون الوطنيّة

189
00:12:36,260 --> 00:12:37,230
هذا هو المكان

190
00:12:44,860 --> 00:12:45,860
ري-ني

191
00:12:46,140 --> 00:12:47,360
ماهيرو

192
00:12:48,100 --> 00:12:50,240
يسرّني أنّكِ وصلتِ إلى هنا

193
00:12:50,630 --> 00:12:52,940
ساعد الجميع

194
00:12:52,940 --> 00:12:55,000
أشكركنَّ جميعًا

195
00:12:55,260 --> 00:12:59,450
تساءلتُ عمَّا ستريده كاتاغيري-سان بعد أن تواصلتْ معي فجأة

196
00:12:59,450 --> 00:13:02,500
أرادتْ المساعدة في إخراج ماهيرو

197
00:13:02,500 --> 00:13:05,120
كنتِ تعرفين كاتاغيري-سان؟

198
00:13:05,710 --> 00:13:09,710
كنتُ مسؤولة العلاقات المدنيّة، لذا أعرف الكثير من المحلّيات

199
00:13:10,270 --> 00:13:15,540
لا تهتم بنا خليفة كاتاغيري-سان جميعًا

200
00:13:15,540 --> 00:13:19,920
يكره الجميع ا.ن، لكنّنا نحبّها

201
00:13:21,430 --> 00:13:22,270
ماذا؟

202
00:13:22,270 --> 00:13:24,190
لا شيء

203
00:13:24,190 --> 00:13:29,810
لكن مع ذلك لا أصدّق أنّ ميزوهارا ريتو هو في الحقيقة أخوكِ

204
00:13:29,810 --> 00:13:31,530
آسفة على عدم إخباركِ عنه

205
00:13:31,820 --> 00:13:35,290
لدى الجميع أسرارهم هذه الأيّام

206
00:13:36,910 --> 00:13:39,990
أنتَ أظرف ممَّا تبدو عليه على التّلفاز

207
00:13:39,990 --> 00:13:40,530
شكرًا

208
00:13:40,530 --> 00:13:44,300
أبعدي يديكِ عن كنز البشريّة

209
00:13:44,300 --> 00:13:46,620
ليس وكأنّي أؤذيه

210
00:13:47,160 --> 00:13:48,650
أهي جاهزة؟

211
00:13:48,650 --> 00:13:51,550
نعم، قديمة قليلًا، لكنّها تفي بالغرض

212
00:13:51,870 --> 00:13:53,180
أشكركِ

213
00:13:53,180 --> 00:13:56,470
ماذا ستفعلين الآن يا أوني-ساما؟

214
00:13:58,370 --> 00:13:59,810
اسمعنَ جميعًا

215
00:13:59,810 --> 00:14:03,440
سنبقى هنا حتّى شروق الشّمس

216
00:14:03,440 --> 00:14:04,500
وبعدها؟

217
00:14:04,500 --> 00:14:05,700
لديّ خطّة

218
00:14:06,260 --> 00:14:09,450
سنتحرّك حين يخيّم اللّيل، استرحنَ حتّى ذلك الحين

219
00:14:09,670 --> 00:14:12,450
شكرًا لكِ يا كاتاغيري-سان

220
00:14:13,540 --> 00:14:15,240
هذا ليس من أجلكَ

221
00:14:22,730 --> 00:14:25,210
أيمكننا الانضمام؟

222
00:14:30,220 --> 00:14:35,720
بعد أن كبِرتَ بدا الأمر وكأنّكَ ستتركنا

223
00:14:36,330 --> 00:14:38,860
لكن لا يزال بمقدوركَ إبداء هذا الوجه

224
00:14:38,860 --> 00:14:40,850
أكنتِ تحبّين نفسي القديمة أفضل من الحاليّة؟

225
00:14:41,130 --> 00:14:42,460
لستُ متأكّدة

226
00:14:42,460 --> 00:14:44,610
!أحببتُ كم كنتَ ظريفًا

227
00:14:44,900 --> 00:14:48,010
حتّى لو أفعل هذا لكما؟

228
00:14:50,870 --> 00:14:54,370
كان ذلك رائعًا يا شوتا-سان

229
00:14:54,820 --> 00:14:56,400
استرحن جميعًا

230
00:15:00,150 --> 00:15:01,430
كيف كان؟

231
00:15:02,340 --> 00:15:03,980
أشعر بشعور رائع

232
00:15:03,980 --> 00:15:07,000
مرّتْ بضعة أيّام منذ تزاوجكَ

233
00:15:07,000 --> 00:15:09,630
أراهن أنّكَ قضيتَ وقتًا رائعًا

234
00:15:10,030 --> 00:15:12,630
أجل، كان شعوره رائعًا

235
00:15:14,780 --> 00:15:15,860
ما الخطب؟

236
00:15:16,300 --> 00:15:21,410
لا، يبدو الأمر فقط أنّكَ كبِرتَ فعلًا
أنا سعيدة

237
00:15:21,410 --> 00:15:23,650
هل ردّتْ علينا الآنسة مانسفيلد؟

238
00:15:23,650 --> 00:15:26,770
"كان كل ما قالتْه هو:" سأفكّر فيه

239
00:15:26,770 --> 00:15:30,300
أظنّ أنّه لن يكون بتلك السّهولة أن تحتلّي منصب مديرة الشّؤون الوطنيّة

240
00:15:31,020 --> 00:15:34,410
وهربَ الرّقم اثنان كما يبدو

241
00:15:36,130 --> 00:15:39,410
إنّه أشجع ممّا ظننت

242
00:15:39,410 --> 00:15:42,330
ستتعقّد الأمور

243
00:15:42,330 --> 00:15:44,840
سيتوجّب علينا الحصول على مساعدة الآخرين

244
00:15:51,370 --> 00:15:52,550
وصلنا

245
00:15:53,090 --> 00:15:54,280
أسنستعمل هذه السّفينة؟

246
00:15:56,050 --> 00:15:58,340
هذا أقصى ما يمكننا الذّهاب إليه أنا وميرا

247
00:15:58,340 --> 00:16:02,010
لديّ شخص سيخرج به من المياه اليابانيّة

248
00:16:02,010 --> 00:16:04,560
اسأله عن الباقي

249
00:16:04,870 --> 00:16:08,820
شكرًا لكِ يا كاتاغيري-سان

250
00:16:09,110 --> 00:16:12,790
...أخوكَ ميزوهارا ريو

251
00:16:12,790 --> 00:16:14,700
سأبذل كلّ ما بوسعي لحمايته

252
00:16:14,700 --> 00:16:17,620
أشكركِ على الاهتمام بأخي

253
00:16:17,620 --> 00:16:18,830
شكرًا لكِ

254
00:16:20,480 --> 00:16:21,290
ريتو

255
00:16:21,580 --> 00:16:23,710
سنواصل تقدّمنا

256
00:16:23,710 --> 00:16:25,420
أنا أيضًا

257
00:16:30,340 --> 00:16:33,000
سوو-سان

258
00:16:33,540 --> 00:16:34,300
نعم؟

259
00:16:34,710 --> 00:16:38,050
أشكركِ على كلّ شيء

260
00:16:38,050 --> 00:16:40,540
لا، لم أفعل أيّ شيء

261
00:16:45,100 --> 00:16:51,070
أنا الّتي يجب أن تشكركَ
كان شرفًا لي أن أكون إلى جانبكَ

262
00:16:57,050 --> 00:16:59,720
أعدكِ أنّني سأعود

263
00:17:00,520 --> 00:17:03,840
ابقي بأمان إلى ذلك الوقت

264
00:17:06,120 --> 00:17:06,920
سأفعل

265
00:17:17,480 --> 00:17:21,930
هذه هي الشّخص يا ريتو الّتي ستُخرجنا من اليابان

266
00:17:21,930 --> 00:17:22,960
أنتِ...؟

267
00:17:22,960 --> 00:17:24,970
نعم، أنا مع الإيزانامي

268
00:17:25,260 --> 00:17:26,850
المنظّمة الغامضة؟

269
00:17:26,850 --> 00:17:29,860
سنتّجه جنوبًا

270
00:17:29,860 --> 00:17:32,530
جنوبًا؟
إلى أين؟

271
00:17:32,530 --> 00:17:33,600
تايوان

272
00:17:33,600 --> 00:17:36,240
سنلتقي إيريسا هناك

273
00:17:37,140 --> 00:17:40,380
تايوان؟
ليس نيغاتا؟

274
00:17:40,380 --> 00:17:43,620
البقاء داخل اليابان بشكل كامل أمر خطر للغاية

275
00:17:43,940 --> 00:17:46,120
فإيريسا في طريقها إليها

276
00:17:46,590 --> 00:17:47,700
إيريسا

277
00:17:47,700 --> 00:17:49,370
قالتْ إنّها ترغب في رؤيتكَ

278
00:17:56,580 --> 00:17:59,930
حدث الكثير منذ استيقاظي من النّوم البارد

279
00:18:03,050 --> 00:18:04,310
سوو-سان

280
00:18:05,960 --> 00:18:08,440
أأنتِ واثقة أنّكِ لا تستطيعين خيانة الفرع اليابانيّ؟

281
00:18:09,380 --> 00:18:11,860
كنتَ تفكّر في سوو-سان، ألستَ كذلك؟

282
00:18:11,860 --> 00:18:13,830
...ماهيرو، لم

283
00:18:13,830 --> 00:18:15,440
سأخبر إيريسا-تشان

284
00:18:15,440 --> 00:18:16,460
لماذا؟

285
00:18:16,460 --> 00:18:18,560
هذه من أجلكَ

286
00:18:19,650 --> 00:18:20,590
لوحة إلكترونيّة؟

287
00:18:21,030 --> 00:18:22,200
ممّن هذه؟

288
00:18:22,200 --> 00:18:23,150
لا أعلم

289
00:18:25,180 --> 00:18:27,740
لمَ هي غاضبة؟

290
00:18:27,740 --> 00:18:29,710
إنّها تعمل

291
00:18:30,710 --> 00:18:31,880
هينو-سان

292
00:18:31,880 --> 00:18:35,020
أنتَ أشجع ممّا تبدو عليه

293
00:18:35,020 --> 00:18:37,800
آسف على إقلاقكَ

294
00:18:37,800 --> 00:18:39,470
لكنّني أظنّ أنّكَ اتّخذتَ القرار الصّحيح

295
00:18:39,920 --> 00:18:45,600
أخبرتني الفتاة الشّقراء أنّه لا تزاوج بعد الآن ولن تسمح لي حتّى بالمغادرة

296
00:18:45,600 --> 00:18:47,960
هي أساسًا حبَستني

297
00:18:47,960 --> 00:18:50,520
،أتمنّى لو كان بإمكانكَ القدوم معنا

298
00:18:50,520 --> 00:18:53,710
لكن تعيّن علينا التّحرّك بسرعة

299
00:18:53,710 --> 00:18:59,650
حسنًا، هذه اللّوحة الإلكترونيّة مميّزة، حضّرتها مساعدتي الجميلة والموهوبة من أجلي

300
00:18:59,650 --> 00:19:04,750
إن كانتْ تستعمل اتّصال الشّبكة التحتأرضيّة فلا يستطيع ا.ن رصدها

301
00:19:04,750 --> 00:19:05,660
...و

302
00:19:06,370 --> 00:19:09,020
أعلمني ما تخطّط له بين الحين والآخر

303
00:19:09,020 --> 00:19:11,100
نعم، ابقَ آمنًا يا هينو-سان

304
00:19:11,100 --> 00:19:13,200
سلّم على ماهيرو-تشان نيابة عنّي

305
00:19:18,590 --> 00:19:23,380
أنا قلق بشأن ميزوهارا-كون، لكن أيضًا قلق على الأخريات اللّواتي لسن هنا

306
00:19:23,380 --> 00:19:24,790
كيتاياما-تشان أيضًا

307
00:19:24,790 --> 00:19:29,810
سأفعل كلّ ما بوسعي لحماية الفتيات

308
00:19:30,170 --> 00:19:33,190
أجل، أشكركِ على كلّ شيء

309
00:19:33,410 --> 00:19:38,940
أكنتَ تريد المغادرة مع ميزوهارا-ساما يا هينو-ساما؟

310
00:19:39,220 --> 00:19:40,440
لا

311
00:19:43,110 --> 00:19:47,450
لا يمكنني ترككنَّ جميعًا ورائي

312
00:19:47,700 --> 00:19:49,010
هينو-ساما

313
00:19:56,420 --> 00:20:00,670
تلك الفتاة شريكة التّزاوج للرّقم واحد

314
00:20:01,720 --> 00:20:03,220
إنّها جميلة

315
00:20:06,720 --> 00:20:09,050
سـ-سامحيني

316
00:20:09,050 --> 00:20:14,120
أكان صعبًا أن تعيدي رجلًا واحدًا إلى الوطن؟

317
00:20:14,120 --> 00:20:15,730
امنحيني فرصة أخرى

318
00:20:16,020 --> 00:20:19,860
تعلمين ما سيحدث إن فشلتِ، أليس كذلك؟

319
00:20:20,830 --> 00:20:22,530
نعم سيّدتي

320
00:20:24,380 --> 00:20:27,760
حان دوركما الآن

321
00:20:28,740 --> 00:20:33,660
كان يجب أن أراقبَ الآنسة سوو بالإضافة إلى الآنسة كاتاغيري

322
00:20:33,660 --> 00:20:36,820
كان كلّ هذا خطّتي

323
00:20:36,820 --> 00:20:39,000
لم تكن للمرافقة السّابقة سوو أيّة علاقة بهذا

324
00:20:40,020 --> 00:20:42,660
!يا لها من صداقة جميلة

325
00:20:42,660 --> 00:20:48,780
أو "صداقة" ليستِ الكلمة اليابانيّة الصّحيحة بالنّسبة لكِ؟

326
00:20:50,640 --> 00:20:53,120
خذاهما إلى زنزانتيهما

327
00:20:53,580 --> 00:20:54,290
تعاليا

328
00:20:56,900 --> 00:21:00,110
...والآن حان الوقت لخطوتنا التّالية

329
00:21:00,900 --> 00:21:03,560
في خطّة إبادة كلّ الرّجال

330
00:21:05,930 --> 00:21:07,280
هذا هو المكان

331
00:21:07,610 --> 00:21:08,570
ما هذا المكان؟

332
00:21:08,570 --> 00:21:11,280
هذه النّافذة مرآة باتّجاه واحد

333
00:21:14,700 --> 00:21:15,790
ما هذا؟

334
00:21:16,110 --> 00:21:20,540
أنا أقدّم لكَ فتاة جديدة كهديّة للاحتفال بإعادة ولادتكَ

335
00:21:21,060 --> 00:21:23,670
اختر المفضّلة لكَ من اللّواتي بالدّاخل

336
00:21:23,670 --> 00:21:25,210
من الدّاخل؟

337
00:21:26,390 --> 00:21:28,360
رأيتها البارحة

338
00:21:28,360 --> 00:21:32,810
كانتْ ممثّلة حين دخلتَ النّوم البارد

339
00:21:33,060 --> 00:21:35,900
ظننتُ أنّني رأيتها في مكان ما

340
00:21:35,900 --> 00:21:38,410
لكنّها شريكة هينو-سان، أليس كذلك؟

341
00:21:38,410 --> 00:21:44,780
حين قَدِمَ المقرّ الرّئيسسيّ العالميّ أخبر جميع الأرقام بإيقاف التّزاوج، أليس كذلك؟

342
00:21:44,780 --> 00:21:46,690
ما عدا أنتَ

343
00:21:46,990 --> 00:21:51,070
أريد منكِ أن تسمحي لشوتا-ساما بالتّزاوج بشروط معيّنة

344
00:21:51,070 --> 00:21:54,660
فهمت، إذًا هذا ما قصدتِه

345
00:21:55,410 --> 00:21:58,580
هذا العالم مدهش

346
00:21:58,830 --> 00:22:02,080
من تريدها الآن؟

347
00:22:04,490 --> 00:22:06,590
سنتوجّه إلى مكان اللّقاء

348
00:22:06,900 --> 00:22:08,210
إنّه جميل

349
00:22:09,750 --> 00:22:11,400
إنّه لا يصدّق

350
00:22:12,100 --> 00:22:13,100
عجبًا

351
00:22:13,100 --> 00:22:14,010
هذا هو المكان

352
00:22:14,840 --> 00:22:15,970
إيريسا

353
00:22:16,340 --> 00:22:18,040
هل سيتسنّى لي رؤيتكِ أخيرًا؟

354
00:22:36,690 --> 00:22:37,730
إيريسا

355
00:22:38,900 --> 00:22:40,050
ريتو

356
00:22:45,710 --> 00:22:49,150
أنا مسرورة جدًّا أنّكَ بأحسن حال يا ريتو

357
00:22:49,920 --> 00:22:52,560
أنا... أنا مسرور جدًّا أنّكِ بخير

358
00:22:55,220 --> 00:22:56,430
...كنتُ أنتظر

359
00:22:59,900 --> 00:23:01,220
لوقت طويل جدًّا

360
00:23:02,940 --> 00:23:06,650
سأطوّر علاجًا لفيروس ق.ذ يا إيريسا

361
00:23:09,400 --> 00:23:12,780
إن كان لن يجده أحد فعلينا إيجاده بأنفسنا

362
00:23:12,780 --> 00:23:16,410
وسنكون أوفر حظًا بالعمل عليه بوجود شخصين بدلا من شخص واحد فقط

363
00:23:16,410 --> 00:23:17,360
أليس كذلك؟

364
00:23:19,470 --> 00:23:20,320
بلى