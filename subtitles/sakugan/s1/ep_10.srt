1
00:00:07,620 --> 00:00:08,880
!رائع

2
00:00:08,880 --> 00:00:11,990
!إنها كبيرة جداً! وغاية في الرّوعة

3
00:00:12,280 --> 00:00:13,600
!انظر إليها فحسب يا توني

4
00:00:13,600 --> 00:00:15,450
أليست سفينة مُلفتة للنظر؟

5
00:00:16,010 --> 00:00:18,660
ما زلتِ تجرّين هذا الخروف الهرِم القذر معكِ؟

6
00:00:18,660 --> 00:00:19,730
!صُن لسانك

7
00:00:19,730 --> 00:00:22,200
،نستحمّ معاً مرّة في الشهر

8
00:00:22,200 --> 00:00:24,450
!وفي كلّ مرّة أفرك جسده بالكامل بالصّابون

9
00:00:26,890 --> 00:00:28,040
!توني

10
00:00:28,840 --> 00:00:30,080
مهلاً

11
00:00:30,580 --> 00:00:33,110
!شكراً يا ميرورو! أقدّر المساعدة

12
00:00:33,110 --> 00:00:34,340
العفو

13
00:00:34,340 --> 00:00:36,680
خذيه. إنّه مهمّ لكِ، أليس كذلك؟

14
00:00:37,420 --> 00:00:40,070
...أجل. توني هو

15
00:00:47,210 --> 00:00:49,520
،أعرف أنّهم يحترسون من شيبيتو

16
00:00:49,520 --> 00:00:52,930
لكن تبدو كلّ الأسلحة فتّاكة

17
00:00:52,930 --> 00:00:56,230
هل المكتب ذاهب لخوض حرب أو ما شابه؟

18
00:00:59,080 --> 00:01:01,540
ماذا تنويان أن تفعلا؟

19
00:01:01,820 --> 00:01:02,860
ماذا؟

20
00:01:03,450 --> 00:01:05,870
أتذكّركما من قاعدة البيانات

21
00:01:09,210 --> 00:01:10,770
لا تقلقا

22
00:01:10,770 --> 00:01:13,420
نظّفتُ سجلّكما الإجرامي بنجاح

23
00:01:13,740 --> 00:01:14,880
حقّاً؟

24
00:01:14,880 --> 00:01:16,920
!يمكنك فعل هذا يا رجل؟

25
00:01:16,920 --> 00:01:18,640
من تكون بالضبط؟

26
00:01:19,080 --> 00:01:21,850
ما الّذي جاء بك إلى هنا على أيّ حال؟

27
00:01:22,210 --> 00:01:24,640
خلاص العالم بالطبع

28
00:03:05,660 --> 00:03:09,930
نحن من مكتب التّنظيم، منذ أيّام
،العالم السّفلي الأولى

29
00:03:09,930 --> 00:03:12,460
،حمينا المُستوطنات الّتي تحفظ ثقافتنا الجميلة

30
00:03:12,460 --> 00:03:16,750
والمتاهة التي تصون طبيعتنا الوافرة

31
00:03:16,750 --> 00:03:18,040
عمّاذا يتكلّم؟

32
00:03:18,040 --> 00:03:18,920
لا تسأليني

33
00:03:19,760 --> 00:03:21,680
أوّلاً، المستوطنات

34
00:03:21,680 --> 00:03:24,290
كما تعلمون، حكم المستوطنات

35
00:03:24,290 --> 00:03:27,640
تتولّاه أميرة مُرسَلة من قِبل مركز القيادة

36
00:03:27,940 --> 00:03:30,500
على الأقلّ، هذه هي الرّواية الرسمية

37
00:03:30,870 --> 00:03:34,310
في الواقع، مكتب التّنظيم يدير كلّ شيء

38
00:03:34,310 --> 00:03:36,640
!هل سبق والتقيت بأميرة؟

39
00:03:36,640 --> 00:03:39,170
عدّة مرّات خلال مسار عملي

40
00:03:40,080 --> 00:03:42,020
!أنت رهيب حقّاً

41
00:03:42,020 --> 00:03:44,370
هذا لا يعني شيئاً صدّقني

42
00:03:44,370 --> 00:03:45,450
...والآن

43
00:03:45,820 --> 00:03:50,030
المستوطنات الّتي ننظّمها ونديرها
:تؤدّي غرضين أساسيّين

44
00:03:50,030 --> 00:03:54,080
،كملجأ للبشريّة من المخاطر الطبيعيّة للمتاهة

45
00:03:54,080 --> 00:03:58,590
وكمخازن للحضارة البشريّة

46
00:03:59,090 --> 00:04:01,040
،بوضع هذين الهدفين في الحسبان

47
00:04:01,040 --> 00:04:05,690
نراقب مراقبة حثيثة سكّان المستوطنات
،من خلال رقاقات مزروعة

48
00:04:05,690 --> 00:04:08,310
ونحدّ السّفر بين المستوطنات

49
00:04:08,310 --> 00:04:11,700
إذاً نحن سجناء داخل مستوطناتنا، صحيح؟

50
00:04:11,700 --> 00:04:14,270
لا أنكر أنّ حرّيتكم مُقيّدة

51
00:04:14,270 --> 00:04:18,700
لكن المكتب يوفّر أكثر من طعام وسلع كافية

52
00:04:18,700 --> 00:04:21,500
لضمان نمط حياة مُريح للجميع

53
00:04:21,500 --> 00:04:25,750
لو كان ذلك كافياً للناس، لما كان هناك مُنقّبين

54
00:04:25,750 --> 00:04:28,940
لو كنّا نستطيع ضمان عدم شقّ
أحد طريقه إلى داخل المتاهة

55
00:04:28,940 --> 00:04:30,590
،والحفر في جدرانها

56
00:04:30,590 --> 00:04:33,410
لكنّا أكثر تساهلاً بالطبع

57
00:04:33,410 --> 00:04:36,630
أليس كذلك يا قوّة العاصفة غاغمبر؟

58
00:04:36,870 --> 00:04:40,500
هل تسخر منّي من جديد؟

59
00:04:40,500 --> 00:04:43,260
لا، إنّها مُعضلة حقّاً

60
00:04:44,030 --> 00:04:48,060
،لأنّه في حين أنّ المتاهة هي محميّة طبيعيّة

61
00:04:48,060 --> 00:04:50,340
،إنّها في نفس الوقت نظام دورانيّ هائل

62
00:04:50,340 --> 00:04:52,860
تولّد الماء والأكسجين وبقيّة المواد العضويّة الأساسيّة

63
00:04:52,860 --> 00:04:55,280
التي يحتاجها العالم السّفلي

64
00:04:55,760 --> 00:05:02,280
تمرّ الأنابيب من كلّ مكان لتنقل الأنيموس إلى المُستوطنات

65
00:05:02,780 --> 00:05:05,030
هذه هي خطوط الأنيموس التي تألفونها

66
00:05:06,520 --> 00:05:12,120
لكن المخاطر المُحتملة على البشريّة
،تتطوّر في العالم السّفلي

67
00:05:12,120 --> 00:05:15,140
ليضع وجودها المستمرّ في موضع شكّ

68
00:05:15,460 --> 00:05:17,860
"نطلق على هذا "الكارثة العظيمة

69
00:05:18,460 --> 00:05:20,210
...زلازل دائمة

70
00:05:20,210 --> 00:05:23,260
...سيول تفيض عبر الشّقوق في الجدران

71
00:05:23,260 --> 00:05:25,280
...تدهور مُنشآت التحكّم

72
00:05:27,470 --> 00:05:30,250
والتصحّر وحرائق الغابات والمزيد

73
00:05:30,900 --> 00:05:36,880
ينجم عن هذا تغيّرات إجماليّة أعظم في المناخ

74
00:05:37,320 --> 00:05:41,000
فضلاً عن ذلك، شوهِد كايجو ضمن المستوطنات

75
00:05:42,570 --> 00:05:48,490
كلّ هذا بدأ في السّنوات الأخيرة مع
بدء الكارثة العظيمة

76
00:05:48,490 --> 00:05:50,700
،لمعرفة السّبب بصورة واضحة

77
00:05:50,700 --> 00:05:53,720
شكّلَ مكتب التّنظيم فرقاً للتعامل مع الأمر

78
00:05:54,120 --> 00:05:59,760
لكن لا نرى أيّ سبب مُحتمل في الوقت
الرّاهن غير قوّة خارجيّة

79
00:06:00,330 --> 00:06:02,230
،إن لم يتمّ التعامل مع الأمر

80
00:06:02,230 --> 00:06:04,370
فلن يتمكّن العالم من الحفاظ على وضعه الحالي

81
00:06:04,370 --> 00:06:05,880
سيتغيّر الوضع الرّاهن بشكل جذريّ

82
00:06:06,550 --> 00:06:09,300
أحبّ العالم الذي نعيش فيه

83
00:06:09,300 --> 00:06:13,400
لهذا أتمنّى أن أصونه بوضعه الحالي

84
00:06:13,760 --> 00:06:15,020
يبدو هذا سخيفاً

85
00:06:15,020 --> 00:06:19,460
سأموت من الملل إذا بقي العالم حولي كما هو

86
00:06:19,460 --> 00:06:20,550
صحيح؟

87
00:06:20,550 --> 00:06:23,570
بالطبع، من المهمّ السّماح بدرجة من التّغيير

88
00:06:23,570 --> 00:06:28,040
،لكن العالم الّذي نعيش فيه مُتّزن بشكل دقيق

89
00:06:28,040 --> 00:06:30,860
جنزير لا يُكسَر ينتقل من جيل لآخر

90
00:06:30,860 --> 00:06:35,080
الحفاظ على الوضع الرّاهن هو أفضل
خيار للبشريّة جمعاء

91
00:06:35,080 --> 00:06:38,410
أجل، أمثالكم يحبّون فرض مُثُلهم فحسب

92
00:06:38,680 --> 00:06:41,830
لكن أعيش حياة سهلة رغيدة، لذا لا تتدخّل

93
00:06:41,830 --> 00:06:46,880
"لكن هل هذه الحياة "السّهلة الرّغيدة
غير مبنيّة على ما حدث في السّابق؟

94
00:06:46,880 --> 00:06:49,260
ماذا؟ مُحال

95
00:06:49,260 --> 00:06:51,240
لا، إنّه محقّ

96
00:06:52,120 --> 00:06:55,070
توني مُنهَك ومُرقّع

97
00:06:55,070 --> 00:06:59,440
لكن هذه نتيجة الأيّام التي قضيناها معاً

98
00:06:59,440 --> 00:07:01,340
لهذا هو مهمّ بالنسبة لي

99
00:07:01,340 --> 00:07:06,280
وأنا أحرص على نظافة رفيقي الرّوبوت
ديثهارت وذلك كي يعيش وقتاً طويلاً

100
00:07:06,280 --> 00:07:08,710
هذا الشّعور يُترجَم إلى الرّغبة في حماية الثّقافة

101
00:07:08,710 --> 00:07:11,420
بل وحتّى العالم

102
00:07:11,420 --> 00:07:13,880
لستُ أفهم فحسب

103
00:07:13,880 --> 00:07:16,780
بالطبع، البعض قد لا يفهم ذلك أبداً

104
00:07:17,100 --> 00:07:20,810
،والبعض الآخر منهم قد يتمسّك بمُثُل مُلتوية

105
00:07:20,810 --> 00:07:23,210
ويقوم بأفعال خطيرة نتيجة ذلك

106
00:07:23,210 --> 00:07:25,460
نطلق عليهم شيبيتو

107
00:07:25,960 --> 00:07:30,220
شيبيتو هي مجموعة إرهابيّة مُضادّة
للنُظُم ومُضادّة للمكتب

108
00:07:31,090 --> 00:07:33,450
"باسم "تحرير الجماهير

109
00:07:33,450 --> 00:07:37,260
يسرقون الكهرباء وينشرون الفوضى في المُستوطنات

110
00:07:37,260 --> 00:07:41,850
!لكن يبقى شيبيتو أبطال العدالة! إنّهم رجال حقيقيّون

111
00:07:42,640 --> 00:07:45,600
تمادوا لدرجة أنّهم تدخّلوا بالأميرات

112
00:07:45,600 --> 00:07:47,710
اللّواتي يمثّلن المستوطنات

113
00:07:48,380 --> 00:07:52,610
لهذا نعارضهم بشدّة

114
00:07:54,390 --> 00:07:57,560
من الواضح بأنّك شغوف بعملك

115
00:07:57,560 --> 00:08:01,290
لكن ما الّذي تتأمّل إنجازه بإظهار كلّ هذا لنا؟

116
00:08:03,640 --> 00:08:10,480
أردتُكم أن تعرفوا ما يجري في عالمنا

117
00:08:11,220 --> 00:08:15,590
وثمّة شيء آخر أريدكم أن تروه

118
00:08:16,050 --> 00:08:19,110
هل تعرفون ما هذا؟

119
00:08:21,510 --> 00:08:25,250
التركيبة اللولبيّة المُزدوجة للحمض النووي الرّيبي؟

120
00:08:25,250 --> 00:08:26,270
أجل

121
00:08:26,560 --> 00:08:28,290
أنتِ ذكيّة حقّاً

122
00:08:28,290 --> 00:08:29,860
ماذا تكون؟

123
00:08:29,860 --> 00:08:32,110
إنّها مُخطّط كلّ الحياة

124
00:08:32,600 --> 00:08:35,580
تصون هذه السّفينة الحيوانات والنّباتات

125
00:08:35,580 --> 00:08:38,580
الّذين فقدوا مواطنهم في الكارثة العظيمة

126
00:08:38,580 --> 00:08:42,040
الصّون المُستمرّ للذريّة والعائلات

127
00:08:42,300 --> 00:08:44,200
والرّوابط بين الآباء والأبناء

128
00:08:44,200 --> 00:08:47,000
مُهمّ وثمين بقدر أهمّية حفظ الثّقافة والطبيعة

129
00:08:47,000 --> 00:08:50,570
حماية كلّ شيء، وتركه لأجيال المستقبل

130
00:08:50,920 --> 00:08:53,720
هذا هو واجب مكتب التّنظيم

131
00:08:53,720 --> 00:08:55,950
!إنّه خلاص العالم

132
00:08:55,950 --> 00:08:57,220
خلاص؟

133
00:08:57,220 --> 00:08:59,120
هذا أمر جلل فعلاً

134
00:08:59,120 --> 00:09:00,180
بالفعل

135
00:09:09,390 --> 00:09:13,070
لدى خنازير الماء روابط عائليّة متينة جدّاً

136
00:09:13,700 --> 00:09:16,280
الآباء والبالغون الآخرون من القطيع يتجمّعون

137
00:09:16,280 --> 00:09:18,530
لحماية ورعاية الأبناء

138
00:09:19,040 --> 00:09:24,250
حبّ التضحية بالذات الّذي يُظهرونه
يشترك تماماً مع مهمّتنا

139
00:09:24,250 --> 00:09:26,040
يبدو هذا خانقاً بالنسبة لي

140
00:09:26,040 --> 00:09:28,400
يقول البعض أنّ تلقّي الحبّ من الوالدين

141
00:09:28,400 --> 00:09:30,610
هو ما يسمح للأبناء الحفاظ على احترام الذّات

142
00:09:30,610 --> 00:09:32,910
لا، يكتشفون هذا الهراء من تلقاء أنفسهم

143
00:09:32,910 --> 00:09:38,430
أليس دور الآباء هو توجيه أبنائهم الأحبّاء نحو البلوغ؟

144
00:09:38,430 --> 00:09:40,540
!المعذرة! أنا أب

145
00:09:40,540 --> 00:09:43,490
!لا أتلقّى محاضرات من شخص بلا أبناء

146
00:09:43,490 --> 00:09:45,600
كانت لديّ زوجة وطفل أيضاً

147
00:09:45,600 --> 00:09:48,060
ماذا؟ هُجِرت أيضاً؟

148
00:09:48,060 --> 00:09:50,940
،قادتنا الظروف إلى انفصالنا في الوقت الحاضر

149
00:09:50,940 --> 00:09:54,800
لكن ما زلتُ أنوي فعل كلّ ما باستطاعتي كأب

150
00:09:54,800 --> 00:09:56,780
!يا لها من عناية مُفرِطة

151
00:09:56,780 --> 00:09:58,680
ماذا عنك؟

152
00:09:59,620 --> 00:10:03,110
يبدو أنّك ترفض فكرة التّعبير عن
الحبّ من خلال العناية

153
00:10:03,110 --> 00:10:06,330
لكن أسألك، لماذا رافقتها في رحلتها؟

154
00:10:08,140 --> 00:10:11,480
لديها خصلة استقلاليّة شديدة

155
00:10:11,480 --> 00:10:13,940
أنا متأكّد أنّها نوت السّفر من تلقاء نفسها

156
00:10:14,270 --> 00:10:16,760
مع ذلك لم تسمح بالأمر

157
00:10:16,760 --> 00:10:19,320
،سواء كنت وقائيّاً زيادة عن اللّزوم أو عديم التدخّل

158
00:10:19,320 --> 00:10:23,220
أب مثلك استطاع أن يجازف بتطوّر ميميمبو

159
00:10:24,640 --> 00:10:27,920
مَن منّا والد جيّد حقيقيّ؟

160
00:10:33,820 --> 00:10:36,830
قُل ما تشاء أيّها الوغد

161
00:10:38,510 --> 00:10:39,530
ها أنتِ ذي

162
00:10:39,900 --> 00:10:43,950
أبله. إنّها تكره الأشخاص الّذين يمسكونها هكذا

163
00:10:43,950 --> 00:10:46,120
!شكراً يا ميرورو

164
00:10:46,120 --> 00:10:48,340
!يمكنني الاعتماد عليك دوماً

165
00:10:49,830 --> 00:10:52,290
هل يتشبّه الأبناء بآبائهم دوماً؟

166
00:10:52,290 --> 00:10:53,830
سؤال ممتاز

167
00:10:53,830 --> 00:10:57,890
بالطبع، يرِث الابن نصف مورّثاته من كُل أب

168
00:10:57,890 --> 00:10:59,460
الحمض الرّيبي وما شابه، صحيح؟

169
00:10:59,460 --> 00:11:02,140
إذاً ميميمبو ورثت نصفاً منك يا أخي؟

170
00:11:02,140 --> 00:11:06,080
!ليت ميرورو كان أبي بدلاً عنه

171
00:11:07,560 --> 00:11:08,760
!ميرورو

172
00:11:08,760 --> 00:11:11,470
!أرِني ماذا يوجد داخل تلك الحاويات الكبيرة

173
00:11:11,470 --> 00:11:13,960
حسناً. دعيني أرافقكِ

174
00:11:13,960 --> 00:11:16,150
!أنا أيضاً! أريد أن أرى أيضاً

175
00:11:33,710 --> 00:11:36,800
!ليت ميرورو كان أبي بدلاً عنه

176
00:11:42,490 --> 00:11:45,610
ما الّذي تراه في ذلك المتأنّق المُغترّ؟

177
