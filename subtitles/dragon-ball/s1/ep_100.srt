1
00:01:51,590 --> 00:01:52,770
!اللعنة

2
00:01:52,770 --> 00:01:54,670
!ما زلت تُقاتل بقذارة

3
00:01:54,670 --> 00:01:57,170
!توقف عن تذمّرك السخيف

4
00:01:57,170 --> 00:01:58,660
!مُت

5
00:02:15,130 --> 00:02:16,110
!الآن

6
00:02:16,330 --> 00:02:17,650
!اقتله

7
00:02:17,820 --> 00:02:19,130
...اقتله حالًا

8
00:02:19,310 --> 00:02:20,220
!يا تين

9
00:02:21,930 --> 00:02:23,350
!توقّف عن هذا

10
00:02:34,960 --> 00:02:38,210
بعد أن هجر معلمه ناسك الكركي

11
00:02:38,450 --> 00:02:42,450
لقد استيقظ وعي تينشينهان كمقاتل

12
00:02:43,080 --> 00:02:47,510
...وتقنيته القادمة التي أخرجها لكي يحقّق النصر

13
00:03:16,850 --> 00:03:18,520
!هذا مستحيل

14
00:03:18,520 --> 00:03:19,990
!يداه

15
00:03:58,510 --> 00:03:59,760
!يداه

16
00:03:59,760 --> 00:04:01,020
!أنت تمزح, صحيح؟

17
00:04:07,420 --> 00:04:09,710
!يا لها من مفاجأة

18
00:04:09,820 --> 00:04:13,270
!المتسابق تينشينهان لديه الآن أربعة أذرع

19
00:04:13,710 --> 00:04:16,800
!يا له من سحر لا يصدّق

20
00:04:18,510 --> 00:04:19,360
!جهّز نفسك

21
00:04:19,480 --> 00:04:20,950
!لقد أدهشتني

22
00:04:21,250 --> 00:04:23,380
!لا أصدق بأنك تستطيع إنشاء أيديّ

23
00:04:23,530 --> 00:04:25,590
!سأعطيك ضعف عدد اللكمات كهدية

24
00:05:11,190 --> 00:05:12,160
!مُدهش

25
00:05:12,680 --> 00:05:14,790
!يبدو وكأنه يقاتل شخصين

26
00:06:00,110 --> 00:06:01,190
!هذا سيء

27
00:06:13,080 --> 00:06:15,190
!والآن أنت حرفيًا لا يمكنك تحريك عضلة

28
00:06:27,080 --> 00:06:28,280
!غوكو

29
00:06:28,780 --> 00:06:29,930
!لقد انتصر

30
00:06:54,910 --> 00:06:57,880
لا يمكنني أن أحرك يديّ وساقيّ
!ولكن يمكنني أن أحرك ذيلي

31
00:07:16,790 --> 00:07:19,920
!المتسابق تين قد أفلته

32
00:07:21,190 --> 00:07:22,050
!اللعنة

33
00:07:22,050 --> 00:07:24,160
!هكذا إذن... أنت تملك ذيل

34
00:07:25,250 --> 00:07:27,760
...إذا كان لديك أربعة أذرع فأنا

35
00:07:28,510 --> 00:07:29,530
!يمكنني أن أملك ثمانية

36
00:07:29,990 --> 00:07:30,850
!ماذا؟

37
00:07:40,110 --> 00:07:42,450
لا تقل لي حتى هو أيضًا؟

38
00:07:52,450 --> 00:07:54,990
!ما هذا؟ إنه شيءٌ مخيف

39
00:08:08,050 --> 00:08:09,930
!هذا مُذهل

40
00:08:10,790 --> 00:08:12,620
!لست سيئًا يا سون-كن

41
00:08:14,620 --> 00:08:20,180
!سون... نسخ ما فعله تين ولديه الآن ثمانية أذرع

42
00:08:29,080 --> 00:08:31,310
لماذا غوكو قادرٌ على فعل ذلك؟

43
00:09:07,650 --> 00:09:09,880
!يا له من تصادم رهيب

44
00:09:10,850 --> 00:09:11,710
!غوكو

45
00:09:12,050 --> 00:09:13,250
!تين-سان

46
00:09:22,050 --> 00:09:22,910
!سون-كن

47
00:09:30,390 --> 00:09:32,280
!كلا المقاتلان قد سقطا

48
00:09:33,310 --> 00:09:34,680
!انهض يا غوكو

49
00:09:34,790 --> 00:09:35,880
!انهض

50
00:09:40,110 --> 00:09:42,110
...سأبدأ بالعد

51
00:09:42,110 --> 00:09:43,080
!واحد

52
00:09:43,360 --> 00:09:44,450
!إثنان

53
00:09:50,560 --> 00:09:52,740
!هذا مثل ما حصل في البطولة السابقة

54
00:10:31,310 --> 00:10:32,510
!ثلاثة

55
00:10:33,080 --> 00:10:34,390
!أربعة

56
00:10:35,710 --> 00:10:37,650
!خمسة

57
00:10:38,220 --> 00:10:39,290
!ستة

58
00:10:39,290 --> 00:10:41,590
!انهض! بسرعة

59
00:10:41,710 --> 00:10:44,260
!انهض! انهض حالًا

60
00:10:44,680 --> 00:10:46,910
!سبعة

61
00:10:47,250 --> 00:10:50,390
!ثمانية

62
00:10:50,620 --> 00:10:53,670
!تسعة

63
00:10:56,910 --> 00:10:58,110
!لقد نهض

64
00:11:01,650 --> 00:11:04,510
!كلا المقاتلان نهضا عند العد تسعة

65
00:11:04,510 --> 00:11:06,520
!يا لها من إرادة رائعة

66
00:11:06,680 --> 00:11:08,460
!لقد فعلها

67
00:11:14,160 --> 00:11:15,930
!لا يزال لدي الكثير

68
00:11:16,960 --> 00:11:18,390
!وأنا كذلك

69
00:11:22,510 --> 00:11:24,280
!المباراة الأفضل

70
00:11:56,330 --> 00:11:58,560
!هذا حقًا صراع مستميت

71
00:13:10,380 --> 00:13:11,350
!هذا رائع

72
00:13:11,350 --> 00:13:12,320
!لقد فعلها

73
00:13:14,660 --> 00:13:20,050
المتسابق سون... استخدم فتحة مختصرة
!للإمساك بقدميّ المتسابق تينشينهان

74
00:13:44,490 --> 00:13:48,380
!والآن كلا المقاتلان يتقاتلا بقوة غاشمة

75
00:13:48,380 --> 00:13:50,410
!من سيتقدم أولًا؟

76
00:13:52,200 --> 00:13:53,180
!سون-كن

77
00:13:53,510 --> 00:13:56,180
!اقضي عليه! مزّقه إربًا

78
00:13:56,180 --> 00:13:59,840
!دعني أو ستموت

79
00:14:01,400 --> 00:14:02,890
!لن أدعك أبدًا

80
00:14:09,630 --> 00:14:11,000
!أنتم! انظروا

81
00:14:20,830 --> 00:14:21,750
!لقد اختفت

82
00:14:28,380 --> 00:14:29,580
لماذا؟

83
00:14:30,510 --> 00:14:35,640
السبب على الأغلب أن
!الألم قد أضعف قوته في التركيز

84
00:14:46,200 --> 00:14:47,580
!ابذل جهدك يا غوكو

85
00:14:47,580 --> 00:14:49,400
!لا تخسر يا تينشينهان

86
00:14:55,060 --> 00:14:56,030
...عذرًا

87
00:14:56,030 --> 00:14:58,030
...يمكنك أن تستسلم إن كنت ترغب في ذلك

88
00:14:58,150 --> 00:14:59,520
!لا تكن غبيًا

89
00:14:59,520 --> 00:15:01,520
!أفضل الموت بدلًا من الإعتراف بالهزيمة

90
00:15:02,150 --> 00:15:03,520
!تين-سان

91
00:15:06,260 --> 00:15:07,630
!توقف يا تشاوزو

92
00:15:11,690 --> 00:15:13,630
!سأهزم هذا الشخص بنفسي

93
00:15:14,890 --> 00:15:15,750
...نعم

94
00:15:17,690 --> 00:15:18,890
!شاهد فقط

95
00:15:53,120 --> 00:15:54,890
!غوكو

96
00:15:55,230 --> 00:15:56,090
!انتظر

97
00:16:01,690 --> 00:16:02,660
...حاضر

98
00:16:10,260 --> 00:16:11,350
!تين-سان

99
00:16:12,660 --> 00:16:14,030
!إنه هجوم مضاد

100
00:16:14,260 --> 00:16:19,030
المتسابق تين قد عكس
!بشكل مُذهل هجوم المتسابق سون

101
00:16:27,630 --> 00:16:28,940
!غوكو

102
00:16:35,120 --> 00:16:36,550
!أنت حقًا شخص عنيد

103
00:16:36,950 --> 00:16:38,260
وأنت كذلك أيها اللعين

104
00:16:40,490 --> 00:16:43,000
!أنت شخص مميز! وأعني ذلك حقًا

105
00:16:43,580 --> 00:16:46,360
!أنا لم أفكر قط بأنك ستدفعني لهذه الدرجة

106
00:16:46,720 --> 00:16:48,870
!لم أكن أريد أن استخدم هذه التقنية

107
00:16:49,120 --> 00:16:50,720
!ما هي نوع التقنية هذه المرة؟

108
00:16:51,180 --> 00:16:52,600
سأقوم بتحذيرك مقدمًا

109
00:16:52,780 --> 00:16:54,470
إذا تلقيت هذه التقنية مباشرة

110
00:16:54,720 --> 00:16:57,000
!حتى أنت أيها اللعين ستموت

111
00:16:57,980 --> 00:16:58,720
!ماذا؟

112
00:17:00,200 --> 00:17:01,920
أنا لا أريد أن أقتلك

113
00:17:02,330 --> 00:17:05,060
لهذا تفاداها! هل فهمت؟

114
00:17:06,890 --> 00:17:08,150
يتفاداها؟

115
00:17:08,260 --> 00:17:10,780
...يا له من شخص مخادع غريب

116
00:17:11,520 --> 00:17:12,780
!لا تقل لي

117
00:17:12,830 --> 00:17:14,390
!إنها الكيكوهو

118
00:17:12,830 --> 00:17:14,390
كيكوهو : مدفع الطاقة

119
00:17:14,490 --> 00:17:16,380
!تين-سان! توقّف

120
00:17:16,490 --> 00:17:17,490
!يبدو أنها هي

121
00:17:17,750 --> 00:17:20,560
!لا تفعلها يا تينشينهان! هل تريد أن تموت؟

122
00:17:20,780 --> 00:17:21,980
ما هذه؟

123
00:17:27,020 --> 00:17:29,390
!من كان يعتقد بأنه قادر على القيام بالكيكوهو

124
00:17:29,390 --> 00:17:32,360
...موتين روشي-ساما! ماذا بحقّ

125
00:17:32,490 --> 00:17:35,010
...إنها تقنية مدمرة بشكل هائل

126
00:17:35,290 --> 00:17:37,180
"أكثر بكثير من "الكاميهاميها

127
00:17:37,360 --> 00:17:39,900
...ولكن لأنها قوية جدًا

128
00:17:40,150 --> 00:17:44,380
يمكن للمستخدم أن يموت بسبب خسارته لطاقة كبيرة

129
00:17:45,180 --> 00:17:48,430
وحتى لو لم تمُت, فسوف تقلل من عمرك

130
00:17:50,660 --> 00:17:52,660
...ناسك الكركي ذلك اللعين

131
00:17:53,350 --> 00:17:55,630
!علمه تقنيات لم يكن عليه تعلمها

132
00:17:57,460 --> 00:17:59,340
!لا, لا تفعلها أبدًا

133
00:17:59,520 --> 00:18:02,860
!لا تقلق! لن أفعلها بكامل قوتي

134
00:18:02,950 --> 00:18:04,700
!أنا لن أموت

135
00:18:18,380 --> 00:18:20,890
!المتسابق تين يطفو في السماء

136
00:18:21,080 --> 00:18:23,710
!هل فهمت؟ من الأفضل لك أن تتفاداها

137
00:18:23,790 --> 00:18:25,960
!توقف! لقد قلت لك أن تتوقف

138
00:18:26,260 --> 00:18:28,230
!ما الذي يخطط للقيام به؟

139
00:18:28,260 --> 00:18:30,830
!لم أتمكن من سماع ما يُقال

140
00:18:31,060 --> 00:18:33,800
المتسابق تينشينهان قد استخدم تقنية
الطيران لمدرسة ناسك الكركي

141
00:18:33,800 --> 00:18:36,900
!ليرتفع إلى الهواء! من أجل ماذا بالضبط؟

142
00:18:37,760 --> 00:18:40,490
!هل فهمت؟ تفاداها مهما كلف الأمر

143
00:18:40,490 --> 00:18:44,160
!كفاك مزاحًا! أنا أكره الهروب

144
00:18:44,200 --> 00:18:45,980
!هذا ليس الوقت المناسب لتكون عنيدًا غبيًّا

145
00:18:46,150 --> 00:18:48,250
!افعل ما يقوله وتفاداها

146
00:18:48,430 --> 00:18:50,430
!تين-سان! لا تمُت

147
00:18:50,430 --> 00:18:52,600
!ما الذي يُخطّط لفعله؟

148
00:18:52,600 --> 00:18:55,830
!يبدو أنها تقنية مُذهلة

149
00:18:56,030 --> 00:18:56,890
!غوكو

150
00:18:58,150 --> 00:19:00,060
...لكن يا موتين روشي-ساما

151
00:19:00,060 --> 00:19:03,870
لماذا يستخدم تقنية تهدّد حياته
ويقول لغوكو بأن يتفاداها؟

152
00:19:03,860 --> 00:19:06,260
ذلك الشخص... ما الذي يفكّر به؟

153
00:19:06,950 --> 00:19:09,570
!أنا لا أعرف ما تنوي به ولكن... أرني ما لديك

154
00:19:09,860 --> 00:19:11,000
!سأقوم بتصدّيها

155
00:19:11,920 --> 00:19:15,510
ذلك الشخص يمكن أن
يطفو في الهواء بتقنية البوكوجتسو

156
00:19:15,800 --> 00:19:18,780
على الأغلب بأن هدفه هو خسارة
!غوكو بسقوطه خارج الحلبة

157
00:19:20,030 --> 00:19:21,060
!ها أنا ذا

158
00:19:41,460 --> 00:19:43,310
!يداه بدأت تتوهّج

159
00:19:43,630 --> 00:19:46,380
!إنه يركّز كل طاقة جسده الى يديه

160
00:19:47,580 --> 00:19:48,950
!يا لها من طاقة مُذهلة

161
00:19:49,130 --> 00:19:53,360
!هدفي هو... حلبة القتال

162
00:19:58,030 --> 00:20:00,600
إن استخدمت كل طاقتي الآن

163
00:20:00,780 --> 00:20:02,600
!فلن يتبقى لي أي قوة

164
00:20:02,950 --> 00:20:05,450
...يجب أن أبقي لنفسي طاقة بما يكفي

165
00:20:10,600 --> 00:20:12,730
!!كيكوهو

166
00:20:16,430 --> 00:20:18,410
!تفاداها يا غوكو

167
00:20:18,660 --> 00:20:19,910
!سيدي الإله

168
00:20:20,150 --> 00:20:21,060
!احذر

169
00:20:53,120 --> 00:20:54,440
!هل أنت بخير يا بولما؟

170
00:20:54,600 --> 00:20:55,460
...نعم

171
00:21:05,000 --> 00:21:06,600
...أكان ذلك

172
00:21:07,470 --> 00:21:10,470
!حلبة القتال! قد اختفت

173
00:21:18,600 --> 00:21:21,910
!ما الذي حدث بحقّ؟

174
00:21:22,320 --> 00:21:26,430
!حلبة القتال قد تبخّرت في غمضة عين

175
00:21:26,490 --> 00:21:29,050
!إنها حقًا مدمرة بشكل لا يصدّق

176
00:21:29,400 --> 00:21:31,120
!الكاميهاميها لا تقارن بها أبدًا

177
00:21:31,580 --> 00:21:33,290
!أين هو غوكو؟

178
00:21:36,830 --> 00:21:37,980
!لقد اختفى

179
00:21:44,030 --> 00:21:45,520
!لقد اختفى غوكو

180
00:21:46,380 --> 00:21:48,200
!لقد تبخّر أيضًا

181
00:21:52,320 --> 00:21:53,460
!هذا مُحال

182
00:22:14,780 --> 00:22:19,360
هل غوكو... حقًا اختفى؟

183
00:22:33,330 --> 00:22:38,420
فريق دراغون بول بالعربي

184
00:22:44,890 --> 00:22:47,660
تعال, أيها الخيال

185
00:22:47,660 --> 00:22:50,290
أنا أحب الغموض

186
00:22:50,290 --> 00:22:56,670
إياك أن تذهب وتخفي شبابك

187
00:22:56,670 --> 00:22:59,670
الرغبة بالدخول في الغموض

188
00:22:59,670 --> 00:23:02,310
والرغبة بالدخول في المغامرة

189
00:23:02,310 --> 00:23:08,480
هو ما يجعل الجميع متحمسًا

190
00:23:08,480 --> 00:23:14,480
إن تظاهرت بالبلوغ واستسلمت

191
00:23:14,480 --> 00:23:20,490
لن تعرف اللغز الموجود خلف المعجزات

192
00:23:20,490 --> 00:23:31,670
امضي الآن وحاول أن تكون جامحًا وقويًا أكثر

193
00:23:31,670 --> 00:23:39,310
سأهديك حبي, سأهديك حبي

194
00:23:39,310 --> 00:23:43,680
إن أريتني شجاعتك الحقيقية

195
00:23:43,680 --> 00:23:51,050
سأهديك حبي, سأهديك حبي

196
00:23:51,050 --> 00:23:59,830
سأهدي قلبك النابض حلمًا لامعًا وبراقا

197
00:24:12,980 --> 00:24:14,350
!ه-هنا كوريرين

198
00:24:15,550 --> 00:24:17,480
!غوكو قد ظهر

199
00:24:18,020 --> 00:24:19,720
...ه-هو لا يمكن

200
00:24:19,720 --> 00:24:22,190
كلا, هو لم يمت بعد

201
00:24:24,420 --> 00:24:25,830
كما هو متوقع

202
00:24:25,830 --> 00:24:29,730
!ولكن حان الوقت لتحديد الفائز في هذا القتال

203
00:24:29,730 --> 00:24:30,790
!أنا لن اخسر

204
00:24:31,470 --> 00:24:33,070
: الحلقة القادمة من دراغون بول

205
00:24:33,070 --> 00:24:35,440
!!...نهاية البطولة! وبعد ذلك

206
00:24:35,440 --> 00:24:36,740
!لا تفوتوها