1
00:00:09,150 --> 00:00:10,580
!ما هذا؟

2
00:00:11,840 --> 00:00:13,700
...تُسحب الطاقة من مكان ما

3
00:00:13,700 --> 00:00:15,240
!ما هذه القوّة؟

4
00:00:29,840 --> 00:00:34,060
!لا بدّ أنها أتت لمساعدتنا مثل السابق تماما

5
00:00:34,620 --> 00:00:38,350
ما الذي أصاب جسدي؟

6
00:00:38,350 --> 00:00:42,680
هل أنت مستعدّ لإظهار قوة الإلاهة في المعركة؟

7
00:00:42,680 --> 00:00:46,470
.يبدو أنها تريدني أن أفعلها بنفسي هذه المرة

8
00:00:46,470 --> 00:00:47,630
!هذا يناسبني

9
00:00:47,630 --> 00:00:51,940
ما هذا؟ موساشي هو الذي يتحكم بها
هذه المرة وليس الإلاهة؟

10
00:00:51,940 --> 00:00:54,170
...وشعره مختلف عن السابق

11
00:00:54,490 --> 00:00:55,670
!إنه ذهبيّ

12
00:00:56,650 --> 00:00:59,790
!يجب أن تكون إلاهة السبج سوداء اللون

13
00:01:01,880 --> 00:01:04,540
!يقوم بجمع طافة الجميع بسيف الكيتيتسو أيضا

14
00:01:04,810 --> 00:01:09,300
إن لم تستطع السيطرة على كل طاقات السيف
!فأنت غير مكتمل

15
00:01:09,300 --> 00:01:10,780
.هذا منطقيّ

16
00:01:10,780 --> 00:01:15,130
.شرب موساشي خمس دم الإلاهة

17
00:01:15,640 --> 00:01:18,440
.لذا لا يمكنه الحصول سوى على خمس قوتها

18
00:01:22,300 --> 00:01:24,440
!أسلوب كانيماكي إيشين

19
00:01:24,710 --> 00:01:27,280
!أنا وجود أسمى

20
00:01:29,980 --> 00:01:32,570
!تماسك يا إنما نو أوداتشي

21
00:01:32,570 --> 00:01:35,100
!إلاهة السبج الحقيقية

22
00:01:40,620 --> 00:01:42,250
!ذراعه

23
00:01:42,250 --> 00:01:43,250
...انتهى الأمر

24
00:01:43,750 --> 00:01:44,740
!فلتمت

25
00:01:49,650 --> 00:01:52,550
!بإصبعه؟

26
00:01:53,140 --> 00:01:56,880
مستحيل! كيف يمكنك فعل ذلك باستخدام
!سيف الكيتيتسو فحسب؟

27
00:01:57,530 --> 00:02:00,340
...أجل

28
00:02:00,340 --> 00:02:05,680
،لاحظت أنّ قوى الجميع تسري بداخلي وليس بداخل السيف

29
00:02:05,680 --> 00:02:08,030
.لذلك حاولت تركيزها في يدي اليمنى

30
00:02:11,920 --> 00:02:12,950
ما هذا؟

31
00:02:13,240 --> 00:02:14,890
...إنه يحسّن من جسده

32
00:02:15,380 --> 00:02:17,070
!تقنية بوشي أصفر

33
00:02:18,350 --> 00:02:22,220
ما الذي سأفعله بذراعي اليسرى؟

34
00:02:22,220 --> 00:02:26,750
!لديّ شعور أنني لن أحتاج سوى لذراعي اليمنى للتعامل معك

35
00:02:26,970 --> 00:02:28,920
!ذراع واحدة

36
00:02:29,220 --> 00:02:30,240
!لا تجعلني أضحك

37
00:02:39,850 --> 00:02:43,030
!خذ هذه

38
00:02:45,390 --> 00:02:49,260
...إنها أحد الهيئات الخمس لقوة إلاهة السبج

39
00:02:49,740 --> 00:02:52,320
!طاقة السيف الذهبيّ

40
00:02:52,320 --> 00:02:54,090
!هذا رائع

41
00:02:54,090 --> 00:02:57,270
.أشعر أنه في إمكاني القضاء على أيّ عدو مهما كان قويا

42
00:02:59,180 --> 00:03:04,700
.الحجر الأسود بداخل والدي هو ما حوّلني إلى سيف

43
00:03:05,050 --> 00:03:07,190
هل يمكنك تدميرها من أجلي؟

44
00:03:07,480 --> 00:03:09,680
.لا بدّ أنه الحجر الأسود

45
00:03:10,000 --> 00:03:11,630
...إن قمت بتحطيمه

46
00:03:11,630 --> 00:03:15,590
أولا، هل يمكنني التحدّث إلى والدي؟

47
00:03:15,840 --> 00:03:16,920
ميتشيرو؟

48
00:03:29,470 --> 00:03:31,620
.هيا. لا تتردّدي الآن

49
00:03:31,620 --> 00:03:33,540
ستخبرينه عن ماهية شعورك الحقيقيّ، صحيح؟

50
00:03:33,540 --> 00:03:35,550
...أجل، لكن

51
00:03:36,110 --> 00:03:40,930
.لم يسبق لي فعل هذا

52
00:03:41,620 --> 00:03:43,290
هل يمكنني فعل ذلك الآن حقا؟

53
00:03:43,530 --> 00:03:45,480
.أعلم أنه في إمكانك فعلها

54
00:03:45,480 --> 00:03:46,880
...موساشي

55
00:03:46,880 --> 00:03:51,790
ستختارينه هو؟ وتتركينني؟

56
00:03:51,790 --> 00:03:53,160
...أبي

57
00:03:53,460 --> 00:03:55,920
.لن تفعلي ذلك يا ميتشيرو

58
00:03:55,920 --> 00:04:02,080
.أنا وأنت نملك الحلم ذاته: أن نصبح كيانا أسمى

59
00:04:06,910 --> 00:04:08,810
.كلا يا أبي

60
00:04:10,200 --> 00:04:14,670
...حلمي... حلمي الحقيقيّ كان

61
00:04:15,260 --> 00:04:22,770
.أن تمسك بيدي وتقضي بعض الوقت رفقتي

62
00:04:30,700 --> 00:04:32,910
.هذا غير صحيح يا ميتشيرو

63
00:04:34,110 --> 00:04:36,680
.أنا وأنت متشابهان

64
00:04:36,680 --> 00:04:39,580
!نملك نفس الأحلام! نحن جسد وروح واحدة

65
00:04:39,580 --> 00:04:41,540
أليس كذلك؟

66
00:04:46,430 --> 00:04:48,790
.هذا يكفي

67
00:04:49,170 --> 00:04:52,520
.لن يتفهّم الأمر مهما قلت له

68
00:04:52,520 --> 00:04:54,330
.فلندمّر الحجر

69
00:04:54,330 --> 00:04:55,270
هل أنت واثقة؟

70
00:05:01,530 --> 00:05:07,530
.أبي... حتى النهاية، لم تشاهدني مطلقا

71
00:05:10,870 --> 00:05:12,760
.حسنا، فلنقم بتدميره

72
00:05:12,760 --> 00:05:17,200
.عندها سنذهب في رحلة للعثور على شيء تقدّرينه

73
00:05:17,200 --> 00:05:18,590
أليس كذلك يا ميتشيرو؟

74
00:05:20,110 --> 00:05:21,360
.لا أستطيع

75
00:05:22,180 --> 00:05:24,940
.تمّ خلقي من ذلك الحجر

76
00:05:25,400 --> 00:05:32,100
.في اللحظة التي تكسره فيها، أنا واثقة أنّ جسدي سيختفي

77
00:05:33,220 --> 00:05:37,630
...دون ذكر كل الألم الذي تسبّبتُ فيه

78
00:05:37,630 --> 00:05:40,120
طلبت منّي فعل هذا وأنت تعرفين كل ذلك؟

79
00:05:40,600 --> 00:05:44,060
!لحظة، هل من طريقة لتتمكني من العيش؟

80
00:05:45,320 --> 00:05:46,580
...كلا

81
00:05:48,500 --> 00:05:50,020
.هكذا أفضل

82
00:05:54,740 --> 00:05:57,610
.سأختفي رفقة والدي

83
00:05:57,610 --> 00:05:58,720
...لكن

84
00:06:00,160 --> 00:06:04,820
.في النهاية المريرة، لم أستطع تركه

85
00:06:05,620 --> 00:06:07,780
جسد وروح واحدة"، صحيح؟"

86
00:06:07,780 --> 00:06:12,640
.كلا. يجب أن أكون الوحيد الذي يختفي كليا

87
00:06:13,880 --> 00:06:19,380
.نصف جسدك مثل جسد شخص عاديّ يا ميتشيرو

88
00:06:19,380 --> 00:06:21,620
.لكن ليس أنا

89
00:06:21,910 --> 00:06:25,590
.استخدمت تقنيات محرمة للاندماج بالكيشين

90
00:06:26,630 --> 00:06:32,130
.جسدي يتدهور كنتيجة لذلك. لن أدوم لوقت طويل

91
00:06:34,150 --> 00:06:35,610
...فهمت

92
00:06:37,730 --> 00:06:39,000
هل أنت واثق؟

93
00:06:40,420 --> 00:06:41,350
.أجل

94
00:06:42,120 --> 00:06:47,170
فهمت... سيموت إذا؟

95
00:06:48,220 --> 00:06:52,560
...بعد كل المعاناة التي جعلني أمرّ بها

96
00:06:52,560 --> 00:06:56,150
.سيموت يتركني خلفه

97
00:06:58,030 --> 00:06:59,810
لمَ تنظرين إليّ هكذا؟

98
00:06:59,810 --> 00:07:02,740
لا يمكنك معرفة ذلك بالرغم من كوننا
جسدا وروحا واحدة؟

99
00:07:02,740 --> 00:07:05,810
لا يمكنك معرفة حقيقة شعوري تجاهك؟

100
00:07:07,120 --> 00:07:08,560
.كلا

101
00:07:08,980 --> 00:07:12,310
.أنا أكرهك

102
00:07:12,930 --> 00:07:18,060
...كنت بارد المشاعر، لئيما، حاقدا ومغرورا

103
00:07:18,060 --> 00:07:20,530
.لا شيء يعتبر ساميا فيك

104
00:07:22,520 --> 00:07:28,220
...معك حقّ. أنا ضعيف... وبشع

105
00:07:28,220 --> 00:07:30,320
.لا فائدة ترجى منّي كشخص

106
00:07:30,320 --> 00:07:31,540
!ألس كذلك؟

107
00:07:31,900 --> 00:07:33,150
.كلا

108
00:07:35,600 --> 00:07:37,840
لمَ تبكين؟

109
00:07:38,670 --> 00:07:43,070
!لأنك... والدي

110
00:07:46,030 --> 00:07:51,490
!لا يهمّ إن كنت ضعيفا! لا شيء من هذا مهمّ

111
00:07:51,780 --> 00:07:53,810
!أنا أهتمّ لأمرك

112
00:07:59,370 --> 00:08:00,420
...أعتقد

113
00:08:01,320 --> 00:08:05,740
.أنه كان هنالك وقت لم أرد فيه سوى سماع ذلك

114
00:08:06,240 --> 00:08:10,410
.يبدو أنّ السيد الصغير ولد بصعوبات جسدية

115
00:08:13,960 --> 00:08:16,760
هذا... أنا؟

116
00:08:20,980 --> 00:08:24,810
.يا لها من حالة مثيرة للشفقة

117
00:08:29,280 --> 00:08:31,650
أنت وحيدة أيضا؟

118
00:08:33,650 --> 00:08:36,870
.كلا، ليست أنا لذا لست واثقا

119
00:08:37,240 --> 00:08:40,070
.إنها شخص مختلف تماما

120
00:08:42,440 --> 00:08:44,890
أنت... ميتشيرو؟

121
00:08:46,680 --> 00:08:49,570
!هذا صحيح... بالطبع

122
00:08:50,420 --> 00:08:53,610
أنت... ما الذي تفكرين فيه؟

123
00:08:54,850 --> 00:08:58,220
...لم أفهم. لأنك لست أنا

124
00:08:58,640 --> 00:09:01,590
...هذه هي! أنت

125
00:09:01,860 --> 00:09:04,430
لست أنا فعلا، صحيح؟

126
00:09:05,490 --> 00:09:09,990
!إنه يراني الآن فعلا

127
00:09:16,730 --> 00:09:18,830
!وداعا يا أبي

128
00:09:19,450 --> 00:09:22,650
—انتظري رجاءً! لم أقم بعد

129
00:09:28,900 --> 00:09:31,640
.تمكّنت من التحدث إليه أخيرا يا ميتشيرو

130
00:09:31,980 --> 00:09:37,590
موساشي... شكرا لك على منحي الشجاعة
.لمواجهة ضعفي

131
00:09:39,870 --> 00:09:41,760
!عاد الكيتيتسو

132
00:09:59,270 --> 00:10:02,360
،بقوّة عباءة إله الحرب الخاصة بتاتسووُمي

133
00:10:02,360 --> 00:10:05,150
.نجا العديد من الجرحى

134
00:10:05,150 --> 00:10:07,070
!وصلت وجبتك

135
00:10:07,930 --> 00:10:09,260
...موساشي

136
00:10:09,710 --> 00:10:14,810
.أنا بخير، لكنك لا تزال في حالة سيئة يا كاتسومي

137
00:10:14,810 --> 00:10:16,440
.سيتطلبني الأمر بعض الوقت فحسب

138
00:10:16,880 --> 00:10:21,310
.سمعت أنك أنقذتنا في النهاية

139
00:10:21,310 --> 00:10:24,020
.كل هذا بفضل تعليمك كيف أصبح لاعبا في الفريق

140
00:10:24,020 --> 00:10:28,260
ستتمكن عشيرتي من العودة لموطننا
.في جزيرة أواجي أخيرا

141
00:10:28,700 --> 00:10:30,480
.شكرا جزيلا لك يا موساشي

142
00:10:33,260 --> 00:10:36,410
.تمّ إلقاء القبض على ميتشيرو

143
00:10:37,140 --> 00:10:39,470
لمَ لم يضعوها في زنزانة؟

144
00:10:39,470 --> 00:10:41,860
.لم يسمح لنا موساشي بفعل ذلك

145
00:10:45,150 --> 00:10:47,060
هل من أخبار عن الكلاب السوداء؟

146
00:10:47,060 --> 00:10:48,910
.لا دليل على وجودهم منذ المعركة

147
00:10:49,140 --> 00:10:51,960
.لا أحد يعلم ما يفكّر فيه أولئك المجانين

148
00:10:51,960 --> 00:10:56,720
لمَ تركوني على قيد الحياة أصلا؟ كيف سيفيدهم ذلك؟

149
00:10:57,580 --> 00:10:59,380
.لا بدّ من وجود سبب من وراء هذا

150
00:11:00,800 --> 00:11:02,340
،خلال حفل التكريم

151
00:11:02,340 --> 00:11:07,540
.تمّ تقديم جوائز لأولئك الذين ساهموا في عملية التحرير

152
00:11:12,490 --> 00:11:14,100
!مولاي

153
00:11:14,100 --> 00:11:21,740
!...لم أقاتل جيدا كفاية لأمنعك من خسارة ذراعك اليمنى

154
00:11:22,150 --> 00:11:25,960
!لا أستحقّ أيّ مكافأة

155
00:11:25,960 --> 00:11:29,490
.فهمت يا كانيتاتسو، والآن عليك أن تتقيّأ

156
00:11:31,530 --> 00:11:35,630
.نساء الأويسوغي جميلات ورائعات

157
00:11:37,520 --> 00:11:40,750
!أبقِ يديك بعيدا عن نساءنا

158
00:11:40,750 --> 00:11:42,940
.لم تتغيّر مطلقا

159
00:11:42,940 --> 00:11:46,010
.لا عجب في أنّ زوجاتك يهربن منك باستمرار

160
00:11:46,010 --> 00:11:48,220
!قل ذلك مجددا أيها الوغد

161
00:11:48,740 --> 00:11:50,180
!واجهني في الخارج

162
00:11:50,430 --> 00:11:52,590
!تبا، سيدمّر القصر

163
00:11:52,590 --> 00:11:54,400
!شباب، علينا كبح جموحه

164
00:11:54,850 --> 00:11:57,390
!فلتتوقف يا كانيتاتسو-دونو

165
00:11:58,150 --> 00:12:00,400
.ليلة أخرى وحفلة أخرى

166
00:12:00,830 --> 00:12:03,850
...البوشي يشربون بكثرة حقا

167
00:12:04,160 --> 00:12:05,370
.لا تهتمّ يا فتى

168
00:12:05,370 --> 00:12:06,560
!كوروكو-سان

169
00:12:06,560 --> 00:12:07,960
،سيتواصل القتال

170
00:12:07,960 --> 00:12:11,340
لذلك يستمتع الجميع بالعيش في هذه اللحظة

171
00:12:12,130 --> 00:12:15,180
.حتى ينشطون أنفسهم ويستعدّون من أجل نزاع آخر

172
00:12:17,670 --> 00:12:22,220
..اقترب اليوم الذي يفترق فيه البوشي، وحينها

173
00:12:22,580 --> 00:12:25,930
.هذا إمضاء والدي

174
00:12:26,590 --> 00:12:27,810
...إذا فوالدي كان

175
00:12:27,810 --> 00:12:29,970
!بوشي أويسوغي؟

176
00:12:29,970 --> 00:12:31,150
.دعني أنهي حديثي

177
00:12:31,530 --> 00:12:36,100
في الحقيقة، لم أعثر على أيّ بوشي
.يدعى كانيماكي جيساي

178
00:12:36,100 --> 00:12:40,100
مهما كانت تلك الصفقة، فعلى الأرجح أنها كانت
.مثل هذا الاتحاد: مؤقتة

179
00:12:41,940 --> 00:12:43,320
.فهمت

180
00:12:43,320 --> 00:12:47,530
.لا يمكنني إخبارك بأكثر من هذا. آسف يا كوجيرو

181
00:12:47,530 --> 00:12:48,530
.لا عليك

182
00:12:51,870 --> 00:12:53,580
سيفان؟

183
00:12:53,810 --> 00:12:55,030
...إنهما

184
00:12:55,800 --> 00:12:59,980
إن كان ذلك هو سيف والدك، فقد تكتشف
.شيئا ما من فحصه

185
00:13:02,630 --> 00:13:05,510
.هذا السيف أشبه بدرس لي

186
00:13:06,440 --> 00:13:10,180
.البلدة التي كبرت فيها تعامل البوشي مثل المجرمين

187
00:13:10,740 --> 00:13:16,050
.لكنّ والدي علمني بخصوص فخر البوشي

188
00:13:16,050 --> 00:13:20,350
.لذا أريد معرفة المزيد بخصوصه

189
00:13:20,350 --> 00:13:21,690
.هنالك طريقة

190
00:13:22,160 --> 00:13:27,270
،كونه كان يملك وثيقة موقّعة من والدي
...زعيم الأويسوغي السابق

191
00:13:27,270 --> 00:13:32,610
.فعلى الأرجح أنّ والدك كان شخصا مهما

192
00:13:32,610 --> 00:13:36,990
...التاكيدا، توكوغاوا، هوجو وداتي

193
00:13:36,990 --> 00:13:41,780
.يمكنني استدعاء قادة الفرق الأخرى لطلب مساعدتهم

194
00:13:41,780 --> 00:13:43,250
!الجنرالات الخمسة العظماء

195
00:13:43,250 --> 00:13:44,500
!حقا؟

196
00:13:45,110 --> 00:13:48,670
لمَ قد تفعل كل هذا من أجلي؟

197
00:13:48,670 --> 00:13:52,140
...قمتم بإنقاذي. وبالإضافة لذلك

198
00:13:53,080 --> 00:13:57,560
.سآخذ المعركة نحوهم وسأضع كل شيء على الحافة

199
00:13:57,560 --> 00:14:00,230
.موساشي، أقدّر لك مساعدتك

200
00:14:00,840 --> 00:14:02,230
أيّ نوع من المساعدات؟

201
00:14:02,440 --> 00:14:05,500
بقية دماء إلاهة السبج مقسّم
.ما بين الجنرالات الخمسة العظماء

202
00:14:05,500 --> 00:14:07,330
.أريدك أن تشربه كله

203
00:14:07,330 --> 00:14:08,680
!هذا خطير جدا يا سيدي

204
00:14:08,680 --> 00:14:11,920
.قد يكون مضيف الإلاهة لكنه لا يزال مجرّد طفل

205
00:14:11,920 --> 00:14:14,280
.هذا من أجل هزيمة أعضاء السبج الثمانية

206
00:14:15,530 --> 00:14:18,540
...لكنك غير مجبر على فعل ذلك

207
00:14:18,540 --> 00:14:19,420
.سأفعلها

208
00:14:19,420 --> 00:14:20,510
.يمكنك الاعتماد عليّ

209
00:14:20,990 --> 00:14:24,500
.لماذا؟ لا علاقة لك بالأويسوغي

210
00:14:24,500 --> 00:14:26,810
لمَ قد تخاطر بحياتك؟

211
00:14:27,040 --> 00:14:28,050
.لديّ أسبابي

212
00:14:28,050 --> 00:14:31,510
.ومقابل مساعدتي، لديّ طلبان

213
00:14:31,860 --> 00:14:34,880
أولهما كان التحقيق في والد كوجيرو؟

214
00:14:35,390 --> 00:14:37,950
...موساشي... لقد

215
00:14:38,590 --> 00:14:41,090
.لديك صديق رائع يا كوجيرو

216
00:14:42,910 --> 00:14:45,190
لحظة، ماذا كان الطلب الآخر؟

217
00:14:53,710 --> 00:14:54,960
!ميتشيرو

218
00:14:54,960 --> 00:14:56,280
.موساشي

219
00:14:56,910 --> 00:14:57,990
هل انتظرت طويلا؟

220
00:14:57,990 --> 00:14:59,230
.كلا

221
00:14:59,230 --> 00:15:00,380
.فلنذهب إذا

222
00:15:00,680 --> 00:15:02,250
...لكنني

223
00:15:02,250 --> 00:15:04,310
،طلبت الإذن من تاتسووُمي-ساما

224
00:15:04,310 --> 00:15:08,140
.وقال أنه في إمكانك الذهاب حيثما شئت لهذا اليوم

225
00:15:08,140 --> 00:15:09,080
حقا؟

226
00:15:09,080 --> 00:15:11,550
!أجل! لذا لنستمتع بوقتنا

227
00:15:11,770 --> 00:15:14,630
أنا حرة... في قضاء الوقت معك؟

228
00:15:24,220 --> 00:15:25,080
!هيا بنا

229
00:15:25,390 --> 00:15:26,300
!أجل

230
00:15:42,070 --> 00:15:44,450
!لم أشاهد مسرحية من قبل

231
00:15:44,450 --> 00:15:45,460
!ولا أنا

232
00:16:15,920 --> 00:16:19,850
!تبدو مثل مجوهرات

233
00:16:30,900 --> 00:16:34,170
مولاي، لمَ قد تسمح بهذا؟

234
00:16:34,170 --> 00:16:37,090
.لا تملك تلك الفتاة وقتا طويلا

235
00:16:38,020 --> 00:16:39,550
!لذيذ

236
00:16:39,550 --> 00:16:44,780
صحيح؟ كوجيرو وتاتسومي أخبراني عن هذا المكان
.لذلك أتيت رفقة الفرقة

237
00:16:44,780 --> 00:16:47,640
حقا؟ كيف حال الجميع؟

238
00:16:47,640 --> 00:16:51,320
.حصل إخوة الشيمازو على قصر

239
00:16:51,320 --> 00:16:54,470
.يمكنكم أن تصبحوا فرقة مستقلة الآن

240
00:16:54,470 --> 00:16:59,050
أنتم أحرار في التصرف بمفردكم دون تلقي أوامر
.من أيّ شخص بعد الآن

241
00:16:59,480 --> 00:17:00,870
...نحن أحرار

242
00:17:00,870 --> 00:17:02,240
من ذلك العجوز؟...

243
00:17:02,670 --> 00:17:04,090
!هذه هي فرقتنا

244
00:17:05,110 --> 00:17:06,540
!هذا مذهل

245
00:17:06,540 --> 00:17:07,450
والبقية؟

246
00:17:07,940 --> 00:17:10,900
.ناوُوي-ساما وناوتورا تلقيا مكافأة أيضا

247
00:17:11,560 --> 00:17:13,940
هل حصلت على أيّ شيء يا موساشي؟

248
00:17:13,940 --> 00:17:14,830
.أجل

249
00:17:15,430 --> 00:17:20,760
...دعاني تاتسووُمي-ساما وناوتورا للانضمام لفرقهم لكن

250
00:17:21,330 --> 00:17:22,710
ترفض ذلك؟

251
00:17:22,710 --> 00:17:23,560
!لماذا؟

252
00:17:23,780 --> 00:17:27,070
.أعني، أنا عضو في فرقة كانيماكي

253
00:17:27,070 --> 00:17:28,120
كانيماكي؟

254
00:17:28,120 --> 00:17:28,950
.أجل

255
00:17:28,950 --> 00:17:31,270
!كوجيرو! تسوغومي

256
00:17:31,630 --> 00:17:32,810
!ماذا؟

257
00:17:35,700 --> 00:17:38,150
.هذا هو كانيماكي كوجيرو

258
00:17:38,150 --> 00:17:40,660
.وهذه هاتوري تسوغومي

259
00:17:41,420 --> 00:17:45,240
!عزمت على أن أصبح الأقوى رفقتهما

260
00:17:45,670 --> 00:17:46,740
...موساشي

261
00:17:46,740 --> 00:17:48,360
فرقة كانيماكي؟

262
00:17:48,360 --> 00:17:50,700
...حتى يعترف بهم مولانا

263
00:17:50,700 --> 00:17:52,350
.يجدر بنا تذكّر ذلك الاسم

264
00:17:52,910 --> 00:17:55,930
هذا محرج نوعا ما، صحيح؟

265
00:17:58,780 --> 00:18:00,620
أنا لا أحلم، صحيح؟

266
00:18:00,620 --> 00:18:02,690
.كلا

267
00:18:02,690 --> 00:18:04,520
...اعترفوا بنا أخيرا

268
00:18:07,560 --> 00:18:09,350
!فرقة كانيماكي

269
00:18:10,380 --> 00:18:12,950
.هذا مذهل يا موساشي

270
00:18:13,200 --> 00:18:14,330
.أجل

271
00:18:14,330 --> 00:18:15,400
!موساشي

272
00:18:16,450 --> 00:18:18,250
!اُنظروا لهذا، تخرج رفقة فتاة

273
00:18:18,250 --> 00:18:19,530
!ميتشيرو

274
00:18:19,530 --> 00:18:22,080
!انظري لهذا

275
00:18:22,830 --> 00:18:24,910
!إنه لامع وجميل

276
00:18:24,910 --> 00:18:26,560
،يقال أنه إن ارتداه زوج

277
00:18:26,560 --> 00:18:28,870
.فسيبقيان مع بعض للأبد

278
00:18:28,870 --> 00:18:30,290
للأبد؟

279
00:18:32,350 --> 00:18:35,490
!ليس سيئا يا صاح

280
00:18:40,440 --> 00:18:42,520
هل تريدين واحدة من هذه يا ميتشيرو؟

281
00:18:42,520 --> 00:18:44,040
ما رأيك في اثنين؟

282
00:18:44,040 --> 00:18:45,720
هل أنتما حبيبان؟

283
00:18:46,620 --> 00:18:48,280
حبيبان...؟

284
00:18:48,670 --> 00:18:51,550
!هذا يعني أنكما تحبان بعضكما كثيرا

285
00:18:51,550 --> 00:18:53,320
نحبّ بعضنا؟

286
00:18:54,910 --> 00:18:56,170
.هذا صحيح

287
00:18:56,170 --> 00:18:57,120
.سنأخذها

288
00:19:02,860 --> 00:19:04,830
.شكرا لك يا موساشي

289
00:19:07,280 --> 00:19:10,630
.هذا ممتع للغاية. ليته يستمرّ للأبد

290
00:19:16,530 --> 00:19:20,680
...لو كنت بشرية عادية

291
00:19:24,970 --> 00:19:30,810
وليس إلاهة سبج مزيفة، فقد نقضي وقتا
...مع بعض... لفترة أطول

292
00:20:02,860 --> 00:20:05,790
.ميتشيرو، لديّ هدية لك

293
00:20:06,080 --> 00:20:07,180
ما هي؟

294
00:20:08,770 --> 00:20:10,650
سيف الكيتيتسو خاصتي؟

295
00:20:10,650 --> 00:20:12,270
.قمت بتهريبه

296
00:20:12,570 --> 00:20:15,020
هو مهمّ بالنسبة لك، صحيح؟

297
00:20:15,350 --> 00:20:18,990
.قلت أنه أول شيء قام والدك بمدحك عليه

298
00:20:18,990 --> 00:20:21,270
.يذهلني أنك تذكرت ذلك

299
00:20:23,650 --> 00:20:28,290
.كنت سأقتلك باستخدامه

300
00:20:29,220 --> 00:20:31,540
.لأنني أردت أن يعترف بي والدي

301
00:20:32,700 --> 00:20:37,260
.كلا... لأنني كنت مجرد امتداد له

302
00:20:38,430 --> 00:20:43,180
.لكن الآن، بفضلك، أصبحت نفسي الحقيقية

303
00:20:43,950 --> 00:20:46,040
.شكرا لك يا موساشي

304
00:20:47,970 --> 00:20:49,620
.لا شكر على واجب

305
00:20:56,660 --> 00:21:02,760
عليك أن تعثر على كنز... لملء الفراغ الوحيد
...الذي في قلبك

306
00:21:03,580 --> 00:21:06,290
بدلي، مفهوم؟

307
00:21:07,080 --> 00:21:09,980
.أجل. أعدك

308
00:21:14,110 --> 00:21:16,720
.حسنا إذا... وداعا

309
00:21:19,620 --> 00:21:20,370
...أجل

310
00:21:32,670 --> 00:21:33,590
—ميتشيرو

311
00:21:36,550 --> 00:21:37,360
!ميتشيرو

312
00:21:50,160 --> 00:21:54,980
لمَ خُلقت ميتشيرو فقط لتموت هكذا؟

313
00:22:03,170 --> 00:22:06,620
.إن كنت تبحث عن الأجوبة، فعليك أن تأتي إلى حيث أتواجد

314
00:22:06,950 --> 00:22:09,570
.ستتمكن من فعل ذلك يا موساشي

315
00:22:15,470 --> 00:22:17,960
.سأذهب إلى هناك مهما كلفني الأمر

316
00:22:18,470 --> 00:22:19,310
!أقسم على ذلك

317
00:22:23,250 --> 00:22:27,180
!وداعا! نراكم في عملية صيد الكيشين القادمة

318
00:22:27,180 --> 00:22:28,530
!اهتموا بأنفسكم

319
00:22:28,530 --> 00:22:30,210
!ماموري-تشان

320
00:22:30,210 --> 00:22:31,480
!وداعا

321
00:22:32,820 --> 00:22:38,050
.مولاي، في النهاية، لم أتمكّن من القضاء على العدوّ

322
00:22:38,610 --> 00:22:39,960
.أقدّم اعتذاراتي الخالصة

323
00:22:41,100 --> 00:22:43,030
.أنتما متشابهان حقا

324
00:22:43,430 --> 00:22:44,730
...تاتسووُمي

325
00:22:44,730 --> 00:22:49,980
.آسف. لم أتمكن من القضاء على إينوكاي شيرو

326
00:22:49,980 --> 00:22:53,480
.ناوتورا، لا تركّز على فكرة قتلك له من عدمها

327
00:22:55,050 --> 00:22:57,140
.لا يزال هنالك ثمانية منهم يا مولاي

328
00:22:57,140 --> 00:23:00,400
،صحيح. حتى عندما يموت أحدهم

329
00:23:00,400 --> 00:23:03,210
.يتمكّنون من العثور على بديل له دائما

330
00:23:03,210 --> 00:23:03,890
...ما

331
00:23:14,010 --> 00:23:18,260
هينوموتو تحت حصار شرس

332
00:23:18,260 --> 00:23:20,700
.من قبل مجموعة قوية من الكيشين

333
00:23:21,150 --> 00:23:23,670
.قوة واحدة فقط تقف في طريقهم

334
00:23:24,250 --> 00:23:27,340
،ترسم طريق كوكبة بألوان الحياة الخمسة نفسها

335
00:23:27,630 --> 00:23:31,550
إنهم محاربون يستخدمون سيوف الكيتيتسو
...والمعروفون أيضا باسم

336
00:23:34,260 --> 00:23:35,410
!فرق البوشي