1
00:00:12,530 --> 00:00:14,660
لماذا تُشهرين سلاحكِ عليّ أنا يا يوكيني؟

2
00:00:16,900 --> 00:00:20,540
هل أعتبرُ صمتكِ إجابة؟

3
00:00:31,160 --> 00:00:33,300
لِمَن تمدِّين يدكِ؟

4
00:00:38,730 --> 00:00:42,730
لن أدع أحداً آخر يحملُ صليبي

5
00:00:43,050 --> 00:00:43,930
ماذا؟

6
00:00:49,990 --> 00:00:53,860
ماذا تقصدين بـ"مستغلّة حفاظكِ على هويتي"؟

7
00:00:53,860 --> 00:00:56,410
روح فيني تسكنُني

8
00:00:56,900 --> 00:00:58,800
وهي على وشك أن تستيقظ

9
00:00:59,550 --> 00:01:02,750
أنا إحدى الأطفال المُستقبِلات اللاتي
جُلِبنَ إلى ذلك الميتَم

10
00:01:03,100 --> 00:01:05,370
كان حدوث ما يحدث الآن مُحتمَلاً

11
00:01:05,370 --> 00:01:09,040
ممّا يزيد من أهمِّية إيقافكِ أكثر

12
00:01:11,100 --> 00:01:13,510
كي لا تخسري مزيداً من هويّتكِ

13
00:01:13,800 --> 00:01:15,760
لحماية كيري-تشان التي أحبُّها

14
00:01:16,680 --> 00:01:18,300
لا تقولي أنّكِ تحبّينني

15
00:01:18,300 --> 00:01:20,800
!حبِّي لكِ أكثر بكثير

16
00:01:21,130 --> 00:01:21,930
...لهذا السبب

17
00:01:21,930 --> 00:01:25,060
سأحمي العالمَ الذي يسكنُه الناسُ الذين أحبُّهم

18
00:01:25,770 --> 00:01:26,560
...كيري-تشان

19
00:01:29,940 --> 00:01:31,820
في كارما القمر التوأم النوع الطارئ

20
00:01:32,770 --> 00:01:33,990
...شيرابي

21
00:01:34,360 --> 00:01:36,570
التّقطيع المختوم: بينوكيو

22
00:01:37,320 --> 00:01:39,410
أقولُ لكِ

23
00:01:39,900 --> 00:01:43,210
!أنني أحبُّك

24
00:01:52,100 --> 00:01:54,900
هذا من مُخلَّفات تلميذتي الصغيرة المتعبة

25
00:01:54,900 --> 00:01:58,360
ألا يُفترَض أن نكون سُعداء لأنها منحَتْك الفُرصة؟

26
00:02:00,770 --> 00:02:01,510
!سيّدي

27
00:02:01,510 --> 00:02:02,180
ماذا؟

28
00:02:02,180 --> 00:02:04,550
قبل أن تذهب، انظر إلى هذا

29
00:02:05,850 --> 00:02:08,940
أنا ماريا كادينزافنا إيف

30
00:02:09,210 --> 00:02:12,820
تخفيفاً للأضرار الناجِمة عن سقوط القمر

31
00:02:13,260 --> 00:02:15,190
"زيّفتُ اسمي إلى "فيني

32
00:02:16,340 --> 00:02:19,000
أُرسِلَتْ هذه البيانات من فرونتير

33
00:02:19,000 --> 00:02:21,280
إنها تُبَثُّ في كلّ أنحاء العالم

34
00:02:21,740 --> 00:02:24,950
ما هو هدف ف.آي.س بالضبط الآن؟

35
00:02:31,880 --> 00:02:35,880
لم تكن الحقيقة مُرضية لفئة النّخبة

36
00:02:35,880 --> 00:02:40,380
التي تحتكرُ جزءاً من الميادين السياسية والاقتصادية

37
00:02:44,240 --> 00:02:46,270
القمر... بأغانيي؟

38
00:02:47,210 --> 00:02:49,290
القمرُ هو جهازُ رصد

39
00:02:49,290 --> 00:02:54,690
أعدَّه الحُماة، لتجريد البشريّة من التفاهم المُتبادَل

40
00:02:54,920 --> 00:02:59,190
أدّى الهجومُ القمري إلى إلغاء بعض من وظائفه التشغيليّة

41
00:02:59,500 --> 00:03:02,410
ولكن إذا كان بالإمكانِ إعادة تشغيل القمر
يمكنُه العودة إلى مداره الأصليّ

42
00:03:05,500 --> 00:03:07,160
أمي، أمي

43
00:03:08,540 --> 00:03:12,230
...أنقذي العالمَ بأغانيكِ

44
00:03:13,250 --> 00:03:15,830
،لقد كذبتُ حيالَ كلّ شيء حتى الآن

45
00:03:16,130 --> 00:03:18,210
لهذا لستُ واثِقة ما إن كانَتْ كلماتي ستصلُكم

46
00:03:18,210 --> 00:03:20,780
ولكن الشيء الوحيد الذي أريدكم أن تصدِّقوه

47
00:03:20,780 --> 00:03:23,460
هو حقيقة أن الأغاني يمكن أن تتحوَّل إلى قوّة

48
00:03:57,830 --> 00:03:59,720
قوّتي بمفردِها ليسَتْ كافية

49
00:03:59,720 --> 00:04:02,010
لمواجهة القمر المُتساقِط

50
00:04:02,440 --> 00:04:03,880
لِذا ساعدوني

51
00:04:04,180 --> 00:04:06,490
أريدُكم أن تمدُّوني بأغانيكم

52
00:04:17,260 --> 00:04:19,900
سأضحِّي بهذه الحياة التي أنقذَتْها سيرينا

53
00:04:20,580 --> 00:04:22,530
لإنقاذِ حياة شخص آخر

54
00:04:23,150 --> 00:04:26,620
ذلك هو الشيء الوحيد الذي أستطيعُ فعله
لردِّ الجميل إليها

55
00:04:29,260 --> 00:04:30,160
!أوغاوا

56
00:04:30,160 --> 00:04:33,080
أعلم، سأتقفّى أثرَ هذا الفيديو

57
00:04:42,450 --> 00:04:44,380
...هناك من يبذل قُصارى جهده

58
00:04:44,380 --> 00:04:46,460
!عليّ فعل المِثل

59
00:04:47,580 --> 00:04:51,270
لا إجابة سِوى المضي قُدماً

60
00:05:00,880 --> 00:05:04,730
إن لم تسرعي، فلن تحصلي على الدُّمية التي تريدينها

61
00:05:05,180 --> 00:05:06,880
...عصا سليمان

62
00:05:06,880 --> 00:05:08,910
لا ينبغي على البشرية أن تمتلك قوّة

63
00:05:09,230 --> 00:05:11,090
لا تقتل إلّا بشراً

64
00:05:12,310 --> 00:05:14,340
أيستخدمُ هذا لتطويع يوكيني؟

65
00:05:20,090 --> 00:05:23,880
ما الذي ترغبينه بهذا الإلحاح حتّى أقدَمتِ
على ارتداء ياقة كلب؟

66
00:05:24,130 --> 00:05:28,080
دائماً ما يقوم أولئك المتشرِّدون بأعمال قذرة

67
00:05:28,080 --> 00:05:28,890
هل أنا مخطئة؟

68
00:05:31,640 --> 00:05:34,230
سآخذُكِ إلى المنزل ولو اضطررتُ لجرّكِ مع العنق

69
00:05:34,530 --> 00:05:36,890
إلى منزلكِ، المكان الذي ستعودين إليه

70
00:05:39,700 --> 00:05:41,790
،مهما رفضتِني بشدّة

71
00:05:42,090 --> 00:05:44,650
سأساعدُكِ

72
00:05:44,980 --> 00:05:48,160
...وبما أنني أعلمُ ذلك، أعلمُ أنني لا أستطيع التحليق بجناح واحدة

73
00:05:48,970 --> 00:05:52,030
فإنَّ من واجبي التسبُّب بهبوب الرياح

74
00:05:54,390 --> 00:05:56,590
هذا صحيح، أليس كذلك يا كانادي؟

75
00:05:57,430 --> 00:05:58,590
أجل

76
00:05:58,590 --> 00:06:00,580
سأساعدُكِ إذاً بما تُريدين

77
00:06:00,860 --> 00:06:03,770
وكذلك سيفعلُ أولئك المُحيطون بكِ

78
00:06:04,980 --> 00:06:07,470
لا تتكلَّمي وكأنّكِ تفهمين ما يجري

79
00:06:07,980 --> 00:06:09,980
ماذا تفعلين؟

80
00:06:09,980 --> 00:06:13,690
بقي القليلُ من الوقتِ قبل أن تنفجر أداة منع الانتهاك

81
00:06:19,070 --> 00:06:20,730
...كازاناري-سينباي

82
00:06:22,230 --> 00:06:23,660
سأنهي هذا بالهجمة التالية

83
00:06:23,960 --> 00:06:27,240
لقد تدرّبتُ طوال هذا الوقت على هذه الهجمة المُركَّبة

84
00:06:28,960 --> 00:06:31,240
إذاً سأريكِ الجانِب الفتَّاك من سيفي

85
00:06:54,600 --> 00:06:56,220
ألف دمعة مُنهمِرة

86
00:07:04,560 --> 00:07:06,280
ما تمنّيتُ أن يحدثَ تماماً

87
00:07:06,280 --> 00:07:07,740
!رائع

88
00:07:08,860 --> 00:07:12,240
لقد فقدتُ إشارَتَيّ آمي نو هاباكيري وإتشيفال

89
00:07:12,790 --> 00:07:15,320
...تسوباسا... كريس-كون

90
00:08:24,570 --> 00:08:27,310
كيري-تشان، أأنتِ عاجزة عن التوقُّف حقاً؟

91
00:08:27,540 --> 00:08:29,060
،إن أردتِ إيقافي

92
00:08:29,060 --> 00:08:31,720
فعليكِ أن تجبريني على ذلك

93
00:08:35,000 --> 00:08:35,780
الواصل؟

94
00:08:36,280 --> 00:08:38,000
،إن لم تسر الأمورُ كما تُريدينها أن تسير

95
00:08:38,000 --> 00:08:40,620
فعليكِ أن تفرضيها بالقوّة

96
00:09:02,640 --> 00:09:05,030
أغنية إيغاليما النهائيّة هي سيفٌ

97
00:09:05,330 --> 00:09:07,940
يقطعُ روحَ ضحيّته

98
00:09:09,930 --> 00:09:11,730
...ليتَني أستطيعُ فقط إزاحة

99
00:09:11,730 --> 00:09:14,160
القليل من عِنادك بعيداً...

100
00:09:16,540 --> 00:09:18,120
من هي العنيدة بيننا؟

101
00:09:18,700 --> 00:09:22,370
يجبُ أن تعيشي في العالم الذي أريدُه

102
00:09:27,060 --> 00:09:30,760
لا أريدُ عالماً يُجبرُني على أن أكون وحيدة

103
00:09:37,070 --> 00:09:39,710
،سأحمي شيرابي

104
00:09:39,710 --> 00:09:43,970
حتّى لو محَتْ روحُ فيني روحي

105
00:09:49,180 --> 00:09:52,610
،الناسُ الذين ينقذهم الدكتور سيخسرون أحبّائهم

106
00:09:52,850 --> 00:09:55,340
!مثلي تماماً

107
00:09:58,240 --> 00:10:00,440
،حتّى لو نجوتُ في عالَمٍ كهذا

108
00:10:00,440 --> 00:10:02,240
لن أتمكّن من الغناء مجدداً

109
00:10:02,590 --> 00:10:04,670
لكنها الطريقة الوحيدة

110
00:10:04,670 --> 00:10:06,290
هذه هي الطريقة الوحيدة

111
00:10:06,290 --> 00:10:08,480
حتّى لو كلّفَني ذلك

112
00:10:08,480 --> 00:10:10,880
كراهيّتكِ لي

113
00:10:13,750 --> 00:10:16,050
...كيري-تشان، لا تقاتلي بعد الآن

114
00:10:16,280 --> 00:10:19,550
لا تسلبيني كيرا-تشان التي أحبُّها

115
00:10:29,790 --> 00:10:31,650
ما هذا؟

116
00:10:32,000 --> 00:10:34,400
مستحيل... أهذه أنتِ يا شيرابي؟

117
00:10:35,240 --> 00:10:38,550
،شيرابي هي الحاوية لروحِ فيني

118
00:10:38,550 --> 00:10:40,410
...لكنني

119
00:10:40,800 --> 00:10:41,840
كيري-تشان؟

120
00:10:42,420 --> 00:10:45,660
...لم أردكِ أن تكوني حزينة

121
00:10:45,950 --> 00:10:48,590
لكن كلّ ما فعلتُه كان التسبّب ببكائكِ

122
00:10:53,370 --> 00:10:55,920
أنا حقاً فتاةٌ فظيعة، ألستُ كذلك؟

123
00:10:56,560 --> 00:10:58,720
أريدُ أن أختفي

124
00:11:00,010 --> 00:11:01,640
لا يا كيري-تشان

125
00:11:06,880 --> 00:11:07,890
شيرابي؟

126
00:11:08,840 --> 00:11:11,270
شيرابي

127
00:11:52,020 --> 00:11:54,650
تبقى أنقاضُ القمرِ صامتة

128
00:11:56,520 --> 00:11:57,970
هل تعجزُ أغانيي

129
00:11:58,270 --> 00:12:01,780
عن إنقاذِ حياة واحدة يا سيرينا؟

130
00:12:04,330 --> 00:12:06,780
إنها مثل بيكي والأُخريات، صحيح؟

131
00:12:07,150 --> 00:12:10,010
...نعم، إنها تغنِّي

132
00:12:10,010 --> 00:12:11,790
لإنقاذِ الآخرين...

133
00:12:16,990 --> 00:12:18,750
،في العالم الذي سأبنيه

134
00:12:18,750 --> 00:12:21,760
لا ضرورة لقابِضات السيمفوغير

135
00:12:24,680 --> 00:12:27,500
...لهذا جمعتُهن سوية للقِتال

136
00:12:27,500 --> 00:12:29,350
لكن لم أتوقّع أن تسيرَ الأمورُ بهذه السلاسة

137
00:12:29,350 --> 00:12:31,210
!هذا سهلٌ للغاية

138
00:12:40,610 --> 00:12:42,020
،كما وعدت

139
00:12:42,020 --> 00:12:44,390
تولّيتُ أمرَ قابضة القسم 2

140
00:12:45,500 --> 00:12:48,370
لِذا أعطِني عصا سُليمان

141
00:12:48,370 --> 00:12:50,670
وهل أنا مضطرٌّ لإبرام

142
00:12:50,670 --> 00:12:54,390
صفَقة كهذه مع فتاة صغيرة؟

143
00:12:57,450 --> 00:12:58,920
لماذا لا تنفجر؟

144
00:12:59,800 --> 00:13:01,210
إنها مكسورة

145
00:13:01,750 --> 00:13:04,760
علينا أن نتوقَّع بأن الأشرار ينكثون بوعودهم

146
00:13:16,370 --> 00:13:17,770
نويز؟ الآن؟

147
00:13:21,230 --> 00:13:25,130
يأتي المضادّ لعقار الواصِل في أقلّ لحظة تتوقّعينها

148
00:13:25,450 --> 00:13:27,610
...حلِّق إذاً

149
00:13:27,610 --> 00:13:29,450
تطهير الدرع

150
00:13:45,260 --> 00:13:46,150
!العصا

151
00:13:52,760 --> 00:13:54,020
سينباي

152
00:14:06,340 --> 00:14:07,400
...ذلك الدرع

153
00:14:07,790 --> 00:14:08,680
مستحيل

154
00:14:08,680 --> 00:14:10,530
تعمّدَتْ اختيار درع

155
00:14:10,890 --> 00:14:12,890
،بتضخيم صوتي أخفّ

156
00:14:12,890 --> 00:14:15,410
لتخفيف الجهد عن مُضادّ الواصِل؟

157
00:14:15,710 --> 00:14:17,410
هل بمقدورها فعل ذلك؟

158
00:14:17,410 --> 00:14:20,290
بمقدورها... فهذه هي طبيعتُها

159
00:14:44,310 --> 00:14:46,530
إذاً سأريكِ الجانِب الفتَّاك من سيفي

160
00:14:51,980 --> 00:14:55,110
لأنه كان الهجوم المُركَّب الذي تمرنّا
،كثيراً عليه سويةً

161
00:14:55,490 --> 00:14:57,450
لقد حفظتُ الهجمات عن ظهرِ قلب

162
00:14:57,900 --> 00:14:58,960
لهذا بمقدوري مُراوغتها

163
00:14:59,290 --> 00:15:00,520
وأعلمُ أنها ستُراوغ

164
00:15:01,140 --> 00:15:03,660
،لأننا فهِمنا بعضنا الآخر بكلمة واحدة

165
00:15:03,670 --> 00:15:06,920
بمقدوري أن أدعها ترقصُ على أوتارِ غبائي

166
00:15:14,810 --> 00:15:15,810
!لن أبقى مكاني لأجلِ هذا

167
00:15:48,480 --> 00:15:49,850
تمَّتْ عمليّة الاسترداد

168
00:15:50,370 --> 00:15:51,860
يمكننا الاسترخاء الآن

169
00:15:53,550 --> 00:15:55,970
...آسفة لأنني ذهبتُ بمُفردي

170
00:15:56,240 --> 00:15:57,390
لا عليكِ

171
00:15:57,890 --> 00:16:00,990
تذكّرتُ أنني لا أستطيع فعل شيء بمفردي أيضاً

172
00:16:00,990 --> 00:16:01,850
،والأنكى من ذلك

173
00:16:02,390 --> 00:16:05,610
حالفَني الحظُّ برُؤيتي ليوكيني كفتاة جيّدة

174
00:16:07,370 --> 00:16:09,140
،بالرغمِ من هذا

175
00:16:09,140 --> 00:16:11,610
لماذا صدّقتِ ما قلتُه؟

176
00:16:13,280 --> 00:16:15,730
"لأنّكِ ناديتِني بـ"سينباي

177
00:16:15,730 --> 00:16:18,740
لم أستطع تجاهُل ما كنتِ على وشك قوله

178
00:16:18,990 --> 00:16:20,120
أكان ذلك كلّ شيء؟

179
00:16:20,120 --> 00:16:21,150
أجل

180
00:16:21,450 --> 00:16:23,670
حسناً، لنذهب ونلتقِ بتاتشيبانا

181
00:16:25,590 --> 00:16:27,920
إنها مجنونة حقاً

182
00:16:28,380 --> 00:16:31,910
لهذا السبب، شئتُ أم أبيت

183
00:16:32,380 --> 00:16:34,460
دياري هو إلى جانب هؤلاء

184
00:16:38,460 --> 00:16:39,140
!اللّعنة

185
00:16:39,640 --> 00:16:41,890
لا أصدِّق أنني أضعتُ عصا سُليمان

186
00:16:42,370 --> 00:16:45,150
سأضطرُّ لإرسال ماريا لمُطاردتهن

187
00:16:47,000 --> 00:16:49,150
!شيرابي، استيقظي

188
00:16:49,450 --> 00:16:54,660
!شيرابي

189
00:16:56,810 --> 00:16:57,990
...كيري-تشان

190
00:16:58,530 --> 00:16:59,520
لا؟

191
00:16:59,890 --> 00:17:02,150
...ما يعني بأنّكِ

192
00:17:02,150 --> 00:17:04,750
وهل من أهمِّية للأمر؟

193
00:17:05,070 --> 00:17:06,620
بل له أهمِّية كبيرة

194
00:17:06,620 --> 00:17:08,920
صديقتي تبكي

195
00:17:09,770 --> 00:17:10,770
هذا صحيح

196
00:17:11,320 --> 00:17:14,020
،كنتُ قد نويتُ البقاء هادِئة

197
00:17:14,020 --> 00:17:16,860
دون طمس روح أحد

198
00:17:17,160 --> 00:17:18,920
ولكن أظنُّني لا أملك خياراً

199
00:17:19,510 --> 00:17:22,300
بعد تلقِّي هجمة تُمزِّقُ الروحَ إلى نصفين

200
00:17:22,300 --> 00:17:24,690
...لن أصمد تِلك الفترة الطويلة

201
00:17:25,920 --> 00:17:27,680
هل حميتِني؟

202
00:17:28,030 --> 00:17:29,650
لكن لماذا؟

203
00:17:30,160 --> 00:17:32,030
أريدُكِ أن تخبريها

204
00:17:32,350 --> 00:17:33,540
أخبرها؟

205
00:17:33,540 --> 00:17:37,080
لميلينيا، أنني كنتُ الشرِّيرة

206
00:17:37,440 --> 00:17:39,780
...في لحظة ما وفي مكان ما

207
00:17:40,350 --> 00:17:44,080
فات الأوان على ادِّعاءِ البطولة

208
00:17:45,110 --> 00:17:47,920
أنتِ يا من تعيشين في الحاضر يجبُ
أن تعالجي الأمر

209
00:17:49,190 --> 00:17:51,840
...تاتشيبانا هيبيكي

210
00:17:52,430 --> 00:17:56,380
في لحظة ما في المستقبل، سيتّصِلُ العالمُ ببعضهم

211
00:17:56,950 --> 00:17:59,260
ومُشاطَرة ذلك لا تُعَدُّ من أدوار الاشباح

212
00:18:04,050 --> 00:18:06,340
...افتحي عينيكِ يا شيرابي

213
00:18:06,640 --> 00:18:08,660
إنهما مفتوحتان يا كيري-تشان

214
00:18:13,350 --> 00:18:14,940
...جروحكِ

215
00:18:15,280 --> 00:18:16,700
(تحديق)

216
00:18:17,010 --> 00:18:18,150
!شيرابي

217
00:18:18,730 --> 00:18:20,320
لكن كيف؟

218
00:18:20,660 --> 00:18:24,010
أظنُّ أن روح فيني قد حمَتْني

219
00:18:24,010 --> 00:18:26,030
فيني أنقذَتْكِ؟

220
00:18:27,410 --> 00:18:30,020
...الجميع يُساعدونني

221
00:18:30,370 --> 00:18:32,930
لهذا أريدُكِ أن تساعديني أيضاً

222
00:18:33,470 --> 00:18:35,420
لنُنقِذ ماريا سويةً

223
00:18:37,980 --> 00:18:38,690
نعم

224
00:18:38,690 --> 00:18:40,850
هذه المرّة، أنتِ وأنا

225
00:18:40,850 --> 00:18:43,110
سننقذ الجميع

226
00:18:44,160 --> 00:18:48,060
ماريا، حاولي أن تعيدي تفعيل الأنقاض القمريّة مجدداً

227
00:18:48,060 --> 00:18:51,510
...لا أستطيع! أغانيي غير قادرة على إنقاذِ العالم

228
00:18:51,510 --> 00:18:54,070
ماريا، هذه فرصتُنا الأخيرة

229
00:18:54,330 --> 00:18:56,370
لمنعِ القمر من السقوط

230
00:18:58,900 --> 00:19:00,450
!خرقاء

231
00:19:02,150 --> 00:19:05,400
إن فشِلَ القمرُ في السقوط فلن أتمكّن
من فعل ما أشاء

232
00:19:05,830 --> 00:19:06,930
ماريا؟

233
00:19:07,470 --> 00:19:08,960
توقّعت، إنها العجوز المتجمِّلة

234
00:19:09,260 --> 00:19:11,280
اسمعني يا دكتور فير

235
00:19:11,280 --> 00:19:13,210
إن استطعنا استخدام مقدِرات فرونتير

236
00:19:13,210 --> 00:19:16,550
،لإطلاقِ التضخيم الصوتي المُجمَّع نحو القمر

237
00:19:16,550 --> 00:19:19,970
،وإعادة تشغيل الأنقاض التي تتحكّمُ بلعنة بالال

238
00:19:19,970 --> 00:19:22,340
يمكنُنا إعادة القمر إلى مسارِه الصحيح

239
00:19:22,590 --> 00:19:25,130
،إن كنتِ مُلِحّة على تفعيلِ الأنقاض

240
00:19:25,130 --> 00:19:27,380
فاذهبي أنتِ إلى القمر إذاً

241
00:19:32,570 --> 00:19:33,310
!أمِّي

242
00:19:33,570 --> 00:19:38,070
السّبب وراء عجز الأبطال عبر التّاريخ
عن حكمِهم للبشر

243
00:19:38,070 --> 00:19:40,320
هو أنَّ أعداد البشر كانَتْ كبيرة جداً

244
00:19:40,750 --> 00:19:43,750
وبالتالي، عليّ أن أنقِصَ عدد البشر
لدرجة أستطيعُ فيها أن أحكمهم

245
00:19:43,750 --> 00:19:46,080
...وحده عبقريّ مِثلي من استطاعَ اكتشاف ذلك

246
00:19:46,520 --> 00:19:50,510
لطالما أردتُ أن أكون بطلاً
وها أنا الآن سأصبح أعظم من ذلك

247
00:19:53,520 --> 00:19:55,150
!كيف تجرؤ على فعلِ ذلك بأمِّي؟

248
00:19:56,380 --> 00:19:58,090
أيمكنُكِ قتلي؟

249
00:19:58,390 --> 00:20:02,090
إنَّ قتلي يعني قتل البشريّة جمعاء

250
00:20:02,450 --> 00:20:03,600
!سأقتلُك

251
00:20:07,570 --> 00:20:10,510
ابتعدي عن طريقي يا مريضة مُتلازِمة الاندماج 1

252
00:20:10,510 --> 00:20:11,280
!كلّا

253
00:20:11,850 --> 00:20:14,180
أنا تاتشيبانا هيبيكي، عمري 16 عاماً

254
00:20:14,180 --> 00:20:16,030
لستُ مريضة مُتلازِمة اندماج

255
00:20:16,030 --> 00:20:19,860
أنا تاتشيبانا هيبيكي فحسب، وأتيتُ إلى هنا
لأنني أردتُ أن أتكلّمَ معكِ

256
00:20:19,860 --> 00:20:22,030
لا داعي للكلام معكِ

257
00:20:22,030 --> 00:20:24,340
!قتلَ أمِّي

258
00:20:24,340 --> 00:20:26,780
لهذا سأقتلُه أيضاً

259
00:20:26,780 --> 00:20:28,690
،إن عجزتُ عن حماية العالم

260
00:20:28,690 --> 00:20:30,620
فلا سبب يدفعُني للعَيش

261
00:20:39,260 --> 00:20:40,170
...أنت

262
00:20:40,420 --> 00:20:43,430
يمكنُكِ البحث عن السبب لاحقاً

263
00:20:44,930 --> 00:20:47,680
لِذا لا تتخلّي عن الحياة

264
00:20:54,290 --> 00:20:55,430
تَعزيم مُقدَّس؟

265
00:20:55,430 --> 00:20:56,650
!ما الذي تفكِّرين به؟

266
00:21:05,950 --> 00:21:07,070
...هذا

267
00:21:07,070 --> 00:21:08,490
علينا أن ننقذَ ماريا

268
00:21:08,960 --> 00:21:10,810
أتِلك البلهاء وراء هذا؟

269
00:21:10,810 --> 00:21:13,480
أجل، لكن هذا هو طبعُ تاتشيبانا

270
00:21:27,560 --> 00:21:28,940
ما الذي يجري؟

271
00:21:29,450 --> 00:21:31,110
!هذا مستحيل

272
00:21:31,420 --> 00:21:33,640
لا ينبغي على مريضِ الاندماج أن يكون
قادراً على فعل هذا

273
00:21:33,970 --> 00:21:35,640
أهذه أغنيتكِ؟

274
00:21:36,290 --> 00:21:38,150
هل الأغنيةُ في قلبكِ هي التي تفعلُ هذا؟

275
00:21:38,640 --> 00:21:40,150
ما هي أغنيتكِ؟

276
00:21:40,540 --> 00:21:41,650
!ما هي؟

277
00:21:42,010 --> 00:21:43,420
هيّا يا هيبيكي

278
00:21:43,420 --> 00:21:44,650
!من أعماق قلبكِ

279
00:21:57,620 --> 00:22:02,800
إنه الرمح الضارِب غانغنير