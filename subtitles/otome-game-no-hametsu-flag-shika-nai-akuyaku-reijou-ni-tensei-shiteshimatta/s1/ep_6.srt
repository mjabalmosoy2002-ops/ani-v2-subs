1
00:00:00,900 --> 00:00:02,980
!وصلت عطلة الصيف

2
00:00:04,800 --> 00:00:09,540
،وحتى الآن، نجحت في تجنب إشارات الهلاك الخاصة بي

3
00:00:09,540 --> 00:00:11,780
.لكن لا يمكنني التهاون الآن

4
00:00:19,550 --> 00:00:20,820
.آخر ما صنعت

5
00:00:22,060 --> 00:00:24,190
!يبدو مثاليًّا

6
00:00:24,190 --> 00:00:25,830
!شكرًا لك يا توم-سان

7
00:00:39,370 --> 00:00:41,040
!ما رأيك؟

8
00:00:41,450 --> 00:00:44,010
...المعذرة... ما هذا بالضبط

9
00:00:44,010 --> 00:00:46,710
!أنا أتمرّن على رمي دمى الثعابين كما لو كانت حقيقية

10
00:00:46,710 --> 00:00:50,200
!يمكنني فعل هذا كي أجعله يسقط دفاعه إن اقتضت الضرورة

11
00:00:50,200 --> 00:00:51,820
ومتى ستقتضي الضرورة ذلك؟

12
00:00:51,820 --> 00:00:54,320
!سيكون الأمر ضروريًّا عندما تقتضي الضرورة

13
00:00:54,570 --> 00:00:56,710
!أخبريني ما إن كان الأمر يبدو طبيعيًّا أم لا فحسب

14
00:02:32,250 --> 00:02:34,160
.أنا أحب عطلة الصيف

15
00:02:34,160 --> 00:02:36,800
يمكنني القيام بكلّ الأشياء التي أستمتع
.بها مع كل وقت الفراغ هذا

16
00:02:36,800 --> 00:02:40,080
وهل رمي الدمى من الأشياء التي تستمتعين بها؟

17
00:02:40,080 --> 00:02:43,280
.لا تلعبي كثيرًا، فنحن نملك تمارين منزلية أيضًا

18
00:02:43,280 --> 00:02:45,660
!لديّ أعمال الحقل الآن

19
00:02:46,600 --> 00:02:47,700
.سيدتي

20
00:02:48,110 --> 00:02:51,120
لقد خبزت هذه الحلويات. هل تودين القليل منها؟

21
00:02:51,120 --> 00:02:53,410
!شكرًا لك

22
00:02:53,410 --> 00:02:56,240
!لم أتناول حلوياتك المنزلية منذ وقت طويل

23
00:02:57,580 --> 00:02:59,360
!إنّها لذيذة

24
00:03:00,450 --> 00:03:04,190
.شكرًا لك على اهتمامك بكاتارينا في المدرسة

25
00:03:04,190 --> 00:03:05,740
كان الأمر صعبًا، صحيح؟

26
00:03:05,920 --> 00:03:08,190
.لا، ليس تمامًا

27
00:03:08,190 --> 00:03:12,920
.لقد تغيرت كثيرًا بعدما صدمت رأسها في صغرها

28
00:03:12,920 --> 00:03:16,460
.كان شقية أنانية من قبل، لكنّها الآن مسببة للمتاعب

29
00:03:16,690 --> 00:03:20,090
.لكنّ أشياء كثيرة تغيرت نتيجة ذلك

30
00:03:20,540 --> 00:03:24,100
،فعلى سبيل المثال، رئيسة الخدم وجوانا والبستانيّ توم

31
00:03:24,100 --> 00:03:26,470
،لم ينفتحا على أحد من قبل

32
00:03:26,630 --> 00:03:29,700
.لكن يبدو أنّهما يستمتعان كثيرًا مع السيدة

33
00:03:29,960 --> 00:03:31,560
.وهذا ينطبق عليّ أيضًا

34
00:03:32,720 --> 00:03:34,160
.هذا صحيح

35
00:03:34,160 --> 00:03:39,470
.بسببها أصبح بإمكاني وزوجي التحدث بصراحة مع بعضنا

36
00:03:39,470 --> 00:03:42,620
...جعلت عائلة كلايس بأكملها عائلةً

37
00:03:41,130 --> 00:03:43,670
!استعداد

38
00:03:46,240 --> 00:03:49,310
...جعلت العائلة بأكملها عائـ

39
00:03:48,220 --> 00:03:50,030
!ها نحن أولاء

40
00:03:52,870 --> 00:03:54,370
...جعلت الـ

41
00:03:53,630 --> 00:03:57,290
!استعداد وها نحن أولاء

42
00:03:58,000 --> 00:04:00,540
...استعداد و

43
00:04:00,540 --> 00:04:01,720
!كاتارينا

44
00:04:01,720 --> 00:04:04,260
!توقفي عن تلك الصرخات العجيبة

45
00:04:11,210 --> 00:04:14,680
.كان بطّيخ هذه السنة بنفس لذة وحلاوة العام السابق

46
00:04:14,680 --> 00:04:16,450
.هذا صحيح

47
00:04:18,340 --> 00:04:22,190
.الهواء لطيف جدًّا. إنّه يشعرني بالنعاس

48
00:04:22,190 --> 00:04:24,990
،أختي، إن نمتِ هنا

49
00:04:24,990 --> 00:04:26,910
.فستوبخك أمنا مجدّدًا

50
00:04:26,910 --> 00:04:28,190
.لا بأس

51
00:04:28,190 --> 00:04:31,660
العشب مريح للغاية. لمَ لا تجرب ذلك أيضًا؟

52
00:04:31,660 --> 00:04:32,680
.أنا لا أريد

53
00:04:42,810 --> 00:04:44,130
!كيث

54
00:04:44,860 --> 00:04:48,020
!أسرع، أسرع! سأسابقك إلى تلك الشجرة

55
00:04:48,020 --> 00:04:49,160
!انتظري

56
00:05:01,260 --> 00:05:02,280
كيث؟

57
00:05:05,390 --> 00:05:06,240
...وحش

58
00:05:06,610 --> 00:05:07,720
!وحش

59
00:05:07,720 --> 00:05:09,080
!اخرج من هنا فحسب

60
00:05:09,170 --> 00:05:10,430
!ابن المحظية

61
00:05:10,430 --> 00:05:13,040
!لمَ أنت هنا؟ أنت كريه المنظر

62
00:05:13,040 --> 00:05:15,280
!اذهب بسرعة

63
00:05:15,780 --> 00:05:16,800
كيث؟

64
00:05:16,130 --> 00:05:18,710
!اختف فحسب

65
00:05:20,040 --> 00:05:21,920
ما الخطب يا كيث؟

66
00:05:21,920 --> 00:05:23,060
هل أنت بخير؟

67
00:05:24,730 --> 00:05:27,810
.أجل... راودني حلم مخيف فحسب

68
00:05:27,810 --> 00:05:31,020
.هكذا إذًا... كنت تئنّ كثيرًا

69
00:05:31,020 --> 00:05:32,610
.آسف على إقلاقك

70
00:05:35,500 --> 00:05:37,380
.لا بأس يا كيث

71
00:05:37,380 --> 00:05:40,900
!إن راودتك أيّ أحلام مخيفة أخرى، فسأوقظك

72
00:05:42,480 --> 00:05:43,320
.حسنًا

73
00:05:48,060 --> 00:05:51,170
.لم أرَ أيّ كابوس آخر مذ ذلك الحين

74
00:05:51,840 --> 00:05:54,370
.وكلّ ذلك لأنّ أختي كانت معي

75
00:06:10,770 --> 00:06:12,310
.أريد أكل معكرونة الأغرة الهلامية

76
00:06:12,310 --> 00:06:13,310
ماذا؟

77
00:06:13,310 --> 00:06:14,590
مـ-ماذا يعني ذلك؟

78
00:06:14,590 --> 00:06:16,800
!معكرونة الأغرة الهلامية هي الأفضل في الصيف

79
00:06:16,800 --> 00:06:19,830
مهلًا... ألا تملكونها في هذا العالم؟

80
00:06:19,830 --> 00:06:22,520
...ها أنت تتفوهين بأشياء غير منطقية مجدّدًا

81
00:06:31,040 --> 00:06:33,170
...اليوم يوم حار آخر

82
00:06:33,170 --> 00:06:34,370
.مرحبًا يا كاتارينا

83
00:06:35,170 --> 00:06:36,920
.جيورد-ساما

84
00:06:36,920 --> 00:06:39,410
ما رأيك أن نذهب للانتعاش عند البحيرة؟

85
00:06:44,940 --> 00:06:47,810
الجو حارّ يوميًا، أليس كذلك؟

86
00:06:47,810 --> 00:06:49,620
.هذا صحيح

87
00:06:49,620 --> 00:06:52,260
...إنّه يجلس قريبًا كثيرًا مني بالنسبة لشخص يشتكي من الحرارة

88
00:06:54,780 --> 00:06:56,640
لماذا توقّفنا؟

89
00:06:56,640 --> 00:06:57,640
!المعذرة

90
00:06:57,640 --> 00:06:58,900
!كيث؟

91
00:07:00,210 --> 00:07:01,430
هل أنت بخير يا أختي؟

92
00:07:01,430 --> 00:07:02,940
ماذا تقصد؟

93
00:07:02,940 --> 00:07:06,360
.أنا ذاهبة إلى البحيرة مع جيورد-ساما فحسب

94
00:07:06,360 --> 00:07:07,600
فحسب؟

95
00:07:07,600 --> 00:07:09,630
!ولهذا السبب أنت في خطر

96
00:07:09,630 --> 00:07:12,490
ألم تكن ذاهبًا إلى مناسبة اجتماعية كبيرة اليوم؟

97
00:07:13,010 --> 00:07:16,250
...لقد ذهبت، لكني التقيت بألان-ساما هناك

98
00:07:16,570 --> 00:07:18,610
.خرج جيورد بمفرده

99
00:07:19,900 --> 00:07:21,860
لهذا السبب لحقت بنا؟

100
00:07:21,860 --> 00:07:23,120
.نعم

101
00:07:23,840 --> 00:07:25,070
!فهمت

102
00:07:25,070 --> 00:07:29,090
أردت المجيء معنا، أليس كذلك؟

103
00:07:29,270 --> 00:07:33,550
!يا إلهي! شعر بالوحدة لأني تركته بمفرده

104
00:07:33,550 --> 00:07:37,490
.ظننته كبر كثيرًا، لكن أظنّه لا يزال طفلاً

105
00:07:37,490 --> 00:07:41,340
فهمت يا كيث. لمَ لا تأتِ معنا إذًا؟

106
00:07:44,570 --> 00:07:48,750
.إصرارك يفاجئني دائمًا يا كيث

107
00:07:48,750 --> 00:07:50,670
.لا، لا، هذا لا شيء مميز

108
00:07:51,470 --> 00:07:53,250
.إنّهما صديقان مقرّبان حقًّا

109
00:07:53,520 --> 00:07:55,040
!وجدتها

110
00:07:55,040 --> 00:07:56,440
...بما أنّنا هنا جميعًا

111
00:08:00,990 --> 00:08:02,590
!المكان جميل

112
00:08:02,590 --> 00:08:06,160
...أجل، إنّها مكان مثالي لموعد غرامي، لكن

113
00:08:06,160 --> 00:08:09,180
...لم أتوقع مجيء هذا العدد من الناس

114
00:08:09,180 --> 00:08:12,670
!فكرت في أنّه سيكون من الممتع أكثر أن أدعو الجميع

115
00:08:12,760 --> 00:08:15,540
.أنا سعيدة لأنّك دعوتِني

116
00:08:15,540 --> 00:08:18,130
.كدت أتخلف

117
00:08:18,220 --> 00:08:21,930
.أنا سعيدة أيضًا لفرصة الخروج معك يا كاتارينا-ساما

118
00:08:21,930 --> 00:08:23,490
.أجل، هذا صحيح

119
00:08:23,490 --> 00:08:25,980
.شكرًا جزيلًا لك على إحضاري

120
00:08:29,360 --> 00:08:31,080
!هناك قوارب

121
00:08:31,080 --> 00:08:33,040
لمَ لا نركب واحدًا معًا؟

122
00:08:33,040 --> 00:08:33,760
!حسنًا

123
00:08:33,760 --> 00:08:36,020
.لا نريد أن يحدث لك أيّ شيء يا أختي

124
00:08:36,020 --> 00:08:37,400
.سأركب معك أنا أيضًا

125
00:08:37,870 --> 00:08:40,570
.غير ممكن. لا يمكن للقارب حمل ذلك العدد

126
00:08:40,730 --> 00:08:43,570
!كاتارينا-ساما، اركبي معي رجاءً

127
00:08:43,820 --> 00:08:45,930
!سيكون الأمر أفضل إن كنّا فتاتين

128
00:08:46,070 --> 00:08:48,590
!في تلك الحالة أريد أن أركب معك أنا أيضًا

129
00:08:48,590 --> 00:08:49,600
!وأنا أيضًا

130
00:08:49,980 --> 00:08:54,320
.أظنّكم نسيتم أنّ كاتارينا خطيبتي أنا

131
00:08:54,320 --> 00:08:56,700
.أجل، في الوقت الراهن

132
00:08:56,700 --> 00:08:58,460
ما معنى ذلك بالضبط؟

133
00:08:58,460 --> 00:08:59,260
.لا شيء إطلاقًا

134
00:08:59,380 --> 00:09:01,360
عمّاذا يتجادلون؟

135
00:09:01,360 --> 00:09:03,570
.أنا أيضًا لا أعلم

136
00:09:03,570 --> 00:09:06,330
هل ركوب القوارب أمر ممتع لتلك الدرجة؟

137
00:09:06,330 --> 00:09:07,170
ماذا؟

138
00:09:07,620 --> 00:09:09,680
ألا تعلم مدى متعة القوارب؟

139
00:09:09,680 --> 00:09:12,000
.ما زلت طفلًا يا ألان-ساما

140
00:09:12,000 --> 00:09:13,110
!مـ-ماذا؟

141
00:09:13,480 --> 00:09:16,620
!سنتسابق لنرى من يمكنه التجديف بسرعة أكبر

142
00:09:16,620 --> 00:09:18,860
،سيعتمد الفوز على قوة الذراع

143
00:09:18,860 --> 00:09:20,740
!لذا أنا أشعر بالثقة

144
00:09:20,860 --> 00:09:23,860
!في تلك الحالة، أنا أملك فرصة أكبر في الفوز

145
00:09:23,860 --> 00:09:26,570
لمَ لا نتواجه كما كنا في السابقة؟

146
00:09:26,570 --> 00:09:29,080
!إن كان هذا تحدّيًّا، فأنا أقبله

147
00:09:35,710 --> 00:09:37,720
.هذه أوّل مرّة أركب فيها قاربًا ما

148
00:09:37,720 --> 00:09:40,170
!انظري! هناك أسماك

149
00:09:43,820 --> 00:09:45,520
كيف حدث هذا؟

150
00:09:45,520 --> 00:09:48,730
.بسبب القرعة. لذا لا خيار أمامنا الآن

151
00:09:51,770 --> 00:09:53,900
.أنت تجيد الأمر بالنسبة لشخص لم يقم بهذا من قبل

152
00:09:54,020 --> 00:09:55,380
هل تظنّ ذلك؟

153
00:09:55,380 --> 00:09:57,640
.هذا لأني لا أستطيع تكرها تهزمني

154
00:10:00,620 --> 00:10:02,820
!أراك لاحقًا يا ألان-ساما

155
00:10:02,820 --> 00:10:07,050
!مذهل يا كاتارينا-ساما! أنت مذهلة

156
00:10:13,790 --> 00:10:15,760
!لذيذ

157
00:10:15,760 --> 00:10:19,600
.أنت تجيدين إعداد الحلويات حقًّا يا ماريا-سان

158
00:10:19,600 --> 00:10:21,110
.شكرًا لك

159
00:10:21,490 --> 00:10:24,840
.أنا سعيدة لأنّنا تمكّنا من اللقاء

160
00:10:24,840 --> 00:10:27,360
!ستكون هذه ذكرى عطلة صيف مذهلة

161
00:10:27,360 --> 00:10:30,590
.أجل. أظنّ أنّ أخي يستمتع أيضًا

162
00:10:33,530 --> 00:10:35,330
...لكني لا أرى ذلك

163
00:10:35,330 --> 00:10:38,910
أمعني النظر. إنّه يبتسم قليلًا، أترين؟

164
00:10:44,620 --> 00:10:46,740
...لا يمكنني رؤية ذلك أبدًا

165
00:10:52,580 --> 00:10:53,420
!مهلًا

166
00:10:54,580 --> 00:10:56,340
!أعدها

167
00:10:56,340 --> 00:10:57,540
!لا تهرب

168
00:10:57,540 --> 00:10:59,430
!أ-أختي، تنورتك

169
00:10:59,430 --> 00:11:01,830
!فكري قليلًا فيمن يراقبك

170
00:10:59,750 --> 00:11:01,350
!عد إلى هنا

171
00:11:02,940 --> 00:11:04,760
...يا إلهي يا كاتارينا

172
00:11:05,950 --> 00:11:08,780
.لم تكن تبتسم هكذا

173
00:11:09,250 --> 00:11:10,560
حقًّا؟

174
00:11:10,560 --> 00:11:11,370
.أجل

175
00:11:11,730 --> 00:11:15,660
.حتّى عندما كنت تبتسم من الخارج، كنت تشعر بالملل

176
00:11:16,020 --> 00:11:17,910
.قد تكون محقًّا

177
00:11:17,910 --> 00:11:20,440
لكن ألا ينطبق نفس الشيء عليك يا نيكول؟

178
00:11:21,570 --> 00:11:25,050
.أنت تبتسم فقط عندما تكون بالقرب منها

179
00:11:25,530 --> 00:11:27,320
...هذا ليس

180
00:11:27,530 --> 00:11:29,580
!انتظر

181
00:11:40,270 --> 00:11:43,700
...يا إلهي، دائمًا ما تتهاون تمامًا

182
00:11:43,700 --> 00:11:47,970
كيث، ما الذي كانوا يعلمونها في منزل كلايس؟

183
00:11:47,970 --> 00:11:52,310
...ظننتها تتعلم آداب السلوك الصحيحة، مثل الجميع

184
00:11:58,280 --> 00:12:00,280
أختي، هل ستخرجين؟

185
00:12:00,570 --> 00:12:03,460
.نعم، سأذهب للتسوق مع صوفيا

186
00:12:03,460 --> 00:12:07,620
.قالت أنّ آخر كتاب من سلسلة الكونت الشيطاني قد صدر

187
00:12:07,620 --> 00:12:08,890
!يا إلهي

188
00:12:08,890 --> 00:12:12,420
!لم نفعل شيئًا سوى اللهو مذ بدأت عطلة الصيف

189
00:12:12,420 --> 00:12:16,660
!ينبغي أن نمضي عطلتنا في تشكيل خطّة لتجنب هلاكنا

190
00:12:16,660 --> 00:12:18,590
!ألا تتفقن معي؟

191
00:12:20,730 --> 00:12:22,910
!مـ-ما الذي تفعلنه؟

192
00:12:22,910 --> 00:12:27,260
.إنّها عطلة الصيف، لذا اجتماعاتنا الداخلية في عطلة أيضًا

193
00:12:27,260 --> 00:12:29,600
،إ-إن كنا سنهلك في جميع الأحوال

194
00:12:29,600 --> 00:12:32,970
.فقد يكون من الجيد أن نستمتع بهذه الراحة ما دمنا نملكها

195
00:12:33,090 --> 00:12:35,610
.أجل، نحتاج لعطلة من حين لآخر

196
00:12:35,610 --> 00:12:36,750
.أنا موافقة

197
00:12:36,750 --> 00:12:37,950
!أنت أيضًا أيتها الرئيسة؟

198
00:12:43,580 --> 00:12:45,120
مـ-من أنت؟

199
00:12:47,590 --> 00:12:51,450
.تعالي واستمتعي بهذه العطلة معي

200
00:12:52,050 --> 00:12:54,250
!حـ-حسنًا

201
00:12:59,150 --> 00:13:03,050
.اقتربنا من متجر الكتب المفضل لديّ

202
00:13:03,300 --> 00:13:05,080
.لا أطيق الانتظار

203
00:13:07,820 --> 00:13:09,660
.الجميع ينظرون لنا

204
00:13:09,970 --> 00:13:13,080
!يبرز هذان الشقيقان في أي مكان يذهبان إليه

205
00:13:13,920 --> 00:13:16,350
ما ذلك المحل يا ترى؟

206
00:13:16,680 --> 00:13:18,090
هل تريدين تفقده؟

207
00:13:18,090 --> 00:13:18,890
!حسنًا

208
00:13:22,240 --> 00:13:24,840
.أنا واثقة أنّ هذه ستبدو رائعة عليك

209
00:13:25,450 --> 00:13:28,970
.وأنا أظنّ أنّ هذه ستبدو جميلة عليك

210
00:13:28,970 --> 00:13:29,700
حقًّا؟

211
00:13:47,040 --> 00:13:50,010
!مذهل! انظري إلى كل هذه الروايات الرومانسية

212
00:13:50,010 --> 00:13:52,690
.هناك روايات كثيرة لا أعرفها

213
00:13:52,690 --> 00:13:55,960
...قصة حب بين أمير وأمير من بلاد معادية

214
00:13:55,960 --> 00:13:57,610
!تبدو مثيرة للاهتمام

215
00:13:57,610 --> 00:13:59,770
.يبدو أنّها عميقة جدًّا

216
00:13:59,970 --> 00:14:01,780
!ها هي

217
00:14:01,780 --> 00:14:04,200
!آخر كتاب من سلسلة الكونت الشيطاني

218
00:14:04,200 --> 00:14:05,370
!معك حق

219
00:14:06,720 --> 00:14:08,080
!أتطلع لقراءته

220
00:14:08,080 --> 00:14:09,560
أليس الأمر رائعًا؟

221
00:14:08,810 --> 00:14:09,560
.أجل

222
00:14:15,620 --> 00:14:17,990
!كان اليوم ممتعًا للغاية

223
00:14:18,050 --> 00:14:19,200
.أجل

224
00:14:19,450 --> 00:14:24,690
أشعر نوعًا ما أني قضيت وقتًا كهذا
.معك من قبل، قبل وقت طويل

225
00:14:24,690 --> 00:14:28,340
.ماذا؟ لكني لا أظننا خرجنا للتسوق معًا من قبل

226
00:14:28,400 --> 00:14:29,840
.نعم، أنت محقة

227
00:14:29,840 --> 00:14:32,200
.أنا واثقة أني حلمت بذلك فحسب

228
00:14:32,200 --> 00:14:33,360
!تذكرت

229
00:14:33,560 --> 00:14:36,260
.هناك شيء نسيت شراءه

230
00:14:36,260 --> 00:14:38,000
.سأعود لإحضاره

231
00:14:38,000 --> 00:14:40,160
.سأذهب معك إذًا

232
00:14:40,160 --> 00:14:44,080
.لا، لا داعي لذلك، سآخذ الخادم معي

233
00:14:44,080 --> 00:14:48,060
!يمكنك الانتظار هنا مع أخي فحسب

234
00:14:48,420 --> 00:14:50,530
!حظًّا موفّقًا يا أخي

235
00:14:50,530 --> 00:14:51,320
!إلى اللقاء

236
00:14:51,320 --> 00:14:53,170
!مهـ... صوفيا

237
00:14:54,200 --> 00:14:55,780
.ها قد ذهبت

238
00:14:55,780 --> 00:14:56,910
.هذا صحيح

239
00:14:57,220 --> 00:14:58,830
.شكرًا لك على القيام بهذا اليوم

240
00:14:59,690 --> 00:15:02,830
.هذه أوّل مرة أرى فيها صوفيا سعيدة في البلدة

241
00:15:03,170 --> 00:15:06,470
.لا داعي لشكري. استمتعت بوقتي أنا أيضًا

242
00:15:06,470 --> 00:15:07,860
...كاتارينا كلايس

243
00:15:09,020 --> 00:15:14,530
.أنا وأختي سعيدان حقًّا بلقائك

244
00:15:14,530 --> 00:15:16,840
المعذرة يا نيكول-ساما؟

245
00:15:22,230 --> 00:15:24,700
،أعلم أني لا أستطيع أن أتمنى دوامها للأبد

246
00:15:25,710 --> 00:15:27,360
...لكن فقط لهذه اللحظة

247
00:15:29,580 --> 00:15:31,450
.دعيني أبقى إلى جانبك

248
00:15:31,600 --> 00:15:34,200
!ماذا؟

249
00:15:36,210 --> 00:15:37,950
!آسفة على التأخير

250
00:15:37,950 --> 00:15:39,880
!مـ-ماذا حدث؟

251
00:15:39,880 --> 00:15:41,740
...الكونت الشيطاني

252
00:15:44,580 --> 00:15:48,380
.بالتفكير في الأمر، قال نيكول بالفعل أنّه معجب بأحد ما

253
00:15:48,980 --> 00:15:53,020
.من المستحيل ألّا يُغرم أيّ كائن حي بهذه الجاذبية

254
00:16:03,450 --> 00:16:06,010
.توجد الكثير من النساء هنا اليوم

255
00:16:06,010 --> 00:16:08,600
.ألان-ساما سيعزف

256
00:16:08,600 --> 00:16:10,480
...لهذا إذًا

257
00:16:10,480 --> 00:16:11,700
.مساء الخير

258
00:16:12,210 --> 00:16:14,120
.أرى أنكم أتيتم جميعًا

259
00:16:14,340 --> 00:16:16,380
.مساء الخير أيها الرئيس

260
00:16:16,380 --> 00:16:19,500
!من الجيد رؤيتك خلال عطلتنا

261
00:16:19,650 --> 00:16:22,410
.يسرني سماع ذلك

262
00:17:19,940 --> 00:17:21,650
.تفضل يا ألان-ساما

263
00:17:21,650 --> 00:17:23,800
.كان أداءً رائعًا

264
00:17:23,970 --> 00:17:26,390
.شكرًا لك

265
00:17:26,390 --> 00:17:29,270
.تلك الأغنية الأخيرة لم أسمعها من قبل

266
00:17:30,490 --> 00:17:33,820
.أجل... إنّها أول مرة أعزفها

267
00:17:34,210 --> 00:17:36,400
".اسمها "من أجلك يا أعز شخص علي

268
00:17:36,540 --> 00:17:40,540
هل عزفتها إذًا وأنت تفكر في الشخص الذي تحبه؟

269
00:17:41,660 --> 00:17:44,670
...أجل، ربّما

270
00:17:44,670 --> 00:17:47,120
...لكن ليس وكأني أحبها تمامًا

271
00:17:47,680 --> 00:17:49,090
...ردة الفعل تلك

272
00:17:49,090 --> 00:17:51,840
.إنّه يفكر في شخص مميز بالفعل

273
00:17:52,110 --> 00:17:54,100
هل هي ميري؟

274
00:17:54,100 --> 00:17:55,500
أم ربما ماريا؟

275
00:17:55,770 --> 00:17:59,910
.ألان-ساما، السيدات ينتظرنك هناك

276
00:17:59,910 --> 00:18:02,940
ألا ينبغي عليك الذهاب لرؤيتهن الآن؟

277
00:18:02,940 --> 00:18:05,100
...أ-أجل... هذا صحيح

278
00:18:05,610 --> 00:18:09,660
...أظنّها لا تحب رؤية خطيبها يحصل على الاهتمام

279
00:18:11,510 --> 00:18:13,570
!لم تبدو جادّة هكذا؟

280
00:18:13,570 --> 00:18:14,880
.هذا خطير

281
00:18:14,880 --> 00:18:18,060
...أمضيت كلّ هذه السنوات أحاول ألّا أدعه يدرك الأمر

282
00:18:18,060 --> 00:18:20,440
.علي أن أزرع بعض الشكوك به لاحقًا مجدّدًا

283
00:18:20,850 --> 00:18:23,330
!لا أريد أي منافسة أخرى

284
00:18:23,810 --> 00:18:28,620
،ظننت أنّ ميري ليست معجبة بألان لتلك الدرجة بعكس اللعبة

285
00:18:28,620 --> 00:18:32,750
.لكن ربما يكون سلوكها الخشن تجاهه مجرد جانب آخر لحبها

286
00:18:33,090 --> 00:18:37,390
آمل حقًّا أن يكون الشخص الذي
!يحبه ألان هو ميري وليست ماريا

287
00:18:40,370 --> 00:18:43,290
.اشتقت لرؤيتك يا سيريوس-ساما

288
00:18:43,290 --> 00:18:44,540
.وأنا أيضًا

289
00:18:44,540 --> 00:18:47,090
.أتمنى أن تنتهي عطلة الصيف قريبًا

290
00:18:48,100 --> 00:18:49,610
.أستأذن منكن قليلًا

291
00:18:50,610 --> 00:18:51,720
!كاتارينا-سان

292
00:18:53,210 --> 00:18:55,140
!أنت محبوب جدًّا أيها الرئيس

293
00:18:55,140 --> 00:18:56,320
.شكرًا لك

294
00:18:57,400 --> 00:19:01,770
بالتفكير بالأمر، أنت لست مخطوبًا بعد أيها الرئيس، صحيح؟

295
00:19:02,620 --> 00:19:04,040
.هذا صحيح

296
00:19:04,040 --> 00:19:07,120
.هناك عروض، لكن يبدو أنّي غير قادر على اتخاذ القرار

297
00:19:07,490 --> 00:19:11,100
هل هناك شخص أنت مهتمّ به يا ترى؟

298
00:19:11,100 --> 00:19:12,290
شخص أنا مهتم به؟

299
00:19:15,320 --> 00:19:18,220
هذا سيئ! هل كان من الوقاحة أن أسأله ذلك؟

300
00:19:18,220 --> 00:19:19,480
...أ-أقصد

301
00:19:19,480 --> 00:19:20,420
.لا يوجد

302
00:19:21,620 --> 00:19:24,840
.لا يوجد شخص مهتم به

303
00:19:28,660 --> 00:19:31,310
.الرقصة على وشك البدء

304
00:19:31,310 --> 00:19:33,980
.شريكك ينتظرك هناك يا كاتارينا-سان

305
00:19:33,980 --> 00:19:37,280
...أ-أجل! أستأذن إذًا

306
00:19:41,620 --> 00:19:43,780
هلّي بهذه الرقصة يا كاتارينا؟

307
00:19:43,780 --> 00:19:45,050
.أ-أجل

308
00:19:45,330 --> 00:19:47,530
.لنرقص أيضًا يا ألان-ساما

309
00:19:47,530 --> 00:19:48,870
...حـ-حسنًا

310
00:19:58,840 --> 00:20:00,550
!ساعدني يا كيث

311
00:20:00,840 --> 00:20:03,770
!لم أنهِ هذا التمرين المنزلي! وهذا أيضًا

312
00:20:04,550 --> 00:20:06,720
!لم تبدئيه أساسًا

313
00:20:07,220 --> 00:20:10,360
!كنت تقولين أنّك تعملين عليه كلّما سألتك

314
00:20:10,360 --> 00:20:12,560
!أ-أنجزت القليل منه بالفعل

315
00:20:12,560 --> 00:20:16,380
أتقصدين هذين السطرين الصغيرين
!اللذين كتبتهما على هذه الصفحة؟

316
00:20:18,110 --> 00:20:19,490
.أنا آسفة

317
00:20:19,690 --> 00:20:24,220
.أنا ملام على ذلك نوعًا ما أيضًا لأنّي صدقتك دون شك

318
00:20:24,220 --> 00:20:26,000
...هذا مؤلم يا أخي الصغير

319
00:20:26,050 --> 00:20:27,360
...على أيّ حال

320
00:20:27,360 --> 00:20:29,630
،علينا العودة للمدرسة غدًا

321
00:20:29,630 --> 00:20:31,600
.لذا عليك الاهتمام بالأمر اليوم

322
00:20:32,070 --> 00:20:33,430
.سأساعدك

323
00:20:33,430 --> 00:20:34,330
...حسنًا

324
00:20:39,090 --> 00:20:41,250
.أختي، لقد انتهيت هنا

325
00:20:41,250 --> 00:20:43,040
!شكرًا لك يا كيث

326
00:20:43,040 --> 00:20:44,430
.أنا على وشك الانتهاء أيضًا

327
00:20:44,740 --> 00:20:45,740
هل تحتاجين المساعدة؟

328
00:20:45,740 --> 00:20:47,690
.لا بأس، يمكنك الذهاب للنوم

329
00:20:47,690 --> 00:20:48,590
...لكن

330
00:20:48,590 --> 00:20:49,640
!لا بأس، لا بأس

331
00:20:50,950 --> 00:20:53,410
.فهمت. حظًّا طيبًا إذًا

332
00:20:53,410 --> 00:20:54,110
.أجل

333
00:20:57,690 --> 00:21:02,370
كنت دائمًا أنجز واجباتي المنزلية في اليوم
...الأخير من العطلة في حياتي السابقة أيضًا

334
00:21:02,940 --> 00:21:05,460
كيف تبلين في فورتشون لافر؟ هل من تقدم؟

335
00:21:11,490 --> 00:21:15,600
،لقد قهرت الأمير المتعجرف والفتى اللعوب

336
00:21:15,600 --> 00:21:18,380
.لكنّ الأمير السادي أسود القلب صعب جدًّا

337
00:21:19,130 --> 00:21:21,800
.تستمر كاتارينا في التدخل

338
00:21:21,800 --> 00:21:24,250
!أنا أنهيت جميع المسارات بالفعل

339
00:21:24,250 --> 00:21:25,630
ماذا؟ بهذه السرعة؟

340
00:21:25,630 --> 00:21:28,160
...أنت سريعة حقًّا يا أتشان

341
00:21:28,160 --> 00:21:30,760
.لكن كان هناك مسار صعب جدًّا

342
00:21:30,760 --> 00:21:31,990
هل تريدين معرفته؟

343
00:21:31,440 --> 00:21:33,790
!مـ-مهلا، لا! لا تحرقي عليّ

344
00:21:33,790 --> 00:21:35,010
...إنّه

345
00:21:35,230 --> 00:21:38,300
.صباح الخير يا سيدتي. عليك أن تستيقظي

346
00:21:35,710 --> 00:21:38,290
...لا... لا أريد سماع ذلك

347
00:21:38,290 --> 00:21:41,950
!قلت أني لا أريد معرفة ذلك! لا

348
00:21:38,300 --> 00:21:39,620
...سيدتي

349
00:21:40,180 --> 00:21:41,730
!سيدتي

350
00:21:43,360 --> 00:21:46,120
.صباح الخير

351
00:21:46,120 --> 00:21:48,110
.أجل، صباح الخير

352
00:21:49,120 --> 00:21:52,140
...أشعر أني رأيت حلمًا يشعرني بالحنين حقًّا

353
00:21:52,140 --> 00:21:52,740
حلم؟

354
00:21:52,880 --> 00:21:55,940
.نعم، الحلم الذي رأيته للتو

355
00:21:55,940 --> 00:21:58,490
.لكني نسيته بمجرد استيقاظي

356
00:21:58,490 --> 00:22:02,750
.أنت متعبة لأنّك أمضيت الليل بطوله تنجزين واجبك

357
00:22:03,950 --> 00:22:04,750
!واجبي؟