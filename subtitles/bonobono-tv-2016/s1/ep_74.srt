1
00:00:05,920 --> 00:00:08,720
ما تعلّمه سنجاب

2
00:00:09,270 --> 00:00:10,600
!إنّها تتنمر عليّ! تتنمر عليّ

3
00:00:10,600 --> 00:00:12,560
!أختي شو تتنمر عليّ

4
00:00:12,560 --> 00:00:14,990
!توقّف يا سنجاب

5
00:00:14,990 --> 00:00:17,390
أين ذهب ذاك الصغير؟

6
00:00:17,390 --> 00:00:20,030
!اخرج أيّها الجبان

7
00:00:21,790 --> 00:00:26,830
كلّما تأتي أختي شو، تتنمر عليّ دائماً. سئمتُ من هذا

8
00:00:26,830 --> 00:00:29,040
!سنجاب

9
00:00:29,040 --> 00:00:30,530
أخفض صوتك يا سنجاب

10
00:00:30,530 --> 00:00:32,750
أختي في الجوار

11
00:00:32,750 --> 00:00:36,060
أختك؟

12
00:00:36,060 --> 00:00:37,650
هل ستتنمر عليّ؟

13
00:00:37,650 --> 00:00:39,550
لن أفعل؟

14
00:00:40,080 --> 00:00:42,150
لديك أختٌ كبيرة؟

15
00:00:42,150 --> 00:00:43,720
دعني أراها

16
00:00:48,040 --> 00:00:50,230
لمَ نتسلّل؟

17
00:00:50,690 --> 00:00:51,780
صمتاً

18
00:00:52,820 --> 00:00:55,000
إنّها هناك

19
00:00:59,540 --> 00:01:02,110
!هذه هي أخت سنجاب

20
00:01:10,580 --> 00:01:13,520
أختك برازٌ إذاً؟

21
00:01:13,520 --> 00:01:15,630
كـ-كلا

22
00:01:15,630 --> 00:01:18,290
لكنّك قلتَ أنّ هذه أختك للتو

23
00:01:18,640 --> 00:01:20,450
...لم أقصد

24
00:01:18,950 --> 00:01:21,660
!سنجاب، ها أنت

25
00:01:21,660 --> 00:01:23,810
!لا تهرب

26
00:01:27,620 --> 00:01:30,800
بونوبونو، أهذه أخت البراز؟

27
00:01:30,800 --> 00:01:33,100
ماذا قلتَ يا تانوكي البراز؟

28
00:01:35,680 --> 00:01:40,040
تانوكي البراز؟ أنعتني أحدٌ بهذا للتو؟

29
00:01:40,040 --> 00:01:42,550
كلا، لم أفعل

30
00:01:42,550 --> 00:01:43,790
!اخرس

31
00:01:44,820 --> 00:01:49,260
اسمعي، أنا لستُ تانوكي، بل راكون

32
00:01:49,260 --> 00:01:52,320
والراكون يأكل السناجب

33
00:01:52,690 --> 00:01:54,340
حاول

34
00:01:55,360 --> 00:01:59,350
سنجاب، أترى أختك الجريئة؟

35
00:01:59,350 --> 00:02:01,170
أيمكنني ضربها؟

36
00:02:01,170 --> 00:02:03,630
أم عليّ ضربك؟

37
00:02:03,980 --> 00:02:05,770
اضرب سنجاب رجاءً

38
00:02:07,170 --> 00:02:10,340
سنجاب، أأترك هذا الشخص يتأمّرك؟

39
00:02:10,340 --> 00:02:11,940
يا للعار

40
00:02:11,940 --> 00:02:14,090
تنعتينني بالعار؟

41
00:02:14,090 --> 00:02:15,630
لديك مشكلةٌ في هذا؟

42
00:02:15,630 --> 00:02:16,400
...أنت

43
00:02:16,400 --> 00:02:17,780
ماذا؟

44
00:02:17,780 --> 00:02:20,730
!توقّفا

45
00:02:20,730 --> 00:02:22,720
!أنت! أنت! أنت

46
00:02:22,720 --> 00:02:24,860
اضرب سنجاب رجاءً

47
00:02:26,490 --> 00:02:28,900
لنفعل هذا

48
00:02:28,900 --> 00:02:30,170
!كُن جاهزاً

49
00:02:30,170 --> 00:02:31,500
توقّفا

50
00:02:31,500 --> 00:02:33,260
كلاكما، أبطلا هذا

51
00:02:33,920 --> 00:02:39,270
جوجونورو... جوجونورو... غيوم

52
00:02:40,400 --> 00:02:42,610
...إنّها

53
00:02:43,470 --> 00:02:45,120
عليك تجنّب القتال

54
00:02:45,120 --> 00:02:46,510
إنّه حماقة

55
00:02:46,510 --> 00:02:49,620
قبل أن قرّرتما تبادل الكره، أحاولتما حبّ بعضكما الآخر؟

56
00:02:49,620 --> 00:02:51,520
هل تفقّدتما جيّداً؟

57
00:02:51,520 --> 00:02:53,940
أ-أختي

58
00:02:53,940 --> 00:02:57,440
ماذا؟ لديك أخت برازٍ أخرى

59
00:02:59,990 --> 00:03:04,590
!لا تقل براز لأختي

60
00:03:09,640 --> 00:03:11,300
توقّفوا

61
00:03:11,590 --> 00:03:13,430
أأنتِ بخيرٍ يا أختي؟

62
00:03:13,430 --> 00:03:15,450
أنا بخير، أنا هادئة

63
00:03:15,450 --> 00:03:18,480
سأتظاهر بأنّي لم أسمع تلك الكلمة الفظّة

64
00:03:18,480 --> 00:03:20,020
سأتغاضى عنها

65
00:03:20,020 --> 00:03:22,310
!اصمتي يا أخت البراز

66
00:03:26,950 --> 00:03:30,780
...أنت

67
00:03:28,620 --> 00:03:30,780
ماذا؟

68
00:03:30,780 --> 00:03:32,060
توقّفا

69
00:03:32,060 --> 00:03:35,920
لن أقضي لحظةً أخرى مع شخصٍ كهذا

70
00:03:35,920 --> 00:03:37,830
لن أقبل تصرفاته

71
00:03:38,240 --> 00:03:40,340
هيّا يا شو، لنرجع

72
00:03:40,340 --> 00:03:41,780
طاب يومكم

73
00:03:42,370 --> 00:03:44,770
سأتذكّر هذا أيّها الوغد

74
00:03:44,770 --> 00:03:47,870
المرّة القادمة سأنهي هذا

75
00:03:51,940 --> 00:03:55,000
تانوكي البراز ذلك يغيضني حقاً

76
00:03:55,000 --> 00:03:58,010
!أختي، أنا آسفة

77
00:04:04,700 --> 00:04:07,910
ما الخطب يا سنجاب؟

78
00:04:08,380 --> 00:04:11,300
تعلّم سنجاب شيئاً

79
00:04:11,870 --> 00:04:14,070
هذا يغلب هذا

80
00:04:14,070 --> 00:04:17,940
وهذا يغلب هذا

81
00:05:24,840 --> 00:05:30,140
القصة
القادمة

82
00:05:24,840 --> 00:05:30,140
لنلعب العقوبة السماوية