1
00:00:05,330 --> 00:00:07,470
آه، إنّه الصيف

2
00:00:14,400 --> 00:00:18,350
آه، إنّه الصيف

3
00:00:20,560 --> 00:00:25,280
"أحبّ عندما أفكّر بـ "آه، إنّه الصيف

4
00:00:25,280 --> 00:00:31,200
تشعر بالحماس وتريد البدء بالركض

5
00:00:44,010 --> 00:00:45,220
هذا يكفي

6
00:00:46,720 --> 00:00:51,880
ماذا يفعل الجميع عندما يفكّرون بـ "آه، إنّه الصيف"؟

7
00:00:54,400 --> 00:00:55,940
إنّه نائم

8
00:00:56,560 --> 00:00:58,480
...برفق

9
00:01:00,260 --> 00:01:01,550
أهذا أنتَ يا بونوبونو؟

10
00:01:01,550 --> 00:01:02,240
أجل

11
00:01:02,530 --> 00:01:05,240
أخبرتك ألّا توقظني هكذا

12
00:01:07,510 --> 00:01:11,410
ماذا؟ تسأل ماذا أفعل عندما أفكّر "آه، إنّه الصيف"؟

13
00:01:11,410 --> 00:01:12,310
أجل

14
00:01:12,870 --> 00:01:15,010
...حسناً، في ذاك اليوم

15
00:01:15,750 --> 00:01:17,610
كنتُ أمشي

16
00:01:18,440 --> 00:01:23,320
"ورأيتُ مشهداً بين بضعة أشجار وفكّرت "آه، إنّه الصيف

17
00:01:24,560 --> 00:01:27,530
لذا بدأتُ بسلوك ذاك الاتّجاه

18
00:01:29,300 --> 00:01:31,300
ماذا فعلتَ بعدها؟

19
00:01:31,760 --> 00:01:33,300
بعدها رجعت

20
00:01:33,570 --> 00:01:38,960
أعرف هذا! هل فعلتَ شيئاً حيث ذهبت؟

21
00:01:39,550 --> 00:01:40,810
...حسناً

22
00:01:41,200 --> 00:01:43,330
نمت كثيراً

23
00:01:44,360 --> 00:01:45,940
إنّه ضفدع

24
00:01:47,720 --> 00:01:48,580
نهر

25
00:01:49,310 --> 00:01:54,030
نظرتُ للمشهد من ناحيةٍ حتّى الأخرى ثم رجعت

26
00:01:54,360 --> 00:01:56,860
!هذا ما تفعله دوماً

27
00:01:58,010 --> 00:02:00,300
كلب البراري

28
00:02:00,300 --> 00:02:05,750
"أظنّ الناس يفعلون شيئاَ عندما يفكّرون "آه، إنّه الصيف

29
00:02:07,140 --> 00:02:10,870
وعندما يفعلونه، يبدو الصيف كذلك أكثر

30
00:02:17,760 --> 00:02:21,760
كلب البراري يحاول قول شيء

31
00:02:21,760 --> 00:02:24,170
لكن ما هو؟

32
00:02:28,600 --> 00:02:31,570
سأجرّب فعلها معه

33
00:02:34,650 --> 00:02:39,070
ماذا كان يحاول كلب البراري قوله؟

34
00:02:39,800 --> 00:02:42,700
...رأسي

35
00:02:44,340 --> 00:02:48,440
كلا، لن يقول شيئاً فظيعاً كهذا

36
00:02:48,810 --> 00:02:52,710
...إن ذهبتَ هناك وصدمتَ رأسك

37
00:02:52,900 --> 00:02:54,940
ستشعر بانتعاش

38
00:02:58,110 --> 00:02:59,880
ماذا؟ متجر الصيف؟

39
00:02:59,880 --> 00:03:01,990
ما هو متجر الصيف؟

40
00:03:01,990 --> 00:03:03,840
سأذهب لتفقّده

41
00:03:08,000 --> 00:03:10,370
أأنت صاحب متجر الصيف يا عمّ؟

42
00:03:10,980 --> 00:03:13,360
أجل، صحيح

43
00:03:13,720 --> 00:03:16,020
أحببتُ الصيف للـ 28 سنة الفائتة

44
00:03:16,020 --> 00:03:18,320
دعني أتكفل بكل حاجاتك الصيفية

45
00:03:18,320 --> 00:03:20,750
!أنا الصيف عينه

46
00:03:22,080 --> 00:03:27,380
ماذا عليّ أن أفعل عندما أفكّر "آه، إنّه الصيف"؟

47
00:03:27,380 --> 00:03:30,210
ما رأيك أن تلعب بخنفس الكركدن؟

48
00:03:37,230 --> 00:03:40,250
أجل، هذا مسلٍّ

49
00:03:40,250 --> 00:03:42,650
!لا يبدو أنّك تتسلى

50
00:03:43,120 --> 00:03:45,690
الصيف يعني اللهو في النهر

51
00:03:46,250 --> 00:03:49,140
أجل، كان هذا مسلياً

52
00:03:49,140 --> 00:03:51,630
!لا يبدو أنّك قد تسلّيت

53
00:03:52,280 --> 00:03:57,900
صاحب متجر الصيف، ماذا تفعل عندما تفكّر
آه، إنّه الصيف"؟"

54
00:03:57,900 --> 00:04:01,270
أحببتُ الصيف، والصيف أحبّني، لـ 28 سنة

55
00:04:01,270 --> 00:04:03,210
...ما أفعله

56
00:04:03,680 --> 00:04:04,730
هو هذا

57
00:04:05,200 --> 00:04:08,180
أتحمّس وأبدأ الركض

58
00:04:08,180 --> 00:04:10,420
!أجل، إنّه الصيف! إنّه الصيف

59
00:04:10,420 --> 00:04:11,670
!أتى الصيف

60
00:04:11,670 --> 00:04:13,120
!سأمسك بخنفس كركدن

61
00:04:11,670 --> 00:04:14,270
إنّه مثلي

62
00:04:13,120 --> 00:04:14,600
!سألهو في النهر

63
00:04:14,600 --> 00:04:16,420
!سآكل أرزّاً

64
00:04:18,340 --> 00:04:24,450
"المرّة القادمة عندما أفكّر بـ "آه، إنّه الصيف
سآتي لزيارة صاحب متجر الصيف

65
00:05:24,840 --> 00:05:29,970
القصة
القادمة

66
00:05:24,840 --> 00:05:29,970
أتى الجنرال