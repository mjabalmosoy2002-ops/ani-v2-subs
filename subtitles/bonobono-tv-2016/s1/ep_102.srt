1
00:00:05,350 --> 00:00:08,670
حسم راكون قراره مجدداً

2
00:00:10,980 --> 00:00:13,490
!بونوبونو، مشكلة

3
00:00:13,780 --> 00:00:17,490
!لم يغسل راكون وجهه لأسبوع

4
00:00:17,800 --> 00:00:21,640
!ماذا؟ لم يغسله لأسبوع؟

5
00:00:21,640 --> 00:00:25,130
حسناً، لنذهب لتفقّد الأمر

6
00:00:25,580 --> 00:00:28,330
راكون، أأنت بخير؟

7
00:00:28,330 --> 00:00:31,700
سمعتُ أنّك لم تغسل وجهك لأسبوع

8
00:00:31,700 --> 00:00:35,320
لن يحصل شيءٌ لي فقط لأنّي لم أغسل وجهي

9
00:00:35,320 --> 00:00:37,840
لكنّ وجهك يبدو متّسخاً

10
00:00:37,840 --> 00:00:40,480
من الطبيعي أن يبدو كذلك قليلاً

11
00:00:40,480 --> 00:00:45,360
قررتُ أن أرى ما يحصل
إن لم أغسل وجهي قطّ

12
00:00:48,190 --> 00:00:49,830
!مشكلة

13
00:00:49,830 --> 00:00:53,360
!لم يغسل راكون وجهه لأسبوعين

14
00:00:53,700 --> 00:00:56,730
ماذا؟ لا يزال لم يغسله؟

15
00:00:57,050 --> 00:01:00,240
حسناً، لنذهب لتفقّد الأمر مجدداً

16
00:01:01,550 --> 00:01:04,250
إنّه ينزع الأعشاب ويبدو غاضباً جداً

17
00:01:04,600 --> 00:01:07,240
حسناً، لنوقفه

18
00:01:07,550 --> 00:01:10,250
!ما الفائدة من إيقافي؟

19
00:01:10,520 --> 00:01:13,260
راكون، أأنت بخير؟

20
00:01:13,610 --> 00:01:16,520
يبدو وجهك أكثر اتّساخاً من السابق

21
00:01:16,520 --> 00:01:18,750
أجل، لم أغسله لأسبوعين

22
00:01:19,230 --> 00:01:21,700
أشعر بحكّةٍ في وجهي، وهذا يثير غضبي

23
00:01:21,700 --> 00:01:23,760
دعاني وشأني فقط رجاءً

24
00:01:23,760 --> 00:01:26,760
أليس هناك ما يمكننا فعله؟

25
00:01:26,760 --> 00:01:29,430
ماذا؟ لو تركتكما تساعدان، هل ستغادران؟

26
00:01:29,430 --> 00:01:31,760
...حسناً، خذا مخاطي

27
00:01:32,430 --> 00:01:34,410
وألصقاه بتلك الشجرة

28
00:01:37,520 --> 00:01:38,930
إلى اللقاء

29
00:01:38,930 --> 00:01:40,510
أجل، شكراً

30
00:01:40,510 --> 00:01:43,020
!بونوبونو، مشكلة

31
00:01:43,020 --> 00:01:46,010
!لا يزال راكون لم يغسل وجهه بعد

32
00:01:46,010 --> 00:01:49,880
ماذا؟ لم يغسله لثلاثة أسابيع إذاً؟

33
00:01:50,240 --> 00:01:53,650
لنذهب لتفقّده، لنذهب لتفقّده

34
00:01:54,430 --> 00:01:56,120
ليس في البيت

35
00:02:02,110 --> 00:02:04,740
!لنعد! لنعد

36
00:02:04,740 --> 00:02:06,470
!رميتُ ماءً فقط

37
00:02:06,700 --> 00:02:08,860
!بونوبونو

38
00:02:08,860 --> 00:02:10,480
!مشكلة

39
00:02:10,480 --> 00:02:13,990
!لا يزال راكون لم يغسل وجهه بعد

40
00:02:14,800 --> 00:02:20,000
لم يغسل راكون وجهه لشهرٍ كامل

41
00:02:20,000 --> 00:02:22,230
قد تخرج الأمور عن السيطرة

42
00:02:22,520 --> 00:02:25,540
قد يكون وجه راكون أسوداً بالكامل

43
00:02:25,540 --> 00:02:28,230
وربما مُستديراً

44
00:02:28,230 --> 00:02:30,640
ماذا؟ مُستديراً؟

45
00:02:30,640 --> 00:02:36,240
!راكون

46
00:02:37,930 --> 00:02:40,000
!راكون

47
00:02:41,740 --> 00:02:43,860
!إن كنتما ستهربان، لا تنادياني

48
00:02:44,260 --> 00:02:46,500
!راكون

49
00:02:46,500 --> 00:02:49,440
تبدو كالسابق

50
00:02:49,440 --> 00:02:52,510
أجل، ولم أعد أشعر بحكّةٍ في وجهي

51
00:02:52,510 --> 00:02:57,040
للمخلوقات الحية حدّ أقصى لمدى تعرّضهم للاتّساخ

52
00:02:57,040 --> 00:03:02,020
لأنّ بعد مضي فترة، يتساقط الوسخ على أجزاء متّسخة بالفعل

53
00:03:02,020 --> 00:03:04,390
هذا مذهل

54
00:03:04,390 --> 00:03:07,860
كنتُ أتساءل ماذا سيحصل إن لم أغسل وجهي قطّ

55
00:03:07,860 --> 00:03:09,810
لكن لم يحصل شيءٌ مُطلقاً

56
00:03:10,130 --> 00:03:13,050
أأنت واثقٌ أنّ لا شيء غريب حصل؟

57
00:03:14,000 --> 00:03:15,980
شيء غريب؟

58
00:03:15,980 --> 00:03:20,270
لستُ واثقاً، لكنّ الأشياء التي كانت مُقرفة
لم تعد تبدو كذلك

59
00:03:20,630 --> 00:03:23,300
مثل اليرقات الكبيرة

60
00:03:24,410 --> 00:03:26,660
كُرات دود الأرض

61
00:03:27,660 --> 00:03:31,790
وسائل النودويوبدويو الذي تسعله أفعى الأوراتسوبوهيندارا

62
00:03:31,790 --> 00:03:33,420
أشياء كهذه

63
00:03:33,420 --> 00:03:35,300
!إنّه يتنمّر عليّ

64
00:03:37,050 --> 00:03:40,660
راكون، ماذا ستفعل الآن؟

65
00:03:41,070 --> 00:03:45,440
حسناً، عدم غسل وجهي لم يؤثر بشيءٍ مطلقاً

66
00:03:45,970 --> 00:03:48,430
حسنٌ، سأغسل وجهي

67
00:03:48,740 --> 00:03:50,290
ماذا؟ حقاً؟

68
00:03:50,290 --> 00:03:51,990
أجل، انتهيت

69
00:03:51,990 --> 00:03:54,260
أين ستغسله؟

70
00:03:54,260 --> 00:03:56,540
هناك؟ أم هنا؟

71
00:03:59,100 --> 00:04:01,050
هنا ربما

72
00:04:03,320 --> 00:04:05,050
!لا يهمّ أين

73
00:04:06,230 --> 00:04:07,920
حسناً، وقت الغسل

74
00:04:12,230 --> 00:04:15,480
إذاً؟ هل الشعور جميلٌ يا راكون؟

75
00:04:18,000 --> 00:04:19,320
أظنّ ذلك

76
00:04:21,820 --> 00:04:26,760
بعدها، أُصيب راكون بالزكام

77
00:05:24,840 --> 00:05:29,970
القصة
القادمة

78
00:05:24,840 --> 00:05:29,970
الجميع مخلوقات غريبة