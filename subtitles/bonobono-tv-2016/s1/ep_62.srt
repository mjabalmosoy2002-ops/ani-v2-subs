1
00:00:06,210 --> 00:00:08,970
عادت أختي

2
00:00:09,300 --> 00:00:10,670
!إنّها تتنمّر عليّ، تتنمر عليّ

3
00:00:10,670 --> 00:00:13,020
!أختي شو تتنمر عليّ

4
00:00:13,390 --> 00:00:15,490
!توقف يا سنجاب

5
00:00:15,610 --> 00:00:16,990
!كلا

6
00:00:18,750 --> 00:00:20,760
سنجاب، انظر لهذا

7
00:00:22,450 --> 00:00:24,530
إنّها أذناي

8
00:00:25,870 --> 00:00:27,660
وقعت في الفخّ

9
00:00:27,660 --> 00:00:31,240
لكن لمّ تهرب معه يا بونوبونو؟

10
00:00:31,410 --> 00:00:35,190
لأنّ أخت سنجاب ستتنمر عليّ

11
00:00:35,190 --> 00:00:37,540
لم أكن أتنمّر عليك

12
00:00:37,750 --> 00:00:41,310
شو، أوقفي ذلك! يكفي

13
00:00:46,300 --> 00:00:49,760
إنّها... أختي الكبيرة داي

14
00:00:50,760 --> 00:00:53,770
سنجاب، بونوبونو أأنتما بحالٍ حسن؟

15
00:00:53,770 --> 00:00:56,100
هل حسنكما مستمر؟

16
00:00:57,010 --> 00:01:00,630
سنجاب! لا تزال ترفض ترك تلك الجوزة؟

17
00:01:00,800 --> 00:01:04,640
أخبرتك إن لم تتركها لن تصبح مستقلاً مطلقاً

18
00:01:04,950 --> 00:01:07,680
سلّم تلك الجوزة قبل أن أعدّ لعشرة

19
00:01:07,680 --> 00:01:08,820
واضح؟

20
00:01:09,340 --> 00:01:10,430
واحد

21
00:01:11,120 --> 00:01:13,860
شو، دعيهما

22
00:01:14,320 --> 00:01:16,360
إن تركته سيهرب مجدداً

23
00:01:16,360 --> 00:01:19,890
كلا، لن يهرب. أنا أثق بسنجاب

24
00:01:20,330 --> 00:01:21,750
حسناً

25
00:01:22,060 --> 00:01:22,940
اثنان

26
00:01:24,060 --> 00:01:25,270
!أيّها الوغد

27
00:01:25,820 --> 00:01:27,850
سنجاب

28
00:01:27,850 --> 00:01:28,860
ثلاثة

29
00:01:28,860 --> 00:01:30,230
أربعة، خمسة

30
00:01:30,230 --> 00:01:31,750
!ستّة، سبعة، ثمانية، تسعة، عشرة

31
00:01:31,750 --> 00:01:33,610
!أختاي تتنمران عليّ

32
00:01:33,610 --> 00:01:36,770
!توقف أيّها الجبان

33
00:01:38,480 --> 00:01:41,710
سنجاب، توقف! مكانك فوراً

34
00:01:41,710 --> 00:01:44,180
!كلا، سنجاب

35
00:01:45,800 --> 00:01:48,680
اتّسخت قدمي

36
00:01:49,740 --> 00:01:51,950
وقعت في الفخ مجدداً

37
00:01:52,200 --> 00:01:56,420
سنجاب، خنت ثقتي

38
00:01:56,610 --> 00:02:00,100
انظر لدموعي المتدفقة

39
00:02:00,410 --> 00:02:03,530
سنجاب، أأنت بخير؟

40
00:02:11,750 --> 00:02:14,580
لا حاجة لشمّها

41
00:02:14,730 --> 00:02:19,020
أيّتها الأخت، لا تتنمري على سنجاب رجاءً

42
00:02:19,020 --> 00:02:20,950
ليس هذا ما نفعله يا بونوبونو

43
00:02:20,950 --> 00:02:23,850
نحن نشجّعه كي يصبح مستقلاً

44
00:02:24,410 --> 00:02:25,790
مستقلاً؟

45
00:02:25,980 --> 00:02:28,220
ماذا تعني "مستقلاً"؟

46
00:02:28,220 --> 00:02:31,220
ماذا يحصل لو لم يكن بإمكانك أن تصبح مستقلاً؟

47
00:02:31,860 --> 00:02:37,630
لو كنتُ عاجزاً عن أن تصبح مستقلاً
سيأتي رجل الاحتجاز

48
00:02:37,630 --> 00:02:41,170
أنتَ بونوبونو الغير مستقلّ

49
00:02:41,170 --> 00:02:44,440
لنذهب بعيداً، بعيداً

50
00:02:44,540 --> 00:02:48,200
حسناً، سأحتجزك الآن

51
00:02:50,720 --> 00:02:52,920
ما الخطب يا بونوبونو؟

52
00:02:53,240 --> 00:02:56,590
أيّتها الأخت، ما المقصود بـ مستقلاً؟

53
00:02:56,740 --> 00:03:00,480
الاستقلالية هي توفير طعامك بنفسك، قتال أعدائك

54
00:03:00,480 --> 00:03:04,350
أي التمكن من العيش بمفردك

55
00:03:04,350 --> 00:03:05,140
...كما

56
00:03:05,140 --> 00:03:06,120
!سنجاب

57
00:03:07,490 --> 00:03:09,490
لا تعرف متى تستسلم

58
00:03:11,000 --> 00:03:12,000
سنجاب

59
00:03:12,350 --> 00:03:16,100
تلك الجوزة ذاتك الأخرى، أو ذاتك بالأحرى

60
00:03:16,100 --> 00:03:19,120
إن لم ترم نفسك، لن تصبح مستقلاً مطلقاً

61
00:03:19,660 --> 00:03:21,680
شو، ارمي الجوزة

62
00:03:21,680 --> 00:03:23,470
بعيداً، أقصى ما يمكن

63
00:03:23,700 --> 00:03:24,800
حسناً

64
00:03:27,480 --> 00:03:29,670
هذا لصالحك يا سنجاب

65
00:03:29,670 --> 00:03:30,900
ستصبح مستقلاً

66
00:03:30,900 --> 00:03:32,260
عليك أن تستقلّ

67
00:03:34,070 --> 00:03:34,760
حسناً

68
00:03:35,070 --> 00:03:37,620
ماذا؟ حقاً؟ صدقاً؟

69
00:03:37,620 --> 00:03:38,390
أجل

70
00:03:39,360 --> 00:03:40,760
حسنٌ

71
00:03:41,260 --> 00:03:43,960
شو، دعي سنجاب

72
00:03:44,100 --> 00:03:46,550
ماذا؟ إنّه يكذب

73
00:03:46,550 --> 00:03:48,790
قال هذا من قبل، أتذكرين؟

74
00:03:48,790 --> 00:03:52,760
كلا، سأثق بسنجاب

75
00:03:53,910 --> 00:03:55,200
حسناً

76
00:04:01,690 --> 00:04:03,980
حقاً؟ صدقاً؟

77
00:04:04,420 --> 00:04:05,310
أجل

78
00:04:06,620 --> 00:04:08,440
إلى اللقاء إذاً

79
00:04:19,180 --> 00:04:22,030
لا تخبر أختيّ، اتّفقنا؟

80
00:04:23,190 --> 00:04:24,640
أجل

81
00:04:25,880 --> 00:04:29,330
سنجاب مذهل

82
00:05:24,840 --> 00:05:30,140
القصة
ألقادمة

83
00:05:24,840 --> 00:05:30,140
بشأن خفّاش