1
00:00:05,820 --> 00:00:08,670
أريد أن أكون مُغنّياً

2
00:00:10,170 --> 00:00:11,620
!با

3
00:00:11,620 --> 00:00:12,740
!باكّاراكّو

4
00:00:12,740 --> 00:00:14,350
!هذا مُسلً

5
00:00:14,350 --> 00:00:16,000
!باكّاراكّو! كاكّاراكّو

6
00:00:16,000 --> 00:00:18,430
!يعطيني هذا شعوراً جميلاً

7
00:00:19,510 --> 00:00:21,640
ما رأيكم بأغنيتي؟

8
00:00:21,640 --> 00:00:24,640
!فينيقي، كانت رائعة

9
00:00:24,640 --> 00:00:27,900
"أُحبّ جزء "كاكّاراكّو

10
00:00:27,900 --> 00:00:29,100
حقاً؟

11
00:00:29,100 --> 00:00:32,640
يحبّ سنجاب جزء "با! با!" في البداية

12
00:00:32,640 --> 00:00:33,970
حقاً؟

13
00:00:34,450 --> 00:00:37,110
أريد أن أكون مغنّي أغانٍ

14
00:00:37,110 --> 00:00:39,940
!هذا مُذهل يا فينيقي

15
00:00:39,940 --> 00:00:41,610
مُغنِّي أغانٍ؟

16
00:00:43,020 --> 00:00:46,110
لمَ قد تريد أن تصبح كذلك؟

17
00:00:46,110 --> 00:00:48,120
...لأنّه

18
00:00:48,120 --> 00:00:50,120
!كي يمكنني غناء الأغاني

19
00:00:50,900 --> 00:00:53,530
!مُذهل يا فينيقي

20
00:00:54,470 --> 00:00:56,630
لكنّك تغنّي طوال الوقت

21
00:00:57,020 --> 00:01:00,960
ليس هكذا، أريد الغناء كمغنّي أغانٍ

22
00:01:00,960 --> 00:01:03,050
أين الفرق؟

23
00:01:03,050 --> 00:01:04,980
!مختلفان تماماً

24
00:01:04,980 --> 00:01:06,560
!أخبرني كيف

25
00:01:06,560 --> 00:01:08,130
!كما قلتُ، مختلفان

26
00:01:13,320 --> 00:01:15,640
!ضرب! ضرب! سأضربك

27
00:01:15,640 --> 00:01:17,480
!يعطيني هذا شعوراً جميلاً

28
00:01:17,480 --> 00:01:19,490
!ضرب! ضرب! سأضربك

29
00:01:19,490 --> 00:01:21,640
!هذا مُسلً

30
00:01:22,510 --> 00:01:24,890
أصبحتُ مغني أغانٍ الآن

31
00:01:25,500 --> 00:01:27,190
!لا تسخر مني

32
00:01:27,930 --> 00:01:31,690
أغاني مغنّي الأغاني يُفترض أن تسلّي الناس

33
00:01:34,840 --> 00:01:37,260
!ضرب! ضرب! سأضربك

34
00:01:37,260 --> 00:01:38,640
!ضرب! ضرب! أجل

35
00:01:38,640 --> 00:01:42,330
!ضرب! ضرب! يعطيني هذا شعوراً جميلاً

36
00:01:42,330 --> 00:01:45,580
كيف كانت؟

37
00:01:43,270 --> 00:01:43,990
أجل

38
00:01:45,580 --> 00:01:46,090
أجل

39
00:01:46,090 --> 00:01:47,470
!لا تردّا بأجل

40
00:01:47,760 --> 00:01:49,760
!أنا جاد

41
00:01:50,190 --> 00:01:53,520
لديك ما تطمح لأن تكونه، صحيح؟

42
00:01:54,260 --> 00:01:55,270
كلا

43
00:01:55,270 --> 00:01:56,640
لا لديك؟

44
00:01:56,640 --> 00:01:59,260
بالطبع لا، أنا مُقتنع بما أنا عليه

45
00:01:59,700 --> 00:02:04,680
،لو أردتُ أن أكون شيئاً آخر
هذا يعني أنّي أكره من أنا الآن، صحيح؟

46
00:02:04,960 --> 00:02:07,520
لذا يريد الناس أن يصبحوا شيئاً آخر

47
00:02:07,520 --> 00:02:08,590
أأنا مخطئ؟

48
00:02:08,590 --> 00:02:13,210
إن أخبرتُ نفسي الآن أنّي أكرهها
!سأشعر بالسوء

49
00:02:13,210 --> 00:02:14,450
صحيح؟ صحيح؟

50
00:02:14,450 --> 00:02:18,170
!أتشعر بحكّة؟ دعني أساعدك

51
00:02:18,170 --> 00:02:21,100
!لا أكره من أنا الآن

52
00:02:21,100 --> 00:02:23,200
!لكنّي أريد أن أصبح مغنياً

53
00:02:23,200 --> 00:02:25,990
!فهمت، لتصبح واحداً إذاً

54
00:02:25,990 --> 00:02:28,040
!أنا سأبقى كما أنا! وداعاً

55
00:02:31,190 --> 00:02:33,830
يمكن أن يكون راكون مزعجاً

56
00:02:34,190 --> 00:02:37,330
أظن بإمكانك أن تصبح مغني أغانٍ

57
00:02:37,330 --> 00:02:38,590
حقاً؟

58
00:02:38,590 --> 00:02:41,600
أجل، يظنّ سنجاب ذلك أيضاً

59
00:02:41,600 --> 00:02:43,620
!أنا سعيد

60
00:02:43,620 --> 00:02:47,220
!كياراريكو، كياراريكو، فوجيريكو، فوجيريكو

61
00:02:47,220 --> 00:02:50,500
!أو-كي... أو-كي

62
00:02:50,500 --> 00:02:51,360
!أو-كي

63
00:02:51,360 --> 00:02:52,760
!أوكي أوكي، أوكي أوكي

64
00:02:52,760 --> 00:02:54,090
!أوكي

65
00:02:54,090 --> 00:02:55,930
!دا

66
00:02:55,930 --> 00:02:56,890
كيف كان ذلك؟

67
00:02:56,890 --> 00:02:58,680
!مسلياً جداً

68
00:02:58,680 --> 00:03:00,350
!كذلك الرقص

69
00:03:00,350 --> 00:03:01,920
تظنّان ذلك أيضاً؟

70
00:03:01,920 --> 00:03:04,220
يضفي الرقص الكثير، صحيح؟

71
00:03:04,580 --> 00:03:05,820
أجل، أجل

72
00:03:05,820 --> 00:03:09,340
أنتَ راقصٌ بارع أيضاً

73
00:03:09,340 --> 00:03:11,110
علّمني أبي

74
00:03:11,110 --> 00:03:13,790
أبوك؟

75
00:03:13,790 --> 00:03:14,610
أجل

76
00:03:14,610 --> 00:03:18,600
أراد أبي أن يصبح راقص رقصات

77
00:03:18,600 --> 00:03:20,880
هل أصبح واحداً؟

78
00:03:20,880 --> 00:03:23,160
كلا، اعتزل

79
00:03:23,940 --> 00:03:25,590
لمَ؟

80
00:03:26,160 --> 00:03:29,920
بالفعل، لمَ؟

81
00:03:30,890 --> 00:03:33,870
تسألون لمَ اعتزلتُ
في أن أصبح راقص رقصات؟

82
00:03:34,260 --> 00:03:35,550
أجل

83
00:03:35,550 --> 00:03:36,580
...حسناً

84
00:03:37,190 --> 00:03:39,860
كلما أصبحتُ ذلك أكثر، ابتعدتُ أكثر

85
00:03:41,710 --> 00:03:44,630
كلما أصبحتَ ذلك أكثر، ابتعدتَ أكثر؟

86
00:03:45,330 --> 00:03:47,650
ما قصدك بابتعدتَ أكثر؟

87
00:03:47,650 --> 00:03:50,590
أليس عليك أن تصبح كذلك فحسب؟

88
00:03:50,590 --> 00:03:52,870
أجل، ربما

89
00:03:53,540 --> 00:03:56,640
لذا يا فينيقي، كُن ما تريد

90
00:03:57,470 --> 00:03:58,530
...لكن

91
00:03:59,600 --> 00:04:01,420
امرح بالاعتزال

92
00:04:04,160 --> 00:04:05,830
إنّها أمّك

93
00:04:05,830 --> 00:04:07,360
!أراكما لاحقاً

94
00:04:08,430 --> 00:04:11,740
أبي، هل مرحتَ بالاعتزال؟

95
00:04:11,740 --> 00:04:14,500
!أجل

96
00:04:17,220 --> 00:04:22,470
يبدو أب فينيقي مُذهل

97
00:04:23,680 --> 00:04:26,030
!لكن لا زلتُ أفعل

98
00:05:24,840 --> 00:05:29,970
القصة
التالية

99
00:05:24,840 --> 00:05:29,970
مصادفة أحدهم