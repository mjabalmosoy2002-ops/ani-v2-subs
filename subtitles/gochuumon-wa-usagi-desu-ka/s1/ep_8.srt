1
00:00:03,050 --> 00:00:04,540
حِسابكُم هو 600 يَن

2
00:00:04,540 --> 00:00:07,700
أعطيتُموني 1000 إذاً الباقي 400

3
00:00:07,700 --> 00:00:09,980
شكراً جزيلاً

4
00:00:10,390 --> 00:00:13,110
مرحى، سوف أطلب شيئاً

5
00:00:11,960 --> 00:00:13,110
!إنها نشيطة بإفراط

6
00:00:13,630 --> 00:00:16,990
تصرفات شارو... هل يعقل...؟

7
00:00:17,780 --> 00:00:19,310
لقد قالت أنَّها لم تتحمَّل

8
00:00:19,310 --> 00:00:21,700
الإحراج من قِبَل الجَّميع لمَعرِفتكن أنّها فقيرة

9
00:00:21,700 --> 00:00:23,870
لذا اقترحتُ عليها جولةً لإسراف في شرب القهوة

10
00:00:23,870 --> 00:00:26,040
كان بإمكانكِ اقتراحُ شيءٍ آخر

11
00:00:26,040 --> 00:00:27,540
إنّهُ ثالثُ مقهى ندخله

12
00:00:27,540 --> 00:00:32,040
لقد ذهبتُ إلى الكثير من الأماكن
ولكنَّ قهوة رابت هاوس هي الأفضل

13
00:00:28,250 --> 00:00:31,130
انظري فقط كم هي تشعُّ نشاطاً

14
00:00:31,130 --> 00:00:33,720
بل هي تحتِ تأثير الكافيين العالي

15
00:00:32,040 --> 00:00:33,720
حقّاً؟ أنا سعيدةٌ جدّاً

16
00:00:33,720 --> 00:00:36,300
سوف أداعبك

17
00:00:34,270 --> 00:00:38,830
أنا مسرورة لأنَّها أصبحت تُحبُّ القهوة

18
00:00:38,530 --> 00:00:40,350
لا أعتقد أنَّ ماتقولينهُ صحيح

19
00:00:40,350 --> 00:00:43,820
عشرة آلاف قدم في سلسلة جبل الألب

20
00:00:42,590 --> 00:00:45,470
لقد أزعجها الأمر لدرجة جعلتها تثمل؟

21
00:00:43,820 --> 00:00:47,590
عالٍ جداً في جبلِ كوياري

22
00:00:45,470 --> 00:00:49,860
..إنَّها تعلم أنَّكن لستن منزعجات أبداً، ولكن

23
00:00:49,860 --> 00:00:54,860
أجل، ما زلت أظن أن بإمكاني أتعلم من تصرفاته كسيدة

24
00:00:54,860 --> 00:00:59,120
بإمكاني أن أندمج بالمدرسة أكثر بهذه الطَّريقة

25
00:01:02,880 --> 00:01:05,540
راقبني من فضلكَ يا أبي

26
00:01:05,540 --> 00:01:08,050
إنَّ مهارة الرَّمي ضروريّةٌ من أجل السيّدة

27
00:01:08,050 --> 00:01:10,190
لا بُدَّ أنَّكِ مُتعبة يا آنسة

28
00:01:10,190 --> 00:01:12,270
استمتعي ببعض القهوة بينما ترتاحين

29
00:01:12,270 --> 00:01:13,880
شكراً جزيلاً لكِ

30
00:01:20,800 --> 00:01:22,540
لقد أصبتها، لق أصبتها

31
00:01:22,540 --> 00:01:24,560
أصبتها جميعها

32
00:01:27,960 --> 00:01:30,340
لقد ولد شيطان ساحة المعركة

33
00:01:30,340 --> 00:01:32,980
يالها من جملةٍ رائعة

34
00:03:09,370 --> 00:03:11,990
لكي نَنسى الأوقات العَصيبة في العمل

35
00:03:11,990 --> 00:03:14,770
أتينا جميعاً اليوم إلى يُنبوعٍ حارّ لنلهو

36
00:03:15,220 --> 00:03:19,170
إنَّها كالقلعة

37
00:03:19,170 --> 00:03:22,320
إنَّهُ بناءٌ قديم تمَّ تجديده

38
00:03:22,780 --> 00:03:25,820
لم أذهب إلى ينبوعٍ حار مرتدية ثياب السباحة من قبل

39
00:03:25,820 --> 00:03:27,940
سنتمكنمن السباحة والاستحمام في ذات الوقت

40
00:03:27,940 --> 00:03:29,390
عُصفورانِ بحجرٍ واحد

41
00:03:33,990 --> 00:03:36,230
..ليتَني أحضرتُ معي حلقة سباحة

42
00:03:37,850 --> 00:03:40,280
...لقد أحضرت هذه

43
00:03:40,280 --> 00:03:41,160
تفضّلي

44
00:03:41,160 --> 00:03:42,380
زعانفُ سِباحة؟

45
00:03:42,380 --> 00:03:43,610
أنا لا أحتاجهما

46
00:03:43,610 --> 00:03:46,790
خطوة، خطوة، خطوة، خطوة

47
00:03:51,580 --> 00:03:54,480
تبدينَ رائعة يا كوكوا سان

48
00:03:54,480 --> 00:03:56,190
شكراً لكِ

49
00:03:56,190 --> 00:03:58,840
إنَّها المرّةُ الأولى الّتي أرتدي فيها ثوب سباحة من قطعتين

50
00:03:59,810 --> 00:04:02,280
زِيُّكِ جميلٌ أيضاً يا تشينو تشان

51
00:04:02,280 --> 00:04:02,970
أليسَ كذلك؟

52
00:04:03,920 --> 00:04:06,970
لمَ تبدينَ فخورةً بهذا يا كوكوا سان؟

53
00:04:06,970 --> 00:04:10,600
تبدينَ مُختلفة عن المُعتاد يا تشيا سان، هذا جميل

54
00:04:11,160 --> 00:04:14,990
أحبُّ اختيار الألوان الغامقة دائماً

55
00:04:14,990 --> 00:04:18,360
ولكن بما أنَّني برفقة أشخاصٍ يافعين، يجب أن أجرّب هذا صحيح؟

56
00:04:18,360 --> 00:04:20,620
ولكن كم عمركِ أنتِ؟

57
00:04:20,620 --> 00:04:22,740
أينَ ريزي تشان؟

58
00:04:28,550 --> 00:04:30,510
ماذا؟

59
00:04:33,430 --> 00:04:36,010
هذا مثلُ النّكهة التي تُستعمَل في المكوِّنات الأساسيّة

60
00:04:36,010 --> 00:04:36,880
ماذا؟

61
00:04:37,840 --> 00:04:40,410
أعارَتني تشيا زيِّ سابحةٍ قديمٍ لها

62
00:04:40,410 --> 00:04:42,870
إنَّهُ واسعٌ بعض الشّيء

63
00:04:42,870 --> 00:04:46,260
ولكن إن ربطتُ العُقَد أكثر.. فسيُصبح جيّداً

64
00:04:46,260 --> 00:04:47,270
شارو تشان

65
00:04:49,260 --> 00:04:51,020
خيوطُ زيّكِ تخنقك

66
00:04:51,020 --> 00:04:52,770
هذا ليسَ صحيحاً

67
00:04:52,770 --> 00:04:55,850
يبدو زيُّكِ رائعا عليكِ يا شارو تشان

68
00:04:55,850 --> 00:04:58,230
أجل يبدو رائعاً

69
00:04:58,230 --> 00:05:00,110
..أجل ولكنّهُ

70
00:05:00,820 --> 00:05:02,110
ريزي سان

71
00:05:03,770 --> 00:05:07,380
إن كُنتِ لا تُمانعين، هلّا ضفرتِ لي شَعري؟

72
00:05:07,380 --> 00:05:09,120
أجل بالطّبع

73
00:05:14,880 --> 00:05:16,870
ما رأيكِ؟

74
00:05:17,760 --> 00:05:20,430
إنّهُ جميلٌ جدّاً، شكراً لكِ

75
00:05:19,610 --> 00:05:21,630
تبدينَ جميلةً يا تشينو تشان

76
00:05:21,630 --> 00:05:23,450
أنتِ رائعة يا سينباي

77
00:05:23,450 --> 00:05:25,630
أنتِ جيّدةٌ بهذا بالفعل يا ريزي تشان

78
00:05:26,180 --> 00:05:29,040
شعري طويلٌ أيضاً

79
00:05:29,040 --> 00:05:32,200
لذا أصنع الضفائر بكثرة

80
00:05:32,200 --> 00:05:35,640
هلّا ضفرتِ شعري أيضاً؟

81
00:05:35,640 --> 00:05:37,630
بكلّ تأكيد

82
00:05:41,650 --> 00:05:44,060
حبذا لو كان شعري طويلا

83
00:05:44,060 --> 00:05:48,160
كنتُ لأجعلها تضفرُ لي شعري أيضاً

84
00:05:49,340 --> 00:05:50,700
تتحرَّكُ يداكِ كما لو كنت معتادة على الأمر

85
00:05:50,700 --> 00:05:51,710
هذا جميل

86
00:05:51,710 --> 00:05:53,120
هذا طبيعيّ

87
00:05:53,570 --> 00:05:56,650
لم أرَ أحدا بهذه البراعة من قبل

88
00:05:56,650 --> 00:05:59,080
أنت محظوظة لأن بإمكانك فعل كل ذلك بالشعر

89
00:05:56,650 --> 00:05:59,080
حقاً، أنا طبيعيّة

90
00:05:59,600 --> 00:06:01,230
هذا مُذهلٌ جدّاً

91
00:06:01,230 --> 00:06:03,340
ولكنَّهُ مُبالغٌ به قليلاً

92
00:06:03,870 --> 00:06:06,840
! إنَّها سعيدةٌ به

93
00:06:14,850 --> 00:06:16,180
هذا شعورٌ رائع

94
00:06:16,180 --> 00:06:17,590
ذكَّرني هذا عندما تعرّضتُ لمشاكل

95
00:06:17,590 --> 00:06:20,570
عندما سبحتُ في حمّامٍ عام في صِغَري

96
00:06:20,570 --> 00:06:22,560
ولكن هذا ليسَ حمّاما عامّاً

97
00:06:22,560 --> 00:06:25,430
أما زلت تقصدين الحمّامات العامة يا شارو تشان؟

98
00:06:26,970 --> 00:06:28,880
أذهبُ أحياناً

99
00:06:28,880 --> 00:06:31,200
ولكن ليسَ لمكانٍ كبيرٍ كهذا

100
00:06:31,200 --> 00:06:34,850
أتساءَل إن كانت تتحدث عن استعارتها لثوب السباحة الخاص بي

101
00:06:36,450 --> 00:06:37,790
إنَّها فاتِرة

102
00:06:38,300 --> 00:06:40,160
! هذا ليسَ حمّاماً

103
00:06:40,160 --> 00:06:42,460
أنتِ فتاةٌ من الطِّراز القديم أليسَ كذلك؟

104
00:06:47,480 --> 00:06:49,050
مرحباً يا كرة الفرو

105
00:06:49,050 --> 00:06:52,150
أراهنُ أنَّهُ بإمكانك النّزول بهذا الماء الدّافئ

106
00:06:52,150 --> 00:06:55,350
هناكَ حوضٌ يناسبُ حجمَ تيبي تماماً

107
00:06:57,220 --> 00:06:59,560
لا تكُن ترفض
ألا تُحبُّ الينابيع الحارة؟

108
00:06:59,560 --> 00:07:02,120
هل تتحوّل إلى أرنبٍ عادي إن تبلَّلت؟

109
00:07:03,370 --> 00:07:08,630
يُقالُ أنَّ هذا الينبوع الحار يقلل من ضغط الدم وآلام المفاصل

110
00:07:09,320 --> 00:07:12,780
وهل يُفيدُ في النموّ؟

111
00:07:14,230 --> 00:07:16,290
لا يوجد الكثير من النّاس اليوم

112
00:07:17,320 --> 00:07:19,350
لقد كنتُ متشوّقاً جدّا لتحدي

113
00:07:19,350 --> 00:07:22,120
بعض الّلاعبين الأقوياء هنا

114
00:07:22,470 --> 00:07:24,770
هل تلعب معي إذاً؟

115
00:07:24,770 --> 00:07:26,000
قبلت تحديك يا تشينو

116
00:07:26,780 --> 00:07:29,020
هل ستلعب في كِلا الطَّرفين؟

117
00:07:29,020 --> 00:07:30,760
هذه مرحلةٌ متطوّرةٌ جدّاً

118
00:07:31,140 --> 00:07:33,530
هلّا نسبح قليلاً؟

119
00:07:33,530 --> 00:07:36,140
أنا لا أعرفُ كيفَ أسبح

120
00:07:36,590 --> 00:07:40,110
لم أسبح في مسبح عميق من قبل

121
00:07:40,110 --> 00:07:41,300
هذه مفاجأة

122
00:07:42,270 --> 00:07:44,520
سوف أعلّمكِ إذاً

123
00:07:44,520 --> 00:07:48,350
انظري إليّ، هذا يُدعى الزَّحف

124
00:07:48,350 --> 00:07:51,650
أعتقد أنَّكِ أنتِ من يجب أن تتعلّمي أوّلاً

125
00:07:53,860 --> 00:07:57,930
حان وقت بَدء تدريبنا الخاص لتعليم ريزي تشان السِّباحة

126
00:07:57,930 --> 00:07:58,450
تمهّلي

127
00:07:58,840 --> 00:08:03,440
إن كُنّا سنَسبح فأنا أظنُّ أنَّ علينا القيام بالإحماء

128
00:08:03,440 --> 00:08:04,320
أجل

129
00:08:04,710 --> 00:08:07,050
إنَّ الإحماء مُهمٌّ جدّاً

130
00:08:07,050 --> 00:08:08,210
! كم هي مرنة

131
00:08:08,210 --> 00:08:09,570
شارو تشان

132
00:08:10,680 --> 00:08:13,920
لا يُمكِنُنا أن نتركها تتغلّب علينا بالّلياقة

133
00:08:13,920 --> 00:08:15,300
ما الّذي تفعلانه؟

134
00:08:16,010 --> 00:08:17,800
كنات مباراة جيّدة بالفعل

135
00:08:17,800 --> 00:08:18,330
أجل

136
00:08:18,330 --> 00:08:19,820
تشينو تشان

137
00:08:20,400 --> 00:08:22,410
هل أستطيعُ اللعبَ معك؟

138
00:08:22,910 --> 00:08:25,490
فأنا لم ألعب الشَّطرنج من قبل

139
00:08:25,490 --> 00:08:27,880
ولكنَّها شبيهةٌ بالشوغي أليسَ كذلك؟

140
00:08:27,880 --> 00:08:29,690
حسناً، سوف ألعب معكِ

141
00:08:32,510 --> 00:08:35,200
بما أنَّنا نلعب، لمَ لا نضعُ رهانًا؟

142
00:08:35,200 --> 00:08:36,710
ما رأيكِ إن فزتُ

143
00:08:36,710 --> 00:08:40,600
فسوفَ تُريني كيفَ يبدو تيبي وهو مبلول

144
00:08:40,600 --> 00:08:41,080
ماذا؟

145
00:08:41,080 --> 00:08:42,280
حسناً

146
00:08:42,690 --> 00:08:47,540
وإن ربحتُ أنا، سوف تُناديني كوكوا سان بأونيسان

147
00:08:47,540 --> 00:08:49,550
ما الّذي تُقحمينَني بهِ؟

148
00:08:50,210 --> 00:08:51,040
إذاً

149
00:08:51,630 --> 00:08:53,990
سوف نبدأ بمباراة حبسِ النفَس

150
00:08:53,990 --> 00:08:56,040
لماذا سنبدأ بهذا أولا؟

151
00:08:56,040 --> 00:08:57,640
.واحد، اثنان

152
00:09:10,570 --> 00:09:11,400
كوكوا

153
00:09:13,900 --> 00:09:15,880
هل أنتِ بخير؟

154
00:09:15,880 --> 00:09:16,990
أنا ربِحت

155
00:09:16,990 --> 00:09:19,200
لا تغطسي بهذه الطريقة المضللة

156
00:09:19,200 --> 00:09:20,330
حسناً، الجولة الثّانية

157
00:09:20,330 --> 00:09:21,160
أسنقومُ بهذا مُجدّداً؟

158
00:09:27,020 --> 00:09:28,040
ما الّذي تفعله؟

159
00:09:29,100 --> 00:09:30,960
تمثيليات تحزيرية تخص الأرانب؟

160
00:09:31,720 --> 00:09:33,120
اليمين؟

161
00:09:33,120 --> 00:09:34,720
كلا، مُسدَّس

162
00:09:35,480 --> 00:09:37,340
ليسَ لديَّ فِكرةٌ عن هذا

163
00:09:37,830 --> 00:09:39,140
نرجسيّة؟

164
00:09:40,110 --> 00:09:41,630
من كانَ هذا؟

165
00:09:42,650 --> 00:09:44,400
الحلُّ لكُلِّ هذه الأشياء هو ريزي تشان

166
00:09:44,400 --> 00:09:46,020
أنا لا أبدو هكذا

167
00:09:46,020 --> 00:09:48,000
الشاه في خطر

168
00:09:48,000 --> 00:09:49,650
أنا لم أنتهِ بَعد

169
00:09:49,650 --> 00:09:54,850
إن خسِرت تشيا تشان سوف يُقضى على هيبَتي كأخت كبرى

170
00:09:56,340 --> 00:09:57,720
بقينا نحنُ الاثنتان فقط

171
00:09:58,660 --> 00:10:01,620
ما رأيُكِ أن نتمرّن باللوح الآن؟

172
00:10:01,940 --> 00:10:06,190
أفضل أن نتمرن بإمساك يدي

173
00:10:06,190 --> 00:10:08,870
إنَّ ريزي سينباي طفوليّة أكثر مِمّا توقّعت

174
00:10:17,050 --> 00:10:20,980
كنتُ أظنُّ أنَّكِ جيّدة في كُلِّ الرِّياضات يا سينباي

175
00:10:20,980 --> 00:10:23,460
لم يكُن لديَّ فُرصةً للسِّباحة

176
00:10:23,460 --> 00:10:25,110
لم يكُن يوجد في مدرستنا صفوفٌ للسِّباحة

177
00:10:26,380 --> 00:10:30,470
تعلُّم السِّباحة من شخصٍ أصغر مِنّي هو أمرٌ مُحرجٌ بعض الشّيء

178
00:10:30,470 --> 00:10:34,270
ولكنَّها ليست مُحرَجة من سحبي لها من يديها؟

179
00:10:35,040 --> 00:10:38,520
سوف أصبح جيّدةً كِفاية لكي أنقذكِ إن غرقتِ

180
00:10:38,520 --> 00:10:41,150
...لأستطيع أن أزعجكِ بمثل

181
00:10:44,110 --> 00:10:45,540
هل بدأ التَّطبيق العمليّ بهذه السُّرعة؟

182
00:10:45,890 --> 00:10:48,620
توتّرتُ كثيراً فتشنَّجت ساقي

183
00:10:48,620 --> 00:10:52,150
بإمكانكِ فِعلُ هذا يا تشيا، ضَعيها في مرحلة الموت

184
00:10:52,150 --> 00:10:54,130
أنتِ تعنينَ "مات الشاه"؟

185
00:10:54,130 --> 00:10:57,440
إن خسرتِ الآن فسأبدو بشكلٍ سخيف

186
00:10:57,440 --> 00:10:58,570
اهدأ يا تيبي

187
00:10:58,570 --> 00:10:59,490
حسناً

188
00:10:59,490 --> 00:11:02,440
لا يجب أن يتحدّى أيُّ جنديٍّ الملكة

189
00:11:02,440 --> 00:11:04,960
إلى أن يُصبح نبيلاً

190
00:11:04,960 --> 00:11:07,970
هلّا توقّفتِ عن الّلعب بأحجار الّلعبة يا كوكوا تشان؟

191
00:11:07,970 --> 00:11:09,980
الآن يا تشينو، هناك

192
00:11:09,980 --> 00:11:11,940
هيا يا تشيا، خلفكِ تماماً

193
00:11:12,360 --> 00:11:15,940
هيّا، بإمكانكِ فعل هذا

194
00:11:13,580 --> 00:11:15,940
لا أستطيعُ التَّركيز

195
00:11:21,880 --> 00:11:23,420
أنتِ رائعةٌ بالفعل يا سينباي

196
00:11:24,070 --> 00:11:27,370
كلُّ هذا بفضلِ تدريبك

197
00:11:27,370 --> 00:11:30,550
بل لأنَّكِ تتعلّمينَ بسرعة

198
00:11:30,550 --> 00:11:33,420
لم أفعل شيئاً يُذكَر

199
00:11:33,420 --> 00:11:36,760
لم أكُن أعلم أنَّ السِّباحة مِمتعة

200
00:11:36,760 --> 00:11:38,000
شكراً يا شارو

201
00:11:40,390 --> 00:11:41,510
..إذاً، الآن

202
00:11:43,130 --> 00:11:45,760
لنستخدم هذه ونسبح أعمق من قبل

203
00:11:45,760 --> 00:11:49,020
لكني لا أستطيع ذلك يا سينباي

204
00:11:49,420 --> 00:11:50,750
ما هذا؟

205
00:11:50,750 --> 00:11:52,000
إنَّهُ ناعم

206
00:11:52,000 --> 00:11:52,890
يبدو لذيذاً

207
00:11:52,890 --> 00:11:54,940
ما الّذي تفعلهُ هنا؟

208
00:11:54,940 --> 00:11:56,300
أهوَ حيوان المالك الأليف؟

209
00:11:56,300 --> 00:11:57,590
انظروا، إنَّهُ يتمدَّد

210
00:11:57,590 --> 00:11:59,480
بالفعل

211
00:11:57,900 --> 00:12:02,360
ساعديني يا تشينو

212
00:12:05,570 --> 00:12:08,620
المنظرُ في الّليلِ مُدهش، ويُعطي شعوراً رائعاً

213
00:12:09,270 --> 00:12:11,570
الهواءُ في الّليل عليل

214
00:12:13,510 --> 00:12:15,880
وأشعرُ وكأنَّني إن أصغيتُ جيّداً

215
00:12:15,880 --> 00:12:20,350
فسوفَ أعرفُ ماذا يحصل في البلدة بين هذه الأضواء

216
00:12:20,350 --> 00:12:21,760
هذا جميل

217
00:12:21,760 --> 00:12:26,020
يقولُ هذا البيت أنَّ الأخت الصُّغرى سَتُعِدُّ الأرزّ بالكاري الّليلة

218
00:12:26,020 --> 00:12:27,530
كم هذا لطيف

219
00:12:27,530 --> 00:12:29,480
الزَّوجانِ في ذاكَ المنزل

220
00:12:29,480 --> 00:12:30,810
يتشاجرانِ الّليلة

221
00:12:31,650 --> 00:12:32,960
أفسدَ هذا الّلحظة

222
00:12:33,940 --> 00:12:35,570
لقد اشترينا المشروبات

223
00:12:35,570 --> 00:12:37,190
لنتناولها سويّاً

224
00:12:38,270 --> 00:12:40,160
القهوة بالحليب

225
00:12:38,970 --> 00:12:40,580
الفواكه بالحليب

226
00:12:40,580 --> 00:12:42,150
مرحى

227
00:12:42,590 --> 00:12:43,900
!أونيتشان

228
00:12:44,300 --> 00:12:47,060
هكذا تشربينَ القهوة بالحليب

229
00:12:49,160 --> 00:12:50,940
تشينو ربحت؟

230
00:12:59,060 --> 00:13:03,080
يجب أن نرى إن كان الأرنب الزعيم سيحضر القنصلية العامة

231
00:13:03,080 --> 00:13:04,460
أجل

232
00:13:04,460 --> 00:13:06,940
..وذاكَ المشهد بِحبّات القهوة

233
00:13:06,940 --> 00:13:10,070
لا أستطيعُ الإنتظار لكي أرى كيفَ حولوا هذا المشهد إلى فيلم

234
00:13:10,070 --> 00:13:12,380
تبدينَ مُتحمّسةً يا تشيا تشان

235
00:13:12,380 --> 00:13:15,090
بالطّبع، فسوفَ أشاهدُ فيلماً مع الجَميع

236
00:13:15,090 --> 00:13:18,190
يجب أن أشكر تلكَ الزَّبونة الّتي قدّمت لي البطاقات

237
00:13:15,990 --> 00:13:19,050
إن كُنتِ ترغبين

238
00:13:19,050 --> 00:13:21,440
أنا أملكُ بعض البطاقات الإضافيّة

239
00:13:22,060 --> 00:13:24,320
هل تشعرينَ بالنَّعاس يا كوكوا سان ؟

240
00:13:24,320 --> 00:13:30,030
أجل أردت أن أُريَ تشينو تشان نتائج تدريب الأمس

241
00:13:31,040 --> 00:13:31,620
لقد أجرينا امتحاناً بأنواع القهوة

242
00:13:31,620 --> 00:13:34,360
هنا لديكِ الموكا، وهنا بلو ماونتن وإينستانت

243
00:13:34,360 --> 00:13:36,120
ولكنها جميعًا من نوع كيليمانجارو

244
00:13:36,120 --> 00:13:40,170
إذاً، لم تستطيعي النَّوم بعد شُربِ كلّ تلك القهوة؟

245
00:13:40,170 --> 00:13:42,860
كنتُ مُستيقظة طوال الوقت

246
00:13:42,860 --> 00:13:45,320
ماذا؟ هل تقصدين أنَّكِ لم تنامي على الإطلاق؟

247
00:13:45,320 --> 00:13:48,290
هيّا استفيقي، سوف نشاهد فيلماً بعد المدرسة

248
00:13:48,290 --> 00:13:51,390
إن شربتُ بعض القهوة فأظنُّ أنَّني سأصمد حتّى المساء

249
00:13:51,750 --> 00:13:53,050
ماذا؟

250
00:13:53,050 --> 00:13:54,140
بالمُناسبة

251
00:13:54,140 --> 00:13:57,540
سوف نتقابل جميعاً في السّينما أليسَ كذلك؟

252
00:13:57,540 --> 00:13:58,570
أجل

253
00:13:59,790 --> 00:14:01,320
تبدو مُتعَبة

254
00:14:01,750 --> 00:14:04,610
ألم تنَم لأنَّها كانت مُتحمّسة من أجل الفيلم؟

255
00:14:04,610 --> 00:14:08,990
لا أستطيعُ النَّوم قبل الرَّحلات أيضاً

256
00:14:10,350 --> 00:14:13,510
أنا أشعرُ بإرهاقي من العمل الآن

257
00:14:13,510 --> 00:14:16,240
لقد كُنّا مشغولينَ جدّاً البارحة على غيرِ العادة

258
00:14:13,700 --> 00:14:16,240
هلّا تقدّمينَ طلبيّة عند انتهاءكِ من الأطباق؟

259
00:14:16,240 --> 00:14:17,720
أجل

260
00:14:19,540 --> 00:14:21,290
يبدو أن سينباي تشعر بالملل

261
00:14:21,290 --> 00:14:24,860
هل التَّواجد برفقتي مُمِلٌّ لهذه الدَّرجة؟

262
00:14:24,860 --> 00:14:25,990
بالمُناسبة

263
00:14:25,990 --> 00:14:29,130
سوف نتقابل جميعاً في السّينما أليسَ كذلك؟

264
00:14:34,400 --> 00:14:36,230
أشعرُ بالنَّعاس

265
00:14:36,780 --> 00:14:39,900
لم يجدر بي أن أبقى مستيقظة طوال الّليل برفقة كوكوا سان

266
00:14:40,890 --> 00:14:43,100
لا تُصدِرا أصواتاً غريبة أمامي من فضلكما

267
00:14:43,100 --> 00:14:45,780
أنتِ مُتعبةٌ دائماً أليسَ كذلك يا تشينو؟

268
00:14:45,780 --> 00:14:47,780
ليسَ دائماً

269
00:14:47,780 --> 00:14:51,060
فأنا لا أدع الزّبائن يرونَني بهذا الشَّكل

270
00:14:51,060 --> 00:14:54,160
ماذا.. أتُغيّرينَ تعاليمَ وجهكِ عندما تعملين؟

271
00:14:54,570 --> 00:14:58,930
رُبَّما وجودُ تيبي على رأسها، يوقظ جانبا آخر فيها

272
00:14:58,930 --> 00:15:00,050
فهمت

273
00:15:00,050 --> 00:15:01,420
هلّا نظفتما من فضلكما؟

274
00:15:02,250 --> 00:15:07,280
لنفكّر بالأشياء الّتي نستطيعُ وضعها على رأسِ تشينو لكي تستيقظ

275
00:15:07,280 --> 00:15:08,800
..هناكَ أيضاً

276
00:15:08,800 --> 00:15:10,510
هلّا تنسَيان الأمر وتُنَظِّفان من فضلكما؟

277
00:15:15,070 --> 00:15:16,390
..مطر

278
00:15:18,660 --> 00:15:20,190
إنَّها تُمطر

279
00:15:21,390 --> 00:15:25,300
رُبَّما سيكونُ مشاهدة الفيلم بيومٍ آخر أفضل

280
00:15:25,300 --> 00:15:30,350
كلا، إنَّنا في عُطلةٍ جميعاً وهذا لا يتكرَّر

281
00:15:31,080 --> 00:15:32,250
كوكوا تشان

282
00:15:32,670 --> 00:15:33,920
لنذهب يا تشيا تشان

283
00:15:33,920 --> 00:15:36,200
الركض تحت المطر يعطي شعورًا جميلاً

284
00:15:37,370 --> 00:15:38,950
كوكوا تشان

285
00:15:39,820 --> 00:15:42,130
أتساءل من سيصل إلى هناك أوّلاً

286
00:15:44,980 --> 00:15:47,840
أتمنّى أن تكونَ تشينو والآخرينَ بخير

287
00:15:47,840 --> 00:15:49,240
أنا أعتذر

288
00:15:49,240 --> 00:15:51,750
لم أستطع قولَ شيءٍ لكِ لأنَّني رأيتُكِ تستمتعينَ بوقتك

289
00:15:51,750 --> 00:15:54,720
أنا أملكُ هنا مِظلّة

290
00:15:58,030 --> 00:15:59,770
إنَّها تُمطر

291
00:15:59,770 --> 00:16:01,840
لم أحضر معي مِظلّة

292
00:16:01,840 --> 00:16:02,850
إنَّها مُشكلة

293
00:16:03,640 --> 00:16:05,360
هل علينا الإنتظار إلى أن يتوقف المطر؟

294
00:16:05,360 --> 00:16:06,560
أو الإتّصال بأحدٍ ليأخذنا؟

295
00:16:10,090 --> 00:16:12,440
بالمناسبة ، سمعتُ أنَّ الجَّنود

296
00:16:12,440 --> 00:16:16,070
لا يستخدمون المِظلّات لأنَّها تعترضُ طريقهم

297
00:16:16,070 --> 00:16:17,610
هل هذا صحيح؟

298
00:16:18,840 --> 00:16:20,960
لن أستطيعَ التَّصويب بيدٍ واحِدة

299
00:16:22,360 --> 00:16:25,510
هذا صحيح، يدٌ واحِدة للتَّصويب لن تكفي أبداً

300
00:16:26,170 --> 00:16:27,320
سوف أركض

301
00:16:27,320 --> 00:16:28,240
!سينباي؟

302
00:16:28,240 --> 00:16:30,420
لم يجدرُ بي قول ذلك

303
00:16:33,860 --> 00:16:35,550
المعذرة على تأخُّري

304
00:16:35,550 --> 00:16:36,930
تشينو تشان

305
00:16:36,930 --> 00:16:38,700
من الجيّد أنَّكِ وصلتِ

306
00:16:38,700 --> 00:16:41,140
لم نتوقّع أن تُمطِر

307
00:16:41,910 --> 00:16:43,310
إنَّنا مُبلولات جميعاً

308
00:16:43,310 --> 00:16:45,370
أعتقد أنَّ هذا أيقظني

309
00:16:45,370 --> 00:16:47,540
أجل، لم أعُد أشعر بالنَّعاس

310
00:16:47,540 --> 00:16:50,610
نسيتُ كم كنتُ مُتعبةً أيضاً

311
00:16:50,610 --> 00:16:53,070
أظنُّ أنَّني أستطيعُ البقاء صاحية

312
00:16:53,530 --> 00:16:56,290
في الحقيقة، كنتُ أشعر بالنُّعاس أيضاً

313
00:16:56,290 --> 00:16:58,700
ماذا؟ لم تقولي هذا سابقاً

314
00:16:59,950 --> 00:17:02,200
انظرن جميعاً

315
00:17:03,540 --> 00:17:05,770
تُشرقُ الشَّمس من بين الغيوم

316
00:17:06,490 --> 00:17:07,830
هذا جميل

317
00:17:07,830 --> 00:17:09,510
لو كانَ هذا فيلماً

318
00:17:09,510 --> 00:17:11,990
فلن أتفاجأ إن ظهرت النهاية الآن

319
00:17:11,990 --> 00:17:13,470
انتهى ذلك بسرعة

320
00:17:14,150 --> 00:17:16,010
عندما يشعُّ الضَّوء هكذا من بينِ الغيوم

321
00:17:16,010 --> 00:17:18,580
"فهذا يُدعى "أدراج الملاك

322
00:17:19,060 --> 00:17:20,510
هذا جميل

323
00:17:20,510 --> 00:17:24,850
حقّاً؟ فقد قرأتُ أنَّ اسمها مخاط الشّمس

324
00:17:26,980 --> 00:17:27,980
تدمَّرت الّلحظة

325
00:17:29,310 --> 00:17:30,280
مهلاً

326
00:17:30,940 --> 00:17:32,710
استخدمن هذه

327
00:17:32,710 --> 00:17:35,150
إنَّها إضافيّة لم أستعملها في حصّة الرّياضة

328
00:17:35,150 --> 00:17:37,030
كم هي رائعةٌ ريزي تشان

329
00:17:37,500 --> 00:17:39,450
سوف أجفِّفُ شعرك

330
00:17:39,450 --> 00:17:42,540
لستِ مُضطرّةً لهذا فأنا لم أتبلَّل كثيراً

331
00:17:43,030 --> 00:17:44,790
كانت لديك مِظلّة يا تشينو، أليسَ كذلك؟

332
00:17:43,050 --> 00:17:46,910
كفى، يجب علينا تجفيفهُ وإلّا سوف يتجعَّد

333
00:17:45,230 --> 00:17:47,660
أحضرها تيبي من أجلي

334
00:17:46,910 --> 00:17:49,790
ولكنَّكِ لستِ أمّي

335
00:17:47,660 --> 00:17:49,050
إنَّهُ مفيدٌ جدّاً

336
00:17:50,170 --> 00:17:52,200
هلاّ دخلنا؟

337
00:17:52,200 --> 00:17:54,540
سأذهب لأشتري بعض الفُشار

338
00:17:54,540 --> 00:17:56,420
هل يريدُ أحدٌ مشروباً؟

339
00:17:56,420 --> 00:17:59,540
أُعامَلُ كالطِّفلة طوالَ الوقت

340
00:17:57,480 --> 00:18:00,940
المعذرة، أريدُ فُشاراً واثنان من الصودا من فضلك

341
00:17:59,540 --> 00:18:00,940
أعرفُ كيفَ تشعرين

342
00:18:00,940 --> 00:18:03,560
يُصبحُ شعرها مُتجعّداً جداً

343
00:18:06,060 --> 00:18:09,060
لماذا حمَّصتهُ لهذه الفترة الطَّويلة؟

344
00:18:09,060 --> 00:18:11,840
خلال خمسِ دقائق
...بدأت غدد دموعي بـ

345
00:18:09,990 --> 00:18:13,370
أنا سوف أحضنهُ، أمّا أنتَ فاركض

346
00:18:11,840 --> 00:18:13,460
أنا الأختُ الكبرى

347
00:18:13,460 --> 00:18:15,710
لا أستطيعُ البكاء أمامَ تشينو تشان

348
00:18:16,060 --> 00:18:19,070
لا أريدُ أن تراني كوكوا سان وأنا أبكي

349
00:18:19,070 --> 00:18:20,890
سوفَ تسخرُ مِنّي

350
00:18:19,070 --> 00:18:22,660
أنا أرنب، لا أستطيعُ صنعَ القهوة

351
00:18:22,660 --> 00:18:25,160
القهوةُ المُحمَّصة يكونُ طعمها حامِضِيٌّ أكثر

352
00:18:23,000 --> 00:18:24,370
تشينو تشان

353
00:18:25,160 --> 00:18:26,990
أنا مُعجبٌ بكَ بعض الشَّيء

354
00:18:26,150 --> 00:18:27,880
هذا صحيح

355
00:18:27,880 --> 00:18:30,210
إن كُنتَ رجُلاً فتصرَّف كرَجُل

356
00:18:27,880 --> 00:18:30,830
من الأفضل أن نكونَ صادقينَ بمشاعرنا

357
00:18:30,210 --> 00:18:32,680
هذه الأسنانُ ليست لطحنِ حبّاتِ القهوة

358
00:18:34,230 --> 00:18:36,330
إنَّها أوَّل مرّة أدخل فيها إلى السّينما

359
00:18:34,460 --> 00:18:37,370
أعطِ كوبي إيواك لها

360
00:18:36,330 --> 00:18:38,540
الشّاشةُ كبيرةٌ جدّاً

361
00:18:37,370 --> 00:18:40,840
..توقّف عن هذا، إن حمَّصتها أكثر من ذلك سوف

362
00:18:38,540 --> 00:18:40,840
أعتقد أنَّها أكبر من شاشاتنا في المنزل

363
00:18:41,210 --> 00:18:45,030
عيناك كبُحيرتان في ضوءِ القمر

364
00:18:45,730 --> 00:18:47,600
أستطيعُ استخدامَ هذا في قائمتنا

365
00:18:46,270 --> 00:18:50,820
إذاً أنتَ القمر الّذي ينعكسُ في البحيرة

366
00:18:48,700 --> 00:18:50,820
اصمُتي يا معِدَتي

367
00:18:50,820 --> 00:18:53,180
أبيضٌ ومُستَدير

368
00:18:51,580 --> 00:18:54,860
كان علي أن أشتري شيئا بدلا من إسكات جوعي

369
00:18:53,180 --> 00:18:58,140
عناق القمر... أنتِ في الحقيقة ملكة الّليل الشرّيرة

370
00:19:06,610 --> 00:19:08,270
رابت هاوس

371
00:19:09,030 --> 00:19:10,790
أتيتُ إلى هنا أخيراً

372
00:19:14,520 --> 00:19:16,580
عندما أرى سيّدي

373
00:19:16,580 --> 00:19:19,670
يجب أن أنظر إلى عينيهِ بكلٍّ ثقة عندما أتكلَّم

374
00:19:22,460 --> 00:19:25,890
شكراً لانتِظارِكُم، ها هيَ السباغيتي بالبطلينوس

375
00:19:27,200 --> 00:19:28,140
أهلاً

376
00:19:28,140 --> 00:19:32,770
نظرتُ في عينيِّ شخصِ غير سيّدي

377
00:19:33,420 --> 00:19:35,320
كانَ  فيلماً رائِعاً

378
00:19:35,890 --> 00:19:37,690
هل نمتِ خلال النِّصف الثّاني؟

379
00:19:37,690 --> 00:19:41,920
لقد كانَ فيلماً رائعاً
كيفَ ستُناقشينَهُ معنا الآن؟

380
00:19:41,920 --> 00:19:44,570
ولكنَّني قرأتُ الكتاب

381
00:19:44,940 --> 00:19:47,330
مازالت لا تتذكَّرهُ جيّداً

382
00:19:47,330 --> 00:19:51,520
ولكن الرَّجل الّذي تحوَّلَ إلى أرنب كانَ رائعا للغاية

383
00:19:52,460 --> 00:19:55,500
والامرأة اليابانيّة المُسِنّة في متجر الحلويّات المُنافس

384
00:19:55,500 --> 00:19:57,840
أثّرَتْ عاطِفتها على قلبي كثيراً

385
00:19:57,840 --> 00:20:00,140
تبدو كقِصَّةٍ سمعتُ عنها من قبل

386
00:20:00,140 --> 00:20:02,340
مع أنهما كانا يتشاجران على أشياء سخيفة جدّاً

387
00:20:02,840 --> 00:20:04,730
كان الرّجل المسّن رائعًا

388
00:20:05,240 --> 00:20:08,740
ولكن ابن النادل الّذي أنقذّ المقهى

389
00:20:08,740 --> 00:20:10,250
بموسيقى الجاز كانَ أروع

390
00:20:10,250 --> 00:20:10,640
ماذا؟

391
00:20:10,640 --> 00:20:12,230
كان يشبه أبي

392
00:20:13,780 --> 00:20:17,270
تيب تعبيري جدًا اليوم

393
00:20:17,270 --> 00:20:19,110
أنا متأكّدة أنَّهُ استمتعَ بالفيلم أكثر مِن الجَّميع

394
00:20:21,930 --> 00:20:23,330
أنا ذاهبةٌ للمرحاض

395
00:20:23,330 --> 00:20:24,450
سوف ننتظر هنا

396
00:20:25,410 --> 00:20:27,270
...عندما تعودُ ريزي تشان

397
00:20:28,020 --> 00:20:28,700
تشينو تشان؟

398
00:20:29,190 --> 00:20:30,290
هل تشعرينَ بالنُّعاس؟

399
00:20:30,290 --> 00:20:32,220
كلا، أنا بخير

400
00:20:32,220 --> 00:20:33,230
هيّاً

401
00:20:34,540 --> 00:20:36,700
سأحملكِ بطريقِ عودتنا للمنزل

402
00:20:36,700 --> 00:20:38,350
أنا لستُ طِفلة

403
00:20:38,350 --> 00:20:40,380
لا بأس، أنا لا أمانع

404
00:20:40,380 --> 00:20:41,960
ولكنَّني أمانع

405
00:20:43,140 --> 00:20:44,680
لا تتأوَّهي أمامي

406
00:20:44,680 --> 00:20:47,550
أنتِ تريدينَ حملي على ظهركِ فقط

407
00:20:47,550 --> 00:20:52,050
ربّما لا يجدرُ بكِ فعل هذا يا كوكوا تشان
ألستِ مُتعبةً أيضاً؟

408
00:20:52,050 --> 00:20:53,810
إن وقعتِ ستحلُّ مُصيبة

409
00:20:55,680 --> 00:20:56,940
في هذه الحالة

410
00:21:01,430 --> 00:21:03,490
هل تلعبن لعبة التّكدّس أو شيءٍ من هذا القبيل؟

411
00:21:07,120 --> 00:21:11,620
طالما أنت نادل في الصَّميم
فحتّى الأرنب يستطيع صنع القهوة

412
00:21:11,970 --> 00:21:15,450
هذه جملةٌ مُقتبسة عن فيلم البارحة

413
00:21:16,430 --> 00:21:19,780
رُبَّما سأحاول أن أصبح نادلة حقيقية  أيضًا

414
00:21:19,780 --> 00:21:22,880
وأنتِ ستكونينَ ساقية الحانة يا ريزي تشان

415
00:21:23,420 --> 00:21:25,130
تتأثّرين بسرعة

416
00:21:26,190 --> 00:21:27,580
ألن يكونَ من العظيمِ أن

417
00:21:27,580 --> 00:21:30,670
نواصل العمل نحنُ الثّلاثة هنا، حتّى عندما نكبر؟

418
00:21:32,470 --> 00:21:35,610
ألا تريدين أن تكوني خبّازة أو مُحامية بعد الآن؟

419
00:21:35,610 --> 00:21:39,350
كنتُ أفكّر، رُبّما ستكونُ كتابة الروايات مُمتِعة أكثر

420
00:21:45,400 --> 00:21:48,120
لماذا أنتِ غاضِبة؟

421
00:21:48,700 --> 00:21:51,020
إن كُنتِ تريدين أن تُصبحي نادلة حقيقيّة

422
00:21:51,020 --> 00:21:53,950
فأخبريني إذاً الفرق بين كل كوب من أكواب القهوة هذه

423
00:23:27,650 --> 00:23:37,560
في الحلقة القادمة: جبلُ آوياما الرّاكد