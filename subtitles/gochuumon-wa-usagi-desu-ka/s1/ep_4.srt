1
00:00:50,150 --> 00:00:54,650
ولكنَّكِ لم تشربي عصير الطَّماطم أيضاً

2
00:00:56,150 --> 00:01:00,270
ولكن هناك أطعمةٌ كثيرة لا تُحبّينها، وهي أكثر مِمّا أكره

3
00:01:00,270 --> 00:01:03,400
يجب أن تُجبري نفسكِ وتأكليها
وإلّا لن تكبُري أبداً

4
00:01:03,400 --> 00:01:05,370
لا داعي لأن تقلقي

5
00:01:05,370 --> 00:01:09,000
عندما أصلُ إلى سِنّك سأصبحُ أطول منكِ

6
00:01:09,340 --> 00:01:10,830
أتعتقدينَ ذلك؟

7
00:01:12,000 --> 00:01:17,740
ولكنَّكِ تحملينَ تيبي على رأسكِ كلّ يوم

8
00:01:17,740 --> 00:01:19,760
هل ستكبُرينَ بهذا الشَّكل؟

9
00:02:53,380 --> 00:02:54,440
صباحُ الخير

10
00:02:56,940 --> 00:02:59,040
صباحُ الخير يا تشينو

11
00:02:59,040 --> 00:03:01,150
صباحُ الخير يا تشينو تشان

12
00:03:05,430 --> 00:03:07,790
مايا سان، ميغو سان

13
00:03:20,950 --> 00:03:23,940
هل اشتقتِ لنا في هذه العطلة؟

14
00:03:23,940 --> 00:03:25,430
أنتِ تُشعِرينَني بالخجل

15
00:03:31,190 --> 00:03:33,560
كم هذا جميل

16
00:03:38,870 --> 00:03:40,190
سوف أتناول هذا

17
00:03:40,190 --> 00:03:41,690
! تشينو

18
00:03:45,640 --> 00:03:46,910
! إنَّها تأكُل الكرَفس

19
00:03:49,770 --> 00:03:54,700
أعتقد أنَّني إذا تناولتُ الأشياء الّتي لا أحبّها سوفَ يكبرُ حجمي

20
00:03:54,700 --> 00:03:57,660
وتحتاجينَ أيضاً إلى الكثير من الطّعام والنَّوم

21
00:03:57,660 --> 00:03:58,880
أحسنتِ يا تشينو تشان

22
00:03:59,250 --> 00:04:04,340
يقولُ لي والِداي أنَّني سأبقى قصيرةً إلى الأبد إن بقيتُ أسهرُ ليلاً

23
00:04:04,790 --> 00:04:07,220
أنا أعرفُ شخصاً ينامُ كثيراً

24
00:04:07,220 --> 00:04:11,480
أهيَ تلكَ الفتاة الجَّميلة الّتي تعملُ في المقهى لديكُم؟

25
00:04:12,670 --> 00:04:16,060
أعتقد أنَّنا عندما ننامُ كثيراً نكبرُ بالفعل

26
00:04:18,480 --> 00:04:19,980
.لم أنَم كثيراً

27
00:04:20,710 --> 00:04:23,730
هذا اليوم مُناسبٌ للقيلولة

28
00:04:24,470 --> 00:04:27,490
لا أستطيعُ تناول شيءٍ يحتوي الكافيين

29
00:04:31,920 --> 00:04:33,790
هذا ليسَ صحيحاً دائماً

30
00:04:35,670 --> 00:04:39,240
إذاً لا بُدَّ من وجود طريقة أخرى عدا النّوم

31
00:04:39,240 --> 00:04:42,200
سمعتُ أنَّنا نصبحُ أطول عندما نقفز

32
00:04:42,200 --> 00:04:44,470
يُقالُ أنَّ الموز جيّدٌ أيضاً

33
00:04:45,680 --> 00:04:48,220
القفز .. الموز

34
00:04:54,940 --> 00:04:55,960
...القفز

35
00:05:10,080 --> 00:05:12,890
أعتقد أنَّ شيئاً جميلاً قد حصلَ معها

36
00:05:12,890 --> 00:05:14,080
كم هذا جميل

37
00:05:18,120 --> 00:05:20,700
أعتقد أنَّ التنطّط ليس كافياً

38
00:05:22,540 --> 00:05:26,100
سوف أقفزُ على الأحجار الحمراء إلى أن أصل للمنزل

39
00:05:40,390 --> 00:05:43,030
..أعتقد أنَّ الحرارة أثّرت على تشينو تشان وجعلت

40
00:05:43,030 --> 00:05:46,530
حرارتُها ترتفع

41
00:05:54,630 --> 00:05:56,040
موز

42
00:05:56,040 --> 00:05:58,200
ستبدأ التّخفيضات بعد عشرة دقائق

43
00:05:58,200 --> 00:05:59,970
لذا يجب أن أُحضر الفاصولياء الصَّغيرة قبلَ هذا

44
00:05:59,970 --> 00:06:03,080
وهناكَ تخفيضٌ على السَّمك

45
00:06:03,080 --> 00:06:06,630
سعر ثلاث بصلات هو 100 يَن، وسِعر نصف الملفوف 50 يَن

46
00:06:06,630 --> 00:06:08,770
..أصبحو هكذا 1500 يَن، إذاً

47
00:06:09,300 --> 00:06:12,160
حسناً، أعتقد أنَّني أستطيع تخفيض التّكلفة لأقل من 1500 يَنّ

48
00:06:12,160 --> 00:06:13,250
شارو سان؟

49
00:06:15,050 --> 00:06:18,990
! حتّى الفتيات الغنيّات تأتينَ إلى المتجر إذاً

50
00:06:18,990 --> 00:06:20,720
ماذا؟ أجل هذا صحيح

51
00:06:21,330 --> 00:06:24,530
ماذا سأفعل؟ لقد اقتربَ موعد التَّخفيضات

52
00:06:24,530 --> 00:06:25,940
هل هناكَ مشكلةٌ ما ؟

53
00:06:27,290 --> 00:06:29,780
أحتاجُ إلى عذرٍ ما في الحال

54
00:06:29,780 --> 00:06:31,370
..حسناً

55
00:06:32,660 --> 00:06:33,840
هذا

56
00:06:33,840 --> 00:06:35,830
أريدُ هذه العلبة الموجودة هناك

57
00:06:35,830 --> 00:06:38,350
ولكنَّها بعيدةٌ جدّاً

58
00:06:38,350 --> 00:06:40,600
من المستحيل أن نصل إليها كِلانا

59
00:06:49,040 --> 00:06:52,140
ما هذا؟
أهوَ نوعٌ جديد من التَّدريب؟

60
00:06:56,790 --> 00:06:57,780
تفضّلي

61
00:06:57,780 --> 00:06:59,350
!ريزي سينباي

62
00:07:00,460 --> 00:07:01,810
يالها من مُصادفة يا ريزي سان

63
00:07:02,310 --> 00:07:05,250
شاهدتُكما وأنتما تتدرّبان من الخارج

64
00:07:05,250 --> 00:07:07,320
هل تقومان بتدريب البقاء؟

65
00:07:08,060 --> 00:07:09,820
إنَّنا نتسوّق فحسب

66
00:07:09,820 --> 00:07:12,820
أنا مسرورةٌ لأنَّني قصيرة

67
00:07:13,740 --> 00:07:15,950
حساءُ حراشف السّلحفاة
يا له من ذوقٍ رفيع

68
00:07:16,480 --> 00:07:18,070
تفضّلي يا تشينو

69
00:07:18,070 --> 00:07:19,200
إنَّهُ خبزٌ بالكرَفس

70
00:07:19,740 --> 00:07:21,330
تفضّلي عصير الطّماطم

71
00:07:23,340 --> 00:07:26,090
لنتغلّب على هذا سويّاً يا تشينو تشان

72
00:07:26,090 --> 00:07:27,160
حسناً

73
00:07:28,020 --> 00:07:29,510
واحد، اثنان

74
00:07:31,420 --> 00:07:32,590
ما الأمر؟

75
00:07:33,310 --> 00:07:34,780
من الّذي ضربكُما؟

76
00:07:35,500 --> 00:07:37,260
عصيرُ الطّماطم

77
00:07:37,260 --> 00:07:38,500
الكرَفس

78
00:07:38,500 --> 00:07:39,060
الخضار؟

79
00:07:40,120 --> 00:07:43,190
كُنّا نُحاول تناول الطّعام الّذي لا نُحبّه

80
00:07:43,780 --> 00:07:46,570
لأنني إن لم أتناول كلّ شيء، فلن أكبُرَ أبداً

81
00:07:47,380 --> 00:07:49,420
أتريدينَ أن تكبُري يا تشينو؟

82
00:07:51,970 --> 00:07:53,260
هكذا إذاً

83
00:07:55,470 --> 00:07:59,210
إن تكلّمتِ بصوتٍ عالٍ فقد تبدينَ أكبر

84
00:07:59,210 --> 00:08:00,750
وهم؟

85
00:08:00,750 --> 00:08:02,790
حسناً، جرّبي الأمر

86
00:08:03,470 --> 00:08:04,540
أهلاً بكم

87
00:08:05,310 --> 00:08:07,240
أ-أهلاً بكم

88
00:08:07,240 --> 00:08:08,760
هذا صوتٌ مُنخفض

89
00:08:10,890 --> 00:08:11,410
أهلاً

90
00:08:11,410 --> 00:08:12,410
ليسَ هكذا

91
00:08:13,110 --> 00:08:13,470
..أهلَ

92
00:08:13,470 --> 00:08:15,180
ارفَعي صوتكِ أكثر

93
00:08:15,180 --> 00:08:21,680
أهلاً بكم

94
00:08:17,160 --> 00:08:17,580
أهلاً

95
00:08:19,390 --> 00:08:19,820
أهلاً

96
00:08:21,680 --> 00:08:22,000
أهلاً

97
00:08:22,000 --> 00:08:26,900
أهلاً بكم

98
00:08:22,740 --> 00:08:24,940
بدأت تشينو تشان تنزعج من هذا

99
00:08:26,900 --> 00:08:27,860
ريزي تشان

100
00:08:31,400 --> 00:08:33,610
أهلاً بكم

101
00:08:36,850 --> 00:08:39,210
سوفَ ألتزمُ بالعمل القديم الشاقّ فقط

102
00:08:39,210 --> 00:08:41,420
لنعملَ بجهدٍ لكي نهزمَ الطّعام الّذي لا نُحبّهُ سويّاً

103
00:08:42,030 --> 00:08:44,760
سوف آكلُ كثيراً وسأنامُ كثيراً

104
00:08:44,760 --> 00:08:47,420
وسأكبرُ وأصبحُ بحجمِ كوكوا سان على الأقلّ

105
00:08:47,420 --> 00:08:51,670
إن حدثَ هذا فستُصبح هي من يُداعبكِ يا كوكوا

106
00:08:52,140 --> 00:08:54,090
لا أظنُّ أنَّني أمانعُ هذا

107
00:08:54,090 --> 00:08:58,140
لن أعانقكِ أبداً لذا لا تقلقي

108
00:08:58,140 --> 00:09:00,680
لا تكبُري أكثر يا تشينو تشان

109
00:09:00,680 --> 00:09:03,270
لا تأكلي، لا تنامي

110
00:09:03,730 --> 00:09:05,360
لا تكوني سخيفة

111
00:09:14,530 --> 00:09:15,950
إنَّها رسالةٌ من تشيا تشان

112
00:09:16,680 --> 00:09:18,920
أعتقد أنَّ حرارة الصّيف قد أثّرت على تشينو تشان

113
00:09:18,920 --> 00:09:21,880
احرصي على أن تأكل جيّداً وتنام

114
00:09:23,090 --> 00:09:24,390
تشينو تشان

115
00:09:24,390 --> 00:09:25,080
ماذا؟

116
00:09:26,290 --> 00:09:30,630
يجب أن تأكلي كثيراً وتنامي

117
00:09:31,850 --> 00:09:33,050
احسمي قراركِ

118
00:09:40,120 --> 00:09:42,100
ما الّذي تفعلهُ تشينو تشان؟

119
00:09:42,470 --> 00:09:44,390
إنَّها تُخبرها عن حظّها

120
00:09:44,390 --> 00:09:46,490
تُصيبُ توقّعاتها في أغلبِ الأوقات

121
00:09:47,780 --> 00:09:50,730
بإمكانها أن تُنافسني بقُدرتي على تنبّؤ الطَّقس

122
00:09:50,730 --> 00:09:52,230
هذا ليسَ سيّئاً على الإطلاق

123
00:09:52,690 --> 00:09:54,480
لماذا تعتبرينَ الأمر على أنَّهُ مُسابقة؟

124
00:09:55,460 --> 00:09:58,340
كيفَ تقومين بقراءة الطّالع؟

125
00:09:58,340 --> 00:10:00,410
الطَّريقة سهلةٌ جدّاً

126
00:10:00,810 --> 00:10:02,910
أوّلاً، تشربين قهوتكِ

127
00:10:03,260 --> 00:10:06,540
ومن ثُمَّ تقلبينَ الفنجان رأساً على عقب

128
00:10:07,090 --> 00:10:10,160
ومن ثُمَّ تقرأين الطّالع باستخدام الأشكال المرسومة

129
00:10:10,160 --> 00:10:11,540
في قعر الفنجان

130
00:10:12,000 --> 00:10:15,300
يُدعى هذا قراءة الطّالع أو كافيدومانسي

131
00:10:15,930 --> 00:10:17,840
كانَ الكافيدومانسي الخاص بجدي يُعرَف

132
00:10:17,840 --> 00:10:20,560
بالدقة لدرجة أخافت الناس

133
00:10:20,560 --> 00:10:23,310
تنفعُ قراءتي في الكابتشينو فقط

134
00:10:23,730 --> 00:10:26,050
هذا رائعٌ جدّاً

135
00:10:26,780 --> 00:10:28,640
أريدُ تجربة هذا أيضاً

136
00:10:33,960 --> 00:10:35,150
حسناً، بالنسبة لتشينو تشان

137
00:10:35,750 --> 00:10:39,010
أنا أرى أرانباً تُمطرُ فوقكِ

138
00:10:39,430 --> 00:10:41,710
لا يبدو هذا لي

139
00:10:41,710 --> 00:10:44,160
ولكن إن كُنتِ مُحِقّة فهذا جميلٌ جداً

140
00:10:44,610 --> 00:10:46,290
أمّا بالنّسبة لريزي تشان

141
00:10:46,800 --> 00:10:48,830
أنا أرى الكثير من النقود

142
00:10:48,830 --> 00:10:51,080
رُبّما سيتغيّر حظّكِ بالنّقود

143
00:10:53,010 --> 00:10:55,170
رُبّما أستطيعُ شراء كلّ ما أريده

144
00:10:55,710 --> 00:10:57,210
..وتيبي

145
00:10:57,770 --> 00:11:02,200
يرتدي ثياباً رائعة ويجذب أنظار الجميع

146
00:11:02,200 --> 00:11:04,300
ما الأمر يا تيبي؟

147
00:11:04,650 --> 00:11:06,920
أعتقد أنَّ تيبي يريدُ أن يقرأ طالعكِ

148
00:11:06,920 --> 00:11:10,440
مسابقة لنرى من الأصح؟

149
00:11:11,830 --> 00:11:14,360
..حظُّ كوكوا غداً هو

150
00:11:15,080 --> 00:11:18,700
لا أعرف إن كانَ مطراً أم رقطات

151
00:11:18,700 --> 00:11:20,860
ومن الأفضل ألّا تذهبي إلى الخارج

152
00:11:21,880 --> 00:11:22,950
تفضّل

153
00:11:22,950 --> 00:11:24,890
كانَ ذلك حظّكِ

154
00:11:24,890 --> 00:11:27,650
حانَ الآن دور ريزي تشان

155
00:11:29,010 --> 00:11:33,070
سوفَ تٌصبحُ ريزي زوجةً جميلة يوماً ما

156
00:11:33,070 --> 00:11:35,170
أنا؟ هذا مُستحيل

157
00:11:35,170 --> 00:11:38,000
لم يكُن طبق التّيراميسو كافياً لها البارحة بعد العشاء

158
00:11:38,000 --> 00:11:40,360
لهذا تسلَّلت إلى المطبخ

159
00:11:40,360 --> 00:11:43,670
أنت متعطّشة للمَوَدّة، وتتأثرين بالمجاملات بسهولة

160
00:11:43,670 --> 00:11:45,510
من الأفضل لكِ أن تتجنبي ذلك

161
00:11:45,960 --> 00:11:47,370
أنتَ كُرةُ فروٍ غبيّة

162
00:11:47,370 --> 00:11:49,960
كانَ هذا مجرّد تقييم شخصي

163
00:11:49,960 --> 00:11:51,890
أعتقد أنَّهُ كانَ مُحِقّاً

164
00:11:51,890 --> 00:11:53,530
لدينا اختبارٌ قريباً

165
00:11:53,530 --> 00:11:54,400
لم أدرس شيئاً أبداً

166
00:11:54,400 --> 00:11:56,560
كافيدومانسار؟

167
00:11:57,910 --> 00:12:00,150
هل هذا مُتعلّقٌ باستحضار الأرواح؟

168
00:12:00,770 --> 00:12:04,890
من أين لكِ بهذه المعرفة
حول هذه الأشياء يا تشيا تشان؟

169
00:12:04,890 --> 00:12:07,130
لقد أخطئتِ، الاسم هو كافيدومانسي

170
00:12:07,580 --> 00:12:09,030
أنا أعتذر

171
00:12:09,030 --> 00:12:13,560
بمناسبةِ ذكر قراءة الطّالع ، يمكنني قراءة الكف

172
00:12:13,560 --> 00:12:17,170
حقّاً، اقرئي كفّي

173
00:12:20,150 --> 00:12:24,360
يبدو أنَّكِ تملكينَ شرّاً مخفيّاً يا كوكوا تشان

174
00:12:24,360 --> 00:12:24,920
شرّ؟

175
00:12:26,880 --> 00:12:28,680
أنا أملكُ البعض منهُ في الواقع

176
00:12:29,740 --> 00:12:31,760
إنَّنا مُتشابهتان إذاً

177
00:12:31,760 --> 00:12:33,140
شر؟

178
00:12:37,000 --> 00:12:39,660
يبدو هذا لذيذاً جدّاً

179
00:12:39,660 --> 00:12:40,530
حقّاً؟

180
00:12:40,900 --> 00:12:44,820
أعددتُ طعامي بنفسي اليوم وأنا فخورةً بهذا

181
00:12:44,820 --> 00:12:47,280
خاصة الطريقة التي تم بها قلي هذا البيض

182
00:12:48,630 --> 00:12:50,160
يا إلهي

183
00:12:52,500 --> 00:12:54,270
المعذرة يا كوكوا تشان

184
00:12:54,270 --> 00:12:57,410
غالباً ما تحمل الغربان آنكو

185
00:12:57,410 --> 00:12:59,040
لا بأس

186
00:12:59,040 --> 00:13:02,940
لطالما أردت تذوق شطائر الخبز بالكفتة الخاصة بالمدرسة

187
00:13:05,930 --> 00:13:07,060
كوكوا تشان

188
00:13:11,060 --> 00:13:12,670
كوكوا تشان

189
00:13:13,320 --> 00:13:15,370
..ولكن .. ولكن

190
00:13:15,370 --> 00:13:17,300
لقد أمسكت بالشطيرة

191
00:13:17,300 --> 00:13:18,460
هذا ليسَ ما أقصده

192
00:13:18,460 --> 00:13:21,460
منذُ أن ذهبتِ إلى الحمّام بعد الغداء

193
00:13:21,460 --> 00:13:24,790
ورقطاتك ظاهرة

194
00:13:28,630 --> 00:13:31,980
كانَ هذا يوماً سيّئاً

195
00:13:31,980 --> 00:13:33,990
تحصلُ الكثير من هذه الأشياء

196
00:13:35,750 --> 00:13:38,550
المعذرة ولكنَّهُ انزلقَ من يدي

197
00:13:38,550 --> 00:13:40,490
كوكوا تشان

198
00:13:42,000 --> 00:13:44,300
من الجيّد أنَّ آنكو لم يبتَلّ

199
00:13:44,300 --> 00:13:45,590
كوكوا تشان

200
00:13:49,880 --> 00:13:51,620
شكراً يا تشيا تشان

201
00:13:51,620 --> 00:13:53,180
كلا، بل أنا من عليهِ أن يشكركِ

202
00:13:53,740 --> 00:13:55,790
لا أستطيعُ أن أسمّي هذا امتناناً

203
00:13:55,790 --> 00:13:58,320
ولكن هل نستطيعُ أن نذهب إلى مقهى شارو تشان؟

204
00:13:58,320 --> 00:13:59,270
سأشتري لك شيئاً

205
00:13:59,650 --> 00:14:01,220
حقّاً؟ هل أنتِ متأكّدة؟

206
00:14:01,220 --> 00:14:02,520
مرحى

207
00:14:03,020 --> 00:14:05,400
ما الّذي أحضرتهِ إلى هنا؟

208
00:14:06,150 --> 00:14:08,740
توقّفي، لا تقتربي منّي

209
00:14:08,740 --> 00:14:12,870
هل هالةُ حظّي سيّئة التّأثير لهذه الدَّرجة؟

210
00:14:13,340 --> 00:14:15,490
كانَ آنكو يعضّها عندما كانت صغيرة

211
00:14:15,490 --> 00:14:18,520
ومنذ ذلك الوقت وشارو تشان تخافُ منه

212
00:14:19,260 --> 00:14:22,120
ماذا؟ آنكو السبب؟

213
00:14:24,820 --> 00:14:26,970
هذا أكثرُ من القليل

214
00:14:27,780 --> 00:14:28,800
شكراً على انتظاركم

215
00:14:31,680 --> 00:14:33,960
لا أصدّق أنَّهُ أتى إلى هنا

216
00:14:33,960 --> 00:14:35,680
هذا ليسَ يوم حظّي بالتّأكيد

217
00:14:36,130 --> 00:14:38,780
...ليس... يوم حظي

218
00:14:38,780 --> 00:14:42,940
لا تقولي ذلك، فقد بدأت بنسيان الأمر

219
00:14:44,360 --> 00:14:47,940
لم أفهم ما قيلَ تماماً، ولكن تباً

220
00:14:49,030 --> 00:14:49,950
هذا الباقي

221
00:14:51,200 --> 00:14:53,240
ما الّذي تفعلينه؟

222
00:14:53,240 --> 00:14:55,360
سوف أقرأُ لكِ كفّكِ

223
00:14:55,770 --> 00:14:57,240
...لنرَ

224
00:14:57,900 --> 00:15:02,480
أنتِ مُعجبةٌ بشخصٍ ما ولكنه لا يملك أية فكرة

225
00:15:02,480 --> 00:15:04,960
أنتِ تواجهين الكثير من العقبات

226
00:15:04,960 --> 00:15:08,130
ولديكِ حظٌّ مُريع مع النّقود

227
00:15:06,110 --> 00:15:08,130
لا تقولي المزيد أيّتها الحمقاء

228
00:15:09,390 --> 00:15:11,130
تشينو تشان، ريزي تشان

229
00:15:11,130 --> 00:15:13,390
هل تحقق أي شيء مما تنبأت لك اليوم؟

230
00:15:16,580 --> 00:15:19,270
كلا، لم يحصل أيّ شيءٍ معي

231
00:15:19,820 --> 00:15:21,460
حسناً

232
00:15:21,460 --> 00:15:25,650
لقد سقط آنكو عليّ من السماء
وارتفعت تنّورتي كثيراً

233
00:15:25,970 --> 00:15:28,570
ورمَت شارو تشان نقوداً عليّ

234
00:15:28,570 --> 00:15:29,650
كانَ هذا مُريعاً

235
00:15:30,140 --> 00:15:32,730
أعتقد أنَّ تيبي هو الّذي فاز في مسابقة قراءة الطّالع

236
00:15:32,730 --> 00:15:35,280
ما خطبكما أنتُما الاثنتان؟

237
00:15:36,060 --> 00:15:38,680
رُبّما لا يجب عليكِ أن تعبثي مع الحظّ

238
00:15:38,680 --> 00:15:39,740
من أجلِ مصلحتكِ

239
00:15:39,740 --> 00:15:40,540
لماذا؟

240
00:15:47,330 --> 00:15:49,300
يا لها من مكتبةٍ كبيرة

241
00:15:50,180 --> 00:15:53,050
تساءلتُ إلى أين كنتِ تحضريننا

242
00:15:53,050 --> 00:15:55,050
هل ذلك المكان في الأعلى جيّد؟

243
00:15:55,050 --> 00:15:56,810
أجل، والرؤية أخّاذة أيضاً

244
00:15:57,580 --> 00:15:59,990
ألم تأتي إلى هنا لكي تدرسي؟

245
00:15:59,990 --> 00:16:02,190
لمَ أتيتِ إلى المكتبة يا تشينو تشان ؟

246
00:16:02,500 --> 00:16:04,180
هناكَ كتابٌ قرأتهُ عندما كنتُ صغيرة

247
00:16:04,180 --> 00:16:05,870
وأريدُ أن أقرأهُ مُجدّداً الآن

248
00:16:06,380 --> 00:16:09,140
ولكنَّني لا أذكرُ اسمه

249
00:16:09,140 --> 00:16:11,270
هل تذكرينَ ما هو موضوعه؟

250
00:16:13,370 --> 00:16:16,340
أرادَ أرنبٌ أن يصبح بطلا

251
00:16:16,340 --> 00:16:18,970
لذا هزم أرنباً شريرا

252
00:16:18,970 --> 00:16:20,830
لكن بعض الأرانب تورطت بالرغم من أن لا دخل لها

253
00:16:20,830 --> 00:16:23,460
وهناك كانت المشكلة

254
00:16:23,780 --> 00:16:26,710
ثمّ يظهرُ فجأة أرنبٌ آخر ليلاحق البطل

255
00:16:26,710 --> 00:16:29,070
لقد تقاتلا أثناء القصّة

256
00:16:29,070 --> 00:16:31,650
...ولكن في النّهاية

257
00:16:29,070 --> 00:16:32,470
إنَّها تذكرهُ جيّدا ولكن تريدُ أن تقرأهُ من جديد

258
00:16:32,850 --> 00:16:33,520
بالتفكير في الأمر

259
00:16:33,520 --> 00:16:35,970
لقد قُلتِ أنَّهُ سيكونُ لديكِ إمتحانٌ قريباً أليسَ كذلك يا تشينو تشان؟

260
00:16:36,360 --> 00:16:39,300
لمَا لا تدعينَ شارو تشان تساعدكِ؟

261
00:16:39,300 --> 00:16:41,020
شارو سان؟

262
00:16:41,020 --> 00:16:41,600
أجل

263
00:16:42,100 --> 00:16:44,940
إنَّها طالبةٌ بمِنحةٍ دراسيّة ولديها علاماتٌ عالية جدّاً

264
00:16:44,940 --> 00:16:45,730
بالإضافة إلى أنَّ تعليمها ممتاز

265
00:16:45,730 --> 00:16:47,730
هذا مُذهلٌ للغاية

266
00:16:48,190 --> 00:16:50,320
إنَّها جميلةٌ وذكيّة

267
00:16:50,320 --> 00:16:52,340
ولا عيوب لديها

268
00:16:52,340 --> 00:16:53,360
إنَّها تعميني

269
00:16:53,740 --> 00:16:55,700
...على العكس

270
00:16:56,050 --> 00:16:59,680
وهي شابّةٌ غنيّةٌ جدّاً، إنَّها مثاليّةٌ بالفعل

271
00:16:59,680 --> 00:17:01,140
!إنها تعمينا

272
00:17:02,380 --> 00:17:05,080
شكراً على مساعدتكِ اليوم يا كوكوا سان

273
00:17:06,520 --> 00:17:08,330
ألن تساعديها يا تشيا؟

274
00:17:08,720 --> 00:17:10,230
كلا، كلا

275
00:17:10,760 --> 00:17:12,750
سوفَ تقومُ بمُساعدَتي

276
00:17:12,750 --> 00:17:13,770
أنتِ تمزحينَ صحيح؟

277
00:17:13,770 --> 00:17:16,470
أنا بارعةٌ بالرّياضيّات والفيزياء

278
00:17:16,850 --> 00:17:20,350
لماَ لا تُساعدين تشينو تشان في دراستها إذاً؟

279
00:17:21,880 --> 00:17:25,100
...مستواي عادي مقارنة بالترتيب العام

280
00:17:25,450 --> 00:17:28,530
هل هناكَ مواد أخرى تُسيءُ إلى مستواكِ؟

281
00:17:28,530 --> 00:17:29,980
هذه

282
00:17:30,300 --> 00:17:32,770
إنَّها سيّئة في العلوم الإنسانية

283
00:17:32,770 --> 00:17:35,400
...أقرأ الكثير من الكتب ولكن

284
00:17:35,860 --> 00:17:39,280
لا يُمكنني الاعتماد على طريقة كوكوا سان في التّعليم

285
00:17:39,280 --> 00:17:40,280
ماذا؟

286
00:17:40,280 --> 00:17:43,780
حقّاً؟ ولكن من السّهل فهمها

287
00:17:43,780 --> 00:17:46,160
هذا لأنكما متشابهتان

288
00:17:46,160 --> 00:17:48,320
هذا لأننا صديقتان حميمتان، أليس كذلك؟

289
00:17:48,320 --> 00:17:49,560
أجل

290
00:17:50,020 --> 00:17:52,360
لننسَ أمرهما ولندرس سويّاً يا تشينو تشان

291
00:17:52,360 --> 00:17:53,550
حسناً

292
00:17:54,070 --> 00:17:57,960
ولحلِّ المُشكلة، اكتُبي الجّواب الّذي حصلتِ عليه في الجّواب الأخير

293
00:17:59,430 --> 00:18:02,310
طريقةُ تدريسكِ سهلةٌ جدّاً بالفعل

294
00:18:02,690 --> 00:18:04,180
أنا سعيدةٌ جدّاً

295
00:18:04,180 --> 00:18:07,810
لو كانَت لي أختٌ صغيرةٌ مثلكِ لدرّستُها كلّ يوم

296
00:18:08,810 --> 00:18:11,820
أتمنّى لو كانَت لي أختٌ كُبرى مثلك أيضاً

297
00:18:11,820 --> 00:18:14,820
أنا غيرُ مرغوبٍ بي

298
00:18:14,820 --> 00:18:16,950
!عليك التزام الهدوء في المكتبة

299
00:18:17,310 --> 00:18:21,570
إلى أيِّ ثانويّةٍ ستذهبين؟ إلى مدرستنا أم مدرسة شارو تشان

300
00:18:21,570 --> 00:18:23,330
عندما تكبُرين؟

301
00:18:23,770 --> 00:18:26,580
ستبدينَ رائعة بزِيّنا يا تشينو تشان

302
00:18:26,580 --> 00:18:29,710
ستبدو ظريفةً جدّاً بالسُّترة

303
00:18:29,960 --> 00:18:33,050
أظنّها ستبدو أكثر أناقة وهي ترتدي الهاكاما

304
00:18:33,050 --> 00:18:34,420
من أيّ زمنٍ أتيتِ؟

305
00:18:34,960 --> 00:18:40,090
باستبعاد الهاكاما، سأقرر ذلك قريباً

306
00:18:40,090 --> 00:18:41,510
من الصّعب أن أختار

307
00:18:41,510 --> 00:18:44,720
ليسَ من السّهل أن تختاري قرارات مستقبلكِ

308
00:18:45,030 --> 00:18:46,900
المُستقبل؟

309
00:18:46,900 --> 00:18:50,480
أريدُ أن أكون مُحاميةً أو خبّازة

310
00:18:51,120 --> 00:18:54,390
أدعى كوكوا
وأنا المُحامية الرّسميّة للبلدة

311
00:18:54,390 --> 00:18:55,610
هناكَ شيءٌ غريب حيال هذا

312
00:18:55,610 --> 00:18:58,310
مهلاً، لقد أخطأت

313
00:18:58,790 --> 00:18:59,590
دَعنني أبدأ من جديد

314
00:19:00,270 --> 00:19:04,010
أدعى كوكوا
وأنا المُحامية الرّسميّة للبلدة

315
00:19:04,010 --> 00:19:06,240
ولكن المُشكلة ليست برأسكِ وجسدكِ

316
00:19:06,240 --> 00:19:08,790
هذا حلمٌ مُدهشٌ يا كوكوا تشان

317
00:19:10,410 --> 00:19:11,950
ما هو حلمكِ يا تشيا تشان؟

318
00:19:13,000 --> 00:19:14,170
...حلُمي

319
00:19:14,590 --> 00:19:19,530
هو أن أجعل آما أوسا آن أكثر شُهرةً بمواهبي الخاصة

320
00:19:19,530 --> 00:19:20,430
مثلي تماماً

321
00:19:21,230 --> 00:19:24,400
أريدُ أن أستلم عمل العائلة كُلّهُ و أصبحَ نادلةً جيدة

322
00:19:24,400 --> 00:19:26,470
النوادل رائعونَ للغاية

323
00:19:26,470 --> 00:19:28,520
بإمكانكِ فعل هذا يا تشينو تشان

324
00:19:29,240 --> 00:19:33,350
حاليّاً، أريدُ أن أتخلّص من فقري فقط

325
00:19:33,350 --> 00:19:34,100
لقد قرَّرت

326
00:19:34,730 --> 00:19:38,620
سوف أصبح مُحامية نادلة رسمية للبلدة

327
00:19:38,620 --> 00:19:41,490
انسي جملة "البلدة الرسمية" لو سمحتِ

328
00:19:44,750 --> 00:19:46,910
أينَ هو كِتاب تشينو تشان؟

329
00:19:47,420 --> 00:19:51,850
بوجودِ كلّ هذه الكتب، من الصّعب إيجاده

330
00:19:51,850 --> 00:19:54,310
العدالة .. الشرّ

331
00:19:55,660 --> 00:19:58,250
أظنُّ أنَّني أعرفُ اسمَ الكتاب

332
00:19:58,250 --> 00:20:00,130
حقّاً؟

333
00:20:00,600 --> 00:20:02,740
لم أدرك ذلك من قبل

334
00:20:02,740 --> 00:20:05,760
ولكن يبدو أنَّ أذواقنا مُتشابهة في الكتب

335
00:20:20,220 --> 00:20:23,550
لو ذهبتُ إلى ذات مدرستكِ

336
00:20:24,250 --> 00:20:25,870
كيفَ ستكونُ حياتي الآن؟

337
00:20:26,850 --> 00:20:30,500
هل أنتِ نادمة لاختياركِ المدرسة الّتي ترتادينها؟

338
00:20:30,500 --> 00:20:35,330
لو كنتُ فقط بذاتِ عُمر ريزي سينباي

339
00:20:35,700 --> 00:20:37,550
هذا يعني أنَّها نادِمة

340
00:20:38,790 --> 00:20:41,130
من المُمِلّ أن يذهب الشّخص إلى

341
00:20:41,130 --> 00:20:45,180
مدرسةٍ خاصّة لكي يعلّموننا جيّداً

342
00:20:46,180 --> 00:20:47,160
لو كنتُ مكانك

343
00:20:47,160 --> 00:20:50,350
لأرهقتُ نفسي وأنا أحاول التصرُّف كما الآنسات الراقيات

344
00:20:51,240 --> 00:20:51,930
..ولكن، مهلاً

345
00:20:52,950 --> 00:20:56,810
إن ذهبتِ إلى ذات مدرستنا

346
00:20:58,250 --> 00:20:59,690
إن قمت بذلك؟

347
00:20:59,690 --> 00:21:01,410
لكان العدد الفردي

348
00:21:01,410 --> 00:21:04,390
قد أجبرَنا أنا وكاكوا-تشان على حضور صفَّين مختلفَين

349
00:21:04,390 --> 00:21:06,050
أنا لا أريدُ هذا

350
00:21:07,080 --> 00:21:08,730
أنا أمزحُ فقط

351
00:21:08,730 --> 00:21:11,700
توقّفي عن التّلاعب بي

352
00:21:12,960 --> 00:21:16,310
لكنك تفهمين الأمر أليس كذلك؟

353
00:21:17,480 --> 00:21:20,800
بإمكاننا أن نتقابل خارج المدرسة

354
00:21:20,800 --> 00:21:24,470
سنكونُ معاً دائماً حتّى حينَ نكبر

355
00:21:29,060 --> 00:21:30,220
أجل

356
00:21:31,190 --> 00:21:33,220
أظنُّ أنَّهُ كان هنا

357
00:21:34,680 --> 00:21:35,950
وجدته

358
00:21:35,950 --> 00:21:36,980
هذا رائع

359
00:21:39,000 --> 00:21:41,820
هل سأكونُ أختاً يُعتمدُ عليها هذه المرّة؟

360
00:21:41,820 --> 00:21:43,050
كوكوا سان؟

361
00:21:45,500 --> 00:21:47,280
أنا سعيدةٌ أنا وجدناه

362
00:21:49,270 --> 00:21:50,660
كوكوا سان

363
00:21:53,370 --> 00:21:54,870
هذه ليست القصّة الصَّحيحة

364
00:23:26,900 --> 00:23:36,720
في الحلقة القادمة: كوكوا ونيّة القتل دونَ حِقد

365
00:23:27,620 --> 00:23:30,990
عندما كنتُ شاباّ، كان صديقي في الجيش

366
00:23:30,990 --> 00:23:32,890
لذا ضمَّ تدريبي الكثير من الأشياء بما فيها الهزازات

367
00:23:32,890 --> 00:23:34,860
ولكنَّني نادل عادي، صدِّقني

368
00:23:34,860 --> 00:23:36,070
أصدّقُ ماذا؟