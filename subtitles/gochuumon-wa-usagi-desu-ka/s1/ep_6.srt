1
00:00:05,990 --> 00:00:09,690
لدى مقهانا "رابت هاوس" عامليْن بدوام جزئي

2
00:00:10,370 --> 00:00:14,070
هذه كوكوا سان
لقد انتقلت للعيش هنا هذا الربيع

3
00:00:14,570 --> 00:00:16,570
وهذه ريزي سان

4
00:00:17,480 --> 00:00:18,990
أعتذرُ عن التّأخير

5
00:00:21,540 --> 00:00:22,700
استمتعا

6
00:00:23,880 --> 00:00:26,520
أليست تلك الفتاة ذات الضفيرة جذابة؟

7
00:00:26,520 --> 00:00:28,960
أجل إنّها كذلك، ومظهرُ شعرها يلائمها جدّاً

8
00:00:32,150 --> 00:00:35,800
حسناً، لا يجب أن أنصت إلى ملاطفات الزَّبائن هكذا

9
00:00:37,560 --> 00:00:38,930
لا يجب أن أعيرهم إهتماماً

10
00:00:39,760 --> 00:00:42,520
تستعملُ ريزي سان زجاجَ النّافذة كمِرآة

11
00:00:44,980 --> 00:00:47,070
ما الأمر؟

12
00:00:47,070 --> 00:00:48,800
ماذا على رأسك؟

13
00:00:48,800 --> 00:00:51,650
إنَّ تيبي يُجرّبُ صورةً جديدةً هذا الشَّهر

14
00:00:52,110 --> 00:00:54,170
تبدو الضفيرة ظريفة

15
00:00:54,170 --> 00:00:56,110
عن أي منا كانت تلك الفتاتان تتحدثان؟

16
00:00:57,260 --> 00:00:59,370
لقد قالت منذُ قليل أنَّها لن تُعيرَ اهتمامها لأحد

17
00:01:00,260 --> 00:01:02,980
أعتقد أنَّ قلب الفتاة المُراهقة مُعقّد

18
00:02:36,790 --> 00:02:38,630
الطَّقسُ جميلٌ اليوم

19
00:02:39,400 --> 00:02:42,530
من الجيّد أن أعمل على سفينتي الموجودة في القارورة تحت أشعّة الشَّمس

20
00:02:42,530 --> 00:02:44,010
لنذهب بنُزهة

21
00:02:44,610 --> 00:02:47,800
أحبُّ البقاء في المنزل أيّام العُطَل

22
00:02:47,800 --> 00:02:52,020
سوفَ تنتهي سفينتي في القارورة عمّا قريب

23
00:02:52,580 --> 00:02:56,280
أنهِ العمل في المُتنزّه
وبإمكاننا جعلها تطفو في النَّهر

24
00:02:57,960 --> 00:03:01,780
هل تعرفينَ ماذا تعني سفينةٌ في قارورة؟

25
00:03:06,430 --> 00:03:09,290
بإمكانكِ أن ترى البلدة بأكملها من على هذه الهضبة

26
00:03:09,760 --> 00:03:12,290
يالهُ من منظرٍ رائع

27
00:03:12,710 --> 00:03:17,880
لو كانت لديّ درّاجة لوضعتك في المقعد
الخلفي وقدتها نزولا عن هذه الهضبة

28
00:03:18,470 --> 00:03:20,770
الرّكوب الثُّنائي للدرّاجة غيرُ مسموح

29
00:03:20,770 --> 00:03:22,380
ولكن أوّلاً

30
00:03:22,700 --> 00:03:25,390
يجب أن أتعلّم قيادة الدراجة

31
00:03:29,140 --> 00:03:32,120
لطالما أردتُ أن أتدرّب على هذا تحت ضوء غروب الشمس

32
00:03:32,120 --> 00:03:33,900
وأن أقع مِراراً وتكراراً

33
00:03:34,330 --> 00:03:37,400
إنَّها تستمرُّ بتغيير الموضوع

34
00:03:41,180 --> 00:03:42,510
إنَّها ريزي تشان

35
00:03:43,340 --> 00:03:45,120
إنَّها تشتري ثياباً

36
00:03:45,750 --> 00:03:47,950
هذه الثّياب تُلائمها كثيراً

37
00:03:48,720 --> 00:03:51,790
هذا النّوعِ من الثّياب لا نرتديهِ غالباً

38
00:03:53,110 --> 00:03:54,540
لقد ابتسمت قليلا

39
00:03:55,370 --> 00:03:57,670
يبدو أنَّها وجدت شيئاً أعجبها

40
00:04:01,170 --> 00:04:04,350
يبدو أنَّها مُنزعجة بخصوص شيءٍ ما

41
00:04:04,350 --> 00:04:06,550
لنتركها وشأنها

42
00:04:14,290 --> 00:04:16,910
الجوُّ لطيفٌ ودافئ

43
00:04:16,910 --> 00:04:20,720
أجل، هناكَ رائحةٌ حلوة أيضاً

44
00:04:21,280 --> 00:04:23,450
...بما أنك ذكرت الأمر

45
00:04:23,450 --> 00:04:26,530
إنَّهُ كُشك الفطائر المحلاة

46
00:04:26,970 --> 00:04:29,550
سأشتري لكِ واحدةً يا تشينو تشان

47
00:04:29,550 --> 00:04:30,540
هل أنتِ مُتأكّدة؟

48
00:04:30,890 --> 00:04:33,000
اترُكي الأمر لأختكِ الكبرى

49
00:04:34,270 --> 00:04:35,620
شارو تشان؟

50
00:04:36,250 --> 00:04:38,660
كوكوا؟ تشينو تشان؟

51
00:04:38,660 --> 00:04:41,220
لم أكُن أعلم أنَّكِ تقومينَ بعملٍ كهذا

52
00:04:41,220 --> 00:04:43,130
من المؤكَّد أنَّهُ لديكِ اهتماماتٌ كثيرة

53
00:04:43,130 --> 00:04:45,110
هذا صحيح

54
00:04:45,110 --> 00:04:47,180
!لديَّ اهتماماتٌ كثيرة
هل هذا سيّئ؟

55
00:04:48,250 --> 00:04:49,680
تفضّلا

56
00:04:49,680 --> 00:04:52,930
شكراً لكِ، حانَ وقتُ الأكل

57
00:04:55,900 --> 00:04:57,320
إنَّهُ لذيذ

58
00:04:57,320 --> 00:04:59,150
تفضّلي يا شارو تشان، تذوقي القليل

59
00:04:59,490 --> 00:05:01,770
ولكنَّني أعمل

60
00:05:01,770 --> 00:05:03,900
هيّا، مُجرَّد قضمة

61
00:05:05,360 --> 00:05:07,410
قضمةٌ واحدة

62
00:05:07,950 --> 00:05:12,170
أنا لا أجد فرصة لأكل الفطائر المحلاة

63
00:05:16,270 --> 00:05:17,880
سقط آنكو من السَّماءِ مُجدَّداً

64
00:05:18,310 --> 00:05:21,500
أكان عليك السقوط على الفطائر المحلاة دونما مكان آخر؟

65
00:05:22,270 --> 00:05:23,510
أليس كذلك يا شارو تشان؟

66
00:05:24,440 --> 00:05:27,260
هل تفاجأت أكثر مني؟

67
00:05:27,260 --> 00:05:29,260
مهلاً

68
00:05:29,740 --> 00:05:31,780
وأخيراً لحقت بك

69
00:05:31,780 --> 00:05:35,640
هل حملت الغربان آنكو مجددا يا تشيا تشان؟

70
00:05:36,210 --> 00:05:38,860
هذا ليسَ لباسكِ المُعتاد؟

71
00:05:38,860 --> 00:05:40,170
هل لاحظتِ هذا؟

72
00:05:40,890 --> 00:05:44,280
موضوعنا هذا الشَّهر هو الرَّجعيّة الحديثة

73
00:05:44,280 --> 00:05:46,200
ألا تعتقدين أنَّ مقهى آما أوسا سيُصبح

74
00:05:46,200 --> 00:05:49,040
أكثر حيويّة من فلور دو لابان يوماً ما؟

75
00:05:49,720 --> 00:05:51,080
حقّاً؟

76
00:05:51,540 --> 00:05:52,790
..إذاً

77
00:05:53,440 --> 00:05:54,710
سوف أخلعه

78
00:05:54,710 --> 00:05:56,660
لا تخلعيهِ هُنا

79
00:05:59,880 --> 00:06:02,710
هذا جميلٌ ولطيف

80
00:06:03,140 --> 00:06:07,210
أنا بخير، فأنا لديَّ تيبي

81
00:06:07,210 --> 00:06:10,510
أعتقد أنَّها قالت أنَّ الحيوانات لا تُحبها

82
00:06:10,830 --> 00:06:15,110
أراهنُ أنها تظن أن فمك وشعرك يشبهان خاصتها

83
00:06:15,110 --> 00:06:17,270
لذا تحتقر بعضها

84
00:06:17,270 --> 00:06:19,460
هل تعلمينَ ماذا يعني ذلك؟

85
00:06:20,240 --> 00:06:25,510
لذا، إن عانقتكِ فلن تكوني وحيدة وسيُحلُّ كُلَ شيء

86
00:06:27,340 --> 00:06:30,110
هذا لا يحلُّ شيئاً

87
00:06:30,110 --> 00:06:31,910
تشينو تشان

88
00:06:32,480 --> 00:06:34,770
مايا سان، ماغو سان

89
00:06:34,770 --> 00:06:36,700
ذهبنا لمُشاهدة فيلم

90
00:06:36,700 --> 00:06:38,180
حقا؟

91
00:06:38,180 --> 00:06:42,690
لو علمنا أنَّكِ في عُطلة لكُنّا دعوناكِ

92
00:06:42,690 --> 00:06:44,920
تعالي معَنا في المرَّةِ القادمة، اتفقنا؟

93
00:06:45,390 --> 00:06:46,300
حسناً

94
00:06:46,720 --> 00:06:49,430
بالمُناسبة، مانوع الفيلم الّذي شاهدتُماه؟

95
00:06:49,430 --> 00:06:52,640
قلتُ أنَّني أريدُ مُشاهدة فيلم حركة

96
00:06:52,640 --> 00:06:54,170
ولكن ميغو قالت

97
00:06:54,170 --> 00:06:56,290
هذا الفيلم مشهورٌ جدّاً الآن

98
00:06:56,290 --> 00:06:57,930
إنَّهُ يجعل الشَّخص يذرف الدّموع

99
00:06:58,540 --> 00:07:00,640
حتّى أنَّني اشتريتُ كُتَيِّباً

100
00:07:00,640 --> 00:07:03,680
يمكنني أن أنسب هذا العنوان

101
00:07:05,590 --> 00:07:07,110
كوكوا سان؟

102
00:07:09,440 --> 00:07:11,360
انتظر، انتظر

103
00:07:15,880 --> 00:07:17,340
أمسكتُ بك

104
00:07:17,830 --> 00:07:20,620
هذا لونٌ غيرُ اعتياديّ لأرنب

105
00:07:25,800 --> 00:07:27,550
اجلسي هنا إن أردتِ

106
00:07:28,250 --> 00:07:29,790
هل أستطيعُ هذا حقّاً؟

107
00:07:33,540 --> 00:07:34,980
هل كُنتِ تتنزّهين؟

108
00:07:34,980 --> 00:07:39,350
أجل، كنتُ أتجوّل لكي أجِد فِكرة

109
00:07:39,350 --> 00:07:40,350
فِكرة؟

110
00:07:40,740 --> 00:07:43,350
أنا كاتبة روايات

111
00:07:43,680 --> 00:07:46,580
كاتبةُ روايات؟ هذا رائع

112
00:07:47,290 --> 00:07:49,230
ما الاسم المُستعار الّذي تستخدمينه؟

113
00:07:49,580 --> 00:07:53,270
اسمي هو آوياما بلو ماونتن

114
00:07:54,070 --> 00:07:55,870
يالهُ من اسمٍ غريب

115
00:07:56,230 --> 00:08:00,410
كتبتُ روايةً تحوّلت إلى فيلم منذُ فترةٍ وجيزة

116
00:08:00,410 --> 00:08:01,730
هذا مُذهل

117
00:08:03,590 --> 00:08:07,220
بصفتي محامية النوادل الدولية للبلدة

118
00:08:07,220 --> 00:08:11,590
رُبَما أستطيعُ أن أعمل ككاتبة روايات بينما أقومُ بالخَبْز أيضاً

119
00:08:11,590 --> 00:08:13,340
كوكوا سان

120
00:08:14,360 --> 00:08:16,090
تشينو تشان تبحثُ عنّي

121
00:08:16,090 --> 00:08:19,450
حسناً، أراكِ لاحقاً
سأذهب لكي أتجوّل

122
00:08:19,880 --> 00:08:21,150
استمتعي بوقتك

123
00:08:21,640 --> 00:08:23,060
كنتُ أبحثُ عنكِ

124
00:08:23,380 --> 00:08:24,730
أعتذرُ عن هذا

125
00:08:25,380 --> 00:08:29,200
أليسَ لديكِ مُشكلة بالتَحدُّث مع الغُرباء؟

126
00:08:29,620 --> 00:08:32,820
أنتِ تتحدّثينَ مع الزّبائن في القهى أيضاً

127
00:08:33,670 --> 00:08:36,420
لا أستطيعُ أن أتحدّث مع أحد خارج المقهى

128
00:08:36,960 --> 00:08:39,280
انا لستُ جيّدةً بالتكلُّم

129
00:08:39,790 --> 00:08:41,910
ولكن بدَوتِ وكأنَّكِ تستمتعين

130
00:08:41,910 --> 00:08:43,540
عندما تحدّثتِ مع أصدقاءكِ منذُ قليل

131
00:08:44,680 --> 00:08:48,950
لو لم يقوما ببدء الحديث أولا

132
00:08:48,950 --> 00:08:51,430
لما أصبحنا أصدقاء

133
00:08:51,430 --> 00:08:53,550
هذا ليسَ صحيحاً

134
00:08:53,800 --> 00:08:59,220
لو كنتُ أملك موهبة التكلُّم منَ البطن لكنتُ ملكتُ العالَم

135
00:08:59,770 --> 00:09:01,520
حظّاً جيّداً في ذلك

136
00:09:05,330 --> 00:09:07,140
إلى أينَ نذهبُ الآن؟

137
00:09:07,140 --> 00:09:08,600
...لنرَ

138
00:09:09,750 --> 00:09:10,400
ريزي سان؟

139
00:09:10,710 --> 00:09:12,150
أجل؟

140
00:09:12,500 --> 00:09:14,060
! لقد لاحَظاني

141
00:09:16,720 --> 00:09:18,600
لقد أخطأنا بالشَّخص

142
00:09:18,600 --> 00:09:19,880
أنا أعتذر

143
00:09:20,760 --> 00:09:24,160
أجل، شعرها وملابسها تختلفان عما
كانت عليه عندما رأيناها من قبل

144
00:09:24,560 --> 00:09:26,100
هل رأينني؟

145
00:09:26,930 --> 00:09:30,150
لكنك التفتِّ عندما نادينا اسم ريزي تشان

146
00:09:30,150 --> 00:09:32,550
سمعتكما خطأً

147
00:09:32,550 --> 00:09:34,170
..اسمي هو

148
00:09:34,700 --> 00:09:36,550
روزي في الواقع

149
00:09:36,550 --> 00:09:38,370
...هكذا إذاً

150
00:09:38,370 --> 00:09:40,250
مازلتُ مُتفاجئة

151
00:09:40,250 --> 00:09:44,260
هناكَ فتاةٌ تعمل معنا في المقهى، وهي تُشبهكِ كثيراً

152
00:09:44,260 --> 00:09:47,580
حقّاً؟ أودُّ الذّهاب إلى هناك

153
00:09:47,580 --> 00:09:51,430
إنَّهُ يُدعى رابت هاوس، سنَسعَدُ بزيارتك

154
00:09:51,430 --> 00:09:54,260
بالطّبع، سأزوركم في يومٍ ما

155
00:09:54,260 --> 00:09:54,900
إلى الّلقاء

156
00:09:56,520 --> 00:09:59,630
أنا خجولةٌ عند التحدث مع الناس اللذين لا أعرفهم

157
00:09:59,630 --> 00:10:03,490
ولكن لسببٍ ما استطعتُ التكلُّم معها

158
00:10:03,490 --> 00:10:05,160
هذا رائع يا تشينو تشان

159
00:10:05,590 --> 00:10:09,180
هل يُعقل أن يكونَ هذا تأثير كوكوا سان؟

160
00:10:09,180 --> 00:10:11,420
كلا، كانت تلك ريزي

161
00:10:12,150 --> 00:10:14,790
وكأنَّ الأمر لا يكفيني أنَّه تم طلبي لأصبح عارضةً لتسريحات شعر

162
00:10:14,790 --> 00:10:17,970
لم أستطع مقاومة الثّياب الجَديدة التي اشتريت

163
00:10:18,740 --> 00:10:22,440
وجهها كان يريدُ أن يقولَ الحقيقة ولكنَّها لم تستطع هذا

164
00:10:26,600 --> 00:10:28,940
لقد تعبت قدماي

165
00:10:30,060 --> 00:10:32,500
أنا مُرهقة، ولكنَّني استمتعتُ اليوم

166
00:10:33,420 --> 00:10:37,470
تكلّمتُ مع الكثير من الأشخاص مع أنَّني في يومِ عُطلتي

167
00:10:39,570 --> 00:10:40,820
كوكوا سان

168
00:10:41,280 --> 00:10:42,960
أعلمُ

169
00:10:42,960 --> 00:10:45,870
غداً يومٌ مدرسيّ
لذا تريدينَ النوم باكراً صحيح؟

170
00:10:46,460 --> 00:10:47,790
ليلةً سعيدة

171
00:10:52,230 --> 00:10:53,410
جدّي

172
00:10:55,380 --> 00:10:57,800
إنَّهُ في الحانة مع أبي

173
00:11:03,400 --> 00:11:04,430
تفضل

174
00:11:05,850 --> 00:11:08,320
لا يمكنني أن أسترخي اليوم

175
00:11:08,980 --> 00:11:11,810
أود أن أتحدث أكثر

176
00:11:12,630 --> 00:11:15,240
ولكن إن كانَ الأمرُ يُزعجكِ

177
00:11:17,540 --> 00:11:20,860
لماَ لا نُشاهد الفيلم الّذي استعرتهُ من ريزي تشان؟

178
00:11:21,800 --> 00:11:22,530
حسناً

179
00:11:23,140 --> 00:11:25,450
لا أعتقد أنَّها ستكونُ مُحادثةٌ شيّقة

180
00:11:30,740 --> 00:11:31,870
ماذا؟

181
00:11:33,950 --> 00:11:35,340
أعتذر عن التّأخير

182
00:11:35,720 --> 00:11:38,090
لم أستطع إيجاد زيّي

183
00:11:39,030 --> 00:11:40,920
أهلاً بعودتك

184
00:11:41,310 --> 00:11:45,160
زيُّ عملي ! هل تمَّ طَردي؟

185
00:11:46,150 --> 00:11:47,560
مرحباً يا تشينو

186
00:11:47,920 --> 00:11:51,030
هذا الشّيءُ المنفوش ظريفٌ جدّاً

187
00:11:51,030 --> 00:11:53,310
أعتقدُ أنَّني سأحصلُ على نقاطِ خبرة لمُجرّد هزيمة هذا الشّيء

188
00:11:53,850 --> 00:11:57,060
متى صَغُرَ حجمكِ هكذا فجأة يا ريزي تشان؟

189
00:11:57,060 --> 00:11:58,080
صغُر

190
00:11:58,080 --> 00:12:00,030
...مهلا، بد النظر مجددا، أنت لست

191
00:12:00,500 --> 00:12:03,160
هل ريزي هي صاحبةُ هذا الزيّ؟

192
00:12:04,790 --> 00:12:07,360
كانَ هذا موجوداً في خِزانتها

193
00:12:07,360 --> 00:12:09,870
هل تعمل في وظيفةٍ غير قانونية أيضًا؟

194
00:12:10,180 --> 00:12:13,750
تركت ريزي تشان هنا شيئاً ما كانَ يجب تركه

195
00:12:13,750 --> 00:12:16,080
مايا سان، أعطِني تيبي من فضلك

196
00:12:16,720 --> 00:12:19,670
تشينو تشان، أعتذرُ عن تأخيري

197
00:12:20,090 --> 00:12:22,260
ولكن أليست هاتان الفتاتان اللتان التقيناهما البارحة؟

198
00:12:22,770 --> 00:12:27,010
إنَّهما زميلتاي في الصف وهما يُساعِدانني

199
00:12:27,010 --> 00:12:28,200
أنا مايا

200
00:12:28,200 --> 00:12:29,220
وأنا أدعى ميغو

201
00:12:29,630 --> 00:12:31,130
حسناً

202
00:12:31,130 --> 00:12:33,940
شكراً لكما يا مايا تشان ويا ميغو تشان

203
00:12:33,940 --> 00:12:37,560
لا داعي للشُّكر أليسَ كذلك يا ميغو؟

204
00:12:37,560 --> 00:12:40,440
هذا مُمتع، والأزياء ظريفة جدا

205
00:12:40,440 --> 00:12:43,380
أنتما تبدوانِ رائِعَتَين بهما

206
00:12:43,380 --> 00:12:47,530
إن أضّفنا لونَينِ آخَرَين فبإمكاننا مُحاربة الشرّ

207
00:12:47,900 --> 00:12:51,080
حقّاً؟ أريدُ الّلون الأسود

208
00:12:51,080 --> 00:12:52,660
انا أريدُ الأبيض

209
00:12:53,100 --> 00:12:55,410
ولكن ماذا سنُحارب؟

210
00:12:55,410 --> 00:12:57,400
المقاهي المُنافِسة على ما أعتقد

211
00:12:57,400 --> 00:13:00,010
ألن يؤذي هذا عمَلنا؟

212
00:13:01,160 --> 00:13:03,260
يا كوكوا سان

213
00:13:03,260 --> 00:13:07,170
"بإمكانكِ أن تُناديني بـ"أونيتشان

214
00:13:07,170 --> 00:13:08,980
لا تُعيريها أيَّ انتباه

215
00:13:08,980 --> 00:13:12,760
هيّا يا تشينو تشان، أَريهم كيفَ يتمُّ الأمر

216
00:13:12,760 --> 00:13:15,290
هيّا قولي أونيتشان

217
00:13:15,290 --> 00:13:18,920
ما الذي دفعك لتظني أنّ بإمكانك جعلي أناديك بذلك؟

218
00:13:19,830 --> 00:13:22,470
أنا أشعر بالغيرة يا تشينو تشان

219
00:13:22,470 --> 00:13:25,490
أنتِ محظوظةٌ لأنَّكِ تملكينَ أختاً كبيرةً كهذه

220
00:13:26,780 --> 00:13:30,810
كلا، كلا .. أنا لا أستطيع أن أقوم بالأشياء الّتي تقومُ بها الأخت الكبرى

221
00:13:31,320 --> 00:13:33,370
تفضّلا، تناولا الخبز الّذي صنعته

222
00:13:33,370 --> 00:13:36,220
شكراً جزيلاً لكِ

223
00:13:38,760 --> 00:13:40,550
أنتِ طاهيةٌ جيدة أيضاً

224
00:13:41,230 --> 00:13:44,630
لماذا لم تقولي لي بأنَّها شخصٌ رائع؟

225
00:13:44,980 --> 00:13:48,380
الخُبز هو الشّيء الوحيد الّذي تستطيعُ طَهوهُ كوكوا سان بشكلٍ صحيح

226
00:13:49,140 --> 00:13:52,380
المعذرة، لقد طُلِبَ مِنّي المُساعدة في النّادي

227
00:13:53,530 --> 00:13:56,020
أهلا يا ريزي تشان، سوف أعرّفكِ

228
00:13:58,760 --> 00:14:01,440
هاتانِ هُما أختايَ الصَّغيرتان الجَّديدتان

229
00:14:02,040 --> 00:14:03,540
لا تكذبي

230
00:14:03,540 --> 00:14:04,320
تذكرت

231
00:14:04,320 --> 00:14:07,220
...يبدو أنَّني فقدتُ ذاكَ الشّيء

232
00:14:07,220 --> 00:14:08,450
هل رآهُ أحدٌ ما؟

233
00:14:08,810 --> 00:14:10,450
هل تقصدينَ هذا؟

234
00:14:10,810 --> 00:14:14,190
كانَ هناكَ سكُينُ قتال أيضاً
هل هذا هو؟

235
00:14:14,950 --> 00:14:18,330
لا تُحضري أشياءَ خطيرة إلى هُنا يا ريزي

236
00:14:18,970 --> 00:14:22,320
لا يجدرُ بالمبتدئين التعامل مع هذه الأشياء، أعيديها

237
00:14:22,320 --> 00:14:24,000
يبدو هذا رائعاً

238
00:14:24,920 --> 00:14:27,270
هل تحاولُ ريزي أن تُصبحَ مُمثِّلة؟

239
00:14:27,270 --> 00:14:29,050
أم أنها مهووسة بالجيش؟

240
00:14:29,050 --> 00:14:32,030
مهووسة بالجيش؟ ما معنى ذلك؟

241
00:14:32,030 --> 00:14:34,010
..إنَّهُ

242
00:14:34,010 --> 00:14:34,760
لا تأبهي لهذا

243
00:14:35,290 --> 00:14:38,020
أنا أجيدُ حركات الـ"سي.كيو.سي" وأشياء من هذا القبيل

244
00:14:38,360 --> 00:14:42,080
تجيدُ القتال عن قرب؟

245
00:14:42,080 --> 00:14:43,520
هل كانَتْ تابعة للجيش؟

246
00:14:43,870 --> 00:14:47,490
أنتِ تُشاهدين التلفاز كثيراً يا مايا تشان

247
00:14:49,590 --> 00:14:53,500
إنَّ ريزي تختلفُ عن باقي الفتيات

248
00:14:53,500 --> 00:14:55,340
أنا مُعجبةٌ بذلك

249
00:14:55,340 --> 00:14:57,120
هل أنا مُميَّزة إذاً؟

250
00:14:57,540 --> 00:15:00,540
سوفَ أجعلكِ قدوتي يا كوكوا تشان

251
00:15:00,540 --> 00:15:02,710
لم يقُل هذا لي أحدٌ من قبل

252
00:15:02,710 --> 00:15:04,490
أريدُ أختاً كبرى

253
00:15:03,540 --> 00:15:04,490
إذاً يا تشينو

254
00:15:04,490 --> 00:15:05,710
أجل؟

255
00:15:04,490 --> 00:15:06,300
نادني بذلك كما تُريدين

256
00:15:06,300 --> 00:15:08,700
من هو قدوتكِ؟

257
00:15:09,110 --> 00:15:10,800
قدوتي؟

258
00:15:11,180 --> 00:15:13,200
إن كانَ عليَّ اختيارُ شخصٍ ما

259
00:15:13,200 --> 00:15:14,340
شارو سان؟

260
00:15:14,340 --> 00:15:15,560
بالطّبع

261
00:15:16,150 --> 00:15:19,450
هل نستطيعُ مُساعدتكِ لبقيّة اليوم يا تشينو؟

262
00:15:19,880 --> 00:15:21,320
أجل بالطَّبع

263
00:15:21,320 --> 00:15:24,900
شكراً، سأذهب لإعداد القهوة إذاً

264
00:15:24,900 --> 00:15:27,640
أريدُ أن أجرّب هذا أيضاً

265
00:15:27,640 --> 00:15:28,690
لنقُم بذلك

266
00:15:29,190 --> 00:15:32,310
أعتقد أنَّني سأكونُ أنا و ريزي تشان زبونتان

267
00:15:32,310 --> 00:15:34,040
هذا يُعطيني شعوراً جديداً

268
00:15:35,350 --> 00:15:36,870
تفضّلي

269
00:15:36,870 --> 00:15:38,500
شكراً لكِ

270
00:15:38,500 --> 00:15:43,690
ليسَ من الجيّد أكل حبوب البن مباشرة يا مبغو تشان

271
00:15:44,740 --> 00:15:46,630
أعلمُ هذا

272
00:15:46,630 --> 00:15:49,020
بفضلِ تأثير أبي

273
00:15:49,020 --> 00:15:52,750
طريقتي القاسية في التَّفكير تجعل الأمور صعبة

274
00:15:52,750 --> 00:15:53,890
لكِلَينا

275
00:15:53,890 --> 00:15:54,680
كِلَينا؟

276
00:15:55,160 --> 00:15:56,870
يحدُثُ هذا طوال الوقت

277
00:15:56,870 --> 00:15:57,930
جدّي

278
00:15:59,180 --> 00:16:01,950
ما هذا الشُّعور؟

279
00:16:08,740 --> 00:16:10,420
تفضّلي

280
00:16:10,420 --> 00:16:12,360
شكراً لكِ

281
00:16:12,360 --> 00:16:14,320
أعتذرُ عن قدومي بينما أنتِ تعملين

282
00:16:14,700 --> 00:16:16,010
لا بأسَ

283
00:16:16,010 --> 00:16:17,900
حتّى وإن كُنتِ قادمة لرؤية آنكو فقط

284
00:16:17,900 --> 00:16:20,950
فأنا سعيدةٌ لمجيئكِ والتّحدُّث معي

285
00:16:21,320 --> 00:16:22,400
تشيا سان

286
00:16:22,840 --> 00:16:25,760
ما خطبُ أصدقائك؟

287
00:16:26,390 --> 00:16:29,210
أصبحتا تأتيان إلى المقهى أحياناً

288
00:16:29,740 --> 00:16:33,000
وأصبحتا كأختين صغيرتين لكوكوا سان وريزي سان الآن

289
00:16:33,950 --> 00:16:36,970
ماذا ستقولُ شارو تشان لو أخبرتها بهذا؟

290
00:16:37,480 --> 00:16:40,350
وهذا ... يُزعِجني

291
00:16:41,180 --> 00:16:42,730
أنتِ تشعُرينَ بالغيرة أليسَ كذلك؟

292
00:16:43,130 --> 00:16:46,100
الغيرة؟ مِمَّن؟

293
00:16:46,410 --> 00:16:47,980
إنَّها لا تُدرك هذا بَعد

294
00:16:48,970 --> 00:16:52,990
أي شخص أصغر من كوكوا سان مناسب لها

295
00:16:53,470 --> 00:16:55,750
هذا كلامٌ قد يُسبِّبُ سوءَ تفاهُم

296
00:16:56,290 --> 00:17:00,620
ويبدو أن ريزي سان قد طورت علاقة قرابة مع مايا سان

297
00:17:01,540 --> 00:17:07,770
بدا الأمر وكأن ميغو سان ومايا سان قد نسيا أمري

298
00:17:08,470 --> 00:17:09,380
تشينو تشان

299
00:17:10,020 --> 00:17:13,630
لما لا تبقي معي إن كنت تشعرين بالوحدة؟

300
00:17:13,980 --> 00:17:16,610
سيجعل هذا الأمورَ أكثرَ تعقيداً

301
00:17:16,610 --> 00:17:18,890
..المعذرة ولكن

302
00:17:19,230 --> 00:17:22,210
هل أنتِ حفيدة مالك رابت هاوس؟

303
00:17:22,810 --> 00:17:23,890
أجل أنا حفيدته

304
00:17:24,360 --> 00:17:26,650
هل أنتِ على معرفةٍ بِجَدّي؟

305
00:17:26,650 --> 00:17:31,450
كنتُ أزورُ رابت هاوس أحياناً عندما كُنتُ في المدرسة

306
00:17:32,220 --> 00:17:35,240
ولكن لم أشعر أنَّني جاهِزة مؤخّراً

307
00:17:35,750 --> 00:17:37,490
جاهزة؟

308
00:17:37,920 --> 00:17:41,350
أعلمُ لماذا تَشعرين وكأنَّ شيئاً يُزعجك

309
00:17:41,850 --> 00:17:45,880
أنتِ مُحاطةٌ بأشخاصٍ أعزاء على قلبك

310
00:17:45,880 --> 00:17:49,260
لا أعرف ماذا عليَّ أن أفعل

311
00:17:49,930 --> 00:17:51,880
لم أشعر بهذا من قبل

312
00:17:52,500 --> 00:17:54,920
لم تشعُري بهذا من قبل؟

313
00:17:54,920 --> 00:17:58,010
رُبمّا هذا شيءٌ جيّد

314
00:17:58,010 --> 00:17:59,260
شيءٌ جيّد؟

315
00:17:59,260 --> 00:18:04,020
أعتقد أنَّ قلبكِ يُعلّمك

316
00:18:04,020 --> 00:18:10,270
أنَّكِ تُحبّينَهم أكثر مما تدركين

317
00:18:10,650 --> 00:18:13,940
أعتذرُ عن قولِ شيء جريء كهذا

318
00:18:13,940 --> 00:18:15,990
سوف أذهب الآن

319
00:18:19,930 --> 00:18:21,700
يالها من شخصٍ غريب

320
00:18:25,420 --> 00:18:30,150
لا فائدة مني، فلم أتمكن من مساعدتك

321
00:18:30,150 --> 00:18:32,090
هذا ليسَ صحيحاً

322
00:18:32,090 --> 00:18:35,110
مُجرّد سماعكِ لي خفّف عنّي

323
00:18:36,090 --> 00:18:41,200
ماذا تقصدين بأنّ لريزي سينباي أختًا صُغرى؟

324
00:18:41,200 --> 00:18:43,010
راسَلتِها بخصوصِ ذلك

325
00:18:45,440 --> 00:18:46,820
أتعلمين يا ريزي تشان؟

326
00:18:47,580 --> 00:18:52,030
عندما رأيتُ تشينو تشان تتكلّم مع هاتين الفتاتَين

327
00:18:52,650 --> 00:18:56,110
شعرتُ بالسَّعادة و الوَحدة في آنٍ واحد

328
00:18:56,490 --> 00:19:02,200
من المؤكَّد أنَّهما قد رأتا جوانباً لتشينو تشان لم أرها بعد

329
00:19:02,200 --> 00:19:03,640
..كوكوا

330
00:19:04,890 --> 00:19:08,030
ليسَ الأمر أنَّني لا أفهم كيفَ تشعرين

331
00:19:08,670 --> 00:19:11,580
ولكنَّني الشخص الوحيد الّذي لا يُقيمُ هنا

332
00:19:11,580 --> 00:19:14,240
ماذا؟ هل قُلتِ شيئاً؟

333
00:19:14,240 --> 00:19:16,340
لم أقُل شيئاً على الإطلاق

334
00:19:17,190 --> 00:19:18,560
ما الّذي قُلتهِ؟

335
00:19:18,560 --> 00:19:19,950
قلتُ لا شيء

336
00:19:19,950 --> 00:19:24,910
أعتقد أنَّني لستُ الوحيدة الّتي شعرت بالإستياء يا جَدّي

337
00:19:28,680 --> 00:19:30,490
أهلاً بعَودَتك

338
00:19:30,490 --> 00:19:32,060
هلّا نستعدّ لأن نفتحَ المقهى؟

339
00:19:32,840 --> 00:19:33,610
أجل

340
00:19:36,190 --> 00:19:41,270
أفضل شعور ينتابني عندما نعمل معا ثلاثتنا فقط

341
00:19:41,270 --> 00:19:42,700
رُبّما أنتِ مُحِقّة

342
00:19:43,100 --> 00:19:46,950
تطحنُ ريزي تشان حبوب البُنِّ و تَطهو

343
00:19:46,950 --> 00:19:51,100
..تُقدِّمُ تشينو تشان الطَّلبات للزَّبائن، وأنا

344
00:19:51,620 --> 00:19:52,710
أستلقي تحت الشَّمس

345
00:19:52,710 --> 00:19:53,960
لا تتكاسلي

346
00:19:55,970 --> 00:19:57,630
صباحُ الخير يا تشينو تشان

347
00:19:58,300 --> 00:19:59,810
صباحُ الخير

348
00:20:01,080 --> 00:20:04,350
إذاً، هل تشعُرين بتحسُّن الآن؟

349
00:20:05,310 --> 00:20:07,040
ماذا تقصِدان؟

350
00:20:07,040 --> 00:20:10,120
بدَوتِ مُحبطةً مُؤخّراً

351
00:20:10,120 --> 00:20:13,350
كانَ من الصَّعب مُحادَثَتُكِ لذا قلِقنا عليكِ

352
00:20:13,730 --> 00:20:15,190
لا تَضغَطي على نفسك

353
00:20:15,190 --> 00:20:18,180
أجل، فأنت تخفين أتفه الأشياء

354
00:20:19,510 --> 00:20:23,360
لا بأس، أعتقدُ أنَّني تحسّنتُ كثيراً

355
00:20:23,360 --> 00:20:24,930
الآن؟

356
00:20:24,930 --> 00:20:26,270
كيف؟

357
00:22:00,780 --> 00:22:03,460
أليسَ غروب الشمس جميل يا تيبّي

358
00:22:03,910 --> 00:22:07,020
أتساءلُ إن كُنتُ أعيشُ بطريقةٍ

359
00:22:07,020 --> 00:22:10,570
تجعَلُني قدوةً لتشينو تشان كأختها الكبرى

360
00:22:10,570 --> 00:22:12,850
لمَ تقولُ فتاةٌ بعمركِ شيئًا كهذا؟

361
00:22:12,850 --> 00:22:15,500
أنا صديقةُ ريزي تشان الآن

362
00:22:15,500 --> 00:22:18,850
ولكن أتساءل إن كانت لا تزالُ تراني غريبة الأطوار

363
00:22:18,850 --> 00:22:21,530
أعتقد أنَّ ريزي مُهتمّةٌ بهذا أكثر

364
00:22:21,530 --> 00:22:25,570
التَّفاعل مع الفتيات في هذا العُمر صعبٌ جدّاً أليسَ كذلك؟

365
00:22:25,930 --> 00:22:27,620
آوياما سان؟

366
00:22:27,620 --> 00:22:29,030
يالها من مُصادفة

367
00:22:30,090 --> 00:22:32,450
يالهُ من أرنبٍ لطيف

368
00:22:33,190 --> 00:22:35,830
قرأتُ رِوايتكِ يا آوياما سان

369
00:22:36,330 --> 00:22:39,830
الأرنب الّذي أصبحَ نادلا
كانَ مُثيراً للإهتمام

370
00:22:39,830 --> 00:22:41,930
حقّاً؟

371
00:22:42,660 --> 00:22:45,670
في الواقع، كانَ هُناكَ مثالٌ للشخصيّة الرَّئيسيّة

372
00:22:45,670 --> 00:22:48,440
من أيِّ نوعٍ من الأشخاصِ كان؟

373
00:22:48,440 --> 00:22:52,510
مالكُ مَقهى، اعتَنى بي لفترةٍ طويلة

374
00:22:52,510 --> 00:22:54,970
وعندما واجهَ المقهى مصاعبَ ماليّة

375
00:22:54,970 --> 00:22:57,420
قالَ أنَّهُ يُفضّل أن يكونَ أرنباً

376
00:22:57,420 --> 00:22:59,560
اعتمدتُ على هذا كمَرجعٍ لي

377
00:22:59,560 --> 00:23:02,490
أودُّ أن أقولَ لهُ أنَّني أصبحتُ مَشهورة كفاية

378
00:23:02,490 --> 00:23:04,220
ليتم تصوير أفلامٍ اعتمادًا على رواياتي

379
00:23:04,810 --> 00:23:07,190
...ولكنَّني كنتُ مشغولةً جدّاً ولم أستطع رؤيته لمدة طويلة

380
00:23:07,880 --> 00:23:10,630
هل تشعُرينَ بالتوتُّر من رؤيته بعد كل هذه المدة؟

381
00:23:10,630 --> 00:23:11,950
أجل

382
00:23:12,540 --> 00:23:16,330
لا بُدَّ أنَّهُ يمزح بتَمَنّيهِ أن يكونَ أرنباً

383
00:23:16,330 --> 00:23:18,410
إنَّهُ يمتلكُ روحَ دُعابةٍ بالفعل

384
00:23:19,030 --> 00:23:25,260
إنَّهُ رجلٌ كبيرٌ في السِّن، لديهِ لِحيةٌ بيضاء وقلبٌ طيّب

385
00:23:22,630 --> 00:23:25,260
أنا أحنُّ لهذا

386
00:23:26,000 --> 00:23:35,930
في الحلقة القادمة: نادني بأختي

387
00:23:26,950 --> 00:23:29,130
"في الحلقة القادمة من "هل طلبت أرنبًا؟

388
00:23:29,130 --> 00:23:33,040
انفصالُ قلبينِ عن بعضهما البعض، يُحدِثُ تغييراً في المشاعر

389
00:23:33,040 --> 00:23:34,470
نادِني بأختي

390
00:23:34,470 --> 00:23:35,930
أنا مُتشوّقٌ لهذا