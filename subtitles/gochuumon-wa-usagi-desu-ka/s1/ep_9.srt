1
00:00:20,370 --> 00:00:21,870
!مهلاً

2
00:00:21,870 --> 00:00:22,840
إلى هناك

3
00:00:22,840 --> 00:00:24,170
لا، انتظر

4
00:00:26,120 --> 00:00:29,550
وأخيراً أنشأتُ المقهى بعد كُلّ هذا الكِفاح

5
00:00:30,250 --> 00:00:32,740
ولكنَّني لا أستطيعُ إبقاء العمل على الطريق الصَّحيح

6
00:00:40,540 --> 00:00:41,930
أنا متأكِّد

7
00:00:42,770 --> 00:00:46,030
أنَّني لو كنتُ أرنباً .. لكانت الحياة ستصبحُ أسهل

8
00:00:51,290 --> 00:00:53,250
مرحباً يا عم

9
00:00:53,820 --> 00:00:55,160
أهلاً بكِ

10
00:00:55,850 --> 00:00:58,740
ما هذا الشّيء المنفوش أيها العم؟

11
00:00:59,090 --> 00:01:01,260
هذا أرنبي الأليف

12
00:01:02,460 --> 00:01:04,000
رائحتهُ جميلة

13
00:01:04,440 --> 00:01:09,210
هذه رائحةُ قهوة، فأنا أديرُ مقهى

14
00:01:09,630 --> 00:01:13,210
هل يكونُ طلبكَ التّحوُّل إلى أرنب يا عم؟

15
00:01:13,210 --> 00:01:14,840
لقد سمِعَتني

16
00:01:18,050 --> 00:01:21,060
سألقي بتعويذةٍ عليك

17
00:01:21,520 --> 00:01:26,090
فلتُصبح أرنباً يوماً ما

18
00:01:30,330 --> 00:01:33,190
سوف نرحل يا كوكوا

19
00:01:34,380 --> 00:01:35,400
انتظريني

20
00:01:35,400 --> 00:01:38,410
لا تتركيني يا أختي

21
00:01:38,410 --> 00:01:40,490
هيّاً، لنذهب إذاً

22
00:01:40,490 --> 00:01:42,060
من الّذي كُنتِ تتكلّمينَ معه؟

23
00:01:42,060 --> 00:01:43,660
إنَّهُ جدُّ الأرنب

24
00:01:44,270 --> 00:01:45,450
أرنب؟

25
00:01:51,060 --> 00:01:55,480
حتّى إن تمنّيتُ تحوُّلي لأرنب، فما كنت لأريد أن أصبح مثلك

26
00:01:56,880 --> 00:01:59,680
سأشعر بحرّ شديد في فصل الصيف

27
00:01:59,680 --> 00:02:01,910
ولكن سأشعر بالدفء في فصل الشتاء

28
00:02:04,000 --> 00:02:09,340
حسناً، تشعرُ تشينو بالوحدة عندما لا تكونُ موجوداً

29
00:02:10,540 --> 00:02:12,550
هل أنتَ جاهز للذّهاب للمنزل يا تيبي؟

30
00:02:18,390 --> 00:02:20,490
إنَّها تستخدم تيبي كوِسادة مُجدّداً

31
00:02:21,320 --> 00:02:24,880
لا تتركيني يا أختي

32
00:04:05,110 --> 00:04:06,750
تذكّرتُ شيئاً

33
00:04:06,750 --> 00:04:08,760
سوف آخذُ عطلةً من العمل مُجدّداً

34
00:04:09,390 --> 00:04:11,270
هل لديكِ شيءٌ لفعلهِ؟

35
00:04:11,680 --> 00:04:13,910
طُلِبَ منّي أن أساعد في أحد النوادي

36
00:04:14,330 --> 00:04:15,270
نادي المسرح

37
00:04:15,670 --> 00:04:17,980
نادي المسرح؟ ياللرّوعة

38
00:04:18,440 --> 00:04:22,570
إذاً النادي الّذي تساعدينه أحيانًأ هو نادي المسرح؟

39
00:04:23,040 --> 00:04:26,390
صوتكِ جميلٌ جدّاً
وأنتِ تحفظينَ بسرعة

40
00:04:26,390 --> 00:04:28,030
ستكونينَ مُمثِّلة رائعة

41
00:04:28,480 --> 00:04:30,290
هل تعتقدينَ هذا؟

42
00:04:30,630 --> 00:04:32,070
...المسرح

43
00:04:32,070 --> 00:04:34,190
القصص الخيالية جميلة أليس كذلك؟

44
00:04:35,660 --> 00:04:38,540
التمثيلية التي نعمل عليها ليست ظريفة كتلك

45
00:04:38,850 --> 00:04:40,960
أي نوع من القصص الخيالية المظلمة تكون؟

46
00:04:42,590 --> 00:04:43,630
خُذ هذه

47
00:04:44,170 --> 00:04:45,920
من أينَ حصلتِ على هذه الفكرة؟

48
00:04:45,920 --> 00:04:48,290
!إنَّها مسرحيّةٌ عادية! عادية

49
00:04:48,290 --> 00:04:50,900
أخبرينا عن الدور الذي ستلعبينه

50
00:04:52,110 --> 00:04:53,640
أخبرينا، أخبرينا

51
00:04:53,640 --> 00:04:56,230
لا تضحكا

52
00:04:57,180 --> 00:05:01,230
أنا بطلة شبح الأوبرا، كريستين

53
00:05:01,770 --> 00:05:02,940
تبدينَ سعيدة

54
00:05:02,940 --> 00:05:04,610
إطلاقًا

55
00:05:05,100 --> 00:05:07,500
أنتِ تضغطينَ كثيراً، سوف تكسرينَ الصَّحن

56
00:05:07,500 --> 00:05:09,720
إهدئي يا كريستين

57
00:05:09,720 --> 00:05:11,870
لا تُناديني بهذا الاسم بشكلٍ طبيعيّ

58
00:05:12,430 --> 00:05:15,320
لعبتُ دورَ كلبٍ مرَّة

59
00:05:16,360 --> 00:05:17,720
لن ألعبَ دورَ كلب

60
00:05:17,720 --> 00:05:21,410
أنا سألعب دور سيّدةً شابّة وراقية وهي مغنّية أوبرا

61
00:05:23,460 --> 00:05:26,470
...راقية... سيدة

62
00:05:27,960 --> 00:05:30,720
المعذرة، سوف أدفع ثمنه

63
00:05:31,310 --> 00:05:36,070
هذا صحيح
هذا الدّورُ سيكونُ صعباً جدّاً بالنّسبةِ لي

64
00:05:38,920 --> 00:05:43,250
رُبّما تستطيعُ تشيا تشان و شارو تشان أن تعلّماكِ كيف تتصرفين كسيدة

65
00:05:49,950 --> 00:05:51,200
إنَّها كوكوا تشان

66
00:05:53,450 --> 00:05:55,800
أهيَ آتية لتدمير محلنا؟

67
00:05:57,770 --> 00:05:58,830
هذا ما في الأمر

68
00:05:59,350 --> 00:06:01,380
أتيتُ لكي أتعلّم منكِ

69
00:06:01,380 --> 00:06:05,860
بما أنَّكِ طلبتِ مُساعَدَتي
فمنَ الأفضل أن أكونَ جديّةً بهذا الأمر

70
00:06:07,130 --> 00:06:07,970
اترُكي الأمرَ لي

71
00:06:08,300 --> 00:06:09,720
سأحوّلكِ إلى عذراء يمكنها

72
00:06:09,720 --> 00:06:11,020
!إخجالُ أرواح الطبيعة الشريرة

73
00:06:11,020 --> 00:06:12,850
أنا أعتمدُ عليكِ

74
00:06:12,850 --> 00:06:16,370
أوّلاً ارتَدي هذا، ودعيني أسرّحُ لكِ شعرك

75
00:06:16,370 --> 00:06:19,020
سوف آخذُ مُسدّساتكِ أيضاً

76
00:06:24,710 --> 00:06:26,490
!انتهيت

77
00:06:26,490 --> 00:06:30,120
والآن أنتِ تبدينَ كسيّدةِ حقيقيّة من جميع الجوانب

78
00:06:30,820 --> 00:06:33,490
يبدو هذا الشكل مألوفاً

79
00:06:37,790 --> 00:06:40,120
لنبدأ التَّدريب الآن

80
00:06:40,120 --> 00:06:43,720
كإختبارٍ أوّلي، حاولي إظهار محبّتكِ لهذه النَّبتة

81
00:06:43,720 --> 00:06:44,850
حاضر سيّدتي

82
00:06:45,420 --> 00:06:49,090
بالمُناسبة، هل هناكَ سببٌ ما لارتِدائي لهذا اللباس؟

83
00:06:49,500 --> 00:06:52,850
بالطبع ، من المهمّ ارتداء ما يُلائم نوع العمل

84
00:06:53,180 --> 00:06:54,850
...لذلك

85
00:06:56,250 --> 00:06:58,390
هذا ليسَ جيّداً يا كريستين سان

86
00:06:58,390 --> 00:07:00,310
أنتِ لا تبذلين جهداً كافياً

87
00:07:00,750 --> 00:07:03,050
ستدخلين في الدور أنت أيضًا؟

88
00:07:03,050 --> 00:07:06,170
ألن يكون من الأسرع أن تغيري شخصيتي؟

89
00:07:06,170 --> 00:07:08,570
إنَّها طريقةٌ خاطئة للتَّفكير بالأمر

90
00:07:10,310 --> 00:07:12,120
كم هذا رائع

91
00:07:14,260 --> 00:07:17,600
رؤيتكما وأنتما تتعاملان مع كل شيء بجدية كبيرة

92
00:07:17,600 --> 00:07:20,420
أنتما عانستان ناضجتان حقًا

93
00:07:20,420 --> 00:07:21,450
من هذه؟

94
00:07:21,450 --> 00:07:23,580
إنَّها كاتبة الروايات، آوياما سان

95
00:07:23,580 --> 00:07:27,160
أتذكرين؟ هي من كتبَت قصّة الفيلم الّذي شاهدناه

96
00:07:27,160 --> 00:07:29,650
النادل الّذي أصبحَ أرنباً

97
00:07:31,630 --> 00:07:36,500
تُساعدني آوياما سان أحيانا
بابتِكارِ أسماءٍ جديدة لقائمة الطَّعام

98
00:07:32,220 --> 00:07:34,610
قوائم الطَّعام صعبةٌ هذه الأيام صحيح؟

99
00:07:34,610 --> 00:07:37,600
ألا يوجدُ شيءٌ أكثر تأثيراً؟

100
00:07:36,500 --> 00:07:37,600
مساهمة إذًا؟

101
00:07:40,460 --> 00:07:44,690
الطَّريقة الّتي تبدو بها تشيا تشان
عندما تبتكرُ اسماً جديداً بعدَ صراعٍ طويل

102
00:07:44,690 --> 00:07:48,940
والتي تتفتح لتتحول إلى ابتسامة، تجعلها تبدو كعذراء جميلة

103
00:07:49,780 --> 00:07:51,270
إنَّها شاعِرة

104
00:07:51,270 --> 00:07:53,030
ماذا عنكِ يا آوياما سان؟

105
00:07:53,530 --> 00:07:56,200
أنا مازلتُ في صراع

106
00:07:56,200 --> 00:07:58,540
هل هذا وقتٌ مناسب لأشجِّع غيري؟

107
00:07:59,610 --> 00:08:03,040
أتساءل إن كانت ريزي تشان ستُغنّي وترقص

108
00:08:03,040 --> 00:08:05,440
ألا يجعلُ هذا المسرحيّة موسيقيّة؟

109
00:08:05,440 --> 00:08:07,540
برقصنا رقصةً جميلة على البار اليوم في ساعاتِ الّليل

110
00:08:08,170 --> 00:08:09,920
ألا تظنّين أن عدد الزبائن سيزداد؟

111
00:08:10,420 --> 00:08:12,670
هل سيكون ذلك "جميلا"؟

112
00:08:13,050 --> 00:08:15,260
ستكونُ رائعةً جدّاً

113
00:08:15,260 --> 00:08:18,360
ما هي الأدوار الّتي لعِبتِها من قبل؟

114
00:08:18,360 --> 00:08:21,680
لعبتُ مرة دور شجرة بجزم

115
00:08:21,680 --> 00:08:22,430
!يا له من ذوق جميل

116
00:08:22,800 --> 00:08:24,370
الأشجارُ رائعة

117
00:08:24,370 --> 00:08:27,160
ثباتها يُطهِّرُ الرّوح بأكملها

118
00:08:27,160 --> 00:08:27,880
هذا صحيح

119
00:08:27,880 --> 00:08:28,690
فهمت

120
00:08:28,690 --> 00:08:31,290
!قد تكون الأشجار الراقصة فكرة روائية

121
00:08:31,290 --> 00:08:33,700
الأشجارُ رائعة لأنَّها لا تتحرّك

122
00:08:34,650 --> 00:08:38,200
قالت ريزي سينباي أنَّها ستأتي إلى آما أوسا لحاجةٍ ما
ما هي يا ترى؟

123
00:08:42,210 --> 00:08:44,100
..أنا خائفة منه، ولكن

124
00:08:45,770 --> 00:08:47,710
...إن لم أتحمل هذا القدر

125
00:08:48,260 --> 00:08:49,420
مرحباً

126
00:08:52,880 --> 00:08:55,550
لماذا؟ لماذا؟

127
00:08:55,550 --> 00:08:57,790
المعذرة يا شارو تشان

128
00:08:57,790 --> 00:08:59,820
كنتُ ألعب دور الشَّبح من مسرحية

129
00:08:59,820 --> 00:09:03,670
شبح الأوبرا
لمُساعدة ريزي تشان في دَورِها

130
00:09:03,670 --> 00:09:07,000
رُبّما هذا القِناع يبدو كشبحٍ أكثر

131
00:09:07,000 --> 00:09:09,760
فكرتُكِ للأقنعة البديلة تبدو غريبةً بما فيهِ الكفاية

132
00:09:10,360 --> 00:09:11,570
شارو تشان

133
00:09:11,570 --> 00:09:16,320
تريدُ ريزي تشان أن تعرفَ رأيكِ بهذا الأمر

134
00:09:17,100 --> 00:09:18,270
حسناً

135
00:09:18,270 --> 00:09:21,110
تريدين مني أن أرتدي أحد هذين القناعين واصبح شيطانًا أو روحا

136
00:09:21,110 --> 00:09:23,410
وأن أقوم بإرشادك، أليس كذلك؟

137
00:09:23,870 --> 00:09:25,720
لا علاقةَ لذلك بالأقنعة

138
00:09:25,720 --> 00:09:27,040
لا علاقة له؟

139
00:09:27,700 --> 00:09:30,370
ما أريدُ تعلّمهُ منكِ هو كيف أصبحُ راقية

140
00:09:30,370 --> 00:09:32,040
علّميني السر

141
00:09:32,040 --> 00:09:34,670
لا أعرفُ إن كانَ هناكَ سر لذلك

142
00:09:35,440 --> 00:09:38,390
إنَّها حكمةٌ دنيويّة، اكتسبها لا شعوريًا

143
00:09:38,390 --> 00:09:40,050
من أجل المُضيِّ في الحياة

144
00:09:40,050 --> 00:09:42,720
هل الحياةُ بتلكَ القسوة؟

145
00:09:42,720 --> 00:09:44,810
فهمت

146
00:09:45,320 --> 00:09:50,150
من الصعب على النادلات كسب
عيشهن في هذا الزمان والسن، اليس كذلك؟

147
00:09:50,150 --> 00:09:52,690
إنَّها المرأة الغريبة الّتي كانت في المُتنزَّه ذاكَ اليوم

148
00:09:52,690 --> 00:09:55,190
إنَّها الكاتِبة أوياما سان

149
00:09:55,190 --> 00:09:57,200
هذه هي الكاتبة؟

150
00:09:57,200 --> 00:10:02,200
مَثَلُ النادلات كمَثَل فناناتٍ ترقص في صالة الأكل

151
00:10:02,760 --> 00:10:05,450
أهكذا نبدو لك؟

152
00:10:06,120 --> 00:10:09,920
ولكن بذاتِ الوقت إنَّهن كالمُقاتلات اللّاتي تُحاربن في صالة الأكل

153
00:10:10,300 --> 00:10:12,790
تشبيهُكِ يصِفُني أنا

154
00:10:13,380 --> 00:10:15,960
فنانة ومُقاتِلة

155
00:10:15,960 --> 00:10:18,300
ها لا تبدو منزعجة مَمّا قيل

156
00:10:19,530 --> 00:10:24,780
كنتُ أتساءل... رُبّما تريد ريزي تشان أن تنضمّ إلى نادي المسرح بالفعل

157
00:10:24,780 --> 00:10:26,560
هذا مُستحيل

158
00:10:26,870 --> 00:10:30,580
إنَّها جادةٌ بتحسين آداءها لدورها

159
00:10:30,580 --> 00:10:33,860
إن شاركَت بالنّادي، فسوفَ تترُك العمَل هنا

160
00:10:33,860 --> 00:10:34,440
ماذا؟

161
00:10:34,760 --> 00:10:37,510
سيكونُ هذا مُحزِناً جدّاً

162
00:10:40,010 --> 00:10:41,290
ريزي تشان

163
00:10:45,980 --> 00:10:47,080
ريزي تشان

164
00:10:48,400 --> 00:10:51,170
لا يمكنني القتال عن قرب

165
00:10:51,170 --> 00:10:55,850
لا يمكنني حماية هذا المقهى بدلاً عن ريزي تشان

166
00:10:55,850 --> 00:10:58,010
هل تعتقدينَ أنَّ ريزي تشان حارِسة؟

167
00:10:59,020 --> 00:11:01,130
أتينا لمعرفة شعور ريزي تشان

168
00:11:01,890 --> 00:11:02,700
ماذا؟

169
00:11:02,700 --> 00:11:03,640
روزي تشان

170
00:11:04,510 --> 00:11:06,100
من الجميلِ رؤيتكما مُجدّداً

171
00:11:06,100 --> 00:11:08,390
أنا عذراء قادرة على إخجال أرواح الطبيعة الشريرة

172
00:11:08,930 --> 00:11:10,910
لقد انتقلت شخصيّة كريستين إليها

173
00:11:10,910 --> 00:11:12,900
من علَمها هذه الجُملة؟

174
00:11:13,400 --> 00:11:17,600
روزي تشان، كنتُ أنتظرُ قدومكِ إلى مقهانا

175
00:11:17,600 --> 00:11:18,910
أنا أعتذر

176
00:11:18,910 --> 00:11:21,750
لم أتوقَّع أنَّكِ ستتذكّرينني

177
00:11:21,750 --> 00:11:23,910
بالطّبع سأذكر، فأنا كنتُ أنتظركِ

178
00:11:24,280 --> 00:11:25,360
فهمت

179
00:11:25,360 --> 00:11:30,200
تشينو تشان تحبُّ شخصًا مثل روزي تشان أكثر مني

180
00:11:31,160 --> 00:11:34,610
سوف أجعلُ نفسي أبدو ناضجةً أيضاً

181
00:11:32,090 --> 00:11:32,920
كوكوا سان

182
00:11:32,920 --> 00:11:36,310
انتظري، لم ننتهِ من الكلام بعد

183
00:11:36,800 --> 00:11:38,170
لمَ أتيا إلى هنا

184
00:11:41,540 --> 00:11:43,680
لن آتي إلى هذا المكان مُجدَّداً

185
00:11:43,680 --> 00:11:46,680
!توقّف! ابتعد عنّي! هذا مؤلم

186
00:11:44,220 --> 00:11:45,830
ذاكَ الصّوت

187
00:11:46,190 --> 00:11:47,180
سيّدي؟

188
00:11:47,500 --> 00:11:49,230
لا تعضّني

189
00:11:50,190 --> 00:11:51,780
هذا مؤلم

190
00:11:51,780 --> 00:11:54,440
أنا مسرورةٌ لأنّهُ يبدو بخير

191
00:11:57,020 --> 00:11:59,890
هذا لا يُناسبني على الإطلاق

192
00:11:59,890 --> 00:12:01,730
سوف أرفضُ دورَ كريستين

193
00:12:01,730 --> 00:12:03,660
كلا، يجب عليكِ أن تقومي به

194
00:12:03,660 --> 00:12:07,710
لمَ عليكِ رفضَ شيءٍ تريدينَ القيامَ به؟

195
00:12:08,790 --> 00:12:10,910
هذا ما كنتُ سأقوله

196
00:12:11,310 --> 00:12:14,120
أوياما سان مُحِقّة

197
00:12:14,120 --> 00:12:16,380
تبدينَ رائعةً وأنتِ ترتدينَ هذا

198
00:12:16,810 --> 00:12:19,500
أنتِ رائعةٌ جدّاً، سيكونُ مُحزناً أن ترفضي الدَّور

199
00:12:19,500 --> 00:12:22,550
تأخَّرَ الوقت لرفضِ الدَّور
ولكنَّني بدأتُ أشعرُ بالإحراج

200
00:12:24,260 --> 00:12:27,260
شكراً، سوفَ أجرّب

201
00:12:27,760 --> 00:12:30,850
لقد جئتُ إلى هنا مُندَفِعةً أيضاً

202
00:12:30,850 --> 00:12:33,160
ولكن هذا ليسَ شيئًا أحتاج فيه لمساعدة

203
00:12:33,160 --> 00:12:35,280
لقد سألتِ الشَّخص الخاطئ فحسب

204
00:12:35,280 --> 00:12:36,770
أتقولينَ هذا الآن؟

205
00:12:40,160 --> 00:12:43,650
إذاً هذه كريستين الّتي لعبتِ دورها يا ريزي تشان؟

206
00:12:44,020 --> 00:12:46,600
إنَّها تُحارب الشبح بمُسدَّس

207
00:12:46,600 --> 00:12:50,410
تبيّن أنهم أرادوا كتابة نصّ يناسبني من البداية

208
00:12:50,870 --> 00:12:54,570
..وبعدما واجهتُ المشاكل بتعلُّمي كيفَ أتصرف كسيدة

209
00:12:54,570 --> 00:12:57,170
أنا مُنزعجةٌ جدّاً، سوفَ أثأرُ لنفسي بدورٍ آخر

210
00:12:58,390 --> 00:13:00,520
لا تفعلي هذا

211
00:13:00,520 --> 00:13:02,130
ألا تريدانني أن ألعب أدوارًا لا تناسبني؟

212
00:13:15,160 --> 00:13:16,940
المعذرة

213
00:13:17,540 --> 00:13:20,190
لم أكُن أتوقّع أن تطيرَ بهذا الإتجاه

214
00:13:22,220 --> 00:13:27,410
أمِنَ العاديّ أن تفعلي ذلك بمخطوطاتك يا آوياما سان؟

215
00:13:27,410 --> 00:13:28,570
...في الواقع

216
00:13:30,310 --> 00:13:33,830
توقّفتُ عن كِتابة الرّوايات

217
00:13:33,830 --> 00:13:35,530
ماذا؟

218
00:13:38,540 --> 00:13:41,170
أعتذرُ عن تأخيري مجددا

219
00:13:41,170 --> 00:13:43,790
هل رِدائي في الغسّالة؟

220
00:13:48,120 --> 00:13:49,880
أهلاً بعودتك

221
00:13:51,200 --> 00:13:55,140
لم أكُن أعلم أنَّكِ تعملين هنا يا كوكوا سان

222
00:13:56,950 --> 00:13:59,020
من المؤكَّد أنَّني فُصِلتُ هذه المرّة

223
00:13:59,020 --> 00:14:00,630
هل أنتِ عاطِلةٌ عن العمل؟

224
00:14:00,630 --> 00:14:02,730
...في الواقع، منذُ قليل أنا أيضاً كنتُ

225
00:14:03,400 --> 00:14:06,230
هذا الرّداء الخاطئ يا آوياما سان

226
00:14:08,060 --> 00:14:10,740
لقد استقلتِ من الكِتابة يا آوياما سان؟

227
00:14:11,210 --> 00:14:16,020
كانت بحاجة إلى عمل، لذا أحضرتها إلى هنا في الوقت الراهن

228
00:14:16,020 --> 00:14:17,750
مقاسي تمامًا

229
00:14:18,170 --> 00:14:21,580
وكأنَّ قدري هو أن أعمل هنا

230
00:14:21,580 --> 00:14:23,500
هل أنتِ متأكّدة من هذا؟

231
00:14:23,820 --> 00:14:28,260
بالمُناسبة، أينَ هو السيّد ذو الّلحية البيضاء؟

232
00:14:28,600 --> 00:14:31,500
كنتُ أودُّ أن أراه طوالَ هذه المُدّة

233
00:14:31,500 --> 00:14:33,410
ألم تعلَمي؟

234
00:14:34,280 --> 00:14:37,270
لقد توفّى جدُّ تشينو تشان

235
00:14:37,720 --> 00:14:38,510
ماذا؟

236
00:14:39,120 --> 00:14:42,520
ولكنَّني سمعتُ صوتَهُ ذاكَ اليوم

237
00:14:43,240 --> 00:14:45,400
لن آتي إلى هذا المكان مُجدَّداً

238
00:14:46,810 --> 00:14:49,670
إنَّها تشتاقُ إليهِ لدرجة أنَّها تتخيّلُ صوته

239
00:14:50,410 --> 00:14:54,840
دلِّلي كرة الفِراء هذه وستَشعُرينَ بتحسُّن

240
00:14:54,840 --> 00:14:55,660
...لا تفعلي

241
00:14:57,690 --> 00:14:59,230
آوياما سان؟

242
00:14:59,750 --> 00:15:02,810
لقد أحببته

243
00:15:02,810 --> 00:15:06,670
عيناه المحجوبتان تذكرني بشيء

244
00:15:07,100 --> 00:15:08,670
بالنَّظرِ عن قُرب، يبدو فِراءهُ كثيفا

245
00:15:09,250 --> 00:15:11,930
أرى أنَّها تُحبُّ مظهر الأشقياء

246
00:15:12,710 --> 00:15:16,390
رائحتهُ كالقهوة ، تماماً مثلَ السيد

247
00:15:16,390 --> 00:15:18,320
لا أصدّق هذا

248
00:15:18,320 --> 00:15:21,440
هل رحلَ بالفعل؟

249
00:15:22,570 --> 00:15:28,020
ألن يُعطيني رأيهُ بكِتاباتي مُجدّداً؟

250
00:15:30,410 --> 00:15:33,210
لاحظتُ أنَّ آوياما سان لم تأتِ إلى هنا مؤخّراً

251
00:15:33,210 --> 00:15:35,330
هل تعملُ في رابت هاوس حقّاً؟

252
00:15:35,330 --> 00:15:38,830
يبدو أنَّ كِتاباتها تمرُّ بمرحلةِ ركود

253
00:15:38,830 --> 00:15:39,960
حقّاً؟

254
00:15:40,390 --> 00:15:42,960
إنَّها تُساعِدنا خِلال النَّهارِ أحياناً

255
00:15:48,210 --> 00:15:51,100
أليسَ هذا الكشك متقن الصنع؟

256
00:15:51,100 --> 00:15:53,340
ما هذا بالضّبط؟

257
00:15:53,790 --> 00:15:56,220
فكّرتُ أن أساعد هذا المقهى

258
00:15:56,220 --> 00:15:59,650
عبرَ القيامِ بشيءٍ أستطيع القيام به بمفردي

259
00:16:00,100 --> 00:16:03,100
أنا أحبُّ الإنصات للآخرين

260
00:16:04,280 --> 00:16:09,380
ألهمني تاكاهيرو سان عندما يُنصتُ لمشاكل زبائنه

261
00:16:09,380 --> 00:16:10,740
تاكاهيرو سان؟

262
00:16:10,740 --> 00:16:11,610
أبي؟

263
00:16:11,610 --> 00:16:15,290
كم هذا جميل، أعتقد أنَّها فكرةٌ رائعة

264
00:16:15,290 --> 00:16:18,120
لقد صنعنا هذا من أجلكِ أيضاً يا تشيا  تشان

265
00:16:18,730 --> 00:16:21,570
سوف تستفيدينَ من موهبتكِ هكذا

266
00:16:21,570 --> 00:16:22,870
أجل

267
00:16:24,620 --> 00:16:27,640
أودُّ أيضاً أن أستفيد من موهبتي

268
00:16:27,640 --> 00:16:31,250
ولكن لسببٍ ما لا أحد يتحدث إلي

269
00:16:31,250 --> 00:16:33,510
أنتِ شخصٌ غامضٌ جدّاً

270
00:16:33,830 --> 00:16:36,000
لذا ربما يصعب عليهم ذلك

271
00:16:36,000 --> 00:16:38,010
لا أعتقد أنَّ تلك هي  المُشكلة

272
00:16:38,500 --> 00:16:43,020
كانَ سيّدي جيّدا جدّاً بالإنصات للآخرين

273
00:16:43,390 --> 00:16:48,270
أتمنّى أن أكونَ شخصاً مثلهُ لأستطيع تقديم الرّاحة للآخرين

274
00:16:48,720 --> 00:16:50,270
فهمت

275
00:16:51,030 --> 00:16:53,110
إن بَدَوتِ أكثر تميزًا

276
00:16:53,110 --> 00:16:55,680
فسيَسهلُ على الطُلّاب مُحادثتكِ

277
00:16:55,680 --> 00:16:58,030
لنضع بعض الحيوانات المحشوّة هنا

278
00:17:00,040 --> 00:17:04,460
إن كانَ لديَّ أشياءٌ ظريفة تنظرُ لي هكذا

279
00:17:04,460 --> 00:17:05,540
ستحلُّ عليَّ الّلعنة

280
00:17:05,540 --> 00:17:07,310
لعنة؟

281
00:17:08,000 --> 00:17:12,800
رُبّما كلَما ساعدت الآخرين، أصبحتِ محبوبةً أكثر

282
00:17:14,760 --> 00:17:18,870
لأجل هذا، أحضرتُ شخصاً يقلقُ حيال الكثير من الأشياء كل يوم

283
00:17:18,870 --> 00:17:22,310
...أخبرتي أن أتخلى عن متاعب حياتي اليومية، ولكن

284
00:17:24,460 --> 00:17:26,430
أنا مسرورةٌ لقدومك

285
00:17:26,430 --> 00:17:28,390
هذه قهوة للتّرحيب بكِ

286
00:17:28,390 --> 00:17:30,570
ولكن عليَّ العمل بعدَ هذا

287
00:17:31,020 --> 00:17:33,620
قمتُ بمزجِها بنفسي

288
00:17:33,620 --> 00:17:34,570
ماذا؟

289
00:17:40,410 --> 00:17:42,950
أنا أبكي لسببٍ لا أعرفه

290
00:17:42,950 --> 00:17:46,080
هل تثملُ بطرقٍ مُختلفة إعتماداً على المزيج؟

291
00:17:46,080 --> 00:17:47,790
هذا مُستحيل

292
00:17:48,270 --> 00:17:50,060
لا أستطيعُ المُتابعة

293
00:17:51,150 --> 00:17:53,860
الأمورُ صعبةٌ جدّاً هذا الشّهر

294
00:17:53,860 --> 00:17:55,840
وقد عضَّني ذاكَ الأرنب

295
00:17:55,840 --> 00:17:57,660
هدّئي من رَوعك

296
00:17:57,660 --> 00:18:00,930
هذا هو الأمر الّذي أردتُ فِعله

297
00:18:02,820 --> 00:18:06,140
وصلت رِسالةٌ لكِ من شخصٍ يريدُ نصيحة

298
00:18:06,140 --> 00:18:09,310
بدأ الأمر يعمل كصندوق اقتراحات الآن

299
00:18:12,180 --> 00:18:14,820
أختي الصَّغيرة لا تتناول خُضارها

300
00:18:15,130 --> 00:18:19,500
وإن استمرَّ هذا فسوفَ تبقى صغيرة الحجم إلى الأبد

301
00:18:22,870 --> 00:18:25,450
يجب عليَّ أن أكتبَ ردّاً

302
00:18:26,480 --> 00:18:29,060
ولا مانعَ لديَّ إن بقيت بهذا الحجم

303
00:18:29,060 --> 00:18:31,610
ولكنَّني سأقدِّرُ إن أعطيتني بعض الوصفات لاستخدام الكَرَفْس

304
00:18:31,610 --> 00:18:33,780
حتى يحبه الأطفال اللذين يكرهونه

305
00:18:35,130 --> 00:18:37,640
أحضرتُ رسالةً لكِ أيضاً

306
00:18:37,640 --> 00:18:39,830
إنَّها فتاةٌ تقول أنَّ أختها الكبرى

307
00:18:39,830 --> 00:18:42,000
تُجبرها على تناول الخضروات الّتي لا تُحبّها

308
00:18:42,000 --> 00:18:43,850
تشجَّعا أنتما الإثنتان و واجِها بعضكما

309
00:18:44,430 --> 00:18:47,210
أصبحتُ مشغولةً فجأة

310
00:18:47,640 --> 00:18:48,850
...إذاً

311
00:18:48,850 --> 00:18:52,860
هل أنتِ متأكّدة من ترككِ لوظيفتكِ ككاتِبة بهذه السهولة؟

312
00:18:54,380 --> 00:18:58,340
..في الحقيقة، أودُّ مُتابعة الكِتابة ولكن

313
00:18:59,370 --> 00:19:03,000
من قالَ لي أنَّهُ لا يجب عليَّ التَّخلّي عمّا أحب؟

314
00:19:03,000 --> 00:19:04,950
أصبحت ريزي تشان عاطفيّةً جدّاً

315
00:19:06,730 --> 00:19:12,280
في الواقع، منذُ أن فقدتُ قلم الحبر الّذي قدَّمهُ لي سيّدي

316
00:19:12,280 --> 00:19:14,460
لم أعُد أستطع كِتابةَ شيء

317
00:19:14,890 --> 00:19:17,710
أقلام الحبر الأخرى لا تساعدني

318
00:19:17,710 --> 00:19:20,970
أنتِ مُحقّة، من الصّعب الإستغناء عن الأشياء المُعتادين عليها

319
00:19:20,970 --> 00:19:24,780
هل تعرفينَ أينَ أضعتهِ؟

320
00:19:24,780 --> 00:19:29,980
أنا متأكّدة أنَّني كنتُ أملكهُ في اليوم الّتي رأيتُ بهِ كوكوا سان

321
00:19:34,260 --> 00:19:36,730
إن كانت قد أضاعتهُ باليوم الّذي قابلَتني به

322
00:19:37,270 --> 00:19:39,510
فقد يكون في مكانٍ ما هنا

323
00:19:42,320 --> 00:19:44,490
هل وجدتهِ يا تشينو تشان؟

324
00:19:44,820 --> 00:19:48,620
كلا لم أجده، هل أنتِ متأكّدة أنَّكِ قابلتِها هنا؟

325
00:19:49,680 --> 00:19:51,620
أرنبٌ جميل

326
00:19:51,620 --> 00:19:52,330
مرحى

327
00:19:52,330 --> 00:19:54,250
ألا تريدين أن تبحثي عن القلم؟

328
00:19:56,500 --> 00:19:59,980
أرى أنَّهُ من الصّعب أن يقعَ في مكانٍ ما كهذا

329
00:19:59,980 --> 00:20:01,260
أليسَ كذلك يا تيبي؟

330
00:20:13,340 --> 00:20:15,240
هل هذا هو؟

331
00:20:16,810 --> 00:20:18,970
أتريدني أن أعطيهِ لها؟

332
00:20:19,480 --> 00:20:21,490
حسناً لا بأسَ

333
00:20:22,360 --> 00:20:23,990
...أنا

334
00:20:24,580 --> 00:20:28,910
لا أعلم لماذا انتهى بكما الأمر أنت وتيبي هكذا

335
00:20:29,530 --> 00:20:32,660
ولكن إبقاء هذا الأمر سِرّاً شيءٌ مقيِّد جدًا

336
00:20:34,860 --> 00:20:38,980
لا داعي لأن يبقى الأمرُ سِرّاً من أجلي بعد الآن

337
00:20:38,980 --> 00:20:42,230
لأنك الشَّخص الوحيد الّذي أكلّمه

338
00:20:43,650 --> 00:20:47,190
لذا... أبهِجها أرجوك

339
00:20:52,020 --> 00:20:56,870
...كنتُ أريدُهُ أن هذه الرواية على الأقل

340
00:20:57,480 --> 00:20:59,400
كانت جيّدة

341
00:21:02,020 --> 00:21:06,430
ولكنَّ كان للابن مشاهد أكثر من بطل الرواية

342
00:21:07,480 --> 00:21:10,280
هناكَ خطب ما

343
00:21:11,900 --> 00:21:15,040
أتى صوتُ سيّدي من هذه الّلعبة المحشوّة

344
00:21:15,040 --> 00:21:16,250
ماذا؟

345
00:21:16,250 --> 00:21:18,040
ليس من هناك

346
00:21:19,940 --> 00:21:23,090
والآن بما أنَّ آوياما سان استعادَت قلمها

347
00:21:23,090 --> 00:21:25,080
فقد عادَت إلى الكِتابة الآن

348
00:21:26,390 --> 00:21:30,350
لقد أحبّت العمل كساقية وتأتي للعمل أحياناً لتُساعِدنا

349
00:21:30,860 --> 00:21:34,500
أتمنّى لو استطعتُ مُقابلة جدّ تشينو تشان

350
00:21:34,500 --> 00:21:37,350
كانَ قد توفّى عندما أتيتُ إلى هنا

351
00:21:37,960 --> 00:21:41,230
يُراقبنا المُعلّم طوالَ الوقت

352
00:21:41,230 --> 00:21:46,610
وعندما نكونُ في ورطة فهو يظهر من حيثُ لا ندري ويُساعِدنا

353
00:21:47,130 --> 00:21:52,120
رُبّما في المرّة القادمة يستعيرُ جسد تيبي ليُكلّمنا

354
00:21:52,120 --> 00:21:54,130
هذا مُخيفٌ جدّاً

355
00:21:54,130 --> 00:21:56,620
لا تقولي أشياءَ كهذه

356
00:23:26,360 --> 00:23:36,220
في الحلقة القادمة: فيلق المعركة المضاد للأخوات، والمعروف أيضًا بفيلق تشيمامي

357
00:23:27,510 --> 00:23:30,700
ألا تلاحظ أنَّ كوكوا تؤثّر على تشينو كثيراً؟

