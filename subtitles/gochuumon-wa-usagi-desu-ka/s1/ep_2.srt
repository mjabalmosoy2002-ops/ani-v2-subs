1
00:00:03,510 --> 00:00:06,920
هذه بلدةٌ ذات شوارعَ مُحجَّرة
ومنازل ذات بنية خشبية

2
00:00:07,270 --> 00:00:13,120
أدعى كوكوا، وقد انتقلتُ إلى هنا
لأرتاد المدرسة الثّانويّة في الرّبيع

3
00:00:14,170 --> 00:00:17,610
أنا أعمل في رابت هاوس وهو مكانُ إقامَتي حاليّاً

4
00:00:19,270 --> 00:00:20,870
ولديَّ أيضاً أختٌ صغيرة

5
00:00:21,540 --> 00:00:23,750
أنا لستُ أختكِ الصَّغيرة

6
00:00:23,750 --> 00:00:29,340
أخبرتني زبونةٌ أنَّني مُصابة بعقدةِ الأخت

7
00:00:30,580 --> 00:00:32,590
ألا يبدو هذا رائعاً؟

8
00:00:33,960 --> 00:00:35,660
أنصتي إلى هذا يا ريزي تشان

9
00:00:35,660 --> 00:00:38,600
أنا مصابةٌ بعقدةِ الأخت على ما يبدو

10
00:00:38,600 --> 00:00:41,150
حقا؟

11
00:00:41,150 --> 00:00:44,510
عقدة الأخت، عقدة الأخت

12
00:00:44,510 --> 00:00:45,840
ياللهول

13
00:00:44,510 --> 00:00:51,070
عقدة الأخت، عقدة الأخت
عقدة الأخت

14
00:00:45,840 --> 00:00:47,600
إنَّها لا تعرفُ ما معنى هذا

15
00:00:47,600 --> 00:00:49,380
يجب أن نوقفها

16
00:00:49,380 --> 00:00:51,070
يا إلهي

17
00:02:42,400 --> 00:02:44,220
حانَ وقتُ الذّهاب

18
00:02:45,640 --> 00:02:49,090
ثيابُكِ المدرسيّة ظريفةٌ جدّاً يا تشينو تشان

19
00:02:49,090 --> 00:02:50,230
حقّاً؟

20
00:03:00,620 --> 00:03:01,540
ماذا؟

21
00:03:01,540 --> 00:03:03,950
ما الّذي كُنتِ تتوقّعينه؟

22
00:03:07,450 --> 00:03:09,290
سوفَ نذهبُ الآن

23
00:03:09,290 --> 00:03:10,540
إنَّنا ذاهِبتان

24
00:03:10,540 --> 00:03:12,410
حسناً، فلتقضيا يوماً سعيداً

25
00:03:12,410 --> 00:03:13,040
اعتنيا بأنفسكما

26
00:03:13,580 --> 00:03:14,820
حسناً

27
00:03:21,910 --> 00:03:24,390
أتذهبينَ من هذا الطّريق أيضاً يا تشينو تشان؟

28
00:03:24,390 --> 00:03:25,800
أنا أذهب من هذا الطّريق

29
00:03:26,280 --> 00:03:29,350
سنَمشي سويّاً لفترةٍ بسيطةٍ على الأقلّ

30
00:03:29,350 --> 00:03:30,180
أجل هذا صحيح

31
00:03:33,450 --> 00:03:35,270
أنا ذاهبةٌ من هذا الطّريق

32
00:03:35,270 --> 00:03:36,150
كانَ هذا سريعاً

33
00:03:38,670 --> 00:03:40,680
صباحُ الخير يا تشينو

34
00:03:40,680 --> 00:03:44,070
صباحُ الخير

35
00:03:45,950 --> 00:03:49,310
حسناً، لنتحمّس ولنذهب

36
00:03:53,600 --> 00:03:55,790
صباحُ الخير يا ريزي تشان

37
00:03:59,820 --> 00:04:02,150
زِيُّكِ رائعٌ جدّاً يا ريزي تشان

38
00:04:03,110 --> 00:04:05,450
إنَّهُ زيٌّ عاديّ

39
00:04:06,510 --> 00:04:08,890
حُللك رائعةٌ للغاية

40
00:04:08,890 --> 00:04:12,210
لمَا لا نتبادل ملابسنا؟

41
00:04:12,210 --> 00:04:15,660
اذهبي إلى مدرستكِ
سوف تتأخّرين

42
00:04:15,660 --> 00:04:18,770
حسناً، أراكِ في المقهى إذاً

43
00:04:18,770 --> 00:04:21,780
حسناً، إياك أن تتوهي

44
00:04:23,040 --> 00:04:25,030
أنا قلِقةٌ عليها قليلاً

45
00:04:26,980 --> 00:04:30,070
تقابلنا مُجدّداً يا ريزي تشان

46
00:04:30,850 --> 00:04:32,160
أراكِ لاحقاً

47
00:04:32,680 --> 00:04:34,160
إنَّها تائِهة

48
00:04:34,660 --> 00:04:36,420
هل تعرفينَ الطَّريق إلى المدرسة؟

49
00:04:37,080 --> 00:04:39,300
لا داعي لأن تقلقي

50
00:04:43,590 --> 00:04:46,300
ها أنتِ مُجدَّداً

51
00:04:49,390 --> 00:04:50,470
ماذا؟

52
00:04:50,470 --> 00:04:52,220
ومجدّداً

53
00:04:53,020 --> 00:04:56,130
هل قُمتُ بالدّخول إلى بُعدٍ آخر؟

54
00:04:58,210 --> 00:04:59,750
ما الأمر؟

55
00:04:59,750 --> 00:05:02,190
هل أنتِ... تائهة؟

56
00:05:11,880 --> 00:05:12,940
...إنَّهُ

57
00:05:13,760 --> 00:05:15,040
سمعتُ عن هذا كثيراً

58
00:05:15,040 --> 00:05:16,710
الأرانب الوحشيّة

59
00:05:21,360 --> 00:05:23,550
أنا في جنة للمداعبة

60
00:05:24,550 --> 00:05:26,200
يوكان بالبندق؟

61
00:05:29,220 --> 00:05:32,180
هيّا... هيّا

62
00:05:35,460 --> 00:05:37,450
ألن تأكلَ هذا؟

63
00:05:37,450 --> 00:05:39,500
أرنبي الصَّغير يأكله

64
00:05:41,380 --> 00:05:42,220
ماذا؟

65
00:05:45,750 --> 00:05:49,820
جذبتُ فتاةً بدلاً من أرنب

66
00:05:53,510 --> 00:05:56,930
كوكوا تشان
يالهُ من اسمٍ يُشعِرُ بالدّفء

67
00:05:56,930 --> 00:05:58,290
أنا أدعى تشيا

68
00:05:58,670 --> 00:06:02,800
تشيا تشان، هذا اسمٌ جميل

69
00:06:03,340 --> 00:06:06,130
هذه اليوكان بالبندق لذيذةٌ جدّاً

70
00:06:06,130 --> 00:06:09,700
هل أحببتها؟ أنا من صنعها

71
00:06:09,700 --> 00:06:11,300
أتصنعين الحلويّات اليابانيّة؟

72
00:06:11,730 --> 00:06:15,020
أجل، وهذه هي أفضل ابتكاراتي

73
00:06:16,260 --> 00:06:18,760
مثل القمر الّذي يُسافرُ في الّليلِ المُظلم

74
00:06:18,760 --> 00:06:21,070
أدعوها سينياتسوكي

75
00:06:21,980 --> 00:06:24,320
هذا البندق الموجود في اليوكان يُمِّثلُ القمر

76
00:06:24,730 --> 00:06:26,460
هذا جميلٌ جدّاً

77
00:06:26,460 --> 00:06:27,820
حتّى ولو أنَّني لم أفهَم شيئاً

78
00:06:28,150 --> 00:06:30,390
أعتقدُ أنَّنا سوف نُصبحُ أصدقاء

79
00:06:31,170 --> 00:06:33,930
أنتِ ترتادين ذاتَ المدرسة الّتي أنا بها

80
00:06:33,930 --> 00:06:35,330
حقّاً؟

81
00:06:37,160 --> 00:06:39,100
سوف نتأخَّر على مراسم الدّخول

82
00:06:39,540 --> 00:06:40,790
لنذهب سويّاً، يا تشيا تشان

83
00:06:41,240 --> 00:06:42,750
ولكن اليوم

84
00:06:42,750 --> 00:06:43,880
أسرعي

85
00:06:48,140 --> 00:06:51,100
لقد عُدنا إلى ذات المكان مُجدّداً

86
00:06:51,100 --> 00:06:53,720
انتظري قليلاً

87
00:06:53,720 --> 00:06:57,430
مراسمُ الدّخول للمدرسة في الغد

88
00:06:58,800 --> 00:07:01,520
قلتُ أنَّ مراسم دخول المدرسة غداً

89
00:07:04,570 --> 00:07:06,940
أنا أشعرُ بالإحراج

90
00:07:05,820 --> 00:07:06,940
أنتِ مُضحكة

91
00:07:07,620 --> 00:07:12,820
لنذهب إلى المدرسة سويّاً لكي لا تتوهي

92
00:07:13,210 --> 00:07:15,580
أنتِ مُذهلة

93
00:07:20,250 --> 00:07:22,750
هذه هي المدرسة الّتي سنذهبُ إليها في الغد

94
00:07:23,250 --> 00:07:26,260
هذه هي مدرَستي الجَديدة

95
00:07:26,260 --> 00:07:28,890
بمُجرّد النَّظر إليها أشعرُ بالحماس

96
00:07:29,320 --> 00:07:32,180
سأقضي هنا فترةَ شبابي

97
00:07:32,180 --> 00:07:36,530
سأضحكُ هنا وأبكي مع أصدقائي ورُبّما نتشاجر

98
00:07:36,530 --> 00:07:39,580
مهلا، إنها المدرسة الإعداديّة

99
00:07:37,260 --> 00:07:40,580
إنَّها جميلةٌ كما تخيّلتها

100
00:07:39,580 --> 00:07:42,900
نسيتُ أنَّني تخرّجتُ من هنا منذُ زمن

101
00:07:40,580 --> 00:07:42,900
من المؤكّد أنَّني سأكونُ سعيدةً هنا

102
00:07:43,520 --> 00:07:45,860
نراكِ غداً يا تشينو

103
00:07:45,860 --> 00:07:47,160
إلى الّلقاء

104
00:07:53,320 --> 00:07:54,360
لقد عدت

105
00:07:56,030 --> 00:07:58,200
كيفَ كانت مدرستكِ؟

106
00:07:58,780 --> 00:08:02,290
لدى هذه البلدة العديد من الأبنية الجَّميلة

107
00:08:02,680 --> 00:08:04,260
حقّاً؟

108
00:08:04,260 --> 00:08:05,790
وكيفَ كانت مدرستكِ؟

109
00:08:05,790 --> 00:08:08,750
تُشعرُني هذه البلدة وكأنَّني في قصّةٍ خياليّة

110
00:08:09,470 --> 00:08:10,240
...وكيفَ كانت

111
00:08:10,240 --> 00:08:10,760
لا تسأليني

112
00:08:19,420 --> 00:08:21,890
لا أصدّق أنَّنا في ذات الصفّ يا تشيا تشان

113
00:08:22,380 --> 00:08:26,350
لقد تفاجأتُ أنَّكِ تهتِ حتى في المدرسة

114
00:08:27,550 --> 00:08:28,650
هناكَ رائحةٌ زكيّة

115
00:08:28,650 --> 00:08:29,530
إنَّهُ مخبز

116
00:08:30,770 --> 00:08:31,940
كم هذا جميل

117
00:08:32,350 --> 00:08:33,600
الخُبز؟

118
00:08:33,600 --> 00:08:37,000
تمتلكُ عائلتي مخبزاً
لذا أنا مُعتادة على صُنع الخبز كثيراً

119
00:08:37,000 --> 00:08:38,990
أتمنّى أن أصنعَ الخُبز مُجدَّداً

120
00:08:38,990 --> 00:08:41,080
بإمكانكِ أن تخبزي حقّاً؟
كم هذا رائع

121
00:08:41,480 --> 00:08:46,780
أشعرُ أنَّ قلبي يقفز فرحاً كلّما نظرتُ إلى الخبز

122
00:08:46,780 --> 00:08:48,240
أعلمُ ماذا تقصدين

123
00:08:48,240 --> 00:08:52,180
تخطرُ لي الكثير من الأفكار عندما أنظرُ إلى الحلويّات اليابانيّة

124
00:08:53,940 --> 00:08:56,510
ولكن أكثر شيءٍ أحبّه

125
00:08:57,260 --> 00:09:00,380
هو تسمية الشّيء الّذي أصنعه عندما أنتهي

126
00:09:00,380 --> 00:09:01,930
هذا مُذهل

127
00:09:06,940 --> 00:09:09,340
أجل، إنَّنا نملكُ فُرناً كبيراً

128
00:09:09,340 --> 00:09:12,040
قامَ جدّي بشرائهِ منذُ وقتٍ طويل

129
00:09:13,400 --> 00:09:14,980
حقّاً؟

130
00:09:14,980 --> 00:09:16,720
عندما نحصلُ على إجازة في المرّةِ القادمة

131
00:09:16,720 --> 00:09:19,470
لمَ لا نبتكرُ جميعاً قائمة جديدة؟

132
00:09:19,470 --> 00:09:21,800
إنَّ الخُبز الطّازج لذيذٌ جدّاً

133
00:09:21,800 --> 00:09:24,550
قلّلا من الكلام وأكثرا من العمل

134
00:09:25,390 --> 00:09:28,410
إنَّ الخُبز الطّازج لذيذٌ جدّاً

135
00:09:28,410 --> 00:09:30,470
أنا أدركُ ذلك

136
00:09:34,780 --> 00:09:36,680
هذهِ صديقتي تشيا تشان من المدرسة

137
00:09:38,280 --> 00:09:39,680
سُررتُ برؤيتكما

138
00:09:40,100 --> 00:09:42,250
هاتانِ هُما تشينو تشان و ريزي تشان

139
00:09:42,250 --> 00:09:43,590
سُررتُ بلقائك

140
00:09:43,590 --> 00:09:44,870
أهلاً بكِ

141
00:09:44,870 --> 00:09:46,810
ذلك الكلب

142
00:09:47,130 --> 00:09:49,140
إنَّهُ ليسَ كلباً

143
00:09:49,140 --> 00:09:51,620
إنَّهُ ليسَ كُرة فراءٍ عاديّة

144
00:09:51,620 --> 00:09:53,560
سيّد فرو؟

145
00:09:53,560 --> 00:09:56,070
إنَّهُ منفوشٌ كثيراً

146
00:09:56,070 --> 00:09:58,600
هل أنتَ سعيدٌ يا سيّد فرو؟

147
00:09:58,600 --> 00:09:59,910
إنَّهُ تيبي

148
00:09:59,910 --> 00:10:03,490
يجب أن يقولَ أحدهم أنَّهُ أرنبُ آنغورا

149
00:10:06,680 --> 00:10:10,330
تفاجأتُ كثيراً عندما علمتُ أنَّكِ تصنعينَ الخُبز يا كوكوا

150
00:10:11,740 --> 00:10:13,590
لا أعتقد أنَّهُ كانَ إطراءً

151
00:10:14,660 --> 00:10:16,590
حسناً، لنقُم بهذا

152
00:10:16,590 --> 00:10:19,600
لا تستهينوا بصُنع الخبز يا أصدقاء

153
00:10:19,600 --> 00:10:23,310
إنَّها كالمعركة الّتي تتأثّر بأصغر الأخطاء

154
00:10:24,070 --> 00:10:26,160
كوكوا مُشتعلةٌ كالنّار

155
00:10:26,680 --> 00:10:30,200
هذه الهالة... إنّها كالمُحارب العظيم في المعركة

156
00:10:31,900 --> 00:10:33,690
سأتركُ التّعليمات لكِ اليوم

157
00:10:33,690 --> 00:10:35,240
أنا أعتمدُ عليكِ

158
00:10:35,240 --> 00:10:36,780
حاضر سيّدتي

159
00:10:37,700 --> 00:10:39,390
سأشاركُ معكما أيضاً

160
00:10:39,390 --> 00:10:40,570
هذا لا يُطاق

161
00:10:41,010 --> 00:10:43,880
فلتُحضّرن جميعاً المقادير الّتي سوف تستخدمنها في الخبز

162
00:10:43,880 --> 00:10:44,620
حاضر سيّدتي

163
00:10:44,620 --> 00:10:45,700
سيّدتي

164
00:10:46,050 --> 00:10:47,950
لا يُطاق

165
00:10:48,260 --> 00:10:52,960
أنا أصنعُ نوعاً جديداً من الخبز وهو ياكي أودون

166
00:10:53,270 --> 00:10:57,460
أحضرتُ حبوب الآزوكي الخاصّة بعائلتي
والخوخ و أعشاب نوري البحريّة

167
00:10:57,780 --> 00:11:02,970
وجدتُ بيض السّلمون و أعشاب كونبو البحريّة بالسّمسم

168
00:11:03,340 --> 00:11:05,740
هل نصنعُ الخبز حقّاً؟

169
00:11:06,290 --> 00:11:09,950
أوّلاً، نخلطُ الطَّحين مع الخَميرة الجافّة

170
00:11:10,360 --> 00:11:14,030
تجعلُ الخميرة الخُبزَ ينتفخ أليسَ كذلك؟

171
00:11:14,030 --> 00:11:16,930
هذا صحيح
أنتِ تعلمين هذا؟

172
00:11:16,930 --> 00:11:18,880
جيّدُ جدّاً يا تشينو تشان

173
00:11:18,880 --> 00:11:20,780
إنها فطريات خميرة جافة

174
00:11:21,250 --> 00:11:22,720
فطريّات خميرة؟

175
00:11:31,190 --> 00:11:34,220
إن كانَ علينا أن نضع مثلَ هذه الأشياء الخطيرة

176
00:11:34,220 --> 00:11:36,290
فأنا أفضّل العمل بالخُبز الجاف

177
00:11:36,290 --> 00:11:38,840
سأضعُ الخميرة الجافّة

178
00:11:52,080 --> 00:11:55,440
لم أكُن أعلم أنَّ عجن الخُبز يحتاجُ لقوّةٍ كبيرة

179
00:11:55,840 --> 00:11:58,820
لم أعُد أستطيعُ تحريكِ يديَّ

180
00:11:59,660 --> 00:12:02,120
تبدينَ بخير يا ريزي تشان

181
00:12:02,120 --> 00:12:03,910
ما الّذي جعلكِ تعتقدينَ هذا؟

182
00:12:04,440 --> 00:12:06,630
هل أنتِ بخير يا تشيا تشان؟

183
00:12:06,630 --> 00:12:07,910
هل تحتاجينَ مُساعَدة؟

184
00:12:08,880 --> 00:12:11,420
كلّا، أنا بخير

185
00:12:11,420 --> 00:12:12,290
أنتِ تعملينَ بجهد

186
00:12:13,300 --> 00:12:16,810
لا أستطيعُ تركَ الكثير من العمل لكوكوا تشان

187
00:12:16,810 --> 00:12:19,920
يجب أن أثبتَ لهم أنَّني قادرةٌ على العمَل

188
00:12:20,300 --> 00:12:22,980
إن استسلمتُ الآن، سوفَ أكونُ عاراً على جَميع السّاموراي

189
00:12:22,980 --> 00:12:25,300
سوف أحارب بقوة

190
00:12:26,980 --> 00:12:28,940
يجب أن يكونَ هذا كافياً

191
00:12:29,650 --> 00:12:32,080
إنَّها طريّة ورائحتها زكية

192
00:12:32,080 --> 00:12:32,890
العجينة؟

193
00:12:32,890 --> 00:12:34,020
يا له من حب مذهل

194
00:12:34,470 --> 00:12:36,770
والآن نتركُ العجينةَ لمُدّة ساعة

195
00:13:15,610 --> 00:13:18,120
ما هو الشَّكل الّذي تصنعينهُ يا تشينو؟

196
00:13:18,120 --> 00:13:19,640
شكلُ جدّي

197
00:13:19,640 --> 00:13:22,360
كانَ يلعبُ معي منذُ أن كنتُ صغيرة

198
00:13:22,360 --> 00:13:24,330
أنتِ مُدلَّلةُ جدّكِ إذاً

199
00:13:25,070 --> 00:13:28,660
أنا أعشقُ الطّريقة الّتي كانَ يصبُّ بها القهوة

200
00:13:35,800 --> 00:13:38,670
حانَ الوقت لخبزِ جَدّي

201
00:13:39,750 --> 00:13:41,580
هل لديكِ بعض الوقت يا تشيا تشان؟

202
00:13:41,580 --> 00:13:42,380
ما الأمر؟

203
00:13:42,770 --> 00:13:44,230
مُفاجأة

204
00:13:44,230 --> 00:13:47,130
فنّ اللاتيه الخاص، فقط من أجلك

205
00:13:48,220 --> 00:13:49,400
كم هذا جميل

206
00:13:49,400 --> 00:13:51,510
أنا مسرورةٌ جدّاً بهذه النتيجة

207
00:13:51,510 --> 00:13:53,340
سوفَ أجرّبُ القليلَ منه

208
00:14:01,610 --> 00:14:03,860
...تُحفتي الفنيّة

209
00:14:05,220 --> 00:14:07,390
إنّها تُصعّبُ عليَّ الأمور

210
00:14:09,030 --> 00:14:12,470
لماذا أنتِ مُلتصقةٌ بالفُرن يا تشينو تشان؟

211
00:14:14,950 --> 00:14:16,600
هل الأمر ممتع إلى هذه الدرجة؟

212
00:14:17,450 --> 00:14:19,640
إنَّها تكبُرُ وتكبُر

213
00:14:20,340 --> 00:14:24,250
كَبُرَ جدّي أكثر من خُبز كوكوا سان و تشيا سان

214
00:14:24,250 --> 00:14:28,430
خُبزُكِ متأخر يا ريزي سان، عليك أن تحاولي بجد أكبر

215
00:14:28,430 --> 00:14:30,180
!لا تقولي لي ذلك

216
00:14:35,060 --> 00:14:37,310
لنأكل

217
00:14:38,150 --> 00:14:38,940
هذا لذيذ

218
00:14:38,940 --> 00:14:40,520
إنّهُ طريٌّ جدّاً

219
00:14:40,520 --> 00:14:42,270
تماماً كما توقّعتُ من خبز طري

220
00:14:43,080 --> 00:14:45,530
بإمكاننا أن نصنعَ لائحةً من هذا الخُبز

221
00:14:45,880 --> 00:14:47,150
هذا خبزٌ بالخوخ

222
00:14:47,460 --> 00:14:48,900
هذا خبزُ ياكي أودون

223
00:14:48,900 --> 00:14:50,660
هذا جدّي المحروق

224
00:14:51,820 --> 00:14:54,160
لا شيءَ من هذا يجعلني أشعرُ بالجّوع

225
00:14:55,920 --> 00:14:58,100
صنعتُ خبزَ تيبي أيضاً

226
00:14:58,100 --> 00:14:59,660
كم هذا ظريف

227
00:15:01,180 --> 00:15:03,570
أعتقدُ أنَّ فكرة الّلائحة ستكونُ رائعة

228
00:15:03,570 --> 00:15:04,880
سوفَ أجرّب واحدةً

229
00:15:06,540 --> 00:15:08,380
إنَّها طريّةٌ للغاية

230
00:15:10,010 --> 00:15:11,890
أتمنّى أن يكونَ مذاقها لذيذاً

231
00:15:16,060 --> 00:15:18,790
استخدمتُ مُربّى الفراولة الّتي أحضرتها ريزي سان

232
00:15:18,790 --> 00:15:19,850
إنَّهُ لذيذ، أليسَ كذلك؟

233
00:15:20,210 --> 00:15:23,230
أجل... ولكن

234
00:15:24,070 --> 00:15:26,370
هذا مُخيفٌ نوعاً ما

235
00:15:35,430 --> 00:15:37,620
يجب أن يكونَ هنا

236
00:15:38,760 --> 00:15:41,350
لشُكرِكُن على دعوتي لصُنعِ الخبز معكن

237
00:15:41,350 --> 00:15:44,130
سأدعوكن إلى مقهى عائلتي

238
00:15:44,480 --> 00:15:46,780
أتشوّقُ لرؤية شكل المقهى

239
00:15:46,780 --> 00:15:48,880
ماذا يُدعى المقهى؟

240
00:15:49,230 --> 00:15:51,830
..رُبّما آما أوسا

241
00:15:51,830 --> 00:15:53,180
هل قُلتِ آما أوسا؟

242
00:15:53,180 --> 00:15:54,920
هل تعرفينَ مكانهُ يا تشينو تشان؟

243
00:15:54,920 --> 00:15:58,120
أذكرُ أنَّهُ كانَ مُنافساً عندما افتتحَ جدّي المقهى

244
00:16:00,580 --> 00:16:01,850
أليسَ هذا هو؟

245
00:16:02,760 --> 00:16:04,810
اللافتةُ راقيةٌ جدّاً

246
00:16:05,350 --> 00:16:06,860
يبدو مكاناً مُثيراً للاهتمام

247
00:16:07,530 --> 00:16:10,360
أنا... أرنب... جميل؟

248
00:16:11,580 --> 00:16:13,280
بل اسمهُ آما أوسا آن

249
00:16:14,140 --> 00:16:15,750
مرحباً

250
00:16:16,260 --> 00:16:18,870
أهلاً بكن

251
00:16:19,210 --> 00:16:23,440
أهذا الرِّداءُ هو زِيُّ العمل؟

252
00:16:23,440 --> 00:16:26,470
كنتِ ترتدينهُ عندما قابلتُكِ أوّلَ مرّة

253
00:16:26,470 --> 00:16:31,040
كنتُ عائدةً للمنزل بعد أن سلّمتُ حلوى اليوكان لزبونتنا

254
00:16:31,040 --> 00:16:34,420
ذاكَ اليوكان لذيذٌ جدّاً، تناولتُ ثلاثةً منه

255
00:16:34,420 --> 00:16:36,590
أكلتِ ثلاث قطعٍ لوحدك؟

256
00:16:36,920 --> 00:16:38,350
! أرنب

257
00:16:39,010 --> 00:16:41,100
يُدعى آنكو، وهو أرنب مُلصَق المقهى

258
00:16:41,100 --> 00:16:42,900
اعتقدتُ أنَّهُ تِمثال

259
00:16:42,900 --> 00:16:46,770
لا يتحرّكُ آنكو إلّا إن حفّزهُ شيءٌ ما

260
00:16:48,380 --> 00:16:49,250
تشينو

261
00:16:49,660 --> 00:16:51,670
هل أنتِ بخير يا تشينو؟

262
00:16:53,490 --> 00:16:55,030
باغتَني ذاكَ الشّيء

263
00:17:00,420 --> 00:17:02,370
هل يضربُ دائماً بسبب طبيعتهِ العدائيّة؟

264
00:17:02,810 --> 00:17:06,120
كلا، إنّهُ الحب من النَّظرة الأولى

265
00:17:06,680 --> 00:17:08,130
الحبّ من النَّظرة الأولى؟

266
00:17:08,890 --> 00:17:11,780
لطالما ظننت أنَّهُ خجول

267
00:17:11,780 --> 00:17:13,300
يبدو أنَّهُ جدِيٌّ

268
00:17:13,300 --> 00:17:16,810
أليسَ تيبي ذكراً؟

269
00:17:16,810 --> 00:17:18,340
بل تيبي أنثى

270
00:17:19,300 --> 00:17:21,180
ولكن ليسَ من الدّاخل

271
00:17:23,120 --> 00:17:27,350
حاولتُ تجربة فن الرَّسم ولكن بالماتشا
كيفَ يبدو؟

272
00:17:27,350 --> 00:17:29,110
ماذا رسمتِ؟

273
00:17:29,590 --> 00:17:32,610
لا أستطيعُ رسمَ شيءٍ جميل مثلكِ

274
00:17:32,990 --> 00:17:35,550
ولكنَّني أحبُّ أعمال هوكوساي

275
00:17:35,550 --> 00:17:36,860
أهذه أوكيويي؟

276
00:17:37,550 --> 00:17:40,140
أنا أحبُّ باشو ساما أيضاً

277
00:17:40,990 --> 00:17:42,490
كم هذا جميل

278
00:17:42,880 --> 00:17:45,690
هذه هي اللائحة

279
00:17:46,890 --> 00:17:48,740
الجواهر الثّلاثة المُتألّقة

280
00:17:48,740 --> 00:17:50,940
الجوهرة الحمراء في حقل الثّلج

281
00:17:50,940 --> 00:17:53,650
القمر والنجوم المُنعكسة على البحر

282
00:17:54,180 --> 00:17:57,380
لمَ يبدو كُلّ شيءٍ في القائمة كمعركةٍ في مجلّةِ مانغا؟

283
00:17:59,260 --> 00:18:01,840
من المؤكّد أنَّ كعكة الماتشا لذيذة

284
00:18:01,840 --> 00:18:04,890
ولكن تبدو قشدة الآنميتسو وشيراتاما لذيذتان

285
00:18:04,890 --> 00:18:06,100
هل تعرفينها؟

286
00:18:06,550 --> 00:18:10,380
حسناً سأتناول الشاتشيهوكو الذهبي الخاص

287
00:18:10,380 --> 00:18:12,140
...لا أعلم ماذا يكون ولكن

288
00:18:12,140 --> 00:18:14,330
سأتناول القمر والنجوم المُنعكسة على البحر

289
00:18:14,330 --> 00:18:16,950
أريد ثالوت مجوهرات العاصمة المزهرة

290
00:18:17,300 --> 00:18:19,700
حسناً، انتظرن قليلاً

291
00:18:20,230 --> 00:18:23,770
الملابس اليابانيّة جميلةٌ جدّاً

292
00:18:24,730 --> 00:18:26,280
هل تريدينَ تجربتها؟

293
00:18:26,280 --> 00:18:28,500
كلا، لم أقصد هذا

294
00:18:28,500 --> 00:18:30,830
أنا متأكّدة أنَّها ستكونُ رائعة عليكِ يا ريزي تشان

295
00:18:32,880 --> 00:18:34,830
هل تعتقدينَ هذا؟

296
00:18:35,800 --> 00:18:36,590
أجل

297
00:18:40,390 --> 00:18:42,340
ستبدينَ جميلة

298
00:18:42,340 --> 00:18:43,170
أجل، أجل

299
00:18:45,540 --> 00:18:47,180
شكراً على انتظاركُن

300
00:18:47,180 --> 00:18:50,950
طلبت ريزي تشان القمر والنّجوم المُنعكسة على البحر

301
00:18:50,950 --> 00:18:52,730
إنَّهُ حساءُ حبوب الآزوكي بالشيراتاما والبندق

302
00:18:53,160 --> 00:18:56,570
طلبت تشينو تشان ثالوث مجوهرات العاصمة المزهرة

303
00:18:56,570 --> 00:18:58,990
هناكَ غصنٌ من شجرة الدانغو في الآنميتسو

304
00:18:58,990 --> 00:19:02,690
وطلبت كوكوا تشان الشاتشيهوكو الذّهبي الخاصّ

305
00:19:04,170 --> 00:19:07,580
ألا يُعتبرُ استخدام العود من أجل الشاتشيهوكو أمراً مُبالغاً به؟

306
00:19:07,960 --> 00:19:09,580
استمتعن بوقتكُن

307
00:19:09,970 --> 00:19:12,780
لنتناول الحلوى

308
00:19:15,480 --> 00:19:17,050
إنَّها لذيذةٌ جدّاً

309
00:19:18,940 --> 00:19:21,450
هذا الدانغو بنكهة الساكورا

310
00:19:21,450 --> 00:19:24,230
أحضرتُ لكَ اليوكان بالبندق يا آنكو

311
00:19:26,450 --> 00:19:27,660
ما الأمر؟

312
00:19:27,660 --> 00:19:29,930
هل يريدُ تناول حلوانا؟

313
00:19:29,930 --> 00:19:33,890
خُذ قضمةً صغيرةً فقط

314
00:19:33,890 --> 00:19:37,230
بالمُقابل دَعني أداعبك فيما بعد

315
00:19:38,720 --> 00:19:39,940
إنَّهُ يأكلُ كلَّ شيء

316
00:19:39,940 --> 00:19:40,950
ياللهول

317
00:19:41,580 --> 00:19:44,780
حساءُ حبوب الآزوكي رائعٌ جدّاً

318
00:19:45,510 --> 00:19:48,410
يجب أن نفعل شيئاً كهذا في مقهانا أيضاً

319
00:19:48,410 --> 00:19:52,970
ما رأيك في شراكة مع رابت هاوس إذاً؟

320
00:19:52,970 --> 00:19:54,910
أظنُّ أنَّها فكرةٌ رائعة

321
00:19:54,910 --> 00:19:56,500
...أشياء مثل قهوة الآنميتسو

322
00:19:56,830 --> 00:20:00,300
يبدو هذا رائعاً، ماذا عن المناشف وحقائب التسوّق؟

323
00:20:00,300 --> 00:20:02,260
أريد كوب قهوة

324
00:20:03,350 --> 00:20:05,260
ألن نتكلّم عن أفكارٍ للطّعام؟

325
00:20:05,910 --> 00:20:07,890
شكراً لكِ على الحلوى

326
00:20:08,670 --> 00:20:11,520
ألا تريدينَ أن تُربّتي على آنكو يا تشينو تشان؟

327
00:20:11,520 --> 00:20:15,150
تقولُ تشينو أنَّ تيبي هو الحيوان الوحيد الذي يحبها

328
00:20:45,990 --> 00:20:48,720
أصبحتما صديقين بسرعة

329
00:20:49,940 --> 00:20:52,490
لن يكون الأمر كافياً إلّا إن وضعتهُ على رأسها

330
00:20:55,160 --> 00:20:57,440
هلّا عُدنا الآن؟

331
00:20:57,880 --> 00:21:00,320
تعاليْن مرّةً أخرى

332
00:21:00,750 --> 00:21:01,570
بكلّ تأكيد

333
00:21:02,380 --> 00:21:05,070
لو كنتُ أقيمُ في منزلك

334
00:21:05,530 --> 00:21:08,700
لكنتُ ساعدتكِ هنا يا تشيا تشان

335
00:21:09,210 --> 00:21:11,510
أرحّبُ بكِ إن أردتِ أن تبدئي الآن

336
00:21:11,510 --> 00:21:14,080
إنَّنا نُوظّفُ طاقماً جديداً دائماً

337
00:21:14,080 --> 00:21:15,870
يبدو هذا رائعاً

338
00:21:15,870 --> 00:21:18,710
إنَّهُ مقهى أيضاً، لذا سوف تتأقلمين

339
00:21:19,050 --> 00:21:21,350
سوف أُخلي غرفةً من أجلك

340
00:21:21,350 --> 00:21:23,440
أحضري أغراضكِ حالاً

341
00:21:23,440 --> 00:21:25,720
فليوقفها أحدٌ رجاءً

342
00:21:25,720 --> 00:21:27,780
إلى الّلقاء يا تشيا تشان

343
00:21:27,780 --> 00:21:29,180
شكراً لكِ على الحلوى

344
00:21:29,180 --> 00:21:30,280
إلى الّلقاء

345
00:21:32,390 --> 00:21:35,180
إذاً كانَ هذا المقهى مُنافساً لنا؟

346
00:21:36,010 --> 00:21:38,690
هذا لا يعني شيئاً الآن

347
00:21:39,480 --> 00:21:43,440
يجب أن نعملَ بجهد لإرضاء زبائننا أيضاً

348
00:21:43,850 --> 00:21:44,840
أجل

349
00:21:50,580 --> 00:21:53,830
!ما خطب هذا اليوكان بالبندق؟ إنه حلو للغاية

350
00:21:53,830 --> 00:21:55,300
إنّهُ حلوُ المذاق، حلوُ المذاق

351
00:21:55,300 --> 00:21:56,490
هذا لذيذ، هذا لذيذ

352
00:21:56,490 --> 00:21:57,620
حلوُ المذاق للغاية

353
00:23:27,820 --> 00:23:37,560
في الحلقة القادمة: أتذكر عندما شربتَ وحاولت إشعال نار المخّيّم بمنزلك ؟

354
00:23:28,230 --> 00:23:30,460
أحبُّ الصّحون ذات الملمس النَّاعم

355
00:23:30,460 --> 00:23:34,330
هناكَ كثيرٌ من الأشخاص لا يُقاومونَ نعومتي و فِرائي

356
00:23:34,330 --> 00:23:36,520
...عندما أذهب إلى المتنزّه

357
00:23:36,520 --> 00:23:37,560
لماذا ضحكت؟