1
00:00:24,420 --> 00:00:26,540
استيقظي يا كوكوا سان رجاءً

2
00:00:27,060 --> 00:00:30,500
!كوكوا سان، أنا جادة... استيقظي

3
00:00:42,120 --> 00:00:43,730
تشينو تشان؟

4
00:00:49,800 --> 00:00:52,740
لماذا كُنتِ نائمة في غرفتي؟

5
00:00:53,180 --> 00:00:56,490
...أنا واثقة

6
00:00:56,920 --> 00:01:01,240
لأنَّكِ لم تترُكي كُمّي بعدَ أن غَفَوتِ

7
00:01:01,850 --> 00:01:05,580
رُبّما كانت رائحة الخبز الّذي خبزناه معًا بعد العشاء لا تزال عالقةً بي

8
00:01:06,060 --> 00:01:08,520
أنا متأكّدة لأنَّ رائحتكِ كانت لذيذة

9
00:01:19,910 --> 00:01:23,600
رُبّما كانت رائحة الطَّحين فوّاحة أكثر من رائحة الخبز

10
00:01:23,600 --> 00:01:24,730
إنَّها رائحةٌ عليلة

11
00:01:24,730 --> 00:01:27,990
ولكن في كِلا الحالَتَين ما زالت رائحة الخبز موجودة، أليس كذلك؟

12
00:01:27,990 --> 00:01:29,300
ماذا عنّي؟

13
00:01:29,300 --> 00:01:30,610
...رائحتكِ أنتِ

14
00:01:31,300 --> 00:01:34,230
مثل شيء قد يحيطك بحضن دافئ

15
00:01:34,230 --> 00:01:36,820
إنَّها تذكّرني بوابي سابي

16
00:01:36,820 --> 00:01:37,820
وابي سابي؟

17
00:01:39,410 --> 00:01:42,820
يبيعُ هذا السّوق الكثير من الأشياء، حتى بنهاية السَّنة

18
00:01:42,820 --> 00:01:45,640
أعلمُ أنَّنا جِئنا بمُهمّة ولكنَّني أستمتع بوقتي

19
00:01:45,640 --> 00:01:47,460
كان على تشينو تشان أن تأتي معنا

20
00:01:47,910 --> 00:01:51,740
هذا مُمتعٌ بطريقةٍ مُختلفة أكثر من عيد الميلاد

21
00:01:51,740 --> 00:01:54,960
رائحةُ الفواكهَ والّلحوم تشعرني بالجّوع

22
00:01:55,800 --> 00:01:57,840
تأكلُ ريزي تشان شيئًا ما

23
00:01:57,840 --> 00:02:00,030
...كوكوا... تشيا

24
00:02:00,890 --> 00:02:02,740
هل تأكلُ شارو تشان العيّنات؟

25
00:02:02,740 --> 00:02:04,060
!لقد اشتريتها

26
00:02:04,470 --> 00:02:07,410
أنا متفاجئةٌ من ملاحظتكما لنا

27
00:02:07,410 --> 00:02:09,430
بين كلّ هؤلاء النّاس هنا

28
00:02:09,430 --> 00:02:11,240
كنتُ أشعر بالجوع

29
00:02:11,240 --> 00:02:14,070
ورائحةُ الأعشاب تفوحُ من شارو تشان

30
00:02:14,070 --> 00:02:15,850
هل أنتِ جادّة؟

31
00:02:15,850 --> 00:02:18,700
هل الرّائحةُ مُلتصقةٌ بي لهذه الدَّرجة؟

32
00:02:18,700 --> 00:02:21,420
لقد كانت تمزَح، لا داعي لأن تتحقَّقِي

33
00:02:21,990 --> 00:02:24,700
تفوح منك رائحة خطيرة يا ريزي تشان مثل البارود

34
00:02:24,700 --> 00:02:26,130
لهذا أستطيعُ التعرُّف عليكِ عندما تكونين بالجوار

35
00:02:27,900 --> 00:02:30,580
لقد كنتُ أمزح، لا داعي لأن تتحقَّقي

36
00:02:37,340 --> 00:02:40,600
كلّ هذا التِّجوال يشعرنا بالجوع، لا يمكننا فعل شيء حيال ذلك

37
00:02:40,600 --> 00:02:42,680
أنا لا أفعل هذا دائما

38
00:02:43,210 --> 00:02:46,010
إنَّنا مشغولات دائماً بالعمل

39
00:02:46,010 --> 00:02:50,230
ولكن عندما نفعل أشياءَ كهذه، فإنَّنا نبدو كطالبات ثانويّةٍ عاديّات

40
00:02:50,230 --> 00:02:51,560
أنتِ مُحقّة

41
00:02:51,950 --> 00:02:55,200
هذه البلدة جميلةٌ جدّاً و هواءها نقي جدًا

42
00:02:55,200 --> 00:02:56,710
ورائحتها جميلة

43
00:02:56,710 --> 00:02:59,460
هذه رائحة الكعكة المحلاة الّتي تحملينها

44
00:02:59,460 --> 00:03:01,570
بما أنَّكِ ذكرتِ الأمر

45
00:03:01,570 --> 00:03:04,060
أصبحتُ مُعتادةً عليه، ولم يَخْطُرُ لي الأمر

46
00:03:04,060 --> 00:03:06,830
والهواءُ أنقى في الشّتاء

47
00:03:07,320 --> 00:03:10,160
لنأخذ كُلّنا نفَسًا عميقاً

48
00:03:10,160 --> 00:03:12,380
شهيق

49
00:03:13,500 --> 00:03:14,460
زفير

50
00:03:16,310 --> 00:03:18,270
هذا مُريحٌ جدّاً

51
00:03:18,270 --> 00:03:20,710
أشعرُ وكأنَّني نسيتُ شيئاً

52
00:03:20,710 --> 00:03:23,340
هل غداً هو الأحد؟

53
00:03:23,980 --> 00:03:28,270
أشعرُ وكأنَّني وُكِّلتُ بمهمّة تُفيدُ المُجتمع

54
00:03:29,930 --> 00:03:31,350
لقد تأخرت

55
00:03:33,080 --> 00:03:35,290
لقد كانت مُهمّةً صغيرةً فقط

56
00:03:37,430 --> 00:03:41,860
أنا أحبُّ رائحة القهوة يا جدّي

57
00:03:42,710 --> 00:03:45,500
رائحةُ الشّاي الأخضر والشاي بالأعشاب جميلةً أيضاً

58
00:03:45,500 --> 00:03:47,490
!أهلاً بكم! هيا

59
00:03:46,490 --> 00:03:47,490
..ولكن

60
00:03:47,910 --> 00:03:51,000
يبدو وكأنَّني وجدتُ رائحةً أخرى تُشعِرني بالرّاحة

61
00:03:54,480 --> 00:03:56,000
أتساءلُ متى ستَعود

62
00:04:00,310 --> 00:04:02,700
ياللهول، انظرن إلى الوقت

63
00:04:02,700 --> 00:04:04,530
يجب أن أعودَ بسرعة

64
00:04:04,530 --> 00:04:07,710
وقبلَ أن أعود، يجب أن أشتري تذكاراً لتشينو تشان

65
00:04:07,710 --> 00:04:10,520
سوف أتأخَّر إن لم أُسرِع أنا أيضًا

66
00:04:10,520 --> 00:04:13,050
لا أريدُ أن ينخفض مُرتَّبي

67
00:04:13,050 --> 00:04:15,400
تحصلُ مثلَ هذه الأشياء أحياناً

68
00:05:50,300 --> 00:05:51,740
لقد وصلنا

69
00:05:51,740 --> 00:05:53,700
ما الّذي جاءَ بكما إلى هنا؟

70
00:05:54,180 --> 00:05:56,370
هناكَ شيءٌ نودُّ التأكد منه من أجل واجبنا

71
00:05:56,370 --> 00:05:58,710
جِئنا لإقامة مُقابلةٍ لجميع من في المقهى

72
00:05:59,200 --> 00:06:00,580
سوف أسألكِ فوراً

73
00:06:01,020 --> 00:06:05,510
ما الشّيء الّذي يجعلُ عملك في هذا المقهى جديرًا بالاهتمام؟

74
00:06:05,510 --> 00:06:07,590
ابتساماتُ زبائننا

75
00:06:07,590 --> 00:06:09,730
تعمل كوكوا سان بدوام جزئي فقط

76
00:06:09,730 --> 00:06:10,470
تشينو تشان

77
00:06:10,980 --> 00:06:14,700
إن كانت لديكما أسئلة حول المقهى، اسألا والدي فهو مالكُ المكان

78
00:06:14,700 --> 00:06:16,260
هذا ليسَ سهلاً

79
00:06:16,260 --> 00:06:18,330
ولكن عندما أفكّر بعدد الأشخاص اللذين يأتون إلى هنا

80
00:06:18,330 --> 00:06:22,650
لشُرب فنجان قهوة في مكان هادئوسط شقاء الحياة العصرية

81
00:06:22,650 --> 00:06:24,700
فهذا يجعل عملي جديرًا بالاهتمام

82
00:06:24,700 --> 00:06:27,450
عندما يقول لي الزّبائن أنّهم سيعودون مرّةً أخرى

83
00:06:27,450 --> 00:06:30,320
فهذا يُشعرني أنّهم يعتبرون المكان كبيتهم الثّاني

84
00:06:30,320 --> 00:06:32,230
!تشينو تتحدّث

85
00:06:32,230 --> 00:06:34,920
على أيّ حال، أسرعي وبدّلي ثيابكِ من فضلك

86
00:06:34,920 --> 00:06:36,760
سوف أساعدك

87
00:06:36,760 --> 00:06:38,500
أعتقدُ أنَّهُ بإمكانكِ ذلك

88
00:06:38,500 --> 00:06:41,790
لطالما أردتُ المُساعدة هكذا

89
00:06:41,790 --> 00:06:43,530
شكراً يا ميغو تشان

90
00:06:44,090 --> 00:06:45,960
!إنَّه بالمقلوب

91
00:06:47,710 --> 00:06:50,720
هلاّ ذكرتني كيف ترتدين الرباط؟

92
00:06:51,300 --> 00:06:53,430
أعتقد أنَّها سترتدي ثيابها أسرع بنفسها

93
00:06:55,270 --> 00:06:57,360
المعذرة

94
00:07:02,060 --> 00:07:04,690
أينَ تشيمامي يا كوكوا؟

95
00:07:05,260 --> 00:07:07,690
إنهن تقابلن والد تشينو تشان

96
00:07:08,080 --> 00:07:10,960
فهمت، إنَّهُ تقريرٌ مهني، أليس كذلك؟

97
00:07:10,960 --> 00:07:13,870
توجب علينا ذلك في عطلة الشتاء في المدرسة الإعدادية

98
00:07:13,870 --> 00:07:15,200
يذكّرُني هذا بالماضي

99
00:07:15,200 --> 00:07:17,160
هل أجريتِ مُقابلة مع والدك؟

100
00:07:17,680 --> 00:07:20,230
أنا لا أخطّط للانضمام إلى الجّيش

101
00:07:20,230 --> 00:07:22,670
ولكنَّني كنتُ طفلةً نشيطة

102
00:07:23,750 --> 00:07:26,180
ذهبتُ إلى بائع الزّهور

103
00:07:26,180 --> 00:07:27,770
هذا أمر عادي

104
00:07:30,010 --> 00:07:33,430
ما هو أهمُّ شيءٍ لديك في إدارة هذا المقهى؟

105
00:07:33,960 --> 00:07:37,930
تقييمُ كُلّ كوبٍ من القهوة
واستخدام أفضل أنواع حبوب البنّ

106
00:07:38,430 --> 00:07:42,480
وأن نعرض للزّبائن الوقت والمكان الّلازِمان لكي يستمتعوا بالهدوءِ والسّكينة

107
00:07:43,130 --> 00:07:46,890
وأبتغي  مشاركة منظرو الزبائن، وهذا شيء افتقر له الجيل السابق

108
00:07:46,890 --> 00:07:47,520
!ماذا قلت؟

109
00:07:47,520 --> 00:07:51,610
!أنا أتفهم الزبائن أكثر منك بكثير

110
00:07:53,620 --> 00:07:54,240
!ماذا؟

111
00:07:54,920 --> 00:07:57,700
هل أعلنت تشينو الآن الحرب على جيل المقهى الثاني؟

112
00:07:58,280 --> 00:08:00,980
أعتقد أنَّ إدارة القطاع الخاص صعبةٌ جدّاً

113
00:08:00,980 --> 00:08:03,690
يبدو أنّ هناك الكثير من المنافسة

114
00:08:03,690 --> 00:08:05,540
يبدو أن المقابلة قد انتهت

115
00:08:06,330 --> 00:08:09,210
مازال هناك آما أوسا آن و فلور دو لابان

116
00:08:09,810 --> 00:08:13,110
أودُ إجراء مقابلةً معهما أيضاً

117
00:08:13,110 --> 00:08:17,040
لمَ لا تأخذيهما إلى هناك في استراحتك؟

118
00:08:17,510 --> 00:08:20,020
ولكن لديّ عملٌ أقومُ به

119
00:08:20,020 --> 00:08:23,790
سأحل محلك

120
00:08:23,790 --> 00:08:26,480
خُذيهما أرجوكِ يا كوكوا سان

121
00:08:28,440 --> 00:08:31,490
لا يمكنني أن أرفض طلبًا من أخواتي الطغيرات

122
00:08:32,100 --> 00:08:33,090
حقّاً؟

123
00:08:33,090 --> 00:08:34,660
هذا جيد

124
00:08:34,660 --> 00:08:36,620
أشعرُ بالرّاحة لمعرفة أنَّ كوكوا تشان ستكونُ معنا

125
00:08:37,430 --> 00:08:38,740
...مُهمّة استطلاع

126
00:08:39,990 --> 00:08:41,330
إن استخفَفتن بالأمر فسيَقضونَ عليكن

127
00:08:41,330 --> 00:08:42,890
سيقضونَ علينا؟

128
00:08:44,710 --> 00:08:47,000
إنَّ ريزي سان تمزحُ فقط

129
00:08:49,250 --> 00:08:52,460
أنتما صديقتا تشينو تشان

130
00:08:52,460 --> 00:08:53,800
سأقدّمُ لكما خِدمةً خاصّة

131
00:08:53,800 --> 00:08:58,350
لقد أتيا لإجراءِ مقابلةٍ معكِ لواجبٍ مدرسيّ

132
00:08:58,350 --> 00:08:59,310
سأدخلُ في صُلبِ الموضوع

133
00:08:59,310 --> 00:09:02,350
هل يوجد عداءٌ بينكِ وبين رابت هاوس؟

134
00:09:02,350 --> 00:09:05,810
كانَ هذا في وقت سابق
إنَّنا لا نتنافسُ الآن

135
00:09:05,810 --> 00:09:07,810
كلا، أعتقدُ أنَّنا منافسيْنِ قويين

136
00:09:07,810 --> 00:09:08,650
حقّاً؟

137
00:09:08,650 --> 00:09:12,940
سمعتُ مؤخّراً أنَّ والد تشينو تشان كانَ يعزفُ الجاز

138
00:09:12,940 --> 00:09:15,650
وجعلني هذا أدركُ أنَّنا نحتاجُ للموسيقى هنا

139
00:09:15,990 --> 00:09:17,020
...ولكن

140
00:09:17,020 --> 00:09:19,050
لا أملكُ الآلات الموسيقية لذا أغني

141
00:09:19,050 --> 00:09:19,880
هذا مُذهل

142
00:09:19,880 --> 00:09:21,870
إنَّها كحانة الكاريوكي

143
00:09:21,870 --> 00:09:26,060
هل تواجهينَ صعوبةً بالدّراسة والعمل سويّاً؟

144
00:09:26,060 --> 00:09:28,710
ألا تجدينَ صعوبةً بالتّوفيق بينهما؟

145
00:09:29,020 --> 00:09:31,210
يُعتبرُ العملُ كالدّراسة أيضاً

146
00:09:31,630 --> 00:09:34,720
إن فصلتِ بينهما فستجري الأمور على ما يُرام

147
00:09:34,720 --> 00:09:37,590
إنَّها تبدو رائعةٌ يا ميغو

148
00:09:37,590 --> 00:09:39,470
أجل إنَّها مُذهلة يا مايا تشان

149
00:09:39,900 --> 00:09:42,790
ساعديني بالرّياضيّات مجددا يا كوكوا تشان

150
00:09:42,790 --> 00:09:44,360
أنا في مأزقٍ كبير

151
00:09:44,360 --> 00:09:47,480
هلّا تُساعديني بمواد الفن الجميل أيضاً؟

152
00:09:50,100 --> 00:09:51,820
أهلاً بكم

153
00:09:51,820 --> 00:09:54,420
هذا المكان يليق بالأرانب أكثر من مقهاكم

154
00:09:54,420 --> 00:09:56,700
لقد خسرَ رابت هاوس

155
00:09:56,700 --> 00:09:58,570
انظري إلى طولِ هذه التنّورة

156
00:09:58,890 --> 00:09:59,840
ماذا؟

157
00:09:59,840 --> 00:10:01,460
إنَّها تتغلّبُ علينا بالجّرأة أيضاً

158
00:10:02,030 --> 00:10:04,890
لن أتفاجأ أبداً إن بدأت بالغِناء

159
00:10:04,890 --> 00:10:05,930
الغِناء؟

160
00:10:05,930 --> 00:10:08,020
هل لديكم خِدمةُ غناءٍ هنا؟

161
00:10:08,020 --> 00:10:08,960
كلا، لا نملك ذلك

162
00:10:09,430 --> 00:10:12,460
أتمنّى أن تُحِبّا شاي الأعشاب أكثر من الزِيّ الّذي أرتديه

163
00:10:12,460 --> 00:10:15,190
تريدُ أن تقتُلنا بعد أن نسترخي

164
00:10:15,190 --> 00:10:15,960
ماذا؟

165
00:10:15,960 --> 00:10:18,090
قومي بوضعية مقهاكم الخاصة

166
00:10:18,090 --> 00:10:19,260
هل أنا مُضطرّةٌ لذلك؟

167
00:10:20,690 --> 00:10:22,760
هذا ما يفعلونهُ في رابت هاوس

168
00:10:24,870 --> 00:10:27,480
..إن كانت سينباي تقومُ بهذا ، إذاً

169
00:10:29,500 --> 00:10:31,230
هذه خدمتنا

170
00:10:31,230 --> 00:10:34,190
حسناً ولكن ريزي تشان ترفض القيام بها

171
00:10:36,190 --> 00:10:40,530
إن كنتما تريدا إجراء مقابلات مهنية فهناك كاتبة روايات أيضًا

172
00:10:40,530 --> 00:10:42,740
أهي كاتبةُ رواياتٍ حقّاً؟

173
00:10:42,740 --> 00:10:44,280
لنجرّب هذا يا ميغو

174
00:10:44,280 --> 00:10:45,040
حسناً

175
00:10:46,100 --> 00:10:48,730
أكانت تلك مقابلة مهنية؟

176
00:10:48,730 --> 00:10:50,670
ماذا؟ ألم نُخبركِ؟

177
00:10:51,020 --> 00:10:55,390
أخبرينا من فضلك، كيفَ أصبحتِ كاتِبة
ولماذا تستمرّينَ بذلك؟

178
00:10:55,390 --> 00:10:58,890
..إن كانَ التحدُّث معي يُفيدكُما

179
00:10:59,880 --> 00:11:03,560
بدأتُ بها عندما نصحني أحدهم بذلك

180
00:11:04,280 --> 00:11:05,640
...وأقوك بذلك لأن

181
00:11:05,960 --> 00:11:06,970
لأنَّ ماذا؟

182
00:11:07,380 --> 00:11:10,690
هل السبب هو اللحظات التي ترين الناس تتأثر بأعمالك؟

183
00:11:11,040 --> 00:11:12,440
...في الواقع

184
00:11:15,650 --> 00:11:19,210
أستطيعُ مراقبة الفتيات التي تعملن هنا دون إثارة الشبهات

185
00:11:19,210 --> 00:11:22,040
تقصدينَ مراقبة الناس

186
00:11:22,040 --> 00:11:24,160
أليسَ هذا اختلاسٌ للنَّظر؟

187
00:11:26,690 --> 00:11:28,040
لم يبقَ لديَّ نقوداً

188
00:11:28,040 --> 00:11:31,540
كانت الحلويّات والشّاي بالأعشاب لذيذينَ جدّاً

189
00:11:31,540 --> 00:11:33,980
وتمكَنّا من سماعِ الكثير من القصص

190
00:11:33,980 --> 00:11:35,970
حسناً، هل أنتما جاهزتانِ للعودة؟

191
00:11:35,970 --> 00:11:37,350
هل سنعودُ بهذه السُّرعة؟

192
00:11:37,350 --> 00:11:39,670
لنذهب ونُجري مقابلاتٍ مع مقاهي أخرى

193
00:11:40,040 --> 00:11:43,470
لا يمكننا ذلك لأن تشينو تشان ستقلق علينا إن تأخرنا

194
00:11:46,190 --> 00:11:48,120
أرجوكِ يا أختي الكبرى

195
00:11:48,120 --> 00:11:51,180
نريدُ أن نبقى معكِ لفترةٍ أطول يا كوكوا أونيتشان

196
00:11:51,180 --> 00:11:53,650
يا للهول

197
00:11:54,350 --> 00:11:57,890
سوف تغضبُ تشينو تشان لتأخُّرنا

198
00:11:57,890 --> 00:12:00,620
لست أفهم من منكما الأخت الكبرى

199
00:12:03,470 --> 00:12:05,380
لقد عدنا يا ريزي

200
00:12:05,380 --> 00:12:06,830
كيفَ جرى الأمر؟

201
00:12:06,830 --> 00:12:10,620
هناكَ فُرصةٌ بأن ننُنافسكم عندما نكبر

202
00:12:10,620 --> 00:12:12,580
هل خنتمانا؟

203
00:12:13,450 --> 00:12:14,500
أتعلمينَ شيئاً؟

204
00:12:14,500 --> 00:12:18,900
أنتِ محظوظةٌ لحصولكِ على أختين أكبر منك كصديقتين يا تشينو تشان

205
00:12:18,900 --> 00:12:20,810
أختين؟

206
00:12:20,810 --> 00:12:24,140
أتساءلُ إن كنتُ سأصبح مثلهما يوماً ما

207
00:12:24,140 --> 00:12:27,100
أفضّلُ أن تبقي كما أنتِ يا ميغو سان

208
00:12:27,970 --> 00:12:29,640
سنعودُ سريعًا

209
00:12:30,280 --> 00:12:33,640
انظري، هناكَ الكثيرُ من الثّلج

210
00:12:34,450 --> 00:12:36,440
سوف أصنعُ أرنباً ثلجيّاً

211
00:12:36,440 --> 00:12:38,820
سأذهبُ للتسوّق بدونك

212
00:12:38,820 --> 00:12:40,390
انتهيت

213
00:12:40,390 --> 00:12:42,320
إنَّهُ ظريف

214
00:12:42,320 --> 00:12:46,240
هل أُعجبتِ بهذا اليء الصغير؟ أنت حقا لا تزالين طفلة

215
00:12:46,240 --> 00:12:47,200
من مِنّا الطفلة؟

216
00:12:47,660 --> 00:12:50,440
إن بقي الثَّلج عندَ بَدء الفصل الدراسي الجديد

217
00:12:50,440 --> 00:12:52,700
فأنا متأكّدة أنَّنا سنقيمُ حرباً بكراتِ الثّلج

218
00:12:52,700 --> 00:12:54,960
أنا متحمّسةٌ للغاية

219
00:12:54,960 --> 00:12:59,990
ولكنَّني أشعرُ بالبرد عندما أتخيّلك وأنت ترمينني بكرات الثّلج

220
00:13:01,710 --> 00:13:04,930
هلّا تنحنينَ قليلاً يا كوكوا سان؟

221
00:13:05,750 --> 00:13:07,930
لم أقصد اتّخاذ وضعيّة القِتال

222
00:13:11,230 --> 00:13:12,350
...حرارتكِ مرتفعة

223
00:13:13,460 --> 00:13:14,790
كوكوا سان

224
00:13:15,780 --> 00:13:17,810
اعتني بنفسكِ يا كوكوا تشان

225
00:13:18,420 --> 00:13:20,410
شكراً لزيارتك

226
00:13:20,410 --> 00:13:22,460
وشكراً لإحضارك الكثير من الأشياء

227
00:13:22,460 --> 00:13:24,570
خوخٌ مُعلّب وتُفّاحةٌ وثوم

228
00:13:24,570 --> 00:13:27,800
ارتداء الثّوم حولَ الرقبة يفيد ضد الرشح، أليس كذلك؟

229
00:13:27,800 --> 00:13:29,570
ألا تقصدينَ البصل المطهوّ؟

230
00:13:30,000 --> 00:13:32,410
أجل، هذا يُخيفُ أشباح المرض

231
00:13:33,200 --> 00:13:36,080
مصاصو الدماء هم من يُهزمون بالثوم

232
00:13:36,760 --> 00:13:38,580
سمِعتُ أنَّكِ أصبتِ بالرَّشح، هل أنتِ بخير؟

233
00:13:38,580 --> 00:13:41,500
هل أنتِ من قشّرها بهذه الطريقة يا ريزي تشان؟

234
00:13:41,500 --> 00:13:43,090
دعن التعامل مع السكاكين لي

235
00:13:43,800 --> 00:13:46,790
طلبت مِنّي تشينو صُنع أرانب من التفاحة

236
00:13:46,790 --> 00:13:49,340
ولكن لا يمكنني القول بأنها أرانب

237
00:13:49,340 --> 00:13:51,480
ألا يشبه هذا الأرنب أكثر؟

238
00:13:51,480 --> 00:13:52,330
هذا مُذهل

239
00:13:52,330 --> 00:13:53,270
كم هو ظريف

240
00:13:53,270 --> 00:13:55,560
لا تحملُ الأرانب العادية الأسلحة

241
00:13:56,200 --> 00:13:57,770
هل أنتِ بخير يا كوكوا؟

242
00:13:57,770 --> 00:13:59,770
هل أتعبناك بالتجوال معنا؟

243
00:13:59,770 --> 00:14:03,660
شكراً لقدومكما، ستكون أختكما الكبرى بخير

244
00:14:03,660 --> 00:14:05,110
إنَّها حمى بسيطة

245
00:14:05,110 --> 00:14:08,940
تحسّني بسرعة لكي نصنعَ رجلاً ثلجيّاً و نتقاتل بكرات الثلج

246
00:14:08,940 --> 00:14:09,870
إنَّها فكرةٌ رائعة

247
00:14:09,870 --> 00:14:11,660
إنَّها تحتاجُ للرّاحة

248
00:14:11,660 --> 00:14:14,500
لن يحصل هذا إلّا بعدَما تتعافى

249
00:14:14,500 --> 00:14:17,980
هذا صحيح، تُحاربُ كوكوا تشان الأشباحَ الآن

250
00:14:17,980 --> 00:14:18,920
تقصدينَ أشباح المرض

251
00:14:18,920 --> 00:14:21,170
لهذا تضعُ ثوماً حول رقبتها إذاً

252
00:14:21,170 --> 00:14:24,550
هذا صحيح، كان علي إحضار صليب أيضًا

253
00:14:24,550 --> 00:14:27,420
سكين ريزي سيبدو أفضل من الصليب

254
00:14:32,120 --> 00:14:35,690
لقد عادت الحمى يا كوكوا سان

255
00:14:35,690 --> 00:14:37,270
يجب أن ترتاحي

256
00:14:37,680 --> 00:14:40,190
اخلُدي إلى النّوم

257
00:14:40,190 --> 00:14:41,730
لنذهب يا فتيات

258
00:14:41,730 --> 00:14:43,050
سنأتي لاحقاً

259
00:14:43,050 --> 00:14:44,360
نامي قليلاً

260
00:14:44,360 --> 00:14:46,300
اعتني بنفسك يا كوكوا تشان

261
00:14:46,300 --> 00:14:47,690
أعتذر منكم جميعاً

262
00:14:48,300 --> 00:14:51,000
قومي بما يُطلبُ منكِ عندما تكونِين مريضة

263
00:14:51,650 --> 00:14:54,000
أعتذرُ يا تشينو تشان

264
00:14:54,000 --> 00:14:55,560
لا بأس

265
00:14:58,260 --> 00:15:00,580
لماذا لستِ في السّرير يا شارو تشان؟

266
00:15:01,530 --> 00:15:03,590
سئمتُ من المكوثِ في السّرير

267
00:15:03,590 --> 00:15:04,790
لا يمكنك فعل ذلك

268
00:15:04,790 --> 00:15:07,420
لن تتحسّني إن لم ترتاحي

269
00:15:07,420 --> 00:15:10,420
هيّا، ضعي هذا الثّوم حول رقبتكِ
وضعي مخلَّل الإجاص على بطنك

270
00:15:10,420 --> 00:15:11,870
لن أضعَ هذه الأشياء

271
00:15:11,870 --> 00:15:15,350
هذه العِلاجات الّتي تعلّمكِ إيّاها جدّتكِ خاطِئة

272
00:15:16,870 --> 00:15:18,280
...ولكن

273
00:15:18,280 --> 00:15:21,140
إوهام نفسك بالتحسن مهم للغاية

274
00:15:22,360 --> 00:15:25,150
أنتِ لا تُصدّقينَ أن هذه الأمور تنجح، أليس كذلك؟

275
00:15:25,470 --> 00:15:29,020
عليك الذهاب، ستصابين بالعدوى إن مكثت لفترة أطول

276
00:15:29,020 --> 00:15:31,900
هناك أسطورة تقول أن نقل الزكام يجعله يختفي

277
00:15:31,900 --> 00:15:33,870
أنتِ تُخاطرينَ بنفسك للاعتناء بي

278
00:15:35,870 --> 00:15:36,790
ما الّذي تفعلينه؟

279
00:15:37,460 --> 00:15:38,790
سأبقى هنا إلى أن تنامي

280
00:15:39,250 --> 00:15:42,050
سأستغرق بعض الوقت لإنهاء هذا الكتاب

281
00:15:53,180 --> 00:15:55,800
صنعت ريزي تشان عصيدة الأرز قبل أن تذهب

282
00:15:57,130 --> 00:15:58,430
تشي..نو

283
00:16:00,640 --> 00:16:01,890
هل تتألّمين؟

284
00:16:01,890 --> 00:16:04,810
أخبريني إن كان هناك ما يمكنني فعله

285
00:16:04,810 --> 00:16:06,190
...تشي... تشي

286
00:16:06,620 --> 00:16:07,320
ما الأمر؟

287
00:16:09,520 --> 00:16:10,820
كوكوا سان

288
00:16:11,530 --> 00:16:16,680
أريدُ ريزوتو سرطان البحر الموجود في ابحر الأبيض المتوسط

289
00:16:16,680 --> 00:16:18,830
البحر المتوسّط؟

290
00:16:20,830 --> 00:16:23,210
حرارتكِ مرتفعةٌ جدا

291
00:16:23,210 --> 00:16:24,210
تحتاجينَ إلى دواءكِ فوراً

292
00:16:24,570 --> 00:16:26,670
لم يعُد هناكَ المزيد من الدّواء يا تشينو

293
00:16:27,780 --> 00:16:30,440
كُلُّ المتاجر القريبة قد أغلقت

294
00:16:31,010 --> 00:16:32,910
ومازالَ أبي يعمل

295
00:16:34,380 --> 00:16:35,390
ماذا عليَّ أن أفعل؟

296
00:16:36,570 --> 00:16:39,820
لمَ لا تذهبين لمنزل تشيا وتستعيري دواءً؟

297
00:16:39,820 --> 00:16:41,770
فكرةٌ رائعة يا جدّي

298
00:16:41,770 --> 00:16:45,380
إن ركضتُ إلى هناك سأعود خلالَ ساعة

299
00:16:45,380 --> 00:16:48,110
ولكن هناكَ ثلجٌ كثيرٌ في الخارج، هذا خطير

300
00:16:55,040 --> 00:16:56,160
...أنا

301
00:16:56,660 --> 00:16:57,760
أنا ذاهبة

302
00:16:59,920 --> 00:17:00,910
تشينو

303
00:17:18,620 --> 00:17:20,230
إنَّها تُثلجُ بغزارة

304
00:17:21,520 --> 00:17:24,020
يجب أن أجرفَ الثّلج في الصّباح

305
00:17:24,340 --> 00:17:27,270
هل تفكّرينَ بالذّهاب إلى هناكَبمفردك في هذا الليل يا تشينو؟

306
00:17:28,350 --> 00:17:29,650
جدّي؟

307
00:17:29,650 --> 00:17:30,270
أجل

308
00:17:31,530 --> 00:17:34,460
أنتَ تندمجُ مع لون الثّلج ولا أستطيعُ رؤيتك

309
00:17:38,150 --> 00:17:41,470
شكراً لمجيئكَ معي يا جدّي

310
00:17:41,470 --> 00:17:45,860
ماذا عساي أن أفعل وأختك الكبرى العزيزة في تلك الحالة؟

311
00:17:45,860 --> 00:17:48,850
إنَّها ليست أختي الكبرى
كوكوا سان هي كوكوا سان

312
00:17:48,850 --> 00:17:50,580
توقّفي عن هذا

313
00:17:52,750 --> 00:17:53,760
...ولكن

314
00:17:53,760 --> 00:17:55,050
ماذا؟

315
00:17:55,750 --> 00:17:57,690
أنا لا أكرهُ

316
00:17:59,110 --> 00:18:01,180
رائحة كوكوا سان

317
00:18:03,500 --> 00:18:05,040
المعذرة

318
00:18:05,670 --> 00:18:07,520
كيفَ تشعرينَ الآن؟

319
00:18:08,240 --> 00:18:10,520
أحضرتُ بعض الشّراب السّاخن

320
00:18:11,210 --> 00:18:12,480
كوكوا سان

321
00:18:13,390 --> 00:18:14,360
ياللهول

322
00:18:15,080 --> 00:18:17,470
لن تتعافي أبداً بهذا الشَّكل

323
00:18:19,150 --> 00:18:22,650
بدأتُ أشعرُ بالبرد أيضاً

324
00:18:26,690 --> 00:18:29,370
هذا لذيذ

325
00:18:29,900 --> 00:18:32,880
شرابُ المعلّم لا يخيب أبدًا

326
00:18:32,880 --> 00:18:36,210
إنَّهُ يُدفئ الجَسد والرّوح

327
00:18:36,980 --> 00:18:40,160
ما هذا؟

328
00:18:40,160 --> 00:18:42,220
يوجد اثنتين من كوكوا سان هنا؟

329
00:18:42,760 --> 00:18:45,830
سأعودُ فيما بَعد

330
00:18:49,980 --> 00:18:51,450
تشينو تشان؟

331
00:18:56,930 --> 00:18:57,610
تشيا سان؟

332
00:18:57,610 --> 00:18:59,330
تشينو تشان؟

333
00:18:59,330 --> 00:19:02,870
هناكَ ثلجٌ على رأسك

334
00:19:02,870 --> 00:19:04,900
أعتقد أنَّهُ تيبي فقط

335
00:19:04,900 --> 00:19:09,180
هلّا تُعطيني دواءً للرَّشح إن كنتِ تملكينَ بعضاً منه؟

336
00:19:09,180 --> 00:19:11,620
نفذ دواء كوكوا سان

337
00:19:11,620 --> 00:19:13,880
بكلّ تأكيد، كم تحتاجين؟

338
00:19:13,880 --> 00:19:15,880
أتملكينَ هذا دائماً؟

339
00:19:16,430 --> 00:19:17,380
لقد طرأ شيءٌ ما

340
00:19:17,730 --> 00:19:19,510
هل شارو سان مريضةٌ أيضاً؟

341
00:19:19,860 --> 00:19:22,890
خُذي الدّواء وأسرعي بالعودة إلى كوكوا سان

342
00:19:22,890 --> 00:19:25,600
حسناً، شكراً لكِ

343
00:19:30,040 --> 00:19:31,480
يجب أن أسرع أنا أيضاً

344
00:19:40,920 --> 00:19:43,490
لقد احضرتُ دواءً لكِ يا كوكوا سان

345
00:19:44,870 --> 00:19:46,280
تشينو تشان؟

346
00:19:46,280 --> 00:19:48,000
هل أنتِ بخير؟

347
00:19:48,000 --> 00:19:50,500
أشعرُ ببعض التحسُّن

348
00:19:50,500 --> 00:19:53,500
ماذا حصلَ لجبهتك؟

349
00:19:54,150 --> 00:19:58,760
إن قلتُ لها أني انزلقتُ على الثّلج ووقعتُ على وجهي فسوف تضحك

350
00:19:58,760 --> 00:20:03,580
هل وقعتِ بينما كُنتِ تلعبينَ بالثّلج وتقاتلين بكرات الثلج

351
00:20:03,580 --> 00:20:04,640
يجب أن تكوني حذِرة

352
00:20:04,640 --> 00:20:06,600
لقد وقعتُ بشكلٍ طبيعيّ

353
00:20:06,970 --> 00:20:10,100
إن التقطتِ العدوى مِنّي يا تشينو تشان

354
00:20:10,530 --> 00:20:13,460
سوف أبذلُ جهدي للاعتناء بكِ

355
00:20:14,530 --> 00:20:17,020
أنا لستُ ضعيفةً لذلك الحد

356
00:20:17,490 --> 00:20:19,590
لقد درّبتني ريزي سان

357
00:20:25,740 --> 00:20:28,430
لم تلتقطي العدوى مِنّي

358
00:20:28,430 --> 00:20:30,630
ولكنَّكِ مرضتِ بالنّكاف

359
00:20:30,630 --> 00:20:32,840
لسبب ما أشعر أني خسرت

360
00:20:32,840 --> 00:20:35,170
يجب أن ترتاحي قليلاً

361
00:20:35,680 --> 00:20:38,170
هذه المرّة، ستعتني بكِ أختكِ الكبرى

362
00:20:38,170 --> 00:20:40,180
سأكونُ بخيرٍ بمفردي

363
00:20:40,180 --> 00:20:42,170
مازالت حرارتي مُنخفضة

364
00:20:42,170 --> 00:20:45,180
عندما تكونين مريضة يجب أن تفعلي ما يُطلبُ منكِ

365
00:22:21,210 --> 00:22:23,270
هل تعافيتِ من النكاف؟

366
00:22:23,810 --> 00:22:26,780
صباحُ الخير، أجل أنا بخير

367
00:22:27,210 --> 00:22:30,100
لم أكُن أعلم أنَّ مرض النّكاف مازالَ موجوداً

368
00:22:30,100 --> 00:22:33,990
عندما تُصابينَ بالنّكاف
تُصبحُ وجنتاكِ كبيرتانِ للغاية صحيح؟

369
00:22:34,750 --> 00:22:36,280
بالمُناسبة، أينَ هي كوكوا؟

370
00:22:36,280 --> 00:22:38,210
لا أعتقد أنَّها استيقظت بعد

371
00:22:38,520 --> 00:22:39,540
ياللهول

372
00:22:42,070 --> 00:22:43,670
سوف أذهبُ لإيقاظها

373
00:22:49,550 --> 00:22:52,440
حانَ وقتُ افتتاح المقهى يا كوكوا سان

374
00:22:52,440 --> 00:22:53,430
استيقظي أرجوكِ

375
00:22:53,790 --> 00:22:56,890
عندما يُصبحُ الخبز جاهزاً
أطلقي الصّافرة لإعلامي

376
00:22:57,270 --> 00:23:00,790
ألم نُقرِّر أن نعمل سويّاً اليوم بما أنَّنا أصبحنا بصحّةٍ أفضل؟

377
00:23:00,790 --> 00:23:03,230
عشرونَ دقيقة أخرى

378
00:23:16,040 --> 00:23:17,790
أنتِ تنامينَ كثيراً يا أونيتشان

379
00:23:20,630 --> 00:23:24,400
لماذا أيقظك صوت أخفت من صوت المنبه؟

380
00:23:24,400 --> 00:23:26,720
سؤالٌ جيّد

381
00:23:30,890 --> 00:23:34,060
ما الّذي قلتهِ للتو يا تشينو تشان؟

382
00:23:34,060 --> 00:23:36,180
لم أقل شيئاً