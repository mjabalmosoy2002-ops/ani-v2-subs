1
00:00:10,280 --> 00:00:12,130
أهلاً

2
00:00:12,130 --> 00:00:14,110
هذه زميلتي في الصفّ واسمُها تشيا تشان

3
00:00:14,620 --> 00:00:18,000
إنَّها فتاةُ المُلصقات لمتجر آما أوسا آن للحلويّات

4
00:00:20,220 --> 00:00:23,360
"تفضّلي إنَّهُ طبق "المُحاربون بعدَ آثار الحلم

5
00:00:23,360 --> 00:00:26,640
يبدو طبقاً رائعاً للغاية

6
00:00:26,640 --> 00:00:28,750
يبدو كساحةِ معركةٍ حقيقيّة

7
00:00:32,830 --> 00:00:36,900
أعتقد أنَّ المذاق ينقصهُ شيء

8
00:00:36,900 --> 00:00:38,760
أتعتقدينَ هذا أيضاً يا كوكوا تشان؟

9
00:00:39,200 --> 00:00:40,260
كنتُ أعلمُ هذا

10
00:00:40,760 --> 00:00:42,790
أحتاجُ إلى إيجاد الجّزء النّاقص

11
00:02:35,100 --> 00:02:37,720
المكانُ هادئٌ جدّاً بدونِ كوكوا

12
00:02:39,320 --> 00:02:40,220
أجل

13
00:02:41,050 --> 00:02:43,470
لديكِ بضعةُ أيّامٍ فقط من أجلِ الدِّراسة قبل الإمتحان

14
00:02:43,470 --> 00:02:45,470
هل ستَبقينَ في منزل تشيا للدّراسة إذاً؟

15
00:02:45,780 --> 00:02:49,600
هكذا إذًا! أعيريني تيبّي إذًا يا تشينو تشان

16
00:02:50,090 --> 00:02:52,160
ما الّذي تُخطّطين لهُ؟

17
00:02:53,230 --> 00:02:53,940
..أنا

18
00:02:54,610 --> 00:02:57,640
لا أستطيعُ النَّوم بدون أن ألاعبه

19
00:02:57,640 --> 00:02:59,610
إنَّهُ ليسَ آداة تساعد على النوم

20
00:02:59,610 --> 00:03:02,870
إذاً، لكي أمضي ليلة هانئة

21
00:03:03,300 --> 00:03:06,200
على الأقل دعيني أداعبه مسبقًا

22
00:03:06,200 --> 00:03:07,900
هل أنت دب سبِت؟

23
00:03:10,140 --> 00:03:12,840
مع أنَّ المكان هادئٌ جدّاً

24
00:03:12,840 --> 00:03:14,980
إلّا أنَّه سيُصبحُ مليئاً بالضَجّة بعد قليل

25
00:03:16,100 --> 00:03:18,980
ستأتي مايا سان و ميغو سان لكي تبيتان الّليلة هنا

26
00:03:20,260 --> 00:03:23,220
مرحباً تشينو وريزي

27
00:03:23,220 --> 00:03:25,010
شكراً لكما لقبولكما بمكوثنا هنا

28
00:03:25,010 --> 00:03:28,380
سوف سنُنَشّط المكان بدلا عن كوكا

29
00:03:28,380 --> 00:03:30,070
لنعمل بجدّ

30
00:03:30,070 --> 00:03:32,310
كانت كوكوا ستَسعَد لو كانت هنا

31
00:03:32,310 --> 00:03:33,900
الكثير من الأخوات الصَّغيرات

32
00:03:34,430 --> 00:03:35,980
شكراً لاستِضافتِكُما لنا

33
00:03:35,980 --> 00:03:36,780
لا مشكلة

34
00:03:39,220 --> 00:03:41,370
بوجود ثلاث فتياتٍ هنا

35
00:03:41,370 --> 00:03:43,620
أعتقد أنَّني سوف أخلط أسماءهن

36
00:03:43,620 --> 00:03:44,660
حتّى اسمي؟

37
00:03:45,120 --> 00:03:47,700
سوف نضعُ تشينو ومايا وميغو سويّاً

38
00:03:47,700 --> 00:03:48,660
"يتكوّنُ معنا "تشيمامي

39
00:03:48,660 --> 00:03:50,120
لم يُعجبني الاسم

40
00:03:50,120 --> 00:03:51,370
وأنا أيضاً

41
00:03:54,180 --> 00:03:56,640
تبدينَ رائعة يا ريزي

42
00:03:56,640 --> 00:03:59,380
زي الساقي مذهل

43
00:03:59,380 --> 00:04:01,040
حقّاً؟

44
00:04:01,040 --> 00:04:03,730
تفضّلا، إن كنتما تُريدانَ العمل فسوفَ تحتاجانَ للزيّ الرسميّ

45
00:04:03,730 --> 00:04:04,390
أنستطيعُ الحصول عليها؟

46
00:04:04,870 --> 00:04:06,970
هلّا تُعيريني مُسدّساً إذاً؟

47
00:04:06,970 --> 00:04:08,310
لا تنجرفي كثيراً

48
00:04:08,310 --> 00:04:09,900
ياللأسف

49
00:04:11,550 --> 00:04:14,590
حسناً، عندما تنتهيان اخرجا إلى صالة الطّعام

50
00:04:14,590 --> 00:04:15,560
حسناً

51
00:04:16,070 --> 00:04:19,550
شعرتُ وكأنَّها تقول
أنَّني لا أستطيع الحصول الآن إلا على الزيّ

52
00:04:19,550 --> 00:04:22,190
يجب أن تكتسبي خِبرةً إذاً

53
00:04:25,250 --> 00:04:26,200
استعد

54
00:04:27,560 --> 00:04:29,780
تيبي ليسَ وحشاً

55
00:04:31,670 --> 00:04:33,160
شكراً على انتظارك

56
00:04:33,750 --> 00:04:37,170
بينما نعملُ هنا، سنرتدي ضفائر

57
00:04:37,170 --> 00:04:38,540
إنَّنا مُتشابهات

58
00:04:38,940 --> 00:04:40,620
هذه قاعدةٌ غريبة

59
00:04:40,620 --> 00:04:42,050
لقد قلدناك

60
00:04:42,380 --> 00:04:44,360
أعتقد أنَّهُ لا بأس بهذا

61
00:04:44,360 --> 00:04:45,550
ليسَ سيّئاً

62
00:04:46,300 --> 00:04:46,930
ميغو

63
00:04:47,630 --> 00:04:49,310
أيُّ واحدةٌ هي ريزي الأصليّة؟

64
00:04:49,310 --> 00:04:52,360
...إنَّها... إنَّها

65
00:04:52,360 --> 00:04:55,840
هل تستطيعينَ التّفريق بيننا بهذه الضّفائر؟

66
00:04:56,300 --> 00:04:58,190
لا أستطيعُ التَّمييز

67
00:04:58,190 --> 00:05:00,410
ليسَ عليكِ الّلعب بكلِّ هذا الصّدق

68
00:05:00,410 --> 00:05:02,080
...ولكن

69
00:05:03,860 --> 00:05:05,070
أهلاً

70
00:05:05,400 --> 00:05:08,820
طبقنا المُميّز اليوم هو
"هبوط التّنين على القِطقِط"

71
00:05:08,820 --> 00:05:10,010
تفضّلي القائمة

72
00:05:10,010 --> 00:05:11,550
هل أحضر الحساب؟

73
00:05:11,550 --> 00:05:12,950
أتريدينَ بعض الشّاي؟

74
00:05:12,950 --> 00:05:14,390
إيصالان

75
00:05:14,390 --> 00:05:16,670
وأضيفي "جبل الثلج اليشبي" رجاءً

76
00:05:17,010 --> 00:05:20,540
على الفَور، أنا أقطّعُ بعض الثّلج الّذي تجمَّدَ هذا الصباح

77
00:05:21,090 --> 00:05:23,800
"تفضّلي طبق "جبل الثلج اليشبي

78
00:05:24,230 --> 00:05:26,690
إنَّهُ من الثَّلج المُكسَّر حديثاً

79
00:05:26,690 --> 00:05:29,430
إنه طازج

80
00:05:30,470 --> 00:05:34,450
لم أعمل بيُسرٍ هكذا من قبل

81
00:05:34,450 --> 00:05:35,730
هل نستطيعُ أن نوظّفكِ؟

82
00:05:35,730 --> 00:05:38,540
لم تنتهِ هذه الرَّقصة بعد

83
00:05:45,250 --> 00:05:47,700
شكراً لانتظارك

84
00:05:47,700 --> 00:05:51,180
ولكنَّني طلبتُ كابوتشينو

85
00:05:51,180 --> 00:05:53,080
المعذرة

86
00:05:53,630 --> 00:05:56,830
أعطيتها كاكاو بالحليب عن طريق الخطأ

87
00:05:57,210 --> 00:05:59,330
..الّتي تعمل بالمشروبات هي

88
00:06:00,520 --> 00:06:01,840
تشينو؟

89
00:06:02,280 --> 00:06:04,840
لماذا لا تُعدّينَ شيئاً عدا الكاكاو بالحليب

90
00:06:04,840 --> 00:06:07,220
متى أعددتُ هذا كُلّه؟

91
00:06:07,220 --> 00:06:09,280
...هل هي

92
00:06:09,280 --> 00:06:10,840
مصابة بمرض كوكوا؟

93
00:06:12,950 --> 00:06:14,670
هل أنتِ بخير؟

94
00:06:14,670 --> 00:06:18,520
هذا غريب... رُبّما تشينو تشان تشتاقُ لي

95
00:06:21,870 --> 00:06:23,730
حسناً، لنشرب هذه

96
00:06:25,690 --> 00:06:29,870
أنتَ لا تتحرّك أبداً أليسَ كذلك؟

97
00:06:29,870 --> 00:06:31,370
ألا تفهمين؟

98
00:06:32,570 --> 00:06:36,120
البقاء بشكلٍ ساكن هو صفة الملوك

99
00:06:36,120 --> 00:06:37,510
أنت

100
00:06:37,510 --> 00:06:41,910
دَعي المُهرّجينَ الكوميديين يخرجونَ بفوضى عارمة

101
00:06:41,910 --> 00:06:47,130
لأنَّ الصيّاد يشحذُ سكاكينهُ بصَمت تجهيزاً لما سيحدث

102
00:06:47,130 --> 00:06:49,050
لكن ما الّذي ستفعلهُ؟

103
00:06:49,050 --> 00:06:50,840
إنَّهُ قانون البَرّ

104
00:06:51,250 --> 00:06:55,850
إنَّنا موجودونَ على رأس السلسلة الغذائية، هذا كلُّ ما في الأمر

105
00:06:56,390 --> 00:06:59,210
هذه حتميّة الطَّبيعة

106
00:06:59,210 --> 00:07:00,600
كوكوا سان

107
00:07:01,100 --> 00:07:04,580
لا تقرئي كتابي بصوتٍ عالٍ أرجوكِ

108
00:07:05,760 --> 00:07:08,110
هذا مُحرج

109
00:07:13,460 --> 00:07:14,870
لقد شربناها كُلها

110
00:07:18,640 --> 00:07:22,270
علّميني شيئاً عن الأرجنتين أيضاً يا ريزي

111
00:07:22,270 --> 00:07:26,400
الأرجنتين؟ هل تحتاجين إلى مساعدة في واجب الدّراسات الإجتماعيّة؟

112
00:07:26,400 --> 00:07:28,860
"أعتقد أنَّها تعني "آل دينتي

113
00:07:28,860 --> 00:07:30,330
أجل هذا ماقصدتُه

114
00:07:30,330 --> 00:07:31,300
هل أنتِ مُترجمتها؟

115
00:07:31,890 --> 00:07:34,620
تستطيعُ ميغو سان و مايا سان التّواصل ذهنيا

116
00:07:34,620 --> 00:07:35,680
حقّاً؟

117
00:07:36,080 --> 00:07:39,420
..لو كانَ عقلي مُتّصلاً بعقلِ ريزي سان

118
00:07:39,420 --> 00:07:41,440
إسبريسّو وشطيرة أليس كذلك؟

119
00:07:42,110 --> 00:07:44,220
إن كُنتِ تريدين التّواصل بدونِ كلمات

120
00:07:44,220 --> 00:07:45,810
فسأعلّمكِ بعض الإشارات اليدوية

121
00:07:46,250 --> 00:07:47,820
إشارات يدوية؟

122
00:07:48,410 --> 00:07:49,820
هذا يعني إطلاقُ نار

123
00:07:50,520 --> 00:07:52,380
وهذا يعني أعطِني ذخيرة

124
00:07:52,380 --> 00:07:53,820
ولكنَّني لن أستخدم هذه الأشياء

125
00:07:54,260 --> 00:07:55,510
حقا؟

126
00:07:56,420 --> 00:07:58,080
حسناً يا ريزي

127
00:07:58,420 --> 00:07:59,950
ماذا؟

128
00:08:00,260 --> 00:08:03,080
هل تعلمينَ بمَ أفكّرُ الآن؟

129
00:08:04,940 --> 00:08:06,460
...حسناً

130
00:08:06,460 --> 00:08:08,300
أعيريني مسدسك؟

131
00:08:08,300 --> 00:08:09,530
خطأ

132
00:08:09,530 --> 00:08:10,870
أنا أعلم

133
00:08:10,870 --> 00:08:11,590
أجل يا ميغو؟

134
00:08:12,040 --> 00:08:15,720
لنذهب إلى الينابيع الحارّة بعد العمل لكي نسترخي

135
00:08:15,720 --> 00:08:16,820
صحيح

136
00:08:16,820 --> 00:08:17,600
رائع

137
00:08:17,920 --> 00:08:21,590
أردتُ الذّهاب منذُ أن أخبرتني تشينو عن ذهابكن إلى هناك

138
00:08:21,590 --> 00:08:24,980
كانَ يجب أن تحزري يا ريزي

139
00:08:24,980 --> 00:08:26,330
وكيف يُفترضُ بي أن أعرفَ هذا؟

140
00:08:26,330 --> 00:08:27,560
هذا صحيح

141
00:08:30,220 --> 00:08:34,220
أتيتِ إلى هنا لكي تدرسي ولكنَّنكِ تُساعدينَ في العمل أيضاً

142
00:08:34,220 --> 00:08:35,740
هذا يجعل المتعة مضاعفة

143
00:08:36,870 --> 00:08:39,510
أشعرُ بإحساسِ إنجازٍ غريب

144
00:08:39,510 --> 00:08:42,000
لا يوجد فتياتٌ بذات عُمري تعملن في متجرنا

145
00:08:42,630 --> 00:08:45,030
لذا فأنا أحسدُ رابت هاوس

146
00:08:46,030 --> 00:08:48,130
سآتي وأساعدكِ في أيِّ وقتٍ تريدين

147
00:08:48,440 --> 00:08:51,130
!كوكوا سان... أنا سعيدةٌ

148
00:08:51,500 --> 00:08:54,010
سأساعدكِ لتُبدّلي ثيابكِ بشكلٍ سريع

149
00:08:54,010 --> 00:08:58,010
أستطيعُ خلعَ الزيِّ لوحدي

150
00:08:58,510 --> 00:08:59,010
إذاً

151
00:08:59,530 --> 00:09:03,020
إن كُنتم ستتساعدانِ بالدِّراسة، فلماذا ناديتماني؟

152
00:09:03,520 --> 00:09:06,440
عندما نبدأ بفقدان تركيزنا

153
00:09:06,440 --> 00:09:08,400
نريدُكِ أن تضربينا بهذه

154
00:09:09,830 --> 00:09:12,400
أينَ هي المذكرة التي تحتوي على واجبنا؟

155
00:09:15,060 --> 00:09:17,420
ياللهول، هذه هي

156
00:09:18,300 --> 00:09:20,030
هل أستطيعُ الذّهاب للمنزل؟

157
00:09:20,030 --> 00:09:23,410
أريدُ المزيد من القهوة

158
00:09:23,410 --> 00:09:28,280
أر-يدو... المز-يدا... منا... القه-وة

159
00:09:28,280 --> 00:09:30,170
أنتِ تلفظينَ بالشّكل الخاطئ

160
00:09:30,550 --> 00:09:33,170
"هذه الكلمة " أريد" وهذه هي  "المزيد

161
00:09:33,780 --> 00:09:35,150
القهوة

162
00:09:35,150 --> 00:09:37,630
لمَ هذا هو الجزء الوحيد الّذي تلفظينه بالشّكل الصحيح؟

163
00:09:38,390 --> 00:09:39,430
الشّاي الأخضر

164
00:09:40,070 --> 00:09:40,930
القهوة

165
00:09:41,380 --> 00:09:42,430
الشّاي الأخضر

166
00:09:42,770 --> 00:09:45,270
أريد المزيد من القهوة

167
00:09:45,270 --> 00:09:48,060
أريد المزيد من الشّاي الأخضر

168
00:09:49,660 --> 00:09:51,190
هل أستطيع الذّهاب للمنزل؟

169
00:09:53,830 --> 00:09:56,790
هل أستطيع رؤية ملاحظاتك الإنجليزيّة يا تشيا تشان؟

170
00:09:56,790 --> 00:09:58,280
بالطّبع

171
00:09:58,280 --> 00:10:00,700
شردتُ قليلاً في الصفّ ذاكَ اليوم

172
00:10:01,340 --> 00:10:02,170
تفضّلي

173
00:10:02,170 --> 00:10:03,140
شكراً

174
00:10:03,140 --> 00:10:05,350
أنتِ جيّدة بكتابة المُلاحظات يا تشيا تشان

175
00:10:05,350 --> 00:10:07,710
إنَّهُ أسهل بكثير من النَّظر إلى السبورة

176
00:10:09,420 --> 00:10:10,080
ماذا؟

177
00:10:10,690 --> 00:10:15,340
القاعدة الوامضة
صخور الّهب و لولب الذّهب

178
00:10:15,680 --> 00:10:16,750
ياللهول

179
00:10:16,750 --> 00:10:19,090
هذا دفتر أفكاري للقائمة

180
00:10:19,090 --> 00:10:20,620
لا عجبَ بهذا

181
00:10:22,840 --> 00:10:24,970
هل أستطيعُ الذّهاب للمنزل الآن؟

182
00:10:27,220 --> 00:10:29,160
لا أستطيعُ الإنتظار للذّهاب لمسبح الينابيع الحارة

183
00:10:29,160 --> 00:10:30,980
أنا مُتحمّسة كثيراً

184
00:10:30,980 --> 00:10:33,600
لا تتحمَّسي وتبتعدي عنّا

185
00:10:34,450 --> 00:10:35,230
أينَ تشينو؟

186
00:10:37,300 --> 00:10:39,740
وجدتُ بعض الأرانب البرية

187
00:10:40,460 --> 00:10:42,870
هل أصبحتِ تُشبهينَ كوكوا الآن؟

188
00:10:45,990 --> 00:10:48,600
جدي قيمة إكس

189
00:10:48,600 --> 00:10:50,870
إنَّها الدّالّة التّربيعيّة

190
00:10:50,870 --> 00:10:52,400
لقد نجحت

191
00:10:52,890 --> 00:10:54,940
لقد حللتها بشكلٍ خاطئ

192
00:10:54,940 --> 00:10:56,760
ماذا؟ كلا، لم أفعل

193
00:10:57,140 --> 00:10:58,530
انظري هنا

194
00:10:58,530 --> 00:11:00,760
أنتِ جيّدة بالرّياضيّات أيضاً يا شارو تشان، أليس كذلك؟

195
00:11:01,140 --> 00:11:04,970
هل تقصدين أنَّني صقلتُ مهاراتي عبرَ عدِّ النّقود؟

196
00:11:05,290 --> 00:11:08,850
أستطيعُ أن أحلُّ معادلةَ رياضيّات بذهني مثل المصريين القدماء

197
00:11:09,250 --> 00:11:13,060
أعدت حساب الجزء الذي أخطأت به، ومع ذلك أخطأت بحله

198
00:11:13,060 --> 00:11:17,160
لنُقِم مُباراة ً إذاً ، من يستطيعُ أن يذكر أكثر عدد من الأرقام الأوليّة بسرعة

199
00:11:17,160 --> 00:11:18,440
لماذا الأرقام الأوليّة بالتّحديد؟

200
00:11:18,440 --> 00:11:24,570
2, 3, 5, 7, 11, 13, 17, 19, 23...

201
00:11:20,610 --> 00:11:22,680
حقّاً، لماذا الأرقام الأوليّة بالتّحديد؟

202
00:11:31,900 --> 00:11:33,560
خُذي هذا

203
00:11:35,910 --> 00:11:37,140
ياللهول

204
00:11:40,090 --> 00:11:42,340
لقد تجاوزت الحد الآن

205
00:11:45,940 --> 00:11:49,850
جدّي، لم أحظَ بأصدقاءٍ ينامونَ عندي من قبل

206
00:11:50,200 --> 00:11:52,680
لا أعلمُ إن كنتُ سأكونُ مِضيافةً جيّدة

207
00:11:54,390 --> 00:11:55,710
وخطرَ في ذهني شيء

208
00:11:55,710 --> 00:11:59,110
أنَّني دائماً أعتمدُ على كوكوا سان بهذه الأمور

209
00:11:59,900 --> 00:12:03,130
كوني على طبيعتكِ أمامهما فقط

210
00:12:03,130 --> 00:12:03,860
ماذا؟

211
00:12:04,240 --> 00:12:06,240
...جدي، إن صوتك

212
00:12:06,600 --> 00:12:08,070
آوياما سان؟

213
00:12:08,070 --> 00:12:11,500
أنا متأكّدة أنَّ هذا ما كان سيقولهُ السيد

214
00:12:12,190 --> 00:12:15,320
هل تأتين إلى هنا كثيراً؟

215
00:12:15,320 --> 00:12:19,900
لن تعلمينَ أين ستجدينَ فِكرةً جديدة لرواية

216
00:12:22,880 --> 00:12:24,320
إلى الّلقاء  الآن

217
00:12:24,320 --> 00:12:25,260
تشينو

218
00:12:25,260 --> 00:12:28,520
انظري، انظري... اشترت ريزي هذان لنا

219
00:12:29,000 --> 00:12:31,960
لننقسم إلى فريقين و نتحارب بمُسدَّسات الماء

220
00:12:31,960 --> 00:12:33,140
حسناً

221
00:12:35,650 --> 00:12:38,130
!حسنا... لنبدأ

222
00:12:38,130 --> 00:12:40,400
ريزي سان تبرقُ كثيراً

223
00:12:40,400 --> 00:12:41,650
مهلاً

224
00:12:41,960 --> 00:12:44,240
كيفَ نضع الماء بهما؟

225
00:12:44,240 --> 00:12:46,030
إنَّنا لا نعرفُ كيفَ نستخدمهما

226
00:12:46,350 --> 00:12:48,590
كانَ يجب أن تقولا هذا من البداية

227
00:12:48,590 --> 00:12:50,100
المعذرة

228
00:12:53,940 --> 00:12:55,120
من هنا؟

229
00:13:00,220 --> 00:13:02,590
ما الّذي تفعلينهُ هناك؟

230
00:13:03,100 --> 00:13:07,720
أظنُّ أنَّ مايا سان و ميغو سان يتواصلان ذهنيا

231
00:13:07,720 --> 00:13:10,720
لذا تركتُ الأمر على ريزي سان واختبأت

232
00:13:10,720 --> 00:13:11,850
صحيح

233
00:13:12,480 --> 00:13:15,100
لا يحبُّ تيبي أن يتبلَّل أمام الآخرين

234
00:13:15,100 --> 00:13:16,850
لذا هلّا تنتبهينَ عليه

235
00:13:17,620 --> 00:13:19,410
...هذه مشكلة

236
00:13:19,410 --> 00:13:22,730
..كما ترين، إنَّ مايا سان

237
00:13:22,730 --> 00:13:24,740
أعطتني سِلاحها

238
00:13:25,050 --> 00:13:26,090
ماذا؟

239
00:13:26,090 --> 00:13:28,870
طلبت منّي أن أجد مكان اختباء ريزي سان

240
00:13:28,870 --> 00:13:31,330
هل تأخذينَني كرهينة؟

241
00:13:34,620 --> 00:13:35,710
تيبي

242
00:13:35,710 --> 00:13:37,460
وجدتُ ميغو أيضاً

243
00:13:38,630 --> 00:13:40,740
لقد وجَدتِني

244
00:13:41,220 --> 00:13:43,110
أينَ هي مايا سان؟

245
00:13:43,110 --> 00:13:45,130
لن تقولَ لنا عن مكانها بهذه البساطة

246
00:13:45,630 --> 00:13:47,130
إنَّها هناك

247
00:13:47,740 --> 00:13:49,510
إنَّها صادقةٌ جدّاً

248
00:13:49,510 --> 00:13:51,930
ميغو أيّتها الحمقاء

249
00:13:49,510 --> 00:13:54,890
بلل .. برد .. بلَل .. بَرد

250
00:13:51,930 --> 00:13:54,890
من المُسلّي أن ألعب دور الشّخص السيّء

251
00:13:54,890 --> 00:13:59,270
9,649... 9,661...

252
00:13:59,270 --> 00:14:05,650
9,677... 9,679... 9,689...

253
00:14:03,930 --> 00:14:05,650
إلى متى سوف تعُدّين؟

254
00:14:06,150 --> 00:14:08,010
ألا يجب أن تدرُسي؟

255
00:14:06,150 --> 00:14:10,990
9,697... 9,719...

256
00:14:11,580 --> 00:14:13,000
أنا أرى ألبوماً

257
00:14:13,000 --> 00:14:14,830
كم زاويةً تستطيعينَ أن تلتقطي؟

258
00:14:15,360 --> 00:14:17,450
...أظنُّ أنَّها

259
00:14:17,450 --> 00:14:20,580
قبلَ أن نبدأ المرحلة الثّانويّة، صحيح؟

260
00:14:20,900 --> 00:14:23,350
لا تبدو تشيا تشان سعيدة

261
00:14:23,350 --> 00:14:25,340
أعتقد أنَّها كانت تتساءل ما إن كُنّا سنبقى أصدقاء

262
00:14:25,340 --> 00:14:28,220
لأنَّ مدرستينا كانتا بعيدتين عن بعضهما

263
00:14:28,220 --> 00:14:31,140
كم أنتِ شخصٌ قلِق

264
00:14:31,730 --> 00:14:34,140
كانَ هذا غيرُ مُتوقَّع

265
00:14:39,580 --> 00:14:41,150
أيّتها المعلّمة

266
00:14:41,440 --> 00:14:44,560
بما أنَّنا خرجنا من الحمّام، لنتناول القهوة بالحليب

267
00:14:44,560 --> 00:14:45,820
معلّمة؟

268
00:14:45,820 --> 00:14:48,440
لقد نادَيتِ ريزي بالمعلّمة

269
00:14:48,440 --> 00:14:50,970
شعرتُ وكأنَّني في المدرسة لسببٍ ما

270
00:14:50,970 --> 00:14:53,160
رُبّما لأنَّها تُذكّرني بمعلّمة الرّياضة

271
00:14:53,840 --> 00:14:57,080
قالت معلّمة وليسَ مدرّبة

272
00:14:57,800 --> 00:14:59,730
لماذا تختبئين؟

273
00:14:59,730 --> 00:15:02,670
المعذرة، ولكن عندما سمعتُ كلمة معلّمة

274
00:15:03,100 --> 00:15:07,080
اعتقدتُ أنَّ مُحرِّرَتي أتت لتأخذ المخطوطة مِنّي

275
00:15:13,280 --> 00:15:15,220
استمتعنا كثيراً في المسبح

276
00:15:15,220 --> 00:15:15,930
أجل

277
00:15:16,340 --> 00:15:17,660
أودُّ العودة إلى هنا مرّةً أخرى

278
00:15:17,340 --> 00:15:20,190
هل أرسل لها ماذا فعلنا اليوم؟

279
00:15:17,660 --> 00:15:20,190
أجل وأنا أيضاً

280
00:15:20,570 --> 00:15:23,190
هل تريدين أن تُكلّمي كوكوا سان؟

281
00:15:23,190 --> 00:15:26,290
أنا لم أقُل هذا

282
00:15:26,290 --> 00:15:28,720
يظهرُ هذا على وجهكِ كثيراً

283
00:15:29,360 --> 00:15:31,700
هل هذا هو التخاطر؟

284
00:15:35,350 --> 00:15:37,700
لنتسابق إلى رابت هاوس

285
00:15:38,140 --> 00:15:41,820
إن ربحتُ الآن فستكونون فيلق التشيمامي بدءاً من الغد

286
00:15:43,020 --> 00:15:45,210
كلا

287
00:15:51,660 --> 00:15:53,090
هل تعلمين شيئاً؟

288
00:15:53,820 --> 00:15:57,420
كانَ أمراً جديداً أن أسمع قِصصاً عن ماضي تشيا تشان

289
00:15:59,930 --> 00:16:03,880
قد يكونُ هذا نافعاً لعكس المواقف الّتي شعرتُ بالحرجِ فيها

290
00:16:03,880 --> 00:16:05,720
..منذُ زمنٍ طويل قامت شارو تشان بـ

291
00:16:05,720 --> 00:16:08,610
لا تقولي هذا أمام ريزي سينباي

292
00:16:08,920 --> 00:16:10,190
حسناً

293
00:16:10,190 --> 00:16:14,400
إنَّها سعيدةٌ لأنَّها وجدت صديقات تستطيع الاندماج معهن

294
00:16:14,400 --> 00:16:16,490
لذا ابقين أصدقاءً لها، اتفقنا؟

295
00:16:16,800 --> 00:16:19,930
ماذا؟ لم أسمعكِ بسببِ صوت الماء

296
00:16:22,700 --> 00:16:25,000
سأشعرُ بالإحراج على كل حال

297
00:16:28,390 --> 00:16:31,010
انظري، لقد نامت شارو  تشان

298
00:16:32,900 --> 00:16:35,420
إنَّها مُتعبة لأنَّها تعمل طوال الوقت

299
00:16:35,420 --> 00:16:39,010
إنَّها تتصرّف وكأنَّها قويّة، ولكن هناك
الكثير من الأشياء الّتي تُقلِقُها بشأن المدرسة الجَديدة

300
00:16:39,420 --> 00:16:41,900
لذا ابقين أصدقاءً لها، اتفقنا؟

301
00:16:41,900 --> 00:16:45,180
هل كُنتِ قلِقة بشأن بَدء المرحلة الثّانويّة

302
00:16:45,180 --> 00:16:47,270
لأنَكِ كُنتِ قلقة على شارو تشان؟

303
00:16:49,410 --> 00:16:52,150
هذا لطيف، أحسدُ الناس اللذين يملكون أصدقاء طفولة

304
00:16:52,800 --> 00:16:56,010
...حبّذا لو كان لي نفس أحلامكما

305
00:16:56,010 --> 00:16:59,940
بإمكاننا أن نصنع ذكرياتٍ جديدة من الآن فصاعِداً

306
00:16:59,940 --> 00:17:00,660
أنتِ مُحِقّة

307
00:17:01,180 --> 00:17:03,020
إذاً سوفَ أقصُّ قُصّتي

308
00:17:03,020 --> 00:17:04,270
هل هذا ما تريدينه؟

309
00:17:07,620 --> 00:17:09,580
كانَ يوماً مُسلّياً حقّاً

310
00:17:09,580 --> 00:17:11,170
مازالَ الّليلُ في أوّله

311
00:17:11,170 --> 00:17:12,900
ماذا سوف نلعب؟

312
00:17:12,900 --> 00:17:14,700
لنلعب الكلمات المُتقاطعة

313
00:17:14,700 --> 00:17:16,180
ماذا عن إختبارات الشخصيّة؟

314
00:17:16,180 --> 00:17:18,410
كوني أكثر جُرأة

315
00:17:18,410 --> 00:17:22,070
ولكن الّلعبة الوحيدة الّتي أملكها في غرفتي هي الشَّطرنج

316
00:17:24,800 --> 00:17:25,970
أبي

317
00:17:25,970 --> 00:17:27,150
سوفَ تنَشِّط هذه الأجواء

318
00:17:28,600 --> 00:17:31,690
رائع، لقد انتقمتُ من دون رابيتشيو

319
00:17:32,140 --> 00:17:34,940
لقد وقعت في فخ محصل الضرائب

320
00:17:35,260 --> 00:17:37,820
سوف أعودُ إلى البداية

321
00:17:39,020 --> 00:17:41,010
هذا مُسلٍّ أليسَ كذلك يا تشينو؟

322
00:17:41,010 --> 00:17:41,930
أجل

323
00:17:50,780 --> 00:17:52,960
إنَّها من تشينو تشان

324
00:17:53,560 --> 00:17:56,470
لا تُسبب كوكوا سان المشاكل أليس كذلك؟

325
00:17:56,880 --> 00:18:01,110
أتساءل إن كانت تشينو تشان تشعر بالوحدة بدوني

326
00:18:01,110 --> 00:18:03,220
بما أنك أردتِ رؤية
شكل تيبي وهو مبلول

327
00:18:03,220 --> 00:18:05,480
فقد التقطتُ صورةً له اليوم

328
00:18:06,040 --> 00:18:09,100
إنَّها تقضي وقتاً مُمتعاً

329
00:18:09,560 --> 00:18:11,740
يبدو تيبي حزينًا وظريفاً

330
00:18:11,740 --> 00:18:13,570
سأجعلُ منها خلفية لهاتفي

331
00:18:13,570 --> 00:18:16,330
أتمنّى لو ذهبتُ معهن أيضاً

332
00:18:27,180 --> 00:18:28,830
مرحباً

333
00:18:28,830 --> 00:18:30,000
أهلاً تشينو تشان

334
00:18:30,520 --> 00:18:32,980
لقد شاهدتُ الصّورة، هل استمتعتِ بوقتك؟

335
00:18:32,980 --> 00:18:34,380
أجل

336
00:18:34,930 --> 00:18:36,460
كانَ ذلك مُمتعاً

337
00:18:40,680 --> 00:18:43,640
أتمنّى لو كنتُ برفقتك

338
00:18:43,640 --> 00:18:45,640
هل تبكينَ بسبب هذا؟

339
00:18:46,080 --> 00:18:49,390
لكن لو لم أكُن مُعتادة على العَيش برفقتك

340
00:18:49,930 --> 00:18:51,740
لتوترت كثيرًا

341
00:18:52,490 --> 00:18:55,900
ولما كنتُ دعَوتُهُما إلى هنا حتّى

342
00:18:55,900 --> 00:18:57,470
حقّاً؟

343
00:18:57,470 --> 00:19:00,180
تبكينَ وتضحكين، أنتِ غريبة بالفعل

344
00:19:00,180 --> 00:19:02,040
سوف أعودُ في الغد، اتفقنا؟

345
00:19:02,970 --> 00:19:04,620
تُصبحينَ على خير

346
00:19:05,650 --> 00:19:10,290
لنُرسل لهن صورةً لنا أيضاً

347
00:19:13,450 --> 00:19:17,550
إنَّنا نقيمُ حفلة قصاصٍ هنا

348
00:19:18,630 --> 00:19:20,790
لماذا أرسلت هذا لي؟

349
00:19:21,720 --> 00:19:23,890
هل هذه موضةٌ للشّعر الآن؟

350
00:19:25,660 --> 00:19:26,560
شارو تشان

351
00:19:26,940 --> 00:19:29,180
هل ترغبين برواءِ قصص مُخيفة الآن؟

352
00:19:29,180 --> 00:19:31,190
!سوف أنام

353
00:19:31,190 --> 00:19:34,310
لا أستطيعُ أن أنام دونَ أن أعانق شيئًا

354
00:19:34,310 --> 00:19:37,510
كلا، لا تُحضري هذا الشّيء إلى هنا

355
00:19:37,510 --> 00:19:39,690
لمَ لا تعانقين شارو تشان بدلاً عنه؟

356
00:19:39,690 --> 00:19:43,230
أجل، عانقيني بدلا عنه

357
00:19:43,870 --> 00:19:47,880
أنت جريئة لثقتك في عناقك

358
00:19:47,880 --> 00:19:49,030
لست كذلك

359
00:19:49,030 --> 00:19:51,460
أنتِ مثل الأرنب الّذي يلحق به الصيّاد

360
00:19:51,460 --> 00:19:52,370
مهلاً

361
00:19:52,370 --> 00:19:54,000
كلا

362
00:20:16,050 --> 00:20:17,020
ماذا؟

363
00:20:17,020 --> 00:20:20,750
من غيرِ عادتكِ أن تنامي في الصفّ

364
00:20:20,750 --> 00:20:22,030
هيّا لنُسرع

365
00:20:22,370 --> 00:20:24,570
سينفذُ الخبز من متجر المدرسة

366
00:20:24,570 --> 00:20:27,170
انتظرا

367
00:20:30,040 --> 00:20:32,640
أملكُ 52 يَن فقط

368
00:20:33,380 --> 00:20:35,440
يالهُ من حلم

369
00:20:37,540 --> 00:20:42,080
هل تريدينَ خُبز الشمام خاصتي يا شارو تشان؟

370
00:20:42,080 --> 00:20:46,840
إن أكلتِ كثيراً سوفَ تنامينَ في الصفّ بعد الزوال

371
00:20:50,950 --> 00:20:54,560
هل سأُنهي الحلُم إن عُدتُ إلى النَّوم؟

372
00:21:04,220 --> 00:21:06,610
هل يبدو هذا غريباً

373
00:21:15,820 --> 00:21:18,590
أتساءل إن كنّ يعملن

374
00:21:19,440 --> 00:21:21,500
مرحباً تشينو وميغو

375
00:21:21,830 --> 00:21:25,260
هناكَ شيءٌ لطالما أردت فعله في المقاهي

376
00:21:25,570 --> 00:21:26,830
ما هو؟

377
00:21:26,830 --> 00:21:28,060
ماذا؟

378
00:21:28,060 --> 00:21:29,260
حسناً

379
00:21:30,870 --> 00:21:33,050
سوف أدخلُ كزبونةٍ اليوم

380
00:21:36,410 --> 00:21:39,200
أهلاً بكِ يا أختي

381
00:21:39,200 --> 00:21:40,520
إنَّهُ مقهى أختٍ صغرى

382
00:21:41,020 --> 00:21:42,780
ما الّذي تفعلنه؟

383
00:21:43,300 --> 00:21:45,860
قفن في خط مستقيم يا فيلق تشيمامي

384
00:21:45,860 --> 00:21:47,530
لم ينجح الأمر مع المدربة

385
00:21:47,880 --> 00:21:50,530
أعتقد أنَّه ينجح فقط مع كوكوا سان

386
00:23:27,360 --> 00:23:37,270
في الحلقة القادمة: ترتدي الفتاة معطفًا أحمر وتقود فريقًا من الأرانب عبر سماء ليلة عيد الميلاد

387
00:23:28,410 --> 00:23:29,630
ماذا سنفعل هذه السَّنة

388
00:23:29,630 --> 00:23:30,440
بخصوص ماذا؟

389
00:23:30,440 --> 00:23:32,120
بخصوصِ عيد الميلاد بالطّبع

390
00:23:32,120 --> 00:23:34,120
أرغبُ بليلةِ عيدِ ميلادٍ هادئة أخرى

391
00:23:34,120 --> 00:23:36,350
سوفَ نقيمُ حفلةَ عيدِ ميلادٍ ضخمة

392
00:23:36,350 --> 00:23:37,270
ماذا؟