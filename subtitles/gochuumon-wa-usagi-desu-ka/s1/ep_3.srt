1
00:00:04,730 --> 00:00:06,030
هذا لذيذ

2
00:00:06,030 --> 00:00:09,410
أنا أحبُّ القهوة أيضاً

3
00:00:09,410 --> 00:00:13,190
أصبحتُ مُعتادة على القهوة الّتي تصنعينها

4
00:00:13,190 --> 00:00:14,240
أتساءلُ ما السّبب

5
00:00:16,600 --> 00:00:19,990
ولكنَّكِ لا تعرفينَ الفرق بين النكهات بعد

6
00:00:19,990 --> 00:00:22,300
أنتِ مُدمنةٌ على الكافيين فقط

7
00:00:22,690 --> 00:00:24,500
أصبحتُ مُدمِنةً بنظرها

8
00:00:24,800 --> 00:00:27,230
سيحينُ وقت فتح المقهى

9
00:00:27,230 --> 00:00:28,280
حسناً

10
00:00:33,110 --> 00:00:36,050
أكوابُ رابت هاوس بسيطةٌ جدّاً

11
00:00:36,400 --> 00:00:38,050
هذا أفضل

12
00:00:38,380 --> 00:00:41,520
إن نوّعتِ بعض الشّيء فأنا متأكدة أنَّ الزّبائن سوف يستمتعون

13
00:00:41,960 --> 00:00:43,230
أتعتقدينَ هذا؟

14
00:00:43,640 --> 00:00:46,370
رأيتُ بعض الأكواب الجميلة منذُ فترة

15
00:00:46,370 --> 00:00:48,020
لمَا لا نذهبُ جميعاً ونشتري القليل؟

16
00:00:48,020 --> 00:00:49,650
ما هو شكلها؟

17
00:00:49,650 --> 00:00:50,860
...حسناً

18
00:00:51,140 --> 00:00:54,360
كانت هناكَ شمعةٌ يتراقصُ لهيبها في الأعلى، ورائحتها جميلة

19
00:00:54,360 --> 00:00:57,100
هل أنتِ متأكّدة أنَّها ليست شمعة لتعطير الجوّ؟

20
00:02:31,210 --> 00:02:33,780
الكثير من الأكواب الجَميلة

21
00:02:35,580 --> 00:02:37,320
لا تلعبي هنا

22
00:02:43,620 --> 00:02:45,730
تماماً كما توقّعت

23
00:02:48,280 --> 00:02:50,300
المعذرة

24
00:02:51,680 --> 00:02:53,060
كم هذا ظريف

25
00:02:53,060 --> 00:02:55,900
إن جلسَ تيبي بأحد الأكواب، سوف نحظى على الإنتباه

26
00:02:56,300 --> 00:02:58,960
ولكن لا يوجد كوبٌ بهذا الحجم

27
00:02:58,960 --> 00:03:00,130
بل يوجد

28
00:03:01,510 --> 00:03:02,910
! هناكَ واحدٌ كبير بالفعل

29
00:03:14,170 --> 00:03:15,600
هذا ليسَ مُشابهاً

30
00:03:15,600 --> 00:03:17,620
إنّهُ يبدو كالأرز

31
00:03:21,060 --> 00:03:22,840
أعتقد أنَّ هذا جيّد

32
00:03:27,310 --> 00:03:30,290
رأيتُ مواقفَ كهذه في مجلّة مانغا

33
00:03:30,290 --> 00:03:32,270
هذه المواقف تتطوّر لتُصبح رومانسيّة، أليسَ كذلك ؟

34
00:03:33,550 --> 00:03:35,770
إنَّها تتصرّفُ بشكلٍ غريب

35
00:03:36,150 --> 00:03:37,780
شارو تشان؟

36
00:03:38,610 --> 00:03:41,530
ريزي سينباي! ما الّذي تفعلينهُ هنا

37
00:03:41,810 --> 00:03:43,460
هل تعرفينها؟

38
00:03:43,460 --> 00:03:45,370
إنَّها طالبةٌ في مدرستنا

39
00:03:45,750 --> 00:03:47,330
إنها في نفس عمر كوكا وتشيا

40
00:03:47,330 --> 00:03:49,900
هل أنتِ أكبر منّي يا ريزي تشان؟

41
00:03:49,900 --> 00:03:51,350
هل أدركتِ هذا الآن؟

42
00:03:51,610 --> 00:03:53,940
ماذا تفعلين هنا يا سينباي؟

43
00:03:53,940 --> 00:03:57,130
جِئنا لنشتري الأكواب للمقهى الّذي أعملُ به

44
00:03:57,350 --> 00:03:59,240
هل تشترينَ شيئاً من هنا؟

45
00:03:59,240 --> 00:04:02,380
كلا، النَّظرُ إلى هذه الأشياء يكفيني

46
00:04:02,380 --> 00:04:03,700
النّظر فقط؟

47
00:04:03,700 --> 00:04:04,590
أجل

48
00:04:05,250 --> 00:04:06,600
هذا الّلون الأبيض

49
00:04:06,600 --> 00:04:09,150
الشّكل الأنيق

50
00:04:10,430 --> 00:04:12,510
أنتِ تمتلكينَ ذوقاً غريباً

51
00:04:13,130 --> 00:04:14,520
انظروا من يتحدث عن الغرابة

52
00:04:16,460 --> 00:04:20,110
أنتما لستما بذاتِ العمر
كيفَ التقيتُما إذاً؟

53
00:04:20,110 --> 00:04:24,990
لقد أنقذتني عندما حاولَ لِصٌّ الهجومَ عليّ

54
00:04:24,990 --> 00:04:27,280
كم هذا رائع

55
00:04:39,340 --> 00:04:40,420
انخفضي

56
00:04:42,560 --> 00:04:45,800
سأتولى أمره

57
00:04:45,800 --> 00:04:46,970
هذا ليسَ صحيحاً

58
00:04:47,760 --> 00:04:50,450
...لم أقُل هذا، كانَ الأمر فقط

59
00:04:50,450 --> 00:04:51,560
لا تقولي لهما

60
00:04:52,880 --> 00:04:54,560
أرنبٌ متوحّشٌ مُجرم؟

61
00:04:54,920 --> 00:04:58,060
سوف يعضّني، أنا خائفة
لا أستطيعُ المرور من هنا

62
00:05:00,800 --> 00:05:03,490
أنتِ تقفينَ في طريقي مُجدّداً

63
00:05:11,420 --> 00:05:12,660
هذا ماحدث

64
00:05:15,750 --> 00:05:18,630
ليسَ من الغريبِ أن أخافَ من الأرانب

65
00:05:20,160 --> 00:05:22,300
ما رأيكُن بهذا الكوب؟

66
00:05:23,180 --> 00:05:25,400
إنَّها تحاول تغيير الموضوع وكأنَّهُ لم يحدث

67
00:05:25,400 --> 00:05:26,550
كلا، ليس كذلك

68
00:05:26,820 --> 00:05:27,800
انظري إلى هذا

69
00:05:27,800 --> 00:05:30,910
هذا الشَّكل يسمحُ للرّائحة بالانتشار أكثر

70
00:05:32,090 --> 00:05:34,320
هناكَ الكثير من أنواع الأكواب

71
00:05:35,210 --> 00:05:38,800
هذا الكوبُ قوامهُ مُختلفٌ عندَ المِقبض

72
00:05:39,720 --> 00:05:42,690
إنَّهُ جميل، فهمتُ الأمر الآن

73
00:05:42,690 --> 00:05:44,320
أنتِ تعلمينَ الكثير عن الأكواب

74
00:05:44,880 --> 00:05:49,280
أنا أنتبهُ كثيراً للأكواب الّتي أشربُ منها الشّاي

75
00:05:49,600 --> 00:05:53,630
أنا أستخدم أكواباً جيّدة وقويّة للقهوة

76
00:05:53,630 --> 00:05:57,660
كوب الشّاي خاصَّتي هو المُفضّل لديّ ولكنَّهُ في منزلي

77
00:05:57,660 --> 00:05:59,290
ما الّذي يتنافسنَ عليه؟

78
00:05:59,660 --> 00:06:04,040
ولكنَّنا نُقدّم القهوة، لذا فإنَّنا نحتاجُ إلى أكواب

79
00:06:04,040 --> 00:06:05,760
أتردنَ هذا حقّاً؟

80
00:06:06,120 --> 00:06:09,370
لقد أردتُ أن أرى مكانَ عملكِ

81
00:06:09,370 --> 00:06:11,960
ألا تُحبّينَ القهوة؟

82
00:06:13,130 --> 00:06:15,780
تكونُ لذيذةً جدّاً عندَ وضع الكثير من السُكَّر والحليب بها

83
00:06:16,470 --> 00:06:18,640
لا أقصد أنَّني لا أحبُّ مرارتها

84
00:06:18,900 --> 00:06:19,900
لمَ إذاً؟

85
00:06:21,830 --> 00:06:23,400
عندما أتناول الكثير من الكافيين

86
00:06:23,720 --> 00:06:26,030
أُصابُ بالحماس الشَّديد

87
00:06:26,030 --> 00:06:27,480
! أتتأثّرينَ بالقهوة

88
00:06:27,480 --> 00:06:29,410
لم أكُن ألاحظ هذا الشّيء على نفسي

89
00:06:29,860 --> 00:06:32,160
تعالي كزيارةٍ فقط، لا داعي لأن تشربي القهوة

90
00:06:33,240 --> 00:06:34,160
حسناً

91
00:06:34,460 --> 00:06:37,240
يبدو هذا الكوب فاخراً

92
00:06:38,620 --> 00:06:40,140
لكنه باهظٌ جدّاً

93
00:06:40,140 --> 00:06:41,260
خمسون ألف ينّ

94
00:06:41,640 --> 00:06:44,020
تُكلّفُ الأكواب الأثريّة ذات السِّعر تقريباً

95
00:06:44,020 --> 00:06:45,550
...إنَّه

96
00:06:46,670 --> 00:06:49,030
...كنتُ سأرميهِ ولكن

97
00:06:49,030 --> 00:06:50,780
هل تودّينَ أن تأخذيه آنستي؟

98
00:06:54,570 --> 00:06:57,180
إنَّهُ كالكوب الّذي استخدمتهُ كهدَفٍ عندما كنتُ صغيرة

99
00:07:01,790 --> 00:07:04,850
لنشتري أكواباً مُتطابقة يا تشينو تشان

100
00:07:04,850 --> 00:07:06,980
لم نأتِ إلى هنا لنشتري أكواباً تخصّنا

101
00:07:07,270 --> 00:07:11,220
هذا لن يضُرّ
أيُّ رسمةٍ تريدين؟

102
00:07:07,710 --> 00:07:10,240
إنَّها تراقبهما وتنظر إليهما بحسد

103
00:07:12,910 --> 00:07:15,220
تأتي هذه الأكواب بلونين مُختلفين

104
00:07:15,220 --> 00:07:16,990
أليسَ هذا جميلاً؟

105
00:07:17,180 --> 00:07:19,380
إنَّهُ جميلٌ جدّاً

106
00:07:20,890 --> 00:07:23,500
ياللهول، هذه الأكواب للأزواج

107
00:07:23,500 --> 00:07:25,190
حسناً، سوف أشتريهما

108
00:07:25,190 --> 00:07:26,630
وسأعطيكِ واحداً

109
00:07:27,980 --> 00:07:29,880
شكراً جزيلاً لكِ

110
00:07:30,100 --> 00:07:32,690
أنتِ تعرفينَ الكثير عن الأكواب باهظة الثَّمن

111
00:07:32,690 --> 00:07:34,380
أنتِ كالفتيات الغنيّات

112
00:07:34,380 --> 00:07:35,460
غنيّات؟

113
00:07:35,860 --> 00:07:39,890
سمعت أن في المدرسة التي تستعمل
ذلك الزي الكثير من العباقرة والفتيات الغنيّات

114
00:07:39,890 --> 00:07:42,660
وأنتِ جميلةٌ أيضاً
أنتِ مثاليّةٌ في كُلِّ شيء

115
00:07:42,660 --> 00:07:44,770
يجب أن توجّهي كلامكِ إلى ريزي سينباي

116
00:07:45,080 --> 00:07:48,440
أراهنُ أنَّ هذا الكوب مثل حُلية بالنّسبةِ إليكِ

117
00:07:48,440 --> 00:07:50,940
هل تقولينَ هذا لي؟

118
00:07:53,200 --> 00:07:55,700
سوف أجعلُ منهُ إرثاً عائليّاً للأبد

119
00:07:55,700 --> 00:07:57,430
إنَّها وقفةُ الفتاة الغنيّة

120
00:07:57,430 --> 00:08:00,660
طريقةُ حملكِ للكوب أنيقةٌ جدّاً

121
00:08:00,660 --> 00:08:02,800
أنا أُمسكُ به بشكلٍ طبيعيّ

122
00:08:02,800 --> 00:08:05,380
وشعرُها المُتطاير يعطيها مظهراً جليلاً

123
00:08:05,380 --> 00:08:06,920
إنَّهُ منفوشٌ بعض الشّيء فقط

124
00:08:06,920 --> 00:08:09,560
هل تأكلينَ أشياءً مثل الكافيار أيضاً؟

125
00:08:09,560 --> 00:08:12,800
يُفترضُ أن تسألي ريزي سينباي عن أشياءَ كهذه

126
00:08:13,570 --> 00:08:16,760
أنا أتناول الأطعمة السّريعة

127
00:08:16,760 --> 00:08:18,800
وعيِّنات الحصص من السّوق

128
00:08:20,380 --> 00:08:21,390
الحصص؟

129
00:08:21,390 --> 00:08:24,140
الأطعمة التي يمكنُكِ أن تأكليها فوراً لذيذة أيضاً، أليسَتْ كذلك ؟

130
00:08:24,440 --> 00:08:25,660
أعلمُ تماماً ماذا تقصدين

131
00:08:25,660 --> 00:08:28,370
طعمُ الأرزِّ والبيض النيّئ رائع أليسَ كذلك؟

132
00:08:28,370 --> 00:08:30,690
من المؤكَّد أنَّها تقصدُ الكافيار عندما قالت البيض النيّئ

133
00:08:43,110 --> 00:08:44,250
شارو تشان

134
00:08:44,670 --> 00:08:45,620
أهلاً بعودتك

135
00:08:51,050 --> 00:08:54,590
أخذت ريزي سينباي صورةً خاطِئةً عنّي

136
00:08:54,910 --> 00:08:57,580
وهناكَ فتاةٌ لديها مخلوقٌ عجيبٌ على رأسها

137
00:08:57,580 --> 00:08:59,470
لقد التقيتِ كوكوا تشان وصديقتيها إذاً

138
00:08:59,970 --> 00:09:01,780
لا تقولي لهن

139
00:09:02,320 --> 00:09:03,290
أقولُ لهن ماذا؟

140
00:09:03,850 --> 00:09:08,770
أنَّني أعيشُ في هذا المنزل

141
00:09:10,500 --> 00:09:13,240
ولكنَّني أراهُ بيتاً جميلاً ومتواضعاً

142
00:09:42,780 --> 00:09:44,150
أنا ذاهِبة

143
00:09:44,790 --> 00:09:46,390
ما هذا؟

144
00:09:46,390 --> 00:09:48,800
إنَّها مُلصقاتٌ للمكان الّذي سأعملُ به

145
00:09:48,800 --> 00:09:50,810
دَعيني أحصلُ على واحدة من فضلك

146
00:09:52,300 --> 00:09:53,650
...إنَّ هذا

147
00:09:57,830 --> 00:10:00,030
...إنَّ هذا

148
00:10:03,480 --> 00:10:05,830
شارو تشان في ورطة

149
00:10:04,620 --> 00:10:05,830
ما الّذي يحصل؟

150
00:10:06,140 --> 00:10:09,290
كانت شارو تشان تحملُ هذا المُلصقات

151
00:10:09,520 --> 00:10:12,520
لا بُدَّ أنَّها تعملُ بمكانٍ سيّئ

152
00:10:12,520 --> 00:10:13,650
ماذا؟

153
00:10:13,650 --> 00:10:15,550
أنا خائفةٌ من سؤالها

154
00:10:15,920 --> 00:10:19,590
فلور دو لابان؟ أليسَ مُجرّد مقهى؟

155
00:10:21,840 --> 00:10:24,600
كيفَ نوقف شارو تشان؟

156
00:10:25,200 --> 00:10:27,810
لمَا لا نذهب جميعاً إلى هناك بعد العمل؟

157
00:10:28,040 --> 00:10:29,310
أنتجسَّس؟

158
00:10:29,680 --> 00:10:30,810
نتجسَّس؟

159
00:10:31,110 --> 00:10:34,190
هل الجميعُ مُستعدُّ لنصبحَ أشباحاً؟

160
00:10:34,360 --> 00:10:35,790
أنا جاهزةٌ لهذا

161
00:10:35,790 --> 00:10:37,440
لا تستهين بقوّة التجسُّس

162
00:10:37,440 --> 00:10:38,410
عُلم

163
00:10:38,410 --> 00:10:40,270
حسناً، اتبعاني الآن

164
00:10:40,270 --> 00:10:41,410
حاضر سيّدتي

165
00:10:41,410 --> 00:10:43,040
لا أستطيعُ سماعكُما

166
00:10:42,060 --> 00:10:44,060
أينَ سنتجسس؟

167
00:10:43,040 --> 00:10:44,410
حاضر سيّدتي

168
00:10:50,320 --> 00:10:53,610
أنتِ وشارو تشان أصدقاء منذُ الطّفولة إذاً

169
00:10:53,610 --> 00:10:54,550
هذا صحيح

170
00:10:54,920 --> 00:10:57,050
لهذا لم أستطع تجاهل هذا

171
00:10:57,570 --> 00:11:00,310
سوف نتجسَّس بهدوء

172
00:11:05,140 --> 00:11:06,930
أهلاً

173
00:11:09,990 --> 00:11:11,940
لماَ أنتن هنا؟

174
00:11:15,010 --> 00:11:17,440
إنَّهُ مقهىً مُختصٌّ بشاي الأعشاب

175
00:11:18,150 --> 00:11:20,200
لدى الأعشاب الكثير من المزايا الحسَنة

176
00:11:20,430 --> 00:11:22,590
مَن كوّنَ فِكرةً خاطئة عن المكان من بينكن؟

177
00:11:22,590 --> 00:11:25,520
لقد أتينا لرؤيتكِ فقط يا شارو تشان

178
00:11:25,520 --> 00:11:27,950
ماذا قصدتِ بكلمة سيّئ إذاً؟

179
00:11:27,950 --> 00:11:29,830
ولكنَّني لستُ أنا من قال ذلك

180
00:11:33,590 --> 00:11:35,750
هذا زيٌّ رائع

181
00:11:35,750 --> 00:11:36,920
إنَّها هي

182
00:11:36,920 --> 00:11:39,090
ولكنَّكِ تبدينَ رائعة يا شارو تشان

183
00:11:39,090 --> 00:11:40,610
أذنا الأرنب تُناسبكِ

184
00:11:40,610 --> 00:11:41,930
مالك المكان يُحبّ هذه الأشياء

185
00:11:45,470 --> 00:11:49,260
لم أرد أن تراني ريزي سينباي وأنا بهذا الشّكل

186
00:11:49,260 --> 00:11:50,810
تلكَ هي نظرةُ الإحتقار

187
00:11:56,850 --> 00:11:59,320
قد ينفعُ تشذيبُ الآذان قليلاً

188
00:12:00,120 --> 00:12:02,260
لماذا ترتدينَ زِيَّ العمل؟

189
00:12:02,900 --> 00:12:04,450
كُنّا في عجلةٍ من أمرنا

190
00:12:04,770 --> 00:12:06,830
أودُّ أن أطلبَ يا آنسة

191
00:12:07,270 --> 00:12:08,700
أودُّ أن أطلبَ أيضاً

192
00:12:08,840 --> 00:12:10,170
لحظةً واحدةً فقط

193
00:12:10,170 --> 00:12:12,170
لا تقوما بأشياءٍ مُضلِّلة

194
00:12:12,960 --> 00:12:15,690
بما أنَّنا هُنا، هل نستطيعُ الحصول على بعض الشّاي قبلَ ذهابنا؟

195
00:12:15,690 --> 00:12:16,920
أجل، بكلّ تأكيد

196
00:12:18,710 --> 00:12:22,130
لا أعرفُ الكثير عن أنواع الشّاي بالأعشاب

197
00:12:22,560 --> 00:12:24,750
داندليون هو الأفضل

198
00:12:24,750 --> 00:12:26,390
هل جرّبتهِ من قبل؟

199
00:12:26,660 --> 00:12:29,110
إنَّهُ يجعلكِ قويّةً مثل الأسد

200
00:12:29,110 --> 00:12:31,180
إنَّها لا تعرف أنّهُ يعني زَهرة

201
00:12:31,600 --> 00:12:35,770
إن لم تُقرّرن بَعد
بإمكاني إختيار النّوع الّذي يُناسبُ كلّ واحدةٍ منكن

202
00:12:36,190 --> 00:12:38,180
سأختار الزَّهرة الهندية لكوكوا

203
00:12:38,180 --> 00:12:39,850
يمتلكُ مزايا للإسترخاء

204
00:12:40,780 --> 00:12:42,490
وإكليل الجبل لتشيا

205
00:12:42,490 --> 00:12:44,120
إنَّهُ جيّد للأكتاف المُتصلّبة

206
00:12:44,120 --> 00:12:45,160
سيكونُ هذا مفيداً

207
00:12:45,630 --> 00:12:49,160
هل ترغبينَ بالأقحوان ذي الرَّائحة الجميلة؟

208
00:12:49,520 --> 00:12:50,830
أنا لستُ طِفلة

209
00:12:51,280 --> 00:12:54,720
سمعتُكِ تقولين أنَّكِ تواجهينَ صعوبةً في النّوم يا ريزي سينباي

210
00:12:54,720 --> 00:12:56,250
لذا أنصحكِ بالخزامى

211
00:12:58,570 --> 00:13:03,240
يرغبُ تيبي بشيءٍ يُعيد قوّة السَّمع والبصر من فضلك

212
00:13:03,240 --> 00:13:05,010
هل تيبي طاعنٌ بالسنّ؟

213
00:13:11,880 --> 00:13:13,360
إنَّه يتحوّل إلى الّلون الأحمر

214
00:13:13,360 --> 00:13:14,520
كم هذا جميل

215
00:13:18,520 --> 00:13:22,560
يتحوّلُ هذا من الأزرق إلى الزهريّ عندما أضعُ الّليمونَ فيه

216
00:13:22,560 --> 00:13:24,100
كم هذا جميل

217
00:13:24,100 --> 00:13:24,780
حسناً

218
00:13:25,330 --> 00:13:27,650
هل ترغبنَ بالبسكويت المصنوع بالأعشاب؟

219
00:13:27,650 --> 00:13:29,280
لقد خبَزتُهُ بنَفسي

220
00:13:29,660 --> 00:13:31,540
هل صنعتِ هذا بالفعل؟

221
00:13:31,840 --> 00:13:32,780
سوف أجرّب

222
00:13:34,040 --> 00:13:35,000
إنَّها لذيذةٌ جدّاً

223
00:13:35,510 --> 00:13:37,000
أنا مسرورةٌ جدّاً

224
00:13:37,190 --> 00:13:39,040
تحوّلَ لون شارو تشان إلى أحمر

225
00:13:39,040 --> 00:13:41,380
من المُمتع مُشاهدة هذا

226
00:13:43,600 --> 00:13:45,440
هذا البسكويت ليسَ حلواً

227
00:13:45,440 --> 00:13:46,880
بلى هُو كذلك

228
00:13:48,020 --> 00:13:50,660
هذا لأنَّكِ شربتِ غيمنيما سيلفيسترا

229
00:13:51,310 --> 00:13:54,690
"غيمنيما تعني "مُدمِّر السكّر

230
00:13:54,690 --> 00:13:57,730
لن تستطيعي الشّعور بمذاقٍ حلو لفترةٍ من الزمن بعدَ تناوله

231
00:13:58,060 --> 00:14:00,860
هل هذا تأثير الأعشاب بالفعل؟

232
00:14:01,370 --> 00:14:04,230
كُنتِ تشربينهُ عندما اتّبعتِ حِميةً أليسَ كذلك؟

233
00:14:04,230 --> 00:14:06,570
لا تقولي هذا لهن أيّها الحمقاء

234
00:14:07,240 --> 00:14:09,570
لقد شربتُ كثيراً

235
00:14:09,570 --> 00:14:12,280
أشعرُ وكأنَّ أزهاراً سوفَ تتفتَّحُ في معدتي

236
00:14:13,460 --> 00:14:16,890
أخبريني إن كُنتِ تريدينَ مُساعدةً بشيءٍ ما

237
00:14:16,890 --> 00:14:20,710
شكراً لكِ
أنتِ أصغرُ منّي ولكنَّكِ فتاة مسؤولة

238
00:14:21,090 --> 00:14:22,660
أودّك أن تكوني أختي الصغرى

239
00:14:25,820 --> 00:14:28,180
تشينو تشان هي أختي أنا

240
00:14:28,180 --> 00:14:29,510
ما الّذي تتكلّمينَ عنه؟

241
00:14:29,980 --> 00:14:31,850
هل تشعرانَ بالإسترخاء؟

242
00:14:32,040 --> 00:14:34,300
أنا أشعرُ بالإسترخاء بالفعل

243
00:14:34,300 --> 00:14:36,480
وأعتقد أنَّ ألم أكتافي قد زال

244
00:14:36,770 --> 00:14:39,080
أنا أشعرُ بالحيوية

245
00:14:39,080 --> 00:14:41,440
أعتقدُ أنّه أثر الغُفل

246
00:14:41,440 --> 00:14:45,320
هل تستطيعينَ إعداد الشّاي بالأعشاب في المنزل يا شارو تشان؟

247
00:14:45,690 --> 00:14:48,490
أجل، هناكَ بعض الأشخاص يزرعون هذه الأعشاب

248
00:14:49,550 --> 00:14:51,150
لقد نامت كوكوا

249
00:14:51,150 --> 00:14:52,710
لقد كانت تتكلّم منذُ لحظة

250
00:14:52,710 --> 00:14:54,440
يعملُ هذا الشّاي بشكلٍ جيّد

251
00:14:59,030 --> 00:15:00,710
أنصتن جَميعاً

252
00:15:00,980 --> 00:15:03,090
هيّا لنصنع الشّاي بالأعشاب

253
00:15:03,450 --> 00:15:05,050
هل تعتقدين أنَّنا نستطيع أن نُحضّرهُ بهذا؟

254
00:15:05,650 --> 00:15:06,920
...كوكوا سان

255
00:15:07,250 --> 00:15:09,830
إنَّهُ حشيش

256
00:15:14,050 --> 00:15:17,390
شكراً لمجيئكما بالرّغم من أنّها تُمطر

257
00:15:17,700 --> 00:15:20,160
لقد خرجتُ من العمل بكلِّ الأحوال

258
00:15:20,160 --> 00:15:23,150
وكانت الشّمسُ مُشرقة عندما وصلنا إلى هنا

259
00:15:23,150 --> 00:15:25,520
هذا كلّهُ بفضلِ تصرّفات شخصٍ ما كُلّ يوم

260
00:15:25,770 --> 00:15:29,780
رُبّما بسبب مجيء شارو تشان إلى هنا

261
00:15:30,490 --> 00:15:31,780
أعتذرُ عن التّأخير

262
00:15:32,130 --> 00:15:34,600
أنتِ لا تُحبّينَ القهوة... هل ستكونين بخير؟

263
00:15:34,600 --> 00:15:36,840
لن يضرّ القليل من شُرب القهوة

264
00:15:40,910 --> 00:15:43,570
صنعت ريزي سينباي القهوة لي خِصّيصاً

265
00:15:45,710 --> 00:15:47,170
أنصتن جميعاً

266
00:15:47,650 --> 00:15:52,890
شكراً لأنَّكن لعبتن معي اليوم

267
00:15:52,890 --> 00:15:55,030
تعالي متى شئتِ

268
00:15:55,030 --> 00:15:57,430
!حقّاً؟ سآتي، سآتي

269
00:15:59,350 --> 00:16:01,440
أنتِ ظريفةٌ جدّاً يا تشينو تشان

270
00:16:01,440 --> 00:16:03,850
...أصبحَ لدينا كوكوا رقم اثنان

271
00:16:06,340 --> 00:16:08,370
يزدادُ تساقط المطرُ شيئاً فشيئاً

272
00:16:08,370 --> 00:16:09,360
وكذلك الرياح

273
00:16:09,940 --> 00:16:12,690
سأطلبُ سيّارة أجرة وأصطحبها إلى المنزل

274
00:16:13,420 --> 00:16:15,620
!لا أريدها أن تعلم أين أقطن

275
00:16:15,920 --> 00:16:18,450
كلا، أنا سآخذها إلى المنزل

276
00:16:19,880 --> 00:16:22,060
!تشيا تشان

277
00:16:26,910 --> 00:16:28,960
بإمكانكما استخدام الحمّام أوّلاً

278
00:16:28,960 --> 00:16:30,020
شكراً لكِ

279
00:16:30,020 --> 00:16:31,970
هل أنتما متأكّدتانِ من بقائي هنا أيضاً؟

280
00:16:32,370 --> 00:16:34,840
هل أنتِ متوتّرة لبقائكِ هنا يا ريزي تشان؟

281
00:16:34,840 --> 00:16:36,260
كلا

282
00:16:36,260 --> 00:16:39,130
كلُّ ما في الأمر أنَّني خيَّمتُ في البراري فقط

283
00:16:39,130 --> 00:16:40,510
...وإنَّها المرّةُ الأولى التي

284
00:16:40,510 --> 00:16:41,560
في البراري؟

285
00:16:43,170 --> 00:16:45,990
غُرفتكِ مثلكِ تماماً يا تشينو

286
00:16:48,270 --> 00:16:51,570
انظرا، لقد ارتديت لباس تشينو المدرسيّ

287
00:16:51,570 --> 00:16:55,180
بإمكانكِ الذّهاب إلى المدرسة الإعداديّة دون إثارة الشُّبهات. هذا أمرٌ مقلق

288
00:16:55,180 --> 00:16:57,370
حقّاً؟ سوف أجرّبُ ذلك

289
00:16:57,370 --> 00:17:00,200
تمهّلي، إنَّها تُمطرُ في الخارج

290
00:17:00,200 --> 00:17:01,580
هذه ليست المُشكلة الوحيدة

291
00:17:04,660 --> 00:17:07,890
أليسَ من الّلطيف أن نبقى هنا مع ريزي تشان والآخرين؟

292
00:17:07,890 --> 00:17:09,460
ليسَ تماماً

293
00:17:10,330 --> 00:17:12,980
أنتِ من أرادَ رؤيتهن، أليسَ كذلك؟

294
00:17:12,980 --> 00:17:14,600
ليس كذلك

295
00:17:15,350 --> 00:17:18,160
أنتِ لا تستمتعينَ بوقتكِ، أليس كذلك؟

296
00:17:18,160 --> 00:17:20,280
أنا لا أستمتعُ بوقتي

297
00:17:21,780 --> 00:17:24,580
إن تشينو تشان ظريفة لدرجة
تجعلك تعانقينها، أليس كذلك؟

298
00:17:24,580 --> 00:17:28,490
ألا يزعجها ذلك عندما تفعلها كوكوا؟

299
00:17:31,690 --> 00:17:34,250
من الجيّد أنَّنا استعرنا منامتي تشينو تشان

300
00:17:34,250 --> 00:17:35,740
لكن أليستا ظريفتين؟

301
00:17:36,070 --> 00:17:38,340
تبدينَ كفتاةٍ غنيّة بالفعل

302
00:17:38,800 --> 00:17:40,870
أنا أنامُ مُرتديةً ثيابي الرّياضيّة

303
00:17:42,170 --> 00:17:45,210
ماذا إن ضحِكَت ريزي سينباي على مظهري؟

304
00:17:48,380 --> 00:17:50,840
الأمرُ ليسَ كما تظُنّين
لقد خسرتُ في لعبة حجر ورق مقصّ

305
00:17:53,340 --> 00:17:55,680
حسناً يا تشينو تشان، لنذهب للاستحمام

306
00:17:55,680 --> 00:17:56,490
حسناً

307
00:17:56,490 --> 00:17:57,680
مهلاً

308
00:18:00,700 --> 00:18:02,120
لقد انتهينا

309
00:18:02,120 --> 00:18:03,390
أمازلتِ تقومينَ بذلك؟

310
00:18:03,900 --> 00:18:06,350
حسناً، أنا ذاهبةٌ لكي أستحمّ

311
00:18:07,070 --> 00:18:09,450
رائحتكِ تشبهُ رائحة كوكوا

312
00:18:10,230 --> 00:18:12,260
ماذا تقصدين؟ رائحتي تشبه رائحتي؟

313
00:18:12,260 --> 00:18:13,530
أنا أقصدُ الشّراب

314
00:18:13,820 --> 00:18:16,490
إنَّها بودرة استحمام

315
00:18:16,760 --> 00:18:19,180
سيجعلُ هذا رائحتكِ كالحلويّات يا ريزي تشان

316
00:18:19,180 --> 00:18:20,740
هذا ليسَ ضروريّاً

317
00:18:24,550 --> 00:18:27,000
أكرهُ الاعتراف بهذا ولكنَّهُ ليسَ سيّئاً

318
00:18:30,790 --> 00:18:33,360
أصبحَ المكانُ يضجُّ بالحيويّة فجأة

319
00:18:34,620 --> 00:18:36,360
بما أنَّنا نملكُ هذه الفُرصة

320
00:18:36,360 --> 00:18:39,690
أرغبُ بسماعِ الأشياء الّتي تخفينها في قلوبكن

321
00:18:40,830 --> 00:18:43,490
ألا يُجبرني هذا ببوحِ اسم من أحبّ؟

322
00:18:45,660 --> 00:18:48,850
!مهلا لحظة... لا! أنا لست جاهزةً لهذا

323
00:18:49,580 --> 00:18:52,180
أخبرنني بأفضلِ قصّة أشباح

324
00:18:52,730 --> 00:18:54,980
أنتِ تتكلّمينَ وكأنّكِ واقعةٌ في الحبّ

325
00:18:55,240 --> 00:18:57,780
وقعت قصّة أشباح في مقهاي

326
00:18:58,440 --> 00:18:59,600
حقّاً؟

327
00:18:59,600 --> 00:19:02,490
ريزي سان، كوكوا سان أعلم أنَّكما تعملانَ هنا

328
00:19:02,490 --> 00:19:04,590
ولكن ابقيا هادئتين وأنصِتا

329
00:19:06,300 --> 00:19:10,000
عندما يحلُّ الّليل في هذا المقهى

330
00:19:13,830 --> 00:19:16,660
شاهد الأمر الكثيرُ من الناس

331
00:19:16,660 --> 00:19:19,690
شاهدتُ الأمر أنا وأبي أيضاً

332
00:19:20,440 --> 00:19:22,890
ما هذا الشّيء؟

333
00:19:23,130 --> 00:19:25,190
عيونٌ تلمعُ في الظَّلام

334
00:19:25,930 --> 00:19:27,960
من شيءٍ صغير ومنفوش

335
00:19:28,760 --> 00:19:30,140
وأبيض

336
00:19:30,670 --> 00:19:33,810
..إنَّها تبذلُ جهدها لإخافتنا ولكن

337
00:19:33,810 --> 00:19:35,610
إنها تتحدّث عن تيبي

338
00:19:37,500 --> 00:19:39,500
لديَّ قصّةٌ كنتُ أحتفظ بها

339
00:19:39,910 --> 00:19:42,610
إنّها قصّةٌ حقيقيّة تُدعى: الأرنب المُمَزِّق

340
00:19:45,060 --> 00:19:46,370
انقطعت الكهرباء

341
00:19:46,370 --> 00:19:49,610
...يجب عليكن أن تهدأن. في أوقات كهذه

342
00:19:53,260 --> 00:19:55,000
لقد قُمتِ بإشعال شَمعة

343
00:19:55,510 --> 00:19:57,590
بدأت الأمور تُصبحُ حماسيّةً أكثر

344
00:19:58,740 --> 00:20:03,260
يوماً ما في إحدى المقاهي
كانَ هناكَ أرنب

345
00:20:04,140 --> 00:20:07,720
كانت تحدثُ جريمةَ قتلٍ تلو أخرى حول هذا الأرنب

346
00:20:11,230 --> 00:20:12,730
وهذه هي القصّة

347
00:20:13,130 --> 00:20:14,440
النّهاية

348
00:20:15,170 --> 00:20:18,610
هلّا توقّفنا عن رواياتِ قصص الأشباح وخلدنا إلى النوم؟

349
00:20:19,240 --> 00:20:22,150
سوفَ تأتي إلينا الأشباح دونَ شكّ

350
00:20:35,160 --> 00:20:36,340
الحمّام

351
00:20:47,390 --> 00:20:50,850
...تبا... لقد أخافتني تشيا

352
00:20:57,180 --> 00:20:58,600
ريزي سينباي؟

353
00:20:59,200 --> 00:21:02,920
انطفأت شمعتي ولم أستطع التّحرُّك

354
00:21:02,920 --> 00:21:04,410
ليس هذا ما حصل

355
00:21:05,350 --> 00:21:06,820
لنذهب سويّاً

356
00:21:07,120 --> 00:21:09,460
حسناً

357
00:21:14,160 --> 00:21:16,700
كم أحبّك أيّها البرق

358
00:21:25,260 --> 00:21:27,140
صباحُ الخير يا تشينو تشان

359
00:21:27,140 --> 00:21:28,700
صباحُ الخير

360
00:21:31,810 --> 00:21:33,150
صباحُ الخير

361
00:21:33,150 --> 00:21:36,150
...شارو تشان، قُلتِ في نومكِ أنَّ اليوم سيكون حافلا بالمبيعات الخا

362
00:21:36,850 --> 00:21:39,690
!حتّى وإن قلتُ ذلك، لا تتحدثي عنه هنا

363
00:21:44,640 --> 00:21:46,410
لما هي هناك؟

364
00:21:46,870 --> 00:21:49,790
رُبّما تحلم بالزّحف

365
00:23:27,360 --> 00:23:37,300
في الحلقة القادمة : أغراض الحظ خاصتك هي الخضار والجَريمة والعقاب

366
00:23:30,560 --> 00:23:33,420
فسوفَ تُصبحُ تشينو منفوشةٌ وناعمة مثلي تماماً

367
