193
00:13:48,700 --> 00:13:50,640
ماذا ستُسمّينَ هذا المقهى إذاً؟

194
00:13:50,640 --> 00:13:53,670
سوف أسمّيه المقهى المنفوش

195
00:13:54,940 --> 00:13:57,390
هذا ليسَ منطقيّاً

196
00:13:57,390 --> 00:13:59,370
المقهى المنفوش

197
00:13:59,910 --> 00:14:01,400
هل أحببتِ هذا؟

198
00:14:08,390 --> 00:14:10,690
ما الّذي تفعلينهُ يا ريزي-تشان؟

199
00:14:10,690 --> 00:14:12,250
فنُّ اللّاتيه

200
00:14:12,250 --> 00:14:15,210
أرسم صوراً في القهوة باستخدامِ فنّ اللّاتيه

201
00:14:15,210 --> 00:14:16,160
كهذه

202
00:14:17,860 --> 00:14:20,170
إنَّها خدمةٌ مجانيّة في هذا المقهى

203
00:14:20,630 --> 00:14:21,940
أتودّينَ تجربة هذا؟

204
00:14:21,940 --> 00:14:23,170
اترُكي الأمرَ لي بالرّسم

205
00:14:23,530 --> 00:14:26,190
فقد ربحتُ المرتبة الأولى من قبل

206
00:14:26,190 --> 00:14:27,720
الفَوزُ بمباراةٍ مدرسيّة

207
00:14:27,720 --> 00:14:29,890
هو إحدى أسوأ الدَّرجات، ولا تستطيعينَ حِسبانه

208
00:14:34,160 --> 00:14:36,640
سأريكِ بعض الأمثلة

209
00:14:36,640 --> 00:14:38,850
إنَّها مذهلة حقاً

210
00:14:38,850 --> 00:14:41,090
هل تعتقدينَ أنَّها رائعة بالفعل؟

211
00:14:41,090 --> 00:14:42,700
بل إنَّها مذهلة

212
00:14:42,700 --> 00:14:45,020
أنتِ فنّانةٌ رائعة يا ريزي-تشان

213
00:14:45,020 --> 00:14:46,860
اصنعي كوباً آخر، أرجوكِ

214
00:14:46,860 --> 00:14:49,060
حسناً

215
00:14:49,060 --> 00:14:50,110
كوبٌ آخر فقط

216
00:14:50,510 --> 00:14:51,490
حقّاً؟

217
00:14:51,490 --> 00:14:53,990
ولكن احرصي أن تحفظي الخطوات

218
00:15:05,090 --> 00:15:06,770
انتهيت

219
00:15:06,770 --> 00:15:08,580
هذا مُدهش

220
00:15:08,580 --> 00:15:10,590
هذا ليسَ بالشّيء الكثير

221
00:15:10,920 --> 00:15:14,470
كلّا، لقد تخطّى هذا مرحلة المهارة

222
00:15:14,470 --> 00:15:17,050
هذا ليسَ شيئاً بشريّاً حتّى

223
00:15:17,660 --> 00:15:20,120
حسناً، سوف أحاول

224
00:15:20,120 --> 00:15:21,100
ابذُلي جهدك

225
00:15:31,330 --> 00:15:34,280
هذا صعب
لم أكُن أتخيّل أنَّهُ بهذه الصعوبة

226
00:15:34,750 --> 00:15:35,680
دَعيني أرى

227
00:15:40,330 --> 00:15:43,120
هذا ظريفٌ جدّاً

228
00:15:44,000 --> 00:15:46,440
إنَّها تضحكُ عليّ

229
00:15:46,440 --> 00:15:47,580
ياللهول

230
00:15:47,580 --> 00:15:49,510
حاولي أن تصنعي واحداً يا تشينو-تشان

231
00:15:49,510 --> 00:15:51,270
هل عليَّ ذلك أنا أيضاً؟

232
00:15:52,330 --> 00:15:55,900
أتحرّقُ شوقاً لرؤية ما ستَصنع، ماذا عنكِ يا ريزي-تشان؟

233
00:15:55,900 --> 00:15:58,840
...حسبما أذكر، إنَّ فنّ اللّاتيه لدى تشينو هو

234
00:15:58,840 --> 00:16:00,020
انتهيت

235
00:16:00,690 --> 00:16:02,150
ماهذا؟

236
00:16:04,810 --> 00:16:06,790
أصبحت تشينو-تشان واحدةً مِنّا

237
00:16:06,790 --> 00:16:07,770
واحدةٌ منكما؟

238
00:16:07,770 --> 00:16:10,780
أجل، أنتِ واحدةٌ مِنّا

239
00:16:08,670 --> 00:16:10,780
كلّا يا كوكوا

240
00:16:11,380 --> 00:16:14,770
لا تستطيعين أن تُقارني هذا النَّوع من الفنّ بفنِّنا

241
00:16:19,350 --> 00:16:20,680
عملٌ جيّد اليوم

242
00:16:20,680 --> 00:16:22,000
عملٌ جيّد

243
00:16:25,270 --> 00:16:28,250
ستعيشين هنا بدءاً من اليوم يا كوكوا، أليسَ كذلك؟

244
00:16:28,570 --> 00:16:30,440
هذا صحيح

245
00:16:30,440 --> 00:16:33,260
لِنعُدّ العشاء سويّاً اليوم يا تشينو-تشان

246
00:16:33,260 --> 00:16:35,230
أستطيعُ أن أُعِدّهُ بنفسي

247
00:16:35,230 --> 00:16:37,780
ماذا؟ سوف أقومُ بمُساعدتكِ

248
00:16:37,780 --> 00:16:38,760
لا بأس بذلك حقّاً

249
00:16:38,760 --> 00:16:42,480
لماذا؟ دَعينا ندخلُ إلى المطبخِ سويّاً

250
00:16:40,880 --> 00:16:42,480
يبدو هذا مُسلّياً

251
00:16:42,890 --> 00:16:43,730
عمتما مساءً

252
00:16:43,730 --> 00:16:45,130
عملٌ جيّد اليوم

253
00:16:45,130 --> 00:16:46,700
إلى الّلقاء

254
00:16:48,110 --> 00:16:50,410
هل الحساءُ جيّدٌ على العشاء؟

255
00:16:50,410 --> 00:16:52,210
سأقطّعُ الخُضروات

256
00:16:52,210 --> 00:16:53,990
كلّا، سأفعلُ ذلك بنفسي

257
00:17:00,640 --> 00:17:01,880
تشينو-تشان

258
00:17:02,370 --> 00:17:03,000
ماذا؟

259
00:17:03,000 --> 00:17:05,370
مفاجأة

260
00:17:06,410 --> 00:17:07,380
ما هذا؟

261
00:17:07,380 --> 00:17:09,560
أعددتُها سرّاً اليوم

262
00:17:10,070 --> 00:17:11,550
هل هؤلاء... نحن؟

263
00:17:11,550 --> 00:17:13,180
هذا صحيح

264
00:17:18,040 --> 00:17:19,400
من هذا؟

265
00:17:19,400 --> 00:17:20,970
هذا والدي

266
00:17:21,590 --> 00:17:23,430
إذاً أنتِ كوكوا-كن، أليس كذلك؟

267
00:17:23,860 --> 00:17:26,170
ستُصبح الأمور أكثر حيويّة هنا

268
00:17:27,090 --> 00:17:28,770
من الرَّائع وجودكِ هنا

269
00:17:29,560 --> 00:17:31,650
شكراً على استِضافَتِكُم لي

270
00:17:32,250 --> 00:17:33,550
هذا مِن دواعي سروري

271
00:17:35,130 --> 00:17:36,650
اعتني بتشينو

272
00:17:37,360 --> 00:17:38,130
إلى الّلقاء

273
00:17:38,130 --> 00:17:39,340
حسناً

274
00:17:41,900 --> 00:17:44,000
ألا يتناول والدكِ الطّعام برفقتكِ؟

275
00:17:44,000 --> 00:17:47,440
يتحوّل رابت هاوس إلى حانةٍ في الّليل

276
00:17:47,440 --> 00:17:49,000
وهو الّذي يعمل كنادلٍ مساءً

277
00:17:49,000 --> 00:17:51,170
فهمتُ الأمر

278
00:17:51,170 --> 00:17:54,040
كما لو أنَّهُ يقوم بتزويد معلوماتٍ عن الطّرف الآخر

279
00:17:54,040 --> 00:17:55,220
هذا رائع

280
00:17:56,840 --> 00:17:59,090
ما الّذي تتكلّمينَ عنه؟

281
00:18:02,410 --> 00:18:04,050
متى سيَنتهي الطَّعام؟

282
00:18:04,050 --> 00:18:05,360
لن يطولَ كثيراً

283
00:18:06,840 --> 00:18:09,440
أشعرُ وكأنَّنا إخوةٌ عندَ قيامنا بهذه الأمور

284
00:18:09,440 --> 00:18:12,350
نحنُ... إخوة؟

285
00:18:14,840 --> 00:18:17,700
ستكونينَ كوكوا-أونيتشان، أليس كذلك؟

286
00:18:20,220 --> 00:18:22,430
فلتقولي هذا مُجدَّداً

287
00:18:25,240 --> 00:18:27,460
أرجوكِ، مرّةً أخرى

288
00:18:30,980 --> 00:18:33,800
أرجوكِ، مرّةً أخرى

289
00:18:43,990 --> 00:18:45,450
تشينو-تشان

290
00:18:45,860 --> 00:18:47,120
لنستحمَّ سويّاً

291
00:18:47,120 --> 00:18:48,270
سوفَ يكونُ حمّام كوكوا

292
00:18:49,250 --> 00:18:50,900
حمّام كوكوا؟

293
00:18:53,860 --> 00:18:55,800
هذا شعورٌ رائع

294
00:18:55,800 --> 00:18:57,550
هذا مُنعشٌ جدّاً

295
00:18:58,220 --> 00:19:01,100
هل نستطيعُ أن ننامَ في ذاتِ الغُرفة اليوم؟

296
00:19:01,770 --> 00:19:03,740
ذاتِ الغُرفة؟

297
00:19:03,740 --> 00:19:04,830
أجل

298
00:19:06,450 --> 00:19:08,670
حقائبي لم تَصِل بَعد

299
00:19:08,670 --> 00:19:11,130
وهناكَ الكثير من الأشياء الّتي أريدُ أن نتكلّم بها

300
00:19:11,890 --> 00:19:13,230
نتكلّم؟

301
00:19:13,670 --> 00:19:15,040
ننامُ سويّاً؟

302
00:19:15,820 --> 00:19:18,380
هل أستطيعُ أن أفعل كلّ هذا؟

303
00:19:20,250 --> 00:19:22,830
...ليسَ لديّ الكثير لأقوله ولكن

304
00:19:23,730 --> 00:19:26,670
كوني لطيفةً معي رجاءً

305
00:19:30,980 --> 00:19:33,380
أنصت إلى هذا يا وايلد غيس

306
00:19:33,380 --> 00:19:37,280
أتَت فتاةٌ جديدةُ اليوم
وقد كانت غريبة جدّاً

307
00:19:38,180 --> 00:19:39,740
تدرَّبت على فنِّ اللّاتيه كثيراً

308
00:19:39,740 --> 00:19:42,120
انتهى بنا الأمر بالكثير من أكواب القهوة

309
00:19:42,120 --> 00:19:44,740
سوف امتنع عن شُربِ القهوة بالحليب لفترة

310
00:19:48,960 --> 00:19:52,000
أنا لستُ وحيدة
أنا لستُ وحيدةً على الإطلاق

311
00:19:54,500 --> 00:19:56,500
بالمُناسبة، أينَ هو تيبي؟

312
00:19:56,500 --> 00:19:59,020
إنَّهُ يعمل في الحانة برفقةِ والدي

313
00:19:59,020 --> 00:20:02,820
أرغبُ بمعانقتهِ قبلَ أن أنام اليوم

314
00:20:02,820 --> 00:20:04,980
ولكنَّ تيبي ليسَ وِسادة

315
00:20:04,980 --> 00:20:08,260
إذاً سأنامُ وأنا أحضنكِ يا تشينو-تشان

316
00:20:12,360 --> 00:20:15,390
سوفَ تُصبحُ الأمورُ جنونيّة

317
00:20:15,390 --> 00:20:18,010
أتمنّى أن تنسجمَ تشينو معها

318
00:20:18,010 --> 00:20:22,810
تلكَ الفتاة الّتي تُدعى كوكوا، اعتادَت على المقهى بسرعة

319
00:20:23,260 --> 00:20:26,370
رُبّما ستكونُ صديقةً ممتازة لتشينو

320
00:20:28,560 --> 00:20:32,580
ولكنَّني أنزعجُ جدّاً عندما تتمسّكُ بي

321
00:20:32,580 --> 00:20:36,790
أنا في هذا الجسد الآن، هل تعلم ماذا يعني هذا؟

322
00:20:37,150 --> 00:20:40,150
أنتَ تعلم أنَّكَ ستستمتع بكلِّ لحظةِ يا أبي

323
00:20:40,150 --> 00:20:42,150
أحمق

324
00:20:42,150 --> 00:20:45,080
هل لديكَ فكرةٌ عن شعوري الآن؟

325
00:20:45,080 --> 00:20:45,860
أهلاً

326
00:20:45,860 --> 00:20:47,800
أنصت إليّ

327
00:20:54,100 --> 00:20:55,560
بريدٌ إلكترونيّ؟

328
00:20:55,560 --> 00:20:57,100
من كوكوا؟

329
00:20:59,070 --> 00:21:02,220
هل صنعت هذا بنفسها؟

330
00:21:05,530 --> 00:21:07,570
سأجعلها خلفيّةً لهاتفي

331
00:21:14,580 --> 00:21:15,900
كوكوا-سان

332
00:21:17,500 --> 00:21:20,580
كانَ عليَّ طلب المُساعدة بصُنع الحساء

333
00:21:20,580 --> 00:21:22,290
أهذا كُلُّ شيء؟

334
00:21:22,290 --> 00:21:23,670
تشينو-تشان

335
00:21:24,440 --> 00:21:27,050
هذه البلدةُ رائعةٌ جدّاً

336
00:21:27,390 --> 00:21:29,430
هل تعتقدينَ هذا؟

337
00:21:29,750 --> 00:21:30,570
أجل

338
00:21:32,750 --> 00:21:35,310
أنا سعيدةٌ لقدومي إلى هنا

339
00:21:35,630 --> 00:21:38,310
أشعرُ أنَّ الكثير من الأشياء المُمتعة سوف تحدث

340
00:21:42,760 --> 00:21:45,340
لنُصبح أصدقاء يا كوكوا-سان

341
00:21:45,340 --> 00:21:47,270
سأبذلُ جُهدي كأختٍ كبيرة

342
00:21:47,270 --> 00:21:49,030
تمهّلي قليلاً

343
00:21:49,030 --> 00:21:52,410
ماذا؟ أريدُ أن أشارككِ السَّرير اللّيلة

344
00:21:52,410 --> 00:21:53,540
ماذا؟

345
00:23:26,820 --> 00:23:36,640
في الحلقة القادمة: الفتاة الّتي أحبّت الحِنطة
والفتاة الّتي أحبّتها حبوب الآزوكي

346
00:23:27,430 --> 00:23:29,880
يبدو أنَّ كوكوا سوف تذهبُ للمدرسة

347
00:23:29,880 --> 00:23:33,740
إنَّها متوتّرةٌ جدّاً حيالها وحيال لقائها بفتاةٍ ما

348
00:23:33,740 --> 00:23:34,860
إنَّ هذا مُفاجئٌ

349
00:23:34,860 --> 00:23:35,880
ما الّذي تقوله؟

350
00:23:35,880 --> 00:23:36,640
أنا متشوّقٌ لذلك