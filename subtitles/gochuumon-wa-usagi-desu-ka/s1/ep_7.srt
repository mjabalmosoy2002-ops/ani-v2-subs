1
00:00:07,470 --> 00:00:09,230
ابقَ بعيداً عنّي

2
00:00:09,230 --> 00:00:12,240
إن اقتربتَ أكثر فسوفَ أعَضُّ على لساني

3
00:00:13,870 --> 00:00:15,240
مهلاً

4
00:00:21,510 --> 00:00:23,370
بما أنَّني أخافُ من الأرانب

5
00:00:23,370 --> 00:00:26,880
فأنا أقتدي بريزي سينباي التي تنقذني منها دائمًا

6
00:00:26,880 --> 00:00:30,380
إنه ظريف جدا عندما تمعن النظر به

7
00:00:27,630 --> 00:00:31,260
لو كانت شخصيّتي مثل شخصيّة ريزي سينباي

8
00:00:31,260 --> 00:00:33,880
لرُبَّما كنتُ تقبّلتُ واقع فقري

9
00:00:34,700 --> 00:00:36,890
!افسحوا الطريق! حان وقت التخفيضات

10
00:00:44,920 --> 00:00:46,300
المعذرة، المعذرة

11
00:00:46,300 --> 00:00:48,020
!ما كان يجب أن أتخيّل ذلك

12
00:00:48,390 --> 00:00:51,030
لا أستطيعُ أن أقولَ ذلك لريزي سينباي

13
00:00:48,390 --> 00:00:51,030
تتخيّلينَ ماذا؟

14
00:02:27,280 --> 00:02:28,280
كوكوا

15
00:02:29,020 --> 00:02:31,630
أليست تشينو في مِزاجٍ سيّئ اليوم؟

16
00:02:32,580 --> 00:02:33,670
حقّاً؟

17
00:02:34,120 --> 00:02:35,880
تشينو تشان

18
00:02:37,390 --> 00:02:39,630
توقّفي عن هذا رجاءً يا كوكوا سان

19
00:02:44,260 --> 00:02:46,270
أنتِ تقفينَ في طريقي يا كوكوا سان

20
00:02:46,950 --> 00:02:50,070
تشينو تشان دائماً تتصرف معي هكذا

21
00:02:50,070 --> 00:02:53,020
هل تعاملكِ دائماً بهذه الطّريقة؟

22
00:02:53,710 --> 00:02:55,150
هل حصلَ شيءٌ ما؟

23
00:02:57,220 --> 00:03:01,680
عندما كنتُ ألعب البارحة مع كوكوا سان في غرفتي

24
00:03:02,690 --> 00:03:04,160
أنا ذاهبة إلى المرحاض

25
00:03:05,540 --> 00:03:07,050
أراكِ لاحقاً

26
00:03:14,290 --> 00:03:16,000
وعندما عدتُ

27
00:03:16,520 --> 00:03:21,900
وجدت الأحجية التي أستمتع بحلها ببطء كل يوم، قد انتهت تقريبًا

28
00:03:22,730 --> 00:03:25,180
وكانت هناك قطعة ناقصة

29
00:03:25,180 --> 00:03:26,890
هذا مُحزن

30
00:03:27,320 --> 00:03:30,730
ماذا؟ ولكنَّني اعتقدتُ أنَّ ذلك سيُسعِدُ تشينو

31
00:03:31,080 --> 00:03:34,710
وتلك القطعة كانت مفقودة من البداية

32
00:03:34,710 --> 00:03:38,340
لا أعتقد أنها تظنكِ من أضاعها

33
00:03:38,340 --> 00:03:40,740
لكن لا بد أنها صُدمت لسرقة تلك المتعة منها

34
00:03:42,030 --> 00:03:44,090
...أنا... أنا

35
00:03:44,090 --> 00:03:46,700
أنا فاشلةٌ كأختٍ كبرى

36
00:03:47,260 --> 00:03:49,700
كان عليكِ الاعتذار أولا

37
00:03:52,860 --> 00:03:54,830
لم تعُد كوكوا بَعد

38
00:03:54,830 --> 00:03:58,710
لم تكُن تقصد أذيَتك، هلّا سامَحتها؟

39
00:03:58,710 --> 00:03:59,960
..ولكن

40
00:03:59,960 --> 00:04:02,470
بعدما اتّخذتُ ذاكَ الموقف أمامها

41
00:04:02,470 --> 00:04:05,250
أشعر بالحرج من التكلُّم معها

42
00:04:05,250 --> 00:04:07,520
إنَّها لم تُلاحظ هذا حتّى

43
00:04:07,520 --> 00:04:08,930
تشينو تشان

44
00:04:11,820 --> 00:04:15,390
!اشتريتُ لكِ أحجيةً جديدة، أرجوكِ سامِحيني

45
00:04:16,500 --> 00:04:17,990
!ثمانية آلاف قطعة؟

46
00:04:21,510 --> 00:04:23,700
أردتنا أن نساعدكن

47
00:04:24,100 --> 00:04:25,320
بهذا؟

48
00:04:25,320 --> 00:04:27,860
ساعدانا رجاءً

49
00:04:27,860 --> 00:04:30,040
لقد بدأنا بها ولكنها تبدو بلا نهاية

50
00:04:30,610 --> 00:04:32,680
لمَ لا تمزقيها فحسب؟

51
00:04:32,680 --> 00:04:35,790
...ستكون تلك خسارة كبيرة

52
00:04:35,790 --> 00:04:39,410
بالإضافة إلى أنّني لا أستطيعُ إيقاف ريزي تشان الآن

53
00:04:39,410 --> 00:04:40,800
هذا مُسَلٍّ

54
00:04:41,430 --> 00:04:43,590
هذا صحيح

55
00:04:44,100 --> 00:04:47,080
حسناً إذاً، سوف أساعدكن

56
00:04:47,080 --> 00:04:48,180
حقّاً؟

57
00:04:52,430 --> 00:04:55,370
لم أحل أحجية صور مقطوعة منذ مدة طويلة

58
00:04:55,370 --> 00:04:58,320
من الأسهل أن نبدأ بالأطراف، أليس كذلك؟

59
00:05:02,530 --> 00:05:05,410
سوف أجمعُ قطعتي مع قطعة تشينو تشان

60
00:05:05,410 --> 00:05:06,530
يجب أن يكونَ هذا صحيحاً

61
00:05:07,080 --> 00:05:11,060
سنجمعها الآن مع قطعة ريزي تشان

62
00:05:16,520 --> 00:05:18,080
شارو تشان

63
00:05:18,510 --> 00:05:21,880
هل يجدر بشخص عديم الجدوى ولم يجد قطع متناسبة

64
00:05:21,880 --> 00:05:23,740
التواجد هنا حقا؟

65
00:05:23,740 --> 00:05:25,900
أصبحت سلبيّةً فجأة

66
00:05:24,930 --> 00:05:28,720
لا أملكُ موهبة تركيب الأحاجي

67
00:05:25,900 --> 00:05:27,170
يا للازعاج

68
00:05:31,490 --> 00:05:33,890
ابدئي أولا يا سينباي

69
00:05:33,890 --> 00:05:36,140
كلا، يبدو أنَّ قطعَتُكِ مُطابِقة

70
00:05:36,140 --> 00:05:38,830
هذا ليسَ صحيحاً

71
00:05:38,830 --> 00:05:40,270
ولكن انظري إلى الشّكل

72
00:05:40,270 --> 00:05:42,600
كلا، أنتِ ابدئي أولاً

73
00:05:42,600 --> 00:05:43,940
كلا، أنتِ

74
00:05:45,000 --> 00:05:46,520
إنَّها مُناسبة

75
00:05:48,550 --> 00:05:50,440
ما الأمر؟

76
00:05:50,440 --> 00:05:52,860
لا شيء

77
00:05:57,720 --> 00:05:59,670
إنَّهُ أرنبٌ جميل

78
00:06:00,130 --> 00:06:04,590
ألا تعتقد أنَّ ذلك الأرنب يشبهني تمامًا؟

79
00:06:05,160 --> 00:06:07,390
بدأتُ أسأمُ من ذلك

80
00:06:07,390 --> 00:06:09,260
ماذا تعني بأنَّكَ بدأتَ تسأَم؟

81
00:06:13,060 --> 00:06:15,910
بدأ الجميع بقدان التركيز

82
00:06:15,910 --> 00:06:17,020
انظرن

83
00:06:17,640 --> 00:06:19,400
لقد صنعتُ قلباً

84
00:06:19,960 --> 00:06:23,150
خُذي استراحةً يا ريزي سينباي إن كُنتِ مُتعَبة

85
00:06:26,300 --> 00:06:30,530
مرت مدة وكوكوا سان تُحدّق بتلك القطعة دون حراك

86
00:06:34,440 --> 00:06:36,420
على فكرة

87
00:06:36,420 --> 00:06:39,480
لا داعي لأن تُحمّلي نفسكِ المسؤوليّة

88
00:06:39,480 --> 00:06:42,490
أنا لم أعُد غاضبة

89
00:06:42,490 --> 00:06:43,710
هل هي نائمة؟

90
00:06:45,520 --> 00:06:48,510
يجب أن أتابع المحاولة لوقت أطول

91
00:06:49,250 --> 00:06:51,290
كادَت أن تنتَهي

92
00:06:52,170 --> 00:06:53,050
أنتِ مُحِقّة

93
00:06:53,700 --> 00:06:55,270
!نحن في المرحلة الأخيرة

94
00:06:55,270 --> 00:06:55,810
أجل

95
00:06:56,350 --> 00:06:59,060
ولكن لا يوجد شيء تحت الأحجية

96
00:06:59,060 --> 00:07:00,560
ماذا سنَفعلُ بها؟

97
00:07:02,350 --> 00:07:04,570
ألم يُفكِّر أحدٌ بهذا؟

98
00:07:04,920 --> 00:07:07,480
لاحظتُ هذا سابقاً

99
00:07:07,480 --> 00:07:10,310
ولكنَّني لم أستَطِع البَوح بذلك خوفاً من هذهِ الّلحظة

100
00:07:10,740 --> 00:07:13,450
كانَ يجب أن أقولَ ذلك من قبل، إنَّهُ خطئي

101
00:07:13,890 --> 00:07:17,700
توقَّفي عن لَومِ نفسك، أنتِ تُوَتِّرينَ الجَّميع

102
00:07:21,670 --> 00:07:23,210
أنا جائعة

103
00:07:23,590 --> 00:07:25,740
سأذهبُ لإعدادِ بعض الفطائر

104
00:07:26,360 --> 00:07:27,670
سوف أساعدكِ

105
00:07:30,790 --> 00:07:33,840
يبدو أنَّهُما تصالَحَتا تِلقائِيّاً

106
00:07:33,840 --> 00:07:36,550
هل كانتا مُتخاصِمَتيْن؟

107
00:07:36,550 --> 00:07:39,890
ألَم تُلاحِظن أنَّ تشينو لم تتكلّم كثيراً؟

108
00:07:43,420 --> 00:07:46,070
أوليست تلك طبيعتها؟

109
00:07:46,070 --> 00:07:48,390
تشينو تشان خجولةٌ فقط

110
00:07:52,400 --> 00:07:57,900
احزري! يمكنني الآن أن أقلب الفطائر في الهواء

111
00:07:57,900 --> 00:08:00,310
!راقبي هذا! ها أنا ذي

112
00:08:04,460 --> 00:08:06,170
لنرَ

113
00:08:06,880 --> 00:08:10,500
لن تتكلّم معي تشينو تشان

114
00:08:10,500 --> 00:08:12,150
افعلي شيئاً حيال ذلك

115
00:08:13,020 --> 00:08:14,640
كانَ ذلك ساخنًا

116
00:08:18,140 --> 00:08:20,270
إنَّها تكرَهُني الآن

117
00:08:21,030 --> 00:08:23,980
...كادت الفطائر أن تَجهز، خذيها إلى

118
00:08:25,520 --> 00:08:27,030
هذه؟

119
00:08:28,560 --> 00:08:32,170
!حدث شيءٌ سيئ، تسبب الكتشب بموت كوكوا سان

120
00:08:33,810 --> 00:08:35,660
أنا أعتذرُ يا تشينو شان

121
00:08:36,090 --> 00:08:39,380
تعاملت معكِ ببرودة أيضًا

122
00:08:39,900 --> 00:08:43,220
ولكنَّها أوَّل مرّةٍ نتخاصمُ بها كأختيْن

123
00:08:43,220 --> 00:08:45,790
لذا كنتُ سعيدةً نوعاً ما... قليلا

124
00:08:47,330 --> 00:08:51,270
تدَّعي الأرانب المَوت لكي تلفت الانتباه أيضًا

125
00:08:51,270 --> 00:08:53,800
أنتِ لا تبدينَ كأرنب بهذهِ الابتِسامة

126
00:08:54,290 --> 00:08:56,190
بل تُشبهينَ قنفذ البحرِ أكثر

127
00:08:56,190 --> 00:08:58,790
قنفذ البحر؟

128
00:08:58,790 --> 00:09:00,330
لستُ مُتأكِّدة من شعوري

129
00:09:00,890 --> 00:09:03,180
شكراً على الطَّعام

130
00:09:03,520 --> 00:09:05,120
كانَ هذا لذيذاً

131
00:09:05,120 --> 00:09:05,810
أجل

132
00:09:06,320 --> 00:09:09,080
هذا اللغز السلكي صعب

133
00:09:09,080 --> 00:09:11,320
صنعها جَدّي خصّيصاً لأجلي

134
00:09:11,320 --> 00:09:14,390
هل تُحبّين الأحاجي يا تشينو؟

135
00:09:14,390 --> 00:09:18,200
...لقد كانت صعبة للغاية، حاولت مرارً، لكني لم أتمكن من حلّها

136
00:09:18,700 --> 00:09:23,450
سوفَ أُفاجئ جَدّي يوماً ما وأحلُّها

137
00:09:23,450 --> 00:09:28,480
ولكنَّني أتساءل أينَ ذهبت القِطعة النّاقصة من الأحجية الأولى

138
00:09:28,480 --> 00:09:31,990
ستجدينَ دائماً أشياءَ كهذه عندما تنسينَ أمرَها

139
00:09:31,990 --> 00:09:36,680
ذاتَ مَرّة، نسِيَت شارو تشان حقيبتها في المدرسة

140
00:09:36,680 --> 00:09:39,510
لقد كانت تبكي مخافة ألا تتمكن من المدرسة في اليوم التالي

141
00:09:39,870 --> 00:09:43,270
لا تتكلّمي عن ماضيّ أمام ريزي سينباي

142
00:09:49,160 --> 00:09:51,630
...تشينو تشان، هل هذهِ

143
00:09:51,630 --> 00:09:53,530
القِطعة المَفقودة

144
00:09:53,530 --> 00:09:56,780
هذا جيد! بإمكانكِ الآن أن تُنهيها

145
00:09:57,310 --> 00:09:58,200
أجل

146
00:10:09,610 --> 00:10:10,980
كوكوا سان

147
00:10:10,980 --> 00:10:12,920
أجل ؟ يمكنك مناداتي بأونيتشان

148
00:10:13,310 --> 00:10:15,010
لن أفعل هذا

149
00:10:17,470 --> 00:10:19,340
صباحُ الخير يا تشيا تشان

150
00:10:19,960 --> 00:10:21,670
صباحُ الخير يا كوكوا سان

151
00:10:21,670 --> 00:10:23,870
هل أصبحت تشينو تشان في مِزاجٍ أفضل؟

152
00:10:23,870 --> 00:10:26,260
لقد سامَحَتني هذا الصَّباح

153
00:10:26,850 --> 00:10:28,730
إنَّهُ ثقب؟

154
00:10:28,730 --> 00:10:30,380
!لا

155
00:10:30,380 --> 00:10:32,110
إن ترَكتِها هكذا سوف يزداد الأمر سوءا

156
00:10:32,560 --> 00:10:34,620
هل تُفضّلينَ تغطيتها بلُصاقة الجروح

157
00:10:34,620 --> 00:10:37,290
أم ألوّن جلدَكِ بالّلون الأسود؟

158
00:10:37,290 --> 00:10:38,510
لا بأس

159
00:10:39,870 --> 00:10:41,490
أظن أن هذا خيار ثالث

160
00:10:44,680 --> 00:10:48,000
أليست البطاطا الحُلوة الكستنائية الّتي صنعها والد تشينو تشان لذيذة؟

161
00:10:48,420 --> 00:10:49,580
أجل

162
00:10:49,580 --> 00:10:51,350
ألن تأكلي؟

163
00:10:52,630 --> 00:10:54,000
أنا لستُ جائِعة

164
00:10:54,500 --> 00:10:56,390
هل هي حزينة؟

165
00:10:56,860 --> 00:10:59,200
إن كانَ هُناكَ شيءٌ يُزعِجُكِ
فبإمكانكِ أن تُخبِريني

166
00:10:59,200 --> 00:11:01,590
شكراً ولكن... لا بأس

167
00:11:01,590 --> 00:11:03,390
هذه مُشكِلَتي أنا

168
00:11:06,320 --> 00:11:08,140
تشيا حزينة؟

169
00:11:08,700 --> 00:11:10,020
هذا صحيح

170
00:11:10,540 --> 00:11:13,410
ولكنَّكِ لم تُلاحظيني عندما كنتُ غاضِبة

171
00:11:13,410 --> 00:11:16,560
أمّا تشيا فقد لاحظتِها عندما تصرَّفت بشكلٍ غريب

172
00:11:17,570 --> 00:11:20,330
هل تشعرُ تشينو تشان بالغيرة؟

173
00:11:20,330 --> 00:11:22,290
أنتِ غبية يا أونيتشان

174
00:11:23,660 --> 00:11:26,790
مازلتُ أهتمُّ لأمركِ يا تشينو تشان

175
00:11:27,550 --> 00:11:30,000
عندما لا تأخذين حمّاماً معي

176
00:11:30,000 --> 00:11:33,220
فأنا أتقبَّلُ أنَّكِ تعتقدينَ نفسكِ أكبر من أن تقومي بذلك

177
00:11:33,220 --> 00:11:36,040
كما أنني أفكر في طُرُقٍ للتعامل مع الفترات العاصية

178
00:11:36,550 --> 00:11:38,600
هل كلمة "أفكّر" صحيحةٌ هنا؟

179
00:11:38,600 --> 00:11:42,460
هل تظنين أنك أبٌ لابنة بالغة؟

180
00:11:42,460 --> 00:11:45,430
في الواقع هناكَ شيءٌ يُزعجني أيضاً

181
00:11:45,960 --> 00:11:48,150
بوحي لي بالشّيء الّذي تُعانينَ منه

182
00:11:48,150 --> 00:11:49,930
ارمِ نفسكِ في أحضاني فقط

183
00:11:50,650 --> 00:11:53,020
أنا هنا من أجلك، أخبريني بكل شيء

184
00:11:53,020 --> 00:11:56,190
قد تكلفك أية هفوة ذهنية حياتك في ساحة المعركة

185
00:11:56,510 --> 00:11:59,040
أشعرُ وكأنَّني توقّفتُ عن النموّ

186
00:11:59,040 --> 00:12:00,830
كلُ ماعليكِ فِعلهُ هو مُتابعة حياتك

187
00:12:00,830 --> 00:12:02,450
!لقد تجاهلَتنا

188
00:12:03,150 --> 00:12:07,010
أنا قلِقة، سوف أذهبُ لتفقُّد تشيا تشان

189
00:12:07,010 --> 00:12:09,320
ولكن الظلام قد حلّ في الخارج

190
00:12:09,320 --> 00:12:11,330
لا أريدُ أن يحصلَ شيءٌ ما

191
00:12:12,040 --> 00:12:13,290
سوفَ أُعيركِ هذا

192
00:12:13,940 --> 00:12:17,290
عندما تُطلقين النّار، أبقِ مرفقيك مُتقارِبين، وامسكيهِ بكِلتا يديكِ

193
00:12:17,290 --> 00:12:19,800
مِنَ المُمكن أن يُقبضُ عليّ

194
00:12:25,250 --> 00:12:26,680
شارو تشان

195
00:12:27,110 --> 00:12:29,570
ما الّذي تفعلينهُ أمام منزل تشيا تشان؟

196
00:12:30,700 --> 00:12:33,570
لقد تشاجرتُ نوعاً ما معها هذا الصَّباح

197
00:12:33,570 --> 00:12:35,310
عندما أتَت لإيقاظي

198
00:12:35,310 --> 00:12:37,570
ألِهذا السَّبب هي حزينة؟

199
00:12:37,570 --> 00:12:41,190
حاولت أن تَتبَعني
ولكنَّني هربتُ منها وذهبتُ للمدرسة

200
00:12:41,540 --> 00:12:43,900
شارو تشان

201
00:12:44,840 --> 00:12:46,200
لم أتَحمَّل الذَّنب

202
00:12:46,660 --> 00:12:49,140
وتريدين أن تتصالحا الآن صحيح؟

203
00:12:49,560 --> 00:12:51,920
ولكن كانَ ذلك خطأ تشيا أيضًا

204
00:12:51,920 --> 00:12:55,670
فهي ترغمني على شرب الحليب كل
!صباح، وتقول لي أنه سيساعدني في النمو

205
00:12:55,980 --> 00:12:57,860
لأنَّ صَدري مُسَطَّح

206
00:12:57,860 --> 00:12:59,920
أعتقد أنَّها مُهتمّةٌ بطولك فقط

207
00:13:01,030 --> 00:13:03,330
كانت تشيا تشان حزينةً جدّاً اليوم

208
00:13:03,330 --> 00:13:05,940
لم أرَها كئيبةً بهذا الشّكل من قبل

209
00:13:05,940 --> 00:13:07,850
أكانت حزينةً لهذه الدَّرجة؟

210
00:13:07,850 --> 00:13:09,890
من الجَّميل أن يكون لدى الشَّخص صديقُ طفولة

211
00:13:12,330 --> 00:13:13,430
لنذهب

212
00:13:13,970 --> 00:13:16,310
لن تشعُري بالإحراج إن كنتُ برفقتك صحيح؟

213
00:13:16,650 --> 00:13:20,840
لم يكُن هذا سبب عدم دخولي للمقهى

214
00:13:22,520 --> 00:13:24,000
أنا خائفةٌ منه

215
00:13:24,000 --> 00:13:26,700
كُلّما يراني يهجمُ عليَّ و يعضُّني

216
00:13:26,700 --> 00:13:30,450
اترُكي الأمرَ لي
سوف أحميكِ

217
00:13:31,380 --> 00:13:33,450
أهلاً

218
00:13:34,450 --> 00:13:35,790
عملية سرقة؟

219
00:13:36,110 --> 00:13:38,090
إنها أنا فحسب

220
00:13:38,550 --> 00:13:41,410
ما الّذي يحصل يا كوكوا تشان؟

221
00:13:42,240 --> 00:13:46,200
هل أنتِ بخير؟ فأنتِ لم تتناولي طعام الغداء

222
00:13:46,200 --> 00:13:48,040
أنا لستُ جائعة

223
00:13:48,040 --> 00:13:50,690
لقد أخذتِ الطَّلب الأخير اليوم أليسَ كذلك؟

224
00:13:50,690 --> 00:13:52,010
سوف أستعيرُ مطبخك

225
00:13:54,830 --> 00:13:56,850
المطبخُ ليسَ من هذا الاتّجاه

226
00:13:59,300 --> 00:14:00,540
يبدو هذا مناسبًا

227
00:14:00,540 --> 00:14:02,760
تبدينَ وكأنَّكِ تعرفين ما الّذي تفعلينه

228
00:14:02,760 --> 00:14:04,690
عندما تُعِدِّينَ حساء الميسو

229
00:14:05,220 --> 00:14:07,960
يُشعِرُني هذا بالحَنينِ إلى أمّي

230
00:14:07,960 --> 00:14:09,660
توقّفي عن هذا

231
00:14:09,660 --> 00:14:11,450
بالمُناسبة يا أمي

232
00:14:11,900 --> 00:14:14,620
مازالَ حجمُ الأعشاب البحريّة يتزايد

233
00:14:14,620 --> 00:14:15,910
لقد وضعتِ الكثير

234
00:14:15,910 --> 00:14:19,360
دموعي تنهمرُ بسببِ هذا البصل

235
00:14:19,360 --> 00:14:22,160
توقفي عن إزعاجي إن كنت ابنتي

236
00:14:22,160 --> 00:14:26,010
أتُعِدَّان طعامَ العشاء من أجلي ؟

237
00:14:26,010 --> 00:14:28,570
لقد قُلتِ أنَّكِ لستِ جائعة

238
00:14:28,570 --> 00:14:30,840
لذا أردتُ طهوَ شيءٍ خفيفٍ وصحيّ

239
00:14:30,840 --> 00:14:32,260
هذا يُشعِرُني بالسَّعادة

240
00:14:32,260 --> 00:14:35,020
ولكن بدلاً من أن تعتبري نفسكِ أماً يا شارو تشان

241
00:14:35,370 --> 00:14:38,520
هل يمكنك أن تكوني الزوجة حديثة العهد التي تظن أن كل شيءٍ سيكون بخير

242
00:14:38,520 --> 00:14:40,680
طالما الحبُّ موجودٌ بيننا بالرغم من فقرنا؟

243
00:14:40,680 --> 00:14:42,900
لا تَتَنصَّتي علينا هكذا

244
00:14:43,940 --> 00:14:45,130
في الواقع

245
00:14:46,020 --> 00:14:48,510
أنا أعتذرُ عن هروبي منكِ هذا الصَّباح

246
00:14:48,510 --> 00:14:50,070
شارو تشان

247
00:14:50,070 --> 00:14:52,910
حسناً يا تشيا تشان، يجب أن تكوني سعيدةً الآن

248
00:14:52,910 --> 00:14:54,910
...أنا آسفة... في الواقع

249
00:14:55,620 --> 00:14:58,200
لنتبادل وجبات الغداء

250
00:14:58,200 --> 00:15:01,460
كانت البطاطا الحُلوة الكستنائية الّتي أعدَّها والد تشينو تشان

251
00:15:01,710 --> 00:15:05,160
أفضل بكثير من الحلوى الّتي أعِدُّها أنا

252
00:15:05,160 --> 00:15:07,100
ولكنَّني كنتُ مُحرجةٌ جدّاً من هذا ولم أقُل شيئاً

253
00:15:07,100 --> 00:15:09,130
لهذا كُنتِ حزينةً إذاً

254
00:15:09,130 --> 00:15:09,970
بالمُناسبة

255
00:15:10,420 --> 00:15:12,750
هناكَ شيءٌ أردتُ إعطائكِ إيّاه هذا الصَّباح

256
00:15:12,750 --> 00:15:14,890
ماذا؟ ألم يكُن حليباً؟

257
00:15:15,390 --> 00:15:17,790
كانَ هذا عالقٌ بشجرةٍ أمام منزلنا

258
00:15:18,900 --> 00:15:22,110
ركضتِ إلى المدرسة بسرعة ولم ألحق بكِ

259
00:15:23,360 --> 00:15:26,430
هل كُنتِ تركضينَ خلفي وتُلَوِّحينَ بهذا ورائي؟

260
00:15:26,430 --> 00:15:27,960
أيّتها الحمقاء اليابانيّة المُحِبّة للحلويّات

261
00:15:27,960 --> 00:15:29,480
أبيض؟

262
00:15:32,410 --> 00:15:35,530
هل تحلِيَتُكِ اليوم هي الحليب مع الكانتن يا تشينو تشان؟

263
00:15:36,170 --> 00:15:38,790
مذاقُها كالتَّحلية وتحتوي على الكثير من الكالسيوم

264
00:15:38,790 --> 00:15:40,950
لذا أعتقد أنَّ هذا سيُساعدني على النموّ

265
00:15:42,820 --> 00:15:45,140
وإن كُنتُ محظوظة سوف يكبرُ صَدري قليلاً أيضاً

266
00:15:45,140 --> 00:15:46,500
! هذا تفكيرٌ منطقيّ

267
00:15:46,500 --> 00:15:48,050
أتعتقدين أنَّ هذا سيَنجح؟

268
00:15:49,940 --> 00:15:53,780
إنَّها أفضل من تحلية الكانتن الّتي نُقدّمها

269
00:15:57,730 --> 00:16:00,250
أنا من مقهى فلور دو لابان

270
00:16:00,250 --> 00:16:02,060
إنَّنا نُقدّم الشّاي بالأعشاب

271
00:16:02,600 --> 00:16:04,540
شكراً لكِ

272
00:16:04,540 --> 00:16:06,150
كم بقي من الملصقات؟

273
00:16:09,030 --> 00:16:11,510
!ابتعد عن تلك الملصقات

274
00:16:11,510 --> 00:16:14,070
!قلتُ لكَ ابتعد

275
00:16:15,620 --> 00:16:17,220
ابتعد من هنا أرجوك

276
00:16:17,220 --> 00:16:20,840
أرجوك، أرجوك، أرجوك

277
00:16:18,520 --> 00:16:20,330
...إنَّها تتوسَّلُ إلى أرنب

278
00:16:20,840 --> 00:16:23,230
أرجوك، أرجوك

279
00:16:23,230 --> 00:16:24,040
تفضّلي

280
00:16:25,330 --> 00:16:27,000
!ريزي سينباي

281
00:16:28,340 --> 00:16:29,880
شكراً لكِ

282
00:16:30,730 --> 00:16:34,020
لا أراكِ بهذا اللّباس خارج العمل عادةً

283
00:16:34,020 --> 00:16:35,640
تمَّ تعييني لتوزيعِ مُلصقات من أجل

284
00:16:35,640 --> 00:16:39,390
مهرجان الخُبز الّتي تُقيمهُ كوكوا

285
00:16:38,990 --> 00:16:39,390
خريطة →                          هنا

286
00:16:39,860 --> 00:16:41,470
..."سنأكل جميع الأنواع"

287
00:16:42,980 --> 00:16:46,150
ولكنَّني سأعمل طوال يوم السبت

288
00:16:46,150 --> 00:16:48,910
حقّاً؟ هذا مؤسف

289
00:16:48,910 --> 00:16:52,150
كنتُ أكل ما يحلو لي من خبز الشّمّام

290
00:16:52,150 --> 00:16:54,110
حسناً، سوف أبدأ الآن

291
00:16:54,760 --> 00:16:57,550
إن حملتها بهذا الشّكل
فهل سيأخها الناس مني؟

292
00:16:57,550 --> 00:16:58,550
أجل

293
00:16:58,980 --> 00:17:02,440
تعالوا إلى فلور دو لابان من فضلكم

294
00:17:02,440 --> 00:17:05,000
إنَّها تُروِّجُ لمقهانا من دونِ قصد

295
00:17:07,030 --> 00:17:08,220
هل هناكَ خطبٌ ما؟

296
00:17:08,220 --> 00:17:12,170
كتبتِ اسم المقهى بالشّكل الخاطئ يا كوكوا سان

297
00:17:12,720 --> 00:17:15,480
لقد كتبتِ هورس "حصان" بدلاً من هاوس

298
00:17:15,480 --> 00:17:16,590
ياللهول

299
00:17:16,590 --> 00:17:19,640
إن أضفنا حِصاناً إلى الّلافتة فسَتُحَلُّ المُشكلة صحيح؟

300
00:17:19,640 --> 00:17:20,970
كلا

301
00:17:20,970 --> 00:17:25,980
"ولماذا جعلتِ تيبي يقول شيئاً غريباً مثل "أهلاً بكم، تفضّلوا

302
00:17:25,980 --> 00:17:28,510
هذا رسمٌ سيئ لي

303
00:17:28,510 --> 00:17:31,360
سوف ينتشرُ خطأي في المدينةِ بأكملها

304
00:17:31,360 --> 00:17:33,410
سأذهبُ لاستعادة المُلصقات

305
00:17:33,410 --> 00:17:36,110
تصرفت بحماقة لأني لم أتفقدها

306
00:17:36,580 --> 00:17:38,340
تعالو إلى مقهانا رجاءً

307
00:17:38,340 --> 00:17:39,420
المعذرة

308
00:17:39,420 --> 00:17:40,080
أجل؟

309
00:17:41,020 --> 00:17:44,500
هل هذا مقهىً من النَّوع الإباحي؟

310
00:17:41,950 --> 00:17:46,580
~يغذّي العقلَ والجَّسدَ معاً~

311
00:17:44,500 --> 00:17:46,580
إنَّهُ مُجرَّدُ مقهىً ناجح عادي

312
00:17:46,930 --> 00:17:51,820
فهمت... نقوم بشرب الشاي بينما
...نحترم الفتيات المرتديات لآذني الأرانب

313
00:17:51,820 --> 00:17:52,970
!نحترم؟

314
00:17:53,940 --> 00:17:56,090
هذه فكرةٌ جيّدة

315
00:17:56,530 --> 00:18:00,050
سآتي لزيارتكم قريباً، لذا احجزي لي مِقعداً

316
00:18:01,110 --> 00:18:03,770
لا تتحدّثي إلى أفخاذي من فضلك

317
00:18:04,080 --> 00:18:06,500
أعتقد أنَّها فَهِمَتني بالشَّكل الخاطئ

318
00:18:06,500 --> 00:18:08,630
لأنني لم أستطع أن أنظر في عينيها عندما تكلَّمتُ معها

319
00:18:07,720 --> 00:18:09,290
تعالوا إلى مقهانا

320
00:18:10,810 --> 00:18:12,900
هل هذا مُلصقٌ لمَقهى رابت هاوس؟

321
00:18:13,690 --> 00:18:17,150
سيّدي... أستطيعُ أن أراكَ مرّةً أخرى

322
00:18:17,880 --> 00:18:19,280
رابت هورس؟

323
00:18:21,050 --> 00:18:23,280
أعتقدُ أنَّهُ مقهىً آخر

324
00:18:23,600 --> 00:18:26,820
توقّفي عن توزيع المُلصقات

325
00:18:26,820 --> 00:18:28,540
شارو سان؟

326
00:18:29,460 --> 00:18:31,490
أخطأت في الاسم

327
00:18:31,490 --> 00:18:32,130
ماذا؟

328
00:18:33,110 --> 00:18:34,250
لم ألاحظ هذا

329
00:18:34,740 --> 00:18:37,590
لا يمكننا فعل شيء الآن، حلُّنا الوحيد هو أن نُصَحِّح المُلصَقات الّتي بقِيَت

330
00:18:41,170 --> 00:18:43,000
اثبتي مكانكِ أرجوكِ

331
00:18:43,000 --> 00:18:45,220
أصبحتُ حصاناً الآن بالفعل

332
00:18:46,480 --> 00:18:48,790
سقطت حشرةٌ كبيرةٌ من الغُصن

333
00:18:48,790 --> 00:18:49,890
لماذا حصلَ هذا؟

334
00:18:50,270 --> 00:18:52,430
هذا جانب غير متوقع منك

335
00:18:53,740 --> 00:18:56,050
وأنتِ تبدينَ شخصا يُعتمدُ عليهِ بشكلٍ مُفاجئ

336
00:18:56,050 --> 00:18:59,110
تدخلُ هذه الحشرات من الفجوات في منزلي

337
00:18:59,110 --> 00:19:00,830
أو لا تدخل على الإطلاق

338
00:19:03,560 --> 00:19:05,620
ومع هذا أنتِ تخافينَ من الأرانب

339
00:19:05,980 --> 00:19:08,820
أعتقدُ أنَّكِ لن تُمانعي من حملِ أرنبٍ صغير صحيح؟

340
00:19:08,820 --> 00:19:11,580
حسناً، إن لم يكُن يعضّ

341
00:19:12,740 --> 00:19:14,530
..ما الّذي

342
00:19:19,110 --> 00:19:20,480
أتُصدِرُ الأرانب صوتاً؟

343
00:19:20,480 --> 00:19:23,300
لا أعتقد أنَّها تتكلم بصوتٍ واضح

344
00:19:23,840 --> 00:19:26,470
تُصدِرُ الأرانب أصواتاً صرصارة

345
00:19:26,470 --> 00:19:27,560
حقّاً؟

346
00:19:30,150 --> 00:19:32,060
سوف أسألُها عندما أصل إلى المنزل

347
00:19:34,130 --> 00:19:37,170
شكراً لقدومكم لمهرجان الخُبز اليوم

348
00:19:37,170 --> 00:19:39,440
أنا سعيدةٌ جدّاً لنجاحه

349
00:19:39,920 --> 00:19:43,980
لم تكوني هناك معنا
لذا خُذي هذا الخُبز

350
00:19:43,980 --> 00:19:45,200
شكراً لكِ

351
00:19:45,200 --> 00:19:48,230
حسناً، هل تعرفين أينَ هو منزل شارو؟

352
00:19:48,940 --> 00:19:50,470
لم تستطع المجيء بسبب العمل

353
00:19:50,470 --> 00:19:52,080
لذا نريدُ أن نقدِّمَ لها بعض الخُبز

354
00:19:52,080 --> 00:19:56,520
..أعتقد أنَّها تعيشُ بمنزلٍ كبير بسقفٍ أحمر ولكن

355
00:19:56,520 --> 00:19:57,720
..في الواقع

356
00:19:59,460 --> 00:20:02,340
نسيتُ أن أشتري العشاء

357
00:20:07,590 --> 00:20:09,840
...لا تقلن لي أننا كنا

358
00:20:09,840 --> 00:20:12,390
...مخطئين بشدة

359
00:20:12,390 --> 00:20:15,480
لطالما فرضنا تخيلاتنا كثيراً عليكِ

360
00:20:16,250 --> 00:20:20,310
لطالما أُعجِبتُ بكِ
وهذا ليسَ لأنَّكِ غنيّة

361
00:20:20,310 --> 00:20:22,110
إنَّها تحاول أن تُهوّن عليّ بكلامها

362
00:20:22,440 --> 00:20:24,910
بالمُناسبة يا شارو تشان، أينَ تُقيمين؟

363
00:20:24,910 --> 00:20:27,370
في هذه السقيفة الصغيرة الموجودة هنا

364
00:20:27,690 --> 00:20:32,160
فهمتُ الآن.. أنتِ هي طالبة المِنحة في مدرستنا

365
00:20:32,160 --> 00:20:34,170
لم أستطع أن أقول هذا لكُن

366
00:20:34,640 --> 00:20:38,380
حسناً، لكي نتعادَل
سوف أُخبركِ بسِرّي

367
00:20:39,490 --> 00:20:44,750
أنا أحب أن أعطي مسدسات مصَغّرة لأرانبي المحشوة

368
00:20:44,750 --> 00:20:46,470
هل هذا غريب؟

369
00:20:46,870 --> 00:20:48,390
أعلمُ ما الّذي تقصدينه

370
00:20:48,390 --> 00:20:52,310
أنا أفهم ما الّذي تقصدينه
فأنا أحبُّ وضع الصّحون بجانب ألعابي

371
00:20:52,630 --> 00:20:53,980
أتقومينَ بذاتِ الشَّيء؟

372
00:20:53,070 --> 00:20:55,520
إنَّهُما تمتلكان ذات الصِّفات

373
00:20:53,980 --> 00:20:54,450
أجل

374
00:20:54,450 --> 00:20:56,310
أنا سعيدةٌ جدّاً

375
00:20:59,050 --> 00:21:01,030
أشعرُ بالإحراج

376
00:21:01,030 --> 00:21:02,810
لقد شاهدوا منزلي

377
00:21:03,240 --> 00:21:05,200
لكنك فهمت الآن، أليس كذلك؟

378
00:21:05,790 --> 00:21:09,720
حتّى عندما علِموا أنَّكِ لستِ غنيّة
لم يخب أملهن

379
00:21:09,720 --> 00:21:11,610
فأنتِ مازلتِ شارو تشان ذاتها

380
00:21:12,110 --> 00:21:13,310
..تشيا

381
00:21:14,720 --> 00:21:19,020
ولكن مع هذا فأنا حزينةٌ أنَّ السرّ الّذي كان بيننا قد انفضح

382
00:21:19,020 --> 00:21:20,170
لماذا؟

383
00:21:20,170 --> 00:21:21,960
حسناً، لنتناول بعض الخبز

384
00:21:21,960 --> 00:21:25,410
لا تستعملي مجموعة فناجيني دونَ أن تطلبي مِنّي الإذن

385
00:21:25,410 --> 00:21:27,650
هناكَ الكثير من خبز الشمام

386
00:21:27,650 --> 00:21:29,180
أليسَ هذا لطيفاً؟

387
00:21:31,160 --> 00:21:32,810
ما هذا؟

388
00:21:33,380 --> 00:21:35,140
لقد اختفَت لوحَتي

389
00:21:35,140 --> 00:21:37,210
وضعتُ عِوَضاً عَنها لوحة جديدة

390
00:21:37,210 --> 00:21:38,310
ما الّذي تقوله؟

391
00:21:38,900 --> 00:21:40,850
انظر جيّداً يا أبي

392
00:21:40,850 --> 00:21:43,850
ألا تذكّركَ هذه الأرانب الخمسة بأحد؟

393
00:21:43,850 --> 00:21:44,690
ماذا؟

394
00:21:47,800 --> 00:21:48,740
...حسنًا

395
00:21:49,170 --> 00:21:51,180
أعتقد أنَّها ليست سيّئة

396
00:21:51,180 --> 00:21:55,270
بما أنَّني أنظر عن قرب الآن
ألا يبدو الأرنب في المُنتصف مثلي؟

397
00:23:27,150 --> 00:23:37,060
في الحلقة التّالية: مبلولٌ بماء المسبح، مبلولٌ بالمطر، مبلولٌ بالدُّموع

398
00:23:28,090 --> 00:23:30,530
أجل، هذا يجعلُ الشَّخص صادقاً

399
00:23:30,530 --> 00:23:31,970
أريدُ أن أكونَ صادقاً مع هذه المشاعر

400
00:23:31,970 --> 00:23:34,820
يبدو أنَّ تشينو مُتأثّرةٌ أكثر بغروب الشَّمس

401
00:23:34,820 --> 00:23:37,010
...أنا... مهلا، أنا أيضًا