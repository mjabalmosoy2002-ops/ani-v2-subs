1
00:00:25,460 --> 00:00:27,920
إنَّهُ سوق عيد الميلاد

2
00:00:28,660 --> 00:00:32,280
إنَّها المرّة الأولى الّتي تأتينَ بها إلى سوق كهذا أليسَ كذلك يا كوكوا تشان؟

3
00:00:32,280 --> 00:00:33,120
أجل

4
00:00:33,750 --> 00:00:35,360
اهدأي

5
00:00:35,360 --> 00:00:37,490
أنا في سعادةٍ غامرة

6
00:00:37,490 --> 00:00:38,300
إلى أينَ نذهب أوّلاً؟

7
00:00:39,640 --> 00:00:42,300
لا تنسَي لمَ أتينا إلى هنا ساعة وصلنا

8
00:00:42,300 --> 00:00:46,700
أتينا لشراء الحُليّ لنُزيّن بها شجرتنا في المقهى

9
00:00:46,700 --> 00:00:47,900
أجل هذا صحيح

10
00:00:48,580 --> 00:00:51,290
أنا أفهمُ تماماً سبب تحمسها

11
00:00:51,290 --> 00:00:55,240
بما أنَّنا أتينا، لنتجوّل هنا بعدَ أن نشتري ما أتينا لأجله

12
00:00:55,240 --> 00:00:56,280
لنقُم بذلك

13
00:00:56,280 --> 00:00:57,930
مرحى

14
00:00:58,390 --> 00:00:59,530
اهدأي قليلاً

15
00:00:59,530 --> 00:01:01,920
من هنا يا تشينو تشان

16
00:01:00,480 --> 00:01:02,730
انتبهي سوف تقعين

17
00:01:04,600 --> 00:01:07,250
هل قرَّرتن ما ستضعن في قائمة عيد الميلاد؟

18
00:01:07,250 --> 00:01:10,420
أجل، وضعناها نحنُ الثّلاثة هذه السّنة

19
00:01:10,870 --> 00:01:12,320
لقد عمِلنا بجدّ

20
00:01:12,320 --> 00:01:16,380
سوف فطائر مميزة حصريًا بمناسبة عيد الميلاد

21
00:01:16,380 --> 00:01:18,230
هذا رائع

22
00:01:18,230 --> 00:01:20,990
هل ستقدّم آما أوسا آن شيئاً خاصّاً؟

23
00:01:20,990 --> 00:01:23,830
سوف نقدّم الدّيك الرّومي هذه السّنة

24
00:01:23,830 --> 00:01:25,740
ديكٌ روميّ في متجر حلويّات؟

25
00:01:25,740 --> 00:01:27,940
يمرُّ الأمر بشكلٍ جيّد لسببٍ ما

26
00:01:28,440 --> 00:01:30,400
علينا إذًا أن نصنع البيتزا

27
00:01:30,780 --> 00:01:34,610
بإمكاني تخيّلك وأنتِ تكسرين الصّحون عندما تدوّرين عجينة البيتزا

28
00:01:34,610 --> 00:01:38,020
كنت أدوّر عجينة البيتزا في صغري

29
00:01:38,020 --> 00:01:40,990
أنتِ تلقين نكتاً ظريفة أحياناً يا تشينو

30
00:01:41,860 --> 00:01:45,000
هل ستعملين في عيد الميلاد يا شارو سان؟

31
00:01:45,000 --> 00:01:47,720
أجل فالأجر سيكونُ جيدًا

32
00:01:48,310 --> 00:01:51,840
..من الّلُطف أن يكون لديَّ عطلة بيوم عيد الميلاد، ولكن

33
00:01:51,840 --> 00:01:55,300
لنحتفل معًا بمناسبة عيد الميلاد بعد العمل

34
00:01:51,840 --> 00:01:55,300
لنلتقي معًا بمناسبة عيد الميلاد بعد العمل

35
00:01:56,410 --> 00:01:58,150
لقد تناغَمتُما بشكلٍ رائع

36
00:01:59,180 --> 00:02:01,640
كنتُ أنتظر اليوم الّذي سأتناغم به مع تشينو تشان منذُ زمن

37
00:02:01,640 --> 00:02:03,560
ولكنَّنا لم نتناغَم

38
00:02:03,560 --> 00:02:06,470
قالت كوكوا سان : حفلةً بعد العمل

39
00:02:06,470 --> 00:02:08,640
بينما قلت : لنلتقي معًا

40
00:02:08,640 --> 00:02:10,470
إنَّهما ذاتُ الشّيء

41
00:02:10,470 --> 00:02:13,960
نأكلُ الطّعام، نتناوَلُ كعكة ونشربُ القهوة

42
00:02:13,960 --> 00:02:15,910
ونرقصُ طوال الّليل

43
00:02:15,910 --> 00:02:18,170
لن أرقصَ وأبقى مستيقظة طوال اللّيل

44
00:02:18,170 --> 00:02:22,120
كما أنه علينا الاحتفال بعيد الميلاد بهدوء وسلام

45
00:02:22,120 --> 00:02:23,550
تشينو تشان

46
00:02:24,940 --> 00:02:27,250
تبدوانَ كأختين بالفعل

47
00:02:29,210 --> 00:02:30,710
تشينو تشان

48
00:02:30,710 --> 00:02:34,330
على أيّ حال، أودُّ أن نجتَمع كلّنا سويّاً

49
00:02:34,330 --> 00:02:37,670
لمَ لا نتبادل الهدايا بينَنا؟

50
00:02:37,670 --> 00:02:39,500
هذه فكرةٌ رائعة

51
00:02:39,500 --> 00:02:41,180
هل يناسبك ذلك يا شارو؟

52
00:02:42,370 --> 00:02:43,430
شارو؟

53
00:02:43,430 --> 00:02:48,560
...لن أحتفل بكعكة أرز دبق تتوسطها شمعة فقط هذه السنة

54
00:02:48,980 --> 00:02:51,960
كيفَ كُنتِ تقضينَ أعياد الميلاد طوال كلّ هذه السّنوات؟

55
00:04:26,140 --> 00:04:29,160
أنا أشمُّ رائحةً حلوة منذ مدة

56
00:04:29,490 --> 00:04:30,660
أنتِ مُحقّة

57
00:04:30,660 --> 00:04:32,670
أتساءلُ إن كانَ أحدٌ يطهو حبوب الآزوكي

58
00:04:32,670 --> 00:04:33,610
لا أظن ذلك

59
00:04:33,610 --> 00:04:35,250
هل هي آتية من هناك؟

60
00:04:47,770 --> 00:04:49,760
كم هذا جميل

61
00:04:50,160 --> 00:04:51,830
هذا مارزبان

62
00:04:51,830 --> 00:04:53,710
إنَّها تُستعملُ لتزيين الكعك وما شابه

63
00:04:53,710 --> 00:04:56,520
لماذا اسمها مارزيبان؟

64
00:04:57,120 --> 00:04:59,180
لأنه خبز جاد

65
00:04:59,180 --> 00:05:01,150
إنه جاد حيال مظهره الظريف

66
00:05:01,150 --> 00:05:03,500
أهذا خبز؟

67
00:05:03,500 --> 00:05:04,630
على ما أذكر

68
00:05:04,630 --> 00:05:08,990
فإنها معجنات مصنوعة بعجن اللوز المدقوق والسكر معًا

69
00:05:12,100 --> 00:05:14,230
لأنه جاد

70
00:05:14,230 --> 00:05:17,620
إنه جاد! لهذا بإمكانه تخطي عقبات الأجناس

71
00:05:17,620 --> 00:05:19,250
لا تُتعبي نفسك

72
00:05:26,930 --> 00:05:28,260
كم هذا جميل

73
00:05:28,860 --> 00:05:31,870
هناكَ العديد من أنواع الحُلي

74
00:05:31,870 --> 00:05:33,930
أتساءلُ ما الّذي سنحضرهُ للمقهى

75
00:05:34,700 --> 00:05:36,920
لمَ لا نُزيّن منزلك يا شارو تشان؟

76
00:05:36,920 --> 00:05:38,480
سوف يبدو مُذهلاً

77
00:05:38,480 --> 00:05:40,690
إنّهُ جيّد كما هو

78
00:05:40,690 --> 00:05:42,710
يالهُ من تمثال ملاك كبير

79
00:05:42,710 --> 00:05:44,960
لديهم أشياء كهذه أيضاً؟

80
00:05:44,960 --> 00:05:47,700
!"سيكون الموضوع "الإسطبل الذي وُلد فيه المسيح

81
00:05:48,120 --> 00:05:49,100
إسطبل؟

82
00:05:49,100 --> 00:05:50,250
ألم يُعجبكِ هذا؟

83
00:05:50,250 --> 00:05:52,030
يجب أن تعلمي هذا مُسبقاً

84
00:05:57,000 --> 00:05:59,200
هل يمكنني أن أسألك شيئاً يا ريزي تشان؟

85
00:05:59,750 --> 00:06:00,790
ما الأمر؟

86
00:06:00,790 --> 00:06:03,800
كلّ ما في الأمر، أنَّهُ في ليلة عيد الميلاد

87
00:06:03,800 --> 00:06:07,560
أودُّ أن أضع هدية بجانب وسادة تشينو تشان لكي أفاجئها

88
00:06:08,680 --> 00:06:12,010
ولكن ماذا يجب أن أُحضر لها؟

89
00:06:12,820 --> 00:06:14,430
ما رأيكِ بهذا؟

90
00:06:16,670 --> 00:06:18,610
سيُفاجئها هذا بطريقةٍ أخرى

91
00:06:18,610 --> 00:06:20,200
أنا أمزح

92
00:06:20,200 --> 00:06:23,690
ما رأيكِ بصندوق الموسيقى ذاك؟

93
00:06:25,030 --> 00:06:26,190
قد يفي بالغرض

94
00:06:26,660 --> 00:06:28,700
إن قدّمتُ لها هذا مع الأرنب المحشو

95
00:06:28,700 --> 00:06:32,470
سوف تبتسمَ حتّى لو بكيت

96
00:06:32,470 --> 00:06:34,700
لا داعي لأن تحضري لها الأرنب

97
00:06:42,440 --> 00:06:43,490
ثلج

98
00:06:47,130 --> 00:06:48,630
إنّهُ جميلٌ جدّاً

99
00:06:49,310 --> 00:06:51,570
عندما أنظر إلى السّماء لوقتٍ طويل

100
00:06:51,570 --> 00:06:54,010
أشعر وكأنّها تسحبُني للأعلى

101
00:06:59,770 --> 00:07:02,060
أينَ كنتِ يا كوكوا سان؟

102
00:07:03,710 --> 00:07:07,120
إنَّها هديّةٌ مُبكرة من سانتا كوكوا

103
00:07:07,120 --> 00:07:08,150
امددن أيديكن

104
00:07:08,890 --> 00:07:09,820
تفضّلن

105
00:07:10,240 --> 00:07:13,320
هذا ما كنتُ أنظر إليه

106
00:07:14,230 --> 00:07:15,280
كوكوا

107
00:07:15,870 --> 00:07:18,200
...كنتُ أريدُ أن أتناولها لذا

108
00:07:18,200 --> 00:07:19,910
إنَّها مُجرَّد كُتل سكَّر

109
00:07:20,230 --> 00:07:23,380
ولكن لماذا قرَّرتِ أن تقدّمي لنا هذه فجأة؟

110
00:07:23,770 --> 00:07:27,640
عندما كنتُ صغيرة، كنتُ أتمنّى أن أكونَ سانتا

111
00:07:27,640 --> 00:07:29,210
لديكِ الكثير من الأحلام

112
00:07:29,770 --> 00:07:32,390
ما أردتيه في الحقيقة هو أن أتسلل

113
00:07:32,390 --> 00:07:34,480
بينما أنتن نائمات و؛ضر لكن أحلاما

114
00:07:34,480 --> 00:07:35,430
هذا مُخيف

115
00:07:35,430 --> 00:07:40,230
لمَ لا نُقم حفلة عيد الميلاد في رابت هاوس؟

116
00:07:40,230 --> 00:07:41,720
يبدو هذا جيدا

117
00:07:41,720 --> 00:07:43,310
هل أنتِ موافقة على هذا يا تشينو تشان؟

118
00:07:43,310 --> 00:07:45,000
بالطّبع

119
00:07:45,000 --> 00:07:46,320
سوف نحجز المكان بأكمله ليلا

120
00:07:46,840 --> 00:07:50,280
حفلةٌ في المكان الّذي أعملُ به

121
00:07:50,280 --> 00:07:52,150
سيكونُ شعوراً غريباً

122
00:07:52,590 --> 00:07:56,030
هل أستطيعُ إحضار مايا سان و ميغو سان أيضاً؟

123
00:07:56,030 --> 00:07:58,040
إنّها فكرةٌ رائعة

124
00:07:58,780 --> 00:08:00,750
حماسي سيَمنعني من النَّوم في الّليل

125
00:08:01,170 --> 00:08:03,710
سيُغمى عليك في ليلة عيد الميلاد

126
00:08:06,140 --> 00:08:08,800
أنتِ سانتا رائع يا كوكوا تشان

127
00:08:08,800 --> 00:08:11,380
ماذا قُلتِ؟

128
00:08:11,380 --> 00:08:13,550
لا شيء

129
00:08:14,380 --> 00:08:16,640
إلى أينَ سنذهب الآن؟

130
00:08:16,640 --> 00:08:18,560
أريد شراء وجبة خفيفة من  كشك ما

131
00:08:18,560 --> 00:08:20,380
أريدُ رؤية الأضواء

132
00:08:20,380 --> 00:08:21,700
لنقُم بكلّ هذا

133
00:08:21,700 --> 00:08:23,760
حسناً، لنركض

134
00:08:23,760 --> 00:08:25,030
أجل

135
00:08:25,030 --> 00:08:26,960
سوف تقعين إن ركضتِ

136
00:08:26,960 --> 00:08:28,570
مرحى

137
00:08:43,510 --> 00:08:46,210
ها هي فطيرة العيد المُميّزة

138
00:08:48,570 --> 00:08:51,870
أتساءل إن كانَ الجَميع سيأتين إلى الحفلة

139
00:08:52,380 --> 00:08:55,420
تشيا وشارو مشغولتان بالعمل أيضًا

140
00:08:55,420 --> 00:08:58,220
أربع فطائر مميزة من فضلك

141
00:08:58,220 --> 00:09:00,890
لا يوجد وقت نهدره في القلق على الغير

142
00:09:01,290 --> 00:09:05,310
"أنتِ لم تكتبي"أهلاً بكم! تعالوا

143
00:09:05,310 --> 00:09:06,400
على الدعوات مجدّدا أليس كذلك يا كوكوا سان؟

144
00:09:06,880 --> 00:09:10,170
لا بأس! فقد استعملت الكانجي هذه المرة

145
00:09:10,170 --> 00:09:11,700
هذا سيئ

146
00:09:19,300 --> 00:09:20,700
خطرت لي فكرة

147
00:09:20,700 --> 00:09:24,480
،بما أنَّها مُناسبة خاصّة
سوف بتمثيلية مضحكو في الحفلة

148
00:09:24,480 --> 00:09:26,970
سيكون من الممتع عرض مسرحية هزلية قصيرة مع شارو تشان

149
00:09:25,290 --> 00:09:26,540
ماذا؟

150
00:09:27,380 --> 00:09:31,550
لكني لم أحسّن تلك المزحة بعد

151
00:09:31,550 --> 00:09:36,050
كلا، هذه الحفلة تُقيمها كوكوا تشان وتشينو تشان

152
00:09:39,340 --> 00:09:41,720
لن أسمحَ بأيّ تسويات

153
00:09:41,720 --> 00:09:43,710
رائع

154
00:09:44,460 --> 00:09:48,230
تعالوا و شاهدونا

155
00:09:48,810 --> 00:09:50,370
البردُ قارس

156
00:09:50,370 --> 00:09:53,060
لا أصدّق أنَّني أوزّع الملصقات في يوم كهذا

157
00:09:55,330 --> 00:09:58,360
أتمنّى أن أصل إلى الحفلة في الوقت المُناسب

158
00:09:59,010 --> 00:10:01,650
بوجود الكثير من النّاس ستكون صينية بطاطس مناسبة جدًا

159
00:10:01,650 --> 00:10:04,700
وكعكة للتحلية تنتظرنا بعد ذلك

160
00:10:05,220 --> 00:10:08,970
ماذا؟ لقد رأيت شيئًا كهذا من قبل

161
00:10:09,540 --> 00:10:11,590
أرجوكم، اشتَروا أعواد الثِّقاب

162
00:10:11,590 --> 00:10:13,000
مُستحيل

163
00:10:26,310 --> 00:10:28,250
مساءُ الخير

164
00:10:28,250 --> 00:10:30,640
لقد أحضرنا حلويّات العيد

165
00:10:30,640 --> 00:10:31,440
ماذا؟

166
00:10:31,780 --> 00:10:33,660
رابت هاوس مُمتلئٌ بالزّبائن

167
00:10:33,660 --> 00:10:35,050
هذا شيءٌ نادر

168
00:10:35,610 --> 00:10:38,350
يبدو أنَّ فطائرنا الخاصة قد ذاع صيتُها في البلدة بأكملها

169
00:10:38,350 --> 00:10:40,490
تفضّلا بالجّلوس وانتظرا

170
00:10:40,490 --> 00:10:43,420
مهلاً، هل ارتديتُما هاتان في طريقكما إلى هنا إلى هنا؟

171
00:10:43,420 --> 00:10:44,290
بالطّبع

172
00:10:44,290 --> 00:10:45,280
تبدو جيدة أليس كذلك؟

173
00:10:45,280 --> 00:10:47,910
...إن أحضرتما هذه الأشياء

174
00:10:48,270 --> 00:10:50,890
لا أستطيعُ كبحَ جِماح نفسي

175
00:10:50,890 --> 00:10:52,790
مازِلنا نَعمل يا كوكوا سان

176
00:10:55,110 --> 00:10:56,440
مساءُ الخير

177
00:10:56,440 --> 00:10:58,390
هل العملُ جيّد؟

178
00:10:58,390 --> 00:11:01,760
أهلاً تشيا تشان، اجلسي برفقة مايا سان و ميغو سان وانتظرن قليلاً

179
00:11:02,220 --> 00:11:04,640
أحضرتُ بعض الحلويّات اليابانيّة الخاصة

180
00:11:04,640 --> 00:11:07,330
حلويّاتٌ يابانيّة؟

181
00:11:08,620 --> 00:11:11,560
..كلا يا ميغو، يُفترضُ أن تقولي

182
00:11:12,040 --> 00:11:14,760
إنَّها كعكة أليس كذلك؟

183
00:11:14,760 --> 00:11:18,940
أجل تقريباً
ولكنَّني أردتُ رؤية بعض الحماس

184
00:11:19,480 --> 00:11:21,420
أعتذرُ لجعلِكُن تنتظرن

185
00:11:21,420 --> 00:11:22,820
فأنتن زبائن أيضًا

186
00:11:23,190 --> 00:11:25,840
يبدو أنك مشغولة جدًا

187
00:11:25,840 --> 00:11:28,120
حسناً سوفَ نساعدكِ إذاً

188
00:11:28,120 --> 00:11:29,580
إن كانَ هذا لا يُزعجكن

189
00:11:29,930 --> 00:11:31,830
على الإطلاق، سيساعدنا ذلك كثيرًا

190
00:11:32,240 --> 00:11:35,340
يحتاجُ الجميع إلى أصدقاء وأخواتٍ صغيرات

191
00:11:36,140 --> 00:11:38,790
أهذه هي فطيرة العيد الخاصّة؟

192
00:11:38,790 --> 00:11:40,220
تبدو لذيذةٌ جدّاً

193
00:11:40,220 --> 00:11:42,600
سنَعملُ بعد أن نتناولها

194
00:11:42,600 --> 00:11:44,220
هل ستتقاعسانِ من الآن؟

195
00:11:45,300 --> 00:11:47,100
هل وصلتُ في الوقت المُناسب؟

196
00:11:47,470 --> 00:11:50,560
شارو... ما كان عليك القدوم ركضًا

197
00:11:50,560 --> 00:11:54,230
لم تعمَلن جميعاً؟

198
00:11:54,230 --> 00:11:56,310
إنَّهن مشغولات لذا فإنَّنا نُساعدهن

199
00:12:01,230 --> 00:12:05,280
كنتُ أعتقد أنَّني انتهيتُ من العمل

200
00:12:06,010 --> 00:12:08,160
بإمكانكِ الجلوس والانتظار يا شارو تشان

201
00:12:08,700 --> 00:12:11,000
أجلسُ وأنتظر؟

202
00:12:11,750 --> 00:12:14,420
!ما كنت لأسمح لنفسي لفعل ذلك أبدًا

203
00:12:15,150 --> 00:12:17,000
لقد تجاوَزت حدودها واستفاقت

204
00:12:18,540 --> 00:12:21,180
إلى الطّاولة رقم 2، شطائر ممزوجة وقهوة أميركيّة

205
00:12:21,180 --> 00:12:23,340
وفطيررة خاصة وقهوة بالحليب

206
00:12:23,340 --> 00:12:23,800
حاضر

207
00:12:24,140 --> 00:12:28,400
الطّاولة رقم 3، معكرونة وفطيرة خاصّة ومزيجُ القهوة أيضًا

208
00:12:28,400 --> 00:12:29,060
عُلِم

209
00:12:29,680 --> 00:12:32,120
شارو سان رائعةٌ جدّاً في خدمة الزبناء

210
00:12:32,120 --> 00:12:34,190
هذا لا شيء، لا يمكننا أن نخسر أمامها

211
00:12:35,700 --> 00:12:39,490
بإمكاني أن أعُود إلى عملي الطّبيعي وأخيراً

212
00:12:39,490 --> 00:12:41,100
لا يوجد وقتٌ للرّاحة

213
00:12:41,100 --> 00:12:45,410
مدربة شيطانة! إلهة الموت لساحة المعركة

214
00:12:45,410 --> 00:12:46,700
هذا إطراءٌ لي

215
00:12:47,180 --> 00:12:50,140
"هذا الزّبون يريدُ طبق "خيوط الغروب

216
00:12:50,140 --> 00:12:51,170
الغروب؟

217
00:12:51,170 --> 00:12:51,830
ميغو

218
00:12:51,830 --> 00:12:53,860
!إنها مجرد معكرونة

219
00:12:53,860 --> 00:12:54,580
ماذا؟

220
00:12:55,030 --> 00:12:59,590
"ها هو "الإغراء الأحمر والأبيض فوق القمة المقدسة

221
00:13:00,040 --> 00:13:01,840
لقد أعطت اسمًا رائعًا

222
00:13:02,450 --> 00:13:05,420
المعذرة ولكنَّها عادةٌ قديمة

223
00:13:05,420 --> 00:13:08,680
من المدهش كيفَ تستطيعين ابتكار أسماء كهذه على الفور

224
00:13:08,680 --> 00:13:11,970
بإمكاني تغيير أسماء قائمتكن بليلةٍ واحدة

225
00:13:12,380 --> 00:13:13,390
لن أسمحَ بهذا

226
00:13:13,780 --> 00:13:16,930
لن يُجرى أيّ تغييرٍ قد يُسبِّبُ أيّ تشويش

227
00:13:16,930 --> 00:13:20,190
ونحتاجُ إلى أربع فطائر خاصة

228
00:13:20,190 --> 00:13:21,020
حسناً

229
00:13:21,020 --> 00:13:24,530
تبدو شارو تشان مدربة شرّيرة أكثر من ريزي تشان

230
00:13:24,960 --> 00:13:29,430
لكن متغير الزبائن قد ازداد مذ أتت شارو تشان

231
00:13:29,430 --> 00:13:33,140
حسناً لنتحمس ونعمل بجدٍّ أكبر جميعاً أيضًا

232
00:13:33,140 --> 00:13:34,410
أجل

233
00:13:35,910 --> 00:13:37,660
كان هذا لذيذاً

234
00:13:37,660 --> 00:13:38,170
أجل

235
00:13:39,320 --> 00:13:42,550
الطاولة رقم 2، اسبريسو مابعد العشاء

236
00:13:42,870 --> 00:13:43,670
عُلم

237
00:13:44,800 --> 00:13:46,550
أريدُ أن أقضمَ القليل

238
00:13:48,250 --> 00:13:49,450
لا تستطيعين

239
00:13:54,940 --> 00:13:57,190
نفذت منا الزُّبدة

240
00:13:57,610 --> 00:13:59,090
هذه مُشكلة

241
00:13:59,090 --> 00:14:01,820
الكثير من المتاجر مُغلقة في عيد الميلاد

242
00:14:02,210 --> 00:14:03,480
لا تقلقي

243
00:14:04,310 --> 00:14:06,190
بإمكاننا صُنع الزُّبدة

244
00:14:06,590 --> 00:14:07,700
...تشيا سان

245
00:14:07,700 --> 00:14:11,020
...إن خفقتِ القشدة الخامة هكذا

246
00:14:22,650 --> 00:14:23,710
!تشيا سان

247
00:14:24,200 --> 00:14:28,220
...لحظة من فضلكما

248
00:14:33,730 --> 00:14:36,490
إنَّها 3،620 يَن

249
00:14:36,490 --> 00:14:40,150
أعتذر عن التّأخير، الفاتورة هي 3،620 ينّ

250
00:14:42,080 --> 00:14:42,850
تفضّلي

251
00:14:42,850 --> 00:14:44,270
إنه الثمن الصحيح

252
00:14:44,720 --> 00:14:46,780
شكراً جزيلاً لكما

253
00:14:47,500 --> 00:14:49,820
شكراً لكِ يا كوكوا تشان

254
00:14:49,820 --> 00:14:52,150
لا داعي لأن تتوتَّري

255
00:14:52,150 --> 00:14:53,160
ذات مرة، حاولت تشيا تشان

256
00:14:53,160 --> 00:14:57,620
تكليف أحد الزبائن ما يكفي لتطابق الميزانية الوطنية

257
00:14:57,620 --> 00:15:00,620
أعتقدُ أنَّ هذا جديرٌ بالتّوتُّر

258
00:15:30,700 --> 00:15:33,410
إنَّهُ ظريفٌ جدّاً! ما هذا؟

259
00:15:33,740 --> 00:15:36,460
هذه الفطائر لذيذةٌ جدّاً

260
00:15:36,460 --> 00:15:38,080
شكراً جزيلا

261
00:15:41,350 --> 00:15:43,080
هذا رائعٌ بالفعل

262
00:15:43,080 --> 00:15:45,470
حقّاً؟

263
00:15:45,470 --> 00:15:48,090
يمكنني رسم أي شيء تطلبينه

264
00:15:48,090 --> 00:15:51,430
هلّا جهّزتِ الطبقَ التالي يا ميغو تشان؟

265
00:15:51,430 --> 00:15:52,090
بالطّبع

266
00:15:52,090 --> 00:15:54,300
شكرا جزيلا

267
00:16:25,880 --> 00:16:30,960
لطالما تمنّيتُ أن يكونَ المقهى ملاذاً هادئاً

268
00:16:33,510 --> 00:16:36,470
ولكن هذا مُمتعٌ أيضاً

269
00:16:43,770 --> 00:16:45,730
عمِلنا بجدٍّ اليوم

270
00:16:45,730 --> 00:16:47,700
أنا مُتعبةٌ جدّاً

271
00:16:47,700 --> 00:16:49,860
ولكنَّنا استمتعنا بوقتنا

272
00:16:50,170 --> 00:16:52,780
أشعرُ وكأنَّنا أنجزنا شيئاً

273
00:16:52,780 --> 00:16:56,820
أنا وتاكاهيرو سان سنًقدّم الطّعام

274
00:16:56,820 --> 00:16:58,240
لذا استمتعن بوقتكن

275
00:16:58,600 --> 00:17:00,110
حسناً

276
00:17:00,630 --> 00:17:03,370
اقترحي نخبًا يا تشينو تشان

277
00:17:17,420 --> 00:17:19,750
أحسنتن عملاً اليوم

278
00:17:20,280 --> 00:17:23,100
نخبكن

279
00:17:23,100 --> 00:17:26,350
عيد ميلاد مجيد

280
00:17:43,770 --> 00:17:47,250
انضمي إلى الحفلة بعد أن تجهزي ذلك الطبق

281
00:17:47,720 --> 00:17:51,990
كلا، طالما أنَّني لا أنظر إلى الطّعام فسأكونُ بخير

282
00:17:53,060 --> 00:17:54,950
هذا مٌدهش

283
00:17:54,950 --> 00:17:57,010
يبدو الطّعامُ لذيذاً

284
00:17:57,610 --> 00:17:59,670
يا لها من وليمة

285
00:17:59,670 --> 00:18:01,710
أنا لستُ أحلم، صحيح؟

286
00:18:01,710 --> 00:18:04,060
حسناً، حان وقت تقطيع الدّيك الرّومي

287
00:18:04,600 --> 00:18:09,060
يستخدم "الإغراء البني المُذَهّب" خاصتنا منكهات سرية خاصة

288
00:18:09,430 --> 00:18:13,530
هل تسمين حتى الديك الرومي في آما أوسا آن؟

289
00:18:14,020 --> 00:18:17,360
سأعدُّ المشروبات لهم بما أنَّهن عملن بجد

290
00:18:17,850 --> 00:18:21,260
هل نستطيعُ فتح الهدايا الّتي تبادلناها الآن؟

291
00:18:21,260 --> 00:18:23,450
لنفتحها معاً جميعًا

292
00:18:23,870 --> 00:18:25,080
...واحد، اثنان

293
00:18:25,650 --> 00:18:28,350
يبدو هذا البسكويت لذيذًا

294
00:18:28,350 --> 00:18:29,940
مِعطفٌ بأذنيّ أرنب

295
00:18:29,940 --> 00:18:31,630
هل سيليقُ بي؟

296
00:18:31,630 --> 00:18:35,030
إنه ذلك الأرنب المخيف

297
00:18:35,030 --> 00:18:36,970
دُميةٌ تقليديّة؟

298
00:18:38,840 --> 00:18:40,420
لا تقرَبي هذا مِنّي

299
00:18:40,420 --> 00:18:44,640
لم أرَ رابت هاوس يضجُّ بالحياةِ هكذا من قبل

300
00:18:45,700 --> 00:18:48,810
...يمكنني سماع اسم سيدي بوضوح

301
00:18:48,810 --> 00:18:49,900
...هذه

302
00:18:51,240 --> 00:18:53,150
ليلةٌ المُعجزات

303
00:19:30,910 --> 00:19:32,690
!الآن سيبدأ الحدث الرئيسي

304
00:19:35,910 --> 00:19:38,410
يجب أن أضع هديّتها بجانب وسادتها

305
00:19:38,410 --> 00:19:39,860
لأنَّني أختها الكبرى

306
00:19:40,710 --> 00:19:44,470
أستطيعُ أن أشعر برغبة تشينو شان بزيارة سانتا لها

307
00:19:44,470 --> 00:19:46,870
سأضعُ هذا الجورب احتياطاً

308
00:20:12,420 --> 00:20:15,810
يبدو أنَّ لدى كوكوا كن ذات الفِكرة

309
00:20:33,610 --> 00:20:34,790
إنَّها مليئة

310
00:20:41,670 --> 00:20:46,180
الأرنب المُحترم والبيت الخشبي

311
00:20:42,230 --> 00:20:46,180
إنَّها الأحجية ثلاثيّة الأبعاد الّتي أردتها وعلبةٌ موسيقيّة ظريفة

312
00:20:47,240 --> 00:20:48,680
وكوكوا سان؟

313
00:21:05,010 --> 00:21:07,450
...عيد ميلاد مجيد

314
00:21:21,460 --> 00:21:24,680
صباحُ الخير

315
00:21:26,040 --> 00:21:28,230
هل هذا...؟

316
00:21:29,270 --> 00:21:32,220
يبدو أنَّ اثنان من السّانتا أتيا إلى غرفتي البارحة

317
00:21:33,180 --> 00:21:34,980
ولدها وكوكوا

318
00:21:35,720 --> 00:21:38,810
ولكن أحدهما بدا مشتت التفكير

319
00:21:39,310 --> 00:21:40,610
مشكلة

320
00:21:41,120 --> 00:21:44,490
استيقظتُ ووجدتُ هديّةً من سانتا في غرفتي

321
00:21:44,890 --> 00:21:46,710
ولمَ أنتِ متفاجئةً هكذا؟

322
00:21:46,710 --> 00:21:48,360
إنَّ تفكيرها مشتت بالفعل

323
00:21:50,240 --> 00:21:52,740
ما الّذي تتكلّمينَ عنه؟

324
00:21:52,740 --> 00:21:55,230
سانتا كلوس ذو تفكير مشتت

325
00:23:28,650 --> 00:23:38,560
في الحلقة القادمة: يمكنني النوم متأخرًا من أجلك

326
00:23:29,520 --> 00:23:33,180
ما رأيكُما أن نستحم سويّاً يوماً ما؟

327
00:23:33,180 --> 00:23:34,360
كلا

328
00:23:34,360 --> 00:23:36,350
كما اعتَدنا أن نفعل

329
00:23:36,350 --> 00:23:37,510
كلا