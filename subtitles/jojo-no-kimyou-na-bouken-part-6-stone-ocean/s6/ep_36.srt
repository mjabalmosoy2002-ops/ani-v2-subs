222
00:13:18,810 --> 00:13:20,060
.إنه يتحرّك

223
00:13:22,850 --> 00:13:25,310
!ولكنه يقترب منّا خفيةً

224
00:13:28,320 --> 00:13:30,570
.هذا سيئ. تحرّكوا

225
00:13:31,320 --> 00:13:34,740
!اهربوا من هنا! هيا

226
00:13:39,120 --> 00:13:41,250
!ستار بلاتينا! زا وارد

227
00:13:50,630 --> 00:13:52,920
!قدرتي على إيقاف الزمن لا تكفي

228
00:13:53,010 --> 00:13:54,300
!هذا سيئ

229
00:13:56,090 --> 00:13:57,890
!تعال يا سيد جوتارو

230
00:14:03,480 --> 00:14:04,350
...أنت

231
00:14:04,850 --> 00:14:06,850
اسمك أنسوي، صح؟ -
.نعم -

232
00:14:07,940 --> 00:14:09,610
.واسم ستاندي دايفر داون

233
00:14:10,190 --> 00:14:12,360
.قدرته الغطسُ في مُختلَف الأجسام

234
00:14:13,440 --> 00:14:14,860
.لنحرس الواجهة الأخرى

235
00:14:14,950 --> 00:14:17,720
هيا، ولكن هل رأيت سرعته تلك؟

236
00:14:17,720 --> 00:14:20,240
.الحراسة وحدها لن تنفع

237
00:14:21,830 --> 00:14:23,290
،بالمناسبة يا سيد جوتارو

238
00:14:24,410 --> 00:14:27,370
.سأبذل كل ما لديّ لحماية ابنتك

239
00:14:27,960 --> 00:14:30,670
،مأزقنا عويص

240
00:14:31,340 --> 00:14:33,300
.ولكني سأحرص على أن ننجو منه

241
00:14:34,420 --> 00:14:37,300
.لذلك فاسمح لي بالزواج بابنتك رجاءً

242
00:14:37,380 --> 00:14:41,260
ماذا قلت؟

243
00:14:41,350 --> 00:14:44,890
.أنا أطلب يد ابنتِك منك

244
00:14:44,980 --> 00:14:47,850
.أرجوك اقبل بزواجي بها يا سيد جوتارو

245
00:14:50,980 --> 00:14:54,900
،أدري أن الوقت غير ملائمٍ إطلاقًا
.ولكن كلمةٌ واحدة منك ستفي بالغرض

246
00:14:55,400 --> 00:15:00,990
،كل ما أريده هو أن تسمح لي
.لا أريد شيئًا بعد ذلك

247
00:15:02,580 --> 00:15:07,500
.فأنا لم أتوقّع قطّ أنها ستقبل بي

248
00:15:08,210 --> 00:15:10,630
،فأنا سفّاحٌ مجرِم

249
00:15:10,710 --> 00:15:14,630
وأدري أن وقوع جولين في حبّي
.شيء مستحيل

250
00:15:15,210 --> 00:15:20,930
،ولكن إرادتها وقلبها القويّين اللذان ورِثتهما عنك

251
00:15:21,010 --> 00:15:23,930
.قد أنارا قلبي ونزعا عنه الظُّلمة

252
00:15:26,430 --> 00:15:29,230
!لقد أنارت قلبي وهو على عتبة الانهيار

253
00:15:29,310 --> 00:15:31,150
.رجاءً، أنا أحتاج موافقتك

254
00:15:31,730 --> 00:15:33,320
.كلمةٌ واحدة تكفي

255
00:15:33,400 --> 00:15:34,520
.قل إنك تسمح بزواجنا

256
00:15:35,110 --> 00:15:37,190
.وحرّر قلبي وروحي رجاءً

257
00:15:37,690 --> 00:15:41,570
اسمح لي بالزواج منها إن خرجنا
.من هذه أحياءً

258
00:15:43,450 --> 00:15:45,040
ما الذي تتحدث عنه؟

259
00:15:45,660 --> 00:15:48,080
هل جُننت من هول ما رأيت أم ماذا؟

260
00:15:50,670 --> 00:15:51,830
،أنسوي

261
00:15:54,800 --> 00:15:56,340
.الأجدر بنا التجمّع

262
00:15:56,420 --> 00:15:59,050
.وأنتم يا رفاق، اقتربوا

263
00:16:01,300 --> 00:16:05,810
.صعودنا إلى هنا وفّر لنا الملجأ، ولكن طُرُق الهرب مسدودة

264
00:16:05,890 --> 00:16:07,850
.فهو يتحرّك بالفعل

265
00:16:09,310 --> 00:16:10,850
.ولكننا لا نستطيع رؤية حركته

266
00:16:11,350 --> 00:16:13,960
،وضعت حاجزًا من خيوطي للآن

267
00:16:13,960 --> 00:16:16,320
.ولكن لا ضمانة أنه سيحمي أحدًا

268
00:16:16,820 --> 00:16:19,820
،ثم أن القسّ ولو أنه حصل على مبتغاه

269
00:16:19,900 --> 00:16:22,610
.فلن يدعنا نفلت بغض النظر

270
00:16:22,700 --> 00:16:25,240
.لأنه يريد القضاء علينا

271
00:16:26,790 --> 00:16:28,290
...يريد

272
00:16:28,370 --> 00:16:32,120
.يريد إنهاء ما بينه وبين آل جوستار

273
00:16:32,210 --> 00:16:34,960
!ولكننا نجهل أدنى شيءٍ عن ستانده

274
00:16:35,040 --> 00:16:37,170
كيف نقاتله إذن؟

275
00:16:37,250 --> 00:16:39,800
!قلها يا سيد جوتارو

276
00:16:48,430 --> 00:16:51,770
.أصغو إليّ يا شباب

277
00:16:51,850 --> 00:16:53,690
،قد يبدو أننا محاصرون

278
00:16:54,270 --> 00:16:56,270
.ولكن الاحتماء بهذا السطح كان الخيار الصحيح

279
00:16:57,270 --> 00:16:59,780
.فقوة القسّ هي تسريع الزمن

280
00:17:00,280 --> 00:17:02,530
.ولو أنه وحده من يستطيع مجاراة تلك السرعة

281
00:17:02,610 --> 00:17:05,160
.فنحن ما زلنا قادرين على رؤيته

282
00:17:05,740 --> 00:17:08,290
،انطلاقًا من سرعة ساعتي

283
00:17:09,040 --> 00:17:13,580
.فالساعةُ تمرّ بسرعة دقيقتين تقريبًا

284
00:17:13,670 --> 00:17:14,750
،بمنعى أنه

285
00:17:14,830 --> 00:17:16,960
،إن كان يركض بسرعة عشرة كيلومترات في الساعة

286
00:17:17,040 --> 00:17:20,300
.فسيبدو لنا أنه يركض بسرعة قطارٍ سريع

287
00:17:21,010 --> 00:17:25,800
أي أننا سنستطيع رؤيته كما نستطيع
.رؤيةَ القطارات السريعة

288
00:17:25,890 --> 00:17:27,390
.لذا فاهدأوا وارتقبوا

289
00:17:27,890 --> 00:17:29,890
.حاولوا رصد حركاته على الأقل

290
00:17:30,390 --> 00:17:32,310
.فإدراكها ممكن

291
00:17:32,390 --> 00:17:34,310
!أسرع منا بستين مرة

292
00:17:34,810 --> 00:17:38,520
ولكن إن كان في سيارة تجري 60كم\س
،فستبدو كأنها تقطع 1800كم\س

293
00:17:39,110 --> 00:17:41,490
!وإن كانت 100كم\س فستبدو 2.4 ماخ

294
00:17:42,070 --> 00:17:43,070
.معك حق

295
00:17:43,150 --> 00:17:47,320
.ولكن القسّ يريد الصعود إلينا خفية

296
00:17:48,030 --> 00:17:52,950
،فهو يعرف أنني أستطيع إيقاف الزمن
.ولو لثوانٍ قليلة

297
00:17:53,040 --> 00:17:55,250
،وهو نفسه لا يعلم

298
00:17:56,290 --> 00:17:58,790
.إلامَ ستحولُ قوّته من الآن وصاعدا

299
00:17:59,380 --> 00:18:03,050
.وهو يريد اكتشاف ذلك

300
00:18:04,930 --> 00:18:07,300
!ستار بلاتينا! زا وارد

301
00:18:17,310 --> 00:18:18,310
أين؟

302
00:18:18,400 --> 00:18:20,070
أين هو؟

303
00:18:20,150 --> 00:18:22,440
.لقد رأيت حركةً تحت الطاولة

304
00:18:22,530 --> 00:18:24,360
.إنه يقترب منا

305
00:18:25,360 --> 00:18:28,070
.أقصى ما أستطيع إيقافه من الزمن هو خمس ثوانٍ

306
00:18:28,570 --> 00:18:32,830
.عليّ أن أجده وأقضي عليه قبل أن تنقضي

307
00:18:33,660 --> 00:18:36,620
يا رجل، أين هو؟

308
00:18:36,710 --> 00:18:39,580
أكنت أتخيّل تلك الحركة وحسب؟

309
00:18:40,290 --> 00:18:41,420
.وصلت إلى حدّي

310
00:18:41,920 --> 00:18:43,130
...سيسترسل الزمن جريه

311
00:18:47,090 --> 00:18:48,390
!فوق النخلة

312
00:18:48,470 --> 00:18:49,800
!كان مختبئًا بين أوراقها

313
00:18:49,890 --> 00:18:50,970
!ماذا؟

314
00:18:51,050 --> 00:18:53,720
!لا يُعقل! هل يُخطط لقذف نفسه إلى هنا؟

315
00:18:53,810 --> 00:18:56,270
!لقد بلغت حدّي! سيسترسل الزمن جريه

316
00:18:56,350 --> 00:18:58,020
!سيقذف نفسه كالقنبلة

317
00:19:05,610 --> 00:19:06,610
!فوقنا

318
00:19:29,260 --> 00:19:30,090
!..أبي

319
00:19:30,680 --> 00:19:31,890
!وراءك يا آنسة

320
00:19:32,470 --> 00:19:33,640
!سيهاجمنا ثانيةً

321
00:19:41,350 --> 00:19:42,310
...أنسوي

322
00:19:44,610 --> 00:19:49,650
...أغطَستَ ستاندك في جسدي

323
00:19:51,620 --> 00:19:54,080
.وتلقّى ضربة القسّ بدلًا عني

324
00:19:54,700 --> 00:19:58,120
.وحماني من ضربةٍ كانت قاضية

325
00:19:58,210 --> 00:19:59,410
...ولكن

326
00:20:14,850 --> 00:20:16,260
.إنها قصيرة جدًا

327
00:20:16,350 --> 00:20:19,270
.لا تكفيني خمسة ثوانٍ إطلاقًا

328
00:20:19,350 --> 00:20:22,230
!ولا أستطيع إيقاف الزمن مرتين متتاليتين

329
00:20:23,230 --> 00:20:26,190
،عندما يوقف ستار بلاتينا الزمن لخمس ثوانٍ

330
00:20:26,980 --> 00:20:31,660
.فلن يستطيع إيقافه إلا بعد مرور هنيهة

331
00:20:32,410 --> 00:20:38,660
.وفرصتي الوحيدة للقضاء عليه هي إن دخل في مدايَ الهجومي

332
00:20:39,200 --> 00:20:43,580
!وإن كان الزمن متوقّفًا فقط

333
00:20:46,000 --> 00:20:47,090
.بلغت حدي

334
00:20:47,590 --> 00:20:49,420
.سيسترسل الزمن

335
00:20:57,560 --> 00:20:59,270
!أبي! أنسوي

336
00:21:10,240 --> 00:21:14,360
.سأبدأ بأنسوي إذن، لا جوتارو

337
00:21:14,450 --> 00:21:16,410
.أقصد في ترتيب القتل

338
00:21:16,490 --> 00:21:18,030
.أصغوا إليّ

339
00:21:18,120 --> 00:21:20,910
،لا شك أن ما يجري يفوق فهمكم القاصر

340
00:21:21,500 --> 00:21:23,670
.ولكن سأبسّطه لكم

341
00:21:24,370 --> 00:21:26,040
.الزمن يتسارع

342
00:21:27,290 --> 00:21:33,010
،وهذه القوة لم أكتسبها لأقتلكم

343
00:21:33,090 --> 00:21:35,840
.ولا لأصير أقوى البشر

344
00:21:37,640 --> 00:21:43,140
بل اكتسبتها لأقود كل من في العالمِ
.إلى السعادة الحقة

345
00:21:43,640 --> 00:21:47,900
،ستاندي الجديد، قوتي الجديدة

346
00:21:48,400 --> 00:21:50,230
...سأسمّيها

347
00:21:50,980 --> 00:21:52,780
!ميد إن هيفن

348
00:22:02,810 --> 00:22:05,020
يـتـبـع