208
00:11:42,190 --> 00:11:44,020
ويذر ريبورت

209
00:11:45,000 --> 00:11:51,510
في الماضي السحيق، عندما ظهرت النباتات فوق الأرض
.ظهر معها الأوكسجين

210
00:11:52,510 --> 00:11:58,100
،في حالة ارتباط ذرة أكسجين مع جزيئة ثنائيّ الأكسجين

211
00:11:58,180 --> 00:12:00,770
.يتكوّن الأوزون، ثلاثيّ الأكسجين

212
00:12:01,270 --> 00:12:07,860
،يغطّي هذا الغاز الأرضَ في طبقة الأوزون
.التي يبلغ ارتفاعها 20 كيلومترًا، وسمكها خمسة كيلومترات

213
00:12:09,030 --> 00:12:12,780
،إن تضررت هذه الطبقة بأي طريقة

214
00:12:12,870 --> 00:12:15,950
فما الذي سيحلّ بالحياة على الأرض؟

215
00:12:16,790 --> 00:12:20,710
.لا يقدر البشر على توقع الظواهر الجوية الشاذة

216
00:12:20,790 --> 00:12:27,000
بل كل ما نقدر عليه هو تحليل الظواهر والمعلومات
.التي جمعناها عبر العصور والاستنتاج منها

217
00:12:32,380 --> 00:12:34,930
.أين هو؟ لا شك أنه أحد هؤلاء

218
00:12:35,010 --> 00:12:36,810
.لا بد أنه في الأرجاء

219
00:12:36,890 --> 00:12:39,640
،سأجده وأنتزع منه القرص انتزاعًا

220
00:12:40,480 --> 00:12:43,060
!قبل أن يسلمه لهذه المؤسسة

221
00:12:44,020 --> 00:12:46,190
،هدفي متّجه إلى المستشفى على الأرجح

222
00:12:46,270 --> 00:12:49,940
!لأنه لن يتخلى عن جولين كوجو في هذا الوضع

223
00:12:50,530 --> 00:12:53,740
.من يجري ناحية المستشفى هو إمبوريو بلا شك

224
00:12:53,820 --> 00:12:56,780
.كل ما عليّ هو البحث عن شخصٍ يجري في طريق المشفى

225
00:12:57,740 --> 00:13:00,540
!تبًّا! لن أخسر هذه

226
00:13:00,620 --> 00:13:03,170
!سأبلغ السعادة الحقة مهما كلفتني

227
00:13:05,580 --> 00:13:08,340
،أريد مساعدتك يا آنسة جولين

228
00:13:08,420 --> 00:13:09,420
...ولكن

229
00:13:10,010 --> 00:13:13,300
!عليّ تسليم القرص إلى مبعوث مؤسسة سبيدواغون بسرعة

230
00:13:14,220 --> 00:13:19,350
.فهذا وعدي معكِ، إيصال القرص إلى بر الأمان

231
00:13:19,430 --> 00:13:23,560
.اتفقت أنا ومبعوث المؤسسة على أن نلتقي بعد خمس دقائق

232
00:13:24,190 --> 00:13:26,100
!اللعنة

233
00:13:26,860 --> 00:13:28,610
!لماذا؟ لماذا؟

234
00:13:28,690 --> 00:13:31,400
!لست أرى أحدًا يتجه إلى المستشفى

235
00:13:31,900 --> 00:13:33,490
.لا شك أنه في هذه الناحية

236
00:13:33,570 --> 00:13:35,950
!بلا شكّ

237
00:13:48,250 --> 00:13:50,170
.مرحبا يا آنسة

238
00:13:51,800 --> 00:13:52,630
ماذا؟

239
00:14:02,930 --> 00:14:04,690
.أمسكت بك

240
00:14:04,770 --> 00:14:08,940
.جدر بي سؤال أندروورد، سؤال الأرض منذ البداية

241
00:14:09,020 --> 00:14:12,610
!فعند الأرض الرقم الذي اتصلت به كوجو جولين

242
00:14:13,190 --> 00:14:18,280
.فقد أعلمها بمقعدي الناجيين عبر الهاتف

243
00:14:18,370 --> 00:14:23,250
.ما يعني أنها تعرف رقم هاتفه

244
00:14:24,160 --> 00:14:26,830
.لم أظنّ أنه طفلٌ كهذا

245
00:14:28,080 --> 00:14:32,090
.حتى القسّ لم يعرف هويته

246
00:14:37,380 --> 00:14:40,350
!ماذا؟ ليس معه القرص

247
00:14:40,970 --> 00:14:44,020
!وليس معه حتى الهاتف الذي كلمني به قبل قليل

248
00:14:44,600 --> 00:14:45,930
!أين وضعه؟

249
00:14:46,690 --> 00:14:48,440
.تمهّل، لا تفزع

250
00:14:48,940 --> 00:14:51,650
.سأكتشف أين خبّأه بسهولة إن استخرجت ذكراه

251
00:14:51,730 --> 00:14:53,110
!وما الذي فعله به

252
00:14:53,730 --> 00:14:55,900
!تبا

253
00:14:55,990 --> 00:14:56,990
!لقد أتيتا

254
00:15:04,750 --> 00:15:07,960
أهو من هنا حقا يا جولين؟ -
.نعم -

255
00:15:08,040 --> 00:15:09,920
.أستشعر حضرته هنا

256
00:15:10,000 --> 00:15:14,090
أليست هذه الطريق التي سلكها إمبوريو؟

257
00:15:15,090 --> 00:15:17,380
!مهلًا. هل يعقل أنه يلاحق إمبوريو؟

258
00:15:17,470 --> 00:15:18,970
.لا يقعل

259
00:15:19,050 --> 00:15:22,640
.فلا هو ولا القسّ يعرفانه

260
00:15:23,930 --> 00:15:26,310
!..ذلك -
!إمبوريو -

261
00:15:31,770 --> 00:15:33,440
!انتبهي. تفاديها

262
00:15:40,820 --> 00:15:42,320
!يا رجل

263
00:15:43,580 --> 00:15:46,790
.هذه الحلازن ليست سرابًا ولا وهمًا

264
00:15:47,500 --> 00:15:50,120
.بل حلازن دبقة وباردة حقيقية

265
00:15:59,050 --> 00:15:59,880
!إرميس

266
00:16:05,260 --> 00:16:07,470
.اسبقيني يا جولين

267
00:16:07,560 --> 00:16:09,270
!أنقذي إمبوريو أولا

268
00:16:09,350 --> 00:16:12,270
.لقد رأيته يُجَرّ من وراء الشجرة

269
00:16:12,350 --> 00:16:15,980
.إنه يستهدف إمبوريو ولو لست أدري هدفه

270
00:16:17,070 --> 00:16:18,490
!ستون فري

271
00:16:22,910 --> 00:16:24,070
.سحقًا

272
00:16:24,160 --> 00:16:27,790
!جسدي وحبلي تثاقلا وصارا كالحلزون

273
00:16:28,870 --> 00:16:30,120
!إمبوريو

274
00:16:30,210 --> 00:16:33,130
!تمسّك بحبلي إن كنت تسمعني

275
00:16:34,380 --> 00:16:36,170
!تشكيلة 40-60

276
00:16:36,750 --> 00:16:37,920
!انطلاق

277
00:16:43,050 --> 00:16:44,510
!جولين

278
00:16:45,510 --> 00:16:47,010
.أنت في فلوريدا

279
00:16:47,100 --> 00:16:49,890
.استخرجت ذكريات من بطولة السوبربول

280
00:16:49,980 --> 00:16:51,480
،كوجو جولين

281
00:16:51,560 --> 00:16:55,110
.سيجرّك الظهير معه حتى الهدف

282
00:16:55,190 --> 00:16:56,360
!..حبلي

283
00:16:56,440 --> 00:16:58,730
.لن تستطيعي فعل شيءٍ لإنقاذ نفسك بجسدك البطيء

284
00:16:58,820 --> 00:17:02,150
.وداعًا، لن تستطيعي العودة إلى هنا

285
00:17:02,330 --> 00:17:05,370
.أحا، كدت أنسى أن عليّ تجنّبها

286
00:17:06,950 --> 00:17:08,410
.كما ظننت

287
00:17:08,490 --> 00:17:12,540
.كان قرص ذكرى جوتارو معه عندما رد على الهاتف

288
00:17:13,080 --> 00:17:16,750
.ولكنه اختفى فجأة بعد ذلك

289
00:17:16,840 --> 00:17:19,250
.لا شك أن ذلك بفعل ستانده

290
00:17:19,340 --> 00:17:23,760
.يبدو أن إخفاء الأشياء واستخراجها هي قدرته

291
00:17:23,840 --> 00:17:26,970
أين أخفى القرص إذن؟

292
00:17:27,050 --> 00:17:28,430
.سأحقق في ذلك ثانية

293
00:17:30,720 --> 00:17:31,600
ماذا؟

294
00:17:32,520 --> 00:17:34,060
!أين جولين؟

295
00:17:34,140 --> 00:17:36,810
.المفترض أن هروبها وجسدها كذلك مستحيل

296
00:17:48,490 --> 00:17:51,200
!لا يعقل! لقد عادت له

297
00:17:51,290 --> 00:17:52,500
!كركبت الأنبوب لتقترب منه

298
00:17:53,080 --> 00:18:00,210
استغلّت جسدها اللزج الرخو ووَلجت
.الأنبوب المحطمّ

299
00:18:02,210 --> 00:18:04,380
!أندروورد

300
00:18:05,590 --> 00:18:07,970
،محاولة جيدة

301
00:18:08,050 --> 00:18:12,600
!ولكنك الآن كالعزلاء أمام قوة أندروورد

302
00:18:14,560 --> 00:18:16,690
...ما استخرجته هو ذكرى

303
00:18:16,770 --> 00:18:19,730
!ذكرى الملح المتروك بعد تبخّر المحيط

304
00:18:20,320 --> 00:18:24,780
!فالحلازن لا تستطيع تحمّل الملح

305
00:18:28,780 --> 00:18:29,950
!ماذا؟

306
00:18:34,960 --> 00:18:36,670
تبّا! أين خبّأه؟

307
00:18:37,290 --> 00:18:40,000
.لا شك أنه ما زال معه

308
00:18:40,090 --> 00:18:41,630
.كل ما في الأمر أنه مخبّأ

309
00:18:41,710 --> 00:18:44,090
.لقد خبّأه في شيء ما

310
00:18:50,470 --> 00:18:54,020
.فهمت الآن، ستانده كستاندي

311
00:18:54,100 --> 00:18:57,850
.فهو يستخرج ذكريات الأغراض

312
00:18:58,480 --> 00:19:00,190
!مرحى

313
00:19:00,270 --> 00:19:02,190
!هذا قرص جوتارو الأصليّ

314
00:19:02,270 --> 00:19:03,650
!إنه لي

315
00:19:03,730 --> 00:19:05,860
!أنا المنتصر

316
00:19:05,940 --> 00:19:08,030
،والآن أخيرًا

317
00:19:08,110 --> 00:19:11,030
!اقتربت خطوةً من هدف القسّ

318
00:19:11,120 --> 00:19:12,990
!جولين

319
00:19:13,790 --> 00:19:15,580
.أعتذر يا إمبوريو

320
00:19:16,080 --> 00:19:18,370
.إذ أني استخدمتك طعمًا

321
00:19:18,870 --> 00:19:20,960
،فقد لمستَني

322
00:19:21,540 --> 00:19:24,250
.وهو لَمَسك

323
00:19:24,340 --> 00:19:27,220
...سيكتشف ذلك الآن... على غفلة

324
00:19:29,760 --> 00:19:32,600
!لا أستطيع التحرك

325
00:19:45,530 --> 00:19:47,990
!ممتاز! الآن تحقق إمساكنا به

326
00:19:48,070 --> 00:19:49,650
!مرحى لك يا جولين

327
00:19:54,410 --> 00:19:55,490
...إمبوريو

328
00:19:58,500 --> 00:19:59,500
.لا

329
00:19:59,580 --> 00:20:04,880
لم يستطع مبعوث مؤسسة سبيدواغون
.دخول المدينة وقعد ينتظرني في طرفها

330
00:20:04,960 --> 00:20:06,130
.هكذا إذن

331
00:20:09,950 --> 00:20:10,800
!ممتاز

332
00:20:10,880 --> 00:20:12,390
.كما المتوقّع من لصّ سيارات خبير

333
00:20:12,470 --> 00:20:14,600
،دعيني أذكّرك

334
00:20:14,680 --> 00:20:17,180
.تهمة سرقة السيارة ملفّقة لا غير

335
00:20:17,270 --> 00:20:18,930
.أمزح أمزح

336
00:20:19,480 --> 00:20:20,980
.لتأتِ معنا

337
00:20:21,600 --> 00:20:24,270
.لا تنوي الهرب أفضل لك

338
00:20:24,360 --> 00:20:26,440
.أدري

339
00:20:32,030 --> 00:20:35,450
أهذه صدفة السائق؟

340
00:20:35,530 --> 00:20:38,160
ولكن لِمَ فارغة؟

341
00:20:40,290 --> 00:20:41,620
.وهنا صدفات فارغة أخرى

342
00:20:42,830 --> 00:20:46,460
.بدأت أستوعب

343
00:20:48,800 --> 00:20:54,930
.لا أدري كيف جعل ويذر البشر يتحولون لحلازن

344
00:20:55,010 --> 00:20:58,560
.ولكني أدري ما الذي ينتظرنا

345
00:20:59,270 --> 00:21:03,100
!ينتظرنا أعداء الحلازن الطبيعيين! قتلة الحلازن

346
00:21:04,520 --> 00:21:06,770
،الحلازن فريسة سهلة مناسبة

347
00:21:06,860 --> 00:21:09,190
.فهي بطيئة الحركة

348
00:21:09,280 --> 00:21:12,780
،تحشر هذه الحشرات رأسها في صدفات الحلازن

349
00:21:12,860 --> 00:21:15,370
!وتأكلها شيئًا فشيئًا

350
00:21:16,070 --> 00:21:18,290
!إنها آكلات الحلازن

351
00:21:18,370 --> 00:21:20,870
!هو اسم هذه الحشرات

352
00:21:27,250 --> 00:21:28,420
!ويذر

353
00:21:28,500 --> 00:21:30,550
!قلت انتظر يا هذا

354
00:21:32,470 --> 00:21:33,880
ما الذي يحدث؟

355
00:21:33,970 --> 00:21:35,840
أأنت من فعل هذا؟

356
00:21:35,930 --> 00:21:39,350
!ماذا الذي فعلت يا ويذر؟

357
00:21:40,470 --> 00:21:43,600
.اصمت يا أنسوي

358
00:21:44,730 --> 00:21:47,650
.إنه يقترب منا

359
00:21:48,770 --> 00:21:51,440
.إنه في حدود عشرين مترًا حولنا

360
00:21:52,280 --> 00:21:54,450
هو؟ هل تقصد القسّ بوتشي؟

361
00:21:55,070 --> 00:21:56,030
.إنه هنا

362
00:21:56,780 --> 00:21:59,370
،هدف حياتي الوحيد

363
00:21:59,450 --> 00:22:01,700
.هو تعديل ما بيننا من حساب

364
00:22:02,730 --> 00:22:04,980
يـتـبـع