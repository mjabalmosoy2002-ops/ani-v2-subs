00:12:20,140 --> 00:12:22,020
ﺎ

211
00:12:20,140 --> 00:12:22,020
ﺷ

212
00:12:20,140 --> 00:12:22,020
ﺮ

213
00:12:20,140 --> 00:12:22,020
ﻟ

214
00:12:20,140 --> 00:12:22,020
ﺍ

215
00:12:20,190 --> 00:12:22,020
ريكيل

216
00:12:22,540 --> 00:12:24,000
،كوجو جولين

217
00:12:24,080 --> 00:12:27,630
.سأبدأ بك ثم أقتل رفيقيك

218
00:12:36,310 --> 00:12:37,720
...أعضاؤنا الداخلية

219
00:12:37,810 --> 00:12:39,600
،ما كان شيء كذلك ليحدث

220
00:12:40,180 --> 00:12:42,140
.إلّا إن هاجم أعضاءنا الداخلية

221
00:12:42,730 --> 00:12:43,850
أعضاؤنا..؟

222
00:12:45,900 --> 00:12:47,070
!..هذا

223
00:12:47,650 --> 00:12:49,400
.بدأ سرّه يتّضح لي

224
00:12:49,900 --> 00:12:51,820
!يا آنسة! الحرارة

225
00:12:51,900 --> 00:12:54,490
!العصيّ تتغذّى على الحرارة

226
00:12:55,490 --> 00:12:58,120
.اكتشفت ذلك لأن البول الدامي يحدث بسبب تضرر الكلي

227
00:12:58,200 --> 00:13:01,410
،وانظري إلى كليتيّ، إحداهما سالمةٌ بفضل تغطية القرص لها

228
00:13:01,500 --> 00:13:05,210
.والأخرى باردة بفعل هجومه السارق للحرارة

229
00:13:06,210 --> 00:13:08,460
،هذا مذكور في كتاب أتذكره

230
00:13:08,550 --> 00:13:11,510
.موضوع في الرف الثاني من المكتبة

231
00:13:12,170 --> 00:13:14,380
،الأعضاء العليلة في الجسد

232
00:13:14,470 --> 00:13:18,060
.هي أبرد من الأعضاء الصحيحة

233
00:13:19,100 --> 00:13:20,970
،أخذ الحرارة من اليد

234
00:13:21,060 --> 00:13:23,980
.يجعل عضلاتها تتقلّص وتتعفن

235
00:13:24,560 --> 00:13:26,690
.وأخذها من الجفن يُغمِضُه

236
00:13:27,270 --> 00:13:29,020
،وأخذها من الكلية

237
00:13:29,110 --> 00:13:30,860
.يسبب البول الدامي

238
00:13:30,940 --> 00:13:31,900
،أي أن العصيّ

239
00:13:31,990 --> 00:13:36,660
.تعيش على أخذ حرارة المخلوقات الأخرى والتغذي عليها

240
00:13:37,240 --> 00:13:39,410
،تفعل ذلك من دون لمسك

241
00:13:39,990 --> 00:13:43,410
.فلا تدري أن حرارتك أُخِذت حتى يطولك الداء

242
00:13:44,000 --> 00:13:46,500
يا طفل، هل أأنت عبقريّ أم ماذا؟

243
00:13:47,460 --> 00:13:49,130
.أنت محقّ

244
00:13:49,210 --> 00:13:52,880
،وأما هجومي عليكم ليس بنية القتل

245
00:13:52,970 --> 00:13:55,590
.بل أردت شلّكم وحسب

246
00:13:56,430 --> 00:13:58,930
!حتى أستطيع تركيز هجومي

247
00:14:00,180 --> 00:14:04,270
.في جسد الإنسان عضوٌ إن أُخِذت حرارته قُتِلَ

248
00:14:04,350 --> 00:14:07,350
.إنه العضو الذي يتحكم في سائر الجسد عند كل الحيوانات

249
00:14:07,940 --> 00:14:09,570
!أقصد جذع الدماغ

250
00:14:09,650 --> 00:14:12,400
.سآخذ الحرارة من رقبتك

251
00:14:12,480 --> 00:14:14,570
!هجوم

252
00:14:14,650 --> 00:14:17,950
!البركة! اغطسي في البركة يا آنسة

253
00:14:18,030 --> 00:14:21,080
.لا لن أفعل، بل هاتني قداحة

254
00:14:21,160 --> 00:14:22,830
.أعطني قداحتك الشبحية

255
00:14:22,910 --> 00:14:23,750
.هيا

256
00:14:32,880 --> 00:14:34,460
!لا يُعقل

257
00:14:35,550 --> 00:14:37,470
.بل معقول

258
00:14:37,550 --> 00:14:39,800
،باعتبار كل ما مررت به حتى الآن

259
00:14:39,890 --> 00:14:42,720
،واعتبار هدفي في ملاحقة القس

260
00:14:42,810 --> 00:14:44,310
.فهذا ليس بالشيء الجلل

261
00:14:46,980 --> 00:14:49,060
!هذه اللعينة

262
00:14:50,400 --> 00:14:54,740
.روحي أقوى من هذه الفاشلة

263
00:14:58,820 --> 00:15:00,120
أين؟

264
00:15:01,160 --> 00:15:02,080
أين أصوب؟

265
00:15:03,290 --> 00:15:06,250
!أي عضوٍ أهاجمُ حتى أقتلها؟

266
00:15:12,420 --> 00:15:13,670
!فَعَلَتها

267
00:15:14,300 --> 00:15:15,550
...وحمة نجمية

268
00:15:15,630 --> 00:15:17,130
،لا أدري من تكون

269
00:15:17,220 --> 00:15:19,380
،ولكن يبدو لي أن أسلخك ضربًا

270
00:15:19,470 --> 00:15:22,260
.وأجعلك تخبرني بمكان القسّ وبكلّ ما يجري

271
00:15:23,600 --> 00:15:27,230
.تذكروا عرق أبيكم

272
00:15:27,890 --> 00:15:29,520
.نعم، لقد وُلِدت مجددا

273
00:15:36,070 --> 00:15:36,900
،نعم

274
00:15:37,490 --> 00:15:42,990
.لا أعرف أي عضوٍ أسلّط عليه العصيّ بعد أن غطّيت جسدك بالنار

275
00:15:43,080 --> 00:15:48,960
.ولكني سأكتشف ذلك إن فعلت الشيء نفسه

276
00:15:49,670 --> 00:15:51,790
،سأستطيع اكتشاف نقطة ضعفك

277
00:15:51,880 --> 00:15:54,170
.بتجربتي وشعوري بذاتي

278
00:15:55,800 --> 00:15:58,470
.روحي هي أبولو 11

279
00:15:58,550 --> 00:16:02,010
!سوف أتخطى روحك يا كوجو جولين

280
00:16:05,350 --> 00:16:07,850
!اقتليه بسرعة يا جولين

281
00:16:15,820 --> 00:16:17,070
!ماذا تفعلين؟

282
00:16:17,150 --> 00:16:19,490
!إنه خلفك

283
00:16:20,740 --> 00:16:23,950
.لن تستطيعي رؤيتي الآن

284
00:16:25,120 --> 00:16:29,200
.فقد علمت نقطة ضعفٍ بتجربتي

285
00:16:29,290 --> 00:16:33,420
!إنه فمك الذي تفتحينه لتتنفسي

286
00:16:34,840 --> 00:16:38,840
،ففيه يوجد المهاد البصري، وهو الجزء الناقل لما ترين إلى الدماغ

287
00:16:38,920 --> 00:16:40,630
.يوجد مباشرة فوق فكك العلوي

288
00:16:40,720 --> 00:16:43,430
،أدخلت عصيّي إلى فمك

289
00:16:43,510 --> 00:16:45,140
.وأخذت منه الحرارة

290
00:16:46,180 --> 00:16:48,430
.بذلك أضرَرْتُ بمهادك البصريّ

291
00:16:48,520 --> 00:16:52,060
!لن تستطيعي رؤيتي الآن

292
00:16:53,350 --> 00:16:57,650
!أنا المنتصر! لن أفزع بعد اليوم

293
00:16:58,150 --> 00:17:01,360
!سوف أستردّ زمام حياتي

294
00:17:02,110 --> 00:17:04,820
!أنا أبولو 11 نفسها

295
00:17:05,870 --> 00:17:07,120
.إذن فلن أحاول رؤيتك

296
00:17:07,870 --> 00:17:10,870
،وبما أنك تهاجم فمي

297
00:17:10,950 --> 00:17:12,330
.فلن أتنفس أيضا

298
00:17:16,880 --> 00:17:19,500
،عندما هاجم ريكيل الحوامة

299
00:17:20,420 --> 00:17:23,760
،شعرت به كما شعرت بالصبي الأخضر

300
00:17:23,840 --> 00:17:27,050
.وكما استشعر القسّ أنني هربت من السجن

301
00:17:30,470 --> 00:17:32,640
.سأكتشف من تكونون

302
00:17:33,230 --> 00:17:35,440
...ثم سأجعلكم تخبرونني

303
00:17:35,940 --> 00:17:36,860
.بخطة القسّ

304
00:17:45,070 --> 00:17:47,370
.لم أظن عزمها بهذه القوة

305
00:17:47,950 --> 00:17:50,870
...عزمها هذا على قتل القس

306
00:17:50,950 --> 00:17:55,080
.إنه إرادةٌ ورثتها عن أبيها كوجو جوتارو

307
00:17:55,170 --> 00:17:58,540
!تكاد تكون امرأة مختلفة عمّن كانت يوم دخولها السجن

308
00:18:03,090 --> 00:18:05,090
.لقد خسر

309
00:18:05,180 --> 00:18:11,010
.ولكنني أنا من سيعين القسّ على بلوغ الجنة

310
00:18:11,600 --> 00:18:14,770
.لقد أخذت كل حرارتي بالفعل بعصيّي

311
00:18:15,520 --> 00:18:19,520
.أي أني قطعت الأعصاب في دماغي وجسدي

312
00:18:19,610 --> 00:18:23,150
.لن أتألّم الآن ولن أشعر بالضرر

313
00:18:23,240 --> 00:18:25,070
.لن أسقط إلّا ميِّتًا

314
00:18:26,200 --> 00:18:28,120
.هاجميني الآن

315
00:18:28,950 --> 00:18:31,620
هل ستهزمينني بسرعة؟

316
00:18:31,700 --> 00:18:35,080
أم هل ستنهي العصيّ أمرك قبل ذلك؟

317
00:18:36,120 --> 00:18:41,800
!لقد أخمدت نار رقبتك بالفعل

318
00:18:44,420 --> 00:18:46,090
!سأقتل أمك الآن

319
00:18:47,340 --> 00:18:50,140
!هيا يا عصيّ

320
00:18:50,220 --> 00:18:51,220
!يا آنسة

321
00:19:01,150 --> 00:19:03,110
!جولين

322
00:19:03,190 --> 00:19:04,280
!يا آنسة

323
00:19:11,120 --> 00:19:13,160
!ماذا؟

324
00:19:13,910 --> 00:19:15,120
.تبًا

325
00:19:15,200 --> 00:19:19,790
...أخمدت النار من على رقبتها لكي آخذ حرارتها

326
00:19:20,380 --> 00:19:23,210
...ولكن يدي... سحقًا

327
00:19:23,300 --> 00:19:25,130
...يدي تشنّجت

328
00:19:25,210 --> 00:19:29,430
!فأعاقت أصابعي العصيّ عن قتلها

329
00:19:31,390 --> 00:19:33,050
.تبا

330
00:19:35,930 --> 00:19:37,120
!يا آنسة

331
00:19:37,120 --> 00:19:39,140
!فعلتها جولين

332
00:19:40,480 --> 00:19:45,940
أخبريني، هل تركتِ يدي على رقبتكِ عمدًا؟

333
00:19:46,440 --> 00:19:48,820
أم أكان ذلك صدفة وحسب؟

334
00:19:49,400 --> 00:19:50,780
.لقد كان صدفة

335
00:19:50,860 --> 00:19:52,120
.ما كنت لأنجو لولا الصدفة

336
00:19:53,240 --> 00:19:57,160
.هذا هو الجواب الذي أردته منك

337
00:19:57,750 --> 00:19:58,910
ولكن أأنت تقولين الحقيقة؟

338
00:19:59,500 --> 00:20:01,000
من أنت؟

339
00:20:01,710 --> 00:20:03,840
لِمَ تجمّعتُم حول القسّ؟

340
00:20:04,840 --> 00:20:08,170
.أصغي إلي، لقد رضيتُ الآن

341
00:20:09,130 --> 00:20:11,680
.ففي الماضي لم أقدر حتى على القيادة

342
00:20:12,180 --> 00:20:15,100
.والآن ما عاد نَفَسي يضيقُ

343
00:20:16,680 --> 00:20:20,770
.فقد ملأ القسّ الفراغ في قلبي

344
00:20:20,850 --> 00:20:24,020
.ولذلك سأفديه بروحي

345
00:20:25,400 --> 00:20:32,070
.إرادة رجلٍ يدعى ديو تجري في عروق القسّ الآن

346
00:20:32,740 --> 00:20:37,620
.وهي تجلب أبناءه إلى القسّ

347
00:20:38,700 --> 00:20:44,170
.ما نحن إلّا بيادقُ وضعها القدر في طريق القسّ لتعاونه على بلوغ الجنة

348
00:20:45,170 --> 00:20:46,800
،وأنت يا جولين

349
00:20:46,880 --> 00:20:49,050
.أنت مثلنا أيضًا

350
00:20:49,550 --> 00:20:53,510
.ما مطاردتك للقسّ إلا مساعدةٌ له

351
00:20:53,590 --> 00:20:55,760
.الآنَ فهمت ذلك

352
00:20:56,300 --> 00:20:58,470
.قلتِ أنك ما كنتِ لتنجي

353
00:20:59,270 --> 00:21:03,600
،وأن ضربك لي من دون أن تُزيلي يدي عن عنقك

354
00:21:03,690 --> 00:21:05,480
.ما كان إلا صدفةً

355
00:21:06,190 --> 00:21:08,650
.النصر ليس هو المهم

356
00:21:08,730 --> 00:21:11,150
.الآن استوعبت ذلك

357
00:21:12,360 --> 00:21:15,870
.فالقسّ يحتاج الصدفة كتلك

358
00:21:16,700 --> 00:21:18,870
.إنه يريد الصُّدَفَ التي حالفَتْكِ اليوم

359
00:21:18,950 --> 00:21:20,450
!تلك هي ما سينفعه

360
00:21:21,160 --> 00:21:25,540
.قدرُكِ أعظم من أقدارنا مجتمعةً

361
00:21:26,630 --> 00:21:27,460
أيحتاجني القس؟

362
00:21:27,540 --> 00:21:29,380
أم يحتاجك أنت؟

363
00:21:29,460 --> 00:21:33,760
.الجواب أنه يحتاج ذا القدر العظيم، أيًا يكون

364
00:21:34,340 --> 00:21:36,930
،فأعظم القوى في الكون

365
00:21:37,010 --> 00:21:39,760
.لا تأتي عن وعيٍ وحساب

366
00:21:41,020 --> 00:21:43,350
.بل هي مقدرة مسبقًا

367
00:21:44,560 --> 00:21:46,810
.وذلك الرجل قدره فريدٌ أيضًا

368
00:21:46,900 --> 00:21:50,110
،ولذلك هو وحده من أخذ القسّ ذاكرته

369
00:21:50,650 --> 00:21:53,490
.وتركه يحيا في داخل السجن

370
00:21:55,240 --> 00:21:56,910
.أقصد ويذر ريبورت

371
00:21:58,530 --> 00:22:01,660
،إن هرب من السجن

372
00:22:01,750 --> 00:22:04,330
،فهروبه ليس ليتبعك

373
00:22:05,210 --> 00:22:08,960
.بل ليحمل قدره العظيم ويعاوِن القسّ

374
00:22:09,590 --> 00:22:12,960
،عندما ظهرت الوحمة النجمية على كتف القسّ

375
00:22:13,550 --> 00:22:17,680
.فلا بد أنها ظهرت على كتف ويذر كذلك

376
00:22:20,060 --> 00:22:23,140
.فهو أخو القسّ الأصغر في الحقيقة

377
00:22:25,520 --> 00:22:28,940
.لا تصغي لهذا الملعون

378
00:22:29,560 --> 00:22:34,440
.قاتِلُ أُختي هو سبورتس ماكس الذي أحيا عظم ديو

379
00:22:34,530 --> 00:22:36,680
أموتها مساعدة مقدّرةٌ للقسّ أيضًا؟

380
00:22:36,680 --> 00:22:38,030
!كلّا

381
00:22:38,110 --> 00:22:40,280
.ما خُلِق القسّ إلّا لأقتله

382
00:22:40,990 --> 00:22:43,040
.هيا بنا إلى أورلاندو

383
00:22:43,120 --> 00:22:45,000
أليس القسّ هناك؟

384
00:22:47,620 --> 00:22:52,090
أكان إبقاء جولين لِيَد ريكيل على رقبتها صدفة بحق؟

385
00:22:52,170 --> 00:22:54,670
أم أكان عمدًا؟

386
00:22:55,380 --> 00:22:59,300
.لم تخبرنا الآنسة جولين بشيءٍ عن ذلك

387
00:22:55,740 --> 00:23:00,720
[ريكيل]
[اسم الستاند [سكاي هاي
لا أمل في شفائه

388
00:23:00,720 --> 00:23:02,720
بقي على المحاق التالي أربعة أيام

389
00:23:04,100 --> 00:23:06,520
،في قانون فلوريدا الطّرقيّ

390
00:23:06,600 --> 00:23:12,570
.سائقوا الدراجات النارية ليسوا مجبرين على ارتداء الخوذ

391
00:23:12,650 --> 00:23:16,070
،أي أن حقّ السائق الشخصيّ في عدم ارتدائها

392
00:23:16,150 --> 00:23:20,070
.فوقَ واجبه على حماية نفسه من الموت والعاهات الناتجة عن الحوادث

393
00:23:20,820 --> 00:23:23,240
.وحتى أولئك أحرار

394
00:23:24,120 --> 00:23:25,950
،لم يحكمهم أحدٌ في الماضي

395
00:23:27,000 --> 00:23:29,080
.ولا ينبغي أن يحكمهم أحد في المستقبل

396
00:23:27,600 --> 00:23:32,460
[العصّ الحية] حرة طليقة

397
00:23:32,020 --> 00:23:35,030
يـتـبـع