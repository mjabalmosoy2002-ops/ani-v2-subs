1
00:00:02,740 --> 00:00:06,940
هلّا أخبرتني عن السّبب يا ساوتومي؟

2
00:00:07,300 --> 00:00:10,770
سأذهب للعمل كمُساعدة لإيفانجيلين بارتون

3
00:00:10,770 --> 00:00:13,780
سلّمتُ إشعاراً للمدرسة بأنّني
سوف أنسحب بشكل مؤقّت

4
00:00:14,050 --> 00:00:17,820
هل غولف إيف لافت إلى هذا الحدّ؟

5
00:00:18,100 --> 00:00:18,950
أجل

6
00:00:19,660 --> 00:00:22,380
!يستحقّ المُراهنة عليه بحياتي

7
00:00:23,420 --> 00:00:26,520
حسناً. أقبل طلب انسحابكِ

8
00:00:26,840 --> 00:00:29,680
هل يمكنكِ التكلّم بأيّ لغة أجنبيّة؟

9
00:00:30,050 --> 00:00:32,940
لطالما افترضتُ أنّني سأكون مُساعدة
،في الجولات الأمريكيّة

10
00:00:32,940 --> 00:00:35,340
لذا كنتُ أحضر دروس لغة إنجليزيّة لسنوات

11
00:00:35,650 --> 00:00:38,660
،أعلم بأنّه لم يمضِ على وجودي هنا طويلاً
لكن شكراً لك على كلّ شيء

12
00:00:38,660 --> 00:00:39,910
وداعاً

13
00:00:44,770 --> 00:00:46,510
طلب انسحاب

14
00:00:47,720 --> 00:00:51,960
نحن مَدينون لها بهذا القدر، أليس كذلك يا سيرا؟

15
00:00:54,430 --> 00:00:55,720
ساوتومي

16
00:00:56,520 --> 00:00:59,830
هل صحيح أنّكِ أخبرتِ المدرسة بأنّكِ ستغادرين؟

17
00:01:00,150 --> 00:01:01,990
أجل، صحيح

18
00:01:01,990 --> 00:01:03,870
أماواشي

19
00:01:03,870 --> 00:01:06,090
أعطتني إيف رسالة لأجلكِ

20
00:01:06,560 --> 00:01:07,830
إيف؟

21
00:01:08,340 --> 00:01:09,840
"...إنّه سباق"

22
00:01:11,450 --> 00:01:16,300
!إنّه سباق لرؤية من يصبح محترفاً أوّلاً يا أوي

23
00:02:49,460 --> 00:02:52,060
كانت مكافأتك على الفوز في المُباراة هي الدّعم

24
00:02:52,060 --> 00:02:54,650
لجعلك لاعبة غولف محترفة في أسرع وقت، صحيح؟

25
00:02:55,030 --> 00:02:55,780
أجل

26
00:02:56,060 --> 00:02:57,980
سأمنحكِ فُرصة إذاً

27
00:02:57,980 --> 00:03:00,100
لكن فُرصة واحدة فقط

28
00:03:00,100 --> 00:03:01,200
هذا كلُّ ما أحتاجه

29
00:03:04,080 --> 00:03:06,620
اسمي تشارلوت، من طاقم آريوس

30
00:03:06,620 --> 00:03:10,710
،ستشاركين في بطولة أوروبّا المفتوحة للنساء

31
00:03:10,710 --> 00:03:13,720
والّتي ستُقام بعد شهرين باسمنا

32
00:03:14,150 --> 00:03:17,420
بالطبع، الظّفر بالبطولة هو أمر إلزاميّ

33
00:03:17,880 --> 00:03:22,520
إلى ذلك لالحين، سوف ندفع نفقات تمرينك وإقامتك

34
00:03:22,780 --> 00:03:28,190
ستستخدمين عِصيّ وملابس وأحذية آريوس

35
00:03:28,480 --> 00:03:35,560
إذا أصبحتِ محترفة، فسوف نطلب منكِ
أن تصبحي لاعبة غولف تابعة لآريوس

36
00:03:35,940 --> 00:03:37,450
هل هذا مقبول؟

37
00:03:37,450 --> 00:03:39,450
أجل، لا مانع

38
00:03:40,010 --> 00:03:43,460
لكن أوّلاً، ثمّة أمر عليكِ فعله

39
00:03:44,030 --> 00:03:44,870
ما هو؟

40
00:03:45,140 --> 00:03:47,140
مدام كاترين

41
00:03:47,980 --> 00:03:50,500
تريدكِ ميّتة حسبما قيل لي

42
00:03:54,360 --> 00:03:56,960
تعرف الرّواية برمّتها إذاً

43
00:03:56,960 --> 00:04:02,180
يمكن لعائلة بارتون أن تضغط عليها
لتدعكِ وشأنكِ

44
00:04:02,500 --> 00:04:05,500
لكن لا نملك سبباً يدفعنا للقيام بذلك

45
00:04:05,770 --> 00:04:09,300
هذه مشكلتكِ. حُلّيها بنفسكِ

46
00:04:09,310 --> 00:04:11,520
سأعطيكِ على الأقلّ طريقة لفعل ذلك

47
00:04:11,740 --> 00:04:14,640
وماذا عليّ أن أفعل إذاً؟

48
00:04:14,860 --> 00:04:18,220
هناك شيء وحيد تبرعين فيه: الغولف

49
00:04:19,780 --> 00:04:23,070
تواصلنا مع المدام كاترين بصورة سرّية للغاية

50
00:04:23,070 --> 00:04:30,050
،وعدتْ أنّكِ إذا فزتِ في مُباراة غولف
سوف تدعكِ وشأنكِ

51
00:04:30,660 --> 00:04:32,380
...لكن إذا خسرتِ

52
00:04:33,750 --> 00:04:37,880
هل أنتِ مستعدّة للمخاطرة بحياتكِ
لأجل مُجرّد مُباراة غولف؟

53
00:04:37,880 --> 00:04:39,330
هذا سؤال سخيف

54
00:04:39,330 --> 00:04:41,240
كنتُ أفعل ذلك طوال حياتي

55
00:04:42,860 --> 00:04:45,190
مدام، لديكِ ضيفة

56
00:04:45,190 --> 00:04:47,260
أدخلها

57
00:04:47,630 --> 00:04:48,940
أمركِ

58
00:05:02,730 --> 00:05:04,100
من هنا

59
00:05:04,100 --> 00:05:10,060
يا إلهي. شكراً على قدومكِ إلى
هنا يا آنسة ريميلدا

60
00:05:10,060 --> 00:05:12,710
هذا من دواعي سروري يا مدام كاترين

61
00:05:12,900 --> 00:05:15,820
هل يمكنني أن أفترض بأنّكِ هنا

62
00:05:15,820 --> 00:05:19,660
لأنّكِ ترغبين في المشاركة في المُباراة
كما طلبتُ منكِ؟

63
00:05:19,960 --> 00:05:26,090
مليون يورو لمُباراة واحدة؟ كيف لي أن أرفض؟

64
00:05:26,090 --> 00:05:31,520
لكن ضدّ من سألعب حتّى تنفقين كلّ هذا المال؟

65
00:05:31,880 --> 00:05:34,830
فتاة صغيرة عمرها حوالي 15

66
00:05:34,830 --> 00:05:38,780
سافلة أهانَتْني

67
00:05:39,030 --> 00:05:44,280
!أنا مستعدّة لدفع أكثر من مليون يورو لهزيمتها حتّى

68
00:05:44,500 --> 00:05:46,490
حسناً

69
00:05:46,820 --> 00:05:50,930
يسرّني أن أساهم في إخماد إحباطكِ

70
00:05:55,400 --> 00:05:57,960
كيف سارت الأمور يا عزيزي؟

71
00:05:58,300 --> 00:06:01,410
،طلبتُ من رجالي التحرّي حول ما تخطّط له كاترين

72
00:06:01,680 --> 00:06:04,300
وحصلتُ على صورة لن تصدّقيها

73
00:06:04,760 --> 00:06:07,560
!أهذه ريميلدا؟

74
00:06:07,560 --> 00:06:12,040
أجل، أحضرت العجوز الشّمطاء خصماً فظيعاً

75
00:06:12,700 --> 00:06:14,300
إنّها حسناء

76
00:06:14,480 --> 00:06:16,310
حسناً، ما مشكلتها؟

77
00:06:17,000 --> 00:06:22,420
ريميلدا هي أفضل لاعبة غولف أمريكيّة
في العالم الإجراميّ

78
00:06:22,420 --> 00:06:25,690
تلعب في أمريكا، في العالم الإجرامي وأمام العامّة

79
00:06:25,690 --> 00:06:29,860
إذاً إنّها اللّاعبة الأقوى في عالم المجرمين

80
00:06:29,860 --> 00:06:32,180
إيف، اسمعي

81
00:06:32,180 --> 00:06:33,950
—عليكِ إلغاء هذا

82
00:06:33,950 --> 00:06:35,930
لا أستطيع فعل ذلك

83
00:06:36,520 --> 00:06:39,560
لم أرَها وهي تلعب من قبل

84
00:06:39,560 --> 00:06:41,560
لا أستطيع مساعدتكِ في هزيمتها

85
00:06:41,560 --> 00:06:43,710
يمكنني أن أدع رجالي يراقبونها

86
00:06:43,710 --> 00:06:45,340
لستُ بحاجة ذلك

87
00:06:45,340 --> 00:06:48,200
المُباراة اللّيلة

88
00:06:48,200 --> 00:06:50,420
!ا-اللّيلة؟

89
00:06:50,640 --> 00:06:51,600
أجل

90
00:06:51,600 --> 00:06:53,310
هيّا بنا

91
00:06:53,310 --> 00:06:54,710
هيّا؟

92
00:06:55,110 --> 00:06:56,230
إلى أين؟

93
00:06:56,240 --> 00:06:59,480
لإحضار مساعدتي

94
00:07:04,640 --> 00:07:07,940
...لم أدرك أنّ مدّة رحلة الطيران هي 12 ساعة

95
00:07:07,940 --> 00:07:10,020
مؤخّرتي تؤلمني

96
00:07:10,020 --> 00:07:11,220
!القزمة

97
00:07:11,830 --> 00:07:13,220
!هنا

98
00:07:13,220 --> 00:07:15,630
!بسرعة

99
00:07:16,160 --> 00:07:21,040
!إيف! إيف، فعلتُها

100
00:07:21,040 --> 00:07:27,380
مُساعدتكِ الشخصيّة قد تخلّت عن كلّ
!شيء لديها لتكون معكِ

101
00:07:28,080 --> 00:07:30,540
لدينا مُباراة اللّيلة

102
00:07:30,540 --> 00:07:33,560
!هذا قريب جدّاً

103
00:07:34,660 --> 00:07:37,520
ماذا تقصدين باللّيلة؟

104
00:07:37,520 --> 00:07:38,970
ما الملعب؟

105
00:07:39,370 --> 00:07:43,720
حفظتُ كلّ ما يمكن حفظه حول ملاعب هذا البلد

106
00:07:43,720 --> 00:07:46,290
يمكننا الحديث عن الأمر عندما نصل إلى هناك

107
00:07:46,290 --> 00:07:47,510
نحن جاهزتان

108
00:07:50,190 --> 00:07:53,160
مـ-من هذان الشّخصان؟

109
00:07:53,160 --> 00:07:55,570
يبدوان مُخيفين

110
00:07:55,570 --> 00:07:59,000
...لا يبدوان مُواطنين شريفين

111
00:07:59,000 --> 00:08:01,960
هذه مُساعدتي الشخصيّة

112
00:08:01,960 --> 00:08:04,630
اسمها هو... ذكّريني به؟

113
00:08:04,630 --> 00:08:07,200
!إتشينا! إتشينا ساوتومي

114
00:08:07,200 --> 00:08:09,640
كيف لكِ ألّا تتذكّري اسمي؟

115
00:08:09,640 --> 00:08:12,970
!مُساعدتكِ في المدرسة الابتدائيّة

116
00:08:13,340 --> 00:08:17,110
!عمري 16! أنا فتاة ثانويّة جميلة

117
00:08:17,500 --> 00:08:19,030
!أنتِ في الثّانويّة؟

118
00:08:19,030 --> 00:08:21,720
!اليابانيّون لا يمكن تحديد عمرهم حقّاً

119
00:08:21,720 --> 00:08:25,470
هذه المرأة الأفعى وحبيبها. إنّهما يساعدانني

120
00:08:25,470 --> 00:08:29,240
!فيبير! احفظي اسمي فحسب

121
00:08:29,870 --> 00:08:32,490
...لا تتغيّر إيف أينما ذهبت

122
00:08:33,000 --> 00:08:34,990
هل يمكنكما إيصالي؟

123
00:08:35,250 --> 00:08:38,160
تريدني كاترين ميّتة أيضاً

124
00:08:38,440 --> 00:08:40,690
إذا ربحتُ، سنتخلّص من ذلك

125
00:08:40,910 --> 00:08:43,490
!إذا خسرتِ، سأموت أيضاً

126
00:08:43,820 --> 00:08:46,400
سأوصلكِ في طريقي فحسب، اتّفقنا؟

127
00:08:44,650 --> 00:08:48,750
...يـ-يتحدّثان عن شيء مُخيف

128
00:08:56,620 --> 00:08:58,140
لن تغادري؟

129
00:08:58,420 --> 00:09:00,380
سأنتظر ساعتين

130
00:09:00,380 --> 00:09:03,890
أتعتقدين أنّها قادرة على هزيمة ريميلدا حقّاً؟

131
00:09:03,890 --> 00:09:07,140
،إيف... تلك المتغطرسة الحمقاء الوقحة

132
00:09:07,140 --> 00:09:09,710
،الّتي لا تفكّر سوى بنفسها

133
00:09:09,710 --> 00:09:12,820
أحضرت مُساعدتها كلّ المسافة
من اليابان لأجل هذه المباراة

134
00:09:13,270 --> 00:09:15,290
لا بدّ أنّها تعتقد بأنّها تستطيع الفوز

135
00:09:19,920 --> 00:09:23,860
إ-إيف، نحن على وشك أن نلعب الغولف، صحيح؟

136
00:09:23,860 --> 00:09:24,860
أجل، لماذا؟

137
00:09:25,140 --> 00:09:27,540
أين الملعب؟

138
00:09:27,540 --> 00:09:28,500
تحت الأرض

139
00:09:28,500 --> 00:09:30,120
!تحت الأرض؟

140
00:09:32,120 --> 00:09:35,460
إيف، هل لعبتِ هنا من قبل؟

141
00:09:35,460 --> 00:09:36,720
أجل، مرّتان

142
00:09:37,120 --> 00:09:39,520
...أ-أعرف أنّ هذا سؤال سخيف، لكن

143
00:09:39,520 --> 00:09:42,180
هذه ليست مُباراة عاديّة، أليس كذلك؟

144
00:09:42,180 --> 00:09:43,560
أجل، ليست كذلك

145
00:09:44,370 --> 00:09:46,700
!لم تخبريني بذلك أبداً

146
00:09:46,700 --> 00:09:49,560
!سأعود إلى المنزل! سأعود إلى اليابان

147
00:09:49,560 --> 00:09:52,340
إذا ربحتُ هذه، سأحظى بفُرصة لأصبح محترفة

148
00:09:52,990 --> 00:09:54,280
حقّاً؟

149
00:09:54,280 --> 00:09:56,970
لذا أريد الفوز مهما كلّف الأمر

150
00:09:56,970 --> 00:10:01,400
عـ-على ماذا تراهنين في هذه المُباراة بالمناسبة؟

151
00:10:01,730 --> 00:10:03,800
على حياتي

152
00:10:04,910 --> 00:10:05,840
...إ-إيف

153
00:10:05,840 --> 00:10:06,740
هيّا بنا

154
00:10:07,280 --> 00:10:08,590
!إيف

155
00:10:15,430 --> 00:10:17,790
ما-ما هذا المكان؟

156
00:10:17,790 --> 00:10:19,720
وصلتُما

157
00:10:22,970 --> 00:10:25,350
...السّاقطة الصّغيرة

158
00:10:25,790 --> 00:10:29,870
إذا غضبتِ زيادة عن اللّزوم، ستزداد
التّجاعيد في وجهكِ أكثر

159
00:10:29,870 --> 00:10:31,710
!أيّتها المرأة العجوز، العجوز

160
00:10:32,120 --> 00:10:35,770
!لم يكن عليكِ تكرارها مرّتين

161
00:10:37,720 --> 00:10:40,200
!النّجدة! النّجدة

162
00:10:40,200 --> 00:10:46,080
أيّ شخص يسخر منّي... أيّ شخص
!يسخر من المافيا... يدفع ثمن ذلك

163
00:10:46,250 --> 00:10:49,080
مثلما فعلت روز آليون

164
00:10:50,470 --> 00:10:55,040
وبالطبع سيعني ذلك التعمّق أكثر مع المافيا

165
00:10:55,410 --> 00:10:58,330
عميق لدرجة لن تخرجي أبداً

166
00:11:00,440 --> 00:11:07,120
أيّ شخص يفتعل شجاراً معي
يدفع ثمن ذلك أيّتها المرأة العجوز

167
00:11:07,560 --> 00:11:10,400
!أيّتها الصّغيرة

168
00:11:12,370 --> 00:11:15,390
حافظي على رباطة جأشكِ رجاء يا مدام كاترين

169
00:11:15,390 --> 00:11:17,920
لم يكن هذا اتّفاقنا

170
00:11:18,800 --> 00:11:20,280
أعلم ذلك

171
00:11:21,400 --> 00:11:25,120
أنا هنا كمُمثّل عن عائلة بارتون

172
00:11:25,440 --> 00:11:27,860
العصيّ الخاصّة بكِ بحوزتي

173
00:11:27,860 --> 00:11:28,880
شكراً

174
00:11:29,200 --> 00:11:31,580
أتمنّى لكِ حظّاً طيّباً في مُباراتكِ

175
00:11:31,580 --> 00:11:33,920
سأربح بالمهارة

176
00:11:36,830 --> 00:11:38,200
أنا آسفة

177
00:11:38,200 --> 00:11:39,880
أظنّني تأخّرت

178
00:11:40,800 --> 00:11:42,970
لا، لا عليكِ

179
00:11:43,420 --> 00:11:46,340
أنتِ خصمي اليوم إذاً؟

180
00:11:46,610 --> 00:11:49,550
أجل. إيفانجيلين بارتون

181
00:11:49,550 --> 00:11:51,240
اسمي ريميلدا

182
00:11:51,240 --> 00:11:55,030
لا أملك شيئاً ضدّكِ، لكن هذا عمل

183
00:11:55,550 --> 00:11:59,790
ولا أملك شيئاً ضدّكِ أيضاً، لكن
سوف أخترقكِ برصاصتي

184
00:11:59,790 --> 00:12:01,080
تخترقينني؟

185
00:12:01,760 --> 00:12:05,080
برصاص قوس قزح الخاص بي

186
00:12:05,450 --> 00:12:07,610
...رصاص قوس قزح

187
00:12:08,610 --> 00:12:09,600
...مستحيل

188
00:12:09,920 --> 00:12:12,500
هل تعلّمتِ من ليو ميلّافودين؟

189
00:12:12,500 --> 00:12:14,210
لثلاث سنوات فقط

190
00:12:16,320 --> 00:12:19,860
آنسة كاترين، أريدكِ أن تُضاعفي لي أجري

191
00:12:19,860 --> 00:12:21,670
ما الأمر؟

192
00:12:21,910 --> 00:12:24,620
إنّها خصم قويّ جدير بذلك

193
00:12:24,620 --> 00:12:27,180
يجب ألّا تستهيني بها

194
00:12:27,540 --> 00:12:30,010
فهمت يا آنسة ريميلدا

195
00:12:30,010 --> 00:12:31,750
شكراً لكِ

196
00:12:31,750 --> 00:12:36,600
بهذا القدر الكبير من المال، أنا
مستعدّة لاستخدام سلاحي السرّي

197
00:12:36,600 --> 00:12:37,840
سلاحكِ السرّي؟

198
00:12:37,840 --> 00:12:39,590
سترين عندما نصبح في الملعب

199
00:12:39,590 --> 00:12:41,120
سأفعل بكلّ تأكيد

200
00:12:41,390 --> 00:12:44,280
إنّها مُباراة من حفرة واحدة، طريقة المُنافسة

201
00:12:44,610 --> 00:12:48,240
إذا تعادلت كلتا اللّاعبتين، تنتقلان لشوط إضافي

202
00:12:48,240 --> 00:12:50,240
هل من اعتراض؟

203
00:12:50,240 --> 00:12:51,050
لا

204
00:12:51,050 --> 00:12:51,780
لا مانع

205
00:12:52,000 --> 00:12:54,160
لكن أريد استخدام مُساعدتي

206
00:12:55,840 --> 00:12:57,580
...لن أسمح

207
00:12:57,580 --> 00:12:58,700
!لا مانع

208
00:12:58,700 --> 00:13:00,100
آنسة ريميلدا؟

209
00:13:00,100 --> 00:13:01,550
سأربح في كلتا الحالتين

210
00:13:03,320 --> 00:13:05,480
آسفة، لكن تعالي والعبي معي

211
00:13:05,730 --> 00:13:09,850
لا تقلقي. حتّى لو خسرتُ، أنا
الوحيدة الّتي سوف تموت

212
00:13:10,600 --> 00:13:12,020
...لن نخسر

213
00:13:12,020 --> 00:13:15,200
...حتّى نلعب في الدّوري الرّئيسي معاً

214
00:13:15,730 --> 00:13:21,470
!سأكون مُساعدتكِ في الغولف، لا بل في حياتكِ

215
00:13:44,430 --> 00:13:47,350
!ما-ما هذا؟

216
00:13:47,350 --> 00:13:50,140
!كـ-كم كلّف هذا؟

217
00:13:50,140 --> 00:13:52,430
لم يكن لدى المرأة العجوز شيء
أفضل تُنفق مالها عليه

218
00:13:52,680 --> 00:13:54,440
!أستطيع سماعكِ

219
00:13:54,650 --> 00:13:58,440
!آنسة ريميلدا، ضعي حدّاً لهذا من الحفرة الأولى

220
00:14:01,000 --> 00:14:03,720
لا تُغضبي راعيتي كثيراً

221
00:14:03,720 --> 00:14:04,720
نقش

222
00:14:04,720 --> 00:14:06,040
طرة

223
00:14:07,080 --> 00:14:08,480
سألعب أوّلاً

224
00:14:11,010 --> 00:14:14,780
حفرة قصيرة بحفر رمليّة تحيط بحيّز الحفرة

225
00:14:17,690 --> 00:14:19,790
...رياح خفيفة

226
00:14:29,480 --> 00:14:32,680
!ماذا تفعلين؟

227
00:14:32,680 --> 00:14:34,320
!كفى إضاعة للوقت

228
00:14:34,320 --> 00:14:37,980
!لماذا أحضرتك إلى هنا برأيك؟

229
00:14:38,810 --> 00:14:44,230
يبدو أنّ هذه السيّدة لا تعرف
الآنسة ريميلدا جيّداً

230
00:14:45,200 --> 00:14:47,050
هذه فُرصتنا يا إيف

231
00:14:47,050 --> 00:14:48,860
لا يمكنني أن أجزم

232
00:14:52,840 --> 00:14:55,530
لم تكن ضربة خاطئة

233
00:14:56,220 --> 00:14:58,290
كيف ستلعب؟

234
00:14:58,880 --> 00:15:02,190
!بصرف النّظر، سألعب بأسلوبي الخاص في الغولف

235
00:15:03,100 --> 00:15:04,710
...رصاصة

236
00:15:05,080 --> 00:15:07,000
!السّماء الحمراء

237
00:15:15,880 --> 00:15:17,440
!ادخلي الهدف

238
00:15:25,510 --> 00:15:26,690
!أخفقت

239
00:15:27,140 --> 00:15:29,870
!شتّتني أسلوبها في الغولف

240
00:15:31,300 --> 00:15:34,460
تبدأ الغولف خاصّتي من هنا

241
00:15:42,930 --> 00:15:47,340
!أنا في خطر محدق

242
00:15:47,340 --> 00:15:52,280
،إذا لم أستطع الخروج من الحفرة الرمليّة
فإنّ خسارتي شبه مؤكّدة

243
00:15:53,460 --> 00:15:55,360
...لكن هذه

244
00:15:57,050 --> 00:15:59,350
!هذه الخطوة الأولى تجاه نصري فحسب

245
00:16:08,190 --> 00:16:12,490
!طـ-طائر

246
00:16:12,830 --> 00:16:15,080
والآن إيف هي من في ورطة

247
00:16:17,490 --> 00:16:19,530
...هـ-هذا

248
00:16:20,160 --> 00:16:21,500
فعلَتْ ذلك عمداً

249
00:16:21,500 --> 00:16:23,600
،كانت تعلم بأنّها ستتعافى

250
00:16:23,600 --> 00:16:25,250
إذاً تعمّدت وضع نفسها

251
00:16:25,250 --> 00:16:28,370
في الحفرة الرمليّة وذلك كي تنثر الرّمل
على خطّ الضّرب الخفيف الخاصّ بي

252
00:16:30,620 --> 00:16:32,950
...لن يكون تنظيفها مخالفاً للقوانين

253
00:16:32,950 --> 00:16:33,900
كلّا

254
00:16:34,440 --> 00:16:36,170
هذا فخّ

255
00:16:36,170 --> 00:16:37,130
فخّ؟

256
00:16:37,130 --> 00:16:40,620
،عندما سدّدتْ ريميلدا من الحفرة الرمليّة

257
00:16:40,620 --> 00:16:42,060
،لستُ متأكّدة

258
00:16:42,060 --> 00:16:45,690
لكن أعتقد بأنّني رأيتُها تنشر بعض
المسحوق على الأرض

259
00:16:45,910 --> 00:16:48,930
لعلّه حجر صابون زلِق

260
00:16:49,880 --> 00:16:53,280
إذا أبعدتِ الرّمل، فسوف ينتشر
الصّابون في كلّ مكان

261
00:16:53,640 --> 00:16:55,790
كان ليختلف الأمر لو كان بوسعكِ
،توجيه ضربة تمرينيّة

262
00:16:56,050 --> 00:16:58,880
لكن لا أستطيع قراءة الخطّ هكذا

263
00:16:59,690 --> 00:17:03,920
تركّزتْ استراتيجيّتها برمّتها على التّظاهر
،بأنّها ارتكبت خطأ

264
00:17:03,920 --> 00:17:06,940
ثمّ إفساد خطّ ضربنا الخفيف

265
00:17:06,940 --> 00:17:10,880
هذه خدعة بسيطة جدّاً بالنسبة لأفضل
لاعبة غولف في أمريكا

266
00:17:11,200 --> 00:17:14,200
إنّها تفلح على الأشخاص الّذين
لم يروا ذلك من قبل

267
00:17:14,200 --> 00:17:17,560
كادت تنال منكِ، أليس كذلك؟

268
00:17:17,560 --> 00:17:19,270
حسناً، ما الخطّة إذاً؟

269
00:17:19,660 --> 00:17:22,210
كلّ ما عليكِ هو ضربها بشكل مستقيم لإدخالها

270
00:17:22,590 --> 00:17:24,500
انسي الخطّ

271
00:17:24,500 --> 00:17:26,970
اضربيها بشكل مستقيم وستكونين بخير

272
00:17:26,970 --> 00:17:30,320
مُساعدتي مُلِحّة للغاية

273
00:17:30,620 --> 00:17:32,670
تستطيع مُحترفة فعلها

274
00:17:32,670 --> 00:17:36,420
لا، تستطيع أوي أماواشي فعلها

275
00:17:36,420 --> 00:17:38,110
هل تقولين لي أنّكِ لا تستطيعين؟

276
00:17:38,310 --> 00:17:39,680
أيّتها الطفلة

277
00:17:39,680 --> 00:17:41,400
ستندمين على هذه المُلاحظة لاحقاً

278
00:17:41,400 --> 00:17:45,120
كيف لكِ أن تقولي هذا حتّى بعد عدم
إخباري ماذا كانت طبيعة هذه المُباراة؟

279
00:17:45,120 --> 00:17:46,960
كلّ ما عليّ هو إدخالها فحسب، صحيح؟

280
00:17:47,260 --> 00:17:50,580
سأخبركِ بالزاوية وكم من قوّتكِ عليكِ أن تستخدمي

281
00:17:51,100 --> 00:17:53,590
كشفتْ فخّي؟

282
00:17:53,840 --> 00:17:56,800
من تلكما الفتاتان؟

283
00:17:56,800 --> 00:17:58,770
ما هذا؟

284
00:18:00,900 --> 00:18:02,790
إنّها تخيّب أملي

285
00:18:02,790 --> 00:18:04,460
أنفقتُ المال على التّذكرة هنا

286
00:18:04,900 --> 00:18:06,850
أهذا كلّ ما لديكِ؟

287
00:18:07,300 --> 00:18:10,220
أنتِ بعيدة كلّ البُعد عن مستواها

288
00:18:10,580 --> 00:18:13,270
أهدرتُ الوقت بقطعي كلّ المسافة إلى أمريكا

289
00:18:13,560 --> 00:18:15,830
يا لها من مضيعة كاملة لوقتي

290
00:18:15,830 --> 00:18:18,070
الغولف خاصّتكِ كذبة

291
00:18:18,070 --> 00:18:20,330
لا تستحقّ حتّى أن تُدعى غولف

292
00:18:21,000 --> 00:18:25,800
ذات يوم، غولف كهذا... سيُباد بواسطة الغولف الحقيقيّ

293
00:18:26,560 --> 00:18:29,630
الزّاوية 48 درجة. القوّة 3

294
00:18:29,630 --> 00:18:30,790
عُلِم

295
00:18:39,320 --> 00:18:41,320
هل انتهيتِ من خدعكِ السحريّة؟

296
00:18:41,320 --> 00:18:43,960
سوف ننهي الأمر بالحفرة التّالية

297
00:18:43,960 --> 00:18:45,800
بدأتُ أجوع

298
00:18:47,190 --> 00:18:49,460
جهّزوا الحفرة الثّانية

299
00:18:49,460 --> 00:18:50,720
!حـ-حاضر

300
00:18:59,580 --> 00:19:01,330
بُحيرة؟

301
00:19:01,640 --> 00:19:04,600
!لا يمكن أن أكون في خطر هنا

302
00:19:10,680 --> 00:19:13,450
يمكنني التّصويب نحو الرّاية بضربتي الثّانية

303
00:19:19,210 --> 00:19:22,890
لم تري كلّ ألواني السّبعة، صحيح؟

304
00:19:23,700 --> 00:19:27,210
راقبي هذا يا آنسة مساعدة شخصيّة

305
00:19:28,080 --> 00:19:30,430
أفضل ما لديّ مختلف

306
00:19:30,430 --> 00:19:32,200
إنّه أبعد بكثير

307
00:19:32,560 --> 00:19:33,980
...هذا لا يكفي

308
00:19:34,960 --> 00:19:38,040
لا أستطيع لعِب الغولف بالطريقة الّتي أريد هنا

309
00:19:38,880 --> 00:19:42,280
...ليس في هذا المكان المليء بالمال والجشع

310
00:19:42,620 --> 00:19:45,870
أريد أن ألعب الغولف حيث يمكننا
...وضع كلّ ما لدينا على المحكّ

311
00:19:45,870 --> 00:19:48,700
غولف تفجّر عقلي

312
00:19:49,160 --> 00:19:51,190
معها، يمكنني فعلها

313
00:19:52,130 --> 00:19:55,720
لكن... لا يوجد شيء هنا لأجلي إطلاقاً

314
00:19:55,720 --> 00:19:58,460
أليس كذلك يا إتشينا؟

315
00:19:58,460 --> 00:19:59,870
هذا صحيح

316
00:19:59,870 --> 00:20:01,390
هذا المكان مُملّ

317
00:20:01,390 --> 00:20:04,640
لكن إذا أصبحتِ مُحترفة، يمكنكِ
فعل ذلك في أيّ وقت تريدين

318
00:20:04,970 --> 00:20:08,280
...الغولف الّتي تُريدينها والّتي تجعلكِ ترتجفين

319
00:20:08,280 --> 00:20:09,930
!والّتي تفجّر عقلكِ

320
00:20:11,230 --> 00:20:13,590
...رصاصة تنّين الماء

321
00:20:13,590 --> 00:20:16,560
!الزرقاء النيليّة

322
00:20:22,680 --> 00:20:24,820
إنّها متّجهة بشكل مستقيم نحو الماء

323
00:20:24,820 --> 00:20:25,910
لا

324
00:20:26,140 --> 00:20:27,670
...هذه

325
00:20:29,490 --> 00:20:33,050
!اقفزي

326
00:20:44,680 --> 00:20:47,090
أنتِ في ورطة فعلاً الآن

327
00:20:47,100 --> 00:20:50,300
لمَ لا تنثرين مزيداً من الرّمل والمسحوق؟

328
00:20:50,300 --> 00:20:52,720
لم تنتهِ المباراة بعد

329
00:20:52,720 --> 00:20:54,110
بلى

330
00:20:54,440 --> 00:20:57,680
لا تستطيع الغولف خاصّتكِ هزيمتي

331
00:20:57,680 --> 00:21:02,110
لن أخسر أمام شخص لا يلعب بشكل فعليّ

332
00:22:12,540 --> 00:22:14,070
...الجوّ حارّ هنا

333
00:22:22,190 --> 00:22:25,440
ما رأيكِ؟ هذه هي قوّتي الحقيقيّة

334
00:22:25,670 --> 00:22:27,880
،لو لَعِبَتْ هكذا منذ البداية

335
00:22:27,880 --> 00:22:29,750
لكانت مُباراة جميلة

336
00:22:30,060 --> 00:22:31,540
سوف نستخدم ذاك

337
00:22:31,770 --> 00:22:33,100
ذاك، صحيح؟

338
00:22:33,100 --> 00:22:34,540
اقرئي الخطّ لأجلي

339
00:22:37,410 --> 00:22:41,210
بعد الرّاية بـ 5 أمتار، بقدر 3 حفر نحو اليمين

340
00:22:44,050 --> 00:22:46,490
أنتِ الّتي في ورطة الآن

341
00:22:48,730 --> 00:22:51,470
لن ألعب غولف مُزيّفة بعد الآن

342
00:22:51,470 --> 00:22:53,470
هذه هي المرّة الأخيرة

343
00:22:53,960 --> 00:22:56,230
...حرّريها... أطلقيها

344
00:22:56,780 --> 00:22:58,920
!رصاصة قوس قزح

345
00:23:00,040 --> 00:23:04,510
!ما... ما هذا؟

346
00:23:07,630 --> 00:23:10,070
الغولف خاصّتكِ كذبة

347
00:23:10,450 --> 00:23:12,770
لا تستحقّ حتّى أن تُدعى غولف

348
00:23:13,610 --> 00:23:15,660
...ذات يوم، غولف كهذا

349
00:23:22,360 --> 00:23:25,280
سيُباد بواسطة الغولف الحقيقيّ

350
00:23:27,300 --> 00:23:28,930
...دعيني ألعب

351
00:23:34,440 --> 00:23:38,120
!دعيني ألعب الغولف الحقيقيّ

352
00:23:40,610 --> 00:23:44,200
تكسب أوي أجنحة جديدة، الأجنحة السّاطعة

353
00:23:44,200 --> 00:23:47,650
...الحلقة القادمة، إنّها تسافر بأجنحتها السّاطعة

354
00:23:47,650 --> 00:23:49,990
!تجاه المستقبل، وتجاه الغد