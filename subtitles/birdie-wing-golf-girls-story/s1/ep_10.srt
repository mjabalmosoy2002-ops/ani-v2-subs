1
00:00:01,550 --> 00:00:05,990
،رايو هي مدرسة تحضيريّة شهيرة جدّاً

2
00:00:05,990 --> 00:00:08,970
لكنّها شهيرة تحديداً بنادي الغولف لديها

3
00:00:09,280 --> 00:00:11,980
ربح 13 بطولة في آخر 3 سنوات

4
00:00:14,560 --> 00:00:17,230
،بدعم شركة أثينا العالميّة المالي

5
00:00:17,230 --> 00:00:20,620
توفّر تشكيلة واسعة من المنشآت وكذلك مسكناً خاصّاً

6
00:00:20,620 --> 00:00:24,590
لذا يأتي لاعبو غولف موهوبون من كلّ
أنحاء البلد إلى هنا

7
00:00:26,580 --> 00:00:27,680
أنتِ

8
00:00:28,460 --> 00:00:29,790
ماذا؟

9
00:00:29,790 --> 00:00:31,600
من هُنّ؟

10
00:00:31,860 --> 00:00:34,020
يراودهن فضول تجاهكِ

11
00:00:34,020 --> 00:00:36,300
،أنتِ أوّل تلميذة تبادل تأتي إلينا

12
00:00:36,300 --> 00:00:40,460
وفتاة مُثيرة ونحيلة وشقراء. وهذا ما يزيد الأمر سوءاً

13
00:00:41,880 --> 00:00:44,720
!توقّفن عن التحديق بي! هذا ليس استعراضاً

14
00:00:46,820 --> 00:00:50,730
لا ينبغي أن تُعادي الآخرين هكذا

15
00:00:50,730 --> 00:00:53,240
وأيضاً لباسكِ التحتيّ ظاهر

16
00:00:53,240 --> 00:00:57,730
لا يمكننا السّماح لتلميذة منتقلة
بالالتحاق من دون امتحان

17
00:00:58,120 --> 00:01:00,740
!نحن بحاجة لها

18
00:01:00,740 --> 00:01:05,200
للفوز بالبطولة المزدوجة الخاصّة
بمدارس الغولف اليابانيّة للإناث

19
00:01:06,240 --> 00:01:08,670
أثينا، الرّاعي الرئيسي لمدرستنا

20
00:01:08,670 --> 00:01:12,150
!ومن يدير البطولة، بحاجة لنا للفوز

21
00:02:49,100 --> 00:02:50,620
...هـ-هذا

22
00:02:50,620 --> 00:02:52,010
!تلميذة التبادل

23
00:02:52,010 --> 00:02:53,880
!أوي أماواشي

24
00:02:54,840 --> 00:02:55,860
...أنتِ

25
00:02:56,740 --> 00:02:57,360
—لنلعب

26
00:02:57,360 --> 00:03:00,820
كيف كان يومكِ الأوّل يا إيف؟

27
00:03:02,680 --> 00:03:04,410
!انسي ذلك! لنلعب

28
00:03:04,840 --> 00:03:08,910
،أنتِ من قال بأنّني إذا التحقتُ بهذه المدرسة
!يمكنني اللّعب معكِ متى أردت

29
00:03:09,300 --> 00:03:12,290
!انتظرتُ اليوم كلّه! لنلعب الآن

30
00:03:12,750 --> 00:03:18,510
قطعتُ كلّ المسافة إلى اليابان لألعب
!معكِ، بما أنّكِ أردتِ أن تلعبي

31
00:03:19,940 --> 00:03:22,420
إيف، هل أنتِ منزعجة؟

32
00:03:22,420 --> 00:03:24,680
!أنا منزعجة جدّاً

33
00:03:26,040 --> 00:03:29,560
...أتمنّى أن ألعب أيضاً، لكن

34
00:03:29,810 --> 00:03:32,600
آسفة. لدى أوي مباراة تمرينيّة

35
00:03:32,600 --> 00:03:34,520
إنّها متوجّهة إلى مُحافظة أخرى

36
00:03:35,500 --> 00:03:37,530
!إذاً خذيني معكِ

37
00:03:37,530 --> 00:03:40,120
!يمكننا حسم هذه المسألة هناك

38
00:03:40,120 --> 00:03:41,690
...وسنرى من لاعبة الغولف الأفضل

39
00:03:41,690 --> 00:03:45,600
مستحيل. لستِ جزءاً من نادي الغولف

40
00:03:46,020 --> 00:03:47,160
هيّا بنا يا أوي

41
00:03:47,860 --> 00:03:49,430
آسفة يا إيف

42
00:03:49,430 --> 00:03:51,580
يمكننا أن نلعب عندما أعود

43
00:03:51,850 --> 00:03:55,310
ما رأيكِ أن تنضمّي لنادي الغولف؟

44
00:03:55,310 --> 00:03:57,380
يمكننا أن نلعب كثيراً حينها

45
00:03:58,740 --> 00:04:01,000
ما مشكلتها؟

46
00:04:02,440 --> 00:04:03,770
ما الّذي تحدّقن به؟

47
00:04:03,770 --> 00:04:06,340
!آسفة

48
00:04:06,830 --> 00:04:08,040
!إنّها مجنونة

49
00:04:08,040 --> 00:04:10,290
!مجنونة حقيقيّة

50
00:04:11,530 --> 00:04:15,840
أوي، لماذا أحضرتها إلى المدرسة؟

51
00:04:15,840 --> 00:04:18,490
والطلب منها الانضمام لنادي الغولف أيضاً؟

52
00:04:18,490 --> 00:04:21,820
كي أكون معها للأبد بالطبع

53
00:04:21,820 --> 00:04:24,840
أريد أن ألعب الغولف معها بقيّة حياتي

54
00:04:24,840 --> 00:04:25,990
...هذا لا يعني

55
00:04:28,660 --> 00:04:30,070
أنا بحاجة لها

56
00:04:30,720 --> 00:04:32,240
الغولف خاصّتي بحاجة لها

57
00:04:34,120 --> 00:04:35,480
...أوي

58
00:04:37,560 --> 00:04:40,360
بدأت بلعب الغولف في سنّ 13

59
00:04:40,360 --> 00:04:43,250
إنّها في 15 الآن ولم تخسر في أيّ مباراة

60
00:04:43,640 --> 00:04:48,010
أنا متأكّدة بأنّ ذلك سيختلف قليلاً
عندما تلتحق بالمدرسة الثانويّة

61
00:04:48,010 --> 00:04:51,430
لكن ما تريده أكثر من أيّ شيء آخر

62
00:04:52,190 --> 00:04:55,720
هو شخص مكافئ لها

63
00:04:56,080 --> 00:04:57,400
منافس

64
00:05:03,080 --> 00:05:05,440
تريدين الانضمام لنادي الغولف؟

65
00:05:05,440 --> 00:05:07,950
...إيفانجيلين ف. كيميشيما

66
00:05:08,230 --> 00:05:09,890
نادِني إيف فحسب. إنّه أقصر

67
00:05:09,890 --> 00:05:11,400
صوني لسانكِ

68
00:05:11,820 --> 00:05:14,790
وبالطبع نرحّب بأيّ شخص يمتلك موهبة

69
00:05:15,020 --> 00:05:17,960
نقصد بموهبة حقيقيّة

70
00:05:17,960 --> 00:05:19,910
أتريد خوض مباراة إذاً؟

71
00:05:19,910 --> 00:05:20,880
!انتبهي لكلامكِ

72
00:05:21,080 --> 00:05:24,100
ما كنتِ لتحظي بفرصة

73
00:05:24,440 --> 00:05:25,760
أوتظن بأنّك أفضل منّي؟

74
00:05:25,760 --> 00:05:27,760
أجل، أظنّ ذلك

75
00:05:28,940 --> 00:05:31,020
!إيف، هذا يكفي

76
00:05:31,020 --> 00:05:32,030
!دعيني

77
00:05:32,030 --> 00:05:34,260
استيقظتُ في هذا الصّباح وترتّب
،عليّ ارتداء هذا الزيّ الغريب

78
00:05:34,260 --> 00:05:38,060
وحضور هذه الدروس الغريبة وتحديق الجميع بي

79
00:05:38,060 --> 00:05:39,890
!أنا منزعجة

80
00:05:39,890 --> 00:05:41,900
!لن تتمكّني من الانضمام للفريق

81
00:05:41,900 --> 00:05:46,080
!لا أبالي! أنا هنا فقط لألعب مع أوي

82
00:05:48,070 --> 00:05:50,190
إلى أين ذهبت أوي؟

83
00:05:50,190 --> 00:05:51,790
أتظنّينني سأخبرك؟

84
00:06:04,910 --> 00:06:06,430
!إيف

85
00:06:06,870 --> 00:06:09,930
ما مشكلة الجميع هنا؟

86
00:06:10,920 --> 00:06:13,260
هل أنت متأكّد من هذا يا مدرّب؟

87
00:06:13,260 --> 00:06:14,180
بخصوص ماذا؟

88
00:06:16,930 --> 00:06:21,500
ظننتُ بأنّك كنت ستدعها تلعب بدلاً منّي

89
00:06:21,500 --> 00:06:23,040
تلعب إلى جانب أماواشي في

90
00:06:23,040 --> 00:06:26,200
البطولة المزدوجة لمدارس الغولف
الثانويّة اليابانيّة للإناث

91
00:06:26,200 --> 00:06:29,070
سأدعها وشأنها في الوقت الرّاهن

92
00:06:29,810 --> 00:06:30,790
لماذا؟

93
00:06:31,340 --> 00:06:35,270
لا جدوى من مُلاعبة شخص لا يريد النّزال

94
00:06:35,270 --> 00:06:38,460
لا تقلقي. حصدتُ البذور

95
00:06:39,790 --> 00:06:40,840
!هيّا بنا

96
00:06:40,850 --> 00:06:43,050
لنذهب ونحصل على بعض الطعام

97
00:06:41,760 --> 00:06:43,290
!إيف

98
00:06:43,290 --> 00:06:46,250
إيف، إلى أين أنتِ ذاهبة؟

99
00:06:46,520 --> 00:06:47,800
!دعيني وشأني

100
00:06:47,800 --> 00:06:50,370
اهدئي

101
00:06:50,370 --> 00:06:53,540
حالما تنضمّين لنادي الغولف، يمكنك
الذهاب إلى المسكن

102
00:06:53,540 --> 00:06:55,540
وستحصلين على ثلاث وجبات في اليوم

103
00:06:55,780 --> 00:06:58,360
إيف، لا مكان لكِ تذهبين إليه، صحيح؟

104
00:06:58,360 --> 00:07:04,940
أعتقد بأنّ الانضمام لنادي الغولف
...هو أفضل خياراتكِ

105
00:07:05,080 --> 00:07:06,200
إلى أين ينبغي أن نذهب؟

106
00:07:06,200 --> 00:07:06,920
مرحباً

107
00:07:07,930 --> 00:07:09,150
ما اسمكما؟

108
00:07:09,610 --> 00:07:12,030
كيكو موكاي

109
00:07:12,030 --> 00:07:14,910
أكيمي ساكوي

110
00:07:15,130 --> 00:07:20,620
وصلتُ إلى اليابان للتو ولا أعرف ما يجري هنا

111
00:07:20,620 --> 00:07:23,840
هل يمكنكما أن تخبراني ما الأشياء المُسلّية هنا؟

112
00:07:23,930 --> 00:07:25,290
...حـ-حسناً

113
00:07:25,290 --> 00:07:26,880
بـ-بكلّ سرور

114
00:07:27,470 --> 00:07:28,920
!شكراً

115
00:07:30,440 --> 00:07:33,250
المعذرة، أنتِ إيفانجيلين، صحيح؟

116
00:07:33,250 --> 00:07:34,440
طالبة التّبادل

117
00:07:34,440 --> 00:07:35,720
نادياني إيف فحسب

118
00:07:35,720 --> 00:07:37,140
!حـ-حسناً

119
00:07:39,560 --> 00:07:41,140
...زيرة نساء

120
00:07:41,140 --> 00:07:43,420
!زيرة نساء ومجنونة

121
00:07:53,240 --> 00:07:54,410
!هكذا إذاً

122
00:07:54,410 --> 00:07:55,290
!أجل

123
00:08:46,030 --> 00:08:47,750
عليّ العودة إلى المنزل

124
00:08:48,080 --> 00:08:50,220
...يُفرَض عليّ حظر تجوّل أيضاً

125
00:08:50,220 --> 00:08:51,550
حظر تجوّل؟

126
00:08:51,550 --> 00:08:56,420
يريد والدايّ أن أعود إلى المنزل في ساعة معيّنة

127
00:08:56,710 --> 00:08:58,480
هذا هو حظر التجوّل

128
00:08:58,480 --> 00:09:01,310
،إن لم تعودي قبل هذه السّاعة
...سيغضب والداكِ منكِ

129
00:09:01,310 --> 00:09:02,260
آسفة

130
00:09:02,480 --> 00:09:03,900
هكذا إذاً

131
00:09:03,900 --> 00:09:06,190
آسفة لإبقائكما حتّى وقت متأخّر في الخارج

132
00:09:06,450 --> 00:09:08,480
!لا، تسلّينا

133
00:09:08,480 --> 00:09:10,190
!شكراً على الحيوان المحشو

134
00:09:10,690 --> 00:09:13,000
هل تعرفين كيف نصل إلى المنزل؟

135
00:09:13,760 --> 00:09:15,200
سأكون بخير

136
00:09:15,200 --> 00:09:17,640
!لنخرج معاً ثانية يا إيف

137
00:09:17,640 --> 00:09:19,160
!وداعاً

138
00:09:22,830 --> 00:09:25,740
يريدان عودتكما إلى المنزل؟

139
00:09:26,050 --> 00:09:28,120
ألا يُفرض عليكِ حظر تجوّل؟

140
00:09:31,210 --> 00:09:33,740
...هناك حظر في المسكن الدّراسي

141
00:09:33,740 --> 00:09:36,440
لكنّنا تجاوزناه منذ فترة طويلة

142
00:09:36,440 --> 00:09:38,170
سيوبّخوننا

143
00:09:39,210 --> 00:09:41,180
لماذا تراقبينني؟

144
00:09:41,530 --> 00:09:44,170
لأنّني أريد أن أكون مساعدتكِ كلاعبة غولف

145
00:09:44,170 --> 00:09:45,430
لماذا؟

146
00:09:45,430 --> 00:09:48,340
أريد أن أكون مساعدة غولف محترفة

147
00:09:48,720 --> 00:09:52,170
لذا أريد أن أشكّل ثنائيّاً مع الأفضل

148
00:09:52,860 --> 00:09:57,930
،معكِ، أظنّنا نستطيع أن نحلّ في... لا بل

149
00:09:57,930 --> 00:10:00,580
نربح البطولة المُزدوجة لمدارس الغولف
الثانويّة اليابانيّة للإناث

150
00:10:01,020 --> 00:10:04,840
،إذا أردتِ أن تكوني مُساعدة بهذا الإلحاح
فلمَ لا تطلبين من أوي أماواشي؟

151
00:10:05,180 --> 00:10:10,320
حصلتْ على مساعدة سلفاً. شينجو هي مساعدتها

152
00:10:12,020 --> 00:10:12,860
هل يمكنني أن أفوز؟

153
00:10:15,050 --> 00:10:18,250
إذا شكّلتُ ثنائيّاً معكِ، هل يمكنني
هزيمة أوي أماواشي؟

154
00:10:18,250 --> 00:10:20,930
...فـ-في الواقع

155
00:10:22,070 --> 00:10:23,080
!يمكنك

156
00:10:23,080 --> 00:10:24,980
!يمكننا أن نفوز

157
00:10:25,320 --> 00:10:28,760
إذاً عندما ألعب مع أوي، كوني مساعدتي

158
00:10:30,640 --> 00:10:32,570
!حسناً! سأفعل

159
00:10:32,570 --> 00:10:35,860
هل سمعتُ ما أعتقد بأنّني سمعتُه؟

160
00:10:36,950 --> 00:10:40,240
سوف تهزمين أوي أماواشي؟

161
00:10:40,240 --> 00:10:43,070
هل أنتِ جادّة؟

162
00:10:43,480 --> 00:10:45,070
من تكونين؟

163
00:10:45,070 --> 00:10:47,040
...إيسيشيبا

164
00:10:47,320 --> 00:10:49,320
كويو إيسيشيبا

165
00:10:49,320 --> 00:10:52,470
تلميذة سنة ثانية في نادي الغولف
لثانويّة شيزوكا كوران للإناث

166
00:10:52,470 --> 00:10:54,920
إنّها لاعبة نظاميّة في البطولة الوطنيّ

167
00:10:54,920 --> 00:10:56,990
شكراً على التّعريف

168
00:10:56,990 --> 00:11:00,100
لكن هل أنا مشهورة إلى هذا لحدّ؟

169
00:11:00,420 --> 00:11:04,650
أحفظ أسماء كلّ اللّاعبين في البطولة الوطنيّة

170
00:11:04,650 --> 00:11:06,130
ومن تكونين أنتِ؟

171
00:11:06,130 --> 00:11:10,100
أنا إتشينا ساوتومي، طالبة سنة أولى
من نادي رايو للغولف

172
00:11:10,100 --> 00:11:10,640
...وهذه

173
00:11:10,640 --> 00:11:12,160
لا داعي لتخبريها

174
00:11:12,640 --> 00:11:15,980
لا أعرّف عن اسمي إلّا لأشخاص يحمّسونني

175
00:11:17,210 --> 00:11:18,890
وأنا لا أحمّسكِ

176
00:11:20,360 --> 00:11:23,060
لماذا تُعادين الجميع؟

177
00:11:23,060 --> 00:11:25,530
قد لا تكون من مدرستنا، لكنّها أكبر منّا

178
00:11:25,800 --> 00:11:29,610
لا أمانع. لستُ هنا لتشكيل صداقات

179
00:11:30,040 --> 00:11:34,880
إذا هزمتُكِ في ذلك، هل ستخبرينني باسمكِ؟

180
00:11:35,150 --> 00:11:38,480
أنا بارعة جدّاً في الضربات الخفيفة

181
00:11:38,480 --> 00:11:41,290
وجيّدة بما يكفي لهزيمة أوي أماوشي أيضاً

182
00:11:41,960 --> 00:11:44,670
حسناً. موافقة

183
00:11:45,400 --> 00:11:49,390
فقد كنتُ بمزاج عكر طوال اليوم

184
00:11:49,390 --> 00:11:52,430
آسفة، لكن سأحرّر كلّ غضبي عليكِ

185
00:11:53,280 --> 00:11:54,860
لا تتردّدي

186
00:11:55,090 --> 00:11:57,120
...سوف أخترقكِ

187
00:11:57,120 --> 00:11:59,100
!برصاصتي...

188
00:12:05,180 --> 00:12:06,830
من سيبادر؟

189
00:12:06,830 --> 00:12:08,610
اللّاعب الأضعف

190
00:12:08,610 --> 00:12:11,280
أنتِ طفلة حقّاً

191
00:12:19,900 --> 00:12:21,180
رسمتُه

192
00:12:30,080 --> 00:12:34,940
أدخلتها دون انحراف حتّى ميلّيمتر واحد
!عن الخطّ المثاليّ

193
00:12:35,290 --> 00:12:39,540
،هذه هي قوّة كويو إيسيشيبا من كوران إذاً

194
00:12:39,540 --> 00:12:41,690
!"الّتي يطلقون عليها بـ"البحث عن الخطّ

195
00:12:45,130 --> 00:12:47,780
لم أرَ ضربات إيف الخفيفة من قبل

196
00:12:49,650 --> 00:12:51,830
،إذا أردتِ أن تكوني مساعدتي

197
00:12:51,830 --> 00:12:54,460
تعلّمي كيف ألعب الغولف أوّلاً

198
00:12:55,360 --> 00:12:58,510
...إيف، أراقب عن كثب

199
00:12:59,200 --> 00:13:00,960
...الرّصاصة الخضراء

200
00:13:04,350 --> 00:13:06,100
!النّهِمة

201
00:13:12,990 --> 00:13:16,300
!لـ-ليس من المفترض عليكِ أن تتجاهلي الخطّ

202
00:13:16,300 --> 00:13:21,560
!لو انحرفت ولو قليلاً، لتجاوزت الحيّز الأخضر

203
00:13:21,850 --> 00:13:25,570
...إ-إنّها طمّاعة للغاية

204
00:13:25,820 --> 00:13:28,000
الطريقة التي تضربين فيها بشكل خفيف سخيفة

205
00:13:28,390 --> 00:13:31,080
بالنسبة لي، هذه هي الطريقة الصّحيحة للضرب الخفيف

206
00:13:42,120 --> 00:13:43,720
...الرّصاصة الخضراء

207
00:13:43,720 --> 00:13:45,380
!النّهِمة

208
00:13:48,650 --> 00:13:51,140
!هـ-هذا أسوأ حتّى

209
00:14:04,030 --> 00:14:06,660
!لم يعُد هذا ضرباً خفيفاً حتّى

210
00:14:07,160 --> 00:14:08,530
هل لديكِ مشكلة؟

211
00:14:08,800 --> 00:14:11,040
لا. البتّة

212
00:14:25,400 --> 00:14:28,960
...إنّها جشعة وخشنة

213
00:14:28,960 --> 00:14:33,360
لكن تظلّ تُدخل الكُرات في الحفرة

214
00:14:34,730 --> 00:14:37,690
هذا هو أسلوب إيف في الغولف إذاً

215
00:14:37,690 --> 00:14:39,440
،طريقة للّعب غير ممكنة إلّا بالنسبة لها

216
00:14:39,860 --> 00:14:42,690
!لا يستطيع سواها استخدامها

217
00:14:47,440 --> 00:14:49,190
كيف تستطيع أن تلعب هكذا؟

218
00:14:49,190 --> 00:14:51,740
،كلّ طلقة تُطلقها هي عبارة عن مجازفة

219
00:14:51,740 --> 00:14:54,000
!كالسّير على حبل مشدود

220
00:14:54,000 --> 00:14:56,560
...لكن من المدهش رؤية ذلك

221
00:14:56,560 --> 00:14:57,940
!لا أستطيع الإشاحة بنظري

222
00:14:58,450 --> 00:15:00,460
...غولف تُسحر كلّ من يراها

223
00:15:03,280 --> 00:15:04,670
!بحث

224
00:15:12,280 --> 00:15:13,530
!الخطّ

225
00:15:15,160 --> 00:15:16,500
لقد اخترقتُها

226
00:15:23,640 --> 00:15:24,640
توقّفي

227
00:15:28,700 --> 00:15:31,570
!كـ-كاوروكو

228
00:15:31,910 --> 00:15:34,170
هي وأنا ثنائيّ

229
00:15:34,170 --> 00:15:36,710
هل يمكننا التّبادل؟

230
00:15:36,710 --> 00:15:38,370
بالتأكيد، إذا شئتِ

231
00:15:38,620 --> 00:15:39,920
شكراً

232
00:15:39,920 --> 00:15:41,570
تروقينني

233
00:15:42,670 --> 00:15:44,160
لقد حمّستِني

234
00:15:46,390 --> 00:15:47,840
دعيني أحلّ مكانكِ إذاً يا كويو

235
00:15:48,500 --> 00:15:51,760
...كاوروكو، هذا الأمر بيني وبينها

236
00:15:52,010 --> 00:15:54,840
إذا استمررتِ في هذا، ستخفقين في الضّربة

237
00:15:55,890 --> 00:15:59,140
من فضلكِ. دعيني أتولّى الأمر

238
00:16:02,980 --> 00:16:06,940
أنتِ أفضل لاعبة لدينا

239
00:16:07,750 --> 00:16:09,950
شكراً لكِ يا كويو

240
00:16:09,950 --> 00:16:13,720
كاوروكو إيجيما، تلميذة سنة ثالثة في كوران

241
00:16:13,720 --> 00:16:16,240
قائدة واللّاعبة الأفضل في نادي الغولف

242
00:16:16,240 --> 00:16:19,400
والمركز السّادس في ثانويّات الإناث العام الماضي

243
00:16:19,400 --> 00:16:21,320
!لاعبة محترفة حقيقيّة

244
00:16:22,190 --> 00:16:29,160
مشاهدة الطريقة الاستثنائيّة االتي
تلعب بها قد أثّرت على عقلكِ

245
00:16:29,160 --> 00:16:33,880
إذا استمررتِ في اللّعب، سوف تسحقكِ

246
00:16:34,470 --> 00:16:39,350
لن أدعها تدمّر شريكتي

247
00:16:40,320 --> 00:16:41,560
مِضرب تسديدات عالية؟

248
00:16:41,560 --> 00:16:42,310
لماذا؟

249
00:16:42,800 --> 00:16:44,360
،تعلم هذا بالطبع

250
00:16:44,360 --> 00:16:49,310
لكن مِضرب الضربات الخفيفة أسهل
!بكثير من تسديدات التّقريب

251
00:16:49,590 --> 00:16:51,310
فلماذا إذاً؟

252
00:16:53,650 --> 00:16:54,900
في المنطقة

253
00:17:07,860 --> 00:17:09,230
ما-ماذا حدث للتو؟

254
00:17:09,230 --> 00:17:11,170
...قوى تركيزها

255
00:17:11,470 --> 00:17:14,380
هذا هو اختصاصها

256
00:17:14,840 --> 00:17:18,520
،تعطّل حواس السّمع والتذوّق والشمّ لديها

257
00:17:18,520 --> 00:17:21,380
!لتعزّز قوى تركيزها

258
00:17:29,310 --> 00:17:32,280
"تطلِق على ذلك بـ"في المنطقة

259
00:17:49,560 --> 00:17:51,970
تسديدة مُوفّقة في الحفرة يا كاوروكو

260
00:17:51,970 --> 00:17:53,500
شكراً لكِ يا كويو

261
00:17:53,500 --> 00:17:54,780
مذهل

262
00:17:54,780 --> 00:17:58,080
!أنتِ ثاني شخص يدهشني بتسديدة

263
00:17:58,080 --> 00:18:00,680
هل لي أن أسأل من كانت الأولى؟

264
00:18:00,990 --> 00:18:02,520
أوي أماوشي

265
00:18:03,310 --> 00:18:05,840
فهمت. لا عجب

266
00:18:06,240 --> 00:18:07,130
تفضّلي

267
00:18:11,070 --> 00:18:12,570
لا يا إيف

268
00:18:12,570 --> 00:18:13,750
ماذا؟

269
00:18:13,750 --> 00:18:15,600
إذا سدّدتِ هكذا، ستخفقين

270
00:18:15,600 --> 00:18:17,200
إنّها حفرة سهلة

271
00:18:17,200 --> 00:18:19,070
مع ذلك ستخفقين

272
00:18:19,360 --> 00:18:20,330
!ابتعدي عنّي

273
00:18:22,290 --> 00:18:23,540
!صدّقيني

274
00:18:23,540 --> 00:18:27,280
!ثِقي بمساعدتكِ

275
00:18:33,800 --> 00:18:35,170
ماذا حدث؟

276
00:18:35,170 --> 00:18:36,320
هذا فخّ

277
00:18:36,320 --> 00:18:37,040
فخّ؟

278
00:18:37,040 --> 00:18:39,390
سدّدت إيجيما إلى تلك النقطة

279
00:18:39,390 --> 00:18:44,340
ضربتها عالية عمداً لتشكّل انبعاجاً
في الأرض أمام الحفرة

280
00:18:45,030 --> 00:18:50,320
إذا سدّدتِها بشكل مستقيم، فسوف تلامس
الكرةُ الانبعاج وتنحرف عن المسار

281
00:18:50,610 --> 00:18:54,240
كانت تنصب فخّاً من البداية؟

282
00:18:54,240 --> 00:18:55,190
أجل

283
00:18:55,510 --> 00:18:57,440
ماذا نفعل إذاً؟

284
00:18:57,440 --> 00:18:58,650
حِساب

285
00:19:01,130 --> 00:19:03,620
!انظري... وجدتُها

286
00:19:04,120 --> 00:19:07,000
!وجدتُ الإجابة الأمثل

287
00:19:14,010 --> 00:19:15,040
!إنّي أراها

288
00:19:15,840 --> 00:19:17,710
...أرى الكرة هنا

289
00:19:18,990 --> 00:19:22,060
،إذا كانت التّلويحة الأقوى لديكِ هي 10

290
00:19:22,060 --> 00:19:23,740
اضربي بـ 6

291
00:19:23,740 --> 00:19:26,060
...لا تصوّبي نحو الحفرة

292
00:19:26,430 --> 00:19:28,060
صوّبي نحو الانبعاج

293
00:19:28,310 --> 00:19:29,900
هل من طريقة أخرى؟

294
00:19:29,900 --> 00:19:30,950
لا

295
00:19:33,680 --> 00:19:36,750
إذا شكّلتُ ثنائيّاً معكِ، هل يمكنني
هزيمة أوي أماواشي؟

296
00:19:37,220 --> 00:19:38,380
!يمكنكِ

297
00:19:38,380 --> 00:19:39,700
!يمكننا أن نفوز

298
00:19:40,350 --> 00:19:43,690
أظنّني عليّ أن أفعل ما تقوله
مساعدتي الشخصيّة في الغولف

299
00:19:44,000 --> 00:19:45,450
...إيف

300
00:19:48,010 --> 00:19:50,170
كشفت الفخّ

301
00:19:50,890 --> 00:19:53,050
إنّها أذكى ممّا تبدو

302
00:19:55,890 --> 00:19:57,820
...رصاصة الثّقة

303
00:19:57,820 --> 00:19:59,310
الخضراء

304
00:20:11,880 --> 00:20:13,770
!أحسنتِ صنعاً يا إيف

305
00:20:13,770 --> 00:20:15,380
أبليتِ حسناً أيّتها القزمة

306
00:20:15,380 --> 00:20:17,950
!لا تعلّقي بشأن طولي من فضلكِ

307
00:20:18,240 --> 00:20:20,650
حسناً، ذكّريني ماذا كان اسمكِ؟

308
00:20:20,890 --> 00:20:22,360
!إتشينا

309
00:20:22,360 --> 00:20:24,230
!إتشينا ساوتومي

310
00:20:25,790 --> 00:20:27,800
!أحسنتِ صنعاً يا قزمة

311
00:20:27,800 --> 00:20:29,890
!يُفترض أن تذكري اسمي بعد أن أخبرتكِ

312
00:20:29,890 --> 00:20:33,170
!مثل الغولف خاصّتكِ تماماً، أنتِ تتجاهلين القواعد

313
00:20:34,190 --> 00:20:38,450
أنا آسفة، لكن انتهى كلّ شيء لليوم

314
00:20:38,450 --> 00:20:43,310
أعتقد بمقدورنا أن نبقى هنا
طوال اللّيل دون أن ننتهي

315
00:20:43,560 --> 00:20:44,650
هكذا إذاً

316
00:20:44,650 --> 00:20:46,230
لا مانع لديّ

317
00:20:46,440 --> 00:20:48,570
ليلة موفّقة إذاً

318
00:20:48,570 --> 00:20:50,260
هيّا بنا يا كويو

319
00:20:50,260 --> 00:20:51,230
حسناً

320
00:20:51,560 --> 00:20:53,390
أنتِ، عرّفيني على اسمكِ

321
00:20:55,980 --> 00:20:59,240
إيفانجيلين. ناديني إيف

322
00:20:59,830 --> 00:21:04,790
قائدة نادي الغولف كوران للإناث
كاوروكو إيجيما، سنة ثالثة

323
00:21:04,790 --> 00:21:06,610
يشرّفني التعرّف عليكِ

324
00:21:07,200 --> 00:21:09,040
،حسناً يا إيف

325
00:21:09,040 --> 00:21:13,790
سأراكِ في البطولة المزدوجة لمدارس الغولف
الثانويّة اليابانيّة للإناث

326
00:21:17,000 --> 00:21:20,330
المعذرة، ما هي هذه البطولة اليابانيّة؟

327
00:21:20,330 --> 00:21:24,080
البطولة المزدوجة لمدارس الغولف
الثانويّة اليابانيّة للإناث؟

328
00:21:24,080 --> 00:21:26,510
إنّها بطولة جديدة

329
00:21:26,970 --> 00:21:30,180
وستكون كاوروكو إيجيما هناك؟

330
00:21:30,180 --> 00:21:35,520
أجل، ربّما كثنائي مع كويو إيسيشيبا

331
00:21:39,000 --> 00:21:40,910
أنا جائعة

332
00:21:41,240 --> 00:21:43,290
لنذهب وناكل طعاماً ما قبل أن نعود

333
00:21:43,290 --> 00:21:48,050
تجاوزنا ساعات حظر التجوّل بكثير، لذا قد أرافقكِ

334
00:21:51,680 --> 00:21:55,570
التقيتُ بالشخص الّذي كنت تتكلّم عنه

335
00:21:55,570 --> 00:21:58,540
،كنتُ أنوي أن أدع كويو تلعب معها

336
00:21:58,540 --> 00:22:00,920
لكن لم يسعني فعل شيء

337
00:22:01,290 --> 00:22:04,320
أنت رجل قاسٍ

338
00:22:04,320 --> 00:22:09,640
كان بمقدورك سحقها أيّها المدرّب آمورو

339
00:22:10,560 --> 00:22:12,260
لكن سارت الأمور بسلاسة، صحيح؟

340
00:22:12,260 --> 00:22:15,690
تمكّنتِ من رؤية أحد منافسيك في البطولة

341
00:22:16,640 --> 00:22:19,880
أجل، أتطلّع قدماً لرؤيتك هناك

342
00:22:20,330 --> 00:22:21,190
وداعاً

343
00:23:20,440 --> 00:23:22,100
هل من مشكلة؟

344
00:23:22,100 --> 00:23:24,100
أريدك أن تدعني أنضمّ لنادي الغولف

345
00:23:24,720 --> 00:23:25,800
...للالتحاق تحتاجين

346
00:23:25,800 --> 00:23:27,780
سأخضع لاختبار إن لزم الأمر

347
00:23:28,540 --> 00:23:32,000
لا، انتهى الاختبار

348
00:23:32,270 --> 00:23:34,500
ابدئي غداً

349
00:23:35,080 --> 00:23:36,510
!مرحى! مرحى

350
00:23:36,900 --> 00:23:39,350
!!مرحى

351
00:23:40,060 --> 00:23:50,020
الحلقة القادمة

352
00:23:40,410 --> 00:23:42,260
أيّتها المساعدة! من تلك الفتاة؟

353
00:23:42,260 --> 00:23:44,110
كينوي جينغوجي، رئيسة نادي الغولف

354
00:23:44,110 --> 00:23:46,030
!إنّها تُرهقني كثيراً بالعمل

355
00:23:46,030 --> 00:23:47,090
إنّها تؤذيكِ لأنها تحبّك

356
00:23:47,090 --> 00:23:48,530
!المزيد من باردي باردي في الأسبوع المقبل

357
00:23:48,530 --> 00:23:50,530
!ليس ثانية