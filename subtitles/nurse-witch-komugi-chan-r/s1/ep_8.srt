214
00:11:31,750 --> 00:11:33,040
...ص

215
00:11:33,040 --> 00:11:34,370
أمزح فقط

216
00:11:34,370 --> 00:11:36,800
حتّى الـ"ص" التي تكرهينها كثيراً في سباتٍ الآن

217
00:11:36,990 --> 00:11:39,000
!تبّاً يا يو-ني

218
00:11:39,000 --> 00:11:40,080
كوموغي-تشان

219
00:11:40,690 --> 00:11:42,860
ثمّة وحش قريب

220
00:11:43,810 --> 00:11:45,930
،أعلمُ أنّكِ لا تستطيعين رؤيته

221
00:11:45,930 --> 00:11:48,220
لكن أُذنايّ تتنبّهان

222
00:11:48,700 --> 00:11:50,450
ما-ماذا ينبغي أن أفعل؟

223
00:11:51,290 --> 00:11:52,270
ما الأمر؟

224
00:11:52,270 --> 00:11:53,690
...ماذا؟

225
00:11:53,940 --> 00:11:56,920
عليّ الذهاب إلى دورة المياه
نسيتُ هاتفي الخليوي

226
00:11:56,920 --> 00:11:59,170
ونسيتُ ضبط مسجِّلة أشرطة الكاسيت

227
00:11:59,170 --> 00:12:01,300
سأعودُ إلى الفندق

228
00:12:01,300 --> 00:12:02,320
!مهلاً

229
00:12:04,390 --> 00:12:05,450
حسناً، أيّاً يكن

230
00:12:05,860 --> 00:12:07,620
سأفعلُ ذلك بنفسي إذاً

231
00:12:11,460 --> 00:12:13,370
...عندما تصلُ كوكونا وتسوكاسا إلى هنا

232
00:12:13,370 --> 00:12:14,390
!زئير

233
00:12:14,930 --> 00:12:16,040
!لا

234
00:12:16,040 --> 00:12:17,170
لا عليكِ

235
00:12:18,460 --> 00:12:20,420
إنّها رائعة للغاية

236
00:12:23,840 --> 00:12:25,300
هذا مُمتاز

237
00:12:25,300 --> 00:12:27,390
حسناً، أنا جاهزٌ لكما في أي وقت

238
00:12:29,540 --> 00:12:32,340
هذا مخيف جداً

239
00:12:32,600 --> 00:12:33,810
نـ-نعم

240
00:12:34,390 --> 00:12:38,660
أحسُّ بوحش

241
00:12:36,330 --> 00:12:36,810
ماذا؟

242
00:12:50,630 --> 00:12:52,660
أنا مُتعبة

243
00:12:52,660 --> 00:12:54,960
تسوكاسا-تشان، هلّا سبقتِني؟

244
00:12:54,960 --> 00:12:56,460
أريدُ أن أكون وحيدة

245
00:12:56,460 --> 00:12:57,890
أ-أكيد

246
00:12:57,890 --> 00:13:00,210
حقاً؟ سأمضي في طريقي إذاً

247
00:13:00,450 --> 00:13:02,090
وإلّا فلا أستطيع التحوُّل

248
00:13:05,330 --> 00:13:07,180
إنّه بارز تماماً

249
00:13:07,180 --> 00:13:09,610
كما ترين، يقِفُ متأهِّباً

250
00:13:10,220 --> 00:13:11,560
فهمت

251
00:13:11,560 --> 00:13:13,220
من هُنا

252
00:13:17,150 --> 00:13:20,460
أخيراً حظيتُ بدورٍ لي

253
00:13:20,460 --> 00:13:22,650
!لحظة، انتظر

254
00:13:23,060 --> 00:13:25,480
كفِّي عن اللّهو واهزميه

255
00:13:25,480 --> 00:13:27,430
!أعيدي لوني

256
00:13:27,430 --> 00:13:29,820
لماذا سمحتَ للوحشِ أن يُهاجمك؟

257
00:13:29,820 --> 00:13:31,080
!اصمتي

258
00:13:31,080 --> 00:13:32,290
كنتُ بطيئاً فحسب

259
00:13:32,780 --> 00:13:35,690
أنا الدبُّ الشفَّاف الذي لا لون له

260
00:13:36,010 --> 00:13:37,710
!قلتُ انتظر

261
00:13:39,060 --> 00:13:39,790
لقد أتيا

262
00:13:40,250 --> 00:13:41,880
...حسناً

263
00:13:46,420 --> 00:13:47,990
دبّ

264
00:13:49,410 --> 00:13:50,760
تسوكاسا فقط

265
00:13:50,760 --> 00:13:52,520
حاول أن تزأر كدبّ

266
00:13:51,270 --> 00:13:52,820
...ينبغي عليّ إذاً

267
00:13:59,620 --> 00:14:00,880
والآن تحوّلي إلى فتاة تومبو-ي

268
00:14:00,880 --> 00:14:01,940
حسناً

269
00:14:09,610 --> 00:14:10,530
...يو

270
00:14:10,770 --> 00:14:11,850
لا تصدري صوتاً

271
00:14:13,990 --> 00:14:15,100
!ولا حركة

272
00:14:17,430 --> 00:14:18,780
يـ-يوتو؟

273
00:14:18,780 --> 00:14:20,170
ماذا؟ ما هذا؟

274
00:14:25,840 --> 00:14:27,070
يوتو

275
00:14:29,120 --> 00:14:31,690
هل آلمتُك؟ آسف

276
00:14:32,120 --> 00:14:34,600
هل كنتُ أوخزك بمصباحي؟

277
00:14:35,300 --> 00:14:36,920
...مصباح

278
00:14:38,010 --> 00:14:40,010
ينبغي أن نكون بخير الآن

279
00:14:41,170 --> 00:14:42,450
رأيتُ دبّاً

280
00:14:42,760 --> 00:14:45,910
لا نريده أن يعثر علينا
لِذا حاول ألّا تصدر ضجيجاً

281
00:14:46,380 --> 00:14:47,280
آسف

282
00:14:47,280 --> 00:14:49,800
هـ-هكذا إذاً

283
00:14:52,270 --> 00:14:55,220
فهمت، لقد فاجأتني

284
00:14:57,870 --> 00:14:58,990
!عجباً

285
00:15:09,820 --> 00:15:11,890
أين كوموغي وكوكونا؟

286
00:15:17,640 --> 00:15:20,140
الطيران المنخفِض

287
00:15:20,760 --> 00:15:23,270
كان ذلك وشيكاً، كدتُ أهلك

288
00:15:23,270 --> 00:15:24,610
لن تفلت منّي

289
00:15:25,740 --> 00:15:28,960
:استخدمي شعاع ضرب وتكسير الفائق كبّاش

290
00:15:28,960 --> 00:15:31,350
من الأعلى للأسفل، من الأمام إلى الخلف
وشعاع فوقي مائل

291
00:15:31,350 --> 00:15:32,360
سأفعلُ ذلك إذاً

292
00:15:32,610 --> 00:15:34,980
!شُعاع لا أدري ما اسمه

293
00:15:34,030 --> 00:15:36,950
شُعاع ضرب وتكسير الفائق كبَّاش: من الأعلى للأسفل

294
00:15:36,950 --> 00:15:39,620
...من الأمام إلى الخلف، وشعاع فوقي مائل

295
00:15:39,920 --> 00:15:43,790
هو شعاع طويل كاسمه تماماً، لِذا أتركُ الأمرَ لمخيّلتكم

296
00:15:44,040 --> 00:15:47,690
دبّ بِلا لون هو دبّ شفّاف

297
00:15:47,690 --> 00:15:50,530
أوف وأوف

298
00:15:51,630 --> 00:15:53,800
كتاب

299
00:15:56,710 --> 00:15:59,060
لقد عادَ لوني

300
00:15:59,430 --> 00:16:01,430
أصبحَتْ بطاقة فان-سِ ملكي

301
00:16:01,430 --> 00:16:03,850
كوموغي-تشان، كنتِ مفيدة هذه المرّة فقط

302
00:16:03,850 --> 00:16:06,280
مجموعة بطاقاتي فان-سِ تزدادُ حجماً

303
00:16:06,280 --> 00:16:08,320
الأميرة-بي، انتظري فحسب

304
00:16:11,150 --> 00:16:13,950
تأخّرنا كثيراً

305
00:16:13,950 --> 00:16:16,590
سبقَتْنا الممرِّضة الساحرة إلى ذلك

306
00:16:16,590 --> 00:16:19,830
لكن لماذا هي؟

307
00:16:20,550 --> 00:16:22,410
هل كوموغي-تشان بخير؟

308
00:16:22,410 --> 00:16:25,030
قالَتْ أنها ستعود

309
00:16:25,030 --> 00:16:26,250
هل تاهَتْ؟

310
00:16:26,590 --> 00:16:29,520
آملُ ألّا تُصادِف أي وحش أو دبّ

311
00:16:29,520 --> 00:16:31,640
لقد اختفى حضورُ الوحش

312
00:16:31,640 --> 00:16:33,050
لا بدّ وأن شخصاً ما قد هزمه

313
00:16:33,050 --> 00:16:34,340
شخص ما؟

314
00:16:34,640 --> 00:16:35,880
يا شباب

315
00:16:36,610 --> 00:16:39,170
شكراً على الانتظار، آسفة

316
00:16:39,170 --> 00:16:41,280
تهتُ مجدداً

317
00:16:43,340 --> 00:16:44,520
يا إلهي

318
00:16:47,150 --> 00:16:50,680
غِناء الأغاني من المخارج الأنفية

319
00:16:49,520 --> 00:16:51,520
هذا شعور رائع

320
00:16:51,520 --> 00:16:52,300
نعم

321
00:16:52,840 --> 00:16:54,430
أهو ساخن قليلاً؟

322
00:16:54,730 --> 00:16:55,700
نعم

323
00:16:56,760 --> 00:16:58,660
لكن ربّما بارد قليلاً

324
00:16:58,960 --> 00:16:59,700
نعم

325
00:17:03,290 --> 00:17:06,470
يوتو قويّ جداً

326
00:17:06,470 --> 00:17:08,330
إنه رجل حقيقيّ

327
00:17:09,530 --> 00:17:11,870
تحبِّين يوتو-سان، أليس كذلك؟

328
00:17:11,870 --> 00:17:14,980
نعم

329
00:17:12,590 --> 00:17:13,960
توقّعتُ ذلك

330
00:17:15,380 --> 00:17:17,630
ماذا؟

331
00:17:19,140 --> 00:17:20,930
عرفتُ أنّك كذلك

332
00:17:20,930 --> 00:17:22,310
...كـ-كلّا

333
00:17:22,550 --> 00:17:25,090
...لا، أنا

334
00:17:25,090 --> 00:17:27,850
...أنا... أنتِ

335
00:17:29,220 --> 00:17:32,590
عرفتُ أنّني كنتُ محقّة بعدما رأيتُكِ اليوم

336
00:17:32,590 --> 00:17:35,490
بأنّكِ في الواقع أنثويّة

337
00:17:36,880 --> 00:17:40,740
لكن هنالِك معجبون لكِ ومكتب ولكِ شخصيّتكِ

338
00:17:41,220 --> 00:17:43,750
نحنُ نواجهُ أموراً صعبة كثيرة

339
00:17:43,980 --> 00:17:45,980
كنتُ قلِقة حيال ذلك أيضاً

340
00:17:45,980 --> 00:17:47,240
ركضتُ في ذلك الماراثون

341
00:17:48,450 --> 00:17:50,900
وأنا متأكِّدة من أمر واحد فقط

342
00:17:51,200 --> 00:17:53,970
أنّكِ تحبِّين يوتو-سان يا تسوكاسا-تشان

343
00:17:57,290 --> 00:17:58,680
لا تقلقي

344
00:17:59,180 --> 00:18:01,620
اذهب. إلى أين أذهب؟

345
00:17:59,840 --> 00:18:01,810
أعتقدُ أنّ يوتو-سان يعتبرُ

346
00:18:01,620 --> 00:18:04,180
إلى هناك. إلى أين بالضبط؟

347
00:18:01,810 --> 00:18:04,180
كوموغي-تشان أختاً

348
00:18:04,670 --> 00:18:06,360
حـ-حقّاً؟

349
00:18:06,360 --> 00:18:07,200
نعم

350
00:18:07,850 --> 00:18:10,520
...ولستُ متأكّدة تماماً لكن

351
00:18:11,470 --> 00:18:14,530
أظنُّه مهتمّاً بكِ

352
00:18:18,210 --> 00:18:20,570
لِذا لا تقلقي، ستنجحين

353
00:18:24,000 --> 00:18:25,830
!طرطشة

354
00:18:29,180 --> 00:18:30,650
كوموغي

355
00:18:30,910 --> 00:18:32,620
عمّاذا كنتُما تتكلّمان؟

356
00:18:32,620 --> 00:18:34,280
نِصف الكلام سرّ

357
00:18:34,280 --> 00:18:34,960
!مهلاً

358
00:18:34,960 --> 00:18:36,360
نصف؟

359
00:18:36,360 --> 00:18:38,000
والنصف الآخر هو أنّ

360
00:18:38,000 --> 00:18:41,680
تسوكاسا-تشان أنثويّة حقاً

361
00:18:41,680 --> 00:18:44,350
ماذا؟ أكنتِ تعلمين أيضاً يا كوكونا-تشان؟

362
00:18:44,350 --> 00:18:45,510
توقعتُ هذا

363
00:18:47,270 --> 00:18:49,230
...عندما عدنا إلى غرفتنا

364
00:18:53,550 --> 00:18:56,940
تسوكاسا-تشان، سأخرجُ أنا وكوموغي-تشان أولاً

365
00:18:56,940 --> 00:18:58,750
ماذا؟

366
00:18:57,550 --> 00:18:59,200
افعلي ذلك فحسب

367
00:19:03,550 --> 00:19:05,890
الماء منعش

368
00:19:05,890 --> 00:19:09,890
لِساني حسّاس للحرارة، لكن أحبُّ الينابيع السّاخنة

369
00:19:11,850 --> 00:19:13,250
يـ-يوتو؟

370
00:19:13,860 --> 00:19:15,000
تسوكاسا؟

371
00:19:15,600 --> 00:19:16,960
هل يوجدُ شخصٌ آخر هناك؟

372
00:19:18,630 --> 00:19:20,800
أنا... إنه أنا فقط

373
00:19:21,180 --> 00:19:22,190
هكذا إذاً

374
00:19:23,500 --> 00:19:27,220
آسِف بشأن ما سبق، كنتُ أسيرُ في كلّ مكان

375
00:19:27,770 --> 00:19:29,360
...أردتُك وكوكونا

376
00:19:29,360 --> 00:19:30,570
،لا

377
00:19:30,570 --> 00:19:33,520
أردتُكما أن تستمتعا قليلاً

378
00:19:35,110 --> 00:19:38,530
رغبتكِ دوماً هي أن يتمتّع أصدقاؤكِ

379
00:19:38,990 --> 00:19:40,030
ويكونوا سُعداء

380
00:19:43,320 --> 00:19:45,450
أصدقاء؟

381
