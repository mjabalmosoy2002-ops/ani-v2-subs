1
00:01:35,710 --> 00:01:37,530
كانَتْ ليليا-تشان مُذهلة

2
00:01:37,990 --> 00:01:40,740
كانَتْ متألِّقة للغاية

3
00:01:40,740 --> 00:01:42,790
ربّما بعض من قوّتِها قد حفّزَني

4
00:01:43,140 --> 00:01:45,540
سأضاعفُ جهودي في العمل

5
00:01:45,540 --> 00:01:48,290
عيادة يوشيدا

6
00:01:45,800 --> 00:01:46,980
لقد عُدت

7
00:01:46,980 --> 00:01:48,290
أهلاً بعودتكِ

8
00:01:52,420 --> 00:01:53,950
أوسا-ب؟

9
00:01:53,950 --> 00:01:57,510
أهلاً بعودتكِ يا كوموغي-تشان

10
00:01:58,070 --> 00:01:59,870
تسوكاسا-تشان، أراك لاحقاً

11
00:01:59,870 --> 00:02:00,530
نعم

12
00:02:01,290 --> 00:02:02,280
لقد عُدت

13
00:02:03,120 --> 00:02:09,060
أهلاً بعودتك

14
00:02:10,430 --> 00:02:11,730
...كوموغي-تشان

15
00:02:11,990 --> 00:02:15,370
هل اشتقت إليّ أثناء وجودي

16
00:02:15,370 --> 00:02:16,990
في عالم فانتا-سِ؟

17
00:02:16,990 --> 00:02:18,780
كانت الأجواء هادئة ولطيفة

18
00:02:19,400 --> 00:02:21,390
لدرجة أنّني نسيتُ أنّك قد ذهبت

19
00:02:23,270 --> 00:02:24,440
!أنتِ قاسية للغاية

20
00:02:24,440 --> 00:02:27,280
لقد كنتُ أفكّرُ طوال هذا الوقت بالاستحمام

21
00:02:27,280 --> 00:02:29,470
!معكِ عندما أعود

22
00:02:29,470 --> 00:02:30,960
لا يمكن أن أفعل ذلك

23
00:02:32,330 --> 00:02:33,590
هذه لكِ

24
00:02:33,820 --> 00:02:37,050
كعك عالم فانتا-سِ، بسكويت عالم فانتا-سِ

25
00:02:37,050 --> 00:02:40,550
كازوز عالم فانتا-سِ، وكريب عالم فانتا-سِ

26
00:02:40,840 --> 00:02:42,760
رائع، شكراً

27
00:02:42,760 --> 00:02:44,300
حسناً، وماذا حدث؟

28
00:02:44,840 --> 00:02:46,350
...في الحقيقة

29
00:02:46,970 --> 00:02:49,310
همس همس تمتمة تمتمة بيونبيون

30
00:02:49,310 --> 00:02:51,680
ماذا؟ فتاة وحشيّة سرقَتْ

31
00:02:51,680 --> 00:02:53,650
كلّ بِطاقات فانتا-سِ خاصّتك؟

32
00:02:54,000 --> 00:02:55,220
...نعم

33
00:02:55,540 --> 00:02:57,440
سنستعيدُها كلّها

34
00:02:57,440 --> 00:03:01,180
أذنايّ تستنفِران عندما يظهرُ وحشٌ آخر

35
00:03:01,180 --> 00:03:02,910
سأحصلُ عليها حينئذ دون شكّ

36
00:03:03,140 --> 00:03:04,720
ليس باليدِ حيلة على ما أظن

37
00:03:04,720 --> 00:03:07,050
لا أدري ما الذي يجري بالضبط، لكن لا بأس

38
00:03:07,050 --> 00:03:09,290
سأستريحُ قليلاً إذاً

39
00:03:09,590 --> 00:03:12,450
ماذا فعلتِ أثناء غيابي؟

40
00:03:12,450 --> 00:03:14,380
تعرّفتُ على صديقةٍ جديدة

41
00:03:14,380 --> 00:03:16,670
إنّها نجمة فائقة الشهرة تُدعى ليليا-تشان

42
00:03:16,910 --> 00:03:17,810
إنّها هذه الفتاة

43
00:03:18,390 --> 00:03:20,050
إنّها ظريفة

44
00:03:22,010 --> 00:03:23,470
!إنّها هي

45
00:03:23,730 --> 00:03:24,620
ماذا؟

46
00:03:24,620 --> 00:03:27,810
إنّها الفتاة الوحشيّة الغامضة التي سرقَتْ
بطاقات فانتا-سِ خاصّتي

47
00:03:27,810 --> 00:03:30,540
عمّاذا تتكلّم؟ هذا مُستحيل

48
00:03:30,540 --> 00:03:31,980
!أنا متأكّدٌ من ذلك

49
00:03:31,980 --> 00:03:32,850
ماذا؟

50
00:03:33,070 --> 00:03:36,410
ما زلتَ لم تعثر على خادمة-تشان أو أختاه-تشان

51
00:03:36,410 --> 00:03:38,310
بشكليهما الطبيعيين

52
00:03:38,310 --> 00:03:39,610
فمن أين لكَ هذه الثّقة؟

53
00:03:39,610 --> 00:03:41,510
!أنا متأكّدٌ أنها هي

54
00:03:41,510 --> 00:03:43,860
!إنها هي، لنذهب ونكتشف

55
00:03:44,160 --> 00:03:46,240
لكن كيف؟

56
00:03:46,240 --> 00:03:48,820
إنّها وحش، إنّها العدوّ

57
00:03:48,820 --> 00:03:50,870
تبّاً. فهمت، فهمت

58
00:03:51,290 --> 00:03:53,870
حسناً، حسناً، تصبح على خير

59
00:03:56,150 --> 00:03:59,440
غير معقول، من المُحال أن تكون ليليا-تشان وحشاً

60
00:04:01,180 --> 00:04:02,300
...هذا

61
00:04:02,300 --> 00:04:04,000
مستحيل...

62
00:04:08,430 --> 00:04:09,930
ما الأمر؟

63
00:04:10,880 --> 00:04:12,310
لا شيء

64
00:04:12,310 --> 00:04:12,850
نعم

65
00:04:12,850 --> 00:04:14,190
تبدين ظريفة اليوم أيضاً

66
00:04:16,230 --> 00:04:18,340
هل أحسست بشيء؟

67
00:04:18,340 --> 00:04:21,350
ربّما نعم وربّما لا

68
00:04:21,350 --> 00:04:22,240
ما الذي يعنيه هذا؟

69
00:04:22,540 --> 00:04:24,150
أذنايّ ليستا متشنّجتَين

70
00:04:24,150 --> 00:04:27,110
لكن أحسُّ بشيء غير طبيعي

71
00:04:27,110 --> 00:04:29,990
أظنُّني نصف متشنِّج

72
00:04:30,250 --> 00:04:32,060
...نصف متشنِّج؟ بعبارة أخرى

73
00:04:32,060 --> 00:04:34,500
إنّها ليسَتْ وحشاً

74
00:04:34,500 --> 00:04:35,250
أرأيت؟

75
00:04:35,510 --> 00:04:38,410
لكن أحسُّ بشيء ما

76
00:04:39,730 --> 00:04:42,010
أتمنّى لكُن وقتاً ممتعاً اليوم

77
00:04:42,460 --> 00:04:43,380
نعم

78
00:04:43,380 --> 00:04:46,890
شكراً على دعوتِنا إلى حفلِ قبّة سماء طوكيو الخاصّ بكِ

79
00:04:56,560 --> 00:04:59,440
كم ليليا كريمة

80
00:04:59,440 --> 00:05:00,700
حتّى دعَتْنا أيضاً

81
00:05:00,700 --> 00:05:03,610
بما أنّنا وصلنا إلى هنا، لنستمتع بوقتنا

82
00:05:03,840 --> 00:05:05,800
أخيراً قد وصلنا

83
00:05:05,800 --> 00:05:07,940
لكن ليليا-تشان ستغنِّي

84
00:05:07,940 --> 00:05:11,870
يمكنُنا أن نرى كيف ستكونُ حفلة قبّة سماء
طوكيو الموسيقيّة

85
00:05:12,240 --> 00:05:15,520
امتلأت المقاعد التي تتّسِع لـ570 ألف شخصاً

86
00:05:15,520 --> 00:05:16,780
مذهل

87
00:05:17,200 --> 00:05:19,380
هذا يُعادل عدد سكّان توتّوري تقريباً

88
00:05:19,900 --> 00:05:21,920
يبقى حلماً بعيداً

89
00:05:22,530 --> 00:05:24,930
لكن ياكوكونا-تشان وتسوكاسا-كُن

90
00:05:25,470 --> 00:05:27,470
سنغنِّي هنا يوماً ما أيضاً

91
00:05:27,960 --> 00:05:28,680
نعم

92
00:05:29,050 --> 00:05:30,060
سوية

93
00:05:38,920 --> 00:05:41,100
سأبذلُ قصارى جهدي اليوم

94
00:05:41,500 --> 00:05:43,750
سأقدِّمُ الاستعراض الأعظم

95
00:05:44,080 --> 00:05:46,950
وذلك كي يستمتع مُعجبيني

96
00:05:46,950 --> 00:05:49,740
وتستمتعُ صديقاتي

97
00:05:50,130 --> 00:05:53,130
وكي أتمكّن من توسيع دائرة

98
00:05:53,130 --> 00:05:54,970
مُعجبيني وصديقاتي

99
00:05:56,300 --> 00:05:57,160
تفضّل

100
00:05:59,900 --> 00:06:00,690
حسناً

101
00:06:01,980 --> 00:06:10,430
وأنا أنثرُ الألماس لأجعل الأيّام العاديّة أكثر بريقاً

102
00:06:10,430 --> 00:06:15,640
أتخيّلُ نسخةً خاصّةً من نفسي

103
00:06:16,390 --> 00:06:25,220
هذا هو المكان الذي تتحقّقُ فيه الأحلام والآمال والطموحات

104
00:06:20,540 --> 00:06:22,700
كوموغي-تشان، كوموغي-تشان

105
00:06:22,700 --> 00:06:24,190
ماذا يا أوسا-ب؟

106
00:06:24,190 --> 00:06:26,070
!أُذنايّ متشنّجتان! إنّه وحش

107
00:06:25,220 --> 00:06:30,170
لكنّه ليس مكاناً سهل المنال

108
00:06:26,330 --> 00:06:28,070
ماذا؟ أين؟

109
00:06:31,900 --> 00:06:33,080
!هناك

110
00:06:33,080 --> 00:06:35,330
هذا وحش كاميرا أشعّة تحت الحمراء

111
00:06:33,080 --> 00:06:37,900
هذا المسرح ليس مكاناً سهل المنال

112
00:06:35,710 --> 00:06:38,830
سيجعلُ ذلك الوحش ملابسك شفّافة

113
00:06:39,100 --> 00:06:41,080
ليليا-تشان في خطر

114
00:06:40,690 --> 00:06:44,700
بريقه يفوقُ كلّ بريق

115
00:06:42,220 --> 00:06:43,130
ما الأمر؟

116
00:06:43,680 --> 00:06:45,450
عـ-عليّ الذهاب إلى دورة المياه

117
00:06:44,700 --> 00:06:48,840
الجميعُ لديهم فُرصة في مُتناول اليد

118
00:06:45,450 --> 00:06:46,970
أنا أيضاً

119
00:06:46,970 --> 00:06:48,840
أريدُ قطف بعض الزهور

120
00:06:50,550 --> 00:06:53,740
سأذهبُ إلى دورة مياه أخرى

121
00:06:53,740 --> 00:06:54,850
هـ-هل أنتِ متأكّدة؟

122
00:06:54,850 --> 00:06:56,850
أشعرُ برغبةٍ في سلوك هذا الاتّجاه

123
00:06:56,850 --> 00:06:58,220
أظنُّني سأسلكُ هذا الاتّجاه

124
00:06:58,220 --> 00:06:59,890
حسناً، أراكما لاحقاً

125
00:07:00,280 --> 00:07:01,530
على مهل، على مهل

126
00:07:01,530 --> 00:07:02,270
على مهل

127
00:07:02,520 --> 00:07:04,490
هل من أحد؟ هل من أحد؟

128
00:07:07,780 --> 00:07:10,210
كلوروفورم مغرَز مِظَلِّي لامع

129
00:07:07,780 --> 00:07:10,210
!شرارة ميرال العذراء

130
00:07:07,780 --> 00:07:10,210
!إشراقة شمس الزهرة الجميلة

131
00:07:08,910 --> 00:07:12,760
إنَّ ترتيلها يفكُّ شفرة الرّمز المُبرمَج في التّعزيمة

132
00:07:10,210 --> 00:07:12,760
تينيبول لامِعة جميلة

133
00:07:10,210 --> 00:07:12,760
!بينيفور ميرال الملتهبة

134
00:07:10,210 --> 00:07:12,760
!اللّاعبة المغناجة المنفوشة

135
00:07:12,760 --> 00:07:14,310
وتجري مسحاً لكامل جسد كوموغي

136
00:07:14,310 --> 00:07:17,730
وتحوّلُ الأشعّة قلبَ كوموغي الحنون وقلب
كوكونا المحبّ لأداء الواجب

137
00:07:17,730 --> 00:07:21,640
وروح تسوكاسا المُحبّة إلى خلايا أمازوني-ن

138
00:07:21,640 --> 00:07:24,980
لتفعِّل الإمكانيات القصوى لتومبو-ي وتُعيد بِناء جسدها وزيّها

139
00:07:24,980 --> 00:07:29,710
وسطياً، يستغرقُ تحوُّل فتاة تومبو-ي 0.02 ثانية

140
00:07:34,220 --> 00:07:35,690
ماذا؟

141
00:07:35,690 --> 00:07:37,930
.واضح، واضح، واضح

142
00:07:38,400 --> 00:07:40,410
أشعّة تحت الحمراء

143
00:07:40,710 --> 00:07:43,480
حتّى لو كنتِ ترتدين لِباساً، أستطيعُ رُؤية ما خلفه بوضوح

144
00:07:43,480 --> 00:07:45,980
واضح، واضح، واضح، واضح

145
00:07:46,280 --> 00:07:48,760
أستطيعُ رؤية عظامكِ

146
00:07:51,200 --> 00:07:53,560
واضح، واضح، واضح، واضح

147
00:07:53,560 --> 00:07:54,350
!توقّف مكانك

148
00:07:54,350 --> 00:07:54,820
واضح؟

149
00:07:55,390 --> 00:07:56,410
من أنت؟

150
00:07:58,090 --> 00:08:00,120
يمكنُك الاعتماد عليّ في تطهير قلبك

151
00:08:00,120 --> 00:08:01,360
!أنا الممرِّضة الساحرة

152
00:08:01,360 --> 00:08:03,730
قلب طاهر وعالم طاهر

153
00:08:03,730 --> 00:08:05,110
!الخادمة السّاحرة

154
00:08:05,110 --> 00:08:06,650
هل تلوت صلواتك؟

155
00:08:06,650 --> 00:08:07,920
!الأخت السّاحرة

156
00:08:10,190 --> 00:08:11,270
ما هذا؟

157
00:08:11,270 --> 00:08:12,880
لعلّه سيناريو فُكاهي

158
00:08:13,150 --> 00:08:15,320
أتِلك هي أختاه-تشان؟

159
00:08:18,270 --> 00:08:20,140
!وحش كاميرا الأشعّة تحت الحمراء

160
00:08:20,140 --> 00:08:21,270
...لن ندعك

161
00:08:21,270 --> 00:08:22,730
تلمس ليليا-تشان

162
00:08:23,050 --> 00:08:24,240
...واضح، واضح

163
00:08:24,240 --> 00:08:26,460
هل ألتقطُ صورةً تجسُّسية رائعة؟

164
00:08:34,610 --> 00:08:35,740
لقد كنتُ أنتظرك

165
00:08:36,820 --> 00:08:37,740
ليليا-تشان؟

166
00:08:38,120 --> 00:08:38,870
واضح؟

167
00:08:40,590 --> 00:08:42,890
!الثورة العالميّة

168
00:08:42,890 --> 00:08:44,870
!رائع ومُمتاز جدّاً

169
00:08:45,180 --> 00:08:47,600
نجمة في قمّة القمم

170
00:08:49,640 --> 00:08:51,880
!ثمّة وحش آخر هنا

171
00:08:52,160 --> 00:08:54,170
،بعد أن ألصقَتْ بِطاقةَ فان-سِ على حيوانِها المحشو

172
00:08:54,170 --> 00:08:56,610
.كومامي، حوّلَتْها إلى وحش

173
00:08:56,610 --> 00:09:00,470
رُغمَ عجزها عن الكلام أو الحركة، إلّا أن بالاندماج

174
00:09:00,470 --> 00:09:03,900
.تستطيعُ التحكُّم بجسدِ ليليا

175
00:09:03,900 --> 00:09:06,060
خلال هذه الفترة، تكونُ ليليا غائبة عن الوعي

176
00:09:06,060 --> 00:09:09,100
بالمناسبة، يستغرقُ تحوّلها 0.015 ثانية

177
00:09:09,100 --> 00:09:11,490
أي أسرع بـ0.005 ثانية من الفتيات السّاحرات

178
00:09:11,490 --> 00:09:14,730
،مُعتلية عرش العالم وذروة النّجوم

179
00:09:14,730 --> 00:09:16,220
اسمي ليليا من إيدورا

180
00:09:24,440 --> 00:09:25,710
!الشّعاع الأعظم

181
00:09:25,710 --> 00:09:29,210
يُطلَق شُعاع الفتاة الجميلة المجرّية المُحمِّسة للقلب

182
00:09:29,210 --> 00:09:32,550
من النّجم المتفجِّر الأعظم بواسطةِ قلبك
عندما تقومُ الإنزيمات التي تُنتجُها

183
00:09:32,550 --> 00:09:34,860
خلايا أمازوني-ن بتحطيم القلوب الشرّيرة بسُرعة

184
00:09:34,860 --> 00:09:38,520
!لتجعلها شفّافة وتطهّرها

185
00:09:44,430 --> 00:09:48,430
كُشِفَ فِلمي، كم هذا مُبهِج

186
00:09:48,430 --> 00:09:52,420
!شفّاف! أصبحُ شفّافاً

187
00:09:56,870 --> 00:09:57,900
ليليا-تشان

188
00:09:57,900 --> 00:09:59,230
توقّعتُ ذلك

189
00:09:59,230 --> 00:10:00,470
إنّها وحش

190
00:10:00,470 --> 00:10:01,700
اهزموها

191
00:10:02,300 --> 00:10:04,730
أنا البِطاقة الأخيرة

192
00:10:05,080 --> 00:10:09,240
والآن لقد حصلتُ على كافّة بِطاقات فان-سِ

193
00:10:10,080 --> 00:10:13,740
ستحقّقُ هذه القوّة أمنيتي

194
00:10:41,530 --> 00:10:42,220
ماذا؟

195
00:10:42,220 --> 00:10:43,370
ما هذا؟

196
00:10:43,690 --> 00:10:45,080
ما الذي يجري؟

197
00:10:45,380 --> 00:10:46,690
...ليليا

198
00:10:48,120 --> 00:10:49,150
يوتو؟

