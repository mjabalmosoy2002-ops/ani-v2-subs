1
00:00:20,660 --> 00:00:23,390
هل من أحد هناك؟

2
00:00:24,700 --> 00:00:25,590
مرحباً

3
00:00:27,610 --> 00:00:29,910
هل من أحد هناك؟

4
00:00:32,370 --> 00:00:33,740
أنا وحيدة

5
00:00:35,120 --> 00:00:36,910
أنا في وحدة كبيرة

6
00:00:46,340 --> 00:00:49,770
لا أريد أن أكون لوحدي بعد الآن

7
00:00:54,890 --> 00:00:57,880
لن أدعك وحيدة

8
00:01:02,660 --> 00:01:04,260
سنصِلُ عمّا قريب

9
00:01:04,260 --> 00:01:06,540
حسناً، شكراً لك

10
00:01:12,330 --> 00:01:16,360
!ليليا، ليليا، ليليا

11
00:02:54,700 --> 00:02:56,530
شكراً على الطعام

12
00:02:56,780 --> 00:02:58,090
!مفاجأة

13
00:02:58,090 --> 00:02:59,280
رائع

14
00:03:02,730 --> 00:03:04,530
إنّه لذيذ جداً

15
00:03:04,530 --> 00:03:06,510
هذا مذهل

16
00:03:06,510 --> 00:03:09,050
نعم، من المذهل أن تتمكّن أمّي

17
00:03:09,050 --> 00:03:12,170
من تحضير هذا الطعام اللذيذ والغداء الظريف كلّ يوم

18
00:03:12,170 --> 00:03:14,070
...هذا مذهلٌ أيضاً

19
00:03:14,070 --> 00:03:17,900
نعم، بالفعل، لكن أنا أقصدُ هذا

20
00:03:17,900 --> 00:03:18,670
ما هذا؟

21
00:03:18,670 --> 00:03:22,300
النّجمة المتفجِّرة العظمى
ليليا

22
00:03:18,670 --> 00:03:22,300
إصدار خاصّ للنّجمات الأجنبيّات

23
00:03:19,150 --> 00:03:22,300
النجمة المتفجِّرة الأمريكيّة ليليا، يو

24
00:03:22,670 --> 00:03:25,470
ليليا-تشان، أعرفها

25
00:03:25,810 --> 00:03:29,950
ظهرَتْ لأوّل مرّة منذُ أيّام وأصبحَتْ
أفضل نجمة في أمريكا

26
00:03:29,950 --> 00:03:32,640
يبدو أنّها ستظهرُ للمرّة الأولى في اليابان قريباً

27
00:03:33,250 --> 00:03:34,770
حقّاً؟

28
00:03:35,150 --> 00:03:36,870
أتساءلُ ما إن كنَّا سنلتقي في مكانٍ ما

29
00:03:36,870 --> 00:03:38,600
هل ستمنحُني توقيعها يا تُرى؟

30
00:03:38,600 --> 00:03:40,280
أنا متحمِّسة للغاية

31
00:03:40,530 --> 00:03:42,590
أنتِ مُسترخية تماماً

32
00:03:42,590 --> 00:03:44,130
بالفعل

33
00:03:44,130 --> 00:03:46,030
قد تنتزع منكِ العمل

34
00:03:46,370 --> 00:03:48,920
أنا أبذلُ قصارى جهدي فحسب

35
00:03:48,920 --> 00:03:49,910
كيف؟

36
00:03:49,910 --> 00:03:52,130
...كتقرير الينابيع السّاخنة و

37
00:03:52,130 --> 00:03:54,210
تِلكم البرامج مشهورة جدّاً

38
00:03:55,030 --> 00:03:56,130
ومُسلسلات الدراما

39
00:03:56,420 --> 00:03:59,670
وحتّى أنّكِ بدأتِ تحصلين على ثلاثة سطور
مُتكاملة من الحوار، صحيح؟

40
00:03:59,670 --> 00:04:03,050
وأقمتُ حفلات موسيقيّة للصيدليّة

41
00:04:03,050 --> 00:04:04,680
من المهمّ الحفاظ على عملكِ

42
00:04:05,500 --> 00:04:06,430
يو، يو

43
00:04:06,840 --> 00:04:07,680
نعم

44
00:04:10,310 --> 00:04:14,320
كلّ هذا كي نتمكّن أنا وكوكونا-تشان وتسوكاسا-كُن

45
00:04:14,320 --> 00:04:16,610
من الغِناء في قبّة سماء طوكيو سوية

46
00:04:21,250 --> 00:04:23,450
لقد انتهيتُ من أعمالي في مجلس الطلبة

47
00:04:23,720 --> 00:04:26,800
كوكونا-تشان، أحسنتِ صنعاً

48
00:04:32,730 --> 00:04:35,210
سأبدعُ في التمثيل اليوم أيضاً

49
00:04:35,450 --> 00:04:37,210
هل حفظتِ عباراتكِ؟

50
00:04:37,460 --> 00:04:40,710
نعم، عن ظهر قلب. سهرتُ اللّيل كلّه لأحفظها

51
00:04:41,140 --> 00:04:42,060
"ماذا؟"

52
00:04:42,060 --> 00:04:43,360
"مستحيل"

53
00:04:43,360 --> 00:04:45,000
"ماذا تقصدين؟"

54
00:04:45,000 --> 00:04:46,470
عن ظهرِ قلب

55
00:04:46,750 --> 00:04:48,630
أنتِ متحمِّسة لهذا حقاً

56
00:04:48,630 --> 00:04:50,050
لنبذل قصارى جهدنا

57
00:04:50,050 --> 00:04:51,600
نعم، عُلِم

58
00:04:51,820 --> 00:04:55,290
،كي لا نُعيق يو-ني

59
00:04:55,290 --> 00:04:58,360
لنندفِع بجرأة وطاقة كوموغيّة

60
00:04:58,750 --> 00:05:00,730
!صباح الخير

61
00:05:00,730 --> 00:05:02,500
ماذا؟

62
00:05:03,180 --> 00:05:04,520
ما الأمر؟

63
00:05:05,370 --> 00:05:06,690
...يا للهول

64
00:05:09,070 --> 00:05:09,990
!آسف

65
00:05:10,460 --> 00:05:12,210
ما الذي يجري؟

66
00:05:12,210 --> 00:05:15,120
لقد أُلغي التصوير فجأة

67
00:05:15,430 --> 00:05:17,400
"ماذا؟" "مستحيل"

68
00:05:17,400 --> 00:05:18,620
"ماذا تعني؟"

69
00:05:18,620 --> 00:05:20,910
جميل يا كوموغي

70
00:05:20,910 --> 00:05:23,380
حفظتِ عباراتكِ

71
00:05:23,670 --> 00:05:25,570
"ماذا؟"

72
00:05:25,570 --> 00:05:26,770
"ماذا تقصد؟"

73
00:05:26,770 --> 00:05:29,170
جميل، بدا وكأنّه حقيقيّ

74
00:05:29,170 --> 00:05:31,520
هذا ما أطلِق عليه بالتمثيل الحقيقيّ

75
00:05:33,180 --> 00:05:36,020
لماذا ألغي التصوير؟

76
00:05:36,020 --> 00:05:38,480
لماذا تتكلّمين بيابانيّة متقطِّعة؟

77
00:05:38,480 --> 00:05:40,690
...لم ترِد هذه العبارات في النصّ لِذا

78
00:05:40,690 --> 00:05:43,780
هذا سيئ، هذا سيئ، أنتِ لا ترتجلين إطلاقاً

79
00:05:43,780 --> 00:05:45,850
!حسناً، لنتدرّب

80
00:05:45,850 --> 00:05:47,400
سنقيمُ مُعسكر تدريب على الارتجال

81
00:05:48,040 --> 00:05:49,420
انسَ الأمر

82
00:05:49,420 --> 00:05:51,910
المعذرة، ماذا تعني أنّه أُلغي؟

83
00:05:52,290 --> 00:05:54,760
انصدمتُ عندما سمعتُ بالأمرِ في بادئ الأمر

84
00:05:54,760 --> 00:05:58,210
يبدو أنّهم يصوِّرون فِلماً ببطولة نجمة أخرى بدلاً من ذلك

85
00:05:59,520 --> 00:06:01,210
قال مكتبُ النّجوم

86
00:06:01,210 --> 00:06:04,380
أنّهم سيموِّلون الفِلم بأكمله

87
00:06:04,380 --> 00:06:06,660
والمبلغ ضخم جدّاً

88
00:06:06,660 --> 00:06:10,020
كُسِبَ الزبون بمقدار كبير من المال

89
00:06:10,020 --> 00:06:11,470
أنا حقّاً آسف

90
00:06:11,760 --> 00:06:14,280
حقّاً؟ هذا مُؤسِف

91
00:06:14,280 --> 00:06:16,980
حسناً، لا تستسلمي، يحدثُ ذلك أحياناً

92
00:06:17,250 --> 00:06:20,280
ابتهجي ولننتقل إلى العمل التّالي

93
00:06:20,280 --> 00:06:22,040
كوموغي، عليكِ إعداد تقرير عن الينابيع السّاخنة

94
00:06:22,040 --> 00:06:23,980
كوكونا، عليكِ تصوير برنامج حواري

95
00:06:24,350 --> 00:06:27,820
تسوكاسا-كُن ويوتو-كُن، هل نذهبُ للتدريب؟

96
00:06:28,130 --> 00:06:29,800
لننتقل إلى العمل التّالي

97
00:06:29,800 --> 00:06:30,480
نعم

98
00:06:30,480 --> 00:06:32,070
نعم، معك حقّ

99
00:06:32,360 --> 00:06:34,190
ماذا؟

100
00:06:34,490 --> 00:06:37,080
تلقّيتُ للتو مكالمةً من المحطّة التلفزيونيّة

101
00:06:37,510 --> 00:06:39,500
لقد أُلغي هذا البرنامج

102
00:06:39,500 --> 00:06:41,750
...مستحيل

103
00:06:39,500 --> 00:06:44,750
نستخدمُ المناشفَ بغرض التصوير السنمائي

104
00:06:41,750 --> 00:06:43,550
،لستُ أفهم

105
00:06:43,550 --> 00:06:47,540
لكن تمَّ شِراء خانتنا بواسطة مكتب نجوم ما

106
00:06:47,540 --> 00:06:50,630
وسيُعرَضُ برنامج النُّجوم ذاك اعتباراً من الأسبوع المقبل

107
00:06:54,900 --> 00:06:56,930
كونا-تشان وتسوكاسا-تشان أيضاً؟

108
00:06:56,930 --> 00:07:01,790
نعم، تمّ شراء خانتنا الزمنيّة المخصّصة
لبرنامجنا الحواري، لهذا ألغي

109
00:07:01,790 --> 00:07:04,440
لقد ألغي برنامج يوتو وبرنامجي أيضاً

110
00:07:04,660 --> 00:07:06,780
كنّا سنؤدّي البطولة معاً أيضاً

111
00:07:06,780 --> 00:07:07,460
ماذا؟

112
00:07:07,850 --> 00:07:09,240
لا شيء

113
00:07:09,500 --> 00:07:12,910
قالت الرّئيسة أي أنّ النجمات الأُخريات

114
00:07:12,910 --> 00:07:14,620
قد أُلغيَتْ أعمالهن أيضاً

115
00:07:15,180 --> 00:07:17,460
لكن هذا مذهل

116
00:07:17,840 --> 00:07:20,000
نعم، بالفعل

117
00:07:21,280 --> 00:07:24,650
هل من مُستجدَّات بخصوص مثلَّث الحب؟

118
00:07:26,100 --> 00:07:27,680
لا أستطيع سماعهن

119
00:07:27,680 --> 00:07:28,590
هذا مذهل

120
00:07:28,590 --> 00:07:29,480
يو؟

121
00:07:29,480 --> 00:07:31,290
هذا مذهل جدّاً

122
00:07:31,290 --> 00:07:33,630
،كان النّاس يوصفونه بالمذهل

123
00:07:33,630 --> 00:07:35,700
لكن لم أكن أدري أنّه مذهل إلى هذا الحدّ

124
00:07:35,700 --> 00:07:38,000
ما هو المُذهل؟

125
00:07:38,350 --> 00:07:41,140
ألم يشعرن بشيء مُذهل إلى هذا الحدّ من قبل؟

126
00:07:42,860 --> 00:07:46,480
إنّها النّجمة المتفجِّرة الأمريكية العُظمى ليليا-تشان، صحيح؟

127
00:07:46,740 --> 00:07:48,980
على أي حال، أتُريدان الذهاب

128
00:07:48,980 --> 00:07:50,860
إلى إعلان الغدّ سوية؟

129
00:07:51,240 --> 00:07:52,420
نحنُ الثلاثة؟

130
00:07:52,420 --> 00:07:54,120
نعم، بكلِّ سرور

131
00:07:54,120 --> 00:07:56,580
قال يوتو أنّه سيأتي معنا

132
00:07:56,980 --> 00:07:58,100
...علاقتهم

133
00:07:58,400 --> 00:08:02,370
تزدادُ تعقيداً أكثر فأكثر على ما يبدو...

134
00:08:02,370 --> 00:08:04,750
يُقامُ مُؤتمرٌ صحفيّ

135
00:08:04,750 --> 00:08:06,880
في قصر شيتاماتشي إيدو

136
00:08:07,130 --> 00:08:08,690
لعبة ورق بوري وبارا المشهورة كثيراً

137
00:08:08,690 --> 00:08:11,380
بين الأطفال ستحظى بأنِمي أخيراً

138
00:08:12,090 --> 00:08:15,390
إنّه المُؤتمر الصحفيّ الرسميّ للإعلانات المتعلِّقة
بأنِمي بوري بارا

139
00:08:15,930 --> 00:08:19,260
وسيلعبُ يو-ني دورَ أحد النّجوم
شريحة لحم التنُّورة ماكسيمليان

140
00:08:19,690 --> 00:08:22,890
بالإضافة إلى بطولة كوكونا-تشان بدور البطلة كالبيكو-تشان

141
00:08:23,150 --> 00:08:24,830
وأيضاً من بطولة تسوكاسا-كُن بدور

142
00:08:24,830 --> 00:08:27,270
مُنافِس شريحة لحم التنُّورة، أمير بوري بريوش

143
00:08:27,560 --> 00:08:30,980
ومن بين الشخصيات الدّاعمة، لسان ورأس
وكتف مشوي وأحشاء وكرش

144
00:08:30,980 --> 00:08:35,220
ترقوّة وقشّة

145
00:08:35,220 --> 00:08:37,660
ستلعبُ يوشيدا كوموغي دور العنق

146
00:08:37,660 --> 00:08:41,120
بالمناسبة، لماذا قصر شيتاماتشي إيدو؟

147
00:08:41,120 --> 00:08:44,690
لأنّنا نريدُ ربطه ببوري بارا قليلاً

148
00:08:44,690 --> 00:08:46,380
من المهمّ ربط الأمور

149
00:08:47,480 --> 00:08:49,550
أشعرُ بتوتُّر بعض الشيء

150
00:08:49,930 --> 00:08:52,670
أعلمُ أنّه دور داعِم، لكنّه أساسيّ

151
00:08:52,890 --> 00:08:54,690
لقد اقتربَ الوقت

152
00:08:54,690 --> 00:08:56,090
هيّا بنا

153
00:08:59,290 --> 00:09:00,510
الرّئيسة أي؟

154
00:09:01,670 --> 00:09:03,220
لقد أُلغي

155
00:09:03,560 --> 00:09:04,370
ماذا؟

156
00:09:05,340 --> 00:09:07,060
لقد أُلغي بوري بارا

157
00:09:07,370 --> 00:09:09,570
ماذا؟

158
00:09:09,570 --> 00:09:10,560
"ماذا؟"

159
00:09:10,560 --> 00:09:11,650
"مستحيل"

160
00:09:11,650 --> 00:09:12,820
"ماذا تقصدين؟"

161
00:09:13,520 --> 00:09:17,450
لقد تمَّ شِراء الخانة الزمنيّة لأنمي بوري بارا
بواسطة مكتب ليليا للمواهب

162
00:09:17,780 --> 00:09:19,450
ليليا مجدّداً؟

163
00:09:20,090 --> 00:09:23,070
لقد تحوّلَ المُؤتمر الصحفي إلى إعلان عن ليلي بارا

164
00:09:23,070 --> 00:09:24,710
لقد تمَّ الاستحواذ على خانة بوري بارا بواسطة

165
00:09:25,240 --> 00:09:27,410
برنامج يُدعى جنّة ليليا، أو ليلي بارا كاختصار

166
00:09:27,410 --> 00:09:30,710
يُربَطُ قصرُ شيتاماتشي إيدو بليليا

167
00:09:31,410 --> 00:09:32,930
أنذهب إذاً؟

168
00:09:32,930 --> 00:09:33,710
نعم

169
00:09:34,090 --> 00:09:35,610
أحسنتُم صنعاً جميعاً

170
00:09:35,610 --> 00:09:36,970
نستأذن

171
00:09:44,780 --> 00:09:47,230
،بما أنَّنا هنا

172
00:09:47,230 --> 00:09:49,040
لِمَ لا نخرج ونتنزّه في يوم الإجازة
غير المتوقّعة هذا؟

173
00:09:49,040 --> 00:09:50,080
نتنزّه؟

174
00:09:50,390 --> 00:09:51,650
بالتأكيد، تبدو فكرة سديدة

175
00:09:53,170 --> 00:09:56,010
حسناً، لا مُشكلة، إذ ليس لدينا أي عمل اليوم

176
00:09:56,010 --> 00:09:58,860
نعم، ينبغي أن تنسوا كلّ شيء وتستمتعوا

177
00:09:59,180 --> 00:10:01,050
ما-ماذا ستفعلُ يا يوتو؟

178
00:10:01,470 --> 00:10:02,850
...في الحقيقة

179
00:10:03,610 --> 00:10:06,740
لن أذهب، استمتعن أنتُن

180
00:10:06,740 --> 00:10:08,310
ح-حقّاً؟

181
00:10:12,260 --> 00:10:14,940
كوكونا-تشان وتسوكاسا-كُن، ماذا تُريدان أن تريا؟

182
00:10:14,940 --> 00:10:18,630
السقوط الحرّ السريع؟ أم قاطرة دايميو السريعة؟

183
00:10:19,080 --> 00:10:20,960
بيت المُحارِب السّاقِط المسكون

184
00:10:20,960 --> 00:10:23,310
أودُّ أن أرى "نامبا ران" ثلاثي الأبعاد أيضاً

185
00:10:23,310 --> 00:10:25,350
لنرهم كلّهم إذاً

186
00:10:29,510 --> 00:10:30,850
هل من مُشكلة؟

187
00:10:30,850 --> 00:10:31,530
ماذا؟

188
00:10:31,530 --> 00:10:33,980
آه لا، أنا آسفة

189
00:10:34,240 --> 00:10:37,060
انفصلتُ عن مجموعتي وقد تهت

190
00:10:37,440 --> 00:10:40,320
هل تعرفين أين تقعُ صالة قصر دايميو؟

191
00:10:40,800 --> 00:10:44,240
صالة قصر دايميو؟ سنأخذكِ إلى هناك

192
00:10:44,490 --> 00:10:46,500
...ماذا؟ ل-لكن

193
00:10:48,910 --> 00:10:51,240
لا مُشكلة، لا داعي للقلق

194
00:10:51,240 --> 00:10:52,750
من هنا، من هنا

195
00:10:56,140 --> 00:10:57,320
ما الأمر؟

196
00:10:57,320 --> 00:10:57,880
ماذا؟

197
00:10:58,150 --> 00:10:59,380
هل أصبتِ بالرشح؟

198
00:10:59,380 --> 00:11:01,980
آه لا، أنا أتحصّنُ فحسب

199
00:11:02,320 --> 00:11:03,990
هذه النظّارة الشمسيّة لطيفة

200
00:11:03,990 --> 00:11:05,760
الضوء مُبهِر في الخارج

201
00:11:05,760 --> 00:11:07,380
بالفعل

202
00:11:10,280 --> 00:11:12,170
...من الواضح أنَّ تِلك الفتاة

203
00:11:12,570 --> 00:11:14,690
هي ليليا، صحيح؟

204
00:11:15,140 --> 00:11:17,490
ما اسمك؟

205
00:11:17,490 --> 00:11:19,120
ليليا

206
00:11:19,120 --> 00:11:20,380
ليليا-تشان

207
00:11:20,380 --> 00:11:22,000
ليليا-تشان، صحيح؟

208
00:11:22,000 --> 00:11:25,580
نفس اسم ليليا-تشان

209
00:11:25,970 --> 00:11:27,690
لحظة، أنتِ ليليا-تشان

210
00:11:27,690 --> 00:11:28,830
هل أنتِ هي فعلاً؟

211
00:11:29,110 --> 00:11:30,710
نعم

212
00:11:31,950 --> 00:11:33,420
أنا هي فعلاً

213
00:11:34,680 --> 00:11:36,630
هنيئاً، إنّها ليليا-تشان

214
00:11:36,630 --> 00:11:39,340
!رائع، يا لظرافتكِ

215
00:11:39,660 --> 00:11:42,300
ش-شكراً لكِ

216
00:11:43,060 --> 00:11:46,140
أنتُما سايونجي-سان وكيساراغي-سان، صحيح؟

217
00:11:46,140 --> 00:11:47,040
ماذا؟

218
00:11:47,590 --> 00:11:48,930
أتعرفين من نكون؟

219
00:11:49,290 --> 00:11:52,980
"نعم، لقد اطّلعتُ على الدراما الخاص بكِ "ملفّات تاكس

220
00:11:53,360 --> 00:11:55,690
وأدواركِ في تمثيلِ المخلوق الفضائي

221
00:11:55,690 --> 00:11:59,530
والجثّة والينابيع السّاخنة كانت رائعة كذلك يا يوشيدا-سان

222
00:11:59,530 --> 00:12:01,070
أتعرفين أعمالي أيضاً؟

223
00:12:01,510 --> 00:12:02,390
نعم

224
00:12:02,390 --> 00:12:06,080
أنا مسرورةٌ جدّاً بلِقائي ببعض النّجمات الأكبر سنّاً

225
00:12:06,380 --> 00:12:09,870
لقد درستِ عن نجماتِ بلدنا إذاً

226
00:12:10,370 --> 00:12:11,670
أنا مسرورة بذلك

227
00:12:16,940 --> 00:12:18,520
ليليا-تشان، أتريدين الرّكوب؟

228
00:12:18,520 --> 00:12:19,050
ماذا؟

229
00:12:19,050 --> 00:12:21,470
لنركبها، هيّا، لنذهب

230
00:12:21,780 --> 00:12:24,430
...ماذا؟ لكن

231
