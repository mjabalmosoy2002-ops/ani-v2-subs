1
00:00:03,920 --> 00:00:06,140
احرقوا المساكن

2
00:00:06,140 --> 00:00:08,240
سوف نستدرج عشتار للدّخول

3
00:00:08,530 --> 00:00:09,620
يوري-ساما

4
00:00:09,620 --> 00:00:11,570
ينوي أورهي حرق المدينة بالكامل

5
00:00:12,380 --> 00:00:14,300
لا ينبغي أن تُغادري الآن

6
00:00:14,300 --> 00:00:19,630
حتّى لو هربتِ، هاتّوسا محفوفة
بالمخاطر ما دمتِ مُتَّهمة

7
00:00:19,630 --> 00:00:20,500
لا

8
00:00:20,780 --> 00:00:23,000
أنا من يريدونها

9
00:00:23,000 --> 00:00:26,720
إذا غادرت، لا يملكون سبباً لحرق المدينة

10
00:00:26,720 --> 00:00:27,800
...لكن

11
00:00:27,800 --> 00:00:32,150
يوري-ساما، أقسمنا الولاء لكِ

12
00:00:32,150 --> 00:00:37,430
حتّى أطفالنا سيضحّون بأرواحهم
لحمايتك من الضّرر

13
00:00:37,430 --> 00:00:40,310
...شكراً لك يا تالوس. لكن

14
00:00:40,570 --> 00:00:45,590
،الحديد الّذي تصنعونه مُهمٌّ جدّاً بالنّسبة لنا
لذا يجب علينا تجنُّب مجزرة

15
00:00:45,590 --> 00:00:48,820
ينبغي أن توفّروا تلك المهارات للأمير

16
00:00:49,200 --> 00:00:50,520
يوري-ساما

17
00:00:51,640 --> 00:00:54,280
استعجلوا. لا تدعوا عشتار تهرب

18
00:00:56,730 --> 00:00:58,800
يجب علينا القضاء على مُحرّضهم

19
00:00:59,250 --> 00:01:02,340
روسافا، أنت قائد النبّالين، أليس كذلك؟

20
00:01:02,340 --> 00:01:04,750
سمعتُ بأنّك أفضل نبّال بين الهيتايتي

21
00:01:04,750 --> 00:01:06,630
هل تعتقد بأنّك تستطيع إصابة أورهي؟

22
00:01:06,930 --> 00:01:07,710
ماذا؟

23
00:01:08,040 --> 00:01:11,220
،إذا غرست سهماً في أورهي
فسيُزعزع ذلك صفوفَ العدوّ

24
00:01:11,220 --> 00:01:13,010
سيمنحني هذا فُرصةً للهرب

25
00:01:15,350 --> 00:01:18,640
تالوس، ما أقوى قوس لديك؟

26
00:01:19,010 --> 00:01:22,140
لدينا قوس مراسميّ يتطلّب
استخدامه ثلاثة رجال

27
00:01:22,140 --> 00:01:23,900
هل يمكنك استعماله؟

28
00:01:24,980 --> 00:01:27,170
تأمرني يوري-ساما بذلك

29
00:01:27,170 --> 00:01:29,110
لا يمكنني رفضها

30
00:01:29,110 --> 00:01:32,690
الهاتّي الّذين يأوون المغتالَ مُجرمين مثلها

31
00:01:32,690 --> 00:01:34,200
يمكنكم قتلهم جميعاً

32
00:01:54,930 --> 00:01:57,970
أورهي، يجب أن تنزف

33
00:01:58,240 --> 00:02:01,770
!بدلاً من جعل الآخرين يُراق دمهم لأجلك

34
00:02:03,690 --> 00:02:05,170
جهِّزوا السِّهامَ النّاريّة

35
00:02:09,580 --> 00:02:10,900
عـ-عيني

36
00:02:10,900 --> 00:02:11,890
!أورهي-ساما

37
00:02:11,890 --> 00:02:13,250
!أُصيبَ أورهي-ساما

38
00:02:14,680 --> 00:02:15,530
!انطلقوا الآن

39
00:02:16,820 --> 00:02:18,030
!افتحوا البوّابة

40
00:03:54,430 --> 00:03:56,760
حلم ذلك اليوم الرّائع

41
00:03:58,370 --> 00:04:00,760
ما الّذي يحدث في آلينا؟

42
00:04:01,550 --> 00:04:02,930
يجب أن أذهب

43
00:04:03,470 --> 00:04:04,890
!ما زلت تمنعني؟

44
00:04:04,890 --> 00:04:11,230
أخبرتُك مراراً بأنّ الزّحف بجنودك
سيُشعل حرباً أهليّة

45
00:04:11,750 --> 00:04:13,940
إذا أخطأتَ بنفس الطّريقة الّتي
،أخطأت فيها الملكة

46
00:04:13,940 --> 00:04:17,650
فسوف تُعرَّض تتويجك لخطر

47
00:04:18,000 --> 00:04:19,740
العرش تحت أنظارك

48
00:04:19,740 --> 00:04:21,530
أتوسّل إليك أن تنتظر

49
00:04:21,530 --> 00:04:24,820
لكن إذا تأخّرت، ستبقى يوري في خطر

50
00:04:25,990 --> 00:04:27,450
إيباني-ساما

51
00:04:30,660 --> 00:04:32,550
حلمي هو أن أراك ملِكاً

52
00:04:32,550 --> 00:04:36,780
وأحلم بالحُكم المثاليّ الّذي سينتج عن تتويجك

53
00:04:36,780 --> 00:04:39,880
إذا لم أحقّق ذلك الحلم، فلا معنى من حياتي

54
00:04:40,690 --> 00:04:43,390
إذا كنت لا تزال مُصرّاً على تعبئة قوّاتك

55
00:04:43,670 --> 00:04:47,140
فسوف تذهب روحي إلى نيرغال في العالم السُّفليّ

56
00:04:52,400 --> 00:04:54,230
!توقّفي يا عشتار

57
00:04:54,230 --> 00:04:55,520
!لن تفلتي

58
00:04:56,950 --> 00:04:57,990
!احذري

59
00:05:01,070 --> 00:05:02,480
!يوري-ساما

60
00:05:06,390 --> 00:05:08,500
لا أستطيع التنفُّس. النّجدة

61
00:05:08,770 --> 00:05:10,910
فليُساعدني أحدٌ ما

62
00:05:10,910 --> 00:05:12,870
!يوري-ساما

63
00:05:19,910 --> 00:05:21,210
رمسيس؟

64
00:05:22,220 --> 00:05:23,300
شكراً

65
00:05:23,300 --> 00:05:25,860
أعدني إلى هاتّوسا الآن رجاء

66
00:05:25,860 --> 00:05:28,460
أعدني إلى الأمير كايل

67
00:05:28,460 --> 00:05:29,970
تمزحين بالتّأكيد

68
00:05:30,900 --> 00:05:34,970
من ينقذ فتاةً ليُسلّمها لرجل آخر فحسب؟

69
00:05:34,970 --> 00:05:37,940
لستُ أميراً يهوى الفروسيّة

70
00:05:37,940 --> 00:05:40,690
أنا رجلٌ يأخذ ما يريد

71
00:05:40,690 --> 00:05:42,950
سواء كانت امرأة أو مملكة

72
00:05:42,950 --> 00:05:44,660
عمّاذا تتكلّم؟

73
00:05:44,660 --> 00:05:49,360
كنتُ أنتظر انفصالكِ عن الأمير

74
00:05:49,360 --> 00:05:51,780
ستحبّين موطني منف

75
00:05:51,780 --> 00:05:54,220
سأستغرق وقتي في تعليمكِ كُلّ شيء هناك

76
00:05:54,220 --> 00:05:55,710
!لـ-لا، لا تفعل

77
00:05:56,790 --> 00:05:57,520
!أسرع

78
00:05:57,520 --> 00:06:00,850
!ا-انتظر! لا تأخذني إلى هناك

79
00:06:00,850 --> 00:06:02,970
!مهلاً يا رمسيس

80
00:06:02,970 --> 00:06:04,280
يوري-ساما

81
00:06:07,620 --> 00:06:10,720
يرفض سموُّه أكل طعامه ثانية

82
00:06:10,720 --> 00:06:12,260
أنا لا ألومه

83
00:06:12,260 --> 00:06:16,310
لا بُدّ أنّ عجزه عن إنقاذ يوري-ساما يؤلمه كثيراً

84
00:06:16,310 --> 00:06:21,570
،إيباني-ساما يضحّي بسمعته من أجل إبقائه هنا
لكن لا يمكن أن يكون هذا مقبولاً

85
00:06:21,570 --> 00:06:24,110
لا أُمانع أن يكرهني

86
00:06:24,380 --> 00:06:27,740
لكن هذا الوضع أوقعنا في مأزق

87
00:06:28,140 --> 00:06:32,500
كيف نوصل سموّه إلى العرش ونُعيد يوري-ساما؟

88
00:06:32,920 --> 00:06:36,500
لا يمكن فعل شيء حتّى نقبض على قاتل الملِك

89
00:06:37,180 --> 00:06:38,800
،إذا قبضنا على المُجرم

90
00:06:38,800 --> 00:06:42,430
فسيُعَدّ انتشار جنود الملِكة سلوكاً مُخلّاً بالنّظام

91
00:06:42,900 --> 00:06:46,660
،حينئذ يحقُّ لسموّه بأن يقمع العنف

92
00:06:46,660 --> 00:06:48,760
باعتباره ملِك مُستقبليّ

93
00:06:48,760 --> 00:06:54,410
،نعلم بأنّ أورهي هو القاتل الحقيقيّ
لكنّه محميّ بواسطة الملكة

94
00:06:54,410 --> 00:06:57,940
ربّما يستطيع أن يزعم شخصٌ بأنّه
المُجرم لكسب الوقت لنا

95
00:06:58,300 --> 00:07:01,330
لكن سيُخاطر ذلك الشّخص بالحُكم عليه بالإعدام

96
00:07:01,770 --> 00:07:04,280
هذا ليس ادّعاء يمكن المُزاح به

97
00:07:04,790 --> 00:07:08,950
لو كان الأمر بتلك البساطة، لسلّمتُ
نفسي منذ فترة طويلة

98
00:07:08,950 --> 00:07:13,260
إذاً لا يمكننا التحرُّك دون القبض على مُجرم

99
00:07:13,260 --> 00:07:14,330
أحمل تقريراً

100
00:07:14,580 --> 00:07:18,790
وصلَ القائدُ العسكريّ روسافا للتو
رفقة هادي وأختيها

101
00:07:19,150 --> 00:07:20,040
!هادي

102
00:07:20,040 --> 00:07:24,170
سموّك، تمَّ اختطاف يوري-ساما بواسطة رمسيس

103
00:07:24,170 --> 00:07:25,170
ماذا؟

104
00:07:25,170 --> 00:07:26,990
!سامحنا أرجوك

105
00:07:26,990 --> 00:07:30,050
ماذا يعتقد رمسيس نفسه فاعلاً؟

106
00:07:30,410 --> 00:07:31,690
رمسيس

107
00:07:31,690 --> 00:07:34,800
عرفتُ بأنّ عينيه كانتا تشتعلان طموحاً

108
00:07:34,800 --> 00:07:39,650
.تساءلتُ عن سبب اختياره الخدمة في هاتّوسا
كان هدفه يوري إذاً

109
00:07:39,650 --> 00:07:41,150
!كيكّوري! سرِّج حصاني

110
00:07:41,480 --> 00:07:42,070
!سموّك

111
00:07:42,070 --> 00:07:44,780
!ابتعد! لن يوقفني أحدٌ الآن

112
00:07:45,090 --> 00:07:45,860
!هيّا بنا

113
00:07:45,860 --> 00:07:47,400
!الأمير كايل، انتظر

114
00:07:49,500 --> 00:07:51,540
ربّما كان مُجرّد حلم

115
00:07:52,160 --> 00:07:56,280
حلم عالم مثاليّ ابتغاه كافّة الأشخاص
الحالمين بالمثاليّة في هذا العالم

116
00:07:56,840 --> 00:07:59,270
كرّستُ نفسي لخدمة الأمير كايل

117
00:07:59,270 --> 00:08:03,290
لأنّني ظننتُ بأنّه الرّجل الّذي سيجعل
ذلك الحلم حقيقة

118
00:08:03,920 --> 00:08:06,390
الآن أمسى ذلك الحلم قريباً من الزّوال

119
00:08:07,260 --> 00:08:10,740
احرصوا على ألّا يسمع أحدٌ من خارج
!القصر بهذا الأمر

120
00:08:10,740 --> 00:08:13,530
يجب ألّا يعلم أحدٌ بأنَّ سموّه غادر القصر

121
00:08:13,530 --> 00:08:14,310
!حالاً

122
00:08:14,310 --> 00:08:15,940
ماذا الآن؟

123
00:08:15,940 --> 00:08:18,560
سبّبنا مزيداً من المتاعب

124
00:08:24,190 --> 00:08:26,070
أورسولا؟ ما المُشكلة؟

125
00:08:26,560 --> 00:08:27,550
كاش

126
00:08:28,070 --> 00:08:30,460
ماذا يُفترض بي أن أفعل؟

127
00:08:30,460 --> 00:08:34,780
الآنسة هادي وأختاها عرضنَ أرواحهن
لحماية يوري-ساما

128
00:08:34,780 --> 00:08:36,870
بينما أنا لم أفعل شيئاً

129
00:08:36,870 --> 00:08:40,000
يجدر بكِ أن تفعلي ما يمكنكِ فعله فقط

130
00:08:40,000 --> 00:08:43,820
لكن هذه الأزمة هي من صنيعي

131
00:08:43,820 --> 00:08:46,760
ورّطتُ يوري-ساما في مؤامرة الملكة بحماقة

132
00:08:46,760 --> 00:08:50,460
لا الأمير ولا يوري-ساما يلومانكِ على ذلك

133
00:08:50,460 --> 00:08:51,100
—لكن

134
00:08:51,100 --> 00:08:52,160
هذا يكفي

135
00:08:56,270 --> 00:08:59,290
كان ذلك عديم اللّباقة بعد انفصال
الأمير كايل عن يوري-ساما

136
00:08:59,290 --> 00:09:02,110
لكنّنا مُضطرّان للانتظار فترة أطول للعيش معاً

137
00:09:02,110 --> 00:09:04,180
لذا لا ضير من استراحة قصيرة

138
00:09:04,180 --> 00:09:05,020
...كاش

139
00:09:05,270 --> 00:09:09,890
يمكنكِ أن تُعدّي وليمةً لهما عندما يعودان

140
00:09:11,450 --> 00:09:16,000
أعاني كثيراً لأنّ الأمير ويوري-ساما
يرفضان إلقاء اللّوم عليّ

141
00:09:30,630 --> 00:09:32,580
...إذا قبضوا على مُجرم

142
00:09:33,820 --> 00:09:36,530
تريدين التكلُّم معي؟

143
00:09:36,530 --> 00:09:37,390
أجل

144
00:09:37,830 --> 00:09:42,020
لديّ شهادة بشأن مقتل الملِك الرّاحل

145
00:09:42,750 --> 00:09:46,440
كنتُ أنا من قتلَ جلالة الملك

146
00:09:47,860 --> 00:09:48,780
ماذا قلتِ؟

147
00:09:49,180 --> 00:09:51,900
اعترفتْ أورسولا بقتل الملك؟

148
00:09:51,900 --> 00:09:53,240
جنون

149
00:09:53,940 --> 00:09:55,070
أورسولا؟

150
00:09:55,390 --> 00:09:59,450
أجل. يطلبون منكِ التوجُّه إلى قصر الملِك فوراً

151
00:10:00,110 --> 00:10:02,120
لماذا تفعل ذلك؟

152
00:10:03,710 --> 00:10:05,960
فخامتكِ وكافّة الحاضرين

153
00:10:06,460 --> 00:10:08,420
،كما سمعتُم

154
00:10:08,420 --> 00:10:13,970
اعترفتْ فتاةٌ بعمليّة الاغتيال ونحن هنا لاستجوابها

155
00:10:14,280 --> 00:10:17,100
هذه هي المرأة الّتي تزعم مسؤوليّتها عن الجريمة

156
00:10:17,100 --> 00:10:17,900
!أوسولا

157
00:10:17,900 --> 00:10:18,640
!كاش

158
00:10:18,640 --> 00:10:20,680
!أورسولا ليست الجانية

159
00:10:20,680 --> 00:10:22,730
!لا يمكن أن تكون قد فعلَتْها

160
00:10:23,000 --> 00:10:24,480
نعلم

161
00:10:24,930 --> 00:10:28,230
لا أرى وليّ العهد بيننا

162
00:10:29,440 --> 00:10:33,950
سموّه يستريح بعد مرضه بسبب التوتُّر المُتكرِّر

163
00:10:33,950 --> 00:10:37,410
استلمتُ رسالةً تُعيّنني وكيلاً له

164
00:10:37,690 --> 00:10:42,410
فليكُن ذلك. سوف نُتابع الإجراءات
من دون وليّ العهد

165
00:10:43,200 --> 00:10:49,750
يا امرأة، أسألكِ مرّة أخيرة ما إن كنتِ
الشّخص الّذي اغتالَ الملِك

166
00:10:50,070 --> 00:10:54,700
أجل، أنا المُجرمة الخائنة الّتي قتلتْ جلالته

167
00:10:54,700 --> 00:10:59,550
أطالب بعقوبة وبأن يعمّ سلامٌ فوريّ
أرجاء الإمبراطوريّة

168
00:10:59,550 --> 00:11:00,740
هذا مُستحيل

169
00:11:00,740 --> 00:11:02,810
أورسولا، لماذا تفعلين هذا؟

170
00:11:06,130 --> 00:11:09,830
أعتقد بأنّها تعمل كخادِمة في قصر وليّ العهد

171
00:11:09,830 --> 00:11:14,450
لا أعتقد بأنّ مُجرّد خادمة قادرة على
تخطيط خيانة كهذه لوحدها

172
00:11:14,450 --> 00:11:17,700
هل هناك من يتحكّم بكِ؟

173
00:11:17,950 --> 00:11:18,940
معها حقّ

174
00:11:18,940 --> 00:11:21,200
ربّما يكون وليّ العهد؟

175
00:11:21,200 --> 00:11:25,460
هل تحاول الملكةُ توريط الأمير كايل؟

176
00:11:29,170 --> 00:11:33,350
يا امرأة، أعتقد بأنّ فخامتها على حقّ

177
00:11:33,350 --> 00:11:36,430
هل أُمرتِ بارتكاب جريمة شنيعة كهذه؟

178
00:11:37,350 --> 00:11:39,140
قولي الحقيقة

179
00:11:39,140 --> 00:11:41,760
من أمرَ بتنفيذ هذه الجريمة؟

180
00:11:41,760 --> 00:11:44,730
بكلّ تأكيد، سأخبرك بكلّ شيء

181
00:11:47,110 --> 00:11:53,070
أُمِرتُ بواسطة الأرملة الملكة بقتل جلالة الملك

182
00:11:53,070 --> 00:11:53,940
ماذا؟

183
00:11:53,940 --> 00:11:55,360
ماذا قلتِ؟

184
00:11:55,360 --> 00:11:57,990
الملكةُ أمرتْ بذلك؟

185
00:11:57,990 --> 00:11:59,030
!كذِب وافتراء

186
00:11:59,030 --> 00:12:04,820
وفوق ذلك. أُمِرتُ أيضاً باتِّهام عشتار
ظلماً وبهتاناً

187
00:12:04,820 --> 00:12:09,300
جاء الأمر من مُساعدها، أورهي-ساما

188
00:12:09,300 --> 00:12:12,530
إن كنتُم تشكّون بي، فاسألوا شعب كاتابا

189
00:12:15,130 --> 00:12:19,050
خطّطت الملكةُ لاغتيال الملك؟

190
00:12:19,050 --> 00:12:22,100
لكن ظننتُ بأنّ عشتار المُقدّسة هي المُتَّهمة

191
00:12:22,370 --> 00:12:24,770
أخبرينا بالمزيد عمّا حدث في كاتابا

192
00:12:24,770 --> 00:12:29,100
لن أكون جزءاً من هذا التّحقيق السّخيف. سأُغادر

193
00:12:29,670 --> 00:12:31,400
فخامتكِ، انتظري رجاء

194
00:12:31,400 --> 00:12:34,060
لن تُجيب فخامتها عن التّهم

195
00:12:32,320 --> 00:12:34,070
ما الّذي يجري؟

196
00:12:34,070 --> 00:12:36,600
نحن لا نعرف شيئاً الآن

197
00:12:34,770 --> 00:12:36,140
انتهت هذه الجلسة

198
00:12:36,140 --> 00:12:37,710
خذوا المرأة بعيداً

199
00:12:40,530 --> 00:12:41,730
!أورسولا

200
00:12:41,730 --> 00:12:43,780
لِمَ تعترفين بالجريمة؟

201
00:12:48,540 --> 00:12:51,330
أصدقائي الأعزّاء، كنتُم جميعاً لطيفين معي

202
00:12:51,790 --> 00:12:53,210
أشكرك على كلّ شيء

203
00:12:55,760 --> 00:12:56,880
إيلباني-ساما

204
00:12:58,480 --> 00:13:04,640
عسى أن ترى يوري-ساما عائدة
بسلام في أسرع وقت

205
00:13:08,160 --> 00:13:11,900
ماذا نفعل؟ ستُعدَم أورسولا
!إذا لم نفعل شيئاً

206
00:13:11,900 --> 00:13:13,770
سأذهب لإبلاغ الأمير كايل

207
00:13:14,240 --> 00:13:16,470
أعلم بأنّه يستطيع التدخُّل

208
00:13:16,470 --> 00:13:18,240
لا يمكنك أن تُبلغه

209
00:13:18,240 --> 00:13:23,280
أجل، سيثبت سموُّه براءتها إن كان هنا

210
00:13:23,280 --> 00:13:25,870
لكن هذا سيُعيدنا إلى حيث بدأنا

211
00:13:25,870 --> 00:13:29,380
لكن الطّريق الّذي تختاره سيؤدّي
!إلى وفاة أورسولا

212
00:13:29,380 --> 00:13:31,500
!لم تفعل شيئاً يستحقُّ ذلك

213
00:13:31,780 --> 00:13:33,170
أعلم ذلك

214
00:13:33,590 --> 00:13:34,500
...لكن

215
00:13:35,960 --> 00:13:39,060
هيّأتْ أورسولا فُرصةً لنا

216
00:13:39,060 --> 00:13:43,670
سننتهز هذه الفُرصة لدفن الملِكة
وإيصال الأمير كايل للعرش

217
00:13:44,630 --> 00:13:46,460
هيّا. افتحي فمكِ

218
00:13:46,850 --> 00:13:49,440
عليكِ أن تأكلي للبقاء سليمة صحّياً

219
00:13:49,440 --> 00:13:51,660
أنتِ نحيلة للغاية

220
00:13:51,660 --> 00:13:54,690
إذاً فكّ قيدي فحسب وذلك كي
أتمكّن من الأكل بمفردي

221
00:13:54,690 --> 00:13:56,820
لكن ستحاولين الهرب إذا فعلتُ ذلك

222
00:13:56,820 --> 00:13:58,100
سأفعل ذلك بكلّ تأكيد

223
00:13:58,100 --> 00:14:01,900
فأنا لا أريد السّفر إلى مصر أو أكون حبيبتك

224
00:14:01,900 --> 00:14:06,340
أخبرتُكِ بالفعل بأنّني أحصل دوماً
،على أيّ شيء تراه عيناي

225
00:14:06,340 --> 00:14:07,700
سواء كان مملكة أو امرأة

226
00:14:07,700 --> 00:14:11,100
مهلاً. تريد أن تكون ملك الهيتّايتي؟

227
00:14:11,100 --> 00:14:15,290
إيّاك أن تفعل. لدينا ما يكفي من
مشاكل مع الملِكة

228
00:14:15,290 --> 00:14:19,540
أرديكِ فقط أن تُفكّري في أن تكوني امرأتي

229
00:14:19,540 --> 00:14:23,470
وبالنّسبة للمملكة الّتي أريدها هي مصر

230
00:14:23,470 --> 00:14:26,300
لا يستهويني تاج هيتّايتي

231
00:14:26,300 --> 00:14:30,800
سُلالتنا الثّامنة عشر يستشري فيها الفساد
لدرجة تُثير اشمئزازي

232
00:14:30,800 --> 00:14:35,000
نحن محكومون بواسطة أولئك الّذين
يطمعون بالثّروات والسّلطة فقط

233
00:14:35,000 --> 00:14:38,610
الفراعنة هم أسوأ النّاس

234
00:14:38,960 --> 00:14:40,170
الفراعنة؟

235
00:14:40,170 --> 00:14:43,350
أجل. من هو الفرعون الآن؟

236
00:14:43,350 --> 00:14:45,570
ماذا حدث للملِكة عنخس إن آمون؟

237
00:14:45,840 --> 00:14:49,200
تزوّجتْ من جديد من وزير يُدعى آي

238
00:14:49,200 --> 00:14:52,150
،إنّه عجوز عديم الموهبة من البلاط الإمبراطوريّ

239
00:14:52,150 --> 00:14:55,710
استطاع كسب العرش وملكة شابّة
بفضل ذهبِه وعلاقاته

240
00:14:56,000 --> 00:14:58,780
العلاقة الفاضحة تُثير اشمئزازي

241
00:14:58,780 --> 00:15:02,840
.الثّروة والعلاقات لا تصنعان فرعوناً
القدرة هي الّتي تفعل ذلك

242
00:15:03,120 --> 00:15:06,220
المملكة لا تتأسّس بواسطة الأرستقراطيّين والأثرياء

243
00:15:06,220 --> 00:15:11,600
يحدث ذلك فقط عندما يتمكّن المُزارِعون والحِرفيّون
والآخرون جميعهم من العيش بسلام

244
00:15:11,600 --> 00:15:16,560
الرّجل الوحيد القادر على تحقيق
حُكم كهذا هو فرعون

245
00:15:16,980 --> 00:15:19,270
أعلم بأنّني لديّ المقدرة

246
00:15:19,270 --> 00:15:22,090
ذات يوم، سأكون فرعون

247
00:15:22,810 --> 00:15:28,240
تفكيرك كتفكير الأمير كايل، رغم
أنّ منهجك مُختلف

248
00:15:28,610 --> 00:15:31,700
لكن رجلاً واحداً وحده لا يستطيع حكم مملكة

249
00:15:31,700 --> 00:15:34,900
يجب على فرعون أن يمتلك امرأةً
ذات مقدِرة مثله

250
00:15:34,900 --> 00:15:38,000
امرأة تستطيع مُساندة فرعون

251
00:15:38,290 --> 00:15:41,640
كنتُ أظنُّ بأنّ امرأة كهذه لا يمكن العثور عليها

252
00:15:41,640 --> 00:15:45,130
ثمّ اكتشفتُ بأنّ أمير الهيتّايتي لديه امرأة كهذه

253
00:15:47,510 --> 00:15:48,720
تقصدني أنا؟

254
00:15:49,790 --> 00:15:52,680
لذا أردتُ سرقتكِ منه

255
00:15:52,680 --> 00:15:56,890
أنت تُبالغ في تقديري. أقصد بأنّني أصبحتُ
عقيلته بالصّدفة فقط

256
00:15:56,890 --> 00:15:58,830
هذا أفضل بالنّسبة لنا

257
00:15:59,510 --> 00:16:02,180
انسي أن تكوني امرأة ذلك الأمير

258
00:16:02,180 --> 00:16:04,650
سأرقّيكِ إلى ملكة مصر بأكملها

259
00:16:06,680 --> 00:16:08,530
مهلاً! ماذا تحاول أن تفعل؟

260
00:16:08,940 --> 00:16:11,680
المعذرة. تلقّينا رسالةً من هاتّوسا

261
00:16:11,680 --> 00:16:12,660
ما هي؟

262
00:16:12,660 --> 00:16:14,660
ماذا حدث في هاتّوسا؟

263
00:16:16,720 --> 00:16:19,290
وردَ أنّهم قبضوا على قاتل الملِك

264
00:16:20,330 --> 00:16:21,880
وكان أورسولا

265
00:16:21,880 --> 00:16:25,670
ماذا؟ هل فقدوا صوابهم؟ يعلمون بأنّ
أورسولا لم تفعلها

266
00:16:25,670 --> 00:16:27,540
يعلمون بالتّأكيد

267
00:16:27,540 --> 00:16:30,680
غالباً ضحّتْ بنفسها لإنهاء الأزمة

268
00:16:30,930 --> 00:16:32,010
هذا فظيع

269
00:16:32,800 --> 00:16:34,250
يجب عليّ أن أعود

270
00:16:34,250 --> 00:16:36,180
!رمسيس، أعدني

271
00:16:36,540 --> 00:16:37,560
أرفُض

272
00:16:37,820 --> 00:16:39,440
رمسيس

273
00:16:40,070 --> 00:16:41,310
أرجوك

274
00:16:50,070 --> 00:16:53,830
يؤسفنا أنّ وليّ العهد غائب بسبب مرضه

275
00:16:54,180 --> 00:16:58,920
لكنّنا نُعلن هاهنا الحكم على هذه
المرأة بالإعدام لاغتيالها الملِك

276
00:17:02,580 --> 00:17:05,300
ألا تعرفون مكان يوري؟

277
00:17:05,300 --> 00:17:07,380
إلى أين ذهبَ رمسيس؟

278
00:17:09,130 --> 00:17:10,590
أورسولا؟

279
00:17:10,590 --> 00:17:12,840
ويجب ألّا نُخبر سموّه؟

280
00:17:15,320 --> 00:17:17,150
ما الأمر؟ هل هي من هاتّوسا؟

281
00:17:17,150 --> 00:17:19,980
لا شيء مُهمّ

282
00:17:19,980 --> 00:17:22,940
لا شيء يدعو للقلق

283
00:17:24,330 --> 00:17:25,190
مهلاً

284
00:17:25,560 --> 00:17:27,360
قائد العربات

285
00:17:27,360 --> 00:17:30,650
أريد رؤية السّجينة. اسمحوا لي بالمرور

286
00:17:30,650 --> 00:17:33,760
لا يمكننا. لا يُسمَح لأحد بالدّخول إلى هنا

287
00:17:33,760 --> 00:17:38,660
إذاً إن اندلعت حربٌ أُخرى، لا تحتاجون
مُساعدة من العربات؟

288
00:17:40,090 --> 00:17:41,230
!أورسولا

289
00:17:41,230 --> 00:17:42,420
كاش

290
00:17:42,420 --> 00:17:44,970
سأحرّرك. يمكننا الهرب معاً

291
00:17:44,970 --> 00:17:46,290
لا، لا نستطيع

292
00:17:46,290 --> 00:17:47,530
بل نستطيع

293
00:17:47,530 --> 00:17:49,270
كِلانا سنهرب من هنا

294
00:17:49,270 --> 00:17:50,300
لا تفعل من فضلك

295
00:17:50,300 --> 00:17:53,050
أنت أحد قادة الأمير كايل القيّمين

296
00:17:53,050 --> 00:17:55,680
امرأتي هي كُلّ ما يهمّني

297
00:17:58,270 --> 00:17:59,420
أنت رائع

298
00:17:59,770 --> 00:18:00,680
هيّا بنا

299
00:18:00,680 --> 00:18:01,560
لا أستطيع

300
00:18:01,560 --> 00:18:03,850
!لكن سيقتلونكِ إذا لم تهربي

301
00:18:05,190 --> 00:18:07,130
،حالما يتمّ إعدامي

302
00:18:07,130 --> 00:18:10,240
يستطيع الأمير إدانة الملِكة على
جرائمها بشكل علنيّ

303
00:18:10,240 --> 00:18:12,700
لكنّكِ لستِ القاتلة

304
00:18:13,050 --> 00:18:16,410
كاش. حلمتُ بحياة معك

305
00:18:16,410 --> 00:18:19,950
وبأن أحمل الكثير من الأطفال، وبأن نشيخ معاً

306
00:18:20,700 --> 00:18:24,420
وعندما نموت، يدفننا أحفادنا بجانب بعضنا الآخر

307
00:18:24,420 --> 00:18:26,040
ما زال بمقدورنا أن نعيش هذا الحلم

308
00:18:26,040 --> 00:18:27,170
...آسفة، لكن

309
00:18:27,840 --> 00:18:30,550
لديّ حلم أكبر من ذلك حتّى

310
00:18:30,940 --> 00:18:33,840
،في هذا الحلم، يصبح الأمير كايل ملِكاً

311
00:18:33,840 --> 00:18:38,690
وتقف يوري بجانبه بصفتها تاوانانّا

312
00:18:39,450 --> 00:18:43,750
إن أصبحا حاكمين، فستصبح الإمبراطوريّة عظيمة

313
00:18:43,750 --> 00:18:49,270
،ولن نخشى جوعاً ولا حرباً
وسيعيش الجميع بسلام

314
00:18:49,270 --> 00:18:51,560
!هذا ما أعرفه

315
00:18:51,560 --> 00:18:54,950
أريد أيضاً أن تكون يوري-ساما تاوانانّا

316
00:18:59,700 --> 00:19:04,770
كاش، هذا يعني بأنّ حلمنا واحد

317
00:19:05,440 --> 00:19:09,880
يمكننا تحقيق ذلك الحلم، حتّى
لو لم نكن معاً

318
00:19:11,340 --> 00:19:12,380
أورسولا

319
00:19:16,740 --> 00:19:21,680
سامحني يا كاش. لأنّني أحلم
حلماً أكبر حتّى

320
00:19:22,420 --> 00:19:23,680
أنا آسفة

321
00:19:25,390 --> 00:19:28,310
لم يبقَ الكثير حتّى نصل إلى
محطّتنا في هذه اللّيلة

322
00:19:28,640 --> 00:19:33,000
ستكون الأمور على ما يُرام. أنا متأكّدة بأنّ
الأمير كايل سينقذ أورسولا في الوقت

323
00:19:35,080 --> 00:19:42,620
سنعدم الآن المرأة المُدانة باغتيال
الملِك أرنواندا الثّاني

324
00:19:43,450 --> 00:19:44,360
!أورسولا

325
00:19:44,360 --> 00:19:45,910
أين كاش؟ أليس هو هنا؟

326
00:19:46,330 --> 00:19:52,420
سوف نُخضِع جيش الملِكة باسم الأمير
كايل حالما يُنفَّذ الإعدام

327
00:19:52,420 --> 00:19:53,120
مفهوم؟

328
00:19:53,120 --> 00:19:53,920
حاضر

329
00:19:54,260 --> 00:19:56,930
يا امرأة، هل لديكِ كلمات أخيرة؟

330
00:19:56,930 --> 00:19:58,990
!أورسولا! سنذهب لإيجاد كاش

331
00:19:58,990 --> 00:20:00,850
!سنُحضره إلى هنا، لذا انتظري فحسب

332
00:20:03,680 --> 00:20:06,560
هل لديكِ أي كلام تقولينه؟

333
00:20:06,960 --> 00:20:08,770
ليس لديّ ما أتحسّر عليه

334
00:20:09,290 --> 00:20:11,310
إذا أغمضتُ عيني، أستطيع أن أحلم

335
00:20:11,780 --> 00:20:15,950
بيوري-ساما تضع التّاجَ الملكيّ

336
00:20:17,560 --> 00:20:18,720
لا، ليس لديّ

337
00:20:19,070 --> 00:20:25,300
لِقاء الجريمة البغيضة وهي قتل
،الملِك أرنواندا الثّاني

338
00:20:25,300 --> 00:20:28,830
ستدفعين حياتكِ ثمناً

339
00:20:28,830 --> 00:20:30,000
!اشنقوها

340
00:20:34,880 --> 00:20:36,430
!تحرّكوا يا جنود

341
00:20:49,990 --> 00:20:52,290
سأحلم دوماً بذلك اليوم الرّائع

342
00:20:53,000 --> 00:20:58,240
رغم فُراقنا، ما زلنا نتشارك نفس الآمال والرّغبات

343
00:20:59,040 --> 00:21:00,860
يمكننا أن نحلم نفس الحلم

344
00:21:05,250 --> 00:21:06,540
مهلاً

345
00:21:07,450 --> 00:21:10,440
لماذا غروب الشّمس أحمر؟

346
00:21:11,060 --> 00:21:13,200
يُراودني شعور سيّئ