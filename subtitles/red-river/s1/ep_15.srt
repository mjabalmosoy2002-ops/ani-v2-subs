1
00:01:32,070 --> 00:01:33,480
عشتار المُزيّفة

2
00:01:55,680 --> 00:01:56,610
يوري

3
00:01:57,830 --> 00:01:59,320
تسرّني عودتكِ

4
00:02:01,350 --> 00:02:06,230
،جرحي بسبب السّهم أدّى إلى حُمّى
لذا طُرِحتُ في الفِراش لبعض الوقت

5
00:02:06,650 --> 00:02:10,500
أثناء تلك الفترة، سوّى الهيتّايتي خِلافهم مع المصريّين

6
00:02:11,670 --> 00:02:13,610
...وعندما تمكّنتُ من النّهوض أخيراً ثانية

7
00:02:19,230 --> 00:02:25,000
،والد الأمير كايل، الملِك سوبّيلوليوما الأوّل
انهارَ بمرض مُميت

8
00:02:25,990 --> 00:02:31,760
كانت حُمّى لمدّ عشرة أيّام، وباء قيلَ
بأنّه يُبيد مدينةً في غضون عشرة أيّام

9
00:02:32,180 --> 00:02:36,110
أثناء مرض الملِك، تولّى الأمير
واجبات الحكومة

10
00:02:36,780 --> 00:02:37,720
أمير؟

11
00:02:38,440 --> 00:02:39,520
ما هذا؟

12
00:02:40,470 --> 00:02:42,220
ختم أبي

13
00:02:43,070 --> 00:02:45,160
كنتُ أفكّر بمدى اهترائه

14
00:02:46,090 --> 00:02:49,160
كان يستخدمه منذ تبوّأ العرش

15
00:02:50,990 --> 00:02:52,020
سموّك

16
00:02:52,940 --> 00:02:55,490
يريد رسولٌ مصريٌّ مُقابلتك

17
00:02:56,560 --> 00:03:01,370
قبل أيّ شيء، أتمنّى لجلالة الملِك
الشّفاء العاجل

18
00:03:01,770 --> 00:03:07,080
آتي أيضاً بصفتي القائد الجديد للجنود
المصريّين المُتمركزين في هاتّوسا

19
00:03:07,080 --> 00:03:08,380
هذا أنت من جديد

20
00:03:08,750 --> 00:03:12,300
رجاء يا يوري-ساما. اغفري سلوكي الماضي

21
00:03:12,300 --> 00:03:16,050
اسمي رمسيس. شرف لي معرفتكِ

22
00:03:16,370 --> 00:03:20,610
سموّك، لديّ هدايا أتمنّى تقديمها لعقيلتك

23
00:03:20,930 --> 00:03:22,850
!يا للرّوعة

24
00:03:22,850 --> 00:03:26,940
هل ستعطيننا كُلّ هذا حقّاً؟
وليس للملِكة؟

25
00:03:27,210 --> 00:03:33,570
من الطّبيعيّ تأسيس علاقة
مع الحاكم المُحتمل التّالي

26
00:03:33,570 --> 00:03:36,030
لكن ألا يُفترض أن يكون وليّ العهد؟

27
00:03:36,030 --> 00:03:41,610
لا، الشّخص الّذي يجب الالتفات له
هو الأمير الّذي يُقيم في هذا القصر

28
00:03:41,610 --> 00:03:44,800
أيّ أحمق يستطيع أن يتنبّأ
مَن سيكون الحاكم الحقيقيّ

29
00:03:45,210 --> 00:03:46,290
...وفضلاً عن ذلك

30
00:03:46,740 --> 00:03:48,710
أردتُ رؤيتكِ شخصيّاً

31
00:03:50,970 --> 00:03:53,630
سأحصل على بقيّتكن يوماً ما

32
00:03:53,630 --> 00:03:57,260
الحِرفيّات المصريّة مُميّزة جدّاً

33
00:03:58,000 --> 00:03:58,880
ماذا؟

34
00:03:59,350 --> 00:04:03,070
يقول رمسيس بأنّ الحاكم التّالي
سيكون الأمير كايل؟

35
00:04:03,850 --> 00:04:07,140
كم أتمنّى أن يكون ذلك سهلاً

36
00:04:07,420 --> 00:04:09,440
ما الّذي يمنعه؟

37
00:04:09,440 --> 00:04:12,020
،إذا أراد أن يكون الملِك المُقبل ذا إرادة قويّة

38
00:04:12,020 --> 00:04:14,770
لكان قد عيّنَ الأمير كايل خليفته ببساطة

39
00:04:15,200 --> 00:04:19,180
لكن، وليّ العهد أرنواندا، ليس رجلاً قويّاً

40
00:04:19,180 --> 00:04:21,820
ستتدخّل الملكةُ بلا شكّ

41
00:04:21,820 --> 00:04:25,860
بالإضافة إلى ذلك، لا يستطيع أحدٌ استبدال
التوانانّا حتّى تموت

42
00:04:26,270 --> 00:04:29,130
ستصبح الملِكة الأرملة وتحصل
على الصّلاحية الكاملة

43
00:04:29,570 --> 00:04:34,320
إذا أصبح الأمير جودا وليّ العهد، فإنّ
الملِكةَ ستقتل كايل

44
00:04:34,710 --> 00:04:36,050
هذا مُروّع

45
00:04:36,630 --> 00:04:37,720
إيل

46
00:04:37,720 --> 00:04:40,080
لستَ بحاجة للمُتابعة

47
00:04:40,080 --> 00:04:42,510
إذاً سوف نستأذن بالانصراف

48
00:04:44,630 --> 00:04:46,680
ما قاله للتو لا يعنيكِ

49
00:04:50,200 --> 00:04:51,790
لذا الزمي الصّمت

50
00:04:55,330 --> 00:04:56,430
سموّ الأمير

51
00:04:58,100 --> 00:05:01,990
اسمع، أنا متأكّدة بأنّ أباك سيتحسّن

52
00:05:02,500 --> 00:05:04,240
أتعتقدين ذلك؟

53
00:05:04,590 --> 00:05:05,370
أجل

54
00:05:06,180 --> 00:05:07,170
أنا مُتيقّنة من ذلك

55
00:05:09,160 --> 00:05:10,350
!الأمير كايل

56
00:05:11,840 --> 00:05:15,130
والدك، جلالته، قد تُوفّي

57
00:05:16,760 --> 00:05:17,760
سموّ الأمير

58
00:05:19,550 --> 00:05:20,470
يوري

59
00:05:21,670 --> 00:05:23,940
من فضلكِ. اسمحي لي بهذا

60
00:05:38,550 --> 00:05:40,000
!سنذهب إلى قصر أبي

61
00:05:41,680 --> 00:05:45,770
،أُقيمَتْ جنازة للملك لاحقاً

62
00:05:45,770 --> 00:05:49,630
وأصبح أرنواندا الثّاني الملِك الجديد

63
00:05:49,630 --> 00:05:52,860
،بالنّسبة لِمَن سيصبح وليّ العهد التّالي

64
00:05:52,860 --> 00:05:56,050
كقائد للحرَس الملكيّ، كان الأمير كايل مُرشّحاً

65
00:05:56,630 --> 00:06:00,350
مثلما كان الأمير جودا، بما أنّ أمّه
كانت الملِكة الأرملة

66
00:06:02,150 --> 00:06:04,970
لماذا أنا؟ كايل هو الخيار الواضح

67
00:06:04,970 --> 00:06:07,430
لا أريد حتّى أن أكون ملكاً

68
00:06:07,430 --> 00:06:09,060
!أمّي

69
00:06:09,060 --> 00:06:12,680
لا نتحمّل خسارة هذه المعركة

70
00:06:12,680 --> 00:06:16,490
أجل. لذلك، لديّ خطّة

71
00:06:18,050 --> 00:06:19,190
حقّاً؟

72
00:06:19,190 --> 00:06:21,350
إذاً الملِكة الأرملة قد بدأت بتحرّكاتها

73
00:06:21,350 --> 00:06:23,450
ماذا نفعل، سموّك؟

74
00:06:23,760 --> 00:06:25,180
لا شيء حاليّاً

75
00:06:25,180 --> 00:06:28,840
لكن احرص على ألّا تسمع يوري شيئاً
—عن الأمر، وإلّا ستُقدِم على

76
00:06:28,840 --> 00:06:30,240
!اخرج

77
00:06:30,520 --> 00:06:32,580
سآتي لزيارتكِ ثانية

78
00:06:32,580 --> 00:06:33,840
أهذا أنت يا رمسيس؟

79
00:06:33,840 --> 00:06:35,210
تحيّة لك، سموّك

80
00:06:35,810 --> 00:06:38,640
أعتذر. سآتي ثانية في وقت لاحق

81
00:06:41,210 --> 00:06:43,220
!لا تعُد أبداً

82
00:06:43,220 --> 00:06:44,620
ماذا حدث؟

83
00:06:44,620 --> 00:06:46,360
ا-الأمير؟

84
00:06:46,360 --> 00:06:48,070
لم يحدث شيء

85
00:06:48,070 --> 00:06:51,590
لكن على أيّ حال، ألم تبدأ الملكةُ
بتحرّكاتها بعد؟

86
00:06:51,590 --> 00:06:53,220
هل تحاول أن تنصب فخّاً؟

87
00:06:53,220 --> 00:06:54,920
لا تُغيّري الموضوع

88
00:06:55,910 --> 00:06:58,210
ذلك الرّجل زير نِساء سيّئ الصّيت

89
00:06:58,210 --> 00:07:00,380
لا أكنّ أيّ مشاعر تجاهه

90
00:07:00,380 --> 00:07:01,890
وأمير الظّلام؟

91
00:07:02,690 --> 00:07:05,320
كان هذا زينة لجبهة الأمير، أليس كذلك؟

92
00:07:05,710 --> 00:07:08,570
أنا مُستاء لأنّكِ احتفظتِ به هذه الفترة الطّويلة

93
00:07:08,920 --> 00:07:10,500
لـ-لا، لحظة

94
00:07:10,500 --> 00:07:15,570
لم أرد نسيان كم أحبَّ أميرُ الظّلام أختَه

95
00:07:16,120 --> 00:07:17,400
...على أيّ حال

96
00:07:18,110 --> 00:07:20,240
...أكثر شيء ثمين بالنّسبة لي

97
00:07:23,120 --> 00:07:24,200
هو هذا

98
00:07:25,430 --> 00:07:27,300
ما زال لديكِ هذا؟

99
00:07:27,590 --> 00:07:30,350
ويحك! أنا أُقدّره

100
00:07:30,350 --> 00:07:32,640
إذاً سأعطيك هذا كُلّ يوم

101
00:07:33,100 --> 00:07:35,180
ألفاً منه. بل عشرة آلاف

102
00:07:35,760 --> 00:07:37,300
مهلاً

103
00:07:38,430 --> 00:07:40,160
لا يمكنك خداعي

104
00:07:40,160 --> 00:07:42,360
أنت تُخفي شيئاً، أليس كذلك؟

105
00:07:42,360 --> 00:07:46,260
لا أخفي شيئاً. عليكِ أن تهدئي
ولا تبرحي مكانكِ

106
00:07:50,120 --> 00:07:52,840
ما الّذي يُخفيه عنّي؟

107
00:07:55,470 --> 00:07:56,690
!أنت من جديد؟

108
00:07:56,690 --> 00:07:59,500
اهدئي. لديّ أنباء

109
00:07:59,940 --> 00:08:02,500
ظهرتِ "أنتِ" أُخرى

110
00:08:02,500 --> 00:08:04,710
ماذا؟ أنا؟

111
00:08:04,710 --> 00:08:07,360
أجل، شخص ينتحل شخصيّتكِ

112
00:08:07,360 --> 00:08:10,360
تزعم بأنّها محظيّة الأمير كايل
لتفعل ما يحلو لها

113
00:08:10,360 --> 00:08:13,720
يقول النّاس بأنّ أفعالها تُلطّخ سمعة سموّه

114
00:08:14,160 --> 00:08:17,610
ما هذا؟ وفي أسوأ وقت بالنّسبة للأمير

115
00:08:24,840 --> 00:08:26,620
!ابتعدوا! ابتعدوا

116
00:08:26,620 --> 00:08:28,570
!عشتار المُقدّسة تعبر

117
00:08:38,660 --> 00:08:41,040
!أنتِ! يجب أن تنحني لها

118
00:08:43,790 --> 00:08:49,790
إنّها تتباهى بملابسها ومُجوهراتها
كُلّ يوم. عشتار تُخيّب أملي

119
00:08:50,550 --> 00:08:55,930
ما الّذي يراه الأمير كايل في تلك
المرأة الّتي فتنَتْه تماماً؟

120
00:08:55,930 --> 00:08:58,680
إنّه غير مُلائم ليكون وليّ العهد

121
00:08:58,680 --> 00:08:59,850
أنتِ مُخطئة

122
00:08:59,850 --> 00:09:02,060
كيف لي أن أكون مُخطئة؟

123
00:09:02,060 --> 00:09:03,440
...لأنّه

124
00:09:03,990 --> 00:09:08,830
لن يُصدّقني أحدٌ إذا قلتُ بأنّ
تلك المرأة مُزيّفة

125
00:09:09,760 --> 00:09:13,040
في الواقع، أين تعيش عشتار المُقدّسة؟

126
00:09:13,590 --> 00:09:16,990
في القصر على قمّة التلّة

127
00:09:19,850 --> 00:09:21,160
بئس الأمر

128
00:09:21,520 --> 00:09:23,750
حُمّى العشرة أيّام قد خلّفتْ
نقصاً لدينا في الأيدي العاملة

129
00:09:23,750 --> 00:09:26,160
ومع ذلك يجب علينا تحضير مآدب
لعشتار في كلّ مساء؟

130
00:09:26,160 --> 00:09:27,560
المعذرة

131
00:09:28,260 --> 00:09:30,260
ينبغي أن توظّفنَني أيضاً

132
00:09:31,070 --> 00:09:35,560
تبدين مُشرِقة تماماً من جديد
يا عشتار المُقدّسة

133
00:09:35,560 --> 00:09:38,140
لا أكتفي من جمالكِ

134
00:09:38,140 --> 00:09:40,890
الأمير كايل يقول لي نفس الكلام

135
00:09:41,190 --> 00:09:44,520
أما من شيء جديد لإمتاعي؟

136
00:09:44,520 --> 00:09:50,170
وجدتُها. هناك ممالِك أُخرى تدع العبيد
يُقاتلون بعضهم الآخر كرياضة

137
00:09:50,170 --> 00:09:53,030
ينبغي أن ندع أولئك الرّجال يتقاتلون

138
00:09:54,410 --> 00:09:58,630
سيتلقّى الفائز جائزةً تُمنَح
باسم الأمير كايل

139
00:09:58,630 --> 00:10:00,250
!ما مُشكلتكِ؟

140
00:10:00,630 --> 00:10:04,630
مُحال أن يكون الأمير كايل مع فتاة
!تقول كلاماً كهذا

141
00:10:04,630 --> 00:10:08,000
ومن أنتِ؟ هل تعلمين مع من تتكلّمين؟

142
00:10:08,000 --> 00:10:10,570
لا، من تكونين بالتّحديد يا عشتار المُزيّفة؟

143
00:10:10,570 --> 00:10:11,840
!أتجرئين على ذلك؟

144
00:10:11,840 --> 00:10:13,380
أنا من يُعرَف بعشتار

145
00:10:13,380 --> 00:10:17,180
كفّي عن سرقة اسمي والتسبُّب
بمتاعب للأمير

146
00:10:17,180 --> 00:10:20,680
ماذا؟ تعيسة جبانة مثلكِ هي عشتار؟

147
00:10:22,310 --> 00:10:24,480
!اطردوا هذه الشّرّيرة

148
00:10:24,480 --> 00:10:28,360
!لكن صدّقوني! أنا عشتار الحقيقيّة

149
00:10:32,550 --> 00:10:35,490
.هذه عقوبتكِ على ما فعلتِه مع عشتار
!ادخلي

150
00:10:45,710 --> 00:10:47,360
ما هذا المكان؟

151
00:10:48,780 --> 00:10:51,470
لماذا زجّوا بكِ هنا؟

152
00:10:51,840 --> 00:10:55,040
هذا المكان مُخصّص لعزل المرض

153
00:10:55,600 --> 00:10:56,940
من أنت؟

154
00:10:56,940 --> 00:11:00,180
اسمي كورك. أتطوّع بالمجيء
إلى هنا لمُعالجة المرضى

155
00:11:00,180 --> 00:11:03,270
لحظة. جميعهم مُصابون بحُمّى العشرة أيّام؟

156
00:11:03,870 --> 00:11:06,870
أجل، لكن ليس لديهم طعام أو دواء

157
00:11:06,870 --> 00:11:09,660
مصائبهم تزداد سوءاً

158
00:11:09,660 --> 00:11:11,270
لكنّك بخير؟

159
00:11:11,560 --> 00:11:14,530
أصابني المرض عندما كنتُ طفلاً

160
00:11:14,530 --> 00:11:18,530
قيلَ بأنّ أولئك الّذين ينجون من حُمّى
العشرة أيّام لن يُصابوا به ثانية

161
00:11:18,840 --> 00:11:19,900
هل أنتِ كذلك؟

162
00:11:19,900 --> 00:11:21,100
لا أعتقد

163
00:11:21,100 --> 00:11:22,160
لستِ كذلك؟

164
00:11:22,420 --> 00:11:24,290
مـ-ماء

165
00:11:24,290 --> 00:11:26,790
أ-أريد... ماء

166
00:11:27,100 --> 00:11:29,170
لـ-لحظة. سأحضر بعضاً

167
00:11:29,990 --> 00:11:31,110
إنّها فارغة

168
00:11:31,810 --> 00:11:35,670
ليس لدينا عدد كافٍ من الأشخاص
لملء القدور بالماء

169
00:11:37,390 --> 00:11:38,870
هيّا. لنذهب

170
00:11:42,510 --> 00:11:44,920
!أمسكوه! لا تتردّدوا

171
00:11:45,560 --> 00:11:46,730
!أصلان

172
00:11:46,730 --> 00:11:51,130
بحقّ الآلهة، أيّ رجل يستطيع ركوب
هذا الحصان صعب المراس؟

173
00:11:51,860 --> 00:11:55,020
،إذا استطعتُ ركوب هذا الحصان
هل يمكنني الحصول عليه؟

174
00:12:10,670 --> 00:12:12,710
كورك، أين يمكننا الحصول على ماء؟

175
00:12:14,050 --> 00:12:17,000
لنعُد. سأساعد المرضى

176
00:12:29,440 --> 00:12:33,060
ماذا؟ تلك الطّفلة تُداوي المرضى؟

177
00:12:33,740 --> 00:12:35,200
مولايّ الكاهن

178
00:12:37,240 --> 00:12:40,800
ستكون الأمور بخير. ليست سوى مسألة
وقت قبل أن تُصاب بالعدوى أيضاً

179
00:12:41,800 --> 00:12:44,330
لذا يا يوري، مضى عشرة أيّام الآن

180
00:12:44,770 --> 00:12:46,500
هل صحّتكِ جيّدة؟

181
00:12:46,500 --> 00:12:48,460
أجل. صحّتي كصحّة حصان

182
00:12:48,460 --> 00:12:50,210
مُدهش

183
00:12:50,210 --> 00:12:52,580
الجميع في المدينة يتحدّثون عنكِ

184
00:12:52,580 --> 00:12:54,500
يقولون بأنّكِ فتاةٌ مُعجزة

185
00:12:54,500 --> 00:12:55,920
أي مُعجزة؟

186
00:12:56,820 --> 00:13:02,300
حتّى لو كنتُ "مُعجزة"، هذا لن يُفيد
النّاس المُتواجدين هنا

187
00:13:02,300 --> 00:13:04,780
نحتاج الكثير من الطّعام والدّواء

188
00:13:05,160 --> 00:13:07,440
لدينا مخزون في قاعة المدينة

189
00:13:07,970 --> 00:13:10,620
سأذهب وأطلب منهم

190
00:13:11,710 --> 00:13:12,480
!ابتعدي

191
00:13:13,440 --> 00:13:16,070
!لا يملك المُحافظُ وقتاً لأمثالك

192
00:13:17,530 --> 00:13:18,740
!يوري

193
00:13:19,010 --> 00:13:20,520
هل كُلّ شيء على ما يُرام؟

194
00:13:20,520 --> 00:13:23,570
لا بُدّ أنّكِ العاملة المُعجزة الّتي
سمعتُ عنها الكثير

195
00:13:23,570 --> 00:13:25,210
سأقدّم المُساعدة أيضاً

196
00:13:25,210 --> 00:13:28,410
أنا قلق على الأشخاص الّذين تمّ
نفيهم إلى الوادي

197
00:13:28,410 --> 00:13:29,720
أنتم

198
00:13:30,410 --> 00:13:33,010
ا-المُواطنون يُشكّلون تجمُّعاً

199
00:13:33,010 --> 00:13:34,410
دعيهم

200
00:13:35,180 --> 00:13:39,420
كي تكوني عشتار الحقيقيّة، يجب أن تفرضي
سلطتكِ الإلهيّة وتطرديهم

201
00:13:40,760 --> 00:13:42,770
لكن أتساءل عن السّبب

202
00:13:42,770 --> 00:13:45,890
لماذا لم تُصَب تلك العذراء بحُمّى العشرة أيّام؟

203
00:13:46,260 --> 00:13:47,730
!أعطونا طعاماً

204
00:13:47,730 --> 00:13:48,600
!ودواء

205
00:13:48,600 --> 00:13:50,950
!شاركونا الطّعام الّذي تأكلونه في مآدبكم

206
00:13:50,950 --> 00:13:52,430
!اصمتوا جميعاً

207
00:13:53,430 --> 00:13:56,730
كيف تجرؤون على عصيان الإمبراطوريّة
!بهذه الطّريقة؟

208
00:14:01,070 --> 00:14:04,570
عشتار المُقدّسة! أتوسّل إليكِ
!أن تُباركي ابني

209
00:14:07,360 --> 00:14:08,580
حُمّى العشرة أيّام؟

210
00:14:08,580 --> 00:14:11,910
أتوسّل إليكِ. امنحي طفلي البرَكة

211
00:14:11,910 --> 00:14:16,140
هذه فُرصتكِ لكسب ودّ المزيد
من النّاس. المسي الفتى

212
00:14:16,140 --> 00:14:17,980
...لـ-لكن

213
00:14:17,980 --> 00:14:20,200
ألا تريدين أن تكوني عشتار الحقيقيّة؟

214
00:14:28,310 --> 00:14:29,140
!لا أستطيع

215
00:14:31,020 --> 00:14:32,890
!لا أريد أن ألمسه

216
00:14:32,890 --> 00:14:34,080
!ابني

217
00:14:37,710 --> 00:14:41,030
كيف تجرئين على الاقتراب من عشتار
!المُقدّسة ومعكِ مُصاب بالحُمّى

218
00:14:41,030 --> 00:14:42,690
!ا-ابني

219
00:14:44,150 --> 00:14:46,940
مهلاً، اهدأ يا فتى

220
00:14:46,940 --> 00:14:48,330
لا تقلق أيّها الصّغير

221
00:14:48,630 --> 00:14:50,650
هيّا. لا تبكِ

222
00:14:54,550 --> 00:14:56,540
سنعتني بهذا الطّفل في الوادي

223
00:14:57,040 --> 00:14:59,200
لا ينبغي أن يكون مكاناً للموت

224
00:14:59,200 --> 00:15:01,090
يجدر بنا مُعالجة النّاس هناك

225
00:15:01,360 --> 00:15:03,790
لذا أعطونا طعاماً ودواء

226
00:15:03,790 --> 00:15:08,760
،هذا صحيح. إذا تمّت مُعالجة هذا الطّفل
فسينمو ويكبر مثلي

227
00:15:08,760 --> 00:15:13,220
أجل. يبدو أنّ الأطفال يتعافون
أكثر من البالغين

228
00:15:13,220 --> 00:15:16,840
،إذا سمحنا عمداً بإصابة الرُّضَّع بالمرض

229
00:15:16,840 --> 00:15:19,480
فسينجو كثير من النّاس من الموت

230
00:15:19,480 --> 00:15:22,090
هذه هي الفكرة وراء اللُّقاحات

231
00:15:22,490 --> 00:15:27,170
رُبّما لم أرض لأنّني لُقِّحت؟

232
00:15:28,130 --> 00:15:30,910
نحن نفشل في التحكّم بالرّعاع

233
00:15:30,910 --> 00:15:34,200
زجّي بتلك العذراء في السّجن
لإثارتها التمرُّد

234
00:15:35,000 --> 00:15:38,250
!أنتِ! سئمتُ منكِ

235
00:15:39,900 --> 00:15:41,250
ماذا الآن؟

236
00:15:41,980 --> 00:15:46,360
،ظننتُ بأنّني كنتُ أساعد الأمير
لكن كان تلك أنانيّتي المُبالغ بها

237
00:15:46,880 --> 00:15:49,740
سبّبتُ مزيداً من المتاعب له

238
00:15:50,660 --> 00:15:52,270
!حضرة المُحافظ! لديّ أنباء

239
00:15:52,270 --> 00:15:54,330
!وصل الأمير كايل إلى مدينتنا

240
00:15:54,330 --> 00:15:55,360
ماذا؟

241
00:15:56,430 --> 00:15:57,870
ماذا أفعل؟

242
00:15:57,870 --> 00:16:00,020
لم أتوقّع أن يأتي الأمير كايل إلى هنا

243
00:16:00,020 --> 00:16:01,870
لا تقلقي

244
00:16:01,870 --> 00:16:05,060
عقوبة خطيرة تنتظر أولئك الّذين
ينتحلون شخصيّة عشتار

245
00:16:05,060 --> 00:16:09,780
لكن إذا كسبتِ قلبَ الأمير، فسوف
تُصبحين عشتار الحقيقيّة

246
00:16:09,780 --> 00:16:11,400
سأكون الحقيقيّة؟

247
00:16:17,040 --> 00:16:20,040
سموّك، تِلك هي عشتار المُقدّسة

248
00:16:23,800 --> 00:16:26,870
سموّك. اشتقتُ لِلقائك

249
00:16:27,870 --> 00:16:31,660
أستميحك عذراً على استعارة
اسم عشتار المُقدّسة

250
00:16:31,660 --> 00:16:34,680
من فضلك امنحني شغفك يا سموّ الأمير

251
00:16:35,270 --> 00:16:38,200
لن أكفّ عن إدخال السّرور إلى قلبك

252
00:16:38,760 --> 00:16:42,000
وقتكِ الّذي قضيتِه خانِعة كعشتار
جعلَكِ تنسين

253
00:16:42,710 --> 00:16:48,370
التسبُّب باحتقار العائلة الملكيّة هو
جريمة يُعاقَب عليها بالإعدام

254
00:16:49,150 --> 00:16:51,270
لـ-لا، لحظة

255
00:16:51,950 --> 00:16:54,530
سموّك، ماذا تقصد بذلك؟

256
00:16:54,820 --> 00:16:56,540
لا أعرف هذه المرأة

257
00:16:56,840 --> 00:17:00,120
وحدهم الأوغاد البغيضون مَن ينتحلون
!شخصيّة عشتار! اقبضوا عليها

258
00:17:02,130 --> 00:17:04,340
لا أستطيع فعل المزيد هنا

259
00:17:05,550 --> 00:17:07,530
أين عشتار الحقيقيّة؟

260
00:17:07,530 --> 00:17:09,880
ماذا؟ الحقيقيّة بيننا؟

261
00:17:11,080 --> 00:17:13,100
سأعيد طرح السّؤال

262
00:17:13,100 --> 00:17:16,810
أين تقع فوضى في هذه المدينة؟

263
00:17:16,810 --> 00:17:19,360
—فوضى؟ لم أسمع بأي

264
00:17:19,360 --> 00:17:20,960
!حضرة المُحافظ! هناك مُشكلة

265
00:17:20,960 --> 00:17:23,430
!يحاول المُواطنون اقتحام السّجن

266
00:17:23,430 --> 00:17:24,520
ماذا؟

267
00:17:24,520 --> 00:17:26,750
!أطلقوا سراح تلك الفتاة

268
00:17:26,750 --> 00:17:29,160
!لم ترتكب أيّ خطأ

269
00:17:32,930 --> 00:17:33,780
!يوري

270
00:17:33,780 --> 00:17:34,740
كورك؟

271
00:17:35,150 --> 00:17:36,910
انتظر. سأفتح الزّنزانة

272
00:17:36,910 --> 00:17:38,700
هيّا. سنتوجّه إلى الوادي

273
00:17:39,110 --> 00:17:42,620
وزّعَ الأمير كايل الطّعام والدّواء
على المرضى

274
00:17:42,620 --> 00:17:44,580
الأمير كايل؟

275
00:17:44,990 --> 00:17:46,240
!أهلاً بعودتكِ

276
00:17:46,240 --> 00:17:48,180
!عدتِ

277
00:17:48,590 --> 00:17:51,210
رِفاق، سُنعدّ وجبات طعام لكم

278
00:17:51,210 --> 00:17:52,840
!اصبروا

279
00:17:55,220 --> 00:17:56,800
!هدوء

280
00:17:57,310 --> 00:17:59,180
!انحنوا

281
00:17:59,180 --> 00:18:01,950
!وصلَ الأمير كايل مورسيلي

282
00:18:04,650 --> 00:18:07,860
لـ-لماذا الأمير كايل هنا؟

283
00:18:08,170 --> 00:18:10,320
أتيتُ لاستعادة عشتار

284
00:18:10,670 --> 00:18:12,810
ماذا؟ عشتار المُقدّسة؟

285
00:18:12,810 --> 00:18:14,930
عشتار في القصر

286
00:18:14,930 --> 00:18:16,000
يا رجال

287
00:18:17,070 --> 00:18:19,200
هل تعرفون من تكون عشتار؟

288
00:18:19,200 --> 00:18:22,110
نـ-نعرف من تكون عشتار بالطّبع

289
00:18:22,110 --> 00:18:25,110
إنّها عذراء ذات شعر داكن
...وعينين داكنتين

290
00:18:26,010 --> 00:18:28,640
وهي من بلد أجنبيّ

291
00:18:28,640 --> 00:18:30,380
!عُدت

292
00:18:30,380 --> 00:18:34,500
وهي حسناء تأسر الجميع

293
00:18:36,390 --> 00:18:37,800
الأمير؟

294
00:18:38,400 --> 00:18:43,390
كما يزعم الجميع، وجدتُ نفسي
مأسوراً بهذه الفتاة فعلاً

295
00:18:44,110 --> 00:18:47,400
لكنّها كطائر، تبتعد عن مرقدي
،من وقت لآخر

296
00:18:47,730 --> 00:18:49,660
لتجعلني أُصاب بالأرق ليلاً

297
00:18:50,530 --> 00:18:53,080
أليس كذلك يا يوري؟

298
00:18:53,490 --> 00:18:55,570
سـ-سموّ الأمير

299
00:19:01,170 --> 00:19:03,740
سأعرّفكم عليها

300
00:19:03,740 --> 00:19:08,330
هذه عقيلتي الوحيدة. والجميع يُناديها عشتار

301
00:19:10,310 --> 00:19:13,170
يوري هي عشتار المُقدّسة الحقيقيّة؟

302
00:19:13,490 --> 00:19:17,870
آسف لتأخُّري. كان لديّ عمل
منعَني من الهرب

303
00:19:17,870 --> 00:19:22,750
صحيح يا سموّ الأمير، لا ينبغي أن تكون
هنا. لا أريدك أن تمرض

304
00:19:22,750 --> 00:19:26,520
لن أتأثّر، لأنّ عشتار بجانبي

305
00:19:27,440 --> 00:19:30,740
أنتِ لا تُصابين بحُمّى العشرة أيّام

306
00:19:30,740 --> 00:19:35,200
يُقال بأنّ الشّخص الّذي يتلقّى بركَتكِ
سيكون حُرّاً من المرض

307
00:19:35,620 --> 00:19:38,140
لذا سأتلقّى بركَتكِ الآن أيضاً

308
00:19:38,140 --> 00:19:40,120
لستُ كذلك

309
00:19:40,610 --> 00:19:42,860
لا شكّ، أتيتُ إلى هنا للتّعامل
،مع عشتار المُزيّفة

310
00:19:42,860 --> 00:19:45,460
لكن زُجِجتُ في السّجن ثمّ خرجتُ منه

311
00:19:45,460 --> 00:19:48,140
لم أفعل شيئاً بتلك الأهمّية فعلاً

312
00:19:48,140 --> 00:19:51,710
لم أمرض بالحُمّى لأنّني تلقّحت

313
00:19:52,020 --> 00:19:55,340
في نهاية المطاف، احتجتُ لدعمك لي

314
00:19:55,980 --> 00:19:58,100
أهذا ما تعتقدينه حقّاً؟

315
00:20:00,130 --> 00:20:01,350
هل يمكنني التكلُّم؟

316
00:20:02,390 --> 00:20:03,230
تفضّل

317
00:20:03,600 --> 00:20:04,780
سيّدي

318
00:20:04,780 --> 00:20:07,250
كنّا نحن من حرّرناها من السّجن

319
00:20:07,250 --> 00:20:09,810
فعلنا ذلك لأنّنا كنّا مأسورين مثلك

320
00:20:10,480 --> 00:20:14,190
أنا مُبتهج جدّاً بعد أن عرفتُ بأنّ
يوري هي عشتار المُقدّسة

321
00:20:14,190 --> 00:20:15,620
كذلك أنا

322
00:20:15,620 --> 00:20:19,990
إن جاز لي إعطاء رأيي، أنا مسرور
لاختيارك يوري-ساما كعقيلة لك

323
00:20:19,990 --> 00:20:23,950
بالنّسبة لذلك، أكرّس حياتي
المُتواضعة لتحقيق غايتكما

324
00:20:23,950 --> 00:20:24,620
أنا أيضاً

325
00:20:24,620 --> 00:20:25,800
وكذلك أنا

326
00:20:27,460 --> 00:20:29,710
!يحيا الأمير كايل

327
00:20:29,710 --> 00:20:31,040
!سموّ الأمير

328
00:20:30,080 --> 00:20:31,290
!يحيا سموّه

329
00:20:31,150 --> 00:20:32,740
!تحيا عشتار

330
00:20:32,740 --> 00:20:34,710
!يحيا الأمير

331
00:20:35,310 --> 00:20:36,440
...أنتم

332
00:20:36,870 --> 00:20:40,320
يوري، أعتقد بأنّ هذا يُثبت بأنّني
سأحصل على بركَتكِ

333
00:20:40,320 --> 00:20:41,970
هـ-هنا؟

334
00:20:41,970 --> 00:20:47,790
أحصل على اعتذاركِ أيضاً لتَركي
والمُغادرة دون إذن

335
00:21:11,570 --> 00:21:13,000
أنا آسفة