1
00:00:02,230 --> 00:00:07,740
حضرة المُحافظ، نحن مُمتنّون حقّاً
لضيافتك السّخيّة

2
00:00:10,820 --> 00:00:14,570
الأمير مورسيلي دون سِواه. من دواعي
—سروري وشرف لي أن

3
00:00:17,560 --> 00:00:20,250
سنعتبر أنفسنا في الدّيار لبعض الوقت

4
00:00:20,600 --> 00:00:21,750
يا حضرة المُحافظ

5
00:00:26,130 --> 00:00:27,910
،هذه هاتّوسا

6
00:00:28,400 --> 00:00:32,930
عاصمة إمبراطوريّة هيتّايتي في القرن
الرّابع عشر قبل الميلاد

7
00:00:34,620 --> 00:00:40,110
هذه قصّة فتاة تركب الرّياح الحارّة الرّطبة

8
00:00:40,680 --> 00:00:42,870
عبر مسافات الأناضول الواسعة

9
00:00:51,380 --> 00:00:55,270
تهبُّ رياحٌ عاتية، لتحمل معها الرّمال الجافّة

10
00:00:57,250 --> 00:00:59,000
،تهبُّ الرّياح ساخنة

11
00:00:59,760 --> 00:01:01,790
،وأنا أعيش تحت هذه السّماء

12
00:01:02,210 --> 00:01:06,550
النّهر الأحمر

13
00:01:02,430 --> 00:01:04,990
على ضفاف النّهر الأحمر

14
00:02:30,000 --> 00:02:35,010
إشارة الكفّ

15
00:02:31,710 --> 00:02:33,530
إشارة الكفّ

16
00:02:37,070 --> 00:02:41,970
مع الأسف، أرسلَني أبي في هذه
الحملة العسكريّة السّخيفة

17
00:02:42,570 --> 00:02:45,980
إنّ أخذ استراحة طويلة هنا
سوف يُرضيني بشكل كبير

18
00:02:45,980 --> 00:02:50,860
يمكننا ترك الجنود خارج هذه
الأسوار إن لزم الأمر

19
00:02:51,400 --> 00:02:55,240
إن كان الأمر كذلك، فيمكنك البقاء
قدر ما ترغب من مدّة

20
00:02:55,730 --> 00:02:56,820
شكراً

21
00:02:57,240 --> 00:03:00,880
بئس الأمر. خوض الحروب مُرهِق حقّاً

22
00:03:00,880 --> 00:03:05,190
لكن تلقّينا نبأ عن نصرك المؤزَر في كيزّواتنا

23
00:03:05,190 --> 00:03:07,890
كان ذلك جيش أخي

24
00:03:07,890 --> 00:03:11,770
إنّه يمنحني نصف شرف فوزه في المعارك

25
00:03:11,770 --> 00:03:15,970
أعتقد بأنّه لا يزال في ساحات المعارك
يكسب مزيداً من المجد لأجلي

26
00:03:16,260 --> 00:03:19,350
لكن عندما أمتلك هذه، فأنا لا أضجر أبداً

27
00:03:25,030 --> 00:03:27,060
ما رأيكِ؟ هل أعجبكِ المذاق؟

28
00:03:27,060 --> 00:03:30,270
لا أستطيع تذوُّق شيء عندما
يكون لِسانك عقبة

29
00:03:30,270 --> 00:03:33,780
هل هي محظيّتك؟

30
00:03:33,780 --> 00:03:34,780
بالفعل

31
00:03:36,400 --> 00:03:38,100
أليست ظريفة؟

32
00:03:39,240 --> 00:03:44,290
إنّها من بلاد بعيدة وتبدو بريئة جدّاً

33
00:03:44,290 --> 00:03:49,100
.أطمئنك بأنّها بعيدة كُلّ البُعد عن البراءة
لا سيّما تحت الغطاء

34
00:03:49,680 --> 00:03:52,170
ماذا؟ تريدين أن تنامي؟

35
00:03:52,170 --> 00:03:57,840
حضرة المُحافظ، يريد سموّه أن يخلد
إلى النّوم مع محظيّته

36
00:03:57,840 --> 00:04:00,840
سامحني على الإطالة

37
00:04:01,400 --> 00:04:04,520
أتمنّى لك أُمسية مُبهجة، سموّك

38
00:04:04,520 --> 00:04:07,750
أشكرك يا حضرة المُحافظ. تُصبح على خير

39
00:04:11,270 --> 00:04:16,110
يبدو أنّ وليّ العهد ليس بحاجة
للقلق بشأن ذلك الرّجل

40
00:04:16,110 --> 00:04:20,140
أجل، لكن ينبغي أن نُبلغه
على الرُّغم من ذلك

41
00:04:24,050 --> 00:04:24,870
انظروا

42
00:04:25,190 --> 00:04:27,480
أزالوا نصفَ الحُرّاس

43
00:04:28,140 --> 00:04:30,800
مهاراتي في التّمثيل ليست سيّئة إطلاقاً

44
00:04:30,800 --> 00:04:32,500
هل كان يُمثّل حقّاً؟

45
00:04:34,280 --> 00:04:35,960
أنا مُرهَقة

46
00:04:36,250 --> 00:04:42,120
إذاً متى ستخبرنا كيف يُفترض بنا
أن نأخذ ملاطية؟

47
00:04:42,120 --> 00:04:45,760
قطعنا مُنتصف الطّريق بالفعل
نحو غزو ملاطية

48
00:04:47,030 --> 00:04:49,200
لا حاجة لإشهار أسلحة

49
00:04:49,200 --> 00:04:51,400
ستُفتَح ملاطية بلا إراقة دماء

50
00:04:51,670 --> 00:04:53,390
لحظة، بلا إراقة دماء؟

51
00:04:53,390 --> 00:04:58,040
سنسيطر على هذه المدينة دون إشهار
أسلحتنا أو إراقة دماء

52
00:04:58,040 --> 00:04:59,330
بالفعل

53
00:04:59,330 --> 00:05:03,240
،أوّلاً، سنكتشف مكان انتشار الحُرّاس
ثمّ سنحرق مُستودعات الأسلحة

54
00:05:03,630 --> 00:05:09,000
بعد ذلك، سيندفع جنودنا عبر البوّابات
ويستولون على المدينة

55
00:05:09,000 --> 00:05:13,040
بهذه الطّريقة، يمكننا تقليص الوقت
وعدد الجنود المطلوبين

56
00:05:13,040 --> 00:05:15,230
هل سيفلح ذلك أصلاً؟

57
00:05:15,230 --> 00:05:17,500
أعلم بأنّنا نستطيع فعلها

58
00:05:17,500 --> 00:05:20,770
لكن فقط في حال كان أمير
الظّلام خارج المشهد

59
00:05:21,320 --> 00:05:24,920
لهذا السّبب طلبتُ من زانّانزا
استدراجه بعيداً من هنا

60
00:05:25,340 --> 00:05:28,890
مصير الخطّة هو الفشل إذا كان
موجوداً للدّفاع عن المدينة

61
00:05:28,890 --> 00:05:31,200
هيّا. الوقت يُداهمنا

62
00:05:31,200 --> 00:05:33,940
أوّلاً، نحتاج خريطة انتشار المدينة

63
00:05:33,940 --> 00:05:34,860
حاضر

64
00:05:34,860 --> 00:05:37,300
سـ-سآتي للمُساعدة في البحث عنها أيضاً

65
00:05:37,300 --> 00:05:39,350
ينبغي أن ترتاحي يا يوري-ساما

66
00:05:39,350 --> 00:05:40,650
أجل، هذا صحيح

67
00:05:40,650 --> 00:05:45,240
مهلاً. عددكم قليل وقد تحتاجون لمُساعدة

68
00:05:45,240 --> 00:05:46,700
لذا هيّا بنا

69
00:05:57,590 --> 00:06:01,530
كان من الأفضل لكِ أن تبقي مع الأمير كايل

70
00:06:01,530 --> 00:06:04,380
معه حقّ. فهذه مهمّة خطيرة

71
00:06:04,380 --> 00:06:05,320
أجل

72
00:06:05,720 --> 00:06:09,600
لكن وجودي معه هو مُشكلتي الحقيقيّة

73
00:06:09,600 --> 00:06:12,680
،أحبّ الأمير كايل كثيراً

74
00:06:12,680 --> 00:06:16,400
لكن النّوم في نفس غرفته خانِق

75
00:06:16,980 --> 00:06:22,140
،تصنّعتُ النّوم في اللّيلة الماضية
لكن لن يفلح ذلك لفترة طويلة

76
00:06:22,790 --> 00:06:24,080
ماذا سأفعل؟

77
00:06:24,580 --> 00:06:25,860
يوري-ساما

78
00:06:25,860 --> 00:06:26,910
اختبئي

79
00:06:32,550 --> 00:06:34,460
هل كان ذلك مبعوثاً؟

80
00:06:34,460 --> 00:06:35,770
على الأرجح

81
00:06:35,770 --> 00:06:38,840
إنّه في طريقه لإبلاغ أمير الظّلام عنّا

82
00:06:39,870 --> 00:06:41,900
لكن سيكون كُلّ شيء على ما يُرام

83
00:06:41,900 --> 00:06:44,430
جنودنا الّذين ينتظرون في الخارج سيُوقفونه

84
00:06:44,700 --> 00:06:47,540
لنحرص على ألّا يرونا فحسب

85
00:06:49,610 --> 00:06:50,770
ما هذا المكان؟

86
00:06:50,770 --> 00:06:54,310
لا بُدّ أنّه المكان الّذي يحتفظ فيه
الميتانّي بكافّة غنائمهم

87
00:06:54,710 --> 00:06:57,110
قد تكون عين إيلّويانكا هنا

88
00:06:57,110 --> 00:07:00,690
لكن كيف هو شكل عين إيلّويانكا بالضّبط؟

89
00:07:00,690 --> 00:07:06,260
قيلَ بأنّها إمّا عين تنّين قديم
أو حجر كريم قرمزيّ

90
00:07:06,260 --> 00:07:08,660
لكن لا أحد نعرفه قد رآها يوماً

91
00:07:08,660 --> 00:07:14,330
يُزعَم بأنّها مختومة داخل صندوق عاجيّ مُذهّب
وصغير بما يكفي لحمله باليدين

92
00:07:14,330 --> 00:07:17,160
صندوق عاجيّ مطليّ بالذّهب؟

93
00:07:17,500 --> 00:07:19,760
لا يمكننا البحث عنها حالياً

94
00:07:19,760 --> 00:07:21,930
سننتظر حتّى تسقط ملاطية

95
00:07:25,900 --> 00:07:28,260
ها هي ذي. خريطة الانتشار

96
00:07:28,260 --> 00:07:29,900
يجب علينا نسخها بسرعة

97
00:07:34,600 --> 00:07:37,580
ها هو ذا. المبعوث من ملاطية

98
00:07:37,580 --> 00:07:39,440
—جيّد. إذاً كما خطّطنا، نحن

99
00:07:39,440 --> 00:07:40,360
لحظة

100
00:07:41,390 --> 00:07:43,690
هل لديك شأن معنا؟

101
00:07:43,690 --> 00:07:46,240
نحن مشغولون بمهمّة

102
00:07:46,680 --> 00:07:48,540
سيكون هذا سريعاً

103
00:07:50,870 --> 00:07:52,030
،لنكُن واضحين فحسب

104
00:07:52,480 --> 00:07:55,160
يجب أن نسيطر على مُستودعات
الأسلحة والبوّابات

105
00:07:55,500 --> 00:07:57,960
سنحرق المُستودعات

106
00:07:57,960 --> 00:08:03,210
وسنضمن عبور جنودنا من البوّابات

107
00:08:03,210 --> 00:08:06,130
يوري وأنا سنصرف انتباه المُحافظ

108
00:08:06,130 --> 00:08:08,130
سنُهاجم غداً فجراً

109
00:08:08,130 --> 00:08:12,260
احرصوا على التّعاون الكامل مع الجنود في الخارج

110
00:08:12,260 --> 00:08:13,020
سموّك

111
00:08:14,720 --> 00:08:17,810
نرغب في ترفيهك. سموّك

112
00:08:18,200 --> 00:08:23,370
ندعوك إلى مأدبة رسميّة سنُقيمها اللّيلة

113
00:08:23,370 --> 00:08:25,360
نأمل أن تحضرها

114
00:08:25,360 --> 00:08:27,310
مأدبة رسميّة؟

115
00:08:27,780 --> 00:08:31,440
ما يعني بأنّ الحضور سيكونون فقط
رجالاً ذوي مرتبة رفيعة

116
00:08:31,900 --> 00:08:36,950
سيكون إيباني الوحيد في حاشيتي
الّذي يستطيع مُرافقتي

117
00:08:36,950 --> 00:08:41,020
سامحني على فظاظتي بعدم دعوة محظيّتك

118
00:08:41,020 --> 00:08:43,840
لكن هذه هي قاعدة القصر

119
00:08:43,840 --> 00:08:47,220
أين المتعة في عشاء بلا نساء؟

120
00:08:47,910 --> 00:08:50,880
مع الأسف، لا أستطيع رفض دعوة رسميّة

121
00:08:51,130 --> 00:08:53,140
شكراً لك على تفهّمك

122
00:08:53,140 --> 00:08:55,990
سنأتي ثانية لاحقاً في هذا المساء

123
00:08:56,470 --> 00:08:57,670
إلى اللِّقاء

124
00:09:00,340 --> 00:09:01,420
ذلك الوغد

125
00:09:01,880 --> 00:09:06,260
يبدو أنّه يريد إبقاءك تحت أنظارهم
ريثما يعود أمير الظّلام

126
00:09:06,260 --> 00:09:09,950
أجل، لكنّه لا يعلم بأنّنا اعترضنا المبعوث

127
00:09:10,340 --> 00:09:12,560
حسناً، بغضّ النّظر، سأستمتع بالاستقبال

128
00:09:13,130 --> 00:09:15,830
أمّا بقيّتكم فاحصلوا على نوم هانئ

129
00:09:18,830 --> 00:09:21,440
أين الرّجال الّذين أُرسِلوا لنصب
كمين للمبعوث؟

130
00:09:21,440 --> 00:09:24,120
ينبغي أن يكونوا قد عادوا الآن

131
00:09:24,120 --> 00:09:26,500
!حـ-حضرة القائد! هنا

132
00:09:27,310 --> 00:09:28,180
ما الأمر؟

133
00:09:28,900 --> 00:09:32,640
بحقّ الآلهة. من فعل هذا؟

134
00:09:32,640 --> 00:09:35,060
لا تُشير السّيوف إلى أيّ دليل

135
00:09:35,060 --> 00:09:37,640
لا، سنبحث عن الجاني لاحقاً

136
00:09:37,640 --> 00:09:41,230
هذا يعني بأنّ المبعوث لم يُعترَض

137
00:09:41,230 --> 00:09:45,270
يعرف أمير الظّلام الآن بأنّ الأمير كايل في ملاطية

138
00:09:46,210 --> 00:09:48,530
تلقّينا تقريراً من ملاطية

139
00:09:49,220 --> 00:09:50,420
ماذا قلت؟

140
00:09:50,420 --> 00:09:53,610
كايل مورسيلي يُقيم داخل المدينة؟

141
00:09:53,610 --> 00:09:55,660
مُحال! لماذا سمحوا له بالدّخول؟

142
00:09:55,660 --> 00:09:59,160
يسعى للسّيطرة على المدينة من الدّاخل

143
00:09:59,910 --> 00:10:03,270
الآن قد عرفتُ بأنّ الهيتّايتي الّذين
كنتُ أُطاردهم مُجرّد طعم

144
00:10:03,270 --> 00:10:06,720
لهذا السّبب كانوا يهربون بمسار دائريّ عمداً

145
00:10:07,340 --> 00:10:10,050
!إلى كافّة الرّجال! سنعود إلى ملاطية

146
00:10:11,960 --> 00:10:15,470
!الأمير زانّانزا! أمير الظّلام ورجاله ينسحبون

147
00:10:15,470 --> 00:10:16,300
ماذا؟

148
00:10:16,560 --> 00:10:17,700
لكن لماذا؟

149
00:10:17,700 --> 00:10:20,570
ظننتُ بأنّنا أسرْنا المبعوث

150
00:10:20,570 --> 00:10:22,800
إذا عاد، فسيكون أخي في خطر حينها

151
00:10:26,420 --> 00:10:27,650
ربحت

152
00:10:28,490 --> 00:10:30,030
لـ-لنلعب ثانية

153
00:10:30,030 --> 00:10:35,110
.لكن ربحتُ عشر مرّات على التّوالي
لا تملكين مهارة في لعبة سينيت

154
00:10:35,420 --> 00:10:37,300
إذاً سأنظّف الغرفة

155
00:10:37,300 --> 00:10:38,870
فعلتِ ذلك مرّتين بالفعل

156
00:10:38,870 --> 00:10:41,160
وخادمة نظّفَتْها قبل ذلك

157
00:10:41,430 --> 00:10:42,690
...لكن

158
00:10:43,420 --> 00:10:48,400
،لكن إذا لم أفعل شيئاً لتشتيت انتباهنا
فسوف يتبدّل مزاجه ثانية

159
00:10:48,400 --> 00:10:51,210
...وإذا ظللتُ أصدّه، فهو حقّاً سوف

160
00:10:55,670 --> 00:10:56,730
سموّ الأمير؟

161
00:10:57,640 --> 00:11:01,420
في بلدي، ننام مع النّساء اللّواتي نُحبّهن

162
00:11:01,420 --> 00:11:05,200
إنّها الطّريقة الوحيدة للتّعبير عمّا في قلوبنا

163
00:11:06,060 --> 00:11:11,650
يـ-يمكنك فعلها بهذه الطّريقة، لكنّني
لستُ جاهزة لذلك بعد

164
00:11:11,650 --> 00:11:12,600
مُؤلم

165
00:11:14,860 --> 00:11:15,890
سموّ الأمير؟

166
00:11:17,940 --> 00:11:19,490
لا تريدين ذلك

167
00:11:19,780 --> 00:11:22,380
إذاً لن أجبركِ

168
00:11:22,380 --> 00:11:26,060
لكن يُحبطني تحاشيكِ لي بشكل سافر

169
00:11:26,060 --> 00:11:28,310
جعلَني هذا أرغب في الأخذ بالثّأر

170
00:11:28,990 --> 00:11:32,350
،إن كنتِ لا ترغبين في فعل ذلك
فماذا يجدر بي أن أفعل؟

171
00:11:32,350 --> 00:11:34,380
سأفعل ما تُملينه عليّ

172
00:11:34,380 --> 00:11:38,500
كيف يُعبّر الرّجال عن ودّهم في موطنكِ؟

173
00:11:38,500 --> 00:11:40,140
...د-دعني أُفكّر

174
00:11:42,610 --> 00:11:44,570
ودّهم؟

175
00:11:50,220 --> 00:11:51,840
هل هذه تميمة؟

176
00:11:51,840 --> 00:11:54,740
"إنّه رمز يعني "أُحبّك

177
00:11:54,740 --> 00:11:57,610
الجميع في دولتي يعرفونها

178
00:11:57,610 --> 00:12:00,350
هل سيضحك ويعتبرها سخافة طفوليّة؟

179
00:12:00,830 --> 00:12:05,620
لكنّه لم يذكر شيئاً عن شعوره تجاهي فعلاً

180
00:12:06,020 --> 00:12:08,980
أعتقد بأنّ أحبّ طريقة دولتي أكثر

181
00:12:08,980 --> 00:12:11,240
بئساً. كان ينبغي أن أعلم

182
00:12:17,480 --> 00:12:18,530
سموّ الأمير؟

183
00:12:19,300 --> 00:12:22,810
لن أسمح لكِ برفض شفتَي

184
00:12:23,210 --> 00:12:24,680
لأنّ شفتيكَ مُلكٌ لي

185
00:12:31,510 --> 00:12:33,060
سموّ الأمير كايل

186
00:12:33,530 --> 00:12:36,000
،سامحنا على إزعاجك

187
00:12:36,000 --> 00:12:39,020
لكن جاء المُحافظ لمُرافقتك إلى المأدبة

188
00:12:39,020 --> 00:12:41,200
أعتذر من أعماق قلبي

189
00:12:41,200 --> 00:12:43,930
هل حان ذلك الوقت بالفعل؟

190
00:12:43,930 --> 00:12:45,330
حسناً. سآتي حالاً

191
00:12:53,860 --> 00:12:56,720
يبدو أنّ الأمور تسير على ما يُرام

192
00:12:56,720 --> 00:12:59,580
لكن علينا تجنُّب إثارة الشّكوك حتّى بزوغ الفجر

193
00:12:59,580 --> 00:13:00,620
أجل

194
00:13:00,620 --> 00:13:03,510
لِمَ يجب أن أُرسَل في هذه المهمّة التّافهة؟

195
00:13:03,820 --> 00:13:06,130
ضُبّاطنا سائسو عبيد حقّاً

196
00:13:07,100 --> 00:13:08,290
كاش؟

197
00:13:08,290 --> 00:13:11,940
سيّد كيكّوري. إنّه يحمل رسالةً للأمير كايل

198
00:13:11,940 --> 00:13:14,760
هل يمكنك أن تُصدِّق ذلك يا كيكّوري؟

199
00:13:14,760 --> 00:13:19,860
أولئك البيروقراطيّون يريدون مُوافقة الأمير
على حصص الفاصولياء من بين كُلّ شيء

200
00:13:19,860 --> 00:13:21,310
ماذا؟ فاصولياء؟

201
00:13:22,290 --> 00:13:24,780
سيكون أمير الظّلام هنا اللّيلة

202
00:13:25,540 --> 00:13:29,620
سأشرح لاحقاً. يجب أن تُخبر الأمير
كايل في أسرع وقت

203
00:13:29,620 --> 00:13:33,070
سأفعل، لكنّني غير قادر على
الاقتراب منه حاليّاً

204
00:13:33,070 --> 00:13:35,240
لا وقت للجدال

205
00:13:35,240 --> 00:13:38,100
إن لم تسرع، فسوف يذبحنا أمير الظّلام

206
00:13:38,100 --> 00:13:41,360
حتّى الأمير لن يتجنّب قطع رأسه

207
00:13:42,160 --> 00:13:45,480
،لكن إذا فعلنا شيئاً يُثير الشّكوك

208
00:13:45,480 --> 00:13:48,800
فسيعلمون بأنّنا مُدرِكون لأمير الظّلام

209
00:13:48,800 --> 00:13:51,450
وعددنا قليلٌ على حماية الأمير كايل

210
00:13:51,450 --> 00:13:52,860
إذاً، ماذا سنفعل؟

211
00:13:52,860 --> 00:13:54,400
نحن في مأزق

212
00:13:54,400 --> 00:13:57,570
لا يُسمَح بدخول أحد منّا إلى المأدبة

213
00:13:57,840 --> 00:14:00,860
سنُقتَل جميعاً إذا اكتفينا بالوقوف

214
00:14:00,860 --> 00:14:02,900
سيُقطَع رأس الأمير

215
00:14:03,940 --> 00:14:05,200
سأذهب أنا

216
00:14:06,150 --> 00:14:08,700
لكن يُحظَر على النّساء دخول قاعة المأدبة

217
00:14:08,700 --> 00:14:12,330
إذا انتهكتِ مرسوم القصر، سيقتلونك فوراً

218
00:14:12,330 --> 00:14:14,680
لكن يجب أن أخبر الأمير

219
00:14:15,210 --> 00:14:16,170
!يوري-ساما

220
00:14:22,260 --> 00:14:23,310
يوري-ساما

221
00:14:23,310 --> 00:14:25,470
لا! سيُقطّعونها إرباً

222
00:14:25,790 --> 00:14:28,720
ما هذا؟ هذه المنطقة محظورة على الإناث

223
00:14:28,720 --> 00:14:29,720
!ما هذه الوقاحة؟

224
00:14:29,720 --> 00:14:33,050
قد تكونين محظيّة، لكن هذه الوقاحة غير مقبولة

225
00:14:33,050 --> 00:14:36,690
من عاداتنا إعدام أيّ شخص يتحدّى الحظر

226
00:14:36,950 --> 00:14:37,620
!يوري

227
00:14:37,620 --> 00:14:38,570
!سموّ الأمير

228
00:14:38,570 --> 00:14:41,280
!اشتقتُ لك

229
00:14:41,280 --> 00:14:43,140
!لا تتركني ثانية

230
00:14:46,280 --> 00:14:48,570
أريد أن نكون لوحدنا

231
00:14:48,570 --> 00:14:50,510
لنعُد إلى غرفتنا

232
00:14:50,510 --> 00:14:53,370
أيمكننا ذلك؟ من فضلك؟

233
00:14:54,420 --> 00:14:58,450
تلقّينا نبأ بأنّ أمير الظّلام سيعود
في وقتٍ أقرب من المُتوقَّع

234
00:15:01,630 --> 00:15:04,740
ا-المعذرة. سموّك؟

235
00:15:04,740 --> 00:15:06,540
أهذا كلُّ شيء؟

236
00:15:06,540 --> 00:15:08,970
اشتقتِ لي؟ أيّتها المسكينة

237
00:15:09,240 --> 00:15:11,230
مهلاً، مهلاً. سنذهب إلى غرفتنا

238
00:15:11,230 --> 00:15:13,310
دعونا نُمارس العلاقة حتّى الفجر

239
00:15:14,680 --> 00:15:18,230
اعذرنا رجاء يا حضرة المُحافظ. استمتعتُ بوقتي

240
00:15:18,230 --> 00:15:20,190
كان اللّقاء بكم رائعاً

241
00:15:20,550 --> 00:15:22,230
أتمنّى لكم جميعاً ليلة هانئة

242
00:15:22,230 --> 00:15:23,390
وداعاً

243
00:15:25,200 --> 00:15:26,770
لا يهمّ

244
00:15:26,770 --> 00:15:30,800
سيُلطّخ أميرُ الظّلام سريرهما بدمهما على أيّ حال

245
00:15:31,890 --> 00:15:35,290
أصبح لديّ علم الآن. أبليتِ حسناً يا يوري

246
00:15:35,290 --> 00:15:37,660
سموّ الأمير كايل، ماذا نفعل؟

247
00:15:37,660 --> 00:15:39,830
لا يمكننا إيقاف أمير الظّلام بمفردنا

248
00:15:39,830 --> 00:15:41,040
هدّئ من روعك

249
00:15:41,040 --> 00:15:43,610
سنغزو المدينة في وقت أبكر
من المُتوقَّع فحسب

250
00:15:43,610 --> 00:15:45,420
سنلتزم بالخطّة

251
00:15:45,910 --> 00:15:48,200
كيكّوري، أحرِق المُستودعات

252
00:15:48,200 --> 00:15:49,030
حاضر

253
00:15:49,030 --> 00:15:50,430
إيل، افتح البوّابات

254
00:15:50,430 --> 00:15:51,380
حاضر

255
00:15:51,380 --> 00:15:53,960
كاش، تولّى قيادة الجيش في الخارج

256
00:15:53,960 --> 00:15:54,700
حالاً

257
00:15:54,700 --> 00:15:58,690
افتح البوّابات وأدخل فيلقَ هيتّايتي

258
00:16:00,360 --> 00:16:02,100
!مرحباً

259
00:16:02,100 --> 00:16:03,990
كيف حالكما يا سيّدان؟

260
00:16:04,770 --> 00:16:09,440
هل يمكننا أن نطلب منكما معروفاً
أيُّها الوسيمان؟

261
00:16:11,030 --> 00:16:13,330
افتحا البوّابة حالاً

262
00:16:13,330 --> 00:16:14,530
من فضلكما

263
00:16:16,080 --> 00:16:17,970
!حـ-حريق

264
00:16:17,970 --> 00:16:19,790
!المُستودع يشتعل

265
00:16:19,260 --> 00:16:19,790
!اهربوا

266
00:16:20,080 --> 00:16:24,380
لقد بدأت. آمل أن يصلوا إلى هنا
قبل أمير الظّلام

267
00:16:24,380 --> 00:16:25,500
تحرّكوا

268
00:16:25,500 --> 00:16:29,200
أيّ بطيء سيُقطَع رأسه وتُزيَّن به
أسوار ملاطية

269
00:16:30,630 --> 00:16:32,180
!النّجدة

270
00:16:32,180 --> 00:16:34,260
!اثبتوا! لا تخافوا

271
00:16:35,720 --> 00:16:38,070
لا بُدّ أنّك القائد العسكريّ دانا

272
00:16:38,070 --> 00:16:41,480
ابقَ صامتاً إذا كنت تُقدِّر حياتك

273
00:16:41,800 --> 00:16:43,910
!عبرَ رجالُنا البوّابةَ الغربيّة

274
00:16:43,910 --> 00:16:45,860
،أسرْنا كافّة الضبّاط الكبار

275
00:16:45,860 --> 00:16:48,390
وسنسيطر قريباً على البوّابة الشّرقيّة

276
00:16:48,390 --> 00:16:50,360
سيطرنا على قاعة المدينة

277
00:16:50,630 --> 00:16:54,990
مُذهل، خطّة الأمير كايل تفلح حقّاً

278
00:16:54,990 --> 00:16:56,600
يجب عليّ تقديم المُساعدة أيضاً

279
00:16:57,160 --> 00:17:01,080
!سموّك! جنود ميتانّي المُشاة ينهبون الخزينة

280
00:17:01,790 --> 00:17:03,970
يمكننا ترك الأمر للمُتأخّرين{?}

281
00:17:03,970 --> 00:17:05,590
!لا، لا يمكننا

282
00:17:05,590 --> 00:17:09,480
لا تزال عين إيلّويانكا في الخزينة

283
00:17:09,480 --> 00:17:11,510
إذا وجدوها، سيُقضى علينا

284
00:17:11,840 --> 00:17:13,890
سأذهب للبحث عنها

285
00:17:14,370 --> 00:17:16,740
!توقّفي يا يوري! لا داعي للذّهاب

286
00:17:16,740 --> 00:17:18,680
!الأمير كايل! وصلَ أمير الظّلام

287
00:17:18,680 --> 00:17:19,930
ماذا؟

288
00:17:20,330 --> 00:17:21,550
يجب أن أركض

289
00:17:21,970 --> 00:17:26,220
لن نسمح لأحد بالحصول على شيء
يتحكّم بعقول البشر

290
00:17:27,460 --> 00:17:31,280
!عادَ أميرُ الظّلام عبر البوّابة الشّرقيّة

291
00:17:31,280 --> 00:17:35,120
لكن قيلَ لي بأنّ البوّابة الشّرقيّة ستكون
تحت سيطرتنا الآن

292
00:17:35,450 --> 00:17:40,540
كانت كذلك، لكن قطعَ أحدُهم حِبال أقواس
النبّالين المُخصّصين للبوّابة

293
00:17:41,920 --> 00:17:44,450
قالوا بأنّ أمير الظّلام يعلم بأنّنا هنا

294
00:17:44,450 --> 00:17:47,690
لأنّ الجنود الّذين أُرسِلوا لإيقاف
المبعوث قد قُتِلوا

295
00:17:47,690 --> 00:17:51,730
هذا يعني أنّ شخصاً في فيلقنا كان يُعرقلني

296
00:17:52,610 --> 00:17:54,200
هل ستكون يوري بخير؟

297
00:17:54,550 --> 00:17:55,940
!استعجلوا

298
00:17:55,940 --> 00:17:58,100
!خذوا أيّ شيء يبدو قيّماً

299
00:17:59,510 --> 00:18:04,060
بئساً. كيف  أجد صندوقاً صغيراً
وسط هذه الكومة الهائلة؟

300
00:18:06,580 --> 00:18:07,430
من هناك؟

301
00:18:09,440 --> 00:18:12,330
ألستَ الكاهن؟

302
00:18:12,330 --> 00:18:13,760
لماذا أنت هنا؟

303
00:18:14,200 --> 00:18:15,700
صحيح

304
00:18:15,700 --> 00:18:19,290
إن لم تُمانع، هل يمكنك مُساعدتي؟
أنا أبحث عن شيء

305
00:18:23,010 --> 00:18:25,740
لحظة، هل يُعقَل أن يكون هذا؟

306
00:18:26,590 --> 00:18:28,140
أين أمير الظّلام؟

307
00:18:28,140 --> 00:18:31,890
لا داعي للقلق. لن ندعه يتجاوز
باحة البوّابة الشّرقيّة

308
00:18:31,890 --> 00:18:34,710
نحن نسيطر على كامل المدينة تقريباً الآن

309
00:18:34,710 --> 00:18:36,410
إذاً أحضر يوري إليّ

310
00:18:36,410 --> 00:18:40,690
،الآن بعد أن علمنا بأنّه يوجد مُخرّبٌ بيننا
إلى أين من المُمكن أن تكون قد ذهبتْ؟

311
00:18:40,690 --> 00:18:42,480
أستميحك عذراً

312
00:18:42,740 --> 00:18:45,350
هل رأيت شالما-ساما؟

313
00:18:45,350 --> 00:18:47,730
يبدو أنّنا افترقنا

314
00:18:47,730 --> 00:18:48,920
شالما؟

315
00:18:48,920 --> 00:18:51,580
أجل. اسمه أورهي شالما

316
00:18:51,580 --> 00:18:53,280
كان هنا منذ البداية؟

317
00:18:53,280 --> 00:18:55,450
!سموّ الأمير كايل

318
00:18:55,450 --> 00:19:00,160
أجل. أُمِرَ بواسطة الملِكة للانضمام
للحملة العسكريّة ككاهن

319
00:19:00,500 --> 00:19:02,250
الملِكة فعلتْ ذلك؟

320
00:19:02,520 --> 00:19:05,250
!لا بُدّ أنّه هذا! بحثتُ في كُلّ مكان

321
00:19:05,250 --> 00:19:07,880
أجل، أنا أيضاً

322
00:19:14,830 --> 00:19:19,670
انضممتُ للحملة العسكريّة لاستعادة هذه الأداة

323
00:19:19,670 --> 00:19:23,890
تريدني الملكةُ ناكيا أن آخذ
هذا الطّلسم إليها

324
00:19:24,560 --> 00:19:27,770
لا تزال تحتوي هذه الغرفة
على أشياء قيّمة

325
00:19:28,030 --> 00:19:29,390
أجل، هذه هي

326
00:19:29,730 --> 00:19:31,750
مهلاً، إنّها فتاة

327
00:19:32,670 --> 00:19:34,280
ستُحقّق مبيعات طائلة

328
00:19:35,570 --> 00:19:37,070
!اهربوا

329
00:19:37,070 --> 00:19:40,510
أولئك الجنود الأوغاد. أخذوا العذراء منّي

330
00:19:40,510 --> 00:19:42,630
لكن حصلتُ على الطّلسم على الأقلّ

331
00:19:42,630 --> 00:19:44,200
!أفسح الطّريق

332
00:19:47,410 --> 00:19:48,630
ماذا تفعل؟

333
00:19:50,750 --> 00:19:54,510
هل أنت كاهن هيتّايتي؟

334
00:19:54,820 --> 00:19:57,930
أمير ظلام ميتانّي؟

335
00:19:59,710 --> 00:20:02,380
لم آتِ إلى هنا لقتل كهَنة

336
00:20:02,380 --> 00:20:04,740
:لكن قُل لكايل مورسيلي التّالي

337
00:20:04,740 --> 00:20:11,510
،لك الحُرّية في الاستيلاء على ملاطية"
"لكن سيُزيّن رأسُك رمحاً يوماً ما

338
00:20:11,510 --> 00:20:12,770
مفهوم؟

339
00:20:12,770 --> 00:20:17,600
.يبدو أنّك تُثمّن هذا الشّيء
اسمح لي بأن آخذه

340
00:20:18,230 --> 00:20:19,530
هيّا بنا

341
00:20:19,530 --> 00:20:21,230
!إلى كافّة الجنود، تراجعوا

342
00:20:21,230 --> 00:20:23,030
!سنُغادر ملاطية

343
00:20:23,030 --> 00:20:27,160
كانت عين إيلّويانكا في كفّ يدي

344
00:20:28,040 --> 00:20:30,980
أمير الظّلام يأمر بالانسحاب. هل نحن جاهزون؟

345
00:20:30,980 --> 00:20:33,460
أجل. حصلنا على كُلّ ما نحتاج من غنائم

346
00:20:33,460 --> 00:20:36,170
بهذه الكومة الصّغيرة، لن نحتاج
المال لفترة من الزّمن

347
00:20:36,170 --> 00:20:39,770
لدينا فتاة أيضاً ستُباع بثمن باهظ

348
00:20:39,770 --> 00:20:40,680
!هيّا بنا

349
00:20:41,100 --> 00:20:45,600
!الأمير كايل! غزونا ملاطية! المدينة مُلكنا

350
00:20:45,600 --> 00:20:49,140
!لِمَ لم يُعثَر على يوري بعد؟ ابحثوا عنها حالاً

351
00:20:49,140 --> 00:20:52,060
!لاذ الميتانّي بالفرار كالكِلاب

352
00:20:52,060 --> 00:20:54,650
!ملاطية مُلكنا

353
00:20:54,920 --> 00:20:58,880
مُذهل. غزونا ملاطية في غضون أيّام حقّاً

354
00:20:58,880 --> 00:21:01,950
أجل. سارت الأمور وفق خطّة الأمير كايل حرفيّاً

355
00:21:01,950 --> 00:21:03,780
أختي، انظري للأسفل هناك

356
00:21:03,780 --> 00:21:05,360
!إنّها يوري-ساما

357
00:21:10,190 --> 00:21:11,410
...يوري

358
00:22:45,050 --> 00:22:50,060
عشتار المسلوبة