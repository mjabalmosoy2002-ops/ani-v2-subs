1
00:00:01,860 --> 00:00:04,780
يا لها من حالة! كانت عشتار الحقيقيّة

2
00:00:04,780 --> 00:00:07,400
كنتُ أنا من زجّ بها في السّجن

3
00:00:07,700 --> 00:00:09,400
اسمعوا إلى هذا الكلام

4
00:00:09,400 --> 00:00:13,530
كلّ الّذين أظهروا عِداءً ليوري-ساما
،سوف يُعدَمون

5
00:00:13,530 --> 00:00:15,830
أو يقضون بقيّة أيّامهم في المنفى

6
00:00:17,410 --> 00:00:21,390
لكن الأمير كايل وعشتار المُقدّسة رحيمان

7
00:00:21,390 --> 00:00:24,880
!لذا اشكروا كُلّ آلهة هيتّايتي خاصّتنا أيّها الوقحون

8
00:00:26,610 --> 00:00:28,980
يمكننا الاكتفاء بهذا

9
00:00:28,980 --> 00:00:31,720
قلّة تهذيب يوري تُلام أيضاً

10
00:00:31,990 --> 00:00:32,820
سموّك

11
00:00:33,220 --> 00:00:38,860
أشكرك على تساهلك من أعماق
قلبي يا سموّ الأمير كايل

12
00:00:38,860 --> 00:00:42,980
رغم ذلك، أريد مُعاقبة هذه المرأة على مكرها

13
00:00:46,150 --> 00:00:47,990
أنتِ عشتار المُزيّفة؟

14
00:00:47,990 --> 00:00:52,730
ينبغي أن نحكم على هذه المرأة بالأشغال
الشّاقة مدى الحياة في الأقاليم

15
00:00:52,730 --> 00:00:55,010
في العادة، نأمر بقتلها

16
00:00:56,350 --> 00:00:57,870
أنتِ، أخبريني

17
00:00:59,620 --> 00:01:01,410
لماذا فعلتِ ذلك؟

18
00:01:01,870 --> 00:01:04,090
من المؤكّد أنّكِ كنتِ تعلمين بأنّكِ ستنكشفين

19
00:01:09,550 --> 00:01:13,590
أردتُ أن أعيش حلمي، ولو لبُرهة فقط

20
00:01:14,320 --> 00:01:18,820
وُلِدتُ في قرية نائية وفقيرة في الغرب

21
00:01:19,240 --> 00:01:22,730
أُبيدَتْ تماماً بواسطة الحُمّى
الّتي دامتْ عشرة أيّام

22
00:01:22,730 --> 00:01:26,980
والدايّ وأخوتي الصّغار هلَكوا بشكل مُؤلم

23
00:01:28,480 --> 00:01:31,820
لم أرد أن أضطرّ لتحمُّل مثل هذه
المِيتة القاسية

24
00:01:32,180 --> 00:01:35,030
لم أرِد عيش حياة بؤس من جديد

25
00:01:36,950 --> 00:01:39,340
وكأنّكِ الوحيدة الّتي تُعاني

26
00:01:39,780 --> 00:01:42,790
دمّرَت الحُمّى عدداً لا يُحصى من الأرواح

27
00:01:43,930 --> 00:01:46,790
يوري-ساما، ينبغي أن تعمل في المناطق النّائية

28
00:01:47,280 --> 00:01:50,240
معك حقّ. ينبغي أن نجعلها تعمل

29
00:01:50,670 --> 00:01:52,550
كخادِمة في قصر الأمير

30
00:01:53,950 --> 00:01:56,850
يوري-ساما، كيف لهذه أن تكون عقوبة؟

31
00:01:56,850 --> 00:02:00,120
كُلّ فتاة في العاصمة تطمح للعمل في قصر

32
00:02:00,120 --> 00:02:03,230
لا يمكننا السّماح لهذه المحتالة
!بالعمل بالقرب منكِ

33
00:02:03,230 --> 00:02:06,450
،نحتاج مزيداً من الأيدي العاملة
لذا هذا مثاليّ

34
00:02:06,450 --> 00:02:10,650
فضلاً عن ذلك، استأجرنا هادي وأختيها
بعد أن حاولنَ قتلي

35
00:02:12,440 --> 00:02:14,320
سموّ الأمير، ما رأيك؟

36
00:02:15,510 --> 00:02:17,830
يا امرأة، ما هو اسمكِ الحقيقيّ؟

37
00:02:17,830 --> 00:02:20,330
ا-اسمي أورسولا، سموّك

38
00:02:20,710 --> 00:02:24,710
حسناً يا أورسولا، هل ترغبين في خدمة يوري؟

39
00:02:25,830 --> 00:02:28,960
هل تقول حقّاً بأنّها ستسمح لي بخدمتها؟

40
00:02:29,350 --> 00:02:34,280
حتّى بعد أن انتحلتُ اسمَ عشتار بطلاناً
ولطّختُ سمعتَها علناً؟

41
00:02:34,720 --> 00:02:37,930
وحملتْ أيضاً ذلك الجنين دون تردُّد

42
00:02:39,390 --> 00:02:40,610
إنّها أفضل منّي

43
00:02:42,670 --> 00:02:45,550
سيكون شرفاً لي أن أخدمكِ، مولاتي

44
00:02:46,060 --> 00:02:49,900
،سموّ الأمير كايل، بما أنّ كُلّ الأمور حُسِمَتْ
فيجدر بنا العودة إلى هاتّوسا

45
00:02:49,900 --> 00:02:52,530
لا يمكننا الابتعاد عن العاصمة لفترة طويلة جدّاً

46
00:02:52,800 --> 00:02:54,700
بالفعل، كما تقول

47
00:02:55,590 --> 00:02:58,270
صحيح. صِراع القِوى

48
00:02:58,270 --> 00:03:00,320
ما آخر تطوّرات ذلك؟

49
00:04:32,850 --> 00:04:34,280
قسَم القبر

50
00:04:38,260 --> 00:04:41,010
أهلاً بعودتكِ يا يوري-ساما

51
00:04:41,300 --> 00:04:44,050
عدتِ بأمان. هذا مُطمئن

52
00:04:44,050 --> 00:04:47,060
أنا أيضاً مسرور لأنّكِ عدتِ سالمة

53
00:04:47,540 --> 00:04:50,580
أجل، في الواقع، آسفة على المُغادرة
دون إخباركم

54
00:04:50,580 --> 00:04:53,810
هل حدثتْ أي تطوُّرات بشأن اختيار
وليّ العهد المُقبل؟

55
00:04:54,060 --> 00:04:56,340
العدد قليلٌ على الاختيار بين المُعسكرين

56
00:04:56,340 --> 00:04:58,350
النُّبلاء يدعمون الملكة وابنها

57
00:04:58,350 --> 00:05:03,070
.لكن الجيش يدعم الأمير كايل
ووزراء المجلس مُنقسمان بالتّساوي

58
00:05:03,490 --> 00:05:07,200
يبدو أنّ العامّة سيكونون الصّوت الحاسم

59
00:05:07,200 --> 00:05:11,210
على أيّ حال، ستُحسَم المسألة في المرّة
المُقبلة الّتي يتدخّل فيها الوُزراء

60
00:05:11,580 --> 00:05:16,050
لكن الأولويّة لمراسم التّتويج للملك الجديد

61
00:05:20,050 --> 00:05:22,050
!يا لها من جمهرة

62
00:05:22,050 --> 00:05:26,260
يحظى النّاس بفُرص قليلة ثمينة
لرؤية الملكيّين علناً

63
00:05:26,260 --> 00:05:28,180
هذا نادرٌ للغاية

64
00:05:29,040 --> 00:05:32,560
!الملكة ناكيا

65
00:05:32,560 --> 00:05:33,870
!تحيا الأرملة الملِكة

66
00:05:33,870 --> 00:05:35,150
!الأمير جودا

67
00:05:37,650 --> 00:05:39,780
هناك الكثير من الهتافات

68
00:05:39,780 --> 00:05:42,110
هل جميعهم يحبّون الملِكة إلى هذا الحدّ؟

69
00:05:42,870 --> 00:05:44,870
!الأمير كايل

70
00:05:45,670 --> 00:05:47,840
!يحيا الأمير كايل

71
00:05:47,840 --> 00:05:51,080
!يحيا وليّ العهد كايل وعشتار

72
00:05:51,080 --> 00:05:52,330
!وليّ العهد كايل

73
00:05:52,330 --> 00:05:53,390
!الأمير كايل

74
00:05:53,390 --> 00:05:55,150
!عشتار المُقدّسة

75
00:05:56,670 --> 00:06:01,720
ينبغي لهذا الاستقبال أن يقنع
أيّ شخص، حتّى الملكة

76
00:06:07,350 --> 00:06:09,970
...أنا، أرنواندا الثّاني

77
00:06:10,350 --> 00:06:13,120
أعيّن كايل مورسيلي كوليّ عهدي

78
00:06:13,480 --> 00:06:15,780
تهانينا يا سموّ الأمير كايل

79
00:06:15,780 --> 00:06:19,020
تهانينا يا وليّ العهد الجديد

80
00:06:19,470 --> 00:06:24,280
كايل، أتطلّع قُدماً لدعمك وتعاونك

81
00:06:24,800 --> 00:06:26,290
حاضر، جلالتك

82
00:06:30,660 --> 00:06:33,040
يوري-ساما، تهانينا

83
00:06:33,900 --> 00:06:35,500
إنّها أنباء سارّة

84
00:06:35,500 --> 00:06:37,170
أجل، بكلّ تأكيد

85
00:06:37,170 --> 00:06:38,350
ما هذا؟

86
00:06:38,670 --> 00:06:42,130
السّبب الأهمّ لهذه المُناسبة
لم يُسمَح لها بالدّخول؟

87
00:06:42,440 --> 00:06:45,430
تستحقّين أن تتواجدي في الدّاخل
،أكثر من أيّ شخص آخر

88
00:06:45,430 --> 00:06:48,110
مع ذلك تقفين في الخارج ببساطة لأنّكِ محظيّة

89
00:06:48,110 --> 00:06:49,510
هذا سخيفٌ حقّاً

90
00:06:49,510 --> 00:06:51,160
بالفعل

91
00:06:51,160 --> 00:06:55,820
إذا كانت هكذا ستُعامل، فينبغي لها
أن تُسرع وتصبح زوجته

92
00:06:55,820 --> 00:06:57,730
لا تفعلي من فضلكِ يا هادي

93
00:06:58,230 --> 00:07:02,730
،لا أملك المكانة لأكون زوجته
ولا أريد ذلك

94
00:07:24,470 --> 00:07:25,860
الجوّ بارد

95
00:07:30,390 --> 00:07:31,560
مُستحيل

96
00:07:31,560 --> 00:07:32,350
ثلج؟

97
00:07:35,100 --> 00:07:36,640
أنتِ مُستيقظة بالفعل؟

98
00:07:36,640 --> 00:07:38,980
!سموّ الأمير، انظر! الثّلوج تتساقط

99
00:07:39,590 --> 00:07:41,160
هكذا إذاً

100
00:07:44,260 --> 00:07:47,240
أعتقد بأنّ هذا هو أوّل شتاء لكِ في الأناضول

101
00:07:47,240 --> 00:07:51,700
،أجل. في هذه الفترة من العام الماضي
كنّا نخوض حملة ميتانّي

102
00:07:52,080 --> 00:07:55,120
لا أصدِّق ذلك. إنّها تُثلِج بالفعل

103
00:07:55,120 --> 00:07:58,460
ومع ذلك الصّيف هنا جافّ وحارّ للغاية

104
00:07:58,460 --> 00:08:00,890
إنّه ليس حارّاً إلى تلك الدّرجة طوال العام

105
00:08:00,890 --> 00:08:04,380
،حالما يصل الشّتاء إلى الأناضول
كُلّ ما يمكنك فعله هو انتظار الرّبيع

106
00:08:04,380 --> 00:08:06,340
"يطلق النّاس على هذا بـ"موسم الأرض

107
00:08:06,680 --> 00:08:08,220
انتظار الرّبيع؟

108
00:08:08,220 --> 00:08:10,090
إنّه الموسم الرّطب، صحيح؟

109
00:08:11,860 --> 00:08:14,100
ذلك عندما يُفترض بي العودة

110
00:08:17,970 --> 00:08:20,040
هذا لا يُصدَّق

111
00:08:20,040 --> 00:08:23,360
ينامان في نفس السّرير في كلّ ليلة
ومع ذلك لم يُحقّقا أي تقدُّم؟

112
00:08:23,360 --> 00:08:26,400
ما مُشكلة الأمير كايل ويوري-ساما؟

113
00:08:26,400 --> 00:08:29,320
استطعتِ تمييز ذلك يا أورسولا؟

114
00:08:29,320 --> 00:08:32,300
،بالطّبع. قد يكون سموّه خبيراً

115
00:08:32,300 --> 00:08:35,980
لكن لا يبدو أنّ يوري-ساما تعرف
الكثير عن جسد الذّكور

116
00:08:35,980 --> 00:08:39,830
في الواقع، الجميع في هذا القصر
جهَلة كثيراً في العلاقات

117
00:08:39,830 --> 00:08:41,000
وجدتُها

118
00:08:41,000 --> 00:08:46,120
سأحرص شخصيّاً على أن يُتمّم
ذلكما الاثنان علاقتهما

119
00:08:47,300 --> 00:08:52,260
.يا فتيات، أنتن هنا للعمل، لا للثّرثرة
تنتظرنا مهام كثيرة

120
00:08:52,820 --> 00:08:54,140
هل يمكنني تقديم المُساعدة؟

121
00:08:54,460 --> 00:08:56,950
يوري-ساما. لم نستطع سؤالكِ

122
00:08:56,950 --> 00:08:59,980
هيّا يا آنسة هادي. ينبغي لنا
التّرحيب بمُساعدتها

123
00:09:00,700 --> 00:09:04,230
يوري-ساما، هذا غيار ملابس الأمير كايل

124
00:09:04,230 --> 00:09:08,860
.يستخدم الحمّامَ الآن، لذا خذيه إليه
...وأثناء وجودكِ هناك

125
00:09:08,860 --> 00:09:12,110
يمكنكِ الانضمام له في الحمّام؟

126
00:09:12,110 --> 00:09:14,120
ماذا؟ أنا؟

127
00:09:23,880 --> 00:09:25,010
من هناك؟

128
00:09:27,880 --> 00:09:29,930
يوري؟

129
00:09:30,380 --> 00:09:32,660
أ-أجل، هذه أنا

130
00:09:32,660 --> 00:09:34,680
أحضرتُ ملابسك

131
00:09:34,680 --> 00:09:37,240
شكراً لكِ

132
00:09:37,240 --> 00:09:39,430
هلّا سكبتِ لي بعض الخمر أيضاً رجاء؟

133
00:09:39,430 --> 00:09:41,440
حسناً

134
00:09:46,940 --> 00:09:49,510
هل هو مُرهَق تماماً؟

135
00:09:49,510 --> 00:09:53,790
لا بُدّ أنّه كذلك. يبدو أنّه يُساعد
الملكَ الجديد كثيراً

136
00:09:53,790 --> 00:09:57,330
لا بُدّ أنّها الفترة الوحيدة الّتي يتمكّن
فيها من الاسترخاء

137
00:10:01,410 --> 00:10:03,860
ما الخطب؟ هل أنتِ بردانة؟

138
00:10:03,860 --> 00:10:06,920
لـ-لا. إطلاقاً

139
00:10:06,920 --> 00:10:10,140
إن كنتِ كذلك، فينبغي أن تأتي
وتتدفّئي معي

140
00:10:10,630 --> 00:10:12,480
!مهلاً يا سموّ الأمير

141
00:10:15,970 --> 00:10:19,060
لماذا تضحك؟ ابتللتُ تماماً

142
00:10:19,400 --> 00:10:21,620
هذا بديهيّ. فأنتِ في حمّام

143
00:10:21,620 --> 00:10:23,640
يا إلهي، أنت ثمل

144
00:10:25,130 --> 00:10:26,100
ما الأمر؟

145
00:10:26,100 --> 00:10:27,490
أنا بخير

146
00:10:27,490 --> 00:10:30,500
الجرح في ظهري يؤلمني بين الحين والآخر فقط

147
00:10:30,500 --> 00:10:32,980
من السّهم الّذي تلقّيتِه عندما مات زانّانزا؟

148
00:10:32,980 --> 00:10:34,200
أجل

149
00:10:34,200 --> 00:10:36,660
دعيني أرى جرحكِ

150
00:10:38,200 --> 00:10:40,450
سـ-سموّ الأمير؟

151
00:10:43,040 --> 00:10:45,780
كانت بشرتكِ ملساء وصافية تماماً

152
00:10:45,780 --> 00:10:47,630
لكنّها الآن مليئة بالنّدبات

153
00:10:48,880 --> 00:10:50,880
ا-انتظر

154
00:10:55,860 --> 00:10:58,280
...ماذا الآن؟ رغم ذلك

155
00:10:59,060 --> 00:11:00,150
...أنا

156
00:11:00,830 --> 00:11:02,740
واقعة في حُبّك

157
00:11:02,740 --> 00:11:05,190
...لا أكترث لما يحدث

158
00:11:06,390 --> 00:11:07,690
بعد الآن

159
00:11:17,780 --> 00:11:18,950
سـ-سموّ الأمير؟

160
00:11:19,600 --> 00:11:22,050
لا أريدكِ أن تُصابي بنزلة برد

161
00:11:22,540 --> 00:11:24,320
يجب أن تُبدّلي ملابسكِ أيضاً

162
00:11:26,420 --> 00:11:27,320
ماذا؟

163
00:11:27,830 --> 00:11:29,200
لماذا؟

164
00:11:32,050 --> 00:11:34,150
إنّهما صعبا المراس

165
00:11:34,150 --> 00:11:38,500
إذاً سأضيف لطعامهما مُثيراً للشّهوة ببساطة

166
00:11:40,140 --> 00:11:43,720
يبدو أنّنا استأجرنا خبيراً

167
00:11:48,480 --> 00:11:51,000
ما الخطأ الّذي ارتكبتُه؟

168
00:11:51,000 --> 00:11:54,510
كنتُ جاهزاً حتّى لإقامة علاقة معه
في ذلك الوقت

169
00:11:56,240 --> 00:11:57,320
من فعل ذلك؟

170
00:12:00,980 --> 00:12:03,580
طفل؟ في القصر؟

171
00:12:03,580 --> 00:12:05,700
ما الأمر يا يوري-ساما؟

172
00:12:05,700 --> 00:12:07,540
أنتن

173
00:12:07,540 --> 00:12:08,920
هل تعرفنَ هذا الطّفل؟

174
00:12:09,230 --> 00:12:10,100
لا

175
00:12:10,100 --> 00:12:11,420
لا نعرفه

176
00:12:11,420 --> 00:12:13,130
من أين أتى؟

177
00:12:13,130 --> 00:12:15,710
أتيت إلى هنا إذاً

178
00:12:16,380 --> 00:12:20,720
لا يجوز أن تبتعد. فنحن هنا لمُقابلة سموّه

179
00:12:20,720 --> 00:12:23,350
من هي؟ إنّها حسناء

180
00:12:23,350 --> 00:12:24,930
...هذا

181
00:12:24,930 --> 00:12:26,890
كيكّوري. لم أرك منذ وقت طويل

182
00:12:26,890 --> 00:12:28,310
من تكون؟

183
00:12:28,310 --> 00:12:31,150
،هذه غوزيل-ساما

184
00:12:31,150 --> 00:12:34,650
ابنة آيغيل-ساما، الّذي يقود مجلس الوُزراء

185
00:12:34,940 --> 00:12:36,610
غوزيل-ساما؟

186
00:12:37,030 --> 00:12:39,230
لا بُدّ أنّكِ عشتار المُقدّسة

187
00:12:39,230 --> 00:12:41,170
شرف لي أن ألتقي بكِ

188
00:12:42,200 --> 00:12:45,120
عليك أن تلقي التّحيّة عليها أيضاً يا كايل

189
00:12:45,460 --> 00:12:46,750
كايل؟

190
00:12:48,420 --> 00:12:50,710
...أجل. ابني هو

191
00:12:53,250 --> 00:12:55,640
سموّك. آيغيل-ساما قد جاء

192
00:12:56,760 --> 00:12:59,760
اعذرني على هذه الزّيارة المُفاجئة، سموّك

193
00:13:00,040 --> 00:13:04,230
سأسمح بذلك، لكنّنا نلتقي يوميّاً
في قصر الملك

194
00:13:04,230 --> 00:13:05,640
ألم يكن باستطاعتنا التكلُّم هناك؟

195
00:13:06,270 --> 00:13:07,420
لا، سموّك

196
00:13:07,420 --> 00:13:09,640
حسناً. صرِّح عمّا تريد

197
00:13:10,100 --> 00:13:11,730
عُلِم، سموّك

198
00:13:11,730 --> 00:13:16,360
آمل أنّك تتذكّر ابنتي غوزيل؟

199
00:13:16,610 --> 00:13:19,360
أجل. أتذكّرها جيّداً

200
00:13:19,660 --> 00:13:23,160
أعلم بأنّ ابنتي لم تعُد من ضمن اهتماماتك
منذ زمن بعيد

201
00:13:23,160 --> 00:13:25,860
لا بُدّ أنّك تتساءل عن سبب ذِكري لها الآن

202
00:13:25,860 --> 00:13:29,870
لكن قبل حوالي عام، أنجبتْ غوزيل طفلاً

203
00:13:31,250 --> 00:13:35,630
وليّ العهد كايل، ذلك الطّفل هو ابنك

204
00:13:39,010 --> 00:13:41,720
هل أنتِ متأكّدة بأنّ هذا الفتى
هو ابن الأمير كايل؟

205
00:13:42,020 --> 00:13:43,060
أجل

206
00:13:43,060 --> 00:13:48,360
قبل صيفين، كان سموّه يزور منزلي
في كلّ ليلة

207
00:13:48,360 --> 00:13:51,090
لمُشاركة حُبّه لي

208
00:13:51,090 --> 00:13:53,140
فأنجبتُ هذا الفتى نتيجة ذلك

209
00:13:53,140 --> 00:13:56,220
الأمير كايل لديه طفل؟

210
00:13:57,140 --> 00:14:02,780
فـ-في الواقع، هذا منطقيّ. فقد كان لديه
الكثير من العشيقات. أو هذا ما سمعتُه

211
00:14:03,100 --> 00:14:07,920
ولم أكن قد التقيتُ به أصلاً
عندما كان يُقابلها

212
00:14:08,400 --> 00:14:09,530
...أعلم ذلك، لكن

213
00:14:11,830 --> 00:14:13,150
أنا مسحوقة

214
00:14:20,450 --> 00:14:21,420
كايل

215
00:14:22,430 --> 00:14:23,370
جلالتك

216
00:14:24,040 --> 00:14:27,390
سمعتُ بأنّ لديك طفل وريث أنجبته بغير قصد

217
00:14:27,390 --> 00:14:31,770
إذاً هل أدخلتَ السّيّدة غوزيل إلى قصرك؟

218
00:14:31,770 --> 00:14:34,140
لا، لم أفعل ذلك بعد

219
00:14:34,140 --> 00:14:38,400
لِمَ التّأخير؟ أمُّ غوزيل تحمل دماً ملَكيّاً

220
00:14:38,400 --> 00:14:40,780
تتمتّع غوزيل بالنّسب المُلائم لتكون زوجتك

221
00:14:40,780 --> 00:14:45,780
،يمكنها أن تكون صاحبتك من الأساس
لكن يجب أن تدخل قصرَك حالاً

222
00:14:50,320 --> 00:14:54,790
هل سيجعل الأميرُ غوزيل-ساما زوجتَه حقّاً؟

223
00:14:56,000 --> 00:14:59,880
لا أدري. لكنّها أنجبتْ مولوده الأوّل

224
00:14:59,880 --> 00:15:04,990
أجل. لا بُدّ أنّ الأمير كايل مسرور
بامتلاك طفل ذكَر

225
00:15:04,990 --> 00:15:07,640
أراد الأمير كايل طفلاً؟

226
00:15:07,640 --> 00:15:09,040
!يوري-ساما

227
00:15:09,040 --> 00:15:12,720
.نحن نتحدّث عن مُعتقَد سائد فحسب
رُبّما تكون حالته استثنائيّة

228
00:15:15,310 --> 00:15:17,810
بئساً. يجب أن أذهب وأحضِّر وجبتنا

229
00:15:17,810 --> 00:15:19,500
سـ-سأقدّم المُساعدة يا أختي

230
00:15:19,500 --> 00:15:20,830
يجب أن أحضر الماء

231
00:15:20,830 --> 00:15:22,190
حان وقت التّنظيف

232
00:15:22,190 --> 00:15:23,980
أنتن؟

233
00:15:27,320 --> 00:15:28,200
ماذا؟

234
00:15:30,570 --> 00:15:32,390
كاش، ما الأمر؟

235
00:15:32,390 --> 00:15:34,170
هل تضبط قوسَك هنا؟

236
00:15:34,170 --> 00:15:35,580
يوري-ساما

237
00:15:35,580 --> 00:15:38,960
أتيتُ فقط كنوع من التّغيير

238
00:15:38,960 --> 00:15:41,960
فهمت. هلّا طرحتُ سؤالاً؟

239
00:15:42,320 --> 00:15:43,190
تفضّلي

240
00:15:43,830 --> 00:15:47,880
بما أنّك رجل، فهل امتلاك ابن
هو أمرٌ جلل؟

241
00:15:47,880 --> 00:15:50,030
يمكنني القول بأنّه كذلك

242
00:15:50,030 --> 00:15:53,310
لهذا الرّجال الأقوياء يُرافقون محظيّات باستمرار

243
00:15:53,310 --> 00:15:56,270
يريدون الحرص على حصولهم على وريث ذكَر

244
00:15:57,520 --> 00:15:59,350
،وإن كنتُ الأمير كايل

245
00:15:59,350 --> 00:16:04,180
فسأرغب في وريثٍ في أسرع وقت
،مُمكن لأسباب سياسيّة

246
00:16:04,180 --> 00:16:07,150
الآن بعد أن أصبحتُ وليّ عهد الهيتّايتي

247
00:16:07,540 --> 00:16:09,530
أسباب سياسيّة؟

248
00:16:09,530 --> 00:16:10,840
—لذا بالتّفكير للأمام

249
00:16:10,840 --> 00:16:11,910
بئساً يا حشرة

250
00:16:12,780 --> 00:16:14,260
لماذا فعلتِ ذلك؟

251
00:16:15,950 --> 00:16:18,420
يوري-ساما، تعالي وتذوّقي الطّعام

252
00:16:18,420 --> 00:16:20,460
بجدّية. ما مُشكلتكِ؟

253
00:16:21,780 --> 00:16:23,660
سأغلق فمك هذا

254
00:16:23,660 --> 00:16:27,170
لا أصدّق بأنّ مُتوحِّشاً عديم الإحساس
مثلك يقود عربات الخيول

255
00:16:28,240 --> 00:16:31,140
وما الّذي تعرفه خادمة جديدة؟

256
00:16:31,140 --> 00:16:33,100
لا جدوى من الشّرح

257
00:16:33,100 --> 00:16:36,180
خدمتَ لمدّةٍ أطول، ومع ذلك أنت عديم الإحساس تماماً

258
00:16:36,180 --> 00:16:37,310
!ماذا؟

259
00:16:37,600 --> 00:16:38,280
خُذ

260
00:16:40,730 --> 00:16:43,150
ستقوم بأعمال التّنظيف هنا

261
00:16:43,150 --> 00:16:44,320
ماذا؟

262
00:16:46,120 --> 00:16:48,570
عملُك هو تنظيف مُخلّفاتك

263
00:16:51,490 --> 00:16:55,240
يوري-ساما، لا تهتمّي لما قاله

264
00:16:55,920 --> 00:16:57,160
فهمتُ الآن

265
00:17:01,540 --> 00:17:05,680
الآن عرفتُ لماذا تركني الأمير
كايل في الحمّام

266
00:17:06,270 --> 00:17:11,700
تواجُدي مع الأمير لا يتمحور حول
محبّة بعضنا الآخر

267
00:17:11,700 --> 00:17:14,680
،سيترتّب عليّ إنجاب أطفاله وتربيتهم

268
00:17:14,960 --> 00:17:18,440
كُلّ هذا بينما أكون وسط أيّ حدث سياسيّ

269
00:17:18,910 --> 00:17:20,960
وغالباً أكثر من ذلك حتّى

270
00:17:21,520 --> 00:17:24,600
لكن هل أنا جاهزة لكلّ ذلك؟

271
00:17:25,200 --> 00:17:28,590
كان يعلم بأنّني لم أكن كذلك، ولهذا السّبب توقّف

272
00:17:28,590 --> 00:17:32,280
لا أستطيع تقبُّل ذلك، وقد لاحظَ ذلك فوراً

273
00:17:39,370 --> 00:17:43,210
سموّك، لِمَ لا ترى ابنك بنفسك؟

274
00:17:43,210 --> 00:17:47,880
لا أنا ولا أبي نطمع بمكاسب
...سياسيّة. لذا من فضلك

275
00:17:47,880 --> 00:17:51,440
سوف نتحادث لاحقاً

276
00:17:51,440 --> 00:17:53,970
روسافا، رافق السّيّدة غوزيل رجاء

277
00:17:55,760 --> 00:17:56,850
!سموّك

278
00:18:01,400 --> 00:18:02,600
يوري؟

279
00:18:02,600 --> 00:18:03,970
سموّ الأمير؟

280
00:18:03,970 --> 00:18:06,280
لِمَ لا تُقابل الصّبيّ؟

281
00:18:06,790 --> 00:18:09,360
...إن كان بسببي

282
00:18:14,070 --> 00:18:16,620
ابن غوزيل ليس ابني

283
00:18:17,650 --> 00:18:20,500
لماذا لا تُبلغ الجميع بذلك إذاً؟

284
00:18:20,500 --> 00:18:23,330
الآن ليس الوقت المُناسب

285
00:18:23,870 --> 00:18:27,610
ماذا تقصد؟ هل هو أمر سياسيّ؟

286
00:18:27,610 --> 00:18:29,960
لستُ أفهم حقّاً

287
00:18:29,960 --> 00:18:33,420
تبدو كرجل يتملّص من مسؤوليّاته

288
00:18:33,790 --> 00:18:34,930
ماذا؟

289
00:18:35,220 --> 00:18:39,180
سموّ الأمير، إن كنت تُحاول أن تُراعي
مشاعري، فلا تفعل

290
00:18:39,180 --> 00:18:44,590
لا يهمّ لي مَن تتزوّج، ولا كم طفلاً لديك

291
00:18:44,590 --> 00:18:50,010
فضلاً عن ذلك، سأعود إلى الدّيار
في الرّبيع القادم على أيّ حال

292
00:18:50,010 --> 00:18:50,920
!يوري

293
00:18:54,950 --> 00:18:56,870
تريد العودة؟

294
00:18:56,870 --> 00:18:58,910
لكن كنتُ أعلم ذلك

295
00:19:01,730 --> 00:19:02,620
!كيكّوري

296
00:19:03,770 --> 00:19:04,620
!أعطِني الرّسَن

297
00:19:06,970 --> 00:19:10,240
لطالما كنتُ أبحث عن زوجة

298
00:19:10,240 --> 00:19:12,780
فلماذا لم تكن غوزيل؟

299
00:19:12,780 --> 00:19:15,720
ولا كافّة الحسناوات رفيعات المرتبة الأُخريات؟

300
00:19:16,020 --> 00:19:19,220
لم أكن أعرف ما الّذي يعنيه
أن أُحبّ امرأة

301
00:19:19,660 --> 00:19:21,100
إلى أن التقيتُ بكِ

302
00:19:22,350 --> 00:19:23,960
ثمّ عرفتُ أخيراً

303
00:19:25,770 --> 00:19:27,590
ماذا؟ الأمير؟

304
00:19:29,650 --> 00:19:32,430
سـ-سموّ الأمير؟ ما هذا؟

305
00:19:32,900 --> 00:19:36,040
أنزلني. إلى أين أنت ذاهب؟

306
00:19:43,150 --> 00:19:45,540
ما هذا المكان؟

307
00:19:46,700 --> 00:19:48,310
سأقولها من جديد

308
00:19:48,310 --> 00:19:51,420
ابن غوزيل ليس ابني

309
00:19:52,060 --> 00:19:53,630
—إذاً لماذا تتكتّم على الأمـ

310
00:19:53,630 --> 00:19:55,300
لا يهمّني ما يعتقده الآخرون

311
00:19:56,550 --> 00:19:59,220
لكن أريد أن أحرص على أن تعلمي أنتِ تحديداً

312
00:20:00,720 --> 00:20:03,720
هذا المكان هو ضريح أمّي

313
00:20:04,270 --> 00:20:07,320
فقط أبي الرّاحل وأنا دخلنا هذا المكان

314
00:20:08,100 --> 00:20:11,890
أنت تُقسم في ضريح أمّك الآن؟

315
00:20:11,890 --> 00:20:14,120
لهذا أحضرتني إلى هنا؟

316
00:20:21,910 --> 00:20:24,770
أحفظ تاريخ آخر لِقاء بيني وبين غوزيل

317
00:20:25,740 --> 00:20:30,460
أنجبتْ بعد ذلك بأكثر من عام كامل

318
00:20:30,770 --> 00:20:32,480
لا يمكن أن يكون طفلي

319
00:20:32,980 --> 00:20:36,590
لكن اعتقدَ آيغيل بأنّه ابني، لذا أخبرني

320
00:20:36,590 --> 00:20:38,470
كونه رجلاً صادقاً

321
00:20:38,470 --> 00:20:41,180
إذاً غوزيل هي من يكذب؟

322
00:20:41,450 --> 00:20:43,640
لم تكن غوزيل مُخادِعة من قبل

323
00:20:43,640 --> 00:20:47,960
لماذا تكذب إذاً؟ هل هناك من يتحكّم بها؟

324
00:20:47,960 --> 00:20:48,980
...أيُعقَل

325
00:20:51,600 --> 00:20:52,900
أجل

326
00:20:52,900 --> 00:20:56,460
بسبب احتماليّة ذلك، لا أستطيع
التصرُّف باستعجال

327
00:20:58,070 --> 00:21:02,070
.لنعُد إلى القصر يا سموّ الأمير
الوقت يُداهمنا

328
00:21:02,540 --> 00:21:03,440
حسناً

329
00:21:04,920 --> 00:21:09,870
أمّي، لا أعلم ما إن ستصبح هذه
،العذراء لي أم لا

330
00:21:09,870 --> 00:21:13,400
لكن أردتُ أن أريكِ يوري ولو لمرّة على الأقلّ