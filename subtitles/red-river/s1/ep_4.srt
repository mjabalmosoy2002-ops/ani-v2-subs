1
00:00:02,100 --> 00:00:03,880
،هذه هاتّوسا

2
00:00:04,370 --> 00:00:08,900
عاصمة إمبراطوريّة هيتّيتي في القرن
الرّابع عشر قبل الميلاد

3
00:00:10,590 --> 00:00:16,080
هذه قصّة فتاة تركب الرّياح الحارّة الرّطبة

4
00:00:16,650 --> 00:00:18,840
عبر مسافات الأناضول الواسعة

5
00:00:27,350 --> 00:00:31,240
تهبُّ رياحٌ عاتية، لتحمل معها الرّمال الجافّة

6
00:00:33,220 --> 00:00:34,970
،تهبُّ الرّياح ساخنة

7
00:00:35,730 --> 00:00:37,760
،وأنا أعيش تحت هذه السّماء

8
00:00:38,180 --> 00:00:42,520
النّهر الأحمر

9
00:00:38,400 --> 00:00:40,960
على ضفاف النّهر الأحمر

10
00:02:07,730 --> 00:02:09,400
تجسيد عشتار

11
00:02:21,810 --> 00:02:24,590
انتهى المطاف بمُرافقتي له دون تفكير

12
00:02:27,970 --> 00:02:29,060
...ماذا

13
00:02:29,500 --> 00:02:32,510
هل هذا هو النّهر الأحمر؟

14
00:02:32,850 --> 00:02:35,130
ذلك النّهر هو ماراسّانتيا

15
00:02:35,130 --> 00:02:39,240
اليابسة الحمراء الّتي وُجِدَتْ في الضِّفاف
تصبغ النّهرَ بهذا اللّون

16
00:02:40,650 --> 00:02:45,710
الهيتّاتيّون القدماء كانوا يعيشون في هذه
المنطقة على ضفاف هذا الّنهر

17
00:02:45,710 --> 00:02:49,650
تمتدّ إمبراطوريّتنا الآن لمسافات شاسعة
الآن وراء هذه الضِّفاف

18
00:02:50,320 --> 00:02:55,340
لكن يبقى العالم في هذا الجانب
من ماراسّانتيا موطننا الحقيقيّ

19
00:02:55,650 --> 00:02:58,400
إذاً هذا هو مسقط رأس الهيتّايتيّين

20
00:02:59,600 --> 00:03:02,540
مدينة ألينّا تقع على امتداد النّهر

21
00:03:03,040 --> 00:03:07,470
.قال تيتو بأنّ لديه ثلاث أخوات
آمل أن يكُنّ بخير

22
00:03:07,470 --> 00:03:10,000
ما كنتُ لأقلق بشأنهن

23
00:03:10,340 --> 00:03:15,260
إنّهن من عشيرة هاتّي. تستطيع أولئك الفتيات مُنافسة
مُعظم الرّجال في استخدام الأسلحة

24
00:03:15,870 --> 00:03:19,340
كان تيتو ينتمي إلى إحدى العشائر
الأقدم في هذا العالم

25
00:03:19,340 --> 00:03:21,390
وكان أبوه هو شيخ العشيرة

26
00:03:22,140 --> 00:03:25,390
.تلك الفتيات مُلفِتات للنّظر
سترين ذلك بنفسكِ

27
00:03:26,370 --> 00:03:29,520
لكن كنتُ أنا من تسبّب بمقتل تيتو

28
00:03:30,030 --> 00:03:32,630
بأيّ وجه سأقابل أخواته؟

29
00:03:35,270 --> 00:03:38,180
شرف لنا أن نلتقي بكِ يا يوري-ساما

30
00:03:38,180 --> 00:03:42,660
نحن بنات تالوس، شيخ الهاتّي

31
00:03:43,120 --> 00:03:45,120
أنا الكُبرى، هادي

32
00:03:45,120 --> 00:03:47,960
،هاتان التّوأمتان هما أختايّ
ريوي وشالا

33
00:03:48,220 --> 00:03:51,540
نحن الثّلاثة كنّا نتطلّع قُدماً لوصولكن

34
00:03:52,540 --> 00:03:55,320
إنّهن أخوات تيتو حقّاً

35
00:03:56,120 --> 00:03:57,700
—إذاً، المعذرة

36
00:03:57,700 --> 00:03:58,320
هادي

37
00:03:59,010 --> 00:04:01,950
سامحيني، لكن أريد أن أعرف
الوضع في الشّمال

38
00:04:01,950 --> 00:04:04,200
خذيني إلى مجلس الحرب

39
00:04:04,200 --> 00:04:05,530
أمرك، سموّك

40
00:04:06,280 --> 00:04:09,940
آسف يا يوري، سيترتّب عليكِ التحدُّث
معهم في وقت لاحق

41
00:04:09,940 --> 00:04:11,570
حسناً

42
00:04:12,620 --> 00:04:13,800
فهمت

43
00:04:18,510 --> 00:04:20,230
أهذه هي حقّاً؟

44
00:04:20,230 --> 00:04:24,190
ظننتُ بأنّ محظيّة الأمير كايل
ستكون حسناء فوق الوصف

45
00:04:24,190 --> 00:04:27,050
بجدّية. إنّها مُجرّد فتاة نحيلة

46
00:04:27,050 --> 00:04:28,260
إنّها كذلك بالفعل

47
00:04:28,260 --> 00:04:32,420
إنّها بلا قيمة حرفيّاً من دون حماية سموّه

48
00:04:32,870 --> 00:04:37,350
،ومع ذلك هي من قتلت تيتو
لذا يجب أن تدفع حياتها ثمن ذلك

49
00:04:55,350 --> 00:04:56,150
يوري

50
00:04:56,150 --> 00:05:00,270
،يجب أن أتوجّه إلى ساحة المعركة
لكن لا أريدكِ أن تتعرّضي لخطر

51
00:05:00,270 --> 00:05:01,210
سموّك

52
00:05:01,660 --> 00:05:04,530
لو سمحت، سنعتني نحن بيوري-ساما

53
00:05:04,530 --> 00:05:05,550
هادي

54
00:05:05,980 --> 00:05:07,130
...لكنّني

55
00:05:07,850 --> 00:05:08,910
سموّ الأمير

56
00:05:09,540 --> 00:05:11,990
سأنتظرك هنا

57
00:05:12,750 --> 00:05:15,630
سأكون بخير بوجودهن معي

58
00:05:16,360 --> 00:05:19,130
أريد أيضاً أن أتكلّم معهن بشأن تيتو

59
00:05:22,690 --> 00:05:26,430
أعتقد يستطيع هؤلاء الثّلاثة
ردع رجال الملِكة

60
00:05:26,960 --> 00:05:27,950
عُلِم

61
00:05:28,350 --> 00:05:30,180
إذاً سأتركها تحت رعايتك

62
00:05:30,580 --> 00:05:31,480
سموّك

63
00:05:42,920 --> 00:05:44,810
!لا تُطاردوا الهاربين

64
00:05:44,810 --> 00:05:47,040
مهمّتنا هي الدِّفاع عن آلينّا

65
00:05:47,040 --> 00:05:49,500
!كُلّ ما نحتاجه هو التصدّي للكاشوغا

66
00:05:53,420 --> 00:05:56,880
ماذا؟ ألا يوجد فُرسان يركبون الخيول؟

67
00:05:56,880 --> 00:05:58,950
!كوني منطقيّة

68
00:05:58,950 --> 00:06:02,190
الخيول هي لجرّ العربات في القتال فقط

69
00:06:02,190 --> 00:06:04,400
هـ-هل هذا قانون؟

70
00:06:05,350 --> 00:06:07,210
انظري إلى الأمير كايل هناك

71
00:06:10,150 --> 00:06:11,350
!سموّ الأمير

72
00:06:19,750 --> 00:06:20,780
...أخبريني

73
00:06:20,780 --> 00:06:23,990
لستُ خبيرة، لكن ألسنا نخسر؟

74
00:06:27,310 --> 00:06:28,620
معكِ حقّ

75
00:06:29,580 --> 00:06:32,150
الكاشوغا هم أوهن الخصوم

76
00:06:32,150 --> 00:06:34,670
هل تلقّوا معلومات مُسبَقة؟

77
00:06:36,040 --> 00:06:39,480
ربّما الملِكة تتحكّم بالأشياء من الظِّلال

78
00:06:40,370 --> 00:06:44,680
سموّ الأمير كايل، عُد بأمان أرجوك

79
00:06:44,680 --> 00:06:49,050
لحظة! ما هذا؟ هل أنا واقعة
في حُبّ الأمير؟

80
00:06:51,200 --> 00:06:52,700
!ابتعدوا! ابتعدوا

81
00:06:52,700 --> 00:06:57,040
سأقطع الصّديق والعدوّ على حدّ
!سواء إذا وقف في طريقي

82
00:06:59,910 --> 00:07:00,900
أُنثى؟

83
00:07:00,900 --> 00:07:02,860
هل هي تلك الفتاة؟

84
00:07:02,860 --> 00:07:05,340
لا بُدّ أنّ الملكة استدرجَتها إلى هنا

85
00:07:05,340 --> 00:07:07,510
هذه المرّة، سأحصل على رأسها

86
00:07:10,750 --> 00:07:15,900
،إذا استدرجتِ يوري إلى زووا
ستثأرنَ لموت تيتو حتماً

87
00:07:16,750 --> 00:07:20,390
لحسن الحظّ، تمكّنا من وضع طعم لزووا

88
00:07:21,440 --> 00:07:23,710
سنُدفِع قاتلَ تيتو الثّمن

89
00:07:26,550 --> 00:07:29,720
لا يمكن أن أكون واقعة في حُبّه

90
00:07:31,050 --> 00:07:32,560
!يا فتاة

91
00:07:32,560 --> 00:07:34,060
!عثرتُ عليكِ

92
00:07:34,060 --> 00:07:34,770
!زووا

93
00:07:43,900 --> 00:07:47,010
تلك الحمقاء. تعتقد بأنّها تستطيع
أن تسبق عربة؟

94
00:07:47,010 --> 00:07:49,910
اقتلها. أجهز عليها حالاً

95
00:07:49,910 --> 00:07:52,280
!لن تفلتي

96
00:07:54,980 --> 00:07:56,120
خيول؟

97
00:08:03,340 --> 00:08:04,920
تركب حصاناً؟

98
00:08:11,600 --> 00:08:13,970
!سأسقط! أيُّها الحصان السيّئ

99
00:08:13,970 --> 00:08:16,980
!أنت قاسٍ جدّاً كأوّل مرّة

100
00:08:17,260 --> 00:08:18,850
لن تهرب

101
00:08:19,570 --> 00:08:20,940
...إنّها مُتوجِّهة

102
00:08:21,540 --> 00:08:23,120
نحو مُنحدر مباشرة

103
00:08:24,240 --> 00:08:26,810
!حصان مُطيع! لا تُقدِم على أيّ تصرُّف غبيّ

104
00:08:24,600 --> 00:08:26,810
!تذوّقي الموت يا فتاة

105
00:08:37,690 --> 00:08:39,280
!هـ-هجوم

106
00:08:39,280 --> 00:08:41,040
من الخاصرة؟

107
00:08:41,040 --> 00:08:44,040
كيف نزلتْ من الأعلى هناك؟

108
00:08:44,040 --> 00:08:48,090
!حصان غبيّ! توقّف فحسب

109
00:08:50,720 --> 00:08:53,030
!تراجعي! ستدوسين علينا

110
00:08:55,310 --> 00:08:59,820
سـ-سموّ الأمير كايل! الكاشوغا تنكسر صفوفهم

111
00:08:59,820 --> 00:09:04,490
من يركب حصاناً في معركة؟
لم أسمع بمُجازفة كهذه

112
00:09:05,310 --> 00:09:09,490
لكن من الواضح أنّ هذا يمنح مرونةً وقوّة
اختراقيّة أكبر من عربة

113
00:09:10,650 --> 00:09:11,810
يوري

114
00:09:12,280 --> 00:09:14,220
!هذه هي فُرصتنا يا رجال

115
00:09:14,220 --> 00:09:16,580
!لنسحق الكاشوغا في هجمة واحدة

116
00:09:25,370 --> 00:09:27,550
الكاشوغا قد تفرّقوا

117
00:09:27,550 --> 00:09:32,930
وكانوا يربحون حتّى قلبت تلك
الفتاة الموازين بحصانها

118
00:09:34,110 --> 00:09:36,260
أختي، انظري. هناك

119
00:09:42,440 --> 00:09:43,390
!ريوي

120
00:09:43,980 --> 00:09:47,480
!أيُّها الحصان! إلى هناك! فوراً

121
00:09:47,480 --> 00:09:48,650
ما-ماذا؟

122
00:09:48,650 --> 00:09:52,340
حسناً، آسفة. كان ينبغي أن
أطلب بطريقة ألطف

123
00:09:52,340 --> 00:09:55,740
هل يمكنك أن تأخذني إلى تلك
الفتاة من فضلك؟

124
00:09:55,740 --> 00:09:59,010
يمكننا ترك الجنود يتولّون الباقي

125
00:09:59,010 --> 00:10:00,160
أين يوري؟

126
00:10:03,170 --> 00:10:04,920
يوري-ساما هناك

127
00:10:12,830 --> 00:10:14,650
!يا لها من فتاة

128
00:10:15,450 --> 00:10:19,860
حوّلَتْ هزيمةً وشيكةً في آلينّا
إلى نصر لنا بسهولة

129
00:10:23,750 --> 00:10:27,110
هذه المدينة مليئة بالأحاديث
عنك يا يوري-ساما

130
00:10:27,460 --> 00:10:29,830
يُقال بأنّكِ قد تكونين تجسيداً لعشتار

131
00:10:29,830 --> 00:10:31,710
هذا يكفي

132
00:10:31,710 --> 00:10:34,320
كلّ ما فعلتُه كان التمسُّك بحصان
حِفاظاً على حياتي

133
00:10:34,320 --> 00:10:41,070
فضلاً عن ذلك، الأمير كايل ناداني
بـ"عشتار" بشكل وليد اللّحظة فقط

134
00:10:41,070 --> 00:10:42,510
أليس كذلك؟

135
00:10:42,950 --> 00:10:45,080
أجل، معك حقّ

136
00:10:46,830 --> 00:10:52,510
انسي ذلك. ستُبهجين النّاسَ إذا لوّحتِ
لهم من الشّرفة

137
00:10:52,510 --> 00:10:54,890
قلتُ توقّف

138
00:10:54,890 --> 00:10:58,390
معها حقّ في أنّ مُناداتي لها بعشتار
...كان تصرُّفاً عفويّاً. مع ذلك

139
00:10:58,390 --> 00:10:59,690
المعذرة

140
00:11:00,900 --> 00:11:02,020
حضرة المُحافظ

141
00:11:02,020 --> 00:11:07,270
اخترتَ عقيلتَك بعناية. أنقذَتْنا جميعاً

142
00:11:08,650 --> 00:11:13,200
بالتّالي، أريد أن أقدّم لكِ
هديّة يا يوري-ساما

143
00:11:16,110 --> 00:11:17,500
نفس الحصان؟

144
00:11:17,500 --> 00:11:19,240
اسمه أصلان

145
00:11:19,240 --> 00:11:24,240
إنّه مُشاغب قليلاً، لكن يبدو أنّه
أُعجِبَ بكِ يا يوري-ساما

146
00:11:24,240 --> 00:11:25,870
إنّه مُلككِ الآن

147
00:11:27,200 --> 00:11:30,340
ينبغي أن نُزوّدها بسيف لتحمي نفسها

148
00:11:30,340 --> 00:11:36,260
إذاً أقترح سيفاً صغيراً تستطيع فتاة
حمله معها دون إثارة شُبهات

149
00:11:36,690 --> 00:11:40,610
بئساً. لا أريد حصاناً ولا سيفاً

150
00:11:41,140 --> 00:11:45,440
الأهمّ، أين أخوات تيتو؟

151
00:11:45,440 --> 00:11:47,680
لم أتكلّم معهن حوله بعد

152
00:11:48,840 --> 00:11:51,650
لا أُصدِّق بأنّها نجَتْ في وسط معركة

153
00:11:51,650 --> 00:11:55,940
لـ-لكنّها ضحّتْ وأنقذتني

154
00:11:55,940 --> 00:11:59,030
ربّما فعلَتْ ذلك، لكنّها قتلتْ تيتو

155
00:11:59,380 --> 00:12:03,030
يبدو أنّه يجب علينا الآن أن نفعل
الأمور بأيدينا

156
00:12:03,030 --> 00:12:07,820
لكن الأمير لا يترك يوري ولا حتّى لِلَحظة

157
00:12:07,820 --> 00:12:12,090
وهو ماهر جدّاً بالسّيف لدرجة
يقهرنا نحن الثّلاثة

158
00:12:14,540 --> 00:12:15,830
هذا أنت

159
00:12:16,290 --> 00:12:20,340
إن كنتُن تبحثنَ عن حلّ، فأقترح
هذا الماء الأبيض

160
00:12:20,790 --> 00:12:22,390
ماء أبيض؟

161
00:12:22,670 --> 00:12:27,240
ضعي الماء في فمِ ضحيّتكِ، لينتهي
الأمر بلمح البصر

162
00:12:30,950 --> 00:12:34,320
لا بُدّ أنّكِ مُتعبة. حان وقت النّوم

163
00:12:34,320 --> 00:12:37,860
...ماذا؟ أ-أجل، بخصوص ذلك

164
00:12:39,910 --> 00:12:43,090
اسمعي، إن كنتِ تنوين البقاء
،في هذا البلد

165
00:12:43,090 --> 00:12:46,450
سيكون من دواعي سروري أن تتعوّدي
على مُشاركة سرير معي

166
00:12:46,450 --> 00:12:47,990
،ما دمتِ هنا

167
00:12:47,990 --> 00:12:52,790
فأنتِ محظيّتي، مهما كانت
الظّروف الحقيقيّة

168
00:12:53,770 --> 00:12:54,750
أجل

169
00:12:55,290 --> 00:12:59,240
شكراً على تذكيري بأنّني محظيّتك المُزيّفة

170
00:12:59,670 --> 00:13:05,160
ظننتُ فقط بأنّني واقعة في حُبّه وهذا
ما في الأمر. ينبغي أن أتجاوز ذلك

171
00:13:05,520 --> 00:13:06,930
هل من مُشكلة؟

172
00:13:07,350 --> 00:13:08,980
لا شيء إطلاقاً

173
00:13:08,980 --> 00:13:10,350
سأخلد إلى النّوم

174
00:13:23,620 --> 00:13:26,200
سموّ الأمير، ما الّذي يجري؟

175
00:13:35,910 --> 00:13:39,120
.لا تتحرّكي واثبتي مكانكِ
دعي كُلّ شيء عليّ

176
00:13:47,430 --> 00:13:49,470
!يوري! سأقتلكِ

177
00:13:52,810 --> 00:13:54,270
!أحسنتِ التصدِّي يا يوري

178
00:13:55,900 --> 00:13:56,730
من أنت؟

179
00:13:59,710 --> 00:14:03,190
شالا؟ والأختان؟ ما معنى هذا؟

180
00:14:04,850 --> 00:14:08,540
كنّا مُستعدّات لقبول الموت
لدخول جناح النّوم الخاص بك

181
00:14:08,540 --> 00:14:12,830
لكن سننتقم من الشّخص الّذي قتل أخانا

182
00:14:12,830 --> 00:14:16,310
...تقصدنَ بأنّ يوري قتلتْ تيتو؟ لكنّه

183
00:14:16,310 --> 00:14:17,790
!انتظر يا سموّ الأمير

184
00:14:18,930 --> 00:14:20,840
أريد أن أقولها أنا

185
00:14:22,520 --> 00:14:26,140
أعترف بأنّني مُلامة على مقتل تيتو

186
00:14:26,140 --> 00:14:28,340
لكن اسمعنَ أرجوكن

187
00:14:28,840 --> 00:14:30,520
...ما أريد قوله هو

188
00:14:30,890 --> 00:14:33,640
أنا آسفة. آسفة حقّاً

189
00:14:36,760 --> 00:14:39,330
،أعلم بأنّ الاعتذار لن يُعيده

190
00:14:39,330 --> 00:14:41,940
ولا أتوقّع منكن أن تُسامحنني أيضاً

191
00:14:42,480 --> 00:14:46,060
لكن كان تيتو لطيفاً جدّاً معي

192
00:14:46,060 --> 00:14:49,700
كانت الملكة تحاول قتلي دوماً

193
00:14:49,700 --> 00:14:52,860
—لكن تقدّم تيتو لإنقاذي. ثمّ زووا

194
00:14:52,860 --> 00:14:53,750
!كاذِبة

195
00:14:53,750 --> 00:14:58,880
أخبرنا مبعوثٌ من الأمير كايل بأنّ
!تيتو قُتِلَ بواسطتك

196
00:14:59,630 --> 00:15:01,050
!ريوي! شالا

197
00:15:01,050 --> 00:15:02,280
!حسناً

198
00:15:02,280 --> 00:15:03,380
ماذا تفعلن؟

199
00:15:05,590 --> 00:15:08,240
إذا أردتِ الاعتذار، فافعليها أمام تيتو

200
00:15:08,240 --> 00:15:10,970
افعليها أمام نيرغال، إله عالم الآخرة

201
00:15:11,810 --> 00:15:14,220
هادي، يوري تقول الحقيقة

202
00:15:14,220 --> 00:15:17,590
زووا قتلَ تيتو وارتدى طوقَه في
مِعصمه وكأنّه سِوار

203
00:15:17,590 --> 00:15:19,900
ولم أرسل مبعوثاً أيضاً

204
00:15:27,280 --> 00:15:28,200
!يوري

205
00:15:32,310 --> 00:15:33,090
يوري

206
00:15:33,800 --> 00:15:37,080
لا... لا أستطيع التنفُّس

207
00:15:37,830 --> 00:15:38,830
أختي

208
00:15:39,830 --> 00:15:42,850
صدري وحلقي يحترقان

209
00:15:43,950 --> 00:15:45,140
...ما الّذي

210
00:15:46,030 --> 00:15:47,580
يحدث لي؟

211
00:15:49,470 --> 00:15:50,430
!يوري

212
00:15:54,760 --> 00:15:57,060
!فليُنقذنا أحد! كيكّوري

213
00:15:58,790 --> 00:16:00,440
حاضر، أنا هنا

214
00:16:00,440 --> 00:16:01,920
استدعِ طبيباً

215
00:16:02,730 --> 00:16:04,810
يوري-ساما! ماذا حدث لها؟

216
00:16:04,810 --> 00:16:05,720
!بسرعة

217
00:16:05,720 --> 00:16:07,780
!حـ-حاضر! حالاً

218
00:16:07,780 --> 00:16:10,450
هادي، لا بُدّ أنّكِ استخدمتِ سُمّاً

219
00:16:10,450 --> 00:16:11,530
ما كان نوعه؟

220
00:16:11,530 --> 00:16:13,660
لـ-لا أعلم

221
00:16:18,110 --> 00:16:20,340
أشعر ببرد في قلبي

222
00:16:20,900 --> 00:16:26,340
يتحوّل قلبي إلى جليد بشكل أسرع
من ازدياد برودة جسد يوري

223
00:16:27,320 --> 00:16:29,550
ستُفتَح عينا يوري ثانية

224
00:16:29,550 --> 00:16:31,050
لا بُدّ من ذلك

225
00:16:38,590 --> 00:16:39,480
كيف حالها؟

226
00:16:41,980 --> 00:16:43,060
!أجبني

227
00:16:45,670 --> 00:16:47,440
فات الأوان

228
00:16:48,780 --> 00:16:50,000
...هل تقصد

229
00:16:50,450 --> 00:16:55,290
لا تنفُّس أو نبض. لقد تُوفّيَتْ

230
00:16:58,950 --> 00:17:01,640
لا. مستحيل

231
00:17:02,540 --> 00:17:03,790
!يوري

232
00:17:19,520 --> 00:17:20,690
سموّ الأمير كايل

233
00:17:21,330 --> 00:17:25,150
يجب أن تأكل شيئاً من أجل سلامتك

234
00:17:26,390 --> 00:17:28,570
،لو كان هذا سيحدث

235
00:17:28,570 --> 00:17:32,530
فكان ينبغي أن أجبرها على العودة
إلى الدّيار عندما سنحت لنا الفُرصة

236
00:17:32,530 --> 00:17:35,060
أتفهّم جلدك لذاتك

237
00:17:35,060 --> 00:17:38,410
لكن كانت يوري-ساما من اختارت
في تلك اللّيلة

238
00:17:38,410 --> 00:17:39,410
!لا

239
00:17:40,350 --> 00:17:42,250
أنت مُخطئ يا كيكّوري

240
00:17:42,820 --> 00:17:46,410
الحقيقة هي أنّني أردتُها أن تبقى معي

241
00:17:46,950 --> 00:17:50,560
لم أُرِد إرسالها إلى المنزل
في تلك اللّيلة

242
00:17:52,830 --> 00:17:57,130
أعلم بأنّك تتألّم، لكن هل نستجوب
هادي والأخوات؟

243
00:17:58,340 --> 00:17:59,570
سنفعل

244
00:18:16,850 --> 00:18:19,570
ارتكبنا جريمةً لا تُغتفَر

245
00:18:19,570 --> 00:18:21,000
نقبل بالعقوبة

246
00:18:21,000 --> 00:18:22,190
!معتوهات

247
00:18:22,190 --> 00:18:25,620
كان تيتو يحبّ يوري وضحّى
!بحياته لإنقاذها

248
00:18:25,620 --> 00:18:26,420
—مع ذلك أنتن

249
00:18:25,620 --> 00:18:27,210
يكفي يا كيكّوري

250
00:18:28,910 --> 00:18:33,010
هادي، أتشهدين بأنّكِ لم تري
وجه المُحرِّض؟

251
00:18:33,300 --> 00:18:37,550
سامحنا، سموّك. كان وجهه
مُغطّى بغطاء أسود

252
00:18:37,550 --> 00:18:40,600
هذا أورهي، مُساعد الملِكة

253
00:18:41,040 --> 00:18:46,270
أجل، ربّما. لكن بما أنّهن لم يرين
وجهه، فلا يمكننا الجزم

254
00:18:47,330 --> 00:18:49,440
المعذرة، سموّك

255
00:18:49,440 --> 00:18:52,650
سرقَ أحدٌ جثمان يوري-ساما
من المعبد العظيم

256
00:18:52,650 --> 00:18:53,740
ماذا؟

257
00:18:55,740 --> 00:18:59,120
لدينا جنود مُتمركزون عند المداخل

258
00:18:59,420 --> 00:19:01,260
فكيف حدث هذا؟

259
00:19:01,260 --> 00:19:03,060
استخدم الشّرّير مخرجاً سرّيّاً

260
00:19:03,620 --> 00:19:09,050
القصور والمعابد لديها دوماً مثل هذه
المعابر في حالات الطّوارئ

261
00:19:09,470 --> 00:19:12,760
من الكاهن المسؤول عن هذا المعبد؟

262
00:19:12,760 --> 00:19:14,340
الملِكة

263
00:19:14,340 --> 00:19:17,760
لكن لماذا تنحدر لدرجة سرِقة جثمان؟

264
00:19:18,060 --> 00:19:23,010
بالفعل. الملكة لا تريد يوري ميّتة

265
00:19:23,420 --> 00:19:26,540
خطّتها هي قطع رأس يوري حيّة
كجزء من طقوس

266
00:19:27,140 --> 00:19:29,530
تسميمها سيكون مُخالفاً لذلك

267
00:19:30,090 --> 00:19:31,150
...قطعاً لا

268
00:19:35,770 --> 00:19:38,770
لا أستطيع الحركة

269
00:19:39,160 --> 00:19:44,330
ليس الآن. سنقطع رأسها بعد
نقلها إلى الملكة

270
00:19:44,330 --> 00:19:45,060
من هذا؟

271
00:19:45,060 --> 00:19:47,580
تحتاج رأسها فقط

272
00:19:47,580 --> 00:19:50,420
تقطيعها هنا لن يُشكّل فرقاً

273
00:19:50,420 --> 00:19:55,310
تريد الملكة قطع رأس العذراء
أثناء مُمارسة طقوس فعليّة

274
00:19:55,310 --> 00:19:58,090
سنستأصل رأسها حالما نصل
إلى هاتّوسا

275
00:19:58,390 --> 00:20:00,880
لم نُسمّمها فقط

276
00:20:00,880 --> 00:20:04,520
الماء الأبيض يجعل الجسدَ
في حالة موت مُؤقَّت

277
00:20:04,820 --> 00:20:06,970
خادم الملِكة وزووا؟

278
00:20:07,510 --> 00:20:09,900
لماذا أنا هنا؟

279
00:20:09,900 --> 00:20:12,700
دعني أفعلها الآن فحسب

280
00:20:12,700 --> 00:20:15,610
أعدك بأنّك ستتمكّن من الاحتفاظ بالرّأس

281
00:20:15,960 --> 00:20:17,910
لـ-لا

282
00:20:17,910 --> 00:20:20,640
يمكن تأجيل معرفة السّبب لوقت لاحق

283
00:20:21,050 --> 00:20:23,520
عليّ الخروج من هنا

284
00:20:23,910 --> 00:20:28,570
اقبل فحسب. الرّأس المقطوع هو
نفسه في أيّ مكان

285
00:20:29,630 --> 00:20:31,670
هل استيقظتِ يا فتاة؟

286
00:20:36,760 --> 00:20:39,470
زووا، لا تُلوّح بسيفك بتهوُّر

287
00:20:40,270 --> 00:20:42,720
يجب عليّ الخروج

288
00:20:43,290 --> 00:20:44,300
!ضوء

289
00:20:55,990 --> 00:20:59,820
من أنتِ؟ لماذا أنتِ هنا؟

290
00:21:00,270 --> 00:21:03,320
أ-أنا يوري

291
00:21:03,810 --> 00:21:04,900
يوري؟

292
00:21:04,900 --> 00:21:09,710
أتقصدين بأنّكِ المحظيّة الرّسميّة
الأولى للأمير كايل؟

293
00:21:10,960 --> 00:21:12,770
ومن تكون أنت؟