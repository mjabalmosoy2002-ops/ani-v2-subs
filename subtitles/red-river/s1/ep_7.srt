1
00:00:02,100 --> 00:00:03,880
،هذه هاتّوسا

2
00:00:04,370 --> 00:00:08,900
عاصمة إمبراطوريّة هيتّايتي في القرن
الرّابع عشر قبل الميلاد

3
00:00:10,590 --> 00:00:16,080
هذه قصّة فتاة تركب الرّياح الحارّة الرّطبة

4
00:00:16,650 --> 00:00:18,840
عبر مسافات الأناضول الواسعة

5
00:00:27,350 --> 00:00:31,240
تهبُّ رياحٌ عاتية، لتحمل معها الرّمال الجافّة

6
00:00:33,220 --> 00:00:34,970
،تهبُّ الرّياح ساخنة

7
00:00:35,730 --> 00:00:37,760
،وأنا أعيش تحت هذه السّماء

8
00:00:38,400 --> 00:00:40,960
على ضفاف النّهر الأحمر

9
00:02:07,510 --> 00:02:09,280
شفتان باردتان

10
00:02:15,110 --> 00:02:18,180
كيزّواتنا هي مملكةٌ مُتحالفة مع إمبراطوريّتنا

11
00:02:18,920 --> 00:02:21,420
يجب أن نجمع قوّات هيتّايتي بسرعة

12
00:02:21,420 --> 00:02:23,790
كيزّواتنا ليس لديها جيش؟

13
00:02:23,790 --> 00:02:28,470
لديها جيش، لكن لا يستطيع
الصُّمود أمام هذا الهجوم

14
00:02:28,470 --> 00:02:30,120
ستسقط في غضون يوم

15
00:02:30,500 --> 00:02:33,840
يوري، هل يمكنكِ الخروج من هذه
المدينة بمفردكِ؟

16
00:02:34,580 --> 00:02:38,240
يجب أن نُبلغ أخي بهذا مهما كلّف الأمر

17
00:02:38,240 --> 00:02:39,960
هل يمكنكِ فعلها يا يوري؟

18
00:02:39,960 --> 00:02:41,810
لكن ماذا ستفعل أنت؟

19
00:02:41,810 --> 00:02:46,230
سأحشد جنودَ هيتّايتي في نقطة عسكريّة
لكسبِ الوقت لأنفسنا

20
00:02:46,570 --> 00:02:50,490
النّقطة العسكريّة هي معقلٌ صغير
سيصمد لثلاثة أيّام

21
00:02:50,860 --> 00:02:55,290
أعتقد بأنّ أخي لحقَ بنا وهو
في كانيش بالفعل

22
00:02:55,820 --> 00:03:00,870
أريدكِ أن تبحثي عن أخي
وتجمعي جنودي في كانيش

23
00:03:02,750 --> 00:03:07,500
سأفعلها. أعِدُك بالعودة مع الأمير كايل
والجنود في غضون ثلاثة أيّام

24
00:03:08,750 --> 00:03:10,620
تقع كانيش شمال هذا المكان

25
00:03:10,620 --> 00:03:13,130
فقط اتّبعي النّجم القطبيّ الثّابت

26
00:03:13,130 --> 00:03:16,080
النّجم القطبيّ"؟ تقصد نجم الشّمال؟"

27
00:03:16,760 --> 00:03:17,470
!يوري

28
00:03:17,470 --> 00:03:18,480
لا تذهبي بعد

29
00:03:19,460 --> 00:03:21,850
أعتذر لأنّني خطفتُكِ وأحضرتُكِ إلى هنا

30
00:03:21,850 --> 00:03:26,440
ولماذا قلتُ بأنّني أغار من أخي؟

31
00:03:27,190 --> 00:03:30,110
هل كانت تلك مشاعري الحقيقيّة؟

32
00:03:30,110 --> 00:03:33,800
.كانت الملِكة تتحكّم بك فحسب
لا تقلق بشأن ذلك

33
00:03:34,360 --> 00:03:36,790
وداعاً يا سموّ الأمير. بالتّوفيق

34
00:03:37,800 --> 00:03:38,700
!يوري

35
00:03:38,700 --> 00:03:41,200
!سأعود بعد ثلاثة أيّام

36
00:03:42,910 --> 00:03:43,960
يوري

37
00:03:51,080 --> 00:03:53,210
كيف أتجاوزهم؟

38
00:03:53,210 --> 00:03:54,460
!لا تفعلوا أرجوكم

39
00:03:54,460 --> 00:03:56,410
!لا تؤذوا طفلي

40
00:03:56,410 --> 00:03:58,050
الأطفال عديمو القيمة على أيّ حال

41
00:03:59,880 --> 00:04:02,350
لا. لا أملك وقتاً لهذا

42
00:04:02,850 --> 00:04:04,770
لا يمكنني التورُّط

43
00:04:05,470 --> 00:04:06,440
!أمِّي

44
00:04:06,440 --> 00:04:07,530
!لا تفعل

45
00:04:07,530 --> 00:04:08,690
هذا كثير جدّاً

46
00:04:10,310 --> 00:04:12,560
لا تتحرّك أيُّها الطّفل

47
00:04:12,560 --> 00:04:14,530
!دعوهما وشأنهما

48
00:04:17,570 --> 00:04:19,240
من هذه الفتاة؟

49
00:04:19,240 --> 00:04:20,410
!ابني

50
00:04:20,740 --> 00:04:24,120
هناك دوماً قمامة أمثالكم في أيّ زمان كنّا

51
00:04:25,740 --> 00:04:28,160
!لـ-لنذهب! لم ينتهِ الأمر بعد

52
00:04:32,920 --> 00:04:35,840
يا إلهي. أنتِ مُذهلة

53
00:04:35,840 --> 00:04:38,250
شـ-شكراً جزيلاً لكِ

54
00:04:38,250 --> 00:04:39,760
يسرّني أنّكم بخير

55
00:04:40,060 --> 00:04:42,140
على أيّ حال، يجب عليّ الذّهاب

56
00:04:42,140 --> 00:04:45,760
لماذا ستُغادرين؟ السّفر خطيرٌ جدّاً

57
00:04:45,760 --> 00:04:48,640
لا، يجب عليّ المُغادرة حالاً

58
00:04:48,640 --> 00:04:51,760
يبدو وكأنّ لديكِ حاجة مُلِحّة لفعل ذلك

59
00:04:51,760 --> 00:04:53,310
حسناً، فليكُن

60
00:04:53,310 --> 00:04:55,690
سأدلّكِ على طريقٍ آمن، لذا اتبعيني

61
00:04:55,690 --> 00:04:57,110
مخرج سرّيّ؟

62
00:04:57,110 --> 00:04:59,400
إذاً ينبغي للجميع أن يسلكوه ويهربوا

63
00:04:59,400 --> 00:05:01,840
لن نذهب إلى أيّ مكان

64
00:05:01,840 --> 00:05:04,410
فهذه دولتنا في نهاية المطاف

65
00:05:04,670 --> 00:05:07,110
الحروب هي هكذا دوماً

66
00:05:07,110 --> 00:05:11,680
تُحرَق المنازل، وتُنهَب المتاجر، وتُهاجَم النّساء

67
00:05:12,230 --> 00:05:15,170
كلّ ما يمكننا فعله هو الاختباء
وتحيُّن فُرصتنا

68
00:05:16,030 --> 00:05:18,960
أنا متأكّدةٌ بأنّ جيش هيتّايتي سيأتي للإنقاذ

69
00:05:18,960 --> 00:05:22,930
أخشى بأنّ الهيتّايتي لا يختلفون
عن جنود ميتانّي

70
00:05:22,930 --> 00:05:26,430
الهيتّايتي لا يفعلون هذه الأشياء
الفظيعة للمدنيّين

71
00:05:28,450 --> 00:05:31,470
لن يسمح لهم الأمير كايل بفعل ذلك

72
00:05:37,440 --> 00:05:38,970
حسناً، اذهبي

73
00:05:39,790 --> 00:05:41,240
رافقتكِ السّلامة

74
00:05:43,720 --> 00:05:45,660
أقسم بأنّني سأعود

75
00:05:46,120 --> 00:05:48,550
سأعود رفقة الأمير كايل

76
00:05:49,170 --> 00:05:51,620
فقط اتّبعي نجم الشّمال الوحيد

77
00:05:52,190 --> 00:05:54,850
:أطلب من كافّة النُّجوم في السّماء الأناضوليّة

78
00:05:54,850 --> 00:05:59,480
،من فضلكِ أرشديني إلى الأمير كايل
أينما حلّ

79
00:06:07,100 --> 00:06:09,380
يوري، عسى أن تكوني بخير

80
00:06:09,380 --> 00:06:11,000
هل هذا حصانٌ ضالّ؟

81
00:06:14,050 --> 00:06:15,050
...لا، هذا

82
00:06:15,690 --> 00:06:16,630
!يوري

83
00:06:18,980 --> 00:06:21,030
تكلّمي معي؟ هل أنتِ متوعِّكة؟

84
00:06:21,030 --> 00:06:22,020
!يوري

85
00:06:24,310 --> 00:06:28,580
الأمير كايل؟ أهذا أنت

86
00:06:28,580 --> 00:06:31,450
أجل، أنا هنا. أليس هذا واضحاً؟

87
00:06:32,600 --> 00:06:35,050
هذا مُطمئن. نجوتُ

88
00:06:35,820 --> 00:06:39,640
سموّ الأمير، الميتانّي هاجموا كيزّواتنا

89
00:06:39,640 --> 00:06:41,110
نحتاج مزيداً من الجنود

90
00:06:41,110 --> 00:06:41,880
ماذا؟

91
00:06:41,880 --> 00:06:45,500
زانّانزا يفعل ما بوسعه لحماية الجميع

92
00:06:45,500 --> 00:06:47,890
لذا يجب عليك الذّهاب لمُساعدته

93
00:06:48,160 --> 00:06:50,300
حسناً. سأذهب بأقصى سرعة

94
00:06:50,300 --> 00:06:51,390
وثمّة أمر آخر

95
00:06:51,390 --> 00:06:58,040
مُر جنودك بعدم أذيّة الأبرياء هناك

96
00:06:59,230 --> 00:07:00,280
!يوري

97
00:07:02,510 --> 00:07:04,490
هادي، خُذي يوري

98
00:07:04,490 --> 00:07:05,320
حاضرة

99
00:07:07,910 --> 00:07:12,040
.كيكّوري، سنذهب إلى كانيش
سنقود جيشَ زانّانزا المُتمركز هناك

100
00:07:12,040 --> 00:07:12,970
أمرك

101
00:07:21,090 --> 00:07:23,090
ألن يُساعدنا جيش كيزّواتنا؟

102
00:07:24,180 --> 00:07:27,050
لم يحشدوا قوّاتهم بعد، ولا يمكننا
الصّمود فترة أطول

103
00:07:27,360 --> 00:07:28,340
يوري

104
00:07:29,030 --> 00:07:30,740
ألم تُحضري أخي بعد؟

105
00:07:30,740 --> 00:07:31,610
!سموّك

106
00:07:32,010 --> 00:07:33,150
!انظروا

107
00:07:45,340 --> 00:07:48,410
!عدتُ يا سموّ الأمير زانّانزا

108
00:07:48,410 --> 00:07:50,740
!أخي! يوري

109
00:07:51,060 --> 00:07:53,990
!أيّتها العربات، تقدّمي

110
00:08:02,970 --> 00:08:06,560
لم أتوقّع أن يصل الهيتّايتي بهذه السّرعة

111
00:08:07,750 --> 00:08:08,730
يجب أن أفكِّر

112
00:08:09,150 --> 00:08:11,990
كيف أُغرق دُول المُتوسِّط بدماء هيتّايتي؟

113
00:08:20,740 --> 00:08:21,610
!يوري

114
00:08:22,210 --> 00:08:23,480
!سموّ الأمير زانّانزا

115
00:08:23,480 --> 00:08:26,030
شكراً لكِ على إحضار أخي

116
00:08:26,030 --> 00:08:28,780
على شكر على واجب، يسرّني
أنّني وصلت في الوقت

117
00:08:31,680 --> 00:08:32,490
أخي

118
00:08:32,900 --> 00:08:36,380
أطلب غفرانك لأنّني خطفتُ يوري

119
00:08:37,310 --> 00:08:38,580
...أنا سوف

120
00:08:38,580 --> 00:08:40,500
سنتعامل مع هذه المسألة لاحقاً

121
00:08:40,960 --> 00:08:43,540
سأدخل المدينة عبر البوّابة الغربيّة

122
00:08:43,800 --> 00:08:48,300
بينما تتقدّم أنت عبر البوّابة الشّرقيّة
للالتفاف من خلف أمير الظّلام

123
00:08:48,300 --> 00:08:50,090
حـ-حسناً

124
00:08:50,090 --> 00:08:53,510
يوري، ستبقين في هذا المعقل
مع هادي وأختيها

125
00:08:53,510 --> 00:08:56,430
ماذا؟ لا، سأذهب أيضاً. خذني معك

126
00:08:56,430 --> 00:08:59,020
يُفترض أن تبقى عشتار في المعبد

127
00:08:59,520 --> 00:09:00,640
...لكنّني

128
00:09:00,640 --> 00:09:02,220
كيكّوري، هيّا بنا

129
00:09:02,220 --> 00:09:03,600
حـ-حاضر

130
00:09:18,990 --> 00:09:21,110
!سيُدافع المُشاة عن هذه الشّوارع

131
00:09:21,110 --> 00:09:23,030
!لا تؤذوا المُواطنين

132
00:09:23,030 --> 00:09:25,840
!أمِّنوا كُلّ النّساء والأطفال الّذين تُرِكوا

133
00:09:28,610 --> 00:09:32,880
إنّ أيّ ضرر للنّساء والأطفال يُزعج
إلَهة هيتّايتي، عشتار

134
00:09:34,220 --> 00:09:36,640
لن نُسيء مُعاملتكم. ثِقوا بنا

135
00:09:36,970 --> 00:09:38,520
لماذا تفعلون هذا؟

136
00:09:39,220 --> 00:09:42,230
استغرقنا سنوات لجمع مخزون الطّعام هذا

137
00:09:44,770 --> 00:09:45,980
مـ-من هناك؟

138
00:09:46,840 --> 00:09:49,370
كيف تُطاوعكم قلوبكم على حرق مدينة؟

139
00:09:49,370 --> 00:09:51,720
!هادي، ريوي، شالا! هيّا بنا

140
00:09:51,720 --> 00:09:52,320
حسناً

141
00:10:00,910 --> 00:10:02,480
!لـ-لننسحب

142
00:10:06,540 --> 00:10:07,460
ها أنتِ

143
00:10:07,460 --> 00:10:10,400
يسرّني أنّ جميعكم بخير

144
00:10:10,400 --> 00:10:11,970
!وأنتِ كذلك

145
00:10:11,970 --> 00:10:17,220
إذاً عدتِ لأجلنا فعلاً بعد الهرب
من الخطر بنجاح

146
00:10:17,490 --> 00:10:18,470
أجل

147
00:10:18,950 --> 00:10:23,440
وعدتُ مع الرّجل الّذي تجرّه الخيول الذّهبيّة

148
00:10:25,170 --> 00:10:27,110
أرى بأنّكِ تحترمين ذلك الرّجل

149
00:10:27,400 --> 00:10:31,260
وكما قلتُ، الهيتّايتي لن يؤذوكم أبداً

150
00:10:31,260 --> 00:10:32,910
لن يسمح لهم ذلك الرّجل

151
00:10:34,140 --> 00:10:37,960
قال الأمير بأنّه يريد بناء عالم مثاليّ

152
00:10:39,950 --> 00:10:42,590
هادي، اعتني بهن

153
00:10:42,590 --> 00:10:43,360
عُلِم

154
00:10:45,720 --> 00:10:48,900
يا إلهي، من تلك العذراء؟

155
00:10:48,900 --> 00:10:50,670
إنّها يوري-ساما

156
00:10:50,930 --> 00:10:54,550
،إنّها محظيّة للأمير الثّالث، كايل مورسيلي

157
00:10:55,280 --> 00:10:58,270
وتُعرَف بعشتار شعب الهيتّايتي

158
00:10:59,390 --> 00:11:01,360
تلك الفتاة الشّابّة؟

159
00:11:02,100 --> 00:11:05,810
أريد أن أكون مع الأمير كايل. وأكون مُفيدة له

160
00:11:06,270 --> 00:11:10,190
لذلك، سأفعل كُلّ ما بحيلتي
لِلَعب دور عشتار

161
00:11:25,660 --> 00:11:27,420
شكراً يا سموّ الأمير كايل

162
00:11:28,000 --> 00:11:30,550
حمقاء! طلبتُ منكِ البقاء في الحصن

163
00:11:30,550 --> 00:11:33,920
أنتِ تستدرجين العدوّ لمُهاجمتكِ
إذا رآكِ عزلاء

164
00:11:33,920 --> 00:11:36,240
أ-أنا آسفة

165
00:11:36,240 --> 00:11:38,800
أردتُ فعل شيء لتقديم المُساعدة

166
00:11:39,140 --> 00:11:42,060
يمكنني إدارة المعارك بشكل مثاليّ
دون مُساعدتكِ

167
00:11:46,780 --> 00:11:48,300
ما كان ينبغي أن أصرخ

168
00:11:48,890 --> 00:11:51,300
إنّني أغضب عندما أحتكّ في معركة

169
00:11:52,060 --> 00:11:56,650
لعبتِ دور عشتار بشكل مُبهر
أكثر ممّا تصوّرت

170
00:11:56,650 --> 00:11:58,150
فعلتِ ما يكفي

171
00:11:58,610 --> 00:12:00,000
سموّ الأمير كايل

172
00:12:01,200 --> 00:12:03,230
أخبرني بما يجب عليّ فعله

173
00:12:03,230 --> 00:12:05,250
قُل ما تشاء، وسأنفّذ

174
00:12:06,460 --> 00:12:09,480
لا أريد أن آخذها إلى ساحة المعركة

175
00:12:09,990 --> 00:12:13,710
في الواقع، كنتُ لأُفضِّل ألّا
تطأ قدماها خارج قصري

176
00:12:14,240 --> 00:12:17,940
،كنتُ لأحبسها في أعماق القصر
ولا أسمح لها برؤية أحد

177
00:12:17,940 --> 00:12:20,200
وذلك كي لا ينظر إليها أيّ رجل آخر

178
00:12:25,340 --> 00:12:27,060
ستكون مُلكي لوحدي

179
00:12:29,390 --> 00:12:30,810
!سموّك

180
00:12:30,810 --> 00:12:33,770
!اصطفّتْ جنود كيزّواتنا مع الميتانّي

181
00:12:33,770 --> 00:12:35,030
ماذا؟

182
00:12:35,030 --> 00:12:36,980
!انقلبَ الملِك سوناش علينا

183
00:12:37,780 --> 00:12:38,990
تعرّضنا لخيانة؟

184
00:12:39,250 --> 00:12:41,770
اقتحمَ أمير الظّلام القصر

185
00:12:44,130 --> 00:12:45,270
تبّاً

186
00:12:46,810 --> 00:12:49,060
سيُدمَّر جيشنا إذا لم نتصرّف

187
00:12:49,060 --> 00:12:52,540
،إذا وصلَ غزو الميتانّي إلى المدينة
سنخسر الحرب

188
00:12:59,970 --> 00:13:01,180
ماذا يفعلون؟

189
00:13:01,500 --> 00:13:04,850
!نحن دائماً محكومون بواسطة جيش أو آخر

190
00:13:04,850 --> 00:13:07,520
لذا نفضِّل أن نكون تحت حماية عشتار

191
00:13:07,520 --> 00:13:10,270
!على الخضوع لحُكمٍ دامٍ من أمير الظّلام

192
00:13:10,270 --> 00:13:14,770
،حتّى لو كان الملِك مع الميتانّي
!نحن مع الهيتّايتي

193
00:13:18,060 --> 00:13:19,280
أتيتُ لتسليم تقرير

194
00:13:19,280 --> 00:13:20,820
المُواطنون يثورون

195
00:13:20,820 --> 00:13:21,960
ماذا؟

196
00:13:22,450 --> 00:13:25,490
أهل المدينة يُهاجمون قوّاتنا داخل كيزّواتنا

197
00:13:25,490 --> 00:13:30,400
الجميع يُقاومون قوّاتنا بينما يُردّدون اسم عشتار

198
00:13:30,400 --> 00:13:32,000
كم هذا مُزعج

199
00:13:32,000 --> 00:13:34,520
أريد إنهاء العمل هنا

200
00:13:34,520 --> 00:13:38,230
لكن من غير الحكمة تحريض النّاس
في كلّ أنحاء هذه البلاد

201
00:13:39,020 --> 00:13:42,630
لا جدوى من البقاء هنا. سنُغادر

202
00:13:42,630 --> 00:13:43,580
سموّك

203
00:13:43,580 --> 00:13:47,890
وأخبرني: هل تعرف من يقود جيشَ الهيتّايتي؟

204
00:13:47,890 --> 00:13:48,640
أجل

205
00:13:48,900 --> 00:13:53,020
الجنود المأسورون يخبروننا بأنّه
أميرهم الثّالث، كايل مورسيلي

206
00:13:53,330 --> 00:13:55,020
كايل مورسيلي

207
00:13:56,790 --> 00:13:58,270
سأتذكّر هذا الاسم

208
00:14:02,030 --> 00:14:06,220
الأمير كايل مورسيلي، سـ-سامحني
على خيانتي أرجوك

209
00:14:06,680 --> 00:14:10,070
هذا يُخالف تماماً الحلف الّذي شكّلناه

210
00:14:10,670 --> 00:14:13,420
أ-أتوسل إليك أن تعفو عنّي

211
00:14:13,420 --> 00:14:15,790
!أصفح عن حياتي

212
00:14:15,790 --> 00:14:17,140
الملِك سوناش

213
00:14:17,590 --> 00:14:20,800
سيكون ملِكنا هو من يقرّر مصيرك

214
00:14:20,800 --> 00:14:23,800
ستحبس نفسك وتتنازل عن حُكمك للأمير

215
00:14:23,800 --> 00:14:25,920
!حاضر

216
00:14:25,920 --> 00:14:28,040
!عشتار

217
00:14:28,430 --> 00:14:32,360
!عشتار، امنحينا بركاتكِ

218
00:14:32,360 --> 00:14:35,440
!نُصلّي لأجل بركَاتكِ يا عشتار

219
00:14:36,420 --> 00:14:39,960
بدأ تقديسهم الأعمى لعشتار يشتدّ

220
00:14:39,960 --> 00:14:41,450
لا تراجُع الآن

221
00:14:42,220 --> 00:14:44,700
يوري، امنحيهم بركَاتكِ

222
00:14:44,700 --> 00:14:46,620
ماذا؟ لكن كيف؟

223
00:14:53,750 --> 00:14:56,200
شفتاه باردتان

224
00:15:05,360 --> 00:15:08,600
!تُنزِل عشتار برَكاتها على كيزّواتنا

225
00:15:12,140 --> 00:15:14,330
قلوبهم تشتعل شغفاً

226
00:15:14,330 --> 00:15:16,850
الشّمس حارّة كما الأرض الّتي نقف عليها

227
00:15:18,660 --> 00:15:21,010
لكن كانت قبلته باردة

228
00:15:31,820 --> 00:15:33,960
،ظننتُ بأنّنا سنربح المعركة

229
00:15:35,100 --> 00:15:37,310
لكن أولئك الثّلاثة يبدون بائسين

230
00:15:38,060 --> 00:15:42,330
تعلمين السّبب جيّداً. ما زالت
هناك تلك المسألة العالقة

231
00:15:42,670 --> 00:15:44,800
تـ-تلقّينا رسالة

232
00:15:44,800 --> 00:15:49,430
...الملِك قد استدعى سموّك ويوري-ساما

233
00:15:49,670 --> 00:15:51,480
إلى قصره

234
00:16:03,190 --> 00:16:08,200
هكذا إذاً. لا بُدّ أنّ الملِكة سعتْ
لعقد مجلِس الوُزراء

235
00:16:08,470 --> 00:16:09,610
وُزراء؟

236
00:16:09,890 --> 00:16:14,370
الملِك والملِكة يتشاركان النّفوذ
مع هؤلاء الرّجال

237
00:16:14,970 --> 00:16:18,230
كايل مورسيلي. زانّانزا هاتّوسيلي

238
00:16:18,630 --> 00:16:21,670
أثني عليكما على إنجازاتكما في كيزّواتنا

239
00:16:22,380 --> 00:16:27,130
لكنّها لا تكفي لإلغاء الحاجة لانتقادكما

240
00:16:27,710 --> 00:16:31,720
،يُفترض للأُمراء أن يكونوا قدوة لشعبهم

241
00:16:31,720 --> 00:16:35,850
مع ذلك فضيحة طالتْ أبنائي قد هزّت
العائلةَ الملكيّة والعاصمة

242
00:16:36,460 --> 00:16:37,770
لا سيّما أنت يا زانّانزا

243
00:16:38,130 --> 00:16:40,270
!الاختطاف هو جريمة لا تُغتفَر

244
00:16:40,270 --> 00:16:41,860
!جلالتك، اسمح لي أن أتكلّم

245
00:16:41,860 --> 00:16:43,000
اجلس

246
00:16:43,460 --> 00:16:45,440
لا يوجد ما تُدافع عنه

247
00:16:45,930 --> 00:16:51,660
عدد من الحُرّاس شهِدوا زانّانزا وهو يخطف
هذه الفتاة بالقوّة ويُغادر المدينة

248
00:16:51,950 --> 00:16:52,810
بالفعل

249
00:16:53,490 --> 00:16:56,410
—كعقوبة، أغرّمكما بـ 800 مانا فضّيّة

250
00:16:56,410 --> 00:16:57,690
!لا يمكننا أن نكون مُتساهلين

251
00:16:58,400 --> 00:17:02,250
!أطالب بتجريد كِلا الملكَين من لقبهما الملكيّ

252
00:17:03,460 --> 00:17:07,260
تقصد حرمانهما من حقّهما في الخِلافة؟

253
00:17:07,260 --> 00:17:12,220
جلالتك، قلتَ بأنّ الأمير ينبغي أن
يكون قدوة لشعبه

254
00:17:12,220 --> 00:17:14,760
لهذا أطالب بهذه العقوبة

255
00:17:15,030 --> 00:17:17,510
جرِّد الأميرين من رتبتهما

256
00:17:17,950 --> 00:17:20,520
!أطلب من المجلس التّصويت

257
00:17:20,520 --> 00:17:22,520
!غـ-غير مُمكن

258
00:17:23,720 --> 00:17:26,290
أؤيّد سعادتها

259
00:17:26,290 --> 00:17:28,150
أؤيّدها

260
00:17:28,150 --> 00:17:29,420
كذلك أنا

261
00:17:30,930 --> 00:17:33,430
الوُزراء يدعمون الملِكة

262
00:17:33,430 --> 00:17:35,910
ولا حتّى الملك يستطيع إلغاء القرار

263
00:17:37,290 --> 00:17:40,290
هـ-هذا هُراء

264
00:17:42,390 --> 00:17:45,540
جلالتك، يمكنك أن تنطق بالحُكم

265
00:17:49,080 --> 00:17:51,030
إذاً سوف أعلن القرار

266
00:17:51,030 --> 00:17:56,390
،الملِك مورسيلي وزانّانزا هاتّوسيلي
—أُعلن هاهنا عن تجريد

267
00:17:56,390 --> 00:17:57,930
!لـ-لحظة

268
00:17:57,930 --> 00:18:01,430
الأمير كايل قد خطّطَ لعمليّة الاختطاف
!المُزيّفة هذه برمّتها

269
00:18:01,430 --> 00:18:04,070
!أيّتها الطّفلة، كفى كلاماً فارغاً

270
00:18:04,070 --> 00:18:05,030
دعيها تتكلّم

271
00:18:07,070 --> 00:18:08,400
يمكنكِ المُتابعة

272
00:18:08,400 --> 00:18:10,260
حـ-حاضرة

273
00:18:10,260 --> 00:18:11,310
...لذا على أيّ حال

274
00:18:11,990 --> 00:18:17,410
الأمير كايل قد خطّطَ لهذه المُجازفة
بأكملها لخِداع جيش الميتانّي

275
00:18:17,410 --> 00:18:18,660
ماذا؟

276
00:18:19,010 --> 00:18:23,290
كان يعلم بأنّ أمير الظّلام سيشنّ هجوماً
،مُباغتاً على كيزّواتنا

277
00:18:23,290 --> 00:18:28,670
لذا أرسلَني والأمير زانّانزا إلى هناك
باكراً وذلك كي نتمكّن من المُقاومة

278
00:18:28,670 --> 00:18:31,670
لذا لم يكن هناك أيّ حالة اختطاف

279
00:18:31,670 --> 00:18:35,180
ولم نفعل شيئاً نتحسّر عليه

280
00:18:37,380 --> 00:18:38,750
هل تقولين الحقيقة؟

281
00:18:38,750 --> 00:18:41,390
من الواضح أنّها تكذب. لتلفيق حجّة براءة

282
00:18:41,390 --> 00:18:45,840
هل تعتقد بأنّنا كنّا لننتصر لولا
تحضيرات مُسبَقة للمعركة؟

283
00:18:45,840 --> 00:18:49,770
النّصر في كيزّواتنا يُثبت ما تقوله

284
00:18:49,770 --> 00:18:54,610
إذاً لماذا لم تُعلِنوا عن هذه المعرفة
المُسبَقة بهجوم الميتانّي؟

285
00:18:54,610 --> 00:18:58,300
لخِداع الخصم، يجب أن تخدع حليفك أوّلاً

286
00:18:58,620 --> 00:19:03,150
وفي هذه الأيّام، لا أحد يعلم
من قد يحاول الغدر بك

287
00:19:04,370 --> 00:19:07,750
هـ-هكذا إذاً. خطّة ممتازة
يا سموّ الأمير كايل

288
00:19:07,750 --> 00:19:09,660
يا له من تخطيط جريء

289
00:19:09,660 --> 00:19:13,460
كنتُ أشعر بأنّ الأمر كان أكبر من ذلك

290
00:19:13,460 --> 00:19:15,100
هكذا إذاً

291
00:19:15,100 --> 00:19:18,340
أبليتُما بلاء عظيماً يا كايل وزانّانزا

292
00:19:18,720 --> 00:19:23,490
ستُكافآن على إنجازاتكما. أتمنّى لكما التّوفيق

293
00:19:23,490 --> 00:19:24,310
شكراً

294
00:19:25,030 --> 00:19:28,120
هـ-هذا مُطمئن

295
00:19:30,190 --> 00:19:31,730
شكراً لكِ يا يوري

296
00:19:31,730 --> 00:19:34,460
أنقذتِني من جديد

297
00:19:34,460 --> 00:19:38,490
لا، يعزو الفضل للجميع لتأييدهم
روايتي المُلفَّقة

298
00:19:38,820 --> 00:19:42,520
بجدّية. ستغتنم تلك الملِكة
أي فُرصة للانقضاض علينا

299
00:19:42,520 --> 00:19:44,120
شكراً

300
00:19:47,850 --> 00:19:48,960
الأمير كايل؟

301
00:19:54,210 --> 00:19:56,580
انتظر يا سموّ الأمير كايل

302
00:19:58,270 --> 00:20:00,220
مهلاً يا سموّ الأمير كايل

303
00:20:01,150 --> 00:20:04,980
هل تعتقد بأنّ شيئاً حدث بيني
وبين الأمير زانّانزا؟

304
00:20:04,980 --> 00:20:06,660
ماذا تقصدين؟

305
00:20:06,660 --> 00:20:08,230
لقد أنقذتِني

306
00:20:08,230 --> 00:20:10,400
لا بُدّ أنّكِ مُرهَقة، لذا يمكنكِ
الخلود إلى النّوم

307
00:20:10,730 --> 00:20:13,050
إذاً لماذا لا تنظر إليّ؟

308
00:20:13,050 --> 00:20:15,440
إن كان هناك ما يدور في ذهنك، فقُله

309
00:20:15,440 --> 00:20:17,360
توقّفي أيّتها الفتاة المُتوحِّشة

310
00:20:19,860 --> 00:20:21,280
قلتُ لكِ توقّفي

311
00:20:21,280 --> 00:20:23,450
لا. دعني

312
00:20:32,230 --> 00:20:33,840
الأمير كايل؟

313
00:20:34,770 --> 00:20:36,590
يجب أن تنامي

314
00:20:37,780 --> 00:20:40,430
هذا لأنّني "مُتوحِّشة"، أليس كذلك؟

315
00:20:41,470 --> 00:20:43,810
!اذهب إلى إحدى خليلاتك فحسب

316
00:20:44,760 --> 00:20:47,120
سأنام مع هادي والتّوأمتين

317
00:20:51,440 --> 00:20:53,470
كايل أحمق

318
00:20:53,470 --> 00:20:54,800
سئمتُ منه

319
00:20:57,840 --> 00:20:59,920
ماذا كان يُفترض بي أن أفعل؟

320
00:21:00,900 --> 00:21:03,450
مصير يوري هو المُغادرة إلى موطنها

321
00:21:07,700 --> 00:21:12,160
إذا تقاربنا أكثر، فلن أتمكّن
من التخلّي عنها