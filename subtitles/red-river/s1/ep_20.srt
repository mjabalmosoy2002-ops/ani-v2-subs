1
00:00:00,390 --> 00:00:08,070
سنعدم الآن المرأة المُدانة الّتي
اغتالت الملِك أرنواندا الثّاني

2
00:00:10,570 --> 00:00:12,950
هل لديكِ أي كلمات أخيرة؟

3
00:00:13,620 --> 00:00:15,600
ليس لديّ ما أتحسّر عليه

4
00:00:16,030 --> 00:00:17,710
إذا أغمضتُ عينَي، فأستطيع الحلم

5
00:00:18,510 --> 00:00:22,710
بيوري-ساما ترتدي التّاجَ الملكيّ

6
00:00:24,470 --> 00:00:25,960
لا، لا يمكنني

7
00:00:26,260 --> 00:00:32,240
لِقاء الجريمة البغيضة وهي قتل
،الملِك أرنواندا الثّاني

8
00:00:32,240 --> 00:00:35,720
ستدفعين ثمن ذلك حياتكِ

9
00:00:35,720 --> 00:00:36,890
!اشنقها

10
00:00:49,070 --> 00:00:55,200
النّهر الأحمر

11
00:02:11,990 --> 00:02:16,990
انقسامات

12
00:02:14,130 --> 00:02:15,200
انقسامات

13
00:02:18,990 --> 00:02:22,910
أخبرني. ما الّذي تُخفيه عنّي؟

14
00:02:22,910 --> 00:02:26,880
لا أعتقد بأنّ هناك أيّ شيء. لـ-لا أعلم

15
00:02:26,880 --> 00:02:30,700
كيكّوري، هل تنوي التّظاهر بالجهل حقّاً؟

16
00:02:30,700 --> 00:02:32,220
ليس أنت فقط

17
00:02:32,220 --> 00:02:36,040
تالوس وميتّاناموا كانا يتحاشيان
النّظر في وجهي

18
00:02:37,240 --> 00:02:39,810
أخبرني ماذا حدث بالضّبط في هاتّوسا

19
00:02:40,360 --> 00:02:45,140
يوري هي أولويّتي، لكن لن أتجاهل
الشّؤون الأُخرى

20
00:02:45,140 --> 00:02:47,130
أخبرني حالاً يا كيكّوري

21
00:02:47,130 --> 00:02:49,690
...في الواقع، يؤسفني

22
00:02:50,150 --> 00:02:52,030
!الأمير! الأمير كايل

23
00:02:53,060 --> 00:02:53,740
ما الخطب؟

24
00:02:53,740 --> 00:02:55,720
جاء حصان يوري-ساما إلى هنا

25
00:02:55,720 --> 00:02:56,820
أصلان؟

26
00:02:56,820 --> 00:02:58,780
حصانها فقط؟ أين يوري؟

27
00:03:03,250 --> 00:03:05,960
ما هذا؟ ما الّذي يُزعجه؟

28
00:03:05,960 --> 00:03:10,640
ربّما يعلم أصلان أين سنجد يوري-ساما

29
00:03:11,580 --> 00:03:13,890
!فكّوا قيد الحصان. سنتبعه

30
00:03:16,170 --> 00:03:19,030
لماذا غروب الشّمس أحمر إلى هذا الحدّ؟

31
00:03:19,720 --> 00:03:21,810
يُراودني إحساس سيّئ

32
00:03:25,390 --> 00:03:30,480
ماذا؟ أنتِ كحمامةٍ صغيرة ترتعد
من غروب شمس؟

33
00:03:31,790 --> 00:03:35,610
"في موطني، هناك خُرافة تُعرَف بـ"شفق الشّياطين

34
00:03:35,960 --> 00:03:39,380
يحدث ذلك في فترة الغسق، مثل الآن

35
00:03:39,850 --> 00:03:43,540
يعتقد النّاس بأنّ أرواحاً شرّيرة تعبر
إلينا في مثل هذا الوقت

36
00:03:44,020 --> 00:03:47,500
يُقال بأنّ هذه الأرواح تضلّ البشر

37
00:03:47,860 --> 00:03:53,230
شفق الشّياطين هو عندما يضلّ النّاس؟

38
00:03:53,920 --> 00:03:55,810
يبدو هذا معقولاً بالنّسبة لي

39
00:04:03,330 --> 00:04:04,810
ما الّذي تحاول فعله؟

40
00:04:04,810 --> 00:04:07,480
أعتقد بأنّ صبري ينفد

41
00:04:21,500 --> 00:04:23,700
من أين أتت هذه الفتاة؟

42
00:04:23,700 --> 00:04:26,370
آمل أنّك لم تختطفها رغماً عن إرادتها

43
00:04:26,650 --> 00:04:29,860
لا أريد مشاكلَ مع الهيتّايتي

44
00:04:29,860 --> 00:04:33,960
سيُزعج ذلك كافّة المصريّين الّذين
يعيشون في هذه القرية

45
00:04:33,960 --> 00:04:38,820
أحضرتُ هذه المرأة كي تخدمني في مصر

46
00:04:38,820 --> 00:04:43,180
إنّها ليست للمتعة، كي يكون لديك علم

47
00:04:43,610 --> 00:04:48,660
أخبر الآخرين في القرية ألّا يؤرقوا
شهر عسلنا الشّغوف

48
00:04:52,660 --> 00:04:53,650
بئساً

49
00:04:53,990 --> 00:04:56,420
كم أنتِ عنيدة لا تستسلمين

50
00:04:56,420 --> 00:04:57,640
!أفلتني أيّها الوغد

51
00:04:57,640 --> 00:04:59,570
!أنت آخر شخص أريد أن أكون معه

52
00:04:59,860 --> 00:05:01,370
بئس الأمر

53
00:05:01,370 --> 00:05:04,330
ما الّذي يجعلني أرافق امرأة مُزعجة
مُشاغبة مثلكِ؟

54
00:05:04,330 --> 00:05:06,320
حسناً، ليس عليك القيام بهذا

55
00:05:06,320 --> 00:05:09,370
أنت حتّى لا تُحبّ الفتيات اللّواتي يُشبهنَني

56
00:05:09,370 --> 00:05:12,420
إذا أردتني من أجل طموحاتك السّياسيّة
!فقط، فلا تلمسني

57
00:05:12,420 --> 00:05:15,130
كانت تلك فكرتي في البداية

58
00:05:15,130 --> 00:05:17,880
لكن أصبحتُ مُولعاً بمُعانقتكِ

59
00:05:18,860 --> 00:05:23,400
بشرتكِ ناعمة كطفل رضع، ولا تفوح
منكِ رائحة جسد

60
00:05:23,400 --> 00:05:26,760
لهذا السّبب تنتقل إليكِ رائحة آخر
رجل تكونين معه

61
00:05:27,350 --> 00:05:30,990
عطر الأمير قد زالَ منذ زمن بعيد عنكِ

62
00:05:30,990 --> 00:05:34,020
الرّائحة الوحيدة الّتي لديكِ هي رائحتي

63
00:05:39,530 --> 00:05:41,120
الأمير كايل

64
00:05:41,770 --> 00:05:43,280
أجل، فهمت

65
00:05:43,280 --> 00:05:45,530
لا يهمّ إذا احتجتُ مُساعدة

66
00:05:45,530 --> 00:05:48,360
لا يمكنك مُغادرة هاتّوسا الآن

67
00:05:48,820 --> 00:05:53,130
هناك معركة الخِلافة خاصّتك
وإدانة أورسولا الظّالمة

68
00:05:53,130 --> 00:05:56,410
لا يمكنك حتّى ترك هاتّوسا لأجلي

69
00:05:57,920 --> 00:06:00,840
لذا لن تأتي لإنقاذي

70
00:06:00,840 --> 00:06:03,340
...تصالحتُ مع ذلك الواقع، لكن

71
00:06:03,340 --> 00:06:05,700
ثمّة شيء واحد يجدر بكِ معرفته

72
00:06:05,700 --> 00:06:09,550
كلّما قاومت المرأةُ الرّجلَ، زادت رغبتُه أكثر

73
00:06:10,520 --> 00:06:12,740
لم أعُد أُبالي

74
00:06:12,740 --> 00:06:15,560
افعل بي ما تشاء

75
00:06:16,610 --> 00:06:19,570
لكن لن تحصل على روحي أبداً

76
00:06:19,570 --> 00:06:24,490
أنتِ خير من يعلم بأنّني أستطيع
الحصول على أيّ شيء وكُلّ شيء أريده

77
00:06:27,280 --> 00:06:29,280
شفتاه لا تُحتمَلان

78
00:06:31,160 --> 00:06:33,070
وكذلك أصابعه

79
00:06:33,540 --> 00:06:36,670
ظننتُ بأنّني استسلمت، لكن جسدي
يشمئزّ من هذا

80
00:06:36,670 --> 00:06:39,040
!لـ-لا

81
00:06:39,040 --> 00:06:40,220
!لا

82
00:06:40,220 --> 00:06:42,800
!سموّ الأمير، ساعدني

83
00:06:44,550 --> 00:06:47,230
لم أكن أتوقّع وصولك يا سموّ الأمير كايل

84
00:06:47,230 --> 00:06:48,510
الأمير كايل

85
00:06:48,510 --> 00:06:50,100
أيّها الوغد

86
00:06:50,100 --> 00:06:52,810
!أشهِر سيفك. سأقتلك هنا

87
00:06:52,810 --> 00:06:57,270
أتساءل ما إن كنت وسيفك الجميل
تستطيعان إسقاطي فعلاً

88
00:07:01,280 --> 00:07:04,530
لن يستخدم يوري كدرع؟

89
00:07:06,950 --> 00:07:10,200
أختار مُقاتلتك، رجلاً لرجل

90
00:07:10,200 --> 00:07:15,080
وحياة امرأة على المحكّ هنا
في هذه المُبارزة

91
00:07:22,880 --> 00:07:25,130
إنّه سيّافٌ ماهر

92
00:07:25,550 --> 00:07:29,590
ظننتُه مُجرّد أمير مُدلَّل لم يُقاتل
في خطوط الجبهة يوماً

93
00:07:29,590 --> 00:07:30,760
لكن كنتُ مُخطئاً

94
00:07:30,760 --> 00:07:31,970
!سموّك

95
00:07:31,970 --> 00:07:33,100
!الأمير كايل

96
00:07:35,210 --> 00:07:40,980
كان ينبغي أن أفترض بأنّ الأمير هيتّايتي
لن يأتي بمُفرده

97
00:07:40,980 --> 00:07:43,570
لا أملك فُرصة ضدّ رجل مع خدمه

98
00:07:44,000 --> 00:07:47,320
لكن تذكّر بأنّني لم أخسر أمامك
في معركة عادلة

99
00:07:52,580 --> 00:07:54,410
اللّعنة. مخرج خلفيّ؟

100
00:07:54,410 --> 00:07:57,000
!كوني بخير يا يوري! سنلتقي ثانية

101
00:07:57,000 --> 00:07:57,850
!الحقا به

102
00:07:57,850 --> 00:07:58,750
!حاضر

103
00:08:00,310 --> 00:08:02,840
سموّ الأمير؟ أهذا أنت حقّاً؟

104
00:08:02,840 --> 00:08:05,280
آسف لأنّني تركتُ القلقَ يأكلكِ لأيّام عديدة

105
00:08:05,760 --> 00:08:07,050
هل تأذّيتِ؟

106
00:08:07,050 --> 00:08:08,220
سموّ الأمير

107
00:08:08,220 --> 00:08:09,940
أتى لأجلي

108
00:08:09,940 --> 00:08:12,740
كان ينبغي أن يكون مشغولاً
بحرب خِلافة العرش

109
00:08:13,430 --> 00:08:14,860
لكنّه أتى لأجلي

110
00:08:17,310 --> 00:08:19,390
سامحيني أرجوكِ

111
00:08:19,390 --> 00:08:20,540
سموّ الأمير

112
00:08:22,130 --> 00:08:23,470
لحظة، مهلاً

113
00:08:23,470 --> 00:08:25,690
...إذا كان هنا، فماذا عن

114
00:08:27,990 --> 00:08:30,140
ماذا حدث لأورسولا؟

115
00:08:30,140 --> 00:08:32,410
هل أثبتَّ بأنّها كانت بريئة؟

116
00:08:32,410 --> 00:08:34,490
أورسولا؟ بريئة؟

117
00:08:34,920 --> 00:08:37,700
!الأمير كايل! كنتُ أبحث عنك

118
00:08:38,830 --> 00:08:39,690
كاش؟

119
00:08:40,430 --> 00:08:44,220
يجب أن تأتي وتُهدّئ آلينا

120
00:08:44,220 --> 00:08:47,230
أرسلنا بالفعل جنوداً إلى أسوار المدينة

121
00:08:47,630 --> 00:08:50,050
نريدك أن تقود المعركة

122
00:08:50,050 --> 00:08:51,780
ما الّذي يجري؟

123
00:08:51,780 --> 00:08:55,890
ظننتُ بأنّنا لن نقوم بتعبئة جنود
ما لم نُعالج قضيّة الاغتيال

124
00:08:57,030 --> 00:08:59,390
أنا هنا لأُخبرك بأنّها عولِجَتْ

125
00:08:59,390 --> 00:09:00,480
ماذا؟

126
00:09:01,760 --> 00:09:05,400
كاش، هل ترتدي جديلة شعر؟

127
00:09:05,400 --> 00:09:07,420
وهي سوداء

128
00:09:07,420 --> 00:09:08,710
...لا

129
00:09:08,710 --> 00:09:11,310
يا إلهي. هل هذا شعر أورسولا؟

130
00:09:11,310 --> 00:09:12,910
ماذا حدث لأورسولا؟

131
00:09:12,910 --> 00:09:18,910
،مُقابل جريمة قتل الملِك أنواندا الثّاني

132
00:09:18,910 --> 00:09:21,640
أُعدِمَتْ أورسولا في مساء الأمس

133
00:09:26,150 --> 00:09:27,030
...لا

134
00:09:27,570 --> 00:09:29,420
أنت تمزح، أليس كذلك يا كاش؟

135
00:09:30,110 --> 00:09:31,680
أنا أقول الحقيقة

136
00:09:32,150 --> 00:09:34,040
كان إعداماً علَنيّاً

137
00:09:34,750 --> 00:09:36,430
أمام المعبد العظيم

138
00:09:37,240 --> 00:09:38,520
لكن لماذا؟

139
00:09:39,460 --> 00:09:42,020
لماذا لم تُنقذها؟ لماذا؟

140
00:09:42,340 --> 00:09:44,520
!كان بوسعك إنقاذها

141
00:09:46,520 --> 00:09:50,530
يوري-ساما، لم يكن الأمير كايل
يعلم بأمر أورسولا

142
00:09:50,990 --> 00:09:55,290
سامحنا سموّك. رمسيس قد أفلت

143
00:09:55,290 --> 00:09:57,400
نحن آسفان يا سموّ الأمير كايل

144
00:09:57,400 --> 00:09:59,160
كاش، أنت هنا؟

145
00:09:59,420 --> 00:10:02,460
أجل، أرسلنا جنوداً إلى آلينّا

146
00:10:02,460 --> 00:10:04,790
إذاً أورسولا قد ماتت؟

147
00:10:08,120 --> 00:10:09,000
أجل

148
00:10:09,650 --> 00:10:12,190
كنتما تعلمان أيضاً؟

149
00:10:14,060 --> 00:10:17,220
جميعكم كنتم تعلمون بأنّ أورسولا ستُعدَم؟

150
00:10:17,500 --> 00:10:19,320
وبقيتُم صامتين؟

151
00:10:22,720 --> 00:10:24,000
يا إلهي

152
00:10:24,510 --> 00:10:25,820
أورسولا

153
00:10:27,680 --> 00:10:30,690
إذاً هذا ما كنتُم تخفونه عنّي؟

154
00:10:31,650 --> 00:10:32,640
أجل

155
00:10:33,820 --> 00:10:37,200
هل سلّمتْ أورسولا نفسها؟

156
00:10:37,720 --> 00:10:43,710
أجل. كانت أمنيتها بأن تُصبح أنت الملِك
وبأن تصبح يوري-ساما تاوانانّا

157
00:10:52,810 --> 00:10:54,140
أورسولا

158
00:10:58,450 --> 00:11:00,260
!سنعود إلى آلينّا حالاً

159
00:11:00,260 --> 00:11:02,620
!سنُجبر قوّات الملِكة على الانسحاب

160
00:11:04,850 --> 00:11:09,310
ميتّاناموا. حالما تصل إلى آلينّا، قُد
جنودك المُشاة وهاجموا خصومنا

161
00:11:09,310 --> 00:11:10,320
!حاضر

162
00:11:10,320 --> 00:11:13,400
!كاش، حصِّن البوّابة بعرباتك

163
00:11:13,400 --> 00:11:14,400
!حاضر

164
00:11:14,870 --> 00:11:16,830
!سنزحف نحو آلينّا

165
00:11:18,450 --> 00:11:19,410
لماذا؟

166
00:11:20,360 --> 00:11:26,420
لماذا الجميع مُتلهّفين لخوض حرب بعد
إعدام أورسولا ظلماً؟

167
00:11:32,410 --> 00:11:35,220
!انتباه يا جنود الملِكة ناكيا

168
00:11:35,220 --> 00:11:37,180
أنا كايل مورسيلي

169
00:11:37,440 --> 00:11:41,560
المُجرم الّذي قتلَ الملِك قد أُعدِم

170
00:11:41,930 --> 00:11:46,440
وبالتّالي فإنّ بعثتكم للقبض على مُتَّهم
تُعَدّ ملغيّة الآن

171
00:11:46,440 --> 00:11:49,340
أيّ شخص لا يرمي سيفَه ويستسلم

172
00:11:49,340 --> 00:11:51,310
سيُعامَل كمُتمرِّد

173
00:11:52,140 --> 00:11:54,480
!إنّه الجيش النّظامي للأمير

174
00:11:54,820 --> 00:11:59,490
عاد الأمير كايل إلينا ومن خلفه جيش

175
00:11:59,490 --> 00:12:01,020
!ارموا سيوفكم

176
00:12:01,020 --> 00:12:03,200
!أولئك الّذين يستسلمون سيُعفَى عنهم

177
00:12:07,320 --> 00:12:09,780
لن يُقاتلنا أحد؟

178
00:12:09,780 --> 00:12:11,200
بالطّبع لا

179
00:12:11,200 --> 00:12:13,550
هذا الفصيل ليس ندّاً لرجالنا

180
00:12:13,550 --> 00:12:18,300
في العادة، حاشية واحدة تكون أكثر
من كافية لقمع هؤلاء الرّعاع

181
00:12:18,570 --> 00:12:21,650
إذاً لماذا تركتُم أورسولا تموت؟

182
00:12:21,650 --> 00:12:25,100
لم تكونوا بحاجة لتعامُل الأمير كايل
مع هذا، فلماذا إذاً؟

183
00:12:25,420 --> 00:12:32,150
كان لا بُدّ من وجود سموّه هنا لقمع غضب
الملِكة وتأمين العرش

184
00:12:32,150 --> 00:12:37,190
ما زلتُ لا أعي ذلك. لِمَ كان يجب
على أورسولا أن يُضحَّى بها؟

185
00:12:37,890 --> 00:12:39,280
يوري-ساما

186
00:12:39,280 --> 00:12:43,950
لم تتقبّلي هذه الحقيقة لأنّكِ ترعرعتِ
في بلد بلا حروب

187
00:12:44,390 --> 00:12:48,360
الأمير كايل هو من سُلالة نادرة في عالمنا

188
00:12:48,360 --> 00:12:51,580
نحتاجه ليحكم إمبراطوريّتنا مهما كلّف الأمر

189
00:12:51,990 --> 00:12:55,150
جميعنا تحمّلْنا المآسي لتحقيق ذلك الحلم

190
00:12:55,590 --> 00:13:00,100
...أجل، أعلم بأنّكم كذلك. أعلم ذلك، لكن

191
00:13:07,100 --> 00:13:08,860
الأمير كايل

192
00:13:08,860 --> 00:13:11,850
تلقّينا إرساليّة من هاتّوسا

193
00:13:11,850 --> 00:13:13,020
إرساليّة؟

194
00:13:13,020 --> 00:13:13,860
أجل

195
00:13:15,020 --> 00:13:19,070
أصدرت الأرملةُ الملِكة بياناً

196
00:13:20,210 --> 00:13:22,020
كيكّوري، اقرأه لنا

197
00:13:22,020 --> 00:13:23,110
سموّك

198
00:13:23,560 --> 00:13:27,560
الجنود المُرتبطين بقصري سبَّبوا"
"اضطراباً مُؤسفاً

199
00:13:27,560 --> 00:13:30,120
"في آلينّا من دون علمي"

200
00:13:30,490 --> 00:13:35,630
أعتقد بأنّ هذه الحادثة كانت بناء على توجيهات"
"كاهن من القصر، أورهي شالما

201
00:13:35,630 --> 00:13:40,620
بالتّالي، سأمتثل للعقوبة المُنزَلة على الجنود"
"المسؤولين عن هذه الفضيحة

202
00:13:40,620 --> 00:13:41,630
انتهت

203
00:13:41,630 --> 00:13:42,720
ماذا؟

204
00:13:42,720 --> 00:13:45,090
تدّعي عدم تورّطها؟

205
00:13:45,090 --> 00:13:46,530
اللّعنة على تلك الملِكة

206
00:13:46,530 --> 00:13:49,310
إنّها تُضحّي بأورهي لتنجُ بجلدها

207
00:13:49,570 --> 00:13:52,480
هل عثرنا على أورهي بين هؤلاء الجنود؟

208
00:13:52,480 --> 00:13:54,320
لا، لم نعثر

209
00:13:54,710 --> 00:13:57,730
لم نجده بين الجثث الّتي تعرّفنا عليها أيضاً

210
00:13:58,060 --> 00:14:02,050
سموّ الأمير، أُصيبَ أورهي في العين
بواسطة سهم رماه روسافا

211
00:14:02,450 --> 00:14:04,450
قد لا يكون في آلينّا بعد الآن

212
00:14:07,100 --> 00:14:08,890
!تعقّبوا أورهي

213
00:14:08,890 --> 00:14:12,070
إنّه الشّخص الوحيد الّذي يستطيع
أن يشهد على خيانة الملِكة

214
00:14:12,070 --> 00:14:13,460
!أحضروه إليّ حيّاً

215
00:14:13,460 --> 00:14:14,710
حالاً

216
00:14:15,180 --> 00:14:19,360
سموّك، يمكنك أن ترتاح هنا
ريثما تردنا أنباء

217
00:14:19,850 --> 00:14:22,090
لا بُدّ أنّ يوري-ساما مُرهَقة أيضاً

218
00:14:22,090 --> 00:14:24,430
أجل، نقبل دعوتك

219
00:14:27,270 --> 00:14:28,850
تعالي يا يوري

220
00:14:38,110 --> 00:14:38,980
يوري

221
00:14:38,980 --> 00:14:41,530
لا، لستُ بمزاج لذلك

222
00:14:41,530 --> 00:14:42,720
يوري

223
00:14:42,720 --> 00:14:46,740
هل تعلمين كم آلمَني الانفصال عنكِ؟

224
00:14:46,740 --> 00:14:49,080
أردتُ إعادتكِ بشدّة

225
00:14:49,080 --> 00:14:52,420
أردتُ أن أكون معك أيضاً يا سموّ الأمير

226
00:14:52,420 --> 00:14:53,500
...لكن

227
00:14:53,830 --> 00:14:55,170
لا تلمسني

228
00:14:55,170 --> 00:14:58,630
قايضتَ حياة أورسولا مُقابل الحقّ
في خِلافة العرش

229
00:15:00,390 --> 00:15:04,430
انظري إليّ. هل سيُرضيكِ أن أنهار
من شدّة البُكاء بدلاً من ذلك؟

230
00:15:05,120 --> 00:15:07,590
لا، هذا ليس ما أريده

231
00:15:07,890 --> 00:15:12,330
لا أتمنّى أبداً التّضحية بأحد لأجل طموحاتي

232
00:15:12,770 --> 00:15:16,210
لكن لم يكن تحقيق طموحاتي طريقاً سهلاً يوماً

233
00:15:16,210 --> 00:15:18,310
لن يكون كُلّ شيء عبارة عن ابتسامات

234
00:15:19,550 --> 00:15:23,620
حسناً، فهمت. إنّه جريح بسبب ذلك أيضاً

235
00:15:23,620 --> 00:15:28,720
يفضّل إراقة دمه على رؤية حُلفائه يعانون

236
00:15:29,390 --> 00:15:30,860
...أفهم كُلّ ذلك، لكن

237
00:15:32,060 --> 00:15:34,580
قبل وفاة الملك، أخبرني بشيء

238
00:15:34,990 --> 00:15:38,000
أن أكون عقيلتك يعني الكثير من العقبات

239
00:15:38,400 --> 00:15:41,500
إنّها ليست مهمّة يسيرة تستطيع
أي امرأة تحمّلها

240
00:15:45,990 --> 00:15:47,790
كان على حقّ تماماً

241
00:15:48,390 --> 00:15:50,480
لا أستطيع تحمُّل هذا

242
00:15:50,930 --> 00:15:55,390
مُحال أن أتقبّل التكتُّم على موت أورسولا

243
00:15:56,110 --> 00:15:58,690
كنتُ في هذا العصر لقرابة عامين

244
00:15:59,580 --> 00:16:02,950
حاولتُ التكيُّف معه. لكن ليس بعد الآن

245
00:16:03,930 --> 00:16:06,490
لا أستطيع تحمّله

246
00:16:06,900 --> 00:16:11,370
أُحبّك حُبّاً جمّاً، لكن لا أستطيع
!فعل هذا معك

247
00:16:16,740 --> 00:16:18,580
!لا! توقّف

248
00:16:18,930 --> 00:16:20,510
المعذرة

249
00:16:20,510 --> 00:16:23,500
سموّك، حدّدنا موقع أورهي

250
00:16:23,500 --> 00:16:25,710
بإذنك، مُرنا بالمُطاردة

251
00:16:32,010 --> 00:16:34,390
!يوري! يجب ألّا تذهبي بمفردكِ

252
00:16:34,720 --> 00:16:35,840
أورهي

253
00:16:35,840 --> 00:16:37,640
لن تفلت هذه المرّة

254
00:16:37,990 --> 00:16:42,180
سنُعيدك إلى هاتّوسا ونجعلك
،تفضح جرائم الملِكة

255
00:16:42,180 --> 00:16:46,150
وستُخبر الجميع بأنّ أورسولا لم تستحقّ الموت

256
00:16:47,930 --> 00:16:48,970
!روسافا

257
00:16:49,620 --> 00:16:50,910
يوري-ساما

258
00:16:51,870 --> 00:16:53,310
أين أورهي؟

259
00:16:53,780 --> 00:16:55,410
فوق تلك الجروف الصّخريّة

260
00:16:56,180 --> 00:16:59,860
حاصرناه كُلّياً. لا يستطيع الهرب

261
00:16:59,860 --> 00:17:02,810
نريد أن نقبض عليه حالما يحضر سموُّه

262
00:17:03,640 --> 00:17:06,490
يبدو أنّ أورهي سعى للهرب إلى بلدان أُخرى

263
00:17:06,490 --> 00:17:09,000
رصدناه عند النّهر

264
00:17:09,000 --> 00:17:10,670
النّهر الأحمر؟

265
00:17:10,670 --> 00:17:12,930
ماذا لو تمكّنَ من السّباحة وعبوره؟

266
00:17:12,930 --> 00:17:14,350
كُلّ شيء على ما يُرام

267
00:17:14,350 --> 00:17:17,920
هذا القسم مليء بمُنحدرات نهريّة
يستحيل عبورها

268
00:17:18,360 --> 00:17:20,730
لا أحد يستطيع النّجاة من التيّارات

269
00:17:21,500 --> 00:17:23,790
أحسنتَ صنعاً يا روسافا

270
00:17:23,790 --> 00:17:25,070
سأصعد إلى هناك

271
00:17:25,540 --> 00:17:27,570
ابقَ هنا رجاء، سموّك

272
00:17:27,570 --> 00:17:29,860
سنقبض على أورهي لأجلك

273
00:17:29,860 --> 00:17:34,410
لا، سأحسم النّتيجة. سيحرس بقيّتكم المُحيط

274
00:17:34,410 --> 00:17:36,530
سموّ الأمير، سآتي أيضاً

275
00:17:42,720 --> 00:17:44,500
انتبهي على نفسكِ هنا يا يوري

276
00:17:45,140 --> 00:17:46,080
حسناً

277
00:17:54,890 --> 00:17:57,160
هل أنتِ بخير؟ هل من جروح؟

278
00:17:57,160 --> 00:17:59,240
لا، أنا بخير

279
00:17:59,240 --> 00:18:04,210
وليّ العهد، شرف لي أن أرحّب بك شخصيّاً

280
00:18:11,750 --> 00:18:12,780
!أورهي

281
00:18:12,780 --> 00:18:15,470
وأحضرتَ عشتار معك

282
00:18:15,470 --> 00:18:19,190
لا أصدّق بأنّك تُكافئني بهذه الطّريقة

283
00:18:21,050 --> 00:18:23,510
نحن نُكافئك بالفعل

284
00:18:23,950 --> 00:18:26,050
كمُعترِف رئيسيّ بالجرائم

285
00:18:32,420 --> 00:18:35,740
أورهي، لا مفرّ لك

286
00:18:35,740 --> 00:18:37,800
تخلّت عنك الملِكة

287
00:18:38,160 --> 00:18:41,310
!ولاؤك لن يُكافَأ. استسلم حالاً

288
00:18:41,310 --> 00:18:44,690
!هيّا يا أورهي! افعل ما يقوله فحسب

289
00:18:44,690 --> 00:18:50,280
!أخبر الوُزراء بأنّ الملِكةُ أمرتْ باغتيال الملِك

290
00:18:50,280 --> 00:18:54,030
!إن فعلت ذلك، فسيعفو الأمير عنك

291
00:18:54,030 --> 00:18:55,270
!أورهي

292
00:18:58,530 --> 00:19:00,180
لا تفعل. ستموت

293
00:19:06,290 --> 00:19:07,830
اقتلني

294
00:19:07,830 --> 00:19:10,300
أفضّل الموت على اعتقالي

295
00:19:10,790 --> 00:19:12,240
حسناً

296
00:19:12,240 --> 00:19:16,050
إن لم أستطع إقناعك، فسآخذك
إلى هاتّوسا بالقوّة

297
00:19:31,110 --> 00:19:33,320
إنّه يتراجع نحو النّهر؟

298
00:19:39,030 --> 00:19:39,950
!لا تفعل

299
00:19:39,950 --> 00:19:41,950
!عُد يا أورهي

300
00:19:41,950 --> 00:19:43,120
!لا تفعلي يا يوري

301
00:19:43,600 --> 00:19:44,740
!يوري

302
00:19:49,760 --> 00:19:51,130
لماذا؟

303
00:19:52,040 --> 00:19:55,510
ما الّذي يجعله يفعل المُستحيل لحماية الملِكة؟

304
00:19:56,130 --> 00:19:58,590
!أورهي

305
00:19:58,880 --> 00:19:59,780
!سموّك

306
00:19:59,780 --> 00:20:00,850
!يوري-ساما

307
00:20:01,360 --> 00:20:02,850
ما حدث قد حدث

308
00:20:02,850 --> 00:20:05,640
،نحن في أسوأ وضع من دون شهادة أورهي

309
00:20:05,640 --> 00:20:08,170
لكن ما زال بإمكاننا إلقاء اللّوم على الملِكة

310
00:20:08,170 --> 00:20:10,730
كُلّ ما نحتاجه هو فضح الملِكة

311
00:20:10,730 --> 00:20:13,590
لا، لا يمكننا ترك الأمر هكذا

312
00:20:13,590 --> 00:20:15,710
الأمر لا يتعلّق بالملِكة فقط

313
00:20:15,710 --> 00:20:18,660
هل يُفترض بنا نسيان أورسولا؟

314
00:20:18,660 --> 00:20:19,660
يوري-ساما

315
00:20:21,070 --> 00:20:26,290
كلامكِ وشغفكِ هو ما يجعل النّاس يحبّوكِ

316
00:20:26,290 --> 00:20:29,810
كانت أورسولا تعلم بأنّكِ ستبكين
،لأجل خادمة

317
00:20:29,810 --> 00:20:32,110
لهذا السّبب ضحّتْ بنفسها

318
00:20:32,670 --> 00:20:37,670
ماتت راضيةً وهي تعلم بأنّ قرارها
كان يصبّ في مصلحة أعظم

319
00:20:38,540 --> 00:20:43,930
أعلم ضمنيّاً بأنّ أورسولا ما كانت لترغب
في رؤيتكِ تتألّمين بموتها

320
00:20:49,880 --> 00:20:51,080
أحقّاً ذلك؟

321
00:20:51,720 --> 00:20:54,360
هل كانت أورسولا مُتقبِّلة لهذا حقّاً؟

322
00:20:55,690 --> 00:21:00,630
حتّى لو كانت كذلك، لا أستطيع تقبُّل موتها

323
00:22:44,930 --> 00:22:49,930
قرار المُغادرة