1
00:00:02,100 --> 00:00:03,880
،هذه هاتّوسا

2
00:00:04,370 --> 00:00:08,900
عاصمة إمبراطوريّة هيتّيتي في القرن
الرّابع عشر قبل الميلاد

3
00:00:10,590 --> 00:00:16,080
هذه قصّة فتاة تركب الرّياح الحارّة الرّطبة

4
00:00:16,650 --> 00:00:18,840
عبر مسافات الأناضول الواسعة

5
00:00:27,350 --> 00:00:31,240
تهبُّ رياحٌ عاتية، لتحمل معها الرّمال الجافّة

6
00:00:33,220 --> 00:00:34,970
،تهبُّ الرّياح ساخنة

7
00:00:35,730 --> 00:00:37,760
،وأنا أعيش تحت هذه السّماء

8
00:00:38,400 --> 00:00:40,960
على ضفاف النّهر الأحمر

9
00:02:07,250 --> 00:02:09,630
لا أستطيع العودة، لن أعود

10
00:02:12,820 --> 00:02:14,240
!افتحوا هذا الباب

11
00:02:14,240 --> 00:02:16,240
!جاء زُوّار لملكتكم

12
00:02:18,090 --> 00:02:21,100
من يُنادي في ساعة مُتأخّرة كهذه؟

13
00:02:22,120 --> 00:02:23,640
!سموّ الأمير كايل

14
00:02:24,240 --> 00:02:27,750
أريد رؤية فخامتها فيما يخصّ
مسألة عاجلة

15
00:02:27,750 --> 00:02:29,630
!بـ-بكلّ تأكيد! حالاً

16
00:02:36,070 --> 00:02:38,140
الأمير كايل دون سِواه

17
00:02:38,140 --> 00:02:42,560
ألم تحترم فترة الرّاحة المسائيّة
الخاصّة بملكتك؟

18
00:02:42,560 --> 00:02:46,170
—لم تكوني نائمة! كنتِ تحاولين أن

19
00:02:46,170 --> 00:02:48,860
أعتذر عن وقاحتي

20
00:02:49,520 --> 00:02:54,490
لكن يبدو أنّ أحد خدَمي قد أتوا
إلى هذا القصر بالخطأ

21
00:02:54,780 --> 00:02:56,000
خدَم؟

22
00:02:56,410 --> 00:02:59,410
ولو سألتني، لا أعلم شيئاً عن ذلك

23
00:02:59,410 --> 00:03:00,620
كاذبة

24
00:03:00,620 --> 00:03:04,820
!كان الفتى الّذي أنقذني من القتل بواسطتكِ

25
00:03:04,820 --> 00:03:08,780
ماذا؟ أتفترين على ملكتكِ بهذا الشّكل؟

26
00:03:08,780 --> 00:03:14,540
الحِفاظ على هذه الحمقاء كعقيلة لك
سوف يُلطّخ شرفك أيّها الأمير كايل

27
00:03:14,540 --> 00:03:16,010
!أعيدي تيتو إلينا

28
00:03:16,260 --> 00:03:19,710
.ربّما كنتِ تحلمين يا طفلة
اغربي عن وجهي

29
00:03:19,710 --> 00:03:20,600
!انتظري

30
00:03:20,600 --> 00:03:24,450
فخامتكِ، أطلب منكِ تفتيش هذه المباني

31
00:03:24,450 --> 00:03:27,850
أريد الحرص على ألّا يكون خادمي
قد تسلّلَ إلى داخل قصركِ

32
00:03:28,550 --> 00:03:30,650
طلبك مرفوض

33
00:03:30,650 --> 00:03:33,030
والآن انصرف أيُّها الأمير كايل

34
00:03:33,030 --> 00:03:34,400
لكنّني مُصرّ

35
00:03:34,400 --> 00:03:37,700
هل نسيت؟ أنا الملِكة

36
00:03:37,700 --> 00:03:40,200
أنا تاوانانّا الخاصّة بكلّ ما تراه

37
00:03:40,200 --> 00:03:42,790
لا أحد يأمرني سوى الإمبراطور

38
00:03:42,790 --> 00:03:43,960
انصرفا

39
00:03:45,790 --> 00:03:47,290
تاوانانّا"؟"

40
00:03:47,710 --> 00:03:50,380
ماذا يعني "تاوانانّا"؟

41
00:03:50,380 --> 00:03:53,790
إنّه اللّقب الّذي يُمنَح لأبرز
امرأة في الإمبراطوريّة

42
00:03:53,790 --> 00:03:57,740
،هذا يعني بأنّنا إذا أردنا التصرُّف
فإنّنا نحتاج أبي. هيّا بنا

43
00:04:01,660 --> 00:04:05,100
طلبتُ من بوّاب بأن يُخبر أبي بأنّني
أريد التكلُّم معه

44
00:04:05,100 --> 00:04:07,740
قد لا يُوافق في مثل هذه
،السّاعة المُتأخِّرة

45
00:04:07,740 --> 00:04:10,980
لكن سنُقنعه بمُرافقتنا إلى قصر الملِكة

46
00:04:10,980 --> 00:04:14,340
الوقت يُداهمنا. اسحبه من السّرير فحسب

47
00:04:14,340 --> 00:04:15,390
سموّك؟

48
00:04:17,090 --> 00:04:19,180
ما سبب هذه الفوضى؟

49
00:04:19,940 --> 00:04:22,420
لم تلتقي بهذا الرّجل بعد يا يوري

50
00:04:22,420 --> 00:04:25,580
...هذا إيلباني، مُشرف هذا القصر

51
00:04:25,580 --> 00:04:27,070
وأخي بالتبنّي

52
00:04:27,660 --> 00:04:31,880
سموّك، لدينا كُلّ شيء لإعادة
يوري-ساما، صحيح؟

53
00:04:34,220 --> 00:04:38,700
دعنا نتجاهل الخادم ونُعيدها حالاً

54
00:04:38,700 --> 00:04:39,590
ماذا؟

55
00:04:39,980 --> 00:04:42,340
لن أعود إلى الدّيار بينما تيتو مفقود

56
00:04:42,650 --> 00:04:45,350
تيتو قد قُتِل على الأغلب

57
00:04:45,350 --> 00:04:49,250
تخلّي عنه. استعدّي للعودة

58
00:04:49,250 --> 00:04:51,270
ما الّذي يجعلك تقول ذلك؟

59
00:04:51,710 --> 00:04:55,520
أعتقد بأنّ الملِكة تُوظِّف كاشوغا
يُدعى زووا

60
00:04:56,310 --> 00:05:00,070
إنّه زعيم البربريّين في الشّمال

61
00:05:00,070 --> 00:05:07,620
إنّه مشهور بُحبّه للملابس المُبهرَجة
وجمع جلود أولئك الّذين يقتلهم

62
00:05:07,900 --> 00:05:12,220
يُشاع بأنّه ميّال بالتّحديد للبشرة
النّاعمة لصغار السنّ

63
00:05:12,220 --> 00:05:14,360
لذا لا أظنّه سيتخلّى عن تيتو

64
00:05:14,360 --> 00:05:16,590
!هذا يعني بأنّه لا يوجد وقت حرفيّاً

65
00:05:16,590 --> 00:05:17,420
!يوري

66
00:05:17,420 --> 00:05:18,420
!دعني

67
00:05:18,760 --> 00:05:20,840
!لا يمكنني التخلّي عنه

68
00:05:20,840 --> 00:05:21,590
!اهدئي

69
00:05:34,710 --> 00:05:36,050
هل هدأتِ الآن؟

70
00:05:37,110 --> 00:05:40,110
لم أتخلَّ عن تيتو

71
00:05:40,810 --> 00:05:45,100
كلّ الحيوات مُقدّسة، مهما كانت
مكانة الشّخص

72
00:05:45,630 --> 00:05:49,370
نسيان ذلك سيجعلني مثل سوء الملِكة

73
00:05:49,910 --> 00:05:51,360
سموّ الأمير

74
00:05:51,360 --> 00:05:54,680
سنفعل المُستحيل لاستعادة تيتو

75
00:05:55,270 --> 00:05:56,750
هل تفهم يا إيل؟

76
00:05:59,120 --> 00:06:01,720
أسحب ما قلتُه

77
00:06:05,660 --> 00:06:09,280
هل أبي غير موجود؟ سأضغط
—على البوّابين ثانية

78
00:06:10,100 --> 00:06:12,080
أستميحك عذراً، سموّك

79
00:06:12,080 --> 00:06:12,850
ما الأمر؟

80
00:06:13,590 --> 00:06:17,510
عثرنا على جثّة طفل خارج
السّور الشّرقيّ

81
00:06:29,820 --> 00:06:32,410
يُنصح بعدم رؤية الباقي

82
00:06:33,060 --> 00:06:36,500
الطّفل مسلوخ الجلد من العنق إلى أسفل

83
00:06:39,420 --> 00:06:42,570
تيتو

84
00:06:43,890 --> 00:06:48,510
أوّل مرّة ابتسمتُ فيها في هذا الواقع
الجديد كانت عندما التقيتُ بك

85
00:06:48,510 --> 00:06:50,010
يوري-ساما

86
00:06:50,290 --> 00:06:54,020
أنا مُمتنّ لكِ لإنقاذي من الإعدام

87
00:06:54,020 --> 00:06:57,400
كنتُ سعيداً جدّاً لأنّكِ فعلتِ ذلك لأجلي

88
00:06:58,090 --> 00:06:59,400
يوري-ساما

89
00:06:59,780 --> 00:07:01,020
كوني بخير

90
00:07:02,510 --> 00:07:04,440
أنا من ينبغي أن أشكرك

91
00:07:06,790 --> 00:07:07,840
تيتو

92
00:07:09,180 --> 00:07:11,600
مهما قلتُ من كلام فهو لا يكفي
للاعتذار منك

93
00:07:11,600 --> 00:07:13,090
هذه غلطتي

94
00:07:13,090 --> 00:07:15,590
كنتُ أنا من قتلك

95
00:07:37,480 --> 00:07:38,670
ألن تأكلي؟

96
00:07:39,620 --> 00:07:42,410
لم تأكلي شيئاً منذ الصّباح

97
00:07:42,830 --> 00:07:43,950
لا أريد شيئاً

98
00:07:46,080 --> 00:07:47,950
كلّ هذه غلطتي

99
00:07:47,950 --> 00:07:51,700
أخبرني أرجوك. ماذا يُفترض بي أن أفعل؟

100
00:07:59,750 --> 00:08:02,000
سـ-سموّ الأمير؟

101
00:08:02,290 --> 00:08:03,160
لا تبكي

102
00:08:03,640 --> 00:08:05,460
،لا أستطيع شرح السّبب كما ينبغي

103
00:08:06,160 --> 00:08:08,560
لكن لا أريد أن أرى دموعكِ

104
00:08:16,390 --> 00:08:18,030
المعذرة على المُقاطعة

105
00:08:18,770 --> 00:08:21,640
سموّك، يجب علينا أن نُسرع

106
00:08:22,410 --> 00:08:23,520
ما السّبب؟

107
00:08:23,520 --> 00:08:27,510
أنسيت؟ يجب علينا التّحضير لإعادة
يوري-ساما إلى ديارها

108
00:08:28,720 --> 00:08:33,750
الفجر التّالي هو آخر مرّة يرتقي فيها
نجم الصّباح أثناء موسم الأمطار

109
00:08:34,350 --> 00:08:36,910
سيترتّب علينا انتظار فُرصة أُخرى عاماً كاملاً

110
00:08:37,370 --> 00:08:39,920
سنُعيد يوري؟

111
00:08:39,920 --> 00:08:43,160
سأتمكّن من العودة إلى الدّيار غداً؟

112
00:08:47,680 --> 00:08:49,550
أنا مُستعدّ للطّقوس بشكل كامل

113
00:08:49,840 --> 00:08:51,800
يمكننا البدء في أيّ وقت

114
00:08:51,800 --> 00:08:53,740
أجل. أنا جاهزة أيضاً

115
00:08:54,300 --> 00:08:57,220
سأتمكّن من رؤية عائلتي ثانية أخيراً

116
00:08:57,220 --> 00:09:00,880
فلماذا لستُ سعيدة؟

117
00:09:01,690 --> 00:09:05,440
ستعودين إلى الدّيار أخيراً يا يوري-ساما

118
00:09:06,080 --> 00:09:07,560
سأفتقدكِ

119
00:09:08,890 --> 00:09:11,730
قال  تيتو بأنّه أرادني أن أبقى معه هنا

120
00:09:12,320 --> 00:09:15,240
...لكن حتّى لو بقيتُ هنا

121
00:09:15,900 --> 00:09:18,470
،لن أنسى تيتو أبداً

122
00:09:18,470 --> 00:09:21,330
لكن لا يسعني فعل شيء لأجله الآن

123
00:09:21,330 --> 00:09:24,000
!سأعود! سأعود إلى المنزل

124
00:09:24,000 --> 00:09:26,460
!سأعود إلى عائلتي

125
00:09:35,790 --> 00:09:40,350
سموّك، هل تنوي حقّاً إرسال
يوري-ساما بعيداً؟

126
00:09:40,740 --> 00:09:42,350
لِمَ السّؤال ثانية؟

127
00:09:42,350 --> 00:09:49,860
كنتُ خائفاً من أن تنسى سبب رفضك
لكُلّ عروض الزّواج حتّى تاريخه

128
00:09:50,520 --> 00:09:52,440
لم أنسَ

129
00:09:52,440 --> 00:09:56,370
أصبحت يوري محظيّتي بمحض الصّدفة

130
00:09:57,810 --> 00:09:58,680
...لكن

131
00:10:00,870 --> 00:10:04,250
لا يهمّ. سنُعيد يوري

132
00:10:04,610 --> 00:10:08,380
حتّى لو بقيتْن ليس عليكم
القلق حيال شيء

133
00:10:08,990 --> 00:10:11,090
!في الواقع، أُحبّ هيمورو

134
00:10:11,090 --> 00:10:12,970
!لا أطيقك

135
00:10:18,850 --> 00:10:22,820
هذا آخر نجم صباح للعام: عشتار

136
00:10:23,350 --> 00:10:27,730
يبدأ موسم الجفاف غداً، لذا
لن تمتلئ الينابيع قبل العام المُقبل

137
00:10:29,440 --> 00:10:30,650
!الأمير كايل

138
00:10:31,290 --> 00:10:35,150
وضعنا أفضل حُرّاسنا في كافّة الينابيع السّبعة

139
00:10:35,150 --> 00:10:36,080
جيّد

140
00:10:37,020 --> 00:10:42,090
يوري، ستدخلين النّبع وتعودين
من حيث أتيتِ

141
00:10:47,080 --> 00:10:49,420
آمل ألّا تتدخّل الملكةُ ثانية

142
00:10:49,420 --> 00:10:51,510
أتوقّع منها أن تُحاول

143
00:10:51,510 --> 00:10:54,470
لكن أنا ساحرٌ قويّ مثلها

144
00:10:54,900 --> 00:10:57,700
أستطيع ردّ كافّة خِداعها، لذا لا تخافي

145
00:10:57,700 --> 00:10:58,810
حسناً

146
00:11:14,360 --> 00:11:15,610
!لا أحد يتحرّك

147
00:11:33,710 --> 00:11:36,940
الرّياح هدّأت الماء؟

148
00:11:39,450 --> 00:11:40,210
!يوري

149
00:11:40,880 --> 00:11:42,530
ادخلي النّبع

150
00:11:43,290 --> 00:11:45,970
،يا إله وسيّد الزّمان والمكان

151
00:11:45,970 --> 00:11:49,600
!أعِد هذه العذراء إلى مكانها السّابق

152
00:12:00,280 --> 00:12:01,830
...هذا السّوار

153
00:12:01,830 --> 00:12:03,040
زووا؟

154
00:12:06,790 --> 00:12:08,560
!قُطّاع طُرُق كاشوغا

155
00:12:08,560 --> 00:12:10,420
!احموا الأمير كايل والآخرين

156
00:12:12,720 --> 00:12:14,550
يوري، ادخلي النّبع

157
00:12:14,870 --> 00:12:16,690
ثمّ أستطيع ترتيل التّعويذة

158
00:12:17,010 --> 00:12:18,130
!يوري

159
00:12:20,510 --> 00:12:24,850
ذلك السِّوار هو الطّوق الّذي
حصل عليه تيتو من أخواته

160
00:12:25,970 --> 00:12:28,600
وذلك الشّيء على رأسه... يا إلهي

161
00:12:29,660 --> 00:12:32,960
يوري-ساما

162
00:12:34,780 --> 00:12:35,870
تيتو

163
00:12:36,730 --> 00:12:39,200
!يوري! بسرعة! قبل أن يبزغ الفجر

164
00:12:40,460 --> 00:12:42,070
كيف أمكنك؟

165
00:12:43,160 --> 00:12:44,280
!يوري

166
00:12:45,220 --> 00:12:48,210
أستطيع قطع رأسكِ بيد واحدة
مغلولة خلف ظهري

167
00:12:54,880 --> 00:12:56,130
!أيّتها السّاقطة

168
00:13:09,150 --> 00:13:10,560
!طلع الفجر

169
00:13:10,560 --> 00:13:13,940
!انتهى عملنا هنا. لنذهب

170
00:13:16,190 --> 00:13:17,210
لكن لماذا؟

171
00:13:18,610 --> 00:13:21,910
لديّ عمل غير مُنتهٍ هنا

172
00:13:22,990 --> 00:13:24,080
...أنا

173
00:13:24,820 --> 00:13:27,540
!لا أستطيع ترك قتَلة تيتو أحراراً

174
00:13:28,450 --> 00:13:31,430
لن أعود إلى الدّيار ما لم أثأر لتيتو

175
00:13:34,400 --> 00:13:35,450
يوري

176
00:13:43,500 --> 00:13:45,630
أبليتَ بلاء جيّداً يا زووا

177
00:13:45,630 --> 00:13:48,180
كلّ ما احتجناه كان هو أن تبقى

178
00:13:50,910 --> 00:13:54,100
يمكننا أن نستغرق وقتنا الآن
في القبض عليها

179
00:13:54,100 --> 00:13:57,950
هذه المرّة، سنحرص على ألّا
يعترض كايل طريقنا

180
00:14:03,570 --> 00:14:05,620
يجب أن أثأر لتيتو

181
00:14:06,220 --> 00:14:11,440
لكن رغم ذلك، لا يمكنني فعل شيء
من دون الأمير كايل

182
00:14:14,460 --> 00:14:17,460
ماذا؟ الكاشوغا هاجموا آلينا؟

183
00:14:17,460 --> 00:14:20,420
أجل. تلقّينا نبأ بذلك للتو

184
00:14:20,780 --> 00:14:22,100
ما هي آلينا؟

185
00:14:22,100 --> 00:14:23,620
مدينة مُحصَّنة

186
00:14:23,620 --> 00:14:25,930
يقع معبدٌ هامّ هناك

187
00:14:25,930 --> 00:14:29,390
لكن سحَقْنا الكاشوغا في معركة
في العام الماضي

188
00:14:29,390 --> 00:14:33,210
لا ينبغي أن تكون لديهم القوّات
الكافية لاجتياح آلينا

189
00:14:33,210 --> 00:14:34,640
إنّهم ليسوا كذلك

190
00:14:34,930 --> 00:14:38,150
هذا يُشير إلى أنّ لديهم داعم قويّ

191
00:14:38,150 --> 00:14:39,520
لكن من؟

192
00:14:43,200 --> 00:14:44,480
لديّ فكرة

193
00:14:45,100 --> 00:14:47,940
لا تتكلّمي يا يوري. لا نملك دليلاً

194
00:14:47,940 --> 00:14:51,780
على أيّ حال، أمرَني الملكُ بردِّ الهجوم

195
00:14:52,820 --> 00:14:54,540
سأغادر هاتّوسا قريباً

196
00:14:55,430 --> 00:14:57,460
ماذا يُفترض بي أن أفعل؟

197
00:14:59,710 --> 00:15:03,090
بالطّبع، ستنتظرين هنا يا يوري-ساما

198
00:15:03,090 --> 00:15:06,340
ساحة المعركة ليست مكاناً للنّساء

199
00:15:07,970 --> 00:15:10,960
لا بُدّ أنّ الملِكة قد خطّطتْ هذا

200
00:15:11,370 --> 00:15:13,850
تحاول إبعاد كايل عنّي

201
00:15:13,850 --> 00:15:16,520
كيكّوري، سنستعدّ للحرب

202
00:15:16,520 --> 00:15:17,270
حاضر

203
00:15:21,760 --> 00:15:27,070
يُراودني شعور بأنّك لا تريدني
هنا. ما السّبب؟

204
00:15:28,910 --> 00:15:33,100
أقسمَ الأمير سابقاً بألّا يتّخذ محظيّة

205
00:15:33,100 --> 00:15:35,580
وافقتُه على هذا القرار

206
00:15:37,220 --> 00:15:42,500
إن نويتِ البقاء، فينبغي
أن يتمّ إبلاغكِ

207
00:15:42,800 --> 00:15:47,260
الأمير كايل هو شخص بارز سيمتثل
في النّهاية للمنصب الأعلى

208
00:15:47,260 --> 00:15:49,260
يمتثل؟

209
00:15:49,260 --> 00:15:52,890
تقصد بأنّه سيصبح الملك؟
ظننتُه الثّالث في خطّ الخِلافة

210
00:15:52,890 --> 00:15:57,900
وليّ العهد، أرنوواندا، لديه بُنية ضعيفة

211
00:15:57,900 --> 00:16:01,320
لم ينجب أطفالاً ولا يُؤمَل منه ذلك

212
00:16:01,790 --> 00:16:06,390
والأمير الثّاني، تيليبينو، لديه
أمّ ذات نسب مُتواضع

213
00:16:06,390 --> 00:16:08,390
لذا سوف يُحرَم من العرش

214
00:16:08,790 --> 00:16:11,900
لكن وُلِدَ الأمير كايل
،من رحمِ الملِكة السّابقة

215
00:16:11,900 --> 00:16:14,170
وهو سليم عقليّاً وجسديّاً

216
00:16:14,170 --> 00:16:18,420
لديه كلّ الصِّفات لتبوُّء العرش
أكثر من أيّ شخص آخر

217
00:16:18,710 --> 00:16:23,840
الجميع باستثناء الملكة الحاليّة
قبِلوا ضمنيّاً صحّة ذلك

218
00:16:24,320 --> 00:16:28,680
لـ-لكن ما علاقتي أنا بكونه سيصبح الملِك؟

219
00:16:28,990 --> 00:16:33,880
إذا أصبح الأميرُ ملِكاً، فإنّ عقيلته
الملكيّة ستُصبح التاوانانّا

220
00:16:34,990 --> 00:16:40,180
يجب أن تمتلك التّوانانّا الأهليّة
والشّخصيّة اللّازمة

221
00:16:40,180 --> 00:16:43,270
ويمكنكِ أن تري كيف أنّ الملِكة
ناكيا تمتلك تلك المُتطلّبات

222
00:16:43,960 --> 00:16:46,990
:أخبرني الأمير ذات مرّة بالتّالي

223
00:16:46,990 --> 00:16:49,800
"ذات يوم، سأحكم كملِك"

224
00:16:49,800 --> 00:16:55,040
لذلك، سأكون حريصاً حيال
خياري النّهائيّ للعروس

225
00:16:55,580 --> 00:16:58,400
يجب أن تتمتّع بالموهبة والحرص

226
00:16:58,400 --> 00:17:01,310
والحضور الذّهنيّ وصِفات
أُخرى مطلوبة للقيادة

227
00:17:01,980 --> 00:17:04,960
بالمُقابل، لن أتّخذ أي امرأة أُخرى

228
00:17:05,580 --> 00:17:09,030
لن أُحبّ سوى زوجتي ما دمتُ حيّاً

229
00:17:11,670 --> 00:17:17,180
كان الأمير يبحث عن المرأة الأنسب
...منذ ذلك الحين. ومع ذلك هو

230
00:17:17,180 --> 00:17:20,540
لا تقلق. لم ينسَ أميرُك شيئاً

231
00:17:22,430 --> 00:17:27,160
.أنا محظيّته للاستعراض فقط
لا أكثر ولا أقلّ

232
00:17:27,790 --> 00:17:31,070
فلماذا أشعر بالاستياء وأنا أعلم ذلك؟

233
00:17:36,100 --> 00:17:40,580
يُجبَر كايل على مُغادرة هاتّوسا
بأمر من الملِك

234
00:17:40,830 --> 00:17:43,680
مع رحيل كايل، تُصبح تلك العذراء مُلكنا

235
00:17:43,680 --> 00:17:45,590
نبأ يا فخامة الملك ناكيا

236
00:17:46,190 --> 00:17:50,470
قد يكون الأمير كايل فطِناً بما يكفي
لأخذ العذراء معه

237
00:17:50,470 --> 00:17:52,180
إلى ساحة معركة؟

238
00:17:53,040 --> 00:17:54,800
إن كان كذلك، فليكُن إذاً

239
00:17:57,750 --> 00:17:59,430
...تعرف ما يجب فعله

240
00:17:59,850 --> 00:18:01,190
يا أورهي

241
00:18:04,300 --> 00:18:06,190
كايل مورسيلي

242
00:18:06,500 --> 00:18:09,440
أمنحك السّلطة الكاملة للتصرُّف
كوكيل عنّي

243
00:18:09,440 --> 00:18:12,640
اذهب وادحر الكاشوغا

244
00:18:12,640 --> 00:18:13,450
حاضر

245
00:18:17,960 --> 00:18:22,580
،إلهنا، تيشوب، في العلالي
يمنح النّصر لهيتّيتيس

246
00:18:23,550 --> 00:18:25,080
سنزحف إلى ساحة المعركة

247
00:18:27,590 --> 00:18:31,410
إلى متى سيغيب يا تُرى؟

248
00:18:31,410 --> 00:18:35,840
لا، لا يمكنني الاستمرار في إزعاجه بمشاكلي

249
00:18:36,450 --> 00:18:41,070
يجب أن أقول وداعاً له
وأتمنّى له التّوفيق

250
00:18:43,600 --> 00:18:45,300
المعذرة

251
00:18:47,370 --> 00:18:50,070
...سموّ الأمير كايل، في الواقع

252
00:18:50,510 --> 00:18:51,320
يوري

253
00:18:54,710 --> 00:18:57,160
هل أنتِ مُستعدّة لمُواجهة الحرب؟

254
00:18:59,550 --> 00:19:02,910
ابقي معي. أُقسِم بأن أحميكِ

255
00:19:04,550 --> 00:19:08,250
إن كنتِ تثقين بي، فتعالي إذاً يا يوري

256
00:19:08,250 --> 00:19:09,460
!سموّك

257
00:19:09,460 --> 00:19:11,200
سموّ الأمير كايل

258
00:19:30,120 --> 00:19:34,070
كايل، أتتنازل وتأخذ امرأة
إلى المعركة معك؟

259
00:19:38,070 --> 00:19:39,910
!اسمعوني أيّتها الحاشية

260
00:19:39,910 --> 00:19:45,580
ظهرتْ هذه العذراء من نبعٍ عندما
كانت عشتار تلمع في السّماء

261
00:19:45,580 --> 00:19:48,670
تعرفون عشتار على أنّها إلَهة الحرب

262
00:19:49,080 --> 00:19:53,060
فلتعلموا إذاً بأنّ عشتار
منحَتْنا هذه العذراء

263
00:19:54,730 --> 00:19:59,640
ما دامت هذه العذراء معنا، فإنّ
!هيتّيتيس سوف تسود

264
00:20:05,120 --> 00:20:06,690
اسمعي هذا يا يوري

265
00:20:06,690 --> 00:20:10,740
إذا أردتِ الثّأر لتيتو، فافعلي
ما يلزم للنّجاة إذاً

266
00:20:11,150 --> 00:20:11,980
حسناً

267
00:20:12,830 --> 00:20:17,320
ثمّة أمر آخر. آلينّا هي مسقط
رأس تيتو أيضاً

268
00:20:26,490 --> 00:20:29,800
مرحباً؟ هل من أحد؟ مرحباً؟

269
00:20:31,310 --> 00:20:33,630
من يطرق أثناء هذه الأزمة؟

270
00:20:34,660 --> 00:20:36,580
هل هذا منزل تيتو؟

271
00:20:36,580 --> 00:20:37,940
أجل. وبعد؟

272
00:20:37,940 --> 00:20:40,300
ما قصّة أخينا؟

273
00:20:40,300 --> 00:20:43,610
أنا مبعوثٌ مُرسَل بواسطة الأمير كايل

274
00:20:44,250 --> 00:20:47,140
يؤلمني القول بأنّ أخاكن العزيز قد مات

275
00:20:47,140 --> 00:20:49,310
ماذا؟ تيتو مات؟

276
00:20:49,310 --> 00:20:50,940
هذا مُستحيل

277
00:20:50,940 --> 00:20:56,480
يؤسفني بأنّ محظيّة الأمير قتلَتْه
من أجل سبب تافه

278
00:20:56,480 --> 00:20:59,030
ماذا؟ محظيّته؟

279
00:20:59,030 --> 00:21:01,860
حدّثنا عن هذه المرأة

280
00:21:02,150 --> 00:21:07,120
إنّها فتاة فاسقة صغيرة اسمها يوري

281
00:21:07,520 --> 00:21:10,230
يوري؟ هذه من قتلتْ تيتو؟

282
00:21:11,550 --> 00:21:13,080
يجب أن تدفع الثّمن