1
00:00:02,100 --> 00:00:03,880
،هذه هاتّوسا

2
00:00:04,370 --> 00:00:08,900
عاصمة إمبراطوريّة هيتّايتي في القرن
الرّابع عشر قبل الميلاد

3
00:00:10,590 --> 00:00:16,080
هذه قصّة فتاة تركب الرّياح الحارّة الرّطبة

4
00:00:16,650 --> 00:00:18,840
عبر مسافات الأناضول الواسعة

5
00:00:27,350 --> 00:00:31,240
تهبُّ رياحٌ عاتية، لتحمل معها الرّمال الجافّة

6
00:00:33,220 --> 00:00:34,970
،تهبُّ الرّياح ساخنة

7
00:00:35,730 --> 00:00:37,760
،وأنا أعيش تحت هذه السّماء

8
00:00:38,400 --> 00:00:40,960
على ضفاف النّهر الأحمر

9
00:02:07,610 --> 00:02:09,580
سيف للقتال

10
00:02:13,490 --> 00:02:14,410
يوري؟

11
00:02:15,060 --> 00:02:19,160
تقولين بأنّكِ المحظيّة الرّسميّة الأولى
للأمير كاي؟

12
00:02:19,670 --> 00:02:21,560
و-ومن  تكون أنت؟

13
00:02:21,980 --> 00:02:24,580
من أكون؟ اسمي تالوس

14
00:02:24,580 --> 00:02:26,170
تالوس؟

15
00:02:26,170 --> 00:02:28,350
يبدو ذلك الاسم مألوفاً

16
00:02:28,350 --> 00:02:30,820
إلى أين ذهبتِ يا فتاة؟

17
00:02:30,820 --> 00:02:33,880
تظاهر بأنّك لم ترني! ذلك
!الرّجل يلحق بي

18
00:02:31,170 --> 00:02:32,590
،سأقطع رأسكِ

19
00:02:32,590 --> 00:02:34,740
!أينما هربتِ

20
00:02:35,300 --> 00:02:38,720
إن كنتِ يوري فعلاً، فلا أستطيع تجاهلكِ

21
00:02:39,150 --> 00:02:41,320
هل أنتِ في الخارج يا فتاة؟

22
00:02:41,780 --> 00:02:45,230
عليّ الذّهاب حقّاً! أعِدُك بأنّنا
!سوف نتكلّم لاحقاً

23
00:02:45,230 --> 00:02:47,490
لن يكون هناك أيّ كلام

24
00:02:48,190 --> 00:02:51,890
!أنت مُلكي أيّها الوقحة! سأقطع رأسك

25
00:02:48,500 --> 00:02:51,270
الكاشوغا زووا يُطاردكِ

26
00:02:51,270 --> 00:02:54,450
ثمّ ستُقاتلينه

27
00:02:54,450 --> 00:02:55,360
تعالي

28
00:02:55,360 --> 00:02:56,550
لـ-لماذا؟

29
00:02:56,910 --> 00:02:59,920
من يكون هذا الرّجل بالضّبط؟

30
00:03:02,700 --> 00:03:06,660
هل تعرف إلى أين يؤدّي المعبر السّرّي؟

31
00:03:06,660 --> 00:03:08,870
لا، لا أملك أدنى فكرة

32
00:03:08,870 --> 00:03:10,800
المعذرة، أستميحك عذراً

33
00:03:11,500 --> 00:03:15,260
أعتقد بأنّه يتّصل بخلفيّة ورشة أبي

34
00:03:15,590 --> 00:03:19,860
هذا صحيح. هاتّي عشيرة حِدادة
وصناعة معادن

35
00:03:19,860 --> 00:03:23,760
ورشة مثاليّة في الطّوارئ بما أنّها
تحتوي على أسلحة

36
00:03:23,760 --> 00:03:25,300
هيّا بنا يا سموّ الأمير كايل

37
00:03:25,300 --> 00:03:26,100
حسناً

38
00:03:26,100 --> 00:03:31,270
،قد يسعى ذلك الرّجل للثأر من يوري
مثلما فعلت الأُختان

39
00:03:31,270 --> 00:03:32,410
وصلنا

40
00:03:35,560 --> 00:03:36,700
أين نحن؟

41
00:03:37,550 --> 00:03:39,200
لن تُقاتلي عزلاء

42
00:03:39,830 --> 00:03:42,030
يمكنكِ اختيار سلاح واحد

43
00:03:42,350 --> 00:03:44,450
لماذا تفعل هذا لي؟

44
00:03:44,450 --> 00:03:46,980
هذه ورشتي

45
00:03:46,980 --> 00:03:51,120
نحن الهاتّي نوفّر قوت يومنا
من صناعة هذه الأشياء

46
00:03:51,670 --> 00:03:53,710
هاتّي؟ عشيرة تيتو؟

47
00:03:54,030 --> 00:03:55,260
أجل

48
00:03:55,260 --> 00:03:59,510
لو ظلّ حيّاً، لأصبح خليفتي

49
00:03:59,510 --> 00:04:02,100
إذاً هذا يعني بأنّك والد تيتو

50
00:04:02,100 --> 00:04:03,580
والآن، اختاري

51
00:04:03,580 --> 00:04:05,430
إن لم تفعلي، فسأطردكِ

52
00:04:05,430 --> 00:04:09,110
هكذا إذاً. يعتقد أيضاً بأنّني قتلتُ تيتو

53
00:04:10,310 --> 00:04:14,790
لكن هل يمكنني القول بصدق
بأنّني لا يد لي في الأمر؟

54
00:04:16,900 --> 00:04:20,390
هيّا. اختاري سلاحكِ وقِفي أمام زووا

55
00:04:22,580 --> 00:04:26,000
لا جدوى من البقاء في هذا العصر
إذا ظللتُ أهرب

56
00:04:26,410 --> 00:04:29,060
وسأحتاج سيفاً للقتال

57
00:04:35,190 --> 00:04:37,100
هذا السّيف صدئ تماماً

58
00:04:37,100 --> 00:04:40,180
لماذا هو الوحيد الّذي صدأ من بين
كلّ هذه السّيوف الفاخرة؟

59
00:04:40,850 --> 00:04:44,440
يبدو رديئاً جداً وعتيقاً بين السّيوف اللّامعة

60
00:04:44,990 --> 00:04:46,600
يُشبهني بعض الشّيء

61
00:04:50,100 --> 00:04:51,890
وهو يلائم يدي بصورة مثاليّة

62
00:04:54,110 --> 00:04:56,730
إن لم تُمانع، سآخذ هذا

63
00:05:02,330 --> 00:05:04,490
!وجدتُكِ أيّتها الوقحة

64
00:05:04,490 --> 00:05:07,270
!هذه المرّة، أنتِ فريستي

65
00:05:13,690 --> 00:05:14,660
!تالوس

66
00:05:18,110 --> 00:05:21,340
سمو الأمير كايل؟ مضى وقت طويل

67
00:05:21,340 --> 00:05:22,800
هل مرّتْ فتاةٌ من هنا؟

68
00:05:23,220 --> 00:05:26,260
أرسلتُها لمُقاتلة زووا قبل مجيئك

69
00:05:26,260 --> 00:05:27,530
ماذا؟

70
00:05:29,700 --> 00:05:32,680
ليس عليك العبوس بشأن مصير عذرائك

71
00:05:33,290 --> 00:05:34,480
ماذا يعني؟

72
00:05:34,850 --> 00:05:41,280
هادي، عندما طلبتُ من الفتاة اختيار
سيف، سرعان ما اختارت خياراً صحيحاً

73
00:05:42,110 --> 00:05:43,060
...تقصد

74
00:05:43,060 --> 00:05:44,490
ماذا اختارت؟

75
00:05:44,490 --> 00:05:49,130
سموّك، تعلم بأنّ هذه البلاد في حالة
دائمة من الحروب

76
00:05:49,500 --> 00:05:53,060
الميتانّي. المصريّون. والهيتّايتي

77
00:05:53,460 --> 00:05:56,060
،تتحارب القوى الثّلاث على السّيادة

78
00:05:56,060 --> 00:05:59,760
والدُّول الصّغرى تتحارب فيما بينها أيضاً

79
00:06:00,090 --> 00:06:01,800
نحن من قبيلة هاتّي

80
00:06:01,800 --> 00:06:07,890
،لطالما صلّينا لإلَهة الحرب، عشتار
لتقف في صفّنا

81
00:06:07,890 --> 00:06:14,310
والآن يعتبر أهل البلدة محظيّتك
تجسيداً لعشتار

82
00:06:14,310 --> 00:06:17,900
مهلاً لحظة. ألهذا جعلتَ يوري-ساما
تختار سيفاً؟

83
00:06:17,900 --> 00:06:21,080
بالفعل. وضعتُها تحت اختبار

84
00:06:21,080 --> 00:06:23,580
واختارت السّيفَ الصّحيح

85
00:06:23,990 --> 00:06:26,600
نفس السّيف الّذي كنّا نُقدّره لأجيال

86
00:06:26,600 --> 00:06:27,910
سيف ثمين؟

87
00:06:27,910 --> 00:06:29,160
الأمير كايل

88
00:06:29,490 --> 00:06:32,080
السّيف الّذي اختارته محظيّتك

89
00:06:32,080 --> 00:06:36,170
هو سلاح قويّ سيُحدّد من يحكم
العالمَ المعروف

90
00:06:37,920 --> 00:06:39,630
!توقّفي يا فتاة

91
00:06:40,960 --> 00:06:42,050
يوري-ساما؟

92
00:06:43,060 --> 00:06:43,760
!زووا

93
00:06:43,760 --> 00:06:46,010
!يوري-ساما، اسمحي لنا

94
00:06:46,010 --> 00:06:47,680
!ابتعدا أيّها الضّعيفان

95
00:06:51,010 --> 00:06:52,180
!أيُّها البرغوث

96
00:06:52,970 --> 00:06:54,340
إنّه قويٌّ جدّاً

97
00:06:54,340 --> 00:06:56,690
ولديه سيف ضخمك

98
00:07:01,520 --> 00:07:02,440
!يوري

99
00:07:05,480 --> 00:07:06,490
أحضري سِهامي

100
00:07:10,870 --> 00:07:12,790
هذا طوق تيتو

101
00:07:14,750 --> 00:07:16,410
لا أستطيع الهرب فحسب

102
00:07:18,590 --> 00:07:21,200
ستُواجهينني بهذا السّيف التّافه؟

103
00:07:21,200 --> 00:07:24,820
أتريدينني أن أشطركِ إلى نصفين
بالإضافة إلى سيفكِ؟

104
00:07:25,550 --> 00:07:26,550
!لن أهرب

105
00:07:27,060 --> 00:07:27,840
!يوري

106
00:07:32,290 --> 00:07:34,520
كسرَتْ سيفَ زووا؟

107
00:07:35,410 --> 00:07:37,180
جـ-جنون

108
00:07:38,270 --> 00:07:41,020
ما-ما هذا السّيف؟

109
00:07:41,020 --> 00:07:43,020
أنتِ تسخرين منّي

110
00:07:43,730 --> 00:07:47,910
لستُ بحاجة سيف لفصل رأسكِ
عن جسدكِ بيدَي هاتين

111
00:07:50,310 --> 00:07:52,030
لا تسنح لي فُرصة جيّدة للرّمي

112
00:07:53,460 --> 00:07:56,460
!ستدفع ثمنَ ما فعلتَه لتيتو

113
00:08:00,150 --> 00:08:02,480
عسى أن تمدّني السّماء بالقوّة

114
00:08:02,480 --> 00:08:03,670
بئساً

115
00:08:03,670 --> 00:08:06,590
هذا السّيف التّافه لن يمنعني من سحقك

116
00:08:16,300 --> 00:08:18,240
مات؟

117
00:08:18,240 --> 00:08:19,360
زووا قد مات؟

118
00:08:19,360 --> 00:08:20,640
حقّاً؟

119
00:08:22,480 --> 00:08:24,770
!هلكَ زووا

120
00:08:24,770 --> 00:08:26,860
يستطيع أبي أن يرقد بسلام أخيراً

121
00:08:26,860 --> 00:08:28,260
وكذلك أخي الصّغير

122
00:08:28,260 --> 00:08:29,740
انظري يا أختي

123
00:08:29,740 --> 00:08:31,170
إنّه طوق تيتو

124
00:08:31,170 --> 00:08:33,240
إذاً زووا قتلَ تيتو

125
00:08:33,880 --> 00:08:35,180
يوري-ساما

126
00:08:38,460 --> 00:08:40,710
اقبلي اعتذارنا أرجوكِ

127
00:08:42,040 --> 00:08:43,050
يوري

128
00:08:50,850 --> 00:08:51,850
تيتو

129
00:08:53,320 --> 00:08:54,480
...أنا

130
00:08:56,150 --> 00:08:58,960
لم أقضِ على الملكة بعد

131
00:08:59,590 --> 00:09:02,100
لكن قتلتُ زووا، الرّجل الّذي سلخ جلدك

132
00:09:03,780 --> 00:09:04,820
...لذا

133
00:09:05,650 --> 00:09:09,870
هل يمكننا القول بأنّني في الطّريق
إلى الثّأر لأجلك؟

134
00:09:10,840 --> 00:09:11,700
ماذا؟

135
00:09:11,700 --> 00:09:13,370
هل هذا نجم الصّباح؟

136
00:09:14,380 --> 00:09:17,950
!لا، ليس كذلك! إنّها يوري-ساما

137
00:09:18,310 --> 00:09:22,360
...تيتو، أستطيع الآن أن أرسلك

138
00:09:22,360 --> 00:09:24,770
أستطيع إرسالك إلى السّماء

139
00:09:25,880 --> 00:09:28,290
!يوري-ساما هي إلَهة الحرب حقّاً

140
00:09:28,290 --> 00:09:30,340
!إنّها عشتار الهيتّايتيّين

141
00:09:30,340 --> 00:09:31,820
!تحيا يوري-ساما

142
00:09:31,820 --> 00:09:34,800
!تحيا عشتار

143
00:09:32,610 --> 00:09:33,520
!يوري

144
00:09:34,800 --> 00:09:36,240
!الأمير كايل

145
00:09:36,720 --> 00:09:39,240
—آسفة لو أثرتُ قلقك، أنا

146
00:09:39,240 --> 00:09:39,980
ماذا؟

147
00:09:40,670 --> 00:09:43,880
أجل، أستطيع سماع قلبكِ ونبضكِ

148
00:09:43,880 --> 00:09:45,660
وجسدك دافئ

149
00:09:45,660 --> 00:09:46,980
هذا مُطمئن

150
00:09:47,270 --> 00:09:48,280
!سموّ الأمير

151
00:09:49,460 --> 00:09:51,320
ما شكل هذا السّيف؟

152
00:09:51,700 --> 00:09:54,070
ما يكون هذا برأيك؟

153
00:09:54,070 --> 00:09:55,200
تالوس

154
00:09:57,120 --> 00:10:00,450
يوري-ساما، لماذا اخترتِ هذا السّيف؟

155
00:10:00,450 --> 00:10:03,980
في الواقع، السّيوف الأُخرى
كانت كبيرة جدّاً بالنّسبة لي

156
00:10:03,980 --> 00:10:06,720
،لكن يوجد غِمد صدئ مع هذا

157
00:10:06,720 --> 00:10:08,840
لذا ظننتُ بأنّه مُجرّد سيف حديديّ عاديّ

158
00:10:08,840 --> 00:10:10,040
حديديّ؟

159
00:10:10,040 --> 00:10:12,160
يوري-ساما، أتعرفين بالحديد؟

160
00:10:12,610 --> 00:10:18,470
أن تُميّزي الحديد من النّظر فوراً
هو أمر مُدهش حقّاً

161
00:10:18,470 --> 00:10:20,100
ما السّبب؟

162
00:10:20,100 --> 00:10:23,740
سيف حديديّ ليس بالأمر الجلل، صحيح؟

163
00:10:23,740 --> 00:10:28,280
الحديد هو معدنٌ نادرٌ جدّاً لا يتواجد إلّا
في الحجارة الّتي تتساقط من السّماء

164
00:10:28,860 --> 00:10:33,500
كلّ بلد في العالم مُستعدّة لدفع أكوام
من الذّهب لأجل الحديد

165
00:10:33,500 --> 00:10:37,120
،تقريباً لم يرَ أحدٌ الحديد من قبل
مع ذلك استطعتِ تمييزه

166
00:10:37,120 --> 00:10:40,320
أيقولون لي بأنّ الحديد نادر جدّاً؟

167
00:10:40,320 --> 00:10:44,580
هل رجعتُ كثيراً بالزّمن لدرجة
لم يكن الحديد مُتوفّراً؟

168
00:10:44,580 --> 00:10:46,980
،لكن منذ القِدَم

169
00:10:46,980 --> 00:10:51,330
اشتهرتْ عشيرتنا بمعرفة كيفيّة الحصول
على الحديد من خامّ موجود في الأرض

170
00:10:51,330 --> 00:10:54,590
تلك المعرفة هي الكنز الحقيقيّ لهاتّي

171
00:10:54,590 --> 00:10:56,940
تعرف عشيرتك صنع الحديد؟

172
00:10:56,940 --> 00:10:58,120
يوري-ساما

173
00:10:58,510 --> 00:11:01,840
يمكنكِ إنزال العقوبة القصوى علينا

174
00:11:01,840 --> 00:11:03,320
،تمّ خداعنا

175
00:11:03,320 --> 00:11:07,150
،لكن أذيّتكِ، عشتار بحدّ ذاتها
تبقى خطيئة فاحشة

176
00:11:07,150 --> 00:11:09,500
عقوبة الإعدام؟ مُستحيل

177
00:11:09,500 --> 00:11:13,810
سموّ الأمير، هادي والتّوأمتان خُدِعنَ
بواسطة الملكة، صحيح؟

178
00:11:13,810 --> 00:11:18,090
هذا صحيح، لكن مع ذلك سبّبنَ
لكِ أذى مُميتاً

179
00:11:18,090 --> 00:11:20,530
كيف تريدين التّعامل معهن؟

180
00:11:20,530 --> 00:11:22,740
لـ-لن أفعل شيئاً لهُن

181
00:11:22,740 --> 00:11:26,300
هذه غلطتي من الأساس لأنّني
لم أتكلّم معهن في وقت أسبق

182
00:11:26,300 --> 00:11:27,500
يوري-ساما؟

183
00:11:28,890 --> 00:11:34,320
لحسن حظّهن، قلّة من النّاس يعلمون
بأنّهن قد سمّمنَكِ

184
00:11:35,520 --> 00:11:36,260
تالوس

185
00:11:36,260 --> 00:11:36,990
سموّك

186
00:11:36,990 --> 00:11:40,090
لا يوجد وصيفات في قصري الآن

187
00:11:40,090 --> 00:11:42,850
أودّ توفير خادمة أو أكثر ليوري

188
00:11:43,190 --> 00:11:48,200
هل يمكن أن تسمح لبناتك برعاية
يوري كخادمات شخصيّات؟

189
00:11:51,180 --> 00:11:53,110
أشكرك، سموّك

190
00:11:53,110 --> 00:11:54,790
هذا مُطمئن

191
00:11:54,790 --> 00:11:58,420
آمل أن يعوّض هذا بعض الشّيء
عن مقتل تيتو

192
00:11:58,420 --> 00:12:00,240
وثمّة أمر آخر يا يوري-ساما

193
00:12:00,780 --> 00:12:04,360
فقدت عشيرتُنا خليفتَها أسرارنا
في أعمال الحِدادة

194
00:12:04,940 --> 00:12:09,790
لكن أحببتِ تيتو بما يكفي
للثأر لوفاته القاسية

195
00:12:10,130 --> 00:12:15,670
لذا نحن، الهاتّي، سننقل أيضاً
فنون الحِدادة لكِ

196
00:12:15,670 --> 00:12:20,360
تقصد أنّ يوري حُرّة في فعل ما يحلو
لها في مجال صنع الحديد الخاصّ بكم؟

197
00:12:20,360 --> 00:12:25,930
أجل. نُقدِّم ليوري الفنَّ الّذي سيغزو العالم

198
00:12:26,750 --> 00:12:28,000
لي أنا؟

199
00:12:29,860 --> 00:12:31,440
أبليتَ بلاء حسناً يا كايل

200
00:12:31,440 --> 00:12:34,020
،لم تردع الكاشوغا فحسب

201
00:12:34,020 --> 00:12:36,550
بل عدتَ وبحوزتك جائزة أعظم
في صنع الحديد

202
00:12:36,550 --> 00:12:40,570
سيجعل هذا الإنجاز جيشنا الأقوى في العالم

203
00:12:40,570 --> 00:12:45,700
في الحقيقة، كانت يوري من مُنِحَتْ
أسرار الحديد، لا أنا

204
00:12:46,550 --> 00:12:50,790
يمتلك بلدُنا السرَّ الآن

205
00:12:50,790 --> 00:12:55,590
نحن أيضاً نميل للاعتقاد بأنّ
محظيّتك هي عشتار بحدّ ذاتها

206
00:12:55,590 --> 00:12:57,140
ألسنا كذلك يا ملِكتي؟

207
00:12:57,140 --> 00:12:58,420
بلا شكّ

208
00:12:58,960 --> 00:13:03,680
.يجب أن أهنّئك يا سموّ الأمير كايل
لديك ذوق رفيع في النّساء

209
00:13:04,230 --> 00:13:06,340
هذا لطفٌ منكِ يا أُمّاه

210
00:13:12,030 --> 00:13:15,760
أرغب في تجهيزها قبل خوض
حرب مع الميتانّي

211
00:13:16,160 --> 00:13:18,260
بدأ الميتانّي بالتحرُّك؟

212
00:13:18,260 --> 00:13:22,950
أجل. نعتقد بأنّنا سنشتبك في حرب
قبل نهاية العام

213
00:13:23,260 --> 00:13:25,360
لن تكون كمعاركنا السّابقة

214
00:13:25,360 --> 00:13:29,200
ستُحدِّد هذه الحرب بقاء دولتنا

215
00:13:29,200 --> 00:13:32,500
أمرتُ الأُمراء بالرّحيل عن مُستوطناتهم

216
00:13:32,500 --> 00:13:35,980
كايل، أتوقّع منك أيضاً أن تبقى مُتأهِّباً

217
00:13:35,980 --> 00:13:36,800
حاضر

218
00:13:38,170 --> 00:13:40,560
إذاً حرب مع الميتانّي

219
00:13:41,230 --> 00:13:42,640
ويا كايل

220
00:13:43,660 --> 00:13:47,030
يجب أن تُرافقك محظيّتُك إلى المعركة ثانية

221
00:13:47,030 --> 00:13:49,340
،سواء كانت عشتار فعلاً أم لا

222
00:13:49,340 --> 00:13:52,020
حضورها يُلهم الجنود حتماً

223
00:13:52,020 --> 00:13:53,200
مفهوم؟

224
00:13:54,520 --> 00:13:56,700
!مـ-مهلاً يا هذا

225
00:13:56,700 --> 00:13:58,600
!أبطئ قليلاً

226
00:13:57,020 --> 00:14:00,030
عليكِ أن تجلسي مُنتصبة القامة
وتُحافظي على توازنكِ

227
00:14:00,860 --> 00:14:04,330
!ليتني أستطيع، لكن لا يمكنني

228
00:14:06,240 --> 00:14:09,600
على أيّ حال، لماذا أنتِ مُتلهّفة
للتّدريب من أجل المعركة؟

229
00:14:09,600 --> 00:14:10,750
...في الواقع

230
00:14:11,620 --> 00:14:14,090
،استطعتُ الانتقام من قاتل تيتو

231
00:14:14,090 --> 00:14:16,730
،لكن سأتواجد هنا لبعض الوقت

232
00:14:16,730 --> 00:14:19,520
ولا أريد أن أشكّل عائقاً في وجه كايل

233
00:14:19,520 --> 00:14:20,880
يوري-ساما

234
00:14:21,410 --> 00:14:23,400
ماذا تعتقدين بأنّكِ تفعلين؟

235
00:14:23,400 --> 00:14:25,820
الأمير كايل على وشك أن يُشرّفنا بحضوره

236
00:14:25,820 --> 00:14:28,290
لِمَ ترتدي عقيلته زيّاً كهذا؟

237
00:14:28,290 --> 00:14:30,000
هيّا. لنذهب ونُبدّل ملابسكِ

238
00:14:30,950 --> 00:14:33,390
!يا إلهي! كم هذا جذّاب

239
00:14:33,390 --> 00:14:35,400
أحبُّ هذا أيضاً

240
00:14:35,900 --> 00:14:37,820
مُبهر

241
00:14:38,650 --> 00:14:40,170
هذا يكفي حاليّاً

242
00:14:40,170 --> 00:14:42,470
أبدو بلهاء بالفساتين

243
00:14:42,470 --> 00:14:44,100
لا، نحن مُصرّات

244
00:14:44,100 --> 00:14:46,850
،تمّ توظيفنا كوصيفات لكِ

245
00:14:46,850 --> 00:14:50,740
لذا سنعتني بشعركِ وبشرتكِ
وكذلك لباسكِ

246
00:14:50,740 --> 00:14:52,080
لحظة، سوف تُحمّمنني؟

247
00:14:52,080 --> 00:14:56,190
تزداد الأيّام حرّاً، وسيُفسد الهواء
الجافّ بشرتكِ

248
00:14:56,190 --> 00:14:57,130
أجل، بالفعل

249
00:14:57,510 --> 00:15:00,220
،إذا كنتِ ستنامين مع الأمير كايل اللّيلة

250
00:15:00,220 --> 00:15:02,750
فعلينا أن نُدلّككِ بزيوت عطريّة

251
00:15:04,040 --> 00:15:05,470
تروقني تلك الفكرة

252
00:15:05,470 --> 00:15:08,260
سموّك. أهلاً بعودتك

253
00:15:10,720 --> 00:15:12,100
!اخرج من هنا

254
00:15:12,100 --> 00:15:14,500
لـ-لماذا أنتِ وقحة مع الأمير؟

255
00:15:14,500 --> 00:15:17,240
لماذا أنتِ مُحرَجة من الشّخص
الّذي ستنامين معه؟

256
00:15:17,810 --> 00:15:20,780
معها حقّ لو كنتُ محظيّة حقيقيّة

257
00:15:21,940 --> 00:15:24,560
لكن لستُ كذلك حتّى بالنّسبة له

258
00:15:28,950 --> 00:15:30,200
يوري-ساما

259
00:15:30,200 --> 00:15:32,470
أترتدين هذا الزيّ من جديد؟

260
00:15:32,470 --> 00:15:35,160
لا داعي. هذا أسهل للتحرُّك

261
00:15:36,150 --> 00:15:39,880
نبأ يا سموّ الأمير. عاد الأمير
زانّانزا إلى الدّيار

262
00:15:40,260 --> 00:15:42,340
ماذا؟ زانّانزا؟

263
00:15:43,590 --> 00:15:45,470
زانّانزا، أهلاً بعودتك

264
00:15:46,930 --> 00:15:49,300
أخي، لم أرك منذ وقت طويل

265
00:15:49,300 --> 00:15:50,550
أرى بأنّك على أحسن ما يُرام

266
00:15:50,550 --> 00:15:53,680
كالعادة، وأنت كما أتذكّرك

267
00:15:53,680 --> 00:15:58,690
أجل. لكن كما سمعت، يسعى
الميتانّي للحرب معنا

268
00:15:58,690 --> 00:15:59,980
من هذا؟

269
00:15:59,980 --> 00:16:03,680
الأمير زانّانزا، الرّابع في سلسلة
خِلافة العرش

270
00:16:03,680 --> 00:16:06,720
،في حين أنّه أخو كايل من أمّ مُختلفة

271
00:16:06,720 --> 00:16:11,700
إلّا أنّهما ترعرعا معاً ويتعاملان مع بعضهما
الآخر كأخوين كاملين

272
00:16:11,700 --> 00:16:15,970
الأمير زانّانزا لا غِنى عنه ليحكم
الأمير كايل العالم

273
00:16:16,330 --> 00:16:18,580
لكن على أيّ حال، أين "إلَهتك" يا أخي؟

274
00:16:19,190 --> 00:16:20,930
سمعتُ الأنباء

275
00:16:20,930 --> 00:16:25,050
أميرة ذات جمال أخّاذ قد أسرَتْ قلبَك

276
00:16:25,050 --> 00:16:27,980
أجل. إنّها حسناء بالفعل

277
00:16:30,470 --> 00:16:32,130
هل ارتكبتُ خطأ؟

278
00:16:34,070 --> 00:16:36,640
أهذه هي عقيلتُك؟

279
00:16:37,020 --> 00:16:39,150
ظننتُك غُلاماً خادماً

280
00:16:39,150 --> 00:16:41,720
طلبنا منها تبديل لِباسها

281
00:16:39,390 --> 00:16:44,020
لا، عند إمعان النّظر، مظهركِ وجاذبيّتكِ
فريدان من نوعهما حقّاً

282
00:16:44,410 --> 00:16:46,430
سامحيني رجاء

283
00:16:46,430 --> 00:16:50,220
تبدو مُختلفة تماماً عن حبيباتك
السّابقات يا أخي

284
00:16:50,220 --> 00:16:51,530
زانّانزا

285
00:16:51,530 --> 00:16:54,310
لا، لا أشكّ بك يا أخي

286
00:16:54,310 --> 00:16:56,600
اخترتَ تجسيدَ عشتار بلا شكّ

287
00:16:56,600 --> 00:16:58,540
سنهزم الميتانّي

288
00:16:58,540 --> 00:17:00,880
لا يمكن أن تكون هناك وسيلة أُخرى

289
00:17:00,880 --> 00:17:05,050
هذه الحرب هي فُرصتنا العُظمى لنشر
اسم الأمير كايل

290
00:17:05,050 --> 00:17:06,670
سيكون كلّ شيء على ما يُرام

291
00:17:06,670 --> 00:17:09,300
لا يوجد مُحاربٌ أعظم من الأمير كايل

292
00:17:09,300 --> 00:17:13,800
.يجب ألّا نثِق بأنفسنا بإفراط
فالهزيمة ستعني نهاية الهيتّايتي

293
00:17:13,800 --> 00:17:17,020
سموّ الأمير، هل تريد حكم العالم؟

294
00:17:18,430 --> 00:17:22,380
أسعى لحكم مثاليّ حالما أتبوّأ العرش

295
00:17:22,800 --> 00:17:24,600
،أسعى لعالم بلا حرب

296
00:17:24,600 --> 00:17:28,560
حيث لا نغزو الآخرين ولا يغزونا الآخرون

297
00:17:29,100 --> 00:17:32,970
لذا هل ترين تناقُضاً في تحضيري للمعركة؟

298
00:17:34,490 --> 00:17:38,080
لكن لا معنى للكلمات المُبتذَلة في عالم اليوم

299
00:17:38,630 --> 00:17:41,240
الدُّول الضّعيفة سرعان ما يتمّ
اجتياحها بواسطة الدُّول المُجاورة

300
00:17:41,870 --> 00:17:44,860
لا يُكسَب السّلام إلّا من خلال ألم المعركة

301
00:17:45,380 --> 00:17:47,400
،إن كان هذا ضروريّاً للسّلام

302
00:17:47,750 --> 00:17:50,260
فسوف أغزو العالمَ إذاً

303
00:17:50,260 --> 00:17:52,000
أنا معك يا أخي

304
00:17:52,000 --> 00:17:55,210
ولا شكّ في أنّني سأُساعدك
في مسعاك العظيم

305
00:17:56,390 --> 00:17:59,780
،كلّما تعرّفتُ على الأمير أكثر
بدا بعيد المنال أكثر

306
00:18:02,140 --> 00:18:05,710
نفد الخمر لدينا، لذا سأحضر بعضاً

307
00:18:05,710 --> 00:18:07,070
من فضلكِ

308
00:18:07,570 --> 00:18:12,970
،سموّك، ما زلتُ مُعارضاً لحصولك على محظيّة

309
00:18:12,970 --> 00:18:16,200
لكن يبدو أنّه يترتّب عليّ قبول يوري-ساما

310
00:18:17,100 --> 00:18:22,280
ستُثبت بأنّها نافعة لك حتّى يأتي
اليوم الّذي تتّخذ فيه زوجةً شرعيّة

311
00:18:23,350 --> 00:18:27,920
إيل، أنا لا أُبقي يوري بجانبي
فقط لأنّها عشتار

312
00:18:47,930 --> 00:18:49,110
يوري

313
00:18:49,910 --> 00:18:51,160
سموّ الأمير كايل

314
00:18:52,920 --> 00:18:57,070
يمكنني بناء قصر مُختلِف لأجلكِ

315
00:18:57,070 --> 00:19:00,950
سيتمّ حمايتكِ بواسطة نخبة من الحُرّاس
وذلك كي نتمكّن من العيش مُفترقَين

316
00:19:01,240 --> 00:19:01,960
ماذا؟

317
00:19:02,410 --> 00:19:04,910
هل ستفترقين عنّي؟

318
00:19:05,880 --> 00:19:08,670
أعتقد بأنّها... فكرة

319
00:19:09,150 --> 00:19:12,860
يريد أن يجد زوجةً فعليّة على أيّ حال

320
00:19:14,680 --> 00:19:18,300
حسنٌ إن كان هذا ما تُريده

321
00:19:22,310 --> 00:19:27,690
إبقاؤكِ معي سيُعرّضكِ لخطر حربنا

322
00:19:30,780 --> 00:19:35,720
أنتِ لستِ مُلكيّتي، مع ذلك
أُقحمكِ في طموحاتي

323
00:19:36,030 --> 00:19:39,030
سيكون هذا بمثابة استغلال لكِ فقط

324
00:19:44,860 --> 00:19:47,540
إذاً هل أنا نافعة لك؟

325
00:19:47,540 --> 00:19:49,500
أجل، بشكل بليغ

326
00:19:50,120 --> 00:19:52,880
لكن لم يكن هذا سبب اختطافكِ من الملِكة

327
00:20:03,720 --> 00:20:05,180
...إن لم أكن عقبة

328
00:20:07,400 --> 00:20:09,030
فخُذني معك إذاً

329
00:20:12,170 --> 00:20:14,210
أعلم بأنّه لن يكون لي

330
00:20:14,210 --> 00:20:15,690
...لكن الآن

331
00:20:15,990 --> 00:20:18,200
كُلّ ما أريده هو أن أكون مع كايل

332
00:20:43,240 --> 00:20:46,390
أريد أن أُساعده حقّاً

333
00:20:51,040 --> 00:20:52,690
أيُعقَل هذا؟

334
00:20:52,690 --> 00:20:57,550
كايل وزانّانزا، جوهرتا أولياء عهد
الهيتّايتي توحّدا

335
00:20:57,550 --> 00:21:01,700
حتّى النّاس بدؤوا يُوقّرون تلك العذراء
بصفتها عشتار

336
00:21:02,210 --> 00:21:09,160
،إذا حقّقَ كايل نصراً ضدّ الميتانّي
سيؤمّن صعوده للعرش

337
00:21:09,470 --> 00:21:10,500
اللّعنة عليه

338
00:21:11,470 --> 00:21:14,140
يجب ألّا نسمح بحدوث ذلك