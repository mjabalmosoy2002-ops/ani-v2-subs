1
00:00:02,100 --> 00:00:03,880
،هذه هاتّوسا

2
00:00:04,370 --> 00:00:08,900
عاصمة إمبراطوريّة هيتّايتي في القرن
الرّابع عشر قبل الميلاد

3
00:00:10,590 --> 00:00:16,080
هذه قصّة فتاة تركب الرّياح الحارّة الرّطبة

4
00:00:16,650 --> 00:00:18,840
عبر مسافات الأناضول الواسعة

5
00:00:27,350 --> 00:00:31,240
تهبُّ رياحٌ عاتية، لتحمل معها الرّمال الجافّة

6
00:00:33,220 --> 00:00:34,970
،تهبُّ الرّياح ساخنة

7
00:00:35,730 --> 00:00:37,760
،وأنا أعيش تحت هذه السّماء

8
00:00:38,400 --> 00:00:40,960
على ضفاف النّهر الأحمر

9
00:02:07,340 --> 00:02:09,600
الشّخص الّذي لا أستطيع أن أُحبّه

10
00:02:20,470 --> 00:02:23,410
سيتزوّج الأمير كايل من فتاة
أُخرى في النّهاية

11
00:02:24,720 --> 00:02:26,660
...لذا لا أستطيع السّماح لنفسي

12
00:02:28,750 --> 00:02:31,960
بالوقوع في حُبِّه أكثر من ذلك

13
00:02:42,500 --> 00:02:44,310
جيّد. سيَفي هذا بالغرض

14
00:02:44,890 --> 00:02:49,820
تطوّرتِ كثيراً حتّى صرتِ تتمكّنين
من مُبارزة زانّانزا بالسّيف يا يوري

15
00:02:49,820 --> 00:02:55,490
،يوري-ساما، تحسّنتِ كثيراً
وحتّى نحن لسنا ندّاً لكِ

16
00:02:55,810 --> 00:02:57,820
من الواضح أنّ لديكِ موهبة في ذلك

17
00:02:58,210 --> 00:03:02,330
لا أملك خياراً. إذا أردتُ
...البقاء مع الأمير كايل

18
00:03:04,600 --> 00:03:06,240
هذه هي الطّريقة الوحيدة

19
00:03:10,020 --> 00:03:14,400
بدأتُ أدرك سبب انجذابك
نحو هذه العذراء يا أخي

20
00:03:14,840 --> 00:03:17,510
صراحتها وصدقها العظيم يجعلانها قيّمة

21
00:03:18,490 --> 00:03:20,870
أستأذن، سموّك

22
00:03:20,870 --> 00:03:21,810
ما الأمر؟

23
00:03:21,810 --> 00:03:26,770
يريد الملك استضافة حفلة
،عشاء في قصره

24
00:03:26,770 --> 00:03:30,810
الآن بعد أن اجتمع كافّة
الأُمراء في العاصمة

25
00:03:31,090 --> 00:03:36,180
من أجل هذه المُناسبة، أمر الملك
أن يُحضر الأُمراء عقيلاتهم

26
00:03:36,180 --> 00:03:41,360
يودُّ جلالته رؤية عشتار، لذا
يوري-ساما لديها دعوة خاصّة

27
00:03:42,900 --> 00:03:45,540
سموّ الأمير كايل، احذر من فضلك

28
00:03:45,540 --> 00:03:49,380
كانت الملِكة ناكيا هي من اقترحت
حضور العقيلات

29
00:03:49,380 --> 00:03:52,940
تلك الملِكة الخبيثة. إنّها
تنوي فعل شيء ما

30
00:04:01,880 --> 00:04:04,950
هل أنت متأكّدٌ بأنّني ينبغي
أن أتواجد هنا؟

31
00:04:05,980 --> 00:04:07,040
ماذا؟

32
00:04:07,040 --> 00:04:09,370
يا إلهي. أهذه هي عقيلة الأمير كايل؟

33
00:04:09,370 --> 00:04:12,970
ماذا ترتدي؟ تبدو كفتى

34
00:04:14,470 --> 00:04:16,030
حسناً، حسناً

35
00:04:16,820 --> 00:04:19,920
أرى أمامي الأمير كايل والأمير زانّانزا

36
00:04:19,920 --> 00:04:21,280
يا مرحباً

37
00:04:21,600 --> 00:04:23,280
الملِكة ناكيا

38
00:04:24,790 --> 00:04:26,140
!أنتِ هناك

39
00:04:26,140 --> 00:04:29,120
!هذا المدخل ليس لأمثالكِ

40
00:04:29,390 --> 00:04:30,320
!غادري حالاً

41
00:04:30,990 --> 00:04:34,480
جلالتكِ، هذا المدخل مُخصّص
للعائلة الملكيّة

42
00:04:34,480 --> 00:04:37,050
هذا التّخصيص يشمل عقيلتي الملكيّة

43
00:04:37,050 --> 00:04:38,160
عقيلتك؟

44
00:04:40,050 --> 00:04:44,930
سامحني. ظننتُها خادمتك بسبب زيّها هذا

45
00:04:46,430 --> 00:04:51,870
قد تعتبرها عشتار، لكن لباسها
يُثبت انعداماً في الذّوق

46
00:04:51,870 --> 00:04:58,190
لا أُصدِّق بأنّ الأمير كايل لا يعرف كيف
يُلبِس محظيّته. هذا مُضحك للغاية

47
00:04:58,570 --> 00:05:01,920
!اختار الأمير فُستاناً جميلاً
أنا من اختار ارتداء هذا فحسب

48
00:05:01,920 --> 00:05:03,030
!اصمتي

49
00:05:03,310 --> 00:05:05,220
هذا لا يعنيكِ

50
00:05:05,220 --> 00:05:08,500
يتعلّق الأمر بتعريض الأمير لوقاره لخطر

51
00:05:08,500 --> 00:05:11,000
بإحضار محظيّة إلى مأدبة بخرقة قماشيّة

52
00:05:12,190 --> 00:05:13,800
لا تصغي إليها

53
00:05:13,800 --> 00:05:16,140
كوني على طبيعتكِ فحسب

54
00:05:16,140 --> 00:05:16,930
—لكن

55
00:05:16,930 --> 00:05:19,210
يوري-ساما، لا ترتعدي رجاء

56
00:05:19,210 --> 00:05:21,750
أتينا ونحن على استعداد لهذا الوضع

57
00:05:23,180 --> 00:05:24,090
تعالي

58
00:05:24,090 --> 00:05:24,970
من هنا

59
00:05:25,800 --> 00:05:28,860
سموّك، انتظر بضع لحظات من فضلك

60
00:05:28,860 --> 00:05:30,260
حـ-حسناً

61
00:05:48,480 --> 00:05:52,080
كايل، أين عشتار خاصّتك؟

62
00:05:54,070 --> 00:05:59,050
النّجمة عشتار تنتظر الفجر، لذا
يمكننا الانتظار أيضاً

63
00:05:59,050 --> 00:06:00,080
هكذا إذاً

64
00:06:00,830 --> 00:06:02,550
ماذا عنك يا زانّانزا؟

65
00:06:02,550 --> 00:06:04,800
،الآن بعد أن حصل كايل على محظيّة

66
00:06:04,800 --> 00:06:08,440
أنت الأمير الوحيد بلا عقيلة

67
00:06:08,440 --> 00:06:09,930
هذا صحيح

68
00:06:09,930 --> 00:06:13,810
حان الوقت لأجد امرأة لي

69
00:06:15,010 --> 00:06:16,400
حسناً

70
00:06:16,400 --> 00:06:17,860
أستميحك عذراً

71
00:06:18,170 --> 00:06:20,860
يوري-ساما جاهزة للدّخول

72
00:06:31,750 --> 00:06:34,600
يوري-ساما، ما الأمر؟

73
00:06:34,600 --> 00:06:38,040
لـ-لا، هذا الفستان مُحرجٌ حقّاً

74
00:06:39,640 --> 00:06:42,190
يبدو أنّ السّتارة ثقيلة جدّاً

75
00:06:42,190 --> 00:06:45,050
سأرافق السّيّدة إلى الخارج

76
00:06:45,050 --> 00:06:46,130
يوري؟

77
00:06:47,020 --> 00:06:49,760
هيّا. كُفّي عن هذا واكشفي عن نفسكِ

78
00:07:14,410 --> 00:07:16,010
ما-ماذا؟

79
00:07:16,010 --> 00:07:17,750
هل أبدو بتلك الغرابة؟

80
00:07:18,140 --> 00:07:20,170
عينايّ خدعتاني

81
00:07:21,300 --> 00:07:25,920
عشتار هي أيضاً إلَهة
الجمال والخيرات

82
00:07:25,920 --> 00:07:28,180
!وما أجملها

83
00:07:28,180 --> 00:07:29,500
بالفعل

84
00:07:29,500 --> 00:07:31,740
من كان يتوقّع أن تكون
أميرة بهذا الشّكل؟

85
00:07:31,740 --> 00:07:36,310
لم يتمكّن الأمير كايل من إيجاد
محظيّة قبل لقائها

86
00:07:39,520 --> 00:07:40,400
!انتبهي

87
00:07:46,230 --> 00:07:49,950
أ-أنا آسفة. لستُ معتادة على
ارتداء الفساتين الطّويلة

88
00:07:50,990 --> 00:07:53,270
لا، أنا المُلام

89
00:08:12,630 --> 00:08:15,120
ما الأمر؟ هل أنتِ مُرهقة؟

90
00:08:15,770 --> 00:08:18,100
الأمير زانّانزا

91
00:08:18,640 --> 00:08:23,730
،لم أحضر حفلةً فاخرة كهذه من قبل
وأنا قلقة بشأن الملِكة

92
00:08:24,100 --> 00:08:27,250
انصدمتُ عندما رأيتُكِ

93
00:08:27,250 --> 00:08:30,330
ذكّرتِني بأمِّي

94
00:08:33,420 --> 00:08:39,510
كانت أمّي خادمة للملِكة الرّاحلة
هينتي، أمّ أخي

95
00:08:40,250 --> 00:08:44,380
جذبتْ أمّي إعجابَ أبي، وكنتُ النّتيجة

96
00:08:45,460 --> 00:08:48,970
لهذا تربّيتَ مع الأمير كايل؟

97
00:08:49,240 --> 00:08:51,510
لكن كانت أمّي واهنة

98
00:08:51,980 --> 00:08:54,360
تُوفّيَتْ في صغري

99
00:08:54,360 --> 00:09:00,480
تبنّتْني الملكةُ هينتي وربّتْني
مثل أخي تماماً

100
00:09:01,150 --> 00:09:07,230
أتذكّر كيف كانت أمّي نحيلة
وضئيلة الحجم، كفتاة صغيرة

101
00:09:08,210 --> 00:09:09,890
مثلما أنتِ الآن

102
00:09:16,190 --> 00:09:18,370
يوري، تعالي معي

103
00:09:18,370 --> 00:09:20,330
ينبغي أن تُرحّبي بوزرائنا

104
00:09:21,690 --> 00:09:24,060
آسفة، لكن عليّ الذّهاب

105
00:09:28,020 --> 00:09:29,370
سموّ الأمير زانّانزا

106
00:09:30,040 --> 00:09:32,550
هل تريد بعض الخمر؟

107
00:09:33,060 --> 00:09:35,280
أجل، رُبّما

108
00:09:40,800 --> 00:09:41,810
جلالتك

109
00:09:42,590 --> 00:09:44,470
أعطيتُه إيّاه

110
00:09:44,470 --> 00:09:46,270
أجل، ممتاز

111
00:09:46,270 --> 00:09:49,780
هذا أجود خمر في مصر

112
00:09:49,780 --> 00:09:53,120
أردتُه أن يتذوّقه

113
00:10:08,250 --> 00:10:10,060
ما-ما الّذي يجري؟

114
00:10:10,060 --> 00:10:13,340
أشعر بحرارة. رأسي يذوب

115
00:10:13,600 --> 00:10:15,590
الأمير زانّانزا

116
00:10:15,590 --> 00:10:19,140
ما شربتَه للتوّ كان ماء الورد

117
00:10:19,540 --> 00:10:23,040
أعتقد بأنّ هناك شيئاً اشتهيتَه

118
00:10:23,040 --> 00:10:26,550
لم تعُد بحاجة لقمع رغباتك

119
00:10:27,820 --> 00:10:32,700
اذهب واستحوذ على ما تشتهيه لاحقاً

120
00:10:35,910 --> 00:10:38,290
...أ-أ

121
00:10:44,660 --> 00:10:46,040
...أريد

122
00:10:46,740 --> 00:10:48,210
أريد تلك الفتاة

123
00:10:49,670 --> 00:10:50,980
لنفسي

124
00:10:52,840 --> 00:10:55,840
يمكننا المُغادرة أخيراً

125
00:10:56,970 --> 00:11:00,720
.سئمتُ من هذا الفُستان الفاخر
أريد تبديله

126
00:11:01,090 --> 00:11:03,640
إذاً سوف نُحضِّر الحمّام

127
00:11:03,640 --> 00:11:05,230
سوف نغسلكِ أيضاً

128
00:11:05,500 --> 00:11:08,520
لا، لا داعي. أستطيع فعل ذلك بنفسي

129
00:11:08,520 --> 00:11:09,360
...لكنّنا

130
00:11:14,760 --> 00:11:18,220
رغم ذلك، أنا مُطمئنّة

131
00:11:18,570 --> 00:11:21,800
ظننتُ بأنّ الملِكة كانت ستفعل
شيئاً اللّيلة

132
00:11:26,610 --> 00:11:28,350
مـ-من هناك؟

133
00:11:36,660 --> 00:11:38,550
الأمير زانّانزا؟

134
00:11:44,560 --> 00:11:46,180
!الأمير كايل

135
00:11:46,760 --> 00:11:47,390
!يوري

136
00:11:48,980 --> 00:11:50,110
زانّانزا؟

137
00:11:52,070 --> 00:11:53,690
!الأمير كايل

138
00:11:54,190 --> 00:11:57,110
زانّانزا، ما معنى هذا؟

139
00:11:57,110 --> 00:12:00,560
أخي، أعطِني هذه العذراء

140
00:12:01,050 --> 00:12:05,330
من حقوقك مُشاركة محظيّة
ليست بزوجتك

141
00:12:05,660 --> 00:12:06,870
...هل أنت

142
00:12:09,180 --> 00:12:12,680
سموّك، الأمير زانّانزا تحت تأثير تعويذة

143
00:12:12,680 --> 00:12:14,050
هكذا يبدو

144
00:12:14,050 --> 00:12:15,650
أعطِني إيّاها

145
00:12:15,650 --> 00:12:17,710
سأحبّها وأقدّرها دوماً

146
00:12:18,450 --> 00:12:18,880
!لا

147
00:12:18,880 --> 00:12:19,890
!زانّانزا

148
00:12:28,770 --> 00:12:31,260
...إن لم تُصبح مُلكي

149
00:12:31,730 --> 00:12:34,190
فسوف أقتلها فوراً

150
00:12:34,190 --> 00:12:35,150
!الأمير زانّانزا

151
00:12:35,150 --> 00:12:36,490
لا تفعل يا كيكّوري

152
00:12:36,490 --> 00:12:38,150
زانّانزا جادّ

153
00:12:38,150 --> 00:12:39,820
!الأمير كايل

154
00:12:40,660 --> 00:12:41,580
!لا

155
00:12:43,470 --> 00:12:44,330
!يوري

156
00:12:47,250 --> 00:12:50,290
!الأمير زانّانزا! عُد أدراجك، من فضلك

157
00:13:01,800 --> 00:13:06,310
هذا يُشبه عندما استخدمت
الملكةُ لعنةً على تيتو

158
00:13:06,670 --> 00:13:08,370
هل فعلَتْها معه أيضاً؟

159
00:13:11,470 --> 00:13:15,940
الأمير كايل، هربَ الأمير زانّانزا
!من بوّابة المدينة عبر حصان

160
00:13:15,940 --> 00:13:17,020
ماذا؟

161
00:13:17,020 --> 00:13:19,810
أيُّها الحارس. من أيّ طريق
اتّجه زانّانزا؟

162
00:13:19,810 --> 00:13:22,610
سـ-سموّك. غادر جنوباً

163
00:13:23,060 --> 00:13:24,200
ماذا؟

164
00:13:27,370 --> 00:13:33,600
كايل. هل صحيحٌ أنّ زانّانزا اختطفَ
محظيّتك وهرب من المدينة بها؟

165
00:13:33,600 --> 00:13:34,500
أجل

166
00:13:34,950 --> 00:13:38,920
.لم أتوخّ الحذر بما يكفي
لا أملك عذراً

167
00:13:38,920 --> 00:13:40,290
بئساً

168
00:13:40,290 --> 00:13:42,990
،الحرب مع الميتانّي تقترب

169
00:13:42,990 --> 00:13:46,440
وقادتي يتقاتلون على امرأة؟

170
00:13:46,440 --> 00:13:50,100
لم يمرّ البلاط على فضيحة
كهذه من قبل

171
00:13:50,100 --> 00:13:51,160
بالفعل

172
00:13:51,730 --> 00:13:53,510
معه كُلّ الحقّ

173
00:13:53,510 --> 00:13:57,260
هل يمكننا حقّاً الوثوق برجل لا يستطيع
التحكُّم بأخيه ومحظيّته

174
00:13:57,260 --> 00:14:01,360
في تولّي الحكومة والجيش كما ينبغي؟

175
00:14:07,240 --> 00:14:08,600
أبي

176
00:14:08,600 --> 00:14:10,670
امنحني الإذن باللّحاق بزانّانزا

177
00:14:10,670 --> 00:14:13,480
لكن يجب أن تستعدّ للحرب

178
00:14:14,020 --> 00:14:16,880
لن أهمل ذلك الواجب. أتوسّل إليك

179
00:14:19,210 --> 00:14:20,270
فليكُن

180
00:14:21,570 --> 00:14:25,350
أرِنا كيف ستُعالج هذه الأزمة

181
00:14:25,350 --> 00:14:26,140
حاضر

182
00:14:45,150 --> 00:14:48,290
الأمير زانّانزا، من فضلك

183
00:14:48,750 --> 00:14:50,200
هل يمكننا العودة؟

184
00:14:57,290 --> 00:14:59,000
إلى أي مسافة يبتعد؟

185
00:14:59,420 --> 00:15:03,170
أمامنا هناك كيزّواتنا، المملكة
الّتي تحدُّ ميتانّي

186
00:15:03,970 --> 00:15:04,920
يوري

187
00:15:13,830 --> 00:15:15,680
ماء

188
00:15:44,840 --> 00:15:46,860
!الأمير زانّانزا، توقّف

189
00:15:46,860 --> 00:15:47,880
!أفلتني

190
00:15:47,880 --> 00:15:50,100
الملكة تتحكُّم بعقلك

191
00:15:50,420 --> 00:15:54,190
تحاول غرس وتد بينك وبين الأمير كايل

192
00:15:54,190 --> 00:15:55,350
أخي؟

193
00:15:57,100 --> 00:15:59,420
أجل! لذا استفِق من ذلك

194
00:15:59,420 --> 00:16:01,360
لنعُد إلى الأمير كايل

195
00:16:01,730 --> 00:16:03,060
أخي

196
00:16:04,910 --> 00:16:08,360
لطالما كنتُ أحسده

197
00:16:10,150 --> 00:16:14,310
كان لديه أمّ لطيفة، وينتظره
مُستقبلٌ مُشرق

198
00:16:14,310 --> 00:16:17,120
شخصيّته هي من النّوع الّذي
!يجذب الجميع إليه

199
00:16:17,120 --> 00:16:19,650
!لديه كُلّ ما أريده

200
00:16:19,650 --> 00:16:21,380
الأمير زانّانزا

201
00:16:24,590 --> 00:16:25,650
يوري

202
00:16:26,350 --> 00:16:28,020
سأقدِّرك للأبد

203
00:16:28,690 --> 00:16:31,090
سأُحبّكِ أكثر من أيّ شخص آخر

204
00:16:33,890 --> 00:16:36,140
أريدكِ أن تكوني مُلكي

205
00:16:36,540 --> 00:16:38,640
ا-ابتعد عنّي

206
00:16:40,830 --> 00:16:43,440
!الميتانّي يُهاجمون

207
00:16:57,240 --> 00:17:01,750
!سموّ الأمير، يجب أن نعود إلى هاتّوسا
!ينبغي أن نُحذّر الأمير كايل

208
00:17:01,750 --> 00:17:03,010
أخي؟

209
00:17:03,010 --> 00:17:04,750
!أجل! تعال الآن

210
00:17:05,130 --> 00:17:07,340
...لكنّني

211
00:17:08,820 --> 00:17:10,260
...أنا

212
00:17:16,890 --> 00:17:20,270
!من فضلك يا سموّ الأمير! أتوسّل إليك

213
00:17:22,840 --> 00:17:26,120
لا جدوى. تعويذة الملِكة قويّةٌ جدّاً

214
00:17:27,460 --> 00:17:29,530
مهلاً أيُّها الشّابّ

215
00:17:29,790 --> 00:17:32,700
امرأتك لا تُحبّذك

216
00:17:32,700 --> 00:17:35,660
دعها هنا، وذلك كي نُوفِّر لها الرَّاحة

217
00:17:35,920 --> 00:17:38,370
هيّا. سلّمها وارحل

218
00:17:38,720 --> 00:17:40,870
!لا، لا تفعلوا! اتركوني

219
00:17:40,870 --> 00:17:41,790
!خُذ

220
00:17:42,960 --> 00:17:44,270
!الأمير زانّانزا

221
00:17:44,270 --> 00:17:46,880
مهلكِ. ستبقين معنا

222
00:17:46,880 --> 00:17:47,990
هيّا

223
00:17:48,350 --> 00:17:49,490
لن تُقاوم؟

224
00:17:48,490 --> 00:17:49,840
خُذ هذه

225
00:17:49,840 --> 00:17:52,920
أعلم بأنّه مُحال أن يسمح لنفسه
بأن يُضرَب هكذا

226
00:17:52,920 --> 00:17:54,590
كيف أوقظه؟

227
00:18:04,480 --> 00:18:06,550
آسفة يا سموّ الأمير

228
00:18:14,780 --> 00:18:18,410
لماذا ضربتِني يا يوري؟
هل تحاولين قتلي؟

229
00:18:18,780 --> 00:18:20,910
هل صحوتَ الآن؟

230
00:18:23,170 --> 00:18:24,350
أنا ماذا؟

231
00:18:25,160 --> 00:18:27,360
تذكّرتُ الآن

232
00:18:27,680 --> 00:18:29,050
...اختطفتُكِ، ثمّ

233
00:18:29,050 --> 00:18:31,860
هذا مُطمئن. عدتَ إلى طبيعتك

234
00:18:31,860 --> 00:18:34,180
ما الهراء الّذي تتفوّهين به؟

235
00:18:40,350 --> 00:18:43,240
أعتذر يا يوري. سأتوب كما ينبغي لاحقاً

236
00:18:45,590 --> 00:18:48,270
،الآن بعد أن عاد الأمير زانّانزا إلى رشده

237
00:18:48,930 --> 00:18:50,150
...هؤلاء

238
00:18:50,780 --> 00:18:52,270
!لا يملكون فُرصة

239
00:18:54,940 --> 00:18:56,510
ماذا حدث للتو؟

240
00:18:56,510 --> 00:18:58,040
!أصبح قويّاً فجأة

241
00:19:03,440 --> 00:19:04,210
!يوري

242
00:19:10,470 --> 00:19:14,510
أريهم كم تحسّنتْ مهاراتكِ بالسّيف

243
00:19:14,800 --> 00:19:15,600
حسناً

244
00:19:30,060 --> 00:19:33,320
إ-إنّها قويّة أيضاً. احذروا

245
00:19:33,790 --> 00:19:36,590
تعلّمتُ القتالَ وذلك كي أكون
نافعة للأمير كايل

246
00:19:37,130 --> 00:19:41,700
،يجب أن أحذّره بشأن هذا الهجوم
ما يعني بأنّه لا يمكن أن أموت هنا

247
00:19:45,400 --> 00:19:46,770
مـ-مهلاً

248
00:19:48,180 --> 00:19:49,710
!انسحبوا

249
00:19:54,200 --> 00:19:55,700
لديّ سؤال لك

250
00:19:56,970 --> 00:19:57,800
تكلّم

251
00:19:59,590 --> 00:20:03,610
كم جنديّ ميتانّي قد أُرسِلَ إلى هنا؟

252
00:20:03,610 --> 00:20:05,560
لـ-لن أُخبرك

253
00:20:07,340 --> 00:20:10,900
لا تحتاج النّساء رجلاً بلا أنف

254
00:20:10,900 --> 00:20:15,110
لـ-لدينا 5000 جنديّ مُشاة. و-و 500 عربة

255
00:20:15,110 --> 00:20:17,950
من هو القائد الأعلى لذلك الجيش؟

256
00:20:17,950 --> 00:20:21,200
نـ-نحن بقيادة أمير الظّلام

257
00:20:21,740 --> 00:20:23,450
أمير الظّلام؟

258
00:20:24,350 --> 00:20:25,290
من؟

259
00:20:28,490 --> 00:20:32,790
اسمه الحقيقيّ ماتّيوازا، وليّ عهد ميتانّي

260
00:20:33,270 --> 00:20:35,800
،إنّه معروف بالبطش

261
00:20:35,800 --> 00:20:38,550
فهو يذبح الرّجال والنّساء والأطفال
على حدٍّ سواء

262
00:20:38,550 --> 00:20:42,340
ومسارات عربته هي عِبارة
عن أنهار من الدِّماء

263
00:20:42,680 --> 00:20:47,940
لهذا يُطلق عليه النّاس بأمير
الظّلام الدّامي

264
00:20:50,120 --> 00:20:52,940
الأمير هو القائد الأعلى لميتانّي

265
00:20:52,940 --> 00:20:57,330
،بما أنّه هنا في هذه المعركة الأولى
فهذا يُثبت عزيمته

266
00:20:57,830 --> 00:21:00,360
،إذا سمحنا بسقوط كيزّواتنا

267
00:21:01,230 --> 00:21:05,160
فستُهاجم ميتانّي مركزَ هيتّايتي

268
00:21:06,880 --> 00:21:08,500
!يا للهول