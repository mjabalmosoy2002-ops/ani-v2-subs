1
00:00:02,100 --> 00:00:03,880
،هذه هاتّوسا

2
00:00:04,370 --> 00:00:08,900
عاصمة إمبراطوريّة هيتّايتي في القرن
الرّابع عشر قبل الميلاد

3
00:00:10,590 --> 00:00:16,080
هذه قصّة فتاة تركب الرّياح الحارّة الرّطبة

4
00:00:16,650 --> 00:00:18,840
عبر مسافات الأناضول الواسعة

5
00:00:27,350 --> 00:00:31,240
تهبُّ رياحٌ عاتية، لتحمل معها الرّمال الجافّة

6
00:00:33,220 --> 00:00:34,970
،تهبُّ الرّياح ساخنة

7
00:00:35,730 --> 00:00:37,760
،وأنا أعيش تحت هذه السّماء

8
00:00:38,180 --> 00:00:42,520
النّهر الأحمر

9
00:00:38,400 --> 00:00:40,960
على ضفاف النّهر الأحمر

10
00:02:05,980 --> 00:02:10,990
تحت شجرة التّفّاح

11
00:02:07,540 --> 00:02:09,360
تحت شجرة التّفّاح

12
00:02:24,330 --> 00:02:27,330
لا يوجد تراجُع

13
00:02:30,070 --> 00:02:32,100
...لكن إذا تقدّمنا أكثر

14
00:02:33,320 --> 00:02:35,260
رسالة لجلالته

15
00:02:35,790 --> 00:02:39,970
سعر الحبوب قد حلّق، ليُسبّب
استياء في كافّة الأسواق

16
00:02:39,970 --> 00:02:43,850
حبوب؟ لكن طلبنا ما يكفي للاستيراد

17
00:02:44,100 --> 00:02:49,230
أجل، لكن لم يصلنا أي قافِلة من بلاد
ما بين النّهرين منذ شهر

18
00:02:49,230 --> 00:02:50,820
أيُعقَل هذا؟

19
00:02:50,820 --> 00:02:55,240
تلقّينا إشعارات بالمُغادرة من تلك
القوافل، أليس كذلك؟

20
00:02:55,240 --> 00:03:00,740
أجل، سموّك. لكن جميعها اختفتْ
لدى وصولها إلى الأناضول الشّرقيّة

21
00:03:01,060 --> 00:03:03,890
لِمَ لا تُرسلون جنوداً على الفور؟

22
00:03:03,890 --> 00:03:06,120
تلك المنطقة تحدُّ مملكةَ ميتانّي

23
00:03:06,470 --> 00:03:08,640
،إذا كانت القوافل تختفي

24
00:03:08,640 --> 00:03:13,430
فهذا يعني بأنّ الميتانّي يسرقون بضاعتنا
المُستورَدة دون رادع

25
00:03:13,430 --> 00:03:15,130
حـ-حسناً

26
00:03:15,130 --> 00:03:17,260
!جِدوا تلك القوافل حالاً

27
00:03:17,990 --> 00:03:19,400
!حـ-حاضر

28
00:03:20,390 --> 00:03:24,520
ما الّذي أصابَ الملِكة؟ كانت
أكثر غضباً من المعتاد

29
00:03:24,920 --> 00:03:28,940
كان بالها مشغولاً بسؤال وهو
مَن سيتبوّأ العرش

30
00:03:28,940 --> 00:03:31,190
...إذا كان هذا مُرتبطاً بهذه المُشكلة

31
00:03:31,530 --> 00:03:36,400
فهذا يعني أنّ شيئاً مُتّصلاً بالعرش
له علاقة بتلك القوافل

32
00:03:36,400 --> 00:03:39,960
،إذا كانت ترسم خطّةً أخرى
فلا يمكننا أن نغضّ الطّرف

33
00:03:39,960 --> 00:03:41,080
لنُحقِّق في المسألة

34
00:03:41,510 --> 00:03:43,030
...ويا زانّانزا

35
00:03:51,750 --> 00:03:56,350
زانّانزا، كُن مُستعدّاً للردّ إذا
قام الميتانّي بالتّعبئة

36
00:03:56,350 --> 00:03:57,270
حاضر

37
00:04:00,140 --> 00:04:04,380
ألم يتصل الأمير كايل ويوري-ساما بعد؟

38
00:04:04,380 --> 00:04:06,130
ازداد الأمر سوءاً

39
00:04:15,150 --> 00:04:19,150
هل سيبقى الأمير كايل في قصر
الملك ثانية اللّيلة؟

40
00:04:19,460 --> 00:04:21,980
إنّه مشغولٌ يوميّاً بمجلس الحرب

41
00:04:21,980 --> 00:04:25,180
ويبدو أنّ الملِكة تُخطّط لمزيد من الأمور

42
00:04:25,180 --> 00:04:26,660
أتعتقدنَ ذلك حقّاً؟

43
00:04:27,820 --> 00:04:29,260
يوري-ساما

44
00:04:29,260 --> 00:04:31,960
هل الملِكة تُخطّط لشيء ثانية؟

45
00:04:31,960 --> 00:04:33,420
أجل

46
00:04:33,420 --> 00:04:38,220
وفقاً لكيكّوري، أرسلَتْ للسّؤال
عن شيء من بابل

47
00:04:38,220 --> 00:04:39,500
للسّؤال عن ماذا؟

48
00:04:39,500 --> 00:04:42,720
ما كان قد اختفى مع القافلة

49
00:04:43,130 --> 00:04:46,470
صرخَتِ الملكةُ في وجه الجنود للبحث عنه

50
00:04:48,100 --> 00:04:51,990
يوري-ساما، يجدر بنا أن نقدّم
وجبةَ طعام للأمير كايل

51
00:04:51,990 --> 00:04:52,850
ماذا؟

52
00:04:52,850 --> 00:04:56,570
ترغبين في التحدُّث معه حول
مُخطَّط الملِكة، صحيح؟

53
00:04:56,570 --> 00:04:58,270
...بـ-بالتّأكيد، لكن

54
00:04:58,270 --> 00:04:59,800
هذا ليس كُلّ شيء

55
00:04:59,800 --> 00:05:02,600
سيشعر الأمير كايل بسعادة غامرة

56
00:05:02,600 --> 00:05:03,940
...لـ-لكنّني

57
00:05:03,940 --> 00:05:06,620
أجل، بينما تتكلّمان عن الملِكة

58
00:05:09,130 --> 00:05:11,490
ما زال الأمير كايل في مجلس الحرب

59
00:05:11,490 --> 00:05:12,580
هلّا سمعتنّني؟

60
00:05:12,580 --> 00:05:14,460
أجل، أجل. نحن نُقدّم طعاماً فحسب

61
00:05:14,460 --> 00:05:17,250
هيّا. لننتظر في قاعة الاستقبال خاصّته

62
00:05:22,440 --> 00:05:24,910
أليس هذا أحد رجال الملِكة؟

63
00:05:26,760 --> 00:05:29,000
يوري-ساما، من هنا

64
00:05:30,190 --> 00:05:31,480
يوري-ساما؟

65
00:05:32,980 --> 00:05:37,940
نعلم بأنّ ملاطية تُمثّل القاعدة
الأماميّة للميتانّي

66
00:05:37,940 --> 00:05:40,940
لذلك، يجب علينا إرسال جنود إلى المدينة

67
00:05:41,620 --> 00:05:46,060
الأمير الثّالث كايل مورسيلي، آمرك
بقيادة قوّات الطّليعة

68
00:05:46,060 --> 00:05:46,950
حاضر

69
00:05:46,950 --> 00:05:50,690
الأمير الرّابع زانّانزا هاتّوسيلي، سوف
تقود الفيلقَ الثّاني

70
00:05:50,690 --> 00:05:51,620
حاضر

71
00:05:51,620 --> 00:05:54,550
،سيبقى وليّ العهد في هاتّوسا

72
00:05:54,550 --> 00:05:58,540
والأُمراء الآخرون سيبقون مُتأهِّبين
للزّحف إلى ساحة المعركة

73
00:05:58,540 --> 00:05:59,440
جلالتك

74
00:06:00,380 --> 00:06:04,890
يبدو عدد الجنود هذا كبير جدّاً
على مُهاجمة ملاطية ببساطة

75
00:06:04,890 --> 00:06:06,090
معك حقّ

76
00:06:06,090 --> 00:06:09,890
هدفُنا ليس إخضاع مدينة الحصن ملاطية فقط

77
00:06:09,890 --> 00:06:12,230
إنّما إبادة مملكة ميتانّي بحدّ ذاتها

78
00:06:13,540 --> 00:06:17,060
،تناوشنا بشكل مُتكرّر مع الميتانّي

79
00:06:17,060 --> 00:06:21,150
لكن الآن بعد أن امتلكنا القوّة، هذه
هي فُرصتنا لحسم الصِّراع نهائيّاً

80
00:06:21,520 --> 00:06:23,530
لا يهمّني كم سنة سيستغرق ذلك

81
00:06:23,530 --> 00:06:28,260
سنُرسل ملِك الميتانّي، توشراتّا، مُباشرة
نحو إله العالم السُّفليّ، نيرغال

82
00:06:29,120 --> 00:06:31,250
لا تعودوا حتّى يتحقّق ذلك

83
00:06:31,590 --> 00:06:33,390
قد يستغرق ذلك سنوات؟

84
00:06:33,710 --> 00:06:36,080
سأزحف أيضاً نحو ساحة المعركة

85
00:06:36,770 --> 00:06:38,500
!الملِك سيقودنا

86
00:06:41,590 --> 00:06:45,970
الأمير كايل، تهانينا قيادة بعثة الملِك

87
00:06:47,470 --> 00:06:52,230
في صفِّنا عشتار أيضاً، لذا
سيكون نصرنا مضموناً

88
00:06:53,860 --> 00:06:55,060
!الأمير كايل

89
00:06:55,840 --> 00:06:58,270
لم ترَ يوري-ساما، صحيح؟

90
00:06:58,270 --> 00:07:00,730
فقدنا أثرها

91
00:07:02,590 --> 00:07:05,840
هل اكتشفت مكانه؟

92
00:07:05,840 --> 00:07:09,450
أجل. نعلم بأنّه في قبضة الميتانّي الآن

93
00:07:09,450 --> 00:07:12,930
اللّعنة عليهم. يجب أن نستردّه

94
00:07:12,930 --> 00:07:14,120
نحن نحتاجه

95
00:07:14,120 --> 00:07:16,670
يجب أن نحصل على عين إيلّويانكا

96
00:07:16,670 --> 00:07:18,280
عين إيلّويانكا؟

97
00:07:20,540 --> 00:07:21,460
من هناك؟

98
00:07:21,460 --> 00:07:22,520
بئساً

99
00:07:35,350 --> 00:07:36,890
الأمير كايل؟

100
00:07:39,150 --> 00:07:40,350
الفأرة

101
00:07:40,730 --> 00:07:44,230
مولاتي، هل تحتاجين مُساعدة عقيلتي؟

102
00:07:44,230 --> 00:07:47,700
ما-ما أحتاجه هو أن تُبرّرا موقفكما

103
00:07:47,700 --> 00:07:51,450
لماذا تتسكّع عقيلتُك في هذا المكان؟

104
00:07:51,750 --> 00:07:55,870
لأنّني أخبرتُها أن تأخذ مخزوناً
من متاجر الحبوب المُتبقّية

105
00:07:56,430 --> 00:07:59,540
نحتاج حصصاً كافية لحملتنا العسكريّة

106
00:08:01,020 --> 00:08:02,620
هل من مُشكلة؟

107
00:08:03,500 --> 00:08:06,490
يمكنكِ الانصراف يا مولاتي

108
00:08:07,260 --> 00:08:12,480
سيكون من غير اللّائق أن تتواجد
كاهنة بالقرب من سيف مسحوب

109
00:08:24,190 --> 00:08:25,240
سموّ الأمير

110
00:08:25,700 --> 00:08:27,280
الأمير كايل

111
00:08:32,230 --> 00:08:34,030
عين إيلّويانكا؟

112
00:08:34,430 --> 00:08:37,040
أرسلَتِ الملكةُ للسّؤال عن ذلك بالتّحديد؟

113
00:08:37,040 --> 00:08:39,790
لم أعلم بأنّه موجود فعلاً

114
00:08:39,790 --> 00:08:42,790
مهلاً. ما هي عين إيلّويانكا؟

115
00:08:43,240 --> 00:08:45,880
طلسم أسطوريّ ثمين

116
00:08:46,240 --> 00:08:53,390
من يحمله يستطيع التحكُّم بعقول
وأجساد كافّة النّاس

117
00:08:53,390 --> 00:08:55,300
تحكُّم عقليّ؟

118
00:08:55,300 --> 00:08:59,140
تسعى الملكةُ للتحكُّم بالإمبراطوريّة بواسطته؟

119
00:08:59,140 --> 00:09:01,730
لكن يُقال بأنّ الميتانّي يمتلكونه الآن

120
00:09:01,730 --> 00:09:03,210
الميتانّي؟

121
00:09:03,210 --> 00:09:05,320
الأمر أسوأ إن امتلكوه

122
00:09:05,680 --> 00:09:09,070
يبدو أنّ حملتنا لديها هدفٌ جديد

123
00:09:09,420 --> 00:09:12,540
تقصد بأنّنا سنبحث عن عين إيلّويانكا؟

124
00:09:12,540 --> 00:09:15,540
إذاً يجب علينا الحرص على إيجادها

125
00:09:15,540 --> 00:09:17,290
لا يمكننا السّماح للملكة بالحصول عليها

126
00:09:17,550 --> 00:09:19,780
إذاً يجدر بنا أن نستعدّ للزّحف

127
00:09:19,780 --> 00:09:20,540
أجل

128
00:09:20,540 --> 00:09:24,590
لا، لن آخذك في هذه الحملة

129
00:09:24,590 --> 00:09:26,500
ستبقين في هاتّوسا

130
00:09:27,490 --> 00:09:30,630
لكن لماذا؟ خذني معك يا سموّ
الأمير كايل

131
00:09:31,020 --> 00:09:34,320
ستكون هذه الحرب مُختلفة عمّا سبق

132
00:09:34,320 --> 00:09:37,810
لن أعود حتّى تُدمَّر ميتانّي

133
00:09:38,190 --> 00:09:40,430
قد تستغرق هذه الحرب سنوات لتنتهي

134
00:09:40,850 --> 00:09:42,230
سنوات؟

135
00:09:42,530 --> 00:09:43,600
يوري

136
00:09:43,600 --> 00:09:47,190
ستعودين إلى عائلتكِ في غضون
العام المُقبل

137
00:09:47,190 --> 00:09:53,240
خلال عشرة أشهر، ينبغي أن تكون الينابيع
مُمتلئة تحت نجم الصّباح

138
00:09:54,030 --> 00:09:57,450
هناك رجال دين رفيعو المرتبة
غيري أنا والملِكة

139
00:09:57,830 --> 00:10:00,620
ستتمكّنين من العودة دون حضوري

140
00:10:00,620 --> 00:10:03,210
دون حضورك؟

141
00:10:03,480 --> 00:10:08,460
لا تخافي. أنتِ قادرة على مُقاومة الملكة الآن

142
00:10:08,780 --> 00:10:10,950
سأعيّن حُرّاساً أقوياء لأجلكِ أيضاً

143
00:10:12,990 --> 00:10:14,270
لا، خذني معك

144
00:10:14,950 --> 00:10:16,850
!أريد أن أكون معك

145
00:10:18,350 --> 00:10:22,390
أجل، أريد العودة إلى عائلتي

146
00:10:22,770 --> 00:10:26,770
لكنّك أنت من يجعل الحياة هنا
جديرة بالحياة

147
00:10:27,230 --> 00:10:30,530
لا أريد أن أُبقى في هاتّوسا من دونك

148
00:10:38,220 --> 00:10:41,630
ستبقين هنا ثمّ تعودين إلى عائلتكِ

149
00:10:43,210 --> 00:10:46,430
!يا أمير! سموّ الأمير كايل

150
00:10:46,430 --> 00:10:49,280
!لا! خذني معك

151
00:10:50,750 --> 00:10:52,110
يوري-ساما

152
00:11:01,550 --> 00:11:02,880
يوري-ساما

153
00:11:05,960 --> 00:11:10,370
أنتن. أنا آسفة لأنّني أحدثتُ جلبةً هناك

154
00:11:10,370 --> 00:11:11,480
لا عليكِ

155
00:11:11,990 --> 00:11:15,900
سأكون بخير. سأفعل ما قاله الأمير

156
00:11:16,390 --> 00:11:18,700
معه حقّ في نهاية المطاف

157
00:11:19,040 --> 00:11:23,090
سيترتّب عليّ البقاء هنا وانتظار نجم الصّباح

158
00:11:25,580 --> 00:11:30,750
هادي، هل تعتقدين بأنّ الأمير
يكره جرأتي؟

159
00:11:30,750 --> 00:11:32,900
هذا مُستحيل

160
00:11:32,900 --> 00:11:35,920
يفعل هذا لأنّ سموّه يعزّكِ كثيراً

161
00:11:43,070 --> 00:11:47,890
تخلّيتُ عن يوري لأنّها تنتمي لأخي

162
00:11:49,180 --> 00:11:51,410
،لكن إذا تركَها أخي

163
00:11:51,410 --> 00:11:55,320
فيحقّ لي أن أتّخذها لنفسي

164
00:11:55,320 --> 00:11:57,020
الأمير زانّانزا؟

165
00:11:57,020 --> 00:12:00,250
كيكّوري، هلّا نقلت هذه الرّسالة إلى أخي؟

166
00:12:05,470 --> 00:12:06,740
!الأمير كايل

167
00:12:07,370 --> 00:12:08,520
ما الأمر؟

168
00:12:08,520 --> 00:12:11,820
صرّحَ الأميرُ زانّانزا بأنّه سيتملّك يوري-ساما

169
00:12:11,820 --> 00:12:15,550
قال بأنّه سيفعل ذلك بمحض
إرادته هذه المرّة

170
00:12:15,550 --> 00:12:16,430
ماذا؟

171
00:12:16,430 --> 00:12:17,800
!الأمير كايل

172
00:12:19,460 --> 00:12:23,560
أمسكَ الأمير زانّانزا يوري-ساما
وحملَها بعيداً

173
00:12:24,630 --> 00:12:27,020
كيكّوري، إلى أين هربَ زانّانزا؟

174
00:12:27,020 --> 00:12:28,750
سـ-سأخبرك

175
00:12:28,750 --> 00:12:32,110
قال بأنّه سيعود لفترة وجيزة إلى
كانيش قبل الحملة

176
00:12:38,360 --> 00:12:39,980
تبّاً لك يا زانّانزا

177
00:12:40,360 --> 00:12:44,370
لِمَ برأيك أترك يوري في هاتّوسا إذاً؟

178
00:12:44,620 --> 00:12:47,130
لن أتخلّى عنها لأيّ رجل

179
00:12:47,800 --> 00:12:49,260
ولا حتّى أنت

180
00:12:50,100 --> 00:12:51,300
سأقطع رأسك

181
00:12:54,140 --> 00:12:56,410
!الأمير زانّانزا، لا تفعل هذا أرجوك

182
00:12:59,500 --> 00:13:00,430
!يوري

183
00:13:03,710 --> 00:13:07,020
هذه أسرع طريقة لجمع التّفّاح

184
00:13:07,020 --> 00:13:10,730
بجدّية، توقّف. أنت تتسبّب بسقوط حشرات عليّ

185
00:13:13,540 --> 00:13:17,190
أخي. وصلتَ بشكل أسرع ممّا توقّعت

186
00:13:18,210 --> 00:13:20,780
الأمير كايل؟ ماذا تفعل هنا؟

187
00:13:20,780 --> 00:13:22,500
أتسألينني؟

188
00:13:22,820 --> 00:13:25,670
أريد أن أعرف ماذا تفعلان هنا

189
00:13:25,670 --> 00:13:26,830
أين المُشكلة؟

190
00:13:27,290 --> 00:13:30,770
دعاني الأمير زانّانزا إلى هنا لتشجيعي

191
00:13:30,770 --> 00:13:33,370
هادي والتّوأمتان قُلنَ بأنّ هذا
سيكون مُفيداً لي

192
00:13:36,930 --> 00:13:39,600
خدعتُ الأمير كايل عن قصد

193
00:13:42,770 --> 00:13:44,140
أخي

194
00:13:44,140 --> 00:13:48,450
أنا أكثر أخ مُحبَّب لك وخادمك
الأكثر أهلاً للثِّقة

195
00:13:48,450 --> 00:13:50,640
لـ-لماذا تُذكّرني بذلك الآن؟

196
00:13:50,640 --> 00:13:54,860
ومع ذلك أتيتَ مُسرِعاً إلى هنا
بنيّة قتلي إن لزم الأمر

197
00:13:55,540 --> 00:14:00,140
،إن كنت تهتمّ لامرأتك إلى هذا الحدّ
فلا تُفكِّر حتّى بتركها والرّحيل

198
00:14:02,890 --> 00:14:06,490
رغم ذلك، سأترككما تُعالجان الأمور

199
00:14:07,100 --> 00:14:08,260
بالتّوفيق

200
00:14:09,750 --> 00:14:11,270
زانّانزا؟

201
00:14:24,340 --> 00:14:29,310
ا-سمع. لا أُمانع إطلاقاً. سأبقى في هاتّوسا

202
00:14:29,310 --> 00:14:30,640
عشرة أشهر

203
00:14:31,740 --> 00:14:34,450
سأدمِّر ميتانّي في عشرة أشهر

204
00:14:34,450 --> 00:14:37,100
ماذا؟ لكن قلتَ بأنّ ذلك سيستغرق سنوات

205
00:14:37,100 --> 00:14:39,560
سأبحث عن أيّ طريقة

206
00:14:41,730 --> 00:14:43,110
...لذا يا يوري

207
00:14:43,710 --> 00:14:44,990
تعالي معي

208
00:14:46,590 --> 00:14:51,140
سنعود بعد عشرة أشهر وذلك كي
تتمكّني من العودة إلى الدّيار

209
00:14:51,590 --> 00:14:52,540
...لذا من فضلكِ

210
00:14:53,350 --> 00:14:55,040
ابقي معي

211
00:14:55,720 --> 00:14:56,810
سموّ الأمير؟

212
00:15:02,830 --> 00:15:05,450
هل أنت متأكّدٌ من هذا؟

213
00:15:06,390 --> 00:15:08,920
في الحقيقة كنتُ خائفاً

214
00:15:09,500 --> 00:15:13,150
كنتُ خائفاً من أن تُشكّلي جزءاً
كبيراً من حياتي

215
00:15:13,150 --> 00:15:15,670
لدرجة يغدو الفُراق لا يُطاق

216
00:15:16,190 --> 00:15:18,960
لكن ما دمتِ هنا، سنبقى معاً

217
00:15:21,590 --> 00:15:22,640
لن أتخلّى عنكِ

218
00:15:25,230 --> 00:15:26,720
الأمير كايل

219
00:15:47,300 --> 00:15:48,720
!مُذهل

220
00:15:49,590 --> 00:15:52,000
الجيش بأكمله يتحرّك

221
00:15:53,580 --> 00:15:54,850
يوري-ساما

222
00:15:54,850 --> 00:15:58,430
صنع أبي هذا السّيف الحديديّ لأجلكِ

223
00:16:00,680 --> 00:16:01,770
شكراً لكِ

224
00:16:02,070 --> 00:16:05,910
سينتهي موسم النّار قريباً وسيبدأ
موسم الرّياح

225
00:16:05,910 --> 00:16:09,280
سنتمكّن من صنع المزيد من الأسلحة
الحديديّة أكثر من السّابق

226
00:16:12,220 --> 00:16:17,440
يوري، هذا مُتأخّر، لكن هؤلاء هم ضُبّاطي

227
00:16:18,190 --> 00:16:21,960
أنا قائد العربات، كاش. شرف
لي أن ألتقي بكِ

228
00:16:21,960 --> 00:16:24,720
قائد المُشاة، ميتّاناموا

229
00:16:24,720 --> 00:16:26,630
يُشرّفني لقاؤكِ

230
00:16:27,040 --> 00:16:29,990
أنا قائد النبّالين. اسمي روسافا

231
00:16:29,990 --> 00:16:32,550
يسرّني التعرُّف عليكِ يا يوري-ساما

232
00:16:32,920 --> 00:16:36,290
أ-أجل، أنا أيضاً. سررتُ بلقائكم

233
00:16:38,450 --> 00:16:40,040
سيّد إيلباني؟

234
00:16:40,940 --> 00:16:42,650
هل ستأتي معنا أيضاً؟

235
00:16:42,650 --> 00:16:45,400
أجل. سأُرافقكم كمُؤرِّخ أحداث هذه الحرب

236
00:16:45,400 --> 00:16:50,630
،تحتاج الحملة الطّويلة أكثر من جنود
لذا سنُحضر طبّاخين وحِرفيّين كذلك

237
00:16:50,630 --> 00:16:52,070
هكذا إذاً

238
00:16:52,070 --> 00:16:53,310
يوري-ساما

239
00:16:53,310 --> 00:16:54,730
تعالي معنا

240
00:16:59,580 --> 00:17:03,080
إنّه باهر الجمال. من يكون؟

241
00:17:03,460 --> 00:17:06,400
يُقال بأنّ اسمه شالما. إنّه كاهن

242
00:17:06,400 --> 00:17:08,800
إنّه رجلٌ جميل

243
00:17:17,190 --> 00:17:21,060
الحملة الشّاملة فيها مُختلف
الأنواع والأشكال من النّاس

244
00:17:22,810 --> 00:17:26,780
سنكون في موقع نُحاصِر فيه
ملاطية خلال بضعة أيّام

245
00:17:26,780 --> 00:17:28,820
سنتمكّن من الهجوم بشكل فوريّ؟

246
00:17:28,820 --> 00:17:31,950
الميتانّي ماهرون في قيادة العربات

247
00:17:31,950 --> 00:17:35,210
وتضاريس المنطِقة تُناسب العربات

248
00:17:35,210 --> 00:17:37,360
سنكون فريسة لأمير الظّلام

249
00:17:37,360 --> 00:17:39,940
ما يقودنا إلى حِصار؟

250
00:17:39,940 --> 00:17:42,170
ذلك سيُطيل الحربَ كثيراً

251
00:17:43,110 --> 00:17:45,000
لن نفرض حِصاراً

252
00:17:45,590 --> 00:17:48,960
يمكننا إسقاط ملاطية في خمسة أيّام

253
00:17:50,540 --> 00:17:51,700
خمسة فقط؟

254
00:17:55,140 --> 00:18:00,640
سموّ الأمير، أعلم بأنّنا نريد العودة إلى هاتّوسا خلال
عشرة أشهر، لكن لا تستعجل الأمور رجاء

255
00:18:00,980 --> 00:18:06,560
سيكون من اللّطيف أن نستطيع
البقاء معاً لفترة أطول

256
00:18:14,100 --> 00:18:15,680
أنا لا أستعجل الأمور

257
00:18:16,140 --> 00:18:18,030
...كما وعدت، في غضون عشرة أشهر

258
00:18:18,310 --> 00:18:22,180
لا، في تسعة أشهر، سأعيدكِ إلى هاتّوسا

259
00:18:24,490 --> 00:18:27,210
تقول بأنّها تريد أن نكون معاً؟

260
00:18:27,210 --> 00:18:32,160
لحسن الحظّ، هي لا تعتقد بأنّ هذا كُلّ
ما يترتّب على محظيّة

261
00:18:32,730 --> 00:18:35,930
مهلاً. هل من الآمن النّوم هكذا حقّاً؟

262
00:18:35,930 --> 00:18:37,010
سأغتصبكِ

263
00:18:54,430 --> 00:19:00,230
أمير الظّلام، وردنا تقرير عن وجود فيلق هيتّايتي
شمال هذا المكان على بُعد مسافة يوم واحد

264
00:19:00,230 --> 00:19:01,540
كشفوا عن أنفسهم؟

265
00:19:01,540 --> 00:19:06,210
أجل. يبدو أنّ إستراتيجيّتنا بمُهاجمة القافِلات
لاستدراجهم إلى هنا قد أثمرتْ

266
00:19:07,710 --> 00:19:12,510
راياتهم أيضاً تحمل علامة الجيش
الّذي قاتلناه في كيزّوواتنا

267
00:19:12,510 --> 00:19:16,050
ماذا؟ كايل مورسيلي يقود هذا الجيش؟

268
00:19:16,050 --> 00:19:16,890
أجل

269
00:19:16,890 --> 00:19:20,900
كنتُ أنتظر خوض معركة ضدّ
ذلك الرّجل مرّة أُخرى

270
00:19:21,910 --> 00:19:23,850
حسناً. سأذهب أنا

271
00:19:24,310 --> 00:19:27,020
دانا، ستبقى أنت وتحمي هذا المكان

272
00:19:27,020 --> 00:19:28,020
حاضر

273
00:19:28,730 --> 00:19:30,270
تقرير من كشّافنا

274
00:19:30,640 --> 00:19:32,550
بدأ أمير الظّلام بالتحرُّك

275
00:19:32,550 --> 00:19:34,260
هل كُشِفَ أمرنا؟

276
00:19:34,260 --> 00:19:36,820
لا. إنّه يزحف شمالاً

277
00:19:37,990 --> 00:19:41,670
أخبرتُ زانّانزا بأن يستدرج أمير
الظّلام بعيداً من معقله

278
00:19:42,100 --> 00:19:44,540
سيُبعده لقرابة خمسة أيّام

279
00:19:46,040 --> 00:19:47,890
يجب علينا أن نتحرّك أيضاً

280
00:19:47,890 --> 00:19:53,640
أوّلاً، سأطلب من مُحافظ ملاطية استضافة
الأمير الثّالث كايل مورسيلي كضيف له

281
00:19:53,640 --> 00:19:56,070
سأذهب إلى هناك مع عدد ضئيل من الأتباع

282
00:19:56,070 --> 00:19:56,930
ماذا؟

283
00:19:57,300 --> 00:20:03,470
هُم غير مُدركين بأنّنا نعلم بأنّ الميتانّي
يستخدمون ملاطية كقاعدة أماميّة لهم

284
00:20:03,470 --> 00:20:05,180
،بابتعاد أمير الظّلام عن الطّريق

285
00:20:05,180 --> 00:20:08,940
سيُرحِّبون بي بما أنّهم لا يُريدون
إحداث جلبة

286
00:20:08,940 --> 00:20:10,440
!هذا محض هُراء

287
00:20:10,440 --> 00:20:14,150
معه حقّ! من الخطير جدّاً دخول
!المدينة من دون جيش

288
00:20:14,150 --> 00:20:18,400
،لغزو ملاطية في خمسة أيّام
نحتاج الطّعم المُناسب

289
00:20:18,400 --> 00:20:19,490
!كُن منطقيّاً

290
00:20:19,490 --> 00:20:21,160
خذني معك

291
00:20:21,460 --> 00:20:23,910
إن لم تفعل، فلن أدعك تذهب

292
00:20:24,310 --> 00:20:28,120
ستأتين بالطّبع. فأنتِ الحدث الرّئيسيّ

293
00:20:29,750 --> 00:20:34,220
ويا كيكّوري، اعترِض كُلّ مبعوث من ملاطية

294
00:20:34,630 --> 00:20:38,910
لا نريد أن يعلم أميرُ الظّلام بأنّني هناك

295
00:20:41,760 --> 00:20:47,270
حضرة المُحافظ، نحن مُمتنّون حقّاً
لضيافتك السّخيّة

296
00:20:47,270 --> 00:20:51,450
لا بُدّ أنّكما خادِما الأمير

297
00:20:51,450 --> 00:20:53,990
أتمنّى أن أُرحِّب بسموّه بحدِّ ذاته

298
00:20:53,990 --> 00:20:56,120
لنكتفِ بهذا القدر من الرّسميّات

299
00:20:56,120 --> 00:20:57,730
إيل، أرشدني للدّاخل

300
00:20:57,730 --> 00:20:59,200
حاضر، سموّك

301
00:21:02,030 --> 00:21:05,860
الأمير مورسيلي دون سِواه. من دواعي
—سروري وشرف لي أن

302
00:21:08,700 --> 00:21:11,420
سنعتبر أنفسنا في الدّيار لبعض الوقت

303
00:21:11,740 --> 00:21:12,810
يا حضرة المُحافظ

304
00:22:45,010 --> 00:22:50,010
إشارة الكفّ