1
00:00:02,100 --> 00:00:03,880
،هذه هاتّوسا

2
00:00:04,370 --> 00:00:08,900
عاصمة إمبراطوريّة هيتّايتي في القرن
الرّابع عشر قبل الميلاد

3
00:00:10,590 --> 00:00:16,080
هذه قصّة فتاة تركب الرّياح الحارّة الرّطبة

4
00:00:16,650 --> 00:00:18,840
عبر مسافات الأناضول الواسعة

5
00:00:27,350 --> 00:00:31,240
تهبُّ رياحٌ عاتية، لتحمل معها الرّمال الجافّة

6
00:00:33,220 --> 00:00:34,970
،تهبُّ الرّياح ساخنة

7
00:00:35,730 --> 00:00:37,760
،وأنا أعيش تحت هذه السّماء

8
00:00:38,400 --> 00:00:40,960
على ضفاف النّهر الأحمر

9
00:02:07,460 --> 00:02:09,150
عشتار المسلوبة

10
00:02:11,470 --> 00:02:14,290
ماذا؟ الميتانّي لديهم يوري؟

11
00:02:14,290 --> 00:02:15,110
أجل

12
00:02:15,560 --> 00:02:17,830
رأيناها تُخطَف على ظهر عربة

13
00:02:18,330 --> 00:02:19,690
يوري

14
00:02:28,250 --> 00:02:30,800
!أحضروا خيلي! سأبحث عن يوري

15
00:02:30,800 --> 00:02:32,900
!سموّك! يجب أن تبقى هنا

16
00:02:32,900 --> 00:02:35,010
!الميتانّي قد انسحبوا

17
00:02:35,010 --> 00:02:38,600
!سيكون من الحماقة مُطاردتهم
!يجب أن نثبت

18
00:02:38,600 --> 00:02:39,390
دعوني

19
00:02:39,390 --> 00:02:41,180
يوري مُلكي

20
00:02:41,180 --> 00:02:43,370
سأجدها بنفسي إن لزمَ الأمر

21
00:02:43,370 --> 00:02:44,560
الأمير كايل

22
00:02:45,480 --> 00:02:48,670
قد تنتمي يوري-ساما لك

23
00:02:48,670 --> 00:02:52,690
لكن رغم ذلك، هل تتذكّر لمن ينتمي فيلق
الـ 5000 رجل؟

24
00:02:55,010 --> 00:03:00,830
لا تنسَ بأنّك قائد طليعة الهيتّايتي

25
00:03:04,330 --> 00:03:07,490
كاش. روسافا. يمكنكما أن تفلتاني الآن

26
00:03:08,710 --> 00:03:09,590
كيكّوري

27
00:03:09,900 --> 00:03:12,660
استدعِ كافّة المسؤولين الرّفيعين

28
00:03:12,660 --> 00:03:15,650
سنحرص على استعادة النِّظام في هذه المدينة

29
00:03:15,650 --> 00:03:16,420
سموّك

30
00:03:17,530 --> 00:03:21,440
سموّك، أرسلتُ أختَي للّحاق بيوري-ساما

31
00:03:21,840 --> 00:03:26,910
نُقسم بأن نحميها ولو على حساب
أرواحنا، لذا اطمئنّ

32
00:03:27,390 --> 00:03:28,360
شكراً لكِ

33
00:03:29,770 --> 00:03:30,860
هيّا

34
00:03:31,540 --> 00:03:33,460
المزيد من الغنائم لنا

35
00:03:33,460 --> 00:03:35,880
انحرفت هؤلاء الفتيات عن الهيتّايتي

36
00:03:35,880 --> 00:03:37,180
عمل ممتاز

37
00:03:37,180 --> 00:03:38,490
لا تلمسوهن

38
00:03:38,490 --> 00:03:40,160
كي لا يفقدنَ قيمتهن

39
00:03:40,160 --> 00:03:41,620
أجل، أجل، أعلم

40
00:03:43,800 --> 00:03:44,830
الأمير كايل

41
00:03:44,830 --> 00:03:47,380
لا تغضب رجاء

42
00:03:47,380 --> 00:03:51,590
النّساء اللّواتي يؤسرنَ بواسطة جيش
عدائيّ يُبعنَ كعبيد عادةً

43
00:03:51,590 --> 00:03:55,560
ينبغي أن تكون يوري-ساما لا تزال
على قيد الحياة

44
00:03:56,340 --> 00:03:57,790
أعلم ذلك

45
00:03:58,220 --> 00:04:02,850
لا أستطيع قبول بيع يوري
لرجل آخر والعيش معه

46
00:04:02,850 --> 00:04:05,790
ما دامت تتنفّس. أستطيع استرجاعها

47
00:04:06,710 --> 00:04:12,980
لكن إذا اكتشفوا بأنّها محظيّتي
...أو بأنّها عشتار من الهيتّايتي

48
00:04:14,660 --> 00:04:17,510
فسوف يستهدفها أميرُ الظّلام

49
00:04:20,360 --> 00:04:21,450
سموّ الأمير كايل؟

50
00:04:28,780 --> 00:04:29,640
كيكّوري

51
00:04:30,580 --> 00:04:33,020
سنزحف نحو واسّوغانّي

52
00:04:33,020 --> 00:04:35,090
!أبلغ أبي

53
00:04:35,430 --> 00:04:36,960
حـ-حاضر، سموّك

54
00:04:44,470 --> 00:04:47,910
سموّك، سمعتُ بإشاعة غريبة للتو

55
00:04:47,910 --> 00:04:49,160
ما هي؟

56
00:04:49,160 --> 00:04:54,670
سمعتُ بأنّ محظيّةً مولعٌ مورسيلي بها
موجودة بين النّساء اللّواتي أسرناهن

57
00:04:54,670 --> 00:04:58,490
يُقال أيضاً بأنّ هذه المحظيّة تُعبَد
كعشتار بواسطة النّاس

58
00:04:59,110 --> 00:05:00,740
أتقول عشتار؟

59
00:05:00,740 --> 00:05:01,770
أجل

60
00:05:01,770 --> 00:05:06,140
،عندما طردَ أهل المدينة رجالَنا من كيزّوواتنا

61
00:05:06,140 --> 00:05:09,250
يُزعَم بأنّ المحظيّة هي مَن ألهمتهم

62
00:05:09,630 --> 00:05:11,260
كم هذا مُثير للاهتمام

63
00:05:11,260 --> 00:05:13,380
أحضر كافّة النّساء إليّ

64
00:05:14,240 --> 00:05:16,950
قالوا بأنّ علينا إحضار النّساء

65
00:05:16,950 --> 00:05:18,880
الأمير يأمر بذلك. تحرّك

66
00:05:19,190 --> 00:05:22,470
ماذا الآن؟ يبحثون عن يوري-ساما

67
00:05:23,080 --> 00:05:28,380
.شالا، يجب علينا خلع ملابسها
إنّها مُبهرَجة جدّاً

68
00:05:28,380 --> 00:05:29,270
حسناً

69
00:05:34,210 --> 00:05:35,400
يوري-ساما

70
00:05:36,500 --> 00:05:39,150
شالا؟ أين عين إيلّويانكا؟

71
00:05:39,150 --> 00:05:42,200
اهدئي، أو سيسمعكِ الميتانّي

72
00:05:43,060 --> 00:05:48,480
محظيّة الأمير كايل مورسيلي من الهيتّايتي
موجودة بينكن

73
00:05:48,480 --> 00:05:50,540
من يدلّنا إليها؟

74
00:05:51,390 --> 00:05:55,010
هذا أمر من الأمير ماتّيوازا. يجب عليكِ الاعتراف

75
00:05:55,010 --> 00:05:57,460
أُسِرتُ بواسطة أمير الظّلام؟

76
00:05:57,460 --> 00:05:59,550
لم تعثروا عليها بعد؟

77
00:06:01,510 --> 00:06:03,630
أعتذر، سموّك

78
00:06:06,750 --> 00:06:09,090
هذا هو أمير الظّلام إذاً

79
00:06:09,950 --> 00:06:11,240
سموّك

80
00:06:11,600 --> 00:06:15,690
هلّا أخذتَني بدلاً من محظيّة رجل آخر؟

81
00:06:15,690 --> 00:06:17,600
إذاً، يجدر بك أن تختارني

82
00:06:17,600 --> 00:06:20,610
أتمنّى أن أكون جزءاً من نسائك

83
00:06:22,570 --> 00:06:23,900
!لـ-لا، لا تفعلا

84
00:06:24,330 --> 00:06:25,450
سموّك؟

85
00:06:37,250 --> 00:06:40,140
لا أُعاني من نقص في النذساء

86
00:06:40,140 --> 00:06:45,010
أنا لا أبحث عن امرأة مورسيلي لأجعلها
تُشاركني السّرير

87
00:06:45,010 --> 00:06:47,310
أحضروا النّساء اللّواتي يرتدين ملابسَ فاخرة

88
00:06:47,310 --> 00:06:48,050
حالاً

89
00:06:54,640 --> 00:06:56,860
أنتِ أيضاً. تعالي

90
00:06:56,860 --> 00:06:57,790
!ريوي

91
00:06:58,700 --> 00:07:02,670
لا تقلقي. يمكننا إخراج أنفسنا من أيّ ورطة

92
00:07:11,700 --> 00:07:15,290
زيّ أرجوانيّ؟ قيّمة جدّاً بالفعل

93
00:07:15,290 --> 00:07:17,990
القليل يرتدون مثل هذا اللّباس

94
00:07:35,180 --> 00:07:36,730
ماذا تفعل؟

95
00:07:37,100 --> 00:07:41,400
!أختي الصُّغرى هي مُجرّد فتاة ريفيّة
!أعفُ عنها أرجوك

96
00:07:42,900 --> 00:07:47,240
إنّها خفيفة، لكن أشتمّ رائحة
لُبان في شعرها

97
00:07:47,240 --> 00:07:49,570
لا بُدّ أنّها رائحة رجل عليها

98
00:07:50,280 --> 00:07:56,060
في هذا العالم، الرّجال الوحيدون الّذين
يستطيعون تقبُّل اللُبان

99
00:07:56,060 --> 00:07:58,420
هم أحد أُمراء الهيتّايتي

100
00:07:58,420 --> 00:08:00,360
رائحة الأمير كايل عليّ؟

101
00:08:03,920 --> 00:08:07,450
لا بُدّ أنّكِ امرأة كايل مورسيلي

102
00:08:07,450 --> 00:08:10,090
لا أعتقد بأنّكِ عشتار

103
00:08:10,090 --> 00:08:13,650
كافّة الهيتّايتي سيعلمون بأنّهم ضُلِّلوا

104
00:08:13,650 --> 00:08:16,880
حالما أعدمكِ في أنسب ساحة

105
00:08:28,560 --> 00:08:30,740
!اهدأ واتبعني

106
00:08:31,620 --> 00:08:33,190
تـ-تبّاً لهذا الحيوان

107
00:08:38,000 --> 00:08:40,080
لماذا أنت هادئ الآن؟

108
00:08:40,460 --> 00:08:41,630
أصلان؟

109
00:08:41,920 --> 00:08:44,630
لا بُدّ أنّهم أسروه في وسط المعركة

110
00:08:45,120 --> 00:08:46,540
تمّ أسره أيضاً؟

111
00:08:46,960 --> 00:08:47,880
شالا؟

112
00:08:48,230 --> 00:08:52,080
أ-أنا بخير. تعثّرتُ فحسب

113
00:08:52,080 --> 00:08:53,890
!أنت، انهض

114
00:08:56,400 --> 00:08:58,580
أريد... ماء

115
00:09:01,090 --> 00:09:03,770
!ما المُشكلة؟ تحرّك

116
00:09:04,220 --> 00:09:10,280
!توقّفوا! لم نشرب ماء منذ مُغادرة ملاطية
!لذا من الطّبيعيّ ألّا يستطيع المشي

117
00:09:10,280 --> 00:09:12,610
لا تهتمّوا لأمره. اقتلوه

118
00:09:13,160 --> 00:09:15,060
يمكن التخلُّص من الأسرى

119
00:09:15,060 --> 00:09:19,500
أولئك الّذين لا يستطيعون العمل لن نأخذهم
معنا. لذا اقتلوه

120
00:09:19,870 --> 00:09:20,710
حالاً

121
00:09:21,920 --> 00:09:22,930
لا تفعل

122
00:09:24,050 --> 00:09:25,680
هذا فظيع

123
00:09:25,680 --> 00:09:28,290
كان بمقدورك أن تُقدّم له ماء مثلما طلب

124
00:09:28,290 --> 00:09:31,240
حينئذ يستطيع النّهوض والمشي

125
00:09:31,680 --> 00:09:33,260
لماذا تفعل ذلك؟

126
00:09:33,260 --> 00:09:35,180
هكذا أفضل

127
00:09:35,180 --> 00:09:37,640
استمتعَ بميتةٍ سريعة

128
00:09:38,810 --> 00:09:43,890
الأسرى الّذين ينجون ليتمّ بيعهم في المزاد
جميعهم يقولون نفس الكلام

129
00:09:43,890 --> 00:09:46,320
"ليتني كنتُ ميّتاً"

130
00:09:48,990 --> 00:09:51,860
هذه واسّوغانّي، عاصمة مملكة ميتانّي

131
00:09:52,320 --> 00:09:55,030
هل هذه الطّفلة الهزيلة عشتار؟

132
00:09:55,030 --> 00:09:59,930
هذا لا يُصدَّق. إن كان كذلك، فلا بُدّ
أنّ الأمير هيتّايتي مجنون

133
00:10:02,590 --> 00:10:07,090
بالفعل. يبدو أنّ كايل مورسيلي لديه
ذوق غريب في النِّساء

134
00:10:07,090 --> 00:10:11,150
محاربٌ عظيمٌ مثله أمامه تشكيلة
واسعة من الحسناوات

135
00:10:11,150 --> 00:10:15,100
لا. الرّجل الّذي يُقدّس عشتار
مُزيّفة للفوز في المعارك

136
00:10:15,100 --> 00:10:17,180
لا يمكن أن يُدعى بمُحارب

137
00:10:17,460 --> 00:10:20,600
لا يحتاج الأمير عشتاراً للفوز

138
00:10:20,600 --> 00:10:24,350
إذاً كان مُجرّد عذر لإبقائكِ جواره؟

139
00:10:24,350 --> 00:10:26,810
كنتُ أنا من أراد أن أكون معه

140
00:10:26,810 --> 00:10:29,520
هل انجذبتِ لنفوذه وثروته؟

141
00:10:29,520 --> 00:10:33,490
،لا. أريد فقط أن أكون مع الأمير كايل
وهذا ما في الأمر

142
00:10:35,450 --> 00:10:37,990
تريدين العودة إلى مورسيلي؟

143
00:10:38,970 --> 00:10:40,200
...في الواقع

144
00:10:41,080 --> 00:10:43,210
إذاً انجي من المُحاكمة

145
00:10:43,620 --> 00:10:48,200
إذا تمكّنتِ من النّجاة، فسوف ألبّي أُمنيتكِ

146
00:10:49,460 --> 00:10:50,690
!اقتلوها

147
00:10:50,690 --> 00:10:52,530
!اقتلوا تلك الفتاة

148
00:10:52,530 --> 00:10:56,080
!مُحال أن تُؤكَل عشتار الحقيقيّة حيّة

149
00:10:58,720 --> 00:10:59,600
يوري-ساما

150
00:10:59,600 --> 00:11:00,260
عشتار المُقدّسة

151
00:11:00,260 --> 00:11:01,070
ستكون بخير

152
00:11:01,070 --> 00:11:02,720
يوري-ساما ستكون بخير

153
00:11:01,070 --> 00:11:03,730
أصلّي لأجلكِ يا عشتار

154
00:11:04,110 --> 00:11:06,650
لا يمكنني الموت. ليس هنا

155
00:11:18,230 --> 00:11:22,120
يجب عليّ العودة إلى الأمير. لذا
لا يمكنني الموت هنا

156
00:11:40,010 --> 00:11:41,260
هل هذا الحيوان مجنون؟

157
00:11:41,260 --> 00:11:42,640
!أمسكوا به

158
00:11:45,810 --> 00:11:46,730
!أصلان

159
00:11:50,760 --> 00:11:52,670
ارموا تلكما الفتاتين في الحفرة

160
00:11:52,670 --> 00:11:53,360
حاضر

161
00:11:57,250 --> 00:11:58,910
ريوي. شالا

162
00:11:58,910 --> 00:12:00,190
!أصلان

163
00:12:19,270 --> 00:12:20,720
!يوري-ساما

164
00:12:21,180 --> 00:12:23,310
سمعتُ الأسطورة

165
00:12:23,310 --> 00:12:25,530
،عشتار تُروّض أسداً

166
00:12:25,530 --> 00:12:29,280
،وتُصادف الإلَهتين التّوأمتين، نيناتّا وكوليتّا

167
00:12:29,280 --> 00:12:31,860
وتزحف تحت الشّمس المُشرِقة

168
00:12:32,130 --> 00:12:34,520
!تحيا يوري-ساما-
!عشتار-

169
00:12:44,740 --> 00:12:48,260
لماذا يهتف شعبُنا لهذه العذراء؟

170
00:12:48,260 --> 00:12:49,310
!توقّفوا عن هذا

171
00:12:49,310 --> 00:12:50,140
لا

172
00:12:50,920 --> 00:12:52,960
شعبُنا يُقدِّر الشّجاعة

173
00:12:53,390 --> 00:12:55,300
إنّ قمعهم سيُشعل تمرُّداً

174
00:12:55,590 --> 00:12:56,940
!أمير الظّلام

175
00:12:57,600 --> 00:13:01,680
وعدتَ بأن تُحقِّق لي أُمنيتي
إذا نجوت، أليس كذلك؟

176
00:13:02,590 --> 00:13:06,490
بالفعل. وهو إعادتكِ إلى مورسيلي، صحيح؟

177
00:13:06,940 --> 00:13:09,100
عظيم. يمكنكِ المُغادرة

178
00:13:09,680 --> 00:13:13,360
لا. أُمنيتي هي أن تُعامل الأسرى بشكل أفضل

179
00:13:14,310 --> 00:13:18,010
لا تُعامل الهيتّايتي الّذين أسرتَهم كحيوانات

180
00:13:18,010 --> 00:13:20,930
احرص على أن توفير الطّعام والمسكن

181
00:13:20,930 --> 00:13:23,110
،لكافّة أهل الميتانّي هنا

182
00:13:23,110 --> 00:13:27,220
لن تقبلوا بأن يتمّ أسركم ومُعاملتكم
كقمامة، أليس كذلك؟

183
00:13:27,220 --> 00:13:28,390
...في الواقع

184
00:13:28,390 --> 00:13:30,210
ما كنتُ لأقبل ذلك

185
00:13:30,210 --> 00:13:31,010
أجل

186
00:13:31,010 --> 00:13:32,080
مُستحيل

187
00:13:32,080 --> 00:13:33,460
سيكون ذلك فظيعاً

188
00:13:33,460 --> 00:13:37,090
رأيت؟ حتّى مُواطنيك لا يريدون تلك المُعاملة

189
00:13:38,340 --> 00:13:41,090
عامل أسراك ككائنات بشريّة

190
00:13:41,380 --> 00:13:43,730
كان الأمير كايل ليفعل ذلك

191
00:13:45,150 --> 00:13:49,180
لِمَ لا تتمنّين الحرّية لنفسكِ؟

192
00:13:49,180 --> 00:13:52,890
لأنّني أعلم بأنّك لن تلتزم بكلامك
وتدعني أخرج سليمة

193
00:13:52,890 --> 00:13:56,820
ستقتلني حالما أخرج من المدينة
وأبتعد عن العيون المُترقِّبة

194
00:13:57,280 --> 00:14:01,330
هذه الفتاة ماهرة في الاستدراج لتقديم تنازُلات

195
00:14:01,330 --> 00:14:03,210
،عوضاً عن رغبة مُريبة ما

196
00:14:03,210 --> 00:14:08,370
تُطالب بشيء أنا مُضطرّ لاحترامه بما أنّه
يوجد عددٌ لا يُحصَى من الشّهود

197
00:14:08,760 --> 00:14:11,420
هل هذا مُجرّد تبجُّح منها؟

198
00:14:11,420 --> 00:14:12,740
...أم أنّها فعلاً

199
00:14:15,150 --> 00:14:18,840
فليكُن. سأحترم أُمنيتكِ

200
00:14:20,000 --> 00:14:21,040
!يوري-ساما

201
00:14:21,040 --> 00:14:21,940
!عشتار

202
00:14:21,940 --> 00:14:23,640
!تحيا عشتار

203
00:14:24,750 --> 00:14:29,140
ماذا الآن؟ إنّهم يستمرّون في تعظيم
فتاة الهيتّايتي هذه

204
00:14:29,140 --> 00:14:30,820
لسنا بحاجة للاستعجال

205
00:14:30,820 --> 00:14:32,180
،إن كانوا يؤمنون بها

206
00:14:32,180 --> 00:14:36,140
فسوف نستغلّ "عشتار" هذه ببساطة
لتحقيق مآربنا الشّخصيّة

207
00:14:39,930 --> 00:14:42,310
يوري-ساما، كنتِ مُدهشة للغاية

208
00:14:42,310 --> 00:14:44,320
وعظيمة إن جازَ التّعبير

209
00:14:45,670 --> 00:14:47,320
يوري-ساما؟

210
00:14:48,130 --> 00:14:49,470
كنتُ خائفة للغاية

211
00:14:50,810 --> 00:14:55,320
،كنتُ قريبة جدّاً من الصُّراخ قائلة
"أعيدوني إلى الأمير كايل"

212
00:14:56,370 --> 00:15:01,250
لا أُبالي إذا قتلوني في النّهاية. أريد
فقط أن أعود

213
00:15:01,830 --> 00:15:04,660
أريد العودة إلى الأمير كايل

214
00:15:07,690 --> 00:15:10,930
حان وقت نقلكِ إلى غرفتكِ، فخامتكِ عشتار

215
00:15:13,010 --> 00:15:18,060
يريدكِ سموُّه أن تقطني في حرَمِ نسائه

216
00:15:18,060 --> 00:15:19,890
حرَم النّساء؟

217
00:15:19,890 --> 00:15:22,580
سيجعل يوري-ساما محظيّته؟

218
00:15:22,580 --> 00:15:26,460
هذا فظيع. يوري-ساما تنتمي للأمير كايل بالفعل

219
00:15:26,460 --> 00:15:29,260
لن أذهب. ليس إلى حرَمه

220
00:15:29,260 --> 00:15:31,830
،إذا كنتِ تُفضِّلين زنزانة السّجن
فيمكنكِ البقاء

221
00:15:35,170 --> 00:15:38,210
أنا حتّى لا أريدكِ محظيّة لي بصراحة

222
00:15:38,210 --> 00:15:39,540
إذاً لماذا تفعل هذا لي؟

223
00:15:39,540 --> 00:15:45,420
ما أحتاجه هو أن تكون عشتار
جزءاً من نسائي

224
00:15:45,420 --> 00:15:48,930
سيعلم النّاس بأنّ عشتار تنتمي لي

225
00:15:48,930 --> 00:15:50,220
ماذا؟

226
00:15:50,220 --> 00:15:53,330
سننشر الأنباء إلى البلاد

227
00:15:53,330 --> 00:15:56,970
وستُعرَف ميتانّي كمملكة تحتوي على عشتار

228
00:15:56,970 --> 00:16:01,330
سيفرح المُواطنون ممّا سيُعزّز ذلك سمعتنا الدُّوليّة

229
00:16:01,330 --> 00:16:04,690
تقصد بأنّك ستنشر الأنباء إلى الهيتّايتي؟

230
00:16:04,690 --> 00:16:05,900
بكُلّ تأكيد

231
00:16:05,900 --> 00:16:09,610
هدفي النّهائيّ هي أن يسمع مورسيلي
بهذا الإنجاز

232
00:16:09,610 --> 00:16:10,820
!لا تفعل من فضلك

233
00:16:10,820 --> 00:16:13,080
!لا يجوز أن تكذب عليه بهذا الشّكل

234
00:16:13,080 --> 00:16:18,160
الأسيرات من دُول أُخرى يتحوّلن تلقائيّاً
إلى عبيد أو محظيّات

235
00:16:18,160 --> 00:16:20,130
سيفهم مورسيلي حتماً

236
00:16:20,130 --> 00:16:22,490
!أتوسّل إليك، لا تفعلها

237
00:16:22,490 --> 00:16:27,100
.سيكون كُلّ شيء على ما يُرام يا يوري-ساما
الأمير كايل يؤمن بكِ

238
00:16:27,100 --> 00:16:31,850
أجل. مهما حدث، سيحبّكِ سموُّه دوماً

239
00:16:33,050 --> 00:16:35,480
لكن لستُ أكيدة من ذلك

240
00:16:35,850 --> 00:16:38,980
لِمَ تغضبين إلى هذا الحدّ؟

241
00:16:38,980 --> 00:16:41,230
!لن تفهم أبداً شعوري

242
00:16:47,600 --> 00:16:50,820
ماذا؟ حصل أمير الظّلام على يوري-ساما؟

243
00:16:51,870 --> 00:16:53,470
أحقّاً ذلك؟

244
00:16:53,470 --> 00:16:58,540
الجنود يتحدّثون عن ذلك. قالوا بأنّ الأنباء
وردت من القافلة الآشوريّة

245
00:16:58,820 --> 00:17:02,270
على أيّ حال، يجب على الأمير كايل
ألّا يسمع بهذا

246
00:17:02,270 --> 00:17:04,290
—يجب فرض حظر نشر على الجنود

247
00:17:04,290 --> 00:17:05,860
المعلومات صحيحة؟

248
00:17:06,420 --> 00:17:10,180
يوري الآن في حرَم نساء أمير الظّلام؟

249
00:17:15,520 --> 00:17:18,850
سموّك، وصلَ مبعوث مورسيلي

250
00:17:18,850 --> 00:17:20,030
ماذا؟

251
00:17:21,470 --> 00:17:22,730
هل يُراودك فضول؟

252
00:17:25,730 --> 00:17:27,220
حسناً

253
00:17:27,220 --> 00:17:32,940
هذا سيؤدّي وظيفة التّشديد على أهل
هيتّايتي بأنّكِ محظيّتي

254
00:17:32,940 --> 00:17:35,660
يمكنكِ رؤية المبعوث معي

255
00:17:35,660 --> 00:17:39,250
...لكن إذا تكلّمتِ بطريقة غير لائقة

256
00:17:40,120 --> 00:17:43,000
فسيُكلّفكِ ذلك حياة صديقتيكِ...

257
00:17:46,960 --> 00:17:50,260
،أحمل رسالةً من أميري، كايل مورسيلي

258
00:17:50,260 --> 00:17:53,760
إلى وليّ عهد مملكة ميتانّي، ماتّيوازا

259
00:17:54,760 --> 00:18:01,020
يأمل أن تُوافق على تبادُل الأسرى بين بلدينا

260
00:18:01,020 --> 00:18:05,760
تبادُل أسرى؟ لم أسمع بشيء كهذا من قبل

261
00:18:05,760 --> 00:18:08,080
التّفاصيل مذكورة في هذه الرّسالة

262
00:18:10,450 --> 00:18:12,830
لن أتفاوض

263
00:18:12,830 --> 00:18:17,780
،أخبر مورسيلي بأنّه إذا أراد أسراه
فيجب عليه أخذهم بالقوّة

264
00:18:18,950 --> 00:18:20,120
عُلِم

265
00:18:20,540 --> 00:18:23,070
أستأذن بالانصراف إذاً

266
00:18:23,530 --> 00:18:27,670
لكن هل يمكنني تقديم احترامي
لعشتار المُقدّسة أوّلاً؟

267
00:18:29,710 --> 00:18:31,140
سأسمح لك

268
00:18:31,630 --> 00:18:33,660
لا تتلفّظي بأيّ كلمة

269
00:18:41,160 --> 00:18:42,240
يوري-ساما

270
00:18:42,820 --> 00:18:45,860
تبقين عشتارنا مهما كان العالم
الّذي أنتِ فيه

271
00:18:45,860 --> 00:18:48,610
عسى أن تُباركي لي في رحلة عودتي

272
00:18:49,100 --> 00:18:53,360
من فضلك أخبر الأمير كايل بأنّني أُحبّه

273
00:18:53,920 --> 00:18:55,860
ووحده فقط

274
00:19:00,450 --> 00:19:02,580
وضعَ شيئاً في يدي

275
00:19:03,330 --> 00:19:05,960
آمل أن تبقي بأتمّ صحّة

276
00:19:30,590 --> 00:19:33,470
إنّها رسالةٌ من الأمير كايل

277
00:19:34,280 --> 00:19:35,740
إنّها منه فعلاً

278
00:19:36,260 --> 00:19:38,870
انظري. هذا ختم سموّه

279
00:19:39,520 --> 00:19:42,290
أرسل هذه لي؟

280
00:19:44,340 --> 00:19:47,570
لكن لا أستطيع قراءة الكلمات

281
00:19:47,570 --> 00:19:49,780
اسمحي لي. سأقرأها أنا

282
00:19:49,780 --> 00:19:53,110
أنا متأكّدة بأنّه قال بأنّه سوف ينقذكِ حتماً

283
00:19:55,550 --> 00:19:56,680
ماذا؟

284
00:19:56,680 --> 00:19:58,760
لا تبدو أنّها رسالة

285
00:19:59,850 --> 00:20:01,260
ما هذا؟

286
00:20:20,120 --> 00:20:22,840
"إنّه رمز يعني، "أُحبّكِ

287
00:20:25,420 --> 00:20:28,370
أُحبّكِ. أُحبّكِ

288
00:20:29,400 --> 00:20:32,090
يوري، أُحبّكِ

289
00:20:32,530 --> 00:20:33,760
أميري

290
00:20:40,900 --> 00:20:43,590
لا تقلق. لن أستسلم

291
00:20:44,280 --> 00:20:48,500
لن أستسلم. ليس قبل أن أعود إليك

292
00:20:53,190 --> 00:20:54,570
أقبل وبكلّ سرور

293
00:20:54,880 --> 00:20:58,040
سأحرص على القضاء على تلك
الفتاة بشكل نهائيّ

294
00:20:58,460 --> 00:21:04,160
سيصبح حرَم نساء ميتانّي المثوى
الأخير للطّفل

295
00:21:04,500 --> 00:21:06,560
انقل هذا إلى أختي، ناكيا-ساما

296
00:21:07,470 --> 00:21:09,960
حالاً، ناديا-ساما