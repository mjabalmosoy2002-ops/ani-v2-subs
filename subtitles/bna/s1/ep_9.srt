1
00:00:01,040 --> 00:00:03,960
هل أنتَ مستعد للذهاب؟

2
00:00:04,310 --> 00:00:07,240
فأنت تعلم الدرب السديد

3
00:00:07,490 --> 00:00:10,820
سأمضي في دربي دون ارتياب

4
00:00:10,820 --> 00:00:13,720
فهيّا بنا إلى عالم جديد

5
00:00:27,140 --> 00:00:33,550
يحبس الجميع أنفاسهم على ذكر الآمال

6
00:00:33,720 --> 00:00:40,150
يومًا ما سألاقيك في مكانٍ يفوق الخيال

7
00:00:40,150 --> 00:00:46,730
ما من شيء سيوقفني عن الترحال

8
00:00:46,780 --> 00:00:50,050
لوّن العالم بألوانك واجعله جميلًا

9
00:00:50,050 --> 00:00:53,160
فالتغيير إن عزمنا ليس مستحيلًا

10
00:00:53,300 --> 00:00:56,600
كن نورًا يقشع ظلالًا انسدلت طويلًا

11
00:00:56,600 --> 00:00:59,940
وامضِ قدمًا ودع الحذرَ خلفك مذلولًا

12
00:01:05,190 --> 00:01:07,350
،لا تدّعي أنّكِ نبيّة

13
00:01:07,440 --> 00:01:09,400
،فأنتِ لستِ ذئبة فضيّة يا نازونا

14
00:01:09,480 --> 00:01:11,860
ما الغاية من جعل النّاس يصدّقون هذه الكذبة؟

15
00:01:12,280 --> 00:01:14,320
خصوصًا أنّ الذئب الفضيّ الحقيقيّ موجودٌ فعلًا

16
00:01:15,360 --> 00:01:16,320
وماذا في هذا؟

17
00:01:17,160 --> 00:01:19,570
أنا زعيمة جماعة الذئبة الفضيّة، ديس لوف

18
00:01:20,160 --> 00:01:24,290
وقريبًا سيزيد عدد أفراد الجماعة ومعجبيّ عن 5,000

19
00:01:24,870 --> 00:01:26,540
،عاش بعض من معجبيّ حياةً تعيسةً

20
00:01:26,620 --> 00:01:29,670
ولكنّهم يقولون إنّهم يُمدّون بالقوّة إن رأوني فقط

21
00:01:30,090 --> 00:01:33,420
أنا أمدّهم بالأمل بصفتي ديس لوف

22
00:01:35,170 --> 00:01:38,380
أجئتِ لتخبريني بهذا فحسب؟

23
00:01:39,220 --> 00:01:41,890
أجئتِ لتخبريني أنّي مزيّفة؟

24
00:01:41,970 --> 00:01:43,850
..لا! كنتُ

25
00:01:43,930 --> 00:01:45,810
أكنتِ قلقةً عليّ؟

26
00:01:45,890 --> 00:01:48,560
!يا لكِ من بطلة

27
00:01:49,060 --> 00:01:51,020
لقد استعددتُ للعواقب سلفًا

28
00:01:53,150 --> 00:01:56,820
هيّا غادري فالسهر يضرّ ببشرتي

29
00:02:09,580 --> 00:02:11,580
هل تحسّنت جراحك يا شيرو-سان؟

30
00:02:12,340 --> 00:02:13,630
هل حادثتِها؟

31
00:02:14,920 --> 00:02:15,760
نعم

32
00:02:16,380 --> 00:02:19,090
لا تقلق، لم أخبرها بشأنك

33
00:02:28,520 --> 00:02:30,600
يتعكّر مزاجك إن جعتِ

34
00:02:31,210 --> 00:02:36,780
على الناس أن يروا بعيونهم
ويخوضوا التجارب ليجدوا الإجابة الشافية

35
00:02:37,690 --> 00:02:38,530
ما الأمر؟

36
00:02:38,610 --> 00:02:42,030
فكّرتُ أنّ شخصًا عاش أزيد من ألف عامٍ يعلمُ الكثير بلا شك

37
00:02:42,450 --> 00:02:43,950
هل تسخرين منّي؟

38
00:02:45,080 --> 00:02:45,950
شكرًا لك

39
00:02:46,790 --> 00:02:47,950
هنيئًا مريئًا

40
00:03:01,550 --> 00:03:04,470
سأذهب إلى مقرّ الشرطة لأعرف المزيد عن يابا

41
00:03:04,890 --> 00:03:05,930
أتودّين المجيء؟

42
00:03:05,960 --> 00:03:06,970
،اذهب من دوني

43
00:03:07,060 --> 00:03:08,270
لديّ أمرٌ أنجزه

44
00:03:08,730 --> 00:03:10,310
،ابتعدي عن تلك الجماعة

45
00:03:10,850 --> 00:03:12,850
وابتعدي عن المركز الطبيّ كذلك، أفهمتِ؟

46
00:03:13,980 --> 00:03:16,440
!لقد فهمت، أراك لاحقًا

47
00:03:50,680 --> 00:03:51,730
!حيّ الفقراء

48
00:03:57,070 --> 00:03:59,480
...يُفترض أنّها حطّت في مكانٍ ما هنا

49
00:04:02,070 --> 00:04:03,450
!ميتشيرو

50
00:04:03,820 --> 00:04:04,950
ما الذي تفعلينه؟

51
00:04:05,030 --> 00:04:07,910
أودّ أن أسألكِ هذا، ما الذي تحميلنه؟

52
00:04:07,990 --> 00:04:11,080
!مياه معدنية من شبه مياه

53
00:04:11,130 --> 00:04:11,740
ماذا؟

54
00:04:11,830 --> 00:04:14,040
...وبمنقّي المياه الذي اشتريتُه في ذاك اليوم

55
00:04:16,170 --> 00:04:18,130
أما زلتِ تستعملين هذا؟

56
00:04:20,130 --> 00:04:22,010
!أعبّئه وأفعل هذا

57
00:04:22,970 --> 00:04:26,220
!ها هي ذي! مياه معدنية من شبه مياه

58
00:04:29,930 --> 00:04:32,640
!الماء بدون قمامة لذيذ حق

59
00:04:32,730 --> 00:04:34,560
أتودّين بعضًا منه يا ميتشيرو؟

60
00:04:34,590 --> 00:04:35,650
لا، شكرًا لك

61
00:04:35,730 --> 00:04:37,810
!أبيع الزجاجة لقاء 10 ين

62
00:04:37,900 --> 00:04:41,190
!عظيم أليس كذلك؟! سأصير غنيًّا بهذا

63
00:04:47,780 --> 00:04:49,580
!ها هي ذي

64
00:04:50,290 --> 00:04:52,080
!إنّها أحد أشياء جماعة الذئب الفضيّ

65
00:04:52,160 --> 00:04:54,330
!إنّي أحبّ عذراء الذئب الفضيّ

66
00:04:54,710 --> 00:04:57,830
!ولقد تغيّرتُ بفضلها

67
00:04:57,920 --> 00:05:01,380
،فما عدت أقطف الأزهار من بيوت النّاس وأبيعها

68
00:05:01,460 --> 00:05:05,840
!وما عدتُ آخذ مقاعد الدرّاجات وأبيعها

69
00:05:06,220 --> 00:05:08,470
!هذا لأنّ الذئبة الفضيّة تراقبنا

70
00:05:08,550 --> 00:05:10,810
!جميع من يعيش في الحيّ الفقراء يقول ذلك

71
00:05:13,140 --> 00:05:14,770
!لنكن هجانًا أفضل قدر المستطاع

72
00:05:15,180 --> 00:05:16,270
وهل لا بأس من فعل هذا؟

73
00:05:16,730 --> 00:05:18,980
!هذه مياه معدنيّة من شبه مياه

74
00:05:19,060 --> 00:05:22,360
!وهي كما قلتُ! ليست بخدعة وهذه تجارة

75
00:05:22,730 --> 00:05:25,530
أتعجّب من قولك هذا وتدّعي أنّك
تصبو إلى أن تكون هجينًا أفضل

76
00:05:25,610 --> 00:05:28,410
هل تحبّين الذئبة الفضيّة كذلك يا ميتشيرو؟

77
00:05:33,660 --> 00:05:34,830
نعم

78
00:05:35,500 --> 00:05:36,370
أحبّها

79
00:05:41,540 --> 00:05:43,670
!عثرتُ على عملة 10 ين نادرة

80
00:05:43,760 --> 00:05:45,630
!عليّ أن أريها للجميع

81
00:05:47,090 --> 00:05:48,680
لم تتغيّر قطّ

82
00:05:55,430 --> 00:05:59,150
كان يابا طبيعيًا جدًا قبل الحادثة

83
00:06:14,660 --> 00:06:18,580
،قضى يابا صباحه كما اعتاد في ذاك اليوم

84
00:06:19,170 --> 00:06:21,670
من ثمّ جاء ليراه بوريس من تلك الجماعة

85
00:06:21,750 --> 00:06:22,750
بوريس؟

86
00:06:22,840 --> 00:06:26,050
،أخبرني أنّه يودّ ينصح المجرمين بتعاليم الرّب

87
00:06:26,130 --> 00:06:30,340
ولكن انظر، تدمّر السجن وهرب المجرمون الأشرار

88
00:06:30,840 --> 00:06:33,720
سأقضي أيامًا أحاول فيها إصلاح ما جرى

89
00:06:34,260 --> 00:06:35,600
أودّ رؤية جثّة يابا

90
00:06:36,100 --> 00:06:38,100
نُقلت إلى المركز الطبي

91
00:06:38,480 --> 00:06:41,350
المركز الطبي؟ أليست الشرطة
المسؤولة عن الطبّ الشرعي؟

92
00:06:41,440 --> 00:06:46,320
ولكن على الشرطة اتّباع أوامر الجهات العليا كذلك

93
00:06:59,910 --> 00:07:00,830
نازونا؟

94
00:07:07,760 --> 00:07:08,630
!نازونا

95
00:07:32,360 --> 00:07:33,450
المركز الطبي؟

96
00:07:52,380 --> 00:07:54,510
هل فُحصت نتائج تلك التجربة؟

97
00:07:54,540 --> 00:07:55,600
..حسنًا، بهذا الخصوص

98
00:08:15,950 --> 00:08:18,370
!نازونا

99
00:08:22,250 --> 00:08:23,080
!نازونا

100
00:08:23,750 --> 00:08:24,580
ميتشيرو؟

101
00:08:27,920 --> 00:08:29,000
!أأنتِ بخير؟

102
00:08:33,130 --> 00:08:34,340
!ما الذي تفعلينه؟

103
00:08:34,800 --> 00:08:37,180
!يحقّ فقط للموظّفين المصرّح لهم الدخول إلى هنا

104
00:08:37,550 --> 00:08:40,140
!لديّ كل الحق لمساعدة نازونا

105
00:08:42,930 --> 00:08:43,890
!لا تفعلي ذلك يا ميتشيرو

106
00:08:58,700 --> 00:09:00,080
!أبعد يديك عن نازونا

107
00:09:02,620 --> 00:09:03,750
!أيّتها الوحش

108
00:09:09,250 --> 00:09:10,210
!ميتشيرو

109
00:09:11,000 --> 00:09:12,210
!هذا يكفي

110
00:09:29,520 --> 00:09:30,520
!ميتشيرو

111
00:09:32,070 --> 00:09:33,320
دعوها

112
00:09:38,910 --> 00:09:40,620
ما الذي تفعله بنازونا؟

113
00:09:40,700 --> 00:09:45,040
لن تترككم جماعة الذئبة
!الفضيّة وشأنكم إن حصل مكروه لنازونا

114
00:09:45,450 --> 00:09:47,710
..بل إنّني

115
00:09:47,790 --> 00:09:50,750
،تفسّرين الأمور حسب ما تهوين وتسبّبين المشكلات كالعادة

116
00:09:51,670 --> 00:09:53,170
لم تتغيّري قطّ

117
00:09:56,760 --> 00:10:01,100
أنا آسفة، لا شكّ أنّها ظنّت أنّني اختُطفت

118
00:10:01,510 --> 00:10:06,310
..لا بأس، فالتصرّف بتهوّر لإنقاذ صديق

119
00:10:06,390 --> 00:10:08,140
شيءٌ يعجبني

120
00:10:08,730 --> 00:10:11,690
ونِعم الصديقة لديكِ يا نازونا-كن

121
00:10:12,270 --> 00:10:13,610
أنتِ ميتشيرو-كن، صحيح؟

122
00:10:13,690 --> 00:10:16,070
أخبرتني نازونا الكثير عنكِ

123
00:10:17,490 --> 00:10:18,860
،أعرفُك

124
00:10:18,950 --> 00:10:20,620
أنت رئيس سيلفستا

125
00:10:20,990 --> 00:10:22,830
أسعدني أنّي تعرفينني

126
00:10:23,370 --> 00:10:26,290
،أنتِ محقّة، أنا آلان سيلفستا

127
00:10:26,700 --> 00:10:29,120
وأنا رئيس شركة سيلفستا للأدوية

128
00:10:30,330 --> 00:10:31,960
ما الذي يجري هنا؟

129
00:10:32,040 --> 00:10:33,750
وما الذي تفعلينه هنا يا نازونا؟

130
00:10:34,300 --> 00:10:35,960
كنتُ أجري صورة رنين مغناطيسي

131
00:10:36,550 --> 00:10:37,760
صورة رنين مغناطيسي؟

132
00:10:39,340 --> 00:10:43,970
تسمح نازونا لنا بدراستها
ونحن نجري لها الفحوصات بانتظام

133
00:10:44,560 --> 00:10:46,680
جئتُ هنا بإرادتي

134
00:10:47,560 --> 00:10:48,680
هلّا تغادرين

135
00:10:49,140 --> 00:10:51,850
،على رسلك، ولأنّ الفرصة سنحت لنا هذا

136
00:10:51,940 --> 00:10:55,230
لربّما من الأفضل أن تعرف ميتشيرو الحقيقة كذلك

137
00:10:55,320 --> 00:10:56,610
!ولكنّ هذا

138
00:10:56,680 --> 00:11:01,530
ستحصل مشكلات لاحقًا إن استنتجت
أشياءَ بناءً على جزءٍ من القصّة

139
00:11:01,930 --> 00:11:07,450
أظنّ أنّه من حقّ ميتشيرو-كن
معرفة السبب الذي جعلها هجينةً

140
00:11:09,790 --> 00:11:10,960
حسنًا

141
00:11:12,000 --> 00:11:12,920
نازونا؟

142
00:11:14,250 --> 00:11:15,210
،ميتشيرو-كن

143
00:11:15,750 --> 00:11:17,420
،عليّ الاعتذار لكِ

144
00:11:18,210 --> 00:11:19,800
..فلقد صرتِ هجينةً

145
00:11:20,550 --> 00:11:22,930
بسبب هذا المركز الطبّي بعينه

146
00:11:26,430 --> 00:11:30,640
نُقل إليكِ أنتِ ونازونا خطأً دمٌ يحتوي على عقّار تجريبي

147
00:11:30,730 --> 00:11:33,520
ومصنوع من حمضيٍ نوويّ صبغي حيوانيّ نشط

148
00:11:44,140 --> 00:11:49,790
وقع اختلاطٌ بين بعضٍ من هذا العقّار
التجريبيّ وعقّارٍ باعه كلّ من يابا وميمورا بيعًا غير قانونيٍّ

149
00:11:53,540 --> 00:11:57,040
وصادف أن نُقل إليكما

150
00:11:58,250 --> 00:11:59,340
...محال

151
00:11:59,710 --> 00:12:02,840
،حينما أدرك يابا أنّ عدد الأكياس لم يكن صحيحًا

152
00:12:02,930 --> 00:12:04,760
.حاول بجدٍّ البحث عن الأكياس الناقصة

153
00:12:05,180 --> 00:12:08,140
،اكتشف أنّ نازونا تحوّلت إلى هجينة

154
00:12:08,220 --> 00:12:10,350
ولهذا سارع للقبض عليها وحجرها

155
00:12:09,790 --> 00:12:17,130
أنثى

156
00:12:09,790 --> 00:12:17,130
ميتشيرو كييييييييييييياغيموري

157
00:12:10,850 --> 00:12:15,150
،ولكنّه لم يدرك أنّكِ أنتِ صديقتها تحوّلتِ إلى هجينة كذلك

158
00:12:15,600 --> 00:12:17,060
إلى أن وصلتِ إلى هذه المدينة

159
00:12:18,070 --> 00:12:20,860
السبب الحقيقي وراء تفجيرهما المركز الطبيّ

160
00:12:20,940 --> 00:12:24,030
كان ليمحيا البيانات المتعلّقة بتسرّب العقّار التجريبيّ

161
00:12:24,610 --> 00:12:27,530
،فتطوير العقّار الجديد كان أمرًا سرّيًا جدًا

162
00:12:27,620 --> 00:12:31,250
إن اكتشف أحد ما ذلك فلن
يقتصر عقابهما على بيعه بيعًا غير قانونيّ فقط

163
00:12:31,870 --> 00:12:33,460
!ليتكِ لم تكوني هنا

164
00:12:35,620 --> 00:12:38,630
!أتعني أنّني ونازونا ضحيّتان لتجاربكم؟

165
00:12:38,710 --> 00:12:39,590
!هذا فظيع

166
00:12:39,960 --> 00:12:40,920
إنّي آسف جدًا

167
00:12:41,550 --> 00:12:43,550
أتحمّل مسؤولية هذا

168
00:12:44,340 --> 00:12:45,590
،ولكن لا تقلقي

169
00:12:46,180 --> 00:12:48,180
فبإمكانكِ أن تعودي بشريةً

170
00:12:49,600 --> 00:12:52,730
إذ نطوّر عقّارًا يُشفي مرض الهجان هذا

171
00:12:52,810 --> 00:12:54,560
وسيجهز قريبًا

172
00:12:54,640 --> 00:12:58,230
بإمكانكِ ونازونا أن تعودا بشريّتين بجرعةٍ منه

173
00:12:58,980 --> 00:13:02,690
لهذا السبب أنا وسيلفستا نتعاون

174
00:13:12,830 --> 00:13:16,620
عندما سمعتُ بأمر تحوّلي إلى هجينة، صدُمت كذلك

175
00:13:17,580 --> 00:13:24,420
ولكنّه وعدني أن تتحمّل سيلفستا للأدوية
كامل المسؤولية وستطوّر عقّارًا يعيدني بشريّةً

176
00:13:25,040 --> 00:13:32,220
طلبتُ من نازونا-كن أن تعمل على بثّ الأمل في كلّ
هجينٍ إلى حين إنهائنا تطوير العقّار الشافي لمرض الهجان

177
00:13:32,720 --> 00:13:34,270
وذلك بالاستعانة بقدرتها على التحوّل

178
00:13:39,270 --> 00:13:40,360
!لحظة

179
00:13:40,770 --> 00:13:44,190
كنتَ ضدّ فكرة انتقال جماعة
!الذئبة الفضيةّ إلى مدينة أنيما

180
00:13:44,570 --> 00:13:47,280
،كان هذا أمرًا ضروريًا

181
00:13:47,680 --> 00:13:53,870
وجود جماعة الذئبة الفضيّة أمر ضروريٌّ
للحدّ من الإنتروبيا العقلية للهجان

182
00:13:54,620 --> 00:13:56,710
إنتروبيا؟

183
00:13:57,080 --> 00:14:00,420
أنا واثق من أنّكِ صرتِ تفهمين هذا
لأنّكِ عشتِ في مدينة أنيما

184
00:14:01,000 --> 00:14:03,420
،من السهل أن يتأثّر الهجان بعواطفهم

185
00:14:04,000 --> 00:14:05,210
،متى ازداد شعورهم بالإحباط

186
00:14:05,300 --> 00:14:08,720
أبسط شيء قادر على جعلهم
يهتاجون محدثين فوضى عارمة

187
00:14:09,220 --> 00:14:13,310
وإنّنا نستغلّ الإيمان بمعتقد جماعة
الذئبة الفضيّة لنحافظ على ضبط نفوسهم

188
00:14:13,760 --> 00:14:18,440
فبصبّ كامل تركيزهم على الإله نقلّل من إنتروبيا عقليّتهم

189
00:14:18,890 --> 00:14:20,900
ألست تقصد الاضطراب؟

190
00:14:20,980 --> 00:14:24,320
،ولأنّ البشر اضطهدوا الهجان

191
00:14:24,400 --> 00:14:27,700
محال أن يؤمن الهجان بمعتقدٍ يستهوي البشر

192
00:14:28,150 --> 00:14:31,870
وماذا عن إنقاذك على يد نازونا عندما هوجمت؟

193
00:14:32,240 --> 00:14:35,870
،علمتُ سلفًا أنّني قد أتعرّض للهجوم

194
00:14:36,790 --> 00:14:38,830
وببساطة استغللتُ هذه المعلومة

195
00:14:39,290 --> 00:14:42,750
فلعلمك القليل من التمثيل ضروريّ لجعل النّاس يؤمنون

196
00:14:43,160 --> 00:14:49,550
أسرع طريقة للحدّ من إنتروبيا عقليّتهم
هي جعلهم يؤمنون من تلقاء أنفسهم

197
00:14:49,970 --> 00:14:51,510
أظنّك تقصد الاضطراب هنا

198
00:14:51,590 --> 00:14:54,970
إنتروبيا العقليّة، هل فهمتِ؟

199
00:14:58,930 --> 00:15:00,230
خدعتما الجميع؟

200
00:15:01,150 --> 00:15:02,650
بل كانت مجرّد تمثيليّة

201
00:15:03,190 --> 00:15:06,190
حوفظ على نظام أنيما نتيجةً لذلك

202
00:15:06,610 --> 00:15:08,240
لمَ لم تخبريني؟

203
00:15:08,650 --> 00:15:11,660
!أخبرتُكِ أنّني أبحث عن طريقةٍ تُشفينا من مرض الهجان هذا

204
00:15:12,030 --> 00:15:14,370
!ما كنتُ لأخبركِ بالطبع لأنّه أمر شديد السرّيّة

205
00:15:14,450 --> 00:15:17,040
أنا وبوريس فقط يعلمان هذا

206
00:15:17,120 --> 00:15:19,290
لم أخبركِ لأنّكِ دخيلة على هذا

207
00:15:19,370 --> 00:15:22,170
!أنا وأنتِ من يعانيان من مرض الهجان هذا

208
00:15:22,250 --> 00:15:24,670
!ذاك الرجل العجوز المشبوه هو من لا دخل له بهذا

209
00:15:24,750 --> 00:15:26,920
!أخبرتكِ أنّه ليس مشبوهًا كما تقولين

210
00:15:27,300 --> 00:15:30,670
!عجوز لا يفارقكِ على مدار الساعة، هذا يثير الريبة بلا شك

211
00:15:31,050 --> 00:15:32,760
!على رسلكما

212
00:15:32,840 --> 00:15:35,470
،يؤمن الجميع بما يرونه فقط

213
00:15:36,100 --> 00:15:37,390
وهذا ينطبق عليكِ

214
00:15:37,810 --> 00:15:40,850
،فعندما رأيتِ نازونا-كن تستقلّ سيارةً فيها أتباعي

215
00:15:41,020 --> 00:15:43,230
اعتقدتِ أنّها اختُطفت

216
00:15:43,310 --> 00:15:45,440
ولكنّ تبيّن أنّ الحقيقة شيء آخر، أليس كذلك؟

217
00:15:46,230 --> 00:15:49,900
الحقيقة تنجلي في ما لا نراه

218
00:15:51,570 --> 00:15:54,200
،أضمن لكِ أنّنا سنوفّر العقّار لكما

219
00:15:55,070 --> 00:15:57,580
وأقسم إنّني سأجعلكما تعودان بشريّتين

220
00:15:58,160 --> 00:15:59,160
هذا وعد

221
00:16:00,250 --> 00:16:03,580
ولكن هلّا تتعاونان أنتِ ونازونا-كن حتّى ذلك الحين

222
00:16:12,050 --> 00:16:13,300
نتعاون؟

223
00:16:13,760 --> 00:16:15,430
ما الذي يفترض بي فعله؟

224
00:16:15,890 --> 00:16:18,680
يفترض بكِ ألّا تتدخلي في عملنا

225
00:16:19,560 --> 00:16:21,770
عملكم؟

226
00:17:50,360 --> 00:17:54,030
ظننتُني أخبرتُكِ أن تبتعدي عن تلك الجماعة وعن المركز الطبّي

227
00:17:55,400 --> 00:17:58,360
يبدو أنّه من الممكن أن أعود بشريّة

228
00:18:02,330 --> 00:18:03,290
خطأ طبيّ؟

229
00:18:03,660 --> 00:18:04,160
نعم

230
00:18:04,580 --> 00:18:07,660
،ولكنّه اعتذر إليّ

231
00:18:08,370 --> 00:18:11,290
ووعدني أن يوفّر عقّارًا لنا

232
00:18:11,960 --> 00:18:13,460
وهل تصدقينه؟

233
00:18:14,210 --> 00:18:16,510
إنهّ يستغلّكما من أجل مخطّطاته فقط

234
00:18:17,170 --> 00:18:20,590
!تظنّ ذلك لأنّ آلان بشريٌّ فقط

235
00:18:20,680 --> 00:18:23,760
إنّك تشكّ في كلّ شيء يقوله البشر

236
00:18:24,140 --> 00:18:26,180
صديقتُكِ بشريّة كذلك، صحيح؟

237
00:18:26,270 --> 00:18:29,390
،تقول كذبًا إنّها ذئبة فضيّة وتخدع الهجان كلّهم

238
00:18:29,480 --> 00:18:30,980
هكذا هم البشر

239
00:18:31,560 --> 00:18:33,940
!أنت مخطئ! ليس ذلك ما نازونا عليه

240
00:18:34,730 --> 00:18:37,740
أعترف أنّها تكذب بخصوص كونها ذئبة فضيّة

241
00:18:38,570 --> 00:18:41,910
لطالما قالت نازونا إنّها تودّ أن تكون آيدول

242
00:18:42,490 --> 00:18:45,450
فكّرتُ أنّها تودّ أن تكون محطّ انتباه الجميع

243
00:18:46,450 --> 00:18:48,460
حسنًا، قد يكون هذا جزءًا من السبب

244
00:18:49,230 --> 00:18:56,380
ولكنّ نازونا تودّ أن تمنح بصيص أمل
وأحلامًا للهجان الذي اضطُهدوا وعانوا طويلًا

245
00:18:56,920 --> 00:18:59,550
لهذا السبب صارت الذئبة الفضيّة وثابرت في ذلك

246
00:18:59,840 --> 00:19:01,890
أظنّ هذا رائعًا جدًا

247
00:19:02,430 --> 00:19:06,640
تودّ منّي أن أتغاضى عن أمر
ادّعاء كونها ذئبة فضيّة

248
00:19:08,560 --> 00:19:10,020
هل انضممتِ إلى تلك الجماعة؟

249
00:19:11,100 --> 00:19:14,360
لا تكن أحمق، لا أومن بما جاءت به تلك الجماعة المزيّفة

250
00:19:14,770 --> 00:19:16,980
ولكنّي أومن بنازونا

251
00:19:17,730 --> 00:19:21,780
أدركتُ أنّ مشاعري تجاهها لم تتغيّر قطّ

252
00:19:23,280 --> 00:19:26,580
لن أخبرها بهذا أبدًا لأنّه سيغضبها

253
00:19:27,910 --> 00:19:29,960
أتودّين أن تعودي بشريّة؟

254
00:19:32,080 --> 00:19:33,500
بالطبع أودّ ذلك

255
00:19:34,380 --> 00:19:36,880
وإن عدتِ بشريّةً، أستغادرين مدينة أنيما؟

256
00:19:37,750 --> 00:19:39,550
،صرتُ أحبّ هذه المدينة

257
00:19:40,090 --> 00:19:42,840
ولكنّي أودّ العودة إلى دياري

258
00:19:44,550 --> 00:19:45,360
أحقًا؟

259
00:19:45,740 --> 00:19:46,220
نعم

260
00:19:51,890 --> 00:19:52,850
دعه مفتوحًا

261
00:19:54,020 --> 00:19:57,150
الرياح باردة الليلة، ستصابين بالبرد

262
00:19:57,230 --> 00:19:58,110
لا آبه

263
00:19:58,780 --> 00:20:02,820
لن تأتي الفتاة التانوكي إلى هنا مجددًا، صحيح؟

264
00:20:04,450 --> 00:20:05,340
يا بوريس

265
00:20:05,530 --> 00:20:06,000
نعم

266
00:20:06,330 --> 00:20:09,790
من الآن فصاعدًا، سيتولّى أحد غيرك إدارة أعمالي

267
00:20:09,870 --> 00:20:11,330
ماذا؟ وما السبب؟

268
00:20:11,750 --> 00:20:12,790
!لأنّك مثير للريبة

269
00:20:14,120 --> 00:20:17,500
،ومن المثير للريبة أن تدخل غرفتي دون إذنٍ

270
00:20:17,590 --> 00:20:19,130
لذا لن أدع هذا يتكرّر

271
00:20:20,670 --> 00:20:22,170
كن هجينًا أفضل قدر المستطاع

272
00:20:23,930 --> 00:20:26,350
كن هجينًا أفضل قدر المستطاع

273
00:20:36,230 --> 00:20:38,190
ما زالت بشريّة في النهاية

274
00:20:38,650 --> 00:20:39,690
هل قلت شيئًا؟

275
00:20:39,970 --> 00:20:40,530
لا

276
00:20:40,610 --> 00:20:41,860
ما الذي جاء بك إلى هنا اليوم؟

277
00:20:41,940 --> 00:20:44,150
،أودّ معرفة نتيجة الطبّ الشرعي

278
00:20:44,240 --> 00:20:46,070
كيف انتهى بيابا الحال هكذا؟

279
00:20:46,450 --> 00:20:48,620
لقد تحوّر حمضه الحيوانيّ النووي الصبغي

280
00:20:49,030 --> 00:20:49,940
حمضه الحيوانيّ النووي الصبغي

281
00:20:50,100 --> 00:20:52,700
ولكنّنا ما زلنا نجهل السبب

282
00:20:52,790 --> 00:20:55,540
سيُعلموني إن علموا

283
00:20:55,620 --> 00:20:57,290
لمَ تتركين هذا الشأن في أيدي عاملي المركز الطبي؟

284
00:20:57,830 --> 00:21:01,630
أكره الاعتراف بهذا ولكنّ المركز الطبّي يمتلك أحدث التقنيات

285
00:21:01,710 --> 00:21:05,260
وبالإضافة إلى أنّ آلان ليس بشريًّا سيئّا كما تظنّ

286
00:21:05,680 --> 00:21:07,970
الجميع أصحابه الآن إذن

287
00:21:08,600 --> 00:21:12,180
ما قابلتُ في حياتي بشريًّا طيّبًا قطّ مذ أن وعيتُ على هذه الدنيا

288
00:21:12,560 --> 00:21:14,890
حقًا؟ ولكنّك قابلتَ واحدًا كلّ هذه المدّة

289
00:21:15,350 --> 00:21:17,190
أوَليست ميتشيرو بشريّة طيّبة؟

290
00:21:22,690 --> 00:21:26,570
أشكرك جزيلًا على تكرّمك بوقتك المشغول

291
00:21:27,110 --> 00:21:29,070
ما الشغل العاجل الخاص بك؟

292
00:21:29,660 --> 00:21:33,540
،ما كانت لتنشأ مدينة أنيما من دون مساعدتك

293
00:21:33,950 --> 00:21:35,540
يا حضرة رئيس الوزراء شيراميزو

294
00:21:35,620 --> 00:21:38,250
ولهذا السبب أودّ استشارتك

295
00:21:38,330 --> 00:21:39,500
استشارتي؟

296
00:21:39,880 --> 00:21:43,260
أودّ تقديم شيء للحكومة اليابانيّة

297
00:21:59,370 --> 00:22:02,860
فجأةً صار رأسًا على عقب

298
00:22:03,090 --> 00:22:06,990
عالمُنا ها قد بدأ بالتغيير

299
00:22:07,220 --> 00:22:11,390
الأمس ولّى والغد على الأبواب

300
00:22:11,420 --> 00:22:15,620
لذا أُجبرتُ على التغيير دون تخيير

301
00:22:16,030 --> 00:22:20,010
بحثًا عنك في الأرجاء أجري

302
00:22:20,010 --> 00:22:24,210
وما زلتُ عن حقيقتي لا أدري

303
00:22:24,210 --> 00:22:29,320
أبكي بحرارة ولكنّي لن أرضى بالخسارة

304
00:22:30,420 --> 00:22:32,450
أخبرني

305
00:22:32,450 --> 00:22:36,300
إلى الليالي المنيرة ننتمي

306
00:22:36,300 --> 00:22:40,640
فالتحليق في سمائها يسعد قلبي

307
00:22:40,810 --> 00:22:44,730
فهيّا نجُب العالم وإلى أقاصيه نمشي

308
00:22:44,730 --> 00:22:48,130
مسحورين بنجوم السما