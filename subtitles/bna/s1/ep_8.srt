1
00:00:25,400 --> 00:00:29,270
نعم، شعرتُ أنّه ما من خيارٍ آخر أمامنا
عدا القبول بطلب الجماعة

2
00:00:29,650 --> 00:00:34,780
،أتفهم ذلك، خصوصًا من بعد حماسة ذلك الحشد

3
00:00:34,860 --> 00:00:37,740
عدم اعتراف بحقّهم سيؤول إلى أعمال شغب

4
00:00:38,320 --> 00:00:42,830
ومحال أن أرفض من بعد أن أنقذوا حياتي

5
00:00:44,540 --> 00:00:48,380
ولكنّي لم أتوقع أنّهم كُثر هكذا

6
00:00:48,460 --> 00:00:52,210
نقدّر عددهم حاليًا بـ5,000

7
00:00:52,300 --> 00:00:55,590
نقسّمهم الآن ونوطّنهم في أرجاء أنيما

8
00:00:55,680 --> 00:00:59,300
لا شكّ أنّكِ تعانين يا حضرة العمدة
ولكن عليكِ بالصبر

9
00:01:00,850 --> 00:01:01,890
ما الوضع؟

10
00:01:02,180 --> 00:01:05,440
إنّ عملية تثبيط الحمض النووي الصبغي
،الحيواني تجري على قدمٍ وساقٍ وباستقرار

11
00:01:05,520 --> 00:01:06,600
ونكاد ننجح

12
00:01:07,060 --> 00:01:09,480
جميل، واصلوا

13
00:01:12,940 --> 00:01:15,530
حان موعد الاختبار النهائيّ تقريبًا

14
00:01:17,090 --> 00:01:20,010
هل أنتَ مستعد للذهاب؟

15
00:01:20,360 --> 00:01:23,290
فأنت تعلم الدرب السديد

16
00:01:23,540 --> 00:01:26,870
سأمضي في دربي دون ارتياب

17
00:01:26,870 --> 00:01:29,770
فهيّا بنا إلى عالم جديد

18
00:01:43,190 --> 00:01:49,600
يحبس الجميع أنفاسهم على ذكر الآمال

19
00:01:49,770 --> 00:01:56,200
يومًا ما سألاقيك في مكانٍ يفوق الخيال

20
00:01:56,200 --> 00:02:02,780
ما من شيء سيوقفني عن الترحال

21
00:02:02,830 --> 00:02:06,100
لوّن العالم بألوانك واجعله جميلًا

22
00:02:06,100 --> 00:02:09,210
فالتغيير إن عزمنا ليس مستحيلًا

23
00:02:09,350 --> 00:02:12,650
كن نورًا يقشع ظلالًا انسدلت طويلًا

24
00:02:12,650 --> 00:02:15,990
وامضِ قدمًا ودع الحذرَ خلفك مذلولًا

25
00:02:20,930 --> 00:02:25,270
،مضت 3 أيّام فقط منذ أن استقرّت الجماعة في ذاك المبنى

26
00:02:25,350 --> 00:02:27,680
بوسعك الإحساس بحبّهم تجاه الذئبة الفضيّة

27
00:02:28,390 --> 00:02:32,440
هذا دليلٌ على نفوذ المعتقد الديني

28
00:02:57,130 --> 00:02:58,090
نازونا؟

29
00:03:01,680 --> 00:03:02,970
!نازونا

30
00:03:06,560 --> 00:03:08,430
،لم أكن أعلم أنّ بوسعكِ الطيران

31
00:03:08,810 --> 00:03:09,810
أكنتِ تخفين الأمر؟

32
00:03:10,560 --> 00:03:13,350
!غير صحيح! اكتشفتُ هذا أوّل مرةٍ يوم أمس

33
00:03:13,440 --> 00:03:15,520
!لم تقولي إنّه بوسعكِ الطيران كذلك

34
00:03:15,940 --> 00:03:18,280
وهل عليّ إخباركِ بكلّ شيء؟

35
00:03:18,360 --> 00:03:19,990
...ولكنّكِ أوّل من سأل

36
00:03:20,740 --> 00:03:21,780
!انسي الأمر

37
00:03:22,200 --> 00:03:24,950
!لا أصدّق أنّكِ انتقلتِ إلى المبنى الذي في الشارع المقابل

38
00:03:25,030 --> 00:03:27,540
ماذا؟ بوريس هو من قرّر ذلك بنفسه

39
00:03:28,080 --> 00:03:31,410
على كلٍّ، إيّاكِ أن تخبري أحدًا عن حقيقتي

40
00:03:31,500 --> 00:03:34,420
موضوع أنّي بشريّة يجب أن يظلّ طيّ الكتمان

41
00:03:34,880 --> 00:03:36,880
!أخبرتكِ أنّني لن أخبر أحدًا

42
00:03:36,960 --> 00:03:41,090
ولكن أهذا ما تريدينه حقًا يا نازونا؟

43
00:03:43,220 --> 00:03:44,640
،لستُ نازونا

44
00:03:51,430 --> 00:03:53,140
!أنا ديس لوف

45
00:03:53,600 --> 00:03:57,020
!لا تناديني بنازونا! أنا ديس لوف

46
00:04:02,280 --> 00:04:03,610
ما هذه النبرة؟

47
00:04:04,570 --> 00:04:06,200
...وكأنّي سأتذكّره

48
00:04:16,080 --> 00:04:17,340
إلى أين ذهبتِ؟

49
00:04:17,920 --> 00:04:21,090
كنتُ مع نازونا، بيد أنّ هذا ما عاد اسمها

50
00:04:21,630 --> 00:04:22,720
ذهبتِ لرؤيتها؟

51
00:04:23,470 --> 00:04:25,640
،صادف أن قابلتُها فحسب

52
00:04:25,720 --> 00:04:27,510
وماذا؟ أجريمةٌ هذه؟

53
00:04:29,010 --> 00:04:30,010
لا

54
00:04:34,640 --> 00:04:36,850
ما الأمر إذن؟

55
00:04:37,440 --> 00:04:40,440
،سيستجوبون الهجين الصقر الذي ألقوا القبض عليه

56
00:04:41,480 --> 00:04:42,440
أتودين المجيء؟

57
00:04:43,570 --> 00:04:46,660
ظننتُ أنّكِ قد تودّين معرفة من وظّفه

58
00:04:47,030 --> 00:04:48,700
ألهذا السبب استدعيتني إلى هنا؟

59
00:04:48,780 --> 00:04:49,520
نعم

60
00:04:49,790 --> 00:04:50,620
!جديًا؟

61
00:04:51,200 --> 00:04:52,840
لا تأتي إن لم ترغبي

62
00:04:52,940 --> 00:04:55,540
!سأذهب معك

63
00:04:58,460 --> 00:05:02,380
وَعظ المجرمين بالدّين ليس بالشأن السهل طبعًا

64
00:05:02,460 --> 00:05:06,260
المجرمون تحديدًا في حاجةٍ إلى تعاليم الرّب

65
00:05:06,340 --> 00:05:07,760
لا خلاف في هذا

66
00:05:07,820 --> 00:05:09,330
غرفة الاستجوSSSDاب الأو

67
00:05:07,820 --> 00:05:09,330
غرفةسشسشسسشسشس الاستجواب الأولى

68
00:05:07,820 --> 00:05:09,330
غرفة الاستجواب الأولى

69
00:05:09,350 --> 00:05:10,310
أهلًا

70
00:05:11,350 --> 00:05:13,890
،كان رئيس المركز الطبيّ

71
00:05:13,980 --> 00:05:15,690
وقُبض عليه بتهمة الاحتيال

72
00:05:15,770 --> 00:05:19,400
لا أظنّه سيكون عنيفًا ولكن عليك الحذر

73
00:05:22,400 --> 00:05:25,110
!لا أومن بما جاءت به جماعة الذئبة الفضيّة

74
00:05:25,990 --> 00:05:28,530
نعم، هكذا أعرفك

75
00:05:29,620 --> 00:05:32,620
مهلًا، هل تقابلنا سابقًا؟

76
00:05:32,700 --> 00:05:36,000
لا أظنّك ستعرفني بهيئتي هذه

77
00:05:36,460 --> 00:05:37,370
ماذا؟

78
00:05:37,790 --> 00:05:40,750
هل عليّ فضح جرائمك؟

79
00:05:40,840 --> 00:05:45,760
أنا واثقٌ من أنّك تودّ الخروج
،من هذا الوضع بقضيّة اختلاس فقط

80
00:05:45,840 --> 00:05:49,090
ولكن أشكّ أنّ الرئيس آلان سيدعك تفرّ هكذا

81
00:05:49,720 --> 00:05:52,560
من تكون؟

82
00:06:00,190 --> 00:06:01,150
...مهلًا

83
00:06:01,810 --> 00:06:03,730
هذا كبير معلّمي الجماعة

84
00:06:07,650 --> 00:06:09,700
ما الخطب يا يابا-سان؟

85
00:06:10,110 --> 00:06:11,200
هل أنت بخير؟

86
00:06:18,500 --> 00:06:20,880
،أنتِ هنا كذلك يا ميتشيرو إذن

87
00:06:21,330 --> 00:06:23,590
هل اعتدتِ هذه المدينة؟

88
00:06:24,000 --> 00:06:25,630
نعم، نوعًا ما

89
00:06:25,710 --> 00:06:27,720
عجبًا، تبدين غير واثقة

90
00:06:29,130 --> 00:06:30,890
!سيّدي المحقّق، لقد فرّ يابا

91
00:06:38,940 --> 00:06:42,190
!أذلك يابا؟ إنّه مختلف عن ذي سبق

92
00:06:42,270 --> 00:06:43,270
!نعم

93
00:06:44,730 --> 00:06:47,150
!لكم أن تطلقوا النار! أطلقوا

94
00:06:55,540 --> 00:06:58,080
تبًا! كيف صار بهذه الضراوة؟

95
00:06:58,580 --> 00:06:59,830
!سأوقفه

96
00:07:00,540 --> 00:07:01,270
!ما هذا؟

97
00:07:01,600 --> 00:07:02,790
!لقد اندلع حريق

98
00:07:02,880 --> 00:07:06,550
نعم، كان فعّالًا مثل المتوقّع

99
00:07:07,380 --> 00:07:09,050
!علينا ألّا ندعه يحدث ضرّرًا أكبر

100
00:07:09,510 --> 00:07:11,130
!علينا إيقافه

101
00:07:13,430 --> 00:07:16,970
!لقد حطّم السور وسيدخل المدينة

102
00:07:24,940 --> 00:07:25,860
!ماذا؟

103
00:07:30,280 --> 00:07:31,530
!شينرو-سان

104
00:07:31,610 --> 00:07:33,990
أنا بخير، بإمكاني تولّي أمره

105
00:07:34,410 --> 00:07:35,740
!ولكنّ ذراعك متضرّرة

106
00:07:41,040 --> 00:07:42,040
!تحسّنت؟

107
00:07:47,380 --> 00:07:49,760
!كيف لهذا الشيء أن يقاوم أوغامي؟

108
00:07:50,630 --> 00:07:53,590
!ستحلّ كارثة إن اقتحم ذاك الشيء المدينة

109
00:07:58,720 --> 00:07:59,760
!ما الذي تفعلينه؟

110
00:07:59,820 --> 00:08:01,020
!سأتولّى أمره

111
00:08:01,600 --> 00:08:06,480
!سأحمله إلى مكان ناءٍ

112
00:08:06,560 --> 00:08:08,170
!لا تكوني حمقاء وابتعدي

113
00:08:08,170 --> 00:08:09,110
!كلّا

114
00:08:09,480 --> 00:08:11,940
!لا تظنّ أنّك قادر على حلّ كلّ مشكلةٍ بنفسك

115
00:08:12,320 --> 00:08:16,450
!أستطيع تأدية الواجب في وقت الصعاب كذلك

116
00:08:24,080 --> 00:08:27,130
!أريني ما بوسعكِ فعله إذن

117
00:08:31,960 --> 00:08:33,550
!رفرفي بجناحيكِ أقوى

118
00:08:35,050 --> 00:08:36,430
!أقوى

119
00:08:36,510 --> 00:08:39,680
!أعطِني جناحين أكبر

120
00:08:45,230 --> 00:08:47,230
!كفّ عن المقاومة

121
00:08:47,310 --> 00:08:48,520
!أيّها اللعين

122
00:08:49,610 --> 00:08:52,220
!اذهبي إلى الميناء! فما من أحدٍ هناك

123
00:08:52,250 --> 00:08:52,860
!حسنًا

124
00:08:57,990 --> 00:09:00,040
!إنّه يقاوم مجددًا

125
00:09:00,040 --> 00:09:00,540
!أسقطيه

126
00:09:00,620 --> 00:09:02,200
!من هذا الارتفاع؟

127
00:09:02,240 --> 00:09:03,410
!لا يهمني! افعليها فحسب

128
00:09:03,500 --> 00:09:04,640
!سأكون بخير

129
00:09:04,680 --> 00:09:05,160
!حسنًا

130
00:09:23,680 --> 00:09:24,560
!فعلناها

131
00:09:24,640 --> 00:09:26,060
بالكود

132
00:09:30,270 --> 00:09:31,110
!تراجعي

133
00:09:34,530 --> 00:09:36,570
شـ-شيرو-سان؟

134
00:09:41,530 --> 00:09:43,740
!سأكون بخير، عليكِ الخروج

135
00:09:50,210 --> 00:09:51,380
!شيرو-سان

136
00:09:51,750 --> 00:09:52,800
أنا بخير

137
00:09:52,880 --> 00:09:55,340
!بل إنّ جرحك بليغ! لنخرج معًا

138
00:09:56,970 --> 00:10:00,930
!واجبي ألّا أدع ذاك الشخص يجول بحريّة

139
00:10:08,890 --> 00:10:10,230
!توقف

140
00:10:14,610 --> 00:10:15,610
!اهربي

141
00:10:36,710 --> 00:10:39,180
!فعلتُها! اهرب يا شيرو-سان

142
00:10:58,490 --> 00:11:00,150
!ليس لدي خيار آخر

143
00:11:29,890 --> 00:11:31,020
الذئب الفضيّ؟

144
00:11:31,520 --> 00:11:33,230
مهلًا! ألستَ أنت شيرو-سان؟

145
00:11:34,270 --> 00:11:35,400
تراجعي

146
00:12:06,850 --> 00:12:08,100
!شيرو-سان

147
00:12:09,930 --> 00:12:11,450
!سأتصل بالإسعاف

148
00:12:11,520 --> 00:12:12,480
!لا تفعلي

149
00:12:13,610 --> 00:12:16,440
سأكون بخير

150
00:12:19,530 --> 00:12:20,780
!أوغامي-كن

151
00:12:20,860 --> 00:12:23,240
!ما الذي تفعلينه هنا يا حضرة العمدة؟

152
00:12:23,320 --> 00:12:25,160
أخبرني المحقّق تاتشيكي بما حصل

153
00:12:25,660 --> 00:12:27,580
...إنّ شيرو-سان قد

154
00:12:27,990 --> 00:12:29,410
سيكون بخير

155
00:12:29,950 --> 00:12:31,040
اصطحبه إلى السيّارة

156
00:12:31,230 --> 00:12:31,910
حسنًا

157
00:12:36,750 --> 00:12:38,340
صارت تعرف الأمر

158
00:12:42,720 --> 00:12:43,720
هكذا إذن

159
00:12:49,100 --> 00:12:50,680
،تحسّنت حالته

160
00:12:51,060 --> 00:12:53,770
وسيكون بخيرٍ الآن بعد أن شُفيت جراحه

161
00:12:54,190 --> 00:12:55,940
ذاك الجرح كان بليغًا جدًا

162
00:12:56,400 --> 00:12:58,020
إنّه خالد بلا شك

163
00:12:58,440 --> 00:13:01,150
ومن الجيد أن إصاباتكِ لم تكن أسوأ

164
00:13:01,730 --> 00:13:03,070
هذا بفضل شينرو-سان

165
00:13:04,320 --> 00:13:07,030
ماذا يكون؟

166
00:13:07,530 --> 00:13:08,950
هل شينرو-سان هو الذئب الفضي؟

167
00:13:09,580 --> 00:13:11,950
أليست صديقتك من تحمل هذا اللقب؟

168
00:13:12,040 --> 00:13:16,670
لا تتحامقي! سمعتُه يقول لكِ إنّني صرتُ أعرف الأمر

169
00:13:17,210 --> 00:13:20,840
ونازونا ذئبة فضيّة مزيفة، وأنتِ تعلمين هذا، صحيح؟

170
00:13:21,960 --> 00:13:22,880
نعم

171
00:13:23,260 --> 00:13:26,760
هل شينرو-سان هو الذئب الفضيّ الحقيقي؟

172
00:13:26,840 --> 00:13:28,430
ولماذا تودّين معرفة ذلك؟

173
00:13:31,930 --> 00:13:35,600
،لا أعرف أيّ شيء عن شينرو-سان

174
00:13:36,350 --> 00:13:38,270
ولم أحاول حتّى أن أعرف

175
00:13:38,770 --> 00:13:43,360
لا بدّ أنّني جزمتُ أنّني وشينرو-سان مختلفان

176
00:13:44,030 --> 00:13:46,320
أهذا بسبب أنّه هجين وأنتِ بشريّة؟

177
00:13:47,990 --> 00:13:52,950
،شعرتُ بالازدراء  تجاهه لأنّه يكره البشر

178
00:13:53,370 --> 00:13:56,960
..ظننتُه متحيّزًا للهجان، ولكن

179
00:13:57,790 --> 00:13:59,670
،أنا مثله

180
00:14:00,250 --> 00:14:03,880
فكُرت أنّنا مختلفان لأنّه هجين

181
00:14:05,460 --> 00:14:08,630
خفتُ عندما صرتُ هجينة

182
00:14:09,510 --> 00:14:13,470
ولربّما هذا لأنّي لم أكن أعرف شيئًا عن الهجان

183
00:14:14,470 --> 00:14:18,890
ولكنّي الآن أودّ معرفة المزيد عن شيرو-سان

184
00:14:20,940 --> 00:14:22,230
حسنًا إذن

185
00:14:25,230 --> 00:14:27,440
ذئب فضيّ بجناحين إذن

186
00:14:28,320 --> 00:14:30,360
يا له من كيانٍ أسطوريّ

187
00:14:31,240 --> 00:14:36,370
كلّما عظِم شأن الكيان الزائف، جمّلوه في أعين الآخرين كي يصدّقوا به

188
00:14:38,910 --> 00:14:42,130
إن أوغامي شيرو هو الذئب الفضيّ الحق

189
00:14:42,710 --> 00:14:44,250
وهذا منذ ألف عام

190
00:14:44,340 --> 00:14:45,960
ألف عام؟

191
00:14:46,340 --> 00:14:48,590
أتقصدين أنّه حيّ منذ ألف عام؟

192
00:14:48,670 --> 00:14:49,470
صحيح

193
00:14:49,870 --> 00:14:52,340
ولكنّه لا يبدو هرِمًا بالنسبة لي

194
00:14:52,800 --> 00:14:57,980
لا يبدو هرِمًا لأنّه ما عاد يشيخ منذ أن صار الذئب الفضّي

195
00:14:58,350 --> 00:14:59,980
منذ أن صار الذئب الفضّي؟

196
00:15:00,060 --> 00:15:03,400
،لم يكن أوغامي-كن الذئب الفضيّ منذ البداية

197
00:15:05,650 --> 00:15:07,940
إنّها قصة طويلة

198
00:15:10,950 --> 00:15:16,240
منذ ألف عام، مدينة في أقصى
شرق أوروبا تدعى نيرفازيل

199
00:15:16,330 --> 00:15:21,370
كان يعيش فيها الهجان فقط مثل مدينة أنيما

200
00:15:22,290 --> 00:15:26,880
وعاش هو فيها كذلك، ولكنّه وقتها كان مجرّد هجين ذئب عادي

201
00:15:27,780 --> 00:15:34,850
،كان البشر والهجان وقتها على ودادٍ وسواسية

202
00:15:35,890 --> 00:15:37,060
،ولكن في أحد الأيّام

203
00:15:37,850 --> 00:15:43,060
،هاجم جيش من البشر مدينة نيرفازيل على حين غرّة

204
00:15:49,280 --> 00:15:51,570
،أُبيدت عشيرته

205
00:15:56,120 --> 00:15:57,580
ولاقى هو المصير ذاته كذلك

206
00:16:12,630 --> 00:16:17,100
،وتُركت جثّته والجثث الأخرى في العراء تتعفّن

207
00:16:22,390 --> 00:16:24,650
،وحينها حدثت ظاهرة غامضة

208
00:16:48,130 --> 00:16:50,670
،وما زال سببها مجهولًا

209
00:16:51,300 --> 00:16:54,260
..إذ إنّ دماء إخوانه وأخواته النيرفازيليين الألفين

210
00:16:54,800 --> 00:16:57,340
منحته جسدًا خالدًا

211
00:16:57,850 --> 00:16:59,760
وهذا ما يؤمن به هو

212
00:17:00,350 --> 00:17:01,220
غير معقول

213
00:17:01,850 --> 00:17:04,100
،وبقوّته من بعد أن صار الذئب الفضيّ

214
00:17:04,180 --> 00:17:07,350
،صار يجول باحثًا عن القائد الذي فتك بعشيرته

215
00:17:07,440 --> 00:17:11,230
لاحق الجيش البشري وقتل منهم العديد

216
00:17:11,730 --> 00:17:15,150
ولكنّه لم يعثر قطّ على ذاك القائد

217
00:17:27,210 --> 00:17:29,750
،ومن بعد أن أدرك أنّ ثأره بلا جدوى

218
00:17:29,840 --> 00:17:33,010
صار حامي الهجان

219
00:17:33,880 --> 00:17:37,130
،أحيانًا يحميهم من اضطهاد البشر

220
00:17:37,220 --> 00:17:40,220
وأحيانًا أخرى يقودهم إلى أرض موعودة أخرى

221
00:17:40,720 --> 00:17:43,100
لا شكّ أنّه هكذا بدأت أسطورة الذئب الفضيّ

222
00:17:43,770 --> 00:17:46,020
..تقابلنا أنا وهو لأوّل مرّةٍ

223
00:17:47,020 --> 00:17:50,060
في أوروبا وفي نهاية الحرب العالميّة الثانية

224
00:17:52,150 --> 00:17:56,320
،أرادت بعض الدول دراسة قوى الهجان

225
00:17:56,400 --> 00:17:58,490
بغيّةً استعمالها أسلحةً حيويّة

226
00:17:58,910 --> 00:18:01,530
،أُلقيَ القبض على أولئك الهجان في تلك الدول

227
00:18:01,620 --> 00:18:05,410
وزُجّ بهم في معتقلاتهم
وأُجريت عليهم تجارب مرارًا وتكرارًا

228
00:18:16,510 --> 00:18:20,340
،أنقذنا الذئب الفضيّ في ذاك الوقت

229
00:18:22,720 --> 00:18:27,680
ولكن عندما رأى حالة الهجان الذين
،أُجريت عليهم تجارب المزريّة

230
00:18:28,190 --> 00:18:31,480
قتل بوحشيّة كلّ من كان يعمل في تلك المؤسسة البحثيّة

231
00:18:32,650 --> 00:18:37,240
ومذاك الحين لم يتحوّل إلى هيئة الذئب الفضيّ

232
00:18:39,780 --> 00:18:44,990
خشيةً منها ولهذا لم يظهرها للنور قطّ

233
00:18:45,950 --> 00:18:49,870
ولهذا لا تخبري أحدًا أنّه هو الذئب الفضيّ، فهمتِ؟

234
00:18:52,000 --> 00:18:53,180
لم أفهم

235
00:18:53,230 --> 00:18:53,590
ماذا؟

236
00:18:54,250 --> 00:18:59,510
لم أفهم الأمر تمامًا، ولهذا لن يغيّر ما قلتِه شيئًا

237
00:19:00,130 --> 00:19:03,390
،بالنسبة لي هو أوغامي شيرو لا غير

238
00:19:04,010 --> 00:19:08,430
الشابّ الفظّ الذي يحمي مدينة أنيما بلا هوادة

239
00:19:09,810 --> 00:19:10,770
،أصبتِ

240
00:19:11,440 --> 00:19:14,110
..هذا التفكير الصائب، بل

241
00:19:14,690 --> 00:19:15,940
هذا ما عليكِ فعله

242
00:19:17,150 --> 00:19:18,030
!أجل

243
00:19:20,530 --> 00:19:23,450
،ناضلتُ لأكون عالمةً بعد أن نجوتُ

244
00:19:23,870 --> 00:19:29,160
وفكّرتُ أنّه من الضروري معرفة
أنفسنا أكثر وليس البشر فحسب

245
00:19:29,960 --> 00:19:32,460
كنّا في المنشأة نفسها

246
00:19:33,830 --> 00:19:36,460
إنّه غراب عدّل جينيًّا

247
00:19:37,050 --> 00:19:39,010
ولهذا السبب عاش طويلًا

248
00:19:41,470 --> 00:19:43,760
أُنقذ كلانا

249
00:19:45,140 --> 00:19:48,140
،سأسكت عن الأمر

250
00:19:48,850 --> 00:19:52,140
أقسم إنّي لن أخبر أحدًا أنّ شيرو-سان هو الذئب الفضيّ

251
00:19:53,150 --> 00:19:54,060
..ولكن

252
00:19:55,150 --> 00:20:00,530
ولكنني أودّ إخبار أحدٍ أعرفه أنّ الذئب الفضيّ موجودٌ حقًا

253
00:20:02,400 --> 00:20:03,320
!أرجوك

254
00:20:05,320 --> 00:20:07,330
لا أعرف هل يوافق على هذا

255
00:20:07,410 --> 00:20:08,580
لا آبه

256
00:20:10,040 --> 00:20:11,120
!شيرو-سان

257
00:20:13,250 --> 00:20:14,330
أخبريها

258
00:20:15,830 --> 00:20:16,750
!حسنًا

259
00:20:21,420 --> 00:20:22,550
هل أنت واثق؟

260
00:20:22,630 --> 00:20:25,090
ستخبرها حتى إن وقفتُ في طريقها

261
00:20:26,510 --> 00:20:30,060
يبدو أنّك تعرفها حقّ المعرفة

262
00:20:30,140 --> 00:20:32,560
لقد سبّبت لي الكثير من المتاعب أصلًا

263
00:20:35,190 --> 00:20:38,820
عليّ الذهاب كذلك، فشيء ما يشغل بالي

264
00:20:49,370 --> 00:20:50,330
ميتشيرو

265
00:21:00,960 --> 00:21:02,720
أهلًا بحضرة العمدة

266
00:21:02,830 --> 00:21:04,130
أرِني نتائج التجارب

267
00:21:04,990 --> 00:21:05,820
...ولكن

268
00:21:05,850 --> 00:21:06,800
!لا بأس

269
00:21:08,050 --> 00:21:09,100
...ولكن

270
00:21:09,180 --> 00:21:12,680
،أنت تعلم جيدًا أنّه قبل أن تصبح عمدة أنيما

271
00:21:13,100 --> 00:21:16,310
كانت أفضل دارسي الحمض النووي الحيوانيّ الصبغي

272
00:21:17,060 --> 00:21:20,940
وهي أوّل هجين ينال على شهادة الدكتوراة

273
00:21:23,030 --> 00:21:25,860
!ما هذه الطفرات التي أصابت الحمض النووي؟

274
00:21:25,950 --> 00:21:28,370
صحيح، إنّنا نحاول اكتشاف هذا كذلك

275
00:21:29,240 --> 00:21:32,290
أستعلمني إن أحرزتم أيّ تقدّم؟

276
00:21:32,790 --> 00:21:34,160
سأسعد بفعل ذلك

277
00:21:34,540 --> 00:21:38,250
من المطمئن أن يكون رئيس شركة سيلفستا للأدوية هنا

278
00:21:38,330 --> 00:21:41,250
ستتولّى أمر أيّ شيءٍ يطرأ

279
00:21:41,750 --> 00:21:44,010
لهذا السبب أنا هنا

280
00:21:47,010 --> 00:21:49,930
نعم، لهذا السبب تحديدًا

281
00:21:59,370 --> 00:22:02,860
فجأةً صار رأسًا على عقب

282
00:22:03,090 --> 00:22:06,990
عالمُنا ها قد بدأ بالتغيير

283
00:22:07,220 --> 00:22:11,390
الأمس ولّى والغد على الأبواب

284
00:22:11,420 --> 00:22:15,620
لذا أُجبرتُ على التغيير دون تخيير

285
00:22:16,030 --> 00:22:20,010
بحثًا عنك في الأرجاء أجري

286
00:22:20,010 --> 00:22:24,210
وما زلتُ عن حقيقتي لا أدري

287
00:22:24,210 --> 00:22:29,320
أبكي بحرارة ولكنّي لن أرضى بالخسارة

288
00:22:30,420 --> 00:22:32,450
أخبرني

289
00:22:32,450 --> 00:22:36,300
إلى الليالي المنيرة ننتمي

290
00:22:36,300 --> 00:22:40,640
فالتحليق في سمائها يسعد قلبي

291
00:22:40,810 --> 00:22:44,730
فهيّا نجُب العالم وإلى أقاصيه نمشي

292
00:22:44,730 --> 00:22:48,130
مسحورين بنجوم السما