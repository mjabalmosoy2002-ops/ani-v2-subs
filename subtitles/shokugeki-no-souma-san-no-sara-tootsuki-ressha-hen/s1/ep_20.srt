1
00:00:03,350 --> 00:00:07,190
،تادوكورو ميغومي وتاكومي ألديني
.إضافة إلى دوجيما غين

2
00:00:07,190 --> 00:00:09,320
.سوف تشكّلون فريق دوجيما

3
00:00:09,750 --> 00:00:13,650
يوكيهيرا سوما وناكيري إرينا
.وسايبا جويتشيرو أيضًا

4
00:00:13,650 --> 00:00:15,660
.سوف تشكّلون فريق سايبا

5
00:01:55,930 --> 00:02:01,260
.وهكذا، سيُقام شوكوغيكي للفِرق في جزيرة ريبون

6
00:02:01,650 --> 00:02:02,450
ما رأيكم؟

7
00:02:02,450 --> 00:02:04,050
هل يمانع أيّ منكم هذا؟

8
00:02:04,050 --> 00:02:05,720
.لا مانع لديّ

9
00:02:05,720 --> 00:02:07,660
ماذا عنكم؟

10
00:02:07,660 --> 00:02:08,690
هل أنت موافق؟

11
00:02:08,690 --> 00:02:10,560
!شوكوغيكي للفِرق

12
00:02:10,560 --> 00:02:12,130
!كم هذا جريء

13
00:02:12,130 --> 00:02:13,480
.لكنّها ليست فكرة سيّئة

14
00:02:13,480 --> 00:02:16,650
إنّها فرصة جيّدة للقضاء على
.أولئك الّذين يعارضون المركز

15
00:02:17,380 --> 00:02:17,780
.نعم

16
00:02:18,280 --> 00:02:19,950
.لقد هزمتُك ثانية يا سو-ميان

17
00:02:21,280 --> 00:02:23,430
.أظنّها فكرة جيّدة أيضًا

18
00:02:23,430 --> 00:02:26,890
.يمكننا هزيمة كلّ المتمرّدين دفعة واحدة

19
00:02:26,890 --> 00:02:28,210
أليس كذلك يا بوتشي؟

20
00:02:28,870 --> 00:02:30,690
!دعوني أنضمّ للقتال أيضًا

21
00:02:30,690 --> 00:02:33,860
يجب أن أكون الشّخص
!الّذي سيسحق يوكيهيرا سوما

22
00:02:33,860 --> 00:02:35,570
لكن هل ستكون بخير يا إيزان؟

23
00:02:35,570 --> 00:02:36,160
ماذا؟

24
00:02:36,160 --> 00:02:37,340
ما الّذي تقوله يا تسوكاسا-سان؟

25
00:02:37,340 --> 00:02:37,720
...حسنًا

26
00:02:37,720 --> 00:02:40,710
أظنّ فقط أنّه لن يكون في صالحنا
.إن خسرتَ ثانية

27
00:02:41,890 --> 00:02:43,510
!أيّها الغبيّ تسوكاسا

28
00:02:43,510 --> 00:02:45,320
ماذا يا ريندو؟

29
00:02:45,320 --> 00:02:48,520
!ألا تملك أيّ تعاطف لزملائك الأصغر؟

30
00:02:48,520 --> 00:02:53,000
لقد تكبّد إيزان هزيمة ساحقة
!على يد شقيّ من السّنة الأولى

31
00:02:53,000 --> 00:02:56,030
!اشعر بالأسف حياله، مفهوم؟! كن لطيفًا معه

32
00:02:56,030 --> 00:02:58,120
.يا لك من مسكين يا إيزان

33
00:02:59,130 --> 00:02:59,710
!مهلاً

34
00:02:59,710 --> 00:03:01,110
!ذلك هاتفي

35
00:03:04,840 --> 00:03:06,490
.أكره كم أنّك همجيّ

36
00:03:07,930 --> 00:03:09,330
سيكون لدينا أربعة خصوم؟

37
00:03:09,710 --> 00:03:12,460
إذًا سيكون علينا مواجهتهم بنفس العدد؟

38
00:03:12,810 --> 00:03:15,420
.نعم، هذه خطّة ممكنة

39
00:03:15,860 --> 00:03:18,580
.لكن لنقدّم كلّ ما لدينا نظرًا لهذه المناسبة

40
00:03:21,030 --> 00:03:25,890
لا يتواجد العمل الجماعيّ في المطبخ
.إلاّ بعد سنين عدّة من التّدريب

41
00:03:26,320 --> 00:03:28,560
ومع ذلك، نرى نتائج جيّدة معهم
.دون التّحدّث بكلمة واحدة

42
00:03:28,560 --> 00:03:29,480
.بالفعل

43
00:03:29,480 --> 00:03:32,940
أتساءل إن كان أيّ واحد من الفريقين
.قادرًا على إنهاء الطّبق من الأساس

44
00:03:32,940 --> 00:03:35,560
،"سنُعدّ طبق "هاشي بارمونتيي

45
00:03:35,560 --> 00:03:39,650
طبق نُعدّه من طبقات من البطاطس
...المهروسة والجبن وصلصة اللّحم، لكن

46
00:03:39,990 --> 00:03:44,620
لماذا لديه أنشوفة وريحان
وصحن تقديم مسطّح؟

47
00:03:47,530 --> 00:03:50,290
.سوف أتحدّاك في شوكوغيكي في نهاية المطاف

48
00:03:50,600 --> 00:03:52,910
أقسم أنّني سأسوّي حسابي معك

49
00:03:52,910 --> 00:03:55,750
من مباراتنا في اليوم الأوّل من المخيّم
!خلال انتخابات الخريف

50
00:03:56,190 --> 00:03:58,440
،بعد كلّ ذلك الحديث

51
00:03:58,440 --> 00:04:00,350
.خسرتُ قبل أن أتمكّن حتّى من مواجهته ثانية

52
00:04:00,350 --> 00:04:04,590
حتّى أنّه استعاد السّكّين المهمّة
.أكثر من حياتي من أجلي

53
00:04:04,950 --> 00:04:07,050
!سُحقًا، سُحقًا

54
00:04:07,780 --> 00:04:09,270
!سُحقًا

55
00:04:09,270 --> 00:04:11,810
!عليّ أن أتغيّر

56
00:04:12,250 --> 00:04:16,270
أنا تاكومي ألديني، تلميذ من السّنة
.الأولى الثّانويّة في أكاديميّة توتسكي

57
00:04:16,630 --> 00:04:18,020
!أتيت إلى هنا من أجل الفترة التّدريبيّة

58
00:04:18,380 --> 00:04:19,730
.شكرًا لاستضافتي

59
00:04:21,060 --> 00:04:21,690
!تاكومي

60
00:04:22,090 --> 00:04:24,570
!جهّز عشرين طبقًا، في الحال

61
00:04:24,570 --> 00:04:24,910
!حاضر

62
00:04:24,910 --> 00:04:30,350
صُدمتُ لأنّ المدير قد سمح لتلميذ بالدّخول
.للمطبخ بعد أوّل أو ثاني يوم فقط

63
00:04:30,350 --> 00:04:32,390
.لقد حقّق ذلك من خلال تلكما العينين

64
00:04:32,390 --> 00:04:36,710
.ثمّة عزيمة متّقدة في تلكما العينين الزّرقاوين

65
00:04:37,050 --> 00:04:41,670
.عليّ تدمير ما أعتبره طبخ ألديني

66
00:04:41,670 --> 00:04:44,510
!عليّ تحطيم من كنتُه في الماضي

67
00:04:45,760 --> 00:04:49,470
.خلّ النّبيذ الأبيض وزيت زيتون وخلاّط

68
00:04:49,470 --> 00:04:51,240
.فهمت

69
00:04:51,240 --> 00:04:53,720
،إن كان الطّبق سيُقدّم على صحن
!فستكون ثمّة حاجة لصلصة ما

70
00:04:53,720 --> 00:04:58,900
.لقد طلب الطّاهي دوجيما صلصة أنشوفة

71
00:05:00,490 --> 00:05:01,570
،إنّها سوفريتّو

72
00:05:02,000 --> 00:05:04,370
.عجينة تُستعمل في المطبخ الإيطاليّ

73
00:05:04,370 --> 00:05:09,870
تُعد عن طريق قلي البصل والثّوم ببطء مع
.الفلفل الأحمر والأخضر في زيت زيتون

74
00:05:09,870 --> 00:05:14,870
تشبه كثيرًا ميربوا البصل والجزر والكزبرة
.المُستعملة في المطبخ الفرنسيّ

75
00:05:14,870 --> 00:05:18,510
لكنّ الفلفل المُضاف في السّوفريتّو الإيطاليّة

76
00:05:18,510 --> 00:05:21,840
يُعطي عجينة أحلى وأغنى تتماشى
.جيّدًا مع صلصة الطّبق

77
00:05:21,840 --> 00:05:25,850
."لكنّ السّوفريتّو لا تُستعمل في "هاشي بارمونتيي

78
00:05:27,350 --> 00:05:29,650
هل يحاول توصيل جوابه لارتجال الطّاهي دوجيما

79
00:05:29,650 --> 00:05:32,720
عن طريق ارتجال شيء بنفسه
لتعزيز مذاق الطّبق أكثر؟

80
00:05:34,500 --> 00:05:36,330
.لقد تطوّر

81
00:05:36,330 --> 00:05:40,860
أستطيع الإحساس بتصميم جديد
.يوشك أن يكون هوسًا عنده

82
00:05:41,770 --> 00:05:43,940
لماذا التّردّد يا يوكيهيرا؟

83
00:05:44,400 --> 00:05:47,450
.هدفنا هو إعادة إيسامي والبقيّة إلى توتسكي

84
00:05:47,820 --> 00:05:50,160
ومع ذلك ستسمح لنفسك أن تتعثّر هنا؟

85
00:05:50,160 --> 00:05:52,830
.لا يهمّ إن كانت معركة تجريبيّة
...نحن في مطبخ

86
00:05:52,830 --> 00:05:54,870
!ساحة القتال لي ولك

87
00:05:54,870 --> 00:05:58,500
.أنت على حقّ، هذا هو تاكومي ألديني الّذي أعرفه

88
00:06:00,420 --> 00:06:02,920
!لقد حمّستني كثيرًا

89
00:06:03,290 --> 00:06:05,380
.هنالك أمر واحد فقط للقيام به هنا

90
00:06:05,700 --> 00:06:09,090
تبيُّن نوايا سايبا-ساما والاستجابة
!لها بأفضل ما لدينا

91
00:06:09,930 --> 00:06:13,310
.لدى "هاشي بارمونتيي" ثلاث مكوّنات رئيسيّة

92
00:06:13,990 --> 00:06:17,880
،صلصة لحم غنيّة بلحم مفروم بنّيّ اللّون

93
00:06:17,880 --> 00:06:20,770
،"وبطاطس مهروسة قشديّة تُدعى "بوم بيوري

94
00:06:20,770 --> 00:06:22,290
.إضافة إلى الجبن

95
00:06:22,290 --> 00:06:24,530
توضع المكوّنات على شكل طبقات
.ثمّ تُطبخ لتشكيل الطّبق النّهائيّ

96
00:06:25,000 --> 00:06:28,700
ومع ذلك، يقوم سابيا-ساما بإعداد... الفطائر؟

97
00:06:29,400 --> 00:06:30,540
ماذا يفترض أن أفعل؟

98
00:06:30,540 --> 00:06:32,450
!ماذا يريد؟

99
00:06:34,760 --> 00:06:37,830
.لا عجب أنّ مساعديه حائرين

100
00:06:42,610 --> 00:06:43,880
.الفتى صاحب المنشفة يقوم بأمر ما

101
00:06:43,880 --> 00:06:46,090
.إنّه يجهّز بطاطس وجبنة

102
00:06:46,090 --> 00:06:49,050
."هذه مكوّنات أساسيّة في "هاشي بارمونتيي

103
00:06:50,590 --> 00:06:53,770
...حسنًا، أعتقد أنّه هنا

104
00:06:53,770 --> 00:06:56,220
!أجل، ها هو

105
00:07:06,130 --> 00:07:09,360
من المستحيل أن يكون هذا الطّبق
.حتّى في نصف المستوى المطلوب

106
00:07:09,360 --> 00:07:13,030
.لا فكرة لديّ ما الّذي يفكّر به هذين الاثنين

107
00:07:14,330 --> 00:07:17,020
.كلاّ، بل تعرفين

108
00:07:17,020 --> 00:07:19,250
.تذكّري يا ناكيري إرينا

109
00:07:19,830 --> 00:07:22,000
.تذكّري ما اختبرته في مسكن النّجم القطبيّ

110
00:07:22,000 --> 00:07:25,810
لقد وجدتِ هناك أنّ الحلول غير المتوقّعة

111
00:07:25,810 --> 00:07:29,970
قد تولد من الأفكار الفوضويّة
.الّتي تتصادم فيما بينها

112
00:07:30,460 --> 00:07:33,110
.ما يقومان به الآن هو نفس الشّيء

113
00:07:33,110 --> 00:07:36,050
،فعن طريق إظهار أفكارهما وغرورهما لبعضهما

114
00:07:36,050 --> 00:07:39,430
يأملان أن يُنشئا شيئًا لا يمكن
.إنشاؤه عن طريق التّناغم

115
00:07:39,430 --> 00:07:42,900
.هذا هو التّحدّي الّذي وضعه لنا سايبا-ساما

116
00:07:43,800 --> 00:07:47,110
إنّها طريقة طبخ لا تخطر على البال
.من وجهة نظري المثاليّة

117
00:07:47,110 --> 00:07:49,320
.لا بأس، لقد فهمت

118
00:07:49,750 --> 00:07:50,780
!سأركب وإيّاكما هذه الموجة

119
00:07:50,780 --> 00:07:51,710
!ماذا؟

120
00:07:51,710 --> 00:07:52,400
!إرينا-ساما؟

121
00:07:59,290 --> 00:08:01,270
!أهذا ما يجب أن يكون عليه الطّبق؟

122
00:08:01,270 --> 00:08:06,250
"كلاّ، يفترض أن يضمّ طبق "هاشي بارمونتيي
.لحمًا مفرومًا أو مقطّعًا بعناية

123
00:08:06,900 --> 00:08:08,730
.أنا منذهل

124
00:08:08,730 --> 00:08:13,750
لطالما سعت إرينا-ساما لتأييد ما هو
.متّفق عليه في طعام نخبة الذّوّاقة

125
00:08:13,750 --> 00:08:15,970
لا أستطيع تصوّرها تتّبع طريقة
.طبخ جديدة كهذه

126
00:08:16,290 --> 00:08:23,020
قد تكون هذه هي اللّحظة
...الّتي ستبدأ فيها بالفعل

127
00:08:23,360 --> 00:08:25,900
.تدريبها الحقيقيّ الجادّ

128
00:08:31,570 --> 00:08:33,160
!انتهى الوقت

129
00:08:33,160 --> 00:08:35,030
!ليقدّم كِلا الفريقين طبقه

130
00:08:35,400 --> 00:08:38,790
!سنتذوّق طبقَيْ "هاشي بارمونتيي" الآن

131
00:08:52,010 --> 00:08:55,760
!هل هذا طبق "هاشي بارمونتيي" بالفعل؟

132
00:08:55,760 --> 00:08:58,500
الفطائر والسّردين اليافع
...المجفّف وشريحة لحم

133
00:08:58,500 --> 00:09:00,640
.لا فكرة لديّ كيف سيكون مذاقه

134
00:09:00,640 --> 00:09:05,060
لنقم بتقييم كلّ واحد من الطّبقين

135
00:09:05,060 --> 00:09:07,370
.أو هذا ما أريد قوله

136
00:09:08,020 --> 00:09:12,370
لكن في هذا النّزال، أنتم الأربعة
!من ستحدّدون النّتيجة

137
00:09:12,370 --> 00:09:13,110
!ماذا؟

138
00:09:13,110 --> 00:09:19,860
سينتهي هذا النّزال بتذوّق كلّ
!جانب لطبق الآخر

139
00:09:19,860 --> 00:09:21,080
ماذا يحدث هنا؟

140
00:09:21,080 --> 00:09:22,920
.أعتقد أنّ علينا التّذوّق فحسب

141
00:09:22,920 --> 00:09:23,780
.صحيح

142
00:09:24,450 --> 00:09:25,210
!مذهل

143
00:09:25,670 --> 00:09:27,990
.يا له من "بوم بيوري" ناعم

144
00:09:27,990 --> 00:09:32,670
إنّه أشبه بحلوى غزل بنات مثاليّة
.مصنوعة من السّحر

145
00:09:33,050 --> 00:09:36,070
يا للطّبقات الجميلة من
.بوم بيوري" وصلصة اللّحم"

146
00:09:36,070 --> 00:09:37,630
.إنّ له بنية جميلة وافرة

147
00:09:38,010 --> 00:09:42,820
يضيف التّصميم الزّاهي للصّلصة
.الخضراء جماليّة للطّبق أيضًا

148
00:09:48,370 --> 00:09:50,540
!هنالك مكعّبات لحم بالدّاخل

149
00:09:50,540 --> 00:09:51,650
...هذه

150
00:09:51,650 --> 00:09:53,280
...إنّه ساخن، لكن

151
00:09:53,280 --> 00:09:57,430
،نعم. من المستحيل مقاومة الرّغبة في أكله
.رغم أنّه يكاد يحرق اللّسان

152
00:09:58,240 --> 00:10:01,240
..."هذه واحدة من إغراءات "هاشي بارمونتيي

153
00:10:02,650 --> 00:10:05,030
.الثّابتة والّتي لا تتغيّر

154
00:10:13,340 --> 00:10:15,270
ماذا عنكم أنتم؟

155
00:10:15,270 --> 00:10:16,760
.تذوّقوا الطّبقين رجاءً

156
00:10:23,890 --> 00:10:25,470
!كيف يعقل أن يكون مذاقه هكذا؟

157
00:10:25,470 --> 00:10:27,930
!هذه هي قوّة توتسكي إذًا

158
00:10:27,930 --> 00:10:30,930
أيّ الفريقين فاز إذًا؟

159
00:10:30,930 --> 00:10:33,770
!أشيروا إلى المنتصر

160
00:10:41,280 --> 00:10:41,910
!مستحيل

161
00:10:43,870 --> 00:10:45,530
ماذا يحدث؟

162
00:10:45,530 --> 00:10:48,120
هل اعترف كِلا الفريقين بهزيمتهما؟

163
00:10:54,200 --> 00:10:58,800
في المطاعم الفاخرة، نجد أنّ صلصة
.اللّحم عبارة عن حساء لحم مفروم

164
00:10:58,800 --> 00:11:03,260
بينما في طبقكم، تشكّل صلصة اللّحم
.أساسًا متينًا للنّكهة

165
00:11:03,260 --> 00:11:07,520
منحت سوفريّتو ألديني-كُن حلاوة
!أكثر عُمقًا للّحم المفروم

166
00:11:07,950 --> 00:11:11,650
كما استُعملت السّوفريتّو
.في الصّلصة الإسبانيّة أيضًا

167
00:11:12,070 --> 00:11:14,650
لا بدّ أنّ ذلك كان إلهامًا
من تادوكورو-سان، صحيح؟

168
00:11:14,650 --> 00:11:16,010
.هذا مذهل

169
00:11:16,010 --> 00:11:18,930
وفي النّهاية، صلصة الأنشوفة
،الّتي استُعلمت لتمييز الطّبق

170
00:11:18,930 --> 00:11:21,660
وُضعت على شكل نقاط
ممّا أنشأ نكهة مختلفة

171
00:11:21,990 --> 00:11:23,740
.إضافة للمسة جماليّة

172
00:11:24,520 --> 00:11:25,770
...إن كان عليّ تشبيه الأمر

173
00:11:25,770 --> 00:11:29,120
فإنّه أقرب إلى الاستماع إلى عزف
،لفرقة جاز تخلو من أيّ عيوب

174
00:11:29,120 --> 00:11:31,730
حيث التّناغم والانسجام يتألّقان
،بصمت بين كلّ ذلك الارتجال

175
00:11:31,730 --> 00:11:34,960
.ويضيف قائد الفرقة إيقاعًا ممتعًا بالطّبول

176
00:11:34,960 --> 00:11:36,580
.لستُ مقتنعًا

177
00:11:37,940 --> 00:11:41,330
ماذا عن إعادة التّفسير الجريئة للمكوّنات الثّلاثة
الأساسيّة لـ"هاشي بارمونتيي" في طبقكم

178
00:11:41,330 --> 00:11:45,970
الّتي فتحت الباب لعالم جديد
تمامًا من الاحتمالات؟

179
00:11:46,330 --> 00:11:50,180
توقّع يوكيهيرا أنّ جويتشيرو-سان
،كان ينوي تغليف المكوّنات بالفطيرة

180
00:11:50,560 --> 00:11:54,350
وفكّر في إعداد "بوم غاليت" بالجبن
والبطاطس والسّردين المجفّف

181
00:11:54,760 --> 00:11:58,820
."لإضافتها في الفطيرة مع "بوم بيوري

182
00:11:58,820 --> 00:12:04,780
سمح ذلك للطّبق بامتلاك قوام مقرمش وكثير المضغ
.ونكهة بحريّة ما كان ليمتلكهما بطريقة أخرى

183
00:12:05,200 --> 00:12:07,740
ولا أصدّق أنّ ناكيري-سان أضافت
!ابتكارًا خاصًّا بها أيضًا

184
00:12:07,740 --> 00:12:10,100
.نعم، لقد تفاجأت كثيرًا

185
00:12:10,100 --> 00:12:14,790
لقد طبخت "أونتركوت" جيّدًا
،وهي واحدة من أفخر قطع اللّحم

186
00:12:14,790 --> 00:12:18,170
ثمّ أعدّت صلصة عن طريق طبخ
قنّينة كاملة من نبيذ "بوردو" ببطء

187
00:12:18,170 --> 00:12:21,340
،لتصبح صلصة "بوردوليز" مركّزة للّحم
!وتمّ وضع كلّ شيء داخل الفطيرة

188
00:12:21,340 --> 00:12:25,920
صحيح، إنّها "صلصة لحم" خاصّة
!لديها نكهة لحم لا يمكن نكرانها

189
00:12:25,920 --> 00:12:28,350
كان جوابها للموضوع الّذي قُدّم لنا
!هو إضافة قوام أكثر للطّبق

190
00:12:28,350 --> 00:12:30,020
...إن كان عليّ وصف الأمر

191
00:12:32,710 --> 00:12:36,470
،فإنّه جدير بأن يُسمّى فنًّا حديثًا
وهو تعاون أثاره

192
00:12:36,470 --> 00:12:41,110
سعي قائد الفريق لدفع كلّ الفنّانين
!المختلفين لإظهار أفكارهم

193
00:12:42,280 --> 00:12:45,270
.لكنّ الصّلصة كانت غريبة لحدّ كبير

194
00:12:45,270 --> 00:12:48,820
كان الطّبق ليكون متماسكًا أكثر إن تعاملت
.مع نكهة السّردين بشكل أفضل

195
00:12:48,820 --> 00:12:49,870
!ماذا تقولين؟

196
00:12:49,870 --> 00:12:51,620
!كانت فكرة رائعة

197
00:12:51,620 --> 00:12:53,710
!نعم، كانت رائعة بالفعل

198
00:12:54,040 --> 00:12:56,030
ناكيري-سان، كانت تعلو وجهك
.ابتسامة كبيرة وأنتِ تطبخينه

199
00:12:56,030 --> 00:12:56,560
.نعم

200
00:12:56,560 --> 00:12:58,920
.بدوتِ وكأنّك تستمتعين حقًّا بطبخه

201
00:12:58,920 --> 00:13:01,620
!ماذا؟ لماذا تسخرون منّي جميعكم؟

202
00:13:01,620 --> 00:13:04,170
،ألديني-كُن وتادوكورو-سان
!ما فعلتُماه أنتما كان مذهلاً أكثر

203
00:13:04,170 --> 00:13:06,610
،"أقول ذلك بصفتي صاحبة "لسان الإله
!لذلك لا يوجد خطأ في الأمر

204
00:13:06,610 --> 00:13:08,850
بالكاد يمكن اعتبار طبقنا
!أنّه احترم الموضوع المقدّم

205
00:13:08,850 --> 00:13:09,890
ماذا تقولين؟

206
00:13:09,890 --> 00:13:13,520
عليك أن تفخري أكثر لتمكّنكم
!من الجمع بين مكوّنات قويّة كهذه

207
00:13:13,520 --> 00:13:14,460
،في تلك الحالة

208
00:13:14,460 --> 00:13:18,610
يجب أن تحصل تادوكورو-سان على الثّناء الأسمى
!لتقديمها لدعم قويّ من خلف الكواليس

209
00:13:18,610 --> 00:13:20,360
!ذ-ذ-ذلك ليس صحيحًا

210
00:13:20,360 --> 00:13:21,680
!بل صحيح تمامًا

211
00:13:21,680 --> 00:13:24,070
!أنت مذهلة أيضًا يا تادوكورو

212
00:13:24,070 --> 00:13:27,860
بهدف امتلاك عمل جماعيّ
،في شوكوغيكي الفِرق

213
00:13:27,860 --> 00:13:32,790
من الضّروريّ لكلّ عضو أن يختبر
.قدرات الآخرين مباشرة

214
00:13:32,790 --> 00:13:35,090
سمح هذا النّزال لهم بإدراك ما التّحدّيّات
الّتي على كلّ واحد منهم تخطّيها

215
00:13:33,350 --> 00:13:34,880
.أنتم الفائزون

216
00:13:34,880 --> 00:13:36,920
.القرار ليس بيدك

217
00:13:35,090 --> 00:13:41,750
وما التّقنيات والعزيمة
.الّتي اكتسبوها نتيجة لذلك

218
00:13:36,920 --> 00:13:38,470
.اقبلي الأمر فحسب

219
00:13:38,470 --> 00:13:41,050
.حسنًا، لنقل أنّ مذاق كِلا طبقينا كان رائعًا

220
00:13:41,050 --> 00:13:41,750
.نعم

221
00:13:41,750 --> 00:13:44,710
.لقد نجح التّدريب بشكل كامل

222
00:13:44,710 --> 00:13:46,820
.إنّه تعادل إذًا

223
00:13:46,820 --> 00:13:47,550
.نعم

224
00:13:47,550 --> 00:13:51,000
.إرينا، كان ذلك طبقًا مثيرًا للاهتمام

225
00:13:51,000 --> 00:13:53,160
.بدوتِ أنّك تستمتعين بوقتك

226
00:13:53,160 --> 00:13:55,520
!لا تسخر منّي أيضًا يا جدّي

227
00:13:56,100 --> 00:13:59,040
.لقد ألهمني سايبا-ساما ويوكيهيرا-كُن فحسب

228
00:13:59,040 --> 00:14:00,890
—إن كنتُ وحدي، ما كنتُ لأستطيع أن

229
00:14:00,890 --> 00:14:04,990
.بالفعل، هكذا يقوم هذين الاثنين بتحفيز بعضهما

230
00:14:04,990 --> 00:14:10,820
بالنّسبة لتلك العائلة، فإنّ التّصادم
.الّذي حدث بينهما قبل قليل أمر عاديّ

231
00:14:10,820 --> 00:14:13,800
لذلك السّبب لم يخف يوكيهيرا سوما من هذا النّزال

232
00:14:13,800 --> 00:14:18,210
.وجعل جويتشيرو يتقبّل مساهماته

233
00:14:18,890 --> 00:14:24,170
لكنّني ما كنت أبدًا لأحلم بفعل
.شيء كهذا مع والدي

234
00:14:24,870 --> 00:14:26,820
.لا أتصوّر طلبي خدمة كهذه منه

235
00:14:26,820 --> 00:14:29,630
لماذا لا تطلبين؟

236
00:14:29,960 --> 00:14:31,540
.أنت ابنته

237
00:14:31,540 --> 00:14:34,950
.عليك تعلّم أن تكوني أنانيّة أحيانًا يا إرينا

238
00:14:38,550 --> 00:14:42,270
سايبا-سينباي والبقيّة على متن
.تسوكيكاغي رقم 4

239
00:14:42,900 --> 00:14:47,650
.تلتقي هنا طريقهم بطريق أخرى مختلفة

240
00:14:47,970 --> 00:14:50,130
سنقابلهم هنا غدًا

241
00:14:50,130 --> 00:14:53,560
.وسنحدّد قوانين النّزال

242
00:14:56,330 --> 00:14:57,650
...إرينا

243
00:14:57,650 --> 00:14:59,960
.أتساءل  إن استمتعت بوقت لعبك في الخارج

244
00:15:00,870 --> 00:15:03,420
.حان الوقت لسماع ما لديك لتقوليه

245
00:15:16,900 --> 00:15:18,730
.سنجتمع هنا إذًا لتحديد القواعد

246
00:15:18,730 --> 00:15:21,600
هل هذا هو المكان بالفعل؟
.إنّنا في بقعة نائية ومجهولة

247
00:15:21,600 --> 00:15:24,720
أين هم خصومنا إذًا؟

248
00:15:24,720 --> 00:15:26,570
!هناك، انظروا

249
00:15:34,520 --> 00:15:36,530
.كانت هذه طريقة أسرع للوصول

250
00:15:37,110 --> 00:15:39,790
.سوف يصل البقيّة قريبًا أيضًا

251
00:15:49,780 --> 00:15:51,630
.وصلنا جميعنا الآن

252
00:15:51,630 --> 00:15:53,140
.البرد قارس

253
00:15:53,140 --> 00:15:54,510
.لننتهِ من هذا بسرعة

254
00:15:55,540 --> 00:15:59,270
يوجد هنا كلّ أعضاء النّخبة العشرة
.السّتّة الخائنين على ما يبدو

255
00:15:59,270 --> 00:16:01,980
إيزان-سينباي، مرّ وقت طويل
—منذ الشّوكوغيكي الأخير

256
00:16:01,980 --> 00:16:05,600
!سأسحقك

257
00:16:02,690 --> 00:16:03,600
...عفوًا

258
00:16:04,380 --> 00:16:04,800
...لكن

259
00:16:05,600 --> 00:16:06,080
.حسنًا

260
00:16:06,080 --> 00:16:06,820
!سأسحقك

261
00:16:06,820 --> 00:16:08,820
...سأسحقك، سأسحقك، سأسحقك

262
00:16:07,560 --> 00:16:08,820
.نواياه واضحة وضوح الشّمس

263
00:16:10,260 --> 00:16:11,410
.ابدئي يا كينوكوني

264
00:16:11,410 --> 00:16:11,900
.حسنًا

265
00:16:11,900 --> 00:16:14,330
،بمجرّد انتهاء المرحلة الأخيرة من الامتحانات

266
00:16:14,330 --> 00:16:16,780
سيتمّ تجهيز قاعة امتحان خاصّة
في أقصى جنوب جزيرة ريبون

267
00:16:16,780 --> 00:16:19,290
.لتكون السّاحة الّتي سيقام فيها شوكوغيكي الفِرق

268
00:16:19,640 --> 00:16:22,760
إنّ التّلاميذ الّذين يواصلون سفرهم شمالاً
،بينما ينجحون في امتحانات التّقدّم

269
00:16:22,760 --> 00:16:26,290
إضافة لأيّ ضيوف تمّت دعوتهم
.مرحّب بهم لحضور النّزال

270
00:16:26,290 --> 00:16:29,430
.فعلاً؟ سوف تحوّلون الأمر إلى عرض

271
00:16:29,430 --> 00:16:33,170
.نعم، الهدف هو التّشهير بهزيمتنا نحن المتمرّدين

272
00:16:34,280 --> 00:16:35,720
.حسنًا جدًّا

273
00:16:35,720 --> 00:16:40,970
هل نوافق على أنّ الفريق الفائز
سيحتلّ كلّ مقاعد النّخبة العشرة؟

274
00:16:40,970 --> 00:16:42,550
.لا اعتراضات لديّ

275
00:16:42,550 --> 00:16:46,350
دعونا لا نضع أيّ حدود لعدد الأعضاء
.الّذين سيشاركون في كلّ فريق

276
00:16:46,350 --> 00:16:48,770
،هذه ميزة خاصّة لشوكوغيكي الفِرق

277
00:16:49,210 --> 00:16:52,610
وقد شارك سايبا-سينباي سابقًا
في نزال واحد ضدّ خمسين، صحيح؟

278
00:16:52,610 --> 00:16:53,740
فعلاً؟

279
00:16:55,000 --> 00:16:57,160
،إن كان لديكم داعمون آخرين

280
00:16:57,160 --> 00:17:00,660
.فلا أهتمّ حتّى إن أحضرتم خمسين أو مائة منهم

281
00:17:01,030 --> 00:17:03,800
،بما أنّ جلّ المتمرّدين قد فُصلوا الآن

282
00:17:03,800 --> 00:17:05,940
.أتصوّر أنّ الوضع سيكون صعبًا

283
00:17:06,620 --> 00:17:09,360
.أنت في مزاج جيّد للغاية يا أزامي

284
00:17:09,360 --> 00:17:12,810
لكن إن فاز يوكيهيرا والآخرون
،وأصبحوا أعضاء في النّخبة العشرة

285
00:17:12,810 --> 00:17:14,720
.فبإمكانهم استبعادك من منصبك كمدير

286
00:17:15,200 --> 00:17:16,920
،سيتمّ حلّ المركز

287
00:17:16,920 --> 00:17:20,750
.وما تسمّيه ثورة سيذهب مهبّ الرّيح

288
00:17:20,750 --> 00:17:23,930
.وإن فزنا، كلّ المتمرّدين سيُفصلون

289
00:17:24,300 --> 00:17:27,770
.وسيصبح سايبا-سينباي حليفي

290
00:17:27,770 --> 00:17:30,610
.لا يوجد ما قد يُسعدني أكثر من هذا

291
00:17:30,610 --> 00:17:32,370
.معك حقّ

292
00:17:32,370 --> 00:17:34,610
.وإن خسروا، سأقفل مطعم يوكيهيرا أيضًا

293
00:17:35,300 --> 00:17:36,730
،اعذروني على المقاطعة

294
00:17:36,730 --> 00:17:40,680
كلّ ما نفكّر به هنا هو كيفية
.إعادة أصدقائنا للأكاديميّة

295
00:17:41,280 --> 00:17:43,290
!لهذا السّبب نخوض هذا الشّوكوغيكي

296
00:17:43,290 --> 00:17:44,610
!هذا صحيح

297
00:17:44,610 --> 00:17:46,370
.إيّاكم ونسيان ذلك

298
00:17:46,740 --> 00:17:48,330
.أنا مدرك لذلك

299
00:17:48,330 --> 00:17:49,410
ماذا؟

300
00:17:49,410 --> 00:17:50,790
كُتيّبات تلاميذ؟

301
00:17:50,790 --> 00:17:54,200
أيعقل أنّها لأصدقائنا الّذين هُزموا
في المرحلة الثّالثة من الامتحانات؟

302
00:17:54,760 --> 00:17:57,550
.لم يعودوا بحاجة لهذه بعد الآن

303
00:17:57,550 --> 00:17:59,390
.لقد جعلتهم يسلّمونها لي

304
00:17:59,810 --> 00:18:03,140
.إنّها تمثّل هويّتنا كتلاميذ في توتسكي

305
00:18:03,640 --> 00:18:05,190
!مهلاً، ماذا تظنّ نفسك فاعلاً؟

306
00:18:05,190 --> 00:18:07,350
!أعد إليّ بوتشي يا سو-ميان

307
00:18:07,350 --> 00:18:10,690
لنعامل كتيّباتنا بنفس الطّريقة بما أنّها
.تمثّل حياتنا بصفتنا النّخبة العشرة

308
00:18:11,040 --> 00:18:12,500
!أنت فظيع

309
00:18:12,500 --> 00:18:16,510
كيف تجرؤ على استعمال بوتشي كحقيبة تسوّق؟

310
00:18:16,510 --> 00:18:20,050
.رأيتك تمزّقينه وتشدّينه مرّات عدّة
.لذلك لا يحقّ لك قول ذلك

311
00:18:20,050 --> 00:18:21,660
...سايتو-سينباي

312
00:18:21,660 --> 00:18:24,490
.يجب إقامة نزال عادل ومنصف دائمًا

313
00:18:24,490 --> 00:18:28,160
!إظهار عزيمتنا للقيام بذلك هي روح السّاموراي

314
00:18:29,720 --> 00:18:32,210
.واجهونا إن أردتم استعادة كتيّباتكم

315
00:18:32,210 --> 00:18:33,710
.سنواجهكم بكلّ ما أوتينا

316
00:18:34,150 --> 00:18:36,170
.سنبقي كتيّبات التّلاميذ في مأمن

317
00:18:37,670 --> 00:18:39,770
.بالمناسبة يا إرينا

318
00:18:39,770 --> 00:18:44,180
ستشاركين طبعًا في شوكوغيكي
.الفِرق كواحدة من أعضاء فريقنا

319
00:18:45,680 --> 00:18:47,780
تمهّل. ما الّذي تقوله؟

320
00:18:47,780 --> 00:18:50,580
لماذا يحقّ لك تحديد ذلك يا ناكامورا-سينباي؟

321
00:18:50,580 --> 00:18:53,330
.أنا من عليه قول ذلك الكلام

322
00:18:53,330 --> 00:18:57,510
المدير ومجلس النّخبة العشرة
.يشكّلون إدارة المركز

323
00:18:57,510 --> 00:19:00,170
،بعبارات أخرى وبصفتها صاحبة المقعد العاشر

324
00:19:00,170 --> 00:19:03,410
.فإنّ إرينا جزء من المركز حسب التّسلسل الإداريّ

325
00:19:03,410 --> 00:19:06,180
.من المتوقّع تمامًا أن تواجه المتمرّدين

326
00:19:06,180 --> 00:19:06,910
...مستحيل

327
00:19:07,440 --> 00:19:09,570
.وقتك كهاربة قد انتهى يا إرينا

328
00:19:09,570 --> 00:19:10,750
.عودي

329
00:19:10,750 --> 00:19:14,210
.حان الوقت لتكفّي عن التّصرّف بأنانيّة

330
00:19:14,210 --> 00:19:15,170
!ناكيري-سان

331
00:19:15,790 --> 00:19:16,970
...هذا سيّئ

332
00:19:16,970 --> 00:19:19,550
.لا حول ولا قوّة لناكيري في مواجهة والدها

333
00:19:23,140 --> 00:19:24,390
...يا والدي

334
00:19:28,100 --> 00:19:29,480
أخذت نفسًا عميقًا؟

335
00:19:32,930 --> 00:19:34,350
!أخذت واحدًا آخر

336
00:19:34,350 --> 00:19:35,460
!وثالثًا

337
00:19:36,120 --> 00:19:37,210
!ورابعًا

338
00:19:37,620 --> 00:19:38,690
!أخذت الكثير الأنفاس العميقة

339
00:19:43,620 --> 00:19:46,280
.أفهم وجهة نظرك يا والدي

340
00:19:46,280 --> 00:19:51,460
لذلك، أعلن أنّني أتخلّى عن كلّ مسؤوليّاتي
!كصاحبة المقعد العاشر في النّخبة العشرة

341
00:19:51,460 --> 00:19:55,630
!من الآن فصاعدًا، أنا ناكيري إرينا فحسب

342
00:19:55,630 --> 00:20:00,630
وإلاّ، لن أكون قادرة على الوقوف
.إلى جانبهم بجسدي وروحي

343
00:20:00,630 --> 00:20:02,630
!تخلّت عن منصبها؟

344
00:20:05,810 --> 00:20:09,770
...لا أصدّق أنّك قد تعارضيني برأي مختلف

345
00:20:09,770 --> 00:20:11,310
.حسنًا جدًّا يا إرينا

346
00:20:11,310 --> 00:20:14,230
...ولكن، إن خسر فريقكم

347
00:20:14,620 --> 00:20:17,230
.سيكون عليك دون غيرك قبول شرط مختلف

348
00:20:17,230 --> 00:20:19,150
.سيكون الطّرد نتيجة سهلة للغاية

349
00:20:19,460 --> 00:20:23,280
.لذا سيكون عليك مساعدة المركز لبقيّة حياتك

350
00:20:23,800 --> 00:20:26,180
ستقومين بما آمرك به

351
00:20:26,180 --> 00:20:28,490
.ولن تعصيني أبدًا ثانية

352
00:20:28,930 --> 00:20:30,200
مفهوم؟

353
00:20:31,010 --> 00:20:31,910
.نعم

354
00:20:36,830 --> 00:20:38,610
...برد قارس

355
00:20:38,610 --> 00:20:41,510
.مع السّلامة يا يوكيهيرا سوما

356
00:20:42,390 --> 00:20:44,880
سيتمّ اتّخاذ القرار في هذه المسألة
.على جزيرة ريبون إذًا

357
00:20:45,220 --> 00:20:46,090
.أجل

358
00:20:53,480 --> 00:20:54,770
.يا ناكيري

359
00:20:58,730 --> 00:21:00,610
.إنّها تفيض بالأدرينالين

360
00:21:01,040 --> 00:21:03,010
هل أنت بخير يا ناكيري-سان؟

361
00:21:03,570 --> 00:21:08,040
إن فزنا بشوكوغيكي الفِرق وسحقنا
،النّخبة العشرة الحاليّين

362
00:21:08,040 --> 00:21:11,450
فسأعود للنّخبة العشرة بصفتي
!صاحبة المقعد الأوّل

363
00:21:11,450 --> 00:21:16,330
سأتوّج المنتصرة في هذه المعركة
!لأصبح الملكة الحقيقيّة للطّعام الرّاقي

364
00:21:16,330 --> 00:21:19,340
!جميعكم ستكونون خدمًا للملكة

365
00:21:19,340 --> 00:21:20,840
!اعتبروا هذا شرفًا لكم

366
00:21:21,990 --> 00:21:23,380
.كم هذا جميل

367
00:21:23,380 --> 00:21:26,550
.دور الملكة يناسبك تمامًا كما توقّعت

368
00:21:26,550 --> 00:21:28,470
.أنا سعيدة لأنّك تبدين بحال جيّدة

369
00:21:28,470 --> 00:21:30,350
...كلاّ

370
00:21:30,350 --> 00:21:32,440
!أنا من سيحتلّ الصّدارة

371
00:21:32,440 --> 00:21:34,310
!على الخدم أن يلتزموا الصّمت

372
00:21:34,310 --> 00:21:36,360
لا تستخفّي بالمطاعم الشّعبيّة
!الّتي تخدم الجموع

373
00:21:36,360 --> 00:21:38,270
هل تقول أنّك لا تستطيع احترام "لسان الإله"؟

374
00:21:38,270 --> 00:21:39,380
!ماذا؟

375
00:21:39,380 --> 00:21:40,170
!أبي

376
00:21:40,170 --> 00:21:41,720
!قل شيئًا يا أبي

377
00:21:41,720 --> 00:21:42,580
!لا تغشّ

378
00:21:42,580 --> 00:21:44,580
!إدخال سايبا-ساما في هذا ضدّ القواعد

379
00:21:44,580 --> 00:21:46,030
.أنا فخور بكِ

380
00:21:46,540 --> 00:21:50,620
!لم أتوقّع أنّك ستقفين في وجه والدك العنيد

381
00:21:52,630 --> 00:21:55,830
.ربّما أكون قد تأثّرت بأسلوب عائلة مختلفة

382
00:21:55,830 --> 00:22:00,170
هل قسّمت فِرق التّدريب البارحة
لأنّك توقّعت حدوث حتّى هذا؟

383
00:22:00,170 --> 00:22:03,400
.لستُ أدّعي معرفتي بالغيب

384
00:22:03,400 --> 00:22:09,180
.أردتُ لها فقط أن تتعلّم شيئًا منهما

385
00:22:09,670 --> 00:22:11,140
.وما زلت المعلّم الّذي عهدناه

386
00:22:11,450 --> 00:22:14,510
،حسنًا، بعد سماع ناكيري تقول ذلك الكلام

387
00:22:14,510 --> 00:22:16,790
أعتقد أنّ علينا جميعنا المراهنة
!بحياتنا على هذا الأمر

388
00:22:16,790 --> 00:22:17,350
!حسنًا

389
00:22:17,350 --> 00:22:19,560
!يا رفاق، أخرجوا كتيّبات التّلاميذ خاصّتكم

390
00:22:20,560 --> 00:22:21,590
!تفضّلي

391
00:22:23,620 --> 00:22:27,950
كنتِ أوّل من حمّسنا عن طريق
.إخبارنا بأن ننجح في امتحانات التّقدّم

392
00:22:27,950 --> 00:22:30,200
.أمسيتِ الكتف الّتي نتّكئ عليها

393
00:22:30,690 --> 00:22:33,950
.حياتنا بين يديك يا ناكيري

394
00:22:38,570 --> 00:22:40,130
!إنّها في الحفظ والصّوْن

395
00:24:07,430 --> 00:24:10,310
.نحن في مفترق طرق يسمّى الانطلاق