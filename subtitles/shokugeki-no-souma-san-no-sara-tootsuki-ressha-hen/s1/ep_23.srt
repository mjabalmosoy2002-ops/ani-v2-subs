1
00:00:03,380 --> 00:00:06,230
!بدأ شوكوغيكي الفِرق

2
00:00:07,910 --> 00:00:09,970
ياكيصوبا فوريّة؟

3
00:00:09,970 --> 00:00:11,530
ماذا؟ أقلتِ شيئًا يا سينباي؟

4
00:00:12,220 --> 00:00:14,780
لا تعتقد ولو لوهلة أنّ بإمكانك
.هزيمتي في الصّوبا

5
00:00:14,780 --> 00:00:18,020
!إيشيكي، ألا تملك أيّ شرف؟

6
00:00:18,020 --> 00:00:20,130
سمعتُ أنّه قد تمّ استبعادك
من المقعد السّابع

7
00:00:20,130 --> 00:00:22,880
وأنّك واصلتَ المكوث في مكان
،يُدعى مسكن النّجم القطبيّ

8
00:00:22,880 --> 00:00:24,210
.وهو مضجع للأوباش

9
00:00:24,210 --> 00:00:25,880
!أقول هذا لصالحك

10
00:00:25,880 --> 00:00:30,710
،بصفتك عضوًا من عائلة إيشيكي
!فلا يجدر بك الاختلاط مع أولئك الحثالة

11
00:00:33,240 --> 00:00:35,540
عفوًا... اسمك يا شيراتسو-كُن، صحيح؟

12
00:00:36,230 --> 00:00:37,550
لماذا لا تغلق فمك قليلاً؟

13
00:00:39,220 --> 00:00:40,940
!لقد قطّع الأنقليس بسرعة البرق

14
00:00:40,940 --> 00:00:42,560
!وكلّ ذلك بضربة واحدة من السّكّين

15
00:00:43,800 --> 00:00:48,020
يملك صاحب المقعد السّابع
!سابقًا مهارات مرعبة

16
00:00:48,650 --> 00:00:51,980
.لكنّه ليس ندًّا للمركز

17
00:00:51,980 --> 00:00:55,990
لنتطلّع قُدمًا للّحظة الّتي ستختفي
.فيها ابتسامته بسبب الهزيمة

18
00:00:55,990 --> 00:00:58,280
.لم تتغيّر مهاراته

19
00:00:58,280 --> 00:01:01,620
إن اختار طريقًا مختلفًا، لكان قد
.أصبح غنيًّا لدرجة تفوق الأحلام

20
00:01:02,140 --> 00:01:04,550
لماذا تمرّد ضدّ المركز؟

21
00:01:04,550 --> 00:01:05,790
.يا له من غبيّ

22
00:01:05,790 --> 00:01:06,930
!جوريو

23
00:01:06,930 --> 00:01:10,090
!لا تسمح له بالتّفوّق عليك
!أره من تكون

24
00:01:10,630 --> 00:01:12,830
.أنا سعيد جدًّا يا إيشيكي

25
00:01:12,830 --> 00:01:15,590
.مهاراتك رفيعة للغاية

26
00:01:16,440 --> 00:01:18,700
،لا أفهم تمامًا ما يحدث هنا
.لكنّه عازم على الأمر الآن

27
00:01:18,700 --> 00:01:19,720
.جيّد، جيّد

28
00:01:19,720 --> 00:01:22,600
ما تلك التّقنية الّتي استعملها
إيشيكي-سان للتّوّ؟

29
00:01:22,600 --> 00:01:26,240
لقد قطّع الأنقليس من البطن
.بدقّة وسرعة عاليتين

30
00:01:26,240 --> 00:01:28,230
.اختار تقطيع الأنقليس من البطن

31
00:01:28,230 --> 00:01:29,920
.هذا لا يُصدّق

32
00:01:29,920 --> 00:01:32,020
،لا يملك الأنقليس قفصًا صدريًّا

33
00:01:32,020 --> 00:01:35,440
لذلك من الصّعب تمامًا إدخال سكّين
.إلى تجويف الجسم النّاعم بدقّة

34
00:01:35,440 --> 00:01:39,950
إذا قارنّا هذا بالتّقطيع من الظّهر، تتطلّب
.هذه الطّريقة تقنيات سكّين متقدّمة جدًّا

35
00:01:39,950 --> 00:01:43,370
من الصّعب تصديق قيامه بهذا نظرًا لكونه
.عاريًا ولا يرتدي إلاّ مئزرًا في العادة

36
00:01:43,370 --> 00:01:44,290
.معك حقّ

37
00:01:44,290 --> 00:01:47,250
عاريًا ولا يرتدي إلاّ مئزرًا؟ ماذا تقصدين؟

38
00:01:47,250 --> 00:01:49,290
!أخبريني أيّتها الآنسة المساعِدة

39
00:01:49,290 --> 00:01:52,670
.لا تناديني بذلك

40
00:01:50,500 --> 00:01:51,760
!نيكومي-تشان

41
00:01:53,000 --> 00:01:56,010
تقطيع الأنقليس من الظّهر
.هي الطّريقة الشّائعة

42
00:01:56,010 --> 00:01:58,440
سمعتُ من قبل أنّ تقطيع الأنقليس من البطن

43
00:01:58,440 --> 00:02:00,740
هو تقنية تطوّرت في مناطق كانساي
.مثل أوساكا وكيوتو

44
00:02:00,740 --> 00:02:02,140
لماذا يعرف إيشيكي-سينباي تلك الطّريقة؟

45
00:02:02,140 --> 00:02:03,720
.بالطّبع هو يعرفها

46
00:02:04,130 --> 00:02:09,480
عملت عائلة إيشيكي في مطعم يابانيّ تقليديّ
.في حيّ غيون بكيوتو منذ فترة موروماتشي

47
00:02:09,960 --> 00:02:13,080
عائلة كينوكوني في الشّرق
...عائلة إيشيكي في الغرب

48
00:02:13,650 --> 00:02:16,410
هاتين العائلتين هما عمودا
.الطّبخ اليابانيّ الشّهيرين

49
00:02:16,410 --> 00:02:17,190
!ماذا؟

50
00:02:17,550 --> 00:02:22,950
وعلاقة كينوكوني-سينباي
.وإيشيكي-سينباي لا تنحصر هناك

51
00:02:23,460 --> 00:02:24,260
ماذا؟

52
00:02:24,260 --> 00:02:26,950
صبيّ من عائلة أخرى سيأتي
للعيش معنا يا والدي؟

53
00:02:26,950 --> 00:02:29,790
تعرفين بشأن عائلة إيشيكي من كيوتو، صحيح؟

54
00:02:29,790 --> 00:02:32,550
.إنّه تقليد قديم

55
00:02:32,550 --> 00:02:35,800
بمجرّد أن يبلغ الوريث المفترض
،الرّابعة من عمره

56
00:02:35,800 --> 00:02:38,760
يتمّ إرسالهم لأماكن بعيدة
.عن المنزل ليتدرّبوا

57
00:02:38,760 --> 00:02:40,090
.حسنًا

58
00:02:40,090 --> 00:02:42,970
.عائلتانا مقرّبتان جدًّا

59
00:02:43,300 --> 00:02:47,930
،إنّه في نفس عمرك
.لذلك قد تصبحان صديقين

60
00:02:49,530 --> 00:02:51,150
.قولي مرحبًا يا نيني

61
00:02:52,810 --> 00:02:56,650
.إنّه وريث عائلة إيشيكي، ساتوشي-كُن

62
00:02:56,860 --> 00:02:58,690
...ماذا؟ هذا يعني

63
00:02:58,690 --> 00:03:01,110
!إنّهما صديقا طفولة؟

64
00:03:01,110 --> 00:03:02,610
فعلاً؟

65
00:03:03,210 --> 00:03:04,580
.أفترض أنّ ذلك صحيحًا

66
00:03:04,580 --> 00:03:06,080
!ليس صحيحًا

67
00:03:06,470 --> 00:03:08,910
!لقد مكث معنا للتّدرّب فحسب

68
00:03:08,910 --> 00:03:10,410
!لم نتقرّب من بعضنا أو ما شابه

69
00:03:10,410 --> 00:03:14,420
يا إلهي، ترين كلّ شيء كإهانة
.اليوم كعادتك يا كينوكوني-كُن

70
00:03:14,420 --> 00:03:16,630
لماذا تعارضينني بشدّة هكذا؟

71
00:03:16,630 --> 00:03:18,380
.لا تتصرّف بسذاجة

72
00:03:19,370 --> 00:03:20,760
.تعرف السّبب

73
00:04:53,850 --> 00:04:55,770
.النّزالات محتدمة للغاية

74
00:04:55,770 --> 00:04:57,860
!إنّها في المرحلة الأولى

75
00:04:58,260 --> 00:05:01,780
لدينا في النّزال الأوّل صاحبة
المقعد الخامس كابوراكي شوكو

76
00:05:01,780 --> 00:05:03,990
ضدّ صاحب المقعد الثّالث
.سابقًا ميغيشيما توسكي

77
00:05:03,990 --> 00:05:07,490
وصاحب المقعد شيراتسو جوريو
في النّزال الثّاني

78
00:05:07,490 --> 00:05:09,740
ضدّ إيشيكي ساتوشي صاحب
!المقعد السّابع سابقًا

79
00:05:10,310 --> 00:05:13,370
أمّا في النّزال الثّالث، فلدينا صاحبة
المقعد السّادس كينوكوني نيني

80
00:05:13,370 --> 00:05:16,330
ضدّ يوكيهيرا سوما، ابن طاهٍ
!في مطعم شعبيّ

81
00:05:22,420 --> 00:05:26,430
!والآن، يبدو أنّ الحكّام قد وصلوا

82
00:05:26,430 --> 00:05:27,890
!اسمحوا لي أن أقدّمهم لكم

83
00:05:27,890 --> 00:05:29,730
.وصل الحكّام

84
00:05:29,730 --> 00:05:30,890
.إنّهم مهمّون بالفعل

85
00:05:39,270 --> 00:05:40,860
.كان ذلك ثقيلاً

86
00:05:40,860 --> 00:05:43,150
عفوًا يا آنسة؟ هل أنت بخير؟

87
00:05:44,330 --> 00:05:45,360
ماذا؟

88
00:05:45,360 --> 00:05:48,320
!الكتب الّتي تحملها

89
00:05:49,700 --> 00:05:52,230
."كتب عليها "م ذ ع

90
00:05:52,230 --> 00:05:53,450
أيُعقل أنّهم...؟

91
00:05:53,450 --> 00:05:55,480
.مذهل. لم أرهم شخصيًّا من قبل

92
00:05:55,480 --> 00:05:56,780
.إنّهم إذًا الحكّام في هذا الشّوكوغيكي

93
00:05:56,780 --> 00:05:57,920
أتوا كلّ هذه المسافة لليابان؟

94
00:05:59,210 --> 00:06:00,150
ماذا؟

95
00:06:00,150 --> 00:06:01,750
هل أنا الوحيد الّذي لا فكرة لديه هنا؟

96
00:06:01,750 --> 00:06:04,250
.منظّمة الذّوّاقة العالميّة

97
00:06:04,680 --> 00:06:06,820
وظيفتهم الأساسيّة هي تصنيف

98
00:06:06,820 --> 00:06:09,210
كلّ مؤسّسات الطّعام الفاخرة في العالم
.بأسره ومنحهم حتّى ثلاث نجمات

99
00:06:09,210 --> 00:06:14,220
.تُنشر تقييماتهم مرّة كلّ سنة في كتب خاصّة

100
00:06:19,290 --> 00:06:22,050
من جهة أخرى، هنالك طهاة كانت
،لهم أعمال مربحة للغاية

101
00:06:22,050 --> 00:06:26,570
لكن أغلقوا مطاعمهم لأنّهم فقدوا
.نجمة، وفقدوا ثقتهم معها

102
00:06:26,930 --> 00:06:32,410
."يحترم كلّ الطّهاة ويخشون منظّمة "م ذ ع

103
00:06:32,410 --> 00:06:33,810
فعلاً؟

104
00:06:33,810 --> 00:06:37,660
بالتّفكير في الأمر، قال المعلّم شينوميا
.إنّه سيحصل على ثلاث نجوم

105
00:06:37,660 --> 00:06:38,870
.أظنّ أنّ ذلك ما كان يقصده

106
00:06:38,870 --> 00:06:42,030
.تعتبر الكتب المنشورة لتقييماتهم كتبًا مقدّسة

107
00:06:42,030 --> 00:06:44,200
،"تُعرف أيضًا بـ"الكتاب

108
00:06:44,200 --> 00:06:48,170
.ويُعرف الموظّفون ممثّلو تلك المنظّمة برجال الكتاب

109
00:06:48,170 --> 00:06:52,850
بعبارات أخرى، فإنّ حكّام اليوم
!"هم رجال كتاب "م ذ ع

110
00:06:52,850 --> 00:06:53,650
.المعذرة

111
00:06:53,650 --> 00:06:57,640
.أقرأ عبارة "مطعم يوكيهيرا الشّعبيّ" على قميصك

112
00:06:57,640 --> 00:06:58,740
.نعم، صحيح

113
00:06:58,740 --> 00:07:00,550
.إنّه مطعم تديره عائلتي

114
00:07:00,550 --> 00:07:01,400
ماذا بشأنه؟

115
00:07:01,400 --> 00:07:04,100
...يوكيهيرا

116
00:07:06,170 --> 00:07:08,190
.لا داعي لتشعر بالسّوء

117
00:07:08,190 --> 00:07:08,860
ماذا؟

118
00:07:09,190 --> 00:07:14,070
يقول الكثيرون إنّه إن لم يكن اسم المطعم
.مدرجًا في الكتاب، فهو ليس مطعمًا حقيقيًّا

119
00:07:14,070 --> 00:07:16,080
.قد يكون ذلك صحيحًا

120
00:07:16,080 --> 00:07:18,100
لكن ماذا في ذلك؟

121
00:07:18,100 --> 00:07:21,500
!فما تزال هنا وعلى قيد الحياة

122
00:07:21,500 --> 00:07:23,690
!عليك أن تكون ممتنًّا لوالديك

123
00:07:23,690 --> 00:07:24,670
ماذا؟

124
00:07:25,480 --> 00:07:27,380
.أشعر أنّها تشعر بالشّفقة عليّ

125
00:07:27,380 --> 00:07:31,080
هل من المناسب أن يكونوا حكّامًا علينا؟

126
00:07:31,080 --> 00:07:33,260
!غبيّ! لا تكن فظًّا

127
00:07:33,260 --> 00:07:34,920
!يوكيهيرا سوما

128
00:07:34,920 --> 00:07:37,390
!لا يجب على أصحاب مطعم منحطّ التّحدّث هكذا

129
00:07:37,390 --> 00:07:40,110
!لا تعدّون سوى طعام من المستوى الثّاني

130
00:07:40,110 --> 00:07:42,940
—ما كانت "م ذ ع" أن تقبل بطبخ مثل

131
00:07:42,940 --> 00:07:43,900
!صمتًا رجاءً

132
00:07:47,820 --> 00:07:50,250
—لقد سخرتُ من

133
00:07:51,030 --> 00:07:54,530
.لقد شجّعته نظرًا لأنّه لم يتلقّ أيّ نجوم بعد

134
00:07:54,880 --> 00:07:56,490
هل قالت للتّوّ أنّها سخرت منّي؟

135
00:07:56,490 --> 00:08:00,260
لكنّ حقيقة عدم امتلاكه أيّ نجوم

136
00:08:00,260 --> 00:08:03,860
لن تكون لها أيّ علاقة بالطّبق
.الّذي سيقدّمه اليوم

137
00:08:03,860 --> 00:08:05,370
.هذا صحيح

138
00:08:05,370 --> 00:08:08,630
سيكون أساس قرارنا الوحيد
هو ما سيوجد في الطّبق

139
00:08:08,630 --> 00:08:14,890
أقسمّ بالرّب والكتاب
.أنّ حكمنا سيكون منصفًا تمامًا

140
00:08:15,200 --> 00:08:21,020
لذلك قدّم لنا طبقًا جيّدًا اليوم
.يا مطعم يوكيهيرا الشّعبيّ

141
00:08:21,020 --> 00:08:23,570
،ظننتُ أنّكم مجرّد متعاليين

142
00:08:23,570 --> 00:08:25,150
.لكنّ كلامكم قد أعجبني

143
00:08:25,150 --> 00:08:26,550
!انتظروا

144
00:08:28,110 --> 00:08:30,110
.هذه ليست طريقة طبخ فعّالة

145
00:08:30,110 --> 00:08:31,740
هل سينجح في هذا النّزال؟

146
00:08:33,200 --> 00:08:34,260
!إيشيكي

147
00:08:34,260 --> 00:08:35,950
!ليس لديك وقت ليتشتّت انتباهك هكذا

148
00:08:36,870 --> 00:08:38,950
!سوف يكتمل طبقي قريبًا

149
00:08:38,950 --> 00:08:41,910
!سوف أسحقك بهذا الطّبق

150
00:08:41,910 --> 00:08:44,980
.يا ويحي. أفترض أنّ عليّ أن أسرع

151
00:08:48,750 --> 00:08:51,300
أعتقد أنّ إيشيكي يريد استعمال هذا النّزال

152
00:08:51,300 --> 00:08:58,430
،ليثبت شيئًا ليس لجوريو وحده
.بل لنيني وبقيّتنا أيضًا

153
00:09:08,480 --> 00:09:10,230
!حسنًا! انتهيت

154
00:09:10,230 --> 00:09:13,440
!والآن أيّها الحكّام المحترمون! تذوّقوا رجاءً

155
00:09:14,250 --> 00:09:15,640
!حانت اللّحظة

156
00:09:15,640 --> 00:09:17,740
!أوّل المنتهين هو شيراتسو جوريو

157
00:09:17,740 --> 00:09:23,720
أيّ نوع من أطباق الأنقليس الإيطاليّ
قد طبخ لنا؟

158
00:09:24,850 --> 00:09:26,660
.مثير للاهتمام

159
00:09:29,330 --> 00:09:32,090
نكهات الطّماطم المركّزة والمنعشة

160
00:09:32,090 --> 00:09:36,130
!وغنى الأنقليس قد ولّدتا رائحة عطرة شهيّة

161
00:09:36,130 --> 00:09:40,370
!أجل، ذلك هو سحر الطّبق الأعظم والفريد

162
00:09:40,370 --> 00:09:42,540
إنّه تعاون بين الأومامي والدّهون

163
00:09:42,540 --> 00:09:44,810
...في الأنقليس وغنى الطّماطم

164
00:09:44,810 --> 00:09:47,310
!"كابيتوني إن أوميدو"

165
00:09:49,350 --> 00:09:52,480
!يبدو شهيًّا

166
00:09:49,770 --> 00:09:52,480
...حسنًا، لنبدأ دون تأخير

167
00:09:57,110 --> 00:10:00,530
.أومامي ودهون الأنقليس تندفع نحوي

168
00:10:01,330 --> 00:10:06,040
لقد تعزّزت بشكل مبهر بنكهات
.زيت الزّيتون والطّماطم

169
00:10:08,680 --> 00:10:10,050
!هذا كمال

170
00:10:10,050 --> 00:10:13,630
طبق "كابيتوني إن أوميدو" هذا
.تمّ إعداده بشكل رائع

171
00:10:17,080 --> 00:10:19,030
.يبدو شهيًّا بالفعل

172
00:10:19,030 --> 00:10:22,890
لكن ما معنى "كابيتوني" و"إن أوميدو" أيضًا؟

173
00:10:23,280 --> 00:10:26,420
.إن أوميدو" تعني الحساء"

174
00:10:26,420 --> 00:10:28,740
.و"كابيتوني" تعني الأنقليس

175
00:10:28,740 --> 00:10:31,970
ولكن، وحدها إناث الأنقليس
.الكبيرة الّتي تُدعى كذلك

176
00:10:31,970 --> 00:10:34,860
.إنّها تعتبر مكوّنًا راقيًا نظرًا للحمها الكثيف والدّسم

177
00:10:34,860 --> 00:10:39,860
"تتمّ مناداة بقيّة الأنقليس بـ"أنغيلا
.لتمييزها عن الكابيتوني

178
00:10:40,180 --> 00:10:43,580
ثمّة سرّ آخر أيضًا يعزّز من نكهة الكابيتوني اللّذيذة

179
00:10:43,580 --> 00:10:45,990
في هذه الطّماطم المطبوخة ببطء
مع الأنقليس، صحيح؟

180
00:10:48,210 --> 00:10:52,410
طماطم سان مارزانو الّتي اخترتُها
.هي النّجم الحقيقيّ في للطّبق

181
00:10:52,410 --> 00:10:56,000
تملك سلاسة الطّماطم هذه
،نسبة مياه أقلّ من الأخرى

182
00:10:56,000 --> 00:10:59,680
،ممّا يمنع الحساء من أن يصبح مليئًا بالماء
.ممّا يجعل إعداد صلصة غنيّة أمرًا ممكنًا

183
00:11:00,010 --> 00:11:04,900
عمق النّكهة الّتي وفّرتها طماطم سان مارزانو

184
00:11:04,900 --> 00:11:06,930
.قد تجانست مع التّوابل لتعزيز نكهات الأنقليس

185
00:11:06,930 --> 00:11:09,720
هذه البولينتا المُعدّة عن طريق غلي
،دقيق الذّرة ليصبح عصيدة كثيفة

186
00:11:09,720 --> 00:11:14,190
ثمّ أُعدّت لتكون مقرمشة من الخارج
.وطريّة من الدّاخلة، رائعة جدًّا

187
00:11:14,190 --> 00:11:16,490
تتطلّب منه الصّلصة أن يعزّز رائحة الثّوم

188
00:11:16,490 --> 00:11:20,990
وتركيز حلاوة البصل بينما يقلّل
.من كمّيّة الماء للطّماطم

189
00:11:21,580 --> 00:11:25,120
لن يكون الطّبق مثاليًّا إلاّ إذا تواصل
.الطّاهي مع المكوّنات

190
00:11:25,600 --> 00:11:28,250
.يبدو أنّ جوريو قد أثبت أنّه قادر على ذلك

191
00:11:28,250 --> 00:11:31,510
العديد من المكوّنات وألحانها العديدة

192
00:11:31,510 --> 00:11:33,800
.قد زادت من جمال بعضها بعضًا بالفعل

193
00:11:33,800 --> 00:11:35,460
!إنّها روندو بالفعل

194
00:11:35,460 --> 00:11:40,220
وكأنّ الكابيتوني كبير الحجم والطّماطم
...تصفّي الجسد والرّوح

195
00:11:40,220 --> 00:11:44,490
!ثمّ تقومان ببنائه خير بناء

196
00:11:45,430 --> 00:11:47,140
...هذه النّكهات اللّذيذة

197
00:11:47,890 --> 00:11:50,340
...تجعل المرء يشعر وكأنّه يُسحق

198
00:11:50,340 --> 00:11:53,480
!بين نهدين مبهجين للحواس

199
00:11:54,730 --> 00:11:57,820
"!هذا رائع"

200
00:11:58,810 --> 00:12:01,630
!أبليتَ حسنًا يا شيراتسو جوريو

201
00:12:01,630 --> 00:12:04,950
!إنّه طبق رائع يوفي سمعة عائلتك حقّها

202
00:12:04,950 --> 00:12:06,700
.بالطّبع

203
00:12:06,700 --> 00:12:12,460
كنت أجهد نفسي بشدّة لصقل
.مهاراتي بهدف اللّحاق بركب إيشيكي

204
00:12:12,460 --> 00:12:15,530
!حسنًا يا إيشيكي ساتوشي! هلمّ عليّ

205
00:12:15,530 --> 00:12:18,170
!لننِه هذه الجلسة المذهلة

206
00:12:18,170 --> 00:12:20,410
.بالطّبع سأفعل

207
00:12:20,410 --> 00:12:25,510
الطّبق الّذي أوشك على تقديمه
.يضمّ العديد من المكوّنات الخاصّة

208
00:12:27,290 --> 00:12:31,480
مهلاً، تلك أشياء نخزّنها
.في مسكن النّجم القطبيّ

209
00:12:34,550 --> 00:12:36,550
.نعم، أعتقد أنّ بإمكاننا اختيار هذا

210
00:12:36,550 --> 00:12:40,790
.لنجرّب إعداد جبننا الطّبيعيّ الخاصّ يا نيكومي-تشي

211
00:12:40,790 --> 00:12:42,780
هكذا إذًا. قلت جبنًا؟

212
00:12:43,190 --> 00:12:46,920
أنا واثقة أنّ بإمكاننا الحصول على حليب
،عالي الجودة بفضل علاقات عائلتي

213
00:12:46,920 --> 00:12:48,120
.لكنّنا نفتقر للمعرفة المطلوبة

214
00:12:48,120 --> 00:12:49,580
!لا تقلقي

215
00:12:49,580 --> 00:12:53,090
.لدينا خبيرة تخمير ها هنا في مسكن النّجم القطبيّ

216
00:12:55,640 --> 00:12:57,700
لماذا أنت متعبة جدًّا هكذا؟

217
00:12:58,760 --> 00:13:03,700
أنا أبحث في مواضيع جديدة لعصير
،الأرزّ مع ماروي-كُن الآن

218
00:13:03,700 --> 00:13:05,170
.لذلك أفتقر للنّوم

219
00:13:05,170 --> 00:13:08,310
!وجدتُ بعض المصادر

220
00:13:08,970 --> 00:13:09,870
!هذا ثقيل

221
00:13:09,870 --> 00:13:12,470
من كان يعلم أنّ إعداد الطّعام
المدخّن عمل شاقّ لهذه الدّرجة؟

222
00:13:12,470 --> 00:13:15,770
مهلاً، لماذا لا تبدو متعبًا؟

223
00:13:15,770 --> 00:13:17,850
،بمجرّد أن تنتهيا من حمل تلك
.فهنالك غيرها

224
00:13:17,850 --> 00:13:19,730
!لنرتح قليلاً

225
00:13:20,580 --> 00:13:22,980
!هذا جميل! يا لروعة الشباب

226
00:13:22,980 --> 00:13:25,430
مهلاً، سوف يستعمل المكوّنات
الّتي ابتكرناها نحن؟

227
00:13:25,430 --> 00:13:26,660
أحضرها إلى هنا؟

228
00:13:26,660 --> 00:13:29,780
!نعم، لقد سرقتُها بنفسي

229
00:13:29,780 --> 00:13:31,960
لماذا تبدو فخورًا كثيرًا بهذا؟

230
00:13:31,960 --> 00:13:33,570
.توقّف رجاءً

231
00:13:33,570 --> 00:13:36,040
!كنّا لا نزال في مراحل التّذوّق الأولى

232
00:13:37,160 --> 00:13:40,290
.أنت ساحرة حتّى وأنت غاضبة يا ساكاكي-كُن

233
00:13:41,380 --> 00:13:47,140
.شيراتسو-كُن، سأريك ما يعنيه الطّبخ لي

234
00:13:57,860 --> 00:14:02,570
سيقدّم إيشيكي ساتوشي من فريق
.المتمرّدين طبقه الآن

235
00:14:02,570 --> 00:14:04,570
.هنيئًا مريئًا لكم

236
00:14:05,000 --> 00:14:09,160
طبق الأنقليس خاصّتي هو هيتسومابوشي
.على طريقة النّجم القطبيّ

237
00:14:09,160 --> 00:14:10,990
على طريقة النّجم القطبيّ؟

238
00:14:10,990 --> 00:14:12,610
..."هيتسومابوشي"

239
00:14:12,610 --> 00:14:17,730
في العادة، يتمّ تناول الطّبق أوّلاً عن طريق
.أكل أنقليس مقطّع مشويّ مع الأرزّ

240
00:14:17,730 --> 00:14:20,740
ثمّ يتمّ الاستمتاع بالطّبق بإضافة
توابل مثل البصل وطحالب البحر

241
00:14:20,740 --> 00:14:25,590
بعد إضافة سائل ما مثل الحساء
.أو الشّاي الأخضر وأكله مثل أوتشازوكي

242
00:14:25,590 --> 00:14:29,720
يتمّ الاستمتاع بالطّبق في مراحل
.عديدة بينما يتغيّر

243
00:14:30,130 --> 00:14:31,470
...ومع ذلك

244
00:14:31,470 --> 00:14:34,470
.إنّه يبدو مثل ريزوتّو الجبن

245
00:14:35,930 --> 00:14:38,700
.لقد قدّم شيئًا مميّزًا

246
00:14:38,700 --> 00:14:42,530
.آسف، أعرف أنّ الريزوتّو اختصاصك يا سوما-كُن

247
00:14:42,530 --> 00:14:43,150
ماذا؟

248
00:14:43,150 --> 00:14:47,740
أنا أحبّ استعمال الأرزّ فقط
.لأنّ عائلتي تدير مطعمًا شعبيًّا

249
00:14:50,310 --> 00:14:54,580
إن استعمل خليط مكوّنات
،أعدّها زملاؤه الأصغر فقط

250
00:14:54,580 --> 00:14:56,620
!من المستحيل أن يتمكّن من تقديم طبق متماسك

251
00:14:57,130 --> 00:14:58,600
.لنتذوّق هذا الطّبق

252
00:14:59,810 --> 00:15:02,080
.إنّه يبدو مثل ريزوتّو الجبن بالفعل

253
00:15:02,520 --> 00:15:06,550
يبدو أنّه سيكون علينا سكب محتوى
.الإبريق على الطّبق في النّهاية

254
00:15:08,820 --> 00:15:11,510
.الجبن المذاب يغلّف الأرزّ

255
00:15:18,140 --> 00:15:19,100
!كلاّ

256
00:15:19,660 --> 00:15:23,310
...إنّه لذيذ للغاية وكأنّه يعذّبنا

257
00:15:23,700 --> 00:15:25,770
.الفلفل اليابانيّ هو ما يجمع مكوّنات هذا الرّيزوتّو

258
00:15:25,770 --> 00:15:30,490
تُظهر الرّائحة العطرة القويّة والحادّة
غنى الجبن الخفيف

259
00:15:30,490 --> 00:15:32,990
!وتسمح للنّكهات اللّذيذة للأنقليس بالانفجار

260
00:15:33,320 --> 00:15:36,450
والمكوّن الأساسيّ الّذي يربط كلّ
...شيء ببعضه في الخفاء

261
00:15:36,820 --> 00:15:37,910
!هو الثّوم

262
00:15:38,240 --> 00:15:39,530
!الثّوم؟

263
00:15:39,530 --> 00:15:40,870
استعمل الثّوم في طبخ يابانيّ؟

264
00:15:41,290 --> 00:15:44,540
شرائح الثّوم المدخّن الّتي أعدّها زملائي

265
00:15:45,380 --> 00:15:49,050
باستعمال خشب الجوز الذي يعزّز
.نكهات الطّعام البحريّ

266
00:15:49,760 --> 00:15:51,850
،وباستعمالها كإضافات مفتّتة فوق الطّبق

267
00:15:51,850 --> 00:15:54,470
.فذلك يضيف ملمسًا مقرمشًا له بعض الشّيء

268
00:15:54,790 --> 00:15:57,130
والأمر الأكثر أهمّيّة هنا

269
00:15:57,130 --> 00:16:00,060
.هو أنّ الأنقليس قد شُوِيَ بأسلوب كانساي

270
00:16:00,690 --> 00:16:02,120
،على عكس الطّريقة المستعملة في أسلوب كانتو

271
00:16:02,120 --> 00:16:04,110
لا يُطهى الأنقليس على البخار أبدًا
.أثناء هذه العمليّة

272
00:16:04,110 --> 00:16:08,430
وذلك يمنح أنقليسًا مشويًّا مقرمشًا وعبِقًا
،أكثر بلمسة قويّة من دهون الأنقليس

273
00:16:08,430 --> 00:16:11,780
والّذي يسمح بدوره بإضافته
.مع مكوّن قويّ مثل الثّوم

274
00:16:12,090 --> 00:16:14,550
وفوق كلّ ذلك، الثّوم مشبّع
،بشغف إيبوساكي-كُن

275
00:16:14,550 --> 00:16:17,870
ودماء وعرق ودموع مساعديه
!أوكي-كُن وساتو-كُن

276
00:16:17,870 --> 00:16:19,860
!فبالطّبع سيكون لذيذًا

277
00:16:19,860 --> 00:16:21,820
!لا تقل أنّ عرقنا موجود هناك

278
00:16:21,820 --> 00:16:22,750
!هذا مقرف

279
00:16:23,330 --> 00:16:27,980
هذا وحده راقٍ بشكل كافٍ
،ليكون طبق ذوّاقة

280
00:16:27,980 --> 00:16:29,500
لكن ماذا يوجد في الإبريق؟

281
00:16:30,210 --> 00:16:31,720
.إنّه حساء كبد الأنقليس

282
00:16:32,220 --> 00:16:36,180
تمّ قلي كبد أنقليس معدّ مسبقًا
،مع شرائح الثّوم في زيت الزّيتون

283
00:16:36,650 --> 00:16:39,890
ثمّ تمّت إضافة مكوّن قام بإعداده
كلّ من ساكاكي-كُن وماروي-كُن

284
00:16:39,890 --> 00:16:42,100
.إضافة إلى حساء البونيتو المجفّف

285
00:16:42,420 --> 00:16:45,940
إنّه يختلط بلطف مع الجبن الّذي
أعدّته يوكينو-كُن ونيكومي-كُن

286
00:16:45,940 --> 00:16:48,450
.لإنشاء طعم دائم جميل

287
00:16:50,470 --> 00:16:51,440
...شيراتسو-كُن

288
00:16:52,650 --> 00:16:55,660
،إن وجدتَ هذا الطّبق لذيذًا

289
00:16:56,230 --> 00:16:59,490
فسأطلب منك الاعتذار على إهانتك
.لكلّ شخص من مسكن النّجم القطبيّ

290
00:17:00,550 --> 00:17:03,460
.كما لا أعتبر طبقي طبقًا يابانيًّا على الإطلاق

291
00:17:03,460 --> 00:17:05,790
لقد أعددتُ ببساطة طبقًا أعتبره
.علامتي الخاصّة في الطّبخ

292
00:17:07,490 --> 00:17:08,900
،في شوكوغيكي واحد

293
00:17:08,900 --> 00:17:13,760
وصف أحد الذّوّاقة الّذين حكموا
...على طبق إيشيكي ساتوشي بالتّالي

294
00:17:14,270 --> 00:17:16,520
".مطبخ يابانيّ قتاليّ للغاية"

295
00:17:20,890 --> 00:17:24,040
"!هذا رائع"

296
00:17:25,770 --> 00:17:28,650
جلد الأنقليس المقرمش
...والدّهون السّاخنة

297
00:17:28,650 --> 00:17:30,900
...النّكهات الغنيّة الواضحة لحساء الكبد

298
00:17:30,900 --> 00:17:35,280
نكهات المكوّنات والإحساس الّذي
تتركه في الفم قد اتّحدا

299
00:17:35,280 --> 00:17:37,410
!وشكّلا لذّة واحدة ورفيعة

300
00:17:37,410 --> 00:17:40,080
.رائحته قويّة للغاية

301
00:17:40,540 --> 00:17:43,830
.لكنّ ذلك سمح له بالتّماشي مع رائحة الأنقليس

302
00:17:43,830 --> 00:17:47,650
.حوّل عيب المكوّن إلى نكهة لذيذة

303
00:17:47,650 --> 00:17:49,890
حسنًا يا شيراتسو-كُن، كيف كان مذاقه؟

304
00:17:49,890 --> 00:17:51,220
.أنا لا أهتمّ بشأني شخصيًّا

305
00:17:51,220 --> 00:17:53,390
.لكن عليّ الحفاظ على شرف قاطني المسكن

306
00:17:53,390 --> 00:17:57,220
،لا علاقة لهذا بما أريده أنا
.بل بمسؤوليّاتي كزميل أكبر لهم

307
00:17:57,220 --> 00:17:58,670
.لذلك أريد منك أن تعتذر

308
00:17:58,670 --> 00:17:59,640
ستعتذر، صحيح؟

309
00:17:59,640 --> 00:18:01,850
...هذا الطّبق

310
00:18:01,850 --> 00:18:05,060
!لا يترك مجالاً للمقاومة

311
00:18:05,400 --> 00:18:07,440
.والآن، اعتذر

312
00:18:07,440 --> 00:18:10,980
!سُحقًا

313
00:18:17,640 --> 00:18:19,050
!انتهى التّقييم

314
00:18:19,050 --> 00:18:21,620
الفائز في النّزال الثّاني من
...المرحلة الأولى هو

315
00:18:21,990 --> 00:18:23,460
!إيشيكي ساتوشي

316
00:18:31,640 --> 00:18:34,130
.أنت رائع يا إيشيكي-سينباي

317
00:18:36,930 --> 00:18:38,340
.كم هذا مريح

318
00:18:38,340 --> 00:18:40,300
...إيشيكي-سينباي

319
00:18:40,730 --> 00:18:43,310
...تستعمل مكوّناتنا دون إذننا

320
00:18:43,310 --> 00:18:45,840
ماذا كنتَ ستفعل إن خسرت؟

321
00:18:45,840 --> 00:18:48,520
.أنا أثق بعملكم

322
00:18:50,020 --> 00:18:52,610
!ما زلت غاضبة

323
00:18:52,610 --> 00:18:55,410
.كان ذلك مجرّد نموذج تجريبيّ

324
00:18:55,410 --> 00:18:59,480
سيّد إيشيكي، هل يمكنني تذوّق ما في القنّينة؟

325
00:18:59,480 --> 00:19:00,700
.نعم، بالطّبع

326
00:19:08,600 --> 00:19:13,720
أظنّ أنّني أفهم ما تأمل أن تحميه
.في هذا الشّوكوغيكي

327
00:19:14,670 --> 00:19:17,280
.مارسوا مهاراتكم إلى أقصى الدّرجات

328
00:19:17,280 --> 00:19:23,140
ستحصلون على تقييم مطلق
وعادل لجميع أطباقكم

329
00:19:23,450 --> 00:19:27,100
."من رجال كتاب "م ذ ع

330
00:19:28,560 --> 00:19:32,060
.جوريو! دع الباقي لي

331
00:19:32,060 --> 00:19:33,900
!أبليتَ حسنًا

332
00:19:33,900 --> 00:19:35,900
...إيشيكي

333
00:19:38,900 --> 00:19:43,260
.خسر شيراتسو، لكنّه يبدو سعيدًا بطريقة ما

334
00:19:43,260 --> 00:19:46,560
.ظهرت قوّة إيشيكي بالكامل في ذلك النّزال

335
00:19:46,560 --> 00:19:50,120
.لا يقاتل إلاّ من أجل زملائه الأصغر إذًا

336
00:19:50,120 --> 00:19:54,180
.إنّه يحبّ فكرة أنّ يكون المنقذ ضدّنا

337
00:19:54,180 --> 00:19:56,520
.تلك هي حقيقته

338
00:19:57,510 --> 00:19:58,760
أذلك صحيح؟

339
00:19:59,080 --> 00:20:03,220
.أشعر بعزيمة قويّة للحفاظ على مبادئه تنبع منه

340
00:20:05,300 --> 00:20:07,070
!ما زال لدينا نزالان في هذه المرحلة

341
00:20:07,070 --> 00:20:10,710
،طالما أنّ المركز سيفوز بكليهما
!فلن تكون هنالك أيّ مشاكل

342
00:20:13,350 --> 00:20:14,650
!دقّة عالية

343
00:20:14,650 --> 00:20:15,400
!سرعة فائقة

344
00:20:15,760 --> 00:20:17,860
!إنّها تشبه آلة دقّة

345
00:20:18,350 --> 00:20:24,740
يستطيع صانعو الصّوبا المدرّبون جيّدًا تقطيع
.المعكرونة بنفس الوسع حتّى عُشر الميلمتر

346
00:20:24,740 --> 00:20:28,080
.لا يوجد شكّ أنّها وصلت لذلك المستوى

347
00:20:29,790 --> 00:20:32,000
!بدأ يوكيهيرا بتقطيع المعكرونة خاصّته أيضًا

348
00:20:32,000 --> 00:20:33,670
...رغم أنّه يستعمل آلة لذلك

349
00:20:33,670 --> 00:20:35,750
.الفرق بين حدّة عمليهما كبير جدًّا

350
00:20:35,750 --> 00:20:39,030
يوكيهيرا... أيّ نوع من الصّوبا ستطبخ؟

351
00:20:39,030 --> 00:20:41,420
أستكون باردة أم ساخنة؟

352
00:20:41,960 --> 00:20:44,050
.أوّلاً، أودّ أن أهنّئك

353
00:20:44,480 --> 00:20:48,050
.احرص على أن تنافسني في المرحلة الثّانية

354
00:20:48,050 --> 00:20:49,650
.دعينا لا نستبق الأمور

355
00:20:49,650 --> 00:20:52,950
أنت صاحبة المقعد السّادس وأنا
.صاحب المقعد السّابع سابقًا

356
00:20:52,950 --> 00:20:54,250
—ليس عليك أن تأخذي الأمر على

357
00:20:54,250 --> 00:20:56,210
.ما عاد هنالك ما يدفعك للتّصرّف بغباء

358
00:20:56,210 --> 00:20:58,400
السّبب الوحيد وراء كوني أعلى مرتبة منك

359
00:20:58,730 --> 00:21:01,230
.هو أنّك لم تكن جادًّا أبدًا

360
00:21:02,100 --> 00:21:04,240
أتلعب بمهد القطّة أم التّلاعب بالكرات؟

361
00:21:06,110 --> 00:21:08,370
نيني-تشان، ما هذا؟

362
00:21:08,370 --> 00:21:12,070
صحيح، إنّها آلة موسيقيّة يابانيّة
.تقليديّة تُدعى ناي التّنّين

363
00:21:12,070 --> 00:21:12,790
أتريد تجربتها؟

364
00:21:13,270 --> 00:21:17,000
.من الصّعب حتّى إطلاق صوت منها في البداية

365
00:21:22,790 --> 00:21:24,220
.لطالما كنتَ كذلك

366
00:21:24,980 --> 00:21:28,180
أنت تتقن التّقنيات الّتي تطلّبت
منّي وقتًا طويلاً بسهولة

367
00:21:28,790 --> 00:21:31,160
.بينما تبدو وكأنّك لم تبذل كلّ جهدك بعد

368
00:21:31,910 --> 00:21:35,690
هل يمكنك حتّى أن تدرك كم
جعلني ذلك بائسة؟

369
00:21:36,050 --> 00:21:40,190
لذلك سأريك أيّ واحد منّا في الدّفعة
الواحدة بعد التّسعين

370
00:21:40,190 --> 00:21:42,390
!هو الطّاهي الأفضل

371
00:21:43,110 --> 00:21:45,860
.آسف، لن تتسنّى لك الفرصة لذلك

372
00:21:47,060 --> 00:21:52,660
لأنّك ستخسرين أمام طاهٍ يُدعى
.يوكيهيرا سوما قبل ذلك

373
00:21:53,870 --> 00:21:54,970
!ماذا؟

374
00:21:54,970 --> 00:21:58,330
!يُخرج يوكيهيرا سوما شيئًا ما

375
00:21:59,210 --> 00:22:01,200
!إنّها مقلاة صينيّة عملاقة

376
00:22:01,200 --> 00:22:05,170
!لقد وضعها على نار كبيرة

377
00:22:05,170 --> 00:22:06,760
!هل هو جادّ؟

378
00:22:06,760 --> 00:22:08,430
.ياكيصوبا فوريّة

379
00:22:09,640 --> 00:22:11,850
.حسنًا، حان وقت اللّمسات الأخيرة

380
00:22:11,850 --> 00:22:12,840
—هل تلك

381
00:22:12,840 --> 00:22:13,560
!صوبا؟

382
00:22:13,560 --> 00:22:14,220
.مستحيل

383
00:22:14,810 --> 00:22:16,430
!إنّه يقوم بقليها

384
00:22:16,430 --> 00:22:18,560
إنّه يفسد صوبا الثّمانية لكلّ اثنين
...الّتي تكبّد عناء إعدادها

385
00:22:19,170 --> 00:22:21,440
.سوف تضيع كلّ النّكهات اللّذيذة

386
00:22:21,860 --> 00:22:24,780
.يوكيهيرا سوما-كُن، ستلقى نهايتك ها هنا

387
00:22:25,340 --> 00:22:28,150
.في النّهاية، ما طبقك إلاّ ارتجال يائس

388
00:22:28,680 --> 00:22:33,240
سوف أسحقه إلى جانب تطلّعات
!إيشيكي العالية عنك

389
00:24:06,770 --> 00:24:11,090
.الخطوة الأخيرة وشيكة. لا تفوّتوها رجاءً