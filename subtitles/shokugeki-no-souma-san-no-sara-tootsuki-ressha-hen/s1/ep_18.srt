1
00:00:05,180 --> 00:00:08,520
.تهانينا على فوزك بالمعركة الشّاملة يا هاياما أكيرا

2
00:00:08,900 --> 00:00:11,350
.أنت الآن عضو رسميّ في المركز

3
00:00:11,350 --> 00:00:12,990
.لا أهتمّ بذلك

4
00:00:12,990 --> 00:00:16,010
—فِ بوعدك وجهّز مختبر الأبحاث لي ولجون

5
00:00:16,010 --> 00:00:17,220
.أعلم ذلك

6
00:00:17,830 --> 00:00:21,170
.لكن قبل ذلك، أنجز مهمّتك الأولى

7
00:00:21,170 --> 00:00:22,660
.إنّها مسألة بسيطة

8
00:00:22,660 --> 00:00:27,170
اهزم الخصم الّذي سبق وانتصرت
.عليه مرّتين من قبل مرّة وإلى الأبد

9
00:00:28,630 --> 00:00:30,370
.لا تفعل ذلك يا هاياما-كُن

10
00:00:30,370 --> 00:00:32,010
.اترك المركز في الحال

11
00:00:32,410 --> 00:00:35,340
أخبرتك ألاّ تنضمّ للمركز، صحيح؟

12
00:00:35,340 --> 00:00:37,740
لماذا تأبى الإستماع لي؟

13
00:00:38,430 --> 00:00:40,620
،حتّى إن استمعت لأزامي-سينباي

14
00:00:40,620 --> 00:00:42,890
فلا يوجد ما يضمن أنّه سيسمح
—لك بفعل ما تريد

15
00:00:42,890 --> 00:00:43,980
وماذا في ذلك؟

16
00:00:43,980 --> 00:00:47,010
هل هنالك طريقة أخرى نستطيع
بها إنهاء بحثنا؟

17
00:00:47,010 --> 00:00:48,480
!أنت لا تفهم الأمر يا هاياما-كُن

18
00:00:48,480 --> 00:00:49,690
!ما-ما الأمر

19
00:00:50,320 --> 00:00:52,690
هل تفهمين من الأساس
كم يعني لي كلّ ما مررنا به؟

20
00:00:53,140 --> 00:00:54,630
.لا بأس

21
00:00:54,630 --> 00:00:56,400
،مهما كان ما تقولينه

22
00:00:56,400 --> 00:00:58,620
.فسأحمي هذا المكان

23
00:00:58,620 --> 00:01:00,660
.لا أهتمّ لما قد أضحّي به

24
00:01:05,150 --> 00:01:06,580
.طبق لحم الدّببة المقليّ

25
00:01:07,080 --> 00:01:08,540
.استمتعوا بالوجبة

26
00:02:49,670 --> 00:02:52,730
الطّبق الّذي أعدّه سيّد الرّوائح
...العطرة، هاياما أكيرا هو

27
00:02:53,140 --> 00:02:54,440
.لحم الدّببة المقليّ

28
00:02:55,570 --> 00:02:57,570
!هاياما، أين حصّتي؟

29
00:02:57,570 --> 00:02:59,980
!أسرع ودعني أتذوّقه

30
00:02:59,980 --> 00:03:00,910
.اخرس

31
00:03:01,220 --> 00:03:02,130
.خذ

32
00:03:02,130 --> 00:03:04,740
،بعد أن تتذوّقه وتعترف بالهزيمة
.غادر الأكاديميّة

33
00:03:04,740 --> 00:03:07,700
تتصرّف وكأنّك لا تملك وقتًا لي بالفعل إذًا؟

34
00:03:07,700 --> 00:03:09,500
.ذلك كان شعوري حيالك دائمًا

35
00:03:09,500 --> 00:03:12,420
.لم نعد في نفس المستوى
.افهم ذلك وأرحنا جميعًا

36
00:03:12,420 --> 00:03:14,370
.إنّه واثق من نفسه كثيرًا

37
00:03:14,370 --> 00:03:16,550
لا بدّ أنّه سار على نفس الحبل المشدود

38
00:03:16,550 --> 00:03:19,360
...بين الرّائحة السّيّئة والأومامي، ومع ذلك

39
00:03:19,360 --> 00:03:20,350
.صحيح

40
00:03:20,350 --> 00:03:23,930
الاختبار الأوّل هو هل نجح في رهانه
...بإزالة الرّائحة السّيّئة

41
00:03:24,330 --> 00:03:26,510
.لكن لا يوجد الكثير لنشكّ به في ذلك

42
00:03:26,510 --> 00:03:28,270
.لننتقل للتّذوّق

43
00:03:29,730 --> 00:03:31,350
!ساخن، ساخن، ساخن

44
00:03:31,980 --> 00:03:35,310
،الخليط الخفيف يلمع بشدّة
.لدرجة تخطف الأبصار

45
00:03:35,310 --> 00:03:37,730
.مهارات هاياما مميّزة بالفعل

46
00:03:41,400 --> 00:03:44,110
مـ-مستحيل. ما هذا؟

47
00:03:44,110 --> 00:03:45,990
مجرّد تقريبها لفمي

48
00:03:45,990 --> 00:03:49,580
!كافٍ لجعل البهارات تقوم بتأثيرها

49
00:03:50,000 --> 00:03:51,910
!والآن، وقت الأكل

50
00:03:56,990 --> 00:03:59,170
!لذيذ جدًّا

51
00:04:01,150 --> 00:04:02,450
!كلاّ يا بيرتا

52
00:04:02,450 --> 00:04:03,760
!تمالكي نفسك

53
00:04:03,760 --> 00:04:05,470
!نعم يا سيلا

54
00:04:05,470 --> 00:04:07,600
.علينا التزام الهدوء وتحليل هذا

55
00:04:08,780 --> 00:04:13,310
هذا الطّعم الحارّ اللاّذع أصله
!الببرين من الفلفل الأسود

56
00:04:13,310 --> 00:04:18,260
اتحاده مع البيرازين الّذي هو مكوّن عطريّ
،ينتج عن تسخين مسحوق الفلفل الأحمر

57
00:04:18,260 --> 00:04:20,320
.قد شكّل أساس هويّة نكهة الطّبق

58
00:04:20,320 --> 00:04:23,530
.كما أنّ الزّعتر يصدّ رائحة طرائد لحم الدّببة

59
00:04:23,530 --> 00:04:27,990
.بينما التّيمول الحادّ والقابض يقوم بمفعوله هنا

60
00:04:27,990 --> 00:04:31,200
...إضافة للفلفل الحارّ والأوريغانو

61
00:04:32,410 --> 00:04:33,910
!لا يمكنني التّحمّل

62
00:04:33,910 --> 00:04:36,880
!أنا أفقد كلّ إحساس بالمنطق

63
00:04:37,290 --> 00:04:38,340
!يا للدّقّة

64
00:04:38,910 --> 00:04:43,150
رائحة لحم الدّببة السّيّئة تحوّلت
!إلى أومامي قويّ بالكامل

65
00:04:43,150 --> 00:04:48,620
...الأومامي المعقّد النّاتج وطبقات النّكهة

66
00:04:50,150 --> 00:04:52,910
!هذا يتجاوز ما أعدّه يوكيهيرا سوما بكلّ وضوح

67
00:04:54,770 --> 00:04:57,020
،إضافة إلى مزيج بهارات كاجون

68
00:04:57,020 --> 00:05:01,180
أضفت إلى صلصة النّقع
توت العرعر الّذي تمّ سحقه

69
00:05:01,180 --> 00:05:02,990
.في هاون ومدقّة لزيادة عبيره

70
00:05:02,990 --> 00:05:05,220
،كلّما مضغتم الطّعام

71
00:05:05,220 --> 00:05:07,790
سينتشر الأومامي الحلو والمميّز للحم الدّببة

72
00:05:07,790 --> 00:05:09,870
.أكثر فأكثر كأنّه سيل في أفواهكم

73
00:05:10,200 --> 00:05:13,290
لقد اختار يوكيهيرا-دونو أكثر أجزاء
لحم الدّببة من ناحية الرّائحة السّيّئة

74
00:05:13,290 --> 00:05:16,210
واستعمل توت شزندرا لزيادة
.نكهات لحم الدّببة

75
00:05:16,210 --> 00:05:17,880
وما زال ذلك غير كافٍ؟

76
00:05:17,880 --> 00:05:23,010
لا بدّ أنّ ذلك يعني أنّ مهارات استعمال
.هاياما للبهارات أعلى بكثير

77
00:05:23,010 --> 00:05:29,720
قيل أنّ حتّى البشر يستطيعون
.التّمييز بين عشر آلاف رائحة تقريبًا

78
00:05:29,720 --> 00:05:33,180
.لقد استعملتُ تلك القدرة في طبقي بكلّ بساطة

79
00:05:34,110 --> 00:05:35,310
.يسهل عليك قول ذلك

80
00:05:35,310 --> 00:05:38,410
وكأنّ هناك من يستطيع إعداد طبق كهذا

81
00:05:38,410 --> 00:05:40,900
...دون حاسّة شمّ هاياما وحساسيّته الخارقة

82
00:05:41,370 --> 00:05:43,110
.والآن، وقت الضّربة القاضية

83
00:05:50,810 --> 00:05:55,160
ما كنت أبدًا لأفكّر في استعمال موقد اللّحام لحرق
...السّمك لإخراج زيوته وروائحه العطرة

84
00:05:55,540 --> 00:05:57,290
كيف فكّرت في ذلك؟

85
00:05:57,290 --> 00:05:58,730
.هيّا أخبرنا

86
00:05:58,730 --> 00:06:02,280
حسنًا، لن أحتلّ المركز الثّاني في
.المرّة التّالية بما أنّني أعرف خدعك

87
00:06:02,280 --> 00:06:04,200
.لا تعتقد أنّك أفضل من الجميع

88
00:06:04,200 --> 00:06:05,920
هل أتيتما إلى هنا لافتعال قتال؟

89
00:06:09,460 --> 00:06:10,890
...يا إلهي

90
00:06:11,940 --> 00:06:13,670
.آسف يا يوكيهيرا

91
00:06:13,670 --> 00:06:15,640
،لكن لديّ شيء أريد حمايته

92
00:06:15,640 --> 00:06:17,850
!حتّى إن عنى ذلك هزيمتكم

93
00:06:27,010 --> 00:06:28,450
.لم يستطع تجاوز هاياما

94
00:06:28,450 --> 00:06:29,910
...هذا يعني

95
00:06:29,910 --> 00:06:33,830
أنّ طرد يوكيهيرا سوما
قد تأكّد في هذا النّزال؟

96
00:06:35,290 --> 00:06:37,570
.ما زال الوقت باكرًا على الحكم

97
00:06:38,060 --> 00:06:41,580
.لقد تذوّقنا اللّحم المقليّ فحسب

98
00:06:42,010 --> 00:06:44,550
.ما زال علينا تذوّقه رفقة الصّلصة

99
00:06:45,510 --> 00:06:47,240
.صحيح، كان ذلك وشيكًا

100
00:06:47,240 --> 00:06:48,880
.لقد كدت أنهيه كلّه

101
00:06:48,880 --> 00:06:52,850
حسنًا، سأغمس لحم الدّببة المقليّ
.في صلصة اللّحم الخاصّة بهاياما

102
00:06:53,510 --> 00:06:58,060
صلصة مُعدّة من حساء بقايا لحم الدّببة في
...القِدر بجرعة كريمة من عبير توت العرعر

103
00:07:03,690 --> 00:07:04,820
!هذه هي

104
00:07:04,820 --> 00:07:07,150
فرع من قدرة تعرية الصّدر
الّتي تمتلكها عائلة ناكيري

105
00:07:07,560 --> 00:07:09,050
!المتوارثة لأجيال وأجيال

106
00:07:09,050 --> 00:07:11,930
،تمزّق الملابس المتفجّر بسبب قوّة الإرادة

107
00:07:11,930 --> 00:07:13,870
!"المعروفة أيضًا بـ"الانفجار

108
00:07:15,350 --> 00:07:16,830
...هذا بشبه تقريبًا

109
00:07:16,830 --> 00:07:20,540
!قصفًا بقنابل نكهات

110
00:07:20,540 --> 00:07:24,910
.تكاد دقّة إتقان هذا الطّبق تكون مرعبة

111
00:07:24,910 --> 00:07:27,210
!توت العرعر وبهارات كاجون

112
00:07:27,210 --> 00:07:28,820
!الطّعم الحلو والطّعم الحارّ

113
00:07:28,820 --> 00:07:30,850
...تناسب ذهبيّ لزيادة نكهة لحم الدّببة

114
00:07:30,850 --> 00:07:33,220
!لقد حقّق التّوازن المثاليّ

115
00:07:33,590 --> 00:07:39,430
إنّها نتيجة سعيه العلميّ عن كيفية
.ترابط روائح الطّعام ولذّته مع بعضها

116
00:07:40,020 --> 00:07:41,450
،إن كان عليّ تقديم تشبيه للأمر

117
00:07:41,450 --> 00:07:44,730
فهو يمثّل مدرعة مثاليّة لا يمكن
!اختراقها من كلّ الزّوايا

118
00:07:44,730 --> 00:07:48,690
!الطّبق عبارة عن حصن لا يُخترق

119
00:07:49,330 --> 00:07:51,560
.من المستحيل أن تتمكّن من اللّحاق بي

120
00:07:51,560 --> 00:07:54,660
.ليس ذلك ممكنًا دون حاسّة شمّي الخارقة

121
00:07:55,070 --> 00:07:56,140
.انتهى أمرك

122
00:07:56,860 --> 00:07:59,080
هل قلت أنّ أمري قد انتهى؟

123
00:07:59,080 --> 00:08:03,250
.هاياما، لا تسئ فهم الأمر

124
00:08:03,610 --> 00:08:06,540
.لم يستسلم بعد

125
00:08:07,010 --> 00:08:10,180
!لم يتمّ قرع جرس النّهاية بعد

126
00:08:15,390 --> 00:08:20,140
والآن، سأتذوّق شريحة اللّحم المفروم
.الّتي أعدّها يوكيهيرا سوما مع الصّلصة

127
00:08:20,490 --> 00:08:21,600
.يا لها من رائحة

128
00:08:22,060 --> 00:08:26,940
يبدو أنّ أساسها هو حساء لحم
.الدّببة أيضًا مثل صلصة هاياما

129
00:08:26,940 --> 00:08:27,480
.نعم

130
00:08:28,050 --> 00:08:30,690
وفّر توت شزندرا المنقوع
.في السّاكي نقطة تركيز

131
00:08:30,690 --> 00:08:33,150
.يا له من عبير ثوم خفيف

132
00:08:33,150 --> 00:08:34,490
ما هو مصدر هذا الاعتدال؟

133
00:08:36,790 --> 00:08:37,910
.فهمت

134
00:08:37,910 --> 00:08:41,040
،مقارنة بتوت العرعر الّذي استعمله هاياما

135
00:08:41,040 --> 00:08:44,250
فإنّ يوكيهيرا-تشين قد استعمل ذلك
.المكوّن كعامل أساسيّ في الصّلصة

136
00:08:45,950 --> 00:08:46,890
!ماذا؟

137
00:08:48,150 --> 00:08:51,150
.الطّبق بأكمله قد تغيّر بشكل كامل

138
00:08:51,150 --> 00:08:53,190
...يا له من عبير متواصل

139
00:08:53,190 --> 00:08:56,050
.إنّه لا يعلق بالفم رغم مثابرته

140
00:08:56,050 --> 00:08:59,720
وكأنّ نكهات لحم الدّببة الحلوة
...قد تمّ شحذها

141
00:08:59,970 --> 00:09:03,030
...وتتدافع مباشرة من خلالي

142
00:09:06,900 --> 00:09:08,080
!ماذا يحدث؟

143
00:09:08,080 --> 00:09:09,980
!لقد خُلعت ملابسنا

144
00:09:09,980 --> 00:09:11,580
.ها هي ذي

145
00:09:11,580 --> 00:09:15,070
هذه التّقنيّة هي نسخة أكثر تقدّمًا
.عن قدرة الانفجار السّابقة

146
00:09:15,070 --> 00:09:17,030
أكثر تقدُّمًا عن الانفجار؟

147
00:09:17,340 --> 00:09:21,910
عند تذوّق طبق يمتلئ بالتّناغم الرّوحيّ
،وجدير بتعرية الصّدر

148
00:09:22,250 --> 00:09:27,180
فإنّ قوّة الإرادة الّتي تتدفّق في عروق
.عائلة ناكيري تتحرّر كأنّها موجة

149
00:09:28,210 --> 00:09:35,340
.ينقل هذا قدرة التّعرّي للغرباء بشكل مؤقّت

150
00:09:35,340 --> 00:09:38,060
!"إنّها تُعرف بـ"الهديّة

151
00:09:39,220 --> 00:09:41,000
!الهديّة؟

152
00:09:41,000 --> 00:09:43,930
!استطاع يوكيهيرا سوما إعداد طبق كهذا؟

153
00:09:44,890 --> 00:09:49,990
السّرّ خلف نكهات هذه الصّلصة اللّذيذة
هو العسل والخلّ البلسميّ، صحيح؟

154
00:09:49,990 --> 00:09:51,270
!هذا صحيح

155
00:09:51,600 --> 00:09:54,430
تُضيف حلاوة العسل الخفيفة
،عُمقًا لنكهة الصّلصة

156
00:09:54,430 --> 00:09:58,530
بينما تجمع حمضيّة الخلّ النّكهات
.معًا وتركّزها بشكل كبير

157
00:10:02,990 --> 00:10:05,450
.هذه الرّائحة العطرة... مصدرها الكرملة

158
00:10:05,880 --> 00:10:08,420
.لقد قمتُ بكرملة العسل ببطء

159
00:10:09,010 --> 00:10:13,170
هذه عمليّة أكسدة تحدث عند
تسخين السّكّر، صحيح يا بيرتا؟

160
00:10:13,170 --> 00:10:14,330
.نعم يا سيلا

161
00:10:14,330 --> 00:10:18,430
إنّها تقنيّة مهمّة تُستعمل على نطاق
واسع من الأطباق

162
00:10:18,430 --> 00:10:19,930
.بدءًا بالطّبخ الفرنسيّ وصولاً للحلويّات

163
00:10:19,930 --> 00:10:21,380
!هذا صحيح

164
00:10:21,380 --> 00:10:24,600
،أوّلاً، قمت بكرملة العسل ببطء

165
00:10:24,600 --> 00:10:27,680
ثمّ قمت بتخفيفه بالخلّ البلسميّ
.إلى أن وصل إلى نقطة تماسك جيّدة

166
00:10:28,200 --> 00:10:31,250
ثمّ أضفت الثّوم والبصل المفروم
،اللّذان تمّ قليُهما بشكل منفصل

167
00:10:31,250 --> 00:10:33,400
.وغليتُ المزيج مع توت شزندرا

168
00:10:33,400 --> 00:10:37,820
وفي النّهاية، أضفت حساء لحم الدّببة
وتبّلت كلّ شيء بالملح

169
00:10:38,830 --> 00:10:43,580
لإنشاء الصّلصة الأفضل القادرة على
!تسريع نكهات لحم الدّببة المفروم

170
00:10:46,180 --> 00:10:48,990
،عزّزتَ لحم الدّببة بالعسل

171
00:10:48,990 --> 00:10:53,460
ثمّ استعملتَ الخلّ البلسميّ والكرملة
."بغرض "التّقليل" و"التّشديد

172
00:10:54,920 --> 00:10:58,320
بعبارات أخرى، تمكّنتُ من إظهار
،مبدأين متعارضين نظريًّا

173
00:10:58,320 --> 00:11:02,390
،تقليل الرّائحة و وتشديدها
.وذلك بشكل منسجم في طبق واحد

174
00:11:03,530 --> 00:11:08,510
آسف، لكنّني قرّرت استعمال المبادئ
.الّتي استعملتَها في النّهائيّ ضدّك

175
00:11:09,850 --> 00:11:13,860
إنّ يوكيهيرا-تشين لا يتهاون
.في تقديم كلّ ما لديه أثناء نزال ما

176
00:11:13,860 --> 00:11:17,070
.أنا أحبّ ذلك فيه

177
00:11:17,820 --> 00:11:22,530
كان لحم الدّببة المقليّ لهاياما
.طبقًا ممتازًا وأنيقًا

178
00:11:22,900 --> 00:11:26,660
اللّحم المقليّ بحدّ ذاته
.كان متفوّقًا بشكل ساحق

179
00:11:26,660 --> 00:11:30,910
،ولكن إن كنّا سنحكم على الصّلصة بحدّ ذاتها

180
00:11:30,910 --> 00:11:36,000
!فإنّ المنتصر هنا هو يوكيهيرا سوما

181
00:11:38,210 --> 00:11:39,210
!لقد لحق به

182
00:11:39,210 --> 00:11:40,970
!لكن من الفائز؟

183
00:11:40,970 --> 00:11:41,590
!والآن

184
00:11:41,590 --> 00:11:43,800
!سنبدأ التّقييم

185
00:11:43,800 --> 00:11:45,510
،ناكيري سوي-دونو

186
00:11:45,510 --> 00:11:46,720
،سيلا-دونو

187
00:11:46,720 --> 00:11:47,930
...بيرتا-دونو

188
00:11:48,460 --> 00:11:50,640
!قدّموا لنا أصواتكم رجاءً

189
00:11:51,350 --> 00:11:54,940
إن تمّ الحكم على طبقي اللّحم المقليّ
،والصّلصة معًا كطبق واحد

190
00:11:55,450 --> 00:11:59,650
فأيّ الطّبقين تمكّن من النّجاح في
إظهار نكهات لحم الدّببة؟

191
00:12:02,490 --> 00:12:03,320
!اتّخذتُ قراري

192
00:12:05,140 --> 00:12:05,990
!وأنا أيضًا

193
00:12:07,460 --> 00:12:08,160
!هذا هو

194
00:12:12,060 --> 00:12:12,790
!تعادل

195
00:12:12,790 --> 00:12:14,740
هل يعني هذا أنّهما متعادلان؟

196
00:12:14,740 --> 00:12:19,250
إلى من ستعطي صوتك الأخير
يا ناكيري سوي-دونو؟

197
00:12:19,660 --> 00:12:21,210
!أومامي لا تشوبه شائبة

198
00:12:21,640 --> 00:12:23,640
،حصن لا يُخترق في كفّة

199
00:12:23,640 --> 00:12:26,970
وآلة حصار حربيّة تركّز كلّ نكهاتها
!في ضربة واحدة في كفّة أخرى

200
00:12:27,310 --> 00:12:29,930
أيّ الطّبقين سيختار ناكيري سوي-دونو؟

201
00:12:33,470 --> 00:12:37,150
لا توجد أيّ عيوب في طبق لحم
.الدّببة المقليّ خاصّتي

202
00:12:37,610 --> 00:12:39,110
.لكنّه تمكّن من اللّحاق بي

203
00:12:39,110 --> 00:12:40,570
...يوكيهيرا

204
00:12:41,780 --> 00:12:43,740
.أنت منظر لا يسرّ النّاظر إليه

205
00:12:43,740 --> 00:12:46,110
.لا يمكنني أن أخسر

206
00:12:46,110 --> 00:12:47,580
.قطعًا لا

207
00:12:49,010 --> 00:12:52,330
.في هذا النّزال، كلاكما متساوٍ تقريبًا في النّكهات

208
00:12:52,890 --> 00:12:55,790
هذا ينعكس في تقاسم صوتَيْ
.بيرتا وسيلا عليكما

209
00:12:56,150 --> 00:12:58,740
،إن تواجد عامل ما سيحدّد النّتيجة

210
00:12:58,740 --> 00:13:01,510
.فسيكون هوس أحدكما بطبقه

211
00:13:01,970 --> 00:13:07,430
يوكيهيرا سوما، أنت لم تستعمل
عسلاً عاديًّا في الصّلصة، صحيح؟

212
00:13:08,180 --> 00:13:12,890
بالفعل، هذه اللّمحات القابضة الخفيفة
—لرائحة هذا العسل العطر مصدرها

213
00:13:12,890 --> 00:13:15,100
!أنا مسرور لملاحظتك لذلك

214
00:13:15,100 --> 00:13:17,350
!استعملت عسلاً من شجرة أمور الفلّينيّة

215
00:13:17,350 --> 00:13:20,590
،عسل من شجرة من الفصيلة السّذابيّة

216
00:13:20,590 --> 00:13:22,940
...نفس فصيلة شجرة المندرين

217
00:13:23,260 --> 00:13:28,280
نعم، معروف امتلاكها لحلاوة خفيفة
.ومذاقها المرّ الخفيف الّذي يدوم في الفم

218
00:13:28,610 --> 00:13:32,260
كانت أنواع أخرى من العسل أن تكمل

219
00:13:32,260 --> 00:13:34,740
،غنى وطراوة لحم الدّببة

220
00:13:34,740 --> 00:13:39,460
لكنّها كانت لتقود إلى نكهة ثقيلة للغاية

221
00:13:39,460 --> 00:13:41,920
إن قامت نكهاتها بتعزيز تأثير شريحة
.اللّحم المفروم القويّ

222
00:13:41,920 --> 00:13:44,380
لكن عند استعمال العسل
...من شجرة أمور الفلّينيّة

223
00:13:44,900 --> 00:13:47,850
فإنّ المذاق القابض والمرّ
الخفيف الّذي يدوم في الفم

224
00:13:47,850 --> 00:13:50,270
،هو اختيار مناسب تمامًا ومثاليّ للحم الدّببة

225
00:13:50,270 --> 00:13:51,850
!يكاد يكون معجزة

226
00:13:52,220 --> 00:13:56,390
لم يدع يوكيهيرا سوما عيوب استعمال
العسل الممكنة تمرّ مرور الكرام

227
00:13:56,390 --> 00:13:58,980
.وسعى خلف مذاق أفضل إلى حدّ أبعد بكثير

228
00:13:58,980 --> 00:14:02,380
لكن كيف توصّل إلى هذه التّركيبة؟

229
00:14:02,380 --> 00:14:06,400
صحيح، يصعب تصديق أنّه حصل على إلهام
.عشوائيّ باستعمال هذا العسل بالتّحديد

230
00:14:07,820 --> 00:14:11,150
لقد تمكّنت من هزيمتي في مهرجان
.وليمة القمر أيضًا

231
00:14:11,150 --> 00:14:15,950
عليّ أن أعترف أنّك لا تستسلم أبدًا حتّى
.تعثر على إجابة ترضيك يا يوكيهيرا-تشين

232
00:14:16,590 --> 00:14:18,690
،إن عثرتم على أيّ شيء يمكن استعماله كمكوّن

233
00:14:18,690 --> 00:14:20,080
!أعلموني بالأمر في الحال رجاءً

234
00:14:20,490 --> 00:14:24,090
دعونا نأتي بأكبر عدد من الأفكار
!بقدر الإمكان قبل الغروب

235
00:14:24,090 --> 00:14:25,590
!يوكيهيرا-دونو

236
00:14:25,590 --> 00:14:29,340
!وجدنا بلّوطًا وتوت كيوي حتّى الآن

237
00:14:29,340 --> 00:14:32,720
!لقد جمعنا أوراق تنّوب الييزو

238
00:14:32,720 --> 00:14:33,780
!جيّد

239
00:14:33,780 --> 00:14:34,560
!شكرًا لكم

240
00:14:35,030 --> 00:14:37,320
!حسنًا، لنذهب إلى القمّة الآن

241
00:14:37,320 --> 00:14:37,890
.حسنًا

242
00:14:38,300 --> 00:14:38,860
!جيّد

243
00:14:38,860 --> 00:14:41,090
!لننزل إلى الجدول

244
00:14:41,090 --> 00:14:41,610
...كلاّ

245
00:14:42,270 --> 00:14:46,630
سنمضي بقدر المستطاع لزيادة
.خياراتنا بقدر الإمكان

246
00:14:46,630 --> 00:14:48,860
!ثمّ سأختبر كلّ شيء في المطبخ

247
00:14:48,860 --> 00:14:53,660
،سوف أختبر العشرات والمئات
!بل الآلاف من التّركيبات

248
00:14:54,000 --> 00:14:56,890
.سوف نخرج للجبال ثانية غدًا أيضًا

249
00:14:56,890 --> 00:14:57,960
.شكرًا على المساعدة

250
00:14:57,960 --> 00:14:59,250
!ثانية؟

251
00:14:59,250 --> 00:15:03,010
أعضاء مجموعة أبحاث الطّبخ
.الصّينيّ مدرّبون جيّدًا

252
00:15:03,010 --> 00:15:05,900
يمكنك استغلالهم بقدر الإمكان
.ما دمت لن تقتلهم

253
00:15:05,900 --> 00:15:07,260
!أيّها القائد

254
00:15:07,260 --> 00:15:10,030
وبذلك انتشرنا في كلّ أرجاء المكان

255
00:15:10,030 --> 00:15:12,510
.ووجدنا أخيرًا عسلاً كخيار محتمل

256
00:15:12,850 --> 00:15:16,220
،لكن هنالك الكثير من أنواع العسل

257
00:15:16,720 --> 00:15:22,090
لذلك أخذ الأمر وقتًا أطول لأقرّر
.استعمال عسل شجرة أمور الفلّينيّة

258
00:15:23,770 --> 00:15:26,170
ما هو موجود في أساس هذا الطّبق

259
00:15:26,170 --> 00:15:29,990
ما هو إلاّ فضول الطّاهي وهوسه
!بالنّكهة اللّذان لا حدود لهما

260
00:15:29,990 --> 00:15:33,450
!وبذلك، أستطيع أن أرى من يكون الطّاهي كفرد

261
00:15:35,160 --> 00:15:36,370
!ماذا؟

262
00:15:36,370 --> 00:15:38,120
ولكنّ العامل الّذي فصل بينكم

263
00:15:38,120 --> 00:15:41,080
.كان لأيّ درجة كان الطّبق انعكاسًا لتميّز الطّاهي

264
00:15:41,080 --> 00:15:43,140
المتنافس الّذي استحقّ النّصر

265
00:15:43,140 --> 00:15:46,440
هو الطّاهي الّذي سعى خلف
!طبخه بطريقته الخاصّة

266
00:15:46,440 --> 00:15:50,630
الطّاهي الّذي سعى ليعرف
!كيف يجب أن يكون طبخه

267
00:15:50,630 --> 00:15:51,720
!مستحيل

268
00:15:51,720 --> 00:15:53,970
—أنّى له أن يصل إلى مستوى طبقي الرّفيع

269
00:15:53,970 --> 00:15:55,940
هل تعتقد ذلك بالفعل؟

270
00:15:57,310 --> 00:15:58,300
...الطّاهي دوجيما

271
00:15:58,300 --> 00:16:01,940
إذًا فأنت تقول أنّك سعيت لطعام
الذّوّاقة الحقيقيّ بأفضل مهاراتك؟

272
00:16:01,940 --> 00:16:03,800
.بالطّبع

273
00:16:03,800 --> 00:16:06,420
—لقد أنشأت توازنًا رفيعًا ومثاليًّا

274
00:16:06,420 --> 00:16:07,890
،كلّ ذلك بمفردك

275
00:16:07,890 --> 00:16:10,240
دون أن تعرف لِمن تطبخ؟

276
00:16:13,030 --> 00:16:14,980
.هذا رائع يا هاياما-كُن

277
00:16:14,980 --> 00:16:16,980
.إنّ له رائحة غنيّة

278
00:16:16,980 --> 00:16:18,410
.بالطّبع، هذا لا شيء

279
00:16:19,450 --> 00:16:22,160
.سأكون التّلميذ الأوّل في توتسكي

280
00:16:22,530 --> 00:16:24,120
.نعم، نعم، نعم، نعم

281
00:16:24,890 --> 00:16:25,580
.جيّد

282
00:16:25,580 --> 00:16:27,310
.هذا ممتاز

283
00:16:27,310 --> 00:16:30,740
لكن هل عليّ استعمال مسحوق خشن
للبهارات المستعملة في مزيج كاجون

284
00:16:30,740 --> 00:16:33,550
للسّماح للنّكهات بالتّميّز أكثر؟

285
00:16:33,900 --> 00:16:35,760
—ما رأيك يا جو

286
00:16:43,190 --> 00:16:45,100
لا أحتاج حتّى لتذوّق الطّبق

287
00:16:45,770 --> 00:16:48,440
لأعرف أنّه مختلف تمامًا عمّ قدّمته

288
00:16:48,440 --> 00:16:50,650
.في نهائيّ انتخابات الخريف

289
00:16:51,970 --> 00:16:55,250
هاياما أكيرا، هل يمكنك أن تقول بكلّ صراحة

290
00:16:55,250 --> 00:16:58,120
أنّك تعاملت مع هذا الطّبق بشغف حقيقيّ

291
00:16:58,120 --> 00:17:00,580
وفعلت كلّ ما بوسعك خلال فترة
عمليّة اختبار الوصفات؟

292
00:17:01,060 --> 00:17:05,770
هل ربّما كنتَ تفتقر للرّغبة الحماسيّة
بامتلاك شخص يقول أنّ الطّبق لذيذ؟

293
00:17:10,010 --> 00:17:15,180
...إذًا كيف تمكّن يوكيهيرا
كيف تمكّن من الوصول حيث هو الآن؟

294
00:17:15,980 --> 00:17:18,550
ما هو الشّيء الّذي يحفّزك؟

295
00:17:18,960 --> 00:17:22,320
هل كنتَ بالفعل جشعًا لتلك
الدّرجة بشأن طبقك

296
00:17:22,320 --> 00:17:24,310
لأنّك رغبت بالنّجاح في امتحانات التّقدّم؟

297
00:17:24,810 --> 00:17:26,440
ما الّذي تتحدّث عنه يا هاياما؟

298
00:17:26,770 --> 00:17:28,650
!كان لأجلك! لأجلك

299
00:17:28,650 --> 00:17:31,070
!كلّ هذا لأنّني أردتُك أن تأكل الطّبق بالطّبع

300
00:17:31,410 --> 00:17:33,820
!كلّ هذا لأدفعك أنت لتقول أنّه لذيذ

301
00:17:33,820 --> 00:17:35,530
!لأسحقك

302
00:17:36,130 --> 00:17:39,160
!لهذا السّبب كنت أعمل بجدّ

303
00:17:39,160 --> 00:17:43,900
!لذلك لا أحتمل رؤيتك مشتّت الذّهن هكذا

304
00:17:47,860 --> 00:17:50,000
.إليك طبقًا ساخنًا

305
00:17:50,310 --> 00:17:52,580
!بالهناء الشّفاء يا هاياما

306
00:18:14,100 --> 00:18:15,980
.هكذا إذًا

307
00:18:15,980 --> 00:18:17,110
،شغف يوكيهيرا لهذا الطّبق

308
00:18:17,820 --> 00:18:22,080
،كلّ المحن والمصاعب الّتي مرّ بها
.تتدفّق في داخلي

309
00:18:22,730 --> 00:18:25,250
،لقد حافظ عليّ أمام ناظريه
،رغم أنّني أغلقت على نفسي

310
00:18:25,250 --> 00:18:28,710
.ولم يفكّر إلاّ في كيفية تحسين الطّبق

311
00:18:29,150 --> 00:18:31,880
لم يكن مثلي أنا الّذي فقد هدفه
الّذي كان يطبخ من أجله

312
00:18:32,540 --> 00:18:37,890
.ولم يستطع إلاّ إجهاد نفسه بالكامل

313
00:18:39,950 --> 00:18:40,930
جون؟

314
00:18:44,560 --> 00:18:45,930
.أنا آسفة

315
00:18:45,930 --> 00:18:46,710
هل آلمك ذلك؟

316
00:18:46,710 --> 00:18:48,120
هل أنت بخير؟

317
00:18:48,120 --> 00:18:50,330
لماذا أنت هنا يا شيومي-سينباي؟

318
00:18:50,330 --> 00:18:51,690
.لقد دعوتُها

319
00:18:52,070 --> 00:18:54,190
فنحن نعرف بعضنا منذ أيّام
.مسكن النّجم القطبيّ

320
00:18:54,660 --> 00:18:56,100
.يا لها من صدمة

321
00:18:56,620 --> 00:18:58,440
.لم تضربني جون من قبل

322
00:18:59,530 --> 00:19:01,660
،أنا وليّة أمرك أيضًا

323
00:19:01,660 --> 00:19:03,160
.لذلك اعتبر هذا تأديبًا أبويًّا

324
00:19:03,770 --> 00:19:08,300
سوف أطلعك باستنتاجاتي
.بعد التّفكير بشأن كلّ ما حدث

325
00:19:09,000 --> 00:19:12,980
.لا أحتاج لمختبر أبحاث بعد الآن

326
00:19:13,490 --> 00:19:16,650
هنالك أمر أردتك أن تفعله

327
00:19:16,650 --> 00:19:19,580
.أكثر من رغبتي في استعادة معدّاتي ومزانيّتي

328
00:19:19,580 --> 00:19:20,590
ماذا؟

329
00:19:21,130 --> 00:19:23,870
...ما أردتُ أن أراه حقًّا

330
00:19:24,310 --> 00:19:29,670
هو أن تستمتع بطبخك

331
00:19:29,670 --> 00:19:34,770
وتكرّس نفسك لحرفتك مع الكثير
.من الأصدقاء في مثل سنّك

332
00:19:35,650 --> 00:19:38,420
.لا تزال طفلاً يا هاياما-كُن

333
00:19:38,860 --> 00:19:43,570
ليس عليك أن تشعر بالمسؤوليّة
.بسبب إغلاق مختبر الأبحاث

334
00:19:49,530 --> 00:19:52,930
.ماذا؟ لا تعامليني كطفل يا جون

335
00:19:52,930 --> 00:19:54,630
!لا تناديني باسمي فقط

336
00:19:55,010 --> 00:19:58,880
،هاياما، لا أهتمّ بشأن ما يفعله المركز

337
00:19:59,350 --> 00:20:02,130
.لكنّني ما زلت أريد العمل على الطّبخ معك

338
00:20:02,730 --> 00:20:05,760
.لن أسمح لك بالتّخلّي عن طبخك

339
00:20:06,790 --> 00:20:09,060
...هذا صحيح. أنا

340
00:20:11,290 --> 00:20:13,150
...بتواجدي هنا

341
00:20:13,150 --> 00:20:14,690
...مع الجميع

342
00:20:15,340 --> 00:20:18,440
.كنت أستمتع بوقتي بالفعل

343
00:20:20,410 --> 00:20:22,590
.هذا ما سمحتَ لي بتذكّره

344
00:20:23,400 --> 00:20:26,850
.وكأنّها... رسالة من الإله

345
00:20:32,870 --> 00:20:36,290
.أخيرًا

346
00:20:37,210 --> 00:20:38,920
.أخيرًا حدث الأمر

347
00:20:43,860 --> 00:20:45,760
،بصوت واحد ضدّ صوتين

348
00:20:45,760 --> 00:20:47,550
!نعلن أنّ يوكيهيرا سوما هو الفائز

349
00:20:50,060 --> 00:20:51,520
!سعيد لأنّ الطّبق أعجبكم

350
00:22:23,810 --> 00:22:27,290
.لم يعد لدينا منزل الآن على ما أظنّ

351
00:22:27,290 --> 00:22:28,930
لماذا تضحكين إذًا؟

352
00:22:28,930 --> 00:22:31,120
.بشأن ذلك

353
00:22:31,120 --> 00:22:33,450
لماذا لا تأتي إلى النّجم القطبيّ؟

354
00:22:33,910 --> 00:22:37,160
!سيكون لديك مكان للطّبخ أيضًا على الأقل

355
00:22:37,510 --> 00:22:40,110
.لقد كنتِ تعيشين هناك يا شيومي-سينباي

356
00:22:40,110 --> 00:22:41,790
.لدينا الكثير من الغرف الشّاغرة

357
00:22:41,790 --> 00:22:42,850
صحيح؟

358
00:22:42,850 --> 00:22:43,650
!"قل "نعم

359
00:22:43,650 --> 00:22:45,130
...يوكيهيرا-كُن

360
00:22:45,530 --> 00:22:47,270
.شكرًا يا يوكيهيرا

361
00:22:47,850 --> 00:22:49,840
.أنا أقدّر اقتراحك هذا بالفعل

362
00:22:51,070 --> 00:22:52,640
!يوكيهيرا-كُن

363
00:22:53,070 --> 00:22:54,550
.مرحبًا يا ناكيري

364
00:22:55,430 --> 00:22:56,550
كيف سار الأمر؟

365
00:22:56,980 --> 00:23:00,600
.صحيح، لقد تمكّنت من تخليص نفسي

366
00:23:00,940 --> 00:23:03,470
إ-إذًا فقد فزت؟

367
00:23:03,470 --> 00:23:05,020
هل ركضت كلّ هذه المسافة إلى هنا؟

368
00:23:05,020 --> 00:23:07,330
.شعرك مبعثر بالكامل

369
00:23:08,170 --> 00:23:10,440
!بالطّبع فعلت

370
00:23:10,440 --> 00:23:12,870
.ها أنت هنا

371
00:23:13,590 --> 00:23:16,330
.أنا أيدا، مساعد أزامي-ساما

372
00:23:16,330 --> 00:23:18,220
.المعذرة

373
00:23:19,900 --> 00:23:22,450
،أنت تعرف ماذا يحدث هنا
صحيح يا هاياما أكيرا؟

374
00:23:22,450 --> 00:23:22,790
.نعم

375
00:23:23,250 --> 00:23:27,380
.نظرًا إلى النّتائج الأخيرة، فقد تمّ طردك

376
00:23:29,810 --> 00:23:32,770
تلقّينا تقارير من امتحانات وقعت
.على المسارات الأخرى أيضًا

377
00:23:33,610 --> 00:23:36,930
!إرينا-ساما... أنا جدّ آسفة

378
00:23:41,830 --> 00:23:43,560
!سُحقًا

379
00:23:57,240 --> 00:24:00,390
!كلّ من المذكورين للتّوّ قد طُردوا

380
00:24:07,630 --> 00:24:10,030
!صحيح، لنذهب للمحطّة في الشّمال