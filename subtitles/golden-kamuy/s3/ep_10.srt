1
00:00:15,200 --> 00:00:16,730
!أمسكته

2
00:00:18,290 --> 00:00:22,720
.يضع النيفخ دهون الفقمات على كلّ شيء

3
00:00:22,720 --> 00:00:25,580
.إنّها مثل صلصة الصويا لليابانيين

4
00:00:25,580 --> 00:00:28,500
.إنّها مصدر طعام مهم في هذا الوقت من السنة

5
00:00:31,690 --> 00:00:32,900
.حيوان رنة

6
00:00:32,900 --> 00:00:34,680
هل أتى من الجانب الآخر؟

7
00:00:35,790 --> 00:00:40,180
.ربما هرب من القارة لأنّ شيئًا ما كان يطارده أيضًا

8
00:01:05,370 --> 00:01:11,860
الإله الذهبي

9
00:02:40,380 --> 00:02:44,020
.استعمل بعض الثلج المتسخ لإخفاء الثقوب

10
00:02:44,020 --> 00:02:45,560
،لا تضع الكثير

11
00:02:45,560 --> 00:02:48,140
.وإلّا فلن نتمكن من إدخال المتفجرات لاحقًا

12
00:02:55,410 --> 00:02:56,550
.كما ظننا

13
00:02:56,550 --> 00:02:58,110
.المنارة فارغة

14
00:02:58,700 --> 00:03:00,640
.حصلنا على المتفجرات

15
00:03:07,240 --> 00:03:10,440
الجهة الأمامية محروسة بشكل كبير، لذا سنذهب

16
00:03:10,440 --> 00:03:13,650
.من الخلف، الجهة المقابلة لمضيق تارتاري

17
00:03:13,650 --> 00:03:15,170
.سنفجر هذه النقاط الأربع في آن واحد

18
00:03:15,540 --> 00:03:20,130
.وتلك هي إشارة الهروب لصوفيا ورفاقها

19
00:03:20,130 --> 00:03:20,960
.هذا صحيح

20
00:03:20,960 --> 00:03:23,890
.قلت لها أن تفعل ذلك غدًا على الساعة 4:00

21
00:03:24,890 --> 00:03:26,670
.نحن جاهزون

22
00:03:26,670 --> 00:03:28,930
.حان الوقت يا أسيربا

23
00:03:29,350 --> 00:03:33,440
.أنا واثق أنّك ستتذكرين شيئًا ما عند لقائها

24
00:03:33,970 --> 00:03:36,180
.لا يسعني انتظار ذلك

25
00:04:17,230 --> 00:04:18,950
ما الخطب يا شيرايشي؟

26
00:04:18,950 --> 00:04:20,710
لمَ لم تفجرها؟

27
00:04:20,710 --> 00:04:23,240
!وضعتها، لكنها لم تنفجر

28
00:04:23,240 --> 00:04:24,980
!وكذلك خاصتي

29
00:04:26,350 --> 00:04:27,280
!تبًّا

30
00:04:27,280 --> 00:04:29,870
!أظنّها لم تُخَزَّن بشكل جيّد

31
00:04:31,950 --> 00:04:33,400
.انفجر شيء ما

32
00:04:34,970 --> 00:04:36,210
.إنّه سجن أكو

33
00:04:46,700 --> 00:04:48,260
!خاراشو

34
00:05:26,490 --> 00:05:27,600
.هذا غريب

35
00:05:31,720 --> 00:05:33,420
.لا أحد يخرج من هناك

36
00:05:46,890 --> 00:05:50,420
.يولبارس تعني نمر في لغة التّتار

37
00:05:51,840 --> 00:05:55,170
،النمر السيبيري هو الأضخم من بين جميع النمور

38
00:05:55,170 --> 00:05:58,150
.يهاجم ويفترس حتّى الدببة والتماسيح

39
00:05:58,670 --> 00:06:05,530
!أحيانا يعبر المضيق مطاردًا فرائسه ويبتعد كثيرًا عن منطقته

40
00:07:09,160 --> 00:07:10,030
!حسنًا

41
00:07:25,000 --> 00:07:26,320
...ذلك الزي

42
00:07:27,180 --> 00:07:28,680
كارافوتو أينو؟

43
00:07:29,420 --> 00:07:31,880
.كارافوتو أينو؟ لا

44
00:07:33,940 --> 00:07:36,080
...أراني ويلك

45
00:07:36,640 --> 00:07:39,500
.كان يرتدي التيتارابي في صغره

46
00:07:42,230 --> 00:07:43,430
.تلكما العينان

47
00:07:43,980 --> 00:07:45,800
.عينا ويلك

48
00:07:48,040 --> 00:07:49,220
هل أنت صوفيا؟

49
00:07:51,430 --> 00:07:52,780
...أسيربا

50
00:07:54,560 --> 00:07:56,660
.لم يكن هذا ما تخيلته

51
00:07:57,100 --> 00:07:58,140
!صوفيا

52
00:08:02,220 --> 00:08:04,690
!أصحبت امرأة فاتنة

53
00:08:07,360 --> 00:08:08,970
!يولبارس

54
00:08:56,030 --> 00:08:57,970
!نجح الأمر

55
00:08:58,210 --> 00:09:00,070
.لا أحد يلاحقنا

56
00:09:00,070 --> 00:09:03,180
،أصبنا في اختيار الفجر كوقت للهرب

57
00:09:03,180 --> 00:09:04,310
.عندما يكون الكثير من الصيادين

58
00:09:12,660 --> 00:09:15,110
.أريدك أن تحدثيني عن أبي

59
00:09:15,110 --> 00:09:17,530
.أخبريني أشياء وحدك تعرفينها

60
00:09:35,320 --> 00:09:39,800
.ترعرعت في منزل مترف وارتديت الملابس الغالية

61
00:09:40,950 --> 00:09:43,640
.كنت فتاة غنية لم تعرف سوى المدن

62
00:09:47,140 --> 00:09:50,060
.التقيت بهما كجزء من حركة ثورية

63
00:09:52,040 --> 00:09:55,480
.علماني أشياء كثيرة لم أعرفها

64
00:09:57,140 --> 00:09:59,050
...عنب الثور المملّح

65
00:09:59,820 --> 00:10:02,080
...زلاجات كلاب كارافوتو أينو

66
00:10:02,360 --> 00:10:04,750
...هوهوتشيري المربوط بغرة الشعر

67
00:10:05,380 --> 00:10:07,660
...قراء الطالع بالعظم الخاصة بالويلتا

68
00:10:08,430 --> 00:10:11,700
...ملابس النيفخ المصنوعة من جلود الفقمات والسمك

69
00:10:12,630 --> 00:10:16,550
...حياة الأقليات العرقية التي كانت تعيش في أقصى الشرق

70
00:10:20,550 --> 00:10:23,020
...لغاتنا الفريدة من نوعها

71
00:10:23,670 --> 00:10:25,400
...الآلهة التي نؤمن بها

72
00:10:34,450 --> 00:10:37,840
.سيختفي كلّ شيء إن لم نقاتل لحمايتها

73
00:10:39,040 --> 00:10:43,810
.سينسى جيل الأطفال الجديد لغتهم وآلهتهم

74
00:10:53,470 --> 00:10:58,040
لمَ خسر سكان أمريكا الأصليون أمام البيض؟

75
00:10:58,660 --> 00:11:02,680
.لأنّ كلّ القبائل كانت في حرب مع بعضها

76
00:11:03,670 --> 00:11:05,520
،قيل لي أنّ في هوكّايدو اليابانية

77
00:11:05,520 --> 00:11:10,380
.هناك أناس لهم تقاليد مشابهة للكارافوتو أينو

78
00:11:15,230 --> 00:11:20,520
...جميعهم في أعداد قليلة، لكن إن تعاونّا جميعًا

79
00:11:21,210 --> 00:11:22,570
تعاون؟

80
00:11:23,040 --> 00:11:26,080
،علينا إنشاء اتحاد لولايات أقصى الشرق

81
00:11:26,510 --> 00:11:29,350
.يشمل كارافوتو وهوكّايدو

82
00:11:33,790 --> 00:11:35,260
.اتّحاد ضخم

83
00:11:42,220 --> 00:11:45,430
.فجّر كيرورانكي الجدار وسمح للسجناء بالهرب

84
00:11:45,910 --> 00:11:48,680
.تأخرنا قليلًا، لكنّهم قريبون

85
00:11:50,090 --> 00:11:51,320
ماذا إذًا يا ريو؟

86
00:11:54,250 --> 00:11:55,380
من هناك؟

87
00:11:55,380 --> 00:11:56,690
هل وجدت الرائحة؟

88
00:11:57,150 --> 00:12:01,780
.لا تقل لي أنّهم هربوا عبر طوافات الجليد

89
00:12:05,920 --> 00:12:09,410
.إن قال ريو أن هذا هو الطريق، فأنا أصدقه

90
00:12:11,300 --> 00:12:12,460
ما الخطب؟

91
00:12:14,540 --> 00:12:15,670
نمر؟

92
00:12:27,340 --> 00:12:29,640
،إحدى تلك الطلقات كانت طويلة

93
00:12:29,640 --> 00:12:33,900
.مثل التي يمكن سماعها من بندقية تستعمل بارودًا أسودًا عتيقًا

94
00:12:35,870 --> 00:12:36,930
.لا يمكن

95
00:12:42,940 --> 00:12:45,950
الإله الذهبي

96
00:12:56,300 --> 00:12:58,150
شيرايشي، إلى أين أنت ذاهب؟

97
00:12:58,150 --> 00:12:59,710
.اذهبوا من دوني

98
00:13:01,430 --> 00:13:03,810
.أريد أن أتبول

99
00:13:03,810 --> 00:13:07,550
.يصعب عليّ إخراج قضيبي بكل هذه الطبقات

100
00:13:10,610 --> 00:13:12,180
.كان هذا وشيكًا

101
00:13:14,860 --> 00:13:16,190
!المسافة تتسع

102
00:13:16,190 --> 00:13:19,140
!طوافات الجليد تتحرك مع التيار

103
00:13:19,140 --> 00:13:21,230
!لا تسقط في البحر

104
00:13:21,230 --> 00:13:22,630
ماذا أفعل؟

105
00:13:22,630 --> 00:13:24,980
!لا يمكنني العودة

106
00:13:24,980 --> 00:13:28,450
!اتجه غربًا فحسب! سنلتقي هناك

107
00:13:29,280 --> 00:13:33,080
.لا أظنني أستطيع الوصول إلى هناك من هنا

108
00:13:33,470 --> 00:13:35,690
!سيكون لي حظّ أوفر إن عدت

109
00:13:35,690 --> 00:13:38,210
!سألحق بكم بسرعة، لذا انتظروني

110
00:13:38,600 --> 00:13:40,360
!احترس يا شيرايشي

111
00:13:40,360 --> 00:13:42,460
!لن تنجو إن سقطت وأنت بمفردك

112
00:13:42,710 --> 00:13:47,160
!هل فهمت؟ إيّاك أن تسقط! لا تسقط

113
00:13:52,250 --> 00:13:56,100
!ليس من السهل عبور هذه الأرضية الوعرة بزلاجة

114
00:13:56,100 --> 00:13:58,330
.كما أنّ الطقس يسوء أيضًا

115
00:13:58,330 --> 00:14:00,190
.قد يكون من الخطير اللحاق بهم

116
00:14:00,190 --> 00:14:02,500
!رأيت ذلك الانفجار

117
00:14:02,500 --> 00:14:04,500
!إنّهم قريبون

118
00:14:08,200 --> 00:14:10,390
!ريو منفعل للغاية أيضًا

119
00:14:12,390 --> 00:14:13,550
!يمكننا إيجادهم إن ذهبنا الآن

120
00:14:13,550 --> 00:14:15,530
!انتظر يا سوغيموتو

121
00:14:18,570 --> 00:14:20,290
.انظري يا أسيربا

122
00:14:24,920 --> 00:14:26,030
.ذئاب

123
00:14:26,650 --> 00:14:28,150
هل ستأتي إلى هنا؟

124
00:14:28,150 --> 00:14:29,130
.أشكّ في ذلك

125
00:14:29,800 --> 00:14:32,670
هل هي من كانت تلاحق حيوان الرنة ذاك؟

126
00:14:45,130 --> 00:14:47,780
.الذئاب جميلة

127
00:14:48,470 --> 00:14:51,210
.تعيش حياة قوية ولا تضيع شيئًا

128
00:14:51,210 --> 00:14:53,120
.وهذا ما يجعلها جميلة

129
00:14:54,160 --> 00:14:57,290
.الجمال والقوة هما نفس الشيء

130
00:15:05,330 --> 00:15:11,050
.في إحدى الليالي، كانت الشرطة السرية تلاحقنا، فهربنا إلى الغابة

131
00:15:12,200 --> 00:15:15,970
.كان أحد رفاقنا مصابًا إصابة بليغة ولم نتمكن من التحرك

132
00:15:18,280 --> 00:15:21,000
،أُغميَ عليه

133
00:15:21,000 --> 00:15:23,440
.وأوقفنا عن الحركة

134
00:15:27,560 --> 00:15:32,040
...عندما بدأ ملاحقونا يقتربون وهدد أنينه بإنذارهم

135
00:15:40,970 --> 00:15:45,060
،لم يكن سينجو في كل الأحوال

136
00:15:45,610 --> 00:15:49,400
.وبالكاد فررنا منهم

137
00:15:50,670 --> 00:15:52,210
،لو كنت مكانه

138
00:15:52,210 --> 00:15:57,690
.لترددت قبل أن أتّخذ نفس القرار على الأرجح

139
00:15:59,740 --> 00:16:04,570
لكنّ ويلك كان شخصًا يمكنه التوصل
.لذلك الجواب في أقل وقت ممكن

140
00:16:09,190 --> 00:16:12,720
.كنت أثق به من أعماق قلبي

141
00:16:13,390 --> 00:16:14,730
.وأحببته

142
00:16:20,070 --> 00:16:21,740
هل سنطلق على الدّيسم أيضًا؟

143
00:16:22,690 --> 00:16:24,660
ألا يمكننا إعادته إلى الكوتان؟

144
00:16:26,380 --> 00:16:29,380
.إنّه أكبر من أن نربيه

145
00:16:30,470 --> 00:16:32,850
هل تظنّين أن في ذلك قسوة يا أسيربا؟

146
00:16:35,050 --> 00:16:37,690
،تلك الأم وطفلها سيصبحان دمًا ولحمًا

147
00:16:37,690 --> 00:16:40,130
.ويعيلان حياتنا

148
00:16:40,810 --> 00:16:43,020
.حتّى الديسم مصدر ثمين للطعام

149
00:16:43,460 --> 00:16:47,270
.سنجوع إن ترددنا فقط لأن في الأمر قسوة

150
00:16:48,360 --> 00:16:52,240
.الشفقة واللطف الخاطئان يمكن أن يصبحا ضعفًا

151
00:16:54,680 --> 00:16:57,420
.الضعيف يخسر ويُؤكل

152
00:17:07,390 --> 00:17:09,870
مصدر اسم ويلك؟

153
00:17:09,870 --> 00:17:12,120
.لا أعلم

154
00:17:13,640 --> 00:17:15,480
هل تعرفين يا أسيربا؟

155
00:17:17,010 --> 00:17:20,190
.أظنّه أخبرني ذات مرة

156
00:17:21,330 --> 00:17:22,600
ماذا قال؟

157
00:17:26,430 --> 00:17:31,000
.هناك شيء مهم حدث وجعله ما كان عليه

158
00:17:32,220 --> 00:17:35,740
،قبل أن يصبح اسمه ويلك

159
00:17:36,460 --> 00:17:40,330
.وجد ذئبًا واهنًا بالقرب من الكوتان

160
00:17:42,850 --> 00:17:46,870
.ذهب لرؤيته كلّ يوم

161
00:17:50,500 --> 00:17:54,790
.وفي النهاية، بدأ الذئب بالعواء

162
00:17:58,140 --> 00:18:00,520
.وأجابه عواء آخر

163
00:18:02,230 --> 00:18:05,140
،فهم ويلك أنّه أراد العودة إلى زمرته

164
00:18:05,810 --> 00:18:11,400
.وأنّه أصبح ذئبًا وحيدًا لأنّه مريض أو لديه علّة ما

165
00:18:13,590 --> 00:18:16,780
.أتت الزمرة من أجله

166
00:18:18,910 --> 00:18:22,150
.لكنّ تلك الزمرة قتلته

167
00:18:24,200 --> 00:18:28,100
.قرّرَت أنّ لا مكان له في الزمرة

168
00:18:29,320 --> 00:18:33,950
.إن أبطأها ذئب واحد، فسيهدد الزمرة بأكملها

169
00:18:37,010 --> 00:18:38,890
.الذّئاب منطقية وحكيمة

170
00:18:39,460 --> 00:18:44,760
.تمّ التخلص من أيّ لطف زائد بها كي تضمن بقاءها

171
00:18:46,330 --> 00:18:49,350
.جمال فعّال من دون أيّ تبذير

172
00:18:49,350 --> 00:18:52,040
.هذا ما شعر به من طريق عيش الذئاب

173
00:18:57,680 --> 00:18:59,970
.أراد أن يكون مخلوقًا مثلها

174
00:18:59,970 --> 00:19:04,050
.لذا سلخ فروه عن جثته وركض مرتديًا إيّاه

175
00:19:05,880 --> 00:19:09,200
،نظر والده البولندي

176
00:19:10,140 --> 00:19:12,710
.وقرر اسمه حينها

177
00:19:14,720 --> 00:19:15,990
.ويلك

178
00:19:17,530 --> 00:19:21,680
.ويلك تعني الذئب في اللغة البولندية

179
00:19:33,150 --> 00:19:35,260
.أخبرني عن أمي

180
00:19:35,830 --> 00:19:37,020
مجدّدًا؟

181
00:19:37,660 --> 00:19:41,160
.كانت امرأة جميلة مثلك

182
00:19:42,220 --> 00:19:43,960
.التقينا في أوتارو

183
00:19:44,690 --> 00:19:48,040
.علّمتني كلّ الأشياء التي لم أعرفها

184
00:19:49,900 --> 00:19:53,970
.لغة هوكّايدو أينو ومعتقداتهم

185
00:19:56,100 --> 00:19:59,750
.لا تنسي أبدًا ما سأقوله لك

186
00:20:01,500 --> 00:20:08,660
...أخبرت أمكّ ذات مرّة عن كيفية حصولي على الاسم ويلك

187
00:20:09,350 --> 00:20:13,950
.وبعدها أعطتني اسمًا بالأينو

188
00:20:16,550 --> 00:20:18,670
.هوروكِّوُو أوشيكوني

189
00:20:20,050 --> 00:20:21,940
هوروكِّوُو أوشيكوني؟

190
00:20:24,160 --> 00:20:26,830
.تعني اللحاق بالذئب

191
00:20:29,100 --> 00:20:31,240
.لأني أردت أن أكون ذئبًا

192
00:20:32,660 --> 00:20:38,260
.الوحيدان اللذان يعرفان هذا الاسم هما أنا وأمّك التي سمّتني به

193
00:20:39,440 --> 00:20:41,560
.عليك ألّا تخبري أحدًا

194
00:20:50,730 --> 00:20:52,000
.سوغيموتو

195
00:20:52,000 --> 00:20:53,520
كيف تقرأ هذا؟

196
00:20:53,850 --> 00:20:54,940
".أو"

197
00:20:54,940 --> 00:20:56,680
."مثل التي في "أوكاي

