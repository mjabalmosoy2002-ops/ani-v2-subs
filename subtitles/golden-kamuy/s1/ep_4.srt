1
00:00:03,150 --> 00:00:05,940
.هذا فخّ لاصطياد أسماك النهر يدعى راوماب

2
00:00:06,850 --> 00:00:08,400
!يا لعددها

3
00:00:08,810 --> 00:00:10,570
.إنّها أسماك الإسقلبين

4
00:00:10,570 --> 00:00:13,800
سمك الإسقلبين في هذه الوقت
.من السنة يكون دسمًا ولذيذًا

5
00:00:13,800 --> 00:00:16,650
،سأنظّف الأسماك التي سنستعملها في الحساء هنا

6
00:00:16,650 --> 00:00:18,410
.لذا ساعدني

7
00:00:18,410 --> 00:00:19,230
...لا

8
00:00:19,900 --> 00:00:22,500
.لقد نسيت سكيني وحربتي

9
00:00:23,780 --> 00:00:27,080
.لن يكون الإسقلبين لذيذًا إن لم نستخرج أحشاءه بسرعة

10
00:00:27,080 --> 00:00:29,490
!اذهب وأحضرهما بسرعة أيّها الغبي

11
00:00:29,490 --> 00:00:31,090
!أنت لئيمة

12
00:00:33,630 --> 00:00:35,800
...سيكون من الأسرع أن أذهب من هنا

13
00:00:37,010 --> 00:00:38,110
.توقف

14
00:00:38,580 --> 00:00:39,760
.لا تتحرك

15
00:00:40,890 --> 00:00:42,220
هل تريد شيئًا؟

16
00:00:42,220 --> 00:00:44,390
.لا تلمس الخيط الذي بقرب قدميك

17
00:00:47,530 --> 00:00:50,570
.إنه فخّ يدعى أمابو

18
00:00:50,570 --> 00:00:53,340
.سيطلق سهمًا مسمومًا إن لمست الخيط

19
00:00:53,340 --> 00:00:54,490
.شكرًا لك

20
00:00:54,490 --> 00:00:55,570
.لقد أنقذتني

21
00:00:56,010 --> 00:00:57,910
...أنت والد

22
00:00:58,410 --> 00:01:00,130
.أوساما-تشان

23
00:01:00,130 --> 00:01:03,250
.أسيربا ابنة أختي الكبيرة

24
00:01:04,610 --> 00:01:06,920
.أسيربا ذكية

25
00:01:06,920 --> 00:01:11,020
.إن كنت تروق لها، فلا بد أنّك شخص طيّب

26
00:01:11,550 --> 00:01:12,760
.أعتذر عن تصرفي قبل قليل

27
00:01:13,160 --> 00:01:16,670
.ظننت أنّ هناك من لا أروق له لأنّي ياباني

28
00:01:16,670 --> 00:01:23,930
أخبرتك أسيربا أنّ القرويين كانوا
يجمعون الذهب لقتال السيسام، صحيح؟

29
00:01:23,930 --> 00:01:27,850
.وأنّه سُرق وقُتِل أتشا أسيربا والبقية

30
00:01:28,160 --> 00:01:29,330
أتشا؟

31
00:01:29,330 --> 00:01:32,070
.تعني أب بلغة الأينو

32
00:01:32,900 --> 00:01:36,410
.وجد أسلافنا ذلك الذهب

33
00:01:36,990 --> 00:01:41,710
.وأخذه بعض الرجال لشراء الأسلحة

34
00:01:41,710 --> 00:01:44,580
هل تعرف هوية من سرق سبائك الذهب؟

35
00:01:44,580 --> 00:01:45,750
.لا

36
00:01:46,490 --> 00:01:51,250
يقول الجميع أنّ ذلك كان غضب
.واشا أوش كاموي، إلهة الماء

37
00:01:52,260 --> 00:01:56,150
.لا يغسل الأينو ملابسهم في الأنهار أو يتبرزون فيها

38
00:01:56,150 --> 00:01:59,020
،يصلون إلى ذلك الحدّ لتجنب تدنيس الأنهار

39
00:01:59,020 --> 00:02:00,980
...ومع ذلك حاولنا التصويل عن الذهب هناك

40
00:02:02,460 --> 00:02:07,690
.تدنيس الأنهار لشن حرب ما كفر بالنسبة للأينو

41
00:02:08,330 --> 00:02:14,540
.ذلك الذهب ملعون. تتلبسه الشياطين

42
00:03:46,150 --> 00:03:49,020
.انظري إلى هذا أيتها الجدّة

43
00:03:49,020 --> 00:03:51,190
!اصطدنا كلّ هذا الإسقلبين

44
00:03:52,740 --> 00:03:54,550
.هينّا، هينّا

45
00:03:58,430 --> 00:03:59,890
ما الذي تفعله؟

46
00:04:00,330 --> 00:04:02,970
.تقدّمها إلى روحها الحارسة

47
00:04:02,970 --> 00:04:06,550
.إن أعطاك أحد شيئًا ما، قدّمه إلى روحك الحارسة

48
00:04:07,010 --> 00:04:10,570
.تخرج روحك الحارسة وتدخل من رقبتك

49
00:04:11,010 --> 00:04:17,310
.تدعى تورينبي، ويحصل الجميع على واحدة عندما يولدون

50
00:04:18,130 --> 00:04:22,700
.يقال أنّ ذلك هو سبب اختلاف شخصيات وقدرات الناس

51
00:04:22,700 --> 00:04:25,380
.يمكن لبعض الناس رؤيتها

52
00:04:25,380 --> 00:04:26,910
.يمكن لهوتشي رؤيتها بعض الشيء

53
00:04:27,420 --> 00:04:30,660
.تقول أنّك تملك تورينبي قوية جدًّا

54
00:04:32,690 --> 00:04:37,000
.إذًا ربّما يقول الناس أنّي خالد بفضل روحي الحارسة

55
00:04:37,310 --> 00:04:41,030
.لكني لم أرك تفعلين ذلك من قبل

56
00:04:41,780 --> 00:04:44,360
.فقط العجزة يقومون بذلك في هذه القرية

57
00:04:44,360 --> 00:04:46,720
...يا للأطفال هذه الأيام

58
00:04:47,950 --> 00:04:48,800
.إنّه جاهز

59
00:04:48,800 --> 00:04:50,220
.أعددت الحساء من الإسقلبين

60
00:04:50,220 --> 00:04:51,350
.إنّه كيناوهاو

61
00:04:51,350 --> 00:04:52,890
!يبدو لذيذًا

62
00:04:52,890 --> 00:04:53,970
!فلنأكل

63
00:05:02,310 --> 00:05:03,440
.فلنأكل

64
00:05:06,830 --> 00:05:08,200
!إنّه لذيذ

65
00:05:08,200 --> 00:05:11,410
.له حساء غني ولذيذ

66
00:05:11,410 --> 00:05:15,160
متى كانت آخر مرة تناولت فيها هذا
الكم من الخضار الجذرية في آن واحد؟

67
00:05:16,850 --> 00:05:19,170
...حساء الإسقلبين لذيذ

68
00:05:21,050 --> 00:05:24,970
،إنّه لذيذ حقًّا يا أسيربا-سان

69
00:05:24,970 --> 00:05:27,850
!لكن إن أضفنا الميسو إليه، فأراهن أنّه سيكون ألذ بكثير

70
00:05:27,850 --> 00:05:29,560
.اخرس يا سوغيموتو

71
00:05:29,560 --> 00:05:30,680
.أبعد البراز

72
00:05:31,080 --> 00:05:32,940
.تفضّلي أيّتها الجدّة

73
00:05:32,940 --> 00:05:34,890
.إنّه ميسو

74
00:05:34,110 --> 00:05:36,530
!توقّف

75
00:05:36,530 --> 00:05:42,230
.أنت تجعلها تقدّم البراز إلى روحها الحارسة

76
00:05:42,230 --> 00:05:43,650
.إنّه ليس برازًا

77
00:05:43,650 --> 00:05:45,610
مهلًا! ما هذا؟

78
00:05:45,610 --> 00:05:46,910
.سوتو

79
00:05:46,910 --> 00:05:49,910
.عصا تُستعلم لإلحاق الألم بالخبُث

80
00:05:49,910 --> 00:05:51,280
!سوغيموتو

81
00:05:51,280 --> 00:05:54,530
!مـ-مهلًا! توقّفي

82
00:06:06,750 --> 00:06:09,060
هل زاد وزنك قليلًا خلال الأيّام الماضية؟

83
00:06:09,510 --> 00:06:10,720
أتذكر ما قلته لك؟

84
00:06:10,720 --> 00:06:12,650
.تنمو الدّببة بسرعة

85
00:06:12,650 --> 00:06:13,890
.أسيربا

86
00:06:14,990 --> 00:06:16,170
.قومي بهذا

87
00:06:16,170 --> 00:06:18,480
.أنت الأكثر إخافة

88
00:06:18,480 --> 00:06:19,440
.حسنًا

89
00:06:19,440 --> 00:06:21,270
ما هذا؟

90
00:06:21,270 --> 00:06:24,150
.يدعى كيساراري، معناه الوحش ذو الآذان الطويلة

91
00:06:24,460 --> 00:06:31,120
نلوح به أمام نافذة ما ونحن نصدر
.أصواتًا مفزعة لإخافة الأطفال

92
00:06:31,500 --> 00:06:33,850
.جرب الأمر يا سوغيموتو

93
00:06:33,850 --> 00:06:34,780
أنا؟

94
00:06:48,010 --> 00:06:49,130
!توقف، توقف

95
00:06:49,130 --> 00:06:50,240
.توقف عن ذلك يا سوغيموتو

96
00:06:50,240 --> 00:06:51,150
.أنت تحرجني

97
00:06:51,900 --> 00:06:52,830
.أعطنيه

98
00:06:52,830 --> 00:06:54,410
.سأريك كيفية القيام بالأمر

99
00:07:02,860 --> 00:07:05,800
...أسيربا هي حقًّا الأكثر إخافة

100
00:07:05,800 --> 00:07:07,610
.تبولت أوسوما في سروالها

101
00:07:08,380 --> 00:07:11,570
.أسيربا-سان، أعطيني فرصة لاسترجاع شرفي

102
00:07:12,330 --> 00:07:13,330
.حسنًا

103
00:07:13,780 --> 00:07:15,450
.أرني ما يمكنك فعله حقًّا

104
00:07:26,010 --> 00:07:27,250
!أحسنت يا أوسوما

105
00:07:27,250 --> 00:07:28,630
!يمكنك أن تصبحي صيّادة رائعة

106
00:07:51,300 --> 00:07:53,740
هل تسمع يا سوغيموتو-سان؟

107
00:07:54,210 --> 00:07:55,990
.هذا صوت سماعه أمر نادر

108
00:07:57,130 --> 00:08:00,970
.عواء أخفت من عواء الكلب وأطول منه

109
00:08:00,970 --> 00:08:02,220
.إنّه ذئب

110
00:08:03,310 --> 00:08:07,610
.رأيت ذئبًا أبيضًا ينقذ أسيربا-سان مرّتين

111
00:08:08,290 --> 00:08:09,670
ما هي قصته؟

112
00:08:09,670 --> 00:08:11,300
.فهمت

113
00:08:11,300 --> 00:08:14,640
هذا العواء لريتار إذًا؟

114
00:08:16,100 --> 00:08:22,520
.وجدت أسيربا ووالدها ذلك الذئب عندما كانا يذهبان للصيد

115
00:08:23,000 --> 00:08:25,530
،بدا كرجل ثلج صغير

116
00:08:25,530 --> 00:08:28,540
.لذا سمياه ريتار التي تعني أبيض

117
00:08:29,470 --> 00:08:31,340
.كانا معًا دائمًا

118
00:08:31,340 --> 00:08:33,480
،حتّى بعد أن قُتل والدها

119
00:08:33,480 --> 00:08:37,240
.كانت أسيربا تذهب إلى الجبال مع ريتار بمفردها

120
00:08:37,630 --> 00:08:42,200
.لكنهما عاشا في عالمين مختلفين

121
00:08:45,390 --> 00:08:46,650
...عواء

122
00:08:51,190 --> 00:08:52,510
هل هذا...؟

123
00:08:53,050 --> 00:08:55,140
!لا! لا تصغ

124
00:09:01,380 --> 00:09:02,540
!لا، انتظر

125
00:09:02,540 --> 00:09:04,070
!عد إلى عريشك

126
00:09:05,230 --> 00:09:06,440
!ريتار

127
00:09:08,370 --> 00:09:12,990
.لم يستطع أن يكون كلبًا أليفًا

128
00:09:15,690 --> 00:09:17,030
...ريتار

129
00:09:19,300 --> 00:09:23,110
.لأنّه كان هوركيو كاموي فخورًا

130
00:09:25,610 --> 00:09:27,250
!لا تذهب يا ريتار

131
00:09:27,660 --> 00:09:29,670
!عد يا ريتار

132
00:09:29,670 --> 00:09:32,710
هل ستتركني أنت أيضًا؟

133
00:09:37,670 --> 00:09:39,860
...لا تذهب يا ريتار

134
00:09:41,610 --> 00:09:42,930
!أتشا

135
00:09:44,180 --> 00:09:50,150
.قد تبدو ناضجة، لكنّ أسيربا فتاة وحيدة

136
00:09:51,340 --> 00:09:54,980
.توقفت عن الابتسام بعد ذلك

137
00:09:55,470 --> 00:09:57,950
.لكنّها أسعد بكثير مؤخّرًا

138
00:09:58,620 --> 00:10:01,940
.على الأرجح أنّها تحبّ التواجد في الجبال معك

139
00:10:22,140 --> 00:10:23,890
.فهمت أيّتها الجدّة

140
00:10:24,780 --> 00:10:28,250
أنت تحبينها حقًّا، أليس كذلك؟

141
00:10:29,190 --> 00:10:30,660
.وكذلك باقي سكّان القرية

142
00:10:58,850 --> 00:10:59,930
.الوداع

143
00:11:12,770 --> 00:11:14,480
!لن أسامح سوغيموتو أبدًا

144
00:11:15,050 --> 00:11:16,730
...غادر دون إخباري

145
00:11:16,730 --> 00:11:19,940
.عليّ أن أضربه على رقبته بسوتو وإلّا لن أشعر بالرضى

146
00:11:22,540 --> 00:11:24,430
.لا يوجد ما يدل على أنّه استُخدم

147
00:11:25,330 --> 00:11:27,580
هل ذهب إلى البلدة ولم يعد؟

148
00:11:29,310 --> 00:11:30,780
.لديّ شعور سيّئ

149
00:11:32,210 --> 00:11:36,810
لكن سيكون من الصعب
.إيجاده في تلك البلدة الضخمة

150
00:11:37,460 --> 00:11:38,550
ماذا أفعل؟

151
00:11:42,750 --> 00:11:45,680
،إن عزفت مزمار الأيل في طريق للأيل

152
00:11:45,680 --> 00:11:48,860
.فقد يظنّ أنّ هناك أيل ويأتي لاصطياده

153
00:11:52,850 --> 00:11:54,570
.أنت أيّها الضّخم

154
00:11:56,090 --> 00:11:57,840
أهذا أنت؟

155
00:11:57,840 --> 00:12:00,190
هل حدث أيّ شيء غريب مؤخّرًا؟

156
00:12:01,690 --> 00:12:02,950
.أجل

157
00:12:02,950 --> 00:12:05,140
تعرّضت فتاة يعمل في محل يملكه صديق لي

158
00:12:05,140 --> 00:12:06,950
.للأذى بشكل سيّئ من قبل زبون ما

159
00:12:08,100 --> 00:12:10,380
ما الغريب في ذلك؟

160
00:12:10,380 --> 00:12:16,330
...كان ذلك الزبون يملك أوشامًا غريبة

161
00:12:18,930 --> 00:12:21,760
.سأحضر تلك الفتاة الآن

162
00:12:21,760 --> 00:12:24,470
.تناول سوبا الزنجة هذا وانتظر

163
00:12:24,470 --> 00:12:27,120
!السوبا لدينا لذيذة أيضًا

164
00:12:29,480 --> 00:12:30,930
.فلنأكل

165
00:12:37,170 --> 00:12:38,850
.الحساء دسم

166
00:12:38,850 --> 00:12:41,150
.ولدت في كانتو، لذا أحبّه هكذا

167
00:12:41,580 --> 00:12:45,110
...وحلاوة الزنجة وهي تذوب في الفم

168
00:12:45,440 --> 00:12:48,260
.كما قالت تمامًا، إنّه لذيذ

169
00:12:51,450 --> 00:12:53,670
.هذا هينّا

170
00:12:54,870 --> 00:12:58,930
من هو الرجل الذي يسأل عن الأوشام؟

171
00:12:58,930 --> 00:13:00,380
.الذي يرتدي قبعة الجيش

172
00:13:08,300 --> 00:13:09,720
!لا تتحرك

173
00:13:11,320 --> 00:13:12,980
.على ركبتيك

174
00:13:12,980 --> 00:13:18,190
قد تصيب الرصاصة أحدًا ما بعد
.أن تخرج من وجهك إن أطلقت

175
00:13:24,070 --> 00:13:25,280
.تراجع

176
00:13:25,280 --> 00:13:26,790
.لنقتله

177
00:13:31,440 --> 00:13:33,290
.يكفي

178
00:13:34,210 --> 00:13:35,620
.لا تقتلوه بعد

179
00:13:38,580 --> 00:13:41,890
.أنا حاصد روحك

180
00:13:41,890 --> 00:13:46,830
.يمكنني أن أطفئ شمعة حياتك في أيّ وقت

181
00:13:50,180 --> 00:13:55,020
.استأجرني زبون للمومس التي تأذّت

182
00:13:55,020 --> 00:13:59,100
قال لي أن أجد الرجل الذي يملك
.الأوشام الغريبة وأجعله يدفع الثمن

183
00:13:59,420 --> 00:14:04,220
حاولت أن أسأل عنه فوجدت
.نفسي محاطًا فجأة برجال مسلحين

184
00:14:04,220 --> 00:14:07,460
بالطبع سأهرب، أليس كذلك؟

185
00:14:09,060 --> 00:14:10,350
...هذا ليس جيّدًا

186
00:14:10,350 --> 00:14:13,030
.عليّ أن أجد طريقة للخروج من هنا

187
00:14:13,390 --> 00:14:15,220
هل تحب الحلوى؟

188
00:14:16,360 --> 00:14:20,460
.إنّها كوشي دانغو، من منتزه حديقة الأزهار في أوتارو

189
00:14:24,430 --> 00:14:25,580
.إنّها لذيذة

190
00:14:25,580 --> 00:14:27,570
مضى وقت طويل لم آكل فيه شيئًا حولًا

191
00:14:27,570 --> 00:14:29,750
.لدرجة أنّي أشعر أن غدد لعابي ستنفجر

192
00:14:33,010 --> 00:14:35,830
...خالد، خالد

193
00:14:35,830 --> 00:14:39,090
.عُثر على أحد رجالي شبه ميت عند ضفة النهر

194
00:14:39,090 --> 00:14:41,650
.كتب شيئًا ما بأصابعه

195
00:14:43,430 --> 00:14:44,580
.شكرًا على الطعام

196
00:14:45,110 --> 00:14:46,360
هل المخرج من هناك؟

197
00:14:47,240 --> 00:14:51,110
أنت من فعل ذلك بالجندي أوغاتا، صحيح؟

198
00:14:52,600 --> 00:14:55,330
...يا سوغيموتو الخالد

199
00:14:57,290 --> 00:14:58,390
.اجلس

200
00:15:00,070 --> 00:15:02,090
.أنتما تشبهان بعضكما تمامًا

201
00:15:02,090 --> 00:15:04,460
من منكما ضربني بالبندقية؟

202
00:15:04,460 --> 00:15:05,990
،عليك وضع علامة في مكان ما

203
00:15:05,990 --> 00:15:07,640
.على الجبين أو مكان آخر بارز

204
00:15:07,640 --> 00:15:09,260
.سأقتلك

205
00:15:10,530 --> 00:15:12,010
.لقد أمسكتم الرجل الخاطئ

206
00:15:12,010 --> 00:15:14,720
.اسمي ليس سوغيموتو

207
00:15:15,120 --> 00:15:19,730
.رأيت سوغيموتو مرة واحدة في ميناء آرثر

208
00:15:19,730 --> 00:15:21,810
،من بعيد جدًّا

209
00:15:21,810 --> 00:15:26,520
...شعرت بالرهبة من طريقة قتاله التي تشبه الشياطين

210
00:15:26,520 --> 00:15:29,760
.أنت من رأيته

211
00:15:29,760 --> 00:15:33,280
.عندما رأيت طريقة قتالك عند محل السوبا تأكّدت

212
00:15:33,280 --> 00:15:35,810
.كنت في القسم الثاني

213
00:15:35,810 --> 00:15:37,710
.لم أكن في ميناء آرثر

214
00:15:37,710 --> 00:15:39,660
.يبدو أنّكم أمسكتم الرجل الخاطئ بالفعل

215
00:15:40,930 --> 00:15:46,040
لمَ هاجم الجندي أوغاتا سوغيموتو الخالد؟

216
00:15:47,230 --> 00:15:52,690
السبب هو امتلاكك لإحدى الأوشام
.التي تشير إلى مكان الذهب

217
00:15:52,690 --> 00:15:58,520
وحاولت الهرب منّا لأنّك كنت
.خائفًا من أن نكتشف ذلك

218
00:15:59,310 --> 00:16:01,910
لديك أحد الجلود الموشومة، صحيح؟

219
00:16:02,470 --> 00:16:04,100
أين خبّأته؟

220
00:16:04,100 --> 00:16:05,340
ذهب؟

221
00:16:05,340 --> 00:16:06,230
أوشام؟

222
00:16:06,230 --> 00:16:08,540
.لا فكرة لديّ عمّ تتحدّث

223
00:16:08,540 --> 00:16:11,570
هل رئيسكم عاقل؟

224
00:16:11,570 --> 00:16:15,030
.فجّرت قذيفة القليل من دماغي

225
00:16:29,290 --> 00:16:31,230
.أنت رجل مذهل

226
00:16:31,230 --> 00:16:33,300
.لم تطرف ولو مرّة

227
00:16:33,300 --> 00:16:37,010
.أنت حقًّا سوغيموتو الخالد

228
00:16:37,550 --> 00:16:42,830
...لكن إن كنت خالدًا ولا يمكنني أن أطفئ شمعة حياتك

229
00:16:42,830 --> 00:16:47,470
!سأمضغ الشمعة من الأعلى إلى الأسفل فحسب

230
00:16:54,550 --> 00:16:56,920
.هذا أحد جوربي سوغيموتو

231
00:16:56,920 --> 00:16:58,530
.لقد نسيه

232
00:17:01,900 --> 00:17:04,750
.أنت تلفت الأنظار يا ريتار، لذا لننتظر حلول الليّل

233
00:17:05,500 --> 00:17:09,250
.هناك طريقة واحدة فقط للنجاة من هذا الوضع

234
00:17:09,730 --> 00:17:12,010
.اعمل لديّ

235
00:17:12,550 --> 00:17:15,880
.فقدت الكثير من الرّجال في ساحة المعركة

236
00:17:16,620 --> 00:17:18,310
.أحتاج المزيد منهم

237
00:17:18,310 --> 00:17:24,310
أملك أقل من مئة رجل بقليل
.يبحثون عبر هوكايدو بأكملها

238
00:17:24,770 --> 00:17:28,860
هذا عدد كبير تشارك الذهب معه، أليس كذلك؟

239
00:17:29,350 --> 00:17:31,760
.سيكون الذهب تمويلًا للحرب

240
00:17:31,760 --> 00:17:35,820
لن تدوم الأسلحة والذخيرة التي
.سرقناها من أساهيكاوا إلى الأبد

241
00:17:36,640 --> 00:17:39,320
ما الذي تنوون فعله؟

242
00:17:39,320 --> 00:17:42,330
.شراء الأسلحة من رجل أمريكي

243
00:17:42,690 --> 00:17:45,640
.آخر الأسلحة، جُمعت من جميع أنحاء العالم

244
00:17:45,640 --> 00:17:49,260
.سأبدأ بالاستيلاء على القسم السابع

245
00:17:49,260 --> 00:17:54,910
ثم سأستحوذ على الموانئ الرئيسية
.التي تتحكم في مسار البضائع إلى اليابسة

246
00:17:54,910 --> 00:17:56,720
.ستصبح هوكّايدو ملكًا لنا

247
00:17:57,170 --> 00:17:59,870
،كنّا أبطالاً في ساحة المعركة

248
00:17:59,870 --> 00:18:02,780
.لكن عندما عدنا إلى الديار، أصبحنا مشرّدين

249
00:18:02,780 --> 00:18:04,630
هل ربحت شيئًا من القتال؟

250
00:18:04,630 --> 00:18:07,690
أم أنّك خسرت ما هو أكثر بكثير؟

251
00:18:08,390 --> 00:18:12,520
.أريد جنديًّا شجاعًا مثلك

252
00:18:12,520 --> 00:18:14,570
.قاتل معنا

253
00:18:17,130 --> 00:18:18,720
.هذه مضيعة وقت

254
00:18:19,760 --> 00:18:22,910
.ربما سأعضّ تلك الشمعة إذًا

255
00:18:29,160 --> 00:18:30,630
هل هو في الداخل؟

256
00:18:33,360 --> 00:18:34,800
.حسنًا، اذهب

257
00:18:41,770 --> 00:18:43,800
!وحش

258
00:18:47,120 --> 00:18:47,680
ماذا؟

259
00:18:48,110 --> 00:18:49,470
.أنت لست سوغيموتو

260
00:18:49,470 --> 00:18:51,390
...أنت

261
00:18:51,390 --> 00:18:52,900
.ملك الانصراف

262
00:18:52,900 --> 00:18:55,470
!شيرايشي يوشيتاكي، ملك الهرب

263
00:18:56,490 --> 00:18:59,780
مهلًا، ألست فتاة الأينو التي التقيتها سابقًا؟

264
00:19:01,130 --> 00:19:02,030
.لا تأكله

265
00:19:02,770 --> 00:19:05,280
.ما كان ريتار ليخطئ في رائحة ما

266
00:19:05,770 --> 00:19:07,090
أين سوغيموتو؟

267
00:19:07,090 --> 00:19:08,400
!ليس معي

268
00:19:08,400 --> 00:19:09,710
!أنا بمفردي

269
00:19:09,710 --> 00:19:11,040
.هذا غريب

270
00:19:11,040 --> 00:19:13,590
...لقد تتبعت رائحة جوربه

271
00:19:14,090 --> 00:19:16,370
لمَ قادتني إلى هنا؟

272
00:19:16,370 --> 00:19:17,550
جورب؟

273
00:19:18,470 --> 00:19:19,920
هل حدث الأمر حينها...؟

274
00:19:20,720 --> 00:19:21,960
!لا شكّ

275
00:19:21,960 --> 00:19:23,890
!تبادلنا الجوارب حينها

276
00:19:25,520 --> 00:19:26,720
.مقزّز

277
00:19:27,040 --> 00:19:31,030
ماذا حدث؟ هل خانك سوغيموتو؟

278
00:19:31,030 --> 00:19:33,150
هرب بالجلود، صحيح؟

279
00:19:33,150 --> 00:19:34,170
.اخرس

280
00:19:34,170 --> 00:19:36,760
.فهمت، هذا يشرح الأمر

281
00:19:36,760 --> 00:19:40,050
.كانت الإشاعة عن سوغيموتو إذًا

282
00:19:40,050 --> 00:19:41,440
إشاعة؟

283
00:19:41,440 --> 00:19:42,410
أيّ إشاعة؟

284
00:19:42,720 --> 00:19:47,110
تورّط بالأمس رجل بندبة كبيرة
على وجهه في قتال ضخم قبل أن يؤخذ

285
00:19:47,110 --> 00:19:50,010
.إلى مقر القسم السابع

286
00:19:51,130 --> 00:19:54,830
.إنّه ميت على الأرجح

287
00:19:55,210 --> 00:19:56,830
.خذني إلى هناك

288
00:19:56,830 --> 00:19:59,300
،يمكن لهذا السهم المسموم قتل دبّ في عشر خطوات

289
00:20:00,510 --> 00:20:02,510
.لكنّك ستموت قبل أن تخطوَ خطوة واحدة

290
00:20:04,470 --> 00:20:06,510
!فهمت! فهمت

291
00:20:06,510 --> 00:20:07,940
!لذا لا تشيري إليّ بذلك الشيء

292
00:20:07,940 --> 00:20:10,180
...فتاة مخيفة

293
00:20:10,490 --> 00:20:13,650
.انتظري. سأغسل وجهي كي أستيقظ

294
00:20:15,080 --> 00:20:17,160
.كان إحساسي السيّئ صائبًا

295
00:20:17,800 --> 00:20:18,960
...سوغيموتو

296
00:20:21,250 --> 00:20:22,070
ما الخطب؟

297
00:20:25,250 --> 00:20:26,280
.لقد هرب

298
00:20:39,330 --> 00:20:42,010
.يمكن لريتار الركض لليلة كاملة إن اضطر لذلك

299
00:20:42,450 --> 00:20:45,530
.يمكنك أن تختبئ في قعر مرحاض، ومع ذلك سيجدك

300
00:20:46,530 --> 00:20:48,720
.تابع الهرب يا ملك الهرب

301
00:20:49,690 --> 00:20:53,060
.لن تهرب من هوركيو كاموي أبدًا

302
00:21:01,110 --> 00:21:03,440
هل أنت حيّ يا وغد الكوشي دانغو؟

303
00:21:04,530 --> 00:21:07,410
هل هو سوغيموتو الخالد حقًّا؟

304
00:21:07,410 --> 00:21:10,300
لا تظنّ أننا أمسكنا بالرجل
الخاطئ، أليس كذلك يا يوهي؟

305
00:21:10,300 --> 00:21:13,990
،انتفخ وجهه ضعف حجمه بعد أن أبرحته ضربًا

306
00:21:13,990 --> 00:21:15,980
.لكن الانتفاخ اختفى الآن يا كوهي

307
00:21:16,470 --> 00:21:21,170
إن كان هو، فأراهن أنّ بإمكاننا
.استخراج أحشائه وسيشفى في الصباح

308
00:21:21,590 --> 00:21:25,380
.لن نتمكّن من معرفة مكان الأوشام إن قتلناه يا يوهي

309
00:21:25,380 --> 00:21:30,650
.لنكفّ عن تضييع الوقت ونقطع أصابعه إلى أن يخبرنا

310
00:21:31,170 --> 00:21:35,090
أنت من ضربني أمام محل السوبا، صحيح؟

311
00:21:36,170 --> 00:21:37,100
ماذا؟

312
00:21:37,410 --> 00:21:41,070
.سأضع علامة عليك كي يميّزكما الناس

313
00:21:42,530 --> 00:21:44,570
.اخرس أيّها الوغد

314
00:22:01,090 --> 00:22:05,010
!أنا سوغيموتو الخالد

315
00:23:36,370 --> 00:23:39,250
.الحلقة القادمة: ركض