1
00:00:15,280 --> 00:00:17,120
!شيرايشي! أسرع والتقط تلك البندقيّة

2
00:00:18,130 --> 00:00:19,830
.أعطها لي

3
00:00:22,750 --> 00:00:25,000
!أيّها الجرو الغبيّ

4
00:00:27,070 --> 00:00:30,290
!لا تحرّك ساكنًا يا نيهي تيتسوزو

5
00:00:30,290 --> 00:00:32,050
!ارم سلاحك أنت أيضًا

6
00:00:35,510 --> 00:00:37,140
...أيّها الوغد

7
00:00:37,140 --> 00:00:39,890
!لا تستعملها كرهينة

8
00:00:40,890 --> 00:00:42,180
!أفلتها

9
00:00:42,180 --> 00:00:42,890
!لا تقترب

10
00:00:44,490 --> 00:00:45,810
!هذا جُبن

11
00:00:45,810 --> 00:00:48,270
...كيف لك أن تستعمل فتاةً بريئة كرهينة

12
00:00:48,620 --> 00:00:49,740
.تلك كذبة

13
00:00:50,250 --> 00:00:53,170
.كانت تملك أحد الجلود الموشومة

14
00:00:53,170 --> 00:00:55,980
.لا تقل لي أنّها بريئة

15
00:00:55,980 --> 00:00:59,120
.أنا لا أعني لذلك الرجل الكثير

16
00:00:59,630 --> 00:01:01,080
.سيطلق النّار عليّ بعد أن تنقضي حاجته إليّ

17
00:01:01,430 --> 00:01:04,040
.لا يجدر بنا أن نتقاتل. بل علينا الانسحاب

18
00:01:04,040 --> 00:01:05,970
.لا تصدّقها

19
00:01:05,970 --> 00:01:09,000
.النساء مخيفات يا تانيغاكي

20
00:01:09,530 --> 00:01:11,210
!ارمِ سلاحك بسرعة

21
00:01:11,820 --> 00:01:14,720
!أنا مستعدّ للقتال بالبنادق وهي في المنتصف

22
00:01:16,660 --> 00:01:18,180
...شيرايشي

23
00:01:19,370 --> 00:01:20,510
.أنا آسف

24
00:01:21,360 --> 00:01:22,390
.ارمِ البندقيّة

25
00:01:25,900 --> 00:01:27,770
.لا تدعها ترى هذا

26
00:01:28,210 --> 00:01:30,480
.خذها إلى مكان بعيد

27
00:01:32,410 --> 00:01:33,730
.حسنًا

28
00:01:33,730 --> 00:01:36,530
.تانيغاكي، ارمِ لي شيئًا أقيّدهما به

29
00:01:51,210 --> 00:01:54,720
.خذها إلى مكان بعيد ما يكفي كي لا تسمع صراخهما

30
00:01:54,720 --> 00:01:55,420
!توقّف

31
00:01:55,420 --> 00:01:56,220
!لا تقتلهما

32
00:01:56,690 --> 00:01:58,080
!سوغيموتو

33
00:01:58,080 --> 00:01:59,960
!شيرايشي

34
00:01:59,960 --> 00:02:00,680
!أفلتني

35
00:02:02,540 --> 00:02:03,560
ماذا؟

36
00:02:04,940 --> 00:02:06,940
...ملك الهروب

37
00:02:06,940 --> 00:02:08,640
.نسيت ذلك

38
00:02:09,680 --> 00:02:12,270
ها قد هربنا، لكن ما العمل الآن؟

39
00:02:12,270 --> 00:02:13,790
!لا نملك أيّ سلاح

40
00:02:13,790 --> 00:02:15,050
،سوف نتسلّل

41
00:02:15,050 --> 00:02:16,750
،ونباغتهما

42
00:02:16,750 --> 00:02:18,990
!ونستعيد أسيربا-سان

43
00:03:51,710 --> 00:03:55,290
!تانيغاكي! لقد هربا

44
00:03:55,290 --> 00:03:56,280
!سوغيموتو

45
00:03:56,280 --> 00:03:57,130
.اهدئي

46
00:03:59,970 --> 00:04:01,750
.وضعي سيّئ في الغابة

47
00:04:01,750 --> 00:04:04,160
.عليّ الخروج إلى مكان تكون فيه الرؤية واضحة

48
00:04:27,790 --> 00:04:29,130
.ابقي هادئة

49
00:04:31,040 --> 00:04:32,610
!لا تذهب من هناك

50
00:04:32,610 --> 00:04:33,460
!إنّه فخّ للأيل

51
00:04:33,460 --> 00:04:34,420
!هناك أمابّو

52
00:04:44,300 --> 00:04:45,630
!فكّ قيدي

53
00:04:46,870 --> 00:04:48,740
.رأس السهم ذاك مكسوّ بنبتة خانق الذئب

54
00:04:48,740 --> 00:04:50,420
.ما زال السمّ في جسدك

55
00:04:51,630 --> 00:04:53,060
!سيفوت الأوان إن لم تسرع

56
00:04:57,610 --> 00:04:59,690
.أشعر أنّ ساقي تحترق

57
00:05:00,700 --> 00:05:02,900
.لا يوجد أيّ ترياق لسموم الأينو

58
00:05:03,250 --> 00:05:06,220
.الطريقة الوحيدة للنجاة هي قطع اللحم المسموم

59
00:05:06,220 --> 00:05:07,110
.لا أكترث لذلك

60
00:05:08,330 --> 00:05:09,830
!افعلي ذلك

61
00:05:18,790 --> 00:05:21,110
من أين ذهبا؟

62
00:05:21,110 --> 00:05:22,520
.من هنا أيّها الغبي

63
00:05:30,230 --> 00:05:32,510
وقع في فخّ سهام؟

64
00:05:33,020 --> 00:05:35,390
،قطعت اللحم المحيط بالجرح أيضًا

65
00:05:35,390 --> 00:05:37,020
.لكني لا أدري إن كان سينجو

66
00:05:37,510 --> 00:05:39,210
.لننهِ الأمر

67
00:05:39,210 --> 00:05:41,830
.لم نأتِ لنقتل بعضنا

68
00:05:42,590 --> 00:05:45,150
.انتظر هنا يا تانيغاكي

69
00:05:45,740 --> 00:05:48,780
.أعدك بأن أطيح بالذئب الأبيض

70
00:05:49,400 --> 00:05:52,530
...إنّها مهووس

71
00:05:53,000 --> 00:05:59,420
إن كان ما قاله صحيحًا، فبإمكانك
إحضار الذئب إلى هنا، صحيح؟

72
00:05:59,900 --> 00:06:03,420
.لا يمكنني أن أدعهما يستعيداك بعد

73
00:06:12,550 --> 00:06:14,520
!أفلتني

74
00:06:15,140 --> 00:06:16,390
!أنزلني

75
00:06:18,360 --> 00:06:20,590
!ريتار هو آخر ذئب

76
00:06:20,590 --> 00:06:24,980
هل ستسمح لآخر الهوركوكاموي النبيلة
بالموت فقط من أجل مال قذر؟

77
00:06:25,470 --> 00:06:28,400
.انقرضت الذئاب بالفعل

78
00:06:28,970 --> 00:06:31,660
.لن يعود جنسها أبدًا

79
00:06:31,990 --> 00:06:34,660
خطيئة السماح لها بالانقراض

80
00:06:34,660 --> 00:06:38,250
.خطيئة يتشاركها جميع من يعيش على هذه الأرض

81
00:06:39,030 --> 00:06:40,970
.المال لا يهم

82
00:06:41,780 --> 00:06:46,090
.أريد أن أكون آخر صيّاد يرى ذئب إيزو

83
00:06:50,710 --> 00:06:52,670
،لا أكترث إن صرختِ

84
00:06:52,670 --> 00:06:54,740
.لكن إن عضضتِ لسانك، فلن يتسببّ ذلك إلّا بالألم

85
00:06:54,740 --> 00:06:57,350
.لن تموتي، لذا لا تحاولي

86
00:07:03,070 --> 00:07:05,650
.لن أقتل نفسي

87
00:07:06,490 --> 00:07:09,110
.أنا لا أريد أي يصبح ريتار وينكاموي فحسب

88
00:07:10,520 --> 00:07:12,070
،أهذا ما يعني أنّها إن قتلت إنسانًا

89
00:07:12,070 --> 00:07:15,470
تصبح آلهة شريرة وتذهب إلى الجحيم؟

90
00:07:16,460 --> 00:07:17,880
.لا تقلقي

91
00:07:17,880 --> 00:07:20,120
.البشر ليسوا قيّمين إلى تلك الدّرجة

92
00:07:20,900 --> 00:07:24,840
.هذه معركة بين حيوانين بريّين

93
00:07:24,840 --> 00:07:27,840
.لكنّي سأكون النّاجي الوحيد

94
00:07:28,570 --> 00:07:31,340
.سأنهي الأمر بطلقة واحدة كي لا يعاني

95
00:07:35,640 --> 00:07:38,810
!يا للعجب! لقد أتى حقًّا

96
00:07:44,730 --> 00:07:46,070
!غير معقول

97
00:07:46,070 --> 00:07:48,400
!إنّه يركض بطريقة تصعّب عليّ التصويب

98
00:07:48,400 --> 00:07:50,860
هل يفهم ما هو السّلاح؟

99
00:07:50,860 --> 00:07:52,050
!مذهل

100
00:07:52,050 --> 00:07:54,360
!أنت تستحقّ حقًّا أن تكون الذئب الأخير

101
00:07:54,360 --> 00:07:55,780
!لا تقترب يا ريتار

102
00:07:55,780 --> 00:07:56,240
!تعال إلى هنا

103
00:08:06,740 --> 00:08:08,300
!لقد انتصرت

104
00:08:27,230 --> 00:08:29,330
.أحسنت يا ريو

105
00:08:30,530 --> 00:08:32,970
.قمت بعملٍ جيّد جدًّا بالنسبة لقنينة ماء ساخن

106
00:08:34,340 --> 00:08:35,950
...فهمت

107
00:08:35,950 --> 00:08:37,700
كان هناك زوج إذًا؟

108
00:08:38,070 --> 00:08:39,990
أظنّ أنّ الزّوجة

109
00:08:39,990 --> 00:08:44,080
.لا تهتمّ بمعركة بين رجلين

110
00:08:47,410 --> 00:08:50,080
.النساء مخيفات حقًّا

111
00:08:51,150 --> 00:08:52,310
...لكن

112
00:08:53,220 --> 00:08:54,870
.أنا راضٍ

113
00:09:25,110 --> 00:09:28,420
ريتار... ألديك عائلة؟

114
00:09:29,480 --> 00:09:32,390
...من كان يناديك في تلك اللّيلة

115
00:09:56,580 --> 00:10:02,410
".فلتولد من جديد وتسمع أصواتًا عذبة"

116
00:10:08,450 --> 00:10:11,190
هل سنأخذهما حقًّا؟

117
00:10:11,670 --> 00:10:13,880
.لا يمكننا أن نتركهما وهما على وشك الموت

118
00:10:14,260 --> 00:10:17,840
كما أنّ كلب الأينو سيبقى
.هناك إلى الأبد إن لم نأخذه

119
00:10:19,770 --> 00:10:21,910
.لقد تعبت

120
00:10:21,910 --> 00:10:25,690
.سأستريح هنا إلى أن يلحق بنا سوغيموتو

121
00:10:42,430 --> 00:10:43,700
.سينا كيسارا

122
00:10:44,030 --> 00:10:44,990
ماذا؟

123
00:10:44,990 --> 00:10:46,900
.يقولون أنّ أذنيك غريبتان

124
00:10:50,960 --> 00:10:52,920
هل أنت واثق من هذا؟

125
00:10:52,920 --> 00:10:56,110
،إن كانت شريكتي تريد إنقاذهما

126
00:10:56,110 --> 00:10:57,810
.فلن أتدخّل

127
00:10:57,810 --> 00:11:02,400
،إن حاولا فعل شيء ما مجدّدًا
.فسأتولى أمرهما بنفسي هذه المرة

128
00:11:03,430 --> 00:11:05,550
.فلنأكل

129
00:11:05,550 --> 00:11:08,180
.إنه حساء لحم الأيل، يوكوهاو

130
00:11:10,310 --> 00:11:11,550
.هينّا، هينّا

131
00:11:11,550 --> 00:11:13,970
.لحم الأيل هينّا حتّى وهو مطبوخ

132
00:11:13,970 --> 00:11:15,840
.أجل، هينّا حقًّا

133
00:11:19,200 --> 00:11:22,290
...آمل ألّا يضع سوغيموتو أيّ أوسوما به مجدّدًا

134
00:11:23,510 --> 00:11:28,160
آمل ألّا يضع سوغيموتو أيّ
.أوسوما في الحساء مجدّدًا

135
00:11:29,050 --> 00:11:30,620
الميسو، صحيح؟

136
00:11:33,320 --> 00:11:35,090
مجدّدًا يا سوغيموتو؟

137
00:11:35,540 --> 00:11:37,360
!أنت تحبّ الأوسوما خاصّتك حقًّا

138
00:11:37,360 --> 00:11:38,630
!يا إلهي

139
00:11:40,550 --> 00:11:42,340
ما هذا؟

140
00:11:42,340 --> 00:11:43,960
!هذا مؤلم

141
00:11:42,870 --> 00:11:46,710
هل هناك شيء حلو يخرج من رأسك يا شيرايشي؟

142
00:11:46,710 --> 00:11:48,350
!الأوسوما لذيذ جدًّا

143
00:11:47,930 --> 00:11:50,060
شيء حلو؟

144
00:11:48,350 --> 00:11:50,060
!إنّه ليس برازًا

145
00:11:50,060 --> 00:11:51,290
...توقّف

146
00:11:51,290 --> 00:11:53,060
.لا أكترث إن كان حلوًا، توقّف

147
00:11:54,020 --> 00:11:55,270
.إنه رويبي السلمون

148
00:11:56,080 --> 00:12:00,890
.نعلّق اللحم أو السمك النيّئ على شجرة لتجميده

149
00:12:04,360 --> 00:12:06,950
.إنّه نصف مجمّد وله ملمس غريب

150
00:12:07,340 --> 00:12:10,110
...إنّه يذوب في الفم

151
00:12:10,110 --> 00:12:11,350
!إنّه لذيذ

152
00:12:11,350 --> 00:12:14,080
."رويبي تعني "الطعام المذاب

153
00:12:14,430 --> 00:12:15,670
!فهمت

154
00:12:15,670 --> 00:12:19,160
.الجو بارد هنا، لذا من الطبيعي أن يكون مجمّدًا

155
00:12:36,400 --> 00:12:38,700
ما الذي قالته؟

156
00:12:38,700 --> 00:12:42,780
.إنّها باسكوما أو أسطورة خاصة بهوتشي عن السلمون

157
00:12:43,400 --> 00:12:48,640
،حدث نفس الشيء في هيداكا
.كوشيرو، شيراوي... أماكن كثيرة

158
00:12:48,640 --> 00:12:54,000
أرسلت كلّ القرى رجلًا بسفينة
.إلى البحار لجمع كلّ الذهب في مكان واحد

159
00:12:54,000 --> 00:12:56,440
،دام ذلك لسنوات

160
00:12:56,440 --> 00:12:57,960
،لذا لم نتمكّن من صيد السلمون

161
00:12:57,960 --> 00:13:00,090
.وأصبحت حياتنا أكثر صعوبة

162
00:13:01,070 --> 00:13:02,460
،عقد الأينو اجتماعًا

163
00:13:02,460 --> 00:13:04,090
.واتّفقوا على التوقف عن جمع الذهب

164
00:13:04,890 --> 00:13:08,550
،وخُبّئ الذهب كي لا يقاتل أحد بسببه

165
00:13:08,550 --> 00:13:10,060
.ومُنِع الحديث عنه

166
00:13:11,020 --> 00:13:12,870
،هرم جميع من يهمهم الأمر

167
00:13:12,870 --> 00:13:17,770
وفي النهاية بقي رجل عجوز واحد في
.قريتنا يعرف بمكان الكنز

168
00:13:18,220 --> 00:13:21,850
.وقُتِل ذلك الرّجل من قِبل نوبّيرابو

169
00:13:21,850 --> 00:13:23,740
.مهلًا لحظة

170
00:13:24,090 --> 00:13:26,950
هل هو الكنز المدفون؟

171
00:13:26,950 --> 00:13:30,700
تمّ جمعه من كلّ هوكايدو على مدى سنوات؟

172
00:13:30,700 --> 00:13:33,450
.لم أسمع هذه الباسكوما من قبل أنا أيضًا

173
00:13:33,450 --> 00:13:36,330
،إن كان ذلك صحيحًا

174
00:13:36,330 --> 00:13:40,340
فقد يكون هناك أكثر من الكان
!العشرين الذي نعلم بشأنها

175
00:13:40,850 --> 00:13:42,390
.أنت مخطئ تمامًا

176
00:13:44,170 --> 00:13:45,870
،كما قالت العجوز

177
00:13:46,360 --> 00:13:50,390
.تمّ نشر قصّة الذهب سرًّا عبر البلاد من طرف الأينو

178
00:13:51,260 --> 00:13:54,890
،كان قائدنا جندي استخبارات

179
00:13:54,890 --> 00:13:57,850
.وبارعًا في جمع وتحليل المعلومات

180
00:13:58,790 --> 00:14:00,360
الملازم تسورومي؟

181
00:14:00,920 --> 00:14:06,110
أراد نوبيرابو الحرص على ألّا يتمكّن أحد
،من إيجاد الذهب بالطريق المستعمل للهرب

182
00:14:06,110 --> 00:14:08,210
.لذا أعطى معلومات خاطئة

183
00:14:08,210 --> 00:14:12,870
.يمكن لأيّ شخص أن يحمل 75 كيلوغرامًا بنفسه

184
00:14:12,870 --> 00:14:15,580
...لكن في الحقيقة

185
00:14:15,890 --> 00:14:18,370
.هناك أكثر مما يمكن حمله

186
00:14:18,370 --> 00:14:23,830
يظنّ الملازم تسورومي أنّ هناك 1000 ضعف
.الذّهب الذي أٌخبر به السجناء

187
00:14:26,840 --> 00:14:28,220
!ألفا كان؟

188
00:14:29,870 --> 00:14:33,350
.تسورومي ذاك غريب حقًّا

189
00:14:33,350 --> 00:14:37,790
قال أنّه سيستولي على القسم
،السابع الرئيسي في أساهيكاوا

190
00:14:37,790 --> 00:14:39,550
لكن ماذا سيفعل عندها؟

191
00:14:39,550 --> 00:14:41,610
يشنّ انقلابًا؟

192
00:14:41,960 --> 00:14:45,240
،إن كان لديك كلّ ذلك الذهب

193
00:14:45,240 --> 00:14:49,320
أولن تتقاسمه مع أصدقائك وتعيش حياة رغيدة؟

194
00:14:49,680 --> 00:14:53,580
لم قد يريد الاستيلاء على مقرّ القسم السّابع؟

195
00:14:53,580 --> 00:14:55,580
.حصار ميناء آرثر على الأرجح

196
00:15:02,150 --> 00:15:06,760
صوت رشّاشات ماكسيم الذي يشبه
...موسيقى الموت بحد ذاته

197
00:15:06,760 --> 00:15:10,330
أتمنّى أن أجعل من جعلونا نشنّ

198
00:15:10,330 --> 00:15:12,220
.هذا الهجوم عديم الفائدة يسمعونها عن قرب

199
00:15:12,540 --> 00:15:14,180
!ارمِ قنبلة

200
00:15:14,180 --> 00:15:15,350
.حاضر

201
00:15:18,680 --> 00:15:19,520
.سامحني

202
00:15:25,910 --> 00:15:27,190
!تقدّموا

203
00:15:39,170 --> 00:15:41,040
،انتصرنا

204
00:15:41,040 --> 00:15:43,290
،لكن قبل الاستيلاء على تلة الـ 203

205
00:15:43,290 --> 00:15:47,970
.سقط أكثر من نصف القسم السابع ضحايا

206
00:15:48,530 --> 00:15:53,470
كان رئيس الأركان مهووسًا بشنّ
،هجوم جبهويّ لتعزيز مجده الخاص

207
00:15:53,470 --> 00:15:57,220
.وانتحر ندمًا على الضّحايا الذي تسبّب بموتهم

208
00:15:57,220 --> 00:16:01,420
،لامت الحكومة باقي القسم على انتحاره

209
00:16:01,420 --> 00:16:03,700
،ولم يتوقّف الأمر على عدم تلقينا لأي مال أو أوسمة

210
00:16:03,700 --> 00:16:08,400
.بل عاملنا باقي الجيش كمنبوذين

211
00:16:08,400 --> 00:16:09,420
...لكن

212
00:16:10,110 --> 00:16:12,030
،سوف ننشئ دكتاتورية عسكرية

213
00:16:12,340 --> 00:16:15,490
!سأقودها أنا

214
00:16:15,810 --> 00:16:18,790
.لا يمكننا إعطاء الّذهب للجميع

215
00:16:18,790 --> 00:16:24,210
سنستعمله لافتتاح مصنع أسلحة
.في هوكّايدو الغنية بالموارد

216
00:16:24,530 --> 00:16:25,900
أليس كذلك؟

217
00:16:25,900 --> 00:16:27,920
.البنادق الجيّدة باهظة الثمن

218
00:16:28,330 --> 00:16:31,630
إن كنت لا تريد دفع الكثير، فهذا
.أفضل ما يمكنك الحصول عليه

219
00:16:32,190 --> 00:16:37,640
تسورومي-سان، إن كنت تريد استعمال الذهب
.لإنشاء مصنعٍ للأسلحة، فعليك أن تسرع

220
00:16:37,640 --> 00:16:41,140
.سأشتري أسلحتك وأبيعها عبر العالم

221
00:16:41,700 --> 00:16:44,140
.الأسلحة اليابانية تُصنَع بشكل جيّد

222
00:16:44,700 --> 00:16:47,740
.والحرب مربحة

223
00:16:48,510 --> 00:16:50,990
!الأطفال الذين فقدوا آباءهم

224
00:16:50,990 --> 00:16:53,200
!الآباء الذين فقدوا أبناءهم

225
00:16:53,200 --> 00:16:55,200
!الزوجات اللاتي فقدن أزواجهنّ

226
00:16:55,200 --> 00:16:57,950
.سنمنحهم عمل مستقرًّا ومتوازنًا

227
00:16:58,280 --> 00:17:01,290
سننقذهم من قضاء حياتهم

228
00:17:01,290 --> 00:17:05,900
!جوعًا وشعورًا بالبرد وهم يحرثون الأرض الباردة

229
00:17:05,900 --> 00:17:10,880
!هذا أقلّ ما يمكننا فعله لرفاقنا الذين ماتوا

230
00:17:12,390 --> 00:17:16,630
،لا أعرف سبب رغبتك بالذّهب

231
00:17:17,070 --> 00:17:22,380
لكنّي واثق أنّ السّبب لا شيء مقارنة
.بالعبء الذي يحمله الملازم تسورومي

232
00:17:35,150 --> 00:17:36,990
.سوغيموتو

233
00:17:36,990 --> 00:17:42,190
لن تتوقف بسبب ما سمعته للتو، صحيح؟

234
00:17:43,280 --> 00:17:44,200
...لا

235
00:17:44,570 --> 00:17:47,770
.تسبب بضرر كبير وقتل رجاله أيضًا

236
00:17:48,450 --> 00:17:51,770
.العمل معه ليس خيارًا في هذه المرحلة

237
00:17:51,770 --> 00:17:53,920
.لكنّي لن أسمح له بالحصول عليه أيضًا

238
00:17:53,920 --> 00:17:56,710
.هذا سوغيموتو الذي أعرفه

239
00:17:56,710 --> 00:17:59,840
.سأفي بوعدي لشريكي. هذا كلّ شيء

240
00:18:11,210 --> 00:18:14,650
!نساء

241
00:18:16,050 --> 00:18:17,340
.وحش

242
00:18:17,340 --> 00:18:19,360
.سيتّصل أحد ما بالشرطة

243
00:18:19,360 --> 00:18:25,330
كان العمل الإجباري في سجن
.أباشيري قاسيًّا لدرجة موت بعضهم

244
00:18:25,330 --> 00:18:29,570
.لكنّه قال أنّه يجعله كسولًا

245
00:18:30,830 --> 00:18:34,010
.ناغاكورا، نادِ أوشياما

246
00:18:34,960 --> 00:18:37,010
.لنذهب إلى البلدة

247
00:18:43,330 --> 00:18:44,800
!أنا آسف

248
00:18:46,770 --> 00:18:50,190
!عليك أن تفكّر أكثر في من تفتعل شجارًا معه

249
00:18:50,510 --> 00:18:51,570
.ابتعدوا

250
00:19:01,100 --> 00:19:03,570
.حسنًا، سأعود لاحقًا

251
00:19:03,570 --> 00:19:06,700
.اذهبوا أنتم العجزة واشربوا بعض الشاي أو ما شابه

252
00:19:07,770 --> 00:19:10,920
.تابع التكلّم بتلك الطريقة وسأشقّ بطنك

253
00:19:10,920 --> 00:19:12,610
.مخيف

254
00:19:12,610 --> 00:19:17,550
يمكنني رؤية لمَ قالوا أنّك كنت
.أقوى سيّاف في الشينسينغومي

255
00:19:19,760 --> 00:19:21,510
.تساهل معه قليلًا

256
00:19:21,510 --> 00:19:26,320
إن لم تترك أوشياما يضاجع امرأة
.من وقت لآخر يصبح متقلّبًا

257
00:19:26,320 --> 00:19:30,730
قد لا يسعى خلف النساء في الجوار
.فقط. قد يسعى خلفك أنت

258
00:19:35,600 --> 00:19:37,150
.مرحبًا يا سيدي

259
00:19:38,350 --> 00:19:39,910
هل عدت؟

260
00:19:39,910 --> 00:19:41,910
.ليس لدي جديد أخبرك به، لكن تعال وامرح قليلًا

261
00:19:41,910 --> 00:19:44,610
!جميع الفتيات في محلّك بشعات

262
00:19:44,610 --> 00:19:46,800
.أنت تغيظني حقًّا

263
00:19:48,930 --> 00:19:53,470
أظنني سأقوم ببعض "الاستجواب" في
.بيت دعارة أغلى من المعتاد اليوم

264
00:19:53,470 --> 00:19:55,840
!فعليّ إيجاد ذلك الذهب في النهاية

265
00:20:01,670 --> 00:20:04,640
.مرحبًا يا شيرايشي يوشيتاكي

266
00:20:08,060 --> 00:20:11,270
لماذا تهرب يا شيرايشي؟

267
00:20:11,270 --> 00:20:13,690
!لنتحدث قليلًا

268
00:20:14,440 --> 00:20:15,680
!تبًّا! تبًّا

269
00:20:15,680 --> 00:20:18,900
!التقيت بأوشياما من بين الجميع

270
00:20:18,900 --> 00:20:20,940
!مرحبًا أيّها الضخم

271
00:20:20,940 --> 00:20:23,770
!الرجل الذي تبحث عنه هناك

272
00:20:23,770 --> 00:20:27,500
!هو الذي لكم المومس وآذاها

273
00:20:27,500 --> 00:20:28,700
ماذا؟

274
00:20:28,700 --> 00:20:30,250
ذلك الوغد؟

275
00:20:31,010 --> 00:20:33,710
!حسنًا، سأبرحه ضربًا

276
00:20:34,410 --> 00:20:35,750
!شجار! شجار

277
00:20:35,750 --> 00:20:36,600
!نل منه

278
00:20:36,600 --> 00:20:37,670
!سوف أساعدك

279
00:20:42,930 --> 00:20:44,690
!تبًّا

280
00:20:44,690 --> 00:20:46,550
!لم يبطئوا حركته حتّى

281
00:20:58,700 --> 00:20:59,790
!نعم

282
00:20:59,790 --> 00:21:00,820
!لا بد أنّه ميّت الآن

283
00:21:12,690 --> 00:21:14,160
!ابتعد عن الطريق

284
00:21:21,170 --> 00:21:22,260
!لم ينجح الأمر

285
00:21:22,260 --> 00:21:24,130
!لن يوقفه شيء

286
00:21:24,550 --> 00:21:28,680
كيف يمكنني إيقاف ذلك الثور الهائج؟

287
00:21:32,030 --> 00:21:33,420
!القسم السابع

288
00:21:34,630 --> 00:21:37,450
ما الخطب؟ لمَ أنت خائف جدًّا؟

289
00:21:37,970 --> 00:21:40,310
.هناك شيء غريب حيالك

290
00:21:40,310 --> 00:21:42,770
أيوجد لدى أحدكم لائحة مطلوبين؟

291
00:21:43,480 --> 00:21:45,420
!سـ-ساعدوني

292
00:21:45,420 --> 00:21:49,410
!قال أني سرقت ماله في الحمّام وهو يلاحقني

293
00:21:49,730 --> 00:21:54,830
يلاحقني رجل لديه أوشام
!غريبة وهو ليس من الياكوزا

294
00:23:35,770 --> 00:23:40,000
.الحلقة القادمة، عين قاتل