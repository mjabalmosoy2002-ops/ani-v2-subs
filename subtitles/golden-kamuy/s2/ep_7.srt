1
00:00:02,760 --> 00:00:04,480
!وجدناكِ أخيرًا

2
00:00:04,480 --> 00:00:07,310
!كنا نبحث عنك مذ كنّا في أوتارو

3
00:00:08,280 --> 00:00:09,320
عنّي؟

4
00:00:11,410 --> 00:00:14,860
.التقينا صيادين من الأينو هناك وسألناهما

5
00:00:17,170 --> 00:00:20,380
مرحبًا، هل رأيتما فتاة من الأينو؟

6
00:00:21,540 --> 00:00:25,460
.ينبغي أن تكون مع رجل يابانيّ بندبة على وجهه

7
00:00:26,610 --> 00:00:29,250
.إنّها الفتاة التي رأيناها للتوّ

8
00:00:30,710 --> 00:00:34,660
!كانا متفاجئين لوصولك إلى هذا الحدّ

9
00:00:34,660 --> 00:00:37,370
أرادا منّا جميعًا الذهاب
!لزيارتهما في الكوتان الخاص بهما

10
00:00:37,370 --> 00:00:38,890
!لقد اصطادا دبًّا

11
00:00:38,890 --> 00:00:40,210
!هيا بنا يا أسيربا

12
00:00:40,210 --> 00:00:41,590
!هيّا بنا يا سوغيموتو

13
00:00:41,590 --> 00:00:43,430
!هناك حساء دبّ ينتظرنا

14
00:00:43,430 --> 00:00:48,150
أفضّل الذهاب لحانات محلّية
!على حساب إينكارما-تشان

15
00:00:48,800 --> 00:00:52,530
!كلّا! إينكارما جزء من عائلتي

16
00:00:53,430 --> 00:00:54,600
عائلة؟

17
00:00:54,600 --> 00:00:58,820
،أجل! إنّها لا تغضب إن لمست ثدييها

18
00:00:58,820 --> 00:01:01,160
.وتانيغاكي نيسبا مرافقها

19
00:01:01,580 --> 00:01:02,790
.هذا صحيح

20
00:01:05,560 --> 00:01:06,980
لمَ هو هنا؟

21
00:01:09,620 --> 00:01:10,760
...مرافق

22
00:01:10,760 --> 00:01:12,360
...كلّا

23
00:02:57,030 --> 00:02:59,350
هل وجدتموهم؟

24
00:02:59,350 --> 00:03:00,490
!مرحبًا بكم

25
00:03:00,490 --> 00:03:03,540
.كاموي هوبونيري على وشك البدء

26
00:03:03,540 --> 00:03:04,840
.استمتعوا بوقتكم

27
00:03:05,990 --> 00:03:10,160
.كاموي هوبونيري تعني رحيل الآلهة. إنّه احتفال

28
00:03:10,160 --> 00:03:12,830
.يودّعون الدبّ الذي اصطادوه

29
00:03:13,590 --> 00:03:15,460
،إنّه طقس يختلف عن إيومانتي

30
00:03:15,460 --> 00:03:18,050
.حيث يودّعون فيه دبًّا تربّى في قفص

31
00:03:29,320 --> 00:03:31,380
.تلك الصيحة تدعى أوكوكوكسي

32
00:03:31,380 --> 00:03:35,150
.تُستعمل لإخبار إله النار بأنّه قد تمّ اصطياد دب

33
00:03:35,470 --> 00:03:38,850
،الكاموي أشياء لا يمكن للبشر فعلها

34
00:03:38,850 --> 00:03:41,910
.أشياء تساعدنا وأشياء تتسبب بالكوارث لنا

35
00:03:43,030 --> 00:03:45,810
.النار شيء مهمّ في حياتنا

36
00:03:45,810 --> 00:03:49,090
.الأنصال تقطع أشياء لا يمكننا قطعها بأنفسنا

37
00:03:49,090 --> 00:03:50,750
.لذا فيها كاموي بداخلها

38
00:03:50,750 --> 00:03:53,350
.الأشجار كاموي تجلس على الجبال

39
00:03:53,350 --> 00:03:57,010
الطقس السيّئ والأوبئة
،أشياء خارجة عن سيطرة البشر

40
00:03:57,010 --> 00:03:57,960
.لذا هي كاموي أيضًا

41
00:03:59,090 --> 00:04:03,650
.لكنّها  ليست أعظم بكثير من البشرية

42
00:04:03,650 --> 00:04:06,140
.نعتبرها متساوية معنا

43
00:04:06,650 --> 00:04:09,760
،لطالما اعتقدنا بذلك أثناء صيدنا

44
00:04:09,760 --> 00:04:13,380
،لا نصيب الفريسة بأسهمنا
.بل تركض إليها الكاموي من أجلنا

45
00:04:14,120 --> 00:04:18,180
،ندعوها إلى عالمنا، ومقابل لحمها وفروها

46
00:04:18,180 --> 00:04:22,620
تطلب السّاكي والتبغ التي هي
.أشياء نحن فقط نستطيع صنعها

47
00:04:22,620 --> 00:04:25,780
،بعدها نودّع الكاموي بطقس مناسب

48
00:04:26,220 --> 00:04:31,040
.كي تخبر الكاموي الأخرى أنّ عالم البشر مكان جيّد

49
00:04:31,780 --> 00:04:35,640
.إن لم نعاملها بطريقة مناسبة، فلن تعود إلى عالمنا أبدًا

50
00:04:36,850 --> 00:04:41,800
بعد ذلك سيؤخذ رأس الدبّ إلى
.مذبح في الخارج مزخرف بإيناو

51
00:04:42,310 --> 00:04:46,950
.الإيناو عيدان خشبية مبرودة تُعطى للكاموي كهدية

52
00:04:48,200 --> 00:04:53,020
عندما يملك كاموي ما الكثير من
.الإيناو ترتفع مكانته في عالمه

53
00:04:53,370 --> 00:04:56,780
يُقال أنّ الإيناو الذي نعطيها
،له تتحول إلى فضّة وذهب

54
00:04:56,780 --> 00:04:59,270
.وتتحوّل إلى كنز ثمين تحتفظ به

55
00:04:59,270 --> 00:05:02,800
،الذّهب قيّم حتّى في الآخرة إذًا

56
00:05:02,800 --> 00:05:06,200
وإن كان لديك الكثير، فستكون سعيدًا؟

57
00:05:32,180 --> 00:05:34,850
ما الذي تفكّر فيه تلك التشيرونوب؟

58
00:05:35,320 --> 00:05:36,370
...أسيربا

59
00:05:37,970 --> 00:05:40,010
.لديّ شيء أودّ إخبارك إيّاه

60
00:05:40,450 --> 00:05:42,690
.أتيت إلى هنا لأخبرك بشأن هوتشي

61
00:05:59,000 --> 00:06:00,010
...هوتشي

62
00:06:03,250 --> 00:06:08,930
أتيت كلّ هذه المسافة من أوتارو
لتقول لها ذلك يا جدني تانيغاكي؟

63
00:06:08,930 --> 00:06:10,410
...جندي أوغاتا

64
00:06:10,950 --> 00:06:15,020
أرسلك الملازم تسورومي إلى هنا لمراقبتي، صحيح؟

65
00:06:15,020 --> 00:06:18,810
.لا.... لم أعد مع الجيش

66
00:06:18,810 --> 00:06:22,910
.ساعدتني تلك العجوز، لذا سأعيد لها حفيدتها بأمان

67
00:06:22,910 --> 00:06:24,440
.هذا واجبي

68
00:06:24,790 --> 00:06:26,780
.أتساءل عن ذلك

69
00:06:26,780 --> 00:06:31,740
كنت مؤمنًا كبيرًا بالملازم تسورومي
.وقتلت ثلاثة رجال في الجبال

70
00:06:33,450 --> 00:06:34,370
في الجبال؟

71
00:06:34,850 --> 00:06:37,700
أتقصد الرجال الثلاثة الذين كانوا مع تانيغاكي؟

72
00:06:37,700 --> 00:06:39,960
.قتلهم دبّ

73
00:06:40,380 --> 00:06:43,710
.أنت متأكّد من ذلك لأنّي كنت هناك

74
00:06:44,280 --> 00:06:45,670
دبّ؟

75
00:06:47,830 --> 00:06:51,640
رأت العجوز حلمًا لم ترَ فيه حفيدتها مجدّدًا؟

76
00:06:52,060 --> 00:06:53,900
.كان مجرّد حلم

77
00:06:53,900 --> 00:06:55,720
.أرسل لها رسالة

78
00:06:56,210 --> 00:07:01,530
لطالما اعتقدنا نحن الأينو أنّ
الأحلام شيء يرسله الكاموي عندما

79
00:07:01,530 --> 00:07:03,540
.تريد أن ترينا شيئًا ما

80
00:07:03,540 --> 00:07:08,070
.لا أؤمن بذلك، لكنّ هوتشي من الأينو القدماء

81
00:07:08,770 --> 00:07:13,030
...وقد راودها حلم قبل وقت طويل

82
00:07:14,500 --> 00:07:18,500
،رأت في الحلم ابنتها محاطة بالدّببة

83
00:07:18,500 --> 00:07:20,180
.تودّعها وترسلها للعالم الآخر

84
00:07:21,770 --> 00:07:27,210
.أخبرتني أنّه بعد ذلك بوقت قصير مرضت أمي وماتت

85
00:07:27,640 --> 00:07:31,280
.لهذا السّبب تؤمن بالأحلام بشدّة

86
00:07:31,280 --> 00:07:34,340
أسيربا-سان، هل تريدين العودة؟

87
00:07:35,090 --> 00:07:36,680
،إن رأت وجهك مرّة واحدة فقط

88
00:07:36,680 --> 00:07:40,660
فلن يبقى حلمها نبوءة، صحيح؟

89
00:07:41,160 --> 00:07:42,600
.ستشعر بتحسّن

90
00:07:45,320 --> 00:07:47,230
.لست مضطرة لإرغام نفسك على البقاء هنا

91
00:07:51,090 --> 00:07:53,320
.لا تعاملني كطفلة يا سوغيموتو

92
00:07:53,730 --> 00:07:57,060
.هناك شيء أريد معرفته مهما كلّف الأمر

93
00:07:57,060 --> 00:08:01,450
سأعرف ما أريد معرفته
.وسأمضي قُدمًا من أجل حلمي

94
00:08:21,290 --> 00:08:23,690
.تانيغاكي نسيبا

95
00:08:23,690 --> 00:08:26,940
.كنت أتساءل بشأن بندقية موراتا تلك

96
00:08:26,940 --> 00:08:28,890
ألم تكن ملكًا لنيهي تيتسوزو؟

97
00:08:29,960 --> 00:08:31,360
كنت تعرف نيهي؟

98
00:08:31,760 --> 00:08:35,120
.كنّا نصطاد الدّببة معًا قبل أكثر من عشر سنوات

99
00:08:35,120 --> 00:08:39,280
كان بارعًا في ذلك لدرجة أنّي ظننت
.أنّه لن يبقى أيّ دبّ في المنطقة

100
00:08:41,320 --> 00:08:43,240
.مات نيهي في الجبال

101
00:08:43,670 --> 00:08:45,790
.أخذت هذه البندقية منه

102
00:08:45,790 --> 00:08:47,670
.فهمت

103
00:08:47,670 --> 00:08:51,860
لكن لا بدّ أنّك تواجه صعوبة
.في استعمال بندقية قديمة كتلك

104
00:08:51,860 --> 00:08:56,010
.غيّرني نيهي تيتسوزو من جنديّ وأعادني إلى كوني ماتاغي

105
00:08:56,820 --> 00:09:02,020
قرّرت حملها معي كي لا أنسى
.شعوري عند الإطلاق على فريستي

106
00:09:02,470 --> 00:09:05,980
أنهِ المعركة برصاصة واحدة دائمًا، صحيح؟

107
00:09:08,440 --> 00:09:12,330
أترى تلك العلامات الصغيرة على ماسورة البندقية؟

108
00:09:13,400 --> 00:09:15,570
.أخبرني نيهي بمعناها

109
00:09:17,650 --> 00:09:22,330
.لدي عدّة أطفال، لكن لديّ ابنٌ واحد

110
00:09:23,000 --> 00:09:26,790
هذه البندقية التي استعملها في
.الحرب الصينية اليابانية الأولى

111
00:09:27,210 --> 00:09:29,610
،أعطاها لي أحد أصدقائه

112
00:09:29,610 --> 00:09:33,990
وقال لي أنّه أضاف كلّ علامة على
.الماسورة بعد أن يطلق على عدو ما

113
00:09:35,090 --> 00:09:38,090
،ربّما توقف عن العدّ بعد العدّو السابع

114
00:09:38,090 --> 00:09:40,870
.أو ربّما مات بعدها

115
00:09:41,480 --> 00:09:44,980
في كلا الحالتين، لم يكن من النوع الذي
.قد يستمتع بإطلاق النار على الناس

116
00:09:44,980 --> 00:09:48,550
لكنّ النوع الضّعيف الذي
يشعر بالذنب بعد قتل شخص ما

117
00:09:48,550 --> 00:09:50,190
.ليس مؤهّلا ليكون جنديًّا

118
00:09:50,190 --> 00:09:53,570
.كان عليه البقاء في المنزل وصيد الدّببة معي

119
00:10:02,740 --> 00:10:04,450
أ-أهذا أنت يا ريو؟

120
00:10:08,310 --> 00:10:09,120
!ريو؟

121
00:10:09,940 --> 00:10:12,090
!إنّه ريو

122
00:10:12,460 --> 00:10:15,320
ما الذي يفعله كلب نيهي هنا؟

123
00:10:15,750 --> 00:10:17,380
هل أحضرته معك؟

124
00:10:17,380 --> 00:10:18,430
...كلّا

125
00:10:20,050 --> 00:10:22,890
...ريو، أكنت

126
00:10:23,650 --> 00:10:27,890
أكنت تتبع تانيغاكي كلّ هذا
!الوقت بما أنّه يملك بندقية نيهي؟

127
00:10:37,880 --> 00:10:39,530
.يا لك من كلب رائع

128
00:10:44,310 --> 00:10:45,620
!هذا مؤلم أيّها الحيوان الغبيّ

129
00:10:45,620 --> 00:10:47,010
!اغرب عن وجهي

130
00:10:47,010 --> 00:10:48,960
.ريو كلب وفيّ

131
00:10:48,960 --> 00:10:52,290
.لن ينسى عدوًّا لسيّده

132
00:11:02,870 --> 00:11:04,890
ماذا ستفعل الآن يا تانيغاكي؟

133
00:11:06,600 --> 00:11:10,560
!سأتبعكم إلى أن تحقّق أسيربا حلمها

134
00:11:11,880 --> 00:11:13,060
.فهمت

135
00:11:13,400 --> 00:11:17,190
.سأرسل برقيّة إلى هوتشي بمجرد أن نصل إلى البلدة

136
00:11:18,610 --> 00:11:19,610
!حسنًا

137
00:11:21,610 --> 00:11:25,620
!حسنًا، لنذهب إلى أباشيري يا أسيربا-سان

138
00:11:27,300 --> 00:11:28,070
!أجل

139
00:11:40,040 --> 00:11:42,470
!سيوبّخني الملازم تسورومي

140
00:11:42,790 --> 00:11:45,170
لا بدّ أنّه غضب كثيرًا عندما سمع أنّني سمحت

141
00:11:45,170 --> 00:11:47,260
!لشيرايشي يوشيتاكي بالهرب

142
00:11:47,770 --> 00:11:49,350
كيف بدا؟

143
00:11:50,600 --> 00:11:56,390
أيّها الرقيب تسوكيشيما، هل قال
الملازم تسورومي شيئًا ما عني؟

144
00:11:57,720 --> 00:12:00,240
!لا داعي لتخبرني! أنا أعلم يا تسوكيشيما

145
00:12:00,240 --> 00:12:02,110
...أنا

146
00:12:02,110 --> 00:12:06,310
!سيتمّ إرسالي إلى أباشيري لمراقبة إينودو شيروسكي

147
00:12:08,150 --> 00:12:10,460
.اهدأ أيّها الملازم الثاني كويتو

148
00:12:10,460 --> 00:12:13,770
.انظر، أحضرت الصورة التي طلبتها

149
00:12:15,830 --> 00:12:18,590
!إنّها صورة رائعة يا تسوكيشيما

150
00:12:19,050 --> 00:12:21,690
ليس هناك ندبة على وجهه، لذا لا بدّ أنّها التُقِطت

151
00:12:21,690 --> 00:12:23,970
!قبل معركة موكدين

152
00:12:26,760 --> 00:12:29,350
.أنا غيور منك يا رقيب تسوكيشيما

153
00:12:30,730 --> 00:12:36,290
.كنت لأقاتل إلى جانبه لو أنّي ولِدت في وقت أبكر

154
00:12:39,010 --> 00:12:41,080
!هذا ممتاز

155
00:12:41,970 --> 00:12:44,740
!تسوكيشيما، اسحق بعض الأرز لنستعمله كغراء

156
00:12:45,120 --> 00:12:46,450
.لا

157
00:12:47,480 --> 00:12:49,930
!لم أعلم أنّك هنا أيّها الملازم الثاني كويتو

158
00:12:52,690 --> 00:12:54,920
.مرحبًا

159
00:13:02,490 --> 00:13:04,070
.اهدأ

160
00:13:04,070 --> 00:13:07,150
.لا يمكنني فهم لهجة ساتسوما السريعة

161
00:13:07,150 --> 00:13:08,510
.خذ نفسًا عميقًا

162
00:13:15,060 --> 00:13:16,270
!لا أفهمك

163
00:13:16,270 --> 00:13:17,650
!تسوكيشيما

164
00:13:17,970 --> 00:13:21,780
.أخبره أنّ شيرايشي هرب، لكني نسخت أوشامه

165
00:13:23,090 --> 00:13:25,480
.قال أنّه نسخ أوشام شيرايشي

166
00:13:25,480 --> 00:13:30,200
لمَ أنا الوحيد الذي تتحدث معه بلهجة
ساتسوما السريعة أيّها الملازم الثاني كويتو؟

167
00:13:30,580 --> 00:13:35,930
.أمرتك بعدم قتل شيرايشي لأنّي ظننته ذا قيمة

168
00:13:35,930 --> 00:13:39,090
...وقد سمحت للعدوّ بالظّفر به

169
00:13:39,090 --> 00:13:41,590
.لقد خذلتني أيّها الملازم الثاني كويتو

170
00:13:56,290 --> 00:13:58,340
!يبدو ذلك رائعًا عليك

171
00:13:58,340 --> 00:14:01,520
إنّه جلد السجين الذي كان
يدّعي أنّه إينودو، صحيح؟

172
00:14:01,520 --> 00:14:04,760
.هذه إضافة غير متوقّعة

173
00:14:04,760 --> 00:14:06,400
،مّما سمعت

174
00:14:06,400 --> 00:14:11,530
يمكن افتراض أنّ هذه الأوشام كانت
.ملكًا للمحتال سوزوكاوا كيوهيرو

175
00:14:11,530 --> 00:14:13,450
.أحسنت أيّها الملازم الثاني كويتو

176
00:14:14,200 --> 00:14:15,370
...لكن

177
00:14:16,180 --> 00:14:17,870
.الخطوط ليست صحيحة

178
00:14:19,330 --> 00:14:26,210
!سوموهان! سوموهان

179
00:14:21,140 --> 00:14:23,840
.هذا ما أتحدّث عنه أيّها الملازم الثاني كويتو

180
00:14:25,250 --> 00:14:27,970
.أنت مُستبعد من مهمّة أساهيكاوا

181
00:14:31,330 --> 00:14:32,650
...من الآن فصاعدًا

182
00:14:34,570 --> 00:14:37,810
.ستساعدني في مطاردة السجناء الآخرين

183
00:14:45,890 --> 00:14:48,190
.قال أنّه سيبذل جهده

184
00:14:49,540 --> 00:14:51,450
.يا للإزعاج

185
00:14:51,450 --> 00:14:56,250
هل أنت واثق أنّ أوغاتا هياكونوسكي
هو من كان على متن المنطاد

186
00:14:56,250 --> 00:14:59,410
مع شيرايشي وسوغيموتو؟

187
00:15:00,340 --> 00:15:01,330
.نعم

188
00:15:02,370 --> 00:15:05,590
إنّه يجلب العار لانتحار والد
،أوغاتا النبيل، هانازاوا كوجيرو

189
00:15:05,590 --> 00:15:09,590
.قائد القسم السابع السابق

190
00:15:10,870 --> 00:15:14,070
حتّى أبي يشعر بعدم ثقة كبيرة تجاه
القيادة المركزية على الطريقة

191
00:15:14,070 --> 00:15:19,020
.التي لاموا بها القسم السابع على انتحار الفريق هانازاوا

192
00:15:19,020 --> 00:15:21,190
فما الذي يفكّر فيه أوغاتا؟

193
00:15:21,190 --> 00:15:26,550
وُلد والد الملازم الثاني كويتو في
ساتسوما مثل الفريق هانازاوا

194
00:15:26,550 --> 00:15:28,930
وكانا صديقين، صحيح؟

195
00:15:30,490 --> 00:15:33,960
سبب الانتحار كان لوم القيادة المركزية الكامل

196
00:15:33,960 --> 00:15:38,870
.للفريق هانازاوا على عدد الضحايا الكبير في تلة 203

197
00:15:38,870 --> 00:15:42,880
اعتقدت بالطّبع أنّ أوغاتا هياكونوسكي سيقاتل

198
00:15:42,880 --> 00:15:48,120
...من أجل شرف أبيه ومن أجل القسم السابع، لكن

199
00:15:52,690 --> 00:15:58,970
كان أبي حينها مقدّمًا في فرقة
.الحرس الإمبراطوري الأولى

200
00:15:59,370 --> 00:16:00,960
،نظرًا لمركزه

201
00:16:00,960 --> 00:16:05,650
.لا بدّ أنّه كان منزعجًا لأنّ أساكوسا غيشا حامل بابنه

202
00:16:06,290 --> 00:16:09,370
،عندما أنجبت زوجته ولدًا

203
00:16:09,370 --> 00:16:13,660
.أخبرتني جدّتي أنّه توقّف عن المجيء كلّيًا

204
00:16:14,120 --> 00:16:17,000
،أخذت جدّتي أمي وأخذتني وأنا لا أزال رضيعًا

205
00:16:17,000 --> 00:16:19,660
.إلى منزلها في إيباراكي

206
00:16:20,340 --> 00:16:23,700
.كانت أمّي تعدّ حساء سمك أنكو

207
00:16:23,700 --> 00:16:26,840
.يقولون فوغو في الغرب وأنكو في الشرق

208
00:16:27,150 --> 00:16:29,750
.كان طبقًا محليًّا لذوي الطبقة الدنيا

209
00:16:29,750 --> 00:16:31,700
.أحببته، فكنت آكل الكثير منه

210
00:16:32,660 --> 00:16:36,340
.لكنّي تناولته كلّ يوم

211
00:16:36,850 --> 00:16:41,270
...كلّ يوم في الشتاء، كانت أمي

212
00:16:42,070 --> 00:16:44,730
.تحاول إعداد حساء أنكو...

213
00:16:45,450 --> 00:16:50,640
.قال أبي أنّه يحبّه، لذا ظنّت أنّه قد يعود لتناوله

214
00:16:50,640 --> 00:16:53,410
...كلّ يوم

215
00:16:54,400 --> 00:16:57,370
.كانت قد جُنّت

216
00:17:01,720 --> 00:17:06,650
أخذت بندقيّة قديمة كانت عند
.جدّي واصطدت بها طائرًا

217
00:17:11,330 --> 00:17:16,230
،ظننت أنّي إن أحضرته إلى المنزل
.فقد لا تعدّ أمي حساء أنكو

218
00:17:18,070 --> 00:17:24,250
لكن مهما كان عدد الطيور التي
.اصطدتها، تابعت إعداد حساء أنكو

219
00:17:26,230 --> 00:17:27,970
...لذلك السبب

220
00:17:29,230 --> 00:17:31,940
،في غياب جدي وجدّتي

221
00:17:32,390 --> 00:17:36,420
.وضعت سمّ فئران في حساء الأنكو وأطعمته لها

222
00:17:40,230 --> 00:17:46,750
ظننت أنّ أبي سيأتي للجنازة
.إن بقي له أيّ حبّ تجاه أمي

223
00:17:47,700 --> 00:17:52,410
.في النّهاية سترى الرّجل الذي أحبّته

224
00:17:55,330 --> 00:17:56,380
...لكن

225
00:17:59,160 --> 00:18:01,350
.لم تأتِ أبدًا

226
00:18:01,850 --> 00:18:06,450
.لا تقل لي أنّك تفعل هذا كرهًا لتخليّ عنكما

227
00:18:08,050 --> 00:18:11,920
،أشفقت على أمّك

228
00:18:11,920 --> 00:18:13,940
.لكنّك سئمت منها أيضًا

229
00:18:14,530 --> 00:18:16,860
!مثلي تمامًا

230
00:18:17,250 --> 00:18:20,630
.لا يختار الأطفال آباءهم

231
00:18:21,210 --> 00:18:26,590
.الحب مفهوم مبهم مثل الإله

232
00:18:26,590 --> 00:18:31,750
لكن لو بقي لديك أيّ حبّ
.نحو أمي، لما تخلّيت عنها

233
00:18:32,810 --> 00:18:36,630
...ربما عندما يولد ابن لوالدين ينقصهما الحبّ

234
00:18:37,260 --> 00:18:41,080
.يفتقد شيئًا ما...

235
00:18:41,080 --> 00:18:44,180
.مهما كان كانت عظمة سلاسة أبيه

236
00:18:45,960 --> 00:18:49,190
،حقيقة أنّ الملازم الثاني هانازاوا يوساكو

237
00:18:49,970 --> 00:18:55,650
.الابن الذي أنجبته من زوجتك رجل نبيل تؤكّد ذلك

238
00:18:56,130 --> 00:18:58,400
،التقيته بعد انضمامي للجيش

239
00:18:58,400 --> 00:19:00,070
.ولم أعرف كيف أتصرّف

240
00:19:00,850 --> 00:19:07,160
.ناداني بأخي الكبير مهما قلت له أنّ رتبته أعلى مني

241
00:19:07,520 --> 00:19:13,290
.لم يتركني أبدًا. قال أنّه كبر وهو يريد أخًا دائمًا

242
00:19:14,250 --> 00:19:16,490
...تلك الابتسامة البريئة

243
00:19:19,190 --> 00:19:23,340
...جعلتني أدرك أنّه كان طفلاً

244
00:19:24,220 --> 00:19:27,220
.كبر محبوبًا من قِبل والديه...

245
00:19:27,770 --> 00:19:33,400
بالمناسبة، لم يكن لأبيه أيّ طريقة ليعرف حقيقة

246
00:19:34,490 --> 00:19:38,440
.موت الملازم الثاني هانازاوا يوساكو في تلة 203

247
00:19:46,410 --> 00:19:49,770
.أطلقت النار على مؤخرة رأسه

248
00:19:51,030 --> 00:19:54,270
،ليس بداعي الغيرة منه

249
00:19:54,270 --> 00:19:58,760
.أو حتّى لرغبة في جعل أبيه يعاني

250
00:19:59,490 --> 00:20:03,090
...أردت التّحقّق من شيء فقط

251
00:20:03,650 --> 00:20:10,180
عندما يسمع خبر موت
،يوساكو-سان، هل سيفكّر الأب فيّ

252
00:20:11,010 --> 00:20:16,900
أو ربّما يهتمّ أكثر فجأة للابن
الآخر الذي أنجبه من عشيقته؟

253
00:20:21,650 --> 00:20:25,940
أكانت هناك أيّة فرصة لي لأكون سعيدًا أيضًا؟

254
00:20:34,250 --> 00:20:36,380
...معك حقّ

255
00:20:37,330 --> 00:20:41,880
!أنت تفتقد شيئًا. أنت ابن فاشل

256
00:20:43,940 --> 00:20:45,540
!اللعنة عليك

257
00:21:08,980 --> 00:21:14,790
.سيحمل كبار الجيشِ القسمَ السابع مسؤولية انتحاره

258
00:21:14,790 --> 00:21:19,250
.سيكون وقتًا عصيبًا علينا، لكن عليك التّحمّل

259
00:21:19,700 --> 00:21:24,370
!سيصبح القسم السابع أقوى بكثير بوجود عدوٍّ خارجيّ

260
00:21:24,370 --> 00:21:30,470
.سيحوّل القسم السابع ابن المقدم هانازاوا الناجي إلى بطل

261
00:21:30,470 --> 00:21:34,350
!سيروا فيك إله الحرب الذي فقدوه

262
00:21:34,350 --> 00:21:38,440
.أحسنت يا أوغاتا هياكونوسكي

263
00:21:41,730 --> 00:21:44,150
.أسحنت

264
00:21:46,740 --> 00:21:48,570
.غاوٍ لعين

265
00:23:35,990 --> 00:23:39,330
.الحلقة القادمة: عينان زرقاوان