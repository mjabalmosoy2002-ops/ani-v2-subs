1
00:01:40,990 --> 00:01:45,000
أبطال غير متناغمين

2
00:01:41,530 --> 00:01:43,910
استخدمتُ التّصوير الحراريّ من
القمر الاصطناعيّ

3
00:01:44,150 --> 00:01:47,460
المتلصّص شوجي للتّحقّق من عدد
.الوحوش داخل مخبأ العدوّ

4
00:01:47,460 --> 00:01:50,300
تُظهر القراءات الحراريّة
.وجود نحو 500 وحش

5
00:01:50,370 --> 00:01:54,010
وبحسابٍ بسيط، فهذا يعني أنّ على كلّ
.واحدٍ منّا القضاء على أكثر من 60 وحشًا

6
00:01:54,210 --> 00:01:57,310
يبقى القلق الأكبر هو قوّة
.الوحوش عالية المستوى

7
00:01:57,370 --> 00:01:59,640
فبعد أن تبيّن أنّ الحريش العظيم
الّذي ظهر مؤخرًا

8
00:01:59,640 --> 00:02:02,610
،يعمل هو الآخر مع جمعيّة الوحوش

9
00:02:02,710 --> 00:02:05,390
ينبغي أن نفترض أنّ لديهم عدّة وحوش

10
00:02:05,390 --> 00:02:07,890
.ذات تهديد من مستوى شيطان أو حتّى تنّين

11
00:02:07,890 --> 00:02:12,910
،كنتُ أحرس المقرّ الرّئيسيّ
.لذلك قاتلتُ طفيليًّا واحدًا

12
00:02:12,970 --> 00:02:15,330
ماذا عنكم أنتم يا من قاتلتم هناك؟

13
00:02:15,430 --> 00:02:16,860
هل كانوا أقوياء؟

14
00:02:16,860 --> 00:02:19,160
.يبدو أنّ مستوياتهم كانت مختلفة

15
00:02:19,400 --> 00:02:22,810
،لم يكن معظمهم من مستوى يُذكر
لكنّ البعض منهم كان لا يُستهان به

16
00:02:22,810 --> 00:02:25,330
.وحتّى أنا واجهتُ صعوبة معهم

17
00:02:25,330 --> 00:02:27,000
"تصدّع"

18
00:02:25,330 --> 00:02:30,290
بعد أن تعلّمتُ الآن أن أتقبّل
.الألم، فلن تكون هنالك مشكلة

19
00:02:30,290 --> 00:02:33,340
أصحيح أنّه تمّت الإطاحة بالفارس المندفع؟

20
00:02:33,490 --> 00:02:34,630
...لا أدري

21
00:02:34,830 --> 00:02:37,210
قام بتعذيب وحش وكان أوّل من اكتشف

22
00:02:37,210 --> 00:02:41,520
،أنّ مخبأهم كان في المدينة زد
.لذلك ذهب للتّحقّق من الأمر

23
00:02:41,630 --> 00:02:44,100
.لكنّنا لم نسمع عنه أيّ شيء مذّاك الحين

24
00:02:44,100 --> 00:02:46,430
.هكذا إذًا. تمّت الإطاحة به

25
00:02:46,670 --> 00:02:49,440
،إنّ لديه جسد سايبورغ

26
00:02:49,440 --> 00:02:51,700
.لذلك لا يعني أنّه قد مات بالضّرورة

27
00:02:52,010 --> 00:02:55,270
ربّما دُمّرت أجزاؤه، ولا يستطيع
،التّحرّك أو إرسال إشارة

28
00:02:55,270 --> 00:02:57,830
لذلك فهو يتوارى عن الأنظار
.منتظرًا أن يتمّ إنقاذه

29
00:02:58,390 --> 00:03:00,040
...لنأمل ذلك

30
00:03:00,910 --> 00:03:05,500
وهذا يعني أنّ أيّ واحدٍ منّا قد يلقى
.المصير نفسه الّذي لقيه الفارس المندفع

31
00:03:05,730 --> 00:03:07,440
.لذلك لا ترخوا دفاعاتكم

32
00:03:07,440 --> 00:03:08,790
.ابقوا متأهّبين

33
00:03:08,790 --> 00:03:11,670
.أشكّ أنّ بإمكانهم هزيمتي

34
00:03:11,670 --> 00:03:15,180
سيضربون ضربتهم بلا أيّ رحمة
.بمجرّد أن تقع أعينهم علينا

35
00:03:15,330 --> 00:03:16,710
...وبطبيعة الحال

36
00:03:16,710 --> 00:03:21,050
،حتّى إن حاول وحش التّفاوض
.فلسنا بحاجة للاستجابة له

37
00:03:21,050 --> 00:03:24,550
.نعم. سيُودي إظهار الرّحمة إلى هلاكنا

38
00:03:24,550 --> 00:03:27,100
هلّي أن أقول شيئًا؟
بين أفراد جمعيّة الوحوش

39
00:03:27,100 --> 00:03:31,020
.شُبّانٌ خُدعوا وحُوِّلوا إلى وحوش

40
00:03:31,390 --> 00:03:33,400
.أريد أن أنقذ هؤلاء الشُّبّان

41
00:03:33,600 --> 00:03:37,490
،إذا رأيتم وحوشًا بثياب السّجن
.اتركوهم لي أتولّى أمرهم

42
00:03:37,730 --> 00:03:40,490
تحوّل أحد أصدقائي القدامى
،هو الآخر إلى وحش

43
00:03:40,490 --> 00:03:42,450
.ولم يكن أمامي خيار سوى أن أجهز عليه

44
00:03:42,770 --> 00:03:45,950
هل هناك أيّ سبيل لإنقاذ
من تمّ تحويلهم لوحوش؟

45
00:03:45,950 --> 00:03:49,250
أنوي أن أجرّب مزيجًا من عناق
الملاك وقبلة الإيقاظ العميقة

46
00:03:49,250 --> 00:03:51,950
.لعلّه يعيدهم إلى وعيهم

47
00:03:51,950 --> 00:03:54,370
.فهمت... حسنًا... أعتذر على السّؤال

48
00:03:54,370 --> 00:03:55,960
.لنعد إلى صلب موضوعنا

49
00:03:55,960 --> 00:03:59,710
،إنّ الزّعيم، ملك الوحوش أوروتشي
،والمخطِّط غيورو-غيورو

50
00:03:59,710 --> 00:04:01,920
.هما بلا شكّ ذوا تهديد من المستوى تنّين

51
00:04:01,920 --> 00:04:06,650
نعم، إنّهما قويّان بما يكفي لقيادة
.هذا العدد من الوحوش

52
00:04:06,750 --> 00:04:09,890
لذا علينا تجنّب القتال
.الفرديّ معهما ما أمكن

53
00:04:09,890 --> 00:04:12,820
.حسنًا، سأطيح بالزّعيم النّهائيّ

54
00:04:12,930 --> 00:04:17,770
بإمكانكم أنتم تولّي أمر الضّعفاء
الّذين يعترضون طريقي، مفهوم؟

55
00:04:17,930 --> 00:04:19,610
.لا تأخذي قرارات نيابة عن الجميع

56
00:04:19,610 --> 00:04:21,820
أتقول أنّك تريد قتال الزّعيم الأخير؟

57
00:04:21,820 --> 00:04:24,700
.أخرسوها. لا فائدة من هذا –
.أنا أقوم بهذا لأجلكم أيّها الضّعفاء –

58
00:04:24,700 --> 00:04:26,250
...مهلاً، مهلاً كلاكما

59
00:04:26,820 --> 00:04:29,370
.لهذا السّبب أكره إدارة أبطال الرّتبة س

60
00:04:29,370 --> 00:04:32,920
.لسنا هنا لتحسين حركة المرور

61
00:04:33,240 --> 00:04:36,080
.هذه مهمّة إنقاذ رهينة

62
00:04:36,080 --> 00:04:38,000
.وصيد الوحوش مجرّد مكافأة إضافيّة

63
00:04:38,330 --> 00:04:41,210
.لا تنسي ذلك أيّتها الإعصار

64
00:04:41,210 --> 00:04:44,810
من الأفضل ألاّ تطلقي هجومًا
.قد يدمّر المخبأ بأكمله

65
00:04:45,880 --> 00:04:48,150
.الأنفاق التّحأرضيّة واسعة وعميقة

66
00:04:48,300 --> 00:04:49,600
حتّى تحرّياتي

67
00:04:53,810 --> 00:04:56,810
إن صادفتم شيئًا سواء كان
،الوحوش العاديّة أو الزّعيم

68
00:04:56,810 --> 00:04:58,160
.فلا يمكن تفادي القتال معهم

69
00:04:58,350 --> 00:05:01,030
.على أيّ أحد يلتقي بهم أن يقضي عليهم

70
00:05:03,990 --> 00:05:06,000
لتمكّنّا من تنفيذ العمليّة
.بعدد أقلّ بكثير من الأفراد

71
00:05:06,150 --> 00:05:10,080
لماذا في رأيك انتظرنا حتّى يجتمع الجميع؟

72
00:05:10,480 --> 00:05:13,920
كان ينبغي أن يكون ذلك واضحًا
...لو فكّرت قليلاً

73
00:05:14,410 --> 00:05:16,420
،وبدل أن تعتمدي دائمًا على قواك الذّهنيّة

74
00:05:16,420 --> 00:05:18,630
ما رأيك أن تستخدمي عقلك بين الحين والآخر؟

75
00:05:18,630 --> 00:05:21,390
!توقّف، توقّف! هذا يكفي

76
00:05:21,950 --> 00:05:22,800
.عفوًا

77
00:05:23,120 --> 00:05:26,420
يا هؤلاء... كنتُ أتساءل لماذا
.لم تكونوا في غرفة الانتظار

78
00:05:26,420 --> 00:05:29,640
أنا ضمن الفريق، ومع ذلك أنتم هنا
.تقيمون اجتماعًا سرّيًّا بدوني

79
00:05:29,640 --> 00:05:30,760
ما معنى هذا؟

80
00:05:30,760 --> 00:05:32,310
!أماي ماسك

81
00:05:33,170 --> 00:05:36,320
.لم نكن نحاول إقصاءك أو أيّ شيء من هذا القبيل

82
00:05:36,390 --> 00:05:38,530
أردنا في البداية أن نناقش
.المسألة بين أبطال الفئة س

83
00:05:38,600 --> 00:05:40,200
لماذا الفئة س فقط؟

84
00:05:40,600 --> 00:05:43,230
هناك أعضاء آخرون في الفريق غيري، صحيح؟

85
00:05:43,230 --> 00:05:44,540
...إنّ ذلك

86
00:05:44,850 --> 00:05:48,210
سيُكلَّف جميع من هم دون الفئة س
.بدعم العمليّات على السّطح

87
00:05:48,360 --> 00:05:53,590
كنتُ أعرف أنّه سيعترض، لذلك
.كنتُ سأخبره في اللّحظة الأخيرة

88
00:05:54,030 --> 00:05:58,550
كيف يمكنني شرح الأمر له
من دون أن أجرح كبرياءه؟

89
00:05:58,750 --> 00:06:01,340
.لماذا؟ لأنّنا نكرهك جميعًا

90
00:06:01,340 --> 00:06:02,500
.كلاّ، كلاّ

91
00:06:02,500 --> 00:06:05,130
!إنّك تجعلين الوضع أسوأ أيّتها الإعصار

92
00:06:05,580 --> 00:06:08,910
أنا مكلّف بالتّأهّب على السّطح؟
هلاّ شرحت أكثر؟

93
00:06:08,910 --> 00:06:12,810
،نعم. سيتوجّه فريق الهجوم تحت الأرض

94
00:06:12,810 --> 00:06:15,570
.وسيبقى فريق الدّعم فوقها
.سننقسم إلى فريقين

95
00:06:15,630 --> 00:06:18,850
،أردنا الاستفادة من مهاراتك القياديّة

96
00:06:18,850 --> 00:06:22,020
وأن تتولّى قيادة فريق الدّعم
.يا أماي ماسك

97
00:06:22,020 --> 00:06:24,990
.سنكون الوحيدين الّذين سيهاجمون تحت الأرض

98
00:06:25,140 --> 00:06:27,650
.وستتعاملون أنتم مع أيّ وحش نتركه خلفنا

99
00:06:27,900 --> 00:06:30,720
.لكنّي سأحضر تلاميذي معي

100
00:06:30,720 --> 00:06:32,670
.عشرون بيتزا أخرى لو سمحت

101
00:06:32,780 --> 00:06:35,540
.لا تملأ معدتك قبل القتال –
.حاضرة. في الحال –

102
00:06:35,540 --> 00:06:37,450
.تناول البروتين بدل ذلك أيّها الإله الخنزير

103
00:06:37,650 --> 00:06:40,410
كلاّ. لا يمكنني أن أثق بأنّكم
.ستتولّون الأمر بمفردكم

104
00:06:40,410 --> 00:06:41,830
.سأذهب أيضًا

105
00:06:41,830 --> 00:06:43,420
.عرفتُ أنّه سيقول ذلك

106
00:06:43,420 --> 00:06:45,750
هل عليّ أن أشرح الأمر لك بالتّفصيل؟

107
00:06:45,750 --> 00:06:49,210
.هذا القتال أعلى بكثير من مستواك

108
00:06:49,210 --> 00:06:50,550
!لن تشارك معنا

109
00:06:50,550 --> 00:06:52,590
.أيّها الإمبراطور الطّفل، لا يبدو أنّك تفهم

110
00:06:52,590 --> 00:06:55,430
!مهلاً! لا تتجاهلني –
...إن كنت تريد استخدام مهاراتي القياديّة –

111
00:06:55,430 --> 00:06:58,190
فعلى أبطال الفئة س أن يكونوا
.تحت إمرتي إذًا

112
00:06:58,560 --> 00:07:00,810
نحن تحت إمرتك أنت؟ –
!تتظاهرون أنّكم لا تسمعوني؟ –

113
00:07:00,810 --> 00:07:02,650
.اسمك وحده يبعث على السّخرية

114
00:07:03,060 --> 00:07:06,310
تريد نيل الفضل فحسب؟
.ادّعي أنّك صاحب إنجازاتي

115
00:07:06,310 --> 00:07:08,260
.لكن اتّبع أوامر الإمبراطور الطّفل

116
00:07:08,260 --> 00:07:10,450
.هذا ليس الوقت المناسب لعرقلة بعضنا

117
00:07:10,520 --> 00:07:11,570
!هذا صحيح

118
00:07:11,570 --> 00:07:14,580
لا يجب عليك التّظاهر بالقوّة
!قبل المعركة يا غبيّ

119
00:07:14,690 --> 00:07:17,380
.سنخرج لمواجهة جيش من الوحوش

120
00:07:17,860 --> 00:07:20,010
هذا ليس الوقت المناسب
.لاعتراض طريق بعضنا

121
00:07:20,110 --> 00:07:23,130
أيّها الرّجل الزّومبي، لماذا أنت خالد؟ –
!رائحتك كريهة! غيّر اسمك –

122
00:07:23,130 --> 00:07:24,170
.إنّ ذلك مريب

123
00:07:24,490 --> 00:07:27,220
.ربّما تكون وحشًا بالفعل

124
00:07:27,410 --> 00:07:28,510
ماذا قلت؟

125
00:07:28,510 --> 00:07:33,300
إنّك مصنّف من الفئة س بسبب
،قدراتك القتاليّة فقط

126
00:07:33,300 --> 00:07:35,600
.لكنّ هويّتك الحقيقيّة محلّ شكّ

127
00:07:35,750 --> 00:07:38,930
هل يمكننا فعلاً أن نثق بتواجدك إلى جانبنا؟

128
00:07:39,220 --> 00:07:42,340
.مهلاً، كفّ عن الضّغط عليه

129
00:07:42,340 --> 00:07:44,740
هذا ليس صائبًا. لا يجدر بالأبطال
.أن يتقاتلوا فيما بينهم

130
00:07:44,980 --> 00:07:47,660
صحيح، يفترض أن تكون بطلاً
...محترفًا، ومع ذلك

131
00:07:47,720 --> 00:07:48,780
ماذا هنالك؟

132
00:07:48,780 --> 00:07:53,490
،إن كان لديك مشكلة
.انس المعركة وعد لغنائك

133
00:07:53,660 --> 00:07:56,830
تتصرّفون أنتم أبطال الفئة س
.وكأنّكم فوق الجميع

134
00:07:56,830 --> 00:07:58,430
.تجاوز غروركم الحدود كثيرًا

135
00:07:58,430 --> 00:08:00,800
.لديكم سمعة سيّئة في الجمعيّة

136
00:08:01,200 --> 00:08:03,920
.لا يبدو أنّكم تبذلون ما في وسعكم

137
00:08:04,120 --> 00:08:07,320
.و5 لترات من الكولا لو سمحت

138
00:08:07,320 --> 00:08:10,840
أنسيتم المسؤوليّة الّتي ترافق
امتلاككم للقوّة؟

139
00:08:10,840 --> 00:08:11,970
!مهلاً لحظة

140
00:08:11,970 --> 00:08:14,380
لماذا تعمل كمعبود جماهير
إلى جانب عملك كبطل إذًا؟

141
00:08:14,380 --> 00:08:15,510
.هذا سخيف

142
00:08:15,510 --> 00:08:18,420
،تصف نفسك بالقناع الوسيم
!لكنّك لستَ بتلك الوسامة من الأساس

143
00:08:18,420 --> 00:08:19,800
أتفهم كلامي؟

144
00:08:19,800 --> 00:08:21,270
.ا-اهدئي

145
00:08:21,470 --> 00:08:24,190
،إن أغضبتِ أماي ماسك
.فستكون وسائل الإعلام لك بالمرصاد

146
00:08:24,190 --> 00:08:25,060
.ستكون مشكلة كبيرة

147
00:08:25,350 --> 00:08:30,120
أنتم يا أبطال الفئة س موجودين فقط
.لأنّكم موضوعون تحت السّيطرة

148
00:08:30,180 --> 00:08:34,250
ولولا ذلك، لكنتم مجرّد أفراد
.خطرين ذوي قوّة قتاليّة هائلة

149
00:08:34,350 --> 00:08:37,110
.لهذا سأُحسن استغلالكم هذه المرّة

150
00:08:37,110 --> 00:08:38,790
.اتّبعوا أوامري

151
00:08:40,690 --> 00:08:44,260
.علاقة سيّدٍ وخادم مع شابٍّ وسيمٍ حازم

152
00:08:44,530 --> 00:08:46,540
...هذا ليس سيّئًا، لكنّه مقلق

153
00:08:46,540 --> 00:08:49,340
لِمَ لا تحاول إخضاعنا بالقوّة؟

154
00:08:49,500 --> 00:08:50,800
.إن كنت تظن أنّك تستطيع

155
00:08:51,870 --> 00:08:54,050
أتظنّ أنّني لا أستطيع؟

156
00:08:56,510 --> 00:08:58,640
.مهلاً، هذا ليس وقت المزاح

157
00:08:58,640 --> 00:09:00,470
.أوقف نظراتك القاتلة تلك أيّها الوميض

158
00:09:00,470 --> 00:09:01,970
.الأمر عائد إليه

159
00:09:01,970 --> 00:09:03,890
...إن تدخّل وعطّل العمليّة

160
00:09:03,890 --> 00:09:05,650
!وصل السّيّد كينغ

161
00:09:06,690 --> 00:09:11,160
"هدير"

162
00:09:13,730 --> 00:09:15,500
!أستكون تحت إمرتي أيضًا...؟

163
00:09:15,690 --> 00:09:18,870
لماذا أنت متّسخ هكذا؟
.ورائحتك مقرفة

164
00:09:18,870 --> 00:09:23,050
صحيح، تمّ إحضاري إلى هنا
،بمجرّد وصولي للمنزل

165
00:09:23,110 --> 00:09:24,800
.لذلك لم تكن لديّ فرصة لتغيير ملابسي

166
00:09:25,160 --> 00:09:27,830
.كلاّ، سيترك هذا بقعة على الملابس

167
00:09:27,830 --> 00:09:30,840
لماذا تأخّرت؟ أين كنت؟

168
00:09:30,910 --> 00:09:32,600
كيف صار حالك هكذا؟

169
00:09:32,660 --> 00:09:34,060
هل يستجوبني؟

170
00:09:34,160 --> 00:09:36,560
.لم أحبّ هذا الرّجل أبدًا

171
00:09:36,710 --> 00:09:40,900
.إنّه ليس أمرًا يستحقّ الذّكر على الإطلاق

172
00:09:41,460 --> 00:09:43,110
...كنتُ في المدينة زد

173
00:09:43,380 --> 00:09:44,810
...أتناول –
...كان السّيّد كينغ –

174
00:09:44,810 --> 00:09:48,900
يقاتل وحيدًا قرب مخبأ العدوّ
!في المدينة زد طوال اللّيل

175
00:09:48,900 --> 00:09:49,810
عفوًا؟

176
00:09:49,810 --> 00:09:51,950
.البقع الّتي على ملابسه من دماء الوحوش

177
00:09:52,100 --> 00:09:55,120
.وكدليل، لا توجد البقع إلاّ في الأمام

178
00:09:55,190 --> 00:09:59,160
ولأنّهم فاقوه عددًا، استنزف قوّته
.وكان عليه التّراجع

179
00:09:59,160 --> 00:10:01,660
!وحينها وجدناه ورافقناه إلى هنا

180
00:10:01,660 --> 00:10:05,700
لماذا يفهم هؤلاء الأشخاص الوضع بشكل
خاطئ دائمًا ويخبرون به الجميع؟

181
00:10:05,700 --> 00:10:08,970
...يقاتل بلا توقّف... وحده

182
00:10:10,530 --> 00:10:11,920
.مثير للاهتمام

183
00:10:12,590 --> 00:10:16,850
.حزمك، وجرأتك الّتي لا تعرف الخوف

184
00:10:17,120 --> 00:10:18,910
.عليّ الاعتراف

185
00:10:18,910 --> 00:10:21,310
.يبدو أنّ هنالك بعض أبطال الفئة س المحترمين

186
00:10:21,500 --> 00:10:23,310
.تخاصُمُنا فيما بيننا لا طائل منه

187
00:10:23,590 --> 00:10:25,890
...ومن أجل كينغ، سأتراجع

188
00:10:28,220 --> 00:10:29,850
،لكنّني ما زلتُ ضمن فريق الهجوم

189
00:10:29,850 --> 00:10:31,000
.وهذا غير قابل للنّقاش

190
00:10:31,000 --> 00:10:33,450
.مذهل. إنّه لا يتراجع مطلقًا

191
00:10:34,180 --> 00:10:39,820
.لا يمكنك مواجهة العدوّ وحدك يا كينغ –
...كلاّ، أنا –

192
00:10:39,820 --> 00:10:44,280
قام الفارس المندفع بنفس الشّيء
وذهب للتّحقيق في أمر المدينة المهجورة

193
00:10:44,280 --> 00:10:46,210
.وانقطع الاتصال به تمامًا منذ ذلك الحين

194
00:10:46,900 --> 00:10:50,010
من يدري أيّ تهديد قد يكون كامنًا هناك؟

195
00:10:50,120 --> 00:10:51,590
.فلنقاتل جميعًا معًا

196
00:10:53,870 --> 00:10:54,850
!...أكيد

197
00:11:02,470 --> 00:11:04,430
.لقد تجمّع فريق الدّعم

198
00:11:04,760 --> 00:11:06,060
.حان وقت الانطلاق

199
00:11:08,630 --> 00:11:10,350
.هذه لحظة حاسمة

200
00:11:10,350 --> 00:11:11,400
.نعم

201
00:11:14,010 --> 00:11:16,480
.بصفتي المسؤول عنها، سأشهد نهايتها بنفسي

202
00:11:16,730 --> 00:11:20,290
قلّلتُ من شأنك. من كان يتوقّع
.أن تكون بهذا القدر من الصّلابة

203
00:11:20,600 --> 00:11:23,620
.ظننتك مدفوعًا فقط بطموح التّرقية

204
00:11:24,320 --> 00:11:25,920
.لستَ مخطئًا تمامًا

205
00:11:25,980 --> 00:11:29,450
...ستضمن لي هزيمة جمعيّة الوحوش ترقية

206
00:11:32,200 --> 00:11:34,430
.وسيُكتب اسمي في التّاريخ

207
00:11:40,790 --> 00:11:43,730
.شكرًا لكم جميعًا على الحضور
.أنا سيكينغال

208
00:11:44,340 --> 00:11:45,590
.وأنا سيتش

209
00:11:45,590 --> 00:11:48,970
هل الجميع على دراية بمهمّة اليوم؟

210
00:11:48,970 --> 00:11:53,520
!نعم! احتفاليّة اليوم هي دعم أبطال الفئة س

211
00:11:53,520 --> 00:11:55,110
...نـ... نعم

212
00:11:55,220 --> 00:11:56,620
احتفاليّة؟

213
00:11:57,720 --> 00:12:01,400
وتحديدًا، ستتولّون القضاء على
،أيّ وحوش استطاعت التّسلّل

214
00:12:01,400 --> 00:12:04,160
.وتأمين طُرق إخلاء آمنة، وحماية الطّفل

215
00:12:04,160 --> 00:12:07,530
وبعد أن يقتحم أبطال الفئة س
،المقرّ وينقذوا الرّهينة

216
00:12:07,530 --> 00:12:09,840
.ستقومون بمرافقته بسلام إلى مقرّ جمعيّة الأبطال

217
00:12:09,950 --> 00:12:12,160
.هذه هي المهمّة الأهمّ

218
00:12:12,320 --> 00:12:13,720
هلّي أن أقول شيئًا؟

219
00:12:13,820 --> 00:12:14,770
وما هو؟

220
00:12:14,770 --> 00:12:18,040
نحن نغامر بأعناقنا في قلب أراضي العدوّ

221
00:12:18,040 --> 00:12:20,140
.دون أن نعرف ما ينتظرنا

222
00:12:25,340 --> 00:12:26,980
.وإلاّ فلا يستحقّ الأمر المخاطرة

223
00:12:28,460 --> 00:12:30,260
.لا بأس. أعد بذلك

224
00:12:30,260 --> 00:12:31,860
!أجل

225
00:12:32,520 --> 00:12:33,780
ما رأيك يا سيتش؟

226
00:12:33,890 --> 00:12:37,480
يبدو أنّ حماة البشريّة أقوى
من أيّ وقتٍ مضى، أليس كذلك؟

227
00:12:37,480 --> 00:12:39,120
...نـ... نعم

228
00:12:39,220 --> 00:12:40,740
...المعذرة يا سيّد سيتش

229
00:12:43,190 --> 00:12:44,160
!ماذا؟

230
00:12:48,370 --> 00:12:52,710
مرحبًا يا سيتش. أسقطتُ جهاز
.اتّصالي في مكانٍ ما

231
00:12:52,860 --> 00:12:55,260
أنا آسف، هل يمكنني الحصول
على واحد جديد؟

232
00:12:55,500 --> 00:12:59,140
.هـ-هكذا إذًا. مفهوم. سأُحضره لك حالاً

233
00:12:59,540 --> 00:13:01,640
.تذكّر يا سيتش

234
00:13:01,710 --> 00:13:03,840
أعِده من حيث أتى من دون
.أن تخبره بأيّ شيء

235
00:13:04,170 --> 00:13:07,450
...وبخصوص مخبأ غارو

236
00:13:07,450 --> 00:13:09,600
هل حصلتم على أيّ معلومات جديدة؟

237
00:13:09,710 --> 00:13:13,230
.أعتقد أنّه ما زال بين جماعة الوحوش

238
00:13:13,230 --> 00:13:16,240
.لا، لا شيء جديد

239
00:13:16,680 --> 00:13:17,950
.فهمت

240
00:13:18,310 --> 00:13:19,360
.أيّها النّاب الفضّيّ

241
00:13:20,190 --> 00:13:22,990
لِمَ تركتَ غارو يفرّ؟

242
00:13:23,440 --> 00:13:26,160
أتدخّل وحشٌ بالفعل؟

243
00:13:26,440 --> 00:13:29,880
أتعني أنّني تركتُه يهرب عمدًا؟

244
00:13:31,120 --> 00:13:35,080
،آسف... هناك أمور كثيرة تحدث
.وقد اختلط عليّ الأمر قليلاً

245
00:13:35,320 --> 00:13:38,680
سأطلب من أحد الموظّفين
.أن يجلب لك جهاز اتّصال جديد

246
00:13:38,830 --> 00:13:40,640
.انتظر هنا رجاءً

247
00:13:43,210 --> 00:13:44,970
.إنّهم لا يثقون بك

248
00:13:45,210 --> 00:13:49,260
.ربّما يظنّون أنّك تهاونت ولم تُجهز عليه

249
00:13:49,260 --> 00:13:51,520
.لم أتهاون معه على الإطلاق

250
00:13:52,710 --> 00:13:55,030
.جيّد. لا يبدو أنّ أحدًا يتبعني

251
00:13:55,180 --> 00:13:57,780
.سأختبئ في هذه الغرفة مؤقّتًا

252
00:13:57,890 --> 00:14:00,190
لكن كيف سأخرج من هنا؟

253
00:14:00,190 --> 00:14:01,570
ما الّذي تفعله؟

254
00:14:02,150 --> 00:14:03,980
ولماذا أنت هنا يا بانغ؟

255
00:14:03,980 --> 00:14:08,110
كان لديّ بعض الأمور لأتعامل
معها. ماذا تفعل أنت هنا؟

256
00:14:08,360 --> 00:14:10,990
،كان هناك استدعاءٌ طارئ لأبطال الفئة س

257
00:14:10,990 --> 00:14:13,000
...فأحضروني إلى هنا أيضًا

258
00:14:13,280 --> 00:14:16,050
.ماذا؟ لم يخبرني أحد

259
00:14:16,360 --> 00:14:19,630
كلاّ... لم يكن يُفترض بي
...أن أخبر بانغ بهذا

260
00:14:19,870 --> 00:14:23,850
هيّا... لقد تشاركنا أنا وأنت
.وجبة قدر ساخن

261
00:14:23,910 --> 00:14:25,310
.أخبرني بما لديك

262
00:14:26,840 --> 00:14:29,850
.تأخّر كينغ كثيرًا في الحمّام

263
00:14:30,250 --> 00:14:32,260
،كان محرّكه يزمجر بشدّة

264
00:14:32,260 --> 00:14:34,730
.ربّما يحاول التّركيز بمفرده فحسب

265
00:14:36,260 --> 00:14:39,440
ستقتحمون مخبأ جمعيّة الوحوش؟

266
00:14:39,550 --> 00:14:41,660
...إذًا هكذا هو الوضع

267
00:14:42,350 --> 00:14:47,290
ومع ذلك، تُركنا أنا وجينوس خارج
.الموضوع. أعتقد أنّهم لا يثقون بنا

268
00:14:47,980 --> 00:14:51,870
!وأخذوا طفلاً كرهينة؟ يا لقسوتهم

269
00:14:52,230 --> 00:14:56,370
،كنّا منشغلين بتعقّب غارو
.لذلك لم نتحقّق حتّى من الأخبار

270
00:14:56,700 --> 00:15:01,130
هل يعلم سايتاما أنّ مقرّ
العدوّ في المدينة المهجورة؟

271
00:15:01,280 --> 00:15:02,290
.لا أظنّ

272
00:15:02,290 --> 00:15:05,180
.لو كان يعلم، لذهب بنفسه منذ زمن

273
00:15:05,590 --> 00:15:09,590
،سيتوجّه الفريق إلى أطلال المدينة زد من هنا

274
00:15:09,590 --> 00:15:11,980
.وسيأخذ كلّ منهم مساره الخاصّ

275
00:15:12,540 --> 00:15:14,300
.لكن لديّ ما أسألكما عنه

276
00:15:14,550 --> 00:15:16,520
.أيّها النّاب الفضّيّ، بومب

277
00:15:16,880 --> 00:15:19,470
ما رأيكما أن نصطحب الأصلع
ذو الرّداء والشّيطان السّايبورغ

278
00:15:19,470 --> 00:15:22,650
ونتسلّل عبر مساري الخاصّ سرًّا؟

279
00:15:23,050 --> 00:15:25,980
...لكنّ ذلك سيخالف أوامر الجمعيّة

280
00:15:26,220 --> 00:15:28,400
سيكون غارو هناك، صحيح؟

281
00:15:28,600 --> 00:15:30,150
.سننضمّ إليك

282
00:15:31,610 --> 00:15:32,830
.حسنًا

283
00:15:32,980 --> 00:15:35,920
.سنلتقي في بيت سايتاما كما البارحة

284
00:15:35,980 --> 00:15:37,340
.مفهوم

285
00:15:37,580 --> 00:15:39,420
.إلى اللّقاء إذًا

286
00:15:40,860 --> 00:15:44,630
.لقد نجوت. يا لها من راحة

287
00:15:45,540 --> 00:15:49,450
لقد عاد كينغ. هل حدث شيء ما؟

288
00:15:49,450 --> 00:15:51,680
.لا، لا مشكلة إطلاقًا

289
00:15:51,680 --> 00:15:54,190
.لقد توقّف محرّك الملك

290
00:15:54,290 --> 00:15:56,180
.لا بدّ أنّه شحذ تركيزه

291
00:15:57,170 --> 00:15:58,310
.حسنًا، لننطلق الآن

292
00:15:58,720 --> 00:16:00,320
هل الجميع مستعدّ؟

293
00:16:00,890 --> 00:16:01,990
!هيّا بنا

294
00:16:11,820 --> 00:16:14,810
،استُدعيتُ للانضمام إلى فريق الهجوم

295
00:16:14,810 --> 00:16:17,210
.لكنّهم أبعدوني في آخر لحظة لسبب ما

296
00:16:17,530 --> 00:16:19,790
.قيل لي أن أبقى خارج هذه المسألة

297
00:16:20,240 --> 00:16:23,160
.أراهن أنّ الإعصار هي من أقصتني

298
00:16:23,160 --> 00:16:24,250
!كلاّ

299
00:16:24,250 --> 00:16:26,890
لن تعترف بي أبدًا، أليس كذلك؟

300
00:16:27,240 --> 00:16:30,060
.لديّ أيضًا حساب شخصيّ مع جمعية الوحوش

301
00:16:30,210 --> 00:16:34,090
كيف يجرؤون على إهانتي أمام
أختي بذلك الشّكل؟

302
00:16:35,340 --> 00:16:38,890
كان جمع النّقاط بثبات والاستمرار في نشاطي

303
00:16:38,890 --> 00:16:40,860
.هو نقطة قوّة مجموعة العاصفة الثّلجيّة

304
00:16:41,170 --> 00:16:45,200
.لكن تعطّلت عمليّاتنا كلّها بسببهم

305
00:16:51,230 --> 00:16:52,980
.سآخذ بثأري

306
00:16:52,980 --> 00:16:55,530
.بقوّة العاصفة الثّلجيّة الجديدة

307
00:16:59,440 --> 00:17:02,750
لقد أرهقتُ الدّكتور كوسينو
،بطلباتي غير المعقولة

308
00:17:02,750 --> 00:17:06,880
،لكنّني وحسب نصيحة معلّمي
.جعلتُه يزيد قوّتي أكثر

309
00:17:07,130 --> 00:17:10,290
.هذا التّحديث متهوّر للغاية

310
00:17:10,290 --> 00:17:13,560
.تعزيزٌ هجوميّ غير متوازن بشدّة

311
00:17:18,800 --> 00:17:21,860
ستضطرّ للقتال بينما تتحكّم
.أنت بنفسك في تلك القوّة

312
00:17:22,220 --> 00:17:26,950
إن استخدمتَ القوّة الكاملة، ستتجاوز
.الأجزاء قدرتها على التّحمّل وتتحطّم

313
00:17:27,100 --> 00:17:31,690
...إنّه خيارٌ أخير فحسب
.عشر ثوانٍ هي الحدّ الأقصى

314
00:17:32,180 --> 00:17:34,690
.وإن زدتَ على ذلك، فلن يتحمّل جسدك

315
00:17:34,690 --> 00:17:36,990
،وإن انفجر قلبُ الطّاقة داخلك

316
00:17:36,990 --> 00:17:40,380
.فقد تموت حتّى لو كنت سايبورغ

317
00:17:40,780 --> 00:17:45,300
هل فهمت يا جينوس؟
.ستصمد القوّة القصوى 10 ثوان فقط

318
00:17:45,610 --> 00:17:47,510
.لا تنس ذلك

319
00:17:54,010 --> 00:17:55,770
ماذا تريدين الآن؟

320
00:17:55,870 --> 00:17:58,890
.لا تظنّي أنّ بإمكانك القدوم متى يحلو لك

321
00:17:59,090 --> 00:18:02,400
.ماذا تقول؟ أنت هنا طوال الوقت أيضًا

322
00:18:02,460 --> 00:18:04,360
.لا يحقّ لك أن تشتكي

323
00:18:04,670 --> 00:18:07,740
.لديّ الحقّ بصفتي تلميذ معلّمي

324
00:18:08,180 --> 00:18:10,660
.ثمّ إنّني أدفع حصّتي من الإيجار

325
00:18:10,810 --> 00:18:14,780
إيجار؟ سايتاما ليس مالك
.هذه الشّقّة من الأساس

326
00:18:15,030 --> 00:18:16,740
.إنّه يعيش هنا بلا إذن فحسب

327
00:18:16,940 --> 00:18:18,710
.إنّك تتعرّض للاحتيال

328
00:18:19,400 --> 00:18:23,280
على أيّ حال، ألم يصلك
أيّ شيء من الجمعيّة بعد؟

329
00:18:23,280 --> 00:18:24,870
.لقد تواصلوا معي بالفعل

330
00:18:25,450 --> 00:18:28,650
،اتُّخذ ابن أحد المدراء رهينة

331
00:18:28,650 --> 00:18:31,130
.لذا يفترض أن يكونوا قد تحرّكوا الآن

332
00:18:31,280 --> 00:18:33,850
لكن ربّما لم يعثروا
على مخبأ الوحوش بعد؟

333
00:18:34,040 --> 00:18:37,800
لو عرفنا، لكان المعلّم سايتاما
.قد محاهم من الوجود منذ مدّة

334
00:18:38,210 --> 00:18:40,130
.لقد عدتُ بعد الإصلاحات

335
00:18:40,130 --> 00:18:41,710
.نحن هنا يا سايتاما

336
00:18:41,710 --> 00:18:44,260
...يمكننا أخيرًا عقد اجتماعٍ استراتيجيّ لكي

337
00:18:45,050 --> 00:18:46,980
.ماذا؟ إنّه ليس هنا

338
00:18:47,180 --> 00:18:50,270
لكنّ التّخفيض الّذي كان ينتظره
.لن يبدأ إلاّ بعد غد

339
00:18:50,930 --> 00:18:52,270
هل قال لك أيّ شيء؟

340
00:18:52,270 --> 00:18:55,120
.حتّى بذلة الأبطال خاصّته ليست هنا
.ربّما حدث شيء ما

341
00:18:56,230 --> 00:18:59,990
.مرحبًا. لقد عدنا يا سايتاما

342
00:18:59,990 --> 00:19:01,640
.معلّمي ليس هنا

343
00:19:01,640 --> 00:19:04,670
.ليس هنا؟ هذا مؤسف

344
00:19:05,400 --> 00:19:09,760
لقد كنّا على وشك اقتحام
.مخبأ الوحوش مع كينغ

345
00:19:09,820 --> 00:19:12,880
ماذا؟ إذًا فقد عثرتم
على مخبأ جمعيّة الوحوش؟

346
00:19:13,080 --> 00:19:15,690
.يبدو أنّه قريبٌ جدًّا من هنا

347
00:19:15,690 --> 00:19:17,630
.تحت أنوفنا تمامًا، كما يُقال

348
00:19:18,590 --> 00:19:20,680
ألن تأتي أنت أيضًا يا جينوس؟

349
00:19:20,680 --> 00:19:21,770
.بالطّبع

350
00:19:25,260 --> 00:19:28,110
.نجحتُ في الخروج بطريقة ما

351
00:19:28,930 --> 00:19:30,740
.ها أنت ذا يا كينغ

352
00:19:31,550 --> 00:19:34,070
...مـ... مرحبًا

353
00:19:35,680 --> 00:19:37,280
.يبدو أنّ الجميع هنا

354
00:19:37,280 --> 00:19:39,240
.لكنّ سايتاما ليس موجودًا

355
00:19:39,240 --> 00:19:40,780
!ماذا؟ مستحيل

356
00:19:40,780 --> 00:19:43,780
لكن لم يعد لدينا أيّ وقت
...قبل بدء الهجوم

357
00:19:43,780 --> 00:19:50,040
"هدير"

358
00:19:43,980 --> 00:19:45,580
ماذا نفعل إذًا يا كينغ؟

359
00:19:45,990 --> 00:19:48,030
هل ننتظر عودة معلّمي سايتاما؟

360
00:19:48,030 --> 00:19:50,040
أم ندخل من دونه؟

361
00:19:50,040 --> 00:19:53,000
"هدير"

362
00:19:53,280 --> 00:19:54,840
.سننتظر سايتاما

363
00:19:55,370 --> 00:19:57,050
،إن كانت هذه معركة شاملة

364
00:19:57,050 --> 00:19:59,220
.فنحن بحاجة إلى قوّة سايتاما

365
00:19:59,410 --> 00:20:00,850
...عليّ أن أعترف لك يا كينغ

366
00:20:00,920 --> 00:20:03,350
أرى أنّك أعددتَ خططًا خلف
.الكواليس مسبقًا

367
00:20:03,590 --> 00:20:05,730
.إن كنّا سنذهب، فسنذهب جميعًا

368
00:20:05,840 --> 00:20:09,580
كلّ أفراد مجموعة العاصفة
الثّلجيّة الجديدة معًا، صحيح؟

369
00:20:09,580 --> 00:20:10,820
حسنًا، ماذا علينا أن نفعل؟

370
00:20:11,890 --> 00:20:14,960
!أنتم! لا تتجاهلوني

371
00:20:14,960 --> 00:20:20,280
!أنتم! هل تستمعون لي؟
!انظروا إليّ! أنا أحدّثكم

372
00:20:20,640 --> 00:20:24,900
لا يزيد تأخّر كينغ إلاّ عبئًا أكثر
.على أبطال الفئة س الآخرين

373
00:20:24,900 --> 00:20:26,370
.اذهبوا أنتم أوّلاً

374
00:20:26,610 --> 00:20:28,080
.وأنا سأنتظر معلّمي

375
00:20:28,530 --> 00:20:30,330
.وحين يعود، سننضمّ إلى الهجوم

376
00:20:30,330 --> 00:20:32,160
.خطة جيّدة

377
00:20:32,160 --> 00:20:34,460
ماذا؟ سنذهب من دون سايتاما؟

378
00:20:34,460 --> 00:20:36,080
أأنتم جادّون؟

379
00:20:36,780 --> 00:20:38,260
.حسنًا، هيّا بنا

380
00:20:38,330 --> 00:20:40,500
.لننهِ الأمر قبل غروب الشّمس

381
00:20:40,500 --> 00:20:44,090
اتبعوني يا مجموعة العاصفة
!الثّلجيّة الجديدة، لننطلق

382
00:20:44,090 --> 00:20:47,970
"هدير"

383
00:20:45,970 --> 00:20:47,390
...لستُ واثقًا حيال هذا

384
00:20:51,010 --> 00:20:54,030
سايتاما، أين ذهبت؟

385
00:22:31,610 --> 00:22:32,830
.وصلنا

386
00:22:36,950 --> 00:22:39,470
ماذا؟ أين كينغ؟

387
00:22:39,570 --> 00:22:41,330
.كان من المفترض أن يكون في المؤخّرة

388
00:22:41,330 --> 00:22:43,420
.لقد رأيته يركض مبتعدًا

389
00:22:47,670 --> 00:22:50,770
على الجميع الالتزام بالتّوقيت
.المحدّد للهجوم

390
00:22:51,090 --> 00:22:52,260
.هذا ما قاله

391
00:22:52,260 --> 00:22:56,320
.يتصرّف بمفرده وكأنّ الأمر لا شيء

392
00:22:56,510 --> 00:22:58,730
لماذا لم يخبرني مباشرة؟

393
00:22:59,640 --> 00:23:01,980
هل ما زلتُ أُعامَل كطفل؟

394
00:23:01,980 --> 00:23:06,990
.إنّه يتحرّك بسرعة. هذه طبيعته

395
00:23:07,190 --> 00:23:10,610
.كنت آمل أن أرى كينغ يقاتل عن قرب

396
00:23:10,610 --> 00:23:11,750
.يا للأسف

397
00:23:11,810 --> 00:23:14,380
.له طريقته الخاصّة في القيام بالأمور

398
00:23:14,610 --> 00:23:15,590
.نعم

399
00:23:15,650 --> 00:23:16,630
...انظروا

400
00:23:17,150 --> 00:23:18,800
.ثمّة ضيوف أمامنا

401
00:23:19,780 --> 00:23:22,260
.يبدو أنّهم يجهّزون لنا حفلة ترحيب

402
00:23:22,370 --> 00:23:24,840
.انظروا! إنّهم يستمرّون بالظّهور

403
00:23:25,200 --> 00:23:28,310
،أيّها المعلّم أتوميك
.أشعر بوجودهم خلفنا أيضًا

404
00:23:28,660 --> 00:23:30,730
.ليس خلفنا فقط

405
00:23:39,380 --> 00:23:41,400
خرقة قديمة...؟

406
00:23:45,850 --> 00:23:47,780
...حسنًا، حسنًا

407
00:23:48,020 --> 00:23:49,570
...عجبًا

408
00:23:49,570 --> 00:23:53,360
سمعت أنّ جمعيّة الأبطال سترسل
...كامل قوّتها القتاليّة

409
00:23:53,360 --> 00:23:55,170
لكن هل هذا هو كلّ شيء؟

410
00:23:55,910 --> 00:24:00,870
الهجوم المضادّ