1
00:00:33,170 --> 00:00:36,730
يُرجى قراءة دليل تشغيل
.جهاز الإرسال بشكل شامل

2
00:00:37,750 --> 00:00:40,020
.أدرجتُ الخريطة الّتي قمتُ بإنشائها

3
00:00:40,510 --> 00:00:45,030
،يمكننا التّواصل في حالات الطّوارئ
.لكن لا تعوّلوا أن يتمّ إنقاذكم

4
00:00:50,980 --> 00:00:53,700
قد تكون لإضاعة طريقكم
.في منطقة العدوّ عواقب قاتلة

5
00:00:54,230 --> 00:00:55,450
.كونوا حذرين رجاءً

6
00:00:56,270 --> 00:01:00,790
،اسمع. أنت ذلك البطل فائق السّرعة
الوميض الومّاض، صحيح؟

7
00:01:01,070 --> 00:01:02,210
.أعطوني الفتى

8
00:01:02,490 --> 00:01:03,950
.كنّا في انتظارك

9
00:01:04,200 --> 00:01:07,920
.عرفنا سلفًا أنّك ستسلك هذا الطّريق

10
00:01:07,920 --> 00:01:10,340
،إنّك تتفاخر بسرعتك

11
00:01:10,340 --> 00:01:13,760
.لكن لنرَ إن كانت تنفعك في ممرّات ضيّقة

12
00:01:19,100 --> 00:01:21,060
.لم أتفاخر أبدًا بسرعتي

13
00:01:21,060 --> 00:01:23,770
.ذلك تصرّف قد تقوم به شخصيّة جانبيّة

14
00:01:23,970 --> 00:01:26,740
مع أنّه قيل لي من قبل
.أنّي أُنهي الأمور بسرعة بالفعل

15
00:02:57,030 --> 00:03:00,960
"قصّة نينجا"

16
00:03:12,170 --> 00:03:13,460
.هذا مثير للإعجاب

17
00:03:14,580 --> 00:03:15,420
...أيّها الوميض

18
00:03:18,830 --> 00:03:19,920
.أحسنت

19
00:03:20,370 --> 00:03:22,130
.ذلك ما يجعلك جديرًا بأن تُقتل

20
00:03:22,130 --> 00:03:24,510
لا تقل لي أنّ تلك كانت سرعتك القصوى؟

21
00:03:24,750 --> 00:03:28,020
.أنت المسؤول عن حادثة الفصل 44 الأخير

22
00:03:28,020 --> 00:03:29,980
.الوميض الومّاض

23
00:03:30,380 --> 00:03:31,490
...فهمت

24
00:03:40,070 --> 00:03:42,110
إذًا كنتما تسعيان خلفي طوال هذا الوقت؟

25
00:03:42,110 --> 00:03:43,610
.وها قد التقينا أخيرًا

26
00:03:43,610 --> 00:03:45,120
.كنتُ أنتظر هذا

27
00:03:45,320 --> 00:03:46,290
...هذا الرّجل

28
00:03:46,780 --> 00:03:47,870
!ركلة نصل الرّياح

29
00:03:50,740 --> 00:03:52,290
!ركلة نصل اللّهب

30
00:03:55,580 --> 00:03:56,470
!...سلك فولاذيّ

31
00:03:59,660 --> 00:04:01,220
!كان ذلك وشيكًا

32
00:04:01,220 --> 00:04:04,180
أوشكتُ كثيرًا على تقطيعك
.إلى قطع لحم صغيرة

33
00:04:04,180 --> 00:04:08,150
لم يخطر ببالي قطّ أن تُقدِم
.على الهجوم وحدك هكذا

34
00:04:08,210 --> 00:04:10,180
.يبدو أنّك واثقٌ من نفسك كثيرًا

35
00:04:10,180 --> 00:04:12,180
وبفضل ذلك، صارت الأمور
.أسهل بكثير علينا

36
00:04:20,530 --> 00:04:21,820
.كفانا حديثًا

37
00:04:21,820 --> 00:04:23,790
.والآن، اهرب لتنجو بحياتك

38
00:04:24,020 --> 00:04:28,170
،كحشرة تطاردها الرّياح والنّيران
.فتهيم مسرعةً نحو شِباك العنكبوت

39
00:04:28,280 --> 00:04:31,950
!ستتمزّق إربًا بسرعتك الخاصّة

40
00:04:39,540 --> 00:04:41,210
.قام بقطع الجدران

41
00:04:41,210 --> 00:04:42,920
إذًا أنت من القرية أيضًا؟

42
00:04:42,920 --> 00:04:46,260
انضممتَ للوحوش للقضاء عليّ؟

43
00:04:46,260 --> 00:04:48,140
.المكان مزدحم جدًّا هنا

44
00:04:48,800 --> 00:04:50,190
.لننتقل إلى مكان آخر

45
00:05:08,150 --> 00:05:09,670
!ركلة نصل العاصفة

46
00:05:21,910 --> 00:05:23,760
ليس مكانًا سيّئًا، صحيح؟

47
00:05:23,760 --> 00:05:26,770
.أخذناه بالقوّة من الوحوش

48
00:05:27,040 --> 00:05:29,260
.بإمكاننا القتال هنا بقدر ما نشاء

49
00:05:29,460 --> 00:05:30,810
.وبكلّ ما لدينا

50
00:05:31,420 --> 00:05:33,520
...إنّ من سيقضون عليك هم

51
00:05:33,520 --> 00:05:35,480
!من الفصل 37 الذّهبيّ

52
00:05:35,840 --> 00:05:37,650
!الرّياح العاصفة

53
00:05:36,180 --> 00:05:38,030
"مستوى التّهديد: شيطان"
"الرّياح العاصفة"

54
00:05:39,890 --> 00:05:41,450
!وأنا لهب الجحيم

55
00:05:40,430 --> 00:05:41,870
"مستوى التّهديد: شيطان"
"لهب الجحيم"

56
00:06:06,420 --> 00:06:07,800
من أجّركما؟

57
00:06:07,800 --> 00:06:12,600
سأذهب لزيارة من أجّركما بعد
.أن أنهي أمر جمعيّة الوحوش

58
00:06:27,230 --> 00:06:29,500
من أجّرنا؟

59
00:06:31,820 --> 00:06:36,590
،ماذا لو أخبرتك أنّه أبورابوزو
...ملك الاتّجار بالبشر

60
00:06:37,110 --> 00:06:40,210
أتُراك تظنّ حقًّا أنّ بإمكانك

61
00:06:40,210 --> 00:06:43,090
مواجهة جيش منظّمته
في عالمه السّفليّ وحدك؟

62
00:06:43,620 --> 00:06:45,710
.لا –
كيف؟ –

63
00:06:45,710 --> 00:06:50,300
لأنّي قتلتُه سلفًا. ظلّ يرسل
.القتلة خلفي بلا توقّف

64
00:06:51,670 --> 00:06:53,830
ماذا عن شوغن المخدّرات هيرود؟

65
00:06:53,830 --> 00:06:55,310
.قتلتُه أيضًا

66
00:06:55,310 --> 00:06:57,220
وجامع القلوب بوليغولا؟

67
00:06:57,220 --> 00:06:58,140
.قتلتُه

68
00:06:58,140 --> 00:06:59,690
اللّصّ الشّبح المسخ تشيماغوسا؟

69
00:06:59,690 --> 00:07:00,560
.قتلتُه

70
00:07:00,560 --> 00:07:02,560
قائد قطّاع الطّرق المنيع جاما العاصف؟

71
00:07:02,560 --> 00:07:04,200
.هو أيضًا، كدتُ أنسى أمره

72
00:07:04,770 --> 00:07:07,780
القيادة العُليا لتحالف الاغتيالات؟

73
00:07:07,890 --> 00:07:09,750
.جميعهم في أعماق المحيط الآن

74
00:07:10,350 --> 00:07:13,920
،لا أشيع الأمر بين النّاس
...لذلك لا يدري أحد

75
00:07:13,980 --> 00:07:17,090
لكنّني قضيتُ على كلّ
.من حاول السّعي خلفي

76
00:07:17,950 --> 00:07:20,340
هل انتهت كلّ أسئلتكما المخادعة الآن؟

77
00:07:20,530 --> 00:07:24,800
حسنًا، من الّذي يدير كلّ هذا من الظّلال إذًا؟

78
00:07:24,990 --> 00:07:30,720
كان هؤلاء هم الأشخاص الّذين كنّا
.سنقتلهم بعد القضاء عليك

79
00:07:30,720 --> 00:07:35,010
.لذلك فقد وفّرت علينا متاعب كثيرة
.نحن ممتنّان لك

80
00:07:35,210 --> 00:07:37,810
!شكرًا لك، لكنّك ستموت الآن

81
00:07:39,970 --> 00:07:43,860
إذا قارنتَهم بالأبطال، فإنّ أفضل
.المقاتلين في القرية أشدّ إزعاجًا بكثير

82
00:07:45,760 --> 00:07:47,720
.ليس جميع النّينجا من القرية

83
00:07:47,720 --> 00:07:50,080
.لكنّهم لا شيء مقارنة بالنّينجا من القرية

84
00:07:50,140 --> 00:07:54,620
اعتُبر جيلنا في القرية، الفصل 37
.الذّهبيّ، الأقوى في التّاريخ

85
00:07:54,620 --> 00:07:56,870
.ونحن أقوى اثنين من ذلك الجيل

86
00:07:56,870 --> 00:08:00,410
لنرَ كم ستصمد يا صاحب المركز
!الأوّل من الجيل الرّابع والأربعين

87
00:08:13,290 --> 00:08:14,240
.لستما سيّئين

88
00:08:14,240 --> 00:08:16,140
أكانت تلك سرعتكما القصوى؟

89
00:08:16,140 --> 00:08:19,770
.كفاكما تهاونًا
لماذا لا تقدّما كلّ ما لديكما؟

90
00:08:20,130 --> 00:08:22,270
.أقصد قوّة الوحوش خاصّتكما

91
00:08:22,430 --> 00:08:24,380
.إذًا فأنت تعرف

92
00:08:24,380 --> 00:08:27,730
راودني ذلك الإحساس الغريب
،منذ أوّل مواجهة بيننا

93
00:08:27,730 --> 00:08:30,900
لكنّني تأكّدتُ تمامًا حين حاولتما
.نقل القتال إلى مكانٍ آخر

94
00:08:31,190 --> 00:08:33,860
،لم تصيرا وحشين إلاّ حديثًا

95
00:08:33,860 --> 00:08:36,670
لذلك ما زلتما لا تبرعان
.في التّحكّم بسرعاتكما القصوى

96
00:08:36,820 --> 00:08:39,790
.لذلك استدرجتماني إلى هذا الفضاء المفتوح

97
00:08:39,790 --> 00:08:43,290
عجبًا، عجبًا. أكلتَ الطّعم رغم أنّك تعرف؟

98
00:08:43,290 --> 00:08:46,790
.يا لك من وغد مغرور
!أظهر بعض الاحترام لزملائك الأكبر

99
00:08:47,030 --> 00:08:50,290
وكذلك أنتما. سألقّنكما درسًا
.لن تنسيانه أيّها الحثالة

100
00:08:50,290 --> 00:08:54,510
إنّ تحوّلكما إلى وحوش لا يعني
.أنّكما ستستطيعان التّغلّب عليّ

101
00:08:54,510 --> 00:08:58,010
.هذه الكلمات... لا يمكنك التّراجع عنها الآن

102
00:08:54,880 --> 00:08:58,010
"مستوى التّهديد: تنّين"
"الرّياح العاصفة" "لهب الجحيم"

103
00:08:58,300 --> 00:09:00,900
.إيّاك أن تشيح نظرك عنّا من الآن فصاعدًا

104
00:09:15,900 --> 00:09:17,910
!أسلوب النّار: تقطيع الشّرارات المتطايرة

105
00:09:22,740 --> 00:09:25,160
استطاع تحمّل مسايفتي الوحشيّة؟

106
00:09:25,160 --> 00:09:26,710
...أم كان مجرّد حظّ؟ لا

107
00:09:28,870 --> 00:09:30,170
.تقطيع الوميض الثّقيل

108
00:09:33,910 --> 00:09:35,510
!كنتَ تستهدف تدمير سلاحي؟

109
00:09:35,510 --> 00:09:37,930
،بطيء. لا يستطيع دماغك مجاراتك
.أنت بلا فائدة

110
00:09:41,090 --> 00:09:44,390
.واضح لي لماذا يوصف بالعبقريّ مثلنا

111
00:09:44,390 --> 00:09:48,990
،من حيث الدّقّة التّقنيّة
.قد تكون الغلبة للوميض

112
00:09:49,220 --> 00:09:53,240
لا يبدو أنّه يُعاني من أيّ نقص
.في السّرعة أو القوّة

113
00:09:53,430 --> 00:09:57,240
لا يوجد وحوش سوانا قادرة
...على الوقوف في وجهه

114
00:09:57,240 --> 00:09:59,200
ما زلتما تعتقدان أنّكما تتفوّقان عليّ؟

115
00:09:59,200 --> 00:10:00,710
.أنتما مخطئان تمامًا

116
00:10:02,400 --> 00:10:05,700
...الرّياح العاصفة، لهب الجحيم

117
00:10:05,700 --> 00:10:08,470
.أعرف حركاتكما حقّ المعرفة

118
00:10:09,320 --> 00:10:13,350
.فقبل كلّ شيء، تدرّبتُ أكثر من أيّ أحد آخر

119
00:10:13,700 --> 00:10:17,640
،كلّما كان المقاتل أكثر مهارة
.اقترب أكثر من الأساسيّات

120
00:10:17,870 --> 00:10:19,330
،مهما كانت سرعة الهجوم

121
00:10:19,330 --> 00:10:22,850
يمكنك التّعامل معه بسهولة
.إذا كنت تعرف الأساسيّات

122
00:10:23,840 --> 00:10:26,270
.حسنًا إذًا

123
00:10:26,630 --> 00:10:28,180
هذا يكفي... صحيح؟

124
00:10:28,180 --> 00:10:31,910
.نعم، هذا يكفي. اكتفيتُ من القتال كنينجا

125
00:10:32,060 --> 00:10:34,020
.لا مزيد من التّقنيات أو الأسلحة

126
00:10:34,020 --> 00:10:36,440
.سنقتلك كوحشين

127
00:10:36,440 --> 00:10:40,040
.ستكون تلك أكثر الطّرق قسوة وعنفًا للموت

128
00:10:40,150 --> 00:10:42,960
...إنّ ما ستراه الآن سيكون ببساطة

129
00:10:43,030 --> 00:10:48,080
نحن الاثنين نسحق ضعيفًا
.بسرعةٍ لا يستطيع تحمّلها

130
00:10:48,080 --> 00:10:52,040
لقد أجبرتنا على التّخلّي عن آخر
.ذرّة شرف لنا كنينجا

131
00:10:52,040 --> 00:10:56,250
ومن باب الاحترام، سنُطلِق أقصى
...سرعتنا، وننقضّ عليك

132
00:10:56,250 --> 00:10:59,020
.بلا هوادةٍ حتّى تنهار صريعًا

133
00:10:59,170 --> 00:11:02,970
فلتتعلّم ما يفصل بين البشر
.والوحوش، ومُت

134
00:11:02,970 --> 00:11:05,850
.الوداع أيّها الوميض الومّاض

135
00:11:24,480 --> 00:11:26,870
أتعتقد أنّ بإمكانك الإفلات منّي الآن؟

136
00:11:26,870 --> 00:11:29,050
.لا تخيّب أملي

137
00:11:52,140 --> 00:11:53,490
!ركلة وامضة

138
00:11:56,260 --> 00:11:58,070
.هذا سيّئ، إنّه يُطبق علينا

139
00:11:58,180 --> 00:12:00,280
.يجب أن نستعيد سيطرتنا فورًا

140
00:12:03,650 --> 00:12:04,660
.التّقنية الأقوى

141
00:12:09,330 --> 00:12:11,000
.التّقطيع الوامض

142
00:12:20,250 --> 00:12:22,770
.سُحقًا. كم هذا مُحبط

143
00:12:23,130 --> 00:12:26,810
أخفى تلك التّقنية السّرّيّة في جعبته
.طوال الوقف ولم يستعملها حتّى الآن

144
00:12:27,340 --> 00:12:31,110
كنتُ أنتظر اللّحظة المناسبة فقط
.للإطاحة بكما معًا

145
00:12:31,340 --> 00:12:36,560
،إن استطاع ولو واحد منكما الهرب
.فسيتسبّب ذلك بالمشاكل لاحقًا

146
00:12:40,480 --> 00:12:46,210
ما كان ليستطيع أيّ بطل آخر من
.أبطال الفئة س مجاراة سرعتكما

147
00:12:46,400 --> 00:12:51,590
كانت أفضل حركة كنتما لتقوما
.بها هي ببساطة ألاّ تقاتلاني

148
00:12:51,900 --> 00:12:55,130
...ليتك لم تكن خصمي

149
00:12:56,490 --> 00:12:58,680
.إنّك تثير استفزازي حقًّا

150
00:12:58,990 --> 00:13:01,500
.يعيش القتلة في الظّلال

151
00:13:01,500 --> 00:13:05,270
.لا تتمّ معاملتنا كبشر إطلاقًا
.يتمّ استغلالنا ثمّ التّخلّص منّا لا غير

152
00:13:06,130 --> 00:13:11,270
...أردنا أن نكون المسيطرين فحسب
.أن نتولّى زمام التّحكّم ولو لمرّة

153
00:13:11,970 --> 00:13:13,600
...لاكتساب القوّة

154
00:13:13,600 --> 00:13:16,360
...جرّبنا كلّ شيء يخطر على البال

155
00:13:16,760 --> 00:13:18,660
...أيّها الوميض الومّاض

156
00:13:19,010 --> 00:13:22,370
ما الّذي كنّا نفتقر له؟

157
00:13:39,330 --> 00:13:41,260
.لم تتدرّبا بما يكفي

158
00:13:53,760 --> 00:13:55,230
أين أنا؟

159
00:13:57,600 --> 00:13:58,900
"تفتيش"

160
00:13:59,900 --> 00:14:01,030
"إسراع"

161
00:14:03,640 --> 00:14:04,990
"هبوب"

162
00:14:05,690 --> 00:14:09,410
لا بدّ أنّ الإشارة الّتي تتحرّك
.بسرعة فائقة هي الوميض

163
00:14:09,650 --> 00:14:13,130
لكنّه توقّف. هل تحطّم جهاز إرساله؟

164
00:14:13,780 --> 00:14:16,250
.لا توجد أيّ حركات غير عاديّة من البقيّة

165
00:14:16,990 --> 00:14:19,930
،ولكن حتّى إن حدث أيّ شيء
.بإمكانهم تولّي الأمر

166
00:14:20,120 --> 00:14:21,420
،وإن كانوا في خطر بالفعل

167
00:14:21,420 --> 00:14:23,760
.واثق أنّهم سيرسلون إشارة استغاثة

168
00:14:24,870 --> 00:14:27,770
.إنّهم ليسوا من أنا قلق بشأنهم

169
00:14:28,210 --> 00:14:30,180
،إن استطعنا إنقاذ الرّهينة بطريقة ما

170
00:14:30,180 --> 00:14:34,150
سينخفض الإجهاد الذّهنيّ
.لهذه المعركة انخفاضًا كبيرًا

171
00:14:35,220 --> 00:14:38,990
عليّ القيام بما أستطيعه ليتمكّنوا
.من تقديم كلّ ما بوسعهم

172
00:14:39,340 --> 00:14:42,810
،التزمتُ الصّمت تجنّبًا لإثارة المشاكل
.لكن لديّ بعض المعلومات

173
00:14:46,070 --> 00:14:47,450
"دبّابة أخطبوط صغيرة رقم 8"

174
00:14:48,400 --> 00:14:49,290
!أنا قريب

175
00:14:54,030 --> 00:14:55,090
...لا أصدّق

176
00:14:55,740 --> 00:14:59,210
،أجرى الفارس اختبارات شديدة للمتانة
.ومع ذلك هو بهذا الحال الآن

177
00:14:59,610 --> 00:15:02,620
يبدو أنّ ملك الوحوش أوروتشي
.من فعل هذا به

178
00:15:02,620 --> 00:15:05,550
أيّ نوع من الهجمات دمّره لهذا الحدّ؟

179
00:15:05,790 --> 00:15:07,810
.يا إلهي، آمل ألاّ ألتقي به أبدًا

180
00:15:09,290 --> 00:15:13,940
سأستخرج البيانات من الرّوبوت
.بنفسي بما أنّه يرفض إخباري

181
00:15:14,750 --> 00:15:16,360
.ستفي أيّ بيانات بالغرض

182
00:15:21,180 --> 00:15:25,160
ثمّة دليل على أنّ أحدًا ما
.حاول إعادة جمعه

183
00:15:25,720 --> 00:15:30,790
لا يوجد أيّ ضرر على بعض الأجزاء
.وتمّ تفكيكها بشكل متقن

184
00:15:30,850 --> 00:15:34,250
هل لديهم خبير في هذا المجال؟

185
00:15:34,450 --> 00:15:38,950
إن استعمل الوحوش التّكنولوجيا
.خاصّتنا ضدّنا، سنكون في ورطة كبيرة

186
00:15:38,950 --> 00:15:41,620
...كلاّ، صداع آخر

187
00:15:42,450 --> 00:15:44,790
...وجدته! هذا

188
00:15:50,830 --> 00:15:54,390
،كان يعرف هذا طوال الوقت
...لكنّه ظلّ يرفض التّعاون

189
00:15:54,390 --> 00:15:57,980
.حسنًا، لن يُجدي الغضب نفعًا الآن

190
00:15:58,920 --> 00:16:02,740
.وجدنا أخيرًا الدّليل الصّحيح
!يجب أن نظلّ إيجابيّين

191
00:16:05,470 --> 00:16:09,780
اتّخاذ خطوات صغيرة وثابتة
.هو أقصر الطُّرق إلى النّجاح

192
00:16:10,350 --> 00:16:12,700
لا يمكن للمرء التّفكير بوضوح
.عندما يكون مستفَزًّا

193
00:16:12,770 --> 00:16:15,530
.سأتناول شيئًا حلوًا لإراحة دماغي

194
00:16:18,620 --> 00:16:20,700
هل أنت من صنع هذا؟

195
00:16:20,700 --> 00:16:22,460
.يا له من تصميم طفوليّ

196
00:16:22,610 --> 00:16:25,880
أراهن أنّك أتيت إلى هنا لقضاء
وقت ممتع، صحيح؟

197
00:16:26,280 --> 00:16:28,890
لا بدّ أنّه من اللّطيف أن تكون طفلاً
.وليس لديك شيء يُقلقك

198
00:16:29,250 --> 00:16:32,880
.لكنّي لا أظهر الرّحمة حتّى للأطفال

199
00:16:34,420 --> 00:16:35,590
هل أنت أحد القادة؟

200
00:16:36,090 --> 00:16:39,150
.أنا ما يمكنك وصفه بالإدارة الوسطى

201
00:16:39,510 --> 00:16:43,080
لستُ قائدًا بالتّحديد، لكنّي
.ما زلت أحظى باحترام من حولي

202
00:16:43,080 --> 00:16:45,650
بطريقة ما، أنا أكثر كفاءة حتّى
.من بعض الوحوش الزّعماء

203
00:16:46,720 --> 00:16:51,330
.مفهوم؟ تضمّ المنظّمات أنواعًا شتّى من القيود

204
00:16:51,600 --> 00:16:56,580
لا بدّ أنّ ذلك مفهوم صعب
.على طفل يتطلّع للأبطال

205
00:16:57,070 --> 00:17:02,000
طفل ذكيّ يرتقي للفئة س
ويصير مشهورًا

206
00:17:02,000 --> 00:17:03,700
.ثمّ يصير مدلّلاً بشدّة

207
00:17:03,700 --> 00:17:08,090
.والآن، سيقوده غروره إلى النّهاية
.يا له من مصير مأساويّ

208
00:17:08,870 --> 00:17:12,760
ما كان عليك تصديق الثّناء
.الّذي قدّمه لك الكبار

209
00:17:14,170 --> 00:17:17,240
.أنا لا أثق إلاّ بنفسي

210
00:17:17,240 --> 00:17:20,890
جمعيّة الوحوش هذه مجرّد
.محطّة في طريقي

211
00:17:21,210 --> 00:17:25,150
وفي النّهاية، سأستولي على
.لقب الملك من أوروتشي

212
00:17:25,800 --> 00:17:27,820
.أنا الرّجل العنقاء

213
00:17:25,800 --> 00:17:32,690
"مستوى التّهديد: شيطان"
"الرّجل العنقاء"

214
00:17:28,140 --> 00:17:29,980
،لم أستطع خلع زيّ العنقاء هذا

215
00:17:29,980 --> 00:17:32,690
.وقبل أن أدرك، كنتُ قد صرتُ وحشًا

216
00:17:32,930 --> 00:17:35,280
...أيّها الطّفل الإمبراطور
.أنت ضحيّة للزّمن

217
00:17:35,280 --> 00:17:36,820
.ستموت هنا

218
00:17:36,820 --> 00:17:39,780
.سأمنحك موتًا فوريًّا لكي لا تعاني

219
00:17:39,780 --> 00:17:40,960
!هجوم المنقار

220
00:17:42,490 --> 00:17:46,630
،بينما كنتَ تتكلّم
.أطلقت أسلاكًا وجهّزتُ لهذا

221
00:17:47,120 --> 00:17:52,420
هذا الشّريط الشّفّاف الرّفيع
.يقاوم كلّ الهجمات المفاجئة

222
00:17:53,200 --> 00:17:55,420
لإمكانك لفّه على شكل أنبوب
.وحمله إلى أيّ مكان معك

223
00:17:55,420 --> 00:17:57,680
.يمكن لفّ حتّى السّكاكر فيه
إنّه مفيد، صحيح؟

224
00:17:58,750 --> 00:18:00,600
."سأسمّيه "الجدار غير المرئيّ

225
00:18:00,880 --> 00:18:04,400
.أهذا عاديّ جدًّا؟ ربّما "الدّرع المزعج" أفضل

226
00:18:05,090 --> 00:18:07,840
.اعتقدتُ أنّ بإمكاني إجراء حديث محترم معك

227
00:18:07,840 --> 00:18:11,450
كنت أفكّر في الإمساك بك حيًّا
...واستعمالك لإرشادي

228
00:18:11,770 --> 00:18:13,980
.أمّا الآن، فقد صرتُ في مزاج سيّئ

229
00:18:20,150 --> 00:18:23,540
،لا بأس بالطّموح، لكن إن كنتَ موهوبًا حقًّا

230
00:18:23,540 --> 00:18:26,250
.ما كنتَ لتنضمّ لجمعيّة الوحوش

231
00:18:27,610 --> 00:18:29,420
.أعتقد أنّ الأمر نفسه ينطبق عليّ

232
00:18:29,570 --> 00:18:32,220
.شكرًا لك. أشعر بهدوء أكثر الآن

233
00:18:43,210 --> 00:18:45,390
.أنت، اخرس –
ما المشكلة؟ –

234
00:18:45,550 --> 00:18:47,220
.يثير هذا الفتى ضجّة كبيرة

235
00:18:47,220 --> 00:18:49,740
يا للإزعاج. هل نأكله فحسب؟

236
00:18:49,840 --> 00:18:52,810
.سبق واخترق الأبطال المكان

237
00:18:52,810 --> 00:18:55,480
من يهتمّ لسلامة الرّهينة؟

238
00:18:55,480 --> 00:18:56,450
.أعجبني ذلك

239
00:18:56,770 --> 00:18:58,860
ماذا؟ ما هذا؟

240
00:18:59,230 --> 00:19:00,900
ماذا؟ –
ماذا؟ –

241
00:19:00,900 --> 00:19:02,080
ماذا؟ –
!مهلاً –

242
00:19:02,270 --> 00:19:03,790
!سُحقًا! لا تستنشقوا هذا

243
00:19:11,410 --> 00:19:12,880
واغانما؟ –
ماذا؟ –

244
00:19:14,240 --> 00:19:16,670
.أنا هنا لإنقاذك
.تعال معي، لنخرج من هنا

245
00:19:19,120 --> 00:19:20,590
!ضغط الوحل

246
00:19:21,080 --> 00:19:23,900
"مستوى التّهديد: نمر"
"قنديل الوحل"

247
00:19:25,760 --> 00:19:28,190
لا يؤثّر الغاز السّامّ
.على بعض الوحوش إذًا

248
00:19:35,270 --> 00:19:37,650
ربّما لستَ قويًّا كما ظننت؟

249
00:19:37,650 --> 00:19:39,400
.حتّى التّقطيع لا يؤثّر فيه

250
00:19:43,110 --> 00:19:44,610
!أمزح فحسب

251
00:19:44,610 --> 00:19:48,040
سبق وأخبرتك أنّ التّقطيع
.أو الطّعن لا ينفعان ضدّي

252
00:19:49,150 --> 00:19:52,010
.أرى أنّك لا تملك طريقة لقتلي

253
00:19:52,120 --> 00:19:53,880
!الحظّ إلى جانبي أخيرًا

254
00:19:53,880 --> 00:19:57,010
من كان يظنّ أنّ الإطاحة ببطل من
الفئة س ستكون بهذه السّهولة؟

255
00:19:59,660 --> 00:20:00,630
ماذا؟

256
00:20:00,630 --> 00:20:01,770
.إنّه زيت مشتعل

257
00:20:05,750 --> 00:20:07,510
.الرّائحة فظيعة. لنغادر المكان

258
00:20:07,510 --> 00:20:08,520
.حـ-حسنًا

259
00:20:14,350 --> 00:20:16,560
.بإمكانك خلع قناع النّقيق الآن

260
00:20:16,560 --> 00:20:17,570
كيف تشعر؟

261
00:20:19,310 --> 00:20:21,570
.أنا أتضوّر جوعًا

262
00:20:22,940 --> 00:20:25,150
أنت بطل الفئة س، الطّفل الإمبراطور، صحيح؟

263
00:20:25,150 --> 00:20:26,910
!لماذا كلّ هذا التّأخير؟

264
00:20:27,820 --> 00:20:29,340
.أنا آسف، آسف

265
00:20:29,940 --> 00:20:30,790
.سر خلفي

266
00:20:30,790 --> 00:20:32,500
ماذا؟ –
.ما زال يوجد شيء ما هنا –

267
00:20:34,370 --> 00:20:36,710
سأطيح به بدبّابتي الّتي أتحكّم
.بها عن بعد، ثمّ سنغادر

268
00:20:37,330 --> 00:20:38,680
.يبدو ذلك ممتعًا

269
00:20:47,630 --> 00:20:48,940
أنت بطل، صحيح؟

270
00:20:49,210 --> 00:20:52,480
.لا أحتاج لمعرفة اسمك
.سأتخلّص منك في الحال

271
00:20:53,520 --> 00:20:55,700
...آلة؟! في تلك الحالة

272
00:21:01,140 --> 00:21:03,830
.مُحيّد الخصوم الآليّ
!صندوق صعق الحشرات

273
00:21:07,320 --> 00:21:09,640
،إنّه يحتويهم داخل قفص عالي الجهد

274
00:21:09,640 --> 00:21:11,840
ثمّ يقوم بتحميلهم بإشارات
.زائدة لتعطيلهم

275
00:21:11,900 --> 00:21:14,540
.ممتاز! أريد أخذ ذلك الرّوبوت للمنزل

276
00:21:18,130 --> 00:21:19,180
ماذا؟

277
00:21:19,950 --> 00:21:21,100
!إنّه قويّ

278
00:21:21,450 --> 00:21:22,810
!تراجع يا واغانما

279
00:21:23,460 --> 00:21:26,730
،سُحقًا. إنّني أستعمل الكثير من أدواتي
.لكن ما باليد حيلة

280
00:21:26,920 --> 00:21:27,940
!اخرجوا

281
00:21:30,000 --> 00:21:31,810
!الخدم المخلصون
!رجال الكلب المستضعف

282
00:21:31,970 --> 00:21:34,560
!رقم 23 ورقم 24 ورقم 25

283
00:21:34,560 --> 00:21:35,520
!اندمجوا

284
00:21:40,440 --> 00:21:42,370
!كلب سربروس المستضعف المجنون

285
00:21:42,730 --> 00:21:44,030
.يبدو ذلك شرسًا

286
00:21:44,030 --> 00:21:46,360
.ممتاز! إنّه قتال روبوتات

287
00:21:46,360 --> 00:21:47,780
.نعم، نوعًا ما

288
00:21:49,940 --> 00:21:53,880
كيف تجرؤ على وضعي في الفئة ذاتها
مع ذكاء اصطناعيّ بمستوى الكلاب؟

289
00:21:55,610 --> 00:21:56,710
!صواريخ أقلام الرّصاص

290
00:21:58,830 --> 00:22:00,050
!رأس صمغ الطّيور الحربيّ

291
00:22:02,040 --> 00:22:04,340
!لكمة تجذيف الكلب الجامحة

292
00:22:04,710 --> 00:22:06,720
!أجل، لننطلق

293
00:22:06,870 --> 00:22:08,250
.علينا الخروج يا واغانما

294
00:22:09,140 --> 00:22:10,210
.هيّا بنا نسرع

295
00:22:10,210 --> 00:22:12,190
مـ-مهلاً.. لماذا...؟

296
00:22:17,310 --> 00:22:19,280
.لا يجب أن تفقد انتباهك

297
00:22:19,550 --> 00:22:23,070
عليّ الآن التّركيز على إبعاد
.واغانما عن الخطر

298
00:23:56,030 --> 00:24:01,000
"طفل شجاع"