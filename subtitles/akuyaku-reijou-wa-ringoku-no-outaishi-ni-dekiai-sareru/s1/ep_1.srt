1
00:00:05,110 --> 00:00:09,990
أكاديميّة لابيس لازولي

2
00:00:13,200 --> 00:00:14,930
!تياراروز-ساما

3
00:00:15,710 --> 00:00:18,000
غداً هو يوم تخرّجنا

4
00:00:18,270 --> 00:00:22,840
من المُحزن جدّاً ألّا أراكِ بعد الآن

5
00:00:22,840 --> 00:00:25,330
ستسنح لنا فُرص للّقاء ثانية

6
00:00:25,330 --> 00:00:29,590
سأكون هنا دوماً في مملكة لابيس لازولي

7
00:00:25,340 --> 00:00:29,590
تياراروز لابيس كلامينتايل

8
00:00:29,590 --> 00:00:31,330
!أجل، معكِ حقّ

9
00:00:30,380 --> 00:00:35,010
ماريتّا

10
00:00:30,380 --> 00:00:35,010
فليوريان

11
00:00:31,330 --> 00:00:34,610
!فأنتِ الملكة المُستقبليّة

12
00:00:34,610 --> 00:00:38,230
متى زفافكِ من الأمير هارتنايتس؟

13
00:00:38,230 --> 00:00:42,170
بعد التخرُّج، سأخضع لتدريب
،عرائسيّ لمدّة عام

14
00:00:42,170 --> 00:00:45,480
ثمّ سنُقيم زفافنا في الكاتدرائيّة

15
00:00:45,830 --> 00:00:51,140
حالما تصبحين ملكة، سيكون السّلام
في لابيس لازولي مضموناً

16
00:00:51,490 --> 00:00:55,490
سأبذل قصارى جهدي للارتقاء لتوقُّعات الجميع

17
00:00:56,820 --> 00:01:00,350
،أنا تياراروز لابيس كلامينتايل

18
00:01:01,210 --> 00:01:04,080
ابنة الماركيز الّذي مُنِح اسم لابيس

19
00:01:04,080 --> 00:01:06,070
وخطيبة وليّ العهد

20
00:01:08,040 --> 00:01:09,730
الأمير هارتنايتس

21
00:01:10,890 --> 00:01:12,220
ما هذا؟

22
00:01:12,600 --> 00:01:16,260
تبدو تعابير وجهه عابسة

23
00:01:16,750 --> 00:01:18,610
هل حدث شيء؟

24
00:01:21,220 --> 00:01:22,950
!الأمير هارتنايتس

25
00:01:29,930 --> 00:01:31,170
لماذا؟

26
00:01:31,600 --> 00:01:33,470
!هذا مستحيل

27
00:01:34,180 --> 00:01:35,880
...فأساساً، أنا

28
00:01:38,450 --> 00:01:39,580
ماذا؟

29
00:01:40,850 --> 00:01:42,460
...أنا

30
00:03:21,140 --> 00:03:23,400
!الأمير هارتنايتس باهر الجمال

31
00:03:24,100 --> 00:03:26,100
إنّه باهر الجمال حقّاً

32
00:03:26,100 --> 00:03:29,820
أريد أن تعيشي معي... الآن وللأبد

33
00:03:26,100 --> 00:03:30,400
هارتنايتس

34
00:03:26,100 --> 00:03:30,400
I أريد أن تعيشي معي... الآن وللأبد

35
00:03:29,190 --> 00:03:30,400
نعم

36
00:03:29,190 --> 00:03:30,400
لا

37
00:03:30,400 --> 00:03:31,020
!بالطّبع

38
00:03:31,020 --> 00:03:32,170
هارتنايتس

39
00:03:31,020 --> 00:03:32,170
أريد أن تعيشي معي... الآن وللأبد

40
00:03:31,020 --> 00:03:32,170
نعم

41
00:03:31,020 --> 00:03:32,170
لا

42
00:03:32,870 --> 00:03:34,980
!كم هذا رائع

43
00:03:34,980 --> 00:03:38,410
!وبهذا مسار هارتنايتس قد أُنجِز

44
00:03:38,410 --> 00:03:41,140
لعبة الأوتومي، خاتم لابيس لازولي

45
00:03:38,410 --> 00:03:43,870
خاتم لابيس لازولي

46
00:03:41,140 --> 00:03:43,870
أحببتُها حُبّاً جمّاً لدرجة الإدمان

47
00:03:43,870 --> 00:03:45,310
كيف تجرئين؟

48
00:03:45,870 --> 00:03:47,960
أنتِ مُجرّد شخص من العوام

49
00:03:45,870 --> 00:03:51,210
تياراروز

50
00:03:45,870 --> 00:03:51,210
أنتِ مُجرّد شخص من العوام. عليكِ
أن تبتعدي عن حبيبي هارتنايتس

51
00:03:47,960 --> 00:03:51,210
عليكِ أن تبتعدي عن حبيبي هارتنايتس

52
00:03:51,210 --> 00:03:52,530
أنتِ قبيحة؟

53
00:03:51,210 --> 00:03:53,590
تياراروز

54
00:03:51,210 --> 00:03:53,590
أنتِ قبيحة

55
00:03:53,960 --> 00:03:55,770
أهذه أنا؟

56
00:04:04,030 --> 00:04:05,390
تذكّرتُ الآن

57
00:04:06,220 --> 00:04:08,190
كانت تلك حياتي السّابقة

58
00:04:06,560 --> 00:04:08,190
خاتم لابيس لازولي

59
00:04:09,020 --> 00:04:12,340
وتلك الآنسة الصّغيرة ذات
...السّلوك البغيض هي

60
00:04:15,360 --> 00:04:17,530
...لا... أنا

61
00:04:18,330 --> 00:04:19,700
شرّيرة؟

62
00:04:20,240 --> 00:04:24,460
...تجسّدتُ من جديد كشرّيرة

63
00:04:25,230 --> 00:04:26,540
استيقظتِ؟

64
00:04:27,580 --> 00:04:28,850
!سموّك

65
00:04:28,850 --> 00:04:30,450
ينبغي أن تنامي أكثر

66
00:04:30,830 --> 00:04:33,840
أجهّز عربة لكِ الآن

67
00:04:34,380 --> 00:04:37,840
هارتنايتس لابيسلازولي لاكتوموت

68
00:04:34,550 --> 00:04:37,840
الأمير الأوّل لمملكة لابيس لازولي

69
00:04:37,840 --> 00:04:41,160
إنّه المسار الرّئيسيّ في لعبة الأوتومي

70
00:04:41,160 --> 00:04:43,930
والأمير الأوّل لمملكة لابيس لازولي

71
00:04:44,720 --> 00:04:49,690
!شخصيّة في اللّعبة الّتي لعبتُها أمامي

72
00:04:49,690 --> 00:04:52,390
هذه أوّل مرّة تغيبين فيها عن الوعي

73
00:04:53,520 --> 00:04:58,030
كنتِ تحاولين لفت انتباهي لأنّني
كنتُ أهتمّ بأكاري كثيراً؟

74
00:04:58,030 --> 00:04:59,030
ماذا؟

75
00:04:59,840 --> 00:05:01,300
نظراته جافّة

76
00:05:02,430 --> 00:05:05,910
إنّه ليس كهارتنايتس الّذي في اللّعبة

77
00:05:07,530 --> 00:05:10,740
لا. يبدو أنّني مريضة

78
00:05:10,740 --> 00:05:12,820
أعتذر على الإزعاج

79
00:05:12,820 --> 00:05:16,210
حسناً، أنا خطيبكِ عمليّاً

80
00:05:16,660 --> 00:05:18,100
"عمليّاً"

81
00:05:18,710 --> 00:05:22,930
،أعلم بأنّ غداً هو حفل التخرّج
لكن لديّ عمل يجب القيام به

82
00:05:23,410 --> 00:05:27,180
أعتذر، لكن لا أعتقد بأنّني
سأتمكّن من مُرافقتك إلى هناك

83
00:05:27,930 --> 00:05:29,940
فهمت

84
00:05:35,190 --> 00:05:39,810
هل هناك إهانة أعظم من عدم مُرافقة
الخطيب لخطيبته إلى حفلة؟

85
00:05:40,850 --> 00:05:45,240
لكن أعرف ما يحدث في القصّة
،من الآن فصاعداً

86
00:05:45,240 --> 00:05:48,240
خاتم لابيس لازولي

87
00:05:45,590 --> 00:05:47,820
لأنّني لعبتُ اللّعبة مرّات كثيرة

88
00:05:48,980 --> 00:05:50,790
المسار الرّئيسيّ في اللّعبة

89
00:05:50,790 --> 00:05:54,200
هو وليّ عهد مملكة لابيس
لازولي، هارتنايتس

90
00:05:54,570 --> 00:05:59,460
تلتحق البطلة بالأكاديميّة بسحرها
،القويّ، الصّلاة المُقدّسة

91
00:05:59,460 --> 00:06:01,010
وتلتقي بهارتنايتس

92
00:06:03,470 --> 00:06:05,570
،إنّه التّلميذ الأكثر شعبيّة هناك

93
00:06:05,570 --> 00:06:09,370
ويُمطر البطلة بالودّ والعطف دوماً

94
00:06:10,370 --> 00:06:12,080
،يبتسم لها بطفل

95
00:06:12,670 --> 00:06:14,870
...ويهمس في أذنها عبارات جميلة

96
00:06:15,610 --> 00:06:20,620
وبعد مشهد النّهاية، يقيمون زفافاً
مهيباً في الكاتدرائيّة

97
00:06:28,860 --> 00:06:32,390
لكنّني لستُ البطلة

98
00:06:32,390 --> 00:06:33,940
أنا الشّرّيرة

99
00:06:35,420 --> 00:06:38,420
!اعرفي حجمكِ! أنتِ من العوام

100
00:06:35,540 --> 00:06:38,420
!اعرفي حجمكِ
!أنتِ من العوام

101
00:06:35,540 --> 00:06:41,130
تياراروز

102
00:06:38,420 --> 00:06:41,130
أنا أنسب لسموّه

103
00:06:39,040 --> 00:06:43,170
الشّرّيرة تياراروز تُعامل البطلة بقسوة

104
00:06:41,130 --> 00:06:43,170
تياراروز

105
00:06:41,130 --> 00:06:43,170
!أنتِ تعترضين طريقي! ابتعدي

106
00:06:43,170 --> 00:06:45,800
لأنّها لا تريد أن تخسر الأمير

107
00:06:46,170 --> 00:06:50,130
في حفلة التخرُّج، أُدينت باحتقارها للبطلة

108
00:06:50,130 --> 00:06:51,760
وفُسِخت الخطوبة

109
00:06:52,310 --> 00:06:55,770
تياراروز

110
00:06:52,310 --> 00:06:55,770
!كم هذا مُغيظ

111
00:06:55,770 --> 00:06:58,160
لكن لم أفعل شيئاً بتلك القسوة

112
00:06:58,160 --> 00:07:01,440
أرغب في تجنُّب حدث الإدانة
...إن استطعت، لكن

113
00:07:02,300 --> 00:07:04,380
اليوم هو اليوم الّذي يسبق نهاية اللّعبة

114
00:07:04,380 --> 00:07:06,600
حدث الإدانة لا يمكن تجنّبه في هذه اللّحظة

115
00:07:07,090 --> 00:07:08,950
لا ينتظرني سوى نهاية سيّئة

116
00:07:12,250 --> 00:07:16,340
ماذا يحدث للشرّيرة بعد حدث الإدانة؟

117
00:07:17,390 --> 00:07:18,960
:أعرف هذا القدر

118
00:07:19,380 --> 00:07:25,010
لا نهاية سعيدة حيث ينتهي المطاف
بالشرّيرة مع شخص

119
00:07:29,270 --> 00:07:32,010
أهلاً بعودتكِ يا تياراروز-ساما

120
00:07:30,010 --> 00:07:33,890
فيليني سانفيست

121
00:07:32,010 --> 00:07:33,890
شكراً لكِ يا فيليني

122
00:07:34,590 --> 00:07:39,640
اسم لابيس هو شرف يُمنح لعائلات

123
00:07:39,640 --> 00:07:42,900
أولئك الّذين يُقدّمون أعمالَ خير
عظيمة للعائلة الملكيّة

124
00:07:43,310 --> 00:07:44,940
أهلاً بعودتكِ يا تياراروز

125
00:07:44,940 --> 00:07:46,220
أهلاً بعودتكِ

126
00:07:46,220 --> 00:07:47,810
شكراً لكما

127
00:07:48,390 --> 00:07:51,660
ما الأمر؟ نادراً ما تُرحّبان بي في المنزل شخصيّاً

128
00:07:51,660 --> 00:07:55,160
رئيس الوزراء

129
00:07:51,660 --> 00:07:55,160
شناوس لابيس كلامينتايل

130
00:07:51,660 --> 00:07:55,160
إيلتيانا لابيس كلامينتايل

131
00:07:52,010 --> 00:07:56,730
وجدنا زينة جميلة يمكنكِ ارتداءها
في حفل زفافكِ مع الأمير

132
00:07:56,730 --> 00:07:58,400
كنتُ مُتحمّسة جدّاً لأُريكِ

133
00:07:58,400 --> 00:08:00,800
وتلقّينا بعض الحلويّات الّتي تُحبّينها

134
00:08:00,800 --> 00:08:01,920
لنأكلها معاً

135
00:08:02,270 --> 00:08:05,680
لن تسنح لكِ المزيد من الفُرص
لأكل حلويّات

136
00:08:05,680 --> 00:08:08,510
يا عزيزي، من المُبكّر جدّاً البُكاء

137
00:08:08,510 --> 00:08:13,810
أعلم ذلك. سأفتقد لتيارا، لكن
الأولويّة لسعادتها

138
00:08:14,340 --> 00:08:18,110
،كابنة الماركيز الّذي مُنح اسم لابيس

139
00:08:18,110 --> 00:08:22,060
كنتُ أخضع لتدريب لأصبح
ملكة منذ كنتُ صغيرة

140
00:08:22,870 --> 00:08:24,840
،بصفتي خطيبة وليّ العهد

141
00:08:24,840 --> 00:08:28,070
عملتُ جاهدة لدراسة مُختلَف
أنواع المواد

142
00:08:28,570 --> 00:08:31,530
إذا بدا وكأنّ زوجكِ على وشك
،أن يسلك طريقاً خاطئاً

143
00:08:31,530 --> 00:08:33,330
احرصي على تقويمه

144
00:08:33,330 --> 00:08:36,150
أبي، رئيس الوزراء، علّمني ذلك

145
00:08:36,690 --> 00:08:39,190
،لعلّ ذلك كان شاقّاً أحياناً

146
00:08:39,190 --> 00:08:42,150
لكن فعلتُ كلّ شيء بدافع الحُبّ
للأمير هارتنايتس

147
00:08:43,130 --> 00:08:47,180
لكن... يبدو أنّ ذلك لم يُلامس
مشاعر الأمير هارتنايتس

148
00:08:48,120 --> 00:08:50,750
...أحببتُ شخصيّته أيضاً

149
00:08:51,580 --> 00:08:55,590
ربّما سأتغيّب عن حفلة تخرُّج يوم غد

150
00:08:56,130 --> 00:08:57,560
لا، لا أستطيع

151
00:08:57,560 --> 00:09:02,650
سيعطي هذا صورة سيّئة عن ابنة الماركيز
إذا غاب اسم لابيس

152
00:09:03,130 --> 00:09:07,280
آخر شيء أتمنّى فعله هو أن أُسبّب
مُشكلة لأمّي وأبي العزيزين

153
00:09:08,260 --> 00:09:12,050
تغيُّر مشاعر هارتنايتس يتماشى
مع قصّة اللّعبة

154
00:09:12,050 --> 00:09:15,870
لا أستطيع تغيير دوري كشرّيرة أيضاً

155
00:09:17,790 --> 00:09:21,000
لو كنتُ البطلة، لحظيتُ بنهاية سعيدة

156
00:09:21,000 --> 00:09:23,970
...لكن لا أعلم ما الّذي سيجري لي الآن

157
00:09:27,950 --> 00:09:30,200
ماذا سيحدث لي؟

158
00:09:39,830 --> 00:09:41,420
...آنسة تياراروز

159
00:09:50,610 --> 00:09:53,640
...لو سمحتِ لي

160
00:10:05,880 --> 00:10:09,880
!تمادت أكاري-ساما في سلوكها

161
00:10:09,880 --> 00:10:11,360
!بالفعل

162
00:10:11,360 --> 00:10:14,320
كيف تجرؤ على التعلُّق بالأمير هارتنايتس

163
00:10:14,320 --> 00:10:16,860
بينما خطيبته، تياراروز-ساما، موجودة هنا؟

164
00:10:16,860 --> 00:10:21,630
!مهما حدث يا تياراروز-ساما، نحن بجانبكِ

165
00:10:21,630 --> 00:10:25,090
شكراً جزيلاً. هذا مُطمئن جدّاً

166
00:10:30,920 --> 00:10:35,580
حدث الإدانة الّذي نُسمّيه جميعاً
حفلة تخرُّج سيبدأ قريباً

167
00:10:35,990 --> 00:10:39,370
هيّأتُ نفسي لهذا، لكن ما زلتُ خائفة

168
00:10:39,870 --> 00:10:41,410
...تياراروز-ساما

169
00:10:41,740 --> 00:10:47,920
ربّما ينبغي أن أتواصل مع مولايّ
وأطلب منه مُرافقتكِ؟

170
00:10:47,920 --> 00:10:50,040
لا مُشكلة يا فيليني

171
00:10:50,040 --> 00:10:52,650
لدى أبي طريقته في العمل

172
00:10:52,650 --> 00:10:54,530
لا أريد إزعاجه

173
00:10:54,530 --> 00:10:55,680
...أجل، لكن

174
00:10:55,680 --> 00:10:58,040
رغم ذلك... معكِ حقّ

175
00:10:58,040 --> 00:11:03,470
إذا رأني أبي أدخل الحفلة
،من دون مُرافق

176
00:11:03,470 --> 00:11:06,020
فسيستشيط غضباً بكلّ تأكيد

177
00:11:03,770 --> 00:11:06,020
أبي الشّغوف زيادة عن اللّزوم

178
00:11:06,660 --> 00:11:10,150
ما زلتُ قلقة بشأنكِ يا تياراروز-ساما

179
00:11:11,230 --> 00:11:13,320
سأكون بخير فحسب

180
00:11:16,030 --> 00:11:18,460
!يبدو شهيّاً

181
00:11:18,460 --> 00:11:20,630
من فضلكِ، كُلي ما تشائين

182
00:11:20,630 --> 00:11:22,120
!بكلّ سرور

183
00:11:26,910 --> 00:11:28,350
!شهيّة

184
00:11:29,200 --> 00:11:33,510
أحببتُ الخَبز وأكل الحلويّات
منذ حياتي السّابقة

185
00:11:34,020 --> 00:11:37,720
أكل حلويّات شهيّة يُسعدني

186
00:11:42,960 --> 00:11:47,230
،أملتُ أن يرسم هذا البسمة في وجهكِ
ولو للحظات فقط

187
00:11:47,230 --> 00:11:48,780
...فيليني

188
00:11:55,340 --> 00:11:57,840
،لا أستطيع تجنُّب حدث الإدانة

189
00:11:57,840 --> 00:12:00,120
!لذا لا جدوى من الجلوس خائفة

190
00:12:00,120 --> 00:12:01,670
!يجب عليّ بذل قصارى جهدي

191
00:12:05,120 --> 00:12:08,120
تيارا-ساما! هل أنتِ بخير؟

192
00:12:08,120 --> 00:12:12,020
أكاري-ساما، لا يجوز أن تدخلي
!من دون سابق إنذار

193
00:12:12,020 --> 00:12:14,830
حسناً، طاب يومكِ يا أكاري-ساما

194
00:12:14,830 --> 00:12:17,630
وشكراً على اهتمامكِ

195
00:12:17,630 --> 00:12:20,400
طاب يومكِ يا تيارا-ساما

196
00:12:18,090 --> 00:12:22,640
أكاري

197
00:12:20,400 --> 00:12:25,720
أنا متأكّدة بأنّها بطلة لعبة الأوتومي
خاتم لابيس لازولي

198
00:12:26,460 --> 00:12:28,840
...فُستان فاخر وظريف

199
00:12:28,840 --> 00:12:30,760
...مُجوهرات لامعة

200
00:12:31,230 --> 00:12:33,360
...وطبيعة ملاك لطيفة

201
00:12:33,770 --> 00:12:37,050
إنّها تُجسّد كلّ ما يتوقّعه المرء
من بطلة اللّعبة

202
00:12:38,320 --> 00:12:42,160
كنتُ قلقة بعد أن انهرتِ فجأة
في غرفة الصّفّ البارحة

203
00:12:42,680 --> 00:12:45,170
كان الأمير هارتنايتس قلقاً كذلك

204
00:12:45,170 --> 00:12:46,790
إنّه لطيفٌ جدّاً، أليس كذلك؟

205
00:12:47,240 --> 00:12:49,580
أعتذر لإثارة قلقكِ

206
00:12:51,290 --> 00:12:53,060
الأمير هارتنايتس

207
00:12:59,040 --> 00:13:01,040
طاب يومك، سموّك

208
00:13:01,040 --> 00:13:05,380
شكراً. كانت أكاري قلقة بعد
أن غبتِ عن الوعي

209
00:13:05,380 --> 00:13:09,550
كيف حالكِ؟ هل ستحضرين حفلة التخرُّج؟

210
00:13:09,550 --> 00:13:14,060
،أجل، ارتحتُ جيّداً في اللّيلة الماضية
لذا لن تكون تلك مُشكلة

211
00:13:14,060 --> 00:13:17,300
!من المُطمئن رؤيتكِ على ما يُرام

212
00:13:17,300 --> 00:13:19,570
أليس كذلك يا سموّ الأمير هارتنايتس؟

213
00:13:19,570 --> 00:13:20,820
أجل، بالفعل

214
00:13:21,360 --> 00:13:26,190
فيليني، سنُرتّب التّحضيرات النّهائيّة
قريباً إذا أردتُ الحضور في الوقت

215
00:13:26,190 --> 00:13:27,370
بالطّبع

216
00:13:27,370 --> 00:13:31,950
ماذا؟! تيارا-ساما، لستِ جاهزة بعد؟

217
00:13:32,290 --> 00:13:35,040
يبدو أنّنا وصلنا في وقت انشغالها

218
00:13:35,590 --> 00:13:37,840
نستأذن بالانصراف الآن

219
00:13:38,160 --> 00:13:39,140
حسناً

220
00:13:54,790 --> 00:13:58,150
حالما يُفتَح هذا الباب، ستبدأ

221
00:14:08,380 --> 00:14:11,610
تياراروز لابيس كلامينتايل تدخل القاعة

222
00:14:13,410 --> 00:14:14,660
لقد بدأت

223
00:14:18,760 --> 00:14:20,190
كما في اللّعبة تماماً

224
00:14:21,050 --> 00:14:22,680
ما الّذي يجري؟

225
00:14:22,680 --> 00:14:25,140
لماذا تدخل تياراروز-ساما لوحدها؟

226
00:14:25,140 --> 00:14:28,260
من تلك الفتاة الّتي بجانب الأمير؟

227
00:14:29,190 --> 00:14:32,520
تياراروز، أعلن هاهنا

228
00:14:32,520 --> 00:14:35,400
!عن فسخ خطوبتي بكِ

229
00:14:46,650 --> 00:14:50,080
هلّا أخبرتني عن السّبب؟

230
00:14:50,080 --> 00:14:51,510
السّبب؟

231
00:14:51,510 --> 00:14:55,210
تياراروز، لِمَ لا تسألين نفسكِ؟

232
00:14:55,210 --> 00:15:00,210
لا أعرف السّبب. لم أفعل شيئاً
يستحقّ خزياً كهذا

233
00:15:01,470 --> 00:15:05,390
،إذا أردت اتّخاذ فتاة أُخرى كعقيلة لك

234
00:15:05,860 --> 00:15:09,470
أليست هناك إجراءات مُناسبة عليك اتّباعها؟

235
00:15:09,470 --> 00:15:12,790
كيف تجرئين على الردّ على عضو
!في العائلة الملكيّة؟

236
00:15:12,790 --> 00:15:15,580
قلتِ كلاماً قاسياً كثيراً لأكاري

237
00:15:15,580 --> 00:15:18,060
!بعد أن علمتِ بأنّها ترعرعت في الرّيف

238
00:15:18,060 --> 00:15:22,300
،بدا أنّها غير مُدركة لقوانين مملكتنا

239
00:15:22,300 --> 00:15:24,190
لذا علّمتُها بضعة أشياء فحسب

240
00:15:24,190 --> 00:15:29,690
حسناً، سمعتُ بأنّكِ طلبتِ منها
!الرّكوع عند التّرحيب بي

241
00:15:29,690 --> 00:15:33,280
هذا لأنّ سموّك هو وليّ العهد

242
00:15:33,280 --> 00:15:37,210
أليس من المنطقيّ أن تركع
!عند التّرحيب بك؟

243
00:15:37,210 --> 00:15:39,960
!وقلتِ لها ألّا ترقص معي أيضاً

244
00:15:39,960 --> 00:15:44,460
هذا لأنّها كانت قد رقصتْ معك
بالفعل أكثر من مرّتين

245
00:15:45,220 --> 00:15:47,900
هذا شيء لا يفعله سوى خطيبتك

246
00:15:49,330 --> 00:15:56,520
لا تقل لي بأنّك لا تعلم ذلك؟

247
00:15:58,060 --> 00:16:02,230
لـ-لكن قالت أكاري بأنّكِ
!قاسية معها دوماً

248
00:16:03,350 --> 00:16:06,240
مهما دافعتُ عن براءتي فهذا
لن يُجدي نفعاً

249
00:16:07,000 --> 00:16:11,470
سواء لأنّ البطلة سيطرت عليه
،أو لأنّه تعديل للّعبة

250
00:16:11,470 --> 00:16:13,880
يسير كلّ شيء وفق القصّة في النّهاية

251
00:16:13,880 --> 00:16:16,580
أعتقد بأنّ النّهاية لا يمكن تغييرها
في نهاية المطاف

252
00:16:19,000 --> 00:16:23,860
إذاً قلبك ينتمي لأكاري-ساما؟

253
00:16:24,830 --> 00:16:27,670
أتقبلين فسخ خطوبتنا؟

254
00:16:27,670 --> 00:16:29,010
أجل

255
00:16:29,010 --> 00:16:31,890
إذاً أعلن هاهنا عن فسخ خطوبتنا

256
00:16:31,890 --> 00:16:34,270
وأتقدّم لخطبة أكاري

257
00:16:34,270 --> 00:16:37,930
بصيغة أُخرى، ستكون أكاري
!الملكة المُستقبليّة

258
00:16:39,710 --> 00:16:40,980
انتهى الأمر

259
00:16:41,660 --> 00:16:45,110
،وما زال لديّ والدَي اللّطيفين

260
00:16:45,110 --> 00:16:48,040
وكذلك فيليني وصديقاتي

261
00:16:48,040 --> 00:16:49,760
—لم أخسر كلّ شيء

262
00:16:49,760 --> 00:16:52,690
...جريمة أذيّة الملكة المُستقبليّة

263
00:16:53,370 --> 00:16:55,460
!ليست جريمة يمكن غفرانها

264
00:16:55,920 --> 00:16:57,120
ماذا؟

265
00:16:57,120 --> 00:17:01,760
لذلك يا تياراروز، أعلن عن نفيكِ
!من هذه المملكة؟

266
00:17:02,870 --> 00:17:05,070
نفيي... أنا؟

267
00:17:05,070 --> 00:17:07,670
!لا... هذا شديد القسوة

268
00:17:08,620 --> 00:17:10,720
لا أستطيع عصيان وليّ العهد

269
00:17:11,230 --> 00:17:15,060
إذا تمّ نفيي، فلن أتمكّن من رؤية
أحد منهم ثانية

270
00:17:15,590 --> 00:17:19,560
...لا أبي ولا أمّي، أو حتّى فيليني

271
00:17:22,720 --> 00:17:25,480
!لا

272
00:17:28,380 --> 00:17:30,050
هذا يكفي

273
00:17:52,180 --> 00:17:55,010
هل أنتِ بخير يا آنسة تياراروز؟

274
00:17:56,270 --> 00:17:58,360
الأمير أكواستيد؟

275
00:17:59,460 --> 00:18:02,160
...الأمير الأوّل لمملكة مارينفوريست

276
00:18:01,390 --> 00:18:07,320
الأمير الأوّل لمملكة مارينفوريست

277
00:18:01,390 --> 00:18:07,320
أكواستيد مارينفوريست

278
00:18:02,160 --> 00:18:03,550
أكواستيد

279
00:18:03,990 --> 00:18:06,340
إنّه الشّخصيّة الرّئيسيّة في تتمّة اللّعبة

280
00:18:06,340 --> 00:18:09,680
وقعتُ في الحُبّ حالما رأيتُه
تصميمه أوّل مرّة

281
00:18:09,680 --> 00:18:14,670
لكن مُتُّ قبل أن تصدر التتمّة حتّى

282
00:18:15,160 --> 00:18:18,360
ماذا يفعل الأمير أكواستيد هنا؟

283
00:18:18,360 --> 00:18:20,160
لا مُشكلة. قفي مُعتزّة

284
00:18:20,870 --> 00:18:24,920
أنتِ، وبكلّ كبريائكِ، أكثر استقامة
...من أيّ شخص هنا

285
00:18:25,190 --> 00:18:26,350
وأكثر جمالاً

286
00:18:28,670 --> 00:18:32,420
الأمير أكواستيد، آمل ألّا تتدخّل في هذا الأمر

287
00:18:32,760 --> 00:18:35,680
!يجب أن تُدان لجرائمها

288
00:18:36,050 --> 00:18:37,380
تُدان؟

289
00:18:37,380 --> 00:18:41,560
يبدو لي أنّ كلامك كان أقسى
بكثير من كلامها

290
00:18:42,930 --> 00:18:47,300
،فسخ خطوبتكما في حفلة تخرُّج
،حدث احتفاليّ

291
00:18:47,300 --> 00:18:49,860
وانتقاد امرأة وحيدة أمام الجميع

292
00:18:49,860 --> 00:18:51,430
...وإهانتها

293
00:18:52,040 --> 00:18:54,610
ليست أشياء ينبغي لوليّ عهد أن يفعلها

294
00:18:54,610 --> 00:18:57,700
!ما-ما شأنك أنت؟

295
00:18:58,090 --> 00:18:59,860
إنّه شأني

296
00:19:01,210 --> 00:19:02,330
وكلّ الشّأن

297
00:19:04,580 --> 00:19:06,710
فُسِخت خطوبتكما الآن، صحيح؟

298
00:19:11,380 --> 00:19:16,470
آنسة تياراروز، هلّا صرتِ عقيلتي؟

299
00:19:16,470 --> 00:19:17,940
ماذا؟

300
00:19:19,470 --> 00:19:25,470
أردتُ باستماتة أن أجعلكِ مُلكي
منذ فترة طويلة

301
00:19:26,500 --> 00:19:28,760
ماذا؟ منذ... فترة طويلة؟

302
00:19:29,740 --> 00:19:33,320
لحظة، لماذا يتقدّم لخطبتي أمير
من جزء تتمّة؟

303
00:19:33,840 --> 00:19:35,490
!لحظة، يتقدّم للخطبة؟

304
00:19:38,270 --> 00:19:42,240
أنا متأكّد بأنّ تقدُّمي لخطبتكِ
كان مُفاجئاً بالنّسبة لكِ

305
00:19:43,100 --> 00:19:46,710
لكن هلّا فكّرتِ في الأمر رجاء؟

306
00:20:17,800 --> 00:20:19,490
شكراً لك

307
00:20:20,590 --> 00:20:24,790
إنّ معرفة شعورك أسعدني كثيراً

308
00:20:25,290 --> 00:20:26,540
!انتظر

309
00:20:28,180 --> 00:20:29,710
!هذا لا يُصدَّق

310
00:20:30,200 --> 00:20:34,910
كانت تيارا-ساما خطيبة الأمير هارتنايتس
!قبل لحظات مضت

311
00:20:34,910 --> 00:20:37,220
!لماذا تختارها؟

312
00:20:37,610 --> 00:20:41,010
تيارا-ساما قاسية جدّاً وعدائيّة

313
00:20:41,010 --> 00:20:43,180
!إنّها غير مُلائمة لك

314
00:20:43,180 --> 00:20:46,350
!لذا من فضلك... تعال وانضمّ لنا

315
00:20:46,670 --> 00:20:48,090
!أكاري-ساما

316
00:20:48,090 --> 00:20:51,220
الأمير أكواستيد هو وليّ عهد
!المملكة المُجاورة لنا

317
00:20:51,220 --> 00:20:54,210
!لا يجوز أن تلمسيه هكذا ببساطة

318
00:20:54,210 --> 00:20:56,460
!ابتعدي عنه رجاء

319
00:20:56,460 --> 00:20:59,060
—لا! لن أدعكِ تحصلين على الأمير أكوا

320
00:21:00,470 --> 00:21:05,650
،شكراً لكِ على إظهار هذا الاهتمام لي
يا آنسة تياراروز

321
00:21:06,340 --> 00:21:07,450
...إطلاقاً

322
00:21:08,510 --> 00:21:11,330
أنا الأمير الأوّل لمارينفوريست

323
00:21:11,810 --> 00:21:14,130
تعلمين هذا، ومع ذلك تختارين
التصرُّف بهذه الطّريقة؟

324
00:21:14,130 --> 00:21:15,820
ما-ماذا؟

325
00:21:16,690 --> 00:21:19,710
لكنّك لطيف جدّاً يا سموّ الأمير أكوا

326
00:21:19,710 --> 00:21:21,760
...مُحال أن تغضب لمثل هذا

327
00:21:21,760 --> 00:21:24,010
إنّها تُقلّل من احترامي. خذوها بعيداً

328
00:21:24,010 --> 00:21:24,880
ماذا؟

329
00:21:24,880 --> 00:21:26,870
!ماذا؟ لكن لماذا؟

330
00:21:26,870 --> 00:21:29,520
!ماذا؟

331
00:21:31,010 --> 00:21:35,850
يبدو أنّني سبّبتُ فوضى بإقحام
نفسي بشكل مُفاجئ

332
00:21:35,850 --> 00:21:39,080
أعتذر يا آنسة تياراروز

333
00:21:39,080 --> 00:21:43,090
لا عليك. أنا من ينبغي أن يشكرك
على مُساعدتك لي

334
00:21:44,350 --> 00:21:46,780
سأُساعدكِ في أيّ وقت

335
00:21:49,730 --> 00:21:53,000
ينبغي أن نكون تجاوزنا نهاية
...اللّعبة بالفعل

336
00:21:53,000 --> 00:21:55,380
!ما الّذي سيجري الآن؟

337
00:23:31,600 --> 00:23:35,600
لم أتخيّل يوماً أن يتقدّم الأمير
...أكواستيد لخطبتي

338
00:23:35,600 --> 00:23:39,050
سموّك، لا تُدلّلني كثيراً رجاء