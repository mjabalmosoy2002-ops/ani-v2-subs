1
00:00:06,960 --> 00:00:09,070
أنتِ تياراروز إذاً؟

2
00:00:10,380 --> 00:00:14,830
شرف لي أن ألتقي بك يا ملك جنّيي الغابة

3
00:00:14,830 --> 00:00:17,320
يمكنكِ أن تُناديني كيث

4
00:00:17,320 --> 00:00:21,270
يبدو أنّ جنّيات الغابة مُعجبات بكِ

5
00:00:21,270 --> 00:00:23,660
أنا مُمتنّة ومسرورة لأنّني
حصلتُ على استحسانهن

6
00:00:27,690 --> 00:00:29,490
مُثير

7
00:00:29,490 --> 00:00:33,260
تيارا، روحكِ غير عاديّة إطلاقاً

8
00:02:11,990 --> 00:02:16,370
،إنّها روحٌ غير مُستقرّة إطلاقاً
لكنّها جميلة أيضاً

9
00:02:16,670 --> 00:02:19,040
ورائحتها لطيفة

10
00:02:20,450 --> 00:02:21,580
...الملك كيث

11
00:02:21,580 --> 00:02:24,290
ربّما هذا ما تشمّه

12
00:02:24,950 --> 00:02:27,650
لا داعي لـ"ملك". ناديني كيث ببساطة

13
00:02:27,650 --> 00:02:28,670
...لكن

14
00:02:28,670 --> 00:02:29,620
افعليها

15
00:02:29,620 --> 00:02:31,760
حـ-حسناً

16
00:02:31,760 --> 00:02:34,430
!يا له من ملك جنّيين أنانيّ

17
00:02:35,890 --> 00:02:38,470
فهمت. بسكويت إذاً؟

18
00:02:40,450 --> 00:02:44,390
ماذا؟ يحتوي هذا على سحرك حسبما أرى

19
00:02:44,390 --> 00:02:48,190
،أجل. إنّه ليس سحراً قويّاً

20
00:02:48,190 --> 00:02:50,440
لكن أستطيع استخدامه مع
الحلويّات الّتي أُعدّها

21
00:02:52,690 --> 00:02:54,650
على أيّ حال، إنّه لذيذ جدّاً

22
00:02:54,910 --> 00:02:55,710
—الملك كيـ

23
00:02:55,710 --> 00:02:56,670
كيث

24
00:02:57,760 --> 00:03:00,810
يسرّني أنّه نال إعجابك يا كيث

25
00:03:01,160 --> 00:03:02,200
حسناً

26
00:03:02,200 --> 00:03:05,560
بخلاف البشر، الجنّيون أحرار

27
00:03:05,560 --> 00:03:07,880
نستخدم أيّ اسم نشاء

28
00:03:07,880 --> 00:03:09,740
هكذا يبدو

29
00:03:10,090 --> 00:03:13,880
ليتني أستطيع العيش كجنّية كذلك

30
00:03:14,270 --> 00:03:16,480
ما الأمر؟ هل هناك ما يؤرقكِ؟

31
00:03:17,200 --> 00:03:18,300
لا

32
00:03:18,720 --> 00:03:21,190
لدى البشر أشياء كثيرة تُقيّدهم

33
00:03:21,190 --> 00:03:23,770
كنتُ أفكّر في مدى صعوبة ذلك

34
00:03:25,840 --> 00:03:27,130
استرخي

35
00:03:28,520 --> 00:03:32,150
إذا أصابكِ أيّ مكروه، فسأكون قوّتكِ

36
00:03:34,290 --> 00:03:36,150
شكراً لك

37
00:03:37,980 --> 00:03:42,450
شكراً على الاقتطاع من وقتك
لمُقابلتي اليوم

38
00:03:42,450 --> 00:03:47,210
أنا من ينبغي أن أشكركِ. دائماً
ما تكونين الشّخص الّذي يُعينني

39
00:03:47,600 --> 00:03:49,460
لا شكر على واجب

40
00:03:49,460 --> 00:03:53,090
على ذكر الأمر، من غير المألوف
أن تتحوّلي إلى آيشيلا-ساما

41
00:03:53,090 --> 00:03:56,380
لمسائل لا صِلة لها بالعمل

42
00:03:57,200 --> 00:03:59,340
أشير إلى زينة الشّعر

43
00:03:59,750 --> 00:04:03,120
أريد أن أمنح تيارا أفضل شيء
في نهاية المطاف

44
00:04:03,920 --> 00:04:09,020
وحتّى أنّك سهرت اللّيل كلّه
كي ترسم التّصميم بنفسك

45
00:04:09,020 --> 00:04:10,790
كنتَ تعلم بذلك؟

46
00:04:10,790 --> 00:04:12,360
أنا خادمك

47
00:04:14,090 --> 00:04:15,810
أحسد تياراروز-ساما

48
00:04:15,810 --> 00:04:19,990
الرّجل الّذي يحبّها مُولع جدّاً بها

49
00:04:21,070 --> 00:04:23,110
سموّك، إنّه تارمو

50
00:04:23,110 --> 00:04:24,110
ادخل

51
00:04:24,980 --> 00:04:26,160
المعذرة

52
00:04:26,830 --> 00:04:29,610
ما الأمر؟ أين تيارا؟

53
00:04:31,080 --> 00:04:33,760
إذاً أنتِ ملكة مُستقبليّة؟

54
00:04:33,760 --> 00:04:36,280
لم يُقرَّر ذلك بعد

55
00:04:36,280 --> 00:04:39,090
أنا خطيبة الأمير فقط

56
00:04:39,980 --> 00:04:42,990
البشر مُعقّدون للغاية

57
00:04:42,990 --> 00:04:46,080
إنّه الملك المُستقبليّ، أليس كذلك؟
كيف هو طبعه؟

58
00:04:46,080 --> 00:04:48,600
أجل. الأمير أكواستيد لطيفٌ جدّاً

59
00:04:48,890 --> 00:04:52,800
ويحظى بدعم شعبه الرّاسخ

60
00:04:52,800 --> 00:04:56,110
إنّه أروع بكثير ممّا أستحقّ

61
00:04:59,000 --> 00:05:01,240
!لحظة، كم السّاعة الآن؟

62
00:05:01,240 --> 00:05:03,590
!يـ-يجب عليّ العودة

63
00:05:03,590 --> 00:05:05,450
أين المخرج؟

64
00:05:07,580 --> 00:05:09,050
سآخذكِ إلى هناك

65
00:05:09,050 --> 00:05:10,050
ماذا؟

66
00:05:15,230 --> 00:05:17,290
غـ... غرفتي؟

67
00:05:17,750 --> 00:05:19,550
ملك الجنّيين مُؤتمن حقّاً

68
00:05:19,840 --> 00:05:22,420
استخدمَ تعويذة الانتقال الآنيّ
الصّعبة تلك بسهولة

69
00:05:23,800 --> 00:05:25,050
!تيارا

70
00:05:27,240 --> 00:05:28,610
!من أنت؟

71
00:05:30,870 --> 00:05:32,560
!ابتعد عن تيارا

72
00:05:34,140 --> 00:05:36,400
لا بُدّ أنّك أكواستيد

73
00:05:38,690 --> 00:05:42,310
أنا أنسب لكِ من هذا الرّجل

74
00:05:43,010 --> 00:05:45,030
!توقّف عن ذلك من فضلك يا ملك الجنّيين

75
00:05:45,880 --> 00:05:47,030
!ملك الجنّيين؟

76
00:05:50,620 --> 00:05:53,610
لم أكن أعلم بأنّك ملك جنّيين

77
00:05:53,610 --> 00:05:56,670
أعتذر لأنّني أشهرتُ سيفي عليك

78
00:05:56,670 --> 00:05:58,770
حسنٌ إذاً. أُسامحك

79
00:05:58,770 --> 00:06:01,110
فأنا بمزاج جيّد الآن

80
00:06:01,530 --> 00:06:05,430
لكن تياراروز خطيبتي

81
00:06:07,990 --> 00:06:09,750
التقرُّب منها

82
00:06:09,750 --> 00:06:12,890
يبدو عملاً غير وقور بالنّسبة لملك جنّيين

83
00:06:12,890 --> 00:06:16,800
ما هذا الّذي أراه؟ إنّه يحبّكِ
حُبّاً جمّاً يا تيارا

84
00:06:17,570 --> 00:06:20,900
!ما فعلتَه هو ما أدّى إلى سوء فهمه يا كيث

85
00:06:23,440 --> 00:06:24,570
لا يهمّ

86
00:06:24,960 --> 00:06:27,070
سأنصرف لليوم

87
00:06:30,110 --> 00:06:32,900
،إذا ضاقتِ بكِ الحياة كثيراً
فتواصلي معي في أيّ وقت

88
00:06:33,330 --> 00:06:35,540
سأساعدكِ كعربون شكر على البسكويت

89
00:06:36,560 --> 00:06:37,930
...كيث

90
00:06:40,830 --> 00:06:42,440
...ا-المعذرة

91
00:06:48,930 --> 00:06:50,640
...المعذرة، أنا

92
00:06:50,640 --> 00:06:52,290
أخبرني تارمو

93
00:06:52,290 --> 00:06:54,930
جنّيات الغابة قد أخذنَكِ، صحيح؟

94
00:06:54,930 --> 00:06:59,650
!أ-أجل! أنا آسفة جدّاً لأنّني أثرتُ قلقك

95
00:06:59,920 --> 00:07:03,170
مُحال أن أغضب منكِ بسبب ذلك

96
00:07:03,650 --> 00:07:06,660
لا، من الواضح أنّه غاضب

97
00:07:06,660 --> 00:07:10,410
أتعتقدينني غاضباً يا تيارا؟

98
00:07:16,330 --> 00:07:18,940
بصراحة... أشعر بغيرة شديدة

99
00:07:19,710 --> 00:07:21,670
...ا-الأمير أكوا

100
00:07:23,230 --> 00:07:26,880
لهذا أنا غاضب

101
00:07:29,940 --> 00:07:31,140
الاسم

102
00:07:31,140 --> 00:07:34,920
...الاسم؟ الأمير أكوا

103
00:07:37,700 --> 00:07:41,220
ناديتُ ملك الجنّيين "كيث" دون أيّ لققب

104
00:07:41,630 --> 00:07:45,570
هل يريد الأمير أكوا أن أفعل المثل معه؟

105
00:07:46,110 --> 00:07:48,830
لكن هل هذا مسموح أصلاً؟

106
00:07:49,200 --> 00:07:51,490
...ربّما إذا كنّا بمفردنا

107
00:07:52,080 --> 00:07:54,500
أ-أكوا

108
00:07:59,680 --> 00:08:01,000
جواب صحيح

109
00:08:08,450 --> 00:08:10,710
أحسنتِ صنعاً

110
00:08:10,710 --> 00:08:13,200
شكراً لكِ يا مُعلّمة

111
00:08:13,200 --> 00:08:15,820
حسناً، هذا كلّ شيء لليوم

112
00:08:17,660 --> 00:08:20,210
!الأمير أكواستيد

113
00:08:20,210 --> 00:08:21,900
يبدو أنّكما انتهيتُما

114
00:08:21,900 --> 00:08:26,080
أجل. تياراروز-ساما تلميذة مُتألّقة

115
00:08:26,080 --> 00:08:30,910
تمكّنتْ من إتمام ستّة أشهر
من العمل في شهر واحد

116
00:08:31,300 --> 00:08:36,090
كلّ ما بقي هو أسبوع واحد من المُحاضرات
عن الجنّيين، وننتهي بعدها

117
00:08:36,090 --> 00:08:39,300
فهمت. أنتِ لامعة الذّكاء يا تيارا

118
00:08:39,300 --> 00:08:42,670
!شكراً لك! سأبذل قصارى جهدي في الدّراسة

119
00:08:43,000 --> 00:08:45,920
بالمناسبة، هل أنتِ مُتفرّغة؟

120
00:08:48,490 --> 00:08:50,380
ماذا؟ أنا؟

121
00:08:50,710 --> 00:08:56,140
أجل. أريدكِ أن تطّلعي على عملي
عن كثب وتفهميه

122
00:08:56,450 --> 00:08:59,860
لكنّني خطيبتكِ فقط

123
00:08:59,860 --> 00:09:02,100
لا أعرف شيئاً عن شؤون مملكتك

124
00:09:02,480 --> 00:09:03,800
لا مُشكلة

125
00:09:04,230 --> 00:09:09,520
،حتّى كملِكة، ستبقين خارج نطاق عملي

126
00:09:09,520 --> 00:09:12,070
لكن لا ضير من معرفة طبيعة العمل

127
00:09:14,610 --> 00:09:16,040
عُلِم

128
00:09:16,040 --> 00:09:19,040
سأبذل قصارى جهدي لأكون
نافعة لك يا سموّ الأمير أكوا

129
00:09:28,710 --> 00:09:30,760
كنتِ تعملين بجدّ في كلّ مساء

130
00:09:32,790 --> 00:09:34,970
هلّا اقترحتُ عليكِ التوقُّف اللّيلة والاستراحة؟

131
00:09:35,520 --> 00:09:39,410
لا يسعني فعل شيء لأكون نافعة
للأمير أكوا بعد

132
00:09:39,410 --> 00:09:42,480
لكن كنتِ تعملين بجدّ أكبر ممّا يلزم

133
00:09:45,810 --> 00:09:47,500
رغم ذلك، لم أكن أعلم

134
00:09:48,050 --> 00:09:53,580
أنّ آيشيلا-ساما كانت تتردّد على
مكتبه، ولو كان ذلك بداعي العمل

135
00:09:54,360 --> 00:09:57,140
،آيشيلا-ساما في الرّابعة عشر من العمر فقط

136
00:09:57,140 --> 00:09:59,400
ومع ذلك تقوم بعملها باجتهاد من الآن

137
00:10:00,270 --> 00:10:02,830
كيف عسايّ أكون نافعة له؟

138
00:10:06,020 --> 00:10:08,670
!يبدو هذا رائعاً

139
00:10:09,120 --> 00:10:14,470
أنا متأكّدة بأنّ حلويّاتكِ السّحريّة
سوف تُبدّد إعياء الأمير

140
00:10:14,730 --> 00:10:17,380
شكراً لكِ. سأبذل قصارى جهدي

141
00:10:17,380 --> 00:10:19,200
!صباح الخير يا تيارا

142
00:10:20,010 --> 00:10:22,090
أتُعدّين الحلويّات؟

143
00:10:22,090 --> 00:10:23,690
!يمكنكِ تناول هذه

144
00:10:23,690 --> 00:10:26,190
مُكسّرات وزهور؟

145
00:10:27,740 --> 00:10:30,150
فيليني، افتحي فمكِ

146
00:10:34,230 --> 00:10:37,920
هذه الزّهور من جنّيات الغابة قابلة للأكل

147
00:10:37,920 --> 00:10:42,180
إنّها شهيّة! لديها حلاوتها الطّبيعيّة
!وليست مُرّة إطلاقاً

148
00:10:42,180 --> 00:10:43,270
أليس كذلك؟

149
00:10:45,830 --> 00:10:48,840
خبزتِ هذا لأجلنا يا تيارا؟

150
00:10:49,100 --> 00:10:50,150
أجل

151
00:10:50,150 --> 00:10:53,550
،بما أنّكما تعملان بجدّ
أردتُكما أن تتناولاه

152
00:10:54,100 --> 00:10:56,020
أنا سعيدٌ لأنّكِ فكّرتِ في أمرنا

153
00:10:56,020 --> 00:10:57,620
لنأخذ استراحة قصيرة

154
00:10:57,620 --> 00:10:58,390
حسناً

155
00:11:04,510 --> 00:11:06,980
كلّ الحلويّات الّتي تُعدّينها شهيّة يا تيارا

156
00:11:08,750 --> 00:11:10,690
!مذاقها رائع

157
00:11:10,990 --> 00:11:13,330
إنّها أخّاذة بالفعل

158
00:11:13,330 --> 00:11:16,200
يسرّني أنّها أعجبتكم

159
00:11:18,200 --> 00:11:19,200
تفضّل

160
00:11:19,770 --> 00:11:21,340
المعذرة

161
00:11:23,540 --> 00:11:26,750
ماذا؟ أهذا منكِ يا آيشيلا-ساما؟

162
00:11:28,140 --> 00:11:31,210
إنّها أحدث وصفة كعكة من طبّاخ عائلتنا

163
00:11:31,670 --> 00:11:37,180
بما أنّكِ هنا الآن، أردتُ أن
،أُقدّم شيئاً حُلواً لكِ

164
00:11:39,720 --> 00:11:42,970
إطلاقاً! من فضلكِ، لا تقلقي بشأن ذلك

165
00:11:42,970 --> 00:11:45,350
إنّها كعكة شهيّة

166
00:11:45,820 --> 00:11:48,560
!أعشق الحلويّات

167
00:11:50,750 --> 00:11:53,770
تبدين سعيدة جدّاً عندما تأكلين الحلويّات

168
00:11:53,770 --> 00:11:55,640
أستطيع مُراقبتكِ للأبد

169
00:11:57,620 --> 00:11:59,570
سأحضر المزيد في المرّة المُقبلة

170
00:12:00,410 --> 00:12:03,210
يا لها من كعكة فاخرة

171
00:12:03,210 --> 00:12:06,790
أيُّهما تُفضّل يا سموّ الأمير أكواستيد؟

172
00:12:12,740 --> 00:12:14,460
...في الواقع

173
00:12:18,640 --> 00:12:20,710
وهل من داعٍ للتّفكير؟

174
00:12:20,710 --> 00:12:22,890
مذاق كعكة تيارا أطيب بكثير

175
00:12:23,690 --> 00:12:25,220
!ملك الجنّيين

176
00:12:27,820 --> 00:12:29,440
سآعود ثانية من أجل المزيد

177
00:12:30,070 --> 00:12:32,190
أظنّني أخبرتُك مسبقاً

178
00:12:32,560 --> 00:12:35,750
بأنّني أُفضّل ألّا تلمس خطيبتي

179
00:12:35,750 --> 00:12:38,200
حقّاً؟

180
00:12:54,810 --> 00:12:57,150
ما زلت تأكل تلك الكعكة؟

181
00:12:57,150 --> 00:12:59,840
أنت غير مهتمّ أصلاً بالحلويّات

182
00:12:59,840 --> 00:13:02,220
الحلويّات الّتي تُعدّها تيارا مُختلفة

183
00:13:02,570 --> 00:13:03,920
...عجباً

184
00:13:03,920 --> 00:13:08,730
لماذا لم تستطع القول بأنّ مذاق
حلويّاتها أشهى فحسب إذاً؟

185
00:13:09,800 --> 00:13:14,100
لا أريد تعكير صفو مزاج الآنسة آيشيلا

186
00:13:14,550 --> 00:13:16,770
لا سيّما عندما تكون في القلعة

187
00:13:17,160 --> 00:13:19,490
...أجل، هذا صحيح

188
00:13:20,380 --> 00:13:22,690
،إذا تعكّر مزاج الآنسة آيشيلا

189
00:13:22,690 --> 00:13:25,860
فسوف يشعر جنّيّات البحر بذلك، وستهيج البِحار

190
00:13:25,860 --> 00:13:30,950
لكن ما دامت سعيدة، ستُشارك
البِحار محاصيلها معنا

191
00:13:32,780 --> 00:13:33,780
المزيد من فضلك

192
00:13:33,780 --> 00:13:35,780
ماذا؟ ثانية؟

193
00:13:45,590 --> 00:13:48,350
!"مشهد "منقوع بالوسامة

194
00:13:48,350 --> 00:13:51,640
لماذا نسيتُ ذلك حتّى الآن؟

195
00:13:52,700 --> 00:13:58,370
كان المشهد العيّنة الوحيد الّذي تمّ الكشف
،عنه في جزء التتمّة قبل وفاتي

196
00:13:58,370 --> 00:14:00,070
من حدث حيثُ يمشي الأمير أكوا

197
00:14:00,070 --> 00:14:04,490
عند المُحيط أثناء مُواعدة
ثمّ يسقط ويبتلّ

198
00:14:05,200 --> 00:14:08,210
بدا الأمير أكوا وسيماً جدّاً

199
00:14:08,910 --> 00:14:11,760
!لحظة، لا! كان على مُوعد مع البطلة

200
00:14:11,760 --> 00:14:15,290
!كان حدثاً طوّرَ علاقته العاطفيّة مع آيشيلا

201
00:14:15,290 --> 00:14:17,930
لا أستطيع التّخمين متى سيقع ذلك الحدث

202
00:14:17,930 --> 00:14:22,700
ينبغي أن أكون بخير ما دام الأمير
...أكوا لا يدخل إلى المُحيط معها

203
00:14:23,730 --> 00:14:25,300
ماذا؟ المُحيط؟

204
00:14:25,670 --> 00:14:29,310
أجل. سأتفقّد مُحيط آيشيلا-ساما

205
00:14:29,680 --> 00:14:32,310
يبدو أنّ أصنافاً جديدة من المرجان
قد ظهرتْ هناك

206
00:14:32,780 --> 00:14:34,420
...لا

207
00:14:36,030 --> 00:14:37,230
ما الأمر؟

208
00:14:37,230 --> 00:14:39,180
لا شيء

209
00:14:42,370 --> 00:14:43,570
تيارا

210
00:14:44,860 --> 00:14:47,500
لا داعي لتتحفّظي عن شيء أمامي

211
00:14:47,500 --> 00:14:50,510
لكنّه عملٌ رسميّ بالنّسبة لك، صحيح؟

212
00:14:50,510 --> 00:14:52,690
...لا يمكن أن أكون أنانيّة

213
00:14:52,690 --> 00:14:54,620
لا تكملي هذه الجملة

214
00:14:59,620 --> 00:15:03,000
لن أتوقّف حتّى تخبريني

215
00:15:07,840 --> 00:15:10,600
!من فضلك... من فضلك لا تذهب إلى المُحيط

216
00:15:13,390 --> 00:15:15,880
حسناً. لن أذهب

217
00:15:15,880 --> 00:15:16,900
ماذا؟

218
00:15:16,900 --> 00:15:19,610
سأكلّف إيليوت بمهمّة التفقُّد

219
00:15:20,450 --> 00:15:23,820
فأنتِ أهمّ بالنّسبة لي

220
00:15:25,340 --> 00:15:26,820
...الأمير أكوا

221
00:15:31,570 --> 00:15:35,260
إذاً سيُرافقكِ إيليوت-ساما
في مهمّة تفقُّد اليوم؟

222
00:15:35,260 --> 00:15:37,250
أجل. آسف بشأن ذلك

223
00:15:37,550 --> 00:15:39,240
عُلِم

224
00:15:39,240 --> 00:15:42,300
هل سيأتي إيليوت-ساما إلى هنا قريباً؟

225
00:15:42,300 --> 00:15:45,060
إنّه مع الفرسان الآن، لذا
سنذهب ونحضره

226
00:15:45,390 --> 00:15:46,720
تعالي معنا يا تيارا

227
00:15:47,590 --> 00:15:50,610
هناك حديقة ورود جميلة في الطّريق

228
00:15:50,610 --> 00:15:51,680
هل نراها معاً؟

229
00:15:53,530 --> 00:15:54,970
!أتمنّى ذلك

230
00:15:59,480 --> 00:16:01,590
!ما أجملها

231
00:16:01,590 --> 00:16:03,270
!إنّها جميلة

232
00:16:03,610 --> 00:16:06,550
إن أعجبتكِ واحدة، فيمكنكِ قطفها

233
00:16:06,550 --> 00:16:08,150
هل أنت متأكّد؟

234
00:16:08,150 --> 00:16:11,410
بالطّبع. آنسة آيشيلا، يمكنكِ ذلك أيضاً

235
00:16:11,410 --> 00:16:13,280
!أشكرك

236
00:16:15,370 --> 00:16:17,440
!انظرا إلى هذه

237
00:16:18,300 --> 00:16:22,290
هذه الورود البيضاء ستُلائم شعر
تياراروز-ساما بشكل مثاليّ

238
00:16:28,980 --> 00:16:30,520
!آنسة آيشيلا

239
00:16:42,010 --> 00:16:44,030
!الأمير أكواستيد

240
00:16:45,540 --> 00:16:48,450
...الأمير أكوا! هل أنت... بخير

241
00:16:51,310 --> 00:16:53,870
!منقوع بالوسامة

242
00:16:55,170 --> 00:17:00,010
لا... لكن كان من المُفترض أن يقع
...هذا الحدث في المُحيط

243
00:17:00,560 --> 00:17:04,810
هل قوّة اللّعبة، قوّة الأحداث، مُطلَقة؟

244
00:17:05,800 --> 00:17:10,180
هل من المستحيل لي أن أغيّر
مسار تقدُّم اللّعبة؟

245
00:17:14,440 --> 00:17:15,850
!تيارا

246
00:17:20,240 --> 00:17:24,310
الآن قد فعلتُها، بعد أن قلتُ
...بأنّني لن أهرب بعد الآن

247
00:17:25,000 --> 00:17:27,100
لكن لا يسعني سوى الشّعور بالتوتُّر

248
00:17:27,100 --> 00:17:30,980
هل ما زال قلب الأمير أكوا يميل نحوي؟

249
00:17:32,570 --> 00:17:34,900
كيف أصبح أقوى؟

250
00:17:37,080 --> 00:17:38,910
لا داعي للقلق

251
00:17:38,910 --> 00:17:42,930
،إذا استمررتُ في البحث فحسب
فسرعان ما ستجفّ الدّموع

252
00:17:47,050 --> 00:17:48,580
!كيث؟

253
00:17:48,580 --> 00:17:51,380
ما هذا؟ هل أبكاكِ؟

254
00:17:51,790 --> 00:17:52,970
!لا، لم يفعل

255
00:17:53,470 --> 00:17:56,350
لكن قلبكِ يبكي

256
00:17:56,350 --> 00:17:59,470
إن كنتِ تُعانين، فتعالي إليّ

257
00:17:59,470 --> 00:18:01,890
...كما قلتُ لك سابقاً، ليس وكأنّ

258
00:18:01,890 --> 00:18:05,100
أتتذكّرين ما قلتُه لكِ؟ الجنّيون أحرار

259
00:18:09,260 --> 00:18:11,190
تيارا، سأدخل

260
00:18:15,010 --> 00:18:16,450
ليست هنا؟

261
00:18:20,200 --> 00:18:21,790
...هذه

262
00:18:23,800 --> 00:18:25,380
هذا ملك الجنّيين؟

263
00:18:26,920 --> 00:18:28,380
...تيارا

264
00:18:29,420 --> 00:18:30,990
ماذا؟ إنّها تيارا

265
00:18:30,990 --> 00:18:33,280
!أهلاً بعودتك يا ملك

266
00:18:35,310 --> 00:18:38,470
!كيث! ما معنى هذا؟

267
00:18:38,470 --> 00:18:40,140
مهلاً، كفّي عن الصُّراخ

268
00:18:43,690 --> 00:18:48,850
،لا أعتقد بأنّكِ تدركين هذا يا تيارا
لكن يبدو وجهكِ في حالة يُرثى لها

269
00:18:48,850 --> 00:18:49,940
!ماذا؟

270
00:18:49,940 --> 00:18:51,480
استلقي واستريحي قليلاً

271
00:18:54,980 --> 00:18:56,220
لم تنامي بما يكفي؟

272
00:18:56,220 --> 00:18:57,800
!هذا مُضرّ بصحّتكِ

273
00:18:57,800 --> 00:18:59,750
...المعذرة

274
00:19:01,040 --> 00:19:03,800
!أعدني! سأستريح في غرفتي الخاصّة

275
00:19:03,800 --> 00:19:05,170
لا أعتقد ذلك

276
00:19:05,170 --> 00:19:08,590
تعلمين بأنّ جنّيات الغابة مُتقلّبات، أليس كذلك؟

277
00:19:08,880 --> 00:19:11,430
...لكن لديّ

278
00:19:17,990 --> 00:19:22,560
حتّى وأنتِ في حالة ضعف، لم أتوقّع
أن يتنامي بهذه السّهولة

279
00:19:23,680 --> 00:19:25,850
لا بُدّ أنّكِ مررتِ بمشاعر فظيعة

280
00:19:26,290 --> 00:19:28,890
!سآخذ قيلولة مع تيارا

281
00:19:28,890 --> 00:19:31,980
عقيلة محبوبة بواسطة جنّيات غابة؟

282
00:19:32,510 --> 00:19:37,370
وجنّيات البحر تحببنَ تلك البشريّة
المدعوّة آيشيلا، أليس كذلك؟

283
00:19:39,440 --> 00:19:43,490
لعلّ البشر مُزعجون، لكن جنّيات
البحر أولئك مُزعجون كذلك

284
00:19:44,290 --> 00:19:47,380
يزدادون تعلُّقاً بشكل شديد

285
00:19:47,380 --> 00:19:51,840
في تلك المرّة الّتي وقعتْ فيها
،فتاة أحبّوها في ورطة

286
00:19:51,840 --> 00:19:56,810
صُبِغ المُحيط بالأحمر، واختفت
الأسماك، وذبلت النّباتات المرجانيّة

287
00:19:58,560 --> 00:20:00,860
متى كان ذلك ثانية؟

288
00:20:00,860 --> 00:20:02,520
كم قرناً مضى على ذلك؟

289
00:20:07,140 --> 00:20:11,280
فتّشنا القلعة بأكملها، لكن لم نستطع إيجادها

290
00:20:12,070 --> 00:20:14,620
كيف يجرؤ على اختطاف تياراروز-ساما؟

291
00:20:14,620 --> 00:20:17,940
ما الّذي يُفكّر فيه ملك الجنّيين ذاك؟

292
00:20:24,510 --> 00:20:26,770
النّصوص المُحرّمة الخاصّة بالعائلة الملكيّة

293
00:20:30,460 --> 00:20:32,830
انتظر هنا لبعض الوقت

294
00:20:32,830 --> 00:20:34,170
عُلِم

295
00:20:47,690 --> 00:20:50,120
تبّاً. أين هو؟

296
00:20:50,120 --> 00:20:52,810
،أتفهّم سبب وجود الكثير من سجلّات المُحيط

297
00:20:52,810 --> 00:20:54,540
لكن العدد قليل جدّاً بالنّسبة للغابة

298
00:20:55,900 --> 00:21:01,030
الطّريق إلى عرش ملك جنّيّي الغابة"
يبدأ في القلعة"؟

299
00:21:02,790 --> 00:21:04,240
في القلعة؟

300
00:21:04,980 --> 00:21:08,650
غرفة الملكة؟ لِمَ يكون هناك؟

301
00:21:12,000 --> 00:21:13,520
!ملِك الجنّيين

302
00:21:13,520 --> 00:21:16,250
تبدو مُستميتاً جدّاً

303
00:21:16,700 --> 00:21:20,960
!ألا تعتقد بأنّ السّبب هو لأنّك اختطفت عقيلتي؟

304
00:21:20,960 --> 00:21:24,450
...في الواقع، كنتُ أخطّط لذلك في البداية

305
00:21:25,300 --> 00:21:28,190
لكن غيّرتُ رأيي

306
00:21:28,190 --> 00:21:30,270
الجنّيّون مُتقلّبو المزاج كما تعلم

307
00:21:30,600 --> 00:21:32,520
!كفى مُزاحاً

308
00:21:32,840 --> 00:21:35,270
أنا لا أمزح

309
00:21:36,290 --> 00:21:38,780
سوف آخذها

310
00:23:30,680 --> 00:23:35,730
،أنا سعيدة لأنّ الأمير أكوا
،قال بأنّه يحبّني

311
00:23:35,730 --> 00:23:39,110
لكن... هذا أيضاً سبب خوفي