1
00:00:02,190 --> 00:00:06,880
أريد معرفة المُستقبل الّذي ينتظرني
،أنا، الشّرّيرة

2
00:00:07,270 --> 00:00:10,610
وأريد أن أرى كيف ستنتهي هذه اللّعبة

3
00:00:10,610 --> 00:00:12,120
...وللقيام بذلك

4
00:00:12,870 --> 00:00:16,950
عليّ التكلُّم مع الملكة بارل مرّة أُخرى

5
00:01:54,620 --> 00:01:55,830
بارل

6
00:01:56,610 --> 00:01:58,420
...كلير

7
00:02:02,690 --> 00:02:07,250
اتّخذتُ شكل امرأة لأنّكِ قلتِ
،بأنّكِ تكرهين الرّجال

8
00:02:07,250 --> 00:02:08,980
لكن لستُ بحاجة ذلك بعد الآن، صحيح؟

9
00:02:10,030 --> 00:02:16,320
بارل، لن يدين أحدٌ ملك جنّيين
لإحداثه كارثة طبيعيّة

10
00:02:16,880 --> 00:02:21,020
من المُمكن أن يعتبرها النّاس
ضروريّة في بعض الأحيان

11
00:02:21,020 --> 00:02:21,870
...لكن

12
00:02:22,360 --> 00:02:26,830
من السيّئ توريط البشر في مُشكلة
بيني وبينكِ

13
00:02:28,760 --> 00:02:30,840
لماذا أنا دوماً؟

14
00:02:31,570 --> 00:02:35,100
بدأ ذلك مع المطالب الأنانيّة لجنّيات البحر

15
00:02:35,100 --> 00:02:37,830
!أريد أن تكون آيشيلا سعيدة

16
00:02:38,290 --> 00:02:42,620
لكن مُحال أن أفصل شخصين يُحبّان
بعضهما الآخر حُبّاً جمّاً

17
00:02:43,010 --> 00:02:46,210
...هكذا كان الأمر... لكن

18
00:02:46,610 --> 00:02:50,770
عندما رأيتُ كلير يستمتع كثيراً
...مع أشخاص غيري

19
00:02:51,370 --> 00:02:55,350
لطالما ظننتُ بأنّ ملوك الجنّيّين كائنات وحيدة

20
00:02:55,810 --> 00:02:58,250
لكن لا يوجد سوايّ وحيد

21
00:03:00,050 --> 00:03:02,660
أقبل بأن أكون وحيدة

22
00:03:03,310 --> 00:03:04,780
...بارل

23
00:03:04,780 --> 00:03:07,950
أعلم بأنّكِ تتوقين لصُحبة أكثر
من أيّ شخص آخر

24
00:03:10,630 --> 00:03:12,120
!الملكة بارل

25
00:03:12,120 --> 00:03:13,630
اعذرنا على الإزعاج رجاء

26
00:03:14,230 --> 00:03:17,010
تياراروز. آيشيلا بارلانت

27
00:03:17,690 --> 00:03:20,720
ماذا؟ هل أنت... الملك كلير؟

28
00:03:21,670 --> 00:03:24,230
أجل. هذا هو مظهري الأصليّ

29
00:03:30,480 --> 00:03:32,190
لماذا أتيتِ إلى هنا؟

30
00:03:33,180 --> 00:03:36,810
أنا هنا لأنّني أريد إكمال كلّ ما بدأتُه

31
00:03:38,020 --> 00:03:40,280
بقي الأمير أكوا في البرّ

32
00:03:40,280 --> 00:03:43,910
وذلك كي يتولّى القيادة في منع
انتشار الفوضى بين العوام

33
00:03:43,910 --> 00:03:48,310
ما كنتُ لأتوقّع أبداً أن يتغلّب
على آثار الإكسير السرّي بنفسه

34
00:03:48,310 --> 00:03:50,530
من تكونين بالضّبط؟

35
00:03:51,110 --> 00:03:52,660
من أكون؟

36
00:03:52,660 --> 00:03:55,230
أنا مُجرّد شرّيرة مُتواضعة

37
00:03:55,230 --> 00:03:57,510
بالطّبع، لا أستطيع إخبارها بذلك

38
00:03:57,820 --> 00:03:59,760
لكن ثمّة شيء واحد أستطيع قوله

39
00:04:00,660 --> 00:04:04,560
الشّخص الوحيد الّذي أُحبّه هو الأمير أكوا

40
00:04:04,920 --> 00:04:09,810
ليس عليكِ القلق بشأن أيّ شيء

41
00:04:10,590 --> 00:04:11,830
...تُحبّينه

42
00:04:12,770 --> 00:04:14,680
!كم أنتِ محظوظة

43
00:04:15,050 --> 00:04:18,650
لديكِ رجل يفكّر فيكِ وفيكِ وحدكِ

44
00:04:19,350 --> 00:04:20,410
ماذا؟

45
00:04:23,640 --> 00:04:28,230
الشّخص الّذي رغبتُه تركَني قائلاً
بأنّ المكانة بيننا واسعة

46
00:04:28,830 --> 00:04:32,760
"لا يمكن لإنسان وملكة جنّيين أن يكونا معاً"

47
00:04:32,760 --> 00:04:36,380
هذا ما قاله قبل أن يختار امرأة بشريّة

48
00:04:36,380 --> 00:04:41,440
قال بأنّه لا يريد نسياني، لذا أخذ اسمي

49
00:04:43,340 --> 00:04:46,470
لستُ بحاجة لحُبّ لا هو هنا ولا هو هناك

50
00:04:46,950 --> 00:04:51,150
...اسمي هو... آيشيلا بارلانت

51
00:04:52,590 --> 00:04:58,000
هل هذا يعني أنّ شخصاً بين أسلافي
رفض الزّواج من الملكة بارل؟

52
00:04:59,170 --> 00:05:04,120
لم أكن أعلم بأنّ الملكة بارل تحمّلت
...مثل هذه الرّومانسيّة المأساويّة

53
00:05:04,120 --> 00:05:06,440
أمسى هذا من الماضي الآن

54
00:05:16,990 --> 00:05:18,010
ما هذا؟

55
00:05:18,430 --> 00:05:20,040
زينة مرجانيّة

56
00:05:20,040 --> 00:05:24,090
اخترتُها لأنّني ارتأيتُ بأنّها ستُلائمكِ

57
00:05:24,090 --> 00:05:25,010
ماذا؟

58
00:05:25,360 --> 00:05:30,740
علّمتني تياراروز بأنّ المرأة
الّتي أحبّها ستكون أسعد

59
00:05:30,740 --> 00:05:33,230
بهديّة اخترتُها بنفسي

60
00:05:37,220 --> 00:05:39,990
!توقّعت! إنّها تلائمكِ بشكل مثاليّ

61
00:05:40,490 --> 00:05:43,410
هل يُعقَل أنّكِ كنتِ تغارين من تياراروز؟

62
00:05:46,100 --> 00:05:50,870
لم أدرك بأنّكِ تحبّينني إلى هذا الحدّ
لدرجة أنّكِ لطّختِ المُحيط بالأسود

63
00:05:51,380 --> 00:05:53,550
ظننتُ بأنّ السّبب هو لأنّكِ كرهتِني

64
00:05:53,550 --> 00:05:56,380
—بـ-بالطّبع لا أكره

65
00:05:57,080 --> 00:06:01,110
لكن في هذه الحالة، عليكِ أن تفهمي
طبيعة ما قمتِ به

66
00:06:01,110 --> 00:06:04,130
وتقبلي عقوبة كملِكة جنّيين

67
00:06:05,160 --> 00:06:06,640
!انتظر لحظة

68
00:06:07,350 --> 00:06:12,100
هلّا سمحت لي من فضلك أن
أختار عقوبة الملكة بارل؟

69
00:06:12,480 --> 00:06:14,980
أنا متأكّدة بأنّها ستكون أخفّ من العقوبة

70
00:06:14,980 --> 00:06:17,730
الّتي ستتلقّاها من ملِك جنّيين

71
00:06:19,140 --> 00:06:24,150
آيشيلا بارلانت، يؤسفني القول بأنّني
لا أستطيع قبول ذلك

72
00:06:24,460 --> 00:06:29,160
لا يمكن للبشر أن يُسمَح لهم باتّخاذ
قرار بما يحدث مع بارل

73
00:06:30,230 --> 00:06:32,640
،لا تعتقدي بأنّ البشريّ يستطيع تقييد بارل

74
00:06:33,820 --> 00:06:37,360
لا سيّما إذا كان من سلالة بارلانت

75
00:06:40,220 --> 00:06:41,730
!آيشيلا-ساما

76
00:06:42,440 --> 00:06:44,880
...الملك كلير، إنّ آيشيلا-ساما

77
00:06:44,880 --> 00:06:48,380
لا تقلقي. أعدتُها إلى السّطح فحسب

78
00:06:49,140 --> 00:06:52,520
تياراروز، قلتِ بأنّكِ أردتِ إكمال هذا

79
00:06:52,830 --> 00:06:56,680
لهذا السّبب، سأسمح بوجودكِ
هنا حتّى النّهاية

80
00:06:57,330 --> 00:06:59,730
شـ-شكراً لك

81
00:07:00,150 --> 00:07:03,170
وبعد؟ ما هي عقوبتي؟

82
00:07:03,170 --> 00:07:05,950
يسرّني أنّكِ قبلتِها بصدر رحب يا بارل

83
00:07:07,170 --> 00:07:09,470
ما حدث كان غلطتي

84
00:07:11,210 --> 00:07:12,290
،في هذه الحالة

85
00:07:12,290 --> 00:07:17,150
امنحي أكواستيد وتياراروز برَكة
ملِكة جنّيّي البحر

86
00:07:17,480 --> 00:07:20,710
هذه هي العقوبة الّتي توصّلتُ إليها لأجلكِ

87
00:07:22,190 --> 00:07:24,330
!أيّ مزحة هي هذه؟

88
00:07:24,330 --> 00:07:28,480
!اتّخذتُ قراري في عدم منح برَكتي لأيّ بشريّ

89
00:07:28,480 --> 00:07:32,180
حسناً، أنا مُولع بمملكة مارينفوريست

90
00:07:33,110 --> 00:07:35,960
،ملك جنّيّي السّماء باركَ بوليّ العهد

91
00:07:35,960 --> 00:07:39,700
وعقيلته لديها ملك جنّيّي الغابة بجانبها

92
00:07:40,740 --> 00:07:45,080
لذا إذا باركَتْ ملكة جنّيّي البحر
،لهما معاً أيضاً

93
00:07:45,080 --> 00:07:46,940
ستنعم هذه المملكة بالسّلام

94
00:07:47,700 --> 00:07:50,580
لذا باركي لهما بكلّ قوّتكِ، اتّفقنا؟

95
00:07:50,580 --> 00:07:55,130
لكن إذا فعلتُ ذلك، فذلك سوف
!يستنزف قوّتي السّحريّة تقريباً

96
00:07:55,130 --> 00:07:58,750
أجل. هذا ما يجعلها عقوبة

97
00:07:59,970 --> 00:08:03,940
إنّها عقوبة، وتُساعد هذه المملكة
على الازدهار

98
00:08:03,940 --> 00:08:05,460
!الجميع يكسبون

99
00:08:06,070 --> 00:08:10,450
كلير... أنت تحبّ هذه المملكة كثيراً

100
00:08:11,360 --> 00:08:14,750
...لكن إذا كان هذا ما ترغبه

101
00:08:18,600 --> 00:08:21,150
،يا مُحيط الأمواج والتموُّجات

102
00:08:22,750 --> 00:08:25,800
امنح أسمى البرَكات لذلكما الاثنين

103
00:08:25,800 --> 00:08:27,760
اللّذين يحملان مُستقبل مارينفوريست
على عاتقهما

104
00:08:28,690 --> 00:08:33,740
لأجل أكواستيد مارينفوريست، نصل
...مائيّ يستطيع اختراق كلّ شيء

105
00:08:34,830 --> 00:08:39,850
،ولأجل تياراروز لابيس مارينفوريست
جدار مائيّ يستطيع التصدّي لكلّ شيء

106
00:08:41,970 --> 00:08:43,880
!أشعر بحرّ شديد

107
00:08:43,880 --> 00:08:46,270
تياراروز، حاولي أن تسترخي

108
00:08:46,270 --> 00:08:48,220
عليكِ أن تتلقّي قوّة بارل فحسب

109
00:08:57,790 --> 00:09:00,070
لا يبدو أنّ هناك أي فوضى جماهيريّة

110
00:09:00,070 --> 00:09:05,070
أجل، لحسن الحظّ، لم يكن هناك الكثير
من النّاس الّذين رأوا المُحيط الأسود بعينهم

111
00:09:05,070 --> 00:09:08,920
—هذا جيّد. سأتجوّل في المدينة تحسّباً

112
00:09:13,050 --> 00:09:14,370
ما الأمر؟

113
00:09:14,370 --> 00:09:16,870
إنّها برَكة ملكة جنّيّي البحر

114
00:09:17,360 --> 00:09:20,840
...ذكرَ كلير ذلك من قبل، لكن هذا التأثير

115
00:09:20,840 --> 00:09:22,670
لا بُدّ أنّ تيارا تتلقّاها أيضاً

116
00:09:23,670 --> 00:09:25,500
!إيليوت، سوف أعود

117
00:09:25,500 --> 00:09:26,710
!الأمير أكواستيد

118
00:09:28,620 --> 00:09:29,770
...تيارا

119
00:09:33,110 --> 00:09:34,740
أنا مُرهَقة

120
00:09:35,790 --> 00:09:37,760
يسرّني أنّكِ بخير

121
00:09:40,350 --> 00:09:42,380
أهلاً بعودتك يا سموّ الأمير أكوا

122
00:09:43,510 --> 00:09:45,170
هل أنتِ بخير يا تيارا؟

123
00:09:45,170 --> 00:09:47,940
تلقّيتِ برَكة ملكة جنّيّي البحر، صحيح؟

124
00:09:48,390 --> 00:09:50,040
لا تشعرين بحالٍ جيّدة، صحيح؟

125
00:09:51,170 --> 00:09:53,530
،لا، فاجأني ذلك

126
00:09:53,530 --> 00:09:55,570
لكن لستُ مُتوعّكة إطلاقاً

127
00:09:55,860 --> 00:09:57,260
هذا ممتاز

128
00:10:00,370 --> 00:10:02,480
...ا-الأمير أكوا

129
00:10:03,610 --> 00:10:06,590
الأمير أكواستيد، تياراروز-ساما

130
00:10:06,950 --> 00:10:12,590
أنا آسفة حقّاً لأنّني سبّبتُ الكثير
من المشاكل لكما

131
00:10:12,590 --> 00:10:15,280
عاقباني كما تريان مُناسباً رجاء

132
00:10:16,280 --> 00:10:18,730
،عقوبة بارل، ملكة جنّيّي البحر

133
00:10:18,730 --> 00:10:21,350
قد قُرِّرت بواسطة كلير، ملِك جنّيّي السّماء

134
00:10:21,720 --> 00:10:25,370
تلقّيتُ برَكة حماية المُحيط

135
00:10:25,750 --> 00:10:28,860
تلقّيتُ برَكة هجوميّة

136
00:10:29,350 --> 00:10:33,290
،لطالما أشرفتُ على البحار والشّواطئ

137
00:10:33,290 --> 00:10:35,070
لكن أرى بأنّه لم يعُد هناك حاجة لذلك

138
00:10:36,100 --> 00:10:40,420
لأنّكما تلقّيتُما برَكة ملكة جنّيّي البحر

139
00:10:40,420 --> 00:10:45,390
لا، أريدكِ أن تستمرّي في إدارة المُحيط

140
00:10:45,390 --> 00:10:46,330
ماذا؟

141
00:10:46,640 --> 00:10:50,210
فأنتِ تعرفينه أكثر من أيّ شخص آخر

142
00:10:50,210 --> 00:10:52,090
أتّفق

143
00:10:52,400 --> 00:10:54,590
...لكنّني

144
00:10:55,190 --> 00:10:58,600
...أنتِ المُناسبة لهذا العمل. في النّهاية

145
00:10:58,600 --> 00:11:02,380
لا يوجد أحدٌ يحبّ المُحيط مثلما تُحبّينه

146
00:11:02,380 --> 00:11:04,320
هذا ما أعتقده

147
00:11:05,510 --> 00:11:07,400
،تيارا عليها الاعتناء بالغابة

148
00:11:07,400 --> 00:11:09,510
لذا لن يكون لديها وقت للإشراف على المُحيط

149
00:11:09,990 --> 00:11:12,100
سنُعزّز العلاقات الدبلوماسيّة كذلك

150
00:11:13,180 --> 00:11:16,680
لا أريد أن أبقى تحت رحمة
ملوك الجنّيّين بعد الآن

151
00:11:17,360 --> 00:11:21,080
أعتقد بأنّه يريدني أن أبقى في القلعة
وألّا أذهب إلى البحر

152
00:11:21,830 --> 00:11:25,090
في السّابق، ما كنتُ لأتخيّل حدوث هذا حتّى

153
00:11:26,500 --> 00:11:30,100
أنا متأكّدة بأنّها وافقتْ على استخدام
الإكسير في لحظة ضعف فقط

154
00:11:30,720 --> 00:11:33,510
إمّا هذا، أو أنّها قوّة اللّعبة فحسب

155
00:11:34,370 --> 00:11:39,150
أحياناً أعتقد بأنّ اللّعبة تتمحور فقط
،حول ما يريده شخص

156
00:11:39,150 --> 00:11:41,010
...وهذا يُقلقني، لكن رغم ذلك

157
00:11:43,310 --> 00:11:48,480
إذا كان هذا ما ترغبانه، فسأقبل بكلّ تواضع

158
00:11:48,480 --> 00:11:50,940
سنعتمد عليكِ يا آنسة آيشيلا

159
00:11:51,320 --> 00:11:53,550
أعتقد أُغلِقت القضيّة حاليّاً

160
00:12:10,860 --> 00:12:12,340
—ماذا؟ لا أستطيع الحـ

161
00:12:14,230 --> 00:12:17,230
عادة يستيقظ قبل أن أفعل

162
00:12:17,230 --> 00:12:18,680
هذا نادر

163
00:12:20,780 --> 00:12:22,690
رموشه طويلة

164
00:12:24,040 --> 00:12:25,220
أحبّه

165
00:12:26,640 --> 00:12:28,450
أحضرتُ لكما زهوراً

166
00:12:30,940 --> 00:12:34,650
!كـ-كـ-كيث! لماذا أنت في غرفة نومنا؟

167
00:12:36,830 --> 00:12:39,360
ألا يعرف ملوك الجنّيّين شيئاً
!عن آداب السّلوك العامّة؟

168
00:12:39,360 --> 00:12:40,750
ما هذا؟

169
00:12:40,750 --> 00:12:45,890
ألا يؤمن وليّ عهد هذه المملكة
بأنّ الملوك الجنّيّين مُطلَقون؟

170
00:12:45,890 --> 00:12:48,320
أنا لا أتنازل عندما يتعلّق الأمر بتيارا

171
00:12:48,320 --> 00:12:51,410
أنا الوحيد الّذي يُسمَح له برؤيتها
!بعد أن تستيقظ

172
00:12:51,410 --> 00:12:55,130
يا لك من وليّ عهد أنانيّ

173
00:12:55,130 --> 00:12:56,750
لستُ بحاجة هذا من ملك جنّيّين

174
00:12:56,750 --> 00:13:00,170
!يدخل غرفة نوم زوجين دون إذن

175
00:13:00,630 --> 00:13:04,440
إذا كان لديك شأن معنا، فانتظر في غرفة
!أُخرى حتّى نبدّل ملابسنا

176
00:13:05,800 --> 00:13:06,970
حسناً، حسناً

177
00:13:15,360 --> 00:13:17,860
إنّه سُكّر جمعتُه من زهورك

178
00:13:18,260 --> 00:13:20,320
!أحضرت كلّ هذا السكّر؟

179
00:13:20,320 --> 00:13:23,550
،وأيضاً، الكميّة قليلة

180
00:13:23,550 --> 00:13:25,610
لكن يمكنك جمع رحيقها أيضاً

181
00:13:25,610 --> 00:13:26,830
!حتّى الرّحيق؟

182
00:13:27,380 --> 00:13:30,500
والبتلات صالحة للأكل أيضاً

183
00:13:30,500 --> 00:13:33,580
إنّها زهرتكِ حقّاً يا تيارا

184
00:13:33,580 --> 00:13:35,150
تفوح منها رائحة خفيفة

185
00:13:38,510 --> 00:13:40,710
هذا ما توقّعتُه من زهرة تيارا

186
00:13:40,710 --> 00:13:43,550
كلّ جزء منها حلو، مثلها تماماً

187
00:13:44,760 --> 00:13:48,850
أنت الشّخص الوحيد الّذي يصفني بالحلوة

188
00:13:51,510 --> 00:13:55,230
بقدر ما أستمتع برؤية تيارا، هل يمكنكما
فعل هذا في مكان آخر؟

189
00:13:57,730 --> 00:14:01,640
!بهذا، ربّما أستطيع صنع تحلية جديدة

190
00:14:04,040 --> 00:14:05,700
سأتذوّق أوّلاً

191
00:14:07,850 --> 00:14:12,510
النّكهة الرّقيقة الحلوة تملأ فمي

192
00:14:14,330 --> 00:14:16,280
ربّما حلوى صلبة؟

193
00:14:16,630 --> 00:14:18,350
والآن إلى بعض الماء

194
00:14:21,840 --> 00:14:26,390
...ربّما... إذا تعمّقتُ في سحري أكثر

195
00:14:34,150 --> 00:14:36,480
!فعلتُها! نجح ذلك

196
00:14:39,580 --> 00:14:41,930
،حالما تصبح بلون ذهبيّ جميل

197
00:14:41,930 --> 00:14:44,570
...سألفّها ببتلات، وأبرّدها، و

198
00:14:44,570 --> 00:14:45,840
!أصبحت جاهزة

199
00:14:46,380 --> 00:14:49,040
ماذا تُدعى هذه الحلويّات؟

200
00:14:49,040 --> 00:14:50,500
حلويّات درع السّلحفاة

201
00:14:50,500 --> 00:14:53,310
!إنّها جميلة جدّاً، وتبدو شهيّة

202
00:14:53,310 --> 00:14:55,120
!شكراً لكِ يا فيليني

203
00:14:55,810 --> 00:14:58,530
لنأخذها إلى الأمير أكوا فوراً

204
00:14:59,170 --> 00:15:04,810
سموّه في الشّاطئ يشرف على زرع أشجارك

205
00:15:07,200 --> 00:15:09,000
!الأمير أكوا

206
00:15:10,310 --> 00:15:11,650
!تيارا

207
00:15:15,810 --> 00:15:16,950
ما الّذي جاء بك إلى هنا؟

208
00:15:16,950 --> 00:15:20,440
،الحلويّات الجديدة الّتي أعددتُها قد تمّت
لذا أحضرتُها لكِ

209
00:15:20,760 --> 00:15:22,320
إنّها حلويّات درع سُلحفاة

210
00:15:22,320 --> 00:15:25,450
أردتُك أن تكون أوّل من يُجرّبها

211
00:15:26,220 --> 00:15:27,710
إنّها تشبهكِ كثيراً

212
00:15:27,710 --> 00:15:28,700
ماذا؟

213
00:15:28,700 --> 00:15:31,590
جميلة، ظريفة، ولذيذة الشّكل

214
00:15:34,230 --> 00:15:38,170
ا-الأمير أكوا، أما زلت في مُنتصف عملك؟

215
00:15:39,600 --> 00:15:41,430
سنستغرق وقتنا عندما أنتهي إذاً

216
00:15:44,560 --> 00:15:46,150
...الملك كلير

217
00:15:51,610 --> 00:15:54,160
كنتُ أتأمّل المُحيط

218
00:15:54,920 --> 00:15:59,760
تأثّرتُ كثيراً في أوّل مرّة رأيتُ
فيها المُحيط في مارينفوريست

219
00:16:00,200 --> 00:16:02,480
لم أصدّق بأنّه كان بهذا الجمال

220
00:16:03,970 --> 00:16:07,880
يبدو جميلاً لأنّه مُحيط الملكة بارل بالطّبع

221
00:16:08,940 --> 00:16:14,660
،بعض الأيّام ستكون مُشمسة
وأُخرى عاصِفة مع مطر بارد

222
00:16:15,680 --> 00:16:19,760
هذا المُحيط هو قلب الملكة بارل
المُحبّ بحدّ ذاته

223
00:16:19,760 --> 00:16:22,790
لهذا يُلامس القلب بهذه الشدّة

224
00:16:23,450 --> 00:16:26,490
أحبّ مُحيط الملكة بارل

225
00:16:27,510 --> 00:16:31,870
أرغب في تقديم بعض حلويّات
درع السّلحفاة هذه لها

226
00:16:34,190 --> 00:16:38,270
إنّ أكل حلويّات شهيّة يُشجّعني دوماً

227
00:16:38,270 --> 00:16:41,960
آمل أن تُهدّئ هذه روحها، ولو قليلاً

228
00:16:41,960 --> 00:16:43,520
...تياراروز

229
00:16:44,230 --> 00:16:47,020
!أنا آسفة يا سموّ الأمير أكوا

230
00:16:47,020 --> 00:16:50,470
بعد أن قلتُ بأنّني أردتُك
...أن تأكلها أوّلاً

231
00:16:50,470 --> 00:16:52,020
ألا ينبغي لي ذلك؟

232
00:16:52,020 --> 00:16:54,870
تيارا... أنتِ ظريفة جدّاً

233
00:16:54,870 --> 00:16:56,880
...ا-الأمير أكوا

234
00:16:56,880 --> 00:16:57,920
لا عليكِ

235
00:16:59,360 --> 00:17:01,340
يمكنكِ فعل ما يحلو لكِ

236
00:17:02,520 --> 00:17:04,420
!شكراً لك

237
00:17:19,300 --> 00:17:20,640
...هذا

238
00:17:24,460 --> 00:17:27,150
!الشّاطئ يتجدّد

239
00:17:31,710 --> 00:17:33,740
الملك كلير، ما هذا؟

240
00:17:33,740 --> 00:17:35,390
إنّها قوّة بارل

241
00:17:36,320 --> 00:17:39,040
هذه هديّة وداع منّي

242
00:17:41,550 --> 00:17:43,130
!الملكة بارل

243
00:17:48,840 --> 00:17:51,590
منحتْ بارل برَكتها للمُحيط

244
00:17:52,320 --> 00:17:55,300
باستخدام آخر جزء مُتبقٍّ من سحرها

245
00:17:56,600 --> 00:17:58,810
...استهلكتْ كلَّ سحرها

246
00:17:59,280 --> 00:18:01,370
ودخلتْ في حالة نوم عميق...

247
00:18:01,830 --> 00:18:03,350
...بئساً

248
00:18:03,350 --> 00:18:06,250
والآن مُحال أن نعرف من يتلقّى عقوبة فعليّاً

249
00:18:08,760 --> 00:18:10,110
تلك الحمقاء

250
00:18:10,560 --> 00:18:12,070
...الملك كلير

251
00:18:12,070 --> 00:18:15,330
تياراروز، هلّا أعطيتِني الحلويّات
الّتي كانت مُخصّصة لبارل؟

252
00:18:15,330 --> 00:18:16,400
بكلّ تأكيد

253
00:18:31,460 --> 00:18:35,610
آمل أن تصلها بهذه الطّريقة

254
00:18:41,510 --> 00:18:44,730
عسى أن يُبارَك

255
00:18:46,170 --> 00:18:48,270
مُستقبل الملكة بارل

256
00:18:49,650 --> 00:18:52,950
الأمير أكواستيد وتياراروز-ساما

257
00:18:52,950 --> 00:18:57,160
سمعتُ بأنّ كليكما تلقّيتُما برَكات
من ملكة جنّيّي البحر

258
00:18:57,570 --> 00:19:00,780
!أمسى مُستقبل مارينفورست الآن آمناً

259
00:19:01,920 --> 00:19:05,970
تياراروز-ساما، تبدين كإلَهة

260
00:19:05,970 --> 00:19:09,630
شكراً لكِ. أشعر بسعادة واطمئنان

261
00:19:11,310 --> 00:19:12,480
ماذا كان ذلك؟

262
00:19:16,200 --> 00:19:19,720
...ما الأمر؟ أشعر وكأنّ شيئاً يُناديني

263
00:19:25,840 --> 00:19:29,400
هذه... رسالة من أكاري-ساما

264
00:19:29,990 --> 00:19:34,280
دوّنتْ كلّ شيء عن أيّامها السّعيدة
مع الأمير هارتنايتس باليابانيّة

265
00:19:35,610 --> 00:19:37,290
هذا هو طبع أكاري-ساما

266
00:19:38,640 --> 00:19:40,620
،بالمُناسبة يا تيارا-ساما

267
00:19:40,620 --> 00:19:42,990
هل يسير كلّ شيء على ما يُرام
بينكِ وبين الأمير أكوا؟

268
00:19:43,280 --> 00:19:47,520
إذا حاولت بطلة جزء التتمّة فعل
!شيء، فلا تستسلمي

269
00:19:47,520 --> 00:19:51,500
!وانتبهي من حدث جرعة الحُبّ تحديداً

270
00:19:51,820 --> 00:19:56,160
أكاري-ساما... ليتكِ أرسلتِ
هذه الرّسالة مُسبقاً

271
00:19:56,960 --> 00:20:00,010
إذاً كان هذا حدثاً في اللّعبة فعلاً

272
00:20:00,490 --> 00:20:02,780
،حالما تتلقّين برَكة ملك الجنّيّين

273
00:20:02,780 --> 00:20:04,880
!ستكشفين عن مرحلة مخفيّة

274
00:20:04,880 --> 00:20:06,770
ألم تفعلي ذلك بعد؟

275
00:20:07,670 --> 00:20:09,620
مرحلة مخفيّة؟

276
00:20:09,620 --> 00:20:11,920
إنّها تكتب عمّا سيحدث من هنا

277
00:20:11,920 --> 00:20:13,650
،إذا عرفتُ ما الّذي سيحدث

278
00:20:13,980 --> 00:20:19,220
رُبّما أستطيع تجنُّب تعديلات اللّعبة
وأضمن مُستقبلاً سعيداً

279
00:20:19,880 --> 00:20:21,020
...لكن

280
00:20:21,720 --> 00:20:22,920
وجدتُكِ

281
00:20:24,660 --> 00:20:26,700
كنتُ أبحث عنكِ يا تيارا

282
00:20:28,720 --> 00:20:30,270
ما الأمر؟

283
00:20:30,270 --> 00:20:32,770
لا شيء

284
00:20:33,900 --> 00:20:35,550
تبدين مُتوتّرة قليلاً

285
00:20:38,820 --> 00:20:41,280
تيارا، لا تنسي

286
00:20:41,280 --> 00:20:44,260
بأنّني سأبقى بجانبكِ دوماً

287
00:20:44,530 --> 00:20:47,340
،في السّرّاء والضرّاء

288
00:20:47,340 --> 00:20:52,520
وأريد أن أتشارك معكِ كلّ أفراحكِ وحزنكِ وألمكِ

289
00:20:53,000 --> 00:20:54,820
ما دمتُ على قيد الحياة

290
00:20:57,530 --> 00:20:59,110
...الأمير أكوا

291
00:21:07,230 --> 00:21:08,320
تيارا؟

292
00:21:10,480 --> 00:21:13,010
أُحبّك. أُحبّك حبّاً جمّاً

293
00:21:13,010 --> 00:21:14,500
أحبّك من أعماق قلبي

294
00:21:14,500 --> 00:21:17,580
شكراً لك على اختياري

295
00:21:18,300 --> 00:21:23,520
أنا سعيدة جدّاً لكوني معك
...يا سموّ الأمير أكوا... لا، يا أكوا

296
00:21:25,430 --> 00:21:28,890
يا للعجب! أنتِ ظريفة جدّاً

297
00:21:32,240 --> 00:21:34,290
هلّا رقصتِ معي؟

298
00:21:34,290 --> 00:21:35,540
بكلّ سرور

299
00:21:49,000 --> 00:21:50,640
مُحال لقصّة شرّيرة

300
00:21:50,640 --> 00:21:53,900
معشوقة بواسطة أمير مملكة مُجاورة

301
00:21:53,900 --> 00:21:55,680
أن تتواجد في لعبة

302
00:21:56,370 --> 00:21:59,380
،لكن كيفما كانت مُجريات القصّة لاحقاً

303
00:21:59,960 --> 00:22:01,880
...ما دمتُ مع الأمير أكوا

304
00:22:02,970 --> 00:22:05,250
فأنا سعيدة

305
00:23:23,390 --> 00:23:24,770
عُدت

306
00:23:25,730 --> 00:23:27,440
أهلاً بعودتك