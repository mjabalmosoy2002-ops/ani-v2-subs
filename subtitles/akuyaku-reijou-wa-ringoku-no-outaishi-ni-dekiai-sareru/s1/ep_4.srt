1
00:00:05,570 --> 00:00:07,990
أعددتُه حُلواً قليلاً

2
00:00:07,990 --> 00:00:10,070
شكراً لكِ يا فيليني

3
00:00:17,370 --> 00:00:19,600
ما ذلك الضّوء؟

4
00:00:25,060 --> 00:00:28,090
لم يرِد تقرير من القلعة بعد

5
00:00:28,590 --> 00:00:32,890
ما الّذي سيفعله الأمير أكوا عندما
يكتشف بأنّها كانت الصّلاة المُقدّسة؟

6
00:00:33,390 --> 00:00:37,350
إن سارت الأمور بنفس طريقة
...مسار القصّة

7
00:00:38,390 --> 00:00:41,780
الأمير أكوا هو مسار تمّ تقديمه
،في جزء التتمّة

8
00:00:41,780 --> 00:00:43,650
لذا لا ينبغي لهذا أن يكون مُهمّاً

9
00:00:44,340 --> 00:00:47,850
،لكن الآن بعد أن انتهت اللّعبة عمليّاً

10
00:00:47,850 --> 00:00:50,070
فماذا لو انتقلنا إلى جزء التتمّة الآن؟

11
00:01:05,800 --> 00:01:07,320
المعذرة

12
00:01:09,870 --> 00:01:11,900
قيل لي بأنّ الضّوء الّذي رأيناه قبل قليل

13
00:01:11,900 --> 00:01:14,720
كان نتيجة عتاد سحريّ معطوب

14
00:01:14,980 --> 00:01:17,070
وطُلِب من تياراروز-ساما العودة إلى المنزل

15
00:01:17,070 --> 00:01:23,300
حتّى تكتمل مُعاينة القلعة
للعتاد المذكور

16
00:01:23,300 --> 00:01:25,450
فهمت. عُلِم

17
00:01:28,100 --> 00:01:30,990
كان عتاداً سحريّاً معطوباً إذاً

18
00:01:30,990 --> 00:01:32,930
يسرّني أنّ الأمر لم يكن خطيراً

19
00:01:34,030 --> 00:01:36,440
تيارا، سأوصلكِ إلى المنزل

20
00:01:37,100 --> 00:01:39,500
حسناً، شكراً لك

21
00:01:40,120 --> 00:01:42,300
أُفضّل حقّاً ألّا أعود إلى المنزل

22
00:01:42,870 --> 00:01:46,350
أريد أن أرى بنفسي إلى أين
تتّجه اللّعبة تالياً

23
00:01:47,130 --> 00:01:52,160
آمل فقط ألّا يمسك الأمير أكوا
...بيد البطلة

24
00:03:31,860 --> 00:03:32,810
ادخل

25
00:03:34,360 --> 00:03:36,150
عدتُ للتو

26
00:03:36,410 --> 00:03:39,130
استغرق ذلك وقتاً طويلاً. ماذا حدث؟

27
00:03:39,910 --> 00:03:40,960
...في الواقع

28
00:03:41,550 --> 00:03:43,000
،تفاجأتُ لدى معرفة بأنّ أكاري-ساما

29
00:03:43,000 --> 00:03:47,520
الفتاة الّتي بجانب الأمير هارتنايتس
،في حفل التخرُّج

30
00:03:47,520 --> 00:03:49,960
قد تعلّمتْ استخدام الصّلاة المُقدّسة

31
00:03:51,130 --> 00:03:53,710
!غير ممكن... الآنسة أكاري فعلتْ ذلك؟

32
00:03:58,570 --> 00:04:01,220
أمستْ هذه مُشكلة كبيرة

33
00:04:01,220 --> 00:04:03,320
...الآنسة أكاري من بين كلّ النّاس

34
00:04:03,990 --> 00:04:07,730
الصّلاة المُقدّسة هي قوّة مرغوبة
بواسطة كافّة الدُّول

35
00:04:07,730 --> 00:04:09,930
المنافع الّتي تُحقّقها عظيمة جدّاً

36
00:04:09,930 --> 00:04:13,230
لدرجة أنّ أيّ دولة تمتلكها تستطيع
الاستمتاع بسلام كامل

37
00:04:13,530 --> 00:04:17,790
أجل، لهذا السّبب أولئك الّذين يستطيعون استخدامها
غالباً ما يتزوّجون من الطّبقة الملكيّة

38
00:04:18,250 --> 00:04:20,970
حتّى العائلة الملكيّة تريد جعلها مُلكها

39
00:04:20,970 --> 00:04:22,220
بالفعل

40
00:04:22,810 --> 00:04:27,930
من المُرجّح أنّ لابيس لازولي سوف تجعل
تلك الفتاة تتزوّج الأمير هارتنايتس

41
00:04:27,930 --> 00:04:30,480
وذلك كي لا يفقدوها أبداً

42
00:04:30,990 --> 00:04:32,240
على الأغلب

43
00:04:32,800 --> 00:04:37,030
لكن يمكننا على الأقلّ استخدام قوّة
مارينفوريست للتدخُّل

44
00:04:37,030 --> 00:04:41,260
،إذا استطعنا الحصول على الصّلاة المُقدّسة
فسوف تزدهر دولتنا أكثر حتّى

45
00:04:41,940 --> 00:04:45,210
الفتاة الّتي تستطيع استخدام
الصّلاة المُقدّسة؟

46
00:04:46,060 --> 00:04:47,350
أريدها

47
00:04:51,850 --> 00:04:53,940
،مضى عشرة أيّام منذ ذلك الحين

48
00:04:53,940 --> 00:04:57,490
لكن ما زلتُ لا أفقه شيئاً عن الصّلاة المُقدّسة

49
00:04:58,600 --> 00:05:03,020
،بما أنّ أبي هو رئيس الوزراء
...فأنا واثقة بأنّه يعلم

50
00:05:03,630 --> 00:05:07,580
لكن لا أستطيع سؤاله عن شيء
تتستّر عليه العائلةُ الملكيّة

51
00:05:07,980 --> 00:05:11,120
"!في الواقع أعلم بشأن الصّلاة المُقدّسة"

52
00:05:12,680 --> 00:05:14,360
لكن لا أستطيع إخباره بذلك

53
00:05:14,360 --> 00:05:17,560
لم أرَ الأمير أكوا منذ ذلك اليوم أيضاً

54
00:05:18,080 --> 00:05:21,400
ألا يعلم بشأن الصّلاة المُقدّسة بعد؟

55
00:05:21,400 --> 00:05:25,100
...أم... إذا كان يعلم بشأنها

56
00:05:25,430 --> 00:05:27,150
تياراروز

57
00:05:27,150 --> 00:05:30,410
اكتملت التّحضيرات للمُغادرة إلى مارينفوريست

58
00:05:30,410 --> 00:05:32,550
يمكنكِ الذّهاب إلى هناك متى جهزتِ

59
00:05:33,300 --> 00:05:37,520
بالطّبع، سوف أُرافقكِ كلّ الطّريق

60
00:05:37,520 --> 00:05:39,830
شكراً لكِ يا فيليني

61
00:05:39,830 --> 00:05:43,120
لكن متى ستُغادرين؟

62
00:05:43,120 --> 00:05:47,790
ألم يقترب وقت عودة الأمير
أكواستيد إلى المنزل كذلك؟

63
00:05:48,670 --> 00:05:50,080
بلى

64
00:05:50,960 --> 00:05:55,800
من المُحبط جدّاً ألّا أستطيع فعل
شيء سوى انتظار نبأ منه

65
00:06:03,340 --> 00:06:05,980
لماذا لم يأتِ الأمير أكوا إلى هنا بعد؟

66
00:06:07,230 --> 00:06:09,360
،ظننتُ أنّه حالما يرى قوّة الصّلاة المُقدّسة

67
00:06:09,360 --> 00:06:13,920
فسيقول فوراً بأنّه يريدني
ويتوجّه إلى هنا لإحضاري

68
00:06:14,740 --> 00:06:18,750
،ثمّ أذهب إلى مارينفوريست رفقة الأمير أكوا

69
00:06:18,750 --> 00:06:21,130
!ثمّ نتزوّج

70
00:06:21,600 --> 00:06:24,780
!أو هذا ما توقّعتُه، لكن مضى أسبوعان

71
00:06:24,780 --> 00:06:29,030
!تبّاً يا أمير أكوا! تعال إلى هنا فحسب

72
00:06:42,120 --> 00:06:44,390
فيليني، ما رأيكِ؟

73
00:06:44,390 --> 00:06:47,000
!يبدو هذا لذيذاً حقّاً

74
00:06:47,000 --> 00:06:48,510
!أسعدتِني

75
00:06:53,520 --> 00:06:55,840
الأمير أكوا قادم لرؤيتي

76
00:06:56,480 --> 00:07:00,480
لا بُدّ أنّ التّفاصيل حُسِمت أخيراً... صحيح؟

77
00:07:01,750 --> 00:07:02,820
ستكون الأمور على ما يُرام

78
00:07:03,500 --> 00:07:05,820
،لم يقل أبي شيئاً

79
00:07:05,820 --> 00:07:07,680
لذا أنا متأكّدة بأنّه لن يأتي بأنباء سيّئة

80
00:07:08,890 --> 00:07:11,580
آمل أن يحبّ الأمير أكوا هذه

81
00:07:15,710 --> 00:07:18,460
آسف لأنّني لم أتمكّن من المجيء
إلى هنا كثيراً في الآونة الأخيرة

82
00:07:18,750 --> 00:07:21,710
كانت كلّ التّحضيرات تستهلك وقتي

83
00:07:21,710 --> 00:07:24,720
لا عليك، لا تقلق بشأن ذلك

84
00:07:31,690 --> 00:07:34,060
...أتساءل ما مُشكلة الأمير أكوا

85
00:07:37,750 --> 00:07:40,900
في الحقيقة، تمّ حسم الخطوبة

86
00:07:41,840 --> 00:07:43,730
أقصد بشأن الآنسة أكاري

87
00:07:44,150 --> 00:07:45,230
ماذا؟

88
00:07:45,850 --> 00:07:48,910
أكاري-ساما... ومن؟

89
00:07:49,980 --> 00:07:52,730
لن أتفاجأ إذا كان يسعى

90
00:07:52,730 --> 00:07:55,800
للحصول على الصّلاة المُقدّسة

91
00:07:56,880 --> 00:07:59,690
إذاً... هل سيحدث ذلك من جديد؟

92
00:08:00,240 --> 00:08:03,470
!لا! أرجوكِ، لا تأخذي الأمير أكوا منّي

93
00:08:03,470 --> 00:08:05,530
!أيّ شيء عدا هذا

94
00:08:07,550 --> 00:08:12,140
الآنسة أكاري والأمير هارتنايتس
مخطوبان بشكل رسميّ الآن

95
00:08:13,940 --> 00:08:16,120
إنّه الرّجل الّذي أذاكِ

96
00:08:16,480 --> 00:08:18,690
...أعتقد بأنّكِ تشعرين بتضارُب حيال هذا، لكن

97
00:08:20,580 --> 00:08:23,210
...الخطوبة ليست من... الأمير أكوا

98
00:08:25,920 --> 00:08:26,990
تيارا؟

99
00:08:28,390 --> 00:08:31,320
أنا آسفة. شعرتُ براحة فحسب

100
00:08:32,100 --> 00:08:36,440
ظننتُك ستخطب أكاري-ساما

101
00:08:36,440 --> 00:08:37,830
كنتُ خائفة للغاية

102
00:08:38,130 --> 00:08:39,870
ولماذا تعتقدين ذلك؟

103
00:08:40,280 --> 00:08:43,090
مُحال أن أختار سواكِ

104
00:08:44,070 --> 00:08:46,460
أنا آسف لأنّني جعلتُكِ تشعرين بقلق

105
00:08:47,290 --> 00:08:49,190
هيّا، لا تبكي

106
00:08:49,190 --> 00:08:50,700
...لستُ

107
00:08:52,480 --> 00:08:53,510
ماذا؟

108
00:09:00,710 --> 00:09:02,460
...الأمير أكوا

109
00:09:02,460 --> 00:09:05,130
تيارا، افتقدتُكِ كثيراً

110
00:09:05,130 --> 00:09:06,490
كذلك أنا

111
00:09:10,520 --> 00:09:11,750
هذا مُطمئن

112
00:09:12,200 --> 00:09:16,490
من المُطمئن ألّا يختار الأمير أكوا أكاري-ساما

113
00:09:17,900 --> 00:09:20,470
سآخذكِ معي إلى مارينفوريست

114
00:09:21,180 --> 00:09:24,590
ستبقين بجانبي لبقيّة حياتنا، أليس كذلك؟

115
00:09:24,590 --> 00:09:27,440
بالطّبع يا سموّ الأمير أكوا

116
00:10:03,720 --> 00:10:05,960
مساء الخير يا تيارا-ساما

117
00:10:06,360 --> 00:10:08,470
أكاري... ساما؟

118
00:10:23,840 --> 00:10:26,190
مساء الخير يا تيارا-ساما

119
00:10:26,560 --> 00:10:29,020
أكاري... ساما؟

120
00:10:29,350 --> 00:10:32,690
في الواقع، فكّرتُ في الأمر مليّاً

121
00:10:33,470 --> 00:10:37,030
تيارا-ساما، أنتِ لاعبة في هذه
اللّعبة، أليس كذلك؟

122
00:10:38,620 --> 00:10:39,910
خاتم لابيس لازولي

123
00:10:41,500 --> 00:10:46,880
اللّعبة... إذاً أكاري-ساما مثلي حقّاً

124
00:10:47,170 --> 00:10:50,780
أقصد بأنّكِ الشّيء الوحيد
الّذي يختلف عن اللّعبة

125
00:10:50,780 --> 00:10:53,000
،سارَ كلُّ شيء آخر وفقاً لأحداث اللّعبة

126
00:10:53,000 --> 00:10:55,590
!لكن النّهاية لم تسرِ كما ينبغي إطلاقاً

127
00:10:56,030 --> 00:11:00,180
المعذرة... لا أعتقد بأنّني أفهمكِ

128
00:11:00,180 --> 00:11:02,190
!لا حاجة لادّعاء الجهل

129
00:11:03,840 --> 00:11:08,400
وأنا الّتي كنتُ أُخطّط هنا للزّواج
...من الأمير هارتنايتس وأعيش بسعادة

130
00:11:08,400 --> 00:11:11,690
،لكن بعدها جاء المُفضّل لديّ
!الأمير أكوا

131
00:11:11,690 --> 00:11:14,000
!لم أستطع تصديق ذلك

132
00:11:15,450 --> 00:11:19,210
لكن الأمير أكوا هو المسار
،الرّئيسيّ في جزء التتمّة

133
00:11:19,210 --> 00:11:23,150
لذا ارتأيتُ بأنّني سأرضى بالأمير
...هارتنايتس، المُفضّل الثّاني لديّ

134
00:11:23,150 --> 00:11:27,210
،لكن إذا كنتُ سأتزوّج الأمير أكوا
!فإنّني  أُفضّله بالطّبع

135
00:11:28,980 --> 00:11:32,540
لم تسمعي حتّى بجزء التتمّة، أليس كذلك؟

136
00:11:33,050 --> 00:11:36,170
بالبطلة الظّريفة في مارينفوريست؟

137
00:11:36,170 --> 00:11:37,360
ماذا؟

138
00:11:37,680 --> 00:11:39,100
!توقّعتُ ذلك

139
00:11:39,100 --> 00:11:42,680
.كنتُ أحاول خداعكِ لتعترفي بذلك
!يسرّني أنّ ذلك قد أفلح

140
00:11:45,310 --> 00:11:46,970
تجسدتُ من جديد

141
00:11:47,440 --> 00:11:51,690
،أتذكّر بأنّني كنتُ ألعب اللّعبة
لكن هذا كلّ شيء

142
00:11:51,690 --> 00:11:54,800
...إذاً هذا يعني

143
00:11:54,800 --> 00:11:57,580
!أنّكِ مُتِّ قبل حتّى أن تلعبي التتمّة؟

144
00:11:57,580 --> 00:11:59,280
!هذا لا يُصدَّق

145
00:12:00,280 --> 00:12:04,680
أيّتها المسكينة! لا توجد لعبة
!أوتومي بمثل روعة هذه اللّعبة

146
00:12:04,680 --> 00:12:06,500
،الأمير هارتنايتس رائع

147
00:12:06,500 --> 00:12:10,290
لكن الأمير أكوا في جزء التتمّة
!أفضل بكثير، بكثير

148
00:12:10,770 --> 00:12:14,950
البطلة في جزء التتمّة هي ابنة دوق
في مارينفوريست تُدعى آيشيلا

149
00:12:14,950 --> 00:12:16,900
وعندما يشعر الأمير أكوا بالضّجر

150
00:12:16,900 --> 00:12:20,800
،من الخطيبة الّتي اختارَتْه لها الدّولة
!يلتقي بها على شاطئ البحر

151
00:12:20,800 --> 00:12:23,130
بطلة جزء التتمّة؟

152
00:12:23,920 --> 00:12:26,430
!ذلك المشهد غاية في الرّوعة

153
00:12:26,430 --> 00:12:28,840
لم أعُد أحصي عدد المرّات
!الّتي أعدتُه فيها

154
00:12:30,460 --> 00:12:35,110
،على أيّ حال، أظنّكِ تعلمين هذا
لكن أستطيع استخدام الصّلاة المُقدّسة

155
00:12:35,620 --> 00:12:40,700
وإذا أخبرتُ أميري الحبيب أكوا
بذلك، فسأتمكّن من الزّواج منه

156
00:12:41,240 --> 00:12:44,620
لذا انفصلي عنه أرجوكِ

157
00:12:44,620 --> 00:12:45,580
!لا

158
00:12:45,580 --> 00:12:46,790
لِمَ لا؟

159
00:12:46,790 --> 00:12:49,390
،أحبّه أكثر بكثير ممّا تُحبّينه

160
00:12:49,390 --> 00:12:51,810
!ولعبتُ اللّعبة مرّات كثيرة

161
00:12:51,810 --> 00:12:55,290
!الأمير أكوا ليس لعبة! إنّه شخص

162
00:12:55,290 --> 00:12:58,140
!أعلم ذلك بالطّبع

163
00:12:58,140 --> 00:13:02,090
!لكن نظرتكِ لهذا الأمر تتجاهل أُمنياته

164
00:13:02,430 --> 00:13:04,130
عمّاذا تتكلّمين؟

165
00:13:04,130 --> 00:13:07,290
،كوليّ عهد لبلد كبير، حالما يكتشف

166
00:13:07,290 --> 00:13:09,750
فسوف يريدني بالطّبع

167
00:13:10,650 --> 00:13:12,020
...لذا فقط

168
00:13:15,900 --> 00:13:17,320
...ما الّذي

169
00:13:17,890 --> 00:13:20,060
كنتُ أقول لنفسي... ماذا عن سيناريو

170
00:13:20,060 --> 00:13:24,030
حيث تُصاب تيارا-ساما وتُفسَخ خطوبتها؟

171
00:13:26,280 --> 00:13:29,370
لا تقلقي. سيجعلكِ ذلك تنامين قليلاً

172
00:13:29,370 --> 00:13:30,830
يمكنكِ أن تسترخي

173
00:13:30,830 --> 00:13:33,540
!تعلمين بأنّكِ لن تفلتي بفعلتكِ هذه

174
00:13:33,540 --> 00:13:36,300
،حسناً، أنا البطلة

175
00:13:36,300 --> 00:13:41,300
،لذا عندما ينتهي كلّ شيء
!سأحظى بالنّهاية السّعيدة

176
00:13:45,430 --> 00:13:48,090
!تعال أيّها الرّعد

177
00:14:00,190 --> 00:14:03,260
هذا جيّد. يبدو أنّني وصلتُ في الوقت

178
00:14:04,780 --> 00:14:06,240
...الأمير أكوا

179
00:14:06,240 --> 00:14:08,400
...لـ-لماذا

180
00:14:09,060 --> 00:14:11,200
الأمير أكوا هنا؟

181
00:14:14,310 --> 00:14:17,460
أنا آسف. أرى بأنّني لم أصل
في الوقت في نهاية المطاف

182
00:14:19,370 --> 00:14:21,210
!ما الّذي يجري هنا؟

183
00:14:22,310 --> 00:14:25,720
أكاري-ساما، سوف تشرحين هذا، أليس كذلك؟

184
00:14:25,720 --> 00:14:28,030
!الأمر ليس كما تعتقد يا سموّ الأمير أكوا

185
00:14:28,030 --> 00:14:31,300
!تعلّمتُ كيفيّة استخدام الصّلاة المُقدّسة

186
00:14:31,300 --> 00:14:35,610
لكن يبدو وكأنّني سأُجبَر على
...الزّواج من الأمير هارتنايتس

187
00:14:35,610 --> 00:14:37,730
!أنقذني أرجوك يا سموّ الأمير أكوا

188
00:14:38,130 --> 00:14:41,300
!خذني معك إلى مملكتك

189
00:14:41,740 --> 00:14:43,500
ما الّذي منحكِ الحقّ؟

190
00:14:43,500 --> 00:14:46,990
أنتِ تُحبّين الأمير هارتنايتس، أليس كذلك؟

191
00:14:46,990 --> 00:14:50,030
!لا تتدخّل في هذا أيُّها الماركيز كلامينتيل

192
00:14:50,680 --> 00:14:54,190
الأمير أكوا، ألن يجعل امتلاكك
لي ولصلاتي المُقدّسة

193
00:14:54,190 --> 00:14:56,000
مملكتك أكثر ازدهاراً؟

194
00:14:58,000 --> 00:15:00,510
...لا! من فضلك لا تفعلي

195
00:15:00,510 --> 00:15:03,050
!إلّا الأمير أكوا! أرجوكِ

196
00:15:05,010 --> 00:15:06,510
أعلم ذلك

197
00:15:09,370 --> 00:15:13,640
أعلم بأنّكِ تمتلكين قوّة الصّلاة المُقدّسة

198
00:15:13,640 --> 00:15:18,150
إذاً لماذا لم تجعلني خطيبتك؟

199
00:15:18,660 --> 00:15:20,900
لا تستهيني بي

200
00:15:21,230 --> 00:15:25,310
أستطيع قيادة مملكتي إلى الازدهار
حتّى من دون قوّتكِ

201
00:15:26,000 --> 00:15:28,660
لذا لستُ أحتاجكِ

202
00:15:29,060 --> 00:15:31,110
...الوحيدة الّتي أُريدها هي

203
00:15:34,230 --> 00:15:35,650
تيارا

204
00:15:37,860 --> 00:15:39,390
...الأمير أكوا

205
00:15:40,250 --> 00:15:41,610
...كذِب

206
00:15:42,600 --> 00:15:44,470
!كلّ هذا كذِب

207
00:15:44,470 --> 00:15:47,340
...مُحال ألّا تختارني

208
00:15:48,260 --> 00:15:49,590
اعتقلوها

209
00:15:55,880 --> 00:15:59,010
يسرّني أنّكِ بخير. هل أُصبتِ
بأي جروح أُخرى؟

210
00:15:59,010 --> 00:16:03,830
لا. أنا بأمان لأنّك أتيت لإنقاذي

211
00:16:03,830 --> 00:16:06,590
وهذا الشّيء على خدّي
هو مُجرّد خدش

212
00:16:07,030 --> 00:16:08,350
...المعذرة

213
00:16:08,350 --> 00:16:09,840
ابقي هكذا فحسب

214
00:16:11,550 --> 00:16:13,600
،بعد ما مررتِ به

215
00:16:13,600 --> 00:16:16,040
لا مانع أن تكوني أكثر إلحاحاً في طلباتكِ

216
00:16:16,510 --> 00:16:22,270
الأمير أكوا، شكراً جزيلاً لك
على المجيء لإنقاذي

217
00:16:27,540 --> 00:16:29,780
...لماذا يجب عليّ

218
00:16:30,300 --> 00:16:33,760
!أن أعيش في مكان كهذا؟

219
00:16:37,100 --> 00:16:40,560
تمّ إعفائي من عقوبة أخطر
...بفضل تيارا-ساما، لكن رغم ذلك

220
00:16:41,320 --> 00:16:42,460
!تعال أيّها الماء

221
00:16:49,680 --> 00:16:53,850
ما دمتُ هنا، هذا هو أقوى
سحر أستطيع استعماله

222
00:16:53,850 --> 00:16:58,090
لو كنّا في لعبة أوتومي، لجاء
...أميرٌ لإنقاذي

223
00:16:58,740 --> 00:17:01,790
!لحظة، هذه لعبة أوتومي

224
00:17:03,220 --> 00:17:04,250
تفضّل؟

225
00:17:06,270 --> 00:17:07,940
!الأمير هارتنايتس

226
00:17:08,760 --> 00:17:10,730
!أتيت لأجلي

227
00:17:11,160 --> 00:17:13,500
!سأعدّ الشّاي حالاً

228
00:17:14,350 --> 00:17:16,570
لن أبقى لفترة طويلة

229
00:17:16,570 --> 00:17:17,770
ليس عليكِ ذلك

230
00:17:18,210 --> 00:17:19,930
أريد فعلها

231
00:17:19,930 --> 00:17:22,190
فالبقاء مُملّ هنا، لم أعُد أحتمل

232
00:17:25,630 --> 00:17:27,610
أنتِ وأنا سنتزوّج

233
00:17:28,790 --> 00:17:30,860
أجل، أعلم

234
00:17:31,790 --> 00:17:34,620
قبلتِ بذلك بسهولة

235
00:17:35,160 --> 00:17:39,610
سمعتُ بأنّكِ... تكنّين مشاعرَ للأمير أكواستيد

236
00:17:40,240 --> 00:17:43,400
،بالطّبع، فالأمير أكوا هو المُفضّل لديّ

237
00:17:43,920 --> 00:17:47,130
لكن الأمير هارتنايتس مُخطئ

238
00:17:47,990 --> 00:17:50,920
أحبّك أيضاً يا سموّ الأمير هارتنايتس

239
00:17:52,380 --> 00:17:54,710
،انعتني بالوقِحة

240
00:17:54,710 --> 00:18:00,140
لكن أعشق كلّ شيء يتعلّق
!بعالم لعبة الأوتومي هذه

241
00:18:01,100 --> 00:18:02,890
!أُحبّك حُبّاً جمّاً

242
00:18:05,530 --> 00:18:06,650
حقّاً؟

243
00:18:11,400 --> 00:18:13,150
سأعود إلى المنزل الآن

244
00:18:24,910 --> 00:18:26,950
أحضري تلك الأمتعة إلى هنا

245
00:18:28,950 --> 00:18:32,910
الأمير أكواستيد، من فضلك اعتن بابنتنا

246
00:18:33,300 --> 00:18:37,630
بكلّ تأكيد. وسوف أُسعدها

247
00:18:38,000 --> 00:18:41,320
أنا سعيدٌ بالفعل من الآن

248
00:18:41,320 --> 00:18:45,770
الأمير أكوا، أنا سعيدة جدّاً بالفعل كذلك

249
00:18:47,100 --> 00:18:48,730
حسناً، غلبتني

250
00:18:49,340 --> 00:18:52,240
تحضيرات المُغادرة قد تمّت

251
00:18:53,350 --> 00:18:56,660
ستذهبين من الآن؟ سنفتقدكِ

252
00:18:57,210 --> 00:18:59,280
،بعد أن أتمم عاماً من التّدريب العرائسيّ

253
00:18:59,280 --> 00:19:03,660
سأعود إلى هنا لأجل إطلالتي
الأولى في الحفلة

254
00:19:04,260 --> 00:19:07,380
يمكنكما التطلُّع قُدماً لكثير
من الهدايا من مارينفوريست

255
00:19:08,430 --> 00:19:10,130
لا أطيق الانتظار

256
00:19:10,520 --> 00:19:13,010
رافقتكِ السّلامة يا تيارا

257
00:19:13,010 --> 00:19:15,380
لا تقومي بأيّ عمل مُتهوّر

258
00:19:15,880 --> 00:19:19,890
حسناً. اعتنيا بنفسيكما يا أبي وأمّي كذلك

259
00:19:23,610 --> 00:19:26,120
أنتِ أيضاً يا فيليني. كوني بخير

260
00:19:26,120 --> 00:19:31,070
شكراً. سأدعم تياراروز-ساما حتّى النّهاية

261
00:19:31,650 --> 00:19:36,780
قلبي ينبض بطريقة مُختلفة
عن أيّ وقت مضى

262
00:19:36,780 --> 00:19:38,150
!سنُغادر

263
00:19:53,640 --> 00:19:57,050
هناك جنّيات في مارينفوريست، أليس كذلك؟

264
00:19:57,050 --> 00:20:01,010
أجل. أنا متأكّد بأنّها تمنحكِ بركاتها

265
00:20:01,010 --> 00:20:03,180
لا أطيق انتظار اللّقاء بهم

266
00:20:05,900 --> 00:20:08,900
،كنتُ مُحرَجة من القيام بذلك سابقاً

267
00:20:09,440 --> 00:20:11,610
لكن أريد مُحاولة لفت انتباهه

268
00:20:14,850 --> 00:20:16,140
...تيارا

269
00:20:18,420 --> 00:20:20,950
!انسي الأمر! هذا أكثر ما يمكنني فعله

270
00:20:24,480 --> 00:20:28,480
تيارا، أنتِ ظريفة جدّاً حقّاً

271
00:20:32,330 --> 00:20:33,460
ماذا؟

272
00:20:35,590 --> 00:20:37,420
رسالة؟

273
00:20:39,860 --> 00:20:42,220
إنّها لكِ، من الآنسة أكاري

274
00:20:42,860 --> 00:20:44,350
من الآنسة أكاري؟

275
00:20:44,930 --> 00:20:48,310
،إنّها مُريبة جدّاً. أنا آسف
لكن سأتفقّدها أوّلاً

276
00:20:50,660 --> 00:20:52,130
،عزيزتي تيارا-ساما

277
00:20:52,660 --> 00:20:57,330
هذه الرّسالة هي السّحر الأقوى الّذي
أستطيع استخدامه في البرج الأبيض

278
00:20:57,790 --> 00:21:02,530
سأبذل قصارى جهدي لأعيش
،سعيدة مع الأمير هارتنايتس

279
00:21:02,530 --> 00:21:05,980
لذا من فضلكِ ابحثي عن سعادتكِ أيضاً

280
00:21:09,480 --> 00:21:12,460
أشعر بأنّ الأمور تسير بسلاسة
...أكثر من الطّبيعيّ، لكن

281
00:21:17,210 --> 00:21:25,210
،إذا خسرتِ أمام بطلة جزء التتمّة
!!فلن أُسامحكِ أبداً

282
00:21:18,280 --> 00:21:20,610
هل هذه... يابانيّة؟

283
00:21:28,030 --> 00:21:31,590
الأمير أكوا، هلّا احتفظتُ بهذه الرّسالة؟

284
00:21:31,590 --> 00:21:33,360
...حسناً، لا أُمانع

285
00:21:40,940 --> 00:21:44,960
لن أخسر أمام بطلة جزء التتمّة
!الّتي لم ألتقِ بها بعد

286
00:21:50,330 --> 00:21:52,780
عاد وليّ العهد

287
00:21:53,930 --> 00:21:57,180
والآن أتساءل ما الفتاة الّتي
عاد بها إلى الدّيار

288
00:23:30,570 --> 00:23:34,390
أنا سعيدة جدّاً لأنّني تمكّنتُ
!من رؤية المُحيط مع الأمير أكوا

289
00:23:34,390 --> 00:23:36,770
من الّتي تبتسم في الشّاطئ؟

290
00:23:36,770 --> 00:23:39,410
!هل يُعقَل أنّها... بطلة جزء التتمّة؟