1
00:01:00,370 --> 00:01:05,040
تمرين

2
00:01:02,970 --> 00:01:07,080
سيُعقَدُ اجتماعٌ دعائي اليوم
في شركة تسجيلات هيمين

3
00:01:07,400 --> 00:01:09,660
الاجتماع الدعائي هو ببسيطِ العبارة

4
00:01:09,660 --> 00:01:12,290
اجتماعٌ نحدِّدُ فيه كيفيّة الترويج عن أنفسنا

5
00:01:13,240 --> 00:01:18,020
لقد طُرِحَ ألبومي الأوّل في الأسواق
وسنصدرُ مزيداً من الأغاني الجديدة

6
00:01:18,020 --> 00:01:19,390
نحنُ مستعدّون ومتأهِّبون

7
00:01:19,390 --> 00:01:21,060
سنؤجّلُ جولتي أيضاً

8
00:01:21,490 --> 00:01:24,210
سأشتهرُ بهجوم كاسح على العالم

9
00:01:24,760 --> 00:01:26,690
...هجوم على العالم

10
00:01:26,690 --> 00:01:28,850
هجوم على مونوكروم

11
00:01:28,850 --> 00:01:30,370
لماذا تكرِّرين نفس الكلام؟

12
00:01:30,930 --> 00:01:32,440
لا سبَب وجيه

13
00:01:32,440 --> 00:01:34,750
هذه فرصتُكِ لتحقيقِ الشهرة أكثر

14
00:01:34,750 --> 00:01:36,300
لنشتهر شهرة جنونيّة

15
00:01:36,300 --> 00:01:38,120
ثمّ يوماً ما، ستُدرَج تسجيلات هيمين

16
00:01:38,120 --> 00:01:40,260
في القسم الأوَّل من بورصة طوكيو

17
00:01:40,260 --> 00:01:42,260
هذا حلمٌ كبير

18
00:01:42,260 --> 00:01:45,470
اودُّ أن أفتتحَ فرعاً ثانياً أو ثالثاً
لمتجر يوماً ما أيضاً

19
00:01:45,770 --> 00:01:46,870
!لنبذل قصارى جهدنا

20
00:01:46,870 --> 00:01:49,290
،لنضع البورصة وافتتاح الفروع جانباً

21
00:01:49,670 --> 00:01:53,540
هلّا طرحتُما أفكاركما حول الوسائل
التي ينبغي اتّباعها لتحقيق مبيعات؟

22
00:01:53,540 --> 00:01:54,920
من أي وجهة نظر؟

23
00:01:54,920 --> 00:01:59,220
على سبيلِ المثال، تبيعُ كيكوكو 100.002.000 نسخة ألبوم

24
00:01:59,220 --> 00:02:00,710
!هذه ألمَع نجمة

25
00:02:00,710 --> 00:02:02,810
ماذا يجدرُ بي أن أفعل لأتخطَّى كيكوكو؟

26
00:02:03,150 --> 00:02:05,770
أظنُّ أنَّ تعزيز ظهوركِ أمر مهمّ

27
00:02:05,770 --> 00:02:06,730
ظهوري؟

28
00:02:06,730 --> 00:02:09,920
نعم، لنُعلِم أكبر قدر مُمكن من الناس من تكونين

29
00:02:09,920 --> 00:02:11,100
وكيف نفعلُ ذلك؟

30
00:02:11,100 --> 00:02:13,930
سنُنشئ عيِّنات ونرسلها إلى محطَّات

31
00:02:13,930 --> 00:02:17,050
الإذاعة والتلفزيون في كل أنحاء العالم
ونطلب منهم عرض أغانيكِ

32
00:02:17,050 --> 00:02:18,820
أظنُّها ستكونُ دعاية إشهار جيّدة

33
00:02:18,820 --> 00:02:20,910
فكرة سديدة يا يايوي-تان

34
00:02:20,910 --> 00:02:24,610
قد لا أبدو كذلك، لكنّني مروِّجة تسجيلات هيمين

35
00:02:24,610 --> 00:02:27,720
حسناً إذاً، سأطلبُ تصنيع سبعة مليارات عيّنة حالاً

36
00:02:27,720 --> 00:02:28,830
!سبعة مليارات؟

37
00:02:28,830 --> 00:02:33,020
أيْ نسخة واحدة لكل شخص في العالم

38
00:02:33,020 --> 00:02:33,910
...يبدو ذلك رائعاً

39
00:02:33,910 --> 00:02:34,960
!انتظري

40
00:02:35,410 --> 00:02:36,470
أمزحُ فقط

41
00:02:36,470 --> 00:02:41,120
لا ألمِّح أبداً إلى توقُّفي عن القيامِ بذلك

42
00:02:41,120 --> 00:02:42,520
عن ماذا؟

43
00:02:42,520 --> 00:02:44,970
،إن سلَّمنا سبعة مليارات عيّنة

44
00:02:44,970 --> 00:02:46,680
فلن يبقى أحدٌ لشرائها

45
00:02:46,680 --> 00:02:50,630
معكِ حقّ، كما تقولين تماماً

46
00:02:50,630 --> 00:02:52,880
يا لي من خرقاء، خرقاء للغاية

47
00:02:52,880 --> 00:02:54,230
لم تتغيّري البتّة

48
00:02:54,230 --> 00:02:57,120
ناهيك عن أنّ تسجيلات هيمين لا زالَتْ شركة صغيرة

49
00:02:57,120 --> 00:03:00,690
لِذا لن نستطيع تغطية تكاليف
سبعة مليارات عيّنة البتّة

50
00:03:00,690 --> 00:03:02,200
لا داعي للشعور بالإحباط

51
00:03:02,520 --> 00:03:03,740
مونوكروم-سان؟

52
00:03:03,740 --> 00:03:08,840
"عندما ذكرَتْ يايوي-تان "كثير من العيّنات
خطرَتْ في ذهني فكرة جيّدة

53
00:03:08,840 --> 00:03:10,710
لا أتوقّع أقلّ من ذلك من مروّجتنا المتمكّنة

54
00:03:11,920 --> 00:03:14,460
أنتِ تحرجينني، ما هي هذه "الفكرة الجيّدة"؟

55
00:03:14,740 --> 00:03:18,210
فكرة أكثر فعاليّة من توزيع العيّنات بكثير

56
00:03:21,180 --> 00:03:23,160
ألبومي مُتاحٌ في الأسواق الآن

57
00:03:23,160 --> 00:03:24,600
أنا أقيمُ حفلاً موسيقيّاً

58
00:03:24,600 --> 00:03:26,430
شكراً لكم، شكراً لكم

59
00:03:26,900 --> 00:03:29,170
ينتظرُني الجميع في أنحاء البلد

60
00:03:26,900 --> 00:03:29,170
،استنسخَتْ مونوكروم كثيراً من نفسها

61
00:03:29,170 --> 00:03:31,940
وكدحَتْ للترويجِ عن نفسها

62
00:03:32,210 --> 00:03:35,890
ينبغي لهذا أن يكون أكثر فعاليّة
من إنشاء عيِّنات

63
00:03:35,890 --> 00:03:37,430
حملة استنساخ

64
00:03:37,430 --> 00:03:39,370
هذا شيءٌ لا يستطيع فعله إلّا مونوكروم-سان

65
00:03:39,370 --> 00:03:41,590
سيكونُ ذلك حديث أهل البلدة بالتأكيد

66
00:03:41,590 --> 00:03:43,700
رائع، تِلك حقّاً مصنوعة سابِقة لأوانها

67
00:03:45,230 --> 00:03:47,830
سأشتهرُ أكثر

68
00:03:50,830 --> 00:03:53,210
سيسيطرُ سوباشي على آكيهابارا

69
00:03:53,210 --> 00:03:54,960
وأنا أختُ سوباشي، سوبامي

70
00:03:57,020 --> 00:03:59,420
تعالوا يا أولاد، حيُّوا سوباشي

71
00:04:01,530 --> 00:04:03,850
مهلاً يا أوني-تشان، أنتَ تنفعلُ كثيراً

72
00:04:03,850 --> 00:04:05,390
أنا، سوبامي، سأسيطر

73
00:04:05,390 --> 00:04:06,850
!سوباشي من سيسيطر

74
00:04:06,850 --> 00:04:08,320
!بل سوبامي

75
00:04:08,720 --> 00:04:09,600
!بل سوباشي

76
00:04:10,520 --> 00:04:14,500
سوباشي

77
00:04:10,680 --> 00:04:11,620
!بل سوبامي

78
00:04:11,620 --> 00:04:12,820
!بل سوباشي

79
00:04:14,860 --> 00:04:16,650
هذان سوباشي وسوبامي، صحيح؟

80
00:04:16,650 --> 00:04:18,650
إنهما مشهوران جداً بين الأطفال

81
00:04:18,930 --> 00:04:23,400
أطفال... لقد جعلتُ الأطفالَ يصرخون لي أيضاً

82
00:04:23,830 --> 00:04:24,950
حدثَ ذلك بالفعل، صحيح؟

83
00:04:25,200 --> 00:04:28,330
أريدُ أن أجعلَ الأطفالَ يصرخون لي مجدّداً

84
00:04:28,660 --> 00:04:31,500
أرجوكِ لا ترتدي قناع الشيطان ناماهاغا ثانيةً

85
00:04:32,880 --> 00:04:34,250
مونوكروم-سان

86
00:04:34,250 --> 00:04:35,500
أمزح فقط

87
00:04:35,940 --> 00:04:39,290
ماذا يجدرُ بي أن أفعل لتعزيز
ظهوري لدى الأطفال؟

88
00:04:39,290 --> 00:04:41,790
...نعم، دعيني أرى

89
00:04:41,790 --> 00:04:43,050
سأجرِّب

90
00:04:43,450 --> 00:04:45,930
سأصبحُ مونو-شي، مونو-شي

91
00:04:46,460 --> 00:04:49,110
التهيُّجُ هكذا لا يليقُ بي

92
00:04:49,110 --> 00:04:51,060
نعم، من الأفضل ألّا تفعلي ذلك

93
00:04:53,110 --> 00:04:55,600
...كيف نعزِّزُ ظهوركِ لدى الأطفال

94
00:04:56,850 --> 00:04:59,060
...واحد، اثنان، ثلاثة، أربعة

95
00:04:59,340 --> 00:05:00,250
!يوريكا

96
00:05:01,080 --> 00:05:02,360
سأؤدِّي التمارين الرياضيّة

97
00:05:02,360 --> 00:05:03,150
تمارين رياضيّة؟

98
00:05:03,150 --> 00:05:06,910
سأعزِّزُ ظهوري وأكسب الأطفال

99
00:05:06,910 --> 00:05:08,910
التمارين الرياضيّة أساسيّة لتحقيقِ ذلك

100
00:05:08,910 --> 00:05:11,330
التمارينُ الرياضيّة يذيعُ صيتها كثيراً

101
00:05:11,330 --> 00:05:12,290
!قد تنجح

102
00:05:12,290 --> 00:05:16,170
في الواقع، ذكرتُ تمارينَ الجمباز سابقاً

103
00:05:16,420 --> 00:05:18,040
تمارين جمباز مونوكروم

104
00:05:18,370 --> 00:05:19,790
هذه بصيرتي

105
00:05:20,230 --> 00:05:22,430
سأتألّقُ أكثر بتمارين الجمباز والتمارين الرياضيّة

106
00:05:22,430 --> 00:05:25,300
سأدعُ العالمَ يرى تمارين جمباز مونوكروم

107
00:05:28,270 --> 00:05:33,000
تمارين رياضيّة

108
00:05:33,490 --> 00:05:37,350
هكذا حصلَتْ مونوكروم على الميداليّة الذهبيّة
في تمارين الرياضة الإيقاعيّة

109
00:05:38,480 --> 00:05:40,010
،الوثب

110
00:05:42,560 --> 00:05:43,650
،دعامة التوازن

111
00:05:45,600 --> 00:05:46,490
،الحركات الأرضيّة

112
00:05:47,340 --> 00:05:48,860
ثمّ القضبان غير المتناسِقة

113
00:05:48,860 --> 00:05:52,580
حصلَتْ على ميداليات ذهبيّة في نشاط
رياضي تِلو الآخر

114
00:05:52,820 --> 00:05:55,580
شلّال القمر هو الجسرُ المؤدّي إلى المجد

115
00:05:59,640 --> 00:06:00,750
!أهلاً

116
00:06:03,440 --> 00:06:06,950
بالمناسبة، أدركَ مانيو وجودَ خطأ ما

117
00:06:06,950 --> 00:06:09,170
فأنتجَ فيديو تمارسُ فيه مونوكروم
تمارين الجمباز

118
00:06:09,170 --> 00:06:14,810
ونالَ إعجاب الأطفال كثيراً
ولكن تِلك قصّة أخرى تماماً

119
00:06:16,790 --> 00:06:18,440
واحد، اثنان، ثلاثة

120
00:06:18,440 --> 00:06:19,940
!نصر