1
00:00:16,000 --> 00:00:19,950
نادي كوتو الموسيقي

2
00:00:25,580 --> 00:00:28,910
.وهذا كل شيء لاجتماع اليوم

3
00:00:28,910 --> 00:00:29,950
!حسنًا

4
00:00:30,750 --> 00:00:33,410
!أنا مرهقة -
.أنا أيضًا -

5
00:00:33,410 --> 00:00:35,080
ماذا ستفعلين الآن؟

6
00:00:35,080 --> 00:00:36,620
ما رأيك في المرور على المقهى؟

7
00:00:36,870 --> 00:00:39,620
.شكرًا على مجهودك اليوم يا رئيسة أكاتسكي

8
00:00:39,620 --> 00:00:40,660
.شكرًا لك

9
00:00:41,000 --> 00:00:42,750
.طاب مساؤكن

10
00:00:43,040 --> 00:00:45,370
.إلى اللقاء

11
00:00:53,750 --> 00:00:55,450
.لنأخذ بعض الفطائر المحلاة

12
00:00:55,450 --> 00:00:56,620
!فكرة جيدة، هيّا بنا

13
00:01:04,080 --> 00:01:07,750
ما الذي تفعله هذه الفتاة هنا؟

14
00:02:44,120 --> 00:02:45,450
نيمو؟

15
00:02:45,450 --> 00:02:49,250
أيعقل أنها هي نفسها هيراغي نيمو، واحدة من الماجيوس؟

16
00:02:49,250 --> 00:02:50,370
تعرفين نيمو؟

17
00:02:50,910 --> 00:02:54,330
.آسفة! سمعت الاسم فقط

18
00:02:54,330 --> 00:02:55,950
أين سمعته؟

19
00:02:59,040 --> 00:03:04,750
من وقت لآخر، تأتي أجنحة الماجيوس
.إلى مكتبة (أي) لاسترجاع ساحرة

20
00:03:08,450 --> 00:03:12,830
.أذكر أنهن قلن شيئًا عن تعاون هيراغي نيمو

21
00:03:14,330 --> 00:03:17,000
هل يجبرن نيمو على مساعدة الماجيوس؟

22
00:03:17,620 --> 00:03:20,200
ربّما هي أسيرة؟

23
00:03:20,200 --> 00:03:22,540
.إن صح هذا، فلا يمكننا تجاهل الأمر

24
00:03:23,870 --> 00:03:27,910
.قد تكون (وي) أسيرتهن أيضًا

25
00:03:33,870 --> 00:03:37,910
.لنقبض على بعض الريشات السوداء ونجبرهن على الإفصاح عن هذا

26
00:03:37,910 --> 00:03:39,790
.ربّما يعرفن شيئًا عن نيمو

27
00:03:40,080 --> 00:03:44,410
لكن كيف نجدهن؟
هل نتحقق من إشاعة أخرى؟

28
00:03:44,660 --> 00:03:47,620
ألا توجد طريقة مباشرة للعثور عليهن؟

29
00:03:47,620 --> 00:03:50,290
.إن كنّا نعرف طريقة، ما كنّا لنتكبد عناء هذا

30
00:03:54,120 --> 00:03:56,120
.لنفكر فيما سنفعله سويًا

31
00:03:56,120 --> 00:03:57,160
!نعم

32
00:03:57,160 --> 00:04:00,200
.في هذه الحالة، سأبحث في أمر إشاعة أخرى أيضًا

33
00:04:03,370 --> 00:04:06,160
.المعذرة

34
00:04:08,080 --> 00:04:09,580
!تسوكويو انتظري

35
00:04:09,580 --> 00:04:11,830
ماذا تريدين؟

36
00:04:11,830 --> 00:04:13,830
.أنا أكاتسكي تسوكويو

37
00:04:13,830 --> 00:04:16,290
!لا علاقة تربطني بأماني تسوكويو

38
00:04:16,750 --> 00:04:20,410
...إذًا أنتِ هي فعلاً أمانو تسوكويو من أجنحة الـ

39
00:04:20,870 --> 00:04:25,410
!كوني عضوة في أجنحة الماجيوس أمر فائق السرية

40
00:04:26,750 --> 00:04:29,540
أيمكننا التحدث في مكان آخر إذًا؟

41
00:04:29,830 --> 00:04:34,120
استجواب؟ أو تعذيب؟

42
00:04:34,120 --> 00:04:36,370
.لن أفعل شيئًا كهذا أبدًا

43
00:04:36,370 --> 00:04:39,290
.أريد التحدث فقط

44
00:04:56,290 --> 00:04:58,910
.أنتِ وحدك اليوم

45
00:04:59,500 --> 00:05:02,540
.نعم. أردت التحدث إليك بشدة

46
00:05:08,120 --> 00:05:11,330
تبحثين عن أختك الصغرى؟

47
00:05:12,700 --> 00:05:16,330
.الدليل الوحيد الذي أمتلكه هما نيمو وتوكا

48
00:05:18,290 --> 00:05:20,450
لماذا تخبرينني بكل هذا؟

49
00:05:21,330 --> 00:05:23,450
.لأنه عليّ رؤية نيمو

50
00:05:25,910 --> 00:05:27,330
...تسوكاسا

51
00:05:28,290 --> 00:05:32,200
توأمكِ وُلِدت أولاً أو أنتِ أولاً؟

52
00:05:33,200 --> 00:05:34,950
.نعتبرها أختي الصغرى

53
00:05:34,950 --> 00:05:36,910
.يبدو أنكما مقربتين

54
00:05:36,910 --> 00:05:42,750
تسوكويو

55
00:05:36,910 --> 00:05:42,750
تسوكاسا

56
00:05:37,580 --> 00:05:41,250
...بالطبع، إن تسوكاسا

57
00:05:41,250 --> 00:05:42,750
...نحن

58
00:05:43,500 --> 00:05:45,000
...الوحيدتان...

59
00:05:47,410 --> 00:05:51,750
إن لم تسمحي لي بمقابلة نيمو، سأخبر
.ياتشيو والأخريات بهويتك الأخرى

60
00:05:53,080 --> 00:05:55,120
تهددينني؟

61
00:05:55,120 --> 00:05:57,660
.إن كان هذا ما فهمته من كلامي، فلا بأس

62
00:05:58,290 --> 00:06:01,120
إلى ياتشيو

63
00:05:59,120 --> 00:06:03,540
...وإن لم أعد للبيت سالمة، عندها

64
00:06:08,660 --> 00:06:11,950
!أرجوك! اسمحي ليّ برؤية نيمو

65
00:06:12,660 --> 00:06:15,540
.سأفعل أي شيء من أجل (وي)

66
00:06:18,660 --> 00:06:26,040
.حسنًا. أتفهم مشاعرك

67
00:06:26,540 --> 00:06:31,160
.لكن سأتحدث مع ميفيو بشأن هذا أولاً

68
00:06:49,910 --> 00:06:51,200
وقايات؟

69
00:06:51,580 --> 00:06:53,950
فكرت في أنها ستكون فكرة رائعة

70
00:06:53,950 --> 00:06:57,580
.أن أجلب وقايات مماثلة للأكواب لشكر ياتشيو على شراء الأكواب

71
00:06:57,910 --> 00:06:59,330
!فكرة عظيمة

72
00:06:59,620 --> 00:07:01,580
!سيظهر هذا تعاوننا كفريق

73
00:07:01,950 --> 00:07:04,200
.ليس لديّ إلّا المال الذي ادّخرته في عيد الميلاد

74
00:07:04,660 --> 00:07:09,160
!لا مشكلة! أنا وفليشيا نمتلك مالاً من العمل في بانبانزاي

75
00:07:10,000 --> 00:07:14,500
!لنفاجئ معلمتي ياتشيو بطقم فاخر مماثل

76
00:07:14,500 --> 00:07:17,580
!لا بأس بالفكرة، لكن ما الذي قلته بشأن مالي الذي كدحت لأجله؟

77
00:07:28,870 --> 00:07:29,830
من ياتشيو:   سأتأخر اليوم بسبب جلسة التصوير

78
00:07:40,580 --> 00:07:41,910
أي واحدة نجلب؟

79
00:07:41,910 --> 00:07:43,370
.توجد الكثير

80
00:07:43,370 --> 00:07:45,000
...عذرًا

81
00:07:45,750 --> 00:07:47,620
.أظن هذه مناسبة

82
00:07:48,750 --> 00:07:49,750
!إنها ظريفة

83
00:07:49,750 --> 00:07:50,750
!جميلة

84
00:07:51,000 --> 00:07:53,160
إذًا لم لا نختر هذه؟

85
00:07:53,160 --> 00:07:55,250
هل ستعجبها يا ترى؟

86
00:07:55,250 --> 00:07:56,700
....بالطبع ستعجبها

87
00:07:57,500 --> 00:07:58,910
ما هذه؟

88
00:08:03,620 --> 00:08:05,290
ورود؟

89
00:08:06,790 --> 00:08:07,830
...أهذه

90
00:08:07,830 --> 00:08:08,830
!غير معقول

91
00:08:11,040 --> 00:08:12,120
!هؤلاء هن

92
00:08:13,000 --> 00:08:14,000
!لا

93
00:08:33,200 --> 00:08:34,410
أين الواقيات؟

94
00:08:34,950 --> 00:08:36,120
!هناك

95
00:08:41,410 --> 00:08:42,500
...ذلك

96
00:08:49,200 --> 00:08:52,450
ماذا تظن نفسك فاعلاً؟

97
00:08:53,790 --> 00:08:55,080
!سانا

98
00:09:00,410 --> 00:09:01,410
.حمدًا لله

99
00:09:05,250 --> 00:09:06,410
ماذا؟

100
00:09:17,120 --> 00:09:20,330
!آسفة، لكن اليوم علينا تنظيف هذه الفوضى بسرعة

101
00:09:20,330 --> 00:09:21,330
!حسنًا

102
00:09:30,080 --> 00:09:31,870
.كان هذا سهلاً

103
00:09:31,870 --> 00:09:36,040
.لكنها تحولت إلى رحلة تسوق عويصة

104
00:09:36,040 --> 00:09:38,200
.لكن ما أجمل التي اشتريناها

105
00:09:38,700 --> 00:09:40,370
.حتمًا

106
00:09:40,370 --> 00:09:42,200
.علينا الآن إعطاؤها إلى ياتشيو

107
00:09:43,330 --> 00:09:44,330
!نعم

108
00:09:50,000 --> 00:09:50,250
تسورونو: نحن مستعدات

109
00:09:50,250 --> 00:09:51,830
تسورونو: ثلاثة في الفناء

110
00:09:51,830 --> 00:09:54,290
عندما تعود ياتشيو، سأنبهك برسالة، صحيح؟

111
00:09:54,290 --> 00:09:56,080
تسورونو: افعلي ذلك على الوقت، مفهوم؟

112
00:09:56,080 --> 00:09:58,290
.يا لها من مسؤولية

113
00:10:00,120 --> 00:10:01,120
!ياتشيو

114
00:10:03,000 --> 00:10:04,950
...مرحبًا بـ

115
00:10:06,250 --> 00:10:07,580
ميفيو؟

116
00:10:21,700 --> 00:10:25,370
!هل ترغبين... بالشاي... سأجلب بعض الشاي

117
00:10:25,910 --> 00:10:29,330
.لا حاجة لتكليف نفسك

118
00:10:30,370 --> 00:10:32,040
...المعذرة

119
00:10:35,700 --> 00:10:38,950
.كنت أحضر إلى هنا دومًا طول سبع سنوات

120
00:10:38,950 --> 00:10:41,500
أنا حزينة لأنني أُعامل كضيفة

121
00:10:41,790 --> 00:10:44,410
.على الرغم من أنني أعرف المطبخ أكثر منك

122
00:10:47,370 --> 00:10:48,790
.حسنًا

123
00:10:49,040 --> 00:10:50,660
...هذه الخزانة

124
00:10:52,410 --> 00:10:55,080
.نهتنا ياتشيو عن لمسها

125
00:10:55,080 --> 00:10:57,910
.لا مشكلة

126
00:11:02,790 --> 00:11:04,450
.هذا لي

127
00:11:06,950 --> 00:11:07,790
...لكن

128
00:11:07,790 --> 00:11:10,160
أهذا لك يا إروها؟

129
00:11:10,790 --> 00:11:11,830
.نعم

130
00:11:13,540 --> 00:11:15,450
.كوب ظريف

131
00:11:15,450 --> 00:11:17,950
.عرفت أنه لكِ من شكله

132
00:11:18,410 --> 00:11:21,700
.ذهبنا كلّنا لشرائها
.أقصد كل من تسكن في فيلا ميكازوكي

133
00:11:22,620 --> 00:11:23,700
حقًا؟

134
00:11:28,500 --> 00:11:29,500
...عذرًا

135
00:11:29,790 --> 00:11:33,200
ما الذي تريدينه من ياتشيو؟

136
00:11:35,000 --> 00:11:39,330
وهل أحتاج سببًا لزيارة صديقتي؟

137
00:11:40,000 --> 00:11:42,580
لكن لم تأت إلى هنا منذ فترة، صحيح؟

138
00:11:43,000 --> 00:11:45,370
.كانت ياتشيو قلقة عليك

139
00:11:45,750 --> 00:11:49,410
.هكذا إذًا. نعم، لم أتمكن من القدوم

140
00:11:50,040 --> 00:11:53,950
.أنا واثقة من أن ياتشان لن تسامح أجنحة الماجيوس

141
00:11:55,160 --> 00:11:59,660
.لكن جئت إلى هنا اليوم للتحدث معكِ يا إروها

142
00:11:59,660 --> 00:12:01,200
معي؟

143
00:12:02,950 --> 00:12:05,160
.سأدخل صلب الموضوع

144
00:12:05,160 --> 00:12:10,750
إروها، إن أردتِ أن تعرفي أكثر عن نيمو
هل ستأخذين بعين الاعتبار الانضمام إلى أجنحة الماجيوس؟

145
00:12:13,080 --> 00:12:15,370
لِمَ تطلبين منّي الانضمام؟

146
00:12:15,790 --> 00:12:18,790
إن انضممتِ إلى أجنحة الماجيوس

147
00:12:18,790 --> 00:12:22,040
.يمكنك البحث عن أختك الصغرى دون أي خلاف معنا

148
00:12:23,450 --> 00:12:27,290
هل تعرفين شيئًا عن (وي)؟
هل هي مع أجنحة الماجيوس؟

149
00:12:27,620 --> 00:12:31,000
.لا أعرف أي شيء عن تماكي وي

150
00:12:31,370 --> 00:12:37,750
.لكن قد تكون مع أجنحة الماجيوس في مقر ما دون علمي

151
00:12:37,750 --> 00:12:39,580
ماذا عن نيمو؟

152
00:12:39,580 --> 00:12:43,620
.قالت سانا بأنها سمعت اسم نيمو في الحاجز

153
00:12:47,790 --> 00:12:49,540
.تأخرت

154
00:12:49,540 --> 00:12:51,410
لم ترسل التنبيه بعد؟

155
00:12:51,870 --> 00:12:54,620
.لا يمكنني تجاهل الإشاعات والساحرات

156
00:12:54,620 --> 00:12:57,790
.عارضت (أي) الماجيوس أيضًا

157
00:13:03,080 --> 00:13:09,080
.أدعوكن جميعًا إلى محاضرة عن معنى تحرير الفتيات الساحرات

158
00:13:09,700 --> 00:13:12,500
.ستُعقد المحاضرة هذا السبت الثالثة بعد الظهر

159
00:13:12,500 --> 00:13:14,080
.في متحف الذّاكرة

160
00:13:14,660 --> 00:13:19,790
أيمكنكن تأجيل حكمكن علينا حتى ذلك الحين؟

161
00:13:22,620 --> 00:13:25,160
لدينا ضيفة؟

162
00:13:25,620 --> 00:13:27,910
.مرحبًا ياتشان

163
00:13:29,080 --> 00:13:30,160
!ميفيو

164
00:13:38,950 --> 00:13:43,120
.آسفة. لم أقصد مفاجأتك

165
00:13:43,120 --> 00:13:44,660
.كنت على وشك المغادرة

166
00:13:45,200 --> 00:13:47,700
.حظيت بمحادثة جميلة مع إروها

167
00:13:48,040 --> 00:13:50,080
أي أفكار زرعتها في رأس تماكي؟

168
00:13:51,080 --> 00:13:54,700
لِمَ لا تسأليها بنفسك؟

169
00:13:54,700 --> 00:13:56,830
أنتما مقرّبتان، صحيح؟

170
00:13:57,450 --> 00:13:59,830
.تفاجأت عندما دخلت المطبخ

171
00:13:59,830 --> 00:14:03,620
.رأيت أكواب إروها والبقية

172
00:14:04,370 --> 00:14:06,830
تكتسبين صديقات مجددًا؟

173
00:14:07,410 --> 00:14:10,200
.لسنا صديقات. مجرد زميلات سكن

174
00:14:10,660 --> 00:14:12,160
.غير صحيح

175
00:14:15,410 --> 00:14:19,410
.أنتِ على عهدك السابق مجددًا
...بعد مقابلة إروها

176
00:14:19,410 --> 00:14:20,370
...غير صحيح

177
00:14:20,370 --> 00:14:25,290
.أنتِ طيبة ياتشان
.لهذا لم تتمكني من هجرهن

178
00:14:25,290 --> 00:14:27,700
.لا يسعك إلا مساعدة المحتاج

179
00:14:28,450 --> 00:14:31,750
.علمتِ ومع هذا أعدتِ الكرّة

180
00:14:31,750 --> 00:14:32,750
.اخرجي

181
00:14:34,370 --> 00:14:36,450
...سيتكرر الأمر مجددًا. أنتِ سـ

182
00:14:36,790 --> 00:14:37,830
!اخرجي

183
00:14:47,580 --> 00:14:50,790
.هل أنتِ بخير ياتشيو؟ تبدين شاحبة

184
00:14:50,790 --> 00:14:54,450
.آسفة. أشعر بتوعك

185
00:14:54,700 --> 00:14:56,620
.سأخلد للفراش

186
00:15:01,580 --> 00:15:03,500
ما الذي حدث؟

187
00:15:19,370 --> 00:15:25,290
.جميل. كسبتِ كل هؤلاء الصديقات من أجلي

188
00:15:26,250 --> 00:15:27,410
.أنا مسرورة

189
00:15:27,700 --> 00:15:28,750
!لا

190
00:15:31,660 --> 00:15:32,830
...غير صحيح

191
00:15:44,950 --> 00:15:47,700
مهمة المفاجأة الخارقة
سنزين غرفة المعيشة في اليوم الذي تعود
فيه ياتشيو في وقت متأخر وعندما تعود نخرج الحلوى
وأثناء هول المفاجأة، نعطيها الواقيات ونشاهد ابتسامتها

192
00:15:49,500 --> 00:15:50,540
محاضرة؟

193
00:15:50,540 --> 00:15:52,950
...نعم. ميفيو قامت بدعوتنا البار

194
00:15:52,950 --> 00:15:54,330
.إن أردتن الذهاب، اذهبن

195
00:15:56,250 --> 00:15:58,540
.حسنًا، سأذهب للمدرسة

196
00:15:59,540 --> 00:16:00,910
ألا يزال الوقت مبكرًا؟

197
00:16:01,830 --> 00:16:05,660
.سأذهب مبكرًا من اليوم
.لا يمكننا الذهاب في نفس الوقت مجددًا

198
00:16:06,160 --> 00:16:10,160
.ولدي جلسة تصوير الليلة، لذا تناولوا العشاء دوني

199
00:16:10,580 --> 00:16:11,620
.إلى اللقاء

200
00:16:13,200 --> 00:16:14,410
ما كان هذا؟

201
00:16:18,830 --> 00:16:22,790
هل ستذهبين حقًا إلى تلك المحاضرة؟

202
00:16:23,500 --> 00:16:27,660
.نعم. فكرت في هذا طول الليلة البارحة وقررت الذهاب

203
00:16:27,660 --> 00:16:30,040
.هدفنا ليس قتالهن

204
00:16:30,370 --> 00:16:32,370
.أجزم بأنه فخ

205
00:16:32,370 --> 00:16:35,410
.إن أريتهن قوّتي سوف يهربن

206
00:16:35,410 --> 00:16:37,750
!هذا صحيح! وعلينا الذهاب كلّنا حتى نكون بأمان

207
00:16:37,750 --> 00:16:39,700
احكمي بنفسك

208
00:16:42,290 --> 00:16:46,580
إذًا أين متحف الذاكرة؟

209
00:16:51,750 --> 00:16:54,830
محاضرة عن تحرير الفتيات الساحرات؟

210
00:16:55,250 --> 00:16:57,580
.يا له من شيء غريب

211
00:16:58,160 --> 00:17:03,080
طلبت منا الذهاب إلى متحف الذاكرة
.لكننا نجهل مكانه

212
00:17:03,500 --> 00:17:04,830
متحف الذاكرة؟

213
00:17:05,120 --> 00:17:06,660
تعرفينه؟

214
00:17:06,660 --> 00:17:08,370
.توجد إشاعة عنه في حي ساكاي

215
00:17:08,370 --> 00:17:09,450
"إشاعة متحف الذاكرة"

216
00:17:10,120 --> 00:17:14,660
.سمعت بأن ذكريات قديمة معروضة في متحف مهجور

217
00:17:14,660 --> 00:17:16,620
.هذا ما سمعته على ما أعتقد

218
00:17:20,160 --> 00:17:22,830
سمعت؟ من أخبرك؟

219
00:17:22,830 --> 00:17:25,500
.إشاعة متحف الذاكرة

220
00:17:27,370 --> 00:17:29,080
لديك ذكرى ترغب بتغييرها؟

221
00:17:29,080 --> 00:17:30,700
ذكرى تريد نسيانها؟

222
00:17:30,700 --> 00:17:33,750
أو ذكرى تريد تذكرها؟

223
00:17:34,080 --> 00:17:38,540
!إن كانت تشغلك أي ذكرى، تعال إلى متحف الذاكرة

224
00:17:38,950 --> 00:17:43,540
.اقرع الجرس وستعرض كل الذكريات

225
00:17:43,830 --> 00:17:46,370
.إنه متحف يعزز الأبحاث

226
00:17:46,370 --> 00:17:50,660
!إن تصفحت الذكريات، سترى العديد من الحقائق المخفية

227
00:17:51,370 --> 00:17:56,790
.إن نظرت إلى ذكرى مخزنة هناك، ستتأثر بها

228
00:17:56,790 --> 00:18:00,200
.هذا ما تقوله الإشاعة التي تتردد بين الناس في حي ساكاي

229
00:18:00,450 --> 00:18:02,200
ما هذا يا ترى؟

230
00:18:04,250 --> 00:18:06,250
...حي ساكاي

231
00:18:06,500 --> 00:18:09,200
...بناية مهجورة في حي ساكاي

232
00:18:09,660 --> 00:18:10,950
.لا بد من أنها هذه

233
00:18:12,330 --> 00:18:13,580
!شكرًا لكما

234
00:18:22,620 --> 00:18:25,580
لن تخبري رينا وكايدي؟

235
00:18:25,580 --> 00:18:27,200
.بالطبع لا

236
00:18:27,790 --> 00:18:30,700
.كايدي لا يسعها التعامل مع هذا

237
00:18:31,160 --> 00:18:36,450
.أظن أنه عليك إخبار رينا على الأقل يا موموكو

238
00:18:36,450 --> 00:18:39,370
هذا أفضل من أن تسمع بالأمر لاحقًا، صحيح؟

239
00:18:40,790 --> 00:18:42,370
.فهمت

240
00:18:51,000 --> 00:18:52,830
.تمطر بغزارة

241
00:18:52,830 --> 00:18:54,580
معك المفتاح يا سانا؟

242
00:18:54,580 --> 00:18:55,580
.معي

243
00:18:58,870 --> 00:19:00,120
.حسنًا سنذهب

244
00:19:04,080 --> 00:19:06,370
!إروها، سنسبقك

245
00:19:06,370 --> 00:19:07,870
!انتظرن، أنا قادمة

246
00:19:30,330 --> 00:19:32,250
.المطر غزير جدًا

247
00:19:37,000 --> 00:19:40,620
.هذا الكيوبي الذي قابلته عندما أبرمت عقدي

248
00:19:40,620 --> 00:19:42,410
.لكنه أصغر مما أذكر

249
00:19:43,040 --> 00:19:46,450
.أرى كيوبي الصغير دومًا عندما أتسكع مع إروها

250
00:19:46,450 --> 00:19:49,200
.نجده أينما توجد إشاعة

251
00:19:49,200 --> 00:19:53,790
.تذكرت (وي) بعد أن لمست هذا الصغير أول مرة

252
00:19:57,660 --> 00:19:59,660
!حسنًا، هيّا بنا

253
00:20:03,580 --> 00:20:06,200
.هذا متحف الذاكرة

254
00:20:06,660 --> 00:20:08,370
...إنه فارغ

255
00:20:09,620 --> 00:20:10,700
ما هذا؟

256
00:20:23,580 --> 00:20:25,580
ماذا يكون على أي حال؟

257
00:20:26,080 --> 00:20:26,970
يكون؟

258
00:20:27,430 --> 00:20:28,330
.كيوبي الصغير

259
00:20:28,620 --> 00:20:32,120
.إنه كيوتشان
.كنت أدعوه كيوبي الصغير من قبل

260
00:20:32,120 --> 00:20:35,370
.لا وقع لاسم كيوبي الصغير
.لنختر له اسمًا

261
00:20:35,370 --> 00:20:36,660
.إذًا هاتشيبي

262
00:20:36,660 --> 00:20:37,500
!تشيبيتي

263
00:20:37,500 --> 00:20:38,660
.تشيتشان

264
00:20:38,910 --> 00:20:40,290
كيوتي؟

265
00:20:54,700 --> 00:20:56,950
!أنا مبللة تمامًا

266
00:20:56,950 --> 00:20:58,660
...لو كانت المسألة تافهة

267
00:20:59,580 --> 00:21:00,790
موموكو؟

268
00:21:03,540 --> 00:21:09,410
.أعتقد أنه من الأفضل أن أخبرك بما حدث مع ياتشيو والبقية منذ عام

269
00:21:09,750 --> 00:21:12,750
.لِمَ الآن؟ لا علاقة لهذا بيّ

270
00:21:12,750 --> 00:21:13,790
.بل له علاقة

271
00:21:16,000 --> 00:21:20,410
.هذا متعلق بكل فتاة ساحرة

272
00:21:38,120 --> 00:21:41,700
.الموعد كان الساعة الثالثة في متحف الذاكرة

273
00:21:42,080 --> 00:21:44,450
.أنا متفاجئة من قدومكن

274
00:21:55,910 --> 00:21:57,580
.توكا

275
00:21:58,540 --> 00:22:01,580
أنتِ تعرفينني فعلاً إذًا؟

276
00:22:03,660 --> 00:22:05,950
.سررت بمقابلتك يا تماكي إروها

277
00:22:06,540 --> 00:22:08,120
.أنا ساتومي توكا

278
00:22:08,750 --> 00:22:10,660
.واحدة من الماجيوس الثلاثة

279
00:22:12,040 --> 00:22:17,000
عند الثالثة مساءً

280
00:22:12,040 --> 00:22:17,000
في متحف الذاكرة