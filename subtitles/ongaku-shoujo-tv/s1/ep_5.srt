1
00:00:05,860 --> 00:00:08,000
المكياج الذي يحرّر روحكِ

2
00:00:09,150 --> 00:00:13,320
!دعي الفتاة التي بداخلكِ تغنّي

3
00:00:14,530 --> 00:00:17,090
!برينتيمب" في الأسواق الآن"

4
00:00:18,610 --> 00:00:20,790
!إنها ظريفة للغاية

5
00:00:20,790 --> 00:00:22,960
!سأشتريها

6
00:00:23,440 --> 00:00:26,300
أرى هؤلاء الفتيات كثيراً مؤخراً

7
00:00:26,300 --> 00:00:28,690
بالفعل! إنّهن ظريفات

8
00:00:28,690 --> 00:00:30,440
ما اسم الفرقة؟

9
00:00:30,440 --> 00:00:33,590
لا تعرفين؟ إنّهن فتيات الموسيقى

10
00:02:09,270 --> 00:02:11,610
...صباح الخير

11
00:02:20,860 --> 00:02:23,740
استيقظتن جميعاً؟

12
00:02:23,830 --> 00:02:26,660
لدينا جلسة تصوير اليوم

13
00:02:26,750 --> 00:02:32,330
ويجري التصوير هنا في دولتشي، لذا ارتأينا
أن نشرع في التنظيف

14
00:02:32,460 --> 00:02:35,590
نظّفتُ غرفةَ المعيشة اللّيلة الماضية

15
00:02:35,670 --> 00:02:38,260
!أحسنتِ عملاً يا هاناكو

16
00:02:39,760 --> 00:02:44,390
مرحى! هذا يعني أنّنا يمكننا تناول
!فطور فاخر

17
00:02:46,220 --> 00:02:48,270
أحسنتِ يا هاناكو

18
00:02:48,560 --> 00:02:50,690
فار-تشان، ابقي مكانكِ هنا واسترخي

19
00:02:52,100 --> 00:02:54,480
!حسناً، ابدأن بالأكل

20
00:02:54,770 --> 00:02:56,320
!شكراً على الطعام

21
00:02:57,110 --> 00:02:59,610
هل هيو بخير؟

22
00:02:59,740 --> 00:03:01,740
ما سيحدث سيحدث

23
00:03:01,740 --> 00:03:05,870
...كانت مقابلة المجلّة البارحة مع إيري

24
00:03:05,950 --> 00:03:08,660
أعتقد أنها مُنهَكة من الكلام

25
00:03:09,160 --> 00:03:12,080
لكن... نحقّق إنجازاً كلّ يوم

26
00:03:12,250 --> 00:03:13,500
!بالتأكيد

27
00:03:13,750 --> 00:03:17,130
هذه دلالةٌ على أنّ فتيات الموسيقى على
حافّة الاستكشاف

28
00:03:17,250 --> 00:03:18,460
!بالتأكيد

29
00:03:19,010 --> 00:03:20,300
سأعدّ بعض الشاي

30
00:03:20,300 --> 00:03:23,890
أحبّذ الشاي الأخضر -
!حسناً -

31
00:03:24,930 --> 00:03:27,390
...لنرَ... بالنسبة للشاي الأخضر

32
00:03:27,390 --> 00:03:31,560
تحبّه رورو ساخناً وثقيلاً. وشوبّي
تحبّ المُخمّر البارد

33
00:03:32,940 --> 00:03:36,320
إذاً سأحضّر طلب ميكو وساسامي أولاً

34
00:03:36,320 --> 00:03:39,470
هاناكو، هل لي بمزيد من الدجاج المقليّ؟

35
00:03:39,470 --> 00:03:40,820
يمكنكِ ذلك

36
00:03:41,740 --> 00:03:43,740
!هذا كتاب وصفة دولتشي

37
00:03:43,740 --> 00:03:46,850
!مجموعة الوصفات هذه مذهلة

38
00:03:46,850 --> 00:03:50,660
،كلّ تفضيلات الفتيات مُدرَجة بالتفصيل

39
00:03:50,660 --> 00:03:52,670
!لذا إنه مفيد جداً

40
00:03:53,420 --> 00:03:58,030
نعم، كلّنا نستخدمه عندما يحين
دورنا للطبخ

41
00:03:58,030 --> 00:03:59,800
والأمر لا يتقصر على الطعم فحسب

42
00:03:59,800 --> 00:04:01,550
يحتوي على وصفاتٍ صحّية

43
00:04:01,550 --> 00:04:06,080
مفيدة لبشرتكِ وحنجرتكِ

44
00:04:06,080 --> 00:04:08,930
جُمِعَتْ هذه الوصفات بحبّ

45
00:04:11,890 --> 00:04:13,980
مـ-مايونيز؟

46
00:04:13,980 --> 00:04:17,300
نعم... أردتُ مزيداً من النكهات

47
00:04:17,300 --> 00:04:18,730
!هكذا إذاً

48
00:04:19,110 --> 00:04:20,230
!هاناكو

49
00:04:21,030 --> 00:04:22,110
نعم؟

50
00:04:22,110 --> 00:04:24,570
قالت هيو أنّها تريد بعضاً من
عصير الطماطم

51
00:04:24,570 --> 00:04:27,270
ماذا؟ ينبغي أن نتناول بعضاً

52
00:04:27,270 --> 00:04:29,200
أضيفي بعضاً من الملح رجاء

53
00:04:31,910 --> 00:04:33,040
شكراً لك

54
00:04:33,040 --> 00:04:36,300
غريب... تحبّين عصير الطماطم يا هيو؟

55
00:04:36,300 --> 00:04:39,210
هيو... ربّما تحوّلتِ إلى مصّاصة دماء؟

56
00:04:40,630 --> 00:04:45,930
يا للهول! حريّ بنا أن نبدأ بالتّحضير
قبل أن يصل طاقم التصوير

57
00:04:54,980 --> 00:04:58,690
فكرة تصوير اليوم هي: يوم
في حياة فتيات الموسيقى

58
00:04:59,900 --> 00:05:05,200
أوري وكيري وكوتوكو، أنتن عضوات هيس
لا تعِيشنّ هنا؟

59
00:05:05,200 --> 00:05:06,720
هذا صحيح

60
00:05:06,720 --> 00:05:12,040
هكذا إذاً... حسناً، قد نجعل الأمر يبدو
وكأنّكن تعيشنّ هنا

61
00:05:12,620 --> 00:05:16,750
فتيات يشاركن نفس الحلم ويضحكن
ويبكين معاً

62
00:05:16,750 --> 00:05:19,210
تحت سقف واحد

63
00:05:19,210 --> 00:05:21,510
هذا يعطي صورة أجمل لنجمات الجماهير

64
00:05:21,510 --> 00:05:23,590
صورة أجمل لنجمات الجماهير؟

65
00:05:25,220 --> 00:05:29,050
هل هذا يعني أنّك ستكتب ذلك في المُقابلة؟

66
00:05:29,050 --> 00:05:32,890
أنّ فتيات الموسيقى يُقِمن جميعهن معاً
في نفس المنزل؟

67
00:05:33,640 --> 00:05:35,180
هذا ما أقصده بالضبط

68
00:05:35,730 --> 00:05:38,480
لكن هذه ليست الحقيقة

69
00:05:38,480 --> 00:05:41,650
إذاً علينا أن نكذب بشأن أنفسنا؟

70
00:05:43,030 --> 00:05:45,030
...أوري، اهدئي

71
00:05:45,900 --> 00:05:50,080
إن أمكن، نودّ أن نتحدّث كثيراً عن موسيقانا

72
00:05:50,080 --> 00:05:53,830
فتيات الموسيقى هي فرقة من عاشقات الموسيقى

73
00:05:54,580 --> 00:05:56,830
آه صحيح... بالتأكيد

74
00:05:57,210 --> 00:06:02,260
يمكنكن الحديث عن ذلك لاحقاً مع المُقابِل

75
00:06:02,260 --> 00:06:03,590
!كلّنا جاهزات هنا

76
00:06:04,050 --> 00:06:07,220
حسناً، لننهِ هذا الأمر بسرعة

77
00:06:08,510 --> 00:06:10,640
!شكراً لكم

78
00:06:10,640 --> 00:06:15,070
يا إلهي! هل من حاجة للجوئه لمثل
هذا الإعداد المزيّف؟

79
00:06:15,070 --> 00:06:19,400
من عادة السيّد إينابا تخطّي كلّ الحدود

80
00:06:21,520 --> 00:06:26,320
!حسناً... أمسكي بوسادة وابتسمي

81
00:06:28,150 --> 00:06:33,240
.كيري، انظري إليّ بعينَي جرو
هل نسيتِ أنكِ نجمة جماهير؟

82
00:06:33,240 --> 00:06:34,660
!آه صحيح

83
00:06:35,040 --> 00:06:38,540
جـ-جرو؟

84
00:06:39,420 --> 00:06:44,200
إيري، هيو... أبرزا شفتيكما على طريقة
البطّة. تذكّرا أنكما نجمتا جماهير

85
00:06:44,200 --> 00:06:46,170
...نبرز شفتنا -
بطّة؟... -

86
00:06:49,430 --> 00:06:51,430
لا أعتقد أنه قصد ذلك

87
00:06:51,890 --> 00:06:56,310
هل يمكنكن أن تبتسمن أكثر؟ ابتسمن فحسب

88
00:06:57,180 --> 00:07:00,520
!كنجمات جماهير. ابتسمن

89
00:07:01,020 --> 00:07:02,270
...حسناً

90
00:07:03,020 --> 00:07:06,360
كوتوكو، ماذا يعني بـ"كنجمات جماهير"؟

91
00:07:06,940 --> 00:07:08,070
لستُ أدري تماماً

92
00:07:08,610 --> 00:07:11,410
لكن... علينا أن نفعلها فحسب

93
00:07:19,580 --> 00:07:21,000
...الجميع يبدون

94
00:07:22,040 --> 00:07:23,190
ماذا؟ -
لا شيء -

95
00:07:23,190 --> 00:07:25,170
سيأخذن استراحة

96
00:07:25,170 --> 00:07:27,590
سأحضر لهُن ماءً

97
00:07:31,590 --> 00:07:32,930
!أحسنتُن عملاً

98
00:07:32,930 --> 00:07:36,160
ابتسامتي عالقة في وجهي

99
00:07:36,160 --> 00:07:38,230
كنّا نبتسم طوال الوقت

100
00:07:38,230 --> 00:07:39,680
...الابتسام كنجمة جماهير

101
00:07:40,060 --> 00:07:42,020
لا أدري إن فعلناها بشكل صحيح

102
00:07:42,020 --> 00:07:43,650
...أو فيما إذا بدوتُ كجرو

103
00:07:43,650 --> 00:07:44,900
...أو بطّة

104
00:07:46,820 --> 00:07:51,950
ظلّ يأمرنا لنكون "مثل نجمات جماهير" بدلاً
"من "مثل فتيات الموسيقى

105
00:07:52,280 --> 00:07:54,660
حسناً، هذه لمجلّة تحكي عن نجمات جماهير

106
00:07:55,160 --> 00:07:57,280
مع ذلك، لا أكترث لهذا

107
00:07:57,280 --> 00:08:00,910
إذ ليس مهمّاً من نكون ما دمنا
نتصرّف كنجمات جماهير

108
00:08:01,250 --> 00:08:03,620
...تلك الفكرة تجعلني

109
00:08:04,830 --> 00:08:06,500
حزينة قليلاً...

110
00:08:09,300 --> 00:08:10,340
...سيّد إينابا

111
00:08:10,670 --> 00:08:14,300
وصلَت المُنتجات لجلسة تصوير ما بعد الظهر

112
00:08:14,300 --> 00:08:18,260
حسناً. لنجهّز الأمور أثناء قضاء
الفتيات للاستراحة

113
00:08:18,560 --> 00:08:21,460
المعذرة... هل هذه لجلسة التصوير؟

114
00:08:21,460 --> 00:08:27,150
نعم، أردتُ تصوير الجميع حول مائدة الطعام

115
00:08:28,110 --> 00:08:33,400
دائماً ما نسمع عن نجمات جماهير وعصائرهن
الغنيّة بالفيتامين

116
00:08:33,700 --> 00:08:36,120
جميعكن تحببن هذه الأشياء، أليس كذلك؟

117
00:08:36,410 --> 00:08:39,120
لذا لنفعلها، بابتسامة نجمة جماهير، اتّفقنا؟

118
00:08:45,000 --> 00:08:46,820
...لا أمانع الخضروات، لكن

119
00:08:46,820 --> 00:08:49,750
خلايايّ تشتهي اللّحم

120
00:08:50,920 --> 00:08:54,760
كنّا نعمل بلا توقُّف منذ الصباح
لذا أنا أتضوّر جوعاً

121
00:08:55,130 --> 00:08:59,720
الغداء وفق الجدول يكون بعد المُقابلة
عقب جلسة التصوير

122
00:08:59,720 --> 00:09:02,060
لا أدري ما إن كنتُ سأصمد

123
00:09:02,060 --> 00:09:04,770
قد يكون جسدي وروحي مُنهكَين جداً

124
00:09:05,440 --> 00:09:09,650
المعذرة، هل يمكننا استخدام تلك المنتجات
ونحضّر شيئاً ما؟

125
00:09:11,320 --> 00:09:14,590
أعرف ما يحبّه الجميع

126
00:09:14,590 --> 00:09:19,330
ما تأكله الفتيات دوماً سيجعلها تكون
أقرب إلى فتيات الموسيقى

127
00:09:19,330 --> 00:09:21,410
لا، مستحيل

128
00:09:22,870 --> 00:09:26,920
تطبخين لهُن جميعاً؟ لن يسعفكِ الوقت

129
00:09:26,920 --> 00:09:28,940
حقاً؟ -
...نعم -

130
00:09:28,940 --> 00:09:31,630
،إن لم تستطيعي تحضير الطعام في الوقت
فسوف نتأخّر

131
00:09:32,050 --> 00:09:36,590
أعلم ذلك! أعدك أنني سأنتهي قبل
!نهاية الاستراحة. أرجوك

132
00:09:36,590 --> 00:09:40,430
فهمت... أنتِ تسعين لإبراز نفسكِ
على أنّكِ تجيدين الطبخ، صحيح؟

133
00:09:41,470 --> 00:09:44,520
لكن الأغراض هي عبارة عن كاري فقط، صحيح؟

134
00:09:44,520 --> 00:09:48,310
لمَ لا نتحدّث حول ذلك أثناء المقابلة؟

135
00:09:49,100 --> 00:09:52,300
شيفي ماهرة في الطبخ

136
00:09:52,300 --> 00:09:53,480
شيفي؟

137
00:09:54,190 --> 00:09:59,070
"تقصدُ أوري... شيفي كما في "شيف

138
00:10:00,660 --> 00:10:05,410
!أطباق شيفي... شهيّة وكأنها من عالم آخر

139
00:10:05,410 --> 00:10:07,540
حقاً؟ لم أكن أعلم

140
00:10:07,870 --> 00:10:11,570
ماذا؟ هاناكو، ألا تستخدمين كتابَ وصفات دولتشي؟

141
00:10:11,570 --> 00:10:14,460
بلى، طوال الوقت

142
00:10:14,840 --> 00:10:18,380
حسناً إذاً، أنتِ تعرفين طبخَ أوري سلفاً

143
00:10:19,390 --> 00:10:23,850
كتاب طبخ دولتشي هو مجموعة من وصفات أوري

144
00:10:25,100 --> 00:10:27,180
حقّاً؟

145
00:10:27,980 --> 00:10:31,520
حسناً، ضع الطبق الكبير في الوسط

146
00:10:31,520 --> 00:10:34,270
...لتنسيق الألوان هنا -
...حسناً إذاً -

147
00:10:34,730 --> 00:10:36,280
نعم، فليكُن زاهياً بالألوان

148
00:10:38,740 --> 00:10:41,910
!أرجوك دع أوري تحضّر الأطباق

149
00:10:41,910 --> 00:10:43,980
ماذا؟ من أنتِ؟

150
00:10:43,980 --> 00:10:46,660
اسمي هاناكو ياماداغي، أنا في طاقم فتيات الموسيقى

151
00:10:47,580 --> 00:10:52,670
أرجوك دع أوري تحضّر الأطباق في جلسة
!تصوير بعد الظهر

152
00:10:53,000 --> 00:10:55,800
...كما أخبرتُها سلفاً

153
00:10:55,800 --> 00:10:59,930
وصفات أوري هي سبب وجود
!فتيات الموسيقى الحاليّة

154
00:11:00,930 --> 00:11:03,830
سنحرص على انتهاء الطعام قبل بدء
!جلسة التصوير

155
00:11:03,830 --> 00:11:06,270
!لذا أرجوك

156
00:11:07,730 --> 00:11:08,980
...هاناكو

157
00:11:10,140 --> 00:11:12,650
...مهلاً مهلاً

158
00:11:12,650 --> 00:11:13,980
!سيّد إينابا

159
00:11:14,270 --> 00:11:16,420
أعتذر عن التدخّل

160
00:11:16,420 --> 00:11:22,140
لكن جلسة تصوير اليوم تحكي عن
الحياة الحقيقيّة لفتيات الموسيقى، صحيح؟

161
00:11:22,140 --> 00:11:23,740
...أجل

162
00:11:23,740 --> 00:11:27,580
...إذاً عرض الفتيات وهُنّ يأكلن من طبخ أوري

163
00:11:27,580 --> 00:11:31,500
لا يوجد ما هو أكثر حقيقيّة من ذلك

164
00:11:32,880 --> 00:11:35,590
دع أوري تفعل ذلك من فضلك

165
00:11:35,590 --> 00:11:40,220
ستجد ابتسامات مثاليّة لمخطّط مجلّة مثالي

166
00:11:44,260 --> 00:11:46,010
حقّاً؟

167
00:11:52,980 --> 00:11:56,440
كيف لي أن أرفض عندما تطلبون
طلباً كهذا؟

168
00:11:59,030 --> 00:12:00,530
!شكراً لك

169
00:12:18,480 --> 00:12:20,880
هاناكو، ما المكوّنات التي تبقّت لدينا؟

170
00:12:20,880 --> 00:12:23,930
...دجاج، بيض، توفو و

171
00:12:24,650 --> 00:12:27,260
لدينا كثير من اللّحم والبطاطا من البارحة

172
00:12:27,260 --> 00:12:30,640
حسناً، سيكون الطبق الرئيسي كاري

173
00:12:30,640 --> 00:12:34,030
...لكن -
لا يوجد وقت لندعه يغلي ببطء -

174
00:12:34,030 --> 00:12:36,960
مع ذلك أستطيع تحضيره. لا تقلقا

175
00:12:38,670 --> 00:12:43,340
سأريهم كيف أنّ نجمة الجماهير تحوّل
الكاري في آخر دقيقة إلى طبق نجوم

176
00:12:45,670 --> 00:12:48,220
!أ-أنتِ غاية في الرّوعة

177
00:12:50,300 --> 00:12:53,220
كفّي عن التملّق وارتدي مئزركِ

178
00:12:54,640 --> 00:12:56,830
كيري، قطّعي الفاكهة إلى شرائح رجاءً -
حاضرة -

179
00:12:57,600 --> 00:12:59,420
هاناكو، تولّي أمر طبق ميكو

180
00:12:59,420 --> 00:13:01,120
حسناً. طبق اللّحم

181
00:13:01,120 --> 00:13:03,510
...التّوابل هي -
!أعلم... -

182
00:13:03,510 --> 00:13:05,940
!لديّ الشيف أوري هنا

183
00:13:07,240 --> 00:13:10,930
دائماً ما أعتمد على هذا الكتاب. شكراً
!لكِ يا أوري

184
00:13:14,750 --> 00:13:16,540
يا له من إطراء يا أوري

185
00:13:16,540 --> 00:13:18,190
...هـ-هذا عادي

186
00:13:18,190 --> 00:13:21,420
أعني أنّ التزام هاناكو بالوصفة بحذافيرها

187
00:13:21,420 --> 00:13:23,750
لا يعني أنّ الجميع سيبتسم

188
00:13:28,050 --> 00:13:29,220
!هكذا إذاً

189
00:13:37,850 --> 00:13:39,000
انتهيت

190
00:13:48,780 --> 00:13:50,950
!يبدو كلّ شيء ممتازاً

191
00:13:53,030 --> 00:13:56,100
!حسناً، لنبدأ بالتصوير
!حاضر -

192
00:13:56,700 --> 00:13:58,790
!لذيذ

193
00:14:00,080 --> 00:14:03,340
!هرَم من الدجاج المقليّ الحارّ

194
00:14:04,130 --> 00:14:07,570
أحبّ التوابل التي تكون لادِعة قليلاً

195
00:14:08,590 --> 00:14:12,080
لا تقولي لي أنّ هذا الكاري هو لحم
!وبطاطا اللّيلة الماضية؟

196
00:14:13,350 --> 00:14:17,180
أعيدَ تحضير البواقي تصبح كاري! لم أدعها
تغلي لفترة طويلة

197
00:14:18,810 --> 00:14:21,060
!وهذا الكاري مع الفواكه

198
00:14:22,650 --> 00:14:25,090
!إنه منعش جداً وخفيف

199
00:14:26,190 --> 00:14:29,280
لم أرَ أي من هذا في كتاب
وصفات دولتشي

200
00:14:29,280 --> 00:14:34,070
نعم. لقد انشغلنا كثيراً مؤخراً، كلّ
الفتيات مُنهَكات

201
00:14:34,370 --> 00:14:36,720
لاحظتِ ذلك يا أوري؟

202
00:14:36,720 --> 00:14:38,310
بالطبع

203
00:14:38,310 --> 00:14:43,780
لذا أعددتُ أطباق مُفعَمة بالطاقة ومع
ذلك سهلة الهضم

204
00:14:43,780 --> 00:14:47,050
لا عجب في أنّكِ عمود فتيات الموسيقى

205
00:14:47,050 --> 00:14:48,180
...لا

206
00:14:48,180 --> 00:14:52,110
!بفضل أوري، نتمكّن من التألُّق

207
00:14:52,110 --> 00:14:53,990
خفّفن من الإطراءات

208
00:15:02,270 --> 00:15:05,210
ابتساماتهن مختلفة تماماً عن السابق

209
00:15:05,610 --> 00:15:08,360
هذه الابتسامات أفضل بكثير يا سيّد إينابا

210
00:15:09,490 --> 00:15:12,050
حُسِمَ الأمر! سنستخدم هذا لمخطّط المجلّة

211
00:15:24,040 --> 00:15:25,290
سأساعدك

212
00:15:29,250 --> 00:15:30,380
...المعذرة

213
00:15:30,840 --> 00:15:33,840
أوري، شكراً لكِ على اليوم

214
00:15:35,140 --> 00:15:38,180
...حضّرتِ مثل هذه الأطباق العظيمة

215
00:15:38,600 --> 00:15:42,520
مع ذلك كنتُ وقحاً لأنني اعتقدتُ أنه
لم يكن هناك ما يكفي من وقت

216
00:15:42,520 --> 00:15:46,610
لا... كان لديك سبب لتقلق

217
00:15:47,060 --> 00:15:52,140
في الواقع، كنتُ من معجبيكن منذ أوّل
إطلالة لكِ ولكيري

218
00:15:52,140 --> 00:15:53,780
حقّاً؟

219
00:15:53,780 --> 00:15:58,640
نعم! وبرؤيتكِ اليوم، انتعش ذلك
الحماس القديم

220
00:15:58,640 --> 00:16:02,230
أنتِ نجمة جماهير مميّزة

221
00:16:02,230 --> 00:16:03,770
شكراً لك

222
00:16:04,210 --> 00:16:07,980
ألن تؤدّي دور الأخت مع كيري
كما في السّابق؟

223
00:16:07,980 --> 00:16:10,250
...ماذا؟ في الواقع

224
00:16:13,050 --> 00:16:14,720
ما الأمر يا كيري؟

225
00:16:14,720 --> 00:16:16,640
...لا شيء

226
00:16:18,180 --> 00:16:22,680
هاناكو... هل يمكنني قضاء اللّيلة
في غرفتكِ؟

227
00:16:23,520 --> 00:16:26,960
أريد حقّاً أن أتعرّف عليكِ أكثر

228
00:16:26,960 --> 00:16:28,340
لا؟

229
00:16:28,340 --> 00:16:31,650
!هل تمزحين؟ أتمنّى ذلك

230
00:16:31,650 --> 00:16:32,960
!كيري

231
00:16:32,960 --> 00:16:38,160
أوري، سأقضي اللّيل مع هاناكو

232
00:16:38,160 --> 00:16:42,980
.ماذا؟ لا، لنذهب إلى المنزل
لا بدّ وأنكِ مُتعَبة

233
00:16:42,980 --> 00:16:45,870
!لا بأس! أتمنّى أن أستضيفها

234
00:16:45,870 --> 00:16:47,880
!ليس هنا بيت القصيد

235
00:16:48,630 --> 00:16:50,380
ألن تنضمّي إليّ؟

236
00:16:50,380 --> 00:16:51,900
ماذا؟ ماذا تقولين؟

237
00:16:51,900 --> 00:16:54,740
!حسناً، أحسنتُن عملاً يا فتيات

238
00:16:55,760 --> 00:16:58,010
!شكراً لك

239
00:16:58,010 --> 00:17:00,700
!شكراً لك -
!شكراً لك -

240
00:17:01,760 --> 00:17:03,220
الأمور بخواتمها

241
00:17:05,230 --> 00:17:08,130
كيري تقضي اللّيل في غرفة هانا؟

242
00:17:08,730 --> 00:17:11,020
الحياة لا تنفك عن مفاجأتي

243
00:17:12,150 --> 00:17:15,590
استطاعت كيري أخيراً أن تفترق
عن أختها الصغرى

244
00:17:15,590 --> 00:17:16,780
قد تكونين على حقّ

245
00:17:30,080 --> 00:17:32,890
هذا شعور مذهل -
بالفعل -

246
00:17:32,890 --> 00:17:37,880
هاناكو، شكراً لك على الإيمان بأوري اليوم

247
00:17:38,630 --> 00:17:41,540
،لأنّكِ وقفتِ معها

248
00:17:41,540 --> 00:17:45,700
كانت أوري قادرة على إبراز مهاراتها في
الطبخ، والتقطنا صوراً رائعة

249
00:17:45,700 --> 00:17:47,580
...يا للهول. كان ذلك لأنّ

250
00:17:47,580 --> 00:17:51,940
السيّد إيكيهاشي وأوري لا يعرفان معنى
معنى الاستسلام أيضاً

251
00:17:52,730 --> 00:17:56,940
كانت أوري متواضعة وتنحني للآخرين باستمرار

252
00:17:58,200 --> 00:18:03,990
قبل فتيات الموسيقى، شاركنا في أوّل
إطلالة كفرقة من أختين

253
00:18:04,370 --> 00:18:08,870
كنتُ في وعكة صحّية ولا أتحلّى
...بلياقة عالية

254
00:18:12,170 --> 00:18:16,420
وكانت أوري دائماً ما تؤدّي الأعمال
بالنيابة عنّي

255
00:18:16,760 --> 00:18:17,970
...لم أكن أعلم

256
00:18:19,470 --> 00:18:23,140
أنّ أوري كانت تضطرّ للانحناء
...والاعتذار لأجلي

257
00:18:23,140 --> 00:18:26,600
شعرتُ بالاستياء كثيراً

258
00:18:27,350 --> 00:18:32,150
لكن كانت أوري اليوم بديعة بأسلوبها
في الانحناء بكل أدب

259
00:18:32,600 --> 00:18:37,740
شعرتُ وكأنني شهدتُ من جديد فخر
أوري كنجمة جماهير

260
00:18:38,820 --> 00:18:41,780
...أنا متأكّدة لو لم أكن موجودة

261
00:18:41,780 --> 00:18:45,620
لتمكّنت أوري من الازدهار كمؤدّية

262
00:18:46,080 --> 00:18:47,330
أنتِ مخطئة في هذه

263
00:18:49,120 --> 00:18:53,210
...هل تعلمين؟ في كتاب وصفات دولتشي، أطباقك

264
00:18:53,210 --> 00:18:56,750
موصوفة بتفصيل أكبر من أي وصفة أخرى

265
00:18:57,210 --> 00:19:01,330
هذا لأنّها تريدكِ أن تكوني بأفضل وضع مُمكن

266
00:19:01,330 --> 00:19:05,390
لأنها تريد أن تعمل معكِ في فريق للأبد

267
00:19:05,390 --> 00:19:06,620
...هاناكو

268
00:19:06,620 --> 00:19:07,500
اتّفقنا؟

269
00:19:08,680 --> 00:19:09,730
شكراً لكِ

270
00:19:10,600 --> 00:19:14,270
حسناً إذاً يا هاناكو... دعيني أغسل ظهركِ

271
00:19:14,730 --> 00:19:17,340
...سأفركه لكِ بلطف

272
00:19:19,440 --> 00:19:21,550
...يا للهول

273
00:19:23,530 --> 00:19:26,020
!هل أنتِ بخير يا كيري؟

274
00:19:41,630 --> 00:19:43,410
لماذا، كيري...؟

275
00:19:46,390 --> 00:19:48,370
...لطالما كنتُ

276
00:19:48,970 --> 00:19:51,100
الأولى بالنسبة إليكِ يا أختي

277
00:20:51,040 --> 00:20:53,290
!صباح الخير

278
00:21:03,710 --> 00:21:06,180
أوري؟ ما الذي يجري؟

279
00:21:06,180 --> 00:21:09,290
ألستِ المُراقِبة الصباحيّة يا رورو؟

280
00:21:09,290 --> 00:21:10,830
...بلى، لكن

281
00:21:11,060 --> 00:21:15,500
قالت أوري لأنّها استهلكَتْ مكوّنات دولشي
،في جلسة تصوير البارحة

282
00:21:15,500 --> 00:21:19,100
أتَتْ لتعدّ لنا الفطور

283
00:21:19,900 --> 00:21:23,400
هاناكو، آمل ألّا تكوني قد فعلتِ شيئاً
!غريباً لكيري

284
00:21:23,400 --> 00:21:25,740
!ماذا؟ ماذا تقصدين بـ"غريب"؟

285
00:21:26,200 --> 00:21:29,160
كالشخير بصوتٍ عال، لم تستطع
كيري أن تغمض لها عين

286
00:21:29,160 --> 00:21:31,280
...أو ركلها في منامكِ

287
00:21:31,280 --> 00:21:35,560
أو ارتداء بيجاما سخيفة تلوّث سمعة
نجمات الجماهير

288
00:21:35,910 --> 00:21:40,730
لم أفعل شيئاً كهذا! والمعذرة، مُحال
!أن ألوّث سمعة نجمات الجماهير

289
00:21:40,730 --> 00:21:43,390
!هذا أطيب حتّى من طعام البارحة

290
00:21:43,390 --> 00:21:45,530
!شيفي، أنتِ الأفضل

291
00:21:45,940 --> 00:21:48,030
!اخترعتِ قائمة جديدة

292
00:21:48,540 --> 00:21:51,740
هاناكو، لا بدّ وأنّكِ فعلتِ شيئاً
لإشعال نار أوري

293
00:21:52,640 --> 00:21:55,970
أتذوّق حبّ وفخر أوري في الطعام

294
00:23:30,010 --> 00:23:32,970
أودّ تجربة طعام مانتشو-هان صيني
إمبراطوريّ يوماً ما

295
00:23:32,970 --> 00:23:34,720
سأعدّه لك غداً

296
00:23:34,720 --> 00:23:37,760
:الحلقة القادمة من فتيات الموسيقى
"لحم ونجمات جماهير"

297
00:23:37,760 --> 00:23:39,580
ما خطب هذا العنوان؟