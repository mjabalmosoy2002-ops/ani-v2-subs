1
00:00:04,590 --> 00:00:08,110
كلّما جاء هذا الموسم أتذكّر مشهداً مُعيّناً

2
00:00:08,920 --> 00:00:13,890
كنتُ أحبُّ التسلُّل إلى غرفةِ الموسيقى
للعزفِ على البيانو الكبير

3
00:00:14,860 --> 00:00:16,990
...وفي ذلك اليوم، كنتُ أفعل ذلك فحسب

4
00:00:23,580 --> 00:00:26,300
آنذاك، لم أكُن أعرف شيئاً

5
00:00:27,000 --> 00:00:29,350
لم أكُن أدرِك أنّه وبعد سنواتٍ قليلة
...سوف يُتوفّى والدي

6
00:00:29,350 --> 00:00:31,160
...أو أنّني سأتولّى الشّرِكة

7
00:00:32,060 --> 00:00:37,440
أو أنَّ حياة أبي سوف تُزهَق بواسطةِ
مُنظّمة غامِضة تُدعى البجعة السّوداء

8
00:00:53,360 --> 00:00:57,630
في هذا العالم، توجد قوى فريدة
"تُعرَف باسم "إيفول

9
00:00:57,630 --> 00:00:59,870
لا يمتلكها إلّا القلّة القليلة من النّاس

10
00:01:00,360 --> 00:01:04,290
من بينهم، اختار البعض أن يحارب
قدرَه، أن يحارب العالم

11
00:01:04,290 --> 00:01:06,940
هذه حكاية هؤلاء الـ"إيفولفر" الشّباب

12
00:02:31,820 --> 00:02:34,560
اختفَتْ تلميذةٌ من ثانويّة لافلاند؟

13
00:02:35,880 --> 00:02:39,510
...لغز البجعة السّوداء وذكرياتي المفقودة

14
00:02:39,790 --> 00:02:43,180
بحثتُ بشكل شامل متسائلة ما إن
،كانت هناك أي أدلّة

15
00:02:43,180 --> 00:02:44,470
فوجدتُ هذه

16
00:02:44,470 --> 00:02:46,930
حادثة صغيرة في مدرستي الثانوية القديمة

17
00:02:51,020 --> 00:02:52,760
!صباح الخير يا آنسة بطاطس"

18
00:02:52,760 --> 00:02:54,610
لم تسهري طوال اللّيل في العمل ثانية، أليس كذلك؟

19
00:02:59,060 --> 00:03:02,320
سأستمرّ في التحرّي حول أولئك الأشخاص، لذا"

20
00:03:02,730 --> 00:03:06,400
لا تقلقي بشأن أي شيء وركّزي
"على عملكِ فحسب، اتفقنا؟

21
00:03:08,250 --> 00:03:11,400
"شكراً. أموري بخير"

22
00:03:11,750 --> 00:03:13,030
!إرسال

23
00:03:15,000 --> 00:03:16,890
"حلقتنا السابقة من "ميراكل فايندر

24
00:03:16,890 --> 00:03:20,380
،مقابلة حصريّة مع المُخترِق الأسطوري
كِي، حقّقَتْ نجاحاً باهراً

25
00:03:20,780 --> 00:03:23,920
رويداً رويداً، بدأ النّاس يعرفوننا أكثر

26
00:03:24,410 --> 00:03:27,940
وفي خِضمِّ كلّ هذا، الفكرة التي جاء
...بها كانيا لفقرتِنا التّالية كانَتْ

27
00:03:29,170 --> 00:03:31,520
رسالة الحبّ على الطاولة"؟"

28
00:03:31,520 --> 00:03:32,990
أعرف السّبب

29
00:03:32,990 --> 00:03:34,720
ذاع صيتُ ذاك الفيلم

30
00:03:34,720 --> 00:03:37,870
!لِهذا أصبحت الرّسائل ذات شهرة واسِعة اليوم

31
00:03:37,870 --> 00:03:40,610
لأنّ المشاعر المكتوبة بخطّ اليد
تكون طازجة، أليس كذلك؟

32
00:03:40,610 --> 00:03:44,010
لِهذا السّبب ينبغي لنا أن نجمع مجموعة
من النّوادر المتعلِّقة بالرسائل

33
00:03:44,010 --> 00:03:46,280
...ونُظهِر المُعجِزات الدّافئة واليوميّة المخفيّة في

34
00:03:46,280 --> 00:03:47,790
نحن نستغلّ الشعبيّةَ فحسب

35
00:03:47,790 --> 00:03:49,680
!لا تعبِّري عنها بهذا الشّكل

36
00:03:49,680 --> 00:03:51,160
هذا واضح حتّى لو لم أقل ذلك

37
00:03:51,160 --> 00:03:52,620
نحن لا نستغلّها

38
00:03:53,040 --> 00:03:54,780
كيف لك أن تقول ذلك؟

39
00:03:53,040 --> 00:03:55,720
تبّاً، لا أملك أي ذكرى جيّدة عن الرّسائل

40
00:03:55,720 --> 00:03:56,750
!لذا يا حضرة الرّئيسة

41
00:03:56,750 --> 00:03:59,660
كان هناك مطعم رامِن أمام
مدرستنا الثانويّة، صحيح؟

42
00:04:00,000 --> 00:04:02,720
تعتقدين أنَّ بمقدورنا تفقُّد لوحة
الرّسائل هناك؟

43
00:04:03,500 --> 00:04:04,800
ما زالَتْ هناك؟

44
00:04:04,800 --> 00:04:06,930
طبقاً لمصادري

45
00:04:07,270 --> 00:04:10,280
تِلك الإشاعة حول أنّك إذا أفصحت عن مشاعرِك
هناك فسوف تُبادَل بالمثل

46
00:04:10,280 --> 00:04:12,230
!ما زالَتْ مُنتشِرة أيضاً

47
00:04:13,440 --> 00:04:16,270
!ماذا؟ أخبرني بالمزيد بالتفصيل

48
00:04:16,650 --> 00:04:19,880
لك أن تتخيّل أنَّ كيكي تحبُّ مثل هذه الأمور

49
00:04:19,880 --> 00:04:22,190
!هيّا! أخبرني

50
00:04:22,190 --> 00:04:23,320
!هذا مؤلم

51
00:04:23,740 --> 00:04:25,010
حسناً

52
00:04:25,010 --> 00:04:27,150
إنّها خطّة مُلائمة للوقتِ الرّاهن. لنطبّقها

53
00:04:27,150 --> 00:04:28,880
سنسير عليها للحلقةِ المُقبِلة

54
00:04:29,410 --> 00:04:31,370
!مرحى

55
00:04:31,370 --> 00:04:32,240
!انتظر

56
00:04:32,240 --> 00:04:34,850
!لم تخبرني شيئاً بعد

57
00:04:32,240 --> 00:04:35,670
وقد أردتُ التحرِّي حول ثانويّة لافلاند في النِّهاية

58
00:04:44,590 --> 00:04:45,930
!يا للهول

59
00:04:53,560 --> 00:04:55,600
!مرحى! لحقت في آخر لحظة

60
00:05:04,240 --> 00:05:05,420
ماذا؟

61
00:05:05,420 --> 00:05:10,350
لقد سلّمتُ تقريرنا الماليّ الربعيّ
لشركتِنا للمُدقِّق

62
00:05:10,350 --> 00:05:14,120
...أرسلتُ نسخةً لك للاطّلاعِ عليها

63
00:05:15,240 --> 00:05:19,160
أتتّصلين بي في منتصفِ اللّيل لتخبريني
عن تقريركِ الرّبعي؟

64
00:05:19,160 --> 00:05:20,680
مُنتصف اللّيل؟

65
00:05:23,420 --> 00:05:25,800
سأسافر إلى نيويورك للعمل في الأسبوع المُقبِل

66
00:05:33,320 --> 00:05:36,100
!أ-أنا آسفة جداً! تصبح على خير

67
00:05:44,230 --> 00:05:45,030
نعم؟

68
00:05:45,680 --> 00:05:46,990
أغلقتِ الخطَّ في وجهي

69
00:05:47,300 --> 00:05:51,720
...لا! مُحال أن أغلقَ الخطَّ في وجهِك سيّدي

70
00:05:53,760 --> 00:05:55,330
أنا آسفةٌ جدّاً

71
00:05:55,980 --> 00:05:57,070
يكفي

72
00:05:57,070 --> 00:06:00,870
سأطّلِع على التقريرِ لاحقاً. إن كانَتْ
هناك أي أخطاء، سأرسِل ردّاً

73
00:06:00,870 --> 00:06:02,660
حـ... حسناً

74
00:06:03,150 --> 00:06:04,020
ماذا؟

75
00:06:04,020 --> 00:06:06,840
...لا شيء. ظننتُ فقط أنّك ستغضب منّي أكثر من ذلك

76
00:06:06,840 --> 00:06:10,800
الغضب من كلّ صغيرة وكبيرة يرتكبها
أحمق هو مضيعةٌ للوقت

77
00:06:12,100 --> 00:06:13,890
هل تسير أمور البرنامج بسلاسة؟

78
00:06:13,890 --> 00:06:15,050
!أجل

79
00:06:15,050 --> 00:06:17,560
أنا في طريقي لإجراء بحثٍ في ثانويّة لافلاند

80
00:06:17,560 --> 00:06:18,770
حقّاً؟

81
00:06:18,770 --> 00:06:21,860
اِحرصي على ألّا تدعي غباءكِ
يؤثِّر على زملائكِ الأحدث منكِ

82
00:06:24,830 --> 00:06:26,270
!المعذرة

83
00:06:29,610 --> 00:06:32,610
سمعتُ بذلك! فتاة سنة ثانية، صحيح؟

84
00:06:32,610 --> 00:06:35,640
توقّفَتْ عن المجيء إلى المدرسة فجأة
،قبل ستّة أشهر

85
00:06:35,640 --> 00:06:37,770
!ويُقال أنّها اختفَتْ

86
00:06:37,770 --> 00:06:40,890
لطالما كانَتْ غريبة الأطوار قليلاً حسبما يُقال

87
00:06:40,890 --> 00:06:43,290
...سمعتُ أنّه لم يكن لديها أصدقاء

88
00:06:43,290 --> 00:06:46,520
وقالوا أنّه كانَتْ تمتلك قوّة غريبة ما

89
00:06:47,180 --> 00:06:48,460
ماذا يعني ذلك؟

90
00:06:48,460 --> 00:06:50,170
...الأساتذة الذين تعاملوا معها بقسوة

91
00:06:50,170 --> 00:06:53,100
وزملاؤها الأقدم منها في ناديها أخذوا
يتأذّون الواحد تِلو الآخر

92
00:06:53,100 --> 00:06:56,110
يقول النّاس أنّهم احترقوا فجأة رغم
!أنّه لم يكن هناك أي حريق في الجوار

93
00:06:56,110 --> 00:06:58,470
!ماذا؟ هذا غير منطقيّ

94
00:07:03,460 --> 00:07:05,980
هل اختُطِفَتْ بواسطةِ البجعة السّوداء فعلاً أيضاً؟

95
00:07:06,270 --> 00:07:09,320
أرجوكِ! ألن تستمعي إلى روايتي؟

96
00:07:09,320 --> 00:07:10,900
—إن كنتِ من التّلفزيون، فأنا متأكّدٌ أنّكِ

97
00:07:13,000 --> 00:07:14,190
حمّسني ذلك. صحيح؟

98
00:07:14,190 --> 00:07:15,200
أجل

99
00:07:17,380 --> 00:07:19,370
اختفاء فتاة في السّنة الثانية؟

100
00:07:19,370 --> 00:07:21,220
سألنا شخصٌ للتو عن ذلك

101
00:07:21,220 --> 00:07:22,080
ماذا؟

102
00:07:22,080 --> 00:07:23,210
انظري. ذاك الشّخص

103
00:07:25,040 --> 00:07:26,400
هاكو-سينباي؟

104
00:07:27,950 --> 00:07:29,840
هكذا إذاً. أنتِ هنا لإجراء بحث

105
00:07:29,840 --> 00:07:34,380
أجل. هل أنت هنا للسؤالِ
عن اختفاءِ تِلك التّلميذة؟

106
00:07:35,500 --> 00:07:39,230
سينباي، حقيقة وجودك هنا تعني
أنّها إيفولفر حقّاً، صحيح؟

107
00:07:39,230 --> 00:07:43,280
هل اختُطِفَتْ بواسطةِ البجعة السّوداء
كذلك الفتى السّابق؟

108
00:07:43,900 --> 00:07:47,750
ما الذي تخطِّط له البجعة السّوداء
من جمعِ كلّ هؤلاء الإيفولفر؟

109
00:07:48,300 --> 00:07:49,320
...أنتِ

110
00:07:49,320 --> 00:07:50,070
نعم؟

111
00:07:50,690 --> 00:07:51,640
ماذا؟

112
00:07:51,640 --> 00:07:53,210
الأولويّة لتحرّياتكِ

113
00:07:53,210 --> 00:07:53,530
ماذا؟

114
00:07:53,880 --> 00:07:55,490
!ا-انتظر! سينباي

115
00:07:55,490 --> 00:07:56,970
!سينباي

116
00:08:00,000 --> 00:08:01,060
...المعذرة

117
00:08:01,060 --> 00:08:04,330
سينباي، ألن يكون من الأفضل عدم
دخولك هذا المطعم؟

118
00:08:04,620 --> 00:08:06,350
تريدين إجراء مُقابلة، صحيح؟

119
00:08:06,350 --> 00:08:07,840
...أجل، لكن

120
00:08:13,130 --> 00:08:15,480
!انتظر يا سينباي

121
00:08:16,660 --> 00:08:18,360
!مرحباً

122
00:08:23,420 --> 00:08:24,270
الطلب المُعتاد

123
00:08:26,140 --> 00:08:27,530
على الفور

124
00:08:32,840 --> 00:08:34,860
!ما زالَتْ هنا حقّاً

125
00:08:35,410 --> 00:08:37,370
!لم تتغيّر إطلاقاً

126
00:08:40,440 --> 00:08:42,240
شكراً على الانتظار

127
00:08:42,240 --> 00:08:46,510
تفضّل رامن بلحم العجل ورامن تشاشو

128
00:08:46,510 --> 00:08:48,590
!مُذهِل! هذا يُثير حنيني

129
00:08:49,200 --> 00:08:50,630
شكراً على الطعام

130
00:09:02,780 --> 00:09:04,520
إنّه كما كان في السّابِق

131
00:09:06,090 --> 00:09:07,270
هل كنتِ تأتين إلى هنا كثيراً؟

132
00:09:07,590 --> 00:09:08,750
أجل

133
00:09:08,750 --> 00:09:11,460
لكن الصَّديقة التي كنتُ أرافقها إلى هنا

134
00:09:11,460 --> 00:09:14,300
انتقلَتْ فجأة إلى مدرسةٍ أخرى
،في آخر عامنا الأوّل

135
00:09:14,300 --> 00:09:16,470
...ولم تسنحْ لي فُرصة لأودّعها

136
00:09:26,780 --> 00:09:28,170
...بعد ذلك، أنا حقّاً لم

137
00:09:29,180 --> 00:09:30,160
هكذا إذاً

138
00:09:32,670 --> 00:09:33,840
نوه-سان

139
00:09:33,840 --> 00:09:34,670
حاضر؟

140
00:09:34,670 --> 00:09:38,800
أتينا إلى هنا اليوم لأنّها تقول أنّها
تريد كِتابة مقالة عن هذا المطعم

141
00:09:38,800 --> 00:09:40,970
مقالة؟

142
00:09:40,970 --> 00:09:41,870
!أجل

143
00:09:42,260 --> 00:09:45,850
،أنا أنتِج برنامجاً تلفزيونيّاً

144
00:09:45,850 --> 00:09:49,560
وكنتُ آمل أن تسمح لي بكتابةِ مقالة
عن لوحةِ الرّسائل في هذا المطعم

145
00:09:50,930 --> 00:09:53,610
سيترتّب عليّ استشارة زوجتي حول ذلك

146
00:09:53,610 --> 00:09:55,650
لأنّها هي المؤسِّسة

147
00:09:55,650 --> 00:09:58,030
وهي تكره أن تكشف عن نفسِها أمام الآخرين

148
00:09:58,300 --> 00:10:00,080
هلّا صنعت معروفاً وفعلت ذلك؟

149
00:10:00,920 --> 00:10:04,460
إن كان معروفاً لك يا هاكو-سان
...فلا يمكنني الرّفض حقّاً

150
00:10:04,460 --> 00:10:05,740
...سينباي

151
00:10:05,740 --> 00:10:08,550
...لا أريد أن أفرض عليهم أو ما شابه

152
00:10:12,320 --> 00:10:13,420
أمهليني لحظة

153
00:10:14,720 --> 00:10:16,080
!حسناً

154
00:10:18,540 --> 00:10:19,480
تفضّلي

155
00:10:21,090 --> 00:10:22,920
سأذهب وأتكلَّم مع زوجتي

156
00:10:22,920 --> 00:10:24,850
تناولي هذه بينما تنتظرين

157
00:10:24,850 --> 00:10:26,990
!ليس عليك أن تتكبّد أي عناء لأجلي

158
00:10:26,990 --> 00:10:29,600
آسِفة لكوني مُلِحّة إلى هذا الحدّ

159
00:10:29,600 --> 00:10:31,210
لا تقلقي بشأنِ ذلك

160
00:10:31,210 --> 00:10:34,450
نحن مَدينون لهاكو-سان بالكثير

161
00:10:35,820 --> 00:10:38,460
المعذِرة... هل الأمور بخير حقّاً؟

162
00:10:38,460 --> 00:10:39,490
عفواً؟

163
00:10:39,490 --> 00:10:43,330
هل يُعقَل أنّه ما زال يهدِّدك
بعد كلّ هذا الوقت؟

164
00:10:49,280 --> 00:10:52,700
لا يمكِن لهاكو-سان أن يهدّدنا ليبتزّنا مالياً

165
00:10:52,700 --> 00:10:53,720
...لـ-لكن

166
00:10:53,720 --> 00:10:58,010
أنا متأكّدةٌ أنّني رأيتُك تعطي هاكو-سينباي
!ظرفاً مليئاً بالمال

167
00:10:58,010 --> 00:11:02,320
بالنسبةِ لنا، هاكو-سان هو الشّخص
الذي تُدين له عائلتُنا بكلِّ شيء

168
00:11:10,520 --> 00:11:13,820
،نقلَ هاكو-سان ابننا إلى المشفى فوراً

169
00:11:13,820 --> 00:11:16,220
وحتّى أنّه سدّد التّكاليف الطبّية

170
00:11:16,220 --> 00:11:20,480
بفضلِه، تعافى ابنُنا كلّياً دون أن تظهر
عليه أي آثار مُستديمة

171
00:11:20,480 --> 00:11:22,530
...إذاً ما رأيتُه كان

172
00:11:23,280 --> 00:11:28,250
هاكو-سان هو شخصٌ يسلكُ الطريقَ الذي
يؤمِن به مهما كان رأي الآخرين

173
00:11:28,250 --> 00:11:30,710
يبدو أنَّ كثيراً من النّاسِ يُسيئون فهمه، لكن

174
00:11:30,710 --> 00:11:34,000
نحن حقّاً مُمتنّون له

175
00:11:37,150 --> 00:11:41,140
إن كان ذلك صحيحاً، عن ماذا إذاً كانَتْ
تحكي تِلك الرسالة المُلطَّخة بالدم؟

176
00:12:01,410 --> 00:12:03,260
هل استطعتِ جمع ما يكفي من معلومات؟

177
00:12:03,260 --> 00:12:05,640
أجل! شكراً جزيلاً لكِ

178
00:12:06,080 --> 00:12:07,760
إن كنتِ قد انتهيتِ فعودي إلى المنزلِ بسرعة

179
00:12:09,700 --> 00:12:12,450
لكن يا سينباي، ستبدأ بتحرّياتك الآن، صحيح؟

180
00:12:12,450 --> 00:12:13,510
!سأذهب أيضاً

181
00:12:13,510 --> 00:12:15,410
اتّصل المقرّ سابقاً

182
00:12:15,790 --> 00:12:18,130
يبدو أنّهم أخذوا ينشطون في هذه المنطِقة

183
00:12:18,460 --> 00:12:19,630
...البجعة السّوداء

184
00:12:19,630 --> 00:12:23,010
إن رافقتِني، من المُحتمَل أن تتأذّي

185
00:12:23,010 --> 00:12:24,700
!لكن أريد أن أعرف

186
00:12:24,700 --> 00:12:26,890
—ما الذي يخطِّطون له؟ سوف أذهب

187
00:12:26,890 --> 00:12:30,100
أخبرتُكِ. قد تتعرّض حياتكِ لخطر

188
00:12:35,100 --> 00:12:38,730
إذا اكتشفتُ أي شيء، سأحرص
على إخباركِ لاحقاً

189
00:12:38,730 --> 00:12:40,520
عودي إلى المنزلِ اليوم

190
00:12:53,900 --> 00:12:55,750
كانيا؟ هل من مُشكلة؟

191
00:12:55,750 --> 00:12:57,210
هل يسير البحث على ما يُرام؟

192
00:12:57,570 --> 00:13:01,380
ما الأخبار؟ ما رأيكِ بمدرستكِ
القديمة بعد العودة؟

193
00:13:01,380 --> 00:13:03,470
هل ذكّرَتْكِ بشيء؟

194
00:13:04,310 --> 00:13:05,550
ماذا تقصد بـ"أي شيء"؟

195
00:13:05,550 --> 00:13:07,700
بربّكِ

196
00:13:07,700 --> 00:13:10,900
ذكريات من المدرسةِ الثانويّة عن الحسرة
...أو الوعود، أو

197
00:13:10,900 --> 00:13:14,020
رسائل وُضِعَتْ سرّاً على طاولتك رُبّما؟

198
00:13:14,820 --> 00:13:16,480
!ما أدراك بذلك يا كانيا؟

199
00:13:16,480 --> 00:13:17,320
ماذا؟

200
00:13:17,320 --> 00:13:21,510
...في الواقع! حدثَتْ أمور كثيرة و

201
00:13:21,900 --> 00:13:23,040
!كانيا

202
00:13:23,040 --> 00:13:25,600
مهلاً، مهلاً. لا تقلقي بشأنِ التّفاصيل

203
00:13:25,600 --> 00:13:27,240
كيف سار البحث؟

204
00:13:31,900 --> 00:13:33,200
مرحباً؟

205
00:13:33,200 --> 00:13:34,910
حضرة الرّئيسة، أتسمعينني؟

206
00:13:34,910 --> 00:13:36,290
آسفة. سأعاود الاتِّصال لاحقاً

207
00:13:36,290 --> 00:13:37,260
—يا حضرة

208
00:13:42,930 --> 00:13:44,800
...يجب أن أخبر سينباي

209
00:14:33,100 --> 00:14:36,620
هذا لن يحرّركِ من رملي

210
00:14:40,500 --> 00:14:41,350
!توقّف

211
00:14:45,210 --> 00:14:47,210
ماذا تستفيدون من فعل هذا؟

212
00:14:47,690 --> 00:14:49,740
ما هو هدفكم جميعاً؟

213
00:14:49,740 --> 00:14:51,520
لا أدري

214
00:14:51,520 --> 00:14:56,130
كلّ ما طُلِب منّي هو رميكِ من الحافّةِ هنا

215
00:14:59,010 --> 00:15:01,000
خلعَ سِواري؟

216
00:15:01,000 --> 00:15:03,540
...لا. رغم ذلك، سينباي سوف

217
00:15:03,540 --> 00:15:05,210
ستصل الشّرطة إلى هنا قريباً

218
00:15:05,210 --> 00:15:06,870
يبدو هذا جيّداً

219
00:15:08,270 --> 00:15:12,120
سندعهم يلتقِطون جثّتكِ

220
00:15:13,640 --> 00:15:17,460
...آسف. لا أكنّ ضغينة تجاهكِ، لكن

221
00:15:17,460 --> 00:15:19,310
هذا لأجلِ أختي الصّغيرة

222
00:15:24,080 --> 00:15:25,740
!أتخادعينني؟

223
00:15:26,220 --> 00:15:27,350
!موتي

224
00:15:28,080 --> 00:15:30,220
،ما دمتِ في مكانٍ وسط الرِّياح

225
00:15:30,220 --> 00:15:31,780
سأجدكِ دوماً

226
00:15:32,140 --> 00:15:33,240
!هاكو-سينباي

227
00:15:42,830 --> 00:15:45,100
...ما هذا؟ قوّتي

228
00:15:45,840 --> 00:15:47,400
—لا أستطيع احتواءها

229
00:16:17,610 --> 00:16:19,180
!هاكو-سينباي

230
00:16:19,180 --> 00:16:20,580
أنتِ بخير الآن

231
00:16:21,260 --> 00:16:22,540
...لكن هذا

232
00:16:32,940 --> 00:16:34,290
...لقد فُكّت

233
00:16:36,640 --> 00:16:38,100
!سينباي، خلفك

234
00:16:40,660 --> 00:16:41,840
!تمسّكي

235
00:16:51,480 --> 00:16:53,250
ستأتي التَّعزيزات إلى هنا قريباً

236
00:16:53,250 --> 00:16:54,780
لا حاجة للقلقِ بشأن الباقي

237
00:17:09,910 --> 00:17:11,170
!انظر إلى هذه الفوضى

238
00:17:11,460 --> 00:17:14,610
ألن تُجهِز عليه يا سينباي؟

239
00:17:14,610 --> 00:17:17,140
!عليك أن تُدرِك مكانتك يا فتى

240
00:17:17,140 --> 00:17:19,040
—إذا تعلّمتَ درسك فمن المُستحسَن أن

241
00:17:19,040 --> 00:17:20,120
...أنا

242
00:17:21,150 --> 00:17:23,400
!لا أتلقّى الأوامر من أحد

243
00:17:24,730 --> 00:17:25,980
!خُذ هذه

244
00:17:29,500 --> 00:17:30,980
!فلتمُت

245
00:17:45,520 --> 00:17:46,770
!لا

246
00:17:46,770 --> 00:17:48,080
...ما زلتُ

247
00:18:03,070 --> 00:18:05,730
وهبتني الحياة

248
00:18:05,730 --> 00:18:09,340
لهذا سأضحّي بكلِّ شيء لحمايتكِ

249
00:18:12,410 --> 00:18:13,740
لا تضيعي هذا ثانية

250
00:18:13,740 --> 00:18:14,660
حسناً

251
00:18:16,890 --> 00:18:20,310
سينباي، كيف عرفتَ أنّني كنتُ على السّطح؟

252
00:18:20,310 --> 00:18:22,120
لم أكن أحمل أداة التعقُّب

253
00:18:22,120 --> 00:18:26,160
أخبرتُكِ. ما دمتِ وسط الرّياح
فسوف أجدكِ دوماً

254
00:18:28,210 --> 00:18:29,820
إذاً... ما الغرض من هذا؟

255
00:18:31,050 --> 00:18:34,090
في المرّة المُقبِلة التي تنادينني
"بها، لا تناديني "سينباي

256
00:18:34,090 --> 00:18:35,560
ناديني هاكو

257
00:18:37,520 --> 00:18:38,340
حسناً

258
00:18:42,350 --> 00:18:43,920
...بعد أسبوع

259
00:18:43,920 --> 00:18:45,540
تلقّيتُ تقريراً

260
00:18:46,100 --> 00:18:50,230
الشّخص الذي هاجمني، جاي، كان
له أخت توأم صُغرى

261
00:18:46,910 --> 00:18:48,050
بشأن هذه الفقرة

262
00:18:48,050 --> 00:18:50,230
هلّا جعلتها أكثر تماسُكاً؟

263
00:18:50,490 --> 00:18:53,190
،نظراً إلى أنّها كانَتْ تمتلك إيفول قويّاً جدّاً

264
00:18:53,190 --> 00:18:55,730
تمَّ أسرها واحتجازها في مركزِ البجعة السّوداء

265
00:18:56,170 --> 00:19:00,200
هاجمني لويس مقابل لِقاء أخته

266
00:19:01,120 --> 00:19:04,660
وهذان الشّقيقان، جاي وأخته الصّغرى جوسي

267
00:19:04,660 --> 00:19:07,180
ورد اسمهما في القضيةِ الأخيرة
التي كان أبي قد عمل عليها

268
00:19:07,180 --> 00:19:09,690
كانَتْ عن اختفاءِ عائلة في شمال مدينة لافلاند

269
00:19:09,690 --> 00:19:11,530
وهما كانا الطّفلين اللّذين اختفيا

270
00:19:12,670 --> 00:19:16,000
...وفاة أبي... الذّكريات التي لا أستطيع تذكّرها

271
00:19:16,860 --> 00:19:19,050
كلّ شيء متّصل ببعضه

272
00:19:19,050 --> 00:19:22,970
البجعة السّوداء... كلّ شيء مرتبِط
بمؤامرتِهم الخبيثة

273
00:19:24,940 --> 00:19:27,970
شكراً لك على إرسال تقرير تحقيقك

274
00:19:27,970 --> 00:19:31,750
ما زلتُ لا أعرف لماذا تستهدفكِ البجعةُ السّوداء

275
00:19:31,750 --> 00:19:32,880
كوني حذِرة

276
00:19:32,880 --> 00:19:33,810
حسناً

277
00:19:35,680 --> 00:19:37,240
أخبرني كانيا

278
00:19:37,240 --> 00:19:41,400
قال، "في ذلك الوقت، طلب منّي أخي
"هاكو وضع الرّسالة على طاولتكِ

279
00:19:42,370 --> 00:19:43,450
أنا آسفةٌ جدّاً

280
00:19:43,450 --> 00:19:46,470
...ظننتُها تهديداً في بادئ الأمر

281
00:19:46,470 --> 00:19:49,190
ماذا كتبتَ في الرّسالة؟

282
00:19:52,600 --> 00:19:55,840
إذاً عليّ فقط... وضع هذه على طاولتها، صحيح؟

283
00:19:55,840 --> 00:19:58,210
...إنّها ملطّخة بالدم

284
00:19:58,720 --> 00:20:00,870
...أفسدتُ الأمر أثناء التّدريب، لذا

285
00:20:01,370 --> 00:20:04,090
آسف للسؤال، لكن أعِد كتابتها لأجلي، اتّفقنا؟

286
00:20:04,090 --> 00:20:06,600
لا أظنّني سأحصل على فُرصة
قبل عمليّة الالتحاق

287
00:20:07,120 --> 00:20:09,970
...لكنّها رائعة هكذا

288
00:20:11,000 --> 00:20:14,350
أنا واثقٌ أنّك عانيتَ كثيراً حتّى عرفتَ
ماذا تكتب في آخر لحظة

289
00:20:14,350 --> 00:20:16,670
!كان ذلك وشيكاً

290
00:20:18,800 --> 00:20:20,840
!أقبل بالمهمّة

291
00:20:20,840 --> 00:20:24,800
أخي هاكو، أعِدُك أنَّ مشاعرك
!ستُبادَل بالمثل

292
00:20:28,220 --> 00:20:30,610
لنترك تِلك الرّسالة في الماضي

293
00:20:30,990 --> 00:20:33,820
بالنسبةِ لنا، لا يزال المُستقبل أمامنا

294
00:22:06,460 --> 00:22:09,840
لقد تأكّدنا من أنَّ لديهم قاعدة هنا

295
00:22:10,160 --> 00:22:12,980
السّماسِرة المتورِّطون في تِلك
،الحادِثة قبل 17 عاماً

296
00:22:12,980 --> 00:22:15,220
ومُنظّمة مُرتبِطة بإقراض المال

297
00:22:15,810 --> 00:22:19,450
يبدو أنَّ عدداً من الشخصيّات البارِزة
في العالمِ الماليّ مُرتبِطون أيضاً

298
00:22:21,240 --> 00:22:23,260
كان ذلك قبل ثلاثة أيّام فقط

299
00:22:23,260 --> 00:22:27,070
هُيِّئَتْ لتبدو أمام النّاس أنّها انفجار غازيّ

300
00:22:27,580 --> 00:22:29,590
إليك التّقرير عن كلِّ ما جرى إلى الآن

301
00:22:32,720 --> 00:22:34,510
ماذا عن تِلك الفتاة؟

302
00:22:35,000 --> 00:22:38,100
رغم أنّك قلتَ أنّك ستجد مُرشّحاً مُرجَّحاً

303
00:22:38,620 --> 00:22:40,730
لا يوجد دليلٌ ملموسٌ بعد

304
00:22:40,730 --> 00:22:45,450
إذا كان سبب فقدانها للذكرياتِ يكمُن
...في الحادِثة قبل 17 عاماً، فإذاً

305
00:22:45,450 --> 00:22:47,730
السّلوك الخاطئ سيعطي نتيجة عكسيّة

306
00:22:48,320 --> 00:22:51,230
تقصد ب.ت.س.د؟

307
00:22:51,230 --> 00:22:53,730
في هذه الحالة، كُل ما يمكنك فعله
هو المُتابعة بحذر

308
00:22:59,580 --> 00:23:00,440
!انتبه

309
00:23:01,440 --> 00:23:04,150
سأستعيدها

310
00:23:04,150 --> 00:23:06,390
مهما كلّف الأمر

311
00:23:21,120 --> 00:23:25,000
...مشهد جميل يُثير مشاعر الحنين

312
00:23:25,000 --> 00:23:28,340
إذا استرخيتِ مُتأمِّلة الذكريات المُترنِّحة
،تحت ظلِّ هذه الشجرة

313
00:23:28,340 --> 00:23:30,390
فستبدئين ترين حقيقتكِ

314
00:23:30,390 --> 00:23:31,550
...الحلقة السّادسة

315
00:23:31,550 --> 00:23:33,200
".ما وراء ذلك الحلم"