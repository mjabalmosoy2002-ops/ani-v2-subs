1
00:00:01,130 --> 00:00:03,840
كان يوماً خريفيّاً صحواً مثاليّاً

2
00:00:04,180 --> 00:00:06,000
،بتوصيةٍ من سيمون

3
00:00:06,000 --> 00:00:08,850
"كنتُ في طريقي لإجراءِ بحث لـ"ميراكل فايندر

4
00:00:09,470 --> 00:00:10,940
على الأقلّ، هذا ما ظننتُه

5
00:00:12,700 --> 00:00:18,180
حسناً؟ هل ستخبرني إلى أين نحن
ذاهبان الآن يا سيمون؟

6
00:00:18,180 --> 00:00:19,850
هل أنتِ مُصرّة على معرفة ذلك؟

7
00:00:19,850 --> 00:00:20,920
...في الواقع

8
00:00:20,920 --> 00:00:25,470
أنت من قال أنّ هناك مكان غامض

9
00:00:25,470 --> 00:00:28,450
!لهذا أنا هنا وكلّي جاهزيّة للذهاب

10
00:00:29,300 --> 00:00:31,420
انتظر لحظة... هل كنتَ تكذِب؟

11
00:00:31,420 --> 00:00:35,430
في الحقيقة... هلّا سمحتِ لي بالشرح؟

12
00:00:36,820 --> 00:00:40,740
أمسيتِ تُعلنين عن مقالةٍ مشهورة
تِلو الأخرى مؤخّراً

13
00:00:40,740 --> 00:00:42,980
شركتُكِ ترتقي

14
00:00:42,980 --> 00:00:44,060
شكراً لك

15
00:00:46,000 --> 00:00:48,410
بالتزامنِ مع عملكِ كرئيسةِ شركة

16
00:00:48,410 --> 00:00:50,250
كنتِ مشغولة تماماً

17
00:00:50,250 --> 00:00:52,190
بالطبع، علينا أن نعمل بجدٍّ ومثابرة

18
00:00:52,930 --> 00:00:54,610
لكن هناك مشكلة واحدة

19
00:00:55,860 --> 00:00:58,380
،يبدو أنّكِ لم تلحظي

20
00:00:58,380 --> 00:01:02,500
لكن موظّفيكِ الموهوبين الموثوقين
لا يمكن خداعهم

21
00:01:03,180 --> 00:01:05,360
،أتوا إليّ ليتحدّثوا عنكِ

22
00:01:05,360 --> 00:01:09,570
قائلين أنّهم مسرورون لعملكِ بجدٍّ لكنّهم
قلقون من سقوطكِ نتيجة التّعب

23
00:01:11,420 --> 00:01:12,480
...لكن

24
00:01:12,480 --> 00:01:14,510
يُبالغون في القلق

25
00:01:14,850 --> 00:01:18,830
قِسط من الرّاحة أمر ضروريّ لأي مدير

26
00:01:18,830 --> 00:01:20,910
،عندما يحين الوقت لاتّخاذ قرارات مهمّة

27
00:01:20,910 --> 00:01:24,110
يجب أن يكون عقلكِ مرتاحاً ليعمل
بأفضل أداء ممكن

28
00:01:24,480 --> 00:01:26,050
...لهذا السّبب

29
00:01:26,050 --> 00:01:29,100
كنتُ آمل أن ترافقيني في نزهةٍ اليوم

30
00:01:29,100 --> 00:01:34,780
بهذا الشّكل، سيرتاح بالهم وسأحظى
أنا بإجازةٍ لطيفة

31
00:01:36,170 --> 00:01:37,440
حسناً

32
00:01:37,440 --> 00:01:40,460
إذاً، اليوم فقط، سأنسى أمر
العمل وأستمتع بوقتي

33
00:01:40,840 --> 00:01:42,460
شكراً لك يا سيمون

34
00:01:44,630 --> 00:01:48,740
لكن... إنّه مكانٌ غامضٌ حقّاً

35
00:01:50,380 --> 00:01:54,590
المكان الذي نحن مُتوجِّهان إليه هو مكانٌ
يحتوي على إطلالةٍ مميّزةٍ جدّاً

36
00:01:55,910 --> 00:01:59,540
ما الذي ينتظرنا وراء هذا المنظر الجميل؟

37
00:01:59,540 --> 00:02:02,310
في تِلك اللّحظة، وحده سيمون من يعرف الإجابة

38
00:02:02,770 --> 00:02:08,060
لكن حتّى هو لم يستطع أن يتصوّر
ما كان على وشك أن يحدث

39
00:02:21,320 --> 00:02:25,590
في هذا العالم، توجد قوى فريدة
"تُعرَف باسم "إيفول

40
00:02:25,590 --> 00:02:27,830
لا يمتلكها إلّا القلّة القليلة من النّاس

41
00:02:28,350 --> 00:02:32,250
من بينهم، اختار البعض أن يحارب
قدرَه، أن يحارب العالم

42
00:02:32,250 --> 00:02:34,900
هذه حكاية هؤلاء الـ"إيفولفر" الشّباب

43
00:04:08,810 --> 00:04:10,970
لا تزال وجهتنا بعيدة، صحيح؟

44
00:04:10,970 --> 00:04:13,500
هل أنت متأكّد أنّه كان ينبغي
أن نترجّل عن الحافلة هنا؟

45
00:04:13,500 --> 00:04:16,650
الطقس جميل. لنتمشَّ قليلاً

46
00:04:17,070 --> 00:04:19,190
أردتِ رؤية المنظر، صحيح؟

47
00:04:24,320 --> 00:04:27,370
في البداية، كان كمئة ألف ثعلب آخر"

48
00:04:27,370 --> 00:04:29,150
مجرّد ثعلب

49
00:04:29,570 --> 00:04:32,830
،حتّى أصبحنا صديقين

50
00:04:32,830 --> 00:04:35,050
،والآن هو الوحيد الفريد من نوعه في العالم بأسره

51
00:04:35,050 --> 00:04:37,380
"ثعلب مميّز جداً

52
00:04:38,050 --> 00:04:40,230
من "الأمير الصغير"، صحيح؟

53
00:04:40,230 --> 00:04:44,130
...سيذكّرني لون القمحِ الذهبيّ بكِ"

54
00:04:44,810 --> 00:04:47,910
وصوت الرّياح تهبُّ من فوق حقول القمح

55
00:04:47,910 --> 00:04:50,600
"...هو شيء سأتعلّق به

56
00:04:55,420 --> 00:04:57,400
!اُنظر

57
00:04:57,700 --> 00:05:01,340
هل ترى؟ ألا يوحي لك هذا أنّ ثعلباً قد يجلس هناك؟

58
00:05:03,700 --> 00:05:04,950
ما الخطب؟

59
00:05:11,020 --> 00:05:13,500
يبدو أنها تتألّم ولا تستطيع المشي

60
00:05:15,960 --> 00:05:17,690
إنّها ليسَتْ شارِدة

61
00:05:17,690 --> 00:05:20,090
إنها مجرّد هريرة، لذا لا يمكن أن تكون ابتعدت كثيراً

62
00:05:20,090 --> 00:05:22,160
!علينا إيجاد صاحبها

63
00:05:22,160 --> 00:05:25,220
اصبري فحسب. سأوصلكِ إلى المنزل

64
00:05:25,530 --> 00:05:27,660
سيمون، اعتني بهذه الصّغيرة

65
00:05:29,050 --> 00:05:32,010
سأذهب وأسأل النّاس هناك

66
00:05:32,480 --> 00:05:34,830
!المعذرة

67
00:05:39,020 --> 00:05:40,960
شكراً لكما

68
00:05:40,960 --> 00:05:44,440
أليس الحظّ يحالفنا لأنّكِ أنقذتِ بواسطة
لطيفَين كهذين يا مي-تشان؟

69
00:05:44,790 --> 00:05:48,450
والآن تفضّلا رجاء. سأعدُّ الشاي

70
00:05:48,450 --> 00:05:50,550
لا تُتعبي نفسك

71
00:05:50,550 --> 00:05:52,560
لا حاجة للتواضع. هيّا

72
00:05:53,440 --> 00:05:54,410
حسناً

73
00:06:00,130 --> 00:06:01,610
...جميل

74
00:06:02,060 --> 00:06:03,220
شكراً لكِ

75
00:06:03,220 --> 00:06:05,660
هل أنتِ من صنع كلّ هذا؟

76
00:06:05,660 --> 00:06:06,590
أجل

77
00:06:06,590 --> 00:06:09,710
اسمحي لي أن أعطيكِ هديّةً كعربون شكر

78
00:06:09,710 --> 00:06:14,000
لا! لا أقبل شيئاً بهذا الجمال مقابل لا شيء

79
00:06:14,840 --> 00:06:15,830
ما هذه؟

80
00:06:15,830 --> 00:06:20,100
إنّها حِليّ. حِليّ تمنح الحظّ السَّعيد

81
00:06:21,710 --> 00:06:25,570
هلّا علّمتِني كيفيّة صنعها؟

82
00:06:25,570 --> 00:06:28,530
...بالطبع! اختاري ما تريدين تعلّم صنعه

83
00:06:28,530 --> 00:06:32,000
...الأبسط إن إمكن

84
00:07:00,400 --> 00:07:04,450
...حسناً... نفعل هذا، ثمّ

85
00:07:05,490 --> 00:07:06,650
ماذا؟

86
00:07:07,670 --> 00:07:09,110
!مرّة أخرى

87
00:07:10,410 --> 00:07:14,540
سمعتُ أنّكِ واجهتِ بعض المتاعب أثناء
التحرّي حول مدرستكِ الثانويّة القديمة

88
00:07:15,480 --> 00:07:16,970
أخبروك بذلك أيضاً؟

89
00:07:16,970 --> 00:07:21,640
يبدو أنّكِ تتحرّين عن شيء خطير جدّاً ثانية

90
00:07:21,640 --> 00:07:25,200
أعرفك جيّداً، لا بدّ وأنّكِ تسعين وراء الحقيقة

91
00:07:25,200 --> 00:07:26,670
بأقصى طاقتك

92
00:07:27,550 --> 00:07:32,620
ولا أدري ما إن كانت معرِفة الحقيقة
تجلب السّعادةَ دوماً

93
00:07:33,900 --> 00:07:39,810
قد تندمين إذا تعرّضتِ لخطر أو تعلّمتِ
أشياء كنتِ لتكوني أسعد لولا معرفتها

94
00:07:40,890 --> 00:07:44,240
شكراً لك يا سيمون للقلقِ عليّ

95
00:07:45,100 --> 00:07:48,280
لكن... لا أظنّ أنّ هذا ما سينتابني من شعور

96
00:07:48,280 --> 00:07:51,350
،لا أنكر أنّ ذلك قد يكون خطيراً

97
00:07:51,350 --> 00:07:54,740
لكن هذا أفضل بكثير من عدمِ المعرفة

98
00:07:54,740 --> 00:07:55,820
...فأساساً

99
00:07:56,110 --> 00:07:58,140
،مهما كانت الحقيقة قاسية

100
00:07:58,140 --> 00:08:00,080
لا يمكنك التغلُّب عليها ما لم تعرفها، صحيح؟

101
00:08:00,630 --> 00:08:03,750
وإن لم تتغلّب عليها فلن يتغيّر شيء مهما فعلت

102
00:08:03,750 --> 00:08:05,640
لا يمكنك التقدُّم خطوة

103
00:08:05,640 --> 00:08:07,310
وأنا لا أقبل بذلك

104
00:08:08,030 --> 00:08:11,100
إذا كان هناك "إيفولفر" يعانون، أريد مساعدتهم

105
00:08:11,100 --> 00:08:14,370
لا أريد من أحد آخر أن يسقط ضحيّة
مثلما حدث مع أبي

106
00:08:14,370 --> 00:08:16,310
أريد إيقاف البجعة السّوداء

107
00:08:24,630 --> 00:08:26,730
!أخطأتُ مجدّداً

108
00:08:27,980 --> 00:08:30,330
دعيني أراها. سأفكّكها لكِ

109
00:08:30,330 --> 00:08:32,700
!لا داعي! سأفعل ذلك بنفسي

110
00:08:32,700 --> 00:08:35,050
حقّاً؟ إذاً خذي وقتكِ

111
00:08:35,050 --> 00:08:36,030
!حسناً

112
00:08:38,170 --> 00:08:42,680
لا تضغطي على نفسكِ كثيراً عندما
تكونين معي. خذي وقتكِ في النضوج

113
00:08:57,880 --> 00:08:58,640
شو

114
00:08:59,600 --> 00:09:03,100
هل كنتَ أنت من استدعاني إلى هذا المكان؟

115
00:09:03,490 --> 00:09:06,060
أجل، لديّ تحذير لك

116
00:09:07,940 --> 00:09:10,460
رسالة من البجعة السّوداء

117
00:09:10,460 --> 00:09:14,400
"يُقال، "إذا كانت حياتك تهمّك، كفّ عن التدخُّل

118
00:09:15,320 --> 00:09:17,570
!لحظة، أنت من البجعة السّوداء؟

119
00:09:18,000 --> 00:09:21,410
لا تقلّل من شأني. لم أنضمّ لهم

120
00:09:21,410 --> 00:09:23,680
كُل ما في الأمر أنّهم يستحقُّون الاستغلال

121
00:09:23,680 --> 00:09:25,710
قبلتُ هذا العمل بالمقابل، هذا كُل شيء

122
00:09:28,710 --> 00:09:30,480
!إيّاك ولمسها

123
00:09:38,940 --> 00:09:42,970
أنا متأكّدٌ أنّه ما زال هناك المزيد من المرح
لنحظى به، لكن ينبغي أن نكتفي بهذا القدر اليوم

124
00:09:42,970 --> 00:09:46,610
لا أعتقد أنّك ستتمكّن من حماية أي شيء
...مهمّ بالنسبة لك، لكن

125
00:09:46,610 --> 00:09:51,690
حسناً... إذا أردت حمايتها حقّاً فحريّ
بك أن تغادر قوّات المهام فوراً

126
00:09:52,560 --> 00:09:53,650
ماذا تعني؟

127
00:09:55,160 --> 00:09:58,400
ألا تعلم ماذا يحدث للأشخاص
الذين تقبض عليهم؟

128
00:09:58,920 --> 00:10:02,300
يستخدمون كلمات طنّانة مثل "حبس
"احترازيّ" و "ردع جريمة

129
00:10:02,300 --> 00:10:05,620
لكن قوّات المهام هي مجموعة من الجلّادين

130
00:10:10,490 --> 00:10:12,130
...ينبغي أن تتوخّى الحذر

131
00:10:13,020 --> 00:10:14,750
كي لا يعدمونك أيضاً

132
00:10:33,150 --> 00:10:34,080
ها نحن ذا

133
00:10:38,610 --> 00:10:40,070
!فعلتُها

134
00:10:40,590 --> 00:10:43,410
تهانينا! أحسنت. إنه عمل مبهر

135
00:10:43,410 --> 00:10:44,420
!شكراً

136
00:10:44,420 --> 00:10:47,090
سيمون. إنّها هديّة

137
00:10:47,090 --> 00:10:47,660
ماذا؟

138
00:10:47,990 --> 00:10:52,370
أعرف أنّني تأخّرتُ في ذلك، لكن شكراً
"لك على مساهمتك في "ميراكل فايندر

139
00:10:53,080 --> 00:10:57,300
لولا وجودك في البرنامج، لما استطعنا المُتابعة

140
00:10:57,860 --> 00:11:02,930
عندما التقينا أوّل مرّة، طلبتَ منّي
أن أريك طباعي، أليس كذلك؟

141
00:11:02,930 --> 00:11:06,460
عندما فكّرتُ في الأمر الآن، عرفتُ
أنّها كانت الشرارة الأولى

142
00:11:06,460 --> 00:11:08,430
أنت من دفعني للمضيّ قُدماً

143
00:11:10,350 --> 00:11:12,800
هذه مجرّد عربون شكر منّي

144
00:11:12,800 --> 00:11:14,820
احتفِظ بها لجلبِ الحظّ السعيد إن أحببت

145
00:11:14,820 --> 00:11:19,790
تقصدين لهذا السّبب أعدتِ العمل
عليها مراراً وتكراراً؟

146
00:11:19,790 --> 00:11:20,750
!أجل

147
00:11:21,060 --> 00:11:24,060
رغم أنّها لم تصبِح مُتقنة كما ينبغي

148
00:11:24,490 --> 00:11:27,580
صحيح. لا أعتبرها مُتقنة

149
00:11:28,380 --> 00:11:30,500
لكن تروقني

150
00:11:30,860 --> 00:11:33,500
إنّها تُسعدني كثيراً. شكراً لكِ

151
00:11:46,680 --> 00:11:48,460
!كم هو جميل

152
00:11:48,460 --> 00:11:51,890
أهذا هو "المنظر المميّز" الذي تحدّثت عنه؟

153
00:11:51,890 --> 00:11:53,130
لا

154
00:12:12,870 --> 00:12:14,210
!مُذهل

155
00:12:23,110 --> 00:12:25,140
هل تتذكّرين... هذا المكان؟

156
00:12:32,390 --> 00:12:35,850
...لماذا أشعر... فجأة... بالنُّعاس

157
00:12:39,950 --> 00:12:42,360
...أنا متأكّدٌ أنّكِ ستتذكّرين

158
00:12:43,590 --> 00:12:45,940
...الحقيقةَ التي تبحثين عنها

159
00:12:46,640 --> 00:12:50,430
والوعد الذي قطعناه في ذلك اليوم

160
00:13:01,850 --> 00:13:03,010
ماذا؟

161
00:13:03,010 --> 00:13:05,850
هل... نمت؟

162
00:13:15,500 --> 00:13:18,870
...تبدو أصغر ممّا كانت

163
00:13:18,870 --> 00:13:20,260
هل أتخيّل ذلك؟

164
00:13:24,680 --> 00:13:26,030
...تِلك الفتاة

165
00:13:30,510 --> 00:13:31,910
!مرحباً

166
00:13:32,390 --> 00:13:33,680
مرحباً

167
00:13:36,910 --> 00:13:39,130
هل أتيت إلى هنا للرسم؟

168
00:13:39,130 --> 00:13:42,440
أجل. آتي إلى هنا للرسم كلّ يوم

169
00:13:42,440 --> 00:13:44,190
!دعني أرى

170
00:13:48,300 --> 00:13:49,640
...هذا مُذهِل

171
00:13:49,640 --> 00:13:50,990
!هذا مُذهِل

172
00:13:50,990 --> 00:13:53,590
!يعجبني رسمك

173
00:13:53,590 --> 00:13:56,030
كم عمركِ؟ ما اسمكِ؟

174
00:13:56,390 --> 00:13:58,560
!سأبلغ الخامسة قريباً

175
00:13:58,560 --> 00:14:01,610
وحتّى أستطيع كتابة اسمي الآن

176
00:14:01,610 --> 00:14:02,410
انظر

177
00:14:04,210 --> 00:14:06,170
ما اسمك؟

178
00:14:06,170 --> 00:14:07,570
اسمي سيمون

179
00:14:07,840 --> 00:14:09,120
سيمون؟

180
00:14:09,120 --> 00:14:10,430
هل تتذكّرين؟

181
00:14:12,290 --> 00:14:14,760
لحظة... ما الذي يجري؟

182
00:14:14,760 --> 00:14:16,780
من هذان الطفلان؟

183
00:14:17,250 --> 00:14:18,420
هذا غريب جداً

184
00:14:18,420 --> 00:14:22,060
أشعر بحنينٍ بعض الشيء، كما لو أنّني
...رأيتُ هذا من قبل

185
00:14:22,420 --> 00:14:26,130
ويقول ذلك الفتى أنّ اسمه مثل اسمك، سيمون

186
00:14:28,090 --> 00:14:29,320
!فعلتُها

187
00:14:29,320 --> 00:14:32,570
هذه لك. مع أنّها عوجاء قليلاً

188
00:14:33,040 --> 00:14:34,260
شكراً لكِ

189
00:14:34,260 --> 00:14:36,500
هل ستأتي إلى هنا غداً أيضاً؟

190
00:14:36,500 --> 00:14:37,360
أجل

191
00:14:37,360 --> 00:14:39,000
!مرحى

192
00:14:40,890 --> 00:14:43,020
...لكن هذا الوعد

193
00:14:56,950 --> 00:14:58,580
ما-ما هذا؟

194
00:15:10,250 --> 00:15:11,220
!مرحباً

195
00:15:12,310 --> 00:15:15,220
مرحباً. هل تنتظرين الفتى؟

196
00:15:15,220 --> 00:15:16,400
أجل

197
00:15:16,400 --> 00:15:18,230
الفتى الذي قابلتُه البارحة

198
00:15:18,230 --> 00:15:20,860
قال أنّه سيعود

199
00:15:20,860 --> 00:15:22,400
لكن لا أظنّه سيأتي

200
00:15:22,820 --> 00:15:24,610
ماذا؟ لماذا؟

201
00:15:28,570 --> 00:15:31,320
يمكنني رؤية الغد

202
00:15:31,320 --> 00:15:32,130
ماذا؟

203
00:15:32,480 --> 00:15:34,880
ورأيتُ اليوم أيضاً

204
00:15:34,880 --> 00:15:37,530
انتظرتُ طويلاً ولم يأتِ

205
00:15:37,530 --> 00:15:40,660
أقوم بطيّ الأوراق كطائر كركي بنفسي

206
00:15:40,660 --> 00:15:43,200
أحلامي تتحقّق دوماً

207
00:15:43,200 --> 00:15:44,670
وأحلامكِ أيضاً، أليس كذلك؟

208
00:15:45,470 --> 00:15:48,630
لهذا السّبب... سوف تستيقظين قريباً

209
00:15:48,630 --> 00:15:51,130
ما... ما الذي تقولينه؟

210
00:15:52,830 --> 00:15:56,270
قريباً سيرحل ولن يعود

211
00:15:56,270 --> 00:15:57,070
ماذا؟

212
00:16:12,180 --> 00:16:13,590
أين أنا؟

213
00:16:25,820 --> 00:16:26,670
!انتبه

214
00:16:39,710 --> 00:16:41,100
!لا يزال حيّاً

215
00:16:45,620 --> 00:16:46,850
سيمون؟

216
00:16:57,160 --> 00:16:58,260
هل أنتِ بخير؟

217
00:16:58,990 --> 00:17:01,160
...سيمون... ما الذي

218
00:17:01,720 --> 00:17:04,620
كنتِ نائمة هنا طوال الوقت

219
00:17:04,620 --> 00:17:05,460
ماذا؟

220
00:17:05,460 --> 00:17:08,660
لا بدّ وأنّكِ كنتِ مُرهقة أكثر مما توقّعت

221
00:17:08,660 --> 00:17:10,960
بعد عودتكِ إلى المنزل، ينبغي أن ترتاحي

222
00:17:11,650 --> 00:17:13,180
...ا-انتظر

223
00:17:13,180 --> 00:17:15,760
...كانت الأمطار تهطل ورأيتُ حادثاً

224
00:17:15,760 --> 00:17:17,180
...لكن ذلك الفتى كان

225
00:17:17,180 --> 00:17:18,920
كنتِ تحلمين

226
00:17:23,060 --> 00:17:24,230
...سيمون

227
00:17:24,230 --> 00:17:27,390
يؤسفني ذلك، لكن لا أستطيع مرافقتكِ للمنزل

228
00:17:27,390 --> 00:17:28,270
قُد من فضلك

229
00:17:32,130 --> 00:17:35,350
...مستحيل... أعني، كان ذلك

230
00:17:35,350 --> 00:17:38,410
كلّ ذلك... كان حلماً؟

231
00:18:11,520 --> 00:18:15,440
سمعتُ أنّك فشلت في إيقاظ الملِكة يا آريس

232
00:18:15,860 --> 00:18:19,340
"يتطوّر الناس من خلال تفاعلهم مع الآخرين"

233
00:18:19,340 --> 00:18:21,970
هذه نظريّتك، أليس كذلك؟

234
00:18:21,970 --> 00:18:24,470
،البشريّة موهوبة بطبيعةٍ اجتماعيّة

235
00:18:24,470 --> 00:18:28,220
لهذا خلقَتْ مُجتمعاً متعاوناً وتطوّرت

236
00:18:28,220 --> 00:18:30,610
هذه هي الحقيقة البسيطة

237
00:18:30,970 --> 00:18:32,750
يجب علينا أن نتمكّن من الاستفادةِ منها

238
00:18:33,090 --> 00:18:34,320
عظيم

239
00:18:34,320 --> 00:18:38,090
سنرى قريباً فيما إذا كانت نظريّتك صحيحة

240
00:18:42,480 --> 00:18:44,020
لقد حان الوقت

241
00:18:50,210 --> 00:18:53,230
،مهما كانت الحقيقة قاسية

242
00:18:53,230 --> 00:18:56,330
تُقاتِل الملِكة بكل ما أوتيت من قوّة للمضيّ قُدماً

243
00:18:56,950 --> 00:18:58,830
...كما توقّعنا تماماً

244
00:18:58,830 --> 00:19:01,520
لا، بسرعة أكبر حتّى

245
00:19:02,240 --> 00:19:05,750
وفقاً للخطّة، أودّ أن أدعوها إلى عالمِ الحلم

246
00:19:05,750 --> 00:19:07,810
وأعيد ذكرياتها

247
00:19:08,210 --> 00:19:10,780
،لم تكن صحوة كاملة

248
00:19:10,780 --> 00:19:13,670
لكن أنا متيقّنٌ أنّ تِلك القوّة بدأت تتفتّح

249
00:19:14,180 --> 00:19:16,720
ألهذا لم أستطع إبقاء الأمور تحت السّيطرة؟

250
00:19:17,560 --> 00:19:20,740
هذه هي المرّة الأولى التي أشعر فيها
أنّني لن أتمكَّن من التحكُّمِ بها

251
00:19:21,090 --> 00:19:23,870
...نتيجة ذلك، ذلك الحلم

252
00:19:25,130 --> 00:19:27,760
،الفتى الذي فقد والديه في ذلك الحادث

253
00:19:27,760 --> 00:19:30,060
،وكان النّاجي الوحيد

254
00:19:30,440 --> 00:19:35,020
أصبح الإيفولفر الأوّل بفعلِ البشر
عن طريق تلك المُنظّمة

255
00:19:35,370 --> 00:19:37,260
،وكتأثير جانبي

256
00:19:37,260 --> 00:19:39,640
...فقد مشاعره ولون عالمه

257
00:19:39,640 --> 00:19:40,780
أو هذا ما ظنّه

258
00:19:49,160 --> 00:19:53,120
...سيذكّرني لون القمحِ الذهبيّ بكِ"

259
00:19:54,150 --> 00:19:59,600
وصوت الرّياح تهبُّ من فوق حقول القمح
"...هو شيء... أنا سوف

260
00:20:07,480 --> 00:20:10,440
...إذا كان الفتى الذي رأيتُه في الحلم سيمون

261
00:20:10,760 --> 00:20:13,160
هل عاش وحيداً طوال هذا الوقت؟

262
00:20:16,250 --> 00:20:19,920
قريباً سيرحل ولن يعود

263
00:20:20,820 --> 00:20:24,670
هل يُعقل... أنّ سيمون هو من يواجه
خطراً ما هذه المرّة؟

264
00:20:25,600 --> 00:20:27,310
سيمون هو إيفولفر

265
00:20:27,740 --> 00:20:29,840
من المُحتمَل أنّه تعرّض لخطر

266
00:20:30,720 --> 00:20:34,240
،لا أعرف ما الذي تخطِّط له البجعة السوداء

267
00:20:34,240 --> 00:20:35,950
لن أسمح لهم بفعلِ ذلك

268
00:20:37,960 --> 00:20:38,840
!صباح الخير

269
00:20:38,840 --> 00:20:39,930
!يا رئيسة

270
00:20:39,930 --> 00:20:41,720
!هناك أنباء مُبهرة

271
00:20:41,720 --> 00:20:43,380
ا-انتظري يا يوي-تشان

272
00:20:43,380 --> 00:20:45,480
أنّا-سان؟ لمَ كلّ هذا الحماس؟

273
00:20:45,480 --> 00:20:48,690
!فرصة عظيمة باتت بمُتناول أيدينا

274
00:20:48,690 --> 00:20:49,930
فرصة عظيمة؟

275
00:20:58,380 --> 00:20:59,540
...و

276
00:20:59,540 --> 00:21:02,780
أتوا إلينا لتوقيع شراكة عمل

277
00:21:02,780 --> 00:21:03,600
!ماذا؟

278
00:21:03,600 --> 00:21:06,830
!بـ"أتش.بي.أس"، تقصدان "أتش.بي.أس"؟

279
00:21:06,830 --> 00:21:09,120
صاحبة أعلى عدد مُشاهدات لبرامج
المنوّعات الترفيهيّة في أمريكا؟

280
00:21:09,120 --> 00:21:11,610
!شركة البثّ التلفزيونيّ الأمريكيّة الضخمة تلك؟

281
00:21:11,610 --> 00:21:14,690
!لهذا هي أنباء مبهرة

282
00:21:14,690 --> 00:21:19,280
يبدو أنّ المُقابلة الحصريّة تِلك مع كِي
نالَتْ شعبيّةً كبيرة في أمريكا أيضاً

283
00:21:19,280 --> 00:21:22,130
!يريدون التّعاون مع المُنتِجة، أي أنتِ

284
00:21:22,130 --> 00:21:23,340
لا أصدِّق هذا

285
00:21:23,340 --> 00:21:24,770
!هذا غير معقول

286
00:21:26,100 --> 00:21:29,600
برنامج لعِب ومنوّعات ترفيهيّة مُبتكر"
،يتمنّى الجميع مشاهدته

287
00:21:29,600 --> 00:21:32,290
!يرحّب بالضيوف من كلّ طبقات المجتمع

288
00:21:32,790 --> 00:21:35,540
...وأوّل ضيف شهير سيكون

289
00:21:35,540 --> 00:21:40,150
الذي يُشعّ كالمذنّب، والذي أسّس إحدى كبرى
،الشركات من الصّفر

290
00:21:40,150 --> 00:21:44,370
أمير العالم الماليّ الشابّ وحبيب العصر

291
00:21:46,170 --> 00:21:48,750
،الشّخص الذي بات حديث النّاس

292
00:21:49,090 --> 00:21:51,090
!رئيس مجموعة هاروي"؟

293
00:23:21,530 --> 00:23:24,940
...مكان بغيض ينخر قلبي

294
00:23:25,380 --> 00:23:27,990
،وذلك كي يكون عقلكِ وعواطفك حازمة

295
00:23:27,990 --> 00:23:29,920
سأبدِّد مخاوفكِ

296
00:23:29,920 --> 00:23:31,460
،الحلقة السّابعة

297
00:23:31,460 --> 00:23:33,110
"ذكريات مُتّصِلة"