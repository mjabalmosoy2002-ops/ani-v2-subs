1
00:00:00,370 --> 00:00:02,980
!اقتلوا الشّياطين! اهزموا ملك الشّياطين

2
00:00:03,190 --> 00:00:05,730
!تلك السّاحرة الّتي تدّعي أنّها إلهة

3
00:00:05,730 --> 00:00:07,980
!اربطوها! لنربطها

4
00:00:07,980 --> 00:00:10,730
!من سمح لك بصبغ شعرك باللّون الأزرق؟

5
00:00:10,730 --> 00:00:14,990
!مزيّفة! مزيّفة! مزيّفة

6
00:00:14,990 --> 00:00:17,990
!أكوا المزيّفة تهرب

7
00:00:18,470 --> 00:00:20,490
!جدوا أكوا المزيّفة

8
00:00:20,870 --> 00:00:22,750
.أعتقد أنّ مصدر الماء هو المشكلة

9
00:00:23,750 --> 00:00:24,820
.بالفعل

10
00:00:24,820 --> 00:00:28,250
إن كان بإمكاني تطهير ذلك، فستعود
.الينابيع السّاخنة كلّها إلى طبيعتها

11
00:00:28,250 --> 00:00:30,550
!سيوقف هذا الرّائحة العفنة من مصدرها

12
00:00:30,550 --> 00:00:33,130
!ها هي ذي! المدّعية

13
00:00:34,630 --> 00:00:37,890
هل تريدين إنقاذ هؤلاء
!الّذين يتفوّهون بكلّ هذا حقًّا؟

14
00:00:39,010 --> 00:00:42,180
...ولكنّهم مؤمنيّ الأعزّاء

15
00:00:43,520 --> 00:00:46,900
!هيّا، أنا رئيسة كهنة مع كنسية أكسيز

16
00:00:46,900 --> 00:00:49,730
!انظروا لبطاقة المغامر خاصّتي

17
00:00:50,010 --> 00:00:52,650
.لا يمكنك الدّخول سواءً كنتِ رئيسة كهنة أم لا

18
00:00:53,100 --> 00:00:57,280
.أخبرَنا أحد المشرفين بألاّ نسمح لأحدٍ بالدّخول

19
00:00:57,570 --> 00:00:58,780
مشرف؟

20
00:01:00,800 --> 00:01:03,450
...أعضاء مذهب أكسيز المُشرّفين

21
00:01:04,250 --> 00:01:08,080
.من المهمّ أن تفعلوا هذا
.إنّه الشّيء الصّحيح لفعله

22
00:01:08,080 --> 00:01:10,040
—إن تركتونا نمرّ، فهذه المدينة سوف

23
00:01:10,630 --> 00:01:12,420
.نحن تابعو مذهب إيريس

24
00:01:12,420 --> 00:01:13,590
!لماذا؟

25
00:01:13,590 --> 00:01:15,070
!هيّا، دعونا نمرّ

26
00:01:15,070 --> 00:01:17,050
!مصدر الماء في الأعلى في خطر

27
00:01:17,050 --> 00:01:19,680
.أريد إنقاذ هذه المدينة فحسب

28
00:01:17,550 --> 00:01:19,680
.لنرَ كيف سيجري الأمر

29
00:01:19,680 --> 00:01:21,340
.لا تعني لا

30
00:01:21,340 --> 00:01:23,000
.هيّا، عودي

31
00:01:23,000 --> 00:01:24,390
!انتظر

32
00:01:24,390 --> 00:01:26,750
...أنت نوعًا ما، حسنًا

33
00:01:26,750 --> 00:01:28,960
!جذّابٌ نوعًا ما

34
00:01:28,960 --> 00:01:32,440
!مظهرك يبدو كتنّينٍ أحمر، إنّه رائعٌ حقًّا

35
00:01:32,770 --> 00:01:34,900
!أتعنين أنّ وجهي كوجه سحليّة؟

36
00:01:36,380 --> 00:01:40,450
،حسنًا، إن كنت لا تريد تركي أدخل حقًّا

37
00:01:40,720 --> 00:01:43,760
فسأخبر كنيسة أكسيز أنّكم أنتم
يا أعضاء مذهب إيريس

38
00:01:43,760 --> 00:01:45,910
.تقولون أشياءً فظيعةً عن مذهبنا

39
00:01:46,080 --> 00:01:47,660
!ما خطبك؟

40
00:01:47,660 --> 00:01:50,370
مثل هذه الأشياء هي الّتي تجعل
!التّعامل مع مؤمني أكسيز صعبًا

41
00:01:50,370 --> 00:01:53,840
—بالإضافة إلى ذلك، هذا الشّعر الأزرق
ألستِ من قام بتلك الحيلة

42
00:01:53,840 --> 00:01:55,500
!عندما أبدلتِ الينابيع السّاخنة بماءٍ ساخن؟

43
00:01:55,500 --> 00:01:58,840
...لـ-لا، كلّ ما فعلته هو تطهير الينابيع السّاخنة

44
00:01:59,040 --> 00:02:00,270
!أنتِ هي فعلاً إذًا

45
00:02:00,270 --> 00:02:01,720
!لا يمكننا قطعًا أن نتركك تدخلين

46
00:02:01,720 --> 00:02:03,220
!اذهبي من هنا من فضلك

47
00:02:01,720 --> 00:02:03,220
.توقّعت أنّ هذا سيحدث

48
00:02:03,220 --> 00:02:04,260
!انتظر

49
00:02:04,260 --> 00:02:07,040
هيّا يا داركنس، هذه إحدى المرّات
.القليلة الّتي يمكن أن تكوني مفيدةً بها

50
00:02:07,040 --> 00:02:07,950
!ماذا تعني بقليلة؟

51
00:02:07,950 --> 00:02:10,650
!أنا مفيدة في بعض الأحيان كما تعلم

52
00:02:10,650 --> 00:02:12,980
!لا تدفعني! ما الّذي تحاول فعله؟

53
00:02:13,610 --> 00:02:15,480
!انتباه

54
00:02:15,480 --> 00:02:18,330
!هل تدركان من تكون هذه؟

55
00:02:18,330 --> 00:02:22,870
إنّكم بحضور سيّدة من عائلة
!داستينس، داستينس فورد لالاتينا

56
00:02:23,830 --> 00:02:25,790
!هذه حالة طارئة

57
00:02:25,790 --> 00:02:29,760
هيّا يا سيّدتي، أظهري تلك القلادة
!الّتي تخفينها على صدرك كدليل

58
00:02:26,660 --> 00:02:27,510
!أنت

59
00:02:29,760 --> 00:02:31,590
!سيّدتي، توقّفي عن المقاومة

60
00:02:32,450 --> 00:02:34,710
!هيّا أظهريها يا سيّدتي

61
00:02:34,710 --> 00:02:36,550
!ثبّتها يا كازوما

62
00:02:36,840 --> 00:02:38,010
—أنا سوف

63
00:02:38,010 --> 00:02:40,240
!مؤلم، مؤلم! هذا يؤلم يا داركنس

64
00:02:40,240 --> 00:02:43,350
!هيّا يا ويز خذيها بسرعة
!الآن هي فرصتك لأخذ القلادة

65
00:02:43,330 --> 00:02:45,610
!تعالي إلى هنا بسرعة يا ويز أرجوك

66
00:02:45,610 --> 00:02:47,620
!ثبّتي يدها اليمنى يا أكوا

67
00:02:47,620 --> 00:02:50,230
!هيّا يا سيّدتي، اهدئي

68
00:02:48,380 --> 00:02:50,840
!بسرعة يا ويز

69
00:02:50,840 --> 00:02:51,950
!افعليها يا ويز

70
00:02:51,950 --> 00:02:52,700
!سيّدتي

71
00:02:52,700 --> 00:02:54,290
!أنا آسفة جدًّا يا داركنس-سان

72
00:02:54,290 --> 00:02:55,650
!أنا آسفة، أنا آسفة

73
00:02:55,650 --> 00:03:00,120
أنتم! لا يمكن لعائلة داستينس
—أن تمارس سلطتها من أجل

74
00:03:04,050 --> 00:03:05,290
!إنّها حقيقيّة

75
00:03:05,290 --> 00:03:07,040
.نعتذر على الإزعاج

76
00:03:07,340 --> 00:03:08,540
!كونوسوبا

77
00:03:10,560 --> 00:03:12,550
.إنّك مزعجة

78
00:03:12,550 --> 00:03:16,640
هل تريديننا أن نعاملك كنبيلة
!أو كجزء من المجموعة؟ كوني واضحة

79
00:03:16,640 --> 00:03:18,230
!لا تقل عنّي مزعجة

80
00:03:18,230 --> 00:03:20,300
!ألست أصغر منّي يا كازوما؟

81
00:03:22,040 --> 00:03:25,800
أعاملك بهذه الطّريقة لأنّني أراكِ
.كصديقة يا داركنس

82
00:03:26,000 --> 00:03:29,580
صحيح، ليس كنبيلة أكبر سنًّا منّي
،تدعى لالاتينا-ساما

83
00:03:29,580 --> 00:03:31,910
.ولكن كداركنس، محاربة حملاتنا الجديرة بالثّقة

84
00:03:31,910 --> 00:03:34,440
...فـ-فهمت

85
00:03:34,440 --> 00:03:37,110
...في هذه الحالة، أعتقد

86
00:03:37,400 --> 00:03:38,170
.سهلة للغاية

87
00:03:38,170 --> 00:03:39,080
.سهلة جدًّا

88
00:03:39,080 --> 00:03:40,110
.سهلة حقًّا

89
00:03:40,110 --> 00:03:41,610
!يا-يا رفاق

90
00:03:42,620 --> 00:03:43,740
.ها هو

91
00:03:43,740 --> 00:03:45,790
!انظرن، الماء أسود

92
00:03:45,790 --> 00:03:48,950
!إنّه مسمّم، إنّه مسمّمٌ تمامًا

93
00:03:48,950 --> 00:03:54,160
إن كان هذا مؤشّرًا على شيء ما، فإنّ
.مصدر الماء تلوّث مسبقًا على الأرجح

94
00:03:54,160 --> 00:03:55,170
!لنسرع

95
00:04:00,360 --> 00:04:02,050
.انتظرن، يوجد أحدٌ هناك

96
00:04:07,810 --> 00:04:09,260
...هذا

97
00:04:09,670 --> 00:04:11,560
!لا يمكنني ابتلاعه

98
00:04:12,030 --> 00:04:14,230
...سيجعلني نظيفًا جدًّا

99
00:04:15,200 --> 00:04:16,160
...المُنظّف

100
00:04:16,160 --> 00:04:18,890
.يبدو أنّه يفكّر برمي نفسه هناك

101
00:04:18,890 --> 00:04:22,420
.لقد جعله تابعو مذهب أكسيز يعاني كثيرًا

102
00:04:22,420 --> 00:04:23,150
!انتظروا

103
00:04:25,780 --> 00:04:27,200
!انتبه

104
00:04:27,850 --> 00:04:30,740
!لا تفعل شيئًا متهورًا

105
00:04:36,180 --> 00:04:37,130
!كونوسوبا

106
00:04:37,130 --> 00:04:39,530
حسنًا، حسنًا، هل أنتم سيّاح؟

107
00:04:39,530 --> 00:04:42,910
هذه الينابيع السّاخنة تشفي آلام الظّهر
السّفليّة وتيبّس الأكتاف والإرهاق

108
00:04:42,910 --> 00:04:46,410
وتساعد البشرة، دون ذكر الاكتئاب
!والسّلبيّة وكلّ أنواع اللّعنات

109
00:04:46,410 --> 00:04:50,660
يؤمن بها الكثير من المشاهير
!من كلّ أرجاء العالم بقوّة

110
00:04:50,660 --> 00:04:51,610
—لذا ينبغي عليكم أن

111
00:04:52,430 --> 00:04:54,770
...أعتقد أنّي رأيته في مكانٍ ما

112
00:04:54,770 --> 00:04:57,460
!رأيتِني؟ لا يمكن! هذه أوّل مرّةٍ نتقابل فيها

113
00:04:57,460 --> 00:05:01,070
هانس-سان! أنت هانس-سان، أليس كذلك؟

114
00:05:01,280 --> 00:05:04,350
—مـ-من قد يكون هذا؟ أنا واحد من المشرفين

115
00:05:04,350 --> 00:05:08,050
!مرّ وقتٌ طويل يا هانس-سان! إنّها أنا ويز

116
00:05:08,050 --> 00:05:09,750
!ويز اللّيتش

117
00:05:09,750 --> 00:05:11,580
...لا أعلم ما تقصدين

118
00:05:11,930 --> 00:05:16,230
إن كنت أتذكّر، أنت متحوّلٌ هلاميٌّ
سامٌّ مميت، صحيح؟

119
00:05:16,230 --> 00:05:19,590
هل يمكن أن تكون أنت من يسمّم مصدر الماء؟

120
00:05:19,590 --> 00:05:20,130
!هلاميّ

121
00:05:20,130 --> 00:05:22,210
هلاميّ مميت؟

122
00:05:22,490 --> 00:05:26,400
لِمَ تتجاهلني يا هانس-سان؟

123
00:05:26,400 --> 00:05:29,890
!إنّها أنا ويز! هيّا يا هانس-سان! هانس-سان

124
00:05:27,670 --> 00:05:30,540
—ماذا تريدين؟ أنا لا أعرفك

125
00:05:31,470 --> 00:05:32,460
!توقّفي عن هزّي

126
00:05:32,460 --> 00:05:35,880
هل نسيتني؟

127
00:05:35,880 --> 00:05:38,800
—أتذكر، عندما كنّا في قلعة ملك الشّياطين

128
00:05:37,840 --> 00:05:40,230
!كلاّ

129
00:05:40,230 --> 00:05:42,820
—تذكّرت أنّ لديّ عملاً مهمًّا في المدينة

130
00:05:44,450 --> 00:05:46,400
!أين تعتقد أنّك ذاهب يا هانس؟

131
00:05:46,400 --> 00:05:47,020
.صحيح

132
00:05:46,720 --> 00:05:48,530
!لن ندعم تمرّ يا هانس

133
00:05:48,530 --> 00:05:49,260
.نعم

134
00:05:48,960 --> 00:05:51,660
!هل تعتقد أنّ أعذارك ستنفع يا هانس؟

135
00:05:51,660 --> 00:05:52,500
.حسنًا، لا بأس

136
00:05:53,040 --> 00:05:54,870
،لِمَ لا تتوقّف عن المقاومة

137
00:05:54,870 --> 00:05:57,370
!وتكشف عن هويّتك يا هانس؟

138
00:05:58,750 --> 00:05:59,440
!هانس

139
00:05:59,440 --> 00:06:00,610
!سحقًا

140
00:06:00,610 --> 00:06:03,540
!تستمرّون أيّها الأوغاد بمناداة اسمي بلا احترام

141
00:06:03,540 --> 00:06:06,500
!ألم تقولي أنّك ستفتحين متّجرًا يا ويز؟

142
00:06:06,500 --> 00:06:08,760
توقّفي عن العبث عند الينابيع
!السّاخنة واذهبي للعمل

143
00:06:08,960 --> 00:06:10,060
!هـ-هذا فظيع

144
00:06:10,060 --> 00:06:11,910
!إنّي أعمل بجدٍّ حقًّا

145
00:06:11,910 --> 00:06:14,600
،رغم أنّي كلّما عملتُ بجدٍّ أكبر
...بدا أنّ لديّ مالاً أقلّ

146
00:06:15,430 --> 00:06:18,830
...قضيتُ وقتًا طويلاً أفعل هذا بكلّ هدوء

147
00:06:19,270 --> 00:06:25,030
أليس اتّفاقنا أنّك لا تساعدينا
،إلاّ بالحفاظ على الحاجز يا ويز

148
00:06:25,030 --> 00:06:28,110
وعوضًا عن هذا، لا تعارضيننا؟

149
00:06:28,110 --> 00:06:30,950
علاقة دون تطفّل؟

150
00:06:30,950 --> 00:06:32,880
لِمَ تعترضين طريقي إذًا؟

151
00:06:32,880 --> 00:06:35,620
ماذا، أأعترض طريقك؟

152
00:06:35,860 --> 00:06:39,010
!أردت التّرحيب بك فقط لأنّه مرّ وقتٌ طويل

153
00:06:39,010 --> 00:06:40,920
!وهذا اعتراضٌ لطريقي

154
00:06:41,970 --> 00:06:45,690
...عندما أفكّر بكم عانيت بسببك

155
00:06:45,690 --> 00:06:46,920
.استعدّ لدفع الثّمن

156
00:06:47,120 --> 00:06:50,430
ماذا ستفعلين يا ويز؟ هل تريدين قتالي؟

157
00:06:50,890 --> 00:06:53,460
!هؤلاء أصدقائي

158
00:06:53,460 --> 00:06:55,060
ألا يمكننا نقاش هذا؟

159
00:06:55,330 --> 00:06:59,400
!أصبحت جبانة منذ أن أصبحتِ ليتش يا ويز

160
00:06:59,400 --> 00:07:03,200
،عندما طاردتِنا كساحرة عُليا

161
00:07:03,200 --> 00:07:06,320
!لم تتحدّثي عن مناقشة أيّ شيءٍ أبدًا

162
00:07:06,320 --> 00:07:09,510
لم أكن أعير لوجهات نظر الآخرين
—اهتمامًا في ذلك الوقت ولم

163
00:07:09,510 --> 00:07:12,070
تعرفينه يا ويز، أليس كذلك؟

164
00:07:12,790 --> 00:07:16,240
.إنّه خصمٌ صعب على الأرجح، لذا تراجعي

165
00:07:17,770 --> 00:07:19,570
!اسمي ساتو كازوما

166
00:07:20,000 --> 00:07:22,500
!وقتلت الكثير من الخصوم الأقوياء

167
00:07:23,440 --> 00:07:27,730
—كـ-كازوما-سان، أودّ تجنّب القتال ولكن

168
00:07:29,120 --> 00:07:30,840
.هيّا بنا يا رفيقي

169
00:07:30,840 --> 00:07:31,640
.تشونتشونمارو

170
00:07:31,640 --> 00:07:32,550
!كلاّ

171
00:07:33,010 --> 00:07:37,730
حسنًا. على كلّ من عرف هويّتي
الحقيقيّة أن ينحني

172
00:07:37,730 --> 00:07:39,510
...متوسّلاً للرّحمة

173
00:07:39,510 --> 00:07:41,440
.يبدو أنّك شجاع

174
00:07:41,690 --> 00:07:44,860
،ما الّذي تتحدّث عنه؟ إنّك هلاميّ
!أضعف أنواع الوحوش

175
00:07:45,210 --> 00:07:49,140
ذلك السّمّ المميت يعني أنّك تمتلك
،هجماتٍ سامّة على الأرجح

176
00:07:49,140 --> 00:07:51,920
!ولكن لدينا أكوا الّتي تستطيع تطهير السّمّ

177
00:07:51,920 --> 00:07:53,860
!لا أرى إمكانيّة لخسارتنا

178
00:07:54,430 --> 00:07:56,540
...اسمي هانس

179
00:07:56,540 --> 00:07:58,760
.واحدٌ من قادة جيش ملك الشّياطين

180
00:07:58,760 --> 00:08:02,050
.هانس الهلاميّ السّامّ المميت

181
00:08:02,050 --> 00:08:04,380
ماذا قلت للتّوّ؟ قائد في جيش ملك الشّياطين؟

182
00:08:04,380 --> 00:08:08,520
هنالك مكافأة كبيرة على رأس هانس-سان
!حتّى بين ضباط جيش ملك الشّياطين الآخرين

183
00:08:08,520 --> 00:08:10,130
!إنّه قويٌّ جدًّا، لذا احترس

184
00:08:10,440 --> 00:08:13,650
الهلاميّون ضعفاء، أليس كذلك؟
ضعفاء حقًّا؟

185
00:08:13,650 --> 00:08:16,010
من أخبرك بهذا الهراء؟

186
00:08:16,410 --> 00:08:18,220
!الهلاميّون خصومٌ أقوياء

187
00:08:18,220 --> 00:08:20,650
.أوّلاً، الهجمات الجسديّة لا تؤثّر بهم تقريبًا

188
00:08:20,650 --> 00:08:22,770
!يمكنك اعتبار الأمر منتهيًا إن أمسكوا بك

189
00:08:23,000 --> 00:08:26,310
إمّا أن تُذاب بأنزيماتهم الهاضمة
!أو سيخنقونك حتّى الموت

190
00:08:26,310 --> 00:08:27,650
!ما هذا؟! مخيف

191
00:08:27,910 --> 00:08:31,860
بالإضافة إلى ذلك، سمّه سامّ لدرجة
!أنّه يؤثّر على كلّ ينبوع ساخن في المدينة

192
00:08:32,290 --> 00:08:34,110
!اعتبر أنّ الاشتباك معه يعني موتًا فوريًّا

193
00:08:34,110 --> 00:08:35,360
!مـ-موتٌ فوريّ؟

194
00:08:36,870 --> 00:08:38,300
.لا تقلق يا كازوما

195
00:08:38,300 --> 00:08:39,990
!حتّى وإن مُتّ، فأنا هنا

196
00:08:40,500 --> 00:08:44,160
ولكن لا تدعه يأكلك، لا يمكنني
.أن أعيد إحياءك إن كنت مهضومًا

197
00:08:47,320 --> 00:08:52,040
!هيّا، واجهوني أيّها المغامرون الشّجعان

198
00:08:52,040 --> 00:08:54,020
—وأسقطوني أرضًا إن كنتم

199
00:08:54,840 --> 00:08:59,340
!آسف! آسف حقًّا

200
00:09:03,010 --> 00:09:05,270
!لِمَ نهرب؟

201
00:09:05,460 --> 00:09:07,340
!أيّتها الغبيّة! تحرّكي بسرعة

202
00:09:07,340 --> 00:09:10,150
!هذا سيّئ، سيّئ، سيّئ
!إنّه أسوأ من كلّ الآخرين

203
00:09:10,800 --> 00:09:12,960
...الهلاميّ... إنّنا نترك الهلاميّ

204
00:09:12,960 --> 00:09:15,150
!عليك إدراك أنّك ستموتين هذه المرّة يا داركنس

205
00:09:18,720 --> 00:09:19,910
أليس هذا...؟

206
00:09:20,130 --> 00:09:23,410
!اقتلوا الشّياطين! اهزموا ملك الشّياطين

207
00:09:24,660 --> 00:09:27,010
.لننسَ أمر مصدر الماء

208
00:09:27,010 --> 00:09:29,460
من يهتمّ لأمر مذهب أكسيز؟

209
00:09:29,840 --> 00:09:31,580
!ما الّذي تقوله؟

210
00:09:31,580 --> 00:09:34,970
!ستخرب كنيسة أكسيز في هذه المدينة

211
00:09:35,190 --> 00:09:36,470
أليس هذا أمرًا جيّدًا؟

212
00:09:37,640 --> 00:09:40,680
!توقّفوا عن إغاظة أكوا-ساما من فضلكم

213
00:09:40,680 --> 00:09:41,560
!لا يهمّ

214
00:09:47,310 --> 00:09:51,420
هل أنت متأكّد من هذا؟
.ستسوء الأمور بهذا المعدّل

215
00:09:54,710 --> 00:09:56,950
!لا خيار آخر

216
00:10:02,690 --> 00:10:04,200
!أنت

217
00:10:04,650 --> 00:10:07,860
عنصرك هو السّم؟
!لا أحد يحبّ هذا! إنّه كئيب

218
00:10:07,860 --> 00:10:11,210
على الأرجح أنّك انضممت لجيش
!ملك الشّياطين لأنّ لا أحد يحبّك

219
00:10:11,210 --> 00:10:12,410
!والآن، تُب

220
00:10:12,410 --> 00:10:13,210
ماذا؟

221
00:10:13,590 --> 00:10:15,040
!أكوا

222
00:10:15,040 --> 00:10:15,840
!كازوما

223
00:10:17,440 --> 00:10:21,780
كيف تملكون الجرأة على مواجهتي
ثانيةً أيّها الضعفاء؟

224
00:10:22,490 --> 00:10:27,510
على أيّ حال، عندما أنتهي من هذه
.الينابيع السّاخنة، سأفرغ من هذه المدينة

225
00:10:27,510 --> 00:10:28,810
!أخيرًا

226
00:10:28,810 --> 00:10:32,560
!سأتمكّن من مغادرة هذه المدينة المزعجة

227
00:10:32,770 --> 00:10:34,960
...أتفهّم شعورك، ولكن

228
00:10:35,660 --> 00:10:38,700
صحيح! ما الّذي حدث للمشرف الحقيقيّ؟

229
00:10:40,370 --> 00:10:41,320
.أكلتُه

230
00:10:41,620 --> 00:10:43,780
...لحظة... ماذا قلت

231
00:10:43,780 --> 00:10:46,050
!قلت أنّي أكلته

232
00:10:46,050 --> 00:10:49,040
!أنا هلاميّ! الالتهام هو غريزتي

233
00:10:50,880 --> 00:10:51,540
!ويز؟

234
00:10:52,120 --> 00:10:54,950
!السّجن البلوريّ الملعون

235
00:10:58,510 --> 00:11:01,980
...شرط حيادتي هو

236
00:11:01,980 --> 00:11:06,430
.أنّه لا يجب قتل الأشخاص غير المقاتلين

237
00:11:06,670 --> 00:11:07,510
أليس كذلك؟

238
00:11:07,510 --> 00:11:09,850
!ويز! توقّفي! ألغي سحرك

239
00:11:10,310 --> 00:11:14,360
.موت المغامرين في القتال أمرٌ لا مفرّ منه

240
00:11:15,110 --> 00:11:17,590
،إنّهم يقتلون الوحوش

241
00:11:17,590 --> 00:11:20,060
.ويكسبون قوت يومهم بفعل هذا

242
00:11:20,060 --> 00:11:23,370
.يفترض أن يكونوا مستعدّين لمواجهة نهاية مشابهة

243
00:11:23,690 --> 00:11:26,640
،والفرسان كذلك... إنّهم يجمعون الضّرائب

244
00:11:26,640 --> 00:11:29,120
.وعوضًا عن هذا، يحمون المواطنين

245
00:11:29,510 --> 00:11:31,320
،بما أنّهم يستلمون الدّفعات

246
00:11:30,020 --> 00:11:33,120
!هل تنوين قتالي حقًّا يا ويز؟

247
00:11:31,320 --> 00:11:33,760
مشاركتهم في معاركَ حياة وموت
.نتيجة طبيعيّة لذلك

248
00:11:33,120 --> 00:11:35,130
—إن فعلنا هذا

249
00:11:34,430 --> 00:11:35,130
...ولكن

250
00:11:35,130 --> 00:11:37,710
—ستتلوّث كلّ المنطقة حولـ

251
00:11:38,150 --> 00:11:42,220
ولكنّ الرّجل العجوز المشرف على الينابيع
!السّاخنة لم يفعل شيئًا خاطئًا

252
00:11:42,430 --> 00:11:44,470
...ويز تخيفني

253
00:11:44,470 --> 00:11:48,310
...مواجهتي لامرأة كانت معروفة بساحرة الثّلج

254
00:11:48,310 --> 00:11:49,810
!ليس لديّ خيارٌ آخر

255
00:11:53,510 --> 00:11:56,460
...سألتهم كما تأمرني غريزتي

256
00:12:05,570 --> 00:12:06,990
...هذا

257
00:12:09,610 --> 00:12:12,310
!يا له من هلاميّ رائع! هذا مؤسف

258
00:12:12,310 --> 00:12:15,170
إن لم يكن سامًّا، فقد آخذه
!إلى المنزل وأجعله حيواني الأليف

259
00:12:15,560 --> 00:12:18,220
!هل أذاب عقلك؟

260
00:12:26,170 --> 00:12:28,220
!إنّه خطير! عودي إلى هنا

261
00:12:28,690 --> 00:12:32,850
!ما هذا؟ هل هذا ما كان يلوّث الينابيع السّاخنة؟

262
00:12:32,850 --> 00:12:35,560
!تطهير! تطهير! تطهير

263
00:12:35,850 --> 00:12:39,780
!تطهير! تطهير
!إنّه يحرق! إنّه يحرق

264
00:12:39,780 --> 00:12:42,090
!انسي الأمر واهربي

265
00:12:42,090 --> 00:12:45,490
ولكن إن لم أحمي الينابيع
...السّاخنة، فإنّ مؤمنيّ

266
00:12:45,790 --> 00:12:46,470
!انظروا

267
00:12:46,470 --> 00:12:49,740
!الفتاة ذات الشّعر الأزرق كانت تقول الحقيقة

268
00:12:49,740 --> 00:12:51,500
!اقضوا عليه

269
00:12:54,120 --> 00:12:56,000
!شفاء! شفاء! شفاء! شفاء

270
00:12:56,000 --> 00:12:58,130
!إنّه يحرق... يحرق

271
00:12:58,130 --> 00:13:02,540
!تطهير! تطهير! تطهير! تطهير

272
00:13:03,070 --> 00:13:05,380
!يمكنك فعلها يا آنسة

273
00:13:05,380 --> 00:13:06,390
!احترسي

274
00:13:09,790 --> 00:13:11,770
!تراجعوا جميعًا! المكان خطر

275
00:13:11,770 --> 00:13:14,270
!ما الّذي تفعلينه يا تابعة مذهب إيريس الغبيّة؟

276
00:13:15,850 --> 00:13:17,480
!أيّتها التّابعة الشّريرة

277
00:13:19,690 --> 00:13:23,320
سأستخدم سحري الانفجاريّ
!وأفجّره إلى قطعٍ صغيرة

278
00:13:23,320 --> 00:13:26,320
!لا تفعلي! سيلوّث ذلك الجبل كلّه

279
00:13:26,320 --> 00:13:27,300
!سحقًا

280
00:13:27,300 --> 00:13:29,510
!هل هنالك ما يمكنك فعله يا ويز؟

281
00:13:29,510 --> 00:13:33,330
لا يمكنني تثليجه بحجمه هذا
!بقوّة سحري الحاليّة

282
00:13:33,570 --> 00:13:35,580
...إن كان بإمكاننا جعله أصغر بطريقةٍ ما

283
00:13:35,850 --> 00:13:38,260
!لوّثت ينابيعنا السّاخنة

284
00:13:38,260 --> 00:13:41,250
!أيّها المغفّل الحقير

285
00:13:50,150 --> 00:13:52,260
...أعتقد أنّه حتّى الهلاميّون لديهم تفضيلات

286
00:13:52,260 --> 00:13:53,480
!كازوما

287
00:13:53,030 --> 00:13:53,990
ما الخطب؟

288
00:13:53,480 --> 00:13:57,280
ألا يمكنك التّفكير بخطّة خبيثة
!للتّعامل مع هذا كما تفعل عادةً؟

289
00:13:57,280 --> 00:13:59,020
.لا تقولي عنها خبيثة

290
00:14:02,070 --> 00:14:02,920
عظام؟

291
00:14:04,450 --> 00:14:05,840
!إنّه مشرف الينابيع السّاخنة

292
00:14:05,840 --> 00:14:07,530
هل أكله هذا الوغد؟

293
00:14:07,530 --> 00:14:09,020
!سيدفع الثّمن

294
00:14:10,340 --> 00:14:12,580
...لم يهضمه بشكلٍ كامل بعد

295
00:14:13,160 --> 00:14:14,330
!ليس لديّ خيار آخر

296
00:14:15,120 --> 00:14:18,790
يمكنك إعادة إحياء أحد إن لم يكن
!مهضومًا تمامًا، صحيح يا أكوا؟

297
00:14:19,420 --> 00:14:21,790
!ماذا؟ نعم، يمكنني

298
00:14:21,790 --> 00:14:25,300
يمكنك تجميده إن كان أصغر، صحيح يا ويز؟

299
00:14:25,830 --> 00:14:28,430
...نـ-نعم! بنصف حجمه الحاليّ تقريبًا

300
00:14:28,750 --> 00:14:31,890
!ستُشعلينه يا ميغومين! استعدّي

301
00:14:32,220 --> 00:14:35,220
!يمكنني إطلاقه؟! سأطلقه، حسنًا؟

302
00:14:35,780 --> 00:14:38,940
عليّ حماية الجميع من هانس
بينما يتمّ تفجيره، صحيح؟

303
00:14:38,940 --> 00:14:41,620
!تمامًا. أعتمد عليك

304
00:14:43,230 --> 00:14:45,990
عدوٌّ برتبة قائد قد ظهر خلال
...إجازة الينابيع السّاخنة

305
00:14:46,140 --> 00:14:49,990
!سحقًا، ما خطب توازن اللّعبة في هذا العالم؟

306
00:14:49,990 --> 00:14:54,120
!تطهير! تطهير! تطهير! تطهير

307
00:15:05,550 --> 00:15:08,450
!سأكون وجبتك اليوم

308
00:15:13,390 --> 00:15:15,890
...تفجير... تفجير... تفجير

309
00:15:16,140 --> 00:15:20,130
...مستخدمة أمجد وأقوى وأكبر سحرٍ انفجاريّ

310
00:15:20,130 --> 00:15:21,600
...اسمي ميغومين

311
00:15:21,600 --> 00:15:23,340
الضّربة الّتي سُمح لي بإطلاقها

312
00:15:23,340 --> 00:15:25,920
،أتغاضى بها عن قدر أنسبائي

313
00:15:25,920 --> 00:15:28,250
،مُحيلة كلّ أملٍ بالعودة للحياة إلى معاناة

314
00:15:27,830 --> 00:15:29,650
!تطهير! تطهير

315
00:15:28,250 --> 00:15:30,210
!والنّموذج الّذي تُحكم عليه كلّ القوّات

316
00:15:30,160 --> 00:15:31,550
!تطهير

317
00:15:32,040 --> 00:15:35,160
!لم ينتهِ حظّك عندما أتيت إلى هذه المدينة

318
00:15:35,840 --> 00:15:38,910
!بل كان عندما افتعلت شجارًا معنا

319
00:15:43,820 --> 00:15:46,630
!الباقي يعتمد عليكم يا رفاق

320
00:15:52,920 --> 00:15:54,180
...أيّها المخلوق البائس

321
00:15:54,540 --> 00:15:58,970
زامن نفسك مع الدّخان الأحمر
!وكفّر بموجٍ من الدّماء

322
00:15:58,970 --> 00:16:01,820
!اضرب! انفجار

323
00:16:11,450 --> 00:16:13,610
!اتركيني أيّتها التّابعة

324
00:16:11,860 --> 00:16:12,900
!تراجعوا

325
00:16:14,890 --> 00:16:15,870
أيّتها السّيّدة؟

326
00:16:20,060 --> 00:16:23,130
!السّجن البلوريّ الملعون

327
00:16:56,610 --> 00:17:02,170
حمدًا لله أنّي تمكّنت من إيقاف
...هانس قبل أن تنفذ قوّتي السّحريّة

328
00:17:03,690 --> 00:17:04,840
هل انتهى الأمر؟

329
00:17:05,640 --> 00:17:08,690
من كان يعتقد أنّ بإمكانكم
...فعل كلّ هذا

330
00:17:08,690 --> 00:17:09,460
!ماذا؟

331
00:17:17,750 --> 00:17:19,720
.ولكن لم ينتهِ الأمر بعد

332
00:17:19,720 --> 00:17:23,830
!سآكلكم قريبًا وأُشفى

333
00:17:25,480 --> 00:17:27,700
.اهزموا ملك الشّياطين

334
00:17:28,090 --> 00:17:41,950
!اقتلوا الشّياطين! اهزموا ملك الشّياطين

335
00:17:45,470 --> 00:17:49,850
!ضربة الإله

336
00:17:56,340 --> 00:18:00,220
،كنت أتساءل ما الّذي كنتِ تنوين فعله
!ولكن هذا ليس كافيًا لهزيمتي

337
00:18:00,780 --> 00:18:03,790
!أيّتها الكاهنة المثيرة للشّفقة

338
00:18:05,700 --> 00:18:08,510
!أيّتها السّيّدة

339
00:18:09,550 --> 00:18:11,360
!مذهب أكسيز، عقيدتنا

340
00:18:11,690 --> 00:18:13,720
".يمكن لعقيدة أكسيز أن تنجز الأمور"

341
00:18:13,720 --> 00:18:17,860
ولأنّ بإمكانك إنجاز الأمور، حتّى لو لم تسر"
"!على ما يرام، فإنّه ليس خطأك

342
00:18:18,180 --> 00:18:20,620
"!إنّه خطأ المجتمع أنّ الأمور لا تسير على ما يرام"

343
00:18:20,800 --> 00:18:24,120
!يمكنك الهرب من الأشياء غير السّارّة"
"!هذا لا يعني خسارتك

344
00:18:24,380 --> 00:18:27,120
"!لأنّه يُقال أنّ الهرب فوزٌ أحيانًا"

345
00:18:27,320 --> 00:18:29,420
"الإجابة هي أن تستفيق بعد الشّك"

346
00:18:29,420 --> 00:18:31,770
"!هو شيءٌ ستندم عليه، مهما اخترت"

347
00:18:31,770 --> 00:18:33,470
"،إن كنتَ ستندم على هذا في أيّ حال"

348
00:18:33,470 --> 00:18:35,760
"!افعل الأسهل لك حاليًّا"

349
00:18:35,970 --> 00:18:38,260
!ما هذا النّور؟

350
00:18:38,610 --> 00:18:40,620
"!لا تخف من الكبر"

351
00:18:40,620 --> 00:18:44,260
حتّى الإله لا يعلم ما إن كنتَ"
"،ستكون سعيدًا في المستقبل

352
00:18:44,260 --> 00:18:47,020
"!لذا عليك أن تكون سعيدًا الآن على الأقلّ"

353
00:18:47,020 --> 00:18:53,930
!اقتلوا الشّياطين! اهزموا ملك الشّياطين

354
00:18:54,480 --> 00:18:58,660
ذنب تخريب ينابيع مؤمنيّ الأعزاء السّاخنة

355
00:18:58,660 --> 00:19:00,570
!منحَ لك الهلاك الأكيد

356
00:19:00,570 --> 00:19:04,410
!اطلب خلاص الإله وتُب

357
00:19:04,690 --> 00:19:07,410
!اقتلوا الشّياطين! اهزموا ملك الشّياطين

358
00:19:07,740 --> 00:19:08,410
...لا يمكن

359
00:19:08,770 --> 00:19:12,170
!إيريس تحشو صدرها

360
00:19:12,350 --> 00:19:20,680
!ترتيلة الموتى الإلهيّة

361
00:19:24,140 --> 00:19:28,180
—الإلهة البائسة الّتي يقدّسونها

362
00:19:28,510 --> 00:19:29,940
...لا يمكن

363
00:19:30,430 --> 00:19:34,730
!إنّها أنتِ؟

364
00:19:41,970 --> 00:19:43,490
.انتهت المعركة

365
00:19:44,290 --> 00:19:48,940
...بعد المتاعب مع الينابيع السّاخنة، لم يُقدّم لنا

366
00:19:48,940 --> 00:19:50,020
.أيّ امتنان

367
00:19:50,020 --> 00:19:52,550
!عملت بجدّ لتطهيرها

368
00:19:52,550 --> 00:19:54,420
!لِمَ الجميع غاضب؟

369
00:19:55,100 --> 00:19:56,670
،بفضل ترتيلة أكوا الإلهيّة للموتى

370
00:19:57,320 --> 00:20:01,180
كلّ الينابيع السّاخنة في أركانريتيا
.تحوّلت إلى مياهٍ ساخنة عاديّة

371
00:20:00,320 --> 00:20:02,560
!إنّه مجرّد ماء ساخن! إنّه مجرّد ماء ساخن

372
00:20:03,680 --> 00:20:07,630
هدف جيش ملك الشّياطين لقطع
...مصدر دخل مذهب أكسيز

373
00:20:07,630 --> 00:20:10,930
.انتهى بنجاح في النّهاية

374
00:20:11,130 --> 00:20:15,060
...كنّا سنعود بقدرة ويز على الانتقال الآنيّ

375
00:20:15,380 --> 00:20:17,810
،ولكن أُصيبت بقوّة التّطهير

376
00:20:17,810 --> 00:20:19,710
.وما يزال يبدو أنّها ستختفي في أيّ لحظة

377
00:20:20,360 --> 00:20:22,320
!تعالي! تعالي إلى هنا

378
00:20:23,020 --> 00:20:27,280
.لذا عدنا إلى المنزل بعربة ثانيةً

379
00:20:30,010 --> 00:20:32,980
.لم تكن هذه رحلة ينابيع ساخنة في النّهاية

380
00:20:33,720 --> 00:20:35,040
!انظروا

381
00:20:35,230 --> 00:20:36,540
!انظروا هناك

382
00:20:36,760 --> 00:20:38,550
!يمكنني رؤية أكسيل

383
00:20:52,850 --> 00:20:55,810
!الينابيع السّاخنة؟ لا بدّ أنّ هذا رائع

384
00:20:55,810 --> 00:20:56,970
!مرحبًا بعودتكم

385
00:20:56,970 --> 00:20:59,820
!لنشرب في النّقابة اليوم يا كازوما

386
00:21:01,030 --> 00:21:04,250
.مرحبًا بعودتكم. يبدو أنّها كانت رحلةً صعبة

387
00:21:06,850 --> 00:21:08,540
.عدت حيًّا إذًا

388
00:21:09,090 --> 00:21:11,400
...ربّما أنت حقًّا

389
00:21:11,400 --> 00:21:13,320
.لا، لا بدّ وأنّها مخيّلتي

390
00:21:15,200 --> 00:21:16,960
!مرحبًا بعودتكم جميعًا

391
00:21:16,960 --> 00:21:19,590
!الآن يا ميغومين، لنتبارز

392
00:21:19,860 --> 00:21:22,270
كنتِ هنا تنتظرين كلّ يوم، صحيح؟

393
00:21:22,270 --> 00:21:25,470
!لـ-لـ-لا لم أكن كذلك
!صادف أنّي أتيت اليوم فحسب

394
00:21:26,790 --> 00:21:28,220
...ما باليد حيلة

395
00:21:28,540 --> 00:21:30,570
.سأتساهل معك بما أنّه مرّ وقتٌ طويل

396
00:21:30,570 --> 00:21:31,780
ماذا؟ حقًّا؟

397
00:21:31,780 --> 00:21:32,560
.نعم

398
00:21:33,690 --> 00:21:34,840
!عدنا

399
00:21:34,840 --> 00:21:35,600
.مرحبًا بعودتك

400
00:21:35,770 --> 00:21:38,230
!لا شيء أفضل من المنزل

401
00:21:39,500 --> 00:21:41,230
...عندما ينتهي الشّتاء، سيأتي الرّبيع

402
00:21:42,100 --> 00:21:46,160
...أستيقظ هنا، أنام هنا، وأعيش هنا

403
00:21:44,000 --> 00:21:46,990
—حجر، ورقة

404
00:21:46,160 --> 00:21:46,990
.الآن

405
00:21:47,710 --> 00:21:52,080
في هذا العالم غير العادل
...والقاسي جدًّا والرّائع

406
00:21:52,080 --> 00:21:54,570
.فليبارك له الرّب، ولكم أيضًا

407
00:21:54,990 --> 00:21:59,320
!كازوما-سان! الماء السّاخن لا يعمل

408
00:22:00,600 --> 00:22:01,960
!آتٍ

409
00:23:35,420 --> 00:23:37,780
!شكرًا لكم على الدّعم جميعًا

410
00:23:37,780 --> 00:23:40,240
—لم تبدأ معركتنا الحقيقيّة