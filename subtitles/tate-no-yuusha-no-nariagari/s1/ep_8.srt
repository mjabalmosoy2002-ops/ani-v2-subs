!أكلتِها؟

208
00:17:07,630 --> 00:17:08,710
!رافتاليا

209
00:17:09,290 --> 00:17:10,250
أونيتشان؟

210
00:17:10,710 --> 00:17:14,340
.سنعطيها الدواء في العربة ونعود إلى القرية حالًا

211
00:17:14,340 --> 00:17:15,510
.كلا

212
00:17:16,010 --> 00:17:18,300
.علينا التكفل بجثة التنين

213
00:17:18,300 --> 00:17:19,890
!أنتِ أولى

214
00:17:20,350 --> 00:17:22,270
.سأكون بخير

215
00:17:22,270 --> 00:17:25,350
.سأشرب الدواء وأستلقي لفترة

216
00:17:26,230 --> 00:17:28,770
.فيلو، لنسرع بتنظيف هذه الفوضى

217
00:17:28,770 --> 00:17:29,940
!حسنًا

218
00:17:30,900 --> 00:17:34,070
.عادت رياح الجبل إلى طبيعتها

219
00:17:34,070 --> 00:17:35,570
.سنكون بخير الآن

220
00:17:36,280 --> 00:17:38,950
.شكرًا جزيلًا

221
00:17:38,950 --> 00:17:41,330
.استخدم هذا المال لعلاج رافتاليا

222
00:17:41,700 --> 00:17:43,330
.لا يهمني كم سيكلف

223
00:17:43,330 --> 00:17:44,790
.عالجها دون فشل

224
00:17:45,580 --> 00:17:48,370
.سيكون علاجها صعبًا

225
00:17:48,370 --> 00:17:52,250
.لقد أُصيبت بلعنة، لعنة بغاية القوة علاوة على ذلك

226
00:17:52,710 --> 00:17:56,510
،لففناها بضمادات منقوعة في ماء مقدس

227
00:17:56,840 --> 00:18:01,720
.لكنَّنا لا نملك ماءً مقدسًا نقيًا بما يكفي لإزالة اللعنات

228
00:18:02,010 --> 00:18:05,560
.إن ذهبت إلى كنيسة أحد المدن الكبيرة، ستحصل عليه بكل تأكيد

229
00:18:05,560 --> 00:18:08,900
.احتفظ بهذا المال لذلك الوقت

230
00:18:09,810 --> 00:18:10,980
.شكرًا

231
00:18:14,110 --> 00:18:16,610
أأنتِ بخير يا أونيتشان؟

232
00:18:16,610 --> 00:18:18,820
،أجل، عُولجت

233
00:18:18,820 --> 00:18:20,240
.لذا أنا بخير

234
00:18:20,240 --> 00:18:23,530
.لم أكُن أعلم أنَّ الجثث قادرة على إلحاق لعنات قويَّة كهذه

235
00:18:24,450 --> 00:18:26,790
.التنانين مخلوقات مرعبة

236
00:18:27,500 --> 00:18:28,330
.أجل

237
00:18:28,750 --> 00:18:32,250
.ما كان عليَّ أن أتهور كثيرًا وأعرض نفسي لكل ذلك اللحم المتعفن

238
00:18:36,510 --> 00:18:38,680
إنَّه يهتم لأمركِ كثيرًا، أليس كذلك؟

239
00:18:38,680 --> 00:18:40,550
...عـ-عفوًا

240
00:18:40,840 --> 00:18:43,350
.اعتن بنفسكِ يا رافتاليا-سان

241
00:18:45,810 --> 00:18:47,060
.أنا آسف

242
00:18:47,730 --> 00:18:49,230
.لا بأس

243
00:18:49,770 --> 00:18:51,060
...تلك القوة

244
00:18:51,060 --> 00:18:56,070
.خالجني شعور بأنَّها ستأخدك إلى مكان بعيد

245
00:18:56,860 --> 00:19:02,660
.لذا، بما أنَّني نجحت في إيقافك، ما أصابني لا يعد شيئًا

246
00:19:04,870 --> 00:19:08,040
هل ستذهب إلى مكان ما يا سيدي؟

247
00:19:08,040 --> 00:19:09,540
.لن أذهب إلى أي مكان

248
00:19:11,670 --> 00:19:13,750
!لدي هدية لك يا سيدي

249
00:19:15,040 --> 00:19:16,250
ما هذه؟

250
00:19:18,130 --> 00:19:20,760
.بلورة كانت داخل التنين

251
00:19:20,760 --> 00:19:22,720
هل تقيأتها؟

252
00:19:23,470 --> 00:19:26,810
!كلا! احتفظت بهذه كهدية

253
00:19:27,680 --> 00:19:32,810
...إن كانت هذه تبلورًا لبقايا المانا من جثة التنين

254
00:19:39,780 --> 00:19:41,650
مستواي لا يكفي إذن؟

255
00:19:42,240 --> 00:19:45,580
.ذلك الدّرع لم يكن في شجرة الترقية

256
00:19:46,160 --> 00:19:48,490
،لو واصلت استخدام قوته

257
00:19:48,830 --> 00:19:52,920
.لقتلت رافتاليا إضافة لفيلو التي كانت داخل التنين

258
00:19:53,880 --> 00:19:55,460
ناوفومي-ساما؟

259
00:19:56,340 --> 00:19:58,460
.سامحاني

260
00:19:59,300 --> 00:20:04,090
.عرضتكما للخطر آنذاك لأنَّني ترددت

261
00:20:04,760 --> 00:20:09,100
.مثلما تختلف الشجاعة عن التهور، يختلف الحذر عن الجبن

262
00:20:09,640 --> 00:20:12,810
.إن بقيت جبانًا، فسأفشل في حماية الأشياء التي أعزها

263
00:20:13,520 --> 00:20:18,320
.آنذاك، كان عليَّ أن أتقدم وأصرف انتباه التنين

264
00:20:18,730 --> 00:20:20,650
.كان هناك عدَّة أمور أستطيع فعلها

265
00:20:21,030 --> 00:20:23,530
!ليست غلطتك يا ناوفومي-ساما

266
00:20:23,530 --> 00:20:26,280
...لو كنت أقوى

267
00:20:26,280 --> 00:20:27,910
.أنا أخطأت أيضًا

268
00:20:27,910 --> 00:20:30,540
.اندفعت لأنَّني أكره التنانين كثيرًا

269
00:20:31,200 --> 00:20:32,620
...أنتما

270
00:20:38,340 --> 00:20:41,460
،نحن الآن أقوى مما كنَّا عليه أمس

271
00:20:41,460 --> 00:20:43,220
.وسنغدو أقوى غدًا

272
00:20:44,090 --> 00:20:46,180
.لنواصل على هذا المنوال يوميًّا

273
00:20:46,470 --> 00:20:47,890
.أجل. سويًّا

274
00:20:48,300 --> 00:20:49,560
!سأعمل بجد أيضًا

275
00:20:50,720 --> 00:20:51,390
.أجل

276
00:20:51,930 --> 00:20:53,980
!لقد ابتسمت يا سيدي

277
00:20:55,140 --> 00:20:56,690
.صحيح

278
00:20:56,690 --> 00:20:59,440
.ابتسمتَ ابتسامة عادية أخيرًا

279
00:20:59,440 --> 00:21:01,150
حقًّا؟

280
00:21:01,150 --> 00:21:03,700
أجل! أليس كذلك يا أونيتشان؟

281
00:21:03,700 --> 00:21:04,490
!أجل

282
00:21:07,160 --> 00:21:08,740
.تأخر الوقت

283
00:21:08,740 --> 00:21:10,870
.اخلدا للنوم وارتاحا

284
00:21:10,870 --> 00:21:12,290
!حسنًا

285
00:21:15,670 --> 00:21:19,130
هلَّا قضيت الليلة معي؟

286
00:21:19,710 --> 00:21:20,880
أتشعرين بالوحدة؟

287
00:21:20,880 --> 00:21:22,590
.ليس كذلك

288
00:21:22,590 --> 00:21:25,470
.خلت أنَّه لا بأس في أن أكون أنانية قليلًا هذه المرة فقط

289
00:21:25,470 --> 00:21:26,360
...فيلو

290
00:21:27,160 --> 00:21:29,580
.نامي مع رافتاليا الليلة

291
00:21:29,580 --> 00:21:30,860
!حسنًا

292
00:21:31,440 --> 00:21:32,840
تشعرين بالبرد، صحيح؟

293
00:21:33,160 --> 00:21:36,390
...هذا ليس ما قصدته

294
00:21:36,970 --> 00:21:39,750
.انضم إلينا يا سيدي

295
00:21:39,750 --> 00:21:40,700
.لن أفعل

296
00:21:41,940 --> 00:21:43,860
.أنا لست دافئًا

297
00:21:52,270 --> 00:21:53,650
...عليَّ أن أغدو أقوى

298
00:21:55,740 --> 00:21:58,740
.رفقة من تثقان فيَّ

299
00:21:59,680 --> 00:22:01,100
.وسأحميهما

300
00:22:01,990 --> 00:22:04,660
!مهما كلف الأمر