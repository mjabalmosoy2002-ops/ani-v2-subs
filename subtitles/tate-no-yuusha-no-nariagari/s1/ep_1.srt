187
00:11:42,010 --> 00:11:43,840
.يودا ماساتو

188
00:11:42,010 --> 00:11:43,840
.كوداكا إنيتشي

189
00:11:42,010 --> 00:11:43,840
.نوغوشي هيديو

190
00:11:44,720 --> 00:11:45,720
