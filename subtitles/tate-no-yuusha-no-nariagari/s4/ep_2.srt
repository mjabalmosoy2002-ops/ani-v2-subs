1
00:00:02,010 --> 00:00:04,940
هذه الغرفة كبيرة بما يكفي كي ننام فيها جميعاً

2
00:00:05,350 --> 00:00:09,890
لا، هذه الغرفة لك وحدك يا ناوفومي-ساما

3
00:00:09,890 --> 00:00:13,330
!أريد البقاء مع مولايّ

4
00:00:13,330 --> 00:00:16,320
حضّرنا غرفة أخرى لخدَمك

5
00:00:17,190 --> 00:00:20,210
،بالنّسبة لمخطّطاتك لبقيّة اليوم

6
00:00:20,210 --> 00:00:23,960
،حالما ترتاح في غرفتك

7
00:00:23,960 --> 00:00:29,930
سيترتّب عليك تبديل ملابسك بزيّ سيلتفيلت
الرّسميّ لحضور مأدبة اللّيلة

8
00:00:31,200 --> 00:00:33,960
لكن أوّلاً، يجب أن تستحمّ

9
00:00:33,960 --> 00:00:37,930
سأبلغك عندما يصبح الحمّام جاهزاً

10
00:00:35,530 --> 00:00:38,310
يبدو وكأنّهم يريدون التّظاهر بأنّنا غير موجودين

11
00:00:38,310 --> 00:00:43,770
،أجل. هناك بعض الوقت حتّى المأدبة
لذا لنقُم بجولة في أرجاء البلدة

12
00:00:43,770 --> 00:00:46,940
لا، سأبقى في الغرفة المُجاورة

13
00:00:46,940 --> 00:00:50,100
أريد أن أتمكّن من حماية ناوفومي-ساما
في حال وقع مكروه

14
00:00:50,100 --> 00:00:54,520
!ماذا؟ أريد الذّهاب لرؤية البلدة معكِ

15
00:00:55,540 --> 00:00:58,310
أجل، جميعكن، اذهبنَ وتجوّلن في البلدة

16
00:00:58,310 --> 00:00:59,860
!حسناً

17
00:00:59,860 --> 00:01:02,450
أتساءل ما إن كان لديهم خمر لذيذ

18
00:01:02,450 --> 00:01:05,340
!لا أطيق الانتظار! هيّا بنا

19
00:01:05,340 --> 00:01:06,160
...لكن

20
00:01:06,160 --> 00:01:07,170
!لكن

21
00:01:10,120 --> 00:01:12,330
!اتركنَ راف-تشان

22
00:02:47,980 --> 00:02:50,820
،بحسب طريقة تصرّفهم

23
00:02:50,820 --> 00:02:55,020
قد يكون هذا البلد مُزعجاً أكثر ممّا
توقّعت، أليس كذلك يا راف-تشان؟

24
00:02:59,430 --> 00:03:01,320
ما الأمر يا راف-تشان؟

25
00:03:01,930 --> 00:03:04,410
ترس، هنا؟

26
00:03:05,870 --> 00:03:07,390
...ما المهارات الّتي يملكها

27
00:03:07,390 --> 00:03:10,340
تقوية تحوُّل الوحش والإصلاح التّضاريسيّ؟

28
00:03:26,760 --> 00:03:29,720
!يبدو هذا لذيذاً

29
00:03:30,490 --> 00:03:32,490
هذه البلدة رائعة، أليس كذلك؟

30
00:03:34,660 --> 00:03:36,490
!أهلاً وسهلاً

31
00:03:39,360 --> 00:03:44,060
ويبدو أنّهم يحترمون ناوفومي-ساما
بشكل كبير أيضاً

32
00:03:44,630 --> 00:03:46,320
...ناوفومي-ساما

33
00:03:50,580 --> 00:03:52,650
!يبدو هذا لذيذاً أيضاً

34
00:03:52,650 --> 00:03:55,550
!لديهم خمر

35
00:03:55,550 --> 00:04:00,770
ربّما ستبدو منطقة ناوفومي-ساما
هكذا يوماً ما

36
00:04:03,250 --> 00:04:04,000
!حسناً

37
00:04:04,730 --> 00:04:07,620
ماذا؟ أحضروا العدد الخاطئ من كؤوس الماء؟

38
00:04:12,760 --> 00:04:15,870
لهذا السّبب كنت مُتردّداً لمُغادرة القلعة

39
00:04:15,870 --> 00:04:18,770
كان هكذا طوال الوقت الّذي قضيناه
في التجوّل حول البلدة

40
00:04:18,770 --> 00:04:20,810
أخي، أنت متأثّر بالأمر زيادة عن اللّزوم

41
00:04:21,080 --> 00:04:26,450
من الرّائع وجود مُختلف أنواع النّاس
يعيشون معاً

42
00:04:26,450 --> 00:04:29,280
لكن هناك جانب خفيّ من القصّة
لا يظهر للوهلة الأولى

43
00:04:29,570 --> 00:04:34,550
،وعلينا أن ننظر للصّورة بشموليّتها
بما أنّ ناوفومي-تشان لا يستطيع

44
00:04:43,770 --> 00:04:46,200
أتشعرين براحة يا راف-تشان؟

45
00:04:59,990 --> 00:05:01,260
مُثير شهوة؟

46
00:05:03,250 --> 00:05:04,640
ما هذا بالضّبط؟

47
00:05:04,640 --> 00:05:06,320
ما الّذي يجري؟

48
00:05:11,480 --> 00:05:13,150
...بطل

49
00:05:13,150 --> 00:05:20,120
!بطل... بطل التّرس! بطل التّرس

50
00:05:20,120 --> 00:05:21,450
!لحظة، لحظة، لحظة

51
00:05:23,420 --> 00:05:24,850
!ابتعدن

52
00:05:24,850 --> 00:05:26,170
!ترس النّيزك

53
00:05:30,480 --> 00:05:33,370
!افتح يا بطل التّرس

54
00:05:32,060 --> 00:05:34,170
!سأغسل ظهرك

55
00:05:35,320 --> 00:05:36,680
!ترس بوّابة الانتقال

56
00:05:37,720 --> 00:05:38,910
غير مُتاح؟

57
00:05:42,980 --> 00:05:44,090
رافتاليا-تشان؟

58
00:05:44,090 --> 00:05:44,760
هل من مُشكلة؟

59
00:05:44,760 --> 00:05:45,440
ناوفومي-ساما؟

60
00:05:47,860 --> 00:05:50,090
حسناً، لننطلق أيضاً

61
00:05:50,090 --> 00:05:52,320
...أشعر بالتّخمة

62
00:05:51,230 --> 00:05:53,610
!لم ننتهِ من الأكل

63
00:05:54,700 --> 00:05:56,030
!يا بطل

64
00:05:56,030 --> 00:05:58,050
!أريد أن أنجب منك طفلاً

65
00:05:57,130 --> 00:06:00,040
هل هذا ما كانت تتحدّث عنه الملكة؟

66
00:06:00,880 --> 00:06:05,640
أوّلاً، ستتقرّب منك أميرات ونبيلات صغيرات

67
00:06:05,640 --> 00:06:12,170
سيُحاولن تشكيل فريقاً من النّسوة
بمُختلف الأشكال والأنواع

68
00:06:12,550 --> 00:06:14,020
نسوة؟

69
00:06:15,230 --> 00:06:16,490
!تذكّرت

70
00:06:16,940 --> 00:06:20,530
!يا وريد التنّين، لبِّ استجدائي

71
00:06:20,530 --> 00:06:23,020
!كمصدر لقوّتك، آمرك

72
00:06:23,860 --> 00:06:28,860
فكّ شفرة قوانين الطبيعة، وأنشئ وهماً
!لتضليل خصومنا

73
00:06:28,860 --> 00:06:30,820
!الفراغ هو شكل

74
00:06:36,540 --> 00:06:38,620
!بطل التّرس

75
00:06:38,620 --> 00:06:41,910
!يا لك من عنيف

76
00:06:44,590 --> 00:06:46,670
ما الوهم الّذي يرينَه؟

77
00:06:47,570 --> 00:06:50,920
ولحظة، أليستْ "الشّكل هو فراغ"؟

78
00:06:50,920 --> 00:06:53,600
ناوفومي-ساما... هل أنت بخير؟

79
00:06:54,940 --> 00:06:57,870
...سـ-سمعتُ إشارة استغاثة

80
00:06:57,870 --> 00:06:59,430
ما الّذي يجري هنا؟

81
00:06:59,430 --> 00:07:02,190
الأمر كما يبدو فحسب. حالة طارئة

82
00:07:02,190 --> 00:07:05,270
يا إلهي. أرى بأنّك مُستمتع بوقتك

83
00:07:05,270 --> 00:07:07,710
سبقنَني إليك

84
00:07:07,710 --> 00:07:09,900
إنّهن يرينَ وهماً فحسب

85
00:07:10,360 --> 00:07:12,100
لنهرب فحسب

86
00:07:16,180 --> 00:07:18,070
ماذا كان ذلك بالضّبط؟

87
00:07:18,410 --> 00:07:20,570
أعتذر من أعماق قلبي

88
00:07:20,570 --> 00:07:23,980
إنّها خدمة نُوفّرها لبطل التّرس لأجيال

89
00:07:24,530 --> 00:07:26,410
ظننتُك ستستمتع بها

90
00:07:26,690 --> 00:07:28,510
هل تُهينني؟

91
00:07:28,510 --> 00:07:30,090
إطلاقاً

92
00:07:30,510 --> 00:07:32,190
أنا آسف حقّاً

93
00:07:32,190 --> 00:07:34,490
سئمتُ من الأعذار الفارغة

94
00:07:34,490 --> 00:07:38,730
إذا أردت أن تعتذر فعلاً، فأحضر
لي ذلك القارب اللّعين بسرعة

95
00:07:38,730 --> 00:07:40,550
حـ-حاضر

96
00:07:40,780 --> 00:07:44,030
سنعقد مؤتمراً في غضون أيّام
للتّصويت حول المسألة

97
00:07:44,030 --> 00:07:49,150
،إذا كان الأمر سيستغرق كلّ ذلك الوقت
فيمكنني العودة إلى الدّيار بمهارة بوّابة الانتقال الآنيّ خاصّتي

98
00:07:49,150 --> 00:07:50,990
!لا تفعل من فضلك

99
00:07:50,990 --> 00:07:55,230
أمهلني بعض الوقت! أعِدُك
!بأنّني سأحضّره لأجلك

100
00:07:55,230 --> 00:07:56,370
حسناً

101
00:07:56,690 --> 00:07:59,610
لكن لا تنسَ بأنّكم إذا كنتُم ستستمرّون
،في مُعاملتنا بهذه الطّريقة

102
00:07:59,610 --> 00:08:02,570
فسوف نتصرّف من تلقاء أنفسنا

103
00:08:07,200 --> 00:08:11,850
هل يمكنني الوصول إلى كوتين لو
فعلاً بترك الأمر على عاتقه؟

104
00:08:36,730 --> 00:08:40,370
!يا إلهي! كم هذا مُبهر

105
00:08:40,370 --> 00:08:43,480
!أنا متأكّدة بأنّه سيكون زيّاً مُدهشاً

106
00:08:43,480 --> 00:08:46,020
!حدّثني بكلّ شيء عنه يا أخي

107
00:08:47,300 --> 00:08:51,880
،جميعكم، مراسم العبادة قد انتهت

108
00:08:51,880 --> 00:08:56,040
والآن حان الوقت لأمسية مُبهجة
!من العشاء والتّحادُث

109
00:09:04,860 --> 00:09:07,730
أتريدني أن أحضر لك شيئاً خفيفاً لتأكله؟

110
00:09:07,730 --> 00:09:09,260
أجل، شكراً

111
00:09:11,290 --> 00:09:13,360
!سآكل أيضاً

112
00:09:18,020 --> 00:09:21,260
حافظ على هدوئك فحسب يا أخي

113
00:09:21,260 --> 00:09:23,420
آتلا-تشان على حقّ

114
00:09:25,100 --> 00:09:28,630
هذه فُرصة نادرة، لذا علينا أن نفكّر بعقلانيّة

115
00:09:29,160 --> 00:09:30,710
فُرصة لماذا؟

116
00:09:30,710 --> 00:09:32,420
أتتذكّر ما قلتُه في البلدة؟

117
00:09:32,420 --> 00:09:33,790
هناك دوماً جانب خفيّ من القصّة

118
00:09:34,220 --> 00:09:38,080
يُفترض أن يتمّ التّرحيب في هذه
،الأُمسية ببطل التّرس

119
00:09:38,080 --> 00:09:41,380
لكن لا بُدّ من وجود أشخاص هنا
لأسباب أُخرى

120
00:09:41,380 --> 00:09:46,610
فقط ابدأ في البحث عنهم وسرعان
ما ستنتهي هذه الحفلة

121
00:09:47,340 --> 00:09:49,610
هل يمكنني الحصول على شراب آخر؟

122
00:09:50,460 --> 00:09:53,350
...أشخاص هنا لأسباب أُخرى

123
00:09:57,450 --> 00:09:59,090
!يا بطل

124
00:09:59,090 --> 00:10:02,480
هل تستمتع بالحفلة؟

125
00:10:02,980 --> 00:10:06,390
اسمك جاراليس، صحيح؟

126
00:10:06,390 --> 00:10:10,510
شرف لي أن تتذكّر

127
00:10:10,910 --> 00:10:13,190
أرغب في الحديث معك حول
ما ناقشناه قبل مدّة

128
00:10:16,960 --> 00:10:19,000
فول-ساما، آتلا-ساما

129
00:10:22,880 --> 00:10:24,640
أحتاج للحديث معكما

130
00:10:26,170 --> 00:10:27,460
...أنت

131
00:10:38,930 --> 00:10:43,270
مضى سنوات طويلة يا فول-ساما، وآتلا-ساما

132
00:10:43,270 --> 00:10:45,380
...نضجتُما بشكل كبير

133
00:10:45,380 --> 00:10:46,810
...إيثان

134
00:10:46,810 --> 00:10:49,030
أخي، من يكون هذا؟

135
00:10:49,030 --> 00:10:51,490
عملَ إيثان لصالح أبي

136
00:10:51,490 --> 00:10:52,700
بي؟

137
00:10:52,700 --> 00:10:53,850
أجل

138
00:10:53,850 --> 00:10:56,110
،قد لا تتذكّرين

139
00:10:56,110 --> 00:10:59,930
لكن كان يأتي إلى منزلنا ويلعب معنا كثيراً

140
00:11:00,310 --> 00:11:05,880
تُوفّي والداكما ثمّ اختفيتُما

141
00:11:05,880 --> 00:11:08,600
كنتُ قلقاً جدّاً بشأنكما

142
00:11:09,160 --> 00:11:12,490
أشباه البشر النّمر الأبيض غير مُرحّب
بهم كثيراً في هذا البلد

143
00:11:12,490 --> 00:11:16,600
سامحاني على اللّقاء بكما بهذه الطّريقة

144
00:11:16,600 --> 00:11:19,830
...لكن ثمّة أمر أردتُ أن أخبركما عنه

145
00:11:22,790 --> 00:11:25,940
احذروا من جاراليس الأسد

146
00:11:25,940 --> 00:11:30,340
قد يكون مُتورّطاً في وفاة والديكما

147
00:11:31,490 --> 00:11:33,030
جاراليس؟

148
00:11:33,030 --> 00:11:37,090
قيل بأنّه كان حاضراً في اللّحظات
،الأخيرة لوالدكما

149
00:11:37,090 --> 00:11:41,530
لكن انتشرتْ إشاعة في الجيش آنذاك
بأنّ هذا قد لا يكون صحيحاً

150
00:11:41,530 --> 00:11:42,340
قد لا يكون صحيحاً؟

151
00:11:42,600 --> 00:11:43,280
أجل

152
00:11:43,820 --> 00:11:49,000
تقريره عن اللّحظات الأخيرة لتيران-ساما
لم يبدُ منطقيّاً جدّاً

153
00:11:49,450 --> 00:11:53,200
أخبرتُ المسؤولين العسكريّين مراراً بأنّهم بحاجة
...للتحرّي حول الأمر ثانية، كن

154
00:11:54,120 --> 00:11:58,460
لطالما ندمتُ على عدم القتال
،مع تيران-ساما حتّى النّهاية

155
00:11:58,460 --> 00:12:02,230
ندمتُ على عدم القدرة على حمايته

156
00:12:03,390 --> 00:12:09,370
لذا أقلّ ما يمكنني فعله هو مُساعدتكما على ما أعتقد

157
00:12:10,080 --> 00:12:13,410
!سأفعل المستحيل لأجلكما

158
00:12:14,010 --> 00:12:18,510
حسناً، هل تسير الأمور على ما يُرام
مع السيّد فارنر؟

159
00:12:19,620 --> 00:12:21,340
كما توقّعت

160
00:12:21,340 --> 00:12:26,340
إنّه غير معنيّ بما تريده على ما يبدو

161
00:12:26,680 --> 00:12:31,630
يريد أن يُبقيك هنا مهما كلّف الأمر

162
00:12:31,630 --> 00:12:35,240
الرّأي العامّ مهمّ جدّاً بالنّسبة له
في نهاية المطاف

163
00:12:35,240 --> 00:12:36,650
الرّأي العامّ؟

164
00:12:36,650 --> 00:12:40,820
،لأنّ إيمانهم ببطل التّرس راسخ ومتين جدّاً

165
00:12:41,700 --> 00:12:45,330
يسأل النّاس أنفسهم عن سبب
،حمايته للدّول الأُخرى

166
00:12:45,330 --> 00:12:49,130
بما يتعارض مع المكان الّذي ينبغي له
أن يحميه، سيلتفيلت

167
00:12:49,130 --> 00:12:53,060
يزداد النّاس الّذين يقولون ذلك عدداً

168
00:12:54,070 --> 00:12:58,250
والسيّد فارنر قلق جدّاً مؤخّراً
من أن يقوم النّاس

169
00:12:58,250 --> 00:13:01,100
الّذين يُراودهم هذا الشّعور بعمل طائش

170
00:13:01,670 --> 00:13:05,400
...لذا لا يهمّ ما تقوله له

171
00:13:06,940 --> 00:13:10,430
بالتّالي، أرجو منك أن تستخدمني
أنا بدلاً من ذلك

172
00:13:10,770 --> 00:13:14,340
بوسعي ترتيب سفينة فوراً

173
00:13:15,270 --> 00:13:20,650
مع الأسف، لستُ قادراً على فعل ذلك
رسميّاً نظراً لمنصبي الحاليّ

174
00:13:20,650 --> 00:13:26,420
لكن أنا مُستعدّ للتّحايُل المطلوب
لأجل بطل التّرس

175
00:13:26,420 --> 00:13:28,990
أنت إلَهنا، وهذه هي أُمنيتك

176
00:13:29,790 --> 00:13:36,050
السّماح لي بمُساعدتك هو الوسيلة
الوحيدة لإيصالك إلى كوتين لو

177
00:13:42,710 --> 00:13:45,950
يبدو هذا لذيذاً

178
00:13:45,950 --> 00:13:47,040
أجل

179
00:13:47,040 --> 00:13:49,760
صباح الخير يا بطل التّرس

180
00:13:50,090 --> 00:13:56,370
،حبّذا أن تحضر مؤتمراً عقب هذا
...ثمّ سنتناول الغداء، وبعدها

181
00:13:56,370 --> 00:13:58,860
فهمت. فهمت. مُؤتمر إذاً

182
00:14:06,480 --> 00:14:10,670
يظلّ فارنر يوفّر لي خدمة لا معنى لها

183
00:14:10,670 --> 00:14:13,360
واجتماعات عديمة القيمة لإبقائنا في البلد

184
00:14:13,850 --> 00:14:16,770
جاراليس مُحقّ بشأن ذلك على الأقلّ

185
00:14:17,310 --> 00:14:21,820
،لكن طريقة تزلُّف جاراليس لي
لا تروقني إطلاقاً

186
00:14:22,600 --> 00:14:26,910
،بحسب ما قاله كُل من فول وآتلا
يبدو خطيراً

187
00:14:29,840 --> 00:14:32,860
لا يمكن الوثوق بكليهما

188
00:14:32,860 --> 00:14:34,170
...ما يعني

189
00:14:34,890 --> 00:14:37,230
!اتلُ صلواتكم لبطل التّرس

190
00:14:37,470 --> 00:14:40,510
!إرادة إله التّرس تُقرّر كلّ شيء

191
00:14:40,900 --> 00:14:45,230
!بفضله نتلقّى طعامنا وننعم بحياتنا

192
00:14:45,230 --> 00:14:49,320
لندع هذا الطّعام وهذه الحياة تغدو
!قوّة لتطبيق هذه المشيئة

193
00:14:50,560 --> 00:14:52,500
!لندعها تصبح قوّة

194
00:14:52,820 --> 00:14:55,690
يا لها من صلاة رائعة

195
00:14:55,690 --> 00:14:59,740
كُل أوّلاً يا بطل التّرس

196
00:15:04,650 --> 00:15:05,920
...على أيّ حال

197
00:15:06,320 --> 00:15:11,340
أريد الخروج من هذا البلد
المُريب في أسرع وقت

198
00:15:16,480 --> 00:15:19,760
والآن لنبدأ هذا الاجتماع الخاصّ

199
00:15:20,390 --> 00:15:25,030
بينما نسعى لتوسيع وتعزيز جيشنا
،تحضيراً للموجة التّالية

200
00:15:25,030 --> 00:15:29,690
نحتاج لإعادة تنظيم قوّاتنا بوجود
بطل التّرس كنُواة لها

201
00:15:28,840 --> 00:15:30,110
مهلاً لحظة

202
00:15:30,460 --> 00:15:35,680
الموجة التّالية؟ قلتُ لك لن أبقى

203
00:15:35,680 --> 00:15:37,460
نعلم

204
00:15:37,460 --> 00:15:40,240
لهذا نُناقش الميزانيّة المطلوبة

205
00:15:40,240 --> 00:15:44,400
لنطلب من أجود مصنع سُفُن لدينا أن يبني
لك سفينة جديرة ببطل التّرس

206
00:15:43,900 --> 00:15:46,340
!تعلم بأنّ هذا ليس ما أريده

207
00:15:48,030 --> 00:15:51,940
أتفهّم رغبتك في استخدامي

208
00:15:51,940 --> 00:15:55,830
لتوسيع جيشك وتوحيد شعبك

209
00:15:57,240 --> 00:16:02,730
لكن مثلما تريد حماية بلدك، أريد
!حماية بلادي

210
00:16:02,730 --> 00:16:06,030
في هذه اللّحظة، شعب قريتي
!ينتظرون عودتي

211
00:16:06,520 --> 00:16:07,890
...لكن

212
00:16:08,350 --> 00:16:11,870
،حالما يتمّ التّعامل مع العنقاء وكوتين لو

213
00:16:11,870 --> 00:16:15,320
لا أمانع أن أؤدّي واجبي كبطل التّرس قليلاً

214
00:16:18,790 --> 00:16:20,910
مُبهر يا بطل

215
00:16:20,910 --> 00:16:25,120
ينبغي للحاكم الحقيقيّ أن يضع
الأولويّة دوماً لبلاده وشعبه

216
00:16:25,120 --> 00:16:31,090
أتعلّم الكثير منك

217
00:16:31,410 --> 00:16:38,440
!أريدك أيضاً أن تحكم سيلتفيلت وتوحّد شعبه

218
00:16:38,440 --> 00:16:45,630
لكن ليس من الصّواب أن يعصي شعبُ
سيلتفيلت رغبة بطل التّرس

219
00:16:45,630 --> 00:16:49,360
ألا ينبغي أن نحضّر سفينة فوراً؟

220
00:16:49,360 --> 00:16:54,370
وحدهم مُمثّلو الأعراق العُظماء الأربعة
!من يُسمَح لهم بالتكلُّم في هذا المُؤتمر

221
00:16:54,370 --> 00:16:56,950
!اِلزَم مكانتك يا جاراليس

222
00:16:58,800 --> 00:17:01,290
أعتذر يا حضرة البطل

223
00:17:01,610 --> 00:17:05,020
مشاعرك قيّمة جدّاً بالنّسبة لنا

224
00:17:05,020 --> 00:17:09,850
من فضلك أمهلنا وقتاً حتّى
نتأقلم مع رأيك وأفكارك

225
00:17:09,850 --> 00:17:11,740
...تأخير آخر

226
00:17:12,090 --> 00:17:14,460
إلى أيّ درجة أنت عنيد؟

227
00:17:23,140 --> 00:17:24,250
!ناوفومي-ساماا

228
00:17:24,250 --> 00:17:24,950
ماذا؟

229
00:17:24,950 --> 00:17:27,350
لنفعل هذا بسرعة في ظلّ غياب الجميع

230
00:17:29,200 --> 00:17:30,710
!بطل التّرس

231
00:17:30,710 --> 00:17:32,120
هذا إيثان، الّذي كنتُ أحدّثك عنه

232
00:17:32,690 --> 00:17:37,380
شرف لي أن ألتقيك شخصيّاً

233
00:17:37,380 --> 00:17:40,580
مهما شكرتُك على إنقاذ فول-ساما
وآتلا-ساما لا أوفيك حقّك

234
00:17:40,930 --> 00:17:46,720
...سأردّ هذا الدَّين ولو كلّفني ذلك حياتي

235
00:17:46,720 --> 00:17:47,830
هذا يكفي

236
00:17:47,830 --> 00:17:50,050
فعلتُ ذلك لأسبابي الخاصّة

237
00:17:50,660 --> 00:17:53,790
الأهمّ، أخبرك فول، صحيح؟

238
00:17:53,790 --> 00:17:56,370
أجل. تريدني أن أراقبهما، صحيح؟

239
00:17:56,640 --> 00:18:00,990
أجل. كلّاً من فارنر وجاراليس وصلا
،إلى طريق مسدود

240
00:18:00,990 --> 00:18:04,600
وقد يقومان بعمل طائش لكسر الجمود

241
00:18:05,200 --> 00:18:07,720
شارك أي معلومة تحصل عليها مع هؤلاء

242
00:18:07,720 --> 00:18:08,640
!مرحباً

243
00:18:08,640 --> 00:18:09,940
!سُرِرتُ بلقائك

244
00:18:09,940 --> 00:18:13,170
أريد حسم كلّ هذه الأمور في غضون أيّام

245
00:18:16,960 --> 00:18:19,780
...سطحيّاً، سايرتُهم

246
00:18:20,370 --> 00:18:22,750
بينما كنتُ أستعدّ سرّاً...

247
00:18:24,050 --> 00:18:26,790
...وذلك كي أكون جاهزاً ما إن تسنح الفُرصة

248
00:18:28,980 --> 00:18:32,980
وهكذا مضتْ أيّامي في سيلتفيلت

249
00:18:45,790 --> 00:18:47,790
!لا أريد أن آكل هذه

250
00:18:47,790 --> 00:18:52,060
حقّاً؟ سأتناول أيّ شيء إذا
!أعطوني بيرة معه

251
00:18:52,060 --> 00:18:52,770
...لكن هذا

252
00:18:52,320 --> 00:18:55,570
!إرادة إله التّرس تُقرّر كلّ شيء

253
00:18:55,570 --> 00:18:59,360
!بفضله نحصل على طعامنا وننعم بحياتنا

254
00:18:59,750 --> 00:19:03,910
لندع هذا الطّعام وهذه الحياة تغدو
!قوّة لتطبيق هذه المشيئة

255
00:19:03,910 --> 00:19:05,610
!لندعها تصبح قوّة

256
00:19:05,980 --> 00:19:08,830
والآن كُل من فضلك يا بطل التّرس

257
00:19:30,620 --> 00:19:33,180
حضرة البطل، ما هذا؟

258
00:19:33,180 --> 00:19:34,940
!اصمت واشربه بسرعة

259
00:19:34,940 --> 00:19:37,900
مذاقه مُقزّز، لكن هذا أفضل
!من الموت بفعل السُّمّ

260
00:19:37,900 --> 00:19:38,650
!سُمّ

261
00:19:40,780 --> 00:19:42,690
...يتظاهر بالجهل

262
00:19:42,690 --> 00:19:45,780
!إنّ تسميم إله هو جريمة تستحقّ الإعدام

263
00:19:45,780 --> 00:19:47,280
!إنّها الخيانة العُظمى

264
00:19:48,610 --> 00:19:51,570
ما الخطب؟ هل لديك شيء لتقوله لي؟

265
00:19:52,590 --> 00:19:58,620
.يبدو أنّنا بحاجة لنتكلّم جميعاً
أنتما تُحبّان النّقاش، أليس كذلك؟

266
00:20:03,140 --> 00:20:06,350
لا أصدّق بأنّ شخصاً حاول تسميمي

267
00:20:06,350 --> 00:20:09,150
ظننتُ بأنّ هذا البلد آمن

268
00:20:09,150 --> 00:20:12,270
!أنا متأكّد بأنّك أنت من فعلها يا جاراليس

269
00:20:12,270 --> 00:20:15,960
!لا يوجد سواك يخون إلَهنا

270
00:20:15,960 --> 00:20:19,530
لا يمكنك قول هذا من دون دليل

271
00:20:19,530 --> 00:20:26,000
أليس من المُمكن أن تكون قد فعلتَ ذلك
وأنت على علمٍ بأنّ البطل سيُغادر بلادنا؟

272
00:20:26,000 --> 00:20:26,980
ماذا؟

273
00:20:27,970 --> 00:20:31,200
حسناً، لا يهمّني من فعل ذلك

274
00:20:31,530 --> 00:20:34,390
حاول شخصٌ تسميمنا

275
00:20:34,390 --> 00:20:36,480
هذا كلّ ما يهمّ

276
00:20:36,480 --> 00:20:39,670
لا أستطيع التّعاون مع بلد كهذا بعد الآن

277
00:20:40,110 --> 00:20:42,130
حصلتُ على وسيلة لركوب قارب

278
00:20:42,710 --> 00:20:45,430
سئمتُ من التّعامل معكم

279
00:20:45,430 --> 00:20:47,610
...لحظة يا بطل التّرس! أرجوك

280
00:20:47,610 --> 00:20:50,170
أنا حزين لأجلك

281
00:20:50,170 --> 00:20:56,410
أزعجتَ إلَهنا وفقدتَ فُرصة للتّعاون معه

282
00:20:56,410 --> 00:20:59,750
هذا فشل ذريع يا سيّد فارنر

283
00:20:59,750 --> 00:21:01,520
!اِلزَم حدودك يا جاراليس

284
00:21:01,520 --> 00:21:03,980
!دائماً ما تُخطّط لأعمال رخيصة

285
00:21:03,980 --> 00:21:10,420
،إن كنتَ تُلمّح إلى أنّني مسؤول عن هذا
فآمل أن يكون لديك دليل ما

286
00:21:10,420 --> 00:21:13,660
تصرّفاتك حتّى الآن هي كلّ
!الدّليل الّذي أحتاجه

287
00:21:13,660 --> 00:21:16,590
!أنت تفعل المُستحيل لكسب النّفوذ

288
00:21:16,590 --> 00:21:19,040
!لستُ الوحيد الّذي رأى ذلك

289
00:21:19,040 --> 00:21:20,550
!هذا صحيح

290
00:21:19,630 --> 00:21:20,730
!معه حقّ

291
00:21:20,730 --> 00:21:21,640
!أيّها الجبان

292
00:21:20,930 --> 00:21:21,990
!ينبغي أن تخجل من نفسك

293
00:21:21,990 --> 00:21:27,310
تلوم الآخرين لأنّ منصبك في خطر

294
00:21:27,310 --> 00:21:30,980
أهكذا ينبغي أن يكون الحاكم حقّاً؟

295
00:21:31,360 --> 00:21:35,540
هذا ما يحدث عندما تدع السّلالة
تكون الشّيء المُهمّ الوحيد

296
00:21:35,540 --> 00:21:40,060
هناك الكثير من الأشخاص الموهوبين
خارج الأعراق العُظماء الأربعة

297
00:21:41,560 --> 00:21:44,020
!لا تقلْ لي بأنّك تُشير إلى نفسك؟

298
00:21:44,020 --> 00:21:45,490
ماذا؟

299
00:21:45,490 --> 00:21:47,230
!اصمت أيّها الأسد

300
00:21:46,690 --> 00:21:48,870
!جاراليس-ساما على حقّ

301
00:21:47,380 --> 00:21:48,870
!فارنر-ساما على حقّ

302
00:21:49,990 --> 00:21:52,070
!اصمت أيّها العجوز

303
00:21:52,770 --> 00:21:55,120
!اصمتوا جميعاً

304
00:22:01,610 --> 00:22:04,380
!لقد سئمتُ من هذا