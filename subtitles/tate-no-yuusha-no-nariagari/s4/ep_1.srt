1
00:00:12,660 --> 00:00:15,250
اسمي إيواتاري ناوفومي

2
00:00:15,250 --> 00:00:17,620
،كنتُ مُجرّد طالب كلّية عاديّ

3
00:00:17,620 --> 00:00:19,760
حتّى جاء اليوم الّذي استُدعيتُ
فيه إلى عالم آخر

4
00:00:19,760 --> 00:00:23,500
والآن أنا بطل التّرس، أحد الأبطال القدّيسين الأربعة

5
00:00:24,170 --> 00:00:26,360
،لطالما كان الأبطال الأربعة على خِلاف

6
00:00:26,360 --> 00:00:29,370
لكن وصلنا الآن أخيراً إلى المرحلة الّتي
قد نتمكّن فيها من التّعاون معاً

7
00:00:36,630 --> 00:00:39,610
قد أرسلَ مغتالين إلى منطقتي

8
00:00:40,130 --> 00:00:45,450
ارتدتْ رافتاليا زيّ ميكو الّذي يشبه
الملابس الّتي يرتديها إمبراطورهم

9
00:00:45,450 --> 00:00:47,410
وهذا كلّ السّبب الّذي احتاجوه

10
00:00:55,080 --> 00:01:01,330
،والآن أنا في طريقي إلى سيلتفيلت
المكان الّذي يحتوي على قوارب مُنتظمة إلى كوتين لو

11
00:01:01,330 --> 00:01:03,560
من أجل تلقين الحمقى درساً

12
00:01:05,400 --> 00:01:08,650
،اليوم الّذي يتمّ إحياء العنقاء فيه قد اقترب

13
00:01:09,050 --> 00:01:15,600
،لكن قبل أن يحين، أريد حلّ هذه المُشكلة
والّتي ستُحدّد مُستقبل رافتاليا

14
00:01:20,070 --> 00:01:23,760
أجل، أعتقد حان الوقت لنأخذ استراحة

15
00:01:39,170 --> 00:01:40,790
شكراً يا غايليون

16
00:01:40,790 --> 00:01:42,960
...أنا بخـ

17
00:01:44,720 --> 00:01:46,680
اقتربنا من الحدود

18
00:01:46,680 --> 00:01:50,330
يجب أن أعود إلى أرضي
وأُعيد تنظيم قوّاتي

19
00:01:52,070 --> 00:01:53,040
غايليون؟

20
00:01:53,310 --> 00:01:54,250
ماذا؟

21
00:01:55,070 --> 00:01:57,590
!درايفا آكوا بلاست

22
00:02:06,570 --> 00:02:08,710
!مولايّ

23
00:02:09,300 --> 00:02:10,230
ماذا؟

24
00:02:10,230 --> 00:02:11,940
فيلو؟ راف-تشان؟

25
00:02:12,410 --> 00:02:15,060
مهلاً! لماذا تفعلين هذا؟

26
00:02:15,300 --> 00:02:17,540
!أنا من ينبغي أن يقول لكِ ذلك يا ميلتي

27
00:02:17,540 --> 00:02:20,020
ماذا تفعلين هنا؟

28
00:02:20,020 --> 00:02:22,650
أنت من طلب منّا الذّهاب للتّدريب

29
00:02:22,650 --> 00:02:26,150
رغم ذلك، مُصادفة كبيرة
أن تلتقي بي هنا

30
00:02:26,150 --> 00:02:27,810
...في الواقع

31
00:02:27,810 --> 00:02:32,290
،في الحقيقة، عندما كنّا نتدرّب
التقينا بفيتوريا

32
00:02:32,700 --> 00:02:33,800
فيتوريا؟

33
00:02:33,800 --> 00:02:37,680
،وقالت بأنّنا إذا سلكنا هذا الطّريق
فسوف نلتقي بك

34
00:02:37,680 --> 00:02:41,040
وقالت بأنّ لديها طلب منّا لننقله إليك

35
00:02:41,310 --> 00:02:42,710
حسناً، يمكنكِ أن تحدّثيني عنه لاحقاً

36
00:02:42,710 --> 00:02:46,460
لديّ مُشكلة أهمّ الآن

37
00:02:48,260 --> 00:02:50,560
،لكن يا ناوفومي

38
00:02:50,560 --> 00:02:54,850
قالت بأنّها ستدفع مُقدّماً، وفعلَتِ
الكثير لأجلنا بالفعل

39
00:02:54,850 --> 00:02:55,950
لا أُبالي

40
00:02:55,950 --> 00:02:57,910
لم تفعل شيئاً لي

41
00:02:57,910 --> 00:02:59,270
حسناً؟

42
00:02:59,270 --> 00:03:04,350
،مُقابل تخفيض مُستوياتنا
!حسّنتْ إحصائيّاتنا

43
00:03:05,160 --> 00:03:06,990
!تضاعفَتْ وأكثر

44
00:03:06,990 --> 00:03:10,310
أصبحتْ كإحصائيّاتي عندما تحدّيتُ
سُلحفاة الرُّوح

45
00:03:11,300 --> 00:03:12,870
لا، لا يهمّ

46
00:03:16,250 --> 00:03:18,050
!انتظر يا ناوفومي

47
00:03:18,050 --> 00:03:20,590
...ساعدَتْنا أيضاً في كسب فئة جديدة

48
00:03:20,590 --> 00:03:23,020
ساعديها أنتِ إذاً

49
00:03:23,020 --> 00:03:24,940
!لا أستطيع

50
00:03:24,940 --> 00:03:29,640
في الواقع، قالت بأنّه لا بُدّ
!أن أكون أنا وأنت

51
00:03:31,200 --> 00:03:33,030
هل تتكلّمين معها الآن؟

52
00:03:33,030 --> 00:03:34,030
أجل

53
00:03:35,450 --> 00:03:36,690
هكذا إذاً

54
00:03:36,690 --> 00:03:38,510
أنت طريقك إلى كوتين لو إذاً

55
00:03:38,510 --> 00:03:43,650
ويقول مولايّ، "إذا تجاهلتُ
،طلبك على أيّ حال

56
00:03:43,650 --> 00:03:46,760
"هل ستقتلين الأبطال القدّيسين؟

57
00:03:48,110 --> 00:03:50,360
حسناً. سأنتظر

58
00:03:50,810 --> 00:03:53,210
لكن لا تلوموني إذا ندمتُم على ذلك لاحقاً

59
00:03:53,620 --> 00:03:55,840
"يقول "لا يهمّ

60
00:04:10,440 --> 00:04:12,210
...سيلتفيلت

61
00:05:58,020 --> 00:06:00,930
،مُحاكاتي لتقنيّة هينغين موسو السرّية

62
00:06:00,930 --> 00:06:03,200
!الوضعيّة الأولى: الشّمس

63
00:06:09,300 --> 00:06:12,200
كيف تستطيع آتلا-سان فعل ذلك؟

64
00:06:12,200 --> 00:06:14,270
!مُذهل يا آتلا

65
00:06:14,270 --> 00:06:18,680
تقول إكلير بأنّ لديها موهبة في هينغين موسو

66
00:06:18,680 --> 00:06:20,650
يجب أن أبذل قصارى جهدي أيضاً

67
00:06:20,650 --> 00:06:23,930
!بطل التّرس وفريقه قد عادوا

68
00:06:28,590 --> 00:06:31,610
سنصل إلى حدود سيلتفيلت غداً

69
00:06:32,060 --> 00:06:34,320
حالما نجتاز الحدود، سنقطع طريقنا برّاً

70
00:06:34,320 --> 00:06:36,570
هل هذا يعني بأنّه عليّ جرّ العربة؟

71
00:06:36,570 --> 00:06:40,910
أجل. لكن لا يمكننا أخذ العربة
عبر بوّابة الانتقال الآنيّ

72
00:06:40,910 --> 00:06:43,100
ميلتي، هل يمكنكِ الاتّصال بالملكة

73
00:06:43,100 --> 00:06:45,710
والطّلب منها تحضير عربة
بالقرب من نقطة تفتيش الحدود؟

74
00:06:46,020 --> 00:06:48,360
تتكلّم وكأنّ الأمر سهل

75
00:06:48,930 --> 00:06:50,990
سأسأل على ما أعتقد

76
00:06:52,100 --> 00:06:53,920
عُلِم، حسبما أعتقد

77
00:06:54,780 --> 00:06:57,520
إذاً فيلو قادمة، لكن مَن أيضاً؟

78
00:06:57,520 --> 00:06:59,770
إنّه بلد أشباه بشر

79
00:06:59,770 --> 00:07:03,820
أخذ شخص من عائلة ميلرومارك الملكيّة
مثل ميلتي خطأ غالباً

80
00:07:03,820 --> 00:07:05,920
!أعلم ذلك

81
00:07:05,920 --> 00:07:08,580
لكن هل يمكنك أن تدعني مسؤولة
عن منطقتك، اتّفقنا؟

82
00:07:08,580 --> 00:07:10,150
شكراً

83
00:07:10,150 --> 00:07:11,690
ماذا عن فول وآتلا؟

84
00:07:13,100 --> 00:07:15,330
لم يُفوّتا يوماً تدريبيّاً واحداً

85
00:07:15,830 --> 00:07:17,990
إنّهما يزدادان قوّة طوال الوقت

86
00:07:35,410 --> 00:07:39,440
ماذا سيحدث إن لم تأخذهما يا ترى؟

87
00:07:39,880 --> 00:07:43,620
ستيلفيلت هي موطنهما أيضاً

88
00:07:44,060 --> 00:07:47,240
لذا قد يكونان نافعين من هذه النّاحية

89
00:07:47,240 --> 00:07:49,660
ناوفومي، ماذا عنّا؟

90
00:07:49,980 --> 00:07:55,240
أرغب في مجيئكم، لكن لعناتكم
لم تُشفَ تمامأً بعد

91
00:07:55,240 --> 00:08:00,850
كلتاهما ذهبتا للاستحمام في ينابيع
كار مينا السّاخنة مراراً

92
00:08:00,850 --> 00:08:04,620
الأمر يفلح، لكن يستغرق بعض
الوقت رغم ذلك

93
00:08:04,620 --> 00:08:09,340
فهمت. احرصوا على أن تكونوا جاهزين
للانطلاق عند إحياء العنقاء

94
00:08:09,340 --> 00:08:10,650
عُلِم

95
00:08:11,390 --> 00:08:14,590
!سأساعدكما في التحسّن في أسرع وقت

96
00:08:15,720 --> 00:08:22,380
إذاً ستتكوّن فرقتنا منّي ورافتاليا وفيلو
وسادينا وفول وآتلا

97
00:08:23,910 --> 00:08:26,040
وأنت أيضاً يا راف-تشان بالطّبع

98
00:08:27,560 --> 00:08:31,890
حسناً، هل شنّ أحدٌ من مغتالي
كوتين هجوماً أثناء غيابي؟

99
00:08:31,890 --> 00:08:33,790
...في الواقع، بخصوص ذلك

100
00:08:33,790 --> 00:08:36,610
لم يحدث شيء منذ ذلك الهجوم الأوّل

101
00:08:36,610 --> 00:08:37,570
ماذا؟

102
00:08:37,570 --> 00:08:39,270
...أشخاص من

103
00:08:39,270 --> 00:08:43,100
أشخاص من عالم مولايّ ينبغي
أن يستهدفوا هذه القرية أيضاً

104
00:08:43,100 --> 00:08:45,040
لكن لا أثر لهم

105
00:08:45,410 --> 00:08:47,420
ما الّذي يجري؟

106
00:08:47,420 --> 00:08:50,040
هل جميعهم حذِرون لأنّ كشّافيهم
قد أُبيدوا بالكامل؟

107
00:08:50,040 --> 00:08:52,000
...آمل ذلك على الأقلّ

108
00:08:52,340 --> 00:08:56,880
أرغب في المُساعدة على الأقلّ
...في التّعامل مع أي مُهاجم

109
00:08:56,880 --> 00:08:59,100
لكن لا أثر لهم

110
00:08:59,420 --> 00:09:02,090
أعتقد سننتظر رؤية ما سيفعلونه

111
00:09:02,090 --> 00:09:06,570
ولكن إلى أين هرب موتوياسو، وما الّذي يفعله؟

112
00:09:06,570 --> 00:09:09,810
حتّى بغرابة أطباعه، من المُفيد انضمامه

113
00:09:12,810 --> 00:09:16,880
كيف تجرؤون على غزو بلاد والد زوجتي؟

114
00:09:17,540 --> 00:09:21,780
بالإضافة إليكم، كان هناك أيضاً
بعض الأشخاص بلباس نينجا

115
00:09:22,210 --> 00:09:24,000
،لكن لأجل والد زوجتي

116
00:09:24,000 --> 00:09:26,490
!ولأجل فيلو-تان

117
00:09:26,490 --> 00:09:29,710
!سأدمّر روحكم بحدّ ذاتها

118
00:09:29,710 --> 00:09:32,830
!لحظة! لا أريد الموت أمام غريب أطوار

119
00:09:32,830 --> 00:09:33,750
!وداعاً

120
00:09:37,480 --> 00:09:41,850
والآن، سأطبّق العدالة على المجموعة
!التّالية من الأشرار

121
00:09:49,960 --> 00:09:52,480
ما رأيك بالعربة يا فيلو؟

122
00:09:52,480 --> 00:09:55,300
!أعتقد بأنّه مصنوعة من خشب مُختلف

123
00:09:55,300 --> 00:09:57,700
هل الخشب يُشكّل ذلك الفرق الكبير؟

124
00:09:58,480 --> 00:10:00,290
كلّ نوع منهما جيّد بطريقته الخاصّة

125
00:10:00,290 --> 00:10:01,970
ماذا؟

126
00:10:02,750 --> 00:10:04,910
!بطل التّرس

127
00:10:03,860 --> 00:10:06,210
...ثمّة تجمُّع لحشود

128
00:10:06,530 --> 00:10:12,240
ربّما انتشرت الإشاعة بأنّنا قادمون
عندما تُجهّز الملكة هذه العربة

129
00:10:12,870 --> 00:10:14,420
ابقوا يقظين

130
00:10:14,740 --> 00:10:15,420
عُلِم

131
00:10:15,420 --> 00:10:20,420
لِمَ لا نأخذ استراحة جميعاً
ونتناول مشروباً؟

132
00:10:27,820 --> 00:10:31,270
أحمل تقريراً لك، جلالتك

133
00:10:32,030 --> 00:10:38,480
فرقة الإمبراطورة المُزيّفة قد عبرت
الحدود للتو إلى داخل ستيلفيلت

134
00:10:40,450 --> 00:10:42,930
لكن لا داعي للقلق

135
00:10:42,930 --> 00:10:48,930
أقسم بأنّني سأقتل بطل التّرس والشّخص الخائن

136
00:10:48,930 --> 00:10:54,420
الّذي يطمع بعرشك قبل دخولهما كوتين لو

137
00:11:01,340 --> 00:11:04,610
وبعد يا فول؟ هل تشعر وكأنّك في الدّيار؟

138
00:11:04,610 --> 00:11:06,190
لا أعلم

139
00:11:06,190 --> 00:11:08,410
لم أكن في هذا الجزء من البلد من قبل

140
00:11:08,410 --> 00:11:10,900
لا أتذكّر ذلك جيّداً أيضاً

141
00:11:12,110 --> 00:11:16,560
ما زلتُ مصدوماً من سهولة
عبورنا نقطة التّفتيش

142
00:11:16,560 --> 00:11:18,480
ما الّذي يجري هنا؟

143
00:11:19,760 --> 00:11:23,260
ماذا كُتِبَ على تلك الرّاية الكبيرة؟

144
00:11:23,260 --> 00:11:25,440
لا داعي لمعرفة ما كُتِبَ فيها

145
00:11:25,440 --> 00:11:27,330
إذ يمكن التّمييز بالنّظر إلى وجوه الجميع

146
00:11:27,330 --> 00:11:31,700
"مكتوب "مرحباً يا بطل التّرس

147
00:11:32,780 --> 00:11:35,460
إذاً يمكنك قراءتها؟

148
00:11:35,460 --> 00:11:39,100
إنّها المهارة المُفيدة الوحيدة الّتي يملكها أخي

149
00:11:39,100 --> 00:11:40,360
!أنتِ قاسية

150
00:11:49,900 --> 00:11:51,610
استمرّي في التقدُّم فحسب يا فيلو

151
00:11:51,610 --> 00:11:52,890
!حسناً

152
00:11:54,230 --> 00:12:02,110
نحن، حرَس سيلتفيلت الملكيّ، سنُرافق
!بطل التّرس وفريقه إلى القصر

153
00:12:06,250 --> 00:12:08,800
هذا ما هو مُتوقَّع من سيلتفيلت

154
00:12:08,800 --> 00:12:13,760
من المُبهر أن يحترموا ناوفومي-ساما

155
00:12:13,760 --> 00:12:15,120
...آتلا

156
00:12:16,300 --> 00:12:19,130
...أشعر وكأنّني نجم موكب كبير

157
00:12:20,300 --> 00:12:23,270
حتّى أنا مُتفاجئة

158
00:12:23,270 --> 00:12:26,220
أنت حقّاً البطل يا ناوفومي-تشان؟

159
00:12:26,520 --> 00:12:30,470
تذكّرتُ للتو ما قالته لي
ملكة ميلرومارك في السّابق

160
00:12:30,470 --> 00:12:31,680
...هذا

161
00:12:31,680 --> 00:12:33,190
ماذا قالت؟

162
00:12:33,580 --> 00:12:34,380
...أوّلاً

163
00:12:34,950 --> 00:12:39,650
أوّلاً، ستتقرّب منك أميرات ونبيلات صغيرات

164
00:12:39,940 --> 00:12:46,570
سيُحاولن تشكيل فريق نسوة لأجلك
بفتيات بأيّ عدد من الأصناف

165
00:12:46,570 --> 00:12:48,030
فريق نسوة؟

166
00:12:48,030 --> 00:12:52,300
وبعد ذلك، ستقع ضحيّة مرض مجهول

167
00:12:52,300 --> 00:12:55,030
...وإيواتاني-ساما المسكين، أنت سوف

168
00:12:55,030 --> 00:12:57,690
!هـ-هذا مستحيل

169
00:12:57,690 --> 00:13:02,730
!سيلتفيلت تعبد بطل التّرس كإله! كملِك

170
00:13:02,730 --> 00:13:04,180
...مُحال لهم أن

171
00:13:04,180 --> 00:13:06,130
آمل أن تكوني على حقّ

172
00:13:09,800 --> 00:13:14,970
على أيّ حال، يجب علينا عبور هذا
البلد في أسرع وقت مُمكن

173
00:13:30,950 --> 00:13:32,820
...بطل التّرس

174
00:13:33,170 --> 00:13:37,960
!مرحباً، مرحباً بك في سيلتفيلت

175
00:13:37,960 --> 00:13:40,030
أنا مُبتهج جدّاً بوجودك هنا

176
00:13:41,610 --> 00:13:47,160
اسمي فارنرن مُمثّل عرق شوساكو

177
00:13:47,160 --> 00:13:49,140
شرف لي أن ألتقي بك

178
00:13:49,140 --> 00:13:50,820
عرق شوساكو؟

179
00:13:50,820 --> 00:13:53,260
اسمي إيواتاني ناوفومي، بطل التّرس

180
00:13:53,700 --> 00:13:54,850
...وهؤلاء

181
00:13:55,140 --> 00:13:57,820
خادمته، رافتاليا

182
00:13:57,820 --> 00:14:00,660
!اسم فيلو هو فيلو

183
00:14:01,570 --> 00:14:03,190
!أنا سادينا

184
00:14:03,190 --> 00:14:04,310
وأنا آتلا

185
00:14:04,790 --> 00:14:05,520
فول

186
00:14:06,760 --> 00:14:08,600
أهلاً بكم جميعاً

187
00:14:08,600 --> 00:14:13,150
اشتريتهما عندما كانا عبدين
في زيلتوبلي

188
00:14:13,150 --> 00:14:15,780
إنّهما ليسا نمر أبيض شبه بشريّ أصيلين

189
00:14:15,780 --> 00:14:18,890
،لن أتورّط في أيّ نزاع قوى في بلدكم

190
00:14:18,890 --> 00:14:20,760
ولن أدعهما يتدخّلا، لذا لا داعي للقلق

191
00:14:21,060 --> 00:14:23,020
هكذا إذاً

192
00:14:23,020 --> 00:14:25,700
والآن، تفضّل معي إلى داخل القصر

193
00:14:27,740 --> 00:14:33,500
أنا متأكّد بأنّك مُرهَق بسبب رحلتك
الطّويلة يا بطل التّرس

194
00:14:33,500 --> 00:14:35,770
...لكن أرغب في فُرصة لمُقابلة

195
00:14:36,140 --> 00:14:39,470
مُقابلة؟ بين مَن ومَن؟

196
00:14:53,390 --> 00:14:56,210
لا يُسمَح لخدمك بتجاوز هذه النّقطة

197
00:15:18,650 --> 00:15:20,770
،بطل التّرس

198
00:15:20,770 --> 00:15:25,930
الأعراق المُجتمعة هنا كلّها تحكم
،سيلتفيلت حتّى يومنا هذا

199
00:15:25,930 --> 00:15:28,310
يوم عودتك

200
00:15:29,210 --> 00:15:32,160
أنا سوليا، من عرق غينمو

201
00:15:32,950 --> 00:15:38,150
وأنا تسولون، مُمثّل عرق أوتاتسو يا بطل التّرس

202
00:15:40,550 --> 00:15:45,030
المعذرة... شكراً

203
00:15:45,460 --> 00:15:47,000
كلامك هو شرف لي

204
00:15:47,540 --> 00:15:50,210
أهكذا ينبغي أن تكون المُقابلة؟

205
00:15:50,210 --> 00:15:54,430
أجل. جميعنا تغمرنا البهجة

206
00:15:54,430 --> 00:15:58,640
سأقول صراحة ما أحتاجه منكم فحسب

207
00:15:58,640 --> 00:15:59,640
!حاضر

208
00:16:01,920 --> 00:16:06,600
لستُ مُهتمّاً بالاستيلاء على سيلتفيلت

209
00:16:06,930 --> 00:16:10,050
أنا هنا فقط في طريقي إلى هدفي

210
00:16:10,510 --> 00:16:15,370
أعدُكم ألّا أتدخّل في شؤون حكمكم لبلدكم

211
00:16:16,000 --> 00:16:19,970
لذا حضّروا سفينة إلى كوتين لأجلي

212
00:16:19,970 --> 00:16:22,330
أريد المُغادرة في أسرع وقت مُمكن

213
00:16:23,260 --> 00:16:24,780
هكذا إذاً

214
00:16:24,780 --> 00:16:28,330
يبدو أنّك أسأت الفهم يا بطل التّرس

215
00:16:28,330 --> 00:16:29,420
ماذا؟

216
00:16:29,830 --> 00:16:32,830
أوّلاً، من فضلك ارتح من رحلتك الطّويلة

217
00:16:32,830 --> 00:16:36,190
ثمّ سيكون من دواعي سرورنا الإصغاء لك

218
00:16:36,190 --> 00:16:39,810
بعد مُشاركتك في مأدبة اللّيلة

219
00:16:39,810 --> 00:16:42,030
أنا على عجلة من أمري

220
00:16:42,030 --> 00:16:46,190
وأنا متأكّد بأنّ بعضاً منكم يريدني
أن أخرج من هنا في أسرع وقت، صحيح؟

221
00:16:46,190 --> 00:16:49,270
لن أنكر ذلك

222
00:16:49,270 --> 00:16:53,160
لكن هناك مرض في بلدنا يجب تطهيره

223
00:16:54,120 --> 00:16:58,200
أيّ شخص لا يريد ناوفومي-ساما
هنا هو خائن لبلده

224
00:16:58,200 --> 00:17:01,300
!يجب العثور عليه وإعدامه في أسرع وقت

225
00:17:02,800 --> 00:17:08,140
مهمّتنا الوحيدة في الحياة هي قسَم
!الولاء لبطل التّرس

226
00:17:08,140 --> 00:17:10,380
من فضلك لا تنسَ ذلك

227
00:17:10,990 --> 00:17:12,430
...يا للرّوعة

228
00:17:12,430 --> 00:17:14,890
أن نُقسِم الولاء لناوفومي-ساما

229
00:17:14,890 --> 00:17:19,620
إذاً ينبغي أن تُحقّقوا أُمنيتي
في أسرع وقت، أليس كذلك؟

230
00:17:19,620 --> 00:17:22,270
بالطّبع سنُحضّر سفينة

231
00:17:22,270 --> 00:17:30,570
،لكن الإله الّذي نعبده قد عاد أخيراً
وستُغادر من الآن؟

232
00:17:30,900 --> 00:17:34,030
هذا البلد هو محض محطّة لرحلتك؟

233
00:17:34,370 --> 00:17:37,160
!رأيتَ كيف يُقدّسك شعبنا

234
00:17:37,160 --> 00:17:39,160
،إذا غادرت فجأة

235
00:17:39,160 --> 00:17:45,620
،سيعتقد النّاس بأنّك تخلّيت عن سيلتفيلت
ويغرق في الحزن

236
00:17:46,040 --> 00:17:47,830
—لكن لا نملك الوقت كي

237
00:17:47,830 --> 00:17:52,950
،قد يكون هناك مُشاغبين حتّى
وانقلاباً عسكريّاً

238
00:17:53,960 --> 00:17:58,290
هذا هو حجم قيمتك بالنّسبة لهذا البلد

239
00:17:58,290 --> 00:17:59,290
...أرجوك

240
00:17:59,290 --> 00:18:04,180
أرجوك كُن بطل التّرس الّذي
!كنّا ننتظره جميعاً

241
00:18:11,940 --> 00:18:13,620
حسناً

242
00:18:13,620 --> 00:18:16,520
سأحضر هذه المأدبة إذاً إن
كان هذا ما تريده

243
00:18:17,580 --> 00:18:18,770
ممتاز

244
00:18:18,770 --> 00:18:23,920
حضّرنا غرفة لبطل التّرس
وكلّ تابع من أتباعه

245
00:18:23,920 --> 00:18:27,240
من فضلكم انتظروا هناك ريثما تبدأ المأدبة

246
00:18:27,530 --> 00:18:29,600
لا أريد أن نكون في غرف مُنفصلة

247
00:18:30,030 --> 00:18:33,280
لا أتخيّل بأنّهم سيُقدِمون على أيّ
،تصرّف تجاهي الآن

248
00:18:33,280 --> 00:18:35,680
لكن لا أريد أن أكون وحيداً، تحسُّباً فقط

249
00:18:36,090 --> 00:18:41,290
لا يمكننا مُعاملة الآخرين بنفس الطّريقة
الّتي نُعامل فيها بطل التّرس

250
00:18:41,710 --> 00:18:45,360
سيُقلّل هذا من شأن إيماننا

251
00:18:45,360 --> 00:18:46,090
...المعذرة

252
00:18:47,910 --> 00:18:52,780
هل من المُمكن تحضير غرفة
بجانب ناوفومي-ساما؟

253
00:18:52,780 --> 00:18:55,100
،انظروا إلى تلك النّمر الأبيض
تعتقد بأنّه يُسمَح لها بالتكلُّم

254
00:18:55,100 --> 00:18:56,950
!كم هذا سخيف

255
00:19:02,660 --> 00:19:06,370
حسناً. سأطلب تحضيرها فوراً

256
00:19:07,350 --> 00:19:09,650
ما زال هناك بعض الوقت قبل المساء

257
00:19:09,650 --> 00:19:13,890
أفضّل الذّهاب لرؤية البلدة
عوضاً عن البقاء

258
00:19:13,890 --> 00:19:16,610
!سيُشرّفهم تلقّي زيارة من بطل التّرس

259
00:19:16,610 --> 00:19:17,590
!يا للرّوعة

260
00:19:17,990 --> 00:19:19,490
حسناً، هيّا بنا

261
00:19:19,490 --> 00:19:20,810
...لكن

262
00:19:21,270 --> 00:19:25,260
يتطلّب بعض الوقت ترتيب
زيارة ملكيّة كهذه

263
00:19:26,230 --> 00:19:30,900
والزّيارة المُفاجئة ستأخذ النّاس
على حين غرّة

264
00:19:30,900 --> 00:19:34,340
سيندمون على أنّهم كانوا عاجزين
عن تقديم ترحيب مُناسب لك

265
00:19:34,890 --> 00:19:38,020
مثل هذا الحدث الكبير يتطلّب تحضيرات

266
00:19:38,020 --> 00:19:40,880
!ويجب إخبار النّاس سلفاً

267
00:19:40,880 --> 00:19:43,680
حسناً. سأبقى داخل القصر

268
00:19:43,680 --> 00:19:46,370
هل يُسمَح لي على الأقلّ
بالمشي في الدّاخل؟

269
00:19:46,370 --> 00:19:47,890
بالطّبع

270
00:19:47,890 --> 00:19:51,380
فأساساً، هذا مكانك

271
00:19:51,950 --> 00:19:56,600
ومع ذلك لا يُسمَح لي بدخول غرفة واحدة

272
00:19:56,600 --> 00:19:59,930
"جميعها تخضع لـ"التّرميم
لا أملك حرّية إطلاقاً

273
00:20:00,960 --> 00:20:02,640
...بئساً

274
00:20:02,640 --> 00:20:05,130
كم يوماً سوف نهدر هنا؟

275
00:20:06,710 --> 00:20:10,970
حسبما بدا، يمكن أن يستغرق
ذلك أشهراً، لا أيّاماً

276
00:20:11,400 --> 00:20:13,940
لكن حينئذ لن نملك الوقت
!الكافي للاستعداد للعنقاء

277
00:20:15,010 --> 00:20:16,360
!أجل

278
00:20:16,360 --> 00:20:22,950
،أحترم ولاءهم لناوفومي-ساما
لكنّهم مُتشدّدون جدّاً

279
00:20:23,880 --> 00:20:26,040
هذا ما شعر به الأبطال الثّلاثة لآخرون

280
00:20:26,040 --> 00:20:29,070
عندما كانوا يُقدَّسون كآلهة في ميرلومارك

281
00:20:29,070 --> 00:20:34,910
أعتقد كانوا يتمتّعون بروح أكثر
!حرّية منك الآن يا ناوفومي-ساما

282
00:20:34,910 --> 00:20:39,310
عليك أن تتحلّى بروح حُرّة
لتطلب منهم منحك سفينة

283
00:20:39,310 --> 00:20:45,840
بينما تتهرّب من دون أدء واجبك
كبطل ترس، أليس كذلك؟

284
00:20:45,840 --> 00:20:48,120
معكِ حقّ في ذلك

285
00:20:48,120 --> 00:20:50,340
أجل، صغتُ تلك العبارة بشكل خاطئ

286
00:20:50,340 --> 00:20:54,340
سادينا-سان، ناوفومي-ساما مُستعجل فحسب

287
00:20:54,340 --> 00:20:57,180
لأنّه يريد مُساعدة رافتاليا-سان، صحيح؟

288
00:20:57,180 --> 00:20:59,760
!أعلم ذلك

289
00:20:59,760 --> 00:21:03,270
أنا آسفة... يبدو أنّني سبّبتُ مشاكلَ للجميع

290
00:21:03,270 --> 00:21:07,440
حسناً يا ناوفومي-ساما، عليك أن
تفعل الكثير لأجلي أيضاً

291
00:21:07,440 --> 00:21:09,350
ما هذا الكلام فجأة؟

292
00:21:08,680 --> 00:21:11,440
!إنّه بطل التّرس بشخصه

293
00:21:12,860 --> 00:21:14,200
ومن تكون؟

294
00:21:15,080 --> 00:21:21,540
اسمي ياراليس، مُمثّل عرق لايو

295
00:21:21,900 --> 00:21:23,660
شبه بشريّ أسد؟

296
00:21:24,280 --> 00:21:29,800
أعتذر لعدم قدرتي على التّعريف
عن نفسي الآن

297
00:21:29,800 --> 00:21:30,980
لا عليك

298
00:21:30,980 --> 00:21:38,010
حسناً يا بطل التّرس، جميعنا سمعنا
...بقليل ممّا حدث

299
00:21:38,010 --> 00:21:41,950
إذا أردت تجهيز سفينة لك
،للاتّجاه إلى كوتين لو

300
00:21:41,950 --> 00:21:45,110
فيمكنني تجهيزها بسرعة من تلقاء نفسي

301
00:21:45,110 --> 00:21:48,060
لم تكن حاضراً في المُقابلة قبل قليل

302
00:21:49,010 --> 00:21:52,980
.ما يعني بأنّك لستَ مُهمّاً إلى هذا الحدّ
هل أنت قادر على فعل هذا حقّاً؟

303
00:21:54,160 --> 00:22:01,050
أتطلّع قُدماً لرؤيتك في مأدبة اللّيلة

304
00:22:11,260 --> 00:22:14,990
!شاهق الارتفاع

305
00:22:18,420 --> 00:22:21,770
فول، هل تعرف شيئاً عن ياراليس ذاك؟

306
00:22:22,400 --> 00:22:24,280
لا، آسف

307
00:22:24,280 --> 00:22:26,790
هذه أوّل مرّة أرى فيها فارنر هذا أيضاً

308
00:22:27,120 --> 00:22:29,410
أنت عديم الجدوى يا أخي

309
00:22:29,410 --> 00:22:30,380
!آتلا

310
00:22:30,980 --> 00:22:33,470
لا تثقي بأي منهما

311
00:22:33,470 --> 00:22:36,240
لكن إذا كان ياراليس مُستعدّاً
،لتحضير سفينة لنا

312
00:22:36,240 --> 00:22:40,320
فهو غالباً ليس في نفس صفّ فارنر

313
00:22:40,810 --> 00:22:45,410
قد يكون شخصً لا يزال غير مُهمّ
،بما يكفي لإجراء مُقابلة

314
00:22:45,410 --> 00:22:48,000
لكن قوّته تتعزّز بشكل سريع

315
00:22:48,560 --> 00:22:50,840
ماذا ستفعل يا ناوفومي-تشان؟

316
00:22:51,420 --> 00:22:55,060
لا أحد يعلم متى سنتمكّن
من مُغادرة سيلتفيلت

317
00:22:55,060 --> 00:22:57,660
إذا سمحنا للزّعيم الطّائر يأمرنا

318
00:22:57,660 --> 00:23:01,070
لكن يبدو أنّ عرض الأسد جيّداً
لدرجة مُريبة

319
00:23:01,310 --> 00:23:06,020
التّحالف مع طرف يعني غالباً
مُعاداة الطّرف الآخر

320
00:23:06,020 --> 00:23:08,980
إذاً سننتظر بضعة أيّام ونرى

321
00:23:10,960 --> 00:23:13,290
!كلّ هذا مُعقّد للغاية

322
00:23:13,290 --> 00:23:14,960
!فيلو جائعة

323
00:23:14,960 --> 00:23:16,280
أجل

324
00:23:27,030 --> 00:23:31,070
...ما زالت كوتين لو بعيدة