!ها أنا ذي

193
00:12:15,720 --> 00:12:17,590
!رقصة أزهار الكرز كاغورا: التّشكيل الثّاني

194
00:12:19,520 --> 00:12:21,390
!تشكيلات ينغ-يانغ الشّديدة الثّمانية

195
00:12:21,390 --> 00:12:23,230
!تفتُّح جزء واحد

196
00:12:21,390 --> 00:12:23,230
!مُجزّئ الإمبراطور

197
00:12:23,720 --> 00:12:25,680
!طاعن إمبراطور العناصر الخمسة

198
00:12:25,680 --> 00:12:27,430
!مُجزِّئ إمبراطور العناصر الخمسة

199
00:12:35,360 --> 00:12:36,330
!شجرة أزهار كرز الرّبيع

200
00:12:36,330 --> 00:12:37,870
!رقصة أزهار الكرز كاغورا: التّشكيل الثّالث

201
00:12:37,870 --> 00:12:38,810
!تفتُّح ثلاثي الأجزاء

202
00:12:38,810 --> 00:12:40,270
...كم هذا جميل

203
00:12:40,780 --> 00:12:46,640
أظنّني فهمتُ أخيراً سبب أنّ ومهبة
رافتاليا السّحريّة

204
00:12:46,640 --> 00:12:48,910
هي النُّور والظّلام

205
00:12:49,430 --> 00:12:53,910
ليس لثني الضّوء أو الاختباء
في الظّلام فقط

206
00:12:54,880 --> 00:12:56,020
!الخشب يغزو الأرض

207
00:12:56,020 --> 00:12:57,070
!الأرض تغزو الماء

208
00:12:57,070 --> 00:12:58,260
!الماء يغزو النّار

209
00:12:58,260 --> 00:12:59,290
!النّار يغزو المعدن

210
00:12:59,290 --> 00:13:00,680
!المعدن يغزو الخشب

211
00:13:00,900 --> 00:13:02,490
:رقصة أزهار الكرز كاغورا: التّشكيل الرّابع

212
00:13:02,490 --> 00:13:03,350
!تفتُّح خُماسي الأجزاء

213
00:13:03,350 --> 00:13:04,400
!تفتُّح سُداسي الأجزاء

214
00:13:05,610 --> 00:13:09,490
مثل الينغ واليانغ تماماً، تحتوي موهبتها
،على النُّور والظّلام معاً

215
00:13:09,490 --> 00:13:12,610
ما يجعلها خبيرة في تبايُن العناصر

216
00:13:13,010 --> 00:13:15,780
أبليتِ حسناً في الصُّمود حتّى الآن، بالفعل

217
00:13:15,780 --> 00:13:21,620
سلسلة المهارات القويّة هذه تزداد قوّة
مع كلّ هجمة، حسبما هو واضح

218
00:13:21,620 --> 00:13:25,770
لكنّها تستهلك قوّتكِ بشكل كبير
خلال فترة قصيرة، بالفعل

219
00:13:25,770 --> 00:13:27,820
أعلم ذلك

220
00:13:27,820 --> 00:13:29,940
لكن لن أتراجع

221
00:13:30,540 --> 00:13:32,720
!إذاً سأستخدم تقنيّتي العظمى أيضاً

222
00:13:35,780 --> 00:13:38,090
!الغزو الكامل لعناصر الإمبراطور الخمسة

223
00:13:52,840 --> 00:13:53,930
!فعلتُها

224
00:13:54,310 --> 00:13:58,600
!سأقاوم قوّةَ اليانغ بالينغ خاصّتي وأُلغيها

225
00:13:58,600 --> 00:14:00,610
...سينتهي هذا بلمح البصر

226
00:14:01,010 --> 00:14:04,060
،والآن، إن كنتِ لا تريدين الموت
!فتعالي معي إذاً

227
00:14:05,530 --> 00:14:08,040
!الولادة الكاملة لعناصر الإمبراطور الخمسة

228
00:14:12,480 --> 00:14:14,120
!القمر السّديميّ

229
00:14:14,120 --> 00:14:17,500
...القليل فقط... ولو لبُرهة

230
00:14:19,090 --> 00:14:20,440
!ليس بعد، أجل بالفعل

231
00:14:22,090 --> 00:14:23,790
...في تلك البُرهة

232
00:14:24,550 --> 00:14:25,800
!سيف الوهم

233
00:14:29,260 --> 00:14:31,980
هذه هي النّهاية

234
00:14:33,270 --> 00:14:35,750
حسناً، أبليتِ حسناً

235
00:14:39,040 --> 00:14:41,960
تفتقرين للكثير

236
00:14:41,960 --> 00:14:44,230
لكن سأعترف بأنّكِ تتمتّعين
بالمعنويّات العالية، بالفعل

237
00:14:44,950 --> 00:14:49,500
...ربّما يمكنني ائتمانكِ على زمام الأمور
أجل، بالفعل

238
00:14:51,620 --> 00:14:54,650
لم تستخدمي قوّتكِ الكاملة، صحيح؟

239
00:14:54,650 --> 00:14:55,870
هذا غير صحيح

240
00:14:56,210 --> 00:15:01,340
استخدمتُ مُعظم القوّة الّتي أقدر
عليها بهذا الجسد، بالفعل

241
00:15:01,340 --> 00:15:06,540
إن لم تستطيعي التفوُّق عليّ، فلستِ
جديرة بأن تكوني مُسكِّنة روحيّة

242
00:15:06,540 --> 00:15:11,290
لا سيّما أنّكِ تتعاونين مع مُستخدم
أداة تسكين روح، بالفعل

243
00:15:11,290 --> 00:15:12,930
...مُسكِّنة روحيّة

244
00:15:13,580 --> 00:15:16,210
الّتي يكون عملها هو إيقاف الأبطال؟

245
00:15:16,690 --> 00:15:23,930
خلاف ذلك، لن تكوني قادرة على مُعاقبة
الحمقى عندما يظهرون، بالفعل

246
00:15:24,660 --> 00:15:31,690
عسى أن تبقي مُتواضعة وتسعين للحفاظ
على سلالة كوتين لو الإمبراطوريّة قويّة

247
00:15:32,900 --> 00:15:39,230
تكبّدتْ دولتي الكثير من الأضرار، لكن
تمكّنتُ من رؤية شيء مُثير في النّهاية

248
00:15:40,730 --> 00:15:44,070
احرصي على العمل بجدّ، ولا تدعيهم
يهزمونكِ، بالفعل

249
00:15:45,990 --> 00:15:50,100
والآن حان الوقت لأشباح الماضي
بأن تتلاشى، بالفعل

250
00:16:03,990 --> 00:16:05,190
!ناوفومي-ساما

251
00:16:05,690 --> 00:16:07,770
تحتاج شفاء مُتقدِّماً

252
00:16:08,190 --> 00:16:09,090
!فيلو

253
00:16:09,090 --> 00:16:11,110
!خذيها إلى الجيش الثّوريّ

254
00:16:11,110 --> 00:16:12,600
!حاضرة

255
00:16:13,040 --> 00:16:15,310
...والآن كلّ ما بقي

256
00:16:22,500 --> 00:16:24,460
!ابحثوا عن خصمنا البغيض، ماكينا

257
00:16:24,460 --> 00:16:26,540
!اقبضوا على الإمبراطور، رافتميلا

258
00:16:29,550 --> 00:16:30,420
!انظروا

259
00:16:30,730 --> 00:16:32,300
!رافتاليا-ساما

260
00:16:32,940 --> 00:16:35,240
!وبطل التّرس معها

261
00:16:36,500 --> 00:16:38,610
...ر-ربحنا

262
00:16:38,610 --> 00:16:40,840
!ربحنا

263
00:16:55,300 --> 00:16:57,030
استيقظتِ

264
00:16:57,520 --> 00:17:00,130
ناوفومي-تشان؟

265
00:17:00,130 --> 00:17:01,660
كيف هو شعوركِ؟

266
00:17:08,420 --> 00:17:10,520
لا ينبغي أن تتحرّكي بعد

267
00:17:10,520 --> 00:17:14,090
هذا صحيح. غبتِ عن الوعي ليومين

268
00:17:14,450 --> 00:17:15,990
يومان؟

269
00:17:17,520 --> 00:17:19,340
ماذا حدث بعد ذلك؟

270
00:17:20,530 --> 00:17:23,270
لا أعرف كم تتذكّرين

271
00:17:23,270 --> 00:17:27,740
قُتِلت ماكينا بواسطة الإمبراطورة السّابقة
الّتي استدعيتِها بقدرة العرّافة خاصّتكِ

272
00:17:28,920 --> 00:17:32,430
...كنتُ مُحقّة إذاً

273
00:17:32,920 --> 00:17:36,290
إذاً الإمبراطور... رافتميلا-ساما؟

274
00:17:36,730 --> 00:17:40,250
،بعد قتال الإمبراطورة السّابقة مع رافتاليا

275
00:17:40,250 --> 00:17:42,800
...صعدنا إلى غرفته في القلعة

276
00:17:46,580 --> 00:17:50,220
لكنّه كان قد هُجِرَ بواسطة ماكينا
والرّجال الآخرين

277
00:17:50,220 --> 00:17:52,550
كان يرتجف وحيداً في غرفته

278
00:17:53,560 --> 00:17:55,880
،عندما أخبرناه بأنّ ماكينا قد ماتت

279
00:17:56,280 --> 00:18:00,320
بدأ يتصرّف كإمبراطور حقيقيّ ووهبَنا حياته

280
00:18:00,760 --> 00:18:05,590
لكن كان ذلك سيتعارض مع الوعد
الّذي قطعَتْه رافتاليا معكِ

281
00:18:05,990 --> 00:18:10,150
انتزعتْ لقبَ الإمبراطور منه من دون قتله

282
00:18:10,710 --> 00:18:17,180
بالطّبع، وبّخناه كثيراً بشأن
قوانينه الجائرة

283
00:18:18,140 --> 00:18:21,220
وأخبرنا الجيشَ الثّوريّ

284
00:18:21,220 --> 00:18:25,160
بأنّ الإمبراطور الشّابّ قد قُتِل
والتُهِمَ بواسطة فيلوليال

285
00:18:25,790 --> 00:18:27,600
...جيّد

286
00:18:27,600 --> 00:18:30,240
لكن لن أراه بعد الآن، أليس كذلك؟

287
00:18:30,240 --> 00:18:32,440
لا أعلم بشأن ذلك

288
00:18:38,190 --> 00:18:39,630
!شيلدينا

289
00:18:39,630 --> 00:18:40,830
!رافت

290
00:18:40,830 --> 00:18:42,380
!أقصد، جلالتك

291
00:18:42,730 --> 00:18:45,770
شيلدينا، لم أعُد الإمبراطور

292
00:18:46,200 --> 00:18:47,790
إنّما هي

293
00:18:49,490 --> 00:18:50,880
...شكراً لك

294
00:18:54,240 --> 00:18:55,690
شيلدينا؟

295
00:18:56,620 --> 00:19:02,310
،وهذا الإمبراطور السّابق، رافتميلا
اختبأ في قرية لورولونا

296
00:19:02,310 --> 00:19:06,340
،وأنهت شيلدينا وسادينا الأمور مع عائلتهما

297
00:19:06,340 --> 00:19:09,330
وأصبحا خادمتي الإمبراطورة الجديدة، رافتاليا

298
00:19:14,150 --> 00:19:16,830
وتمّ التكفُّل بمُخلّفات الحرب

299
00:19:16,830 --> 00:19:20,580
لنترك الباقي لهم ونعُد إلى القرية

300
00:19:21,070 --> 00:19:25,060
لكن أنا متأكّد بأنّه سيترتّب عليكِ
العودة بعد مدّة لتكوني الإمبراطورة

301
00:19:25,390 --> 00:19:27,540
اخترتُ هذا الدّرب

302
00:19:27,540 --> 00:19:29,550
سأحرص على أن يكون ناجحاً

303
00:19:30,360 --> 00:19:33,760
.بصفتي سيفك يا ناوفومي-ساما
وبصفتي الإمبراطورة

304
00:19:34,570 --> 00:19:35,690
حسناً

305
00:19:36,110 --> 00:19:39,960
ماذا عنك يا ناوفومي-ساما؟
ماذا ستفعل بشأن سيلتفيلت؟

306
00:19:39,960 --> 00:19:41,580
هذا صحيح

307
00:19:41,580 --> 00:19:47,570
بعد ما قلتُه، يجب أن أتوقّف في طريق
العودة والقيام بموكب استعراضيّ

308
00:19:48,140 --> 00:19:51,530
ثمّ سيحين وقت مُقاتلة العنقاء

309
00:19:51,530 --> 00:19:54,710
وعندما يُهزَم، ينتظرنا
وحشٌ حارسٌ آخر

310
00:19:55,130 --> 00:19:58,530
وعندما ننتهي من ذلك، ستعود الموجات

311
00:19:58,530 --> 00:20:00,760
سنكون مشغولين، أليس كذلك؟

312
00:20:00,760 --> 00:20:02,130
أجل

313
00:20:05,690 --> 00:20:10,460
هل تعتقد بأنّ هذا ما أراد
أبي وأمّي رؤيته؟

314
00:20:10,960 --> 00:20:12,240
أجل

315
00:20:12,240 --> 00:20:13,370
أنا متأكّدٌ من ذلك

316
00:20:22,700 --> 00:20:24,940
...لـ-لحظة، بطل الرّمح

317
00:20:24,940 --> 00:20:27,240
!لا، موتوياسو-ساما

318
00:20:32,700 --> 00:20:35,840
!لا أملك أدنى فكرة عمّا تقولينه

319
00:20:35,840 --> 00:20:37,210
!رمح الهجوم الهوائي

320
00:20:46,710 --> 00:20:51,980
أنت، أيّتها الخنزيرة، كنتِ غالباً تُشكّلين خطراً
على والد حبيبتي! لكنّكِ ميّتة الآن

321
00:20:52,350 --> 00:20:54,620
!هيّا بنا جميعاً

322
00:20:56,940 --> 00:21:00,810
بئساً، نسيتُ تدمير روحها

323
00:21:00,810 --> 00:21:03,740
!حسناً، يمكنني فعلها في المرّة القادمة