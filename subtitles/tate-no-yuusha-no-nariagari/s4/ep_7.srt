1
00:00:02,000 --> 00:00:06,430
يقول تنّينُ الماء بأنّ الحاجز يتمّ
التحكُّم به عن طريق تلك المنارة

2
00:00:06,430 --> 00:00:11,120
سيترتّب علينا تعطيله إذا أردنا التّواصل
مع الّذين ما زالوا على متن السّفينة

3
00:00:11,120 --> 00:00:13,920
أريد إيصالهم إلى الميناء بسرعة، أجل

4
00:00:15,650 --> 00:00:18,460
...تبدو إحصائيّاتهم سليمة

5
00:00:21,030 --> 00:00:24,940
لكن مهما فعلنا، لا يمكننا
الاقتراب من اليابسة

6
00:00:24,940 --> 00:00:25,900
أجل

7
00:00:25,900 --> 00:00:28,380
هل الجميع بخير؟

8
00:00:28,380 --> 00:00:29,870
...ناوفومي-ساما

9
00:00:30,230 --> 00:00:32,940
تقول راف-تشان بأنّهم بخير، صحيح؟

10
00:00:32,940 --> 00:00:37,280
لستُ قلقة. أنا مُنزعجة فقط
لأنّني لستُ بجانبه

11
00:00:42,240 --> 00:00:43,690
أين ناوفومي؟

12
00:00:49,270 --> 00:00:50,990
!ها نحن ذا

13
00:00:51,570 --> 00:00:53,400
كيف نبدو؟

14
00:00:53,400 --> 00:00:54,940
رائعتان؟

15
00:00:56,150 --> 00:00:58,200
سيُخفي هذا وجهكِ أيضاً

16
00:00:59,220 --> 00:01:03,280
رافتاليا-تشان، احرصي على عدم
إظهار ذيلكِ وأُذنيكِ

17
00:01:03,280 --> 00:01:04,100
حسناً

18
00:01:04,810 --> 00:01:06,660
ما هذا؟

19
00:01:06,660 --> 00:01:10,350
هذا دليل على أنّ تنّين الماء يحمينا

20
00:01:10,350 --> 00:01:13,730
إنّه يُعبَد في هذا البلد

21
00:01:13,730 --> 00:01:15,880
إنّه شيء مُقدّس إذاً؟

22
00:01:16,790 --> 00:01:19,390
إن انتهينا من تبديل الملابس، فلنذهب

23
00:01:19,390 --> 00:01:20,460
حسناً

24
00:01:20,850 --> 00:01:24,210
يجب أن نكسر ذلك الحاجز

25
00:02:56,640 --> 00:02:58,850
...إنّها جميلة

26
00:02:58,850 --> 00:03:02,190
لومينا الكرز تلمع في اللّيل

27
00:03:02,190 --> 00:03:05,520
تُستخدَم كمصدر طاقة لكثير
من الأدوات المُختلفة

28
00:03:05,990 --> 00:03:09,130
هل يمكننا أخذها إلى المنزل
واستخدامها في قريتنا؟

29
00:03:09,130 --> 00:03:12,960
في الواقع، يبدو أنّها لا تنمو جيّداً
إلّا في هذا البلد

30
00:03:12,960 --> 00:03:14,340
هكذا إذاً

31
00:03:15,160 --> 00:03:17,100
هل يصطادون السّمك؟

32
00:03:17,100 --> 00:03:19,690
يبدو أنّهم يجمعون عشباً بحريّاً

33
00:03:19,690 --> 00:03:22,850
سيكون من الأسرع لو نُحلّق إلى هناك فحسب

34
00:03:22,850 --> 00:03:25,320
إلّا إن حاولوا اصطيادنا ونحن في السّماء

35
00:03:25,320 --> 00:03:27,890
سنكون بأمان برّاً

36
00:03:33,490 --> 00:03:34,940
...لا أعرف ماذا أُسمّي هذا

37
00:03:34,940 --> 00:03:37,840
بلاد رافتاليا اليابانيّة"؟"

38
00:03:37,840 --> 00:03:39,400
ماذا؟

39
00:03:39,400 --> 00:03:42,340
هذا تشريفاً لعشيرة الإمبراطور

40
00:03:42,340 --> 00:03:44,900
عشيرة الإمبراطور محبوبة بواسطة الشّعب؟

41
00:03:45,360 --> 00:03:50,880
لكن أمّي وأبي اضطرّا لمُغادرة كوتين لو

42
00:03:51,420 --> 00:03:52,260
ماذا؟

43
00:03:56,960 --> 00:03:57,750
ماذا؟

44
00:04:01,950 --> 00:04:02,970
!ناوفومي-ساما

45
00:04:02,970 --> 00:04:03,550
أجل

46
00:04:03,550 --> 00:04:04,280
انتظرا

47
00:04:04,960 --> 00:04:06,580
!اذهب أنت يا غايليون-تشان

48
00:04:07,270 --> 00:04:09,420
أنتما لا تتحرّكا

49
00:04:15,340 --> 00:04:16,680
هل يمكنك النّهوض؟

50
00:04:21,230 --> 00:04:22,360
!مهلاً

51
00:04:22,770 --> 00:04:24,310
ماذا كان ذلك؟

52
00:04:24,580 --> 00:04:27,970
....كيف أمكنكم

53
00:04:27,970 --> 00:04:30,430
ألا تخشون من القُضاة؟

54
00:04:36,420 --> 00:04:39,290
كنتُم أنتم من قتل ذلك الوحش، صحيح؟

55
00:04:39,290 --> 00:04:41,950
أردنا إنقاذ ذلك الطّفل فحسب

56
00:04:41,380 --> 00:04:46,580
كلّ ما حدث هنا كان مُحاولة
وحش لأكل آخر

57
00:04:47,540 --> 00:04:49,260
كذِب

58
00:04:49,260 --> 00:04:50,940
هل تعصون أوامر الإمبراطور؟

59
00:04:50,940 --> 00:04:52,610
بالطّبع لا

60
00:04:52,610 --> 00:04:57,320
أنا متأكّدة بأنّكم أذكياء بما يكفي
لمعرفة ماهيّة هذا الوحش، صحيح؟

61
00:04:57,620 --> 00:04:59,300
خادم تنّين الماء؟

62
00:05:00,570 --> 00:05:02,270
!نحن آسفون

63
00:05:03,960 --> 00:05:05,080
من هم؟

64
00:05:05,080 --> 00:05:08,160
رُسُل لتنّين الماء؟

65
00:05:08,520 --> 00:05:10,610
...لا أُصدّق بأنّ الأمور ساءت إلى هذا الحدّ

66
00:05:11,390 --> 00:05:14,250
!أحسنتِ صنعاً أيّتها الآنسة الصّغيرة

67
00:05:15,920 --> 00:05:18,800
بينما كان الجميع خائفين جدّاً
،من تحرُّك القُضاة

68
00:05:18,800 --> 00:05:21,380
!تصرّفتِ لإنقاذ حياة ذلك الطّفل

69
00:05:21,780 --> 00:05:24,870
إذا هوجِم طفل، من الطّبيعيّ أن نُنقذه

70
00:05:24,870 --> 00:05:28,640
أنا مُتأثّر جدّاً لدرجة الوقوع
!في الحُبّ يا آنستي الصّغيرة

71
00:05:30,000 --> 00:05:33,980
،من فضلكِ اسمحي لي أنا، موراماسا
بشراء كوب من الشّاي لكِ يا آنستي الصّغيرة

72
00:05:33,980 --> 00:05:36,570
...المعذرة، نحن لم

73
00:05:36,570 --> 00:05:39,430
أنا آسفة. نحن على عجلة من أمرنا

74
00:05:39,430 --> 00:05:42,000
!يا للجمال

75
00:05:42,000 --> 00:05:45,520
!من فضلكِ، اسمحي لي بشراء شاي لكِ

76
00:05:45,820 --> 00:05:47,480
...إنّه يستهدف كلّ فتاة يراها

77
00:05:47,480 --> 00:05:49,020
هل هو موتوياسي 2؟

78
00:05:49,420 --> 00:05:50,640
شكراً

79
00:05:50,640 --> 00:05:55,330
لكن ثمّة شخص أُحبّه، لذا
لا بُدّ أن أرفض

80
00:05:55,330 --> 00:05:57,290
لا تقولي ذلك

81
00:05:57,740 --> 00:05:59,550
ضربة تسوفاي الصّاعقة

82
00:06:01,520 --> 00:06:03,860
...يا لكِ من صبيانيّة

83
00:06:05,320 --> 00:06:07,430
حسناً، لقد جذبنا الكثير من الأنظار

84
00:06:07,430 --> 00:06:08,920
لنتحرّك

85
00:06:08,920 --> 00:06:10,080
أجل

86
00:06:10,360 --> 00:06:11,860
لنُسرع

87
00:06:11,860 --> 00:06:13,030
هيّا بنا

88
00:06:13,030 --> 00:06:15,060
!يا له من رجل غريب

89
00:06:19,150 --> 00:06:21,750
لِمَ كان أولئك القُضاء مستائين؟

90
00:06:21,750 --> 00:06:26,570
الإمبراطور الحاليّ يمنع قتل
الكائنات الحيّة

91
00:06:26,570 --> 00:06:28,310
حتّى الوحوش

92
00:06:29,560 --> 00:06:32,670
كما فعل أحد الشّوغن القُدماء

93
00:06:32,670 --> 00:06:35,270
الشّوغن؟

94
00:06:35,270 --> 00:06:37,870
يسرّني أنّ غايليون كان هنا

95
00:06:38,990 --> 00:06:43,180
إذاً لا يُعاقبون وحشاً على قتل
وحش آخر، صحيح؟

96
00:06:43,490 --> 00:06:47,880
،إذا طلب مالكُ الوحش من الوحش فعل ذلك
فرُبّما سيُعاقب الملك

97
00:06:47,880 --> 00:06:51,050
لكن لا يسعهم فعل شيء إذا
كان تنّين الماء

98
00:06:51,050 --> 00:06:54,760
إذاً استفدنا ممّا أعطانا إيّاه تنّين الماء

99
00:06:57,030 --> 00:07:00,890
ما يعني بأنّهم لا يستطيعون حتّى
اصطياد السّمك في هذا البلد

100
00:07:00,890 --> 00:07:02,630
أجل

101
00:07:02,990 --> 00:07:05,410
لهذا كان البّحارون يجمعون عشباً بحريّاً

102
00:07:05,410 --> 00:07:09,310
...لحظة! إذا أخذت هذا، فكيف لي

103
00:07:09,310 --> 00:07:12,780
أولئك الّذين لا يدفعون ضرائبهم
!لا يختلفون عن الخونة

104
00:07:14,030 --> 00:07:16,410
...لكن إذا كنّا لا نستطيع صيد السّمك

105
00:07:16,410 --> 00:07:19,200
هل ستعصي أوامر الإمبراطور؟

106
00:07:25,820 --> 00:07:27,180
...رافتاليا-تشان

107
00:07:28,410 --> 00:07:31,520
قد نتمكّن من استخدام هذا لصالحنا

108
00:07:32,300 --> 00:07:36,420
أنا متأكّد بأنّ كثيراً من المُواطنين
غير راضين عن هذا القانون

109
00:07:38,320 --> 00:07:39,260
ما الخطب؟

110
00:07:39,260 --> 00:07:40,570
أحدهم يُراقبنا

111
00:07:45,480 --> 00:07:46,780
قاضٍ؟

112
00:07:46,780 --> 00:07:47,810
لا أعلم

113
00:07:48,440 --> 00:07:50,610
سنستخدم سحر الاختفاء عندما
ننعطف في الزّاوية

114
00:07:50,610 --> 00:07:51,360
عُلِم

115
00:08:00,480 --> 00:08:04,910
!لستُ عدوّكم

116
00:08:04,910 --> 00:08:09,800
شعب البحر شاركوني كلمات
،تنّين الماء

117
00:08:09,800 --> 00:08:11,890
!وأتيتُ للتّرحيب بكم

118
00:08:12,520 --> 00:08:15,780
!من فضلكم، استمعوا إليّ على الأقلّ

119
00:08:15,780 --> 00:08:16,820
رافتاليا

120
00:08:17,580 --> 00:08:21,350
التّوقيت مُناسب جدّاً ليكون
الأمر برمّته كذبة

121
00:08:21,350 --> 00:08:22,400
أنت

122
00:08:23,540 --> 00:08:25,310
حاليّاً، انهض

123
00:08:27,780 --> 00:08:29,160
...المعذرة

124
00:08:29,160 --> 00:08:32,490
أوّلاً، عرّف عن نفسك وأخبرنا ماذا تريد

125
00:08:32,490 --> 00:08:36,020
أنا لومينوس، ابن رالوفا، مُحافظ المدينة

126
00:08:36,020 --> 00:08:37,760
ادخل صلب الموضوع

127
00:08:37,760 --> 00:08:38,950
...لكن

128
00:08:39,280 --> 00:08:42,420
...أفضّل أن تتكلّم بشكل طبيعيّ أيضاً

129
00:08:42,640 --> 00:08:43,790
...إذاً

130
00:08:44,240 --> 00:08:47,920
نحتاج مُساعدتكم

131
00:08:48,440 --> 00:08:50,040
لماذا نحن؟

132
00:08:50,430 --> 00:08:54,390
أنا متأكّد بأنّكم رأيتم ما يجري في هذا البلد

133
00:08:54,780 --> 00:08:56,880
مسألة "عدم قتل الكائنات الحيّة"؟

134
00:08:57,200 --> 00:09:01,340
والضّرائب باهظة... بعض النّاس
يتضوّرون جوعاً حرفيّاً

135
00:09:01,790 --> 00:09:05,930
لا يمكننا أن نسمح لهذه الحكومة
الشّرّيرة بالاستمرار

136
00:09:05,930 --> 00:09:09,240
إذاً أنت لست راضياً عن الإمبراطور؟

137
00:09:09,480 --> 00:09:12,540
سأشرح أكثر في القصر

138
00:09:12,960 --> 00:09:15,190
هلّا تفضّلتم معنا؟

139
00:09:15,560 --> 00:09:17,950
بوسعنا الاستماع إليه على الأقلّ، صحيح؟

140
00:09:17,950 --> 00:09:19,210
أجل

141
00:09:19,640 --> 00:09:22,400
إيّاك والتّفكير في نصب فخّ لنا

142
00:09:22,400 --> 00:09:24,590
!مُحال أن أفعل

143
00:09:24,590 --> 00:09:28,080
!إذا أهنتُكم، فسأشقّ بطني للاعتذار

144
00:09:33,080 --> 00:09:37,880
اسمي رالوفا، مُحافظ المدينة

145
00:09:38,310 --> 00:09:41,510
هل يمكنني رؤية وجهك؟

146
00:09:45,320 --> 00:09:48,070
تُشبهين أباكِ

147
00:09:48,070 --> 00:09:50,140
تعرف أبي؟

148
00:09:50,880 --> 00:09:53,120
كان لطيفاً جدّاً معي

149
00:09:53,410 --> 00:09:57,060
قضيتَ الوقت مع والد رافتاليا-تشان، صحيح؟

150
00:09:57,380 --> 00:09:59,720
أنت الميكو السّابق لتنّين الماء، صحيح؟

151
00:09:59,720 --> 00:10:00,910
تسرّني رؤيتك من جديد

152
00:10:00,910 --> 00:10:04,120
اسمي إيواتاني ناوفومي، بطل التّرس

153
00:10:04,120 --> 00:10:06,010
سمعتُ عنك

154
00:10:06,010 --> 00:10:11,630
مهما شكرناك لا نُوفيك حقّك
على حماية رافتاليا-ساما

155
00:10:12,130 --> 00:10:14,260
ظننتُ بأنّ هذا المكان كان معزولاً

156
00:10:14,260 --> 00:10:16,150
لكنّك تعرف عن العالم الخارجيّ

157
00:10:16,150 --> 00:10:19,190
هذه بلدة تجاريّة في نهاية المطاف

158
00:10:19,190 --> 00:10:20,590
هكذا إذاً

159
00:10:20,590 --> 00:10:21,550
وبعد؟

160
00:10:21,550 --> 00:10:24,560
ماذا تقصد بأنّك تحتاج مُساعدتنا؟

161
00:10:26,360 --> 00:10:31,810
نريد من رافتاليا-ساما أن تعتلي العرش
وإنهاء هذه الحكومة الفظيعة

162
00:10:31,810 --> 00:10:35,300
أعتلي العرش؟ أ-أنا؟

163
00:10:35,300 --> 00:10:40,860
أتينا إلى هذا البلد للتّعامل مع مَن
كان يُهاجم رافتاليا

164
00:10:41,230 --> 00:10:43,820
حالما ينتهي ذلك، سنُغادر

165
00:10:44,700 --> 00:10:46,330
أعي ذلك

166
00:10:46,640 --> 00:10:48,080
لست مُعارضاً على ذلك؟

167
00:10:48,410 --> 00:10:52,660
إذا كانت ستُصبح دُمية في يد أصحاب
،النّفوذ كالإمبراطور الحاليّ

168
00:10:52,660 --> 00:10:54,720
!فلن تكون إمبراطورة حقيقيّة

169
00:10:55,120 --> 00:11:00,090
يُفترَض للإمبراطور أن يتواجد لأجل
هذا العالم، لأجل شعبه

170
00:11:00,350 --> 00:11:03,940
هذا نفس تفكير والد رافتاليا-ساما

171
00:11:05,400 --> 00:11:09,940
ألهذا السّبب غادر؟

172
00:11:09,940 --> 00:11:12,380
هذا ليس السّبب الوحيد

173
00:11:12,380 --> 00:11:17,040
اندلعت معركة قبيحة آنذاك حول
مَن سيكون الإمبراطور التّالي آنذاك

174
00:11:26,380 --> 00:11:31,180
كان البقاء في هذا البلد سيعني
نهاية فظيعة بالنّسبة له

175
00:11:31,540 --> 00:11:32,750
...ولذا

176
00:11:33,480 --> 00:11:36,280
...انتظرنا فترة طويلة جدّاً

177
00:11:36,280 --> 00:11:39,110
اللّحظة الّتي يقوم فيها الإمبراطور
الحقيقيّ بوضع حدّ

178
00:11:39,110 --> 00:11:42,730
لهذا وإعادة هذا العالم إلى ما كان
!ينبغي أن يكون

179
00:11:43,790 --> 00:11:45,670
ما هي خطّتك؟

180
00:11:46,090 --> 00:11:49,540
أوّلاً، القضاء على القُضاة الّذين
،يحرسون المنارة

181
00:11:49,540 --> 00:11:52,240
لإرسال إشارة لبدء الثّورة

182
00:11:52,240 --> 00:11:54,900
أعتقد بأنّ هذا سينفعكم كذلك

183
00:11:55,220 --> 00:11:56,650
هل لديكم قوّات جاهزة؟

184
00:11:56,650 --> 00:12:00,440
،عشيرتي، وشعب هذه البلدة

185
00:12:00,440 --> 00:12:02,600
جاهزون للانتفاض

186
00:12:02,600 --> 00:12:03,990
حسناً

187
00:12:06,370 --> 00:12:07,780
...ناوفومي-ساما

188
00:12:08,220 --> 00:12:10,920
رافتاليا، جهّزي زيّ الميكو الخاص بكِ

189
00:12:11,740 --> 00:12:13,210
ثانية؟

190
00:12:13,210 --> 00:12:14,700
...لكن هذا يعني

191
00:12:17,380 --> 00:12:18,440
تفضّلي

192
00:12:19,200 --> 00:12:20,560
هل تعلم ما يعنيه هذا؟

193
00:12:20,560 --> 00:12:21,850
...إذا ارتديتُه

194
00:12:21,850 --> 00:12:24,300
سيستهدفوننا على أيّ حال

195
00:12:24,300 --> 00:12:26,490
حريّ بنا أن نمتلك مزيداً من الحُلفاء

196
00:12:26,490 --> 00:12:28,270
...أجل، لكن

197
00:12:28,270 --> 00:12:33,030
أريد إبطال ذلك الحاجز بسرعة، وذلك كي
نتمكّن من اللّقاء مع الّذين في السّفينة أيضاً

198
00:12:33,030 --> 00:12:34,820
و... انظري

199
00:12:35,610 --> 00:12:37,400
انظري إلى عيونهم

200
00:12:37,400 --> 00:12:41,880
كانوا ينتظرون طويلاً ظهور إشارة

201
00:12:42,560 --> 00:12:44,270
سأساعدكِ على ارتدائه

202
00:12:53,410 --> 00:12:55,240
...ا-المعذرة

203
00:12:58,340 --> 00:13:02,030
!نطلب هدايتك لنا يا مولايّ الإمبراطور

204
00:13:02,030 --> 00:13:05,790
!سوف نتبعك ولو كلّفنا ذلك أرواحنا

205
00:13:07,030 --> 00:13:09,180
!يا مُواطنو كوتين لو الفخورون

206
00:13:11,090 --> 00:13:13,390
!الإمبراطور الحقيقيّ قد عاد

207
00:13:13,620 --> 00:13:16,660
!حان الوقت الآن لوضع حدّ للحكومة الشّرّيرة

208
00:13:16,940 --> 00:13:19,900
!سيقودكم الإمبراطور الحقيقيّ

209
00:13:20,300 --> 00:13:21,480
!لأجل العالم

210
00:13:21,480 --> 00:13:22,350
!لأجل شعبكم

211
00:13:22,770 --> 00:13:25,190
!تعالوا معنا إن كنتُم شُجعاناً

212
00:13:30,360 --> 00:13:34,590
ناوفومي-ساما، قلّدت آتلا-سان
...من أجل إثارة حماسهم

213
00:13:34,590 --> 00:13:36,560
!وقد نجح ذلك

214
00:13:36,560 --> 00:13:39,010
!يزداد حماسي

215
00:13:39,010 --> 00:13:43,420
سوف نتولّى القيادة. لا أريد وقوع
ضحايا من غير ضرورة

216
00:13:44,730 --> 00:13:46,060
حسناً

217
00:13:46,460 --> 00:13:49,520
،إذا كنّا لا نستطيع تجنُّب هذا
فسيترتّب علينا المضيّ قُدماً

218
00:13:55,560 --> 00:13:56,860
!توقّفوا

219
00:13:56,860 --> 00:14:00,030
!هذه حدود مُقدّسة تنتمي للإمبراطور

220
00:14:00,030 --> 00:14:04,530
أخبر قائدك بأنّ الإمبراطور الحقيقيّ
!قد أتى للتكلّم معه

221
00:14:05,120 --> 00:14:09,390
أنتم الإمبراطور المُزيّف... وحاملو
!أدوات الرُّوح الشّرّيرة

222
00:14:09,390 --> 00:14:11,400
!لا نتكلّم مع خونة

223
00:14:11,400 --> 00:14:12,750
!اقتلوهم

224
00:14:14,990 --> 00:14:17,000
حسناً، توقّعتُ ذلك

225
00:14:17,450 --> 00:14:18,210
!هيّا بنا

226
00:14:22,710 --> 00:14:24,180
!ترس النّيزك

227
00:14:24,540 --> 00:14:27,870
!أدوات الرُّوح لن تفلح ضدّنا

228
00:14:31,640 --> 00:14:33,350
!اللّعنة! أعماني؟

229
00:14:33,350 --> 00:14:35,880
حضّرنا أنفسنا أيضاً

230
00:14:35,880 --> 00:14:37,660
!هالة تسوفاي الشّاملة

231
00:14:38,220 --> 00:14:39,330
!رافتاليا-تشان

232
00:14:39,330 --> 00:14:39,810
!حسناً

233
00:14:44,600 --> 00:14:46,760
!اتبع الإمبراطور الحقيقيّ

234
00:14:46,760 --> 00:14:48,320
!حاضر يا أبي

235
00:14:53,240 --> 00:14:54,840
!سنفعل هذا سريعاً

236
00:14:54,840 --> 00:14:55,690
!حسناً

237
00:15:00,500 --> 00:15:01,830
...هذه هي المنارة

238
00:15:02,410 --> 00:15:04,440
...إذا استطعنا إخماد النّار في القمّة

239
00:15:06,220 --> 00:15:07,660
ماذا تفعلون؟

240
00:15:08,040 --> 00:15:12,180
!اقتلوا الإمبراطور المُزيّف فحسب

241
00:15:12,510 --> 00:15:14,460
إنّه الزّعيم؟

242
00:15:14,460 --> 00:15:15,940
هكذا يبدو

243
00:15:16,890 --> 00:15:19,360
...الجبان الّذي يزعم بأنّه الإمبراطور

244
00:15:19,360 --> 00:15:25,330
اشعر بقوّتي أنا، بيارغا، الّذي
!نالَ برَكة الإمبراطور الحقيقيّ

245
00:15:29,520 --> 00:15:30,410
ماذا؟

246
00:15:30,410 --> 00:15:31,470
ما هذا؟

247
00:15:31,470 --> 00:15:35,450
يبدو أنّ الحماية الّتي منحنا
إيّاها ناوفومي-تشان قد اختفت

248
00:15:36,410 --> 00:15:37,740
...هذا

249
00:15:37,740 --> 00:15:39,500
!حجر إمبراطور ساكورا

250
00:15:39,500 --> 00:15:42,130
،سلاح يُضعِف قوّة أدوات الرُّوح

251
00:15:42,130 --> 00:15:45,330
!ويُعزّز قوّة الشّخص المُبارَك بواسطة الإمبراطور

252
00:15:45,680 --> 00:15:48,710
...إنّه السّلاح المثاليّ لإيقاف الأبطال

253
00:15:49,000 --> 00:15:50,420
!ها أنا قادم

254
00:15:55,620 --> 00:15:57,260
!هالة تسوفاي

255
00:15:58,140 --> 00:16:00,150
إنّه يصدّ سحر البطل أيضاً؟

256
00:16:00,150 --> 00:16:03,110
!اقتلوا الخونة

257
00:16:04,890 --> 00:16:07,420
!كمصدر قوّتك، آمرك

258
00:16:07,420 --> 00:16:13,190
!فُكّ شفرة قوانين الطّبيعة، واطعن خصومي

259
00:16:13,980 --> 00:16:16,490
!برق الجنزير أول درايفا

260
00:16:19,540 --> 00:16:24,620
!مهما حدث، سوف أحميكما

261
00:16:24,620 --> 00:16:27,410
!ولا تنسوني

262
00:16:33,570 --> 00:16:36,570
!أنت... ميكو السّفّاحة

263
00:16:36,570 --> 00:16:39,550
أتعترضيننا بالرّغم من شروركِ؟

264
00:16:39,790 --> 00:16:43,220
!أجل. فليبدأ الذّبح

265
00:16:44,970 --> 00:16:46,460
ماذا نفعل؟

266
00:16:46,460 --> 00:16:47,930
!فلتموتا

267
00:16:47,930 --> 00:16:52,080
الإمبراطور المُزيّف وحامل أدوات
!الرُّوح الشّرّيرة

268
00:16:52,080 --> 00:16:54,240
!الضّربة المائيّة الجارحة درايفا

269
00:16:54,240 --> 00:16:55,960
!العصفة الصّخريّة درايفا

270
00:16:58,320 --> 00:16:59,720
!سادينا

271
00:17:01,410 --> 00:17:03,790
!كان ذلك ذكيّاً جدّاً يا ناوفومي-تشان

272
00:17:07,550 --> 00:17:09,600
لا بأس

273
00:17:09,600 --> 00:17:11,260
!لكن هذه هي النّهاية

274
00:17:11,260 --> 00:17:15,980
،سنقوم بهذا العمل بالنّيابة عن الإمبراطور
المُسكِّن

275
00:17:15,980 --> 00:17:20,430
،نحوّل أنفسنا إلى سيوف، وندمج قوّتك بقوّتي

276
00:17:20,430 --> 00:17:23,780
ونُنزِل قدر الدّمار على هؤلاء الحمقى

277
00:17:23,780 --> 00:17:24,970
...هل يُعقَل

278
00:17:24,970 --> 00:17:27,780
!التّعويذ النّجميّ

279
00:17:33,240 --> 00:17:34,450
ما هذا؟

280
00:17:34,450 --> 00:17:37,530
!وبهذا، تكون المعركة قد انتهت

281
00:17:39,270 --> 00:17:41,200
أهذا كلّ ما لديك؟

282
00:17:43,300 --> 00:17:45,040
ما هذه القوّة؟

283
00:17:45,040 --> 00:17:47,290
...التّعويذ النّجميّ

284
00:17:47,290 --> 00:17:50,520
تعويذ سلاح خاصّ يسمح لأولئك
الممنوحين برَكة قويّة

285
00:17:50,520 --> 00:17:55,210
بواسطة الإمبراطور أن يجمعوا قوى
الآخرين الّذين بورِكوا

286
00:17:57,980 --> 00:17:59,810
يُشاركون طاقة حياتهم أيضاً؟

287
00:18:03,250 --> 00:18:05,160
!سادينا-نيسان! غايليون

288
00:18:10,940 --> 00:18:14,480
أهذه هي كلّ القوّة الّتي يملكها
!الإمبراطور المُزيّف؟

289
00:18:15,190 --> 00:18:18,370
!هذا لا يعني شيئاً

290
00:18:18,370 --> 00:18:20,320
!أنتِ بحكم الميّتة

291
00:18:20,870 --> 00:18:22,410
!استخدم هذا

292
00:18:24,590 --> 00:18:25,530
ماذا؟

293
00:18:29,090 --> 00:18:31,510
!ترس الحجر الخاصّ بالإمبراطور ساكورا؟

294
00:18:31,510 --> 00:18:37,270
سيُعزّز قدراتك قليلاً، حتّى داخل
الحاجز الحجريّ للإمبراطور ساكورا

295
00:18:37,270 --> 00:18:38,750
...أنت

296
00:18:38,750 --> 00:18:41,390
هل خنتنا؟

297
00:18:41,390 --> 00:18:44,150
لماذا تُساعد الإمبراطور المُزيّف؟

298
00:18:44,400 --> 00:18:47,080
!أخونكم؟ هذا مُحال

299
00:18:47,080 --> 00:18:50,140
!أنا دائماً في صفّ الجميلات المُثيرات

300
00:18:51,640 --> 00:18:55,100
!لا أفهم ما يجري، لكن سأستخدمه

301
00:18:58,030 --> 00:18:59,920
!عادت قوّتي

302
00:19:00,920 --> 00:19:01,900
...بهذا

303
00:19:01,900 --> 00:19:05,110
!أذيقاهُم العذاب يا فتاتان

304
00:19:05,110 --> 00:19:08,340
!أيّها الحمقى

305
00:19:08,340 --> 00:19:11,290
!مجال التّأثير ساكورا! دعم الهجوم

306
00:19:15,300 --> 00:19:16,290
!رافتاليا

307
00:19:16,290 --> 00:19:17,060
!حسناً

308
00:19:17,060 --> 00:19:20,000
رقصة الكرز كاغورا، التّشكيل
!الأوّل: تفتُّح

309
00:19:23,310 --> 00:19:24,620
!غايليون-تشان

310
00:19:24,620 --> 00:19:26,510
!اذهب والمس لومينا الكرز

311
00:19:26,510 --> 00:19:28,340
!أستحقّ مُعاملة أفضل

312
00:19:33,740 --> 00:19:36,100
!قوّة حجر الإمبراطور ساكورا

313
00:19:36,590 --> 00:19:38,360
!الحاجز تحت سيطرتي

314
00:19:38,360 --> 00:19:40,110
!حسناً! الآن

315
00:19:40,110 --> 00:19:42,300
،في البلاد المختومة الخاصّة بالإمبراطور السّماويّ

316
00:19:42,300 --> 00:19:46,040
مشاعر تجرف وتُزيل الماء الرّاكد
القديم كتيّار نقيّ

317
00:19:46,040 --> 00:19:48,730
تصبح القوّة الّتي تنقذ العالم

318
00:19:49,240 --> 00:19:52,090
!يا وريد التنّين، أطلب منك مُعجزة

319
00:19:52,780 --> 00:19:56,080
أنا، غايليون، أوجّه أوامري للسّماوات والأرض

320
00:19:56,080 --> 00:20:00,010
اقطع قوانين الحقيقة، واربطهم معاً، واجعلهم
يبصقون القيح في داخلهم

321
00:20:00,470 --> 00:20:06,270
بواسطة قوّتي، أيقظ قوّة تدمير
!الأتباع الحمقى الّذين أمامي

322
00:20:07,020 --> 00:20:09,720
!الموجة المُدمِّرة لومينا الكرز الخاصّة بتنّين الماء

323
00:20:13,110 --> 00:20:16,350
!النّهائيّة الأسمى: ضربة القدر الجارحة

324
00:20:17,040 --> 00:20:18,780
!لم أنتهِ بعد

325
00:20:18,780 --> 00:20:20,980
لا. انتهى الأمر

326
00:20:28,880 --> 00:20:31,320
!فعلناها

327
00:20:46,210 --> 00:20:48,640
!مولايّ

328
00:20:49,540 --> 00:20:51,180
!ناوفومي-ساما

329
00:20:51,180 --> 00:20:53,310
يبدو أنّ الجميع بأمان

330
00:20:53,310 --> 00:20:55,460
التقينا مع الجميع أخيراً

331
00:20:55,460 --> 00:20:56,310
أجل

332
00:20:59,300 --> 00:21:01,590
!مولايّ

333
00:21:01,590 --> 00:21:04,030
!ناوفومي-ساما، آسف لتأخّرنا

334
00:21:06,590 --> 00:21:07,870
ساين-سان؟

335
00:21:07,870 --> 00:21:09,720
انتقلت آنيّاً إلى هنا؟

336
00:21:09,720 --> 00:21:12,290
تقول بأنّها لم تتحمّل الانتظار

337
00:21:13,280 --> 00:21:14,530
...يسرّني أنّك بخير

338
00:21:14,860 --> 00:21:18,500
لا أصدّق بأنّني سمحتُ لكِ
!بمُعانقته أمامي

339
00:21:18,500 --> 00:21:20,610
كلتاكما، ماذا تفعلان؟

340
00:21:20,610 --> 00:21:23,180
مهلاً، مهلاً. أهؤلاء نسوتك؟

341
00:21:23,180 --> 00:21:24,210
كلّا

342
00:21:25,060 --> 00:21:27,340
يسرّني أنّك بخير

343
00:21:27,340 --> 00:21:29,450
!لحظة، مُعلّم؟

344
00:21:31,620 --> 00:21:33,370
!إيلهارت-تشان

345
00:21:33,370 --> 00:21:35,240
كيف حالك؟

346
00:21:35,240 --> 00:21:37,690
...هل هو

347
00:21:37,690 --> 00:21:38,930
أجل

348
00:21:38,930 --> 00:21:41,070
لا بُدّ أنّكِ مُرهَقة من رحلة السّفينة

349
00:21:41,070 --> 00:21:43,030
لنذهب ونحتسِ بعض الشّاي

350
00:21:43,030 --> 00:21:44,640
!أرفُض

351
00:21:45,040 --> 00:21:48,430
إنّه زير نساء أكثر حتّى ممّا سمعنا

352
00:21:48,430 --> 00:21:51,790
لكن أعتقد هذا هو سبب مُوافقته
على مُساعدتنا

353
00:21:51,790 --> 00:21:55,410
الجميع هنا، لذا لنُقِم حفلة نصر

354
00:21:58,060 --> 00:22:00,520
!لا تتركوني

355
00:22:00,520 --> 00:22:04,340
!مهلاً! يا آنسة