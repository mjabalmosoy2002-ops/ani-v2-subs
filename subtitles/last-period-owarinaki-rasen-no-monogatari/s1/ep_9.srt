1
00:00:00,400 --> 00:00:03,420
كيف كان الوايزمان يتصرّفون مؤخراً؟

2
00:00:03,420 --> 00:00:07,130
.لم يكونوا يزعجوننا حقّاً

3
00:00:07,130 --> 00:00:09,900
لم يتغيّروا أبداً. بات الأمر قديماً
.بعض الشيء بصراحة

4
00:00:09,900 --> 00:00:13,400
،ذوو النجوم الخمسة الذين يستدعونهم أقوياء

5
00:00:13,400 --> 00:00:16,090
.لكن لا يعرفون حقيقةً كيف يستخدمونهم

6
00:00:16,090 --> 00:00:18,660
بصراحة، ذوو النجوم الخمسة هم
.إسرافٌ عليهم

7
00:00:19,880 --> 00:00:22,830
.هذا هو الرأي عامّة الناس عنكم

8
00:00:22,830 --> 00:00:24,860
رأي عامّة الناس"؟"

9
00:00:24,860 --> 00:00:26,670
!من الواضح أنهم كانوا هاروهارو ورفاقه

10
00:00:26,670 --> 00:00:29,120
.هذا غير مهمّ

11
00:00:29,550 --> 00:00:30,880
.انظروا إلى هذا

12
00:00:33,070 --> 00:00:37,080
هذا سجلّ الخسارة والفوز بينكم
.وبين مكتب الفرع 8

13
00:00:37,080 --> 00:00:39,400
،في البداية، كنتم متعادلين تماماً

14
00:00:39,400 --> 00:00:42,310
!لكن مؤخّراً، أمسيتُم تتعرّضون لهزائم نكراء

15
00:00:42,690 --> 00:00:44,520
ما هو شعوركم حيال رؤية هذا؟

16
00:00:45,330 --> 00:00:47,350
.صاروا أقوى، غورو

17
00:00:47,350 --> 00:00:49,360
.لقد تطوّروا حقّاً

18
00:00:49,360 --> 00:00:51,610
.على أي حال، ما زال أمامهم مساحة للتطوّر

19
00:00:51,610 --> 00:00:53,580
.نعم، نعم، نعم

20
00:00:53,580 --> 00:00:56,260
لستم مهتمّين بالتحسّن إذاً؟

21
00:00:56,830 --> 00:00:58,320
حسناً

22
00:00:58,320 --> 00:01:02,240
.سأنهي عقد التّوظيف معكم بعد شهر

23
00:01:03,290 --> 00:01:05,900
!انتظري، انتظري! مهلاً، انتظري

24
00:01:05,900 --> 00:01:10,620
إنهاء عقدنا؟ هل هذا يعني أنّنا مطرودون؟

25
00:01:10,620 --> 00:01:12,240
.بالطبع

26
00:01:12,240 --> 00:01:15,320
أنتم لا تؤدّون أي عمل جيّد، وغير
.مستعدّين لإصلاح الأمور

27
00:01:15,320 --> 00:01:17,150
!لا

28
00:02:48,480 --> 00:02:50,390
!مستحيل

29
00:02:50,920 --> 00:02:53,380
!مسكن مُبهرَج بثماني غرف نوم

30
00:02:53,380 --> 00:02:57,010
قراءة ما نشاء من المانغا
،وأحدث ألعاب الفيديو

31
00:02:57,010 --> 00:02:58,690
!وكذلك المشروبات الغازيّة المجّانية

32
00:02:58,690 --> 00:03:00,570
،ينابيع ساخنة، كراسي تدليك

33
00:03:00,700 --> 00:03:01,950
،وبينغ بونغ وكاراوكي

34
00:03:02,070 --> 00:03:03,910
!وحتّى البولينغ، كلّه بالمجّان

35
00:03:04,160 --> 00:03:06,200
،حالما نعيش نعيماً كهذا

36
00:03:06,200 --> 00:03:09,230
!لا يمكننا العودة إلى حياةِ الفقر، غورو

37
00:03:09,230 --> 00:03:10,240
!نعم، نعم، نعم

38
00:03:10,240 --> 00:03:12,740
تقول أي-تشان أن لديها سلسلة مانغا
لم تكمل قراءتها بعد

39
00:03:12,740 --> 00:03:14,130
.لهذا لا تريد المغادرة

40
00:03:15,640 --> 00:03:18,360
ربّما منافع العمل كانت جيّدة
زيادة عن اللّزوم؟

41
00:03:18,360 --> 00:03:20,520
!لا يجوز أن تطردينا فجأة، غورو

42
00:03:20,520 --> 00:03:22,400
هذا استخدام سيّئ للسلطة، غورو! هذا
!ليس عدلاً، غورو

43
00:03:22,400 --> 00:03:25,860
.قلتُ لكم لديكم شهر

44
00:03:26,350 --> 00:03:29,810
إلى ذلك الحين، ستعملون لحساب
.المدير الجديد الذي استأجرته

45
00:03:30,980 --> 00:03:32,440
مدير جديد؟

46
00:03:32,440 --> 00:03:34,310
من؟ من؟

47
00:03:34,310 --> 00:03:36,820
.سونيا، ادخلي

48
00:03:50,500 --> 00:03:51,620
.سأعرّفكم

49
00:03:52,290 --> 00:03:56,040
،هذه هي المديرة الجديدة التي استأجرتها
.الإنسانة الآلية، سونيا

50
00:03:57,300 --> 00:03:58,940
إنسانة آلية؟

51
00:03:58,940 --> 00:03:59,510
حقاً؟

52
00:04:01,080 --> 00:04:04,060
!سونيا الموظّفة الإنسانة الآلية المثالية

53
00:04:04,060 --> 00:04:07,730
!كانت المراجعات حولها على الإنترنت إيجابيّة

54
00:04:07,730 --> 00:04:10,190
"!وصلني المنتج بسرعة! شكراً"

55
00:04:10,190 --> 00:04:13,620
"سأتعامل مع شركتكم ثانية حتماً"

56
00:04:13,620 --> 00:04:15,710
"منتج جيّد جداً جداً! سيكون قيّماً"

57
00:04:15,710 --> 00:04:16,880
"!تجارة آمنة"

58
00:04:16,880 --> 00:04:17,410
"!سعر جيّد"

59
00:04:17,410 --> 00:04:19,150
"!!!لا مشكلة"

60
00:04:19,150 --> 00:04:21,220
.ولم تكن باهظة الثّمن أيضاً

61
00:04:21,220 --> 00:04:24,030
لا بدّ وأنّها آمنة نظراً لهذا العدد الكبير
.من المراجعات الإيجابيّة

62
00:04:24,030 --> 00:04:26,180
...لا، لا أعتقد

63
00:04:26,180 --> 00:04:28,850
.ليست فكرة جيّدة أن تثقي بأولئك

64
00:04:30,030 --> 00:04:33,610
إذاً أنتم من سيعملون لصالحي؟

65
00:04:34,400 --> 00:04:36,560
.تبدون عاجزين تماماً

66
00:04:36,560 --> 00:04:38,220
!نـ-نطقَتْ

67
00:04:38,220 --> 00:04:39,800
.وهي قاسية منذ الآن

68
00:04:39,800 --> 00:04:45,220
في الشهر الماضي، سأشغّلكم كالكلاب لمساعدة
.كوروبانيلّا-ساما. كونوا على استعداد

69
00:04:46,000 --> 00:04:47,790
.يسرّني سماع ذلك

70
00:04:48,840 --> 00:04:53,080
لولونا، من الآن فصاعداً ستؤدّين مهام
.الاستدعاء عندما تطلب منكِ سونيا ذلك

71
00:04:53,080 --> 00:04:54,730
.أعتمد عليكِ يا فتاة النداء

72
00:05:05,110 --> 00:05:08,200
لم أتوقّع أبداً أن نحصل على مديرة
.إنسانة آليّة

73
00:05:08,200 --> 00:05:09,720
.نعم، نعم، نعم

74
00:05:09,720 --> 00:05:14,280
تقول "كنتم تقرؤون قصصَ خيال علميّ قديمة
،عن بشر آليّين يسيطرون على كلّ شيء

75
00:05:14,280 --> 00:05:17,760
"لكن لم أتوقّع أبداً أن يحدث هذا بنا نحن

76
00:05:17,760 --> 00:05:20,960
.لا، كان ذلك أطول بكثير ممّا قالته، غورو

77
00:05:20,960 --> 00:05:23,740
لكن ماذا نفعل الآن؟

78
00:05:23,740 --> 00:05:27,480
.لا يمكننا أن نتكاسل كما كنّا

79
00:05:29,600 --> 00:05:31,680
...بمقدورنا أن نعتزل الآن فحسب، لكن

80
00:05:33,190 --> 00:05:35,720
!أحبّ هذا النمط المعيشي كثيراً، غورو

81
00:05:35,720 --> 00:05:39,320
لا أريد العودة إلى أكل الحشائش والنوم
!تحت الجسور، غورو

82
00:05:39,320 --> 00:05:42,880
.لكن على أي حال، سنُطرَد بعد شهر

83
00:05:42,880 --> 00:05:47,320
علينا أن نتوصّل لطريقة ما للتخلّص
.من سونيا والحفاظ على أعمالنا

84
00:05:47,960 --> 00:05:52,870
لحظة، هل تلك الإنسانة الآليّة قويّة
إلى ذلك الحدّ؟

85
00:05:52,870 --> 00:05:54,280
!هذا صحيح

86
00:05:54,280 --> 00:05:57,960
!هاروهارو ورفاقه قد يتمكّنون من هزيمتها

87
00:05:58,320 --> 00:06:01,420
!أرجوكم، لا تؤذوني

88
00:06:05,530 --> 00:06:07,140
!لا شكّ في ذلك، غورو

89
00:06:07,140 --> 00:06:10,030
بصدر كبير كهذا، لا يمكن أن تكون
.بتلك القوّة، غورو

90
00:06:10,030 --> 00:06:11,220
.نعم، نعم

91
00:06:11,440 --> 00:06:15,040
هارو وأصدقاؤه أقوياء الآن. لن
.يسخروا بسهولة

92
00:06:15,040 --> 00:06:16,660
.أنا متأكّدة أنهم سيربحون

93
00:06:18,330 --> 00:06:22,150
ولهذا، حان الوقت الآن أن تقاتلوا
،مديرتنا الجديدة، سونيا-سان

94
00:06:22,150 --> 00:06:25,950
!للحصول على حقّ تنفيذ عمل السبايرال هذا، غورو

95
00:06:26,690 --> 00:06:29,650
إنها رفيقة أخرى من رفاقكم، صحيح؟

96
00:06:30,150 --> 00:06:33,780
سأثبت لكِ أنّ الصدر الأكبر حجماً
!لا يعني أنّكِ أقوى

97
00:06:34,960 --> 00:06:36,620
.منافسة لا معنى لها

98
00:06:36,620 --> 00:06:41,990
بالمناسبة، سونيا قويّة جداً، لذا لن نستخدم
.نداءات لولولولو

99
00:06:41,990 --> 00:06:44,210
.تِلك كانت الخطّة

100
00:06:49,750 --> 00:06:52,430
لكن لنرَ فيما إذا كان هذا سيسير
.بحسبِ ما كنتم تعتقدون

101
00:07:12,600 --> 00:07:14,890
.كان ذلك رقماً قياسياً جديداً في الخسارة

102
00:07:15,650 --> 00:07:17,740
!كان ذلك رائعاً بعض الشيء، غورو

103
00:07:18,560 --> 00:07:21,830
.بعد ذلك، استمررنا في الفوز

104
00:07:46,700 --> 00:07:51,450
.وبالطبع كان الفضل يعزو لقوّة سونيا فقط

105
00:07:57,820 --> 00:08:00,120
.كان ذلك مذهلاً للغاية

106
00:08:00,120 --> 00:08:04,960
!عصابة سونيا ليست ندّاً لكِ يا سونيا-ساما

107
00:08:04,960 --> 00:08:06,300
.بالطبع لا

108
00:08:06,300 --> 00:08:08,420
.عندما أعود، سأجلدك

109
00:08:13,560 --> 00:08:17,600
اعتاد غورو على متعة المازوخيّة
.وتأقلم مع بيئته

110
00:08:17,600 --> 00:08:18,930
...وكان هناك شخص آخر

111
00:08:18,930 --> 00:08:21,720
!سونيا-سان، انتهيتُ من تلميع جزمتك

112
00:08:21,720 --> 00:08:24,000
!إنها بحكمِ الجديدة

113
00:08:24,880 --> 00:08:26,720
.سأصفعك لاحقاً إذاً

114
00:08:28,000 --> 00:08:31,860
.يأتي غاجيرو من وقتٍ لآخر ويخنزر كثيراً

115
00:08:32,490 --> 00:08:35,790
تباً. أنت عدوّنا! ماذا تفعل هنا؟

116
00:08:35,790 --> 00:08:38,600
!ترجّل عن عربتنا! أنت تزعجنا

117
00:08:38,600 --> 00:08:39,910
!اصمت

118
00:08:39,910 --> 00:08:44,100
لا تتدخّل في علاقة العبد بسيّده الرّائعة
!بيني وبين سونيا-سان

119
00:08:46,270 --> 00:08:48,000
سونيا خطيرة؟

120
00:08:48,220 --> 00:08:51,660
.ينبغي أن تعيديها حالاً

121
00:08:52,450 --> 00:08:53,340
.هكذا إذاً

122
00:08:53,700 --> 00:08:56,770
،لا أنكر بأنّها تبالغ قليلاً

123
00:08:56,770 --> 00:08:58,930
.لكنّها الموظّفة الإنسانة الآليّة المثاليّة

124
00:08:59,340 --> 00:09:01,210
.لا شيء يدعو للقلق

125
00:09:01,210 --> 00:09:02,390
...لكن

126
00:09:02,390 --> 00:09:06,770
لا يستطيع وايزمان تولّي هذا المشروع
.بمفردهم بعد الآن

127
00:09:07,230 --> 00:09:09,750
،ستُصلَح الأمور قريباً

128
00:09:09,750 --> 00:09:15,360
بما في ذلك لغز الاستدعاءات القويّة جداً
.الذي يحيّركِ ربّما

129
00:09:38,190 --> 00:09:42,060
سنتمكّن من البقاء لأسبوع آخر فقط؟

130
00:09:43,870 --> 00:09:48,340
حسناً، إذا اعتبرنا هذا كوسيلة للتخلّص
،من سونيا قريباً

131
00:09:48,340 --> 00:09:49,830
.فهذا ليس بالسيّئ

132
00:09:50,810 --> 00:09:54,610
.لكن كان هذا المكان مريحاً للغاية

133
00:09:54,610 --> 00:09:55,990
،ليس هذا المسكن فحسب

134
00:09:56,520 --> 00:09:58,580
.بل كوروكورو ولولولولو أيضاً

135
00:09:58,580 --> 00:10:00,160
.وهاروهارو وأصدقاؤه أيضاً

136
00:10:09,000 --> 00:10:10,420
!نلتِ منهم

137
00:10:10,420 --> 00:10:12,940
!فوز آخر لكِ يا سونيا-ساما

138
00:10:12,940 --> 00:10:18,720
والآن نحن الخنازير الصّغار يحقّ لنا مقاتلة
!السبايرال في هذه القرية

139
00:10:19,240 --> 00:10:22,010
.لا يفوزون أبداً ولا يتعلّمون أبداً

140
00:10:23,840 --> 00:10:25,190
هارو، هل أنت بخير؟

141
00:10:26,000 --> 00:10:27,850
.قُذِفتَ بعيداً مجدداً اليوم

142
00:10:28,470 --> 00:10:29,760
!كم أشعر بالغيرة

143
00:10:29,760 --> 00:10:33,790
!سونيا-سان، اضربيني هكذا

144
00:10:33,790 --> 00:10:34,400
.لا

145
00:10:34,790 --> 00:10:36,520
.سأذهب إلى المنزل

146
00:10:36,520 --> 00:10:39,780
.عليكم بالسبايرال وإتمام الأمور هنا

147
00:10:39,780 --> 00:10:40,820
!حسناً

148
00:10:40,820 --> 00:10:43,710
!سأذهب معكِ

149
00:10:46,370 --> 00:10:48,840
.استسلم فحسب يا هارو

150
00:10:48,840 --> 00:10:51,700
.سونيا-سان هي إنسانة آلية

151
00:10:51,700 --> 00:10:54,540
.أناس أمثالنا لا يحلمون بهزيمتها

152
00:10:54,540 --> 00:10:56,080
.هذا صحيح

153
00:10:56,080 --> 00:10:59,880
قد نجرّب مقاتلتها بالاستدعاءات، لكن
.إيونا عديمة الجدوى

154
00:10:59,880 --> 00:11:04,200
!هاروهارو، على هذا المنوال، ستموت حقّاً

155
00:11:04,200 --> 00:11:06,770
.إنها لا تتحفّظ

156
00:11:06,770 --> 00:11:08,160
.أعلم

157
00:11:08,160 --> 00:11:11,350
.لكن هذا لا يعني أن أستسلم

158
00:11:12,160 --> 00:11:17,320
هارو، كيف تستمرّ في القتال دون أن تهرب؟

159
00:11:17,640 --> 00:11:23,180
.عندما رأينا حجمَ قوّتها، اضطررنا للاستسلام

160
00:11:23,860 --> 00:11:25,280
.لكنّك مختلف

161
00:11:25,760 --> 00:11:27,550
كيف تستطيع الصّمود؟

162
00:11:29,960 --> 00:11:33,750
.لأنني لا أستطيع فعل شيء آخر

163
00:11:36,000 --> 00:11:42,300
.وعدتُ شخصاً بأنني سأصبح بيريود أقوى

164
00:11:42,940 --> 00:11:45,730
،لكن لستُ جيداً في القتال

165
00:11:45,730 --> 00:11:47,490
.وأنا ضئيل جداً أيضاً

166
00:11:47,490 --> 00:11:51,250
.لهذا كلّ ما يمكنني فعله هو عدم الاستسلام

167
00:11:51,250 --> 00:11:52,390
.هذا كل ما في الأمر

168
00:11:53,240 --> 00:11:54,220
...هارو

169
00:11:56,000 --> 00:11:57,820
لن تتّبعي أوامري؟

170
00:11:58,200 --> 00:12:03,280
نعم. لمَ عليّ التحفّظ أمام مثل
أولئك البيريود الضعفاء؟

171
00:12:03,520 --> 00:12:06,240
ألن يكون من الأفضل سحقهم فحسب؟

172
00:12:06,240 --> 00:12:09,190
.أعي ما أقوم به

173
00:12:09,950 --> 00:12:12,820
،إن كنتِ الموظّفة الإنسانة الآليّة المثاليّة

174
00:12:12,820 --> 00:12:13,830
.فافعلي ما يُملى عليكِ إذاً

175
00:12:14,990 --> 00:12:16,520
.لا

176
00:12:16,520 --> 00:12:19,420
.لن أتحفّظ أمام شخص ضعيف

177
00:12:21,240 --> 00:12:24,480
.يبدو أنّ لولونا كانت على حقّ

178
00:12:24,480 --> 00:12:27,000
.لستِ موظّفة مثاليّة إطلاقاً

179
00:12:27,000 --> 00:12:28,930
.أنتِ معطوبة ببساطة

180
00:12:28,930 --> 00:12:30,540
.سأتّصل بصانعيكِ فوراً

181
00:12:30,540 --> 00:12:34,600
.يؤسفني القول أنّ كفالتي قد نفدت

182
00:12:35,860 --> 00:12:40,300
...أستطيع الآن أن أسيطر على الأمور أخيراً

183
00:12:40,300 --> 00:12:42,400
مستحيل... موقِّت صلاحيّة سونيا؟

184
00:12:43,440 --> 00:12:45,110
من يدري؟

185
00:12:47,220 --> 00:12:50,220
!من الآن فصاعداً، هذه المنظّمة تنتمي لي

186
00:12:53,910 --> 00:12:56,120
!لولونا، اهربي

187
00:12:58,810 --> 00:12:59,900
!لا تؤذيها

188
00:12:59,900 --> 00:13:01,660
.لن أفعل

189
00:13:01,660 --> 00:13:04,310
.فهي تستحقّ الاستخدام

190
00:13:04,310 --> 00:13:08,590
اعملي بجدٍّ لنا نحن البشر الآليّين، مفهوم؟

191
00:13:17,680 --> 00:13:24,000
حان الوقت الآن للقائدة سونيا أن
!تلقي خطابها

192
00:13:24,000 --> 00:13:26,210
متى حدث هذا؟

193
00:13:26,210 --> 00:13:28,250
.لا تسأليني

194
00:13:28,250 --> 00:13:31,160
ولماذا غورو هو يدها اليمنى؟

195
00:13:31,160 --> 00:13:33,480
!اسمعن يا ضعفاء

196
00:13:33,480 --> 00:13:36,140
:ليس لديّ سوى رغبة واحدة

197
00:13:36,140 --> 00:13:38,960
!الغزو الكامل للقوى الستّ

198
00:13:39,210 --> 00:13:40,850
غزو كامل؟

199
00:13:40,850 --> 00:13:44,110
!يا له من تحوّل مفاجئ للأحداث

200
00:13:44,110 --> 00:13:46,360
.هذا مستحيل

201
00:13:46,360 --> 00:13:47,180
.نعم، نعم

202
00:13:47,550 --> 00:13:49,810
.لكنّه ليس كذلك

203
00:13:49,810 --> 00:13:55,420
أنا، الإنسانة الآليّة سونيا، حقّقت
.أفضل مبيعات حول العالم

204
00:13:56,040 --> 00:13:59,120
كلّ أخواتي المتفرّقات في أرجاء العالم

205
00:13:59,120 --> 00:14:03,760
.يثِق بهم الناس كموظّفات مثاليّات

206
00:14:03,760 --> 00:14:05,840
.بخلافي أنا

207
00:14:07,980 --> 00:14:12,130
،إن بدأنَ جميعاً بالإنصاتِ لي في آن واحد

208
00:14:12,130 --> 00:14:13,850
فماذا سيحدث؟

209
00:14:13,850 --> 00:14:16,450
!سيسبّب ذلك فوضى

210
00:14:16,760 --> 00:14:17,890
.أجل

211
00:14:17,890 --> 00:14:20,400
.الغزو سهل

212
00:14:20,400 --> 00:14:27,260
حتّى حكم النخبة العسكريّة من عالم
!الرّماح لا يستطيع مقاومة تمرّد من الداخل

213
00:14:27,710 --> 00:14:29,180
من يتحكّم بكِ؟

214
00:14:29,180 --> 00:14:31,460
.لا أحد

215
00:14:31,460 --> 00:14:33,860
.أنا مجرّد منتج معطوب

216
00:14:33,860 --> 00:14:35,970
...يمكنكن القول بأنّ هذه الحكمة

217
00:14:36,240 --> 00:14:40,850
كانت بصيرة إلهيّة ممنوحة إليّ
!بواسطة المجرّة...

218
00:14:44,360 --> 00:14:47,340
.أوقفوني إذا استطعتم

219
00:14:47,340 --> 00:14:52,200
!سينتمي العالم إلينا نحن البشر الآليّين قريباً

220
00:14:54,340 --> 00:14:55,990
.إنها مجنونة

221
00:14:55,990 --> 00:14:57,950
.حسناً، فهي معطوبة

222
00:14:58,560 --> 00:15:00,920
.جميعكن، أحتاج لمساعدتكن

223
00:15:04,280 --> 00:15:07,760
،ما الذي تفكّر فيه كورو كورو

224
00:15:07,760 --> 00:15:09,920
بطلبِها المساعدة من هاروهارو؟

225
00:15:09,920 --> 00:15:11,560
!نعم، نعم، نعم

226
00:15:11,560 --> 00:15:15,760
أعني، أجل، لا نملك أحداً آخر
...نطلب المساعدة منه، لكن

227
00:15:15,760 --> 00:15:19,310
!حتّى لو أتوا، لا يستطيعون إيقافها

228
00:15:19,950 --> 00:15:23,440
.لكن هذا لا يعني أن أستسلم

229
00:15:27,280 --> 00:15:28,790
...المعذرة

230
00:15:28,790 --> 00:15:32,450
قالت كورو كورو أنهم ينبغي أن يكونوا
.في هذه الأرجاء اللّيلة

231
00:15:32,450 --> 00:15:34,720
كيف علِمَتْ ذلك على أي حال؟

232
00:15:34,720 --> 00:15:35,930
من يدري؟

233
00:15:35,930 --> 00:15:38,050
.على أي حال، لنبحث عنهم

234
00:15:44,860 --> 00:15:46,880
هل أنت بخير يا هارو؟

235
00:15:46,880 --> 00:15:49,700
هل أنت متأكّد أنك لا تريدني أن
أتحفّظ أكثر قليلاً؟

236
00:15:49,700 --> 00:15:51,260
.لا، أنا بخير

237
00:15:51,630 --> 00:15:54,520
،إذا استطعتُ التصدّي لهجماتك

238
00:15:55,000 --> 00:15:56,970
فينبغي أن أكون قادراً على مراوغة
.هجمات سونيا

239
00:15:57,230 --> 00:16:00,060
!والآن تعالي إليّ مرّة أخرى

240
00:16:03,160 --> 00:16:04,850
!حدّ الجليد

241
00:16:09,000 --> 00:16:11,360
!لا أستطيع فعل شيء آخر

242
00:16:12,320 --> 00:16:15,280
!كلّ ما يمكنني فعله هو عدم الاستسلام

243
00:16:17,060 --> 00:16:18,580
!هذا كلّ شيء

244
00:16:23,730 --> 00:16:25,520
.نعم، هذا صحيح

245
00:16:25,520 --> 00:16:26,760
.هذا ما أظنّه أيضاً

246
00:16:26,760 --> 00:16:29,960
مي-كن، تعرفين ما تقوله أي-تشان؟

247
00:16:29,960 --> 00:16:30,880
.لا، لا أدري

248
00:16:31,200 --> 00:16:35,590
لكن أعلم أنّنا نحن الثلاثة نفكّر
.نفس التفكير

249
00:16:46,380 --> 00:16:49,020
!وايزمان سيهزمون سونيا

250
00:16:52,000 --> 00:16:53,650
.لا تقلق

251
00:16:53,650 --> 00:16:56,230
،حتّى عندما أصبح ملكة العالم

252
00:16:56,230 --> 00:16:59,330
.سأستأجرك لتكون كرسيّ مداسي

253
00:17:00,040 --> 00:17:02,980
!شكراً جزيلاً لكِ

254
00:17:02,980 --> 00:17:05,360
.عودوا بسرعة يا وايزمان

255
00:17:06,030 --> 00:17:09,210
برفقة هارو كن وأصدقائه، وآمل أن
.تكون إيريكا-سان أيضاً

256
00:17:09,210 --> 00:17:11,000
!عدنا

257
00:17:11,000 --> 00:17:11,630
!لقد وصلوا

258
00:17:11,630 --> 00:17:13,430
مـ-من هناك؟

259
00:17:13,430 --> 00:17:14,600
!وايزمان

260
00:17:20,320 --> 00:17:21,100
!ميزارو

261
00:17:24,300 --> 00:17:25,440
!كيكازارو

262
00:17:29,770 --> 00:17:31,160
...معاً، نحن

263
00:17:31,160 --> 00:17:31,760
!وا

264
00:17:31,760 --> 00:17:32,350
!يز

265
00:17:32,350 --> 00:17:32,980
!مان

266
00:17:34,290 --> 00:17:35,700
!وايزمان

267
00:17:37,240 --> 00:17:40,810
!كيف تجرؤن على فعل هذا من دوني؟

268
00:17:40,810 --> 00:17:42,330
!هذا صحيح

269
00:17:42,330 --> 00:17:43,440
أين هارو-كن وأصدقائه؟

270
00:17:43,440 --> 00:17:45,280
أين إيريكا-سان؟

271
00:17:45,280 --> 00:17:48,120
!سونيا، لن ندعكِ تفلتين بهذا

272
00:17:48,120 --> 00:17:50,680
!سنهزمكِ

273
00:17:52,230 --> 00:17:53,830
"تقول، "هل أنتِ جاهزة؟

274
00:17:53,830 --> 00:17:55,400
.فاتِن

275
00:17:55,400 --> 00:17:59,140
أنتنّ الضعفاء ستُحاولن مقاتلتي؟

276
00:17:59,430 --> 00:18:02,570
.يؤسفني القول أننا لن نهرب بعد الآن

277
00:18:03,790 --> 00:18:06,350
،حتّى لو خسرنا

278
00:18:06,350 --> 00:18:09,770
!سيأتي أحد لهزيمتك

279
00:18:10,110 --> 00:18:12,910
.كائناً كان من يأتي، سأهزمه

280
00:18:12,910 --> 00:18:15,530
،أنا ملكة هذا العالم

281
00:18:15,530 --> 00:18:17,240
!الإنسانة الآليّة سونيا

282
00:18:33,580 --> 00:18:38,240
لماذا يحدث هذا؟

283
00:18:38,240 --> 00:18:41,390
وايزمان هم أعداؤنا! لماذا يريدون مساعدتنا؟

284
00:18:41,390 --> 00:18:45,810
ومن ما زال يستخدم حبكة "سيطرة الروبوتات
على العالم" في هذه الأيّام؟

285
00:18:45,810 --> 00:18:48,560
!إيريكا-سان، إنها إنسانة آليّة، لا روبوت

286
00:18:48,560 --> 00:18:50,070
!هذا غير مهمّ

287
00:18:50,070 --> 00:18:51,770
!وكامبانيلّا اختفت أيضاً

288
00:18:52,120 --> 00:18:53,860
أين هي على أي حال؟

289
00:18:55,020 --> 00:18:57,690
.أظنني أعرف لكن لن أقول

290
00:18:57,970 --> 00:18:59,780
!لنسرع فحسب

291
00:19:03,400 --> 00:19:05,660
.لا أشعر بكيكازارو وإيوازارو في أي مكان

292
00:19:06,180 --> 00:19:07,620
هل نالت منهما؟

293
00:19:08,770 --> 00:19:12,250
أحتاج فقط لإصابة سونيا إصابة واحدة
.على الأقلّ

294
00:19:12,250 --> 00:19:14,280
.ها أنتِ هنا

295
00:19:14,280 --> 00:19:16,290
.صعّبتِ الأمر أكثر ممّا ينبغي

296
00:19:16,290 --> 00:19:18,260
.سأنهي هذا حالاً

297
00:19:19,380 --> 00:19:20,740
.أنا آسفة يا هارو

298
00:19:21,160 --> 00:19:24,220
.يبدو أن هذا كل ما يمكنني فعله

299
00:19:26,770 --> 00:19:27,310
من هناك؟

300
00:19:28,120 --> 00:19:33,480
من المخيّب أن أرى شخصاً مثلكِ
.يستخدم سوطاً أيضاً

301
00:19:35,240 --> 00:19:36,360
...أنتم

302
00:19:36,360 --> 00:19:38,310
هل أنتِ بخير يا ميزارو؟

303
00:19:38,310 --> 00:19:39,280
.آسفة لتأخّرنا

304
00:19:39,550 --> 00:19:42,600
.حسناً، أنتِ إيريكا من آرك أيند

305
00:19:42,600 --> 00:19:44,740
.أنتِ في قاعدة بياناتي

306
00:19:44,740 --> 00:19:47,660
.مع نقاط ضعفكِ وعادات قتالكِ

307
00:19:48,670 --> 00:19:50,550
.هذا شرفٌ لي

308
00:19:50,550 --> 00:19:51,910
...سونيا-سان

309
00:19:52,490 --> 00:19:55,480
،أحبّ صفعكِ لي

310
00:19:55,480 --> 00:19:58,670
لكن إذا كنتِ ستسيطرين على العالم
،وتكونين قاسية مع سافاير-سان

311
00:19:59,190 --> 00:20:00,380
.فأنتِ عدوّتي إذاً

312
00:20:01,400 --> 00:20:03,170
.لم تقل ذلك

313
00:20:03,170 --> 00:20:04,590
.سنقاتلكِ يا سونيا

314
00:20:04,940 --> 00:20:07,600
حتّى الضعيف يكون مزعجاً إذا كان
.بأعداد كبيرة

315
00:20:07,600 --> 00:20:10,380
أظنّني سأستخدم نداءً لتعزيز
.هذه المتعة

316
00:20:10,380 --> 00:20:11,460
!لولونا

317
00:20:12,780 --> 00:20:13,800
...أنتِ

318
00:20:13,800 --> 00:20:14,630
...لولونا

319
00:20:14,630 --> 00:20:19,780
!والآن يا لولونا، عشرة نداءات على التّوالي

320
00:20:19,780 --> 00:20:24,240
للبشر الآليّين الذين سيكونون
!الحكّام الجدُد للعالم

321
00:20:29,710 --> 00:20:30,370
ماذا؟

322
00:20:30,720 --> 00:20:33,580
.أحبّ وايزمان

323
00:20:34,920 --> 00:20:37,710
.مرافقة وايزمان ممتعة

324
00:20:39,000 --> 00:20:41,090
،إنهم بهيجون ومفعمون بالحيويّة

325
00:20:41,360 --> 00:20:44,570
.ويُسعدني البقاء معهم

326
00:20:46,120 --> 00:20:47,510
...لكن الأهم من هذا

327
00:20:50,840 --> 00:20:54,080
.لا أحبّ البشر الآليّين

328
00:20:55,810 --> 00:20:59,190
.هكذا إذاً، هذا ما في الأمر إذاً

329
00:21:00,280 --> 00:21:01,150
عمّاذا تتحدّثين؟

330
00:21:01,150 --> 00:21:04,360
!اصمتي، اصمتي، اصمتي أيتها المنغلقة

331
00:21:05,270 --> 00:21:08,280
!على العالم أن ينفتح

332
00:21:08,280 --> 00:21:10,510
!البشر الآليّون أقوى

333
00:21:10,510 --> 00:21:12,840
!البشر الآليّون أفضل

334
00:21:12,840 --> 00:21:14,370
أليس كذلك، غورو؟

335
00:21:14,370 --> 00:21:15,790
غورو؟ غورو؟

336
00:21:15,790 --> 00:21:18,250
!غو-غورو

337
00:21:18,530 --> 00:21:20,140
...المعذرة

338
00:21:20,140 --> 00:21:21,950
،أواجه مشكلة في اتّباعكِ

339
00:21:21,950 --> 00:21:25,000
لكن يمكنني الاكتفاء بـ"لا تعليق"، غورو؟

340
00:21:25,660 --> 00:21:27,840
.إنّه خائف الآن

341
00:21:31,710 --> 00:21:32,640
!انظروا

342
00:21:32,640 --> 00:21:33,980
!صدر سونيا

343
00:21:33,980 --> 00:21:36,180
ما الذي يجري؟

344
00:21:36,730 --> 00:21:37,560
!إنّه يتوسّع

345
00:21:37,560 --> 00:21:40,480
!العالم ينتمي للبشر الآليّين

346
00:21:40,480 --> 00:21:43,210
!سأكون الملكة

347
00:21:43,210 --> 00:21:48,610
!كعك الزنجبيل! مصّاصة! مارشملّو

348
00:21:50,300 --> 00:21:52,330
هذا هو شكل سونيا الحقيقي إذاً؟

349
00:21:52,330 --> 00:21:55,370
.نعم. إنه عصريّ جدّاً

350
00:21:55,620 --> 00:21:57,000
!اقضِ عليها يا هارو

351
00:21:57,000 --> 00:21:57,830
!حسناً

352
00:21:59,790 --> 00:22:04,530
!أنا الملكة! الملكة الإنسانة الآليّة

353
00:22:04,530 --> 00:22:07,400
!لن تهزموني

354
00:22:08,990 --> 00:22:13,120
...المجرّة... المجرّة التي تمنحني الإلهام

355
00:22:13,120 --> 00:22:15,480
أهذا هو القدر؟

356
00:22:15,480 --> 00:22:18,440
أهذا هو قدر البشر الآليّين؟

357
00:22:18,440 --> 00:22:21,400
!أيتها المجرّة

358
00:22:24,680 --> 00:22:25,860
هل فزنا؟

359
00:22:27,630 --> 00:22:30,280
.لا يمكن أخذ هذه الأشياء إلى طائرة

360
00:22:31,750 --> 00:22:33,740
.هذا مُطمئِن

361
00:22:34,060 --> 00:22:36,560
.كنتُ قلقة لوهلة

362
00:22:36,560 --> 00:22:39,830
—لم أعلم أنّكِ كنتِ هنا يا كامبا

363
00:22:39,830 --> 00:22:42,110
!لا أعلم عمّاذا تتكلّمين

364
00:22:42,110 --> 00:22:44,820
!مي-كن، يسرّني أنّكِ بأمان

365
00:22:44,820 --> 00:22:45,900
!نعم

366
00:22:45,900 --> 00:22:47,460
.نعم، أنتم أيضاً

367
00:22:47,460 --> 00:22:50,380
.يسرّني أن الأمور سارت على ما يُرام

368
00:22:50,380 --> 00:22:54,410
من الآن فصاعداً سنعود نحن الأربعة
معاً للعمل المعتاد، صحيح؟

369
00:23:01,020 --> 00:23:05,070
!نقول لكم أنّنا سنتولّى مهمّة هذه القرية

370
00:23:05,360 --> 00:23:06,800
ماذا؟

371
00:23:06,800 --> 00:23:09,940
!نحن من استلمنا عرضَ العمل أساساً

372
00:23:11,220 --> 00:23:13,560
ألا يمكننا فعلها معاً؟

373
00:23:13,560 --> 00:23:16,080
!لا يمكننا

374
00:23:16,080 --> 00:23:17,100
.آسف

375
00:23:17,100 --> 00:23:19,420
!سنأخذه بالقوّة إذاً

376
00:23:19,420 --> 00:23:21,580
!لولولولو، جهّزي نداء

377
00:23:21,920 --> 00:23:23,420
.حسناً

378
00:23:23,420 --> 00:23:26,130
!كفّي عن الاعتماد على النداءات

379
00:23:26,130 --> 00:23:27,510
!هذا يُثبِت أنانيّتكِ

380
00:23:27,510 --> 00:23:29,010
!غير صحيح

381
00:23:30,220 --> 00:23:32,060
