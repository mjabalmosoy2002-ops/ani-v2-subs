.قدّم تانوما سويتشي أداءً مذهلًا

188
00:10:18,280 --> 00:10:20,830
...تانوما... سويتشي

189
00:10:21,600 --> 00:10:24,560
تانوما

190
00:10:25,280 --> 00:10:28,060
!سيقيم أحدهم كوشين شاميسن تسوغارو في طوكيو

191
00:10:28,330 --> 00:10:29,580
.نحن وسط درس

192
00:10:29,920 --> 00:10:32,820
.من الممكن أن يشارك فيها ساوامورا سيتسو

193
00:10:32,820 --> 00:10:35,660
!"أتريان؟ إنّها تدعى "كأس ماتسوغورو

194
00:10:37,080 --> 00:10:40,700
.سبق وسمعت بشأنها من أستاذي في المدرسة

195
00:10:41,490 --> 00:10:43,270
.يبدو أنّها ستكون ممتعة جدًّا

196
00:10:45,290 --> 00:10:48,460
...أجل. أنت جميلة كعادتك اليوم

197
00:10:48,760 --> 00:10:50,330
.يا كيورا 2 خاصّتي

198
00:10:55,190 --> 00:10:57,130
...المشاعر الّتي انتابتني آنذاك

199
00:10:57,650 --> 00:10:59,500
.أغلقت الغطاء عليها قبل وقت طويل

200
00:11:01,040 --> 00:11:02,920
.كنت أتضوّر في ذلك الوقت

201
00:11:03,840 --> 00:11:08,270
.يستحيل ببساطة إيقاظ تلك المشاعر مرّة أخرى

202
00:11:09,270 --> 00:11:10,440
لديك 1 رسالة جديدة من كويابو كيكو

203
00:11:13,410 --> 00:11:15,040
"...كاميكي سيريو-ساما"

204
00:11:15,040 --> 00:11:17,690
".أرجو أن تنصت لقلقي كمعلّمة"

205
00:11:17,990 --> 00:11:22,060
في الحقيقة، يكافح الجميع للانسجام"
".في نادي تقدير الشّاميسن

206
00:11:22,060 --> 00:11:25,200
على هذا الحال، أشكّ أنّنا سنستطيع"
".حتّى المشاركة في المسابقة

207
00:11:25,850 --> 00:11:27,070
مسابقة؟

208
00:11:27,080 --> 00:11:29,830
أكاديميّة أوميزونو

209
00:11:27,080 --> 00:11:30,910
معلّمة

210
00:11:27,240 --> 00:11:32,720
،كان ساوامورا سيتسو-كن يعلّم البقيّة"
".لكن قد يكون ذلك مرهقًا جدًّا عليه

211
00:11:29,410 --> 00:11:43,260
تمّ إدراج ملف 1

212
00:11:33,160 --> 00:11:36,450
".'هذا ساوامورا-كن يعزف 'شينبوشي"

213
00:11:36,450 --> 00:11:39,680
".لكن لا أدري إن كان هذا صائبًا أم لا"

214
00:11:39,680 --> 00:11:42,740
".فهو لا يستطيع قراءة الموسيقى"

215
00:11:43,260 --> 00:11:44,050
تمّ إدراج ملف 1

216
00:11:49,370 --> 00:11:52,290
...إنّها حادّة وقاسية... جامحة وشرسة

217
00:11:52,290 --> 00:11:54,320
!نقره والباتشي غير منتظمين

218
00:11:55,290 --> 00:11:57,940
.لا أفهم

219
00:11:58,570 --> 00:12:02,550
ماذا سيحدث إن أطلق ساوامورا سيتسو العنان لصوته الحقيقيّ؟

220
00:12:03,150 --> 00:12:04,440
!لا أدري فحسب

221
00:12:07,490 --> 00:12:08,870
.لا أفهم

222
00:12:10,500 --> 00:12:13,670
...هل سمعت؟ يقال أنّ والد سيتسو-كن

223
00:12:13,670 --> 00:12:15,030
!مستحيل

224
00:12:15,030 --> 00:12:16,420
...صوتي

225
00:12:16,600 --> 00:12:17,710
لمن ذلك الصّوت؟

226
00:12:21,640 --> 00:12:24,970
ورثت الرّوح الحيّة لصوته، أليس كذلك؟

227
00:12:25,240 --> 00:12:27,100
!أنا أمّك

228
00:12:27,530 --> 00:12:28,970
لمَ لن تشارك في المسابقة؟

229
00:12:30,970 --> 00:12:32,980
كاريوكي

230
00:12:38,540 --> 00:12:40,030
.لا أفهم

231
00:12:44,510 --> 00:12:45,710
...لا أفهم

232
00:12:49,180 --> 00:12:50,620
!لا أفهم

233
00:12:52,550 --> 00:12:56,570
!أريد صوتًا لا يرتبط... بأيّ شيء

234
00:13:24,910 --> 00:13:27,330
...عـ-عذرًا، ساوامورا-كن

235
00:13:27,330 --> 00:13:28,910
هل لديك بعض الوقت الآن؟

236
00:13:35,630 --> 00:13:38,270
...في الواقع

237
00:13:38,270 --> 00:13:39,760
.آسف بشأن ذلك اليوم

238
00:13:39,760 --> 00:13:40,760
ماذا؟

239
00:13:40,760 --> 00:13:42,190
.أفسدتُ الأجواء

240
00:13:42,190 --> 00:13:44,640
...لـ-لا على الإطلاق! بل نحن من

241
00:13:44,640 --> 00:13:46,510
.لسنا جيّدين جدًّا

242
00:13:46,510 --> 00:13:49,520
.لست متفاجئة لأنّك سئمت منّا يا ساوامورا-كن

243
00:13:50,240 --> 00:13:54,520
.أحببت صوت جدّي. أردتُ أن أكون مثله تمامًا

244
00:13:56,670 --> 00:14:00,940
،كان لا بأس عندما كان هدفي، لكن الآن وقد رحل

245
00:14:00,940 --> 00:14:03,150
.أصبح قيدًا

246
00:14:03,150 --> 00:14:06,150
قيدًا؟ أتقصد جدّك؟

247
00:14:06,550 --> 00:14:08,540
.لا أحد مهتمّ بي

248
00:14:09,120 --> 00:14:12,720
.بل يريدون سماع الشّيء الّذي يدعمني: صوت جدّي

249
00:14:13,740 --> 00:14:15,490
!أنت هو أنت يا ساوامورا-كن

250
00:14:17,890 --> 00:14:20,330
!ساوامورا-كن، تملك صوتك الخاصّ

251
00:14:20,840 --> 00:14:22,700
ألا تذكر ما قالته جدّتي؟

252
00:14:22,700 --> 00:14:25,050
.لديك طيبةٌ تُشفي

253
00:14:25,050 --> 00:14:28,010
...ولم تشفِ جدّتي فحسب

254
00:14:28,010 --> 00:14:29,720
.بل وشفيتني أيضًا

255
00:14:30,170 --> 00:14:33,530
.استطعتُ أن أساعد جدّتي على سماع تلك الأغنيّة ثانيةً

256
00:14:33,530 --> 00:14:35,690
.أنجزت هدفي

257
00:14:35,690 --> 00:14:38,940
.لكن لم أرد أن تكون تلك نهاية رحلتي مع شاميسن تسوغارو

258
00:14:39,410 --> 00:14:43,030
.وذلك لأنّني تأثّرت كثيرًا بصوتك يا ساوامورا-كن

259
00:14:43,690 --> 00:14:45,500
،ومع أنّي أدري أنّ ذلك مستحيل

260
00:14:45,500 --> 00:14:48,440
.إلّا أنّي أردت أن أقترب ولو قليلًا منه

261
00:14:54,380 --> 00:14:57,370
.لهذا أريد الأداء في المسابقة

262
00:14:57,370 --> 00:14:59,000
.أريد أن أعمل بجدّ مع الجميع

263
00:15:01,570 --> 00:15:04,800
.أنتما! كنتما هنا إذًا

264
00:15:05,210 --> 00:15:06,640
!كويابو-سينسي؟

265
00:15:06,640 --> 00:15:10,030
.لم تكونا في الفصل، لذا كنت أبحث عنكما

266
00:15:10,030 --> 00:15:12,310
!في الواقع، لديّ أخبار مهمّة

267
00:15:14,970 --> 00:15:19,190
.مفاجأة! أتى كاميكي سيريو-سان لرؤية كيف تبلون جميعًا

268
00:15:19,190 --> 00:15:20,430
يا للهول! هو شخصيًّا؟

269
00:15:20,430 --> 00:15:21,690
لماذا؟ لكن كيف؟

270
00:15:21,690 --> 00:15:23,760
!يا إلهي! إنّه وسيم حقًّا

271
00:15:24,200 --> 00:15:25,320
ماذا؟

272
00:15:25,320 --> 00:15:28,800
.أخبرته أنّكم تعملون جميعًا من أجل المشاركة في المسابقة

273
00:15:28,800 --> 00:15:32,710
!لذا اقترح أن يستمع لعزفكم ويسديكم النّصح

274
00:15:33,150 --> 00:15:35,660
.أعترف، إنّه سبب ضعيف

275
00:15:36,090 --> 00:15:38,540
،المعذرة. نحن ممتنّون حقًّا

276
00:15:38,540 --> 00:15:42,560
.لكن لا أحد هنا يستطيع عزف مقطوعة "شينبوشي" غيره

277
00:15:42,560 --> 00:15:45,160
هل تخطّطون لمجاراة أسلوب ساوامورا فيها؟

278
00:15:45,570 --> 00:15:47,660
.لن أجاريهم

279
00:15:47,660 --> 00:15:49,510
.لأنّ خاصّتي غير منتظمة

280
00:15:49,760 --> 00:15:50,890
حقًّا؟

281
00:15:51,210 --> 00:15:53,130
.حسنًا إذًا، دعني أسمعها

282
00:15:54,520 --> 00:15:56,590
ستستمع لخاصّتي، ثمّ ماذا؟

283
00:15:57,130 --> 00:15:58,590
.سأسديك النّصح

284
00:15:58,590 --> 00:15:59,820
سأستمع، ثمّ ماذا؟

285
00:16:00,230 --> 00:16:03,840
،سمعت صوتك مرّتين الآن

286
00:16:03,840 --> 00:16:06,890
.لكن لا أظنّ أنّك أظهرت قدرتك الحقيقيّة في أيّ منهما

287
00:16:06,890 --> 00:16:10,700
هل أتيتُ إلى هنا... من باب الفضول؟

288
00:16:10,700 --> 00:16:12,730
أم بسبب شعور بقلق لا يهدأ؟

289
00:16:15,070 --> 00:16:17,610
.في تلك الحالة، أشكرك مسبقًا على النّصيحة

290
00:16:26,200 --> 00:16:29,510
لن يتخاذل ثانيةً، أليس كذلك؟

291
00:16:33,740 --> 00:16:35,630
!أ-أحتاج تسجيل هذا

292
00:16:46,840 --> 00:16:49,810
ماذا؟ أهذه نفس المقطوعة الّتي عزفها سابقًا؟

293
00:16:54,000 --> 00:16:56,790
!أمست مقطوعة مختلفة تمامًا الآن

294
00:16:56,790 --> 00:16:58,570
...عندما يضيف جملًا

295
00:16:58,570 --> 00:17:01,850
.لم يختلف عدد المرّات فحسب... بل وحتّى النّغمة اختلفت

296
00:17:01,850 --> 00:17:04,880
.ستفكّر أنّ شخصًا آخر يعزف

297
00:17:04,880 --> 00:17:07,040
.إنّها أرقّ من السّابق

298
00:17:13,040 --> 00:17:14,350
.فهمت

299
00:17:16,300 --> 00:17:18,840
أنت متقلّب حقًّا، أليس كذلك؟

300
00:17:20,420 --> 00:17:21,390
...لكن

301
00:17:22,730 --> 00:17:23,910
.ما زال الطّريق طويلًا أمامك

302
00:17:47,180 --> 00:17:51,920
مع أنّ هناك أيّام لا يستطيع فيها الموسيقار
،أن يعزف أغنيّةً أتقنها جيّدًا

303
00:17:51,920 --> 00:17:53,600
.إلّا أنّه سيعزف بكفاءة مع ذلك

304
00:17:54,970 --> 00:17:59,280
.لكن بالنّسبة له، يتغيّر كلّ شيء وفقًا لكيف يشعر

305
00:18:00,650 --> 00:18:02,760
.ذلك لأنّك تصرّ أن تفعل كلّ شيء بطريقتك الخاصّة

306
00:18:03,130 --> 00:18:05,050
.لكنّي لن أدعك تفعل ما يحلو لك

307
00:18:41,030 --> 00:18:46,040
...أصوات ساوامورا-كن السّريعة والعطوفة والطّفرة

308
00:18:46,040 --> 00:18:49,880
...تركب فوق أصوات سيريو-سان النّاعمة والممتدّة

309
00:18:51,430 --> 00:18:52,610
ما هذا؟

310
00:18:53,570 --> 00:18:56,150
أيحاولان خلق شيء جديد؟

311
00:19:00,490 --> 00:19:02,120
تفاعل كيميائيّ؟

312
00:19:04,470 --> 00:19:07,540
ما... هذا الشّعور؟

313
00:19:08,500 --> 00:19:10,660
.وكأنّ صوته يساندني

314
00:19:14,480 --> 00:19:17,450
.الصّوت يقفز ويرقص بشكل طبيعيّ

315
00:19:19,780 --> 00:19:20,730
...يرقص

316
00:19:23,290 --> 00:19:24,270
...ويرقص

317
00:19:26,280 --> 00:19:27,280
!ويرقص

318
00:19:42,410 --> 00:19:43,570
...هذا

319
00:19:44,400 --> 00:19:45,820
!هو التّجاوب

320
00:20:07,760 --> 00:20:11,690
.لم نحصل على أيّ نصيحة في الأخير

321
00:20:11,690 --> 00:20:15,440
من الفظاظة أن نطلب النّصيحة بمستوى
.مهاراتنا، لذا الأمر أفضل هكذا

322
00:20:15,440 --> 00:20:17,950
.لكنّها كانت فرصة لن نحصل على مثيلتها على الأغلب

323
00:20:17,950 --> 00:20:21,700
.بربّك. لقد أعطانا شيئًا جيّدًا بقدر النّصح

324
00:20:21,700 --> 00:20:22,620
حقًّا؟

325
00:20:22,620 --> 00:20:24,300
ألم تلحظي؟

326
00:20:24,300 --> 00:20:28,230
.لقد عزف ذلك الرّجل الجمل في "شينبوشي" بأبسط طرق ممكنة

327
00:20:28,230 --> 00:20:29,580
بأبسط طرق ممكنة؟

328
00:20:29,790 --> 00:20:31,510
...صحيح. ما يعني

329
00:20:32,610 --> 00:20:33,950
ما الخطب يا يوي-تشان؟

330
00:20:34,860 --> 00:20:38,880
...أداء كـ-كاميكي سيريو وساوامورا الجماعيّ

331
00:20:39,410 --> 00:20:42,420
.يطابق الوقت الأقصى للمسابقة تمامًا

332
00:20:42,420 --> 00:20:43,950
ماذا؟

333
00:20:43,950 --> 00:20:45,920
.أرأيت؟ عرفتها

334
00:20:46,070 --> 00:20:51,490
،إ-إذًا... إن تعلّمنا النّسخة المبسّطة
!سنستطيع أن نعزف مثل سيريو-سان

335
00:20:51,490 --> 00:20:53,870
.هذا ما سيعنيه الأمر، أجل

336
00:20:53,870 --> 00:20:55,460
!يا له من رجل

337
00:20:55,460 --> 00:20:58,700
.استطاع أن يجاري ساوامورا تمامًا في أوّل عزف لهما معًا

338
00:20:58,920 --> 00:20:59,880
.أنت مخطئ

339
00:21:01,240 --> 00:21:03,200
.لم يجاري عزفه بعزفي

340
00:21:03,780 --> 00:21:05,700
.بل جعلني أجاريه

341
00:21:06,030 --> 00:21:10,760
كانت "جمل" كاميكي سيريو
.محبوسةً، وتحدّاني بالأساسيّات فحسب

342
00:21:11,420 --> 00:21:13,250
ما رأيك إذًا؟

343
00:21:13,250 --> 00:21:16,580
كيف شعرت أن تُسحب من قبل أداء شريكك؟

344
00:21:16,890 --> 00:21:18,450
لا بدّ أنّ ذلك كان مزعجًا، صحيح؟

345
00:21:18,960 --> 00:21:20,060
.ليس تمامًا

346
00:21:21,400 --> 00:21:23,080
إلى أين أنت ذاهب؟

347
00:21:23,080 --> 00:21:23,940
.المرحاض

348
00:21:26,280 --> 00:21:28,320
.عجبًا، عجبًا. لقد هرب

349
00:21:28,320 --> 00:21:30,350
.لا بدّ أنّ ذلك أزعجه حقًّا

350
00:21:31,200 --> 00:21:34,150
مهلًا. هل تهرّب للتّوّ؟

351
00:21:37,280 --> 00:21:39,450
.شعور أن أُسحب

352
00:21:40,080 --> 00:21:41,930
...ليس مزعجًا بالضّبط

353
00:21:42,270 --> 00:21:46,570
...لكنّه ضايقني قليلًا بالفعل. وكان ممتعًا كذلك نوعًا ما

354
00:21:50,830 --> 00:21:52,770
!هذا ليس شاي الشّعير! بل مرقة المعكرونة

355
00:21:52,770 --> 00:21:55,080
...إنّها مالحة جدًّا

356
00:21:55,640 --> 00:21:59,380
.هكذا شعرت عندما كان جدّنا يمازحنا

357
00:21:59,630 --> 00:22:02,620
.هذه أوّل مرّة ينتابني هذا الشّعور الجيّد منذ فترة طويلة

358
00:22:07,840 --> 00:22:10,460
.سيكون سحب سيتسو-كن من قوقعته صعبًا

359
00:22:11,300 --> 00:22:13,470
".انسَ "سحبه

360
00:22:13,470 --> 00:22:15,970
.لقد خرج من قوقعته بنفسه

361
00:22:16,440 --> 00:22:17,790
.هكذا الأمر

362
00:22:17,790 --> 00:22:20,360
.ما كان يمكن قمع تلك المشاعر

363
00:22:43,310 --> 00:22:45,210
!عجبًا! لقد تزامنوا للمرّة الأولى

364
00:22:46,670 --> 00:22:49,130
.الألعاب والشّاميسن متشابهان كثيرًا

365
00:22:49,130 --> 00:22:52,280
!بما أنّ الأمر آل إلى هذا، ما علينا سوى أن نواصل الرّكض سريعًا

366
00:22:52,540 --> 00:22:54,010
.حسنًا. مرّة أخرى من البداية