1
00:01:37,580 --> 00:01:40,000
!مياو-مياو

2
00:01:50,300 --> 00:01:54,310
!أمسكتُ بكِ

3
00:01:55,260 --> 00:01:56,100
مياو؟

4
00:01:56,850 --> 00:01:59,810
!مياو! مياو

5
00:02:07,610 --> 00:02:10,400
!لا، ما الّذي فعلتُه بجسدي الجميل؟ مياو

6
00:02:10,490 --> 00:02:12,410
!ياه

7
00:02:13,740 --> 00:02:14,660
"ياه؟"

8
00:02:14,740 --> 00:02:17,700
!سقطَ خنزير أبيض صغير من السّماء

9
00:02:18,500 --> 00:02:21,870
بماذا نعتِّني؟ لهذا السّبب أكره
!الحيوانات الأدنى قيمة

10
00:02:22,370 --> 00:02:23,380
...لحظة

11
00:02:23,460 --> 00:02:25,710
!بعد أن أمعنتُ النّظر، أنت قطّ

12
00:02:26,210 --> 00:02:30,880
هل أنت بخير أيُّها القطّ؟ هل
سقطت في هذه الحفرة مثلي؟

13
00:02:31,720 --> 00:02:35,640
لا أستطيع التسلّق إلى الأعلى. ماذا أفعل؟

14
00:02:36,720 --> 00:02:40,640
انسي ذلك! دعينا نتحدّث عن تجرُّؤكِ
!على نعتي بالخنزير

15
00:02:41,730 --> 00:02:43,100
!كم أنت ظريف

16
00:02:43,190 --> 00:02:45,610
قبل كلّ شيء، هذا شكلي المُؤقّت

17
00:02:45,690 --> 00:02:48,190
شكلي الحقيقيّ فخم وعظيم

18
00:02:50,610 --> 00:02:53,360
تصرخون في وجهي هكذا... أنتم
الأطفال البشر مزعجون

19
00:02:56,450 --> 00:03:00,410
لكن يسرّني أنّك لم تُصَب بأذى

20
00:03:04,330 --> 00:03:06,460
هذه مشكلة، لا أملك وقتاً لهذا

21
00:03:06,540 --> 00:03:09,960
لنسرع ونخرج من هذا المكان

22
00:03:11,470 --> 00:03:14,340
!انتظر أيُّها القطّ! لا تذهب

23
00:03:14,430 --> 00:03:16,260
!لا تتركني لوحدي

24
00:03:17,470 --> 00:03:20,770
!هذا لا يُصدَّق... لهذا أكره الأطفال البشر

25
00:03:20,850 --> 00:03:22,140
...أيُّها القطّ

26
00:03:23,770 --> 00:03:27,060
!أيّها القطّ، تفوح منك رائحة كحول

27
00:03:34,280 --> 00:03:35,570
!عُدت

28
00:03:36,620 --> 00:03:39,080
...غريب

29
00:03:39,160 --> 00:03:42,160
عدتُ يا سيّدة توكو -
أهلاً بعودتك

30
00:03:44,540 --> 00:03:45,870
سأذهب لأبدِّل ملابسي

31
00:03:46,630 --> 00:03:49,500
...أجل -
هل من مشكلة؟ -

32
00:03:51,760 --> 00:03:53,090
...في الحقيقة

33
00:03:55,970 --> 00:03:57,260
...هكذا إذاً

34
00:03:58,930 --> 00:04:01,770
.الاقتصاد في انحسار من جديد
انظر إلى أسعار الأسهم

35
00:04:01,850 --> 00:04:03,640
!سينسي

36
00:04:04,890 --> 00:04:07,600
قالت السيّدة توكو بأنّ القريدس الّذي
احتفظَتْ به في الثلّاجة قد اختفى

37
00:04:08,190 --> 00:04:10,860
هذا غريب بالفعل

38
00:04:10,940 --> 00:04:12,650
أنت من أكله، أليس كذلك؟

39
00:04:12,740 --> 00:04:13,610
ماذا؟

40
00:04:14,110 --> 00:04:17,240
قلتُ لك آلاف المرّات ألّا تسبّب
مشكلة لهذا البيت

41
00:04:17,820 --> 00:04:20,450
!أحمق! كيف تجرؤ على الاشتباه بي؟

42
00:04:20,530 --> 00:04:21,830
هذا طبيعيّ

43
00:04:22,410 --> 00:04:23,750
!لا أعرف شيئاً عن الأمر

44
00:04:23,830 --> 00:04:27,420
فضلاً عن ذلك، لا يمكنك إزعاجي بشأن
قطعة أو 13 قطعة من القريدس

45
00:04:27,500 --> 00:04:29,790
!أيّها الفتى الجاهل

46
00:04:39,390 --> 00:04:42,260
هذه الأسطوانة الّتي استعرتُها
من نيشيمورا

47
00:04:42,350 --> 00:04:43,350
!ما مبرّرك الآن؟

48
00:04:43,430 --> 00:04:47,390
!هذه غلطتك لأنّك تركتها هنا يا غبيّ

49
00:04:49,400 --> 00:04:50,520
!توقّعت

50
00:04:55,240 --> 00:04:56,780
!انقلع

51
00:05:04,450 --> 00:05:06,250
!سئمتُ منك

52
00:05:06,330 --> 00:05:09,960
!ناتسومي، أيّها الجانح! أيُّها المُهرِّج
!أيّها الهليون الأبيض

53
00:05:15,590 --> 00:05:19,050
!تاكاشي؟ سمعتُ صُراخاً

54
00:05:19,550 --> 00:05:22,510
!آسف، لا شيء

55
00:05:26,100 --> 00:05:29,520
!ناتسومي، أيّها الجانح! أيُّها المُهرِّج
!أيّها الهليون الأبيض

56
00:05:35,150 --> 00:05:36,900
!ناتسومي، أيُّها المُغفّل

57
00:05:38,240 --> 00:05:41,950
رغم ذلك، ذاك القطّ الأبيض الخنزيريّ
مُثير للمتاعب حقّاً

58
00:05:42,620 --> 00:05:44,540
،يأتي إلى هنا، ياتسوهارا، في كلّ ليلة

59
00:05:44,620 --> 00:05:47,580
ويشرب كحولاً ما يكفي لقرية كاملة

60
00:05:47,660 --> 00:05:48,830
يشرب ويشرب

61
00:05:48,910 --> 00:05:52,790
.لا يقتصر الأمر على الخمر
يلتهم الطّعام أيضاً

62
00:05:52,880 --> 00:05:54,630
يأكل بلا توقُّف -
بالفعل -

63
00:05:54,710 --> 00:05:56,460
وأغنِّي أيضاً

64
00:05:56,550 --> 00:05:58,300
أجل، أذنه غير موسيقيّة -
بالفعل -

65
00:05:58,380 --> 00:06:00,380
وأكون بغيضاً عندما أثمل

66
00:06:00,470 --> 00:06:03,640
أجل، دائماً ما يفتعل المشكلات

67
00:06:03,720 --> 00:06:05,850
شِجارات ثمالى -
بالفعل -

68
00:06:05,930 --> 00:06:07,270
ماذا ستفعلون؟

69
00:06:08,520 --> 00:06:11,690
صحيح أنّنا في ياتسوهارا مَدينون
،للسيّد ناتسومي

70
00:06:11,770 --> 00:06:15,610
وذلك الشّرِه أصمّ النّغم الثّمل
القطّ الخنزيريّ هو حارسه

71
00:06:15,690 --> 00:06:18,490
!لكن رغم ذلك، للصّبر حدود

72
00:06:18,570 --> 00:06:19,950
بالفعل صحيح -
معك حقّ -

73
00:06:20,030 --> 00:06:22,870
حُسِمَ الأمر إذاً! من أجل السّلام
،في ياتسوهارا

74
00:06:22,950 --> 00:06:26,700
سنقاطع ذلك القطّ الخنزيريّ الشّرِه كريه
!الرّائحة الثّمل أصمّ النّغم

75
00:06:26,790 --> 00:06:28,410
!موافقون

76
00:06:28,500 --> 00:06:31,460
،لأجل السّلام في ياتسوهارا

77
00:06:31,540 --> 00:06:33,500
سنُقاطع ذلك القطّ الخنزيريّ

78
00:06:33,580 --> 00:06:36,630
الشّرِه كريه الرّائحة أصمّ النّغم الثّمل

79
00:06:36,710 --> 00:06:39,050
!حسناً

80
00:06:39,130 --> 00:06:42,630
!مياو-مياو

81
00:06:43,260 --> 00:06:44,930
هذا رائع

82
00:06:45,010 --> 00:06:47,180
!مادارا...ساما

83
00:06:49,770 --> 00:06:52,190
معكم حقّ في نهاية المطاف

84
00:06:52,270 --> 00:06:56,020
أنا شرِه ومُفرِط الشّرب ولا أستطيع الغناء

85
00:06:56,110 --> 00:06:58,110
!ورائحتي كريهة جدّاً

86
00:06:58,190 --> 00:07:02,070
!أكلتُ 13 قطعة من القريدس من الثلّاجة
!وكسرتُ أسطوانة

87
00:07:07,240 --> 00:07:08,080
!مُذنِب حتّى النُّخاع

88
00:07:19,340 --> 00:07:22,300
قريدس؟ أسطوانة؟

89
00:07:22,440 --> 00:07:24,030
...إي-أف-جي

90
00:07:32,560 --> 00:07:34,100
!أيّها الرّاهب

91
00:07:36,270 --> 00:07:38,190
من أنتِ؟

92
00:07:38,270 --> 00:07:40,730
حريّ بك أن تُطهّر ياتسوهارا

93
00:07:40,820 --> 00:07:41,650
عفواً؟

94
00:07:41,740 --> 00:07:45,360
إنّها وكرٌ للأياكاشي الجاحدين

95
00:07:45,860 --> 00:07:48,780
اجعلها طاهرة بحيث لا تطأ
أقدامهم أرضها ثانية

96
00:07:48,870 --> 00:07:50,700
!كلّ شبر من المكان

97
00:07:51,250 --> 00:07:53,410
انتظري لحظة فحسب أيّتها الآنسة الصّغيرة

98
00:07:53,500 --> 00:07:55,960
أبي، عُدت

99
00:07:56,040 --> 00:07:58,250
أهلاً بعودتك

100
00:08:05,010 --> 00:08:07,220
شعرتُ بقشعريرة غريبة للتو

101
00:08:12,980 --> 00:08:15,190
حسناً، ما التّالي في برنامجنا؟

102
00:08:15,730 --> 00:08:18,150
سأعود إلى المنزل. لديّ وظيفة مدرسيّة

103
00:08:18,230 --> 00:08:19,860
هكذا إذاً

104
00:08:19,940 --> 00:08:22,070
الحرّ شديد -
...هذا حارِق -

105
00:08:22,150 --> 00:08:24,360
يروقني هذا -
لكنّه باهظ الثّمن -

106
00:08:24,440 --> 00:08:26,860
!اشتريته على أيّ حال -
يا ولد -

107
00:08:35,210 --> 00:08:37,120
هذا الزيّ غير مألوف لديّ

108
00:08:37,210 --> 00:08:38,540
إلى أي مدرسة تتردّد؟

109
00:08:38,630 --> 00:08:40,960
لا أدري -
لنجرّب -

110
00:08:41,040 --> 00:08:43,420
أيّتها الظّريفة. ما هي مدرستكِ؟

111
00:08:45,590 --> 00:08:47,470
هذا أنتما أيّها الفاشلان

112
00:08:47,550 --> 00:08:48,430
ماذا؟

113
00:08:48,510 --> 00:08:50,510
أنتما زميلا ناتسومي في الصفّ، صحيح؟

114
00:08:50,600 --> 00:08:53,970
فهمت! أنتِ صديقة ناتسومي إذاً؟

115
00:08:54,060 --> 00:08:55,390
صديقة؟

116
00:08:55,890 --> 00:08:58,730
!مُخطئ! أنا مُعلّمته

117
00:08:58,810 --> 00:09:00,230
مُعلّمته؟

118
00:09:00,310 --> 00:09:03,650
رغم أنّني قطعتُ روابطي معه للتو

119
00:09:06,650 --> 00:09:08,950
أنتما، تعالا معي

120
00:09:13,660 --> 00:09:15,870
كم تملك من المال؟

121
00:09:15,950 --> 00:09:19,000
أنفقتُ معظمه في صالة الأركيد

122
00:09:20,380 --> 00:09:22,000
!أنتما -
ماذا؟ -

123
00:09:22,090 --> 00:09:25,090
.اطلبا بيتزا فصول الأربعة أخرى
مع غراتان أيضاً

124
00:09:25,170 --> 00:09:26,630
!لم تنتهِ بعد؟

125
00:09:26,720 --> 00:09:28,510
من المؤكَّد أنّكِ لا تستطيعين
أكل أكثر من ذلك

126
00:09:29,090 --> 00:09:32,140
لا داعي للقلق. معدتي في وضع مثاليّ

127
00:09:32,220 --> 00:09:35,680
في الواقع، مِحفظاتنا هي الّتي تعاني

128
00:09:35,770 --> 00:09:39,270
!ماذا؟ -
انسي الأمر -

129
00:09:39,350 --> 00:09:41,650
بالمناسبة، ماذا يعني أركيد؟

130
00:09:42,230 --> 00:09:43,730
هل هو نوع من بسكويت الأرزّ؟

131
00:09:45,230 --> 00:09:47,440
تفضّلي الهوت دوغ خاصّتكِ

132
00:09:47,530 --> 00:09:50,660
ممتاز. أحضري بيتزا وغراتان تالياً

133
00:09:53,620 --> 00:09:56,160
!...لنرَ

134
00:09:58,750 --> 00:10:01,630
غير معقول. يا له من إسراف

135
00:10:06,210 --> 00:10:09,010
...يا فتاة -
نادِني سينسي -

136
00:10:09,090 --> 00:10:10,800
...سينسي

137
00:10:10,880 --> 00:10:14,100
نريد العودة إلى المنزل

138
00:10:14,680 --> 00:10:16,140
!من فضلكِ يا سينسي

139
00:10:16,220 --> 00:10:19,230
!أيُعقَل هذا؟ لعبة غبيّة

140
00:10:20,060 --> 00:10:22,770
!هيّا! أسرع! أسرع

141
00:10:22,850 --> 00:10:25,480
خرجنا مع الفتاة الخطأ

142
00:10:25,570 --> 00:10:28,110
!فعلتُها! أنا في المركز الأوّل

143
00:10:35,660 --> 00:10:38,580
لم أرَ القطّ اليوم

144
00:10:38,660 --> 00:10:39,990
هل من فكرة عن السّبب يا تاكاشي؟

145
00:10:40,080 --> 00:10:41,410
لا أدري

146
00:10:41,500 --> 00:10:45,040
ألا تعتقد بأنّه جائع؟ قطقوط مسكين

147
00:10:45,120 --> 00:10:46,420
قطقوط؟

148
00:10:46,500 --> 00:10:48,750
هذا نادر

149
00:10:49,420 --> 00:10:50,960
أقصد قطّك

150
00:10:51,050 --> 00:10:54,170
في العادة أجده مسترخياً على كرسيّي

151
00:10:54,260 --> 00:10:55,590
آسف بشأن ذلك

152
00:10:56,300 --> 00:10:59,470
رغم ذلك، عدم وجود هرهور يُشعرنا بالوحشة

153
00:10:59,560 --> 00:11:02,680
هرهور؟

154
00:11:04,230 --> 00:11:08,480
أعتقد أنّ نيانكو-سينسي كان يقضي وقته في المنزل
مع عائلة فوجيوارا أكثر ممّا توقّعتُ

155
00:11:15,950 --> 00:11:18,950
ماذا تفعل؟ تختبئ في مكان كهذا

156
00:11:31,420 --> 00:11:33,380
!أنِّب ضميرك أيّها الفتى الصّغير

157
00:11:33,460 --> 00:11:35,670
!لن أعود إلى المنزل بتلك السّهولة

158
00:11:36,470 --> 00:11:38,050
!مياو -
ماذا؟ -

159
00:11:38,140 --> 00:11:39,800
مياو

160
00:11:41,720 --> 00:11:44,560
هل ابتسم ذاك القطّ للتو؟

161
00:11:46,100 --> 00:11:47,390
!نيشيمورا

162
00:11:47,480 --> 00:11:49,440
تفضّل أسطوانتك

163
00:11:50,440 --> 00:11:54,030
...ناتسومي -
من تكون؟ -

164
00:11:54,110 --> 00:11:55,860
من؟

165
00:11:55,940 --> 00:11:59,320
!تلك الفتاة! تعرف أيّ واحدة -
فتاة؟ -

166
00:11:59,410 --> 00:12:01,530
أجل -
!هذا صحيح

167
00:12:01,620 --> 00:12:06,080
الفتاة الّتي التهمَتْ قائمة مقهى كاملة
من الأعلى إلى الأسفل

168
00:12:06,160 --> 00:12:09,210
وحتّى أنّها جعلَتْنا نأخذها إلى الأركيد

169
00:12:09,290 --> 00:12:10,960
!ما كانت لتدعنا نغادر

170
00:12:11,040 --> 00:12:14,050
ذهبَ مصروف شهر كامل أدراج الرّياح

171
00:12:14,130 --> 00:12:14,960
أدراج الرّياح

172
00:12:15,050 --> 00:12:17,300
لا أعرف فتاة كهذه

173
00:12:17,380 --> 00:12:20,010
لكنّها تعرفك

174
00:12:20,090 --> 00:12:21,640
لا بدّ من وجود خطأ ما

175
00:12:22,220 --> 00:12:25,810
أقصد لا أملك أي صديقة حتّى

176
00:12:25,890 --> 00:12:27,140
صديقة؟

177
00:12:27,230 --> 00:12:30,730
"!مُخطئ! أنا مُعلّمته"

178
00:12:30,810 --> 00:12:32,060
سينسي؟

179
00:12:32,940 --> 00:12:34,530
أجل

180
00:12:34,610 --> 00:12:36,610
هذا ما قالَتْه

181
00:12:40,530 --> 00:12:42,030
أخبرني بكلّ شيء

182
00:12:51,380 --> 00:12:52,540
!أمسكتُ بك

183
00:12:53,170 --> 00:12:57,170
الذّهاب إلى صالة الأركيد بعد الدّوام
مُخالف للقواعد المدرسيّة

184
00:12:57,260 --> 00:12:59,590
أو بالأحرى، أنا متفاجئة قليلاً

185
00:12:59,680 --> 00:13:01,680
إذاً تلعب ألعاب الفيديو أيضاً يا ناتسومي؟

186
00:13:02,180 --> 00:13:06,180
حسناً، أعتقد هذا خير من النّبش
في نفايات النّاس

187
00:13:12,230 --> 00:13:13,770
يا آنسة

188
00:13:15,070 --> 00:13:19,860
تاميكو! مرحباً! هل أنتِ لوحدكِ؟

189
00:13:19,950 --> 00:13:21,820
لا، أنا مع أمّي

190
00:13:22,320 --> 00:13:24,990
فهمت. إنّها جارتي

191
00:13:25,080 --> 00:13:26,290
مرحباً

192
00:13:26,370 --> 00:13:27,330
هل خرجتُما للتسوُّق؟

193
00:13:27,410 --> 00:13:30,500
!أجل! سنخرج في نزهة غداً

194
00:13:31,710 --> 00:13:35,380
إذاً أمّكِ وأبوكِ حصلا على إجازة؟

195
00:13:35,460 --> 00:13:37,800
!يسرّني سماع هذا -
!أجل -

196
00:13:37,880 --> 00:13:41,340
...يعمل والداها بدوام كامل، لذا هي

197
00:13:42,180 --> 00:13:43,220
اختفى

198
00:13:45,300 --> 00:13:46,560
لقد هرب

199
00:13:49,930 --> 00:13:51,350
!عُدت

200
00:14:05,240 --> 00:14:09,410
ربّما سأضايق صديقَي ناتسومي من جديد

201
00:14:12,250 --> 00:14:13,120
!من هنك؟

202
00:14:15,250 --> 00:14:19,130
!لم أرك منذ وقت. هذا أنا

203
00:14:19,210 --> 00:14:22,090
هذا الصّوت... أهذا أنت يا إينكو؟

204
00:14:22,630 --> 00:14:23,840
أجل

205
00:14:24,340 --> 00:14:25,640
ماذا تريد؟

206
00:14:25,720 --> 00:14:27,800
في الواقع... سمعتُ أنّك

207
00:14:27,890 --> 00:14:31,730
قطعتَ روابطك مع البشريّ الّذي
يحمل كتاب الأصدقاء

208
00:14:32,310 --> 00:14:34,770
!لا علاقة لك بالأمر

209
00:14:35,270 --> 00:14:36,860
...إذا قطعت روابطك معه

210
00:14:36,940 --> 00:14:41,650
فلن تمانع إذاً إن حصلتُ على كِتاب
الأصدقاء لنفسي

211
00:14:43,820 --> 00:14:46,530
فهمت؟! فقد رفضتَه أنت

212
00:14:46,620 --> 00:14:48,410
لا تأتِ إليّ وتشتكِ لاحقاً

213
00:14:48,490 --> 00:14:49,740
هذا كلّ ما أردتُ قوله

214
00:14:51,870 --> 00:14:53,500
!أنت! انتظر

215
00:15:01,840 --> 00:15:04,090
ماذا تظنُّ أنّك تفعل يا مادارا؟

216
00:15:04,170 --> 00:15:05,840
!لن أدعك تمرّ

217
00:15:05,930 --> 00:15:07,090
!ابتعد عن طريقي

218
00:15:15,440 --> 00:15:17,480
كم أنت مثير للشّفقة يا مادارا

219
00:15:18,110 --> 00:15:21,570
هل تندم فجأة على التخلّي
عن كِتاب الأصدقاء؟

220
00:15:21,650 --> 00:15:24,650
...أو لا تقل لي أنّ ذلك البشريّ

221
00:15:25,150 --> 00:15:26,610
!اصمت

222
00:15:49,140 --> 00:15:52,180
...بغضّ النّظر عن ذلك الغبيّ

223
00:15:52,260 --> 00:15:53,470
...إنّ ترك ناتسومي

224
00:15:53,560 --> 00:15:57,310
لكِتاب الأصدقاء حاليّاً يقع في قبضة
أياكاشي آخر

225
00:15:57,390 --> 00:15:59,900
لَهو شيء لا أقبل به

226
00:16:01,730 --> 00:16:02,940
!اصمتوا يا غربان

227
00:16:04,400 --> 00:16:06,990
تأكل كثيراً بالنّسبة لحجمك الصّغير

228
00:16:14,910 --> 00:16:16,330
!يكفي! هذا يدغدغ

229
00:16:16,410 --> 00:16:18,370
!كـ... كارثيّ

230
00:16:34,640 --> 00:16:38,140
انظر، الصّغير قد أُعجِب بك يا تاكاشي

231
00:16:39,560 --> 00:16:42,810
غادر صديقنا بمهمّة عمل، لذا ليست
إلّا مدّة يومين أو ثلاث

232
00:16:42,900 --> 00:16:45,900
آسف، لكن هل يمكننا ترك الأمر لك؟ -
أكيد -

233
00:16:45,980 --> 00:16:50,410
انظر، كان يلعب بالخيط -
من يحتاج ناتسومي؟ -

234
00:16:51,450 --> 00:16:53,870
من يحتاج كِتاب الأصدقاء؟

235
00:16:53,950 --> 00:16:58,120
ذاك الفتى... يحسب أنّه يستطيع
السّخرية منّي؟

236
00:17:00,460 --> 00:17:01,960
!اصمتوا

237
00:17:02,040 --> 00:17:05,250
!لستُ حيواناً للعرض يا أوغاد! تراجعوا

238
00:17:07,630 --> 00:17:12,720
!حسناً! أعتقد حان الوقت لأغنية

239
00:17:13,220 --> 00:17:18,680
ما أجمل النُّجوم في سماء اللّيل

240
00:17:18,770 --> 00:17:23,900
...أجل، والسّماء زرقاء

241
00:17:31,990 --> 00:17:34,410
أسرفتُ في الشّرب في اللّيلة الماضية

242
00:17:38,040 --> 00:17:39,790
...ماذا؟ ماء النّبع هذا

243
00:17:44,080 --> 00:17:46,250
رأسي ينبض

244
00:17:46,340 --> 00:17:48,630
!اصمتوا وكفّوا عن التّغريد

245
00:17:48,710 --> 00:17:49,880
!تغريد تغريد تغريد

246
00:17:50,630 --> 00:17:52,050
قرقعة، قرقعة...؟

247
00:17:52,930 --> 00:17:55,300
على ذكرِ الأمر، أنا جائع

248
00:18:05,650 --> 00:18:08,940
!أمسكتُ بكِ

249
00:18:11,900 --> 00:18:12,820
مياو؟

250
00:18:13,570 --> 00:18:15,070
!مياو

251
00:18:22,710 --> 00:18:24,460
أنت جائع؟

252
00:18:24,540 --> 00:18:27,040
!وجدتُها! لديّ بعض الشّوكولاتة

253
00:18:30,880 --> 00:18:33,590
تفضّل أيّها القطّ، نصف لك

254
00:18:40,180 --> 00:18:41,520
إنّها لذيذة، صحيح؟

255
00:18:42,020 --> 00:18:45,600
كان من المُفترض أن أتقاسمها
مع أمّي وأبي

256
00:18:46,610 --> 00:18:49,110
لكن أُلغيَتْ نزهتنا من جديد

257
00:18:49,190 --> 00:18:50,650
لذا أتيتُ بمفردي

258
00:18:50,730 --> 00:18:52,570
ثمّ سقطتُ هنا

259
00:18:53,070 --> 00:18:55,860
وجدتُها! ما رأيك أن تأتي
إلى منزلي أيُّها القطّ؟

260
00:18:56,360 --> 00:19:00,160
يمكننا تناول العشاء والمقرمشات معاً

261
00:19:00,240 --> 00:19:03,210
!سيكون مذاقها أطيب إذا شاركني أحدٌ بها

262
00:19:07,040 --> 00:19:08,340
ما كلّ هذا؟

263
00:19:12,460 --> 00:19:15,130
!كفّ عن الاختباء واخرج يا سينسي

264
00:19:20,220 --> 00:19:23,100
كان أنت

265
00:19:39,070 --> 00:19:40,160
!يا للهول، مطر

266
00:19:40,740 --> 00:19:45,500
هذا سيّئ! قالت أمّي أنّ الأرانب
!تموت عندما يبتلّون

267
00:19:45,580 --> 00:19:49,250
أنا واثقة أنّ نفس الأمر ينطبق
على القطط، صحيح؟ صحيح؟

268
00:19:49,330 --> 00:19:52,670
ماذا يجدر بي أن أفعل؟ لا أريدك
!أن تموت أيّها القطّ

269
00:19:52,750 --> 00:19:55,670
.اهدئي أيّتها الطّفلة البشريّة
لن يحدث هذا

270
00:19:56,340 --> 00:19:58,220
أيّها القطّ، أنا آسفة جدّاً

271
00:19:58,300 --> 00:19:59,970
،قلتَ بأنّك أردت العودة إلى المنزل

272
00:20:00,050 --> 00:20:02,060
!لكن أجبرتُك على البقاء هنا

273
00:20:02,140 --> 00:20:05,680
أنا آسفة أيُّها القطّ. بقيتَ لأجلي

274
00:20:06,270 --> 00:20:09,020
!لا تمُت أيُّها القطّ

275
00:20:09,100 --> 00:20:10,940
أنتِ من يقتلني

276
00:20:20,910 --> 00:20:23,030
عمَّ الهدوء الآن

277
00:20:24,540 --> 00:20:27,750
البشر كائنات واهنة

278
00:20:28,250 --> 00:20:30,960
لا أحبّ الضُّعفاء

279
00:20:34,130 --> 00:20:36,760
إنّهم ضعفاء جدّاً، ومع ذلك
يقلقون على الآخرين

280
00:20:36,840 --> 00:20:40,590
عاجزون تماماً، ومع ذلك يدافعون
عن شخص باستماتة

281
00:20:41,090 --> 00:20:42,300
...هذه الطّفلة

282
00:20:43,600 --> 00:20:45,390
وهو

283
00:20:45,470 --> 00:20:47,060
!سينسي

284
00:20:47,140 --> 00:20:49,190
!نيانكو-سينسي

285
00:20:49,270 --> 00:20:50,770
!سينسي

286
00:20:50,850 --> 00:20:52,560
!نيانكو-سينسي

287
00:21:00,530 --> 00:21:02,450
ماذا؟ هل أطير؟

288
00:21:05,200 --> 00:21:06,910
يا له من حلم جميل

289
00:21:07,000 --> 00:21:09,750
دافئ جدّاً... ومُريح

290
00:21:27,680 --> 00:21:28,600
ماذا؟

291
00:21:33,690 --> 00:21:36,520
أيّتها الفتاة الصّغيرة! ماذا تفعلين هنا؟

292
00:21:37,030 --> 00:21:38,990
هل أنتِ بخير أيّتها الصّغيرة؟

293
00:21:40,950 --> 00:21:43,160
!سينسي -
هل يمكنكِ أن تخبريني باسمكِ؟ -

294
00:21:43,240 --> 00:21:46,530
!سينسي، اخرج

295
00:21:47,040 --> 00:21:50,500
نيانكو-سينسي، أين أنت؟

296
00:21:51,000 --> 00:21:52,420
أعتقد لا أملك خياراً

297
00:21:55,960 --> 00:21:59,420
!ناتسومي

298
00:21:59,510 --> 00:22:03,300
!مياو! مياو! مياو

299
00:23:36,440 --> 00:23:38,940
!عندما لمسَ علامتي، انكمشَ سينسي

300
00:23:39,020 --> 00:23:41,730
أجل، إنّها من تلك اللّعنة الّتي انتقلَتْ إليك

301
00:23:41,820 --> 00:23:43,030
!أنت هينوي

302
00:23:43,110 --> 00:23:44,740
لعنة علامة الأيّام الخمسة

303
00:23:44,820 --> 00:23:47,780
ناتسومي، بقي أمامك خمسة أيّام للعيش

304
00:23:47,860 --> 00:23:48,870
خمسة أيّام؟