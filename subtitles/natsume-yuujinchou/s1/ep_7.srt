1
00:01:31,330 --> 00:01:35,080
...ما زالت هناك... قبّعة البشر

2
00:01:37,080 --> 00:01:40,540
يا له من لون أبيض جميل. كما الثّلج

3
00:01:41,590 --> 00:01:44,050
ألن يأخذها أحد؟

4
00:01:44,130 --> 00:01:46,260
هل ستأتين معي إذاً؟

5
00:01:49,050 --> 00:01:51,890
جميلة... سوف أريها لأمّي

6
00:01:55,220 --> 00:01:56,680
...أمّي

7
00:01:57,600 --> 00:02:00,520
!لا! لا يجوز للرّجل أن يبكي

8
00:02:01,110 --> 00:02:03,730
من الآن فصاعداً، يجب أن أعتمد
!على نفسي للعيش

9
00:02:08,050 --> 00:02:12,010
الحلقة 7

10
00:02:12,950 --> 00:02:14,950
!سأغادر يا سيّدة توكو

11
00:02:15,450 --> 00:02:16,500
!بالتّوفيق

12
00:02:16,580 --> 00:02:19,000
!استمتع بوقتك -
حسناً -

13
00:02:19,960 --> 00:02:21,000
!تاكاشي

14
00:02:22,040 --> 00:02:23,000
نعم؟

15
00:02:23,840 --> 00:02:27,420
سمعتُ بأنّك ذاهب إلى نبع كاريبا
السّاخن في رحلة تخييم دراسيّة

16
00:02:27,510 --> 00:02:29,880
في الواقع... أجل

17
00:02:32,260 --> 00:02:35,430
سامحني. أنا ممتنٌّ لدفعك الأجور

18
00:02:37,470 --> 00:02:39,520
لا تقلق بشأن ذلك

19
00:02:40,350 --> 00:02:42,480
أردتُ فقط أن أطلب معروفاً

20
00:02:43,020 --> 00:02:43,940
ماذا؟

21
00:02:44,020 --> 00:02:46,480
هناك صانع فخّاريّات بالقرب من النّبع السّاخن

22
00:02:46,570 --> 00:02:49,030
هلّا طلبتُ منك إحضار زبديّة أرزّ من هناك؟

23
00:02:49,610 --> 00:02:52,490
اتّصلوا بي للقول بأنّها ستجهز قريباً

24
00:02:53,990 --> 00:02:56,120
هل يمكنك تولّي المهمّة؟

25
00:02:58,080 --> 00:02:59,580
بالطّبع يا سيّد شيغيرو

26
00:03:05,420 --> 00:03:08,050
أرى ابتسامةً غريبة جدّاً في وجهك يا ناتسومي

27
00:03:11,840 --> 00:03:14,050
سينسي! متى قد...؟

28
00:03:14,140 --> 00:03:17,470
من الطبيعيّ أن يذهب حارسُك
الشّخصيّ معك، أليس كذلك؟

29
00:03:17,560 --> 00:03:19,180
...هذا صحيح على ما أعتقد

30
00:03:20,850 --> 00:03:23,900
وبعد؟ لِمَ أنت سعيد؟

31
00:03:24,560 --> 00:03:30,280
لم أتوقّع أن يكون الشّعور بهذه الرّوعة
عندما يطلب منك أحدٌ معروفاً

32
00:03:42,620 --> 00:03:45,670
...يسقط العظيم أخيراً"

33
00:03:46,380 --> 00:03:49,800
"ليغدو غُباراً في مهبِّ الرّيح

34
00:03:50,300 --> 00:03:52,970
حسناً. بهذا نختتم المُحاضرة الصّباحيّة

35
00:03:53,470 --> 00:03:55,510
لديكم وقت حرّ حتّى فترة الغداء

36
00:03:58,600 --> 00:04:01,430
حسناً! ماذا نفعل؟

37
00:04:01,520 --> 00:04:03,770
لنذهب إلى النّبع السّاخن أوّلاً

38
00:04:03,850 --> 00:04:04,690
أليس كذلك يا ناتسومي؟

39
00:04:04,770 --> 00:04:08,770
آسف، لديّ مهمّة أؤدّيها

40
00:04:08,860 --> 00:04:11,110
ماذا؟ -
هل أنت متأكّد؟ -

41
00:04:16,200 --> 00:04:18,240
...لنرَ

42
00:04:18,870 --> 00:04:21,750
أعتقد بأنّه في هذه الأرجاء

43
00:04:23,460 --> 00:04:25,000
ها هو

44
00:04:30,250 --> 00:04:32,840
!أيّها الضّعيف اليتيم الضّئيل

45
00:04:39,180 --> 00:04:42,060
هل ما زلت تتجوّل حول الغابة؟

46
00:04:42,140 --> 00:04:44,440
!لا أحد يريد مخلوقاً عديم الجدوى مثلك هنا

47
00:04:50,770 --> 00:04:53,690
!ابتعد عن الغابة أيّها الفاشل

48
00:04:54,780 --> 00:04:56,200
فاشل"؟"

49
00:04:56,280 --> 00:04:58,870
!قلتُ اخرج من هنا

50
00:05:00,910 --> 00:05:02,120
!توقّفا

51
00:05:06,420 --> 00:05:07,670
من... أنت؟

52
00:05:08,250 --> 00:05:10,170
ماذا تفعلان أيّها المُخيفان؟

53
00:05:10,750 --> 00:05:12,840
كيف تتنمّران على طفل؟

54
00:05:13,420 --> 00:05:15,920
ألست طفلاً بشريّاً؟

55
00:05:16,010 --> 00:05:19,890
ينبغي للبشريّ أن يفكّر مرّتين
!قبل أن يتحدّانا

56
00:05:19,970 --> 00:05:23,600
!أيّها الشّقيّ الوقح! سألتهمك هنا والآن

57
00:05:51,250 --> 00:05:52,880
المهمّ أنّه بخير

58
00:05:58,550 --> 00:06:01,600
من جديد، تدخّلتَ فيما لا يعنيك يا ناتسومي

59
00:06:03,010 --> 00:06:04,310
ماذا عسايّ أفعل؟

60
00:06:04,810 --> 00:06:07,600
في كلّ الأحوال، كانت هذه مضيعة كبيرة للوقت

61
00:06:07,680 --> 00:06:10,690
الآن علينا قطع كلّ المسافة
للعودة إلى هنا ثانية

62
00:06:10,770 --> 00:06:12,400
ما باليد حيلة

63
00:06:12,480 --> 00:06:15,400
قالوا بأنّ زبديّة الأرزّ لن تجهز قبل يوم غد

64
00:06:16,780 --> 00:06:19,700
أنتم البشر تُحدِثون جلبة على كلّ شيء

65
00:06:19,780 --> 00:06:22,570
إنّه مجرّد وعاء لاحتواء الطّعام

66
00:06:22,660 --> 00:06:25,830
اشترِ واحداً فحسب في سوقك المحلّي

67
00:06:25,910 --> 00:06:28,410
سيكون بسيطاً جدّاً

68
00:06:28,500 --> 00:06:30,290
إنَّ الصّحن لا ينبغي أن يكون مجرّد وعاء

69
00:06:30,370 --> 00:06:32,790
عمّاذا تتكلّم؟ -
أكره البشر -

70
00:06:32,880 --> 00:06:33,790
...ومع ذلك

71
00:06:38,220 --> 00:06:39,300
!أحسنت الإمساك

72
00:06:44,720 --> 00:06:47,100
!ناتسومي! لا تنم

73
00:06:52,770 --> 00:06:54,110
...ناتسومي

74
00:07:06,370 --> 00:07:09,580
تلقّيتُ ضربة بسببك يا ناتسومي

75
00:07:11,870 --> 00:07:12,750
آسف بشأن ذلك

76
00:07:14,840 --> 00:07:17,420
هل يراودك فضول بشأن العشاء
أيضاً يا ناتسومي؟

77
00:07:17,500 --> 00:07:19,800
أجل، أتطلّع قُدماً له

78
00:07:20,380 --> 00:07:22,180
ناتسومي يبتسم كثيراً

79
00:07:23,010 --> 00:07:24,930
لكن بشكلٍ ما، تبدو هذه ككذبة

80
00:07:25,930 --> 00:07:31,100
.كلامه وإيماءاته وحتّى هالته
كلّ هذا يبدو كذبة

81
00:07:32,730 --> 00:07:35,150
هذا صحيح. فعلناها معاً، أليس كذلك؟ -
متى؟ -

82
00:07:35,230 --> 00:07:37,730
ماذا؟ قبل أيّام

83
00:07:42,400 --> 00:07:44,700
ربّما لا يكون بشريّاً إطلاقاً

84
00:07:45,370 --> 00:07:48,950
ربّما يكون مثلي، شخصاً يتظاهر
بأنّه بهيئة بشريّة

85
00:07:49,450 --> 00:07:51,870
شخصاً وحيداً تماماً مثلي

86
00:07:52,460 --> 00:07:53,370
،إن كان ذلك صحيحاً

87
00:07:54,080 --> 00:07:57,040
!فينبغي أن يعيش معي في الغابة

88
00:07:57,130 --> 00:07:58,880
أليس كذلك يا أمّي؟

89
00:08:12,480 --> 00:08:13,940
هذه مُعضِلة

90
00:08:14,520 --> 00:08:16,560
سنعود إلى الدّيار غداً

91
00:08:16,650 --> 00:08:18,900
سأشعر بالحزن إذا تعلّق بي كثيراً

92
00:08:19,480 --> 00:08:20,900
فات الأوان على ذلك

93
00:08:21,490 --> 00:08:23,570
اصمت يا سينسي

94
00:09:00,900 --> 00:09:02,440
هذه كارثة

95
00:09:02,530 --> 00:09:05,740
لا يمكننا الحصول على زبديّة
الأرزّ في هذا الطّقس

96
00:09:06,240 --> 00:09:08,370
قد لا أتمكّن حتّى من العودة
في الوقت لحضور الدّرس

97
00:09:11,030 --> 00:09:12,660
...سيّد ناتسومي

98
00:09:17,580 --> 00:09:18,960
هل كنتُ أتخيّل؟

99
00:09:43,480 --> 00:09:44,530
شكراً

100
00:09:57,830 --> 00:10:01,790
أمّي، كنتُ مفيداً لشخص أخيراً

101
00:10:01,880 --> 00:10:03,380
"حتّى أنّه قال "شكراً

102
00:10:03,880 --> 00:10:06,210
لستُ فاشلاً بعد الآن، صحيح؟

103
00:10:06,720 --> 00:10:08,630
!غداً، سأقتات على الفطريّات

104
00:10:08,720 --> 00:10:11,720
سأحصل على الكثير منها
!وأشاركها مع ناتسومي

105
00:10:15,140 --> 00:10:17,310
حسناً، حسناً... إنّه الثّعلب الضّئيل

106
00:10:17,390 --> 00:10:19,850
عدتَ من جديد

107
00:10:19,940 --> 00:10:23,110
أنت لا تتعلّم درسك أبداً. قلنا
!لك أن تغرب عن وجهنا

108
00:10:32,200 --> 00:10:35,290
!لا نريد أي فاشل في هذه الغابة

109
00:10:36,750 --> 00:10:39,330
!أنتما مخطئان! لستُ فاشلاً بعد الآن

110
00:10:39,410 --> 00:10:40,540
...قلتُ

111
00:10:40,620 --> 00:10:42,790
!...مؤلم! أيّها

112
00:10:46,420 --> 00:10:49,800
!أيّها الغبيّ! ستدفع ثمن ذلك

113
00:10:55,010 --> 00:10:57,310
!أعتقد قلتُ لكما أن تتوقّفا

114
00:10:57,390 --> 00:10:58,980
...أنت

115
00:11:01,940 --> 00:11:03,150
الّذي رأيناه البارحة

116
00:11:05,400 --> 00:11:08,320
هل قبضتايّ لم تكونا كافيتين؟

117
00:11:08,400 --> 00:11:10,280
...سيّد ناتسومي

118
00:11:10,360 --> 00:11:12,910
سيّد ناتسومي -
ماذا؟ من هناك؟ -

119
00:11:13,700 --> 00:11:17,120
هل نسيتِ يا ريكو ناتسومي؟ -

120
00:11:17,200 --> 00:11:20,210
"عندما يحلّ الرّبيع، سأعيد اسمك لك"

121
00:11:20,290 --> 00:11:22,420
أليس هذا ما قلتِه؟

122
00:11:23,080 --> 00:11:26,090
ريكو تلك! إنّها فوضى أخرى خلّفَتْها

123
00:11:26,170 --> 00:11:28,920
كم "ربيعاً" مضى منذ ذلك الحين؟

124
00:11:31,970 --> 00:11:34,390
هل كنت أنت من ناداني؟

125
00:11:35,180 --> 00:11:37,430
سينسي، من فضلك تولّ أمر الزّبديّة -
!مياو -

126
00:11:44,440 --> 00:11:47,440
اقبل هذا يا ساوارابي. إنّه اسمك

127
00:11:54,030 --> 00:11:56,160
...لحظة، هل هذا ناتسومي

128
00:11:56,240 --> 00:11:58,540
الشّخص الّذي يحمل كِتاب الأصدقاء؟

129
00:11:59,580 --> 00:12:02,910
أقبل بالاستلام

130
00:12:04,830 --> 00:12:07,710
كِتاب الأصدقاء... سمعتُ به

131
00:12:08,210 --> 00:12:11,590
كلّ شخص دُوِّنَ اسمه مُقيّد
بخدمة مالك الكِتاب

132
00:12:12,920 --> 00:12:14,890
!سوف تؤخَذ أسماؤنا

133
00:12:15,390 --> 00:12:17,470
!لنهرب

134
00:12:17,550 --> 00:12:19,930
ماذا أصابهما فجأة؟

135
00:12:20,020 --> 00:12:24,850
مُحال لشخصٍ أعاد اسماً للتو
أن يأخذ اسماً آخر

136
00:12:28,060 --> 00:12:30,320
دوّنتُ اسمي على هذا

137
00:12:30,400 --> 00:12:32,740
!من فضلك اجعلني خادمك

138
00:12:32,820 --> 00:12:35,200
!أعِدُك بأن أكون مُفيداً لك

139
00:12:36,570 --> 00:12:37,450
لستُ بحاجة لهذا

140
00:12:41,910 --> 00:12:43,460
لأنّني ضعيفٌ جدّاً

141
00:12:44,460 --> 00:12:46,630
لا حاجة لك منّي؟

142
00:12:48,130 --> 00:12:50,960
لا أريدك أن تتقيّد بواسطة شيء كهذا

143
00:12:51,630 --> 00:12:54,880
العلاقة بيننا ليست علاقة سيّد وخادم

144
00:12:56,510 --> 00:12:57,470
أليس كذلك؟

145
00:13:00,560 --> 00:13:04,060
يجب أن تكون علاقتنا مختلفة عن ذلك

146
00:13:16,360 --> 00:13:18,320
يا له من لون جميل

147
00:13:18,400 --> 00:13:19,660
سأذهب لتبديل ملابسي

148
00:13:20,780 --> 00:13:23,450
نصحني صديقي بمحلّ الفخّاريات هذا

149
00:13:24,280 --> 00:13:27,500
بما أنّ عائلتنا قد كبرت، ارتأيتُ
بأنّها كانت فرصة جيّدة

150
00:13:30,830 --> 00:13:33,960
هذه لك يا تاكاشي

151
00:13:34,800 --> 00:13:36,460
شكراً جزيلاً لك

152
00:13:38,840 --> 00:13:40,800
مثلما أخبرتُ ذلك الثّعلب الصّغير

153
00:13:40,880 --> 00:13:42,550
عمّاذا تتكلّم يا ناتسومي؟

154
00:13:43,430 --> 00:13:45,890
المسألة لا تتعلّق بفائدتك من عدمها

155
00:13:47,100 --> 00:13:48,680
كلامك غير مفهوم

156
00:13:56,860 --> 00:13:58,490
!إنّها جميلة كما توقّعت

157
00:14:01,070 --> 00:14:04,030
أرغب في أن يراها ناتسومي

158
00:14:05,080 --> 00:14:06,120
...ناتسومي

159
00:14:06,910 --> 00:14:08,750
أريد رؤية ناتسومي

160
00:14:12,170 --> 00:14:14,670
!الرّجال لا يملكون وقتاً للبُكاء

161
00:14:14,750 --> 00:14:18,420
!وعدتُ أن أصبح أقوى وأكون نافعاً لناتسومي

162
00:14:22,970 --> 00:14:25,350
أتريد أن ترى ناتسومي بهذا الإلحاح؟

163
00:14:26,600 --> 00:14:28,560
سمعتُ الإشاعات

164
00:14:29,060 --> 00:14:34,310
،أصبحتَ من معارف ناتسومي
مالِك كِتاب الأصدقاء

165
00:14:37,110 --> 00:14:40,240
ما زلت عاجزاً عن اتّخاذ شكل بشريّ كامل؟

166
00:14:41,400 --> 00:14:45,410
،إذا استطعت إحضار الكثير من السّمك لي كي آكله

167
00:14:45,490 --> 00:14:49,120
فسأخبرك كيف تستطيع اللِّقاء بناتسومي

168
00:15:10,560 --> 00:15:14,230
والآن هل ستخبرني كيف يمكنني
اللّقاء بناتسومي؟

169
00:15:19,690 --> 00:15:23,240
ثعلب صغير غبيّ. لقد تمّ خِداعك

170
00:15:23,320 --> 00:15:27,160
بسبب حماقتك أنت وحيد دوماً

171
00:15:27,240 --> 00:15:31,450
ناتسومي أيضاً قد نسي أمرك بالفعل

172
00:15:37,210 --> 00:15:39,170
خذ هذه أيّها الثّعلب الصّغير

173
00:15:40,250 --> 00:15:43,720
ستحوّلك هذه الحبّة إلى بشريّ
لمدّة يوم واحد

174
00:15:43,800 --> 00:15:46,550
حبّة للتحوّل إلى بشريّ؟

175
00:15:48,140 --> 00:15:51,680
إذا أردت رؤيته، فينبغي أن تذهب إليه بنفسك

176
00:15:51,770 --> 00:15:53,770
هذا كلّ ما أعرفه

177
00:15:58,270 --> 00:16:01,190
!فهمت. ينبغي أن أذهب إليه

178
00:16:23,590 --> 00:16:27,260
حسناً! فأنا ثعلب في نهاية المطاف

179
00:16:27,340 --> 00:16:30,300
!حالما أختلط بين البشر، سأتعقّب رائحةَ ناتسومي

180
00:16:31,720 --> 00:16:33,640
!سأغادر يا أمّي

181
00:16:53,160 --> 00:16:56,410
أتساءل ما إن كان ناتسومي
بمفرده ويشعر بالوحشة

182
00:17:12,800 --> 00:17:13,970
رائحة ناتسومي؟

183
00:17:26,740 --> 00:17:29,400
!ناتسومي... هذه رائحة ناتسومي

184
00:17:43,670 --> 00:17:44,880
!أريد رؤيته

185
00:17:46,250 --> 00:17:48,630
!يا فتى! انتبه وأنت تمشي

186
00:17:49,130 --> 00:17:50,470
ناتسومي، أين أنت؟

187
00:17:53,140 --> 00:17:54,100
...ناتسومي

188
00:17:54,180 --> 00:17:55,640
يا إلهي، هل أنت بخير؟

189
00:17:55,720 --> 00:17:57,430
هل أنت لوحدك؟ أين أمّك؟

190
00:17:57,520 --> 00:17:59,100
!أنا بخير بمفردي

191
00:18:03,360 --> 00:18:04,820
أريد رؤيته

192
00:18:05,320 --> 00:18:06,730
...أريد رؤيته

193
00:18:06,820 --> 00:18:09,150
أين؟ أين ناتسومي؟

194
00:18:11,030 --> 00:18:12,240
!ناتسومي

195
00:18:13,490 --> 00:18:15,660
!أكلت الطّعم! اسحب! اسحب

196
00:18:16,240 --> 00:18:18,080
!هذه سمكة كبيرة

197
00:18:18,160 --> 00:18:21,160
أنت من جديد يا ناتسومي؟
أنت تصطاد كلّ السّمك

198
00:18:21,250 --> 00:18:22,330
آسف

199
00:18:22,830 --> 00:18:25,670
مياو. مياو

200
00:18:26,500 --> 00:18:28,210
!من سمح لك بأكل هذه؟

201
00:18:32,550 --> 00:18:33,890
!رائحة ناتسومي

202
00:18:33,970 --> 00:18:36,890
!إنّه هنا! إنّه قريب

203
00:18:36,970 --> 00:18:38,310
!يمكنني اللّقاء به

204
00:19:03,830 --> 00:19:05,500
!العشاء جاهز

205
00:19:05,580 --> 00:19:07,170
!اصطاد تاكاشي سمكة تروتة ضخمة

206
00:19:07,250 --> 00:19:10,300
يا له من صيد وفير...

207
00:19:10,380 --> 00:19:12,300
شكراً لك على الطّعام يا تاكاشي -
العفو -

208
00:19:12,800 --> 00:19:15,050
تاكاشي، لا تمانع أسماك المياه العذبة، صحيح؟

209
00:19:15,140 --> 00:19:17,010
أجل. يمكنني أكل أي شيء بلا مشاكل

210
00:19:17,100 --> 00:19:19,600
لا تتردّد في إخبارنا عن أيّ شيء لا تحبّه

211
00:19:19,680 --> 00:19:24,230
.شيغيرو لا يحبّ الفليفلة الخضراء
إنّه كطفل صغير

212
00:19:25,400 --> 00:19:29,020
عندما كنتُ صغيراً، لم أكن أحبّها أيضاً

213
00:19:29,110 --> 00:19:31,780
هكذا إذاً! لديّ حليف

214
00:19:33,280 --> 00:19:34,530
تفضّل

215
00:19:34,610 --> 00:19:35,950
لنتذوّق

216
00:19:38,120 --> 00:19:42,040
أعترف يا توكو. تطبخين السّمك بمهارة

217
00:19:43,210 --> 00:19:45,290
أعتقد سأتناول حصّتي أيضاً

218
00:19:45,370 --> 00:19:46,540
تفضّلي

219
00:19:47,920 --> 00:19:48,750
كيف وجدتِها؟

220
00:19:50,050 --> 00:19:51,500
!شهيّة

221
00:19:52,010 --> 00:19:55,970
هذه مُناسبة سعيدة. من اللّطيف
أن أُدعَى إلى وجبة كهذه

222
00:20:03,020 --> 00:20:07,190
أنا مسرور جدّاً. ناتسومي يستمتع بنفسه

223
00:20:07,270 --> 00:20:09,440
!إنّه غير وحيد إطلاقاً

224
00:20:10,150 --> 00:20:11,780
...الشّخص الوحيد

225
00:20:12,480 --> 00:20:14,490
هو أنا

226
00:20:22,410 --> 00:20:23,830
!انتظري

227
00:20:30,670 --> 00:20:31,840
توقّعت

228
00:20:32,960 --> 00:20:34,970
أنت ذاك الثّعلب الصّغير، أليس كذلك؟

229
00:20:35,470 --> 00:20:36,300
شكراً

230
00:20:36,800 --> 00:20:38,430
أتيت لرؤيتي، صحيح؟

231
00:21:14,800 --> 00:21:16,460
هذه قبّعة ظريفة

232
00:21:18,010 --> 00:21:20,140
لنأكل شيئاً ثمّ أرافقك إلى الدّيار

233
00:21:22,350 --> 00:21:23,850
يجب أن أحفظ الطّريق

234
00:21:24,350 --> 00:21:26,680
في المرّة المقبلة، سآتي لزيارتك

235
00:21:30,770 --> 00:21:31,650
!حسناً

236
00:21:40,610 --> 00:21:42,370
أنت شُجاع حقّاً

237
00:21:42,870 --> 00:21:46,830
عندما كنتُ وحيداً، كنتُ أخشى
أن أخطو خطوة للأمام

238
00:21:46,910 --> 00:21:49,290
لم أفكّر أبداً في محاولة إصلاح الأمور بنفسي

239
00:21:50,040 --> 00:21:52,710
بسبب ذلك، قد يكون هناك الكثير

240
00:21:52,790 --> 00:21:55,000
ممّا فشلتُ في ملاحظته حتّى الآن

241
00:23:35,690 --> 00:23:37,480
يستطيع ذلك الرّجل رؤية اليوكاي

242
00:23:37,560 --> 00:23:40,150
اتّصل قلباهما ببعضهما الآخر فأصبح عزيزاً عليه

243
00:23:40,780 --> 00:23:41,650
...حتّى جاء يوم

244
00:23:41,730 --> 00:23:43,650
بدا أنّه يفقد القدرة على رؤية الأياكاشي

245
00:23:43,740 --> 00:23:45,610
...إذا كان حبيبي سعيداً

246
00:23:45,700 --> 00:23:46,990
فلا أبالي

247
00:23:47,070 --> 00:23:48,910
هل أنتِ متأكِّدة يا كيو؟