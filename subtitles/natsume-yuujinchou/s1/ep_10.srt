1
00:01:32,950 --> 00:01:36,330
أريد أن أتكتّم على سرّ رؤيتي لليوكاي

2
00:01:38,580 --> 00:01:39,750
هناك مِظلّة تطير

3
00:01:40,420 --> 00:01:41,250
مِظلّة؟

4
00:01:41,340 --> 00:01:42,460
أين؟

5
00:01:42,550 --> 00:01:45,460
!هناك! انظر -
أين؟ لا أرى شيئاً -

6
00:01:46,800 --> 00:01:48,760
أين؟

7
00:01:53,510 --> 00:01:56,430
آسف، لا بدّ أنّني كنتُ مخطئاً -
متأكّد؟ -

8
00:01:57,270 --> 00:01:58,690
!وداعاً يا ناتسومي

9
00:01:58,770 --> 00:02:00,480
!أراك غداً -
!حسناً -

10
00:02:11,030 --> 00:02:14,740
هل يمكنك رؤيتي؟ أيّها الطّفل البشريّ

11
00:02:21,750 --> 00:02:24,130
إذاً دعني أخبرك

12
00:02:24,210 --> 00:02:27,800
لا أريد أن أمسّ البشر، لكن لا أملك خياراً

13
00:02:30,680 --> 00:02:33,260
أحتاج جسدَك هذا لبعض الوقت

14
00:02:33,350 --> 00:02:34,510
!تـ... توقّف

15
00:02:34,600 --> 00:02:37,140
هيّا، دعني أحصل عليه

16
00:02:38,770 --> 00:02:40,230
!توقّف

17
00:02:41,100 --> 00:02:42,980
!قلتُ توقّف

18
00:02:51,530 --> 00:02:54,280
أنت عصبيّ حقّاً

19
00:02:54,370 --> 00:02:55,990
...نيانكو-سينسي

20
00:02:58,410 --> 00:03:00,370
يحتوي على كالسيوم. كُل

21
00:03:01,580 --> 00:03:02,830
لا أريد

22
00:03:02,920 --> 00:03:05,880
!تبّاً! ما مشكلتي؟

23
00:03:05,960 --> 00:03:09,130
بالنّسبة لبشريّ، لكمتك قويّة

24
00:03:09,210 --> 00:03:10,050
!حسناً إذاً

25
00:03:10,130 --> 00:03:12,590
!على أيّ حال، ما زلتُ بحاجة لجسدك

26
00:03:12,680 --> 00:03:13,930
ما خطبك؟

27
00:03:14,010 --> 00:03:16,100
انتظر لحظة يا أكاغاني

28
00:03:16,180 --> 00:03:20,060
أيّها الطّفل البشريّ، من فضلك سامح
هذا الرّجل على سلوكه الفظّ

29
00:03:20,810 --> 00:03:22,810
كلّ شيء هو لأجلي

30
00:03:22,900 --> 00:03:24,980
أتى صوت من ذاك القرع

31
00:03:25,060 --> 00:03:28,360
!أساغي، لا تتكلّمي! سوف تُرهقي نفسكِ

32
00:03:28,860 --> 00:03:30,240
...أنا

33
00:03:42,120 --> 00:03:44,120
يبدو أنّها نامت

34
00:03:45,130 --> 00:03:47,880
أساغي... سمعتُ هذا الاسم من قبل

35
00:03:49,460 --> 00:03:54,470
غابة إيسوزوكي، قرية أشباح حيث
تتجمّع الآلهة النّبلاء

36
00:03:54,550 --> 00:03:58,970
هناك، تعيش عازِفة كوتو حسناء وتعزف

37
00:04:00,470 --> 00:04:03,350
أهذه هي أساغي الّتي تتحدّث عنها؟ -
أجل -

38
00:04:03,440 --> 00:04:06,310
لكن ضَعُفَ جسدُها ولم تعُد قادرة
على العزف على الكوتو

39
00:04:06,400 --> 00:04:08,400
أُعيدَتْ إلى موطنها

40
00:04:08,980 --> 00:04:13,610
كانت كثيراً ما تبتسم، لكن خارت طاقتها الآن

41
00:04:15,160 --> 00:04:20,040
لهذا السّبب أيّها الطّفل البشريّ، أحتاج
جسدك من أجل أساغي

42
00:04:21,950 --> 00:04:25,670
إن لم تفعل ما أقوله، فسأمزّق
أُذنيك وأنفك بأسناني

43
00:04:25,750 --> 00:04:27,380
!أعطِني إيّاه! دعني أحصل عليه

44
00:04:27,460 --> 00:04:30,380
!انتظر يا متدنّي المستوى! إنّه لي

45
00:04:32,170 --> 00:04:34,090
!عضّني راكون

46
00:04:34,760 --> 00:04:35,630
!ماذا ناديتني؟

47
00:04:36,220 --> 00:04:37,590
!كُفّ عن الضّحك يا تمثال بوذا

48
00:04:38,220 --> 00:04:41,640
،إذا أرخيت دفاعك أمام أياكاشي
فلن تكون النّتائج مُبشِّرة

49
00:04:42,350 --> 00:04:44,100
لا سيّما عندما يطالب بجسدك

50
00:04:46,230 --> 00:04:48,770
...كانت كثيراً ما تبتسم

51
00:04:49,650 --> 00:04:53,940
لكن رغم ذلك، أشعر بالشّفقة عليهم

52
00:05:04,000 --> 00:05:06,120
!عُدت

53
00:05:07,710 --> 00:05:10,290
صباح الخير يا نيانكو-سينسي

54
00:05:10,380 --> 00:05:12,130
هل سهرت اللّيل كلّه ثانية؟

55
00:05:14,630 --> 00:05:16,720
ناتسومي، شعرك

56
00:05:19,220 --> 00:05:21,560
عيناي زرقاوتان أيضاً

57
00:05:24,430 --> 00:05:26,350
كيف حدث هذا؟

58
00:05:28,060 --> 00:05:29,440
ماذا؟ عدتُ إلى طبيعتي

59
00:05:31,690 --> 00:05:33,440
هل كنتُ أتوهّم؟

60
00:05:33,530 --> 00:05:36,110
!مرحباً! صباح الخير يا ناتسومي

61
00:05:38,570 --> 00:05:40,870
!أجل. صباح الخير

62
00:05:45,700 --> 00:05:47,710
صباح... الخير يا كيتاموتو

63
00:05:47,790 --> 00:05:49,670
فاجأتني

64
00:05:49,750 --> 00:05:51,670
لوهلة، ظننتُك شخصاً آخر

65
00:05:51,750 --> 00:05:54,210
آسف -
يا إلهي! ما خطبهما؟ -

66
00:05:56,760 --> 00:05:57,880
!ناتسومي

67
00:05:58,970 --> 00:06:00,510
شكراً على القاموس

68
00:06:02,010 --> 00:06:02,890
أنا مَدين لك

69
00:06:03,560 --> 00:06:04,970
أجل

70
00:06:10,400 --> 00:06:11,770
ناتسومي، سقط منك

71
00:06:21,490 --> 00:06:23,080
شكراً يا تانوما

72
00:06:24,370 --> 00:06:25,370
تانوما؟

73
00:06:27,120 --> 00:06:31,710
آسف... لوهلة بدوتَ كامرأة يا ناتسومي

74
00:06:31,790 --> 00:06:33,920
المعذرة. كنتُ أتوهّم فحسب

75
00:06:36,210 --> 00:06:37,630
!آ... آسف

76
00:06:38,470 --> 00:06:39,340
...وهكذا

77
00:06:39,420 --> 00:06:41,140
،أتفهّم الأمر بالنّسبة لكيتاموتو

78
00:06:41,220 --> 00:06:44,890
...لكن إذا شعر تانوما بشيء، فهل هذا يعني

79
00:06:54,110 --> 00:06:55,940
فعلت شيئاً، أليس كذلك؟

80
00:06:56,020 --> 00:06:57,320
،بينما كنتَ نائماً

81
00:06:57,400 --> 00:07:00,490
استغرقتُ وقتي في إدخال أساغي إلى جسدك

82
00:07:02,200 --> 00:07:04,410
يبدو أنّ المُزامنة قد سارت على ما يُرام

83
00:07:04,990 --> 00:07:07,410
من فضلك تعاون لبعض الوقت فحسب

84
00:07:12,710 --> 00:07:16,630
إذاً الشّعر الأزرق والعينان الزّرقاوتان
كانتا علامة على الاستحواذ

85
00:07:16,710 --> 00:07:18,380
أعتذر

86
00:07:19,090 --> 00:07:21,630
،قلتُ له ألّا يفعلها

87
00:07:21,720 --> 00:07:25,600
لكن لم أكن أملك قوّة لإيقافه. سامحني

88
00:07:26,560 --> 00:07:28,930
هذا الصّوت... هل أنتِ أساغي؟

89
00:07:29,020 --> 00:07:31,770
من فضلك لا تلُم رفيقي

90
00:07:33,400 --> 00:07:35,480
أنا المُلامة

91
00:07:35,560 --> 00:07:38,230
ليس عليكِ الاعتذار

92
00:07:39,740 --> 00:07:41,610
أنا آسفة جدّاً

93
00:07:44,870 --> 00:07:47,280
طريقة لتحرير شخص من جسدك؟

94
00:07:47,370 --> 00:07:49,660
أجل. طريقة بعيدة عن العنف

95
00:07:50,540 --> 00:07:53,960
في هذه الحالة، الطّريقة الوحيدة
هي تحقيق أمنية أساغي

96
00:07:54,040 --> 00:07:57,920
إذا تمّت مُعالجة مشاعرها، فسوف
تغادر جسدك من تلقاء نفسها

97
00:07:59,050 --> 00:08:01,300
أجل، لكن أي أمنية؟

98
00:08:01,380 --> 00:08:03,800
!لا جدوى من الشّكوى

99
00:08:04,380 --> 00:08:07,010
أنهِ الأمر فحسب وعُد إلى المنزل
أيّها الطّفل البشريّ

100
00:08:07,100 --> 00:08:08,470
!انظروا من يتكلّم

101
00:08:09,060 --> 00:08:11,810
من أين ظهرت؟ ما اسمك؟

102
00:08:11,890 --> 00:08:14,440
لا أملك اسماً يستحقّ المشاركة مع البشر

103
00:08:14,940 --> 00:08:17,650
!إذا كان هذا ما تريده، فسأناديك جانومي إذاً

104
00:08:17,730 --> 00:08:19,070
جانومي، كما في مظلّة الورق

105
00:08:19,150 --> 00:08:21,490
!ماذا؟! أنا... جانومي؟

106
00:08:22,440 --> 00:08:24,240
!شكراً على المجيء لمرافقتنا

107
00:08:24,820 --> 00:08:26,450
!أيّها الرّاكون اللّعين

108
00:08:26,530 --> 00:08:30,790
أعتقد بأنّه اسم ظريف! كم هذا
لطيف يا جانومي

109
00:08:30,870 --> 00:08:32,870
!أساغي! حتّى أنتِ

110
00:08:34,500 --> 00:08:37,420
أين المشكلة فيه؟ أظنّه طريفاً

111
00:08:38,210 --> 00:08:39,550
...أساغي

112
00:08:42,550 --> 00:08:44,550
!مقرف... للغاية

113
00:08:44,630 --> 00:08:46,930
فقدتُ للتو سيطرتي على جسدي

114
00:08:47,840 --> 00:08:51,010
فعلتُ ذلك بلا تفكير. أنا آسفة جدّاً

115
00:08:51,520 --> 00:08:53,140
حسناً، فهمت

116
00:08:53,230 --> 00:08:54,890
سأتعاون

117
00:08:54,980 --> 00:08:57,100
إذا عزفَتْ على الكوتو، هل ستدعني وشأني؟

118
00:08:57,190 --> 00:08:58,360
!بالطّبع

119
00:08:59,360 --> 00:09:02,690
لحظة، تقصد بأنّنا سنبدأ بصنع كوتو؟

120
00:09:02,780 --> 00:09:05,990
أجل. يجب أن يكون كوتو مُميّزاً

121
00:09:06,070 --> 00:09:07,740
"هناك أياكاشي يُدعى "سينبيكي

122
00:09:07,820 --> 00:09:10,830
يشبه الشبُّوط ولديه خيوط
بيضاء على رأسه

123
00:09:10,910 --> 00:09:13,000
!سوف نصطاده

124
00:09:13,500 --> 00:09:15,710
لِمَ علينا اصطياد سمكة؟

125
00:09:15,790 --> 00:09:18,580
!ماذا؟! كُفّ عن الشّكوى

126
00:09:19,080 --> 00:09:21,670
ما هذه النّظرة؟

127
00:09:21,750 --> 00:09:24,050
!أنا من سيفعلها

128
00:09:27,130 --> 00:09:33,430
!ابحث

129
00:09:37,020 --> 00:09:38,100
أنا مُرهَق

130
00:09:38,190 --> 00:09:40,610
أنا آسفة جدّاً يا ناتسومي-ساما -
!أين أنت؟ -

131
00:09:40,690 --> 00:09:42,150
لا، لا مشكلة

132
00:09:43,820 --> 00:09:48,320
ما طبيعة علاقتكِ مع جانومي على أي حال؟

133
00:09:52,120 --> 00:09:53,910
هل أنتما... حبيبان؟

134
00:09:55,870 --> 00:09:57,040
لا، المسألة ليست كذلك

135
00:09:57,120 --> 00:09:59,830
كان جانومي ماسِك المِظلّة

136
00:09:59,920 --> 00:10:01,130
ماسِك المِظلّة؟

137
00:10:02,670 --> 00:10:06,510
،في غابة إيسوزوكي، إله الغابة، ميبو-ساما

138
00:10:06,590 --> 00:10:09,470
كان قد جمع حوله أصحاب الموهبة العظيمة

139
00:10:10,340 --> 00:10:15,220
كان دور جانومي هو تقديم المِظلّات
،لميبو-ساما والآخرين

140
00:10:15,310 --> 00:10:20,850
والعمل كحامٍ للجميع

141
00:10:21,770 --> 00:10:24,480
إنّه ماهرٌ جدّاً

142
00:10:38,250 --> 00:10:42,420
كان إيسوزوكي مكاناً جميلاً. كحلم تماماً

143
00:10:43,500 --> 00:10:45,340
أردتُ البقاء هناك طوال الوقت

144
00:10:45,840 --> 00:10:49,550
ظننتُ أنّ بوسعي العيش بجانب
ميبو-ساما للأبد

145
00:10:50,300 --> 00:10:53,640
...دائماً وأبداً

146
00:10:56,350 --> 00:10:59,140
أن يطردوكِ، فقط لأنّكِ لم تعودي
...قادرة على العزف

147
00:10:59,230 --> 00:11:02,310
يبدو إلَهاً ضيّق التّفكير وفظيعاً

148
00:11:02,810 --> 00:11:04,360
أنت مخطئ يا ناتسومي-ساما

149
00:11:04,440 --> 00:11:08,820
ميبو-ساما تبنّاني عندما لم يكن
لي أي مكان أذهب إليه

150
00:11:09,400 --> 00:11:11,740
كنتُ أنا من لم يتحمّل فكرة
،كوني عديمة الجدوى

151
00:11:11,820 --> 00:11:13,820
ولهذا هربت

152
00:11:15,910 --> 00:11:19,040
!وجدتُها! سينبيكي

153
00:11:19,120 --> 00:11:23,000
!أمسكتُ بواحدة

154
00:11:24,750 --> 00:11:28,300
أترى ما أعنيه؟ هذه الخيوط هنا هي
ما سنستخدمه كأوتار

155
00:11:28,380 --> 00:11:31,170
إذاً نكون هذا قد أمّنّا المواد؟

156
00:11:31,260 --> 00:11:34,470
لا، علينا صنع الهيكل تالياً

157
00:11:34,550 --> 00:11:37,310
!ماذا؟ -
!لنبحث عن أرومة شجرة -

158
00:11:37,390 --> 00:11:42,980
ويجب أن تكون شجرة قد نبتت
منها قصبة خيزران للتو

159
00:11:49,280 --> 00:11:53,070
بقي القليل فقط... القليل لتتمكّني من العزف

160
00:11:58,540 --> 00:12:02,540
يهتمّ جانومي لأمر أساغي حقّاً

161
00:12:08,830 --> 00:12:11,170
كيف ابتللت إلى هذا الحدّ؟

162
00:12:11,250 --> 00:12:12,670
لا شيء

163
00:12:12,750 --> 00:12:15,720
،تحتاج منشفة. بئساً يا تاكاشي
ستُصاب بنزلة برد هكذا

164
00:12:15,800 --> 00:12:17,970
!أنا بخير! لا تقلقي من فضلكِ

165
00:12:19,260 --> 00:12:20,720
أترى ما أعنيه؟

166
00:12:20,800 --> 00:12:22,970
حسناً، جفّف نفسك

167
00:12:23,060 --> 00:12:25,350
أنت مبتلٌّ بشدّة حقّاً

168
00:12:27,060 --> 00:12:28,940
أردتُ البقاء هناك طوال الوقت

169
00:12:29,860 --> 00:12:31,110
...دائماً وأبداً

170
00:12:31,820 --> 00:12:34,440
حريّ بك أن تستحمّ الآن. مفهوم؟

171
00:12:35,190 --> 00:12:38,570
،انتهيتُ للتو من تسخين المياه
ادخل بسرعة

172
00:12:38,660 --> 00:12:42,660
إلى متى بالضّبط سأتمكّن
من البقاء هنا؟

173
00:13:14,230 --> 00:13:18,150
هل كان ذلك حلماً؟ لا، كانت أساغي

174
00:13:19,910 --> 00:13:21,280
جانومي

175
00:13:21,370 --> 00:13:23,280
هل أيقظتُك يا ناتسومي؟

176
00:13:23,370 --> 00:13:24,370
تقريباً

177
00:13:24,450 --> 00:13:27,410
لكن لا تزال أساغي نائمة، إذا
...أردت التكلُّم معها

178
00:13:27,500 --> 00:13:30,120
لم تعُد أصابع أساغي قادرة
على عزف ا لكوتو

179
00:13:31,500 --> 00:13:35,340
إنّها مُصابة بمرض  يُفتّت جسدها كتُراب

180
00:13:35,420 --> 00:13:37,340
لن تكون أبداً كما كانت

181
00:13:38,590 --> 00:13:42,930
،لكن بينما هي في جسد شخص آخر
يتأخُّر تطوُّر المرض

182
00:13:43,430 --> 00:13:45,390
أنا ممتنٌّ لك يا ناتسومي

183
00:13:46,770 --> 00:13:49,020
،آخر مرّة رأيتُ فيها ابتسامتها

184
00:13:49,100 --> 00:13:50,350
كانت تعزف على الكوتو بسعادة

185
00:13:51,020 --> 00:13:54,360
أمام ميبو-ساما

186
00:13:54,940 --> 00:13:56,360
...أثناء ذلك الأداء

187
00:13:59,530 --> 00:14:01,950
بدأت بشرتها تتصدّع

188
00:14:02,450 --> 00:14:06,160
...أصابعها البيضاء النّحيلة، وخدّاها المُضيئان

189
00:14:06,240 --> 00:14:09,080
كلّ ذلك أمام ميبو-ساما

190
00:14:10,750 --> 00:14:12,080
غداً سيكون القمر بدراً

191
00:14:12,580 --> 00:14:15,500
سيُمهَّد طريق واحد نحو إيسوزوكي لفترة قصيرة

192
00:14:15,590 --> 00:14:20,550
أريد أن أتيح لها العزف أمام ميبو-ساما مرّة أخرى

193
00:14:21,130 --> 00:14:25,220
ساعدني حتّى ذلك الحين
من فضلك يا سيّد ناتسومي

194
00:14:25,890 --> 00:14:27,810
...جانومي، لماذا تفعل

195
00:14:29,060 --> 00:14:30,770
كلّ هذا؟

196
00:14:33,600 --> 00:14:34,770
...أنا

197
00:14:45,030 --> 00:14:47,370
!طاب يومك، أكاغاني

198
00:14:47,990 --> 00:14:49,370
أنا مجرّد

199
00:14:50,500 --> 00:14:52,460
ماسِك مِظلّة

200
00:14:57,840 --> 00:15:01,130
!تبّاً! هذا أصعب ممّا توقّعت

201
00:15:02,630 --> 00:15:05,260
لا أستطيع إيجاد أرومات إطلاقاً -
!أين؟! أين هي؟ -

202
00:15:07,050 --> 00:15:09,220
هل هو متأكّد بأنّ هذا هو المكان الصّحيح؟

203
00:15:17,190 --> 00:15:21,150
أتبحث عن شيء؟ -
أرومة شجرة وقصبة خيزران بارزة منها -

204
00:15:21,230 --> 00:15:24,030
في هذه الحالة، انظر! هناك
واحدة بين الأجمة

205
00:15:26,660 --> 00:15:28,280
!معك حقّ! إنّي أراها

206
00:15:29,410 --> 00:15:31,040
لحظة، مع من تكلّمتُ للتو؟

207
00:15:31,120 --> 00:15:33,960
!أخبرتُك بما طُلِبَ منك. أخبرتُك

208
00:15:34,040 --> 00:15:37,460
!والآن بالمقابل، سأحصل على أمعائك

209
00:15:39,210 --> 00:15:42,760
!اللّعنة! تكلّمتُ بالخطأ مع يوكاي غريب

210
00:15:43,670 --> 00:15:47,300
ناتسومي! هل تبحث جيّداً؟

211
00:15:49,720 --> 00:15:52,720
!أحسنت يا ناتسومي! هذا ما نحتاجه بالضّبط

212
00:15:52,810 --> 00:15:56,190
!حسناً، لنسرع ونقطّع هذا الشّيء

213
00:16:03,820 --> 00:16:05,570
بدأتُ أشعر بدُوار

214
00:16:06,740 --> 00:16:10,160
هل هذا الشّعور بالحمّى سببه أساغي؟

215
00:16:11,450 --> 00:16:14,290
...إذا عزفَتْ وهي بهذه الحالة السيّئة

216
00:16:15,120 --> 00:16:16,790
...فإنّ طاقة حياة أساغي

217
00:16:18,460 --> 00:16:19,710
هل أنت بخير؟

218
00:16:20,210 --> 00:16:23,090
سامحني. كلّ هذا غلطتي

219
00:16:23,170 --> 00:16:26,590
...تذكّرت. نسيتُ أن أسأل، لكن

220
00:16:26,680 --> 00:16:27,930
نعم؟

221
00:16:28,590 --> 00:16:31,680
هل أنتِ، بحدِّ ذاتكِ، ترغبين
في العزف على الكوتو؟

222
00:16:32,350 --> 00:16:34,390
...إذا استطعتُ ولو لمرّة واحدة

223
00:16:35,730 --> 00:16:40,110
...إذا سنحَتْ لي فُرصة واحدة، فأنا

224
00:16:40,190 --> 00:16:42,690
،لستُ شخصاً يُجيد استخدام كلتَي يديه

225
00:16:42,770 --> 00:16:46,320
وأصابعي مُتحجِّرة. قد لا أتمكّن
من العزف بشكل جيّد

226
00:16:46,400 --> 00:16:47,610
لكن هل هذا مناسب؟

227
00:16:49,950 --> 00:16:50,870
أجل

228
00:17:04,210 --> 00:17:06,760
أساغي، هل تعلمين؟

229
00:17:07,260 --> 00:17:12,220
عندما يتعلّق الأمر بكِ، أكاغاني
يفكّر بكِ دوماً

230
00:17:17,730 --> 00:17:20,770
!اكتمل! ناتسومي، استيقظ

231
00:17:21,980 --> 00:17:23,020
!جيّد

232
00:17:23,650 --> 00:17:25,400
!ما زال هناك وقت. هيّا بنا

233
00:17:27,110 --> 00:17:30,450
أكاغاني! ما الأمر؟ ما الّذي يجري؟

234
00:17:30,530 --> 00:17:35,160
أساغي، إذا ذهبنا الآن، سيبقى الطّريق
!إلى غابة إيسوزوكي مفتوحاً

235
00:17:35,240 --> 00:17:36,660
...نذهب ثمّ

236
00:17:36,750 --> 00:17:39,160
...ميبو-ساما -
!وجدتُك -

237
00:17:39,250 --> 00:17:42,630
!كما وعدت، أتيتُ لأجل أمعائك

238
00:17:43,500 --> 00:17:44,340
!إنّه ذاك اليوكاي

239
00:17:52,470 --> 00:17:53,600
...أكاغاني

240
00:17:58,730 --> 00:17:59,850
!تبّاً

241
00:18:03,150 --> 00:18:04,270
!الكوتو

242
00:18:04,360 --> 00:18:08,740
...الآلة الثّمينة... لأساغي... وجانومي

243
00:18:09,320 --> 00:18:10,950
!ناتسومي

244
00:18:16,910 --> 00:18:20,080
!ناتسومي

245
00:18:22,420 --> 00:18:23,250
هل أنت بخير؟

246
00:18:23,330 --> 00:18:25,210
...أ... أجل

247
00:18:26,000 --> 00:18:27,800
أبعدتُ ذلك الشّيء

248
00:18:28,670 --> 00:18:29,630
ماذا عن الكوتو؟

249
00:18:30,630 --> 00:18:33,340
إنّه سليم. لأنّك حميته

250
00:18:33,930 --> 00:18:36,140
فهمت... يسرّني ذلك

251
00:18:36,760 --> 00:18:38,100
هل يمكنك النّهوض؟

252
00:18:38,180 --> 00:18:40,430
إذا أسرعنا، ما زال بمقدورنا اللّحاق

253
00:18:40,520 --> 00:18:42,310
إذا كان ذلك صعباً جدّاً، فسوف أحملك

254
00:18:43,150 --> 00:18:45,560
...لكن يا جانومي، بهذه الجروح

255
00:18:46,060 --> 00:18:47,690
!هيّا بنا يا ناتسومي

256
00:18:50,030 --> 00:18:51,110
!هيّا

257
00:18:58,660 --> 00:19:02,620
إذا كان هذا ممكناً، أردتُ العزف
على الكوتو مرّة أخرى

258
00:19:03,960 --> 00:19:08,460
طوال هذا الوقت، لم أعزف سوى لميبو-ساما

259
00:19:09,170 --> 00:19:10,300
...لهذا السّبب

260
00:19:11,670 --> 00:19:15,340
...إذا ما مُنِحتُ فُرصة أخرى

261
00:19:16,010 --> 00:19:18,850
فسأعزف لصديقي اللّطيف والعزيز

262
00:19:19,510 --> 00:19:22,350
أردتُ العزف لأجلك

263
00:19:23,770 --> 00:19:26,650
أكاغاني، هل ستسمع عزفي؟

264
00:19:45,710 --> 00:19:48,250
سمعتُ موسيقى من بعيد

265
00:19:49,420 --> 00:19:53,220
أصوات جميلة لم أسمعها من قبل

266
00:19:55,380 --> 00:19:57,260
...لكن هذه الأصوات

267
00:19:58,350 --> 00:20:02,350
مصدرها اهتزازات من أصابعي

268
00:20:24,750 --> 00:20:30,920
،كما لو أنّها هوَتْ من السّماء
خرجَتْ أساغي من جسدي

269
00:20:33,760 --> 00:20:35,380
نحن مَدينان لك

270
00:20:35,470 --> 00:20:37,180
ماذا ستفعلان الآن؟

271
00:20:37,680 --> 00:20:39,800
سأعيد أساغي إلى موطنها

272
00:20:40,300 --> 00:20:41,300
فهمت

273
00:20:44,890 --> 00:20:48,190
غطّتْ في نوم عميق جدّاً فحسب

274
00:20:50,230 --> 00:20:53,360
أجل. إلى اللّقاء يا أساغي

275
00:20:54,650 --> 00:20:57,610
أنت أيضاً يا جانومي -
حسناً -

276
00:20:58,990 --> 00:21:01,370
!إلى اللّقاء يا ناتسومي

277
00:21:05,450 --> 00:21:09,120
أين كنت يا سينسي؟ عندما احتجتُك

278
00:21:09,210 --> 00:21:11,790
هل أنت راضٍ الآن يا كثير الانشغالات؟

279
00:21:11,880 --> 00:21:14,300
أنا جائع. اشترِ لي بعض الفطائر المُبخّرة

280
00:21:14,380 --> 00:21:16,260
!لم يفتتح ناناتسوجيا بعد

281
00:21:16,340 --> 00:21:17,970
!ماذا؟

282
00:21:19,300 --> 00:21:23,180
نيانكو-سينسي، هل وجدتَ يوماً مكاناً
حيث تريد البقاء فيه للأبد؟

283
00:21:24,060 --> 00:21:27,100
لن أحتاج واحداً ما دمتُ حيّاً

284
00:21:28,770 --> 00:21:30,600
...أنا مثلك

285
00:21:31,900 --> 00:21:34,360
أو في معظم الوقت، هذا ما ظننتُه

286
00:21:34,440 --> 00:21:36,530
!أحمق! لا عِناق

287
00:21:36,610 --> 00:21:38,450
!أنزلني! حالاً

288
00:21:39,320 --> 00:21:42,070
بتركهما الكوتو ورحيلهما، حاولتُ
،العزف عليه بنفسي

289
00:21:42,160 --> 00:21:45,830
لكن لم تعُد تلك الأصوات الجميلة تخرج

290
00:21:46,790 --> 00:21:52,790
أعتقد لم تكن أصابعي، إنّما كان
قلبها ما يعزف على الأوتار

291
00:21:52,880 --> 00:21:55,500
!الفطور جاهز -
!قادم

292
00:23:35,690 --> 00:23:37,730
!سينسي! ماذا فعلت؟

293
00:23:37,810 --> 00:23:39,480
هل تعتقد بأنّني سأفعل شيئاً كهذا؟

294
00:23:39,570 --> 00:23:40,940
!لا تدّعِ الجهل! اخرج

295
00:23:41,030 --> 00:23:43,700
!حسناً! سأذهب! أنت أحمق يا ناتسومي

296
00:23:43,780 --> 00:23:45,360
ثمّ وقعتُ في حفرة

297
00:23:45,950 --> 00:23:48,740
!يا للهول! وقع خنزيرٌ صغير من السّماء