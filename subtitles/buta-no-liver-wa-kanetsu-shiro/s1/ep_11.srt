1
00:00:48,310 --> 00:00:50,610
.أحسنت بالوصول إلى هنا

2
00:00:50,900 --> 00:00:51,980
...يا جيس

3
00:00:51,980 --> 00:00:53,570
.تفضّلي بالدّخول

4
00:00:53,860 --> 00:00:56,070
.أنت وخنزيرك الذّكيّ

5
00:01:17,010 --> 00:01:18,390
...الألم

6
00:01:18,930 --> 00:01:19,930
اختفى؟

7
00:01:21,140 --> 00:01:22,180
...هيّا بنا

8
00:01:22,180 --> 00:01:23,640
.من هنا رجاءً

9
00:01:38,070 --> 00:01:40,910
.نظّفا نفسيكما وخذا قسطًا من الرّاحة

10
00:01:41,200 --> 00:01:42,830
.الحمّام في الخلف

11
00:01:42,830 --> 00:01:44,580
.ستجدين ملابس هناك من أجلك أيضًا

12
00:01:44,910 --> 00:01:47,750
.سآتي لاصطحابك عندما تستيقظين

13
00:01:48,210 --> 00:01:50,630
.شكرًا جزيلاً

14
00:01:53,460 --> 00:01:54,460
!المعذرة

15
00:01:57,930 --> 00:02:02,010
أنت قلقة حيال ذلك الشّابّ الصّيّاد، صحيح؟

16
00:02:02,390 --> 00:02:03,970
.إنّه بخير

17
00:02:03,970 --> 00:02:06,060
.لقد غادر غابة الأشواك سلفًا

18
00:02:06,600 --> 00:02:07,980
هكذا إذا؟

19
00:02:13,440 --> 00:02:15,070
كان ذلك متعبًا، صحيح؟

20
00:02:15,070 --> 00:02:17,110
.نعم، أنا منهك تمامًا

21
00:02:17,110 --> 00:02:19,570
لماذا لا أحمّمك وثمّ نخلد للنّوم؟

22
00:02:19,910 --> 00:02:21,910
.تعال عندما أناديك رجاءً

23
00:02:21,910 --> 00:02:23,080
.حسنًا

24
00:02:28,790 --> 00:02:30,000
ماذا؟

25
00:04:05,720 --> 00:04:08,060
!سيّد خنزير؟ تعال من فضلك

26
00:04:08,260 --> 00:04:10,180
!نعم، أنا قادم

27
00:04:36,580 --> 00:04:40,090
!أنا آسف! رأيتك لجزء من الثّانية فقط

28
00:04:40,090 --> 00:04:41,170
.لا بأس

29
00:04:41,170 --> 00:04:46,340
ألا تذكر أنّك أخبرتني أن أدّخر عُريي
للحظة مناسبة يا سيّد خنزير؟

30
00:04:46,340 --> 00:04:49,310
.افتح عينيك الآن وانظر جيّدًا رجاءً

31
00:05:00,610 --> 00:05:01,820
.أنت جميلة

32
00:05:02,860 --> 00:05:05,150
سأحمّمك بشكل جيّد، مفهوم؟

33
00:05:06,740 --> 00:05:09,870
.لذلك لا يجب عليك أن تشيح نظرك وأنا أقوم بذلك

34
00:05:20,380 --> 00:05:22,090
.عليك النّظر إليّ طوال الوقت

35
00:05:22,090 --> 00:05:25,380
.هذه أعلى درجات الشّكر الّتي قد أقدّمها لك

36
00:05:25,380 --> 00:05:26,590
.اقبلها رجاءً

37
00:05:27,800 --> 00:05:29,010
!حسنًا

38
00:05:29,010 --> 00:05:32,220
أنا مضطرّ لقبول هذا إذًا، صحيح؟

39
00:05:33,890 --> 00:05:37,600
.تلك الابتسامة هي أفضل مكافأة لي

40
00:05:37,600 --> 00:05:39,730
!إنّها الابتسامة الّتي منحتني إيّاها

41
00:05:41,570 --> 00:05:45,440
.شعرت بالوحدة كثيرًا وأنا خادمة

42
00:05:45,440 --> 00:05:49,490
.كنتُ أبتسم فقط لأجل مصلحة الآخرين

43
00:05:49,490 --> 00:05:52,540
.ليس من السّهل الابتسام بعفويّة

44
00:05:52,870 --> 00:05:56,620
.لكنّ ذلك كان حالي قبل أن ألتقي بك

45
00:05:56,620 --> 00:06:00,250
.لأنّك جعلتني أبتسم مرّات عدّة

46
00:06:00,250 --> 00:06:02,670
!سرّتني معرفة هذا

47
00:06:03,460 --> 00:06:07,840
مثل المرّة الّتي تباهيت بتلك
!الرّقصة للسّيّد كيلينس

48
00:06:07,840 --> 00:06:09,930
...كدتُ أضحك بصوت عال

49
00:06:09,930 --> 00:06:12,010
!لذلك ذُعرت وكتمتُ أنفاسي

50
00:06:12,390 --> 00:06:15,020
.انسي ذلك رجاءً. لم تكن من أفضل لحظاتي

51
00:06:22,440 --> 00:06:25,360
!لم أنم على سرير ناعم كهذا من قبل

52
00:06:25,360 --> 00:06:26,940
.ولا أنا

53
00:06:26,940 --> 00:06:29,740
.أنا خنزير، لذلك لا عجب في هذا

54
00:06:33,280 --> 00:06:35,290
.كم هذا دافئ

55
00:06:35,290 --> 00:06:37,620
.ومطمئن

56
00:06:45,550 --> 00:06:48,380
.أتطلّع لأصير بشريًّا ثانية بكلّ تأكيد

57
00:06:48,380 --> 00:06:50,630
لكن هل ذلك ممكن من الأساس؟

58
00:06:50,630 --> 00:06:54,470
.ناهيك عن ذكر ما سيفعله الملك بنا

59
00:06:55,810 --> 00:06:56,850
...سيّد خنزير

60
00:07:00,020 --> 00:07:01,770
هل أنت مستيقظة؟

61
00:07:02,810 --> 00:07:04,110
...أنا

62
00:07:04,820 --> 00:07:05,440
ماذا؟

63
00:07:05,940 --> 00:07:06,940
...اسمع

64
00:07:07,360 --> 00:07:09,570
...مهما حدث في الغد

65
00:07:09,860 --> 00:07:14,240
أشعر أنّي محظوظة لتمكّني
.من خوض هذه الرّحلة معك

66
00:07:14,240 --> 00:07:15,370
...جيس

67
00:07:16,080 --> 00:07:17,290
...سيّد خنزير

68
00:07:22,630 --> 00:07:23,750
.شكرًا لك

69
00:07:32,180 --> 00:07:34,010
!صباح الخير

70
00:07:37,350 --> 00:07:39,350
هل هي الظّهيرة؟

71
00:07:40,350 --> 00:07:42,770
!تـ-تفضّلي

72
00:07:45,820 --> 00:07:49,190
.سآخذك للأعلى بمجرّد تغيير ملابسك

73
00:08:08,670 --> 00:08:10,710
.المعذرة

74
00:08:12,090 --> 00:08:14,430
نعم؟ عمّ تريد أن تسأل؟

75
00:08:14,430 --> 00:08:17,390
.يبدو أنّك قادرة على سماع أفكاري

76
00:08:18,810 --> 00:08:21,350
...وهناك أمر حيالك يبدو

77
00:08:21,350 --> 00:08:23,810
هل أنت يثما؟

78
00:08:48,380 --> 00:08:50,710
.ينتظركما الملك في الدّاخل

79
00:09:16,450 --> 00:09:19,370
...هذا هو... ملك هذه

80
00:09:19,370 --> 00:09:21,830
البلاد... ملك مستريا؟

81
00:09:28,920 --> 00:09:30,170
.تفضّلا بالجلوس

82
00:09:30,750 --> 00:09:32,130
.وأنت أيضًا يا فيس

83
00:09:53,610 --> 00:09:56,570
.تفضّلا بالأكل. لا بدّ أنّكما جائعان

84
00:09:56,570 --> 00:09:58,780
.شكرًا جزيلاً

85
00:09:59,700 --> 00:10:05,410
بما أنّه الملك، ظننتُ أنّه سيتسلّط
.علينا من على عرشه

86
00:10:05,410 --> 00:10:09,540
إن كان ذلك سيسعدك، فبإمكاني
...التّسلّط عليكما من على عرشي

87
00:10:09,540 --> 00:10:11,500
لكن أليس من السّهل الحديث هكذا؟

88
00:10:11,500 --> 00:10:13,300
!سمع أفكاري أيضًا

89
00:10:13,300 --> 00:10:14,340
!أنا أعتذر بشدّة

90
00:10:14,340 --> 00:10:15,920
!كانت تلك فظاظة منّي

91
00:10:16,670 --> 00:10:17,840
.لا داعي للقلق

92
00:10:18,130 --> 00:10:23,680
فقبل كلّ شيء، لا يعرف الكثير من
.النّاس أنّ بإمكان السّحرة سماع الأفكار

93
00:10:24,600 --> 00:10:27,690
هل أنتم سحرة؟

94
00:10:27,690 --> 00:10:28,890
.نعم

95
00:10:28,890 --> 00:10:31,980
.أنا ساحر وملك هذه البلاد

96
00:10:31,980 --> 00:10:33,570
.اسمي إيفيس

97
00:10:33,940 --> 00:10:37,360
.ذاك هناك هو حفيدي شرافيس

98
00:10:37,650 --> 00:10:40,450
.وهذه والدته فيس

99
00:10:41,160 --> 00:10:42,450
...والآن

100
00:10:42,450 --> 00:10:45,160
قيل لي أنّ هنالك ما تريدين
.أن تطلبيه منّي يا جيس

101
00:10:45,160 --> 00:10:47,200
.هيّا أخبريني ما هو

102
00:10:47,710 --> 00:10:48,660
!حاضرة

103
00:10:49,870 --> 00:10:51,170
...عفوًا

104
00:10:51,170 --> 00:10:52,000
...أريد

105
00:10:53,290 --> 00:10:56,960
أريد منك أن تعيد السّيّد خنزير
.لطبيعته البشريّة ثانية

106
00:11:01,260 --> 00:11:02,010
.لا بأس

107
00:11:03,010 --> 00:11:05,310
.لكن هناك شرط واحد

108
00:11:07,220 --> 00:11:11,480
مهما كانت الطّريقة الّتي ستُحوّل
،ذلك الشّابّ من خنزير إلى بشريّ

109
00:11:11,480 --> 00:11:14,020
.فعليك المشاهدة حتّى النّهاية

110
00:11:15,110 --> 00:11:15,940
.حسنًا

111
00:11:16,230 --> 00:11:17,610
.ممتاز

112
00:11:17,610 --> 00:11:20,610
.سأذكّرك بوعدك هذا

113
00:11:21,950 --> 00:11:23,410
هل سنكون بخير؟

114
00:11:23,740 --> 00:11:25,660
.لستُ واثقًا جدًّا حيال هذا

115
00:11:27,490 --> 00:11:30,210
إذًا فستعيده إلى طبيعته، صحيح؟

116
00:11:31,830 --> 00:11:34,710
...أستطيع ذلك في هذه اللّحظة

117
00:11:34,710 --> 00:11:35,840
.لنرَ

118
00:11:36,050 --> 00:11:38,840
.سأحرص على أن يتمّ ذلك قبل غروب الشّمس

119
00:11:39,130 --> 00:11:41,880
هل ستستعمل السّحر لتحويله؟

120
00:11:41,880 --> 00:11:43,430
.لا، ليس بالسّحر

121
00:11:52,390 --> 00:11:55,190
ما الّذي ستفعله إذًا؟

122
00:11:56,110 --> 00:11:57,690
.الأمر بسيط

123
00:11:57,980 --> 00:12:00,820
.سيكون عليّ قتل ذلك الخنزير فحسب

124
00:12:04,740 --> 00:12:06,580
قتله؟

125
00:12:06,580 --> 00:12:10,330
بقتل ذلك الخنزير، سيعود وعي
،ذلك الشّابّ إلى جسده الحقيقيّ

126
00:12:10,330 --> 00:12:13,080
.الّذي يوجد الآن نائمًا في العالم الّذي أتى منه

127
00:12:15,000 --> 00:12:17,340
...العالم... الّذي أتى منه

128
00:12:18,710 --> 00:12:23,300
،بينما كان وعي ذلك الشّابّ يطفو بين عالمين

129
00:12:23,300 --> 00:12:25,970
...سُحب بواسطة سحر قويّ

130
00:12:25,970 --> 00:12:30,270
.وسكن بداخل ذلك الخنزير في هذا العالم

131
00:12:31,180 --> 00:12:36,230
وسبب حدوث ذلك هو أمر
.عليك إخباره به بنفسك يا جيس

132
00:12:42,280 --> 00:12:43,570
...إذًا

133
00:12:43,570 --> 00:12:46,570
...إن صار السّيّد خنزير بشريًّا ثانية

134
00:12:46,570 --> 00:12:49,620
فذلك يعني أنّه لن يتواجد
.في هذا العالم بعد الآن

135
00:12:58,250 --> 00:12:59,670
...أنا والسّيّد خنزير

136
00:13:00,250 --> 00:13:02,050
.لا يمكننا البقاء معًا

137
00:13:02,670 --> 00:13:07,550
تلك هي الطّريقة الوحيدة لتحويل
.ذلك الشّابّ لبشريّ ثانية

138
00:13:08,800 --> 00:13:11,810
،إن ظلّ وعيه هنا

139
00:13:11,810 --> 00:13:14,350
...فسيموت جسده في نهاية الأمر

140
00:13:14,350 --> 00:13:17,270
.ولن يستطيع أبدًا العودة لعالمه

141
00:13:18,060 --> 00:13:21,230
.قد يحزنك ذلك، لكن لديّ اقتراح

142
00:13:22,990 --> 00:13:25,530
.دعيني أرحّب بك في العائلة الملكيّة

143
00:13:25,530 --> 00:13:29,450
.كنّا في انتظار ساحرة مثلك

144
00:13:31,240 --> 00:13:33,080
...ساحرة

145
00:13:33,080 --> 00:13:34,370
.كما توقّعت

146
00:13:34,660 --> 00:13:36,370
...إنّ اليثما

147
00:13:36,870 --> 00:13:38,500
.ساحرات

148
00:13:40,590 --> 00:13:42,000
.بالضّبط

149
00:13:42,000 --> 00:13:42,760
...جيس

150
00:13:42,760 --> 00:13:46,590
.يبدو أنّك ساحرة موهوبة للغاية

151
00:13:46,590 --> 00:13:48,970
...بالطّبع ما زلتِ حتّى الآن

152
00:13:49,260 --> 00:13:52,600
."تُعرفين بـ"اليثما

153
00:14:11,780 --> 00:14:14,910
.ما عدت يثما بعد الآن يا جيس

154
00:14:17,040 --> 00:14:18,170
...أتمنّى ألاّ ترى هذا تعجرفًا

155
00:14:18,460 --> 00:14:20,080
.لكن لديّ طلب منك

156
00:14:20,080 --> 00:14:24,000
.أنا متأسّف جدًّا لأنّ هذا حدث لك
.اطلب أيّ شيء

157
00:14:24,760 --> 00:14:28,880
.أنا ممتنّ لك لإخبارنا كيف أصير بشريًّا ثانية

158
00:14:28,880 --> 00:14:31,800
.أنا تحت أمرك للقيام بأيّ شيء تقرّر

159
00:14:35,520 --> 00:14:38,600
.لكن هناك شيء واحد ما زلت أجده غير مقبول

160
00:14:38,600 --> 00:14:42,860
.وأودّ منك أن تشرحه لنا إن لم تمانع

161
00:14:44,150 --> 00:14:49,570
لماذا يجب أن تتواجد طبقة
."في هذا العالم تُدعى "يثما

162
00:14:53,490 --> 00:14:57,500
.لا يعرف الكثير من النّاس ما سأخبركما به

163
00:14:59,210 --> 00:15:02,170
...ولكن، بعد أن نظرت إلى عقلك

164
00:15:02,170 --> 00:15:05,670
يمكنني القول أنّك وصلتَ
.بطريقة أو بأخرى للجواب الصّحيح

165
00:15:06,050 --> 00:15:07,090
.حسنًا إذًا

166
00:15:07,090 --> 00:15:12,010
،كهديّة وداع لك ولإظهار حسن النّيّة تجاه جيس

167
00:15:12,010 --> 00:15:14,390
.سأكشف لكما عن الحقيقة

168
00:15:14,390 --> 00:15:16,220
.أقدّر لك ذلك

169
00:15:24,860 --> 00:15:26,440
...حسنًا أيّها الشّابّ

170
00:15:26,730 --> 00:15:28,150
من أين تريدني أن أبدأ؟

171
00:15:31,610 --> 00:15:34,830
...كلّ ما أعرفه عن اليثما

172
00:15:34,830 --> 00:15:37,490
.هو ما اكتشفته في الأيّام القليلة الماضية

173
00:15:37,950 --> 00:15:39,290
.الأطواق الفضّيّة

174
00:15:39,580 --> 00:15:40,960
.العمل كخادمات

175
00:15:41,290 --> 00:15:45,710
تمكّنهنّ من سماع الأفكار والقيام
.بمعجزات بمساعدة الرّيستا السّوداء

176
00:15:46,000 --> 00:15:47,050
.وأنّهنّ إناث دائمًا

177
00:15:47,340 --> 00:15:48,460
...وتمّ بيعهنّ في سنّ الثّامنة

178
00:15:48,920 --> 00:15:51,470
ويخاطرن بحياتهنّ أثناء سفرهنّ إلى
.العاصمة عندما يبلغن السّادسة عشر

179
00:15:51,470 --> 00:15:54,550
.كما أنّه لا يُسمح لهنّ بركوب العربات

180
00:15:54,850 --> 00:15:57,390
.ولا يجب الاعتداء عليهنّ جنسيًّا حسب القانون

181
00:15:59,560 --> 00:16:02,690
.يبدو أنّك تفهم جيّدًا النّقاط الأساسيّة

182
00:16:02,690 --> 00:16:04,810
.هناك سبب وراء كلّ تلك الأشياء

183
00:16:05,060 --> 00:16:07,230
.إنّها تعني شيئًا ما لكم جميعًا

184
00:16:07,230 --> 00:16:08,530
هل أنا محقّ؟

185
00:16:08,530 --> 00:16:11,450
،"سيكون من المضلّل أن نقول "لنا جميعًا

186
00:16:11,450 --> 00:16:13,910
.لكنّي لن أنكر أنّها تعني شيئًا معيّنًا

187
00:16:13,910 --> 00:16:19,160
أليس نظام اليثما هي طريقة لضمان
نجاة عرق السّحرة؟

188
00:16:25,500 --> 00:16:29,460
ما الّذي تعرفه عن السّحرة؟

189
00:16:29,460 --> 00:16:31,340
.إنّهم يمتلكون قوى هائلة

190
00:16:31,340 --> 00:16:33,800
...وأنّهم خاضوا حروبًا عديدة للسّلطة

191
00:16:33,800 --> 00:16:36,010
.وأنّهم من جلب العصور المظلمة

192
00:16:36,430 --> 00:16:41,140
إذًا ما سبب تراجع السّحرة
إلى هذه المرحلة في نظرك؟

193
00:16:41,480 --> 00:16:45,230
السّبب هو امتلاككم للكثير من القوّة
.واستعمالها بشكل عدوانيّ

194
00:16:45,690 --> 00:16:47,860
.هذا ما أفهمه أنا أيضًا

195
00:16:48,270 --> 00:16:53,070
لم تتناسب القوّة السّحريّة مع الأجسام
.المادّيّة والأنانيّة المفرطة

196
00:16:53,070 --> 00:16:55,170
،وبسب هذين العاملين

197
00:16:55,170 --> 00:16:58,370
بدأ السّحرة في قتل بعضهم
.وجلبوا العصور المظلمة

198
00:16:58,700 --> 00:17:00,860
لذلك السّبب قامت سلفي العظيمة فاتيس

199
00:17:00,860 --> 00:17:05,040
بوضع أطواق فضّيّة على كلّ
...ساحرة ناجية عدى نفسها

200
00:17:05,040 --> 00:17:09,040
.وختمت تلك القوّة السّحريّة والأنانيّة

201
00:17:09,550 --> 00:17:13,880
ونتيجة لذلك، لم يظلّ لهنّ سوى القليل
.من قواهنّ وما عدن يشكّلن خطرًا

202
00:17:13,880 --> 00:17:16,510
.وذلك ما وضع نهاية للعصور المظلمة

203
00:17:17,050 --> 00:17:22,680
ولكن كيف انتهى الأمر بالسّاحرات
ذوات الأطواق كعبيد؟

204
00:17:22,980 --> 00:17:25,440
.اتّضح أنّ الأمر كان فعّالاً أكثر ممّا كان متوقّعًا

205
00:17:25,810 --> 00:17:32,070
،بعد أن تمّ ختم أنانيّتهنّ بتلك الأطواق
...توقّفت اليثما عن التّمرّد بالكامل

206
00:17:32,070 --> 00:17:36,030
حتّى إن تمّت معاملتهنّ كعبيد
.أو تمّ التّمييز ضدّهنّ

207
00:17:37,490 --> 00:17:38,700
...ولكن كيف لذلك

208
00:17:39,160 --> 00:17:42,450
أن يمنح الحقّ لأيّ أحد بمعاملتهنّ بظلم؟

209
00:17:44,580 --> 00:17:49,000
،ما دام البشر موجودين
.فسيكون هناك دائمًا ثمن ندفعه

210
00:17:49,000 --> 00:17:51,290
.على شخص ما أن يتحمّل عبء الظّلم

211
00:17:51,290 --> 00:17:53,620
بدأ المجتمع في اكتساب التّوازن ثانية

212
00:17:53,620 --> 00:17:57,640
بوجود عرق العبيد المسمّى اليثما
.لتحمّل ذلك العبء

213
00:17:57,640 --> 00:18:01,220
لكن ألا تعتقد أنّ النّظام الحاليّ
تجاوز الحدود كثيرًا؟

214
00:18:04,600 --> 00:18:10,060
لماذا تُجبر اليثما اللاّتي بلغن السّادسة عشر
على السّفر للعاصمة مخاطرات بحياتهنّ؟

215
00:18:10,060 --> 00:18:12,320
.بهدف التّقليل من أعدادهنّ

216
00:18:14,150 --> 00:18:19,030
وحدهنّ اليثما اللاّتي أثبتن كفاءتهنّ
.ببلوغ العاصمة يُسمح لهنّ بالنّجاة

217
00:18:19,320 --> 00:18:21,830
...ثمّ نجعلهنّ يحملن أطفالاً ويصرن أمّهات

218
00:18:21,830 --> 00:18:26,460
.أو نرحّب بهنّ في سلالتنا الملكيّة

219
00:18:26,790 --> 00:18:28,830
لماذا اليثما إناث فقط؟

220
00:18:29,120 --> 00:18:31,160
بما أنّه يمكن للذّكور أن يُرزقوا
،بأطفال بدون علمنا

221
00:18:31,160 --> 00:18:32,750
...نتخلّص منهم قبل أن يولدوا

222
00:18:33,090 --> 00:18:35,420
.وعندما تولد الإناث، نسيطر عليهنّ بتلك الأطواق

223
00:18:35,710 --> 00:18:40,590
.وهكذا نضمن ألاّ ينجب أحد أطفال لا علم لنا بهم

224
00:18:43,430 --> 00:18:45,060
.لديّ سؤال واحد أخير

225
00:18:45,560 --> 00:18:49,730
يوجد هذا المجتمع بفضل قدرته
.على توفير اليثما والرّيستا

226
00:18:49,730 --> 00:18:52,020
أنت لا تعتقد بالفعل أنّه سيدوم للأبد، صحيح؟

227
00:18:58,610 --> 00:19:00,030
.بالطّبع لا

228
00:19:00,030 --> 00:19:02,370
.تنهار كلّ المجتمعات في النّهاية

229
00:19:04,030 --> 00:19:10,920
ولكن، أنا أؤمن بشدّة أنّ هذه الحقبة
.أخلاقيّة أكثر من العصور المظلمة

230
00:19:10,920 --> 00:19:16,170
على الأقلّ، لا نيّة لي بتغيير
.الوضع الرّاهن خلال حكمي

231
00:19:16,170 --> 00:19:18,670
...وإن حاول أيّ أحد تغييره

232
00:19:20,840 --> 00:19:23,550
.فسأحرص على المقاومة بكلّ قوّتي

233
00:19:28,850 --> 00:19:31,310
.حان الوقت لإنهاء هذه المحادثة

234
00:19:32,730 --> 00:19:36,400
تعاليا إلى الكاتدرائية الذّهبيّة قبل
.غروب الشّمس بنصف ساعة

235
00:19:36,400 --> 00:19:38,780
.يمكنكما القيام بما يحلو لكما حتّى ذلك الوقت

236
00:19:45,580 --> 00:19:46,740
...سيّد خنزير

237
00:19:47,080 --> 00:19:48,000
ماذا؟

238
00:19:48,660 --> 00:19:52,580
.أريد رؤية مستريا من مكان مرتفع جدًّا

239
00:20:06,760 --> 00:20:08,770
.ما عدت ترتدين ذلك الطّوق الآن

240
00:20:08,770 --> 00:20:11,060
.بإمكانك خلع ذلك الوشاح

241
00:20:11,730 --> 00:20:14,650
.أريد الاحتفاظ بهذا الوشاح

242
00:20:14,650 --> 00:20:17,400
.أنت من اختاره لي يا سيّد خنزير

243
00:20:20,440 --> 00:20:22,030
.هكذا إذًا

244
00:20:24,910 --> 00:20:26,370
...اسمعي يا جيس

245
00:20:27,080 --> 00:20:28,870
هل تلك كيلتري؟

246
00:20:28,870 --> 00:20:30,200
!أظنّ ذلك

247
00:20:30,200 --> 00:20:34,750
،انتهت رحلتنا بسرعة
.لكنّنا سرنا لمسافة طويلة بالفعل

248
00:20:34,750 --> 00:20:35,790
!نعم

249
00:20:35,790 --> 00:20:39,000
!استطعت الوصول إلى هنا بفضلك

250
00:20:39,300 --> 00:20:42,630
.كلّ ما فعلته هو تقديم بعض النّصائح البسيطة

251
00:20:42,630 --> 00:20:44,090
!ذلك ليس صحيحًا

252
00:20:44,090 --> 00:20:49,140
!كنتُ لأُقتل قرب ذلك القصر لولاك أنت

253
00:20:49,140 --> 00:20:53,140
ما كنتِ لتضطرّين لشراء ريستا أخرى
.لو لم أكن موجودًا من الأساس

254
00:20:53,140 --> 00:20:55,350
.وما كان ليوجد أيّ سبب لقتلك

255
00:20:57,230 --> 00:20:58,860
...لولاك يا سيّد خنزير

256
00:20:59,150 --> 00:21:02,150
.كنتُ لأرفض طلب انضمام السّيّد نوت لنا

257
00:21:02,150 --> 00:21:05,780
!ولكانت رحلتنا أكثر خطورة

258
00:21:07,030 --> 00:21:11,700
ليس ذلك فحسب، لكن لو لم تدرك
!أنّهم يستعملون الآنسة بليس للإيقاع بنا

259
00:21:11,700 --> 00:21:12,660
...وأيضًا

260
00:21:13,250 --> 00:21:18,170
استطعت الوصول إلى العاصمة الملكيّة
.فقط لأنّك أدركت حقيقة الهكريبون

261
00:21:19,460 --> 00:21:20,800
!اعترف بذلك رجاءً

262
00:21:20,800 --> 00:21:22,970
...أنا... أنا

263
00:21:23,300 --> 00:21:25,930
!كنتُ لأموت بكلّ تأكيد لولاك يا سيّد خنزير

264
00:21:27,800 --> 00:21:29,430
.معك حقّ

265
00:21:29,430 --> 00:21:32,600
.أعتقد أنّي كنت شريك سفر جيّد بالفعل

266
00:21:32,980 --> 00:21:35,940
.لكن أنا من عليه أن يشكرك

267
00:21:35,940 --> 00:21:40,150
أنت من أنقذ حياتي وحاولت
.مساعدتي لأعود بشريًّا

268
00:21:40,150 --> 00:21:41,980
.ذلك ليس ما حدث بالفعل

269
00:21:43,360 --> 00:21:44,700
ماذا تقصدين؟

270
00:21:45,150 --> 00:21:48,280
واثقة أنّك تساءلت عن الأمر أيضًا، صحيح؟

271
00:21:48,280 --> 00:21:53,040
أقصد حقيقة أنّي اشتريت ريستا
.سوداء قبل أن ألتقيك

272
00:21:53,040 --> 00:21:53,750
...عفوًا

273
00:21:54,120 --> 00:21:57,500
.أريد ريستا واحدة سوداء لاستعمالي الخاصّ

274
00:21:57,790 --> 00:22:00,250
.أحتاج واحدة أخرى

275
00:22:00,250 --> 00:22:04,380
...إنّ سبب إخفاء ذلك عنك

276
00:22:07,760 --> 00:22:14,430
هو أنّي استعملتُ الرّيستا
.الّتي اشتريتُها لتحقيق أمنية أنانيّة

277
00:22:14,430 --> 00:22:15,680
أمنية؟

278
00:22:15,680 --> 00:22:16,770
...في تلك اللّيلة

279
00:22:17,270 --> 00:22:19,270
...صلّيتُ قائلة

280
00:22:22,320 --> 00:22:24,940
أنا خائفة من الذّهاب في رحلتي"
".إلى العاصمة الملكيّة وحدي

281
00:22:25,570 --> 00:22:29,320
".ليتني أقابل شخصًا يمكنه مساعدتي"