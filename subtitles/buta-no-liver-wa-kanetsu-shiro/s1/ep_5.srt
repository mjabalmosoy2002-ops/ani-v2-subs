1
00:00:05,190 --> 00:00:08,480
.إذًا فهذا هو الدّير الّذي وقعت فيه الحادثة

2
00:00:08,860 --> 00:00:10,030
.نعم

3
00:00:15,950 --> 00:00:16,910
...جيس

4
00:00:24,460 --> 00:00:26,670
!ذلك الرّجل... هو من قابلته ذلك اليوم

5
00:00:27,130 --> 00:00:29,670
!ظننتُ بالفعل أنّه مهتمّ بك

6
00:00:30,170 --> 00:00:31,960
هل يعقل أنّه صائد يثما؟

7
00:00:32,880 --> 00:00:33,510
—مهلاً

8
00:01:13,210 --> 00:01:15,970
.يبدو مثيرًا للمشاكل

9
00:02:51,480 --> 00:02:53,310
ماذا نفعل يا سيّد خنزير؟

10
00:02:53,860 --> 00:02:57,940
،حتّى إن حاولنا نحن الثّلاثة مواجهته
—فلن تكون أمامنا فرصة. لذلك

11
00:03:00,240 --> 00:03:01,490
...سيّد نوت

12
00:03:01,490 --> 00:03:02,660
.مساء الخير

13
00:03:03,740 --> 00:03:06,040
.عفوًا، لا داعي للقلق حيال السّيّد نوت

14
00:03:06,040 --> 00:03:07,750
أتعرفينه؟

15
00:03:07,750 --> 00:03:09,120
أليس صائد يثما؟

16
00:03:09,120 --> 00:03:10,500
.لا، ليس كذلك

17
00:03:10,500 --> 00:03:11,790
.إنّه رجل طيّب

18
00:03:12,080 --> 00:03:13,330
.صدّقاني رجاءً

19
00:03:13,630 --> 00:03:16,250
!هكذا إذًا؟ مفهوم

20
00:03:16,250 --> 00:03:17,670
!مهلاً لحظة يا جيس

21
00:03:17,670 --> 00:03:19,510
!من الباكر جدًّا أن نثق به

22
00:03:19,880 --> 00:03:21,180
...أخبريني يا سيريس

23
00:03:21,180 --> 00:03:23,930
تلك هي يثما متّجهة إلى العاصمة، صحيح؟

24
00:03:23,930 --> 00:03:25,850
هل أحضرتها إلى هنا لمشاهدة المناظر أو ما شابه؟

25
00:03:26,180 --> 00:03:27,520
.كلاّ

26
00:03:27,520 --> 00:03:29,230
.ما كنت لأصف هذا بمشاهدة المناظر

27
00:03:29,230 --> 00:03:31,640
.أودّ ترك بعض الأزهار هنا

28
00:03:36,150 --> 00:03:38,110
أهذه فكرتك عن إظهار احترامك؟

29
00:03:38,110 --> 00:03:40,150
...لا بأس بذلك، ولكن

30
00:03:40,150 --> 00:03:43,610
ذلك الوشاح... دليل واضح جدًّا
.على أنّك تخفين طوقك

31
00:03:43,610 --> 00:03:45,280
.اخلعيه

32
00:03:45,570 --> 00:03:46,780
.ارتدي هذا بدلاً منه

33
00:03:47,280 --> 00:03:50,250
.لا يمكن تمييزه عن لون بشرتك من بعيد

34
00:03:50,250 --> 00:03:55,750
،لكن... إن رآه شخص ما عن قرب
ألن يكشف ذلك أمري في الحال؟

35
00:03:56,090 --> 00:03:59,510
الهدف هو ألاّ يستطيع أحد معرفة
.ذلك من نظر لك من بعيد

36
00:03:59,510 --> 00:04:00,760
.هذا ليس من أجلك

37
00:04:01,050 --> 00:04:03,680
.أنا أخبرك بكلّ هذا لأنّك قد تعرّضين سيريس للخطر

38
00:04:04,010 --> 00:04:05,970
.افعلي ما أقوله وارتدي هذا

39
00:04:06,300 --> 00:04:07,220
.حسنًا

40
00:04:07,560 --> 00:04:09,270
!لا ترخي دفاعاتك يا جيس

41
00:04:25,240 --> 00:04:27,410
هل أنت مراهق أم ماذا؟

42
00:04:27,410 --> 00:04:28,870
!يا إلهي

43
00:04:28,870 --> 00:04:31,950
...تقع في حبّ فتاة قابلتها للتّوّ

44
00:04:32,450 --> 00:04:33,210
...ولكن

45
00:04:33,580 --> 00:04:36,210
.لا يبدو خطيرًا على الأقلّ

46
00:04:36,630 --> 00:04:39,090
.سأبقي هويّتي الحقيقيّة سرًّا في الوقت الحاليّ

47
00:04:39,800 --> 00:04:43,300
.أبلغيني في الحال إن شعرت أنّ أذى سيصيبك

48
00:04:43,300 --> 00:04:44,470
ما قولك؟

49
00:04:44,470 --> 00:04:45,590
.مفهوم

50
00:04:46,970 --> 00:04:49,470
هلاّ ساعدتنا أيضًا يا سيريس الظّريفة؟

51
00:04:49,470 --> 00:04:50,720
ظريفة؟

52
00:04:51,020 --> 00:04:54,270
،بمجرّد أن أشعر أنّه يمكنني الوثوق به
.سأعلمه بمن أكون في الحال

53
00:04:54,600 --> 00:04:58,860
،لذلك حتّى ذلك الحين يا سيريس
هلاّ عاملتني كخنزير عاديّ؟

54
00:04:58,860 --> 00:05:00,400
...إن كان هذا ما تريد

55
00:05:00,400 --> 00:05:02,320
.فسأقوم بما تقوله

56
00:05:09,620 --> 00:05:11,240
.سيفي هذا بالغرض

57
00:05:12,330 --> 00:05:13,660
.شكرًا جزيلاً لك

58
00:05:14,960 --> 00:05:15,960
...بالمناسبة

59
00:05:16,290 --> 00:05:17,960
.ما زلت لا أعرف اسمك

60
00:05:17,960 --> 00:05:19,290
.أنا جيس

61
00:05:19,290 --> 00:05:20,920
.سررت بلقائك

62
00:05:21,960 --> 00:05:22,590
...عفوًا

63
00:05:23,260 --> 00:05:24,970
هل مسموح لنا الدّخول؟

64
00:05:24,970 --> 00:05:27,260
.انظري لحال المكان

65
00:05:27,260 --> 00:05:28,430
.افعلي ما يحلو لك

66
00:05:28,430 --> 00:05:30,050
!شكرًا جزيلاً

67
00:06:22,020 --> 00:06:23,320
هل أراحك ذلك؟

68
00:06:25,320 --> 00:06:26,110
...حسنًا

69
00:06:26,780 --> 00:06:27,440
!المعذرة

70
00:06:28,530 --> 00:06:31,910
.قيل لي أنّ هنالك ينبوعًا في هذه المنطقة

71
00:06:31,910 --> 00:06:33,240
أتريدين الذّهاب للسّباحة؟

72
00:06:33,530 --> 00:06:36,790
ماذا يدور في بالك؟ هل أنت وغد من نوع ما؟

73
00:06:37,120 --> 00:06:38,000
.لا

74
00:06:38,000 --> 00:06:40,000
.فكّرت في غسل السّيّد خنزير هناك

75
00:06:41,790 --> 00:06:43,590
.إنّها قريب. تعالي

76
00:06:56,930 --> 00:06:59,020
!شكرًا لك

77
00:06:59,020 --> 00:07:00,350
.هذا شكري لك

78
00:07:00,350 --> 00:07:04,730
.واصلتَ المشي طوال الوقت وأنا نائمة

79
00:07:04,730 --> 00:07:06,360
.نحن في نفس الوضع

80
00:07:06,610 --> 00:07:11,740
.لم يكن لديّ خيار سوى نقلك لأنّنا كنّا نهرب

81
00:07:11,740 --> 00:07:13,620
.لكنّ الأمر لم يكن كذلك بالنّسبة لك

82
00:07:14,490 --> 00:07:16,160
—فعلتَ ذلك لأتمكّن من النّوم

83
00:07:16,160 --> 00:07:17,830
.أنت مخطئة بشأن ذلك

84
00:07:17,830 --> 00:07:19,460
فعلاً؟

85
00:07:19,460 --> 00:07:23,210
فعلت ذلك رغبة منّي بأن تحضنيني
.بفخذيك النّاعمين

86
00:07:24,710 --> 00:07:26,960
.حسنًا، لنغلق هذا الموضوع إذًا

87
00:07:27,300 --> 00:07:28,340
!أكيد

88
00:07:33,090 --> 00:07:34,850
.مشاعره واضحة كالشّمس

89
00:07:47,360 --> 00:07:48,940
هلّي بكوبَيْ بيرة؟

90
00:07:53,490 --> 00:07:54,160
...المعذرة

91
00:07:54,530 --> 00:07:55,910
...أنا

92
00:07:55,910 --> 00:07:57,990
.لا تقلقي حيال المال

93
00:07:57,990 --> 00:07:58,790
.أنا سأدفع

94
00:07:59,330 --> 00:08:00,830
.شكرًا جزيلاً

95
00:08:01,210 --> 00:08:01,960
...لكن

96
00:08:02,250 --> 00:08:04,830
ألن تقع في المشاكل مع سيريس بسبب هذا؟

97
00:08:04,830 --> 00:08:06,840
لماذا قد أقع في المشاكل معها؟

98
00:08:06,840 --> 00:08:08,420
!هذا أنت يا نوت

99
00:08:08,670 --> 00:08:10,010
!لم أعلم أنّك هنا

100
00:08:10,010 --> 00:08:11,970
!لم أرك منذ مدّة يا جدّة

101
00:08:11,970 --> 00:08:13,300
كيف يسير الصّيد؟

102
00:08:13,300 --> 00:08:14,590
على خير ما يرام؟

103
00:08:14,890 --> 00:08:16,300
.تمامًا

104
00:08:16,300 --> 00:08:19,100
.واثق أنّ بإمكاني توفير بعض من لحم الدّببة لك غدًا

105
00:08:19,100 --> 00:08:21,890
.هكذا إذًا؟ هذا متوقّع من نوت

106
00:08:22,350 --> 00:08:24,600
!سأحضّر حساء وأقدّمه لك على حسابنا

107
00:08:24,600 --> 00:08:26,060
.أتطلّع لذلك

108
00:08:26,400 --> 00:08:29,780
هل يمكنك تقديم بعضه لجيس أيضًا يا جدّة؟

109
00:08:30,070 --> 00:08:31,820
.أنت تعرف تمامًا الوضع

110
00:08:31,820 --> 00:08:36,240
لا يمكنني ترك يثما في طريقها
.للعاصمة هنا طويلاً

111
00:08:36,240 --> 00:08:37,070
...أنا آسفة

112
00:08:37,410 --> 00:08:40,080
.لكن سيكون عليك المغادرة غدًا يا جيس

113
00:08:40,080 --> 00:08:41,540
لا تمانعين ذلك، صحيح

114
00:08:41,540 --> 00:08:42,200
.نعم

115
00:08:42,200 --> 00:08:45,920
.سأغادر إلى العاصمة الملكيّة غدًا صباحًا

116
00:08:46,210 --> 00:08:48,960
.نوت، حاول أن يقصر صيدك على الوحوش

117
00:08:49,550 --> 00:08:52,130
...ليس خفيًّا عليّ

118
00:08:52,130 --> 00:08:54,470
.ما يدور في بالك الآن

119
00:08:54,800 --> 00:08:57,390
.فقبل كلّ شيء، إنّها تشبهها كثيرًا

120
00:08:57,390 --> 00:09:00,510
.ذلك ما ظننت عندما رأيتها لأوّل مرّة

121
00:09:00,510 --> 00:09:01,470
.اخرسي

122
00:09:01,810 --> 00:09:03,310
.دعيني وشأني

123
00:09:04,310 --> 00:09:06,350
.شكرًا على الانتظار

124
00:09:07,690 --> 00:09:09,110
...عفوًا

125
00:09:09,110 --> 00:09:10,360
...أنا

126
00:09:10,360 --> 00:09:12,110
.لم أشرب الكحول من قبل

127
00:09:12,400 --> 00:09:13,900
.لديهم بيرة ممتازة هنا

128
00:09:13,900 --> 00:09:15,530
.سأشربها أنا إن لم تعجبك

129
00:09:15,860 --> 00:09:17,910
.جرّبيها فحسب

130
00:09:19,330 --> 00:09:22,080
.حسنًا، إن كنت مصرًّا

131
00:09:25,660 --> 00:09:27,630
!إ-إنها لذيذة

132
00:09:30,040 --> 00:09:33,920
لماذا قتلت ذلك الهكريبون يا سيّد نوت؟

133
00:09:34,220 --> 00:09:37,340
.الهكريبون مخلوقات قرّرت قتلها بمجرّد رؤيتها

134
00:09:38,220 --> 00:09:39,680
.إنّها لا تجلب سوى النّحس

135
00:09:40,350 --> 00:09:44,180
مع أنّه لم يبدأ النّاس في قول ذلك
.إلاّ في السّنوات الأخيرة

136
00:09:45,140 --> 00:09:46,350
!شكرًا لك

137
00:09:46,690 --> 00:09:48,440
.لا مشكلة

138
00:09:49,730 --> 00:09:50,940
...أخبريني يا جيس

139
00:09:50,940 --> 00:09:52,190
أهذا حيوانك الأليف؟

140
00:09:52,530 --> 00:09:53,730
...إنّه

141
00:09:54,110 --> 00:09:55,240
!صديقي

142
00:09:56,780 --> 00:09:57,860
.فهمت

143
00:09:57,860 --> 00:09:59,530
.إنّك تهتمّين كثيرًا به

144
00:09:59,870 --> 00:10:02,030
أهو معك منذ مدّة طويلة؟

145
00:10:02,030 --> 00:10:06,160
...لا، ليس لمدّة طويل، إنّما

146
00:10:06,580 --> 00:10:09,290
.أنا أتشارك قدري مع السّيّد خنزير

147
00:10:10,960 --> 00:10:11,960
قدرك؟

148
00:10:12,250 --> 00:10:13,300
.صحيح

149
00:10:13,300 --> 00:10:15,420
.أنا شريك جيش

150
00:10:15,420 --> 00:10:17,510
.يمكن القول أنّنا مرتبطان بقدر متشارك

151
00:10:17,930 --> 00:10:21,510
.لذلك عليّ التّركيز لتحقيق ذلك الدّور

152
00:10:21,510 --> 00:10:23,260
.ليس من صالحك التّدخّل

153
00:10:23,600 --> 00:10:26,060
.تحدث مثل هذه الأمور كثيرًا

154
00:10:26,390 --> 00:10:27,940
.بينكنّ أيّها اليثما

155
00:10:40,910 --> 00:10:42,830
هل أنت بخير يا جيس؟

156
00:10:43,120 --> 00:10:44,450
!أنا بخير

157
00:10:44,450 --> 00:10:45,660
!أشعر بالرّاحة

158
00:10:46,000 --> 00:10:46,870
!ذلك ليس ما قصدت

159
00:10:47,290 --> 00:10:48,620
—يأخذك ذلك الرّجل

160
00:10:48,620 --> 00:10:50,500
.لا داعي للقلق

161
00:10:50,500 --> 00:10:54,300
.ما كان السّيّد نوت أن يعتدي عليّ أبدًا

162
00:10:54,300 --> 00:10:55,800
فعلاً؟

163
00:11:05,760 --> 00:11:06,430
...جيس

164
00:11:07,180 --> 00:11:09,480
هل يمكنك المجيء معي؟

165
00:11:12,520 --> 00:11:13,900
هل أنت نائمة؟

166
00:11:13,900 --> 00:11:15,190
ماذا؟

167
00:11:15,520 --> 00:11:16,480
...عفوًا

168
00:11:16,820 --> 00:11:18,690
.لستُ نائمة

169
00:11:18,990 --> 00:11:21,860
!مهلاً، لا تفكّر في أشياء غريبة

170
00:11:30,410 --> 00:11:31,500
!مهلاً

171
00:11:33,130 --> 00:11:38,090
!هيّا

172
00:11:38,960 --> 00:11:40,130
!يا جيس

173
00:11:40,130 --> 00:11:40,800
...دعيني

174
00:11:43,010 --> 00:11:44,430
.أضع رأسي على صدرك

175
00:11:51,020 --> 00:11:53,400
!أعتقد أنّي سأدفع بجسدي كاملاً

176
00:11:54,860 --> 00:11:56,400
!لا، لا، لا، لا

177
00:11:56,400 --> 00:11:58,650
".ما كان السّيّد نوت أن يعتدي عليّ أبدًا"

178
00:11:58,650 --> 00:12:00,360
!هذا ما قالته جيس

179
00:12:00,820 --> 00:12:02,490
...في تلك الحالة، أنا

180
00:12:02,820 --> 00:12:04,110
...سأثق في

181
00:12:04,450 --> 00:12:06,080
.جيس فحسب

182
00:12:24,090 --> 00:12:26,390
.أنا فتاة سيّئة بالفعل في النّهاية

183
00:12:27,220 --> 00:12:29,430
.لا يحقّ لي حتّى القيام بهذا

184
00:12:31,770 --> 00:12:32,600
...أنا

185
00:12:34,690 --> 00:12:36,020
.يثما سيّئة

186
00:12:36,020 --> 00:12:39,020
(الحلقة 5)
تقريبًا كلّ الرّجال الوسيمين أوغاد

187
00:13:01,840 --> 00:13:04,220
.لا إشارات أنّ شيئًا ما حدث هنا

188
00:13:07,800 --> 00:13:08,800
من هناك؟

189
00:13:08,800 --> 00:13:09,510
...سيّد خنزير

190
00:13:09,850 --> 00:13:10,680
سيريس؟

191
00:13:10,890 --> 00:13:12,470
ماذا تفعلين هنا في هذا الوقت؟

192
00:13:15,850 --> 00:13:18,110
ما الّذي أردت أن تتحدّثي عنه معي؟

193
00:13:18,110 --> 00:13:22,440
أريدك أن تخبر السّيّد نوت
.من تكون فعلاً في الصّباح

194
00:13:22,440 --> 00:13:25,320
.نوت؟ لن تكون تلك مشكلة

195
00:13:25,860 --> 00:13:28,410
ولكن هل عليّ فعلاً الذّهاب
لرؤيته من أجل هذا؟

196
00:13:28,410 --> 00:13:33,200
سيأتي السّيّد نوت لرؤية الآنسة جيس
.غدًا صباحًا بكلّ تأكيد

197
00:13:33,200 --> 00:13:35,000
سيأتي لرؤيتها؟ لماذا؟

198
00:13:35,370 --> 00:13:36,620
ماذا تقصد؟

199
00:13:36,620 --> 00:13:38,170
...لكي

200
00:13:38,170 --> 00:13:38,830
...إنّه

201
00:13:39,130 --> 00:13:40,500
ما الخطب؟

202
00:13:40,790 --> 00:13:42,380
.أنا آسفة

203
00:13:42,380 --> 00:13:45,300
...لكن... لأنّ السّيّد نوت

204
00:13:45,300 --> 00:13:47,300
...لأنّه يهتمّ بالآنسة جيس

205
00:13:52,470 --> 00:13:54,140
.صحيح

206
00:13:54,140 --> 00:13:55,520
.هذا ما هنالك

207
00:13:55,980 --> 00:13:57,650
...هذه الصّغيرة

208
00:13:57,940 --> 00:14:01,110
.أنا في الثّالثة عشر الآن

209
00:14:01,110 --> 00:14:02,980
هل تحبّين نوت؟

210
00:14:02,980 --> 00:14:04,690
!أعلم

211
00:14:04,690 --> 00:14:06,400
...بصفتي يثما

212
00:14:06,400 --> 00:14:09,620
!ولأنّي طفلة، لا يحقّ لي أن أشعر هكذا

213
00:14:09,620 --> 00:14:10,530
...لكن

214
00:14:11,030 --> 00:14:13,950
!لا أريد أن يغادر السّيّد نوت

215
00:14:13,950 --> 00:14:16,620
ماذا تقصدين بأنّك لا تريدين أن يغادر؟

216
00:14:16,620 --> 00:14:17,920
...السّيّد نوت

217
00:14:17,920 --> 00:14:20,330
!ينوي الذّهاب إلى العاصمة مع الآنسة جيس

218
00:14:20,630 --> 00:14:21,670
ماذا؟

219
00:14:22,840 --> 00:14:26,630
!يخطّط السّيّد نوت أن يكون وصيّ الآنسة جيس

220
00:14:27,090 --> 00:14:28,010
وصيّ؟

221
00:14:28,380 --> 00:14:30,340
.إنّه تقليد لدينا

222
00:14:30,340 --> 00:14:33,930
،لتصل يثما بأمان إلى العاصمة الملكيّة
.هناك شرط عليها تحقيقه

223
00:14:34,390 --> 00:14:35,430
...وهو

224
00:14:37,480 --> 00:14:39,940
.وجود رفيق شجاع وحكيم

225
00:14:39,940 --> 00:14:41,810
.وصيّ بمعنى آخر

226
00:14:42,110 --> 00:14:44,320
...لكن... إنّ الأوصياء

227
00:14:44,320 --> 00:14:48,360
!يختفون دائمًا مع اليثما

228
00:14:48,740 --> 00:14:50,200
.للأبد

229
00:14:51,320 --> 00:14:52,870
.فهمت

230
00:14:52,870 --> 00:14:56,620
.تعتقدين أنّ نوت يخطّط ليصير وصيّ جيس

231
00:14:58,250 --> 00:15:02,000
لهذا السّبب... لا تريد أن يصير السّيّد نوت
وصيّها أيضًا، صحيح يا سيّد خنزير؟

232
00:15:02,000 --> 00:15:03,250
—فقبل كلّ شيء، أنت

233
00:15:03,250 --> 00:15:03,960
!مهلاً

234
00:15:04,250 --> 00:15:05,460
...لأنّك يا سيّد خنزير

235
00:15:05,460 --> 00:15:08,050
!تحبّ الآنسة جيس

236
00:15:13,760 --> 00:15:16,600
.حبّ" عبارة ليست بتلك البساطة"

237
00:15:16,600 --> 00:15:18,930
.إنّها معقّدة بالنّسبة لنا نحن الكبار

238
00:15:19,440 --> 00:15:23,610
.قالت الجدّة أنّك تخدمين هنا منذ خمس سنوات

239
00:15:25,110 --> 00:15:29,610
لذلك فعلى الأرجح أنّك قضيت الكثير من
الوقت تتقرّبين أكثر وأكثر لنوت، صحيح؟

240
00:15:31,410 --> 00:15:32,820
!أجد ذلك رائعًا

241
00:15:32,820 --> 00:15:37,200
.أعتقد أنّه شيء مذهل وحبّ يستحقّ نهاية سعيدة

242
00:15:37,200 --> 00:15:41,290
ألا يستحقّ حبّك نهاية سعيدة يا سيّد خنزير؟

243
00:15:41,290 --> 00:15:42,170
.لا

244
00:15:42,540 --> 00:15:43,710
لماذا؟

245
00:15:43,710 --> 00:15:45,960
.تقابلنا أنا وجيس منذ وقت قصير فقط

246
00:15:46,550 --> 00:15:48,210
...كانت لطيفة معي

247
00:15:48,210 --> 00:15:50,470
.لذلك بدأت أكنّ لها مشاعر بشكل عفويّ

248
00:15:50,760 --> 00:15:52,640
.هذا كلّ ما هنالك

249
00:15:52,640 --> 00:15:57,260
بصفتي خنزيرًا وضعيًا، فستكون أنانيّة
.منّي أن أجل جيس ملكي

250
00:15:59,060 --> 00:16:00,940
.جيس لطيفة مع الجميع

251
00:16:01,270 --> 00:16:05,230
.فتحت قلبها لنوت لأنّها طيّبة مع الجميع

252
00:16:05,520 --> 00:16:09,900
.تلك الطّيبة ليست أمرًا حصريًّا لي

253
00:16:10,320 --> 00:16:13,030
.وما عاد ذلك يزعجني على الإطلاق

254
00:16:13,610 --> 00:16:16,910
.لم أكن بتولاً طوال 19 سنة بلا فائدة

255
00:16:16,910 --> 00:16:18,620
...لكن يا سيّد خنزير

256
00:16:18,950 --> 00:16:21,910
لا تريد أن يكون السّيّد نوت وصيًّا لها، صحيح؟

257
00:16:21,910 --> 00:16:23,120
...ذلك

258
00:16:23,460 --> 00:16:24,170
...لكن

259
00:16:25,040 --> 00:16:29,130
لكنّي لا أستطيع التّدخّل في رحلة جيس
.فقط لأنّي أكنّ مشاعر لها

260
00:16:30,090 --> 00:16:30,800
...لكن

261
00:16:33,050 --> 00:16:34,340
.لا تقلقي

262
00:16:34,340 --> 00:16:35,590
.سأكشف له عن حقيقتي

263
00:16:37,680 --> 00:16:38,930
فعلاً؟

264
00:16:39,220 --> 00:16:40,850
.شكرًا لك

265
00:16:41,560 --> 00:16:42,480
...عفوًا

266
00:16:42,480 --> 00:16:44,560
...يمكنك استعمالنا أنا أو الآنسة جيس

267
00:16:44,560 --> 00:16:48,320
.لنقل كلماتك للسّيّد نوت مباشرة

268
00:16:48,320 --> 00:16:50,570
أتلك موهبة أخرى لليثما؟

269
00:16:50,570 --> 00:16:51,570
.نعم

270
00:16:51,570 --> 00:16:52,700
.فهمت

271
00:16:52,700 --> 00:16:54,860
مثل موجّه إنترنيت؟

272
00:16:55,160 --> 00:16:55,870
...لكن

273
00:16:57,320 --> 00:16:59,950
...لا يهمّ كم سنة أحاول

274
00:17:00,450 --> 00:17:03,000
.فلا أظنّ أنّي سأكون ندًّا للآنسة جيس

275
00:17:03,540 --> 00:17:08,000
...لأنّه لم يمرّ حتّى يوم على لقائهما

276
00:17:09,340 --> 00:17:11,210
!ما كنت لأقول ذلك

277
00:17:11,210 --> 00:17:12,760
!أنت فتاة رائعة أيضًا يا سيريس

278
00:17:13,300 --> 00:17:14,930
...أنت فاتنة بالفعل

279
00:17:14,930 --> 00:17:17,760
!وإن كنت بشريًّا، فسأحضنك بشدّة

280
00:17:18,800 --> 00:17:22,270
هل تحبّ الفتيات الصّغيرات يا سيّد خنزير؟

281
00:17:22,270 --> 00:17:23,850
.مهلاً، ذلك لم يكن تعبيرًا مناسبًا

282
00:17:23,850 --> 00:17:25,440
.تظاهري أنّك لم تسمعيني

283
00:17:26,690 --> 00:17:28,770
...أعلم أنّي لستُ ندًّا لها

284
00:17:29,230 --> 00:17:31,610
.لأنّ الآنسة جيس تشبهها

285
00:17:31,610 --> 00:17:33,360
تشبه من؟

286
00:17:35,070 --> 00:17:36,200
...إنّها

287
00:17:38,570 --> 00:17:39,580
!مـ-مهلاً

288
00:17:39,990 --> 00:17:42,950
هل يُعقل أنّها صاحبة ذلك الطّوق على الجدار؟

289
00:17:44,250 --> 00:17:47,250
.أنت شديد الإدراك يا سيّد خنزير

290
00:17:48,040 --> 00:17:48,880
.ذلك صحيح

291
00:17:49,630 --> 00:17:53,210
...كان السّيّد نوت يحبّ فتاة تُدعى الآنسة إيزي

292
00:17:53,210 --> 00:17:55,880
.الّتي كانت تعمل في هذا النّزل

293
00:17:56,180 --> 00:17:58,800
.رغم أنّ حبّهما لم تكن له نهاية سعيدة

294
00:17:59,300 --> 00:18:04,480
،بدل الذّهاب إلى العاصمة الملكيّة
كانت تعيش في الدّير في بابتساز، صحيح؟

295
00:18:06,560 --> 00:18:08,690
...وبعد أن احترق الدّير

296
00:18:09,270 --> 00:18:13,530
اختُطفت الآنسة إيزي من طرف
.صيّادي اليثما وقُتلت

297
00:18:14,280 --> 00:18:16,860
...ثمّ ذهب السّيّد نوت خلفهم

298
00:18:16,860 --> 00:18:19,870
.واستعاد طوقها منهم

299
00:18:20,280 --> 00:18:21,410
...هل ممكن

300
00:18:21,410 --> 00:18:25,790
أنّ مجموعة من الهكريبون اجتمعت
حول المكان قبل الحادثة؟

301
00:18:25,790 --> 00:18:28,420
ولهذا السّبب يعاملها الجميع
...في القرية كنذير شؤم

302
00:18:28,750 --> 00:18:31,630
وبدأ نوت يشعر برغبة في قتلها؟

303
00:18:31,920 --> 00:18:34,300
.أعتقد أنّك محقّ حيال ذلك

304
00:18:36,380 --> 00:18:39,130
هل قابلتها من قبل؟

305
00:18:39,130 --> 00:18:41,430
.لا. رأيت صورة لها فحسب

306
00:18:42,180 --> 00:18:47,560
يرتدي السّيّد نوت قلادة زجاجيّة
.عليها صورة للآنسة إيزي

307
00:18:47,850 --> 00:18:49,600
.يبدو مهووسًا بها

308
00:18:51,110 --> 00:18:52,400
...وأيضًا

309
00:18:52,400 --> 00:18:56,900
استعمل السّيّد نوت عظامًا للآنسة إيزي
.كجزء من غمدَيْ سيفيه

310
00:18:57,780 --> 00:19:00,070
...ما دامت ضغينة السّيّد نوع موجودة

311
00:19:00,360 --> 00:19:04,700
فإنّ ذلكما السّيفين سيتغلّفان بالنّار
.وسيواصل قتل صائدي اليثما

312
00:19:06,450 --> 00:19:07,120
...لهذا

313
00:19:07,960 --> 00:19:12,710
.لا متّسع لي في قلب السّيّد نوت

314
00:19:15,340 --> 00:19:16,460
...اسمعي يا سيريس

315
00:19:16,840 --> 00:19:17,840
ماذا؟

316
00:19:18,170 --> 00:19:22,510
هلاّ انتظرتنا في قاعة الطّعام غدًا صباحًا أيضًا؟

317
00:19:23,470 --> 00:19:24,680
...أريدك

318
00:19:24,680 --> 00:19:26,970
!أن تساعديني على إقناعه

319
00:19:26,970 --> 00:19:28,350
.مفهوم

320
00:19:28,680 --> 00:19:30,730
.بالطّبع سأكون مسرورة بالمساعدة

321
00:19:33,690 --> 00:19:34,650
...عفوًا

322
00:19:34,650 --> 00:19:36,030
...سيّد خنزير

323
00:19:36,030 --> 00:19:37,280
.حلّ الصّباح

324
00:19:39,530 --> 00:19:41,530
بهذه السّرعة؟

325
00:19:41,530 --> 00:19:42,990
...بشأن البارحة

326
00:19:42,990 --> 00:19:44,120
...أنا

327
00:19:45,030 --> 00:19:46,450
!كانت تلك فظاظة منّي

328
00:19:46,790 --> 00:19:48,200
ماذا تقصدين؟

329
00:19:48,580 --> 00:19:49,710
...عفوًا

330
00:19:50,080 --> 00:19:54,880
بعد العشاء، عدت إلى غرفتي
.وغططت في النّوم سريعًا

331
00:19:55,340 --> 00:19:59,090
.أعتقد أنّي تركت وحدك

332
00:19:59,380 --> 00:20:02,470
...رغم كلّ طبيتك في مرافقتي

333
00:20:02,470 --> 00:20:03,640
!أنا جدّ آسفة

334
00:20:03,640 --> 00:20:04,430
.لا تقلقي

335
00:20:04,850 --> 00:20:06,260
كنت متعبة، صحيح؟

336
00:20:06,260 --> 00:20:07,930
.أتفهّم ذلك

337
00:20:07,930 --> 00:20:10,430
لستَ غاضبًا، صحيح؟

338
00:20:10,430 --> 00:20:13,190
لماذا قد أكون غاضبًا؟

339
00:20:13,190 --> 00:20:15,610
.ما دمت قد ارتحت، فذلك كلّ ما يهمّني

340
00:20:16,520 --> 00:20:18,070
كيف تشعرين؟

341
00:20:18,440 --> 00:20:20,530
هل تعانين من ألم ما؟

342
00:20:20,860 --> 00:20:22,200
.أعتقد أنّي بخير

343
00:20:22,740 --> 00:20:24,410
!أنا في أفضل حال

344
00:20:25,120 --> 00:20:25,870
.هكذا إذًا

345
00:20:26,700 --> 00:20:29,040
.لنذهب لتناول الفطور ونغادر

346
00:20:51,560 --> 00:20:53,480
"!أتشو"

347
00:20:56,980 --> 00:20:58,570
...صباح الخير

348
00:20:58,940 --> 00:21:00,190
.سيّد خنزير

349
00:21:02,820 --> 00:21:03,950
...اسمعي يا جيس

350
00:21:04,280 --> 00:21:06,070
.كنتُ أفكّر في أمر

351
00:21:06,450 --> 00:21:07,160
...إنّ

352
00:21:09,830 --> 00:21:11,750
—أظنّني أريد الذّها

353
00:21:11,750 --> 00:21:12,540
!المعذرة

354
00:21:13,460 --> 00:21:14,540
...سيّد نوت

355
00:21:14,540 --> 00:21:15,920
.أحتاج لإخبارك بأمر ما

356
00:21:17,380 --> 00:21:18,500
...ذلك الخنزير

357
00:21:18,840 --> 00:21:20,500
!بشريّ

358
00:21:20,500 --> 00:21:22,840
ألا تجيدين القيام بالصّفقات يا سيريس أم ماذا؟

359
00:21:23,130 --> 00:21:24,680
ما قصّة الخنزير؟

360
00:21:25,010 --> 00:21:27,550
...هذا الخنزير الّذي يرافق الآنسة جيس

361
00:21:27,550 --> 00:21:29,720
!إنّه بشريّ في الدّاخل

362
00:21:30,060 --> 00:21:31,060
.تكلّم رجاءً

363
00:21:31,520 --> 00:21:32,930
.سأنقل له كلامك

364
00:21:33,890 --> 00:21:34,770
...عفوًا

365
00:21:35,060 --> 00:21:36,060
.صباح الخير

366
00:21:39,480 --> 00:21:41,280
أكان ذلك صوتك؟

367
00:21:41,280 --> 00:21:42,650
.نعم، كان صوت هذا الخنزير

368
00:21:44,360 --> 00:21:45,740
!يبدو هذا مريبًا

369
00:21:45,740 --> 00:21:47,160
!اقفز

370
00:21:48,820 --> 00:21:49,700
ما رأيك؟

371
00:21:49,700 --> 00:21:50,950
أنت تصدّقني الآن؟

372
00:21:51,700 --> 00:21:53,450
—أنت... منذ متى

373
00:21:53,450 --> 00:21:56,330
.كنتُ أراقبك منذ لقائنا البارحة

374
00:21:56,330 --> 00:22:00,250
.رأيتك تدفع جيس لشرب الكحول ثمّ ذهبت لغرفتها

375
00:22:02,050 --> 00:22:03,460
...أيّها الـ –
!المعذرة –

376
00:22:05,260 --> 00:22:08,970
.تملك الآنسة جيش وصيًّا سلفًا

377
00:22:09,350 --> 00:22:10,140
...لذلك

378
00:22:12,810 --> 00:22:14,350
...لذلك يا نوت

379
00:22:14,930 --> 00:22:17,140
.أريد أن أطلب منك خدمة كوصيّ لها

380
00:22:18,980 --> 00:22:19,900
ما هي؟

381
00:22:21,020 --> 00:22:24,030
هل تمانع المجيء معنا إلى العاصمة الملكيّة؟