1
00:00:11,110 --> 00:00:13,120
!تقتربُ السّنة من نهايتِها

2
00:00:14,140 --> 00:00:15,750
.أنا سوزومي

3
00:00:16,120 --> 00:00:19,000
أنا خادمة أعمل في
.قصر ببريطانيا

4
00:00:19,640 --> 00:00:21,000
...لكن

5
00:00:21,360 --> 00:00:24,250
،بسبب ظروف مختلفة
.انهار القصر المعني

6
00:00:35,770 --> 00:00:37,760
،إلى أن يُعاد بناؤه

7
00:00:37,760 --> 00:00:41,540
!سأبقى هنا في اليابان لسنة

8
00:00:43,230 --> 00:00:44,440
!انتهيت

9
00:00:51,030 --> 00:00:53,390
ماذا سآكلُ اليوم؟

10
00:02:30,440 --> 00:02:31,510
.معطف شتوي

11
00:02:32,800 --> 00:02:34,260
.عصفور منتفخ

12
00:02:35,400 --> 00:02:37,090
.سوزومي منتفخة

13
00:02:40,970 --> 00:02:43,480
.هذه طبقات لباس كافية

14
00:02:43,480 --> 00:02:45,200
!إنّها جاهزة يا رئيسة الخدم

15
00:02:45,200 --> 00:02:46,850
!جاهزة لمواجهة البرد

16
00:02:47,070 --> 00:02:48,860
.يصعب جدًا التحرك

17
00:02:48,860 --> 00:02:52,600
عفوًا، أظنني أستطيع
...الاكتفاء بطبقات أقل

18
00:02:51,280 --> 00:02:52,600
أيّ واحدة نستعمل؟

19
00:02:52,600 --> 00:02:53,930
.كلاهما

20
00:02:53,930 --> 00:02:55,360
مرحبًا؟ هل تسمعانني؟

21
00:02:55,360 --> 00:02:58,650
.عجبًا. أصبحت منتفخة بالملابس

22
00:02:58,650 --> 00:03:00,120
!جدّي

23
00:03:00,330 --> 00:03:01,340
.هذا يذكرني بشيء

24
00:03:01,340 --> 00:03:05,530
سمعتُ أنّ ارتداء الملابس الواسعة
.رائج بين الشباب الآن

25
00:03:05,530 --> 00:03:06,720
لذا هل تودّين ارتداء معطفي؟

26
00:03:06,720 --> 00:03:08,000
!طبقة أخرى من الملابس؟

27
00:03:12,130 --> 00:03:15,560
،من الجميل وجودك يا سوزومي
.فبيتنا أصبح أكثر ترتيبًا

28
00:03:15,560 --> 00:03:18,160
...أنا ممتنة لكلّ الأغراض ولكن

29
00:03:18,160 --> 00:03:20,030
.استمتعتُ كثيرًا

30
00:03:20,350 --> 00:03:26,360
حسنًا، حان الوقت لتُساعدا
.في تجهيز عشاء الليلة

31
00:03:31,870 --> 00:03:33,570
ما هذا يا جدّي؟

32
00:03:33,570 --> 00:03:35,150
.شاهدي وتعلّمي

33
00:03:35,150 --> 00:03:37,660
...ضعي الحشوة داخل العجينة

34
00:03:37,660 --> 00:03:39,910
...بلّلي الحافة بقليل من الماء

35
00:03:40,570 --> 00:03:42,620
...شكّلي بعض الطيات

36
00:03:42,620 --> 00:03:44,790
...ثمّ لفّيها حتّى الآخر

37
00:03:44,790 --> 00:03:46,120
ألفّها؟

38
00:03:46,120 --> 00:03:47,620
حتّى الآخر؟

39
00:03:47,620 --> 00:03:50,000
!ها هي! جاهزة

40
00:03:50,000 --> 00:03:51,420
!إنّها جيوزا

41
00:03:51,420 --> 00:03:53,000
.نحن نغلّف الحشوة

42
00:03:53,000 --> 00:03:54,630
أتودّين أن تُجرّبي يا سوزومي؟

43
00:03:54,900 --> 00:03:55,760
!نعم

44
00:03:55,760 --> 00:03:57,240
هل يمكنني أن أجرّب أيضًا؟

45
00:03:57,240 --> 00:03:58,720
!بالطبع

46
00:04:05,610 --> 00:04:07,950
...هذا صعب

47
00:04:07,950 --> 00:04:09,140
كيف تؤدي سوزومي؟

48
00:04:11,700 --> 00:04:14,450
...إنّها لا تجيد الأمر إطلاقًا

49
00:04:15,180 --> 00:04:17,150
.كمية الحشوة مبالغ فيها

50
00:04:17,150 --> 00:04:20,240
.آمل ألا تبكي على النتيجة

51
00:04:29,530 --> 00:04:32,460
.لا يهم إن كانت النتيجة جيّدة أو سيئة

52
00:04:32,460 --> 00:04:33,630
!أنجزتُ اثنتان

53
00:04:35,680 --> 00:04:38,100
!شكرًا لكما على صنع الكثير

54
00:04:38,100 --> 00:04:40,480
.سأبدأ بالقلي لذا كُلا قدر ما يسعكما

55
00:04:42,960 --> 00:04:43,820
!تشون

56
00:04:43,820 --> 00:04:46,040
.أصلُ الجيوزا من الصّين

57
00:04:46,040 --> 00:04:50,230
صدّق أو لا تُصدّق
.تُؤكل الجيوزا منذ أكثر من 2500 سنة

58
00:04:51,470 --> 00:04:54,890
.انظروا إلى هذه القشرة المقرمشة
.أحسنت يا وزير الجيوزا

59
00:04:54,890 --> 00:04:57,220
.استمتعن بأكلها قبل أن تبرد

60
00:04:59,060 --> 00:05:00,350
.لنأكل

61
00:05:06,240 --> 00:05:08,000
!تضيف الخضار قرمشة رائعة

62
00:05:08,000 --> 00:05:12,000
الغلاف الطري والقشرة
!المقرمشة رائعان حقًا

63
00:05:12,870 --> 00:05:15,160
أهذه التي أعددتُها بنفسي؟

64
00:05:17,240 --> 00:05:18,820
!لنتذوقها

65
00:05:24,510 --> 00:05:26,180
!إنّها لذيذة

66
00:05:31,820 --> 00:05:35,110
ماذا؟ أمن خطب ما؟

67
00:05:35,110 --> 00:05:40,480
.حسنًا، أدركتُ للتو أنّ لكلّ شيء توازنًا

68
00:05:40,480 --> 00:05:41,990
.أوافقك

69
00:05:41,990 --> 00:05:45,120
سأعيد النظر في تلك الأغراض
.قبل أن تأخذيها

70
00:05:45,390 --> 00:05:46,910
لِم هذا التغيير المفاجئ؟

71
00:05:46,910 --> 00:05:48,550
!الجيوزا لذيذة

72
00:05:48,550 --> 00:05:50,170
!لنستمتع بها وهي ساخنة

73
00:05:50,170 --> 00:05:55,480
!جدّي! جدّتي! ريكوتا-تشان

74
00:06:00,330 --> 00:06:02,280
!جاهزة

75
00:06:03,050 --> 00:06:04,520
حسبما أظن؟

76
00:06:06,750 --> 00:06:10,610
هل فعلتُ هذا بشكل صحيح؟

77
00:06:19,530 --> 00:06:21,380
!مرحبًا يا سيّدي

78
00:06:22,340 --> 00:06:24,800
الآنسة الخادمة، كيف حالك؟

79
00:06:25,270 --> 00:06:26,030
ذاهبة للتسوق؟

80
00:06:26,030 --> 00:06:31,160
...نعم! الدايكون في التخفيضات... اليوم

81
00:06:31,390 --> 00:06:33,120
هل يثير هذا اهتمامك؟

82
00:06:33,660 --> 00:06:35,500
هل لاحظتَ أنّني أنظر إليه؟

83
00:06:35,500 --> 00:06:37,550
.نعم

84
00:06:37,550 --> 00:06:39,650
.هذا دايكون مجفف

85
00:06:39,650 --> 00:06:42,190
إنّه جاف في هذا الوقت
.من السنة. وهو ممتاز لهذا

86
00:06:43,100 --> 00:06:47,340
حسبتُ أنّه لباس جديد
.بما أنّك أنيق جدًا

87
00:06:49,880 --> 00:06:52,180
.سيكون زيًا غريبًا جدًا

88
00:06:52,550 --> 00:06:55,220
لم أعلم أنّ من الممكن الاستمتاع
بالدايكون بهذه الطريقة

89
00:06:55,220 --> 00:06:57,840
.غير زراعته وطبخه

90
00:06:57,840 --> 00:06:59,060
!ما أمتع ذلك

91
00:06:59,750 --> 00:07:00,930
هل تريدين التجربة؟

92
00:07:03,440 --> 00:07:05,070
!حسنًا

93
00:07:05,070 --> 00:07:07,640
.أولًا، اقطعي الدايكون إلى شرائح رقيقة

94
00:07:07,640 --> 00:07:10,700
.لا يهم إن قشرت القشرة أم لا

95
00:07:11,260 --> 00:07:14,140
.نسيتُ أن أسأل كيف عليّ قطعه

96
00:07:16,810 --> 00:07:18,730
!سأجرّب تقطيعه بطرق مختلفة

97
00:07:20,870 --> 00:07:23,460
.رتّبي الشرائح على مصفاة بشكل منفصل

98
00:07:23,460 --> 00:07:25,230
.ثمّ جفّفيها في الخارج

99
00:07:26,390 --> 00:07:27,720
!الجو بارد

100
00:07:27,720 --> 00:07:30,570
سيستغرق الأمر خمسة أيّام
.في هذا الوقت من السّنة

101
00:07:30,570 --> 00:07:33,430
.تصبح جاهزة عندما تجفّ كليًا

102
00:07:33,430 --> 00:07:35,310
هل أتركها في الخارج ليلًا؟

103
00:07:35,310 --> 00:07:38,060
أدخليها ليلًا وأيضًا عندما تمطر

104
00:07:38,060 --> 00:07:39,900
!مفهوم

105
00:07:42,400 --> 00:07:44,490
.يا لدفء الشمس

106
00:07:44,780 --> 00:07:46,600
...ستجفّ لمدّة خمسة أيّام

107
00:07:46,960 --> 00:07:48,740
خمسة أيّام إذًا؟

108
00:07:48,740 --> 00:07:54,580
يدوم الدايكون أطول عند تجفيفه
!ويزداد نكهة وقيمة غدائية

109
00:07:54,580 --> 00:07:55,690
!هذا هو المطلوب

110
00:07:55,690 --> 00:07:56,750
!تشون، تشون

111
00:07:59,070 --> 00:08:00,600
هل صارت جاهزة بالفعل؟

112
00:08:00,600 --> 00:08:02,250
!لم يمضِ سوى خمس دقائق

113
00:08:17,270 --> 00:08:19,520
!جاهزة

114
00:08:20,240 --> 00:08:21,580
حسبما أظن؟

115
00:08:22,170 --> 00:08:23,520
هل تصلحُ للأكل؟

116
00:08:23,520 --> 00:08:26,940
.تقلّصت إلى أقل من نصف حجمها السابق

117
00:08:27,740 --> 00:08:30,030
...حسنًا، بعد هذا

118
00:08:30,270 --> 00:08:32,860
.انقعيها في الماء لساعة تقريبًا

119
00:08:34,820 --> 00:08:36,800
!عادت إلى حجمها الأصلي

120
00:08:36,800 --> 00:08:40,790
ثمّ تبّليها حسب الذوق
.وأعدّي منها طبقًا مطهوًا

121
00:08:40,790 --> 00:08:44,780
كلّ من يعرف الطبخ يقول
"دائمًا "تبّل حسب الذوق

122
00:08:44,780 --> 00:08:48,010
عند الشك، استعملي منتسويو، بهار جاهز

123
00:08:48,620 --> 00:08:50,240
!شكرًا يا سيّدي

124
00:08:50,240 --> 00:08:52,300
!شكرًا لك يا منتسيو

125
00:08:53,550 --> 00:08:57,040
اسكبي ماء نقع الدايكون مع
،قليل من المنتسويو في القدر

126
00:08:57,040 --> 00:09:00,060
ثُمّ اطبخيه على نار هادئة
!حتّى يتبخر معظم السائل. انتهى

127
00:09:00,060 --> 00:09:02,810
!رائحة الدايكون رائعة

128
00:09:03,350 --> 00:09:04,270
!إنّه جاهز

129
00:09:04,270 --> 00:09:06,070
!دايكون مجفف مطهو

130
00:09:06,310 --> 00:09:07,820
!لنأكل

131
00:09:14,250 --> 00:09:16,580
!تنفجر رائحة الدايكون في المكان

132
00:09:16,580 --> 00:09:18,070
.له قوام متماسك وعضة مرضية

133
00:09:18,070 --> 00:09:20,580
.أشعر فعلًا بالنكهة المُركّزة

134
00:09:22,160 --> 00:09:26,440
أحبّ شرائح نصف القمر أكثر
.فهي ذات قوام مرضي

135
00:09:27,160 --> 00:09:29,170
،قطعتُها كلّها رقيقة هذه المرّة

136
00:09:29,170 --> 00:09:31,740
لكنّني أراهن أنّ الشرائح
!السميكة ستكون لذيذة أيضًا

137
00:09:32,470 --> 00:09:36,180
،بعدما جربت هذا لمرّة
.أود مواصلة تجارب أخرى

138
00:09:36,600 --> 00:09:41,100
...أتساءل كيف عليّ قطعُها
!وأيّ خضار أجرّب المرّة القادمة

139
00:09:45,440 --> 00:09:46,720
!ها هُو

140
00:09:46,720 --> 00:09:48,230
!عليّ أن أخبره عن الدايكون

141
00:09:49,740 --> 00:09:51,260
هل لاحظتَ أنّني أنظر إليه؟

142
00:09:51,260 --> 00:09:53,240
.نعم

143
00:09:53,600 --> 00:09:56,870
.الآنسة الخادمة
كيف كان الدايكون؟

144
00:10:00,880 --> 00:10:03,230
لديكِ روح فكاهة حقًا

145
00:10:11,150 --> 00:10:12,510
!حسنًا

146
00:10:12,510 --> 00:10:13,260
!تشون

147
00:10:13,260 --> 00:10:17,010
يُقال أنّ تقليد تنظيف نهاية السنة
.يرجع إلى فترة هييان

148
00:10:17,010 --> 00:10:18,340
"كان يُسمّى "سوسوهاراي

149
00:10:18,340 --> 00:10:20,550
وكان يُقام لاستقبال السنة الجديدة

150
00:10:20,550 --> 00:10:23,560
!في بيت نظيف ومبهج. تشون

151
00:10:23,560 --> 00:10:30,400
بالمناسبة، يُعد 29 و31 ديسمبر
،و1 يناير أيّام شؤم

152
00:10:30,400 --> 00:10:33,250
لذا يُعتقد أنّ من الأفضل
.تجنّب التنظيف الشامل فيها

153
00:10:33,670 --> 00:10:36,720
،لدينا عادة تنظيف الربيع في بريطانيا

154
00:10:36,720 --> 00:10:39,030
!لكنّني سأجرّب الأسلوب الياباني اليوم

155
00:10:40,090 --> 00:10:41,540
!أولًا

156
00:10:43,290 --> 00:10:45,540
!سأدفأ حالما أتحرّك

157
00:10:45,540 --> 00:10:48,040
!يمكنك فعلها يا سوزومي

158
00:10:50,440 --> 00:10:52,260
.شكرًا على مجهودك

159
00:10:52,670 --> 00:10:56,430
...سأضع الأشياء التي تستغرق وقتًا في الماء

160
00:10:58,440 --> 00:11:00,060
.امسح الغبار دائمًا من الأعلى

161
00:11:05,060 --> 00:11:06,760
.نظّف النوافذ من الخارج

162
00:11:07,720 --> 00:11:08,890
...امسح بالماء أولًا

163
00:11:08,890 --> 00:11:10,640
!ثم امسح بمنشفة جافة لتلمع

164
00:11:11,570 --> 00:11:12,220
!تشون

165
00:11:12,220 --> 00:11:15,450
استخدام ممسحة الأرض تسهّل
.تنظيف الشاشات كثيرًا

166
00:11:15,450 --> 00:11:18,180
اغسل الإطارات بالماء
،ثمّ افركها بالفرشاة

167
00:11:18,180 --> 00:11:21,950
!اشطفها مجددًا، وجففها بقطعة قماش

168
00:11:22,620 --> 00:11:24,020
جوهر تنظيف نهاية السنة هو

169
00:11:24,020 --> 00:11:26,240
الاعتناء بالزوايا التي
.لا أصلُ إليها عادة

170
00:11:26,950 --> 00:11:28,960
!أصبح المكان حارًا

171
00:11:30,960 --> 00:11:33,960
.عند الكنس، اتبع اتجاه حصر التاتامي

172
00:11:34,340 --> 00:11:36,620
...حتّى الأماكن التي لا أستعملها كثيرًا

173
00:11:37,460 --> 00:11:39,690
.سأمسح الثلاجة أيضًا

174
00:11:40,510 --> 00:11:43,350
.أتسائل هل نقعته مدّة كافية

175
00:11:43,350 --> 00:11:46,160
!امسح بمنشفة جافّة كلمسة أخيرة

176
00:11:50,160 --> 00:11:51,970
.سأغسل الحوض أيضًا

177
00:12:05,260 --> 00:12:06,160
!حسنًا

178
00:12:06,410 --> 00:12:08,900
!انتهى تنظيف  نهاية السنة

179
00:12:09,660 --> 00:12:12,240
يا له من شعور جميل
!حين يلمع كلّ شيء

180
00:12:12,240 --> 00:12:14,210
!تدفأتُ أيضًا

181
00:12:16,250 --> 00:12:17,630
ما هذا الصوت؟

182
00:12:19,210 --> 00:12:21,540
!ماذا؟ أهذا صوت معدتي؟

183
00:12:23,260 --> 00:12:25,230
!ما إن أدركتُ ذلك، حتّى جعتُ فجأة

184
00:12:25,230 --> 00:12:28,310
!كنتُ مركزة جدًا فلم ألاحظ

185
00:12:29,110 --> 00:12:32,100
ما الذي يسعني أكله
الآن لأشبع هذا الجوع؟

186
00:12:32,100 --> 00:12:33,320
هل لدي أيّ شيء؟

187
00:12:40,730 --> 00:12:41,990
!حسنًا، مرّت ثلاث دقائق

188
00:12:42,230 --> 00:12:43,420
!اكتمل

189
00:12:45,270 --> 00:12:46,560
!لنأكل

190
00:13:11,350 --> 00:13:13,480
.كان لذيذًا جدًا

191
00:13:13,930 --> 00:13:17,360
.التهمته وكأنّني في سباق

192
00:13:18,560 --> 00:13:22,490
!أنا مستعدة الآن لاستقبال السنة الجديدة

193
00:13:23,000 --> 00:13:26,880
ربّما سأذهبُ إلى بيت جدّتي
.لأساعد في التنظيف

194
00:13:27,540 --> 00:13:28,950
!فراشك

195
00:13:28,950 --> 00:13:31,370
!لا تنسي أن تُدخلي فراشك

196
00:13:31,370 --> 00:13:32,280
!تشون

197
00:13:56,300 --> 00:13:59,510
أهذه لعبة لشخصين فعلًا؟

198
00:13:59,510 --> 00:14:01,010
.لا أدري

199
00:14:03,560 --> 00:14:04,910
!مرحبًا

200
00:14:04,910 --> 00:14:06,330
!أنزو-سان

201
00:14:06,330 --> 00:14:07,840
ريكوتا-سان هنا أيضًا؟

202
00:14:07,840 --> 00:14:09,170
.هذا مناسب

203
00:14:09,170 --> 00:14:10,490
