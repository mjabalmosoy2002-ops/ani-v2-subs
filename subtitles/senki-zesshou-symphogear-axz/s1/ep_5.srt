1
00:00:24,820 --> 00:00:28,260
ما الذي يجري بالضبط؟

2
00:00:29,250 --> 00:00:32,930
تمّت إبادة مقرّ منظّمة كازاناري؟

3
00:00:33,950 --> 00:00:35,170
أين البقيّة؟

4
00:00:40,850 --> 00:00:41,810
!كيريكا-تشان

5
00:00:43,890 --> 00:00:46,470
!تماسكي يا ماريا

6
00:00:46,980 --> 00:00:48,050
!ماريا

7
00:00:57,230 --> 00:00:59,210
...أنا... على قيدِ الحياة

8
00:02:43,760 --> 00:02:45,120
خسرنا

9
00:02:45,120 --> 00:02:47,940
خسرنا خسارة نكراء

10
00:02:47,940 --> 00:02:52,370
ظهر المُدير التنفيذي لمتنوّري بافاريا أخيراً

11
00:02:53,280 --> 00:02:55,550
آدم وايسهاوبت

12
00:02:56,310 --> 00:02:57,250
...و

13
00:02:59,160 --> 00:03:02,270
الفاست روب الخاصّة بالخيميائيّات

14
00:03:02,270 --> 00:03:04,180
،عندما تقاطعت أنصالنا

15
00:03:04,180 --> 00:03:07,340
شعرتُ وكأنّ قوّة إغنايت كانت تُجرَّد
منّا بشكل قسريّ

16
00:03:07,340 --> 00:03:08,720
ماذا كانت تلك القوّة؟

17
00:03:09,510 --> 00:03:14,080
أعتقد أنّها قوّة لابيس فيلوسوفيكوس، حجر الفيلسوف

18
00:03:14,080 --> 00:03:17,790
...حجر الفيلسوف

19
00:03:18,480 --> 00:03:23,550
الهدف النهائي لبحث الخيميائيّات عن الكمال
قد تحقّق على هيئة ملموسة

20
00:03:23,820 --> 00:03:29,230
يطهّر كلّ الخبائث بما في ذلك الأمراض ويزيلها

21
00:03:29,800 --> 00:03:35,340
لم يكن للداينسليف الذي يشكّل نواة
وحدة إغنايت أي أمل ضدّه

22
00:03:35,340 --> 00:03:38,690
لذا، جوهريّاً، إنّه العدوّ الطبيعي لإغنايت

23
00:03:39,040 --> 00:03:41,910
قوّة تعطيل الوحدة قسريّاً

24
00:03:41,910 --> 00:03:43,560
جعلتني أشعر وكأنّني أتمزّق إرباً

25
00:03:43,840 --> 00:03:48,110
ذاك الشيء هو سلاحنا المُطلَق، لكنّه بات
الآن نقطة ضعف؟

26
00:03:49,250 --> 00:03:53,120
هل وصلت الأخريات بأمان إلى طوكيو؟

27
00:03:53,690 --> 00:03:56,110
،سيتوجّب علينا انتظار الفحص الكامل

28
00:03:56,110 --> 00:03:58,840
لكن المُعجزة هي أنّهن لم يُصَبْن بأية
جروح خطيرة

29
00:04:01,520 --> 00:04:03,780
سيكونَنَّ بخير

30
00:04:03,780 --> 00:04:05,770
نعم، معكِ حقّ

31
00:04:05,770 --> 00:04:08,050
سيكونَنّ بخير. أنا متأكّدة

32
00:04:08,320 --> 00:04:10,860
،استخدام دروعهن من دون عقار الواصِل

33
00:04:10,860 --> 00:04:13,850
بالإضافة إلى الجهد المُطبَّق على أجسادهن
...بواسطة وحدة إغنايت

34
00:04:13,850 --> 00:04:17,690
...قد تكون الآثار الجانبيّة لذلك مماثِلة لآثار أغنية الذروة

35
00:04:17,690 --> 00:04:18,970
...لكن

36
00:04:22,210 --> 00:04:26,400
تمّ اتّخاذ القرار بمغادرة مقرّ منظّمة كازاناري

37
00:04:26,730 --> 00:04:28,860
جميعكن، استعدِدنَ للمغادرة

38
00:04:29,350 --> 00:04:32,000
،لو تمكنّا من فكّ شفرة وثائق فالفيردي

39
00:04:32,000 --> 00:04:34,400
...لاستطعنا ربّما فعل شيء ما

40
00:04:42,090 --> 00:04:43,220
سيّدي

41
00:04:43,220 --> 00:04:45,950
يريد كاماكورا رؤيتك

42
00:04:46,440 --> 00:04:49,190
سينهال عليّ بوابل من التوبيخ

43
00:04:59,370 --> 00:05:03,570
نور لابيس تغلّب على ظلام إغنايت

44
00:05:03,570 --> 00:05:07,190
...كان نصرنا أكيداً. لكن

45
00:05:07,470 --> 00:05:12,400
!كان من الممكن أن نحترق ونصبح رماداً

46
00:05:12,400 --> 00:05:17,130
وليس ذلك فحسب، لم نقضِ عليهن

47
00:05:21,790 --> 00:05:24,770
!يا فتيات، وصلَ آدم

48
00:05:25,050 --> 00:05:28,230
!بدلاً من النّكد، لنكن لامعات

49
00:05:29,930 --> 00:05:31,780
!يا فتيات

50
00:05:31,780 --> 00:05:33,360
اهدئي يا تيكي

51
00:05:33,360 --> 00:05:37,020
لكنّهن على حقّ

52
00:05:37,510 --> 00:05:41,060
انضممتُ للمعركة للتفاخر

53
00:05:41,060 --> 00:05:42,810
...بما أنّني كنتُ في المنطقة

54
00:05:43,190 --> 00:05:45,010
لكن أتعلم؟

55
00:05:45,780 --> 00:05:49,990
أعتقد سأدعكن تتولّين أمر السيمفوغير

56
00:05:49,990 --> 00:05:52,460
حضرة المدير التنفيذي، إلى أين؟

57
00:05:52,460 --> 00:05:57,410
قرأت تيكي النجوم وأخبرتني، صحيح؟

58
00:05:57,410 --> 00:05:58,190
أجل

59
00:05:58,670 --> 00:06:01,340
كانت التّجربة ناجحة، صحيح؟

60
00:06:01,340 --> 00:06:04,130
لذا لنفعلها بجدّية في المرّة المقبلة

61
00:06:04,800 --> 00:06:07,310
ونُظهِر قوّة إله

62
00:07:03,480 --> 00:07:04,900
المِنجل المعكوس رابونزيل

63
00:07:05,240 --> 00:07:09,420
تدور أنصال شول شاغانا للأبد لتقطِّع
!كلّ شيء في طريقها

64
00:07:09,420 --> 00:07:11,460
،أقطِّع العقبات التي تعترض طريقنا

65
00:07:11,460 --> 00:07:14,010
!وأمهِّد طريقاً للغد

66
00:07:13,280 --> 00:07:15,160
Δ قاتِلة أكسيل الجذّابة بأسلوب

67
00:07:16,960 --> 00:07:19,890
يستطيع الإيغاليما تقطيع أي شيء

68
00:07:19,890 --> 00:07:22,040
!شبح! إله

69
00:07:22,040 --> 00:07:23,660
!سأقطّعهم إلى نصفين

70
00:07:30,010 --> 00:07:32,870
...تظلُّ تلك الفتيات تضغطن على أنفسهن

71
00:07:32,870 --> 00:07:34,030
!ماريا-سان

72
00:07:34,570 --> 00:07:35,940
هل ينبغي أن تكوني مستيقظة؟

73
00:07:35,940 --> 00:07:37,590
!لستِ بحالٍ جيّدة أيضاً

74
00:07:51,940 --> 00:07:53,220
!كيري-تشان

75
00:08:00,000 --> 00:08:01,240
هل أنتِ بخير؟

76
00:08:03,500 --> 00:08:05,700
!شيرابي-تشان! كيريكا-تشان

77
00:08:06,600 --> 00:08:09,160
لماذا تفعلان هذا من دون الواصِل؟

78
00:08:09,560 --> 00:08:15,510
...لو كنّا نستطيع القتال من دون الواصِل، لتمكّنّا

79
00:08:19,250 --> 00:08:20,580
...لكن

80
00:08:20,580 --> 00:08:21,800
نحن بخير

81
00:08:22,130 --> 00:08:25,030
لنستمرّ في التدريب

82
00:08:25,270 --> 00:08:30,450
علينا أن نعزِّز من توافقِنا، لذا لسنا بحاجة
للاعتماد على الواصِل

83
00:08:30,450 --> 00:08:32,360
!لكن هذا جنون! لا يجوز

84
00:08:32,360 --> 00:08:35,190
!حركة واحدة خاطئة قد تكلّف الموت

85
00:08:35,800 --> 00:08:40,520
التّوافق لديكما جيّد ولم تتساءلا عن السّبب يوماً

86
00:08:40,520 --> 00:08:41,870
!وما أدراكِ أنتِ؟

87
00:08:43,120 --> 00:08:45,760
،حتّى لو لم نمت

88
00:08:45,760 --> 00:08:50,080
يؤلمنا كثيراً أن يعاملنا الآخرون كبقايا
!لدرجة تكاد تقتلنا

89
00:08:51,970 --> 00:08:53,380
لندعهما يفعلانها

90
00:08:53,380 --> 00:08:54,540
!ماريا-سان

91
00:08:54,810 --> 00:08:58,880
سأتدرّب معهما وأحرص على ألّا يبالغا كثيراً

92
00:08:58,890 --> 00:09:00,680
!لن تعزّزي من توافقيّتهما

93
00:09:00,680 --> 00:09:03,350
!أنتِ فقط تزيدين عدد الأغبياء في الغرفة

94
00:09:03,840 --> 00:09:06,100
يوم واحد وأعلم أنّ الواصِل سيكتمل

95
00:09:08,350 --> 00:09:14,030
لكن ليس لدينا الوقت لانتظار ذلك اليوم

96
00:09:14,030 --> 00:09:15,630
هناك طريقة

97
00:09:16,240 --> 00:09:21,450
طريقة قد تؤدّي لصنع القطعة الأخيرة
التي نحتاجها لإكمال الواصِل

98
00:09:21,450 --> 00:09:23,210
...القطعة الأخيرة

99
00:09:23,210 --> 00:09:24,450
حقّاً؟

100
00:09:24,760 --> 00:09:30,290
هناك جزء واحد في وصفةِ الواصِل أعطتني
إيّاها الدكتورة فير ولم أستطع تحليلها

101
00:09:30,290 --> 00:09:33,010
إنّه المكان في الدماع والذي يتّصل به الواصِل

102
00:09:33,010 --> 00:09:37,930
لتخفيفِ الجهد النّاجم عن السيمفوغير

103
00:09:37,930 --> 00:09:40,900
،حتّى لو حظي بمساعدة فيني ومؤسّسات ساكريست الاتّحاديّة

104
00:09:40,900 --> 00:09:43,300
القدرة على صنع الواصل

105
00:09:43,300 --> 00:09:47,980
تعني أنّه كان عالم أحياء مذهلاً رغم أخطائه الكثيرة

106
00:09:47,980 --> 00:09:51,390
مذهل؟ هذا تفكير فظيع

107
00:09:51,940 --> 00:09:55,950
المعذرة... لنقفز من فوق الأمور التكنولوجيّة

108
00:09:55,950 --> 00:09:58,350
ونتطرّق لموضوع القطعة الأخيرة

109
00:09:58,350 --> 00:10:01,480
المفتاح هو الأيرغاتلام الخاص بماريا-سان

110
00:10:01,990 --> 00:10:04,960
الفضّي... درعي؟

111
00:10:05,440 --> 00:10:10,270
إحدى قدرات أيرغاتلام الخاصّة هي التحكّم
بمُوجِّهات الطاقة

112
00:10:10,270 --> 00:10:13,530
...الضوء الذي رأيناه عدّة مرّات عندما كنتِ في مأزق

113
00:10:13,870 --> 00:10:17,460
كان ذلك الضوء إشارات كهربائيّة تنتقل ما بين الدّماغ

114
00:10:17,460 --> 00:10:20,160
والسيموغير الخاص بكِ يصبح مرئيّاً بفضل الأيرغاتلام

115
00:10:20,160 --> 00:10:25,350
أعتقد أنّ ذلك له دور في تخفيف الجهد الذي يشكّله
السيمفوغير على الجسد كذلك

116
00:10:25,350 --> 00:10:29,890
التّدريب الذي أدّيتِه بين كلّ مهامكِ قد عزّز

117
00:10:29,890 --> 00:10:34,300
مُعامِل التوافقيّة لديكِ شيئاً فشيئاً

118
00:10:34,300 --> 00:10:37,430
أعتقد أنّ هذه هي النتيجة

119
00:10:37,430 --> 00:10:42,680
مُعامِل التوافقيّة لدي ماريا هو الأعلى
من بينا نحن الثّلاثة

120
00:10:42,680 --> 00:10:43,680
...ومعنى هذا

121
00:10:43,680 --> 00:10:46,950
!كلّ عملنا المُجِدّ لم يكن عبثاً

122
00:10:47,200 --> 00:10:52,430
أجل. إذا تقفّينا أثر الإشارة الكهربائيّة
...المتبقّية في دماغ ماريا-سان

123
00:10:52,430 --> 00:10:55,670
يمكننا أن نكتشف ما الذي يؤثّر الواصِل عليه؟

124
00:10:56,150 --> 00:10:57,870
لكن كيف؟

125
00:10:57,870 --> 00:11:01,220
سيتوجّب عليكِ الذهاب وتوسّل ذلك الحقير
فير لمعرفة ذلك

126
00:11:02,430 --> 00:11:03,910
اتبعنَني من فضلكن

127
00:11:05,750 --> 00:11:06,800
ما هذا؟

128
00:11:07,110 --> 00:11:10,940
هديّة من الدكتور فير. نظام التغذية المُباشرة

129
00:11:10,940 --> 00:11:13,900
أعدتُ صنعه باستخدام الخيمياء التطبيقيّة

130
00:11:14,250 --> 00:11:16,490
يحوِّل عقلَ شخص آخر

131
00:11:16,490 --> 00:11:20,300
إلى إشارات كهربائيّة ويرسلها إلى دماغ
المستخدِم للسماح بالرصد والمراقبة

132
00:11:20,300 --> 00:11:23,440
إذاً يمكنكِ استخدامه لاستراق النظر
إلى ما بداخل رأس شخص؟

133
00:11:23,440 --> 00:11:25,310
نظريّاً

134
00:11:25,310 --> 00:11:29,530
لكن الدّماغ هو متاهة مُعقّدة

135
00:11:29,800 --> 00:11:33,850
في أسوأ الحالات، عقلا المُراقِب والمُراقَب
قد يختلطان

136
00:11:33,850 --> 00:11:35,640
...ليدمّرهما معاً

137
00:11:36,070 --> 00:11:37,000
سأفعلها أنا

138
00:11:37,760 --> 00:11:40,920
أخيراً حصلنا على طريقة لإنهاءِ الواصِل

139
00:11:40,920 --> 00:11:42,500
لا سبب يدعو لتجاهل ذلك

140
00:11:42,500 --> 00:11:44,310
!لكن هذا خطير جدّاً

141
00:11:44,310 --> 00:11:45,980
!أنتِ متهوّرة للغاية

142
00:11:45,980 --> 00:11:47,840
أيحقُّ لكما أن تتكلّما؟

143
00:11:52,210 --> 00:11:56,600
إذاً يشكّل خطراً على المُراقِب أي أنتِ كذلك؟

144
00:11:56,600 --> 00:11:59,020
هذه هي المعركة التي يمكنني خوضها

145
00:11:59,020 --> 00:12:01,990
!قاتلي معي من فضلكِ يا ماريا-سان

146
00:12:16,700 --> 00:12:21,040
إذاً سمحتما لعدوٍّ أجنبيّ يدوس على ترابنا؟

147
00:12:21,040 --> 00:12:25,450
ونتيجة ذلك، دُمِّر مقرّ مُنظّمة كازاناري في ماتسوشيرو

148
00:12:25,450 --> 00:12:30,270
خسرنا مُعظم الأسرار التي كنّا قد حفظناها
منذ الحرب

149
00:12:30,540 --> 00:12:33,990
فشلنا هو الذي سمح لهذا الخطر الأجنبي
،يقترب من ترابنا

150
00:12:33,990 --> 00:12:35,860
وفشلنا في دحره

151
00:12:36,280 --> 00:12:37,410
—لساننا عاجز عن التّعبير

152
00:12:37,410 --> 00:12:38,900
!هذا لا يستحقُّ حتّى الإصغاء

153
00:12:45,860 --> 00:12:47,820
تعيان الأمر، صحيح؟

154
00:12:47,820 --> 00:12:51,620
سأحرص على أن يتمّ تمرير القانون المتعلِّق
بالدفاع الوطني بسرعة

155
00:12:51,620 --> 00:12:54,820
أنتما لا تتعاملان مع هذا بالجدّية المناسبة
!لذا افعلا ذلك حالاً

156
00:12:58,180 --> 00:13:00,920
أنتِ فاشلة كحامية

157
00:13:00,920 --> 00:13:04,910
من العار أن يجري دماء كازاناري في عروقك

158
00:13:04,910 --> 00:13:10,650
أعتقد ليس دمنا الذي يجعلنا حُماة بل قلوبنا

159
00:13:21,680 --> 00:13:23,290
هل نبدأ؟

160
00:13:23,290 --> 00:13:26,900
نعم. سوف تدخلين عقلي إذاً، صحيح؟

161
00:13:26,900 --> 00:13:31,610
بالتّحديد، سأتّصل بِبُنية دماغك المعروضة
في واقع افتراضي

162
00:13:31,930 --> 00:13:34,770
سيتشارك وعيكِ ووعيي

163
00:13:34,770 --> 00:13:35,800
عُلِم

164
00:13:44,750 --> 00:13:47,730
...كيري-تشان، أعلم أنّكِ قلقة، لكن

165
00:13:47,730 --> 00:13:51,630
!أعلم! لقد اتّخذتُ قراراً واعياً تماماً

166
00:13:53,900 --> 00:13:57,380
تستحقّين هذا لمجازفتكِ في أكل سمك الشوكولاتة
المُنكَّه بالبيض

167
00:13:57,380 --> 00:14:00,630
احرصي على إنهاء وجبتكِ أيّتها التقليديّة

168
00:14:02,810 --> 00:14:04,320
إنّه لذيذ

169
00:14:04,320 --> 00:14:06,240
!هذا لأجل الحظّ السّعيد

170
00:14:06,240 --> 00:14:10,700
إذا استطعتُ أكلها كلّها فهذا يعني أنّ ما تفعله
ماريا وإيلفناين سيفلح

171
00:14:14,000 --> 00:14:16,610
هيبيكي؟ هيبيكي؟

172
00:14:17,140 --> 00:14:18,230
ماذا؟

173
00:14:18,790 --> 00:14:20,330
إنّها تذوب

174
00:14:24,690 --> 00:14:29,980
على الأقلّ، يمكنني سماعكِ، أو امسحي
آثار المُثلّجات عن وجهكِ

175
00:14:30,330 --> 00:14:33,420
كي يمكنكِ التكلّم معي عندما يحدث شيء ما

176
00:14:33,420 --> 00:14:37,600
شكراً لكِ يا ميكو. أنتِ حقّاً إشراقة شمسي

177
00:14:37,830 --> 00:14:39,190
ننتقل الآن للنبأ التالي

178
00:14:39,190 --> 00:14:42,900
ستيفان-كن الذي فقد ساقه في حربٍ
،أهليّة في موطنه

179
00:14:43,280 --> 00:14:49,150
قد أتى من جمهوريّة فالفيردي للحصول
،على طرف صناعي متطوّر

180
00:14:49,150 --> 00:14:52,370
وذلك كي يتمكّن من جديد من لعب كرة القدم

181
00:14:52,760 --> 00:14:57,010
هذا ممتاز. سيتمكّن من لعِب كرة القدم مجدّداً

182
00:14:57,010 --> 00:14:58,710
...آمل ذلك

183
00:15:00,520 --> 00:15:04,730
حقيقة معاناتكِ من خيار ما لا يعني دوماً
أنّه الخيار الصّائب

184
00:15:05,500 --> 00:15:06,680
...في الواقع

185
00:15:06,680 --> 00:15:10,090
!أحياناً لا يكون هناك خياراً صائباً إطلاقاً

186
00:15:14,180 --> 00:15:16,160
مستعدّتان؟ ها نحن ذا

187
00:15:41,200 --> 00:15:44,190
...هذا عقل ماريا

188
00:15:44,630 --> 00:15:47,230
...ما بداخل قلبها، ترسمه ذكرياتها

189
00:15:54,770 --> 00:15:56,220
ماريا-سان؟

190
00:16:02,220 --> 00:16:03,430
!مؤلم

191
00:16:04,930 --> 00:16:06,180
لماذا؟

192
00:16:06,440 --> 00:16:10,540
ستبدآن بالتدريبِ القتالي اليوم

193
00:16:10,970 --> 00:16:14,340
الطفلات المُستقبِلات اللّواتي لم يصبحن
حاويات لفيني

194
00:16:14,340 --> 00:16:18,560
سيُساهمن في سبيلِ المنظّمة ليس بذرف
الدّموع، إنّما بإراقة الدّماء

195
00:16:20,920 --> 00:16:25,950
بما أنّني أشاركها عقلها، تصلني ذكرياتها
وتجاربها كذلك

196
00:16:38,720 --> 00:16:40,500
أين هذا؟

197
00:16:40,920 --> 00:16:44,020
...جزئيّة الدّماغ والمتّصلة بالدرع

198
00:16:55,900 --> 00:16:57,790
اشربنه بسرعة

199
00:17:17,080 --> 00:17:19,680
ما هذا؟ ذكريات النويز؟

200
00:17:28,400 --> 00:17:33,860
إذا متُّ هنا فأنا الحقيقيّة قد لا تستيقظ

201
00:18:02,690 --> 00:18:04,090
ماريا-سان؟

202
00:18:04,090 --> 00:18:09,240
حتّى لو كنتِ أنتِ، من المحرج قليلاً أن يرى
شخصٌ ذكرياتي

203
00:18:09,240 --> 00:18:13,730
متى ومن أي ذكرى أنتِ يا ماريا-سان؟

204
00:18:14,110 --> 00:18:16,740
وعدنا أن نقاتل معاً فحسب، صحيح؟

205
00:18:17,240 --> 00:18:21,490
إذا كنّا نتشارك عقلينا فهذا يعني أنّكِ
لستِ الوحيدة هنا

206
00:18:21,770 --> 00:18:25,290
ما الضير من تحطيم الرّؤوس وأنا بداخل بنفسي؟

207
00:18:30,640 --> 00:18:33,890
!هذه ليست ذكرى... هذا عقل ماريا-سان

208
00:18:35,160 --> 00:18:36,120
!سنشقُّ طريقنا

209
00:18:36,120 --> 00:18:37,260
!حسناً

210
00:18:48,280 --> 00:18:48,970
ماذا؟

211
00:18:52,640 --> 00:18:54,760
ما هذا المكان؟

212
00:18:54,760 --> 00:18:59,330
صورة في قلبك، من ذكرياتكِ التي كدتِ
تنسينها، ربّما؟

213
00:18:59,790 --> 00:19:01,130
في قلبي؟

214
00:19:13,580 --> 00:19:15,010
كيف حالهما؟

215
00:19:15,010 --> 00:19:18,210
أعضاؤهما الحيويّة دون الطبيعي

216
00:19:18,450 --> 00:19:20,740
...إذا استمرّت هذه الحالة

217
00:19:20,740 --> 00:19:22,170
لا نملك خياراً

218
00:19:22,170 --> 00:19:25,040
...سيتوجّب علينا وبشكلٍ مؤقّت إلغاء

219
00:19:26,430 --> 00:19:27,600
ما الخطب؟

220
00:19:28,250 --> 00:19:30,530
!تمّ رصد نويز آلكا في خليج طوكيو

221
00:19:30,770 --> 00:19:33,110
في البداية، النويز الذي استطاع فصل
،جزء من الفضاء

222
00:19:33,110 --> 00:19:34,980
...والآن شكل جديد آخر

223
00:19:34,980 --> 00:19:37,790
!ويبدو أنّه ضخم جدّاً

224
00:19:37,790 --> 00:19:39,790
...لن ندعه يمرّ

225
00:19:39,790 --> 00:19:40,900
!سأذهب

226
00:19:49,120 --> 00:19:55,140
كان سرداب دار الأوبّرا ذاك مليئاً بمُختلَف
الأشياء، ليس تيكي فقط

227
00:19:55,140 --> 00:19:58,170
لن نتراجع

228
00:19:58,170 --> 00:20:01,300
أجل. سيستخدم متنوّرو بافاريا

229
00:20:01,300 --> 00:20:06,380
قوّة الآلهة لإعادة العالم إلى حالته الصحيحة

230
00:20:06,840 --> 00:20:09,560
،إذا كان لمساعدة شخص

231
00:20:09,560 --> 00:20:13,230
...فيمكننا أن نتعاون معاً

232
00:20:14,230 --> 00:20:18,880
...عدالة أعظم... لا بل العدالة في صفِّنا

233
00:20:19,390 --> 00:20:23,570
لن أتجاهل هذا الطريق أبداً حتّى ولو
توجّب عليّ سلوكه بمفردي

234
00:20:23,570 --> 00:20:25,010
لستِ وحدكِ

235
00:20:25,580 --> 00:20:28,330
لن أدعكِ تكونين وحدكِ

236
00:20:28,330 --> 00:20:31,800
نحن هنا بفضلكِ

237
00:20:32,490 --> 00:20:34,260
سنكون نحن الثّلاثة معاً للأبد

238
00:20:39,320 --> 00:20:42,730
!حسناً! سنتوجّه إلى مهبط الحوّامة

239
00:20:43,350 --> 00:20:45,310
!يمكننا أن نحزن لاحقاً

240
00:20:45,310 --> 00:20:46,170
!هيّا بنا

241
00:20:47,090 --> 00:20:48,900
!سنتوجّه إلى المقرّ

242
00:20:49,840 --> 00:20:52,360
!أنا قلقة عليهما

243
00:20:54,410 --> 00:20:57,230
ميكو، توجّهي إلى الملجأ في المدرسة

244
00:20:58,670 --> 00:20:59,770
!هيبيكي

245
00:21:02,950 --> 00:21:06,500
الجميع لديهم شيء لن يتخلّوا عنه أبداً

246
00:21:07,260 --> 00:21:11,020
لكن هذا لا يعني أنّني لا أستطيع الفوز

247
00:21:12,070 --> 00:21:13,650
ليس عليكِ الفوز

248
00:21:16,810 --> 00:21:20,580
لكن احرصي على ألّا تخسري

249
00:21:27,400 --> 00:21:30,310
!ثمّة أغنية في قلبي

250
00:21:31,530 --> 00:21:32,440
نعم

251
00:23:11,210 --> 00:23:14,590
...ماريا

252
00:23:14,590 --> 00:23:15,660
استيقظي

253
00:23:20,470 --> 00:23:21,680
...أنت

254
00:23:22,000 --> 00:23:26,060
أجل. أنا مجرّد بطل عابر

255
00:23:26,060 --> 00:23:29,090
!دكتور فير! ظننتُك ميّتاً

256
00:23:29,090 --> 00:23:32,680
أعيش في قلبك

257
00:23:33,090 --> 00:23:39,250
!يبدو أنّ الأمر ينطبق على معظم مَن يموتون