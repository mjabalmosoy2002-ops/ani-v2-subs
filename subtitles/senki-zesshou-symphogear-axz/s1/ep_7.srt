1
00:00:00,480 --> 00:00:04,360
قلتُن أنّكن ستحرّرن البشريّة من قيود السّيطرة

2
00:00:04,360 --> 00:00:06,660
ماذا تقاتلن؟

3
00:00:06,660 --> 00:00:09,830
أخبرننا ماذا تُرِدن

4
00:00:09,830 --> 00:00:14,310
إذا كنتُن تقاتلن لأجلِ شخص آخر
فيمكننا أن نتعاون معاً

5
00:00:14,660 --> 00:00:16,260
نتعاون معاً؟

6
00:00:16,260 --> 00:00:17,850
يا لها من غطرسة

7
00:00:17,850 --> 00:00:22,790
سنستخدم قوّةَ الآلهة لكسرِ لعنة بالال

8
00:00:24,350 --> 00:00:27,920
قوّة الآلهة؟ لعنة بالال؟

9
00:00:28,440 --> 00:00:31,040
سنسيطر على الآثار القمريّة

10
00:02:21,400 --> 00:02:23,700
الآثار القمريّة؟

11
00:02:23,700 --> 00:02:27,970
نظام العالم غير المكتمل، حيث امتلك بشر
،سلطةً على بشر آخرين

12
00:02:27,970 --> 00:02:32,710
هو نتيجة تنافر سببه لعنة بالال المنقوشة
في أرواحنا

13
00:02:33,700 --> 00:02:38,770
وجعل الناقص كاملاً هو هدف سان جيرمان

14
00:02:39,180 --> 00:02:42,480
إنّه مذهب متنوّري بافاريا

15
00:02:42,480 --> 00:02:47,230
الحصول على الحقوقِ الإداريّة للآثار القمريّة

16
00:02:47,230 --> 00:02:51,710
يتطلّب قوّةً مكافئةً للحُكّام القُدماء والذين
كان يُطلَق عليهم بالآلهة

17
00:02:51,710 --> 00:02:57,150
لهذا أدّينا الطقوس في كلّ أنحاء العالم
بما في ذلك فالفيردي

18
00:02:57,150 --> 00:03:01,390
لكن هذا لا يمنحكن الحقّ للتضحية بالآخرين

19
00:03:01,390 --> 00:03:02,750
نحن لا نضحّي بهم

20
00:03:02,750 --> 00:03:05,300
،الدّماء الذي أريق، الأرواح التي عاشت

21
00:03:05,300 --> 00:03:07,130
!هي أحجار أساس الثّورة

22
00:03:14,710 --> 00:03:16,500
هجمة العنقاء المُحلِّق الجارحة

23
00:03:38,510 --> 00:03:40,180
ما رأيكن بهذه؟

24
00:03:42,020 --> 00:03:44,450
!هذا ردّ الاعتبار على ما سبق

25
00:03:45,450 --> 00:03:46,550
!إنّها ضخمة

26
00:03:52,750 --> 00:03:53,670
!شيرابي

27
00:03:58,200 --> 00:03:59,430
...على هذا المنوال

28
00:03:59,730 --> 00:04:02,120
!إذاً لنفعلها! شيرابي

29
00:04:02,650 --> 00:04:04,330
!وحدة إغنايت

30
00:04:04,330 --> 00:04:05,230
!إشهار السّيوف

31
00:04:05,230 --> 00:04:06,140
!ديث

32
00:04:06,880 --> 00:04:11,110
...لا! قوّة حجر الفيلسوف تُبطِل قوّة داينسليف

33
00:04:21,600 --> 00:04:23,560
إنّهن متهوّرات

34
00:04:23,560 --> 00:04:25,520
...ما دمنَ لا يستطعن إصابتنا

35
00:04:26,060 --> 00:04:28,560
!يجب أن يمُتن

36
00:04:31,190 --> 00:04:33,840
!أساليبكنّ البسيطة هي دليل على أنّ عقولكن فارغة

37
00:04:39,740 --> 00:04:41,770
!تسوكويومي! أكاتسكي

38
00:04:44,000 --> 00:04:48,020
لأجل الغد، رصاصي لن يتردّد

39
00:04:48,020 --> 00:04:50,570
لماذا؟ لماذا؟

40
00:04:50,570 --> 00:04:52,110
مُحال أن تفهمي

41
00:04:52,630 --> 00:04:55,160
لكن تِلك هي لعنة بالال

42
00:04:55,160 --> 00:04:57,220
الجنزير الذي يقيّد البشريّة

43
00:04:58,890 --> 00:05:04,080
لكن رغم ذلك، يستخدم النّاس أياديهم
ليمسكوا بأيدي بعضهم لا ليسبّبوا الألم

44
00:05:04,080 --> 00:05:05,700
يمسكون بأيدي بعضهم؟

45
00:05:05,700 --> 00:05:09,940
كلمات شخص لم يتعرّض لاضطهاد لسببٍ غير منصف

46
00:05:14,700 --> 00:05:17,870
!لا أفهم ما تقولينه إطلاقاً

47
00:05:19,840 --> 00:05:20,800
ماذا؟

48
00:05:30,920 --> 00:05:32,200
...لكن، مع ذلك

49
00:05:33,290 --> 00:05:37,050
أنا متأكّدة أنّني أتفهّم مشاعرك

50
00:05:37,430 --> 00:05:44,520
لا يجوز أن تصنعي مستقبلاً لا يؤذي النّاس فيه
بعضهم الآخر من خلال أذيّة شخص اليوم

51
00:05:44,880 --> 00:05:46,190
...أنتِ

52
00:05:51,650 --> 00:05:53,440
!أنتِ تسلّينني بهذا الكلام

53
00:05:58,230 --> 00:05:59,550
!يا للهول

54
00:05:59,550 --> 00:06:00,650
!هنا

55
00:06:12,210 --> 00:06:15,920
أعلم أنّنا لا نستطيع بلوغ السّماوات معاً

56
00:06:17,760 --> 00:06:20,010
...لكن حتّى لو لم نستطع

57
00:06:20,010 --> 00:06:21,300
!لا تكوني مغرورة

58
00:06:22,530 --> 00:06:27,120
اليد التي تصنع الغد هي دوماً قبضة غضب

59
00:06:29,660 --> 00:06:31,820
لا جدوى من الكلام

60
00:06:31,820 --> 00:06:34,040
سننهي هذا لاحقاً أيّتها السيمفوغير

61
00:06:35,530 --> 00:06:37,710
أتتخلّين عن المهمّةِ الآن؟

62
00:06:38,240 --> 00:06:40,320
ماذا تفعلين يا سان جيرمان؟

63
00:06:40,320 --> 00:06:41,860
أهذه غلطتي؟

64
00:06:41,860 --> 00:06:44,310
!إن كان كذلك فآسفة! آسفة جدّاً

65
00:06:53,730 --> 00:06:57,940
هدف متنوّري بافاريا هو السّيطرة
على الآثار القمريّة

66
00:06:58,340 --> 00:07:01,760
يحتاجون لما يُطلِقون عليه بـ"قوّة الآلهة" كي يفعلوها

67
00:07:01,760 --> 00:07:05,020
ويحاولون تحويل طاقة الحياة إلى ذلك؟

68
00:07:05,610 --> 00:07:10,860
حتّى لو صحَّ ذلك، إذا كانت هجمة واحدة من هيبيكي
تستطيع تدميرها فهذا غير ممكن

69
00:07:10,860 --> 00:07:15,040
...إنّه على الأرجح شيء أوسع بكثير

70
00:07:15,040 --> 00:07:19,780
أين وكيف يتمّ الحصول على ذلك المستوى
...من طاقة الحياة

71
00:07:20,350 --> 00:07:21,930
هل يُعقَل أن تكون خطوط لاي؟

72
00:07:21,930 --> 00:07:23,110
ماذا؟

73
00:07:24,300 --> 00:07:28,080
خطوط لاي التي استخدمتها كارول
عند تشريح العالم

74
00:07:28,080 --> 00:07:32,620
إذا استطاعوا استخراج طاقة الكوكب
...من خلال خطوط لاي

75
00:07:33,090 --> 00:07:37,460
كان متنوّرو بافاريا متورّطين في بناء
تشاتو دي تيفوغيس

76
00:07:37,870 --> 00:07:40,160
من غير المرجَّح أن تكون صدفة

77
00:07:40,570 --> 00:07:46,350
سأتّصل بالجينجا هونتشو وأطلب التّعاون
من كافّة مراصد خطوط لاي

78
00:07:46,350 --> 00:07:47,510
جيّد

79
00:07:47,800 --> 00:07:50,400
يبقى الآن سؤال واحد وهو ما أخبار القابِضات؟

80
00:07:50,930 --> 00:07:53,860
...عَمِلَ عقار الواصل بشكلٍ سليم على ما يبدو، لكن

81
00:07:58,310 --> 00:07:59,690
أنا آسفة

82
00:08:00,580 --> 00:08:05,700
...خاطرتما بحياتكما لصنع الواصل، لكنّنا

83
00:08:07,090 --> 00:08:09,020
أنا كذلك

84
00:08:09,500 --> 00:08:12,860
ظننتُ أنّني ما دمتُ أستطيع القتال فسوف
تفلح الأمور بطريقةٍ ما

85
00:08:13,320 --> 00:08:15,300
لكن كنتُ ساذجة

86
00:08:16,100 --> 00:08:17,260
!اللّعنة

87
00:08:17,880 --> 00:08:19,390
ما الأمر؟

88
00:08:21,510 --> 00:08:24,530
حجر الفيلسوف يُلغي وحدات إغنايت الخاصّة بهن

89
00:08:24,530 --> 00:08:27,710
علينا أن نبحث عن طريقةٍ للتعامل
مع ذلك وبسرعة

90
00:08:28,230 --> 00:08:29,730
ماذا تفعل إيلفناين-كن؟

91
00:08:30,240 --> 00:08:34,580
أخبرتُها أن تهتمّ بنفسها، لكنّها ما زالت
...تعمل في المختبر

92
00:08:37,030 --> 00:08:43,320
آمنتُ بأنّكِ ستكونين بخير، لكن لم يرد في نشرة
الأخبار أي تفاصيل، لذلك قلقت

93
00:08:43,800 --> 00:08:48,920
...هل سيفي هذا بالغرض؟ والآن أضيفي الحليب

94
00:08:49,340 --> 00:08:51,330
!اليوم عودتي بعد آخر مرّة

95
00:08:51,330 --> 00:08:54,550
!كنتُ أدرس حول كيفيّة فعلها سرّاً

96
00:08:55,270 --> 00:08:56,390
...ميكو

97
00:08:57,870 --> 00:09:03,770
عندما ترغبين شيئاً فهل هذا يعني التخلّي
عن شيء آخر؟

98
00:09:06,400 --> 00:09:11,340
هل جعل كلّ شيء يسير على ما يُرام
فحسب هو رغبة أنانيّة؟

99
00:09:13,590 --> 00:09:16,690
تعجبينني عندما تكونين أنانيّة يا هيبيكي

100
00:09:19,370 --> 00:09:24,740
عندما كنتُ أحاول تحسين الوقت الخاص
،بالعُدُو القصير لديّ في المدرسة الإعداديّة

101
00:09:24,740 --> 00:09:27,100
كان الجميع حولي منافسين

102
00:09:27,100 --> 00:09:30,790
لم يكن من السّهل التّفكير في أي شيء آخر

103
00:09:42,570 --> 00:09:45,040
...القليل فقط

104
00:09:46,590 --> 00:09:50,040
!هيبيكي! ماذا تفعلين؟ هذا خطير

105
00:09:50,040 --> 00:09:52,350
!أنا بخير

106
00:09:59,260 --> 00:10:00,800
!شكراً لكِ يا آنسة

107
00:10:00,800 --> 00:10:02,030
شكراً

108
00:10:02,030 --> 00:10:03,590
شكراً جزيلاً لكِ

109
00:10:04,980 --> 00:10:06,360
هل أنتِ بخير؟

110
00:10:06,360 --> 00:10:09,330
أجل. كان هناك طفل يبكي

111
00:10:09,330 --> 00:10:11,320
لذلك بذلتُ مجهوداً كبيراً زيادة على ما أعتقد

112
00:10:11,670 --> 00:10:14,630
قاتل      لصّ     اخرج

113
00:10:18,200 --> 00:10:21,360
،رغم حاجتها للبكاء أكثر من أي شخص آخر

114
00:10:21,360 --> 00:10:23,380
...حاجتها لأن ينقذها شخص ما

115
00:10:24,390 --> 00:10:27,780
لكن ما زالت تتصرّف بتهوُّر في محاولةٍ
منها لمساعدة الآخرين

116
00:10:28,870 --> 00:10:32,360
...لم أرد رؤية أحد آنذاك

117
00:10:32,690 --> 00:10:37,950
لكن كان الأمر مختلفاً عندما رأيتها بينما
كانت تمشي أمامي

118
00:10:39,320 --> 00:10:42,120
في ذلك اليوم، أدركتُ أنّني لم أرد

119
00:10:42,120 --> 00:10:46,000
أن ألتقي بأحد آخر سوى المشي برفقتهن للأبد

120
00:10:47,220 --> 00:10:52,340
وعندما تخرّجتُ من الإعداديّة، تركتُ فريق المضمار

121
00:10:53,950 --> 00:10:58,440
أنا متأكّدة أنّني لن أخبر أحداً عن مشاعري إطلاقاً

122
00:10:58,930 --> 00:11:02,290
،لكن أردتُ إضفاء شكل لمشاعري

123
00:11:02,290 --> 00:11:05,150
لذا قرّرتُ أن أتعلّم العزف على البيانو يوماً ما

124
00:11:07,080 --> 00:11:08,980
شكراً على الطعام

125
00:11:08,980 --> 00:11:10,940
على الرّحب والسّعة

126
00:11:20,490 --> 00:11:21,880
هيبيكي

127
00:11:23,120 --> 00:11:27,890
...إذا كان القيام بما تريدين فعله يجعلكِ أنانيّة

128
00:11:27,890 --> 00:11:30,840
فسوف أساندكِ في هذه الأنانيّة

129
00:11:31,490 --> 00:11:36,920
أنا متأكّدة أنّ أنانيّتك هي يد تبسطينها
لمساعدة المحتاجين

130
00:11:36,920 --> 00:11:38,240
...ميكو

131
00:11:39,200 --> 00:11:40,510
!شكراً لكِ

132
00:11:44,050 --> 00:11:48,520
جمعتُ كلّ ما وجدت من كتُب عن التكنولوجيا
...الهرطقيّة، لكن

133
00:11:49,100 --> 00:11:52,140
إذا احتجتِ لأي شيء آخر، فاطلبي فحسب

134
00:11:52,140 --> 00:11:54,210
...حسناً. شكراً لك

135
00:11:54,910 --> 00:11:56,030
هل أنتِ بخير؟

136
00:11:56,780 --> 00:11:58,760
هل أنتِ متأكّدة أنّكِ لا تُنهكين نفسكِ؟

137
00:11:58,760 --> 00:12:00,780
أنا آسفة

138
00:12:00,780 --> 00:12:04,960
لكن... هذا الجسد قد أعطِيَ لي بواسطة كارول

139
00:12:04,960 --> 00:12:06,780
كلتانا واحد

140
00:12:06,780 --> 00:12:09,200
لهذا عليّ أن أعمل بجدٍّ مكافئ لِكِلتينا

141
00:12:12,990 --> 00:12:13,990
ما الأمر؟

142
00:12:14,970 --> 00:12:16,220
...هذا

143
00:12:22,610 --> 00:12:25,580
قلتُ ذلك، أجل

144
00:12:25,970 --> 00:12:28,420
قلتُ أن تدمِّرن السيمفوغير

145
00:12:28,420 --> 00:12:30,340
أنا آسفة

146
00:12:31,110 --> 00:12:33,750
اعترضت طريقنا عندما كانت الأمور تسير على ما يُرام

147
00:12:33,750 --> 00:12:35,180
لا تروقني

148
00:12:35,180 --> 00:12:38,380
!أسمعكن يا خيميائيّات النخب الثالث

149
00:12:38,380 --> 00:12:40,910
!لن أدعكن توجِّهن أي إهانة لآدم

150
00:12:42,200 --> 00:12:44,830
أخيراً، بات التوجُّه مكشوفاً لنا

151
00:12:45,340 --> 00:12:48,120
في الطّالِع الذي أنشأته تيكي

152
00:12:49,360 --> 00:12:52,370
إذاً سنؤدّي الطقوس لوضع المذبح

153
00:12:54,460 --> 00:12:58,280
هل نمسك بقوّةِ الآلهة بأيدينا؟

154
00:12:59,720 --> 00:13:01,670
!تيكي تحلِّق

155
00:13:02,550 --> 00:13:05,260
...لبناء عالم مثاليّ

156
00:13:10,360 --> 00:13:11,610
لا يعجبني هذا الرّجل إطلاقاً

157
00:13:12,280 --> 00:13:16,950
يزعجني أنّه هو من يدير المتنوّرين

158
00:13:16,950 --> 00:13:18,170
أجل

159
00:13:18,630 --> 00:13:23,900
لكننا لا نتبعه أو نتبع المتنوّرين

160
00:13:29,670 --> 00:13:30,940
...كلتاكما

161
00:13:31,980 --> 00:13:35,630
،إن كنّا لا نريد أن يتصرّف آدم بغرور

162
00:13:35,630 --> 00:13:37,510
فيجب علينا أن نصبِح جادّات

163
00:13:37,510 --> 00:13:42,280
لكن عليّ البدء بمراسم تنصيب المذبح

164
00:13:43,030 --> 00:13:48,040
إذاً اتركي تدمير السيمفوغير علينا

165
00:13:48,530 --> 00:13:49,570
ما الأمر؟

166
00:13:49,570 --> 00:13:51,980
تُرِكَتْ هذه النّفايات بعد

167
00:13:51,980 --> 00:13:57,180
انصهار هيبيكي مع الغانغنير فأصبحا مُفاعِلاً نوويّاً حيّاً

168
00:13:57,770 --> 00:14:00,580
تلك القشرة؟

169
00:14:00,580 --> 00:14:04,940
لكن قيلَ لي أنّه لم يكن يمتلك قوّة
بارزة بحدِّ ذاتها

170
00:14:04,940 --> 00:14:09,910
صُنِع حجر الفيلسوف بواسطةِ استعراض العالم
بأسرِه ككائن حيّ عظيم واحد

171
00:14:09,910 --> 00:14:15,340
لكن هذه القمامة قد صُنِعَتْ من كائن حيّ
ضئيل واحد: هيبيكي-سان

172
00:14:15,340 --> 00:14:18,490
بصيغة أخرى، كلاهما صُنِعا بأسلوبين معاكسين تماماً

173
00:14:18,810 --> 00:14:21,990
مشروع تعزيز قوّة السيمفوغير الذي أقترحه

174
00:14:21,990 --> 00:14:25,480
يسخِّر الخصائص المتعاكِسة لهذه القمامة حرفيّاً

175
00:14:25,480 --> 00:14:29,000
لإبطالِ قوى حجر الفيلسوف

176
00:14:29,000 --> 00:14:32,060
!بمفهوم آخر، إنّه غِلاف حاجِز ثنائي الإبادة

177
00:14:32,400 --> 00:14:33,680
تماماً

178
00:14:33,680 --> 00:14:37,690
استُمِدَّتْ هذه الإجابة من مبادئ الخيمياء

179
00:14:37,690 --> 00:14:40,650
الرئيسيّة للعالَم الأكبر والعالَم الأصغر

180
00:14:41,310 --> 00:14:43,820
...أتمنّى لو يشرح لي أحدهم

181
00:14:43,820 --> 00:14:46,980
لكن أشكُّ في أنّنا سنفهم الشرح

182
00:14:46,980 --> 00:14:53,460
إذا كان ذلك الشيء قد خرج من غبيّة
فلا بدّ أنّ اسمه هو حجر الأحمق إذاً

183
00:14:53,460 --> 00:14:56,330
كلمة "أحمق" قاسية يا كريس-تشان

184
00:14:57,140 --> 00:15:01,280
هكذا إذاً. حجر الأحمق الذي يعترض طريق
حجر الفيلسوف

185
00:15:02,050 --> 00:15:04,150
حتّى أنت يا سيّدي؟

186
00:15:04,770 --> 00:15:07,380
حسناً، أين هو هذا الحجر؟

187
00:15:07,380 --> 00:15:11,460
بعد أن تمَّ تحليله، اعتُبِر عيّنة غير ضروريّة

188
00:15:11,460 --> 00:15:14,400
وأخفي في قصرِ التنّين تحت البحر
في أعماق المحيط

189
00:15:19,000 --> 00:15:24,300
سيكون البحث عن حجرِ الأحمق بمثابة البحث عن حبّة
ذهب في وسطِ الوحل

190
00:15:24,830 --> 00:15:27,030
سيستغرق هذا بعضاً من الوقت، لكن أعتمِد عليكن

191
00:15:27,030 --> 00:15:28,120
عُلِم

192
00:15:31,570 --> 00:15:32,960
يا إلهي

193
00:15:32,960 --> 00:15:36,030
مزدحم أكثر مما توقّعت

194
00:15:40,730 --> 00:15:41,800
...ثمّ

195
00:15:45,100 --> 00:15:46,760
...ثمّ في فالفيردي

196
00:15:48,500 --> 00:15:52,770
بالتفكير في الماضي، لعلَّ كانت هناك طريقة
أكثر هدوءاً للقيام بالأعمال

197
00:16:09,910 --> 00:16:12,810
يمكننا استخدام هذه حقّاً لإيجاده، صحيح؟

198
00:16:19,500 --> 00:16:21,430
!تمّ رصد إشارات نويز آلكا

199
00:16:21,430 --> 00:16:23,370
جاري تضييق نطاق الإحداثيّات

200
00:16:23,370 --> 00:16:24,360
...العدوّ

201
00:16:25,580 --> 00:16:27,170
فوقنا مباشرة؟

202
00:16:27,570 --> 00:16:28,430
...أيُعقَل أنّه

203
00:16:28,430 --> 00:16:30,470
انتظرونا حتّى نغادر؟

204
00:17:13,800 --> 00:17:15,550
α أسلوب سامسارا 100

205
00:17:23,240 --> 00:17:25,520
لا تقلقوا! أسرعوا وأخلوا

206
00:17:25,850 --> 00:17:28,690
هل أنتِ متأكّدة من سلامة ذلك؟

207
00:17:28,690 --> 00:17:30,290
!أيّتها الفتاة المهملة

208
00:17:30,290 --> 00:17:32,140
من تنعتينها بالمهملة؟

209
00:17:32,140 --> 00:17:33,920
!أنتِ بالطبع

210
00:17:40,270 --> 00:17:42,580
بئساً! غلطة من هذه؟

211
00:17:50,020 --> 00:17:51,130
—كيري-تشان! كريس

212
00:17:54,590 --> 00:17:59,850
من دون داينسليف، السيمفوغير ضعيفات حقاً

213
00:17:59,850 --> 00:18:02,430
سندمّركما هنا

214
00:18:03,160 --> 00:18:05,540
أيحاولون تدمير السيمفوغير؟

215
00:18:05,540 --> 00:18:07,550
ليس حجر الأحمق؟

216
00:18:07,550 --> 00:18:10,180
!إذاً لنستخدم كلّ قوانا

217
00:18:11,740 --> 00:18:13,940
!هيّا

218
00:18:14,640 --> 00:18:16,980
!تتعرّض مُنشأة السطح لهجوم

219
00:18:16,980 --> 00:18:17,860
ماذا؟

220
00:18:17,860 --> 00:18:19,640
!سنصعد للسطح حالاً

221
00:18:19,640 --> 00:18:21,830
!استمررن في العمل

222
00:18:22,360 --> 00:18:25,400
يبدو أنّهم لا يعلمون بشأن حجر الأحمق

223
00:18:26,720 --> 00:18:30,740
إذا اكتشفوا بأمر الجهود المبذولة لاسترجاع
الحجر، فقد يعيقونها

224
00:18:30,740 --> 00:18:33,980
...لكن أمام حجر الفيلسوف

225
00:18:33,980 --> 00:18:38,500
التّناغم. إذا استطعنا دمج أغنيتَي
...كيريكا-سان وشيرابي-سان

226
00:18:38,920 --> 00:18:41,270
!يمكنهن القتال من دون الحاجة لإشهار السّيوف

227
00:18:41,880 --> 00:18:45,030
!إذاً سأمهِّد طريقاً لهُن

228
00:18:46,710 --> 00:18:48,670
!شجاعة

229
00:19:00,070 --> 00:19:02,320
!قريبة بما يكفي لقبلة

230
00:19:02,320 --> 00:19:05,450
لكن شفتَيّ ليس من السّهل سرقتها

231
00:19:06,870 --> 00:19:08,110
!ابقي قلبي النّابض

232
00:19:13,210 --> 00:19:15,880
!حسناً، لنفعلها

233
00:19:16,390 --> 00:19:17,630
!كيري-تشان

234
00:19:28,600 --> 00:19:29,890
حلقة تينكر بيل الكارثيّة

235
00:19:47,920 --> 00:19:51,260
التضخيم الصوتي لشيرابي-تشان وكيريكا-تشان
يتزايد بدرجة كبيرة

236
00:19:51,260 --> 00:19:52,990
...بهذا المستوى من القوّة

237
00:19:57,840 --> 00:20:01,210
...لم نكن سوى مجرّد مزيّفتين عديمتي القيمة

238
00:20:01,980 --> 00:20:08,480
لكن منحتنا سان جيرمان جسدين مثاليّين
وحكمة حقيقيّة ومبادئ فكريّة

239
00:20:09,300 --> 00:20:13,060
!لذا لأجلها... لن نخسر

240
00:20:13,060 --> 00:20:14,440
بريلاتي؟

241
00:20:17,390 --> 00:20:22,480
لا يمكنكِ تحقيق مبادئكِ الفكريّة بمجرّد
تصرّفات مُسلِّية مُرضية

242
00:20:35,360 --> 00:20:37,040
!لأجل مبادئي الفكريّة

243
00:20:41,300 --> 00:20:42,260
ماذا؟

244
00:20:48,070 --> 00:20:49,950
هذا يكفي لليوم

245
00:20:59,900 --> 00:21:02,190
...أيدينا تتشابك

246
00:21:02,190 --> 00:21:04,340
ولن نفلت أبداً

247
00:21:04,860 --> 00:21:07,440
افعلا هذا في مكان خاص

248
00:21:07,780 --> 00:21:09,570
نجحن

249
00:21:09,570 --> 00:21:12,260
أجل. لهذا اليوم فقط

250
00:21:21,130 --> 00:21:26,120
يبدو أنّ طقوس تنصيب المذبح تسير على ما يُرام

251
00:21:26,120 --> 00:21:27,170
أجل

252
00:21:27,170 --> 00:21:28,490
...لكن

253
00:21:28,490 --> 00:21:33,310
نفتقر للطاقة المطلوبة لتأسيس مذبح
القيادة المركزيّة الأعظم

254
00:21:33,980 --> 00:21:36,930
إذاً استخدمي قرباناً

255
00:21:37,850 --> 00:21:40,310
واحدة منهما

256
00:21:41,030 --> 00:21:46,220
...ينبغي لهذا أن يعوّض الفارق بسلاسة

257
00:21:46,220 --> 00:21:50,280
طاقة الحياة التي تنبع من جسدٍ كامل

258
00:21:50,740 --> 00:21:55,660
حضرة المُدير... إلى أي درجة تفتقر للإنسانيّة؟

259
00:21:55,660 --> 00:22:00,140
أعتقد حان الوقت لتختاري عدالتكِ