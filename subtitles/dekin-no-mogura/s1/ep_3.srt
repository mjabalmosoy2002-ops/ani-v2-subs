1
00:01:38,230 --> 00:01:41,020
!آسف، لكن تلك الأنواع هي الأكثر رعباً

2
00:01:41,020 --> 00:01:43,490
سواء كانوا أمواتاً أو أحياء، النّفسيّون
!شديدو التعلُّق مُخيفون

3
00:01:43,490 --> 00:01:45,930
أعتقد يعتمد الأمر على حسب
!حياتهم الّتي عاشوها

4
00:01:45,930 --> 00:01:49,380
!لذا بشكل عامّ، أرواح كافّة النّساء مُرعبة

5
00:01:49,630 --> 00:01:50,530
!هكذا إذاً

6
00:01:50,530 --> 00:01:51,400
!أعترض

7
00:01:51,400 --> 00:01:53,080
!أعتقد بأنّ هذا يعتمد على الشّخص

8
00:01:53,080 --> 00:01:54,640
!أجل، أجل

9
00:01:54,640 --> 00:01:56,260
آسف

10
00:01:56,260 --> 00:01:59,010
!انتظروا! انتظروني

11
00:01:59,910 --> 00:02:00,900
!اهربوا

12
00:02:00,900 --> 00:02:03,100
!اهربوا إلى مزار أو ما شابه

13
00:02:03,100 --> 00:02:05,120
هل سينفع ذلك؟

14
00:02:05,120 --> 00:02:09,700
ربّما لا، لكنّه يؤدّي أحياناً وظيفة نقاط حفظ

15
00:02:09,700 --> 00:02:10,980
لستَ متأكّداً؟

16
00:02:11,360 --> 00:02:13,880
،حالما تتفعّل حساسيّتك الماورائيّة

17
00:02:13,880 --> 00:02:15,530
فإنّك تكون أكثر إحساساً للأذى الرّوحانيّ أيضاً

18
00:02:16,570 --> 00:02:17,670
الأذى الرّوحانيّ؟

19
00:02:17,670 --> 00:02:20,660
الأمراض والحوادث الّتي تُسبّبها الأرواح

20
00:02:20,660 --> 00:02:21,890
!لا سيّما أنت يا ماغي

21
00:02:21,890 --> 00:02:24,280
اللّطيفون لكن مُتوتّري الأعصاب أمثالك

22
00:02:24,280 --> 00:02:26,460
يُعانون فوراً عندما يُمَسّون بواسطة
!مثل هذه الأرواح

23
00:02:26,460 --> 00:02:27,870
!انتظروا

24
00:02:26,710 --> 00:02:27,870
!لا أريد

25
00:02:29,670 --> 00:02:31,910
لن تتوقّف القطط عن المواء

26
00:02:31,910 --> 00:02:34,340
إنّها تُضفي المزيد إلى الأجواء المُخيفة

27
00:02:34,740 --> 00:02:36,460
القطط مخلوقات حسّاسة

28
00:02:36,710 --> 00:02:39,030
...لكن هذا المستوى من الانفعال

29
00:02:39,640 --> 00:02:42,250
قد نحظى باستراحة حظّ

30
00:02:42,250 --> 00:02:44,490
!اتبعوا القطط الّتي تموء

31
00:02:52,610 --> 00:02:53,930
حسناً، إنّه موغورا دون سواه

32
00:02:54,460 --> 00:02:56,110
ما الّذي تنوي له؟

33
00:02:57,150 --> 00:03:00,380
كيو-تشان، عرفتُ بأنّك قريب

34
00:03:00,380 --> 00:03:01,880
في طريق عودتك من طرد أرواح؟

35
00:03:02,750 --> 00:03:05,700
.ظننتُ بأنّني شعرتُ بشيء غريب
لا بُدّ أنّه هذا

36
00:03:08,130 --> 00:03:10,410
روح المُلاحق تنكمش لسبب ما

37
00:03:10,410 --> 00:03:12,110
!من فضلك يا كيو-تشان

38
00:03:12,110 --> 00:03:13,250
من فضلك ماذا؟

39
00:03:13,520 --> 00:03:15,830
أخبرني ما الّذي تريد أن تفعله

40
00:03:15,830 --> 00:03:18,210
لم أفهم شيئاً ممّا تقول يوماً

41
00:03:18,210 --> 00:03:19,160
ماذا؟

42
00:03:21,090 --> 00:03:24,570
هل تشبّث بكم هذا الشّيء؟

43
00:03:24,570 --> 00:03:25,720
مساكين

44
00:03:25,940 --> 00:03:27,720
تعرف هذا الشّخص؟

45
00:03:27,720 --> 00:03:30,680
شخص؟ إنّه ليس شخصاً

46
00:03:32,110 --> 00:03:35,460
إنّه مخلوق شبه بشريّ يُعاقَب
على أخطائه

47
00:03:35,460 --> 00:03:39,250
البشريّ يُرسَل في العادة إلى الجحيم
بسبب ارتكابه خطأ

48
00:03:39,250 --> 00:03:41,860
.ليس عليك قول ذلك في وجهي
أنا شخصٌ حاليّاً

49
00:03:41,860 --> 00:03:44,020
أعمل على ذلك شيئاً فشيئاً

50
00:03:44,020 --> 00:03:46,180
اصمت أيّها الثّرثار

51
00:03:46,180 --> 00:03:48,950
أنت. تبدو لطيفاً، لذا سأخبرك بشيء

52
00:03:49,280 --> 00:03:51,300
،لا أعرف ما الّذي قاله لك

53
00:03:51,300 --> 00:03:54,990
لكن لا شيء حميد ستحظى به من الارتباط
بأشباه بشريّين مُريبين

54
00:03:55,460 --> 00:03:58,460
ليس ذلك فقط، لكنّه ضحيّة صدمة
نفسيّة نمطيّة

55
00:03:58,740 --> 00:04:02,380
لا حاجة لاتّخاذ نوبات الكآبة الشّديدة
لهذا المخلوق المُحطَّم

56
00:04:02,380 --> 00:04:04,180
والسّلوك المُتطرّف بجدّية

57
00:04:04,180 --> 00:04:07,440
إنّه يخبر الجميع عن صدمته النّفسيّة

58
00:04:07,440 --> 00:04:10,150
إنّه نصّاب ينجو بالتزلُّف للنّاس

59
00:04:10,150 --> 00:04:11,680
هذا قاسٍ جدّاً

60
00:04:11,910 --> 00:04:14,360
على أيّ حال، هذا نيكوزوكو كيوشيرو

61
00:04:14,360 --> 00:04:15,810
سيطرد هذه الرُّوح لأجلنا

62
00:04:15,810 --> 00:04:17,480
هذان ماغي وياي-تشان

63
00:04:17,890 --> 00:04:20,070
رأيت؟ إنّه هكذا دوماً

64
00:04:20,070 --> 00:04:22,110
إنّه يستثني كثيراً من المعلومات

65
00:04:23,100 --> 00:04:23,930
—أنا

66
00:04:23,930 --> 00:04:25,360
أعرف من تكونين

67
00:04:25,610 --> 00:04:27,410
أنتِ سنة أولى، إينوكاي، العِرضة للمسّ

68
00:04:27,780 --> 00:04:30,020
أجل! أنا إينوكاي شيو

69
00:04:31,030 --> 00:04:35,870
شيو-تشان، لا ينبغي أن تستجيبي
لكلّ شيء بشكل تلقائيّ

70
00:04:36,230 --> 00:04:39,200
ماذا؟ هناك تطابُق بين زيّكما

71
00:04:39,200 --> 00:04:41,090
...معك حقّ. هذا يعني

72
00:04:41,410 --> 00:04:42,470
!حسناً

73
00:04:42,470 --> 00:04:45,400
المزيد من النّاس الّذين أستطيع استعارة
!كُتُب منهم عندما أنسى كتُبي

74
00:04:45,400 --> 00:04:46,840
أنا طالب سنة ثالثة

75
00:04:46,840 --> 00:04:48,570
لا، شيو-تشان

76
00:04:48,570 --> 00:04:52,890
جميعنا مصدومون لأنّ طارد الأرواح
هو تلميذ مدرسة ثانويّة

77
00:04:52,890 --> 00:04:54,280
صحيح

78
00:04:54,280 --> 00:04:56,150
لن نصل إلى نتيجة هكذا

79
00:04:56,150 --> 00:04:59,370
على أيّ حال، فهمتَ الفكرة، هل يمكنك
التّعامل مع تلك الرُّوح؟

80
00:04:59,370 --> 00:05:01,150
لا، لم أفهم الفكرة

81
00:05:01,460 --> 00:05:03,360
دعني أراجع الوضع

82
00:05:03,360 --> 00:05:06,090
لا أعرف السّبب، لكن التقيتَ
بهؤلاء بطريقة ما

83
00:05:06,090 --> 00:05:08,860
ليس ذلك فحسب، لكن عرّضتهم للأذى الرّوحانيّ

84
00:05:08,860 --> 00:05:10,910
وحتّى أنّك أقحمت إينوكاي في الأمر

85
00:05:11,160 --> 00:05:14,730
والآن تريدني أن أصلح كلّ شيء لأجلك

86
00:05:14,730 --> 00:05:15,750
هل أصبتُ بكلامي؟

87
00:05:15,750 --> 00:05:16,790
أجل

88
00:05:16,790 --> 00:05:17,690
مُت

89
00:05:17,690 --> 00:05:19,670
لا أستطيع. هذه هي المُشكلة برمّتها

90
00:05:21,390 --> 00:05:24,660
دعني أحصل على مُوافقتها أوّلاً

91
00:05:24,660 --> 00:05:27,110
إينوكاي، ينبغي أن أطردك روحيّاً؟

92
00:05:27,110 --> 00:05:28,470
ماذا؟

93
00:05:28,470 --> 00:05:30,600
أقصد... ربّما

94
00:05:30,600 --> 00:05:32,470
،لمعلوماتك

95
00:05:32,700 --> 00:05:35,990
تستغلّ الرّوح الظّرفَ لمُضايقتك
جنسيّاً بشكل جنونيّ

96
00:05:35,990 --> 00:05:38,080
يمكنك تجاهلها بما أنّك لا تستطيعين
رؤيتها على أيّ حال

97
00:05:38,080 --> 00:05:39,400
!تخلّص منها أرجوك

98
00:05:44,990 --> 00:05:46,030
أين الرُّوح؟

99
00:05:52,290 --> 00:05:54,750
الرّوح جريحة جسديّاً؟

100
00:05:54,750 --> 00:05:57,370
...أتفهّم بأنّك مُدهش، لكن

101
00:05:59,020 --> 00:06:00,830
...على أيّ حال

102
00:06:02,380 --> 00:06:06,260
،هذا الشّخص أصغر حجماً وسنّاً منّي
لكنّه مُخيف بشكل غريب

103
00:06:06,260 --> 00:06:07,330
ما الّذي يجري؟

104
00:06:08,680 --> 00:06:10,720
...وهذا الضّجيج الغريب

105
00:06:11,120 --> 00:06:14,100
استخدم عينيك، لا رأسك. سيكون ذلك أسرع

106
00:06:14,100 --> 00:06:16,930
انظر عن كثب. عن كثب فعليّاً

107
00:06:16,930 --> 00:06:17,850
ألا يمكنك رؤيته؟

108
00:06:18,780 --> 00:06:22,230
هذا هو ثمن الاستحواذ على قوّة عظيمة

109
00:06:23,020 --> 00:06:25,110
هذا مؤلم

110
00:06:26,890 --> 00:06:28,780
رائحتك كريهة. فمك كريه

111
00:06:28,780 --> 00:06:31,620
حسناً، أعتقد بأنّ بعض الأشخاص
يشعرون بالغيرة

112
00:06:31,930 --> 00:06:33,830
الغيرة من ماذا؟

113
00:06:33,830 --> 00:06:36,190
إنّه يسرق مُكوّناتي الغذائيّة، لذا
لا أستطيع أن أسمن

114
00:06:36,190 --> 00:06:37,820
وتظهر هذه الانتفاخات تحت عينَي

115
00:06:37,820 --> 00:06:38,960
هذا سيّئ

116
00:06:40,890 --> 00:06:43,920
هيّا يا نابيشيما. حان وقت التّحلية

117
00:06:49,350 --> 00:06:50,840
إنّه ممسوس بواسطة باكينيكو

118
00:07:02,980 --> 00:07:04,520
لقد تقيّأ

119
00:07:06,540 --> 00:07:09,450
أعتقد هذا يتفوّق على ابتلاعه بشكل كامل

120
00:07:09,690 --> 00:07:11,910
والآن لن يتمكّن من الحركة لبعض الوقت

121
00:07:11,910 --> 00:07:15,370
شخص من الحياة الآخرة سيُلاحظ
الفوضى ويأتي ليأخذه قريباً

122
00:07:15,370 --> 00:07:17,370
سندعهم يعالجون الباقي

123
00:07:17,740 --> 00:07:20,210
هكذا تُمارس عائلة نيكوزوكو طرد الأرواح

124
00:07:20,500 --> 00:07:23,720
كانوا ممسوسين بواسطة باكينيكو لأجيال

125
00:07:23,720 --> 00:07:28,480
كاختصاصيّ في الأدب، أنا متأكّد بأنّكم
تعلمون بأنّهم ما زالوا مكروهين ومُهابين

126
00:07:28,480 --> 00:07:31,710
حوّلتْ عائلة نيكوزوكو ذلك
إلى طريقة لجني المال

127
00:07:31,710 --> 00:07:32,980
إنّهم طاردو أرواح شرّيرة

128
00:07:32,980 --> 00:07:35,180
يُقاتلون النّار بالنّار

129
00:07:35,460 --> 00:07:37,990
لكن طرد روح شرّيرة بواسطة رئيس
العائلة يُكلّف الكثير

130
00:07:37,990 --> 00:07:40,420
في هذه الأثناء، لا يزال كيو-تشان مُتدرّباً

131
00:07:40,420 --> 00:07:42,000
سيهزم الأرواح مجّاناً

132
00:07:42,000 --> 00:07:44,150
تعرف الكثير من الخدمات المجّانيّة

133
00:07:44,150 --> 00:07:46,390
أنا "لا أهزم" الأرواح

134
00:07:46,390 --> 00:07:49,110
لا بدّ أنّ شخصاً يُزعجك على تفكيرك هذا

135
00:07:49,110 --> 00:07:50,520
معك حقّ

136
00:07:50,520 --> 00:07:53,720
لن تستمتع بحسّ العدالة عندما تفعل ذلك

137
00:07:53,720 --> 00:07:54,490
آسف

138
00:07:54,790 --> 00:07:58,380
تُرضي القطط العظيمة وذلك
كي تضرب ضحاياك

139
00:07:58,380 --> 00:08:00,700
هذا هو أسلوب عائلة نيكوزوكو

140
00:08:01,010 --> 00:08:04,480
،إذا كانت الأرواح سيّئة الحظّ
فإنّها تُؤكَل أحياناً

141
00:08:04,480 --> 00:08:05,460
...بصيغة أُخرى

142
00:08:06,110 --> 00:08:08,810
إنّهم بارعون في التّعامل مع دُمى القطط؟

143
00:08:08,810 --> 00:08:09,530
هذا صحيح

144
00:08:09,530 --> 00:08:11,600
إنّهم غالباً مُدرِّبو حيوانات أليفة مشاهير

145
00:08:11,600 --> 00:08:12,930
على أيّ حال، هذا ما في الأمر

146
00:08:13,380 --> 00:08:15,060
سآخذ بعض النّيران من هذا الشّخص

147
00:08:15,610 --> 00:08:19,600
إنّه أشبه بالمرأة العجوز الّتي
تسرق شعراً في راشومون

148
00:08:19,600 --> 00:08:21,060
يبدو هذا عقيماً

149
00:08:22,300 --> 00:08:24,270
...فتيات

150
00:08:24,270 --> 00:08:26,100
لن يستسلم

151
00:08:26,100 --> 00:08:27,810
لم يحصل على مُواعدة في حياته غالباً

152
00:08:28,140 --> 00:08:30,550
!هيّا يا نابيشيما! اِلعب

153
00:08:39,170 --> 00:08:42,250
كيو-تشان، توخّ الحذر

154
00:08:42,250 --> 00:08:43,350
ستُفرِّق النّيران

155
00:08:43,350 --> 00:08:44,580
أي منطق هو هذا؟

156
00:08:44,820 --> 00:08:47,250
تحصل على توفو أكبر بغرفه
من القِدر بمِغرفة

157
00:08:47,250 --> 00:08:51,760
ثمّ تفتيته بمُحاولة التقاطه بعيدان طعام

158
00:08:51,760 --> 00:08:53,210
إنّه نفس الأمر

159
00:08:53,210 --> 00:08:56,220
أظنّني فهمتُ الأمر، لكن هل كانت
هذه هي طريقة التّشبيه الصّحيحة؟

160
00:08:56,220 --> 00:08:59,220
ما زال كيو-تشان لم يُتقن ذلك بعد

161
00:08:59,220 --> 00:09:02,280
رئيس عائلة نيكوزوكو يفعلها
بصورة أكثر أناقة

162
00:09:02,280 --> 00:09:03,230
!صحيح، هذا

163
00:09:03,460 --> 00:09:08,860
المعذرة، هل اسم أبيه هو نيكوزوكو
توشيرو بالمُناسبة؟

164
00:09:08,860 --> 00:09:10,930
ماذا؟ أنا مُتفاجئ بمعرفتك ذلك

165
00:09:10,930 --> 00:09:11,950
توقّعت

166
00:09:11,950 --> 00:09:14,440
نيكوزوكو هو اسم غير مألوف

167
00:09:14,440 --> 00:09:16,150
إنّه أستاذ في جامعتي

168
00:09:16,480 --> 00:09:19,730
إنّه يُعلّم أدبَ الخيال وهو مُستشار
حلقتي الدّراسيّة

169
00:09:19,730 --> 00:09:22,280
إنّه مُؤلّف خيال بحدّ ذاته

170
00:09:22,280 --> 00:09:24,080
يكتب روايات غامضة

171
00:09:24,080 --> 00:09:27,860
أسلوبه وتعابير وجهه الغريبة مُثيران للاهتمام

172
00:09:27,860 --> 00:09:29,960
لهذا تلقّيتُ إحدى دروسه

173
00:09:29,960 --> 00:09:31,650
مُؤلّف خيال؟

174
00:09:33,310 --> 00:09:36,590
توشيرو يُؤلّف روايات خيال؟

175
00:09:37,550 --> 00:09:39,650
هذه ليست روايات

176
00:09:39,650 --> 00:09:41,180
إنّها غالباً تجاربه الفعليّة

177
00:09:41,180 --> 00:09:43,220
عالم صغير؟

178
00:09:44,220 --> 00:09:45,430
رأيتما؟

179
00:09:45,430 --> 00:09:50,110
هناك غرابة أكبر تحيط بكما
أكثر ممّا تُدركان

180
00:09:56,610 --> 00:09:59,870
قلتُ من البداية بأنّكما تستطيعان
،تجاهل كلّ هذا

181
00:09:59,870 --> 00:10:01,830
،لكن الآن بعد أن عرفتما

182
00:10:02,530 --> 00:10:07,040
يمكنكما تغيير وجهة نظركما
والاستمتاع أكثر بالحياة

183
00:10:07,980 --> 00:10:10,670
!أنا الوحيدة الّتي لا أستطيع رؤية شيء

184
00:10:12,310 --> 00:10:15,200
حسناً، الحياة أسهل بالنّسبة لأمثالها

185
00:10:15,200 --> 00:10:16,470
أنتِ محظوظة لأنّكِ لا تستطيعين

186
00:10:16,470 --> 00:10:18,680
القطّ الضّخم مُخيف جدّاً في الواقع

187
00:10:18,680 --> 00:10:21,140
!أريد رؤية الباكينيكو

188
00:10:21,140 --> 00:10:26,060
على أيّ حال، هذا الوضع هو
مُعجزة القرن بالنّسبة لي

189
00:10:26,060 --> 00:10:28,030
شيو-تشان تُمَسّ بسهولة

190
00:10:28,030 --> 00:10:30,810
ربّما لا ينبغي أن أقولها، لكن
هذا ممتاز بالنّسبة لي

191
00:10:30,810 --> 00:10:34,330
ماغي وياي-تشان، أبلغاني إذا
رأيتُما أيّ شيء آخر

192
00:10:34,330 --> 00:10:36,160
كلاكما حسّاسان للغاية

193
00:10:36,160 --> 00:10:39,910
قلّة من النّاس لديهم دماغ وعينان
يستطيعون تقبُّل هذا بسرعة

194
00:10:39,910 --> 00:10:42,990
كيو-تشان، سأطلب منك مُعالجة
أيّ شيء لا أستطيع مُعالجته

195
00:10:42,990 --> 00:10:44,620
لا، لن تفعل

196
00:10:45,370 --> 00:10:47,160
نحن نُشكّل فريقاً ممتازاً

197
00:10:47,160 --> 00:10:48,750
،كدتُ أستسلم

198
00:10:48,750 --> 00:10:54,240
لكن لم ألتقِ أبداً بطاقم مثاليّ كلّه
دُفعة واحدة من قبل

199
00:10:54,240 --> 00:10:58,090
قد أجمع ما يكفي من نار
للعودة إلى الحياة الآخرة

200
00:10:58,090 --> 00:10:59,880
لديّ بعض الأمل الآن

201
00:11:00,900 --> 00:11:01,800
العودة؟

202
00:11:01,800 --> 00:11:05,410
هذا كلّ شيء لليوم. تأخّر الوقت

203
00:11:05,410 --> 00:11:07,190
ماذا؟ السّاعة 11 مساء؟

204
00:11:07,190 --> 00:11:09,620
يا للهول! سيجنّ جنون أمّي

205
00:11:10,110 --> 00:11:12,350
لديّ مقالة يجب أن أُسلّمها غداً

206
00:11:12,350 --> 00:11:14,060
ما خطبكم يا جماعة؟

207
00:11:14,790 --> 00:11:16,320
صباح الخير

208
00:11:18,040 --> 00:11:21,990
الأستاذ نيكوزوكو، أرسلتُ لك مقالتي للتو

209
00:11:21,990 --> 00:11:26,200
عشرون صفحة حول سبب احتواء أدب
الأطفال على عناصر رُعب كثيرة

210
00:11:26,200 --> 00:11:28,070
أجل، تلقّيتُها

211
00:11:28,780 --> 00:11:30,090
هل سهرت ليلة كاملة؟

212
00:11:30,090 --> 00:11:32,510
ماذا؟ أجل، هذا ما أعتقده

213
00:11:32,510 --> 00:11:33,930
هذا ليس جيّداً بالنّسبة لكما

214
00:11:33,930 --> 00:11:35,300
ينبغي أن تتوخّيا الحذر

215
00:11:35,300 --> 00:11:37,670
حسناً. أستأذن

216
00:11:37,670 --> 00:11:39,380
ماغي-كن، كيريهارا-سان

217
00:11:40,050 --> 00:11:44,390
ينبغي أن أحذّركما: ابتعدا عن شارع الدُّرج

218
00:11:44,390 --> 00:11:46,360
سيظلّ يسحبكما بشكل أعمق

219
00:11:57,230 --> 00:11:59,600
هذه ليست حياة سهلة

220
00:11:59,600 --> 00:12:01,110
تيبُّس الكتِفين فظيع جدّاً

221
00:12:02,190 --> 00:12:04,490
أعتقد سأعود إلى المنزل لليوم وأنام

222
00:12:07,430 --> 00:12:09,770
شكراً على السّماح لي باستخدام الواي فاي

223
00:12:09,770 --> 00:12:10,850
إطلاقاً

224
00:12:10,850 --> 00:12:13,450
نسيتُ بأنّه ليس لديك واي فاي
في مكانك يا موغورا

225
00:12:13,450 --> 00:12:15,750
إذاً هذه مُحاضرة عبر الإنترنت؟

226
00:12:16,000 --> 00:12:17,790
!إنّه توشيرو

227
00:12:18,300 --> 00:12:19,600
مرحباً

228
00:12:19,600 --> 00:12:22,410
اليوم أنا أعطي مُحاضرات من مُحافظة مي

229
00:12:22,410 --> 00:12:25,760
مي هو مسقط رأس إيدوغاوا رانبو

230
00:12:22,610 --> 00:12:25,760
يذهب الأستاذ نيكوزوكو في رحلات
بداعي العمل أحياناً

231
00:12:25,760 --> 00:12:27,890
يقدّم دروسه عبر الإنترنت عندما يفعل

232
00:12:26,060 --> 00:12:27,890
وُلِد رانبو فيما يُعرَف الآن بناباري

233
00:12:28,210 --> 00:12:31,610
أحياناً يسافر من أجل طرد الأرواح الشّرّيرة

234
00:12:28,410 --> 00:12:32,370
عندما بلغ الثّانية، انتقل إلى مدينة
كامياما وانتقل ثانية بعد ذلك

235
00:12:31,610 --> 00:12:34,060
إنّه مشهور وحديث النّاس

236
00:12:32,370 --> 00:12:34,840
ليتنقّل عدّة مرّات طوال حياته

237
00:12:34,060 --> 00:12:36,180
هكذا هو الأمر إذاً

238
00:12:36,180 --> 00:12:37,860
لم أكن أملك فكرة

239
00:12:38,100 --> 00:12:40,600
هل يمكنكم رؤية المُستنند؟

240
00:12:40,600 --> 00:12:42,350
من الصّعب رؤيتك

241
00:12:42,350 --> 00:12:44,670
كيف نُغلق المُستند؟

242
00:12:44,670 --> 00:12:47,870
الرّجاء النّظر إلى المُستند وليس لي

243
00:12:47,870 --> 00:12:52,820
في اليابان، عندما نقرأ القصص عن الكائنات
،غير البشريّة الّذين يعيشون كبشر

244
00:12:52,820 --> 00:12:59,130
في العادة نُفسّر ذلك على أنّه إله
أو كائن مُشابه يتلقّى عقوبة

245
00:12:59,710 --> 00:13:04,260
بعض النّاس يقرؤون كاغوياهيمي من "حكاية
قطّاع الخيزران" بهذا الشّكل

246
00:13:04,260 --> 00:13:08,890
شعب القمر، بعبارة أخرى، سكّان
السّماء، هم فوق البشر

247
00:13:08,890 --> 00:13:10,790
،لأجل المصلحة العامّة

248
00:13:10,790 --> 00:13:13,860
يمكننا القول بأنّه من الطّبيعيّ بالنّسبة لليابانيّين
أن يُفسّروا القصص بهذه الطّريقة

249
00:13:13,860 --> 00:13:20,000
أرواح شجر وحيوانات يخدمون الآلهة يُعتقَد
أيضاً بأنّهم فوق البشر

250
00:13:20,000 --> 00:13:22,500
هذا التّفكير طبيعيّ بالنّسبة لنا كذلك

251
00:13:22,500 --> 00:13:26,150
...تأثير كبير من الإحيائيّة تُلهِم

252
00:13:26,150 --> 00:13:30,910
الكائنات فوق البشر يُخفّضون إلى حالة بشريّة
ويُجبَرون على العيش في هذا العالم

253
00:13:31,150 --> 00:13:32,700
!الإنترنت مجنون

254
00:13:32,700 --> 00:13:34,250
!توشيرو

255
00:13:33,750 --> 00:13:35,330
فوق البشر؟

256
00:13:34,250 --> 00:13:35,830
هل يستطيع رؤيتي أيضاً؟

257
00:13:36,130 --> 00:13:39,330
...لكن مثلما قال نيكوزوكو الصّغير

258
00:13:40,140 --> 00:13:42,210
إنّه ليس شخصاً

259
00:13:46,010 --> 00:13:49,660
بالتّفكير في الأمر الآن، لطالما كان هناك
الكثير من التّشويش الرّوحانيّ

260
00:13:49,660 --> 00:13:51,760
على مُحاضرات الأستاذ نيكوزوكو عبر الإنترنت

261
00:13:51,760 --> 00:13:56,580
ليس ذلك فحسب، لكن إيكيبوكورو-سان يبعث بالكاميرا
لأنّهم يعرفون أين هو

262
00:13:56,580 --> 00:13:57,700
إيكيبوكورو-سان؟

263
00:13:57,700 --> 00:13:59,050
هذا هو اسم القطّ

264
00:13:59,050 --> 00:14:00,380
!إيكيبوكورو-سان؟

265
00:14:00,380 --> 00:14:01,770
في الواقع، لا يهمّ

266
00:14:02,290 --> 00:14:06,160
يُلاحظ الأستاذ فوراً عندما يستخدم التّلاميذ
لقطة شاشة للتغيُّب عن الدّرس

267
00:14:06,160 --> 00:14:09,610
الأرواح الّتي لا تتحرّك في الخلفيّة
لا تكشف عن هويّتها

268
00:14:09,610 --> 00:14:11,780
يُلاحظ فوراً أيضاً ما إن كان هناك
شخص يأخذ قيلولة

269
00:14:11,780 --> 00:14:14,240
لأنّ الأرواح تشي بهم من باب التّسلية

270
00:14:14,520 --> 00:14:20,130
لكن توشيرو يُعاني غالباً ليعرف
من هو التّلميذ أحياناً

271
00:14:20,130 --> 00:14:24,380
لم أتصوّر أبداً أن أعلم بمُعاناته بهذه
الطّريقة الفريدة من نوعها

272
00:14:25,320 --> 00:14:28,970
لماذا إذاً تستمع لمُحاضراته هنا؟

273
00:14:29,310 --> 00:14:30,840
أتيت إلى هنا لسبب، صحيح؟

274
00:14:31,970 --> 00:14:32,840
أجل

275
00:14:32,840 --> 00:14:37,350
قبل أيّام، قلت بأنّ طرد الأرواح
الحقيقيّ باهظ الثّمن

276
00:14:37,350 --> 00:14:38,890
كم تُكلّف بالضّبط؟

277
00:14:39,580 --> 00:14:41,940
ما أسعار طرد الأرواح في السّوق؟

278
00:14:43,820 --> 00:14:45,650
ينتشر هذا بكثيرة

279
00:14:45,650 --> 00:14:47,940
"في الرّدود، "هل ينبغي أن يُظهِروا اسم المتجر؟

280
00:14:47,940 --> 00:14:50,200
"مُخيف. إنّه قريب منّي. لن أعود إلى هناك أبداً"

281
00:14:50,200 --> 00:14:51,320
يفقد النّاس صوابهم

282
00:14:54,520 --> 00:14:58,190
غالباً لم يتوقّعوا أن ينتشر إلى هذه الدّرجة

283
00:14:58,190 --> 00:15:00,920
إذاً لهذا السّبب كان يوجد الكثير
من الزّبائن الغريبين اليوم

284
00:15:01,210 --> 00:15:03,730
لا يهمّ سواء كان هناك أرواح أو لا

285
00:15:03,730 --> 00:15:06,540
أمرني المقرّ بالتّعامل مع الأمر

286
00:15:07,240 --> 00:15:08,720
تعامل مع الأمر

287
00:15:08,720 --> 00:15:10,380
!ماذا يُفترَض بي أن أفعل بالضّبط؟

288
00:15:10,380 --> 00:15:11,750
!إنّهم يحمّلونني المسؤوليّة كاملة

289
00:15:11,750 --> 00:15:13,900
!تبّاً لك يا كانيدا من الشّؤون العامّة

290
00:15:13,900 --> 00:15:17,680
أنا متأكّد بأنّ كانيدا-سان يتلقّى
مُعاملة سيّئة من رؤسائه أيضاً

291
00:15:17,680 --> 00:15:20,790
طالبَ بضعة زبائن بالفعل بأن
أطهّر هذا المكان من الأرواح

292
00:15:20,790 --> 00:15:21,940
ماذا سأفعل؟

293
00:15:22,590 --> 00:15:24,890
هذه مسألة ثِقة بالنّسبة للمتجر

294
00:15:24,890 --> 00:15:28,820
يجب أن أبذل ما بوسعي لأقنع الزّبائن
الّذين أتعامل معهم

295
00:15:32,990 --> 00:15:36,410
ربّما كان يوجد شيء حقّاً هنا

296
00:15:37,830 --> 00:15:39,980
!ماذا؟ أستطيع تحريك الأشياء

297
00:15:39,980 --> 00:15:41,710
!مُذهل، أنت روح شرّيرة

298
00:15:42,010 --> 00:15:43,060
...هناك بالتّاكيد

299
00:15:43,060 --> 00:15:47,240
أتعلم؟ طالبة الثّانويّة تلك كانت
تأتي كثيراً مؤخّراً

300
00:15:47,240 --> 00:15:50,220
الشّخص الّذي يرتدي لباس ثانويّة ياتسومي

301
00:15:50,550 --> 00:15:51,840
!ماغي-سان

302
00:15:52,700 --> 00:15:55,030
سأشتري طعامي الخفيف من هنا
!اعتباراً من الآن

303
00:15:55,030 --> 00:15:56,350
أهذا كلّ شيء ليوم واحد؟

304
00:15:56,350 --> 00:15:57,880
هذا المكان مُمتع

305
00:15:57,880 --> 00:15:59,140
أعتقد سنبقى هنا لبعض الوقت

306
00:15:59,440 --> 00:16:02,680
أمسى هذا الشّيء يحدث كثيراً
منذ بدأتْ بالظّهور

307
00:16:02,680 --> 00:16:04,580
ربّما هي السّبب

308
00:16:04,580 --> 00:16:05,520
أجل

309
00:16:05,820 --> 00:16:07,990
ربّما ينبغي أن أخبر المدير

310
00:16:07,990 --> 00:16:10,860
لكن لا أريده أن يعتقد بأنّني غريب أطوار

311
00:16:10,860 --> 00:16:13,370
أعتقد بأنّ الأشخاص الّذين يستطيعون رؤية الأرواح
يواجهون صعوبة في مثل هذه الأمور

312
00:16:13,370 --> 00:16:16,660
من الرّائع لو كان هذا أنمي، لكن
هذا شاقّ بعض الشّيء

313
00:16:17,050 --> 00:16:19,480
موظّفو الدّوام الكامل مُخيفون أيضاً

314
00:16:19,480 --> 00:16:23,450
،إذا كان طرد الأرواح يُشعر الجميع بحالٍ أفضل
فهو جدير بالمُمارسة إذاً

315
00:16:23,450 --> 00:16:27,040
كما تعلم، ذلك الشّيء؟ تأثير العلاج المُموّوه؟

316
00:16:27,410 --> 00:16:31,220
عجباً. من يُفترَض أن أستأجر لفعل ذلك؟

317
00:16:31,220 --> 00:16:32,760
كاهن شينتو؟ راهب بوذيّ؟

318
00:16:33,050 --> 00:16:35,620
ماغي، هل تعرف أيّ وسيط؟

319
00:16:35,620 --> 00:16:37,150
لا تعرف بالطّبع

320
00:16:37,150 --> 00:16:37,760
ماذا؟

321
00:16:38,360 --> 00:16:40,550
...في  الواقع

322
00:16:40,980 --> 00:16:42,230
بلى

323
00:16:42,230 --> 00:16:43,820
هكذا إذاً

324
00:16:44,820 --> 00:16:47,550
إذاً طلب منك مُديرك معروفاً

325
00:16:47,550 --> 00:16:49,850
ابتسم لك الحظّ

326
00:16:49,850 --> 00:16:50,530
أجل

327
00:16:50,530 --> 00:16:52,770
ابتسم الحظّ لمُديرك

328
00:16:52,770 --> 00:16:53,540
أجل

329
00:16:53,970 --> 00:16:55,950
ماذا؟ حقّاً؟

330
00:16:56,180 --> 00:16:57,040
بجدّية؟

331
00:16:57,040 --> 00:16:58,370
لحظة، حقّاً؟

332
00:16:58,370 --> 00:16:59,810
كيف تعرّفت عليهم؟

333
00:16:59,810 --> 00:17:01,170
لا يهمّ. هل يمكنك سؤالهم؟

334
00:17:01,170 --> 00:17:03,570
ماغي-كن، أنا مسرور جدّاً لأنّني استأجرتُك

335
00:17:03,570 --> 00:17:04,540
شكراً

336
00:17:04,890 --> 00:17:07,960
!كم أنا مسرور

337
00:17:09,670 --> 00:17:12,510
!أنا مسرور جدّاً لأنّني استأجرتُك يا ماغي-كن

338
00:17:12,510 --> 00:17:14,630
!شكراً لك

339
00:17:14,630 --> 00:17:17,010
شكرَني مرّتين بالتّحديد

340
00:17:17,010 --> 00:17:21,060
هذه النّادرة تُسلّط الضّوء على مُعاناة
،الإدارة الوسطى

341
00:17:21,060 --> 00:17:24,680
لكن طرد الأرواح الحقيقيّ مُكلف جدّاً

342
00:17:24,680 --> 00:17:26,900
كم الثّمن؟ 100 ألف ين؟

343
00:17:27,140 --> 00:17:28,130
مليون ين

344
00:17:28,130 --> 00:17:29,790
!مليون ين؟

345
00:17:29,790 --> 00:17:32,020
عندما تكون الأرواح شديدة الخطورة

346
00:17:32,530 --> 00:17:37,250
توشيرو هو من تستدعيه عندما تتعامل
مع شيء شديد الخطورة

347
00:17:37,250 --> 00:17:39,780
مثل الفواتير الطبّية، إنّه باهظ الثّمن

348
00:17:40,060 --> 00:17:45,240
بصيغة أُخرى، روح كتلك الرّوح قبل أيّام
يمكن التّعامل معها مجّاناً بواسطة كيو-تشان

349
00:17:45,620 --> 00:17:49,080
معظم حوادث الأرواح هي إمّا ثانويّة
أو مجرّد اعتقاد خاطئ

350
00:17:49,080 --> 00:17:51,370
أو يمكن تفسيرها طبّياً

351
00:17:51,370 --> 00:17:56,630
لذلك النّفسيّين الغشّاشين الّذين يفرضون
أجراً بنصف القيمة مُريبون

352
00:17:56,630 --> 00:18:00,460
حسبما يبدو لي، أنا واثق
بأنّك تستطيع مُعالجة الأمر

353
00:18:00,460 --> 00:18:03,270
في الواقع، لا يبدو أنّهم يقدّرونني

354
00:18:03,270 --> 00:18:06,130
المعذرة، هل يمكنكم المُغادرة رجاء؟

355
00:18:03,540 --> 00:18:04,960
ما رأيك بكونك روحاً؟

356
00:18:04,960 --> 00:18:06,130
هل تشعر بالجوع؟

357
00:18:06,130 --> 00:18:06,850
!ليس كثيراً

358
00:18:06,850 --> 00:18:08,100
حقّاً؟

359
00:18:08,410 --> 00:18:10,450
حقّاً؟ توقّعت

360
00:18:10,970 --> 00:18:12,310
حقّاً؟

361
00:18:12,310 --> 00:18:14,070
بصراحة، آسف

362
00:18:14,070 --> 00:18:16,820
تفوح منك رائحة خضوع شديد

363
00:18:18,040 --> 00:18:23,030
،لكن بما أنّ الأمر مُتعلّق بالعمل
ستحتاج بالغاً حقيقيّاً

364
00:18:23,720 --> 00:18:27,460
كيو-تشان في المدرسة الثّانويّة، لذا
يجدر بك أن تسأل توشيرو غالباً

365
00:18:27,680 --> 00:18:31,340
لا أحد يعلم ما إن كان موغورا يتظاهر بأنّه
،يطرد الأرواح، ومن المُمكن أن يتقاضى أجراً

366
00:18:31,340 --> 00:18:32,840
لكنّه مع ذلك لا يفعل

367
00:18:33,250 --> 00:18:36,590
لا أعرف سبب مُعاقبته

368
00:18:36,590 --> 00:18:39,720
لطفه غير عاديّ أحياناً

369
00:18:43,130 --> 00:18:44,490
المعذرة

370
00:18:44,490 --> 00:18:49,620
أنا ميكوزوكو، طارد الأرواح الّذي
أُحيلَ إلى هنا

371
00:18:49,620 --> 00:18:51,610
شكراً على القدوم

372
00:18:51,610 --> 00:18:53,190
اسمي كامينوما كيوسكي

373
00:18:53,190 --> 00:18:54,360
!يسرّني وجودك

374
00:18:53,500 --> 00:18:55,400
!يبدو مُريباً جدّاً

375
00:18:56,890 --> 00:18:59,100
أخبرني والد جدّي ذات مرّة برواية

376
00:18:59,480 --> 00:19:03,050
كان مُتمركزاً في جزيرة سيليبيس، أو
جزيرة سولاويسي المُعاصرة

377
00:19:03,050 --> 00:19:06,290
كجزء من مجموعة جيش البعثة الجنوبيّة

378
00:19:06,690 --> 00:19:12,510
كان جنديّ فئة ثانية صغير قد عانى من جروح
،بليغة في كلّ أنحاء جسده

379
00:19:12,510 --> 00:19:17,530
ومن دون غذاء مُناسب، كانت تلك اللّيلة
أو اليوم المُوالي سيكون حاسماً

380
00:19:18,050 --> 00:19:23,170
جنديّ فئة ثانية نحيل بدأ بالادّعاء بأنّه ناسك

381
00:19:23,630 --> 00:19:30,390
أشفق على أولئك الّذين أمامي"
لأنّني لا أريد الشّعور بتأنيب الضّمير

382
00:19:31,020 --> 00:19:34,450
"لستُ مُناسباً لأكون إلهاً

383
00:19:46,990 --> 00:19:50,040
ماذا أطعمت الجنديّ كيريهارا للتو؟

384
00:19:50,320 --> 00:19:51,500
من أنت؟

385
00:19:51,810 --> 00:19:54,000
نيكوزوكو أوشيرو، جنديّ فئة أولى

386
00:19:54,240 --> 00:19:56,750
أنت مع الفرقة الّتي وصلت اليوم؟

387
00:19:56,750 --> 00:19:58,000
سامحني

388
00:19:58,930 --> 00:20:01,400
لا بدّ أنّ شخصاً ما ربّاك بشكل جيّد

389
00:20:01,400 --> 00:20:06,390
في العادة، جنود الفئة الأولى يلقون التّحيّة على
جنود الفئة الثّانية بلكمنا

390
00:20:07,760 --> 00:20:12,980
أنت إمّا ذكيّ أو ماهر حقّاً في شيء

391
00:20:13,270 --> 00:20:16,290
من النّادر لشخص ببُنيتك أن يصل للفئة الأولى

392
00:20:16,630 --> 00:20:19,990
تبدو صحّتك حتّى أسوأ من صحّتي
،والجنديّ كيريهارا

393
00:20:19,990 --> 00:20:20,900
هل أنت بخير؟

394
00:20:20,900 --> 00:20:22,940
انسَ الأمر

395
00:20:22,940 --> 00:20:24,800
لا تُحاول تشتيتي بمُحاولة استفزازي

396
00:20:24,800 --> 00:20:26,480
اسمح لي أن أكون صريحاً

397
00:20:26,480 --> 00:20:29,410
عندما تعود إلى اليابان، أريدك
أن تُساعد ابني

398
00:20:29,410 --> 00:20:33,120
هل ينبغي لك أن تتحدّث عن العودة يا سيّدي؟

399
00:20:33,440 --> 00:20:35,290
لا تُغيّر الموضوع

400
00:20:36,180 --> 00:20:38,710
أعلم بأنّك لست طبيعيّاً

401
00:20:39,640 --> 00:20:43,800
كان من الواضح أنّك تتبع الشّيء
الّذي يستحوذ عليّ بعينيك

402
00:20:45,550 --> 00:20:48,880
كبار عائلتي قصيرو العمر لأنّنا ممسوسون

403
00:20:48,880 --> 00:20:50,520
لا يستطيع الأطبّاء فعل شيء حيال ذلك

404
00:20:50,770 --> 00:20:53,070
عمري 23 سنة حاليّاً

405
00:20:53,070 --> 00:20:55,710
بصراحة، لا أعلم ما إن كنتُ
سأعيش حتّى الثّلاثين

406
00:20:56,040 --> 00:20:58,650
ابني الّذي عمره سنة في المنزل ليس

407
00:20:58,650 --> 00:21:02,390
قويّاً بما يكفي لتحمُّل الاستحواذ
وقد لا يبلغ العاشرة حتّى

408
00:21:02,860 --> 00:21:07,320
إذا كان ما قلتَه للجنديّ كيريهارا
،وأطعمته له سيُطيل حياته

409
00:21:07,320 --> 00:21:09,630
فأريدك أن تُساعد عائلتي إذاً

410
00:21:09,630 --> 00:21:13,100
بالمقابل، ستفعل عائلتي كلّ شيء
لأجلك في المستقبل

411
00:21:14,340 --> 00:21:17,380
ساعدنا أرجوك، ولو كان ابني فقط

412
00:21:17,940 --> 00:21:21,550
إنّ العيش في هذا العالم
،قد يغدو خياراً أكثر صعوبة

413
00:21:21,550 --> 00:21:24,130
لكن أريد أن أمنح ابني أكبر قدر
ممكن من الخيارات

414
00:21:24,660 --> 00:21:29,050
أنا مُندهش من مُلاحظتك تصرّفاتي
الغريبة يا سيّدي

415
00:21:29,570 --> 00:21:32,640
أنا معتاد على مُلاحظة الغرائب

416
00:21:32,640 --> 00:21:34,570
ألقِ نظرة حولك

417
00:21:34,570 --> 00:21:37,520
هذا ما يعنيه أن تُجرَّد من الخيارات

418
00:21:39,380 --> 00:21:42,660
يقول النّاس بأنّه من الصّواب مُساعدة الآخرين

419
00:21:42,660 --> 00:21:46,990
بينما يعتقد آخرون بأنّ فقدان
الأمل هو أكثر نبلاً

420
00:21:47,480 --> 00:21:52,450
حتّى على فراش موتنا، لا نعرف الجواب الصّحيح

421
00:21:52,680 --> 00:21:56,780
لكن هذا النّاسك الّذي لم يستطع حتّى
،اختيار الموت المذكور

422
00:21:56,780 --> 00:22:02,130
قد يؤدّي هذا الخيار إلى المُعجزة"
العظمى في القرن

423
00:22:02,130 --> 00:22:04,960
كما لو كان ذلك لمُواساة نفسه