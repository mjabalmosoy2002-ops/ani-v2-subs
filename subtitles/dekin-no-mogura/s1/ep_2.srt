1
00:00:07,660 --> 00:00:09,480
هل يمكنكما أن تخمّنا ما جرى لي؟

2
00:00:13,620 --> 00:00:15,120
كنتُ مُستهتراً

3
00:00:15,120 --> 00:00:19,870
كان ينبغي أن أفكّر فيما سيحدث
إذا ذهبتُ إلى ساحة المعركة

4
00:00:20,170 --> 00:00:22,990
حدث ذلك بُعيد شرائي لوضع
قانونيّ جديد لي

5
00:00:22,990 --> 00:00:26,040
كمُواطن عاديّ بالمال الّذي ادّخرتُه
أثناء عصر شووا

6
00:00:26,040 --> 00:00:28,790
لا بُدّ أنّ السّعادة قد أعمتني دون أن أدرك

7
00:00:28,790 --> 00:00:32,170
آنذاك، كنتُ سعيداً بتجاوز
فحصي الجسديّ للتجنيد

8
00:00:32,710 --> 00:00:34,180
شعرتُ وكأنّني قُبِلت

9
00:00:34,810 --> 00:00:37,370
،وبالنّظر إلى الطّريقة الّتي تمّ فيها نقلي

10
00:00:37,370 --> 00:00:40,020
بدأتُ أفهم وضعي فجأة وأعود إلى رشدي

11
00:00:41,290 --> 00:00:44,180
لم تستطع الرّفض؟

12
00:00:44,180 --> 00:00:46,150
سيكون ذلك صعباً بالنّسبة لي

13
00:00:46,150 --> 00:00:49,290
أوّلاً، من الصّعب رفض الخضوع للفحص الجسديّ

14
00:00:49,290 --> 00:00:55,150
تُرسَل إشعارات التّجنيد للشّباب الّذين ينجحون
في الفحص، لذا لا نملك سبباً للرّفض

15
00:00:55,150 --> 00:00:56,780
حقّقتُ الدّرجة الثّانية

16
00:00:57,060 --> 00:01:00,000
كنتُ نحيلاً، لكن كنتُ أستخدم اللّهب
للحِفاظ على صحّتي

17
00:01:01,210 --> 00:01:03,270
لا تعرفين ماذا يعني "الدّرجة الثّانية"؟

18
00:01:03,270 --> 00:01:05,740
يمكنكِ البحث عن ذلك لاحقاً

19
00:01:05,740 --> 00:01:07,810
ماكي-تشان، تعلم ما أتحدّث عنه، صحيح؟

20
00:01:07,810 --> 00:01:11,280
فأساساً، سرعان ما فهمت عندما
قلتُ 1942

21
00:01:11,280 --> 00:01:13,010
أنا مُندهش

22
00:01:13,570 --> 00:01:14,180
،في الواقع

23
00:01:14,620 --> 00:01:18,520
هذه الأرقام هي إشارة إلى
خراطيش 7.62 في 39 مم، صحيح؟

24
00:01:19,210 --> 00:01:22,130
رصاص بندقيّة. رأيتُ ذلك في الأفلام

25
00:01:22,130 --> 00:01:23,480
كوبريك، صحيح؟

26
00:01:23,920 --> 00:01:25,990
كنت ترتدي قميص م.1911 في الأمس

27
00:01:25,990 --> 00:01:28,270
هذا سلاح ناريّ، صحيح؟ هل أنا مُحقّ؟

28
00:01:28,270 --> 00:01:30,070
أنت مهتمّ بمثل هذه الأمور، صحيح؟

29
00:01:30,420 --> 00:01:32,120
لديك بعض المعلومات عن ذلك إذاً

30
00:01:32,120 --> 00:01:35,670
أجل. ألعب كثيراً من ألعاب منظور الشّخص الأوّل

31
00:01:35,670 --> 00:01:36,620
ألعاب فيديو؟

32
00:01:36,930 --> 00:01:39,850
.لكن أفعل هذا للتّسلية فقط
لا أعرف كلّ هذا القدر

33
00:01:39,850 --> 00:01:41,930
آسف إذا قلتُ كلاماً جارحاً لك

34
00:01:41,930 --> 00:01:44,880
لا. أنا لا أحاول أن أدعك تُواجه وقتاً عصيباً

35
00:01:45,570 --> 00:01:48,480
إذاً لا بُدّ أنّك تعلم بشأن البندقيّة نوع 38، صحيح؟

36
00:01:48,480 --> 00:01:51,010
كنتُ أستخدم واحدة، لكن بالكاد أعرف عنها شيئاً

37
00:01:51,010 --> 00:01:54,890
.كان لدى الأمريكيّين ذلك الّذي لا أدري ما اسمه
وينشيستر أو ما شابه

38
00:01:54,890 --> 00:01:56,300
على أيّ حال، أتعلم؟

39
00:01:56,890 --> 00:01:59,890
إنّها تؤذي الهدف كثيراً إذا أصابته

40
00:02:01,270 --> 00:02:04,770
والأهمّ من ذلك، ليس من المُمتع إشهار
واحد على شخص والرّمي

41
00:02:07,020 --> 00:02:09,940
.على أيّ حال، أنا كثير الأنين
آسف بشأن ذلك

42
00:02:09,940 --> 00:02:11,760
سأعترف بأنّها تبدو رائعة

43
00:02:11,760 --> 00:02:14,660
،عندما رأيتُ واحدة في الواقع
"!قلتُ لنفسي، "مُذهل

44
00:02:15,230 --> 00:02:16,550
وألعاب الفيديو مُمتعة

45
00:02:16,550 --> 00:02:18,390
لعبتُها في صالات الأركيد

46
00:02:18,390 --> 00:02:20,700
أتفهّم سبب انجذاب النّاس لها

47
00:02:20,700 --> 00:02:22,910
ليتني أمتلك بعضاً أيضاً

48
00:02:22,910 --> 00:02:24,670
لكن من الصّعب الاختيار

49
00:02:25,340 --> 00:02:28,000
لكن ساحة المعركة مُختلفة

50
00:02:28,000 --> 00:02:33,050
أحبّ الأفلام أيضاً، لكن الواقع مُختلف

51
00:02:33,350 --> 00:02:38,110
الرّائحة والأوساخ والبعوض والبراز
والجوع والحكّة والألم

52
00:02:38,110 --> 00:02:42,040
والتعرُّض لتنمّر بواسطة الضُبّاط، وأجسام
مليئة بالسُّخام، وديدان في الجروح

53
00:02:42,040 --> 00:02:45,020
عندما يُطلَب منك التوجّه يميناً، فيجب
عليك أن تتوجّه يميناً مهما كلّف الأمر

54
00:02:45,020 --> 00:02:46,650
ما زلتُ أحلم بذلك

55
00:02:46,920 --> 00:02:50,960
والأسوأ من كلّ ذلك هو أنّني
أستطيع رؤية أرواح الموتى

56
00:02:50,960 --> 00:02:53,650
والكثير منهم، سواء كانوا أصدقاء أم أعداء

57
00:02:53,650 --> 00:02:57,870
هذا مُثير للشّفقة، لكن أُصِبتُ
بصدمة نفسيّة بسبب ذلك

58
00:02:58,300 --> 00:03:01,130
إنّه السّبب الّذي يجعلني لا أرغب
في شراء بطاقة إقامة إلى الآن

59
00:03:01,130 --> 00:03:02,880
لا أستطيع تحمّل تكاليف ذلك على أيّ حال

60
00:03:02,880 --> 00:03:06,750
أعلم بأنّني أستطيع العمل في مكان جيّد لبعض
...الوقت إذا اشتريتُ واحدة، لكن مع ذلك

61
00:03:07,010 --> 00:03:09,870
والأهمّ من ذلك، جعلني ذلك أستهلك
كلّ اللّهب الّذي ادّخرتُه

62
00:03:09,870 --> 00:03:11,550
ترتّب عليّ طَي صفحة جديدة

63
00:03:12,870 --> 00:03:16,860
أخبرتُكما من البداية عن سبب
شرحي لكلّ هذا بالتّفصيل

64
00:03:17,170 --> 00:03:21,260
،الآن بعد أن صرتُما قادرين على رؤيتهم
أبلغوني إذا صادفتُما أيّ روح

65
00:03:24,310 --> 00:03:27,640
سأعمل على جمع اللّهب من جديد

66
00:03:27,640 --> 00:03:29,730
بصراحة، كنتُ لأتمنّى تقديم المُساعدة

67
00:03:29,730 --> 00:03:33,320
،عملتُ جاهداً لجمع كلّ هذا القدر
لذا هذا مُخيّب حقّاً

68
00:03:33,580 --> 00:03:36,560
كيفي يُفترض بنا أن نخبرك وأنت
لا تحمل هاتفاً نقّالاً حتّى؟

69
00:03:37,640 --> 00:03:40,030
إمّا أن تتّصلا بهذا المكان أو تأتيا
إلى هنا شخصيّاً

70
00:03:40,030 --> 00:03:42,120
إنّه رقم متجر الحلويّات في هذا الشّارع

71
00:03:42,380 --> 00:03:44,230
يمكنكما ترك رسالة لي هناك

72
00:03:44,230 --> 00:03:47,430
أمرّ طوال الوقت لأستعمل الإنترنت

73
00:03:47,430 --> 00:03:48,830
يا له من مُزعج

74
00:03:50,570 --> 00:03:55,460
كأنّكما تقولان بحسب تعابير وجهيكما بأنّ
شرحي عامّ مُقارنة بهدفي

75
00:03:55,760 --> 00:04:00,670
بصراحة، كسب تعاطفكما كان
دافعي الخفيّ الحقير

76
00:04:00,670 --> 00:04:02,100
،لكن الأهمّ من ذلك

77
00:04:02,100 --> 00:04:06,730
وجود شخص أتكلّم معه هو أكثر ضرورة
بكثير ممّا تُدركان

78
00:04:08,190 --> 00:04:12,310
،مضى وقت منذ تكلّمتُ عن كلّ ذلك
لكنّكما لطيفان جدّاً

79
00:04:12,310 --> 00:04:18,250
ولم تسألا أبداً عن سبب تلقّيي
العقاب. شكراً

80
00:04:18,250 --> 00:04:21,020
لن أغضب إذا لم تتّصلا بي أبداً ثانية

81
00:04:21,020 --> 00:04:23,160
شكراً على الكبد أيضاً. سوف آكله

82
00:04:23,910 --> 00:04:25,660
هل تعتقدين بأنّ كلّ ما قاله صحيح؟

83
00:04:26,770 --> 00:04:30,080
بصراحة، يبدو أنّ هناك إمكانيّة بأن يكون
جزءاً من دين غريب

84
00:04:30,080 --> 00:04:33,920
في الواقع، تذكّرتُ شيئاً أخيراً

85
00:04:34,270 --> 00:04:35,850
،عائلتي هي من الرّيف في الأصل

86
00:04:35,850 --> 00:04:39,640
ولدينا صور لوالد جدّي في مخزن قديم

87
00:04:39,640 --> 00:04:41,010
...ومن بينها

88
00:04:41,650 --> 00:04:44,950
،عندما رأيتُ موغورا-سان أوّل مرّة
شعرتُ بتشابه بينهما

89
00:04:44,950 --> 00:04:48,020
صور الأسود والأبيض نادرة، لذا
خلّفَ ذلك انطباعاً

90
00:04:48,480 --> 00:04:51,310
كان والد جدّي يروي الكثير من القصص العجيبة

91
00:04:51,310 --> 00:04:56,290
مثل كيف أنّه عاد سباحةً إلى الدّيار عبر
البحر وشرب وقود مُحرّك نفّاث بدلاً من خمر

92
00:04:56,720 --> 00:04:58,740
لا ينبغي أن أضحك، لكن هذا مُذهل

93
00:04:59,170 --> 00:05:04,160
وإحدى قصصه كانت عن مرّة أُصيبَ فيها بجروح
بليغة ثمّ تعافى بين ليلة وضُحاها

94
00:05:04,560 --> 00:05:07,910
حدث ذلك بالتّزامن مع تاريخ تلك الصّورة

95
00:05:09,160 --> 00:05:12,760
،شككتُ بروايته، لكن إن كانت صحيحة

96
00:05:12,760 --> 00:05:15,290
فمن المُمكن أنّني وُلِدتُ بسبب موغورا-سان

97
00:05:15,960 --> 00:05:18,730
إذا استطاع رؤية الكثير من الأرواح
،في ساحة المعركة

98
00:05:18,730 --> 00:05:23,050
فكنتُ أقول لنفسي بأنّه كان باستطاعته ادّخار
نار أكثر كنتيجة ثانويّة أكثر ممّا استعمل

99
00:05:23,480 --> 00:05:26,140
...حتّى لو لم يتصرّف بصورة مُريبة جدّاً في الجيش

100
00:05:26,850 --> 00:05:32,900
لكن من المُمكن أن يكون موغورا-سان قد استهلك ناراً
أكثر على الآخرين ممّا استخدم على نفسه

101
00:05:34,350 --> 00:05:37,100
كنتُ خائفاً من السّؤال عن عقوبته

102
00:05:37,560 --> 00:05:39,950
لكن لا يبدو لي شخصاً سيّئاً

103
00:05:39,950 --> 00:05:42,110
هل تعتقدين بأنّني ساذج؟

104
00:05:43,180 --> 00:05:44,710
ربّما

105
00:05:44,710 --> 00:05:49,200
في عصرنا هذا، نُنعَت بالأغبياء إذا حاولنا
مُساعدة شخص مُريب

106
00:05:52,200 --> 00:05:54,170
لكنّنا لا نرتكب خطأ

107
00:05:57,560 --> 00:05:58,920
!أنتما

108
00:05:59,290 --> 00:06:02,560
لم أعش مثل هذه اللّحظات
!الجميلة في حياتي

109
00:06:02,560 --> 00:06:04,720
!كيف تجرؤان على المُغازلة أمام منزلي

110
00:06:04,720 --> 00:06:06,540
!مُجرّد رؤيتكما أثارت غضبي

111
00:06:06,540 --> 00:06:08,560
!هل فهمتما؟ تبّاً لكما

112
00:06:08,780 --> 00:06:11,230
هل كان عليك أن تخرج وتصرخ
!في وجهنا بسبب ذلك؟

113
00:06:11,230 --> 00:06:12,870
!تذكّرا هذا

114
00:06:12,870 --> 00:06:16,470
الشّباب الّذين لا يذوقون طعم الحلاوة
!في شبابهم، لن يفعلوا أبداً

115
00:06:16,470 --> 00:06:19,230
متى كنتَ صغيراً بالضّبط؟

116
00:06:19,230 --> 00:06:24,190
قابلتُ الكثير من المجانين
!شديدي التعلُّق في حياتي

117
00:06:24,190 --> 00:06:27,830
لا أحد يريد سمع رواياتك المليئة بالعفن

118
00:06:27,830 --> 00:06:28,990
!اللّعنة

119
00:06:28,990 --> 00:06:34,140
آمل أن يقع شريك مُحادثة مُنحرف
!بشكل مُعتدل ولطيف في حضني

120
00:06:34,140 --> 00:06:36,520
!كم أغار منك

121
00:06:36,520 --> 00:06:38,840
ماذا يعني "مُنحرف بشكل مُعتدل"؟

122
00:06:39,350 --> 00:06:41,720
!إن كنت تعرف فتاة كهذه، فعرّفني عليها

123
00:06:41,720 --> 00:06:44,500
!اتّصل بي بشأن ذلك أيضاً، تبّاً

124
00:06:45,370 --> 00:06:47,780
ربّما ينبغي أن نُبقي مسافة بيننا وبينه

125
00:06:48,110 --> 00:06:50,640
ستنحسنا بقول ذلك

126
00:06:56,160 --> 00:06:58,860
هل كان ذلك متجر الحلويّات الّذي ذكره؟

127
00:06:59,500 --> 00:07:01,860
...والد جدّ ياي-تشان

128
00:07:01,860 --> 00:07:03,940
هل مضت كلّ هذه الفترة من الآن؟

129
00:07:05,450 --> 00:07:06,950
هلّا رميت هذه؟

130
00:07:06,950 --> 00:07:09,250
شكراً لك

131
00:07:09,250 --> 00:07:12,740
تبّاً. النّاس يعاملون الموظّفين وكأنّنا عديمو
القيمة فقط لأنّنا متجر بـ100 ين

132
00:07:13,590 --> 00:07:14,780
ما الأمر يا مُدير؟

133
00:07:14,780 --> 00:07:16,310
!ذلك الشّخص لصّ

134
00:07:16,310 --> 00:07:19,280
اشترى غرضاً واحداً فقط ولم يُسدّد
!ثمن الخمسة الأُخرى

135
00:07:19,280 --> 00:07:20,270
!ماذا؟

136
00:07:22,710 --> 00:07:25,330
!ماكي، لا تتردّد! استهدف العينين

137
00:07:25,330 --> 00:07:26,260
!كيف؟

138
00:07:26,490 --> 00:07:29,260
!يا سيّدي! لم تدفع بعد، تبّاً

139
00:07:29,260 --> 00:07:32,320
على ذكر الأمر، أتساءل ما إن كانت
الأرواح تسرق

140
00:07:32,320 --> 00:07:34,190
أتطارد لصّاً؟

141
00:07:34,190 --> 00:07:34,730
ماذا؟

142
00:07:34,730 --> 00:07:36,190
أتريدني أن أمسك به؟

143
00:07:36,190 --> 00:07:36,930
!ماذا؟

144
00:07:43,230 --> 00:07:43,980
بئساً

145
00:07:44,280 --> 00:07:46,170
قلتُ لك لا أحمل رخصة

146
00:07:46,170 --> 00:07:49,980
لا أملك أي مؤهّلات تتطلّب تعريفاً

147
00:07:49,980 --> 00:07:51,680
أجور القطار باهظة الثّمن أيضاً

148
00:07:51,680 --> 00:07:55,120
بدلاً من ذلك، تعلّمتُ كيفيّة ركوب الدرّاجة
بسرعة تصل إلى 70 كم في السّاعة

149
00:07:55,370 --> 00:07:56,920
...هذا الغبيّ المُجدّ في العمل

150
00:07:56,920 --> 00:07:59,630
يتصرّف باستهتار بالرّغم من وضعه

151
00:08:00,020 --> 00:08:01,960
ربّما يمكنك أن تكون مُتسابق كيرين

152
00:08:01,960 --> 00:08:04,530
لكن يتطلّب ذلك وثائق تعريف، صحيح؟

153
00:08:04,530 --> 00:08:06,840
حسناً، ما مُشكلتك؟

154
00:08:07,100 --> 00:08:08,940
هل ترى شيئاً غير اعتياديّ عقب ذلك؟

155
00:08:08,940 --> 00:08:10,090
مثل ماذا؟

156
00:08:10,330 --> 00:08:14,210
كأوّل صورة لك كروح

157
00:08:14,210 --> 00:08:15,970
لا مُشكلة إن لم تفعل

158
00:08:16,360 --> 00:08:19,890
هل سأمرّ بهذه التّجربة غالباً في وقت لاحق؟

159
00:08:19,890 --> 00:08:20,940
!ماكي

160
00:08:20,940 --> 00:08:22,100
هل أمسكت به؟

161
00:08:22,600 --> 00:08:25,070
لا أريد التّعامل مع الشّرطة، لذا لفّق قصّة ما

162
00:08:25,070 --> 00:08:27,500
وأيضاً، إن كان لديك أيّ طعام مُنتهي
الصّلاحيّة، فأعطِني إيّاه كلّه

163
00:08:27,500 --> 00:08:28,150
!إلى اللّقاء

164
00:08:28,400 --> 00:08:32,390
على ذكر الأمر، أتساءل ما إن كان سريعاً
بصورة غريبة بسبب ظروفه المعيشيّة

165
00:08:32,390 --> 00:08:34,540
على الأقلّ زيّت درّاجتك. بئساً

166
00:08:35,430 --> 00:08:36,510
من كان ذلك؟

167
00:08:36,510 --> 00:08:37,830
لا أحد

168
00:08:37,830 --> 00:08:41,900
فهمت. حسناً، لنؤنّب هذا الشّخص
قبل وصول الشّرطة

169
00:08:41,900 --> 00:08:43,130
لا يمكننا فعل ذلك

170
00:08:43,440 --> 00:08:47,360
!خسائر البضاعة تؤثّر على الإضافي الخاصّ بي

171
00:08:47,360 --> 00:08:49,550
لا أُبالي لحقوق إنسان مُجرّد لصّ

172
00:08:49,550 --> 00:08:52,360
إذا أردت كاميرات مُراقبة، فسدّد"
"ثمنها بنفسك؟

173
00:08:52,360 --> 00:08:54,170
!مُحال! تبّاً لمقرّ الشّرطة

174
00:08:54,170 --> 00:08:56,410
!تبّاً لك يا كانيدا من الشّؤون العامّة

175
00:08:56,410 --> 00:08:58,800
ينبغي أن نشتكي لقسم شؤون الموظّفين

176
00:08:58,800 --> 00:09:01,440
أنا متأكّد بأنّ كانيدا-سان يتعرّض
لضغوط من رؤسائه

177
00:09:01,700 --> 00:09:04,360
سأقحِم الشّرطة في أكبر حوادث مُمكنة

178
00:09:04,360 --> 00:09:06,550
!وأسحق المقرّ في المحاكم في نهاية المطاف

179
00:09:06,550 --> 00:09:08,940
!هذا هو هدفي الحاليّ

180
00:09:08,940 --> 00:09:11,420
!أو رُبّما سأقتل لصّاً

181
00:09:11,420 --> 00:09:14,410
حتّى بقتل شخص، يمكن العودة
!إلى المُجتمع بعد سنوات قليلة

182
00:09:14,410 --> 00:09:16,200
!لنقتله يا ماكي-كن

183
00:09:17,930 --> 00:09:20,460
ينبغي أن نُعدّل النّظام القضائيّ في هذا البلد

184
00:09:20,820 --> 00:09:23,830
ينبغي أن ترتاح يا حضرة المُدير سوكيكيو

185
00:09:24,570 --> 00:09:28,050
ماكي-كن، الموظّفون بدوام كامل
!لا يحظون بلحظة راحة

186
00:09:28,050 --> 00:09:29,610
!أنت مُضحك للغاية

187
00:09:29,610 --> 00:09:33,010
ماذا؟ انتظر، ما قصّة "المُدير سوكيكيو"؟

188
00:09:33,010 --> 00:09:36,350
هل هذا اسم الموظّفين السرّي المُخصّص لي؟

189
00:09:36,350 --> 00:09:38,300
آسف

190
00:09:38,300 --> 00:09:40,770
لكن قصدتُ ذلك بمحبّة

191
00:09:41,020 --> 00:09:44,980
لكن سوكيكيو هو أقلّ شخصيّة محبوبة

192
00:09:44,980 --> 00:09:45,690
لا، لحظة

193
00:09:46,040 --> 00:09:47,130
ها أنا ذا

194
00:09:48,250 --> 00:09:52,280
،في المرّة المقبلة الّتي نقبض فيها على لصّ
!سأتعامل معه بهذه الطّريقة

195
00:09:52,280 --> 00:09:56,160
ما بين فوجيمورا وهذا الشّخص، قد يكون
البشر الأحياء أكثر رُعباً من الأرواح

196
00:09:56,870 --> 00:09:58,160
وهذا ما حدث

197
00:09:58,520 --> 00:10:02,770
لكن عندما رأيتُ موغورا، ارتأيتُ بأنّني أفضل
حالاً بمجرّد امتلاك هذا العمل

198
00:10:02,770 --> 00:10:04,540
سوكيكيو المسكين

199
00:10:05,000 --> 00:10:07,630
مكان عملي مُسالم وهادئ

200
00:10:07,630 --> 00:10:09,150
كنتُ في مقهى لثلاث سنوات

201
00:10:09,150 --> 00:10:10,950
ثلاث سنوات؟ هذه مدّة طويلة

202
00:10:10,950 --> 00:10:12,520
إنّه مكان لطيف

203
00:10:12,520 --> 00:10:14,550
انضمّ موظّفٌ جديد مؤخّراً

204
00:10:14,550 --> 00:10:16,600
إنّه صغير جدّاً. عمره 15 فقط

205
00:10:16,600 --> 00:10:19,430
سنة أولى في الثّانويّة إذاً؟ أنا مسرور لأجله

206
00:10:19,990 --> 00:10:21,430
اسمي إينوكاي شيو

207
00:10:21,430 --> 00:10:22,850
أعشق الطّعام

208
00:10:22,850 --> 00:10:25,650
لحظة. أنا قلق بشأن مستوى الذّكاء
المُطبَّق في عمليّة ضمّكِ لموظّفين جدُد

209
00:10:25,650 --> 00:10:28,510
وجبات الطّاقم في هذا المكان لذيذة

210
00:10:28,510 --> 00:10:30,700
عظيم. اسألي كيريهيارا إن كان
لديك أي استفسارات

211
00:10:30,700 --> 00:10:33,200
اسمي كيريهارا يايكو. أنا طالبة كلّية

212
00:10:33,410 --> 00:10:34,890
ناديني يايكو

213
00:10:34,890 --> 00:10:36,470
اسمي إينوكاي شيو، طالبة مدرسة
!ثانويّة سنة أولى

214
00:10:36,470 --> 00:10:38,080
!أعشق الطّعام

215
00:10:38,590 --> 00:10:42,800
لماذا أنتِ واسعة جدّاً بشأن تفضيلاتك؟

216
00:10:42,800 --> 00:10:45,680
ماذا؟ لكن ألا تعتقدين بأنّ مذاق الطّعام لذيذ؟

217
00:10:45,680 --> 00:10:47,150
بلى

218
00:10:47,150 --> 00:10:49,390
يايكو-سان، في أيّ عام أنت في الكلّية؟

219
00:10:49,390 --> 00:10:52,130
أنا سنة ثالثة. لا أبدو كذلك، صحيح؟

220
00:10:53,270 --> 00:10:54,910
هذا هو زيّنا الرّسميّ

221
00:10:54,910 --> 00:10:56,210
هذا لواجهة المحّ

222
00:10:56,210 --> 00:10:57,600
أنا أعمل في المطبخ

223
00:10:57,600 --> 00:10:58,180
!حسناً

224
00:10:58,470 --> 00:11:01,400
!هذا هو عملي الأوّل، لذا أنا متوتّرة

225
00:11:04,060 --> 00:11:09,730
كان ذلك أشبه بالنّظر إلى جبال الألب
السويسريّة، ولم تبلغ 20 حتّى

226
00:11:11,950 --> 00:11:15,650
من مستوى ذكاء منخفض إلى عبارة
اختتاميّة لا أستطيع التّعليق عليها

227
00:11:18,160 --> 00:11:22,880
أليس لديك ما تقوله بشأن ذلك
يا قائد النّدوة ماكي؟

228
00:11:22,880 --> 00:11:24,930
لخّص أفكارك في صفحة واحدة أو أقلّ

229
00:11:26,880 --> 00:11:30,280
ماكي-كن

230
00:11:30,280 --> 00:11:33,040
كان كافّة الزّبائن ينظرون إليها أيضاً

231
00:11:33,040 --> 00:11:36,030
هل الألب بتلك العظَمة حقّاً؟

232
00:11:36,030 --> 00:11:38,390
أين المُشكلة في سهول كانتو؟

233
00:11:38,390 --> 00:11:41,590
بربّكم، بربّكم، بربّكم

234
00:11:41,590 --> 00:11:44,890
أعتقد بأنّ ياي-تشان أكثر جبناً
منّي حتّى أحياناً

235
00:11:41,590 --> 00:11:45,390
أخبرني يا ماكي-كن

236
00:11:45,770 --> 00:11:50,650
وجود شخص أتكلّم معه هو أكثر ضرورة
بكثير ممّا تُدركان

237
00:11:51,280 --> 00:11:55,860
لعلّي أعيش حياة رغيدة الآن

238
00:11:56,510 --> 00:11:58,520
إنّها شيو-تشان

239
00:11:58,520 --> 00:12:00,620
أجل. لقد أقاموا حفلة ترحيب

240
00:12:00,990 --> 00:12:04,030
لم أتلقّ واحدة

241
00:12:04,630 --> 00:12:07,580
إنّها تُرسل لي صورة للحفلة

242
00:12:07,580 --> 00:12:08,410
ماذا؟

243
00:12:13,900 --> 00:12:15,840
إنّه هنا بالفعل

244
00:12:15,840 --> 00:12:21,430
،بصراحة، لو لم يكن هذا الشّارع هنا
"لاعتبرتُ نفسي "ثمل

245
00:12:21,920 --> 00:12:25,930
سألقي كلّ ما هو مُخيف على عاتقه
وأجعله يُعالج الأمر

246
00:12:29,390 --> 00:12:33,030
هذا... ألمك

247
00:12:32,610 --> 00:12:34,230
هل يغنّي شيئاً؟

248
00:12:33,030 --> 00:12:36,680
يمكنك أن تعيش لأجل شخص

249
00:12:35,180 --> 00:12:37,510
إنّه يغنّي "أطلق عنان نفسك"؟

250
00:12:36,680 --> 00:12:40,590
...هذا حلمك

251
00:12:37,510 --> 00:12:40,030
لكنّه يفوّت الكثير من الكلمات

252
00:12:40,030 --> 00:12:42,130
لماذا يغنّي بصوتٍ عال؟

253
00:12:40,590 --> 00:12:46,660
ليس لديك ما تخشاه

254
00:12:42,130 --> 00:12:43,510
أريد المُغادرة من الآن

255
00:12:43,510 --> 00:12:46,660
إنّه أكثر رعباً حتّى من الأرواح
والبشر الأحياء

256
00:12:47,280 --> 00:12:49,290
لِمَ لا؟ يروقني ذلك

257
00:12:49,810 --> 00:12:51,090
الموسيقى جيّدة

258
00:12:51,090 --> 00:12:54,130
حالما تتعلّم أغنية، يمكنك الاستمتاع
بها حتّى بعد مماتك

259
00:12:54,130 --> 00:12:57,230
ستجد أنّ الأرواح تتجمّع حقّاً
في المهرجانات الموسيقيّة

260
00:12:57,230 --> 00:12:59,300
ينبغي أن تُقدّر ذلك الجزء من الثّقافة

261
00:12:59,590 --> 00:13:01,680
ماذا؟ حقّاً؟

262
00:13:01,680 --> 00:13:03,390
كيف سأحضر مهرجانات الآن؟

263
00:13:03,760 --> 00:13:09,520
،إذا سمعتُ أغنية أحبّها في مقهى تسجيلات
سأطلب منهم تشغيلها ثانية حتّى أحفظها

264
00:13:09,850 --> 00:13:11,380
!كم هذا مُزعج

265
00:13:12,270 --> 00:13:13,270
شكراً

266
00:13:13,270 --> 00:13:17,190
ثمّ أستخدم الإنترنت في متجر الحلويّات
للبحث عن الإستوديو الخاص بها

267
00:13:17,190 --> 00:13:20,900
!أصبحت بارعاً جدّاً في التسكُّع

268
00:13:21,150 --> 00:13:23,580
ثمّ أبحث عن طريقة لتسجيلها
على شريط كاسيت

269
00:13:23,580 --> 00:13:24,920
هل نحن في عصر شووا؟

270
00:13:25,580 --> 00:13:27,330
ليس وكأنّني أملك خياراً

271
00:13:27,330 --> 00:13:32,120
،لا أستطيع الحصول على عقد هاتفيّ
والأسطوانات باهظة الثّمن بالنّسبة لي

272
00:13:32,400 --> 00:13:36,290
،يمكنك الاستماع للأشرطة من دون واي فاي
لذا إنّها تقنيّة مُذهلة

273
00:13:36,290 --> 00:13:38,520
أشرطة الكاسيت هي رفاهية

274
00:13:38,520 --> 00:13:41,900
في فترة إيدو، كان كلّ ما نسمعه
هو موسيقى حيّة

275
00:13:41,900 --> 00:13:43,890
!بجدّية، كم عمرك؟

276
00:13:44,320 --> 00:13:45,550
!لا، لحظة

277
00:13:45,550 --> 00:13:46,710
عمّاذا نتكلّم حتّى؟

278
00:13:46,710 --> 00:13:48,680
!لم نأتِ إلى هنا لمُناقشة هذا الأمر

279
00:13:49,710 --> 00:13:50,770
ما هذا الكلام فجأة؟

280
00:13:51,140 --> 00:13:53,870
أنت تتكلّم كثيراً حول تُرّهات غير ضروريّة

281
00:13:53,870 --> 00:13:54,770
حقّاً؟

282
00:13:55,080 --> 00:13:58,780
كلّما يكبر المرء، يقضي مزيداً من الوقت
على ثرثرة لا جدوى منها

283
00:13:58,780 --> 00:14:02,400
وماذا بعد؟ هل أتيتما لتخبراني
بأنّكما رأيتُما شبحاً؟

284
00:14:02,400 --> 00:14:04,160
أم أنّكما تحتاجان نصيحة؟

285
00:14:05,210 --> 00:14:09,080
ربّما رأيتُما صورة لروح ولا تعرفان
ماذا تفعلان

286
00:14:10,700 --> 00:14:13,030
نشاط خارق للطّبيعة يُصيب الأجهزة

287
00:14:13,030 --> 00:14:14,620
يحدث هذا كثيراً في هذه الأيّام

288
00:14:14,620 --> 00:14:18,140
يجنّ جنون التّلفزيون وتتعطّل الكاميرات
وتخرج أصوات غريبة من الهاتف

289
00:14:18,140 --> 00:14:19,480
نسمع هذا طوال الوقت

290
00:14:19,480 --> 00:14:21,130
كفى كلاماً فارغاً حول الغوامض

291
00:14:21,130 --> 00:14:23,130
،لستُ أفهم المنطق بعد

292
00:14:23,130 --> 00:14:26,270
لكن إذا كنتَ السّبب الّذي يجعلنا
نراهم، فافعل شيئاً إذاً

293
00:14:28,300 --> 00:14:32,490
حسناً، أعتقد هذا سيُعالج جزئيّة الخوف

294
00:14:33,690 --> 00:14:37,260
تلك الصّورة الرّوحيّة تبدو هكذا بالنّسبة لي

295
00:14:37,260 --> 00:14:38,520
ماذا عنكما؟

296
00:14:39,930 --> 00:14:43,250
اسمعا، الأرواح هم بشر موتى

297
00:14:43,250 --> 00:14:46,030
لا تعتقدا بأنّهم عدائيّون فقط
لكونهم يبدون مُخيفين

298
00:14:46,320 --> 00:14:48,740
!يبدو أنّهم مُستمتعون

299
00:14:48,740 --> 00:14:50,580
إنّهم بشر في نهاية المطاف

300
00:14:50,960 --> 00:14:54,070
إنّهم غير واضحين بالنّسبة لي

301
00:14:54,070 --> 00:14:56,990
لا أرى سوى عيون الكثير من الأشكال السّوداء

302
00:14:56,990 --> 00:14:59,630
أجل، يبدون بشكل مختلف بحسب الشّخص

303
00:15:00,760 --> 00:15:03,160
يزداد الأمر غموضاً شيئاً فشيئاً

304
00:15:03,160 --> 00:15:05,180
ما زلت تشتكي بشأن ذلك؟

305
00:15:05,180 --> 00:15:06,920
حسناً

306
00:15:06,920 --> 00:15:11,700
سأريك شيئاً سيُثير اهتمام حتّى
رجل كاره للغوامض

307
00:15:11,700 --> 00:15:14,650
تخيّل لوهلة كيف ستصبح روحاً يوماً ما

308
00:15:15,060 --> 00:15:17,610
ثمّ يمكنك النّظر إلى مؤخّرة
فتاة قدر ما تشاء

309
00:15:17,610 --> 00:15:19,580
هذا غير لائق يا عجوز

310
00:15:19,580 --> 00:15:21,880
ولو لدقيقة، حسناً؟

311
00:15:21,880 --> 00:15:24,360
لا أُبالي إذا كنت رجلاً يحبّ المؤخّرات

312
00:15:24,740 --> 00:15:28,350
.على أيّ حال، هناك الكثير منهم
هذا غير معتاد

313
00:15:28,350 --> 00:15:32,220
هل السّبب هو المتجر أم الفتاة؟

314
00:15:32,530 --> 00:15:35,660
ياي-تشان، هل رأيت شيئاً أثناء عملك؟

315
00:15:35,660 --> 00:15:36,950
لا، لا شيء

316
00:15:36,950 --> 00:15:39,670
فهمت. هذا لأنّك لم تكوني تبحثين عنهم

317
00:15:39,910 --> 00:15:42,410
هل هناك قواعد حول كيفيّة ظهورها لك؟

318
00:15:43,130 --> 00:15:44,670
أفضّل ألّا يظهروا بشكل مُخيف

319
00:15:44,950 --> 00:15:48,860
لن أقول أنّه لا يوجد، لكن يعتمد الأمر
على وضعك أو وضع الرُّوح

320
00:15:48,860 --> 00:15:50,360
عليك أن تعتاد على الأمر فحسب

321
00:15:50,360 --> 00:15:52,140
"مثلما تأتي لحظة ويقول المرء فيها "فهمت

322
00:15:52,140 --> 00:15:55,810
قلّة القواعد تجعلني أشمئزّ

323
00:15:55,810 --> 00:15:59,650
لا تخل بأنّك تستطيع شرح كلّ شيء
حول شخص آخر طبقاً للقواعد

324
00:15:59,650 --> 00:16:01,210
هذه غطرسة

325
00:16:01,810 --> 00:16:02,690
آسف

326
00:16:03,390 --> 00:16:05,990
على أيّ حال، لا يمكنني القول بأنّهم
آمنون ما لم أرهم

327
00:16:05,990 --> 00:16:08,000
هل يمكنني دخول المتجر؟

328
00:16:08,000 --> 00:16:10,320
يمكنك كزبون عاديّ

329
00:16:13,830 --> 00:16:15,210
!حسناً، اعزمني

330
00:16:15,210 --> 00:16:18,290
طلبَ كلّ الطّلبات باهظة الثّمن

331
00:16:18,580 --> 00:16:20,820
تفضّل محّار مقليّ بالزّبدة

332
00:16:20,820 --> 00:16:22,290
شكراً

333
00:16:22,290 --> 00:16:23,750
هذه هي الفتاة

334
00:16:23,750 --> 00:16:25,640
...لا ألاحظ شيئاً غير مألوف

335
00:16:25,640 --> 00:16:27,220
انظر جيّداً

336
00:16:30,960 --> 00:16:32,100
!ثمّة شيء هناك

337
00:16:32,100 --> 00:16:34,760
هل ترى؟ حاول أن تجذبهم ثانية

338
00:16:35,350 --> 00:16:38,520
إنّها ضحيّة سهلة للمسّ

339
00:16:38,520 --> 00:16:39,810
!إنّهم مجموعة من المُجرمين

340
00:16:40,080 --> 00:16:43,320
ليس بسبب المتجر. إنّها هي. هذا جيّد

341
00:16:43,320 --> 00:16:45,200
!لا، الأمر ليس كذلك! أشعر بالشّفقة عليها

342
00:16:45,200 --> 00:16:46,610
ما الجيّد في ذلك؟

343
00:16:46,930 --> 00:16:50,670
لو كان المتجر، لترتّب علينا التّعامل معهم هنا

344
00:16:50,670 --> 00:16:52,720
تخيّل لو دخلتُ المشهد هنا

345
00:16:52,720 --> 00:16:54,820
قد يتمّ الإبلاغ عنّي للشّرطة

346
00:16:54,820 --> 00:16:58,180
أعتقد أستطيع تصوير الأمر
على أنّها رقصة مُعاصرة

347
00:16:58,180 --> 00:16:59,250
صحيح

348
00:17:00,460 --> 00:17:03,160
أترى كيف أنّ كلّ الزبائن ينظرون إليها؟

349
00:17:01,490 --> 00:17:02,510
!قادمة

350
00:17:03,160 --> 00:17:06,300
أجل. إنّها بهيجة وجذّابة

351
00:17:06,560 --> 00:17:11,110
والأهمّ من ذلك، ينظر النّاس دون وعي
"نحو "الوجود

352
00:17:11,110 --> 00:17:13,390
بمسّ الأرواح لها، الأمر ليس بيدهم

353
00:17:14,350 --> 00:17:18,140
كانت كافّة الزّبائن ينظرون إليها أيضاً

354
00:17:19,370 --> 00:17:20,720
الطّلب الأخير

355
00:17:20,720 --> 00:17:24,350
...هل لي بتلك الفاكهة الموسميّة سو
سوفليه؟

356
00:17:24,350 --> 00:17:27,140
هذه البانكيك. باهظة الثّمن

357
00:17:27,140 --> 00:17:32,820
بغضّ النّظر، لماذا تتصرّف وكأنّني
سأدفع ثمن الفاتورة؟

358
00:17:34,310 --> 00:17:35,980
شكراً على الانتظار

359
00:17:35,980 --> 00:17:38,310
هل هذان هما اللّذان أردتِ
أن تُعرّفيني عليهما؟

360
00:17:38,310 --> 00:17:38,910
أجل

361
00:17:39,180 --> 00:17:41,410
مرحباً. اسمي إينوكاي شيو

362
00:17:41,410 --> 00:17:43,060
مرحباً

363
00:17:43,060 --> 00:17:45,130
مَن منكما حبيب يايكو-سان؟

364
00:17:45,770 --> 00:17:47,050
ولا واحد

365
00:17:47,050 --> 00:17:51,520
يا آنسة، المعذرة، لكن هلّا طرحتُ
عليك بضعة أسئلة؟

366
00:17:51,520 --> 00:17:52,160
تفضّل

367
00:17:52,160 --> 00:17:55,300
الأوّل، هل تسمعين أصوات غريبة باستمرار
رغم عدم وجود شيء هناك؟

368
00:17:55,580 --> 00:17:58,690
!أجل، دائماً ما أسمع

369
00:17:58,690 --> 00:18:00,560
الثّاني، هل تجوعين بشكل غريب؟

370
00:18:00,560 --> 00:18:02,020
!بلى

371
00:18:02,020 --> 00:18:03,830
!أريد عشرة أطباق من المعكرونة مع الرّامن خاصّتي

372
00:18:03,830 --> 00:18:05,310
!دائماً ما أفعل

373
00:18:05,310 --> 00:18:08,970
أنا على يقين الآن. كانت عِرضة للمسّ دوماً

374
00:18:09,360 --> 00:18:11,590
والآن كيف سنُفسّر هذا لها؟

375
00:18:11,590 --> 00:18:14,020
هذا جنونيّ لدرجة أنّها تعتبر الأمر طبيعيّاً

376
00:18:14,020 --> 00:18:16,990
ماذا؟ أنا عِرضة للمسّ؟

377
00:18:18,670 --> 00:18:20,600
!هل أنتم صائدو أشباح؟

378
00:18:20,600 --> 00:18:23,000
!مُذهل! هل يمكنكم استخدام القوّة؟

379
00:18:23,220 --> 00:18:27,630
أجل، أيّاً يكن. لا مُشكلة إذا علمتْ بكلّ شيء

380
00:18:28,200 --> 00:18:29,960
لكن لا يوجد شيء هنا

381
00:18:29,960 --> 00:18:31,040
هل هي هنا؟

382
00:18:31,040 --> 00:18:32,510
!ارحلي أيّتها الأرواح الشّرّيرة

383
00:18:33,650 --> 00:18:35,480
!تقبّلَتْ ذلك بسرعة

384
00:18:35,480 --> 00:18:39,220
تميل الفتيات لقبول الأمور بسهولة بالغة

385
00:18:39,220 --> 00:18:42,100
ويميل الفتيان للمُطالبة بشرح
،وإنكار الأمر كلّياً

386
00:18:42,100 --> 00:18:45,150
أو يكونوا مُتحمّسين مُتعصّبين للخوارق

387
00:18:45,390 --> 00:18:47,730
يا آنسة، لا تريدين أن تُمَسّي، صحيح؟

388
00:18:47,730 --> 00:18:50,320
!لا! ماذا يجدر بي أن أفعل؟

389
00:18:50,600 --> 00:18:54,320
إذاً لنطلب من الأرواح المُغادرة بلطف

390
00:18:55,960 --> 00:18:59,740
،كفى مُطاردة مؤخّرة فتاة صغيرة
!يا وقود الجحيم

391
00:18:59,740 --> 00:19:00,860
!اخرجوا من هنا

392
00:19:00,860 --> 00:19:01,700
!ما مُشكلتك؟

393
00:19:01,700 --> 00:19:03,830
!كنّا نحدّق فحسب

394
00:19:04,150 --> 00:19:06,360
!لم يكن ذلك "طلب بلطف" إطلاقاً

395
00:19:06,360 --> 00:19:10,130
أجل، أعلم. بما أنّ الأمر مُهمّ، أردتُ
التّعبير عن ذلك بأدب في البداية

396
00:19:10,470 --> 00:19:13,970
لكن الأرواح وقحون بما أنّ النّاس
لا يستطيعون رؤيتهم

397
00:19:13,970 --> 00:19:17,320
دائماً ما ينتهي المطاف بالاضطرار
إلى طردهم بهذا الشّكل

398
00:19:17,320 --> 00:19:21,180
ماذا عن تُرّهات الأخلاقيّات الّتي ذكرتَها
!عن كون الأرواح بشراً؟

399
00:19:21,470 --> 00:19:22,770
...في الواقع، الأمر أشبه بـ

400
00:19:22,770 --> 00:19:24,970
"لا تُواعد، ركّز على دراستك"

401
00:19:24,970 --> 00:19:29,810
"(!لكنّكم تتواعدون، صحيح؟ يا للشّباب)

402
00:19:30,110 --> 00:19:32,150
كقول ذلك في المدرسة

403
00:19:32,150 --> 00:19:33,690
!منطقك مُستفزّ

404
00:19:33,970 --> 00:19:36,610
عليك أن تكذب أحياناً

405
00:19:36,610 --> 00:19:40,220
انظر! من النّادر أن أجمع كلّ هذا
!دُفعة واحدة

406
00:19:40,220 --> 00:19:43,160
أنت من ذكرَ النّظر إلى مؤخّرة
فتاة قدر ما تشاء

407
00:19:43,540 --> 00:19:45,080
...حسناً إذاً

408
00:19:45,080 --> 00:19:48,970
انتهينا من التّعامل مع الّذين يُغادرون
عندما تطلب منهم ذلك

409
00:19:49,430 --> 00:19:51,350
تبدأ المُشكلة الحقيقيّة الآن

410
00:19:53,840 --> 00:19:55,480
لا تنظر في العينين مباشرة

411
00:19:55,480 --> 00:19:57,340
لا تبدُ خائفاً. تصرّف بشكل طبيعيّ

412
00:19:57,340 --> 00:19:59,940
إنّه ليس مهتمّاً سوى بنفسه

413
00:19:59,940 --> 00:20:02,560
إنّه لا يرى حتّى بأنّ شيئاً حدث
للأرواح المُحيطة به

414
00:20:02,940 --> 00:20:06,830
،لكن إذا أدرك بأنّنا لاحظناه
فستكون مُشكلة حقيقيّة

415
00:20:08,040 --> 00:20:12,020
كنتُ آمل ألّا تكون ممسوسة بواسطة أحد
هؤلاء، لكنّها كذلك

416
00:20:12,020 --> 00:20:13,510
يا إلهي

417
00:20:13,510 --> 00:20:16,940
بوسعنا تركه وشأنه، بما أنّ شيو-تشان
،لا تبدو مُنزعجة منه

418
00:20:16,940 --> 00:20:20,780
لكن تتحوّل الأرواح مثله أحياناً إلى
فتيات لطيفات مثل ياي-تشان

419
00:20:20,780 --> 00:20:21,700
ماذا؟

420
00:20:22,080 --> 00:20:24,090
إنّه روح شرّيرة إذاً

421
00:20:26,930 --> 00:20:30,510
لا، مجرّد محتاج

422
00:20:30,920 --> 00:20:33,590
أخبرتُك، الأرواح بشر

423
00:20:33,590 --> 00:20:35,040
...فتاة

424
00:20:33,730 --> 00:20:35,050
بعبارة أُخرى، إنّه مُلاحق

425
00:20:35,460 --> 00:20:37,590
،الآن بعد أن أمعنتُ النّظر فيه

426
00:20:37,590 --> 00:20:40,800
لا يبدو مُخيفاً ومُريباً كما في السّابق

427
00:20:41,220 --> 00:20:44,600
أتعتقد بأنّ الطّلب من مُلاحق
أن يتركك وشأنك سيفلح؟

428
00:20:45,040 --> 00:20:46,120
لا

429
00:20:46,120 --> 00:20:46,810
صحيح؟

430
00:20:47,420 --> 00:20:49,810
البشر الأحياء لديهم الشّرطة

431
00:20:49,810 --> 00:20:52,150
فماذا نفعل إذاً بشأن الموتى؟

432
00:20:52,520 --> 00:20:55,270
ما نحتاجه هو طارد أرواح حقيقيّ

433
00:20:55,270 --> 00:20:58,650
شخص لا يجعله يُغادر فحسب، بل
يجبره على الرّقود بسلام

434
00:20:58,910 --> 00:21:01,610
لكن يا موغورا-سان، لا يمكنك طرد
الأرواح الشّرّيرة، صحيح؟

435
00:21:01,880 --> 00:21:04,580
لا، لكن أعرف شخصاً يستطيع

436
00:21:04,580 --> 00:21:06,520
لا يوجد الكثير من طاردي الأرواح الحقيقيّين

437
00:21:06,520 --> 00:21:08,400
ويطلبون أجوراً باهظة جدّاً

438
00:21:08,400 --> 00:21:11,210
لكن لديّ بعض العلاقات

439
00:21:11,710 --> 00:21:15,910
،وفي الحقيقة، إنّهم أقسى وأتفه منّي
—لذا يجب الانتباه لـ

440
00:21:16,360 --> 00:21:19,130
هل تراني؟

441
00:21:20,090 --> 00:21:24,150
هل كنت تستغيبني؟

442
00:21:24,150 --> 00:21:25,300
تُسيئ إليّ بالكلام؟

443
00:21:25,300 --> 00:21:26,870
كنتَ تُسيئ إليّ بالكلام، أليس كذلك؟

444
00:21:26,870 --> 00:21:29,020
هل تكرهني؟

445
00:21:29,420 --> 00:21:30,270
!تبّاً

446
00:21:30,770 --> 00:21:33,060
!أدرك بأنّنا نستطيع رؤيته

447
00:21:33,060 --> 00:21:33,790
!لنهرب

448
00:21:33,790 --> 00:21:34,550
ماذا؟

449
00:21:36,310 --> 00:21:38,650
!الرّوح على وشك أن تصبح محتاجة حقّاً

450
00:21:40,080 --> 00:21:42,910
أسرعوا واهزموا الرُّوح الّتي تمسّني

451
00:21:43,560 --> 00:21:45,860
الجميع يطلبون منّي دوماً "هزيمة" الأرواح

452
00:21:45,860 --> 00:21:48,160
يا لهم من أغبياء سُذّج

453
00:21:48,670 --> 00:21:51,360
لِمَ لا تبحثون عن سيف مُقدّس
،قاتل للأشباح فحسب

454
00:21:51,360 --> 00:21:54,600
وتنضمّون لفرقة صيد أشباح
،وتبتكروا اسم قدرة رائعة ما

455
00:21:54,600 --> 00:21:58,170
وتهزمون الشّبح بحركتكم القاتلة وتموتون
ميتة جميلة أثناء فعل ذلك

456
00:21:58,170 --> 00:22:00,550
!وتصبحوا شبحاً بحدّ ذاتكم

457
00:22:01,040 --> 00:22:04,060
حينها سأطردك روحيّاً