1
00:01:36,550 --> 00:01:41,740
إن كانت سيّئة الحظّ، فلا بُدّ من وجود
مُشكلة جوهريّة

2
00:01:41,740 --> 00:01:43,990
!أخبريني رجاء

3
00:01:43,990 --> 00:01:46,290
أحضرتُ مالاً

4
00:01:46,290 --> 00:01:48,230
تستحقّ قراءة بختكِ هذه القيمة

5
00:01:48,230 --> 00:01:49,240
!لا، لا داعي

6
00:01:49,240 --> 00:01:51,420
الدّفع لي لن يُشكّل فرقاً

7
00:01:51,420 --> 00:01:54,010
أنا أرى أشياء غريبة بين الحين والآخر فحسب

8
00:01:54,010 --> 00:01:55,710
إنّها ليست قدرة مُفيدة

9
00:01:55,710 --> 00:01:57,430
!لا تكوني مُتواضعة

10
00:01:57,430 --> 00:01:59,720
لقد أنقذتِني

11
00:01:59,720 --> 00:02:03,030
تحلّي بثقة أكبر بالذّات! يمكنكِ
!رؤية المُستقبل

12
00:02:06,020 --> 00:02:09,380
!ابحثي عن ثقتكِ وألقي نظرة إلى مُستقبلي

13
00:02:09,380 --> 00:02:11,900
لِمَ لا تستطيعين توجيه تلك الثّقة
تجاه نفسكِ؟

14
00:02:11,900 --> 00:02:14,950
اسمعي، حتّى لو رأيتُ شيئاً، هذا
ليس صحيحاً بالضّرورة

15
00:02:14,950 --> 00:02:17,810
لا أريد تعظيم مخاوفكِ وقلقكِ

16
00:02:17,810 --> 00:02:21,450
،لكن سيفوت الأوان حالما تقع البليّة
!ألا تعتقدين ذلك؟

17
00:02:21,450 --> 00:02:24,950
على أيّ حال، أخبريني أرجوكِ
!بما ترينه الآن

18
00:02:24,950 --> 00:02:26,060
أرى مساماتكِ

19
00:02:26,060 --> 00:02:27,790
ينبغي أن تبدئي بتغيير كريم الأساس

20
00:02:28,750 --> 00:02:33,110
رأيتُكِ تمسكين بمـ-مانيكي-نيكو

21
00:02:33,110 --> 00:02:34,500
مانيكي-نيكو؟

22
00:02:34,500 --> 00:02:36,170
!هل ينبغي أن أشتري واحداً؟

23
00:02:36,170 --> 00:02:37,930
لـ-لا أعلم

24
00:02:38,610 --> 00:02:42,470
لكن لا أريدكِ أن تشتري شيئاً
،استناداً إلى كلامي الفارغ

25
00:02:42,470 --> 00:02:46,110
،ولدينا الكثير من المانيكي-نيكو
لذا يمكنكِ أخذ واحد

26
00:02:46,110 --> 00:02:47,170
!حقّاً؟

27
00:02:47,170 --> 00:02:49,930
!يا لكِ من شخص طيّب يا كيوكو-سان

28
00:02:49,930 --> 00:02:52,440
!أنتِ فتيّة ومُبتهجة حقّاً! أحترمكِ كثيراً

29
00:02:54,190 --> 00:02:56,360
!شكراً على مُساعدتكِ

30
00:02:58,710 --> 00:03:00,490
يراودني شعور سيّئ حيال هذا

31
00:03:03,850 --> 00:03:05,060
عُدت

32
00:03:06,100 --> 00:03:08,750
،رغم ذلك، يعيش الأطفال في الحرم

33
00:03:08,750 --> 00:03:11,580
وسيذهب زوجي غالباً للشّرب
قبل العودة إلى المنزل

34
00:03:11,580 --> 00:03:13,290
لكن لا أستطيع أن أشتكي

35
00:03:13,780 --> 00:03:15,370
أعيش حياة لطيفة

36
00:03:16,310 --> 00:03:18,400
عدتُ يا ريكي

37
00:03:18,400 --> 00:03:20,840
انظر. إنّه مانيكي-نيكو

38
00:03:21,490 --> 00:03:24,070
ريكي، ما الّذي يوجد في فمك؟

39
00:03:32,350 --> 00:03:34,230
انكسر شيء ما مجدّداً

40
00:03:34,230 --> 00:03:35,860
إنّها قبضة

41
00:03:35,860 --> 00:03:38,770
ريكي، لا تلمس هذا. إنّه خطير

42
00:03:38,770 --> 00:03:40,110
هل أنت من كسر هذا؟

43
00:03:40,400 --> 00:03:43,370
لكن يتجنّب ريكي الأشياء عندما يمشي

44
00:03:44,500 --> 00:03:45,710
رأسي يؤلمني

45
00:03:45,710 --> 00:03:47,610
ربّما سآخذ بقيّة اليوم إجازة

46
00:03:47,610 --> 00:03:50,450
لكن سيوبّخني زوجي على كسلي ثانية

47
00:04:10,330 --> 00:04:11,630
...كيوكو-سان

48
00:04:12,790 --> 00:04:14,140
...يجب أن أخبر كيوكو-سان

49
00:04:18,300 --> 00:04:19,510
!مؤلم

50
00:04:19,510 --> 00:04:20,730
أنا تعيسة الحظّ تماماً

51
00:04:20,730 --> 00:04:23,570
يـ-يجب أن أتكلّم مع كيوكو-سان ثانية

52
00:04:24,050 --> 00:04:25,490
أقفلي الباب

53
00:04:25,490 --> 00:04:26,410
...بسرعة

54
00:04:26,410 --> 00:04:27,550
!مؤلم

55
00:04:28,390 --> 00:04:29,480
!شعري

56
00:04:29,480 --> 00:04:31,120
!الكارثة تلو الكارثة

57
00:04:31,820 --> 00:04:33,500
!النّجدة يا كيوكو-سان

58
00:04:33,500 --> 00:04:36,520
!لماذا تستمرّ هذه الأمور بالحدوث معي؟

59
00:04:37,630 --> 00:04:38,880
!انظروا جميعاً

60
00:04:38,880 --> 00:04:41,510
!أعددتُ خوذة التّونا

61
00:04:41,510 --> 00:04:43,660
من سيبقى لتناول العشاء؟

62
00:04:43,660 --> 00:04:44,700
!أنا

63
00:04:44,700 --> 00:04:46,600
!ماذا؟ أريد تناول عشاء

64
00:04:46,600 --> 00:04:50,600
من الوقاحة البقاء لتناول العشاء
في أوّل زيارة لك

65
00:04:50,600 --> 00:04:52,100
لِمَ لا؟

66
00:04:52,100 --> 00:04:55,700
إنّ إنقاذ سُلحفاة أكسبَ أوراشيما تارو
عشاء في قصر ملك التنّين

67
00:04:57,650 --> 00:04:59,230
!قادمة! أنا قادمة

68
00:04:59,230 --> 00:05:00,040
!كيوكو-سان

69
00:05:00,040 --> 00:05:01,570
!كيوكو-سان! كيوكو-سان

70
00:05:01,570 --> 00:05:03,630
!لم يفلح ذلك! لم يفلح ذلك ثانية

71
00:05:03,630 --> 00:05:06,740
لماذا؟ أخذتُ معي إلى المنزل مانيكي-نيكو
!وفقاً لتنبّؤاتكِ

72
00:05:06,990 --> 00:05:10,130
!ما الخطأ الّذي أرتكبه؟ لا ينفك يحدث هذا

73
00:05:10,130 --> 00:05:12,120
!حتّى عندما أفعل ما تُملينه عليّ، لا يفلح ذلك

74
00:05:12,120 --> 00:05:14,660
لحظة! ماذا حدث يا ساكوراكو-سان؟

75
00:05:14,660 --> 00:05:16,410
فضلاً عن ذلك، لم أتنبّأ بشيء

76
00:05:16,410 --> 00:05:18,460
!لم أخبركِ حتّى بأن تفعلي ما أُمليه

77
00:05:18,460 --> 00:05:19,150
...لكن

78
00:05:19,150 --> 00:05:20,620
اهدئي رجاء

79
00:05:20,620 --> 00:05:22,080
ماذا حدث؟

80
00:05:22,080 --> 00:05:24,340
أ... أنا آسفة

81
00:05:25,890 --> 00:05:27,000
ما الخطب؟

82
00:05:28,680 --> 00:05:30,050
أعلم

83
00:05:30,310 --> 00:05:34,810
أعلم بأنّني مُعجبة بكيوكو-سان ببساطة

84
00:05:42,570 --> 00:05:44,770
إنّهما زوجان مُبهران بالرّغم
من صغر سنّهما

85
00:05:44,770 --> 00:05:46,570
يبدوان مُقرّبين كثيراً أيضاً

86
00:05:46,570 --> 00:05:48,190
مرحباً يا عزيزي؟

87
00:05:48,190 --> 00:05:51,530
أنا جاهزة للذّهاب. هل ستأتي
إلى هنا قريباً؟

88
00:05:51,530 --> 00:05:53,310
ألا يمكنك الذّهاب إلى المنزل بمفردك؟

89
00:05:54,790 --> 00:05:57,880
تلك المدرسة الثّقافيّة هي هدر للمال

90
00:05:57,880 --> 00:06:00,290
أنتِ فظيعة في كلّ ما تفعلينه

91
00:06:00,820 --> 00:06:03,250
الأطفال هم مسؤوليّتكِ

92
00:06:08,010 --> 00:06:11,010
يسرّني أنّ أخاك يشعر بتحسُّن اليوم

93
00:06:11,010 --> 00:06:14,220
المعذرة يا أمّي، تفوّقتُ في اختباري

94
00:06:14,710 --> 00:06:17,460
أنا مسرورة لأجلكِ. سنتكلّم لاحقاً، اتّفقنا؟

95
00:06:17,460 --> 00:06:19,850
هلّا أحضرتِ لي دواء أخيكِ؟

96
00:06:19,850 --> 00:06:22,150
ساكو-تشان، أنتِ صبورة جدّاً

97
00:06:22,150 --> 00:06:24,430
كنتُ لأوبّخ ذلك السّينباي بلهجة شديدة

98
00:06:24,430 --> 00:06:26,660
إنّه يستغلّ نفوذه

99
00:06:27,610 --> 00:06:30,610
يجب على ساكوراكو أن تتعلّم
الردّ على الآخرين

100
00:06:30,610 --> 00:06:32,740
لماذا أصبحتْ هكذا؟

101
00:06:32,740 --> 00:06:36,090
حماقتكِ مُستفزّة للغاية

102
00:06:36,090 --> 00:06:40,170
قد تكونين عديمة الفائدة، لكن على الأقلّ
أعدّي شيئاً أفضل من نفايات الخنزير هذه

103
00:06:43,670 --> 00:06:45,650
أعلم

104
00:06:46,620 --> 00:06:51,180
أعلم بأنّني لا أستطيع أن أعيش حياة كحياتهم

105
00:06:52,870 --> 00:06:54,180
...لكن أحدكم

106
00:06:55,560 --> 00:06:59,690
فليُخبرني رجاء بأنّ حياتي طبيعيّة

107
00:07:02,400 --> 00:07:04,060
!أنتِ

108
00:07:04,060 --> 00:07:06,900
إن كنتِ تؤمنين بقراءة البخت، فهل
تؤمنين بطرد الأرواح الشّرّيرة أيضاً؟

109
00:07:06,900 --> 00:07:07,820
ماذا؟

110
00:07:07,820 --> 00:07:11,820
هناك أشياء لا تستطيع أمّي رؤيتها

111
00:07:12,060 --> 00:07:15,840
،بعبارة أُخرى، ما لم تُعالجي السّبب
!ستحصلين دوماً على نفس النّتيجة

112
00:07:15,840 --> 00:07:18,410
لا يوجد شيء يُدعى بالعيون القديرة
!الّتي تستطيع رؤية كلّ شيء

113
00:07:18,410 --> 00:07:22,580
هل أنتِ متأكّدة بأنّكِ لستِ الشّخص
الّذي يرفض رؤية ما حوله؟

114
00:07:22,580 --> 00:07:24,750
!لهذا تظلّ الأرواح تستغلّكِ

115
00:07:26,730 --> 00:07:29,280
ما الّذي يتحدّث عنه؟

116
00:07:29,280 --> 00:07:31,340
...في الواقع

117
00:07:31,340 --> 00:07:33,910
إنّها ممسوسة بواسطة الكثير
من الأرواح البغيضة

118
00:07:34,850 --> 00:07:35,960
ألم أخبرك؟

119
00:07:35,960 --> 00:07:38,970
الأرواح لا تدخل هذا المنزل في العادة

120
00:07:38,970 --> 00:07:41,850
لكن هؤلاء اقتحموا منزل باكينيكو عنوة

121
00:07:41,850 --> 00:07:46,400
إنّهم من الأشخاص الّذين يدخلون الأماكن
المسكونة لركل القبور في الحياة

122
00:07:46,400 --> 00:07:48,070
لا أريد أن أتورّط معهم

123
00:07:48,070 --> 00:07:51,280
على أيّ حال، ما كان ينبغي
،أن أضحك غالباً

124
00:07:51,520 --> 00:07:54,530
لكن سبب صُداعها تافه جدّاً

125
00:08:03,640 --> 00:08:05,960
لم أكن أدري ما إن كان ينبغي
أن أقول شيئاً

126
00:08:05,960 --> 00:08:08,400
ردود فعل هذه السيّدة مُضحكة للغاية

127
00:08:08,400 --> 00:08:09,670
لنُحرّضها أكثر

128
00:08:09,670 --> 00:08:12,340
يمكننا استخدام القطط الضّخمة
في هذا المنزل

129
00:08:12,340 --> 00:08:15,670
بما أنّ الباندا الأحمر الّذي قبضنا عليه
...قبل أيّام قد هرب

130
00:08:15,670 --> 00:08:18,360
بعد المانيكي-نيكو، لنقلب المذبح

131
00:08:18,360 --> 00:08:19,970
هل من شيء مشؤوم أكثر من ذلك؟

132
00:08:20,930 --> 00:08:25,020
أنتِ تُحوّلين نفسكِ إلى ألعوبة
للأرواح الوضيعة

133
00:08:25,250 --> 00:08:27,050
!لا تدعي أولئك الأغبياء يستغلّونكِ

134
00:08:27,050 --> 00:08:28,900
!وكفّي عن مُعاملة النّاس وكأنّهم خارقون

135
00:08:29,270 --> 00:08:31,230
،هذا هو اختصاصي

136
00:08:31,230 --> 00:08:33,950
!لذا سوف أطرد البليّة الّتي تتشبّث بكِ

137
00:08:34,270 --> 00:08:36,290
!لكن لا أفعل هذا لأجلكِ

138
00:08:36,290 --> 00:08:39,450
!أكره إفسادكِ لمساحتي الآمنة فحسب

139
00:08:39,450 --> 00:08:42,440
!نابيشيما، داهم هؤلاء منطقتك

140
00:08:42,440 --> 00:08:43,580
!التهمهم

141
00:08:49,550 --> 00:08:51,200
!لـ-لا، انتظر

142
00:08:51,200 --> 00:08:52,840
!يبدو هذا سيّئاً حقّاً

143
00:08:53,700 --> 00:08:56,130
يشعر نابيشيما بالتحفُّز اليوم، أليس كذلك؟

144
00:08:56,130 --> 00:08:58,050
يكون نكِداً أحياناً

145
00:08:58,050 --> 00:09:01,600
عبسَ عندما لم يكن محطّ اهتمام
في متجر المئة ين

146
00:09:01,600 --> 00:09:04,350
ماذا؟ لا أستطيع رؤيته، لكن يبدو ظريفاً

147
00:09:05,010 --> 00:09:05,980
طرد أرواح؟

148
00:09:09,370 --> 00:09:10,900
!الحيوانات سريعة في الهرب

149
00:09:12,470 --> 00:09:14,570
أشعر وكأنّ ألم رأسي قد زال

150
00:09:14,890 --> 00:09:18,000
يمتلك ابنك قوى خارقة أيضاً

151
00:09:18,000 --> 00:09:20,080
إنّه ابن جيّد جدّاً أيضاً

152
00:09:20,080 --> 00:09:23,700
أنا مُثيرة جدّاً للشّفقة

153
00:09:23,700 --> 00:09:27,330
كيوكو-سان، أحسدك

154
00:09:28,750 --> 00:09:31,710
قلتِ أخيراً ما تشعرين به فعليّاً

155
00:09:31,710 --> 00:09:32,590
ماذا؟

156
00:09:32,590 --> 00:09:34,760
سمعتُ ما قلتِه قبل قليل

157
00:09:34,760 --> 00:09:38,470
أنتِ مُتقبّلة جدّاً واتّكاليّة كثيراً على
الآخرين، لكنّكِ شخص طيّب

158
00:09:40,220 --> 00:09:42,890
كنتَ تستمع؟ لماذا؟

159
00:09:42,890 --> 00:09:44,430
وأيضاً، من أنت؟

160
00:09:44,690 --> 00:09:47,570
لكن الطّيبة الزّائدة عن اللّزوم
ليست جيّدة أيضاً

161
00:09:47,570 --> 00:09:50,440
تمّ التخلُّص من البليّة، لكنّكِ
لم تتعافي تماماً

162
00:09:50,440 --> 00:09:54,150
ما لم تتغيّري، سيعود أولئك
المُريبون البغيضون فوراً

163
00:09:54,150 --> 00:09:56,080
كلّاً من الأحياء والموتى

164
00:09:56,080 --> 00:09:58,450
يجب أن تتعلّمي أن تشتكي وتغضبي

165
00:09:58,450 --> 00:10:01,540
لكن زوجي لا يُحبّ ذلك

166
00:10:01,540 --> 00:10:05,410
بالإضافة إلى أنّني لستُ في موقف
يسمح لي بالشّكوى

167
00:10:05,410 --> 00:10:07,540
أجل، هذا ما يقوله الجميع

168
00:10:07,540 --> 00:10:11,520
رأيتُ كثيراً من الرّجال والنّساء مثلك

169
00:10:11,520 --> 00:10:13,460
تحوّلتِ إلى كلب بافلوف

170
00:10:13,460 --> 00:10:16,640
أعتقد يُطلقون عليها في هذه الأيّام
بالإساءة النّفسيّة وغسيل الدّماغ

171
00:10:16,640 --> 00:10:17,840
هل يبدو هذا مألوفاً؟

172
00:10:17,840 --> 00:10:20,890
تختلف الظّروف، لكن الأزواج العنيفين
وسليطي اللّسان

173
00:10:20,890 --> 00:10:23,680
والزّوجات الهستيريات هم أمثلة نموذجيّة

174
00:10:23,680 --> 00:10:27,350
وعموماً نراهم مع شُركاء صبورين جدّاً

175
00:10:27,350 --> 00:10:31,020
،وأيضاً سامحيني إن كنتُ مُخطئاً
...لكن بالرّجوع للخلف قليلاً

176
00:10:31,020 --> 00:10:35,150
هل ترعرعتِ لتكوني صبورة مع أمّكِ أم أبيكِ؟

177
00:10:39,350 --> 00:10:42,490
يا عمّة، لا تضعي ثقتكِ في الأمور الخطأ

178
00:10:42,490 --> 00:10:48,360
أكره "التّبصير الدّقيق" الّذي يُجرّد النّاس
فُرصة حلّ مشاكلهم بأيديهم

179
00:10:49,070 --> 00:10:53,750
قدر عائلتنا بعيش أعمار قصيرة
قد تغيّر بشكل قسريّ

180
00:10:54,300 --> 00:10:56,800
بالتّضحية بشخص فريد من نوعه

181
00:10:57,240 --> 00:10:59,560
،رأيتُ ذلك مُثيراً للشّفقة

182
00:10:59,560 --> 00:11:03,160
لذا أحلّ كافّة مشاكلي الأُخرى بنفسي

183
00:11:03,690 --> 00:11:05,470
حتّى عندما لا أستطيع، أبحث عن طريقة

184
00:11:08,050 --> 00:11:09,840
لا أُوافقك يا كيو-تشان

185
00:11:09,840 --> 00:11:11,920
،آسف لتعكير كلامك المُلهِم هذا

186
00:11:11,920 --> 00:11:13,520
لكن كأنّك تُثقِل في الطّلبات وبصورة سريعة

187
00:11:14,650 --> 00:11:17,860
يجب عليك أن تضع ظروفها بعين الاعتبار

188
00:11:18,300 --> 00:11:19,800
هل تحتاج بعض المُساعدة؟

189
00:11:19,800 --> 00:11:21,470
ماذا؟

190
00:11:23,180 --> 00:11:24,950
عُدت

191
00:11:25,730 --> 00:11:27,080
المكان مُظلم هنا

192
00:11:30,200 --> 00:11:33,410
ماذا تفعلين؟ أنتِ تُخيفينني

193
00:11:33,410 --> 00:11:34,850
أين العشاء؟

194
00:11:35,820 --> 00:11:36,740
لا يوجد

195
00:11:36,740 --> 00:11:39,300
!ماذا؟! كيف تجرئين على التكلُّم معي هكذا؟

196
00:11:41,050 --> 00:11:42,780
!لا تعبثي معي

197
00:11:42,780 --> 00:11:44,200
من تعتقدين نفسكِ؟

198
00:11:44,200 --> 00:11:47,010
أنتِ عاجزة أساساً، والآن لا تستطيعين
حتّى أن تطبخي؟

199
00:11:47,790 --> 00:11:49,980
!اصمت أيّها الوغد

200
00:11:49,980 --> 00:11:51,880
!من تعتقد نفسك؟

201
00:11:51,880 --> 00:11:53,060
هل تريد أن تُلعَن؟

202
00:11:53,380 --> 00:11:55,270
!أيّتها التّافه، تافه، تافه

203
00:11:55,270 --> 00:11:57,730
عشاء، عشاء! ما أنت؟ خنزير؟

204
00:11:57,730 --> 00:11:59,760
!لا، هذه وقاحة بحقّ الخنازير

205
00:11:59,760 --> 00:12:01,940
!كفّ عن الاستخفاف بي

206
00:12:01,940 --> 00:12:04,570
لم تقُم بأيّ عمل حقيقيّ فقط لأنّ
،أقرباءك مسؤولون تنفيذيّون

207
00:12:04,570 --> 00:12:07,620
وأعلم بأنّك تستعمل خدمة فتيات عبر الهاتف
!وتضعها تحت بند نفقات عمل

208
00:12:07,620 --> 00:12:11,500
إذا كنت ستسخر من الآخرين، فحضّر
!نفسك إذاً لبقيّة حياتك

209
00:12:11,500 --> 00:12:14,120
!يمكننا مُناقشة عيوبنا بعد ذلك

210
00:12:21,230 --> 00:12:22,810
!مرحباً يا أمّي؟

211
00:12:22,810 --> 00:12:24,850
!لن آتي إلى المنزل في عطلة الأسبوع المُقبل

212
00:12:24,850 --> 00:12:26,850
!من سيقلّ أخي؟ لا أُبالي

213
00:12:27,190 --> 00:12:30,270
!إنّه سليم صحّياً الآن! يستطيع فعلها بنفسه

214
00:12:30,270 --> 00:12:34,600
ما الّذي تفعله أمٌّ في السّبعين من عمرها
برعاية ابنها الّذي شارف بلوغ الخمسين؟

215
00:12:34,600 --> 00:12:36,840
!اصمتيّ! هذه ليست مُشكلتي

216
00:12:36,840 --> 00:12:38,650
!لا تُقلّلي من احترامي ثانية

217
00:12:44,570 --> 00:12:45,410
ماذا؟

218
00:12:48,800 --> 00:12:51,750
هل قلتُ ذلك؟ هل قلتُ ذلك
الكلام المجنون؟

219
00:12:52,010 --> 00:12:55,550
ربّما شدّدتُ وقسوتُ كثيراً دون شعور

220
00:12:55,930 --> 00:12:57,860
أنا آسفة يا أمّي

221
00:12:57,860 --> 00:12:59,290
...لكن الغريب

222
00:12:59,290 --> 00:13:03,880
أشعر وكأنّ شيئاً ما كان مسدوداً
وانفتح أخيراً

223
00:13:04,380 --> 00:13:08,680
تحتاج لتجربة نجاح قولها بلسانها

224
00:13:08,680 --> 00:13:11,970
،ارتأيتُ بأنّ مسّ مُؤمن سوف يفلح

225
00:13:11,970 --> 00:13:14,310
لكن كان كلّ ما فعلتُه هو مدّ يد العون لها

226
00:13:14,620 --> 00:13:16,630
كلّ ما قالته كان ما شعرَتْ به فعليّاً

227
00:13:16,970 --> 00:13:22,290
سنوات خبرتي العشرة كروح كانت
مُلائمة لشخصيّتها العِرضة للهوس

228
00:13:22,290 --> 00:13:24,910
حسناً، لقد اقتنعت

229
00:13:24,910 --> 00:13:27,200
لكن قلتُ لكِ أن ترقدي بسلام يا مايا-تشان

230
00:13:27,420 --> 00:13:30,260
ارتأيتُ بأنّه من الأفضل أن أشكرك أوّلاً

231
00:13:30,260 --> 00:13:33,160
"حتّى السّلاحف تقول "شكراً لك
عندما ينقذها شخص، صحيح؟

232
00:13:33,410 --> 00:13:35,650
،وبما أنّني كنتُ في المنزل لفترة طويلة

233
00:13:35,650 --> 00:13:37,940
أردتُ رؤية المدينة قبل أن أُغادر

234
00:13:37,940 --> 00:13:40,790
ظهرتِ في الوقت المُناسب أيضاً

235
00:13:41,380 --> 00:13:45,730
تلك الفتاة كانت ممسوسة بواسطة مجموعة
من الأرواح، لذا لحقتُ بهم إلى هنا

236
00:13:46,180 --> 00:13:47,540
عدتِ؟

237
00:13:47,540 --> 00:13:49,390
قالت أمّك بأنّني أستطيع المجيء

238
00:13:49,390 --> 00:13:53,470
فهمت. كان حول شيو-تشان الكثير
من الأرواح الّتي لم ألحظها

239
00:13:53,470 --> 00:13:56,420
هنا تمّ التخلّص من الدُّمية، صحيح؟

240
00:13:56,420 --> 00:13:57,470
شكراً لك

241
00:13:58,030 --> 00:14:00,910
لكن كنتِ قادرة على فعل هذا
فقط لأنّكِ روح

242
00:14:00,910 --> 00:14:01,480
أجل

243
00:14:01,480 --> 00:14:04,740
وأستطيع لمس تلك القطّة لأنّني
روح، أليس كذلك؟

244
00:14:05,780 --> 00:14:08,030
كيوكو-سان، هل أنتِ في المنزل؟

245
00:14:08,980 --> 00:14:10,030
!يا للمفاجأة

246
00:14:10,740 --> 00:14:14,030
أنا آسفة على كلّ المشاكل الّتي سبّبتُها

247
00:14:14,030 --> 00:14:15,080
هذه لكِ

248
00:14:15,080 --> 00:14:17,320
لم يكن عليكِ فعل ذلك

249
00:14:17,320 --> 00:14:19,460
!لا، اقبليها أرجوكِ

250
00:14:19,780 --> 00:14:21,460
في هذه الحالة، شكراً لكِ

251
00:14:21,460 --> 00:14:22,790
يبدو شعركِ رائعاً

252
00:14:23,030 --> 00:14:24,100
لِمَ لا تدخلين؟

253
00:14:24,100 --> 00:14:26,270
أعددتُ دوراياكي عملاقاً

254
00:14:26,270 --> 00:14:29,090
لا. ينبغي أن أذهب

255
00:14:29,090 --> 00:14:30,380
انتظري

256
00:14:31,610 --> 00:14:32,450
تفضّلي

257
00:14:34,430 --> 00:14:36,580
تمكّنتِ من إصلاحه بعد أن انكسر؟

258
00:14:36,580 --> 00:14:37,540
!مُذهل

259
00:14:37,540 --> 00:14:38,690
هو من فعل ذلك

260
00:14:38,690 --> 00:14:40,860
يُدعى هذا كينتسوغي

261
00:14:40,860 --> 00:14:42,290
أفضل من السّابق، صحيح؟

262
00:14:42,290 --> 00:14:44,690
سيدفع النّيكوزوكو ثمنه. لا تقلقي

263
00:14:44,690 --> 00:14:47,670
مُدهش. أهذه حرفتك؟

264
00:14:47,670 --> 00:14:48,950
نوعاً ما

265
00:14:49,170 --> 00:14:51,420
أنا ماهر في إطالة الأعمار

266
00:14:51,420 --> 00:14:55,460
ساكوراكو-سان، رأيتُ رؤية لنا
،ونحن نذهب لحضور الأفلام

267
00:14:55,460 --> 00:14:58,180
ونتناول السّوشي ونشرب معاً

268
00:14:58,180 --> 00:15:00,670
يجب أن نفعل المُستحيل
لتحويل ذلك إلى حقيقة

269
00:15:02,450 --> 00:15:04,400
هذا صحيح، أليس كذلك؟

270
00:15:04,400 --> 00:15:06,250
...الجميع يحتاجون

271
00:15:06,520 --> 00:15:09,890
صديقاً ثريّاً ليدعوهم لتناول سوشي

272
00:15:09,890 --> 00:15:11,220
لا أعتقد بأنّ هذا صحيح

273
00:15:11,220 --> 00:15:16,180
بالمُناسبة يا عمّة، ماذا رأيتِ
عندما التقينا أوّل مرّة؟

274
00:15:17,400 --> 00:15:18,430
لن أخبركِ

275
00:15:18,900 --> 00:15:21,810
سيأتي المُستقبل سواء أخبرتُكِ أم لا

276
00:15:21,810 --> 00:15:24,190
أكل السّوشي هو أكثر أهمّية

277
00:15:24,860 --> 00:15:26,360
!حسناً

278
00:15:28,150 --> 00:15:30,850
كيوكو، عائلتنا مُعقَّدة

279
00:15:30,850 --> 00:15:32,860
ستُعانين أكثر من الشّخص العاديّ

280
00:15:32,860 --> 00:15:35,030
ينبغي أن أعتذر سلفاً. آسف

281
00:15:35,030 --> 00:15:38,870
لكن موغورا-سان يُساعدنا، والمنزل
واسع ومُمتع

282
00:15:38,870 --> 00:15:40,620
!كلّ ما أراه هو مُستقبلاً مُثيراً للاهتمام

283
00:15:42,980 --> 00:15:44,250
حسناً، يجدر بي أن أذهب

284
00:15:44,250 --> 00:15:46,250
سأغادر أيضاً. إلى اللّقاء

285
00:15:47,190 --> 00:15:49,260
!أنت أحد زبائننا المُنتظمين

286
00:15:49,260 --> 00:15:51,030
!البيض بـ 100 ين اليوم

287
00:15:51,030 --> 00:15:51,840
!ينبغي أن تزورنا

288
00:15:51,840 --> 00:15:54,460
أنا في طريقي إلى الصّالة الرّياضيّة
!رفقة زوجة فوجيمورا-سان

289
00:15:54,460 --> 00:15:56,220
ثمّ بعد ذلك، سأنظّف مع رابطة الحّيّ

290
00:15:56,220 --> 00:15:57,150
!إلى اللّقاء

291
00:15:57,150 --> 00:15:59,170
يوشيدا-سان قويّة جدّاً

292
00:15:59,170 --> 00:16:01,020
ينبغي أن أكون مثلها

293
00:16:02,130 --> 00:16:05,150
بالمناسبة، الأرواح المُلتهَمة تُفرَز

294
00:16:05,150 --> 00:16:07,440
ويجب أن تنتظر شخصاً حتّى
يأتي ويأخذها

295
00:16:08,220 --> 00:16:12,740
بينما في هذه الأثناء، عثر ثعلب
الماء على منزل جديد

296
00:16:12,740 --> 00:16:15,040
بات رأسي يؤلمني مؤخّراً

297
00:16:15,040 --> 00:16:16,280
ربّما لأنّني كبرتُ

298
00:16:16,280 --> 00:16:19,370
هل يعتقد بأنّه وحش بحر أو ما شابه؟

299
00:16:20,860 --> 00:16:22,660
أصلحتها

300
00:16:22,660 --> 00:16:25,930
لم أكن أتوقّع الكثير عندما طلبتُ
منك إصلاح ساعة يد أبي

301
00:16:25,930 --> 00:16:29,620
استطعتُ بالطّبع. مُعظم الأشياء
يمكن إصلاحها

302
00:16:29,990 --> 00:16:32,380
،كلّ ما في الأمر أنّ في هذه الأيّام
،من الأسرع شراء بديل

303
00:16:32,380 --> 00:16:34,380
لذا مضى وقت منذ أدّيتُ هذا
العمل آخر مرّة

304
00:16:34,380 --> 00:16:37,020
هذا مُدهش. هل يمكنك إصلاح أيّ شيء؟

305
00:16:37,020 --> 00:16:40,090
بكلّ تأكيد. كلّ شيء باستثناء طبيعة الشّخص

306
00:16:40,090 --> 00:16:41,850
وأشياء مثل الهواتف الذّكيّة

307
00:16:42,550 --> 00:16:44,090
تفضّل قسطك

308
00:16:44,090 --> 00:16:45,770
آسف لأنّني طلبتُ منك الدّفع

309
00:16:45,770 --> 00:16:47,360
هذا طبيعيّ فحسب

310
00:16:47,680 --> 00:16:50,780
وإن كنتَ ستعتذر على ذلك، كُفّ
عن تسوُّل الطّعام منّي

311
00:16:52,060 --> 00:16:53,530
أتعلم؟

312
00:16:53,530 --> 00:16:56,280
هذان أمران مُختلفان تماماً

313
00:16:59,130 --> 00:17:03,590
،الآن بعد أن ألقيتُ نظرة عن كثب
يبدو أنّك تصنع وتُصلح مُختلف الأشياء

314
00:17:03,590 --> 00:17:06,510
لست بحاجة لمُؤهّلات لصنع هذه الأشياء

315
00:17:06,970 --> 00:17:10,280
مؤخّراً، كنتُ أحضر فعاليّات حِرفيّات يدويّة

316
00:17:10,280 --> 00:17:14,170
أسجِّل باستعارة الإنترنت الخاصّ
بمتجر السّكاكر ورقم الهاتف

317
00:17:14,750 --> 00:17:17,370
أعتقد بأنّ هذا يفي بالغرض

318
00:17:17,370 --> 00:17:21,690
كيوكو-تشان تشتري هذه عندما
أصنعها بين الحين والآخر

319
00:17:21,690 --> 00:17:22,980
كيوكو-تشان؟

320
00:17:22,980 --> 00:17:24,450
زوجة توشيرو

321
00:17:24,450 --> 00:17:25,810
زوجة الأستاذ؟

322
00:17:25,810 --> 00:17:28,340
إنّها تأتي إلى الجامعة أحياناً

323
00:17:28,340 --> 00:17:29,570
نسيت هذه

324
00:17:29,570 --> 00:17:32,820
ما كنتُ لأتوقّع أبداً بأنّ لديهما
ابن بسنّ الثّانويّة

325
00:17:32,820 --> 00:17:36,100
...لا تستطيع كيوكو-تشان رؤية إيكيبوكورو-سان

326
00:17:36,100 --> 00:17:38,180
!هذا هو شكلها إذاً

327
00:17:38,180 --> 00:17:39,740
إذاً إنّها تشتري هذه بكلّ سرور

328
00:17:40,030 --> 00:17:41,080
هكذا إذاً

329
00:17:43,830 --> 00:17:46,020
هناك المزيد في الطّابق الثّاني

330
00:17:46,020 --> 00:17:46,960
أتريدان أن تريا؟

331
00:17:51,800 --> 00:17:53,630
هذا طعام مُزيّف

332
00:17:53,850 --> 00:17:58,010
الأمر برمّته مُمتع، لكن يشتريها بعض
النّاس كزينة أو إكسسوارات

333
00:17:58,250 --> 00:18:02,930
الفرن مُستعمَل، لكن اشتريتُه لأنّني أستطيع
استخدامه لصنع هذه والفخّاريّات

334
00:18:02,930 --> 00:18:04,550
أنت ماهر في استخدام يديك

335
00:18:04,550 --> 00:18:07,060
كنتُ أصنع سكاكر حيوانات

336
00:18:07,290 --> 00:18:09,440
يشتري النّاس الأشياء الظّريفة

337
00:18:09,970 --> 00:18:12,960
بعد الحرب، بعتُ سمكاً بديل الأودون

338
00:18:12,960 --> 00:18:16,570
بصراحة، كان من السّهل بالنّسبة لي
إيجاد عمل في السّوق السّوداء

339
00:18:16,570 --> 00:18:17,970
لا حاجة للسّيرة الذّاتيّة

340
00:18:17,970 --> 00:18:20,820
لستُ جيّداً في التّعامل مع البدلات
الرّسميّة وجُباة الدّيون

341
00:18:21,050 --> 00:18:25,250
الأجر جيّد، لكن يُرهِق العقل ومن
الصّعب جدّاً الخروج

342
00:18:25,640 --> 00:18:28,400
هذه سرقة للطّباعة الخشبيّة الشّهيرة

343
00:18:28,400 --> 00:18:31,710
أنا خجلٌ من الاعتراف بذلك، لكن
سبقَ وبعتُ هذه من قبل أيضاً

344
00:18:31,710 --> 00:18:35,670
رسمتُ إباحيّات أيضاً وبعتُ أكثر من ذلك بكثير

345
00:18:35,670 --> 00:18:38,300
بعتُ الكثير لدرجة أنّه كاد يُكشَف
أمري بواسطة الشّوغونيّة

346
00:18:38,300 --> 00:18:42,330
سمعتُ أنّ كثيراً من الرسّامين القدماء
كانوا يرسمون الإباحيّات

347
00:18:42,330 --> 00:18:44,220
لأنّها تُحقّق مبيعات أكبر بكثير
من عملهم الرّئيسيّ

348
00:18:44,220 --> 00:18:46,570
هوكوساي وكونيوشي رسما الإباحيّات أيضاً

349
00:18:46,570 --> 00:18:50,550
كانت إحدى الأسماء المُستعارة الخاصّة
"بهوكوساي "القضيب الزّلق

350
00:18:52,440 --> 00:18:56,770
يُقال حتّى الرّسّامة اليابانيّة الشّهيرة
أويمورا شوين كانت ترسم الإباحيّات

351
00:18:56,770 --> 00:18:57,890
المعذرة

352
00:18:57,890 --> 00:19:00,280
لكن كانت مسألة حياة أو موت
بالنّسبة للفنّانين

353
00:19:00,280 --> 00:19:03,760
الاستماع إلى ذلك مُثير جدّاً للاهتمام

354
00:19:03,760 --> 00:19:05,050
إنّه تاريخ

355
00:19:05,290 --> 00:19:07,910
بالنّسبة لي، إنّها ذكريّات

356
00:19:07,910 --> 00:19:10,170
إذاً ماذا لو بعت دوجينشي الآن؟

357
00:19:11,190 --> 00:19:14,170
سمعتُ بأنّك تستطيع جني الكثير
من المال من خلال القيام بذلك

358
00:19:14,170 --> 00:19:16,880
الجنس يُحقّق مبيعات في كلّ عصر

359
00:19:17,170 --> 00:19:18,860
...بوسعي فعل ذلك

360
00:19:20,330 --> 00:19:22,800
أتعتقدين بأنّني أستطيع
تأليف كُتُب إباحيّة؟

361
00:19:22,800 --> 00:19:24,220
ما رأيك بهذا؟

362
00:19:24,220 --> 00:19:26,460
أعتقد يعتمد هذا على النّوع

363
00:19:26,460 --> 00:19:28,350
ينبغي أن تُحدّث أسلوبك

364
00:19:28,640 --> 00:19:33,100
،الرّسوم الّتي رسمتها قبل أيّام كانت بدائيّة
لكن مليئة بالشّخصيّة

365
00:19:33,100 --> 00:19:34,870
أنا واثقة من أنّك سريع التعلُّم

366
00:19:34,870 --> 00:19:36,120
بجدّية؟

367
00:19:36,120 --> 00:19:37,820
!ربّما سأبدأ بالتّمرين

368
00:19:37,820 --> 00:19:39,270
...أو

369
00:19:39,870 --> 00:19:42,180
!من فضلك ارسم مانغا باندا أحمر

370
00:19:42,180 --> 00:19:45,010
وبِع معها سلاسل مفاتيح أكريليّة
!ودُمى شخصيّات معها

371
00:19:45,010 --> 00:19:46,530
!سوف أشتريها

372
00:19:46,530 --> 00:19:48,290
لا بُدّ أنّها تُحبّها حقّاً

373
00:19:48,290 --> 00:19:51,110
سيترتّب عليك إخباري بالمزيد
عن ذلك يوماً ما

374
00:19:51,110 --> 00:19:54,600
بالمُقابل، سأدعك تُعدّ طعاماً مُزيّفاً

375
00:19:54,600 --> 00:19:55,790
!يبدو هذا مُمتعاً

376
00:19:55,790 --> 00:20:01,930
رأيتُ بضعة أنميات، لكن إذا كنتُ سأرسم
شيئاً، فمن الأفضل أن أعمل على بحثي

377
00:20:02,510 --> 00:20:06,140
هذا الشّخص مصدر غنيّ في
مواضيع الفلوكلور

378
00:20:06,360 --> 00:20:07,480
فلوكلور؟

379
00:20:07,480 --> 00:20:10,100
!على ذكر الأمر! تقريري

380
00:20:10,730 --> 00:20:15,350
يجب عليّ كتابة تقرير حول المهرجانات المحلّية

381
00:20:15,350 --> 00:20:18,570
موغورا، هل تعرف أي مهرجان غريب ومُثير؟

382
00:20:18,790 --> 00:20:20,700
يبدو أنّك تعرف

383
00:20:20,700 --> 00:20:24,180
...مهرجانات مُثيرة؟ لنرَ

384
00:20:24,180 --> 00:20:26,810
هناك مهرجان حيث تجتمع الأشباح
مرّة في كلّ عام

385
00:20:26,810 --> 00:20:28,580
حقّاً؟ يبدو هذا مُثيراً للاهتمام

386
00:20:28,580 --> 00:20:31,500
لا، لحظة. لن أسأل عن الأشياء التّخيُّليّة

387
00:20:31,500 --> 00:20:33,410
لكن هذا حقيقيّ

388
00:20:33,410 --> 00:20:36,880
إن سألتني، تُقام مهرجانات كثيرة في اليابان

389
00:20:36,880 --> 00:20:38,620
هذا من أجل تقرير، صحيح؟

390
00:20:39,050 --> 00:20:43,800
سيكون من الغريب أن تعلم بمهرجان غير
مُوثَّق لا يعرف أحدٌ آخر عنه شيئاً

391
00:20:43,800 --> 00:20:44,940
هذا صحيح

392
00:20:44,940 --> 00:20:47,180
ما الّذي سيكون مُلائماً إذاً؟

393
00:20:49,150 --> 00:20:53,810
في هذه الحالة، هل ترغب في حضور مهرجان
موطني في عطلة هذا الأسبوع؟

394
00:20:53,810 --> 00:20:54,610
ماذا؟

395
00:20:54,610 --> 00:20:57,700
ذكرتُ بأنّ عائلتي من الرّيف، صحيح؟

396
00:20:57,700 --> 00:20:58,970
هناك يُقام

397
00:20:58,970 --> 00:20:59,880
هل أنتِ متأكّدة؟

398
00:20:59,880 --> 00:21:02,160
ألم تكوني ستكتبين عن ذلك؟

399
00:21:02,160 --> 00:21:05,320
كتبتُ خاصّتي في مهرجان آخر

400
00:21:05,730 --> 00:21:08,920
ارتأيتُ للتو بأنّه قد يكون من المُمتع
حضوره كشخص من الخارج

401
00:21:08,920 --> 00:21:12,910
ولا يأتينا الكثير من الزُّوّار، لذا
الضّيوف مُرحَّب بهم بحرارة

402
00:21:12,910 --> 00:21:13,960
!يجدر بك أن تأتي

403
00:21:13,960 --> 00:21:17,630
أشعر بأنّني رأيتُ أفلام رُعُب
!تبدأ بهذه الطّريقة

404
00:21:19,460 --> 00:21:21,420
أيّ مهرجان هو هذا؟

405
00:21:21,420 --> 00:21:24,170
إنّه يستند على أسطورة محلّية

406
00:21:24,650 --> 00:21:29,330
على وجه العموم، إنّه مهرجان هِبة وتطهير
لقمع شعوب البِحار

407
00:21:29,330 --> 00:21:33,180
وفقاً للأساطير، شعب البحر يفتن
النّاس ويجرّهم نحو البحر

408
00:21:33,180 --> 00:21:34,590
شعب البحر؟

409
00:21:34,590 --> 00:21:37,890
لدى السّواحل الكثير من الأساطير
الغريبة عن وحوش البحر

410
00:21:37,890 --> 00:21:41,480
صحيح؟ إنّه انعكاس لمخاطر البحر

411
00:21:45,030 --> 00:21:46,890
المعذرة يا موغورا-سان

412
00:21:47,450 --> 00:21:50,240
هل ترغب في الحضور أيضاً؟

413
00:21:51,240 --> 00:21:51,990
لماذا؟

414
00:21:52,370 --> 00:21:56,080
...والد جدّي كيريهارا يوهاتشي

415
00:21:57,970 --> 00:22:00,840
لا يزال على قيد الحياة. سيبلغ 97
في هذا العام