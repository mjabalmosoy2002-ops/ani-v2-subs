1
00:00:01,410 --> 00:00:02,730
،في قديم الزّمان

2
00:00:02,730 --> 00:00:09,060
امرأة جميلة ورضيع جُرِفا في البحر
إلى جزيرة تُدعى ساميشيما

3
00:00:09,990 --> 00:00:12,050
كانا واهنين تماماً

4
00:00:12,050 --> 00:00:16,740
فبذلَ شيخ القرية وابنه قصارى جهدهما لمُداواتهما

5
00:00:17,700 --> 00:00:21,250
قالت المرأة بأنّها أتت من وراء البحار

6
00:00:21,870 --> 00:00:25,140
المرأة، الّتي كانت تعمل في مصنع
،حبوب فاصولياء في البلدة

7
00:00:25,140 --> 00:00:29,500
وقعتْ في حبّ البائع الشّابّ وأنجبتْ طفلاً

8
00:00:29,810 --> 00:00:34,580
غير أنّها طُرِدَتْ وحتّى أنّه لاحقَها قُطّاع طُرُق

9
00:00:36,180 --> 00:00:41,490
بعد عامين، أتى رجال المصنع إلى الجزيرة

10
00:00:41,490 --> 00:00:44,770
،لم يستطع البائع وزوجته الإنجاب

11
00:00:45,270 --> 00:00:49,590
لذا طالبا بطفل المرأة وأخذاه منها

12
00:00:49,590 --> 00:00:55,280
جرحوا المرأة بالسّيوف ورموها في البحر

13
00:00:55,630 --> 00:00:59,580
،وبينما كان يهمّ الرّجال بالعودة إلى المنزل
،هاجمت أمواج البحر

14
00:00:59,580 --> 00:01:05,000
وهبّتْ عاصفة عليهم وظهرَ إنسان بحر مُرعب

15
00:01:05,290 --> 00:01:08,790
،تركوا الطّفل وحاولوا اللّوذ بالفرار

16
00:01:08,790 --> 00:01:11,460
لكن ابتلعَتْهم الأمواج في نهاية المطاف

17
00:01:12,010 --> 00:01:15,090
،كان وجه إنسان البحر وجه المرأة

18
00:01:15,390 --> 00:01:20,600
لكن لم يكن هناك أيّ أثر لجمالها، باعتبارها
أصبحتْ روحاً خبيثة قبيحة

19
00:01:21,540 --> 00:01:25,190
،عقب تعليمات كويتسو

20
00:01:25,190 --> 00:01:28,600
الكاهن الّذي أتى إلى الجزيرة، ابن
شيخ القرية، أدّى صلاة

21
00:01:30,310 --> 00:01:37,050
،عندما حنّطوا جسد الطّفل وقدّموه كهِبة
هدأت العاصفة

22
00:01:37,910 --> 00:01:43,450
هكذا أمستْ ساميشيما تُعرَف بجزيرة شعب البحر

23
00:01:45,740 --> 00:01:48,370
!لا تتحرّك قيد أُنملة

24
00:01:59,130 --> 00:02:00,800
...الجزيرة

25
00:02:00,800 --> 00:02:03,180
...أسلافنا

26
00:02:03,550 --> 00:02:07,470
...مهرجان مُقدّس... الأمّ

27
00:02:07,470 --> 00:02:09,190
...هذا السّهم

28
00:02:09,500 --> 00:02:12,320
سيّدي، لا يمكنك فعل هذا

29
00:02:12,320 --> 00:02:15,480
كنتُ أراقبك بما أنّك مشبوه جدّاً

30
00:02:15,820 --> 00:02:20,040
أهذا ما أملَتْ عليك الماما فعله يا بُني؟

31
00:02:20,040 --> 00:02:22,620
لستُ مشبوهاً فحسب، بل أعرف كلَّ شيء

32
00:02:22,620 --> 00:02:26,500
مُتخلّف مُصاب بعقدة أوديب، وفتاة
صغيرة شرّيرة، وشمطاء قبيحة

33
00:02:26,500 --> 00:02:30,490
أشكّ في أنّه سيُفيد، لكن دعني
أقول هذا الكلام الجيّد على أيّ حال

34
00:02:30,490 --> 00:02:32,540
أتعتبر نفسك رئيس شركة أيّها المُتخلّف؟

35
00:02:33,550 --> 00:02:35,300
من أنت؟

36
00:02:35,300 --> 00:02:36,860
ماذا فعلت بالسّهم؟

37
00:02:36,860 --> 00:02:38,550
ما هذا المصباح؟

38
00:02:39,180 --> 00:02:41,290
هل فعلت شيئاً لابن موري؟

39
00:02:41,290 --> 00:02:43,290
لماذا الآخر غير جريح؟

40
00:02:43,290 --> 00:02:44,350
!هذا غير منطقيّ

41
00:02:44,350 --> 00:02:47,350
تفكيرك سليم بالنّسبة لدُمية

42
00:02:47,970 --> 00:02:49,620
أنت تهدر إمكانيّاتك

43
00:02:49,620 --> 00:02:51,800
أسلوبك بارع في الكلام، وذكيّ

44
00:02:51,800 --> 00:02:55,180
حذارِ من هذه. هل هي سكّين لتقطيع السّمك؟

45
00:02:55,180 --> 00:02:56,930
ليس لديك ثغرات

46
00:02:56,930 --> 00:02:59,110
أنت تُمارس فنّاً قتاليّاً، أليس كذلك؟

47
00:02:59,110 --> 00:03:00,930
لا بُدّ أنّك ترعرعت بشكل جيّد

48
00:03:00,930 --> 00:03:03,780
وحتّى أنّك تبدو وسيم بالنّسبة لسنّك

49
00:03:04,040 --> 00:03:07,290
ستكون رجلاً مرغوباً لو فُطِمت عن أمّك

50
00:03:07,290 --> 00:03:11,790
على أيّ حال، لا أحد يريد رؤية معركة
بين رجل في مُنتصف العمر وعجوز

51
00:03:12,080 --> 00:03:13,580
دعنا ألّا نفعل هذا

52
00:03:13,580 --> 00:03:17,210
علاوة على ذلك، الشّمطاء المُديرة
وفتاة حقل الألغام خلفك

53
00:03:17,210 --> 00:03:21,140
لو كنّا في مانغا أو أنمي، لما كان
لديك أي مُعجبين

54
00:03:21,140 --> 00:03:24,680
يجب أن يكون زعيمك شابّاً وسيماً على الأقلّ

55
00:03:25,090 --> 00:03:27,490
!لا تُهِن عائلتي

56
00:03:27,490 --> 00:03:28,930
عائلتك؟

57
00:03:30,430 --> 00:03:32,940
أليس هذا ما ذُكِر فيه؟

58
00:03:33,510 --> 00:03:35,310
برأس يشبه رأس الرّضيع"

59
00:03:37,290 --> 00:03:38,780
،وجسد امرأة

60
00:03:37,910 --> 00:03:39,620
!أجل، أجل

61
00:03:40,950 --> 00:03:44,290
"تستدرج الرّجال إلى البحر بصوتها

62
00:03:46,060 --> 00:03:48,630
إنسان البحر القبيحة

63
00:03:48,630 --> 00:03:51,040
!هي عائلتك

64
00:05:23,460 --> 00:05:26,420
أيّ شخص يسخر من عائلتي
!هو شخص سيّئ

65
00:05:26,420 --> 00:05:27,340
!اعتذر

66
00:05:27,570 --> 00:05:29,030
أتنتفض غضباً الآن؟

67
00:05:29,030 --> 00:05:30,850
!أنت طفل من كلّ ناحية

68
00:05:34,680 --> 00:05:36,890
مـ-مهلاً! كان ذلك وشيكاً

69
00:05:36,890 --> 00:05:38,100
هذا الشّيء حادّ

70
00:05:38,470 --> 00:05:41,320
أيّ شخص يُعبّر عن رأي هو عدوّ السّلام

71
00:05:41,540 --> 00:05:43,190
كانت أمّي على حقّ

72
00:05:43,190 --> 00:05:45,690
جلب كيريهارا الكارثة إلى الجزيرة

73
00:05:45,690 --> 00:05:49,140
الكارثة هي وحش يصل بهيئة بشر

74
00:05:49,140 --> 00:05:52,090
هكذا تسير الأمور في الحكايات الشّعبيّة
الّتي ترويها أمّي لي

75
00:05:52,090 --> 00:05:56,010
،ورغم أنّ شكله كان مُشتقّاً من غيره
إلّا أنّ مهاراته بالقوس كانت استثنائيّة

76
00:05:56,010 --> 00:05:57,460
إنّه وحشٌ حقيقيّ

77
00:05:57,930 --> 00:06:00,770
كلّ ما تقوله ماما صحيح دوماً

78
00:06:00,770 --> 00:06:03,220
سلامنا مُهدَّد

79
00:06:05,130 --> 00:06:08,880
هل لديك أمّ؟ عائلة؟

80
00:06:09,730 --> 00:06:11,800
ماذا؟ لا

81
00:06:11,800 --> 00:06:14,150
لم أتوقّع ذلك

82
00:06:14,150 --> 00:06:18,640
كبرتَ وأصبحت فتى سيّئاً لأنّك لا تعرف
شيئاً عن حبّ العائلة... عن حبّ الأمّ

83
00:06:18,880 --> 00:06:21,290
أنت تغار من عائلتنا

84
00:06:21,290 --> 00:06:22,940
مسكين

85
00:06:24,070 --> 00:06:28,090
الأطفال الّذين لا يعرفون دفء
العائلة يتربّون بشكل خاطئ

86
00:06:28,090 --> 00:06:29,820
أنت لا تدرك ذلك عن نفسك، صحيح؟

87
00:06:29,820 --> 00:06:31,340
مسكين

88
00:06:31,340 --> 00:06:34,810
لطالما أخبرتني أمّي بأنّني أعرف الحُبّ

89
00:06:34,810 --> 00:06:36,750
إنّه مُهمّ للكائنات البشريّة

90
00:06:36,750 --> 00:06:39,040
لا تفهمني، صحيح؟ أيّها المسكين

91
00:06:40,500 --> 00:06:43,790
يؤسفني قول ذلك، لكن هذا يعني
بأنّك شخص سيّئ

92
00:06:43,790 --> 00:06:48,920
في القصص الّتي أُحبّها، أولئك الّذين
لا يعرفون الحُبّ هو دوماً أشخاص سيّئون

93
00:06:50,650 --> 00:06:55,470
ويجب على الأشخاص السّيّئين أن يُهزَموا دوماً

94
00:06:55,690 --> 00:07:00,950
الجميع ينتظرون اللّحظة الّتي يُهزَم
فيها الأشخاص السّيّئون

95
00:07:00,950 --> 00:07:02,820
إنّ هزيمتهم تجعلني بطلاً

96
00:07:02,820 --> 00:07:05,510
كنتُ أهزم الأشخاص السّيّئين في الجزيرة

97
00:07:05,850 --> 00:07:09,950
لطالما أطرتْ عليّ أمّي، ممّا يزيدني قوّة

98
00:07:10,580 --> 00:07:13,980
يقتصر الأمر كلّه على ما علّمَتْني إيّاه ماما

99
00:07:16,490 --> 00:07:18,160
!أنت هو المجنون

100
00:07:18,160 --> 00:07:20,740
شكراً لك على قول كلام يقوله
الأشرار في العادة

101
00:07:20,740 --> 00:07:23,210
يمكنني هزيمتك الآن، صحيح؟

102
00:07:33,260 --> 00:07:35,220
أنا أقطع القوسَ بسهولة

103
00:07:35,220 --> 00:07:36,140
لماذا؟

104
00:07:36,140 --> 00:07:39,980
في اليابان، عندما يموت النّاس، فإنّهم
يُرسَلون إلى أحد الطّرُق الستّة أو النّعيم

105
00:07:39,980 --> 00:07:43,380
،طريق الجحيم، أقسى الطّرُق جميعها

106
00:07:43,380 --> 00:07:47,220
يُقسَم إلى الجحيمات العظيمة الثّمانية والجحيمات
الباردة الثّمانية، وكلّ جحيم بثمانية عوالم

107
00:07:47,220 --> 00:07:48,170
...بالإضافة إلى ذلك

108
00:07:48,650 --> 00:07:50,610
في الواقع، سأكتفي بهذا القدر

109
00:07:51,940 --> 00:07:57,430
في جحيم الحبل الأسود، أحد الجحيمات العظيمة
الثّمانية، يُربَط الموتى بالحبال

110
00:07:57,430 --> 00:08:00,020
هذا أحد الحِبال الّتي يستخدمونها هناك

111
00:08:00,020 --> 00:08:03,000
إنّه أحمر بفعل الدّماء، لكنّه كان
لونه أسود في الأصل

112
00:08:03,000 --> 00:08:05,920
إنّه لا يُقطَع بسهولة بواسطة أشياء
من هذا العالم

113
00:08:05,920 --> 00:08:08,670
أنت مجنون حقّاً

114
00:08:08,980 --> 00:08:11,060
بالمناسبة، لديّ سؤال لك

115
00:08:11,060 --> 00:08:14,020
ألم تُعلّمك أمّك الدّرس الأساسيّ جدّاً

116
00:08:14,020 --> 00:08:16,760
وهو عدم إشهار أشياء حادّة في وجه الآخرين؟

117
00:08:16,760 --> 00:08:19,700
يبدو هذا أسوأ بكثير من أيّ شيء
علّمَتْك إيّاه عن الحُبّ

118
00:08:19,700 --> 00:08:21,940
!لا تُهِن ماما أيّها الوحش

119
00:08:21,940 --> 00:08:23,850
!لا أعرف إلّا ما عُلِّمتُ إيّاه

120
00:08:23,850 --> 00:08:25,600
!أيّ منطق هو هذا؟

121
00:08:26,560 --> 00:08:27,860
...هلّا فكّرت

122
00:08:30,360 --> 00:08:32,950
!لأجل نفسك ولو لمرّة؟...

123
00:08:33,870 --> 00:08:36,450
...ماما

124
00:08:38,660 --> 00:08:40,290
فتى مسكين

125
00:08:40,540 --> 00:08:43,530
يسرّني أنّني في الثّلاثينيّات الآن

126
00:08:43,530 --> 00:08:46,780
لو كنتُ في سنّه، لكان ذلك
قد استغرقَ وقتاً طويلاً

127
00:08:53,690 --> 00:08:54,970
!ماغي! موري-كن

128
00:08:54,970 --> 00:08:56,720
!ماغي-كن! موري-كن

129
00:08:56,720 --> 00:08:58,790
،حتّى لو أطلقتُ سهماً من هذا العالم

130
00:08:58,790 --> 00:09:03,930
أفتقر لقوّة طرد مخلوق أُخرَويّ
كإنسان البحر ذاك

131
00:09:03,930 --> 00:09:04,770
!اللّعنة

132
00:09:09,860 --> 00:09:12,990
!أحسنت يا زعيم! وصلت إلى هنا في الوقت

133
00:09:35,450 --> 00:09:38,840
في تلك اللّحظة، كان واضحاً أكثر من أيّ وقت مضى

134
00:09:39,170 --> 00:09:43,180
سبب استحقاق إيكيبوكورو-سان
أن يُنادى باسمه

135
00:09:43,180 --> 00:09:47,060
حريّ بي ألّا أرسب في أيّ درس
من دروس الأستاذ

136
00:09:49,900 --> 00:09:51,150
!السّيّد! كيو-تشان

137
00:09:51,150 --> 00:09:52,900
!شكراً على مجيئكما

138
00:09:53,380 --> 00:09:56,470
"لماذا هذا الشّيء شكله مثل إنسان بحر؟"

139
00:09:56,470 --> 00:10:01,470
بغضّ النّظر عن كيف أنّه أصبح كتلة
من الأرواح، كان ذلك سؤالي الأكبر

140
00:10:01,470 --> 00:10:02,240
أجل

141
00:10:02,240 --> 00:10:04,950
بصيغة أُخرى، هذه هي هويّته الحقيقيّة

142
00:10:04,950 --> 00:10:09,500
،إيكيبوكورو، سأشتري لك مغزل حبّار لاحقاً
!لذا اسحب رأس إنسان البحر

143
00:10:12,010 --> 00:10:14,100
!نابيشيما، لا تخذلني

144
00:10:14,100 --> 00:10:17,300
!أنت الأروع هنا، لذا اسحب ذيل إنسان البحر

145
00:10:57,620 --> 00:11:01,800
!انقسم إنسان البحر إلى بشريّ وسمكة

146
00:11:02,620 --> 00:11:03,680
!إنّه قرش

147
00:11:05,930 --> 00:11:09,180
وقعت هجمات قرش في هذه
المنطقة لفترة طويلة

148
00:11:09,460 --> 00:11:13,500
لكن في هذه الأرجاء، تظهر أحياناً حيتان
ضخمة وقروش النّمر

149
00:11:13,500 --> 00:11:16,190
وهناك حتّى سجلّات عن ظهورها في فترة إيدو

150
00:11:16,190 --> 00:11:20,450
يبدو أنّ الجزيرة بحدّ ذاتها كانت تُدعى
ساميشيما، أو جزيرة القرش

151
00:11:20,450 --> 00:11:21,410
ماذا؟

152
00:11:21,770 --> 00:11:24,650
هذا يصِف أصول أسطورة إنسان البحر

153
00:11:24,650 --> 00:11:28,290
،بما أنّك ترعرعتِ في الجزيرة
لعلّكِ سمعتِ بها

154
00:11:28,290 --> 00:11:32,410
إنّها حكاية شعبيّة أصليّة. وحتّى أنّ هناك
كاهناً يظهر فجأة

155
00:11:33,040 --> 00:11:36,000
وكُتِبَ هذا بواسطة كيريهارا يوتارو-سان

156
00:11:36,000 --> 00:11:39,440
بعبارة أُخرى، والد يوهاتشي-سان

157
00:11:39,440 --> 00:11:41,590
والد والد جدّي؟

158
00:11:41,590 --> 00:11:44,340
أجل. كانت المُحتويات مُثيرة للاهتمام

159
00:11:46,870 --> 00:11:50,650
ثمل العجوز هانادا وأخبرني بهذه القصّة

160
00:11:50,650 --> 00:11:58,170
قبل أجيال من طفولته، أتى أسلاف ساميجيما
إلى هذه الجزيرة

161
00:11:59,010 --> 00:12:02,850
يبدو أنّ أسطورة الجزيرة نصف صحيحة

162
00:12:02,850 --> 00:12:07,000
سلَف ساميجيما الّذي كان شيخ
القرية باع ابن المرأة

163
00:12:07,000 --> 00:12:08,750
لرجال مصنع الفاصولياء

164
00:12:09,170 --> 00:12:14,010
غضبت المرأة وطاردت القارب، لكن
هوجِمت بواسطة قرش

165
00:12:14,010 --> 00:12:18,930
هاجمَ سكّانُ الجزيرة القرشَ بحربة، لكن
ماتوا مع القرش

166
00:12:18,930 --> 00:12:21,980
وماتت المرأة وطفلها كذلك

167
00:12:21,980 --> 00:12:27,140
جرف البحرُ جثثَهم إلى ما يُعرَف
اليوم بصخرة إنسان البحر

168
00:12:27,620 --> 00:12:32,640
بعد تخريج يوهاتشي، لاحظ بأنّه رأى إنسان بحر

169
00:12:35,020 --> 00:12:37,150
،باختصار

170
00:12:37,150 --> 00:12:41,650
التّاريخ المُظلم للجزيرة أدّى إلى تشكيل كتلة أرواح
نصفها بشريّ والنّصف الآخر سمكيّ

171
00:12:41,650 --> 00:12:46,410
وبعد سنوات من النّموّ، أصبح وحشاً بهذا الشّكل

172
00:12:46,410 --> 00:12:48,390
،كثيراً ما نرى ذلك في القصص الخرافيّة

173
00:12:48,390 --> 00:12:51,770
لكن عندما تكون هناك حيوانات بالقرب من بشر
،يموتون بينما تُراودهم مشاعر جيّاشة

174
00:12:52,100 --> 00:12:56,120
فإنّ روح البشريّ تستحوذ على الحيوان
وتحوّله إلى وحش

175
00:12:56,120 --> 00:12:58,420
باكينيكو هو مثال من الأمثلة

176
00:12:58,730 --> 00:13:02,090
أو كما في "بايكا هيوريتسو" الخاصّة بسانتو كيودين

177
00:13:02,090 --> 00:13:03,550
كانت سمكة ذهبيّة

178
00:13:03,550 --> 00:13:07,050
التّحذير بشأن عدم أكل فاصولياء
أمام المرأة العجوز

179
00:13:07,050 --> 00:13:09,190
نابع من تلك القصّة غالباً أيضاً

180
00:13:09,190 --> 00:13:10,260
سيّدي

181
00:13:10,260 --> 00:13:13,080
دعني أسدّد ثمن طرد الأرواح

182
00:13:13,080 --> 00:13:16,940
أنا أعمل بدوام جزئيّ فقط الآن، لكن أعِدك
بأنّني سأدفع حالما أحظى بعمل مُناسب

183
00:13:17,980 --> 00:13:20,270
شكراً لكِ، لكن تلقّيتُ الثّمن بالفعل

184
00:13:20,510 --> 00:13:21,230
ماذا؟

185
00:13:21,230 --> 00:13:25,120
بالإضافة إلى تلك، عثرنا على
الطّبعة الأولى من

186
00:13:25,120 --> 00:13:28,060
مطعم الكثير من الطّلبات" في مستودع"
عائلة كيريهارا

187
00:13:28,060 --> 00:13:32,100
ابحثي فيه. إنّه قيّم جدّاً

188
00:13:32,100 --> 00:13:37,450
والد جدّكِ أعطاني إيّاه لاهتمامي بكِ

189
00:13:41,210 --> 00:13:44,350
موغورا، يريدك أن تأخذ حقيبة
الظّهر المُهترئة خاصّته

190
00:13:44,350 --> 00:13:45,470
!لا أريدها

191
00:13:47,100 --> 00:13:48,300
!الأستاذ من طوكيو

192
00:13:48,540 --> 00:13:51,390
!هل تُصدّق هذا؟ ضربَني على رأسي

193
00:13:51,390 --> 00:13:53,490
!كان مصباحاً معدنيّاً أو ما شابه

194
00:13:53,490 --> 00:13:54,980
!انظر إلى هذا الجرح

195
00:13:54,980 --> 00:13:56,850
أيّ جرح؟

196
00:13:56,850 --> 00:13:58,140
ماذا؟

197
00:13:58,140 --> 00:13:59,600
ليس هنا؟ هل شُفي؟

198
00:14:00,170 --> 00:14:02,910
انزلقت من تلقاء نفسك وغبت عن الوعي

199
00:14:02,910 --> 00:14:04,650
ربّما كنتَ تُهلوس

200
00:14:04,650 --> 00:14:06,530
هذا مستحيل

201
00:14:06,530 --> 00:14:08,670
!حتّى أنّه يوجد دماء هنا

202
00:14:08,670 --> 00:14:11,300
لا بُدّ أنّ سبب الدّمااء هو سمكة مُقطَّعة

203
00:14:11,300 --> 00:14:12,280
!مستحيل

204
00:14:12,280 --> 00:14:15,790
بالمناسبة، هل يمكنك رؤية شيء الآن؟

205
00:14:15,790 --> 00:14:17,710
هذا ليس هلوَسة

206
00:14:28,720 --> 00:14:34,220
لا يسعني القول بأنّنا مُقرَّبان الآن، لكن
هناك حتماً رابط عميق بيننا

207
00:14:29,850 --> 00:14:31,610
!ماما

208
00:14:34,460 --> 00:14:36,620
هذا هو الثّمن الّذي تدفعه مُقابل كلّ ما فعلته

209
00:14:36,620 --> 00:14:37,680
أمعن النّظر

210
00:14:38,020 --> 00:14:40,690
!ماما! ماما

211
00:14:40,690 --> 00:14:43,150
!ماما

212
00:14:43,630 --> 00:14:48,110
ذكرتُ في السّابق بأنّ عقلَي ماغي وياي-تشان
،وعيونهما سريعة التكيُّف

213
00:14:48,110 --> 00:14:50,740
لكن هكذا يتصرّف العنيدون

214
00:14:51,370 --> 00:14:54,310
أتساءل متى سيعود إلى رشده

215
00:14:54,310 --> 00:14:56,770
هذا ما يحدث إذاً عندما يبلغ
السّان الخاصّ بك الصّفر

216
00:14:56,770 --> 00:14:57,870
!ماما

217
00:14:57,870 --> 00:15:01,750
!ماما! ماما

218
00:15:01,750 --> 00:15:04,500
!ماما

219
00:15:05,370 --> 00:15:08,260
آسفة يا شيو-تشان. أمهليني لحظة

220
00:15:09,540 --> 00:15:12,740
استقلّا الدرّاجة النّاريّة إلى موغورا-تشان

221
00:15:12,740 --> 00:15:16,610
سننزل إلى البحر ونرى ما إن كان هناك
أيّ شيء يمكننا فعله للمُساعدة

222
00:15:17,020 --> 00:15:22,260
رغم ذلك، النّزول سيراً على الأقدام
أصعب ممّا توقّعت

223
00:15:22,890 --> 00:15:24,610
بالكاد يمكنك الوقوف

224
00:15:25,490 --> 00:15:29,530
حالما تتجاوزين الثّلاثين، فإنّ جسدكِ
يبدأ بالانهيار من الدّاخل

225
00:15:29,530 --> 00:15:33,830
لكن أنا واثقة بأنّكِ ستكونين بخير
حتّى في خمسينيّاتكِ

226
00:15:33,830 --> 00:15:38,420
غالباً. جدّتي الّتي عمرها 80 عاماً
!تُنافس في المُسابقة الثّلاثيّة

227
00:15:38,420 --> 00:15:39,580
سأحملكِ

228
00:15:39,860 --> 00:15:42,820
ربّما سأعتمد عليكِ

229
00:15:46,210 --> 00:15:48,710
!مُذهل! ركبتايّ مرتاحتان تماماً

230
00:15:51,720 --> 00:15:52,860
ماذا؟

231
00:15:55,490 --> 00:15:57,220
ماذا تفعلان؟

232
00:15:57,220 --> 00:16:01,200
كنّا على عجلة من أمرنا للوصول
إلى البحر، لكن ركبتَي قد أُرهِقتا

233
00:16:01,200 --> 00:16:02,310
هل أنتِ ذاهبة إلى هناك أيضاً؟

234
00:16:02,310 --> 00:16:07,150
،أجل. سقطَ أحد سكّان الجزيرة في البحر
لذا أنا ذاهبة للاطمئنان عليه

235
00:16:07,150 --> 00:16:09,900
لكن حسبما سمعت، إنّه بخير

236
00:16:09,900 --> 00:16:11,910
ممتاز. يا لها من مُعجزة

237
00:16:11,910 --> 00:16:13,950
اصعدا

238
00:16:18,170 --> 00:16:20,830
يوي-تشان، هل غادرتِ الجزيرة يوماً؟

239
00:16:21,790 --> 00:16:24,130
أعتقد بأنّها قد تكون فكرة جيّدة

240
00:16:24,130 --> 00:16:29,300
يبدو هذا مُمتعاً، لكن يجب عليّ
خدمة الجزيرة

241
00:16:29,300 --> 00:16:32,800
أعتقد هناك الكثير من الأعمال الّتي
يمكنكِ القيام بها هناك

242
00:16:32,800 --> 00:16:35,540
ستكون فكرة جيّدة تجربة المزيد من الأشياء

243
00:16:35,900 --> 00:16:37,070
...على سبيل المثال

244
00:16:37,430 --> 00:16:39,340
أن تكوني امرأة مُتسلِّطة

245
00:16:39,340 --> 00:16:40,140
ماذا؟

246
00:16:41,180 --> 00:16:42,640
لا شيء

247
00:16:45,150 --> 00:16:48,520
المعذرة، ماذا قصدتِ بذلك؟

248
00:16:48,770 --> 00:16:50,190
!نعتقد بأنّ تلك فكرة ممتازة

249
00:16:50,510 --> 00:16:52,070
!لا تُعبّرا عن رأيكما فجأة

250
00:16:52,330 --> 00:16:53,890
!سندعم عملكِ

251
00:16:53,890 --> 00:16:56,150
!سنكون تحت خدمتك

252
00:16:56,150 --> 00:16:58,700
!لا تطرحا مثل هذه الاقتراحات

253
00:16:58,700 --> 00:17:00,660
!وكفّا عن الصّراخ معاً داخل السّيّارة

254
00:17:00,880 --> 00:17:03,050
أعتقد هناك مطالب لذلك

255
00:17:03,050 --> 00:17:06,090
فأساساً، أنتِ ذلك النّوع من الأشخاص

256
00:17:06,090 --> 00:17:07,550
ما معنى هذا؟

257
00:17:07,950 --> 00:17:10,420
!طوكيو مدينة مُرعبة

258
00:17:10,420 --> 00:17:12,210
زوجة أستاذ جامعة؟

259
00:17:12,210 --> 00:17:15,220
أنتِ غريبة الأطوار بعض الشّيء، أليس كذلك؟

260
00:17:16,470 --> 00:17:17,470
أنا آسفة

261
00:17:18,030 --> 00:17:22,180
لكن ما فعلتِه لموري-كن أغرب
بكثير، ألا تعتقدين ذلك؟

262
00:17:24,330 --> 00:17:25,860
ما الّذي تقولينه فجأة؟

263
00:17:25,860 --> 00:17:27,770
يتسلّط الضّوء دوماً على الأعمال الشّرّيرة

264
00:17:28,370 --> 00:17:31,270
من فضلكِ لا تهينيني بناء على تخمينات

265
00:17:31,510 --> 00:17:33,160
أنتِ ذكيّة

266
00:17:33,160 --> 00:17:36,710
،حتّى عندما تؤخذين على حين غرّة
فإنّكِ لا ترتعدين وتتوارين أكثر

267
00:17:36,710 --> 00:17:38,830
أنتِ مُؤهّلة بالفعل

268
00:17:39,290 --> 00:17:42,580
لهذا نصحتُكِ بمُغادرة الجزيرة
ولو لمرّة واحدة على الأقلّ

269
00:17:42,580 --> 00:17:44,120
لا سيّما بما أنّكِ صغيرة

270
00:17:44,120 --> 00:17:46,580
سمعتُ ما يكفي أيّتها العجوز

271
00:17:46,580 --> 00:17:49,670
من الجيّد الإصغاء لامرأة أكبر سنّاً
بين الفيّنة والأُخرى

272
00:17:50,150 --> 00:17:52,850
أنتِ تُخيفينني. ما مُشكلتكِ؟

273
00:17:52,850 --> 00:17:57,300
لا أعرف ما الّذي سمعتِه، لكن توقّفي رجاء

274
00:17:57,730 --> 00:17:59,970
ليس عليكِ القلق بشأني

275
00:17:59,970 --> 00:18:04,290
ما سكّان الجزيرة بالنّسبة لكِ؟
ماذا عنع موري-كن؟

276
00:18:04,290 --> 00:18:06,640
هل هذان الاثنان زميلان مُهمّان
لكِ في الكلّية؟

277
00:18:08,140 --> 00:18:10,860
من فضلكِ. إنّهما خادمان

278
00:18:11,180 --> 00:18:14,110
لدينا مُساعدون أيضاً، لكن جميعهم
مُهمّون بالنّسبة لنا

279
00:18:14,450 --> 00:18:17,180
!ما خطبكِ؟ يبقى الخدم خدماً

280
00:18:17,180 --> 00:18:18,570
!وُجِدوا ليؤمَروا

281
00:18:18,570 --> 00:18:20,870
!كشفتِ عن شعوركِ الحقيقيّ

282
00:18:21,210 --> 00:18:26,680
سمعتُ بأنّ عائلتكِ تقضي على كلّ شخص
!ليس من سلالتكم

283
00:18:26,680 --> 00:18:29,660
،لا أريد انتقاد العائلات الأُخرى

284
00:18:29,660 --> 00:18:34,380
لكنّكم تتخلّصون حتّى من الأزواج
!ولا تثقون بشيء سوى نسلكم

285
00:18:34,660 --> 00:18:36,800
ما أدراكِ ببنية عائلتي؟

286
00:18:36,800 --> 00:18:41,300
بالإضافة إلى ذلك، ليس لديك رجل مُستقلّ
تتّخذينه كمثَل أعلى

287
00:18:41,850 --> 00:18:43,260
مثَل أعلى؟

288
00:18:43,480 --> 00:18:47,640
وأنتِ مهووسة بإجبار الآخرين على طاعتكِ

289
00:18:48,950 --> 00:18:53,900
ولهذا السّبب استشطتِ غضباً من موري-كن
عندما لم يُطعكِ

290
00:18:54,230 --> 00:18:55,500
!اخرسي، اخرسي

291
00:18:55,500 --> 00:18:56,860
!من تعتقدين نفسكِ؟

292
00:18:56,860 --> 00:19:00,240
!بالغة مسؤولة عن توجيه الأطفال

293
00:19:00,240 --> 00:19:03,190
!اخرسي! عمري 20 سنة

294
00:19:03,190 --> 00:19:07,390
!اذهبي وتشبّثي بزوجكِ برأسكِ الفارغ هذا

295
00:19:07,390 --> 00:19:09,740
!سأقود الجزيرة بقوّتي الخاصّة

296
00:19:09,740 --> 00:19:12,130
!الأزواج جميعهم غُرباء على أيّ حال

297
00:19:12,130 --> 00:19:14,790
!لا جدوى من الوثوق بعلاقة حميميّة مُزيّفة

298
00:19:17,630 --> 00:19:19,630
إطلاق عنان التّقنيّة المُحرَّمة

299
00:19:19,630 --> 00:19:20,590
تنشيط القدرة العُظمى

300
00:19:21,590 --> 00:19:27,570
عندما كنتُ في 18 من العمر، قال توشيرو-سان
—هذا الكلام لي عندما أعطاني هذا الخاتم

301
00:19:31,340 --> 00:19:33,490
!ماغي-كن! موري-كن

302
00:19:33,490 --> 00:19:34,730
!أنتما بخير

303
00:19:37,470 --> 00:19:39,630
وصلتما إلى هنا أيضاً؟

304
00:19:40,210 --> 00:19:41,700
كيوكو، ما الأمر؟

305
00:19:44,910 --> 00:19:46,830
!عجيب أمرك

306
00:19:46,830 --> 00:19:49,500
!لا أحد يتكلّم بهذه الطّريقة

307
00:19:49,500 --> 00:19:50,940
!هذا غير مُمكن

308
00:19:50,940 --> 00:19:54,530
!سأصبح شخصاً عظيماً من تلقاء نفسي

309
00:19:54,530 --> 00:19:56,170
!سنتكلّم بهذه الطّريقة إن أردتِ

310
00:19:56,170 --> 00:19:57,170
!ليس  أنت

311
00:19:57,170 --> 00:20:00,630
!أنت تقول ذلك من باب الطّاعة فقط

312
00:20:00,630 --> 00:20:03,680
لكن نحن مُستعدّون لقول أيّ شيء
!تطلبين منّا قوله

313
00:20:03,680 --> 00:20:06,210
يبدو أنّه حدث شيء، لكن لن أسأل

314
00:20:07,070 --> 00:20:09,150
هل أدّى إيكيبوكورو-تشان بشكل جيّد؟

315
00:20:09,150 --> 00:20:12,560
إيكيبوكورو يأكل حاليّاً النّصف البشريّ
من "إنسان البحر" الآن

316
00:20:22,150 --> 00:20:24,410
!إنّها الشّهقة الأخيرة لإنسان البحر

317
00:20:24,410 --> 00:20:27,080
!استهدفَتها لأنّها يائسة لسبب ما

318
00:20:29,110 --> 00:20:31,540
!ثمّة شيء يسحبني

319
00:20:31,540 --> 00:20:33,060
!فتاة ساميجيما

320
00:20:33,060 --> 00:20:34,830
!إنّها تُجرَف بعيداً

321
00:20:35,150 --> 00:20:36,650
!دعوا الأمر لي

322
00:20:39,270 --> 00:20:41,300
!شيو-تشان؟! لحظة، لحظة، لحظة

323
00:20:43,730 --> 00:20:45,340
!ارتديتِ هذا تحت ملابسكِ؟

324
00:20:45,340 --> 00:20:48,030
شيو-تشان، هل كنتِ تُخطّطين للسّباحة؟

325
00:20:48,030 --> 00:20:52,230
ظننتُها ستكون جزيرة مع شاطئ، لذا
ارتديتُ هذا بدلاً من ملابس داخليّة

326
00:20:52,230 --> 00:20:55,820
لماذا ترتدين هذا في شاطئ؟

327
00:20:55,820 --> 00:20:58,010
لعلّها خطّطتْ لسباحة طويلة المسافة

328
00:20:58,010 --> 00:21:01,990
،وإذا ارتديتِ هذا بدلاً من ملابس داخليّة
فما الّذي كنتِ ستفعلينه بعد أن تسبحي؟

329
00:21:02,820 --> 00:21:04,010
!هذا خطير جدّاً

330
00:21:04,010 --> 00:21:06,410
ألم أخبركِ بأنّ التّيّارات فريدة من نوعها؟

331
00:21:07,390 --> 00:21:08,570
!هذه أنا

332
00:21:16,540 --> 00:21:19,910
ماغي-كن وأنا عانينا كثيراً في تلك المياه

333
00:21:24,290 --> 00:21:27,930
وهكذا، وُلِدت أسطورة إنسان بحر جديدة

334
00:21:27,930 --> 00:21:35,760
يُقال بأنّ امرأة شابّة ظهرتْ وسبحتْ
كسمكة لإنقاذ ابنة شيخ القرية

335
00:21:35,760 --> 00:21:38,770
،وبما أنّ سرعتها كانت خارقة

336
00:21:38,770 --> 00:21:43,440
فلا بُدّ أنّها كانت الإنسان البحر الموصوفة
في أسطورة الجزيرة

337
00:21:43,740 --> 00:21:47,450
هكذا وصفت الجدّةُ هانادا الحدثَ لاحقاً

338
00:21:48,380 --> 00:21:50,450
نسيتُ إحضار غيار من الملابس الدّاخليّة

339
00:21:51,230 --> 00:21:54,080
ألم يأتِ الرّئيس ساميجيما إلى هنا بعد؟

340
00:21:59,030 --> 00:22:03,350
إنسان البحر. إنسان البحر مُرعب