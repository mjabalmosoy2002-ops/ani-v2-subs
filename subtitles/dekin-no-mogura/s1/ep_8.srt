1
00:01:38,030 --> 00:01:41,410
،إنّه ضعيفٌ جدّاً، وعقله يتدهور

2
00:01:41,860 --> 00:01:45,380
لكن سمعت ما قلتُه لماغي-كن، صحيح؟

3
00:01:45,380 --> 00:01:48,540
أنقذت والد جدّي، أليس كذلك؟

4
00:01:49,960 --> 00:01:53,550
كتبَ الأُستاذ عنه غالباً في روايته أيضاً

5
00:01:54,020 --> 00:01:55,420
إذاً إنّه حيّ

6
00:01:55,420 --> 00:02:00,160
بالتّفكير في الأمر الآن، كان
يقول كلاماً غريباً

7
00:02:00,160 --> 00:02:03,050
يايكو، دعينا لا نذهب إلى الشّاطئ الآن

8
00:02:03,050 --> 00:02:04,620
وإلّا سننجرّ للأمر

9
00:02:04,620 --> 00:02:07,810
اكتشفتُ للتوّ بأنّه كان رجلاً
،ورِعاً جدّاً من الرّيف

10
00:02:07,810 --> 00:02:11,730
لكن تكلّمتَ عن كيفيّة إقحامك لنا
،في كلّ هذا

11
00:02:11,730 --> 00:02:14,370
وهذا هو سبب قدرتنا على رؤية الأشياء الآن

12
00:02:14,370 --> 00:02:16,990
لكن هناك طُرُق كثيرة يستطيع المرء
من خلالها الانخراط في الأمر، صحيح؟

13
00:02:18,280 --> 00:02:22,280
حتّى الصّداقة أو مُساعدة شخص
تُعَدُّ كارتباط بالأمر

14
00:02:22,280 --> 00:02:24,120
أعتقد بأنّ هذا يعتمد أيضاً
،على الشّخص نفسه

15
00:02:24,420 --> 00:02:28,910
لكن إن كان الأمر كذلك، فسيغدو من المنطقيّ
أن يتمكّن والد جدّي من رؤية الأشياء

16
00:02:29,140 --> 00:02:31,250
هل ترغب في مُقابلته؟

17
00:02:32,630 --> 00:02:36,760
وفي هذه الأيّام، يبدو أنّه يقضي وقتاً أكبر
...في الماضي منه في الحاضر

18
00:02:36,760 --> 00:02:40,570
سننقل الخشب لإنشاء المُخيّم ثانية؟

19
00:02:41,700 --> 00:02:44,540
إنّه عمل مُرهِق بما أنّني صغير جدّاً

20
00:02:44,540 --> 00:02:47,490
والد جدّي، ليس عليك فعل هذا بعد الآن

21
00:02:47,490 --> 00:02:48,730
تناول دونات

22
00:02:48,730 --> 00:02:51,990
إلى أين ذهب المُجنّدون الجدُد الآخرون؟

23
00:02:51,990 --> 00:02:54,730
سيقعون في ورطة مع المُخضرمين

24
00:02:55,060 --> 00:02:59,070
قد يكون طلباً أنانيّاً، لكن
أريدك أن تلتقي به

25
00:02:59,540 --> 00:03:03,280
لا، ربّما أريد رؤية ما سيحدث إذا التقيته. آسفة

26
00:03:04,590 --> 00:03:05,780
هل هذا يعني "لا"؟

27
00:03:05,780 --> 00:03:07,370
هل سيكون ذلك خطيراً؟

28
00:03:07,370 --> 00:03:11,680
وأيضاً، طعام موطني لذيذ، ويمكنك
أن تأكل ما تشاء

29
00:03:11,680 --> 00:03:13,040
أريد الذّهاب

30
00:03:13,040 --> 00:03:15,540
أريد الذّهاب، لكن ثمّة مُشكلة

31
00:03:15,780 --> 00:03:17,210
!لا أتحمّل نفقات السّفر

32
00:03:17,210 --> 00:03:18,820
!سأُسدّد ثمن ذلك

33
00:03:18,820 --> 00:03:21,700
لا أستطيع أن أطلب من تلميذ يدفع لي

34
00:03:21,700 --> 00:03:24,600
ماذا عن كلّ الطّعام الّذي
جعلتني أُسدّد ثمنه؟

35
00:03:25,090 --> 00:03:26,940
سأضطرّ لاستخدام ورقتي الرّابحة

36
00:03:27,850 --> 00:03:29,310
سأدع توشيرو يدفع

37
00:03:29,310 --> 00:03:31,810
هكذا أصبح ريو-سان تدريجيّاً أكثر وقاحة

38
00:03:31,810 --> 00:03:34,480
حيال تسوُّل المال من ناكاغاوا

39
00:03:34,480 --> 00:03:36,590
لديّ سبب كما تعلم

40
00:03:36,590 --> 00:03:40,950
فهو يكتب عن تحليل وتاريخ
الخيال وأدب الأطفال

41
00:03:41,540 --> 00:03:44,490
إذا دعيتُه، فغالباً سيأتي

42
00:03:44,490 --> 00:03:45,820
سأستغلّ ذلك

43
00:03:45,820 --> 00:03:49,120
،لستُ متأكّداً من أنّ هذا منطقيّ
لكن أيّاً يكن

44
00:03:50,040 --> 00:03:53,290
ياي-تشان، من أين أنتِ على أيّ حال؟

45
00:03:54,370 --> 00:03:55,390
من جزيرة

46
00:03:56,410 --> 00:03:58,970
!يمكنني رؤيتها الآن

47
00:03:57,070 --> 00:03:58,380
هذه جزيرة

48
00:04:00,350 --> 00:04:01,990
أسطورة شعب البحر؟

49
00:04:01,990 --> 00:04:05,760
هذا موضوع جيّد لمقالة حول أدب
الأطفال يا ماغي-كن

50
00:04:06,030 --> 00:04:10,370
مُؤلّف الأطفال الأوّل في اليابان
كتب عن شعب البحر اليابانيّ

51
00:04:10,370 --> 00:04:11,730
تقصد أوغاوا ميمي

52
00:04:11,730 --> 00:04:12,760
أحبُّ أعماله

53
00:04:12,760 --> 00:04:14,980
تلك القصّة مُخيفة جدّاً حقّاً

54
00:04:14,980 --> 00:04:16,850
لقد قرأتُها أيضاً

55
00:04:16,850 --> 00:04:18,900
وردتْ في كتاب انتقيتُه منذ فترة طويلة

56
00:04:18,900 --> 00:04:19,790
!كُتُب

57
00:04:19,790 --> 00:04:21,280
!لا يهمّني ما تحكي عنه! أريدها

58
00:04:21,630 --> 00:04:25,570
لهذا السّبب ليس لديك نوع مُعيّن
في رفوف الكُتُب لديك

59
00:04:25,570 --> 00:04:30,410
أجل. في الأشهر القليلة الماضية، انتقيتُ
أربع نسخ من نفس كتاب إصلاح الذّات

60
00:04:30,410 --> 00:04:33,660
أسطورة عن شعب البحر الّذين
يختطفون النّاس؟

61
00:04:33,920 --> 00:04:35,460
كم هذا مُثير للاهتمام

62
00:04:35,460 --> 00:04:39,980
آمل أن نتمكّن من تحديد أصل الأسطورة

63
00:04:39,980 --> 00:04:43,470
لو كان هذا فيلم رُعُب، لقدتنا إلى حتفنا

64
00:04:46,570 --> 00:04:48,330
هنا أوضح بكثير

65
00:04:48,330 --> 00:04:48,920
لنلتقط صورة

66
00:04:48,920 --> 00:04:50,260
ابتسام

67
00:04:50,260 --> 00:04:52,270
ما هذه المجموعة غير المُتوافقة؟

68
00:04:52,270 --> 00:04:57,080
،سيتمّ استجوابي إذا لم أُحضِر سوى رجالاً
لذا أرغب في إحضار فتاة أُخرى

69
00:04:57,080 --> 00:04:59,390
.ستتناولين طعاماً بحريّاً على حسابنا
ما رأيكِ؟

70
00:04:59,390 --> 00:05:00,440
!مُوافقة

71
00:05:00,440 --> 00:05:05,580
لا أحد يعلم ما الّذي سيقوله النّاس
،إذا رافقتُ طالبة جامعيّة بمفردي

72
00:05:05,580 --> 00:05:07,810
لذا آمل أن تجعلوا هذه كإجازة عائليّة

73
00:05:07,810 --> 00:05:09,120
!مرحى

74
00:05:09,120 --> 00:05:12,350
شيو-تشان، هل حصلتِ على إذن من والديكِ؟

75
00:05:12,350 --> 00:05:13,530
لا داعي للقلق

76
00:05:13,530 --> 00:05:16,510
شعار عائلتنا هو "اجعل نفسك
"أقوى بتجربة كلّ شيء

77
00:05:16,830 --> 00:05:19,500
وحتّى أنّني سأُواجه قرشاً أبيض عملاقاً

78
00:05:19,500 --> 00:05:20,570
هذا مُبهر

79
00:05:20,570 --> 00:05:23,260
حتّى جيسون ستيثام لا يستطيع
أن يعلن هذا التحدّي

80
00:05:23,260 --> 00:05:25,620
"لا تقلقي. "شيو" تعني "شعب البحر

81
00:05:25,620 --> 00:05:28,510
سمّاني والدايّ بذلك على أمل
أن أُصبح سبّاحة ماهرة

82
00:05:28,770 --> 00:05:30,720
هذا ما قصداه؟

83
00:05:30,720 --> 00:05:33,270
أخطّط للحصول على شهادة كحارسة إنقاذ

84
00:05:33,270 --> 00:05:35,870
سافرتُ إلى الصّين مع أختي الكبرى
للتدرُّب في الفنون القتاليّة

85
00:05:35,870 --> 00:05:37,860
وغوام للتمرّن على الرّمي بذخيرة حيّة

86
00:05:37,860 --> 00:05:39,220
أُمارس مُختلف أنواع التّدريب

87
00:05:39,220 --> 00:05:40,730
لديك أخت كبرى؟

88
00:05:41,630 --> 00:05:44,770
أجل. إنّها تُعدّ خبز باغيت لي في كلّ صباح

89
00:05:45,240 --> 00:05:47,890
تلك الصّخرة مُبهرة

90
00:05:47,890 --> 00:05:50,240
لا تميلي كثيراً

91
00:05:50,460 --> 00:05:53,400
التّيّارات المدّية هنا فريدة من نوعها

92
00:05:53,400 --> 00:05:57,460
يتعرّض الغُرباء أحياناً لحوادث عندما
يسبحون باستهتار في الماء

93
00:05:57,460 --> 00:06:02,090
هذا يُساهم في عبادة المحلّيين
لشعب البحر والبحر

94
00:06:02,330 --> 00:06:05,650
بالتّفكير في الأمر، النّاس الّذين يعيشون
على ضفّة البحر نادراً ما يسبحون فيه

95
00:06:05,650 --> 00:06:07,840
!أجل، هذا شائع

96
00:06:08,120 --> 00:06:12,510
مثلما الكثير من النّاس الّذين وُلِدوا
في طوكيو لم يزوروا شيبويا أبداً

97
00:06:12,510 --> 00:06:13,600
!لا يزورونها؟

98
00:06:18,890 --> 00:06:21,190
...بالتّفكير في الأمر الآن

99
00:06:21,190 --> 00:06:24,670
حان وقت ارتداء الأحذية الّتي كنتُ
!أدّخرها لحفظ نعالها

100
00:06:24,670 --> 00:06:27,210
!سنخوض رحلة، صحيح؟ أنا مُتحمّس

101
00:06:27,700 --> 00:06:30,530
ستذهبون إلى مكان جميل؟ كم هذا لطيف

102
00:06:30,770 --> 00:06:32,320
رحلة آمنة

103
00:06:32,550 --> 00:06:36,310
،شكراً. إذا رأيتُ أيّ صدفات غير مألوفة
فسوف أجمعها لأجلك

104
00:06:36,310 --> 00:06:38,130
هل هذه هديّة مُناسبة لشخص بالغ؟

105
00:06:38,990 --> 00:06:44,290
"إذاً سُمِح لموغورا للسّفر بعيداً عن "سجنه

106
00:06:44,550 --> 00:06:47,430
رغم أنّني لا أملك فكرة مَن سمح بذلك

107
00:06:48,620 --> 00:06:50,050
...لا، في الواقع

108
00:06:50,050 --> 00:06:52,950
أشعر وكأنّ تلك المنطقة قد تُعدّ
مكانه الآمن

109
00:06:52,950 --> 00:06:56,850
مكان للعيش بعيداً عن عيون الشّرطة
اليابانيّة، مهما كان مُتقوِّضاً

110
00:06:56,850 --> 00:07:00,900
لستُ أفهم ذلك، لكنّه ودود مع تلك المرأة

111
00:07:00,900 --> 00:07:02,420
وحتّى أنّها تُقدّم له حلوى

112
00:07:02,790 --> 00:07:05,360
لو كنتُ أنا، لما رغبتُ في مُغادرة ذلك المكان

113
00:07:05,660 --> 00:07:10,090
لكن أليس الوقوع في هذه الحالة
الذّهنيّة هو القفص الحقيقيّ؟

114
00:07:10,890 --> 00:07:13,010
كنتُ لأفقد عقلي حتماً

115
00:07:13,010 --> 00:07:16,320
لا، غالباً قد فقد عقله فعلاً

116
00:07:16,320 --> 00:07:18,620
إنّه مُتطفِّل بالرّغم من ذلك

117
00:07:18,620 --> 00:07:21,170
الجميع ينتهي المطاف بهم
بطلبِ معروف منهم

118
00:07:21,170 --> 00:07:25,660
،رغم أنّه أخلاقيّ لدرجة ساذجة
وانتهازيّ، وإنسانيّ

119
00:07:25,660 --> 00:07:30,590
سيُقدّم قرابينَ لمُساعدة الآخرين
بالرُّغم من ظروفه

120
00:07:30,590 --> 00:07:33,110
بطريقة أشبه بالخارقة

121
00:07:33,610 --> 00:07:34,600
...هذا يجعلني أتساءل

122
00:07:34,890 --> 00:07:38,100
هل تطفّلنا يُساعده حقّاً؟

123
00:07:38,100 --> 00:07:40,190
ماغي-كن، نحن هنا

124
00:07:41,250 --> 00:07:42,830
!مرحى

125
00:07:47,770 --> 00:07:51,990
المعذرة، ألا ينبغي أن تُخبري عائلتكِ بأنّكِ هنا؟

126
00:07:51,990 --> 00:07:52,990
ماذا؟

127
00:07:53,660 --> 00:07:56,280
يا لك من ابن مدينة يا ماغي-كن

128
00:07:56,590 --> 00:07:58,780
،في اللّحظة الّتي ترجّلنا فيها

129
00:07:58,780 --> 00:08:01,820
أحضرتْ ابنة كيريهيارا غرباءَ إلى الجزيرة"

130
00:08:01,820 --> 00:08:07,280
فتى واحد في سنّها، واثنان بعمر الثّانويّة
تقريباً، وثلاثة أشخاص في الثّلاثينيّات

131
00:08:07,280 --> 00:08:08,800
"لا سجلّ إجراميّ

132
00:08:08,800 --> 00:08:12,290
تلك المعلومات قد انتشرتْ بالفعل
في كلّ أنحاء الجزيرة

133
00:08:12,290 --> 00:08:13,630
!هل هم من السّي آي أي؟

134
00:08:14,190 --> 00:08:17,980
،"إذا أردت شراء شيء، غير "التّعاونيّة
"لدينا "ناكاما

135
00:08:17,980 --> 00:08:20,390
فقط اترك دفعتك إن لم يكن
هناك أيّ موظّف موجود

136
00:08:20,390 --> 00:08:21,680
سأُبلغهم

137
00:08:21,680 --> 00:08:22,850
ماذا يعني "ناكاما"؟

138
00:08:23,110 --> 00:08:25,430
لا أعرف كيف أصِف الأمر بغير ذلك

139
00:08:25,430 --> 00:08:27,690
أيّاً كان ما يفعله أولئك السّماسرة

140
00:08:27,690 --> 00:08:28,900
البائعون

141
00:08:28,900 --> 00:08:32,150
إذاً إنّهم متاجر حيث يتصرّف كافّة
السّكّان المحلّين كزبائن مُنتظمين؟

142
00:08:32,150 --> 00:08:35,100
لا تنصدم كثيراً

143
00:08:35,100 --> 00:08:36,810
هناك كثير من النّاس في الجزيرة

144
00:08:36,810 --> 00:08:41,430
قبل أن أنتقل إلى طوكيو، جميعهم ساعدوني
في التمرّن على عادة الإقفال

145
00:08:41,430 --> 00:08:43,370
قصّة مُثيرة للاهتمام

146
00:08:43,370 --> 00:08:45,750
ماذا تريدان أن تعرفا أيضاً؟

147
00:08:45,970 --> 00:08:50,630
لا تأكل ناتّو أبداً أمام العائلة
المالكة الرّئيسيّة

148
00:08:50,630 --> 00:08:51,510
!لِمَ لا؟

149
00:08:51,770 --> 00:08:53,890
لا تذكر الفاصولياء حتّى

150
00:08:53,890 --> 00:08:55,510
لِمَ لا؟! ما السّبب؟

151
00:08:56,540 --> 00:08:58,960
لِمَ لا تخبريننا السّبب؟

152
00:08:58,960 --> 00:09:04,270
،إذا أصبحت مُقيماً في هذه الجزيرة يوماً

153
00:09:04,270 --> 00:09:07,730
فستُخبَر بذلك في اليوم الثّالث
من عامك الثّالث

154
00:09:07,730 --> 00:09:11,400
ياي-تشان، هل تستمتعين بالعبث
مع سكّان المدينة؟

155
00:09:11,400 --> 00:09:13,030
...بالمناسبة

156
00:09:13,280 --> 00:09:15,370
تظلّ الأرواح تُحدّق بي

157
00:09:15,370 --> 00:09:17,430
هل هم سُكّان جزيرة سابقون؟

158
00:09:18,270 --> 00:09:19,780
أجل، هكذا يبدو

159
00:09:19,780 --> 00:09:23,290
إنّهم فضوليّون حيال الغُرباء

160
00:09:23,770 --> 00:09:25,820
يايكو-تشان

161
00:09:25,820 --> 00:09:27,830
العجوز هانادا

162
00:09:27,830 --> 00:09:30,370
تبدين أنحل من شعرة ضفدع
مشطورة إلى ثمانية أجزاء

163
00:09:30,370 --> 00:09:33,870
بئساً. ليس إلى هذه الدّرجة

164
00:09:33,870 --> 00:09:38,210
وأحضرتُ مجموعة من الوسيمين معكِ

165
00:09:38,210 --> 00:09:40,670
هذا يجعلني أشعر بروح الشّباب ثانية

166
00:09:41,770 --> 00:09:44,470
لا شيء يجعل أهل طوكيو أدنى أكثر من هذا

167
00:09:41,970 --> 00:09:45,060
ما الّذي تقولينه يا عجوز؟

168
00:09:45,060 --> 00:09:48,120
هل أنتِ ذاهبة إلى منزل كيريهارا-سان؟

169
00:09:48,120 --> 00:09:51,420
يمكنكِ استخدام أي من الدرّاجات هنا

170
00:09:51,420 --> 00:09:54,220
فقط أعيديها قبل أن تُغادري

171
00:09:54,220 --> 00:09:55,690
شكراً لكِ

172
00:09:56,000 --> 00:09:58,950
لديهم أسلوبهم الخاصّ في العيش هنا

173
00:09:59,350 --> 00:10:02,470
،المسافة ساعتان سيراً على الأقدام
لذا لنستعر درّاجة

174
00:10:02,470 --> 00:10:05,620
من لديه رخصة ويستطيع أخذ راكب؟

175
00:10:14,960 --> 00:10:17,470
!مرحى

176
00:10:25,770 --> 00:10:30,020
كنتُ لخضتُ عدّة رحلات لو انتظرتَ
!في الميناء

177
00:10:30,020 --> 00:10:32,690
!لا! لا أريد أن أنتظر وحيداً

178
00:10:33,060 --> 00:10:37,820
تبجّحك بسرعة 70 كم\سا عبر
درّاجة لم يكن كذبة

179
00:10:39,860 --> 00:10:42,000
هل هناك سيُقيمون المهرجان؟

180
00:10:42,000 --> 00:10:43,820
يبدو البحر بعيداً في الأسفل

181
00:10:43,820 --> 00:10:46,830
أعتقد بأنّ عائلة ياي-تشان تعيش
في منتصف الجزيرة

182
00:10:49,740 --> 00:10:55,210
،أبي، أمّي، جدّي، جدّتي
!أخوتي وأخواتي

183
00:10:55,210 --> 00:10:57,340
!والد جدّي

184
00:10:59,810 --> 00:11:01,450
أهلاً بعودتكِ يا يايكو

185
00:11:01,450 --> 00:11:03,100
أهلاً بكم أيّها الضّيوف

186
00:11:07,460 --> 00:11:08,970
...أنت

187
00:11:08,970 --> 00:11:12,230
هل أنت ساتو-سان، الشّخص
الجديد في دار البلديّة؟

188
00:11:12,230 --> 00:11:13,360
!من؟

189
00:11:14,220 --> 00:11:18,240
أعتقد لم يخطر على ذهنه
بأنّك ستكون أنت

190
00:11:18,240 --> 00:11:20,810
قد تكون تسريحة شعري

191
00:11:20,810 --> 00:11:23,240
تسريحة الشّعر قد تُغيّر حقّاً
انطباعك عن شخص

192
00:11:23,690 --> 00:11:26,660
آسفة، بعد قطعك كلّ هذه
المسافة إلى هنا

193
00:11:26,660 --> 00:11:28,570
لا، يسرّني ذلك

194
00:11:28,570 --> 00:11:31,460
نادراً ما أتمكّن من اللّقاء بمعارف قُدماء

195
00:11:31,690 --> 00:11:33,330
شكراً يا ياي-تشان

196
00:11:35,300 --> 00:11:38,130
لكن يبدو والد جدّي مُفعماً بالحيويّة اليوم

197
00:11:38,130 --> 00:11:40,690
أعتقد لأنّ لدينا الكثير من الضّيوف

198
00:11:40,690 --> 00:11:43,510
بالتّأكيد. لنستمتع بالمهرجان معاً إذاً

199
00:11:45,510 --> 00:11:46,860
هذا المكان ضخم

200
00:11:46,860 --> 00:11:49,020
هل تنتمي هذه المنطقة بأكملها لعائلتكِ؟

201
00:11:50,190 --> 00:11:53,270
إنّها واسعة فحسب. إنّها ليست
بتلك القيمة الكبيرة

202
00:11:56,150 --> 00:11:59,430
شكراً على الاعتناء بيايكو

203
00:12:01,150 --> 00:12:02,950
إنّهم ضئيلون جدّاً

204
00:12:02,950 --> 00:12:04,260
هذه أختي الصّغرى

205
00:12:04,260 --> 00:12:06,070
ما زالت في الابتدائيّة

206
00:12:06,370 --> 00:12:07,890
هيّا، قولي مرحباً

207
00:12:09,550 --> 00:12:11,540
مرحباً. اسمي يوشينو

208
00:12:11,540 --> 00:12:12,940
وهذا أخي الأصغر

209
00:12:12,940 --> 00:12:13,790
إنّه في الإعداديّة

210
00:12:13,790 --> 00:12:15,460
مرحباً. اسمي مياما

211
00:12:15,700 --> 00:12:18,270
يا لهم من أخوة أبرياء

212
00:12:19,780 --> 00:12:23,300
لا يوجد الكثير هنا، لكن استمتعوا
بالطّعام البحريّ

213
00:12:24,010 --> 00:12:25,550
أختي، هل أحضرتِ أي هدايا؟

214
00:12:25,550 --> 00:12:27,910
تبدو جشعاً جدّاً عندما تُعبّر
عن الأمر بهذه الطّريقة

215
00:12:27,910 --> 00:12:29,850
لكنّني فعلتُ. خُذ

216
00:12:29,850 --> 00:12:32,490
لا يصنعون هذا إلّا في طوكيو

217
00:12:32,490 --> 00:12:34,440
حسناً! شكراً يا أختي

218
00:12:34,440 --> 00:12:36,190
أيّها الطّمّاع

219
00:12:36,190 --> 00:12:39,070
محظوظة. ليت أخي مثله

220
00:12:39,070 --> 00:12:44,020
أعلم بأنّكما وصلتما إلى هنا للتو، لكن
علينا الذّهاب وتقديم المُساعدة

221
00:12:44,020 --> 00:12:45,450
يمكنكما التجوّل في الجزيرة بحرّية

222
00:12:45,750 --> 00:12:48,710
يايكو، هلّا أخذتِ والد جدّكِ معكِ؟

223
00:12:48,710 --> 00:12:49,530
حسناً

224
00:12:53,780 --> 00:12:55,710
هذا على نطاق واسع جدّاً

225
00:12:55,710 --> 00:12:57,820
كامل الجزيرة هنا

226
00:12:57,820 --> 00:12:59,170
يُقام المهرجان الفعليّ غداً

227
00:12:59,690 --> 00:13:03,010
هذا تمثال شعب البحر. إنّه المعلَم
الرّئيسيّ للمهرجان

228
00:13:04,110 --> 00:13:06,130
إنّه هذا النّوع من شعب البحر إذاً

229
00:13:06,130 --> 00:13:08,130
يُسمَح لك بالتقاط صور

230
00:13:08,130 --> 00:13:12,020
ممتاز. ستكون بضعة صور مثاليّة لتقريري

231
00:13:12,020 --> 00:13:16,440
صحيح؟ من ذا الّذي لا يُرفق
مع تقاريره صوراً؟

232
00:13:16,440 --> 00:13:19,830
إنّ الرّمي على ذلك التّمثال بالسِّهام
هو الحدث الأبرز في المهرجان

233
00:13:19,830 --> 00:13:21,530
عقب ذلك، يتمّ حرقه

234
00:13:21,530 --> 00:13:24,250
فهمت. لطرد الحظّ السّيّئ

235
00:13:24,250 --> 00:13:26,430
يفعلون ذلك في طقوس تسوينا أيضاً

236
00:13:27,900 --> 00:13:34,060
تُمارَس مُختلف أنواع الحركات أثناء
الطّقس، لكن حاول مُجاراتها

237
00:13:34,060 --> 00:13:35,010
ما هذا؟

238
00:13:35,010 --> 00:13:36,920
أنا مهتمّ بهذا أكثر من الحدث الرّئيسيّ

239
00:13:37,450 --> 00:13:42,880
،من الأفضل إشراك أكبر عدد مُمكن من المُشاركين
لهذا السّبب يُرحَّب بالضّيوف

240
00:13:42,880 --> 00:13:46,340
لِمَ لا تشرحين الأسباب خلف
قواعد الجزيرة أبداً؟

241
00:13:46,340 --> 00:13:48,550
دعيني أكتب عنها في تقريري

242
00:13:48,550 --> 00:13:50,870
مجال رماية

243
00:13:50,870 --> 00:13:52,310
والد جدّي، هل تريد تجربة ذلك؟

244
00:13:52,570 --> 00:13:54,640
لنفعلها أيضاً

245
00:13:54,640 --> 00:13:56,530
ماغي، أنت تلعب ألعاب منظور شخص
أوّل، أليس كذلك؟

246
00:13:56,530 --> 00:13:57,970
أرِنا مهاراتك

247
00:13:57,970 --> 00:13:59,190
ماذا؟

248
00:13:59,190 --> 00:14:01,860
سيّدي، هل ترغب في التّجربة كذلك؟

249
00:14:02,250 --> 00:14:03,480
ما الأمر؟

250
00:14:05,870 --> 00:14:09,310
إيكيبوكورو تحبّ هذا ولا تُريد المُغادرة

251
00:14:09,740 --> 00:14:11,530
هذا الشّيء لتجفيف السّمك

252
00:14:11,530 --> 00:14:13,630
إنّها تطلب بأن آكل السّمك

253
00:14:13,630 --> 00:14:16,540
تتذوّق إيكيبوكورو كلّ ما آكله

254
00:14:16,830 --> 00:14:18,870
هكذا يسير الأمر إذاً؟

255
00:14:19,210 --> 00:14:22,500
إنّها تطلب أيضاً بأن أحصل
على إحدى هذه الأدوات

256
00:14:24,460 --> 00:14:26,820
!والد الجدّ، مُذهل

257
00:14:26,820 --> 00:14:28,180
!غاية في الرّوعة

258
00:14:28,620 --> 00:14:30,390
لستَ سيّئاً أيضاً

259
00:14:30,390 --> 00:14:33,050
لا. أنت أفضل منّي بكثير

260
00:14:33,270 --> 00:14:36,520
على ذكر الأمر، كان رامياً ماهراً

261
00:14:36,520 --> 00:14:39,850
كان يحمل والد جدّي رخصة صيد

262
00:14:41,450 --> 00:14:43,480
هل تريد التّجربة يا ساتو-سان؟

263
00:14:43,950 --> 00:14:45,780
!لستُ ساتو-سان

264
00:14:47,070 --> 00:14:48,270
أنا سيّئ

265
00:14:48,270 --> 00:14:50,110
لطالما كنتُ سيّئاً في التّعامل
مع الأسلحة النّاريّة

266
00:14:50,110 --> 00:14:53,060
لا يمكنك إصابة شيء يا ساتو-سان

267
00:14:53,060 --> 00:14:55,040
!أخبرتُك بأنّني لستُ ساتو-سان

268
00:14:55,040 --> 00:14:56,890
أنت سيّئ فعلاً

269
00:14:56,890 --> 00:14:59,350
أنت تُحرج نفسك أمام الصّغار

270
00:15:05,170 --> 00:15:07,420
!يا للرّوعة يا موغورا-سان

271
00:15:08,060 --> 00:15:11,240
يمكنكن أن تخترنَ أيّ جائزة
تُرِدن يا آنسات

272
00:15:11,240 --> 00:15:12,680
!مرحى! شكراً

273
00:15:12,680 --> 00:15:14,420
...ساتو-سان

274
00:15:15,220 --> 00:15:18,390
ألا تعتقد بأنّه من الطّفوليّ أن تتصرّف
هكذا تجاه من هم أكبر منك؟

275
00:15:18,390 --> 00:15:19,430
!أيّها العجوز الخرف

276
00:15:19,680 --> 00:15:22,730
يبدو والد جدّي مُستمتع بوقته

277
00:15:23,290 --> 00:15:26,220
لطالما كان مغروراً ولديه روح المُنافسة

278
00:15:26,220 --> 00:15:28,070
إنّه والد جدّ ظريف

279
00:15:28,580 --> 00:15:32,790
على أيّ حال، كلّاً من الأسلحة النّاريّة
والأقواس تُستعمَلان للرّمي على الأهداف

280
00:15:32,790 --> 00:15:35,280
لكن أعتقد يمكن أن يكون المرء ماهراً
بأحدهما دوناً عن الآخر

281
00:15:35,280 --> 00:15:37,960
،حسناً، يعتمد هذا على الشّخص

282
00:15:37,960 --> 00:15:42,620
لكن آليّة عملهما مُختلفة، وطريقة
التّصويب مُختلفة

283
00:15:42,620 --> 00:15:45,820
أتساءل ما إن كان يوجد أشخاص
،بارعون بكليهما

284
00:15:45,820 --> 00:15:47,100
سيكون ذلك مُدهشاً

285
00:15:47,100 --> 00:15:49,060
هكذا يسير الأمر إذاً؟

286
00:15:49,060 --> 00:15:52,130
...يعتمد الأمر على الشّخص، لكن

287
00:15:52,130 --> 00:15:57,140
هل هذا يعني بأنّه استخدمَ
قوساً لفترة أطول بكثير؟

288
00:15:57,430 --> 00:16:00,890
يايكو-سان، يمكنكِ رؤية المُحيط
بوضوح من هنا

289
00:16:01,540 --> 00:16:04,310
تلك هي الصّخرة الّتي رأيناها
أثناء الوصول عبر القارب

290
00:16:04,540 --> 00:16:06,690
...تُدعى بصخرة شعب البحر، و

291
00:16:08,610 --> 00:16:11,420
يبدو كأنّ شيئاً ينبثق من البحر

292
00:16:21,300 --> 00:16:24,580
فهمت. هذا هو شعب البحر إذاً

293
00:16:24,580 --> 00:16:28,640
حوادث في البحر، وسُفُن مقلوبة وغرق
انتحاريّ وكوارث طبيعيّة

294
00:16:28,640 --> 00:16:30,260
تحدث أمور كثيرة في المُحيط

295
00:16:30,480 --> 00:16:33,170
إنّها مجموعة من الفواجع في البحر إذاً

296
00:16:33,170 --> 00:16:35,760
هذا ليس بالغريب، لكنّه ضخم

297
00:16:37,900 --> 00:16:40,300
لا بُدّ أنّه انبثق بسبب المهرجان

298
00:16:40,300 --> 00:16:44,440
،كما قلتُ عندما تعاملنا مع روح المُلاحِق
كثير من الأرواح تريد أن تُلاحَظ

299
00:16:50,590 --> 00:16:52,990
...يا كائن البحر

300
00:16:52,990 --> 00:16:56,370
هذا المهرجان هو حقّاً لتهدئة شعب البحر إذاً

301
00:16:56,370 --> 00:17:00,240
على متن القارب هنا، قلتُ بأنّ تيّارات
،المدّ كانت فريدة من نوعها

302
00:17:00,240 --> 00:17:04,250
،لكن تلك الصّخرة، صخرة شعب البحر
تُعرف أيضاً باسم صخرة الوصول

303
00:17:04,490 --> 00:17:09,040
عندما يقع حادث في البحر، يُجرَف الجسد
بشكل مُتكرّر إلى هناك

304
00:17:09,300 --> 00:17:12,700
هذا يُفسّر كلّ الأرواح المُجتمعة هناك

305
00:17:12,700 --> 00:17:14,770
إحساسهم بالفرديّة ضعيف

306
00:17:14,770 --> 00:17:18,680
على ذكر الأمر، بدا ماغي-كن
خائفاً في الطّريق إلى هنا

307
00:17:18,680 --> 00:17:22,190
معظم النّاس لا يستطيعون رؤية هذا، صحيح؟

308
00:17:22,190 --> 00:17:24,930
سيكون هذا مُشوِّشاً عندما أكتب تقريري

309
00:17:24,930 --> 00:17:30,320
هناك صعوبة في وصف ما رأيتَه
وكأنّك لم تره

310
00:17:30,320 --> 00:17:31,800
أمرّ بهذا طوال الوقت

311
00:17:31,800 --> 00:17:35,700
على أيّ حال، من النّادر أن يتّخذ
هؤلاء شكل شعب البحر

312
00:17:35,700 --> 00:17:39,280
قد يكون هذا مُشابهاً لإيكيبوكورو ونابيشيما

313
00:17:39,280 --> 00:17:42,010
شعب البحر موجود فعلاً

314
00:17:42,010 --> 00:17:44,400
هل هذا آمن؟

315
00:17:44,400 --> 00:17:47,790
حسناً، شعب البحر حزين

316
00:17:48,250 --> 00:17:52,840
من خلال العبادة، يجب الحفاظ على المسافة
بين هذا العالم والحياة الآخرة

317
00:17:53,100 --> 00:17:58,250
لا يسعنا فعل شيء حيال حزن
شعب البحر

318
00:17:58,250 --> 00:18:02,400
كلّ ما يمكننا فعله هو الحرص على
ألّا ننجرّ لهذا الأمر

319
00:18:02,400 --> 00:18:04,180
من المُهمّ وضع حدّ

320
00:18:04,930 --> 00:18:06,850
يقول ذلك طوال الوقت

321
00:18:06,850 --> 00:18:08,600
ربّما يستطيع رؤيته فعلاً

322
00:18:11,070 --> 00:18:15,110
أنا مُندهش من قدرتك على التّعافي
يا كيريهارا

323
00:18:15,110 --> 00:18:17,060
روح الشّباب مُدهشة، صحيح؟

324
00:18:17,060 --> 00:18:19,070
أنا مُتفاجئ أيضاً

325
00:18:24,490 --> 00:18:26,140
هل يمكنك رؤيتهم أيضاً؟

326
00:18:26,140 --> 00:18:26,750
ماذا؟

327
00:18:26,750 --> 00:18:30,350
أنا وأنت في حالة يُرثى لها، صحيح؟

328
00:18:30,350 --> 00:18:31,800
كُن قويّاً

329
00:18:31,800 --> 00:18:37,010
حتّى لو لم يكن هذا وهماً، كلّ ما يمكننا
فعله هو الحرص على ألّا ننجرّ للأمر

330
00:18:37,350 --> 00:18:41,300
أنت تقدّم الطّعام للّذين يحتضرون، صحيح؟

331
00:18:41,300 --> 00:18:42,260
،هذا عملٌ نبيل

332
00:18:42,260 --> 00:18:46,020
لكن أعتقد بأنّ عليك أن تضع حدّاً

333
00:18:48,290 --> 00:18:49,020
ماذا؟

334
00:18:51,710 --> 00:18:53,270
ما الأمر يا ياي-تشان؟

335
00:18:55,990 --> 00:18:57,440
المعذرة، موري-كن؟

336
00:19:00,810 --> 00:19:03,470
أهذا أنت يا موري-كن؟ لا؟

337
00:19:03,470 --> 00:19:04,910
...المعذرة، هل هذا

338
00:19:06,410 --> 00:19:09,110
كيريهارا يايكو. لم أرك منذ وقت

339
00:19:09,110 --> 00:19:09,790
...المعذرة

340
00:19:15,540 --> 00:19:16,500
صديق لك؟

341
00:19:17,030 --> 00:19:19,340
...أجل، لكن

342
00:19:23,550 --> 00:19:25,260
حدث أُمسية المهرجان قد بدأ

343
00:19:25,500 --> 00:19:27,770
لنتفقّده

344
00:19:29,310 --> 00:19:30,270
ماغي

345
00:19:30,270 --> 00:19:32,180
لا تُحدِّق طويلاً

346
00:19:32,180 --> 00:19:35,610
كما قلتُ، إذا أُعجِبَتْ بك روحٌ
،تبحث عن اهتمام

347
00:19:35,610 --> 00:19:37,310
فقد تُمَسّ في نهاية المطاف

348
00:19:37,310 --> 00:19:38,570
حسناً

349
00:19:38,820 --> 00:19:43,400
لا بُدّ أنّ هذا ما يقصدونه بافتتان النّاس
بواسطة شعب البحر واختطافهم بواسطتهم

350
00:19:43,400 --> 00:19:44,820
لا تلق بالاً لها

351
00:19:45,060 --> 00:19:50,200
يا ضيوف الجزيرة، شكراً لكم على القدوم اليوم

352
00:19:50,200 --> 00:19:55,660
باسم سكّان الجزيرة، عائلة ساميجيما تشكركم

353
00:19:54,610 --> 00:19:58,670
هذه هي الأسرة الرّئيسيّة من العائلة المالكة

354
00:19:55,950 --> 00:20:00,470
يعود تاريخ مهرجان هذا الرّبيع
إلى عصر كيتشو

355
00:19:58,670 --> 00:20:00,470
لم تأكلوا فاصولياء، أليس كذلك؟

356
00:20:00,470 --> 00:20:03,340
بجدّية، ما هذه القاعدة المُخيفة المُبهمة؟

357
00:20:02,090 --> 00:20:06,510
منذ ذلك الحين، تمّ توارثه من جيل
لآخر دون انقطاع

358
00:20:04,340 --> 00:20:07,050
هل هي ملكة الجزيرة؟

359
00:20:06,510 --> 00:20:10,770
لسنوات كحدث مُهمّ في الجزيرة

360
00:20:07,050 --> 00:20:08,350
شيء من هذا القبيل

361
00:20:08,350 --> 00:20:10,770
بعبارة أدقّ، إنّها أمُّ الملك

362
00:20:10,770 --> 00:20:16,760
مثل والدَي، مُعظم سكّان الجزيرة
يعملون لحساب شركة مُعالجة طعام بحريّ

363
00:20:16,760 --> 00:20:20,370
رئيس الشّركة هو ابن تلك المرأة

364
00:20:20,370 --> 00:20:23,990
كانت عائلتها في الأصل من كبار القرية

365
00:20:23,990 --> 00:20:26,740
هذا هو ابنها، الرّئيس

366
00:20:26,740 --> 00:20:29,990
على أيّ حال، إنّها ذات سلطة
على كافّة سكّان الجزيرة الآخرين

367
00:20:29,990 --> 00:20:31,620
إنّها بتلك الأهمّية؟

368
00:20:31,620 --> 00:20:34,330
أجل، هذا مختلف عن طوكيو

369
00:20:34,330 --> 00:20:37,010
احذر ممّا تقوله. سيستهدفونك

370
00:20:37,010 --> 00:20:37,790
من "هُم"؟

371
00:20:37,790 --> 00:20:38,660
السّلطات

372
00:20:38,660 --> 00:20:39,710
!السّلطات؟

373
00:20:39,940 --> 00:20:42,370
انضمّوا إلينا جميعاً رجاء

374
00:20:42,370 --> 00:20:48,970
على أيّ حال، تحرص عائلتهم على ازدهار
الجزيرة، لذا يعرفون ما يجري

375
00:20:51,410 --> 00:20:54,140
شكراً لكم

376
00:20:55,540 --> 00:20:57,810
هذه هي موهبة القويّ

377
00:21:03,860 --> 00:21:05,020
!طعام بحريّ

378
00:21:04,350 --> 00:21:06,240
!طعام بحريّ، طعام بحريّ

379
00:21:05,020 --> 00:21:06,240
!كُلوا ما تشاؤون

380
00:21:06,240 --> 00:21:07,160
كُلوا ما تشاؤون

381
00:21:07,440 --> 00:21:09,530
!سيحظى كلّ شخص بعشر دقائق للاستحمام

382
00:21:09,530 --> 00:21:12,130
!كرحلة مدرسيّة صارمة

383
00:21:12,130 --> 00:21:15,960
،يستطيع الرّجال النّوم في الطّابق الأوّل
والنّساء سينمنَ في الثّاني

384
00:21:15,960 --> 00:21:17,350
آسفة يا كيو-تشان

385
00:21:17,350 --> 00:21:20,340
ليت تحصل عائلتك على غرفة خاصّة بها

386
00:21:20,340 --> 00:21:22,570
لا مُشكلة. لا تقلقي بشأن ذلك

387
00:21:22,570 --> 00:21:25,380
توشيرو-سان، سنضطرّ للنّوم
بشكل مُنفصل اللّيلة

388
00:21:25,870 --> 00:21:27,230
بالمناسبة

389
00:21:27,230 --> 00:21:31,790
يايكو-تشان، أنا آسفة على تطفُّلي

390
00:21:32,230 --> 00:21:34,110
...لكن صديقك موري-كن في الحدث

391
00:21:34,110 --> 00:21:36,640
هل هو، عذراً... فهمتِ؟

392
00:21:36,860 --> 00:21:37,810
ماذا؟

393
00:21:37,810 --> 00:21:40,500
إن كان كذلك، فلا تقلقي بشأن ذلك إذاً

394
00:21:40,500 --> 00:21:43,440
بدا مُحبَطاً قليلاً فحسب

395
00:21:44,010 --> 00:21:45,350
ماذا رأيتِ؟

396
00:21:45,350 --> 00:21:46,950
الأمر غير مُؤكَّد

397
00:21:47,670 --> 00:21:49,390
لحظة واحدة

398
00:21:52,080 --> 00:21:57,080
آمل ألّا يجعلكم هذا تتحاملون عليه

399
00:21:57,080 --> 00:22:00,270
اسمحوا لي بالقول بأنّ المظاهر ليست كلّ شيء

400
00:22:00,270 --> 00:22:04,610
لكن هكذا كان شكل موري-كن في الثّانويّة