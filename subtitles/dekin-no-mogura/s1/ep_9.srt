1
00:01:38,530 --> 00:01:39,700
ما هذا؟

2
00:01:40,010 --> 00:01:42,330
ماغي، هذا واضح

3
00:01:42,330 --> 00:01:45,120
أنت قلق بشأن شيء آخر الآن

4
00:01:45,400 --> 00:01:49,900
وجه الشّخص الّذي أنا مُعجب به"
"لديه وجه جذّاب

5
00:01:49,900 --> 00:01:52,910
عليك فعل كلّ ما يمكنك فعله لمنع هذا

6
00:01:52,910 --> 00:01:54,630
اصمت يا عجوز

7
00:01:54,880 --> 00:01:58,990
بحسب الظّروف، قد تلجأ لإجراءات غير قانونيّة

8
00:01:58,990 --> 00:02:00,730
إن أردت، فسأساعدك

9
00:02:00,730 --> 00:02:04,730
،من وجهة نظر المُجتمع، أنا غير موجود
لذا أنا مُفيد من هذه النّاحية

10
00:02:04,730 --> 00:02:06,240
اصمت من فضلك يا عجوز

11
00:02:06,240 --> 00:02:09,150
"قد تسأل نفسك، "ما أهمّية هذا؟

12
00:02:09,460 --> 00:02:12,770
لكن من الطّبيعيّ التّساؤل عمّا حدث له، صحيح؟

13
00:02:12,770 --> 00:02:19,490
صحيح. بما أنّك هنا، قد يكون من
الجيّد التكلُّم معه

14
00:02:19,490 --> 00:02:23,390
ياي-تشان، كيف عرفتِ بأنّه موري-كن
حالما رأيتِه؟

15
00:02:23,390 --> 00:02:24,620
كانت دُميته

16
00:02:25,490 --> 00:02:27,990
أنا صنعتُها

17
00:02:27,990 --> 00:02:32,000
في أيّام المدرسة الثّانويّة، شخصيّة لعبة الفيديو تلك
كانت غير مشهورة، لذا لم تكن لها بضاعة خاصّة بها

18
00:02:32,000 --> 00:02:36,260
أحبَّ موري-كن نفس لعبة الفيديو
وأراد شيئاً، لذا صنعتُها له

19
00:02:36,260 --> 00:02:38,780
أجل، لا أستطيع فهم الأمر
بمُجرّد التّفكير فيه

20
00:02:38,780 --> 00:02:41,810
أنا مصدومة ومُرهَقة من مسألة
شعب البحر اليوم

21
00:02:41,810 --> 00:02:42,730
لنخلد إلى النّوم

22
00:02:42,730 --> 00:02:46,100
معك حقّ. لكن أملي قد خاب
لعجزي عن رؤيته

23
00:02:46,410 --> 00:02:48,550
يايكو-سان، لنبدّل ملابسنا بالبيجاما ونُدردش

24
00:02:48,550 --> 00:02:50,310
حسناً. بالمناسبة

25
00:02:50,590 --> 00:02:52,150
هذه لوقت النّوم

26
00:02:52,440 --> 00:02:53,460
ما هذه؟

27
00:02:53,860 --> 00:02:56,230
،إذا سقطتْ حريشةٌ من السّقف
فاستخدم هذه

28
00:02:56,450 --> 00:02:57,360
!حريشة؟

29
00:02:57,580 --> 00:02:59,550
لا تلمسها بيديك المُجرّدتين

30
00:02:59,550 --> 00:03:01,180
حسناً، طابت ليلتك

31
00:03:01,180 --> 00:03:02,150
!حريشة؟

32
00:03:02,150 --> 00:03:05,080
يمكنك أكل الحريشة كما تعلم

33
00:03:07,170 --> 00:03:09,510
هيّا يا يايكو-تشان. انضمّي لنا

34
00:03:09,980 --> 00:03:12,250
عمّاذا تتكلّمان؟

35
00:03:12,990 --> 00:03:15,250
يايكو-تشان، من تُحبّين؟

36
00:03:15,250 --> 00:03:17,260
!أحبّ زوجي

37
00:03:17,260 --> 00:03:21,090
أجل، ستكون مُشكلة كبيرة
إذا أحببتِ شخصاً آخر

38
00:03:22,220 --> 00:03:26,300
،في هذه الحالة، شيو-تشان ويايكو-تشان
هل أنتما ساديّتان أم مازوخيّتان؟

39
00:03:26,300 --> 00:03:28,550
أيّ موضوع هو هذا؟

40
00:03:28,550 --> 00:03:29,980
!يا للعجب

41
00:03:29,980 --> 00:03:31,810
!أنا مازوخيّة حرفيّاً

42
00:03:31,810 --> 00:03:36,320
أشعر وكأنّ هذه حروق مُباشرة
من طرف أستاذ حلقتي الدّراسيّة

43
00:03:44,340 --> 00:03:48,580
أرواح البحر الّتي فقدت إحساسها
بالذّات وتبكي كالأطفال الرُّضَّع

44
00:03:48,810 --> 00:03:53,860
.مهرجان الجزيرة. أصحاب النّفوذ
صديقي من الجزيرة

45
00:03:53,860 --> 00:03:55,620
والد جدّ صديقي

46
00:03:55,940 --> 00:03:58,340
زميل صفّ صديقي المُتحوِّل حرفيّاً

47
00:03:58,690 --> 00:04:03,260
،دعوة من صديقة، وركوب درّاجتها

48
00:04:03,260 --> 00:04:06,070
واللّقاء بعائلتها، والآن الإقامة في منزلها

49
00:04:07,050 --> 00:04:09,740
ذاتي المُستقبليّة من 20 سنة
،بعد الآن تصيح قائلة لي

50
00:04:10,140 --> 00:04:13,520
هل لديك أدنى فكرة كم"
"أنّ هذه التّجربة مُذهلة؟

51
00:04:14,020 --> 00:04:17,010
،لكن لأسباب لا أفهمها

52
00:04:17,010 --> 00:04:20,320
أكثر ما أتذكّره هو الرّجل في مُنتصف
يلحق بنا على درّاجة هوائيّة

53
00:04:21,110 --> 00:04:24,070
من الوحش الحقيقيّ، شعب البحر أم هو؟

54
00:04:24,660 --> 00:04:27,260
نمتُ بينما أفكّر بذلك واستيقظتُ
في الصّباح التّالي

55
00:04:37,070 --> 00:04:39,370
إنّه ابن موري-سان

56
00:04:39,370 --> 00:04:42,170
من جديد؟ كان هكذا لبضع سنوات

57
00:04:42,170 --> 00:04:44,980
لا بُدّ أنّ والديه يتألّمان

58
00:04:44,980 --> 00:04:49,390
الوالدان مُعقّدان... بعض الشّيء أيضاً

59
00:04:53,940 --> 00:04:56,630
أبي. كيف حال موري-كن؟

60
00:04:56,630 --> 00:04:58,900
قيل لي بأنّه يبلي حسناً

61
00:04:58,900 --> 00:05:00,680
جيّد

62
00:05:00,680 --> 00:05:03,440
كان ذلك بعد مُغادرتك إلى طوكيو

63
00:05:03,440 --> 00:05:05,900
بدأ يرتعد بسهولة

64
00:05:05,900 --> 00:05:07,990
إنّه هادئ الآن

65
00:05:07,990 --> 00:05:09,740
...هكذا إذاً

66
00:05:13,540 --> 00:05:15,610
سأخرج لبعض الوقت

67
00:05:16,340 --> 00:05:18,910
لكن ربّما سأزعجه إذا ذهبتُ الآن

68
00:05:19,380 --> 00:05:20,980
لا، سأذهب

69
00:05:24,630 --> 00:05:27,150
المعذرة

70
00:05:27,500 --> 00:05:29,620
هل يمكنك النُّهوض؟ أمسكي بيدي

71
00:05:29,620 --> 00:05:32,410
سيّدي؟ مرحباً بك

72
00:05:32,410 --> 00:05:33,180
تفضّل بالدّخول

73
00:05:33,180 --> 00:05:35,430
لا. هنا يكفي

74
00:05:35,690 --> 00:05:39,590
سمعتُ بأنّه جاءك ضيوف يا كيريهارا-سان

75
00:05:39,590 --> 00:05:42,110
أتيتُ لإلقاء التّحيّة وأعتذر

76
00:05:44,860 --> 00:05:49,490
أنا آسف حقّاً على الإزعاج الّذي
يُسبّبه أحد سكّان الجزيرة

77
00:05:49,490 --> 00:05:53,790
ابن عائلة موري غير مُستقرّ ذهنيّاً

78
00:05:53,790 --> 00:05:58,000
جميعنا قلقون عليه، لكن أرجو
ألّا تدعوا الأمر يؤرقكم

79
00:05:58,000 --> 00:06:00,450
أعتذر على حدوث هذا أثناء زيارتكم

80
00:06:00,450 --> 00:06:02,720
،نحن نُقدِّر صغار الجزيرة

81
00:06:02,720 --> 00:06:06,380
لذا نقلق وننهمك بشأنه أكثر من اللّازم

82
00:06:06,380 --> 00:06:08,090
لم أعرّف عن نفسي بعد

83
00:06:08,090 --> 00:06:10,590
اسمي ساميجيما كويتارو

84
00:06:10,590 --> 00:06:12,470
...هكذا إذاً

85
00:06:12,700 --> 00:06:14,860
هذه حفيدتي يوي

86
00:06:14,860 --> 00:06:17,020
تسرّني رؤيتك ثانية يا كيريهارا-تشان

87
00:06:17,020 --> 00:06:18,610
يوي-تشان

88
00:06:18,610 --> 00:06:20,900
لم أركِ منذ التخرُّج من الثّانويّة

89
00:06:20,900 --> 00:06:26,440
أيضاً سمعتُ أنّ أستاذ كلّية
قادم للزّيارة

90
00:06:26,440 --> 00:06:27,710
صحيح

91
00:06:29,210 --> 00:06:33,830
سمعتُ بأنّك تدرس الفلكلور
وأنّك مُهتمّ بجزيرتنا

92
00:06:33,830 --> 00:06:35,690
شكراً لك

93
00:06:35,690 --> 00:06:37,000
العفو

94
00:06:37,000 --> 00:06:41,950
ساعدتنا عائلة كيريهارا منذ
ما قبل جيل أمّي

95
00:06:41,950 --> 00:06:45,710
ضيوفهم هم ضيوفنا

96
00:06:45,710 --> 00:06:48,010
إنّه الفتى ساميجيما

97
00:06:48,010 --> 00:06:51,380
أرغب في أخذكم في جولة
تعريفيّة حول الجزيرة

98
00:06:51,380 --> 00:06:52,680
ما رأيك؟

99
00:06:52,680 --> 00:06:55,860
سألتقي بك بعد أن أزور موري-كن

100
00:06:55,860 --> 00:06:57,560
من الأفضل ألّا تفعلي

101
00:06:57,560 --> 00:06:59,590
وإلّا أزعجتِهم

102
00:06:59,590 --> 00:07:01,900
لنتجوّل في أرجاء الجزيرة يا كيريهارا-تشان

103
00:07:06,110 --> 00:07:07,820
مرحباً يا سيّدي

104
00:07:07,820 --> 00:07:09,530
طاب يومك

105
00:07:09,810 --> 00:07:12,530
كما قالت ياي-تشان، يبدو مُهمّاً

106
00:07:12,750 --> 00:07:14,580
لديه أسلوب خاصّ بالكلام

107
00:07:14,580 --> 00:07:16,200
انظروا من يتكلّم؟

108
00:07:16,200 --> 00:07:18,500
هل أنت صديق كيريهارا-تشان؟

109
00:07:18,780 --> 00:07:21,120
رأيتُك تُصيب ذلك الهدف

110
00:07:25,660 --> 00:07:26,780
صحيح

111
00:07:26,780 --> 00:07:28,390
أدهشني ذلك

112
00:07:28,390 --> 00:07:31,680
لكن تبدو أكبر سنّاً بالنّسبة لصديق كلّية

113
00:07:31,680 --> 00:07:34,930
هل بدأت ترتاد الكلّية بعد
العمل لبعض الوقت؟

114
00:07:34,930 --> 00:07:36,950
...أنا، في الواقع

115
00:07:36,950 --> 00:07:39,100
إنّه خرّيج

116
00:07:40,810 --> 00:07:43,350
على أيّ حال، من المُذهل
أن يكون أستاذ كلّية

117
00:07:43,350 --> 00:07:46,170
هل هناك الكثير أمثاله في المدينة؟

118
00:07:46,170 --> 00:07:47,300
إنّه وسيمٌ جدّاً

119
00:07:47,300 --> 00:07:49,230
ليس إلى هذه الدّرجة

120
00:07:53,210 --> 00:07:55,490
هذا هو مزار شعب البحر

121
00:07:55,740 --> 00:07:58,370
اسمه الرّسميّ هو مزار ساميجيما

122
00:07:58,370 --> 00:08:00,580
بُني بواسطة أسلافي

123
00:08:01,250 --> 00:08:03,920
إنّه بسيط. لكن إليكم هذه النّشرة

124
00:08:08,510 --> 00:08:09,760
هكذا إذاً

125
00:08:09,760 --> 00:08:12,760
إذاً هناك معنى خلف تلك الإشارة في المهرجان

126
00:08:12,980 --> 00:08:15,010
لكن فقدت كامل المعنى

127
00:08:15,010 --> 00:08:18,820
لا بُدّ أنّها تبدو سخيفة، لكنّها مُهمّة

128
00:08:18,820 --> 00:08:21,090
إنّها طريقة أيضاً لتعلُّم النّاس عن البحر

129
00:08:29,980 --> 00:08:31,010
إنّه الرّئيس

130
00:08:31,010 --> 00:08:31,960
أجل

131
00:08:31,960 --> 00:08:33,470
يبدو هذا شهيّاً

132
00:08:33,950 --> 00:08:35,990
إنّه أحد أطباقنا الخاصّة

133
00:08:35,990 --> 00:08:38,520
إنّه مُكوّن من سمك القُدّ والقرش

134
00:08:38,520 --> 00:08:39,530
!أنياب؟

135
00:08:40,060 --> 00:08:43,290
لا أنيب. معظمها أسماك قرش زرقاء

136
00:08:43,290 --> 00:08:47,130
أنياب هو عنوان فيلم، أليس كذلك؟

137
00:08:47,130 --> 00:08:51,430
لكن في هذه الأرجاء، الحيتان العملاقة
وقروش النّمر تظهر بين الحين والآخر

138
00:08:51,430 --> 00:08:54,050
حتّى أنّ هناك سجلّات عن رؤيتها
في فترة إيدو

139
00:08:54,050 --> 00:08:59,350
لذا هناك معنى خلف غرس الخوف
من البحر من خلال المهرجان

140
00:08:59,350 --> 00:09:00,970
مذاق الأنياب لذيذ

141
00:09:00,970 --> 00:09:02,470
ليست أنياباً

142
00:09:02,930 --> 00:09:05,540
هل سيكون هذا مُفيداً لتقريرك؟

143
00:09:05,540 --> 00:09:07,310
ماذا؟ أ-أجل

144
00:09:07,310 --> 00:09:09,850
تعلم بشأن ذلك؟ هذا مُحرج بعض الشّيء

145
00:09:09,850 --> 00:09:10,970
آسف

146
00:09:11,690 --> 00:09:12,750
لا، آنا من ينبغي أن يعتذر

147
00:09:12,750 --> 00:09:16,490
إنّها جزيرة صغيرة. تنتشر الأنباء بسرعة

148
00:09:18,860 --> 00:09:20,900
إنّهم ضيوف الرّئيس

149
00:09:20,900 --> 00:09:22,890
إنّه أستاذ كلّية من طوكيو

150
00:09:22,890 --> 00:09:24,000
أجل

151
00:09:24,220 --> 00:09:26,220
هذه ابنة كيريهارا-سان

152
00:09:26,220 --> 00:09:28,030
إنّها صديقة لابن عائلة موري

153
00:09:28,030 --> 00:09:30,670
لكن كانت عائلة كيريهارا هنا
منذ زمن بعيد

154
00:09:30,670 --> 00:09:34,100
ما زالت عائلة موري غير جاهزة للمهرجان

155
00:09:34,100 --> 00:09:35,050
مهلاً، مهلاً

156
00:09:35,050 --> 00:09:37,130
لا تتوقّعي الكمال بعد

157
00:09:39,510 --> 00:09:43,640
إذاً عائلة موري جديدة في الجزيرة؟

158
00:09:44,770 --> 00:09:47,690
لا شيء. آسف

159
00:09:48,000 --> 00:09:49,400
عرفت؟

160
00:09:50,420 --> 00:09:51,910
على ما أعتقد

161
00:09:51,910 --> 00:09:55,110
لا يسع المرء سوى أن يسمع إشاعات
أثناء التنقُّل في أرجاء الجزيرة

162
00:09:57,180 --> 00:09:59,910
طريقة التّعامل مع النّاس ثابتة وراسخة

163
00:09:59,910 --> 00:10:03,350
ظننتُها تعتمد على المدّة
الّتي يُقيم فيها الشّخص

164
00:10:03,350 --> 00:10:06,410
تعتمد على مدى فهمك للجزيرة

165
00:10:06,700 --> 00:10:09,100
عاشت عائلة موري هنا لستّ سنوات

166
00:10:09,100 --> 00:10:12,500
كان أسلافنا هنا بالفعل
مع نهاية الشّوغونيّة

167
00:10:12,720 --> 00:10:17,670
كان لدى عائلة موري بعض الخلافات
مع الشّركة بُعيد انتقالهم إلى هنا

168
00:10:18,140 --> 00:10:21,730
انضمّ أبي للشّركة من بعدي

169
00:10:21,730 --> 00:10:27,310
بعد حوالي عام من انضمامه، انتقد
خطأ بسيطاً للرّئيس

170
00:10:28,270 --> 00:10:31,770
مُربِك، صحيح؟ هذه هي ردّة الفعل الطّبيعيّة

171
00:10:31,770 --> 00:10:35,150
لكن أحياناً لا يكون النّقد صحيحاً

172
00:10:35,430 --> 00:10:41,920
في هذه الجزيرة، نتماشى بقيّتنا بهدوء
مع بعض من سلوكيّات تلك العائلة الخاطئة

173
00:10:41,920 --> 00:10:44,530
أيّ سلوكيّات؟ من الطّبيعيّ أن
تكون هناك سلوكيّات خاطئة

174
00:10:44,530 --> 00:10:48,930
كم عدد الشّركات الّتي يمكنها أن تدّعي
بأنّها خالية تماماً من العيوب؟

175
00:10:48,930 --> 00:10:53,380
غالباً من الأسرع العمل بهذه
الطّريقة ما دامت ليست جريمة

176
00:10:53,630 --> 00:10:59,510
بعد التحدُّث مع الرّئيس، غالباً ستفهمون
سبب ازدهار هذه الجزيرة

177
00:10:59,510 --> 00:11:04,100
خارج الجزيرة، يعتقدنا الكثير من النّاس
أغبياء ويحاولون النّصب علينا

178
00:11:04,100 --> 00:11:07,480
يحاولون بيعنا مُختلف أنواع التّرهات

179
00:11:07,480 --> 00:11:09,830
في الحقيقة، من الصّعب الحُكم

180
00:11:09,830 --> 00:11:16,070
إنّها عائلة الرّئيس مَن تتحمّل مسؤوليّة
دحض أولئك النّاس

181
00:11:16,070 --> 00:11:21,710
لذا يميل سُكّان الجزيرة لتحاشي أيّ شخص
يعصي العائلة ولو قليلاً

182
00:11:21,710 --> 00:11:25,450
.لكن لستُ متأكّداً بخصوص ذلك
أشعر بأنّه تصرُّف غريب

183
00:11:25,710 --> 00:11:29,190
عندما قالت يايكو بأنّها أرادت
الذّهاب إلى الكلّية، كنتُ مسروراً

184
00:11:29,190 --> 00:11:30,910
فالذّكاء سلاح

185
00:11:31,220 --> 00:11:33,470
،نيكوزوكو-سينسي والجميع

186
00:11:33,470 --> 00:11:36,090
من فضلكم ساعدوا يايكو على التعلُّم
بقدر استطاعتها

187
00:11:36,330 --> 00:11:38,550
يسرّني أنّكم أتيتم

188
00:11:38,800 --> 00:11:43,140
بصفتي سينباي بالنّسبة له، يجدر بي أن
أفعل المزيد لحماية موري-سان وعائلته

189
00:11:43,390 --> 00:11:46,790
يايكو، دعينا نتولّى الجزيرة

190
00:11:47,470 --> 00:11:49,860
يجدر بك أن تتعلّمي قدر ما تستطيعين

191
00:11:49,860 --> 00:11:52,090
المُدراء الماهرون دائماً ما يرتكبون أخطاء

192
00:11:52,090 --> 00:11:54,940
وجميعنا نرتكب أخطاء بسيطة

193
00:11:54,940 --> 00:11:59,820
صحيح، أصبح نيكوزوكو-سينسي
،أستاذاً عن عمر صغير

194
00:11:59,820 --> 00:12:04,630
لكنّه سيّئ في المهام الرّتيبة لدرجة أنّه
يُفجّر طبّاخة أرزّ من دون زوجته

195
00:12:04,630 --> 00:12:06,030
حقّاً؟

196
00:12:07,140 --> 00:12:08,450
سأسمح بذلك

197
00:12:09,010 --> 00:12:10,410
عُدت

198
00:12:10,720 --> 00:12:12,790
أخذتُ ضيوفنا في جولة حول الجزيرة

199
00:12:12,790 --> 00:12:16,380
شكراً لك. أبليتَ حسناً

200
00:12:16,380 --> 00:12:19,630
...أجل. عملتُ بجدّ، كما طلبتِ منّي تماماً

201
00:12:20,070 --> 00:12:21,660
يا ماما

202
00:12:22,550 --> 00:12:24,890
كيف حال ابن عائلة موري؟

203
00:12:24,890 --> 00:12:27,650
لا أريده أن يموت بسببي

204
00:12:27,650 --> 00:12:29,220
يا لك من فتى لطيف

205
00:12:29,470 --> 00:12:31,280
لا تقلق بشأن ذلك

206
00:12:31,280 --> 00:12:33,800
دع ماما تتولّى كلّ شيء وافعل
ما أُمليه عليك

207
00:12:33,800 --> 00:12:34,940
حينئذ لن يكون لديك ما تقلق بشأنه

208
00:12:35,170 --> 00:12:37,210
كيف كان الضّيوف؟

209
00:12:37,210 --> 00:12:39,900
لم يكن هناك أيّ شيء مُميّز فيهم

210
00:12:39,900 --> 00:12:42,740
لا شيء مُميّز إذاً؟

211
00:12:42,740 --> 00:12:44,650
يوي. أبليت حسناً كذلك

212
00:12:48,140 --> 00:12:51,060
والآن هذه خريطة قديمة. مُثير

213
00:12:51,060 --> 00:12:55,370
كان النّاس يعيشون في هذه
الجزيرة منذ عصر كيتشو

214
00:12:55,640 --> 00:12:59,000
منزلنا هنا، ومنزل الرّئيس
ساميجيما موجود هنا

215
00:12:59,000 --> 00:13:01,540
هل رأيتم قصراً كبيراً عندما وصلتُم؟

216
00:13:01,540 --> 00:13:03,090
أجل

217
00:13:03,090 --> 00:13:05,380
إنّه ضخم. لا بُدّ أنّهم مالكو الأرض الرّئيسيّون

218
00:13:05,380 --> 00:13:08,470
إذاً يتركّز كبار السّنّ في وسط الجزيرة

219
00:13:08,700 --> 00:13:09,540
أجل

220
00:13:09,540 --> 00:13:10,370
هكذا إذاً

221
00:13:10,370 --> 00:13:16,350
أجل. أعتقد بأنّ النّاس يستقرّون
في أكثر الأماكن أماناً أوّلاً

222
00:13:16,610 --> 00:13:18,940
كيو-تشان، إلى أين أنت ذاهب؟

223
00:13:18,940 --> 00:13:21,390
للتمشّي. أنا جائع

224
00:13:21,390 --> 00:13:24,650
ألم تتناول ما يكفي من فطور؟ آسفة

225
00:13:24,650 --> 00:13:27,700
لا، أنا فقط أكثر جوعاً من الجميع
بسبب نابيشيما

226
00:13:27,940 --> 00:13:29,070
نابيشيما؟

227
00:13:29,070 --> 00:13:30,990
لا تقلق بشأن الأمر

228
00:13:30,990 --> 00:13:32,370
هل نحضر لك شيئاً؟

229
00:13:32,370 --> 00:13:34,670
لا، سأشتري شيئاً في عربة طعام

230
00:13:34,670 --> 00:13:36,580
عربة طعام؟ سأذهب معك

231
00:13:37,890 --> 00:13:40,860
كيو-تشان، أنت في موعد مع فتاة

232
00:13:41,750 --> 00:13:44,800
إن قلتِ ذلك، فهذا سيُزعج كيو-تشان

233
00:13:45,040 --> 00:13:47,550
لا مُشكلة. جميعنا سنبدو أقلّ
شبهة إذا كنّا شخصين

234
00:13:47,550 --> 00:13:52,930
إذا ذهبنا بمفردنا، سيقول النّاس، "مُذهل، هذا
"الشّخص يأكل كثيراً من الطّعام من العربة

235
00:13:52,930 --> 00:13:54,560
أنتِ الوحيدة الّتي تفعل ذلك

236
00:13:54,560 --> 00:13:56,930
كيف حالكِ يا والدة الجدّ؟

237
00:13:56,930 --> 00:13:58,190
ممتازة

238
00:13:58,520 --> 00:14:05,490
الزيّ الشّيطانيّ الضّيّق الفائق ذو نسبة"
النّجاة 120% اسرقي رجُلَكِ" أفلح ثانية اليوم

239
00:14:05,490 --> 00:14:06,590
فتاة جيّدة

240
00:14:07,270 --> 00:14:10,660
يُعرَف أيضاً بـ"بدلة القتال الخاصّة
"بالأميرة البريئة

241
00:14:10,660 --> 00:14:12,960
قبل أيّام، ألم تُطلقي عليه

242
00:14:12,960 --> 00:14:17,780
الفتيات البريئات الحقيقيّات لا يرتدينَ بلوزة"
"ذات مقاس صغير ضيّقة للغاية كهذا الزّيّ؟

243
00:14:17,780 --> 00:14:21,500
اصمت. من فتح فمه للتو؟ فليتقدّم

244
00:14:21,500 --> 00:14:24,620
قلتُ بأنّه بدلة قتال الأميرة خاصّتي

245
00:14:24,620 --> 00:14:27,940
ولا تنسوا النّجمة الظّريفة بين
"أميرة" و "بدلة قتال

246
00:14:27,940 --> 00:14:29,980
توقَّع أن تُعاقَب لاحقاً

247
00:14:29,980 --> 00:14:31,890
أيضاً، أنا بريئة

248
00:14:31,890 --> 00:14:33,470
!شكراً لـ... أنا آسف

249
00:14:33,470 --> 00:14:37,370
خدع هذا الزيّ الرّجل الأربعينيّ الّذي
تقاعد من الشّركة قبل أيّام

250
00:14:37,370 --> 00:14:41,730
تركَ زوجته الّتي تزوّجها لـ 15 سنة
وطلب منّي الزّواج

251
00:14:41,730 --> 00:14:43,360
!مُحال أن أفعل

252
00:14:43,360 --> 00:14:48,570
بالطّبع، قلتُ والدّموع تذرف من عينَي بأنّني
سأرفض لأنّني شعرتُ بالشّفقة على زوجته

253
00:14:48,570 --> 00:14:51,110
حسّاسة جدّاً أيضاً

254
00:14:51,110 --> 00:14:53,530
كان عديم الجدوى في نهاية المطاف

255
00:14:53,530 --> 00:14:55,820
قُدِّر له أن يُطرَد من الجزيرة

256
00:14:57,540 --> 00:14:59,660
يا لك من ابنة حفيد موهوبة

257
00:14:59,660 --> 00:15:01,210
أنا مسرورة

258
00:15:01,470 --> 00:15:03,420
طلاق؟

259
00:15:03,420 --> 00:15:07,890
ماما. هل كان من المُناسب أن أتطلّق؟

260
00:15:07,890 --> 00:15:11,420
كانت مانامي امرأة جيّدة جدّاً

261
00:15:11,420 --> 00:15:12,590
لا مُشكلة

262
00:15:12,820 --> 00:15:17,130
لم تكن تستحقّك يا كويتارو-تشان

263
00:15:17,130 --> 00:15:19,680
لكن يسرّني أنّها أنجبتْ لك أطفالاً

264
00:15:19,920 --> 00:15:24,230
والآن لديك حفيدة صغيرة ظريفة

265
00:15:24,970 --> 00:15:28,070
لكن من الصّعب إيجاد زوجة جديدة

266
00:15:28,300 --> 00:15:32,340
ما زال عمرك 58. أنت في ريعان شبابك

267
00:15:32,340 --> 00:15:35,660
يجدر بك أن تتزوّج امرأة بدلاً
من عجوز شمطاء

268
00:15:35,890 --> 00:15:37,490
معكِ حقّ

269
00:15:37,750 --> 00:15:41,530
أريد زوجة تستطيع أن تطبخ مثل طبخكِ

270
00:15:41,530 --> 00:15:44,030
لا بُدّ من وجود امرأة تستطيع فعل ذلك

271
00:15:44,030 --> 00:15:45,410
يوجد بالتّأكيد

272
00:15:45,410 --> 00:15:47,490
لكن سيترتّب عليّ تعليمها

273
00:15:47,490 --> 00:15:50,320
ستكون محظوظة إذا علّمتِها يا ماما

274
00:15:50,320 --> 00:15:57,310
لا يريد أحدٌ أن يرتدي هذه البلوزة بلا أكمام
الضّيّقة أثناء هذا الموسم يا غبيّ

275
00:15:57,310 --> 00:15:59,140
إنّها تحفر إبطَي وتؤلمني

276
00:15:59,140 --> 00:16:01,140
أنا واثق بأنّهما حمراوان

277
00:16:01,780 --> 00:16:06,110
ماما، ابنة عائلة كيريهارا
صغيرة ويافعة

278
00:16:06,110 --> 00:16:07,730
أنا واثق بأنّها ستفعل ما يُملى عليها

279
00:16:07,960 --> 00:16:09,970
لا يا كويتارو-تشان

280
00:16:09,970 --> 00:16:12,950
،نساء أمثالها يبدينَ جميلات
لكنّهن عنيدات

281
00:16:13,330 --> 00:16:15,380
بالإضافة إلى أنّها ترتاد الكلّية

282
00:16:15,380 --> 00:16:18,820
لا أحد يدري كيف ستكون ردودها

283
00:16:18,820 --> 00:16:21,960
أنت بحاجة للزّواج من فتاة لطيفة

284
00:16:21,960 --> 00:16:26,760
ذلك الضّيف ذو العينين الحادّتين
هو أستاذ كلّية كيريهارا، صحيح؟

285
00:16:26,760 --> 00:16:29,210
كانت زوجته مُتشبّثة به وتعترض طريقي

286
00:16:29,570 --> 00:16:32,940
أنا واثقة بأنّني أستطيع الحصول
على الأطول قامة إذا ضغطتُ قليلاً

287
00:16:32,940 --> 00:16:36,570
إنّه نوعي المُفضّل، لكنّه بالكاد يردّ عليّ

288
00:16:36,570 --> 00:16:39,180
ما زلتِ ظريفة وساذجة

289
00:16:39,180 --> 00:16:42,780
كانت لديه عينَي رجل مُخضرم

290
00:16:42,780 --> 00:16:45,480
ينبغي أن تستهدفي الشّخص
الّذي لا يفقه شيئاً

291
00:16:45,480 --> 00:16:47,380
ذو النّظّارة سيكون أفضل

292
00:16:47,380 --> 00:16:49,690
ماذا؟ لكنّه قبيح جدّاً

293
00:16:49,970 --> 00:16:52,810
وستحترقين إذا استهنتِ بذلك الأستاذ

294
00:16:52,810 --> 00:16:53,900
كوني حذرة

295
00:16:55,700 --> 00:16:59,540
،تعاملتُ كثيراً مع الغرباء

296
00:16:59,540 --> 00:17:03,080
لكن أولئك الّذين يستهينون بنا ينتهي المطاف بهم
ضُعفاء، لذا لا داعي للقلق منهم

297
00:17:03,300 --> 00:17:07,580
الأشخاص الّذين تجتاحهم طاقتنا
هم المُخيفون

298
00:17:07,830 --> 00:17:12,970
يجب عليك دوماً أن تسبقي رجال الأعمال
الفطنون الّذين يحاولون سرقتنا بخطوة

299
00:17:12,970 --> 00:17:15,010
يوي، لديكِ الموهبة

300
00:17:15,010 --> 00:17:18,620
يجب عليكِ أن تتعلّمي قيادة
هذه الجزيرة يوماً ما

301
00:17:18,620 --> 00:17:19,870
أستطيع فعل ذلك

302
00:17:19,870 --> 00:17:22,100
كان إيقاع موري في الفخّ سهلاً

303
00:17:22,320 --> 00:17:28,690
هذا لأنّني درّبتُ بحرص سُكَّان
الجزيرة على الانخداع بسهولة

304
00:17:28,910 --> 00:17:32,390
ما زالت أسطورة شعب البحر لم تكتمل

305
00:17:32,390 --> 00:17:37,730
كان ينبغي لأسلافنا أن يجعلوا شعبَ البحر
أكثر شرّاً ويكسوا القصّة بثوب أخلاقيّ

306
00:17:37,730 --> 00:17:41,200
من السّهل زرع إحساس بالخير والشرّ في نفوس
النّاس عندما تكون القصّة سهلة الفهم

307
00:17:41,200 --> 00:17:42,870
حسناً، سأصلح الأمر في نهاية المطاف

308
00:17:42,870 --> 00:17:46,400
على أيّ حال، كونا باسمين أمام ضيوفنا

309
00:17:46,400 --> 00:17:49,530
فطرتي تُحدّثني بأنّنا ينبغي أن نحذر منهم

310
00:17:49,530 --> 00:17:53,000
كلّ ما نفعله هو لأجل حفظ سلام عائلتنا

311
00:17:53,260 --> 00:17:58,130
الأشخاص الّذين لديهم عقل والّذين يُعبِّرون
عن آرائهم هم أعداء السّلام

312
00:17:58,390 --> 00:18:03,770
،لهذا حاولتُ دفع عائلة موري لمُغادرة الجزيرة
لكنّهم لا يفعلون ذلك

313
00:18:03,770 --> 00:18:07,450
هذا لأنّ عائلة كيريهارا مهتمّة بهم بشكل غريب

314
00:18:07,450 --> 00:18:11,310
ينبغي أن يسيروا مع التّيّار كبقيّة
سُكّان الجزيرة

315
00:18:11,540 --> 00:18:13,510
إنّه الأب

316
00:18:13,510 --> 00:18:17,890
،إنّه شخص ضئيل يبدو مُستهتراً
لكنّه ذكيٌّ جدّاً

317
00:18:17,890 --> 00:18:18,860
هذا صحيح

318
00:18:19,100 --> 00:18:23,980
حاليّاً، صوّرنا ابن عائلة موري كشخص
،يحاول زيفاً الانتحار بشكل دائم

319
00:18:23,980 --> 00:18:27,350
لكن لا بُدّ أنّ والد عائلة كيريهارا
قد أدرك عدم صحّة ذلك

320
00:18:27,350 --> 00:18:30,670
في نهاية المطاف، ذلك الثّعلب العجوز
شجّع ابنته على الدّراسة

321
00:18:30,670 --> 00:18:32,420
حقيقة أنّهم عجائز مُتمرّسون تُشكّل عقبة

322
00:18:32,740 --> 00:18:34,670
حسناً، لدينا طُرُق مختلفة في جعبتنا

323
00:18:34,890 --> 00:18:38,990
سيُصدِّق سُكّان الجزيرة الآخرون
أيّ شيء نقوله

324
00:18:38,990 --> 00:18:40,730
يمكننا الكذب عليهم قدر ما نحتاج

325
00:18:51,550 --> 00:18:54,300
أعلم بأنّ كائن البحر ذاك
كان ضخماً جدّاً

326
00:18:54,300 --> 00:18:57,040
إنّه تراكُم لمُختلف أنواع الكراهية

327
00:18:57,040 --> 00:18:59,460
،لدى هذه الجزيرة مشاكلها

328
00:18:59,460 --> 00:19:03,780
لكن لا أعلم بشأن التّنمُّر على صديق
يايكو-سان بشدّة

329
00:19:04,070 --> 00:19:07,830
إذا مات في أيّ وقت قريب، فسوف
يصبح جزءاً من شعب البحر

330
00:19:07,830 --> 00:19:14,230
،لا أريد أن أتدخّل، لكن إذا أخبرتُ موغورا
فسوف أتورّط في الأمر

331
00:19:14,230 --> 00:19:16,340
لن نزور عربات الطّعام؟

332
00:19:18,090 --> 00:19:22,510
بالمناسبة يا ساتو-سان، ما حدث
بعد ذلك كان أصعب حتّى

333
00:19:22,730 --> 00:19:23,900
حـ-حقّاً؟

334
00:19:23,900 --> 00:19:25,590
عدنا

335
00:19:25,590 --> 00:19:27,720
كيو-تشان، شيو-تشان. أهلاً بعودتكما

336
00:19:27,980 --> 00:19:30,560
اشترى ياكيسوبا لي

337
00:19:30,790 --> 00:19:32,440
محظوظة

338
00:19:32,710 --> 00:19:34,300
اشترِ لي شيئاً أيضاً

339
00:19:34,300 --> 00:19:37,570
أنفقتُ كلّ مال جيبي على الرّماية

340
00:19:37,910 --> 00:19:40,490
ماذا عرفت؟ أخبرني

341
00:19:43,410 --> 00:19:44,870
...بعبارة أُخرى

342
00:19:49,210 --> 00:19:53,570
العائلة الملكيّة في الجزيرة يفعلون
المستحيل للبقاء في السّلطة

343
00:19:53,570 --> 00:19:57,500
يجعلون سُكّان الجزيرة يعتمدون
عليهم ويُجرّدونهم من حكمهم

344
00:19:57,750 --> 00:20:01,630
تلك العائلة محترفة في التّلاعب بذكاء
بعقول النّاس والتحكُّم بهم

345
00:20:01,630 --> 00:20:05,890
علاوة على أنّ الطّقوس الخارقة الّتي
،تُحفّز على إحساس الوحدة والتّكاتُف

346
00:20:05,890 --> 00:20:10,710
لزرع إحساس أعظم بالوحدة حتّى
"بقصّة "نحن ضدّ الآخرين

347
00:20:10,710 --> 00:20:12,060
ذكيّة جدّاً

348
00:20:12,380 --> 00:20:17,520
أولئك الّذين يعتبرونهم عديمي الفائدة أو وقحين
يُحشَرون في الزّاوية ويتمّ التخلُّص منهم

349
00:20:17,780 --> 00:20:19,980
لا يأبهون إذا ماتوا

350
00:20:20,270 --> 00:20:23,550
،والأسوأ بينهم جميعاً هي السّيّدة الزّعيمة
،ودُمية عقدة أوديب خاصّتها

351
00:20:23,550 --> 00:20:25,570
وحقل الألغام السّائرة قويّة الإرادة تلك

352
00:20:25,790 --> 00:20:28,080
جزيرتي أكثر ريبة حتّى ممّا توقّعت

353
00:20:28,080 --> 00:20:32,910
الزّاوية الّتي أمعنت الفتاةُ النّظر منها
حفّزت كشّاف حقل الألغام الخاص بي

354
00:20:32,910 --> 00:20:35,170
هل أنت صديق كيريهارا-تشان؟

355
00:20:35,440 --> 00:20:37,300
يبدو أنّني كنتُ مُحقّاً

356
00:20:37,300 --> 00:20:40,060
أنت فخّ حقل ألغام نادر

357
00:20:40,060 --> 00:20:44,050
على ذكر الأمر، قلت بأنّك تُواجه صعوبة
مع المجانين نفسيّاً شديدي التعلُّق

358
00:20:44,050 --> 00:20:48,300
لطالما ارتأيتُ أنّ هناك مُشكلة
مع يوي-تشان

359
00:20:48,540 --> 00:20:52,400
على أيّ حال، ببسيط العبارة، إنّهم
مجموعة من المجانين

360
00:20:52,400 --> 00:20:55,230
ماذا يعتقدون الآخرين بالضّبط؟

361
00:20:55,710 --> 00:20:57,730
موري-كن هو أحد ضحاياهم

362
00:20:59,820 --> 00:21:03,860
أنا واثق بأنّ هذه الجزيرة لديها
عدد لا يُحصى من الضّحايا

363
00:21:03,860 --> 00:21:07,780
جعلوا شعب البحر أكبر حجماً

364
00:21:08,040 --> 00:21:11,010
عرفتُ بأنّه كان هناك عدداً قليلاً
جدّاً في الجزيرة

365
00:21:11,010 --> 00:21:14,830
عندما وصلنا إلى الميناء، حدّقوا بنا حتّى

366
00:21:15,080 --> 00:21:18,170
معظمهم يتمّ ابتلاعهم غالباً
بواسطة شعب البحر

367
00:21:18,170 --> 00:21:19,090
،بصيغة أُخرى

368
00:21:19,090 --> 00:21:22,210
هذا المكان دائماً ما يجذب الأرواح

369
00:21:22,490 --> 00:21:25,930
الأرواح الّتي ينتهي المطاف بها
هناك تُشكّل كتلة واحدة

370
00:21:26,240 --> 00:21:29,760
إنّه نوع شائع جدّاً من الأشباح
في قصص الأشباح

371
00:21:29,990 --> 00:21:34,140
لديه نزعة جذب الأرواح ذات
المشاعر السّلبيّة الشّديدة

372
00:21:34,530 --> 00:21:38,850
إنّه كُرة من الحسرة، لذا هو بحاجة لرفيق

373
00:21:39,230 --> 00:21:44,510
يمتصّ كلّ روح يراها ويبدأ في نهاية
المطاف باستدراج الأحياء

374
00:21:45,030 --> 00:21:47,660
أولئك الّذين في حالة مُستضعفة هم
أكثر المُعرّضين لذلك

375
00:21:48,750 --> 00:21:53,100
يخلق هذا مواقعَ مسكونة حيث
تتكرّر فيها الحوادث

376
00:21:53,100 --> 00:21:55,790
أو أماكنَ تجلب الموت

377
00:21:56,140 --> 00:22:00,040
...والجزء الأهمّ من كلّ هذا هو

378
00:22:00,310 --> 00:22:04,960
ماذا فعلت العائلة الملكيّة لموري-كن
حتّى حاصرَتْه؟