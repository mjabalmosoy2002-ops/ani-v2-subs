1
00:00:20,990 --> 00:00:22,370
.أيّتها الأميرة روزيتّا

2
00:00:22,750 --> 00:00:26,660
.التّنّين الشّرّير العظيم بحاجتك

3
00:00:28,910 --> 00:00:32,970
هل يمكنني أن أكون ذات فائدة للتّنّين الشّرّير؟

4
00:00:34,380 --> 00:00:37,050
.عرفتُ أنّك مجرّد مزيّف

5
00:00:37,260 --> 00:00:41,060
.لقد أهنتِ سيّدي التّنّين الشّرّير
!لن أسامحك أبدًا

6
00:00:47,140 --> 00:00:50,100
.أيّتها الأميرة روزيتّا، تجاهليهم

7
00:00:50,700 --> 00:00:54,390
.سيلقى المزيّفون هلاكهم عمّا قريب

8
00:00:55,720 --> 00:00:58,910
.هذا صحيح. أنا أتحدّث عنك

9
00:01:08,910 --> 00:01:12,280
.لقد صدّ قدرة ريكو بكلّ سهولة

10
00:01:12,420 --> 00:01:14,690
هل هو موجود بالفعل؟

11
00:01:14,820 --> 00:01:18,090
هل التّنّين الشّرّير موجود؟

12
00:01:27,980 --> 00:01:31,190
تنّين عاشب عمره 5000 سنة يُعامَل"
"كشرّير بشكل غير عادل

13
00:02:48,610 --> 00:02:51,850
.عرفتُ أنّ هذا سيحدث في نهاية المطاف

14
00:02:52,450 --> 00:02:57,100
.لا يمكن الجزم ما قد يفعله ذلك التّابع المزيّف

15
00:02:57,400 --> 00:02:58,780
.أقول هذا لصالح الجميع

16
00:02:59,250 --> 00:03:03,320
.سيتمّ حلّ منظّمة الدّم الأسود ابتداءً من اليوم

17
00:03:04,370 --> 00:03:07,200
أيّها التّنّين الشّرّير، أهذه غلطتنا؟

18
00:03:07,350 --> 00:03:09,880
!لا داعي للقلق حيال التّابع المزيّف

19
00:03:10,020 --> 00:03:13,000
!لا يصدّق أيّ أحد هراءه

20
00:03:15,390 --> 00:03:19,800
.إنّ ثقتكم العمياء فيّ هي مشكلة أخرى

21
00:03:20,020 --> 00:03:24,070
.لا داعي للقلق. إنّنا لا نشكّ في ولائكم

22
00:03:24,220 --> 00:03:26,120
.امتثلوا للأوامر في الوقت الحاليّ

23
00:03:26,270 --> 00:03:29,680
.رغم أنّ ذلك يؤلمني بصفتي زميلتكم الأقدم

24
00:03:30,080 --> 00:03:32,190
...سيّدتي ريكو

25
00:03:33,060 --> 00:03:34,300
.ريكو

26
00:03:36,120 --> 00:03:39,360
.ربّما حان الوقت لإنهاء هذا

27
00:03:39,560 --> 00:03:42,010
.عليك العودة إلى القرية

28
00:03:42,170 --> 00:03:44,680
.هذه هي نهاية رحلتنا

29
00:03:44,820 --> 00:03:47,950
لكن يا سيّدي التّنّين الشّرّير، علينا
—القيام بشيء ما حيال التّابع المزيّف

30
00:03:48,100 --> 00:03:51,910
.هذا أمر. افعلي ما أقوله

31
00:03:57,580 --> 00:04:01,060
،حتّى إن استطعتُ إصلاح هذا الوضع
.فستظهر الحقيقة يومًا ما

32
00:04:02,340 --> 00:04:06,520
.كنتُ أعلم أنّ هذا سيحصل من البداية

33
00:04:14,020 --> 00:04:15,470
.هكذا الأمر إذًا

34
00:04:16,020 --> 00:04:18,770
!إنّك تخطّط لهجوم شامل ضدّ ملك الشّياطين

35
00:04:20,140 --> 00:04:22,400
إنّك جاهز للتّضحية بحياتك

36
00:04:22,560 --> 00:04:25,320
!لهزيمة ملك الشّياطين

37
00:04:25,460 --> 00:04:29,540
!عليك أن تستعدّ جيّدًا مع أنّ نصرك أكيد

38
00:04:29,670 --> 00:04:32,240
،مع أنّه هنالك مزيّفون

39
00:04:32,380 --> 00:04:37,080
!سيثبت هذا من هو التّنّين الشّرّير الحقيقيّ

40
00:04:37,240 --> 00:04:40,770
!سأقدّم المساعدة بكلّ سرور

41
00:04:41,450 --> 00:04:43,730
!تحت أمرك أيّها التّنّين الشّرّير

42
00:04:47,180 --> 00:04:49,370
.سبق ورأيتُ شيئًا مماثلاً لهذا

43
00:04:49,520 --> 00:04:52,130
.ما سيحدث، سيحدث

44
00:04:53,280 --> 00:04:56,770
.ما دام لا أحد سيتأذّى

45
00:04:57,500 --> 00:05:00,610
،ابتداءً من اليوم
سيتمّ حلّ منظّمة الدّم الأسود

46
00:05:02,570 --> 00:05:05,210
!وستتشكّل منظّمة الدّم الأسود الجديدة

47
00:05:05,340 --> 00:05:07,290
سنخدم التّنّين الشّرّير بكلّ ما بوسعنا

48
00:05:07,410 --> 00:05:09,410
!ونستعدّ لقتال ملك الشّياطين

49
00:05:10,240 --> 00:05:12,720
.ستكون قائدتنا الجديدة هي السّيّدة ريكو

50
00:05:12,850 --> 00:05:14,710
هل من اعتراض؟ –
!على الإطلاق –

51
00:05:14,840 --> 00:05:17,620
!أخبرتكم أن تحلّوا المنظّمة –
!سيّدي التّنّين الشّرّير –

52
00:05:18,240 --> 00:05:22,340
.سنبذل جهدنا كي لا نعرقل تقدّمك

53
00:05:24,980 --> 00:05:26,800
!علينا هذا مغادرة المكان

54
00:05:26,950 --> 00:05:29,000
،إن بقينا تحت الأرض

55
00:05:29,130 --> 00:05:31,430
...فإنّنا بكلّ تأكيد سوف

56
00:05:35,050 --> 00:05:37,060
...هذا نعيم

57
00:05:37,580 --> 00:05:41,410
لماذا لا يأكل التّنّين الشّرّير اللّحم؟

58
00:05:41,560 --> 00:05:43,110
أنت لا تفهم، صحيح؟

59
00:05:43,690 --> 00:05:47,300
إنّ لحم الكائنات الضّعيفة
.يفسد قوّة التّنّين الشّرّير السّحريّة

60
00:05:47,450 --> 00:05:51,330
.وأكل نظام عاشب هو الأفضل لزيادة القوّة

61
00:05:51,470 --> 00:05:54,580
!مفهوم. إنّ التّنّين الشّرّير شديد العزيمة بالفعل

62
00:05:56,360 --> 00:05:59,560
.لا داعي من القلق حيال الغد

63
00:05:59,690 --> 00:06:03,400
من الأفضل الاستمتاع بالحاضر
.لتجنّب النّدم على أيّ شيء

64
00:06:05,940 --> 00:06:07,740
،قبل مدّة طويل

65
00:06:08,140 --> 00:06:10,780
قصد بطلٌ الجبال وحيدًا

66
00:06:11,050 --> 00:06:15,240
.وتحدّى التّنّين الشّرّير المرعب رافنديا

67
00:06:15,940 --> 00:06:19,620
.استمرّت المعركة ضدّ رافنديا لأيّام عديدة

68
00:06:19,910 --> 00:06:24,160
،وبعد معركة يائسة

69
00:06:24,300 --> 00:06:27,130
.نجح البطل في إلحاق جرح واحد

70
00:06:27,970 --> 00:06:31,490
،انتهت المعركة بانتصار التّنّين الشّرّير

71
00:06:31,630 --> 00:06:34,920
لكنّ البطل كان قد أظهر
.مدى عزيمة الجنس البشريّ

72
00:06:35,540 --> 00:06:38,260
وبعد ذلك، رفض التّنّين الشّرّير مغادرة الجبل

73
00:06:38,400 --> 00:06:41,460
.وبدأ يراقب حياة النّاس هناك بدل ذلك

74
00:06:41,690 --> 00:06:43,870
،أمّا البطل وذرّيّته

75
00:06:44,010 --> 00:06:48,080
فقد تمّ احترامهم كرهبان للتّنّين الشّرّير

76
00:06:48,220 --> 00:06:50,700
.وأشرفوا على طقوس لتقديم قرابين حيّة

77
00:06:52,520 --> 00:06:53,790
!أكاذيب

78
00:06:53,910 --> 00:06:56,760
!لا يستطيع أيّ بشريّ قتال التّنّين الشّرّير لأيّام

79
00:06:56,900 --> 00:07:00,710
،كُتب ذلك عن التّنّين الشّرّير

80
00:07:00,850 --> 00:07:02,730
.لكنّه يبدو مثيرًا للشّبهات بالفعل

81
00:07:02,890 --> 00:07:06,650
.تلك قصّة التّنّين الشّرّير الحقيقيّ

82
00:07:06,790 --> 00:07:08,530
.عرفتُ أنّي سأجدكم هنا

83
00:07:09,340 --> 00:07:11,110
هل تمّ حلّ منظّمتكم بعد؟

84
00:07:11,510 --> 00:07:13,920
أيّها المغفّل الوقح! أظهر بعض الاحترام
!عندما تتحدّث مع التّنّين الشّرّير

85
00:07:14,050 --> 00:07:17,920
.على مهلك. هذا الرّجل ضيفي

86
00:07:18,100 --> 00:07:20,540
.يمكنك التّراجع. هيّا –
.أنا آسف –

87
00:07:22,120 --> 00:07:23,930
.الوضع معقّد

88
00:07:24,060 --> 00:07:27,460
لكنّهم لا يسبّبون أيّ مشاكل بعد الآن، صحيح؟

89
00:07:27,620 --> 00:07:31,240
.صحيح، باستثناء سرقة كلّ هذه الثّمار

90
00:07:32,800 --> 00:07:36,650
أيّها الجنرال إدوارد، هل من سبب لقدومك؟

91
00:07:37,150 --> 00:07:39,770
هل رأيت الأميرة روزيتّا؟

92
00:07:40,640 --> 00:07:42,060
تلك الفتاة؟

93
00:07:42,190 --> 00:07:44,060
ألم تعد إلى القصر؟

94
00:07:46,020 --> 00:07:49,030
.لم تعد منذ اختفائها

95
00:07:49,730 --> 00:07:53,110
،لا يحقّ لي التّحدّث في هذه المسألة

96
00:07:53,240 --> 00:07:54,740
لكنّ الأميرة روزيتّا

97
00:07:55,220 --> 00:07:58,040
.ليست جديرة بارتداء التّاج

98
00:07:59,100 --> 00:08:02,700
.سيّدتي فانيسّا أنسب بكثير لتكون الملك

99
00:08:04,400 --> 00:08:08,710
.هذا ممتاز! إنّ النّاس يحبّونها أيضًا

100
00:08:08,980 --> 00:08:13,180
.لكنّ التّاج في حوزة الأميرة روزيتّا الآن

101
00:08:14,270 --> 00:08:17,010
إنّها مسألة وقت فحسب

102
00:08:17,540 --> 00:08:19,160
.قبل أن يلاحظ النّاس ذلك أيضًا

103
00:08:20,300 --> 00:08:23,890
في الوقت الحاليّ، سنُبقيها
.في الدّاخل حتّى لا يراها أيّ أحد

104
00:08:24,510 --> 00:08:27,530
.لكن لا يمكننا مواصلة ذلك للأبد

105
00:08:31,000 --> 00:08:34,670
استعمل قوّتك رجاءً لإيجاد
الأميرة روزيتّا أيّها التّنّين الشّرّير

106
00:08:34,940 --> 00:08:37,120
.واستعادة التّاج منها

107
00:08:38,360 --> 00:08:40,140
.عليك المغادرة

108
00:08:40,570 --> 00:08:44,120
.لا يمكنني مساعدتك للأسف

109
00:08:45,400 --> 00:08:49,140
لا يمكنني أن أجعل التّنّين الشّرّير
.الحقيقيّ عدوًّا لي

110
00:08:49,290 --> 00:08:51,090
،لن يضعني ذلك وحدي في خطر

111
00:08:51,320 --> 00:08:54,090
.بل وريكو أيضًا

112
00:08:54,230 --> 00:08:55,310
!أرجوك يا سيّدي التّنّين الشّرّير

113
00:08:55,450 --> 00:08:57,340
ألم تسمع ما قاله؟

114
00:08:58,610 --> 00:09:01,060
.أخبرك سيّدي التّنّين الشّرّير أن تغادر

115
00:09:05,780 --> 00:09:08,070
.لا تكنَّ لي أيّ ضغية رجاءً

116
00:09:08,310 --> 00:09:11,420
.ليس بوسعي فعل أيّ شيء

117
00:09:25,710 --> 00:09:29,550
اكتفيت! لماذا عليّ القيام بكلّ هذا
مع أنّي لم أعد الملك بعد الآن؟

118
00:09:29,680 --> 00:09:30,960
.رجاءً

119
00:09:31,830 --> 00:09:35,740
.تحتاج استمارات الزّراعة هذه لموافقتك

120
00:09:35,860 --> 00:09:37,160
.لذلك أتمنّى مراجعتها في أقرب وقت ممكن

121
00:09:37,300 --> 00:09:39,260
.لقد تأخّروا هذه السّنة

122
00:09:39,400 --> 00:09:41,890
.سأعمل عليها وأنهيها اللّيلة

123
00:09:42,800 --> 00:09:44,570
دمّرها الجراد؟

124
00:09:45,170 --> 00:09:49,440
لدينا مخازن طعام، لكن ما يقلقني
.هو أنّها لن تكون كافية

125
00:09:49,830 --> 00:09:53,380
إدوارد، أنشئ ممرًّا جديدًا

126
00:09:53,530 --> 00:09:56,200
.واسترد حبوبًا من المملكات المجاورة

127
00:09:56,830 --> 00:10:00,240
سنستعمل ميزانيّة إصلاح
.القصر لتمويل ذلك

128
00:10:00,920 --> 00:10:03,480
.سأهتمّ بالباقي. يمكنك الانصراف

129
00:10:03,850 --> 00:10:04,870
.حاضر

130
00:10:10,750 --> 00:10:12,760
!انتهيتُ أخيرًا

131
00:10:13,150 --> 00:10:15,840
.سيكون لدينا طعام بما يكفي الآن

132
00:10:18,480 --> 00:10:20,510
...يا أختي العزيزة

133
00:10:20,960 --> 00:10:22,430
أين أنت؟

134
00:10:27,100 --> 00:10:28,350
...ذلك الشّكل

135
00:10:30,020 --> 00:10:31,440
!إنّها روزيتّا

136
00:10:45,440 --> 00:10:46,290
!روزيتّا

137
00:10:50,210 --> 00:10:52,820
!انتظري يا معلّمتي

138
00:10:53,340 --> 00:10:57,060
متى ستعلّميني السّحر؟

139
00:10:57,200 --> 00:11:00,020
!عليك بناء قدرتك على التّحمّل أوّلاً
!هيّا، أسرع

140
00:11:00,160 --> 00:11:02,250
أيمكنني إثارة اهتمامكم بواحدة من هذه؟

141
00:11:03,900 --> 00:11:08,280
أتودّون دمية لساحر أسغا الأسطوريّ برافاس؟

142
00:11:08,420 --> 00:11:10,310
!إنّه السّاحر الأعظم على الإطلاق

143
00:11:10,950 --> 00:11:14,050
بالإمكان عرضه على رفوف
.منازلكم كتميمة واقية

144
00:11:14,170 --> 00:11:18,530
.وقد تكتسبون حتّى القدرة على استعمال السّحر

145
00:11:18,690 --> 00:11:20,520
!ماذا؟ ظهر عليها شقّ فجأة

146
00:11:20,660 --> 00:11:23,090
.لا تستطيع تلك الدّمية حمايتك

147
00:11:23,240 --> 00:11:24,900
!هيّا، لنذهب

148
00:11:26,870 --> 00:11:28,200
!توقّفي

149
00:11:33,370 --> 00:11:37,660
.إنّها أختي الكبيرة الضّعيفة

150
00:11:38,050 --> 00:11:40,050
أتدرين ما الّذي تفعلينه؟

151
00:11:41,020 --> 00:11:42,550
.أحفر قبرًا

152
00:11:42,960 --> 00:11:44,390
هل من مشكلة في ذلك؟