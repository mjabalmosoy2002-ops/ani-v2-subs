1
00:00:23,990 --> 00:00:27,210
تنّين عاشب عمره 5000 سنة يُعامَل"
"كشرّير بشكل غير عادل - الموسم 2

2
00:01:44,920 --> 00:01:49,650
.حتّى أنّي غيّرت مظهري لإخفاء هويّتي

3
00:01:49,650 --> 00:01:52,700
.لكنّكما وجدتماني في كلّ الأحوال

4
00:01:53,890 --> 00:01:58,570
.ليس من السّهل أن يكون الفرد إلهًا

5
00:01:58,570 --> 00:02:00,570
تحوّلتِ من وحش إلى إله؟

6
00:02:00,570 --> 00:02:03,630
لا تفقه شيئًا، صحيح؟

7
00:02:03,820 --> 00:02:05,620
.يا سيّد سحليّة

8
00:02:05,620 --> 00:02:10,650
...إن ناديتني سحليّة، فإنّ ريكو سوف

9
00:02:11,200 --> 00:02:13,850
ما الخطب يا ريكو؟

10
00:02:14,080 --> 00:02:17,930
.تتصرّفين بشكل مختلف عادة

11
00:02:18,330 --> 00:02:21,760
!ستدفعون ثمن إهانتكم لسيّدي التّنّين الشّرّير

12
00:02:21,760 --> 00:02:23,350
!إيّاك

13
00:02:23,350 --> 00:02:31,440
!ستدفعون ثمن إهانتكم لسيّدي التّنّين الشّرّير

14
00:02:26,770 --> 00:02:27,850
!إيّاك

15
00:02:31,440 --> 00:02:32,980
!إيّاك

16
00:02:32,980 --> 00:02:37,860
فكّرتُ في ترك هذه الإهانة
.تمرّ بما أنّك توقفني دائمًا

17
00:02:37,860 --> 00:02:39,510
...ولكن إن أردت

18
00:02:40,680 --> 00:02:41,780
—ستدفين ثمن

19
00:02:41,780 --> 00:02:44,010
!لا مهلاً! أسأتِ فهم الأمر

20
00:02:44,480 --> 00:02:49,210
واثقة أنّ الفضول يراودك
.عن كيف صرتُ إلهة يا سيّد سحليّة

21
00:02:49,780 --> 00:02:52,020
.ليس تمامًا

22
00:02:52,330 --> 00:02:55,220
.سأشرح ما الّذي حدث

23
00:02:55,940 --> 00:02:59,200
هل تعرفين ما هي القوّة السّحريّة بالفعل؟

24
00:02:59,710 --> 00:03:04,600
تولد كلّ القوّة السّحريّة في هذا
.العالم من مشاعر النّاس

25
00:03:04,600 --> 00:03:07,020
،بمجرّد تعلّم التّقنية

26
00:03:13,050 --> 00:03:19,400
،وبالتّالي، إن كنت تسعين للقوّة السّحريّة
.عليك تحريض مشاعر شعب أسغا

27
00:03:19,400 --> 00:03:23,070
،بمجرّد أن تصل مشاعرهم لكمّيّة معيّنة

28
00:03:23,070 --> 00:03:26,290
.بإمكانك حتّى تغيير خصائص قوّتك السّحريّة

29
00:03:26,610 --> 00:03:31,000
إنّ القوّةَ السّحريّةَ وليدةُ المشاعرِ
.الإيجابيّةِ هائلةٌ

30
00:03:31,000 --> 00:03:34,020
.بإمكانك تحويل الوحوش إلى آلهة

31
00:03:34,370 --> 00:03:36,210
.والعكس صحيح

32
00:03:36,210 --> 00:03:39,860
،بمجرّد أن أجمع ما يكفي من الخوف من النّاس

33
00:03:40,170 --> 00:03:42,600
...فحينها

34
00:03:48,290 --> 00:03:53,350
!إنّ التّبجيل المتواصل يزيد من قوّتي السّحريّة

35
00:03:53,350 --> 00:03:55,900
.هذه أوّل مرّة أسمع عن هذا

36
00:03:55,900 --> 00:04:00,030
بتعبير آخر، حاول برافاس إنشاء تنّين شرّير

37
00:04:00,030 --> 00:04:02,070
.عن طريق جمع خوف النّاس

38
00:04:02,070 --> 00:04:03,630
.ذلك ليس كلّ شيء

39
00:04:03,630 --> 00:04:07,280
.يتطلّب جمع القوّة السّحريّة جهدًا كبيرًا

40
00:04:07,280 --> 00:04:12,410
تُستعمل في العادة الحجارة السّحريّة
.لامتصاص القوّة السّحريّة

41
00:04:12,410 --> 00:04:15,850
!لكنّي لا أحتاج للقيام بذلك

42
00:04:17,240 --> 00:04:18,290
.فهمت الآن

43
00:04:18,290 --> 00:04:23,610
الحجر الّذي كان يحمله التّابع المزيّف
.كان أداة لامتصاص القوّة السّحريّة

44
00:04:24,040 --> 00:04:28,680
هل يعني ذلك أنّه كان يجمع
قوّة سحريّة أكثر؟

45
00:04:28,680 --> 00:04:33,650
هل يعمل مع برافاس؟
.عرفتُ أنّ هنالك خطبًا ما

46
00:04:33,930 --> 00:04:38,940
أحسنتُ عندما طلبتُ من أتباعي
.استعادة الحجارة السّحريّة

47
00:04:38,940 --> 00:04:39,980
!لا، مهلاً

48
00:04:39,980 --> 00:04:43,170
!إنّ جمعها في مكان واحد أكثر خطورة من ذلك

49
00:04:45,810 --> 00:04:48,910
.علينا جمع المزيد من الحجارة السّحريّة

50
00:04:48,910 --> 00:04:50,170
.مفهوم

51
00:04:59,060 --> 00:05:00,090
!ريكو

52
00:05:00,090 --> 00:05:02,820
!اطلبي من الأتباع حماية الحجارة

53
00:05:03,210 --> 00:05:05,950
.حاضر يا سيّدي التّنّين الشّرّير

54
00:05:09,880 --> 00:05:12,410
.لا بدّ أنّها تحبّ أولئك الزّنادقة

55
00:05:13,380 --> 00:05:16,640
.سيّدتي القدّيسة، شكرًا على مساعدتك

56
00:05:16,640 --> 00:05:18,200
.توقّعتُ هذا منك

57
00:05:18,720 --> 00:05:21,500
فعلاً؟

58
00:05:22,230 --> 00:05:23,990
.لم يكن بالأمر المهمّ

59
00:05:23,990 --> 00:05:28,240
أنا إلهة الماء والحصاد الجيّد في نهاية
.المطاف. يمكنك الاعتماد عليّ

60
00:05:28,240 --> 00:05:31,100
.ربّما يمكنني أن أطلب منك شيئًا آخر إذًا

61
00:05:31,900 --> 00:05:36,270
.قابلتُ رجلاً مقنّعًا يرتدي ملابس سوداء

62
00:05:36,870 --> 00:05:41,750
ادّعى أنّه تابع للتّنّين الشّرّير
.وصدّ هجوم ريكو بكلّ سهولة

63
00:05:41,750 --> 00:05:44,740
.قلّة فقط قد يكونون بتلك القوّة

64
00:05:45,420 --> 00:05:47,570
هل لديك أيّ فكرة عمّن يكون؟

65
00:05:49,040 --> 00:05:50,700
...ذلك الشّخص

66
00:05:51,170 --> 00:05:57,640
.صحيح. لا بدّ أنّه كان هو
...إنّه كما تعلم... نعم

67
00:05:57,640 --> 00:06:00,290
...إنّه... ذلك

68
00:06:00,720 --> 00:06:03,020
هل يُجيب هذا على سؤالك؟

69
00:06:03,020 --> 00:06:05,090
.أنت لا تعرفين

70
00:06:05,520 --> 00:06:09,320
.إنّه يجمع السّحر عن طريق إخافة النّاس

71
00:06:09,320 --> 00:06:12,830
.عليّ إخبار الملك. أنا أستأذن –
!انتظر –

72
00:06:12,830 --> 00:06:16,330
.أنا إلهة. سأساعدك، بإمكانك الاعتماد عليّ

73
00:06:16,330 --> 00:06:17,770
.لديّ فكرة ممتازة

74
00:06:18,160 --> 00:06:22,710
حاول أن تتذكّر من أين تولد
.القوّة السّحريّة

75
00:06:22,710 --> 00:06:25,300
!من خوف النّاس يا سيّد سحليّة

76
00:06:25,300 --> 00:06:28,800
.ذلك ليس ما أريد، لكنّها محقّة

77
00:06:28,800 --> 00:06:32,430
إن امتصصتَ القوّة السّحريّة
،الّتي وُلدت من الخوف

78
00:06:32,430 --> 00:06:36,660
ألن يحلّ ذلك كلّ شيء؟

79
00:06:37,590 --> 00:06:38,710
ماذا عليّ أن أفعل؟

80
00:06:43,810 --> 00:06:48,580
عليك القيام بشيء شرّير
.مثل التّنّين الشّرّير الحقيقيّ

81
00:06:49,060 --> 00:06:53,140
.ثمّ بإمكانك جمع القوّة السّحريّة بكفاءة

82
00:06:53,570 --> 00:06:57,390
...وأكثر الأعمال شرًّا في العالم

83
00:06:58,770 --> 00:06:59,980
...هي وبدون منازع

84
00:07:00,410 --> 00:07:03,930
!إضاعة الطّعام

85
00:07:05,410 --> 00:07:07,960
.أخطتُ في تعليق آمالي

86
00:07:07,960 --> 00:07:10,130
.يا سيّد سحليّة، يمكنك الاعتماد عليّ

87
00:07:10,130 --> 00:07:13,220
...إن دمّرت كلّ العشب في المدينة

88
00:07:13,220 --> 00:07:16,690
.لا، ربّما عليك أكله

89
00:07:17,300 --> 00:07:22,880
إنّه اقتراح غير منطقيّ، لكنّني
.أريد أن أجمع القوّة السّحريّة

90
00:07:23,430 --> 00:07:26,500
.لا أرى أيّ طريقة أخرى

91
00:07:29,510 --> 00:07:31,500
!زئير

92
00:07:37,930 --> 00:07:39,090
.يا صاحبة الجلالة

93
00:07:39,490 --> 00:07:41,250
.لا تدعي الأمر يزعجك رجاءً

94
00:07:41,250 --> 00:07:42,850
.أعلم ذلك

95
00:07:43,580 --> 00:07:48,400
.حاول التّنّين الشّرّير تسوية الأمور بسلام

96
00:07:50,040 --> 00:07:55,320
.بذل جهده لمنعي ومنع روزيتّا من القتال

97
00:07:56,170 --> 00:07:57,770
...يا صاحبة الجلالة –
،الأهمّ الآن –

98
00:07:58,010 --> 00:08:00,610
هل أحرزنا أيّ تقدّم في الحفاظ على الممرّ؟

99
00:08:01,470 --> 00:08:07,150
إنّ رسائلي ولائحة طلباتي
.للممالك المجاورة جاهزة

100
00:08:07,150 --> 00:08:10,420
.لا بدّ من إصلاح الطّريق في أقرب وقت ممكن

101
00:08:11,480 --> 00:08:15,180
.ولا تقلق حيالي وقم بواجباتك

102
00:08:17,030 --> 00:08:18,350
.حاضر يا صاحبة الجلالة

103
00:08:24,350 --> 00:08:28,260
.لم أستطع فهم كيف شعرت روزيتّا

104
00:08:28,770 --> 00:08:34,360
ليلتها، حفرت ذلك القبر
.بهدف إعادة إحياء السّيّد برافاس

105
00:08:35,380 --> 00:08:37,600
.لا، هذا غريب

106
00:08:37,960 --> 00:08:39,850
إنّ جثّة السّيّد برافاس

107
00:08:39,850 --> 00:08:41,780
.لم يُعثر عليها

108
00:08:42,330 --> 00:08:44,820
من يكون ذلك الرّجل؟

109
00:08:47,010 --> 00:08:49,420
.عليّ التّحرّي عن المقبرة ثانية

110
00:08:51,850 --> 00:08:55,570
،ربّما السّبب هو أنّي نظّمت أفكاري

111
00:08:55,570 --> 00:08:58,550
.لكنّ المنظر في الخارج يبدو جميلاً

112
00:09:04,610 --> 00:09:07,230
هل سار الأمر كما يجب؟

113
00:09:07,580 --> 00:09:09,840
.لا، على الإطلاق

114
00:09:09,840 --> 00:09:11,320
...في الحقيقة

115
00:09:11,750 --> 00:09:16,950
!لا يخافني المواطنون أبدًا
!إنّهم ممتنّون لي

116
00:09:18,750 --> 00:09:22,080
.على هذا المعدّل، سيسبقني برافاس

117
00:09:22,380 --> 00:09:23,820
برافاس؟

118
00:09:24,090 --> 00:09:27,850
،تقصد السّيّد برافاس
السّاحر الأسطوريّ لأسغا؟

119
00:09:27,850 --> 00:09:30,500
.نعم. لقد عاد

120
00:09:31,140 --> 00:09:32,480
.ذلك مستحيل

121
00:09:32,480 --> 00:09:37,970
حتّى إله لا يملك القوّة للتّحكّم
.بشؤون حياة وموت النّاس

122
00:09:38,520 --> 00:09:41,580
.حتّى أنا أعرف ذلك

123
00:09:41,580 --> 00:09:43,700
.لا بدّ أنّه مجرّد مزيّف

124
00:09:43,700 --> 00:09:46,840
...أوافقك، ولكن

125
00:09:47,440 --> 00:09:53,130
حسب كلام ريكو، تشبه قوّة
.برافاس السّحريّة قوّة التّاج

126
00:09:53,130 --> 00:09:57,590
أليس من الصّعب نسخ خصائص
القوّة السّحريّة لشخص آخر؟

127
00:09:57,590 --> 00:10:02,370
.هنالك طريقة لتقليدها

128
00:10:05,220 --> 00:10:06,270
...اسمع

129
00:10:06,270 --> 00:10:10,040
!فهمت! سينفع ذلك بالفعل
!هذا هو المتوقّع من القدّيسة

130
00:10:11,100 --> 00:10:14,110
.حسنًا، أراك لاحقًا يا سيّد سحليّة
.عليّ الرّحيل

131
00:10:14,110 --> 00:10:16,800
.إنّ شعب سيرين ينتظرونني
.مع السّلامة

132
00:10:22,230 --> 00:10:25,720
.ربّما سأتحرّى أمر قبر برافاس

133
00:10:26,910 --> 00:10:28,080
ماذا حدث؟

134
00:10:28,080 --> 00:10:31,580
!سيّدتي ريكو! أتيت أخيرًا

135
00:10:31,580 --> 00:10:34,470
.لا تبك. أخبرني ما الّذي حدث

136
00:10:34,960 --> 00:10:39,180
!ظهرت تلك المرأة هنا وسرقت الحجارة السّحريّة

137
00:10:39,180 --> 00:10:40,360
!ماذا قلت؟

138
00:10:49,680 --> 00:10:53,790
.يبدو أنّ كلّ شيء جاهز

139
00:10:57,770 --> 00:10:59,930
أين السّيّد برافاس؟

140
00:11:24,570 --> 00:11:27,490
!كلاّ! لا تأكليني

141
00:11:29,380 --> 00:11:30,410
...ذلك الصّوت

142
00:11:30,410 --> 00:11:33,070
ماذا؟ صاحبة الجلالة؟ –
التّنّين الشّرّير؟ –

143
00:11:34,470 --> 00:11:35,870
!وأخيرًا