1
00:01:48,580 --> 00:01:50,640
!الملك على حقّ

2
00:01:50,760 --> 00:01:53,670
!أتى التّنّين الشّرّير رافنديا لإنقاذنا –
!سيّدي التّنّين الشّرّير –

3
00:01:53,820 --> 00:01:57,340
!سيّدي التّنّين الشّرّير! سيّدي التّنّين الشّرّير

4
00:01:58,960 --> 00:02:00,470
...سيّدة ريكو

5
00:02:00,610 --> 00:02:01,800
.اسمعوا جيّدًا

6
00:02:01,920 --> 00:02:05,310
سيُظهر لنا سيّدي التّنّين الشّرّير
!كيف تسير الأمور

7
00:02:05,450 --> 00:02:09,880
،حتّى أنا، الأولى بين تابعيه
!لم أره بهذه الهيبة من قبل

8
00:02:10,030 --> 00:02:12,900
!هذا دليل لِكَم هو يهتمّ لأمركم

9
00:02:13,040 --> 00:02:16,140
!أمعنوا النّظر وتعلّموا القتال

10
00:02:16,280 --> 00:02:17,180
!حاضر

11
00:02:18,870 --> 00:02:22,120
!سيّدي التّنّين الشّرّير
!لا يوجد من هو أعظم منك

12
00:02:27,440 --> 00:02:29,100
—لا، مهلاً! أنا

13
00:02:37,960 --> 00:02:40,260
.ماذا؟ أنا بخير

14
00:02:40,610 --> 00:02:43,430
.لم أشعر بأيّ ألم على الإطلاق

15
00:02:44,520 --> 00:02:47,600
!إنّ هجوم النّار لم يخدشه حتّى

16
00:02:47,760 --> 00:02:51,770
إذًا فبإمكان الإيمان الكبير
أن يتحوّل لقوّة أيضًا؟

17
00:02:51,920 --> 00:02:53,360
!أيّها السّحليّة

18
00:02:54,780 --> 00:02:55,980
ماذا؟

19
00:02:56,330 --> 00:02:58,420
!اهزمه بسرعة

20
00:02:59,350 --> 00:03:00,360
...لكن

21
00:03:00,880 --> 00:03:04,200
لقد تحوّلتَ من سحليّة بلا حول
!ولا قوّة إلى تنّين في غاية القوّة

22
00:03:04,330 --> 00:03:06,040
!يمكنك النّجاح

23
00:03:06,190 --> 00:03:08,720
!تشجّع يا سيّدي التّنّين الشّرّير

24
00:03:09,160 --> 00:03:10,370
.حسنًا

25
00:03:13,510 --> 00:03:16,090
!لا خيار لديّ سوى القتال الآن

26
00:03:29,020 --> 00:03:30,190
أترون؟

27
00:03:30,320 --> 00:03:32,850
،لأنّكم غير قادرين على استعمال السّحر

28
00:03:32,980 --> 00:03:36,020
.اختار أن يقاتل بقدراته الجسديّة فقط

29
00:03:37,510 --> 00:03:39,360
!يا للُطفه

30
00:03:39,500 --> 00:03:42,020
لا يمكنك حتّى إلقاء تعويذة واحدة؟

31
00:03:42,150 --> 00:03:44,480
!جمعتَ الكثير من القوّة السّحريّة

32
00:03:44,620 --> 00:03:46,960
ألا يمكنك إلقاء أيّ شيء؟

33
00:03:47,820 --> 00:03:49,540
،أنا لا أتفاخر

34
00:03:49,670 --> 00:03:52,290
!لكنّي لم أهزم حتّى أرنبًا من قبل

35
00:03:52,440 --> 00:03:54,220
...صحيح. لديّ ذلك

36
00:04:10,070 --> 00:04:12,840
أهذه تعويذة قديمة؟

37
00:04:17,690 --> 00:04:20,780
!لنتقاتل

38
00:04:26,710 --> 00:04:29,160
!أجل! هذا هو المتوقّع من سيّدي التّنّين الشّرّير

39
00:04:29,310 --> 00:04:30,790
!سيفوز بلا شكّ

40
00:04:31,090 --> 00:04:33,120
!كفاك مقاومة

41
00:04:40,630 --> 00:04:41,880
!روزيتّا

42
00:04:52,070 --> 00:04:56,030
!روزيتّا

43
00:04:56,580 --> 00:04:57,960
أأنت هناك؟

44
00:04:58,780 --> 00:05:00,760
!أظهري نفسك رجاءً

45
00:05:03,890 --> 00:05:04,830
...روز

46
00:05:05,940 --> 00:05:09,130
.سامحيني. تكلّمت معك بقسوة من قبل

47
00:05:09,930 --> 00:05:11,660
.حاولي أن تفهمي رجاءً

48
00:05:11,900 --> 00:05:14,430
كلاكما أنت وشعب أسغا

49
00:05:14,750 --> 00:05:17,780
.مهمّان عندي بشكل متساوٍ

50
00:05:17,920 --> 00:05:22,090
.أنا متردّدة لأنّني لا أستطيع الاختيار بينكما

51
00:05:22,370 --> 00:05:25,030
.حاولت منحك العرش

52
00:05:25,170 --> 00:05:28,390
.أردتُ إظهار قوّتك

53
00:05:28,780 --> 00:05:30,840
.لكنّي كنت مخطئة

54
00:05:31,600 --> 00:05:35,730
.إنّ كلّ ما حدث خطئي أنا

55
00:05:35,920 --> 00:05:39,460
إنّ كلمات العرّاف المشؤومة تلك

56
00:05:39,810 --> 00:05:42,070
.كانت عن ذلك الوحش على الأرجح

57
00:05:42,450 --> 00:05:45,590
سأوضّح سوء الفهم بشأنك
.في الوقت المناسب

58
00:05:45,740 --> 00:05:47,610
.لن أسمح لك بالمعاناة أكثر بعد الآن

59
00:05:48,970 --> 00:05:51,140
هلاّ وثقتِ بي؟

60
00:05:54,590 --> 00:05:57,390
.لم تخيّبي ظنّي أبدًا يا صاحبة الجلالة

61
00:05:57,800 --> 00:06:00,650
.واضح لي لماذا أنت محبوبة

62
00:06:00,890 --> 00:06:03,500
.استهنت بك

63
00:06:03,680 --> 00:06:05,090
!لقد خدعتني

64
00:06:05,900 --> 00:06:08,410
.لا يجب أن أسمح لذعر النّاس أن يزول

65
00:06:08,540 --> 00:06:10,800
.حان الوقت لتموتي

66
00:06:20,560 --> 00:06:23,060
ألا تهاجمين الشّخص الخطأ؟

67
00:06:23,500 --> 00:06:27,790
أم أنّك وأختك قد تصالحتما؟

68
00:06:29,000 --> 00:06:30,860
...أيّتها الأميرة روزيتّا

69
00:06:31,070 --> 00:06:32,280
...روزيتّا

70
00:06:32,610 --> 00:06:36,820
تعاونت معك لأنّي سمعتُ
.أنّ بإمكانك استدعاء التّنّين الشّرّير

71
00:06:36,960 --> 00:06:39,540
.لكنّه لا يستطيع حتّى هزيمة سحليّة مثير للشّفقة

72
00:06:41,390 --> 00:06:44,040
.بالطّبع بإمكانه، إن قتلنا الملك

73
00:06:44,220 --> 00:06:48,300
!لا أريد سماع المزيد! أردتُ القوّة المطلقة

74
00:06:49,110 --> 00:06:51,520
.لكنّي أدركتُ شيئًا في النّهاية

75
00:06:51,670 --> 00:06:54,000
.كانت جهودي مضلَّلة

76
00:06:55,260 --> 00:06:57,130
،اعتقدت أنّ ذلك السّحليّة بلا حول ولا قوّة

77
00:06:57,260 --> 00:07:00,490
لكنّه أظهر قوّة لم أرَ مثلها من
.قبل في هذا الوضع الحرج

78
00:07:01,320 --> 00:07:03,800
.لن أسمح لك حتّى بلمسها

79
00:07:04,140 --> 00:07:06,980
!عليّ حماية هذه القوّة المطلقة

80
00:07:07,350 --> 00:07:11,220
!لا يمكنك أن تخسر
!أنت لها يا سيّدي التّنّين الشّرّير

81
00:07:15,090 --> 00:07:17,400
.ما عدتُ أحتاج هذا التّاج

82
00:07:17,640 --> 00:07:18,880
...أختي

83
00:07:21,580 --> 00:07:26,710
.يبدو أنّه ما زالت هنالك أمور لأتعلّمها منك

84
00:07:27,310 --> 00:07:29,470
...روزيتّا

85
00:07:31,170 --> 00:07:33,330
!أرى أنّكما على وفاق الآن

86
00:07:34,230 --> 00:07:37,520
.سأرسلكما معًا إلى قبركما إذًا

87
00:07:37,930 --> 00:07:40,480
!يا له من تنّين قويّ

88
00:07:40,620 --> 00:07:45,150
!لديه نقطة ضعف واحدة فقط
!عليك تدميرها وتدميري أنا معه

89
00:07:45,690 --> 00:07:48,380
لكن ما الّذي سيحدث لك؟ –
!كفّ عن إضاعة الوقت –

90
00:07:48,520 --> 00:07:51,480
أنا راضٍ لأنّي عشت هذا
!الوقت القليل كساحر عظيم

91
00:07:51,630 --> 00:07:53,440
!أسرع ودمّرها

92
00:07:58,790 --> 00:08:01,660
.لن أنساك أبدًا

93
00:08:14,170 --> 00:08:15,050
!روزيتّا

94
00:08:16,390 --> 00:08:18,260
أتتوقين للموت لتلك الدّرجة؟

95
00:08:22,990 --> 00:08:25,520
لا يمكنك حتّى الانتقال آنيًّا؟

96
00:08:25,950 --> 00:08:29,190
.من الجيّد أنّك هنا إذًا

97
00:09:05,320 --> 00:09:07,410
.عملنا معًا مثاليّ

98
00:09:07,900 --> 00:09:09,190
.لم ينتهِ الأمر بعد

99
00:09:22,820 --> 00:09:25,750
!الآن يا ريكو! صوّبي نحو صدره

100
00:09:25,910 --> 00:09:26,750
!حاضرة

101
00:09:31,620 --> 00:09:34,090
...تقنية التّنّين الشّرّير المطلقة

102
00:09:47,440 --> 00:09:50,930
!قرن التّنّين الشّرّير الرّاعد المدمّر

103
00:10:09,550 --> 00:10:11,340
.أحسنتم

104
00:10:28,430 --> 00:10:29,660
أين الملك؟

105
00:10:30,090 --> 00:10:32,360
!يا صاحبة الجلالة؟ يا صاحبة الجلالة

106
00:10:32,600 --> 00:10:36,870
.ما عادت هنالك حاجة لقتلك

107
00:10:37,820 --> 00:10:40,700
.سأقوم بعمل أفضل المرّة القادمة

108
00:10:41,820 --> 00:10:43,760
.عن إذنكما

109
00:10:51,240 --> 00:10:52,620
!لقد فزنا

110
00:10:54,910 --> 00:10:56,070
.بالطّبع

111
00:11:05,180 --> 00:11:08,290
.انتهى الأمر أخيرًا

112
00:11:18,920 --> 00:11:23,230
.اختفى التّابع المزيّف

113
00:11:24,390 --> 00:11:28,980
.وتصالحت الأختان بعض الشّيء

114
00:11:31,340 --> 00:11:33,330
،وبفضل صاحبة الجلالة

115
00:11:33,460 --> 00:11:36,050
،تمّ تفسير سوء الفهم الّذي أحاط بالنّبوءة

116
00:11:36,200 --> 00:11:39,460
.وانتهى تعصُّب الشّعب ضدّ الأميرة روزيتّا

117
00:11:40,250 --> 00:11:42,120
في تلك الأثناء، تدرس الأميرة روزيتّا

118
00:11:42,250 --> 00:11:45,430
.لتصير ملكًا قويًّا

119
00:11:45,580 --> 00:11:48,040
.لقد تغيّر موقفها

120
00:11:48,170 --> 00:11:52,230
.وحتّى صاحبة الجلالة تثق في أختها

121
00:11:52,360 --> 00:11:55,620
ساعدت منظّمة الدّم الأسود
،في إعادة إحياء المدينة

122
00:11:55,760 --> 00:11:59,740
.وتعلّموا كيف يتعايشون مع شعبها

123
00:12:00,360 --> 00:12:02,720
،وبعد اتّباع تعاليمي وريكو

124
00:12:02,860 --> 00:12:05,530
.تغيّروا بالكامل

125
00:12:05,950 --> 00:12:10,290
تمّ نقل جثّة السّيّد برافاس
.إلى القبر الصّحيح

126
00:12:10,710 --> 00:12:13,320
...أمّا بالنّسبة لذلك الوحش

127
00:12:13,920 --> 00:12:18,040
أتمنّى لو استطعتُ منحه قبرًا
.أفضل، لكن ما باليد حيلة

128
00:12:18,660 --> 00:12:23,030
.عادت حياتي العاديّة لسابق عهدها

129
00:12:26,870 --> 00:12:30,200
.عليكما البقاء في أسغا لوقت أطول

130
00:12:30,850 --> 00:12:33,850
.سنعترض طريقكم فقط إن أطلنا البقاء

131
00:12:33,980 --> 00:12:37,670
.سننطلق لهزيمة ملك الشّياطين
.لا يمكننا إضاعة الوقت هنا

132
00:12:38,760 --> 00:12:40,710
.إليكما هذه المعلومات من بلدان أخرى

133
00:12:40,840 --> 00:12:44,110
يبدو أنّ قوّات ملك الشّياطين
.مجتمعة في الشّمال الشّرقيّ

134
00:12:44,350 --> 00:12:45,870
لماذا لا تذهبان إلى هناك؟

135
00:12:48,120 --> 00:12:51,330
...فات الأوان على العودة الآن

136
00:12:52,730 --> 00:12:55,000
!هيّا بنا يا سيّدي التّنّين الشّرّير

137
00:13:05,050 --> 00:13:06,910
...ذلك السّحليّة

138
00:13:07,220 --> 00:13:09,410
.قد أستطيع استعماله