1
00:00:23,440 --> 00:00:27,040
في نهاية المطاف، سيأتي التّنّين
.الشّرّير الحقيقيّ لهزيمتي

2
00:00:27,180 --> 00:00:31,180
إلى متى ستستمرّ هذه الحياة الهانئة؟

3
00:00:31,880 --> 00:00:33,980
.سيّدي التّنّين الشّرّير، وصل أحد ما

4
00:00:34,120 --> 00:00:35,220
!أوصل بهذه السّرعة؟

5
00:00:37,680 --> 00:00:40,600
.إنّها صاحبة الجلالة فحسب

6
00:00:41,430 --> 00:00:42,880
!سيّدي التّنّين الشّرّير

7
00:00:44,940 --> 00:00:46,140
...سيّدي التّنّين الشّرّير

8
00:00:46,610 --> 00:00:48,220
،عثرتُ على روزيتّا

9
00:00:48,370 --> 00:00:52,080
.لكنّها هربت إلى القبو خلال نقاشنا

10
00:00:52,230 --> 00:00:54,400
.يأبى الباب أن يُفتح ولا نعرف ما العمل

11
00:00:54,980 --> 00:00:58,870
.أعرف أين هي، لكن لا يمكنني فعل أيّ شيء

12
00:01:00,940 --> 00:01:02,050
...سيّدي التّنّين الشّرّير

13
00:01:02,170 --> 00:01:05,750
!استعمل سحرك لفتح باب القبو رجاءً

14
00:01:05,890 --> 00:01:10,540
.عفوًا، ما زلتُ غير واثق ممّا يحدث

15
00:01:11,450 --> 00:01:12,690
...إنّ روزيتّا

16
00:01:13,170 --> 00:01:14,650
.ليست فتاة سيّئة

17
00:01:15,160 --> 00:01:18,270
ولكن بسبب تدليلي لها، صار
لديها اهتمام بالأمور الخطأ

18
00:01:18,400 --> 00:01:20,260
!وتوشك على الخروج عن الطّريق المستقيم

19
00:01:20,470 --> 00:01:23,640
!عليّ إنقاذ أختي روزيتّا

20
00:01:24,090 --> 00:01:27,280
!أعرني قوّتك رجاءً يا سيّدي التّنّين الشّرّير

21
00:01:29,020 --> 00:01:31,610
.يا صاحبة الجلالة، لا يجب عليك التّسرّع

22
00:01:31,760 --> 00:01:34,450
.أخبروني بما حدث

23
00:03:26,340 --> 00:03:29,300
...أنا متعب قليلاً

24
00:03:29,450 --> 00:03:31,440
هلاّ أبطأنا قليلاً؟

25
00:03:31,800 --> 00:03:34,240
هل أساعدك يا سيّدي التّنّين الشّرّير؟

26
00:03:35,200 --> 00:03:38,730
.لا، أنا بخير. ما زال بإمكاني السّير

27
00:03:38,870 --> 00:03:42,660
كيف تخطّط لمساعدتي؟

28
00:03:44,850 --> 00:03:46,950
.ارتح هنا يا سيّدي التّنّين الشّرّير

29
00:03:46,950 --> 00:03:49,400
سأذهب لرؤية إن كانت روزيتّا
.لا تزال في القبو

30
00:03:49,560 --> 00:03:51,240
.انضمّا إلينا لاحقًا مع إدوارد

31
00:03:51,480 --> 00:03:52,460
!مهلاً

32
00:03:55,290 --> 00:03:57,970
.إنّها بالفعل أخت لطيفة

33
00:03:58,120 --> 00:03:59,090
،يا سيّدي التّنّين الشّرّير

34
00:03:59,340 --> 00:04:01,220
هل نرتاح لبعض الوقت؟

35
00:04:01,410 --> 00:04:02,530
.لا

36
00:04:02,650 --> 00:04:06,840
.علينا الإسراع لأجل صالح صاحبة الجلالة

37
00:04:15,370 --> 00:04:17,180
.القصر مهجور

38
00:04:17,300 --> 00:04:21,060
طلبتُ من الجميع الاستعداد
.لهجوم التّنّين الشّرّير

39
00:04:21,200 --> 00:04:22,980
.لن تظلّ سوى صاحبة الجلالة

40
00:04:23,120 --> 00:04:24,280
.فهمت

41
00:04:24,720 --> 00:04:29,620
بالمناسبة، ما الّذي فعلته الأميرة روزيتّا بالتّحديد؟

42
00:04:31,740 --> 00:04:32,820
...في الحقيقة

43
00:04:35,540 --> 00:04:37,710
أتدرين ما الّذي تفعلينه؟

44
00:04:37,930 --> 00:04:39,920
أحفر قبرًا. هل من مشكلة في ذلك؟

45
00:04:43,070 --> 00:04:45,150
.أفهم كيف تشعرين

46
00:04:46,300 --> 00:04:49,010
!لكنّك تماديت كثيرًا بنبش قبور أسلافنا

47
00:04:52,380 --> 00:04:54,690
تفهمين كيف أشعر؟

48
00:04:56,060 --> 00:04:57,260
!نعم

49
00:04:57,510 --> 00:04:59,480
،يخشاك الجميع كمنبوذة

50
00:04:59,630 --> 00:05:02,610
—وعانيت الكثير بسبب ذلك، صحيح؟ ولكن

51
00:05:02,860 --> 00:05:04,190
!لا تفهمين أيّ شيء

52
00:05:06,100 --> 00:05:09,060
.لا يهمّ ما ظنّ الآخرين بي

53
00:05:12,120 --> 00:05:16,290
إنّ كلّ ما أفعله، أفعله لأجل
.سيّدي التّنّين الشّرّير

54
00:05:16,960 --> 00:05:21,340
،وبهذه القوّة الّتي ورثتُها
!أريد استعداء التّنّين الشّرّير

55
00:05:21,590 --> 00:05:24,920
!ولا أهتمّ إن كنتُ منبوذة

56
00:05:29,420 --> 00:05:31,640
.عرفتُ أنّك لا تفهمين

57
00:05:32,200 --> 00:05:33,490
...أختي

58
00:05:35,360 --> 00:05:37,520
.هذا ما حدث إذًا

59
00:05:37,680 --> 00:05:40,270
.لا عجب أنّ صاحبة الجلالة غير صبورة

60
00:05:40,610 --> 00:05:46,350
إذًا فهذا يعني أنّ برافاس هو سلف
.الأميرة وصاحبة الجلالة

61
00:05:46,490 --> 00:05:49,660
بالمناسبة، لماذا هي منبوذة بالضّبط؟

62
00:05:52,090 --> 00:05:58,780
.صار السّيّد برافاس ملكًا بعد إنشائه للمعبر

63
00:06:00,060 --> 00:06:03,080
...كان يسير كلّ شيء على ما يرام

64
00:06:03,750 --> 00:06:06,880
.إلى أن رحل السّيّد برافاس عن هذا العالم

65
00:06:10,680 --> 00:06:12,470
...أنا أتنبّأ

66
00:06:12,870 --> 00:06:17,640
أنّه في يوم ما، سيُولد شخص ما
.يشبه السّيّد برافاس في مكان ما

67
00:06:17,820 --> 00:06:23,530
سيكون كائنًا شرّيرًا سيجلب
!سوء الحظّ لأسغا

68
00:06:24,180 --> 00:06:25,450
ماذا قال؟

69
00:06:29,360 --> 00:06:32,380
.وبعدها وُلدت الأميرة روزيتّا

70
00:06:32,520 --> 00:06:35,490
.تهانينا. إنّها فتاة

71
00:06:36,550 --> 00:06:42,220
وُلدت الأميرة روزيتّا وهي تملك
.قوّة سحريّة مذهلة

72
00:06:42,830 --> 00:06:45,440
،ولأنّها تملك شعرًا أبيض مثل السّيّد برافاس

73
00:06:45,590 --> 00:06:50,300
بدأ النّاس بالقول أنّها الشّخص
.الشّرّير الّذي ذُكر في النّبوءة

74
00:06:53,020 --> 00:06:57,060
لا عجب أنّها ليست ضمن
.صورة العائلة الملكيّة

75
00:06:58,960 --> 00:07:02,460
.إنّ روزيتّا وريكو متشابهتان نوعًا ما

76
00:07:02,860 --> 00:07:05,800
.لكنّ هذه لا تملك أيّ شكوك

77
00:07:05,940 --> 00:07:08,740
!عليّ تحمّل المسؤوليّة عنها دائمًا

78
00:07:15,010 --> 00:07:18,440
.سمعتُ ضجيجًا
.ما زالت روزيتّا في الدّاخل

79
00:07:18,580 --> 00:07:21,090
.من هنا يا سيّدي التّنّين الشّرّير والآنسة ريكو

80
00:07:22,590 --> 00:07:25,400
.سيّدي التّنّين الشّرّير، إنّ روزيتّا في الدّاخل

81
00:07:25,540 --> 00:07:27,170
.استعمل قوّتك السّحريّة لفتح الباب

82
00:07:28,070 --> 00:07:29,010
ما هذا؟

83
00:07:35,330 --> 00:07:38,850
القفل صدئ. لذلك السّبب
.يأبى الباب أن يُفتح

84
00:07:39,280 --> 00:07:42,270
.تراجعا يا سيّدي التّنّين الشّرّير والآنسة ريكو

85
00:08:00,780 --> 00:08:02,210
ماذا؟

86
00:08:04,840 --> 00:08:09,210
.أُلقيت تعويذة دفاعيّة قويّة على هذا الباب

87
00:08:09,860 --> 00:08:13,850
،حتّى الرّمح الرّاعد إدوارد
،أقوى سحرة بلادنا المقاتلين

88
00:08:13,980 --> 00:08:15,680
.لا يمكنه اختراقه

89
00:08:16,890 --> 00:08:20,390
.لا يمكنني كسر باب كهذا

90
00:08:20,960 --> 00:08:23,480
كيف دخلت الأميرة روزيتّا؟

91
00:08:23,830 --> 00:08:27,100
.ربّما استعملت التّاج للانتقال

92
00:08:28,330 --> 00:08:31,460
إنّ من ورثوا قدرات السّيّد برافاس

93
00:08:31,750 --> 00:08:34,780
.بإمكانهم استخلاص قوّة التّاج

94
00:08:35,780 --> 00:08:37,490
!إنّها إساءة لاستعمال قوّته

95
00:08:37,640 --> 00:08:40,320
هذا لأنّها لا تدرك قوّة سيّدي
التّنّين الشّرّير الحقيقيّة

96
00:08:40,470 --> 00:08:43,080
وخُدعت بالتّالي على يد أشرار
.واقترفت هذا الهراء

97
00:08:44,150 --> 00:08:47,320
،سيّدي التّنّين الشّرّير
!افتح ذلك الباب رجاءً

98
00:08:47,470 --> 00:08:49,000
!اجعلها تفهم

99
00:08:49,370 --> 00:08:51,490
...في الحقيقة، أنا

100
00:08:51,620 --> 00:08:53,080
،بشكل شخصيّ

101
00:08:53,210 --> 00:08:56,750
.أفضّل ترك هذا لكبيرة أتباعي

102
00:08:58,760 --> 00:09:02,960
.سمعًا وطاعة، لا تحتاج لإزعاج نفسك

103
00:09:03,220 --> 00:09:07,140
لكن علينا انتهاز هذه الفرصة
لإظهار قوّتك

104
00:09:07,270 --> 00:09:10,190
!وتغيير طريقة تفكير الأميرة روزيتّا

105
00:09:11,780 --> 00:09:14,400
...أظنّ ذلك

106
00:09:14,740 --> 00:09:17,360
.تفضّل يا سيّدي التّنّين الشّرّير

107
00:09:17,810 --> 00:09:19,700
!أعتمد عليك يا سيّدي التّنّين الشّرّير

108
00:09:24,280 --> 00:09:26,670
!حسنًا، عليّ القيام بهذا الآن

109
00:09:27,020 --> 00:09:29,750
.استمتعتُ كثيرًا

110
00:09:29,900 --> 00:09:31,710
.ما عدت أهتمّ ما قد يحدث الآن

111
00:09:31,840 --> 00:09:35,240
!سأفعل كلّ ما يتطلّبه الأمر لفتحه
!سأخاطر بكلّ شيء

112
00:09:44,070 --> 00:09:45,430
!فُتح في الحال

113
00:09:59,780 --> 00:10:03,810
.لم تكن هنالك حاجة لاستعمال السّحر
.كان يجب كسر القفل فحسب

114
00:10:04,960 --> 00:10:06,290
ما هذا؟

115
00:10:17,660 --> 00:10:20,520
!أسمع شيئًا ما. لا بدّ أنّها روزيتّا

116
00:10:22,800 --> 00:10:25,220
!مهلاً يا صاحبة الجلالة

117
00:10:26,150 --> 00:10:28,900
.الأميرة روزيتّا منفعلة

118
00:10:29,020 --> 00:10:31,080
.لن تستمع لأيّ كلمة منك

119
00:10:31,230 --> 00:10:33,420
.من الخطير التّقدّم أكثر

120
00:10:33,710 --> 00:10:36,230
.سأتولّى أنا الأمر

121
00:10:36,920 --> 00:10:37,880
.صاحبة الجلالة

122
00:10:38,680 --> 00:10:40,870
.أنا أوافقه الرّأي

123
00:10:41,030 --> 00:10:44,030
.لندع التّنّين الشّرّير يذهب أوّلاً

124
00:10:50,150 --> 00:10:52,380
.أنقذ أختي رجاءً

125
00:10:53,940 --> 00:10:57,200
.يجدر بتابع التّنّين الشّرّير أن يكون معها

126
00:10:59,430 --> 00:11:02,000
.لا فائدة من الهرب

127
00:11:02,660 --> 00:11:07,220
.سأشرح الوضع وأحلّ أيّ سوء فهم موجود

128
00:11:07,880 --> 00:11:09,690
...ريكو –
.نعم –

129
00:11:09,830 --> 00:11:12,770
.انزلي للأسفل إن سمعتِ صوتي

130
00:11:14,030 --> 00:11:16,650
.تلك هي الإشارة؟ مفهوم

131
00:11:20,660 --> 00:11:23,280
.عفوًا على التّطفّل

132
00:11:24,450 --> 00:11:28,200
هل من أحد هنا؟

133
00:11:30,030 --> 00:11:33,460
أين أنت أيّتها الأميرة روزيتّا؟