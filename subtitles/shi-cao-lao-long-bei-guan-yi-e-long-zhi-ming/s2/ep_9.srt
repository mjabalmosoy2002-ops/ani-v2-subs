1
00:01:45,490 --> 00:01:46,640
.فهمت

2
00:01:46,780 --> 00:01:51,040
إذًا فأنت أيضًا تتحرّى أمر السّيّد برافاس؟

3
00:01:52,070 --> 00:01:53,350
.هذا صحيح

4
00:01:53,690 --> 00:01:55,300
أذلك سبب تواجدك هنا أيضًا؟

5
00:01:55,820 --> 00:01:56,920
.كم سرّني هذا

6
00:01:57,040 --> 00:01:58,790
.تشجّعت الآن بتواجدك معي

7
00:01:58,920 --> 00:02:01,350
.لنكتشف الحقيقة معًا

8
00:02:01,680 --> 00:02:03,540
.هيّا بنا

9
00:02:06,440 --> 00:02:07,940
.سرّني هذا

10
00:02:11,820 --> 00:02:16,060
.يبدو أنّها تريد تجاوز الحادثة في القبو

11
00:02:24,190 --> 00:02:26,640
.إذًا فهذا هو قبر السّيّد برافاس

12
00:02:26,780 --> 00:02:29,080
.إنّه قبر عظيم على خلاف البقيّة

13
00:02:29,970 --> 00:02:31,640
،في كلّ سنة هنا في أسغا

14
00:02:31,780 --> 00:02:35,930
نقيم مراسم في هذا القرب لتشريفه

15
00:02:36,120 --> 00:02:38,480
.وتذكير أنفسنا بأن نكون ممتنّين

16
00:02:40,500 --> 00:02:41,890
...لكنّ روزيتّا

17
00:02:42,350 --> 00:02:44,350
.حاولت تدمير هذا القبر

18
00:02:45,980 --> 00:02:49,060
لم تقم بحفره، صحيح؟

19
00:02:50,450 --> 00:02:54,150
.لا. لقد غادرت بعد تدمير شاهد القبر

20
00:02:57,120 --> 00:02:58,940
.هذا غريب

21
00:03:00,390 --> 00:03:02,640
تظنّ ذلك أنت أيضًا؟

22
00:03:03,360 --> 00:03:07,450
تتطلّب إعادة الأشخاص للحياة
.خروج الأموات من تحت الأرض

23
00:03:07,760 --> 00:03:10,660
.لكن لا توجد أيّ علامة لذلك هنا

24
00:03:11,450 --> 00:03:12,760
...ما يعني

25
00:03:13,320 --> 00:03:15,630
...أنّ السّيّد برافاس الّذي رأيناه

26
00:03:16,180 --> 00:03:17,300
!مجرّد مزيّف

27
00:03:24,920 --> 00:03:28,240
.أ-أظنّني سمعتُ صوتًا

28
00:03:35,750 --> 00:03:37,750
!النّجدة

29
00:04:00,980 --> 00:04:02,170
!إنّه وحش

30
00:04:02,300 --> 00:04:04,980
!سأدعك تتولّى أمره أيّها التّنّين الشّرّير –
!صاحبة الجلالة –

31
00:04:05,130 --> 00:04:06,520
...لكنّي

32
00:04:08,040 --> 00:04:11,020
!ريكو، عودي بسرعة

33
00:04:14,090 --> 00:04:15,520
!لا فائدة منكم

34
00:04:15,690 --> 00:04:18,690
كيف تسمحون بسرقة الحجارة
!السّحريّة النّفيسة تلك؟

35
00:04:18,840 --> 00:04:20,190
!نحن آسفون

36
00:04:20,330 --> 00:04:23,280
!لا يستطيع أحد هزيمة تلك المرأة

37
00:04:24,090 --> 00:04:28,280
فشلتُ في المهمّة الّتي أوكلني بها
.سيّدي التّنّين الشّرّير

38
00:04:28,480 --> 00:04:30,950
...في الحقيقة يا سيّدتي ريكو

39
00:04:35,630 --> 00:04:39,960
.لم تُسرق سوى بعض الحجارة فقط
.ما زال معظمها هنا بأمان

40
00:04:41,440 --> 00:04:43,220
.تستحقّون الثّناء على ذلك

41
00:04:44,000 --> 00:04:45,840
—شكرًا جزيـ –
.لكن لا تغترّ بنفسك –

42
00:04:46,160 --> 00:04:47,180
،على هذا المعدّل

43
00:04:47,300 --> 00:04:51,100
فإنّ عدد التّابعين المزيّفين ومنتحلي
.شخصيّة التّنّين الشّرّير سيزداد فحسب

44
00:04:52,190 --> 00:04:54,860
،بصفتنا خدم التّنّين الشّرّير

45
00:04:54,980 --> 00:04:58,970
علينا مطاردة أولئك المزيّفين
!وندافع عن كرامة سيّدنا

46
00:04:59,510 --> 00:05:03,220
وبصفتي تابعته الأولى، فسأدرّبكم

47
00:05:03,360 --> 00:05:05,610
!لكي لا تُحرجوا سيّدي التّنّين الشّرّير

48
00:05:14,780 --> 00:05:18,330
!يا سيّدي التّنّين الشّرّير، إنّ الوحش يتحوّل

49
00:05:18,470 --> 00:05:19,850
...ذلك

50
00:05:21,210 --> 00:05:25,720
.كانت القدّيسة محقّة
.إنّه وحش يتغذّى على الجثث

51
00:05:25,900 --> 00:05:27,380
وحش يتغذّى على الجثث؟

52
00:05:28,160 --> 00:05:30,220
.إنّه وحش متدنّي المستوى في العادة

53
00:05:31,050 --> 00:05:33,140
.إنّه مجرّد هيكل عظميّ في الحقيقة

54
00:05:33,270 --> 00:05:36,430
،قوّته السّحريّة ضعيفة
،ولكن بعد التهامه لجثّة أحد ما

55
00:05:36,570 --> 00:05:42,160
يستطيع أخذ مظهره
.وتقليد خصائص قوّته السّحريّة

56
00:05:51,360 --> 00:05:53,520
أين أنا؟

57
00:05:53,720 --> 00:05:55,670
.ظننتُ أنّي كنتُ في القبو

58
00:05:57,400 --> 00:05:59,190
!كشفت لنا عن هويّتك الحقيقيّة

59
00:05:59,330 --> 00:06:01,880
!لا تتظاهر بالغباء أيّها الوحش الفظيع

60
00:06:03,250 --> 00:06:04,680
!كيف تجرئين؟

61
00:06:04,820 --> 00:06:09,050
!اركعي عندما تلتقين بساحر عظيم مثلي

62
00:06:10,930 --> 00:06:13,470
.ذلك ليس تظاهرًا

63
00:06:13,680 --> 00:06:17,620
بعد أكل الجثّة، فإنّ الوحش لا يأخذ
،شكل الشّخص فحسب

64
00:06:17,760 --> 00:06:20,030
بل وتصرّفاته وشخصيّته أيضًا

65
00:06:17,760 --> 00:06:20,330
...ذكريات

66
00:06:20,330 --> 00:06:22,830
!إضافة لذكرياته

67
00:06:23,650 --> 00:06:27,200
.إنّه يعتقد أنّه برافاس بالفعل

68
00:06:27,340 --> 00:06:31,030
!أنتم! أظهروا بعد الاحترام

69
00:06:31,810 --> 00:06:35,660
!إنّ النّظر إليكم يجعل دمائي تغلي

70
00:06:35,800 --> 00:06:40,540
،جلبتُ الازدهار لأسغا
وهكذا تردّون لي المعروف؟

71
00:06:40,680 --> 00:06:42,450
،لو عرفتُ أنّ هذا ما سيحدث

72
00:06:42,580 --> 00:06:45,920
!ما كنتُ لأنشئ ذلك الممرّ

73
00:06:47,140 --> 00:06:49,680
.إنّه غاضب بالفعل

74
00:06:50,290 --> 00:06:52,630
.انظر للقبر الّذي خلفك وستعرف

75
00:06:53,950 --> 00:06:59,060
.لا تزال جثّة برافاس مدفونة هناك

76
00:06:59,500 --> 00:07:01,870
.حاول أن تتذكّر

77
00:07:15,040 --> 00:07:17,920
!لكنّك تماديت كثيرًا بنبش قبور أسلافنا

78
00:07:19,460 --> 00:07:21,540
تفهمين كيف أشعر؟

79
00:07:21,680 --> 00:07:22,910
!نعم

80
00:07:23,430 --> 00:07:25,500
،يخشاك الجميع كمنبوذة

81
00:07:25,660 --> 00:07:28,830
—وعانيت الكثير بسبب ذلك، صحيح؟ ولكن

82
00:07:28,980 --> 00:07:30,540
!لا تفهمين أيّ شيء

83
00:07:31,130 --> 00:07:34,100
.لا يهمّ ما ظنّ الآخرين بي

84
00:07:35,020 --> 00:07:38,810
إنّ كلّ ما أفعله، أفعله لأجل
.سيّدي التّنّين الشّرّير

85
00:07:38,950 --> 00:07:43,110
،وبهذه القوّة الّتي ورثتُها
!أريد استعداء التّنّين الشّرّير

86
00:07:43,240 --> 00:07:46,060
!ولا أهتمّ إن كنتُ منبوذة

87
00:07:50,020 --> 00:07:53,480
يبدو أنّه تذكّر. ماذا نفعل الآن؟

88
00:07:54,920 --> 00:07:56,180
!مهلاً

89
00:07:56,910 --> 00:07:58,450
!كيف تجرؤون؟

90
00:07:58,720 --> 00:08:01,880
!ظننتُم أنّ قبر شخص آخر هو قبري

91
00:08:02,400 --> 00:08:04,000
!لن أسامحكم على هذا

92
00:08:04,670 --> 00:08:07,460
صحيح أنّ جميع أهل أسغا
...كانوا مرتبكين

93
00:08:07,600 --> 00:08:11,090
لـ-لكنّ ذلك لا يمنحك الحقّ
!لتغضب علينا

94
00:08:11,220 --> 00:08:12,660
...أنا

95
00:08:12,890 --> 00:08:15,140
أملك الذّكريات والقوّة السّحريّة

96
00:08:15,280 --> 00:08:18,010
.لبرافاس بحدّ ذاته

97
00:08:18,350 --> 00:08:23,010
!أنا السّاحر العظيم السّيّد برافاس

98
00:08:27,540 --> 00:08:28,740
!توقّفي

99
00:08:28,880 --> 00:08:31,600
أتعرفان من أكون؟

100
00:08:31,730 --> 00:08:33,780
!أنا السّيّد برافاس

101
00:08:34,040 --> 00:08:37,430
استسلم. ما كان أيّ ساحر عظيم
.ليكون ضعيفًا هكذا

102
00:08:37,560 --> 00:08:39,080
!أنا هو بالفعل

103
00:08:40,660 --> 00:08:42,750
...يا له من عنيد

104
00:08:43,490 --> 00:08:46,520
،في حالتي، كلّما نكرتُ الأمر

105
00:08:46,640 --> 00:08:50,340
.زاد ارتباك الآخرين أكثر وأكثر

106
00:08:52,240 --> 00:08:56,260
.يا ملك أسغا، بإمكاني إنشاء تنّين شرّير

107
00:08:56,430 --> 00:09:00,010
—فكّي وثاقي، وسأجعل أسغا قويّة

108
00:09:02,600 --> 00:09:05,020
.لا أحتاج لمساعدتك

109
00:09:05,760 --> 00:09:09,140
،حتّى إن كان بإمكانك التّحكّم بتنّين شرّير

110
00:09:09,270 --> 00:09:13,140
لا ينبغي لنا أن ندوس على
.الأمم الأخرى تحت أقدامنا

111
00:09:13,440 --> 00:09:16,810
.ما أسعى إليه هو السّلام

112
00:09:19,070 --> 00:09:22,810
،إن تركناه مقيّدًا
.فلن يتمّ إنشاء أيّ تنّين شرّير

113
00:09:23,280 --> 00:09:25,000
.سُوّي الأمر هكذا

114
00:09:28,560 --> 00:09:33,130
.صحيح! عليّ شرح الأمر لروزيتّا

115
00:09:49,050 --> 00:09:50,610
السّيّد برافاس؟

116
00:09:55,370 --> 00:09:58,860
.كنتُ بانتظارك أيّتها الأميرة روزيتّا

117
00:10:00,170 --> 00:10:01,580
من أنت؟

118
00:10:05,280 --> 00:10:07,580
.قرأت رسالتك الّتي كانت في القبو

119
00:10:08,720 --> 00:10:11,660
.سيحلّ علينا التّنّين الشّرّير قريبًا

120
00:10:12,540 --> 00:10:15,460
.حان وقتي لأتصرّف أخيرًا

121
00:10:15,690 --> 00:10:18,360
.يجب أن يكون السّيّد برافاس هنا أيضًا

122
00:10:18,630 --> 00:10:20,940
،باستدعاء التّنّين الشّرّير

123
00:10:21,180 --> 00:10:24,060
.نحتاج لقوّة السّيّد برافاس السّحريّة

124
00:10:24,700 --> 00:10:26,550
.لا نحتاج إليه

125
00:10:26,890 --> 00:10:28,200
...القوّة السّحريّة الّتي نحتاجها

126
00:10:28,870 --> 00:10:30,730
.موجودة هنا

127
00:10:31,030 --> 00:10:32,150
ماذا تقصد؟

128
00:10:45,640 --> 00:10:48,200
.كلّ شيء في مكانه الآن

129
00:11:08,980 --> 00:11:11,040
.حان الوقت للحركة الأخيرة

130
00:11:11,910 --> 00:11:13,770
!ليبدأ العرض