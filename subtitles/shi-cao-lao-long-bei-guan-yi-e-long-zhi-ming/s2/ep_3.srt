1
00:00:24,000 --> 00:00:27,210
تنّين عاشب عمره 5000 سنة يُعامَل"
"كشرّير بشكل غير عادل

2
00:01:45,900 --> 00:01:47,980
،حسب تعليمات تابعك

3
00:01:48,140 --> 00:01:51,340
!جمعنا حجارة سحريّة وأنشأنا دوائر سحريّة

4
00:01:51,520 --> 00:01:54,760
!أنهينا مهمّتنا بدون أيّ خطأ

5
00:01:57,100 --> 00:01:58,220
ريكو؟

6
00:01:58,980 --> 00:02:00,750
!لم أكن أنا

7
00:02:00,890 --> 00:02:02,930
.قالوا أنّهم اتّبعوا تعليمات تابعك

8
00:02:03,120 --> 00:02:06,580
،يا سيّدي التّنّين الشّرّير
هل لديك تابعون آخرون؟

9
00:02:06,850 --> 00:02:10,440
.لا. أنت تابعتي الوحيدة

10
00:02:10,760 --> 00:02:13,480
.هكذا إذًا؟ إنّه لشرف لي

11
00:02:15,800 --> 00:02:17,490
.لم يكن السّيّدة ريكو

12
00:02:17,680 --> 00:02:20,360
كان الشّخص الّذي قابلناه أطول

13
00:02:20,500 --> 00:02:23,260
.وارتدى عباءة سوداء بقلنسوة

14
00:02:26,000 --> 00:02:28,710
كيف يجرؤ على التّظاهر
!بأنّه تابع لسيّدي التّنّين الشّرّير؟

15
00:02:28,850 --> 00:02:32,670
.لقد خدعكم بالكامل
.لم أقدّم أيّ تعليمات كهذه

16
00:02:32,940 --> 00:02:34,230
!سامحنا

17
00:02:34,360 --> 00:02:37,640
!سمعنا أنّ مصدر قوّتك هو الخوف

18
00:02:37,780 --> 00:02:41,620
ظننّا أنّك ستساعدنا للإطاحة
!بالملك إن ساعدناك

19
00:02:41,760 --> 00:02:43,430
!كنّا نأمل ذلك على الأقلّ

20
00:02:43,880 --> 00:02:47,040
!أنا أعرض عليك روحي كاعتذار

21
00:02:47,190 --> 00:02:48,520
!سندفع أرواحنا تكفيرًا عن ذلك

22
00:02:48,660 --> 00:02:50,690
!لا تكونوا مستهترين كثيرًا بأرواحكم هكذا

23
00:02:51,560 --> 00:02:55,760
.روحي كافية لإرضاء سيّدي التّنّين الشّرّير

24
00:02:55,910 --> 00:03:00,430
.أرواحكم الوضيعة بلا قيمة

25
00:03:00,910 --> 00:03:02,070
أتفهمون؟

26
00:03:02,260 --> 00:03:03,870
!سامحينا

27
00:03:04,580 --> 00:03:06,990
.انتهى كلّ هذا على خير

28
00:03:07,510 --> 00:03:12,460
.لنعد إلى الدّوائر السّحريّة
قلتم أنّكم أنشأتم العديد منها، صحيح؟

29
00:03:12,670 --> 00:03:13,580
.ذلك صحيح

30
00:03:13,800 --> 00:03:16,750
.اذهبوا وتخلّصوا منها جميعها

31
00:03:16,970 --> 00:03:19,340
.لا تزعجوا النّاس في الأعلى

32
00:03:19,500 --> 00:03:20,700
!سمعًا وطاعة

33
00:03:20,860 --> 00:03:24,580
،عفوًا يا سيّدي التّنّين الشّرّير
...لديّ طلب منك في الحقيقة

34
00:03:24,720 --> 00:03:25,800
ما هو؟

35
00:03:26,200 --> 00:03:30,560
كنّا نبجّل ذلك التّمثال الحجريّ
.طوال هذا الوقت

36
00:03:30,870 --> 00:03:32,340
لكنّ هذا التّمثال الحجريّ

37
00:03:32,490 --> 00:03:35,960
.لا يوفي هيئتك الحقيقيّة حقّها

38
00:03:36,480 --> 00:03:40,990
لذلك... هل لنا بشيء لإحياء
ذكرى هذه المناسبة؟

39
00:03:41,130 --> 00:03:42,740
...مثل أحد حراشفك مثلاً

40
00:03:44,040 --> 00:03:48,200
كيف تجرؤ على طلب هدايا
!من سيّدي التّنّين الشّرّير؟

41
00:03:48,340 --> 00:03:49,440
...سيّدتي ريكو

42
00:03:49,580 --> 00:03:53,500
إنّنا نطلب أن نبجّل السّيّد التّنّين الشّرّير
!كما يليق به فحسب! لا ننوي أيّ ضرر

43
00:03:53,640 --> 00:03:54,790
،فعلى عكسك أنت

44
00:03:54,920 --> 00:03:58,420
لا تتسنّى لنا فرصة رؤية سيّدنا
!التّنّين الشّرّير عن قرب دائمًا

45
00:03:58,660 --> 00:04:00,050
.هكذا الأمر إذًا

46
00:04:00,200 --> 00:04:01,310
.معك حقّ

47
00:04:01,480 --> 00:04:03,750
،بينما أنا مع سيّدي التّنّين الشّرّير

48
00:04:03,890 --> 00:04:06,580
،فأنا أظلّ شاهدة دائمًا على قوّته المذهلة

49
00:04:06,720 --> 00:04:09,310
.لكنّكم لن تحقّقوا ذلك الحلم أبدًا

50
00:04:09,450 --> 00:04:12,000
أذلك أمر يستحقّ التّباهي به؟

51
00:04:12,430 --> 00:04:13,620
ما رأيكم بهذا إذًا؟

52
00:04:13,770 --> 00:04:18,370
إنّ مقتنيات قائدة التّابعين
.مغمورة بقوّة سيّدي التّنّين الشّرّير

53
00:04:18,520 --> 00:04:19,940
.خذوا هذه

54
00:04:20,610 --> 00:04:22,780
!شكرًا لك

55
00:04:24,590 --> 00:04:27,800
!لنرحّب بهذا الكنز المقدّس

56
00:05:01,190 --> 00:05:02,870
.اركعوا

57
00:05:04,230 --> 00:05:06,080
.انحنوا مرّة

58
00:05:08,820 --> 00:05:10,640
.انحنوا مرّتين

59
00:05:13,580 --> 00:05:15,930
.انحنوا لثالث مرّة

60
00:05:20,750 --> 00:05:23,510
!أيّ نوع من الطّقوس الغامضة؟

61
00:05:27,620 --> 00:05:31,560
.ما زال وضع الملك مجهولاً
.أسغا في خطر

62
00:05:31,710 --> 00:05:34,350
.عليك التّصرّف بحذر في الوقت الحاليّ

63
00:05:34,520 --> 00:05:36,200
...إنّ حصاد هذه السّنة

64
00:05:36,610 --> 00:05:39,190
!انظروا هناك! إنّها المنبوذة الفضّيّة

65
00:05:39,380 --> 00:05:41,120
...إنّها تلك المنبوذة

66
00:05:46,620 --> 00:05:50,320
،سيّدي التّنّين الشّرّير وسيّدتي ريكو
.سنذهب لاستعادة الحجارة الآن

67
00:05:50,460 --> 00:05:52,710
.كونوا حذرين

68
00:05:53,870 --> 00:05:55,600
!تولّينا ذلك الأمر

69
00:05:55,740 --> 00:05:57,430
.لنغادر المكان في الحال

70
00:05:57,570 --> 00:05:59,180
.بدون تحليق

71
00:05:59,780 --> 00:06:01,290
!حاضرة يا سيّدي التّنّين الشّرّير

72
00:06:02,980 --> 00:06:05,250
.أشعر وكأنّني نسيت أمرًا ما

73
00:06:09,690 --> 00:06:13,390
،يا صاحب الجلالة، أكره المقاطعة

74
00:06:14,120 --> 00:06:16,560
لكن ما الّذي تفعله؟

75
00:06:16,740 --> 00:06:21,300
.أستعدّ للموت لكي لا أسبّب أيّ مشاكل

76
00:06:21,620 --> 00:06:23,440
.هذا المكان هو قبري

77
00:06:23,590 --> 00:06:25,940
!لقد فقد عقله بالكامل

78
00:06:27,280 --> 00:06:29,740
.لقد اكتشفنا ما الّذي يحدث هنا بالفعل

79
00:06:29,880 --> 00:06:32,950
ألا تريد شرح الوضع لشعبك؟

80
00:06:33,480 --> 00:06:35,970
لا يمكنني. ألم أخبرك؟

81
00:06:36,580 --> 00:06:39,660
.أريد منك أن تقتلني

82
00:06:39,830 --> 00:06:42,670
ثانية! لماذا تريد الموت؟

83
00:06:42,830 --> 00:06:45,630
.لأنّي فشلت في مهمّتي

84
00:06:45,840 --> 00:06:48,380
.لكنّنا وجدنا منظّمة الدّم الأسود

85
00:06:50,760 --> 00:06:52,050
.ذلك ليس كافيًا

86
00:06:52,200 --> 00:06:54,140
!وجدتها! تابعك الغامض

87
00:06:54,290 --> 00:06:57,220
لم نعثر بعد على الشّخص
!الّذي يدّعي أنّه تابعك

88
00:06:57,920 --> 00:07:02,150
.سيكون العثور عليه صعبًا بلا أدنى شكّ

89
00:07:03,580 --> 00:07:05,730
هل تريد البحث عنه معًا؟

90
00:07:05,900 --> 00:07:07,100
...ذلك

91
00:07:07,230 --> 00:07:09,400
كيف تجرؤ على استعمال قوّة
!سيّدي التّنّين الشّرّير؟

92
00:07:09,550 --> 00:07:11,410
!سأقتلك الآن إن كانت تلك أمنيتك

93
00:07:12,540 --> 00:07:14,240
!توقّفي

94
00:07:19,840 --> 00:07:21,920
،يا سيّدي التّنّين الشّرّير
هل من تعليمات أخرى؟

95
00:07:24,670 --> 00:07:28,760
!ما الّذي تفعلينه؟
!من أخبرك أن تقتليني بالفعل؟

96
00:07:30,350 --> 00:07:32,680
ما غايتك بالضبط؟

97
00:07:33,600 --> 00:07:35,530
.أعتذر على الارتباك

98
00:07:35,810 --> 00:07:38,520
.أريد تزييف موتي باستعمال قوّتك فحسب

99
00:07:39,270 --> 00:07:41,840
.لست الشّخص المناسب لأكون ملكًا

100
00:07:42,050 --> 00:07:44,840
ومن أجل هذا البلد، أودّ أن أزيّف موتي

101
00:07:44,970 --> 00:07:47,440
.وأسمح لأحد آخر بالجلوس على العرش

102
00:07:47,590 --> 00:07:51,060
،لكن إن كان هنالك مرشّحون واعدون آخرون

103
00:07:51,200 --> 00:07:53,630
ألا يمكنك التّنازل عن الحكم ببساطة؟

104
00:07:53,770 --> 00:07:55,840
.لا داعي لتزييف موتك

105
00:07:55,980 --> 00:07:59,240
.لطالما كان التّاج رمزًا لملك أسغا لأجيال

106
00:07:59,850 --> 00:08:02,560
من اللّحظة الّتي يجلس فيها
،على العرش ويضع هذا التّاج

107
00:08:02,700 --> 00:08:05,220
.يصير الملك مرتبطًا به

108
00:08:05,580 --> 00:08:09,710
وفقط عندما يموت الملك، يترك التّاج
.رأسه ويُعطى للملك الجديد

109
00:08:10,300 --> 00:08:12,080
،جرّبتُ عدّة طرق مختلفة

110
00:08:12,360 --> 00:08:14,560
.لكنّي لم أستطع خداع التّاج

111
00:08:18,350 --> 00:08:20,600
.لكنّي التقيت بك أخيرًا

112
00:08:22,740 --> 00:08:26,440
التّنّين الشّرّير ريفنديا
!الّذي يجمع أرواح البشر

113
00:08:26,640 --> 00:08:29,860
هلاّ قمت بإزالة روحي من جسدي بقوّتك

114
00:08:30,020 --> 00:08:32,510
وتخدع التّاج عن طريق جعلي
...في حالة بين الحياة والموت

115
00:08:32,640 --> 00:08:33,910
!كفاك سخافة

116
00:08:34,080 --> 00:08:38,450
وحدهم المختارون بإمكانهم تقديم
!أرواحهم. أنت لست جديرًا بذلك

117
00:08:38,630 --> 00:08:40,550
،إضافة لهذا، حسب سيّدي التّنّين الشّرّير

118
00:08:40,680 --> 00:08:43,580
.فإنّه راض بالكامل بروحي أنا فقط

119
00:08:44,570 --> 00:08:48,680
يا صاحب الجلالة، ألا توجد
طريقة أخرى لإزالة التّاج؟

120
00:08:49,980 --> 00:08:54,320
.إنّ هذا التّاج ينتمي للسّاحر العظيم برافاس

121
00:08:54,640 --> 00:08:57,260
.إنّه يحتوي الكثير من القوّة السّحريّة

122
00:08:57,500 --> 00:09:01,970
،بمجرّد أن يوضع على رأس الملك
.لا يمكن إزالته حتّى يموت

123
00:09:02,370 --> 00:09:05,320
!حتّى أنّ عليّ الاحتفاظ بهذه التّسريحة للأبد

124
00:09:05,640 --> 00:09:07,660
،قلتُ أنّي لم أرد هذا

125
00:09:07,910 --> 00:09:11,010
.لكنّي لم أستطع مجابهة أوامر الملك السّابق

126
00:09:11,490 --> 00:09:13,780
.لا يوجد ما يمكنني فعله

127
00:09:14,550 --> 00:09:17,320
.لكنّي ما عدت أتحمّل

128
00:09:19,030 --> 00:09:20,740
.حسنًا. ها قد نزعتُه

129
00:09:27,550 --> 00:09:31,040
!سامح ريكو رجاءً

130
00:09:31,480 --> 00:09:33,460
أنا لا أحلم، صحيح؟

131
00:09:33,760 --> 00:09:36,470
!شكرًا جزيلاً! لقد أنقذتني

132
00:09:39,510 --> 00:09:43,140
.على أيّ حال، أنا مسرور لأنّ مشكلتك قد حلّت

133
00:09:44,020 --> 00:09:48,060
كلّ ما بقي هو وضع هذا التّاج على
!رأس أختي وسأتذوّق الحرّيّة ثانية

134
00:09:48,200 --> 00:09:50,820
تريد أن تورث العرش لأختك؟

135
00:09:51,780 --> 00:09:54,070
.روزيتّا استثنائيّة

136
00:09:54,210 --> 00:09:56,320
هل هي طفلة مميّزة؟

137
00:09:57,290 --> 00:09:58,930
.إنّها قصّة طويلة

138
00:09:59,070 --> 00:10:02,080
،ولكن في كلّ الأحوال
!إنّها أقوى منّي بمليون مرّة

139
00:10:02,310 --> 00:10:04,480
لذلك السّبب أعتقد

140
00:10:04,610 --> 00:10:06,980
.أنّ روزيتّا ستكون ملكًا أفضل بكثير

141
00:10:07,110 --> 00:10:09,660
...وستكون أسغا بعدها

142
00:10:07,110 --> 00:10:09,660
...ولكن يا صاحب الجلالة

143
00:10:10,380 --> 00:10:14,050
ألا يجدر بك أن تسأل عمّا تريده أختك؟

144
00:10:14,280 --> 00:10:15,300
...ذلك

145
00:10:16,340 --> 00:10:17,820
.هذا ما ظننت

146
00:10:18,090 --> 00:10:21,840
لقد عانيت لأنّهم أجبروك
.على الجلوس على العرش

147
00:10:21,980 --> 00:10:23,170
،أمّا بالنّسبة لأختك

148
00:10:23,300 --> 00:10:27,350
فأنت لا تعرف بعد إن كانت
تريد أن تصير ملكًا، صحيح؟

149
00:10:27,580 --> 00:10:30,500
عليك التّفكير في الأمر أكثر

150
00:10:30,640 --> 00:10:33,550
.لكي لا تكرّر نفس الخطأ

151
00:10:36,300 --> 00:10:37,380
.حسنًا

152
00:10:37,940 --> 00:10:39,620
.سأسأل أختي

153
00:10:40,060 --> 00:10:42,740
!لكن كلّي ثقة أنّها ستوافق

154
00:10:43,810 --> 00:10:45,910
.سيكون ذلك مثاليًّا

155
00:10:55,100 --> 00:10:56,980
!سيّدي التّنّين الشّرّير، سأساعدك

156
00:11:00,180 --> 00:11:03,460
.هذا مكبّ النّفايات خلف القصر

157
00:11:04,010 --> 00:11:08,310
إذًا فمنظّمة الدّم الأسود كانت
.تتجوّل هنا بكلّ جرأة

158
00:11:15,900 --> 00:11:20,400
.لن تعود أختي الضّعيفة أبدًا
.عليّ أن آخذ مكانها

159
00:11:20,950 --> 00:11:22,350
،ابتداءً من اليوم

160
00:11:22,490 --> 00:11:26,280
.سأصير أنا الملك الجديد

161
00:11:35,020 --> 00:11:39,630
واضح وضوح الشّمس أنّ أختي تحبّ
!أن تحكم! ليس لديّ ما أقلق حياله

162
00:11:39,870 --> 00:11:44,070
!بدا لي ذلك كسبب كبير لتقلق حياله