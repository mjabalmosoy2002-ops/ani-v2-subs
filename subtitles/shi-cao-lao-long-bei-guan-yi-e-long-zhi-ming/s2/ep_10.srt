أتعتقد أنّ بإمكانك خدمة التّنّين الشّرّير
!بقدرتك على التّحمّل الواهنة هذه؟

6
00:00:44,600 --> 00:00:49,130
.يا سيّدتي ريكو، إنّ ألف تمرين بطن كثير جدًّا

7
00:00:49,270 --> 00:00:51,520
.لا أملك القوّة حتّى لأجلس الآن

8
00:00:51,660 --> 00:00:52,690
.هذا مستحيل

9
00:00:58,390 --> 00:01:01,220
!زلزال! اهربوا

10
00:01:03,000 --> 00:01:05,580
ستكون هذه فرصة مثاليّة
.لبعض التّمرين العمليّ

11
00:01:16,050 --> 00:01:19,260
تنّين عاشب عمره 5000 سنة يُعامَل"
"كشرّير بشكل غير عادل - الموسم 2

12
00:02:36,900 --> 00:02:39,860
!فكّا وثاقي في الحال

13
00:02:40,000 --> 00:02:44,930
سأستعمل قوّة التّنّين الشّرّير
!لإعادة مجد أسغا

14
00:02:45,710 --> 00:02:47,200
.سنكون بأمان الآن

15
00:02:47,400 --> 00:02:49,520
.بإمكان إعادة الأمن لسابق عهده

16
00:02:55,990 --> 00:02:57,230
ما هذا؟

17
00:03:05,040 --> 00:03:06,680
!ماذا يجري؟

18
00:03:06,820 --> 00:03:08,020
ما الّذي يحدث؟

19
00:03:20,080 --> 00:03:22,610
.القليل فحسب

20
00:03:31,480 --> 00:03:32,720
.إنّه تنّين

21
00:03:33,460 --> 00:03:36,570
.اعتقدتُ أنّ قوّتك السّحريّة كانت ضروريّة لذلك

22
00:03:36,800 --> 00:03:41,230
!كيف يجرؤون؟! ذلك التّنّين ليس كاملاً

23
00:03:42,420 --> 00:03:43,660
!تحدّث بوضوح

24
00:03:43,990 --> 00:03:45,700
!أزيلي هذه الكمامة عنّي إذًا

25
00:03:46,450 --> 00:03:49,840
.إنّك فظّة كعادتك يا أختي

26
00:03:53,920 --> 00:03:55,120
!روزيتّا

27
00:03:55,580 --> 00:03:57,760
!ساعديني يا روزيتّا

28
00:03:58,090 --> 00:04:01,320
.استمعي لي. هذا ليس السّيّد برافاس

29
00:04:01,530 --> 00:04:02,910
.إنّه محتال

30
00:04:03,580 --> 00:04:07,330
إنّ برافاس المزيّف عبارة
.عن وحش آكل للجثث فحسب

31
00:04:07,480 --> 00:04:10,980
.شاهدتُه يتحوّل من هيئته كهيكل عظميّ

32
00:04:11,770 --> 00:04:15,540
!هراء! حرّريني بسرعة! أنا برافاس الحقيقيّ

33
00:04:15,680 --> 00:04:18,150
—تحتاجين لقوّتي لاستدعاء الـ

34
00:04:18,500 --> 00:04:21,710
.يبدو أنّ ذكرياته لا تزال مشوّشة

35
00:04:32,900 --> 00:04:34,280
!انتبهي يا صاحبة الجلالة

36
00:04:36,020 --> 00:04:37,290
ما الّذي تفعلينه؟

37
00:04:43,450 --> 00:04:45,050
.أحسنت

38
00:04:46,320 --> 00:04:48,350
ترفضين تصديقي؟

39
00:04:48,490 --> 00:04:50,430
.أنت لا تفهمين بالفعل

40
00:04:51,010 --> 00:04:53,810
.لا يهمّ إن كان الحقيقيّ أم لا

41
00:04:57,560 --> 00:05:01,690
.لستُ متشوّقة لإثارة إعجاب أيّ أحد

42
00:05:02,060 --> 00:05:04,240
.لا أهتمّ بأيّ من ذلك

43
00:05:05,540 --> 00:05:07,250
...أنا أتنبّأ

44
00:05:07,400 --> 00:05:12,190
أنّه في يوم ما، سيُولد شخص ما
.يشبه السّيّد برافاس في مكان ما

45
00:05:12,350 --> 00:05:18,630
سيكون كائنًا شرّيرًا سيجلب
!سوء الحظّ لأسغا

46
00:05:18,760 --> 00:05:21,870
.وُلدت وعليّ وصمة الشّرّ

47
00:05:22,620 --> 00:05:26,600
في البداية، عملتُ للتّخلّص
.من تلك الأحكام المسبقة

48
00:05:27,100 --> 00:05:28,950
.لكن كان ذلك هباءً

49
00:05:30,140 --> 00:05:32,590
،لا يتحدّث أيّ أحد عنها علنًا

50
00:05:32,730 --> 00:05:35,040
.لكنّها تظلّ متجذّرة عميقًا بداخلهم

51
00:05:36,620 --> 00:05:38,530
.هكذا هم البشر

52
00:05:39,010 --> 00:05:42,220
عندما يواجهون شيئًا قويًّا
،بشكل لا يمكنهم تصوّره

53
00:05:42,370 --> 00:05:45,040
.يرفضونه بشكل غريزيّ

54
00:05:48,170 --> 00:05:52,130
وذات يوم، عرفت بشأن التّنّين الشّرّير
.من أحد الكتب

55
00:05:55,610 --> 00:05:58,570
.كان التّنّين الشّرّير كائنًا وحيدًا أيضًا

56
00:05:58,720 --> 00:06:01,170
.لكنّ قوّته كانت لا مثيل لها

57
00:06:01,830 --> 00:06:06,280
،وعندما يسعى المرء لمُثل أعظم
.فلا حاجة لاعتبار الضّعفاء

58
00:06:06,980 --> 00:06:09,510
.على الأقوياء أن يكونوا وحيدين دائمًا

59
00:06:10,470 --> 00:06:12,730
.لذلك اتّخذتُ قراري

60
00:06:13,810 --> 00:06:16,590
.لستُ بحاجة ليفهمني أيّ أحد

61
00:06:16,720 --> 00:06:18,350
.لا أحتاج لمساعدة أيّ أحد

62
00:06:18,620 --> 00:06:24,070
سأصبح أقوى وأصير شيئًا
!على شاكلة التّنّين الشّرّير

63
00:06:24,190 --> 00:06:27,400
.علّمها ذلك الكتاب الدّرس الخطأ

64
00:06:27,530 --> 00:06:32,620
سرقتُ التّاج والحجارة السّحريّة
.لأستطيع إعادة إحياء التّنّين الشّرّير

65
00:06:32,790 --> 00:06:36,670
.لا أهتمّ إن كان هذا الشّيء وحشًا بالفعل

66
00:06:37,450 --> 00:06:40,500
.ما دام مفيدًا لي، فلا أهتمّ إن كان مزيّفًا

67
00:06:52,220 --> 00:06:53,940
ما كلّ هذا الضّجيج؟

68
00:06:56,410 --> 00:06:57,640
!تنّين شرّير

69
00:07:08,810 --> 00:07:11,410
.يبدو أنّ الأمر قد نجح

70
00:07:11,530 --> 00:07:16,160
.جيّد. أستطيع الآن أن أعيش على حقيقتي

71
00:07:27,580 --> 00:07:29,090
.ضربتني

72
00:07:29,210 --> 00:07:33,720
.أنا أحبّك كأختي الصّغيرة

73
00:07:33,900 --> 00:07:38,310
!لكنّي لن أسمح لك بإلحاق الأذى بشعب أسغا

74
00:07:38,680 --> 00:07:43,040
هل أخذت في حسبانك الضّرر
الّذي سيسبّبه التّنّين الشّرّير للنّاس؟

75
00:07:43,350 --> 00:07:47,690
.لا أستطيع أن أغفر لهذا حتّى إن كنت أختي

76
00:07:53,730 --> 00:07:54,950
!يا صاحبة الجلالة

77
00:07:55,890 --> 00:07:57,740
.هذه حالة طارئة

78
00:08:01,200 --> 00:08:05,330
سيّدي التّنّين الشّرّير، هلاّ أعرتني قوّتك؟

79
00:08:05,650 --> 00:08:08,920
.تردّ أسغا ديونها دائمًا

80
00:08:09,360 --> 00:08:10,590
من؟ أنا؟

81
00:08:10,800 --> 00:08:13,580
.إدوارد، أخلوا المكان

82
00:08:13,710 --> 00:08:14,550
.حاضر

83
00:08:15,760 --> 00:08:16,780
!بسرعة

84
00:08:29,650 --> 00:08:31,550
.تحبّينني كأختك الصّغيرة

85
00:08:32,200 --> 00:08:34,950
.لم تدركي حتّى أنّ التّاج مفقود

86
00:08:38,620 --> 00:08:40,790
!بسرعة! من هنا

87
00:08:43,670 --> 00:08:44,940
!اهدؤوا

88
00:08:45,370 --> 00:08:47,480
!اتّبعوا التّعليمات لإخلاء المدينة

89
00:08:47,630 --> 00:08:50,050
!سنضمن سلامتكم جميعًا

90
00:08:50,180 --> 00:08:51,370
...صاحبة الجلالة

91
00:08:56,050 --> 00:08:58,390
!أيفترض بنا إيقاف ذلك الشّيء؟

92
00:09:02,390 --> 00:09:04,100
!ريكو

93
00:09:11,710 --> 00:09:13,900
.آسفة على التّأخير يا سيّدي التّنّين الشّرّير

94
00:09:14,740 --> 00:09:17,180
...ريكو

95
00:09:17,940 --> 00:09:20,680
...سيّدتي ريكو، سيّدي التّنّين الشّرّير

96
00:09:21,480 --> 00:09:23,110
أنتم أيضًا؟

97
00:09:23,250 --> 00:09:27,500
كنّا نتدرّب مع السّيّدة ريكو
.لهزيمة المزيّف

98
00:09:28,510 --> 00:09:30,100
ستجعلينهم يقاتلون؟

99
00:09:30,220 --> 00:09:34,600
