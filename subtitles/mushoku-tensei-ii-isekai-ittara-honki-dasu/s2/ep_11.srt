1
00:00:00,000 --> 00:00:03,480
سأسْعَى جَاهِدًا لو وُلِدتُ مِن جَديد

2
00:00:00,000 --> 00:00:03,480
مِن جَديد سأسْعَى جَاهِدًا لو وُلِدتُ

3
00:00:00,000 --> 00:00:03,480
II عَــاطِــلٌ تَــنَــاسَــخَ

4
00:00:00,000 --> 00:00:03,480
II ـخَسَــاـنَـتَـ ـلٌطِــاعَـ

5
00:00:11,800 --> 00:00:16,230
‫هل شعر والدايَ بالقلق عليَّ آنذاك؟

6
00:00:16,800 --> 00:00:21,610
‫ما كانت مشاعرهما نحوي وهما على شفا الموت؟

7
00:00:22,370 --> 00:00:24,080
‫لا أعرف الحقيقة.

8
00:00:24,540 --> 00:00:29,370
‫لم أحضر جنازتهما أو أجمع رمادهما.

9
00:00:29,370 --> 00:00:31,280
‫ماذا كُنتُ أفعل؟

10
00:00:32,570 --> 00:00:37,240
‫أشعر بالحزن لأنَّني لم أُحِبَّ والدايَ كما ينبغي في الماضي.

11
00:00:38,020 --> 00:00:42,190
‫لكن أما كان عليَّ حضور جنازتهما على الأقل؟

12
00:00:42,810 --> 00:00:46,340
‫أما كان عليَّ رؤية وجهيهما بعد الموت؟

13
00:00:56,340 --> 00:01:00,960
‫إن أردتَ حماية أحد، لكان لزامًا عليكَ حماية نورن أو عائشة،

14
00:01:01,570 --> 00:01:03,240
‫لا شخصًا مُزيَّفًا مثلي.

15
00:01:04,650 --> 00:01:07,020
‫وهذا ينطبق على زينيث وليليا.

16
00:01:08,320 --> 00:01:11,120
‫لماذا تركتَ أربعتهُنَّ ورحلت؟

17
00:01:12,110 --> 00:01:15,340
‫ألم يكُنَّ دُنياكَ وما فيها؟

18
00:01:16,120 --> 00:01:19,170
‫ماذا عسايَ أفعل من الآن فصاعدًا؟

19
00:01:20,010 --> 00:01:21,940
‫أخبرني يا باول.

20
00:01:23,680 --> 00:01:27,230
‫أنتَ ابنٌ يُعتمد عليه حقًا.

21
00:01:28,970 --> 00:01:32,970
‫ظننتُ أنِّي لستُ ابن باول،

22
00:01:33,740 --> 00:01:36,270
‫لكنَّه كان والدي.

23
00:01:52,730 --> 00:01:55,090
‫هل لي بطلبٍ بسيطٍ يا رودي؟

24
00:01:58,060 --> 00:01:59,770
‫مُعلِّمتي.

25
00:02:00,140 --> 00:02:03,740
‫هلَّا رافقتني في نُزهةٍ لتغيير هذا الجو.

26
00:02:03,740 --> 00:02:04,570
‫ماذا؟

27
00:02:04,570 --> 00:02:08,920
‫توجد الكثير من الأماكن التي أُريد رؤيتها في هذه المدينة.

28
00:02:08,920 --> 00:02:12,740
‫كما فعلنا في ذلك اليوم.

29
00:02:13,590 --> 00:02:16,520
‫لا، لستُ في حالةٍ تسمح بذلك.

30
00:02:17,080 --> 00:02:19,450
‫هـ-هكذا إذًا.

31
00:02:20,740 --> 00:02:22,040
‫آسف.

32
00:02:36,270 --> 00:02:37,630
‫المعذرة.

33
00:02:44,040 --> 00:02:47,440
‫ما أصاب باول وزينيث أمرٌ مُحزن.

34
00:02:47,950 --> 00:02:53,060
‫أحتفظ بذكرياتٍ جميلةٍ عن حياتنا معًا في بوينا.

35
00:02:53,590 --> 00:02:58,110
‫رُبَّما كانت تلك أسعد أوقات حياتي.

36
00:03:01,990 --> 00:03:07,900
‫عندما تُغامر، فقد يطال الموت بعض المُقرَّبين منك.

37
00:03:07,900 --> 00:03:09,410
‫أعي صعوبة هذا.

38
00:03:10,000 --> 00:03:12,420
‫قاسيتُ هذا الأمر من قبل.

39
00:03:13,410 --> 00:03:15,790
‫كُفِّي عن الكذب من فضلكِ.

40
00:03:16,400 --> 00:03:19,790
‫والداكِ بخير.

41
00:03:20,870 --> 00:03:26,110
‫معكَ حق، لم ألتقِ بهما منذ بضعة سنوات،

42
00:03:26,110 --> 00:03:27,640
...‫لكن كلاهما

43
00:03:27,050 --> 00:03:28,770
‫لا تَعِينَ الأمر إذًا!

44
00:03:28,770 --> 00:03:31,460
‫لا تتظاهري بذلك!

45
00:03:33,380 --> 00:03:34,730
‫أدركتُ شيئًا.

46
00:03:35,510 --> 00:03:39,730
‫ظننتُ أنِّي بدأتُ مُجدَّدًا، وأنِّي أُحسِنُ القيام بالأمور.

47
00:03:40,190 --> 00:03:44,640
‫لكنِّي كُنتُ أتجاهل جُزءًا مِما يُهِمُّ حقًا!

48
00:03:45,330 --> 00:03:48,220
‫أغمضتُ عيني عن صِداماتي مع عائلتي،

49
00:03:48,220 --> 00:03:51,500
‫واقترفتُ الأخطاء ذاتها التي لا رجعة فيها!

50
00:03:57,080 --> 00:03:59,470
‫ظننتُ أنِّي تغيَّرت.

51
00:03:59,470 --> 00:04:03,150
‫لكنِّي بقيتُ على حالي في النهاية.

52
00:04:05,520 --> 00:04:09,840
‫عِشتُ حياةً سعيدةً حقًا في بوينا.

53
00:04:09,840 --> 00:04:17,120
‫كُنتَ مُفعمًا بالموهبة، وباول وزينيث كانا مثالاً للطف معي.

54
00:04:17,770 --> 00:04:22,540
‫تعلَّمتُ منكم معنى الدفء الأسريِّ الحقيقي.

55
00:04:24,890 --> 00:04:29,330
‫باول وزينيث بمثابة عائلةٍ ثانيةٍ لي.

56
00:04:36,930 --> 00:04:41,540
‫لذا... أُريد مُشاركة الحزن الذي يُثقل كاهلك،

57
00:04:41,950 --> 00:04:42,930
‫رودي.

58
00:04:48,180 --> 00:04:51,310
‫قد أكون مُعلِّمةً فاشلةً وضئيلة الحجم،

59
00:04:51,310 --> 00:04:57,780
‫لكنِّي عِشتُ أطول مِنكَ وخبرتُ دروب الحياة.

60
00:04:57,780 --> 00:05:02,400
‫أعلم أنَّ الأمر مؤلم، لكن ستُخفِّفُ المُشاركة من وطأته.

61
00:05:05,370 --> 00:05:06,190
‫رودي!

62
00:05:20,990 --> 00:05:22,180
‫لا تقلق.

63
00:05:24,630 --> 00:05:28,180
‫اترك كُلَّ شيءٍ لي الآن.

64
00:06:12,080 --> 00:06:15,140
‫صباح الخير يا رودي.

65
00:06:16,410 --> 00:06:18,510
‫صباح النور.

66
00:06:19,520 --> 00:06:23,270
‫هل تشعر بتحسُّنٍ قليلاً؟

67
00:06:25,600 --> 00:06:26,640
‫أجل.

68
00:06:35,730 --> 00:06:40,160
‫هل لي أن أسألكِ سؤالاً غريبًا يا مُعلِّمتي؟

69
00:06:40,630 --> 00:06:41,500
‫تفضَّل.

70
00:06:42,120 --> 00:06:45,380
‫ماذا عليَّ أن أفعل الآن؟

71
00:06:48,130 --> 00:06:52,600
‫عليكَ الاعتناء بالعائلة التي تملكها الآن.

72
00:06:53,290 --> 00:06:57,250
‫لا بُدَّ أنَّ هذا ما يُريده باول أيضًا.

73
00:06:57,820 --> 00:07:01,890
‫انظر إلى الأمام، فالجميع بانتظارك.

74
00:07:03,570 --> 00:07:04,660
‫حاضر.

75
00:07:08,010 --> 00:07:09,270
‫مُعلِّمتي،

76
00:07:09,710 --> 00:07:11,440
‫شكرًا جزيلاً.

77
00:07:13,540 --> 00:07:14,400
‫لا عليك.

78
00:07:27,210 --> 00:07:29,420
‫روكسي، أنتِ...

79
00:07:30,630 --> 00:07:35,680
‫آسفةٌ يا رودي، لكن عليَّ التحدُّث مع إليناليسي.

80
00:07:36,030 --> 00:07:38,720
‫هلَّا ذهبتَ إلى ليليا لوحدك.

81
00:07:39,240 --> 00:07:40,580
‫حسنًا.

82
00:08:00,760 --> 00:08:02,120
‫ليليا.

83
00:08:02,120 --> 00:08:04,570
‫ماذا تريد يا سيِّدي روديوس؟

84
00:08:04,570 --> 00:08:08,340
‫آسفٌ لترك أُمِّي في رعايتِكِ لوحدكِ.

85
00:08:08,720 --> 00:08:11,480
‫لا تعتذر، هذا عملي.

86
00:08:13,620 --> 00:08:15,910
‫كيف حالُها؟

87
00:08:15,910 --> 00:08:20,670
‫لا يبدو أنها تتذكرُ شيئًا، لكنها على ما يُرام جسديًا بشكلٍ غير مُتوقع.

88
00:08:20,670 --> 00:08:22,600
‫لا أثر لأيِّ أعراضٍ جانبيَّةٍ غريبة.

89
00:08:23,010 --> 00:08:24,320
‫هكذا إذًا.

90
00:08:25,950 --> 00:08:32,460
‫هذا يعني أنَّها فقدت ذاكرتها، لكنَّها لم تمت عقليًّا.

91
00:08:32,460 --> 00:08:39,440
‫تشكُّ شيرا أنَّ احتجازها داخل بِلَّورة طاقةٍ قد تسبَّب لها بهذه الإعاقة السحريَّة.

92
00:08:41,520 --> 00:08:43,170
‫هل ستتعافى؟

93
00:08:45,130 --> 00:08:48,070
‫إن صدقت كلمات إليناليسي،

94
00:08:48,070 --> 00:08:49,840
‫فهذا مُستحيل.

95
00:08:53,710 --> 00:08:57,100
‫لقد أحسنت السيِّدة إلي.

96
00:08:57,100 --> 00:09:02,340
‫سأعتني بها الآن بعد رحيل سيِّدي.

97
00:09:02,630 --> 00:09:05,840
‫أريد فعل ما بوسعي أيضًا.

98
00:09:05,840 --> 00:09:07,510
‫لا داعي لذلك.

99
00:09:07,510 --> 00:09:08,360
‫ماذا؟

100
00:09:08,640 --> 00:09:12,720
‫أُدركُ أنِّي أتجاوز حدودي يا سيِّد روديوس،

101
00:09:12,720 --> 00:09:17,110
‫لكن هل تسمح لي بقول شيءٍ غير مُهذَّبٍ قليلاً؟

102
00:09:17,110 --> 00:09:18,310
‫تفضَّلي.

103
00:09:20,120 --> 00:09:22,960
‫اهتمَّ بشؤونك.

104
00:09:23,250 --> 00:09:25,970
‫شؤوني؟

105
00:09:25,970 --> 00:09:28,450
‫هذا ما كان ليقوله السيِّد أيضًا.

106
00:09:28,780 --> 00:09:34,970
‫الاعتناء بالسيِّدة هو واجبي، هذا سبب وجودي هنا.

107
00:09:41,390 --> 00:09:42,600
‫لنعُد إلى الديار.

108
00:09:43,240 --> 00:09:44,750
‫إلى عائلتنا.

109
00:11:00,940 --> 00:11:03,430
‫المعذرة يا مُعلِّمتي؟

110
00:11:03,430 --> 00:11:05,690
‫ما الأمر يا رودي؟

111
00:11:07,450 --> 00:11:11,000
‫بصراحة، أنا أُحِبُّ روكسي.

112
00:11:11,550 --> 00:11:17,230
‫ليس كما أُحِبُّ سيلفي تمامًا، لكن لا أستطيع أن أُحدِّدَ أيُّهما أُحِبُّ أكثر.

113
00:11:17,600 --> 00:11:19,170
‫لذا أنا مُحتار.

114
00:11:19,170 --> 00:11:23,050
‫أُحِبُّ سيلفي وأُحِبُّ روكسي أيضًا.

115
00:11:23,760 --> 00:11:27,630
‫لكنّي وعدتُ سيلفي بالبقاء وفيًا.

116
00:11:28,120 --> 00:11:30,240
‫لا يُمكنني كسر هذا الوعد.

117
00:11:31,020 --> 00:11:38,040
‫في الحقيقة، أنا مُتزوِّجٌ بالفعل، وفي انتظار مولودٍ أيضًا.

118
00:11:38,510 --> 00:11:44,640
‫لذا، لا أعتقد أنَّه من اللائق التصرُّف كحبيبين.

119
00:11:45,290 --> 00:11:46,870
‫أعلم.

120
00:11:46,870 --> 00:11:53,510
‫أخبرتني إليناليسي بذلك بعد موت باول عندما كُنَّا قلقين عليك.

121
00:11:53,870 --> 00:11:55,520
‫إذًا، لماذا...

122
00:11:57,380 --> 00:11:59,870
‫لا يجب أن تلوم نفسك.

123
00:12:00,270 --> 00:12:04,260
‫انتهزتُ ضعفكَ عندما كُنتَ مُنهارًا.

124
00:12:04,260 --> 00:12:06,230
‫كان ذلك قرارًا اتَّخذتُه بنفسي.

125
00:12:06,680 --> 00:12:11,550
‫أعلم أنَّكَ لن ترغب بفتاةٍ مثلي في الظروف العاديَّة.

126
00:12:11,550 --> 00:12:13,220
‫هذا ليس...

127
00:12:14,800 --> 00:12:16,640
‫لا تقلق.

128
00:12:16,640 --> 00:12:20,950
‫سأكون يدكَ اليُسرى طوال هذه الرحلة.

129
00:12:21,330 --> 00:12:25,600
‫وعندما تعود، كرِّس اهتمامكَ لزوجتِك.

130
00:12:27,180 --> 00:12:31,100
‫ألن تسمحي لي بردِّ جميلكِ بطريقةٍ ما؟

131
00:12:31,100 --> 00:12:33,360
‫ردُّ جميلي؟

132
00:12:33,360 --> 00:12:36,820
‫أجل، بأيِّ طريقةٍ أقدر عليها.

133
00:12:37,990 --> 00:12:41,160
‫حسنًا، في هذه الحالة...

134
00:12:41,160 --> 00:12:43,690
‫هلَّا استمعتَ لِعُذري.

135
00:12:43,690 --> 00:12:46,100
‫عُذركِ؟

136
00:12:46,100 --> 00:12:47,940
‫استمع إليَّ فحسب.

137
00:12:47,940 --> 00:12:50,110
‫حسنًا، فهمت.

138
00:12:52,050 --> 00:12:55,500
‫وقعتُ في الحُبِّ من أوَّلِ نظرة.

139
00:12:55,500 --> 00:12:56,820
حُبِّ من؟

140
00:12:58,750 --> 00:13:00,410
‫أنتَ يا رودي.

141
00:13:00,410 --> 00:13:03,260
‫عندما أنقذتَني في المتاهة.

142
00:13:03,260 --> 00:13:04,320
‫أنا؟

143
00:13:04,320 --> 00:13:08,360
‫ سيخفق قلبُ أيّ فتاةٍ آنذاك.

144
00:13:09,160 --> 00:13:11,670
‫كُنتَ تُجسِّدُ كُلَّ ما أُريده.

145
00:13:12,040 --> 00:13:16,480
‫حتَّى عندما كُنَّا نستكشف المتاهة، لم أستطع إبعاد ناظري عنك.

146
00:13:17,250 --> 00:13:19,280
‫لكنَّكِ لم تنظري إليَّ مُباشرةً.

147
00:13:19,280 --> 00:13:22,970
‫لأنَّ... ذلك مُحرجٌ جِدًا.

148
00:13:24,010 --> 00:13:26,490
‫ظننتُ أنَّ لا أمل لي.

149
00:13:26,490 --> 00:13:32,230
‫إليناليسي وغيس قالا إنَّكَ ستتعافى بمفردك،

150
00:13:32,620 --> 00:13:36,640
‫لكنِّي تذكَّرتُ أيَّامنا في بوينا...

151
00:13:41,190 --> 00:13:45,700
‫بالطبع، سمعتُ أنَّ قلبكَ مُعلَّقٌ بأخرى،

152
00:13:45,700 --> 00:13:50,260
‫وأنا على يقينٍ بأنَّها ستُساعدكَ على النهوض مُجدَّدًا مهما بلغت حالتُكَ سوءًا.

153
00:13:50,780 --> 00:13:55,470
‫لكنَّها ليست هنا الآن.

154
00:13:55,470 --> 00:14:00,540
‫لذا، من الطبيعيِّ أن أُفكِّرَ في حاجتِكَ لمن يُساعدك.

155
00:14:00,940 --> 00:14:05,560
‫لكن إليناليسي وغيس خطَّطا لترككَ وحيدًا،

156
00:14:05,560 --> 00:14:09,570
‫وليليا مشغولةٌ مع زينيث.

157
00:14:10,100 --> 00:14:13,790
‫لذا لم يكن أمامي سوى التدخُّل.

158
00:14:14,800 --> 00:14:16,970
‫أكان لديَّ خيارٌ آخر؟

159
00:14:18,380 --> 00:14:20,000
‫أنا أُحِبُّك.

160
00:14:24,700 --> 00:14:28,220
‫هذا فظيع! غير مقبولٍ بتاتًا!

161
00:14:29,100 --> 00:14:31,090
‫المعذرة يا مُعلِّمتي؟

162
00:14:33,780 --> 00:14:35,090
‫نعم؟

163
00:14:35,960 --> 00:14:39,860
‫طوال فترة رحلتنا على الأقل...

164
00:14:39,860 --> 00:14:44,340
‫ما نفع ذلك؟ لن يُغيَّر من الأمر شيئًا.

165
00:14:44,340 --> 00:14:47,040
‫لا بالنسبة لي ولا بالنسبة لروكسي.

166
00:14:55,290 --> 00:14:57,900
‫توقَّف، كفاكَ من ذلك.

167
00:14:58,390 --> 00:15:00,720
‫لا أُريد منكَ فعل أيِّ شيء.

168
00:15:02,920 --> 00:15:04,430
‫حسنًا.

169
00:15:21,580 --> 00:15:24,430
‫يُمكنكم خلع عصابة العينين الآن.

170
00:15:27,420 --> 00:15:29,310
‫أين نحن يا رودي؟

171
00:15:29,710 --> 00:15:32,140
‫في غابةٍ بالقرب من شاريا.

172
00:15:32,140 --> 00:15:36,350
‫لا أُصدِّق هذا، هل وصلنا إلى الأراضي الشماليَّة حقًا؟

173
00:15:36,350 --> 00:15:40,050
‫لا عجب أنَّكَ وصلتَ إلى رابان بسرعةٍ أيُّها الزعيم!

174
00:15:40,050 --> 00:15:43,460
‫لا تُخبروا أحدًا بهذا من فضلكم.

175
00:15:43,460 --> 00:15:44,110
‫بالطبع.

176
00:15:44,490 --> 00:15:47,640
‫حسنًا، سنتقدَّم أنا وإليناليسي.

177
00:16:02,550 --> 00:16:03,820
‫روديوس.

178
00:16:03,820 --> 00:16:04,700
‫نعم؟

179
00:16:04,980 --> 00:16:08,570
‫هل تعبدُ ميليس؟

180
00:16:09,450 --> 00:16:10,790
‫لستُ كذلك.

181
00:16:11,160 --> 00:16:14,290
‫وسيلفي لا تعبدها أيضًا، أليس كذلك؟

182
00:16:14,290 --> 00:16:16,650
‫أجل، لا أعتقد ذلك.

183
00:16:16,970 --> 00:16:20,470
‫عزيزي كليف مُتديِّنٌ للغاية.

184
00:16:22,030 --> 00:16:29,310
‫هل تعلم أنَّه يُسمح لأتباع ميليس بزوجةٍ واحدةٍ فقط؟

185
00:16:29,710 --> 00:16:32,810
‫ومن واجبهم البقاء أوفياء لزوجاتهم طوال حياتهم.

186
00:16:32,810 --> 00:16:39,320
‫إنَّها ديانةٌ صارمة، لكنِّي سعيدةٌ بها لأنِّي مُستفيدةٌ منها.

187
00:16:40,240 --> 00:16:42,010
‫ولكن يا روديوس،

188
00:16:42,850 --> 00:16:48,850
‫لا أرى حرجًا في حُبِّ أكثر من امرأةٍ في نفس الوقت.

189
00:16:51,790 --> 00:16:55,980
‫إلامَ تُلمِّحين يا إليناليسي؟

190
00:16:56,910 --> 00:17:00,500
‫تزوَّج روكسي يا روديوس.

191
00:17:02,090 --> 00:17:04,080
‫أأنتِ جادَّةٌ في هذا؟

192
00:17:04,390 --> 00:17:07,230
‫أجل، أنا جادَّة.

193
00:17:07,230 --> 00:17:09,580
‫لا يستطيع أحدٌ قول هذا غيري.

194
00:17:10,840 --> 00:17:14,830
‫بصراحة، لا أُطيق رؤية روكسي على هذه الحال.

195
00:17:14,830 --> 00:17:20,680
‫إنَّها تتوق إلى حنانك، لكنَّها تُخطِّطُ للتنحِّي جانبًا.

196
00:17:20,680 --> 00:17:23,900
‫وهذا لأنَّها التقت بكَ في الوقت الخطأ.

197
00:17:25,630 --> 00:17:31,530
‫أريد أن تنعم روكسي ولو بقسطٍ يسيرٍ من السعادة.

198
00:17:31,530 --> 00:17:33,600
...‫لا، لكن لديَّ سيلفي

199
00:17:33,600 --> 00:17:35,860
‫ما خُطَطُكَ بالنسبة لروكسي؟

200
00:17:36,450 --> 00:17:39,020
‫أريدها أن تكون سعيدة.

201
00:17:39,020 --> 00:17:45,330
‫أودُّ لو بإمكاني جعل روكسي وسيلفي سعيدتين معًا، ولكن...

202
00:17:46,190 --> 00:17:47,920
‫أيُّ أنانيَّةٍ هذه؟

203
00:17:48,400 --> 00:17:54,120
‫تزوَّجتُ سيلفي وأنجبتُ منها وأشتهي امرأةً أُخرى الآن؟

204
00:17:55,010 --> 00:17:58,750
‫أنا الذي دَأِبتُ على وصف باول بالحُثالة،

205
00:17:58,750 --> 00:18:01,770
‫ها أنا ذا أسير على خُطاه.

206
00:18:02,260 --> 00:18:04,310
‫فكِّر مليًا.

207
00:18:04,310 --> 00:18:08,700
‫هل شعرت زينيث بالبؤس بعد زواج باول من ليليا؟

208
00:18:28,420 --> 00:18:31,570
‫انهمرت بالبكاء في البداية.

209
00:18:31,570 --> 00:18:34,000
‫هذا مفروغٌ منه.

210
00:18:34,790 --> 00:18:40,060
‫أعلم أنَّكَ قادرٌ على حُبِهما بنفس القدر.

211
00:18:40,650 --> 00:18:45,170
‫أنتَ ابن باول، من المُفترض أن تُجيد أمرًا كهذا.

212
00:18:46,370 --> 00:18:49,560
‫أنا أُحِبُّ كليهما بالفعل.

213
00:18:50,050 --> 00:18:54,760
‫لكن أعتقد أنَّ سيلفي ستحتقرني إن عُدتُ مع امرأةٍ أُخرى.

214
00:18:55,950 --> 00:18:59,720
‫وقد ترغب روكسي بأن أُحِبَّها هي فقط.

215
00:19:00,150 --> 00:19:04,660
‫ماذا لو هجرتني كلاهما وعُدتُ وحيدًا من جديد؟

216
00:19:05,150 --> 00:19:08,790
‫مع ذلك، أريد إسعادهما معًا.

217
00:19:11,500 --> 00:19:14,650
‫لكن حتَّى لو أردتُ فعل ذلك،

218
00:19:14,650 --> 00:19:19,760
‫فهذا لا يعني موافقة مُعلِّمتي وسيلفي.

219
00:19:19,760 --> 00:19:22,990
‫إذًا، اسأل روكسي الآن.

220
00:19:22,990 --> 00:19:23,710
‫ماذا؟

221
00:19:42,620 --> 00:19:45,140
‫بِمَاذا تُريد الحديث معي؟

222
00:19:46,070 --> 00:19:50,900
‫في الحقيقة، أُريد مُناقشة شيءٍ معكِ.

223
00:19:52,470 --> 00:19:53,320
‫تفضَّل؟

224
00:19:56,250 --> 00:19:59,710
‫أنقذتني تعاليمُكِ مرَّاتٍ عِدَّة.

225
00:20:00,230 --> 00:20:03,930
‫ما كنتُ لأنجو كُلَّ هذه المدَّة من دونكِ.

226
00:20:04,770 --> 00:20:06,930
‫لذا، أنا...

227
00:20:07,780 --> 00:20:09,950
‫في الحقيقة...

228
00:20:09,950 --> 00:20:15,810
‫لديَّ زوجةٌ بالفعل، اسمها سيلفييت غريرات.

229
00:20:16,140 --> 00:20:18,310
‫أجل، سمعتُ بذلك.

230
00:20:19,090 --> 00:20:21,640
‫ما الذي أحاول قوله؟

231
00:20:22,980 --> 00:20:28,950
‫لم يكن لزوجتي كنيةٌ من قبل، لذا كان اسمها سيلفييت فقط.

232
00:20:29,790 --> 00:20:32,320
‫أجل، هذا ما قيل لي.

233
00:20:32,630 --> 00:20:34,770
‫ليس هذا ما أريد قوله.

234
00:20:40,370 --> 00:20:41,860
‫لا بأس.

235
00:20:41,860 --> 00:20:46,270
‫أُفضِّل أن أكون حُثالةً على الندم على صمتي لاحقًا.

236
00:20:47,340 --> 00:20:52,220
‫هل تقبلين تغيير اسمكِ إلى روكسي غريرات يا مُعلِّمتي؟

237
00:20:55,900 --> 00:20:57,470
‫أعشقُكِ.

238
00:21:10,520 --> 00:21:14,620
‫يُسعدني سماع هذا،

239
00:21:14,620 --> 00:21:18,670
‫لكن ألا يجب عليكَ طلب موافقة زوجتِكَ أوَّلاً؟

240
00:21:19,100 --> 00:21:21,170
‫هذا أكيد.

241
00:21:21,170 --> 00:21:22,160
‫إذًا...

242
00:21:25,950 --> 00:21:29,590
‫اسألني مُجدَّدًا بعد حصولكَ على موافقتها.

243
00:21:40,990 --> 00:21:42,970
‫حـ-حسنًا.

244
00:21:58,290 --> 00:22:01,080
‫الابن سرُّ أبيه.