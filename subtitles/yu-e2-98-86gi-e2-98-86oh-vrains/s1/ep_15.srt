00:14:33,050 --> 00:14:35,000
إلى أين ذهبا؟

168
00:14:35,000 --> 00:14:36,990
!لا يمكنني رؤيتهم

169
00:14:37,410 --> 00:14:39,270
ما كلّ هذه البيانات؟

170
00:14:39,270 --> 00:14:41,370
!يا لها من عاصفة بيانات شديدة

171
00:14:43,000 --> 00:14:46,000
!بلايمايكر! شغّل مهارتك

172
00:14:48,360 --> 00:14:51,700
!لم أتمكّن من منعه من تشغيل مهارته

173
00:14:58,540 --> 00:15:00,410
!ولوج العاصفة

174
00:15:09,630 --> 00:15:11,490
!لقد فقدت السّيطرة

175
00:15:14,060 --> 00:15:16,260
أوي، ماذا تفعل؟

176
00:15:16,560 --> 00:15:18,360
.سأنقذ غوست غيرل

177
00:15:18,600 --> 00:15:21,340
!سنُجرّ نحن أيضًا

178
00:15:34,140 --> 00:15:35,780
بلايمايكر؟

179
00:15:40,660 --> 00:15:41,950
.تبدين بخير

180
00:15:47,320 --> 00:15:49,280
.المبارزة لم تنتهي بعد

181
00:16:10,380 --> 00:16:14,120
.أنت كالأبطال الخارقين يا بلايمايكر-ساما

182
00:16:14,340 --> 00:16:16,590
!ياماموتو-سينباي، هناك

183
00:16:17,500 --> 00:16:19,010
!لقد خرجا

184
00:16:19,010 --> 00:16:21,460
.إنّهما بخير

185
00:16:23,740 --> 00:16:25,430
.شكرًا لك

186
00:16:25,800 --> 00:16:28,900
.لكنّ ذلك الموضوع لا دخل له بالمبارزة

187
00:16:29,120 --> 00:16:31,060
.أجل، أنتِ محقّة

188
00:16:31,060 --> 00:16:34,370
!إظهري! أيَّتها الدَّارَة المؤدّية إلى المستقبل

189
00:16:38,060 --> 00:16:39,840
!المؤشّرات جاهزة

190
00:16:39,840 --> 00:16:43,310
!يشترط للاستدعاء: وحشيْ "سايبرس" أو أكثر

191
00:16:43,310 --> 00:16:49,320
!أضع ثنائيّ الرّبط "أندركلوك تيكر" و "بالانسر لورد" على مزوّدات التّرابط

192
00:16:56,060 --> 00:16:57,540
!استدعاء التّرابط

193
00:16:58,000 --> 00:17:00,470
!إظهر، ثلاثيّ الرّبط

194
00:17:01,140 --> 00:17:03,200
!إكسكود تاكر

195
00:17:12,460 --> 00:17:17,650
.حتّى وإن هاجمتني مباشرةً، فلديّ "كونكيري" في يدي

196
00:17:17,650 --> 00:17:19,820
!لن أدعكَ تهاجمني مباشرةً

197
00:17:20,230 --> 00:17:22,790
!"يشتغل تأثير "إكسكود تاكر

198
00:17:22,790 --> 00:17:24,520
!قبض الخانات

199
00:17:24,820 --> 00:17:27,680
...لكلّ وحشٍ في منطقة الوحوش الإضافيّة

200
00:17:27,680 --> 00:17:30,800
!يتمّ منعكِ من استعمال خانة في منطقة وحوشك الرئيسيّة

201
00:17:32,240 --> 00:17:33,500
!مُحال

202
00:17:33,820 --> 00:17:37,070
.هناك وحشيْن في منطقة الوحوش الإضافيّة

203
00:17:37,070 --> 00:17:40,970
!وهناك خانَتيْن فارغتيْن في منطقة وحوشك الرئيسيّة

204
00:17:40,980 --> 00:17:44,580
!هكذا يتمّ ختم الخانتيْن المتبقّيتيْن في منطقة وحوشك الرئيسيّة

205
00:17:46,700 --> 00:17:51,180
.لا يمكنني استعمال تأثير "كونكيري" إن لم يكن هناك مجالٌ لاستدعائه

206
00:17:51,540 --> 00:17:54,190
.لديّ وحشيْن على ملعبي

207
00:17:54,460 --> 00:17:58,620
."ولا يمكن مهاجمتهما بفضل تأثير "التّمويه

208
00:17:58,620 --> 00:18:02,090
!أضحّي بـ"دمية الفحص" لتشغيل تأثيرها

209
00:18:02,710 --> 00:18:06,600
!يمكن لـ"إكسكود تاكر" المهاجمة مرَّتين

210
00:18:10,530 --> 00:18:13,470
!لقد تفوَّق على توقّعاتي

211
00:18:13,610 --> 00:18:16,710
!"أهاجمك مباشرةً بـ"إكسكود تاكر

212
00:18:24,100 --> 00:18:26,620
.انتهى الأمر. جهّزي نفسك

213
00:18:27,380 --> 00:18:29,620
!أهاجمكِ مباشرةً مجدّدًا

214
00:18:29,620 --> 00:18:32,360
!إكسكود كلوز

215
00:18:39,800 --> 00:18:42,280
.لقد خسرت تمامًا

216
00:18:45,260 --> 00:18:46,880
!لقد فعلها

217
00:18:46,880 --> 00:18:50,240
!"إنّ بلايمايكر حقًّا بطل "لينك فراينس

218
00:18:50,240 --> 00:18:52,620
لماذا تحتفل؟

219
00:18:52,620 --> 00:18:58,410
.كانت لتكون هزيمة بطلنا الأولى سبقٌ صحفيّ مميّز

220
00:19:00,850 --> 00:19:02,920
.يا إلهي

221
00:19:03,320 --> 00:19:07,740
.من يعرف ما كان ليحدث إن لم أكن موجودًا

222
00:19:07,740 --> 00:19:09,290
.كان ذلك مجهدًا

223
00:19:12,300 --> 00:19:14,230
.إنّ القمر جميلٌ اليوم

224
00:19:14,440 --> 00:19:18,470
.حقًّا؟ إنّه يبدو مجرّد بياناتٍ بالنّسبة لي

225
00:19:18,880 --> 00:19:22,860
.لا يمكن لـ حاسوبٍ ذكيّ غبيّ فهم هذا الشّعور

226
00:19:22,860 --> 00:19:23,840
.لقد وعدتِني

227
00:19:24,380 --> 00:19:26,540
.أعطِنا المتّفق عليه

228
00:19:26,760 --> 00:19:27,960
.طبعًا

229
00:19:39,950 --> 00:19:44,910
.لديكْ الآن الباب الخلفيّ لـ مركز بيانات شركة تقنيّات سول

230
00:19:45,900 --> 00:19:47,530
.إلى الّلقاء

231
00:19:50,060 --> 00:19:52,270
.ستزداد الأمور حماسًا

232
00:19:57,400 --> 00:20:01,950
ناه، ما الموجود في مركز بيانات شركة تقنيّات سول؟

233
00:20:02,940 --> 00:20:04,950
...لا أعرف

234
00:20:05,820 --> 00:20:06,650
...لكن

235
00:20:12,320 --> 00:20:16,560
.قد يكون هناك شيءٌ عنّي قبل عشرة سنوات

236
00:20:16,560 --> 00:20:19,320
ماذا؟ فيهِ ذلك؟

237
00:20:19,320 --> 00:20:21,900
هل هذه البيانات مهمّة؟

238
00:20:22,280 --> 00:20:23,570
!ناه

239
00:20:24,280 --> 00:20:26,290
إذًا؟ هل صوّرته؟

240
00:20:26,290 --> 00:20:29,010
!طبعًا! بشكلٍ ممتاز

241
00:20:29,220 --> 00:20:36,250
!لم نحصل على سبقٍ صحفيّ لـهزيمة بلايمايكر التاريخيّة، لكنّنا صوّرنا مبارزة رائعة

242
00:20:36,740 --> 00:20:40,260
!الآن يمكننا اكمال حلقة بلايمايكر الخاصّة

243
00:20:40,260 --> 00:20:43,560
!أجل! أعد تشغيل المبارزة

244
00:20:43,560 --> 00:20:44,650
!حسنًا

245
00:20:51,620 --> 00:20:52,500
أري؟

246
00:20:53,210 --> 00:20:54,160
ما الأمر؟

247
00:20:54,380 --> 00:20:56,040
.هناك خطبٌ ما

248
00:20:56,520 --> 00:21:01,380
.آسفة، لقد حذفتُ تسجيلكم

249
00:21:06,640 --> 00:21:08,850
ما الّذي ينبغي علينا فعله يا ياماموتو-سينباي؟

250
00:21:08,850 --> 00:21:10,460
!لا تنطق باسمي الحقيقيّ

251
00:21:10,460 --> 00:21:11,900
!ياماموتو-سينباي

252
00:21:14,840 --> 00:21:20,520
.آسفة، لكن مبارزة الّليلة هي سرٌّ بيني وبين بلايمايكر

253
00:21:30,480 --> 00:21:31,750
.كوساناغي-سان

254
00:21:31,750 --> 00:21:33,170
.شكرًا

255
00:21:33,380 --> 00:21:35,910
هل يمكنك تحليله؟

256
00:21:35,910 --> 00:21:37,040
.أجل

257
00:21:37,260 --> 00:21:38,600
.أعتمد عليك

258
00:23:34,800 --> 00:23:38,200
ما الّذي حدث قبل عشرة سنوات؟

259
00:23:38,200 --> 00:23:42,570
.إنّ بلايمايكر سيتسلّل إلى مركز بيانات شركة تقنيّات سول

260
00:23:42,570 --> 00:23:46,910
.لكنّ الحماية الشّديدة تعترض طريقه

261
00:23:46,910 --> 00:23:51,170
.هناك أثرٌ عميق في الشّبكة

262
00:23:51,170 --> 00:23:53,510
.أعرف أنّ هذا خطر

263
00:23:53,720 --> 00:23:56,780
.لكن عليّ الذّهاب

264
00:23:56,780 --> 00:23:58,800
!في الحلقة القادمة من يوغي أوه! فراينس

265
00:23:59,120 --> 00:24:01,440
التسلّل إلى حصن "سول" الإلكترونيّ

266
00:24:01,440 --> 00:24:03,480
!انتقال إلى فراينس