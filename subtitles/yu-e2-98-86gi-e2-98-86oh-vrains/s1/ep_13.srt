!إظهري، ثنائيّة الرّبط: ملاك تريكستار المُقدَّسة

185
00:12:26,940 --> 00:12:30,600
.لكنّ بلو انجل كانت تتصرّف بغرابة

186
00:12:31,400 --> 00:12:34,870
!"أهاجم "الملاك المُقدَّسة" بـ"إنكود تاكر

187
00:12:34,870 --> 00:12:37,840
!التّرميز الأخير

188
00:12:45,050 --> 00:12:47,180
لا أحد يعرف ذلك

189
00:12:47,950 --> 00:12:53,380
.عندَها، أصيبَتْ بلو انجل بـفيروس حواسيب من صنع فرسان هانوي

190
00:12:57,920 --> 00:13:02,320
...مشاعركِ تجاه بلايمايكر

191
00:13:03,680 --> 00:13:06,170
.صدمتني فعلاً

192
00:13:07,360 --> 00:13:12,330
.أريدكِ أن تهزمي بلايمايكر ببساطة

193
00:13:15,120 --> 00:13:19,690
.قبضت شركة تقنيّات سول على بلايمايكر بسبب سوء تفاهم

194
00:13:19,690 --> 00:13:20,630
ماذا؟

195
00:13:20,630 --> 00:13:22,530
حقًّا؟

196
00:13:26,540 --> 00:13:27,520
ماذا؟

197
00:13:27,520 --> 00:13:29,760
!لا يمكنني الحراك

198
00:13:32,550 --> 00:13:35,140
!قُبِضَ على بلايمايكر

199
00:13:37,620 --> 00:13:43,010
.لكنّ عندَها ظهر زعيم فرسان هانوي، ريفولفر

200
00:13:43,010 --> 00:13:47,850
.هو أيضًا أراد حاسوب بلايمايكر الذكيّ

201
00:13:47,850 --> 00:13:50,570
.وكانت قوّته هائلة

202
00:13:56,960 --> 00:13:58,560
!ريفولفر

203
00:13:58,560 --> 00:14:00,000
ريفولفر؟

204
00:14:00,000 --> 00:14:01,390
!فارسٌ من هانوي

205
00:14:01,390 --> 00:14:03,660
.حرّر بلايمايكر

206
00:14:03,660 --> 00:14:04,360
ماذا؟

207
00:14:04,360 --> 00:14:07,690
.سأواجهه أنا

208
00:14:07,690 --> 00:14:13,370
.لقد وضعنا فيروسًا بداخل شقيقتك، بلو انجل

209
00:14:13,370 --> 00:14:14,280
ماذا؟

210
00:14:16,960 --> 00:14:22,210
.سأعطيك برنامج إزالة الفيروسات إن هزمني بلايمايكر في مبارزة

211
00:14:24,200 --> 00:14:25,640
.بلايمايكر

212
00:14:25,640 --> 00:14:28,460
.ما فعلته لك كان فظيعًا

213
00:14:28,460 --> 00:14:31,260
...لكنّك لأجل أختي

214
00:14:31,260 --> 00:14:35,490
ستقاتل لأجلي رغمًا على حقدك عليّ؟

215
00:14:36,170 --> 00:14:38,490
.لا أحقد عليك

216
00:14:41,570 --> 00:14:45,420
.لا أحقد سوى على فرسان هانوي

217
00:14:45,830 --> 00:14:50,070
!هيّا بنا! لـتبدأ المبارزة الجحيميّة

218
00:14:50,070 --> 00:14:55,180
.يمكنني سماع نبض القوّة المجهولة المتخفّية في الشّبكة

219
00:14:55,710 --> 00:14:59,610
.منتظرةً منّي امساكها

220
00:15:01,740 --> 00:15:03,750
!اقتربي يا عاصفة البيانات

221
00:15:09,850 --> 00:15:11,860
!أشغّل مهارة

222
00:15:11,860 --> 00:15:15,030
!النّفس الجّديد كامنٌ في يدي

223
00:15:15,030 --> 00:15:16,420
!ولوج العاصفة

224
00:15:21,080 --> 00:15:22,430
.يا لها من قوّة

225
00:15:23,370 --> 00:15:24,960
!استدعاء التّرابط

226
00:15:24,960 --> 00:15:29,410
!إظهر، رباعيّ الرّبط: تنّين التّفجير التوبولوجيّ

227
00:15:29,410 --> 00:15:31,040
.هذا سيّء

228
00:15:31,040 --> 00:15:35,780
.هناك طريقةٌ واحدة للفوز

229
00:15:36,500 --> 00:15:38,120
.ولوج العاصفة

230
00:15:38,120 --> 00:15:42,590
.آسف، لكنّني لن أسمح لك باستعمال تلك الورقة

231
00:15:42,590 --> 00:15:44,520
!التّشابك الكامل

232
00:15:54,060 --> 00:15:58,600
.مبارزات السرعة ليست ملائمةً لـ معركتنا

233
00:15:58,600 --> 00:16:01,840
.السّاحة الجديدة في انتظارنا

234
00:16:03,250 --> 00:16:05,090
مـ ماذا يجري؟

235
00:16:10,270 --> 00:16:13,090
!لقد جرَّتهما العاصفة

236
00:16:13,090 --> 00:16:14,910
ما الّذي حدث لهما؟

237
00:16:14,910 --> 00:16:16,820
!لـنتقدَّم أكثر

238
00:16:16,900 --> 00:16:23,800
شاهدةُ عيانٍ لـ مبارزة بلايمايكر وريفولفر
غوست غيرل

239
00:16:18,370 --> 00:16:22,000
.لقد استسلمت ولم أحاول الدّخول إلى العاصفة

240
00:16:22,000 --> 00:16:23,800
.لكنّ معجزةٌ قد حدثت بعد ذلك

241
00:16:24,420 --> 00:16:28,270
.لعلّ جماليَ نعمةٌ من الخالق

242
00:16:28,880 --> 00:16:32,100
.لقد خاطرتُ بـحياتي ونجحتُ في الدّخول

243
00:16:32,570 --> 00:16:37,140
.عندَها، كانت المبارزة الحاسمة لـمستقبل "لينك فراينس" قد بدأت بالفعل

244
00:16:37,140 --> 00:16:41,610
.كان بلايمايكر في وضعٍ حرج

245
00:16:41,610 --> 00:16:46,280
.لا تعرف ماهو إغنيس على ما يبدو

246
00:16:46,280 --> 00:16:49,290
.سأخبرك قبل خسارتك

247
00:16:49,290 --> 00:16:52,000
.إغنيس ليسَ مُجرَّد حاسوبٍ ذكيّ

248
00:16:53,520 --> 00:16:56,890
.إغنيس هو حاسوبٌ ذكيّ حرّ الإرادة

249
00:16:56,890 --> 00:16:58,170
حرّ الإرادة؟

250
00:16:58,910 --> 00:17:02,770
!مستحيل! لا يمكن أنّ يكون هناك برنامجًا للإرادة الحرّة

251
00:17:04,010 --> 00:17:08,790
.توقّعت ردّة فعلكَ هذه

252
00:17:08,790 --> 00:17:15,250
.لكن، سواءً صدّقت هذه القصّة أم لا، فذلك لا يهم

253
00:17:16,980 --> 00:17:20,950
!والآن، سأستئنف هذه المبارزة لأنهي أمرك

254
00:17:20,950 --> 00:17:23,260
!ها أنا ذا يا بلايمايكر

255
00:17:23,260 --> 00:17:26,590
!يا ريحيَ الجديدة الّتي تجتاح العالم المغلق

256
00:17:26,590 --> 00:17:28,010
!استدعاء التّرابط

257
00:17:28,010 --> 00:17:32,280
!إظهر، رباعيّ الرّبط: التنّين فاريلّود

258
00:17:41,620 --> 00:17:44,730
!إنّه وحشه الأقوى

259
00:17:45,300 --> 00:17:50,880
!"تلاشت وحوشك "السايبرس" بفضل تأثير "سجن النّار

260
00:17:50,880 --> 00:17:53,520
!"انطلق أيّها "التنّين فاريلّود

261
00:17:53,520 --> 00:17:56,490
!هاجم بلايمايكر مباشرةً

262
00:17:58,320 --> 00:17:59,580
!خذ هذا

263
00:17:59,700 --> 00:18:02,260
!مدفع فارّيل الرّعدي

264
00:18:12,100 --> 00:18:16,240
.لاشكّ في أنّني سأخسر إن لم أفعل شيئًا في هذا الدّور

265
00:18:16,240 --> 00:18:18,180
لكن ما الّذي يمكنني فعله؟

266
00:18:21,940 --> 00:18:23,360
...هذا

267
00:18:27,480 --> 00:18:33,560
.نبض "السايبرس" الجديد الّذي بـداخل مجموعتي لم يتلاشى بعد

268
00:18:34,110 --> 00:18:36,560
أي، أمازلتَ هناك؟

269
00:18:36,560 --> 00:18:38,400
هل يمكنك سماعي؟

270
00:18:39,040 --> 00:18:41,130
!أجبني يا أي

271
00:18:43,930 --> 00:18:45,470
!بلايمايكر

272
00:18:45,470 --> 00:18:47,820
.لا فائدة مهما فعلت

273
00:18:47,820 --> 00:18:50,440
.لقد تلاشى "السايبرس" بالفعل

274
00:18:54,090 --> 00:18:58,820
.أنت مخطئ. مازال "السايبرس" هنا

275
00:18:58,820 --> 00:19:01,650
!يمكنني سماع نبضاتهم

276
00:19:03,470 --> 00:19:05,720
!إظهر، رباعيّ الرّبط

277
00:19:06,630 --> 00:19:08,670
!تنّين جدار الحماية

278
00:19:20,020 --> 00:19:22,240
."لقد تدمَّر "سجن النّار

279
00:19:24,710 --> 00:19:26,360
.أنا لن أخسر

280
00:19:26,360 --> 00:19:30,280
!لديّ ثلاثة أسباب تجعل هزيمتك ضروريّة

281
00:19:31,590 --> 00:19:37,360
!أوّلاً: سأهزمك واكتشفُ حقيقة ما حدثَ قبل عشرة سنوات

282
00:19:38,800 --> 00:19:42,960
!ثانيًا: سأسترجع ما فقدت من ماضيّ المفقود

283
00:19:42,960 --> 00:19:47,570
!ثالثًا: سأنقذ صديقي الّذي انقذني

284
00:19:47,570 --> 00:19:51,320
...عشرة سنوات... التّعداد الثّلاثي

285
00:19:51,320 --> 00:19:54,810
أيعقل أنّك ذاك الشّخص من الحادثة الّتي وقعتْ قبل عشرة سنوات؟

286
00:19:55,190 --> 00:19:59,910
!هذا صحيح. أنا هو أداةُ الانتقام تلك

287
00:20:02,830 --> 00:20:05,280
.هناك شيءٌ واحد عليّ فعله

288
00:20:05,770 --> 00:20:10,690
!وهو سحق فرسان هانوي ومعرفة كلّ شيء

289
00:20:11,350 --> 00:20:13,180
!"أهاجم بـ"جدار الحماية

290
00:20:13,660 --> 00:20:15,490
!هجوم الزّوبعة

291
00:20:17,140 --> 00:20:21,170
!لن يتدمَّر "فاريلّود" لكنَّك ستتلقَّى ضررًا

292
00:20:31,060 --> 00:20:33,370
.إنّه برنامج الإزالة

293
00:20:33,370 --> 00:20:34,450
!بلايمايكر

294
00:20:34,880 --> 00:20:37,880
.لم تهبّ الرّياح ليّ اليوم

295
00:20:37,880 --> 00:20:44,370
.لكن، لطالما لديك ذلك الحاسوب الذكيّ، فهذه المبارزة ليست سوى البداية

296
00:20:44,370 --> 00:20:46,820
.سوف نلتقي مجدّدًا

297
00:20:50,810 --> 00:20:57,200
.وهكذا انتهتْ المبارزة المهمّة الحاسمة لـمستقبل "لينك فراينس" بـفوز بلايمايكر

298
00:20:57,200 --> 00:21:03,010
.لكن وكما قالَ ريفولفر، هذه ليسَت سوى البداية

299
00:21:02,950 --> 00:21:11,500
شاهدةُ عيانٍ لـ مبارزة بلايمايكر وريفولفر
غوست غيرل

300
00:21:03,570 --> 00:21:05,800
ماذا يكون إغنيس؟

301
00:21:05,800 --> 00:21:08,320
ماهو هدف فرسان هانوي؟

302
00:21:08,320 --> 00:21:11,480
ماهو الحادث الّذي وقعَ لـ بلايمايكر قبل عشرة سنوات؟

303
00:21:12,470 --> 00:21:15,400
.أراكم في الحلقة القادمة

304
00:21:18,800 --> 00:21:21,120
!لقد نجحنا يا ياماموتو-سينباي

305
00:21:21,120 --> 00:21:22,730
!انتهتْ الحلقة الخاصًّة

306
00:21:23,960 --> 00:21:26,490
!أنا أسامحك على مناداتي باسمي الحقيقيّ

307
00:21:26,490 --> 00:21:29,200
!هذا البرنامج سيكون سبقنا الصحفيّ الحصريّ

308
00:21:30,770 --> 00:21:32,210
.سأعود للبيت

309
00:21:32,210 --> 00:21:34,860
.مهلاً. هناك واحدٌ آخر

310
00:21:34,860 --> 00:21:36,680
.يجب أن احذفه

311
00:21:37,650 --> 00:21:40,240
!لقد نجحنا

312
00:21:42,110 --> 00:21:44,080
!سينباي! هناك خطبٌ ما

313
00:21:49,610 --> 00:21:52,090
!بيانات الحلقة الخاصَّة يجري حذفها

314
00:21:52,090 --> 00:21:53,910
!إنّها لا تتوقّف

315
00:21:55,870 --> 00:21:57,460
.اختفت كلّها

316
00:21:57,460 --> 00:22:00,470
...أجل... مع نفقاتنا الإضافيّة

317
00:23:35,660 --> 00:23:39,830
...ألغاز وألغاز وألغاز تفوق المنطق

318
00:23:39,830 --> 00:23:46,600
.صيّادو الكنوز الإلكترونيّة هم روّاد يعيشون على حدود العالم الإلكترونيّ

319
00:23:46,600 --> 00:23:48,780
.غوست غيرل واحدةٌ منهم

320
00:23:48,780 --> 00:23:53,690
.إنّها تجول في أرجاء "لينك فراينس" باحثةً عن ألغازٍ جديدة

321
00:23:53,690 --> 00:23:55,790
.قم بالردّ على غوست غيرل

322
00:23:55,790 --> 00:23:58,350
.اخبرها أنّني أقبلُ مبارزتها

323
00:23:58,350 --> 00:24:00,140
:في الحلقة القادمة من يوغي أوه! فراينس

324
00:24:00,570 --> 00:24:02,040
دعوة غوست غيرل

325
00:24:02,290 --> 00:24:04,200
!انتقال إلى فراينس