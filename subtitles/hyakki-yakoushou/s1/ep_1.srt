1
00:00:21,930 --> 00:00:24,230
.حجرٌ، ورقةٌ، مِقصّ

2
00:00:25,120 --> 00:00:26,400
.أنتَ هُو الـ أوني

3
00:00:29,820 --> 00:00:31,900
.أوني-سان، هَلُمّ إلى هُنا

4
00:00:31,900 --> 00:00:34,270
.اتبع صَوت التّصفيق

5
00:00:34,930 --> 00:00:37,070
.أوني-سان، هَلُمّ إلى هُنا

6
00:00:37,070 --> 00:00:39,330
.اتبع صَوت التّصفيق

7
00:00:41,310 --> 00:00:43,510
.أوني-سان، هَلُمّ إلى هُنا

8
00:00:43,510 --> 00:00:45,750
...اتبع صَوت التّصفيق

9
00:00:55,620 --> 00:00:58,220
!كلا! النّجدة

10
00:01:00,370 --> 00:01:01,370
.رِيتسُو

11
00:01:02,870 --> 00:01:04,630
!تَوقّفي عن هذا

12
00:01:18,920 --> 00:01:20,180
...كان حُلمًا

13
00:01:20,700 --> 00:01:22,290
.وكان مُرعبًا حقًا

14
00:01:22,290 --> 00:01:25,450
لماذا أَرى أحلامًا عن طُفولتي الآن؟

15
00:01:29,090 --> 00:01:31,420
كان جدّي لا يزال على
.قيد الحياة آنذاك

16
00:01:31,420 --> 00:01:36,750
أَجبرني على ارتداء مَلابس
.الفتيات اتّباعًا للتّقاليد

17
00:01:36,750 --> 00:01:39,030
لا بُدّ أنّني كُنت في الثّالثة
.أو الرّابعة مِن عُمري

18
00:01:40,400 --> 00:01:43,960
كثيرٌ مِن الأطفال جَاءوا
.إلى دارنا ذلك اليوم

19
00:01:43,960 --> 00:01:46,370
.وكُنّا نلعب معًا

20
00:01:47,500 --> 00:01:50,110
...حتّى يَومي هذا، ما زِلتُ أَجهل

21
00:01:50,110 --> 00:01:52,510
.كُنه ذلك الشّيء الّذي كان معنا

22
00:01:54,470 --> 00:01:58,290
.كان جدّي يمتلكُ قُوىً غامضةً

23
00:01:58,290 --> 00:02:03,060
لذا، ومُنذ صِغري، كانت الأشياء
.الغَريبة تحدث في دارنا دومًا

24
00:02:03,860 --> 00:02:07,590
.لكنّني اعتدتُ الأمر الآن

25
00:02:08,320 --> 00:02:10,710
.أُمّي، سأَتولّى أنا نَقل هذا

26
00:02:12,970 --> 00:02:14,910
.أَبي، العشاء جاهزٌ

27
00:02:14,910 --> 00:02:15,410
.حسنًا

28
00:02:16,170 --> 00:02:18,390
هذا الشّخص هُو أحدُ تلك
.الأشياء الغَريبة

29
00:02:19,210 --> 00:02:21,760
.تُوفي والدي بسكتةٍ قلبيّة

30
00:02:21,760 --> 00:02:23,810
.عندما كُنت في الخَامسة

31
00:02:24,860 --> 00:02:27,410
.أنا لا أُجيد التّعامل مع والدتك

32
00:02:27,410 --> 00:02:30,880
إنّها ابنة الحَلزون، لذا فهِي
.تمتلكُ بعض القَوى الرُوحيّة

33
00:02:30,880 --> 00:02:32,340
...قد يأتي يومٌ تكتشف فيه

34
00:02:32,340 --> 00:02:34,330
.أنّني يُوكاي يسكن هذا الجَسد

35
00:02:35,500 --> 00:02:38,590
.وحِينها، قد تَتوقّف عن إعداد الزّاد لي

36
00:02:38,910 --> 00:02:41,130
،هذا الرّجل هُنا

37
00:02:41,130 --> 00:02:44,020
هُو في الحَقيقة يُوكاي يعيش
.داخل جَسد والدي

38
00:02:44,020 --> 00:02:45,440
.اسمه أوآراشي

39
00:02:45,880 --> 00:02:49,040
،وبِما أنّه يُوكاي
.فهُو لا يَعمل بطبيعة الحال

40
00:02:49,040 --> 00:02:54,280
مَعيشة عائلتنا تعتمد على أُمّي وجدّتي اللّتين
.تُعلّمان مَراسم الشّاي وتَنسيق الـ كِيمونو

41
00:02:55,000 --> 00:02:56,220
.كانا-تشان

42
00:02:56,800 --> 00:02:58,100
.هِي-تشان

43
00:02:58,100 --> 00:03:00,100
هل أنتِ متوجّهةٌ إلى دار إيجِيما-سينسي؟

44
00:03:00,100 --> 00:03:01,430
.لنَذهب معًا

45
00:03:03,890 --> 00:03:05,200
.أنتِ تَرتدين الـ كِيمونو اليوم

46
00:03:05,200 --> 00:03:06,840
ما المُناسبة؟
.تَبدين جميلةً جدًا

47
00:03:06,840 --> 00:03:10,000
صَنعتهُ جدّتي مِن أَجلي
.لأَرتديه في الدّرس

48
00:03:11,330 --> 00:03:13,030
.هِي-تشان، كانا-تشان

49
00:03:13,940 --> 00:03:15,360
.أنا أَشعر بالغِيرة حقًا

50
00:03:15,370 --> 00:03:18,120
.فذَوق جدّة هِي-تشان رفيعٌ للغاية

51
00:03:18,120 --> 00:03:20,670
.أنا أيضًا أَرتدي الـ كِيمونو اليوم

52
00:03:21,360 --> 00:03:23,570
.إنّ نُقوش لباسكِ بديعةٌ يا هِي-تشان

53
00:03:23,570 --> 00:03:25,470
.شُكرًا لكِ