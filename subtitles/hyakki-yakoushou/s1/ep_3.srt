1
00:00:25,220 --> 00:00:27,020
.هذا غَريبٌ

2
00:00:27,710 --> 00:00:30,400
.ما مِن أحدٍ جاء ليَأخُذهما

3
00:00:30,410 --> 00:00:33,370
هل غَادرت إحداهُنّ حَافية القَدمين؟

4
00:00:34,350 --> 00:00:36,950
.سأَسألُ الطّالبات يَوم الأحد المُقبل

5
00:00:37,250 --> 00:00:40,100
مَن مِنكُنّ عادت إلى دَارها بلا صَندلٍ؟

6
00:00:41,240 --> 00:00:42,540
.إنّ هذا لمُثير للسُخريّة

7
00:00:43,260 --> 00:00:46,070
تلك الرّوح الغَريبة لا تَزال
.قابعةً في الدّار

8
00:00:57,200 --> 00:00:59,400
...نَقشُ ذلك الـ كِيمونو

9
00:01:01,440 --> 00:01:04,970
.أَذكرُ أنّها كانت بين الزّوار

10
00:01:08,710 --> 00:01:11,410
.يَبدو أنّ ثمّة زائرةً لم تَرحل بعد

11
00:01:14,530 --> 00:01:15,690
.سيّدي الشّاب

12
00:01:15,690 --> 00:01:18,430
.ثمّة روحٌ مُريبة قد تسلّلت إلى الدّار

13
00:01:18,440 --> 00:01:20,810
!أُوجيرو، لا تَنطق بها قَبلي

14
00:01:20,810 --> 00:01:22,660
.وَاجهتُ تلك الرّوح آنفًا

15
00:01:22,660 --> 00:01:25,600
كانت تَرتدي كِيمونو بنَقشِ
.أَزهار الكَرز

16
00:01:27,310 --> 00:01:30,200
،أوآراشي
هل لَديك أَدنى فِكرةٍ؟

17
00:01:31,180 --> 00:01:33,910
،تَجاهلها
.ستَرحل مِن تلقاء نَفسها

18
00:01:33,910 --> 00:01:36,990
،لا تَقُم بأيّ فِعلٍ غير ضَروريٍ
هل تَفهم؟

19
00:01:36,990 --> 00:01:38,520
.تَجاهلها فحسب

20
00:01:45,080 --> 00:01:47,950
،سألتُ عِدّة طالباتٍ
.لكن لم تَدّعِ إحداهُن مِلكيّتهما

21
00:01:47,950 --> 00:01:50,580
لا بُدّ أنّهما تَخصّان
.إحدى طَالبات نَهار الأحد

22
00:01:50,580 --> 00:01:52,840
هل تُراهما تُرِكتا هُنا
على سَبيل المُزاح؟

23
00:01:53,620 --> 00:01:54,840
.أنا خَارجٌ

24
00:02:00,690 --> 00:02:01,820
.لا تَزالُ هُنا

25
00:02:03,530 --> 00:02:07,950
.تَجوب أَرجاء الدّار كُلّ يومٍ

26
00:02:08,990 --> 00:02:12,630
ما الّذي جَذبها إلى دَاري؟

27
00:02:15,330 --> 00:02:15,830
ماذا؟

28
00:02:16,220 --> 00:02:18,090
.ليَستا لي

29
00:02:18,090 --> 00:02:19,500
.ولا لي أنا أيضًا

30
00:02:19,500 --> 00:02:23,210
إذًا، مَن غيركما ارتدتِ
الـ كِيمونو في ذلك اليوم؟

31
00:02:23,810 --> 00:02:28,550
في الأُسبوع المَاضي، مَن حَضرتا الدّرس بالزّي
.التّقليدي هُما هِي-تشان وأنا... أَعني هِيداكا

32
00:02:29,020 --> 00:02:31,360
أَلم تكُن هُناك أُخرى؟

33
00:02:31,360 --> 00:02:34,710
اثنتان مِنكُنّ كَانتا تَرتديان ملابس
.غربيّةً، وثلاثٌ يَرتدين الـ كِيمونو

34
00:02:34,720 --> 00:02:37,680
المكان يَضيق بوُجود ستّة
.أشخاصٍ هُنا

35
00:02:38,820 --> 00:02:43,120
،سِينسي
.شَعرتُ بغَرابة الأمر حِينها

36
00:02:43,120 --> 00:02:46,020
تَساءلتُ إن كُنتِ قد حسبتِ
.نفسكِ معنا

37
00:02:46,530 --> 00:02:49,700
.كُنّا أربعًا حِين وصلنا للدّرس

38
00:02:49,700 --> 00:02:53,090
وبوُجود ابنكِ، يُصبح العَدد
خمسةً فحسب، أَليس كذلك؟

39
00:02:53,880 --> 00:02:56,260
،هِي-تشان
...الـ كِيمونو الّذي ارتديتهِ

40
00:02:56,260 --> 00:02:58,070
كان أُرجوانيّ اللّون؟

41
00:02:58,080 --> 00:03:01,380
.كلا، كان لَونه يَميل للحُمرة

42
00:03:01,380 --> 00:03:03,850
وأمّا يَاسودا فقد كان لَون رِدائها
أَزرق مُخضرًا فاتحًا، أَليس كذلك؟

43
00:03:04,520 --> 00:03:06,470
...إذًا، مَن الّتي كانت

44
00:03:06,470 --> 00:03:08,230
تَجلس بجِواري في الأُسبوع المَاضي؟

45
00:03:08,230 --> 00:03:12,470
تلك الّتي تَرتدي كِيمونو أُرجوانيًا
...بنَقشِ أَزهار الكَرز

46
00:03:18,100 --> 00:03:20,910
.لنَعتبرها، زَاشيكي وَاراشي

47
00:03:21,510 --> 00:03:23,530
...أجل

48
00:03:23,530 --> 00:03:25,830
هذا يَعني أنّ البَركة ستَحلّ
.على دَاري

49
00:03:25,840 --> 00:03:28,050
.بالتّأكيد يا سِينسي