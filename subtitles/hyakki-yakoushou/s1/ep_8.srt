1
00:00:22,120 --> 00:00:24,840
يُمكنكم الاختباء في
.أيّ مكانٍ بالدّار

2
00:00:24,840 --> 00:00:26,550
،حسنًا
.أنا قادمٌ لأمسكَ بكُم

3
00:00:26,550 --> 00:00:27,890
.هيّا، اختبئُوا

4
00:00:28,180 --> 00:00:30,590
.أوني-سان، هَلُمّ إلى هُنا

5
00:00:30,600 --> 00:00:32,610
.اتبع صَوت التّصفيق

6
00:00:33,770 --> 00:00:34,830
،أُمّي

7
00:00:34,830 --> 00:00:35,980
.ليكُن مخبؤكِ في مكانٍ قصيّ

8
00:00:35,990 --> 00:00:37,100
!تفرّقوا جميعًا

9
00:00:38,690 --> 00:00:40,480
ما هذا؟

10
00:00:40,480 --> 00:00:42,370
ما الّذي تنوي فعلهُ؟

11
00:00:42,730 --> 00:00:46,110
،وأنتِ أيضًا يا تسُوكاسا-تشان
.اختبئِي في مكانٍ أكثرَ بُعدًا

12
00:00:48,010 --> 00:00:51,210
رِيتسُو، هل تتجنّبني؟

13
00:00:52,240 --> 00:00:53,720
.اغرب عن وجهِي

14
00:00:59,610 --> 00:01:00,610
.حسنًا

15
00:01:02,350 --> 00:01:04,140
أين تختبئينَ؟

16
00:01:04,150 --> 00:01:06,530
.هيّا، أظهِري نفسكِ

17
00:01:07,130 --> 00:01:08,760
.لنلهُو معًا

18
00:01:10,700 --> 00:01:13,440
.أوني-سان، هَلُمّ إلى هُنا

19
00:01:14,110 --> 00:01:16,570
.اتبع صَوت التّصفيق

20
00:01:19,940 --> 00:01:21,040
!أمسكتُ بكِ

21
00:01:23,200 --> 00:01:24,470
.كِينُويو

22
00:01:24,900 --> 00:01:26,770
.إنّكِ كِينُويو أراكَاوا

23
00:01:30,700 --> 00:01:31,950
.هذا صحيحٌ

24
00:01:36,220 --> 00:01:37,890
.استردّ ما كانَ لك

25
00:01:48,040 --> 00:01:49,270
.عادَ إليّ بصري

26
00:01:49,800 --> 00:01:51,310
.أبصرتُ بعيني مِن جديدٍ

27
00:01:51,840 --> 00:01:53,720
،هذه المرّة
."دوري لأكونَ "الأوني

28
00:01:54,020 --> 00:01:54,340
ماذا؟

29
00:01:58,100 --> 00:02:00,480
.أوني-سان، هَلُمّ إلى هُنا

30
00:02:01,080 --> 00:02:03,650
.اتبع صَوت التّصفيق

31
00:02:10,810 --> 00:02:13,430
.أوني-سان، هَلُمّ إلى هُنا

32
00:02:13,810 --> 00:02:16,330
.اتبع صَوت التّصفيق

33
00:02:22,360 --> 00:02:25,270
.أوني-سان، هَلُمّ إلى هُنا

34
00:02:25,820 --> 00:02:26,970
...اتبع صَوت

35
00:02:40,460 --> 00:02:41,580
.تسُوكاسا-تشان

36
00:02:41,810 --> 00:02:43,120
!ابتعدي عنّي

37
00:02:50,400 --> 00:02:51,670
عمّي؟

38
00:02:52,380 --> 00:02:53,570
!تسُوكاسا-تشان

39
00:02:55,650 --> 00:02:58,470
.لم أكُن إلّا غافيًا هُنا فحسب

40
00:02:58,470 --> 00:03:02,350
