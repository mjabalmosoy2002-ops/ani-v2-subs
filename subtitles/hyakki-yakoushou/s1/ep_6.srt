1
00:00:25,280 --> 00:00:27,270
.أُوجيرو، أُوغورو

2
00:00:27,270 --> 00:00:28,820
.أجل، يا سيّدي الشّاب

3
00:00:28,820 --> 00:00:29,830
أجل؟

4
00:00:30,550 --> 00:00:32,650
.ابنةُ عمّي تسُوكاسا-تشان قادمةٌ

5
00:00:32,650 --> 00:00:34,470
قريبةُ السيّد الشّاب؟

6
00:00:34,470 --> 00:00:36,500
.لا بُدّ أن نُحسن ضيافتها

7
00:00:37,360 --> 00:00:39,090
.كُفّا عن أيّ فِعلٍ

8
00:00:39,100 --> 00:00:39,610
!عجبًا

9
00:00:39,610 --> 00:00:42,360
.إنّها تستشعرُ الأرواح نوعًا ما

10
00:00:42,360 --> 00:00:44,650
.هذا مملٌّ

11
00:00:44,650 --> 00:00:47,180
.اختفيا عن أنظارها تمامًا

12
00:00:49,800 --> 00:00:51,800
...تعرّضت ابنةُ عمّي تسُوكاسا-تشان

13
00:00:51,800 --> 00:00:54,700
لمسّ مِن يُوكاي وهِي
.في السّابعة مِن عُمرها

14
00:00:54,700 --> 00:00:56,690
وقد خلّفَ ذلك ندبةً
،سوداء كبيرةً على جسدها

15
00:00:56,690 --> 00:00:58,500
عانت بسببها طيلةَ
،اثنتي عشرة سنةً

16
00:00:59,300 --> 00:01:02,060
.وعاشت فترةَ مُراهقةٍ عصيبة

17
00:01:07,390 --> 00:01:09,310
،لكن بمُجرّد أن رحلَ ذلك اليُوكاي

18
00:01:09,310 --> 00:01:10,870
.تلاشت تلك النّدبة أيضًا

19
00:01:11,810 --> 00:01:15,020
صارَ بمَقدوري الآن ارتداءُ
،ما يحلو لي

20
00:01:16,200 --> 00:01:18,570
.وتسريحُ شعري كما أشاءُ

21
00:01:24,390 --> 00:01:25,480
.رِيتسُو

22
00:01:27,040 --> 00:01:28,380
.تسُوكاسا-تشان

23
00:01:30,440 --> 00:01:32,270
،قِيل لي إنّك فقدتَ بصركَ

24
00:01:32,270 --> 00:01:34,060
.لذا أتيتُ لأطمئنّ عليك

25
00:01:34,640 --> 00:01:36,460
.لم أفقِد سوى عينِي اليُسرى

26
00:01:37,110 --> 00:01:40,100
ما هذا؟
.لم تتبدّل فيها خصلةٌ واحدة

27
00:01:42,000 --> 00:01:43,150
.ألقِ نظرةً

28
00:01:43,160 --> 00:01:44,830
رُخصة قيادةٍ؟

29
00:01:49,210 --> 00:01:51,020
،إن كُنتِ تبغِينَ إثارة غِيرتي

30
00:01:51,020 --> 00:01:53,130
.فعلى الأقلّ تباهي بها أكثر

31
00:01:53,130 --> 00:01:56,180
.معذرةً، فأنا طبعي كئيبٌ

32
00:01:57,260 --> 00:02:00,630
طبائعُ البشر لا تتبدّل
.بمثل هذه السّرعة

33
00:02:00,630 --> 00:02:02,720
تلك السّنوات الاثنتا عشرة
.خلّفت نُدوبًا عميقة

34
00:02:03,280 --> 00:02:05,090
.هذه هديّةٌ بسيطة

35
00:02:05,100 --> 00:02:07,710
.شُكرًا لكِ يا تسُوكاسا-تشان

36
00:02:07,710 --> 00:02:10,420
ما زلتِ مُحافظةً على
.تسريحة شعركِ نفسها

37
00:02:13,110 --> 00:02:14,950
كيفَ حالُ أُمّكِ وأبيكِ؟

38
00:02:14,950 --> 00:02:16,000
.إنّهما بأفضل حالٍ

39
00:02:17,100 --> 00:02:18,340
هل وقتكُم يسمحُ باستقبالي الآن؟

40
00:02:18,340 --> 00:02:20,460
،عمّتي، لديكِ درسٌ اليوم
أَليس كذلك؟

41
00:02:21,440 --> 00:02:24,480
.يبدو أنّ طالبتكِ قد وصلت

42
00:02:24,480 --> 00:02:26,860
لمحتُ فتاةً تعبرُ الرّواق
...وهِي ترتدي كِيمونو

43
00:02:26,860 --> 00:02:28,220
.مُزينًا بنقشة أزهار الكرز

44
00:02:34,160 --> 00:02:36,200
.كم هذا مثيرٌ للحنين

45
00:02:36,780 --> 00:02:40,410
كانَ لمّ شمل العائلة يحدثُ
.هُنا غالبًا في طُفولتنا

46
00:02:40,820 --> 00:02:44,110
ما زِلتُ أذكر كيفَ كُنّا نلعب
.لُعبة المُطاردة حينذاك

47
00:02:44,110 --> 00:02:45,830
غيرَ أنّي لا أستحضرُ
.وُجوه مَن شاركُونا

48
00:02:48,220 --> 00:02:50,160
...لكن

49
00:02:50,160 --> 00:02:53,300
كانت تلك اللّعبة تبعثُ
.الرّعب في نفسي

50
00:02:53,830 --> 00:02:56,220
.هذه الدّار قديمةٌ وفسيحة

51
00:02:59,030 --> 00:03:02,910
،ولأنّها كانت أيّام رأس السّنة
.كانَ الصّغار يرتدون الكِيمونو

52
00:03:03,350 --> 00:03:06,180
.وكُنت أنت أحدهُم بثوبك الأحمر

53
00:03:06,780 --> 00:03:10,300
أمّا الأخرى فقد كانت ترتدي كِيمونو
.بنفسجيًا مُزينًا بنقشة أزهار الكرز

54
00:03:10,300 --> 00:03:13,060
كانَ في غاية الرّوعة، لذا
.رسخت تفاصيلهُ في ذاكرتي بعُمقٍ

55
00:03:13,060 --> 00:03:15,180
.لكن صاحبةُ الكِيمونو مجهولةٌ

56
00:03:16,530 --> 00:03:18,100
!يا إلهي

57
00:03:18,100 --> 00:03:21,200
إنّه يُطابق كِيمونو الفتاة الّتي
.لمحتها في الرّواق مُنذ هُنيهةٍ

58
00:03:22,270 --> 00:03:24,070
،مثلما توقّعتُ إذن

59
00:03:24,070 --> 00:03:27,170
لُعبة الغُمّيضة بدأت
.مُنذ ذلك الحين