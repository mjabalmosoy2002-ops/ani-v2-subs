1
00:00:20,970 --> 00:00:23,660
تملّكني الرّعب حتّى
.عجزتُ عن الصّراخ

2
00:00:24,350 --> 00:00:29,210
فمَضيتُ أعدُو نحو الدّار
.لأُنذرَ والديَ

3
00:00:30,620 --> 00:00:38,290
لكنّني نسيتُ أنّهما
.بالخارج تلك اللّيلة

4
00:00:39,140 --> 00:00:41,550
.كانَ الحريق ينتشرُ بسُرعةٍ

5
00:00:41,550 --> 00:00:43,560
وأنا متسمّرةٌ في مكاني
.مِن الذّعر

6
00:00:43,570 --> 00:00:46,600
لزِمتُ مَخبئي ولم أجرؤ
،على الخُروج

7
00:00:47,280 --> 00:00:51,680
ولم تُطاوعني نفسي أن
.أعترفَ للكبار بما اقترفناه

8
00:00:53,030 --> 00:00:56,370
كذبتُ عليهم وقُلت إنّ شقيقتي
،كانت تقرأُ وحدها في المخزن

9
00:00:56,370 --> 00:01:00,390
وتظاهرتُ بأنّني لا أعلمُ
.عن الأمر شيئًا

10
00:01:01,110 --> 00:01:04,060
عندما حضرَ إيجِيما-سان
،جنازة شقيقتي

11
00:01:04,060 --> 00:01:05,990
...قال لي فجأةً

12
00:01:06,560 --> 00:01:07,850
،كِينُويو-تشان

13
00:01:08,580 --> 00:01:12,000
،إذا كُنتِ تشعرينَ بالوحدة
.فتَعالي لزيارتنا بين الحِين والآخر

14
00:01:13,840 --> 00:01:17,040
،كُنت أخشى افتضاحَ سرّي

15
00:01:17,040 --> 00:01:19,340
.فحييتُ في خوفٍ دائم

16
00:01:21,320 --> 00:01:26,800
مضى ستّون عامًا دُون أن
.أُفضِي بهذا السّر لأحدٍ

17
00:01:27,830 --> 00:01:33,470
لا بُدّ أنّ شقيقتي لا تزال
.تُحاول الإمساك بي

18
00:01:40,200 --> 00:01:41,400
شقيقتي؟

19
00:02:05,610 --> 00:02:06,860
!شقيقتي

20
00:02:07,970 --> 00:02:09,650
!شقيقتي، انتظرِي

21
00:02:11,420 --> 00:02:12,420
!شقيقتي

22
00:02:14,160 --> 00:02:17,320
!أنا آسفةٌ، أنا آسفةٌ

23
00:02:17,940 --> 00:02:21,070
!أنا آسفةٌ

24
00:02:22,850 --> 00:02:24,410
...أنا آسفةٌ

25
00:02:32,330 --> 00:02:33,980
.ها قد وصلنا

26
00:02:35,330 --> 00:02:38,120
،تسُوكاسا-تشان
لِمَ توقّفتِ هُنا؟

27
00:02:38,820 --> 00:02:40,760
لا يُمكنني إدخال السّيارة
.إلى المِرآب

28
00:03:00,110 --> 00:03:01,610
،رحلت

29
00:03:03,450 --> 00:03:05,450
.ولم تعصِب عينيها

30
00:03:05,760 --> 00:03:06,430
،أجل

31
00:03:08,140 --> 00:03:10,020
فالطّفل الّذي يقضي نحبهُ
،"وهُو يتقمّص دورَ "الأوني

32
00:03:10,020 --> 00:03:12,400
،في لُعبة الغُمّيضة

33
00:03:12,990 --> 00:03:16,690
يغدو "أونيًّا" حقيقيًا
.دُون أن يُدرك ذلك

34
00:03:17,810 --> 00:03:21,370
،أمّا الآن فقد انتهت اللّعبة
.وعادت إلى دارها

35
00:03:21,710 --> 00:03:24,120
وأنا كذلك أرغبُ
.بالعودة إلى الدّار