1
00:00:22,680 --> 00:00:25,350
!يا لَلهول
.ثمّة روحٌ غريبة تَلج المكان

2
00:00:29,910 --> 00:00:31,660
.معذرةً

3
00:00:32,760 --> 00:00:33,890
.أهلًا بكُنّ

4
00:00:33,900 --> 00:00:35,050
.تَفضّلن بالدّخول

5
00:00:35,050 --> 00:00:36,970
.نستميحكِ عُذرًا على الإزعاج

6
00:00:36,970 --> 00:00:38,980
،كثيراتٌ مِنكُنّ يَرتدين الـ كِيمونو اليوم

7
00:00:38,980 --> 00:00:40,400
.هذا يَبعث على البَهجة

8
00:00:48,500 --> 00:00:51,580
!يا إِلهي
هل دَخل الجميع؟

9
00:00:53,470 --> 00:00:55,330
ما الّذي تَفعله؟

10
00:00:57,240 --> 00:01:01,210
،يا لَها مِن فُرصةٍ لا تُفوّت
لِمَ لا تنضمّ إلى الدّرس أنت أيضًا؟

11
00:01:01,210 --> 00:01:02,290
!كلا

12
00:01:03,990 --> 00:01:07,360
المكان يَضيق بوُجود ستّة
.أشخاصٍ هُنا

13
00:01:07,360 --> 00:01:09,540
.الآن، كُفّوا جميعًا عن الكلام

14
00:01:09,540 --> 00:01:11,470
.رِيتسُو، اعتدل في جَلستك

15
00:01:12,640 --> 00:01:14,000
مَن عساها تَكون؟

16
00:01:15,890 --> 00:01:18,040
وأين تَتوارى؟

17
00:01:20,740 --> 00:01:23,110
...لا رَيب أنّها واحدةٌ مِنهنّ

18
00:01:23,510 --> 00:01:26,650
!تبًا، ابتعدوا عنّي

19
00:01:28,030 --> 00:01:31,820
...آهٍ، تَصلّبت ساقاي

20
00:01:33,400 --> 00:01:36,090
،حسنًا
.نَكتفي بهذا القَدر لليوم

21
00:01:36,100 --> 00:01:38,430
.نَشكركِ على الدّرس

22
00:01:43,520 --> 00:01:44,860
!يا للأسف

23
00:01:44,860 --> 00:01:46,800
،لا تَنظرن يا فتيات
.أَرجوكن، ليبقَ هذا سِرًا بيننا

24
00:01:46,800 --> 00:01:49,870
ابنُ مُعلّمة مَراسم الشّاي
.لا يُحسن الجُلوس بوضعيّة السّيزا

25
00:01:51,830 --> 00:01:54,740
،في النّهاية
.لم أَتبين هويّتها

26
00:01:55,590 --> 00:01:57,520
هل هُو الابن الوَحيد للـ سِينسي؟

27
00:01:58,600 --> 00:01:59,410
،شُكرًا لكِ على دَرس اليوم
.يا سِينسي

28
00:01:59,410 --> 00:02:01,660
.نَستأذنكِ بالانصراف

29
00:01:59,410 --> 00:02:01,660
.مَوعدنا الأُسبوع المُقبل

30
00:02:01,660 --> 00:02:03,630
.إلى اللّقاء حِينها

31
00:02:03,630 --> 00:02:05,450
.شُكرًا لكِ، سِينسي

32
00:02:05,460 --> 00:02:07,350
هِي-تشان، هل تَرغبين في التوقّف
عند وجهةٍ ما قبل العَودة؟

33
00:02:05,460 --> 00:02:07,350
.رَافقتكنّ السّلامة جميعًا

34
00:02:09,380 --> 00:02:09,730
ماذا؟

35
00:02:14,100 --> 00:02:17,260
هل هُناك مَن لم تُغادر بعد؟

36
00:02:18,160 --> 00:02:19,770
.تبًا، كلا

37
00:02:22,490 --> 00:02:23,890
.مرحبًا

38
00:02:24,580 --> 00:02:25,660
.مرحبًا بكِ

39
00:02:26,220 --> 00:02:28,340
.وَصلت طالبة الدّرس التّالية

40
00:02:28,340 --> 00:02:30,050
.رِيتسُو، ساعدني قليلًا

41
00:02:31,220 --> 00:02:33,920
أَلم تَرحل تلك "الرّوح" مع
مَن رَحلن مِن الطّالبات؟

42
00:02:41,250 --> 00:02:42,660
.سيّدي الشّاب

43
00:02:44,370 --> 00:02:45,930
...إنّه ليس هُنا

44
00:02:45,930 --> 00:02:48,720
كُنت أَودّ سُؤاله إن كان
،بحاجةٍ للمُساعدة

45
00:02:48,730 --> 00:02:50,510
،ولكن بما أنّه غير موجودٍ
.فلا حِيلة لي

46
00:02:50,510 --> 00:02:52,270
،أنت تَعترضُ طريقي
.تنحَّ جانبًا

47
00:02:54,550 --> 00:02:55,830
...أُوغورو

48
00:02:55,830 --> 00:02:58,920
أنت مَن يقفُ عقبةً
.في طريقي يا أُوجيرو

49
00:02:59,520 --> 00:03:01,240
!رَكلتني عمدًا

50
00:03:01,240 --> 00:03:03,050
!أيّها الطّائر الخَبيث

51
00:03:03,050 --> 00:03:06,290
!كُنت تُريد التسلّل لتَملّق السيّد الشّاب

52
00:03:06,290 --> 00:03:07,860
وما العَيب في ذلك؟