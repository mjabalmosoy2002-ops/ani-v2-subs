1
00:00:05,040 --> 00:00:06,910
!ما خطب هؤلاء؟

2
00:00:16,450 --> 00:00:20,950
شيرانوي، ما الّذي يجري؟! ماذا
!يفعل الرّازيتسو في وضح النّهار؟

3
00:00:20,950 --> 00:00:21,950
!وما أدراني؟

4
00:00:22,910 --> 00:00:25,290
!لستُ من أحضرهم معي

5
00:00:25,830 --> 00:00:29,660
أعرف شخصاً واحداً فقط يصنع هؤلاء المسوخ

6
00:00:54,310 --> 00:00:58,640
بدلاً من عيش ألف مستقبل

7
00:01:01,060 --> 00:01:06,100
أريد أن أعيش هذه اللّحظة بالكامل الآن

8
00:01:07,720 --> 00:01:11,850
حتّى لو كنّا على حافّة الهاوية

9
00:01:13,180 --> 00:01:16,560
ما دمتُ معك بينما تمضي مسرعاً للأمام

10
00:01:16,560 --> 00:01:18,890
سأكون كالرّياح المتراقصة

11
00:01:20,600 --> 00:01:22,220
حتّى لو مزّقك سيف الزّمن الّذي لا يُقاوم

12
00:01:22,220 --> 00:01:23,970
مزّقك حتّى تنهار

13
00:01:23,970 --> 00:01:25,640
استمرّ في الحلم وآمن بالنّور

14
00:01:25,640 --> 00:01:26,850
بينما تنظر للسّماء من وقت لآخر

15
00:01:26,850 --> 00:01:30,180
سوف آخذ مكانك

16
00:01:30,180 --> 00:01:33,560
إذا كان القيام بذلك يحميك

17
00:01:33,560 --> 00:01:40,560
فسأتحوّل إلى عاصفة قويّة

18
00:01:40,560 --> 00:01:46,810
قويّة بما يكفي لتغيير القدر الآن

19
00:01:46,890 --> 00:01:55,390
أتحوّل إلى رياح الفجر، الرّياح التي

20
00:01:55,390 --> 00:01:59,180
تفتح باب الظّلام بالقوّة

21
00:02:04,080 --> 00:02:05,250
...لماذا

22
00:02:05,790 --> 00:02:06,750
!أنت هنا؟

23
00:02:08,580 --> 00:02:12,000
!لماذا أحضرت هؤلاء الوحوش إلى هنا بالضّبط؟

24
00:02:13,000 --> 00:02:13,950
!كودو

25
00:02:15,120 --> 00:02:17,870
"ليس من الملائم أن تُطلِق عليهم بـ"الوحوش

26
00:02:18,330 --> 00:02:21,580
أصبح الرّازيتسو الأنواع الّتي سوف
تتفوّق على البشر

27
00:02:21,580 --> 00:02:22,500
ماذا؟

28
00:02:22,790 --> 00:02:25,080
!عالجتُ عيبهم أخيراً

29
00:02:25,080 --> 00:02:28,540
إنّهم سلالةٌ جديدة تستطيع العمل
تحت أشعّة الشّمس

30
00:02:30,000 --> 00:02:34,790
،بواسطة فيلق الرّازيتسو
لن ينتهي إحياء عشيرة يوكيمورا كحلم

31
00:02:35,700 --> 00:02:38,750
أنت من صنع هؤلاء الجنود؟

32
00:02:41,830 --> 00:02:44,410
!كودو، اللّعنة عليك

33
00:02:45,500 --> 00:02:48,950
عصر سلالة شياطين جيدة قد أقبل

34
00:02:49,600 --> 00:02:54,600
الحلقة 3
الملامح البعيدة

35
00:03:05,750 --> 00:03:06,620
مُتعقِّب؟

36
00:03:08,040 --> 00:03:09,120
!انتظر من فضلك

37
00:03:12,410 --> 00:03:13,410
...أنت

38
00:03:17,410 --> 00:03:19,950
أخيراً تمكّنتُ من رؤيتكِ يا تشيزورو

39
00:03:20,290 --> 00:03:22,620
يوكيمورا-كن، هل تعرفينه؟

40
00:03:22,620 --> 00:03:25,200
أجل. التقينا في العاصمة

41
00:03:25,500 --> 00:03:28,700
لكن يا كاورو-سان، لِمَ ترتدي لِباساً بهذه الطّريقة؟

42
00:03:29,120 --> 00:03:30,250
لماذا أنت هنا؟

43
00:03:30,500 --> 00:03:34,200
فهمت... إذاً أوكيتا لم يخبركِ

44
00:03:36,200 --> 00:03:38,450
هذا هو شكلي الحقيقيّ

45
00:03:38,750 --> 00:03:44,450
كان كلّ شيء فعلتُه، من إخفاء جنسي، حتّى
مجيئي إلى هنا، من أجل هدف واحد

46
00:03:45,450 --> 00:03:48,750
أجل، أتيتُ لإنقاذ أختي الصّغرى

47
00:03:49,330 --> 00:03:50,370
أختك...؟

48
00:03:51,620 --> 00:03:54,250
أقصدكِ أنتِ يا تشيزورو

49
00:04:04,200 --> 00:04:06,830
أليس وجهي دليلاً كافياً لكِ؟

50
00:04:07,830 --> 00:04:10,200
إذاً دعيني أستخدم هذا الكاتانا كدليل

51
00:04:11,000 --> 00:04:15,450
الدايتسورين الخاصّ بي هوتوأم الشّوتسورين الخاصّ بكِ

52
00:04:20,200 --> 00:04:25,950
يجدر بكِ أن تدركي بأنّ هذا السّيف قد تمّ
توارثه عبر أجيال عشيرة يوكيمورا

53
00:04:26,580 --> 00:04:29,620
لكن... لم يخبرني أبي أبداً

54
00:04:31,040 --> 00:04:32,410
أبوكِ"؟"

55
00:04:33,290 --> 00:04:36,290
كودو ليس والدنا الحقيقيّ

56
00:04:44,660 --> 00:04:46,540
!وحوش أوغاد

57
00:04:47,540 --> 00:04:49,410
مهما قتلتُ منهم، عددهم لا ينتهي

58
00:04:50,080 --> 00:04:51,910
عصر سلالة جديدة من الشّياطين؟

59
00:04:53,450 --> 00:04:58,250
سيُقضى على اليابان إذا أطلِقَ عنان هؤلاء الوحوش

60
00:04:59,290 --> 00:05:01,160
!هارادا! حان الوقت لهدنة مؤقّتة

61
00:05:01,410 --> 00:05:03,410
!علينا التّعامل مع هؤلاء المزيّفين

62
00:05:08,160 --> 00:05:09,660
لا اعتراض لديّ

63
00:05:13,870 --> 00:05:20,200
بعد أن أُبيدَتْ عشيرة يوكيمورا الشّيطانيّة بواسطة
-البشر لرفضهم مساعدة جماعة معارضة للباكوفو

64
00:05:20,700 --> 00:05:24,200
تمّ تبنّيكِ بواسطة كودو، والّذي كان
ينحدر من فرع تابع لعشيرتنا

65
00:05:24,620 --> 00:05:28,410
حينئذ تمّ تبنّيي بواسطة عشيرة توسا من ناغومو

66
00:05:28,700 --> 00:05:31,830
تفرّقنا عن بعضنا الآخر

67
00:05:34,120 --> 00:05:39,250
والآن أحاول إحياء عشيرة يوكيمورا
رفقة العمّ كودو

68
00:05:40,410 --> 00:05:46,000
إذا استخدمَ ماء الحياة المُعدّل، يستطيع
صنع فيلق رازيتسو بلا نقطة ضعف

69
00:05:46,580 --> 00:05:50,950
يمكننا استخدامهم لإبادة البشر
وبناء عالم من الشّياطين

70
00:05:53,160 --> 00:05:57,750
غالباً، كلّ أصدقائكِ قد قُتِلوا الآن

71
00:05:58,250 --> 00:05:59,250
ماذا؟

72
00:06:00,870 --> 00:06:01,750
!كوندو-سان؟

73
00:06:02,450 --> 00:06:04,120
!يوكيمورا-كن، اهربي

74
00:06:04,120 --> 00:06:05,950
!لا... لا أستطيع

75
00:06:05,950 --> 00:06:07,450
!افعليها! بسرعة

76
00:06:08,200 --> 00:06:11,620
،لن أرحم أيّ شخص يقف بيني وبين تشيزورو

77
00:06:12,370 --> 00:06:15,410
حتّى لو كنتَ قائد الشّينسينغومي

78
00:06:22,200 --> 00:06:23,120
!كوندو-سان

79
00:06:25,870 --> 00:06:27,410
هل فهمت الآن؟

80
00:06:28,080 --> 00:06:31,120
أنا الوحيد القادر على حمايتكِ

81
00:06:32,080 --> 00:06:32,950
!تعالي

82
00:06:33,870 --> 00:06:35,200
تعالي وانضمّي إليّ

83
00:06:36,580 --> 00:06:37,700
...تشيزورو

84
00:06:38,910 --> 00:06:40,000
تعالي الآن

85
00:06:44,870 --> 00:06:45,790
تشيزورو...؟

86
00:06:46,410 --> 00:06:48,790
توقّف يا كاورو-سان

87
00:06:51,250 --> 00:06:53,370
قطعتُ وعداً

88
00:06:53,700 --> 00:06:56,160
أقسمتُ أن أحمي كوندو-سان وأنجو

89
00:06:57,700 --> 00:06:59,290
...قد نكون شقيقين

90
00:06:59,660 --> 00:07:02,290
!لكن سأقاتلك

91
00:07:09,540 --> 00:07:13,540
أتشهرين سيفكِ ضدّ أخيكِ الّذي يشارككِ دمكِ؟

92
00:07:14,120 --> 00:07:16,830
!تنحَّ جانباً من فضلك يا كاورو-سان

93
00:07:17,500 --> 00:07:20,200
هل تدركين كم عانيتُ حتّى وجدتُكِ؟

94
00:07:20,750 --> 00:07:23,370
...تشيزورو، أحبّكِ

95
00:07:23,950 --> 00:07:25,040
ألا تدركين...؟

96
00:07:25,580 --> 00:07:27,540
...وها أنتِ ذي

97
00:07:28,660 --> 00:07:34,040
تفضّلين حماية أولئك البشر
!على عشيرتكِ الشّيطانيّة؟

98
00:07:54,830 --> 00:07:56,540
سأكرّر كلامي مرّة واحدة فقط

99
00:07:57,500 --> 00:07:58,250
...تشيزورو

100
00:08:00,580 --> 00:08:02,370
!تعالي معي

101
00:08:04,160 --> 00:08:08,250
لا أستطيع. لقد... قطعتُ وعداً

102
00:08:10,290 --> 00:08:11,410
...هكذا إذاً

103
00:08:12,580 --> 00:08:13,750
...في هذه الحالة، أنا سوف

104
00:08:15,120 --> 00:08:16,950
!...بيدَي هاتين، أنا سوف

105
00:08:26,830 --> 00:08:27,750
!أوكيتا-سان

106
00:08:27,870 --> 00:08:29,660
أنت عنيد جدّاً

107
00:08:31,750 --> 00:08:33,250
أنت كذلك يا أوكيتا

108
00:08:33,830 --> 00:08:37,870
أنت تبلي حسناً تحت الشّمس. لا بدّ
أنّك تتألّم ألماً مبرحاً

109
00:08:39,580 --> 00:08:42,370
!لهذا يجب عليّ أن أقتلك بسرعة

110
00:08:56,540 --> 00:08:57,910
هارادا

111
00:08:57,910 --> 00:09:02,700
،ما رأيك أن أصرف انتباه المزيّفين
بينما تمهّد أنت طريقاً لرجالك للهرب؟

112
00:09:02,950 --> 00:09:04,830
!...لكن حينئذ أنت

113
00:09:05,250 --> 00:09:08,160
لا تقارنّي بكم أنتم البشر الضُّعفاء

114
00:09:08,450 --> 00:09:12,200
لستُ ضعيفاً لدرجة أسمح لنفسي
بأن يلتهمني هؤلاء الفاشلون

115
00:09:14,540 --> 00:09:16,620
!شينباتشي! يا رجال! سوف ننسحب

116
00:09:17,790 --> 00:09:19,540
!هيّا

117
00:09:52,790 --> 00:09:54,160
ألم أحذّرك؟

118
00:09:54,160 --> 00:09:56,580
لا يستطيع ماء الحياة علاج السلّ

119
00:10:00,290 --> 00:10:02,410
تشيزورو، فلتشهدي

120
00:10:02,830 --> 00:10:05,910
!عليكِ طرح الضّعيف جانباً وقتله هكذا

121
00:10:06,250 --> 00:10:07,290
!أوكيتا-سان

122
00:10:08,160 --> 00:10:09,080
!سوجي

123
00:10:09,500 --> 00:10:11,410
!لا تفعلها

124
00:10:30,330 --> 00:10:32,160
...تشيكاغي كازاما

125
00:10:32,160 --> 00:10:36,950
إنّ خسارة كبريائك كشيطان وتلطيخ
!اسم يوكيمورا أمر لا يُغتفَر

126
00:10:44,910 --> 00:10:48,200
!تشيزورو! تشيزورو

127
00:10:49,750 --> 00:10:50,830
!تشيزورو

128
00:10:54,620 --> 00:10:56,620
!تشيزورو! تشيزورو

129
00:11:01,040 --> 00:11:03,620
تشيزورو، لماذا...؟

130
00:11:17,370 --> 00:11:20,700
لماذا؟ لماذا كنتِ أنتِ دوماً...؟

131
00:11:24,370 --> 00:11:25,330
...كاورو

132
00:11:33,290 --> 00:11:37,000
أعتقد سمعتِ ذلك، لكن كودو
غادر عشيرة ساتسوما

133
00:11:37,200 --> 00:11:39,950
وانحرف عن طريق الشّياطين

134
00:11:39,950 --> 00:11:41,750
يجب أن أقتله

135
00:11:52,410 --> 00:11:53,500
!انتظر من فضلك

136
00:11:56,450 --> 00:11:59,000
!أمهلني بعض الوقت من فضلك

137
00:11:59,750 --> 00:12:01,250
...أنا وأبي

138
00:12:02,950 --> 00:12:04,870
علينا أن نتكلّم

139
00:12:07,450 --> 00:12:10,620
حتّى لو لم نكن مرتبطين بالدّماء، يبقى أبي

140
00:12:11,200 --> 00:12:15,160
لا يجوز أن يُسمَح له باستخدام
الرّازيتسو لإبادة البشريّة بالطّبع

141
00:12:15,450 --> 00:12:19,700
لكن قد يدرك خطيئته إذا تكلّمتُ معه

142
00:12:19,700 --> 00:12:20,750
!أرجوك

143
00:12:22,580 --> 00:12:26,160
حسناً. سأمنحكِ بعض الوقت

144
00:12:27,620 --> 00:12:28,830
!شكراً لك

145
00:12:29,660 --> 00:12:33,410
لا تنسي: الشّياطين دائماً ما يوفون بوعودهم

146
00:12:34,040 --> 00:12:36,830
تصرّفي كشيطانة فخورة والتزمي بكلامكِ

147
00:12:37,580 --> 00:12:38,410
!حسناً

148
00:12:48,250 --> 00:12:52,750
بعد ذلك، تمكنّا بطريقة ما من العودة إلى إيدو

149
00:12:56,790 --> 00:13:01,790
بعد هزيمتنا في كوفو، التجأ الشّينسينغومي
في قصر هاتاموتو

150
00:13:04,540 --> 00:13:08,120
تشربون من الآن؟ عجيب أمركم أنتم العجائز

151
00:13:08,410 --> 00:13:11,790
اصمت! كيف لي ألّا أفعل؟

152
00:13:11,790 --> 00:13:14,950
سانّان-سان، ما رأيك بمُشاطرتنا الشّرب؟

153
00:13:14,950 --> 00:13:15,500
حسناً

154
00:13:15,950 --> 00:13:17,950
لن تدعوني أنا

155
00:13:18,250 --> 00:13:20,370
ما زلتَ صغيراً جدّاً على الشّرب

156
00:13:20,370 --> 00:13:23,580
!ماذا قلت؟

157
00:13:25,370 --> 00:13:28,000
كوندو-سان ليس هنا اليوم أيضاً؟

158
00:13:28,000 --> 00:13:32,700
من واجبات القائد أن يرسم الخطط مع كبار المسؤولين

159
00:13:32,700 --> 00:13:35,790
وجمع مجنّدين جدُد والاهتمام بأمور كثيرة

160
00:13:37,000 --> 00:13:39,540
ليس وكأنّ تجنيد المزيد سينفعنا

161
00:13:40,410 --> 00:13:42,910
لا جدوى إذا كان سيرمي بحياتهم إلى التّهلكة

162
00:13:43,540 --> 00:13:44,660
أليس كذلك يا سايتو؟

163
00:13:46,910 --> 00:13:48,500
لا تضمر ضغينة تجاهه

164
00:13:48,620 --> 00:13:52,750
كانت أوّل مرّة لكوندو-سان يخوض
معركة ضدّ الجيش الإمبراطوريّ

165
00:13:53,080 --> 00:13:56,120
لا يسير كلّ شيء بسلالة في المرّة الأولى

166
00:13:57,580 --> 00:14:01,620
جمع مئات من الرّجال غير المُدرّبين لن يغيّر شيئاً

167
00:14:02,450 --> 00:14:05,410
مُحال أن يتمكّنوا من مقاتلة رازيتسو
يستطيعون الخروج في وضح النّهار

168
00:14:06,120 --> 00:14:08,580
...رازيتسو يستطيعون الخروج في وضح النّهار

169
00:14:09,160 --> 00:14:14,330
اللّعنة! لماذا صنع كودو-سان أولئك الوحوش؟

170
00:14:19,290 --> 00:14:20,370
...تشيزورو

171
00:14:24,580 --> 00:14:25,700
أنا آسفة

172
00:14:26,290 --> 00:14:28,290
لـ-لماذا تعتذرين؟

173
00:14:28,450 --> 00:14:32,410
لا عليكِ! الذّنب ليس ذنبكِ، مفهوم؟

174
00:14:32,410 --> 00:14:34,330
!تـ-تشيزورو

175
00:15:04,250 --> 00:15:05,330
!مرحباً

176
00:15:06,870 --> 00:15:10,000
لهذا كنتِ تخرجين بمفردكِ مؤخّراً إذاً؟

177
00:15:10,450 --> 00:15:11,330
أجل

178
00:15:11,330 --> 00:15:16,540
لكن في النّهاية، المكان الوحيد الّذي يخطر
على ذهني هو المنزل الّذي عشتُ فيه أنا وأبي

179
00:15:16,830 --> 00:15:18,660
عانيتِ كثيراً أيضاً

180
00:15:19,500 --> 00:15:24,000
عندما جلستُ وفكّرتُ في الأمر، أدركتُ
بأنّني لا أعرف شيئاً عن أبي

181
00:15:24,700 --> 00:15:27,500
...أمور كثيرة أريد أن أقولها له عندما أراه

182
00:15:28,500 --> 00:15:29,370
!أعلم

183
00:15:29,370 --> 00:15:32,000
مضى وقتٌ طويل، لذا ما رأيكِ
أن نتناول بعض الدّانغو؟

184
00:15:32,120 --> 00:15:32,950
ماذا؟

185
00:15:35,250 --> 00:15:37,410
شعرتِ بالإحباط هكذا من قبل

186
00:15:38,200 --> 00:15:41,250
كان ذلك في كيوتو. عندما أتت سين للزّيارة

187
00:15:45,620 --> 00:15:50,660
حدث ذلك مؤخّراً نسبيّاً، مع ذلك
أشعر وكأنّه مضى وقت طويل

188
00:15:51,830 --> 00:15:52,750
...أجل

189
00:16:03,750 --> 00:16:04,750
!أوكيتا-سان

190
00:16:05,950 --> 00:16:08,000
مرحبا! كيف حالك؟

191
00:16:08,790 --> 00:16:09,660
ما هذا؟

192
00:16:09,950 --> 00:16:13,660
من النّادر أن يزورني سانو-سان

193
00:16:13,660 --> 00:16:17,540
،وجدنا بعض الدّانغو الّذي يبدو شهيّاً
فأحضرنا لك قليلاً

194
00:16:18,790 --> 00:16:20,750
هل صار المستحيل ممكناً؟

195
00:16:20,750 --> 00:16:24,120
!ماذا؟! وأنا الّذي كنتُ لطيفاً بما يكفي لزيارتك

196
00:16:24,120 --> 00:16:25,580
!كُن ممتنّاً وكُل

197
00:16:26,910 --> 00:16:30,330
أنا واثقٌ بأنّك أتيت كي تأكل
بعضاً من ذلك الدّانغو

198
00:16:31,700 --> 00:16:33,660
هل أنت بخير يا أوكيتا-سان؟

199
00:16:39,790 --> 00:16:42,370
لا تقلقي كثيراً، أنا بخير

200
00:16:42,620 --> 00:16:46,580
"تعرفين المقولة، "لا يمكنك قتل عشبة ضارّة

201
00:16:47,000 --> 00:16:47,910
...أجل

202
00:16:48,580 --> 00:16:51,910
أجل"؟ كان من المُفترض ألّا توافقيني"

203
00:16:52,830 --> 00:16:54,500
!أنا آسفة

204
00:16:56,700 --> 00:16:58,830
ماذا؟ ما الأمر؟

205
00:16:59,580 --> 00:17:03,120
لا شيء! انسي الأمر وأعدّي لنا الشّاي يا تشيزورو

206
00:17:03,370 --> 00:17:04,750
...حـ-حسناً

207
00:17:23,160 --> 00:17:24,950
هل كوندو-سان على ما يُرام؟

208
00:17:25,950 --> 00:17:30,080
لا أدري. لم أره منذ ذلك الحين

209
00:17:32,910 --> 00:17:34,250
...حسناً

210
00:17:42,830 --> 00:17:45,250
حسناً يا أوكيتا-سان. سنعود لاحقاً

211
00:17:51,540 --> 00:17:53,580
بلِّغ تحيّاتي لشينباتشي

212
00:17:57,500 --> 00:17:58,370
!حسناً

213
00:18:15,830 --> 00:18:18,620
!حضرة القائد

214
00:18:19,290 --> 00:18:20,750
!تسرّني رؤيتك بصحّة جيّدة

215
00:18:20,910 --> 00:18:21,750
!كنتُ قلقاً للغاية

216
00:18:26,450 --> 00:18:27,370
!كوندو-سان

217
00:18:29,450 --> 00:18:32,290
أريد أن أتكلّم معك. ممكن؟

218
00:18:33,250 --> 00:18:35,790
ما الأمر يا ناغاكورا-كن؟ تتصرّف برسميّة

219
00:18:36,450 --> 00:18:39,790
يجب أن نتكلّم على انفراد. في مكان آخر

220
00:18:49,200 --> 00:18:50,790
أنت كذلك يا هارادا؟

221
00:18:50,790 --> 00:18:56,120
،أجل. إذا أراد شينباتشي المغادرة
فسأذهب معه غالباً

222
00:18:56,660 --> 00:18:57,580
...هكذا إذاً

223
00:19:08,790 --> 00:19:10,950
شكراً على الاعتناء بنا يا تشيزورو-تشان

224
00:19:11,660 --> 00:19:13,330
هل ستغادران حقّاً؟

225
00:19:13,620 --> 00:19:14,450
...أجل

226
00:19:17,370 --> 00:19:19,450
!هيسكي-كن! سأذهب لإحضار هيسكي-كن -

227
00:19:19,450 --> 00:19:19,830
ودّعناه بالفعل -
!هيسكي-كن! سأذهب لإحضار هيسكي-كن -

228
00:19:19,830 --> 00:19:22,290
ودّعناه بالفعل -

229
00:19:22,290 --> 00:19:24,950
أنا واثق بأنّه غطَّ في النّوم بعد امتعاضه الشّديد

230
00:19:30,040 --> 00:19:33,200
هل عليكما مغادرة الفيلق حقّاً؟

231
00:19:34,870 --> 00:19:37,160
حسناً، لدينا أسبابنا

232
00:19:37,450 --> 00:19:43,040
،بخلاف كوندو-سان أو هيجيكاتا-سان
لم يكن حلمي أن أصبح ساموراي

233
00:19:43,830 --> 00:19:49,830
إنَّ تكريس حياتي لحاكم ما ليس من اختياري
لا يلائم ذوقي نهائيّاً

234
00:19:51,370 --> 00:19:56,950
،مهما حدث، لا أريد أن أقول لنفسي
"يا رجل! ليتني فعلتُ ذلك"

235
00:19:58,410 --> 00:19:59,500
...زعيم

236
00:20:00,370 --> 00:20:04,250
سايتو، هل تنوي البقاء هنا حتّى النّهاية؟

237
00:20:05,290 --> 00:20:09,290
ثمّة شيء هنا ما زال عليّ القيام به

238
00:20:09,910 --> 00:20:10,750
عُلِم

239
00:20:11,540 --> 00:20:14,790
تشيزورو، لطالما أردتُ حمايتكِ

240
00:20:15,040 --> 00:20:17,620
أنا آسف لأنّه يبدو وكأنّ عليّ التخلّي عنكِ
قبل أن يُحسَم كلّ شيء

241
00:20:18,620 --> 00:20:19,910
...هارادا-سان

242
00:20:29,750 --> 00:20:33,160
"-لا تحزني هكذا! "الحظّ السّعيد يدخل أبواب المُبتسمين

243
00:20:33,160 --> 00:20:36,080
...لا أستطيع أن أبتسم! ليس في لحظة كهذه

244
00:20:36,580 --> 00:20:38,700
ينبغي أن تبتسمي لأنّنا في لحظة كهذه

245
00:20:38,700 --> 00:20:42,500
لا تقلقي. أنا متأكّدٌ بأنّه سوف يحميكِ

246
00:20:48,700 --> 00:20:50,620
!ولا تنسي

247
00:20:50,790 --> 00:20:55,660
سنظلّ نخوض نفس المعارك في مكان
ما تحت نفس السّماء

248
00:20:56,000 --> 00:20:56,540
!أجل

249
00:20:57,500 --> 00:21:00,700
!ما زلنا نقاتل كلاب ساتسوما-تشوشو أولئك

250
00:21:01,330 --> 00:21:03,500
هذا ليس وداعنا الأخير

251
00:21:08,660 --> 00:21:11,080
حسناً، حريّ بنا أن نذهب

252
00:21:12,660 --> 00:21:14,580
!بالتّوفيق لكما

253
00:21:15,200 --> 00:21:16,330
أنتِ أيضاً يا تشيزورو

254
00:21:36,100 --> 00:21:41,760
أحدِّق في وجهك

255
00:21:41,760 --> 00:21:47,760
تضيئه شمس الغروب الحمراء الدّاكنة

256
00:21:47,760 --> 00:22:00,180
أتمنّى من السّماء الملتهبة إيقاف الزّمن

257
00:22:00,640 --> 00:22:11,560
تحاول بجدّية المضيّ قدماً بينما تحمل أعباء حزنك

258
00:22:11,560 --> 00:22:24,390
إن أمكن، أريد أن أتبعك عبر هذا الدّرب الوعر

259
00:22:24,390 --> 00:22:31,260
تتحرّك الغيوم من بعيد، بعيد جدّاً

260
00:22:31,260 --> 00:22:36,890
حتّى لو دام هذا لِلَحظة فقط

261
00:22:36,890 --> 00:22:39,810
أريد أن أكون معك

262
00:22:39,810 --> 00:22:50,850
الشّمس الّتي تصبغ قلبي ستدوم للأبد

263
00:22:51,180 --> 00:22:56,930
لذا آمن بروابطنا فحسب

264
00:23:01,830 --> 00:23:04,040
توشي، لا داعي لتذهب أنت

265
00:23:04,330 --> 00:23:06,040
سأذهب إلى الوحدة الرّئيسيّة للعدوّ

266
00:23:06,580 --> 00:23:08,200
!ماذا أصابك يا كوندو-سان؟

267
00:23:08,950 --> 00:23:10,370
اتّخذتُ قراري

268
00:23:10,370 --> 00:23:11,700
!كفاك هراء

269
00:23:11,700 --> 00:23:13,370
!هذا أمرٌ إذاً

270
00:23:13,260 --> 00:23:15,310
الحلقة القادمة
الولاء الأبديّ