1
00:00:03,270 --> 00:00:07,220
بعد أن تغلّب عليهم السّلاح المتطوّر
،الّذي يستخدمه جيش الحكومة الجديدة

2
00:00:07,220 --> 00:00:09,850
تكبّد الشّينسينغومي خسائرَ فادحة

3
00:00:11,240 --> 00:00:17,370
كانت معركة توبا-فوشيمي بمثابة تذكير للمحاربين
بأنّ عصراً جديداً قد أقبل

4
00:00:43,000 --> 00:00:47,200
بدلاً من عيش ألف مستقبل

5
00:00:49,750 --> 00:00:55,000
أريد أن أعيش هذه اللّحظة بالكامل الآن

6
00:00:56,330 --> 00:01:00,500
حتّى لو كنّا على حافّة الهاوية

7
00:01:01,830 --> 00:01:05,250
ما دمتُ معك بينما تمضي مسرعاً للأمام

8
00:01:05,250 --> 00:01:07,870
سأكون كالرّياح المتراقصة

9
00:01:09,250 --> 00:01:10,910
حتّى لو مزّقك سيف الزّمن الّذي لا يُقاوم

10
00:01:10,910 --> 00:01:12,580
مزّقك حتّى تنهار

11
00:01:12,580 --> 00:01:14,200
استمرّ في الحلم وآمن بالنّور

12
00:01:14,200 --> 00:01:15,540
بينما تنظر للسّماء من وقت لآخر

13
00:01:15,540 --> 00:01:18,870
سوف آخذ مكانك

14
00:01:18,870 --> 00:01:22,250
إذا كان القيام بذلك يحميك

15
00:01:22,250 --> 00:01:29,250
فسأتحوّل إلى عاصفة قويّة

16
00:01:29,250 --> 00:01:35,450
قويّة بما يكفي لتغيير القدر الآن

17
00:01:35,540 --> 00:01:44,080
أتحوّل إلى رياح الفجر، الرّياح التي

18
00:01:44,080 --> 00:01:47,870
تفتح باب الظّلام بالقوّة

19
00:01:51,540 --> 00:01:57,660
يناير
1868

20
00:01:52,350 --> 00:01:54,780
،في يناير 1868، السّنة الرّابعة من حقبة كيو

21
00:01:54,780 --> 00:02:00,290
عاد الشّينسينغومي إلى إيدو، بغية اللّجوء
في شيناغاوا، كامايا

22
00:01:57,660 --> 00:01:59,660
الحقيقة

23
00:02:02,460 --> 00:02:05,810
هيجيكاتا-سان، الشّاي جاهز

24
00:02:08,810 --> 00:02:11,080
هيجيكاتا-سان، سأفتح الباب

25
00:02:16,080 --> 00:02:20,670
كان هيجيكاتا-سان يعمل من دون طعام
أو نوم في الأيّام القليلة الماضية

26
00:02:22,260 --> 00:02:25,340
بدأت علامات الإرهاق تظهر عليه يوماً بعد يوم

27
00:02:30,680 --> 00:02:33,430
...هيجيكاتا-سان، من فضلك

28
00:02:33,430 --> 00:02:35,980
ألن تنل قسطاً من الرّاحة؟

29
00:02:35,980 --> 00:02:38,480
وجهك شاحب

30
00:02:38,480 --> 00:02:40,480
هذا ليس من شأنكِ

31
00:02:42,650 --> 00:02:43,360
نائب القائد

32
00:02:43,990 --> 00:02:45,400
ما الأمر؟

33
00:02:45,400 --> 00:02:49,450
المسؤول الشّوغونيّ الّذي كان من المُفترض
أن نلتقي به اليوم قد أرسل رسالة

34
00:02:49,450 --> 00:02:52,910
إنّه غير قادر على الوفاء بوعده وسوف
يلتقي بنا في يوم آخر

35
00:02:52,910 --> 00:02:54,120
ماذا؟

36
00:02:55,620 --> 00:03:00,630
سأتكلّم معهم بلهجة قاسية اليوم

37
00:03:01,090 --> 00:03:02,250
سأغادر

38
00:03:04,760 --> 00:03:06,130
!هيجيكاتا-سان

39
00:03:07,510 --> 00:03:10,720
،رغم أنّنا عدنا إلى إيدو

40
00:03:10,720 --> 00:03:13,560
ما زال مُجتهداً ومُصمّماً في عمله

41
00:03:13,560 --> 00:03:15,140
...أجل

42
00:03:15,140 --> 00:03:16,430
...يتساءل الرّجال أيضاً

43
00:03:16,430 --> 00:03:21,150
متى ينام نائب القائد إذا كان يعمل بهذا الجدّ؟

44
00:03:21,650 --> 00:03:23,980
من أجل إيجاد الوقت المثاليّ للاشتباك
،مع قوّات ساتسوما وتشوشو

45
00:03:23,980 --> 00:03:28,490
كان يلتقي بشكل متكرّر مع قادة الشّوغن

46
00:03:28,490 --> 00:03:29,780
...إنّه

47
00:03:32,620 --> 00:03:37,620
الحلقة 1
كاللَّهب

48
00:03:39,330 --> 00:03:41,170
،لقد بدأت المعركة للتوّ

49
00:03:41,170 --> 00:03:44,050
وقائد الشّوغن قد هرب بالفعل

50
00:03:44,050 --> 00:03:45,800
هذا لا يُصدَّق

51
00:03:46,210 --> 00:03:50,180
ماذا سيحدث برأيك بعد ذلك؟

52
00:03:50,800 --> 00:03:52,800
،حتّى لو اضطررنا لمقاتلة ساتسوما وقوّات تشوشو

53
00:03:52,800 --> 00:03:55,010
لا تستطيع سيوفنا هزيمة أسلحتهم النّاريّة

54
00:04:38,850 --> 00:04:43,350
"من فضلك حاول أن تأكل شيئاً"

55
00:04:55,240 --> 00:04:56,780
...اللّعنة

56
00:04:57,990 --> 00:04:59,750
هيجيكاتا-سان

57
00:05:00,960 --> 00:05:02,290
هيجيكاتا-سان؟

58
00:05:14,390 --> 00:05:15,760
ما الأمر؟

59
00:05:15,760 --> 00:05:17,510
ما زلت حيّاً؟

60
00:05:17,510 --> 00:05:21,140
المعذرة... هل هناك ما أستطيع فعله؟

61
00:05:21,140 --> 00:05:22,560
لا

62
00:05:22,560 --> 00:05:25,060
كفّي عن القلق واخلدي إلى النّوم

63
00:05:25,690 --> 00:05:29,610
لكن... أريد تقديم المساعدة

64
00:05:29,610 --> 00:05:32,070
أريد أن أكون مفيدة للجميع

65
00:05:38,580 --> 00:05:40,080
هذا كلّ شيء

66
00:05:40,080 --> 00:05:41,080
!أرجوك

67
00:05:42,330 --> 00:05:43,580
...عجباً

68
00:05:50,130 --> 00:05:52,470
تريدين تقديم المساعدة؟

69
00:05:53,420 --> 00:05:54,470
أجل

70
00:05:55,260 --> 00:06:00,010
هل تعتقدين بأنّكِ ارتكبتِ خطأ؟

71
00:06:00,010 --> 00:06:01,470
...لا

72
00:06:01,470 --> 00:06:04,480
هل تفعلين هذا من منطلق المنفعة الذّاتيّة؟

73
00:06:04,480 --> 00:06:05,980
لا

74
00:06:07,400 --> 00:06:12,240
الجميع وضعوا حياتهم على المحكّ لحمايتي حتّى الآن

75
00:06:15,740 --> 00:06:21,240
لهذا أريد أن أفعل كلّ ما يمكنني
فعله من أجل مساعدة الجميع

76
00:06:21,240 --> 00:06:23,500
إذاً لا تحني رأسكِ بهذه السّهولة

77
00:06:24,830 --> 00:06:28,420
فأنتِ لم تخطئي

78
00:06:29,790 --> 00:06:31,000
أجل

79
00:06:32,460 --> 00:06:37,010
حسناً إذاً، أوّلاً، أحضري لي فنجاناً من الشّاي

80
00:06:38,430 --> 00:06:40,430
وليكن لذيذاً

81
00:06:40,430 --> 00:06:41,510
!حاضرة

82
00:06:42,390 --> 00:06:44,520
!اعتمد عليّ

83
00:06:46,270 --> 00:06:48,520
هيجيكاتا-سان

84
00:06:48,520 --> 00:06:51,860
كيفما أنظر للأمر، أشعر بأنّك تتساهل مع تشيزورو

85
00:06:51,860 --> 00:06:53,030
اصمت

86
00:06:56,780 --> 00:06:59,030
أجهدت نفسك كثيراً في العمل. هل أنت بخير؟

87
00:06:59,030 --> 00:07:02,040
لا حاجة للقلق

88
00:07:02,660 --> 00:07:06,540
العمل أثناء النّهار بجسد رازيتسو صعب، أليس كذلك؟

89
00:07:07,290 --> 00:07:11,130
لا سيّما عندما تأتي نوبة التعطُّش تلك

90
00:07:15,800 --> 00:07:17,470
،تناول هذا

91
00:07:17,470 --> 00:07:19,720
رغم أنّه يخفّف الألم بشكل مؤقّت فقط

92
00:07:19,720 --> 00:07:21,550
لا أحتاجه

93
00:07:22,220 --> 00:07:23,930
،بعد المعركة السّابقة

94
00:07:23,930 --> 00:07:26,560
بدأ كثير من النّاس بالقلق من الموت نتيجة جروحهم

95
00:07:27,100 --> 00:07:30,560
حاليّاً، أنا الوحيد القادر على قيادة الشّينسينغومي

96
00:07:31,480 --> 00:07:37,200
يجب أن أحرص على أن نكون جاهزين
للمعركة حالما يعود كوندو-سان

97
00:07:37,200 --> 00:07:39,070
معك حقّ

98
00:07:40,370 --> 00:07:43,990
...ثمّة أمر آخر، بخصوص سانّان-سان

99
00:07:46,120 --> 00:07:51,210
بعد ذلك بفترة قصيرة، نصّب الشّينسينغومي
مقرّهم الجديد في قصر أكيزوكي

100
00:07:54,800 --> 00:07:56,840
يوكيمورا-كن

101
00:08:01,760 --> 00:08:03,350
!سانّان-سان

102
00:08:05,010 --> 00:08:07,600
هل يمكنك الاستيقاظ أثناء النّهار؟

103
00:08:07,600 --> 00:08:08,390
أجل

104
00:08:09,850 --> 00:08:12,610
خطرَتْ على ذهني فكرة رائعة

105
00:08:13,360 --> 00:08:16,110
لدرجة لم أستطع النّوم

106
00:08:16,820 --> 00:08:18,110
فكرة؟

107
00:08:18,110 --> 00:08:20,280
أنتِ شيطانة

108
00:08:20,280 --> 00:08:26,490
وقوّة الشّيطان وحيويّته أعلى بكثير
من قوّة البشر العاديّين

109
00:08:27,000 --> 00:08:33,840
لذا ربّما يحتوي دماء الشّيطان على قوّة
لقمع تعطّش الدّماء لدى الرّازيتسو

110
00:08:39,760 --> 00:08:41,680
ماذا تقول؟

111
00:08:41,680 --> 00:08:44,150
ألا يوجد دواء يستطيع فعل ذلك؟

112
00:08:44,490 --> 00:08:48,140
هذا إجراء مؤقّت

113
00:08:48,950 --> 00:08:55,150
قد يستطيع دمُكِ إنقاذنا جميعاً

114
00:08:55,150 --> 00:08:58,410
لم أقل بأنّني سوف أقتلكِ

115
00:08:59,730 --> 00:09:05,010
أريدكِ فقط أن تشاركي قليلاً من دمكِ معي

116
00:09:09,430 --> 00:09:12,050
ماذا تفعل يا سانّان-سان؟

117
00:09:13,580 --> 00:09:15,280
هيجيكاتا-كن

118
00:09:15,280 --> 00:09:18,540
،إذا أردنا استخدام الرّازيتسو بفعاليّة أكبر

119
00:09:18,540 --> 00:09:23,540
فعلينا إيجاد طريقة لقمع تعطّشهم للدّماء

120
00:09:23,540 --> 00:09:25,690
هل تضحّي بها لأجل ذلك؟

121
00:09:25,690 --> 00:09:28,560
أحتاج قليلاً من دمها فحسب

122
00:09:28,560 --> 00:09:32,640
المعركة المقبلة ستكون أصعب بالنّسبة للشّينسينغومي

123
00:09:33,060 --> 00:09:37,180
إذا كانت يوكيمورا-كن غير راغبة في إراقة
...بعض الدّماء من أجل ذلك

124
00:09:37,670 --> 00:09:39,690
ليس هنا بيت القصيد

125
00:09:42,520 --> 00:09:44,550
ليس باليد حيلة إذاً

126
00:09:44,550 --> 00:09:46,810
سأتراجع هذا اليوم

127
00:09:47,410 --> 00:09:52,830
لكن بما أنّك الآن أحد الرّازيتسو، فيجدر
...بك أن تعرف العواقب جيّداً

128
00:09:53,990 --> 00:09:55,330
سانّان-سان

129
00:09:55,830 --> 00:10:01,670
لم تكن تستخدم الشّينسينغومي كغطاء
سعياً للدّماء، صحيح؟

130
00:10:01,670 --> 00:10:07,010
لا. لطالما أعطيتُ الأولويّة لمصالح الشّينسينغومي

131
00:10:11,850 --> 00:10:13,390
هل أنتِ بخير؟

132
00:10:13,410 --> 00:10:14,750
أجل

133
00:10:14,750 --> 00:10:17,000
شكراً جزيلاً لك

134
00:10:17,000 --> 00:10:19,850
لا تتجوّلي في الخارج ليلاً

135
00:10:20,270 --> 00:10:25,030
مؤخّراً، يبدو أنّ سانّان-سان يخرج للحِراسة
أكثر من المعتاد

136
00:10:25,020 --> 00:10:27,100
،ولا أدري إن كان للأمر صِلة

137
00:10:27,540 --> 00:10:30,120
لكن عدد الأشخاص الّذين قُتِلوا في إيدو قد ازداد

138
00:10:30,240 --> 00:10:34,000
لكن ماذا عن الرّازيتسو الّذي كان
يقتل المدنيّين في  اللّيل

139
00:10:34,010 --> 00:10:36,500
ويدّعي بأنّه يؤدّي واجب الحراسة؟
هل لديك علم بهذا؟

140
00:10:36,620 --> 00:10:39,580
...إذاً رواية كيميغيكو-سان

141
00:10:39,580 --> 00:10:43,270
حتّى ولو كان صديقاً، لا يمكننا تجاهل هذا

142
00:10:43,270 --> 00:10:45,650
سيترتّب علينا التّعامل مع الأمر

143
00:10:46,630 --> 00:10:48,640
...هكذا إذاً

144
00:10:50,950 --> 00:10:55,400
هيجيكاتا-سان، هل جسدك بخير حقّاً؟

145
00:10:55,400 --> 00:10:58,260
قلتُ لكِ لا تتدّخلي في شؤوني

146
00:11:02,020 --> 00:11:02,890
!هيجيكاتا-سان

147
00:11:07,700 --> 00:11:09,200
...هيجيكاتا-سان

148
00:11:21,860 --> 00:11:23,970
ألا ينبغي أن تكون نائماً؟

149
00:11:24,330 --> 00:11:25,450
تشيزورو-تشان

150
00:11:25,940 --> 00:11:28,120
لم أتوقّع أن تتمكّني من إيجادي هنا

151
00:11:28,120 --> 00:11:33,980
،كان سايتو-سان سيتدرّب في أوينو
لذا أحضرني إلى هنا

152
00:11:34,420 --> 00:11:36,490
كيف حالك؟

153
00:11:36,490 --> 00:11:38,580
،الجروح تُشفى بشكل بطيء

154
00:11:38,580 --> 00:11:40,970
غالباً بسبب الرّصاص الفضّي

155
00:11:41,490 --> 00:11:43,060
كيف حالُ الجميع؟

156
00:11:45,130 --> 00:11:46,470
يعملون بجدّ

157
00:11:46,990 --> 00:11:48,700
لا سيّما هيجيكاتا-سان

158
00:11:48,700 --> 00:11:52,490
لم يكن نائماً، بل وحتّى تولّى عمل كوندو-سان

159
00:11:55,010 --> 00:11:58,990
...ليتني أُشفَى من جروحي

160
00:11:59,370 --> 00:12:08,010
كلّ ما أجيده هو القتل، لذا إذا كنتُ لا أستطيع
فعل حتّى ذلك، فلا يحقّ لي أن أقف بجانب كوندو-سان

161
00:12:11,020 --> 00:12:13,770
ركّز على التحسُّن حاليّاً من فضلك

162
00:12:13,770 --> 00:12:16,010
!تفضّل، اشرب

163
00:12:29,000 --> 00:12:30,020
مذاقه لذيذ

164
00:12:33,200 --> 00:12:35,270
شكراً لك

165
00:12:35,740 --> 00:12:38,690
هيجيكاتا-سان يحبّه أيضاً

166
00:12:43,700 --> 00:12:47,050
أنا آسف لأنّني أقلقتُ الجميع

167
00:12:47,420 --> 00:12:52,550
لم أتوقّع أن يكون عدم المشاركة في المعركة
تجربة بغيضة بهذا الشّكل

168
00:12:52,550 --> 00:12:54,940
هل تلتئم جروحك كما ينبغي؟

169
00:12:54,940 --> 00:12:56,790
...أجل، انظر

170
00:13:02,190 --> 00:13:03,930
هذا جيّد

171
00:13:04,340 --> 00:13:07,440
حسناً إذاً، سأشرح خطّتنا

172
00:13:07,440 --> 00:13:10,890
سنعيد تنظيم أنفسنا تحت مسمّى
،وحدة كويو تشينبوتاي

173
00:13:10,890 --> 00:13:13,690
وسنستولي على قلعة كوفو كما أُمِرنا

174
00:13:18,440 --> 00:13:20,880
،لحماية أنفسنا من حلف ساتسوما-تشوشو

175
00:13:20,870 --> 00:13:27,090
زوّدتنا الشّوغونيّة بمدفعيّتين وأسلحة ناريّة
والتّمويل اللّازم للحملة العسكريّة

176
00:13:27,100 --> 00:13:29,250
،إذا أنجزنا هذه المهمّة بنجاح

177
00:13:29,250 --> 00:13:32,860
فقد تمنحنا الشّوغونيّة قلعة كوفو

178
00:13:32,860 --> 00:13:35,210
!يا رجال، لنبذل قصارى جهدنا

179
00:13:39,190 --> 00:13:40,900
كوندو-سان

180
00:13:40,900 --> 00:13:44,590
من بلّغنا بأمر الدّفاع عن قلعة كوفو؟

181
00:13:44,590 --> 00:13:47,290
كان كاتسو أوانوكامي-دونو

182
00:13:47,290 --> 00:13:49,100
هل هناك مشكلة؟

183
00:13:49,100 --> 00:13:51,100
...كاتسو

184
00:13:51,100 --> 00:13:53,850
سمعتُ بأنّه يمقت هذه الحرب

185
00:13:53,850 --> 00:13:59,110
من أين له هذا السّخاء حتّى يزوّدنا بمدفعيّات وأموال؟

186
00:13:59,700 --> 00:14:02,520
على ذكر الأمر، حتّى الشّوغن توكوغاوا-دونو بنفسه

187
00:14:02,520 --> 00:14:05,640
أراد الانضمام لقوّات الحكومة الجديدة

188
00:14:05,640 --> 00:14:09,500
أعتقد أنّ كاتسو هذا يفكّر بنفس الطّريقة

189
00:14:09,850 --> 00:14:13,010
،بالفعل، مع استمرار في الحرب بالطّريقة الرّاهنة

190
00:14:13,010 --> 00:14:17,400
يوشينوبو يتجنّب أيضاً الصّراع مع قوّات الحكومة الجديدة

191
00:14:17,400 --> 00:14:19,850
لكن ما دمنا نستطيع الصُّمود في قلعة كوفو

192
00:14:19,850 --> 00:14:21,120
،ونذيق الجميع طعم النّصر

193
00:14:21,120 --> 00:14:23,010
سيدعمنا جيشُ الشّوغن بكامل عتاده

194
00:14:24,400 --> 00:14:27,510
بالإضافة إلى ذلك، المسألة لا تتعلّق
باحتماليّة نصرنا من عدمها

195
00:14:27,980 --> 00:14:33,030
المسألة تتعلّق بحماية قلعة كوفو لمدّة
طويلة بما يكفي لاعترافهم بنا

196
00:14:33,030 --> 00:14:38,410
وهذه المرّة، مُنِحتُ لقب دايميو

197
00:14:38,400 --> 00:14:40,540
!بعبارة أخرى، منصب رفيع

198
00:14:40,540 --> 00:14:42,670
أكثر الشّجعان بين المقاتلين

199
00:14:42,670 --> 00:14:44,670
سأعيّنه خادمي

200
00:14:44,670 --> 00:14:46,430
اعملوا بجدٍّ جميعاً

201
00:14:47,390 --> 00:14:50,310
أنا قائد فرقة في الشّينسينغومي

202
00:14:50,310 --> 00:14:54,260
لكن لا أنوي أن أكون خادمك

203
00:15:01,680 --> 00:15:05,240
سايتو، ما رأيك؟

204
00:15:05,230 --> 00:15:08,230
سأطيع أوامر القائد ونائب القائد

205
00:15:13,410 --> 00:15:18,060
،حاليّاً، تحضيراً للمعركة المقبلة
سيكون هناك زيادة في أعدادنا

206
00:15:18,700 --> 00:15:22,580
،إذا استطعنا حماية قلعة كوفو
فينبغي للشّوغونيّة أن ترسل تعزيزات

207
00:15:22,580 --> 00:15:26,320
وبالنّسبة للآراء الّتي لدينا حول
،كاتسو أوانوكامي

208
00:15:26,820 --> 00:15:28,700
،مهما كان يكره الحرب

209
00:15:28,700 --> 00:15:30,930
ما نواجهه الآن هو وضع محتوم

210
00:15:30,930 --> 00:15:33,130
يجدر به أن يتفهّم ذلك

211
00:15:33,130 --> 00:15:36,350
أجل، وجهة نظرك سديدة

212
00:15:37,190 --> 00:15:41,090
على أي حال، يجب علينا الاستعداد للمعركة

213
00:15:42,610 --> 00:15:44,460
هناك مشكلة أخرى

214
00:15:44,460 --> 00:15:47,600
هذه المرّة، سينتظر فيلق الرّازيتسو الأوامر هنا

215
00:15:47,600 --> 00:15:49,440
لماذا؟

216
00:15:49,440 --> 00:15:54,430
لن يكون الشّينسينغومي بمفردهم في قلعة
كوفو. ستكون تعزيزاتنا هناك أيضاً

217
00:15:54,440 --> 00:15:56,860
إذا رأوا هيئتكم الحقيقيّة، ستقع مشكلة

218
00:15:56,860 --> 00:15:57,880
...لكن

219
00:15:57,880 --> 00:16:01,700
اصبر. الحرب في بدايتها

220
00:16:09,580 --> 00:16:13,170
حسناً، أسرعوا واستعدّوا للزّحف إلى قلعة كوفو

221
00:16:13,180 --> 00:16:15,180
أتمنّى التّوفيق للجميع

222
00:16:15,180 --> 00:16:16,500
انصراف

223
00:16:30,370 --> 00:16:33,000
...لا أكترث لأي منصب رفيع

224
00:16:33,000 --> 00:16:36,170
ما الّذي يفكّر فيه كوندو-سان بالضّبط؟

225
00:16:36,170 --> 00:16:39,780
...ماذا لو مُنِح منصب رفيع في هذا الوقت

226
00:16:40,410 --> 00:16:45,410
بدأ كوندو-سان كرئيس دوجو صغير

227
00:16:45,780 --> 00:16:47,410
أجل

228
00:16:48,350 --> 00:16:54,550
لكن لم يتباهَ كوندو-سان بمركزه أمامنا من قبل

229
00:16:54,550 --> 00:16:58,040
لهذا اتّبعتُه لفترة طويلة

230
00:16:58,660 --> 00:17:00,300
...مع ذلك

231
00:17:01,220 --> 00:17:02,730
...أجل

232
00:17:02,730 --> 00:17:05,570
والآن يريد قلعة كوفو؟

233
00:17:05,570 --> 00:17:09,760
هل يريدنا أن نعمل كحرّاس بوّابة هناك؟

234
00:17:09,760 --> 00:17:13,560
لكن كلّ ما يمكننا فعله الآن هو الوثوق بالقائد

235
00:17:14,400 --> 00:17:15,820
أجل

236
00:17:28,890 --> 00:17:31,170
الجميع مستيقظون من الآن

237
00:17:31,170 --> 00:17:33,960
مرحباً يا تشيزورو! الوقت باكر، أليس كذلك؟

238
00:17:38,350 --> 00:17:40,000
!ماذا؟

239
00:17:40,950 --> 00:17:43,430
لماذا ترتدي هذا اللّباس؟

240
00:17:43,430 --> 00:17:45,760
إنّها أوامر هيجيكاتا-سان

241
00:17:45,760 --> 00:17:50,480
باستثناء أولئك الّذين لا يستطيعون ارتداء شيء غير الزيّ
الرّسميّ المعتاد، يتوجّب علينا جميعنا أن نلبس هذا

242
00:17:50,480 --> 00:17:54,220
تبّاً، يبدو لباساً شاذّاً لدرجة تؤرقني

243
00:17:54,900 --> 00:17:56,610
هيسكي-كن أيضاً

244
00:17:57,760 --> 00:18:00,090
تبدو وكأنّك لست أنت

245
00:18:01,520 --> 00:18:04,110
...إنّه ضيّق قليلاً هنا

246
00:18:04,800 --> 00:18:07,630
،بما أنّ العدوّ يرتدي هذا اللّباس الغربيّ

247
00:18:07,630 --> 00:18:11,450
فربّما يكون أنسب للحروب الغربيّة

248
00:18:15,010 --> 00:18:16,470
بالفعل

249
00:18:16,470 --> 00:18:19,880
وسيكون استخدام الأسلحة النّاريّة أنسب بكثير

250
00:18:19,880 --> 00:18:23,520
لكن هذه الأزرار مزعجة للغاية

251
00:18:23,520 --> 00:18:26,380
إنّه تضيق الخناق على الرّقبة لدرجة مؤلمة

252
00:18:28,120 --> 00:18:33,390
يستخدِمُ الغربُ الأزرارَ بدلاً من الزنّار لتثبيت الملابس؟

253
00:18:33,390 --> 00:18:36,400
!توقّف

254
00:18:33,890 --> 00:18:36,400
!هيسكي، لم يبقَ من شعرك ما هو قابل للشدّ

255
00:18:40,360 --> 00:18:42,150
...سايتو-سان

256
00:18:45,520 --> 00:18:48,010
...سايتو-سان، هذا

257
00:18:48,010 --> 00:18:52,330
...يبدو أنّ هناك بضعة أزرار إضافيّة

258
00:18:52,330 --> 00:18:54,910
لعلّه صُمِّم بهذه الطّريقة

259
00:18:55,230 --> 00:18:56,670
إن لم تمانع، دعني ألقي نظرة

260
00:18:57,320 --> 00:19:01,920
انظر، يوجد ثقبان مُطابِقان في هذا الطّرف

261
00:19:02,610 --> 00:19:06,540
...أعتقد أنّك زرّرته بشكل... خاطئ

262
00:19:08,840 --> 00:19:10,180
سأضبطه لاحقاً

263
00:19:11,550 --> 00:19:12,790
!أنا آسفة

264
00:19:12,790 --> 00:19:15,190
!لا مشكلة ما دام سايتو-سان لا يمانع

265
00:19:28,140 --> 00:19:29,310
ما المشكلة؟

266
00:19:29,740 --> 00:19:32,900
ألا أرتدي هذا بشكل صحيح؟

267
00:19:32,900 --> 00:19:36,330
لـ-لا... حلقت شعرك أيضاً

268
00:19:36,330 --> 00:19:37,450
أجل

269
00:19:37,450 --> 00:19:40,340
إنّه... يليق بك حقّاً

270
00:19:42,120 --> 00:19:44,840
هل الجميع جاهزون؟

271
00:19:46,530 --> 00:19:47,330
ماذا؟

272
00:19:48,150 --> 00:19:50,820
كوندو-سان لا يرتدي زيّاً غربيّاً

273
00:19:50,800 --> 00:19:55,060
لطالما شعرتُ بعدم الرّاحة بارتداء ملابس أجنبيّة

274
00:19:55,060 --> 00:19:59,850
أعتقد على المحارب أن يضع سيفه مع الهاكاما
من أجل أن يشعر براحة تامّة

275
00:19:59,850 --> 00:20:02,530
هكذا أفضل

276
00:20:02,530 --> 00:20:05,350
مُجرَّد ظهورك بهذا الشكل في ساحة
المعركة سيكون كافياً

277
00:20:05,740 --> 00:20:09,990
فأساساً، حضورك هو مصدر قوّة للمقاتلين

278
00:20:10,000 --> 00:20:11,500
حقّاً؟

279
00:20:15,020 --> 00:20:17,490
...هذا... هل هو

280
00:20:18,150 --> 00:20:19,490
إنّه لسوجي

281
00:20:20,910 --> 00:20:26,390
حضّرناه كي يتمكّن من الانضمام للمعركة حالما يعود

282
00:20:26,390 --> 00:20:28,140
هكذا إذاً

283
00:20:29,340 --> 00:20:32,890
سيليق بأوكيتا-سان كثيراً

284
00:20:36,170 --> 00:20:37,460
تشيزورو

285
00:20:37,460 --> 00:20:40,690
في الحقيقة، كان ينبغي أن تبقي هنا

286
00:20:40,690 --> 00:20:43,870
لكن لا يمكننا ترككِ لوحدكِ مع الرّازيتسو

287
00:20:43,870 --> 00:20:46,280
وقد يعود كازاما في أي وقت

288
00:20:46,280 --> 00:20:47,410
أجل

289
00:20:47,940 --> 00:20:50,770
عليكِ طاعة أوامري في الرّحلة

290
00:20:51,670 --> 00:20:52,770
هل هذا واضح؟

291
00:20:52,770 --> 00:20:53,690
حاضرة

292
00:20:56,120 --> 00:21:01,280
!ستنطلق وحدة كويو تشينبوتاي الآن

293
00:21:20,700 --> 00:21:24,500
وهكذا، الشّينسينغومي، تحت مسمّى
،وحدة كويو تشينبوتاي

294
00:21:24,500 --> 00:21:26,010
تنطلق نحو قلعة كوفو

295
00:21:36,950 --> 00:21:42,660
أحدِّق في وجهك

296
00:21:42,660 --> 00:21:48,700
تضيئه شمس الغروب الحمراء الدّاكنة

297
00:21:48,700 --> 00:22:00,870
أتمنّى من السّماء الملتهبة إيقاف الزّمن

298
00:22:01,500 --> 00:22:12,250
تحاول بجدّية المضيّ قدماً بينما تحمل أعباء حزنك

299
00:22:12,250 --> 00:22:25,330
إن أمكن، أريد أن أتبعك عبر هذا الدّرب الوعر

300
00:22:25,330 --> 00:22:32,250
تتحرّك الغيوم من بعيد، بعيد جدّاً

301
00:22:32,250 --> 00:22:37,620
حتّى لو دام هذا لِلَحظة فقط

302
00:22:37,620 --> 00:22:40,750
أريد أن أكون معك

303
00:22:40,750 --> 00:22:51,540
الشّمس الّتي تصبغ قلبي ستدوم للأبد

304
00:22:51,870 --> 00:22:58,080
لذا آمن بروابطنا فحسب

305
00:23:03,450 --> 00:23:05,080
سنشتبك مع العدوّ بهذه الأعداد؟

306
00:23:05,080 --> 00:23:06,450
هل أنت جادّ؟

307
00:23:06,460 --> 00:23:09,460
كمُحاربين، ينبغي أن نكون جاهزين لتقديم أرواحنا

308
00:23:10,220 --> 00:23:12,200
سوف أعود بكلّ تأكيد

309
00:23:12,200 --> 00:23:13,980
لهذا ينبغي أن تؤمني وتنتظريني

310
00:23:13,980 --> 00:23:14,880
!لذا لا تموتي

311
00:23:14,000 --> 00:23:16,040
الحلقة القادمة
طريق الانتكاسات