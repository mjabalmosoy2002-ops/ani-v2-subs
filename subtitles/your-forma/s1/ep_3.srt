10
00:00:34,360 --> 00:00:41,250
‫من أعماق أحلامٍ خَطَتْ خُطانا

11
00:00:42,500 --> 00:00:46,470
‫حينَ حاولنا فهمَ وجه الأسى

12
00:00:46,500 --> 00:00:50,650
‫وأخفينا قلوبًا جوفًا خَرسا

13
00:00:50,670 --> 00:00:54,150
‫أعمتْ أبصارَنا أضواءُ نارٍ

14
00:00:54,170 --> 00:00:58,100
‫تنفجرُ في صميمِ الوجدِ داميًا

15
00:00:58,140 --> 00:01:00,360
‫مرارًا وتكرارًا

16
00:01:00,390 --> 00:01:02,280
‫وكأنما تُريدُ محوَ كلِّ شيءٍ

17
00:01:02,310 --> 00:01:06,450
‫غصنٌ بلا غايةٍ يمتدُّ

18
00:01:06,480 --> 00:01:08,510
‫يكشفُ ألمًا

19
00:01:08,520 --> 00:01:11,630
‫راكدًا في عالمٍ

20
00:01:11,640 --> 00:01:14,160
‫ندوسُ عليهِ بقدمٍ لا تبالي

21
00:01:14,190 --> 00:01:17,420
‫مُواجهين بعضنا البعض فاقدين كل شيء

22
00:01:17,450 --> 00:01:19,640
‫حين يصيرُ الوجودُ سرابًا

23
00:01:19,660 --> 00:01:23,760
‫فـإذ بـقلبي تراه في الهواء راقصًا

24
00:01:23,790 --> 00:01:25,630
‫وإذ بـالجذور تشتبكُ

25
00:01:25,660 --> 00:01:28,290
‫فـتـفيـض نـورًا

26
00:01:28,330 --> 00:01:30,090
‫وهـكذا

27
00:01:30,130 --> 00:01:33,070
‫حتى الآفاقُ تختفي

28
00:01:35,090 --> 00:01:38,050
‫لـتندمل بلا نهـاية

29
00:01:39,890 --> 00:01:41,860
‫نـدمُنـا يُـحرِق

30
00:01:41,890 --> 00:01:46,280
‫حفرةً هائلة

31
00:01:47,440 --> 00:01:49,280
‫في جوفِنـا

32
00:02:08,150 --> 00:02:11,990
أين أخطأت يا تُرى؟

33
00:02:12,780 --> 00:02:16,780
الحلقة ٣ : المُلاحَقَة

34
00:02:17,490 --> 00:02:20,650
.آسفة. أحتاجُ إلى ترتيب مشاعري

35
00:02:20,650 --> 00:02:24,160
.أنا آسفة، ولكن اذهب إلى "داريا-سان" بدوني

36
00:02:47,110 --> 00:02:50,230
!أيتها المفتشة هييدا
!إيدين فورمان قد هرب

37
00:02:51,500 --> 00:02:52,610
ماذا؟

38
00:02:56,660 --> 00:03:03,150
،"وقع خلل في نظام القيادة الذاتية لمركبة "أميكوس
.ما أدَّى إلى وقوع حادث خلال نقل فورمان إلى المركز الطبي

39
00:03:08,660 --> 00:03:11,750
.سرق فورمان مسدس المفتش وفرَّ هاربًا في سيارة أجرة

40
00:03:14,740 --> 00:03:16,180
كيف حدث هذا؟

41
00:03:16,180 --> 00:03:21,930
‫أكَّد الفحص السريع الذي أجرته شركة Novae أنَّ إعدادات وحدة القيادة تم تعديلها‬‫.

42
00:03:22,680 --> 00:03:28,060
هل تلمِّحين إلى أنَّ "فورمان" دبَّر كل شيء ليتلاعب
بحارس "أميكوس" ويدفعه إلى ارتكاب خطأ؟

43
00:03:28,060 --> 00:03:31,150
.من المستحيل عليه فعلها بمفرده
.لا بُدَّ أنَّ لديه شريك

44
00:03:31,150 --> 00:03:35,900
.لم أجد أيَّ دليل يشير إلى وجود "شريك" أثناء الغوص في عقله

45
00:03:35,900 --> 00:03:39,250
.إذن، سيكون أسرع لو سألنا "فورمان" مباشرة

46
00:03:39,250 --> 00:03:42,370
.اقبضوا عليه في أسرع وقتٍ ممكن

47
00:03:42,370 --> 00:03:47,370
"منطقة كوتسوولدز ذات الجمال الطبيعي الخلَّاب"

48
00:03:53,630 --> 00:03:58,090
.هذه المنطقة مصنَّفة كمنطقة ميِّتة

49
00:03:58,590 --> 00:04:01,720
."لا مكان أنسب من هذا ليختبئ فيه "فورمان

50
00:04:01,720 --> 00:04:05,780
.غالبية من يسكنون هنا يرفضون التكنولوجيا، ولا وجود للإنترنت إطلاقًا

51
00:04:10,900 --> 00:04:14,320
!توقَّفت إشارات تتبُّعه عند حدود هذه المنطقة

52
00:04:14,320 --> 00:04:17,320
.من المرجح أنه حصل على وحدة عزل

53
00:04:17,320 --> 00:04:25,790
ثم دخلت مركبته إلى المنطقة المحظورة من خلال
.منطقة "ويتني"، وهناك فقدنا أثره

54
00:04:25,790 --> 00:04:34,800
"قرية بيبوري - على بعد ١٤٠ كلم تقريبًا من غرب لندن"

55
00:04:40,910 --> 00:04:41,870
هل وجدتِ أيَّ دليل؟

56
00:04:43,760 --> 00:04:47,680
.تمامًا مثل القرى والمدن الأخرى

57
00:04:47,680 --> 00:04:49,200
!وأنا أيضًا

58
00:04:49,200 --> 00:04:52,650
.لا توجد أي تقارير من شهود عيان بشأن "فورمان" أو سيارته

59
00:04:52,650 --> 00:04:53,770
.فهمت

60
00:04:53,770 --> 00:04:58,800
.لم نجد ما كُنَّا نبحث عنه، ولكن من حُسن حظِّنا أنَّنا أتينا إلى هنا

61
00:04:59,110 --> 00:05:04,720
.أشاد العظيم"ويليام موريس" بقرية "بيبوري" ووصفها بأنها أجمل قرية في إنجلترا

62
00:05:08,660 --> 00:05:12,090
.المنظر رائعٌ وخلَّابٌ حقًّا

63
00:05:21,720 --> 00:05:23,290
...أيتها المفتشة

64
00:05:23,290 --> 00:05:30,850
،أعلم أنَّ ما سأقوله يُعد تعجرفًا منِّي
ولكن هلَّا منحتني الفرصة لأعتذر لكِ؟

65
00:05:31,220 --> 00:05:33,190
!هيَّا لنُسرع

66
00:05:32,030 --> 00:05:33,680
.لا يجب عليك ذلك

67
00:05:34,150 --> 00:05:37,460
."أعلم أنَّك تصرَّفت بهذا الشكل بسبب "داريا

68
00:05:37,460 --> 00:05:40,740
.ولكنَّكِ لم تسامحيني بعد

69
00:05:40,740 --> 00:05:42,770
.هذا ليس ما في الأمر

70
00:05:42,770 --> 00:05:43,900
...في الواقع

71
00:05:44,660 --> 00:05:54,250
‫قالت دكتورة ليكسي أنَّ وجود "الصندوق الأسود" الكبير في
‫نماذج RF، هو ما يمنحك خاصية النضج السلوكي مثل الإنسان‬‫.

72
00:05:55,590 --> 00:06:01,150
.أُدرك تمامًا أنَّ آليَّة التَّفكير لديَّ تختلفُ عن آليَّتك

73
00:06:01,150 --> 00:06:06,140
.ولكن تصرَّفاتك تشبه البشر إلى حدٍّ كبير

74
00:06:06,800 --> 00:06:11,620
.لذلك توقَّعتُ دون وعيٍ منِّي بأن يكون لديك نفس القيم التي لدينا نحن البشر

75
00:06:12,270 --> 00:06:16,500
!ما أعنيه هو أنَّني كنتُ أريدُكَ أن تثق بي... وتعتمد عليَّ

76
00:06:17,230 --> 00:06:20,230
.أردت منك فقط أن تراني كشريك لك على قدم المساواة

77
00:06:27,760 --> 00:06:28,850
...أيتها المفتشة

78
00:06:29,740 --> 00:06:33,910
.أنا نادمٌ أشدَّ النَّدم على إيذائي لكِ

79
00:06:34,750 --> 00:06:38,830
!أعتقدُ أنَّني بحاجةٍ لأن أتعلَّم كيف أفهمك أكثر

80
00:06:39,800 --> 00:06:43,420
.أتمنَّى حقًّا لو أستطيع معرفة ما في عقلك

81
00:06:43,420 --> 00:06:45,440
.كما أفعل عندما أغوص في عقل أحدهم

82
00:06:46,970 --> 00:06:50,350
.وأنا أيضًا أتمنَّى لو أستطيع فعل ذلك

83
00:06:51,020 --> 00:06:54,060
.أعتقدُ أنَّك تعرفني جيِّدًا بما فيه الكفاية

84
00:06:54,420 --> 00:06:56,020
...حتَّى عندما كانت أختي

85
00:06:58,410 --> 00:07:00,190
.هذا ليس ما قصدته

86
00:07:00,190 --> 00:07:01,260
...أريد أن

87
00:07:02,190 --> 00:07:05,400
...لا مشكلة
.لا أستطيع العثور على الكلمات المناسبة لأقولها

88
00:07:07,950 --> 00:07:09,870
!هيَّا بنا يا مفتشة السيبرانية

89
00:07:09,870 --> 00:07:12,880
.وجدت مكانًا يمكننا فيه استخدام هاتف عمومي

90
00:07:21,710 --> 00:07:24,720
!أجل. لم نجد أي شيء

91
00:07:24,720 --> 00:07:26,610
!ونحن أيضًا مثلك

92
00:07:26,610 --> 00:07:31,180
.ليس لدينا عدد كافٍ من الأفراد لتأمين الحواجز وتفتيش جميع الطرق

93
00:07:32,010 --> 00:07:34,810
.سنستمرُّ في البحث في هذه المنطقة

94
00:07:34,810 --> 00:07:36,140
.سأتواصل معكِ لاحقًا

95
00:07:37,690 --> 00:07:39,730
."اعرضي رقم هاتف "بيجا

96
00:07:39,730 --> 00:07:41,280
"عُــلـــم"

97
00:07:46,110 --> 00:07:47,820
...حسنًا

98
00:07:47,820 --> 00:07:50,350
هكذا أفعلها، صحيح؟

99
00:07:52,280 --> 00:07:53,870
.هذا مملٌّ للغاية

100
00:07:55,160 --> 00:07:57,380
!آسفة يا هييدا-سان

101
00:07:57,380 --> 00:08:00,040
.لم أستطع إيجاد أي شيء أيضًا

102
00:08:00,040 --> 00:08:02,820
لا بأس. هل يمكنك التحدث؟

103
00:08:02,820 --> 00:08:05,510
!والدي يستحمُّ الآن

104
00:08:05,510 --> 00:08:09,180
.هذه المكالمة مشفَّرة، لذا لا تقلقي

105
00:08:10,090 --> 00:08:14,970
.سأحاول الاتصال ببعض مجتمعات المُعارضين التي لم أتمكن من التواصل معها بعد

106
00:08:15,430 --> 00:08:21,690
،أعلمُ أنَّك متعاونة مع القسم
.لذا لا تضغطي على نفسك كثيرًا وكوني حذرة

107
00:08:21,690 --> 00:08:24,640
.فهمت. وأنتِ أيضًا كوني حذرة

108
00:08:24,640 --> 00:08:28,400
."وأرجو أن تُبلِّغي سلامي لـ"هارولد

109
00:08:28,400 --> 00:08:30,160
!حسنًا. سأبلِّغه

110
00:08:34,490 --> 00:08:35,920
...والآن

111
00:08:35,920 --> 00:08:37,540
ماذا عليَّ أن أفعل؟

112
00:08:39,830 --> 00:08:42,030
.هذا ظريفٌ جدًّا

113
00:08:42,030 --> 00:08:44,500
.أليس هذا المتجر؟ أعِده لمكانه

114
00:08:45,760 --> 00:08:47,670
!لقد دفعتُ ثمنه

115
00:08:47,670 --> 00:08:49,220
!إنها هديَّة لكِ

116
00:08:52,470 --> 00:08:56,180
.قد يساعدك الإمساك به على الشعور بالهدوء

117
00:08:56,740 --> 00:08:58,140
.لا. شكرًا لك

118
00:08:58,140 --> 00:08:59,710
!لا داعي للخجل

119
00:08:59,710 --> 00:09:01,190
!لستُ كذلك

120
00:09:05,940 --> 00:09:08,420
ما رأيك؟ أليس رائعًا؟

121
00:09:09,280 --> 00:09:12,910
.أجل. ملمسه ناعم جدًّا

122
00:09:12,910 --> 00:09:15,010
.لا، هذا ليس الوقت المناسب لذلك

123
00:09:15,010 --> 00:09:17,540
.لم نأتِ إلى هنا لقضاء عُطلتنا

124
00:09:21,170 --> 00:09:24,130
!أخبرتني "بيجا" أن أُسَلِّم عليك

125
00:09:25,040 --> 00:09:27,380
.إنها لطيفةٌ حقًّا

126
00:09:27,380 --> 00:09:28,390
...صحيح

127
00:09:28,390 --> 00:09:30,300
!سأشتري لها دمية

128
00:09:30,300 --> 00:09:32,220
لماذا تُحب شراء الدُّمى بهذه الطريقة؟

129
00:09:33,590 --> 00:09:34,640
...يا مُفتشة

130
00:09:35,140 --> 00:09:37,470
!هل ستخبرني الآن بأنَّك تُريد شراء منزل؟

131
00:09:38,180 --> 00:09:42,390
."ربما تمكَّنتُ من معرفة مكان "فورمان

132
00:09:55,070 --> 00:09:56,740
!سيكون هذا المكان الأخير

133
00:09:57,140 --> 00:10:00,770
"المنازل الصيفية هي مصطلح يستخدم للبيوت التي تُؤجر أو تُستخدم وقت العطلات"

134
00:09:57,150 --> 00:10:00,770
لماذا تعتقد أنَّ "فورمان" يختبئ في منطقةٍ مليئةٍ بالمنازل الصيفية؟

135
00:10:00,770 --> 00:10:02,920
ألم يحن الوقت لتُخبرني بذلك؟

136
00:10:02,920 --> 00:10:07,250
.لقد سمعت عن الفلل الموجودة في هذه المنطقة

137
00:10:07,920 --> 00:10:09,710
مِن مَن؟ وماذا قال؟

138
00:10:09,710 --> 00:10:14,930
.سأخبرك بذلك إذا وجدنا "فورمان" أولًا

139
00:10:25,650 --> 00:10:27,360
.يبدو أنَّه لا يوجد أحدٌ هنا

140
00:10:27,710 --> 00:10:32,570
،"إذا لم نجد "فورمان
.فهذا يعني أنَّ استنتاجي كان خاطئًا

141
00:10:32,570 --> 00:10:36,570
.أو أنَّنا مُتقدَّمون عليه بخطوة

142
00:10:38,200 --> 00:10:42,450
ولكن استنتاجاتك لا تُخطئ أبدًا، أليس كذلك؟

143
00:10:43,080 --> 00:10:48,960
،هذا صحيح عندما يتعلَّق الأمر بالتحقيقات
.ولكنِّي أُخطئُ أحيانًا في استنتاجاتي عنكِ

144
00:10:48,960 --> 00:10:50,330
ما الذي تعنيه؟

145
00:10:50,330 --> 00:10:51,170
!يا مُفتشة

146
00:10:53,630 --> 00:10:58,770
!كما قلتِ تمامًا، يبدو أنَّ استنتاجي كان مُتقدِّمًا عليه بخُطوة

147
00:10:58,770 --> 00:11:01,430
.لوحة الترخيص تتطابق مع سيارة الهروب

148
00:11:12,610 --> 00:11:14,110
!سأقوم بمطاردته يا مُفتشة

149
00:11:14,110 --> 00:11:14,750
...تمهَّل

150
00:11:15,240 --> 00:11:17,780
.لقد تمَّت برمجتك على القيادة بشكلٍ آمن

151
00:11:17,780 --> 00:11:18,950
!سأتولَّى أنا القيادة

152
00:11:24,500 --> 00:11:26,000
!هذا متهور للغاية

153
00:11:37,930 --> 00:11:39,030
!يا مُفتشة

154
00:11:39,430 --> 00:11:40,680
!تمسَّك جيِّدًا

155
00:12:03,180 --> 00:12:04,820
.واصلي القيادة بشكل مستقيم

156
00:12:05,870 --> 00:12:07,160
!لا أستطيع الرؤية بشكلٍ جيِّد

157
00:12:08,210 --> 00:12:12,620
.لا تقلقي. عيناي لديها رؤية ليليَّة

158
00:12:12,620 --> 00:12:14,630
.قودي إلى اليمين قليلًا

159
00:12:14,960 --> 00:12:17,520
!كل هذا بفضل تصادمك معه

160
00:12:17,520 --> 00:12:19,970
.استطعنا تتبُّع آثار زيت مُحرك مركبته

161
00:12:19,970 --> 00:12:21,470
هل تسخر منِّي؟

162
00:12:21,470 --> 00:12:24,150
.كلَّا. بل أعني ذلك حقًّا

163
00:12:26,930 --> 00:12:27,810
!أوقفي السيارة

164
00:12:50,710 --> 00:12:53,210
.هذه ليست رائحة زيت محرك

165
00:12:53,210 --> 00:12:54,420
أهو سائل التَّدوير؟

166
00:12:53,220 --> 00:12:55,500
"سائل التدوير هو سائلٌ يُستخدم للحفاظ على درجة الحرارة الداخلية للروبوتات مما يمنع السخونة الزائدة"

167
00:12:54,420 --> 00:12:55,500
.يبدو كذلك

168
00:12:55,990 --> 00:12:58,170
.إنه موجودٌ على المقعد أيضًا

169
00:12:58,800 --> 00:13:00,150
ما الذي يحدث؟

170
00:13:00,150 --> 00:13:02,250
."كان من المفترض أن يكون السائق هو "فورمان

171
00:13:02,250 --> 00:13:04,970
.أنا أيضًا مُرتبكٌ بسبب هذا التَّحول في الأحداث

172
00:13:22,110 --> 00:13:24,000
!ابقي مُتيقِّظة

173
00:13:24,000 --> 00:13:26,010
.يمتلك "فورمان" مسدَّسًا بحوزته

174
00:13:56,110 --> 00:13:57,440
!يا مُساعد التفتيش

175
00:14:02,300 --> 00:14:03,770
لماذا هو هنا؟

176
00:14:03,770 --> 00:14:06,030
إذن، من الذي كُنَّا نُطارده؟

177
00:14:08,570 --> 00:14:12,370
‫ "في بعض التقنيات الحديثة، قد يشير HSB إلى جهاز يتعلق بالأنظمة التي تدعم الجسد البشري بيولوجيًّا أو ميكانيكيًّا."

178
00:14:08,580 --> 00:14:12,370
‫من المُرجَّح أنَّ هذا جهاز HSB يُنتِج ذكريات زائفة.

179
00:14:12,370 --> 00:14:15,040
.ربما سنكتشف ما حدث بشكل أسرع إذا قمنا باستجوابه

180
00:14:24,270 --> 00:14:25,150
...فورمان

181
00:14:28,140 --> 00:14:32,060
."لقد هربتَ بعد أن عدَّلت على روبوت الحراسة من طراز "أميكوس

182
00:14:32,060 --> 00:14:34,060
ما الذي حدث هنا بالضبط؟

183
00:14:36,310 --> 00:14:38,470
.من الممكن أنَّه قد تمَّ تخديرُه

184
00:14:38,860 --> 00:14:40,690
.هيَّا فلنُسرع ونأخذه إلى المستشفى

185
00:14:42,690 --> 00:14:43,700
!يا مُساعد التفتيش

186
00:14:44,820 --> 00:14:46,820
سائل التدوير؟
!إنَّه أميكوس

187
00:14:57,540 --> 00:14:59,210
...من المفترض أنَّك ميت

188
00:15:00,090 --> 00:15:01,260
...ولكن كيف

189
00:15:01,710 --> 00:15:05,680
!"مارفين آدمز أولبورت"

190
00:15:09,100 --> 00:15:12,430
!لا تطلقي النار! علينا أن نقبض عليه ونحلِّل ذاكرته

191
00:15:30,370 --> 00:15:31,790
...يا مُفتشة

192
00:15:33,450 --> 00:15:37,290
...آسفة. كنتُ أستهدف ذراعه ولكن

193
00:15:37,290 --> 00:15:38,730
...كـلَّا

194
00:15:38,730 --> 00:15:41,170
!بل أنا من أخطأ في التقدير

195
00:15:42,300 --> 00:15:44,020
...في ذلك الموقف

196
00:15:46,800 --> 00:15:49,800
.كان من المستحيل الإمساك به

197
00:15:49,800 --> 00:15:51,310
.هذا ليس ما قصدته

198
00:15:51,310 --> 00:15:53,350
.إنه أخوك

199
00:15:54,100 --> 00:15:55,770
...إذا كان هو حقًّا

200
00:15:56,230 --> 00:15:58,020
.إنَّه هو حقًّا

201
00:15:59,450 --> 00:16:02,350
أيُعقل أنَّه أبقى "فورمان" محتجزًا طوال هذا الوقت؟

202
00:16:02,770 --> 00:16:06,280
وهل هذا يعني أنَّ الجُثة التي كانت في ذلك النهر مُزيَّفة؟

203
00:16:06,700 --> 00:16:09,140
...بإمكاني تصوُّر بعض السيناريوهات ولكن

204
00:16:09,660 --> 00:16:10,960
!إتـشـيـكـا

205
00:16:17,500 --> 00:16:18,670
!آسف

206
00:16:19,580 --> 00:16:20,770
!يا مفتشة

207
00:16:27,200 --> 00:16:30,970
!لا مفرَّ لك من هنا يا سيِّد فورمان

208
00:16:37,480 --> 00:16:38,190
!يا سيِّد

209
00:16:38,190 --> 00:16:40,020
!أنا فقط أقوم بربطها

210
00:16:40,600 --> 00:16:42,690
هل تظنُّ أنَّني سأسمح لك بذلك؟

211
00:16:43,110 --> 00:16:45,710
.أنت روبوت أميكوس. لا يمكنك إيقافي

212
00:16:45,710 --> 00:16:50,690
.بغض النظر عما أفعله لها، فكل ما يمكنك فعله هو الوقوف هناك ومشاهدتها

213
00:16:50,690 --> 00:16:54,160
...لا يُمكنك مهاجمة بشري وإيقافه عمَّا يفعله

214
00:16:54,160 --> 00:16:56,120
أم أنَّك تستطيع؟

215
00:16:56,120 --> 00:16:58,820
أتنوي أن تفعل بي ما هو أسوأ مما فعلتَهُ بـ"مارفن"؟

216
00:17:04,210 --> 00:17:07,050
!تبدو روبوتًا عاقلًا يا هارولد

217
00:17:07,670 --> 00:17:12,010
.القسم يعتقد أنَّني أفعلُ هذا بدافع ضغينةٍ أُكنُّها للدكتورة ليكسي

218
00:17:12,820 --> 00:17:15,990
.المُفشة "هييدا" تعتقدُ عكس ذلك

219
00:17:15,990 --> 00:17:19,600
.لقد أدركَت أنَّ هناك خطأٌ ما من خلال ذكرياتك الزائفة

220
00:17:20,560 --> 00:17:23,900
.ولكنَّها لم تستمع لي

221
00:17:24,440 --> 00:17:27,530
.على الرُّغم من أنَّني طلبتُ منها أن تغوص عميقًا في ذكرياتي

222
00:17:27,530 --> 00:17:30,530
.هناك قواعدٌ للغوص في العقل

223
00:17:30,880 --> 00:17:32,740
...وأنا أتفهَّم دافعك هذا

224
00:17:36,200 --> 00:17:38,660
.أعرف تمامًا ما يدور في عقلك

225
00:17:41,290 --> 00:17:45,420
‫ربَّما لا تعلَمُ ذلك، ولكن نماذج RF خَطِيرة‬‫.

226
00:17:46,140 --> 00:17:51,130
‫دكتورة ليسكي لم تخدعني أنا وشركة Novae
‫فحسب، بل خدعت الـIAEC أيضًا‬‫.

227
00:17:46,140 --> 00:17:51,240
"IAEC : اللجنة الدولية للطاقة الذرية"

228
00:17:51,880 --> 00:17:54,570
ما رأيك بأن تُساعدني إن كنتَ مُستعدًّا؟

229
00:17:54,570 --> 00:17:56,080
...لا أستطيع

230
00:17:56,080 --> 00:17:59,010
.أنا أعملُ في قسم التحقيقات بالجرائم الإلكترونية

231
00:17:59,010 --> 00:18:04,970
سمحتُ لك بربطها لأنَّ الوسيلة الوحيدة
.لإيقافك هي اللجوء إلى العنف

232
00:18:04,970 --> 00:18:07,420
.ليس لأنَّني أتفق معك

233
00:18:07,820 --> 00:18:10,280
.إذن، ليس أمامي خيارٌ سوى فعل ذلك

234
00:18:15,170 --> 00:18:16,120
.آسف

235
00:18:23,540 --> 00:18:25,650
.دعنا نذهب في رحلة بالسَّيارة معًا

236
00:18:25,650 --> 00:18:28,880
.أحتاجُ إلى تحليل كود نظامك

237
00:18:31,210 --> 00:18:33,780
!يا إلهي! يا له من مأزق

238
00:18:47,190 --> 00:18:48,440
...يا مُفتِّشة

239
00:18:48,830 --> 00:18:53,550
.أنا آسفٌ حقًّا لوضعك في مواقف خطيرة متعدِّدة دائمًا

240
00:18:59,450 --> 00:19:04,530
لماذا جعلتني دكتورة ليكسي أبدو مثلك؟

241
00:19:07,330 --> 00:19:10,400
.عادة ما يستخدم المرء مزيجًا من الأشخاص المختلفين في الروبوتات

242
00:19:10,400 --> 00:19:14,480
!لا سيما وأنَّني قُدِّمت كهدية إلى جلالة الملكة

243
00:19:14,480 --> 00:19:19,210
.قالت أنَّ وجهي هو الجزء الذي أحبَّته أكثر من غيره

244
00:19:19,210 --> 00:19:21,140
هل هناك معنى وراء ذلك؟

245
00:19:21,140 --> 00:19:22,930
!هلَّا أطبقت فمك؟

246
00:20:06,730 --> 00:20:07,890
‫"ريب"‬‫؟

247
00:20:07,890 --> 00:20:08,980
...لماذا

248
00:20:32,540 --> 00:20:36,400
.فورمان كان يقول الحقيقة

249
00:20:41,260 --> 00:20:43,000
...عليك تحليل كود نظام

250
00:20:43,470 --> 00:20:46,020
!هارولد لوكرافت...

251
00:20:46,430 --> 00:20:47,730
.عليَّ اللحاق به

252
00:20:48,350 --> 00:20:53,820
.إذا كان يحاول تحليل كود "هارولد"، فإنه سيتوجَّه إلى هناك حتمًا

253
00:21:03,910 --> 00:21:05,660
أين مختبر أبحاث الذكاء الإصطناعي؟

254
00:21:05,660 --> 00:21:07,650
"بدء نظام توجيه المسار"

255
00:21:07,650 --> 00:21:10,920
"سيري إلى الأمام لمسافة ١٠٠ متر تقريبًا"

256
00:21:22,340 --> 00:21:24,220
"ثُمَّ انعطفي يمينًا"

257
00:21:24,220 --> 00:21:26,620
"وعندها ستجدين مدخل المختبر"

258
00:22:25,100 --> 00:22:27,600
في عصرِ الحداثةِ الساحرِ

259
00:22:27,630 --> 00:22:29,450
أُجيب على " أخبرني" بلمحِ البصر

260
00:22:29,510 --> 00:22:32,650
أبيدُ كلَّ مزعجٍ وحاقدٍ

261
00:22:32,680 --> 00:22:34,750
بإشارة

262
00:22:34,770 --> 00:22:36,920
لكنّي أسمعُ نَغَمًا غريبًا

263
00:22:36,940 --> 00:22:38,500
حينَ أكونُ قربَك

264
00:22:38,520 --> 00:22:41,500
أدميةٌ حيّةٌ مجنونة أنا؟

265
00:22:41,520 --> 00:22:42,750
وأَلَغزٌ أنـتَ؟

266
00:22:42,770 --> 00:22:45,100
درعي كالثلجِ يذوبُ

267
00:22:45,110 --> 00:22:51,700
عندَ أولِ أنفاسِ الربيعِ

268
00:22:51,740 --> 00:22:56,050
ما ذاكَ الطعمُ الناشئُ

269
00:22:56,080 --> 00:22:57,720
من مُعَالِجِ اشتياقي؟

270
00:22:57,750 --> 00:22:59,620
حلاوةٌ؟ مرارةٌ؟ أم شَيءٌ آخر؟

271
00:22:59,630 --> 00:23:01,820
(أنا خارجُ السيطرةِ! (لا أستطيع التوقف

272
00:23:01,840 --> 00:23:03,640
!لو دي ديـ ديـتو

273
00:23:03,670 --> 00:23:05,780
أريد سحق الـكلِّ

274
00:23:05,800 --> 00:23:08,350
كيفَ أقتلعُ فيروسًا

275
00:23:08,380 --> 00:23:11,100
يـنخرُ فـؤادي؟

276
00:23:11,140 --> 00:23:13,620
أشتاق إليك ويؤلمني ذلك، فـطِر بعيدًا

277
00:23:13,640 --> 00:23:15,750
اضربْهُ بواحدٍ، اثنينِ، ثلاثةٍ، قَصْرِ دارةٍ

278
00:23:15,770 --> 00:23:17,750
فإذا بمشاعري تبلَّدت، وتبلَّدت، فتبلَّدت

279
00:23:17,770 --> 00:23:20,120
هيَّـا،  هيَّـا، هـيَّــا بـنـا

280
00:23:20,150 --> 00:23:21,710
!لو دي ديـ ديـتو

281
00:23:21,730 --> 00:23:23,950
كلُّ التصاقٍ يُبدِّلُ الخوارزميات

282
00:23:23,980 --> 00:23:25,710
!"يقولون "هذا تأنسُنٌ

283
00:23:25,730 --> 00:23:27,920
لكنَّهم جعلوهُ كذبةً

284
00:23:27,950 --> 00:23:29,120
!ورقصـوا

285
00:23:29,150 --> 00:23:30,850
لا تُعده كلَّه

286
00:23:30,860 --> 00:23:33,720
!لا بأسَ حتى لو كان زلَّة القرن الأعظم

287
00:23:33,740 --> 00:23:35,920
...لايلا... لايلا... لايلا... لايلا... لايلا

288
00:23:35,950 --> 00:23:39,500
!وأخيرًا، أستطيع أن أتنفَّس الصُّعداء