200
00:14:54,920 --> 00:14:58,620
!أجل، أجل! لم يطلب أحدٌ مساعدتكَ

201
00:14:59,210 --> 00:15:00,580
لا تموتي

202
00:15:05,180 --> 00:15:06,470
...سابر-سان

203
00:15:12,150 --> 00:15:14,800
!إنّه درع اصطناعيّ متوسّط

204
00:15:14,930 --> 00:15:16,900
لديهم واحدٌ إذن

205
00:15:18,280 --> 00:15:19,270
!ها أنا ذا

206
00:15:24,820 --> 00:15:26,650
!إنّه الطور الزمرديّ

207
00:15:34,040 --> 00:15:36,680
لهذا لا يسعني التوقف عن خوض الحروب

208
00:15:38,370 --> 00:15:40,340
!سوليود-سان، أستر-سان

209
00:15:41,820 --> 00:15:43,310
!احترقوا جميعًا

210
00:15:43,480 --> 00:15:44,910
!ذلك الوغد

211
00:15:45,240 --> 00:15:47,750
كيف يجرؤ على إثارة الفوضى أمامي؟

212
00:15:53,240 --> 00:15:54,550
!أونيه-ني-ساما

213
00:15:54,600 --> 00:15:55,850
!استدعي دولغر يا ميل

214
00:15:56,230 --> 00:15:58,060
!سأسحق ذلك الوغد

215
00:15:58,650 --> 00:15:59,730
!حاضر

216
00:16:01,680 --> 00:16:06,410
!رورو، فارنا، هاي، فامون، را، فو

217
00:16:17,150 --> 00:16:18,040
ماذا؟

218
00:16:18,170 --> 00:16:19,480
!حاولي مجدّدًا يا ميل

219
00:16:21,440 --> 00:16:26,020
!رورو، فارنا، هاي، فامون، را، فو

220
00:16:35,730 --> 00:16:36,710
!مُحال

221
00:16:37,780 --> 00:16:39,900
!لِمَ لا يظهر دولغر؟

222
00:16:40,110 --> 00:16:41,530
لا أعلم

223
00:16:41,600 --> 00:16:42,820
لم يحدث هذا من قبل

224
00:16:43,340 --> 00:16:44,350
...لعلّ

225
00:16:44,610 --> 00:16:45,240
ماذا؟

226
00:16:45,440 --> 00:16:47,310
أهو معطّلٌ أم ماذا؟

227
00:16:47,570 --> 00:16:51,620
لعلّ دولغر لم يتزامن مع أفكارك

228
00:16:51,930 --> 00:16:53,350
ماذا تعنين بذلك؟

229
00:16:53,510 --> 00:16:56,880
يستجيب دولغر لأفكاركَ ويتزامن معها

230
00:16:56,880 --> 00:16:57,440
...لذا

231
00:16:57,480 --> 00:16:59,170
لذا ماذا؟

232
00:16:59,250 --> 00:17:03,970
،لذا، إن كانت أقصى أمانيكَ هي مغادرة هذا العالم

233
00:17:04,340 --> 00:17:07,180
فلن يتمكّن دولغر من التزامن معك

234
00:17:07,260 --> 00:17:08,710
أمانيّ هي مغادرة هذا العالم؟

235
00:17:08,820 --> 00:17:11,420
أهذا بسببي؟

236
00:17:14,970 --> 00:17:16,170
...أونيه-ني-ساما

237
00:17:16,260 --> 00:17:19,860
!ألم تعودي تكترثين لهذا العالم؟ أو لي أنا؟

238
00:17:20,440 --> 00:17:21,440
...ميل-تشان

239
00:17:21,650 --> 00:17:23,440
انظري يا ميز

240
00:17:24,530 --> 00:17:28,020
!انظري إلى ما تسبّب به تدخّلكِ

241
00:17:30,440 --> 00:17:31,730
...لـ-لكن

242
00:17:31,730 --> 00:17:32,460
!اصمتِ

243
00:17:32,460 --> 00:17:33,240
!ابقِ بعيدةً عن هذا

244
00:17:33,440 --> 00:17:37,160
!لطفكِ المزيّف هذا لن يحلّ شيئًا

245
00:17:39,000 --> 00:17:42,670
ثمّة أمورٌ لا يسعكِ حلّها باللّطف وحده

246
00:17:44,060 --> 00:17:45,840
...سابر-سان

247
00:17:53,010 --> 00:17:54,920
!أونيه-ني-ساما، طوركَ

248
00:17:55,130 --> 00:17:57,800
!حسنٌ، حان وقت التنفيس عن غضبي

249
00:18:07,000 --> 00:18:08,310
ثابر

250
00:18:11,510 --> 00:18:13,120
!أونيه-ني-ساما

251
00:18:13,240 --> 00:18:15,030
!اصمتِ، وكفّي عن الذعر

252
00:18:16,260 --> 00:18:19,250
إلى متى يسعكَ الصمود يا تُرى؟

253
00:18:24,020 --> 00:18:28,210
آمل ألّا تكون قد نسيتني

254
00:18:31,010 --> 00:18:32,640
!حسنٌ

255
00:18:32,640 --> 00:18:35,220
!حان وقت ردّ الدّين

256
00:18:35,810 --> 00:18:39,350
!رورو، لاجو، باجورا، ماها، أجوني

257
00:18:41,030 --> 00:18:43,910
!فايغر

258
00:18:58,330 --> 00:18:59,370
!فعلتها

259
00:18:59,400 --> 00:19:01,030
!كما هو متوقع من أونيه-ني-ساما

260
00:19:04,970 --> 00:19:06,750
!هذا غير منطقيّ

261
00:19:07,080 --> 00:19:09,760
لم أكن أعلم أنّ لورس بهذه القوّة

262
00:19:10,130 --> 00:19:11,910
!تـ-تراجعوا

263
00:19:12,760 --> 00:19:14,050
!بوسمان

264
00:19:15,400 --> 00:19:16,760
تشاكرام؟

265
00:19:19,910 --> 00:19:23,310
!حسنٌ، لنزِل بقيّة هذه الحثالة

266
00:19:34,240 --> 00:19:35,740
من هؤلاء؟

267
00:19:36,060 --> 00:19:38,660
!إنّهم رهبان كاتالينا

268
00:19:38,700 --> 00:19:39,860
من هؤلاء؟

269
00:19:40,150 --> 00:19:43,790
!إنّهم قتلةٌ مُرعبون يتبعون طائفة جاينا

270
00:19:44,370 --> 00:19:45,510
!جاينا؟

271
00:19:45,800 --> 00:19:49,290
أتقصدين أنَّ جاينا تقف خلف هذا الهجوم برمّته؟

272
00:19:59,280 --> 00:20:00,880
!أيها الوغد

273
00:20:05,770 --> 00:20:07,470
!هرب

274
00:20:15,990 --> 00:20:17,660
!تبًّا لكَ يا بوسمان

275
00:20:18,130 --> 00:20:20,170
!سأثأر حتمًا

276
00:20:22,620 --> 00:20:27,210
!سوليود-سان، سوليود-سان

277
00:20:27,750 --> 00:20:31,930
أغلب الظنّ أنَّ قبيلة الزوكو قد أسرتها

278
00:20:32,000 --> 00:20:34,460
!تبًّا، تبًّا، تبًّا، تبًّا

279
00:20:34,550 --> 00:20:36,170
!أنا في قمّة الغضب

280
00:20:37,310 --> 00:20:40,600
لا تغضب هكذا يا أونيه-ني-ساما

281
00:20:43,980 --> 00:20:45,820
إنّه خطأي

282
00:20:46,310 --> 00:20:49,530
بسبب تردّدي، أُسرتْ سوليود-سان

283
00:21:01,310 --> 00:21:03,550
هُزمتُ؟

284
00:21:05,110 --> 00:21:07,550
أهُزمتُ أمام هؤلاء الحثالة؟

285
00:21:07,870 --> 00:21:10,710
أترغب في هزيمة ذلك الفولنار؟

286
00:21:10,710 --> 00:21:11,290
من هناك؟

287
00:21:12,110 --> 00:21:16,000
إن كنتَ ترغب في هزيمته، فيسعني منحكَ القوّة

288
00:21:16,880 --> 00:21:18,220
ما قولك؟

289
00:21:24,820 --> 00:21:27,930
امنحني القوّة لأذبحهم جميعًا

290
00:21:28,530 --> 00:21:31,860
!سأبيع روحي للشيطان مقابل ذلك

291
00:21:32,260 --> 00:21:35,930
سآخذكَ بكلمتكَ إذن

292
00:21:37,240 --> 00:21:38,150
...أنتَ

293
00:22:02,100 --> 00:22:03,680
!أنا مثيرةٌ للشفقة

294
00:24:09,460 --> 00:24:11,480
!سيّداتي وسادتي

295
00:24:12,290 --> 00:24:17,420
يكشف سابر عن سرٍّ صادمٍ، ما الماضي الّذي يخفيه يا تُرى؟

296
00:24:17,960 --> 00:24:21,340
وفجأةً، يُهاجم درع اصطناعيّ غامضٌ

297
00:24:21,470 --> 00:24:24,930
ما الّذي سيحلّ بميز الّتي عجزتْ عن التحكّم بدولغر؟

298
00:24:25,850 --> 00:24:27,680
اكتشفوا بقيّة القصّة في الحلقة القادمة

299
00:24:27,770 --> 00:24:29,850
في الحلقة القادمة من ميز: الفضاء المتفجّر

300
00:24:29,870 --> 00:24:32,270
!درع الروم العاشق الّذي لا يُقهر

301
00:24:33,190 --> 00:24:35,270
!أريد أن أقول شيئًا أنا الأخرى