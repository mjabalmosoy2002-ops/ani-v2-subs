Subaru :كارا

3
00:00:01,260 --> 00:00:02,260
!لنبدأ

4
00:02:08,480 --> 00:02:10,160
!تراجعوا

5
00:02:13,210 --> 00:02:16,050
لا نخشى جنود ريوغا

6
00:02:16,400 --> 00:02:18,510
!لا تدعوا أولئك الخونة يعودون أحياءً

7
00:02:31,520 --> 00:02:32,670
ما الّذي ينوون فعله؟

8
00:02:35,340 --> 00:02:36,410
!تلك هي الإشارة

9
00:02:39,180 --> 00:02:40,800
مـ-ما هذا؟

10
00:02:41,050 --> 00:02:42,930
!أ-أيّها القائد، انظر إلى ذاك

11
00:02:54,180 --> 00:02:57,690
لم يكن ادّعاء الهزيمة بالأمر الهيّن يا تاناس-ساما

12
00:02:57,740 --> 00:03:00,640
لكن أبدنا العدوّ دفعةً واحدةً بهذا

13
00:03:01,200 --> 00:03:03,950
،ولم يتبقَّ سوى الاستيلاء على ريغليتز؛ عاصمة بيستال

14
00:03:04,130 --> 00:03:06,740
وانتظار انتصار جيش بالانيا

15
00:03:07,450 --> 00:03:10,750
يظلّ ميز ملاذنا الوحيد على ما يبدو

16
00:03:12,960 --> 00:03:15,050
!أمواج الانتقال الآنيّ العاتية

17
00:03:29,310 --> 00:03:30,800
...أونيه-ني-ساما

18
00:03:35,290 --> 00:03:38,530
لم أحسب أنَّ أمرًا كهذا سيحلُّ بميز-سان

19
00:03:39,130 --> 00:03:40,880
لا يسعني تصديق ذلك

20
00:03:41,490 --> 00:03:44,320
!مُحال، لا يُعقل أن تموت ميز

21
00:03:44,990 --> 00:03:46,860
!ليُخبرني أحدكم أنَّ هذا كذبٌ

22
00:03:46,900 --> 00:03:49,330
لكنَّ هذا هو الواقع

23
00:03:55,250 --> 00:03:57,360
!أونيه-ني-ساما

24
00:03:57,360 --> 00:03:58,170
...ميل-تشان

25
00:04:00,400 --> 00:04:02,110
!تماسكي يا ميل-ساما

26
00:04:02,880 --> 00:04:04,340
سأثأر لكِ

27
00:04:04,610 --> 00:04:05,470
!ماذا؟

28
00:04:06,370 --> 00:04:08,570
!سأثأر لموت أونيه-ني-ساما

29
00:04:09,220 --> 00:04:11,020
!لا يجوز ذلك يا ميل-ساما

30
00:04:11,210 --> 00:04:13,940
!لا يليق بالأميرة أن تطلب الثأر بنفسها

31
00:04:14,700 --> 00:04:21,400
هذا صحيح، فأنتِ الوريثة الشرعيّة لإمبراطوريّة بارتونيا ومكانتكِ غاليّة

32
00:04:21,490 --> 00:04:23,600
!لا شأن لي بذلك

33
00:04:23,920 --> 00:04:28,580
!كلّ ما يهمّ ميل، كلّ ما يهمّني هو أونيه-ني-ساما فحسب

34
00:04:28,660 --> 00:04:29,490
...ميل-ساما

35
00:04:29,810 --> 00:04:32,650
...لا أكترث للعرش ولا للإمبراطوريّة

36
00:04:33,050 --> 00:04:35,560
!بل فلْتُلقَ للخنازير

37
00:04:35,630 --> 00:04:37,000
!كفاكِ مُزاحًا

38
00:04:39,880 --> 00:04:40,880
!جلالتك

39
00:04:42,010 --> 00:04:43,480
،مهما قال أيّ شخصٍ

40
00:04:43,880 --> 00:04:46,180
فأنتِ أميرة إمبراطوريّة بارتونيا

41
00:04:46,640 --> 00:04:48,490
،الجميع يُقاتل من أجلكِ

42
00:04:49,040 --> 00:04:50,850
ولهذا السبب بذلتْ ميز حياتها

43
00:04:51,890 --> 00:04:55,410
!لا أُريد... لا أُريد سماع ذلك

44
00:04:55,410 --> 00:04:56,180
!ميل-ساما

45
00:04:56,820 --> 00:04:58,310
!انتظري رجاءً

46
00:05:02,150 --> 00:05:03,700
أهذا ما تقوله؟

47
00:05:03,960 --> 00:05:05,500
!خاب ظنّي فيكَ يا جلالتك

48
00:05:10,480 --> 00:05:11,990
خاب ظنّكِ فيَّ إذن

49
00:05:12,920 --> 00:05:15,790
أتشاطرينهم الرأي أنتِ أيضًا يا ميز؟

50
00:05:21,140 --> 00:05:26,550
كتمتُ السبب الحقيقيّ وراء انسحاب دولغر من المعركة يا جلالتك

51
00:05:26,860 --> 00:05:30,180
لا يسعنا إحباط معنويات الجيش بأسره الآن

52
00:05:32,990 --> 00:05:38,100
لم أشعر بمرارة كوني ملكًا مثلما أشعر بها اليوم يا يوريكي

53
00:05:39,110 --> 00:05:40,610
...لو كنتُ مجرّد رجلٍ عاديّ

54
00:05:40,610 --> 00:05:44,440
لانطلقتُ في هذه اللحظة للثأر للمرأة الّتي أحببتها

55
00:05:45,150 --> 00:05:46,400
جلالتك

56
00:05:51,080 --> 00:05:52,300
...ميز-سان

57
00:05:53,100 --> 00:05:55,320
لِمَ فارقتِ الحياة؟

58
00:06:03,710 --> 00:06:09,160
لِمَ رحلتِ وتركتِ ميل وحيدةً يا أونيه-ني-ساما؟

59
00:06:09,840 --> 00:06:12,530
!هيّا، لا وقت لدينا للبكاء يا ميل

60
00:06:13,510 --> 00:06:15,810
استدعي دولغر في الحال

61
00:06:16,170 --> 00:06:18,900
إلى متى ستجعلين قائدته تنتظر؟

62
00:06:19,520 --> 00:06:21,730
قائدة؟ أستقودينه بنفسكِ يا ران-تشان؟

63
00:06:23,280 --> 00:06:26,120
لستِ الوحيدة من تبتغي الثأر لميز

64
00:06:26,270 --> 00:06:27,190
!ران-تشان

65
00:06:27,490 --> 00:06:28,510
!مهلًا

66
00:06:31,700 --> 00:06:33,410
!لن أدعكما تنفردان بالأمر وحدكما

67
00:06:33,840 --> 00:06:37,830
!هيّا بنا أيّتها الأميرة، سنثأر لميز حتمًا

68
00:06:39,310 --> 00:06:43,360
إن أصررتِ على الذهاب فسأرافقكِ يا ميل-ساما

69
00:06:43,470 --> 00:06:46,260
رغم كِبر سِنّي، ما زال يسعني تقديم العون

70
00:06:53,550 --> 00:06:55,560
!حسنٌ يا رفاق

71
00:07:01,270 --> 00:07:03,940
!بقي القليل، فلنقتحم الحصن دفعةً واحدة

72
00:07:04,180 --> 00:07:06,580
!سنستعيد بحرنا الأمّ

73
00:07:09,360 --> 00:07:11,070
!النجدة

74
00:07:15,200 --> 00:07:16,620
مـ-ما هذا؟

75
00:07:29,380 --> 00:07:34,600
اعتبروا أنفسكم محظوظين لأنّكم ستموتون على يديّ الفاتنتين

76
00:07:51,900 --> 00:07:53,410
!مـ-ما الّذي حدث هنا؟

77
00:07:58,450 --> 00:08:00,690
النصر لجاينا

78
00:08:15,220 --> 00:08:16,540
انتظر رجاءً

79
00:08:19,060 --> 00:08:22,140
جلالتك، أتنوي استدعاء دراكون؛

80
00:08:22,140 --> 00:08:25,400
الدرع الاصطناعيّ الملكيّ المتوارث في عائلة بالانيا الحاكمة؟

81
00:08:25,900 --> 00:08:26,960
لا توقفيني

82
00:08:27,570 --> 00:08:29,230
أجبني عن أمرٍ واحدٍ رجاءً

83
00:08:29,570 --> 00:08:33,360
...أتنطلق إلى المعركة بصفتك ملك بالانيا

84
00:08:33,450 --> 00:08:36,010
أم كرجلٍ عاديّ؟

85
00:08:36,010 --> 00:08:36,700
!لا تعترضي طريقي

86
00:08:38,320 --> 00:08:39,330
!يوريكي

87
00:08:40,420 --> 00:08:46,130
إذن سأمنعك، ليس بصفتي مستشارةً عسكريّةً؛ بل كامرأة

88
00:08:53,720 --> 00:08:55,050
لا تذهب رجاءً

89
00:08:59,810 --> 00:09:01,060
سامحيني

90
00:09:09,400 --> 00:09:10,650
...ميز-سان

91
00:09:16,660 --> 00:09:24,120
...ما الفائدة من جمع البلورات حتّى الآن

92
00:09:25,240 --> 00:09:27,170
إن كان هذا ما آلَ إليه حال ميز-سان؟

93
00:09:30,130 --> 00:09:31,300
ما هذا الضوء؟

94
00:09:35,290 --> 00:09:39,860
!إنّه الدرع الاصطناعيّ الّذي يحمل بلورة التوباز

95
00:09:40,850 --> 00:09:41,820
!جلالتك

96
00:09:41,820 --> 00:09:44,730
اطمئني، لن أهلك بسهولة

97
00:09:50,230 --> 00:09:52,530
احرص على سلامتك رجاءً

98
00:09:54,020 --> 00:09:56,570
!أكانت البلورة الخامسة على هذه المقربة منّا؟

99
00:09:56,830 --> 00:09:58,270
لا يسعني تجاهل هذا

100
00:09:59,550 --> 00:10:03,090
انتظريني يا ميز-سان، سأعود في الحال

101
00:10:30,480 --> 00:10:31,540
!ماذا؟

102
00:10:32,130 --> 00:10:33,570
...مـ-مُحال

103
00:10:35,610 --> 00:10:37,690
!أما زلتِ على قيد الحياة يا ميز؟

104
00:10:37,820 --> 00:10:40,120
!ها أنا قادمةٌ أيّها الدرع الملعون

105
00:10:40,490 --> 00:10:42,920
!سنثأر لموت أونيه-ني-ساما

106
00:10:44,900 --> 00:10:45,580
!فايغر

107
00:10:49,000 --> 00:10:51,420
حسبتكم ميز، فإذا بكم مجرّد حشراتٍ بائسة

108
00:10:51,560 --> 00:10:53,960
!سنثأر لموت أونيه-ني-ساما

109
00:10:54,540 --> 00:10:56,300
!ولن نُهزم قبل تحقيق ذلك

110
00:11:02,580 --> 00:11:03,580
حمقى

111
00:11:10,190 --> 00:11:14,400
!حمقى، فدولغر لا يُشكّل أيَّ خطرٍ دون ميز

112
00:11:14,650 --> 00:11:17,880
!كفاك تبجّحًا

113
00:11:28,690 --> 00:11:29,700
!سوليود

114
00:11:29,770 --> 00:11:31,100
أأنتما بخير؟

115
00:11:34,960 --> 00:11:37,160
!بديع، بديعٌ للغاية

116
00:11:37,160 --> 00:11:39,050
يا لبهاء تعذيبكم

117
00:11:39,300 --> 00:11:42,760
لا شيء يضاهي بهاء رؤية المحتضرين وهم يتعذّبون

118
00:11:45,470 --> 00:11:46,430
ماذا؟

119
00:11:48,930 --> 00:11:50,060
ما هذا؟

120
00:11:50,190 --> 00:11:54,060
!إنّه الدرع الاصطناعيّ الملكيّ؛ دراكون

121
00:11:54,760 --> 00:11:56,150
!هذا ثأرٌ لميز

122
00:12:13,670 --> 00:12:16,590
أين أنا؟ أمتُّ يا ترى؟

123
00:12:16,720 --> 00:12:19,000
ظهرتِ في النهاية إذن

124
00:12:20,130 --> 00:12:22,970
تتبّعتِ طورنا إلى هذا المكان

125
00:12:23,040 --> 00:12:24,900
أحسنتِ صُنعًا أيّتها الماحية

126
00:12:25,180 --> 00:12:26,550
من أنتم؟ وأين أنتم؟

127
00:12:26,550 --> 00:12:30,290
لكنَّ ظهوركِ هنا يعني نفاد حظّكِ

128
00:12:51,870 --> 00:12:53,750
...رأيتُ هذا المكان من قبل

129
00:12:54,400 --> 00:12:57,320
سنستأصل شأفتكِ

130
00:12:57,920 --> 00:12:59,530
فأنتِ تشكّلين خطرًا

131
00:12:59,920 --> 00:13:01,960
لا يجوز بقاؤكِ على قيد الحياة

132
00:13:04,220 --> 00:13:06,820
ماذا؟ عمَّ تتحدّثان؟

133
00:13:10,090 --> 00:13:12,980
هذا يُماثل ما حدث حين أتيتُ إلى هذا العالم

134
00:13:19,420 --> 00:13:23,390
!لا، كفى

135
00:13:32,040 --> 00:13:32,870
من أنتِ؟

136
00:13:33,750 --> 00:13:38,380
!هلّا هلكتِ وفنيتِ أيّتها الماحية؟

137
00:13:39,130 --> 00:13:42,220
!الماحية؟ ما الّذي تعنينه؟

138
00:13:43,710 --> 00:13:45,880
...في سبيل تحقيق غاياتنا

139
00:13:46,590 --> 00:13:51,730
...أجل، لنحكم هذا العالم كآلهةٍ، يتحتّم علينا استئصالكِ

140
00:13:52,120 --> 00:13:53,260
!يا ميز

141
00:13:54,600 --> 00:13:58,480
أنتما من أذقتما ميل-تشان ورفاقها كلّ هذا العذاب إذن

142
00:13:59,480 --> 00:14:02,570
!وكذلك أهل بيستال وبالانيا

143
00:14:02,570 --> 00:14:07,060
لا يمكن الإبقاء على حياة من يُهدّد وجودنا مثلكِ

144
00:14:15,450 --> 00:14:16,820
لا جدوى

145
00:14:17,230 --> 00:14:22,980
...رورو، دارك، نايتو، باجورا، فوم

146
00:14:24,450 --> 00:14:25,340
!ماذا؟

147
00:14:26,590 --> 00:14:27,880
!هات

148
00:14:33,930 --> 00:14:35,060
...أ-أيّها الـ

149
00:14:42,480 --> 00:14:45,150
!تذوّق بأس دراكون

150
00:14:48,600 --> 00:14:49,760
مُذهل

151
00:14:50,360 --> 00:14:53,530
وجود درعين اصطناعيّان يحملان بلورتي التوباز والياقوت على مقربةٍ كهذه

152
00:14:54,700 --> 00:14:56,820
!ما الّذي يجدر بي فعله؟

153
00:15:00,330 --> 00:15:01,330
ماذا؟

154
00:15:03,170 --> 00:15:04,350
!أخي

155
00:15:05,420 --> 00:15:07,650
كنتُ بانتظارك يا ملك فارماونت

156
00:15:08,620 --> 00:15:09,440
!فات الأوان

157
00:15:16,560 --> 00:15:18,020
!تبًّا

158
00:15:21,560 --> 00:15:22,850
انتهى أمرك

159
00:15:26,530 --> 00:15:27,730
!مُت

160
00:15:37,080 --> 00:15:38,520
!جلالتك

161
00:15:48,190 --> 00:15:50,740
عجزتُ عن الثأر وفقدتُ دراكون أيضًا

162
00:15:51,430 --> 00:15:53,500
يا له من وغدٍ محظوظ

163
00:15:54,880 --> 00:15:56,590
لكنّها نهايته

164
00:15:59,140 --> 00:16:01,600
أرجو ألّا تتدخّل يا أخي

165
00:16:01,690 --> 00:16:02,490
غورجيس

166
00:16:02,690 --> 00:16:05,100
،الضغائن المحفورة في جسدي

167
00:16:06,060 --> 00:16:10,860
...لن تزول حتّى أُمزّقهم إربًا إربًا بهاتين اليدين

168
00:16:12,070 --> 00:16:13,680
!ولن تهدأ نفسي قبل ذلك

169
00:16:14,280 --> 00:16:15,820
افعل ما يحلو لك

170
00:16:19,240 --> 00:16:21,790
أهذه هي قوّة الماحية؟

171
00:16:23,670 --> 00:16:27,000
الماحية؟ أتقصدانني أنا؟

172
00:16:28,210 --> 00:16:31,630
!اهلكي أيّتها الماحية الّتي تعترض طريقنا

173
00:16:34,640 --> 00:16:36,670
!توارَيْ عن أنظارنا

174
00:16:37,470 --> 00:16:41,680
!موتي، موتي

175
00:16:38,930 --> 00:16:42,770
!تلاشي، تلاشي

176
00:16:52,240 --> 00:16:54,650
...إن هزمتُهما فستنتهي هذه الحرب

177
00:16:57,620 --> 00:17:01,480
إن أطحتُ بهما فستضع الحرب أوزارها

178
00:17:01,500 --> 00:17:02,330
!تلاشي

179
00:17:02,410 --> 00:17:03,400
!موتي

180
00:17:03,980 --> 00:17:05,370
!عليَّ إلحاق الهزيمة بكما

181
00:17:07,130 --> 00:17:08,120
!بكما

182
00:17:11,840 --> 00:17:12,800
!ميل-تشان

183
00:17:16,800 --> 00:17:20,250
!عجزتما عن تحريك ساكنٍ، والآن تذوّقا العذاب

184
00:17:22,890 --> 00:17:26,170
!سأثأر لموت أونيه-ني-ساما

185
00:17:27,690 --> 00:17:28,540
!أجل

186
00:17:28,810 --> 00:17:32,010
!يا لكما من وقحتين، ما رأيكما بهذا إذن؟

187
00:17:35,210 --> 00:17:36,100
!ميل-ساما

188
00:17:41,700 --> 00:17:43,620
بلغتما نهايتكما أخيرًا

189
00:17:43,700 --> 00:17:45,980
!ابكيا واصرخا واستجدا النجاة بأرواحكما

190
00:17:46,210 --> 00:17:49,540
وحينها قد أُريحكما بموتةٍ سريعة

191
00:17:49,570 --> 00:17:50,190
!مستحيل

192
00:17:50,270 --> 00:17:50,730
ماذا؟

193
00:17:52,800 --> 00:17:55,280
!لا أرهب الموت

194
00:17:57,260 --> 00:17:59,930
ففيه سألتقي بأونيه-ني-ساما

195
00:18:00,090 --> 00:18:01,810
بل يغمرني الفرح بذلك

196
00:18:02,510 --> 00:18:04,680
!ماذا؟ كفاكِ تفوّهًا بالهراء

197
00:18:10,240 --> 00:18:11,700
!سحقًا لكِ

198
00:18:12,270 --> 00:18:15,410
!سأحقّق رغبتكِ إذن

199
00:18:15,580 --> 00:18:17,180
