1
00:00:00,750 --> 00:00:05,270
.وقريبًا، ستفقدون كلّ قوّتكم

2
00:00:05,700 --> 00:00:14,790
،بمجرّد فقدان القوّة الّتي مُنحت إليكم
.ستدركون أنّكم لا شيء

3
00:00:15,940 --> 00:00:17,070
...سوها

4
00:00:44,640 --> 00:00:45,960
!سُحقًا لك

5
00:00:55,740 --> 00:00:56,410
!سوها

6
00:00:57,010 --> 00:01:00,180
!سوها، استيقظي! سوها

7
00:01:01,540 --> 00:01:03,620
.علينا الخروج من هنا

8
00:01:13,000 --> 00:01:14,100
.لا يمكننا المغادرة

9
00:01:15,470 --> 00:01:19,980
هل هذا الضّوء هو القوّة الملكيّة غير المختومة؟

10
00:01:20,380 --> 00:01:21,990
وذلك ما يحبسها هنا؟

11
00:01:23,250 --> 00:01:24,500
...سوها

12
00:01:27,480 --> 00:01:31,860
.ثمّة أمر لم أخبرك به بعد

13
00:01:32,600 --> 00:01:38,030
في تلك اللّيلة، كنتُ خائفًا
.حتّى الموت من عضّ عنقك

14
00:01:38,780 --> 00:01:42,040
.لم أعرف ماذا قد أفعل لو آذيتك

15
00:01:43,040 --> 00:01:50,880
ولكنّ الأهمّ من ذلك، أنّني كنت
.سعيدًا بمعرفة أنّك تثقين بي

16
00:01:51,790 --> 00:01:59,760
لذا أعدك بأنّني سأردّ جميلَ
.ثقتك بي بإخراجك من هنا الآن

17
00:02:00,630 --> 00:02:01,510
.هيلي

18
00:02:03,470 --> 00:02:04,570
سوها؟

19
00:02:06,470 --> 00:02:11,450
.هيلي... أ-أتيتَ لإنقاذي مجدّدًا

20
00:02:12,180 --> 00:02:17,560
...حينها والآن... أجدك دائمًا

21
00:02:19,560 --> 00:02:20,990
...قربي

22
00:02:21,530 --> 00:02:22,410
.نعم

23
00:02:30,070 --> 00:02:31,040
!هيلي

24
00:02:34,330 --> 00:02:38,550
!حينها والآن، أجدك دائمًا تعترض طريقي

25
00:02:38,930 --> 00:02:45,460
!لولاك أنت، لكانت الأميرة قد اختارتني أنا

26
00:02:45,460 --> 00:02:46,560
!هيلي

27
00:02:46,780 --> 00:02:49,140
!كانت لتختارني في هذه الحياة على الأقلّ

28
00:02:52,210 --> 00:02:54,150
!توقّف

29
00:02:57,660 --> 00:03:01,070
!هيلي، تماسك! انهض

30
00:03:02,160 --> 00:03:03,820
!لماذا؟ لا يمكنني الخروج

31
00:03:03,820 --> 00:03:05,910
!هيلي، تماسك

32
00:03:11,420 --> 00:03:12,600
.أيّتها الأميرة

33
00:03:13,460 --> 00:03:16,380
.انتهى الأمر الآن

34
00:03:17,630 --> 00:03:22,910
.لقد خارت قوى جميع من أتوا لإنقاذ

35
00:03:23,650 --> 00:03:28,010
.وما زال لديّ العديد من الأتباع

36
00:03:28,860 --> 00:03:33,260
.القوّة الّتي منحتِها لهم عادت أيضًا

37
00:03:34,410 --> 00:03:39,900
.وستصير كلّها لي في النّهاية

38
00:03:40,340 --> 00:03:46,410
،سيُسلب كلّ شيء منك
.وستكونين لي للأبد

39
00:03:55,330 --> 00:03:56,590
!داردان

40
00:04:05,140 --> 00:04:07,250
...خارت قواي

41
00:04:08,640 --> 00:04:12,390
.سوها، عليّ حمايتك

42
00:04:13,540 --> 00:04:16,780
.لقد عالجتِ جراحنا

43
00:04:17,590 --> 00:04:20,310
.تشاركتِ قوّتك معنا أيضًا

44
00:04:21,560 --> 00:04:25,910
لذلك لماذا أنا عاجز عن فعل
أيّ شيء من أجلك الآن؟

45
00:04:26,950 --> 00:04:32,580
،بدون القوّة الّتي منحتني إيّاها
.أنا بلا فائدة

46
00:04:37,880 --> 00:04:40,200
.لا تضيّعي وقتك

47
00:04:41,130 --> 00:04:47,020
هل ستهربين وتتجسّدين ثانية؟
.حاولي ذلك

48
00:04:47,020 --> 00:04:52,600
مهما أخذ الأمر من وقت
.أو أينما اختبأت، فسأجدك

49
00:04:56,870 --> 00:04:59,570
ألم تفكّري يومًا أنّ ذلك غريب؟

50
00:05:00,150 --> 00:05:04,660
لماذا كانوا يشكّون دائمًا في أنّك مصّاصة دماء؟

51
00:05:05,160 --> 00:05:09,660
لماذا كان الأشخاص من حولك دائمًا
يتعرّضون لهجمات مصّاصي دماء؟

52
00:05:10,900 --> 00:05:12,660
...اسمعي يا سوها

53
00:05:12,660 --> 00:05:16,900
.مات كريس بسببك

54
00:05:18,050 --> 00:05:22,190
لأنّك كنت تهتمّين لأمره
،أكثر من أيّ شخص آخر

55
00:05:22,190 --> 00:05:27,130
.خطّطتُ لكلّ شيء لأحلّ محلّه

56
00:05:32,470 --> 00:05:35,270
أنت تفهمينني الآن، أليس كذلك؟

57
00:05:35,270 --> 00:05:42,060
حتّى لو نجوتِ منّي الآن، ستلقين
.المصير نفسه في حياتك القادمة

58
00:05:43,650 --> 00:05:45,110
!داردان

59
00:05:47,650 --> 00:05:50,280
.فات الأوان الآن

60
00:05:52,530 --> 00:05:56,390
.استنفدتِ آخر ما تبقّى لديك من قوّة

61
00:05:56,390 --> 00:06:01,030
ما زلت لا تعرفين كيف
.تستخدمينها بالشّكل الصّحيح

62
00:06:01,030 --> 00:06:04,010
.أنت لا تستحقّينها

63
00:06:04,010 --> 00:06:07,430
.لهذا السّبب سآخذها منك

64
00:06:09,420 --> 00:06:12,990
أعلم أنّني أستطيع استخدامها
.أفضل منك بكثير

65
00:06:13,720 --> 00:06:16,170
.استريحي قليلاً الآن

66
00:06:16,170 --> 00:06:19,730
.سأنهي هذا الأمر في هذه الأثناء

67
00:06:25,940 --> 00:06:29,940
،يُفترض أنّ قوّتي قد اختفت
فما السّبب يا ترى؟

68
00:06:32,160 --> 00:06:34,140
.كنتُ أخفي الأمر

69
00:06:35,210 --> 00:06:41,630
أخفيت أنّ في عروقي تجري دماء
.مصّاص دماء ومستذئب معًا

70
00:06:42,430 --> 00:06:47,640
،لكن حتّى بعد أن اعترفتُ بذلك
.ظلّوا أصدقاء لي

71
00:06:49,170 --> 00:06:56,430
الهدف من هذه القوّة هو استعمالها
...لإنقاذهم وإنقاذ سوها، لكن

72
00:06:56,690 --> 00:07:01,240
لم أكن سعيدًا عندما أدركتُ
أنّي أملك هذه القوّة

73
00:07:02,060 --> 00:07:06,380
.لأنّي لم أفهم لماذا أملكها

74
00:07:07,300 --> 00:07:13,000
لكنّي أفهم الآن أنّها ليست
.لأذيّة الآخرين، بل لحمايتهم

75
00:07:13,750 --> 00:07:17,790
فلماذا لا أستطيع استعمالها؟

76
00:07:18,020 --> 00:07:22,110
في العادة، كنتُ لأستطيع الصّعود
.إلى هناك في لمح البصر

77
00:07:22,900 --> 00:07:26,300
ألن أتحرّك كذلك ثانية أبدًا؟

78
00:07:27,090 --> 00:07:28,870
.عليّ إنقاذ سوها

79
00:07:29,270 --> 00:07:33,260
.لا أصدّق أنّي عاجز في لحظة حرجة كهذه

80
00:07:33,580 --> 00:07:37,400
.سُحقًا له. سحقًا له

81
00:07:37,760 --> 00:07:41,020
.سُحقًا له لأنّه يفعل هذا بسوها

82
00:07:41,020 --> 00:07:43,770
.أتمنّى لو أستطيع ضربه بكلّ ما أستطيع من قوّة

83
00:07:44,300 --> 00:07:45,520
...لكن

84
00:07:45,520 --> 00:07:48,530
!سُحقًا، سُحقًا، سُحقًا

85
00:07:48,840 --> 00:07:50,360
.كم أكره هذا

86
00:07:51,350 --> 00:07:54,340
.لا أريد فقدان أيّ أحد أهتمّ لشأنه

87
00:07:55,640 --> 00:07:59,580
عليّ حمايتهم، فلماذا أعجز عن ذلك؟

88
00:08:15,560 --> 00:08:19,090
.كنتُ أخشى الظّلام عندما كنتُ طفلاً

89
00:08:19,830 --> 00:08:23,890
.لكنّي لم أعد كذلك في مرحلة ما

90
00:08:30,620 --> 00:08:32,440
.الظّلام هو مجالي

91
00:08:33,100 --> 00:08:35,510
.الظّلال جزء منّي

92
00:08:37,180 --> 00:08:39,290
.عليّ إنقاذ البقيّة

93
00:08:53,750 --> 00:08:54,470
!هيلي

94
00:09:05,540 --> 00:09:07,370
!أنا وشيك

95
00:09:08,270 --> 00:09:11,280
!أوشك على بلوغ النّهاية

96
00:09:13,810 --> 00:09:16,300
هيلي، هل أنت بخير يا هيلي؟

97
00:09:17,560 --> 00:09:20,870
نوا، كيف استعملت قواك؟

98
00:09:20,870 --> 00:09:22,700
.حتّى أنا لستُ واثقًا من ذلك

99
00:09:23,480 --> 00:09:25,350
.ظننتُ أنّي لم أعد قادرًا على استعمالها

100
00:09:25,980 --> 00:09:31,870
ولكن لسبب ما، شعرتُ
.أنّي امتلكتُ هذه القوّة دائمًا

101
00:09:32,650 --> 00:09:33,260
.لا

102
00:09:34,350 --> 00:09:36,050
.أعلم أنّي شعرتُ بها

103
00:09:36,410 --> 00:09:38,930
.لم أُمنح هذه القوّة من سوها

104
00:09:39,970 --> 00:09:41,390
.صحيح

105
00:09:41,750 --> 00:09:46,030
أتذكر ما قالته مارج؟
.قالت أنّنا أسياد مصّاصي دماء

106
00:09:46,030 --> 00:09:46,940
.نعم

107
00:09:47,220 --> 00:09:50,270
...شعاراتنا لم تختفي، ما يعني

108
00:09:50,270 --> 00:09:54,600
ما زلنا نملك قوانا الّتي استيقظت
.بعد أن صرنا أسياد مصّاصي الدّماء

109
00:09:54,930 --> 00:09:59,990
.لا بدّ أنّنا نسينا أمر قوانا الحقيقيّة

110
00:09:59,990 --> 00:10:00,950
.نعم

111
00:10:01,810 --> 00:10:03,000
!تذكّروا

112
00:10:06,600 --> 00:10:07,290
هيلي؟

113
00:10:09,880 --> 00:10:12,250
.استعاد هيلي قوّته

114
00:10:12,700 --> 00:10:14,960
.اسمعوا يا رفاق

115
00:10:14,960 --> 00:10:18,630
.نملك جميعًا قوى كانت لدينا دائمًا

116
00:10:19,140 --> 00:10:22,130
.تذكّروا ذلك يا رفاق

117
00:10:34,230 --> 00:10:38,280
!سأصير ملكًا الآن

118
00:10:39,900 --> 00:10:41,040
!شيون

119
00:10:41,040 --> 00:10:42,610
!لا تدعهم يأخذونها

120
00:10:43,530 --> 00:10:46,660
!اقتلوا رفاقكم

121
00:10:52,090 --> 00:10:54,040
مارج، هل أنت بخير؟

122
00:10:54,040 --> 00:10:55,750
.نعم. شكرًا لك

123
00:10:56,670 --> 00:10:57,780
.سوها

124
00:10:57,780 --> 00:10:59,930
!سينتهي هذا الآن

125
00:11:04,730 --> 00:11:07,400
!كيف عادت قواكم؟

126
00:11:07,400 --> 00:11:10,520
!سحقًا لك أيّها المستذئب

127
00:11:24,520 --> 00:11:27,650
...يكفي

128
00:11:27,650 --> 00:11:28,370
ماذا؟

129
00:11:29,870 --> 00:11:32,370
.يكفي

130
00:11:34,070 --> 00:11:35,350
...أنا

131
00:11:37,390 --> 00:11:39,420
.سأنهي هذا

132
00:11:47,970 --> 00:11:49,140
!إيان

133
00:11:57,150 --> 00:11:59,750
.ما عدتُ بحاجة لأيّ من هذا

134
00:12:00,150 --> 00:12:04,160
.لا قوّة الأميرة، ولا الأميرة نفسها

135
00:12:04,910 --> 00:12:08,060
،إن لم أستطع العيش مع الأميرة

136
00:12:09,310 --> 00:12:13,660
.فلا أمانع الموت معها

137
00:12:18,980 --> 00:12:19,960
ما الّذي يفعله؟

138
00:12:20,510 --> 00:12:21,630
!سوها

139
00:12:44,360 --> 00:12:49,930
.أيّتها الأميرة، سأكون معك في النّهاية

140
00:12:52,520 --> 00:12:55,370
...ولكن قبل ذلك

141
00:12:58,190 --> 00:13:00,340
.سأتولّى أمرك

142
00:13:28,770 --> 00:13:33,420
سوها، لماذا هذا ثانية؟

143
00:13:37,950 --> 00:13:40,230
!سوها! سوها

144
00:13:43,330 --> 00:13:46,970
.هذا صحيح، سنقوم بهذا ثانية فحسب

145
00:13:47,970 --> 00:13:50,930
!سنولد من جديد، وسنتقابل ثانية

146
00:13:51,650 --> 00:13:56,660
!لا يهمّ كم ألفَ سنة سيأخذ ذلك، فسأجدك

147
00:13:57,190 --> 00:13:59,460
!أقسم أنّي سأبحث عنك

148
00:14:01,190 --> 00:14:04,030
.هيلي، أنا آسفة

149
00:14:05,370 --> 00:14:08,280
.لا يمكنني أن أتجسّد ثانية

150
00:14:08,860 --> 00:14:12,950
.هذه هي نهاية حياتي

151
00:14:15,420 --> 00:14:23,560
،إنّ لقاءكم جميعًا في هذه الحياة

152
00:14:23,560 --> 00:14:28,310
...ومصادقتكم، وقضاء الوقت معًا

153
00:14:29,750 --> 00:14:32,210
.أسعدني كثيرًا

154
00:14:33,110 --> 00:14:36,060
.لذلك... فلا بأس

155
00:14:40,020 --> 00:14:45,780
،بما أنّ هذه هي النّهاية
.فلن أخفي أيّ شيء بعد الآن

156
00:14:47,140 --> 00:14:50,320
.أنا أحبّك يا هيلي

157
00:14:52,770 --> 00:14:56,340
.أنا أحبّك أيضًا يا سوها

158
00:14:59,830 --> 00:15:00,850
.هيلي

159
00:15:02,210 --> 00:15:10,750
كنتَ أعظم فارس في حياتي
.في الماضي وفي الحاضر أيضًا

160
00:15:12,010 --> 00:15:18,100
،أيّتها الأميرة، سأكون فارسك دائمًا
.فارسك أنت وحدك

161
00:16:04,010 --> 00:16:07,190
.هذه هي قوّة الأميرة إذًا

162
00:16:08,470 --> 00:16:11,190
!لا تعرفين كيف تستعملينها كما يجب

163
00:16:15,650 --> 00:16:17,090
...سُحقًا

164
00:16:19,300 --> 00:16:25,650
،داردان، بعد أن استعدتُ قوّتي الآن
.فلا يمكنني مسامحتك

165
00:16:26,950 --> 00:16:31,300
.إنّ جرائمك شنيعة جدًّا

166
00:16:32,250 --> 00:16:40,310
.أيّتها الأميرة، كلّ ما أردتُه هو حبّك

167
00:16:41,350 --> 00:16:46,000
أتدرين كم من الصّعب عليّ أنا، رجل
من مكانة متدنّية، أن أعمل جاهدًا

168
00:16:46,000 --> 00:16:48,030
حتّى أصل لمقعد المستشار؟

169
00:16:48,030 --> 00:16:52,200
.فعلتُ كلّ ذلك من أجل حبّك

170
00:16:53,230 --> 00:16:56,530
!ليتك أحببتني فحسب

171
00:16:56,990 --> 00:17:00,780
!ما كنتُ حينها لأقوم بأيّ من هذا

172
00:17:02,860 --> 00:17:04,250
.سبق وأخبرتك

173
00:17:04,910 --> 00:17:08,750
وحدهم المواطنون الّذين عهدوا
بولائهم بكلّ صدق

174
00:17:09,330 --> 00:17:11,870
.بإمكانهم إن يرثوا القوّة الملكيّة

175
00:17:13,590 --> 00:17:20,430
لا يمكن لأولئك الّذين حاولوا
.أخذها بالقوّة أن يحصلوا عليها

176
00:17:21,070 --> 00:17:22,570
.ونفس الشّيء ينطبق على الحبّ

177
00:17:23,830 --> 00:17:25,420
.عرفتُ ذلك

178
00:17:26,270 --> 00:17:30,270
.عرفتُ أنّ حبّي ما كان ليسير كما أردت

179
00:17:30,930 --> 00:17:35,780
رغم أنّي عرفتُ أنّ قلبك
...ليس لي من البداية

180
00:17:36,230 --> 00:17:38,530
...لا، بل لأنّني عرفتُ ذلك

181
00:17:39,450 --> 00:17:42,290
.استعملتُ المكانة كعُذر

182
00:17:43,160 --> 00:17:47,290
،ورغم معرفتي بذلك، فمهما حاولتُ جاهدًا

183
00:17:47,950 --> 00:17:53,840
.لم أستطع تغيير كيف أشعر حيالك فحسب

184
00:17:55,380 --> 00:18:03,150
...سيلين، ستكونين دائمًا بالنّسبة لي

185
00:18:40,610 --> 00:18:41,780
...أيّتها الأميرة

186
00:18:42,490 --> 00:18:44,930
.لا، صرتِ الملكة الآن

187
00:18:45,500 --> 00:18:49,490
.لا داعي لذلك، ناديني سوها فحسب

188
00:18:49,490 --> 00:18:50,310
...لكن

189
00:18:50,630 --> 00:18:55,320
اسمحي لي أن أشكرك بشكل
.رسميّ على عثورك عليهم

190
00:18:56,900 --> 00:18:59,410
.فعلتُ ما كان عليّ فعله فحسب

191
00:18:59,950 --> 00:19:02,950
.يا رفاق، شكرًا لقدومكم لإنقاذي

192
00:19:10,960 --> 00:19:14,460
ما الّذي ستفعلينه الآن؟

193
00:19:15,660 --> 00:19:19,260
.لم يعد هنالك وجود للمملكة أو لداردان الآن

194
00:19:20,020 --> 00:19:23,660
.أعتقد أنّي أودّ أن أعيش حياتي في الحاضر

195
00:19:26,970 --> 00:19:28,620
.لديّ أخبار جيّدة

196
00:19:29,470 --> 00:19:33,090
.صارت غرفة مسكن جديدة شاغرة
.يمكنك الانتقال إليها

197
00:19:33,860 --> 00:19:37,190
.فعلاً؟ شكرًا لك

198
00:19:37,750 --> 00:19:40,890
لا بدّ أنّه كان من الصّعب عليك
.العيش في تل الغرفة القديمة

199
00:19:40,890 --> 00:19:44,820
،الغرفة الجديدة متشاركة
.لذلك كوني لطيفة مع زميلات سكنك

200
00:19:44,820 --> 00:19:46,700
...زميلات سكن

201
00:19:50,230 --> 00:19:51,060
...أنت

202
00:19:51,060 --> 00:19:53,460
...عـ-عفوًا

203
00:19:54,860 --> 00:19:57,220
!أنت قويّة جدًّا

204
00:19:58,380 --> 00:20:02,050
.فـ-فكّرتُ في التّنظيف تحت السّرير فحسب

205
00:20:02,300 --> 00:20:03,270
.سأساعدك

206
00:20:03,270 --> 00:20:04,730
.حسنًا

207
00:20:04,730 --> 00:20:06,680
—انظري، إنّ البرغيّ في هذا السّرير

208
00:20:06,680 --> 00:20:07,640
.سوها

209
00:20:09,100 --> 00:20:09,810
!هيلي

210
00:20:10,430 --> 00:20:11,630
!والبقيّة أيضًا

211
00:20:12,200 --> 00:20:13,690
.أتينا للمساعدة

212
00:20:13,690 --> 00:20:18,360
،شكرًا على قدومكم
.لكن لا يوجد الكثير هنا لفعله

213
00:20:18,360 --> 00:20:20,460
بالمناسبة، هل تشربون بعض الشّاي؟

214
00:20:20,460 --> 00:20:22,130
.نعم، كم أودّ ذلك

215
00:20:22,130 --> 00:20:24,070
.لا أمانع إذًا

216
00:20:26,910 --> 00:20:29,450
!عيد ميلاد سعيد يا كان

217
00:20:29,450 --> 00:20:30,690
!تفضّل هذه

218
00:20:30,690 --> 00:20:31,650
.شكرًا لك

219
00:20:31,650 --> 00:20:34,010
!سوها، لقد أتيتِ

220
00:20:34,010 --> 00:20:35,560
.استمتعي بوقتك

221
00:20:35,560 --> 00:20:36,330
!أكيد

222
00:20:36,330 --> 00:20:39,240
كيف يفترض بي الاستمتاع بوقتي؟

223
00:20:39,240 --> 00:20:42,220
.أشعر بالملل مع أنّي وصلتُ للتّوّ

224
00:20:42,220 --> 00:20:46,140
.سوها، ليس لدينا وقت لهذا. هيّا بنا

225
00:20:46,140 --> 00:20:48,510
!دعَونا سوها فقط

226
00:20:48,510 --> 00:20:50,640
!ما الّذي تفعلونه هنا أنتم أيضًا؟

227
00:20:50,640 --> 00:20:54,190
!لقد أفسدتم حفلة عيد ميلادنا

228
00:20:54,190 --> 00:20:56,190
!اتركوا هداياكم هنا وغادروا

229
00:20:56,190 --> 00:20:58,220
!تريدون الهدايا فحسب

230
00:20:58,220 --> 00:21:00,130
!سيقدّرها كان كثيرًا

231
00:21:00,130 --> 00:21:02,760
.شكرًا على دعوتي اليوم

232
00:21:02,760 --> 00:21:04,400
.أنا مسرور لأنّك أتيت

233
00:21:06,040 --> 00:21:07,930
هل أنت وهيلي منسجمان معًا؟

234
00:21:09,580 --> 00:21:10,310
.نعم

235
00:21:12,830 --> 00:21:15,410
،سوها، كما سبق وأخبرتك

236
00:21:15,410 --> 00:21:20,630
يقع المستذئبون في حبّ أيّ شخص
.نراه خلال الخسوف لبقيّة حياتنا

237
00:21:20,950 --> 00:21:24,510
.لذلك فسأحبّك للأبد

238
00:21:27,430 --> 00:21:28,830
.لكنّ ذلك ليس كلّ شيء

239
00:21:29,460 --> 00:21:31,080
.أنا معجب بك بشدّة

240
00:21:31,750 --> 00:21:35,430
.أنا مسرور لأنّك من التقيتها تلك اللّيلة

241
00:21:35,980 --> 00:21:40,270
.أريدك أن تكوني سعيدة

242
00:21:44,760 --> 00:21:46,280
.شكرًا لك يا كان

243
00:21:46,610 --> 00:21:48,530
.أنت هي سوها العظيمة إذًا

244
00:21:48,530 --> 00:21:51,020
.اسمي لوكا

245
00:21:51,020 --> 00:21:52,700
.إنّه لشرف لي أن ألقاك

246
00:21:54,900 --> 00:21:56,580
.سامحي أخي

247
00:21:56,910 --> 00:21:59,500
.أنا لوي، التّوأم الأصغر

248
00:21:59,500 --> 00:22:02,170
لوكا، لوي! متى وصلتما إلى هنا؟

249
00:22:02,550 --> 00:22:04,310
.آسفان على التّأخير

250
00:22:04,310 --> 00:22:06,240
.المعذرة أيّتها الملكة

251
00:22:06,240 --> 00:22:10,680
من الآن فصاعدًا، سنقف إلى
.جانبك وسنحميك أيّتها الملكة

252
00:22:10,910 --> 00:22:15,640
.لا... أنا لم أعد ملكة
.أنا مجرّد تلميذة ثانويّة الآن

253
00:22:18,560 --> 00:22:19,710
!بصحّتكم

254
00:22:27,380 --> 00:22:30,440
.الظّلام دامس. نحتاج لبعض النّور يا جينو

255
00:22:30,440 --> 00:22:32,450
.أنا لستُ مصباحًا

256
00:22:32,450 --> 00:22:36,120
أخبروني، متى كانت آخر مرّة
استعملتم فيها قواكم؟

257
00:22:36,610 --> 00:22:38,790
.عندما شويتُ المارشميلو من أجل سوها

258
00:22:38,790 --> 00:22:41,210
خلال تدريب الكرة اللّيليّة؟

259
00:22:41,210 --> 00:22:46,050
للإمساك بالكرة الّتي رماها إيان
.خارج الأكاديميّة بقوّته الوحشيّة

260
00:22:46,050 --> 00:22:48,090
.لصنع ظلّ سلطعون

261
00:22:48,340 --> 00:22:51,100
.لا شيء من ذلك يبدو مفيدًا جدًّا

262
00:22:51,100 --> 00:22:52,970
ماذا عنك إذًا؟

263
00:22:53,320 --> 00:22:57,480
.عندما جعلتُ نادي الفنون يرسمون لوحات لي

264
00:22:57,480 --> 00:22:59,840
!لا تستعملها لذلك الغرض

265
00:22:59,840 --> 00:23:01,870
.لم أستعمل قوّتي على الإطلاق مذّاك الوقت

266
00:23:01,870 --> 00:23:05,630
نعم، لأنّك لا تستطيع القيام
.بأيّ شيء ممتع كذئب

267
00:23:05,630 --> 00:23:10,260
بالنّظر للأمر هكذا، على الأرجح
.أنّ هيلي يستعمل تخاطره أكثر منّا

268
00:23:12,370 --> 00:23:16,200
هل كنتما تتحدّثان بشكل تخاطريّ للتّوّ؟

269
00:23:16,200 --> 00:23:17,850
منذ متى؟

270
00:23:17,850 --> 00:23:20,160
ما الّذي كنتما تتحدّثان عنه؟

271
00:23:20,160 --> 00:23:21,940
.لـ-لم نكن نتحدّث عن أيّ شيء

272
00:23:21,940 --> 00:23:22,960
فعلاً؟

273
00:23:22,960 --> 00:23:24,380
.أخبرنا يا هيلي

274
00:23:24,380 --> 00:23:26,200
.نحن ننتظر

275
00:23:26,530 --> 00:23:27,460
.إنّه سرّ

276
00:23:27,750 --> 00:23:31,410
.ماذا؟ لقد احمرّ وجه سوها

277
00:23:31,410 --> 00:23:32,170
!ماذا؟

278
00:23:33,340 --> 00:23:35,730
هيّا، هيّا، عمّ كنتما تتحدّثان؟