1
00:00:04,570 --> 00:00:06,090
!ركلة جيّدة

2
00:00:06,090 --> 00:00:06,920
!أجل

3
00:00:06,920 --> 00:00:08,890
!حسنًا، أنا التّالي

4
00:00:09,640 --> 00:00:10,950
!سوها

5
00:00:10,950 --> 00:00:13,110
!شيون! رفاق

6
00:00:13,720 --> 00:00:15,770
أتيت لمشاهدتنا نتدرّب؟

7
00:00:15,770 --> 00:00:17,990
نعم. المباراة غدًا، صحيح؟

8
00:00:17,990 --> 00:00:19,450
كيف تشعرون؟

9
00:00:19,450 --> 00:00:20,600
!في أفضل حال

10
00:00:20,600 --> 00:00:23,640
.أخطأتَ كلّ تسديداتك

11
00:00:23,640 --> 00:00:24,420
ماذا؟

12
00:00:24,420 --> 00:00:25,750
فعلاً؟

13
00:00:25,750 --> 00:00:27,350
.لكنّنا سنكون بخير

14
00:00:27,350 --> 00:00:30,170
.سنفوز ثانية بفضلي

15
00:00:30,170 --> 00:00:32,310
.سأهدي انتصارنا لك

16
00:00:32,310 --> 00:00:35,680
.ماذا؟ فـ-فعلاً؟ شكرًا لك

17
00:00:35,680 --> 00:00:38,510
.شكرًا على قدومك يا سوها

18
00:00:38,510 --> 00:00:40,430
.أ-أكيد

19
00:00:41,220 --> 00:00:47,190
.وُلدت لأحميك، ويجب أن أستمرّ في حمايتك

20
00:00:49,000 --> 00:00:51,650
.سأبذل جهدي، لذلك آمل أن تشجّعيني

21
00:00:51,650 --> 00:00:55,220
.حـ-حسنًا. آمل فعلاً أن تفوزوا

22
00:00:55,220 --> 00:00:56,200
.نعم

23
00:00:56,200 --> 00:00:57,020
.اسمعي

24
00:00:57,820 --> 00:00:59,580
.من الخطير لك أن تكوني هنا

25
00:00:59,580 --> 00:01:01,710
.إن كنت لا تريدين أن تتأذّي، فابقي بعيدة

26
00:01:02,650 --> 00:01:05,670
سولون، هل أنت قلق عليّ؟

27
00:01:05,670 --> 00:01:08,260
!ماذا؟ لا

28
00:01:08,260 --> 00:01:10,490
!هيّا، لنواصل التّدريب

29
00:01:10,490 --> 00:01:11,280
.أكيد

30
00:01:11,280 --> 00:01:13,490
.حسنًا، أراكم لاحقًا يا رفاق

31
00:01:28,210 --> 00:01:30,230
.مرّت 120 سنة

32
00:01:30,620 --> 00:01:32,670
كيف حالك أيّتها المديرة؟

33
00:01:33,110 --> 00:01:35,610
.لا بأس كما ترون

34
00:01:35,940 --> 00:01:38,740
.ظننّا أنّك استسلمت منذ مدّة طويلة

35
00:01:39,160 --> 00:01:41,660
لم يخطر ببالنا أنّك واصلت
.البحث عنّا حتّى الآن

36
00:01:41,960 --> 00:01:44,580
.لم آتي من أجلكم يا فتيان

37
00:01:45,350 --> 00:01:47,850
.لكنّي مسرورة لأنّنا التقينا ببعضنا

38
00:01:48,620 --> 00:01:50,700
.أرى أنّكم بقيتم معًا جميعًا

39
00:01:50,700 --> 00:01:52,170
ما الّذي يحدث هنا؟

40
00:01:52,470 --> 00:01:54,950
.التقينا ثانية أخيرًا

41
00:01:54,950 --> 00:01:57,170
.سأخبركم أيضًا

42
00:01:57,610 --> 00:02:01,230
ظهرتِ من العدم وتتوقّعين منّا
!الاستماع لك؟ سحقًا لهذا

43
00:02:01,770 --> 00:02:03,770
!لا تستمعوا لها

44
00:02:03,770 --> 00:02:05,350
ومن قال أنّنا سنفعل؟

45
00:02:05,350 --> 00:02:07,100
.غادري في الحال

46
00:02:08,070 --> 00:02:12,440
.لم نعد الأطفال الّذين عرفتهم سابقًا

47
00:02:17,320 --> 00:02:20,060
.هنالك أمور أكثر إلحاحًا الآن

48
00:02:33,750 --> 00:02:34,680
!كان

49
00:02:35,050 --> 00:02:36,730
.آسف لأنّي طلبتُ لقاءك فجأة

50
00:02:36,730 --> 00:02:37,840
هل حدث شيء ما؟

51
00:02:38,180 --> 00:02:39,880
...لا، في الحقيقة

52
00:02:40,210 --> 00:02:43,160
.أردتُ بشدّة إخبارك بشيء فحسب

53
00:02:45,240 --> 00:02:48,350
.أنا أحبّك يا سوها

54
00:02:48,350 --> 00:02:49,320
ماذا؟

55
00:02:50,660 --> 00:02:55,460
.إذا أحبَّ المستذئب، فسيحبّ للأبد

56
00:02:56,530 --> 00:03:00,740
.لذلك سأستمرّ بحبّك حتّى أموت

57
00:03:02,980 --> 00:03:08,790
سأكون سعيدًا جدًّا إن شجّعتني
.في مباراة الكرة اللّيليّة القادمة

58
00:03:10,490 --> 00:03:13,130
.ذلك هو كلّ ما أردتُ قوله

59
00:03:16,940 --> 00:03:19,130
.سأرافقك في طريق العودة

60
00:03:29,220 --> 00:03:33,580
!على الأقلّ، نهائيّ الكرة اللّيليّة اللّيلة

61
00:03:33,580 --> 00:03:38,410
ومرّة أخرى، ستواجه مدرسة مدينة
!سانشاين أكاديميّة ديسيليس

62
00:03:40,530 --> 00:03:43,600
.سأبذل جهدي، لذلك آمل أن تشجّعيني

63
00:03:43,600 --> 00:03:46,910
سأكون سعيدًا جدًّا إن شجّعتني
.في مباراة الكرة اللّيليّة القادمة

64
00:03:46,910 --> 00:03:48,440
ماذا أفعل؟

65
00:03:48,440 --> 00:03:51,410
.أنا أقدّر صداقتي مع كليهما

66
00:03:51,850 --> 00:03:53,920
.هذا ما ظننتُ على الأقلّ

67
00:03:53,920 --> 00:03:56,450
...لكنّهما مهمّين بالنّسبة لي كـ

68
00:03:58,300 --> 00:04:00,550
!عليّ التّركيز على التّشجيع الآن

69
00:04:02,820 --> 00:04:06,470
،هل ستُكرّر أكاديميّة ديسيليس
أبطال السّنة الماضية، نجاحهم؟

70
00:04:06,740 --> 00:04:09,710
أم ستحصل مدرسة مدينة
سانشاين على انتقامها؟

71
00:04:09,710 --> 00:04:13,230
!ستبدأ المباراة المشتعلة بعد قليل

72
00:04:14,330 --> 00:04:17,900
...ماهان، روسلاند، كاميل

73
00:04:18,730 --> 00:04:21,100
.وعدتم أنّكم ستعودون

74
00:04:21,430 --> 00:04:23,150
!لا. عليّ أن أركّز

75
00:04:23,150 --> 00:04:25,410
!سنفوز بهذه المباراة

76
00:04:25,640 --> 00:04:28,050
!سنهزمكم هذه السّنة ثانية بكلّ سهولة

77
00:04:28,050 --> 00:04:28,870
ماذا؟

78
00:04:28,870 --> 00:04:33,220
!سوها! يجلس داعمو فريقنا هناك

79
00:04:34,940 --> 00:04:39,250
.سوها، أعد أن أفوز من أجلك

80
00:04:39,630 --> 00:04:40,990
ماذا أفعل؟

81
00:04:43,130 --> 00:04:46,300
!توشك المباراة أن تبدأ

82
00:05:01,010 --> 00:05:04,490
!عجبًا! هل ستسجّل ديسيليس هدفًا؟

83
00:05:05,400 --> 00:05:07,160
!جينو! أنا هنا

84
00:05:08,460 --> 00:05:08,990
!ممتاز

85
00:05:11,180 --> 00:05:15,010
!تقف سانشاين لها بالمرصاد
!يا له من تصدٍّ قويّ

86
00:05:11,490 --> 00:05:12,590
!شيون

87
00:05:15,010 --> 00:05:16,120
!أحسنت يا كان

88
00:05:16,120 --> 00:05:17,960
!إنزي

89
00:05:22,120 --> 00:05:22,840
!سُحقًا

90
00:05:30,610 --> 00:05:32,660
!تُسجّل ديسيليس أوّلاً

91
00:05:32,660 --> 00:05:33,440
.ممتاز يا هيلي

92
00:05:33,440 --> 00:05:33,980
.شكرًا لك

93
00:05:33,980 --> 00:05:35,140
!أحسنت

94
00:05:36,820 --> 00:05:38,060
...هيلي

95
00:05:53,080 --> 00:05:56,900
ينتهي النّصف الأوّل بصدارة
!ديسيليس بهدف واحد

96
00:05:57,750 --> 00:06:00,640
.كان ذلك أعنف ممّا توقّعت

97
00:06:00,640 --> 00:06:02,750
.آمل ألاّ يكون قد تأذّى أيّ أحد منهم

98
00:06:02,750 --> 00:06:03,970
!سوها

99
00:06:03,970 --> 00:06:06,590
هل رأيتني أسجّل هدفًا قبل قليل؟

100
00:06:06,590 --> 00:06:08,840
!نعم! كنت رائعًا

101
00:06:08,840 --> 00:06:09,990
فعلاً؟

102
00:06:09,990 --> 00:06:12,510
.وأنا سجّلتُ هدفنا الثّاني

103
00:06:12,510 --> 00:06:13,600
!سوها

104
00:06:13,830 --> 00:06:16,340
!يجلس فريقنا هناك

105
00:06:16,340 --> 00:06:17,560
...ذ-ذلك

106
00:06:17,560 --> 00:06:18,850
!سوها

107
00:06:18,850 --> 00:06:22,940
نحن متأخّرون الآن، لكن أقسم
!أنّنا سنفوز، لذا شجّعيني

108
00:06:22,940 --> 00:06:26,660
.ماذا؟ سوها تشجّعنا نحن

109
00:06:26,660 --> 00:06:29,310
!سوها، يجلس فريقنا في ذلك الجانب

110
00:06:29,310 --> 00:06:29,920
!تمهّل

111
00:06:29,920 --> 00:06:31,700
.سوها معنا نحن

112
00:06:32,190 --> 00:06:34,120
سوها، هل تستمتعين بوقتك؟

113
00:06:34,120 --> 00:06:35,260
!هيلي؟

114
00:06:38,100 --> 00:06:39,740
.شجّعينا نحن

115
00:06:40,930 --> 00:06:41,700
.إلى اللّقاء

116
00:06:41,700 --> 00:06:43,250
هذا كلّ شيء؟

117
00:06:46,890 --> 00:06:47,950
...هيلي

118
00:06:49,670 --> 00:06:50,510
.سوها

119
00:06:52,670 --> 00:06:53,890
هل لديك وقت؟

120
00:07:06,360 --> 00:07:07,510
...مستحيل

121
00:07:08,470 --> 00:07:11,660
.لهذا السّبب كنتُ أبحث عنك

122
00:07:20,540 --> 00:07:21,790
!كلاّ

123
00:07:24,420 --> 00:07:27,130
.ماذا؟ كانت تلك سوها

124
00:07:28,420 --> 00:07:29,550
.إنّها ليست هناك

125
00:07:33,170 --> 00:07:35,260
.ليست هناك. ليست هناك

126
00:07:35,950 --> 00:07:36,830
!سوها

127
00:07:44,820 --> 00:07:46,360
!هيلي

128
00:07:46,600 --> 00:07:48,120
!هل أنت بخير؟

129
00:07:48,790 --> 00:07:50,750
...سـ-سوها قد

130
00:07:50,750 --> 00:07:53,490
!لن أسمح لهم بالفوز اليوم

131
00:07:54,170 --> 00:07:56,030
!أنا من سيفوز

132
00:07:57,940 --> 00:08:00,160
!هدف

133
00:08:00,160 --> 00:08:02,730
تسجّل مدرسة مدينة سانشاين
!الهدف الّذي كانت بحاجته بشدّة

134
00:08:00,490 --> 00:08:01,770
!أجل

135
00:08:02,110 --> 00:08:04,290
!كان ذلك رائعًا يا كان

136
00:08:02,730 --> 00:08:07,290
!تحصل مدرسة مدينة سانشاين على انتقامها

137
00:08:04,290 --> 00:08:05,640
.سُحقًا

138
00:08:06,140 --> 00:08:07,290
.كدنا ننال منهم

139
00:08:07,290 --> 00:08:17,900
!سانشاين! سانشاين! سانشاين

140
00:08:11,650 --> 00:08:13,970
هيلي، هل من خطب ما؟

141
00:08:13,970 --> 00:08:16,150
.حدث شيء ما

142
00:08:17,900 --> 00:08:21,060
!سوها

143
00:08:27,730 --> 00:08:29,570
لماذا كنتِ مع سوها؟

144
00:08:29,990 --> 00:08:31,530
من أخذها؟

145
00:08:33,460 --> 00:08:36,260
.مصّاص الدّماء الأوّل داردان

146
00:08:37,220 --> 00:08:40,010
مصّاص الدّماء الأوّل داردان؟
من يكون؟

147
00:08:40,740 --> 00:08:41,950
...أيُعقل

148
00:08:41,950 --> 00:08:46,610
لا تعرفون أيّ شيء بالفعل، صحيح؟

149
00:08:49,190 --> 00:08:52,920
كان داردان مستشارًا
.في مملكة فارغر القديمة

150
00:08:53,630 --> 00:08:57,650
،مع أنّه كان بشريًّا في الأصل
،فخلال سعيه للقوّة

151
00:08:57,650 --> 00:09:01,410
حوّل نفسه إلى مصّاص دماء
.باستعمال طرق محرّمة

152
00:09:03,240 --> 00:09:04,360
.لا بدّ أنّه هو

153
00:09:04,690 --> 00:09:05,850
هل قابلتموه؟

154
00:09:05,850 --> 00:09:10,870
.نعم. هاجَمنا مع قطيع من مصّاصي الدّماء

155
00:09:10,870 --> 00:09:12,610
من مصّاصو الدّماء الّذين كانوا معه؟

156
00:09:13,210 --> 00:09:18,500
.إنّهم مصّاصو دماء أدنى صنعهم داردان

157
00:09:18,930 --> 00:09:22,760
ضعفاء أمام أشعة الشّمس
،ولا يفكّرون بمنطق أبدًا

158
00:09:22,760 --> 00:09:25,120
.وهم عاجزون عن كبح ظمئهم للدّماء

159
00:09:26,920 --> 00:09:28,290
أنتم تفهمون، صحيح؟

160
00:09:28,290 --> 00:09:32,210
.إنّكم مختلفون عن مصّاصي الدّماء أولئك

161
00:09:33,160 --> 00:09:37,350
أنتم أسياد مصّاصي دماء
.لمملكة فارغر القديمة

162
00:09:38,070 --> 00:09:40,310
أسياد مصّاصي دماء؟

163
00:09:40,720 --> 00:09:46,390
.نعم. كنتم أيضًا فرسانًا خدموا الأميرة

164
00:09:46,390 --> 00:09:49,900
—لقد سجنتنا! لن نصدّق أيّ كلمة

165
00:09:49,140 --> 00:09:51,210
.لم أسجنكم

166
00:09:51,640 --> 00:09:55,990
.أبقيتكم في فانفيلد لحمايتكم من داردان

167
00:09:56,660 --> 00:10:01,670
قبل ألف سنة، عندما هدّد
،تمرّد داردان المملكة

168
00:10:01,670 --> 00:10:06,690
أرسلت الأميرة أرواحكم
.إلى المستقبل البعيد لحمايتكم

169
00:10:07,450 --> 00:10:13,670
.ولكن، فقدتم ذكرياتكم وعدتم أطفالاً

170
00:10:14,210 --> 00:10:21,010
تعقّبت كلّ واحد منكم وحميتكم
.في منزل فانفيلد

171
00:10:22,580 --> 00:10:26,310
.أميرة؟ مهلاً لحظة

172
00:10:26,310 --> 00:10:28,020
...تلك الأميرة

173
00:10:28,020 --> 00:10:29,270
...أهي

174
00:10:30,970 --> 00:10:33,410
أهي سوها؟

175
00:10:33,770 --> 00:10:39,550
.نعم. تعقّبتُ طاقة الأميرة إلى هنا

176
00:10:39,930 --> 00:10:43,030
...لا بدّ أنّكم شعرتم كذلك

177
00:10:43,400 --> 00:10:46,170
.بما هي أقدراكم

178
00:10:55,060 --> 00:10:58,600
ولكن لماذا اختطف داردان سوها؟

179
00:10:59,310 --> 00:11:01,010
.لنفس السّبب كما في الماضي

180
00:11:01,510 --> 00:11:05,140
.يحاول داردان الحصول على قوّتها

181
00:11:05,140 --> 00:11:08,470
.سيكون كلّ شيء لي الآن

182
00:11:09,070 --> 00:11:11,190
...الأميرة... داردان

183
00:11:11,510 --> 00:11:12,660
.فهمت

184
00:11:41,990 --> 00:11:44,550
.أرى أنّك هنا أيّتها الأميرة

185
00:11:45,880 --> 00:11:46,760
.سيّد هيلي

186
00:11:47,490 --> 00:11:49,320
.إنّ الملكة تستدعيك

187
00:11:49,830 --> 00:11:51,850
.لا بدّ أنّه لذلك... السّبب

188
00:11:53,110 --> 00:11:57,290
.قدّم أمير المملكة المجاورة عرضَ زواج

189
00:11:57,690 --> 00:12:02,340
.نعم، سمعتُ بذلك. يقولون أنّه رجل عظيم

190
00:12:02,670 --> 00:12:05,740
.لكنّي لا أريد الزّواج بعد

191
00:12:06,680 --> 00:12:11,150
ولا يمكنني أن أعهد بحياتي
.لشخص بالكاد أعرفه

192
00:12:11,830 --> 00:12:15,900
.لكن لا يُسمح لي باختيار من أحبّ

193
00:12:16,870 --> 00:12:22,130
واثق أنّك ستلتقين شخصًا
.ستحبّينه من أعماق قلبك

194
00:12:22,950 --> 00:12:27,680
...ربّما عليّ إخبار أمّي كيف أنّي

195
00:12:27,680 --> 00:12:28,760
!أيّتها الأميرة

196
00:12:31,150 --> 00:12:32,210
ما الخطب؟

197
00:12:33,230 --> 00:12:35,980
.شكرًا لك يا سيّد هيلي

198
00:12:36,380 --> 00:12:40,980
.إنّك تنقذني دائمًا

199
00:12:43,310 --> 00:12:46,580
.حمايتك هي واجبي أيّتها الأميرة

200
00:12:59,570 --> 00:13:03,190
.تبدين رائعة اليوم أيّتها الأميرة سيلين

201
00:13:03,800 --> 00:13:06,760
هل ستقبلين عرض زواج الأمير؟

202
00:13:06,760 --> 00:13:11,210
،أيّها المستشار داردان
.إنّني أرفض عرضه بكلّ احترام

203
00:13:11,210 --> 00:13:13,660
.هذه أخبار جيّدة

204
00:13:14,510 --> 00:13:17,190
.لم أظنّ أنّك ستقومين بما كنت أريده

205
00:13:17,660 --> 00:13:19,230
!لا علاقة للأمر بك

206
00:13:19,530 --> 00:13:22,730
.أنا أوافقك أيّتها الأميرة سيلين

207
00:13:22,730 --> 00:13:25,110
.أنا أعارض الزّيجات السّياسيّة

208
00:13:26,700 --> 00:13:28,450
!أكنت تتنصّت عليّ؟

209
00:13:28,450 --> 00:13:32,450
.أنا أسمع صوتك بشكل طبيعيّ فحسب

210
00:13:32,450 --> 00:13:33,920
لماذا؟

211
00:13:34,270 --> 00:13:36,000
.لأنّني أستمع له دائمًا

212
00:13:36,000 --> 00:13:37,290
!يا للفظاظة

213
00:13:38,670 --> 00:13:40,180
فظاظة؟

214
00:13:41,150 --> 00:13:43,670
لأنّي لستُ من العائلة الملكيّة؟

215
00:13:44,530 --> 00:13:47,090
!إذًا فإنّ المكانة مهمّة بالنّسبة لك

216
00:13:47,090 --> 00:13:48,220
!اتركني

217
00:13:49,930 --> 00:13:53,470
—كيف أحصل على قلبك

218
00:13:54,460 --> 00:13:55,430
!داردان

219
00:13:55,720 --> 00:14:00,060
في المرّة القادمة الّتي تقلّل فيها من
!احترام الأميرة هكذا، ستدفع ثمنًا غاليًا

220
00:14:06,290 --> 00:14:08,610
.لا أصدّق ما فعله

221
00:14:10,900 --> 00:14:11,810
!أيّتها الأميرة

222
00:14:14,930 --> 00:14:18,060
!سيلين! سيلين، تماسكي رجاءً

223
00:14:20,770 --> 00:14:22,340
.الأمر كما كنّا نخشى

224
00:14:22,850 --> 00:14:23,980
ما هذا؟

225
00:14:23,980 --> 00:14:27,690
أعتقد أنّ ذلك بسبب القوى
.الشّامانيّة للسّلالة الملكيّة

226
00:14:28,980 --> 00:14:33,400
تملك الأميرة سيلين أعظم
.قوى شهدتها المملكة

227
00:14:33,400 --> 00:14:36,540
.ما عاد جسدها قادرًا على التّحمّل أكثر

228
00:14:37,530 --> 00:14:39,580
.ستموت على هذا الحال

229
00:14:40,730 --> 00:14:43,400
.هنالك طريقة واحدة لإبقائها حيّة

230
00:14:44,110 --> 00:14:47,900
،سنستعمل كنز المملكة
...دماء إله الذّئاب القديم

231
00:14:48,550 --> 00:14:50,850
.دماء فارغر

232
00:14:59,450 --> 00:15:00,440
!سيلين

233
00:15:02,990 --> 00:15:06,270
...ما هذا؟ أشعر بدفء كبير

234
00:15:06,620 --> 00:15:11,970
أيّتها الأميرة، أنت الأميرة سيلين
.الّتي تحمل دماء الشّامان

235
00:15:12,590 --> 00:15:16,790
.وسأمنحك أنا إله الذّئاب فارغر القوّة

236
00:15:17,480 --> 00:15:19,850
أنت فارغر؟

237
00:15:26,480 --> 00:15:29,400
!سيلين، لقد استيقظتِ

238
00:15:30,070 --> 00:15:32,670
.حمدًا على هذا. أنت بخير الآن

239
00:15:32,670 --> 00:15:37,350
.أمّي، قابلتُ الإله فارغر

240
00:15:38,060 --> 00:15:41,920
.أيّها الإله فارغر، شكرًا لك

241
00:15:50,120 --> 00:15:52,590
!أمّي! أمّي

242
00:15:53,590 --> 00:15:57,580
.سيلين، لا تحزني

243
00:15:58,060 --> 00:16:03,060
.تعلمين أنّها الطّريقة الوحيدة

244
00:16:03,060 --> 00:16:04,330
...أمّي

245
00:16:05,150 --> 00:16:10,570
بعد أن صار داردان مصّاص الدّماء الأوّل
.الآن، فهو يحاول الاستيلاء على المملكة

246
00:16:11,380 --> 00:16:17,130
،ساعدَنا المستذئبون
.لكنّ أعدادهم كانت كبيرة جدًّا

247
00:16:18,790 --> 00:16:24,260
...لذلك أعطيتهم دماءك

248
00:16:34,760 --> 00:16:38,260
.وصنعتِ أسياد مصّاصي دماء جدد

249
00:16:39,830 --> 00:16:43,020
...اعملوا معًا رجاءً

250
00:16:45,060 --> 00:16:49,660
.لحماية هذه البلاد من داردان

251
00:16:53,400 --> 00:16:55,710
...لكنّي لستُ

252
00:16:55,710 --> 00:16:58,780
،عن طريق شرب دماء فارغر

253
00:16:59,400 --> 00:17:05,300
حصلتِ على قوّة إله الذّئاب القديم
.وصرتِ ملكة مصّاصي الدّماء

254
00:17:05,950 --> 00:17:11,230
.سيلين، خذي قواي الشّامانيّة

255
00:17:12,190 --> 00:17:17,920
.خُتمت قوّتي في مذبح القمر سلفًا

256
00:17:17,920 --> 00:17:19,220
...أمّي

257
00:17:19,450 --> 00:17:26,690
سيلين، إن متُّ، عليك إقامة
،مراسم التّتويج في مذبح القمر

258
00:17:26,690 --> 00:17:30,480
،واكسري الختم واحصلي على قوّة الملكة

259
00:17:31,310 --> 00:17:34,600
.وصيري الملكة الأقوى على الإطلاق

260
00:17:36,260 --> 00:17:38,610
.لا داعي للقلق يا صاحبة الجلالة

261
00:17:39,010 --> 00:17:44,000
سأحصل على تلك القوّة
.وأحكم المملكة كما يجب

262
00:17:44,930 --> 00:17:45,710
!داردان

263
00:17:45,710 --> 00:17:50,620
،أيّتها الأميرة سيلين
.لم أرغب في القيام بهذا

264
00:17:50,620 --> 00:17:55,550
أردتُ حبّك بكلّ بساطة، لكنّك
.كنت ترفضين حتّى النّظر إليّ

265
00:17:55,870 --> 00:17:56,970
!تراجع

266
00:18:00,220 --> 00:18:01,390
!مارج

267
00:18:02,470 --> 00:18:07,600
إذًا لا يمكنني الحصول عليك
.إلاّ بأخذك وسحقك

268
00:18:13,700 --> 00:18:15,030
!احموا الأميرة

269
00:18:25,160 --> 00:18:26,580
!هيلي، خذ الأميرة

270
00:18:27,060 --> 00:18:28,460
هل أنت بخير أيّتها الأميرة؟

271
00:18:28,960 --> 00:18:30,830
!أيّها الوغد داردان

272
00:18:30,830 --> 00:18:32,200
!ابتعد عن طريقي

273
00:18:35,000 --> 00:18:36,460
!سيّد هيلي

274
00:18:36,460 --> 00:18:41,090
لا بدّ أنّك تفهم بما
.أنّك تحبّ الأميرة أيضًا

275
00:18:41,090 --> 00:18:45,100
.أنت وحدك من يمكنه الاعتراف أنّي على حقّ

276
00:18:48,970 --> 00:18:50,600
...وغد

277
00:18:58,950 --> 00:19:02,230
.سيكون كلّ شيء لي

278
00:19:02,870 --> 00:19:05,120
!أيّتها الأميرة! لنذهب إلى مذبح القمر

279
00:19:05,120 --> 00:19:06,490
!عليك أن تسرعي

280
00:19:07,670 --> 00:19:09,550
!أيّتها الأميرة! أيّتها الأميرة

281
00:19:24,630 --> 00:19:26,110
...مارج، إنّ ظهرك

282
00:19:26,110 --> 00:19:29,000
...بسرعة... يجب تتويجك

283
00:19:29,750 --> 00:19:31,190
!لا يمكنني ذلك

284
00:19:31,190 --> 00:19:35,740
!لا يمكنني التّضحية بالجميع لأصير ملكة

285
00:19:38,650 --> 00:19:41,330
.مارج، لديّ طلب منك

286
00:19:42,140 --> 00:19:44,520
سأعود إلى القصر

287
00:19:44,520 --> 00:19:47,930
وسأرسل أرواح الفرسان
.إلى المستقبل البعيد

288
00:19:48,410 --> 00:19:54,810
.عندما يحين الوقت، جديهم واحميهم رجاءً

289
00:19:54,810 --> 00:19:55,920
...أيّتها الأميرة

290
00:20:04,650 --> 00:20:06,180
!ستدفع ثمن هذا

291
00:20:06,180 --> 00:20:10,350
.بالنّسبة لك، لا حدود لقسوتي

292
00:20:14,230 --> 00:20:16,690
!مت فحسب

293
00:20:24,510 --> 00:20:25,450
!أيّتها الأميرة

294
00:20:28,730 --> 00:20:37,580
سيّد هيلي، أنقذتني من الخطر
...عدّة مرّات من قبل

295
00:20:38,380 --> 00:20:41,880
.بلا أيّ خوف أو تردّد

296
00:20:42,390 --> 00:20:48,570
...أعرف أنّك كنت تخفي شيئًا ما

297
00:20:49,340 --> 00:20:54,390
.لأنّي كنتُ أخفي نفس الشّيء

298
00:20:55,670 --> 00:20:58,880
...لذلك... في المرّة القادمة

299
00:20:58,880 --> 00:21:02,570
.لنكن على حقيقتنا

300
00:21:25,370 --> 00:21:31,290
حاول داردان أخذ قوى سوها
.الشّامانيّة وقوّة فارغر

301
00:21:32,290 --> 00:21:33,430
.نعم

302
00:21:35,100 --> 00:21:38,060
...فهمت. تلك الأسطورة

303
00:21:38,660 --> 00:21:40,390
.كانت عنّا

304
00:23:34,030 --> 00:23:36,220
:في الحلقة التّاسعة القادمة

305
00:23:36,220 --> 00:23:39,890
."القمر الضّبابيّ: ضباب ريلغان الأسود"