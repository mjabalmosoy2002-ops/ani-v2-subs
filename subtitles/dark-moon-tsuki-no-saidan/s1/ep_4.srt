1
00:00:00,520 --> 00:00:01,470
.سوها

2
00:00:02,770 --> 00:00:04,330
سوها، أيمكنك سماعي؟

3
00:00:06,060 --> 00:00:06,930
.سوها

4
00:00:09,730 --> 00:00:12,090
هل أنت بخير يا سوها؟ هل تأذّيت؟

5
00:00:12,090 --> 00:00:13,110
هيلي؟

6
00:00:13,470 --> 00:00:14,380
أين أنت؟

7
00:00:14,380 --> 00:00:15,490
.سآتي إليك

8
00:00:15,490 --> 00:00:18,240
.عفوًا، أنا مشغولة الآن

9
00:00:18,240 --> 00:00:19,870
ماذا؟ سوها؟

10
00:00:20,100 --> 00:00:21,290
!كان

11
00:00:21,290 --> 00:00:22,610
.من الرّائع رؤيتك ثانية

12
00:00:23,370 --> 00:00:24,690
...أنا... عفوًا

13
00:00:25,670 --> 00:00:26,830
.لقد ذهب

14
00:00:28,310 --> 00:00:30,000
!لقد اختفى

15
00:02:05,020 --> 00:02:07,800
هل أنت وحدك أم برفقة أحد ما؟

16
00:02:07,800 --> 00:02:08,770
...ماذا؟ عفوًا

17
00:02:09,150 --> 00:02:11,710
.إنّها هنا معي
ألديك مشكلة في ذلك؟

18
00:02:11,710 --> 00:02:12,480
.جاكا

19
00:02:12,920 --> 00:02:14,190
أنتما الاثنان فقط؟

20
00:02:14,190 --> 00:02:16,040
—لا، جاء البقيّة معـ

21
00:02:16,040 --> 00:02:17,740
.ذلك ليس من شأنك

22
00:02:18,680 --> 00:02:20,430
!كان

23
00:02:20,430 --> 00:02:22,320
!لنتسابق بالقوارب

24
00:02:22,320 --> 00:02:24,160
!ماذا؟ إنّها سوها

25
00:02:24,160 --> 00:02:25,180
...من الرّائع رؤيـ

26
00:02:26,160 --> 00:02:27,770
!سوها! جاكا

27
00:02:27,770 --> 00:02:28,860
!شيون

28
00:02:28,860 --> 00:02:29,960
...هل أنتما

29
00:02:29,960 --> 00:02:30,900
ماذا؟

30
00:02:31,860 --> 00:02:32,730
.سوها

31
00:02:32,730 --> 00:02:33,720
.هيلي

32
00:02:33,720 --> 00:02:35,100
هل تأذّيت؟

33
00:02:35,100 --> 00:02:36,710
.لا، أنا بخير

34
00:02:37,080 --> 00:02:38,720
.أنقذني البقيّة

35
00:02:47,060 --> 00:02:48,870
تأذّت؟ هل حدث شيء ما؟

36
00:02:49,390 --> 00:02:52,690
ظهر بعض مصّاصي الدّماء
.من العدم قبل قليل

37
00:02:52,690 --> 00:02:53,810
!ماذا؟

38
00:02:53,810 --> 00:02:56,580
في هذا الوقت؟ وفي السّاحة؟

39
00:02:56,580 --> 00:02:58,360
أين هم الآن؟

40
00:02:58,360 --> 00:03:00,550
.تولّينا أمرهم

41
00:03:00,550 --> 00:03:02,870
.ليس عليكم القلق حيال ذلك

42
00:03:02,870 --> 00:03:04,060
.هذا غير معقول

43
00:03:04,060 --> 00:03:08,230
.ما كنّا لنعرّض سوها للخطر من الأساس

44
00:03:08,230 --> 00:03:09,520
!ماذا قلت؟

45
00:03:09,520 --> 00:03:10,540
.إيان

46
00:03:10,540 --> 00:03:14,100
.سوها، لا تتقرّبي كثيرًا من هؤلاء

47
00:03:14,100 --> 00:03:15,810
.من أجل مصلحتك

48
00:03:15,810 --> 00:03:16,460
ماذا؟

49
00:03:16,460 --> 00:03:20,220
هذا صحيح. عليك قضاء الوقت
.معنا في نهاية الأسبوع القادمة

50
00:03:20,990 --> 00:03:24,130
سبق ووافقت سوها أن تقضي الوقت
.معنا في نهاية الأسبوع القادمة

51
00:03:24,130 --> 00:03:25,600
ماذا؟ أفعلتُ ذلك؟

52
00:03:25,600 --> 00:03:29,470
فهمت. لنلتق في نهاية
!الأسبوع الّذي يلي ذلك

53
00:03:29,470 --> 00:03:29,930
ماذا؟

54
00:03:29,930 --> 00:03:34,180
لدينا خطط في نهاية الأسبوع
.تلك وكلّ نهاية أسبوع أخرى

55
00:03:34,180 --> 00:03:38,100
!وحتّى أبد الآبدين

56
00:03:38,100 --> 00:03:40,570
!أيّها الوغد، كفّ عن العبث معي

57
00:03:40,820 --> 00:03:42,350
!ماذا قلت أيّها الغبيّ؟

58
00:03:42,350 --> 00:03:45,370
!اخرس! لا يتعرّف على الأغبياء إلاّ الغبيّ

59
00:03:49,310 --> 00:03:53,690
ولكن يا سوها، سنقيم حفلة عيد
.ميلاد بعد ثلاثة أسابيع بالفعل

60
00:03:53,690 --> 00:03:54,830
ستحضرينها، صحيح؟

61
00:03:54,830 --> 00:03:58,100
،ماذا؟ إن كان عيد ميلاد أحد
.فبالطّبع سأحضره

62
00:03:58,100 --> 00:04:00,090
!مهلاً! لا تكذب عليها

63
00:04:00,090 --> 00:04:01,560
.إنّها الحقيقة

64
00:04:01,560 --> 00:04:04,130
إن لم تصدّقوني، فلماذا لا تأتون أيضًا؟

65
00:04:04,130 --> 00:04:05,350
!مستحيل أن آتي

66
00:04:05,350 --> 00:04:07,430
!لن أحتفل بذلك

67
00:04:07,430 --> 00:04:10,810
.أنا أمزح. ما كنت لأدعوكم من الأساس

68
00:04:10,810 --> 00:04:14,650
.أعتقد أنّه سيكون من اللّطيف أن نحتفل معًا

69
00:04:14,650 --> 00:04:16,680
.سأذهب بكلّ سرور إن كان ذلك رأي سوها

70
00:04:16,680 --> 00:04:19,530
.وأنا أيضًا. أرسل لي دعوة

71
00:04:19,530 --> 00:04:20,930
.أودّ الذّهاب أيضًا

72
00:04:20,930 --> 00:04:21,690
!ماذا؟

73
00:04:21,690 --> 00:04:23,580
!قلتُ أنّي كنتُ أمزح

74
00:04:23,580 --> 00:04:25,790
.مستحيل أن أقوم بدعوتكم

75
00:04:25,790 --> 00:04:26,660
!ماذا قلت؟

76
00:04:26,660 --> 00:04:30,270
إنّنا نعرض عليك أن نحضر
!حفلتك الصّغيرة المملّة

77
00:04:30,270 --> 00:04:31,620
.هذا يكفي

78
00:04:31,620 --> 00:04:34,290
.أنتم لستم مدعوّين أيّها الفاشلون

79
00:04:34,290 --> 00:04:36,040
.يكفي يا رفاق

80
00:04:38,810 --> 00:04:42,210
قالت سوها أنّ مصّاصي دماء
هاجموها، صحيح؟

81
00:04:42,580 --> 00:04:46,140
.عرّضوا حياة سوها للخطر

82
00:04:46,140 --> 00:04:47,180
.نعم

83
00:04:47,700 --> 00:04:50,610
.تبدوان قلقين جدًّا على سوها

84
00:04:50,610 --> 00:04:54,180
.ماذا؟ صحيح. أتساءل لماذا

85
00:04:54,680 --> 00:04:58,300
.أشعر بقوّة غريبة منها

86
00:04:58,930 --> 00:05:00,940
.ولأصدقكم القول، أنا أيضًا

87
00:05:00,970 --> 00:05:01,690
!لا

88
00:05:03,540 --> 00:05:06,820
.سمّرتني كلمات سوها في مكاني وقتها

89
00:05:07,080 --> 00:05:09,820
.ثمّة شيء مريب بشأنها

90
00:05:09,820 --> 00:05:13,450
ربّما للأمر علاقة بهجوم مصّاصي
.الدّماء الّذي وقع اليوم

91
00:05:13,450 --> 00:05:16,170
.نعم، وذلك ليس كلّ شيء

92
00:05:16,170 --> 00:05:22,800
ربّما كانوا يحمون سوها، لكنّني مندهش
.من أنّهم قاتلوا بني جنسهم

93
00:05:29,090 --> 00:05:31,600
...ذلك الشّخص الّذي رأيت في السّاحة اليوم

94
00:05:32,020 --> 00:05:36,280
،إن عاش كريس وصار راشدًا
.كان ليبدو مثله بالتّأكيد

95
00:05:40,510 --> 00:05:44,900
.لكنّي ظننتُ أنّ كريس قد مات

96
00:05:47,290 --> 00:05:48,130
.سوها

97
00:05:48,530 --> 00:05:52,190
.ناداني باسمي بكلّ تأكيد وقتها

98
00:05:52,610 --> 00:05:55,310
هل كريس لا يزال حيًّا بالفعل؟

99
00:05:55,630 --> 00:05:58,060
لكن كيف؟

100
00:05:58,060 --> 00:06:02,060
ولماذا لم يأتِ لرؤيتي باكرًا؟

101
00:06:02,060 --> 00:06:04,710
.لا أصدّق أنّه اختفى بعد ذلك مباشرة أيضًا

102
00:06:05,400 --> 00:06:08,690
!لا، لا شيء من هذا مهمّ

103
00:06:08,690 --> 00:06:10,970
!كلّ ما يهمّني أنّك لا تزال حيًّا الآن

104
00:06:32,260 --> 00:06:33,330
!كريس

105
00:06:37,580 --> 00:06:38,790
!كريس

106
00:06:39,240 --> 00:06:41,960
!كريس! كريس

107
00:06:41,960 --> 00:06:44,880
.سوها، اشتقتُ لك

108
00:06:45,170 --> 00:06:46,340
أنت حيّ؟

109
00:06:46,340 --> 00:06:48,090
.نعم، ذلك صحيح

110
00:06:48,430 --> 00:06:50,940
هل أنت كريس بالفعل؟

111
00:06:50,940 --> 00:06:53,890
.نعم، هذا أنا. كم أشعر بالحنين

112
00:06:54,140 --> 00:06:57,310
.على أيّ حال، لم تتغيّري إطلاقًا

113
00:06:58,890 --> 00:06:59,970
...كريس

114
00:07:02,060 --> 00:07:04,310
!أنت كريس بالفعل

115
00:07:07,220 --> 00:07:09,810
.سررت برؤيتك ثانية يا سوها

116
00:07:13,730 --> 00:07:14,850
...كريس

117
00:07:15,350 --> 00:07:17,260
ولكن لماذا؟

118
00:07:25,610 --> 00:07:26,810
حلم؟

119
00:07:27,880 --> 00:07:30,010
.لا بدّ أنّه كان حلمًا

120
00:07:33,950 --> 00:07:35,080
.فهمت

121
00:07:36,510 --> 00:07:38,600
.مستحيل أن يكون كريس هناك

122
00:07:39,020 --> 00:07:41,630
.كان كلّ هذا حلمًا

123
00:07:53,390 --> 00:07:56,780
.توقّعتُ هذا. إنّه ليس هنا

124
00:07:59,540 --> 00:08:04,290
لماذا المكان مظلم هكذا مع
أنّ القمر بدر اللّيلة؟

125
00:08:26,070 --> 00:08:29,980
.أنا الوحيد الّذي لم يتحوّل ثانية

126
00:08:30,840 --> 00:08:34,550
لماذا أنا الوحيد العاجز عن ذلك؟

127
00:08:41,690 --> 00:08:47,130
يتحوّل الجميع إلى ذئب بشكل طبيعيّ
،عند التّعرّض لضوء القمر البدر

128
00:08:47,800 --> 00:08:49,930
فلماذا أعجز أنا؟

129
00:08:51,170 --> 00:08:54,570
هل فيّ عيب ما؟

130
00:09:10,790 --> 00:09:11,700
سوها؟

131
00:09:12,780 --> 00:09:13,690
كان؟

132
00:09:36,580 --> 00:09:37,460
.كان

133
00:09:44,470 --> 00:09:46,760
ما الّذي تفعلينه هنا في مثل هذا الوقت؟

134
00:09:47,180 --> 00:09:48,240
وترتدي منامة أيضًا؟

135
00:09:48,240 --> 00:09:50,230
مهلاً، ماذا؟

136
00:09:50,600 --> 00:09:53,550
.إنّه يبدو مختلفًا عن المعتاد

137
00:09:55,030 --> 00:09:57,010
،كـ-كنتُ في عجلة من أمري
!ونسيت تغيير ملابسي

138
00:09:57,010 --> 00:09:58,690
.لا-لا داعي للقلق

139
00:09:58,690 --> 00:10:00,700
.يحدث هذا عندما يكون المرء مستعجلاً

140
00:10:01,130 --> 00:10:02,690
.بل ويحدث معي طوال الوقت

141
00:10:02,690 --> 00:10:04,570
ماذا؟ طوال الوقت؟

142
00:10:06,310 --> 00:10:09,030
عـ-على أيّ حال، ما الّذي تفعلينه هنا؟

143
00:10:09,030 --> 00:10:09,790
ماذا؟

144
00:10:09,790 --> 00:10:13,960
.أ-أنا... أردتُ رؤية البحر في اللّيل فحسب

145
00:10:13,960 --> 00:10:15,210
وحدك؟

146
00:10:15,210 --> 00:10:18,910
.نعم. ظننتُ أنّ القمر بدر اللّيلة

147
00:10:21,140 --> 00:10:22,590
.إنّه خسوف كامل

148
00:10:22,970 --> 00:10:30,020
،عندما تصطفّ الشّمس والأرض والقمر
.يُغطّي ظلّ الأرضِ القمر

149
00:10:30,650 --> 00:10:32,420
.إنّه يوم مميّز بالفعل

150
00:10:32,860 --> 00:10:38,300
،نعم. كنتُ أعرف بأمره
.لكنّ هذه أوّل مرّة أراه بنفسي

151
00:10:39,450 --> 00:10:41,100
...بالمناسبة

152
00:10:41,720 --> 00:10:44,340
ما الّذي تفعله هنا في مثل هذا الوقت؟

153
00:10:44,340 --> 00:10:47,690
.أتيت... لرؤية الخسوف الكامل

154
00:10:47,690 --> 00:10:49,040
.هكذا إذًا

155
00:10:49,040 --> 00:10:51,540
وحدك؟ أين البقيّة؟

156
00:10:52,210 --> 00:10:54,520
...أنا هنا وحدي، أمّا البقيّة

157
00:10:57,300 --> 00:10:58,350
.فنائمون

158
00:10:59,740 --> 00:11:03,980
اسمعي يا سوها. أتريدين أن أوصلك؟

159
00:11:03,980 --> 00:11:04,640
ماذا؟

160
00:11:04,640 --> 00:11:08,480
ظهر بعض مصّاصي الدّماء
.اليوم، صحيح؟ أنا قلق عليك

161
00:11:08,480 --> 00:11:10,730
.أأنت واثق؟ شكرًا لك

162
00:11:11,140 --> 00:11:13,480
.في الحقيقة، كنتُ خائفة قليلاً

163
00:11:13,930 --> 00:11:17,040
.من مصّاصي الدّماء والكلاب الضّالّة أيضًا

164
00:11:17,040 --> 00:11:18,020
الكلاب الضّالّة؟

165
00:11:18,020 --> 00:11:21,770
نعم. ألم تسمعها تعوي قبل قليل؟

166
00:11:21,770 --> 00:11:23,560
فـ-فعلاً؟

167
00:11:23,560 --> 00:11:25,720
.آمل ألاّ تهاجم أيّ أحد

168
00:11:25,720 --> 00:11:28,470
.لا يفعلون ذلك! وخصوصًا الذّئاب

169
00:11:28,470 --> 00:11:28,940
ماذا؟

170
00:11:28,940 --> 00:11:30,370
...أ-أعني

171
00:11:30,710 --> 00:11:34,360
.إنّهم... حيوانات لطيفة بشكل مفاجئ

172
00:11:34,820 --> 00:11:38,060
.هذا صحيح. كما أنّ الذّئاب رائعة

173
00:11:38,060 --> 00:11:40,480
ماذا؟ أتظنّين ذلك؟

174
00:11:40,480 --> 00:11:42,410
تحبّين الذّئاب أيضًا؟

175
00:11:42,410 --> 00:11:45,180
!نعم! أحبّ مشاهدتها على التّلفاز على الأقلّ

176
00:11:45,630 --> 00:11:49,020
.لكنّي سأكون خائفة إن قابلت إحداها

177
00:11:49,390 --> 00:11:50,460
.فهمت

178
00:11:51,020 --> 00:11:53,790
.فـ-في تلك الحالة، سأرافقك

179
00:11:53,790 --> 00:11:55,620
.حسنًا، شكرًا لك

180
00:12:16,030 --> 00:12:18,670
جينو، هل لديك أيّ خطط اليوم؟

181
00:12:19,410 --> 00:12:20,550
.على الإطلاق

182
00:12:21,900 --> 00:12:23,030
كيف تشعر؟

183
00:12:24,120 --> 00:12:25,150
كالمعتاد؟

184
00:12:29,810 --> 00:12:31,590
...تحديق

185
00:12:31,590 --> 00:12:35,330
تريدني أن أتدرّب على الرّمي
.معك، صحيح؟ أعرف هذا

186
00:12:38,090 --> 00:12:40,810
.لا تتوقّف عن رمي الكرة أبدًا

187
00:12:40,810 --> 00:12:41,670
.مرحبًا

188
00:12:42,240 --> 00:12:44,650
ماذا؟ أهو ليس معكما؟

189
00:12:45,530 --> 00:12:47,480
...قال شيون

190
00:12:48,570 --> 00:12:49,590
.شيون

191
00:12:50,940 --> 00:12:52,580
.أنا متعب

192
00:12:52,580 --> 00:12:53,620
ما الأمر؟

193
00:12:53,940 --> 00:12:56,080
.لم أستطع رؤية سوها

194
00:12:56,080 --> 00:12:58,390
.صحيح. حفلة عيد الميلاد

195
00:12:58,390 --> 00:13:01,750
.لا داعي للعجلة
ستراها في نهاية المطاف، صحيح؟

196
00:13:01,750 --> 00:13:04,490
.لم أستطع الانتظار لتقديم هذه لها

197
00:13:04,490 --> 00:13:06,800
أتعبتُ نفسي وأنا أبحث
.عنها في كلّ مكان

198
00:13:07,130 --> 00:13:09,580
.نعم، نعم. لا بدّ أنّ ذلك كان صعبًا عليك

199
00:13:09,580 --> 00:13:13,700
،بما أنّك متعب جدًّا
.سأقدّمها لسوها بدلاً منك

200
00:13:13,700 --> 00:13:14,520
.مهلاً يا هذا

201
00:13:14,520 --> 00:13:16,190
.لا تفعل يا إيان

202
00:13:16,730 --> 00:13:18,220
.سأقدّمها لها أنا

203
00:13:18,220 --> 00:13:18,810
جينو؟

204
00:13:18,810 --> 00:13:20,600
.إن كنتم ستتشاجرون، فسأقدّمها لها أنا

205
00:13:20,600 --> 00:13:21,400
نوا؟

206
00:13:22,540 --> 00:13:25,240
.أنا قلق حيال قدرتك على توصيل الدّعوة

207
00:13:25,240 --> 00:13:26,950
.ربّما عليّ أنا أن أقدّمها لها

208
00:13:26,950 --> 00:13:28,800
!أنت أيضًا يا جاكا؟

209
00:13:28,800 --> 00:13:29,740
.خذ

210
00:13:29,990 --> 00:13:32,250
!يا للؤمكم يا رفاق

211
00:13:32,250 --> 00:13:32,850
.أنا آسف

212
00:13:32,850 --> 00:13:33,870
.آسف، آسف

213
00:13:33,870 --> 00:13:36,420
هذا غريب، صحيح؟

214
00:13:39,340 --> 00:13:45,510
،قبل مقابلتنا لسوها
.أردنا دائمًا الانعزال بأنفسنا

215
00:13:45,510 --> 00:13:46,860
.معك حقّ

216
00:13:47,190 --> 00:13:49,770
.ما كنّا لنفكّر أبدًا بدعوة أحد آخر

217
00:13:49,770 --> 00:13:51,720
.أنا متحمّس للحفلة

218
00:13:51,720 --> 00:13:55,560
وهذا سبب إضافيّ للحرص
.على تقديم الدّعوة لها

219
00:13:55,560 --> 00:13:57,350
.أنا أعلم ذلك

220
00:13:58,700 --> 00:14:02,150
.على الأرجح أنّ سوها هناك

221
00:14:07,070 --> 00:14:08,040
.سوها

222
00:14:10,420 --> 00:14:11,460
.هيلي

223
00:14:11,460 --> 00:14:12,790
أتيتِ لاستعارة بعض الكتب؟

224
00:14:12,790 --> 00:14:14,430
نعم. ماذا عنك؟

225
00:14:14,430 --> 00:14:15,750
.أنا أعيد كتابًا اليوم

226
00:14:16,570 --> 00:14:18,230
.إنّه الكتاب الّذي كان معك يومها

227
00:14:18,230 --> 00:14:20,690
.نعم. لقد أنهيته

228
00:14:20,690 --> 00:14:21,880
أكان مثيرًا للاهتمام؟

229
00:14:21,880 --> 00:14:26,190
.نعم. إنّه عن أساطير من مملكة قديمة

230
00:14:26,690 --> 00:14:29,090
.فيه أساطير عن مصّاصي الدّماء والمستذئبين

231
00:14:29,090 --> 00:14:31,390
...مصّاصي الدّماء والمستذئبين

232
00:14:31,390 --> 00:14:34,610
يشتهرون بكونهم أعداءً
.لدودين منذ القدم

233
00:14:34,610 --> 00:14:36,820
.إنّهم يظهرون معًا في العادة

234
00:14:37,160 --> 00:14:38,990
.فهمت

235
00:14:39,630 --> 00:14:43,480
يتحوّل المستذئبون إلى ذئاب
عندما يكون القمر بدرًا، صحيح؟

236
00:14:43,480 --> 00:14:44,750
.هذا صحيح

237
00:14:44,750 --> 00:14:48,540
بالتّفكير في الأمر، كان هنالك
.خسوف كامل البارحة

238
00:14:48,540 --> 00:14:49,250
.نعم

239
00:14:49,730 --> 00:14:55,780
ربّما لا يمكنهم التّحوّل عندما يكون
.هنالك خسوف يغطّي القمر البدر

240
00:14:55,780 --> 00:14:58,010
.لستُ واثقًا

241
00:14:58,780 --> 00:15:04,540
لكنّي سمعتُ أنّ المستذئبين يقعون في حبّ
.أوّل امرأة يرونها خلال الخسوف الكامل

242
00:15:04,930 --> 00:15:08,130
.ولا يحبّون أيّ أحد آخر طوال حياتهم

243
00:15:09,220 --> 00:15:10,430
.كم هذا جميل

244
00:15:10,430 --> 00:15:13,510
.لكنّ الخسوف ظاهرة نادرة

245
00:15:13,510 --> 00:15:16,980
.أشكّ أنّهم يقعون في الحبّ بتلك الطّريقة كثيرًا

246
00:15:16,980 --> 00:15:19,920
هذا صحيح. هل رأيت الخسوف يا هيلي؟

247
00:15:19,920 --> 00:15:22,610
.لا. كنتُ نائمًا

248
00:15:22,610 --> 00:15:23,830
أرأيته أنت؟

249
00:15:23,830 --> 00:15:26,270
.نعم، عند المدخل البحريّ

250
00:15:26,270 --> 00:15:30,240
ماذا؟ ذهبت إلى هناك بعد ما حدث؟ لماذا؟

251
00:15:31,230 --> 00:15:33,560
.أردتُ رؤية البحر في اللّيل فحسب

252
00:15:34,440 --> 00:15:38,850
ظننتُ أنّ القمر كان بدرًا ليلة
،البارحة وتفاجأت بالظُّلمة

253
00:15:38,850 --> 00:15:41,790
.لكنّ كان أخبرني بأمر الخسوف الكامل

254
00:15:43,650 --> 00:15:45,590
.التقينا عند البحر

255
00:15:45,890 --> 00:15:49,340
التقيتِ كان في ليلة خسوف كامل؟

256
00:15:49,960 --> 00:15:52,840
نعم. هل من خطب في ذلك؟

257
00:15:52,840 --> 00:15:55,020
.لا، لا شيء إطلاقًا

258
00:15:55,020 --> 00:15:56,860
.قومي بدعوتي في المرّة القادمة

259
00:15:56,860 --> 00:15:57,660
.حسنًا

260
00:15:58,360 --> 00:16:00,670
.مرّ ظلّ عابر على وجهه للحظة

261
00:16:00,670 --> 00:16:03,940
ألم يحبّ فكرة لقائي بكان؟

262
00:16:04,330 --> 00:16:07,010
.أحبّ مشاهدة البحر ليلاً أيضًا

263
00:16:07,460 --> 00:16:08,940
فعلاً؟

264
00:16:08,940 --> 00:16:12,660
،بالتّفكير في الأمر
.أتساءل عن سبب خلافاتهم

265
00:16:12,660 --> 00:16:14,700
هل السّبب هو أنّهم يرتادون
مدرستين متنافستين؟

266
00:16:15,950 --> 00:16:20,150
قالوا أنّهم يتنافسون في بطولة
.الكرة اللّيليّة كلّ سنة

267
00:16:21,670 --> 00:16:25,030
.ربّما هم متوتّرون لأنّ لديهم مباراة وشيكة

268
00:16:25,030 --> 00:16:26,920
.لا يمكن فعل أيّ شيء حيال ذلك

269
00:16:26,920 --> 00:16:29,490
على أيّ حال، لا بدّ أنّ ما عشتِه
.البارحة كان صعبًا

270
00:16:29,490 --> 00:16:31,960
.ماذا؟ نعم، صحيح

271
00:16:31,960 --> 00:16:36,380
أبلغيني في الحال إن حدث
أيّ شيء غير عاديّ، موافقة؟

272
00:16:38,720 --> 00:16:40,970
.لم تكن هذه مجرّد مصادفة

273
00:16:40,970 --> 00:16:43,230
.كانوا يستهدفون سوها

274
00:16:46,710 --> 00:16:48,860
.حسنًا. لكنّي بخير

275
00:16:49,220 --> 00:16:51,810
هل اعتدتِ على المدرسة؟

276
00:16:51,810 --> 00:16:56,260
نعم. أعتقد أنّي أستمتع بوقتي
.في المدرسة لأوّل مرّة في حياتي

277
00:16:57,370 --> 00:16:58,490
.فهمت

278
00:16:58,890 --> 00:17:01,750
.كلّ هذا بفضلك يا هيلي. شكرًا لك

279
00:17:01,750 --> 00:17:03,170
.لستِ بحاجة لشكري

280
00:17:03,640 --> 00:17:06,250
.أنا مسرور لأنّك تستمتعين بوقتك

281
00:17:06,250 --> 00:17:09,520
—لكنّك سبب حصولي على أصدقاء

282
00:17:09,520 --> 00:17:10,410
.سوها

283
00:17:10,840 --> 00:17:11,960
.جينو

284
00:17:12,280 --> 00:17:14,350
.كنتِ في المكتبة إذًا

285
00:17:14,350 --> 00:17:16,050
هل تستعيران كتبًا؟

286
00:17:16,050 --> 00:17:18,590
.نعم. لكنّ هيلي هنا ليعيد كتابًا

287
00:17:18,590 --> 00:17:20,160
.فهمت، فهمت

288
00:17:20,160 --> 00:17:21,930
هل تستعيرون كتبًا أيضًا؟

289
00:17:21,930 --> 00:17:25,780
.بالطّبع. المطالعة هوايتي

290
00:17:25,780 --> 00:17:29,410
.أتيتُ لاستعارة كتاب عن ميكانيكا الكمّ

291
00:17:29,410 --> 00:17:31,380
.أنا مهتمّ بها مؤخّرًا

292
00:17:31,380 --> 00:17:33,280
.كفّا عن الكذب كلاكما

293
00:17:33,280 --> 00:17:36,350
.نوا، كتابك مقلوب

294
00:17:39,170 --> 00:17:41,820
.توقّعنا أن تكوني هنا فحسب يا سوها

295
00:17:41,820 --> 00:17:45,160
.لا أحد منّا يقرأ في العادة غير هيلي

296
00:17:45,830 --> 00:17:47,490
.لا تخبرها بذلك

297
00:17:48,090 --> 00:17:50,090
.قرأت ثلاثة أسطر كاملة

298
00:17:50,370 --> 00:17:52,690
عمّ كنتما تتحدّثان؟

299
00:17:53,710 --> 00:17:56,300
.كنتُ أسأل هيلي عن الكتاب الّذي قرأه

300
00:17:56,530 --> 00:17:59,430
.قال أنّه عن مملكة قديمة

301
00:17:59,790 --> 00:18:01,850
.ثمّة مستذئبون ومصّاصو دماء في القصص

302
00:18:01,850 --> 00:18:02,770
مستذئبون؟

303
00:18:03,430 --> 00:18:07,860
نعم. أخبرني هيلي عن أسطورةِ
.مستذئبين رومانسيّة

304
00:18:07,860 --> 00:18:08,600
أيّ أسطورة؟

305
00:18:08,600 --> 00:18:13,850
يقع المستذئبون في حبّ أوّل امرأة
.يرونها خلال الخسوف الكامل

306
00:18:13,850 --> 00:18:16,110
.سيحبّونها هي وحدها للأبد

307
00:18:16,420 --> 00:18:18,840
أليس ذلك رومانسيًّا؟

308
00:18:21,160 --> 00:18:22,490
.كلاّ

309
00:18:22,490 --> 00:18:26,500
.ربّما، ولكنّ المستذئبين مجرّد جراء

310
00:18:26,500 --> 00:18:30,010
نعم. يضطرّ المرء للتّعامل مع فروهم
.المتساقط كلّما كانوا في الجوار

311
00:18:30,010 --> 00:18:31,790
.سنعطس للأبد بسببهم

312
00:18:32,340 --> 00:18:37,470
،يقال أنّهم صنف هجين بين البشر والذّئاب
.%لكنّ جانبهم البشريّ أقلّ من 10

313
00:18:37,470 --> 00:18:38,590
.نعم

314
00:18:40,970 --> 00:18:43,780
سولون؟ أكنت هنا؟

315
00:18:43,780 --> 00:18:51,020
نـ-نعم. إنّ كلّ شخص عبارة عن نصف
.كلب شارد هو وحشيّ وغبيّ وفظّ

316
00:18:51,020 --> 00:18:54,350
.على مهلكم. لا داعي للتّمادي لذلك الحدّ

317
00:18:54,350 --> 00:18:57,240
.تعتقد سوها أنّ أسطورة المستذئبين رومانسيّة

318
00:18:57,580 --> 00:19:01,450
أسطورة وقوعهم في حبّ أوّل شخص
يرونه خلال الخسوف الكامل؟

319
00:19:01,450 --> 00:19:03,720
.ذلك يُثبت غباء المستذئبين فحسب

320
00:19:03,720 --> 00:19:06,870
.مصّاصو الدّماء... أفضل بكثير

321
00:19:06,870 --> 00:19:08,040
...لكن

322
00:19:09,120 --> 00:19:12,680
.لا يشعر مصّاصو الدّماء بالحبّ على الإطلاق

323
00:19:13,000 --> 00:19:17,150
.لا، لا يملكون حتّى قلب البشر الطّيّب

324
00:19:17,570 --> 00:19:21,470
!لقد هاجموني البارجة من العدم

325
00:19:21,840 --> 00:19:24,090
...وأيضًا... وأيضًا

326
00:19:24,090 --> 00:19:28,190
إنّهم يقتلون أشخاصًا بريئين
!ويحوّلونهم إلى مصّاصي دماء

327
00:19:28,930 --> 00:19:32,100
لذلك من المستحيل أن يعرفوا
.ما هو الحبّ من الأساس

328
00:19:32,100 --> 00:19:35,690
!مصّاصو الدّماء مجرّد وحوش قاسية وباردة

329
00:19:35,690 --> 00:19:38,230
!المستذئبون أفضل بكثير

330
00:19:38,230 --> 00:19:40,820
.لا، لا يمكن مقارنتهم بهم أساسًا

331
00:19:40,820 --> 00:19:43,340
!مصّاصو الدّماء هم الأسوأ

332
00:19:46,770 --> 00:19:51,910
.آ-آسفة لأنّي فقدتُ أعصابي فجأة

333
00:19:51,910 --> 00:19:54,080
.لا-لا بأس

334
00:19:54,370 --> 00:19:56,870
.ما كان علينا قول تلك الأشياء من الأساس

335
00:19:57,340 --> 00:19:59,090
.نـ-نعم

336
00:19:59,090 --> 00:20:01,470
.ليس لديك ما تعتذرين بشأنه يا سوها

337
00:20:01,470 --> 00:20:02,580
.صحيح

338
00:20:02,930 --> 00:20:04,620
.لكلّ شخص أشياء يفضّلها عن غيرها

339
00:20:04,620 --> 00:20:05,620
.نعم

340
00:20:05,620 --> 00:20:10,330
.أنا أكره مصّاصي الدّماء بشدّة لا غير

341
00:20:10,330 --> 00:20:11,020
.نعم

342
00:20:12,140 --> 00:20:16,860
.نعلم ذلك. يكره الجميع مصّاصي الدّماء

343
00:20:23,860 --> 00:20:27,410
.فهمت. قُتل صديقها على يد مصّاص دماء

344
00:20:27,410 --> 00:20:29,990
.نعم. هذا سبب كرهها لمصّاصي الدّماء

345
00:20:30,250 --> 00:20:31,650
.ذلك ليس كلّ شيء

346
00:20:32,190 --> 00:20:34,790
تملك سوها تلك القوّة الهائلة، صحيح؟

347
00:20:34,790 --> 00:20:36,270
تقصد قوّتها الجسديّة الخارقة؟

348
00:20:36,580 --> 00:20:39,720
.يعتقد النّاس أنّها مصّاصة دماء بسببها

349
00:20:39,720 --> 00:20:42,610
.على الأرجح أنّها عانت الكثير

350
00:20:43,850 --> 00:20:46,190
ما الّذي يفترض بنا فعله إذًا؟

351
00:20:48,100 --> 00:20:50,640
.لم أستطع تقديم الدّعوة لها

352
00:20:50,950 --> 00:20:53,270
حتّى أنت لم تستطع ذلك؟

353
00:20:53,270 --> 00:20:56,850
ماذا؟ لم يكن الوضع يسمح بذلك، مفهوم؟

354
00:20:56,850 --> 00:21:00,610
.ربّما لا يمكننا دعوتها إلى حفلة عيد الميلاد

355
00:21:26,870 --> 00:21:31,260
ظننتُ أنّ القمر كان بدرًا ليلة
،البارحة وتفاجأت بالظُّلمة

356
00:21:31,260 --> 00:21:34,460
.لكنّ كان أخبرني بأمر الخسوف الكامل

357
00:21:51,590 --> 00:21:54,010
.وجدتك أخيرًا

358
00:23:34,200 --> 00:23:36,350
:في الحلقة الخامسة القادمة

359
00:23:36,350 --> 00:23:39,510
."القمر المتزايد: عضّ عنقي"