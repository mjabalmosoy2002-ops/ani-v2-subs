1
00:00:07,870 --> 00:00:08,790
.أعتذر

2
00:00:15,320 --> 00:00:19,700
...علينا الابتعاد عن سوها
.لا، بل عن جميع البشر

3
00:00:20,420 --> 00:00:21,200
...نحن

4
00:00:22,200 --> 00:00:23,470
.مصّاصو دماء

5
00:00:28,540 --> 00:00:33,470
صارت هذه الغرفة نظيفة في وقت
.سريع بفضل هيلي والبقيّة

6
00:00:34,660 --> 00:00:36,420
.وذلك ليس كلّ شيء

7
00:00:37,340 --> 00:00:38,720
...تلك القوى

8
00:00:39,000 --> 00:00:40,220
...لأنّه

9
00:00:41,650 --> 00:00:43,470
.لدينا سرّ

10
00:00:43,470 --> 00:00:45,020
!مهلاً... ماذا؟

11
00:00:45,020 --> 00:00:48,900
!سـ-سمعتُ للتّوّ صوتك داخل رأسي

12
00:00:48,900 --> 00:00:50,020
.إنّه تخاطر

13
00:00:50,020 --> 00:00:52,170
.هذا ما أستطيع فعله

14
00:00:52,170 --> 00:00:53,150
!ماذا؟

15
00:00:53,150 --> 00:00:54,530
.وأنا أيضًا في الحقيقة

16
00:00:57,430 --> 00:01:00,020
.سأدفّئ يديك عندما تشعرين بالبرد

17
00:01:06,140 --> 00:01:08,010
.بإمكاني فعل هذا

18
00:01:11,870 --> 00:01:17,030
تمّ اتّهامي بأنّي مصّاصة دماء
.مرّات عديد بسبب قواي

19
00:01:17,780 --> 00:01:20,780
.لكنّي لستُ الوحيدة

20
00:01:20,780 --> 00:01:24,210
.يوجد بشر يمتلكون قوى غريبة أيضًا

21
00:01:26,110 --> 00:01:31,480
كريس، أعتقد أنّ بإمكاني الاستمتاع
.بحياة مدرسيّة عاديّة هنا

22
00:01:49,560 --> 00:01:52,920
.مكان تجميع النّفايات بعيد جدًّا

23
00:01:52,920 --> 00:01:57,220
.وقعت جريمة قتل قبل وقت ليس ببعيد

24
00:01:57,220 --> 00:02:00,140
.كانت من صنيع مصّاص دماء حسب الشّائعات

25
00:02:07,330 --> 00:02:10,180
سأرمي هذه القمامة بسرعة
.وأعود إلى غرفتي في الحال

26
00:03:52,120 --> 00:03:53,020
...المعذرة

27
00:03:58,340 --> 00:04:00,600
!مـ-من أنت؟

28
00:04:00,600 --> 00:04:02,050
!هل أنت مصّاص دماء؟

29
00:04:03,970 --> 00:04:05,470
...هذا مؤلم

30
00:04:05,470 --> 00:04:09,220
.زيّ مدرسيّ؟ لكنّه ليس لهذه المدرسة

31
00:04:10,050 --> 00:04:10,960
!كان

32
00:04:10,960 --> 00:04:12,080
!أخي كان

33
00:04:14,280 --> 00:04:15,700
أأنت من فعل هذا؟

34
00:04:16,690 --> 00:04:18,400
!ستدفع ثمن ما فعلت لكان

35
00:04:20,380 --> 00:04:22,280
ماذا؟ فتاة؟

36
00:04:27,330 --> 00:04:28,820
!أخي ناجاك

37
00:04:30,490 --> 00:04:31,940
.مهلاً

38
00:04:31,940 --> 00:04:35,640
أطاحت حتّى بأخي ناجاك؟

39
00:04:35,640 --> 00:04:36,830
من أنت؟

40
00:04:37,610 --> 00:04:40,880
!من تكونون؟ هل أنتم مصّاصو دماء؟

41
00:04:40,880 --> 00:04:44,150
!ماذا قلت؟! اسحبي كلامك

42
00:04:44,780 --> 00:04:46,730
.نحن لسنا مصّاصي دماء

43
00:04:47,100 --> 00:04:48,600
.أخي إنزي

44
00:04:48,600 --> 00:04:50,980
.أتمنّى ألاّ تسيئي الفهم

45
00:04:50,980 --> 00:04:54,340
.ذلك فقط هو أسوأ ما قد تصفيننا به

46
00:04:54,340 --> 00:04:55,660
.هذا صحيح

47
00:04:55,660 --> 00:04:58,970
.لا أحد يفلت بعد الخلط بيننا وبين مصّاصي الدّماء

48
00:04:58,970 --> 00:05:00,650
!هذا جدّيّ

49
00:05:01,510 --> 00:05:03,610
!مجرّد سماع ذلك يشعرني بالقشعريرة

50
00:05:05,050 --> 00:05:07,250
...لأنّنا نكره مصّاصي الدّماء

51
00:05:08,340 --> 00:05:10,730
.أكثر من أيّ شيء في العالم

52
00:05:11,090 --> 00:05:11,770
ماذا؟

53
00:05:14,310 --> 00:05:15,540
.وأنا أيضًا

54
00:05:17,670 --> 00:05:20,380
.نحن تلاميذ من مدرسة مدينة سانشاين

55
00:05:20,380 --> 00:05:21,750
.أنا كان

56
00:05:21,980 --> 00:05:23,300
.وهذا ناجاك

57
00:05:24,170 --> 00:05:26,660
.والاثنان خلفي هما إنزي وتاهيل

58
00:05:26,660 --> 00:05:28,560
.أنا إنزي. سررت بلقائك

59
00:05:28,560 --> 00:05:30,100
.إنّك مذهلة بالفعل

60
00:05:30,100 --> 00:05:31,610
هل تمارسين الفنون القتاليّة؟

61
00:05:31,610 --> 00:05:33,150
.نعم، نوعًا ما

62
00:05:33,800 --> 00:05:37,940
أنا سوها. ما الّذي تفعلونه في مدرستنا؟

63
00:05:38,530 --> 00:05:41,610
.إنّنا في الحقيقة نتحرّى حادثة معيّنة

64
00:05:43,490 --> 00:05:44,760
.أنتما هنا

65
00:05:45,660 --> 00:05:47,400
.جاكا، نوا

66
00:05:51,210 --> 00:05:53,480
ما الّذي تريدونه من تلميذة من مدرستنا؟

67
00:05:53,480 --> 00:05:56,310
ما الّذي تفعلونه هنا من الأساس؟

68
00:05:56,310 --> 00:05:57,920
...عـ-عفوًا

69
00:05:57,920 --> 00:06:00,740
!ما الّذي نريده؟ لا تتظاهرا بالغباء

70
00:06:00,740 --> 00:06:01,960
.تاهيل

71
00:06:02,280 --> 00:06:05,370
تعرفان بأمر جريمة القتل الأخيرة، صحيح؟

72
00:06:05,370 --> 00:06:07,570
نعم. وماذا في ذلك؟

73
00:06:08,010 --> 00:06:10,660
.كان الضّحيّة أحد تلاميذ مدرستنا

74
00:06:10,660 --> 00:06:11,510
ماذا؟

75
00:06:12,200 --> 00:06:13,570
وبعد؟

76
00:06:13,570 --> 00:06:15,560
.لا علاقة لذلك بنا

77
00:06:15,560 --> 00:06:17,230
أتقول لا علاقة؟

78
00:06:18,070 --> 00:06:22,650
في الحقيقة، أراهن أنّكم
.متورّطون في هذا بطريقة ما

79
00:06:23,880 --> 00:06:27,860
.ستندم على قولك لهذا

80
00:06:28,370 --> 00:06:31,300
ألم تظهروا والقمر ساطع في السّماء

81
00:06:31,650 --> 00:06:34,910
لأنّكم تعرفون أنّ لا فرصة لكم أمامنا في العادة؟

82
00:06:34,910 --> 00:06:36,330
ماذا قلت؟

83
00:06:37,160 --> 00:06:38,490
!لا

84
00:06:39,850 --> 00:06:42,500
!توقّفوا جميعًا! لا تتشاجروا

85
00:06:45,050 --> 00:06:46,420
أوقفتنا؟

86
00:06:47,300 --> 00:06:48,790
.إنّها قويّة جدًّا

87
00:06:50,120 --> 00:06:54,180
.ظننّا أنّهم كانوا يتنمّرون عليك فحسب

88
00:06:54,590 --> 00:06:58,470
.ذلك ليس صحيحًا. كان مجرّد سوء فهم

89
00:06:58,470 --> 00:06:59,980
.لذلك توقّفوا عن الشّجار

90
00:07:06,200 --> 00:07:08,210
ما الّذي تفعلونه في مثل هذه السّاعة؟

91
00:07:11,550 --> 00:07:13,230
.هـ-هيلي

92
00:07:17,690 --> 00:07:21,860
.ابتعدوا عن سوها في الحال

93
00:07:22,530 --> 00:07:24,610
.هيلي، الأمر ليس كما تظنّ

94
00:07:24,610 --> 00:07:27,530
.قابلتهم عندما كنتُ أرمي القمامة

95
00:07:27,530 --> 00:07:29,510
.كان كلّ شيء مجرّد سوء فهم

96
00:07:30,340 --> 00:07:31,970
لم تتأذّي، صحيح؟

97
00:07:31,970 --> 00:07:33,830
.ماذا؟ صحيح

98
00:07:34,140 --> 00:07:35,680
.هذا جيّد إذًا

99
00:07:36,190 --> 00:07:37,960
.الوقت متأخّر، والمكان هنا ليس آمنًا

100
00:07:38,360 --> 00:07:40,290
.سأرافقك في طريق العودة. هيّا بنا

101
00:07:40,290 --> 00:07:42,530
...ماذا؟ مهلاً، ولكن

102
00:07:42,530 --> 00:07:45,470
.مهلاً! لم ننتهِ من الحديث

103
00:07:45,470 --> 00:07:47,690
.ليس لدينا ما نتحدّث به معكم

104
00:07:49,000 --> 00:07:51,360
.غادروا المكان في الحال

105
00:07:52,270 --> 00:07:56,170
أنتم من قتل تلميذنا، صحيح؟

106
00:07:56,170 --> 00:07:57,120
.كلاّ

107
00:07:57,120 --> 00:07:59,910
.ماذا؟ هذا ليس جوابًا كافيًا

108
00:07:59,910 --> 00:08:01,750
.إنّنا لا نقوم بأشياء كهذه

109
00:08:01,750 --> 00:08:03,620
!أيمكنك إثبات ذلك؟

110
00:08:03,620 --> 00:08:08,000
وهل لديكم دليل أنّنا الفاعلون؟

111
00:08:11,370 --> 00:08:14,010
.لا يوجد أيّ أحد آخر قادر على ذلك

112
00:08:14,330 --> 00:08:16,170
ما الّذي ستفعلونه إذًا؟

113
00:08:16,170 --> 00:08:19,330
...إن كنّا الجُناة بالفعل

114
00:08:20,820 --> 00:08:23,520
فما الّذي تنوون القيام به؟

115
00:08:23,970 --> 00:08:24,810
...هيلي

116
00:08:26,020 --> 00:08:28,110
!إذًا فقد كنتم أنتم بالفعل

117
00:08:28,930 --> 00:08:30,320
!توقّف يا هيلي

118
00:08:31,390 --> 00:08:33,950
.لا تقاتل رجاءً

119
00:08:34,660 --> 00:08:35,660
.وأنت كذلك يا تاهيل

120
00:08:36,070 --> 00:08:37,560
!أنا أرجوكم جميعًا

121
00:08:48,660 --> 00:08:50,250
.آسف يا سوها

122
00:08:51,590 --> 00:08:52,450
...هيلي

123
00:08:52,890 --> 00:08:56,590
.لن أقاتل. أنا آسف لأنّي أخفتك

124
00:08:57,730 --> 00:09:01,120
.كان، لا علاقة لدينا بجريمة القتل

125
00:09:01,120 --> 00:09:02,600
.هذه هي الحقيقة

126
00:09:03,590 --> 00:09:06,350
.تبًّا، لن نغادر خاليي الوفاض

127
00:09:07,590 --> 00:09:09,380
.هذا يكفي لهذا اليوم

128
00:09:09,950 --> 00:09:12,360
.مباراة الكرة اللّيليّة وشيكة

129
00:09:14,010 --> 00:09:16,360
لماذا لا نسوّي المسألة حينها؟

130
00:09:16,680 --> 00:09:20,150
ليس عن طريق شجار، ولكن
.بمباراة رياضيّة بعدل وإنصاف

131
00:09:21,290 --> 00:09:22,370
.سوها

132
00:09:22,370 --> 00:09:23,190
ماذا؟

133
00:09:23,640 --> 00:09:25,870
.آسف لأنّنا أخفناك قبل قليل

134
00:09:25,870 --> 00:09:29,540
.لا، بل أنا من عليها أن تعتذر لأنّي رميتك

135
00:09:29,540 --> 00:09:32,800
ماذا؟ رمت سوها كان؟

136
00:09:33,050 --> 00:09:35,530
.سنغادر اليوم احترامًا لك

137
00:09:36,330 --> 00:09:37,190
.حسنًا

138
00:09:37,190 --> 00:09:38,180
...لكن

139
00:09:39,250 --> 00:09:41,730
.جريمة القتل والكرة اللّيليّة أمران منفصلان

140
00:09:41,730 --> 00:09:44,260
.من الأفضل أن تحسنوا التّصرّف

141
00:09:44,950 --> 00:09:47,190
.إنّنا نراقبكم دائمًا

142
00:09:47,570 --> 00:09:51,290
.وبالطّبع سنسحقكم في الكرة اللّيليّة أيضًا

143
00:09:51,690 --> 00:09:53,940
.أكيد. سنكون جاهزين

144
00:09:55,270 --> 00:09:56,520
.هيّا بنا يا رفاق

145
00:09:56,520 --> 00:09:59,240
ماذا؟ سنغادر بهذه البساطة فعلاً؟

146
00:10:00,900 --> 00:10:02,890
هل أنت واثق يا كان؟

147
00:10:02,890 --> 00:10:03,700
.نعم

148
00:10:20,910 --> 00:10:25,460
.لا بدّ أنّ رفيقنا قُتل على يد مصّاصي دماء

149
00:10:27,980 --> 00:10:35,230
ولا يُعجبني أنّهم يعتقدون أنّ بإمكانهم
.هزيمتنا في الكرة اللّيليّة ثانية هذه السّنة

150
00:10:37,490 --> 00:10:41,260
سيعود ماهان والبقيّة قريبًا
من أجل المباراة، صحيح؟

151
00:10:42,740 --> 00:10:44,530
.لن ندعهم يفوزون

152
00:10:45,850 --> 00:10:47,010
.نعم

153
00:10:53,610 --> 00:10:56,420
.أنا آسف. تذكّرتُ أنّ عليّ القيام بأمر ما

154
00:10:57,560 --> 00:10:59,150
.واصلوا بدوني

155
00:11:00,210 --> 00:11:03,680
.حسنًا، لكن ابق بعيدًا عنهم

156
00:11:04,350 --> 00:11:05,800
.لا داعي للقلق حيالي

157
00:11:08,120 --> 00:11:09,140
.أنا آسف

158
00:11:09,140 --> 00:11:10,060
ماذا؟

159
00:11:10,330 --> 00:11:13,690
.لأنّي حاولتُ القتال أمامك قبل قليل

160
00:11:13,690 --> 00:11:17,190
لا بأس. توقّفتَ في الحال، صحيح؟

161
00:11:17,580 --> 00:11:18,340
...نعم

162
00:11:19,190 --> 00:11:22,020
.أرأيت؟ لذلك لا داعي للقلق

163
00:11:26,350 --> 00:11:28,440
سوها؟ هل من خطب ما؟

164
00:11:29,460 --> 00:11:30,770
.على الإطلاق

165
00:11:36,760 --> 00:11:41,030
...علينا الابتعاد عن سوها
.لا، بل عن جميع البشر

166
00:11:41,740 --> 00:11:42,550
...نحن

167
00:11:43,590 --> 00:11:44,760
.مصّاصو دماء

168
00:12:19,130 --> 00:12:20,090
.عرفتُ ذلك

169
00:12:22,390 --> 00:12:23,840
.إنزي

170
00:12:24,060 --> 00:12:25,650
.لم أرك منذ مدّة

171
00:12:26,020 --> 00:12:28,350
.لم أرك منذ مباراة الكرة اللّيليّة العام الماضي

172
00:12:29,450 --> 00:12:30,350
...إنّ مظهرك

173
00:12:36,200 --> 00:12:38,530
.إذًا أنت مستذئب أيضًا

174
00:12:40,790 --> 00:12:42,990
.لا داعي لإخفاء الأمر

175
00:12:43,730 --> 00:12:46,410
.أنا مستذئب مثلك

176
00:12:46,410 --> 00:12:48,900
.أنا لستُ مثلكم

177
00:12:50,850 --> 00:12:53,380
هل أنت نصف مصّاص دماء أيضًا؟

178
00:12:55,900 --> 00:12:59,230
.رأيتنا قبل قليل، لكنّك لم تأتِ للمساعدة

179
00:12:59,620 --> 00:13:02,380
أهذا لأنّك تخفي الأمر من أصدقائك؟

180
00:13:02,380 --> 00:13:05,130
.هذا لأنّي لا أحبّ التّورّط معكم

181
00:13:07,640 --> 00:13:11,230
على أيّ حال، هجائن مصّاصي
.الدّماء والمستذئبين نادرون

182
00:13:11,780 --> 00:13:14,640
.فلطالما كنّا أعداءً لدودين

183
00:13:16,650 --> 00:13:19,690
لماذا لا تخبرني كيف يحدث ذلك؟

184
00:13:20,070 --> 00:13:22,670
لماذا قد أفعل ذلك؟

185
00:13:23,970 --> 00:13:26,730
.معك حقّ. لستَ مضطرًّا لإخباري بأيّ شيء

186
00:13:27,160 --> 00:13:28,650
.لا بأس إن لم ترغب في ذلك

187
00:13:29,340 --> 00:13:31,420
.لكنّك سمعتَ ما قالوه

188
00:13:31,860 --> 00:13:35,330
.قُتل أحد تلاميذ مدرستنا قبل أيّام

189
00:13:36,260 --> 00:13:37,110
.نعم

190
00:13:38,490 --> 00:13:41,790
.كانت على عنق الضّحيّة علامات عضّ واضحة

191
00:13:42,140 --> 00:13:44,620
.كما لم يظلّ في جسده قطرة دم واحدة

192
00:13:46,100 --> 00:13:50,260
وماذا في ذلك؟ أتلقي اللّوم علينا؟

193
00:13:52,250 --> 00:13:55,010
!أخبرتك أنّنا ما كنّا لنقوم بذلك أبدًا

194
00:13:55,010 --> 00:13:56,950
.قال هيلي نفس الشّيء

195
00:13:57,660 --> 00:14:00,400
.لكنّكم الوحيدون الموجودين هنا

196
00:14:00,400 --> 00:14:04,580
.صحيح، إنّنا نختبر تلك الرّغبات أحيانًا

197
00:14:05,260 --> 00:14:07,450
أليس الأمر مشابهًا بالنّسبة لكم؟

198
00:14:08,090 --> 00:14:09,950
...عندما تقترب ليالي القمر البدر

199
00:14:10,700 --> 00:14:14,600
نعم. في ليالٍ كهذه، عندما
...يكون القمر كبيرًا ومضيئًا

200
00:14:17,450 --> 00:14:20,670
.تستيقظ غرائزنا الفطريّة

201
00:14:24,700 --> 00:14:27,510
.لكنّنا لن نؤذي بشريًّا أبدًا

202
00:14:27,510 --> 00:14:29,450
.ونحن كذلك

203
00:14:29,450 --> 00:14:31,370
.إنّنا لسنا كبقيّة مصّاصي الدّماء

204
00:14:32,210 --> 00:14:37,180
كلاّ، من وجهة نظرنا، مصّاصو الدّماء
.الآخرون هم من على خطأ

205
00:14:37,180 --> 00:14:40,310
لماذا تظنّ أنّكم الوحيدون المختلفون؟

206
00:14:42,990 --> 00:14:48,310
قبل قليل، سألت كيف يولد هجين
.بين مصّاصي الدّماء والمستذئبين

207
00:14:50,130 --> 00:14:51,750
.لا يمكنني الرّدّ على ذلك

208
00:14:52,190 --> 00:14:54,690
.أخبرتك أنّه لا بأس بذلك إن لم ترد

209
00:14:54,690 --> 00:14:55,580
.الأمر ليس كذلك

210
00:14:56,210 --> 00:14:59,340
ليست مسألة أنّي لا أرغب
.في ذلك. بل لا أستطيع

211
00:15:00,860 --> 00:15:03,340
...وذلك لأنّي

212
00:15:05,180 --> 00:15:08,840
.لا أعرف ماهيتي أيضًا

213
00:15:13,170 --> 00:15:16,600
.لستُ الوحيد. الأمر كذلك بالنّسبة للبقيّة

214
00:15:18,950 --> 00:15:25,250
الأمر وكأنّنا صُنعنا في مكان ما
.واستيقظنا من حلم طويل

215
00:15:27,050 --> 00:15:28,810
.لا أعرف حتّى ماذا أكون

216
00:15:31,290 --> 00:15:34,900
.في كلّ الأحوال، لا علاقة لنا بالجريمة

217
00:15:34,900 --> 00:15:39,000
وأنا واثق أنّكم تشكّون بنا
،لأنّنا مصّاصو دماء مثل الجاني

218
00:15:39,390 --> 00:15:42,230
.لكنّنا لا نعتبرهم منّا

219
00:15:44,630 --> 00:15:47,810
.أتمنّى أنّك تقول الحقيقة

220
00:15:48,330 --> 00:15:51,810
.فنصفك مثلي على الأقلّ

221
00:15:59,830 --> 00:16:02,360
...ذلك... أنا

222
00:16:04,790 --> 00:16:06,730
.حسنًا، من الأفضل أن أذهب

223
00:16:07,290 --> 00:16:10,030
دعنا نلقي السّلام على بعضنا
.على الأقلّ في لقائنا التّالي

224
00:16:11,130 --> 00:16:11,970
.مع السّلامة

225
00:16:17,470 --> 00:16:20,090
.شكرًا لقدومكما لمساعدتي قبل قليل

226
00:16:20,090 --> 00:16:23,080
.كنّا قادمين من التّدريب وقتها

227
00:16:23,080 --> 00:16:23,960
.نعم

228
00:16:23,960 --> 00:16:25,040
.فهمت

229
00:16:25,410 --> 00:16:27,730
كيف عرفت يا هيلي؟

230
00:16:33,970 --> 00:16:36,140
.كنتُ مارًّا من هناك بالصّدفة أيضًا

231
00:16:36,140 --> 00:16:38,440
.فعلاً؟ شكرًا لك

232
00:16:39,010 --> 00:16:41,390
...سرّني أنّك أتيت يا هيلي

233
00:16:42,520 --> 00:16:44,390
!لا-لا تهتمّ

234
00:16:44,690 --> 00:16:46,510
.حسنًا، تصبح على خير

235
00:16:46,510 --> 00:16:47,550
.تصبحين على خير

236
00:16:47,550 --> 00:16:49,530
.تصبحان على خير أيضًا يا نوا وجاكا

237
00:16:49,530 --> 00:16:51,720
.ماذا؟ أ-أكيد

238
00:16:54,660 --> 00:16:56,160
...بالتّفكير في الأمر

239
00:16:58,520 --> 00:17:00,470
...بشأن كان ورفاقه

240
00:17:01,220 --> 00:17:06,080
قالوا أنّ الشّخص الّذي قُتل على يد
مصّاص الدّماء كان صديقهم، صحيح؟

241
00:17:06,390 --> 00:17:07,380
.نعم

242
00:17:07,380 --> 00:17:11,160
.يبدو أنّهم يكرهون مصّاصي الدّماء أيضًا

243
00:17:11,790 --> 00:17:14,860
.إنّ ذلك يجعلهم مثلي تمامًا

244
00:17:16,870 --> 00:17:21,970
قبل مدّة، قُتل صديقي
.على يد مصّاص دماء أيضًا

245
00:17:23,860 --> 00:17:27,130
.لذلك فأنا أكره مصّاصي الدّماء

246
00:17:28,560 --> 00:17:32,780
.ما أقصده هو أنّي أفهم ما يمرّ به كان ورفاقه

247
00:17:33,690 --> 00:17:35,090
.أنا آسفة

248
00:17:36,100 --> 00:17:37,700
.على أيّ حال، تصبحون على خير

249
00:17:45,350 --> 00:17:47,390
.قتل مصّاص دماء صديقها

250
00:17:47,970 --> 00:17:50,750
.لذلك السّبب تكره مصّاصي الدّماء

251
00:17:57,670 --> 00:18:01,600
.حدث الكثير اليوم

252
00:18:02,540 --> 00:18:07,600
.أنا مسرورة لأنّهم لم يتشاجروا

253
00:18:08,270 --> 00:18:12,110
...لكن ما كان ذلك؟ في تلك اللّحظة

254
00:18:12,530 --> 00:18:17,740
لم يفعل هيلي أيّ شيء، لكنّي شعرتُ
.أنّ عليّ إيقافه مهما كلّف الأمر

255
00:18:18,550 --> 00:18:22,250
.وإلاّ كان سيحدث أمر فظيع جدًّا

256
00:18:23,390 --> 00:18:25,620
.سوها ليست طبيعيّة بالتّأكيد

257
00:18:25,620 --> 00:18:29,750
.ذلك واضح. إنّها قويّة مثلي أنا

258
00:18:29,750 --> 00:18:31,900
.ذلك ليس ما نقصده

259
00:18:31,900 --> 00:18:33,140
ماذا تقصدان إذًا؟

260
00:18:36,280 --> 00:18:38,290
...في طريقنا عودتنا من التّدريب

261
00:18:40,450 --> 00:18:43,790
شعرنا بقدر هائل من الطّاقة
.وذهبنا للتّحقّق من الأمر

262
00:18:44,940 --> 00:18:46,810
.ووجدناها هناك

263
00:18:47,350 --> 00:18:49,710
.لم نشعر بأيّ شيء كذلك من قبل

264
00:18:49,710 --> 00:18:51,650
.كان قدرًا هائلاً من الطّاقة

265
00:18:52,690 --> 00:18:54,150
.هكذا إذًا

266
00:18:54,150 --> 00:18:59,700
،وعندما كدنا نخوض شجارًا معهم
.أوقفتنا سوها

267
00:19:00,180 --> 00:19:01,320
!لا

268
00:19:01,740 --> 00:19:04,580
!توقّفوا جميعًا! لا تتشاجروا

269
00:19:05,090 --> 00:19:10,650
،سمّرتنا كلماتها حيث نقف مؤقّتًا
.وكأنّنا كنّا مقيّدين

270
00:19:11,910 --> 00:19:12,790
.نعم

271
00:19:19,590 --> 00:19:22,160
سولون، أين كنت؟

272
00:19:22,160 --> 00:19:25,390
لماذا تجتمعون في غرفتي ثانية؟

273
00:19:26,110 --> 00:19:30,830
حسنًا، سوها تقيم في الغرفة
.الّتي كنّا نجتمع فيها الآن

274
00:19:30,830 --> 00:19:34,930
.نعم، وهذه الغرفة هي الأكثر ترتيبًا

275
00:19:34,930 --> 00:19:36,690
.كما أنّها في المنتصف

276
00:19:36,690 --> 00:19:39,110
!وكذلك غرفة شيون

277
00:19:39,110 --> 00:19:41,180
.ماذا؟ مستحيل

278
00:19:41,180 --> 00:19:43,570
.سأضطرّ للتّنظيف بعد الاجتماع

279
00:19:43,570 --> 00:19:46,030
ماذا قلت قبل أيّام؟

280
00:19:46,030 --> 00:19:49,330
!لا يوجد ما أحبّه أكثر من التّنظيف

281
00:19:49,330 --> 00:19:50,950
.لا تكن سخيفًا

282
00:19:50,950 --> 00:19:55,030
.كنتُ أمزح بالطّبع عندما قلتُ ذلك

283
00:19:55,840 --> 00:20:00,050
،على أيّ حال يا سولون
.أتى بعض المستذئبين إلى مدرستنا

284
00:20:00,820 --> 00:20:03,180
.نعم، ذلك ما يبدو

285
00:20:04,510 --> 00:20:05,850
كيف عرفت؟

286
00:20:06,310 --> 00:20:08,120
.مـ-مجرّد حدس

287
00:20:08,680 --> 00:20:11,270
.بإمكاني شمّ رائحتهم الفظيعة

288
00:20:11,270 --> 00:20:16,200
في كلّ الأحوال، تقع الكثير
.من هجمات مصّاصي الدّماء مؤخّرًا

289
00:20:16,550 --> 00:20:19,780
.لا أصدّق أنّ الآخرين يشكّون في أمرنا ثانية

290
00:20:19,780 --> 00:20:22,900
...لكنّنا شربنا الدّماء فقط

291
00:20:22,900 --> 00:20:25,030
.نعم، في ذلك اليوم

292
00:20:25,300 --> 00:20:28,020
.ما بوسعنا فعل أيّ شيء إن اشتبهوا بنا

293
00:20:28,890 --> 00:20:34,330
لكنّي لا أريد أن تسيء سوها
.فهمنا أو تكرهنا بسبب ذلك

294
00:20:44,550 --> 00:20:46,520
!أخي كان

295
00:20:46,970 --> 00:20:48,970
.سآتي في الحال

296
00:20:50,270 --> 00:20:53,640
.لهذا السّبب قلتُ أنّه ليس علينا مصادقتها

297
00:20:53,640 --> 00:20:57,450
.ومع ذلك، أريتموها قواكم بكلّ تهوّر

298
00:20:57,450 --> 00:21:01,440
.لكنّك ترفض أن تظهر قوّتك حتّى لنا

299
00:21:02,410 --> 00:21:05,480
صحيح. أيُعقل أنّك بشريّ عاديّ؟

300
00:21:05,480 --> 00:21:08,660
!في تلك الحالة، سأعضّك

301
00:21:08,660 --> 00:21:10,160
.بالطّبع لا

302
00:21:10,510 --> 00:21:12,160
.أنا أمزح فحسب

303
00:21:12,160 --> 00:21:14,130
.أنا أصدّقك يا سولون

304
00:21:14,130 --> 00:21:17,850
لا يوجد أحد أفضل منك
.في العثور على العيوب

305
00:21:17,850 --> 00:21:20,390
.إنّها قوّة مذهلة

306
00:21:20,390 --> 00:21:22,010
.سأقتلك

307
00:21:22,380 --> 00:21:26,430
في كلّ الأحوال، لا أريد خلق
.المزيد من سوء الفهم

308
00:21:26,430 --> 00:21:27,930
.صحيح

309
00:21:27,930 --> 00:21:29,680
.لا أريد أن تكرهنا سوها

310
00:21:29,680 --> 00:21:32,610
.لنكتفِ إذًا بتبادل التّحيّة معها فحسب

311
00:21:32,610 --> 00:21:34,220
.لا تتكلّموا معها أكثر

312
00:21:34,220 --> 00:21:35,770
.كفّوا عن التّصرّف بودّ معها

313
00:21:38,390 --> 00:21:40,260
.سولون على حقّ

314
00:21:41,090 --> 00:21:44,360
.حسنًا، لا بأس

315
00:21:46,430 --> 00:21:48,050
!سوها

316
00:21:48,050 --> 00:21:51,260
أتريدين الخروج في نهاية الأسبوع؟

317
00:21:53,930 --> 00:21:54,600
ماذا؟

318
00:23:34,020 --> 00:23:36,310
:في الحلقة الثّالثة القادمة

319
00:23:36,310 --> 00:23:39,180
."نصف قمر، الموعد الاستباقيّ"