1
00:00:00,790 --> 00:00:06,110
لكنّي لا أريد أن تسيء سوها
.فهمنا أو تكرهنا بسبب ذلك

2
00:00:06,380 --> 00:00:07,890
.صحيح

3
00:00:07,890 --> 00:00:09,650
.لا أريد أن تكرهنا سوها

4
00:00:09,650 --> 00:00:12,700
.لنكتفِ إذًا بتبادل التّحيّة معها فحسب

5
00:00:12,700 --> 00:00:14,230
.لا تتكلّموا معها أكثر

6
00:00:14,230 --> 00:00:15,740
.كفّوا عن التّصرّف بودّ معها

7
00:00:18,330 --> 00:00:20,130
.سولون على حقّ

8
00:00:21,000 --> 00:00:23,940
.حسنًا، لا بأس

9
00:00:28,230 --> 00:00:29,690
!سوها

10
00:00:31,070 --> 00:00:34,020
أتريدين الخروج في نهاية الأسبوع؟

11
00:00:35,530 --> 00:00:38,830
ماذا؟ فـ-في نهاية الأسبوع؟ أين؟

12
00:00:38,830 --> 00:00:40,260
...اسمعي

13
00:00:40,530 --> 00:00:41,390
!أنت

14
00:00:41,710 --> 00:00:43,830
.لنذهب إلى السّاحة معًا

15
00:00:43,830 --> 00:00:46,220
.بإمكاننا تناول المثلّجات والتّجوّل

16
00:00:46,220 --> 00:00:47,560
هل تستمع إليّ؟

17
00:00:48,620 --> 00:00:51,760
أقدّر لك ذلك، لكن... أأنت واثق؟

18
00:00:51,760 --> 00:00:53,080
.لنذهب للشّاطئ أيضًا

19
00:00:53,080 --> 00:00:55,010
نحن الاثنان فقط؟

20
00:00:55,010 --> 00:00:56,690
.نعم، نحن الاثنان فقط

21
00:00:56,690 --> 00:00:58,950
.كلاّ! سأذهب معكما

22
00:00:58,950 --> 00:01:01,490
.مهلاً! اهتمّ بشؤونك الخاصّة

23
00:01:01,810 --> 00:01:04,160
تخطّط لقول شيء غريب لها، صحيح؟

24
00:01:04,160 --> 00:01:06,610
ماذا؟ من تظنّني؟

25
00:01:06,610 --> 00:01:08,590
.من المستحيل أن أدعك تذهب وحدك

26
00:01:08,590 --> 00:01:11,840
عفوًا، ما الّذي يحدث بينكما؟

27
00:01:11,840 --> 00:01:15,220
ألم نقرّر أنّنا سنظلّ بعيدين عنها البارحة؟

28
00:01:15,660 --> 00:01:18,260
.حسنًا، لا بأس

29
00:01:18,930 --> 00:01:23,790
نعم، لكنّي كنتُ أمزح فحسب
.حينما قلتُ ذلك أيضًا

30
00:01:23,790 --> 00:01:25,480
.يا لسخافتك يا سولون

31
00:01:27,290 --> 00:01:30,020
!هيلي! جينو! إيان! جاكا! نوا

32
00:01:30,350 --> 00:01:30,940
ماذا؟

33
00:01:30,940 --> 00:01:31,410
سولون؟

34
00:01:31,410 --> 00:01:32,090
ماذا هنالك؟

35
00:01:32,710 --> 00:01:36,080
قال شيون أنّه سيقضي وقتًا مع
.سوها في السّاحة في نهاية الأسبوع

36
00:01:36,500 --> 00:01:37,150
فعلاً؟

37
00:01:37,150 --> 00:01:37,630
ماذا؟

38
00:01:37,630 --> 00:01:38,250
أتقول الحقيقة؟

39
00:01:39,160 --> 00:01:41,060
مهلاً! لماذا وشيت بي؟

40
00:01:41,060 --> 00:01:43,200
.أنت المخطئ لأنّك خلفت بالوعد

41
00:01:43,200 --> 00:01:45,790
سيذهب إلى السّاحة مع سوها
في نهاية الأسبوع؟

42
00:01:45,790 --> 00:01:48,530
—نعم، لذلك أخبروه أنّه ليس عليه

43
00:01:48,530 --> 00:01:49,090
!سأذهب أيضًا

44
00:01:49,750 --> 00:01:51,010
.وأنا كذلك

45
00:01:51,010 --> 00:01:51,750
!مهلاً

46
00:01:51,750 --> 00:01:52,670
.وأنا أيضًا

47
00:01:52,670 --> 00:01:53,670
!جاكا

48
00:01:53,670 --> 00:01:54,850
.يبدو هذا ممتعًا

49
00:01:54,850 --> 00:01:56,720
!نوا! ليس أنتم أيضًا

50
00:01:56,720 --> 00:02:00,050
!يا إلهي! سيذهبون جميعًا الآن بسببك

51
00:02:00,410 --> 00:02:03,570
يا إلهي، ما الّذي يفكّرون فيه جميعًا؟

52
00:02:03,570 --> 00:02:04,500
.سوها

53
00:02:05,010 --> 00:02:05,870
هيلي؟

54
00:02:05,870 --> 00:02:07,890
.سمعتُ أنّك ستخرجين في نهاية الأسبوع

55
00:02:07,890 --> 00:02:09,770
.ماذا؟ نـ-نعم

56
00:02:09,770 --> 00:02:11,580
أيمكنني مرافقتك؟

57
00:02:11,580 --> 00:02:13,150
.نعم، لا بأس

58
00:02:13,150 --> 00:02:14,360
...حسنًا

59
00:02:14,750 --> 00:02:15,960
.أراك في نهاية الأسبوع

60
00:03:54,010 --> 00:03:57,350
.سيكون هذا... مبالغًا فيه قليلاً

61
00:03:57,350 --> 00:03:59,660
.وسيكون من الصّعب المشي بهذا

62
00:03:59,660 --> 00:04:01,510
ماذا أفعل؟

63
00:04:01,860 --> 00:04:05,300
على أيّ حال، لا أصدّق
.أنّي سأخرج مع أصدقاء

64
00:04:20,050 --> 00:04:23,400
.أنت سوها، صحيح؟ أنا كريس

65
00:04:26,410 --> 00:04:29,700
.يقول الجميع أنّك مصّاصة دماء

66
00:04:29,700 --> 00:04:30,430
ماذا؟

67
00:04:31,070 --> 00:04:33,160
هل أنت مصّاصة دماء بالفعل؟

68
00:04:36,930 --> 00:04:39,940
.إن لم تكوني كذلك، عليك إخبار الجميع

69
00:04:41,340 --> 00:04:42,350
.لا فائدة من ذلك

70
00:04:42,850 --> 00:04:45,970
.لا يصدّقني أيّ أحد

71
00:04:47,570 --> 00:04:51,740
.فعلاً؟ لكنّي أراهن أنّك لست مصّاصة دماء

72
00:04:52,970 --> 00:04:53,710
.انظري

73
00:04:55,370 --> 00:04:58,560
.هذا هو حال قدمي منذ ولادتي

74
00:04:59,230 --> 00:05:02,280
.يقول النّاس أشياء مختلفة عندما يرونها

75
00:05:02,280 --> 00:05:07,450
.يختلقون الأكاذيب فقط لأنّني مختلف

76
00:05:08,030 --> 00:05:11,650
.لذلك أراهن أنّهم يكذبون بشأنك أيضًا

77
00:05:20,500 --> 00:05:23,710
.سوها، لنكن صديقين

78
00:05:28,190 --> 00:05:30,130
.أنا وحيد أيضًا

79
00:05:37,290 --> 00:05:38,980
.حسنًا، لا أمانع

80
00:05:49,630 --> 00:05:51,350
.حصلتُ على صديق

81
00:05:54,440 --> 00:05:56,780
.واستمتعتُ بوقتي كثيرًا كلّ يوم

82
00:05:58,690 --> 00:06:02,590
.وأردتُ أن أتشارك سرّي مع أحد ما

83
00:06:03,980 --> 00:06:05,670
.كلّ ذلك لأوّل مرّة في حياتي

84
00:06:09,660 --> 00:06:11,800
!هذا مذهل

85
00:06:14,810 --> 00:06:17,140
!أنت رائعة

86
00:06:20,530 --> 00:06:22,510
لا تظنّ أنّ قوّتي غريبة؟

87
00:06:22,510 --> 00:06:24,980
!لا. إنّها مميّزة

88
00:06:25,940 --> 00:06:29,530
فعلاً؟ لستَ خائفًا من أن أكون مصّاصة دماء؟

89
00:06:29,750 --> 00:06:33,200
.على الإطلاق. أنا أعرفك قبل كلّ شيء

90
00:06:34,360 --> 00:06:38,840
.ولكن... ما زلتُ لا أثق بنفسي بالكامل

91
00:06:39,830 --> 00:06:42,580
سوها، أتريدين تجربة عضّ عنقي؟

92
00:06:42,580 --> 00:06:46,210
...مستحيل! إن فعلتُ ذلك، وحدث شيء ما

93
00:06:46,210 --> 00:06:49,090
.لا بأس. باشري

94
00:07:10,410 --> 00:07:12,030
أرأيت؟ ألم أخبرك؟

95
00:07:12,300 --> 00:07:14,410
.لا يمكن أن تكوني مصّاصة دماء

96
00:07:17,510 --> 00:07:18,690
...كريس

97
00:07:19,250 --> 00:07:23,920
،لا بأس. مهما قاله الآخرون
.فسأصدّقك دائمًا

98
00:08:07,710 --> 00:08:09,060
!سوها

99
00:08:09,710 --> 00:08:11,440
.أتيت باكرًا

100
00:08:11,440 --> 00:08:13,640
.كنتُ آمل الوصول قبلك

101
00:08:13,640 --> 00:08:14,810
.شيون

102
00:08:14,810 --> 00:08:17,130
.تبدين ظريفة جدًّا اليوم

103
00:08:18,070 --> 00:08:22,020
شكرًا لك. لكن أين البقيّة؟

104
00:08:22,920 --> 00:08:25,460
.يبدو أنّهم مشغولون جدًّا

105
00:08:25,460 --> 00:08:29,400
لقد خذلونا. أتصدّقين هذا؟

106
00:08:31,180 --> 00:08:32,290
.هكذا إذًا

107
00:08:32,290 --> 00:08:35,570
.ما باليد حيلة الآن
!لنستمتع نحن الاثنين بوقتنا

108
00:08:35,880 --> 00:08:36,950
.هيّا بنا

109
00:08:37,410 --> 00:08:38,700
.حـ-حسنًا

110
00:08:39,260 --> 00:08:42,240
.سآخذك في جولة اليوم

111
00:08:42,240 --> 00:08:43,830
.شكرًا لك

112
00:08:44,430 --> 00:08:46,460
هيلي مشغول أيضًا؟

113
00:08:46,840 --> 00:08:50,230
.أتساءل ما الّذي يفعله. ربّما سأراسله

114
00:08:50,230 --> 00:08:53,020
.لا، مهلاً. قد يعتقد أنّي غاضبة

115
00:08:50,600 --> 00:08:53,020
.أريد أن أريك العديد من الأماكن

116
00:08:53,020 --> 00:08:54,450
.آمل أن تكوني متحمّسة

117
00:08:53,020 --> 00:08:55,330
!إنّه مشغول. لا يجب أن أجعله يقلق عليّ

118
00:08:56,040 --> 00:08:57,220
.يا سوها

119
00:08:57,220 --> 00:08:59,220
ألست مسرورة لأنّ الجوّ صحو اليوم؟

120
00:08:59,220 --> 00:09:00,430
.ذلك صحيح

121
00:09:01,410 --> 00:09:04,670
.لكن كان بإمكانه إخباري بذلك مسبقًا

122
00:09:05,110 --> 00:09:11,710
بعد التّفكير في الأمر، لا يمكنني مخاطبة
.هيلي بالتّخاطر ما لم يباشر هو بذلك أوّلاً

123
00:09:13,750 --> 00:09:17,490
تكون السّاحة نابضة بالحياة
.في نهاية الأسبوع

124
00:09:17,890 --> 00:09:23,160
يتشكّل صفّ طويل من دولاب
.الملاهي، ويكون مكتظًّا بالعائلات

125
00:09:23,160 --> 00:09:25,500
.توجد عدّة متاجر هناك أيضًا

126
00:09:25,500 --> 00:09:26,960
.هكذا إذًا

127
00:09:27,560 --> 00:09:30,300
،عندما تغرب الشّمس
.ينعكس نورها على الماء

128
00:09:30,300 --> 00:09:32,210
.ونحصل على منظر خلاّب

129
00:09:32,510 --> 00:09:35,570
.أريد أن أحرص على أن تري ذلك

130
00:09:35,570 --> 00:09:37,570
.كم أنت لطيف يا شيون

131
00:09:37,570 --> 00:09:43,170
.أنا هكذا دائمًا، وليس اليوم فقط

132
00:09:43,170 --> 00:09:45,980
.انتبهي لخطواتك

133
00:09:47,140 --> 00:09:48,050
.تفضّلي

134
00:09:48,920 --> 00:09:50,190
.شكرًا

135
00:09:50,420 --> 00:09:52,040
.على الرّحب والسّعة

136
00:09:57,610 --> 00:09:59,110
!كم هي ظريفة

137
00:09:59,110 --> 00:10:00,590
!إنّها قطّة

138
00:10:00,590 --> 00:10:02,120
!معك حقّ

139
00:10:21,620 --> 00:10:23,900
سوها، أتريدين مثلّجات؟

140
00:10:23,900 --> 00:10:26,390
.مثلّجات تلك الشّاحنة لذيذة جدًّا

141
00:10:26,390 --> 00:10:27,230
.نعم

142
00:10:27,230 --> 00:10:30,280
.سأذهب لشرائها. انتظري هنا في السّاحة

143
00:10:30,280 --> 00:10:32,460
.ماذا؟ شكرًا لك

144
00:10:37,210 --> 00:10:38,270
هل نذهب؟

145
00:10:38,270 --> 00:10:39,910
أيجب أن يحضر أحد ما سوها؟

146
00:10:40,290 --> 00:10:41,670
.سأذهب أنا

147
00:10:41,670 --> 00:10:42,510
.وأنا أيضًا

148
00:10:43,130 --> 00:10:44,280
.وكذلك أنا

149
00:10:45,070 --> 00:10:47,410
.أعتقد أنّنا سنذهب جميعًا إذًا

150
00:10:50,590 --> 00:10:51,290
ماذا؟

151
00:10:53,160 --> 00:10:54,390
أين شيون؟

152
00:11:02,510 --> 00:11:03,890
.تفضّلي

153
00:11:05,910 --> 00:11:07,500
.شـ-شكرًا لك

154
00:11:08,380 --> 00:11:11,490
.نكهة النّعناع بقطع شكولاطة هي المفضّلة لديّ

155
00:11:11,490 --> 00:11:14,480
.أنا مسرور لأنّنا استطعنا قضاء الوقت معًا

156
00:11:14,480 --> 00:11:15,370
صحيح؟

157
00:11:15,370 --> 00:11:16,150
.نعم

158
00:11:17,510 --> 00:11:19,150
!يا شيون

159
00:11:19,150 --> 00:11:20,670
أين أنت؟

160
00:11:20,670 --> 00:11:22,040
!قلنا أنّنا سنلتقي عند الخامسة

161
00:11:22,040 --> 00:11:23,230
!لماذا لستَ هنا؟

162
00:11:23,230 --> 00:11:24,610
أذلك صحيح؟

163
00:11:24,610 --> 00:11:27,060
.واثق أنّي قلتُ عند الرّابعة

164
00:11:27,060 --> 00:11:27,590
!ماذا؟

165
00:11:27,590 --> 00:11:31,050
.خاب ظنّي لأنّكم خذلتمونا

166
00:11:31,050 --> 00:11:33,640
.شيون! لن أدعك تفلت بهذا

167
00:11:33,640 --> 00:11:34,710
.جهّز نفسك

168
00:11:35,330 --> 00:11:37,050
.كم أودّ رؤيتك تحاول

169
00:11:37,050 --> 00:11:39,160
.نحن على متن قارب الآن

170
00:11:39,160 --> 00:11:41,950
.تعالوا للبحث عنّا وسط المحيط

171
00:11:42,930 --> 00:11:44,140
!اسمع

172
00:11:46,300 --> 00:11:47,250
ماذا هنالك؟

173
00:11:47,250 --> 00:11:50,340
لا شيء. أليست المثلّجات لذيذة؟

174
00:11:50,340 --> 00:11:52,590
!لقد خدعنا ذلك الوغد

175
00:11:52,590 --> 00:11:54,230
.وبعد كلّ ما قلتُه أيضًا

176
00:11:54,230 --> 00:11:56,480
.لا أمل يُرجى منه

177
00:11:56,480 --> 00:11:59,070
.ستعتقد سوها أنّنا تأخرّنا عليها

178
00:11:59,070 --> 00:11:59,960
.صحيح

179
00:12:02,920 --> 00:12:04,740
...يا شيون

180
00:12:05,620 --> 00:12:07,000
.شكرًا لك

181
00:12:07,000 --> 00:12:11,260
،إن كان الجميع مشغولين
.فلا بدّ أنّك كنت مشغولاً أيضًا

182
00:12:11,260 --> 00:12:12,870
لكنّك أتيت في كلّ الأحوال، صحيح؟

183
00:12:15,320 --> 00:12:17,130
.أنا مسرورة جدًّا لقدومك

184
00:12:18,170 --> 00:12:19,820
.نعم، أعتقد ذلك

185
00:12:20,230 --> 00:12:23,180
.أنا أقدّر الآخرين كثيرًا

186
00:12:23,500 --> 00:12:27,180
.هذه أوّل مرّة أزور فيها السّاحة

187
00:12:27,180 --> 00:12:29,000
ماذا؟ لماذا؟

188
00:12:29,000 --> 00:12:33,380
...لـ-لأنّني... أخاف من الحشود

189
00:12:34,630 --> 00:12:37,110
لماذا لا نذهب في جولة على القارب؟

190
00:12:38,050 --> 00:12:40,410
لا تحبّين الحشود، صحيح؟

191
00:12:40,410 --> 00:12:42,280
.لنذهب قبل حلول الظّلام

192
00:12:42,280 --> 00:12:45,330
.سأذهب لشراء التّذاكر. انتظريني هنا

193
00:12:45,950 --> 00:12:46,940
.مفهوم

194
00:12:54,230 --> 00:12:55,080
.سوها

195
00:12:57,220 --> 00:12:58,100
هيلي؟

196
00:12:58,470 --> 00:12:59,960
هل أنت في السّاحة؟

197
00:13:00,220 --> 00:13:01,710
.ماذا؟ نعم

198
00:13:02,210 --> 00:13:04,740
.ظننتُ أنّك مشغول اليوم

199
00:13:04,740 --> 00:13:08,630
.صحيح، لكن لديّ أمر أكثر أهمّيّة للقيام به

200
00:13:08,630 --> 00:13:10,220
وما هو؟

201
00:13:10,490 --> 00:13:11,910
.لقاؤك أنت

202
00:13:13,560 --> 00:13:15,370
!لـ-لقد فاجأتني

203
00:13:15,370 --> 00:13:18,200
.لم أعتقد أنّك تمزح في مثل هذه الأمور

204
00:13:18,530 --> 00:13:19,730
.إنّها الحقيقة

205
00:13:21,140 --> 00:13:23,450
.آسف لأنّي تأخّرت على موعد مهمّ كهذا

206
00:13:23,450 --> 00:13:25,050
.سأوافيك قريبًا. انتظريني

207
00:13:25,780 --> 00:13:26,580
.حسنًا

208
00:13:30,280 --> 00:13:32,600
.من الأفضل أن أخبر شيون

209
00:13:35,710 --> 00:13:38,750
ماذا؟ أهذا هو الطّريق الصّحيح؟

210
00:13:46,510 --> 00:13:49,300
.ربّما عليّ العودة للانتظار في السّاحة

211
00:14:16,440 --> 00:14:18,460
ما خطب هذا الشّخص؟

212
00:14:18,680 --> 00:14:19,950
!عليّ الهرب

213
00:14:38,110 --> 00:14:40,100
.ثمّة شيء ما ليس في محلّه

214
00:14:57,420 --> 00:15:02,420
أ-أهو مصّاص دماء بالفعل؟

215
00:15:15,790 --> 00:15:17,520
!شـ-شيون

216
00:15:17,520 --> 00:15:19,390
سوها! هل أنت بخير؟

217
00:15:19,630 --> 00:15:24,060
.نـ-نعم. هاجمني فجأة بينما كنتُ أبحث عنك

218
00:15:24,060 --> 00:15:25,670
.لنغادر هذا المكان

219
00:15:25,670 --> 00:15:26,520
!شيون

220
00:15:28,770 --> 00:15:29,930
!شيون

221
00:15:47,080 --> 00:15:48,150
!جاكا؟

222
00:15:48,150 --> 00:15:51,260
.آ-آسف! كانت حالة طارئة

223
00:15:57,760 --> 00:15:58,770
!إيان

224
00:15:59,260 --> 00:16:00,770
!سوها! هل أنت بخير؟

225
00:16:00,770 --> 00:16:03,190
.نعم، والفضل لجاكا

226
00:16:03,560 --> 00:16:04,420
!إيان

227
00:16:04,970 --> 00:16:06,020
.كان ذلك وشيكًا

228
00:16:11,690 --> 00:16:13,530
.إنّه لا يتراجع

229
00:16:14,200 --> 00:16:19,160
.أعطوني تلك الفتاة. حالاً

230
00:16:22,810 --> 00:16:23,770
ماذا قلت؟

231
00:16:24,210 --> 00:16:25,730
نعطيك سوها؟

232
00:16:31,070 --> 00:16:33,090
يريد سوها؟

233
00:16:33,990 --> 00:16:35,430
ولكن لماذا؟

234
00:16:46,060 --> 00:16:48,230
!جاكا! خذ سوها واهربا

235
00:16:48,230 --> 00:16:49,390
!مفهوم

236
00:16:57,580 --> 00:16:59,830
!ما هذا؟! نحن نتحرّك بسرعة

237
00:16:59,830 --> 00:17:02,580
.مـ-مهلاً يا جاكا

238
00:17:02,580 --> 00:17:03,290
ماذا؟

239
00:17:03,770 --> 00:17:04,920
.سأتقيّأ

240
00:17:11,470 --> 00:17:14,470
ما الّذي يفعله هؤلاء هنا؟

241
00:17:14,470 --> 00:17:17,090
هل سوها وشيون بخير؟

242
00:17:19,320 --> 00:17:20,820
.إنّهم كثيرون

243
00:17:26,290 --> 00:17:29,110
.أخبرنا من حرّضكم على هذا

244
00:17:29,110 --> 00:17:31,140
ما الّذي تريدونه؟

245
00:17:37,160 --> 00:17:38,580
.لا فائدة من هذا أيضًا

246
00:17:40,910 --> 00:17:43,850
.فقدوا جميعهم حسّهم بالمنطق

247
00:17:43,850 --> 00:17:46,040
.إنّهم مجرّد مصّاصو دماء متدنّي المستوى

248
00:17:46,370 --> 00:17:48,670
.لا فائدة من الحديث معهم

249
00:17:48,980 --> 00:17:49,910
!يا رفاق

250
00:17:51,370 --> 00:17:52,960
أين سوها؟

251
00:17:52,960 --> 00:17:55,300
أخذها جاكا إلى السّاحة حيث
.يوجد الكثير من الأشخاص

252
00:17:55,300 --> 00:17:56,440
.فهمت

253
00:17:57,240 --> 00:17:58,640
.اسمع يا شيون

254
00:17:58,640 --> 00:18:01,930
كيف حدث هذا وهي برفقتك؟

255
00:18:01,930 --> 00:18:04,250
...في الحقيقة

256
00:18:04,740 --> 00:18:09,900
،ذهبتُ لشراء تذاكر وحدي
.لكنّها كانت قد اختفت عندما عدت

257
00:18:09,900 --> 00:18:13,550
!ماذا؟ لا تتركها وحدها وهي لا تعرف المكان

258
00:18:13,550 --> 00:18:15,130
.توقّف يا سولون

259
00:18:15,670 --> 00:18:19,300
.لم يتوقّع أيّ أحد أن يظهر هؤلاء هنا

260
00:18:22,180 --> 00:18:24,660
ماذا؟ هل قال ذلك بالفعل؟

261
00:18:24,660 --> 00:18:26,130
.نعم

262
00:18:26,660 --> 00:18:28,200
ما الّذي يحدث؟

263
00:18:28,750 --> 00:18:33,740
يجدر بهم أن يعرفوا أنّ تعرّضهم
.للشّمس سيدمّرهم في الحال

264
00:18:33,740 --> 00:18:40,180
صحيح. على عكسنا نحن، لا يجدر بهم
.أن يستطيعوا التّحرّك إلاّ بعد حلول الظّلام

265
00:18:40,540 --> 00:18:42,100
لماذا كانوا يائسين لهذه الدّرجة؟

266
00:18:42,350 --> 00:18:43,570
...بل الأهمّ من ذلك

267
00:18:52,380 --> 00:18:54,310
.لم تكن هذه مجرّد مصادفة

268
00:18:55,730 --> 00:18:57,910
.كانوا يستهدفون سوها

269
00:19:02,740 --> 00:19:05,240
مـ-مهلاً، هل أنت بخير؟

270
00:19:05,480 --> 00:19:06,720
.أنا آسف

271
00:19:06,720 --> 00:19:08,550
.أنا بخير الآن

272
00:19:08,940 --> 00:19:12,360
أشعر بالدّوار فقط
.لأنّي لم أجرّب ذلك من قبل

273
00:19:12,360 --> 00:19:13,990
.أنا فعلاً آسف

274
00:19:13,990 --> 00:19:16,150
.كنتُ أفكّر في إنقاذك فقط

275
00:19:16,850 --> 00:19:18,210
هل أحملك على ظهري؟

276
00:19:18,620 --> 00:19:19,630
.أنا بخير

277
00:19:19,630 --> 00:19:22,420
.سأشعر بتحسّن بعد أن أرتاح قليلاً

278
00:19:24,730 --> 00:19:25,730
...لكن

279
00:19:27,590 --> 00:19:28,890
.شكرًا لك

280
00:19:31,450 --> 00:19:33,290
.أنقذتني في السّابق أيضًا

281
00:19:33,810 --> 00:19:35,900
.تأتي لنجدتي دائمًا

282
00:19:35,900 --> 00:19:37,690
.أ-أكيد

283
00:19:38,410 --> 00:19:41,150
.أنا مسرور لأنّي جئت في الوقت المناسب

284
00:19:41,150 --> 00:19:43,930
على أيّ حال، كيف عرفت بشأن اليوم؟

285
00:19:44,610 --> 00:19:47,380
—أتيت بالضّبط للمكان الّذي كنتُ

286
00:19:47,380 --> 00:19:49,690
...إ-إنّ ذلك

287
00:19:51,400 --> 00:19:53,740
...لستُ واثقًا من أين أبدأ

288
00:20:07,130 --> 00:20:08,070
...أيُعقل

289
00:20:09,810 --> 00:20:10,910
كريس؟

290
00:20:12,750 --> 00:20:17,460
،لا بأس. مهما قاله الآخرون
.فسأصدّقك دائمًا

291
00:20:17,850 --> 00:20:22,740
...ظننتُ أنّنا سنظلّ معًا للأبد، لكن

292
00:21:02,590 --> 00:21:06,450
.أخذ مصّاصو الدّماء كريس منّي

293
00:21:34,020 --> 00:21:34,780
.سوها

294
00:21:36,220 --> 00:21:37,900
سوها، أيمكنك سماعي؟

295
00:21:40,940 --> 00:21:41,860
.سوها

296
00:23:34,020 --> 00:23:36,260
:في الحلقة الرّابعة القادمة

297
00:23:36,260 --> 00:23:39,530
."قمر الدّماء: ليلة الخسوف الكامل"