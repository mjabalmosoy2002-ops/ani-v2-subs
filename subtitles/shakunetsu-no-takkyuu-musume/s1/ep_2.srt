1
00:00:15,540 --> 00:00:17,250
...نصف نهائي المحافظة

2
00:00:18,280 --> 00:00:20,120
!صـ-صباح الخير

3
00:00:20,500 --> 00:00:23,320
!كـ-كاميا-سان! صباح الخير

4
00:00:23,320 --> 00:00:25,030
صـ-صباح النّور

5
00:00:25,820 --> 00:00:27,630
أتيتِ إلى هنا باكراً مجدّداً

6
00:00:28,280 --> 00:00:30,140
آتي قبل الجميع دائماً

7
00:00:30,140 --> 00:00:33,060
كلّما أتيتُ باكراً، تمرّنتُ أكثر

8
00:00:33,060 --> 00:00:35,950
،خطرت على بالي نفس الفكرة واستيقظتُ باكراً

9
00:00:35,950 --> 00:00:38,440
لكن تهتُ في الطريق لمدّة 30 دقيقة

10
00:00:38,440 --> 00:00:39,830
‏30 دقيقة؟

11
00:00:39,830 --> 00:00:42,600
لكن كانت ساعة البارحة

12
00:00:42,600 --> 00:00:45,010
...سأكون بخير غداً

13
00:00:46,050 --> 00:00:46,690
صحيح؟

14
00:00:46,690 --> 00:00:48,560
لا تسأليني

15
00:00:48,560 --> 00:00:51,420
صباح الخير. أتيتُما إلى هنا باكراً

16
00:00:51,420 --> 00:00:52,530
صباح الخير

17
00:00:53,850 --> 00:00:55,730
!صباح الخير

18
00:00:55,730 --> 00:00:57,770
اذهبي وقومي بالإحماء أوّلاً

19
00:00:57,770 --> 00:01:00,050
حالما يصل الجميع إلى هنا، سنذهب للركض

20
00:01:00,050 --> 00:01:00,690
عُلِم

21
00:01:03,050 --> 00:01:05,720
لنذهب ونبدّل ملابسنا يا كويوري-تشان

22
00:01:05,720 --> 00:01:06,890
نـ-نعم

23
00:01:11,500 --> 00:01:13,380
‏30 دقيقة؟

24
00:01:14,070 --> 00:01:16,100
هل وصلَتْ لربع النّهائي حقّاً؟

25
00:02:54,770 --> 00:02:56,450
!سوزوميغاهارا

26
00:02:56,450 --> 00:03:05,630
!كفاح! كفاح

27
00:03:00,700 --> 00:03:01,790
!سوزوميغاهارا

28
00:03:00,700 --> 00:03:03,960
هل سيلعب كويوري-سينباي المباريات مجدّداً اليوم؟

29
00:03:03,960 --> 00:03:07,080
ربّما. هنالك ثلاث لاعبات أعلى منها الآن

30
00:03:07,500 --> 00:03:11,580
إذاً سيتوجّب عليها مواجهة هوكوتو-سينباي
أولاً ثمّ هانابي-سينباي

31
00:03:11,580 --> 00:03:14,410
ما مدى براعة كويوري-سينباي يا تُرى؟

32
00:03:17,340 --> 00:03:20,660
الثرثرة ممنوعة أثناء الرّكض

33
00:03:20,660 --> 00:03:22,090
!نحن آسفات

34
00:03:24,830 --> 00:03:27,540
هل أنتِ بخير يا كويوري-تشان؟

35
00:03:27,540 --> 00:03:28,310
!أجل

36
00:03:29,140 --> 00:03:30,900
...أ-أنا آسفة

37
00:03:31,880 --> 00:03:33,650
اركضي على قدرِ استطاعتك، مفهوم؟

38
00:03:36,110 --> 00:03:39,090
ما الأمر يا جديلة؟ هل تعبتِ من الآن؟

39
00:03:39,090 --> 00:03:41,660
ألا يمكنها تحمُّل الرّكض؟

40
00:03:42,650 --> 00:03:46,780
هذا الجانب مختلفٌ فيها تماماً مُقارنة
بأدائها في لعبة كرة الطاولة

41
00:03:46,780 --> 00:03:48,570
يا لها من صبيّة مسلّية

42
00:03:51,540 --> 00:03:54,760
!أظنّكِ أفضل على ما أعتقد يا هوكوتو

43
00:03:54,760 --> 00:03:56,250
لا تعصريني

44
00:03:57,160 --> 00:03:59,460
لكن شكراً

45
00:04:05,460 --> 00:04:08,390
!حان وقتُ استراحة الغداء! لنأكل

46
00:04:09,390 --> 00:04:12,690
انتظرا، سأذهب لإحضار هوكوتو

47
00:04:17,380 --> 00:04:18,570
!آ-آسفة

48
00:04:18,570 --> 00:04:21,950
حالما أدركتُ أنّ الغداء قد حان أخيراً، لم أستطع إيقافها

49
00:04:22,460 --> 00:04:23,990
لا تقلقي

50
00:04:23,990 --> 00:04:25,990
أعني أنّها كانت تصدر صوتاً طوال الصّباح

51
00:04:25,990 --> 00:04:26,990
أسمعتِ ذلك؟

52
00:04:27,390 --> 00:04:29,700
كان الصوت مرتفعاً جدّاً، سأكون صمّاء
إذا لم أستطع سماعها

53
00:04:31,480 --> 00:04:32,750
!لا داعي للإحراج من ذلك

54
00:04:32,750 --> 00:04:35,420
هذا يُثبِت مقدار الجهد الذي بذلتِه
في تمرين هذا الصّباح

55
00:04:35,870 --> 00:04:38,130
يمكنُ سماعه في صفّي حتّى

56
00:04:38,130 --> 00:04:39,870
إتسومو-سان؟

57
00:04:39,870 --> 00:04:42,830
كلّ زميلاتي في الصفّ وسينسي اعتقدوه
رعداً في بادئ الأمر

58
00:04:42,830 --> 00:04:44,230
ونظروا إلى السّماء

59
00:04:46,060 --> 00:04:47,140
تمزحين، صحيح؟

60
00:04:47,140 --> 00:04:48,140
أجل

61
00:04:49,660 --> 00:04:51,600
!أيّتها اللّعوبة هوكوتو

62
00:04:55,380 --> 00:04:58,420
لن أنهزم بسهولة مثل خيط-سينباي

63
00:04:58,420 --> 00:04:59,400
ماذا؟

64
00:04:59,400 --> 00:05:01,580
لا بدّ وأنّها تتكلّم عن مُباراة التّصنيف

65
00:05:01,580 --> 00:05:03,490
ستُلاعبين هوكوتو اليوم، صحيح؟

66
00:05:03,490 --> 00:05:05,230
أ-أجل

67
00:05:05,910 --> 00:05:06,950
خيط؟

68
00:05:07,880 --> 00:05:09,910
تقصدُ مونيموني-سينباي

69
00:05:09,910 --> 00:05:14,460
تستطيع هوكوتو تحليل النّاس بالنظر إلى مطّاط مضربهم

70
00:05:14,460 --> 00:05:16,360
مثل تحليل شخصيّتهم وأفضل حركاتهم

71
00:05:17,170 --> 00:05:19,130
أستطيع تحديد اللّباس الداخلي الذي يرتدونه أيضاً

72
00:05:19,130 --> 00:05:20,590
حـ-حقّاً؟

73
00:05:21,080 --> 00:05:22,050
حقّاً

74
00:05:24,450 --> 00:05:25,510
حقّاً

75
00:05:25,910 --> 00:05:31,090
أمعنتُ النّظر في أسلوب لعبكِ أثناء مباراتكِ
ضدّ خيط-سينباي

76
00:05:31,740 --> 00:05:34,980
دعيني أقول لكِ أنّني لستُ مثلها

77
00:05:37,250 --> 00:05:39,010
خيط؟

78
00:05:39,010 --> 00:05:40,210
!خيط؟

79
00:05:40,730 --> 00:05:42,820
!خيط، خيط! هذا يكفي

80
00:05:43,070 --> 00:05:45,650
لنأكل بسرعة

81
00:05:45,650 --> 00:05:47,360
!لنأكل

82
00:05:51,230 --> 00:05:52,660
أعطيني هذه

83
00:05:53,140 --> 00:05:54,530
آ-آسفة

84
00:05:54,530 --> 00:05:56,060
تبّاً، لا بأس

85
00:06:02,540 --> 00:06:06,250
كويوري-سينباي تواجه المركز الثّالث هوكوتو-سينباي اليوم

86
00:06:06,250 --> 00:06:09,010
من سيربح؟ هل ستتغيّر التصنيفات مجدّداً؟

87
00:06:09,450 --> 00:06:11,510
!لا تخسري يا هوكوتو

88
00:06:11,510 --> 00:06:14,100
في هذه المدرسة، مهارات هوكوتو لا يُعلى عليها

89
00:06:14,100 --> 00:06:17,310
إذا تحدّثنا من النّاحية التقنيّة، فهي أفضل بكثير
من مونيموني-سينباي

90
00:06:17,310 --> 00:06:18,890
تحتاجين لأكثر من مجرّد حظّ لهزيمتها

91
00:06:23,150 --> 00:06:25,030
هل يمكنني أن أرسل أوّلاً؟

92
00:06:25,030 --> 00:06:25,780
أكيد

93
00:06:27,800 --> 00:06:28,660
...ورديّ

94
00:06:29,800 --> 00:06:31,260
لِباس داخلي خوخي؟

95
00:06:35,640 --> 00:06:37,120
صفر-كل

96
00:06:41,820 --> 00:06:43,040
أعادَتْها كويوري-سينباي

97
00:06:45,150 --> 00:06:46,340
!لكنّها أعيدَتْ إليها

98
00:06:46,340 --> 00:06:49,660
لم تقم جديلة بإعادتها. إنّما دُفِعَتْ لإعادتها

99
00:06:49,660 --> 00:06:50,590
ماذا؟

100
00:06:54,530 --> 00:06:57,790
تستطيعُ هوكوتو أن تدفع خصومها لضرب
الكُرة إلى حيث تشاء هي

101
00:06:58,790 --> 00:07:00,850
لكن إلى حدّ معيّن فقط

102
00:07:00,850 --> 00:07:02,290
!هذا مذهل رغم ذلك

103
00:07:06,840 --> 00:07:09,460
من هناك، تحدُّ من خياراتها

104
00:07:09,460 --> 00:07:11,780
لاختيار الرّمية التي يُرجَّح أن تجعل خصمها يخطئ

105
00:07:17,490 --> 00:07:18,730
،دون أن تشعري

106
00:07:18,730 --> 00:07:22,170
حازت هوكوتو على الزخم كلّه

107
00:07:24,220 --> 00:07:26,500
!جميل يا هوكوتو! هذا هو اللّعب

108
00:07:31,400 --> 00:07:33,800
لن أدعكِ تشقّين طريقكِ إلى هناك

109
00:07:43,060 --> 00:07:44,610
هذه مباراة من جانب واحد

110
00:07:44,610 --> 00:07:46,590
!هوكوتو-سينباي بارعة جدّاً

111
00:07:46,590 --> 00:07:47,960
صحيح؟

112
00:07:49,990 --> 00:07:53,890
تكتيكات هوكوتو تنهكها أيضاً

113
00:07:54,790 --> 00:07:55,490
...لكن

114
00:07:59,480 --> 00:08:02,130
ستكون تسوموجيكازي-سان أوّل من تنفذ طاقتها

115
00:08:02,570 --> 00:08:04,670
يضع أسلوب لعبها ذلك في الحسبان

116
00:08:05,530 --> 00:08:06,620
!سوزومي

117
00:08:06,620 --> 00:08:11,110
!كفاح

118
00:08:07,090 --> 00:08:09,580
!نعم

119
00:08:09,580 --> 00:08:10,510
!سوزومي

120
00:08:11,110 --> 00:08:13,610
!نعم

121
00:08:11,580 --> 00:08:12,980
!كفاح

122
00:08:13,610 --> 00:08:14,660
!سوزومي

123
00:08:14,660 --> 00:08:16,460
،الرّكض صعب

124
00:08:18,790 --> 00:08:20,880
،والاستيقاظ باكراً مزعج

125
00:08:20,880 --> 00:08:22,810
والتّمرين مُنهِك

126
00:08:23,370 --> 00:08:24,270
أرسِلي

127
00:08:24,270 --> 00:08:27,780
لكن، نعم، كرة الطاولة ممتعة حقّاً

128
00:08:32,130 --> 00:08:33,830
لماذا تبتسم؟

129
00:08:37,720 --> 00:08:39,330
تبّاً. هذا ليس جيّداً

130
00:08:47,090 --> 00:08:47,960
ماذا؟

131
00:08:52,220 --> 00:08:53,920
ما رأيكِ بهذه إذاً؟

132
00:08:59,250 --> 00:09:01,310
لماذا تبتسمين؟

133
00:09:09,150 --> 00:09:10,360
تتبادلان الضربات

134
00:09:10,360 --> 00:09:11,400
وبعنف شديد

135
00:09:13,030 --> 00:09:14,220
ما الخطب؟

136
00:09:14,220 --> 00:09:17,480
تتصرّف هوكوتو بشكل مختلف بعض الشيء

137
00:09:19,170 --> 00:09:20,230
صحيح

138
00:09:20,230 --> 00:09:23,540
أنا متأكّدةٌ أنّها لا تحبُّ فترة تبادل الضربات الطويلة

139
00:09:33,620 --> 00:09:36,490
أسلوب لعبها أشدّ من السّابق

140
00:09:37,000 --> 00:09:40,430
!لكن تماسكي يا هوكوتو

141
00:09:40,430 --> 00:09:42,850
ما الذي ترينه ممتعاً؟

142
00:09:44,810 --> 00:09:47,060
بدأت هوكوتو تضرب عدداً أكبر من الضربات السّاحقة

143
00:09:47,580 --> 00:09:52,530
لكن عادة ما يتجنّب أسلوب لعبها القوّةَ التي تؤدّي
إلى ارتكاب أخطاء فيما يتعلّق بدقّة تموضُع الكرة

144
00:09:56,200 --> 00:09:58,420
إلى متى ستستمرُّ فترة تبادُل الضربات هذه؟

145
00:09:58,420 --> 00:10:00,700
كلتاهما مذهلتان

146
00:10:02,920 --> 00:10:03,830
!تبّاً

147
00:10:07,750 --> 00:10:09,030
دائريّة عالية؟

148
00:10:09,030 --> 00:10:10,810
!هذه فرصتكِ يا هوكوتو-سينباي

149
00:10:25,500 --> 00:10:26,060
!هوكوتو

150
00:10:34,740 --> 00:10:36,580
!ربحت كويوري-سينباي في فترة تبادُل الضربات

151
00:10:49,090 --> 00:10:52,020
لا تقلقي يا هوكوتو. ما زلتِ متقدّمة بفارق كبير

152
00:10:53,010 --> 00:10:54,920
معكِ حقّ يا هانابي

153
00:10:58,280 --> 00:10:59,080
أرسِلي

154
00:11:08,360 --> 00:11:10,130
شكراً على هذه المباراة الرّائعة

155
00:11:10,580 --> 00:11:12,650
مؤسف يا هوكوتو

156
00:11:12,650 --> 00:11:13,980
!لكنّكِ قاومتِ على نحوٍ رائع

157
00:11:14,980 --> 00:11:17,210
ارتكبتُ أخطاءً كثيرة في النصف الثاني

158
00:11:17,800 --> 00:11:19,950
عليّ أن أتمرّن أكثر

159
00:11:19,950 --> 00:11:22,340
!نعم! لنفعل ما بوسعنا معاً

160
00:11:22,340 --> 00:11:24,260
ابتعدي عنّي. أنا متعرّقة بما يكفي

161
00:11:24,260 --> 00:11:26,330
!يا لكِ من باردة المشاعر

162
00:11:28,250 --> 00:11:29,040
إتسومو-سان

163
00:11:30,490 --> 00:11:32,460
كـ-كان ذلك ممتعاً للغاية

164
00:11:32,460 --> 00:11:33,750
!شكراً لأنّكِ لعبتِ معي

165
00:11:34,510 --> 00:11:35,750
!شكراً جزيلاً لكِ

166
00:11:36,830 --> 00:11:39,420
على الرّحب يا لِباس داخلي خوخي-سان

167
00:11:40,210 --> 00:11:42,270
خوخي؟ لِباس داخلي خوخي؟

168
00:11:42,270 --> 00:11:44,460
كويوري-سينباي ترتدي لِباس داخلي خوخي؟

169
00:11:46,670 --> 00:11:47,860
!خوخ

170
00:11:47,860 --> 00:11:48,970
!هذا ظريف جدّاً

171
00:11:48,970 --> 00:11:50,350
!لِباس داخلي خوخي

172
00:11:53,330 --> 00:11:55,280
...تسوموجيكازي كويوري

173
00:11:55,280 --> 00:11:57,230
يا لها من فتاة غامضة

174
00:11:59,100 --> 00:12:01,170
كان أسلوب لعبكِ مختلفاً عن المعتاد

175
00:12:01,170 --> 00:12:02,280
ماذا حدث؟

176
00:12:04,130 --> 00:12:07,510
أظنّكِ ستفهمين حالما تلعبين معها فعليّاً

177
00:12:45,620 --> 00:12:47,770
!كـ-كاميا-سان! صباح الخير

178
00:12:48,650 --> 00:12:49,720
...صباح النُّور

179
00:12:50,260 --> 00:12:52,290
لم تضيعي اليوم، أليس كذلك؟

180
00:12:57,250 --> 00:12:59,280
كـ-كاميا-سان

181
00:12:59,280 --> 00:13:01,710
ريثما تصلُ الأُخريات، ما رأيكِ أن تتمرّني معي قليلاً؟

182
00:13:05,650 --> 00:13:10,260
أ... أريدُ أن ألعب معكِ

183
00:13:12,010 --> 00:13:16,280
آ-آسفة، لكن أريدُ أن أعمل على تحسين
تلويحتي اليوم

184
00:13:16,750 --> 00:13:18,450
...يمكننا العمل على ذلك معاً إذاً

185
00:13:32,040 --> 00:13:33,750
!حانت استراحة الغداء

186
00:13:33,750 --> 00:13:36,080
!سأذهبُ لإحضار هوكوتو

187
00:13:40,200 --> 00:13:43,540
سأتناول خبزاً على الغداء اليوم، لهذا سآكُل
في المقصف المدرسي

188
00:13:43,540 --> 00:13:44,900
كاميا-سان؟

189
00:13:44,900 --> 00:13:46,300
لا تنتظرنَني

190
00:13:46,300 --> 00:13:47,570
كُلن أنتنّ الثلاثة

191
00:13:55,910 --> 00:13:58,890
وجوري مغنّية جيّدة جدّاً

192
00:13:58,890 --> 00:14:00,810
!ماذا؟ أشعر بالغيرة الشديدة

193
00:14:04,780 --> 00:14:07,210
ماذا أفعل؟

194
00:14:18,510 --> 00:14:20,220
المعذرة

195
00:14:20,220 --> 00:14:21,540
ألستِ من الصّحيفة المدرسيّة؟

196
00:14:21,940 --> 00:14:24,770
ظننتُكِ أنهيتِ مقالتكِ حول أغاري-تشان

197
00:14:24,770 --> 00:14:26,940
المقابلة، أجل

198
00:14:27,480 --> 00:14:29,390
...لكن كانت الصّور

199
00:14:29,390 --> 00:14:31,610
حسناً، أودّ التقاط المزيد

200
00:14:31,610 --> 00:14:32,980
أين كاميا-سان؟

201
00:14:33,510 --> 00:14:35,020
تتمرّن بمفردها

202
00:14:35,560 --> 00:14:37,980
قالَتْ أنّها تريد الرّكض ثمّ غادرَتْ

203
00:14:38,300 --> 00:14:39,630
حسناً

204
00:14:42,730 --> 00:14:44,360
!فوز آخر لهانابي-سينباي

205
00:14:44,690 --> 00:14:47,030
هل رأيتُن ذلك؟ هذا جنون

206
00:14:47,450 --> 00:14:50,550
إنّها لاعبة كُرات درايف مرتدّة بقبضة القلم مثاليّة

207
00:14:50,550 --> 00:14:54,040
ببقائها قريبة من الطّاولة، تعيدُ كُرات الخصم
...بسُرعة على طريقة درايف

208
00:14:54,040 --> 00:14:56,290
لاعِبة هجوميّة بامتياز

209
00:14:56,290 --> 00:14:59,660
يحوّل أسلوبُ لعبها كافّة تبادُلات ضرب الكُرة
إلى مُواجهات قويّة بشكلٍ حتميّ

210
00:15:00,290 --> 00:15:03,590
إيقاف سرعة ضرباتها ليست مهمّة يسيرة

211
00:15:09,560 --> 00:15:11,130
هوكو هوكو

212
00:15:15,510 --> 00:15:17,890
رائع، هذا مذهل

213
00:15:17,890 --> 00:15:20,100
لم أرَ سرعةً كهذه من قبل

214
00:15:20,520 --> 00:15:23,100
كم سرعة كُرات الدرايف خاصّتها بالضبط؟

215
00:15:26,110 --> 00:15:28,350
!جديلة

216
00:15:30,780 --> 00:15:32,810
هل تِلك هي الفتاة التي رأيناها قبل البارحة؟

217
00:15:32,810 --> 00:15:34,340
هل كانَتْ كذلك دوماً؟

218
00:15:35,510 --> 00:15:39,500
نعم، تتحوّل كويوري-تشان إلى شخص مختلف
عندما تلعبُ كرة الطاولة

219
00:15:41,390 --> 00:15:44,540
المذهل فيها هو أنّه سواء أكنتُ أنا أو هوكوتو-تشان
...أو هانابي-تشان

220
00:15:44,540 --> 00:15:47,340
تستطيعُ مُجاراة أي خصم مهما كانَ أسلوب لعبه

221
00:15:47,340 --> 00:15:50,300
!وما يُدهش أكثر هو ابتسامتها تلك

222
00:15:54,230 --> 00:15:56,180
...تـ-تِلك

223
00:15:56,780 --> 00:15:58,890
!كانَتْ سريعة للغاية

224
00:16:00,690 --> 00:16:02,690
!أ-أنتِ رائعة يا هانا-تشان

225
00:16:03,300 --> 00:16:04,100
!أنا كذلك بالتأكيد

226
00:16:04,100 --> 00:16:06,560
!لم تري شيئاً بعد يا جديلة

227
00:16:06,560 --> 00:16:07,770
!نعم

228
00:16:08,510 --> 00:16:10,340
!افعلي ما بوسعكِ يا كويوري-سينباي

229
00:16:10,340 --> 00:16:11,990
!هانابي-سينباي أيضاً

230
00:16:12,530 --> 00:16:14,450
هل أصبحتُ أقلّ أهمّية الآن؟

231
00:16:17,230 --> 00:16:18,860
بقيتُ في الخارج حتّى وقت متأخّر

232
00:16:18,860 --> 00:16:21,160
أتساءل ما إن كان الجميع قلقين عليّ

233
00:16:29,330 --> 00:16:31,340
!كويوري-سينباي ربِحَتْ

234
00:16:31,340 --> 00:16:32,260
!إنّها مذهلة

235
00:16:33,690 --> 00:16:36,640
!أنتِ رائعة يا جديلة، تبّاً لكِ

236
00:16:36,640 --> 00:16:38,820
!أنتِ مدهشة يا كويوري-سينباي

237
00:16:38,820 --> 00:16:40,530
!قوّة غير قابلة للتصدّي

238
00:16:40,530 --> 00:16:42,600
!أنتِ بطلتُنا الجديدة

239
00:16:42,940 --> 00:16:45,080
!النّجمة التي ترتقي لآمال فريقنا

240
00:17:00,700 --> 00:17:03,320
كويوري-سينباي، العبي معي

241
00:17:03,320 --> 00:17:04,870
أنتِ رائعةٌ جدّاً يا بطلة الفريق

242
00:17:06,210 --> 00:17:07,130
...انتظرن

243
00:17:07,130 --> 00:17:10,120
...أنا... أنا

244
00:17:22,620 --> 00:17:23,610
كويوري-سينباي

245
00:17:23,610 --> 00:17:24,390
سينباي

246
00:17:24,390 --> 00:17:25,570
!سينباي

247
00:17:28,310 --> 00:17:29,170
...أيّتها

248
00:17:31,230 --> 00:17:33,250
!أيّتها... الحقيرات

249
00:17:33,730 --> 00:17:34,680
!كلّكن حقيرات

250
00:17:43,470 --> 00:17:45,620
ما خطبُ أغاري؟

251
00:17:46,100 --> 00:17:49,580
سينباي، ساعديني بعد التّمرين اليوم رجاء

252
00:17:52,920 --> 00:17:56,230
كنّا لنتمرّن بسرور معها لو طلبَتْ ذلك

253
00:17:57,000 --> 00:17:58,750
قد تكون غلطتي

254
00:18:00,040 --> 00:18:04,220
أشعرُ وكأنّ كاميا-سان تتجنّبني اليوم

255
00:18:04,220 --> 00:18:06,600
لأنّني خرقاء

256
00:18:12,430 --> 00:18:14,860
!واثقة أنّها غاضبة منّي كثيراً

257
00:18:15,380 --> 00:18:16,630
مستحيل

258
00:18:16,630 --> 00:18:17,950
!نعم، مستحيل

259
00:18:18,820 --> 00:18:22,180
،ذوات اللّباس الأبيض مُرهِقات كثيراً بلا شكّ

260
00:18:22,180 --> 00:18:24,120
لكن لا يمكن أن تغضب لسببٍ كهذا

261
00:18:24,120 --> 00:18:25,290
!مُحال

262
00:18:25,860 --> 00:18:29,310
!قد تكون شائكة من الخارج، لكنّها فتاة لطيفة من الدّاخل

263
00:18:29,310 --> 00:18:32,290
ساعدَتْكِ كثيراً في الأيّام الثلاثة الماضية، صحيح؟

264
00:18:34,030 --> 00:18:34,800
أجل

265
00:18:34,800 --> 00:18:36,090
واثقة أنّها الآن

266
00:18:36,090 --> 00:18:39,570
تتمرّن على حركةٍ خاصّة تحضيراً
لمُباراة الغد معكِ

267
00:18:39,570 --> 00:18:42,260
فهي بطلةُ فريقنا

268
00:18:45,210 --> 00:18:47,940
!حسناً! عليكِ أن تأكلي أيضاً

269
00:18:48,730 --> 00:18:51,050
!تفضّلي، تناولي هذه يا جديلة

270
00:18:51,050 --> 00:18:52,910
نعم، شكراً

271
00:18:52,910 --> 00:18:56,440
هانابي، اشتريتُ هذه

272
00:19:00,660 --> 00:19:02,480
قولي لي يا هوكوتو

273
00:19:02,480 --> 00:19:07,410
ألا يجعل اللّعب مع جديلة شيئاً ينفجرُ في داخلك؟

274
00:19:07,740 --> 00:19:09,050
أي شيء؟

275
00:19:09,050 --> 00:19:12,500
أعني أنّه يحمّسكِ على سبيلِ المثال

276
00:19:12,500 --> 00:19:14,420
ألم يحدث لكِ هذا؟

277
00:19:15,750 --> 00:19:16,340
لقد حدَث

278
00:19:16,670 --> 00:19:18,640
!توقّعت

279
00:19:18,640 --> 00:19:20,450
أتساءلُ كيف هو الشّعور؟

280
00:19:20,900 --> 00:19:21,840
عجباً

281
00:19:22,390 --> 00:19:23,940
يا لها من فتاة غريبة

282
00:19:25,580 --> 00:19:29,240
...مونيموني-سينباي، إتسومو-سان، وهانا-تشان

283
00:19:29,240 --> 00:19:31,220
كان اللّعب معهن ممتعاً

284
00:19:32,020 --> 00:19:35,330
لكن ذلك الإحساس عندما لعبتُ ضدّ كاميا-سان
كان مختلفاً تماماً

285
00:19:35,330 --> 00:19:36,770
ماذا كان بالضبط؟

286
00:19:40,230 --> 00:19:42,990
آمل أن أكتشف غداً

287
00:19:52,410 --> 00:19:53,450
أغاري-تشان

288
00:19:53,450 --> 00:19:56,510
ألن تتمرّني على الضربة السّاحقة
براحة اليد؟

289
00:19:57,010 --> 00:19:58,350
لماذا تسألين؟

290
00:19:58,350 --> 00:20:00,720
لأنّكِ كنتِ تركّزين فقط على ظاهر اليد

291
00:20:03,140 --> 00:20:06,210
لم أعُد ألعبُ براحة يدي منذُ فترة طويلة

292
00:20:06,940 --> 00:20:08,720
فهي لا تؤدّي إلى انتصارات كافية

293
00:20:09,420 --> 00:20:12,630
بالتأكيد، قد تولّد راحة اليد قوّة أكبر

294
00:20:12,630 --> 00:20:14,200
لكن هذا لا يعني شيئاً إن لم يكن فعّالاً

295
00:20:14,810 --> 00:20:18,730
من الأكثر كفاءة أن أحسّن اللّعب بظاهر يدي
والتي تُعَدُّ أكثر حسماً

296
00:20:18,980 --> 00:20:22,530
لكن كنتِ تستمتعين كثيراً عندما لعبتِ براحة يدكِ

297
00:20:22,530 --> 00:20:24,550
هـ-هذا لا يهمّ

298
00:20:25,730 --> 00:20:27,240
سأفعلُ ما يلزم للفوز

299
00:20:27,240 --> 00:20:28,830
...أغاري-تشان

300
00:20:29,260 --> 00:20:31,280
تبدين تواجهين وقتاً عصيباً، هل أنتِ بخير؟

301
00:20:31,280 --> 00:20:32,780
هل أنتِ متأكّدة أنّكِ لا تتعرّضين لضغوط؟

302
00:20:32,780 --> 00:20:33,900
!أنا بخير

303
00:20:42,450 --> 00:20:46,050
هل تستمتعين بكُرة الطاولة الآن يا أغاري-تشان؟

304
00:20:49,950 --> 00:20:56,060
أعلمُ أنّكِ أوّل من يتمرّن دوماً

305
00:20:57,090 --> 00:21:01,500
أعلمُ أنّكِ كنتِ أكثر تفانٍ وإخلاص في العمل
من أي شخص آخر

306
00:21:01,800 --> 00:21:04,740
وهذا دليلٌ على أنّكِ فعلتِ ذلك، صحيح؟

307
00:21:05,260 --> 00:21:07,450
الاجتهاد في العملِ لن يخذلكِ

308
00:21:07,450 --> 00:21:10,700
لِذا لا تتألّمي كثيراً من فضلك

309
00:21:12,750 --> 00:21:13,880
سينباي

310
00:21:15,530 --> 00:21:17,290
صدركِ ساخن جدّاً ومليء

311
00:21:17,290 --> 00:21:19,950
!ليس ساخناً ولا مليئاً

312
00:21:19,950 --> 00:21:20,760
تبّاً

313
00:21:20,760 --> 00:21:23,450
وأنا التي كنتُ ألعب دور اللّاعبة اللّطيفة الأقدم لأجلكِ

314
00:21:24,290 --> 00:21:26,020
معكِ حقّ

315
00:21:27,230 --> 00:21:30,490
تمرّنتُ أكثر من أي شخص آخر في الفريق

316
00:21:31,480 --> 00:21:33,930
وفعلتُ كلّ هذا لأجعل ذلك المركز ملكي

317
00:21:34,390 --> 00:21:36,120
أنا البطلة

318
00:21:36,120 --> 00:21:38,690
لن أتنازل عن ذلك المركز لأي أحد

319
00:21:39,230 --> 00:21:40,270
أغاري-تشان

320
00:21:51,780 --> 00:21:54,750
لم تبقَ إلّا أغاري-سينباي الآن

321
00:21:55,460 --> 00:21:57,660
هل ستلعبان اليوم؟

322
00:22:06,570 --> 00:22:07,470
تسوموجيكازي-سان

323
00:22:07,470 --> 00:22:08,340
نـ-نعم؟

324
00:22:10,430 --> 00:22:12,450
العبي معي

325
00:23:45,080 --> 00:23:46,980
!الأولى

326
00:23:45,860 --> 00:23:46,980
...عاديّة

327
00:23:46,980 --> 00:23:49,060
!أنتِ رائعة يا أغاري-تشان

328
00:23:47,940 --> 00:23:49,820
من أفضل؟

329
00:23:49,370 --> 00:23:51,110
كويوري-سينباي؟

330
00:23:49,820 --> 00:23:51,770
ستكونُ كويوري-سينباي

331
00:23:51,110 --> 00:23:53,360
أتطلّعُ قُدماً لهذا

332
00:23:52,320 --> 00:23:53,360
!سأسحقُكِ

333
00:23:53,360 --> 00:23:57,750
تعجبني كُرة الطاولة لأنّها تجعلني أرى
وجه خصمي يتصبّبُ عرقاً عن كثب