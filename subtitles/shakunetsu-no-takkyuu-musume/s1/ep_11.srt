1
00:00:32,420 --> 00:00:33,670
مجرّد حلم؟

2
00:00:37,420 --> 00:00:39,230
،أثناء المباراة التمرينيّة الأخيرة

3
00:00:39,650 --> 00:00:43,560
تمكّنتُ من هزيمةِ زاكورو-سان، لاعبة على مستوى وطني

4
00:00:44,080 --> 00:00:48,270
لكن كانَتْ بعيدة كلّ البعد عن مباراة مثاليّة

5
00:00:48,870 --> 00:00:52,770
بصراحة لا أدري ما إن كنتُ سأستطيع الفوز إذا لاعبتُها مجدّداً

6
00:00:54,650 --> 00:00:59,380
عليّ أن أصحّح كلّ الأخطاء
مع انتهاء معسكر التدريب

7
00:01:01,560 --> 00:01:05,800
إن لم أفعل فسأتدمّرَ على المستوى الوطني

8
00:02:46,140 --> 00:02:48,140
الجميع هنا؟

9
00:02:48,140 --> 00:02:50,060
!أجل

10
00:02:50,060 --> 00:02:51,980
هل تأكّدتُنّ من أنّكن لم تنسين شيئاً؟

11
00:02:51,980 --> 00:02:53,310
!أجل

12
00:02:53,310 --> 00:02:56,090
طالبات السنة الأولى متحمّسات للغايةِ اليوم

13
00:02:56,090 --> 00:02:58,620
لنرَ ما إن كنّ سيبقين متحمّسات حالما نصلُ إلى هناك

14
00:02:59,300 --> 00:03:01,730
هل هنالك خطب ما في المُعسكر؟

15
00:03:01,730 --> 00:03:05,060
إنّها زيارتكِ الأولى له يا جديلة

16
00:03:05,060 --> 00:03:06,820
سترين حالما نصلُ إلى هناك

17
00:03:06,820 --> 00:03:09,160
لن نفعل شيئاً خلال خمسة أيّام سوى لعِب كرة الطاولة

18
00:03:09,750 --> 00:03:12,120
!خمسة أيّام من لعِب كُرة الطاولة

19
00:03:13,460 --> 00:03:17,210
!اللّعنة، أراكُن هنا! كنتُ أبحثُ عنكن جميعاً

20
00:03:23,790 --> 00:03:26,430
صدّقنَني، بحثتُ عنكن في كلّ مكان

21
00:03:27,930 --> 00:03:30,390
كومامي...؟

22
00:03:30,890 --> 00:03:33,450
!إنّها كومامين

23
00:03:33,450 --> 00:03:36,140
لم أركِ منذ وقت طويل يا لِباس داخلي مُكشكَش

24
00:03:36,140 --> 00:03:38,030
لم أركن منذُ وقت طويل يا جماعة

25
00:03:38,830 --> 00:03:40,530
ماذا تفعلين هنا؟

26
00:03:40,530 --> 00:03:44,220
ثمّة شيء عليّ فعله في المنطِقة فأردتُ زيارتكن

27
00:03:44,220 --> 00:03:47,970
شعرتُ أنه من الغريبِ ألّا تمارسن التمرينات الصباحيّة

28
00:03:47,970 --> 00:03:50,540
لكن تذكّرت، حان وقتُ المعسكر

29
00:03:51,920 --> 00:03:53,960
من اللّطيف رؤية السينباي بعد فترة طويلة أيضاً

30
00:03:53,960 --> 00:03:57,830
هل كاحلكِ بخير الآن يا كيروكا-سينباي؟

31
00:03:57,830 --> 00:04:00,230
أجل، كلّياً

32
00:04:00,230 --> 00:04:04,930
ويا مونيموني-سينباي، أرى أنّ صدركِ القويّ ما زال نفسه

33
00:04:04,930 --> 00:04:06,430
!صدر قويّ؟

34
00:04:07,720 --> 00:04:08,920
من هي؟

35
00:04:08,920 --> 00:04:10,080
صديقة؟

36
00:04:12,340 --> 00:04:13,890
طالبة سنة ثانية في أكاديميّة تسوبامي للإناث

37
00:04:14,410 --> 00:04:16,040
تسوكينوا كومامي

38
00:04:16,040 --> 00:04:18,360
كانَتْ جزءاً من فريقنا

39
00:04:19,100 --> 00:04:21,200
زميلة سابِقة في الفريق؟

40
00:04:21,680 --> 00:04:24,690
انتقلَتْ قُبيل وصولك

41
00:04:25,950 --> 00:04:29,870
أو بعبارة أدقّ، غادرَتْ سوزوميغاهارا
بحثاً عن فُرَص أفضل

42
00:04:31,280 --> 00:04:32,580
ماذا تقصدين؟

43
00:04:32,580 --> 00:04:35,330
لم أركِ منذُ وقت طويل يا أ-تشان

44
00:04:35,650 --> 00:04:36,820
!أ-تشان؟

45
00:04:37,250 --> 00:04:38,510
لم أركِ منذُ وقت طويل

46
00:04:38,510 --> 00:04:41,420
من هذه؟ سنة أولى؟

47
00:04:41,420 --> 00:04:43,840
انتقلَتْ في هذا الرّبيع

48
00:04:45,070 --> 00:04:46,720
سـ-سرِرتُ بلقائكِ

49
00:04:46,720 --> 00:04:49,050
اسمي تسوموجيكازي كويوري

50
00:04:49,050 --> 00:04:51,060
!تمكّنتُ من التّعريفِ عن نفسي بشكلٍ صحيح

51
00:04:51,790 --> 00:04:53,440
اسمي تسوكينوا كومامي

52
00:04:57,020 --> 00:04:59,020
...أ-تشان، هذه الفتاة

53
00:04:59,020 --> 00:05:00,560
!كومامين

54
00:05:00,560 --> 00:05:04,070
لم أركِ منذ وقت طويل! دعيني ألعب بكعكتَيْ شعركِ

55
00:05:04,660 --> 00:05:06,570
!بونبون! بونبون

56
00:05:06,570 --> 00:05:09,730
!أبعدي يديكِ القذرتين عنها

57
00:05:09,730 --> 00:05:12,350
!هذا يدغدغ أيتها القذرة

58
00:05:16,010 --> 00:05:19,560
مضَتْ فترة طويلة مُذ رأيتُ قدرة كومامين
على التكلُّمِ باطنيّاً

59
00:05:19,560 --> 00:05:20,750
إنّها مشهورة بالفعل

60
00:05:20,750 --> 00:05:25,390
حسناً، إنّه الشيء الوحيد الذي تتمتّع به صاحبة العضلات هذه

61
00:05:25,390 --> 00:05:28,340
لا تُقحِم صدري في الأمر يا كومانوسكي-سان

62
00:05:28,340 --> 00:05:28,970
مؤلم

63
00:05:33,260 --> 00:05:34,120
!رائع

64
00:05:34,120 --> 00:05:36,950
!يبدو وكأنّ الدبّ ينطق حقّاً

65
00:05:36,950 --> 00:05:40,240
!لا نظير لقدرة كومامين على الكلام باطنيّاً

66
00:05:40,240 --> 00:05:41,680
درجة أولى

67
00:05:41,680 --> 00:05:43,050
!الأفضل في اليابان

68
00:05:43,050 --> 00:05:44,960
أنتِ رائعة يا كوما-تشان

69
00:05:44,960 --> 00:05:46,720
!إنّها رائعة

70
00:05:47,700 --> 00:05:51,270
!أ-أنتُنّ تحرجنَني، تبّاً

71
00:05:51,710 --> 00:05:53,740
حسناً، لماذا أتيتِ إلى هنا؟

72
00:05:53,740 --> 00:05:57,790
من المؤكّد أنّكِ لم تأتي للتباهي بقدرتكِ على التكلُّم باطنيّاً

73
00:05:59,100 --> 00:06:00,680
هذا صحيح، بالفعل

74
00:06:01,320 --> 00:06:03,960
...لكن في الواقع، إذا أردتُ أن أتكلّم

75
00:06:10,300 --> 00:06:14,060
أتيتُ لرؤيتك على ما أعتقد

76
00:06:17,050 --> 00:06:20,150
حان الوقتُ للشحن بفيتامين أغاري

77
00:06:20,510 --> 00:06:22,880
!تـ-تـ-تبّاً، ما خطبكِ؟

78
00:06:24,020 --> 00:06:27,050
أ-أتيتِ إلى هنا لأجلِ هذا فقط؟

79
00:06:27,050 --> 00:06:28,880
هذا مهمٌّ بالنسبة لي

80
00:06:28,880 --> 00:06:32,110
لم أركِ منذُ برهة واشتقتُ إليكِ

81
00:06:32,110 --> 00:06:33,160
ماذا؟

82
00:06:33,160 --> 00:06:39,420
وأنا التي ظننتُ أنّكِ أتيتِ لحسم النتيجة معي

83
00:06:39,730 --> 00:06:41,600
حسم النتيجة؟

84
00:06:45,040 --> 00:06:48,630
أذكر أنني أخبرتُكِ أنّني لن ألعب معكِ بعد الآن

85
00:06:48,630 --> 00:06:50,320
ولماذا؟

86
00:06:50,320 --> 00:06:51,140
!أعطيني سبباً

87
00:06:53,260 --> 00:06:54,340
أنا آسفة

88
00:06:57,810 --> 00:07:00,060
!لنخرج من هنا يا كومامي

89
00:07:00,060 --> 00:07:03,340
نعم، إنّهن متوجِّهات إلى المعسكر

90
00:07:03,340 --> 00:07:04,750
هيّا بنا

91
00:07:04,750 --> 00:07:06,070
!انتظري يا كومامي

92
00:07:10,410 --> 00:07:11,680
طاب يومكن

93
00:07:12,280 --> 00:07:13,560
...طاب يومكِ

94
00:07:24,380 --> 00:07:26,860
ألا تتّفقين معي يا هوكوتو؟

95
00:07:26,860 --> 00:07:28,340
!رائع

96
00:07:31,720 --> 00:07:33,680
!هذا جميلٌ للغاية

97
00:07:40,500 --> 00:07:43,310
مركز تمرين أفضل من نادي مدرستنا

98
00:07:44,000 --> 00:07:47,770
بيئة نستطيعُ فيها التركيز على كُرة الطاولة طوال الوقت

99
00:07:48,300 --> 00:07:50,530
يمكننا أن نلعب حتّى ننهار

100
00:07:50,530 --> 00:07:52,570
أنا متحمِّسة

101
00:07:52,580 --> 00:07:54,950
،اشكرنَ الشخص التي نظّمَتْ معسكر التدريب هذا

102
00:07:54,950 --> 00:07:58,040
نيبّونيتشي-سينسي، أفضل مدرِّسة في اليابان

103
00:07:59,630 --> 00:08:01,360
!شكراً جزيلاً لكِ

104
00:08:01,360 --> 00:08:03,510
!أنتِ الأفضل

105
00:08:03,510 --> 00:08:06,620
حسناً إذاً. بطولة الصّيف قد اقتربت

106
00:08:06,620 --> 00:08:10,510
وهدفنا هو الوصول إلى البطولةِ الوطنيّةِ بالطبع

107
00:08:10,510 --> 00:08:14,720
لكن أنا شخصيّاً، أودُّ أن أربح البطولة الوطنيّة

108
00:08:16,700 --> 00:08:20,450
لهزيمة المدارس المخضرمة والعديدة والتأهُّل
إلى البطولة الوطنيّة

109
00:08:20,450 --> 00:08:24,620
يجب أن نعزّز من مستوى لعبنا على عدّة أصعِدة

110
00:08:25,170 --> 00:08:30,400
الهدف من معسكرِ التدريبِ هذا هو تحسين
مستوانا بما يكفي لِلَّعب في البطولة الوطنيّة

111
00:08:31,030 --> 00:08:34,290
!سنتدرّبُ بجدٍّ تحضيراً للبطولة

112
00:08:34,290 --> 00:08:36,150
!بجدّ

113
00:08:36,150 --> 00:08:38,650
البطولة الوطنيّة إذاً؟

114
00:08:38,650 --> 00:08:42,150
سيكون هنالك الكثير من اللّاعِبات المذهلات مثل كوروري-سان، صحيح؟

115
00:08:43,820 --> 00:08:46,460
!مجرّد التفكير بالأمر يجعلُ قلبي ينبضُ بسرعة

116
00:08:48,950 --> 00:08:51,240
هذا يجعلُ قلبكِ ينبضُ بسرعة، أليس كذلك يا أغاري-تشان؟

117
00:08:59,120 --> 00:09:02,120
،مُعظم البرنامج تمارين مُشترَكة

118
00:09:02,120 --> 00:09:05,820
وسنركّز على التمرينات المعتادة مجدّداً اليوم

119
00:09:05,820 --> 00:09:09,310
...كلّ بند من هذه البنود مختلف عن الآخر

120
00:09:09,310 --> 00:09:11,760
،لكن ابتداء من يوم غدّ

121
00:09:11,760 --> 00:09:15,320
ستُقام جلسات تمرين حرّة لمدّة ساعتين عقب التمرين المُشترَك

122
00:09:15,810 --> 00:09:21,010
على المُبتدئات أن تتمرّنَّ أثناء تذكّر المُباريات
اللّاتي خُضنَها في الأيّام السابِقة

123
00:09:21,010 --> 00:09:24,180
خاصّة أولئك اللّواتي لاحظنَ بعض الأخطاء في أدائهن

124
00:09:24,180 --> 00:09:28,500
أريدُ تصحيح هذه الأخطاء في هذا المعسكر

125
00:09:29,000 --> 00:09:30,690
هل كان هذا الكلام موجّهاً نحوي؟

126
00:09:30,690 --> 00:09:32,210
هل لاحظَتْ مُشكلتي؟

127
00:09:33,460 --> 00:09:36,530
ماذا ينبغي أن نفعل؟

128
00:09:36,530 --> 00:09:40,530
حسناً، بالنسبة لطالبات السنة الأولى يمكنهن
مُراجعة كلّ ما تعلّمنَه حتّى الآن

129
00:09:40,530 --> 00:09:44,350
والتركيز على المناطِق التي يشعُرنَّ أنّها
بحاجةٍ إلى تحسين

130
00:09:44,350 --> 00:09:46,570
،سنقدّمُ المُساعدة لكُل لاعِبة تواجه مُشكلة

131
00:09:46,570 --> 00:09:47,690
لذا احرصن على طلبِ المشورة

132
00:09:47,690 --> 00:09:49,060
!عُلِم

133
00:09:49,560 --> 00:09:52,320
هل نبدأ إذاً؟

134
00:09:52,320 --> 00:09:56,240
لنجعل هذا معسكراً مُثمِراً خالياً من الملل

135
00:09:56,240 --> 00:09:58,450
!لنقم بهذا

136
00:09:59,070 --> 00:10:00,660
من فضلِكن

137
00:10:01,090 --> 00:10:02,290
أغاري-تشان

138
00:10:03,470 --> 00:10:05,480
تمرين حرّ؟

139
00:10:05,480 --> 00:10:07,870
ماذا ينبغي أن أفعل؟

140
00:10:08,350 --> 00:10:10,380
سنبدأ بتمرينات حركة الأرجل

141
00:10:10,380 --> 00:10:11,330
أمام

142
00:10:11,800 --> 00:10:12,800
وسط

143
00:10:12,800 --> 00:10:15,070
خلف

144
00:10:15,070 --> 00:10:16,360
مركز

145
00:10:16,360 --> 00:10:17,220
أمام

146
00:10:17,220 --> 00:10:18,570
خلف

147
00:10:18,570 --> 00:10:19,860
مركز

148
00:10:19,860 --> 00:10:21,930
أمام

149
00:10:22,990 --> 00:10:27,140
هذه التمرينات لها علاقة بالوقوفِ
في أنسب نقطة لضرب الكُرة

150
00:10:27,140 --> 00:10:29,340
كُنَّ بارعات وسريعات في تحريك أقدامكن

151
00:10:29,340 --> 00:10:31,920
،هذا التمرين الأهمّ والأكثر جوهريّة

152
00:10:31,920 --> 00:10:33,780
!لذا ركّزنَ

153
00:10:33,780 --> 00:10:34,650
!حاضر

154
00:10:56,710 --> 00:10:57,340
!هوكو

155
00:10:59,020 --> 00:11:00,850
!لنتابع على هذا المنوال

156
00:11:00,850 --> 00:11:02,160
!حاضر

157
00:11:07,310 --> 00:11:11,520
بما أنّ هذا معسكر تدريب، يمكننا التركيز
على التمرين طوال اليوم

158
00:11:12,790 --> 00:11:15,350
لكنّه صعب للغاية

159
00:11:15,350 --> 00:11:17,110
...هذا هو معسكر التدريب إذاً

160
00:11:17,110 --> 00:11:18,610
أشعرُ نفسي سأموت

161
00:11:18,610 --> 00:11:20,260
حسناً يا فتيات

162
00:11:20,260 --> 00:11:23,110
تمارين الضربات السّاحقة هذه هي الأخيرة
لهذا اليوم

163
00:11:23,110 --> 00:11:25,490
ليكُن خِتام يومنا مِسكاً

164
00:11:26,880 --> 00:11:28,740
!تمرين ضربات ساحقة؟

165
00:11:28,740 --> 00:11:30,150
عادَتْ إلى الحماس

166
00:11:30,150 --> 00:11:31,750
مُفعمة بالحياة

167
00:11:33,700 --> 00:11:35,070
جيّد، جيّد

168
00:11:35,070 --> 00:11:37,660
أنتِ رائعةٌ دوماً يا كويوري-تشان

169
00:11:37,660 --> 00:11:42,780
مباراة التمرين جعلَتْ ضرباتكِ السّاحقة أكثر فتكاً

170
00:11:42,780 --> 00:11:44,640
!شـ-شكراً لكِ

171
00:11:46,770 --> 00:11:50,170
الطريقة التي يقفزُ فيها صدركِ عندما تضربين
ضربة ساحِقة فاتِنة

172
00:11:50,170 --> 00:11:51,640
!امدحي ضربتي السّاحقة

173
00:11:51,960 --> 00:11:53,930
فيما يلي، أغاري

174
00:11:55,250 --> 00:11:56,110
شكراً لكِ

175
00:12:10,330 --> 00:12:12,250
مملّة للغاية

176
00:12:13,000 --> 00:12:16,900
لا تستخدمين عادة ضربة ساحِقة براحة اليدّ

177
00:12:16,900 --> 00:12:19,170
لهذا كنتُ متفاجئة جداً آنذاك فلم أستطع ردّها

178
00:12:19,670 --> 00:12:24,380
لكن من السّهل كثيراً التّعامُل معها الآن

179
00:12:30,180 --> 00:12:32,350
ضربات أغاري-تشان السّاحقة

180
00:12:33,070 --> 00:12:34,460
غير فعّالة إطلاقاً؟

181
00:12:44,660 --> 00:12:46,320
!نبع ساخن

182
00:12:46,730 --> 00:12:50,560
مهما كان التمرين صعباً، أستطيعُ تخطّيه
لأنّ هذا ينتظرني

183
00:12:50,560 --> 00:12:52,840
!لهذا أعشق معسكر التدريب

184
00:12:52,840 --> 00:12:56,030
حبّكِ للينابيع السّاخنة يجعلكِ تبدين
كمُواطِنة كبيرة في السنّ

185
00:12:56,030 --> 00:12:59,500
!المسبح الدافئ سيكون أكثر إثارة

186
00:12:59,500 --> 00:13:00,700
مهلاً مهلاً

187
00:13:00,700 --> 00:13:03,550
لا تقولي ذلك. لندخل يا هوكوتو

188
00:13:07,930 --> 00:13:10,600
هل سيكون غداً بنفس مستوى الصّعوبة؟

189
00:13:10,600 --> 00:13:12,270
قد نموت

190
00:13:14,650 --> 00:13:16,520
أتريدين شرب بعض الحليب؟

191
00:13:16,520 --> 00:13:18,310
!بالتأكيد

192
00:13:22,490 --> 00:13:24,070
!أ-أغاري-تشان

193
00:13:24,070 --> 00:13:26,320
هل يجول شيء في خاطركِ؟

194
00:13:27,660 --> 00:13:30,200
،إ-إن كنتِ لا تمانعينني

195
00:13:30,200 --> 00:13:32,120
!سـ-سأستمع إليكِ بصدر رحب

196
00:13:32,730 --> 00:13:33,800
كويوري

197
00:13:43,020 --> 00:13:44,760
ليسَتْ فتّاكة بما يكفي؟

198
00:13:44,760 --> 00:13:45,860
أجل

199
00:13:45,860 --> 00:13:49,440
إنّ ضربتي السّاحقة ليسَتْ فتّاكة بما يكفي
الآن لتحقيق الفوز

200
00:13:50,000 --> 00:13:53,400
،تمكّنتُ بطريقةٍ ما من هزيمة زاكورو-سان

201
00:13:53,940 --> 00:13:56,980
لكنّها ردَّتْ ضرباتي السّاحقة
براحة اليد بسهولة

202
00:14:01,310 --> 00:14:04,380
،بالظروف الرّاهنة، انسينَ أمر البطولة الوطنيّة

203
00:14:04,380 --> 00:14:07,610
لستُ متأكّدة حتّى ما إن كنتُ سأربح
في تصفياتِ المُقاطَعة

204
00:14:08,000 --> 00:14:10,380
أنتِ متشائمة للغاية

205
00:14:10,380 --> 00:14:12,150
لستُ كذلك

206
00:14:12,700 --> 00:14:16,170
سنواجه بلا شكّ أكاديميّة تسوبامي في تصفياتِ المُقاطعة

207
00:14:16,170 --> 00:14:19,540
وكومامي معهن في هذا العام

208
00:14:19,940 --> 00:14:22,290
لن ألعب معكِ بعد الآن

209
00:14:23,350 --> 00:14:24,250
أنا آسفة

210
00:14:31,650 --> 00:14:34,600
حسناً، أجل، كومامين قويّة

211
00:14:34,600 --> 00:14:36,630
لِباس داخلي مُكشكش بارعة جدّاً

212
00:14:36,630 --> 00:14:40,940
قد يكون أفضل بكثير حتّى من موزوياما الآن

213
00:14:40,940 --> 00:14:43,670
ماذا؟ أفضل من فريق كوروري-سان؟

214
00:14:43,670 --> 00:14:44,820
لا يمكنُ الاستهانة بهن

215
00:14:45,180 --> 00:14:48,500
كنتُ متحمِّسة للغاية لأنني استطعتُ توجيه
ضربات ساحِقة براحة اليد مجدّداً

216
00:14:49,140 --> 00:14:52,880
لكن كلّ ما كان يعنيه ذلك هو أنّني أصبحتُ معتدِلة
أخيراً في تلك الضربات

217
00:14:55,810 --> 00:14:57,890
،إن كنتُ عاجزة عن إنهاء فترات تبادُل الضربات

218
00:14:57,890 --> 00:14:59,960
فلا أستطيع مُنافسة اللّاعبات في الفرق المُخضرَمة

219
00:15:00,270 --> 00:15:02,710
!هل ستخرجين بهذه السرعة يا أغاري؟

220
00:15:02,710 --> 00:15:04,530
كان ذلك سريعاً

221
00:15:04,530 --> 00:15:06,230
لا أملك وقتاً أهدره

222
00:15:06,230 --> 00:15:09,340
ينبغي أن أخلد إلى النوم بسرعة وأتمرّن
غداً في الصّباح الباكر

223
00:15:09,340 --> 00:15:10,800
وأستغلّ كلّ ثانية

224
00:15:10,800 --> 00:15:12,840
سأخرجُ أيضاً إذاً

225
00:15:12,840 --> 00:15:16,420
هل غسلتِ كتفيكِ وعددتِ إلى مئة؟

226
00:15:17,760 --> 00:15:20,450
...مئة؟! لم أفعل

227
00:15:20,450 --> 00:15:21,760
لا يمكنكِ إذاً

228
00:15:21,760 --> 00:15:23,870
دفّئي نفسكِ بشكلٍ كامل قبل الخروج

229
00:15:23,870 --> 00:15:25,280
أنا قد فعلت

230
00:15:25,820 --> 00:15:28,260
أنتِ متمسّكةٌ دوماً بالقواعد

231
00:15:28,260 --> 00:15:31,990
في الواقع تبدئين كامرأة عجوز يا لِباس داخلي أبيض

232
00:15:32,460 --> 00:15:35,410
تبّاً، كفّي عن الإشارةِ إلى النّاس بحسبِ
لون ملابسهم الداخليّة

233
00:15:35,410 --> 00:15:37,690
!لدينا أسماء! استخدميها

234
00:15:39,930 --> 00:15:40,870
هوكو

235
00:15:41,820 --> 00:15:43,270
لِباس داخلي خوخي

236
00:15:43,270 --> 00:15:44,830
لِباس داخلي أبيض

237
00:15:44,830 --> 00:15:45,630
هانابي

238
00:15:45,950 --> 00:15:48,020
لماذا تتلقّى هانابي مُعاملة عاديّة؟

239
00:15:48,530 --> 00:15:50,240
هانابي هي هانابي

240
00:15:50,240 --> 00:15:52,300
لا أكثر ولا أقلّ

241
00:15:52,300 --> 00:15:55,270
،اثنان وخمسون، ثلاثة وخمسون
...أربعة وخمسون، خمسة وخمسون

242
00:15:52,660 --> 00:15:54,320
...هذا غير مُنصِف بعض الشيء

243
00:15:54,750 --> 00:15:56,240
أنتِ هزليّة حقّاً يا هوكوتو

244
00:15:55,270 --> 00:15:58,390
،ستّة وخمسون، سبعة وخمسون
...ثمانية وخمسون، تسعة وخمسون

245
00:16:00,380 --> 00:16:00,980
،إذاً

246
00:16:01,650 --> 00:16:05,680
تريدين أن تكوني قادرة على ضربِ ضربات ساحِقة فتّاكة

247
00:16:06,190 --> 00:16:07,440
أجل

248
00:16:07,440 --> 00:16:10,240
وهل لديكِ طريقة لفعل ذلك؟

249
00:16:10,800 --> 00:16:14,160
في الحقيقة، كلّا

250
00:16:14,650 --> 00:16:16,110
،عندما تفكّرين بالأمر

251
00:16:16,110 --> 00:16:20,550
لا يمكنُ تطوير ضربة ساحِقة إلى فتّاكة بين ليلة وضُحاها

252
00:16:21,010 --> 00:16:23,380
،عليّ أن أبتكر شيئاً ما أثناء هذا المعسكر

253
00:16:23,380 --> 00:16:25,920
.لكن لا أعلم ما إن كنتُ سأستطيع

254
00:16:32,880 --> 00:16:35,270
!سأتصدّى لهم هُنا

255
00:16:35,270 --> 00:16:37,400
!اسبقيني يا هوكوتو

256
00:16:37,850 --> 00:16:39,410
...هوكو، هوكو

257
00:17:01,970 --> 00:17:03,290
أغاري-تشان؟

258
00:17:10,760 --> 00:17:12,260
أتعانين من الأرق؟

259
00:17:12,800 --> 00:17:13,650
كويوري؟

260
00:17:15,510 --> 00:17:19,800
أغاري-تشان، إن كان هناك ما يضايقكِ، تكلّمي معي

261
00:17:19,800 --> 00:17:21,850
...كما قلت، ضربتي السّاحقة

262
00:17:22,350 --> 00:17:23,940
أهذا كلّ شيء حقّاً؟

263
00:17:25,950 --> 00:17:27,900
إنّها لِباس داخلي مُكشكش، صحيح؟

264
00:17:28,380 --> 00:17:30,640
كومامين؟

265
00:17:30,640 --> 00:17:31,500
—ما

266
00:17:31,500 --> 00:17:32,760
لماذا؟

267
00:17:32,760 --> 00:17:33,940
هذا واضح وضوح الشّمس

268
00:17:34,270 --> 00:17:35,840
...ولِمَ يكون

269
00:17:36,250 --> 00:17:37,420
أغاري-تشان

270
00:17:42,600 --> 00:17:47,180
أكاديميّة تسوبامي للإناث هي مدرسة
للفتياتِ الثريّات، لكنّها أيضاً فريق مُخضرَم

271
00:17:47,940 --> 00:17:50,940
استطاعَتْ قائدتهن استدراج كومامي

272
00:17:50,940 --> 00:17:52,020
استدراج؟

273
00:17:52,880 --> 00:17:56,970
يبدو أنّ القائدة هي الابنة الوحيدة
لرئيس المجلس هناك

274
00:17:56,970 --> 00:18:02,100
يُقال أنّ عائلتها تديرُ عدداً كبيراً
من صالات كُرة الطاولة

275
00:18:02,100 --> 00:18:05,890
...لهذا يوظِّفون لاعبات بظرف النظر عن مدرسته أو درجته

276
00:18:05,890 --> 00:18:09,190
ويفعلون ما يشاؤون أو هذا ما ورد في الإشاعات

277
00:18:10,400 --> 00:18:13,860
حسناً، نحن لا نعرف التفاصيل أيضاً

278
00:18:13,860 --> 00:18:16,110
فأساساً، لقد غادرت فجأة

279
00:18:16,110 --> 00:18:17,730
هكذا إذاً

280
00:18:19,480 --> 00:18:23,770
ذكرتِ في هذا الصّباح أنّ هناك
نتيجة عليكما حسمها. ماذا كانت تلك؟

281
00:18:25,780 --> 00:18:28,050
،ذات يوم غادرَتْ كومامي

282
00:18:28,050 --> 00:18:32,090
طلبتُ منها أن تُلاعبني في مباراةِ وداع

283
00:18:32,510 --> 00:18:34,600
لكنّها رفضَتْ

284
00:18:34,600 --> 00:18:38,050
سلكنا طريقَين مختلفَين دون حتّى أن نلعب تلك المُباراة

285
00:18:38,510 --> 00:18:40,060
لم يكن في تلك المرّة فحسب

286
00:18:40,850 --> 00:18:43,020
،قبل مُغادرتها بحوالي شهر

287
00:18:43,020 --> 00:18:45,280
توقّفَتْ عن اللّعب في المباريات

288
00:18:46,880 --> 00:18:50,830
لهذا ظننتُ أنّها قد تأتي اليوم

289
00:18:50,830 --> 00:18:55,110
لأنّها شعرَتْ برغبةٍ في اللّعبِ معي الآن

290
00:18:56,580 --> 00:18:57,280
...أعني

291
00:18:57,280 --> 00:18:59,170
أعني أنّكِ فهمتِ، صحيح؟

292
00:18:59,170 --> 00:19:01,090
!نحن لاعبتا كُرة طاولة

293
00:19:01,560 --> 00:19:04,760
ألا يحقّ لنا أن نتحادث باستخدام كُرة الطاولة؟

294
00:19:04,760 --> 00:19:05,830
أليس كذلك يا كويوري؟

295
00:19:05,830 --> 00:19:06,930
!أ-أجل

296
00:19:06,930 --> 00:19:09,350
تبدو كزعيمة عصابة حمِئة

297
00:19:09,350 --> 00:19:11,920
"وكأنّها تقول "سنتواصل عبر قبضاتنا

298
00:19:12,250 --> 00:19:13,290
هذا صحيح

299
00:19:13,290 --> 00:19:17,840
عند المُغادرة دون أن تلعبي مباراة مُناسِبة
فلن تعرفي من الأفضل

300
00:19:18,770 --> 00:19:21,650
!أردتُ أن ألاعبها

301
00:19:22,290 --> 00:19:23,810
فما هو اقتراحها؟

302
00:19:24,380 --> 00:19:28,380
أرادَتْ أن تراني لكنّها لم ترغب بمُلاعبتي؟

303
00:19:29,980 --> 00:19:31,480
ما عرضها؟

304
00:19:31,910 --> 00:19:34,160
لهذا كنتِ غاضبة للغاية إذاً

305
00:19:34,160 --> 00:19:36,680
أنتِ تدقّقين في الأمور كثيراً يا لِباس
داخلي أبيض

306
00:19:36,680 --> 00:19:40,150
!ا-اصمتي! ضايقَني ذلك قليلاً فحسب

307
00:19:40,850 --> 00:19:42,610
حقّاً؟

308
00:19:42,610 --> 00:19:47,180
لكن سنواجه تسوبامي في تصفياتِ المُقاطعة

309
00:19:47,690 --> 00:19:50,820
بمقدوركِ مُلاعبتها حينئذ فحسب

310
00:19:51,880 --> 00:19:53,280
...لا أنكر ذلك

311
00:19:53,760 --> 00:19:57,650
في هذه الحالة فالقلق بشأن لِباس مُكشكَش
هو مضيعةٌ للوقت

312
00:19:57,650 --> 00:19:58,710
مضيَعة؟

313
00:19:58,710 --> 00:20:02,470
عليكِ أن تفعلي كلّ ما بمقدوركِ فعله
الآن تحضيراً لتلك اللّحظة

314
00:20:02,470 --> 00:20:04,700
كلّ ما بمقدوري فعله الآن؟

315
00:20:05,300 --> 00:20:07,560
اجعلي ضربتكِ السّاحقة أكثر فتكاً

316
00:20:10,410 --> 00:20:11,490
!أغاري-تشان

317
00:20:11,490 --> 00:20:14,470
،لا أفهم اتّفاقكِ مع كومامي-سان بالضبط

318
00:20:14,470 --> 00:20:16,650
!لكن أظنّني أستطيعُ المُساهمة في كُرة الطاولة

319
00:20:17,490 --> 00:20:21,610
تمرّني الآن كي تتمكّني من الشعور
بنبضاتِ قلب سريعة معها

320
00:20:21,610 --> 00:20:23,760
!سأساعدكِ

321
00:20:23,760 --> 00:20:24,860
اتّفقنا؟

322
00:20:24,860 --> 00:20:27,100
ما-ماذا تقولين؟

323
00:20:27,100 --> 00:20:29,510
!أستطيعُ اكتشاف ذلك بنفسي

324
00:20:34,270 --> 00:20:40,240
...حـ-حسناً، لا يمكنني أن أرفض عرضاً بالمُساعدة ولو قليلاً

325
00:20:40,240 --> 00:20:42,010
!أكيد

326
00:20:42,430 --> 00:20:44,410
أيُّهما؟

327
00:20:44,410 --> 00:20:45,940
تصرّفها المعتاد

328
00:20:45,940 --> 00:20:46,710
يا إلهي

329
00:20:46,710 --> 00:20:48,450
ماذا تعنين بـ"يا إلهي"؟

330
00:20:48,980 --> 00:20:50,980
أعتقدُ أنّ القضيّة قد حُسِمَتْ

331
00:20:50,980 --> 00:20:53,550
الأمور بخواتيمها! هل نعود إلى الغرفة؟

332
00:20:53,550 --> 00:20:56,190
أجل، علينا البدء باكراً غداً أيضاً

333
00:21:05,580 --> 00:21:07,490
هيّا بنا يا كويوري

334
00:21:08,990 --> 00:21:09,950
!نعم

335
00:21:22,890 --> 00:21:26,250
هل سنتمرّن كما البارحة مجدّداً؟

336
00:21:26,250 --> 00:21:29,390
لا أدري ما إن كنتُ سأصمد

337
00:21:35,490 --> 00:21:36,340
!صباح الخير

338
00:21:38,650 --> 00:21:40,370
!صـ-صباح الخير

339
00:21:41,240 --> 00:21:42,560
!صباح الخير

340
00:21:43,110 --> 00:21:44,340
صباح الخير

341
00:21:44,340 --> 00:21:46,030
!صباح الخير

342
00:21:46,530 --> 00:21:49,680
أغاري-سينباي والباقي مستعدّات لذلك

343
00:21:49,680 --> 00:21:51,240
نعم، هذا مذهل

344
00:21:54,870 --> 00:21:57,140
يا لها من تعابير وجه ممتازة

345
00:21:57,140 --> 00:21:59,940
لن أضجر اليوم على ما يبدو

346
00:23:45,170 --> 00:23:47,320
سأنضمُّ أيضاً

347
00:23:46,450 --> 00:23:48,570
!أنتِ تخجلينني يا هوكوتو

348
00:23:47,690 --> 00:23:50,750
!لا يُطلَق على هذا بالاستعمال العادِل

349
00:23:49,520 --> 00:23:51,570
!أعشقُ كرة الطاولة

350
00:23:51,020 --> 00:23:53,110
!هذه إجابتي

351
00:23:51,960 --> 00:23:54,760
!هذه هي حقيقتي

352
00:23:54,760 --> 00:23:57,560
الجميع هنا تحبّنَّ كرة الطاولة