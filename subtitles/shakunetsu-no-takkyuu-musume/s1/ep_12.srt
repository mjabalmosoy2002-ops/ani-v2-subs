1
00:01:54,090 --> 00:01:55,090
حسناً

2
00:01:56,590 --> 00:01:59,180
انتهى التمرين المشترك

3
00:01:59,180 --> 00:02:01,010
انتهى أخيراً

4
00:02:01,010 --> 00:02:02,910
يوم شاقّ آخر

5
00:02:02,910 --> 00:02:05,390
يبدأ التّمرين الحرّ اعتباراً من الآن

6
00:02:06,100 --> 00:02:10,100
افعلن ما بوسعكن للتخلُّصِ من نقاط ضعفكن

7
00:02:10,100 --> 00:02:13,730
إذا انتابتكن أي شكوك أو أسئلة، فاسألن متى شئتُنّ

8
00:02:14,220 --> 00:02:15,370
ماذا أفعل؟

9
00:02:15,370 --> 00:02:16,890
أتسألين ماذا؟

10
00:02:17,920 --> 00:02:21,790
إن كان تمريناً "حرّاً" فربّما يمكننا أن نستريح؟

11
00:02:22,370 --> 00:02:24,830
ما زلنا طالبات سنة أولى

12
00:02:24,830 --> 00:02:27,000
من الضروري أن نأخذ استراحة

13
00:02:28,550 --> 00:02:31,250
!تمرّني معي يا هوكوتو

14
00:02:32,240 --> 00:02:35,030
يمكننا أن نؤدّي تمارين مكثّفة معاً، اتّفقنا؟

15
00:02:35,030 --> 00:02:37,260
حسناً، لكن كفِّي عن عصري

16
00:02:38,100 --> 00:02:41,720
نحن الوحيدات اللَّاتي خسرنا خلال تلك المباراة التمرينيّة

17
00:02:41,720 --> 00:02:44,140
وضعنا الفريق في مأزق

18
00:02:44,140 --> 00:02:47,390
اعتباراً من الآن، علينا أن نساهم أكثر

19
00:02:47,760 --> 00:02:50,760
من الواضح أنَّ عليكِ التمرُّن على الإرسال

20
00:02:50,760 --> 00:02:54,020
ولعلّكِ تستطيعين تحسين "ذلك" هنا

21
00:02:55,440 --> 00:02:58,940
حسناً، نعم، ينبغي أن يكون هذا السّقف عالياً بما يكفي

22
00:02:59,370 --> 00:03:01,270
!افعلي ما بوسعكِ يا هوكوتو

23
00:03:01,270 --> 00:03:02,910
كفِّي عن عصري

24
00:03:04,060 --> 00:03:05,310
،أثناء مباراة موزوياما

25
00:03:05,310 --> 00:03:08,620
استغلَّتْ خصمتي ضعفي في الأشواط الطويلة
لدفعي لارتكاب الأخطاء

26
00:03:11,510 --> 00:03:13,970
عليّ أن أعزِّز من دقّة إرسالي

27
00:03:13,970 --> 00:03:16,640
لكن أظنّ أنَّ إرسالكِ جيّد جدّاً

28
00:03:16,640 --> 00:03:18,470
جيّد جدّاً لا يكفي

29
00:03:18,470 --> 00:03:21,560
عليّ أن أكون قادرة على إيصالِ الكرة
حيثما أريدُ بالضبط

30
00:03:22,210 --> 00:03:23,390
...وأيضاً

31
00:03:26,990 --> 00:03:30,850
أظنُّني بحاجةٍ لإرسال نِهائي يحقِّقُ لي نجاحاتٍ باهرة

32
00:03:30,850 --> 00:03:33,470
!نهائي؟ يبدو هذا رائعاً

33
00:03:33,470 --> 00:03:36,200
بالمناسبة، ماذا ينبغي أن أفعل؟

34
00:03:36,200 --> 00:03:37,900
تمرّني على الأساسيّات

35
00:03:37,900 --> 00:03:41,230
أنتِ  لاعبة درايف مُضادّة، لذلك من الطبيعي
أن تكوني عِرضة للأخطاء

36
00:03:41,230 --> 00:03:44,360
لكن ينبغي أن تكون قادرة على التّعويضِ عن ذلك
بحركة قدميكِ الخفيفة

37
00:03:44,360 --> 00:03:48,970
استمرّي في العملِ على حركةِ الأقدام
الأساسيّة وستكونين حينئذ ندّاً صعباً

38
00:03:48,970 --> 00:03:51,660
الأساسيّات؟ يبدو هذا رهيباً

39
00:03:51,660 --> 00:03:54,920
سأرافقكِ طوال الطريق، لِذا لا تتذمّري

40
00:03:55,750 --> 00:03:57,530
خفِّفي الأخطاء التي ترتكبينها فحسب

41
00:03:57,970 --> 00:04:01,300
بصفتكِ لاعبة درايف مضادّة، أنتِ أسرع من أي شخص
في الفريق

42
00:04:01,620 --> 00:04:04,040
قد تصبحين أهمّ لاعبة في سوزوميغاهارا

43
00:04:04,500 --> 00:04:06,080
هذا ما أؤمن به

44
00:04:06,080 --> 00:04:08,640
!تبّاً، أنتِ تحرجينني يا هوكوتو

45
00:04:09,080 --> 00:04:13,180
أنتِ الأكثر قابليّة للعصر في فريقنا

46
00:04:13,180 --> 00:04:14,430
هذا ليس مديحاً

47
00:04:14,430 --> 00:04:15,520
باردة كالثلج

48
00:04:16,170 --> 00:04:18,230
!لنبدأ بالعمل إذاً

49
00:04:18,230 --> 00:04:21,050
السينباي متحمِّستان جدّاً لهذا

50
00:04:22,870 --> 00:04:24,200
!لا

51
00:04:27,990 --> 00:04:30,620
لكن البطولة اقتربت

52
00:04:30,620 --> 00:04:35,120
كي أربح، عليّ أن أتخلّى عن الضرباتِ السّاحقة
براحةِ اليدّ وأفكِّر بوسيلةٍ أخرى لأتحسَّن

53
00:04:35,120 --> 00:04:36,580
!لا يعني لا

54
00:04:36,910 --> 00:04:40,210
تـ-تحبِّين تنفيذ الضربات السَّاحقة

55
00:04:40,810 --> 00:04:46,300
وهذا يجعلُ نبضات قلبي تتسارع
كلّما رأيتُكِ تحرزينها

56
00:04:46,300 --> 00:04:49,060
...لذا أنا

57
00:04:49,060 --> 00:04:51,060
لا أريدكِ أن تتخلّي عن ضرباتكِ السّاحِقة

58
00:04:53,190 --> 00:04:56,520
!على أي حال، لا يجوز أن تتخلّي عن الضربات السّاحقة فحسب

59
00:04:56,830 --> 00:04:57,940
كويوري

60
00:05:00,360 --> 00:05:01,610
!أغاري-تشان

61
00:05:01,610 --> 00:05:03,900
!تمرّني معي في التّمرين الحرّ

62
00:05:04,660 --> 00:05:08,810
لقد كنتُ أفكّرُ بوسيلةٍ لتعزيزِ قوّة فتك
ضرباتكِ السّاحقة منذُ البارحة

63
00:05:08,810 --> 00:05:09,870
،وأيضاً

64
00:05:09,870 --> 00:05:11,370
خطرَتْ على ذهني فكرة

65
00:05:14,020 --> 00:05:16,640
ثِقي بي واتّبعي تعليماتي

66
00:05:22,550 --> 00:05:23,590
حسناً

67
00:05:23,930 --> 00:05:25,800
لنفعل ما بوسعنا يا أغاري-تشان

68
00:05:25,800 --> 00:05:26,740
نعم

69
00:05:27,190 --> 00:05:29,070
حسناً، ماذا ينبغي أن أفعل؟

70
00:05:29,070 --> 00:05:30,700
أولاً، اتّخذي هذه الوضعيّة

71
00:05:30,700 --> 00:05:33,640
هكذا؟

72
00:05:31,520 --> 00:05:32,730
ومن ثمّ افعلي هذا

73
00:05:33,640 --> 00:05:35,140
!والآن انهضي

74
00:05:35,140 --> 00:05:36,310
!نهوض

75
00:05:41,050 --> 00:05:42,730
ماذا تفعلان؟

76
00:05:42,730 --> 00:05:45,460
ما هذا؟ هذا ركوبُ الأكتاف

77
00:05:45,460 --> 00:05:47,240
أتتمرّنان على الجمبازِ الجماعي؟

78
00:05:48,590 --> 00:05:50,150
كويوري؟

79
00:05:50,670 --> 00:05:53,330
هل سيُساهم هذا في جعلِ ضرباتي السّاحقة
أكثر فتكاً حقّاً؟

80
00:05:54,050 --> 00:05:56,850
"اسمكِ المستعار هو "لاعبة درايف الشّمال

81
00:05:57,390 --> 00:05:59,970
،كي تنفّذي أفضل ضرباتٍ ساحِقة

82
00:05:59,970 --> 00:06:03,090
أظنّكِ ينبغي أن تستغلّي امتيازكِ
ألا وهو ضربات درايف الدائريّة

83
00:06:05,370 --> 00:06:06,680
ما هذا بالضبط؟

84
00:06:08,200 --> 00:06:10,010
،لا أدري

85
00:06:10,500 --> 00:06:13,280
لكن السينباي تفعلان ما بوسعهما

86
00:06:13,280 --> 00:06:15,850
لا يجوز أن نكون الوحيدتين الكسولتين

87
00:06:19,000 --> 00:06:21,290
الجميع مُجدَّات في العمل

88
00:06:22,770 --> 00:06:25,980
والآن ينبغي أن أتمرّن بشكلٍ ثنائي مع كيروكا

89
00:06:26,300 --> 00:06:27,140
!يا قائدة

90
00:06:27,140 --> 00:06:28,450
!علّمينا

91
00:06:29,180 --> 00:06:30,890
أعلّمكما ماذا؟

92
00:06:30,890 --> 00:06:33,050
لا أستطيع تنفيذ ضربات درايف خاصَّتي

93
00:06:33,050 --> 00:06:34,780
علّميني كيف أتأقلم عليها

94
00:06:34,780 --> 00:06:37,150
وأنا لا أستطيع الصُّمود في فتراتِ تبادل الضربات

95
00:06:37,150 --> 00:06:38,450
ماذا ينبغي أن أفعل؟

96
00:06:38,450 --> 00:06:40,000
!وأنا أيضاً

97
00:06:40,000 --> 00:06:41,620
يا إلهي

98
00:06:41,620 --> 00:06:45,100
لا يمكنني تعليمكن جميعاً في آن واحد
سأعلّم كلّ واحدة منكن على حدة

99
00:06:45,100 --> 00:06:46,460
!شكراً لكِ

100
00:06:46,460 --> 00:06:48,940
أوّلاً، تانبوبو-تشان

101
00:06:48,940 --> 00:06:52,870
إنَّ درايف أقرب إلى "ضرب" الكرة
منها إلى "إصابة" الكرة

102
00:06:52,870 --> 00:06:55,280
والخاصرة هي مفتاح التَّلويح بالمضرب

103
00:06:55,280 --> 00:06:57,300
!عليكِ أن تقومي بهذا ثمّ هذا

104
00:06:57,300 --> 00:06:58,360
جرّبيها

105
00:06:58,360 --> 00:06:59,040
!حاضر

106
00:07:02,460 --> 00:07:04,020
هل ينبغي أن تفعلي هذا؟

107
00:07:04,020 --> 00:07:06,360
أفعل ماذا؟

108
00:07:07,590 --> 00:07:09,430
البطولة على الأبواب

109
00:07:09,900 --> 00:07:12,910
بدلاً من التَّركيز على تمرينكِ في مثل هذا
،الوقت الحرج

110
00:07:12,910 --> 00:07:15,330
كان كلّ ما فعلتِه هو تعليم الكوهاي

111
00:07:15,690 --> 00:07:17,420
ستكون الأمور على ما يُرام

112
00:07:17,420 --> 00:07:21,290
أعملُ على تحسينِ أدائي الثُّنائي
معكِ، أليس كذلك؟

113
00:07:21,290 --> 00:07:23,240
أعملُ ما يجب عليّ فعله

114
00:07:24,580 --> 00:07:27,000
...نعم، لكن

115
00:07:30,570 --> 00:07:32,540
كنتُ مثلهن في السّابق

116
00:07:33,720 --> 00:07:37,890
السينباي علّمنَني الكثير

117
00:07:39,280 --> 00:07:41,630
جعلنَني ما أنا عليه اليوم

118
00:07:43,560 --> 00:07:46,670
بالطبع، الفوز في البطولة مهمّ

119
00:07:47,400 --> 00:07:50,690
أنا لا أمزح عندما أقولُ أنّني أريد
المُشاركة في البطولةِ الوطنيّة

120
00:07:51,480 --> 00:07:58,200
لكن بصِفتي سينباي، أريدُ نقل أكبر
قدر مُمكن من المعرفة إلى الكوهاي

121
00:08:00,670 --> 00:08:04,360
،وبينما يتمرّنَّ أكثر ويتحسّن مُستواهن

122
00:08:04,820 --> 00:08:09,210
أنا متأكّدةٌ أنّهن سيقعنَ في حبِّ
كُرة الطاولة أكثر فأكثر

123
00:08:10,780 --> 00:08:12,230
،وبصِفتي قائدة

124
00:08:12,870 --> 00:08:15,810
لا شيء يُسعدني أكثر من ذلك

125
00:08:17,820 --> 00:08:19,100
...كيروكا

126
00:08:19,830 --> 00:08:22,110
إضافة إلى ذلك، كما أقول دائماً

127
00:08:22,110 --> 00:08:24,850
لن أخسر أمام أحد بوجودكِ معي

128
00:08:26,830 --> 00:08:27,620
!أجل

129
00:08:30,980 --> 00:08:32,860
!طبق ثانٍ

130
00:08:33,230 --> 00:08:35,820
أنتِ شرِهة يا مونيموني-سينباي

131
00:08:36,620 --> 00:08:40,990
أتمرّنُ بجدّ، لذا من الطبيعي أن أجوع

132
00:08:43,620 --> 00:08:45,960
لكن الأهمّ هو أنّني فتاة في مرحلةِ النضج

133
00:08:45,960 --> 00:08:47,710
،إن لم تأكلن كثيراً أيضاً يا فتيات

134
00:08:47,710 --> 00:08:49,340
فلن تنمو أيّ منكن

135
00:08:52,110 --> 00:08:54,180
،النموّ شيء

136
00:08:54,180 --> 00:08:58,220
والنموّ بمثل طريقتكِ أنتِ يا لِباس
داخلي خيطي هو شيء آخر

137
00:08:58,220 --> 00:09:00,310
!كنتُ أقصدُ الطول

138
00:09:00,310 --> 00:09:01,660
!إلى أين قادكِ ذلك؟

139
00:09:01,660 --> 00:09:03,600
!وأيضأً قولي مونيموني-سينباي

140
00:09:03,600 --> 00:09:05,820
لن تكون مشكلة على الإطلاق

141
00:09:05,820 --> 00:09:08,660
يمكنُه أن يكون فعّالاً إذا استخدمتِه هكذا

142
00:09:08,660 --> 00:09:11,400
!لا تعتبري هذا استخداماً فعّالاً

143
00:09:11,400 --> 00:09:13,630
هل يمكنني أن أستريح على وسادة صدركِ أيضاً؟

144
00:09:13,630 --> 00:09:15,640
أودُّ أن أنتهز هذه الفرصة أيضاً

145
00:09:15,640 --> 00:09:18,430
!لـ-لحظة! أنا آكل الآن

146
00:09:18,430 --> 00:09:20,870
تستخدمينه بارتياح إذاً عندما لا تأكلين؟

147
00:09:20,870 --> 00:09:22,860
!ليس هذا ما قصدت

148
00:09:22,860 --> 00:09:24,110
!هذه هي بوبيبوب-سينباي التي عهِدناها

149
00:09:24,110 --> 00:09:26,700
!لا تسمّيني بهذا الاسم

150
00:09:26,700 --> 00:09:28,070
!تبّاً

151
00:09:28,070 --> 00:09:31,190
مهلاً! هلّا توقفتُنّ عن ذلك؟

152
00:09:31,190 --> 00:09:33,230
!هذا ليس ملككِ يا كيروكا

153
00:09:59,170 --> 00:10:00,970
تقومين بهذا

154
00:10:00,970 --> 00:10:02,790
هكذا

155
00:10:02,790 --> 00:10:04,270
!هكذا

156
00:10:10,950 --> 00:10:12,380
!طبق ثانٍ

157
00:10:28,170 --> 00:10:29,100
جميل

158
00:11:14,960 --> 00:11:18,880
!حسناً، يكفي! هذه هي نهاية معسكر التّدريب هذا

159
00:11:20,360 --> 00:11:21,930
!انتهى

160
00:11:21,930 --> 00:11:23,200
هوكو، هوكو

161
00:11:27,190 --> 00:11:29,540
اجتمعن يا فتيات

162
00:11:30,160 --> 00:11:33,930
ها قد أتممنا الآن برنامج تمرين هذا المعسكر بالكامل

163
00:11:34,390 --> 00:11:36,040
أحسنتن صنعاً يا فتيات

164
00:11:36,040 --> 00:11:38,510
!شكراً جزيلاً لكِ

165
00:11:38,510 --> 00:11:41,160
هل تمكّنتُنّ من تصحيحِ أخطائكن؟

166
00:11:41,620 --> 00:11:42,870
،إن لم تفعلن

167
00:11:42,870 --> 00:11:46,630
فاحرصن على العملِ على ذلك في النّادي
بعد أن نعود إلى المدرسة

168
00:11:46,630 --> 00:11:49,280
ستبدأ تصفيات المُقاطعة قريباً

169
00:11:50,980 --> 00:11:54,390
،حالما تنتهين من العشاءِ والاستحمام

170
00:11:54,390 --> 00:11:58,450
يمكنكن قضاء وقتكن إلى أن ننصرف
في صباحِ الغدّ كيفما ترغبن

171
00:11:58,450 --> 00:12:02,090
احرصن على حزمِ أمتعتكن اللّيلة

172
00:12:02,090 --> 00:12:02,740
!حاضر

173
00:12:03,200 --> 00:12:04,630
حسناً يا فتيات

174
00:12:04,630 --> 00:12:06,530
اشكرن نيبّونيتشي-سينسي

175
00:12:06,530 --> 00:12:08,950
!شكراً جزيلاً لك

176
00:12:11,580 --> 00:12:12,830
حسناً، انصراف

177
00:12:13,330 --> 00:12:15,510
انقسمن إلى مجموعات وقمن بأعمال التنظيف

178
00:12:15,510 --> 00:12:17,280
!حاضر

179
00:12:15,920 --> 00:12:17,280
!حان وقتُ التنظيف

180
00:12:21,440 --> 00:12:23,780
أشعرُ وكأنَّني اقتربت

181
00:12:24,270 --> 00:12:27,270
آسفة لأنّني لم أنفعكِ

182
00:12:27,270 --> 00:12:29,680
!ماذا؟ لا، غير صحيح

183
00:12:31,320 --> 00:12:33,590
ساعدتِني كثيراً

184
00:12:33,590 --> 00:12:37,150
لديكِ تمرينكِ الخاصّ لكن وقفتِ معي طوال الوقت

185
00:12:37,910 --> 00:12:41,630
لكن هذا هو السّبب بعينِه والذي يدفعُني
لاكتشافِ هذا بمفردي

186
00:12:44,570 --> 00:12:45,600
أغاري-تشان

187
00:12:51,540 --> 00:12:52,330
ماذا؟

188
00:12:53,180 --> 00:12:55,080
الأضواء تعمل

189
00:12:57,910 --> 00:12:59,860
رائع، يمكننا الاستمرار في فترةِ تبادل الضربات الآن

190
00:12:59,860 --> 00:13:01,420
تدرَّبنا تدريباً فائضاً

191
00:13:01,750 --> 00:13:03,980
كنّا مُنهكاتٍ كثيراً بعد ذلك اليوم الأوّل أيضاً

192
00:13:03,980 --> 00:13:06,550
!لم أعُد كما كنتُ آنذاك

193
00:13:07,060 --> 00:13:10,080
فلتشهدي امتيازَ أغاري-سينباي

194
00:13:10,870 --> 00:13:12,650
!درايف دائريّة

195
00:13:17,150 --> 00:13:18,400
ماذا تفعلان؟

196
00:13:18,910 --> 00:13:20,980
...ماذا؟ في الواقع

197
00:13:20,980 --> 00:13:22,820
نُراجع ما تعلّمناه في المعسكر

198
00:13:23,480 --> 00:13:25,150
!آ-آسفة

199
00:13:25,150 --> 00:13:26,710
لا عليكما

200
00:13:27,200 --> 00:13:28,990
أتينا إلى هنا لنلعب أيضاً

201
00:13:29,990 --> 00:13:32,060
كويوري، ساعديني على مدِّ طاولة

202
00:13:32,060 --> 00:13:32,770
حسناً

203
00:13:34,070 --> 00:13:36,370
!عذراً، استخدما هذه

204
00:13:36,980 --> 00:13:38,330
...ماذا؟ لكن

205
00:13:38,650 --> 00:13:39,960
تفضّلا

206
00:13:41,140 --> 00:13:45,090
بالمقابل، علّميني كيف أنفّذ درايف دائريّة

207
00:13:48,450 --> 00:13:50,760
اضربي الكرة لتحثّيها على الدورانِ هكذا

208
00:13:51,160 --> 00:13:52,000
فهمتِ؟

209
00:13:52,000 --> 00:13:53,300
نـ-نعم

210
00:13:53,300 --> 00:13:54,680
كويوري، أرسلي

211
00:13:54,680 --> 00:13:55,850
حسناً

212
00:14:00,460 --> 00:14:02,350
أبقي عينيكِ على الكرة

213
00:14:05,370 --> 00:14:06,330
ماذا؟

214
00:14:06,330 --> 00:14:08,920
آسفة، أنا سعيدةٌ جدّاً فحسب

215
00:14:08,920 --> 00:14:12,700
لطالما أردتُ أن أتعلّم منكِ

216
00:14:13,420 --> 00:14:14,580
حقّاً؟

217
00:14:15,140 --> 00:14:20,150
كنتُ آمل أن تعلّميني قليلاً في هذا المعسكر

218
00:14:20,150 --> 00:14:23,590
لماذا لم تطلبي منّي ذلك فحسب؟ نحن زميلتان في الفريق

219
00:14:23,590 --> 00:14:27,010
هل بمقدوركِ تعليمي بين الفيّنة والأخرى إذاً؟

220
00:14:27,770 --> 00:14:29,300
أ-أكيد

221
00:14:29,300 --> 00:14:30,280
!مرحى

222
00:14:31,540 --> 00:14:32,780
كويوري-سينباي

223
00:14:33,390 --> 00:14:35,750
أريدُكِ أن تعلّميني أيضاً

224
00:14:36,830 --> 00:14:38,780
أريدُ أن أشعرَ بتسارُع نبضاتِ قلبي أيضاً

225
00:14:42,500 --> 00:14:43,270
ماذا؟

226
00:14:43,750 --> 00:14:45,540
الإضاءة تعمل

227
00:14:45,540 --> 00:14:47,240
سبقَنا أحدهم إلى هنا

228
00:14:50,450 --> 00:14:51,390
جربّيها الآن

229
00:14:51,390 --> 00:14:52,090
!حاضر

230
00:14:52,090 --> 00:14:53,370
ها هي ذي. استعدّي

231
00:14:53,370 --> 00:14:54,080
!عُلِم

232
00:14:54,080 --> 00:14:57,330
!درايف دائريّة

233
00:14:57,330 --> 00:14:59,250
!لا داعي للصُّراخ عاليّاً

234
00:14:59,250 --> 00:15:00,890
!وأخفضي خصركِ

235
00:15:00,890 --> 00:15:01,790
ماذا تفعلين؟

236
00:15:01,790 --> 00:15:03,230
هوكوتو-سان

237
00:15:03,230 --> 00:15:04,170
هانا-تشان

238
00:15:06,460 --> 00:15:08,900
هذا ما يجري إذاً

239
00:15:08,900 --> 00:15:11,000
ماذا عنكما؟

240
00:15:11,000 --> 00:15:13,710
!أتينا إلى هنا لمراجعة تمريننا مجدّداً

241
00:15:14,130 --> 00:15:16,360
لكن يبدو هذا ممتعاً أيضاً

242
00:15:16,360 --> 00:15:17,720
!اسمحن لي أن ألعب معكن

243
00:15:17,720 --> 00:15:18,960
هانابي؟

244
00:15:18,960 --> 00:15:20,420
هانابي-سينباي؟

245
00:15:20,420 --> 00:15:22,120
!مواجهة ثنائيّات

246
00:15:23,100 --> 00:15:24,130
انتظري

247
00:15:24,130 --> 00:15:25,230
لم تكن نيّتنا كذلك

248
00:15:25,560 --> 00:15:26,730
!ها نحن ذا

249
00:15:29,170 --> 00:15:30,490
...مهلاً يا هانابي

250
00:15:30,490 --> 00:15:31,880
!واحد-صفر

251
00:15:32,500 --> 00:15:35,030
!هذا ليس عدلاً! غير محسوبة

252
00:15:35,030 --> 00:15:37,220
!لنبدأ من الصفر إذاً

253
00:15:35,450 --> 00:15:37,220
...الـ-المعذرة

254
00:15:37,220 --> 00:15:39,160
لا تجنّا كثيراً

255
00:15:39,160 --> 00:15:40,710
ما الذي يجري؟

256
00:15:40,710 --> 00:15:41,960
...هل هذا

257
00:15:45,080 --> 00:15:47,800
!إرسالكِ بغيض كالعادة

258
00:15:47,800 --> 00:15:50,010
ازدادَ بغضاً مع التّمرين

259
00:15:51,150 --> 00:15:53,590
ما الذي يجري هنا؟

260
00:15:54,180 --> 00:15:55,840
تمرين صباحيّ في اللّيل؟

261
00:15:55,840 --> 00:15:57,380
...في الواقع

262
00:15:57,380 --> 00:15:58,470
...هما من بدأتا

263
00:16:01,620 --> 00:16:03,010
!تبديل يا هوكوتو

264
00:16:03,010 --> 00:16:03,980
أترك الأمر لكِ

265
00:16:03,980 --> 00:16:05,940
إنّها هانابي-سينباي الآن

266
00:16:06,380 --> 00:16:07,980
هل يمكنها أن تربح اليوم؟

267
00:16:13,090 --> 00:16:14,600
!هذا غشّ

268
00:16:15,410 --> 00:16:16,410
هوكو، هوكو

269
00:16:20,300 --> 00:16:22,120
!هذه كويوري-سينباي التي نعرفها

270
00:16:24,080 --> 00:16:27,130
!حسناً، لنقم بهذا

271
00:16:27,130 --> 00:16:29,250
!سنقيمُ بطولة

272
00:16:29,250 --> 00:16:31,090
!تماسكي يا يوموغيتشي

273
00:16:31,090 --> 00:16:32,220
!هاجمي

274
00:16:32,840 --> 00:16:33,970
!ارتفعَتْ

275
00:16:34,530 --> 00:16:35,930
هل ستحطُّ في الدّاخل؟

276
00:16:35,930 --> 00:16:37,390
!خرجَتْ

277
00:16:37,390 --> 00:16:39,100
!تبّاً

278
00:16:39,750 --> 00:16:41,350
ماذا تفعلن؟

279
00:16:41,780 --> 00:16:42,600
القائدة

280
00:16:43,120 --> 00:16:47,060
يا إلهي، أنتنّ تعشقن كرة الطاولة حقّاً

281
00:16:47,470 --> 00:16:49,790
الجميع مُشارِكات؟

282
00:16:49,790 --> 00:16:52,280
ما رأيكما أن تنضمّا إلينا؟

283
00:16:52,600 --> 00:16:55,770
لكنّنا استحممنا فحسب

284
00:16:56,210 --> 00:16:57,660
!لحظة، تدوّن اسمينا؟

285
00:16:57,660 --> 00:17:01,000
!القائدة ومونيموني-سينباي ستنضمَّان إلينا

286
00:17:02,370 --> 00:17:03,890
...مهلاً

287
00:17:03,890 --> 00:17:06,540
ما المشكلة؟ هذا جزءٌ من المعسكر أيضاً

288
00:17:12,710 --> 00:17:14,300
هوكو، هوكو

289
00:17:14,710 --> 00:17:16,510
!اصمدي يا هوكوتو-سينباي

290
00:17:16,510 --> 00:17:17,960
!عليكِ بها يا هانابي-سينباي

291
00:17:17,960 --> 00:17:19,060
!أنتِ بارعةٌ جدّاً يا أغاري-سينباي

292
00:17:19,060 --> 00:17:20,680
!رائعة يا كويوري-سينباي

293
00:17:21,060 --> 00:17:24,670
وصلت مُباريات الترتيب في المعسكر إلى الحدثِ الرّئيسي

294
00:17:24,670 --> 00:17:27,400
ستتنافس هاتان على المركزِ الأوَّل

295
00:17:29,970 --> 00:17:31,400
...من يا تُرى

296
00:17:31,400 --> 00:17:33,820
ستبتسمُ لها إلَهة النّصر؟

297
00:17:34,290 --> 00:17:36,080
!حظّاً سعيداً لكما

298
00:17:36,080 --> 00:17:38,360
حسناً، بهدوء

299
00:17:38,360 --> 00:17:40,420
كان هذا مُرجَّحاً أن يحدث، صحيح؟

300
00:17:40,420 --> 00:17:41,910
بالتأكيد

301
00:17:42,360 --> 00:17:44,660
،لا أدري كيف انتهى المطافُ بنا إلى هنا

302
00:17:44,660 --> 00:17:46,370
لكن هذا ما حدث، لذا سأستخدم كلّ قوَّتي

303
00:17:46,370 --> 00:17:47,830
أجل

304
00:17:55,160 --> 00:17:57,320
كلتاهما تلعبان بكلّ قوّتهما

305
00:17:57,320 --> 00:17:58,300
تبّاً

306
00:17:59,560 --> 00:18:00,860
يرجعني هذا للذكريات

307
00:18:01,270 --> 00:18:03,770
كانت كويوري هكذا منذُ اللحظة التي التقينا فيها

308
00:18:04,770 --> 00:18:07,290
،ظننتُها مجرّد فتاة خرقاء

309
00:18:07,810 --> 00:18:11,020
لكن تبيّنَ أنّها مختلِفة تماماً عندما تلعبُ كرة الطاولة

310
00:18:11,840 --> 00:18:13,990
دائماً ما تجعل نبضات قلبي تتسارع

311
00:18:15,570 --> 00:18:17,600
!لكن سأكون أنا من يربح

312
00:18:18,130 --> 00:18:19,410
ما رأيكِ بذلك؟

313
00:18:21,260 --> 00:18:22,780
.ردَّتْها. هذا طبيعيّ

314
00:18:23,640 --> 00:18:24,790
،أغاري-تشان

315
00:18:24,790 --> 00:18:26,700
!أحبُّ كرة الطاولة

316
00:18:34,070 --> 00:18:36,130
ها أنا ذي يا أغاري-تشان

317
00:18:36,130 --> 00:18:37,560
ابقي يقِظة

318
00:18:40,160 --> 00:18:42,390
!هذه أنا

319
00:18:45,730 --> 00:18:46,560
!سأتلقّاها بملء إرادتي

320
00:18:47,770 --> 00:18:51,600
هذا هو ردِّي على النشوةِ المُسرِّعة لنبضات
القلب التي منحتِني إيّاها

321
00:18:53,900 --> 00:18:56,390
!هذه هي أنا

322
00:19:04,140 --> 00:19:05,540
...كانَتْ سريعة للغاية

323
00:19:05,540 --> 00:19:06,660
لدرجة أنَّني لم أرها...

324
00:19:09,030 --> 00:19:09,820
فعلتُها

325
00:19:10,560 --> 00:19:11,540
...كان ذلك

326
00:19:12,440 --> 00:19:14,090
!أغاري-تشان

327
00:19:14,090 --> 00:19:17,020
!مذهل! كانَتْ تِلك الضربة السَّاحِقة مذهلة

328
00:19:17,020 --> 00:19:20,180
!بواسطتها، أنا واثقةٌ أنَّكِ تستطيعين هزيمة أي لاعبة

329
00:19:20,180 --> 00:19:21,910
!نجحتِ يا أغاري-تشان

330
00:19:21,910 --> 00:19:23,540
كويوري؟

331
00:19:23,540 --> 00:19:26,100
!رائعة! أنتِ رائعة يا أغاري-تشان

332
00:19:26,550 --> 00:19:28,570
يا لها من مفاجأة

333
00:19:28,570 --> 00:19:30,640
هذا تقدُّمٌ رهيبٌ جدّاً

334
00:19:30,640 --> 00:19:33,520
...إذا تعلَّمَتْ أن تلعب هكذا متى أرادت

335
00:19:33,520 --> 00:19:36,290
!فستحقِّقُ عدداً هائلاً من الانتصارات

336
00:19:36,290 --> 00:19:40,850
وأيضاً لم تركِّز كويوري-تشان على إعادة
ضربات الدرايف الدائريّة فحسب

337
00:19:40,850 --> 00:19:42,330
بل واجهَتْها بضربتِها السّاحقة أيضاً

338
00:19:42,330 --> 00:19:45,870
تبّاً، ما خطبهما بالضبط؟

339
00:19:46,200 --> 00:19:47,620
!هنيئاً

340
00:20:00,310 --> 00:20:02,120
هذا إحساسٌ رائع

341
00:20:04,260 --> 00:20:05,980
ما-ما الأمر؟

342
00:20:05,980 --> 00:20:09,720
في الواقع، كنتِ حزينة عندما وصلنا أوّل
مرّة إلى المعسكر

343
00:20:10,130 --> 00:20:12,390
لهذا أنا سعيدةٌ لأنّ شعوركِ قد تحسّنَ الآن

344
00:20:13,760 --> 00:20:16,420
...لـ-لم أكن حزينة أو ما شابه

345
00:20:16,420 --> 00:20:18,630
ماذا؟ كنتِ كذلك حرفيّاً

346
00:20:21,030 --> 00:20:25,280
فـ-في الواقع، بفرَض أنّني أتحسّنُ فعلاً
فيعزو الفضلُ إليكِ

347
00:20:28,300 --> 00:20:31,070
أنتِ من منحَني اللّمحة الأساسيّة
لتحسينِ ضرباتي السّاحِقة

348
00:20:31,070 --> 00:20:33,750
...وتمرّنتِ معي

349
00:20:33,750 --> 00:20:35,080
أغاري-تشان

350
00:20:35,560 --> 00:20:40,590
...لـ-لذا، في الحقيقة

351
00:20:40,590 --> 00:20:44,050
شـ-شكراً لكِ

352
00:20:45,580 --> 00:20:46,300
العفو

353
00:20:48,070 --> 00:20:50,260
لكن كنتُ أردُّ لكِ الجميل فحسب

354
00:20:51,980 --> 00:20:56,310
فقد ساعدتِني على إيجادِ "البقعة الحلوة" سابقاً
لذا أفعل هذا لردِّ جميلكِ

355
00:20:56,720 --> 00:20:58,930
ردّ جميلي؟

356
00:21:00,040 --> 00:21:03,720
إ-إذاً حان دوري الآن لتدريبكِ مجدّداً

357
00:21:04,180 --> 00:21:08,320
فأنتِ لم تتقني استخدام البقعة الحلوة بعد، أليس كذلك؟

358
00:21:08,320 --> 00:21:11,690
سأدرّبُكِ وأساعدكِ على إتقانِها

359
00:21:12,670 --> 00:21:14,160
!لذا يمكننا أن نطمح لما هو أعلى

360
00:21:15,870 --> 00:21:18,880
إذاً سيكون دوري بعد ذلك

361
00:21:19,220 --> 00:21:21,420
ودوري بعدها

362
00:21:21,420 --> 00:21:23,550
!ودوري بعدها

363
00:21:25,500 --> 00:21:29,350
أرغبُ بالاستمرارِ في التّمرينِ معاً بهذا الشَّكل ونتحسّن

364
00:21:29,980 --> 00:21:31,810
انسي الرّغبة، بل سنفعل ذلك

365
00:21:31,810 --> 00:21:32,830
نعم

366
00:21:35,140 --> 00:21:37,960
ينبغي أن نعود، ستصلُ الحافلة إلى هنا قريباً

367
00:21:37,960 --> 00:21:38,940
أجل

368
00:21:46,400 --> 00:21:49,480
يمكننا أن نتحسّن كثيراً

369
00:21:49,480 --> 00:21:51,660
يمكننا الشُّعور بتسارُعِ نبضاتِ قلوبنا أكثر

370
00:21:52,480 --> 00:21:56,030
!معاً، يمكننا أن نتخطَّى ما نشاء من حدود

371
00:23:06,190 --> 00:23:07,780
!يمكنكِ فعلها يا كويوري-تشان

372
00:23:07,780 --> 00:23:09,900
!أعتمدُ عليكِ يا كويوري-تشان

373
00:23:09,900 --> 00:23:11,780
!انطلقي يا جديلة

374
00:23:11,780 --> 00:23:12,740
!لِباس داخلي خوخي

375
00:23:13,210 --> 00:23:14,990
!اربحي يا تسوموجيكازي-سان

376
00:23:15,570 --> 00:23:16,950
!تماسكي

377
00:23:16,950 --> 00:23:18,200
!نم! نم

378
00:23:18,500 --> 00:23:23,080
!اهزميها حتَّى الموت يا تسوموجيكازي كويوري

379
00:23:23,080 --> 00:23:24,670
!حريّ بكِ أن تربحي يا كويوري

380
00:23:24,670 --> 00:23:28,130
!اللّاعبة الوحيدة التي يُسمَح لكِ بالخسارةِ أمامها هي أنا

381
00:23:31,340 --> 00:23:34,150
!أحبُّ كرة الطاولة

382
00:23:34,640 --> 00:23:38,280
!كلّ ما أريده هو أن أشعرَ بنبضاتِ قلبي تتسارع معكِ