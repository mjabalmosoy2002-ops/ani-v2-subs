1
00:00:24,630 --> 00:00:26,490
!انتظريني

2
00:00:28,380 --> 00:00:30,400
!لنذهب إلى هناك بعدها

3
00:00:31,140 --> 00:00:34,000
!هيّا! ادفعيني أعلى

4
00:00:37,690 --> 00:00:39,460
!سقطت ماي-تشان من الأرجوحة

5
00:00:39,460 --> 00:00:41,520
!ورطة يا سينسي

6
00:00:43,320 --> 00:00:46,030
هل أنت بخير يا ماي-تشان؟

7
00:00:50,360 --> 00:00:53,490
.كثرت الحوادث على الأرجوحة مؤخرًا

8
00:00:53,490 --> 00:00:56,580
حسنًا، طبيعي أن يتعرض
.الأطفال لبعض الخدوش

9
00:00:56,580 --> 00:01:00,760
.مع ذلك، هذه هي المرّة الخامسة هذا الأسبوع

10
00:01:00,760 --> 00:01:02,520
.ودائمًا الأرجوحة هي السبب

11
00:01:02,520 --> 00:01:03,670
.توقفي

12
00:01:06,780 --> 00:01:09,220
ماذا يحدث هنا؟

13
00:01:09,220 --> 00:01:10,620
!تشيي-سينسي

14
00:01:10,620 --> 00:01:12,220
!افتعلت كايا-تشان شجارًا

15
00:01:12,220 --> 00:01:14,300
ماذا؟ مجددًا؟

16
00:01:16,140 --> 00:01:18,810
!دعني أركبها

17
00:01:18,810 --> 00:01:20,620
.لا يُسمح بركوب الأرجوحة

18
00:01:20,620 --> 00:01:23,100
!لماذا؟ كنتُ التالي في الدور

19
00:01:23,100 --> 00:01:24,210
.لا تصطفوا من أجلها

20
00:01:24,210 --> 00:01:25,190
!تنحّي

21
00:01:26,070 --> 00:01:27,840
.قطعًا لا

22
00:01:28,690 --> 00:01:30,070
!كايا-تشان

23
00:01:30,730 --> 00:01:32,670
.ها أنتِ ترفضين مجددًا

24
00:01:32,670 --> 00:01:35,540
.لا يمكنك رفض كلّ شيء

25
00:01:38,160 --> 00:01:40,190
.كايا-تشان

26
00:01:42,150 --> 00:01:45,080
هل أصبحت تشيي-سينسي
مسؤولة عن كايا-تشان؟

27
00:01:45,080 --> 00:01:48,840
سمعتُ أنّ المعلّمة السابقة اضطرت
.للاستقالة بسبب الضغط

28
00:01:48,840 --> 00:01:51,970
يبدو أنّ مشاكلها السلوكية
،تسبب شجارات كثيرة

29
00:01:51,970 --> 00:01:54,820
.لذا آمل أن تستطيع تشيي-سينسي التعامل معها

30
00:01:58,170 --> 00:02:01,060
...لا تديري وجهك. أنصتي لما

31
00:02:01,060 --> 00:02:02,350
!هربت

32
00:02:04,160 --> 00:02:07,240
إنّها المشاغبة التي يتحدث
عنها الجميع إذًا؟

33
00:02:07,760 --> 00:02:11,040
!انتظري يا كايا-تشان

34
00:02:17,490 --> 00:02:20,250
!مرحى

35
00:02:23,190 --> 00:02:24,790
!ليدفعني أحدكم

36
00:02:29,600 --> 00:02:30,800
!مجددًا

37
00:02:33,290 --> 00:02:37,640
!أكثر! أعلى! أعلى! أعلى

38
00:02:47,900 --> 00:02:50,610
.توقف رجاء

39
00:02:51,750 --> 00:02:53,400
!توقف

40
00:02:53,400 --> 00:02:55,260
!أنا خائف

41
00:02:55,260 --> 00:02:58,570
!سأسقط! كفى

42
00:03:08,340 --> 00:03:10,570
.تنحّ إن انتهيتَ

43
00:03:12,240 --> 00:03:14,170
هل أنتِ من دفعتني يا كايا-تشان؟

44
00:03:14,480 --> 00:03:18,260
أنتِ لئيمة! واصلتِ دفعي
!وكدتُ أسقط

45
00:03:18,260 --> 00:03:20,720
سأخبر سينسي... ماذا؟

46
00:03:24,980 --> 00:03:27,480
.هناك خطب هنا

47
00:03:27,900 --> 00:03:30,900
.لا، الأرجوحة طبيعية

48
00:03:28,660 --> 00:03:31,670
.أعلى. أعلى. أعلى

49
00:03:35,780 --> 00:03:39,240
سلسلة السقوط غير الطبيعية من الأرجوحة

50
00:03:39,240 --> 00:03:43,740
لم تكن بسبب إهمال الأطفال
.ولا بسبب مشاغب يثير مشاكل

51
00:03:46,270 --> 00:03:49,800
.ما تسبّب بها لم يكن من هذا العالم

52
00:03:50,890 --> 00:03:55,260
كانت تلك الأيادي تنتظر طفلًا
.ليجلس على الأرجوحة

53
00:03:56,160 --> 00:03:59,010
...وظلّت تترقب لحظة دفعه

54
00:04:00,010 --> 00:04:02,010
.ليسقط إليها

55
00:04:02,010 --> 00:04:07,160
.مجددًا. أعلى. أكثر. أكثر. أكثر. أكثر

56
00:04:07,940 --> 00:04:10,480
.أكثر

57
00:04:12,660 --> 00:04:18,770
وكانت ضحية أخرى ستسقط
.في قبضتها

58
00:04:22,700 --> 00:04:24,090
.لكن ذلك لم يحدث

59
00:04:29,390 --> 00:04:32,090
...لأنّ كايا-تشان

60
00:04:33,260 --> 00:04:36,870
.أقوى وسيطة روحانية

61
00:04:40,660 --> 00:04:42,060
.لا بأس الآن

62
00:04:44,640 --> 00:04:47,270
هل تريد لعب الأرجوحة معي؟

63
00:04:47,270 --> 00:04:51,190
!محال! إنّها مخيفة! الأرجوحة مخيفة

64
00:04:51,190 --> 00:04:53,140
!وأنتِ أيضًا مخيفة يا كايا-تشان

65
00:04:55,700 --> 00:04:58,660
.لستُ مخيفة

66
00:05:04,830 --> 00:05:07,620
ماذا...حدث للتو؟

67
00:06:44,970 --> 00:06:48,390
!غميضة

68
00:06:49,970 --> 00:06:53,510
...يقول الكتكوت ها أنا

69
00:06:53,510 --> 00:06:54,480
!ذا

70
00:06:55,510 --> 00:06:59,230
...يقول القط ها أنا

71
00:06:59,720 --> 00:07:00,620
!ذا

72
00:07:01,310 --> 00:07:04,820
...يقول الصبي ها أنا

73
00:07:05,830 --> 00:07:06,660
!ذا...

74
00:07:07,670 --> 00:07:11,080
...تقول الفتاة ها أنا

75
00:07:15,680 --> 00:07:21,960
.يقول أصدقائي ها نحن ذا

76
00:07:25,280 --> 00:07:28,970
صباح الخير، ميزوكي من
.روضة هاناموجي تتحدث

77
00:07:29,740 --> 00:07:31,740
.مرحبًا، والدة يومي-تشان

78
00:07:32,990 --> 00:07:37,980
.مؤسف. حسنًا، اعتني بنفسك

79
00:07:38,630 --> 00:07:41,620
يومي-تشان مصابة بحمى لذا
.غابت اليوم يا تشيي-سينسي

80
00:07:41,620 --> 00:07:42,730
!كايا-تشان

81
00:07:42,730 --> 00:07:45,490
ألم أخبرك ألّا ترفضي كلّ شيء؟

82
00:07:45,490 --> 00:07:48,280
!تقرأ أيكو-تشان هذا الكتاب الآن

83
00:07:48,280 --> 00:07:49,610
.غير مسموح بهذا

84
00:07:49,610 --> 00:07:52,230
!كايا-تشان

85
00:07:52,230 --> 00:07:55,120
.عجبًا. يبدو أنّك بدأتِ بداية قوية

86
00:07:55,500 --> 00:07:57,410
!أنت لئيمة

87
00:07:57,410 --> 00:07:58,990
!أكرهك يا كايا-تشان

88
00:08:00,970 --> 00:08:04,030
هل أردتِ قراءة الكتاب
لهذه الدرجة يا كايا-تشان؟

89
00:08:06,320 --> 00:08:09,620
.يصعب فهمها كالعادة

90
00:08:09,620 --> 00:08:12,510
.سيرهقك الإفراط في التفكير فقط

91
00:08:13,050 --> 00:08:16,550
طبيعي أن يتصرف الأطفال
.بحدّة حسب مزاجهم

92
00:08:16,550 --> 00:08:18,930
حقًا؟

93
00:08:20,790 --> 00:08:23,180
أهذا ما في الأمر حقًا؟

94
00:08:23,180 --> 00:08:27,350
.هدأت الأمور منذ حادثة الأرجوحة

95
00:08:28,140 --> 00:08:32,820
،منذ أن تعاملت كايا-تشان مع ذلك الوحش

96
00:08:33,110 --> 00:08:36,040
.بالكاد أُصيب أيّ طفل على الأرجوحة

97
00:08:36,750 --> 00:08:39,920
،إن كانت تلك الإصابات بسبب ذلك الوحش

98
00:08:40,680 --> 00:08:43,570
...وكانت كايا-تشان تعرف بشأنه

99
00:08:44,100 --> 00:08:49,170
،لا، مهلًا. هذا مستحيل
.لا بدّ أن بصري أوهمني

100
00:08:49,780 --> 00:08:52,090
.لا وجود للوحوش

101
00:08:57,600 --> 00:08:58,790
.سيئ

102
00:09:02,020 --> 00:09:03,860
...كايا-تشان! أيعقل أنّكِ

103
00:09:05,860 --> 00:09:07,440
!توقفي يا كايا-تشان

104
00:09:07,690 --> 00:09:12,380
،إن عبثتِ بالصفحات هكذا
.فلن يستطيع أصدقاؤك قراءة الكتاب

105
00:09:14,860 --> 00:09:17,080
!طفح الكيل

106
00:09:17,080 --> 00:09:19,160
!أنا غاضبة جدًا اليوم

107
00:09:19,160 --> 00:09:22,950
!أحضري لي كلّ الكتب التي عبثتِ بها! جميعها

108
00:09:22,950 --> 00:09:25,100
.اصبري يا تشيي-سينسي

109
00:09:28,150 --> 00:09:30,930
.كلّ هذه؟ هذا مريع

110
00:09:30,930 --> 00:09:33,270
ما سبب هذا التصرف؟

111
00:09:33,900 --> 00:09:36,110
.لأنّ هذه الكتب لا ينبغي فتحها

112
00:09:38,280 --> 00:09:39,600
كايا-تشان؟

113
00:09:41,270 --> 00:09:42,870
!يا كايا-تشان

114
00:09:42,950 --> 00:09:46,110
ماذا يحدث؟

115
00:09:46,590 --> 00:09:48,970
.إنّها ترفض كلّ شيء

116
00:09:48,970 --> 00:09:51,280
ليتها تخبرني بالسبب فقط. ماذا؟

117
00:09:58,410 --> 00:10:02,550
أكان هذا الكتاب مفتوحًا؟

118
00:10:12,170 --> 00:10:15,840
.حسنًا. عليّ أن أنزع الأشرطة بحذر

119
00:10:16,950 --> 00:10:19,220
.لأنّ هذه الكتب لا ينبغي فتحها

120
00:10:19,710 --> 00:10:23,350
.مع ذلك، لا أستطيع ترك الكتب هكذا

121
00:10:36,640 --> 00:10:40,370
.حسنًا. أزلتُ كلّ الأشرطة عن هذا الكتاب

122
00:10:40,370 --> 00:10:42,080
غميضة ها أنا ذا" إذًا؟"

123
00:10:42,080 --> 00:10:44,600
.كان لديّ هذا الكتاب في طفولتي أيضًا

124
00:10:45,250 --> 00:10:46,880
...ها أنا

125
00:10:46,880 --> 00:10:47,710
.ذا

126
00:10:49,310 --> 00:10:50,880
...ها أنا

127
00:10:50,880 --> 00:10:51,960
!ذا

128
00:10:58,240 --> 00:11:00,010
...ها أنا

129
00:10:58,900 --> 00:11:00,890
ما-ما هذا؟

130
00:11:01,570 --> 00:11:03,940
ها أنا... ها أنا

131
00:11:03,940 --> 00:11:07,400
...ها أنا

132
00:11:08,460 --> 00:11:10,400
الطيف: الكتاب المنبثق

133
00:11:11,230 --> 00:11:18,160
...ها أنا... ها أنا... ها أنا

134
00:11:12,330 --> 00:11:15,650
.لا ينبغي فتح الكتب التي أُغلقت بالغراء

135
00:11:19,120 --> 00:11:21,960
...ها أنا... ها أنا

136
00:11:19,350 --> 00:11:21,120
.ا-ابتعد

137
00:11:21,960 --> 00:11:26,100
لأنّها غالبًا وسيلة لحبس شيء

138
00:11:26,750 --> 00:11:29,130
.لا تريد أن تراه خارجًا

139
00:11:30,400 --> 00:11:33,670
...ها أنا... ها أنا

140
00:11:33,670 --> 00:11:34,720
!ذا

141
00:11:40,080 --> 00:11:42,760
كـ-كايا-تشان؟

142
00:11:43,550 --> 00:11:46,720
.لهذا أخبرتك ألّا تفتحيه

143
00:11:49,200 --> 00:11:53,040
أكنتِ تعرفين ما سيحدث لو
فُتِح الكتاب يا كايا-تشان؟

144
00:11:53,670 --> 00:11:54,370
.نعم

145
00:11:55,830 --> 00:12:01,280
كنتُ محقة. كانت كايا-تشان
.تحمي الجميع من الوحوش

146
00:12:03,280 --> 00:12:05,700
متى بدأ هذا يا كايا-تشان؟

147
00:12:13,750 --> 00:12:15,120
...عفوًا

148
00:12:16,320 --> 00:12:17,380
.تشيي-سينسي

149
00:12:17,380 --> 00:12:18,720
نـ-نعم؟

150
00:12:24,060 --> 00:12:26,060
.تلك كلّها سيئة

151
00:12:26,060 --> 00:12:29,560
!كتاب واحد سيئ يُفسد البقية؟

152
00:12:30,250 --> 00:12:32,680
...فـ-في هذه الحالة

153
00:12:33,830 --> 00:12:39,290
اتبعتُ ما قالته كايا-تشان
.وتخلّصتُ من الكتب سرًا

154
00:12:44,740 --> 00:12:50,470
عجبًا. لم يخبرني أحد أنّنا بحاجة للتخلص
.من هذا العدد من الكتب. يا للإهدار

155
00:12:51,600 --> 00:12:53,920
.سآخذها إلى مكتبة الكتب المستعملة

156
00:12:53,920 --> 00:12:57,060
.إلى اللقاء أيتها المديرة

157
00:12:57,060 --> 00:12:58,880
.إلى اللقاء

158
00:12:59,840 --> 00:13:03,390
.مكان الكتب مجهول في الوقت الحالي

159
00:13:18,380 --> 00:13:20,440
.هيّا بنا يا كايا

160
00:13:20,440 --> 00:13:21,680
.حسنًا

161
00:13:22,200 --> 00:13:26,630
.هل أصابني مرض ما؟ رأسي ثقيل

162
00:13:26,630 --> 00:13:28,790
.أبي

163
00:13:28,790 --> 00:13:30,080
نعم؟

164
00:13:31,250 --> 00:13:32,360
.شعرك مبعثر

165
00:13:34,750 --> 00:13:37,530
.حقًا؟ شكرًا يا كايا

166
00:13:40,700 --> 00:13:42,900
.نحن ذاهبان

167
00:13:46,060 --> 00:13:47,160
.كايا

168
00:13:56,150 --> 00:13:58,230
.أبي. براز كلب

169
00:13:58,530 --> 00:14:01,660
أين؟ أين؟

170
00:14:01,660 --> 00:14:02,860
هل دست عليه؟

171
00:14:10,370 --> 00:14:12,620
!افتحوا! افتحوا الباب

172
00:14:12,620 --> 00:14:15,630
!سينسي! ليفتح أحدكم الباب

173
00:14:15,630 --> 00:14:17,180
!هيّا، افتحوا

174
00:14:17,180 --> 00:14:19,380
!لا! ساعدوني

175
00:14:19,380 --> 00:14:23,540
!النجدة! ليفتح أحدكم الباب رجاء

176
00:14:23,540 --> 00:14:24,800
ما الخطب؟

177
00:14:24,800 --> 00:14:26,870
لِم تصرخ في الحمام؟

178
00:14:30,520 --> 00:14:33,140
!الباب لا ينفتح

179
00:14:32,070 --> 00:14:34,870
.ماذا؟ ها هو انفتح

180
00:14:40,030 --> 00:14:42,280
،وبسبب حدوث ذلك باستمرار

181
00:14:42,280 --> 00:14:47,280
المرحاض الثاني من جهة اليمين
خارج الخدمة لذا لا تستخدموه، اتفقنا؟

182
00:14:47,280 --> 00:14:52,280
هذا يعني أنّ الحمام سيزدحم لذا
.لا تنتظروا حتّى آخر لحظة

183
00:14:52,280 --> 00:14:54,310
!حسنًا

184
00:14:59,710 --> 00:15:02,040
!لا أستطيع التحمل! عليّ التبول

185
00:15:02,460 --> 00:15:05,750
!دعيني أدخل قبلك يا كايا-تشان

186
00:15:05,750 --> 00:15:08,380
.حسنًا، لكنّه مغلق

187
00:15:09,220 --> 00:15:12,140
!صحيح! نسيت أنّنا لا نستطيع استخدام هذا

188
00:15:12,140 --> 00:15:16,230
.قالت سينسي ألّا نتحمل حتّى نُبلّل أنفسنا

189
00:15:17,370 --> 00:15:21,150
.لم يكن بيدي حيلة
.كنتُ منشغلة باللعب

190
00:15:21,150 --> 00:15:22,360
!فكرة

191
00:15:22,830 --> 00:15:27,610
سأستخدم هذا المرحاض يا كايا-تشان
لذا هلّا تراقبين المعلّمة؟

192
00:15:27,610 --> 00:15:28,820
.لا

193
00:15:28,820 --> 00:15:30,250
لـ-لِم لا؟

194
00:15:30,250 --> 00:15:31,290
.سأتعرض للتوبيخ

195
00:15:32,270 --> 00:15:35,180
!لهذا طلبتُ منك أن تحرسي

196
00:15:35,180 --> 00:15:37,120
.ستعلقين بالداخل لذا أرفض

197
00:15:37,120 --> 00:15:39,950
!لن أعلق

198
00:15:39,950 --> 00:15:43,720
لكن إن حدث ذلك فعلًا
فتعالي لإنقاذي يا كايا-تشان

199
00:15:50,860 --> 00:15:52,720
.كان هذا وشيكًا

200
00:15:52,720 --> 00:15:55,140
.لنخرج من هنا قبل أن يُكتَشف أمري

201
00:15:57,640 --> 00:16:00,800
محال. ماذا؟

202
00:16:01,900 --> 00:16:03,750
...افتحي يا كايا-تشان

203
00:16:04,830 --> 00:16:06,670
!سينسي

204
00:16:04,830 --> 00:16:08,660
سأقع في مأزق إن
.ذهبت كايا-تشان لاستدعاء المعلّمة

205
00:16:08,660 --> 00:16:12,500
لكن ماذا لو بقيت
محبوسة هنا للأبد؟

206
00:16:14,250 --> 00:16:15,110
.افتح

207
00:16:15,450 --> 00:16:17,630
.افتح. افتح

208
00:16:18,190 --> 00:16:24,820
!افتح! افتح! افتح

209
00:16:26,620 --> 00:16:27,820
.انفتح

210
00:16:29,790 --> 00:16:34,730
.يُفتَح هذا الباب المغلق بسهولة من الخارج

211
00:16:34,730 --> 00:16:38,190
.لهذا لم يُسبّب أيّ ضرر حتّى الآن

212
00:16:38,770 --> 00:16:40,400
...لكن إن

213
00:16:39,620 --> 00:16:44,670
.لـ-لـ-لن يأتي أحد

214
00:16:43,410 --> 00:16:46,960
...لم يكن هناك أحد بالخارج ليفتحه

215
00:16:44,670 --> 00:16:46,690
.مسكينة. مسكينة

216
00:16:46,690 --> 00:16:50,660
.لن يأتي أحد لإنقاذك

217
00:16:50,660 --> 00:17:00,000
.لن يأتي أحد. مسكينة
.لن يأتي أحد. مسكينة

218
00:17:00,000 --> 00:17:02,520
.مسكينة

219
00:17:05,190 --> 00:17:06,800
.كايا-تشان

220
00:17:07,120 --> 00:17:08,170
.اذهبي إلى الغرفة الأخرى

221
00:17:08,700 --> 00:17:12,430
.مسكينة. مسكينة

222
00:17:15,210 --> 00:17:17,680
.سمعتُ نداءك يا ميتشان

223
00:17:18,220 --> 00:17:20,140
.تعالي لإنقاذي يا كايا-تشان

224
00:17:20,140 --> 00:17:24,450
.مسكينة. مسكينة

225
00:17:27,500 --> 00:17:28,620
.ها أنا أفعل

226
00:17:42,430 --> 00:17:45,880
هل تتذكرين ما قلناه سابقًا يا كايا-تشان؟

227
00:17:46,210 --> 00:17:49,090
.هذا المرحاض خارج الخدمة

228
00:17:49,090 --> 00:17:51,970
.صحيح. أي لا تلمسوه

229
00:17:52,470 --> 00:17:55,720
فكيف حدث هذا إذًا؟

230
00:17:58,220 --> 00:18:00,780
.هذا مبالغ فيه، حتّى لو كان مقلبًا

231
00:18:00,780 --> 00:18:02,780
لِم فعلتِ هذا؟

232
00:18:03,910 --> 00:18:04,940
...بسبب

233
00:18:05,890 --> 00:18:06,980
شبح؟

234
00:18:06,980 --> 00:18:10,580
تلقي كايا-تشان اللّوم على
.الشبح مجددًا يا سينسي

235
00:18:20,760 --> 00:18:22,620
أنت في الصف المتوسط، صحيح؟

236
00:18:22,620 --> 00:18:25,170
.أريدك أن تعبّري بكلماتك وتتحدثي معي

237
00:18:25,650 --> 00:18:27,530
هل تنصتين إليّ يا كايا-تشان؟

238
00:18:28,850 --> 00:18:30,530
!لم تكن هي

239
00:18:31,050 --> 00:18:33,930
.أنا من سببتُ الفوضى

240
00:18:34,270 --> 00:18:36,500
ما قصدك؟

241
00:18:36,500 --> 00:18:38,810
.كان عائقًا لذا فكرتُ في إصلاحه

242
00:18:38,810 --> 00:18:41,580
لكن الباب انخلع وانتهى بي
.الأمر بشطف الأدوات

243
00:18:41,580 --> 00:18:43,810
.جرى كلّ شيء بشكل خاطئ لذا أعتذر

244
00:18:43,810 --> 00:18:45,350
!تشيي-سينسي

245
00:18:51,070 --> 00:18:52,780
لِم كذبت؟

246
00:18:53,040 --> 00:18:56,420
لأنّه لا أحد سيُصدّقنا حتّى
.لو ألقينا اللوم على الشبح

247
00:18:56,420 --> 00:19:01,660
نعم، لكن إن استطعتِ رؤيته
...فربّما قد تراه المعلّمة الأخرى أيضًا

248
00:19:01,660 --> 00:19:04,660
.أنا؟ لا أستطيع رؤية أيّ أشباح

249
00:19:05,060 --> 00:19:07,590
.لم أعد أحتمل رؤية واحد آخر

250
00:19:07,590 --> 00:19:10,190
رأيتهِ بالصدفة فقط إذًا؟

251
00:19:10,670 --> 00:19:14,660
كيف عرفتِ أنّ شبحًا فعلها
إن كنتِ لا ترينهم إذًا؟

252
00:19:14,660 --> 00:19:17,760
.لأنّني أصدّقك يا كايا-تشان

253
00:19:19,650 --> 00:19:25,980
،سواء كانت صدفة أم لا
.أعلم الآن أنّك تحمين الجميع

254
00:19:26,060 --> 00:19:29,290
.لذا سأكون من تحميكِ يا كايا-تشان

255
00:19:30,740 --> 00:19:32,440
.تشيي-سينسي

256
00:19:35,860 --> 00:19:38,350
ميتشان؟

257
00:19:39,010 --> 00:19:41,680
...كايا-تشان، عفوًا

258
00:19:46,290 --> 00:19:48,500
.هيّا. استمعي لما ستقوله

259
00:19:51,630 --> 00:19:53,500
...عـ-عفوًا

260
00:19:54,460 --> 00:19:56,570
.آسفة لأنّني تركتك هنا

261
00:19:57,520 --> 00:19:58,810
...وأيضًا

262
00:19:59,750 --> 00:20:01,270
.شكرًا لك

263
00:20:07,150 --> 00:20:08,150
.العفو

264
00:20:18,320 --> 00:20:21,780
!إلى اللقاء يا سينسي

265
00:20:22,910 --> 00:20:25,500
.سيصل والدك قريبًا

266
00:20:25,500 --> 00:20:27,230
.أنا هنا يا كايا

267
00:20:29,490 --> 00:20:30,670
!أبي

268
00:20:32,300 --> 00:20:33,680
!مرحبًا بعودتك

269
00:20:35,590 --> 00:20:37,160
.شكرًا. عدت

270
00:20:45,050 --> 00:20:49,190
بالتفكير في الأمر، والدها
.من يوصلها ويصطحبها دائمًا

271
00:20:49,690 --> 00:20:52,270
ماذا تفعل والدتها؟

272
00:20:52,270 --> 00:20:55,440
.لم تسمعي بعد إذًا

273
00:20:57,200 --> 00:20:59,450
...إنّ والدة كايا-تشان

274
00:20:59,810 --> 00:21:01,530
.احملني يا أبي

275
00:21:01,530 --> 00:21:05,100
.ماذا؟ كتفاي متيبّسان اليوم

276
00:21:05,100 --> 00:21:06,870
.لذا احملني

277
00:21:06,870 --> 00:21:08,500
هل عليّ ذلك؟

278
00:21:09,860 --> 00:21:12,580
.عدنا

279
00:21:14,590 --> 00:21:16,710
...كايا، اغسلي يديك أولًا

280
00:21:16,710 --> 00:21:18,970
!مهلًا! لا تصعدي للأعلى

281
00:21:23,380 --> 00:21:27,220
سيكون كلّ شيء بخير ما دامت
.كايا-تشان أقوى وسيطة روحانية هنا

282
00:21:28,880 --> 00:21:30,000
...لكن

283
00:21:31,230 --> 00:21:32,730
...عدتُ يا أمّي

284
00:21:44,240 --> 00:21:48,370
.أمّك ليست بصحة جيّدة يا كايا لذا انزلي

285
00:21:51,500 --> 00:21:55,340
في هذه اللحظة، كايا-تشان وحدها
...أدركت وجود شيء

286
00:21:56,080 --> 00:22:00,610
شيء لم تستطع هزيمته
.حتّى وهي أقوى وسيطة روحانية