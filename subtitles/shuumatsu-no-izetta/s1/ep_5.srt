1
00:00:12,310 --> 00:00:14,730
أورتفيني فريديريكا

2
00:00:15,140 --> 00:00:19,830
سيّدة لاندزبروك وحامية الطرق والوديان

3
00:00:20,280 --> 00:00:22,620
،محرِّرة جبال الألب

4
00:00:22,620 --> 00:00:24,750
وحاكمة إيلستادت

5
00:00:25,070 --> 00:00:29,000
هل أنتِ مستعدّة للحصول على لقبِ الأرشيدوقيّة؟

6
00:00:30,250 --> 00:00:31,320
أجل

7
00:00:32,260 --> 00:00:34,890
هل تقسمين أن تكرّسي نفسكِ

8
00:00:34,890 --> 00:00:37,510
لخدمةِ البلد وشعبه؟

9
00:00:38,400 --> 00:00:39,480
أقسم

10
00:00:40,720 --> 00:00:44,120
،إذاً قبّلي السيف الذي يمثّلُ روحَ أسلافنا

11
00:00:44,120 --> 00:00:45,980
وأتممي قسمَكِ

12
00:00:57,450 --> 00:01:01,880
فلتحلّ البركات على أرشيدوقيّة إيلستادت الجديدة

13
00:02:40,840 --> 00:02:44,280
تغصُّ أوروبّا بنيران الحرب

14
00:02:44,280 --> 00:02:45,770
،في هذه السّاعة الحرِجة

15
00:02:45,770 --> 00:02:49,500
،كان فقدان أب دولتنا، الأرشيدوق السّابق

16
00:02:49,500 --> 00:02:53,610
ضربة قاضية حقيقيّة

17
00:02:54,050 --> 00:02:59,050
أنا متأكّدة أنّ هناك من يتساءل ما إن كانَتْ
فتاة صغيرة عديمة الخبرة مثلي

18
00:02:59,050 --> 00:03:01,280
تستطيعُ أن تتولّى القيادة في وضعٍ كهذا

19
00:03:02,390 --> 00:03:05,660
!لكن لا تخف يا شعبي

20
00:03:05,660 --> 00:03:09,420
،لدينا حارسٌ يحمينا

21
00:03:09,420 --> 00:03:10,740
!وهو مُكافئ تماماً لسيفِ أسلافنا القديم هذا

22
00:03:11,590 --> 00:03:12,790
!اسمحوا لي أن أقدّمه لكم

23
00:03:14,920 --> 00:03:17,600
،حارسة إيلستادت

24
00:03:17,600 --> 00:03:20,090
سليلة السّاحرة البيضاء الأسطوريّة

25
00:03:20,090 --> 00:03:22,040
!صديقتي إيزيتّا

26
00:03:24,260 --> 00:03:25,290
تطير؟

27
00:03:25,290 --> 00:03:26,190
...هل هذه

28
00:03:26,190 --> 00:03:26,910
ساحرة؟

29
00:03:26,910 --> 00:03:27,770
أهي حقيقيّة؟

30
00:03:41,690 --> 00:03:44,140
لعلّ بعضكم قد سمعَ نبأ من هنا وهناك

31
00:03:44,140 --> 00:03:46,480
سمعتُم الإشاعات التي تفيدُ بتدمير السّاحرة

32
00:03:46,480 --> 00:03:48,650
،لطائرات الجيش الغازي طائرة تلو الأخرى

33
00:03:48,650 --> 00:03:51,930
،وتحطيمها لدبّاباتهم

34
00:03:51,930 --> 00:03:55,330
!مُدافِعةً عن قلعة كينينبيرغ

35
00:03:55,600 --> 00:03:58,570
!نعم، أحسنتُما صنعاً

36
00:03:58,570 --> 00:04:01,170
...اهدأوا واثبتوا

37
00:03:58,570 --> 00:04:01,170
الإشاعات صحيحة

38
00:04:01,670 --> 00:04:06,440
!تتفوّقُ قوّتها وببساطة قوّة أحدث الأسلحة

39
00:04:14,410 --> 00:04:15,420
!الأميرة فيني

40
00:04:23,100 --> 00:04:25,130
،أقولُ لشعبي العزيز

41
00:04:25,130 --> 00:04:26,730
،وللعالم

42
00:04:26,730 --> 00:04:30,090
أعلنُ هاهُنا وباسمي

43
00:04:31,120 --> 00:04:33,850
أنّ أي شخص يهدّدُ إيلستادت

44
00:04:33,850 --> 00:04:37,020
!سيُواجه غضبَ السّاحرة

45
00:04:49,090 --> 00:04:50,270
!مُذهل

46
00:04:50,270 --> 00:04:51,440
،ظننتُهم سيُخبئونها

47
00:04:51,440 --> 00:04:53,660
!لكنّهم بدلاً من ذلك يعرضونها أمام الكاميرات

48
00:04:53,660 --> 00:04:57,400
!وقد أعلنوا عن تحدّينا

49
00:04:58,190 --> 00:05:00,360
!مذهل

50
00:05:00,360 --> 00:05:02,570
بيركمان، رأيك؟

51
00:05:02,860 --> 00:05:03,700
بالطبع

52
00:05:03,700 --> 00:05:06,930
كنتُ حاضراً خلال استجواب القوّات

53
00:05:06,930 --> 00:05:08,530
التي هُزِمَتْ في كينينبيرغ

54
00:05:08,880 --> 00:05:11,650
قوّتها حقيقيّةٌ بالفعل

55
00:05:11,650 --> 00:05:14,990
طلبتُ مُعاينة الصور المُلتقطة لكينينبيرغ وحفل التتويج

56
00:05:14,990 --> 00:05:19,420
وأفاد التّقرير إلى أنّه لا يوجدُ أي زَيف في ذلك

57
00:05:19,890 --> 00:05:25,050
أريدُ هذه السّاحرة إيزيتّا مهما كلّفَ الأمر

58
00:05:25,050 --> 00:05:29,120
هل تسمحُ لي بالتحدث سموّك؟

59
00:05:29,120 --> 00:05:30,280
بالطبع

60
00:05:30,280 --> 00:05:33,770
فهذا هو سببُ وجودك هُنا يا إليوت

61
00:05:33,770 --> 00:05:38,780
هدفنا الأصليّ من غزو إيلستادت

62
00:05:38,780 --> 00:05:41,740
كان تأمين طريق بين الامبراطوريّة

63
00:05:41,740 --> 00:05:45,020
وحلفائنا في اتّحاد رومولوس

64
00:05:45,020 --> 00:05:47,420
وتسهيل نقل القوّات

65
00:05:47,420 --> 00:05:51,540
والمُؤن إلى أفريقيا أو البحر المتوسّط

66
00:05:52,920 --> 00:05:55,540
لا تنسَ ذلك من فضلك

67
00:05:55,540 --> 00:05:56,560
بالطبع

68
00:05:56,560 --> 00:05:58,540
معك حقّ

69
00:05:58,540 --> 00:06:03,750
نحتاجُ لخطّةٍ لغزو إيلستادت وأسر تِلك السّاحرة

70
00:06:04,210 --> 00:06:09,160
أعتقدُ أنّه من الحكمةِ أن نقرّر حالما نرى خطوتهم التّالية

71
00:06:09,160 --> 00:06:10,640
خطوتهم التّالية؟

72
00:06:10,640 --> 00:06:11,480
أجل

73
00:06:11,480 --> 00:06:13,940
،إذا صحَّتْ تخميناتي

74
00:06:14,400 --> 00:06:16,770
،الآن بعدما روّجوا عنها للعالم

75
00:06:17,440 --> 00:06:20,970
سيشرعون بمُهاجمتنا مباشرة

76
00:06:24,360 --> 00:06:27,050
سموّك، تقرير

77
00:06:27,050 --> 00:06:28,320
تكلّم

78
00:06:28,320 --> 00:06:31,230
رسالة طارئة من فرقة المُشاة 183

79
00:06:31,230 --> 00:06:34,700
التي كانَتْ تُحاصر بريستليتش قُربَ بُحيرة رودين

80
00:06:35,320 --> 00:06:38,330
!شنّت ساحرة إيلستادت هجوماً مُباغِتاً

81
00:06:38,330 --> 00:06:39,160
حقّاً؟

82
00:06:39,750 --> 00:06:40,550
نعم

83
00:06:45,090 --> 00:06:47,960
يريدونها أن تُقاتِل أمام الصّحفيين

84
00:06:47,960 --> 00:06:51,980
واستعراض قوّتها القاهِرة أمام الكاميرات

85
00:06:52,390 --> 00:06:56,380
حينئذ سيضطرُّ العالم كلّه للاعتراف
،بوجود السّاحرة

86
00:06:56,970 --> 00:07:00,760
وقوّتها المُرعبة

87
00:07:44,230 --> 00:07:45,500
!سآخذ هذه

88
00:07:48,060 --> 00:07:49,490
...رائع

89
00:07:49,490 --> 00:07:50,600
!طائرات العدوّ

90
00:07:57,860 --> 00:08:00,330
!انطلقي

91
00:08:05,010 --> 00:08:09,550
ساحرة في عصرنا هذا تهيمنُ على ساحات القتال

92
00:08:23,200 --> 00:08:24,390
ساحرة؟

93
00:08:47,040 --> 00:08:48,590
فرقة؟

94
00:08:48,590 --> 00:08:50,380
هذه المقالة مُبالَغ بها

95
00:08:50,870 --> 00:08:52,950
لم تهزم سوى كتيبة فقط

96
00:08:53,560 --> 00:08:56,090
انتقلَ جيشُنا من مرحلة جيش لا يُقهَر

97
00:08:56,090 --> 00:08:57,980
إلى خاسِر مرّتَين

98
00:08:58,980 --> 00:09:02,330
لا ألوم الحُلفاء على تحمّسهم

99
00:09:03,000 --> 00:09:06,520
أشعرُ بالإحباطِ كلّما تذكّرتُ أنّنا تركناها تذهب

100
00:09:07,000 --> 00:09:10,150
سموّه يستمتعُ بهذا الوضع

101
00:09:10,760 --> 00:09:15,400
خُوِّلنا بتوظيف أكبر عدد من العامِلين
وإنفاق قدرَ ما نشاء من مال

102
00:09:16,530 --> 00:09:18,490
هل كنت أنت من استدعاني؟

103
00:09:18,800 --> 00:09:20,530
النّقيب باسلر

104
00:09:20,530 --> 00:09:22,040
لم نلتقِ من قبل

105
00:09:22,040 --> 00:09:24,130
كيف عرفتَ أنّه أنا؟

106
00:09:24,130 --> 00:09:28,080
بحثتُ عن أكثر الرجال غموضاً في الحانة فحسب

107
00:09:29,320 --> 00:09:30,320
حسناً؟

108
00:09:30,320 --> 00:09:32,050
ماذا تريدُ منّي الوحدة الخاصّة؟

109
00:09:32,340 --> 00:09:34,100
أريدُ أن أسمع إلى ما لديك

110
00:09:34,560 --> 00:09:36,520
،لم تذكر ذلك في تقريرك

111
00:09:36,520 --> 00:09:41,260
لكنّها كانَتْ هي من أسقطَتْك أنت ورجالك، صحيح؟

112
00:09:48,560 --> 00:09:52,010
ما كان أحد ليصدّقني لو قلتُ ذلك حينها

113
00:09:52,010 --> 00:09:53,830
...إذاً كان فعلاً

114
00:09:53,830 --> 00:09:56,360
ما رأيك بقوّتها؟

115
00:09:57,320 --> 00:09:59,000
جنونيّة

116
00:10:00,450 --> 00:10:02,520
لم تُسعفنا كلّ معلوماتنا التي نعرفها

117
00:10:03,440 --> 00:10:06,820
كانَتْ تسيرُ بسرعة 400 كم/سا راكبةً
بندقيّة مع فتاةٍ أخرى

118
00:10:06,820 --> 00:10:08,620
ناورَتْ كطائر خطّاف المخازن

119
00:10:09,030 --> 00:10:13,480
كانت تِلك البندقيّة سلاحاً نموذجيّاً امبراطوريّاً
حسبما قيل لي

120
00:10:14,400 --> 00:10:18,340
لكن لم يمنحوها قدرة الطيران

121
00:10:18,710 --> 00:10:21,340
إنّها ليسَتْ داخل مركبة تجعلُها صغيرة
ويصعبُ إصابتها

122
00:10:22,050 --> 00:10:24,620
لم يستطع أحدٌ مُجاراتها في نِزالٍ جويّ

123
00:10:26,950 --> 00:10:28,180
فيما عدايّ

124
00:10:28,850 --> 00:10:30,010
نجحت

125
00:10:30,010 --> 00:10:31,900
ستتلقّى الأمرَ قريباً

126
00:10:31,900 --> 00:10:33,620
نعتمدُ عليك يا حضرة النّقيب

127
00:10:34,960 --> 00:10:37,400
،ستعملُ لحسابي

128
00:10:37,690 --> 00:10:40,490
وتُساعدنا على اصطيادِ ساحرة إيلستادت

129
00:10:44,790 --> 00:10:47,660
هذا شرفٌ لي يا حضرة الرّائد

130
00:10:56,450 --> 00:10:58,510
،بحسبِ ما قالَه النّقيب باسلر

131
00:10:58,510 --> 00:11:00,960
هل السّاحرة لا تُقهَر حقّاً؟

132
00:11:00,960 --> 00:11:02,500
لستُ متأكّداً من ذلك

133
00:11:03,080 --> 00:11:05,660
بعد سماع ما قالَتْه، أنا واثق

134
00:11:05,660 --> 00:11:08,360
قوّتها ليسَتْ قوّة لا تُقهَر

135
00:11:09,830 --> 00:11:11,390
استغرقَتْ يومين كاملين

136
00:11:11,390 --> 00:11:14,600
بين نزالها مع النّقيب ووصولها إلى كينينبيرغ

137
00:11:15,400 --> 00:11:19,330
ولم تنضمّ إلّا بعدما بدأت المعركة

138
00:11:19,330 --> 00:11:22,090
لو طارَتْ لاستطاعت الوصول إلى هناك في غضون دقائق

139
00:11:22,930 --> 00:11:23,700
لماذا؟

140
00:11:24,720 --> 00:11:27,210
هذا غريب

141
00:11:27,210 --> 00:11:29,690
،ولو كانَتْ لا تُقهَر

142
00:11:29,690 --> 00:11:32,670
فبدلاً من مُحاولة التباهي بقوّتها

143
00:11:33,220 --> 00:11:37,800
بمقدورهم إرسالها إلى برلين الجديدة لتقتل الامبراطور

144
00:11:38,470 --> 00:11:42,040
حينئذ ستنتهي الحربُ فوراً

145
00:11:42,980 --> 00:11:45,190
،السّاحرة قويّة

146
00:11:45,190 --> 00:11:47,510
لكنّها ليسَتْ لا تُقهَر

147
00:11:48,340 --> 00:11:51,060
،فلو كانَتْ لا تُقهَر كما تقول

148
00:11:51,480 --> 00:11:55,970
لرأيت السّاحرات يحكمنَ العالم الآن

149
00:11:55,970 --> 00:11:57,720
لكنّهن لسن كذلك

150
00:11:58,210 --> 00:12:02,420
،ما يعني أنّ لقوّتها حدود ما

151
00:12:02,800 --> 00:12:04,700
أو نقطة ضعف

152
00:12:07,540 --> 00:12:09,450
وماذا سنفعل إذاً؟

153
00:12:11,880 --> 00:12:13,270
لا شيء

154
00:12:14,900 --> 00:12:17,630
سيسأم القادةُ من الانتظار

155
00:12:17,630 --> 00:12:20,180
ويقترحون على الامبراطور أن نُهاجم

156
00:12:20,960 --> 00:12:24,280
يمكننا أن نتصرّف بعد ذلك

157
00:12:35,680 --> 00:12:39,150
أعتقدُ أنّ مُعظم الأمور سارَتْ كما هو مُخطَّط

158
00:12:39,150 --> 00:12:40,060
نعم

159
00:12:40,060 --> 00:12:42,740
بدأ الناسُ بالإيمانِ بوجود السّاحرة

160
00:12:43,170 --> 00:12:45,850
نتلقّى رسائل خطِّية من دُول من كلّ أنحاء العالم

161
00:12:45,850 --> 00:12:47,660
تطلبُ التأكيد على المسألة

162
00:12:47,660 --> 00:12:50,280
وبعضهم الآخر يأملون اللّقاء بالأميرة فيني

163
00:12:51,670 --> 00:12:54,130
أعلمُ أنّه من الغريب أن أقول هذا
بعدما كنّا نحنُ من خطّطَ للأمر

164
00:12:54,130 --> 00:12:58,790
لكنّني مُندهش من تصديق الجميع لهذه الحكاية الخرافيّة

165
00:12:59,270 --> 00:13:00,890
حكاية خرافيّة؟

166
00:13:02,080 --> 00:13:03,550
ربّما لهذا السّبب

167
00:13:04,800 --> 00:13:08,440
تُصبح جرمانيا عدوّة العالم أجمع

168
00:13:09,680 --> 00:13:13,680
وها هي يتمُّ دحرها بواسطة فتاةٍ واحدة

169
00:13:14,260 --> 00:13:16,780
سواء أكانت مزيّفة أم لا، تبقى قصّة مُثيرة

170
00:13:16,780 --> 00:13:19,120
وإن كانَتْ حقيقيّة، فهذا أفضل فأفضل

171
00:13:19,120 --> 00:13:21,460
كان ذلك جزءاً من الخطّة، صحيح؟

172
00:13:21,910 --> 00:13:22,380
أجل

173
00:13:22,380 --> 00:13:24,110
!هذه هي أميرتي فيني

174
00:13:24,110 --> 00:13:25,450
أنتِ ذكيّةٌ للغاية

175
00:13:25,450 --> 00:13:29,050
ينبغي أن تثني على إيزيتّا، لا أنا

176
00:13:29,760 --> 00:13:33,260
أنتِ تؤدّين عملكِ على أكمل وجه

177
00:13:33,620 --> 00:13:37,580
أ-أنا أفعلُ ما طُلِبَ منّي فحسب

178
00:13:38,340 --> 00:13:42,050
أنا سعيدةٌ حقّاً لأنّني استطعتُ أن أكون
مُفيدة للجميع

179
00:13:43,520 --> 00:13:47,050
إذاً أهذا هو النِطاق الذي تستطيعُ ضمنه
استخدام سحرها؟

180
00:13:47,440 --> 00:13:51,140
أجل، إنّها نسخةٌ عن الخريطةِ التي في سردابِ القلعة

181
00:13:51,140 --> 00:13:55,960
يمكنُها استخدام قوّتها ضمن نِطاق
أوسع ممّا توقّعت

182
00:13:55,960 --> 00:13:57,290
!أنا آسفة

183
00:13:57,290 --> 00:14:01,020
لو كنتُ أستطيعُ استخدامها في أيّ مكان
لارتقيتُ لتوقُّعات الجميع

184
00:14:01,460 --> 00:14:03,640
لا، أنا لا ألومكِ

185
00:14:03,640 --> 00:14:05,110
لا تسيئي الفهم

186
00:14:05,110 --> 00:14:08,680
لكنّنا الآن استطعنا هزيمة الجرمانيين مرّتَين

187
00:14:08,680 --> 00:14:10,470
،دون الكشف عن نقطةِ ضعفنا

188
00:14:10,930 --> 00:14:13,450
وأثبتنا للعالمِ قوّتنا

189
00:14:14,180 --> 00:14:17,840
ألن يجعل هذا الهجومَ بالنسبةِ للجرمانيين أصعب؟

190
00:14:17,840 --> 00:14:19,540
...آملُ ذلك

191
00:14:23,800 --> 00:14:25,900
هُنا مكتب الأرشيدوقيّة

192
00:14:26,340 --> 00:14:27,220
نعم

193
00:14:29,520 --> 00:14:30,700
مفهوم

194
00:14:30,700 --> 00:14:31,760
سأبلغُها

195
00:14:34,370 --> 00:14:36,850
بدأت جرمانيا بتقدّمها

196
00:14:37,100 --> 00:14:38,360
أين؟

197
00:14:38,360 --> 00:14:39,860
معبر فيالي

198
00:14:43,720 --> 00:14:44,920
...من بين كلّ الأماكن

199
00:14:44,920 --> 00:14:46,430
لدينا خطّة

200
00:14:46,430 --> 00:14:47,070
ماذا؟

201
00:14:47,070 --> 00:14:49,560
كان هذا مُتوقّعاً

202
00:14:49,560 --> 00:14:51,960
تحدّثتُ مع الأميرة فيني حول الأمر

203
00:14:53,790 --> 00:14:58,260
إيزيتّا، كان الكشف عنكِ للعالم مُجازفة كبيرة

204
00:14:58,690 --> 00:15:02,010
وستكونُ هذه المعركة المُقبِلة هي ما ستحدّد

205
00:15:02,010 --> 00:15:03,630
فوزنا للرِّهان من عدمه

206
00:15:20,360 --> 00:15:23,670
!يا رجال، السّاحرة مزيّفة

207
00:15:24,390 --> 00:15:27,230
لا تنخدعوا بالتهويل الإعلامي الذي تتّبِعُه دولةٌ ضعيفة

208
00:15:27,640 --> 00:15:30,240
!نحنُ لا نُؤمن إلّا بقوّة السّلاح

209
00:15:30,770 --> 00:15:32,650
!تقدّموا

210
00:15:43,410 --> 00:15:44,500
!ابقَ منخفضاً يا يوناس

211
00:15:45,110 --> 00:15:45,800
!حاضر

212
00:15:45,800 --> 00:15:47,340
يُحاولون اجتياحنا

213
00:15:47,340 --> 00:15:48,550
علينا عرقلتهم بطريقةٍ ما

214
00:15:49,190 --> 00:15:50,890
رسالة من قائد السريّة

215
00:15:50,890 --> 00:15:52,260
!تراجعوا 300 متراً

216
00:15:52,930 --> 00:15:54,680
سنتراجع مجدّداً؟

217
00:15:54,680 --> 00:15:56,510
أنا متأكّدٌ أنّنا نكتسبُ الوقت

218
00:15:57,160 --> 00:15:59,680
ستصلُ إيزيتّا إلى هنا قريباً

219
00:15:59,680 --> 00:16:01,810
ومن ثمّ ستقضي عليهم

220
00:16:02,060 --> 00:16:04,640
...أنت وساحرتك تلك

221
00:16:04,640 --> 00:16:06,250
إنّها مذهلةٌ حقّاً

222
00:16:06,250 --> 00:16:07,580
!عندما تراها ستندهش

223
00:16:07,580 --> 00:16:08,900
!ممنوع الكلام

224
00:16:15,620 --> 00:16:18,200
...سيّدي، ينبغي أن تتراجع أكثر

225
00:16:18,200 --> 00:16:19,210
لا مُشكلة

226
00:16:19,210 --> 00:16:22,160
إذا سقطَ هذا المكان فستهلك إيلستادت

227
00:16:22,580 --> 00:16:25,320
...قال سيغ أنّه لديه خطّة، لكن

228
00:16:29,190 --> 00:16:30,470
...ضباب

229
00:16:30,470 --> 00:16:32,380
السّماء معنا

230
00:16:33,380 --> 00:16:37,110
يريدُ الجرمانيّون ممرّاً لحُلفائهم في اتّحاد رومولوس

231
00:16:37,650 --> 00:16:40,640
لذا لن يلجؤوا لأسلوب العنف كالقصف

232
00:16:41,390 --> 00:16:44,340
لهذا يُرسِلون قوّات برّية بدلاً من ذلك

233
00:16:44,340 --> 00:16:48,170
يجبُ أن نهزمهم قبل أن يصلوا إلى العاصمة

234
00:16:48,660 --> 00:16:50,220
تمّ إعطائكِ المُلخّص، صحيح؟

235
00:16:50,680 --> 00:16:53,240
...أجل، لكن

236
00:16:56,530 --> 00:16:58,010
أتفهّم شعوركِ

237
00:16:58,450 --> 00:17:00,600
لكن هذا لمصلحة الجميع

238
00:17:00,600 --> 00:17:03,660
بيانكا، هل كلّ شيء جاهز؟

239
00:17:03,660 --> 00:17:04,300
أجل

240
00:17:04,300 --> 00:17:07,040
حشدنا الحرَس الملكيّ بأكمله وتمكنّا
من الوصول على الموعد بطريقةٍ ما

241
00:17:07,720 --> 00:17:10,640
الحرَس الملكيّ هم رجالٌ ونساءٌ مُوالون

242
00:17:10,640 --> 00:17:13,720
خدموا عائلة إيلستادت منذُ تأسيس البلد

243
00:17:13,720 --> 00:17:16,730
ودعمونا من وراء الكواليس

244
00:17:17,140 --> 00:17:21,160
يفضِّلون الموت على الكشفِ عن سرّكِ

245
00:17:21,160 --> 00:17:23,600
نُقسمُ أن نُقاتل معكِ

246
00:17:24,370 --> 00:17:25,790
...بيانكا

247
00:17:25,790 --> 00:17:26,700
،فخامتكِ

248
00:17:27,060 --> 00:17:29,860
اجتازَت القوّات الجرمانيّة النقطةَ المُحدّدة

249
00:17:30,550 --> 00:17:31,960
تمّ تهيئة الوضع

250
00:17:31,960 --> 00:17:33,500
!ابدأن بالمهمّة

251
00:17:33,500 --> 00:17:33,930
!حاضر

252
00:17:33,930 --> 00:17:34,900
انتظروا

253
00:17:36,600 --> 00:17:37,910
لديّ طلب

254
00:17:42,880 --> 00:17:44,460
!ألا يمكننا أن نسرع أكثر؟

255
00:17:44,460 --> 00:17:45,590
!تقترب طائرات العدوّ

256
00:17:46,230 --> 00:17:46,920
كم عددها؟

257
00:17:46,920 --> 00:17:48,040
!ثلاثة

258
00:17:48,470 --> 00:17:50,500
...لحظة، هذه

259
00:17:52,750 --> 00:17:53,960
!إنّها تحلّق

260
00:17:53,960 --> 00:17:54,960
!ها هي

261
00:17:55,830 --> 00:17:57,580
!ساحرة إيلستادت

262
00:18:20,690 --> 00:18:24,600
!أنا ساحرةُ إيلستادت البيضاء

263
00:18:25,810 --> 00:18:27,080
!إيزيتّا

264
00:18:27,760 --> 00:18:29,040
...مستحيل

265
00:18:29,320 --> 00:18:31,120
أيّها الجنود الجرمانيّون

266
00:18:31,120 --> 00:18:34,000
أنا متأكّدةٌ أنّكم سمعتُم بقوّتي

267
00:18:34,610 --> 00:18:36,200
،الآن بعدما وصلتُ إلى هنا

268
00:18:36,200 --> 00:18:39,590
!لن يُسمَح لكم باتّخاذ خطوة أخرى

269
00:18:41,290 --> 00:18:42,660
!لن أدعكم

270
00:18:46,220 --> 00:18:47,800
!استسلموا

271
00:18:47,800 --> 00:18:52,270
!أو واجهوا غضبَ السّاحرة

272
00:18:52,520 --> 00:18:53,450
!اصمتي

273
00:18:53,450 --> 00:18:58,200
لن تستسلم الامبراطوريّة الجرمانيّة العظيمة
لساحرة من حكاية خرافيّة

274
00:18:58,200 --> 00:18:58,820
!توقّفوا

275
00:19:00,890 --> 00:19:01,490
!توقّفوا

276
00:19:06,840 --> 00:19:07,750
!توقّفوا

277
00:19:10,120 --> 00:19:11,210
!لا جدوى

278
00:19:11,790 --> 00:19:12,920
...تبّاً لكِ

279
00:19:13,330 --> 00:19:16,920
يبدو أنّكم مصرّين على مُواجهة غضبي إذاً

280
00:19:17,780 --> 00:19:18,570
!أطلقوا

281
00:19:20,340 --> 00:19:22,060
!أنا إيزيتّا

282
00:19:22,060 --> 00:19:24,280
يا أرواح الأرض غنوم

283
00:19:24,280 --> 00:19:26,300
!استجيبي لنِدائي

284
00:19:29,780 --> 00:19:31,280
،وبقوّتكِ

285
00:19:31,280 --> 00:19:33,980
دعي غضبي يحلُّ على أولئك

286
00:19:33,980 --> 00:19:36,090
!الذين يُلوّثون هذه الأرض المُقدّسة

287
00:20:15,190 --> 00:20:18,040
ساحرة جيشنا مُذهلة

288
00:20:18,680 --> 00:20:19,770
!ابق يقظاً

289
00:20:19,770 --> 00:20:22,160
!عليك بتحرّي الوضع والتّبليغ

290
00:20:22,160 --> 00:20:22,780
!حاضر

291
00:20:26,150 --> 00:20:27,580
هل أنتِ بخير يا إيزيتّا؟

292
00:20:29,010 --> 00:20:30,150
نعم

293
00:20:30,150 --> 00:20:33,210
حالما أدركتُ أنّها انتهت، زال
التوتُّر عن جسدي

294
00:20:33,640 --> 00:20:35,100
...تبّاً

295
00:20:35,100 --> 00:20:39,560
من الصّعب أن أصدِّق أنّكِ كنتِ نفس
الفتاة التي كانَتْ تصرخ في وجه ذلك الجيش الضخم

296
00:20:39,560 --> 00:20:40,680
،آنذاك

297
00:20:41,120 --> 00:20:46,220
قرّرتُ ذلك لأنّكم فعلتُم ما بوسعكم
جميعاً لتتجهّزوا

298
00:20:47,270 --> 00:20:49,000
كان عليّ أن أفعل ما بوسعي أيضاً

299
00:20:50,400 --> 00:20:51,600
هيّا بنا نعود

300
00:20:51,600 --> 00:20:54,270
أنا متأكّدة أنّ الأميرة فيني قلقةٌ جدّاً عليكِ

301
00:20:54,950 --> 00:20:55,740
!حاضر

302
00:20:56,850 --> 00:20:57,880
هكذا إذاً

303
00:20:57,880 --> 00:20:58,780
شكراً لك

304
00:21:01,760 --> 00:21:05,900
هُزِمَتْ قوّاتنا بواسطة السّاحرة في معبر فيالي مجدّداً

305
00:21:06,640 --> 00:21:09,080
استخدمَتْ هذه المرّة سحرها لإحداث
انهيار صخريّ

306
00:21:09,590 --> 00:21:12,080
أتظنُّ أنّها ليسَتْ لديها نقاط ضعف على الإطلاق؟

307
00:21:12,430 --> 00:21:13,580
لا بل لديها

308
00:21:13,580 --> 00:21:15,590
إنّها الطريقةُ الوحيدةُ لتفسير الأمور

309
00:21:16,520 --> 00:21:19,820
أرسلتَ جاسوساً لاختراقِ جيش إيلستادت، صحيح؟

310
00:21:19,820 --> 00:21:20,640
أجل

311
00:21:20,640 --> 00:21:22,420
لكنّه ضابط برتبة متدنّية

312
00:21:22,760 --> 00:21:25,380
آمل أن يعثر على شيء

313
00:21:28,120 --> 00:21:29,520
!السّاحرة مذهلة

314
00:21:29,520 --> 00:21:31,830
!يستطيعُ أولئك الجرمانيّون العودة مجدّداً في أي وقت

315
00:21:31,830 --> 00:21:34,100
حضرة قائد الفصيل، أين جوناس؟

316
00:21:35,560 --> 00:21:36,510
يحضر الماء

317
00:22:00,050 --> 00:22:02,760
ما الذي تفكّر به يا سيغهارت ميولر؟

318
00:22:02,760 --> 00:22:04,250
ماذا تعني؟

319
00:22:04,250 --> 00:22:05,850
!أجبني فحسب

320
00:22:05,850 --> 00:22:08,400
كان ذلك الشيء برمّته مجرَّد تخطيط

321
00:22:08,400 --> 00:22:10,260
هل استغللتَ الحرَس الملكيّ؟

322
00:22:10,520 --> 00:22:11,290
أجل

323
00:22:11,290 --> 00:22:14,570
،عدد قليل من المحلّيين يعلمون بهذا

324
00:22:15,240 --> 00:22:20,150
لكن يوجد نفقُ تعدينٍ هُنا يعودُ لزمن الرُّوم

325
00:22:20,850 --> 00:22:23,740
زرعنا القنابلَ هُناك وفجّرناه

326
00:22:25,550 --> 00:22:27,390
كان ذلك عملاً مُتقناً

327
00:22:27,390 --> 00:22:30,570
لكن لماذا تكشفُ إيزيتّا نفسها أمام العدوّ؟

328
00:22:31,090 --> 00:22:35,040
فهي في هذا المكان مجرّد فتاة
لا تستطيعُ استخدام سحرها

329
00:22:35,760 --> 00:22:38,570
كانَتْ فكرتها

330
00:22:39,700 --> 00:22:44,500
كانت الخطّة الأصليّة استخدام فتاة
شبيهة من الحرَس الملكيّ

331
00:22:47,080 --> 00:22:49,220
!دعوني أفعلها أنا

332
00:22:49,220 --> 00:22:50,040
-ما الذي

333
00:22:50,040 --> 00:22:52,280
...قد يلتقطون صوراً أو ما شابه و

334
00:22:53,060 --> 00:22:54,140
لا أستطيع الجلوس

335
00:22:54,880 --> 00:22:58,900
مكتوفة الأيدي وأكتفي بمراقبةِ الجميع
يتعرّضون لخطر

336
00:22:59,330 --> 00:23:01,540
!فقط لأنّني لستُ قويّة بما يكفي

337
00:23:02,580 --> 00:23:06,250
تعلمُ كم هي عنيدة حالما تخطر فكرةٌ على بالها، صحيح؟

338
00:23:06,720 --> 00:23:09,350
...حتّى الأميرة فيني استسلمت في النّهاية

339
00:23:11,700 --> 00:23:12,510
!أنت

340
00:25:06,950 --> 00:25:09,930
"...الحلقة القادمة: "في يوم هادئ

341
00:25:10,980 --> 00:25:12,280
!يا للهول

342
00:25:12,280 --> 00:25:14,260
!صدر إيزيتّا-ساما