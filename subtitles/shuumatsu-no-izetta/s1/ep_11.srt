1
00:00:01,230 --> 00:00:02,940
اقتل السّاحرة

2
00:00:03,360 --> 00:00:06,230
كان ذلك أمر الأميرة

3
00:00:08,290 --> 00:00:13,710
لم يكن من الصّعب تخيُّل ما دفعَها لإصدار ذلك الأمر

4
00:00:13,710 --> 00:00:16,540
لكن لم تكن لدينا أي وسيلة للمقاومة

5
00:00:17,320 --> 00:00:19,680
أنا والأخ الأصغر من عائلة مولدر

6
00:00:19,680 --> 00:00:24,540
استخدمنا خريطةَ القوّة السحريّة التي أرَتْنا إيّاها
صوفي كدلالة ثِقة

7
00:00:25,280 --> 00:00:30,160
وسرقنا الحجرَ السحريّ منها في مكانٍ
لم تستطع استخدام سحرها فيه

8
00:00:30,160 --> 00:00:33,090
وسلّمناها للمحكمة

9
00:00:37,200 --> 00:00:43,930
كان الحجر السحريّ المُحطَّم كرمز خيانة
من بلدِنا لبطلته

10
00:00:47,670 --> 00:00:51,440
لن أنسى ما حييت

11
00:00:51,750 --> 00:00:54,450
شكل وجه صوفي المُستشيط غضباً

12
00:01:03,690 --> 00:01:05,000
ما هذا؟

13
00:01:05,000 --> 00:01:06,930
حجر سحريّ

14
00:01:06,930 --> 00:01:10,980
لعلّه النصف الآخر من الحجر الذي تمتلكه صوفي

15
00:02:57,650 --> 00:03:00,020
أهذه هي قاعة السّاحرة إذاً؟

16
00:03:07,540 --> 00:03:11,930
نعتقدُ أنّها بُنيَتْ بواسطة مولدر الذين خانوا صوفي

17
00:03:11,930 --> 00:03:15,770
ربّما ظنّوا أنّ تقديسها سيُكسبُهم غفرانها

18
00:03:15,770 --> 00:03:18,460
ماذا ستفعلُ صوفي إذا رأتْ هذا؟

19
00:03:18,460 --> 00:03:20,880
أنت متحمّس جدّاً حيال هذا

20
00:03:21,180 --> 00:03:25,370
خاصّة باعتبارِك قد استُبعِدتَ من عمليّة السّاحرة

21
00:03:27,030 --> 00:03:30,050
رأيتُ كثيراً من هذا

22
00:03:30,050 --> 00:03:34,190
حسناً، ماذا عن القبر الذي عُثِرَ عليه في التقرير؟

23
00:03:36,660 --> 00:03:37,650
سأرشدك إلى هناك

24
00:03:40,070 --> 00:03:42,470
،وفقاً للطبيب الذي تفقّده

25
00:03:42,880 --> 00:03:45,770
من الشبه مؤكَّد أن يكون هو

26
00:03:46,480 --> 00:03:47,460
هكذا إذاً

27
00:03:48,480 --> 00:03:52,490
أرى أنّك دُفِنتَ دفناً كريماً يا ريكيرت

28
00:03:52,850 --> 00:03:56,710
يعزو نجاح جرمانيا الآن إليك

29
00:03:56,710 --> 00:03:59,240
،لكن بسببِ ذلك

30
00:03:59,240 --> 00:04:02,810
وقعتُ في موقفٍ صعبٍ بعض الشيء

31
00:04:04,740 --> 00:04:06,000
،المُقدَّم هاغار

32
00:04:06,000 --> 00:04:09,080
تلقّينا نبأ من الأطراف التي تبحثُ عن الأرشيدوقيّة

33
00:04:09,080 --> 00:04:11,450
لقد عثروا على مخبأها

34
00:04:17,280 --> 00:04:18,590
،فيني-ساما

35
00:04:19,540 --> 00:04:22,380
كُلي قليلاً فقط من فضلك

36
00:04:22,380 --> 00:04:24,170
إنّه ليس صحّياً

37
00:04:25,080 --> 00:04:26,200
أنا آسفة

38
00:04:26,840 --> 00:04:30,260
...لا أريد أن أكون أنانيّة في وقتٍ كهذا، لكن

39
00:04:31,080 --> 00:04:33,370
صدّقيني لا أستطيع أن آكل

40
00:04:37,090 --> 00:04:38,170
!العدوّ يهاجم

41
00:04:38,170 --> 00:04:39,340
!أحضروا الأسلحة

42
00:04:39,610 --> 00:04:40,870
!قاوموا

43
00:04:43,350 --> 00:04:44,880
إنّه هجوم مُباغِت بواسطة الحرَس الملكيّ الجرمانيّ

44
00:05:07,210 --> 00:05:08,890
!ابتعدوا عن الباب

45
00:05:15,280 --> 00:05:17,070
يبدو أنّه تحت سيطرتنا بشكل كامل تقريباً

46
00:05:17,070 --> 00:05:17,830
هكذا إذاً

47
00:05:18,440 --> 00:05:20,090
هل يمكنني مرافقتك؟

48
00:05:20,410 --> 00:05:24,340
لقد التقيتُ بالأرشيدوقيّة بحدِّ ذاتها مرّتين

49
00:05:24,340 --> 00:05:26,090
قد أفيدك في إيجادها

50
00:05:27,640 --> 00:05:29,270
كما تشاء

51
00:05:33,010 --> 00:05:34,260
هل أنتَ متأكّد؟

52
00:05:36,500 --> 00:05:39,480
هذا سيُسهِّلُ الأمر

53
00:05:46,750 --> 00:05:48,230
أهذا هو؟

54
00:05:48,230 --> 00:05:48,900
نعم

55
00:05:51,840 --> 00:05:55,160
أحضر بعضاً من الجنود الذين أسرناهم

56
00:05:55,160 --> 00:05:57,600
أريدُ من تعرّضوا لأقلّ جروح مُمكنة

57
00:05:57,600 --> 00:05:58,340
حاضر

58
00:05:59,420 --> 00:06:01,580
هل إيزيتّا بخير؟

59
00:06:01,580 --> 00:06:02,620
ربّما

60
00:06:03,160 --> 00:06:06,080
ينبغي أن تكون في الخارج مع سيغ

61
00:06:06,080 --> 00:06:08,200
في الخارج؟ لماذا؟

62
00:06:08,200 --> 00:06:09,970
!الأرشيدوقيّة أورتفيني

63
00:06:10,470 --> 00:06:12,970
!أنتم عالقون كالجرذان

64
00:06:12,970 --> 00:06:15,370
!استسلموا واخرجوا

65
00:06:19,350 --> 00:06:21,590
...إن لم تسرعوا

66
00:06:26,340 --> 00:06:29,950
ستتعب إصبعي من الضغط على الزناد

67
00:06:38,710 --> 00:06:40,160
!توقّفوا

68
00:06:44,590 --> 00:06:45,750
!انتظروا

69
00:06:47,430 --> 00:06:49,160
أنا أورتفيني

70
00:06:49,680 --> 00:06:51,640
!لا تقتلوا المزيد منهم أرجوكم

71
00:06:52,150 --> 00:06:56,200
بِلا أسلحة. تعالي إلى هنا بمفردكِ

72
00:06:57,140 --> 00:07:01,000
أنا مستعدٌّ لأملأ الثقوب في أجسادكم جميعاً إذا اضطررت

73
00:07:01,890 --> 00:07:02,600
الأميرة فيني

74
00:07:13,960 --> 00:07:15,160
هذه هي

75
00:07:16,020 --> 00:07:17,270
من أنت؟

76
00:07:17,270 --> 00:07:20,550
سُرِرتُ بلقائكِ أيتها الأرشيدوقيّة

77
00:07:21,040 --> 00:07:23,530
لقد أتعبتِنا قليلاً، أليس كذلك؟

78
00:07:25,170 --> 00:07:27,270
سأطيع أوامرك

79
00:07:27,270 --> 00:07:31,850
بالمقابل، أريدُك أن تضمن سلامة الموجودين هنا

80
00:07:32,880 --> 00:07:35,880
أتعتقدين نفسكِ في محلٍّ يخوّلكِ للتفاوض؟

81
00:07:38,400 --> 00:07:40,620
من فضلك. أتوسّلُ إليك

82
00:07:41,560 --> 00:07:43,880
أنتِ تُفسدين الأمر أيّتها الأرشيدوقيّة

83
00:07:43,880 --> 00:07:46,520
،عليكِ أن تكوني نبيلة وتقاوميني حتّى النهاية

84
00:07:46,520 --> 00:07:48,480
وإلّا فلن يكون ذلك ممتعاً، أليس كذلك؟

85
00:07:50,070 --> 00:07:52,560
!خاب أملي

86
00:07:52,560 --> 00:07:58,380
سأستخدم قاذفات اللّهب لحرق هذا الملجأ بمن فيه

87
00:07:59,280 --> 00:08:01,240
!أبعد يديك عن فيني-ساما

88
00:08:05,800 --> 00:08:06,460
!السّاحرة

89
00:08:11,420 --> 00:08:13,340
النصف الآخر من الحجرِ السحريّ؟

90
00:08:13,640 --> 00:08:16,800
!لا يُفترَض أن تكون قادرة على استخدامِ سحرها هنا

91
00:08:21,090 --> 00:08:21,980
!إيزيتّا

92
00:08:29,330 --> 00:08:31,060
،إذا استخدمتِ هذا الحجر

93
00:08:31,520 --> 00:08:35,110
فقد تتمكّنين من استخدام قوّتك مثل صوفي

94
00:08:35,110 --> 00:08:36,700
،لكن السّاحرة البيضاء

95
00:08:37,360 --> 00:08:40,200
...صوفي الحقيقيّة قد قالت سابقاً

96
00:08:40,580 --> 00:08:45,160
أنَّ الحجر السحريّ يمتصُّ قوّةَ السّاحرة
بتقصيرِ عمرها

97
00:08:45,160 --> 00:08:46,700
،إذا استهلكتِه كثيراً

98
00:08:46,700 --> 00:08:48,290
فلن يكون عمركِ طويلاً

99
00:08:52,160 --> 00:08:54,160
لماذا تُظهره الآن إذاً؟

100
00:08:54,160 --> 00:08:56,430
!إيزيتّا قاتلَتْ أكثر من ذلك

101
00:08:56,920 --> 00:09:01,670
لن تقبل فيني-ساما بدفعِها للقتالِ باستخدامِها تلك القوّة

102
00:09:02,400 --> 00:09:05,710
!لا أتحمّل النظر إليها وهي بهذا الشكل

103
00:09:05,710 --> 00:09:06,650
...لا أستطيع

104
00:09:09,460 --> 00:09:11,580
شكراً لكِ يا بيانكا

105
00:09:15,780 --> 00:09:19,400
،لكن أريد أن أقاتل حتّى النّهاية

106
00:09:19,860 --> 00:09:21,660
إلى أن ينتهي كلّ شيء

107
00:09:21,950 --> 00:09:25,370
...القتال لأجل فيني-ساما

108
00:09:26,200 --> 00:09:30,780
!هو الشيء الذي أرغبُ بفعله في حياتي

109
00:10:05,840 --> 00:10:07,020
...لا

110
00:10:07,560 --> 00:10:08,940
هذه هي النهاية، صحيح؟

111
00:10:11,120 --> 00:10:13,790
هلّا أخبرتني بشيء أخير؟

112
00:10:13,790 --> 00:10:18,660
أمر الامبراطور حرسَه الملكيّ بالقضاءِ عليّ، أليس كذلك؟

113
00:10:21,910 --> 00:10:23,600
!أجل، هذا صحيح

114
00:10:23,600 --> 00:10:25,420
!انتهى أمرُك

115
00:10:25,420 --> 00:10:26,770
!أنت دون سواك

116
00:10:27,200 --> 00:10:29,830
فلماذا يحلُّ بي هذا إذاً؟

117
00:10:30,340 --> 00:10:31,420
لا أدري

118
00:10:33,790 --> 00:10:34,940
لا تُطلِقوا النار رجاء

119
00:10:39,400 --> 00:10:40,710
أستسلم

120
00:10:51,270 --> 00:10:53,240
هل أنت من فعل هذا؟

121
00:10:53,680 --> 00:10:54,600
أجل

122
00:10:55,250 --> 00:10:57,590
أودُّ منكن أن تكونن رقيقات إن أمكن

123
00:10:57,590 --> 00:11:03,510
بمقدور السّاحرة أن تقتلني بسهولة بحجرِها السحريّ

124
00:11:05,470 --> 00:11:06,780
حجر سحريّ؟

125
00:11:08,390 --> 00:11:10,940
تساءلتُ أين كنتِ

126
00:11:11,380 --> 00:11:15,360
فهمت، أظنُّكِ كنتِ تشحنين سحركِ

127
00:11:15,730 --> 00:11:16,780
...إيزيتّا

128
00:11:18,780 --> 00:11:21,690
أنا مندهشٌ من تحلّيكِ بالجرأة لاستخدامه

129
00:11:21,690 --> 00:11:24,490
،قيلَ لي أنّ استخدامه يؤلم جسدكِ ألماً مبرحاً

130
00:11:25,120 --> 00:11:27,480
ويلتهم عمركِ

131
00:11:36,240 --> 00:11:38,260
سأخلعُ عنك عصبة العينين

132
00:11:47,840 --> 00:11:50,430
كانت جولة طويلة في السيّارة

133
00:11:50,780 --> 00:11:52,890
،بما أنّنا لم نصعد كثيراً من التلال

134
00:11:53,230 --> 00:11:56,860
فهل انتقلنا إلى الغابة الآن؟

135
00:11:59,720 --> 00:12:02,990
أنت من أرسلَ صوفي، أليس كذلك؟

136
00:12:03,620 --> 00:12:05,960
الرّائد أرنولد بيركمان

137
00:12:05,960 --> 00:12:08,700
،ترقّيتُ للتو إلى رتبة مُقدَّم

138
00:12:09,070 --> 00:12:11,020
يا حضرة المُستشار سيغهارت ميولر

139
00:12:12,790 --> 00:12:14,370
أنا رئيس المستشارين الآن

140
00:12:14,620 --> 00:12:16,240
المعذرة

141
00:12:16,240 --> 00:12:19,840
يبدو أنّ معلوماتي أنا وأنت قديمة بعض الشيء

142
00:12:19,840 --> 00:12:25,340
لطالما ظننتُ أنّه يوجد شخصٌ في إيلستادت لديه
نفس عقليّتي

143
00:12:25,680 --> 00:12:27,050
كان أنت

144
00:12:28,480 --> 00:12:30,480
يسرُّني أنّك أنت من أتحدّث معه

145
00:12:30,480 --> 00:12:32,950
سأدخلُ صلبَ الموضوع، أريدُ أن أعرض صفقة

146
00:12:33,360 --> 00:12:34,310
صفقة؟

147
00:12:34,620 --> 00:12:36,780
تجيدُ الصفقات أكثر من التعذيب، صحيح؟

148
00:12:36,780 --> 00:12:40,730
لكنّك أيضاً من النوع الذي يفعلُ ما يلزم
لإنجازِ مهمّة

149
00:12:40,730 --> 00:12:44,320
أشياء يعتبرها الآخرون أحياناً غير طبيعيّة

150
00:12:45,000 --> 00:12:46,240
هل أنا مخطئ؟

151
00:12:50,340 --> 00:12:51,790
ما هي الصفقة؟

152
00:12:51,790 --> 00:12:55,040
مزِّق ياقة سترتي من الخلف

153
00:12:55,040 --> 00:12:57,630
يوجدُ فيلم مخفيّ فيها

154
00:13:06,640 --> 00:13:09,770
نجحَتْ جرمانيّا في إجراء تجربة على قنبلة

155
00:13:09,770 --> 00:13:12,890
،باستخدام نوعٍ جديدٍ من الطاقة
بلّورات السّحر النّاشئة بواسطة السّاحرة

156
00:13:12,890 --> 00:13:15,100
والتي نُطلِق عليها هيكسينيوم

157
00:13:18,770 --> 00:13:27,770
ستُحمَّل القنبلة بصاروخ يتمّ توجيهه عن طريق السّحر

158
00:13:27,770 --> 00:13:30,410
ويُطلَق على لاندزبروك

159
00:13:38,320 --> 00:13:41,290
،وفي نفس الوقت

160
00:13:41,290 --> 00:13:45,720
سيُعقَدُ مؤتمرٌ سرِّي برئاسةِ جرمانيا مع ممثّلي
القوى الكُبرى

161
00:13:45,720 --> 00:13:47,510
،وذلك في ويستريا

162
00:13:47,900 --> 00:13:52,220
بشرط أن تتمّ حماية كافّة المشاركين حِماية كاملة

163
00:13:52,740 --> 00:13:56,100
،من المُفترَض أن تكون محادثات سلام

164
00:13:56,400 --> 00:14:00,400
لكن هدفه الفعليّ هو الكشف عن القنبلةِ الجديدة
وتهديدهم بها

165
00:14:00,720 --> 00:14:03,210
إن كنتُم لا تريدون أن يحدث لكم ما حدث لإيلستادت"

166
00:14:03,210 --> 00:14:05,650
"فاستسلِموا من دون شروط

167
00:14:06,000 --> 00:14:07,650
...إن صحَّ هذا

168
00:14:07,650 --> 00:14:08,700
إنّه صحيح

169
00:14:09,860 --> 00:14:14,990
إن كان كذلك فلماذا تخبرني بهذه السهولة؟

170
00:14:14,990 --> 00:14:18,140
لقد استُبعِدتُ من وحدة صوفي الخاصّة

171
00:14:18,140 --> 00:14:21,160
وصدرَ أمرٌ بإعدامي

172
00:14:21,160 --> 00:14:24,760
أعتقدُ أنّه بإطلاقي النّار على عضو
في الحرسِ الملكيّ

173
00:14:24,760 --> 00:14:27,620
أكونُ قد أثبتُّ كم أنا عازِم على هذا

174
00:14:29,010 --> 00:14:33,390
في هذا اليوم، أملي الوحيد هو أن تربحوا الحرب

175
00:14:33,390 --> 00:14:35,390
،وإن هُزِمَتْ صوفي

176
00:14:35,390 --> 00:14:39,220
ستُصبِح إيزيتّا بلا شكّ الأقوى في العالم

177
00:14:40,070 --> 00:14:43,730
ومن المُمكِن لها أن تدمّرَ جرمانيا بمفردها

178
00:14:45,380 --> 00:14:48,260
أليس لديك أي ولاء لبلدك؟

179
00:14:48,260 --> 00:14:51,970
كلّ ما في الأمر أنّني لا أريد أن أموت

180
00:14:51,970 --> 00:14:55,710
وأفضل طريقة تجنّبُني القتل

181
00:14:55,710 --> 00:14:59,840
هي أن أقتلَ أي شخص يستهدفُ حياتك أولاً

182
00:14:59,840 --> 00:15:00,670
هل أنا مخطئ؟

183
00:15:00,940 --> 00:15:02,590
،إذا اتبعتَ هذه القاعدة

184
00:15:02,590 --> 00:15:05,250
فلن يبقى سواك في نهاية المطاف

185
00:15:05,250 --> 00:15:07,620
سيكون هذا من دواعي سروري

186
00:15:07,940 --> 00:15:09,470
هذا هو الأمان بحدِّ ذاته

187
00:15:13,200 --> 00:15:14,580
أنا مطمئنّ

188
00:15:15,510 --> 00:15:18,000
لستُ مثلك

189
00:15:18,000 --> 00:15:19,640
أنتَ وأنا غير متوافقين على الإطلاق

190
00:15:20,660 --> 00:15:21,950
حقّاً؟

191
00:15:22,670 --> 00:15:25,320
نوع جديد من القنابل؟

192
00:15:25,320 --> 00:15:27,120
انفجار القنبلة

193
00:15:27,120 --> 00:15:31,550
يُعادل حجم 20 ألف طن من متفجّرات الـ ت.ن.ت

194
00:15:31,550 --> 00:15:35,290
تمتلكُ القوّة لتدمير لاندزبروك كلّها بهجمةٍ واحدة

195
00:15:35,740 --> 00:15:39,000
قنبلة واحدة أقوى بكثير من قصف
همجي بواسطة وابل من الطائرات؟

196
00:15:39,000 --> 00:15:40,240
!سحقاً لأوتو ذاك

197
00:15:40,240 --> 00:15:42,460
كيف استطاعَ صنع سلاح شرّير كهذا؟

198
00:15:43,190 --> 00:15:45,130
!لن نسمحَ له باستخدامه

199
00:15:45,130 --> 00:15:46,890
!علينا إيقافه بطريقةٍ ما

200
00:15:48,320 --> 00:15:52,820
لكن هذه نتيجةٌ أخرى من نتائج
استخدام قوّة السّاحرة للحرب، صحيح؟

201
00:15:54,640 --> 00:15:55,740
يكفي

202
00:15:56,320 --> 00:15:57,560
لنستسلم

203
00:15:57,880 --> 00:16:01,870
إذا سلّمتُ نفسي، فلن تستخدمه جرمانيا

204
00:16:01,870 --> 00:16:03,000
فيني-ساما

205
00:16:03,460 --> 00:16:06,520
قالوا أنّ الحجر السحريّ يلتهمُ عمركِ

206
00:16:06,980 --> 00:16:10,280
لن ندعكِ تقاتلين أكثر من ذلك

207
00:16:10,820 --> 00:16:14,170
لا أستطيع انتقاد أوتّو حتّى

208
00:16:14,710 --> 00:16:18,760
لم أستطع مُقاومة إغراء قوّة السّاحرة بحدِّ ذاتها

209
00:16:18,760 --> 00:16:23,410
لكن كان ذلك خطّاً ما كان ينبغي أن أتخطّاه

210
00:16:23,410 --> 00:16:26,820
كما قالَتْ لكِ جدّتكِ

211
00:16:27,330 --> 00:16:29,180
،لم أستطع مُقاومة الإغراء

212
00:16:29,180 --> 00:16:32,220
ونتيجة ذلك، دمّرتُ العالمَ كلّه

213
00:16:33,650 --> 00:16:36,340
...لننهِ هذا الأمر برمّته

214
00:16:41,620 --> 00:16:44,980
!لا تنهِ الأمر من تلقاء نفسكِ

215
00:16:45,240 --> 00:16:49,450
لطالما كنتِ تقولين أنّ شعب البلد
هو ما يبقيكِ على قيد الحياة، صحيح؟

216
00:16:49,450 --> 00:16:51,110
لهذا تُقاتلين، أليس كذلك؟

217
00:16:51,110 --> 00:16:52,780
!أنا مثلكِ

218
00:16:52,780 --> 00:16:56,910
ضحّى كثير من النّاسِ بأرواحهم لأجلي

219
00:16:56,910 --> 00:16:58,240
...لهذا السّبب

220
00:16:58,240 --> 00:16:59,370
...إيزيتّا

221
00:16:59,370 --> 00:17:01,980
!ما زلتُ واقِفة

222
00:17:01,980 --> 00:17:03,730
!ما زلتُ قادرة على القتال

223
00:17:03,730 --> 00:17:05,330
بدأنا بهذا معاً

224
00:17:06,150 --> 00:17:08,040
علينا إنهاء الأمر معاً

225
00:17:11,060 --> 00:17:14,120
أعلم أنّ الأمر مؤلم، أعلم أنّه جارح

226
00:17:14,690 --> 00:17:17,140
...لكن أريدكِ أن تكوني كما كنتِ دوماً

227
00:17:18,200 --> 00:17:20,280
!أرجوكِ يا فيني

228
00:17:23,140 --> 00:17:24,660
اسمي فيني

229
00:17:25,490 --> 00:17:29,020
أورتفيني فريديريكا فون إيلستادت

230
00:17:29,650 --> 00:17:31,100
هذا صحيح

231
00:17:31,100 --> 00:17:35,690
أقسمتُ أنّني ما دمتُ على قيدِ الحياة، سأمنحكِ أمنيتكِ

232
00:17:37,240 --> 00:17:38,870
أنا آسفةٌ يا إيزيتّا

233
00:17:39,760 --> 00:17:41,450
!لنقاتل! معاً

234
00:17:41,800 --> 00:17:42,540
!نعم

235
00:17:43,740 --> 00:17:48,140
سيُطلَق الصّاروخ من جنوب جرمانيا
في قاعدة لوغينباخر

236
00:17:48,140 --> 00:17:52,880
لكن في هذه النقطة، ستحتاجُ صوفي للتحكُّم به

237
00:17:52,880 --> 00:17:56,880
،لذا إذا استطعتُم دفعها نحو معركةٍ قبل أن يُطلَق

238
00:17:56,880 --> 00:18:00,620
فلن يُطلَق الصّاروخ أو يُفجَّر

239
00:18:00,620 --> 00:18:04,680
وهي نسخة، هنالك حدودٌ للمدّة التي تستطيع
خلالها أن تكون نشِطة

240
00:18:04,680 --> 00:18:08,100
لم تستطع متابعة معركة شامِلة
لأكثر من ساعتين كحدٍّ أقصى

241
00:18:10,230 --> 00:18:13,440
وقد يكون أٌقلّ من ذلك بحسبِ كيفيّة
استخدامها لسحرها

242
00:18:13,940 --> 00:18:16,260
...إذا استطاعت إيزيتّا الصمود هذه المدّة الطويلة

243
00:18:16,770 --> 00:18:19,780
لن يُطلَق الصّاروخ على إيلستادت أبداً

244
00:18:24,980 --> 00:18:27,500
لكن لن يكون ذلك كافياً

245
00:18:28,000 --> 00:18:31,350
عليّ حضور مُؤتمر ويستريا مهما كلّفَ الأمر

246
00:18:32,360 --> 00:18:34,710
خاصّة إن كنّا سنهزم صوفي

247
00:18:36,040 --> 00:18:40,340
يمكنك تحضير المُعاملات الورقيّة والعلاقات اللّازمة
أليس كذلك يا بيركمان؟

248
00:18:40,650 --> 00:18:41,770
...سعادتكِ

249
00:18:41,770 --> 00:18:45,420
علينا منع القوى العظمى من القبولِ بمحادثاتِ السّلام أولاً

250
00:18:45,910 --> 00:18:48,520
...وإذا ربِحَتْ إيزيتّا، أنا أيضاً

251
00:18:48,520 --> 00:18:52,520
لا، حينئذ يحتاجُ الأمرُ لوجودي هناك

252
00:18:53,120 --> 00:18:55,690
لا أستطيع العودة إلى جرمانيا الآن

253
00:18:55,690 --> 00:18:58,570
نحن مُشارِكون في هذا معاً أيّتها الأرشيدوقيّة

254
00:18:58,920 --> 00:19:01,120
سأذهب أنا وبيانكا معكِ

255
00:19:01,120 --> 00:19:02,110
شكراً لك

256
00:19:02,110 --> 00:19:05,400
إذا أردنا أن نصلَ على موعدِ الاجتماع
علينا المُغادرة غداً إن أمكن

257
00:19:05,400 --> 00:19:06,490
استعدّوا

258
00:19:06,490 --> 00:19:07,290
عُلِم

259
00:19:09,250 --> 00:19:11,290
لا أرى القمر؟

260
00:19:26,770 --> 00:19:27,810
...إيزيتّا

261
00:19:28,200 --> 00:19:29,240
...فيني-ساما

262
00:19:32,560 --> 00:19:35,940
ألا يؤلمكِ استخدام السحر؟

263
00:19:36,190 --> 00:19:38,420
هذا غير مهمّ

264
00:19:38,420 --> 00:19:39,030
هيّا بنا

265
00:20:07,570 --> 00:20:10,060
ما هذا؟

266
00:20:11,860 --> 00:20:12,660
...المعذرة

267
00:20:14,600 --> 00:20:15,900
!آسفة لأنّني صفعتُكِ

268
00:20:16,880 --> 00:20:20,570
هل تفعلين هذا كي تعتذري عن ذلك؟

269
00:20:25,990 --> 00:20:27,470
،لا مانع لديّ أن أسامحكِ

270
00:20:27,470 --> 00:20:30,080
لكن لديّ شرط

271
00:20:30,080 --> 00:20:31,310
فيني-ساما؟

272
00:20:31,310 --> 00:20:33,770
،ناديتِني باسمي عصر اليوم

273
00:20:33,770 --> 00:20:35,630
!ثمّ توقّفتِ

274
00:20:37,430 --> 00:20:40,100
فيني... ساما

275
00:20:41,510 --> 00:20:42,840
..."لا داعي لإضافة "ساما

276
00:20:44,980 --> 00:20:46,490
...فيني

277
00:20:47,300 --> 00:20:49,160
من دون تأتأة

278
00:20:50,420 --> 00:20:51,860
فيني

279
00:20:51,860 --> 00:20:53,730
نعم، هكذا

280
00:20:54,480 --> 00:20:55,860
فيني

281
00:20:56,840 --> 00:20:57,880
!فيني

282
00:20:58,990 --> 00:20:59,840
أجل

283
00:20:59,840 --> 00:21:00,890
!فيني

284
00:21:03,060 --> 00:21:04,220
!فيني

285
00:21:06,180 --> 00:21:07,350
...إيزيتّا

286
00:21:13,520 --> 00:21:17,020
إيزيتّا، هل سينجح هذا حقّاً؟

287
00:21:17,600 --> 00:21:21,180
وإن نجحَ فهل سينتهي هذا الأمر فعلاً؟

288
00:21:21,860 --> 00:21:24,020
أجل، أظنُّني أستطيع فعلها

289
00:21:26,160 --> 00:21:29,610
تعلّمتُ شيئاً باستخدامِ هذا الحجر

290
00:21:29,610 --> 00:21:31,130
—ولهذا يا فيني-سـ

291
00:21:32,520 --> 00:21:34,330
فيني، أردتُ أن أسألكِ عن الأمر

292
00:21:34,330 --> 00:21:35,450
تكلّمي معي

293
00:21:35,860 --> 00:21:36,580
حسناً

294
00:21:44,280 --> 00:21:48,910
وما الذي سيطلبُه الجرمانيّون الأوغاد منّا أن نفعله؟

295
00:21:52,840 --> 00:21:56,210
هلّا أخفضتِ سلاحكِ؟

296
00:21:56,760 --> 00:21:58,940
فالأمور بخير حتّى الآن، أليس كذلك؟

297
00:21:58,940 --> 00:21:59,540
اصمت

298
00:21:59,880 --> 00:22:01,840
لن أسترخي لحظة وأنا جوارك

299
00:22:02,790 --> 00:22:06,050
بالمناسبة، إنّها جاهزة للخروج، أليس كذلك؟

300
00:22:11,300 --> 00:22:13,640
...إيزيتّا-ساما

301
00:22:13,640 --> 00:22:15,310
احرصي على العودة، مفهوم؟

302
00:22:19,890 --> 00:22:20,860
سأراكم قريباً

303
00:22:21,520 --> 00:22:22,400
!بالتوفيق

304
00:22:27,190 --> 00:22:29,320
أنت في وضع سيئ أيضاً

305
00:22:29,620 --> 00:22:31,520
لكن لنفعل ما بوسعنا

306
00:22:31,520 --> 00:22:32,830
هذه هي المرّة الأخيرة

307
00:22:34,290 --> 00:22:36,060
تعالوا معي جميعاً

308
00:22:39,200 --> 00:22:44,160
!إيزيتّا-ساما

309
00:22:44,160 --> 00:22:45,750
!حظّاً سعيداً

310
00:22:47,840 --> 00:22:48,760
نقطة تفتيش

311
00:22:49,190 --> 00:22:51,320
المكان محميٌّ حِماية مشدّدة بالطبع

312
00:22:51,320 --> 00:22:53,110
لكن هذه هي النقطة الأخيرة

313
00:22:56,080 --> 00:22:57,450
تفضّل

314
00:22:59,810 --> 00:23:00,330
ابتعد

315
00:23:00,330 --> 00:23:01,020
!مهلاً

316
00:23:04,980 --> 00:23:06,780
خاب أملي

317
00:23:06,780 --> 00:23:09,490
،لم أتوقّع منك أن تخوننا

318
00:23:10,290 --> 00:23:11,340
يا بيركمان

319
00:23:21,540 --> 00:23:23,540
سئمتُ من الانتظار

320
00:23:24,400 --> 00:23:26,960
...لنبدأ

321
00:23:27,240 --> 00:23:29,620
!نهاية كلّ شيء

322
00:25:06,550 --> 00:25:09,140
الحلقة الأخيرة: إيزيتّا

323
00:25:10,070 --> 00:25:11,210
،لنذهب معاً

324
00:25:11,730 --> 00:25:14,740
وننهِ كلّ شيء