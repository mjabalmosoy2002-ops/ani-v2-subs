1
00:00:00,950 --> 00:00:02,480
...هذه هي الأخيرة

2
00:00:03,160 --> 00:00:04,480
!طلقة واحدة فقط هي كل ما يلزم

3
00:00:04,480 --> 00:00:05,930
!أرني ما يمكنك فعله

4
00:00:10,270 --> 00:00:11,510
!اللّعنة

5
00:03:08,830 --> 00:03:10,840
استرخِ

6
00:03:10,840 --> 00:03:12,510
،إذا توتّرتَ في الوقت الذي لا يحدث فيه شيء

7
00:03:12,510 --> 00:03:14,790
فلن تتمكّن من الصمود عندما تستدعي الضرورة

8
00:03:22,640 --> 00:03:24,220
مشروب جيّد، صحيح؟

9
00:03:30,160 --> 00:03:33,800
الرقيب أوّل، أيمكننا الفوز؟

10
00:03:34,230 --> 00:03:35,400
تعرف القصّة، صحيح؟

11
00:03:35,880 --> 00:03:39,610
كانت كينينبيرغ المكان الذي قاوم فيها أرشيدوق
إيليستادت حصاراً

12
00:03:39,610 --> 00:03:42,060
ودافع عن منطقته

13
00:03:43,110 --> 00:03:45,180
داخل جدران تلك القلعة

14
00:03:45,180 --> 00:03:48,160
تجد مختلف أنواع السيوف والأشياء التي تعود
للعصور الوسطى

15
00:03:48,760 --> 00:03:51,480
الحظّ حليفنا في مكانٍ كهذا

16
00:03:52,540 --> 00:03:55,450
حسناً، إذا استهدفنا أولئك الجرمانيون فعليّاً

17
00:03:55,450 --> 00:03:57,590
فلن يصمد المكان اثني عشر ساعة على ما أعتقد

18
00:03:58,130 --> 00:03:59,930
،لكن إن قتلنا عدوّاً واحداً

19
00:03:59,930 --> 00:04:03,090
فقد ننقذ روحاً من أرواح زملائنا

20
00:04:04,920 --> 00:04:06,800
آمن بذلك عندما تطلق النّار

21
00:04:09,570 --> 00:04:10,470
حاضر

22
00:04:25,700 --> 00:04:27,730
!لقد أُبيدت الدبّابات

23
00:04:27,730 --> 00:04:29,330
!سيصلون إلى هنا قريباً

24
00:04:30,160 --> 00:04:30,970
!المهندسون

25
00:04:30,970 --> 00:04:31,500
!حاضر

26
00:04:31,500 --> 00:04:33,340
!لن يأتي أحد آخر

27
00:04:33,340 --> 00:04:35,500
!فخّخوا الطريق بالألغام

28
00:04:35,920 --> 00:04:38,840
!أيّها المبعوث، بلِّغ قائد السرية

29
00:04:39,300 --> 00:04:40,100
!حاضر

30
00:04:54,100 --> 00:04:55,630
!هجوم للعدو

31
00:04:55,630 --> 00:04:57,230
!قنابل قادمة

32
00:05:23,450 --> 00:05:24,800
!أيّها الغبي

33
00:05:28,530 --> 00:05:31,160
سعادة الأميرة، لديّ طلب

34
00:05:32,100 --> 00:05:34,730
هلّا أصبحتِ أملي؟

35
00:05:35,190 --> 00:05:36,460
أمل؟

36
00:05:38,640 --> 00:05:41,770
!سأحمي بلدكِ

37
00:05:43,810 --> 00:05:45,150
تحميننا؟

38
00:05:47,920 --> 00:05:48,780
!لا

39
00:05:49,750 --> 00:05:51,130
!لا يا إيزيتّا

40
00:05:51,130 --> 00:05:52,620
...حتّى بقوّتكِ

41
00:05:53,160 --> 00:05:56,830
إنّهم جيش ضخم قوامه عشرات آلاف الجنود

42
00:05:56,830 --> 00:05:59,170
لكن أظنّني أستطيع فعلها

43
00:06:03,560 --> 00:06:05,880
أقدّر هذه اللّفتة

44
00:06:06,580 --> 00:06:10,150
لكن لا علاقة لكِ بالأمر، لا أستطيع توريطكِ

45
00:06:10,960 --> 00:06:12,010
افهميني أرجوكِ

46
00:06:12,010 --> 00:06:12,860
...لكن

47
00:06:13,440 --> 00:06:14,300
ادخل

48
00:06:14,980 --> 00:06:17,060
!كينينبيرع تُقصَف

49
00:06:29,030 --> 00:06:30,200
،حضرة الرّقيب أول

50
00:06:31,110 --> 00:06:34,340
هل انتهى القصف؟

51
00:06:41,680 --> 00:06:42,840
!حضرة الرقيب أوّل

52
00:06:54,290 --> 00:06:57,140
!طبيب

53
00:07:03,690 --> 00:07:08,110
كينينبيرغ الجنوبية
مقرّ قيادة الجيش كيلتفيل

54
00:07:06,560 --> 00:07:08,110
ما حجم الأضرار؟

55
00:07:09,190 --> 00:07:11,190
نعم

56
00:07:11,620 --> 00:07:12,570
هكذا إذاً

57
00:07:13,280 --> 00:07:16,520
،بوقوع المواجهة قربَ العاصمة

58
00:07:16,520 --> 00:07:18,520
لن نحظى بأي قوى اعتراضيّة

59
00:07:18,520 --> 00:07:20,440
اثبتوا هناك بطريقة ما

60
00:07:21,730 --> 00:07:24,140
،إذا سقطت كينينبيرغ

61
00:07:24,140 --> 00:07:27,380
سيتوغّل العدوّ إلى أعماق منطقتنا ويهاجمنا

62
00:07:27,720 --> 00:07:29,130
!أعلم هذا

63
00:07:30,580 --> 00:07:32,950
قم بإخلاء النّاس بسرعة

64
00:07:33,640 --> 00:07:35,350
ربّما لا نملك كثيراً من الوقت

65
00:07:35,890 --> 00:07:40,060
بحيرة رودين
مقرّ الفرقة الجرمانيّة

66
00:07:40,060 --> 00:07:43,240
صمدوا أمامها في نهاية المطاف إذاً؟

67
00:07:43,240 --> 00:07:45,630
أجل، مع الأسف

68
00:07:45,630 --> 00:07:49,530
يبدو أنّ قصف طائراتنا لهم لا يكفي
للتكفّل بالمهمّة على ما يبدو

69
00:07:49,830 --> 00:07:51,820
ربحتَ الرّهان

70
00:07:52,520 --> 00:07:54,740
الشامبانيا لك

71
00:07:55,120 --> 00:07:57,580
حان دوري إذاً

72
00:07:58,020 --> 00:08:00,090
!اطلبوا من سريّة الدبّابات التقدّم

73
00:08:00,090 --> 00:08:01,880
!أسقطوهم

74
00:08:01,880 --> 00:08:03,040
!حاضر

75
00:08:06,550 --> 00:08:12,460
جِدوا شخصاً بسرعة وأرسلوه خلف الفصيل الأوّل

76
00:08:12,130 --> 00:08:13,770
ما زالت وحدات المدفعيّة سليمة، صحيح؟

77
00:08:13,770 --> 00:08:14,500
!نعم سيّدي

78
00:08:14,020 --> 00:08:16,320
قُتِل قائد الفصيل الثّاني أثناء الاشتباك

79
00:08:15,440 --> 00:08:17,340
!أعطوهم الإحداثيات المُعدّلة

80
00:08:16,320 --> 00:08:18,990
تولّى الرقيب أوّل لوتز القيادة
!ويتصدّى للعدو

81
00:08:17,340 --> 00:08:19,600
!أمطِروا القذائف على أولئك الجرمانيين الأوغاد

82
00:08:20,080 --> 00:08:23,360
إلى قيادة المدفعيّة، من مقرّ السريّة

83
00:08:23,360 --> 00:08:26,620
إحداثيات المدى النّاري المُجدي
هي 5200

84
00:08:27,190 --> 00:08:29,690
سَمْت الهدف، 400

85
00:08:32,330 --> 00:08:34,120
...استعداد

86
00:08:34,120 --> 00:08:34,740
!إطلاق

87
00:08:44,720 --> 00:08:46,710
هل من أمل لفوزنا؟

88
00:08:47,200 --> 00:08:52,590
سنكون محظوظين إذا كسبنا الوقت لسكّان
كيلتفيل الواقعة خلفنا لإخلائها

89
00:08:53,270 --> 00:08:55,770
يمكننا كسب الوقت ليس إلّا إذاً؟

90
00:08:55,770 --> 00:08:57,720
هل يعلم الناس في تلك القلعة ذلك؟

91
00:08:58,710 --> 00:09:01,600
يعلمون ذلك ويُقاتلون على أي حال

92
00:09:01,850 --> 00:09:03,400
كسب الوقت؟

93
00:09:05,000 --> 00:09:09,190
نخسر أرواحاً فقط لكسب الوقت؟

94
00:09:50,260 --> 00:09:52,410
...أما من شيء أستطيع فعله

95
00:09:53,110 --> 00:09:55,980
للأرواح التي نخسرها في هذه اللحظة؟

96
00:10:00,030 --> 00:10:02,150
!تبّاً! تبّاً

97
00:10:02,150 --> 00:10:03,380
!أنت

98
00:10:04,210 --> 00:10:05,500
!تعال معي! من هنا

99
00:10:05,910 --> 00:10:07,480
أنت من الفرقة أيضاً، صحيح؟

100
00:10:07,480 --> 00:10:08,590
ما اسمك؟

101
00:10:08,590 --> 00:10:09,670
!جوناس

102
00:10:09,930 --> 00:10:10,970
!حسناً

103
00:10:10,970 --> 00:10:12,700
يمكنُك مُساعدتي في استخدام رشّاش، صحيح؟

104
00:10:13,110 --> 00:10:14,170
!سنُقاوم

105
00:10:14,510 --> 00:10:15,170
!حاضر

106
00:10:28,560 --> 00:10:29,320
!رصاص

107
00:10:29,320 --> 00:10:30,020
!حاضر

108
00:10:38,320 --> 00:10:40,010
!رسالة من قائد السرية

109
00:10:46,220 --> 00:10:47,690
أخيراً؟

110
00:10:48,170 --> 00:10:48,870
!هيّا بنا

111
00:10:59,360 --> 00:11:01,470
،أبي، أمّي

112
00:11:01,470 --> 00:11:04,620
...إيميلي، هايدي، هيلينا

113
00:11:04,620 --> 00:11:06,710
،أبي، أمّي

114
00:11:06,710 --> 00:11:09,830
...إيميلي، هايدي، هيلينا

115
00:11:12,230 --> 00:11:13,940
ألم تستطيعوا إسقاطها بعد؟

116
00:11:14,250 --> 00:11:15,300
...نعم سيّدي

117
00:11:15,300 --> 00:11:17,320
لا بدّ وأنّ نيران المدفعيّة القادمة من خلف العدوّ

118
00:11:17,320 --> 00:11:20,140
مدعومة براصِدين يعتلون قمم الجبال

119
00:11:20,140 --> 00:11:24,070
الإصابة دقيقة جدّاً وتعيق تقدّمنا

120
00:11:25,330 --> 00:11:27,060
تبّاً لهم

121
00:11:27,060 --> 00:11:29,470
سيادة الفريق، إذا استغرقنا وقتاً طويلاً

122
00:11:29,470 --> 00:11:31,720
فقد يغضب جلالته

123
00:11:31,720 --> 00:11:33,470
!أعلم

124
00:11:33,470 --> 00:11:37,800
الرّائد كيلر، اطلب دعماً إضافياً من قوى الجو

125
00:11:40,090 --> 00:11:41,680
عُلِم

126
00:11:42,630 --> 00:11:45,670
هل نحتفي بشرب الشامبانيا معاً؟

127
00:12:03,670 --> 00:12:05,310
!أحضروا قدر ما تجدون

128
00:12:05,310 --> 00:12:07,990
!قد تنفعنا في أي شيء

129
00:12:14,770 --> 00:12:15,740
سعادة الأميرة

130
00:12:17,260 --> 00:12:18,330
من فضلك

131
00:12:18,870 --> 00:12:21,340
دعينا نذهب إلى كينينبيرغ

132
00:12:21,340 --> 00:12:23,120
هذا يكفي

133
00:12:23,120 --> 00:12:25,200
!زملاؤنا الجنود هناك

134
00:12:25,200 --> 00:12:26,850
!لن ندعهم يموتون بمفردهم

135
00:12:26,850 --> 00:12:31,560
لا يمكنكم عبور النّهر أمام العدوّ
دون أي تجهيزات

136
00:12:31,880 --> 00:12:33,790
،بمقدورنا قتل أكبر عدد مُمكن

137
00:12:33,790 --> 00:12:35,980
بالحربة أو بالسكاكين أو أي شيء

138
00:12:35,980 --> 00:12:38,840
خسرنا كلّ زملائنا في القلعة

139
00:12:38,840 --> 00:12:40,910
!لا نستطيع الجلوس هنا مكتوفي الأيدي

140
00:12:40,910 --> 00:12:42,320
!أرجوكِ يا سعادة الأميرة

141
00:12:42,820 --> 00:12:44,250
—هذا يكفي

142
00:12:44,250 --> 00:12:44,950
!لا

143
00:12:47,320 --> 00:12:49,660
!لا نستطيع فعل شيء حالياً

144
00:12:49,660 --> 00:12:50,800
...لكن

145
00:12:50,800 --> 00:12:51,830
!لا تنسوا

146
00:12:52,230 --> 00:12:54,720
ما هي مهمّتنا؟

147
00:12:54,720 --> 00:12:56,920
لأجل ماذا نخاطرُ بأرواحنا؟

148
00:12:58,590 --> 00:13:03,050
!لا للانتقام أو التحدّي بتهوُّر

149
00:13:03,430 --> 00:13:07,750
بل لحماية شعبنا وعوائلنا، أليس كذلك؟

150
00:13:10,690 --> 00:13:12,390
الوضع ميؤوس منه

151
00:13:12,390 --> 00:13:17,290
في وقتٍ ما سأستدعيكم للتضحية بأرواحكم
لأجل زملائكم

152
00:13:17,770 --> 00:13:20,520
لكن لم يحن هذا الوقت الآن

153
00:13:21,410 --> 00:13:22,410
اصبروا حالياً

154
00:13:23,330 --> 00:13:28,060
يقاتلُ الجنود في كينينبيرغ لكسبِ الوقتِ لنا

155
00:13:29,030 --> 00:13:31,240
عندما يحينُ وقتُ الانسحاب، فلا بدّ أن ننسحب

156
00:13:34,640 --> 00:13:35,540
أنا آسفة

157
00:13:36,230 --> 00:13:40,700
لا أستطيع حتّى أن أدعكم تختارون
مكان موتكم حاليّاً

158
00:13:42,530 --> 00:13:44,730
،حقيقة عملي يُفترَض ألّا تكون أن أطلب منكم الموت

159
00:13:44,730 --> 00:13:45,970
،بل أن أطلب منكم العيش

160
00:13:46,880 --> 00:13:50,890
وبناء بلدٍ لا تفكّرون فيه

161
00:13:51,400 --> 00:13:53,580
سوى بالغدّ

162
00:13:54,460 --> 00:13:55,890
!سعادة الأميرة

163
00:13:57,890 --> 00:13:58,810
سامحوني

164
00:14:09,330 --> 00:14:12,980
سامحوني، لأنّني لستُ قوية بما يكفي

165
00:14:43,660 --> 00:14:44,440
نعم

166
00:14:45,320 --> 00:14:48,280
أعتقدُ أنّها ليست سوى مسألة وقت

167
00:14:49,080 --> 00:14:51,220
...لكن ما زال الجنود

168
00:14:52,480 --> 00:14:53,240
نعم

169
00:14:54,500 --> 00:14:55,830
عُلِم

170
00:14:57,320 --> 00:14:58,500
سيادة الفريق؟

171
00:15:00,310 --> 00:15:02,210
استعدّوا للانسحاب

172
00:15:02,600 --> 00:15:06,170
سنتراجعُ إلى فارغاو ونُعيد تنظيم خطوطنا هناك

173
00:15:15,970 --> 00:15:16,860
!حضرة العرّيف

174
00:15:29,400 --> 00:15:31,860
وصلت الإمدادات

175
00:15:32,190 --> 00:15:35,160
سيبدأ القصفُ عمّا قريب

176
00:15:35,470 --> 00:15:37,670
مات الشّاه

177
00:15:38,500 --> 00:15:42,370
لم أكن لأرغب بإزعاجك في هذا الأمر

178
00:15:42,650 --> 00:15:48,180
في كلتا الحالتين، امبراطوريّة جرمانيا العظيمة ستنتصر

179
00:15:49,000 --> 00:15:50,130
سيغ رايخ

180
00:15:51,040 --> 00:15:52,630
!سيغ رايخ

181
00:16:30,560 --> 00:16:31,500
!هيّا

182
00:16:35,600 --> 00:16:37,020
ما هذا؟

183
00:16:37,020 --> 00:16:38,440
!غير مهمّ

184
00:16:38,440 --> 00:16:41,240
إذا كان يُسقِط طائرات ستوكا فهو حليف

185
00:16:42,610 --> 00:16:44,770
!لم ننتهِ بعد

186
00:16:51,910 --> 00:16:54,280
...سعادة الأميرة فيني، إنّ كينينبيرغ

187
00:17:35,640 --> 00:17:36,950
...إذا حقّقتُ إصابة واحدة فقط

188
00:17:39,120 --> 00:17:40,170
!هيّا

189
00:18:14,800 --> 00:18:16,780
هل أنتِ بخير؟

190
00:18:18,790 --> 00:18:20,780
أجل، أنا بخير

191
00:18:21,080 --> 00:18:22,000
...المعذرة

192
00:18:22,000 --> 00:18:25,210
سمعتُ أنّه يوجد الكثير من السيوف القديمة وما شابه هنا

193
00:18:25,210 --> 00:18:26,520
أين هي؟

194
00:18:26,520 --> 00:18:28,920
في الأعلى هناك

195
00:18:28,920 --> 00:18:30,710
بئساً! هناك في الأعلى؟

196
00:18:32,290 --> 00:18:33,680
شكراً لك

197
00:18:33,680 --> 00:18:36,900
وهل أستطيعُ استعارة هذا؟

198
00:18:37,830 --> 00:18:39,130
لا

199
00:18:39,130 --> 00:18:40,510
!آسفة

200
00:18:42,410 --> 00:18:44,820
!سأعتذر لاحقاً

201
00:19:30,280 --> 00:19:31,290
!أنتم

202
00:19:34,430 --> 00:19:35,440
!هذا مستحيل

203
00:19:46,400 --> 00:19:47,290
...التّالية هي

204
00:20:02,060 --> 00:20:03,430
...هذا مستحيل

205
00:20:05,430 --> 00:20:07,200
ما الذي يجري؟

206
00:20:07,200 --> 00:20:08,640
...الأميرة فيني

207
00:20:13,010 --> 00:20:14,100
إيزيتّا؟

208
00:20:14,410 --> 00:20:17,280
أي فتاة هذه؟

209
00:20:17,280 --> 00:20:21,590
هذا لا يُصدَّق لدرجة أنّ أعدائنا والحلفاء
...في حالة فوضى

210
00:20:17,560 --> 00:20:19,590
لماذا تفعلُ كلّ هذا؟

211
00:20:21,600 --> 00:20:24,780
لن أدعك مشاعرك تذهبُ سدى

212
00:20:26,080 --> 00:20:26,950
هانس

213
00:20:27,400 --> 00:20:32,230
هل من وسيلةٍ يستطيعُ الجنود في كينينبيرغ
بواسطتها أن يسمعوا كلامي؟

214
00:20:38,220 --> 00:20:39,630
...رائع

215
00:20:39,630 --> 00:20:40,800
!الرّقيب أوّل

216
00:20:40,800 --> 00:20:42,280
