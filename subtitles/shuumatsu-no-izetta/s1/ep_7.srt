1
00:00:19,780 --> 00:00:24,480
،يقول لنا خبراؤنا أنّ التجهيزات لم تكتمل بعد

2
00:00:24,480 --> 00:00:27,920
لكن يمكنُها أن تعمل كحامِلة

3
00:00:28,200 --> 00:00:30,580
...حاملة الطائرات دراخينفيلس

4
00:00:31,190 --> 00:00:34,010
لم أتوقّع أبداً أن يكملوها

5
00:02:08,440 --> 00:02:13,640
غادرت رصيف روستوك في المنطقة الجرمانيّة
،وعبرت الحزام الصّغير

6
00:02:13,640 --> 00:02:17,650
وتقبع في سوغنيفيورد في مملكتي، مملكة نورد؟

7
00:02:18,470 --> 00:02:19,410
مملكتك؟

8
00:02:19,770 --> 00:02:21,320
،حتّى لو استحوذ عليها الجرمانيّون

9
00:02:21,320 --> 00:02:23,380
!نورد هي أرضنا

10
00:02:24,310 --> 00:02:27,690
لعلّهم أخرجوها من الميناء

11
00:02:27,690 --> 00:02:31,550
كي لا تبقى حبيسة في بحر البلطيق

12
00:02:31,550 --> 00:02:33,170
لكن لماذا الآن؟

13
00:02:33,830 --> 00:02:37,210
إنّها لعبة أوتّو، أليس ذلك؟

14
00:02:39,280 --> 00:02:42,780
حاملة واحدة لا يمكنها تغيير مسار الحرب

15
00:02:42,780 --> 00:02:46,810
لكن بوجودنا هُناك الآن يجبُ علينا التّركيز عليها

16
00:02:46,810 --> 00:02:52,730
إلّا أنّ احتمال أن يُهاجمونا من خلال مضيق
نورماندي أثناء تركيزنا عليها واردٌ أيضاً

17
00:02:52,730 --> 00:02:54,160
تلقّينا نبأ مفاده

18
00:02:54,160 --> 00:02:58,280
أنّه يحشد قوى جويّة قبالة ساحل دوفر

19
00:02:58,280 --> 00:03:00,160
سحقاً لأوتّو ذاك

20
00:03:00,160 --> 00:03:02,030
يفعل ما يحلو له

21
00:03:02,030 --> 00:03:04,240
،لكن يؤسفني القول

22
00:03:04,240 --> 00:03:08,500
أنّنا لا نستطيع فعل شيء لإيقافه

23
00:03:10,000 --> 00:03:15,000
سيّد ستانلي، نحتاج لمُساعدة ولايات أطلنطا المتّحدة

24
00:03:15,000 --> 00:03:17,370
هل أنت متأكّد أنّك لا تستطيع مدّنا بقوّات؟

25
00:03:17,370 --> 00:03:22,460
الرّئيس متعاطف جدّاً مع الحالة الأوروبّية

26
00:03:22,460 --> 00:03:25,080
لكن الشّعب والمجلس التشريعي لن يسمحا بذلك

27
00:03:25,080 --> 00:03:27,560
...اللّعنة لأوتّو

28
00:03:27,560 --> 00:03:32,850
ليته بقي مهووساً بساحرة إيلستادت تلك للأبد

29
00:03:33,280 --> 00:03:34,540
هذا صحيح

30
00:03:34,540 --> 00:03:38,880
،ابتعدنا عن الموضوعِ بنقاشِنا عن الحامِلة

31
00:03:38,880 --> 00:03:42,880
لكنّنا أتينا إلى هُنا للحديثِ عن إيلستادت

32
00:03:42,880 --> 00:03:45,190
للحديثِ عن ماذا؟

33
00:03:45,620 --> 00:03:49,240
تلك الفتيات الصّغيرات ينفّذن خطّة تهويل إعلامي

34
00:03:49,240 --> 00:03:50,930
لكن "ساحرة"؟

35
00:03:50,930 --> 00:03:53,690
نحنُ في وسط القرن العشرين

36
00:03:53,690 --> 00:03:55,950
لكن إن صحَّ ذلك فهو يستحقُّ وقتنا

37
00:03:55,950 --> 00:03:57,870
شاهدتُ المقطع كذلك

38
00:03:57,870 --> 00:04:00,430
إن كانَتْ حقيقيّة فستكون ذات شأن كبير

39
00:04:00,430 --> 00:04:05,870
إذا كانت الشرارة التي ستغيّرُ هيمنة الجرمانيين
الكبيرة في أوروبّا

40
00:04:05,870 --> 00:04:07,600
فسيكون هذا مثيراً للغاية

41
00:04:08,070 --> 00:04:09,320
،يا سادة

42
00:04:09,320 --> 00:04:12,880
لا فائدة من مُناقشتنا حول مقدرات السّاحرة

43
00:04:12,880 --> 00:04:15,850
أو نوايا إيلستادت الحقيقيّة هنا

44
00:04:15,850 --> 00:04:19,880
لهذا استدعيتُ بعضاً من الضيوف المميّزين اللّيلة

45
00:04:20,800 --> 00:04:24,530
لِمَ لا تسألونهم؟

46
00:04:29,380 --> 00:04:32,100
لم نرك منذُ وقت طويل يا سعادة الأمير ماغنوس

47
00:04:32,500 --> 00:04:34,500
تشرّفني رؤيتك ثانية

48
00:04:34,780 --> 00:04:36,350
!هذه أورتفيني

49
00:04:36,350 --> 00:04:37,210
!مستحيل

50
00:04:38,480 --> 00:04:41,200
أنا أورتفيني فون إيلستادت

51
00:04:41,200 --> 00:04:41,880
...و

52
00:04:49,070 --> 00:04:50,180
ما الذي تفكّرين به؟

53
00:04:50,180 --> 00:04:52,250
لا داعي للقلق

54
00:04:52,250 --> 00:04:54,690
ثمّة شخص أودُّ منكم أن تلتقوا به

55
00:04:59,160 --> 00:05:00,470
...مستحيل

56
00:05:03,240 --> 00:05:05,800
!مرحباً! أنا إيزيتّا

57
00:05:14,410 --> 00:05:18,420
شكراً لقطعكما كلّ هذه المسافة إلى هنا
أثناء هذه الفترة الحفيفة بالمخاطر

58
00:05:18,930 --> 00:05:23,680
أتيتُ لأنّني سمعتُ بأنّ الدّول المُتحالِفة
سوف تجتمع

59
00:05:23,680 --> 00:05:26,560
،وبقوّة إيزيتّا

60
00:05:26,560 --> 00:05:29,890
كان الوصول إلى بريتانيا مسألة بسيطة

61
00:05:29,890 --> 00:05:31,530
هكذا إذاً

62
00:05:32,150 --> 00:05:35,270
لكن هذا القدر كافٍ كإثبات وإيضاح

63
00:05:38,690 --> 00:05:41,520
،لعلّ الفتاة ساحرة

64
00:05:41,520 --> 00:05:43,320
لكن لا يوجدُ إلّا واحدة منها

65
00:05:43,320 --> 00:05:45,410
!لا يمكنها فعل الكثير بمفردها

66
00:05:45,410 --> 00:05:47,200
ربّما

67
00:05:47,200 --> 00:05:52,450
لكن هذه القوّة قد حقّقَتْ لنا النصر
في كينينبيرغ ومعبر فيالي

68
00:05:52,880 --> 00:05:57,920
لكن لو احتجتُم للمُقارنة، فقوّة إيزيتّا
هي أشبه بسيف حادّ مُدبَّب

69
00:05:58,390 --> 00:06:02,380
طعن نقطة واحدة سيكون كافياً
لإسقاط العملاق الجرمانيّ

70
00:06:02,380 --> 00:06:05,420
تطلبين منّا جنوداً إذاً

71
00:06:06,290 --> 00:06:10,390
أعلمُ أنّكم لا تستطيعون الاستجابة
لمثل هذا الطلب المُفاجئ

72
00:06:11,320 --> 00:06:14,840
يجبُ أن تقنعوا أسيادكم وشعبكم

73
00:06:15,410 --> 00:06:17,350
،لذا سأسهّلُ عليكم ذلك الأمر

74
00:06:17,350 --> 00:06:22,470
بحلِّ المعضلة الكُبرى التي تُواجهونها الآن

75
00:06:23,420 --> 00:06:24,230
...هل تقصدين

76
00:06:26,240 --> 00:06:28,290
...حاملة الطائرات دراخينفيلس

77
00:06:28,290 --> 00:06:31,820
،بقوّة إيزيتّا

78
00:06:33,360 --> 00:06:35,190
!سأكسرُ أنياب أوتّو الحديثة إلى نصفين

79
00:06:41,790 --> 00:06:44,630
شكراً لك، فخامة الإيرل ريدفورد

80
00:06:45,480 --> 00:06:47,420
لإحضارنا إلى هنا كما هو مخطّط

81
00:06:47,960 --> 00:06:51,390
أنا مدينٌ لكِ بما حدث في ويستيريا

82
00:06:51,970 --> 00:06:56,580
حسناً إذاً، أعجبني تصريحكِ بخصوص حاملة الطائرات

83
00:06:56,580 --> 00:07:00,560
،منذُ سمعنا عن الحاملة ونحن في طريقنا إلى هنا

84
00:07:01,480 --> 00:07:03,190
لم أتوانَ عن التّفكير في الأمر

85
00:07:05,220 --> 00:07:08,070
توصّلنا أنا وإيّاها إلى القرار معاً

86
00:07:08,070 --> 00:07:08,820
نعم

87
00:07:09,140 --> 00:07:10,500
هكذا إذاً

88
00:07:11,300 --> 00:07:13,760
سيّدي، جاءك زائر

89
00:07:13,760 --> 00:07:15,380
كنتُ أنتظره

90
00:07:15,380 --> 00:07:16,290
دعه يدخل

91
00:07:18,250 --> 00:07:24,440
هذا قائد الجناح غرومان من قوّات 633 الجويّة

92
00:07:24,440 --> 00:07:25,770
اسمي غرومان

93
00:07:25,770 --> 00:07:28,970
كان جدّي من نورد

94
00:07:28,970 --> 00:07:32,540
أعتبرها وطني الثّاني

95
00:07:33,140 --> 00:07:36,760
سأفعل ما بوسعي لألقّن أولئك الجرمانيين درساً

96
00:07:37,280 --> 00:07:39,090
يسرُّني سماع ذلك

97
00:07:39,090 --> 00:07:41,910
ويسرّني ركوبك معنا يا سيادة قائد الجناح

98
00:07:41,910 --> 00:07:43,610
،سيّد قائد الجناح

99
00:07:43,610 --> 00:07:45,930
،سأفعلُ ما بوسعي وأبذل قصارى جهدي

100
00:07:45,930 --> 00:07:48,230
!لذا ساعدني من فضلك

101
00:07:48,230 --> 00:07:49,490
!شكراً جزيلاً لك

102
00:07:51,840 --> 00:07:54,160
وأنتِ أيضاً يا آنستي السّاحرة

103
00:07:56,640 --> 00:08:00,110
مع ذلك، كنّا محظوظين لأنّ حامِلة العدوّ قد فرّت

104
00:08:00,110 --> 00:08:02,460
إلى خليج مليء بالطاقة السحريّة

105
00:08:03,780 --> 00:08:06,490
،لكن بحسبِ ما أظهرَتْه تلك الخريطة

106
00:08:06,490 --> 00:08:09,620
المناطق التي توجدُ فيها والتي لا توجد
متقاربة جدّاً

107
00:08:12,800 --> 00:08:13,510
إيزيتّا؟

108
00:08:15,040 --> 00:08:16,330
نعم؟

109
00:08:16,330 --> 00:08:17,340
ما الأمر؟

110
00:08:17,340 --> 00:08:18,660
وجهكِ أحمر

111
00:08:19,440 --> 00:08:20,410
...هل أنتِ

112
00:08:22,180 --> 00:08:23,100
...المعذرة

113
00:08:25,300 --> 00:08:26,610
هل أصبتِ بحمّى؟

114
00:08:27,200 --> 00:08:28,230
لا

115
00:08:28,720 --> 00:08:30,110
!أنا بخير

116
00:08:30,110 --> 00:08:33,210
،لكنّني أجلسُ معكِ في نفس الغرفة

117
00:08:33,640 --> 00:08:35,510
...وعلى نفس السّرير

118
00:08:35,510 --> 00:08:36,370
...المعذرة

119
00:08:37,700 --> 00:08:38,680
لا توافقين على ذلك؟

120
00:08:39,880 --> 00:08:41,700
!لا مُشكلة إذاً

121
00:08:44,120 --> 00:08:44,790
!حسناً

122
00:08:47,900 --> 00:08:50,500
ما رأيكِ من هنا؟

123
00:08:50,500 --> 00:08:51,190
—انتظري

124
00:08:51,190 --> 00:08:52,330
!فيني-ساما

125
00:08:54,440 --> 00:08:56,410
!دغدغة دغدغة دغدغة

126
00:09:04,950 --> 00:09:07,780
أُثقِلُ عليكِ بطلباتي

127
00:09:08,870 --> 00:09:13,820
كان الجميع هُناك ممثّلين عن بلادهم

128
00:09:14,710 --> 00:09:16,520
،إذا احتجتُ لمُساعدتهم

129
00:09:17,030 --> 00:09:22,680
فلا بدّ أن أثبت لهم أنّنا مُفيدون أيضاً

130
00:09:23,300 --> 00:09:25,710
اعتمدي عليّ يا فيني-ساما

131
00:09:26,180 --> 00:09:31,400
أقسمتُ أنّني سأفعل ما يلزم لحمايةِ الجميع

132
00:09:31,960 --> 00:09:36,120
لهذا سأدمّرُ تِلك الحامِلة أو أفعل أي شيء آخر تُريدينه

133
00:09:37,240 --> 00:09:38,360
...إيزيتّا

134
00:09:46,770 --> 00:09:48,270
حسناً، نِداء

135
00:09:49,010 --> 00:09:50,190
ثلاثة من نوع واحد؟

136
00:09:52,740 --> 00:09:54,040
أحسنت يا حضرة النّقيب

137
00:09:54,040 --> 00:09:56,030
أنت عنيفٌ في البوكر مثلما أنت في الجوّ

138
00:09:56,030 --> 00:09:59,030
لا، كان الحظّ فحسب

139
00:09:59,030 --> 00:10:00,810
ماذا عنك؟

140
00:10:00,810 --> 00:10:03,040
هل تستمتعُ بركوبِك الحامِلة الجرمانيّة الأولى؟

141
00:10:03,040 --> 00:10:08,250
لا أدري، لم يتمّ نصب نصف التّجهيزات بعد

142
00:10:08,250 --> 00:10:11,100
ما زالت بعض الأجزاء من الدّاخل مكشوفة

143
00:10:11,100 --> 00:10:14,440
لمحتُ طائرتك الجديدة يا حضرة النّقيب

144
00:10:14,440 --> 00:10:15,800
كانت نوعاً جديداً، أليس كذلك؟

145
00:10:16,450 --> 00:10:17,920
ما هو شكلها؟

146
00:10:17,920 --> 00:10:19,630
...دعني أرى

147
00:10:19,630 --> 00:10:21,710
إنّها مرِنة جدّاً

148
00:10:21,710 --> 00:10:24,040
وحمولة الجناح خفيفة نسبيّاً

149
00:10:24,040 --> 00:10:26,170
لذا فهي تدور بسلاسة

150
00:10:26,170 --> 00:10:28,700
والمحرّك رائع أيضاً

151
00:10:28,700 --> 00:10:30,640
أفضل بكثير من الـ 109

152
00:10:30,640 --> 00:10:32,440
—عندما تنطلق بأقصى سر

153
00:10:33,440 --> 00:10:37,150
ما زال ذلك الشيء سرّياً يا حضرة النّقيب

154
00:10:37,150 --> 00:10:39,230
أنتُم مملّون

155
00:10:39,230 --> 00:10:41,880
على أي حال، إنّها مركبة متينة

156
00:10:41,880 --> 00:10:44,180
آمل ألّا يُتقنها غيري

157
00:10:44,950 --> 00:10:46,920
نداء، وأرمي 20 إضافيّة

158
00:10:48,530 --> 00:10:50,370
بالمناسبة، قطعنا كلّ هذه المسافة إلى هنا، صحيح؟

159
00:10:51,080 --> 00:10:53,220
هل المعلومات أكيدة؟

160
00:10:53,220 --> 00:10:54,440
أجل

161
00:10:54,440 --> 00:10:59,850
وفقاً للرائد، إنّها موثوقة تماماً

162
00:11:01,650 --> 00:11:03,850
سيكون من الصّعب الفوز بمجموعةِ الورق هذه

163
00:11:06,840 --> 00:11:09,320
أيّاً يكن، سألعب فحسب

164
00:11:12,630 --> 00:11:13,660
أنسحب

165
00:11:15,200 --> 00:11:17,250
تعابير وجهك تبيّنُ ذلك بوضوح

166
00:11:17,250 --> 00:11:21,400
لا يمكنُك أن تكون مثل بيركمان

167
00:11:21,400 --> 00:11:23,570
أرجو ألّا تنزعج

168
00:11:26,940 --> 00:11:30,670
ستنزل هذا الوادي وتدخل الخليج من الخلف

169
00:11:30,670 --> 00:11:31,920
لتشنّ هجوماً مُباغِتاً

170
00:11:32,200 --> 00:11:34,330
ولماذا تسلك هذا الطريق؟

171
00:11:35,250 --> 00:11:38,830
كان هذا اقتراحاً من جانب إيلستادت

172
00:11:38,830 --> 00:11:42,940
لا مخطَّطات واردة حاليّاً بالعبور من هذا الوادي

173
00:11:42,940 --> 00:11:45,450
لذا ربّما لن يراقبوا هذه المنطقة

174
00:11:46,080 --> 00:11:47,680
أنتم تبالغون في توخّي الحذر

175
00:11:47,680 --> 00:11:48,860
أجل

176
00:11:48,860 --> 00:11:52,690
تقولُ أنّ السيّدة إيزيتّا ستحملُ صواريخ طوربيد

177
00:11:53,220 --> 00:11:55,900
وتزن 760 كيلوغراماً

178
00:11:55,900 --> 00:11:57,340
ماذا؟

179
00:12:00,370 --> 00:12:02,280
ستبدأ العمليّة في صباح الغدّ

180
00:12:02,280 --> 00:12:06,150
يمكننا إرسال طائرة استطلاع أيضاً إن أردتُم ذلك

181
00:12:06,600 --> 00:12:11,200
اذهب بمفردك من فضلك أو أرسل شخصاً تثق به

182
00:12:12,070 --> 00:12:13,470
هل الصّواريخ جاهزة للانطلاق؟

183
00:12:13,470 --> 00:12:14,210
!نعم

184
00:12:14,210 --> 00:12:15,450
تأكّد من أنّها مُحمَّلة

185
00:12:15,450 --> 00:12:17,210
!الرقم 2 جاهز! الرقم 3 جاهز

186
00:12:17,590 --> 00:12:20,010
سأعود يا فيني-ساما

187
00:12:22,840 --> 00:12:24,550
عودي بالسلامة

188
00:12:25,970 --> 00:12:26,740
!حسناً

189
00:13:09,160 --> 00:13:11,600
أنتِ مقرّبةٌ جدّاً، أليس كذلك؟

190
00:13:11,600 --> 00:13:13,120
...من الأميرة

191
00:13:13,120 --> 00:13:15,440
أعني الأرشيدوقيّة

192
00:13:15,960 --> 00:13:20,720
هذه مهمّة خطيرةٌ جدّاً بصراحة

193
00:13:20,720 --> 00:13:23,570
حتّى بالنسبةِ لكِ

194
00:13:23,570 --> 00:13:25,990
لكن تبدين سعيدة بطريقةٍ ما

195
00:13:25,990 --> 00:13:29,130
أنا سعيدة

196
00:13:29,840 --> 00:13:31,870
أستطيعُ استخدام القوّة التي يكرهها الجميع

197
00:13:31,870 --> 00:13:35,540
لحمايةِ الأرشيدوقيّة التي أحبُّها وشعب إيلستادت

198
00:13:39,330 --> 00:13:42,230
من الجميل أن يمتلك المرءُ شيئاً يحميه

199
00:13:42,690 --> 00:13:45,380
خاصّة إذا كان لديكِ القوّة لفعل ذلك

200
00:13:46,800 --> 00:13:48,920
!حسناً، اقتربنا من الوصول

201
00:13:48,920 --> 00:13:49,890
جاهزة؟

202
00:13:50,390 --> 00:13:51,350
!نعم

203
00:13:53,260 --> 00:13:54,360
!حظّاً سعيداً

204
00:13:54,360 --> 00:13:55,140
!ولكم أيضاً

205
00:13:58,530 --> 00:13:59,640
!إنّها تطير

206
00:14:12,690 --> 00:14:14,410
!حسناً، أطلق عنانهم

207
00:14:14,410 --> 00:14:15,910
!عُلِم

208
00:14:15,910 --> 00:14:16,950
!دعهم يسقطون

209
00:14:23,380 --> 00:14:24,220
!تعالوا معي

210
00:14:26,330 --> 00:14:27,380
...مذهل

211
00:14:46,710 --> 00:14:49,200
الهدف هو... الجوف؟

212
00:14:49,570 --> 00:14:53,710
إذا استطعتِ إصابة الجوف، الجزء الأدنى من سفينة، بصاروخ

213
00:14:53,710 --> 00:14:55,290
،وبشكلٍ مُباشر من المنتصف

214
00:14:55,290 --> 00:14:58,080
،سيجعلُ الضغطُ السّفينةَ تطيرُ في الهواء

215
00:14:58,080 --> 00:15:01,790
ووزن الهيكل والزخم سيجعلانها تنثني

216
00:15:01,790 --> 00:15:05,220
لكن سُرعان ما ستتبدّد موجة الصّدمة النّاجمة
عن الانفجار بعد ذلك

217
00:15:05,890 --> 00:15:08,670
،لذا ستنخفضُ درجةُ الضغط عندَ الجوف بعد ذلك

218
00:15:08,670 --> 00:15:11,760
،ولتنثني للأسفل الآن

219
00:15:11,760 --> 00:15:13,260
...ثمّ أخيراً

220
00:15:14,930 --> 00:15:18,710
،لكن إذا أردت فعل ذلك بهذه الحامِلة

221
00:15:18,710 --> 00:15:20,590
عليكِ ضربها بالصّواريخ الأربعة

222
00:15:20,590 --> 00:15:23,400
وفي نفس الوقت، إصابتها عندَ المنتصف تقريباً

223
00:15:24,070 --> 00:15:27,200
عليكِ تفجير الصّواريخ الأربعة في آن واحد

224
00:15:27,200 --> 00:15:28,280
هل يمكنُكِ فعل ذلك؟

225
00:15:30,100 --> 00:15:31,410
لا مُشكلة

226
00:15:31,410 --> 00:15:35,830
هنالِك كمّية أكثر من كافية من السّحر
ما بين هذا المكان ومركز الخليج

227
00:15:36,580 --> 00:15:37,770
!أستطيعُ فعلها

228
00:15:52,450 --> 00:15:54,010
...حالما أتخطّى هذا المكان

229
00:16:08,940 --> 00:16:09,530
!ليست هنا

230
00:16:13,240 --> 00:16:14,440
!أرسلوا السّفينة إلى البحر

231
00:16:15,320 --> 00:16:16,210
!عليّ اللّحاق بها

232
00:16:25,250 --> 00:16:26,890
!دخل الهدفُ الخليج

233
00:16:26,890 --> 00:16:28,210
!إنّها ساحرة إيلستادت

234
00:16:28,210 --> 00:16:30,060
!إلى الطيّارين، انطلقوا

235
00:16:30,060 --> 00:16:32,320
!سدّوا القمّة، كما خطّطنا تماماً

236
00:16:32,320 --> 00:16:32,920
حاضر

237
00:16:57,440 --> 00:17:01,410
عليكِ تفجير الصّواريخ الأربعة في آن واحد

238
00:17:06,310 --> 00:17:08,280
...التقت بالعدوّ، لكن

239
00:17:08,280 --> 00:17:09,090
...هذا

240
00:17:09,400 --> 00:17:10,410
ما الأمر؟

241
00:17:10,410 --> 00:17:11,710
!إنّه كمين

242
00:17:11,710 --> 00:17:13,340
!كانوا يعلمون بخطّتنا

243
00:17:18,200 --> 00:17:19,720
!ستنخرط في خِضَمِّ المعركة

244
00:17:19,720 --> 00:17:20,510
هل يمكنُك فعلها؟

245
00:17:20,810 --> 00:17:22,900
من تحسبني؟

246
00:17:22,900 --> 00:17:24,080
ترجَّل

247
00:17:24,080 --> 00:17:26,250
أم أنّك تريد الطيران معي؟

248
00:17:26,250 --> 00:17:27,500
!سيغ رايخ

249
00:17:54,160 --> 00:17:55,850
لستِ سيّئة

250
00:17:55,850 --> 00:17:57,640
لكن هذه هي نهايتكِ

251
00:17:57,640 --> 00:18:00,900
!سأردُّ لكِ اعتبار ما حدثَ في جبال الألب

252
00:18:07,070 --> 00:18:08,020
تتبعني؟

253
00:18:16,490 --> 00:18:18,610
!حسناً، نلنا من هذه

254
00:18:38,550 --> 00:18:40,090
هل استسلمَتْ؟

255
00:18:40,090 --> 00:18:41,550
!لكن لن أدعها تفلت

256
00:18:49,990 --> 00:18:50,750
!حضرة النّقيب

257
00:18:50,750 --> 00:18:51,950
!حاصروها

258
00:18:51,950 --> 00:18:53,230
!لن أدعها تخرج من الوادي الخِلاليّ

259
00:18:59,200 --> 00:19:02,160
!الطائرات تُقلِع من الحامِلة

260
00:19:04,070 --> 00:19:05,790
!هيّا بنا يا رجال

261
00:19:44,400 --> 00:19:45,820
كان هُناك ثغرة في السّحر

262
00:19:45,820 --> 00:19:46,950
عليّ أن أتوخّى الحذر

263
00:19:47,280 --> 00:19:49,570
ماذا حدث للتو؟

264
00:19:49,570 --> 00:19:51,050
هل انخفضت سرعتها؟

265
00:19:51,050 --> 00:19:51,790
توقّعتُ هذا

266
00:19:55,210 --> 00:19:56,960
والآن ماذا ستفعلين؟

267
00:19:57,360 --> 00:19:59,170
!أستطيعُ الإمساك بكِ الآن

268
00:20:07,500 --> 00:20:10,480
!وعدتُ أن أفعلها

269
00:20:16,970 --> 00:20:18,360
إنّها على قيدِ الحياة؟

270
00:20:32,710 --> 00:20:33,410
!هيّا

271
00:20:37,660 --> 00:20:38,600
ماذا؟

272
00:20:38,600 --> 00:20:41,840
هل هاجمت المصعد مُباشرة؟

273
00:20:41,840 --> 00:20:42,760
!لن أدعك

274
00:20:43,250 --> 00:20:44,840
!اتبعوني جميعاً

275
00:20:53,010 --> 00:20:54,390
!موتي

276
00:20:59,980 --> 00:21:04,530
العار لقوى بريتانيا الجويّة إذا تخلَّتْ عن سيّدة

277
00:21:05,030 --> 00:21:06,110
!سيّد غرومان

278
00:21:06,110 --> 00:21:07,490
!أيّتها الحقيرة

279
00:21:15,420 --> 00:21:15,920
!الآن

280
00:21:23,300 --> 00:21:24,760
!ممتاز

281
00:21:24,760 --> 00:21:26,240
!نلتُ من مخزون وقودهم

282
00:21:26,720 --> 00:21:29,080
سأسقطُك وأسقط السّاحرة

283
00:21:29,080 --> 00:21:29,930
—لن أدع

284
00:21:29,440 --> 00:21:31,840
هذا يكفي أيّها النّقيب

285
00:21:31,840 --> 00:21:32,430
ماذا؟

286
00:21:32,770 --> 00:21:34,900
تمّت المهمّة

287
00:21:34,900 --> 00:21:37,400
لا حاجة لمتابعة المعركة

288
00:21:37,650 --> 00:21:38,920
...لكن

289
00:21:38,920 --> 00:21:41,360
هذا أمرٌ أيّها النّقيب

290
00:21:41,640 --> 00:21:43,160
آمل أن تطيعه

291
00:21:57,090 --> 00:21:59,500
!الأجواء منعشة وجميلة هنا

292
00:22:00,690 --> 00:22:03,760
لا أدري ماذا حدث لكنّنا خرجنا بسلام

293
00:22:05,040 --> 00:22:06,840
!نجحتِ يا فتاة

294
00:22:21,210 --> 00:22:24,110
تِلك كانت نقطة ضعف السّاحرة إذاً؟

295
00:22:24,720 --> 00:22:27,240
أنا متأكّدٌ من ذلك بعد مُشاهدة المعركة اليوم

296
00:22:27,910 --> 00:22:31,580
كان استخدام دراخينفيلس كطعم أمراً مُستحقّاً

297
00:22:31,580 --> 00:22:32,330
طعم؟

298
00:22:32,660 --> 00:22:33,560
أجل

299
00:22:34,040 --> 00:22:36,480
،لو أبحرَتْ نحو البحر الشّمالي

300
00:22:36,480 --> 00:22:39,780
،لأتى البريتانيّون إليها وأغرقوها حتماً

301
00:22:40,210 --> 00:22:44,600
ولهذا سمح لي جلالته باستخدامها لتطبيقِ هذه الخطّة

302
00:22:45,910 --> 00:22:48,260
للكشفِ عن نقطةِ ضعف السّاحرة؟

303
00:22:48,600 --> 00:22:49,510
نعم

304
00:22:49,920 --> 00:22:53,810
.ولنبدأ بخطّتِنا الجديدة

305
00:22:54,210 --> 00:22:55,920
خطّة جديدة؟

306
00:22:55,920 --> 00:22:56,700
نعم

307
00:22:57,700 --> 00:23:01,580
لكن ثمّة شيء آخر أودُّ التأكُّد منه أوّلاً

308
00:23:03,190 --> 00:23:06,200
،حقيقة السّاحرة البيضاء

309
00:23:06,200 --> 00:23:08,900
والتي قيل بأنّها تكمنُ في سردابِ قلعة إيلستادت

310
00:23:11,330 --> 00:23:15,370
،يبدو أنّ عميلنا لورنس ما زال بأمان

311
00:23:15,690 --> 00:23:17,990
...لهذا أودُّ أن أطلب منه فعل ذلك، لكن

312
00:23:19,090 --> 00:23:21,080
انتظر يا سيادة الرَّائد

313
00:23:23,030 --> 00:23:26,800
هلّا نفّذتُ تلك المهمّة؟

314
00:25:06,630 --> 00:25:09,530
"الحلقة القادمة: "حكاية خرافيّة قاسية

315
00:25:10,280 --> 00:25:14,250
أهؤلاء هم النّاس الذين أقاتلهم؟