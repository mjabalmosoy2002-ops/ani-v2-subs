1
00:00:05,170 --> 00:00:07,740
!دوروتي، لنتسابق إلى الكوخ

2
00:00:20,020 --> 00:00:21,770
هل رأيت ذلك؟

3
00:01:07,360 --> 00:01:09,710
فيني-ساما

4
00:01:12,140 --> 00:01:13,700
استيقظي من فضلك

5
00:01:22,970 --> 00:01:27,480
الحلقة 1

6
00:01:28,580 --> 00:01:29,520
ما الذي يجري؟

7
00:01:30,160 --> 00:01:31,030
سعادة الأميرة

8
00:01:31,770 --> 00:01:32,840
تفتيش عشوائي؟

9
00:01:38,510 --> 00:01:40,710
!لا يجوز أن تفعلوا هذا! هذا بلد مُحايد

10
00:01:44,160 --> 00:01:46,250
سحقاً لأولئك الجنود الجيرمانيين

11
00:01:46,250 --> 00:01:48,740
ما الذي تفعله حكومة ويستريا؟

12
00:01:54,070 --> 00:01:55,380
!أنتم

13
00:01:57,600 --> 00:01:58,550
!توقّفوا

14
00:02:22,800 --> 00:02:23,740
ما الذي يجري؟

15
00:02:24,140 --> 00:02:25,300
!توبياس

16
00:02:25,300 --> 00:02:25,960
!المعذرة

17
00:02:25,960 --> 00:02:26,720
!مهلاً

18
00:02:27,250 --> 00:02:28,110
!ابتعد

19
00:02:28,110 --> 00:02:29,900
!هذه مقصورة الركّاب العامّة

20
00:02:29,900 --> 00:02:31,050
ماذا تظنّ نفسك تفعل؟

21
00:02:31,050 --> 00:02:33,310
!اخرس! نحن نطارد شخصاً مشبوهاً

22
00:02:31,200 --> 00:02:32,540
ثمّة شيء يجري هناك

23
00:02:33,110 --> 00:02:34,140
سألقي نظرة

24
00:02:33,310 --> 00:02:35,050
كيف تجرؤ على التكلّم معي بهذه الطريقة؟

25
00:02:35,050 --> 00:02:37,260
ابن عمّي هو ضابط رفيع المستوى
!في حكومة ويستريا

26
00:02:36,460 --> 00:02:37,720
وإن يكُن؟

27
00:02:38,880 --> 00:02:39,940
!أنت تعترضُ طريقي

28
00:02:41,590 --> 00:02:42,720
سيغ رايخ

29
00:02:42,720 --> 00:02:43,940
أنا من الوحدة الخاصّة

30
00:02:44,320 --> 00:02:46,380
ما الذي يجري هنا؟

31
00:02:46,380 --> 00:02:47,790
!سيغ رايخ

32
00:02:47,790 --> 00:02:49,690
أعتذر عن المتاعب

33
00:02:49,690 --> 00:02:50,730
...كما ترى

34
00:02:52,500 --> 00:02:54,270
أميرة إيلستادت؟

35
00:02:54,270 --> 00:02:57,370
أجل، عثرنا على فتاة تُطابق مواصفاتها

36
00:02:57,370 --> 00:02:58,920
ونطاردها

37
00:02:58,920 --> 00:03:01,290
،أحترم إخلاصكم لأداء مهمّتكم

38
00:03:01,290 --> 00:03:04,490
لكن ويستريا مُحايدة ولا أحترم

39
00:03:04,490 --> 00:03:06,240
تسبّبكم بفوضى في قطارهم

40
00:03:06,240 --> 00:03:07,300
...سيادة الرّائد

41
00:03:07,800 --> 00:03:09,360
أعتذر حقّاً

42
00:03:09,360 --> 00:03:11,500
سنُنهي هذا الأمر بسرعة

43
00:03:11,880 --> 00:03:13,900
آمل أن تفعلوا

44
00:03:13,900 --> 00:03:14,570
حاضر

45
00:03:17,480 --> 00:03:23,220
لكن لماذا تغادر الأميرة أورتفيني موطنها الآن
وهي وريثة عرش الأرشيدوق؟

46
00:03:24,840 --> 00:03:26,680
هل تبحث عن اللّجوء في ويستريا؟

47
00:03:26,970 --> 00:03:30,430
لا، تفضّل عائلة الأرشيدوق القتال

48
00:03:30,430 --> 00:03:34,960
حتّى آخر لحظة والسّقوط عوضاً عن الفرار

49
00:03:34,960 --> 00:03:36,110
فكّر بالأمر

50
00:03:36,930 --> 00:03:41,240
لماذا تقوم أميرة بلد صغير يعيش خوفاً
من الغزو الجيرماني

51
00:03:41,240 --> 00:03:44,380
بزيارة شخصيّة لأرض مُحايدة؟

52
00:03:46,800 --> 00:03:49,390
لمُفاوضات سياسيّة مع الحُلفاء؟

53
00:03:49,390 --> 00:03:50,500
...دعني أخمّن

54
00:03:51,280 --> 00:03:52,960
بريتانيا على الأرجح؟

55
00:04:29,600 --> 00:04:32,670
سأتوجّه إلى ألبرينغين لحضور اجتماعي

56
00:04:32,670 --> 00:04:35,250
بالسّفير البريتاني غداً مهما كلّفَني الأمر

57
00:04:35,920 --> 00:04:38,790
!يجب أن نحثّ الحُلفاء على التحرّك

58
00:04:48,530 --> 00:04:50,100
هل هذا مصير ربّما؟

59
00:04:50,500 --> 00:04:51,750
لا أدري

60
00:04:52,480 --> 00:04:56,060
لكن إذا أردتِ أن تقاومي أيّتها الأميرة

61
00:04:56,060 --> 00:04:57,480
فآمل أن تسرعي

62
00:05:12,030 --> 00:05:12,830
!سعادة الأميرة

63
00:05:21,680 --> 00:05:22,490
!انتظر

64
00:05:23,130 --> 00:05:24,950
!سعادة الأميرة، بسرعة

65
00:05:29,160 --> 00:05:30,180
!اتبعاني

66
00:05:47,160 --> 00:05:47,860
فيني-سامي

67
00:06:14,310 --> 00:06:15,930
فيني-ساما، ماذا تفعلين؟

68
00:06:16,470 --> 00:06:17,450
لا أعرف

69
00:06:18,420 --> 00:06:20,400
لكن أثار هذا اهتمامي لسبب ما

70
00:06:24,480 --> 00:06:25,500
!فيني-ساما

71
00:06:25,970 --> 00:06:28,200
يكفي إلى هذا الحدّ

72
00:06:30,690 --> 00:06:31,870
أيّتها الأميرة

73
00:06:34,450 --> 00:06:36,200
ما هذا التّابوت؟

74
00:06:36,200 --> 00:06:37,580
ماذا يوجد بداخله؟

75
00:06:38,020 --> 00:06:39,300
من في الدّاخل؟

76
00:06:39,890 --> 00:06:43,460
يؤسفني القول أنّها معلومات غاية في السرّية

77
00:06:45,920 --> 00:06:46,550
!توبياس

78
00:06:50,500 --> 00:06:51,500
فيني-ساما

79
00:06:51,990 --> 00:06:52,720
لا تستسلما

80
00:07:04,080 --> 00:07:06,230
حالما نتخطّى هذا النفق سنعبر جسراً

81
00:07:07,040 --> 00:07:09,400
هيرمان، اعتنِ بتوبياس لأجلي، مفهوم؟

82
00:07:34,160 --> 00:07:35,040
!سنقفز

83
00:07:35,040 --> 00:07:35,660
!حاضر

84
00:07:57,480 --> 00:08:00,480
إنّها صبيانيّة حقّاً كما ورد في الإشاعات

85
00:08:00,480 --> 00:08:01,790
...سيادة الرّائد

86
00:08:05,060 --> 00:08:08,060
من هذه الفتاة بالضبط؟

87
00:08:13,540 --> 00:08:14,940
يا إلهي

88
00:08:15,360 --> 00:08:17,320
ألم تكونوا تسمعون؟

89
00:08:17,320 --> 00:08:20,080
،تمثّل هذه معلومات غاية في السرّية

90
00:08:20,080 --> 00:08:23,060
وتنتمي للامبراطور بحدّ ذاته

91
00:08:32,120 --> 00:08:33,080
!توبياس

92
00:08:33,080 --> 00:08:35,490
!تماسك حضرة الرّقيب

93
00:08:36,840 --> 00:08:39,870
أين الأميرة؟

94
00:08:40,370 --> 00:08:41,630
إنّها بخير

95
00:08:41,630 --> 00:08:42,740
أنا هنا

96
00:08:43,200 --> 00:08:44,710
وبفضلك

97
00:08:45,020 --> 00:08:47,320
...سعادة... الأميرة

98
00:08:48,080 --> 00:08:52,210
...أرجوكِ... أنقذي بلدنا

99
00:08:52,520 --> 00:08:53,920
!اعتمد عليّ

100
00:08:53,920 --> 00:08:57,500
!سأحمي إيليستادت حتّى لو كلّفني هذا حياتي

101
00:08:57,500 --> 00:08:58,470
!توبياس

102
00:09:11,960 --> 00:09:16,060
لن أنسى ولاءك ما حييت

103
00:09:19,400 --> 00:09:21,700
الأوّل من سبتمبر، 1939

104
00:09:21,700 --> 00:09:27,250
شنَّت الدكتاتوريّة الأوروبّية القويّة والمعروفة
بامبراطوريّة جيرمانيا

105
00:09:27,920 --> 00:09:32,040
غزواً مفاجئاً لجارتها ليفونيا

106
00:09:33,090 --> 00:09:37,770
وكان ردّ مملكة بريتانيا وجمهوريّة تيرميدور

107
00:09:37,770 --> 00:09:40,160
إعلاناً للحرب ضدّ جيرمانيا

108
00:09:40,160 --> 00:09:42,640
واندلعت الحرب

109
00:09:43,700 --> 00:09:48,030
لكن تكتيات الحرب الخاطفة التي اتّبعتها
والتي مزجَتْ بين الهجوم الجوّي والهجوم البرّي بالدبّابات

110
00:09:48,030 --> 00:09:50,970
أخضعَتْ جيران جيرمانيا الأصغر منها حجماً

111
00:09:51,610 --> 00:09:54,860
،وحتّى دولة تيرميدور

112
00:09:54,860 --> 00:09:57,060
والتي كان يُعتقَد بأنّها تشكّل خطراً كبيراً
قد سقطَتْ أيضاً

113
00:09:57,640 --> 00:10:02,800
والآن جيرمانيا على وشك أن تكشّر عن أنيابها
في وجه دولة صغيرة تقع في جبال الألب

114
00:10:03,440 --> 00:10:06,940
تُعرَف باسم دوقيّة إيلستادت

115
00:10:56,340 --> 00:11:00,120
لا وقت لديكِ للبكاء أو الحزن يا فيني

116
00:11:02,020 --> 00:11:04,640
يمكنكِ أن تبكي عندما تكملين أداء واجبكِ

117
00:11:07,160 --> 00:11:09,530
سعادة الأميرة، ماذا كان ذلك الصّوت؟

118
00:11:09,530 --> 00:11:10,590
لا تقلق

119
00:11:10,590 --> 00:11:11,980
كنتُ أقوم بتمارين إحماء فحسب

120
00:11:12,550 --> 00:11:14,280
هل ملابسي جاهزة؟

121
00:11:16,050 --> 00:11:19,740
لقد طلبتُ من صاحبة النُّزل أن تحضّر لك لباساً

122
00:11:19,740 --> 00:11:22,040
احرص على أن تشكرها جيّداً إذاً

123
00:11:22,040 --> 00:11:26,000
حتّى لو كانت هذه منطقة محايدة، هذا لا يعني
أنّ مكوثي هنا ليس بخطير

124
00:11:26,000 --> 00:11:29,440
وُلِدَتْ صاحبة النُّزل في إيلستادت

125
00:11:29,440 --> 00:11:33,430
قالَتْ أنّها يشرّفها أن تخدمكِ

126
00:11:43,170 --> 00:11:47,190
ثِقة النّاس هي ما تبقيني على قيد الحياة، أليس كذلك؟

127
00:11:51,440 --> 00:11:52,810
وايس هيكسي

128
00:11:53,960 --> 00:11:55,940
السّاحرة البيضاء؟

129
00:12:11,120 --> 00:12:13,200
هل يتمّ نقله جوّاً فيما تبقّى من مسافة؟

130
00:12:13,200 --> 00:12:14,190
أجل

131
00:12:14,190 --> 00:12:19,460
أخبرتني الجماعة في الورشة أنّه رُغم فتحه
لفترة قصيرة من الزمن إلّا أنّ هذا يشكّل خطراً بعض الشّيء

132
00:12:20,690 --> 00:12:25,300
يريدون إرساله إلى العاصمة الامبراطوريّة في أسرع وقت مُمكن

133
00:12:26,900 --> 00:12:28,380
هل تعتقد حقّاً

134
00:12:28,380 --> 00:12:31,640
أنّه أباد سريّة كاملة بمفرده يا سيادة الرّائد؟

135
00:12:32,080 --> 00:12:33,400
لا أدري

136
00:12:35,160 --> 00:12:38,800
لكن يبدو أنّ جلالته مهتمّ جدّاً بالأسطورة

137
00:12:38,800 --> 00:12:40,780
من واجبنا التّحقيق في الأمر

138
00:12:43,200 --> 00:12:44,300
...ناهيك عن أنّه

139
00:12:45,570 --> 00:12:47,360
...إن ثَبُتَتْ صحّتها

140
00:12:47,360 --> 00:12:50,200
ألن يكون ذلك رومانسيّاً؟

141
00:13:11,240 --> 00:13:13,860
أعتذر عن إزعاجك في هذا المساء

142
00:13:13,860 --> 00:13:16,140
!أصبحتِ حلوة كثيراً

143
00:13:16,630 --> 00:13:20,610
لا عجب في افتتانِ أميرنا هنري بكِ

144
00:13:21,180 --> 00:13:24,120
تبدين بهيّة حقّاً يا سعادة الأميرة فيني

145
00:13:24,120 --> 00:13:27,980
مهارتك في المُغازلة لم تتغيّر البتّة يا سيّد ريدفورد

146
00:13:29,120 --> 00:13:33,830
تأثّر جلالته بالرسالة التي أرسلتِها

147
00:13:34,520 --> 00:13:36,160
كيف حالُ والدكِ؟

148
00:13:36,720 --> 00:13:39,000
لا داعي للقلق

149
00:13:39,000 --> 00:13:41,040
يتعافى تدريجيّاً

150
00:13:41,440 --> 00:13:42,510
!هكذا إذاً

151
00:13:42,510 --> 00:13:46,170
إذاً المعلومات التي تلقّيتُها حول عدم قدرة

152
00:13:46,170 --> 00:13:50,220
الأرشيدوق بمغادرة سريره بعد الآن
كانت خاطئة على ما يبدو

153
00:13:50,220 --> 00:13:51,540
بديع

154
00:13:52,160 --> 00:13:53,310
هكذا يبدو

155
00:13:55,360 --> 00:13:58,270
ستصبحين قائدة ممتازة

156
00:13:58,790 --> 00:14:00,970
يشرّفني كلامك هذا

157
00:14:00,970 --> 00:14:02,230
تفضّلي من هنا

158
00:14:06,620 --> 00:14:10,190
يؤلمني جدّاً أن أقول هذا الكلام

159
00:14:10,190 --> 00:14:12,750
لكن يبدو أنّه سيكون من الصّعب على قوّاتنا

160
00:14:12,750 --> 00:14:15,430
أن يذهبوا في بعثةٍ أخرى إلى القارّة

161
00:14:15,910 --> 00:14:20,090
تكبّدنا خسائر فادحة خلال الانسحاب الأخير

162
00:14:22,200 --> 00:14:26,940
سبقَ وحاولت إغراء شركة آينبيرغر في بلدنا

163
00:14:26,940 --> 00:14:29,630
بالانتقال إلى بريتانيا، أليس كذلك؟

164
00:14:29,920 --> 00:14:35,020
عمّال إيلستادت الصّناعيّون الذين يصنعون
آلات دقيقة فاتنون حقّاً

165
00:14:35,020 --> 00:14:37,550
لكن جميعهم قالوا أنّهم مُحال أن يخونوا

166
00:14:37,550 --> 00:14:40,640
الدّولة والأرشيدوق اللّذين كان لهما الفضل
بوصولهم إلى ما وصلوا إليه

167
00:14:40,640 --> 00:14:41,640
نعم

168
00:14:41,640 --> 00:14:43,530
كلّهم رجال مخلصون

169
00:14:44,080 --> 00:14:45,690
،ولهذا

170
00:14:45,690 --> 00:14:49,700
إذا علموا أنّ بريتانيا قد فعلَتْ ما بوسعها
لمُساعدة إيلستادت

171
00:14:50,100 --> 00:14:53,220
فسيتلهّفون لردّ الجميل لكم

172
00:14:55,080 --> 00:14:56,520
هكذا إذاً

173
00:14:56,520 --> 00:14:58,900
هذا مُغرٍ للغاية

174
00:14:59,320 --> 00:15:03,420
لكنّه ليس كافياً لكسب استحسان الحزب والرأي العامّ

175
00:15:03,960 --> 00:15:07,200
ماذا إذاً لو كانت إيلستادت

176
00:15:07,200 --> 00:15:09,950
،وطناً لزوجة هنري

177
00:15:09,950 --> 00:15:12,180
وريثة العرش؟

178
00:15:13,200 --> 00:15:16,800
ألن يرغب الحزب وشعب دولتك حينئذ بإرسال

179
00:15:16,800 --> 00:15:19,140
قوّات إلى القارّة مرّة أخرى؟

180
00:15:19,140 --> 00:15:20,400
...هل تقصدين

181
00:15:20,400 --> 00:15:23,080
،سبقَ ورفضتُ عرضه

182
00:15:23,600 --> 00:15:28,610
لكن أودُّ أن أقبل بعرض الزواج من الأمير هنري

183
00:15:28,910 --> 00:15:31,480
وتتخلّين عن حقّكِ بعرش الأرشيدوق؟

184
00:15:31,890 --> 00:15:34,520
ابنة عمّي ليونورا وطفلها

185
00:15:34,520 --> 00:15:37,030
سأعهدُ بمُستقبل العائلة بين أيديهما

186
00:15:40,160 --> 00:15:44,000
أنتِ حقّاً أميرة بالفطرة، ألستِ كذلك؟

187
00:15:56,280 --> 00:15:56,850
سيّدي

188
00:15:58,530 --> 00:15:59,310
المعذرة

189
00:16:13,570 --> 00:16:18,200
سعادة الأميرة، أنا متأثّر حقّاً برغبتك
في التّضحية بنفسكِ

190
00:16:18,200 --> 00:16:19,620
لأجل بلدكِ

191
00:16:22,660 --> 00:16:25,310
وهذا يزيد الأمر حزناً فوق حزنه

192
00:16:25,310 --> 00:16:27,720
،مهما قدّمتِ من شروط

193
00:16:27,720 --> 00:16:29,320
لا نستطيع مُساعدتك

194
00:16:29,320 --> 00:16:30,010
لماذا؟

195
00:16:34,870 --> 00:16:37,270
لأنّ الأوان قد فات الآن

196
00:16:40,460 --> 00:16:45,150
اقتحمت جيرمانيا الخطوط الدفاعيّة لحدود
إيلستادت للتوّ

197
00:16:45,150 --> 00:16:47,110
وشنّت غزوها

198
00:18:17,730 --> 00:18:18,990
أهذا من تدبيرك؟

199
00:18:19,430 --> 00:18:20,260
...لا

200
00:18:21,090 --> 00:18:24,520
مع أنّني لا أتوقّع أن تصدّقيني

201
00:18:24,520 --> 00:18:27,560
الكلب البريتاني بريء

202
00:18:28,930 --> 00:18:34,250
كلّ ما في الأمر أنّ شبكة امبراطوريّة جيرمانيا
التجسُّسيّة كانت متفوِّقة

203
00:18:38,400 --> 00:18:40,680
أنتِ حسناء كما سمعت

204
00:18:43,130 --> 00:18:45,660
سيسعد الامبراطور

205
00:18:46,500 --> 00:18:48,100
ماذا تنوون أن تفعلوا بي؟

206
00:18:48,100 --> 00:18:49,780
...في الواقع

207
00:18:50,520 --> 00:18:54,000
أظنّكِ سترافقيننا مبدئياً

208
00:18:54,000 --> 00:18:56,600
إلى عاصمتنا، نويه برلين

209
00:19:08,100 --> 00:19:09,630
،إنّها آلة بدائيّة جدّاً

210
00:19:09,630 --> 00:19:11,940
لكن لا تقلقي، لن يطول بقاؤكِ على متنها

211
00:19:15,730 --> 00:19:17,300
هل أنتِ مهتمّة؟

212
00:19:18,000 --> 00:19:21,910
هذه هي كلّ الأسرار العسكريّة الهامّة

213
00:19:23,000 --> 00:19:25,660
وكذلك أنتِ في الواقع

214
00:19:29,600 --> 00:19:32,890
سأستميحك عذراً. إنّها ليست أجمل شيء في الوجود

215
00:19:42,340 --> 00:19:46,910
ينبغي أن نعبر حدود إيلستادت الآن

216
00:19:49,560 --> 00:19:51,000
ما أخبار الحرب؟

217
00:19:52,340 --> 00:19:56,090
ما زالوا على ما يبدو يُقاومون مُقاومة عقيمة

218
00:19:56,410 --> 00:20:00,410
ليسَتْ إلّا مسألة وقت قبل أن يسقطوا

219
00:20:00,410 --> 00:20:01,550
لا تكن واثقاً

220
00:20:02,070 --> 00:20:04,260
شعبي عنيد جدّاً

221
00:20:04,760 --> 00:20:06,300
لا يستسلم بسهولة

222
00:20:06,300 --> 00:20:08,330
ربّما

223
00:20:08,330 --> 00:20:10,760
،لكن إذا استمرّوا في مُقاومتهم

224
00:20:10,760 --> 00:20:14,060
فستفنى أميرتهم المحبوبة

225
00:20:15,320 --> 00:20:17,500
إذا علِموا بذلك فهل تعتقدين

226
00:20:17,500 --> 00:20:19,070
أنّهم سيعيدون النّظر في الأمر؟

227
00:20:19,880 --> 00:20:22,840
!أتستخدمني للابتزاز إذاً؟

228
00:20:23,660 --> 00:20:27,210
هذا مجرّد كلام نظريّ

229
00:20:28,200 --> 00:20:30,360
،أنتِ أميرة إيلستادت

230
00:20:30,360 --> 00:20:32,320
وعذراء حسناء

231
00:20:32,320 --> 00:20:36,380
هنالك طرُق أخرى كثيرة لاستغلالكِ

232
00:20:44,370 --> 00:20:44,960
!لا

233
00:21:15,630 --> 00:21:16,290
!الملازم الأوّل

234
00:21:19,490 --> 00:21:20,550
توقّفا

235
00:21:20,550 --> 00:21:22,800
أنتِ صبيانيّة حقّاً

236
00:21:22,800 --> 00:21:25,360
لكنّكِ كعصفور في قفص

237
00:21:25,360 --> 00:21:28,820
إذا عصيتِ الأوامر فسنكسر عنقكِ وينتهي الأمر

238
00:21:29,600 --> 00:21:30,680
!افعلوا ذلك إذاً

239
00:21:30,680 --> 00:21:33,150
هل تفضّلين الموت إذاً؟

240
00:21:33,150 --> 00:21:36,190
أهذا ما ينبغي لأميرة تحمل أعباء
شعبها أن تفعله؟

241
00:21:40,320 --> 00:21:43,440
لا أنكر أنّ شعبي هو ما يبقيني على قيد الحياة

242
00:21:43,440 --> 00:21:46,650
فحياتي وُجِدَتْ بفضل حبّهم فقط

243
00:21:47,860 --> 00:21:48,780
ماذا؟

244
00:21:48,780 --> 00:21:51,050
إذا أشهرَ شعبي سلاحه

245
00:21:51,050 --> 00:21:53,160
،وضحّى بحياته للقتال

246
00:21:51,200 --> 00:21:53,160
...هذا الصّوت

247
00:21:54,210 --> 00:21:57,350
فسأقاتل حتّى الرّمق الأخير كذلك

248
00:21:57,730 --> 00:22:00,160
،أقسم بشرف عائلتي

249
00:22:00,160 --> 00:22:02,220
!حتّى تُراق آخر قطرة من دمي

250
00:22:03,090 --> 00:22:04,580
اسمي فيني

251
00:22:05,200 --> 00:22:08,590
!أميرة إيلستادت الأولى وأرشيدوقيّتها التّالية

252
00:22:09,680 --> 00:22:13,260
!أورتفيني فريديريكا فون إيلستادت

253
00:22:39,560 --> 00:22:41,290
الأميرة...؟

254
00:22:41,960 --> 00:22:44,110
...هل يُعقَلُ أن تكوني

255
00:22:48,120 --> 00:22:49,160
!إيزيتّا

256
00:22:50,450 --> 00:22:52,280
هل أنا أتوهّم؟

257
00:22:53,160 --> 00:22:56,810
......ساحرتي... البيضاء

258
00:23:00,470 --> 00:23:03,190
!سعادة الأميرة

259
00:23:31,050 --> 00:23:32,390
!سعادة الأميرة

260
00:23:36,890 --> 00:23:37,600
!مدّي يدكِ

261
00:24:18,800 --> 00:24:19,960
...إيزيتّا

262
00:24:22,670 --> 00:24:24,100
...سعادة الأميرة

263
00:24:25,680 --> 00:24:28,980
!سعادة الأميرة

264
00:25:36,370 --> 00:25:39,780
"الحلقة القادمة: "نُدَب وتراشُق نيران

265
00:25:40,950 --> 00:25:44,460
سعادة الأميرة، هل ستُصبحين أملي؟