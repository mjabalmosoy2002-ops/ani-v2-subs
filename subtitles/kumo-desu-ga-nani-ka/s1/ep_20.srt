1
00:00:02,940 --> 00:00:06,190
!كلّ ما يُحيط حولي حلويّات لذيذة

2
00:00:06,190 --> 00:00:08,470
!لا ضير من مُساعدة النّاس في نهاية المطاف

3
00:00:13,520 --> 00:00:14,490
من هذا؟

4
00:00:15,980 --> 00:00:18,740
أنت كابوس المتاهة إذاً؟

5
00:00:19,180 --> 00:00:20,530
ما خطبه؟

6
00:00:20,750 --> 00:00:25,440
أجد صعوبة في التّصديق بأنّ هذه
الحشرة دمّرت إحدى حصوننا

7
00:00:25,440 --> 00:00:26,500
لا يهمّ

8
00:00:26,760 --> 00:00:30,170
حشرة؟ هل يتكلّم عنّي؟

9
00:00:30,170 --> 00:00:34,000
ما زالت لديّ نقاط عمياء، لكن بدأتُ
أخيراً أفهم اللّغة

10
00:00:34,000 --> 00:00:36,500
إذاً... حصن؟ دُمِّر؟

11
00:00:36,710 --> 00:00:39,810
!ما هذا؟

12
00:00:50,830 --> 00:00:53,290
ربّما لا ينبغي أن أقتلهم جميعاً

13
00:00:53,290 --> 00:00:55,070
سأجرّب التّراجع

14
00:01:05,580 --> 00:01:07,450
!لم أكن هنا أبداً

15
00:01:09,140 --> 00:01:12,830
تذكّرت! في ذلك الوقت عندما ارتكبتُ
!هفوة وأسقطتُ بناء كاملاً

16
00:01:12,830 --> 00:01:14,310
هل له صِلة بذلك الأمر؟

17
00:01:14,310 --> 00:01:16,450
ينبغي أن تكون ممتنّاً

18
00:01:16,450 --> 00:01:19,300
مملكة أوتس تستضيفك

19
00:01:20,230 --> 00:01:22,180
ما الّذي يريده هذا الرّجل؟

20
00:01:22,180 --> 00:01:23,050
عجباً

21
00:01:23,300 --> 00:01:25,400
!عمّاذا تتحدّث؟

22
00:01:25,400 --> 00:01:27,320
!احترم الوحش الإلهيّ أكثر من ذلك

23
00:01:27,320 --> 00:01:28,390
!اصمتوا

24
00:01:31,220 --> 00:01:35,390
أيّها الناس! هل تدركون ما يعنيه أن تُشهروا سيفاً

25
00:01:35,390 --> 00:01:40,320
في وجه مبعوث رسميّ من مملكة أوتس؟

26
00:01:40,910 --> 00:01:43,160
هذا الشيء هو غالباً من ملكية أوتس

27
00:01:43,160 --> 00:01:45,830
وبالتالي يحقُّ لنا فعل ما نشاء به

28
00:01:46,100 --> 00:01:50,580
ثمّة شيء متناقض فيزيولوجيّاً في وجه البدين

29
00:01:50,870 --> 00:01:54,880
لا يحقّ لك الرّفض. تعال معنا

30
00:01:58,120 --> 00:01:59,580
!ماذا تفعل؟

31
00:02:03,940 --> 00:02:05,800
!إلى أين تعتقد نفسك ذاهباً؟

32
00:02:05,800 --> 00:02:09,340
!أتعتقد أنّ حشرة مثلك تستطيع إهانتي؟

33
00:02:09,340 --> 00:02:11,120
!سيكلّفك هذا حياتك

34
00:02:11,410 --> 00:02:15,450
أشعر وكأنّه نموذج تقليدي بحت من
نماذج الشخصيّات الشرِّيرة

35
00:03:48,870 --> 00:03:50,000
!سيّدي

36
00:03:51,550 --> 00:03:53,710
المزيد من الرّسائل

37
00:03:55,060 --> 00:03:57,220
كم صاروا هذا الشّهر؟

38
00:03:57,940 --> 00:04:00,760
،إذا حسبنا الإشعارات من الدّبلوماسيّين في الخارج

39
00:04:00,760 --> 00:04:03,270
،والطبقة النبيلة المُقيمة في القصر حالياً

40
00:04:03,270 --> 00:04:05,230
يُصبِح المجموع عشرة

41
00:04:06,740 --> 00:04:08,560
ناهيك عن عددٍ كبير من الضيوف

42
00:04:08,920 --> 00:04:11,680
...كلّ هذا بسبب كابوس المتاهة

43
00:04:11,680 --> 00:04:13,380
"أو ربّما الأنسب القول "اللّوم عليه

44
00:04:14,040 --> 00:04:16,030
،لا ضير من تشكيل معارِف جديدة

45
00:04:16,030 --> 00:04:18,720
لكن بعض الضّيوف غير مُرحَّب بهم

46
00:04:20,350 --> 00:04:22,240
!تبّاً، تبّاً، تبّاً

47
00:04:22,470 --> 00:04:25,740
!تِلك الحشرة المُستفزّة! كيف تجرؤ على الاستهزاءِ بي؟

48
00:04:28,060 --> 00:04:30,520
...على ذكرِهم

49
00:04:30,840 --> 00:04:36,060
يبقى دبلوماسيّاً شرعيّاً من أوتس. لا يُمكننا طرده

50
00:04:40,000 --> 00:04:41,600
ماذا يجب أن نفعل يا سيّدي؟

51
00:04:42,020 --> 00:04:44,000
أحضروه بالقوّة

52
00:04:44,270 --> 00:04:46,210
سنعلّم ذلك الشيء مكانته

53
00:04:46,770 --> 00:04:48,260
ما الطريقة التي نستخدمها؟

54
00:04:48,550 --> 00:04:50,580
بأي طريقة ترونها مُناسِبة

55
00:04:50,580 --> 00:04:52,450
اقبضوا عليه فحسب

56
00:04:52,450 --> 00:04:54,610
حسناً، عُلِم

57
00:05:00,350 --> 00:05:04,830
كنتُ أفعل كلّ ما باستطاعتي لتجنُّب حرب مع أوتس

58
00:05:05,220 --> 00:05:08,740
لكن ماذا لو انتهى المطافُ أن يصبح
كابوس المتاهة هو الفتيل؟

59
00:05:08,740 --> 00:05:11,290
سيكون كابوساً حرفيّاً

60
00:05:13,050 --> 00:05:14,570
أعتذر يا سيّدي

61
00:05:15,180 --> 00:05:21,290
رغم ذلك، ما الّذي تُفكِّر فيه مملكةُ أوتس
بإرسالها رجلا كهذا كمبعوث؟

62
00:05:21,290 --> 00:05:23,550
...هو وفرض التّعرفات وقُطّاع الطُرق هؤلاء

63
00:05:24,160 --> 00:05:26,810
وكأنّهم يُريدون حرباً

64
00:05:28,680 --> 00:05:30,870
لكن لن أسمح بحدوث ذلك

65
00:05:31,580 --> 00:05:33,050
سيتوجّب علينا مُعاملة الأمور بحذر

66
00:05:40,030 --> 00:05:44,450
يبدو أنَّ البدين يقِفُ عند منزل مصَّاصة الدِّماء الرَّضيعة

67
00:05:50,330 --> 00:05:54,540
بدأ الأمر يتعقّد... أفكِّر في الانتقال إلى مكانٍ آخر

68
00:05:54,540 --> 00:05:57,330
لكن إذا فعلت، ستكون دراكولا الصّغيرة في خطر

69
00:05:57,990 --> 00:06:01,830
وعليّ أن أعترف، لستُ مستعجلة في التخلّي
عن هذه الحِمية الغنيّة بالفواكه واللّذيذة

70
00:06:02,370 --> 00:06:04,730
ماذا أفعل؟

71
00:06:06,220 --> 00:06:11,090
حسناً، سوف أغادر إذا أتت سيّدة
الشّيطان على أيّ حال

72
00:06:11,610 --> 00:06:14,840
ماذا تنوي أن تفعل يا تُرى؟

73
00:06:30,850 --> 00:06:33,220
!ما الأمر؟ هذا مُرعِب

74
00:06:33,220 --> 00:06:38,110
لا أعرف بالتّحديد، لكنّها تُقاتل تنِّينَ
أرض قويّ بشكلٍ جنوني

75
00:06:38,110 --> 00:06:39,520
جيّد أنّه هو لا أنا

76
00:06:39,520 --> 00:06:42,650
أعتقد سأترك أسياد الشّيطان غافلين عنّي

77
00:06:42,650 --> 00:06:45,950
بالإضافةِ إلى أنّني مُمتنّة لكلّ الوقت
الإضافي الّذي أكتسبه من وراء ذلك

78
00:06:45,950 --> 00:06:49,620
!بالتوفيقِ لك يا تنِّين الأرض! أشجِّعك

79
00:06:51,020 --> 00:06:51,890
ماذا الآن؟

80
00:06:54,060 --> 00:06:55,130
!إنّه هو

81
00:06:56,640 --> 00:06:59,170
الرّجل الّذي ظهر عندما هزمتُ تنّين النّار

82
00:06:59,170 --> 00:07:02,140
ظهرَ فجأة من جديد. ماذا يريد هذه المرّة؟

83
00:07:04,000 --> 00:07:06,390
لا أنوي أذيّتك

84
00:07:06,980 --> 00:07:11,270
أعتقد يمكنني أن أفترِض أنّه لم يأتِ للقتال إذاً

85
00:07:11,270 --> 00:07:12,660
صحيح؟

86
00:07:12,990 --> 00:07:16,130
هذه أوّل مرّة نتحادث فيها هكذا

87
00:07:16,130 --> 00:07:19,260
أنا مُدير يُدعى غوليديستوديز

88
00:07:19,260 --> 00:07:22,830
!ماذا قلت؟ غوي... غيلي... غويليو؟ طويل جدّاً

89
00:07:22,830 --> 00:07:24,220
سأسمّيك غيلي-غيلي

90
00:07:24,220 --> 00:07:26,040
أتيتُ لأطلب منك معروفاً

91
00:07:26,040 --> 00:07:26,920
معروف؟

92
00:07:27,300 --> 00:07:29,920
هلّا توقّفت عن مُهاجمة أرييل؟

93
00:07:31,820 --> 00:07:34,920
أرييل هو اسم سيّدة شيطان، صحيح؟

94
00:07:34,920 --> 00:07:37,200
هل هاجمتُها في فترةٍ ما؟

95
00:07:37,200 --> 00:07:40,170
!على العكس، هي من استهدفَتْني

96
00:07:40,170 --> 00:07:44,260
أعلم أنّه من الأنانيّ أن أطلب طلباً كهذا

97
00:07:44,730 --> 00:07:48,430
وإن رفضت، سأتفهّم ذلك

98
00:07:50,910 --> 00:07:53,050
لا أعرف ماذا أقول

99
00:07:53,050 --> 00:07:57,550
كنتُ أتنقّل من مكانٍ لآخر في مُعظم
أوقاتي. متى هاجمتُها؟

100
00:07:58,140 --> 00:08:00,460
!انتظر، أعرِف ما يعنيه

101
00:08:01,920 --> 00:08:03,950
!الفنّانة المعروفة بعقلِ الجسد

102
00:08:02,900 --> 00:08:05,320
!الجسد

103
00:08:03,950 --> 00:08:06,950
!هذا صحيح، إنّها داخل سيّدة الشّيطان الآن

104
00:08:07,330 --> 00:08:10,910
،لكن منذُ وفاة أمّي، قُطِع الاتّصال

105
00:08:10,910 --> 00:08:13,710
لذا لا أعلم ما الّذي يجري

106
00:08:14,170 --> 00:08:15,690
لكن هذا منطقيّ

107
00:08:15,690 --> 00:08:20,030
،ظننتُ أنَّ سيّدة الشيطان كانَتْ تستهدفني انتقاماً لأمّي

108
00:08:20,030 --> 00:08:24,020
لكن السّبب هو أنّ عقل الجسد السّابق
الخاص بي ما زال يفرض ذلك الحصار النفسيّ

109
00:08:25,430 --> 00:08:26,950
ما قولك؟

110
00:08:26,950 --> 00:08:27,770
!بئساً

111
00:08:27,770 --> 00:08:32,530
سنوات تحليقي مُنفرِدة جعلَتْني أسرح
في عالمي الصّغير بدلاً من الردّ

112
00:08:32,530 --> 00:08:33,530
!آسفة

113
00:08:36,590 --> 00:08:38,290
لا... لا أستطيع

114
00:08:39,080 --> 00:08:40,030
لماذا؟

115
00:08:40,310 --> 00:08:45,620
في الواقع، إنّ... من يُهاجم الآن هو
إحدى عقولي المُتوازية

116
00:08:45,620 --> 00:08:48,120
جزء منفصل عنّي

117
00:08:48,120 --> 00:08:52,270
ولا أستطيع الاتّصال بها... أو استعادتها

118
00:08:52,270 --> 00:08:53,040
...لذا

119
00:08:54,310 --> 00:08:55,370
هكذا إذاً

120
00:08:56,120 --> 00:08:59,490
طلبتُ طلباً مستحيلاً دون إدراك وضعك

121
00:08:59,490 --> 00:09:00,360
أعتذر

122
00:09:00,360 --> 00:09:01,550
!لا، لا، لا، لا مشكلة

123
00:09:02,250 --> 00:09:04,050
!بالإضافة إلى أنّ هذه أنباء ممتازة

124
00:09:04,050 --> 00:09:09,830
إذا استطعتُ البقاء طليقة، فقد يتمكّن عقل الجسد
السّابق من إسقاط سيّدة الشّيطان

125
00:09:09,830 --> 00:09:11,810
أودّ أن أطلب طلباً آخر

126
00:09:12,820 --> 00:09:15,710
أرجو التوقّف عن التّفاعل مع البشر

127
00:09:16,050 --> 00:09:18,630
هل لديك رغبة في العيش في مكان
آخر هادئ سرّاً؟

128
00:09:19,730 --> 00:09:23,500
...أشعر بالذنبِ لتورّطك في شؤون هذا العالم

129
00:09:23,500 --> 00:09:26,290
لكن أصبحتْ قوّتكِ هائلة

130
00:09:26,290 --> 00:09:30,590
!المُغازلة لن توصلك لأي نتيجة

131
00:09:30,820 --> 00:09:34,590
تُسبّب تصرّفاتك تموُّجات تجعل من الصّعب تجاهلك

132
00:09:36,100 --> 00:09:39,020
قد يقود مثل هذا الأمر العالم نحو فوضى

133
00:09:39,020 --> 00:09:42,300
،أعلم أنّه من الوقاحة طلب كلّ هذه الطلبات

134
00:09:42,300 --> 00:09:44,710
لكن هلّا أعدت النّظر في الأمر من فضلك؟

135
00:09:45,010 --> 00:09:49,600
ينبغي أن أعطي إجابة جادّة إذا كان
جادّاً حيال السّؤال

136
00:09:51,150 --> 00:09:53,230
طلبك... مرفوض

137
00:09:56,830 --> 00:10:01,370
بفضل مهارة مُحرّم، اكتشفتُ حقيقة آليّة
عمل نِظام هذا العالم

138
00:10:02,860 --> 00:10:06,870
وإن لم أفعل شيئاً، سيُدمّر هذا
العالم الّذي أعيش فيه

139
00:10:08,330 --> 00:10:10,480
مُحال أن أقف مكتوفة الأيدي وأسمح بذلك

140
00:10:11,290 --> 00:10:14,620
سأفعل ما يُمكنني فعله

141
00:10:18,040 --> 00:10:19,340
هل أنتِ مُصرّة على ذلك؟

142
00:10:21,260 --> 00:10:22,440
هكذا إذاً

143
00:10:23,610 --> 00:10:27,350
كزائر من عالم آخر، هل ما أحاول فعله يبدو غبيّاً؟

144
00:10:28,090 --> 00:10:32,810
لا أستطيع الإجابة عن ذلك حقّاً... لا أعرف وضعه بالتّحديد

145
00:10:32,810 --> 00:10:33,600
...لكن

146
00:10:36,240 --> 00:10:39,100
ينبغي أن تفعل ما تراه مناسباً

147
00:10:40,000 --> 00:10:42,360
هكذا إذاً... أظنّك على حقّ

148
00:10:43,160 --> 00:10:46,630
كلّ ما يمكنني فعله هو ما أراه ضروريّاً فعلاً

149
00:10:47,940 --> 00:10:50,870
يكفي لليوم. وداعاً

150
00:10:53,760 --> 00:10:57,390
لم أتّخذ موقفاً جدّياً منذ مدّة طويلة، أرهقني ذلك

151
00:10:57,730 --> 00:11:00,450
أعتقِد عمل المُدراء ليس سهلاً

152
00:11:02,640 --> 00:11:03,560
حان وقتُ النّوم

153
00:11:07,650 --> 00:11:08,820
هجوم؟

154
00:11:11,630 --> 00:11:12,880
!مُزعِج للغاية

155
00:11:19,750 --> 00:11:23,220
أحبّ نقاط خبرة البشر الدّسِمة

156
00:11:23,220 --> 00:11:23,910
لحظة

157
00:11:24,530 --> 00:11:25,920
...ألم يكن هذا الرّجل

158
00:11:26,160 --> 00:11:28,400
أحد رِجال البدين؟

159
00:11:29,820 --> 00:11:31,250
!اكتفيت

160
00:11:31,250 --> 00:11:35,140
أتعتقد أنّك يمكنك مُحاولة تهديد حياتي
والفشل فشلاً ذريعاً) ثمّ تفلت بفعلتك؟)

161
00:11:35,140 --> 00:11:36,290
!استعدّ للموت

162
00:11:39,320 --> 00:11:41,350
...تلك الحشرة اللّعينة

163
00:11:41,350 --> 00:11:44,610
—سأستفزّها إلى أن

164
00:11:52,180 --> 00:11:58,010
والآن بعد أن أزحتُ القمامة، يمكنني
التمتّع براحة هانئة

165
00:11:58,010 --> 00:12:00,120
!طابت ليلتكم

166
00:12:08,900 --> 00:12:10,760
هذا سيّئ

167
00:12:11,140 --> 00:12:12,460
أتّفق

168
00:12:12,900 --> 00:12:15,570
موت مُفاجئ بلا آثار لجروح خارجيّة

169
00:12:16,020 --> 00:12:17,240
...أعتقد يمكننا أن نفترض

170
00:12:17,240 --> 00:12:17,960
أجل

171
00:12:18,490 --> 00:12:20,950
كابوس المتاهة هو من فعل هذا

172
00:12:22,320 --> 00:12:25,970
عُثِر على جثث بنفس الحالة في
القصر قبل مدّة

173
00:12:26,340 --> 00:12:28,650
طريقة موتهم كانت غير عاديّة إطلاقاً

174
00:12:28,650 --> 00:12:30,720
لم يكن ذلك من صنيع البشر حتماً

175
00:12:36,350 --> 00:12:41,410
لكن ما زلنا لا نعلم لماذا يقِف في صفّ
بلدتنا أو دولة سارييلّا

176
00:12:42,190 --> 00:12:45,730
هل هو الوحش الإلهيّ الأسطوريّ حقّاً؟

177
00:12:45,920 --> 00:12:49,750
سيكون ذلك عذراً ممتازاً للتوقّف عن التفكيرِ في الأمر

178
00:12:50,360 --> 00:12:51,740
لكن مُحال أن يكون الأمر بتلك البساطة

179
00:12:53,450 --> 00:12:55,740
هذا يضعنا في موقف حرِج

180
00:12:56,190 --> 00:12:59,250
تُوفّي مسؤول من أوتس في بلدنا

181
00:12:59,730 --> 00:13:02,030
لن يدعوا هذا الأمر يمرّ مرور الكرام دون عواقِب

182
00:13:02,510 --> 00:13:08,770
إذا نظرنا للأمر من منظورٍ إيجابي، ستُدرك أوتس
أنّ هذا ما يحدث عند العبث مع وحش خطير

183
00:13:09,830 --> 00:13:11,820
ألم يردّوا بعد؟

184
00:13:11,820 --> 00:13:13,370
ليس بعد، لا

185
00:13:14,060 --> 00:13:18,880
أُرسِلت الرّسالة قبل أيّام. عدم الردّ نذير سيّئ

186
00:13:19,400 --> 00:13:25,080
بالنظرِ إلى طريقة تصرّفه، كان ينبغي أن يعلموا
أنّه سيقوم بعمل طائش

187
00:13:25,830 --> 00:13:27,470
هل من مُشكلة يا سيّدي؟

188
00:13:28,660 --> 00:13:32,040
لم يتصرّف كديبلوماسيّ لائق من الأساس، صحيح؟

189
00:13:32,660 --> 00:13:35,210
لا، معك حقّ

190
00:13:35,510 --> 00:13:39,350
أكره التّفكير بهذا، لكن... ربّما يريدون حقّاً إشعال حرب

191
00:13:39,790 --> 00:13:43,170
لهذا أرسلوه ليُسبّب مشكلة، والّتي
ستؤدّي بدورها لمنحِهم مُبرِّراً

192
00:13:44,690 --> 00:13:50,080
هذا مستحيل! أوتس في موقف ضعيف
!جدّاً أمام بلدنا

193
00:13:50,080 --> 00:13:52,480
لن يملكوا فرصة

194
00:13:52,480 --> 00:13:57,010
صحيح. تحت الظّروف العاديّة، ما كانوا
ليتهوّروا بهذا الشّكل أبداً

195
00:13:57,010 --> 00:13:57,990
...ومع ذلك

196
00:13:57,990 --> 00:14:02,550
!نبأ عاجل! أعلنَتْ مملكةُ أوتس حرباً على بلدنا

197
00:14:10,120 --> 00:14:12,690
ليس ذلك فحسب، بل لديهم دعم شامل

198
00:14:12,690 --> 00:14:16,090
!من إمبراطوريّة رينكساندت ومملكة ألّيوس المُقدّسة

199
00:14:16,370 --> 00:14:17,590
!هذا جنون

200
00:14:17,590 --> 00:14:20,330
!قـ-قوّة تحالُف؟

201
00:14:23,830 --> 00:14:28,340
على الأرجح أعرف الإجابة عن هذا، لكن
هل اندلعت حربٌ لأنّني قتلتُ البدين؟

202
00:14:28,340 --> 00:14:31,050
من الأفضل أن أتفقّد حال الحاكم المحلّي

203
00:14:31,840 --> 00:14:35,350
!يا إلهي، يقوم بحركة إمساك الرأس تلك

204
00:14:35,350 --> 00:14:37,890
ويحي، ارتكبتُ خطأ فادحاً

205
00:14:37,890 --> 00:14:40,290
!لكن لستُ نادمة

206
00:14:40,290 --> 00:14:43,630
!عندما تتلقّى ضربة، تردّ بالمثل! هذه فلسفتي

207
00:14:44,060 --> 00:14:45,100
...بالتالي

208
00:14:46,650 --> 00:14:50,860
بحسبِ ما يبدو، أتساءل إن كانت هذه البلد ستخسر

209
00:14:53,050 --> 00:14:54,020
!حسناً

210
00:14:54,020 --> 00:14:57,430
هناك مصّاصة الدِّماء الرّضيعة التي تستدعي
القلق عليها، وأنا مسؤولة عمّا يجري

211
00:14:57,430 --> 00:14:59,360
!لِذا سأعين هؤلاء

212
00:15:01,090 --> 00:15:07,130
فضلاً عن أنَّ الحرب تمثّل مطعماً يقدّم مائدة
مفتوحة من البشر اللّذيذين الغنيّين بنقاط الخبرة

213
00:15:07,550 --> 00:15:11,340
!لكن مُحال أن يكون هذا دافِعي الرّئيسي! بالطبع لا

214
00:15:11,340 --> 00:15:15,010
!والآن لنُشعِل جحيماً

215
00:16:04,810 --> 00:16:06,670
سوف أسحقكم جميعاً

216
00:16:07,050 --> 00:16:09,480
لن يطول ذلك الآن يا شون

217
00:16:14,700 --> 00:16:17,580
يوليوس-نيساما... راقبني من فضلك

218
00:16:20,680 --> 00:16:23,540
!تعال يا هيوغو

219
00:16:37,890 --> 00:16:42,160
في النّهاية، يبدو أنّني أعرِّض تلاميذي
للخطر في نهاية المطاف

220
00:16:48,350 --> 00:16:51,710
وجدتُ نفسي مولودة من جديد فجأة
في عالمٍ آخر

221
00:16:58,380 --> 00:17:03,990
الصّدمة التّالية كانَتْ كيف أنَّ الجميع حولي
لديهم آذان مُدبّبة طويلة

222
00:17:05,360 --> 00:17:10,020
ذخيرتي من المعلومات ساعدتني في معرفة
أنّهم من الإيلف من أوّل نظرة

223
00:17:11,050 --> 00:17:14,000
وساعدني ذلك في إدراك ما كان قد حدث

224
00:17:16,790 --> 00:17:19,510
قبل التقمُّص، كنتُ مُدرِّسة

225
00:17:20,340 --> 00:17:25,010
كان حلمي أن أكون المُعلّمة الّتي تحظى
بوقت مُمتع مع تلاميذها

226
00:17:25,620 --> 00:17:30,520
كنتُ أحبّ دراسة المجالات التي يهتمّ
،بها الأطفال، مثل ألعاب الفيديو

227
00:17:30,520 --> 00:17:33,280
والمانغا والرّوايات الخفيفة وأي مصدر
آخر أستطيع إيجاده

228
00:17:34,290 --> 00:17:36,880
وكنتُ حتّى أغيّر طريقة كلامي عندما
يكون تفاعلهم جيّداً

229
00:17:38,880 --> 00:17:43,480
وأشعر أنّني كنتُ مُعلّمة محبوبة بفضلِ جهودي

230
00:17:45,880 --> 00:17:51,540
لا أعلم ما إن كان حلمي حقّاً هو الابتسام
خلف شخصيّة مُلفَّقة

231
00:17:52,720 --> 00:17:55,170
وقد انتابتني شكوك

232
00:17:56,370 --> 00:18:00,810
بالرغم من ذلك، شعرتُ بالرّضا بحياتي كمُعلّمة

233
00:18:05,940 --> 00:18:07,080
...لكن بعدها

234
00:18:17,630 --> 00:18:19,770
لستُ شخصاً قويّاً

235
00:18:20,280 --> 00:18:22,420
،لم أتمكّن من قبول ما حدث

236
00:18:22,420 --> 00:18:26,130
وشرعتُ في عيش حياةٍ ثانية، بالطريقة التي
تعيش فيها الشخصيّات في الرّوايات الخفيفة

237
00:18:27,820 --> 00:18:32,700
عجزي عن نسيانِ حياتي الماضية، الّتي انتهى
...المطاف بتعلُّقي بها وسطَ حيرتي

238
00:18:33,090 --> 00:18:34,960
كانتْ هويّتي كمُعلّمة

239
00:18:36,160 --> 00:18:37,830
أنا مُعلِّمة

240
00:18:38,780 --> 00:18:42,960
إذاً في تِلك الحالة، عليّ أن أعطي
الأولويّة لسلامةِ تلاميذي

241
00:18:44,870 --> 00:18:49,770
لحسن الحظّ، وجدتُ نفسي مولودة بمهارة
كانت داعِمة جدّاً لهذا الاعتقاد

242
00:18:51,780 --> 00:18:54,490
مهارتي الفريدة. قائمة التّلاميذ

243
00:18:55,950 --> 00:19:00,330
شملَتْ لائحة بأسماء تلاميذي الّذين
،قد خُلِقوا من جديد

244
00:19:00,330 --> 00:19:03,620
مع وصف واسع لماضيهم وحاضرهم ومُستقبلهم

245
00:19:04,210 --> 00:19:06,090
،تحت بند المستقبل

246
00:19:12,670 --> 00:19:14,370
جعلني ذلك أفقد الأمل

247
00:19:16,110 --> 00:19:20,890
مذكور أنّ كافّة تلاميذي تقريباً يموتون
في غضون 20 سنة

248
00:19:31,740 --> 00:19:36,390
...حصلت على مهارة "تخاطُر". نقاط المهارة المتبقّية

249
00:19:37,800 --> 00:19:39,790
!أرجوكم، النّجدة

250
00:19:48,270 --> 00:19:50,410
!عليك إنقاذ تلاميذي

251
00:19:52,440 --> 00:19:55,160
أخبرتُ بوتيماس بكلّ شيء

252
00:19:55,810 --> 00:20:00,160
عن ذكريات حياتي الماضية. عن مهارة
قائمة التّلاميذ

253
00:20:01,570 --> 00:20:04,150
حسناً. سوف أحميهم

254
00:20:05,630 --> 00:20:10,690
كانت مُجازفة خطيرة، لكن لم يكن هُناك
شخص آخر ألجأ إليه آنذاك

255
00:20:11,880 --> 00:20:13,680
بالمال تارة

256
00:20:14,360 --> 00:20:16,180
وبالخطف تارة أخرى

257
00:20:22,310 --> 00:20:26,620
لكن لدى مهارتي قيدان اثنان

258
00:20:27,340 --> 00:20:29,930
...لا أستطيع رؤية معلومات حول نفسي

259
00:20:29,930 --> 00:20:34,960
ولا أستطيع مُشاركة المعلومات الّتي أحصل
عليها من قائمة التّلاميذ مع أي تلميذ

260
00:20:35,770 --> 00:20:41,220
بدؤوا يكرهونني لأنّهم أُجبِروا على
العيش داخل القرية

261
00:20:41,880 --> 00:20:45,480
لكن ارتأيتُ أنّ ذلك أفضل من موتهم

262
00:20:46,780 --> 00:20:49,070
لأنّني مُعلّمة

263
00:20:49,630 --> 00:20:53,980
فعلتُ المستحيلَ لأجلِ تلاميذي... هذا
ما آمنتُ به طوال هذا الوقت

264
00:20:56,450 --> 00:20:59,870
فلماذا آلت الأمور إلى هذا إذاً؟

265
00:21:01,670 --> 00:21:03,570
هل كنتُ على صواب؟

266
00:21:05,370 --> 00:21:07,340
هل يُعقل أنّني كنتُ مُخطِئة من البداية؟

267
00:21:09,070 --> 00:21:15,380
هل كنتُ مُعلّمة جيّدة أساساً؟

268
00:22:54,480 --> 00:22:56,350
حاولوا أن تكونوا نافعين، حسناً؟

269
00:22:58,070 --> 00:23:01,860
عُلِم يا سيّدتي، كلّ شيء جاهز

270
00:23:03,180 --> 00:23:06,890
يبدو أنّ كلّ شيء يسير وفق الخطّة

271
00:23:08,570 --> 00:23:11,730
أشعلي جحيماً قدر ما تشائين، مفهوم؟

272
00:23:11,730 --> 00:23:13,370
هذا ينطبِق على الجميع

273
00:23:30,850 --> 00:23:33,510
!والآن، فلنبدأ