1
00:00:15,670 --> 00:00:18,520
!عادة ما أكون مُرهقة للغاية بعد التطوّر

2
00:00:18,520 --> 00:00:21,510
هل الفضل يعزو لمهارة إبطال الإعياء هذه؟

3
00:00:21,840 --> 00:00:23,630
هذا مفيد حقّاً

4
00:00:28,570 --> 00:00:30,860
اكتسبت نقاط مهارة

5
00:00:30,860 --> 00:00:31,880
!مهلاً

6
00:00:31,880 --> 00:00:34,990
!ألم تذكري شيئاً مذهلاً للتو؟

7
00:00:34,990 --> 00:00:35,890
ذكّريني ماذا كان ذلك؟

8
00:00:38,220 --> 00:00:39,130
!قبلها

9
00:00:43,500 --> 00:00:45,650
...خلود

10
00:00:46,050 --> 00:00:47,140
!خلود؟

11
00:00:48,320 --> 00:00:49,760
!هل هذا مسموح؟

12
00:00:50,150 --> 00:00:56,900
إنها مهارة الغشّ المُطلقة التي كان يسعى
!لها النّاس عبر التّاريخ

13
00:00:58,030 --> 00:00:59,640
!انتهت اللّعبة، ربِحت

14
00:00:59,640 --> 00:01:01,400
...يمكنكم فعل هذا بي، أو هذا

15
00:01:01,400 --> 00:01:03,050
!وحتّى قليل من هذا

16
00:01:06,890 --> 00:01:08,680
!لكن لن أموت! ليس أنا

17
00:01:08,960 --> 00:01:10,180
!لن أموت أبداً

18
00:01:11,440 --> 00:01:14,200
!يمكنني حتّى هزيمة أمّي الآن

19
00:01:14,790 --> 00:01:15,560
لحظة

20
00:01:15,990 --> 00:01:18,100
ماذا؟ ماذا؟ ما هذا الشيء؟

21
00:01:18,100 --> 00:01:21,230
ارتعدتُ كثيراً بشأن "خلود" لدرجة
!أنّني أغفلتُ هذا اللّقب

22
00:01:21,230 --> 00:01:23,200
!مكتوب "فائز"! هذا عكس ما أشعر به عادة

23
00:01:23,200 --> 00:01:24,550
!حيث كنتُ أشعر أنّني شخص فاشل

24
00:01:24,740 --> 00:01:26,570
!وعلاوة على ذلك، هناك خوف

25
00:01:26,570 --> 00:01:30,650
يبدو أنّ هذه العنكبوت الصّغيرة مُثيرة جدّاً... مُخيفة

26
00:01:30,650 --> 00:01:32,930
!لدرجة أنّ أي شخص يراها سوف يُقصى

27
00:01:32,930 --> 00:01:34,580
!أخيراً تمّ الاعتراف بي كفائزة

28
00:01:36,410 --> 00:01:37,400
لكن بواسطة مَن؟

29
00:01:37,400 --> 00:01:39,820
بواسطة المُدير بالطبع

30
00:01:41,470 --> 00:01:43,210
...هذا الصّوت

31
00:01:44,130 --> 00:01:47,070
مرحباً! أنا د من جديد

32
00:03:19,350 --> 00:03:22,440
مرحباً؟ يمكنك سماعي، صحيح؟

33
00:03:22,720 --> 00:03:24,110
هذه أنا، د

34
00:03:25,880 --> 00:03:28,830
!لا أسمع شيئاً! لا أسمع شيئاً البتّة

35
00:03:28,830 --> 00:03:30,520
هلّا نظرتِ إلى هذا؟

36
00:03:30,520 --> 00:03:33,180
بمتناول يدي زرّ تدمير عنكبوت

37
00:03:33,680 --> 00:03:37,330
!مرحباً؟ آسفة بشأن ذلك! سامحيني
!لا تضغطي ذلك الشيء

38
00:03:37,330 --> 00:03:38,750
!لماذا تمتلكين زرّاً كهذا أصلاً؟

39
00:03:38,750 --> 00:03:40,320
كنتُ أمزح فحسب

40
00:03:40,320 --> 00:03:45,610
بالإضافة إلى ذلك، لستُ بحاجة إلى زرّ
يحوّلكِ إلى مُفرقعات ليّنة

41
00:03:48,210 --> 00:03:49,590
لكن لا تقلقي

42
00:03:49,590 --> 00:03:54,350
لا أتحمّل رؤية مثل هذه الشخصيّة المُسلّية
تُقتَل قبل أوانها

43
00:03:54,350 --> 00:03:56,820
!حقّاً؟! شكراً

44
00:03:59,400 --> 00:04:00,970
!حسناً، انتهت المُحادثة

45
00:04:01,370 --> 00:04:02,410
...تدمير العنكبوت

46
00:04:02,410 --> 00:04:03,090
!آسفة

47
00:04:03,580 --> 00:04:06,080
أنا أستفزّكِ فحسب بالطبع

48
00:04:06,080 --> 00:04:07,590
ماذا تريدين حتّى؟

49
00:04:07,980 --> 00:04:11,360
ارتأيتُ أن أهنّئكِ على خلودكِ الذي اكتسبتِه حديثاً

50
00:04:13,020 --> 00:04:17,170
تُميَّز عناكب زانا هورووا بواسطة خلودها

51
00:04:17,170 --> 00:04:22,760
مع أنّني متفاجئة من أنّ تلك تمكّنت
فعلاً من التطوّر

52
00:04:22,760 --> 00:04:28,470
!تهانينا! أنتِ وحش فريد من نوعه الآن

53
00:04:28,470 --> 00:04:30,050
!تستحقّين التصفيق

54
00:04:30,440 --> 00:04:33,070
ماذا تريدين بالضبط؟

55
00:04:33,070 --> 00:04:36,070
كما ذكرت، أريد التّرفيه

56
00:04:36,070 --> 00:04:38,610
،لكن أنا بمزاج جيّد اليوم

57
00:04:38,610 --> 00:04:41,960
لذا ارتأيتُ أن أصنع لكِ معروفاً وأطلعكِ
على بضعة أشياء

58
00:04:42,970 --> 00:04:44,980
!حقّاً؟

59
00:04:44,980 --> 00:04:48,140
إذاً لماذا خُلِقتُ من جديد في هذا
العالم من الأساس؟

60
00:04:48,420 --> 00:04:50,180
!اسمحي لي أن أشرح

61
00:04:50,180 --> 00:04:52,860
متِّ في اليابان، في الأرض

62
00:04:52,860 --> 00:04:54,970
متُّ حقّاً إذاً

63
00:04:55,770 --> 00:04:57,470
كيف حدث ذلك؟

64
00:04:57,470 --> 00:05:01,730
للأمر علاقة بشيء فعله البطل السّابق وسيّد الشيطان

65
00:05:02,830 --> 00:05:06,870
كلاهما سيّدا سحر بُعديّ عظيمان

66
00:05:06,870 --> 00:05:10,780
وأنشآ سحراً يسمح لهما بالهرب
من حدود هذا العالم

67
00:05:11,350 --> 00:05:13,780
ما هذا بالضبط؟ يبدو مذهلاً

68
00:05:13,780 --> 00:05:15,020
جدّاً

69
00:05:15,020 --> 00:05:20,470
المشكلة هي أنّ دعم النّظام لا يمتدّ
إلى خارج النّظام

70
00:05:20,470 --> 00:05:24,270
ومن دون ذلك الدّعم، لم يتمكّنا من التحكّم
بعمليّة النسخ المُعقّدة

71
00:05:24,270 --> 00:05:26,860
التي سمحت لهما بتجاوز هذا العالم

72
00:05:26,860 --> 00:05:29,180
،بسبب ذلك، خرجت التّعويذة عن السّيطرة

73
00:05:32,380 --> 00:05:34,840
نتيجة ذلك، في النقطة خارج عالمهم التي تمكّنا
،من الوصول إليها، أي اليابان

74
00:05:34,840 --> 00:05:36,670
على الأرض، وقع انفجار

75
00:05:39,680 --> 00:05:41,610
...وذلك المكان هو

76
00:05:41,610 --> 00:05:44,810
تماماً! إنّه صفّ المدرسة الذي كنتِ فيه

77
00:05:44,810 --> 00:05:46,700
!يبدوان مزعجين للغاية

78
00:05:46,870 --> 00:05:48,610
جدّاً

79
00:05:48,610 --> 00:05:51,260
البطل وسيّد الشيطان فقدا صوابهما

80
00:05:51,260 --> 00:05:54,370
وانتهى الحال بي بفحص النّظام الذي
،كان يعمل على ما يُرام

81
00:05:54,370 --> 00:05:56,710
من دون أي مساعدة، باعتباري جعلته يعمل تلقائيّاً

82
00:05:56,710 --> 00:05:57,950
!تدعينه يعمل من تلقاء نفسه؟

83
00:05:57,950 --> 00:05:59,610
!هذه حركة مُطوّرين كسولين قديمة

84
00:05:59,610 --> 00:06:03,430
المُدراء المُنتظمون هم من يُفترض بهم
أن يهتمّوا بهذا العالم

85
00:06:03,430 --> 00:06:06,720
أنا مجرّد شخص من الخارج اقترحَ النّظام

86
00:06:07,180 --> 00:06:10,970
تبدين شخصيّة إداريّة بالرّغم من كلّ ذلك

87
00:06:10,970 --> 00:06:14,900
مهلاً، قُتِل مجموعة من طلّاب الثانويّة الأبرياء

88
00:06:14,900 --> 00:06:18,940
بسبب النّظام الذي أنشأتُه

89
00:06:18,940 --> 00:06:20,730
طلّاب ثانويّة؟ أكثر من طالب؟

90
00:06:21,040 --> 00:06:22,090
أجل

91
00:06:22,090 --> 00:06:25,970
سقطَ أكثر من 25 شخصاً في الانفجار
الذي أصاب الصفّ

92
00:06:26,650 --> 00:06:30,520
،جمعتُ أرواحهم وحافظتُ على سلامة ذاكرتهم

93
00:06:30,520 --> 00:06:34,230
وزوّدتهم بمهارات تجعلهم ينجون في ذلك العالم

94
00:06:34,630 --> 00:06:38,810
وبعد ذلك، زوّدتُ كلّ واحد منهم بمهارة خاصّة
،بالاعتماد على التوافقيّة

95
00:06:38,810 --> 00:06:41,380
مع الحرص على أن يصبح كلّ شخص

96
00:06:41,380 --> 00:06:43,990
من الجِنس الأنسب لتردُّد روحه

97
00:06:44,670 --> 00:06:46,510
تـ-تعلمين أنّني عنكبوت، صحيح؟

98
00:06:46,950 --> 00:06:49,770
!حسناً، لا بدّ أنّ هذا يلائمكِ إذاً

99
00:06:50,020 --> 00:06:52,940
الآخرون كلّهم تقريباً خُلِقوا من جديد كبشر

100
00:06:52,940 --> 00:06:54,900
!لا! لماذا أنا؟

101
00:06:54,900 --> 00:06:57,280
!أريد أن أكون بشريّة أيضاً

102
00:06:57,510 --> 00:07:02,070
رغم ذلك، بالنظر إلى البداية المُبكّرة التي حظيتِ
بها، سوف تتطوّرين وتفهمين الأمور

103
00:07:02,070 --> 00:07:04,500
أسرع من أي شخص آخر

104
00:07:04,500 --> 00:07:05,770
أفهم؟

105
00:07:09,250 --> 00:07:11,980
الآخرون ما زالوا أطفالاً رُضَّع

106
00:07:11,980 --> 00:07:14,340
هذا ما تقصدينه بالبداية المُبكّرة

107
00:07:14,340 --> 00:07:17,800
حتّى ولادتكِ كانت أسرع ممّا كانت
بالنسبة لبشريّ

108
00:07:19,430 --> 00:07:24,470
لهذا كنتُ أنمو بصورة سريعة جدّاً بينما
الآخرون ما زالوا يمصّون إبهامهم؟

109
00:07:25,570 --> 00:07:28,670
لحظة، قلتِ أنّ كان هناك 25 شخصاً
خُلِقوا من جديد، صحيح؟

110
00:07:29,000 --> 00:07:30,990
أجل، هذا صحيح

111
00:07:30,990 --> 00:07:33,840
ألن يكونوا 26 بمن فيهم المُعلّمة؟

112
00:07:33,840 --> 00:07:37,640
هذا لأنّني لم أُخلَق من جديد بحدِّ ذاتي

113
00:07:37,640 --> 00:07:41,550
لحظة، كنتِ في الصفّ؟! من كنتِ؟! ما اسمك؟

114
00:07:41,550 --> 00:07:43,480
!هذا سرّ

115
00:07:44,820 --> 00:07:46,210
،بغضّ النظر عن اسمي

116
00:07:46,210 --> 00:07:52,830
وجودي هو ما جعل سحر البطل وسيّد
الشّيطان يؤثّر على الصفّ

117
00:07:52,830 --> 00:07:56,190
كنتِ مسؤولة جزئيّاً إذاً

118
00:07:56,190 --> 00:08:00,090
على الأرجح كانوا يحاولون قتلي

119
00:08:00,090 --> 00:08:00,840
لماذا؟

120
00:08:01,340 --> 00:08:05,080
يبدو أنّ هناك جماعة تعتبر المُدراء عدوّهم

121
00:08:05,580 --> 00:08:10,140
نظريّتي هي أنّ سيّد الشيطان والبطل السّابقين
قد حُرِّضا بواسطة تلك المجموعة

122
00:08:10,540 --> 00:08:12,750
حسناً، كانت حركة غبيّة

123
00:08:12,750 --> 00:08:17,820
حسناً، الآن بعد أن خُلِقتِ من جديد، أنتِ
حرّة تماماً في فعل ما تُريدين فعله

124
00:08:17,820 --> 00:08:21,240
!وآمل أن يبقى هذا مُسلّياً

125
00:08:21,240 --> 00:08:22,900
كفّي عن المُراقبة بربّك

126
00:08:22,900 --> 00:08:26,470
عسى أن تحقّقي نصراً عليها

127
00:08:26,470 --> 00:08:31,730
!حبّذا أن تتمكّني من النجاة لتسلّيني ليوم آخر

128
00:08:33,370 --> 00:08:35,920
هذا يترك أمامي مزيداً من الأسئلة

129
00:08:42,770 --> 00:08:46,390
تأسّست هذه القرية بواسطة أشخاص
يقدّمون المأوى والطعام

130
00:08:46,660 --> 00:08:50,370
للأشخاص الذين ينوون مواجهة متاهة إيلروي العظيمة

131
00:08:50,660 --> 00:08:54,190
إلى متى عليّ البقاء مختبئة؟

132
00:08:54,760 --> 00:08:58,380
اصبري قليلاً فقط. أنتِ تلفتين كثيراً من الأنظار

133
00:08:58,380 --> 00:09:00,780
—في الواقع، بشأن ذلك، أعتقد

134
00:09:00,780 --> 00:09:01,620
ها نحن ذا

135
00:09:05,320 --> 00:09:07,710
آسف. سنكمل الكلام لاحقاً

136
00:09:14,090 --> 00:09:17,010
تسرّني رؤيتك من جديد يا غويف-دونو

137
00:09:18,990 --> 00:09:20,400
...هايرينس-ساما

138
00:09:21,000 --> 00:09:24,190
هذا غويف-دونو، دليل متاهة

139
00:09:24,190 --> 00:09:26,750
ساعدَ يوليوس عدّة مرّات

140
00:09:27,150 --> 00:09:28,490
كان يعرف ني-ساما

141
00:09:28,490 --> 00:09:30,420
هذا الأخ الأصغر ليوليوس، شلاين

142
00:09:31,040 --> 00:09:33,540
إنّه البطل الحقيقيّ الذي يحذو حذوّ يوليوس

143
00:09:34,640 --> 00:09:35,550
اسمي شلاين

144
00:09:39,230 --> 00:09:40,790
ينبغي أن تدخلوا جميعاً حاليّاً

145
00:09:44,470 --> 00:09:49,190
عبور متاهة إيلروي العظيمة للوصول
إلى قارّة كاساناغاران؟

146
00:09:49,190 --> 00:09:50,070
أجل

147
00:09:50,490 --> 00:09:55,570
المدخل إلى المتاهة محروس بالفعل
بواسطة جنود الإمبراطوريّة

148
00:09:55,800 --> 00:10:00,350
كما تعلم، نحن حاليّاً هاربون من الإمبراطوريّة

149
00:10:00,350 --> 00:10:03,860
لكن بسبب جريمة لم نرتكبها

150
00:10:03,860 --> 00:10:06,700
لم نشارك في مؤامرة لإسقاطِ المملكة

151
00:10:07,680 --> 00:10:11,590
هل ترغب في مساعدتنا لدخول المتاهة العظيمة؟

152
00:10:11,590 --> 00:10:12,740
!أرجوك

153
00:10:15,200 --> 00:10:17,710
أنا آسف، لكن لا أستطيع مُساعدتكم

154
00:10:18,700 --> 00:10:20,050
...غويف-دونو

155
00:10:20,050 --> 00:10:24,590
أعلم أنّكم بريئون جميعاً

156
00:10:24,990 --> 00:10:25,730
—لماذا إذاً

157
00:10:25,930 --> 00:10:29,330
،إذا ساعدتُكم وجذبتُ أنظار الإمبراطوريّة

158
00:10:29,640 --> 00:10:32,230
سأعرّض عائلتي للخطر

159
00:10:33,080 --> 00:10:34,470
أنا آسف

160
00:10:38,990 --> 00:10:41,820
،إذا كان هذا الجبان لا يريد مُساعدتكم

161
00:10:44,090 --> 00:10:46,250
أنا سأفعل

162
00:10:46,690 --> 00:10:47,500
...أبي

163
00:10:48,020 --> 00:10:51,060
اسمي باسغاث، والضعيف هنا هو ابني

164
00:10:52,870 --> 00:10:55,080
،إذا سبّب لك الإمبراطور أي مشكلة

165
00:10:55,080 --> 00:10:57,180
فأخبره أنّ عجوزاً طاعناً في السنّ هرب
قبل أن تتمكّن من إيقافه

166
00:10:57,180 --> 00:10:57,740
—لكن

167
00:10:59,120 --> 00:11:01,750
!أتريد أن تتذوّق لكمة باسغاث القويّة يا فتى؟

168
00:11:04,300 --> 00:11:07,790
إن كنتم لا تمانعون أن يدلّكم عجوزٌ فاشلٌ
مثلي على الطريق، فأنا جاهز

169
00:11:07,790 --> 00:11:08,770
ما رأيكم؟

170
00:11:13,110 --> 00:11:14,780
شكراً لك على مساعدتنا

171
00:11:17,120 --> 00:11:20,250
في، حالما نجهز، سننطلق

172
00:11:20,250 --> 00:11:23,290
قبل ذلك، هلّا وصلتني بسينسي؟

173
00:11:23,290 --> 00:11:25,590
سينسي؟ لماذا؟

174
00:11:25,590 --> 00:11:26,800
!افعل ذلك فحسب

175
00:11:29,760 --> 00:11:32,440
سينسي! تريد في أن تتكلّم معكِ

176
00:11:32,710 --> 00:11:35,320
معي أنا؟ ماذا تريد يا تُرى؟

177
00:11:35,800 --> 00:11:36,810
لا أدري

178
00:11:40,040 --> 00:11:43,290
هل من أحدٍ هنا زار المتاهة سابقاً؟

179
00:11:43,630 --> 00:11:45,620
...أنا و

180
00:11:45,620 --> 00:11:47,960
ذهبتُ مرّة

181
00:11:47,960 --> 00:11:49,560
تسرّني مساعدتكِ يا فتاة

182
00:11:50,940 --> 00:11:53,570
!سأغادر لرؤية في-تشان

183
00:11:54,910 --> 00:11:57,620
كاتيا-سان، هل يمكنكِ المجيء؟

184
00:11:57,620 --> 00:11:58,810
أنا؟

185
00:11:59,210 --> 00:12:00,680
سأذهب أيضاً

186
00:12:00,680 --> 00:12:02,460
!هذا مرفوض تماماً يا شون-كن

187
00:12:03,610 --> 00:12:05,280
ما الذي يجري؟

188
00:12:08,410 --> 00:12:10,850
ها نحن ذا. هذه هي

189
00:12:10,850 --> 00:12:13,740
...المشي يُرهقني

190
00:12:14,100 --> 00:12:16,200
!سيتفاجأ شون-كن

191
00:12:20,070 --> 00:12:21,790
عدنا

192
00:12:21,790 --> 00:12:23,130
تأخّرتُما

193
00:12:23,130 --> 00:12:25,220
شون-كن، هلّي بلحظة؟

194
00:12:29,980 --> 00:12:31,690
ما الأمر الآن؟

195
00:12:31,970 --> 00:12:33,490
هل حدث شيء مع في؟

196
00:12:33,490 --> 00:12:35,290
!شيء من هذا القبيل

197
00:12:45,620 --> 00:12:51,000
!مفاجأة! إنّه الشّكل البشريّ الأبرز العظيم لفي-تشان

198
00:12:52,250 --> 00:12:54,670
المعذرة... شينوهارا-سان؟

199
00:12:55,030 --> 00:12:56,910
التشابه كبير حقّاً

200
00:12:56,910 --> 00:12:58,650
مفاجأة، صحيح؟

201
00:12:59,340 --> 00:13:01,850
!كلّ الفضل يعزو لهذه المهارة الجديدة التي حصلتُ عليها

202
00:13:02,530 --> 00:13:03,640
!"التحوّل البشريّ"

203
00:13:04,090 --> 00:13:06,580
،كنّا نشتري ملابسَ لها في القرية

204
00:13:06,580 --> 00:13:09,390
واستغرقنا وقتاً لأنّنا لم نكن متأكّدات
،بشأن المقاسات

205
00:13:10,770 --> 00:13:14,010
لهذا لم تريديني أن آتي

206
00:13:14,300 --> 00:13:16,270
...معنى هذا أنّها تطوّرت إذاً

207
00:13:16,530 --> 00:13:19,770
أو بالأحرى، عندما كنتُن تتسوّقن لشراء
ملابس، كانت عارية؟

208
00:13:20,070 --> 00:13:21,520
!ما الذي تتخيّله بالضبط؟

209
00:13:21,980 --> 00:13:24,540
لم تكن نيّتي سيّئة إطلاقاً

210
00:13:26,430 --> 00:13:29,620
بالإضافة إلى ذلك، كيف لها أن تكون
مشكلة بالنسبة لي، لا لكِ؟

211
00:13:29,620 --> 00:13:31,500
لأنّها ليست مشكلة بالنسبة لي

212
00:13:31,500 --> 00:13:32,780
—لكن كنتِ

213
00:13:33,130 --> 00:13:34,380
لا مشكلة

214
00:13:34,860 --> 00:13:37,300
لا مشكلة إذاً. حسناً

215
00:13:39,520 --> 00:13:40,530
حسناً، تبدين رائعة

216
00:13:40,530 --> 00:13:41,780
!ألستُ كذلك؟

217
00:13:41,780 --> 00:13:44,300
!أنا مُشرِقة حرفيّاً

218
00:13:44,300 --> 00:13:46,260
أبدو كآنسة حسناء

219
00:13:46,260 --> 00:13:48,890
أعتقد مُقدّر لي أن أكون مُثيرة حتّى
!بعد خلقي من جديد

220
00:13:47,210 --> 00:13:51,370
بدت في-تشان تتصرّف على أنّها شينوهارا-سان
من جديد حالما تحوّلت إلى بشريّة

221
00:13:48,890 --> 00:13:51,370
!هكذا ينبغي أن يكون القدر

222
00:13:52,220 --> 00:13:56,260
هل أنتم منبهرون جميعاً؟ لأنّه
لا مشكلة إن كنتم كذلك

223
00:13:53,260 --> 00:13:56,560
لماذا برأيكما تشبه نفسها كثيراً قبل
أن تُخلَق من جديد؟

224
00:13:56,260 --> 00:13:58,950
!سأسمح بالأمر

225
00:13:57,660 --> 00:13:59,310
!سؤال وجيه

226
00:14:01,220 --> 00:14:02,420
شون؟

227
00:14:02,860 --> 00:14:08,570
كلّ ما في الأمر هو أنّ رؤية في هكذا
تذكّرني كيف كانت في السّابق

228
00:14:09,810 --> 00:14:15,840
هذا يوضّح كيف متنا جميعاً... ووُلِدنا من جديد

229
00:14:20,970 --> 00:14:23,690
أتساءل عن حال الآخرين

230
00:14:40,000 --> 00:14:44,290
تعلمين ما حلّ بالصفّ بأكمله، أليس كذلك يا سينسي؟

231
00:14:44,870 --> 00:14:45,720
أجل

232
00:14:46,070 --> 00:14:48,150
كيف حال الآخرين؟

233
00:14:48,750 --> 00:14:50,390
ومن هي تلك المرأة صوفيا؟

234
00:14:51,180 --> 00:14:53,800
هناك بعض الأشياء التي من الأفضل ألّا تعرفوها

235
00:14:55,060 --> 00:14:58,830
،حسناً، بما أنّ البطل مخلوق من جديد

236
00:14:58,830 --> 00:15:00,790
!فرُبّما سيّد الشيطان هو شخص من صفّنا أيضاً

237
00:15:01,280 --> 00:15:02,940
من يدري؟

238
00:15:13,260 --> 00:15:17,230
حسناً، حصلتم جميعاً على ملابس
السّباحة خاصتكم، صحيح؟

239
00:15:17,230 --> 00:15:20,170
بالتأكيد! حرصنا على أن تكون ظريفة

240
00:15:20,170 --> 00:15:22,570
عذراً، لماذا تفعلون هذا بالضبط؟

241
00:15:22,570 --> 00:15:25,190
هل أتباهى بمفاتني في الشاطئ الآن؟

242
00:15:22,910 --> 00:15:25,330
ألم نكن متوجّهين نحو متاهة إيلروي العظيمة؟

243
00:15:25,190 --> 00:15:26,900
...رغم ذلك، هذا الزيّ بسيط جدّاً

244
00:15:25,330 --> 00:15:26,900
سوف نعبر بحراً إذاً؟

245
00:15:26,900 --> 00:15:28,560
لحظة، نعبر؟

246
00:15:28,560 --> 00:15:33,580
ا-المعذرة، ربّما بمقدوري أن أحملكم جميعاً إلى هناك

247
00:15:33,580 --> 00:15:36,410
البحار هنا هي منطقة لتنّين الماء

248
00:15:36,410 --> 00:15:40,470
سيُغرِقون أي سفينة ويُسقِطون أي شيء يطير

249
00:15:41,200 --> 00:15:44,450
لكن... هناك مدخل نحو متاهة إيلروي العظيمة

250
00:15:44,450 --> 00:15:47,550
ليس بعيداً عن أسفل هذا المُنحدر

251
00:15:47,550 --> 00:15:50,840
إذاً لن نعبر البحر، بل سنسبح نحو مدخل تحت الأرض؟

252
00:15:51,230 --> 00:15:53,910
لا توجد طريقة أخرى لتجنُّب الإمبراطوريّين

253
00:15:54,940 --> 00:15:58,640
أظنّني أفضّل جنود الإمبراطوريّة على تنانين الماء

254
00:15:58,640 --> 00:16:02,070
نحن متيقّنون أنّه سيكون هناك جنوداً
مُتمركزين عند مدخل المتاهة

255
00:16:02,460 --> 00:16:06,350
لكن لا يوجد ما يؤكّد أنّنا سنواجه تنانينَ
مائيّة إذا سلكنا هذا الطريق

256
00:16:06,520 --> 00:16:08,760
ما يعني أنّها عمليّة مُجازفة

257
00:16:09,570 --> 00:16:11,600
!الجميع هنا يجيدون السّباحة، صحيح؟

258
00:16:14,870 --> 00:16:19,870
في الواقع... أنا... قد لا أستطيع السّباحة

259
00:16:22,030 --> 00:16:24,140
لا يمكننا ترك في خلفنا

260
00:16:24,340 --> 00:16:26,450
سأساعدها على ذلك

261
00:16:26,450 --> 00:16:28,830
في، اسبحي بكل ما أوتيتِ من قوّة

262
00:16:28,830 --> 00:16:30,260
نظرتكِ مُخيفة

263
00:16:30,490 --> 00:16:32,850
حسناً، لندع شون يتولّى أمر في

264
00:16:34,000 --> 00:16:37,530
!حسناً، كونوا مُتحمّسين يا جماعة! هيّا

265
00:16:38,660 --> 00:16:42,120
لا أعتقد أنّ الحماس سيشكّل فرقاً أمام تنانين الماء

266
00:16:43,600 --> 00:16:45,520
سوف نسبقكما

267
00:16:50,770 --> 00:16:52,870
حسناً، هيّا بنا يا في

268
00:16:52,870 --> 00:16:54,290
حـ-حسناً

269
00:16:54,980 --> 00:16:56,940
...واحد... اثنان

270
00:16:57,290 --> 00:16:58,030
!ثلاثة

271
00:17:23,460 --> 00:17:24,540
!تبّاً

272
00:17:54,960 --> 00:17:55,840
!شون

273
00:18:01,280 --> 00:18:02,240
!شون

274
00:18:01,510 --> 00:18:02,580
!شون-كن

275
00:18:40,530 --> 00:18:43,700
هلّا ابتعدت عنها؟

276
00:18:44,830 --> 00:18:46,190
آ-آ-آسف

277
00:18:47,060 --> 00:18:51,700
حسناً، لنعتبر الأمر متكافئاً، بما أنّنا نجونا معاً

278
00:18:52,260 --> 00:18:54,260
!هـ-هل الجميع بخير؟

279
00:18:54,610 --> 00:18:56,500
هذا واضح من دون سؤال

280
00:18:58,480 --> 00:19:03,000
،أهلاً بكم في أقرب نقطة من جحيم الحياة
!متاهة إيلروي العظيمة

281
00:19:14,060 --> 00:19:16,470
!الشاطئ

282
00:19:16,470 --> 00:19:18,770
!إنّه كإحدى مُنتجعات المُحيط في ميامي

283
00:19:19,630 --> 00:19:23,150
!وها أنا ذي بجسد جذّاب يتطلّب كلّ الاهتمام

284
00:19:24,600 --> 00:19:26,630
وهو يعوم

285
00:19:27,240 --> 00:19:33,010
في حياتي السّابقة، كنتُ لأستطيع السّباحة
بطريقة تجعل الحوريّات يشعرن بالغيرة

286
00:19:33,010 --> 00:19:37,020
في الواقع لا، كانت كذبة. كنتُ بليدة
جدّاً في حياتي السّابقة

287
00:19:37,440 --> 00:19:39,640
!اصمتي! لم تكن مهارة

288
00:19:41,230 --> 00:19:42,410
...لكن حقّاً

289
00:19:44,660 --> 00:19:49,170
إنّها إحدى زميلاتي في الصفّ؟ من تكون يا تُرى؟

290
00:19:49,170 --> 00:19:52,520
عسى أن تحقّقي نصراً عليها

291
00:19:52,850 --> 00:19:58,070
!حبّذا أن تتمكّني من النجاة لتسلّيني ليوم آخر

292
00:19:58,070 --> 00:20:00,950
،حسناً، بالنسبة لأمّي

293
00:20:00,950 --> 00:20:04,280
أفضل تصرّف هو على الأرجح كسب
،المزيد من الوقت

294
00:20:04,280 --> 00:20:07,680
كي تتمكّن عقولي المُتوازية من إنهاك عقلها أكثر

295
00:20:07,680 --> 00:20:12,930
وفي هذه الأثناء، يمكنني البدء بتقليص عدد أتباعها

296
00:20:16,040 --> 00:20:20,520
صيد السّمك لطيف. يمنحك الفُرصة للتفكير
في مُختلف الأشياء

297
00:20:21,180 --> 00:20:23,440
!ماذا؟ هل اصطدتُ واحدة؟ أظنّها كبيرة الحجم

298
00:20:23,820 --> 00:20:25,690
!ما هي يا تُرى؟ سمك أبو سيف أو ما شابه؟

299
00:20:28,210 --> 00:20:30,210
!ربّما تونة؟

300
00:20:30,210 --> 00:20:31,930
!تعال

301
00:20:35,590 --> 00:20:39,460
!هذا أكبر قليلاً ممّا أردت! تنّين ماء؟

302
00:20:40,860 --> 00:20:44,580
بتذكّر الماضي، قاتلتُ مُختلف أنواع التّنانين

303
00:20:44,580 --> 00:20:48,850
ريند... أرابا... كنتُما خصمين قويّين

304
00:20:49,480 --> 00:20:50,720
...مُقارنة بذلك

305
00:20:51,290 --> 00:20:53,980
!أتظنّ نفسك مُؤهّلاً كتنّين حقّاً؟

306
00:21:00,350 --> 00:21:02,240
!لا أعتقد ذلك

307
00:21:02,240 --> 00:21:06,460
إيّاك والظنّ أنّك تستطيع العبث مع عنكبوت
!قتلَ تنّينَي نار وأرض

308
00:21:09,440 --> 00:21:15,100
أتذكّر الآن أنّ لديّ شيء أفعله
أهمّ من صيد السّمك

309
00:21:16,730 --> 00:21:19,000
!أوّلاً عنكبوت الدّمية المُتحرّكة

310
00:21:19,000 --> 00:21:22,850
!والآن تستمرّ المعركة

311
00:21:25,010 --> 00:21:25,950
!لحظة

312
00:21:25,950 --> 00:21:26,890
!تمهّل

313
00:21:27,400 --> 00:21:29,510
!قلتُ توقّف

314
00:21:32,860 --> 00:21:34,010
!لن أصل إلى نتيجة هكذا

315
00:21:34,250 --> 00:21:37,060
!ما يعني أنّه حان الوقت لاستخدام عقلي

316
00:21:38,020 --> 00:21:41,390
!تعال يا مُنتجع مُحيط ميامي

317
00:21:41,810 --> 00:21:46,040
!تتساءل إن كنتُ سأغرق أيضاً؟ مُحال أن أقلق

318
00:21:49,170 --> 00:21:51,370
!لأنّني أستطيع أن أعوم

319
00:21:51,370 --> 00:21:55,900
!ناهيك عن أنّني خالدة

320
00:21:57,700 --> 00:21:59,280
!نلتُ منه

321
00:21:59,280 --> 00:22:01,800
...إذا استمررتُ في تقليص عدد قوّاتها هكذا

322
00:22:01,800 --> 00:22:05,800
!يمكنني الفوز! لأنّني أساساً، فائزة

323
00:22:06,130 --> 00:22:07,800
!فائزة

324
00:22:09,880 --> 00:22:15,810
صيد السّمك هو خير وسيلة للهدوء والاسترخاء
بعد الانفعال في معركة

325
00:22:16,250 --> 00:22:17,530
!عبرتُ أخيراً

326
00:22:17,530 --> 00:22:18,760
!تبّاً، أخفتني

327
00:22:18,760 --> 00:22:22,270
!الفنّانة التي تُعرف سابقاً بعقل السّحر 1
...تسرّني رؤيتك من جديد

328
00:22:22,270 --> 00:22:23,470
!عليكِ أن تهربي حالاً

329
00:22:23,470 --> 00:22:25,040
لماذا تقولين ذلك؟

330
00:22:25,040 --> 00:22:27,070
!هناك وحش خطير متوجّه نحوك

331
00:22:27,240 --> 00:22:28,610
من؟ أمّي؟

332
00:22:28,610 --> 00:22:31,270
!لا! كنّا مخطئات من البداية

333
00:22:31,270 --> 00:22:34,040
اعتقدنا أنَّ أمّي كانت ذروة السّلسلة
!الغذائيّة، لكن كنّا مُخطئات

334
00:22:34,040 --> 00:22:35,910
!هناك تهديد أكبر منها بكثير

335
00:22:35,910 --> 00:22:38,550
لحظة، ماذا؟ لستُ أفهمك إطلاقاً

336
00:22:47,600 --> 00:22:50,700
ذلك... لم يكن انتقالاً آنيّاً، صحيح؟

337
00:22:50,700 --> 00:22:52,560
هل جاء أحدٌ إلى هنا؟

338
00:22:54,540 --> 00:22:55,530
!تقييم

339
00:22:56,580 --> 00:22:57,740
معقول؟

340
00:22:58,070 --> 00:22:59,800
!تفعّلي يا حكمة

341
00:23:01,410 --> 00:23:02,780
...هذه الألقاب

342
00:23:03,870 --> 00:23:06,000
وحش إلهي قديم؟

343
00:23:06,820 --> 00:23:07,860
!سيّد شيطان؟

344
00:23:08,060 --> 00:23:11,970
!ما هذا بالضبط؟! ليتني لم أنظر أبداً

345
00:23:11,970 --> 00:23:15,550
!هذه مصيبة! مصيبة حقيقيّة

346
00:23:15,550 --> 00:23:17,220
...المعذرة

347
00:23:17,220 --> 00:23:22,370
!لم أقصد أي أذى! تفهمين ذلك، صحيح؟

348
00:23:24,130 --> 00:23:25,900
—يبدو هذا سيّئاً! من الأفضل أن أهـ

349
00:23:29,750 --> 00:23:33,420
!لم أفعلها في الوقت