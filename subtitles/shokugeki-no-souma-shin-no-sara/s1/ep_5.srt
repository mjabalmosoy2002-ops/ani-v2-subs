1
00:00:04,400 --> 00:00:05,440
...هذه النّكهة

2
00:00:08,610 --> 00:00:11,900
.أتساءل ماذا فعلت ميغو-ميان

3
00:00:12,820 --> 00:00:14,860
ماذا يحدث؟

4
00:00:14,860 --> 00:00:18,530
إنّ الحكّام يتفاعلون مع طبق
.تادوكورو ميغومي ثانية

5
00:00:18,530 --> 00:00:20,910
.فهمت... إنّها وسط الدّوراياكي

6
00:00:21,610 --> 00:00:24,460
.وضعت مربّى التّفّاح في الدّاخل

7
00:00:24,460 --> 00:00:27,920
،رغم أنّ التّفّاح هو نجم هذه المربّى
.إلاّ أنّها تحتوي الزّنجبيل أيضًا

8
00:00:27,920 --> 00:00:31,060
الانطباع القويّ الّذي نحصل عليه
عندما تجتمع المربّى

9
00:00:31,060 --> 00:00:33,380
مع قطع من التّفّاح وكعك
.الدّوراياكي رائع للغاية

10
00:00:33,380 --> 00:00:37,530
لا بدّ أنّ هذا الزّنجبيل هو ما كان
.السّيّد ألديني يقطّعه

11
00:00:37,530 --> 00:00:38,350
.نعم

12
00:00:38,350 --> 00:00:43,060
قطّعت زنجبيل تاكومي-كُن الّذي
.على شكل إبر إلى قطع أصغر

13
00:00:43,400 --> 00:00:46,900
خطرت الفكرة ببالي عندما سمعت
.أنّ تاكومي-كُن سيستعمل الزّنجبيل

14
00:00:46,900 --> 00:00:49,370
ظننتُ أنّه ربّما عندما تأخذون
قضمة من المنتصف

15
00:00:49,370 --> 00:00:51,110
،بعد أكل معجون شيروان الحلو الخفيف

16
00:00:51,110 --> 00:00:56,070
،فإنّ الحموضة ستملأ أفواهكم
.مبرزة بذلك عمقًا آخر للنّكهة

17
00:00:56,390 --> 00:00:58,540
...زبدة التّفّاح والمربّى

18
00:00:58,540 --> 00:01:00,160
،قد يبدوان متشابهين

19
00:01:00,480 --> 00:01:03,080
لكنّ الفرق في مذاقهما والتّغيير
...الّذي يسبّبانه

20
00:01:03,080 --> 00:01:06,040
ذلك هو العامل الحاسم الأخير
.في الدّوراياكي الّذي أعددتُه

21
00:01:06,480 --> 00:01:09,430
من كان يعلم أنّها تملك ورقة
رابحة في جعبتها؟

22
00:01:09,430 --> 00:01:11,450
إنّ التّشابه الكبير بين المكوّنين

23
00:01:11,450 --> 00:01:13,840
جعلها قادرة على تسديد
!هذا الهجوم المفاجئ

24
00:01:13,840 --> 00:01:15,540
!يا لها من تقنية تغيير مذاق ممتازة

25
00:01:15,540 --> 00:01:18,140
سيساعدها هذا بكلّ تأكيد
.لمجاراة خصمها

26
00:01:18,140 --> 00:01:22,970
حسنًا، لنطلب من الحكّام
.أن يمنحونا نتائجهم

27
00:01:22,970 --> 00:01:26,190
كانت تلك بكلّ تأكيد لكمة مخبّأة
.لكلّ من استمتع بالطّبق

28
00:01:26,600 --> 00:01:30,610
الضّربة القاضية الّتي كانت تخفيها
!حتّى اللّحظة الأخيرة

29
00:01:33,380 --> 00:01:36,950
،سوف أغوص مباشرة في منتصف منطقة خصمي

30
00:01:36,950 --> 00:01:39,070
...وأقف في نقطتها العمياء

31
00:01:40,700 --> 00:01:42,370
!وأسدّد لكمة من الأسفل

32
00:03:29,390 --> 00:03:31,600
...خسرت

33
00:03:31,910 --> 00:03:38,160
كان مجهودك في تقديم عدّة
.مفاجآت في طبق واحد ممتازًا

34
00:03:38,160 --> 00:03:42,180
لكن بسبب الطّعم المرّ الطّفيف
،في المربّى في النّهاية

35
00:03:42,180 --> 00:03:46,120
.تغلّب ذلك على حلاوة الشّيروان الخفيفة

36
00:03:46,120 --> 00:03:47,880
.أوافقك الرّأي

37
00:03:47,880 --> 00:03:50,330
.لكن يبدو أنّ آن صوّتت لتادوكورو-سان

38
00:03:50,330 --> 00:03:51,390
.بالفعل

39
00:03:51,390 --> 00:03:56,290
كان من الواجب عليّ أن أثني على
.دهائها والإمكانيّات الّتي أظهرتْها

40
00:03:56,290 --> 00:04:02,000
عـ-على أيّ حال، كان الفوز في هذه
،المباراة من نصيب فريق النّخبة العشرة

41
00:04:02,000 --> 00:04:06,600
!بفضل انتصار أكانيغاكوبو مومو-سينباي

42
00:04:10,270 --> 00:04:11,670
...تادوكورو

43
00:04:13,810 --> 00:04:17,740
.آسفة يا سوما-كُن... وتاكومي-كُن

44
00:04:17,740 --> 00:04:19,780
.أظنّني خسرت

45
00:04:20,990 --> 00:04:23,450
!بذلتِ كلّ جهدك! لا تقلقي بشأن ذلك

46
00:04:23,450 --> 00:04:25,950
.كان فكرة الزّنجبيل الإبريّ ممتازة

47
00:04:25,950 --> 00:04:27,410
.يجدر بك أن تفخري بنفسك

48
00:04:27,410 --> 00:04:29,900
!نعم يا ميغومي! لا داعي للاعتذار

49
00:04:29,900 --> 00:04:31,370
!أحسنتِ يا ميغومي

50
00:04:31,370 --> 00:04:33,510
!أبليتِ حسنًا

51
00:04:34,550 --> 00:04:36,210
.شكرًا لكم جميعًا

52
00:04:36,210 --> 00:04:38,460
ما خطبكما؟ لماذا أنتما صامتين فجأة؟

53
00:04:39,090 --> 00:04:41,420
من المخيّب أنّنا خسرنا للمرّة
...الرّابعة على التّوالي

54
00:04:41,420 --> 00:04:43,230
.تادوكورو-سان

55
00:04:43,880 --> 00:04:45,340
.أحسنتِ عملاً

56
00:04:45,650 --> 00:04:48,050
.شكرًا. لكنّني آسفة بالفعل

57
00:04:48,050 --> 00:04:50,760
.عليّ الاعتذار للمدرّب شينوميا أيضًا

58
00:04:50,760 --> 00:04:54,230
.لكنّني أشعر فعلاً أنّني بذلك كلّ جهدي

59
00:04:54,230 --> 00:04:56,620
إنّ مواجهة تلميذة في السّنة
الثّالثة ومن النّخبة العشرة

60
00:04:56,620 --> 00:04:58,860
.هو إنجاز مذهل لي بحد ذاته

61
00:04:59,170 --> 00:05:02,180
...لذا... لذا

62
00:05:03,060 --> 00:05:04,240
...تادوكورو-سان

63
00:05:14,740 --> 00:05:15,580
.لا أصدّق

64
00:05:16,500 --> 00:05:20,280
!ليست ظريفة. ليست ظريفة. ليست ظريفة

65
00:05:20,280 --> 00:05:24,130
!لست ظريفة على الإطلاق يا تادوكورو ميغومي

66
00:05:26,090 --> 00:05:29,760
ألن تقول أيّ شيء لتادوكورو-كُن؟

67
00:05:30,320 --> 00:05:33,020
.إنّها لا تحتاج لأيّ تشجيع الآن

68
00:05:33,510 --> 00:05:35,750
لكن هلاّ أبلغتها هذه الرّسالة منّي؟

69
00:05:35,750 --> 00:05:37,680
،إن كانت تريد أن تصبح أقوى

70
00:05:37,680 --> 00:05:40,940
فبإمكانها طرق باب مطعم
.شينوز طوكيو" في أيّ وقت"

71
00:05:47,780 --> 00:05:51,740
!تشجّعا يا تاكومي-كُن وسوما-كُن

72
00:05:51,740 --> 00:05:55,250
.أكيد يا تادوكورو. أعرف أنّك محبطة الآن

73
00:05:55,250 --> 00:06:00,110
.فقط شاهدي نتاج عملنا الجماعيّ
!أعد ألاّ يضيع هباءً

74
00:06:00,110 --> 00:06:03,450
،يجهّز تاكوميتشي اللّحم أخيرًا
!وهو موضوع طبخه

75
00:06:03,450 --> 00:06:07,470
إنّه يقلي شرائح اللّحم الرّفيعة ببطء
.في زيت السّمسم لإبراز رائحته

76
00:06:07,780 --> 00:06:11,640
،بمجرّد أن يُطبخ اللّحم
.سأضيف الزّنجبيل وأغليه

77
00:06:11,640 --> 00:06:14,160
.يبدو وكأنّه يعدّ شيغوريني

78
00:06:14,160 --> 00:06:19,460
طبق يابانيّ لديها نكهة حلوة غنيّة مع بعض
.المذاق الحارّ من الزّنجبيل الّذي يُبهج اللّسان

79
00:06:19,460 --> 00:06:21,650
إنّ الاختلاف الشّديد في الرّوائح
،قد شُبّه بأمطار شوغيري

80
00:06:21,650 --> 00:06:23,670
،حيث تُمطر وتتوقّف فجأة
.ممّا منح الطّبق اسمه

81
00:06:23,670 --> 00:06:24,780
.إنّه طبق عميق بالفعل

82
00:06:24,780 --> 00:06:28,040
!أحسنت يا تاكوميتشي
!أتقنتَ حتّى المطبخ اليابانيّ

83
00:06:28,040 --> 00:06:30,250
،كيف سيستعمل الشّيغوريني

84
00:06:30,250 --> 00:06:32,780
وإلى أيّ مستوى يمكنه أخذ الشّيغوريني؟

85
00:06:32,780 --> 00:06:35,740
.أتساءل كيف سيجيب أخي على ذلك

86
00:06:38,210 --> 00:06:40,660
!أنت بارع في هذا

87
00:06:40,660 --> 00:06:43,250
هلاّ منحتني بعض النّصائح لاحقًا
عن كيفية إعداد قشرة عجينة البيتزا؟

88
00:06:43,250 --> 00:06:45,920
.اذهب وركّز على طبقك يا يوكيهيرا

89
00:06:45,920 --> 00:06:47,420
إنّه يجهّز عجينة بيتزا؟

90
00:06:47,420 --> 00:06:50,510
ينوي تاكوميتشي أن يعدّ
بيتزا بالشّيغوريني؟

91
00:06:50,510 --> 00:06:53,360
!بيتزا بالشّيغوريني! كم هذا غير اعتياديّ

92
00:06:53,360 --> 00:06:55,720
.نعم. لا أطيق الانتظار لرؤية الطّبق مكتملاً

93
00:06:56,380 --> 00:06:59,470
ماذا؟ شيغوريني؟

94
00:07:03,190 --> 00:07:07,430
لا بدّك أنّ وصلت لهذه المرحلة
رغم أنّك ما زلت محبطًا

95
00:07:07,430 --> 00:07:09,570
بسبب خسارتك أمام ميماساكا
.في انتخابات الخريف

96
00:07:10,150 --> 00:07:13,910
.يا لك من طاه نموذجيّ. هذا مثير للاهتمام

97
00:07:14,320 --> 00:07:15,370
،لكن للأسف

98
00:07:15,990 --> 00:07:21,330
...أعتقد أنّ فخرك سيُسحق ثانية

99
00:07:21,330 --> 00:07:24,290
.يا تاكومي ألديني

100
00:07:24,290 --> 00:07:28,560
لم يتبقّى سوى المبارتين الأولى
.والثّانية في الجولة الثّالثة

101
00:07:28,560 --> 00:07:30,970
أمعنوا النّظر رجاءً لما يوجد
!بيني يديّ إيزان-سينباي

102
00:07:30,970 --> 00:07:35,640
!انظروا لذلك الحجم
!يبدو أنّها مليئة بالعصارة أيضًا

103
00:07:35,640 --> 00:07:39,390
!انظروا لمدى روعة قطعة اللّحم المشويّة

104
00:07:39,390 --> 00:07:41,730
.تلك تقنية محترفة للغاية

105
00:07:41,730 --> 00:07:46,970
.قام بتسخين اللّحم حتّى منتصفه
!إنّها قطعة اللّحم المشويّة الأفضل

106
00:07:47,690 --> 00:07:49,520
...الفجل الحارّ

107
00:07:49,520 --> 00:07:52,950
.ناهيك عن ذكر القشدة الطّريّة والزّبادي والبلم

108
00:07:52,950 --> 00:07:56,730
.يبدو انّه يُعدّ صلصة قشديّة لمرافقة اللّحم

109
00:07:56,730 --> 00:07:58,620
.لا يوجد أيّ تردّد على الإطلاق في حركاته

110
00:07:58,620 --> 00:08:03,120
لا عجب أنّه من النّخبة العشرة. تقنيات
!تحضيره للمكوّنات من الدّرجة الأولى

111
00:08:03,120 --> 00:08:05,090
لماذا تُثني عليه يا ماروي؟

112
00:08:05,090 --> 00:08:08,480
هل نسيت ما فعله ذلك الوغد
لمسكن النّجم القطبيّ؟

113
00:08:08,480 --> 00:08:09,550
...بالطّبع لا

114
00:08:09,550 --> 00:08:11,510
.من المستحيل أن أنسى ذلك

115
00:08:14,220 --> 00:08:15,940
!أحسنت يا تاكوميتشي

116
00:08:15,940 --> 00:08:17,970
!لا تخسر أمام ذلك الياكوزا العبقريّ

117
00:08:17,970 --> 00:08:19,180
!أطحه أرضًا

118
00:08:19,180 --> 00:08:21,010
!يجب أن تفوز

119
00:08:21,010 --> 00:08:23,390
.إنّهم يعتمدون عليك بكلّ تأكيد

120
00:08:24,200 --> 00:08:26,420
،رغم أنّني فعلتُ ذلك بسبب إعادة الهيكلة

121
00:08:26,420 --> 00:08:29,590
.إلاّ أنّ ما فعلته بمسكنهم لم يكن عملاً متحضّرًا

122
00:08:29,590 --> 00:08:32,780
يبدو أنّه من السّهل على النّاس
.العثور على سبب لكرهي

123
00:08:33,260 --> 00:08:35,240
هل أنت واحد من هؤلاء النّاس أيضًا؟

124
00:08:35,940 --> 00:08:39,700
ميماساكا هو من تحدّاك لشوكوغيكي
.في انتخابات الخريف

125
00:08:40,030 --> 00:08:44,100
.كنتُ أدير انتخابات الخريف بكلّ نزاهة فحسب

126
00:08:44,100 --> 00:08:47,540
.لا أعتقد أنّه من العدل أن أكون محلّ الكره

127
00:08:47,540 --> 00:08:52,010
كره؟ تلك الكلمة لا تصف المشاعر
.الّتي أكنّها تجاهك تمامًا

128
00:08:52,010 --> 00:08:55,470
.بل أنا لا أكرهك

129
00:08:55,470 --> 00:08:58,680
.أنا هن للفوز فحسب

130
00:08:58,680 --> 00:09:01,770
.إنّ إيزان معتاد على استفزاز خصومه

131
00:09:01,770 --> 00:09:04,580
،يحاول ألديني التّصرّف بهدوء ورشد

132
00:09:04,580 --> 00:09:08,650
.لكنّه يبدو أكثر تهوّرًا ممّا تبديه كلماته

133
00:09:11,320 --> 00:09:14,290
يقوم تاكوميتشي الآن بلفّ
.عجينته ليدعها ترتاح

134
00:09:14,290 --> 00:09:15,900
.إنّه يدخل المرحلة الأخيرة من تجهيزاته

135
00:09:15,900 --> 00:09:18,870
.يضع الصّلصة بخفّة على عجينة البيتزا

136
00:09:18,870 --> 00:09:22,870
.ثمّ يضع لحم شيغوريني المقليّ بحذر فوقها

137
00:09:22,870 --> 00:09:25,250
!ويضيف أيضًا البصل وجبن الموتزاريلاّ

138
00:09:25,250 --> 00:09:28,080
سيكون عليها طبخها في حرارة
.تبلغ 250 درجة لمدّة 12 دقيقة

139
00:09:28,080 --> 00:09:31,750
عليه فقط أن يطبخها لوقت كافٍ
.لتصبح القشرة بلون بنّيّ ذهبيّ

140
00:09:31,750 --> 00:09:33,460
.إلى الفرن الآن

141
00:09:33,460 --> 00:09:36,000
!"فورنو أتشينديري"

142
00:09:38,470 --> 00:09:41,830
.تبدو البيتزا الّتي أعددتها هشّة

143
00:09:41,830 --> 00:09:45,990
يبدو أنّه سيكون من الصّعب إضافة
.لمزيد من التّوابل بعد أن تُطبخ

144
00:09:45,990 --> 00:09:48,100
وماذا في ذلك؟

145
00:09:48,100 --> 00:09:51,150
.انتهى أمرك

146
00:09:52,640 --> 00:09:57,070
.هنالك مكوّن آخر يتماشى مع صلصتي القشديّة

147
00:09:57,070 --> 00:09:58,780
!الأرضي شوكي

148
00:09:59,110 --> 00:10:03,830
يحتوي هذا الخضار على الكثير من
.السّينارين الّذي يمنحه نكهة مرّة

149
00:10:03,830 --> 00:10:08,790
الميزة الأبرز فيه هي أنّه يلازم
،مستقبلات التّذوّق على اللّسان

150
00:10:08,790 --> 00:10:14,760
وهذا يُربك النّكهات ويجعل أيّ شيء
.يُؤكل بعده أحلى مذاقًا ممّا يجب

151
00:10:14,760 --> 00:10:15,620
!ماذا؟

152
00:10:15,620 --> 00:10:16,880
أذلك ممكن فعلاً؟

153
00:10:16,880 --> 00:10:19,050
،إنّه ممكن. على سبيل المثال

154
00:10:19,050 --> 00:10:22,120
إن أكلتم تحلية بعد أكل طبق
،مُعدّ من الأرضي شوكي

155
00:10:22,120 --> 00:10:24,290
.فإنّه سيبرز حلاوتها أكثر

156
00:10:24,290 --> 00:10:26,600
ثمّة الكثير من الطّهاة الّذين
.يستغلّون هذا لصالحهم

157
00:10:26,600 --> 00:10:30,560
الشّيغوريني الّذي أعددتَه هو طبق
.يظهر النّكهة الحلوة الغنيّة

158
00:10:30,890 --> 00:10:36,490
ماذا سيحدث في اعتقادك إن أكلت
الكثير من الأرضي شوكي قبله؟

159
00:10:36,490 --> 00:10:39,700
ما زالت أمامك 10 دقائق
.قبل أن تُطبخ تلك البيتزا بالكامل

160
00:10:39,700 --> 00:10:42,120
.سيكتمل طبقي أوّلاً

161
00:10:42,430 --> 00:10:45,580
إنّ بيتزا الشّيغوريني الّتي سيتمّ تذوّقها لاحقًا

162
00:10:45,580 --> 00:10:47,580
.ستتحوّل إلى طبق شديد الحلاوة

163
00:10:47,890 --> 00:10:51,080
!ممّا يعني أنّ مذاقها سيذهب مهبّ الرّيح

164
00:10:51,080 --> 00:10:52,370
!ماذا؟

165
00:10:52,370 --> 00:10:55,300
كيف له أن يفعل شيئًا وضيعًا كهذا
!في تلك المرحلة من المباراة؟

166
00:10:55,300 --> 00:10:56,420
!ألا فخر لديك؟

167
00:10:56,420 --> 00:11:01,670
أيّها الحكّام! احرموا ذلك المنحرف
!من المشاركة في الحال

168
00:11:01,670 --> 00:11:03,270
ولماذا قد نفعل ذلك؟

169
00:11:03,270 --> 00:11:06,230
اكتشف ما يطبخه خصمه
،في الوقت المخصّص للطّبخ

170
00:11:06,230 --> 00:11:08,730
.وفكّر في استراتيجيّة لهزيمته

171
00:11:08,730 --> 00:11:11,600
.لم يقترف أيّ خطأ

172
00:11:11,600 --> 00:11:13,060
...مستحيل

173
00:11:13,060 --> 00:11:17,030
.والآن... أعتقد أنّني سأنهي استعداداتي

174
00:11:17,030 --> 00:11:20,110
!سأضيف الكثير من الأرض شوكي

175
00:11:21,320 --> 00:11:24,990
!تاكومي ألديني، ما زلت ساذجًا جدًّا

176
00:11:24,990 --> 00:11:27,740
!الآن كما في السّابق

177
00:11:27,740 --> 00:11:30,650
!في اليوم الّذي أخذت منك سكّين ميتزالونا

178
00:11:30,650 --> 00:11:34,170
...إن كان ذلك الشّخص مكانك

179
00:11:34,600 --> 00:11:37,900
أنا واثق أنّ يوكيهيرا كان ليتمكّن
!من تجاوز هذا

180
00:11:37,900 --> 00:11:39,630
!على عكسك أنت

181
00:11:42,470 --> 00:11:44,610
!انتهى طبقي

182
00:11:44,610 --> 00:11:48,930
...لحم البقر المشويّ السّاحر
.على طريقة إيزان إتسويا

183
00:11:53,090 --> 00:11:55,250
!كلاّ! لقد انتهى

184
00:11:55,250 --> 00:11:57,480
...فوق قطعة اللّحم اللّذيذة المليئة بالعصارة

185
00:11:57,480 --> 00:11:59,440
!وضع بيضة مغليّة قشديّة

186
00:11:59,440 --> 00:12:01,960
!إنّ لذّة ذلك الطّبق تبدو جنونيّة

187
00:12:01,960 --> 00:12:05,010
هل سيُفسد ذلك الطّبقُ طبقَ تاكوميتشي؟

188
00:12:05,010 --> 00:12:06,870
بسبب السّينارين أو أيًّا كان؟

189
00:12:06,870 --> 00:12:09,200
...انظروا لهذا الجمال

190
00:12:09,200 --> 00:12:10,650
!لون أحمر ورديّ راقٍ

191
00:12:10,650 --> 00:12:13,080
.لساني مبتهج من مجرّد النّظر إليه

192
00:12:16,150 --> 00:12:17,880
!سيشهد التّاريخ لهذه اللّذّة

193
00:12:18,190 --> 00:12:22,470
مذهل! لا أعتقد أنّني أكلت من قبل
!طبقًا بهذا القدر من الأرضي شوكي

194
00:12:22,470 --> 00:12:25,140
!نعم، لكنّني أريد أكل المزيد والمزيد منه

195
00:12:25,450 --> 00:12:27,470
...لا يمكنني حتّى إخفاء فضولي

196
00:12:27,470 --> 00:12:31,420
كيف هو مذاق طبق يحتوي الكثير
من الأرضي شوكي؟

197
00:12:31,420 --> 00:12:33,950
يساورني الفضول... بل يقتلني
.الفضول. أريد تذوّقه

198
00:12:33,950 --> 00:12:36,100
...هذا هو سبب فضولك إذًا

199
00:12:36,990 --> 00:12:39,270
.عليك دائمًا إرضاء فضولك

200
00:12:39,650 --> 00:12:41,280
هل تريدان تذوّقه؟

201
00:12:41,280 --> 00:12:42,990
ماذا؟ أيمكننا ذلك؟

202
00:12:42,990 --> 00:12:44,520
ماذا؟ أنا أيضًا؟

203
00:12:48,510 --> 00:12:54,040
لا يكفّ مذاق الصّلصة القشديّة عن مداعبة
.لساني مُخفيًا نكهة للّحم المشويّ الغنيّة

204
00:12:54,040 --> 00:12:56,460
!عصارة اللّحم لها مذاق لا يصدّق

205
00:12:56,460 --> 00:12:58,550
ومع ذلك تمكّن من إبراز العمق المميّز

206
00:12:58,550 --> 00:13:01,170
.والمذاق المرّ للخضراوات بقوّة

207
00:13:01,170 --> 00:13:04,090
.كلّ هذا بسبب سحر السّينارين

208
00:13:04,090 --> 00:13:06,300
إنّه يتخلّص من كلّ الحلاوة غير
،الضّروريّة في الطّبق

209
00:13:06,300 --> 00:13:09,100
.ويساعد على إبراز الصّلصة القشديّة

210
00:13:09,100 --> 00:13:12,060
.يؤثّر السّينارين مباشرة على مستقبلات التّذوّق

211
00:13:12,060 --> 00:13:16,440
،نعم. إنّه يغطّي الجزء العلويّ من اللّسان
.وهو ما يتذوّق الحلاوة

212
00:13:16,950 --> 00:13:19,770
.هذا ما يشعر به الحكّام الآن

213
00:13:19,770 --> 00:13:22,730
.تمّ كبح المذاق الحلو وتعزيز المذاق المرّ

214
00:13:23,310 --> 00:13:26,180
،وإن أكلوا طبقًا آخر بعده

215
00:13:23,870 --> 00:13:32,370
.أكل

216
00:13:26,180 --> 00:13:29,210
يُنزع السّينارين بشكل
،تدريجيّ بينما يمضغون

217
00:13:29,210 --> 00:13:32,370
فتبدأ مستقبلات التّذوّق
...بالعامل بشكل طبيعيّ

218
00:13:32,960 --> 00:13:35,580
،ولكن بسبب كبح الإحساس بالطّعم الحلو

219
00:13:35,580 --> 00:13:38,760
.فإنّ أقلّ حلاوة قد تصبح طاغية

220
00:13:38,760 --> 00:13:40,590
.فهمت

221
00:13:40,590 --> 00:13:43,140
،إن كان ثمّة الكثير من السّينارين على اللّسان

222
00:13:43,140 --> 00:13:46,170
.حتّى الماء سيكون مذاقه حلوًا

223
00:13:46,170 --> 00:13:47,860
إنّ الحلاوة في شيغوريني ألديني

224
00:13:47,860 --> 00:13:50,460
.ستُعزّز أيضًا بكلّ تأكيد

225
00:13:50,460 --> 00:13:53,420
،وفي الوقت الّذي سيتذوّق فيه الحكّام البيتزا

226
00:13:53,420 --> 00:13:55,650
،سيُنزع كلّ السّينارين من ألسنتهم

227
00:13:55,650 --> 00:13:58,650
.ولن يؤثّر ذلك على تذوّقهم للأطباق التّالية

228
00:13:58,650 --> 00:14:02,770
كان إيزان-سينباي على علم بكلّ هذه
!التّأثيرات واستعملها جميعها لصالحه

229
00:14:02,770 --> 00:14:05,060
...كان على علم حتّى بمكوّن صغير كهذا

230
00:14:05,060 --> 00:14:07,900
!إنّ بالفعل مثال للحكمة والثّروة

231
00:14:07,900 --> 00:14:11,410
!أظنّ أنّه لا يلقّب بالخميائيّ من فراغ

232
00:14:13,900 --> 00:14:16,250
!هنالك تفاعل كيميائيّ على لساني مباشرة

233
00:14:16,250 --> 00:14:17,930
!معجزة التّذوّق

234
00:14:17,930 --> 00:14:19,370
...هذه اللّذّة

235
00:14:19,900 --> 00:14:22,000
!عبارة عن خدعة سحريّة عالية المستوى

236
00:14:23,940 --> 00:14:26,920
!وهم لا أريد الخروج منه

237
00:14:28,420 --> 00:14:31,390
!اكتمل طبخ بيتزا تاكوميتشي

238
00:14:31,930 --> 00:14:34,390
حسنًا يا ألديني. لماذا أنت حزين؟

239
00:14:34,700 --> 00:14:38,660
صحيح. لماذا لا تطلب من الحكّام
أن يشربوا بعض الماء؟

240
00:14:38,660 --> 00:14:41,940
!قد يخفّف ذلك من تأثير السّينارين قليلاً

241
00:14:41,940 --> 00:14:43,900
!أغرقهم بالماء

242
00:14:44,290 --> 00:14:46,860
.كلاّ، يمكننا المواصلة كما هو مخطّط

243
00:14:46,860 --> 00:14:49,170
—صحيح، من الجيّد أن تعرف متى تستسـ

244
00:14:49,170 --> 00:14:51,530
.لن يكون ذلك ضروريًّا، فسأفوز

245
00:14:51,950 --> 00:14:52,490
ماذا؟

246
00:14:55,030 --> 00:14:56,430
...أخي

247
00:14:59,290 --> 00:15:00,670
...تلك البيتزا

248
00:15:00,670 --> 00:15:03,450
يجب أن يكون الشّيغوريني
...هو الإضافات الأساسيّة

249
00:15:03,450 --> 00:15:05,000
...أو ذلك ما يجب أن يكون على الأقلّ

250
00:15:05,000 --> 00:15:08,540
لكنّ الشّيغوريني موجود
!في نصف البيتزا فحسب

251
00:15:08,540 --> 00:15:11,140
النّصف الآخر عبارة عن جبن فقط؟

252
00:15:11,140 --> 00:15:12,340
!هذا بسيط أكثر من اللاّزم

253
00:15:12,340 --> 00:15:15,380
بماذا يفكّر تاكومي-كُن؟

254
00:15:21,550 --> 00:15:22,650
!شهيّة طيّبة

255
00:15:23,830 --> 00:15:24,400
.فهمت

256
00:15:24,990 --> 00:15:28,030
.واضح أنّ الإضافات قد فصلت لنصفين

257
00:15:28,030 --> 00:15:30,360
هذا مشابه تمامًا لخدمة
.توصيل البيتزا في اليابان

258
00:15:30,360 --> 00:15:33,290
هل يمكننا أكل هذه البيتزا بأيدينا؟

259
00:15:33,290 --> 00:15:36,630
في إيطاليا، يستعلمون غالبًا
.الشّوكة والسّكّين لأكل البيتزا

260
00:15:36,630 --> 00:15:39,170
.طبعًا، كلوها كما يحلو لكم

261
00:15:39,170 --> 00:15:42,680
.لا تؤثّر طريقة أكلكم للبيتزا على طعمها

262
00:15:42,680 --> 00:15:47,810
لكنّني أتمنّى أن تلبّوا لي طلبًا
.واحد بصفتي طاهي هذا الطّبق

263
00:15:47,810 --> 00:15:49,300
...الجزء الأيمن

264
00:15:49,840 --> 00:15:52,760
أريدكم أن تأكلون الجزء الّذي يحتوي
.الشّيغوريني أوّلاً

265
00:15:52,760 --> 00:15:54,360
!مهلاً لحظة

266
00:15:54,360 --> 00:15:56,920
!لن تكون الحلاوة في صفّه بسبب السّينارين

267
00:15:56,920 --> 00:15:58,600
!بماذا تفكّر يا ألديني؟

268
00:16:00,270 --> 00:16:02,190
.لنبدأ إذًا أكل جزء الشّيغوريني

269
00:16:02,190 --> 00:16:04,470
.هذا الشّيغوريني مذهل

270
00:16:04,470 --> 00:16:08,650
واثق أنّ طعمه كان سيكون رائعًا
.في ظروف عاديّة

271
00:16:08,650 --> 00:16:11,490
هذه مسألة لا يسعنا فعل شيء
.حيالها في منافسة

272
00:16:18,770 --> 00:16:21,040
!لذّتها مذهبة بكلّ تأكيد

273
00:16:21,910 --> 00:16:23,260
!ماذا؟

274
00:16:23,260 --> 00:16:24,370
!كـ-كيف؟

275
00:16:24,730 --> 00:16:26,840
...صلصة اليوزو ميسو الّتي أضفتُها للبيتزا

276
00:16:27,320 --> 00:16:29,880
.حرصت على تعديلها مسبقًا

277
00:16:30,650 --> 00:16:33,330
،بما أنّ الحلاوة ستُعزّز بفضل السّينارين

278
00:16:33,330 --> 00:16:35,580
استعملت أقلّ كمّيّة من الميسو الأبيض والسّكّر

279
00:16:35,580 --> 00:16:37,940
،والميرين الّتي قد أستعملها في العادة

280
00:16:37,940 --> 00:16:41,390
واستعملتُ المزيد من فاكهة اليوزو
.لإظهار الحموضة أكثر

281
00:16:41,390 --> 00:16:45,650
حتّى أنّني بشرتُ قشر اليوزو لإضافة
.بعض المذاق المرّ والحامض

282
00:16:46,030 --> 00:16:49,860
،حرصتُ تمامًا على أن تظلّ النّكهات كما هي

283
00:16:49,860 --> 00:16:52,210
بما أنّكم أكلتم طبق لحم
.إيزان-سينباي المشويّ أوّلاً

284
00:16:52,820 --> 00:16:54,300
،بسبب هذه التّحضيرات

285
00:16:54,300 --> 00:16:57,660
أمست النّكهة الآن أكثر تعقيدًا
.من مجرّد أكل الشّيغوريني وحده

286
00:16:58,020 --> 00:16:59,490
،في الوجبات الإطاليّة الكاملة

287
00:16:59,490 --> 00:17:04,140
يقدّمون أوّلاً طبقًا أوّل قبل
الطّبقين الثّاني والرّئيسيّ

288
00:17:04,140 --> 00:17:06,620
.للمساعدة على زيادة التّرقّب

289
00:17:07,100 --> 00:17:11,180
،بهدف جعل طبقه الطّبق الرّئيسيّ

290
00:17:11,180 --> 00:17:13,880
.جعل السّيّد ألديني من طبقِ خصمه طبقًا أوّلاً

291
00:17:13,880 --> 00:17:17,710
هذا يعني أنّه جعل سحر السّيّد إيزان
.مجرد عرض افتتاحيّ

292
00:17:19,670 --> 00:17:21,390
!هذا لا يعقل

293
00:17:21,390 --> 00:17:23,770
قمتَ بتعديل وصفة الصّلصة؟

294
00:17:24,250 --> 00:17:28,260
قرّرت استعمال الأرضي شوكي لإفساد
!طبقك بعد أن رأيت الشّيغوريني

295
00:17:28,260 --> 00:17:30,360
!قمتُ بذلك بحذر شديد كي لا تلاحظ

296
00:17:30,360 --> 00:17:33,440
كيف إذًا اكتشفت أنّني سأستعمل
!الأرضي شوكي؟

297
00:17:33,440 --> 00:17:34,400
.منذ البداية

298
00:17:35,860 --> 00:17:38,690
...عرفتُ بمجرّد أن أعلن موضوع الطّبخ

299
00:17:39,180 --> 00:17:41,580
.أنّك ستستعمل الأرضي شوكي

300
00:17:42,660 --> 00:17:45,960
هنالك أشياء قليلة يمكنها كبح

301
00:17:45,960 --> 00:17:47,710
.الحلاوة داخل مخزن الأطعمة

302
00:17:47,710 --> 00:17:52,190
مثلاً، فاكهة المعجزات الّتي تجعل
.مذاق الأشياء المرّة حلوًا

303
00:17:52,190 --> 00:17:55,050
لكنّ تأثيرات المكوّن المسمّى ميراكولين

304
00:17:55,050 --> 00:17:57,130
.الموجود فيها تستمرّ لساعتين

305
00:17:57,130 --> 00:18:00,240
لكنّ ذلك سيؤثّر على تذوّق
.الأطباق الأخرى لاحقًا

306
00:18:00,240 --> 00:18:02,970
المكوّن الوحيد الّذي لن يقوم بذلك
.هو الأرضي شوكي

307
00:18:03,690 --> 00:18:08,120
.واصلتُ مراقبتك وتحرّي تفكيرك

308
00:18:08,120 --> 00:18:11,480
سمحتَ لنفسك أن تختار المكوّن
.الوحيد الّذي أردتك أن تختاره

309
00:18:11,790 --> 00:18:14,480
.كما خطّطتُ تمامًا

310
00:18:15,240 --> 00:18:20,640
مستحيل، إنّه لم يكن يحدّث بي فقط
.لأنّه كان مركّزًا تمامًا على الانتقام

311
00:18:20,640 --> 00:18:25,890
بل كان يراقبني منذ بداية الجولة الثّالثة؟

312
00:18:25,890 --> 00:18:27,740
.نعم، نعم، هذا جيّد

313
00:18:27,740 --> 00:18:30,190
من بين تحدّيات الشّوكوغيكي
،الإحدا والعشرين الّتي خضتَها

314
00:18:30,190 --> 00:18:33,440
سحقتَ أطباق خصومك بإبطال
.نكهتها في 12 تحدّيًا منها

315
00:18:33,440 --> 00:18:37,100
.واثق تمامًا أنّك ستحاول ذلك ثانية معي

316
00:18:37,100 --> 00:18:40,060
والآن، واصل تحضيرك للأرضي شوكي

317
00:18:40,060 --> 00:18:42,150
بينما لا فكرة لديك أنّني كنتُ
.أراقبك طوال الوقت

318
00:18:42,150 --> 00:18:43,350
...هيّا، هيّا

319
00:18:43,350 --> 00:18:45,960
...أعتقد أنّني أشعر بإحساس قويّ للانتقام

320
00:18:45,960 --> 00:18:49,100
نعم! يبدو مختلفًا تمامًا
!عن تاكوميتشي الّذي نعرفه

321
00:18:49,100 --> 00:18:52,190
لم أعتقد أبدًا أنّه قد يكون من النّوع
.الّذي يحمل الضّغينة

322
00:18:52,190 --> 00:18:54,020
.أنت تشبهه من تلك النّاحية

323
00:18:55,080 --> 00:18:57,650
.هذا مشابه تقريبًا لطريقة ميماساكا-كُن

324
00:18:59,580 --> 00:19:02,450
لا أصدّق أنّه استعمل تأثير
...السّينارين لمصلحته

325
00:19:02,450 --> 00:19:05,040
يكره كلاهما الآخر كرهًا دفعهما
...لتقويض طبق الآخر

326
00:19:05,040 --> 00:19:06,910
.وكأنّهما يتبادلان الخدع السّحريّة

327
00:19:06,910 --> 00:19:09,940
...لذّة هذه البيتزا

328
00:19:11,470 --> 00:19:14,790
!عبارة عن وهم لا نريد الخروج منه

329
00:19:17,170 --> 00:19:18,570
!أجل

330
00:19:18,570 --> 00:19:20,130
!نجح الطّبق نجاحًا باهرًا

331
00:19:20,450 --> 00:19:23,640
.لكنّني لم أنتهِ بعد من هذه الوجبة

332
00:19:25,350 --> 00:19:29,670
،لا تضمّ الوجبات الإيطاليّة ثلاثة أطباق في العادة

333
00:19:29,670 --> 00:19:32,160
لكنّ الجزء المتبقّي من هذه البيتزا

334
00:19:32,160 --> 00:19:35,930
هو حقًّا طريقتي في أخذ كلّ الطّبخ الإيطاليّ
.الّذي طبخته حتّى الآن للمستوى التّالي

335
00:19:35,930 --> 00:19:37,730
".بيتزو بياتّو"

336
00:19:38,570 --> 00:19:40,200
.الطّبق الثّالث

337
00:19:40,200 --> 00:19:44,160
.تبدو تلك البيتزا كنصفَيْ قمر جُمعا معًا

338
00:19:45,110 --> 00:19:47,490
!نصف قمر... ميتزالونا

339
00:19:47,490 --> 00:19:52,010
،إليكم الآن طبقي الحقيقيّ
..."بيتوا "دوبيو ميتزالونا

340
00:19:52,960 --> 00:19:55,840
.هذه نكهته الحقيقيّة

341
00:19:58,210 --> 00:20:00,800
...يضمّ النّصف الثّاني الجبن فقط

342
00:20:00,800 --> 00:20:02,630
!لن يحقّق له ذلك النّصر

343
00:20:09,180 --> 00:20:12,120
الإضافات عبارة عن أربعة أنواع
.من الجبن في الحقيقة

344
00:20:12,120 --> 00:20:15,650
!الموتزاريلاّ والبارميجان والغورغونزولا والرّيكوتّا

345
00:20:15,650 --> 00:20:16,560
...ممّا يعني

346
00:20:16,560 --> 00:20:18,520
!إنّها بيتزا رباعيّة الجبن

347
00:20:18,520 --> 00:20:20,700
هذه هي الإضافات الأكثر شعبيّة
،للبيتزا في إيطاليا

348
00:20:20,700 --> 00:20:22,530
!لكنّه استعمل المقدار المناسب لكلّ جبن

349
00:20:22,530 --> 00:20:25,950
إنّها تتماشى بشكل مثاليّ
مع القشرة المقرمشة

350
00:20:25,950 --> 00:20:28,990
ويضيف الفلفل الأسود التّأثير
!المناسب أيضًا

351
00:20:28,990 --> 00:20:32,140
الفجوة بين هذا وبين الحلاوة الغنيّة

352
00:20:32,140 --> 00:20:35,250
!للشّيغوريني تخلق عمق لذّة لا يقاوم

353
00:20:35,250 --> 00:20:36,810
،التّغيّر من مذاق الأرضي شوكي المرّ

354
00:20:36,810 --> 00:20:38,660
،ثمّ إلى حلاوة الشّيغوريني

355
00:20:38,660 --> 00:20:41,710
!وأخيرًا ملوحة الجبن الرّباعيّ

356
00:20:41,710 --> 00:20:43,200
.واحد

357
00:20:43,200 --> 00:20:44,630
...اثنان

358
00:20:44,630 --> 00:20:45,830
...ثلاثة

359
00:20:46,930 --> 00:20:50,330
إنّ من يتذوّقون هذه الرّوعة
...يساقون مباشرة للنّعيم

360
00:20:50,990 --> 00:20:54,810
!بلذّة ثلاثيّة التّأثير

361
00:20:55,230 --> 00:20:56,520
كنتُ واثقًا

362
00:20:57,160 --> 00:21:01,340
أنّ بكلّ الخبرة الّتي لديّ من
،طبخ الكثير من البيتزا

363
00:21:01,340 --> 00:21:05,570
أنّني سأتمكّن من خلق الجبن الرّباعيّ
.الأمثل ليتماشى مع الشّيغوريني بمثاليّة

364
00:21:06,170 --> 00:21:07,200
.هذا ليس كلّ شيء

365
00:21:07,710 --> 00:21:11,080
ما كانت بيتزا الشّيغوريني لتوجد
.لولا تجربتي كمتدرّب

366
00:21:11,530 --> 00:21:13,560
،ولولا معركتي ضدّ ميماساكا

367
00:21:13,560 --> 00:21:17,080
ما كنت أبدًا لأفكّر في تتبّع
.عمليّة تفكير خصمي

368
00:21:17,550 --> 00:21:20,500
الاختبارات الّتي لا تعدّ الّتي واجهتُها
...والفشل المرّ الّذي تذوّقتُه

369
00:21:21,110 --> 00:21:23,670
.هو ما أدى بظهور هذا الطّبق

370
00:21:24,090 --> 00:21:27,010
كلّ هذا بسبب تحريضك
.لميماساكا سوبارو ضدّي

371
00:21:27,430 --> 00:21:30,930
دفعني ذلك لأسلك هذا الطّريق
.الّذي قادني لهذا المستوى الرّفيع

372
00:21:32,690 --> 00:21:35,020
.لقد اكتشف خططي بالفعل واستعملها ضدّ

373
00:21:35,020 --> 00:21:38,100
...ثمّ قدّم أكثر الأطباق إثارة للحكّام

374
00:21:38,770 --> 00:21:42,100
كما فعل ميماساكا سوبارو به
.في الماضي تمامًا

375
00:21:42,100 --> 00:21:46,150
!أنا أدور في راحة يده بلا حول ولا قوّة الآن

376
00:21:46,580 --> 00:21:51,120
!سُحقًا لك... أيّها الشّقيّ من السّنة الأولى

377
00:21:51,120 --> 00:21:54,250
والفائز في المباراة الثّانية
...من الجولة الثّالثة هو

378
00:21:54,710 --> 00:21:55,960
...من جانب المتمرّدين

379
00:21:55,960 --> 00:21:57,920
!تاكومي ألديني

380
00:22:01,590 --> 00:22:02,920
"!شكرًا"

381
00:23:35,430 --> 00:23:38,030
...التّقليد المثاليّ

382
00:23:38,030 --> 00:23:39,850
!هذا مقنع أكثر حتّى من الحقيقيّ