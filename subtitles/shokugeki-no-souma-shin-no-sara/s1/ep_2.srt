1
00:01:33,940 --> 00:01:37,860
!حسنًا، توشك الجولة الثّانية أن تبدأ الآن

2
00:01:37,860 --> 00:01:41,120
يبدو أنّ الاستعدادات تسير على
!خير ما يرام لكِلا الفريقين

3
00:01:41,120 --> 00:01:42,870
!أجل

4
00:01:44,750 --> 00:01:49,460
مذهل... يبدو أنّ ميغيشيما-سينباي
.والبقيّة يبذلون كلّ قوّتهم

5
00:01:50,300 --> 00:01:54,330
القوّة؟ هنالك عدّة طرق ماكرة
.للتّعامل مع هذا الوضع

6
00:01:54,330 --> 00:01:57,210
ذكّرني من الّذي خسر أمام
تلميذ من السّنة الأولى؟

7
00:01:57,210 --> 00:01:59,300
.أنا مختلف الآن

8
00:01:59,610 --> 00:02:02,810
!سوف أسحق يوكيهيرا مهما كلّف الأمر

9
00:02:02,810 --> 00:02:04,530
كيف يُبلي ميماساكا؟

10
00:02:04,530 --> 00:02:08,770
،يبدو أنّه خطّط لشيء ما
.لكنّني لست واثقًا

11
00:02:08,770 --> 00:02:11,060
أتساءل إن كان سيستعمل
.التّقليد المثاليّ" كعادته"

12
00:02:11,680 --> 00:02:13,370
!مهلاً! لقد أفزعتني

13
00:02:13,370 --> 00:02:14,770
ما الأمر يا إيبوساكي؟

14
00:02:14,770 --> 00:02:16,930
لا شيء، لكن يبدو كوغا-سينباي

15
00:02:16,930 --> 00:02:19,570
.وكأنّه سيستعمل الشّاي الأخضر حتّى

16
00:02:19,570 --> 00:02:20,890
.صحيح

17
00:02:20,890 --> 00:02:22,950
من جهة أخرى، تسوكاسا-سينباي

18
00:02:23,450 --> 00:02:25,370
!لديه أربع أنواع من أرواق الشّاي

19
00:02:25,370 --> 00:02:27,500
هل سيستعملها كلّها في طبقه؟

20
00:02:27,500 --> 00:02:30,960
،تعريف الشّاي الأخضر مفهوم واسع

21
00:02:30,960 --> 00:02:32,710
.وهنالك عدّة طرق لاستعماله

22
00:02:32,710 --> 00:02:36,550
تُطلق عبارة الشّاي الأخضر على أوراق
الشّاي غير المختمرة والمجفّفة مباشرة

23
00:02:36,550 --> 00:02:40,150
بمجرّد قطفها، ممّا يمنع
.الأنزيمات من أكسدتها

24
00:02:40,150 --> 00:02:45,310
ثمّة أنواع مختلفة مثل السّينتشا
،والغيوكورو والهوجيتشا والكابوستشا

25
00:02:45,310 --> 00:02:47,100
.وكلّ واحدة منها لديها طعمُها وعبقُها

26
00:02:47,100 --> 00:02:49,350
.لهذا السّبب هو صاحب الرّتبة الأولى

27
00:02:49,810 --> 00:02:52,450
.إنّه مدرك لما يفعله بالمكوّنات

28
00:02:54,250 --> 00:02:56,400
.والآن... تعالي إليّ

29
00:02:56,400 --> 00:02:58,860
.نعم... لا داعي للخوف

30
00:03:00,100 --> 00:03:01,820
.تعالي إليّ

31
00:03:02,350 --> 00:03:04,670
ننقع السّينتشا في الماء المغليّ
.لثلاثين ثانية

32
00:03:04,670 --> 00:03:07,710
سيُظهر ذلك مُركّب الكاتيشين
.الّذي هو مصدر طعمه المرّ

33
00:03:08,140 --> 00:03:11,210
يفتقر شاي الغِنمايتشا
.للطّعم المرّ والأومامي معًا

34
00:03:11,210 --> 00:03:13,740
لذلك ننقعه في ماء حرارته
‫90 درجة لثلاثين ثانية

35
00:03:13,740 --> 00:03:15,590
.لإظهار عبقه لأقصى الحدود

36
00:03:16,060 --> 00:03:18,950
يُنقع شاي فوكاموشي سينتشا
بسهولة لدرجة أنّه لا يحتاج

37
00:03:18,950 --> 00:03:21,290
إلاّ لأقلّ من دقيقة في مياه
.حرارتها 80 درجة

38
00:03:21,290 --> 00:03:24,090
أمّا شاي غيوكورو، فيُنقع في مياه
.حرارتها 60 درجة لدقيقتين

39
00:03:24,090 --> 00:03:27,350
تضمن الحرارة المنخفضة امتزاج
.مكوّنات الأومامي ببطء في الماء

40
00:03:27,350 --> 00:03:30,850
.إنّه يستعمل وعاء نامبو للشّاي لغليِ الماء

41
00:03:30,850 --> 00:03:33,810
إنّه يزيل النّكهة الحادّة للماء السّاخن
.ويعطيه طعمًا خفيفًا وناعمًا

42
00:03:33,810 --> 00:03:35,650
.هذا مذهل

43
00:03:35,650 --> 00:03:39,990
يستطيع الطّهاة الموهوبون بحقّ
.التّحكّم بالمكوّنات كما يشاؤون

44
00:03:39,990 --> 00:03:43,890
لكنّ تسوكاسا إيشي لديه كامل الاحترام

45
00:03:43,890 --> 00:03:46,620
.لعالم المكوّنات الغذائيّة

46
00:03:46,620 --> 00:03:48,740
.إنّه السّيف الّذي يحملونه

47
00:03:52,500 --> 00:03:53,740
ما هذا؟

48
00:03:53,740 --> 00:03:58,500
،إنّها أداة مطبخ تُعرف بالمِبشرة
.لكن لم أرَ واحدة بهذا الطّول قطّ

49
00:03:58,500 --> 00:04:00,510
...إنّها تشبه سيف فارس

50
00:04:01,510 --> 00:04:03,840
."فارس الطّاولة الأبيض"

51
00:04:09,220 --> 00:04:10,950
.تولّى أمر كلّ المكوّنات دفعة واحدة

52
00:04:10,950 --> 00:04:12,980
.يا لها من طريقية حركيّة لاستعمالها

53
00:04:12,980 --> 00:04:16,190
.تعامله مع الشّاي الأخضر فاق المثاليّة

54
00:04:16,190 --> 00:04:17,940
.لكنّ ذلك ليس كلّ شيء

55
00:04:18,390 --> 00:04:21,280
كيف لنا أن نتنافس ضدّ ذلك؟

56
00:04:21,280 --> 00:04:25,250
يبدو أنّك كنتَ تركّز على تلك
.الووك طوال هذا الوقت

57
00:04:25,250 --> 00:04:26,660
هل أنت بخير يا كوغا؟

58
00:04:28,120 --> 00:04:32,080
الشّعور بأنّك محاصر في مجالك
.الخاصّ قد يكون عادة سيّئة

59
00:04:32,080 --> 00:04:34,650
هوسك بشيء واحد قد يُبعدك

60
00:04:34,650 --> 00:04:37,040
عن الوصول لمستويات أسمى
.فيما يتعلّق بالنّكهات

61
00:04:37,350 --> 00:04:40,000
.لا تظنّ أنّني لا أعترف بشغفك بكلامي هذا

62
00:04:40,000 --> 00:04:41,380
،لكن عليّ قول هذا

63
00:04:41,380 --> 00:04:45,220
لا أعتقد أنّك ستكون قادرًا
.على هزيمتي أبدًا إن لم تتغيّر

64
00:04:45,690 --> 00:04:47,300
.لا أدري حيال ذلك

65
00:04:55,290 --> 00:04:59,270
مسموح لنا مساعدة أعضاء
.فريقنا في التّجهيزات

66
00:04:59,270 --> 00:05:02,230
تلك إحدى القواعد في شوكوغيكي الفِرق، صحيح؟

67
00:05:02,230 --> 00:05:04,190
.أحسنت يا ميماساكا-تشين

68
00:05:04,190 --> 00:05:06,900
.ها قد أظهر كوغا-سينباي أوراق شايه

69
00:05:06,900 --> 00:05:10,160
لا بدّ أنّه كان ينتظر ميماساكا-كُن
!لينتهي من ذلك

70
00:05:10,160 --> 00:05:12,070
استعمل ميماساكا تقليده

71
00:05:12,070 --> 00:05:14,620
.على كوغا-سينباي، رغم أنّه حليفه

72
00:05:14,620 --> 00:05:18,410
لهذا السّبب كان قادرًا على دعمه
!في الوقت المناسب

73
00:05:18,410 --> 00:05:21,840
!أحسنت أيّها المقلّد المثاليّ ميماساكا سوبارو

74
00:05:22,170 --> 00:05:23,850
!أجل، أجل، أجل

75
00:05:23,850 --> 00:05:28,930
.اليوم هو اليوم الّذي سأهزم فيه تسوكاسا

76
00:05:28,930 --> 00:05:30,930
.نعم، توقّف عن ذلك رجاءً

77
00:05:32,230 --> 00:05:34,270
!لكنّك أبليتَ حسنًا يا ميماساكا-تشين

78
00:05:34,810 --> 00:05:38,400
!بدأ كوغا تيرونوري بالطّهو للتّوّ

79
00:05:38,400 --> 00:05:39,790
ما هذا؟

80
00:05:39,790 --> 00:05:43,570
ورق ألمنيوم وشبكة شيّ في مقلاة ووك؟

81
00:05:43,570 --> 00:05:45,280
.تلك أداة تدخين مرتجلة

82
00:05:45,280 --> 00:05:46,820
تدخين؟

83
00:05:46,820 --> 00:05:51,080
نعم. هدف كوغا-سينباي هو تدخين
.اللّحم باستعمال أوراق الشّاي

84
00:05:51,080 --> 00:05:54,080
!هذا مدهش

85
00:05:54,080 --> 00:05:55,680
،حتّى هذه السّاعة

86
00:05:55,680 --> 00:06:00,790
كان يقلي كلّ جوانب قطعة لحم
.كتف الخنزير جيّدًا في مقلاة الووك

87
00:06:00,790 --> 00:06:02,710
إنّ حقيقة أنّه يقوم بتدخين اللّحم

88
00:06:02,710 --> 00:06:06,260
بدل طبخه بعد أن قلاه مثيرة
!للاهتمام بالفعل

89
00:06:06,260 --> 00:06:09,050
بتدخينه للّحم، فهو قادر على إدماج

90
00:06:09,050 --> 00:06:11,330
.عبق أوراق الشّاي مباشرة له

91
00:06:11,740 --> 00:06:15,930
إنّه يستعمل طريقة مختلفة في التّعامل
.مع أوراق الشّاي من تسوكاسا إيشي

92
00:06:17,230 --> 00:06:20,400
.لم أعلم أبدًا أنّه بإمكاننا فعهل ذلك بالووك

93
00:06:20,400 --> 00:06:21,930
.ربّما سأجرّب ذلك لاحقًا

94
00:06:22,820 --> 00:06:25,400
لكن ما الّذي سيفعله بذلك السّائل الأسود؟

95
00:06:25,400 --> 00:06:28,950
أوشك على استعماله الآن
.يا يوكيهيرا-تشين

96
00:06:29,300 --> 00:06:32,780
بينما يُدخّن اللّحم، سأذهب مباشرة
.لإعداد ما أنا خبير به، الصّلصة

97
00:06:33,280 --> 00:06:36,890
خفّفت بعضًا من خلّ البلسميك
.إلى أن تتكثّف نكهته وعبقه

98
00:06:36,890 --> 00:06:39,750
ثمّ سأضيف الخلّ الأسود والسّكّر
.ومسحوق الشّاي الأخضر

99
00:06:39,750 --> 00:06:43,460
وفوق كلّ ذلك، سأضيف صلصة
!الصّويا المدخّنة هذه

100
00:06:43,460 --> 00:06:45,020
صلصة صويا مدخّنة؟

101
00:06:45,020 --> 00:06:47,840
.نعم، ذلك هو ذاك السّائل

102
00:06:47,840 --> 00:06:50,680
.كان ميماساكا يُدخّن ذلك طوال الوقت

103
00:06:51,130 --> 00:06:57,680
تجعل صلصة الصّويا المدخّنة عبقها
.بارزًا أكثر وتمنحها مذاقًا مركّبًا

104
00:06:58,030 --> 00:06:59,440
.إنّها رائحة مذهلة بالفعل

105
00:06:59,810 --> 00:07:03,770
إضافة عنصر التّدخين للصّلصة
،وليس للّحم فحسب

106
00:07:03,770 --> 00:07:05,320
.سيُعزّز تناغم الطّبق

107
00:07:05,320 --> 00:07:07,480
.هذه فكرة منعشة بالفعل

108
00:07:07,480 --> 00:07:09,990
.عمل فريق ممتاز

109
00:07:11,340 --> 00:07:13,350
بشكل عامّ، يبدو أنّ تسوكاسا-سينباي

110
00:07:13,350 --> 00:07:16,790
.مضطرّ لمواجهة طاهيين الآن

111
00:07:17,740 --> 00:07:19,690
.يا كوغا

112
00:07:19,690 --> 00:07:23,080
ألم تكن تريد مواجهة تسوكاسا رجلاً لرجل؟

113
00:07:23,590 --> 00:07:24,540
.اخرس

114
00:07:25,530 --> 00:07:28,050
!أنا شخص بالغ رغم مظهري

115
00:07:28,050 --> 00:07:31,090
لن أسمح لفخري السّخيف
.بالوقوف في طريقي

116
00:07:31,760 --> 00:07:38,040
وظيفتي الآن هي الحرص على أن أهزمك
.شرّ هزيمة يا تسوكاسا-سان

117
00:07:38,040 --> 00:07:41,270
،فهمت. أرى أنّك اخترت الفوز
.وإن كان في ذلك تخلٍّ عن فخرك

118
00:07:41,650 --> 00:07:45,020
.تبدو مختلفًا قليلاً بالفعل يا كوغا

119
00:07:45,020 --> 00:07:50,690
.سوف أنهي سلسلة انتصارات ها هنا

120
00:07:54,140 --> 00:07:58,120
لكن هل ميماساكا سوبارو قادر
على القيام بتجهيزاته أيضًا؟

121
00:07:58,730 --> 00:08:02,210
ليس لديه وقت كافٍ أو تركيز كافٍ
.ليواصل دعم الآخرين

122
00:08:02,210 --> 00:08:05,100
.أنت محقّ تمامًا

123
00:08:05,100 --> 00:08:08,340
.إنّه يواجه خصمًا جديرًا هو الآخر

124
00:08:08,340 --> 00:08:10,420
صاحب الرّتبة الرّابعة
،في النّخبة العشرة حاليًّا

125
00:08:10,420 --> 00:08:16,510
،وأعظم طاهي سوشي في جيله
.سايتو سومي

126
00:08:16,510 --> 00:08:18,600
!طا-طا-طاهي سوشي؟

127
00:08:18,600 --> 00:08:23,560
سحب ميماساكا بطاقة تونا
!ضدّ طاهي سوشي؟

128
00:08:23,560 --> 00:08:28,400
إنّه ملك النّحس! لدى ميماساكا حظّ
!أسوأ حتّى من يوكيهيرا

129
00:08:28,790 --> 00:08:31,610
.أنا لست غير محظوظ

130
00:08:31,950 --> 00:08:33,360
.لكن انظروا هناك

131
00:08:33,360 --> 00:08:37,950
يبدو ميماساكا وكأنّه يخفي
.شيئًا في جعبته

132
00:08:37,950 --> 00:08:40,700
.أنت رجل غير محظوظ بالفعل

133
00:08:41,380 --> 00:08:43,040
.لكنّ سيكون من غير المهذّب أن أرحمك

134
00:08:43,490 --> 00:08:47,750
،عندما أقف أمام لوح تقطيع
!فأنا أبذل قصارى جهدي

135
00:08:51,860 --> 00:08:54,380
.قطّع تلك لتّون لشرائح في لمح البصر

136
00:08:57,340 --> 00:08:59,040
.القوّة والتّقنية

137
00:08:59,040 --> 00:09:01,100
هذه هي قوّة أصحاب المراتب
.العليا في النّخبة العشرة

138
00:09:12,470 --> 00:09:15,060
.يوشك ميماساكا أن ينتهي من التّقطيع أيضًا

139
00:09:16,150 --> 00:09:16,990
!وميض

140
00:09:24,000 --> 00:09:25,480
!ما الّذي يحدث؟

141
00:09:25,480 --> 00:09:29,330
إنّه ينسخ بكلّ مثاليّة الطّبق
!الآخر دون أيّ تأخير

142
00:09:31,380 --> 00:09:33,840
!وميض التّقليد المثاليّ

143
00:09:34,830 --> 00:09:36,460
،بسرعة وميض الكاميرات

144
00:09:36,460 --> 00:09:39,510
،فأنا أتلقّى وأحلّل حركات خصمي على الفور

145
00:09:39,510 --> 00:09:44,060
.وأجعل جسدي يحاكي كلّ خطوة بحذافيرها

146
00:09:44,060 --> 00:09:47,460
هكذا إذًا. بتلك الطّريقة، بإمكانه
التّقليل من التّفكير

147
00:09:47,460 --> 00:09:49,770
.والحاجة في إنشاء طبق من الصّفر

148
00:09:49,770 --> 00:09:53,760
استعمل كلّ الوقت الّذي احتاجه
خصمه للتّفكير في طبقه

149
00:09:53,760 --> 00:09:58,240
في دعم كوغا تيرونوري عن طريق
.إعداد صلصة الصّويا المدخّنة

150
00:09:58,240 --> 00:10:00,100
!إنّه الوميض بالفعل

151
00:10:00,100 --> 00:10:03,100
هذا لا يشبه تقليد ميماساكا-كُن
!العاديّ على الإطلاق

152
00:10:06,500 --> 00:10:07,330
!مذهل

153
00:10:07,330 --> 00:10:10,170
.يا إلهي. إنّه شخص واعد

154
00:10:10,170 --> 00:10:13,050
!عرفتُ أنّك ستكون أهلاً لها يا ميماساكا

155
00:10:13,540 --> 00:10:15,510
...والآن، أرهم

156
00:10:15,510 --> 00:10:19,020
أرهم كيف يعمل المتمرّدين
!معًا جيّدًا وبقوّة

157
00:10:21,050 --> 00:10:26,270
.سيشّا" اسمي سايتو سومي"
.أنا أسير في درب فنّ الطّبخ

158
00:10:26,690 --> 00:10:29,650
يتعلّم المرء فنون المبارزة
.عن طريق التّقليد

159
00:10:29,650 --> 00:10:33,020
.مهاراتك ممتازة

160
00:10:33,020 --> 00:10:37,690
ورغم أنّني أمارس البوشيدو، إلاّ أنني
.لا أستعمل "سيشّا" للإشارة لنفسي

161
00:10:37,690 --> 00:10:39,190
.بل تفعل ذلك

162
00:10:39,190 --> 00:10:40,280
.ذلك صحيح

163
00:10:40,280 --> 00:10:41,360
.نعم

164
00:10:41,360 --> 00:10:41,990
.بل تستعملها

165
00:10:41,990 --> 00:10:43,180
.بالفعل

166
00:10:43,180 --> 00:10:44,450
!ليس أنت أيضًا

167
00:10:45,410 --> 00:10:48,170
.حسنًا، لحظة رجاءً

168
00:10:51,910 --> 00:10:53,630
.لقد قطّع بقيّتها

169
00:10:57,060 --> 00:10:58,010
.استعمله

170
00:10:58,360 --> 00:11:01,100
.إنّ سكّينك ليست جيّدة كفاية

171
00:11:01,100 --> 00:11:02,970
.سوف تكسر سكّينك

172
00:11:02,970 --> 00:11:08,850
،إن لم تستعمل سيفي إيساناغيري العزيز
.فستعارض بذلك البوشيدو خاصّتي

173
00:11:08,850 --> 00:11:10,230
!البوشيدو؟

174
00:11:10,230 --> 00:11:11,940
!ها قد بدأ ثانية

175
00:11:11,940 --> 00:11:15,020
.بدأت عادة سايتو المزعجة تظهر

176
00:11:15,020 --> 00:11:15,650
عادة؟

177
00:11:16,310 --> 00:11:20,170
إنّه لا يفكّر إلاّ في البوشيدو لدرجة
.أنّه سيجبرك على اتّباعها أيضًا

178
00:11:20,170 --> 00:11:21,570
لا يفكّر إلاّ في البوشيدو؟

179
00:11:21,570 --> 00:11:23,370
.أشكرك

180
00:11:23,370 --> 00:11:28,040
أمسى الآن التّقليد الّذي أستعملهُ
!سيشّا" أقرب للمثاليّة"

181
00:11:32,790 --> 00:11:37,000
،بما أنّ كلانا انتهى من التّقطيع
.ستبدأ المعركة الحقيقيّة

182
00:11:37,310 --> 00:11:38,490
!اتبعني

183
00:11:38,490 --> 00:11:39,340
!بالطّبع

184
00:11:39,340 --> 00:11:40,550
!وميض

185
00:11:40,550 --> 00:11:45,550
سأضع الأكامي في منقوع الميرين
.وصلصة الصّويا والنّبيذ الأحمر

186
00:11:45,950 --> 00:11:47,140
!وميض

187
00:11:47,140 --> 00:11:51,480
سأسفع جانبًا واحدًا من خدّيْ التّونا
!في الزّبدة لتعزيز عبقها

188
00:11:51,480 --> 00:11:55,780
مهلاً، إنّه يعدّ كلّ جزء من السّمكة
بطريقة مختلفة تمامًا؟

189
00:11:55,780 --> 00:11:57,770
أيّ نوع من السّوشي يحاول إعداده؟

190
00:11:57,770 --> 00:11:58,780
!وميض

191
00:12:00,090 --> 00:12:00,860
...ذلك

192
00:12:00,860 --> 00:12:02,780
قشّ؟ لماذا القشّ؟

193
00:12:03,090 --> 00:12:03,740
...تلك

194
00:12:03,740 --> 00:12:04,860
!مشواة سيتشيرين

195
00:12:04,860 --> 00:12:07,860
!لقد أشعلا النّار فيها وبدآ بشيّ اللّحم

196
00:12:07,860 --> 00:12:13,000
إنّ ميماساكا يقوم بكلّ ما يحتاجه
.ليفوز تمامًا مثل كوغا-سينباي

197
00:12:20,590 --> 00:12:22,860
لا أصدّق أنّ القيام بالتدريبات تقليد

198
00:12:22,860 --> 00:12:25,430
.كلّ واحد منهم سيُتعبني لهذه الدّرجة

199
00:12:25,430 --> 00:12:26,390
...لكن

200
00:12:26,390 --> 00:12:27,850
!لن أخسر في المرّة القادمة

201
00:12:28,330 --> 00:12:30,310
.هذا ما يعنيه أن يكون طاهيًا

202
00:12:30,700 --> 00:12:34,730
...تاكومي ألديني ويوكيهيرا سوما أيضًا

203
00:12:35,580 --> 00:12:40,110
إنّني ما أزال واقفًا في المطبخ
.حتّى الآن بفشلهما هما

204
00:12:40,110 --> 00:12:42,440
...ولكي أردّ لهما الجميل

205
00:12:43,830 --> 00:12:46,270
.سيشّا" اسمي سايتو سومي"

206
00:12:46,270 --> 00:12:48,370
إنّ معرفة الطّريق المستقيم دون
.السّير فيه تجعل من المرء جبانًا

207
00:12:48,370 --> 00:12:49,950
!أجل، أجل

208
00:12:49,950 --> 00:12:53,210
أنا ريندو-سينباي! هل سمعتموني؟
!أنا ريندو-سينباي

209
00:12:53,210 --> 00:12:58,170
.أنا أقدّم كلّ ما لديّ لطعام الذّوّاقة
.ذلك هو طبخ تسوكاسا إيشي

210
00:12:58,170 --> 00:13:01,000
.سوف أسحقك يا يوكيهيرا

211
00:13:01,000 --> 00:13:04,650
.أخبرني يا بوتشي، لنتبنّى قطًّا

212
00:13:04,650 --> 00:13:07,090
.بوتشي ظريف جدًّا، مياو-مياو

213
00:13:07,090 --> 00:13:08,050
.مت

214
00:13:08,050 --> 00:13:10,440
.لا-لا تسئ فهم الأمر

215
00:13:10,440 --> 00:13:13,050
.أنا لم أقم بهذا من أجلك

216
00:13:13,050 --> 00:13:16,030
!مـ-من تصفها بالظّريفة؟ غبيّ

217
00:13:16,030 --> 00:13:19,790
!أعمق... سأقلّدهم بشكل أعمق

218
00:13:19,790 --> 00:13:21,650
...أكثر فأكثر

219
00:13:23,870 --> 00:13:26,450
!حان الآن وقت التّرتيب

220
00:13:30,240 --> 00:13:31,990
.أعتذر على جعلكم تنتظرون

221
00:13:31,990 --> 00:13:34,370
،جهّزا كلّ شيء بنفس الطّريقة

222
00:13:34,370 --> 00:13:37,120
لكنّ سايتو-سينباي انتهى أوّلاً؟

223
00:13:37,120 --> 00:13:39,130
.يبدو الطّبق جميلاً بشكل لا يُصدّق

224
00:13:39,130 --> 00:13:41,430
ثمّة العديد من التّدرّجات المختلفة تمامًا

225
00:13:41,430 --> 00:13:43,000
.من اللّون الأحمر المشعّ على الطّبق

226
00:13:43,000 --> 00:13:44,010
...يا لجماله

227
00:13:44,010 --> 00:13:48,980
إنّها أصغر حجمًا حتّى من التّيماري سوشي
.الّذي أعددتُه في انتخابات الخريف

228
00:13:48,980 --> 00:13:50,350
!ظريفة جدًّا

229
00:13:50,660 --> 00:13:53,430
!عشر ياقوتات ماغورو-سوشي بحجم صغير

230
00:13:53,430 --> 00:13:56,390
.والآن، استمتعوا بأكلها

231
00:13:56,390 --> 00:14:01,230
هذا هو الماغورو سوشي المعدّ من
.أفضل طاهي سوشي في توتسكي

232
00:14:01,230 --> 00:14:05,250
يُقال أنّه في كيوتو، يوجد سوشي
صغير الحجم تستطيع المايكو أكله

233
00:14:05,250 --> 00:14:08,200
.دون تلطيخ مكياجهنّ

234
00:14:08,200 --> 00:14:12,530
.طبق يجسّد جمال اليابان بحقّ

235
00:14:12,530 --> 00:14:15,610
.تبدأ "ماغورو" بـ"ما"، لذلك فهي كلمة ظريفة

236
00:14:15,610 --> 00:14:16,500
.ربّما

237
00:14:16,500 --> 00:14:18,710
.أعتذر أيضًا على الانتظار

238
00:14:19,750 --> 00:14:21,170
!التّقليد المثاليّ

239
00:14:21,170 --> 00:14:24,750
!إنّهما متشابهان
!السّوشي خاصّتهما متشابه تمامًا

240
00:14:24,750 --> 00:14:28,420
!لا، مهلاً! ثمّة واحد مختلف تمامًا

241
00:14:28,420 --> 00:14:29,380
!معك حقّ

242
00:14:29,800 --> 00:14:33,100
ثمّة سوشي غونكامانكي
!لا يملكه سايتو-سينباي

243
00:14:33,100 --> 00:14:36,030
ذلك هو التّرتيب الّذي قرّر ميماساكا
.دخول المعركة به

244
00:14:36,030 --> 00:14:37,430
.هناك يختلف ذوقهما

245
00:14:38,890 --> 00:14:41,350
!أقفلوا أفواهكم

246
00:14:41,350 --> 00:14:44,690
!وكأنّ لديه فرصة أمام سايتو-سينباي

247
00:14:45,980 --> 00:14:48,650
!مهارات طُهاة السّوشي الحقيقيّ لا تُضاهى

248
00:14:49,080 --> 00:14:51,660
يوم واحد لا يكفي للمسير
في الطّريق الوعر

249
00:14:51,660 --> 00:14:53,830
!الّذي ساروا فيه ليصبحوا ما هم عليه

250
00:14:53,830 --> 00:14:58,620
من المستحيل لوغد مُقلِّد أن يستطيع
!إعداد طبق سوشي جيّد بالفعل

251
00:14:58,960 --> 00:15:01,080
.جرّبي واحدة إذًا

252
00:15:02,850 --> 00:15:05,000
.استمتعي بأكلها

253
00:15:07,300 --> 00:15:09,840
!أرني أفضل ما لديك

254
00:15:16,430 --> 00:15:19,510
!يا لهما من نشوة

255
00:15:19,510 --> 00:15:21,350
مهلاً، مهلاً؟

256
00:15:26,520 --> 00:15:31,490
ذلك الوغد قد أظهر بكلّ مثاليّة
.النّكهة الكاملة لكلّ جزء من التّونا

257
00:15:31,490 --> 00:15:34,740
!وهذا الأرزّ... ليس مجرّد أرزّ سوشي عادي

258
00:15:34,740 --> 00:15:38,560
.صحيح. استعملت الخلّ الأحمر

259
00:15:38,560 --> 00:15:42,480
يُعدّ الخلّ الأحمر من بقايا السّاكي
.الّتي عُتّقت فترة طويلة من الزّمن

260
00:15:42,480 --> 00:15:45,460
إنّه خلّ رفيع المستوى يتطلّب بين
.خمس سنوات أو ستّة لتحضيره

261
00:15:45,460 --> 00:15:47,380
أليس كذلك يا سينباي؟

262
00:15:47,380 --> 00:15:48,210
.بالفعل

263
00:15:48,210 --> 00:15:52,250
بسبب احتوائه على معدّل منخفض
،من السّكّر ونكهة خفيفة

264
00:15:52,250 --> 00:15:54,930
.يصبح الأرزّ منفوخًا أكثر وأنعم

265
00:15:55,260 --> 00:15:59,100
لكنّ ذلك أيضًا يجعل من الصّعب
تقوية تناغم النّكهات

266
00:15:59,100 --> 00:16:01,020
.بين الأرزّ الإضافات، لذلك يتطلّب عناية أكبر

267
00:16:01,020 --> 00:16:05,480
هل استطاع ميماساكا فعلاً
تقليده لذلك الحدّ؟

268
00:16:05,480 --> 00:16:07,190
!سُحقًا

269
00:16:07,190 --> 00:16:11,650
يُحزنني قول أنّ النّكهة في نفس مستوى
!مهارات الأعضاء الأوائل في النّخبة العشرة

270
00:16:13,110 --> 00:16:15,660
إنّ شغفه الّذي يتألّق كالياقوت

271
00:16:15,660 --> 00:16:18,080
...وسط حِرَفيّةٍ حذرةٍ حذرَ أفعى

272
00:16:19,810 --> 00:16:22,790
!حرارة جسدي مرتفعة
!أشعر وكأنّني سأحترق

273
00:16:22,790 --> 00:16:27,250
طوال هذا الوقت، تجنّبت
...إظهار ردّات فعلي

274
00:16:27,250 --> 00:16:31,920
!لا! لا! لا أستطيع

275
00:16:32,360 --> 00:16:36,800
...لن أتمكّن من الزّواج الآن

276
00:16:38,760 --> 00:16:43,350
أعتقد أنّك انعطفتِ خارج دورك
.بما يكفي أيّتها المعلّقة الظّريفة

277
00:16:43,350 --> 00:16:46,980
.أفضل السّوشي هو الّذي يقدّم طازجًا

278
00:16:46,980 --> 00:16:48,060
...لذلك سوف

279
00:16:48,060 --> 00:16:49,820
!مهلاً لحظة

280
00:16:49,820 --> 00:16:53,220
!ريندو-سينباي قادمة

281
00:16:55,550 --> 00:16:59,500
.أفضّل أن تتناولوا طبقي قبل أن يبرد أيضًا

282
00:16:59,500 --> 00:17:00,450
ماذا؟

283
00:17:00,450 --> 00:17:02,660
!الوجبة مغطّاة بالفلفل الحارّ

284
00:17:02,660 --> 00:17:07,040
.أسمّيه لازيجي تمساح الكايمن

285
00:17:07,040 --> 00:17:08,890
.انتهيتُ أيضًا

286
00:17:08,890 --> 00:17:10,700
!ها هو ذا الرّامن الإفريقيّ

287
00:17:10,700 --> 00:17:13,420
.لا يبدو رامن ميغيشيما-سينباي أحمرًا

288
00:17:13,420 --> 00:17:15,620
أين هو كلّ ذلك الفلفل الحارّ؟

289
00:17:15,620 --> 00:17:19,220
!إذًا لنجرّب كلّ الأطباق معًا

290
00:17:19,220 --> 00:17:21,310
كـ-كلّها معًا؟

291
00:17:21,310 --> 00:17:23,120
.سوف تختلط النّكهات بين بعضها

292
00:17:23,120 --> 00:17:24,680
هل ذلك ممكن من الأساس؟

293
00:17:24,680 --> 00:17:26,380
!بالطّبع ممكن

294
00:17:26,380 --> 00:17:31,610
."نحن حرّاس طعام الذّوّاقة، رجال كتاب "م ذ ع

295
00:17:31,610 --> 00:17:34,570
!لتبدأ المشاورات

296
00:17:36,050 --> 00:17:38,620
.سأبدأ بقطعة السّوشي الجميلة هذه

297
00:17:40,080 --> 00:17:43,200
.لا بدّ أنّ هذا المعجون الأحمر هو الفلفل الحارّ

298
00:17:49,610 --> 00:17:52,840
تؤثّر الطّاقة من المكوّنات على
!أفواهنا كأنّها وابل من الصّواريخ

299
00:17:59,350 --> 00:18:02,350
!سنتلقّى كلّ صاروخ بصدر رحب

300
00:18:02,350 --> 00:18:03,650
!أجل

301
00:18:03,650 --> 00:18:05,730
!ردّة فعل من كامل الجسد

302
00:18:07,350 --> 00:18:09,590
!سوشي كِلا الطّاهيين لا نظير له

303
00:18:09,590 --> 00:18:15,400
أكثر القطع خطورة هي النّوتن
!سوشي المشويّ على القشّ

304
00:18:15,400 --> 00:18:16,670
نوتن؟

305
00:18:16,670 --> 00:18:19,810
،إنّها قطعة اللّحم من قمّة رأس التّونا

306
00:18:19,810 --> 00:18:22,240
.وهي أيضًا أثمن قطعة فيها

307
00:18:22,240 --> 00:18:25,690
احترقت كلّ رائحة السّمك
،عندما تمّ شيّه بالقشّ

308
00:18:25,690 --> 00:18:28,210
.تاركًا خلفه نكهة خالصة فاتحة للشّهيّة

309
00:18:28,210 --> 00:18:30,070
!التّقليد لا غبار عليه

310
00:18:30,070 --> 00:18:33,170
.إذًا فستحسم قطعة الغونكان المعركة

311
00:18:33,820 --> 00:18:36,050
.هنالك ميرانغ فوق قطعة النّغيتورو هذه

312
00:18:36,580 --> 00:18:38,760
...العبق الأخّاذ لصلصة الصّويا المخمّرة

313
00:18:38,760 --> 00:18:41,680
لقد دعم فريقه واستعمله
...في إعداد طبقه أيضًا

314
00:18:41,680 --> 00:18:43,680
.أخذ الأمرين في حسبانه

315
00:18:43,680 --> 00:18:46,040
...العبق الخفيف لصلصة الصّويا المخمّرة

316
00:18:46,040 --> 00:18:50,900
إنّه يُظهر التّباين في القوام بين
!الميرانغ والنّغيتورو أكثر فأكثر

317
00:18:50,900 --> 00:18:54,770
هذه بكلّ تأكيد قطعة الغونكان سوشي
!بالبيض فوق الأرزّ مع النّغيتورو الفضلى

318
00:18:55,990 --> 00:18:57,740
ماذا عن رامن ميغيشيما-سينباي؟

319
00:18:58,270 --> 00:18:59,700
.هذه هريسة

320
00:19:00,020 --> 00:19:03,430
إنّه مزيج تتبيل قيل أنّ أصله
.هو شمال إفريقيا

321
00:19:03,870 --> 00:19:06,650
المكوّنات الّتي تضمّها هي الفلفل
الأحمر وبذور الكروياء

322
00:19:06,650 --> 00:19:10,070
وعصير اللّيمون والثّوم والكثير
.من الفلفل الحارّ

323
00:19:10,070 --> 00:19:13,670
.ثمّ تُمزج جميعها حتّى تصبح معجونًا

324
00:19:13,670 --> 00:19:17,250
الهريسة هي المعجون الّذي
.أعدّه أبي عند زيارته للمسكن

325
00:19:17,250 --> 00:19:19,550
.أعتقد أنّه سبق ذكر شيئًا إفريقيا

326
00:19:19,550 --> 00:19:22,340
،حساء الرّامن مبنيّ على موامبا الدّجاج

327
00:19:22,340 --> 00:19:27,130
،وهو حساء دجاج إفريقيّ
.مع المكسّرات والطّماطم

328
00:19:27,130 --> 00:19:29,810
إنّها العنصر المثاليّ لتعزيز الطّعم
.الحارّ للهريسة الحارّة

329
00:19:32,010 --> 00:19:36,550
قطع سميكة جدًّا من تشار سيو لحم الخنزير
...بزبدة فستق منزليّة قبل طبخها ببطء

330
00:19:36,550 --> 00:19:39,440
كما تشرّبت المعكرونة الحساء
.والطّعم الحارّ من الهريسة

331
00:19:39,440 --> 00:19:40,320
!لا يمكنني التّوقّف عن الأكل

332
00:19:42,730 --> 00:19:46,270
إنّ لذّته تجعل جسدي يستنجد
!من كثرة الحرارة

333
00:19:46,270 --> 00:19:47,580
...يا للنّشوة

334
00:19:48,890 --> 00:19:51,030
!الرّامن الإفريقيّ طبق ناجح أيضًا

335
00:19:51,030 --> 00:19:54,120
!أجل! أنت لها

336
00:19:54,120 --> 00:19:58,030
سنطيح بأصحاب المراتب العليا
!في النّخبة العشرة دفعة واحدة

337
00:20:00,550 --> 00:20:04,090
.هذه هي نتائج المبارتين الثّانية والثّالثة

338
00:20:05,700 --> 00:20:07,990
ما رأيكم أيّها المتمرّدون الحثالة؟

339
00:20:07,990 --> 00:20:11,140
!لا فرصة أمامكم ضدّ النّخبة العشرة

340
00:20:13,520 --> 00:20:17,770
!لماذا؟! التّرتيب في ذلك الغونكان كان مثاليًّا

341
00:20:17,770 --> 00:20:20,490
.لم يكن الغونكانماكي هو عامل الحسم

342
00:20:20,490 --> 00:20:21,820
.بل كان التّقطيع الخفيّ

343
00:20:21,820 --> 00:20:25,660
!قلّدتُ التّقطيع الخفيّ وأدرجتُه فيها بنفسي

344
00:20:26,130 --> 00:20:29,980
،إنّ إضافة تقطيعات إلى اللّحم
،تجعل التّونا تذوب في الفم

345
00:20:29,980 --> 00:20:33,540
.وتنشر النّكهة في كلّ مكان

346
00:20:33,540 --> 00:20:36,920
.نعم. كان تقليدك ممتازًا

347
00:20:37,300 --> 00:20:40,510
لكن ما أعددناك كان خرزات ياقوت
.مصغّرة من السّوشي صغير الحجم

348
00:20:41,210 --> 00:20:43,340
.اكتشفتَ الأمر إذًا

349
00:20:43,340 --> 00:20:47,300
.لقد أضفتَ تقطيعًا خفيًّا أكثر من اللاّزم

350
00:20:47,300 --> 00:20:50,730
إذا ما أضفنا نفس كمّيّة التّقطيع
،الّذي نحتاجها في السّوشي العاديّ

351
00:20:50,730 --> 00:20:53,430
.فستذوب التّونا بسرعة كبيرة

352
00:20:53,430 --> 00:20:55,690
،ولكي تظلّ النّكهة في الفم وقتًا أطول

353
00:20:55,690 --> 00:20:58,820
.من الضّروريّ استعمال تقطيع خفيّ أقلّ

354
00:20:59,240 --> 00:21:03,030
يبدو وكأنّك لم تكن قادرًا على
.تقليد التّفاصيل الصّغيرة

355
00:21:04,010 --> 00:21:09,870
.لا حاجة لتلوم نفسك
.ما هذا إلاّ فرق بين خبراتنا

356
00:21:09,870 --> 00:21:13,800
لـ-لكن ماذا عن رامن ميغيشيما-سينباي؟

357
00:21:13,800 --> 00:21:15,330
!لقد أثنيتم عليه كثيرًا

358
00:21:15,330 --> 00:21:18,560
.كان الرّامن الإفريقيّ مذهلاً بالفعل

359
00:21:18,560 --> 00:21:22,400
.لكنّ طبق كوباياشي ريندو قد تفوّق عليه

360
00:21:22,400 --> 00:21:24,780
،باستعمالها لطريقة لازيجي

361
00:21:24,780 --> 00:21:29,760
استطاعت دفع لحم التّمساح الخفيف
.ليدخل عالم نكهات عبقة وغنيّة

362
00:21:39,470 --> 00:21:40,940
!آسف يا ميغيشيما

363
00:21:40,940 --> 00:21:44,250
.يبدو أنّني فزت بهذه الجولة

364
00:21:44,250 --> 00:21:46,290
.تبقى المنافسةُ منافسة

365
00:21:46,290 --> 00:21:47,650
.لستُ نادمًا على شيء

366
00:21:47,650 --> 00:21:50,570
...لا تقلق. ما زال لدينا

367
00:21:50,570 --> 00:21:52,410
!هذا صحيح

368
00:21:52,410 --> 00:21:55,580
هل يُمكنكم ألاّ تُنهوا الأمور
قبل حتّى أن تبدأ؟

369
00:21:55,580 --> 00:21:59,460
،ما زلتُ أنا كوغا تيرونوري
!لم أقدّم طبقي بعد

370
00:23:35,710 --> 00:23:38,110
...إن تحمّلنا المزيد من المحفّزات