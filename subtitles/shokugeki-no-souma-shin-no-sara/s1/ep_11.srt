1
00:00:02,980 --> 00:00:04,850
.ما كان طبقك ليفوز

2
00:00:04,850 --> 00:00:06,670
،لكي نهزم سينباي

3
00:00:06,670 --> 00:00:10,480
علينا مواجهته باختصاصين نعدّهما
.بكلّ ما لدينا

4
00:00:10,480 --> 00:00:13,860
.على وجبتنا أن تكون بذلك المستوى

5
00:00:14,230 --> 00:00:16,880
،إن لم تهزمي طبقي
.فسنخسر هذه المباراة

6
00:00:16,880 --> 00:00:21,080
.باختصار، هذا شوكوغيكي بيني وبينك

7
00:00:24,210 --> 00:00:26,580
ما الّذي قاله يوكيهيرا للتوّ؟

8
00:00:26,580 --> 00:00:28,380
...هذه الوجبة

9
00:00:28,380 --> 00:00:29,420
...عبارة عن

10
00:00:29,970 --> 00:00:31,920
!شوكوغيكي بينهما؟

11
00:00:31,920 --> 00:00:33,810
.يا لها من فكرة لا تُعقل

12
00:00:33,810 --> 00:00:37,640
لا أصدّق أنّه ينوي إكمال
...وجبتهما بتحدّي شوكوغيكي

13
00:00:37,640 --> 00:00:42,870
بالتّفكير في الأمر، هل تملك إريناتشي
طبقًا مميّزًا يمثّل اختصاصها؟

14
00:00:42,870 --> 00:00:47,020
إنّها تملك الموهبة لجعل أيّ نوع
.من الطّبخ يبدو كطبق احترافيّ

15
00:00:47,020 --> 00:00:50,650
.سمعتُ أنّها تحدّت سينزايمون-ساما مرّات عدّة

16
00:00:50,650 --> 00:00:53,780
لكن يبدو أنّه لم يعترف
.بأيّ طبق من أطباقها بعد

17
00:00:53,780 --> 00:00:56,990
...لا أصدّق هذا. إنّ إرينا-ساما

18
00:00:56,990 --> 00:01:00,130
بصراحة... كنتُ أتساءل
.ما الّذي قد تتفوّه به

19
00:01:00,130 --> 00:01:01,740
.لكن لا أصدّق أنّك ذكرت الشّوكوغيكي

20
00:01:01,740 --> 00:01:05,830
"أعتقد أنّ عبارة "العمل كفريق
.لا توجد في قاموسك

21
00:01:05,830 --> 00:01:08,980
بالطّبع لا! هل ترين أيّ عمل كفريق بيننا؟

22
00:01:08,980 --> 00:01:12,340
هل نسيتِ كم تشاجرنا خلال المعارك
التّجريبيّة في قطار تسوكيكاغي؟

23
00:01:12,840 --> 00:01:16,260
من جهة أخرى، هذا يناسبنا
.أكثر من العمل معًا

24
00:01:20,180 --> 00:01:21,600
.غبيّ

25
00:01:26,550 --> 00:01:28,970
."المكوّن الرّئيسيّ على النّار الآن؟ "جيّد

26
00:01:28,970 --> 00:01:30,430
."الصّلصة؟ "لا

27
00:01:30,430 --> 00:01:31,690
."أساس الحساء؟ "جيّد

28
00:01:31,690 --> 00:01:33,050
."التّتبيل؟ "جيّد

29
00:01:33,050 --> 00:01:34,310
."الكروت؟ "جيّد

30
00:01:34,310 --> 00:01:35,190
."الزّبدة؟ "لا

31
00:01:35,710 --> 00:01:39,660
يوكيهيرا-كُن، رأيتَ المكوّنات
..."الّتي قلتُ لها "لا

32
00:01:39,660 --> 00:01:42,490
.سأضعها جميعها في علب حفظ لاحقًا

33
00:01:42,490 --> 00:01:44,300
.يمكنك إعداد وجبات ليليّة بها إن أردت

34
00:01:44,300 --> 00:01:46,750
حسنًا... لكن ما كان ما عملتِه للتو؟

35
00:01:46,750 --> 00:01:49,580
،سأضطرّ لتغيير وصفتي سببك

36
00:01:49,580 --> 00:01:51,460
.لذلك عليّ أن أكون صارمة بشأن مكوّناتي

37
00:01:51,460 --> 00:01:55,180
!كي أتمكن من طبخ طبق جديد بالكامل

38
00:03:29,980 --> 00:03:34,100
يبدو أنّ فريق المتمرّدين سيعدّ طبقًا
.أساسيًّا جديدًا بالكامل في الحال

39
00:03:34,450 --> 00:03:37,820
!لكن لم يتبقّ الكثير من الوقت

40
00:03:37,820 --> 00:03:39,550
ستبدأ الآن؟

41
00:03:39,550 --> 00:03:40,690
ستعدّ طبقًا مختلفًا؟

42
00:03:41,040 --> 00:03:44,240
يوكيهيرا-كُن، قمت بتذوّق المكوّنات
،من أجلك في طبقك

43
00:03:44,630 --> 00:03:46,620
.لذلك ستكون مساعدًا لي مقابل ذلك

44
00:03:47,080 --> 00:03:48,540
.لا بأس

45
00:03:48,950 --> 00:03:52,970
خذ قشرة ليمون مقطّعة وامزجها
.مع التّوابل الّتي طلبتُها منك

46
00:03:52,970 --> 00:03:54,580
.لديك ثلاثون ثانية

47
00:03:54,580 --> 00:03:55,250
!مفهوم

48
00:03:55,580 --> 00:03:57,780
،بمجرّد أن ينتهي تسخين اللّحم

49
00:03:57,780 --> 00:03:59,460
.لفّه في الكروت وضعه تحت المشواة

50
00:03:59,790 --> 00:04:01,470
!لدينا فرصة واحدة فقط

51
00:04:01,470 --> 00:04:02,930
!عُلم

52
00:04:03,630 --> 00:04:05,890
تستطيع إرينا استعمال "لسان الإله" خاصّتها

53
00:04:06,330 --> 00:04:10,100
.للرّفع من أيّ طبق ليبلغ لذّة مثاليّة

54
00:04:10,570 --> 00:04:12,570
...كلّ طبق تعدّه

55
00:04:13,100 --> 00:04:16,190
ما رأيك يا جدّي؟
!أنا فخورة جدًّا بهذا الطّبق

56
00:04:17,650 --> 00:04:21,940
هل ستعترف بهذا على أنّه اختصاصي الآن؟

57
00:04:21,940 --> 00:04:24,990
للأسف، يبدو أنّ الطّريق
.ما زالت طويلة أمامك

58
00:04:24,990 --> 00:04:26,900
ماذا؟

59
00:04:28,950 --> 00:04:33,910
،بطريقة ما، كلّ طبق تعدّه يعتبر اختصاصًا

60
00:04:34,520 --> 00:04:38,420
،وفي نفس الوقت
.لم يكن أيّ منها كذلك أيضًا

61
00:04:38,800 --> 00:04:41,730
...اختصاص يتجاوز اللّذة المثاليّة

62
00:04:41,730 --> 00:04:45,880
ذلك هو الطّبق الوحيد الّذي
.سيسمح لنا برؤية وجه إرينا الحقيقي

63
00:04:46,220 --> 00:04:49,850
بمجرّد أن تتمكّن إرينا من تقديم
...اختصاصها أخيرًا، فحينها

64
00:04:54,150 --> 00:04:56,190
.اكتمل تكثيف الصّلصة

65
00:04:56,190 --> 00:04:57,950
.الكروت جاهز

66
00:04:57,950 --> 00:04:59,640
.المكّونات الإضافيّة جاهزة

67
00:04:59,640 --> 00:05:02,110
.انتهى التسمير تحت المشواة

68
00:05:02,440 --> 00:05:03,990
!علينا الانتقال للخطوة التّالية بسرعة

69
00:05:04,300 --> 00:05:07,650
يختلف هذا تمامًا عن طريقة طبخها
.الأنيقة والمتحفّظة المعتادة

70
00:05:07,650 --> 00:05:10,120
،يبدو هذا أكثر قوّة
.وكأنّه فيضان شغف مندفع

71
00:05:10,460 --> 00:05:13,410
إنّها تُبعد الآن كلّ شيء عن طريقها

72
00:05:14,050 --> 00:05:16,870
.بهدف الخروج بطبق جديد

73
00:05:16,870 --> 00:05:19,320
.لا يهمّ ما قد تطبخه. فات الأوان

74
00:05:19,680 --> 00:05:24,800
سواء قدّمت طبقًا من اختصاصها
،بعد فاتح الشّهيّة الفظيع ذاك أم لا

75
00:05:25,400 --> 00:05:27,510
.فنتيجة المباراة قد حُدّدت سلفًا

76
00:05:28,720 --> 00:05:32,680
...ما أملكه الآن ولم يكن بحوزتي في السّابق

77
00:05:32,680 --> 00:05:36,270
إن لم أستطع معرفة الأمر، فلن أتمكّن
.من إتمام اختصاصي

78
00:05:36,770 --> 00:05:40,270
...الطّريق الّذي سلكتها حتّى الآن

79
00:05:40,270 --> 00:05:42,940
...كلّ شيء عدا ما يعترف به والدك

80
00:05:42,940 --> 00:05:43,840
.حثالة

81
00:05:43,840 --> 00:05:44,710
.قذارة

82
00:05:44,710 --> 00:05:45,650
.قمامة

83
00:05:45,650 --> 00:05:48,740
،لو لم يتدخّل زوج عمّتي أزامي

84
00:05:48,740 --> 00:05:53,330
.لكنّا صديقتين أفضل بكثير جدًّا يا إرينا

85
00:05:53,680 --> 00:05:57,580
.أنا سعيدة لأنّني أحبّ شيئًا تحبّينه أيضًا

86
00:05:57,940 --> 00:05:59,510
.أنت ابنته

87
00:05:59,510 --> 00:06:01,790
.عليك تعلّم أن تكوني أنانيّة أحيانًا يا إرينا

88
00:06:01,790 --> 00:06:04,760
!ناكيري-سان

89
00:06:03,790 --> 00:06:04,760
!ماذا؟

90
00:06:05,260 --> 00:06:06,970
!حسنًا

91
00:06:09,630 --> 00:06:10,900
هل من خطب يا ناكيري؟

92
00:06:10,900 --> 00:06:12,300
.لا تهتمّ

93
00:06:12,660 --> 00:06:16,180
.كما أنّي لن آكل من طبخك

94
00:06:16,180 --> 00:06:19,710
!إنّها زبديّة تمبورا ببيض الدّجاج بأسلوب يوكيهيرا

95
00:06:21,940 --> 00:06:25,620
هل تريدين تذوّق أطباقي
المقرفة من باب التّغيير؟

96
00:06:25,620 --> 00:06:27,780
!إنّها مقرفة بشكل ممتع

97
00:06:27,780 --> 00:06:29,740
لماذا تقوم بكلّ هذا؟

98
00:06:29,740 --> 00:06:31,200
.الأمر واضح

99
00:06:31,200 --> 00:06:34,950
،إن عرفنا وجهتنا بالضّبط سلفًا
.فالأمر ليس ممتعًا على الإطلاق

100
00:06:36,330 --> 00:06:38,210
...هذا هو الطّبق الوحيد

101
00:06:38,210 --> 00:06:41,990
هذا هو الطّبق الأفضل القادر
!على هزيمة يوكيهيرا-كُن

102
00:06:49,940 --> 00:06:50,880
.استمتعوا بالأكل

103
00:06:59,170 --> 00:07:01,770
...ذلك هو اختصاص الآنسة إرينا

104
00:07:01,770 --> 00:07:04,650
يا لها من قطعة لحم
!جميلة ومليئة بالعصارة

105
00:07:05,020 --> 00:07:07,630
هذا هو الطّبق الرّئيسيّ
...لوجبتنا من طبقين

106
00:07:07,630 --> 00:07:09,650
.زبديّة أرزّ بالدّجاج والبيض

107
00:07:12,660 --> 00:07:15,620
!ماذا؟

108
00:07:15,620 --> 00:07:17,620
!زبديّة أرزّ بالدّجاج والبيض؟

109
00:07:17,620 --> 00:07:19,120
يفترض بذلك أن يكون زبديّة أرزّ؟

110
00:07:19,120 --> 00:07:20,630
...مهلاً، أذلك بالأصل

111
00:07:20,630 --> 00:07:26,020
أهذه نفس إرينا-ساما الّتي تعتبر زبديّات
الأرزّ طبخًا من الدّرجة الثّانية؟

112
00:07:26,020 --> 00:07:27,500
!ومع ذلك أعدّت واحدًا؟

113
00:07:27,500 --> 00:07:29,860
.كنتِ مثلها أيضًا في البداية يا نيكوميتشي

114
00:07:29,860 --> 00:07:31,840
.لكنّ هذا لا يُصدّق

115
00:07:32,310 --> 00:07:36,590
.لا توجد وجبات أرزّ في المطبخ الفرنسيّ

116
00:07:36,590 --> 00:07:40,700
،حتّى في الوجبات اليابانيّة التّقليديّة
.يتمّ تقديمه بعد الوجبة الرّئيسيّة

117
00:07:40,700 --> 00:07:43,260
...ومع ذلك تقدّمه كطبق رئيسيّ

118
00:07:43,260 --> 00:07:47,400
هذا بكلّ تأكيد خيار لا ذكر له
.في أيٍّ من كتب الطّبخ

119
00:07:47,400 --> 00:07:48,860
...بصراحة

120
00:07:49,450 --> 00:07:51,900
لا أصدّق أنّ ابنتي قد أعدّت طبقًا

121
00:07:51,900 --> 00:07:53,840
.بعيدًا كلّ البعد عن الإجابة الصحيحة

122
00:07:53,840 --> 00:07:55,570
.هذا بائس تمامًا

123
00:07:56,010 --> 00:07:58,190
واضح لي أنّه يستحقّ
.علامة صفر بمجرّد النّظر إليه

124
00:07:58,190 --> 00:08:01,330
.لا يمكنني دفع نفسي لتذوّق طبق مثله حتّى

125
00:08:01,330 --> 00:08:04,860
ماذا؟! لكن يُفترض بك
.أن تحكم على الطّبق بتذوّقه

126
00:08:04,860 --> 00:08:08,460
من الرّائع فعلاً أن تستطيع الحكم على
.طبق بمجرّد النّظر إليه يا والدي

127
00:08:08,980 --> 00:08:14,870
لكن إن قال الطّاهيان اللّذان يجسّدان
مُثُلك الخاصّة عمَّ هو صحيح

128
00:08:14,870 --> 00:08:19,060
أنّ طبقي لذيذ، فأنا واثقة
.أنّك ستغيّر رأيك

129
00:08:19,900 --> 00:08:22,660
ماذا؟ إنّها تستفزّنا بالفعل؟

130
00:08:22,660 --> 00:08:25,750
ما رأيك يا تسوكاسا؟ هل نقبل؟

131
00:08:26,270 --> 00:08:30,370
لا ضرر من تذوّقه. ساورني الفضول
.بشأن طبق يوكيهيرا أيضًا

132
00:08:32,820 --> 00:08:36,200
.لا بأس. يمكنكما تذوّقه يا تسوكاسا وكوباياشي

133
00:08:36,910 --> 00:08:42,500
،لكنّ هذه وجبة من طبقين
.لذلك عليكما البدء بفاتح الشّهيّة

134
00:08:42,500 --> 00:08:43,580
!تفضّلا

135
00:08:44,030 --> 00:08:48,260
هذه اختصاصي: لحم العدّ التنّازلي
!لرجل الكهف بأسلوب يافع جريء

136
00:08:48,260 --> 00:08:49,840
!طبخ يوكيهيرا الحقيقيّ

137
00:08:49,840 --> 00:08:52,020
.يبدو هذا مثيرًا للاهتمام

138
00:08:52,020 --> 00:08:53,260
.سأبدأ بالأكل

139
00:09:01,630 --> 00:09:04,030
.فهمت... أحسنت يا يوكيهيرا

140
00:09:04,030 --> 00:09:07,060
.هذا بكلّ تأكيد كافٍ ليسمّى اختصاصًا

141
00:09:07,640 --> 00:09:11,550
.لقد تقدّم كثيرًا عن ذي قبل بكلّ تأكيد

142
00:09:11,550 --> 00:09:13,530
.مذهل يا يوكيهيرا

143
00:09:13,970 --> 00:09:17,660
لكن هل ينفع هذا الطبق كوجبة فعلًا؟

144
00:09:18,110 --> 00:09:23,660
صحيح، لا يسعني سوى الشعور أنّ الطّبق التّالي
.لن يمكنه متابعة هذا مهما كان

145
00:09:26,250 --> 00:09:32,550
!حسنًا، لنتذوّق اختصاصك الآن يا ناكيري-تشان

146
00:09:45,420 --> 00:09:48,330
بيض ممزوج بلحم دجاج
،طريّ وعصارة

147
00:09:48,330 --> 00:09:51,460
!وكلّ شيء يذوب في فمي

148
00:09:51,460 --> 00:09:55,460
،بالكاد قد طُبخ منتصف اللّحم
.بينما الجزء الخارجيّ مقرمش

149
00:09:56,020 --> 00:09:58,330
لقد طُبخ بمثاليّة ليستفيد تمامًا

150
00:09:58,330 --> 00:10:00,070
.من مميّزات دجاج جيدوري الفاخر

151
00:10:00,380 --> 00:10:04,030
الصّلصة معدّة من البيض
،والقشدة والملح والفلفل

152
00:10:04,030 --> 00:10:06,490
ثمّ سُخّنت ليصبح ملمسها قشديًّا
.كثيفًا في حمّام ماء ساخن

153
00:10:06,490 --> 00:10:09,550
يمنحها الكركم لونها الأصفر الحيويّ

154
00:10:09,550 --> 00:10:12,480
ممّا ساعد على خلق صلصة
.بيض مخفوق غنيّة وقشديّة

155
00:10:12,480 --> 00:10:16,110
!ولدينا فوقه مقرمشات أرزّ فوّاحة خاصّة

156
00:10:16,110 --> 00:10:19,490
أرزّ مبخّر حديثًا وحبّار مفروم
منثور بعناية عليه

157
00:10:19,490 --> 00:10:21,550
مع زيت السّمسم، ثمّ تمّ
.قليه حتّى يتقرمش

158
00:10:21,550 --> 00:10:23,390
الصّلصة الكثيفة

159
00:10:23,390 --> 00:10:27,040
إضافة إلى القرمشة، يتناغمان بشكل
.مذهل مع عصارة الدجاج

160
00:10:27,040 --> 00:10:30,390
...صلصة الدّجاج والبيض
.ثمّ مقرمشات معدّة من الأرزّ

161
00:10:30,390 --> 00:10:32,810
تجعل هذه العوامل الثّلاثة منها
!زبديّة أرزّ بالدّجاج والبيض

162
00:10:33,180 --> 00:10:36,450
والجزء الّذي يلعب أكبر
دور في هذا الطّبق

163
00:10:36,450 --> 00:10:38,820
.هي قشرة الكروت حول صدر الدّجاج

164
00:10:39,140 --> 00:10:44,210
الكروت... يُعدّ من أساس
عجينة خبز أو فطيرة

165
00:10:44,210 --> 00:10:46,120
ويُتبّل بتوابل فاتحة للشّهيّة، صحيح؟

166
00:10:46,120 --> 00:10:49,780
إنّه إضافة قيّمة بمكانها
تعزيز الرّائحة والملمس

167
00:10:49,780 --> 00:10:55,090
وتقديم الطّبق دون أن يطغى
.على نكهاته المميّزة

168
00:10:55,090 --> 00:10:59,300
صحيح. هناك يكمن أكبر
.سرّ في هذا الطّبق

169
00:10:59,900 --> 00:11:01,830
،بما أنّني تخلّيت تمامًا عن وصفتي الأولى

170
00:11:01,830 --> 00:11:04,970
،ولكي ينجح هذا الطّبق الجديد بالكامل

171
00:11:04,970 --> 00:11:07,930
احتجتُ لأضيف مكوّنًا معيّنًا للكروت

172
00:11:07,930 --> 00:11:10,580
.الّذي نويت أن ألفّ الدّجاج به

173
00:11:10,580 --> 00:11:11,980
...وذلك المكوّن كان

174
00:11:13,190 --> 00:11:16,870
.مجسّات حبّار مفرومة مع زبدة الفستق

175
00:11:17,650 --> 00:11:19,740
...مـ-مـ-مـ-مـ

176
00:11:19,740 --> 00:11:21,660
!مجسّات حبّار بزبدة الفستق؟

177
00:11:21,660 --> 00:11:22,950
أهي جادّة؟

178
00:11:23,290 --> 00:11:26,350
نعم. كانت مجسّات الحبّار بزبدة الفستق

179
00:11:26,350 --> 00:11:29,910
هي ما وصل فاتح الشّهيّة بالطّبق
.الرّئيسيّ. إنّها قطعة أساسية للأحجية

180
00:11:30,280 --> 00:11:32,780
يضيف غنى زبدة الفستق الخفيف

181
00:11:32,780 --> 00:11:35,790
،عمقًا طفيفًا للدّجاج
.ممّا يجعله تابلًا سرّيًا ممتازًا

182
00:11:36,110 --> 00:11:38,570
ومذاق مجسّات الحبّار
المرّ والمالح باعتدال

183
00:11:38,570 --> 00:11:40,030
مؤثّر للغاية في الرّبط

184
00:11:40,030 --> 00:11:43,140
بين نكهة الكروت ولحم
.الدّجاج المليء بالعصارة

185
00:11:43,140 --> 00:11:46,540
إنّه مزيج فظيع لا ينفكّ يوكيهيرا-كُن
،عن إرغام الآخرين على تناوله

186
00:11:46,540 --> 00:11:50,900
ولكن بين يديّ أنا، حوّلته
.إلى طبق ذوّاقة أنيق

187
00:11:50,890 --> 00:11:54,020
صدر دجاج جيدوري وكروت
مجسّات الحبّار بزبدة الفستق

188
00:11:54,020 --> 00:11:56,110
.هما الجزء الأساسيّ من الطّبق

189
00:11:56,110 --> 00:11:58,860
أعدت النّظر في كلّ الصّلصات
.والزّينة لتدعمهما

190
00:11:59,230 --> 00:12:02,100
،والهدف هو بعد أن تتناولوا طبق يوكيهيرا-كُن

191
00:12:02,100 --> 00:12:05,270
لذّة طبقي سترتقي
.لأقصى المستويات

192
00:12:05,990 --> 00:12:08,860
،كما استخدم يوكيهيرا "لسان الإله" لصالحه

193
00:12:08,860 --> 00:12:12,120
.استخدمت ناكيري-سان طبخ يوكيهيرا الفظيع

194
00:12:12,120 --> 00:12:14,470
لقد قاما ببساطة بأخذ نقاط قوّة الآخر

195
00:12:14,470 --> 00:12:17,340
.وإظهار أفضل ما في طبقيهما

196
00:12:17,340 --> 00:12:19,450
!إريناتشي مذهلة

197
00:12:19,450 --> 00:12:22,580
هذا ما يستطيعان القيام به معًا؟

198
00:12:22,580 --> 00:12:24,260
!اختصاصان يعملان معًا

199
00:12:24,260 --> 00:12:26,510
!أعدّا وجبة بطبقين لا مثيل لها

200
00:12:27,620 --> 00:12:29,020
...يا لك من خبيثة

201
00:12:29,020 --> 00:12:32,180
تسرقين جملتي في بالبداية، والآن هذا؟

202
00:12:33,060 --> 00:12:35,180
.أنت من بدأ هذا القتال

203
00:12:35,180 --> 00:12:36,950
.لن أسمع أيّ شكاوى منك

204
00:12:36,950 --> 00:12:38,940
هكذا إذًا؟

205
00:12:39,310 --> 00:12:42,070
.ناكيري-كُن، لقد تغيّرتِ بالفعل

206
00:12:42,070 --> 00:12:45,240
لكنّني واثق أنّ المدير أزامي
.لا يستمتع بهذا

207
00:12:46,070 --> 00:12:48,790
،ابنته الغالية الّتي حبسها في قفص

208
00:12:52,450 --> 00:12:57,130
تطبخ الآن والبسمة تعلو وجهها
.كما لم يرها من قبل

209
00:13:00,020 --> 00:13:04,740
فاتح شهيّة يوكيهيرا لا يساعد الطّبق الرّئيسيّ
.بل وُجِد ليدفعه للتفوق عليه

210
00:13:04,740 --> 00:13:08,510
وبلا أدنى شكّ، هذا الطّبق يتجاوز
.بكلّ تأكيد فاتح الشّهيّة

211
00:13:08,850 --> 00:13:11,500
،بغضّ النّظر عن جنون طريقتَيهما

212
00:13:11,500 --> 00:13:13,930
!تمكّنا من منحنا هذه التركيبة المذهلة

213
00:13:14,370 --> 00:13:16,500
!وكأنّني في حفل مباشر

214
00:13:16,500 --> 00:13:20,570
ثمّة آلات موسيقيّة وأصوات مختلفة
،تعمل معًا في مستوى عالٍ جدًّا

215
00:13:20,570 --> 00:13:23,940
،وفي لحظة أعجوبيّة واحدة
،تتّحد معًا بشكل مثاليّ

216
00:13:23,940 --> 00:13:25,900
!وتخرج من مكبّرات الصّوت بقوّة

217
00:13:26,510 --> 00:13:28,910
...يجعل تذوّق الطّبق ضغط الصّوت

218
00:13:32,030 --> 00:13:35,830
!يدفع بك ويجرّك بلا رحمة

219
00:13:39,310 --> 00:13:42,070
نال الطّبق استحسان صاحبَي
!الرّتبتين الأولى والثّانية

220
00:13:42,070 --> 00:13:45,380
لن يكون للعمّ أزامي خيار آخر
.سوى الاعتراف بالطّبق

221
00:13:45,690 --> 00:13:49,730
.فهمت. يبدو أنّك قد بذلت جهدًا فيه

222
00:13:49,730 --> 00:13:52,960
واثق أنّه إن اعترف تسوكاسا
،وكوباياشي بالطّبق

223
00:13:52,960 --> 00:13:55,060
.فلا بدّ أنّه لذيذ

224
00:13:55,510 --> 00:13:57,420
.لكن سأكون صريحًا

225
00:13:58,050 --> 00:14:03,400
،لا يهمّ كيف أعددتِ هذا الطّبق
.لا نيّة لي أبدًا للاعتراف به

226
00:14:04,020 --> 00:14:08,360
بصراحة... لم أرد أبدًا أن أرى
.ابنتي تهبط لهذا المستوى

227
00:14:09,280 --> 00:14:11,870
أعدّت الطّبق باهتياج شديد
.لدرجة أنّها كانت تلهث

228
00:14:11,870 --> 00:14:14,410
...لم تتبقّ ولو ذرّة من الأناقة

229
00:14:14,990 --> 00:14:18,230
،إرينا، بسبب ذلك الفتى الأرعن

230
00:14:18,230 --> 00:14:21,330
أُجبرتِ على خلق طبق
.مرتجل ضدّ رغبتك

231
00:14:21,330 --> 00:14:26,210
إن استمرّ هذا، فستعانين
.إلى أن تختنقي فحسب

232
00:14:26,210 --> 00:14:28,430
.إنّه "شّغف" لا تحتاجين إليه

233
00:14:28,430 --> 00:14:33,430
يمكنني بكلّ تأكيد قول أنّه طبق بعيد
.كلّ البعد عن طعام الذّوّاقة الحقيقيّ

234
00:14:33,430 --> 00:14:36,890
!إنّه كومة نجاسة قذرة فحسب

235
00:14:44,470 --> 00:14:46,900
شغف لا أحتاجه؟

236
00:14:47,290 --> 00:14:49,360
.أقدّر قلقك

237
00:14:49,860 --> 00:14:54,780
ولكن، هنالك إضافة أخرى لهذا الطّبق

238
00:14:55,350 --> 00:14:56,330
.ستسمح له بأن يتحوّل

239
00:14:57,290 --> 00:15:02,040
!والآن، شاهد شكل اختصاصيّ الحقيقيّ

240
00:15:06,960 --> 00:15:08,550
ما ذلك؟

241
00:15:08,550 --> 00:15:13,090
تلك المكعّبات الذّهبيّة اللاّمعة قد
!لفّت نفسها حول صدر الدّجاج

242
00:15:13,440 --> 00:15:15,600
!تلك هي توابل الأرزّ المتحوّلة

243
00:15:25,710 --> 00:15:28,230
!الرّائحة الغنيّة من دجاج جيدوري ترتفع

244
00:15:28,230 --> 00:15:31,450
...من النّظر إليها، فهي مكعّبات هلاميّة

245
00:15:32,950 --> 00:15:34,370
!هذا مذهل

246
00:15:34,760 --> 00:15:38,330
الرّائحة الغنيّة لدجاج جيدوري
.المشويّ تداعب أنفي

247
00:15:38,330 --> 00:15:39,700
.حسنًا إذًا

248
00:15:40,140 --> 00:15:43,580
سأتناول قضمة لأستطيع
.على الأقلّ توبيخ ابنتي التّائهة

249
00:15:47,870 --> 00:15:49,930
،ذابت المكعّبات الهلاميّة بشكل مثاليّ

250
00:15:49,930 --> 00:15:54,140
مضيفة بذلك طبقة فخمة
.لنكهة وملمس الطّبق معًا

251
00:15:54,140 --> 00:15:57,980
امتصّت مقرمشات الأرزّ
،كلّ أومامي دجاج جيدوري

252
00:15:57,980 --> 00:16:02,370
وصلصة البيض المخفوق
!أكثر قشديّة من قبل

253
00:16:02,370 --> 00:16:06,110
!التّوازن المثاليّ لهذا الطّبق يجعله مقدّسًا

254
00:16:06,490 --> 00:16:11,420
جلبنا تسوكاسا إيشي وكوباياشي ريندو
...لجنّة عدن للذّوّاقة

255
00:16:11,420 --> 00:16:14,110
وعندما ظننّا أنّنا استقرّينا
...بارتياح في تلك الجنّة

256
00:16:14,110 --> 00:16:15,370
...ظهرت أمامنا

257
00:16:15,370 --> 00:16:17,080
...مبعوثة مقدّسة

258
00:16:17,080 --> 00:16:18,540
...تعلّمت بعض الخُدع اللّعوبة

259
00:16:18,920 --> 00:16:24,190
!ملاك متمرّد أتت لتأخذنا لجنّة جديدة

260
00:16:27,500 --> 00:16:30,710
.عقدتُ عزيمتي

261
00:16:30,710 --> 00:16:33,130
.يحتاج الطّبخ للحرّيّة

262
00:16:33,130 --> 00:16:36,680
،وللحرص على أن يبقى حرًّا
.فسأتحمّل أيّ ألم قد أواجهه

263
00:16:36,680 --> 00:16:41,050
،وهكذا، أكلمتُ اختصاصي
..."الطّبق الحقيقيّ"

264
00:16:41,050 --> 00:16:45,150
،طعام الذّوّاق الحقيقيّ الهارب من الجنّة
.بأسلوب الابنة الجانحة

265
00:16:45,470 --> 00:16:48,610
عن أيّ حرّيّة تتكلّمين؟
عن أيّ إصرار؟

266
00:16:48,610 --> 00:16:54,580
الألم الّذي تسبّبه هذه الأشياء
.سيخنق قلب الطّاهي ويدمّره

267
00:16:55,010 --> 00:16:57,820
.كما حدث معه تمامًا

268
00:16:58,940 --> 00:16:59,830
!سايبا-سينباي

269
00:17:00,850 --> 00:17:02,530
.مرحبًا يا ناكامورا

270
00:17:02,530 --> 00:17:05,580
لا تقل لي أنّك كنتَ مستيقظًا
.طوال اللّيل تختبر الوصفات

271
00:17:06,000 --> 00:17:09,420
ذلك هو الطّبق الّذي فاز بالميداليّة
الذّهبيّة في مسابقتنا الأخيرة، صحيح؟

272
00:17:09,770 --> 00:17:15,220
خطرت ببالي فكرة مذهلة البارحة
!ستجعل هذا الطّبق أفضل بكثير

273
00:17:15,220 --> 00:17:18,170
.لكنّ ذلك الطّبق صحيحٌ تمامًا من الأساس

274
00:17:18,170 --> 00:17:19,260
...فلماذا

275
00:17:19,260 --> 00:17:22,830
لأنّني تحمّست كثيرًا لفكرة
أنّ هنالك نكهات أخرى

276
00:17:22,830 --> 00:17:25,730
!لا أعرفها لدرجة عجزي عن كبح نفسي

277
00:17:26,220 --> 00:17:30,020
،بعد أن قال سينباي ذلك
،واصل التّقدّم للأمام

278
00:17:30,020 --> 00:17:32,610
.ثمّ اختفى في الأراضي القَفِرة

279
00:17:32,610 --> 00:17:34,990
!لن أسمح بحدوث تلك المأساة ثانية

280
00:17:35,470 --> 00:17:36,850
...طعام الذّوّاقة الحقيقيّ

281
00:17:36,850 --> 00:17:40,700
عالم يستطيع فيه كلّ الطّهاة
...الحفاظ على صحّتهم وحيويّتهم

282
00:17:40,700 --> 00:17:44,460
.لن يعاني أحد فيه وسينجو الجميع

283
00:17:44,460 --> 00:17:47,250
!تلك هي ثورتي الكبرى

284
00:17:47,250 --> 00:17:50,400
!تخلّصوا من كلّ الخنازير والطّهاة الحثالة

285
00:17:50,400 --> 00:17:55,340
،إن أضعنا الوقت في التّعامل معهم
!فسيدمّر ذلك الطّهاة الحقيقيّين يومًا

286
00:17:55,340 --> 00:17:56,800
!لهذا السّبب أرفض قبول هذا

287
00:17:56,800 --> 00:17:59,020
!هذه أطباق نجسة

288
00:17:59,020 --> 00:18:02,720
...هذه الأطباق مليئة بالمعاناة والألم
!وذلك يجعلها قمامة نجسة

289
00:18:04,850 --> 00:18:05,640
ماذا؟

290
00:18:04,850 --> 00:18:05,640
ما ذلك الصّوت؟

291
00:18:06,670 --> 00:18:07,600
...هذا الصّوت

292
00:18:10,610 --> 00:18:11,410
!ماذا؟

293
00:18:11,410 --> 00:18:12,670
ما هذا الصّوت؟

294
00:18:12,670 --> 00:18:14,110
انفجار؟

295
00:18:17,430 --> 00:18:18,490
!هذا مقرف

296
00:18:19,750 --> 00:18:23,200
حسنًا يا أبي، كيف كان مذاقه؟

297
00:18:25,870 --> 00:18:29,040
!كلاّ! لماذا؟

298
00:18:29,040 --> 00:18:30,460
!كلاّ

299
00:18:33,460 --> 00:18:34,540
...مهلاً، أهذه

300
00:18:34,540 --> 00:18:36,710
.نعم، لا شكّ في ذلك

301
00:18:37,920 --> 00:18:39,570
!الهبة؟

302
00:18:39,570 --> 00:18:40,430
!إنّها الهبة

303
00:18:40,430 --> 00:18:42,550
!كلاّ

304
00:18:46,170 --> 00:18:48,240
!إنّها تنتشر بين الحضور بأكملهم

305
00:18:48,240 --> 00:18:50,600
!إنّ تأثيرها أكبر من وجبة تسوكاسا وريندو

306
00:18:50,600 --> 00:18:53,370
.تبدو كأغنية جميلة

307
00:18:53,370 --> 00:18:56,660
...نعم. أغنية ألّفها يوكيهيرا وناكيري معًا

308
00:18:56,660 --> 00:18:59,280
وأصبحت لحنًا يُدوّي في صداه
.بين الحضور بأكمله

309
00:18:59,280 --> 00:19:00,320
...مستحيل

310
00:19:00,760 --> 00:19:05,790
هل يعترف جسدي بأنّ الطّبق
لذيذ رغم أنّ عقلي يرفضه؟

311
00:19:06,230 --> 00:19:08,910
!لا يجب أن يحدث هذا
.لا بدّ أنّه خطأ

312
00:19:09,350 --> 00:19:11,460
،إن دمّرتِ ثورتي الكبرى

313
00:19:11,460 --> 00:19:12,800
فالحديقة الّتي تحمي الطّهاة

314
00:19:12,800 --> 00:19:14,960
.والبوصلة الّتي ترشدهم ستختفي

315
00:19:14,960 --> 00:19:20,220
وحينها ستتوهين في الأراضي
!القفار وحدك يا إرينا

316
00:19:20,220 --> 00:19:20,880
!كلاّ

317
00:19:21,360 --> 00:19:23,490
أعتقد أنّنا وصلنا لهذه المرحلة

318
00:19:23,490 --> 00:19:27,600
.لأنّنا جميعًا نتّجه صوب أهدافنا المختلفة

319
00:19:27,600 --> 00:19:31,100
...هنالك آخرون يواصلون التّقدّم للأمام

320
00:19:31,100 --> 00:19:35,570
.تسمح لنا تلك الحقيقة بأخذ خطوة للأمام

321
00:19:35,570 --> 00:19:36,190
...هيساكو

322
00:19:36,190 --> 00:19:38,690
.حتّى وإن كنّا في أرض قفِرة

323
00:19:38,690 --> 00:19:41,790
أتجرئين على التّشكيك بمدير توتسكي؟

324
00:19:41,790 --> 00:19:44,700
!ما أنت إلاّ خادمة متدنّية لعائلة ناكيري

325
00:19:44,700 --> 00:19:47,160
...كلاّ... أنا

326
00:19:47,660 --> 00:19:49,660
...أنا الآن

327
00:19:49,660 --> 00:19:52,870
!صديقة إرينا-ساما

328
00:19:52,870 --> 00:19:54,330
...هيساكو

329
00:19:56,290 --> 00:19:57,750
!هيساكوتشي

330
00:19:59,540 --> 00:20:02,680
.يا والدي، ما قالته هيساكو هو الحقيقة

331
00:20:02,680 --> 00:20:05,640
لكلّ أولئك الطّهاة قيم وأفكار مختلفة
...تمامًا عن أفكاري وقيمي

332
00:20:05,640 --> 00:20:07,760
...طهاة يواجهون طبخهم مباشرة

333
00:20:07,760 --> 00:20:11,640
وقد تمكّنتُ من طبخ هذا
.الطّبق بسبب تفاعلي معهم

334
00:20:11,990 --> 00:20:14,810
لقائي بهؤلاء النّاس الّذين
..."تصفهم بـ"الملوّثين

335
00:20:14,810 --> 00:20:19,610
.كان الثّابل الأفضل لطبخي

336
00:20:19,610 --> 00:20:24,490
!هذه حماقة ما بعدها حماقة
!هذا الشّغف هو سبب ضياع الطّهاة

337
00:20:24,490 --> 00:20:25,200
!هو ما يعذّبهم

338
00:20:25,200 --> 00:20:26,660
!ويحطّمهم في النّهاية

339
00:20:27,000 --> 00:20:28,620
!كما حدث معه تمامًا

340
00:20:28,620 --> 00:20:31,440
تكمن السّعادة الحقيقيّة لكلّ الطّهاة

341
00:20:31,440 --> 00:20:35,000
في العيش بسلام في الحديقة
!الّتي أنشأتُها لهم

342
00:20:35,000 --> 00:20:38,460
هلاّ توقّفت عن تحديد سعادة
الآخرين من أجلهم؟

343
00:20:40,020 --> 00:20:44,180
لم أكن أعرف بشأن كلّ ما
،حدث مع أبي إلاّ مؤخّرًا

344
00:20:44,980 --> 00:20:48,810
.لكن أبي كان سعيدًا بعد لقائه لأمّي

345
00:20:49,610 --> 00:20:51,270
.أعرف ذلك حقّ المعرفة

346
00:20:53,690 --> 00:20:55,140
—ذلك ليس

347
00:20:58,050 --> 00:20:59,820
!لا يمكنني كبح نبض الهبة

348
00:21:02,340 --> 00:21:03,470
!ليس ثانية

349
00:21:04,350 --> 00:21:06,990
!لن تملك طاقة النّبض أيّ مكان لتذهب إليه

350
00:21:16,830 --> 00:21:18,080
...يا والدي

351
00:21:18,670 --> 00:21:22,670
كلّ ما رفضتَه في هذه الأكاديميّة
.قد سمح لي بأن أولد من جديد

352
00:21:23,970 --> 00:21:27,350
...أصبحتُ شخصًا مختلفًا تمامًا
.طاهية مختلفة تمامًا

353
00:21:30,590 --> 00:21:33,980
...في الجولة الأخيرة من شوكوغيكي الفِرق

354
00:21:33,980 --> 00:21:34,930
...عاد الفوز فيها

355
00:21:34,930 --> 00:21:37,530
.حسنًا، لا تفسدي هذا

356
00:21:37,530 --> 00:21:39,940
بما أنّك تسرقين باستمرار
،كلّ شيء آخر منّي

357
00:21:39,940 --> 00:21:40,900
.فقولي جملتي أيضًا

358
00:21:40,900 --> 00:21:42,980
لـ-لماذا أنا؟

359
00:21:46,360 --> 00:21:49,460
.أنت هي الزّعيمة الآن
من غيرك قد يُنهي الأمر؟

360
00:21:49,460 --> 00:21:50,650
!هيّا، قوليها

361
00:21:50,650 --> 00:21:54,370
.حسنًا... لا بأس

362
00:21:55,070 --> 00:21:56,830
!لقوّات المتمرّدين

363
00:21:58,660 --> 00:21:59,910
!سرّني أنّ الطّبق أعجبكم

364
00:23:35,430 --> 00:23:36,750
.بالهناء والشّفاء

365
00:23:36,750 --> 00:23:39,930
!هناك من سرق جملتي ثانية
!الحلقة القادمة هي الأخيرة؟ فعلاً؟