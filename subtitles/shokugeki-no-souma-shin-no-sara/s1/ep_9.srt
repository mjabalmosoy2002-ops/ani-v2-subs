1
00:00:06,210 --> 00:00:09,940
كينوكوني، هل ما زلت قادرة بالفعل

2
00:00:09,940 --> 00:00:12,400
على الاستمتاع بالطّبخ وأنت في "المركز"؟

3
00:00:12,400 --> 00:00:14,110
...إيشّيكي

4
00:00:15,820 --> 00:00:17,280
...المعذرة

5
00:00:17,900 --> 00:00:20,490
نعم؟ كيف لي أن أساعدك
يا تسوكاسا-سينباي؟

6
00:00:20,490 --> 00:00:24,250
لا شيء يا إيشّيكي، كنت أفكّر
.فقط في أنّك أعددت حساءً رائعًا

7
00:00:24,650 --> 00:00:26,460
.مذهل كعادتك

8
00:00:26,890 --> 00:00:29,620
،لكن عندما أفوز بهذه المباراة

9
00:00:29,620 --> 00:00:33,170
هلاّ وافقتَ على الانضمام
لـ"المركز" وتصبح من أتباعي؟

10
00:00:33,590 --> 00:00:35,890
.سأطلب منهم إعادة التّفكير في طردك

11
00:00:35,890 --> 00:00:39,930
أنت مذهل بالفعل عندما يتعلّق
،الأمر بالمطبخ اليابانيّ

12
00:00:39,930 --> 00:00:43,060
.لذلك أعتقد أنّك ستكون مساعدًا مذهلاً

13
00:00:43,060 --> 00:00:45,730
من قد يحاول تجنيد شخص
في وضع كهذا؟

14
00:00:45,730 --> 00:00:47,190
فيم يفكّر؟

15
00:00:48,190 --> 00:00:51,820
لا يوجد ما قد يغيّر من تصرّفاتك
.يا تسوكاسا-سان

16
00:00:52,240 --> 00:00:56,660
حسنًا، فكّر في الأمر فقط
.إلى أن ينتهوا من تذوّق طبقي

17
00:00:59,830 --> 00:01:03,000
.حسنًا. بهذا ينتهي طبقي

18
00:01:10,250 --> 00:01:12,940
.استمتعوا بأكله رجاءً

19
00:02:45,070 --> 00:02:50,480
قدّم إيشّيكي ساتوشي من فريق
.المتمرّدين حساء وانمونو قويًّا للغاية

20
00:02:50,480 --> 00:02:54,190
فما الّذي سيقدّمه تسوكاسا
إيشي من النّخبة العشرة؟

21
00:02:54,750 --> 00:02:59,650
لييفر ألا روايال"، بمعنى "أرنب برّيّ"
."مقدّم على الطّريقة الملكيّة

22
00:02:59,650 --> 00:03:03,620
.طبق أيقونيّ قِيل أن لويس الرّابع عشر أحبّه

23
00:03:04,290 --> 00:03:09,580
واحد من أكثر أطباق لحوم الصّيد تقليديةً
.للسّلالة الملكيّة الفرنسيّة

24
00:03:09,580 --> 00:03:12,290
...عبق عطريّ كثيف

25
00:03:12,290 --> 00:03:15,040
.لا شكّ أنّ هذا طبق ذو جودة عالية

26
00:03:15,040 --> 00:03:19,760
كيف أضاف نكهته الخاصّة
لطبق كلاسيكيّ كهذا؟

27
00:03:23,860 --> 00:03:27,930
قطّع اللّحم من القوائم الأماميّة
،والخلفيّة ومن حول العنق

28
00:03:27,930 --> 00:03:30,940
.ثمّ لفّها بشكل دائريّ على أنبوب

29
00:03:31,430 --> 00:03:33,940
،ثمّ قام بقليها في مقلاة

30
00:03:33,940 --> 00:03:36,190
،ليكبح الرّائحة المميّزة للّحم
.مع الحرص على إبقاء عصارته

31
00:03:36,820 --> 00:03:40,070
أمّا الصّلصة فهي نبيذ أحمر مركّز بأساس
،حساء عظام الأرنب البرّيّ واللّحم

32
00:03:40,070 --> 00:03:44,640
ثمّ أضاف كبد البطّ والشّكولاطة
.ودم الأرنب نفسه. إنّه مثاليّ

33
00:03:44,640 --> 00:03:46,630
هذا وبلا أدنى شكّ طبق
...من الدّرجة الأولى

34
00:03:46,630 --> 00:03:51,650
لكنّ طبق السّيّد إيشّيكي
الّذي امتلأ بالمرح والمفاجأة

35
00:03:51,650 --> 00:03:52,830
.ما زال أفضل منه

36
00:03:55,880 --> 00:03:59,340
!لا... ليس بعد

37
00:03:59,340 --> 00:04:01,290
مهلاً، ماذا يحدث؟

38
00:04:01,290 --> 00:04:02,420
.إنّها تتلوّى

39
00:04:02,420 --> 00:04:04,610
...تحت الصّلصة

40
00:04:04,610 --> 00:04:05,640
ماذا؟

41
00:04:05,640 --> 00:04:09,350
طبقة غامضة أخرى مخبّأة تحت الصّلصة؟

42
00:04:09,690 --> 00:04:12,310
أهذا... "روايال"؟

43
00:04:17,420 --> 00:04:20,990
!يملأ عبق فطر البورتشيني فمي

44
00:04:21,660 --> 00:04:25,200
.ملمسه الحريريّ يذوب على لساني

45
00:04:25,200 --> 00:04:28,330
ألا تعني "روايال" أنّه مُعد بالطّريق الملكيّة؟

46
00:04:28,330 --> 00:04:34,290
نعم، لكن يُسمّى كاسترد البيض بحشوات
.مختلفة أخرى بـ"روايال" أيضًا

47
00:04:34,730 --> 00:04:37,540
يمكن القول أنّه النّسخة
.الفرنسيّة لتشاوانموشي

48
00:04:37,540 --> 00:04:40,380
"إذًا فكلاهما نوعان من "روايال

49
00:04:40,380 --> 00:04:43,010
بما أنّها طريقة ملكيّة لتقديم طبق
.وتشاوانموشي بأسلوب غربيّ

50
00:04:43,320 --> 00:04:45,970
ذلك ليس الشّيء الوحيد
.المخبّأ في الأسفل

51
00:04:45,970 --> 00:04:49,230
...بيوري التّين والتّفّاح وكونفي الكستناء

52
00:04:49,230 --> 00:04:51,360
نكهات "روايال" الخفيفة

53
00:04:51,360 --> 00:04:54,670
،تتناسب مع حموضة وحلاوة الفاكهة

54
00:04:54,670 --> 00:04:59,940
وذلك يجعل مذاق الأرنب البرّيّ
.خفيفًا ويمكن أكله في الحال

55
00:05:00,270 --> 00:05:02,900
كلّ ذلك بينما كان يحرص
.على عدم فقدان التّأثير الأوّليّ

56
00:05:03,350 --> 00:05:05,610
كيف له أن يفكّر في كلّ ذلك؟

57
00:05:05,970 --> 00:05:08,670
حتّى إن استطاع طاهٍ عاديّ
،التّفكير في هذه الفكرة

58
00:05:08,670 --> 00:05:11,080
واثقة أنّ محاولة تنفيذها
.ستكون صعبة للغاية

59
00:05:11,080 --> 00:05:13,420
،عبقريّ، إنّه عبقريّ بمعنى الكلمة

60
00:05:13,420 --> 00:05:15,870
.وبينه وبين الجنون خطّ رفيع

61
00:05:16,830 --> 00:05:20,410
.حسنًا، يمكنكم رسم ما تحبّون اليوم

62
00:05:20,410 --> 00:05:24,340
يمكن مزج الألوان المائيّة
.للحصول على لونكم الخاصّ

63
00:05:25,220 --> 00:05:28,260
.نجحت! يا له من لون جميل

64
00:05:34,190 --> 00:05:37,690
!أخذ إيشي-كُن لوني

65
00:05:38,010 --> 00:05:40,150
!إيشي-كُن! لا تفعل ذلك

66
00:05:40,150 --> 00:05:45,280
ماذا؟ لكنّني اعتقدتُ أنّ رسمتي
.ستبدو أفضل بكثير بذلك اللّون

67
00:05:45,790 --> 00:05:48,590
.واجهت حالات مشابهة مرّات عدّة

68
00:05:48,590 --> 00:05:49,950
لكن ما الخيار الّذي كان لديّ؟

69
00:05:50,320 --> 00:05:52,410
.كان ذلك للحرص على أن يتألّق طبقي

70
00:06:08,300 --> 00:06:12,260
!فاز تسوكاسا إيشي

71
00:06:15,770 --> 00:06:16,730
.إنّه قويّ جدًّا

72
00:06:16,730 --> 00:06:18,620
.إنّه لا يُقهر

73
00:06:18,620 --> 00:06:21,090
.لا أصدّق أنّ حتى إيشيكي-سينباي قد خسر

74
00:06:22,300 --> 00:06:24,660
إيشيكي، هل فكّرت في الأمر؟

75
00:06:24,660 --> 00:06:27,820
إن واصلتَ الوقوف في صفّ
.المتمرّدين، فستُطرد

76
00:06:28,160 --> 00:06:29,820
ستكون تلك خسارة كبيرة، أليس كذلك؟

77
00:06:30,200 --> 00:06:33,490
.لا، أرفض بكلّ تواضع

78
00:06:34,010 --> 00:06:36,540
حتّى وإن أصبحت عاريًا
،ولا أرتدي سوى الفوندوشي

79
00:06:36,540 --> 00:06:39,210
.فأنا أرفض التّخلّي عن الاستمتاع أثناء الطّبخ

80
00:06:40,980 --> 00:06:42,630
.توقّعتُ ذلك

81
00:06:42,630 --> 00:06:45,590
.رفض يوكيهيرا قبلك أيضًا

82
00:06:45,590 --> 00:06:49,260
أعتقد أنّني حقًّا لستُ أهلاً
.لأتميّز على البقيّة

83
00:06:49,260 --> 00:06:53,640
أنا واثق تمامًا أنّ أيّ شخص كان
.ليرفض تحت تلك الظّروف

84
00:06:55,140 --> 00:06:56,230
...إيشّيكي

85
00:06:56,230 --> 00:06:58,770
ماذا؟ هل ستقومين بتشجيعي؟

86
00:06:58,770 --> 00:06:59,640
—ما

87
00:06:59,640 --> 00:07:03,230
كلاّ! كنتُ سأخبرك فقط أنّه كان
.من المستحيل أن تفوز

88
00:07:04,060 --> 00:07:05,940
.تعرف ذلك أفضل من غيرك

89
00:07:05,940 --> 00:07:09,050
.هذا هو تسوكاسا-سينباي

90
00:07:09,050 --> 00:07:11,910
الشّيء الوحيد الّذي يدور في باله
.هو تحسين طبخه

91
00:07:11,910 --> 00:07:14,700
.لذلك هو الأفضل. إنّه لا يُقهر

92
00:07:14,700 --> 00:07:15,910
أهذا رأيك؟

93
00:07:17,210 --> 00:07:20,620
حسنًا... أعتقد أنّ كلّ ما علينا
.هو ترك البقيّة لهذين الاثنين

94
00:07:20,620 --> 00:07:23,570
.بهذا تنتهي مباريات اليوم

95
00:07:23,990 --> 00:07:26,300
...وفي شوكوغيكي الفٍرق غدًا

96
00:07:26,730 --> 00:07:30,370
.بقي اثنان فقط من كلّ فريق

97
00:07:30,370 --> 00:07:35,550
إن بقي طاهٍ واحد فقط من كلّ
...فريق، فسنعقد جولة سادسة

98
00:07:35,550 --> 00:07:36,860
!كلّا

99
00:07:37,430 --> 00:07:42,310
ستكون المعركة القادمة في الجولة الخامسة
.المباراة الأخيرة في شوكوغيكي الفِرق

100
00:07:42,310 --> 00:07:44,520
!ستكون الجولة الأخيرة

101
00:07:45,130 --> 00:07:46,480
جدّي؟

102
00:07:46,480 --> 00:07:47,820
ما الّذي يعنيه؟

103
00:07:47,820 --> 00:07:49,440
المباراة التّالية ستكون الأخيرة؟

104
00:07:49,440 --> 00:07:52,590
.سنغيّر شكل التّنافس

105
00:07:52,590 --> 00:07:55,630
.سيقدّم كِلا الطّاهيين من الفريقين طبقًا واحدًا

106
00:07:55,630 --> 00:08:00,120
سيقدّمون أطباقهم على
.شكل وجبة من طبقين

107
00:08:00,370 --> 00:08:03,250
،سيحضّر أحدهما فاتح الشّهيّة

108
00:08:03,250 --> 00:08:06,420
.وسيحضّر الثّاني الطّبق الرّئيسيّ

109
00:08:06,420 --> 00:08:07,980
...سنقدّم وجبة

110
00:08:07,980 --> 00:08:09,050
من طبقين؟

111
00:08:09,050 --> 00:08:12,800
.ماذا؟ سنحكم على الطّبقين كواحد إذًا

112
00:08:14,220 --> 00:08:15,260
.يبدو هذا ممتعًا

113
00:08:15,900 --> 00:08:16,720
.نعم

114
00:08:16,720 --> 00:08:21,980
،بإمكانكم استعمال أيّ مكوّنات تريدون
لكنّ الموضوع العامّ سيكون

115
00:08:22,450 --> 00:08:25,150
."وجبة ذوّاقة حقيقيّة متعدّدة الأطباق"

116
00:08:25,500 --> 00:08:28,110
هل من اعتراضات أيّها المدير؟

117
00:08:28,110 --> 00:08:31,360
.كلاّ، أعتقد أنّها فكرة ممتازة

118
00:08:31,980 --> 00:08:35,240
مسرحيّة موسيقيّة للذّوّاقة من
...إعداد تسوكاسا وكوباياشي

119
00:08:35,240 --> 00:08:37,570
.سيكون امتيازًا أن نتذوّق ذلك في منافسة

120
00:08:38,020 --> 00:08:39,120
،فقبل كلّ شيء

121
00:08:39,120 --> 00:08:43,540
تتضمّن النّخبة العشرة الحاليّة طهاةً
.يجسّدون المعنى المثاليّ للذّوّاقة

122
00:08:43,540 --> 00:08:47,750
لكن في مستواها الحاليّ، لن تكون إرينا
.قادرة على تقديم طعام ذوّاقة حقيقيّ

123
00:08:49,180 --> 00:08:51,450
.أعرف ذلك أفضل من غيري

124
00:08:51,450 --> 00:08:53,090
.أتساءل بشأن صحّة ذلك

125
00:08:53,670 --> 00:08:56,130
.أعتقد أنّني تغيّرتُ كثيرًا

126
00:08:56,130 --> 00:08:59,390
واثقة أنّ طبقي لن يكون شيئًا
.كان بمقدوري إعداده سابقًا

127
00:09:00,930 --> 00:09:04,500
صغيرتك إرينا قد أصبحت فتاة
.جانحة قد هربت من المنزل

128
00:09:04,500 --> 00:09:08,810
.لم أعد صغيرتك المطيعة يا والدي

129
00:09:08,810 --> 00:09:10,020
!ناكيري-سان

130
00:09:10,020 --> 00:09:11,480
.أحسنتِ القول

131
00:09:12,690 --> 00:09:17,140
التّمرّد في سنّ المراهقة
.أمر طبيعيّ تمامًا

132
00:09:17,140 --> 00:09:18,780
.أنا أقبل هذه الحقيقة بصفتي والدك

133
00:09:18,780 --> 00:09:21,240
..."وسأرحّب بك في "المركز

134
00:09:21,630 --> 00:09:24,960
.بعد أن أقوم بتطهيرك

135
00:09:24,960 --> 00:09:28,150
.ذلك ضروريّ تمامًا يا إرينا

136
00:09:28,150 --> 00:09:33,210
أنت هي المفتاح لقيادة الطّهاة
.نحو الطّريق الصّحيح

137
00:09:34,530 --> 00:09:37,680
.لنجتمع هنا ثانية غدًا

138
00:09:38,290 --> 00:09:41,140
!سيقرّر المنتصر مستقبل أكاديميّة توتسكي

139
00:09:41,640 --> 00:09:45,350
!قدّموا أفضل ما لديكم أيّها الطّهاة اليافعين

140
00:09:45,350 --> 00:09:49,060
نعم... قد يتمكّن هذان الاثنان
.من الفوز بالفعل

141
00:09:49,060 --> 00:09:53,190
كلّ من يوكيهيرا-كُن وناكيري-سان
.قد نضجا كطاهيين

142
00:09:53,580 --> 00:09:57,650
واثقة من قدرتهما على إعداد طبقين قادرين
...على هزيمة صاحبَي الرّتبتين الأولى والثّانية

143
00:09:57,650 --> 00:09:59,360
!بقوّتهما الحاليّة

144
00:10:03,670 --> 00:10:04,980
.كوباياشي-سينباي

145
00:10:06,100 --> 00:10:08,490
هلّي أن أطرح عليك سؤالاً؟

146
00:10:08,490 --> 00:10:09,210
ماذا؟

147
00:10:09,610 --> 00:10:11,170
ماذا تريد يا ألديني؟

148
00:10:11,170 --> 00:10:14,630
.أعتذر إن كنتُ مخطئًا تمامًا بشأن هذا

149
00:10:14,630 --> 00:10:17,880
لكنّني أردتُ أن أسألك عن لحظة قلقك

150
00:10:17,880 --> 00:10:19,720
.الّتي شعرتُ بها أثناء مباراتنا الأخيرة

151
00:10:19,720 --> 00:10:23,930
ممّاذا أنت خائفة يا كوباياشي-سينباي؟

152
00:10:27,020 --> 00:10:29,350
!غبيّ! من الّتي تصفها بالخائفة؟

153
00:10:29,350 --> 00:10:31,330
!لا فكرة لديّ عمّ تتحدّث

154
00:10:31,330 --> 00:10:35,430
!يا إلهي، من تظنّ نفسك؟
!شقيّ غبيّ

155
00:10:35,430 --> 00:10:37,110
مهلاً، ما كان ذلك؟

156
00:10:37,730 --> 00:10:39,660
هل أغضبتَ ريندو-سينباي؟

157
00:10:39,660 --> 00:10:40,570
...لا

158
00:10:45,530 --> 00:10:49,850
.غدًا سينتهي شوكوغيكي الفِرق أخيرًا
.سيتمّ تقرير كلّ شيء

159
00:10:49,850 --> 00:10:51,330
.أشعر بالتوتر

160
00:10:51,330 --> 00:10:54,580
.من المستحيل أن أستطيع النّوم اللّيلة

161
00:10:54,580 --> 00:10:56,950
ألا يوجد ما نستطيع فعله؟

162
00:10:56,950 --> 00:11:00,910
إنّ يوكيهيرا وإرينا يقاتلان من أجل
.إبطال قرار طردنا

163
00:11:00,910 --> 00:11:02,770
ربّما بإمكاننا المساعدة
.بالتّحضير أو ما شابه

164
00:11:02,770 --> 00:11:04,180
.لا، لا

165
00:11:04,560 --> 00:11:08,140
،كلّما تدخّل الآخرون
.فسيضيّعون وقتًا أكبر

166
00:11:08,490 --> 00:11:10,980
...لكنّ عدم القيام بأيّ شيء

167
00:11:10,980 --> 00:11:15,690
.أعتقد أنّه من واجبنا أن نؤمن بهما فحسب

168
00:11:16,900 --> 00:11:19,280
!إضافة إلى أنّ النّوم متأخّرًا يؤذي بشرتي

169
00:11:19,610 --> 00:11:22,020
!اذهبوا للنّوم في الحال، أسمعتموني؟

170
00:11:22,020 --> 00:11:22,740
...حسنًا

171
00:11:24,070 --> 00:11:25,410
.لنراجع هذا ثانية

172
00:11:25,960 --> 00:11:29,730
،سأقوم بهذا هكذا وأقدّم الطّبق الرّئيسيّ
.ثم ذلك وأفوز بالمنافسة

173
00:11:29,730 --> 00:11:32,870
لذا أعدّي فاتح شهيّة يتماشى معه
.فحسب، لا أكثر ولا أقلّ

174
00:11:32,870 --> 00:11:35,750
!لماذا لا تفكّر في الأمور مليًّا أبدًا؟

175
00:11:35,750 --> 00:11:40,860
سأعطيك محاضرة قيّمة
!عن الوجبات الأنيقة بحقّ

176
00:11:41,370 --> 00:11:45,050
...صراخ، صراخ، صراخ

177
00:11:42,540 --> 00:11:45,050
.من النّادر رؤية هذين الاثنين مختلفين هكذا

178
00:11:45,050 --> 00:11:48,560
.ليس لدينا الكثير من الوقت
ما الّذي سنفعله؟

179
00:11:49,060 --> 00:11:50,810
...الجوّ بارد

180
00:11:51,240 --> 00:11:54,310
.بهذا ستكتمل الوجبة الّتي سنقدّمها غدًا

181
00:11:56,670 --> 00:11:58,650
أتسمعني يا تسوكاسا؟

182
00:11:59,690 --> 00:12:02,860
.آسف. نعم، سيكون ذلك جيّدًا

183
00:12:02,860 --> 00:12:06,120
طبق سُمّان محشوّ بالرّيزوتّو والبيض
!بأسلوب يوكيهيرا محسّن وجديد

184
00:12:06,120 --> 00:12:09,370
!معكرونة العدّ العكسيّ بكاري المابو
!بشكل جديد ومحسّن

185
00:12:09,750 --> 00:12:12,460
!كلاهما من اختصاصي

186
00:12:13,460 --> 00:12:16,440
.ليسا عميقين كفاية ليكونا طبقًا رئيسيًّا

187
00:12:16,440 --> 00:12:19,670
لم يُستعملا كأطباق رئيسيّة
في مطعم شينوز، صحيح؟

188
00:12:19,670 --> 00:12:21,170
.هذا كفيل بإقناعك

189
00:12:21,650 --> 00:12:25,310
من الصّعب جدًّا تقديم معكرونة
.مابو كطبق رئيسيّ

190
00:12:25,310 --> 00:12:27,410
واضح تمامًا أنّك لم تفكّر
مليًّا في أيّ طبق آخر

191
00:12:27,410 --> 00:12:29,600
في هذه الوجبة بهذين الطّبقين
.السّخيفين. عرضك مرفوض

192
00:12:30,170 --> 00:12:33,210
إلى اللّقاء. احرص على
.أن ترتاح جيّدًا يا تسوكاسا

193
00:12:33,210 --> 00:12:34,310
.وأنت أيضًا يا ريندو

194
00:12:34,700 --> 00:12:36,030
.تصبحين على خير

195
00:12:39,430 --> 00:12:40,860
.كوباياشي

196
00:12:40,860 --> 00:12:41,690
ميغيشيما؟

197
00:12:41,690 --> 00:12:45,570
.آسف لأنّني لم أستطع هزيمتك

198
00:12:46,130 --> 00:12:48,530
—ميغيشيما، لماذا أنت

199
00:12:48,530 --> 00:12:55,000
الأمر واضح لي. إنّ أكثر المنزعجين
.بشوكوغيكي الفِرق هذا هو أنت

200
00:12:56,460 --> 00:12:59,920
.لا أقول هذا وكأنّه أمر شخصيّ
.إنّها استراتيجيّة

201
00:13:00,380 --> 00:13:04,510
بصفتي الأكثر خبرة بيننا، فأنا من يجب
.أن تقرّر من سيطبخ طبق الوجبة الرّئيسيّ

202
00:13:04,510 --> 00:13:07,760
.ماذا؟ لم يقرّر أيّ أحد أنّك أفضل منّي

203
00:13:07,760 --> 00:13:10,100
كنتُ صاحبة الرّتبة العاشرة
.في النّخبة العشرة

204
00:13:10,100 --> 00:13:12,600
.أنت كنتَ مجرّد تلميذ عاديّ
.الأمر واضح وضوح الشّمس

205
00:13:12,600 --> 00:13:15,500
تخلّيتٍ عن مقعدك بين النّخبة
!العشرة في ذلك اليوم

206
00:13:15,500 --> 00:13:17,080
!هذا يعني أنّك تلميذة عاديّة أيضًا

207
00:13:17,080 --> 00:13:18,190
!لا تدقّق على التّفاصيل

208
00:13:18,190 --> 00:13:20,450
...صراخ، صراخ، صراخ، صراخ

209
00:13:20,450 --> 00:13:22,650
إلى متى سيواصلان هذا؟

210
00:13:23,430 --> 00:13:25,960
.كانت الأمور أكثر متعة في السّابق

211
00:13:25,960 --> 00:13:29,030
.كنّا نبجّل أشياء بعيدة عن متناولنا بكلّ براءة فقط

212
00:13:29,410 --> 00:13:33,870
لم أفكّر أبدًا كيف سيكون الوضع
.عندما نحصل على تلك الأشياء

213
00:13:44,370 --> 00:13:46,720
طيور السّنونو رائعة، صحيح؟

214
00:13:47,070 --> 00:13:49,720
!انظر إلى أيّ علوّ يمكنها الطّيران

215
00:13:49,720 --> 00:13:54,180
.نحن نشاهدها منذ نصف ساعة
.أنت غريبة جدًّا يا ريندو

216
00:13:54,610 --> 00:13:57,060
!لكنّني لستُ غريبة بقدرك أنت

217
00:13:57,060 --> 00:13:59,690
،تواصل قول أنّك تريد أن تكون مثاليًّا أكثر

218
00:13:59,690 --> 00:14:03,480
.لذلك تلاحق الأساتذة طوال الوقت

219
00:14:03,480 --> 00:14:05,860
!يبدو ممتعًا للغاية

220
00:14:06,300 --> 00:14:11,690
،إنّ ذلك... إن أردنا النّجاة في توتسكي
.فعلينا العمل بجدّ أكثر

221
00:14:12,300 --> 00:14:16,620
.وبسبب ذلك، أنت الأوّل في فصلنا

222
00:14:16,970 --> 00:14:19,620
أريد صقل مهاراتي أكثر من أيّ أحد

223
00:14:19,970 --> 00:14:22,630
والوصول إلى الرّتبة الأولى
.في النّخبة العشرة

224
00:14:23,960 --> 00:14:26,340
،إن كنت ستحتلّ الرّتبة الأولى
.فسأحتلّ أنا الثّانية

225
00:14:26,340 --> 00:14:27,430
ماذا؟

226
00:14:27,430 --> 00:14:30,340
استهداف القمّة يبدو ممتعًا
.أكثر إن كنّا معًا

227
00:14:30,340 --> 00:14:31,550
...أ-أكيد

228
00:14:31,930 --> 00:14:35,270
!أجل! سنستولي نحن الاثنان على توتسكي

229
00:14:35,270 --> 00:14:36,470
.بالطّبع

230
00:14:38,910 --> 00:14:40,900
...وثّم أصبحنا أنا وتسوكاسا

231
00:14:40,900 --> 00:14:44,860
صاحبَي الرّتبتين الأولى والثّانية
.بين نخبة توتسكي العشرة حقًا

232
00:14:47,790 --> 00:14:49,330
،تسوكاسا-سينباي

233
00:14:49,330 --> 00:14:53,250
ألم يكن عليك الذّهاب لحضور وليمة
ذوّاقة رفقة ريندو-سينباي بعد هذا؟

234
00:14:53,250 --> 00:14:55,620
.نعم... لكن لا أستطيع إنهاء العمل بسرعة

235
00:14:55,980 --> 00:14:59,580
.حسنًا. سنساعدك أنا وبوتشي

236
00:14:59,900 --> 00:15:02,310
.سأتولّى أمر أوراق تدبير الميزانيّة

237
00:15:02,310 --> 00:15:04,550
.أنا خبير عندما يتعلّق الأمر بعدّ المال

238
00:15:05,220 --> 00:15:08,010
تسوكاسا عديم الفائدة في
،أيّ شيء آخر عدى الطّبخ

239
00:15:08,870 --> 00:15:12,470
لكنّه واصل العمل بجدّ ليتمكّن
.من صقل حرفته

240
00:15:12,780 --> 00:15:16,430
.هذا طبقّ 100 علامة حتمًا
.أنت مذهل يا تسوكاسا إيشي

241
00:15:16,430 --> 00:15:18,390
!لا عجب أنّه الأوّل

242
00:15:18,390 --> 00:15:20,920
.توتسكي مدرسة مذهلة حقًا

243
00:15:20,920 --> 00:15:23,770
!صحيح، وهو التّلميذ الأوّل

244
00:15:29,390 --> 00:15:32,610
ماذا؟ لماذا شعرتُ بالإزعاج للتّوّ؟

245
00:15:33,820 --> 00:15:38,790
مرحبًا بكم في وليمة الأعضاء
.المميّزين في فندق كايزر الكبير

246
00:15:38,790 --> 00:15:42,100
،نرحّب اليوم بيننا بتسوكاسا إيشي-كُن

247
00:15:42,100 --> 00:15:46,410
صاحب الرّتبة الأولى في النّخبة
.العشرة لأكاديميّة توتسكي المرموقة

248
00:15:47,140 --> 00:15:49,380
.تطلّعوا قُدمًا لما لديه ليقدّمه لكم

249
00:15:49,380 --> 00:15:51,170
.تهانينا يا تسوكاسا

250
00:15:51,170 --> 00:15:54,910
تمّت دعوتك للولايات المتّحدة
.للطّبخ في مكان رائع كهذا

251
00:15:54,910 --> 00:15:55,910
!هذا لذيذ

252
00:15:55,910 --> 00:15:57,560
.مذهل بالفعل

253
00:15:57,560 --> 00:15:58,750
.يمكنني رؤية لماذا هو الأوّل

254
00:15:59,520 --> 00:16:00,270
.نعم

255
00:16:01,020 --> 00:16:02,520
...يا إلهي

256
00:16:06,210 --> 00:16:07,400
!أحسنت عملاً

257
00:16:07,400 --> 00:16:09,260
!أبدعتَ يا تسوكاسا

258
00:16:09,260 --> 00:16:13,530
وخاصّة الطّبق الرّئيسيّ! لا بدّ أنّ اختيار
.تلك الصّلصة كان صعبًا للغاية

259
00:16:13,530 --> 00:16:16,030
.شـ... شكرًا لك يا ريندو

260
00:16:16,600 --> 00:16:19,690
.صحيح، كانت تلك وليمة فظيعة

261
00:16:19,690 --> 00:16:21,750
.كانت فظيعة جدًّا لدرجة أنّها كانت ممتعة

262
00:16:21,750 --> 00:16:23,960
ماذا؟ من تكون؟

263
00:16:24,300 --> 00:16:28,120
تسوكاسا إيشي-كُن، إنّ الشّغف
الّذي وضعتَه في تلك الوجبة

264
00:16:28,120 --> 00:16:31,300
لم يصل إلى أيّ أحد
.من الخنازير في تلك الغرفة

265
00:16:33,030 --> 00:16:38,220
...وطبقك الرّئيسيّ لهذا اليوم
.حتّى أنت لم تعتقد أنّه 100 كاملة

266
00:16:38,710 --> 00:16:39,680
هل أنا محقّ؟

267
00:16:41,950 --> 00:16:46,690
هل ما قاله غريب الأطوار ذاك
ما زال يؤثّر فيك؟

268
00:16:47,070 --> 00:16:51,320
،أحبّ الحاضرون ذلك الطّبق بالفعل
.وأنا أيضًا وجدتُه مذهلاً

269
00:16:51,320 --> 00:16:57,160
أجهل السّبب، ولكن كلّما أثنى شخص
،لا أعرفه على طبقي مؤخّرًا

270
00:16:57,160 --> 00:16:59,690
.يُغضبني ذلك كثيرًا

271
00:16:59,690 --> 00:17:00,370
تسوكاسا؟

272
00:17:00,940 --> 00:17:06,210
لكنّه كان الشّخص الوحيد
.الّذي وصف وليمتي بالفظيعة

273
00:17:08,550 --> 00:17:09,800
،مذّاك الحين

274
00:17:09,800 --> 00:17:12,880
...كان تسوكاسا، ومن دون علمي

275
00:17:16,510 --> 00:17:19,010
.مرحبًا. لقد تقابلنا في فيغاس

276
00:17:19,010 --> 00:17:20,470
.يا لها من صدفة

277
00:17:20,470 --> 00:17:24,130
صدفة؟ يبدو لي وكأنّك
.قد عرفتَ أنّني سأكون هنا

278
00:17:24,130 --> 00:17:26,390
.لدعنا نفرح بهذا اللّقاء

279
00:17:26,390 --> 00:17:29,900
.أنا واثق أنّك مهتمّ بي أيضًا

280
00:17:30,690 --> 00:17:33,610
.لنفترض أنّ باولو بيكاسّو ما زال حيًّا

281
00:17:33,610 --> 00:17:34,910
ماذا؟

282
00:17:34,910 --> 00:17:37,740
،إن كان سيُعلن عن لوحته الجديدة

283
00:17:37,740 --> 00:17:41,280
فهل كنتَ لتستطيع الحكم عليها
إن كانت تحفة فنّيّة أم لا؟

284
00:17:41,280 --> 00:17:45,450
.لا أعتقد ذلك. لستُ خبيرًا في الرّسم

285
00:17:45,450 --> 00:17:49,450
أمّا في الموسيقى، فيمكنني على
الأقلّ تقدير ما تقدّمه كلّ آلة

286
00:17:49,450 --> 00:17:51,840
.لقطعة موسيقيّة ما

287
00:17:52,420 --> 00:17:55,310
لنغيّر الموضوع للطّبخ لتتمكّن
.من استيعابه بشكل أبسط

288
00:17:55,310 --> 00:18:00,370
ستكون حينها قادرًا على تمييز الهدف
والتّصميم لطبق ما، صحيح؟

289
00:18:00,850 --> 00:18:03,770
لكن من يفتقرون لذلك الحسّ أو الإدراك

290
00:18:04,270 --> 00:18:09,480
فستكون ردّة فعلهم نفسها دائمًا
،مهما عملتَ أو كرّستَ في طبق ما

291
00:18:09,480 --> 00:18:11,580
.أو كم تحدّيتَ نفسك فيه

292
00:18:12,190 --> 00:18:14,760
كلّ أولئك النّاس قد أثنوا على طبقك

293
00:18:14,760 --> 00:18:18,110
.فقط لأنّك تحمل لقب صاحب الرّتبة الأولى

294
00:18:18,110 --> 00:18:21,120
وقد سئمتَ من ذلك، صحيح؟

295
00:18:21,660 --> 00:18:27,700
عليك استعمال طاقتك
.لأولئك الّذين يفهمونك فعلاً

296
00:18:28,190 --> 00:18:30,330
.أشخاص مثلي أنا مثلاً

297
00:18:32,290 --> 00:18:33,800
،ومذّاك الحين

298
00:18:33,800 --> 00:18:36,760
كان تسوكاسا يقوم بكلّ ما بوسعه
.للحصول على عمل في أمريكا

299
00:18:37,440 --> 00:18:39,810
لم أكتشف إلاّ لاحقًا

300
00:18:39,810 --> 00:18:43,430
بأنّه كان يقابل ناكيري أزامي
.هناك مرّات عدّة

301
00:18:43,830 --> 00:18:46,640
ماذا في رأيك المقصود بصقل
مهاراتك في الطّبخ؟

302
00:18:46,640 --> 00:18:47,600
ماذا؟

303
00:18:47,600 --> 00:18:51,350
.أحيانًا، يبدو الطّبخ كأرض قفِرة واسعة

304
00:18:51,350 --> 00:18:53,740
.لكن في الحقيقة، الأمر ليس كذلك

305
00:18:53,740 --> 00:18:57,070
.لطالما كان للطّبخ هدف واضح

306
00:18:57,070 --> 00:18:59,520
،ما دام أنّه أُعدّ كما يجب

307
00:18:59,520 --> 00:19:03,530
،بإمكان الجميع الوصول إليه بسلام
.باستعمال أسرع الطّرق

308
00:19:03,530 --> 00:19:05,990
...لكن كيف يمكن

309
00:19:05,990 --> 00:19:09,500
.لا تصغِ أبدًا لما لدى أولئك الخنازير ليقولونه

310
00:19:09,500 --> 00:19:13,870
كلّ ما تحتاجه هي بوصلة
مناسبة ستقودك

311
00:19:13,870 --> 00:19:16,480
.للطّريق الصّحيح بكلّ دقّة

312
00:19:16,480 --> 00:19:19,470
.شيء قد ينقذ كلّ الطّهاة من معاناتهم

313
00:19:20,370 --> 00:19:23,680
.وهو "لسان الإله" الّذي تملكه ابنتي

314
00:19:23,680 --> 00:19:25,930
...لسان الإله"؟ ذلك يعني"

315
00:19:25,930 --> 00:19:30,640
أنت تعرفها حقّ المعرفة. إنّها صاحبة
.الرّتبة العاشرة في النّخبة، ناكيري إرينا

316
00:19:31,030 --> 00:19:33,650
.أنا والدها

317
00:19:34,530 --> 00:19:38,290
واثق أنّ ناكيري أزامي كان ينوي
السّيطرة على توتسكي مسبقًا

318
00:19:38,290 --> 00:19:41,320
.عندما كان يتقرّب من تسوكاسا

319
00:19:41,320 --> 00:19:44,780
.من يدري؟ لا أهتمّ لأيّ شيء من ذلك

320
00:19:45,130 --> 00:19:48,110
لماذا دعمتِه؟

321
00:19:48,110 --> 00:19:49,120
...ذلك

322
00:19:50,620 --> 00:19:53,000
.هنالك موجة جديدة قادمة

323
00:19:53,000 --> 00:19:56,960
يبدو أنّ ركوب تلك الموجة
.سيكون أكثر حماسًا

324
00:19:57,310 --> 00:19:58,950
أعتقد لأنّني ظننتُ أنّ بإمكاني

325
00:19:58,950 --> 00:20:01,670
مواصلة إعداد الكثير من الأطباق
.اللّذيذة مع تسوكاسا

326
00:20:02,160 --> 00:20:05,340
حسنًا، عليّ أن أخلد للنّوم باكرًا
.لأكون جاهزة غدًا

327
00:20:05,340 --> 00:20:06,640
!تصبح على خير يا ميغيشيما

328
00:20:21,610 --> 00:20:24,030
.إنّها الجولة الأخيرة من شوكوغيكي الفِرق

329
00:20:24,370 --> 00:20:27,370
.الحضور والحكّام جاهزون

330
00:20:27,370 --> 00:20:30,410
أتساءل أيّ نوع من المعارك
!الحماسيّة سنشاهد اليوم

331
00:20:30,720 --> 00:20:32,540
!لا أطيق الانتظار لأكتشف ذلك

332
00:20:32,970 --> 00:20:37,140
إلى متى سيستمرّ تأثير
شراب الورد خاصتك يا ترى؟

333
00:20:37,140 --> 00:20:41,010
.من يدري؟ لكن لا بأس في رأيي
.إنّها أظرف هكذا

334
00:20:41,330 --> 00:20:44,090
!انظروا الآن لجهة النّخبة العشرة

335
00:20:44,560 --> 00:20:48,050
تسوكاسا إيشي وكوباياشي
!ريندو قد وصلا

336
00:20:49,510 --> 00:20:54,320
أأنت بخير يا تسوكاسا؟ لم تستطع
أن تتخلّص من كلّ تعبك، صحيح؟

337
00:20:54,320 --> 00:20:56,980
.على نحو مفاجئ، لستُ بذلك السّوء

338
00:20:57,440 --> 00:21:01,570
أشعر بأنّني متأهّب أكثر. قد أكون
.في أفضل حالاتي على الإطلاق

339
00:21:01,570 --> 00:21:04,320
كيف ستقسّمان الوجبة بينكما؟

340
00:21:04,320 --> 00:21:08,450
،حسنًا، سأعدّ أنا فاتح الشّهيّة
.وسيعدّ تسوكاسا الطّبق الرئيسيّ

341
00:21:08,450 --> 00:21:11,170
سيعدّ صاحب الرّتبة الأولى
.الطّبق الرّئيسيّ إذًا

342
00:21:11,170 --> 00:21:13,620
.أتساءل كيف سيقسّم فريقنا الوجبة

343
00:21:13,930 --> 00:21:16,850
ميغومي، كيف سارت الأمور ليلة الأمس؟

344
00:21:17,740 --> 00:21:19,400
.يبدون في حالة مزرية

345
00:21:19,400 --> 00:21:20,180
!لكن لماذا؟

346
00:21:20,180 --> 00:21:21,380
كيف سار اجتماع التّفكير بالاستراتيجيّة؟

347
00:21:21,380 --> 00:21:23,190
من سيطبخ ماذا؟

348
00:21:23,190 --> 00:21:24,670
...حسنًا، بشأن ذلك

349
00:21:28,590 --> 00:21:30,170
.حسنًا، ها نحن أولاء يا ناكيري

350
00:21:30,170 --> 00:21:31,220
!أكيد! أرني ما لديك

351
00:21:31,220 --> 00:21:32,720
...في البداية الحجر

352
00:21:32,720 --> 00:21:34,390
!حجر، ورقة، مقصّ

353
00:21:34,390 --> 00:21:35,650
!مرّة أخرى

354
00:21:34,390 --> 00:21:38,520
ما زالا لم يقرّرا ما سيطبخانه؟

355
00:21:35,650 --> 00:21:38,520
!هيّا! هيّا! هيّا

356
00:21:39,860 --> 00:21:41,600
!قضي على عملنا الجماعيّ

357
00:21:41,600 --> 00:21:42,690
!سُحقًا

358
00:21:43,900 --> 00:21:44,610
!هيّا

359
00:21:44,610 --> 00:21:47,150
.سُحقًا، أنا سأعدّ فاتح الشّهيّة

360
00:21:47,150 --> 00:21:50,140
وكلّ ما أردتُه هو إنهاء الجولة
.بأسلوب خاصّ بالطّبق الرّئيسيّ

361
00:21:50,140 --> 00:21:51,600
.لم يكن هنالك أدنى شكّ

362
00:21:51,600 --> 00:21:54,950
.يبدو أنّ المتمرّدان يثيران جلبة هناك

363
00:21:55,330 --> 00:21:57,870
!في كلّ الأحوال، هذه هي

364
00:21:59,420 --> 00:22:02,460
!ستبدأ الجولة الأخيرة

365
00:23:35,470 --> 00:23:39,980
...النّبض المُهدى، المُهدى، المُهدى، المُهدى