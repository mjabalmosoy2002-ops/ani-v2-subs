1
00:00:00,490 --> 00:00:02,320
المدرسة؟

2
00:00:03,300 --> 00:00:06,640
بدأت العمل في المزرعة مباشرة
،بعد المدرسة الابتدائيّة

3
00:00:06,640 --> 00:00:09,350
.ولا أملك أيّ ذكريات عن الدّراسة

4
00:00:09,880 --> 00:00:12,980
أظنّ أنّك ذهبت لمدرسة فتيات
في طوكيو، صحيح يا عزيزتي؟

5
00:00:13,710 --> 00:00:16,910
.لم أذهب إلاّ لفترة قصيرة

6
00:00:17,290 --> 00:00:20,910
كانت مدرسة الفتيات تلك
.في طوكيو أشبه بالحلم

7
00:00:21,260 --> 00:00:23,860
،كان بإمكاني تناول الأرزّ الأبيض وقتما أشاء

8
00:00:23,860 --> 00:00:26,070
.وكانت المياه متوفّرة بمجرّد فتح الصّنبور

9
00:00:26,070 --> 00:00:27,910
.هكذا كانت الأمور وقتها

10
00:00:27,910 --> 00:00:31,370
.سلبتنا الحرب كلّ ذلك، لذلك عدت للأرياف

11
00:00:31,930 --> 00:00:34,830
.كان كوني مغطّاة بالوحل أشبه بالعذاب

12
00:00:41,290 --> 00:00:42,270
...لكن

13
00:00:42,810 --> 00:00:44,840
...بعد أن التقيتك يا عزيزي

14
00:00:45,270 --> 00:00:48,950
بدأت أقول لنفسي أنّه لا ضرر
.من بعض الوحل

15
00:00:52,800 --> 00:00:55,880
.لكن كان كلّ شيء موجودًا في طوكيو

16
00:00:55,880 --> 00:00:59,170
.نعم. لم ينقصهم أيّ شيء

17
00:00:59,860 --> 00:01:03,820
لكن هنالك أمور يمكن العثور
.عليها هنا ولا توجد في طوكيو

18
00:01:05,680 --> 00:01:06,950
مثل ماذا؟

19
00:01:07,820 --> 00:01:10,790
.لن أخبرك، سأُبقي ذلك سرًّا

20
00:01:10,790 --> 00:01:13,800
.لا سبب يدعوني للبوح به قبل كلّ شيء

21
00:01:13,800 --> 00:01:15,720
!ما-ماذا؟

22
00:01:15,720 --> 00:01:17,530
!سيقتلني الفضول

23
00:02:49,400 --> 00:02:52,600
".يصير الجدّ عجوزًا ثانية"

24
00:02:53,460 --> 00:02:55,150
ما هذا؟

25
00:02:55,150 --> 00:02:57,420
،يفترض أنّه مفيد لتجنّب الخرف

26
00:02:57,420 --> 00:02:59,640
.طلب منّي أبي إحضاره لكما

27
00:02:59,640 --> 00:03:02,630
...أضواء وامضة على شاشة صغيرة

28
00:03:03,140 --> 00:03:07,170
يجدر أن تكون ألعاب الأطفال عبارة عن
!بطاقات مينكو وخذاريف بيغوما والمطاردة

29
00:03:07,170 --> 00:03:09,660
نعم، نعم. لكنّي سأتركها هنا، موافقان؟

30
00:03:11,890 --> 00:03:15,500
توجد جثث تجول هنا وهناك
!في هذه اللّعبة يا عزيزتي

31
00:03:15,500 --> 00:03:19,790
.مساكين. نامو أميدا بوتسو
.نامو أميدا بوتسو

32
00:03:19,790 --> 00:03:21,860
.المكان خطير بعد هذه النّقطة

33
00:03:21,860 --> 00:03:26,470
شيوري، يستمرّ هذا الرّجل
.في قول نفس الشّيء

34
00:03:26,470 --> 00:03:29,050
.هذا لأنّ اللّعبة بُرمجت على ذلك الشّكل

35
00:03:29,420 --> 00:03:31,650
.حصلتم على أعشاب شافية

36
00:03:31,650 --> 00:03:35,400
إن فتحت صندوقًا في منزل شخص
!آخر دون إذن، فستكون تلك سرقة

37
00:03:35,400 --> 00:03:38,410
!ستُعاقب على هذا الفعل
!سيغضب البوذا بسبب هذا

38
00:03:38,410 --> 00:03:40,690
.هذا أيضًا جزء من اللّعبة

39
00:03:41,030 --> 00:03:45,000
،إن تأذّت الشّخصيّات الرّئيسيّة
تستعيد عافيتها باستعمال أعشاب؟

40
00:03:45,000 --> 00:03:46,450
.إنّهم أشخاص خارقون

41
00:03:46,450 --> 00:03:50,160
.عرفتُ أنّ سنّهما سيكون مشكلة

42
00:03:50,160 --> 00:03:52,470
.لن يكونا قادرين على تحمّل ألعاب الفيديو

43
00:03:52,910 --> 00:03:57,000
لم ينتهِ المطاف بهؤلاء على هذا
.الحال لأنّ ذلك ما أرادوه

44
00:03:57,000 --> 00:04:01,590
إذًا سيكون علينا أن نحاول إصابتهم
.مباشرة في الرّأس كي لا يعانوا أكثر

45
00:04:01,590 --> 00:04:03,920
.نعم. تلك أفضل طريقة

46
00:04:11,310 --> 00:04:14,180
.لقد أوقع منشارًا كهربائيًّا يا عزيزي

47
00:04:14,180 --> 00:04:17,810
.لديّ بندقيّة سلفًا، لذلك استعمليه أنت يا عزيزتي

48
00:04:18,770 --> 00:04:21,580
!إنّهم يفسدون حقول الأرزّ يا عزيزي

49
00:04:21,580 --> 00:04:22,770
!ماذا؟

50
00:04:25,150 --> 00:04:27,650
.هذا قاسٍ

51
00:04:29,070 --> 00:04:31,900
لكن لا يمكنني قطعهم بسلاسة
.كما أقطع السّياج النّباتيّ

52
00:04:31,900 --> 00:04:36,280
.حسنًا. لا تتحرّك. أنا أحاول التّصويب عليك

53
00:04:43,190 --> 00:04:47,760
،حصلنا على كلّ الجوائز
.لذلك لم يبق شيء للقيام به في اللّعبة

54
00:04:47,760 --> 00:04:48,820
.غير معقول

55
00:04:54,850 --> 00:04:56,110
.تبًّا

56
00:04:56,110 --> 00:04:58,850
!أهلاً، لم أرك منذ مدّة

57
00:04:58,850 --> 00:05:01,190
!شيوري-تشان

58
00:05:01,190 --> 00:05:03,250
.مينو، كفّي عن الالتصاق بي هكذا

59
00:05:03,250 --> 00:05:06,780
ماذا؟ لم نرَ بعضنا منذ مدّة
.ولكنّك تتصرّفين معي ببرود، مياو

60
00:05:06,780 --> 00:05:10,930
نرتاد نفس المدرسة، لكنّنا في مبنيين
.مختلفين، لذلك بالكاد أستطيع رؤيتك

61
00:05:10,930 --> 00:05:12,010
.إنّك مزعجة

62
00:05:12,960 --> 00:05:16,190
.اعتدنا اللّعب معًا طوال الوقت
فما سبب كلّ هذا الجفاء؟

63
00:05:16,190 --> 00:05:18,000
.كان ذلك منذ وقت بعيد

64
00:05:18,000 --> 00:05:23,140
ولكن يا شيورين، لطالما أحببتِ جدّي وجدّتي، صحيح؟

65
00:05:23,140 --> 00:05:25,620
.كما أنّك هنا في منزلهما الآن أيضًا

66
00:05:25,620 --> 00:05:29,730
لديك لسان لاذع، ولكنّك لم تتغيّري
!أبدًا في أعماقك

67
00:05:31,020 --> 00:05:33,940
.ما زلت تتحدّثين عن أمور في الماضي

68
00:05:33,940 --> 00:05:35,980
—إنّ الأمر الآن ليس وكأنّي أحبّهما أو

69
00:05:40,390 --> 00:05:43,730
...عـ-عفوًا يا جدّي، إنّ هذا

70
00:05:43,730 --> 00:05:51,380
.لا-لا بأس يا-يا مينو. أنا بـ-بخير

71
00:05:51,380 --> 00:05:55,450
!هيّا يا شيورين
!عليك أن تسرعي وتسحبي كلامك

72
00:05:51,950 --> 00:05:58,380
.حفيدتي تكرهني. حفيدتي تكرهني
.حفيدتي تكرهني

73
00:05:55,450 --> 00:05:57,790
!لقد عطّلتِ جدّنا بشكل دائم

74
00:05:57,790 --> 00:06:00,890
...هـ-هذا ما تقولين، ولكن

75
00:05:58,380 --> 00:06:00,890
.تكرهني. تكرهني. تكرهني

76
00:06:00,890 --> 00:06:05,080
.لا-لا داعي لـ-للقلق حيال ذ-ذلك

77
00:06:06,800 --> 00:06:11,180
.جدّي، كان ما قلتُه للتّوّ مجرّد تعبير مجازيّ

78
00:06:11,620 --> 00:06:13,050
...كان

79
00:06:13,050 --> 00:06:17,000
...كان كذبة. الحقيقة هي

80
00:06:17,500 --> 00:06:18,700
...الحقيقة هي

81
00:06:19,560 --> 00:06:22,310
...في كلّ الأحوال، أرجوك

82
00:06:24,310 --> 00:06:26,490
.لا تكرهني

83
00:06:33,450 --> 00:06:36,090
!كم أنا مسرور لأنّي عشت طويلاً

84
00:06:36,090 --> 00:06:37,340
!مرحى

85
00:06:37,340 --> 00:06:39,750
!تحسّن حال جدّي

86
00:06:39,750 --> 00:06:41,980
.أتوسّل إليك أن تخرسي

87
00:06:43,600 --> 00:06:45,040
"زوغوري"

88
00:06:45,040 --> 00:06:49,960
الخذاريف المتقاتلة في حفرة
.على شكل طبق في الثّلج

89
00:06:55,130 --> 00:06:56,980
هذا ثانية؟

90
00:06:57,650 --> 00:07:02,610
يراودني هذا الحلم عن ساعة
.رمليّة كلّ ليلة مذ عدتُ شابًّا

91
00:07:02,610 --> 00:07:04,980
.يا له من مكان غريب

92
00:07:04,980 --> 00:07:09,200
.قالت زوجتي أنّها ترى نفس الحلم أيضًا

93
00:07:10,520 --> 00:07:13,540
.مرحنا كثيرًا مذ أن عاد إلينا شبابنا

94
00:07:14,000 --> 00:07:17,880
ما زال هنالك العديد من الأشياء
...الّتي لم نقم بها من قبل

95
00:07:17,880 --> 00:07:21,010
.أشياء كثيرة ما زلت أريد القيام بها لأجلها

96
00:07:21,440 --> 00:07:26,610
وهناك أيضًا رحلة شهر العسل الّتي
.أعدّها يوشياكي والبقيّة من أجلنا

97
00:07:26,610 --> 00:07:30,940
نظرًا للجسد الّذي تملكه زوجتي
.الآن، فأريد اصطحابها

98
00:07:30,940 --> 00:07:35,880
.لا أحد يعلم ما الّذي تخبّئه لنا الحياة

99
00:07:42,600 --> 00:07:45,910
!زتي. عزيزتي...

100
00:07:46,650 --> 00:07:48,290
!عزيزتي

101
00:07:52,150 --> 00:07:54,440
ما الخطب يا عزيزي؟

102
00:07:55,660 --> 00:07:58,210
.عدت عجوزًا كما كنت

103
00:07:58,480 --> 00:07:59,270
ماذا؟

104
00:08:00,320 --> 00:08:02,000
!ماذا؟

105
00:08:03,510 --> 00:08:09,040
في الوقت الحاليّ، لا أشعر بأيّ ألم
.أو ما شابه، لذلك لا داعي للقلق

106
00:08:09,850 --> 00:08:15,940
ولكن يا عزيزتي، أنت تحبّينني
في شبابي أكثر، صحيح؟

107
00:08:16,380 --> 00:08:20,180
رجل عجوز خرف مثلي وأنت كما أنت الآن؟

108
00:08:20,180 --> 00:08:21,710
.نحن أشبه بالقمر وسلحفاة

109
00:08:22,400 --> 00:08:23,710
...عزيزي

110
00:08:24,350 --> 00:08:26,240
.لا تسئ الفهم

111
00:08:26,650 --> 00:08:32,210
الشّخص الّذي أحببت ليس أنت
.في شبابك أو شيخوختك

112
00:08:32,210 --> 00:08:37,230
،إنّه الرّجل المدعوّ سايتو شوزو
.الوحيد في العالم بأسره

113
00:08:37,880 --> 00:08:39,760
.لا تستهن بعمرك

114
00:08:40,260 --> 00:08:43,740
.طوال هذا الوقت، لم نتغيّر على الإطلاق

115
00:08:44,970 --> 00:08:46,660
.هذا صحيح

116
00:08:46,660 --> 00:08:50,660
،ظننتُ أنّ كوني عجوزًا أمر سيّئ

117
00:08:50,660 --> 00:08:55,680
لكنّ ذلك فيه إهانة للحياة
.الّتي عشتها مع زوجتي

118
00:08:55,680 --> 00:08:59,690
كان العمر مجرّد سبب ملائم
.للتّخلّي عن بعض الأشياء

119
00:08:59,690 --> 00:09:02,660
...لقد انغمستُ كثيرًا في عودة شبابي

120
00:09:03,530 --> 00:09:07,050
.نسيت شيئًا كان مهمًّا للغاية

121
00:09:07,860 --> 00:09:09,290
.عزيزتي

122
00:09:10,010 --> 00:09:16,580
إن كان جسدي لا يزال على هذا الحال عندما يحين
.وقت الرّحلة إلى أتامي، فسنذهب في كلّ الأحوال

123
00:09:17,370 --> 00:09:20,870
لا يجب التّخلّي عن الاستمتاع بالحياة
...فقط لأنّي تقدّمت في العمر

124
00:09:20,870 --> 00:09:24,010
!لا أزال شابًّا جدًّا على ذلك

125
00:09:25,240 --> 00:09:29,600
.ما وقعت في حبّه هما تلكما العينين يا عزيزي

126
00:09:32,150 --> 00:09:34,090
.فقدت شعري

127
00:09:35,490 --> 00:09:39,210
أبي، ما الّذي يحدث لجسديكما أنت وأمّي؟

128
00:09:39,210 --> 00:09:41,460
.ذلك ما نودّ معرفته نحن أيضًا

129
00:09:41,460 --> 00:09:44,220
أهذه بقايا من استعادتي لشبابي ثانية؟

130
00:09:45,320 --> 00:09:49,900
تُظهر كليتاك وكبدك علامات
.تقدّم في السّنّ متوقّعة لسنّك

131
00:09:49,900 --> 00:09:51,240
.لذلك لا تضغط على نفسك كثيرًا

132
00:09:53,970 --> 00:09:56,740
كيف هو الوضع إذًا؟

133
00:09:57,000 --> 00:10:00,450
.حسب ما أراه بخصوص حالته الآن، فهو بخير

134
00:10:00,450 --> 00:10:05,250
في الحقيقة، وظائفه الجسديّة أفضل بقليل
.ممّا كانت عليه قبل أن يصبح شابًّا ثانية

135
00:10:06,590 --> 00:10:10,930
لذلك، سيعود جسده إلى سنّه الأصليّ
.بشكل تدريجيّ على الأرجح

136
00:10:10,930 --> 00:10:13,580
.لكنّي قلق عليك أنت أكثر يا أمّي

137
00:10:13,580 --> 00:10:14,620
أنا؟

138
00:10:14,620 --> 00:10:18,910
تملكين الآن جسد امرأة في العشرينات
.من عمرها وفي كامل صحّتها

139
00:10:19,950 --> 00:10:23,640
إن كان جسدك سيتقدّم في العمر
...بشكل تدريجيّ من هذا الوضع

140
00:10:25,420 --> 00:10:30,180
.لا يسعني سوى التّساؤل كم من الوقت ستعيشين

141
00:10:32,310 --> 00:10:35,010
،إنّ موتي لا يخيفني

142
00:10:35,850 --> 00:10:39,060
.ولكن حسب وضعنا هذا، فسيسبقني زوجي أوّلاً

143
00:10:40,050 --> 00:10:42,850
هل سأعيش سبعين سنة أخرى؟

144
00:10:42,850 --> 00:10:45,610
.سيكون تاكاهيرو والبقيّة قد رحلوا عنّا سلفًا

145
00:10:45,610 --> 00:10:48,030
وإن ساءت الأوضاع، فحتّى
...مينو وشيوري قد

146
00:10:49,650 --> 00:10:51,080
.لا أريد ذلك

147
00:10:52,780 --> 00:10:56,780
.لا أريد الموت وحيدة

148
00:10:58,960 --> 00:11:02,850
.أشعر أنّ أمّي أقرب إليه من المعتاد

149
00:11:02,850 --> 00:11:05,360
.حسب منظرهما هذا، يبدوان مثل جدّ وحفيدة

150
00:11:09,590 --> 00:11:12,150
!عاد جدّي وحده كما كان في السّابق

151
00:11:12,150 --> 00:11:15,030
.حدثت أمور كثيرة

152
00:11:15,320 --> 00:11:18,910
ما زلت أتمتّع بالكثير من الحيويّة
.حتّى في وضعي هذا

153
00:11:18,910 --> 00:11:20,410
ماذا؟ فعلاً؟

154
00:11:20,410 --> 00:11:22,900
هل نختبر ذلك؟

155
00:11:24,660 --> 00:11:26,780
.لا تضغط على نفسك كثيرًا يا أبي

156
00:11:27,080 --> 00:11:30,670
.لا داعي للقلق. أنا بخير

157
00:11:31,040 --> 00:11:32,950
.كن حذرًا يا عزيزي

158
00:11:32,950 --> 00:11:34,550
.أعلم ذلك

159
00:11:34,550 --> 00:11:38,150
.أبي، سأعطيك مكافأة إن هزمتني

160
00:11:38,910 --> 00:11:40,550
مكافأة؟

161
00:11:41,280 --> 00:11:43,180
...رحلتك إلى أتامي

162
00:11:43,180 --> 00:11:45,710
.سأحجز لك فيها غرفة بحمّام في الهواء الطّلق

163
00:11:50,860 --> 00:11:53,290
حمّام في الهواء الطّلق؟

164
00:11:57,750 --> 00:12:01,240
!حسنًا. استعدّا يا جدّي وأبي

165
00:12:02,540 --> 00:12:05,240
.قوّة قبضته أقوى بكثير ممّا ظننت

166
00:12:05,720 --> 00:12:09,740
،واثق أنّه قلق من أنّي سأخسر عن قصد
.لذلك ربّما عليّ استعمال بعض القوّة

167
00:12:10,460 --> 00:12:11,760
...استعداد

168
00:12:12,220 --> 00:12:13,210
!انطلاق

169
00:12:22,740 --> 00:12:25,220
!فا-فاز جدّي

170
00:12:25,220 --> 00:12:26,480
عـ-عزيزي؟

171
00:12:31,030 --> 00:12:35,220
مذ صرت عجوزًا ثانية، فكلّما
...ذهبت للتّسوّق مع زوجتي

172
00:12:35,220 --> 00:12:38,190
.يحدّق بنا الكثير من الأشخاص

173
00:12:38,780 --> 00:12:41,410
.واثق أنّنا لا نبدو مثل زوج وزوجة

174
00:12:42,550 --> 00:12:45,460
عزيزي، أيّ لون تفضّل للمجرفة؟

175
00:12:47,880 --> 00:12:49,660
ربّما الأحمر؟

176
00:12:53,880 --> 00:12:56,460
لماذا أنت بعيد عنّي يا عزيزي؟

177
00:12:57,160 --> 00:12:58,790
...لا شيء، لكن

178
00:12:59,210 --> 00:13:02,180
.أشعر أنّ الجميع يحدّق بنا

179
00:13:02,180 --> 00:13:04,290
ولأيّ سبب؟

180
00:13:04,620 --> 00:13:06,970
،لا بأس بوضعنا هكذا في المنزل

181
00:13:06,970 --> 00:13:09,680
...ولكن في أماكن كهذه تعجّ بالنّاس

182
00:13:10,140 --> 00:13:11,500
...فربّما

183
00:13:12,430 --> 00:13:17,340
.ربّما من الأفضل لو تظاهرنا أنّنا لسنا متزوّجان

184
00:13:18,650 --> 00:13:22,320
المعذرة. أهنالك ما أستطيع مساعدتكما به؟

185
00:13:23,580 --> 00:13:26,720
هل تبحث عن هديّة لحفيدتك؟

186
00:13:26,720 --> 00:13:30,710
...لا، نحن... إنّنا

187
00:13:30,710 --> 00:13:34,170
.ربّما من الأفضل أن أتركه يظنّ أنّها حفيدتي

188
00:13:34,170 --> 00:13:38,580
.نـ-نعم، هذا صحيح. أنا أتسوّق مع حفيدتي

189
00:13:38,580 --> 00:13:39,910
.هذا خاطئ

190
00:13:40,970 --> 00:13:42,750
.إنّه زوجي

191
00:13:45,370 --> 00:13:48,300
،لا ألومك لأنّك اعتقدت أنّنا لسنا كذلك

192
00:13:48,300 --> 00:13:51,840
.لكنّنا سنكون شاكرين لتفهّمك يا سيّدي

193
00:13:53,100 --> 00:13:55,850
،أفهم لماذا قد تريد أن تكذب

194
00:13:56,320 --> 00:14:01,340
لكنّي لا أريد أن أكون أيّ شيء
.آخر سوى زوجتك

195
00:14:01,340 --> 00:14:04,850
.أ-أنا آسف يا عزيزتي

196
00:14:05,690 --> 00:14:10,700
لا يمكن العيش في بلاد تتساقط
.فيها الثّلوج بدون هذه

197
00:14:11,040 --> 00:14:14,130
.إنّه مامي دايفوكو المفضّل لدى زوجتي

198
00:14:14,130 --> 00:14:18,020
.أكلناه معًا كثيرًا مذ عاد إلينا شبابنا ثانية

199
00:14:18,020 --> 00:14:22,550
ولكن مؤخّرًا، توقّفت زوجتي
.عن أكله أمامي

200
00:14:22,550 --> 00:14:27,540
،أخاف الإصابة بالسّكّريّ في شيخوختي
...لذلك لا آكله، لكن

201
00:14:28,270 --> 00:14:31,970
ألن تأكلي ذلك المامي دايفوكو؟

202
00:14:31,970 --> 00:14:35,440
.لا، لستُ جائعة في الوقت الحاليّ

203
00:14:35,830 --> 00:14:38,110
.سآكله لاحقًا، فلا داعي للقلق

204
00:14:39,140 --> 00:14:40,430
هكذا إذًا؟

205
00:14:46,310 --> 00:14:51,070
ما زال زوجي يشعر ببعض تأثيرات
،العودة للشّباب

206
00:14:51,070 --> 00:14:53,420
.ولكن من الممكن أن يعود مرضه القديم

207
00:14:54,380 --> 00:14:57,150
.يحبّ زوجي المامي دايفوكو أيضًا

208
00:14:57,590 --> 00:15:00,370
.وأنا أحبّ الحلويّات

209
00:15:02,710 --> 00:15:06,640
،لكنّه يراقب صحّته ولا يأكله

210
00:15:06,640 --> 00:15:08,500
.لذلك لا أستطيع أكله أمامه

211
00:15:09,650 --> 00:15:12,370
،أعلم أنّي أبالغ في مراعاة مشاعره

212
00:15:12,960 --> 00:15:17,620
،ولكن إن كان قربي
.فلا يمكنني أكل هذا المامي دايفوكو

213
00:15:17,620 --> 00:15:19,250
.عزيزتي

214
00:15:19,730 --> 00:15:21,690
عـ-عزيزي؟

215
00:15:21,690 --> 00:15:25,120
...أنا كنت... إنّ هذا

216
00:15:25,120 --> 00:15:28,920
أقسم أنّي لم أكن أحاول أكله
!من وراء ظهرك

217
00:15:28,920 --> 00:15:31,820
.كفّي عن التّصرّف بمراعاة تجاهي

218
00:15:32,260 --> 00:15:34,370
.لا تقومين بأيّ شيء خاطئ

219
00:15:34,370 --> 00:15:37,070
...بالنّسبة لي يا عزيزتي

220
00:15:39,890 --> 00:15:46,230
فإنّ رؤية وجهك السّعيد بينما تأكلين
.هذا هو أفضل دواء لي

221
00:15:50,170 --> 00:15:52,700
عجوزان يأكلان وجبة خفيفة
...في منتصف اللّيل

222
00:15:52,700 --> 00:15:54,080
.إنّنا نسيء التّصرّف هكذا

223
00:15:54,080 --> 00:15:56,730
.لا بأس إن أكلتُ القشرة الخارجيّة فقط

224
00:15:58,310 --> 00:16:01,110
.مامي دايفوكو من المتجر المحلّيّ

225
00:16:01,110 --> 00:16:04,150
يُباع بالكامل في الحال، لذلك
.فإنّ الحصول عليه أمر صعب

226
00:16:05,600 --> 00:16:10,160
،بعد وفاة أبي وأمّي وفقداني لمنزلي

227
00:16:10,160 --> 00:16:14,370
ذهبت للعيش مع أقارب لي
.من جهة أمّي وعملت لديهم

228
00:16:15,940 --> 00:16:19,370
.كان أبي غنيًّا جدًّا عندما كان حيًّا

229
00:16:19,940 --> 00:16:23,630
بما أنّه كان يتصرّف بتعجرف
،مع عائلة أمّي

230
00:16:23,630 --> 00:16:26,190
.تجنّبني أقاربي

231
00:16:26,760 --> 00:16:28,410
.لا تتحدّث الفتاة كثيرًا

232
00:16:28,410 --> 00:16:31,970
ليست معتادة على المكان. لم تطلب
.الكثير. واضح أنّها فتاة مطيعة

233
00:16:31,970 --> 00:16:35,950
كانت المشكلة الأولى هي عدم
.فهم بعضنا بعضًا

234
00:16:35,950 --> 00:16:39,200
"كانوا يستعملون عبارة "كي
."للإشارة لـ"كُلي" و"أعطني هذا

235
00:16:39,620 --> 00:16:41,810
.لم أشعر أنّنا كنّا نتحدّث نفس اللّغة

236
00:16:42,670 --> 00:16:45,790
إنّ ثقافتهم الّتي سمحت لهم
بتحمّل البرد والجوع

237
00:16:45,790 --> 00:16:49,100
.لم تسمح بتقبّل الغرباء بسهولة

238
00:16:50,980 --> 00:16:55,340
جعلني تحدّثي بلهجة طوكيو
.أبدو غير مألوفة لديهم

239
00:16:55,340 --> 00:16:57,550
.وهناك من سخر منّي بسبب ذلك

240
00:17:00,630 --> 00:17:03,660
.لم أشعر بالرّاحة في منزل عائلة أمّي

241
00:17:04,040 --> 00:17:08,930
،لذلك بعد إكمال عملي في الحقول
.كنت أقضي وقتي في الضّريح المحلّيّ

242
00:17:09,490 --> 00:17:10,680
...وذات يوم وأنا هناك

243
00:17:11,640 --> 00:17:17,040
...عفوًا، أظنّ أنّك هي

244
00:17:17,430 --> 00:17:21,180
انتقلت إلى هنا من طوكيو قبل مدّة
.ليست بطويلة واسمي ساساكي

245
00:17:21,180 --> 00:17:24,890
!لا بأس، لا بأس
!لا داعي للنّزول من أجلي

246
00:17:24,890 --> 00:17:26,070
ومن أنت؟

247
00:17:27,080 --> 00:17:29,540
.اسمي سايتو

248
00:17:29,540 --> 00:17:32,150
.أنا أزرع التّفّاح في مكان قريب من هنا

249
00:17:32,150 --> 00:17:36,060
إنّ رؤية فتاة تجلس هنا وحدها
...جعلني أتساءل قليلاً

250
00:17:38,450 --> 00:17:39,810
.انس ذلك رجاءً

251
00:17:39,810 --> 00:17:42,070
هل أنت جائعة؟

252
00:17:44,950 --> 00:17:49,710
لستُ معتادة كم أنّ الطّعام هنا
...مالح وحلو بعد، لذا

253
00:17:52,290 --> 00:17:53,520
ما الخطب؟

254
00:17:54,100 --> 00:17:56,500
.سيكون من الأفضل لك ألاّ تقوم بهذا

255
00:17:56,970 --> 00:17:59,320
.لا بدّ أنّك سمعت الإشاعات عنّي

256
00:17:59,790 --> 00:18:02,450
—أم هل يُعقل أنّك تنوي أن

257
00:18:02,450 --> 00:18:03,970
.لا تقلقي. كلي فحسب

258
00:18:04,670 --> 00:18:07,930
لا أعرف أيّ شيء عمّن تكونين
.أو من أين أتيتِ

259
00:18:08,330 --> 00:18:14,970
،ولكن مهما كان ذلك
.فهو ليس سببًا للبقاء جائعة

260
00:18:14,970 --> 00:18:19,910
إضافة لذلك، لا أريد أن يقول
النّاس أنّ قريتنا لا تستطيع

261
00:18:19,910 --> 00:18:22,120
.مساعدة فتاة في حاجة لا مكان لها لتقصده

262
00:18:23,470 --> 00:18:24,530
!طاب يومك

263
00:18:26,330 --> 00:18:28,840
.إذًا فهنالك أشخاص مثله هنا أيضًا

264
00:18:29,300 --> 00:18:31,300
...في ثقافة التّحمّل هذه

265
00:18:32,050 --> 00:18:35,000
يمكن العثور على الطّيبة؟

266
00:18:37,170 --> 00:18:38,470
.إنّه مالح

267
00:18:43,510 --> 00:18:45,630
أنت لا تتعلّم، صحيح؟

268
00:18:45,630 --> 00:18:48,120
.تواصل الحديث معي يومًا تلو الآخر

269
00:18:48,120 --> 00:18:53,050
،إنّ هذا الضّريح في طريقي للمنزل
.لذلك لا يسعني سوى التّساؤل

270
00:18:53,050 --> 00:18:55,790
محطّة الحافلات على جانب
الجبل أقرب لمنزلك

271
00:18:55,790 --> 00:18:57,700
.وبعيدة عن أنظار النّاس

272
00:18:57,700 --> 00:19:00,440
.أفضّل هذا المكان على ذاك

273
00:19:00,440 --> 00:19:02,080
.أنت فظيع في إدراك الأمور

274
00:19:02,080 --> 00:19:03,640
إدراك؟

275
00:19:04,410 --> 00:19:06,460
.لا تعر كلامي أيّ شأن

276
00:19:06,460 --> 00:19:09,550
،إن كنت لا تفهم ذلك
.فما زال الطّريق طويلاً أمامك

277
00:19:11,290 --> 00:19:13,960
ما الّذي تفعله بجلوسك قربي بمكر هكذا؟

278
00:19:13,960 --> 00:19:14,420
ماذا؟

279
00:19:15,430 --> 00:19:16,550
.آسف

280
00:19:17,080 --> 00:19:21,000
.سيسيء النّاس فهم الوضع إن جلست قربي

281
00:19:21,000 --> 00:19:22,440
.كن حذرًا أكثر رجاءً

282
00:19:22,850 --> 00:19:26,380
.حا-حاضر. مفهوم

283
00:19:26,820 --> 00:19:31,610
يفتقر للاستقرار، ولا يبدو
.أنّه تلقّى تعليمًا جيّدًا

284
00:19:32,090 --> 00:19:36,980
إلى أيّ مدى سيتمكن هذا
الرّجل من التّأثير على قلبي؟

285
00:19:39,010 --> 00:19:40,530
.يستحقّ ذلك المشاهدة

286
00:19:48,080 --> 00:19:51,360
.لقد نجح في التّأثير عليّ بالكامل

287
00:19:52,850 --> 00:19:56,280
.سِكيهان وسوشي الإيناري حلوان جدًّا

288
00:19:57,780 --> 00:19:59,280
!ها هو ذا

289
00:19:59,280 --> 00:20:03,060
.لم يراودني حلم السّاعة الرّمليّة هذا مؤخّرًا

290
00:20:03,060 --> 00:20:06,070
.كنتُ بانتظار هذه اللّحظة

291
00:20:06,070 --> 00:20:11,750
،إن كان قلب السّاعة أعادتي إلى شيخوختي

292
00:20:11,750 --> 00:20:16,780
.فإنّ قلبها مرّة أخرى سيعيدني شابًّا ثانية

293
00:20:17,270 --> 00:20:21,160
،بما أنّ لديّ هذه الفرصة
.فعليّ التّحقّق من الأمر كما يجب

294
00:20:27,710 --> 00:20:30,170
أهذا رمل؟

295
00:20:30,170 --> 00:20:33,530
.يمكنني تخيّل نظرة المفاجأة على وجه زوجتي

296
00:20:40,410 --> 00:20:43,040
!هيّا، تفاجئي يا عزيزتي

297
00:20:43,040 --> 00:20:46,250
احرص على تمشيط شعرك
.الّذي تبعثر أثناء نومك

298
00:20:46,250 --> 00:20:49,380
ماذا؟ تبدو ردّة فعلك مخيّبة
!للآمال قليلاً يا عزيزتي

299
00:20:49,890 --> 00:20:55,290
.هناك أمر يثير فضولي يا عزيزي

300
00:20:57,440 --> 00:21:02,150
هل تعتقد أنّنا لن نتقدّم في العمر أو نموت؟

301
00:21:03,640 --> 00:21:06,820
.أعتقد أنّ ذلك سيحدث على الأرجح

302
00:21:07,380 --> 00:21:11,680
.إنّ السّاعة مجهّزة كي تفقد الرّمل مع الوقت

303
00:21:11,680 --> 00:21:13,720
.ستفرغ من الرّمل بالكامل يومًا ما

304
00:21:14,790 --> 00:21:17,930
لا أدري ما الّذي سيحدث
،عندما سيحدث ذلك

305
00:21:17,930 --> 00:21:22,900
لكن أعتقد أنّ ذلك سيكون نهاية
.معجزة الشّباب هذه

306
00:21:23,300 --> 00:21:27,810
.لا داعي للقلق. لن نعيش للأبد

307
00:21:30,660 --> 00:21:34,120
.لن تكون حياتنا أطول من أبنائنا أو البقيّة

308
00:21:34,120 --> 00:21:39,390
،حسب حالة السّاعة الرّمليّة
.فربّما لدينا بضع سنوات فحسب

309
00:21:43,630 --> 00:21:49,280
أنت الشّخص الوحيد الّذي لن أتركه
.خلفي يا عزيزتي، لذلك لا تقلقي

310
00:21:54,910 --> 00:21:58,470
.شكرًا يا عزيزي

311
00:23:30,860 --> 00:23:33,470
ترتدي زوجتي زيّ بحّارة؟

312
00:23:33,470 --> 00:23:35,210
وزوجي خادم؟

313
00:23:35,530 --> 00:23:39,680
المهرجانات الثّقافيّة ممتعة للغاية، صحيح؟