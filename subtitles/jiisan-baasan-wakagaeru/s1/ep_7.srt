1
00:00:06,740 --> 00:00:09,490
!وصلنا إلى أتامي

2
00:00:10,650 --> 00:00:13,620
!تحقّق حلمنا يا عزيزتي

3
00:00:13,620 --> 00:00:16,700
!أنا شاكرة جدًّا لأبنائنا وعائلاتهم

4
00:00:16,700 --> 00:00:21,540
نحن في أتامي! وهذا مثل فيلم
!"إيزو مونوغاتاري"! "إيزو مونوغاتاري"

5
00:00:22,600 --> 00:00:24,040
،سايتو-ساما

6
00:00:24,370 --> 00:00:29,030
.شكرًا جزيلاً لقطعكم كلّ هذه المسافة إلى هنا

7
00:00:29,340 --> 00:00:32,680
.استرخوا واستمتعوا بوقتكم هنا رجاءً

8
00:00:45,790 --> 00:00:47,240
ما كلّ هذا؟

9
00:00:47,240 --> 00:00:49,270
!لا بدّ أنّ هذا المكان باهظ

10
00:00:49,730 --> 00:00:53,220
تملك هذه الغرفة حمّامًا
.في الهواء الطّلق يا عزيزتي

11
00:00:53,220 --> 00:00:57,200
،لا تمانع مشاركة الغرفة مع الجدّ
صحيح يا شوتا-كُن؟

12
00:00:57,910 --> 00:00:58,990
.لا أمانع

13
00:00:58,990 --> 00:01:04,030
ستكون خسارة ألاّ نستعمل حمّامَ
.هواءٍ طلقٍ مذهلاً مثل هذا

14
00:01:04,030 --> 00:01:07,650
حسنًا يا مينو، أتريدين الذّهاب
للحمّام الكبير معي؟

15
00:01:07,650 --> 00:01:09,000
!هيّا! هيّا

16
00:01:09,410 --> 00:01:11,620
.نحن ذاهبتان للحمّام الآن

17
00:01:11,620 --> 00:01:15,950
يقال أنّه حمّام جيّد جدًّا لأنّ الماء
.يتدفّق مباشرة من المصدر

18
00:01:15,950 --> 00:01:19,270
!حسنًا! سأوافيك في الحال

19
00:01:22,990 --> 00:01:24,180
!عزيزي

20
00:01:25,280 --> 00:01:27,970
.بعد أن ينام الأحفاد

21
00:01:30,280 --> 00:01:34,970
.إن بقيت طويلاً في الحمّام البارد هكذا، فستمرض

22
00:01:34,970 --> 00:01:39,000
.لا، سأكون بخير. هذا مناسب لي الآن

23
00:03:14,390 --> 00:03:18,960
."الجدّ والجدّة في شهر عسلهما: آرك أتامي"

24
00:03:27,320 --> 00:03:30,250
!جدّي متجمّد وعلى وجهه نظرة غريبة

25
00:03:30,250 --> 00:03:32,850
لا، كان هذا ليفاجئ أيّ أحد، صحيح؟

26
00:03:35,940 --> 00:03:37,970
!كم هذا لذيذ

27
00:03:37,970 --> 00:03:41,600
!كلّ شيء رائع، وما عدت أعرف ماذا يحدث

28
00:03:43,880 --> 00:03:46,500
...يا عزيزي، بما أنّها فرصة نادرة

29
00:03:52,710 --> 00:03:56,430
.سامحني اليوم رجاءً يا كبدي

30
00:03:57,430 --> 00:03:59,080
ما الخطب يا شوتا-كُن؟

31
00:03:59,080 --> 00:04:03,920
لا شيء... كنتُ أتساءل فقط
.إن كان يمكنني فعلاً أكل وليمة كهذه

32
00:04:04,470 --> 00:04:08,350
إنّه شهر عسلهما، لكنّ الرّجال
.والنّساء في غرف منفصلة

33
00:04:08,350 --> 00:04:10,700
لا بدّ أنّ ذلك بسببي، صحيح؟

34
00:04:11,240 --> 00:04:14,790
.أنا سعيدة جدًّا لأنّك هنا

35
00:04:15,960 --> 00:04:19,650
بصراحة، لكانت شينجوكو لتكون
.مخيفة إن ذهبت إليها وحدي

36
00:04:20,180 --> 00:04:22,500
،حاول النّاس الحديث معي كثيرًا

37
00:04:22,500 --> 00:04:25,140
.لكنّي كنت مرتاحة ومستمتعة بوقتي بفضلك

38
00:04:25,830 --> 00:04:31,430
.لو لم تكن معنا، على الأرجح أنّنا ما كنّا لنصل إلى هنا

39
00:04:36,640 --> 00:04:41,710
،يمكنكما استعمال العصير
لذلك هلاّ شربتما بنفس الطّريقة معنا؟

40
00:04:41,710 --> 00:04:43,960
ماذا؟ ما الّذي نفعله؟

41
00:04:44,960 --> 00:04:46,740
.نأخذ رشفة في البداية

42
00:04:48,320 --> 00:04:50,070
.ثمّة رشفة ثانية

43
00:04:50,800 --> 00:04:52,100
...وأخرى ثالثة

44
00:04:59,840 --> 00:05:01,840
!ما هذا؟ يا لها من طريقة شرب غريبة

45
00:05:01,840 --> 00:05:06,110
.على مهلك يا عزيزي
أنهيت شرابك بثلاثة رشفات؟

46
00:05:07,160 --> 00:05:08,570
ثلاث رشفات؟

47
00:05:09,740 --> 00:05:14,550
.هذا للتّدريب فحسب
.ما كان الطّفلان ليعرفا بعد

48
00:05:17,360 --> 00:05:20,000
ما الغاية من ذلك يا جدّي؟

49
00:05:20,000 --> 00:05:23,210
.لا فكرة لديّ عمّ يتحدّث

50
00:05:23,210 --> 00:05:25,160
.ستفهمان يومًا ما

51
00:05:26,070 --> 00:05:28,660
!تصبح على خير يا شوتا-كُن

52
00:05:29,320 --> 00:05:31,260
.تـ-تصبحين على خير

53
00:05:32,310 --> 00:05:36,560
لم أتخيّل أبدًا أنّ الوضع سينتهي بي
!بالنّوم في نفس الغرفة مع سايتو-سان

54
00:05:37,260 --> 00:05:41,500
!من الغريب جدًّا ألاّ يناما معًا في شهر عسلهما

55
00:05:41,500 --> 00:05:44,060
.واثقة أنّك ستكونين بخير مع شوتا-كُن

56
00:05:45,440 --> 00:05:47,220
هذا سرّ، مفهوم يا شوتا-كُن؟

57
00:05:47,220 --> 00:05:49,700
.قد يقتلنا أبي إن عرف بالأمر

58
00:05:50,130 --> 00:05:52,080
شوتا-كُن؟

59
00:05:53,070 --> 00:05:56,170
.واثقة أنّهما يعانقان بعضهما الآن

60
00:05:59,340 --> 00:06:02,050
...كلاّ

61
00:06:02,760 --> 00:06:07,160
كان جدّك يحاول الإمساك بيد
،جدّتك هذه الظّهيرة

62
00:06:07,160 --> 00:06:09,120
.لكنّه لم يستطع ذلك

63
00:06:09,120 --> 00:06:11,560
إنّهما مثل المتزوّجين حديثًا، صحيح؟

64
00:06:12,460 --> 00:06:15,190
ماذا سنفعل إن أنجب جدّاي طفلاً آخر؟

65
00:06:15,540 --> 00:06:20,450
شوتا-كُن، هلاّ حاولت مناداتي
عزيزتي" لبعض الوقت؟"

66
00:06:20,450 --> 00:06:22,950
ماذا؟ لماذا تقترحين هذا فجأة؟

67
00:06:22,950 --> 00:06:27,170
أريد أن أشعر بما تشعر به جدّتي
.وأرى كيف هو الأمر

68
00:06:27,170 --> 00:06:29,690
.حـ-حسنًا. سأجرّب ذلك

69
00:06:31,420 --> 00:06:35,100
هل العشاء جاهز يا عزيزتي؟

70
00:06:36,590 --> 00:06:38,010
!أحسنت في تقليده بالفعل

71
00:06:38,660 --> 00:06:40,060
.سأقوم بذلك أيضًا

72
00:06:43,300 --> 00:06:46,720
.تزوّجني رجاءً يا عزيزي

73
00:06:46,720 --> 00:06:50,380
.نحن متزوّجان سلفًا يا عزيزتي

74
00:06:51,840 --> 00:06:56,180
.ينادي جدّاي بعضهما بأسمائهما أحيانًا

75
00:06:56,180 --> 00:06:58,260
.أحبّ عندما يقومان بذلك

76
00:06:59,410 --> 00:07:00,410
.حسنًا

77
00:07:03,880 --> 00:07:04,940
.مينو

78
00:07:08,640 --> 00:07:11,970
.شـ-شوتا-كُن، علينا أن ننام الآن

79
00:07:11,970 --> 00:07:14,240
.نعم، تصبحين على خير

80
00:07:16,460 --> 00:07:20,720
.لندخل الحمّام يا عزيزتي

81
00:07:21,120 --> 00:07:25,560
.يا إلهي. يفكّر في أمور منحرفة حتّى في أحلامه

82
00:07:27,540 --> 00:07:32,180
.لقد شرب بعض السّاكي
.لذلك لا أظنّنا سنأخذ حمّامًا اليوم

83
00:07:33,080 --> 00:07:36,690
!مع أنّه تحدّث كثيرًا عن الذّهاب معًا أيضًا

84
00:07:36,690 --> 00:07:39,730
.أشعر بالغباء لأنّي استعددتُ لذلك نفسيًّا

85
00:07:41,200 --> 00:07:43,740
.نم بهناء اللّيلة

86
00:07:51,770 --> 00:07:54,910
.إنّك تحدّق بطريقة غير محترمة يا عزيزي

87
00:07:56,330 --> 00:07:58,670
أتريد أن ترى بشدّة هكذا؟

88
00:07:58,670 --> 00:08:01,260
.اقترب يا عزيزي

89
00:08:01,890 --> 00:08:03,950
...عـ-عزيزتي

90
00:08:17,030 --> 00:08:18,850
.صباح الخير يا عزيزي

91
00:08:19,780 --> 00:08:23,360
.من المخطّط أن نذهب إلى حمّام مياه البحر اليوم

92
00:08:23,760 --> 00:08:25,870
هل ستذهب وأنت تبدو هكذا؟

93
00:08:30,550 --> 00:08:32,920
!كلاّ

94
00:08:35,690 --> 00:08:38,590
...كان ثدياك هما السّاعة الرّمليّة

95
00:08:38,590 --> 00:08:40,160
.ذلك غير منطقيّ

96
00:08:40,160 --> 00:08:42,380
...كان ثدياك هما السّاعة الرّمليّة

97
00:08:47,610 --> 00:08:50,720
.كان جمالها أشبه بقماش لوحة ناصع البياض

98
00:08:50,720 --> 00:08:54,880
.كانت كلّ العيون في الشّاطئ مركّزة على ذلك

99
00:08:55,630 --> 00:09:01,960
لكنّ الشّخص الّذي كان خلفها
.سلب كلّ تلك النّظرات

100
00:09:06,030 --> 00:09:07,810
...خلف ذلك الجمال الآسر

101
00:09:07,810 --> 00:09:09,350
!يوجد وحش مفتول العضلات

102
00:09:10,890 --> 00:09:13,060
.من المستحيل أن أستطيع التّحدّث معها هكذا

103
00:09:13,060 --> 00:09:16,800
أتريد أن تسابقني إلى هناك يا شوتا-كُن؟

104
00:09:16,800 --> 00:09:18,770
.لا أعتقد أنّ عليك الضّغط على نفسك كثيرًا

105
00:09:18,770 --> 00:09:22,340
،إن كنتَ ستخسر في مواجهة عجوز متهالك مثلي

106
00:09:22,340 --> 00:09:25,160
.فلن أسمح إذًا بأن تكون حفيدتي العزيزة من نصيبك

107
00:09:28,370 --> 00:09:30,530
ألن تسبحي يا جدّتي؟

108
00:09:30,530 --> 00:09:33,220
.في الحقيقة، لا يمكنني الطّفو

109
00:09:33,220 --> 00:09:35,670
.يكفيني أن أقوم بجمع الأصفاد

110
00:09:36,110 --> 00:09:37,440
...ومع ذلك

111
00:09:38,620 --> 00:09:41,620
.مينو، لقد كبرتِ بأكثر من طريقة

112
00:09:42,260 --> 00:09:44,330
!مهلاً! انظروا لهذا

113
00:09:48,330 --> 00:09:49,390
!إنّه عجوز

114
00:09:51,640 --> 00:09:54,120
!إنّ ذلك العجوز يسبح سمكة طائرة

115
00:09:55,200 --> 00:09:58,620
!وكأنّ ذلك العجوز يحلّق في السّماء

116
00:10:03,410 --> 00:10:06,240
.ما زال الطّريق أمامك طويلاً يا شوتا-كُن

117
00:10:06,240 --> 00:10:08,040
!خذي! أجل

118
00:10:08,040 --> 00:10:10,260
.الفائز الجدّ

119
00:10:10,610 --> 00:10:13,040
.أهداني زوجي هذا الفستان

120
00:10:11,670 --> 00:10:17,250
...خياطة، خياطة، خياطة

121
00:10:13,040 --> 00:10:16,180
.كان قصيرًا قليلاً، لذلك أضفت الزّركاش

122
00:10:21,750 --> 00:10:26,150
،تكبّدتِ عناء شراء زيّ سباحة
.لكنّ ذلك ذهب هباءً يا عزيزتي

123
00:10:26,470 --> 00:10:29,870
.أنا أحبّ الاسترخاء في الظّلّ

124
00:10:29,870 --> 00:10:33,750
.إضافة لذلك، لا تنسَ أنّي عجوز في الثّمانين داخلي

125
00:10:33,750 --> 00:10:35,220
.حاول أن تتخيّل ذلك

126
00:10:35,730 --> 00:10:38,400
.تخيّلني أرتدي زيّ سباحة قبل أن أصير شابّة ثانية

127
00:10:38,850 --> 00:10:44,560
،ولكن حتّى في شكلك كعجوز
—أعتقد أنّ زيّ السّباحة سـ

128
00:10:49,010 --> 00:10:51,380
!تحمّل حتّى تُنهي كلامك على الأقلّ

129
00:10:52,800 --> 00:10:53,880
أتريد أن تجرّب؟

130
00:10:53,880 --> 00:10:55,050
.نعم

131
00:10:56,390 --> 00:10:59,210
!أريد التّباهي بعروسي أيضًا

132
00:10:59,210 --> 00:11:01,440
!أنا لستُ مجرّد وحش مفتول العضلات

133
00:11:01,440 --> 00:11:04,380
،عندما يتعلّق الأمر بذلك
.فإنّك تحصد ما تزرعه

134
00:11:05,240 --> 00:11:10,960
،كنتُ دائمًا طريحة الفراش بسبب المرض
وكان الذّهاب للشّاطئ معك والأحفاد

135
00:11:10,960 --> 00:11:13,470
.والاسترخاء هناك فكرة سخيفة

136
00:11:15,610 --> 00:11:20,430
،لكنّ مجرّد تواجدنا هكذا معًا أنا وأنت

137
00:11:20,430 --> 00:11:23,030
.يجعلني أسعد من أيّ وقت آخر

138
00:11:23,030 --> 00:11:24,200
.عزيزتي

139
00:11:25,510 --> 00:11:28,920
.سأذهب لغسل الرّمال عن قدماي

140
00:11:28,920 --> 00:11:30,540
.حسنًا

141
00:11:50,240 --> 00:11:52,910
.ما كنتُ أبدًا لأظهر كلّ هذا للعلن

142
00:11:53,510 --> 00:11:56,390
لا تريدين أن تريني زيّ سباحتك مهما كان؟

143
00:11:56,730 --> 00:11:59,780
.بـ-بعض الأشياء مستحيلة فحسب

144
00:12:00,200 --> 00:12:03,410
.رأيتني عارية عدّة مرّات في السّابق

145
00:12:03,410 --> 00:12:06,100
!ذلك مختلف تمامًا

146
00:12:06,100 --> 00:12:09,670
،يمكنني رؤيتك عارية
لكن لا يمكنني رؤية بزيّ سباحة؟

147
00:12:10,000 --> 00:12:14,830
.لا أريد أن يراني أيّ رجل آخر غيرك

148
00:12:14,830 --> 00:12:16,330
.زوجان لطيفين بشكل مقرف

149
00:12:17,290 --> 00:12:20,040
.سايتو-سان! أحضرتُ لك عصيرًا

150
00:12:26,770 --> 00:12:29,060
لماذا أنت شاردة هكذا؟

151
00:12:29,060 --> 00:12:31,690
.لا شيء، كنت أفكّر في بعض الأمور لا غير

152
00:12:31,690 --> 00:12:33,050
بعض الأمور؟

153
00:12:35,340 --> 00:12:36,460
هل حدث شيء ما؟

154
00:12:36,460 --> 00:12:39,070
!ماذا؟ لا شيء بالتّحديد

155
00:12:39,070 --> 00:12:40,410
!أنتما

156
00:12:41,340 --> 00:12:43,730
!تعالا لمساعدتي في التّوضيب

157
00:12:44,260 --> 00:12:45,330
!حاضر

158
00:12:45,910 --> 00:12:47,250
.علينا الذّهاب

159
00:12:47,250 --> 00:12:48,070
.أكيد

160
00:12:48,980 --> 00:12:50,960
سان-سان-كودو؟

161
00:12:52,010 --> 00:12:56,460
لماذا يجعلني ذلك مدركة بوجوده أكثر الآن؟

162
00:13:06,170 --> 00:13:08,920
.أعتقد أنّ 20 هو الحدّ لهذه المنافسة

163
00:13:08,920 --> 00:13:12,010
.من الصّعب البقاء متزامنين مع بعضنا

164
00:13:14,030 --> 00:13:17,600
أتريدان أن تلعبا كرة الطّاولة يا جدّاي؟

165
00:13:17,600 --> 00:13:18,880
كرة الطّاولة؟

166
00:13:23,110 --> 00:13:23,860
!خذ

167
00:13:24,680 --> 00:13:29,230
!حسنًا

168
00:13:35,720 --> 00:13:39,950
أنا ممتنّ لك لأنّك رددت ذلك بطريقة
،تعني أنّني لست مضطرًّا إلى التّحرّك

169
00:13:39,950 --> 00:13:43,320
.لكن ليس عليك أن تراعيني لهذه الدّرجة

170
00:13:43,320 --> 00:13:47,330
ماذا عنك يا عزيزي؟
.إنّك تواصل رميها حيث أستطيع ضربها

171
00:13:47,330 --> 00:13:49,050
.لا تختلف عنّي أبدًا

172
00:13:49,750 --> 00:13:54,490
عزيزي، ذلك الثّنائيّ لم يتحرّك ولو شبرًا
!واحدًا خلال منافستهما السّريعة

173
00:13:54,490 --> 00:13:57,970
.إنّ الرّجل العجوز متسمّر في مكانه كأنّه تمثال جيزو

174
00:14:17,100 --> 00:14:20,830
تحمّستُ جدًّا بشأن لعب كرة الطّاولة
.لدرجة أنّي تعرّقت كثيرًا

175
00:14:21,670 --> 00:14:23,740
.نـ-نعم

176
00:14:24,350 --> 00:14:28,820
أواثق من هذا؟
الاستحمام معي وأنا في هيئتي كعجوز؟

177
00:14:28,820 --> 00:14:30,240
.لا أمانع إطلاقًا

178
00:14:30,240 --> 00:14:35,910
.فقبل كلّ شيء، رأيتني عارية مرّات عديدة في شبابنا

179
00:14:36,430 --> 00:14:39,860
لماذا قد أخجل من شيء كهذا الآن؟

180
00:14:40,210 --> 00:14:42,940
...حسنًا، ذلك

181
00:14:43,370 --> 00:14:47,890
هل تذكر أوّل يوم صرنا فيه شبابًا ثانية؟

182
00:14:47,890 --> 00:14:50,360
.نعم، بالطّبع أذكر

183
00:14:50,360 --> 00:14:53,300
!لنذهب في شهر عسلنا يا عزيزتي

184
00:14:55,800 --> 00:14:58,450
.يستحقّ هذا أن نعيش حياة طويلة

185
00:14:58,450 --> 00:15:00,000
.بكلّ تأكيد

186
00:15:03,040 --> 00:15:05,230
ما الأمر يا عزيزتي؟

187
00:15:05,230 --> 00:15:11,170
عندما أتخيّل هذا الوضع وأنا في هيئتي
.الحقيقيّة، يبدو لي أمرًا سخيفًا

188
00:15:11,170 --> 00:15:12,890
هيئتك الحقيقيّة؟

189
00:15:12,890 --> 00:15:15,410
...عـ-عزيزتي

190
00:15:15,410 --> 00:15:17,810
نعم يا عزيزي؟

191
00:15:17,810 --> 00:15:21,840
ثنائيّ عجوز يرتعشان وهما يغازلان
.بعضهما في الحمّام

192
00:15:21,840 --> 00:15:26,230
يبدو ذلك من الخارج كمنظر مريع
.من الجحيم لاثنين من اليوكاي

193
00:15:26,800 --> 00:15:30,380
.يبدو مثل الحصول على مرق من مكوّنات جافّة

194
00:15:30,380 --> 00:15:34,300
.يمكنني تخيّلك وأنت تداعب ثديَيّ المترهّلين يا عزيزي

195
00:15:42,050 --> 00:15:47,730
.يا إلهي، اغفر لي أنانيّتي لوقت أطول

196
00:15:49,780 --> 00:15:54,220
.في اليوم التّالي، ذهبنا إلى الضّريح قرب النّزل

197
00:15:55,080 --> 00:15:57,440
ماذا تفعل يا عزيزي؟

198
00:15:57,850 --> 00:16:00,430
...لا شيء! أتفقّد ألواح إيما هذه

199
00:16:00,430 --> 00:16:02,580
.لم أفعل أيّ شيء

200
00:16:02,580 --> 00:16:05,510
!آسف. سأذهب إلى دورة المياه

201
00:16:05,510 --> 00:16:06,610
!ألواح إيما

202
00:16:06,610 --> 00:16:08,360
!علينا كتابة أمنيات عليها أيضًا

203
00:16:09,990 --> 00:16:11,640
!حسنًا، لقد انتهيت

204
00:16:11,640 --> 00:16:13,260
ماذا كتبت يا شوتا-كُن؟

205
00:16:13,260 --> 00:16:15,930
.أمنية للّعب في منافسة كرة القدم الوطنيّة

206
00:16:15,930 --> 00:16:17,580
ماذا عنك يا سايتو-سان؟

207
00:16:17,580 --> 00:16:20,780
!لـ-ليس لديّ أيّ شيء مهمّ لأتمنّاه

208
00:16:21,050 --> 00:16:23,860
".أتمنّى الحصول على علامات جيّدة في امتحاناتي"

209
00:16:23,860 --> 00:16:26,120
".أوموري، سايتو مينو"

210
00:16:26,120 --> 00:16:28,920
،لستُ بارعة في الدّراسة
.لذلك أمنيتي عن نجاحي فيها

211
00:16:29,290 --> 00:16:33,390
سايتو-سان، كان ترتيبك عاليًا جدًّا
في النّتائج الأخيرة، صحيح؟

212
00:16:33,390 --> 00:16:35,420
!لا، لا! على الإطلاق

213
00:16:43,060 --> 00:16:46,190
".سلامة عائلتي. الصّحّة هي كلّ شيء"

214
00:16:46,190 --> 00:16:48,670
".أوموري، سايتو شوزو"

215
00:16:49,320 --> 00:16:53,210
.إنّها ليست أمنية قد يحاول المرء إخفاءها

216
00:16:53,210 --> 00:16:56,870
.يفكّر زوجي بطريقة ملتوية قليلاً أحيانًا

217
00:16:56,870 --> 00:16:59,820
.يُنبئني حدسي أنّ هنالك المزيد بشأن هذا

218
00:17:01,100 --> 00:17:02,490
جدّتي؟

219
00:17:03,820 --> 00:17:05,660
.ما الخطب؟ تسمّرت مكانك لوهلة

220
00:17:05,660 --> 00:17:08,820
.كـ-كلاّ. لا شيء أبدًا

221
00:17:11,350 --> 00:17:13,160
.لا تقلبيها

222
00:17:13,690 --> 00:17:15,170
.أنا أتوسّل إليك

223
00:17:15,170 --> 00:17:16,840
!لا تقلبيها رجاءً

224
00:17:18,470 --> 00:17:23,220
آمل أن أكون زوج عزيزتي ثانية"
".في حياتي التّالية

225
00:17:23,220 --> 00:17:26,390
.كان يفكّر في نفس الشّيء مثلي

226
00:17:27,490 --> 00:17:32,520
يا إلهي! توجد شجرة كوسونوكي
رائعة في قلب الضّريج؟

227
00:17:32,520 --> 00:17:34,840
.يُقال أنّ عمرها 2000 سنة

228
00:17:36,450 --> 00:17:39,400
!إنّها نقطة قوّة مشهورة

229
00:17:39,990 --> 00:17:42,000
نقطة قوّة؟

230
00:17:42,000 --> 00:17:47,110
يُقال أنّه مقابل كلّ دورة حول الشّجرة
.المقدّسة، تطول حياتك سنة واحدة

231
00:17:47,110 --> 00:17:48,250
!ماذا قلت؟

232
00:17:48,540 --> 00:17:50,730
!لنقم بمائة دورة يا عزيزي

233
00:17:50,730 --> 00:17:54,010
!إن عشنا 180 سنة، فسنكون وحوشًا حينها

234
00:17:54,010 --> 00:17:55,130
.نعم

235
00:17:57,910 --> 00:17:59,920
ألن تذهب أيضًا يا شوتا-كُن؟

236
00:18:01,250 --> 00:18:04,850
بصراحة، لستُ قلقًا حيال صحّتي
...في الوقت الحاليّ، لذلك

237
00:18:05,290 --> 00:18:09,300
.لا بأس بذلك. يُقال أنّه لا بأس بالأماني العاديّة أيضًا

238
00:18:09,300 --> 00:18:10,610
فعلاً؟

239
00:18:11,650 --> 00:18:14,570
!تحدّق سايتو-سان بي كثيرًا

240
00:18:14,570 --> 00:18:16,700
!بما أنّنا هنا، لنذهب معًا

241
00:18:16,700 --> 00:18:18,030
.أ-أكيد

242
00:18:18,450 --> 00:18:20,630
أمنية؟

243
00:18:20,940 --> 00:18:24,900
،إن كان هذا ممكنًا، ففي المرّة القادمة
...بدلاً من كوني صديق

244
00:18:25,550 --> 00:18:29,380
أودّ أن أسير إلى جانبهما بصفتي
...شخصًا مميّزًا عندها

245
00:18:29,780 --> 00:18:30,830
...لذلك

246
00:18:37,960 --> 00:18:41,320
!أبناء أحفاد! أبناء أحفاد! أبناء أحفاد

247
00:18:41,320 --> 00:18:42,590
!هيّا

248
00:18:52,740 --> 00:18:55,320
،حتّى إن تحقّق حلمي بلعب كرة القدم

249
00:18:55,320 --> 00:18:57,860
.ما زلت أخطّط للعودة للقرية

250
00:18:57,860 --> 00:19:01,530
.أريد أن أردّ جميلَ امتناني للأرض الّتي رعتني

251
00:19:01,530 --> 00:19:05,330
سايتو-سان، هل لديك أيّ أحلام
لما بعد التّخرّج من الثّانويّة؟

252
00:19:12,780 --> 00:19:15,450
.شوتا-كُن مذهل بالفعل

253
00:19:15,980 --> 00:19:20,090
.لم أتخيّل أبدًا أنّه كان يفكّر بجدّيّة حيال مستقبله

254
00:19:20,610 --> 00:19:23,560
.لم أفكّر في الأمر على الإطلاق

255
00:19:26,050 --> 00:19:28,360
حلم؟

256
00:19:33,300 --> 00:19:37,360
،على الأرجح أنّ الزّراعة ليست سهلة طوال الوقت

257
00:19:37,800 --> 00:19:43,690
.لكنّ مشاهدة جدّاي تجعلني أشعر بالغيرة

258
00:19:52,180 --> 00:19:54,350
.آسفة يا شوتا-كُن

259
00:19:55,410 --> 00:19:57,490
.سأقبّلك على جبهتك فقط في الوقت الحاليّ

260
00:20:04,390 --> 00:20:05,960
...بالتّفكير في الأمر أيّها الجدّ

261
00:20:05,960 --> 00:20:08,280
اخترت هيئتك هذه لهذا اليوم؟

262
00:20:08,280 --> 00:20:12,850
.كانت هذه الهيئة هي الخيار الأفضل البارحة أيضًا

263
00:20:15,030 --> 00:20:17,760
سايتو-سان، هل يوجد شيء ما على وجهي؟

264
00:20:17,760 --> 00:20:19,500
.ماذا؟ لا

265
00:20:19,870 --> 00:20:22,850
.كنتُ أتخيّل كيف ستبدو كجدّ

266
00:21:58,930 --> 00:22:01,920
!يا لأبي الغبيّ

267
00:22:01,920 --> 00:22:04,130
!لا أصدّق هذا

268
00:22:04,400 --> 00:22:07,250
!لم أتخيّل أبدًا أن تصل ديونه لهذا الحدّ

269
00:22:07,660 --> 00:22:11,650
.بعد موت أبي الآن، صارت ديونه ديوني أنا

270
00:22:12,070 --> 00:22:15,230
.سيكون علينا بيع نصف البستان المرهون

271
00:22:15,230 --> 00:22:16,990
.أنا آسف يا إيني

272
00:22:16,990 --> 00:22:19,910
هل يمكننا تأجيل شهر عسلنا أكثر؟

273
00:22:19,910 --> 00:22:22,870
.هذا أمر خارج سيطرتك بالكامل

274
00:22:22,870 --> 00:22:25,410
.واثقة أنّنا سنجدّ حلاًّ بطريقة ما

275
00:22:25,410 --> 00:22:26,520
.أنا آسف

276
00:22:26,520 --> 00:22:27,990
.أسبّب لك المشاكل فحسب

277
00:22:28,580 --> 00:22:30,420
!لكنّي أعدك

278
00:22:30,840 --> 00:22:33,110
!أعد أن آخذك يومًا ما

279
00:22:34,360 --> 00:22:39,080
.سنعالج مرضك
.وسأعمل بجدّ لجني الكثير من المال

280
00:22:39,080 --> 00:22:41,260
!ثمّ أقسم أنّي سآخذك

281
00:22:41,600 --> 00:22:47,520
.في النّهاية، لم نستطع ادّخار المال حتّى كبر أطفالنا

282
00:22:48,050 --> 00:22:51,070
.ولم يشفى مرضي أبدًا

283
00:22:51,950 --> 00:22:54,300
،أخذ الأمر وقتًا طويلاً

284
00:22:54,300 --> 00:22:58,300
.لكنّ هذا الرّجل وفى بوعده لي بالفعل

285
00:23:01,050 --> 00:23:05,890
،الحفيدان نائمان، لكنّه مكان عامّ

286
00:23:05,890 --> 00:23:08,040
...لذلك سأستعمل هذا وأقوم بـ

287
00:23:14,400 --> 00:23:17,720
.شكرًا يا عزيزي

288
00:23:19,960 --> 00:23:22,140
.أحسدهما

289
00:23:23,300 --> 00:23:26,370
.تمّ التّرحيب بنا وكأنّنا غادرنا لعقود من الزّمن

290
00:23:24,470 --> 00:23:28,670
!مرحبًا بكم! مرحبًا بكم

291
00:23:30,470 --> 00:23:34,230
!هناك أشخاص آخرون صاروا شبابًا أيضًا

292
00:23:34,230 --> 00:23:36,940
!ستجري مسابقة لنرى أيّ الزّوجين أفضل

293
00:23:37,830 --> 00:23:40,040
لماذا يجب أن تكون هكذا؟