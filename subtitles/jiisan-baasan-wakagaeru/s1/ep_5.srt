1
00:00:00,840 --> 00:00:02,020
عزيزتي"؟"

2
00:00:02,020 --> 00:00:04,280
،لا أعرف من قد تكون أو من أين أتيت

3
00:00:04,280 --> 00:00:05,990
...ولكن هل يُعقل

4
00:00:06,610 --> 00:00:08,580
أنّك تقصدني أنا؟

5
00:00:09,110 --> 00:00:10,630
.ساساكي إيني

6
00:00:12,190 --> 00:00:14,320
.هذا هو اسمي

7
00:00:16,450 --> 00:00:18,650
هذا ليس تظاهرًا أو مزحة؟

8
00:00:19,440 --> 00:00:22,710
لا تعرفين من أكون بالفعل؟

9
00:00:23,500 --> 00:00:24,670
.نعم

10
00:00:24,670 --> 00:00:29,740
كيف يُعقل هذا؟ حتّى ذكريات زوجتي
.عادت لما كانت عليه وهي شابّة

11
00:00:29,740 --> 00:00:32,010
،بما أنّها قالت أنّ اسمها ساساكي

12
00:00:32,010 --> 00:00:34,680
.ذلك يعني أنّ هذه هي زوجتي قبل لقائها بي

13
00:00:35,080 --> 00:00:39,800
.عندما استيقظت، كان العالم قد تقدّم مائة عام

14
00:00:39,800 --> 00:00:43,680
،حسب الظّروف، لكنت قد فقدت رشدي

15
00:00:43,680 --> 00:00:48,890
،لكن نظرًا لخاتم الزّواج هذا
.يبدو أنّ ما أخبرتني به حقيقيّ

16
00:00:49,520 --> 00:00:51,890
.من المحتمل أن أكون أنا سبب هذا الالتباس

17
00:00:52,840 --> 00:00:54,060
،سايتو-سان

18
00:00:54,580 --> 00:01:01,260
في الماضي، كنتُ أنا من عرض
عليك الزّواج، صحيح؟

19
00:01:01,900 --> 00:01:03,640
.نـ-نعم

20
00:01:03,640 --> 00:01:06,040
.أنا مهتمّة جدًّا بشأن هذا

21
00:01:06,040 --> 00:01:09,080
لماذا وقعتُ في حبّك في هذا العالم؟

22
00:01:09,080 --> 00:01:13,140
لماذا أردت قضاء نصف قرن إلى جانبك؟

23
00:01:14,980 --> 00:01:17,010
.لديّ عرض لك

24
00:01:17,010 --> 00:01:21,810
هلا جعلتني أقع في حبّك ثانية؟

25
00:02:54,340 --> 00:02:57,550
".تعود ذكريات الجدّة كما كانت في شبابها"

26
00:02:58,040 --> 00:03:02,500
حسنًا، لا بدّ أنّ فقدان الذّاكرة
،أمر صعب بشتّى الطّرق

27
00:03:02,500 --> 00:03:04,530
.ولكن ما زلنا بحاجة للأكل

28
00:03:04,860 --> 00:03:06,850
.يا له من جهاز طبخ غريب

29
00:03:06,850 --> 00:03:11,350
.إنّها تطبخ الأرزّ وتسخّنه
.إنّها آلة تستعمل الكهرباء لطبخ الأرزّ

30
00:03:11,350 --> 00:03:12,550
.تذوّقيه

31
00:03:19,520 --> 00:03:21,250
!ما هذا؟

32
00:03:21,810 --> 00:03:24,120
!هذا ليس الأرزّ الّذي أعرفه

33
00:03:25,650 --> 00:03:28,330
.نعم، نعم. أظنّ أنّ مذاقه جيّد

34
00:03:28,330 --> 00:03:29,640
أتظنّين؟

35
00:03:29,640 --> 00:03:33,660
،والآن، كلّ هذه بقايا وجبات سابقة
!تفضّلي بالهناء والشّفاء

36
00:03:34,970 --> 00:03:36,650
.أشعر بالاطمئنان

37
00:03:37,990 --> 00:03:41,940
،حتّى في يابان المستقبل هذه
.هناك بعض الأشياء الّتي لم تتغيّر

38
00:03:41,940 --> 00:03:43,720
.نـ-نعم

39
00:03:44,740 --> 00:03:46,660
.شكرًا على الطّعام

40
00:03:47,230 --> 00:03:50,130
!ناتو في حاوية مصنوعة من مادّة غامضة

41
00:03:50,130 --> 00:03:53,670
!وتصميم حاوية الشّويو هذه مذهل أيضًا

42
00:03:53,670 --> 00:03:57,630
ما الخطب؟ لماذا تنظرين إليّ
بتلك التّعابير مشوشة؟

43
00:03:58,020 --> 00:04:00,680
.أنا متفاجئة قليلاً فحسب

44
00:04:00,680 --> 00:04:04,420
لستُ معتادة على رؤية
.ربّ المنزل يقوم بالأعمال المنزليّة

45
00:04:04,420 --> 00:04:05,600
فعلاً؟

46
00:04:05,940 --> 00:04:08,810
.كان والدي من النّوع المتسلّط

47
00:04:08,810 --> 00:04:11,980
.كان خير مثال لِما لا ينبغي لي أن أكونه

48
00:04:11,980 --> 00:04:17,460
.لم أكن جيّدًا في الطّبخ، لذا تركت معظم ذلك لك

49
00:04:17,460 --> 00:04:20,190
.لكنّي أقوم بمعظم الأشياء الأخرى

50
00:04:20,190 --> 00:04:21,580
.هذا جدير بالثّناء

51
00:04:21,580 --> 00:04:24,500
.الثّناء؟ لا شيء من هذا يستحقّ الثّناء

52
00:04:24,830 --> 00:04:29,110
.تقومين بالعمل معي في البستان أيضًا

53
00:04:30,080 --> 00:04:36,710
لذلك لا أستطيع العودة للمنزل
.وشرب الكحول وحدي

54
00:04:36,710 --> 00:04:40,130
إذًا فهذا هو ما جلبته معها هذه الحقبة؟

55
00:04:41,170 --> 00:04:44,890
.كنّا أنا وأنت على هذا الحال منذ البداية

56
00:04:44,890 --> 00:04:48,130
.لم نحبّ أبدًا أن تكون الأمور غير متوازنة

57
00:04:48,130 --> 00:04:51,180
هذه هي الحياة اليوميّة
.الّتي امتدّت لعدّة عقود من الزّمن

58
00:04:51,180 --> 00:04:52,560
أهذا هو ما يعنيه ذلك؟

59
00:04:53,000 --> 00:04:58,150
إنّه يقوم بالعمل المنزليّ، لكنّه
.لا يتباهى به ولا يطلب الشّكر أيضًا

60
00:05:01,150 --> 00:05:04,080
.لدائن اللّفّ هذه أو مهما كان اسمها مذهلة

61
00:05:04,080 --> 00:05:05,510
!إنّها لا تنتهي

62
00:05:05,510 --> 00:05:08,170
.لا يجدر بنا تضييعها، لذلك توقّفي رجاءً

63
00:05:08,660 --> 00:05:11,170
ساعة رمليّة؟ والعودة للشّباب ثانية؟

64
00:05:11,170 --> 00:05:13,400
ما معنى كلّ هذا؟

65
00:05:13,400 --> 00:05:16,160
.لا أعرف كيف أشرح الأمر بشكل جيّد

66
00:05:16,160 --> 00:05:20,840
.ولكنّك ستفهمين أثناء نومك اللّيلة

67
00:05:25,650 --> 00:05:29,000
.هذا ما كنتُ أقصده

68
00:05:29,480 --> 00:05:32,140
هل حلمت بالسّاعة الرّمليّة يا عزيزتي؟

69
00:05:32,540 --> 00:05:33,590
.كـ-كلاّ

70
00:05:33,590 --> 00:05:36,120
لكن هل أنت سايتو-سان بالفعل؟

71
00:05:36,120 --> 00:05:38,200
!لم أتخيّل أبدًا أن تصير شابًّا ثانية

72
00:05:38,200 --> 00:05:41,150
عفوًا، هل لديك أيّ ذكريات
عنّي بهذا الشّكل؟

73
00:05:41,150 --> 00:05:43,580
...عفوًا، أنا

74
00:05:43,580 --> 00:05:47,140
.أنا آسفة. ما زلت لا أعرفك

75
00:05:49,650 --> 00:05:52,380
.آسف لأنّي أفزعتك

76
00:05:52,380 --> 00:05:54,160
.لا، أنا من عليها أن تتأسّف

77
00:05:54,660 --> 00:05:55,660
.كم هذا غريب

78
00:05:56,260 --> 00:05:59,980
،ليست لديّ أيّ ذكرى عن مظهره أو صوته

79
00:06:00,490 --> 00:06:01,670
لذلك ما السّبب؟

80
00:06:02,200 --> 00:06:05,680
،عندما أراك من الخلف هكذا
...وأنت تشعر بالحزن

81
00:06:06,290 --> 00:06:10,190
.أتمنّى لو يمكنك تشارك بعض ذلك الألم معي

82
00:06:11,190 --> 00:06:13,490
لماذا أتمنّى ذلك بشدّة؟

83
00:06:15,710 --> 00:06:18,620
هؤلاء ابننا وزوجته وحفيدتنا؟

84
00:06:19,040 --> 00:06:20,430
!صحيح

85
00:06:20,870 --> 00:06:23,260
!جميعهم أطفال رائعون

86
00:06:23,610 --> 00:06:26,380
.إنّهم لا يتشاجرون، ويعتنون بآبائهم

87
00:06:26,380 --> 00:06:29,650
!حفيدتنا طيّبة أيضًا
!جميعهم ظريفون للغاية

88
00:06:30,940 --> 00:06:32,310
.هكذا إذًا

89
00:06:32,940 --> 00:06:37,190
،إن عرفوا أنّي فقدت ذاكرتي
.واثقة أنّ ذلك سيكون صدمة لهم

90
00:06:37,800 --> 00:06:40,660
!جدّي، أتيتُ لقضاء الوقت معكما

91
00:06:43,750 --> 00:06:47,010
هذا صحيح! كان يوشياكي وعائلته
!سيأتون لزيارتنا اليوم

92
00:06:47,010 --> 00:06:48,990
!نسيت بالكامل

93
00:06:48,990 --> 00:06:50,130
ماذا نفعل؟

94
00:06:51,640 --> 00:06:54,400
!سايتو-سان— بل يا عزيزي

95
00:06:54,400 --> 00:06:57,240
.سأتظاهر أنّي "الجدّة" لليوم

96
00:06:57,240 --> 00:06:59,090
ماذا عن ذكرياتك ولهجتك؟

97
00:06:59,470 --> 00:07:02,120
.جد طُرقًا لتتستّر على ذلك رجاءً

98
00:07:02,120 --> 00:07:06,450
.لا أعرف أيّ شيء عن ابننا أو حفيدتنا

99
00:07:06,450 --> 00:07:12,100
ولكنّ واجب الأمّ يظلّ كما
.هو مهما تغيّر الزّمان

100
00:07:13,700 --> 00:07:19,010
من واجب الأمّ أن تحرص
.ألاّ يكون أطفالها حزينين

101
00:07:20,480 --> 00:07:23,340
.ماذا؟ شعرك أسود يا جدّتي

102
00:07:24,050 --> 00:07:26,340
!مرحبًا بك يا مينو

103
00:07:28,320 --> 00:07:30,320
كيف تشعر من النّاحية الجسديّة؟

104
00:07:30,320 --> 00:07:33,590
!أشعر بشعور رائع في الوقت الحاليّ كما ترى

105
00:07:33,590 --> 00:07:36,730
!وأنا على شاكلته أيضًا

106
00:07:37,260 --> 00:07:38,500
على شاكلته"؟"

107
00:07:38,500 --> 00:07:42,510
...عفوًا، كنتُ

108
00:07:42,510 --> 00:07:44,750
.هذا بسبب المهرجان الثّقافيّ

109
00:07:45,740 --> 00:07:50,010
ارتدت زوجتي زيًّا مدرسيًّا قبل
أيّام في مدرسة مينو، صحيح؟

110
00:07:50,010 --> 00:07:54,740
ومذّاك الحين، كانت تستمتع باستعمال
.لهجتها عندما كانت تلميذة بدورها

111
00:07:54,740 --> 00:07:57,740
.نـ-نعم. هذا صحيح

112
00:07:58,070 --> 00:08:01,110
كيف صرتُ في المستقبل يا ترى؟

113
00:08:01,110 --> 00:08:03,390
.فهمت. لا بأس بذلك إذًا

114
00:08:03,720 --> 00:08:07,470
.جدّة تستعمل قواعد اللّغة المهذّبة
!يبدو هذا جديدًا بطريقة ما

115
00:08:07,470 --> 00:08:09,190
!وربّما رائعًا قليلاً أيضًا

116
00:08:10,080 --> 00:08:11,330
أتعتقدين ذلك؟

117
00:08:11,330 --> 00:08:13,570
.هذه الفتاة هي حفيدتي

118
00:08:12,210 --> 00:08:15,180
!استمعي لهذا يا جدّتي

119
00:08:13,960 --> 00:08:17,050
.إنّها فتاة طيّبة تهتمّ لأمر جدّيها

120
00:08:15,180 --> 00:08:19,340
،قبل قليل في السّيّارة
!قال أبي شيئًا مضحكًا للغاية

121
00:08:17,050 --> 00:08:20,150
.ومن المؤكّد أنّ دمائي تسري في عروقها

122
00:08:20,150 --> 00:08:21,950
ما هذا الشّعور؟

123
00:08:23,170 --> 00:08:25,270
جـ-جدّتي؟

124
00:08:27,890 --> 00:08:29,480
جدّتي؟

125
00:08:29,480 --> 00:08:30,840
.إنّها ظريفة جدًّا

126
00:08:32,490 --> 00:08:34,940
.أمّي، ربّما حان الوقت لتتركي مينو

127
00:08:34,940 --> 00:08:35,560
.لا أريد

128
00:08:35,560 --> 00:08:37,790
!جدّتي دافئة جدًّا

129
00:08:39,830 --> 00:08:44,050
،إذا قطّعتُ هذه المكونات وأضفت هذا
فسوف أحصل على أرزّ بالكاري؟

130
00:08:44,050 --> 00:08:45,250
أهذا حقيقيّ؟

131
00:08:45,250 --> 00:08:47,340
!نعم، حقيقيّ

132
00:08:52,130 --> 00:08:54,970
!سمعتُ صوتًا عاليًا
هل كلّ شيء بخير؟

133
00:08:54,970 --> 00:08:57,970
!نعم! لا داعي للقلق

134
00:08:58,440 --> 00:09:01,970
هل يُعقل أنّك نسيت كيف تطبخين أيضًا؟

135
00:09:01,970 --> 00:09:05,200
.كان خدمنا يطبخون لنا دائمًا

136
00:09:05,200 --> 00:09:07,610
.لكن حتّى أنا أستطيع تقطيع الخضار

137
00:09:08,520 --> 00:09:11,960
أنت تضحك عليّ في داخلك
لأنّي عاجزة عن الطّبخ، صحيح؟

138
00:09:11,960 --> 00:09:15,920
.لا. ما كنتُ لأضحك عليك وأنت بهذا الحال أبدًا

139
00:09:15,920 --> 00:09:19,400
.إنّك تحاولين التّأكّد ألاّ يقلق ابنينا وعائلتاهما

140
00:09:20,610 --> 00:09:23,350
هل يمكنك الطّبخ يا سايتو-سان؟

141
00:09:23,350 --> 00:09:25,550
.أستطيع طبخ شيء مثل الكاري على الأقلّ

142
00:09:26,980 --> 00:09:29,770
.علّمني رجاءً كيف أقطّع هذه

143
00:09:29,770 --> 00:09:31,070
!يسرّني ذلك

144
00:09:31,930 --> 00:09:33,960
.حافظي على أصابعك مجتمعة هكذا

145
00:09:34,960 --> 00:09:37,960
.واسحبي السّكّين على هذا الشّكل

146
00:09:38,580 --> 00:09:42,970
،عندما أقف في هذا المطبخ
.يراودني شعور غريب بالحنين

147
00:09:43,550 --> 00:09:47,980
،كانت بقايا الوجبات الّتي أكلتها البارحة
.الوجبات الّتي أعدّتها "الجدّة"، لذيذة

148
00:09:47,980 --> 00:09:51,940
.أنا لا أجيد الطّبخ أبدًا
ما الّذي قد دفعني لذلك المستوى يا ترى؟

149
00:09:51,940 --> 00:09:53,920
.كنتُ أتساءل عن ذلك طوال الوقت

150
00:09:54,360 --> 00:09:57,680
.ربّما صرت أدري الآن

151
00:09:59,140 --> 00:10:01,200
كان ذلك بسببك أنت، صحيح؟

152
00:10:06,510 --> 00:10:09,010
البطاطس كبيرة نوعًا ما اليوم، صحيح؟

153
00:10:10,580 --> 00:10:12,570
.تتخيّلين فحسب

154
00:10:13,350 --> 00:10:17,670
.تستعمل الجدّة قشّارة الخضار بلا توقّف

155
00:10:18,830 --> 00:10:22,380
حصلتُ على علامة كاملة في الاختبار
!الّذي خضته قبل أيّام يا أمّي

156
00:10:22,380 --> 00:10:25,010
.أنا فخورة بك يا يوشياكي
!حصدت ثمار جهودك

157
00:10:25,270 --> 00:10:28,860
.ثمّة أوضاع حيث العمل بجدّ وحده لا يكفي

158
00:10:28,860 --> 00:10:33,030
.سايتو-كُن، نحتاج منك أن تقدّم لنا بعض النّتائج

159
00:10:33,030 --> 00:10:33,850
.حاضر

160
00:10:33,850 --> 00:10:38,120
.العمل بجدّ وحده لا يكفي
.نحتاج منك لتعمل بجدّ أكثر من ذلك

161
00:10:44,040 --> 00:10:46,120
ستُفلس الشّركة؟

162
00:10:46,120 --> 00:10:48,850
.إن استمرّت الأوضاع بالسّير على هذا الحال

163
00:10:49,510 --> 00:10:51,720
يؤدّي الانخفاض السّكّانيّ
.إلى إفلاس المتاجر الفرعيّة

164
00:10:52,370 --> 00:10:54,370
.ربما لن نستمرّ لفترة أطول

165
00:10:55,220 --> 00:10:57,470
ما الّذي تنوي فعله؟

166
00:10:57,470 --> 00:11:00,760
يمكنك دائمًا العمل في البستان
...إن ساءت الأمور، ولكن

167
00:11:01,030 --> 00:11:06,420
لا. لا أستطيع التّسبّب بالمشاكل لك
.ولأمّي في هذه المرحلة من حياتي

168
00:11:06,760 --> 00:11:09,490
.سأكون بخير. ستُحلّ الأمور بطريقة ما

169
00:11:09,490 --> 00:11:12,060
.لا، بل سأجد حلاًّ بنفسي

170
00:11:12,060 --> 00:11:15,180
.هذا يعني أنّي لم أكن أعمل بجدّ كاف فحسب

171
00:11:15,770 --> 00:11:18,740
،إن كان العمل بجدّ لن ينجح

172
00:11:18,740 --> 00:11:22,080
.فعليّ فقط أن أعمل بجدّ أكثر من ذلك

173
00:11:28,610 --> 00:11:29,890
.يوشياكي

174
00:11:30,910 --> 00:11:33,210
.لا يجب عليك العمل بجدّ أكثر ممّا تفعل سلفًا

175
00:11:34,110 --> 00:11:39,200
،ما دام رؤساؤك يستغلّون طيبتك وعملك بجدّ

176
00:11:39,970 --> 00:11:45,210
.فلن يتغيّر الوضع أبدًا مهما كنت مجتهدًا

177
00:11:45,560 --> 00:11:48,820
.أنت بشر فحسب. لا بأس بالشّعور بخيبة الأمل

178
00:11:48,820 --> 00:11:51,540
.من المهمّ أيضًا عدم المحاولة بجدّ

179
00:11:51,540 --> 00:11:54,230
.ما عليك سوى الوقوف على قدميك مرّة أخرى

180
00:11:54,230 --> 00:11:57,860
.يمكنك الهرب والقدوم إلينا في أيّ وقت

181
00:12:01,410 --> 00:12:06,450
.أنت ابننا فقبل كلّ شيء وبغضّ النّظر عن عمرك

182
00:12:09,630 --> 00:12:13,770
...وهناك أيضًا ذلك الرّئيس الفظيع يا أمّي

183
00:12:12,930 --> 00:12:16,290
لكنّ ابننا هذا لا يشبهنا أبدًا، صحيح؟

184
00:12:16,290 --> 00:12:19,620
.لكنّه يبدو مثل أبي أنا بكلّ تأكيد

185
00:12:20,010 --> 00:12:21,790
يا أمّي؟

186
00:12:21,790 --> 00:12:22,640
ماذا هنالك؟

187
00:12:23,100 --> 00:12:27,600
لستِ أمّي، صحيح؟

188
00:12:30,270 --> 00:12:33,200
.لكنّي لا أستطيع أن أكون واثقًا بالكامل من ذلك

189
00:12:34,100 --> 00:12:36,470
.أنت أمّي، لكنّك لا تبدين مثل أمّي

190
00:12:37,240 --> 00:12:39,720
!نعم! هناك بطّيخ يحلّق في السّماء

191
00:12:39,720 --> 00:12:43,500
.لا يمكنني التّمييز إن كان ثملاً أم لا

192
00:12:43,500 --> 00:12:46,610
،تصرّفاتك والنّظرة في عينيك تبدو مختلفة

193
00:12:46,610 --> 00:12:50,730
.لكنّك تبدين مثل أمّي تمامًا عندما كنّا صغارًا

194
00:12:50,730 --> 00:12:52,750
...وقبل قليل

195
00:12:53,790 --> 00:12:56,400
.يمكنك الهرب والقدوم إلينا في أيّ وقت

196
00:12:57,630 --> 00:13:01,770
.ذلك بالضّبط ما كانت عليه أمّي دائمًا

197
00:13:09,280 --> 00:13:11,950
.أنت أمّي بالفعل في نهاية المطاف

198
00:13:12,510 --> 00:13:18,280
.فهمت... لستُ ندًّا أبدًا لابني

199
00:13:19,520 --> 00:13:22,690
اعترفتُ بمشاعري لك هنا؟

200
00:13:22,690 --> 00:13:25,770
نعم. هل تذكرين أيّ شيء؟

201
00:13:25,770 --> 00:13:27,540
.ليس في هذه اللّحظة

202
00:13:28,090 --> 00:13:30,180
هل يمكنني أن أقترح شيئًا ما؟

203
00:13:31,530 --> 00:13:37,550
إذا أعدنا تمثيل الوضع كما كان
.في ذلك الوقت، ربّما أتذكّر شيئًا ما

204
00:13:39,000 --> 00:13:41,360
هل أنا من لمستُ يدك؟

205
00:13:41,950 --> 00:13:43,820
.نـ-نعم

206
00:13:43,820 --> 00:13:45,900
.إن كنتَ تكذب، فلن أكون مسؤولة عمّا سيحدث

207
00:13:45,900 --> 00:13:48,240
.أعلم، أعلم

208
00:13:48,240 --> 00:13:50,550
.حسنًا، سأقوم بما أخبرتني به

209
00:13:54,710 --> 00:13:56,490
أكان هكذا؟

210
00:13:56,490 --> 00:13:58,630
.نـ-نعم

211
00:14:01,140 --> 00:14:02,400
كيف الأمر؟

212
00:14:02,820 --> 00:14:05,400
هل تذكّرت أيّ شيء؟

213
00:14:06,310 --> 00:14:09,740
فعلتُ هذا... بالفعل؟

214
00:14:09,740 --> 00:14:12,370
.نـ-نعم، هذا ما فعلت

215
00:14:12,370 --> 00:14:14,650
هل يمكنني قول شيء ما؟

216
00:14:14,650 --> 00:14:15,460
نعم. ماذا؟

217
00:14:15,460 --> 00:14:16,920
!هذا غباء

218
00:14:16,920 --> 00:14:17,860
ماذا؟

219
00:14:17,860 --> 00:14:21,430
!لا بدّ أنّها كذبة! لا أصدّق أنّ هذا ما حدث

220
00:14:21,960 --> 00:14:24,090
.يجعلني هذا أشعر بحكّة في كامل جسدي

221
00:14:24,090 --> 00:14:27,440
.عفوًا... أنا آسف

222
00:14:29,430 --> 00:14:32,430
.صار السّير للمنزل محرجًا الآن

223
00:14:39,460 --> 00:14:43,190
.الرّعد مخيف يا أختي
أيمكنني النّوم معك؟

224
00:14:43,190 --> 00:14:45,850
تحبّين أن تُدلّلي كطفلة، صحيح يا إيني؟

225
00:14:46,740 --> 00:14:47,830
أختي؟

226
00:14:55,400 --> 00:14:58,980
.إنّ جريان الزّمن أمر مخيف

227
00:14:59,870 --> 00:15:03,580
أتيتُ مسرعة عندما عرفتُ
،أنّ أختي الكبرى حيّة

228
00:15:03,580 --> 00:15:07,090
لكنّي لم أتخيّل أبدًا
.أنّها ما عادت تتذكّر إلاّ أمّي

229
00:15:08,910 --> 00:15:11,640
الشّخص الوحيد الّذي يمكنني اللّجوء
...إليه للطّمأنينة في وضعي الحاليّ

230
00:15:11,640 --> 00:15:13,960
.ما عاد جزءًا من هذا العالم

231
00:15:15,960 --> 00:15:18,630
شخص ألجأ إليه للطّمأنينة؟

232
00:15:19,410 --> 00:15:22,060
.لم يقل أيّ كلمة طوال هذا الوقت

233
00:15:22,650 --> 00:15:25,040
.جلس إلى جانبي بصمت فحسب

234
00:15:25,600 --> 00:15:28,990
أيحاول القول أنّي لستُ وحدي؟

235
00:15:29,560 --> 00:15:32,460
.ليست هناك حاجة لتكون مراعيًا لمشاعري

236
00:15:32,930 --> 00:15:36,670
.سأكون بخير حتّى وإن كنتُ وحدي

237
00:15:40,520 --> 00:15:42,570
...حتّى إن كنتُ وحدي

238
00:15:45,850 --> 00:15:49,590
،أريد الذّهاب إلى الحمّام
!لكنّي لا أستطيع النّهوض

239
00:15:51,530 --> 00:15:54,880
.كانت أختي عازفة بيانو ممتازة

240
00:16:07,870 --> 00:16:09,020
عزيزتي؟

241
00:16:20,480 --> 00:16:24,620
،إيني، سأعزف أيّ أغنية تحاولين عزفها

242
00:16:24,620 --> 00:16:26,750
.لذلك اعزفي ما يحلو لك

243
00:16:26,750 --> 00:16:29,770
!سأعزف "فوروساتو" إذًا يا أختي

244
00:16:43,950 --> 00:16:49,400
إنّ أختي لا تتذكّرني أو المكان
.الّذي كبرنا فيه في الوقت الحاليّ

245
00:16:49,400 --> 00:16:53,420
.على الأرجح أنّها لا تعرف حتّى نفسها جيّدًا

246
00:17:00,870 --> 00:17:10,870
...ما زلت أذكر تلك الأيّام

247
00:17:13,750 --> 00:17:16,870
،سأكون في انتظارك هنا غدًا أيضًا

248
00:17:16,870 --> 00:17:18,480
.لذلك دعينا نتدرّب معًا

249
00:17:18,480 --> 00:17:20,700
!نعم، إنّه وعد

250
00:17:20,700 --> 00:17:23,150
.إيني، إنّك بارعة في عزف البيانو

251
00:17:24,130 --> 00:17:30,100
،لا أعرف من تكونين
.لكنّك بارعة في عزف البيانو

252
00:17:51,550 --> 00:17:55,040
!لكن لا يمكننا أن نطلب منهما التّوقّف

253
00:17:55,450 --> 00:17:57,260
.آسف يا عزيزتي

254
00:17:57,260 --> 00:18:00,250
.ستجتمع الجمعيّة اليوم

255
00:18:00,250 --> 00:18:02,730
.من الأفضل أن تتناولي عشاءك قبلي

256
00:18:03,320 --> 00:18:06,720
.مرّت عدّة أسابيع ولم أسترجع ذاكرتي

257
00:18:07,560 --> 00:18:09,980
.هذه أوّل مرّة أظلّ فيها وحدي

258
00:18:11,040 --> 00:18:14,970
في الوقت الحالي، لا إشارات
.على أنّي وقعتُ في حبّه

259
00:18:14,970 --> 00:18:19,860
كما أنّه لم يتقرّب منّي بشكل
.رومانسيّ قصدًا أيضًا

260
00:18:20,440 --> 00:18:25,850
إنّ ترك فتاة فاقدة للذّاكرة
.وحدها لا يصبّ في مصلحته

261
00:18:28,230 --> 00:18:31,820
.الكاري الّذي أعدّه لي ليس لذيذًا اليوم

262
00:18:31,820 --> 00:18:33,230
.وهذا ليس في صالحه أيضًا

263
00:18:34,460 --> 00:18:36,380
هل تدرك الأمر من الأساس؟

264
00:18:36,890 --> 00:18:41,510
،عندما لا تكون برفقتي
.أشعر بالقلق حيال كلّ شيء

265
00:18:42,960 --> 00:18:44,390
القلق؟

266
00:18:45,040 --> 00:18:49,440
،في هذه الأسابيع القليلة الماضية
.تعلّمت أسس الحياة اليوميّة هنا

267
00:18:49,440 --> 00:18:54,240
حتّى بدونه، فلا يجب أن يكون
.هنالك أشياء كثيرة تثير قلقي

268
00:18:55,040 --> 00:18:56,780
...ومع ذلك

269
00:18:58,020 --> 00:19:00,590
.أشعر بالقلق لسبب ما

270
00:19:03,770 --> 00:19:06,800
،لا توجد أيّ حاجة لتدفعه للعودة باكرًا

271
00:19:06,800 --> 00:19:09,780
.ومع ذلك أتمنّى لو يعود بسرعة

272
00:19:10,090 --> 00:19:13,390
...هل يُعقل أنّ مجرّد تواجده بقربي

273
00:19:13,390 --> 00:19:15,920
لديه قيمة خاصّة بحدّ ذاته؟

274
00:19:15,920 --> 00:19:21,320
.أنتِ الشّخص الوحيد الّذي لن أتركه أبدًا

275
00:19:21,320 --> 00:19:23,250
.لا داعي للقلق

276
00:19:32,570 --> 00:19:33,960
عزيزي؟

277
00:19:35,220 --> 00:19:39,560
،عندما كنتُ في السّادسة عشر
.اعترفت بمشاعري له

278
00:19:39,560 --> 00:19:45,130
كان الأمر شبه مزاح، لكنّه استمرّ
.في زيارة الضّريح كلّ يوم لأجلي

279
00:19:45,660 --> 00:19:48,000
!لا تذهبي إلى ذلك الضّريح

280
00:19:48,900 --> 00:19:53,010
كانت العلاقة بين عائلته والأقرباء
،الّذين كنتُ أمكث معهم سيّئة

281
00:19:53,010 --> 00:19:55,000
.لذلك مُنعتُ من رؤيته

282
00:19:56,220 --> 00:20:00,950
توسّلنا وتضرّعنا لنستطيع رؤية
.بعضنا بشكل رسميّ

283
00:20:01,620 --> 00:20:04,670
عندما استطعتُ رؤيته ثانية
،بعد فترة الانفصال الطّويلة

284
00:20:04,670 --> 00:20:08,020
.كانت هنالك كدمات كبيرة على وجهه

285
00:20:08,020 --> 00:20:11,020
.تشاجرتُ مع أبي فحسب

286
00:20:11,520 --> 00:20:15,340
.بعد ذلك، مرضت بشدّة وانهرت

287
00:20:15,340 --> 00:20:19,470
.اعتنى بي ودفع تكاليف العلاج والمستشفى

288
00:20:20,030 --> 00:20:22,830
.شوزو-سان، هذا ليس جيّدًا

289
00:20:23,360 --> 00:20:26,030
.لن يجلب لك وجودك معي سوى التّعاسة

290
00:20:26,380 --> 00:20:30,290
لا يهمّ كم عدد الأشياء غير المعقولة
.والّتي لا معنى لها الّتي قد تعترض طريقنا

291
00:20:30,290 --> 00:20:32,960
.أنا أحبّك

292
00:20:32,960 --> 00:20:35,800
،حتّى إن هطلت عليّ التّعاسة كالمطر

293
00:20:35,800 --> 00:20:40,700
فسيكون عليّ فقط أن أمنحك
.سعادة تتجاوز ذلك فحسب

294
00:20:42,480 --> 00:20:45,900
سأقوم بذلك، حتّى إن تطلّب
.الأمر تكريس حياتي كلّها لذلك

295
00:20:47,050 --> 00:20:48,550
...وثمّ

296
00:20:48,550 --> 00:20:51,060
.وفى بوعده

297
00:20:54,410 --> 00:20:57,030
!عدتُ يا عزيزتي

298
00:20:58,110 --> 00:21:02,750
"اجعلني أقع في حبّك ثانية؟"
ما الّذي كنت أفكّر فيه؟

299
00:21:04,650 --> 00:21:08,320
،لا يهمّ كم مرّة سأفقد فيها ذكرياتي وأنا معه

300
00:21:08,320 --> 00:21:10,650
!فسينتهي الأمر دائمًا على نفس الحال

301
00:21:11,330 --> 00:21:15,810
!عزيزي! عزيزي

302
00:21:20,950 --> 00:21:24,520
.أهلاً بعودتك يا عزيزتي

303
00:22:57,500 --> 00:23:01,280
كيف استطعتَ البقاء هادئًا؟

304
00:23:01,960 --> 00:23:08,220
سواء كنتِ زوجتي من الماضي أو من
.الحاضر، فستضلّين مهمّة عندي

305
00:23:08,680 --> 00:23:14,060
،سواء كنت تتذكّرين أم لا
.لم أرغب باختيار أيّ واحدة منهما

306
00:23:15,330 --> 00:23:17,330
...يا عزيزتي

307
00:23:17,330 --> 00:23:18,990
ماذا؟

308
00:23:22,280 --> 00:23:25,010
.أصابعنا تلامس بعضها

309
00:23:25,620 --> 00:23:27,730
.أقوم بذلك قصدًا

310
00:23:30,620 --> 00:23:34,470
!البارفي هو كرة سكّر وكولسترول

311
00:23:34,470 --> 00:23:36,010
!لا بأس بذلك. كليه فحسب

312
00:23:36,010 --> 00:23:37,620
ماذا عن سعره؟

313
00:23:37,620 --> 00:23:39,250
.لا بأس بذلك