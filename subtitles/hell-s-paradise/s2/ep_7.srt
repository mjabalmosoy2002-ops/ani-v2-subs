1
00:00:18,220 --> 00:00:20,000
ستبدأ المعركة الحقيقيّة الآن

2
00:00:37,770 --> 00:00:39,270
يا للأسف

3
00:00:50,660 --> 00:00:52,360
يجدر بنا التراجع في الوقت الراهن

4
00:00:52,360 --> 00:00:55,120
هذا يكفي

5
00:01:03,380 --> 00:01:04,920
لا أنوي الموت

6
00:01:04,920 --> 00:01:07,810
غايتي هي العودة إلى الديار حيًّا

7
00:01:10,230 --> 00:01:13,970
لأحيا وألقى زوجتي

8
00:01:24,000 --> 00:01:25,510
ساغيري؟

9
00:01:25,510 --> 00:01:27,490
لا شيء، لنسرع

10
00:01:28,540 --> 00:01:32,100
علينا بلوغ الإكسير في أسرع وقتٍ ممكن

11
00:01:32,720 --> 00:01:35,280
هذا واجبنا الآن

12
00:01:35,280 --> 00:01:37,490
لا نملك وقتًا للوقوف مكتوفي الأيدي

13
00:01:42,610 --> 00:01:45,570
أجل، سيتدبّر غابيمارو الأمر حتمًا

14
00:01:47,320 --> 00:01:49,910
والآخرون أيضًا

15
00:02:19,290 --> 00:02:24,250
Rise-KuN :محاكاة

16
00:03:42,190 --> 00:03:43,880
تعال إلى هنا يا توما

17
00:03:44,830 --> 00:03:47,520
أبرمتُ اتفاقًا مع هؤلاء بالفعل

18
00:03:47,520 --> 00:03:50,210
سيمنحوننا الخلود إن انضممنا إليهم

19
00:03:50,210 --> 00:03:53,210
نحن نتكيّف، اصعد إلى هنا

20
00:03:53,710 --> 00:03:56,470
أخي؟ ما الّذي تفعله هنا؟

21
00:03:56,900 --> 00:04:00,480
...كلّا، لا يهمّ السبب، الأهمّ من ذلك

22
00:04:02,820 --> 00:04:04,060
اذهب

23
00:04:04,250 --> 00:04:05,960
أليس هذا شقيقكَ العزيز؟

24
00:04:06,050 --> 00:04:07,240
اذهب إليه فورًا

25
00:04:07,700 --> 00:04:10,100
أم أنّك متردّد بسببنا؟

26
00:04:10,430 --> 00:04:13,860
أأنتَ متأكّد؟ قد نصبح اثنين ضدّ أربعة في أسوأ الحالات

27
00:04:15,860 --> 00:04:19,830
انضمام هذا الضعيف إليهم لن يُحدث فارقًا يُذكر

28
00:04:20,310 --> 00:04:23,120
سأقطعهم جميعًا عن بكرة أبيهم

29
00:04:23,120 --> 00:04:26,370
سمعتَ ما قاله، وداعًا إذن

30
00:04:36,530 --> 00:04:38,920
كان ذلك جليًّا

31
00:04:38,920 --> 00:04:41,120
أكنتَ تمنحه الدفعة الّتي يحتاجها؟

32
00:04:41,800 --> 00:04:44,640
أنتَ عطوفٌ على نحوٍ مفاجئ

33
00:04:44,640 --> 00:04:46,520
لا تُسئ الفهم

34
00:04:46,980 --> 00:04:51,400
السيطرة على عدوٍّ متردّدٍ أسهل من حليفٍ متردّدٍ فحسب

35
00:04:52,170 --> 00:04:55,020
فهمت، لا يسعني إنكار ذلك

36
00:05:34,450 --> 00:05:35,190
!عجبًا

37
00:05:55,670 --> 00:05:58,350
لم تفقد براعتكَ يا توما

38
00:05:59,900 --> 00:06:02,050
أتسخر منّي؟

39
00:06:04,360 --> 00:06:06,800
فكّكَ لضفيرتكَ يعني أنّكَ تكذب

40
00:06:07,710 --> 00:06:09,600
هذه إشارةٌ بديهيّة

41
00:06:14,230 --> 00:06:16,890
عنيتُ تحرّكاتك

42
00:06:17,300 --> 00:06:19,110
تحسّنتْ كثيرًا

43
00:06:19,790 --> 00:06:24,360
غدوتَ رجلًا بحقٍّ، بالكاد تعرّفتُ عليك

44
00:06:28,920 --> 00:06:31,700
أقدّر لكم اعتناءكم بشقيقي

45
00:06:31,700 --> 00:06:34,250
أشكركم على ذلك

46
00:06:34,250 --> 00:06:36,170
شكرًا لكم

47
00:06:36,170 --> 00:06:40,170
هذا عربون تقديري، خذوه

48
00:06:40,170 --> 00:06:42,480
هذا أسوأ من معاداته

49
00:06:42,480 --> 00:06:43,990
أوافقك الرأي

50
00:06:43,990 --> 00:06:46,050
!يا للقسوة

51
00:06:46,400 --> 00:06:50,060
ظننتُ أنّه بوسعنا أن نغدو أصدقاء

52
00:06:50,500 --> 00:06:53,060
أتريدين منّي مواساتكِ؟

53
00:06:55,080 --> 00:06:56,980
لستَ من النوع الّذي يروقني

54
00:06:58,050 --> 00:07:01,010
خيانة، وهجومٌ مباغت

55
00:07:01,010 --> 00:07:04,450
البشرُ مخادعون بحقّ

56
00:07:04,940 --> 00:07:07,430
تجرّأتَ على إيذاء تاوفا

57
00:07:07,430 --> 00:07:09,700
ستدفع ثمن ذلك غاليًا

58
00:07:09,700 --> 00:07:14,710
مخادعون؟ يا لرقيّ ألفاظكم أيّها الخالدون

59
00:07:14,710 --> 00:07:17,560
!نحن قطّاع طرق

60
00:07:19,430 --> 00:07:22,490
!نكذب، ونخدع، ونسلب كلّ شيء

61
00:07:22,490 --> 00:07:25,380
!نحن أشرار إيو؛ الأخوان آزا

62
00:07:35,250 --> 00:07:37,170
الأمر أشبه بما حدث حينها

63
00:07:48,110 --> 00:07:50,700
!ستكون النتيجة ذاتها مهما تكرّر الأمر

64
00:08:17,430 --> 00:08:19,690
سينجوتسو: شظيّة القصدير

65
00:08:26,910 --> 00:08:28,740
كان ذلك وشيكًا

66
00:08:29,140 --> 00:08:30,680
المعذرة

67
00:08:30,680 --> 00:08:32,750
لكنَّ حركاتك متقنةٌ

68
00:08:33,600 --> 00:08:34,490
!أجل

69
00:08:34,490 --> 00:08:37,620
تبرز ندبته حين يشتدّ حماسه

70
00:08:37,620 --> 00:08:38,970
يسهل توقّع أفعاله

71
00:08:56,180 --> 00:08:58,020
...هذان الاثنان

72
00:09:02,400 --> 00:09:04,790
يقاتلان وكأنّهما جسدٌ واحد

73
00:09:12,020 --> 00:09:15,830
أتقن هذا الرجل التاو وبات قادرًا على استشعاره

74
00:09:16,580 --> 00:09:18,580
كما تحسّنتْ قدراته البدنيّة

75
00:09:19,890 --> 00:09:23,160
لكنَّ التغيّر الأعظم طرأ على هذا الرجل

76
00:09:24,610 --> 00:09:26,690
سحقًا للرشاقة

77
00:09:26,690 --> 00:09:29,340
ما تحتاجه للتلويح بالسيف هو رباطة الجأش

78
00:09:32,980 --> 00:09:36,600
أن تكون مستعدًّا لسلب حياة أحدهم بيديك

79
00:09:41,920 --> 00:09:44,610
هذا نقيض ما كان عليه الأمر حينها

80
00:09:46,860 --> 00:09:48,920
إنّهما اثنان في جسدٍ واحد

81
00:09:48,920 --> 00:09:52,400
كلّا، بل اثنان يقاتلان كجسدٍ واحد

82
00:09:54,550 --> 00:09:55,870
الأمر مقزّزٌ

83
00:09:56,780 --> 00:09:58,990
لا أكترث لأمر الطقوس

84
00:09:58,990 --> 00:10:01,450
سأقتلكَ مجدّدًا

85
00:10:08,950 --> 00:10:11,700
قُطع رأسي وكان ذلك مزعجًا بحقّ

86
00:10:11,700 --> 00:10:14,510
لكن يصبح ريين مخيفًا حين نعصي أوامره

87
00:10:16,890 --> 00:10:19,020
لنُنهِ هذا الأمر بسرعة

88
00:10:19,900 --> 00:10:21,770
هلمّا إليّ

89
00:10:21,770 --> 00:10:23,770
!بديع

90
00:10:23,770 --> 00:10:26,270
!مؤخّرةٌ مثيرة، وصدرٌ فاتن

91
00:10:26,270 --> 00:10:28,570
!إنّه تجسيدٌ لامرأةٍ مثاليّة

92
00:10:29,020 --> 00:10:30,280
أوافقك الرأي

93
00:10:31,270 --> 00:10:35,330
،بقدرتها على التجدّد وقوامها الخارق

94
00:10:35,330 --> 00:10:37,660
إنّها تجسيدٌ لخالدةٍ أسطوريّة

95
00:10:38,890 --> 00:10:40,490
!شكرًا لكما

96
00:10:41,120 --> 00:10:42,230
إنّها سريعة

97
00:10:51,920 --> 00:10:55,300
لكنَّ تلقّي المديح منكَ يصيبني بالقشعريرة أيّها العجوز

98
00:10:56,650 --> 00:10:59,550
أنتَ وسيمٌ على نحوٍ مفاجئ

99
00:11:01,310 --> 00:11:03,680
أترغب في ممارسة البوتشوجوتسو معي؟

100
00:11:03,680 --> 00:11:05,760
رغم أنّي سأحوّلك إلى تان في النهاية

101
00:11:07,910 --> 00:11:10,320
...يؤسفني رفض عرضكِ

102
00:11:10,910 --> 00:11:14,070
فجلّ اهتمامي منصبٌّ على ما بداخلكِ فحسب

103
00:11:14,850 --> 00:11:17,480
ما بداخلي؟ يا لكَ من منحرف

104
00:11:17,480 --> 00:11:19,710
سأريكَ إن أردت

105
00:11:19,820 --> 00:11:21,580
لا تتجاهليني

106
00:11:23,990 --> 00:11:28,710
أنتِ مثيرةٌ وقويّة، سيذيع صيتي إن قتلتكِ

107
00:11:28,710 --> 00:11:31,610
أنتِ المرأة المثاليّة بحقّ

108
00:11:32,220 --> 00:11:34,340
امنحيني المزيد من وقتكِ

109
00:11:36,210 --> 00:11:39,220
!حسنٌ، ها أنا ذي

110
00:12:04,910 --> 00:12:06,040
!مُذهل

111
00:12:06,410 --> 00:12:07,540
!أحسنت

112
00:12:19,180 --> 00:12:23,100
!كان ذلك وشيكًا، لكنّكما قويّان حقًّا

113
00:12:23,990 --> 00:12:27,100
!هذا هجوم التاو الخفيّ إذن

114
00:12:27,600 --> 00:12:30,190
لنهاجم مجدّدًا يا أيًّا-كان-إيمون

115
00:12:32,260 --> 00:12:33,810
!إنّه أسايمون

116
00:12:34,220 --> 00:12:36,260
لن نقوى على هزيمتها بهذا المعدّل

117
00:12:37,870 --> 00:12:43,240
لهزيمة التينسين-ساما، علينا تدمير التاندين خاصّتهم بتاو مضادّ

118
00:12:43,240 --> 00:12:46,730
،لكن على نقيض غابيمارو والآخرين

119
00:12:46,730 --> 00:12:50,590
ما زلنا عاجزين عن استخدام التاو كما ينبغي

120
00:13:05,390 --> 00:13:10,740
حسنٌ، حان الوقت أخيرًا لطقس الهيكي... جي؟ فوكوشو؟

121
00:13:10,800 --> 00:13:12,560
!طقس الهيكيجي فوكوشو

122
00:13:12,750 --> 00:13:14,660
!أليس كذلك؟ قلتها

123
00:13:15,010 --> 00:13:17,030
...قرابين هذه المرّة هما

124
00:13:17,400 --> 00:13:22,660
هذا الرجل الشديد القوّة، وذلك الفتى الصغير الفائق السرعة

125
00:13:25,160 --> 00:13:26,470
كما توقّعت

126
00:13:28,840 --> 00:13:31,760
لا تُبصر العيون التاو

127
00:13:32,500 --> 00:13:35,400
،بما أنّنا سنخوض معارك تعتمد على التاو

128
00:13:35,400 --> 00:13:38,940
علينا تعلّم استشعاره أولًا

129
00:13:39,430 --> 00:13:40,340
...والآن

130
00:13:43,970 --> 00:13:47,350
هل يمكنكما استشعار التاو خاصّتي؟

131
00:13:47,350 --> 00:13:48,380
كلّا

132
00:13:56,450 --> 00:14:01,150
يستحيل صدّ هجمات التاو لكونها خفيّة

133
00:14:02,720 --> 00:14:04,240
...تلك التينسين-ساما

134
00:14:04,500 --> 00:14:07,710
أظنّ أنَّ اسمها تاوفا، وعنصرها هو الخشب

135
00:14:07,710 --> 00:14:12,120
يضادّ عنصري المعدنيّ عنصرها، لذا الأفضليّة لنا

136
00:14:12,120 --> 00:14:15,850
لكنَّ تأثيره سيكون ضعيفًا لعجزي عن التحكّم به

137
00:14:15,850 --> 00:14:17,600
علينا تدبير خطّةٍ ما

138
00:14:17,600 --> 00:14:18,880
!اصمت

139
00:14:18,880 --> 00:14:22,370
إيّاكَ وذكر التاو أمامي مجدّدًا

140
00:14:22,370 --> 00:14:24,890
تعلّمه معقّدٌ للغاية

141
00:14:25,630 --> 00:14:29,390
بدأ الأمر يغدو ممتعًا للتو، فلا تفسده

142
00:14:30,010 --> 00:14:31,270
ممتع؟

143
00:14:36,140 --> 00:14:37,980
التاو مهمٌّ للغاية

144
00:14:37,980 --> 00:14:40,070
فهو يتيح لك قراءة حركات خصمكَ

145
00:14:41,380 --> 00:14:45,030
فهمت، إنّها تتفوّق على الدوشي بمراحل

146
00:14:54,410 --> 00:14:56,330
كما أنّه يتّجه حيثما تشاء

147
00:15:00,530 --> 00:15:03,090
أرأيت؟ أليس عمليًّا؟

148
00:15:04,600 --> 00:15:06,570
لِمَ لا تستسلمان فحسب؟

149
00:15:06,570 --> 00:15:08,910
لن تقويا على هزيمتي دون التاو

150
00:15:08,910 --> 00:15:12,100
سيسعدني أن تكفّا عن المقاومة وتدعاني أحوّلكما إلى تان

151
00:15:13,110 --> 00:15:14,600
لم ننتهِ بعد

152
00:15:14,600 --> 00:15:17,260
ألستِ تستمتعين أيضًا؟

153
00:15:17,860 --> 00:15:21,610
ففي النهاية، أمضيتِ ألف عامٍ في تعذيب البشر

154
00:15:26,740 --> 00:15:30,240
لا متعة في هذا إطلاقًا

155
00:15:31,120 --> 00:15:33,750
نُمضي وقتنا كلّه في التدرّب على الخلود هنا

156
00:15:34,880 --> 00:15:37,770
ونستدرج البشر لنتغذّى عليهم

157
00:15:38,390 --> 00:15:40,250
ونكرّر ذلك مرارًا وتكرارًا

158
00:15:40,750 --> 00:15:42,750
،فعلنا ذلك لألف عامٍ

159
00:15:43,370 --> 00:15:45,930
لكنّي أشكّ في بلوغنا الخلود المثاليّ

160
00:15:46,270 --> 00:15:49,620
حتّى لو واصلنا لألف عامٍ آخر

161
00:15:52,450 --> 00:15:55,760
أدرك مودان ذلك، وحتّى جوفا

162
00:15:56,250 --> 00:15:58,310
بل الجميع أدرك ذلك

163
00:15:59,270 --> 00:16:02,210
سأفقد صوابي إن لم أضحك

164
00:16:03,710 --> 00:16:07,530
أو لعلّي أضحك لأنّي فقدتُ صوابي بالفعل

165
00:16:12,370 --> 00:16:15,110
لا أجد متعةً في هذا إطلاقًا

166
00:16:22,680 --> 00:16:25,780
لم أدرك أنَّ التاو بهذه القوّة

167
00:16:27,560 --> 00:16:28,930
هل استسلمتما؟

168
00:16:28,930 --> 00:16:32,670
أظنّ أنَّ الموت السريع أفضل من الموت البطيء

169
00:16:34,600 --> 00:16:37,210
هذا اكتشافٌ مذهل

170
00:16:37,210 --> 00:16:39,890
مرحلةٌ جديدةٌ في دراسة الحياة

171
00:16:39,890 --> 00:16:42,440
والأروع من ذلك أنّه يسعني لمسه

172
00:16:42,440 --> 00:16:45,150
كأنّنا اكتسبنا عضوًا جديدًا

173
00:16:46,070 --> 00:16:48,250
عليَّ العودة بهذه المعرفة إلى الديار

174
00:16:48,250 --> 00:16:50,570
ستُحدث ثورةً في كلّ ما نعرفه عن الطبّ

175
00:16:50,910 --> 00:16:53,250
...ظننتُ أنّني درستُ الكثير، ولكن

176
00:16:53,250 --> 00:16:56,080
ما زالت هناك مجالاتٌ أخرى للبحث فيها

177
00:16:56,480 --> 00:16:59,580
ألم أطلب منك ألّا تفسد المتعة؟

178
00:17:00,420 --> 00:17:04,840
لا شيء يضاهي متعة اللعب بدميةٍ جديدة

179
00:17:04,840 --> 00:17:07,070
أشعر وكأنّنا نحن الدمية هنا

180
00:17:07,070 --> 00:17:08,340
!اخرس

181
00:17:09,590 --> 00:17:12,630
تبدوان مستمتعين حقًّا

182
00:17:14,840 --> 00:17:16,560
يا لحظّكما

183
00:17:19,880 --> 00:17:22,600
لا بُدَّ أنّكما مختلّان عقليًّا

184
00:17:22,600 --> 00:17:24,480
!وأنتِ كذلك

185
00:17:24,480 --> 00:17:26,980
!الاندفاع وحده ليس فنًّا

186
00:17:31,260 --> 00:17:36,080
ما هذا... الشعور؟

187
00:17:48,510 --> 00:17:51,010
!تفادى التاو

188
00:17:51,010 --> 00:17:55,350
فهمت، أدركتُ ماهيّة التاو الآن

189
00:17:58,010 --> 00:18:01,610
لا يمكنكَ رؤيته إطلاقًا، أكانت تلك ضربة حظٍّ؟

190
00:18:05,450 --> 00:18:08,330
لعلَّ صغر سنّ نوروغاي له دورٌ في ذلك

191
00:18:08,880 --> 00:18:11,500
...أظنّ أنَّ سبب عجزكما عن التحكّم بالتاو يعود إلى

192
00:18:11,500 --> 00:18:14,260
!حسنٌ، لا أعرف كيف أصف ذلك

193
00:18:14,780 --> 00:18:16,780
عقولكما متحجّرة

194
00:18:17,220 --> 00:18:21,100
أنتما لا تؤمنان بما لا تُبصره أعينكما، أليس كذلك؟

195
00:18:21,790 --> 00:18:24,290
لا يمكن التحكّم بالتاو بالعقل

196
00:18:24,290 --> 00:18:28,670
عليكما الانفصال عن الواقع وإطلاق العنان لحواسّكما

197
00:18:29,140 --> 00:18:31,540
هيّا، ابذلا جهدًا أكبر قليلًا

198
00:18:31,540 --> 00:18:32,750
لستُ مهتمًّا

199
00:18:32,750 --> 00:18:35,410
لن أضيّع وقتي على ما أعجز عن فعله

200
00:18:35,410 --> 00:18:38,300
لا أؤمن إلّا بما يسعني قطعه

201
00:18:38,300 --> 00:18:40,800
لا يسعني الإيمان بما لا أستطيع لمسه

202
00:18:41,160 --> 00:18:44,520
عليَّ أن أشرّحه، وأستخرجه، وألمسه بنفسي

203
00:18:44,520 --> 00:18:46,190
عمَّ تتحدّث؟

204
00:18:46,190 --> 00:18:48,980
لسنا أصدقاءَ في النهاية

205
00:18:48,980 --> 00:18:51,480
كلٌّ منّا حرٌّ في أفعاله

206
00:18:56,020 --> 00:18:57,070
وداعًا

207
00:19:06,160 --> 00:19:09,000
فهمتُ قصدكَ يا تشيبي-إيمون

208
00:19:09,300 --> 00:19:10,920
إنّه مجرّد حلٍّ مؤقّت

209
00:19:10,920 --> 00:19:12,930
الأهمّ من ذلك، راقبني عن كثب

210
00:19:12,930 --> 00:19:14,870
...إن تمكّنتَ من استشعار التاو

211
00:19:16,220 --> 00:19:18,800
!فستسنح لنا فرصةٌ لشنّ هجومٍ مضادّ

212
00:19:25,190 --> 00:19:27,920
لا يمكنكَ المراوغة من مسافةٍ قريبة، أليس كذلك؟

213
00:19:46,190 --> 00:19:49,130
أستواصل تلقّي الضربات هكذا؟

214
00:19:49,130 --> 00:19:51,880
ليتسنّى له مراقبة التاو خاصّتي؟

215
00:19:52,680 --> 00:19:55,380
يا لوفائك لرفيقك، هذا رائع

216
00:19:55,860 --> 00:19:59,140
!لسنا رفيقين

217
00:20:00,160 --> 00:20:05,520
لسنا رفيقين، لكنّي أظنّ أنّنا أقرب لذلك

218
00:20:06,010 --> 00:20:09,270
أنا مجرمٌ محكومٌ بالإعدام، أواثقٌ من كلامك؟

219
00:20:09,270 --> 00:20:13,260
أنتَ تعتني بالآخرين جيّدًا، كما فعلتَ مع توما

220
00:20:14,220 --> 00:20:16,150
،أدركُ مكانة كلٍّ منّا

221
00:20:16,150 --> 00:20:19,660
ولا أنوي التغاضي عن جرائمك الّتي اقترفتها

222
00:20:21,330 --> 00:20:24,160
لكنّي تعرّفتُ عليك

223
00:20:25,490 --> 00:20:27,160
فالمجرمون المحكومون بالإعدام بشرٌ أيضًا

224
00:20:28,160 --> 00:20:30,670
ومعاشرتهم تولّد التعاطف

225
00:20:32,170 --> 00:20:36,670
،في هذا الوقت القصير والعصيب، فتحنا قلوبنا

226
00:20:36,670 --> 00:20:39,600
واستخرجنا ما بداخله، ولمسناه

227
00:20:40,430 --> 00:20:42,740
وما دمتُ قادرًا على لمسه، فالأمر بسيط

228
00:20:42,740 --> 00:20:44,930
الساموراي والمجرمون سواسية

229
00:20:45,510 --> 00:20:47,260
...لدينا دمٌ، ولحمٌ، وعظام

230
00:20:47,680 --> 00:20:50,440
ورغبةٌ في الحياة

231
00:20:50,440 --> 00:20:52,310
الأمر أشبه بالتشريح

232
00:20:54,650 --> 00:20:57,290
تشبيهكَ مزعجٌ للغاية، لم أستوعبه

233
00:20:59,350 --> 00:21:00,960
لن أكرّره مجدّدًا إذن

234
00:21:03,810 --> 00:21:10,210
لن أقول مجدّدًا إنَّ غايتي الحقيقيّة هي عودتنا جميعًا أحياء

235
00:21:14,710 --> 00:21:17,960
إن لم تكونوا رفاقًا، فلا داعي للحزن إذن

236
00:21:22,010 --> 00:21:24,460
...لا أرى شيئًا، لكن

237
00:21:25,180 --> 00:21:27,970
يسعني استشعار ذلك، الفتى الصغير في ورطة

238
00:21:28,180 --> 00:21:31,980
عليكما الانفصال عن الواقع وإطلاق العنان لحواسّكما

239
00:21:45,560 --> 00:21:49,030
...تمكّنتُ من استشعار التاو خاصّتها حينها

240
00:21:49,750 --> 00:21:52,240
لأنَّ الدماء شوّشتْ رؤيتي في إحدى عينيّ

241
00:21:54,000 --> 00:21:57,380
اعتمدتُ على حواسّي لعجزي عن الرؤية حينها

242
00:22:00,760 --> 00:22:04,760
فقأتُ إحداهما، والأخرى مشوّشة

243
00:22:05,290 --> 00:22:08,260
فهمت، لا أرى شيئًا

244
00:22:09,050 --> 00:22:12,810
لكنّي أستشعره بوضوحٍ الآن

245
00:22:23,400 --> 00:22:24,900
تفاداه مجدّدًا

246
00:22:24,900 --> 00:22:26,660
...مذهل يا غانتيتسو

247
00:22:33,890 --> 00:22:36,480
أنتِ امرأةٌ مذهلةٌ بحقّ

248
00:22:36,480 --> 00:22:38,000
لكِ جزيل الشكر

249
00:22:40,960 --> 00:22:46,440
!إنّه يزداد حدّةً وصلابةً وقوّةً كلّما حُمّي وطُرق

250
00:22:46,890 --> 00:22:48,140
القضيب؟

251
00:22:48,140 --> 00:22:49,390
سيف؟

252
00:22:50,560 --> 00:22:53,890
!بدأ الأمر يغدو مثيرًا للاهتمام