1
00:00:16,620 --> 00:00:21,710
...أيّها المعلّم، هل ستواصل تعليمي فنون... كلّا

2
00:00:21,710 --> 00:00:26,420
أيّها المعلّم، أرجو أن تواصل تعليمي فنون السيف

3
00:00:27,200 --> 00:00:28,480
بالطبع

4
00:00:30,210 --> 00:00:32,730
ما دام هذا الرجل معنا فنحن في أمانٍ

5
00:00:32,850 --> 00:00:36,130
فشيون-سان هو صاحب فضلٍ عليّ ومعلّمي في السيف

6
00:00:36,130 --> 00:00:36,850
!مؤلم

7
00:00:37,010 --> 00:00:39,820
تتصرّف كمعلّمي حتّى في مثل هذه الظروف

8
00:00:40,000 --> 00:00:42,100
أشعرُ بالارتياحِ على النقيضِ تمامًا

9
00:00:43,460 --> 00:00:45,610
تستخفّ بي

10
00:00:54,490 --> 00:00:56,300
أخبرتكَ أنّي اعتدتُ ذلك

11
00:01:00,500 --> 00:01:02,210
!تينزا

12
00:01:28,940 --> 00:01:31,030
من يسلب لا يسعه أن يفهم

13
00:01:32,740 --> 00:01:36,100
فمن سُلِبَ لن ينسى أبدًا

14
00:02:02,270 --> 00:02:07,230
Rise-KuN :محاكاة

15
00:03:16,930 --> 00:03:21,560
استنزف التاو بتوجيه ضرباتٍ متتاليةٍ له كلّما تجدّد

16
00:03:21,860 --> 00:03:25,540
،جراحه ليست مميتة، لكنَّ تجدّده تباطأ كثيرًا

17
00:03:25,540 --> 00:03:27,770
ويبدو أنّه يشيخ أيضًا

18
00:03:28,190 --> 00:03:31,190
لن يقوى على فعل الكثير بعد الآن

19
00:03:40,070 --> 00:03:44,250
يمكن التحكّم بالجمادات بأقلّ قدرٍ من التاو

20
00:03:44,980 --> 00:03:46,830
!مُتْ أيّها البشريّ

21
00:04:00,580 --> 00:04:03,220
سأستغلّ هذه الفرصة لأتعافى

22
00:04:03,570 --> 00:04:06,180
إنّه منهكٌ أيضًا

23
00:04:06,600 --> 00:04:11,270
هجمات التاو المتكرّرة تقصّر من عمره

24
00:04:15,480 --> 00:04:16,490
!أيّها المعلّم

25
00:04:19,490 --> 00:04:21,990
خدعةٌ صبيانيّة، هذا بلا طائل

26
00:04:23,350 --> 00:04:25,970
تاميشي إيتو-ريو: أمطار الخريف

27
00:04:37,100 --> 00:04:39,130
لا يمكنه بلوغ التاندين

28
00:04:55,150 --> 00:04:58,740
رغم أنّكَ بلغتَ حدّكَ أيضًا

29
00:04:59,530 --> 00:05:01,530
!ما خطبك؟ تبًا

30
00:05:03,680 --> 00:05:04,530
!ابتعدي

31
00:05:10,700 --> 00:05:11,710
...معلّـ

32
00:05:29,010 --> 00:05:31,320
ما خطبك؟

33
00:05:31,320 --> 00:05:36,440
أتقصّر عمركَ لأجل شخصٍ ميّتٍ؟

34
00:05:36,910 --> 00:05:38,810
لِمَ تتمادى إلى هذا الحدّ؟

35
00:05:42,810 --> 00:05:44,950
لم أفعل شيئًا بعد

36
00:05:45,030 --> 00:05:50,090
لا يسعني التألّم أو الحزن الآن

37
00:05:50,770 --> 00:05:55,310
لا يسعني حتّى الغضب ما دمتَ حيًّا

38
00:05:56,430 --> 00:05:59,230
سأترك كلّ ذلك إلى ما بعد قتلكَ

39
00:05:59,360 --> 00:06:01,970
اليأس والحزن سيأتيان لاحقًا

40
00:06:02,530 --> 00:06:06,890
والآن، كم مرّةً عليَّ قطعكَ لأرديكَ قتيلًا؟

41
00:06:07,720 --> 00:06:10,990
!هذا سيّئ، هذا سيّئ، هذا سيّئ

42
00:06:10,990 --> 00:06:12,480
...عليَّ فعل شيءٍ ما

43
00:06:12,480 --> 00:06:14,120
!بأيّ طريقة

44
00:06:27,900 --> 00:06:29,240
لا تذعر

45
00:06:29,680 --> 00:06:33,240
يستحيل أن يتعافى التاو في وقتٍ قصيرٍ

46
00:06:42,510 --> 00:06:45,210
أظننتَ أنّكَ اقتربت؟

47
00:06:45,210 --> 00:06:47,510
لا تستخفّ بي أيّها البشريّ

48
00:06:48,140 --> 00:06:51,260
...كان أحد رفاقي ذكرًا وأنثى في آنٍ واحد

49
00:06:51,260 --> 00:06:55,020
يُدوّر الين واليانغ بمفرده ليصقل التاو

50
00:06:55,410 --> 00:06:57,140
قلّدتُ ذلك

51
00:06:58,080 --> 00:07:02,900
الحفاظ على كِلا الجنسين معًا صعبٌ، لكن لا خيار أمامي الآن

52
00:07:02,900 --> 00:07:04,210
...فضلًا عن ذلك

53
00:07:06,060 --> 00:07:09,160
كنتُ أعلم، ظننتُ أنَّ الأمر كذلك

54
00:07:09,650 --> 00:07:11,600
،إن كان التحوّل الجزئيّ ممكنًا

55
00:07:11,610 --> 00:07:13,750
فالكيشيكاي ممكن أيضًا

56
00:07:16,200 --> 00:07:21,990
والآن، كم مئة مرّةٍ أخرى سنستمرّ؟

57
00:07:28,320 --> 00:07:31,560
أقسم أنّي سأحسم هذا الأمر

58
00:07:31,560 --> 00:07:35,310
اعتدتُ على ألاعيبكَ بالفعل

59
00:07:52,080 --> 00:07:53,390
ألاعيب

60
00:07:55,090 --> 00:07:56,540
سمّيها ما شئتِ

61
00:07:56,540 --> 00:07:58,050
هذه ماهيّتي

62
00:08:06,120 --> 00:08:09,800
أمي الّتي كانت فنّانةً متجوّلةً هي من سبّبتْ لي هذه الندوب

63
00:08:12,300 --> 00:08:16,060
كان عرضنا عبارةً عن طفلٍ أعمى يتفادى ضربات الزبائن بسيفٍ خشبيّ

64
00:08:16,360 --> 00:08:19,300
طفلٌ معجزةٌ يسعه توقّع مسار ضربات السيف

65
00:08:19,800 --> 00:08:23,570
كنتُ أنا وأمي نستميتُ للبقاء على قيد الحياة

66
00:08:25,330 --> 00:08:28,950
كانت الندوب جزءًا من العرض، لكنّي وُلدتُ أعمى

67
00:08:29,130 --> 00:08:35,410
كان الأمر هيّنًا عليَّ منذ طفولتي، فقد اعتدتُ استشعار العالم عبر الأمواج؛ أو ما يُعرف بالتاو

68
00:08:38,350 --> 00:08:40,210
...وبعد أن تناهتْ سمعتي إلى مسامع سوروكو كينغيو

69
00:08:40,210 --> 00:08:42,470
ضمّني إلى نقابة تودوزا للمكفوفين

70
00:08:42,620 --> 00:08:45,660
ومن خلالهم، طرقتُ أبواب عشيرة يامادا

71
00:08:46,020 --> 00:08:50,220
كانت فرصةً لا تُعوّض لفنّانةٍ متجوّلةٍ فقيرةٍ وابنها

72
00:08:55,020 --> 00:08:59,700
مهارةٌ لا يُعقل أن تكون لطفلٍ، ناهيكَ عن كونه أعمى

73
00:08:59,700 --> 00:09:01,490
من أين لكَ هذه الندوب؟

74
00:09:02,120 --> 00:09:05,080
والد هذا الطفل سيّافٌ شهيرٌ

75
00:09:05,200 --> 00:09:09,270
حظي بموهبةٍ فذّة، وأُصيب في معركةٍ وهو صغيرٌ

76
00:09:09,640 --> 00:09:14,030
كانت أمّي تختلق الكذبة ذاتها كلّما سُئلنا عن الأمر

77
00:09:18,750 --> 00:09:21,750
وكنتُ أفعل المثل

78
00:09:24,200 --> 00:09:29,030
،لعجزي عن التراجع عن التفسير الّذي قُدّم لكينغيو وتشويه سمعة أمّي

79
00:09:29,480 --> 00:09:33,430
أمضيتُ أيّامي في عشيرة يامادا أُخفي ماضيّ

80
00:09:34,100 --> 00:09:35,630
وكنتُ خجلًا من ذلك

81
00:09:36,510 --> 00:09:39,050
لا يهمّ الماضي

82
00:09:39,180 --> 00:09:42,570
الأهمّ هو الحاضر، أليس كذلك؟

83
00:09:43,770 --> 00:09:45,130
لم أقصد ذلك

84
00:09:45,130 --> 00:09:47,630
حذّرتكَ بأن تتصرّف كفردٍ من عشيرة يامادا

85
00:09:47,760 --> 00:09:53,890
أنا أتصرّف كذلك، أريدكَ أن تنظر إليَّ لا إلى نشأتي يا سينباي

86
00:09:54,700 --> 00:09:57,040
تينزا-كن وشوغين-سان يتشاجران مجدّدًا

87
00:09:57,070 --> 00:09:58,740
هذا ممتع، لندعهما وشأنهما

88
00:10:01,700 --> 00:10:06,170
غبطتُ تينزا الّذي كان على سجيّته ولا يهاب شيئًا

89
00:10:06,520 --> 00:10:11,500
لمستُ فيه إمكانيّاتٍ واعدةً، فقد تقبّله الجميع على طبيعته

90
00:10:14,330 --> 00:10:18,850
براعتكَ في السيف لتُثيرُ الذُّهول أيُّها المُعلِّم

91
00:10:18,850 --> 00:10:20,980
أنتَ قدوتي

92
00:10:23,130 --> 00:10:27,070
لا، أنتَ مخطئٌ، بل أنا من يقتدي بك

93
00:10:34,870 --> 00:10:39,940
!سأقتلكِ بيديّ هاتين، حتّى لو كلّفني ذلك حياتي

94
00:10:50,130 --> 00:10:53,360
يسعني استخدام قوّة الكيشيكاي أثناء التعافي

95
00:10:53,360 --> 00:10:55,330
...لا أمل لك في النصر بعد الآ

96
00:10:55,330 --> 00:10:56,330
!اخرسي

97
00:10:57,090 --> 00:11:01,010
مظهركِ وقدراتكِ المبهرجة مجرّد تهديداتٍ فارغة

98
00:11:01,680 --> 00:11:06,480
تركّزين ما تبقّى من قوّتكِ الضئيلة على التظاهر فحسب

99
00:11:06,600 --> 00:11:09,360
سيغدو تاوكَ كتاو البشر قريبًا

100
00:11:09,780 --> 00:11:12,330
تمثيلكِ المريع لن ينطلي عليّ

101
00:11:13,160 --> 00:11:19,250
لا يسع أيًّا منّا تسديد ضربةٍ قاضية، ممّا يعني أنّنا في مأزقٍ

102
00:11:19,400 --> 00:11:21,870
هذه معركة استنزافٍ بشعةٍ ومميتة

103
00:11:22,730 --> 00:11:23,950
أأنتِ مستعدّة؟

104
00:11:28,000 --> 00:11:29,200
!أيّها المعلّم

105
00:11:30,730 --> 00:11:31,740
نوروغاي

106
00:11:36,660 --> 00:11:40,860
تراجعي، سأتولّى الباقي

107
00:11:43,000 --> 00:11:45,780
سيغدو الأمر خطيرًا الآن

108
00:11:48,900 --> 00:11:50,110
!تبًّا

109
00:11:59,840 --> 00:12:03,280
لعجزي عن التضّاد، لا خيار أمامي سوى حرب استنزافٍ هنا

110
00:12:03,420 --> 00:12:07,270
إذن، كيف أستهلك التاو بكفاءة؟

111
00:12:08,150 --> 00:12:10,670
لا داعي لقطعهم مئات المرّات

112
00:12:10,670 --> 00:12:13,250
ألن يكون طعنهم بالسيف أسهل؟

113
00:12:13,690 --> 00:12:15,010
هذا صحيح

114
00:12:15,350 --> 00:12:17,450
ينبغي أن يكون ذلك ممكنًا فيزيائيًّا

115
00:12:17,450 --> 00:12:21,760
يبدو أنَّ تاندين التينسين-ساما عبارةٌ عن بويضاتٍ داخل أجسادهم

116
00:12:22,190 --> 00:12:25,160
...إن أردنا استنزاف التاو بإجبارهم على التجدّد مرارًا

117
00:12:25,160 --> 00:12:26,770
فسيكون الطعن فعّالًا

118
00:12:31,100 --> 00:12:32,440
بتر أطرافهم

119
00:12:33,730 --> 00:12:34,990
...أو ربّما

120
00:12:36,170 --> 00:12:39,400
استخراج البويضة وطعنها فحسب

121
00:12:40,060 --> 00:12:43,910
بما أنّنا معتادون على انتزاع الكبد فسيكون الأمر سهلًا

122
00:12:44,460 --> 00:12:47,220
المعضلة تكمن في إمكانيّة إبقاء السيف مغروسًا

123
00:12:47,850 --> 00:12:48,650
فهمت

124
00:12:49,040 --> 00:12:52,670
مجرّد تخيّل الأمر يثير اشمئزازي، لا يسعني فعل ذلك

125
00:13:02,800 --> 00:13:05,680
،يتجدّدون، وتنمو الأحراش

126
00:13:05,680 --> 00:13:07,450
يُسحب السيف

127
00:13:07,560 --> 00:13:10,190
،حتّى لو ثبّته، فستتعرّض للإعاقة

128
00:13:10,890 --> 00:13:12,400
ويخترقونك

129
00:13:12,940 --> 00:13:14,270
!أيّها المعلّم

130
00:13:18,590 --> 00:13:20,710
إنّهم أضعف ممّا توقعت

131
00:13:21,240 --> 00:13:23,400
أهذا لأنّي استنزفتُ التاو؟

132
00:13:24,210 --> 00:13:28,040
أخبرتكِ أنّها ستكون معركة استنزاف

133
00:13:28,330 --> 00:13:32,040
من سيُستنزف أولًا، أنا أم أنتِ؟

134
00:13:32,510 --> 00:13:34,370
جئتُ لأصفي الحساب

135
00:13:36,120 --> 00:13:39,210
!إن كان موتًا متبادلًا، فالنصر حليفي

136
00:13:52,530 --> 00:13:58,070
...هذا الألم لا يُقارن بلحظاته الأخيرة

137
00:13:58,390 --> 00:14:00,570
!أيّها المعلّم، توقّف

138
00:14:00,790 --> 00:14:02,450
!ستموت إن لم تتوقف الآن

139
00:14:02,820 --> 00:14:03,950
!ابقي بعيدة

140
00:14:05,650 --> 00:14:09,700
يسعني القضاء على هذا الوحش إن واصلتُ القتال

141
00:14:09,930 --> 00:14:14,710
عليكِ الخروج من هنا والبحث عن الآخرين

142
00:14:15,320 --> 00:14:18,370
سأبقى هنا

143
00:14:20,250 --> 00:14:22,720
هذا غير منطقيّ

144
00:14:23,490 --> 00:14:25,720
أنتَ ذكيّ

145
00:14:26,040 --> 00:14:28,220
وتفكّر مليًّا

146
00:14:28,610 --> 00:14:31,010
وتُحسن اتخاذ القرارات الصائبة، أليس كذلك؟

147
00:14:31,980 --> 00:14:33,650
!هذا ليس من شيمك

148
00:14:36,940 --> 00:14:41,860
أدركتُ معنى صرخته على الفور حينها

149
00:14:43,460 --> 00:14:45,950
أدركَ أنَّ الموقف لا يُرجى فيه النصر، وتجنّبٌ للإبادة

150
00:14:45,970 --> 00:14:49,110
فهمتُ نواياه وتصرّفتُ على الفور

151
00:14:50,370 --> 00:14:53,080
كان القرار الصائب

152
00:14:54,720 --> 00:14:58,630
لِمَ كان عليَّ اتّخاذ القرار الصائب؟

153
00:14:59,700 --> 00:15:02,910
لِمَ لمْ أبقَ بجانبه حتّى لو كان ذلك حماقةً؟

154
00:15:04,750 --> 00:15:10,630
كم كابد من حسرةٍ وألمٍ في لحظاته الأخيرة يا ترى؟

155
00:15:11,710 --> 00:15:15,570
لا يسعني مسامحة نفسي لفراري فحسب

156
00:15:18,130 --> 00:15:25,320
لا يسعني مسامحة نفسي لاختياري الصواب حتّى حين كنتُ أفقد شخصًا غاليًّا

157
00:15:28,100 --> 00:15:33,540
...لا يسع هاتين العينين ذرف الدموع حتّى، لذا على الأقلّ

158
00:15:37,170 --> 00:15:38,400
!أيّها المعلّم

159
00:15:39,690 --> 00:15:43,670
دعي الأمر لي واذهبي للآخرين

160
00:15:43,970 --> 00:15:46,170
...مُحال، ولكن

161
00:15:46,170 --> 00:15:48,930
!أسرعي

162
00:16:00,570 --> 00:16:04,030
المعلّم يمرّ بما مررتُ به حينها

163
00:16:05,460 --> 00:16:10,560
فقدتُ شخصًا عزيزًا ولم يسعني مسامحة نفسي

164
00:16:16,610 --> 00:16:21,860
غدا تائهًا لا يدري أفي العيشِ نجاتُهُ أم في الردى؛ مثلي تمامًا

165
00:16:23,080 --> 00:16:28,300
نجوتُ بمفردي، رغم أنَّ الجميع ماتوا بسببي

166
00:16:34,220 --> 00:16:36,310
...لا أفهم

167
00:16:39,070 --> 00:16:41,410
لِمَ ترغبين في الموتِ إذن؟

168
00:16:43,350 --> 00:16:46,570
أجل، هذا صحيح

169
00:16:46,990 --> 00:16:49,280
...إن لم تشرح لي الأمر جيّدًا

170
00:16:50,230 --> 00:16:56,080
...إن لم أقتنع، فلن... فلن

171
00:17:06,690 --> 00:17:09,090
!تينـ... تينزا

172
00:17:09,540 --> 00:17:16,660
...أنا... المعلّم، أنا

173
00:17:21,800 --> 00:17:25,190
إذن، ليس أمامكِ سوى خيارٍ واحدٍ

174
00:17:29,440 --> 00:17:30,700
أجل

175
00:17:42,630 --> 00:17:45,140
...إن لم تشرح لي الأمر جيّدًا

176
00:17:45,140 --> 00:17:49,410
إن لم أقتنع، فلن أعود

177
00:17:52,800 --> 00:17:55,740
لم أعد أسمع شيئًا

178
00:17:56,910 --> 00:18:01,230
لا أدري كم مضى من الوقت أو إلى متى سأحتمل

179
00:18:02,690 --> 00:18:09,180
لا أشعر سوى بحياتي تتلاشى ببطءٍ ووضوحٍ

180
00:18:16,700 --> 00:18:22,760
ببطءٍ... هذا يعني أنَّ الطعن كان فعّالًا

181
00:18:24,220 --> 00:18:27,010
...تينزا، أخيرًا

182
00:18:36,290 --> 00:18:37,290
...نورو

183
00:18:53,420 --> 00:18:54,700
ما الّذي تفعلينه؟

184
00:18:54,700 --> 00:18:57,230
أعانقكَ لتستعيد التاو

185
00:18:58,920 --> 00:19:01,190
!هذا ليس بالوقت المناسب

186
00:19:03,200 --> 00:19:06,680
على الفتيات ألّا يندفعنَ لضمِّ من هبَّ ودبَّ بهذه السهولة

187
00:19:06,820 --> 00:19:08,590
لا يجدر بكِ فعل ذلك لأسبابٍ عدّة

188
00:19:11,290 --> 00:19:14,340
عُدتَ إلى طبعِكَ المعهود الآن

189
00:19:16,340 --> 00:19:17,310
انظر

190
00:19:18,520 --> 00:19:21,980
لم تموت، لكنَّ تجدّدها تباطأ

191
00:19:21,980 --> 00:19:24,850
سيستغرق تعافيها يومًا كاملًا

192
00:19:25,820 --> 00:19:28,100
لذا يجدر بنا قتلها الآن

193
00:19:28,100 --> 00:19:31,350
كلّا، لذا يجدر بنا تركها وشأنها

194
00:19:32,360 --> 00:19:34,980
ستطعنكَ بالأحراش إن اقتربتَ مجدّدًا

195
00:19:35,110 --> 00:19:37,240
ستموت إن واصلتَ القتال أيّها المعلّم

196
00:19:38,080 --> 00:19:40,870
لنعدْ إلى الآخرين الآن

197
00:19:44,860 --> 00:19:46,940
لا يسعني ذلك

198
00:19:47,850 --> 00:19:51,380
إن لم أقضِ عليها، فلن ترقد روح تينزا بسلامٍ

199
00:19:52,250 --> 00:19:54,420
...معاناته

200
00:19:55,630 --> 00:19:56,850
أنتَ مخطئ

201
00:19:58,310 --> 00:20:01,390
لم يعانِ أو يمتْ نادمًا

202
00:20:02,070 --> 00:20:03,540
أنا مخطئ؟

203
00:20:04,240 --> 00:20:08,790
رأيته حين حملتني بعيدًا

204
00:20:09,400 --> 00:20:12,650
كان يبتسم

205
00:20:13,250 --> 00:20:15,650
كان يبتسم وهو يرانا نبتعد

206
00:20:16,880 --> 00:20:20,510
كنتَ تتألّم طوال هذا الوقت لجهلكَ بذلك أيّها المعلّم

207
00:20:21,170 --> 00:20:23,980
هذا لأنّكَ اضطررتَ لحملي، آسفة

208
00:20:25,010 --> 00:20:26,760
كانت ابتسامةً جميلةً

209
00:20:27,720 --> 00:20:31,420
كان الأمر محزنًا، لكنّه بدا رائعًا

210
00:20:33,020 --> 00:20:36,940
لذا لا وجود للحسرة أيّها المعلّم

211
00:20:44,090 --> 00:20:50,690
انشغلنا بالانتقام ولم نتحدّث كثيرًا عن تينزا

212
00:20:51,740 --> 00:20:56,190
حدّثني عنه، أريد معرفة المزيد عنه

213
00:20:57,270 --> 00:21:02,580
لِنُؤجِّل حديثنا حتَّى نُغادر هذا المكان أحياءً

214
00:21:25,060 --> 00:21:26,470
أنتِ محقّة

215
00:21:26,870 --> 00:21:31,420
لنُنهِ هذا الأمر، لن أتمادى أكثر

216
00:21:33,270 --> 00:21:35,010
لنذهب إلى الآخرين

217
00:21:37,950 --> 00:21:38,770
أجل

218
00:21:40,180 --> 00:21:42,350
شكرًا لكِ يا نوروغاي

219
00:21:43,070 --> 00:21:45,910
منحتِني الحياة

220
00:21:54,010 --> 00:21:57,010
أنا من يجدر به مناداتكِ بالمعلّمة

221
00:21:57,650 --> 00:21:59,260
انقشعَ الضبابُ عن بصيرتي

222
00:22:00,430 --> 00:22:01,900
يبدو أنَّكِ لا تسمعينني

223
00:22:10,140 --> 00:22:13,150
جوجين، هُزمتَ إذن

224
00:22:17,600 --> 00:22:19,100
...شيون-دونو

225
00:22:23,480 --> 00:22:25,620
هلّا أعدتَ النظر في الأمر؟

226
00:22:26,180 --> 00:22:30,060
سنواصل فقدان أحبّائنا إن استمرّ الوضع هكذا

227
00:22:30,410 --> 00:22:33,380
وهذا محزنٌ للغاية

228
00:22:35,840 --> 00:22:36,780
أرجوك