4
00:01:46,910 --> 00:01:48,250
.لا

5
00:01:48,250 --> 00:01:49,950
.لم يكن كذلك

6
00:01:49,950 --> 00:01:51,000
نيني-تشان؟

7
00:01:51,000 --> 00:01:52,950
...كان ذلك

8
00:01:51,000 --> 00:01:52,950
.نيني-تشان

9
00:01:52,950 --> 00:01:54,660
!نيني-تشان

10
00:01:54,660 --> 00:01:55,620
هل تنصتين إلي؟

11
00:01:55,620 --> 00:01:56,870
.آ-آسفة

12
00:01:56,870 --> 00:02:01,450
