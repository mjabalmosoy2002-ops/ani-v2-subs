1
00:01:58,700 --> 00:02:01,840
هذا الحامي سريع في حركة قدميه

2
00:02:01,840 --> 00:02:03,290
!لكن ليس سريعاً بما يكفي

3
00:02:37,130 --> 00:02:39,000
...لن أسقط هنا

4
00:02:39,440 --> 00:02:41,510
لسوء حظّك

5
00:02:45,230 --> 00:02:48,000
لن أدعك تتحوّل

6
00:02:56,880 --> 00:02:58,600
بئس الأمر

7
00:02:58,600 --> 00:03:02,620
انتهى المطاف بي بمُطاردته
إلى داخل حديقة الحيوانات

8
00:03:05,030 --> 00:03:08,510
اسمع، المكان خطير هنا. عليك الهرب

9
00:03:08,510 --> 00:03:09,990
أين أمّي؟

10
00:03:09,990 --> 00:03:10,690
ماذا؟

11
00:03:10,690 --> 00:03:12,930
لا أستطيع إيجادها

12
00:03:12,930 --> 00:03:14,440
إنّه ضائع

13
00:03:23,620 --> 00:03:25,170
!ابقَ بعيداً عنه

14
00:03:25,460 --> 00:03:27,660
!الأطفال هم مستقبل الأرض

15
00:03:27,660 --> 00:03:28,940
!لن أدعك تؤذيهم

16
00:03:43,860 --> 00:03:47,610
انتباه إلى كافّة الزوّار، وردنا
بلاغ بطفل مفقود

17
00:03:48,250 --> 00:03:54,270
يرتدي كيتارو قميصاً مُخطّطاً
ويحمل باندا محشوّاً

18
00:03:54,270 --> 00:03:56,070
أمّه تبحث عنه

19
00:03:56,720 --> 00:04:01,210
الرّجاء على من يجده أن يبلغ أقرب موظّف

20
00:04:03,990 --> 00:04:06,110
هل أنت كيتارو؟

21
00:04:06,850 --> 00:04:07,800
اسمي كي

22
00:04:08,240 --> 00:04:11,060
أحبُّ الباندا

23
00:04:11,060 --> 00:04:14,470
حقّاً؟ أحبُّ الباندا أيضاً

24
00:04:14,470 --> 00:04:16,450
قالوا أنّ أمّك تبحث عنك

25
00:04:16,450 --> 00:04:18,120
!سوف تراها قريباً

26
00:04:20,070 --> 00:04:22,130
—لا تقلق. تعال معي و

27
00:04:21,270 --> 00:04:24,580
من أجل مركز الأطفال المفقودين، سِر
للأمام مباشرة ثمّ انعطف يميناً

28
00:04:28,660 --> 00:04:30,610
تحرّك

29
00:04:30,610 --> 00:04:33,460
حبّاً بالباندا، سأتوقّف

30
00:04:34,080 --> 00:04:36,830
لكن لن يتكرّر ذلك

31
00:04:38,830 --> 00:04:40,550
لا مانع لديّ

32
00:05:04,520 --> 00:05:06,180
حدث شيء ما

33
00:05:06,180 --> 00:05:08,400
لم أتمكّن من إتمام مهمّتي

34
00:05:08,400 --> 00:05:10,290
هذا مؤسف جدّاً

35
00:05:10,290 --> 00:05:11,740
أنا في طريق العودة

36
00:05:11,740 --> 00:05:14,850
ماذا؟ لكن اقترب انتهاء وقت العمل

37
00:05:14,850 --> 00:05:16,870
يكفي لليوم

38
00:05:16,870 --> 00:05:17,840
لا

39
00:05:17,840 --> 00:05:19,230
!حسناً، بالتّوفيق لك في عملك

40
00:05:19,230 --> 00:05:20,030
أنت

41
00:05:24,460 --> 00:05:26,480
ما زال لديّ وقت

42
00:05:30,390 --> 00:05:32,720
فرس النّهر

43
00:05:35,100 --> 00:05:39,100
حيوانات محشوّة كبيرة

44
00:05:39,370 --> 00:05:44,670
إنّها لَحقيقة كونيّة أن المخلوقات
المدعوّة باندا مُبهرة

45
00:05:45,220 --> 00:05:49,990
لكن الأشياء الّتي تُصنَع على هيئتها
هي أيضاً بالمقابل مُبهرة

46
00:05:52,620 --> 00:05:56,580
من الطبيعيّ أن تكون الأشياء
الّتي تشبه الأصل ظريفة

47
00:05:56,580 --> 00:06:00,600
لكن الكاريكاتيرات تمتلك سحراً خاصّاً بها

48
00:06:03,730 --> 00:06:07,380
!إن كان كذلك، يجب أن أراعي شعورهم

49
00:06:11,310 --> 00:06:14,010
هكذا إذاً، هذا الفراء قاسٍ بعض الشّيء

50
00:06:17,730 --> 00:06:20,980
يبدو متيناً أكثر من كونه ليّناً

51
00:06:20,980 --> 00:06:22,270
هذا ممتاز

52
00:06:23,390 --> 00:06:26,020
والآن بالنّسبة للكاريكاتير

53
00:06:34,650 --> 00:06:36,020
ما هذا؟

54
00:06:36,020 --> 00:06:39,860
هذه اللّيونة الّتي تدغدغ البشرة؟

55
00:06:40,650 --> 00:06:45,610
!تجعلني أرغب... في لمسها للأبد

56
00:06:55,680 --> 00:06:57,470
أيُعقَل هذا؟

57
00:06:57,470 --> 00:07:00,160
أنا عاجزٌ الآن عن وضعها جانباً

58
00:07:00,160 --> 00:07:02,610
!لا أملك خياراً سوى شرائها

59
00:07:24,140 --> 00:07:25,670
هل هذه هدايا لشخص ما؟

60
00:07:25,670 --> 00:07:27,350
إنّها لي

61
00:07:30,990 --> 00:07:35,650
نحن ممتنّون كثيراً لمجيئك
إلى حديقة حيواناتنا اليوم

62
00:07:36,250 --> 00:07:38,710
نتطلّع قُدماً لزيارتك المقبلة

63
00:08:06,630 --> 00:08:08,620
لِمَ لا تذهب إلى المنزل؟

64
00:08:10,170 --> 00:08:12,610
لم أنتهِ من العمل بعد

65
00:08:12,610 --> 00:08:15,350
أجل، ذلك الاجتماع التّنفيذيّ
استغرقَ وقتاً طويلاً

66
00:08:15,350 --> 00:08:16,920
على ذكرِ الأمر

67
00:08:16,920 --> 00:08:19,400
تلك المخلوقات الّتي تحبّها
يا حضرة القائد العسكريّ

68
00:08:19,400 --> 00:08:20,900
إنّها الباندا

69
00:08:20,900 --> 00:08:26,260
أجل، الباندا. أليس هناك ثلاثة
منهم داخل منطقتنا؟

70
00:08:26,260 --> 00:08:29,030
وسمعتُ أنّه قد يكون هناك آخر

71
00:08:29,410 --> 00:08:31,500
ماذا قلتَ للتوّ؟

72
00:08:32,790 --> 00:08:37,700
لأكون دقيقاً، توجد أشياء شبيهة بالباندا هناك

73
00:08:37,700 --> 00:08:40,000
وأين هي؟

74
00:08:40,440 --> 00:08:43,660
في الحقيقة، هنا

75
00:08:44,460 --> 00:08:47,750
...إن كان يوجد باندا هناك فعلاً

76
00:08:48,580 --> 00:08:50,920
!فسأذهب لرؤيتها بأمّ عيني

77
00:08:50,920 --> 00:08:53,210
!انتظري فحسب أيّتها الباندا

78
00:08:56,400 --> 00:08:58,610
...ينبغي أن تحصل على قسطٍ من الرّاحة

79
00:09:13,240 --> 00:09:17,240
تويوكان

80
00:09:29,170 --> 00:09:32,760
بوّابة أساكوسا

81
00:09:30,150 --> 00:09:32,760
أساكوسا هاناياشيكي

82
00:09:35,800 --> 00:09:37,680
وصلتُ باكراً جدّاً

83
00:09:38,510 --> 00:09:39,390
البريد العاديّ

84
00:09:38,510 --> 00:09:39,390
أحجام غير قياسيّة

85
00:09:51,370 --> 00:09:53,150
سأقف في الطّابور

86
00:09:55,530 --> 00:09:59,530
بوّابة أساكوسا

87
00:09:57,360 --> 00:09:59,530
الخروج

88
00:09:57,360 --> 00:09:59,530
الدّخول

89
00:10:18,370 --> 00:10:20,650
أين الباندا؟

90
00:10:21,400 --> 00:10:24,890
لا يبدو هذا مكاناً يحتوي على باندا

91
00:10:24,890 --> 00:10:26,690
...روني

92
00:10:26,690 --> 00:10:30,970
آمل أنّك لم تكن نصف نائم
وتتوهّم رؤية أشياء

93
00:10:32,010 --> 00:10:34,280
سوف أتحرّى على أيّ حال

94
00:10:34,280 --> 00:10:35,830
!لنُسرع

95
00:10:35,830 --> 00:10:38,780
المركبات موجودة سواء أسرعنا أم لا

96
00:10:38,780 --> 00:10:43,040
لكن بما أنّنا هنا، سيكون من الهدر
!إذا لم نركب الكثير منها

97
00:10:43,040 --> 00:10:45,310
ما رأيكِ أن نحصل على دخول مجّاني إذاً؟

98
00:10:45,310 --> 00:10:46,280
!لنفعل

99
00:10:49,120 --> 00:10:50,440
!هيّا

100
00:10:51,310 --> 00:10:56,410
هل ركوب المركبات هو ما يفعله النّاسُ هنا؟

101
00:10:56,410 --> 00:10:59,660
هدفي النّهائيّ هو إيجاد الباندا

102
00:10:59,660 --> 00:11:03,140
لكن لن يكون من الجيّد دفع
سكّان الأرض للشّكوك

103
00:11:05,920 --> 00:11:08,640
دخول مجّاني لبالغ واحد

104
00:11:08,640 --> 00:11:09,640
!من جديد

105
00:11:09,640 --> 00:11:11,690
!لنصعد مركبة الدوّامة من جديد

106
00:11:11,690 --> 00:11:14,190
من جديد؟ ما رأيك بشيء آخر؟

107
00:11:14,190 --> 00:11:17,940
!لا! أريد ركوب السيّد حصان ثانية

108
00:11:17,100 --> 00:11:19,430
لديهم حصان هنا؟

109
00:11:17,940 --> 00:11:20,970
!السيّد حصان هو المُفضّل لديّ

110
00:11:19,430 --> 00:11:22,200
في هذه الحالة، ربّما هناك باندا

111
00:11:20,970 --> 00:11:23,270
!ألا يمكنني ركوب واحد مرّة أخرى؟

112
00:11:29,410 --> 00:11:36,860
منطقة
الصُّعود

113
00:11:32,210 --> 00:11:34,870
أظنّني سأجرّب ركوب السيّد حصان

114
00:12:12,580 --> 00:12:14,120
من جديد؟

115
00:12:14,120 --> 00:12:17,930
لماذا يلوّح سكّان الأرض لي؟

116
00:12:18,170 --> 00:12:32,480
البيت المسكون

117
00:13:08,630 --> 00:13:12,160
أي نوع من التّدريب يُفترَض أن يكون هذا؟

118
00:13:12,160 --> 00:13:14,400
!لا وجود للباندا في أي مكان

119
00:13:18,230 --> 00:13:26,490
المخرج

120
00:13:20,920 --> 00:13:22,560
!كان ذلك مُمتعاً للغاية

121
00:13:22,560 --> 00:13:23,740
!لنركبها مجدّداً

122
00:13:23,740 --> 00:13:24,470
!أجل

123
00:13:36,180 --> 00:13:39,370
احذر دوماً من سكّان الأرض

124
00:13:39,370 --> 00:13:41,640
...السّماح للأطفال بركوب هذه الأشياء

125
00:13:41,640 --> 00:13:44,900
آمل ألّا يكون هذا مركز تدريب للحُماة

126
00:13:45,510 --> 00:13:48,080
ما هذا المكان بالضّبط؟

127
00:13:54,790 --> 00:13:59,210
أهذه تجربتك الأولى هنا يا سيّد؟

128
00:13:59,520 --> 00:14:01,520
الأفعوانيّة

129
00:14:02,440 --> 00:14:06,770
مُدُن الملاهي هي حيث يستطيع
الجميع أن يكونوا أطفالاً

130
00:14:07,580 --> 00:14:11,970
آتي إلى هنا من وقتٍ لآخر

131
00:14:12,790 --> 00:14:15,580
ليس وكأنّني أستطيع تحمُّل كافّة المركبات

132
00:14:16,150 --> 00:14:19,320
ألقِ نظرة

133
00:14:21,830 --> 00:14:25,780
يفيض المكان بالابتسامات والسّعادة

134
00:14:26,420 --> 00:14:30,080
إنّه فضاء معزولٌ تماماً عن الحياة اليوميّة

135
00:14:30,080 --> 00:14:34,370
والغريب، يجعل الجميع يبدون كأطفال

136
00:14:35,230 --> 00:14:40,970
عندما آتي إلى هنا وأرى النّاس
،يستمتعون بأيّام عطلتهم القصيرة

137
00:14:41,720 --> 00:14:45,360
يعيدني ذلك للذّكريات

138
00:14:46,920 --> 00:14:48,450
هل تعلم؟

139
00:14:49,210 --> 00:14:51,680
!لديهم باندا هنا

140
00:14:51,680 --> 00:14:54,620
!أحبُّ ركوبها

141
00:14:57,870 --> 00:14:59,640
!جدّي

142
00:15:03,450 --> 00:15:05,040
!لنذهب إلى هناك

143
00:15:05,330 --> 00:15:07,390
ماذا كان ذلك؟

144
00:15:09,000 --> 00:15:13,640
يبدو أنّ مُدُن الملاهي ليست
مراكز تدريب للحُماة

145
00:15:13,640 --> 00:15:17,520
كان ينبغي أن أسأله عن مكان الباندا

146
00:15:22,810 --> 00:15:25,820
حديقة أطفال النّينجا

147
00:15:25,820 --> 00:15:28,820
متجر الهدايا هانامارو

148
00:15:28,820 --> 00:15:31,780
هدايا تذكاريّة

149
00:15:33,520 --> 00:15:37,950
أكلات خفيفة وقرطاسيّة باندا

150
00:15:37,950 --> 00:15:40,400
شارات وملصقات باندا

151
00:15:40,400 --> 00:15:44,840
ما تشكيلة بضاعة الباندا الشّاملة هذه؟

152
00:15:46,980 --> 00:15:49,430
هذا ذيل باندا؟

153
00:15:49,430 --> 00:15:54,310
هل الباندا الّتي تقطن هنا هي
نوع جديد بذيل أسود؟

154
00:15:58,340 --> 00:16:00,360
!ما معنى هذا؟

155
00:16:00,360 --> 00:16:05,240
!باندا محبوسة داخل كبسولات صغيرة؟

156
00:16:05,240 --> 00:16:09,080
!اللّعنة عليكم يا سكَّان الأرض الأشرار

157
00:16:09,080 --> 00:16:11,940
!لكن لا تخافوا أيُّها الباندا

158
00:16:11,940 --> 00:16:14,690
!سأهرع إلى مساعدتكم

159
00:16:15,810 --> 00:16:17,660
!لن أترك باندا خلفي

160
00:16:18,170 --> 00:16:20,650
!جميعكم

161
00:16:28,970 --> 00:16:31,500
ها قد تحرّرتُم

162
00:16:31,500 --> 00:16:34,940
لكن لماذا جميعكم مُتشابهون تماماً؟

163
00:16:35,390 --> 00:16:37,430
المهمّ أن تكونوا ظرفاء

164
00:16:37,430 --> 00:16:41,800
على ذكرِ الأمر. يجب أن أسرع
وأبحث عن باندا الذّيل الأسود

165
00:16:42,760 --> 00:16:43,970
أين هم؟

166
00:16:44,930 --> 00:16:47,140
أين أنتم أيُّها الباندا؟

167
00:16:47,690 --> 00:16:50,430
!سوف أجدكم مهما كلّف الأمر

168
00:16:53,880 --> 00:16:55,260
...أيُّها الباندا

169
00:16:55,260 --> 00:16:59,090
أين قد أجدك وأجد ذيلك الأسود؟

170
00:16:59,090 --> 00:17:01,310
المعذرة يا سيّد

171
00:17:02,890 --> 00:17:04,940
هل هناك ما يؤرقك؟

172
00:17:05,740 --> 00:17:07,950
أبحث عن الباندا

173
00:17:08,280 --> 00:17:09,890
الباندا؟

174
00:17:09,890 --> 00:17:12,190
!بالطّبع

175
00:17:12,190 --> 00:17:13,960
سأدلّك على الطّريق

176
00:17:24,900 --> 00:17:31,290
الباندا ذوو الذّيل الأسود مختبئون
وراء هذا المعبر الضيِّق؟

177
00:17:38,520 --> 00:17:41,490
هنا ستتمكّن من ركوب عربات الباندا

178
00:17:45,540 --> 00:17:47,240
!ماذا؟

179
00:17:48,220 --> 00:17:50,110
ما هذه؟

180
00:17:50,110 --> 00:17:51,450
باندا؟

181
00:17:51,450 --> 00:17:52,970
هذه باندا؟

182
00:17:52,970 --> 00:17:55,250
!هناك شبل حتّى

183
00:17:55,250 --> 00:17:59,980
تقصدين... أنّ هذه الباندا تسمح
لنا بركوب ظهرها؟

184
00:18:29,940 --> 00:18:33,210
إنّها مركبة إذاً

185
00:18:33,600 --> 00:18:38,990
أجل. توجد في الأرض أعاجيب كثيرة
غير موجودة في كوكبنا الأمّ

186
00:18:38,990 --> 00:18:41,540
المزيد من التحرِّي مطلوب

187
00:18:42,800 --> 00:18:43,980
ما هذا؟

188
00:18:43,980 --> 00:18:45,320
عربة باندا

189
00:18:45,320 --> 00:18:47,470
لديه ذيل أسود

190
00:18:47,470 --> 00:18:51,930
أجل. لكن الباندا الحقيقيّ لديه ذيل أبيض

191
00:18:51,930 --> 00:18:55,910
إذاً لماذا لدى عربات الباندا ذيل أسود؟

192
00:18:55,910 --> 00:19:00,250
لا أدري. لا أملك فكرة عمّا
يدور في عقول سكَّان الأرض

193
00:19:01,580 --> 00:19:03,380
لكنّه ظريف

194
00:19:04,080 --> 00:19:06,450
معك حقّ

195
00:19:22,230 --> 00:19:26,990
زرتُ حديقة حيوانات الأرض
هذه مرّات عديدة

196
00:19:27,400 --> 00:19:32,590
مؤخّراً، صرتُ أُراقب وبشكل رئيسيّ
الاختلافات في وجوه الباندا

197
00:19:32,480 --> 00:19:33,980
حامل رخصة
دخول سنويّة

198
00:19:49,240 --> 00:19:52,860
هذه الباندا الأنثى لديها صِفات جميلة

199
00:19:52,860 --> 00:19:56,010
...وهذا الذّكر هنا

200
00:20:00,580 --> 00:20:03,550
لديه عينان لوزيّتان وصِفات خشِنة

201
00:20:03,550 --> 00:20:05,260
يبدو رصيناً

202
00:20:05,260 --> 00:20:08,600
أجل، إنّه وسيم في عالم الباندا

203
00:20:09,000 --> 00:20:12,810
...لكنّه يذكّرني بشخص

204
00:20:12,810 --> 00:20:14,280
لا سيّما تلكما العينين

205
00:20:21,620 --> 00:20:24,770
يشبه إلى حدٍّ ما زميلي في العمل تريغر

206
00:20:24,770 --> 00:20:27,030
!أعتقد... لا

207
00:20:27,440 --> 00:20:32,360
تذكُّري لزملائي في العمل في يوم
!عطلتي يُخالف عقيدتي

208
00:20:31,960 --> 00:20:36,710
:عقيدته
الانعزال
عن العمل
في أيّام العطلة

209
00:20:32,360 --> 00:20:36,360
عقيدتي؟ الانعزال عن العمل في أيّام العطلة

210
00:20:46,170 --> 00:20:49,370
من جديد، يجب أن أتفوّق
على أفضل لقطة لي

211
00:20:49,890 --> 00:20:52,870
اختفت كلّ أفكاري عن زملاء
العمل من ذهني بسرعة

212
00:20:53,440 --> 00:20:58,440
عودة إلى العمل

213
00:20:59,370 --> 00:21:00,430
!بئساً

214
00:21:00,770 --> 00:21:03,860
هذه آخر سحنة أردتُ رؤيتها

215
00:21:08,160 --> 00:21:10,490
ليس لديك ما تقوله؟

216
00:21:12,160 --> 00:21:15,460
!لا تقف في طريقي

217
00:21:15,960 --> 00:21:17,460
!هل تسمعني؟

218
00:21:17,930 --> 00:21:19,380
!أنت

219
00:21:31,310 --> 00:21:34,480
!لِمَ تضحك بالضّبط؟

220
00:21:35,100 --> 00:21:36,580
!سيّدي

221
00:21:36,580 --> 00:21:38,070
!اهدأ من فضلك

222
00:21:38,070 --> 00:21:40,050
!سيّدي تـ-تريغر

223
00:21:42,100 --> 00:21:44,850
!ستدفع ثمن هذا أيُّها المُريب

224
00:21:46,630 --> 00:21:49,680
أقسم بأنّني سأمزِّقك إرباً

225
00:23:22,200 --> 00:23:24,500
أنباء سارّة من فالنسيا

226
00:23:25,590 --> 00:23:27,240
الفتق السُّرّي

227
00:23:28,890 --> 00:23:30,990
ابتسامة مندرينيّة

228
00:23:32,390 --> 00:23:34,310
التّانغور الجميل

229
00:23:34,790 --> 00:23:36,540
اليوسفي الفاتن

230
00:23:38,010 --> 00:23:39,520
عيون المَرمَلاد

231
00:23:41,750 --> 00:23:44,410
لحن سيمفونيّة ناقص

232
00:23:45,150 --> 00:23:49,940
هدايا في موسم البياض