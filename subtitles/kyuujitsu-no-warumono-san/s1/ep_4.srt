1
00:01:24,100 --> 00:01:29,980
عطلة السيّد شرّير

2
00:01:58,220 --> 00:01:59,960
!أهلاً وسهلاً

3
00:02:05,260 --> 00:02:07,800
انضممتُ للقوّة العاملة في هذا الرّبيع

4
00:02:09,410 --> 00:02:12,400
كنتُ أتطلّع قدماً للعيش بمفردي للمرّة الأولى

5
00:02:13,150 --> 00:02:17,100
في آخر اليوم، أخرج للشّرب
مع زملائي في العمل

6
00:02:18,010 --> 00:02:20,080
وأذهب إلى الصّالة الرّياضيّة

7
00:02:20,070 --> 00:02:21,720
يوميوري للسّفر

8
00:02:20,070 --> 00:02:25,220
سفر موسميّ

9
00:02:20,070 --> 00:02:25,470
زُر الجُزر الرّائعة

10
00:02:20,070 --> 00:02:26,600
المناظر الطبيعيّة وراء البحار

11
00:02:20,670 --> 00:02:23,800
في أيّام عطلتي، أزور مُختلَف
...أنواع الأماكن من باب التّسلية

12
00:02:24,650 --> 00:02:27,090
على الأقلّ، تلك كانت النيّة

13
00:02:27,710 --> 00:02:30,660
لكن لا أملك الطّاقة لذلك فحسب

14
00:02:30,980 --> 00:02:34,880
،إذا لم أبقَ في المنزل وأغسل الملابس
فلن يبقى لديّ أي لباس داخليّ

15
00:02:34,880 --> 00:02:37,420
(غداء عشب بحري (معجون السّمك

16
00:02:35,460 --> 00:02:37,420
،أردتُ أيضاً أن أطبخ لنفسي

17
00:02:38,330 --> 00:02:40,790
،لكن عندما أعود إلى المنزل
لا أستطيع حتّى القيام بذلك

18
00:02:40,790 --> 00:02:44,750
.لا يمكنني الاستمرار في العيش هكذا
إنّه باهظ جدّاً

19
00:02:45,140 --> 00:02:49,190
،مع ذلك ينتهي المطاف باستسلامي على أي حال
ثمّ أكتئب من شدّة فشلي

20
00:02:47,220 --> 00:02:49,180
جيلي الطّاقة الهائلة

21
00:02:50,290 --> 00:02:53,650
آسف. حتّى الفاشلين يجوعون

22
00:03:00,150 --> 00:03:04,580
طحن طحن طحن

23
00:03:02,360 --> 00:03:04,580
طحن

24
00:03:08,040 --> 00:03:10,870
طحن طحن طحن طحن طحن طحن طحن طحن طحن

25
00:03:08,510 --> 00:03:09,960
!يا إلهي

26
00:03:11,150 --> 00:03:14,930
إذاً ما يقولونه حول سكّان مركز
!المدينة بأنّهم خطيرون صحيح

27
00:03:14,920 --> 00:03:19,440
طحن طحن طحن طحن طحن طحن

28
00:03:15,470 --> 00:03:17,430
سيترتّب عليّ البقاء بعيداً

29
00:03:20,030 --> 00:03:21,780
هذه أنتِ

30
00:03:21,780 --> 00:03:23,250
!أهلاً وسهلاً

31
00:03:24,050 --> 00:03:26,030
إنّه على علاقة جيّدة مع الموظّفة؟

32
00:03:26,030 --> 00:03:27,140
هذا غريب

33
00:03:27,140 --> 00:03:31,220
لديّ سؤال. أين علبة الفطيرة الصّينيّة؟

34
00:03:31,790 --> 00:03:35,510
انتهت فترة التّرويج، لذا اضطررنا لإزالتها

35
00:03:36,510 --> 00:03:39,130
لا تتوفّر لدينا إلّا في بدايات أبريل

36
00:03:40,630 --> 00:03:41,930
هكذا إذاً

37
00:03:42,330 --> 00:03:44,530
!هذه خيبة أمل حقيقيّة

38
00:03:44,530 --> 00:03:46,380
!أ-أنا آسفة جدّاً

39
00:03:46,380 --> 00:03:49,250
أعلم بأنّها كانت تحليتك عند العودة من العمل

40
00:03:49,800 --> 00:03:50,770
أجل

41
00:03:51,310 --> 00:03:55,990
أعتقد لستُ الشّخص الوحيد الّذي يزور المتجر
في طريق عودته من العمل إلى المنزل

42
00:03:56,540 --> 00:03:59,930
كانت مُكافأتي على عمل يوم شاقّ

43
00:04:00,590 --> 00:04:03,140
احتجتُها لإكمال يومي

44
00:04:04,800 --> 00:04:07,960
!إنّها مهمّة لمكافأة نفسك

45
00:04:07,960 --> 00:04:13,050
،قد لا تكون لدينا تلك الفطائر بعد الآن
!لكن لدينا بعض الأطعمة المُجمّدة

46
00:04:13,050 --> 00:04:15,420
ماذا قلتِ للتو؟

47
00:04:16,280 --> 00:04:18,440
أرغب في سماع المزيد عن ذلك

48
00:04:18,440 --> 00:04:19,910
!اتبعني

49
00:04:24,480 --> 00:04:25,920
مكافأة؟

50
00:04:26,640 --> 00:04:31,080
،كنتُ أركّز كثيراً على كلّ ما هو سلبيّ
لم أفكّر في الأمر من هذه النّاحية أبداً

51
00:04:34,390 --> 00:04:40,470
،حتّى لو كانت هناك أشياء لا أستطيع فعلها
ربّما ينبغي لي أن أحتفل بعملي الدّؤوب

52
00:04:44,590 --> 00:04:47,340
بودينغ

53
00:04:44,590 --> 00:04:47,340
جيلي الطّاقة الهائلة

54
00:04:44,590 --> 00:04:47,340
(غداء عشب بحري (معجون السّمك

55
00:04:47,350 --> 00:04:50,150
!وهذا بمناسبة يوم آخر من العمل الشاقّ

56
00:04:50,720 --> 00:04:53,680
!ماذا؟! شكراً

57
00:04:54,790 --> 00:04:56,980
!شكراً على الزّيارة

58
00:04:58,230 --> 00:05:00,090
!اشتريتُ بعض البودينغ

59
00:05:06,520 --> 00:05:09,720
!أنا مُجدٌّ في العمل! هنيئاً لي

60
00:05:11,410 --> 00:05:13,830
يوم آخر

61
00:05:21,120 --> 00:05:22,860
!مرحباً

62
00:05:27,680 --> 00:05:29,200
جديد

63
00:05:27,680 --> 00:05:29,640
ساكورا بودينغ

64
00:05:27,680 --> 00:05:29,640
بودينغ

65
00:05:27,680 --> 00:05:29,640
إكلير

66
00:05:27,680 --> 00:05:29,640
كعكة لفافة ساكورا

67
00:05:27,680 --> 00:05:29,640
جديد

68
00:05:31,090 --> 00:05:33,550
وصلتنا هذه للتو

69
00:05:34,110 --> 00:05:36,800
،نحن نُجري ترويجاً خاصّ بأزهار الكرز

70
00:05:36,800 --> 00:05:41,280
لهذا لدينا ساكورا موتشي، وكعكة لفافة
،ساكورا، وآيس كريم ساكورا، وساكورا لاتيه

71
00:05:41,640 --> 00:05:43,920
!وشاي بالحليب بنكهة ساكورا

72
00:05:47,570 --> 00:05:51,780
هـ-هل هذه لذيذة؟

73
00:05:52,210 --> 00:05:53,980
!أحبّها شخصيّاً

74
00:05:58,050 --> 00:05:59,370
أريد واحدة

75
00:05:59,370 --> 00:06:00,490
!حسناً

76
00:06:07,540 --> 00:06:09,860
هذا هو مذاق أزهار الكرز إذاً؟

77
00:06:34,950 --> 00:06:40,960
عطلة السيّد شرّير

78
00:06:45,960 --> 00:06:49,430
أكلات خفيفة ساخنة

79
00:06:45,960 --> 00:06:49,430
قهوة مخلوطة طازجة

80
00:06:45,960 --> 00:06:49,430
حشوات كُرة أرزّ
ستحبّها بكلّ تأكيد

81
00:06:49,420 --> 00:06:53,380
ماذا ينبغي أن تكون تحلية اليوم؟

82
00:06:58,570 --> 00:07:00,620
!أهلاً وسهلاً

83
00:07:01,870 --> 00:07:03,720
هذه أنتِ

84
00:07:03,720 --> 00:07:07,350
كنتُ أتساءل فقط ما إن كنتَ ستأتي اليوم

85
00:07:07,910 --> 00:07:11,240
إنّها تلك الموظّفة والسيّد قويّ

86
00:07:11,240 --> 00:07:13,830
يبدوان منسجمين حقّاً

87
00:07:14,350 --> 00:07:16,030
أتعلم؟

88
00:07:21,950 --> 00:07:25,430
!وصلتنا مُنتجات آيس كريم جديدة للتو

89
00:07:28,350 --> 00:07:30,810
أخبريني بالمزيد رجاء

90
00:07:37,220 --> 00:07:39,940
من الوقاحة التّحديق كثيراً

91
00:07:43,570 --> 00:07:46,370
هذه تشكيلتنا الجديدة

92
00:07:46,370 --> 00:07:48,900
!أنصح بهذا تحديداً

93
00:07:48,900 --> 00:07:52,530
!إنّه آيس كريم ناعم مليء بالفاكهة

94
00:07:52,530 --> 00:07:57,760
وانظر! لدينا نكهتان: فراولة أدزوكي
وكيناكو دبس سكّر بالموز

95
00:07:57,760 --> 00:08:00,360
،ليس مذاقها رائعاً فحسب

96
00:08:00,040 --> 00:08:04,710
دبس سكّر بالموز
آيس كريم ناعم كيناكو

97
00:08:00,360 --> 00:08:04,720
!لكن أعتقد أيضاً بأنّها وجبة دسمة

98
00:08:00,890 --> 00:08:04,710
آيس كريم ناعم بالفراولة والأدزوكي

99
00:08:05,070 --> 00:08:08,210
أجل، كلتاهما تبدوان شهيّتين

100
00:08:08,210 --> 00:08:10,370
جذبَتْ انتباهي بصراحة

101
00:08:10,750 --> 00:08:14,750
فراولة أدزوكي وكيناكو
وكيناكو دبس سكّر بالموز؟

102
00:08:14,840 --> 00:08:17,970
دبس سكّر بالموز
آيس كريم ناعم كيناكو

103
00:08:14,840 --> 00:08:17,970
آيس كريم ناعم بالفراولة والأدزوكي

104
00:08:15,350 --> 00:08:17,350
...إذا ترتّب عليّ الاختيار، فسوف أختار

105
00:08:18,190 --> 00:08:20,420
كيناكو دبس سكّر بالموز

106
00:08:18,190 --> 00:08:20,420
!فراولة أدزوكي

107
00:08:20,420 --> 00:08:22,680
!كلاهما على خِلاف

108
00:08:26,950 --> 00:08:29,390
!ها أنا ذي من جديد

109
00:08:29,390 --> 00:08:30,840
!أ-أنا آسفة

110
00:08:30,840 --> 00:08:34,640
،كنتُ متيقّنة بأنّك ستفضّل الفراولة
!وهذا ما جعلني لا أتوقّف

111
00:08:35,010 --> 00:08:38,420
ماذا سنفعل إذا غضب السيّدُ قويّ؟

112
00:08:39,490 --> 00:08:40,400
لا تقلقي

113
00:08:40,670 --> 00:08:44,130
توصياتكِ دائماً مبنيّة على المال

114
00:08:44,130 --> 00:08:48,120
لِمَ لا أشتريهما معاً وأجري اختبار تذوُّق؟

115
00:08:48,380 --> 00:08:50,140
!مذهل

116
00:08:50,140 --> 00:08:53,700
!أ-أنا آسفة! لم أقصد دفعك لشراء المُنتجين

117
00:08:53,700 --> 00:08:54,840
لا عليكِ

118
00:08:54,840 --> 00:08:58,680
قد لا أتمكّن من العودة لشراء الأخرى

119
00:08:59,100 --> 00:09:00,650
احسبي لي الفاتورة

120
00:09:00,650 --> 00:09:02,060
!حـ-حاضرة

121
00:09:13,020 --> 00:09:15,260
،لتحلية اليوم

122
00:09:15,260 --> 00:09:18,030
ربّما سأشتري بعضاً من هذا
الآيس كريم أيضاً

123
00:09:18,740 --> 00:09:22,790
والآن، فراولة أدزوكي أم كيناكو
دبس سكّر بالموز؟

124
00:09:26,470 --> 00:09:28,450
!شكراً جزيلاً لك

125
00:09:32,020 --> 00:09:33,690
!بالتّوفيق

126
00:09:35,220 --> 00:09:36,640
!عرفت

127
00:09:36,630 --> 00:09:38,890
آيس كريم ناعم بالفراولة والأدزوكي

128
00:09:36,630 --> 00:09:38,890
دبس سكّر بالموز
آيس كريم ناعم كيناكو

129
00:09:39,860 --> 00:09:41,590
!شكراً جزيلاً لك

130
00:09:41,590 --> 00:09:42,370
!العفو

131
00:09:49,120 --> 00:09:52,600
حسناً إذاً، ماذا ينبغي أن أجرّب أوّلاً؟

132
00:09:52,880 --> 00:09:55,500
غداً هو أوّل يوم عطلة لي منذ مدّة

133
00:09:55,500 --> 00:09:58,150
سيكون هناك ما يكفي من وقت للتردُّد

134
00:10:00,890 --> 00:10:10,480
أنا ضابطٌ رفيع المستوى من مُنظّمة
الشرّ الّتي تسعى يوميّاً لإبادة البشريّة

135
00:10:10,480 --> 00:10:16,530
والسّيطرة على الأرض باسم كوكبنا الأمّ

136
00:10:16,530 --> 00:10:19,740
لكن اليوم هو يوم عطلتي

137
00:10:21,130 --> 00:10:27,110
سأزور مكاناً يُدعى مقهى بحثاً
"عن شيء يُدعى "فنّ اللّاتيه

138
00:10:32,880 --> 00:10:34,230
مرحباً

139
00:10:44,770 --> 00:10:46,940
ما هذا؟

140
00:10:46,940 --> 00:10:49,530
آلة تجارب ما؟

141
00:10:49,900 --> 00:10:51,370
ما طلبك؟

142
00:10:51,370 --> 00:10:53,080
واحدة من هذه

143
00:10:53,080 --> 00:10:54,730
على الفور

144
00:10:59,920 --> 00:11:02,260
ما الّذي سيفعله؟

145
00:11:10,250 --> 00:11:12,480
!ما-ما هذا؟

146
00:11:12,480 --> 00:11:14,260
صانعة قهوة بطريقة الشّفط

147
00:11:14,260 --> 00:11:17,890
،القهوة بطريقة التدفُّق العلويّ جيّدة أيضاً
لكن مقهانا يتّبع تلك الطّريقة

148
00:11:22,280 --> 00:11:23,890
شكراً على الانتظار

149
00:11:26,770 --> 00:11:31,460
...إذاً هناك أكثر من طريقة لصنع القهوة

150
00:11:34,170 --> 00:11:36,060
ماذا الآن؟

151
00:11:36,370 --> 00:11:38,420
!ما هذا الصّوت؟

152
00:11:38,420 --> 00:11:41,660
ماذا يفعل ذلك الشّخص؟

153
00:11:41,660 --> 00:11:46,000
عليه أن يصدر كلّ هذا الضجيج
فقط لصنع قهوة؟

154
00:11:49,310 --> 00:11:51,090
شكراً على الانتظار

155
00:11:52,680 --> 00:11:54,510
استغرق وقتك واستمتع

156
00:12:03,220 --> 00:12:07,040
هذا ساحرٌ حقّاً كما ذكرت الإشاعات

157
00:12:15,340 --> 00:12:18,860
كيف يشرب المرء شيئاً كهذا؟

158
00:12:34,130 --> 00:12:37,630
ما-ما معنى هذا؟

159
00:12:39,100 --> 00:12:43,750
!كلّما شربتُ أكثر، تبدّد الباندا أكثر

160
00:12:49,860 --> 00:12:51,570
...فنّ اللّاتيه

161
00:12:51,570 --> 00:12:54,460
!يا له من شراب عديم الرّحمة

162
00:12:57,260 --> 00:12:58,440
لا تقلق

163
00:13:00,530 --> 00:13:03,290
هذا هو قدرُنا

164
00:13:30,870 --> 00:13:34,150
!يا أيُّها الباندا

165
00:13:48,980 --> 00:13:50,140
يا صانع القهوة

166
00:13:50,610 --> 00:13:54,070
لاتيه باندا أخرى لهذا الزّبون هنا

167
00:13:54,400 --> 00:13:55,500
حسناً

168
00:14:11,560 --> 00:14:16,840
انفعلتُ زيادة عن اللّزوم بشأن تلك اللّاتيه
باندا فاشتريتُ الكثير

169
00:14:17,370 --> 00:14:20,240
هذا ثقيلٌ جدّاً لدرجة أنّ كتفي سينخلع

170
00:14:20,710 --> 00:14:23,520
...فأساساً، أنا أحمل

171
00:14:29,160 --> 00:14:37,260
مقدار هائل من الحليب لصنع اليخنة
!والبودينغ وجيلي باللّوز

172
00:14:38,600 --> 00:14:42,890
اليخنة بالطّبع لذيذة بحدِّ ذاتها

173
00:14:42,890 --> 00:14:46,810
...لكن غراتان مع الأرزّ وباستا وأرزّ بالعجّة

174
00:14:47,630 --> 00:14:51,110
يمكن استخدامها في تشكيلة
واسعة من المطاعم

175
00:14:51,470 --> 00:14:55,530
ابتداء من الأسبوع المقبل، عليّ أن أعمل
لعدد من الأيّام على التّوالي

176
00:14:55,530 --> 00:14:58,580
سيكون من الجدير طبخ بعض الوجبات سلفاً

177
00:14:59,160 --> 00:15:05,550
،حالما أُنجِز البودينغ وجيلي اللّوز
سأزيّنهما بالباندا

178
00:15:05,810 --> 00:15:10,450
خطرتْ على ذهني الفكرة بينما
كنتُ أشرب لاتيه الباندا ذاك

179
00:15:11,020 --> 00:15:14,270
اليوم، سوف أشرع في تجربة

180
00:15:14,720 --> 00:15:20,390
أتوقّع درجة من الفشل، لذا اشتريتُ حليباً إضافيّاً

181
00:15:20,780 --> 00:15:24,360
،ومن أجل تنسيق كلّ هذا الطّعام

182
00:15:24,360 --> 00:15:29,000
سأستخدم أواني الباندا الّتي
!صادفتُها بالحظّ المُطلَق

183
00:15:56,070 --> 00:15:59,980
،تمكّنتُ من العودة إلى بنائي

184
00:16:00,500 --> 00:16:03,210
...مع ذلك بقيت عقبة أخيرة

185
00:16:03,620 --> 00:16:05,350
!السّلالم

186
00:16:07,730 --> 00:16:12,310
!لِمَ لا تشيّدون مِصعداً يا سكّان الأرض؟

187
00:16:12,980 --> 00:16:14,380
...بغضّ النّظر

188
00:16:16,920 --> 00:16:20,950
!لن أنهزم هنا

189
00:16:25,300 --> 00:16:27,870
،مع كلّ خطوة أتّخذها هنا

190
00:16:28,310 --> 00:16:33,410
!هذه الحقائب تعضُّ كتِفَي ويدَي

191
00:16:34,450 --> 00:16:36,680
!يا لها من ضريبة مُرهِقة روحيّاً

192
00:16:37,420 --> 00:16:40,330
أصابعي على وشك أن تتمزّق

193
00:16:41,240 --> 00:16:44,610
،حالما أبلغ قمّة هذه السّلالم

194
00:16:45,250 --> 00:16:48,580
،سوف أبدأ بصنع اليخنة

195
00:16:49,740 --> 00:16:52,830
!وسأسكبها في وعاء الباندا الخاصّ بي

196
00:16:53,460 --> 00:16:54,890
اصمدوا

197
00:16:55,200 --> 00:16:57,080
!لا تستسلموا

198
00:16:57,530 --> 00:17:01,170
!أتسمعونني يا ساقايّ وكتِفايّ

199
00:17:01,170 --> 00:17:05,880
!إنّي أراها الآن... نهاية رحلتي الطّويلة

200
00:17:34,060 --> 00:17:37,340
مرحباً

201
00:17:39,990 --> 00:17:46,000
عطلة السيّد شرّير

202
00:17:48,950 --> 00:18:00,330
أنا ضابطٌ رفيع المستوى من مُنظّمة
الشرّ الّتي تسعى يوميّاً لإبادة البشريّة

203
00:18:00,330 --> 00:18:07,490
والسّيطرة على الأرض باسم كوكبنا الأمّ

204
00:18:08,930 --> 00:18:14,120
أتيتُ لرؤية أزهار الكرز مثلما
...يحبّ سكّانُ الأرض أن يفعلوا

205
00:18:14,890 --> 00:18:19,030
لكن كانت الزّهور قد تساقطت بالفعل

206
00:18:21,260 --> 00:18:25,540
وحتّى أنّني تكبّدتُ عناء حزم
غداء من أجل هذا

207
00:18:26,140 --> 00:18:29,780
إنّ مشاهدة أزهار الكرز لا تكون كاملة
إلّا بإحضار غداء تنزُّه، أليس كذلك؟

208
00:19:28,310 --> 00:19:35,520
مضغ
مضغ
مضغ
مضغ

209
00:19:28,610 --> 00:19:34,630
ألم تعلّمكِ عائلتكِ ألّا تقبلي
طعاماً من الغرباء؟

210
00:19:38,330 --> 00:19:40,700
هل كنتِ جائعة إلى هذه الدّرجة؟

211
00:19:42,540 --> 00:19:44,540
يا له من كوكب

212
00:19:45,330 --> 00:19:49,580
لكن لا تقلقي. سوف أبيد البشريّة بكلِّ تأكيد

213
00:19:49,990 --> 00:19:51,570
مرّة أخرى؟

214
00:19:51,570 --> 00:19:53,590
كُلي ما تشائين

215
00:19:55,430 --> 00:19:57,970
هل أتيت لمشاهدة الزّهور يا سيّد؟

216
00:19:58,660 --> 00:19:59,590
أجل

217
00:20:00,700 --> 00:20:02,780
لكن يبدو أنّني تأخّرتُ كثيراً

218
00:20:05,610 --> 00:20:07,400
احرصي على المضغ جيّداً

219
00:20:08,310 --> 00:20:10,180
سوف أريك إيّاها

220
00:20:23,730 --> 00:20:30,910
بخلاف نباتات كوكبي والّتي تحتفظ
،بزهورها حتّى تذبل

221
00:20:30,910 --> 00:20:37,040
شجرة أزهار الكرز هذه تفرِّق بتلاتها
بعد فترة قصيرة من تفتّحها

222
00:20:37,830 --> 00:20:43,600
البشر يعتبرون هذا المشهد جميلاً

223
00:21:05,410 --> 00:21:09,750
فهمتُ الآن. مظهرها وهي تتساقط جميلٌ حقّاً

224
00:21:19,410 --> 00:21:20,920
هل عادَتْ إلى المنزل؟

225
00:21:22,130 --> 00:21:26,510
،بعد ذلك، عدتُ مرّات عديدة مع غداء مُعلَّب

226
00:21:27,300 --> 00:21:30,230
لكن لم ألتقِ بتلك الطّفلة

227
00:21:36,710 --> 00:21:43,020
ربّما سأذهب من جديد في العام المقبل
عندما تتفتّح الزّهور

228
00:23:20,000 --> 00:23:20,790
عطلة السيّد شرّير

229
00:23:22,250 --> 00:23:26,190
ما الّذي ترتدينه قبل الذّهاب للقتال؟

230
00:23:27,250 --> 00:23:31,180
،حتّى عندما يخلع الزيّ الرّسميّ
لا يمكنها أن تكون صادقة مع نفسها

231
00:23:32,270 --> 00:23:38,140
قلب خفّاق، يستحيل إخفاؤه
...في وسط لون الطّبيعة

232
00:23:38,920 --> 00:23:43,700
...كانت تعلو وجهها المكشوف بسمة مُزيّفة

233
00:23:44,230 --> 00:23:47,200
تلك الفتاة السّحريّة في ضيق

234
00:23:48,320 --> 00:23:49,940
فتاة سحريّة في ضيق