1
00:00:00,270 --> 00:00:05,460
،فوق المحيط الّذي لا محيط له
.جلس ذات يوم شخص حالم

2
00:00:05,460 --> 00:00:10,470
.حلُم الحالم بكلّ الأشياء في العالم

3
00:00:10,890 --> 00:00:12,700
،يوما بعد يوم

4
00:00:12,700 --> 00:00:17,850
،دون فعل أيّ شيء سوى الحلم
.تحوّل الحالم إلى حجر في النّهاية

5
00:00:18,280 --> 00:00:22,240
أصبح ذلك الحجر المعروف
بحجر النّجوم الخرافيّ أكبر وأكبر

6
00:00:22,240 --> 00:00:25,480
.وتحوّل في النّهاية إلى بيضة

7
00:00:26,010 --> 00:00:31,370
بيضة تطفو وحيدة فوق المحيط
.الّذي بلا محيط بعد

8
00:01:59,220 --> 00:02:02,100
خرافة العواطف
— أكويريون —

9
00:02:12,210 --> 00:02:15,310
.بصراحة، كانت إيتشيكي-سان فتاة غريبة

10
00:02:16,000 --> 00:02:17,790
ألم تكونوا تضايقونها دائمًا؟

11
00:02:17,790 --> 00:02:19,620
!لا تقل ذلك

12
00:02:36,000 --> 00:02:38,090
ماذا؟ قتلت سايو نفسها؟

13
00:02:38,660 --> 00:02:40,030
.لا، لم تقتل نفسها

14
00:02:40,030 --> 00:02:43,740
"فلقد كانت تقول "لا أريد الموت
.قبل حدوث ذلك

15
00:02:46,310 --> 00:02:47,930
من أين سمعت ذلك؟

16
00:02:48,380 --> 00:02:50,200
.لقد نسيت

17
00:02:56,600 --> 00:02:59,200
هل كان لسايو أصدقاء على أيّ حال؟

18
00:02:59,680 --> 00:03:00,720
.لا أدري

19
00:03:05,720 --> 00:03:08,710
.كانت تحدّق في السّماء دائمًا

20
00:03:08,710 --> 00:03:11,050
أيّها الفتى! ما الّذي تفعله في رأيك؟

21
00:03:11,620 --> 00:03:14,380
يا إلهي، أوتوري ثانية؟

22
00:03:15,100 --> 00:03:16,800
لماذا يرتدي تلك الملابس؟

23
00:03:31,140 --> 00:03:33,320
!توقّف مكانك يا فتى

24
00:03:33,320 --> 00:03:36,030
أوتوري ساكّو؟ تقوم بهذا ثانية؟

25
00:03:36,030 --> 00:03:37,200
...تاكِتشي-سنسي

26
00:03:37,460 --> 00:03:38,600
.ساكّو

27
00:03:38,940 --> 00:03:39,900
.مرحبًا

28
00:04:08,560 --> 00:04:32,130
مدرسة خاصّة مصمّمة خصّيصًا
أكاديميّة إينوشيما

29
00:04:10,750 --> 00:04:16,280
في العصور القديمة، استجمع البشر
.شجاعتهم ودخلوا غمار البحر المفتوح

30
00:04:13,860 --> 00:04:16,820
.دخل البشر غمار البحر

31
00:04:16,280 --> 00:04:19,780
.واليوم، نضع الفضاء صوب أعيننا

32
00:04:17,400 --> 00:04:21,530
.ثمّ إلى الفضاء

33
00:04:22,520 --> 00:04:28,000
مدرسة خاصّة مصمّمة خصّيصًا من قبل وكالة
.الحفاظ على الفضاء، أكاديميّة إينوشيما

34
00:04:22,870 --> 00:04:32,130
نقبل الاستفسارات عبر الهاتف والإنترنيت

35
00:04:22,870 --> 00:04:32,130
نقبل بالطّلبات الآن

36
00:04:22,870 --> 00:04:32,130
أكاديميّة إينوشيما                  بحث

37
00:04:32,130 --> 00:04:36,880
.اليوم، حتّى أنتم يمكن أن تصيروا أساطير

38
00:04:32,130 --> 00:04:36,880
نقبل الاستفسارات عبر الهاتف والإنترنيت

39
00:04:32,130 --> 00:04:36,880
نقبل بالطّلبات الآن

40
00:04:32,130 --> 00:04:36,880
أكاديميّة إينوشيما

41
00:04:32,130 --> 00:04:36,880
بحث

42
00:04:33,160 --> 00:04:36,310
.اليوم، حتّى أنتم يمكن أن تصيروا أساطير

43
00:04:36,880 --> 00:04:38,000
وكالة الحفاظ على الفضاء

44
00:04:42,730 --> 00:04:47,730
سوف يهلك كوننا الثّالث عشر
.نتيجة لحماقة البشريّة نفسها

45
00:04:48,130 --> 00:04:52,090
.حرائق متكرّرة وأوبئة وحروب

46
00:04:52,090 --> 00:04:56,660
!كلّ واحدة من هذه جزء من خطّتهم

47
00:04:56,940 --> 00:04:59,190
يوم الحساب وشيك

48
00:04:56,940 --> 00:04:59,190
أوقفوا مشروع إبادة
الكون الثّالث عشر

49
00:04:56,940 --> 00:04:59,190
حرائق مدمّرة

50
00:04:56,940 --> 00:04:59,190
أوبئة

51
00:04:56,940 --> 00:04:59,190
جميعها مكائد

52
00:04:56,940 --> 00:04:59,190
من طرف حكومة العالم

53
00:05:08,250 --> 00:05:11,430
والآن، صرتم تفهمون أنّه في الألعاب
،ذات الطّابع الاستراتيجيّ

54
00:05:11,430 --> 00:05:15,250
عندما يختار جميع اللاّعبين استراتيجيّة
،تزيد من مكاسبهم

55
00:05:15,250 --> 00:05:18,340
.فإنّهم يبلغون ما يسمّى بتوازن ناش

56
00:05:16,250 --> 00:05:22,880
الفريق الأزرق

57
00:05:16,250 --> 00:05:25,010
الفريق الأصفر

58
00:05:16,250 --> 00:05:25,010
أعلى نتيجة

59
00:05:16,250 --> 00:05:25,010
الفريق الأحمر

60
00:05:16,250 --> 00:05:25,010
الضّرر

61
00:05:20,080 --> 00:05:22,330
،في ذلك الوضع
،إن غيّر أيّ لاعب استراتيجيّته

62
00:05:22,330 --> 00:05:26,470
فإنّ مكاسبه من تلك الاستراتيجيّة
.ستصير أقلّ ممّا كانت قبل التّغيير

63
00:05:22,840 --> 00:05:24,930
تجاوزت الحدود تمامًا يا أوتوري ساكّو

64
00:05:25,010 --> 00:05:27,100
ارتدِ زيّك في الجنائز على الأقلّ

65
00:05:27,100 --> 00:05:28,970
لكنّي وجدتُ ذلك رائعًا نوعًا ما

66
00:05:27,170 --> 00:05:30,530
بتعبير آخر، ذلك يعني
.أنّ هذا هو الحلّ الأمثل

67
00:05:28,970 --> 00:05:30,980
أنا أيضًا

68
00:05:29,390 --> 00:05:30,980
لماذا تتواجد زهور القرنفل دائمًا في الجنائز؟

69
00:05:30,970 --> 00:05:31,140
الضّرر

70
00:05:30,970 --> 00:05:35,180
الفريق الأزرق

71
00:05:30,970 --> 00:05:40,310
الفريق الأصفر

72
00:05:30,970 --> 00:05:40,310
أعلى نتيجة

73
00:05:30,970 --> 00:05:40,310
الفريق الأحمر

74
00:05:31,140 --> 00:05:33,310
هل كان أوتوري يعرف إيتشيكي؟
إنّهما من فصلين مختلفين

75
00:05:31,270 --> 00:05:33,310
مررنا على الاختلاف بين توازن ناش

76
00:05:33,060 --> 00:05:35,310
كانا زميلين منذ المدرسة الابتدائيّة

77
00:05:33,310 --> 00:05:34,780
...وأمثليّة باريتو في آخر مرّة

78
00:05:33,310 --> 00:05:40,310
الضّرر

79
00:05:35,150 --> 00:05:37,480
مهلاً، إذًا فقد كانا في فصل الكشّافة؟

80
00:05:37,360 --> 00:05:40,320
كانت موموهيمي-ساما من السّنة الثّالثة هناك أيضًا؟
سمعتُ أنّ ثلاثتهم كانوا أصدقاء

81
00:05:37,480 --> 00:05:40,310
الفريق الأزرق

82
00:05:40,330 --> 00:05:44,250
فعلاً؟ كلّ من موموهيمي-ساما
وإيتشيكي كانتا من الكشّافة؟

83
00:05:44,250 --> 00:05:47,900
،تبًّا. لو قضيتُ الوقت مع إيتشيكي
.فربّما كانت لتعرّفني عليها

84
00:05:47,900 --> 00:05:50,830
.غبيّ. لكانت رفضتك في لمح البصر

85
00:05:50,830 --> 00:05:54,800
لحظة يا ريميا-كُن، ألم تكن
تبكي في جنازة إيتشيكي البارحة؟

86
00:05:54,800 --> 00:05:56,250
.ماذا؟ نعم

87
00:05:56,250 --> 00:05:58,620
هل كنتما مقرّبين من بعض لتلك الدّرجة؟

88
00:06:00,600 --> 00:06:01,990
.لم أتحدّث معها من قبل

89
00:06:03,890 --> 00:06:07,120
ألا يبكي معظم النّاس عندما
يموت زميل لهم في الفصل؟

90
00:06:07,830 --> 00:06:10,840
إنّه محقّ. ألديكم قلوب من حجر؟

91
00:06:10,840 --> 00:06:13,720
.ريميا-كُن لا يشبهكم. إنّه طيّب القلب

92
00:06:13,720 --> 00:06:16,430
.ماذا؟ أنتنّ أيضًا لم تعرفنها جيّدًا

93
00:06:16,430 --> 00:06:18,180
.لكن بإمكان أيّ أحد البكاء إن أراد ذلك

94
00:06:18,640 --> 00:06:19,280
.توشي

95
00:06:20,140 --> 00:06:20,780
.لنذهب

96
00:06:20,780 --> 00:06:22,010
.حسنًا

97
00:06:35,340 --> 00:06:36,550
أسمعت يا مومو؟

98
00:06:36,550 --> 00:06:39,530
يوشكون على الإعلان عن الاختيارات
!الأولى للفصل المتقدّم

99
00:06:39,530 --> 00:06:41,470
فصل العناصر؟

100
00:06:41,470 --> 00:06:43,200
مثل أطفال الابتدائيّة؟

101
00:06:43,200 --> 00:06:45,040
."لا، بل ذلك هو "السّلك الابتدائيّ

102
00:06:45,040 --> 00:06:48,320
إنّهم يختارون تلاميذ من السّنة
.الثّالثة لتشكيل فصل جديد

103
00:06:48,320 --> 00:06:49,390
.لا أفهم

104
00:06:49,390 --> 00:06:52,730
مدرستنا جنونيّة، صحيح؟
.حتّى الفصول غريبة أيضًا

105
00:06:52,730 --> 00:06:55,460
هذا لأنّها مدرسة مصمّمة خصّيصًا
.لوكالة الحفاظ على الفضاء

106
00:06:55,940 --> 00:06:56,860
أسمعتما؟

107
00:06:56,860 --> 00:07:00,830
تملك وكالة الحفاظ على الفضاء
!قاعدة سرّيّة تحت الأرض في إينوشيما

108
00:07:00,830 --> 00:07:02,800
.مستحيل، تلك مجرّد إشاعات

109
00:07:02,800 --> 00:07:04,730
!كلاّ! بل هي حقيقة

110
00:07:04,730 --> 00:07:07,640
،وأراهن أنّه إن اُختير تلميذ كأحد العناصر
فسيتمّ توجيهه إلى تدريب خاصّ

111
00:07:07,640 --> 00:07:10,830
!وسيصل إلى مكانة النّخبة سريعًا
ما رأيك يا مومو؟

112
00:07:10,830 --> 00:07:12,440
.لستُ مهتمّة كثيرًا

113
00:07:17,170 --> 00:07:20,400
ألم تحضر إيتشيكي-سان
إلى المكتبة كثيرًا أيضًا؟

114
00:07:20,400 --> 00:07:22,670
.تحدّثتُ معها لمرّة فحسب

115
00:07:22,670 --> 00:07:23,760
عمّ تحدّثتما؟

116
00:07:24,110 --> 00:07:27,830
.أنا لا... لا أتذكّر

117
00:07:27,830 --> 00:07:29,790
.لم أكن مهتمًّا

118
00:07:29,790 --> 00:07:31,690
.كان حديثًا عن الحيوات السّابقة وما شابه

119
00:07:32,140 --> 00:07:32,940
الحيوات السّابقة؟

120
00:07:32,940 --> 00:07:34,050
.نعم

121
00:07:34,050 --> 00:07:39,980
مثل لقاء بعضنا في حياة سابقة
.وامتلاكنا لأجنحة على ظهورنا

122
00:07:39,980 --> 00:07:42,400
.أتساءل إن كان من أسطورة ما

123
00:07:42,730 --> 00:07:46,640
.اسمع، اعتادت قراءة تلك الكتب هناك

124
00:07:46,980 --> 00:07:49,790
مهلاً يا أوتوري! ما الّذي تفعله هنا؟

125
00:07:50,230 --> 00:07:51,830
.هذا مؤلم

126
00:07:51,830 --> 00:07:52,790
!صه

127
00:07:52,180 --> 00:07:54,110
أين ذهبت يا أوتوري؟

128
00:07:54,110 --> 00:07:56,650
!أخبرتك أنّ الباركور غير مسموح به في المدرسة

129
00:07:56,650 --> 00:07:59,080
!ليس في المدرسة فقط، بل المدينة بأكملها

130
00:07:59,080 --> 00:08:01,790
!يا إلهي، أنا من سيتمّ توبيخه

131
00:08:03,250 --> 00:08:04,280
.شكرًا لكما

132
00:08:04,280 --> 00:08:06,580
أنت أوتوري-كُن من الفصل 2، صحيح؟

133
00:08:06,580 --> 00:08:08,740
.نعم. بإمكانك مناداتي ساكّو

134
00:08:09,030 --> 00:08:11,360
...أنتما من الفصل 1؟ ريميا-كُن و

135
00:08:11,880 --> 00:08:13,170
.لا أعرف اسمك

136
00:08:13,170 --> 00:08:15,720
هاتانو توشي. هل الباركور ممتع؟

137
00:08:15,980 --> 00:08:16,970
.على الإطلاق

138
00:08:17,690 --> 00:08:18,530
.إلى اللّقاء

139
00:08:18,820 --> 00:08:20,380
.مهلاً، انتظر

140
00:08:20,380 --> 00:08:21,420
ماذا؟

141
00:08:21,420 --> 00:08:23,570
.حدّقتَ بي البارحة

142
00:08:23,570 --> 00:08:25,610
...ماذا؟ صحيح

143
00:08:26,010 --> 00:08:27,540
هل فعلتُ شيئًا ما لك؟

144
00:08:28,660 --> 00:08:31,260
ريميا-كُن، ليس لديك قلب، صحيح؟

145
00:08:32,270 --> 00:08:35,760
.أراك أحيانًا لأنّ لديك شعبيّة كبيرة

146
00:08:35,760 --> 00:08:37,090
.مثل هذه الأمور واضحة لي

147
00:08:37,490 --> 00:08:38,450
...إنّ ذلك

148
00:08:38,450 --> 00:08:41,070
.لكنّي لا أهتمّ. أنا مثلك

149
00:08:41,540 --> 00:08:45,040
.ولكن البارحة، أغضبني ذلك نوعًا ما

150
00:08:46,360 --> 00:08:49,490
.كان هو وإيتشيكي-سان في الابتدائيّة معًا

151
00:08:49,870 --> 00:08:50,750
.نعم

152
00:08:52,250 --> 00:08:55,900
.لم تعتني بنفسها أبدًا

153
00:08:56,800 --> 00:08:59,220
.كانت تُعطي الأولويّة للآخرين دائمًا

154
00:08:59,220 --> 00:09:01,230
.وتأذّت كثيرًا بسبب ذلك

155
00:09:01,930 --> 00:09:04,260
.كانت مخاطر ذلك كثيرة، لم أتحمّل المشاهدة

156
00:09:04,260 --> 00:09:05,890
.كنت أنت المحفوف بالمخاطر يا ساكّو

157
00:09:08,870 --> 00:09:13,380
ساكّو، واصلت التّورّط في أمور
.خطيرة وواصلتُ إيقافك

158
00:09:13,380 --> 00:09:16,020
سايو... ما الّذي تفعلينه هنا؟

159
00:09:16,680 --> 00:09:18,680
،إن كنّا سنقاتل مخلوقات خرافيّة

160
00:09:18,680 --> 00:09:21,030
.فكّرتُ أنّه عليّ الدّراسة أكثر عن الخرافات

161
00:09:21,030 --> 00:09:22,510
مخلوقات خرافيّة؟

162
00:09:22,510 --> 00:09:26,310
.يا رفاق، لنبذل جهدنا في فصل العناصر

163
00:09:26,310 --> 00:09:28,430
العناصر؟ هل أنت...؟

164
00:09:28,430 --> 00:09:30,420
!وجدتُك يا أوتوري

165
00:09:30,850 --> 00:09:34,430
،إيّاك أن تتحرّك ولو شبرًا واحدًا
!أنا قادم إليك

166
00:09:36,100 --> 00:09:39,410
.ها أنتم هناك. ستفزعون عند سماع هذا

167
00:09:41,580 --> 00:09:44,700
إذًا فقد أعلنوا عن أعضاء فصل العناصر؟

168
00:09:44,700 --> 00:09:46,110
مستحيل. ثلاثة أشخاص فقط؟

169
00:09:46,110 --> 00:09:47,910
.لكن قد يضيفون المزيد لاحقًا

170
00:09:47,910 --> 00:09:50,490
،أفهم لِمَ اختاروا ريميا-كُن
ولكن ماذا عن أوتوري ساكّو؟

171
00:09:50,490 --> 00:09:53,950
هل هاتانو هو مهووس الكتب ذاك؟
.لكنّه يحصل دائمًا على درجات سيّئة

172
00:09:54,260 --> 00:09:57,570
.كنتُ واثقة أنّه سيتمّ اختيارك يا موموهيمي

173
00:09:58,190 --> 00:10:01,190
.لكن أشعر أنّه كان هنالك واحد آخر

174
00:10:01,190 --> 00:10:02,050
ماذا؟

175
00:10:13,600 --> 00:10:15,020
.إنّهم قادمون

176
00:10:24,590 --> 00:10:27,350
.اسمي موناكاتا وسأترأّس فصل العناصر

177
00:10:27,350 --> 00:10:30,600
ستتّبعون ابتداءً من اليوم
منهجًا دراسيًّا خاصًّا

178
00:10:30,600 --> 00:10:33,910
مصمّم لمساعدتكم على تطوير
.قدراتكم كعناصر

179
00:10:33,910 --> 00:10:36,890
سيكون من الصّعب تدبّر هذا
،إضافة إلى فصولكم العاديّة

180
00:10:36,890 --> 00:10:38,020
.لذلك آمل أن تكونوا مستعدّين

181
00:10:38,020 --> 00:10:39,960
ألا تراها المعلّمة؟

182
00:10:39,960 --> 00:10:45,620
إنّ أوّل شيء أحتاج منكم لفهمه
.هو أنّ هذا البرنامج سرّيّ للغاية

183
00:10:45,620 --> 00:10:49,130
لا يمكنكم حتّى إخبار آبائكم
.أو إخوتكم عن تدريبكم هنا

184
00:10:49,130 --> 00:10:50,040
مفهوم؟

185
00:10:50,270 --> 00:10:51,200
.نعم

186
00:10:51,460 --> 00:10:52,500
ما جوابكم؟

187
00:10:52,800 --> 00:10:53,870
!نعم

188
00:11:01,020 --> 00:11:04,790
أودّ منكم الآن أن تقاتلوا جنود عدوّ
،أو مخلوقات خرافيّة

189
00:11:04,790 --> 00:11:06,560
.في مُحاكي المعارك هذا

190
00:11:06,560 --> 00:11:07,950
مخلوقات خرافيّة؟

191
00:11:08,300 --> 00:11:11,720
سينسي، لماذا وصفتِ الأعداء
بمخلوقات خرافيّة؟

192
00:11:11,720 --> 00:11:13,920
.إنّه سؤال جيّد يا إيتشيكي-سان

193
00:11:13,920 --> 00:11:15,000
.إذًا فهي تراها بالفعل

194
00:11:15,000 --> 00:11:15,620
.نعم

195
00:11:15,620 --> 00:11:18,440
نصفها بالمخلوقات الخرافيّة
.لأنّها تأتي من الفضاء الخرافيّ

196
00:11:18,920 --> 00:11:20,960
.ادخلوا الآلات الآن

197
00:11:20,960 --> 00:11:22,130
...عفوًا

198
00:11:21,620 --> 00:11:22,700
...لحظة

199
00:11:23,540 --> 00:11:24,800
!أسرعوا

200
00:11:43,500 --> 00:11:45,460
.إذًا فهذا مخلوق خرافيّ

201
00:11:45,460 --> 00:11:47,360
!حظًّا سعيدًا يا رفاق

202
00:11:50,080 --> 00:11:51,510
!لا تخافوا

203
00:11:51,940 --> 00:11:53,310
!كلاّ يا ساكّو

204
00:11:54,130 --> 00:11:55,520
!لا داعي للتّهوّر

205
00:11:55,520 --> 00:11:59,730
إنّ آلات المتّجهات تعزّز طاقتكم العاطفيّة
.والمانا خاصّتكم، وتستعملها كقوّة

206
00:11:59,730 --> 00:12:02,970
مصدر تلك المانا هو رغبتكم
.القويّة لهزيمة العدوّ

207
00:12:02,970 --> 00:12:06,130
مانا؟ لا أستطيع مجاراة
!كلّ هذه الأشياء المعقّدة

208
00:12:06,130 --> 00:12:07,530
!علينا القيام بهذا فحسب

209
00:12:07,530 --> 00:12:08,360
!حسنًا

210
00:12:18,460 --> 00:12:22,710
إذًا فقد كان ذلك أحد المخلوقات الخرافيّة
.الّتي تحدّثت عنها إيتشيكي-سان

211
00:12:22,710 --> 00:12:26,900
لكن كيف عرفتْ بشأنها قبل
أن تُختار كواحدة من العناصر؟

212
00:12:26,900 --> 00:12:30,390
.وبمجرّد انتهاء فصل العناصر، اختفت

213
00:12:30,390 --> 00:12:34,070
.لا بدّ أنّها اُختيرت قبلنا

214
00:12:34,070 --> 00:12:35,620
،ولسبب ما

215
00:12:35,620 --> 00:12:39,590
جعل المعلّمون الأمر يبدو كأنّها
.ماتت لتستطيع أن تبدأ التّدريب

216
00:12:40,000 --> 00:12:42,490
.هكذا إذًا، أراهن أنّك على حقّ

217
00:12:45,550 --> 00:12:48,350
لماذا نحن في رأيكما؟

218
00:12:48,850 --> 00:12:49,650
ماذا؟

219
00:12:50,800 --> 00:12:52,890
لماذا تمّ اختيارنا في رأيكما؟

220
00:12:53,310 --> 00:12:56,030
.إنّه بسبب ما لا تملكونه. القلب

221
00:12:56,700 --> 00:12:58,100
من أين ظهرتِ؟

222
00:13:01,080 --> 00:13:04,880
.لقد انتُزع منكم مع أجنحتكم في تلك المرّة

223
00:13:04,880 --> 00:13:06,350
في تلك المرّة؟

224
00:13:06,830 --> 00:13:09,130
.قبل 12 ألف سنة

225
00:13:09,130 --> 00:13:12,120
عفوًا، خلال فترة جومون؟

226
00:13:12,840 --> 00:13:19,320
لا بدّ أنّكم أدركتم أنّنا جميعًا نفتقر
لجزء ما من قلوبنا، صحيح؟

227
00:13:19,890 --> 00:13:20,870
...تقصدين

228
00:13:20,870 --> 00:13:23,800
،لكن إن كنّا نفتقر لها
لماذا تمّ اختيارنا كعناصر؟

229
00:13:23,800 --> 00:13:27,970
قالت سينسي أنّ آلات المتّجهات
.تعزّز المانا خاصّتكم

230
00:13:28,260 --> 00:13:31,450
.صحيح، ذكرت موناكاتا-سينسي ذلك بالفعل

231
00:13:31,990 --> 00:13:34,380
...الطّاقة العاطفيّة، أو المانا

232
00:13:35,160 --> 00:13:38,550
لكن ألا يجب علينا امتلاك قلب
لنتمكّن من ذلك؟

233
00:13:38,550 --> 00:13:41,820
!حان الوقت! وقت الدّمار

234
00:13:41,820 --> 00:13:45,680
!إنّهم يخطّطون لتدمير الكون

235
00:13:45,680 --> 00:13:46,930
!اسمعوا

236
00:13:48,690 --> 00:13:53,290
!أعيروني أسماعكم
!افتحي عيونك أيّتها البشريّة

237
00:13:58,700 --> 00:14:00,130
،من بينهم جميعًا

238
00:13:58,700 --> 00:14:03,690
عناصر

239
00:13:58,700 --> 00:14:03,690
مقياس المانا

240
00:14:00,130 --> 00:14:03,700
لماذا اخترت أطفالاً يملكون
توازنَ مانا ضعيفًا كهؤلاء؟

241
00:14:03,700 --> 00:14:08,690
،استنتج قسم تقدّم تنشيط الأرض، ديفا
.أنّ هذا هو الحلّ الأمثل يا نائب المدير

242
00:14:08,690 --> 00:14:13,570
إضافة لذلك، ليس لدينا إلاّ ثلاثة آلات
!متّجهات بإمكان العناصر استعمالها

243
00:14:13,570 --> 00:14:16,340
كيف يفترض بنا حماية الكون هكذا؟

244
00:14:16,640 --> 00:14:20,270
ليتنا نستطيع إيجاد تلك الملائكة
...الخرافيّة المذكورة في الخرافات

245
00:14:20,590 --> 00:14:21,990
ماذا عسانا نفعل غير هذا؟

246
00:14:22,330 --> 00:14:26,640
بحثنا في أطلال في الكوكب بأكمله
.ولم نستطع العثور على أكويريون

247
00:14:26,640 --> 00:14:28,120
!سيّدي المدير

248
00:14:28,120 --> 00:14:31,960
لا تتحوّل كلّ التّوقّعات الواردة
.في نصوص ناكال إلى حقيقة

249
00:14:31,960 --> 00:14:34,690
هناك نطاق تقلّب كافٍ للسّماح
.بمستقبل مختلف

250
00:14:34,690 --> 00:14:38,910
هل هذا مثال آخر لـ"قدرة الكون
على المراجعة" يا ساروتا-كُن؟

251
00:14:39,180 --> 00:14:40,760
.لا أدري

252
00:14:41,220 --> 00:14:46,080
أو ربّما أنا الّذي أعرف بالفعل
.سيتمّ مراجعته ومحوه من التّاريخ

253
00:14:46,780 --> 00:14:49,920
.باختصار، ستسير الأمور كما يجب لها أن تسير

254
00:14:50,460 --> 00:14:52,520
.لكنّ ذلك سيكون صعبًا على هؤلاء الأطفال

255
00:15:05,160 --> 00:15:07,320
.مهلاً يا ساكّو. ذلك خطير

256
00:15:07,320 --> 00:15:08,340
ماذا؟

257
00:15:08,970 --> 00:15:11,600
موموهيمي. هل أنت نينجا؟

258
00:15:14,320 --> 00:15:19,560
في المدرسة الابتدائيّة، اعتدنا على
.التّحديق بالنّجوم هكذا مع سايو

259
00:15:19,560 --> 00:15:20,380
.نعم

260
00:15:22,190 --> 00:15:23,820
.أراهن أنّها كنت تحبّها

261
00:15:26,160 --> 00:15:27,110
.زهور القرنفل

262
00:15:27,610 --> 00:15:29,360
.أنا متفاجئ من أنّك تذكّرت

263
00:15:29,780 --> 00:15:32,620
.لا أدري ما السّبب
.خطر ببالي ذلك فجأة

264
00:15:33,980 --> 00:15:35,480
.شكرًا لك

265
00:15:35,480 --> 00:15:37,360
لماذا تشكرينني؟

266
00:15:39,810 --> 00:15:42,290
.لأنّ سايو كانت أشبه بأختي الصّغيرة

267
00:15:43,790 --> 00:15:45,450
!وأنت أشبه بأخي الصّغير

268
00:15:47,810 --> 00:15:52,870
.الوضع حيال سايو غريب بالفعل
.أشعر وكأنّها لا تزال حيّة

269
00:15:53,840 --> 00:15:56,340
...إنّها... حقًّا

270
00:15:57,810 --> 00:15:59,060
أهي كذلك؟

271
00:15:59,640 --> 00:16:00,510
ماذا؟

272
00:16:18,640 --> 00:16:20,560
.ساكّو، إنّك متحمّس جدًّا

273
00:16:20,560 --> 00:16:22,170
.وماذا في ذلك؟ جارِني

274
00:16:22,170 --> 00:16:25,320
تنتقل المخلوقات الخرافيّة
.إلى هنا عبر صدع في الفضاء

275
00:16:25,320 --> 00:16:27,160
،من الأفضل هزيمتها هنا

276
00:16:27,160 --> 00:16:29,100
.لكنّنا سنفوز أيضًا إن أرسلناها إلى حيث أتت

277
00:16:29,100 --> 00:16:31,050
أعلم، ولكن كيف؟

278
00:16:31,860 --> 00:16:33,400
!ها هي ذي

279
00:16:57,620 --> 00:16:58,830
...أهذا

280
00:16:59,990 --> 00:17:01,210
صدع؟

281
00:17:01,700 --> 00:17:03,120
!هذا سيّئ

282
00:17:07,140 --> 00:17:10,830
.موناكاتا-سينسي، لقد ظهر صدع

283
00:17:10,830 --> 00:17:11,750
ماذا؟

284
00:17:12,140 --> 00:17:16,360
يخبرنا قسم ديفا أن نرسل أولئك
.الأطفال للقتال

285
00:17:17,730 --> 00:17:20,360
.العدوّ قادم

286
00:17:20,670 --> 00:17:23,210
!مستحيل! ما زالوا يتدرّبون

287
00:17:23,570 --> 00:17:26,570
!إن لم يذهبوا الآن، فسينهار الكون

288
00:17:26,570 --> 00:17:28,320
هذه هي النّتيجة المنطقيّة
.حسب نظريّة الألعاب

289
00:17:32,000 --> 00:17:34,860
.إذًا فقد أتت أخيرًا
!استعدّوا لاعتراضها

290
00:17:34,860 --> 00:17:37,040
!لكن لا يزال هذا باكرًا جدًّا

291
00:17:48,080 --> 00:17:50,090
سيذهبون إلى معركة حقيقيّة سلفًا؟

292
00:17:50,090 --> 00:17:51,290
...سينسي

293
00:17:51,630 --> 00:17:55,080
قوموا بالأمر بينما طائرات الوكالة
!المسيّرة تعترضها! بسرعة

294
00:17:55,640 --> 00:17:56,880
.مفهوم

295
00:17:57,380 --> 00:17:59,060
.انقلوهم إلى هناك الآن

296
00:17:59,060 --> 00:18:00,270
سيُنقلون؟

297
00:18:04,230 --> 00:18:06,730
.المتّجهة سيغل، استعدّي للانطلاق

298
00:18:09,260 --> 00:18:11,920
،إلى كلّ وحدات التّخزين
.ثبّتوا حواجز الأمان

299
00:18:12,450 --> 00:18:14,200
.تفعيل البرج

300
00:18:14,780 --> 00:18:17,910
.جسر المجنقة، تفعيل تسلسل الإطلاق

301
00:18:21,230 --> 00:18:25,260
صار دخول المنطقة ممنوعًا
.الآن لدواعٍ أمنيّة

302
00:18:25,260 --> 00:18:28,940
على سكّان المدينة اللّجوء
.إلى مأوى على الفور

303
00:18:29,470 --> 00:18:31,970
.تمّ فتح غطاء المجنقة الكهرومغناطيسيّ

304
00:18:36,310 --> 00:18:38,580
.تمّ إقران المتّجهة مغناطيسيًّا بالمكّوك

305
00:18:39,140 --> 00:18:42,730
.مسار الإطلاق مفتوح. تمّ تفعيل الدّفع

306
00:18:44,040 --> 00:18:46,400
.إطلاق المتّجهة سيغل

307
00:18:47,190 --> 00:18:50,060
.ميناء اليخوت، بدء تسلسل الإطلاق

308
00:18:51,180 --> 00:18:54,190
.تمّ فتح غطاء المجنقة الكهرومغناطيسيّ
.الاستعداد للإطلاق

309
00:18:54,500 --> 00:18:58,620
.تفعيل البرج
.تمّ إقران المتّجهة مغناطيسيًّا بالمكّوك

310
00:18:58,620 --> 00:19:01,090
.تمّ النّقل لوضع الإطلاق بنجاح

311
00:19:01,090 --> 00:19:04,230
.تمّ فتح أبواب المجنقة الكهرومغناطيسيّ

312
00:19:04,230 --> 00:19:07,490
.تمديد السّكك. مسار الإطلاق مفتوح

313
00:19:07,950 --> 00:19:08,950
.تمّ تفعيل الدّفع

314
00:19:10,630 --> 00:19:13,000
.إطلاق المتّجهة فيو

315
00:19:18,420 --> 00:19:22,520
.كهف إيوايا، البدء بتسلسل الإطلاق
.تمّ فتح أبواب الخليج

316
00:19:22,520 --> 00:19:25,890
.تمّ إقران المتّجهة مغناطيسيًّا بالمكّوك
.تمّ تفعيل الدّفع

317
00:19:26,260 --> 00:19:28,530
.إطلاق المتّجهة تير

318
00:19:32,520 --> 00:19:33,620
ماذا؟

319
00:19:34,820 --> 00:19:37,400
.شعرتُ وكأنّ جسدي حلّق لمكان ما

320
00:19:37,400 --> 00:19:39,010
أين نحن؟

321
00:19:41,790 --> 00:19:44,350
.إنّ هذا يبدو حقيقيًّا بشكل غريب

322
00:19:44,350 --> 00:19:46,400
.هذا صحيح يا تسوكيشيرو ريميا-كُن

323
00:19:46,400 --> 00:19:48,660
.هذا ليس تدريبًا. هذا هو الواقع

324
00:19:48,660 --> 00:19:50,370
ماذا؟ ساروتا-سينسي؟

325
00:19:50,370 --> 00:19:52,120
!الواقع؟

326
00:19:52,120 --> 00:19:53,180
!ثمّة شيء ما هنا

327
00:19:53,180 --> 00:19:56,080
،ذلك هو سلاح غزو عدوّنا
.مخلوق خرافيّ

328
00:19:56,080 --> 00:19:58,130
!إن كنتم تريدون النّجاة، دمّروه

329
00:19:58,130 --> 00:19:58,970
ماذا؟

330
00:20:01,340 --> 00:20:03,470
!مهلاً! إنّه يتّجه نحونا

331
00:20:04,560 --> 00:20:07,900
.إلى كلّ السّفن، نسقوا هجماتكم
!تذكّروا تدريبكم

332
00:20:08,370 --> 00:20:10,400
،سأشتّت انتباهه
!لذلك هاجموه من الخلف

333
00:20:10,400 --> 00:20:11,150
.حاضر

334
00:20:11,150 --> 00:20:12,280
!ستقومان بهذا سلفًا؟

335
00:20:18,250 --> 00:20:21,920
.لا تربكه المعارك الحقيقيّة على الإطلاق

336
00:20:22,870 --> 00:20:24,690
!هذا جيّد! مرّة أخرى

337
00:20:35,180 --> 00:20:36,270
.هذا سيّئ

338
00:20:36,760 --> 00:20:38,190
!إنّ المانا غير مستقرّة

339
00:20:53,420 --> 00:20:54,830
.انتهى الأمر

340
00:21:04,310 --> 00:21:05,190
!يا رفاق

341
00:21:07,880 --> 00:21:08,690
ماذا؟

342
00:21:14,180 --> 00:21:15,380
!هذا مؤلم

343
00:21:15,380 --> 00:21:18,610
حاولوا تذكّر كيف كان الوضع
.وأنتم تملكون أجنحة

344
00:21:20,940 --> 00:21:22,620
ما هذا؟

345
00:21:28,590 --> 00:21:30,060
.أكويريون

346
00:21:32,800 --> 00:21:35,450
!انطلق... يا أكويريون

347
00:21:36,770 --> 00:21:39,290
.ماذا يحدث؟ أشعر بالغثيان

348
00:21:39,290 --> 00:21:41,360
...أهذا هما

349
00:21:41,690 --> 00:21:46,230
!نعم، أستطيع الشّعور بها قادمة منكما

350
00:21:53,260 --> 00:21:55,090
أيعقل أنّ هذا ممكن...؟

351
00:21:56,260 --> 00:21:59,040
عندما تكون الشّمس والقمر
،والمرّيخ على نفس المسار

352
00:21:59,660 --> 00:22:02,050
.يبدأ لحن اتّحاد جديد بالتّردّد

353
00:22:04,320 --> 00:22:07,470
!الملاك الميكانيكيّ أكويريون