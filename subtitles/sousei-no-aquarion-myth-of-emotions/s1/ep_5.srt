1
00:01:32,310 --> 00:01:34,320
عجائب أكاديميّة إينو السّبعة؟

2
00:01:34,320 --> 00:01:38,680
نعم. مثل تبدّل أماكن حمّامات
.الفتيان والفتيات أحيانًا

3
00:01:39,810 --> 00:01:40,740
ما الغاية من ذلك؟

4
00:01:40,940 --> 00:01:45,490
والمرآة الضّخمة الّتي تسحب من
،ينظر إليها في السّاعة 4:44 مساءً

5
00:01:45,850 --> 00:01:47,370
،والنّموذج التّشريحيّ المبتسم

6
00:01:47,370 --> 00:01:50,180
والموناليزا الّتي تبعد نظرها
،عنك إذا ما التقت عيناكما

7
00:01:50,180 --> 00:01:51,210
...وأيضًا

8
00:01:51,720 --> 00:01:52,900
ما الأخرى؟

9
00:01:53,580 --> 00:01:56,710
.صحيح. تمثال نينوميا كينجيرو الرّاكض

10
00:01:57,080 --> 00:02:00,760
وفوق ذلك، عندما تكون
،الصّالة الرّياضيّة فارغة

11
00:02:00,760 --> 00:02:04,460
بالإمكان سماع صوت ارتداد
.كأنّ هنالك من يلعب بالكرة فيها

12
00:02:05,800 --> 00:02:08,380
.وذلك مخيف؟ ما كنت لأدري

13
00:02:08,380 --> 00:02:10,970
.نعم. ذلك في حالتك فقط يا ساكّو

14
00:02:11,830 --> 00:02:14,760
ذكرتَ ستّة فحسب. ما الأخيرة؟

15
00:02:15,090 --> 00:02:16,400
...إنّها

16
00:02:17,340 --> 00:02:19,350
.الشّبح في المكتبة

17
00:02:19,350 --> 00:02:22,330
،إنّه ينادي مِن خلف رفوف الكتب قائلاً

18
00:02:22,330 --> 00:02:23,440
"أيمكننا أن نصير أصدقاء؟"

19
00:02:23,440 --> 00:02:25,240
.مستحيل. إنّه كوكّوري-سان

20
00:02:25,240 --> 00:02:28,910
ماذا؟ ماذا عن الشّبح الّذي يعود
سعيًا للانتقام من متنمّريه؟

21
00:02:29,520 --> 00:02:32,900
.لا، لا. بل إنّها عن التّلميذ المنتقل الغامض

22
00:02:34,230 --> 00:02:37,220
عندما مات تلميذ ما، ظهر تلميذ

23
00:02:37,220 --> 00:02:41,200
.يشبهه تمامًا بعدها بشهر تقريبًا

24
00:02:42,700 --> 00:02:44,270
،بالنّسبة للأعجوبة الأخيرة

25
00:02:44,270 --> 00:02:47,910
،سمع الجميع عن أشياء مختلفة
.ولا يعرفون أيّها الصّحيح

26
00:02:47,910 --> 00:02:49,220
أسمعت عنها يا ساكّو؟

27
00:02:49,220 --> 00:02:51,270
.لا، لم يكن لديّ أيّ أصدقاء في كلّ الأحوال

28
00:02:51,270 --> 00:02:54,680
أخبرني أخي أنّه عندما نكون
في رواق المدخل

29
00:02:54,680 --> 00:02:58,570
ولا يوجد أحد آخر، بالإمكان سماع
!صوت مفتاح بيانو يُضغط

30
00:03:09,220 --> 00:03:10,820
ما الخطب يا مومو؟

31
00:03:10,820 --> 00:03:14,190
ماذا؟ أسمعتما نغمة بيانو للتّوّ؟

32
00:03:14,190 --> 00:03:17,790
عمّ تتحدّثين؟ لدينا حصّة تربية
!بدنيّة تاليًا، لنذهب

33
00:03:17,790 --> 00:03:18,980
.حسنًا

34
00:03:22,370 --> 00:03:25,460
ما الخطب الآن؟

35
00:03:25,460 --> 00:03:30,070
أشعر وكأنّ هنالك شخصًا ما
.يتبعني طوال اليوم

36
00:03:31,450 --> 00:03:32,950
بالمناسبة، أسمعت الخبر؟

37
00:03:32,950 --> 00:03:33,920
أيّ خبر؟

38
00:03:33,920 --> 00:03:36,480
.ثمّة تلميذ منتقل. يُقال أنّه ظريف جدًّا

39
00:03:36,480 --> 00:03:38,650
ماذا؟ كلاّ، بل إنّه فتاة، صحيح؟
.من السّنة الأولى

40
00:03:38,650 --> 00:03:41,430
.لا! بل هو فتى من السّنة الثّالثة

41
00:03:41,430 --> 00:03:42,360
ماذا؟

42
00:03:42,580 --> 00:03:46,150
بالحديث عن الأشباح، هل تعتقدون
أنّ تلك الأشياء أشباح أيضًا؟

43
00:03:46,150 --> 00:03:46,990
أيّ أشياء؟

44
00:03:46,990 --> 00:03:49,480
.تلك الّتي نراها عندما يندمج أكويريون

45
00:03:49,990 --> 00:03:53,370
.قالت إيتشيكي-سان أنّها حيواتنا السّابقة

46
00:03:53,370 --> 00:03:55,370
.صحيح، يبدو ذلك صحيحًا

47
00:03:55,660 --> 00:03:58,890
كنّا أنا وموموهيمي-سينباي
.أختين في حياة سابقة

48
00:03:58,890 --> 00:04:01,370
ماذا؟ كيف عرفت ذلك؟

49
00:04:01,370 --> 00:04:05,220
رأينا نفس الرّؤيا أثناء موعدنا
.في حديقة الأسماك

50
00:04:05,220 --> 00:04:08,220
.نحن الاثنان فقط... في عالم آخر

51
00:04:09,050 --> 00:04:13,540
حيوات سابقة؟ كانت تراودها
.أحلام يقظة بأشياء كتلك دائمًا

52
00:04:19,760 --> 00:04:21,780
.آسف. اسبقاني

53
00:04:23,140 --> 00:04:25,360
ألم يكن هذا هو حمّام الفتيان؟

54
00:04:26,560 --> 00:04:27,490
.المعذرة

55
00:04:41,630 --> 00:04:42,900
ما الخطب؟

56
00:04:43,880 --> 00:04:46,250
.رأيتُ... سايو للتّوّ

57
00:04:49,260 --> 00:04:52,100
الفريق الأزرق

58
00:04:49,260 --> 00:04:52,100
الفريق الأحمر

59
00:04:49,260 --> 00:04:57,980
أعلى نتيجة

60
00:04:49,260 --> 00:04:57,980
الفريق الأصفر

61
00:04:49,260 --> 00:04:57,980
الضّرر

62
00:04:49,910 --> 00:04:51,890
هل ظهر شبح إيتشيكي فعلاً؟

63
00:04:51,890 --> 00:04:55,510
.سمعتُ أنّ شبحها ظهر في المكتبة

64
00:04:55,100 --> 00:04:57,980
الفريق الأزرق

65
00:04:55,100 --> 00:04:57,980
الفريق الأحمر

66
00:04:55,510 --> 00:04:58,720
.كانت تلك سايو بالفعل! رأيتها أيضًا

67
00:04:58,720 --> 00:04:59,920
!هذا مخيف

68
00:04:59,920 --> 00:05:02,820
أواثقون أنّه لم يكن ضحيّة التّنمّر الّذي انتحر

69
00:05:02,820 --> 00:05:04,650
وعاد للانتقام؟

70
00:05:03,900 --> 00:05:06,450
الضّرر

71
00:05:03,900 --> 00:05:11,870
الفريق الأحمر

72
00:05:03,900 --> 00:05:13,250
أعلى نتيجة

73
00:05:03,900 --> 00:05:13,250
الفريق الأصفر

74
00:05:03,900 --> 00:05:13,250
الفريق الأزرق

75
00:05:04,650 --> 00:05:06,220
تقصدون موضوع العجائب السّبعة؟

76
00:05:06,220 --> 00:05:08,560
هذا لأنّكم كنتم تنبذون إيتشيكي دائمًا، صحيح؟

77
00:05:08,410 --> 00:05:13,250
الضّرر

78
00:05:08,560 --> 00:05:09,940
،لم نكن ننبذها

79
00:05:09,940 --> 00:05:11,680
.كما أنّها لم تنتحر من الأساس

80
00:05:11,680 --> 00:05:13,250
!اخرس أيّها الغبيّ

81
00:05:12,660 --> 00:05:13,250
الفريق الأحمر

82
00:05:14,360 --> 00:05:19,000
على الأرجح أنّ تلك بقايا من قبل
.أن ينقسم هذا الكون لاثنين

83
00:05:19,000 --> 00:05:23,130
بقايا وعي من فترة الحضارة
.الفائقة الّتي كانت موجودة آنذاك

84
00:05:23,130 --> 00:05:25,030
فترة الحضارة الفائقة؟

85
00:05:25,030 --> 00:05:25,960
.نعم

86
00:05:26,650 --> 00:05:30,700
أظهرت البحوث أنّ تلاميذ العناصر
الموهوبين مثل إيتشيكي سايو

87
00:05:30,700 --> 00:05:33,770
.يحملون أحيانًا ذكريات عن حيواتهم السّابقة

88
00:05:34,850 --> 00:05:38,560
وبما أنّكم تملكون جميعًا القدرة
،على تحويل عواطفكم إلى طاقة

89
00:05:38,560 --> 00:05:42,290
من المرجّح أيضًا أنّكم تستجيبون
لآثار الطّاقة الرّوحيّة

90
00:05:42,290 --> 00:05:44,140
.الّتي خلّفتها الحضارة الفائقة عبر الزّمن

91
00:05:44,140 --> 00:05:45,820
...عفوًا

92
00:05:46,290 --> 00:05:49,840
لعلمكم، فكرة الحيوات السّابقة
.ليست غير علميّة

93
00:05:50,290 --> 00:05:54,680
ذلك يعني أنّ بإمكانكم أحيانًا رؤية أشياء
.يعجز الأشخاص العاديّون عن رؤيتها

94
00:05:56,000 --> 00:06:00,710
ساروتا-سينسي، سمعتُ عن انتقال تلميذ
.جديد في وقت متأخّر من الفصل الدّراسيّ

95
00:06:00,710 --> 00:06:02,880
...هل يُعقل أنّه

96
00:06:02,880 --> 00:06:05,600
،واثق أنّكم توقّعتم الأمر
.التّلميذ الجديد من العناصر أيضًا

97
00:06:05,600 --> 00:06:07,680
.كما أنّه تلميذ واعد جدًّا

98
00:06:07,970 --> 00:06:09,660
فعلاً؟

99
00:06:10,310 --> 00:06:14,360
أتعتقد يا ساكّو أنّ إيتشيكي-سان
الّتي رأيتها هي ذلك التّلميذ المنتقل؟

100
00:06:14,360 --> 00:06:15,120
ماذا؟

101
00:06:15,120 --> 00:06:18,520
.في الحقيقة، رأى ساكّو إيتشيكي-سان

102
00:06:18,520 --> 00:06:22,070
.رآها تلاميذ آخرون أيضًا
.وصلتني رسائل دردشة عن ذلك

103
00:06:22,070 --> 00:06:27,140
هل يعني ذلك أنّ قدرة الكون على
تصحيح نفسه ما زالت قائمة؟

104
00:06:27,580 --> 00:06:30,150
.هذا ليس ما يحدث هنا لسوء الحظّ

105
00:06:30,570 --> 00:06:36,160
شهدنا جميعًا على موتها وبكينا على
رفاثها في الجنازة، أليس كذلك؟

106
00:06:37,100 --> 00:06:42,910
في هذه النّقطة من الزّمن، يعيش
.كلّ واحد منّا في كون ماتت فيه

107
00:06:43,840 --> 00:06:49,390
،إنّ موتها الآن حقيقة أكيدة
.مهما كان الكون الّذي نحن فيه

108
00:06:55,020 --> 00:06:59,070
!إذًا ما رآه ساكّو هو شـ-شبح حقيقيّ؟

109
00:06:59,070 --> 00:07:00,100
—ربّما يكون ذلك

110
00:07:04,110 --> 00:07:05,040
سايو؟

111
00:07:05,740 --> 00:07:07,160
مهلاً يا سايو؟

112
00:07:19,420 --> 00:07:21,450
.إنّها حقيقيّة إذًا

113
00:07:21,450 --> 00:07:22,880
إلى أين ذهبت؟

114
00:07:22,880 --> 00:07:23,940
!هناك

115
00:07:27,660 --> 00:07:29,040
.اذهبوا أنتم من هناك

116
00:07:29,040 --> 00:07:29,730
.نعم

117
00:07:29,040 --> 00:07:29,970
.حاضر

118
00:07:35,440 --> 00:07:36,760
!هـ-هناك

119
00:08:00,770 --> 00:08:01,800
.مرحبًا

120
00:08:03,960 --> 00:08:04,900
من أنت؟

121
00:08:06,130 --> 00:08:10,820
الأغنية الّتي تعزفها النّجوم
.هي اللّحن الّذي يضبط الكون

122
00:08:23,340 --> 00:08:24,810
!وحش خرافيّ

123
00:08:25,740 --> 00:08:27,000
.ما باليد حيلة. لنذهب

124
00:08:27,000 --> 00:08:27,930
.نعم

125
00:08:43,260 --> 00:08:47,310
من أجل سلامتكم، الولوج
.للمناطق المحيطة محظور الآن

126
00:08:47,310 --> 00:08:51,000
يُرجى من جميع المواطنين
.التّوجّه إلى الملاجئ فورًا

127
00:08:51,800 --> 00:08:54,920
.ميناء اليخوت، بدء تسلسل الإطلاق
.الاستعداد للإطلاق

128
00:08:54,920 --> 00:08:58,730
.كهف إيوايا، تمّ فتح أبواب الخليج

129
00:08:58,730 --> 00:09:00,680
.مسار الإطلاق المجنقة مفتوح

130
00:09:02,440 --> 00:09:04,750
.المتّجهة سيغل، انطلاق

131
00:09:07,390 --> 00:09:09,820
!المتّجهة فيو، انطلاق

132
00:09:13,030 --> 00:09:15,440
!المتّجهة تير، انطلاق

133
00:09:18,220 --> 00:09:19,650
تدريب آخر؟

134
00:09:19,650 --> 00:09:21,530
.يقومون بالكثير منها مؤخّرًا

135
00:09:21,530 --> 00:09:23,970
.هذه آلات وكالة الحفاظ على الفضاء

136
00:09:23,970 --> 00:09:24,970
فعلاً؟

137
00:09:31,050 --> 00:09:34,550
!الوحش الخرافيّ في منتصف الصّدع سلفًا

138
00:09:39,420 --> 00:09:40,650
في بحيرة أشي؟

139
00:09:42,550 --> 00:09:45,920
الأعضاء الّذين اختارتهم ديفا
هم أوتوري ساكّو-كُن

140
00:09:45,920 --> 00:09:48,950
.وأماها موموهيمي-كُن وهاتانو توشي-كُن

141
00:09:49,230 --> 00:09:50,350
.عُلم

142
00:09:50,950 --> 00:09:52,030
!بسرعة

143
00:09:52,300 --> 00:09:54,310
.ليس عليك إخباري بذلك

144
00:09:57,830 --> 00:10:00,740
.إنّها أوّل مرّة لنا معًا يا توشي-كُن
!حظًّا سعيدًا

145
00:10:00,740 --> 00:10:01,750
!شكرًا لك

146
00:10:07,160 --> 00:10:08,740
ما ذلك الشّيء؟

147
00:10:09,420 --> 00:10:10,930
!إنّه قادم نحونا

148
00:10:25,470 --> 00:10:27,680
!اندمجوا بسرعة

149
00:10:28,010 --> 00:10:29,100
!لنقم بهذا

150
00:10:29,630 --> 00:10:33,270
كلاّ! لم يصل مقياس المانا خاصّتكم
!لمستويات الاندماج بعد

151
00:10:42,660 --> 00:10:44,290
ما الّذي يحدث؟

152
00:10:48,250 --> 00:10:51,630
!كلاّ! تلك طريق البلدة
!ثمّة الكثير من النّاس هناك

153
00:10:52,170 --> 00:10:56,490
،أماها-سان، أوتوري-كُن
!تخلّصا من أيّ أفكار تطفّليّة

154
00:10:57,850 --> 00:10:59,790
!تمالك نفسك يا ساكّو

155
00:10:57,850 --> 00:10:59,790
!تمالكِ نفسك يا موموهيمي

156
00:11:00,310 --> 00:11:04,330
لا بأس. من الأفضل عدم
.الاستعجال والاندماج كسيغل

157
00:11:04,330 --> 00:11:08,220
،تريدكم ديفا أن تندمجوا
.مع تير في القيادة هذه المرّة

158
00:11:09,020 --> 00:11:10,470
ماذا؟ أنا؟

159
00:11:10,470 --> 00:11:12,330
!تمالك نفسك يا توشي

160
00:11:10,470 --> 00:11:12,330
!تمالك نفسك يا توشي-كُن

161
00:11:12,700 --> 00:11:15,120
!لكنّي لستُ مستعدًّا

162
00:11:15,640 --> 00:11:19,410
جيّد! وصل مقياس المانا
!إلى مستويات الاندماج أخيرًا

163
00:11:22,590 --> 00:11:25,280
!لنقم بهذا يا ساكّو وموموهيمي-سينباي

164
00:11:25,280 --> 00:11:25,870
!نعم

165
00:11:25,280 --> 00:11:26,210
!أجل

166
00:11:28,650 --> 00:11:31,580
!اندماج النّجوم الخرافيّ
!انطلق يا أكويريون

167
00:11:43,520 --> 00:11:44,450
!توشي

168
00:11:55,520 --> 00:11:57,810
!أكويريون تير

169
00:12:32,820 --> 00:12:37,180
إنّ اختصاص تير هو استعمال
.الأسلحة الحادّة في القتال القريب

170
00:12:41,640 --> 00:12:45,290
ما كانت سيغل لتستطيع الاقتراب
،بما يكفي من أجل قتال قريب

171
00:12:45,290 --> 00:12:48,040
وكانت أسهم فيو لترتدّ عن
.الوحش في الحال

172
00:12:48,040 --> 00:12:51,990
!ولكن، سلاح تير الحادّ بإمكانه الاشتباك معه

173
00:13:07,130 --> 00:13:09,560
!كفّروا عن خطاياكم

174
00:13:13,250 --> 00:13:17,750
!فأنا لا أدعو للخلاص الأبديّ للأشرار

175
00:13:18,180 --> 00:13:22,440
!سيف حُكم الجلاّد

176
00:13:41,520 --> 00:13:42,400
هل نلنا منه؟

177
00:13:42,400 --> 00:13:43,570
!لم يقطعه

178
00:14:01,480 --> 00:14:02,810
.لقد هرب

179
00:14:02,810 --> 00:14:05,160
!ضعوا حاجزًا بقطر 500 متر حول الوتد

180
00:14:05,160 --> 00:14:07,720
!سرّعوا عملية إخلاء المكان من السّكّان والسّيّاح

181
00:14:11,240 --> 00:14:14,620
.استطاعوا غرس الوتد في نهاية المطاف

182
00:14:14,620 --> 00:14:16,960
.نعم. أنا أعتذر

183
00:14:16,960 --> 00:14:18,920
.لا بأس! إنّه وتد واحد فقط

184
00:14:18,920 --> 00:14:23,200
،لم تشكّل مثلّثًا بعد
.لذلك فذلك لا يغيّر أيّ شيء

185
00:14:23,590 --> 00:14:26,070
.ولكن، إنّ الوضع يتغيّر بسرعة

186
00:14:26,070 --> 00:14:29,220
.علينا المضيّ قُدمًا بخططنا. وبسرعة

187
00:14:29,470 --> 00:14:33,850
لذلك السّبب أرسلنا ورقتنا الرّابحة
.للمدرسة كتلميذ منتقل

188
00:14:34,470 --> 00:14:39,250
عجبًا. أنا متفاجئ أنّهم قرّروا
.إرسال الفتى إلينا

189
00:14:39,250 --> 00:14:42,560
.أعلم ما الّذي سيعنيه لهم

190
00:14:42,690 --> 00:14:45,190
.كان ذلك اتّفاقًا بيننا وبينهم
.لا داعي من أن تفهموه

191
00:14:46,030 --> 00:14:50,410
إن نجح هذا، لن تعانون من
.إيجاد بدائل للعناصر بعد الآن

192
00:14:51,070 --> 00:14:53,650
هل تعتقدون أنّ هذا سيسير على ما يرام؟

193
00:14:53,650 --> 00:14:57,230
.عليك الحرص أن يسير كذلك يا موناكاتا-سينسي

194
00:14:57,550 --> 00:15:00,800
بالحديث عن ذلك، إنّ الغرض
.الّذي ناقشناه جاهز الآن

195
00:15:00,800 --> 00:15:03,780
.إنّه مبنيّ على أكويريون سيغل

196
00:15:03,780 --> 00:15:07,550
إنّه يستعمل حجرًا خرافيًّا
.كجهاز تعزيز مانا خاصّ به

197
00:15:08,170 --> 00:15:10,560
.سيكتمل الهاكوبوني قريبًا

198
00:15:10,560 --> 00:15:13,250
وبعد ذلك، سيكون علينا فقط
انتظار أكاديميّة إينوشيما

199
00:15:29,120 --> 00:15:31,110
.يا صاحب الأجنحة المدنّسة

200
00:15:31,110 --> 00:15:32,550
.قدّم حجّتك

201
00:15:33,120 --> 00:15:35,850
!كلّ هذه الأجنحة غلطتها هي

202
00:15:35,850 --> 00:15:39,710
،إن نزعتم أجنحتها
!ستعود أجنحتي إلى طبيعتها

203
00:15:40,740 --> 00:15:42,020
...أيّها الـ

204
00:15:42,780 --> 00:15:44,810
!يا إلهتنا مولوا ساتيني

205
00:15:44,810 --> 00:15:45,750
!أنزلي حكمك

206
00:15:51,190 --> 00:15:53,230
.تمّ الحُكم

207
00:15:53,230 --> 00:15:57,290
.انتزعوا أجنحتهم وانفوهم من أرض ناكال

208
00:15:58,310 --> 00:15:59,760
!مستحيل

209
00:16:05,730 --> 00:16:09,030
!ما سبب الضّحك؟ كلّ هذا غلطتك أنت

210
00:16:09,500 --> 00:16:10,660
—إنّها غـ

211
00:16:11,400 --> 00:16:15,820
!اتركوني. أتركوني! أتركوني

212
00:16:22,970 --> 00:16:27,410
هل تعتقدون أنّ تلك الأشياء
من حيواتنا السّابقة بالفعل؟

213
00:16:27,410 --> 00:16:32,420
كان ذلك قاسيًا بالتّأكيد
.بالنّسبة لبقايا حضارة روحانيّة

214
00:16:33,790 --> 00:16:37,080
أعتقد أنّ العديد من النّاس ماتوا
في تلك المعركة الأخيرة، صحيح؟

215
00:16:43,740 --> 00:16:46,900
يُعتقد أنّ أزيَد من خمسين شخصًا
قد دُفنوا بفعل الانهيار الصّخريّ

216
00:16:46,900 --> 00:16:49,500
.الّذي صاحب ثوران أواكوداني

217
00:16:49,930 --> 00:16:52,710
ما زالت جهود الإنقاذ اليائسة مستمرّة حتّى الآن

218
00:16:52,710 --> 00:16:55,210
وتمّ إعلامُ المناطق المجاورة بضرورة الإخلاء

219
00:16:55,210 --> 00:16:57,500
.بما أنّ تهديد حدوث كارثة ثانية يظلّ قائمًا

220
00:16:58,390 --> 00:17:02,320
.رغم أنّ الكون قد صحّح حقيقة ذلك

221
00:17:02,320 --> 00:17:05,470
استطعنا إنقاذ الكثير من النّاس
.أيضًا بفضلك يا توشي-كُن

222
00:17:06,200 --> 00:17:08,350
...موموهيمي-سينباي

223
00:17:08,350 --> 00:17:14,130
،على أيّ حال، علينا القيام بما نستطيع
.وإلاّ فسيكون هنالك ضحايا أكثر

224
00:17:14,130 --> 00:17:16,560
!يا رفاق، لنبذل كلّ جهدنا

225
00:17:16,560 --> 00:17:17,670
!أجل

226
00:17:17,990 --> 00:17:20,290
...كلام التّشجيع هذا ليس

227
00:17:37,600 --> 00:17:38,830
سايو؟

228
00:17:42,680 --> 00:17:43,860
!سايو

229
00:17:47,650 --> 00:17:48,580
.مهلاً

230
00:17:49,070 --> 00:17:51,590
ألست إيتشيكي-سان؟

231
00:17:51,870 --> 00:17:53,840
من أنت؟

232
00:17:55,270 --> 00:17:59,000
كيف الحال؟ أنا إيتشيكي هانا
.من فصل السّنة الأولى الثّالث

233
00:17:59,000 --> 00:18:00,570
...إيتشيكي؟ تعنين

234
00:18:01,660 --> 00:18:04,290
.يُفترض بي أن أبدأ غدًا

235
00:18:04,290 --> 00:18:05,960
.أنا اليوم ألقي نظرة في الأرجاء فحسب

236
00:18:05,960 --> 00:18:08,310
هل أنت التّلميذ المنتقل؟

237
00:18:08,680 --> 00:18:13,480
وهل أنتم هم أصدقاء أختي الكبرى؟

238
00:18:14,050 --> 00:18:15,210
أختك الكبرى؟

239
00:18:16,230 --> 00:18:19,770
!إيتشيكي سايو هي أختي الكبرى

240
00:18:19,770 --> 00:18:20,930
ماذا؟

241
00:18:22,450 --> 00:18:24,530
كان لسايو أخت؟

242
00:18:30,310 --> 00:18:34,470
يا مومو-ني، هل كنت تعرفين
أنّ لها أختًا صغيرة؟

243
00:18:34,920 --> 00:18:38,580
.سمعتُها تقول أنّها أحبّت أختها الصّغيرة

244
00:18:39,080 --> 00:18:43,300
كانت حزينة لأنّها لم تستطع
.رؤيتها لأنّ ذلك سيضعها في خطر

245
00:18:44,640 --> 00:18:47,000
هل تعاني مرضًا عضالاً أو ما شابه؟

246
00:18:47,000 --> 00:18:50,070
.ربّما لذلك السّبب لم تكن في الجنازة

247
00:18:50,070 --> 00:18:52,260
.مهلاً. لكنّها تبدو في أفضل حال

248
00:18:54,660 --> 00:18:59,720
حسبما رأيت، كانت أختي الكبرى مجتهدة
،في الدّراسة ولطيفة مع الآخرين

249
00:18:59,720 --> 00:19:04,130
،وبإمكانها القيام بأيّ شيء
!لأنّها كانت مثاليّة للغاية

250
00:19:05,480 --> 00:19:07,600
.نعم، ذلك صحيح

251
00:19:07,600 --> 00:19:08,910
فعلاً؟

252
00:19:09,280 --> 00:19:14,830
لقد كتبت عنكما يا موموهيمي-سينباي
.وساكّو-سينباي في رسائلها إليّ

253
00:19:14,830 --> 00:19:16,420
كتبت رسائل؟

254
00:19:16,420 --> 00:19:17,450
.نعم

255
00:19:17,450 --> 00:19:20,810
قالت أنّها سئمت من مشاهدتك
.تقوم بأمور خطيرة يا ساكّو-سينباي

256
00:19:25,170 --> 00:19:30,360
من جهة أخرى، قالت أنّ موموهيمي-سينباي
،كانت في غاية الذّكاء ورياضيّة بارعة

257
00:19:30,360 --> 00:19:31,690
!ولطيفة أيضًا

258
00:19:32,200 --> 00:19:35,700
.لكنّي لم أصدّق أيًّا من ذلك حتّى اليوم

259
00:19:35,700 --> 00:19:39,030
ظننتُ أنّه من المستحيل أن يوجد
.شخص أكثر مثاليّة من أختي

260
00:19:39,030 --> 00:19:41,340
.لكنّي لا أعتقد أنّي مثاليّة على الإطلاق

261
00:19:41,340 --> 00:19:43,310
.لكنّي شاهدتكم طوال اليوم

262
00:19:43,310 --> 00:19:44,350
شاهدتنا؟

263
00:19:45,760 --> 00:19:48,150
ماذا؟ إذًا كنتِ أنتِ طوال الوقت؟

264
00:19:48,150 --> 00:19:50,150
.يقول النّاس أنّي أشبه أختي كثيرًا

265
00:19:50,150 --> 00:19:51,560
أذلك صحيح؟

266
00:19:51,560 --> 00:19:52,490
.مستحيل

267
00:19:53,670 --> 00:19:54,810
!هانا-تشان

268
00:20:02,980 --> 00:20:05,000
الأخت الصّغرى لتلميذة السّنة الثّانية الميتة؟

269
00:20:05,000 --> 00:20:06,830
لماذا غيّرت مظهرها؟

270
00:20:06,830 --> 00:20:09,320
.لم ترد إخافة النّاس بشبهها الكبير لأختها

271
00:20:09,320 --> 00:20:11,000
ستصير مهرّج الفصل الآن؟

272
00:20:17,180 --> 00:20:19,420
انتهيت! ما رأيك؟

273
00:20:26,710 --> 00:20:28,090
من هذه؟

274
00:20:28,530 --> 00:20:30,580
!التّلميذ المنتقل الجديد رائع للغاية

275
00:20:30,580 --> 00:20:31,470
!لنذهب لرؤيته

276
00:20:31,470 --> 00:20:32,400
.نعم

277
00:20:33,410 --> 00:20:35,140
.صباح الخير يا مومو

278
00:20:35,140 --> 00:20:36,320
.صباح الخير

279
00:20:36,320 --> 00:20:39,590
هل سمعت بالتّلميذ المنتقل الغامض بعد؟

280
00:20:39,590 --> 00:20:43,080
.غامض؟ التقينا البارحة

281
00:20:43,080 --> 00:20:46,180
!لا وجود لأيّ غموض. بل ظرافة فحسب

282
00:20:46,180 --> 00:20:48,000
ماذا؟ فعلاً؟

283
00:20:48,000 --> 00:20:50,210
.ربّما بدأت تُظهر اهتمامًا بالفتية أخيرًا

284
00:20:50,210 --> 00:20:52,340
ماذا؟ عمّ تتحدّثان؟

285
00:20:55,380 --> 00:20:57,260
من أين انتقلت إلينا؟

286
00:20:57,260 --> 00:20:58,370
ألديك أيّ هوايات؟

287
00:20:58,860 --> 00:21:00,450
ما طعامك المفضّل؟

288
00:21:01,580 --> 00:21:03,140
ما الّذي أكلت على الفطور؟

289
00:21:04,570 --> 00:21:06,780
.إذًا فذلك هو التّلميذ المنتقل

290
00:21:10,530 --> 00:21:13,740
أليس من المفترض أنّ هانا-تشان
هي التّلميذ المنتقل؟

291
00:21:13,740 --> 00:21:15,700
.أعتقد أنّه كان ذاك

292
00:21:25,550 --> 00:21:30,500
وعدتُ أن نكون واحدًا، أليس كذلك؟
.دعيني أفي بذلك الوعد

293
00:21:31,610 --> 00:21:32,540
.حسنًا

294
00:21:33,390 --> 00:21:35,360
!ماذا؟

295
00:21:41,480 --> 00:21:45,180
ما الّذي تفكّر فيه
موموهيمي-سينباي على أيّ حال؟

296
00:21:46,190 --> 00:21:48,780
.ظننتُ أنّها لا تستطيع الشّعور بالحبّ

297
00:21:53,780 --> 00:21:56,420
!موموهيمي-سينباي

298
00:22:02,240 --> 00:22:03,750
...لقد

299
00:22:04,190 --> 00:22:05,840
...قرّرتُ يا موموهيمي-سينباي

300
00:22:06,880 --> 00:22:09,180
.أن أقوم بقتلك