1
00:01:30,340 --> 00:01:31,350
...لقد

2
00:01:31,690 --> 00:01:33,820
...قرّرتُ يا موموهيمي-سينباي

3
00:01:33,820 --> 00:01:35,700
.أن أقوم بقتلك

4
00:01:35,920 --> 00:01:36,710
ماذا؟

5
00:01:38,030 --> 00:01:40,770
.لمعلوماتك فحسب. إلى اللّقاء

6
00:01:41,930 --> 00:01:43,500
!مع السّلامة

7
00:01:44,680 --> 00:01:46,660
كيف يمكنك توديعها ببساطة هكذا؟

8
00:01:47,890 --> 00:01:49,060
من كانت؟

9
00:01:49,060 --> 00:01:50,880
.الأخت الصّغيرة لأختي الصّغيرة

10
00:01:54,260 --> 00:01:57,570
،اقترب فصل العناصر
.من الأفضل تغيير ملابسكم

11
00:01:57,570 --> 00:01:59,050
.أكيد

12
00:02:07,410 --> 00:02:08,010
.يا إلهي

13
00:02:08,670 --> 00:02:12,010
.هانا-تشان، ستتأخّرين على الفصل

14
00:02:12,850 --> 00:02:14,170
.حسنًا

15
00:02:14,170 --> 00:02:18,370
حاولت إيتشيكي هانا قتل أختها
.سايو مرّات عديدة

16
00:02:18,700 --> 00:02:21,820
،كانت سايو قادرة على صدّ معظم الهجمات

17
00:02:21,820 --> 00:02:25,200
لكنّها أيضًا دخلت المستشفى
.بسبب إصابات بليغة خمس مرّات

18
00:02:25,200 --> 00:02:28,840
لماذا قد تحاول هانا-تشان فعل ذلك بسايو؟

19
00:02:28,840 --> 00:02:30,540
.إنّه تعبير عن الحبّ

20
00:02:30,540 --> 00:02:31,290
ماذا؟

21
00:02:31,290 --> 00:02:35,290
بالنّسبة لها على الأقلّ، الحبّ
.والكره وجهان لنفس العملة

22
00:02:35,290 --> 00:02:39,860
ولسبب ما، المشاعر الّتي قد
تكنّها لشخص تكرهه

23
00:02:39,860 --> 00:02:41,730
.تتحوّل إلى الأشخاص الّذين تحبّهم

24
00:02:40,870 --> 00:02:42,750
!تأهّبي

25
00:02:43,300 --> 00:02:47,440
يبدو أنّ عائلة إيتشيكي لم يكن لديها أيّ
.حيوانات أليفة حتّى بسبب تصرّف هانا

26
00:02:47,440 --> 00:02:49,610
،عندما أتت سايو للأكاديميّة

27
00:02:49,610 --> 00:02:52,950
تمّ تقييم هانا أيضًا كعضوة
.مناسبة لفصل العناصر

28
00:02:53,340 --> 00:02:57,180
قالت الأكاديميّة أنّها ستسمح
،للفتاتين بالانضمام لها

29
00:02:57,180 --> 00:03:00,310
لكنّ والداهما ظنّا أنّه سيكون
.من الأفضل الفصل بين الفتاتين

30
00:03:01,350 --> 00:03:07,060
،عندما غادرت سايو المنزل
.لم يعد لهانا أيّ منفذ لسلوكها

31
00:03:07,060 --> 00:03:09,240
جعلها ذلك تنعزل وبقيت منغلقة
.على نفسها في غرفتها

32
00:03:10,360 --> 00:03:15,240
لذلك السّبب، لدينا مدرّس خاصّ
.لتولّي أمرها طوال الوقت

33
00:03:15,240 --> 00:03:17,810
،عندما اتّصالنا بالعائلة ثانية

34
00:03:17,810 --> 00:03:20,130
.وافقا على إرسال هانا بدون أيّ تردّد

35
00:03:20,410 --> 00:03:23,640
باختصار، كانت هانا مجرّد بديلة
لأختها الّتي ماتت فحسب؟

36
00:03:26,960 --> 00:03:28,180
.ذلك صحيح

37
00:03:34,020 --> 00:03:35,430
ما الّذي تفعله؟

38
00:03:36,130 --> 00:03:39,070
.أعتقد أنّها تحبّني

39
00:03:39,070 --> 00:03:40,040
ماذا؟

40
00:03:43,370 --> 00:03:47,460
إنّ الرّغبة في قتل شخص تحبّه
.لا تبدو منطقيّة لي

41
00:03:47,460 --> 00:03:50,970
.لم تبدُ عواطف الآخرين منطقيّة لي أبدًا

42
00:03:50,970 --> 00:03:53,260
.بل وخاصّة بالنّسبة لي

43
00:03:53,860 --> 00:03:58,050
لا شيء ممّا يتعلّق بالمدرسة
.أو والدَيْ سايو يبدو صائبًا لي

44
00:03:58,650 --> 00:03:59,860
ماذا تعني؟

45
00:04:00,740 --> 00:04:01,980
!لا أدري

46
00:04:05,080 --> 00:04:09,520
أعتقد أنّ موموهيمي-سينباي
.وسان-كُن قد بدآ يتواعدان بالفعل

47
00:04:09,520 --> 00:04:10,390
سان-كُن؟

48
00:04:10,390 --> 00:04:12,100
.ذلك ما يدعوه الجميع

49
00:04:12,100 --> 00:04:12,900
ما اسمه العائليّ؟

50
00:04:12,900 --> 00:04:14,030
.لا يملك واحدًا

51
00:04:14,030 --> 00:04:15,180
.ذلك سخيف

52
00:04:15,180 --> 00:04:17,190
.لكن هنالك بلدان هكذا بالفعل

53
00:04:17,880 --> 00:04:20,800
،لا أدري. إنّ هذا يُزعجني بالفعل

54
00:04:20,800 --> 00:04:23,280
.لكنّي أعتقد أنّهما ثنائيّ جيّد أيضًا

55
00:04:23,510 --> 00:04:24,480
!ماذا؟

56
00:04:25,390 --> 00:04:28,400
.حـ-حسنًا، إنّه خيارها قبل كلّ شيء

57
00:04:30,600 --> 00:04:32,570
ما الّذي أراه أمامي؟

58
00:04:33,360 --> 00:04:34,780
!أقصد هناك

59
00:04:42,250 --> 00:04:44,550
ما الّذي نفعله هنا من الأساس؟

60
00:04:44,550 --> 00:04:48,640
.أتيتُ لأنّي أشعر بالفضول حيالهما
ماذا عنك يا ساكّو؟

61
00:04:49,240 --> 00:04:50,670
...أنا فعلاً لا

62
00:04:51,080 --> 00:04:54,010
أعني، لا يمكننا تركها وحدها، صحيح؟

63
00:04:54,010 --> 00:04:56,060
.يبدو أنّ الفضول يراودك أيضًا

64
00:04:56,060 --> 00:05:01,850
في البداية، وقع الاثنان في الصّحراء
.مثل قطرات ماء صغيرة

65
00:05:02,280 --> 00:05:06,510
تحوّلت مشاعرهما لبعضهما
،إلى أمواج، تتقدّم وتتأخّر

66
00:05:07,120 --> 00:05:09,650
.حتّى صارت شكلاً واحدًا في النّهاية

67
00:05:10,140 --> 00:05:12,450
.كانت تلك بداية الكون

68
00:05:13,170 --> 00:05:15,670
.قصّة من داخل بيضة

69
00:05:16,640 --> 00:05:18,370
ما الّذي يتحدّثان عنه يا ترى؟

70
00:05:18,800 --> 00:05:20,380
.أتساءل بشأن ذلك

71
00:05:20,950 --> 00:05:22,880
.أظنّني سأعود للمنزل فحسب

72
00:05:29,520 --> 00:05:31,090
...يا رفاق

73
00:05:31,660 --> 00:05:34,100
.عليك العودة للمنزل

74
00:05:34,480 --> 00:05:35,640
.نعم

75
00:05:38,590 --> 00:05:40,510
صارت كقطّة مروّضة الآن؟

76
00:05:43,270 --> 00:05:46,570
اسمع. ما غايتك من طلبك من
موموهيمي الخروج معًا وما إلى ذلك؟

77
00:05:46,880 --> 00:05:49,680
،لمعلوماتك، إن كنت تحاول خداعها فحسب

78
00:05:49,680 --> 00:05:51,220
.سأجعلك تندم على ذلك

79
00:05:54,160 --> 00:05:57,170
لماذا تقتلون الوحوش الخرافيّة

80
00:05:57,170 --> 00:05:59,050
مع أنّكم لا تحبّونها من الأساس؟

81
00:06:00,500 --> 00:06:03,080
أنت تعرف بأمر الوحوش الخرافيّة؟

82
00:06:04,150 --> 00:06:06,590
.إنّه مرشّح لفصل العناصر قبل كلّ شيء

83
00:06:06,590 --> 00:06:09,330
لكن لماذا قد نحبّ تلك الوحوش؟

84
00:06:11,580 --> 00:06:15,630
.يشبه هذا الكهف رحم الأمّ

85
00:06:15,630 --> 00:06:16,700
ماذا؟

86
00:06:17,020 --> 00:06:19,330
هل تفهمون غاية هذه الجزيرة؟

87
00:06:20,110 --> 00:06:24,530
هل تعرفون لأيّ غرض يتمّ تربيتكم؟

88
00:06:24,810 --> 00:06:26,450
تربيتنا؟

89
00:06:26,450 --> 00:06:27,800
.تعبير غريب

90
00:06:27,800 --> 00:06:30,530
عمّن تتحدّث؟ المعلّمين؟

91
00:06:31,060 --> 00:06:34,390
.هذا مهد للبيض الّذي ينتظر أن يفقس

92
00:06:34,390 --> 00:06:36,160
إنّهم ينتظرون فقط

93
00:06:37,250 --> 00:06:40,780
.أن يفقس البيض وتخرجوا منه أخيرًا

94
00:06:41,550 --> 00:06:45,110
الوحوش الخرافيّة هي الطُّعم
.لاستدراجكم للخروج

95
00:06:45,110 --> 00:06:48,430
.لا أفهم تمامًا ما تقوله

96
00:06:48,430 --> 00:06:50,960
.أعتقد أنّي بدأت أفهم

97
00:06:52,080 --> 00:06:56,930
صحيح، لكنّ تلك الأشياء تستمرّ
!في مهاجمتنا. علينا هزيمتها

98
00:06:58,210 --> 00:07:01,180
.إن كان ذلك يُمتعك، فما باليد حيلة

99
00:07:02,510 --> 00:07:05,120
.إن كان يؤلمك، فإنّه لا يُغتفر

100
00:07:06,310 --> 00:07:09,850
أيّهما صحيح بالنّسبة لك؟

101
00:07:20,710 --> 00:07:23,440
مهلاً، منذ متى ونحن هنا؟

102
00:07:24,790 --> 00:07:26,890
مهلاً... كلّ هذا الوقت؟

103
00:07:26,890 --> 00:07:28,250
.حوالي ساعة

104
00:07:28,250 --> 00:07:29,490
ماذا؟

105
00:07:30,720 --> 00:07:33,340
ما الّذي تغيّر منذ وصوله؟

106
00:07:33,680 --> 00:07:37,250
لا شيء بعد. لا يوجد أيّ تغيّر
في مستويات مانا التّلاميذ

107
00:07:37,250 --> 00:07:39,970
.ولم نلاحظ أيّ موجات تفاعل وانتشار

108
00:07:40,100 --> 00:07:43,350
هل لديكم أيّ دليل أنّه حقيقيّ؟

109
00:07:44,020 --> 00:07:46,650
.تمّ تأكيد ذلك بواسطة ديفا سلفًا

110
00:07:47,120 --> 00:07:52,240
إنّ وجود المزيد من المستيقظين هو بالضّبط
.ما يريده الأشخاص من مجلس البيضة أيضًا

111
00:07:52,990 --> 00:07:57,250
ألذلك السّبب قرّروا إعارته لكم الآن؟

112
00:07:57,870 --> 00:08:00,070
،مع اقتراب اتّحاد الأكوان

113
00:08:00,070 --> 00:08:04,250
فربّما لا يمكنهم مواصلة الاعتماد
.على مثاليّتهم وحدها

114
00:08:06,870 --> 00:08:10,870
.لننظر إلى النّجوم معًا ونتحدّث عن الكون

115
00:08:11,190 --> 00:08:14,010
.لنتحدّث عن الكون

116
00:08:17,690 --> 00:08:19,900
ما هذا؟

117
00:08:21,950 --> 00:08:23,490
أهذا حقيقيّ؟

118
00:08:26,120 --> 00:08:26,980
ماذا؟

119
00:08:26,980 --> 00:08:28,370
ما الخطب؟

120
00:08:28,370 --> 00:08:30,390
ألا تبدو المدرسة فارغة اليوم؟

121
00:08:30,390 --> 00:08:31,340
أتظنّين ذلك؟

122
00:08:31,980 --> 00:08:34,750
.موموهيمي! ثمّة إعلان

123
00:08:34,750 --> 00:08:35,520
ماذا؟

124
00:08:35,520 --> 00:08:39,030
!إعلان عن عضو العناصر الجديد
.إنّه ذلك التّلميذ المنتقل

125
00:08:43,500 --> 00:08:48,510
هكذا تمّت إعادة كتابة وفاة إيتشيكي سايو
.بقدرة الكون على تصحيح نفسه

126
00:08:48,510 --> 00:08:50,590
.هذه هي الحقيقة الّتي نعرفها

127
00:08:51,230 --> 00:08:52,510
أذلك صحيح؟

128
00:08:53,290 --> 00:08:55,860
ماذا الآن؟

129
00:08:57,500 --> 00:09:00,050
أسترغمون هانا-تشان على قيادة المتّجهة؟

130
00:09:00,050 --> 00:09:03,520
أخبرتكم أنّ إيتشيكي-سان مناسبة تمامًا
.لتكون إحدى العناصر مثل أختها

131
00:09:03,520 --> 00:09:07,030
لكنّي أعلم أنّ سايو ما كانت
!لترغب في تعريض هانا-تشان للخطر

132
00:09:07,030 --> 00:09:08,730
أتعتقدين أنّك حاميتها الآن؟

133
00:09:08,730 --> 00:09:09,600
ماذا؟

134
00:09:09,600 --> 00:09:12,320
.إنّه ليس قرارك، بل قرار إيتشيكي-سان

135
00:09:12,320 --> 00:09:12,760
...لكن

136
00:09:12,760 --> 00:09:15,570
.إيتشيكي-سان، سأمنحك بعض الوقت

137
00:09:15,570 --> 00:09:18,280
.فكّري في الأمر مليًّا قبل اتّخاذ القرار

138
00:09:19,580 --> 00:09:22,320
هل أنت بخير يا هانا-تشان؟

139
00:09:22,980 --> 00:09:26,750
أحببتِ أختك الكبيرة فعلاً، صحيح؟

140
00:09:27,510 --> 00:09:31,880
لذلك ما الّذي ستفعلينه بشأن
كونك من العناصر؟

141
00:09:32,370 --> 00:09:37,610
لستُ واثقة تمامًا، لكنّي
.قد أرغب في تجربة الأمر

142
00:09:37,610 --> 00:09:39,440
!إيّاك يا هانا-تشان

143
00:09:39,440 --> 00:09:43,260
،عندما تكونين في أكويريون
!قد تكونين أيضًا عرضة للموت

144
00:09:43,890 --> 00:09:48,150
.وأنا أعلم أنّ سايو ما كانت لترغب بذلك

145
00:09:49,590 --> 00:09:52,710
.وعدتُ أختي

146
00:09:53,060 --> 00:09:54,140
ماذا؟

147
00:09:55,100 --> 00:09:58,200
.أنا آسفة يا أختي

148
00:09:58,200 --> 00:10:01,520
.أنا أحبّك كثيرًا، كثيرًا بالفعل

149
00:10:01,520 --> 00:10:03,840
...لذلك... أنا أحبّك، لذلك

150
00:10:03,840 --> 00:10:08,130
.أنا أعلم. أنا أحبّك جدًّا أيضًا يا هانا

151
00:10:08,130 --> 00:10:09,370
فعلاً؟

152
00:10:09,370 --> 00:10:10,120
.نعم

153
00:10:11,770 --> 00:10:15,470
أنا أحبّك أكثر من أيّ أحد آخر
.في العالم كلّه يا أختي

154
00:10:15,470 --> 00:10:18,010
.نعم، مفهوم

155
00:10:18,010 --> 00:10:22,100
إذًا هل يمكنك أن تعديني
أنّك لن تقتلي إلاّ أكثر شخص تحبّينه؟

156
00:10:22,100 --> 00:10:23,830
أكثر شخص أحبّه؟

157
00:10:23,830 --> 00:10:26,950
نعم. أنا أكثر شخص تحبّينه، صحيح يا هانا؟

158
00:10:26,950 --> 00:10:28,430
!نعم، إنّه أنت

159
00:10:28,430 --> 00:10:30,880
أكثر من أيّ أحد آخر في العالم؟

160
00:10:30,880 --> 00:10:32,540
!بل وحتّى في الكون

161
00:10:33,770 --> 00:10:35,510
.عديني إذًا

162
00:10:35,510 --> 00:10:41,360
سأسمح لك بقتلي يومًا ما، ولكن حتّى
.ذلك الحين، لا يمكنك قتل أيّ أحد آخر

163
00:10:41,730 --> 00:10:47,250
.نعم. مفهوم، اتّفقنا إذًا
.سأقتل أكثر شخص أحبّه

164
00:10:47,250 --> 00:10:49,950
.وحتّى ذلك الحين، لن أقتل أيّ أحد آخر

165
00:10:50,800 --> 00:10:55,790
.لا بأس. أنت فتاة قويّة يا هانا
.أنا واثقة من ذلك

166
00:10:56,750 --> 00:11:00,090
.لكنّ أختي ماتت

167
00:11:00,090 --> 00:11:04,430
.أكثر شخص أحبّه في العالم تركني

168
00:11:06,190 --> 00:11:10,300
هانا-تشان، هل سبق
وكرهت أحدًا من قبل؟

169
00:11:10,770 --> 00:11:12,280
كرهت؟

170
00:11:12,830 --> 00:11:15,450
.لا أعرف ما معنى الكراهية

171
00:11:16,050 --> 00:11:17,380
.عرفتُ هذا

172
00:11:17,900 --> 00:11:23,370
أعتقد يا هانا-تشان أنّك لا تستطيعين
.كره النّاس لأنّك تفتقرين لتلك العاطفة

173
00:11:23,620 --> 00:11:25,640
الكره؟

174
00:11:25,990 --> 00:11:32,830
لذلك السّبب عندما تحبّين شيئًا
.ما كثيرًا، ترغبين في قتلك

175
00:11:32,830 --> 00:11:34,770
أهذا ما قصدته موناكاتا-سينسي

176
00:11:34,770 --> 00:11:38,320
عندما قالت أنّ الحبّ والكره
وجهان لعملة واحدة؟

177
00:11:38,320 --> 00:11:41,750
عندما يتمّ العبث بذلك التّوازن
،وتكنّ مشاعر مودّة لشخص ما

178
00:11:41,750 --> 00:11:46,010
تُعامل الشّخص الّذي تحبّ
.كشخص تكرهه

179
00:11:46,350 --> 00:11:51,280
.مفهوم. سآخذ مكان سايو

180
00:11:51,680 --> 00:11:55,400
ولكن في المقابل، ليس مسموحًا
.لك قتل أيّ أحد آخر غيري

181
00:11:55,690 --> 00:11:58,150
!موموهيمي-سينباي، أنا أحبّك

182
00:12:06,640 --> 00:12:10,250
هل ستكونان بخير؟
أمن الآمن تركهما وحدهما؟

183
00:12:10,250 --> 00:12:14,200
ما دامت حذرة، فلا أظنّ
.أنّها ستأخذها على حين غرّة

184
00:12:14,200 --> 00:12:18,090
قد تكون محقًّا. والآن، ماذا عن
التّلميذ الآخر في فصل العناصر؟

185
00:12:18,400 --> 00:12:22,360
إنّ ما قاله من قبل يجعل
المرء يتساءل، صحيح؟

186
00:12:22,360 --> 00:12:22,890
ماذا؟

187
00:12:22,890 --> 00:12:26,780
.أقصد ما قاله عن استمتاعنا بذلك وما شابه

188
00:12:26,780 --> 00:12:30,220
صحيح. السّبب الّذي نقاتل لأجله؟

189
00:12:33,970 --> 00:12:35,090
.أنا آسف

190
00:12:54,670 --> 00:12:56,080
هل نذهب؟

191
00:12:56,080 --> 00:12:57,180
.نعم

192
00:12:58,950 --> 00:13:02,760
حسنًا. حان الوقت للذّهاب ومحاولة
.قتل موموهيمي-سينباي ثانية

193
00:13:09,300 --> 00:13:12,300
ماذا؟ ساكّو-سينباي؟

194
00:13:21,140 --> 00:13:23,680
ما الّذي أردت الحديث عنه؟

195
00:13:23,680 --> 00:13:27,080
.الوعد الّذي قطعته مع سايو

196
00:13:27,590 --> 00:13:29,810
إنّ ذلك لا يمنحك سببًا للقتال، صحيح؟

197
00:13:30,710 --> 00:13:35,340
إنّ موموهيمي... كلاّ، أنا أعتقد
.أنّنا سنفعل كلّ ما باستطاعتنا لحمايتك

198
00:13:35,340 --> 00:13:37,680
.سنخاطر بحياتنا لإنقاذك يا هانا

199
00:13:38,620 --> 00:13:40,590
أتوافقين على ذلك؟

200
00:13:40,590 --> 00:13:41,750
...أفهم

201
00:13:42,600 --> 00:13:46,180
،أعني أنّي أفهم ذلك بالفعل داخل رأسي

202
00:13:46,180 --> 00:13:49,630
أفهم أنّه ليس عليّ قتل
.موموهيمي-سينباي أو أيّ شيء آخر

203
00:13:50,260 --> 00:13:52,230
.لكنّي لا أستطيع السّيطرة على مشاعري

204
00:13:52,650 --> 00:13:55,630
.أحبّها كثيرًا لدرجة أنّي أرغب في قتلها

205
00:13:56,030 --> 00:13:57,060
...لكن

206
00:13:57,060 --> 00:13:57,960
لكن ماذا؟

207
00:13:58,340 --> 00:14:02,780
في اللّحظة الّتي أشتبك فيها مع
،موموهيمي-سينباي وأوشك على قتلها

208
00:14:02,780 --> 00:14:04,030
.يمكنني نسيان كل ذلك

209
00:14:04,580 --> 00:14:08,500
،لذلك ربّما إن كنّا في أكويريون معًا

210
00:14:08,500 --> 00:14:11,280
.فربّما ستتوقّف حينها رغبتي في قتلها

211
00:14:12,930 --> 00:14:19,880
انقسمت البيضة لنصفين. صار
.أحدهما فضّة وصار الآخر ذهبًا

212
00:14:20,390 --> 00:14:23,210
.غُمر كون الفضّة بالدّموع

213
00:14:23,210 --> 00:14:25,840
.ولُفّ كون الذّهب باللّهب

214
00:14:26,310 --> 00:14:32,080
صارت الأشياء الموجودة في الدّاخل
.عواطف لا تزال مرتبطة حتّى اليوم

215
00:14:32,080 --> 00:14:33,720
عواطف؟

216
00:14:33,720 --> 00:14:36,680
.تلك هي المانا

217
00:14:37,760 --> 00:14:38,760
مانا؟

218
00:14:41,280 --> 00:14:44,540
.قالت سايو شيئًا قُبيل موتها

219
00:14:46,500 --> 00:14:48,270
.قالت أنّها لم ترد الموت

220
00:14:50,140 --> 00:14:53,390
،لم تعرف أبدًا معنى أن تحبّ نفسها

221
00:14:53,390 --> 00:14:55,850
.لكنّها اكتشفت الأمر في آخر لحظة

222
00:14:56,690 --> 00:14:57,860
...أختي

223
00:14:58,450 --> 00:15:01,610
.ربّما لا يحدث ذلك إلاّ قبل لحظات من الموت

224
00:15:01,610 --> 00:15:06,760
عندما نندمج، أعتقد أنّي أفهم
.معنى الشّعور بالخوف بشكل أفضل

225
00:15:06,760 --> 00:15:08,120
...هل يعني ذلك

226
00:15:09,730 --> 00:15:12,140
،لم أكن واثقًا إن كان عليّ قول هذا

227
00:15:12,140 --> 00:15:17,100
لكنّي سعيد للغاية لأنّه تسنّى لي
.الاندماج مع سايو

228
00:15:21,210 --> 00:15:25,310
.ساكّو-سينباي، اتّخذت قراري

229
00:15:25,310 --> 00:15:28,700
.وكذلك أنا. أشعر بتحسّن الآن
.شكرًا جزيلاً

230
00:15:28,700 --> 00:15:30,090
.هذا من دواعي سروري

231
00:15:32,020 --> 00:15:33,420
،ساكّو-سينباي

232
00:15:34,120 --> 00:15:37,960
أعتقد أنّي أحبّك أكثر لدرجة
.أنّي أكاد أرغب في قتلك

233
00:15:41,800 --> 00:15:44,310
أمن المفترض أن يُسعدني ذلك؟

234
00:15:47,870 --> 00:15:49,090
.سينسي

235
00:15:50,050 --> 00:15:51,820
.اتّخذتُ قراري

236
00:15:52,570 --> 00:15:53,500
.فهمت

237
00:15:54,910 --> 00:15:55,950
ماذا هنالك؟

238
00:15:57,090 --> 00:15:58,100
.لديّ جواب الآن

239
00:15:58,100 --> 00:16:01,710
.عن سبب قتالي

240
00:16:01,710 --> 00:16:03,770
.أنا أشعر أكثر أنّي كامل عندما أكون معهم

241
00:16:04,320 --> 00:16:05,820
.لوهلة على الأقلّ

242
00:16:07,620 --> 00:16:12,620
عندما أندمج معهم، أشعر وكأنّي
.عثرت على شيء أفتقر له

243
00:16:30,400 --> 00:16:31,500
...مومو-ني

244
00:16:31,830 --> 00:16:32,980
ماذا؟

245
00:16:33,780 --> 00:16:35,380
!موموهيمي-سينباي

246
00:16:40,220 --> 00:16:41,260
!مومو-ني

247
00:16:41,680 --> 00:16:42,910
!موموهيمي-سينباي

248
00:16:43,350 --> 00:16:44,810
!ردّي عليّ يا موموهيمي

249
00:16:59,810 --> 00:17:03,840
إنّه موجود في يوغاوارا. ذلك ضمن
.مجال 15 كيلومترًا للوتد الأخير

250
00:17:03,840 --> 00:17:07,730
هذا سيّئ! صدّوه بالطّائرات المسيّرة
!حتّى يستطيع العناصر الانطلاق

251
00:17:07,730 --> 00:17:11,090
،إنّه له شكلاً يشبه آخر واحد
.لكنّه كائن مختلف

252
00:17:11,090 --> 00:17:16,020
،هذا يعني أنّه حتّى إن هزمناه
فإنّ آخر وتد لن يختفي؟

253
00:17:16,020 --> 00:17:18,600
.يا أطفال، ظهر وحش خرافيّ

254
00:17:18,600 --> 00:17:21,260
.إيتشيكي-سان متأهّبة
!احضروا جميعًا في الحال

255
00:17:21,260 --> 00:17:24,970
اذهبا. سآخذ موموهيمي-سينباي
.إلى المستوصف

256
00:17:24,970 --> 00:17:25,910
...حسنًا، ولكن

257
00:17:25,910 --> 00:17:28,320
.لا بأس. لنذهب يا ساكّو

258
00:17:28,320 --> 00:17:29,070
...توشي

259
00:17:29,280 --> 00:17:32,710
إن لم نذهب الآن، فقد يموت
!المزيد من الأشخاص

260
00:17:33,250 --> 00:17:35,960
.لا بأس. اعتن بها يا ريميا

261
00:17:35,960 --> 00:17:36,660
.نعم

262
00:17:46,260 --> 00:17:48,710
ألم ينطلق العناصر بعد؟

263
00:17:48,710 --> 00:17:50,390
.لقد وصلوا. ابدأ الإطلاق

264
00:17:50,390 --> 00:17:51,420
.عُلم

265
00:17:51,630 --> 00:17:54,000
!إطلاق جميع وحدات آلات المتّجهات

266
00:17:54,870 --> 00:17:58,270
هذا الوحش مزوّد بأسلحة دوّارة
.ومرنة مثل الوحش الخرافيّ الأخير

267
00:17:58,270 --> 00:18:01,190
.ستكون المتّجهة تير هي الرّأس
.هاتانو توشي-كُن

268
00:18:01,460 --> 00:18:03,480
.حسنًا. سأقوم بذلك

269
00:18:04,650 --> 00:18:07,660
!اندماج النّجوم الخرافيّ
!انطلق يا أكويريون

270
00:18:19,050 --> 00:18:22,140
إذًا فهذا هو الاندماج؟

271
00:18:22,640 --> 00:18:25,420
!هـ-هذا رائع

272
00:18:26,160 --> 00:18:28,140
!أكويريون تير

273
00:18:46,980 --> 00:18:49,820
!كنّا قادرين على الإمساك بآخر واحد

274
00:19:20,980 --> 00:19:23,050
.سأقتلكم الآن

275
00:19:28,220 --> 00:19:29,330
!لا، لن تفعل

276
00:19:33,890 --> 00:19:35,390
!لا تسمحوا له بزرع الوتد

277
00:19:35,390 --> 00:19:36,360
!حاضر

278
00:19:44,380 --> 00:19:45,850
!علينا النّيل منه الآن

279
00:19:49,950 --> 00:19:55,450
ما-ما هذا؟ هل فقدت
موموهيمي-سينباي وعيها؟

280
00:19:55,450 --> 00:19:56,790
!موموهيمي-سينباي

281
00:20:02,260 --> 00:20:03,270
!هانا-تشان؟

282
00:20:04,160 --> 00:20:07,730
ما الخطب؟ صار مقياس مانا
!إيتشيكي-سان غير متوازن

283
00:20:13,320 --> 00:20:14,060
!هانا

284
00:20:14,060 --> 00:20:15,190
!هانا-تشان

285
00:20:15,190 --> 00:20:16,400
.إنّها المتّجهة فيو

286
00:20:23,830 --> 00:20:25,030
!هانا-تشان

287
00:20:25,030 --> 00:20:25,820
!هانا

288
00:20:27,820 --> 00:20:29,770
!إنّها في طريقها للمدينة

289
00:20:33,280 --> 00:20:34,700
!عودي لرشدك

290
00:20:36,920 --> 00:20:41,310
.لا بأس. أنت فتاة قويّة يا هانا
.أنا واثقة من ذلك

291
00:20:42,860 --> 00:20:45,900
...أختي، موموهيمي-سينباي

292
00:20:46,480 --> 00:20:49,690
ألا تقاتلين من أجل سايو وموموهيمي؟

293
00:20:49,950 --> 00:20:51,450
.أريد حمايتهما أيضًا

294
00:20:51,800 --> 00:20:54,260
!لذلك أعيريني قوّتك

295
00:21:00,990 --> 00:21:04,030
.ستكونين بخير يا هانا. أنت لها

296
00:21:04,030 --> 00:21:05,410
!هانا-تشان

297
00:21:05,410 --> 00:21:08,580
.توشي-سينباي. ساكّو-سينباي

298
00:21:08,940 --> 00:21:09,790
!حسنًا

299
00:21:10,440 --> 00:21:12,490
!هذه فرصتكم! اندمجوا

300
00:21:12,750 --> 00:21:14,180
!عُلم

301
00:21:14,180 --> 00:21:17,580
!اندماج النّجوم الخرافيّ
!انطلق يا أكويريون

302
00:21:27,350 --> 00:21:31,020
هذا ساخن جدًّا. أمصدره هانا-تشان؟

303
00:21:31,020 --> 00:21:31,830
.نعم

304
00:21:32,210 --> 00:21:34,600
!أشعر بذلك أيضًا. هانا

305
00:21:37,410 --> 00:21:38,890
...لا بدّ أنّه

306
00:21:39,430 --> 00:21:43,240
!لهبُ أكويريون سيغل الأحمر

307
00:21:43,240 --> 00:21:48,060
!أكويريون! عناقُ حبِّ هجومِ الشّمس