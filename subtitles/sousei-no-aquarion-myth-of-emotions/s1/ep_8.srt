1
00:01:37,860 --> 00:01:39,510
.سمعتُ عن الأمر بالكامل يا ساكّو

2
00:01:39,510 --> 00:01:40,980
أنت تحبّه الآن، صحيح؟

3
00:01:41,670 --> 00:01:44,660
سأدعمك. اترك كلّ شيء لأختك
.الكبيرة فحسب

4
00:01:44,660 --> 00:01:46,270
...كـ-كلاّ، مهلاً

5
00:01:46,270 --> 00:01:48,010
تريد أن تتعرّف إليه أكثر، صحيح؟

6
00:01:48,010 --> 00:01:49,590
!ا-الأمر ليس كذلك

7
00:01:49,590 --> 00:01:51,120
كيف هو إذًا؟

8
00:01:51,120 --> 00:01:52,790
...من الصّعب شرح

9
00:01:55,670 --> 00:01:57,050
.الأمر

10
00:01:57,590 --> 00:02:00,700
.لا بأس، لا بأس! أفهم الأمر برمّته

11
00:02:01,400 --> 00:02:03,630
!يورا! صباح الخير

12
00:02:04,850 --> 00:02:06,900
.لا تفهمين الأمر على الإطلاق

13
00:02:08,100 --> 00:02:09,730
.صباح الخير يا مومو

14
00:02:09,730 --> 00:02:11,240
هل رأيت هذا؟

15
00:02:20,270 --> 00:02:21,480
ماذا حدث؟

16
00:02:25,130 --> 00:02:29,360
إذًا فلم يتمّ تصحيح معركتنا؟

17
00:02:29,360 --> 00:02:30,910
لكن لماذا؟

18
00:02:31,130 --> 00:02:33,870
هل يعني هذا أنّ قدرة الكون
،على تصحيح نفسه

19
00:02:33,870 --> 00:02:38,030
الّتي كانت موجّهة نحو حذف
،تأثير الفضاء الخرافيّ حتّى الآن

20
00:02:38,030 --> 00:02:39,920
صارت تعمل بشكل معاكس؟

21
00:02:39,920 --> 00:02:43,120
.إنّه تأثير تآزريّ بين الوتدين

22
00:02:43,120 --> 00:02:47,740
يحدّد اتّجاه تصحيح الكون لنفسه
.ما الكون الّذي له الأسبقيّة

23
00:02:47,740 --> 00:02:52,030
ببساطة وعلى هذا المعدّل، سيفوز
.الكون الآخر وسنُحذف بالكامل

24
00:02:52,480 --> 00:02:55,390
.إيتشيكي هانا-سان، هذه غلطتك

25
00:02:55,390 --> 00:02:57,380
.سينسي، لا تقولي هذا

26
00:02:57,380 --> 00:03:00,820
.إنّها غلطتنا أيضًا لأنّنا فصلنا الاندماج

27
00:03:00,820 --> 00:03:04,860
."سمعتُ صوتًا يقول، "اقتلوني

28
00:03:05,550 --> 00:03:09,280
هذا يعني أنّنا كنّا نقتلهم، صحيح؟
نقتل الأشخاص من الفضاء الخرافيّ؟

29
00:03:10,170 --> 00:03:14,340
الوحوش الخرافيّة ليست شكلَ
.حياةٍ ذكيّ تحتاجين للاهتمام بأمره

30
00:03:14,340 --> 00:03:18,880
تذكر ألواح ناكال أنّ الوحوش الخرافيّة
.هي وحوش مُنحت الحياة من طرف الإله

31
00:03:19,110 --> 00:03:20,790
.إنّها وحوش ضخمة لا غير

32
00:03:20,790 --> 00:03:23,140
.لكنّي سمعته يتكلّم

33
00:03:23,140 --> 00:03:27,430
لا بدّ أنّ تلك كانت رسالة أرسلها
.ملائكة الظّلال من الفضاء الخرافيّ

34
00:03:27,430 --> 00:03:29,610
.كان الغرض منها إرباكك

35
00:03:29,940 --> 00:03:33,100
.سبق وأرسلوا لنا عدّة صور حتّى الآن

36
00:03:33,100 --> 00:03:36,650
على أيّ حال، لا يجب السّماح لهم
.بزرع المزيد من الأوتاد

37
00:03:36,890 --> 00:03:39,490
.إن تركوا واحدًا آخر، فستحلّ كارثة

38
00:03:39,490 --> 00:03:41,560
.عودوا للتّدريب جميعًا

39
00:03:42,070 --> 00:03:45,120
.لا. أنا أنسحب

40
00:03:46,050 --> 00:03:46,850
.لا بأس

41
00:03:50,470 --> 00:03:51,810
...هانا-تشان

42
00:03:56,770 --> 00:04:01,720
،قد يُدمَّر هذا الكون بأكمله بسببي
أليس كذلك؟

43
00:04:02,090 --> 00:04:05,760
لكنّ تلك عدالة أيضًا، صحيح؟

44
00:04:06,570 --> 00:04:11,040
وحدهم من استيقظوا وفتحوا أعينهم
.للحقيقة بإمكانهم الوصول للعدالة

45
00:04:11,040 --> 00:04:13,830
ماذا؟ فتحوا أعينهم؟

46
00:04:15,410 --> 00:04:20,230
.أذكر الوقت الّذي استيقظتُ فيه

47
00:04:30,340 --> 00:04:34,110
.الفضاء، الاندماج، الإبادة

48
00:04:34,440 --> 00:04:37,970
.استمرّت تلك الكلمات بالتّردّد في رأسي

49
00:04:38,280 --> 00:04:42,270
.لكن تمّ جعل الحادثة تبدو كهجوم عشوائيّ

50
00:04:42,940 --> 00:04:45,510
.حتّى ذكرى زوجتي عن الأمر قد مُحيت

51
00:04:47,310 --> 00:04:51,700
.الفضاء، الاندماج، الإبادة

52
00:04:52,570 --> 00:04:56,410
،وبينما واصلتُ البحث عن أجوبة
.خسرتُ عملي

53
00:04:56,410 --> 00:04:58,390
.ثمّ تركتني زوجتي وابنتي

54
00:04:58,750 --> 00:05:00,590
.لا بدّ أنّ ذلك كان صعبًا

55
00:05:09,910 --> 00:05:10,530
ما هذا؟

56
00:05:12,930 --> 00:05:17,460
لماذا قرّرت هانا الانسحاب فجأة؟

57
00:05:17,460 --> 00:05:20,830
قالت أنّها ما كانت لتستطيع
.قتل شخص لا تحبّ من الأساس

58
00:05:21,390 --> 00:05:24,420
.ذلك ما قاله سان تمامًا

59
00:05:24,870 --> 00:05:27,850
لماذا تقتلون شيئًا مع أنّكم"
"لا تحبّونه من الأساس؟

60
00:05:28,710 --> 00:05:30,160
سان-كُن قال ذلك؟

61
00:05:30,750 --> 00:05:34,640
أكره الطّريقة الّتي يتصرّف بها
.دائمًا وكأنّه يعرف كلّ شيء

62
00:05:34,640 --> 00:05:36,470
لكنّك تحبّه بالفعل، صحيح؟

63
00:05:37,690 --> 00:05:40,850
أعتقد أنّي أفهم ما قلته من قبل
.بخصوص الحدس

64
00:05:42,370 --> 00:05:44,210
.بخصوص أنّه ليس شخصًا سيّئًا

65
00:05:45,670 --> 00:05:46,850
فعلاً؟

66
00:05:47,330 --> 00:05:49,140
.مرحبًا. لقد أتيت

67
00:05:52,350 --> 00:05:53,750
ما-ما الّذي يحدث؟

68
00:05:53,750 --> 00:05:56,740
هيّا. تريد الحديث معه، صحيح؟

69
00:06:00,060 --> 00:06:02,110
ما الّذي أفعله؟

70
00:06:02,660 --> 00:06:06,830
،اسمع يا سان-كُن
!إنّ صديقي هذا يحبّك

71
00:06:06,830 --> 00:06:08,820
!ما-ماذا؟ مهلاً

72
00:06:08,000 --> 00:06:10,430
.لا داعي للخجل! لا بأس بالأمر

73
00:06:10,430 --> 00:06:12,020
.هيّا، قل شيئًا ما له

74
00:06:12,430 --> 00:06:14,650
لماذا قد أشعر بالإحراج؟

75
00:06:16,480 --> 00:06:19,820
أخبرني، هل كنتُ داخل المانا
خاصّتي وقتها؟

76
00:06:20,770 --> 00:06:26,860
لطالما ظننتُ أنّي تسبّبت بمقتل سايو
.لأنّي لم أستطع الشّعور بالخوف

77
00:06:27,230 --> 00:06:31,300
.لكنّها شعرت بالخوف بدلاً منّي بالفعل

78
00:06:32,700 --> 00:06:35,210
هل كنتَ تُظهر نفس الشّيء للجميع؟

79
00:06:35,620 --> 00:06:41,710
لم أفعل أيّ شيء. كلّ ما فعلتُ
.هو الإشارة لاتّجاه المانا

80
00:06:41,710 --> 00:06:45,800
بمجرّد أن يتعرّف الجميع على
.المانا خاصّتهم، يستيقظون

81
00:06:46,240 --> 00:06:47,710
.ذلك كلّ ما في الأمر

82
00:06:47,710 --> 00:06:49,860
يتعرّفون على المانا خاصّتهم؟

83
00:06:50,710 --> 00:06:51,870
.خذي هذه

84
00:06:56,850 --> 00:06:58,660
.عليكما الحضور معًا

85
00:07:03,360 --> 00:07:07,310
إنّنا نخسر القتال وهانا إيتشيكي
.قد استسلمت أيضًا

86
00:07:07,310 --> 00:07:08,230
.لا يوجد أمل

87
00:07:08,460 --> 00:07:10,090
.أنا أعتذر بشدّة

88
00:07:10,460 --> 00:07:15,030
.لكن ما زالت هنالك بعض الأخبار الجيّدة
.بدأ التّلاميذ يستيقظون

89
00:07:15,030 --> 00:07:17,450
.اسمعوا. أكاديميّة إينوشيما ليست الوحيدة

90
00:07:17,450 --> 00:07:20,410
إنّ قيم المانا ترتفع في مدارس
.العناصر حول العالم

91
00:07:20,830 --> 00:07:23,500
يتمّ نقل المانا في دوّامة؟

92
00:07:23,500 --> 00:07:25,180
.إنّها تتجاوب

93
00:07:25,180 --> 00:07:30,000
بدأت الأكاديميّة بتحرير قوّتها
!كمجالِ تشكّلٍ حيويّ

94
00:07:30,000 --> 00:07:31,010
.إنّها مراسم

95
00:07:31,550 --> 00:07:32,640
مراسم؟

96
00:07:32,640 --> 00:07:37,970
من المفاجئ بالتّأكيد أن يضع التّلاميذ
.مراسم ليبدؤوا بالاستيقاظ وحدهم

97
00:07:37,970 --> 00:07:40,430
لكن قد يكون شكلاً من
.أشكال الاقتراح التّلقائيّ

98
00:07:40,430 --> 00:07:43,820
.بغضّ النّظر، استيقاظهم بدأ بالفعل

99
00:07:43,820 --> 00:07:46,650
إن كانوا قادرين على استعماله
،لمصلحتهم في المعارك

100
00:07:46,650 --> 00:07:50,610
فستكون استعادة مناطقنا
.المفقودة أمرًا بسيطًا

101
00:07:50,990 --> 00:07:55,620
سيؤدّي هذا إلى التّخلّص من الحاجة
.لفحص النّاس لصعود هاكوبوني

102
00:07:56,220 --> 00:08:00,620
لا داعي للقلق. لدينا تذاكر بما
.يكفي لكم ولعائلاتكم

103
00:08:01,000 --> 00:08:02,750
.شكرًا جزيلاً لك

104
00:08:05,100 --> 00:08:06,840
.انقسمت البيضة لنصفين

105
00:08:06,840 --> 00:08:10,330
.صار أحدهما فضّة وصار الآخر ذهبًا

106
00:08:10,330 --> 00:08:14,790
صارت الأشياء الموجودة في الدّاخل
!عواطف لا تزال مرتبطة حتّى اليوم

107
00:08:14,790 --> 00:08:18,830
.كانت تلك بداية الكون
.قصّة من داخل بيضة

108
00:08:18,830 --> 00:08:20,080
ما كان ذلك؟

109
00:08:20,080 --> 00:08:21,180
.لا أدري

110
00:08:21,530 --> 00:08:22,570
!لنكتشف الأمر

111
00:08:22,570 --> 00:08:24,600
ماذا؟ ريميا-كُن؟

112
00:08:28,260 --> 00:08:31,380
.لم نخرج معًا هكذا منذ المدرسة الابتدائيّة

113
00:08:31,380 --> 00:08:33,300
.نسيت كلّ ذلك

114
00:08:34,590 --> 00:08:35,870
!هذا مذهل

115
00:08:35,870 --> 00:08:39,270
!انظر يا ساكّو! المحيط يلمع

116
00:08:39,270 --> 00:08:42,020
.نرى ذلك طوال الوقت

117
00:08:43,370 --> 00:08:46,380
!عجبًا! إنّها سفينة ضخمة

118
00:08:46,380 --> 00:08:47,810
هل أنت طفلة؟

119
00:08:52,750 --> 00:08:56,900
!عجبًا! إنّه المحيط يا كاميساما

120
00:08:56,900 --> 00:08:59,550
.فضاء، اندماج، إبادة

121
00:08:59,550 --> 00:09:01,700
...فضاء، اندماج

122
00:09:08,340 --> 00:09:09,640
!هذا مذهل

123
00:09:11,800 --> 00:09:13,140
!هيّا، هيّا

124
00:09:18,490 --> 00:09:19,710
!سان-كُن

125
00:09:21,620 --> 00:09:23,380
.مرحبًا. لقد وصلتما

126
00:09:23,630 --> 00:09:26,150
.مرحبًا بكما في مجلس بيضة الفضاء

127
00:09:26,150 --> 00:09:27,380
!سررت بلقائك

128
00:09:27,380 --> 00:09:29,940
ما الّذي نفعله هنا على أيّ حال؟

129
00:09:41,220 --> 00:09:43,930
ألا يشعر المرء بالارتياح عندما
يفعل شيئًا مفيدًا؟

130
00:09:44,140 --> 00:09:45,360
!نعم

131
00:09:45,360 --> 00:09:47,940
.إنّ فعل الخير يزيد من المانا

132
00:09:48,690 --> 00:09:50,590
.ذلك ما علّمني إيّاه سان

133
00:09:51,470 --> 00:09:52,780
!هذا أنت

134
00:09:53,660 --> 00:09:54,930
يا عزيزي؟

135
00:09:55,560 --> 00:09:56,280
.نعم

136
00:09:56,280 --> 00:09:59,280
.أنا مسرورة لأنّك عدت لعائلتك

137
00:10:03,740 --> 00:10:07,980
.انظر! إنّهما موموهيمي-سينباي وساكّو-سينباي

138
00:10:10,450 --> 00:10:12,590
!يا له من شعور رائع

139
00:10:13,560 --> 00:10:15,640
ما علاقتك بهؤلاء الأشخاص؟

140
00:10:15,980 --> 00:10:18,640
.إنّهم الأشخاص الّذين ربّوني

141
00:10:18,640 --> 00:10:20,380
ماذا؟ ربّوك؟

142
00:10:20,660 --> 00:10:23,140
.وُلدتُ من بيضة

143
00:10:23,140 --> 00:10:25,100
أقلت بيضة؟

144
00:10:25,760 --> 00:10:28,890
.في القارّة، في منشأة في قلب الصّحراء

145
00:10:29,450 --> 00:10:32,160
.كانت تسمّى البيضة المقدّسة

146
00:10:32,920 --> 00:10:38,040
.ربّاني أشخاص يرتدون معاطف مختبر
.لم يكن لديّ والدان حقيقيّان

147
00:10:38,390 --> 00:10:41,440
لذلك السّبب لا أملك اسمًا
.عائليًّا. أنا سان فقط

148
00:10:43,030 --> 00:10:44,870
ماذا تقصد بمنشأة في القارّة؟

149
00:10:45,540 --> 00:10:48,640
.إنّها منشأة اختبارات لمجلس صحوة العالم

150
00:10:49,080 --> 00:10:51,950
مجلس صحوة العالم؟

151
00:10:52,700 --> 00:10:56,600
الأشخاص الّذين سيطروا على
التّاريخ من الظّلّ وحكموا البشريّة

152
00:10:56,600 --> 00:10:58,680
.لمئات السّنين

153
00:10:58,680 --> 00:11:00,920
.صار هذا غريبًا نوعًا ما

154
00:11:01,160 --> 00:11:03,730
.وقد كنتُ عضوة في تلك المنظّمة

155
00:11:07,700 --> 00:11:09,940
عمّ يتحدّثون في رأيك؟

156
00:11:09,940 --> 00:11:11,790
.لا بدّ أنّه هو

157
00:11:11,790 --> 00:11:12,430
ماذا؟

158
00:11:13,380 --> 00:11:20,650
كانت المنشأة تقوم بتجارب
،لتربية طفل بقدرات خاصّة

159
00:11:20,950 --> 00:11:24,970
.أو ما قد تسمّونه قوى استثنائيّة، طفل خارق

160
00:11:25,400 --> 00:11:31,040
لكنّ هدفهم كان إنشاء منقذ
.بشكل اصطناعيّ

161
00:11:32,180 --> 00:11:35,750
وذلك المنقذ هو سان-كُن؟

162
00:11:35,750 --> 00:11:38,580
.ثمّة آخرون كثيرون من قبله

163
00:11:38,580 --> 00:11:41,640
،لكن كانوا جميعًا تجارب فاشلة
.لذلك تمّ التّخلّص منهم

164
00:11:42,360 --> 00:11:43,990
...تجارب فاشلة

165
00:11:45,080 --> 00:11:50,390
كان مهد حجر النّجوم الخرافيّ
.متّصلاً بكلّ المانا في العالم

166
00:11:50,390 --> 00:11:54,490
أدّى ذلك في النّهاية إلى ظهور
.التّشابك الكمّيّ

167
00:11:54,490 --> 00:11:56,860
.جسيمات أوّليّة عبارة عن أوتار مهتزّة

168
00:11:57,460 --> 00:12:00,230
قابلتُ هؤلاء الأشخاص داخل أحلام
.مرتبطة بعوالم أخرى

169
00:12:00,230 --> 00:12:04,210
.هناك قابلتكم أيضًا

170
00:12:04,490 --> 00:12:08,740
.مهلاً، أنا أصغر منك بسنة
.لم أكن قد وُلدت عند حدوث ذلك

171
00:12:08,740 --> 00:12:12,350
ما زلت أشعر وكأنّي في حلم الآن
.وداخل المهد

172
00:12:12,760 --> 00:12:18,470
.وجميعكم جزء من الحلم الّذي أحلم به

173
00:12:18,470 --> 00:12:19,960
ماذا يفترض أن يعنيه ذلك؟

174
00:12:27,430 --> 00:12:29,350
.تلك أمنيتي

175
00:12:31,680 --> 00:12:32,890
...سان-كُن

176
00:12:35,350 --> 00:12:38,620
إذًا يتمّ استغلال سان
.من طرف الرّاشدين أيضًا

177
00:12:39,240 --> 00:12:41,430
.نعم، مثلنا نحن

178
00:12:41,730 --> 00:12:48,960
،تمرّدنا على تجاربهم اللاّإنسانية
.ثمّ أخذنا سان وهربنا

179
00:12:49,250 --> 00:12:53,750
ثمّ شكّلنا هذه المجموعة
.ونحن نقاتلهم مذّاك الحين

180
00:12:53,750 --> 00:12:56,610
لماذا انتهى بك المطاف
في أكاديميّة إينوشيما إذًا؟

181
00:12:57,090 --> 00:13:00,860
.كانت تلك أمنية سان

182
00:13:03,090 --> 00:13:05,580
.بهدف إيقاظ الجميع

183
00:13:05,580 --> 00:13:08,610
.وأيضًا... للقائك

184
00:13:10,350 --> 00:13:15,350
قطعتُ وعدًا لك منذ زمن بعيد
.بأنّنا سنصير واحدًا

185
00:13:17,900 --> 00:13:21,160
!آسفة يا ساكّو! لا داعي للقلق
.الأمر ليس كذلك بيننا

186
00:13:21,160 --> 00:13:22,490
ولماذا قد أهتمّ؟

187
00:13:24,600 --> 00:13:27,270
سان-كُن، هلاّ أخبرتني بقصّة؟

188
00:13:29,320 --> 00:13:34,240
.لا مجال للشّكّ. ذلك طفل البيضة المقدّسة

189
00:13:34,660 --> 00:13:36,570
طفل البيضة؟

190
00:13:37,320 --> 00:13:43,010
بيضة تطفو وحيدة فوق المحيط
.الّذي بلا محيط بعد

191
00:13:47,040 --> 00:13:48,530
هل رأيتم توشي؟

192
00:13:48,530 --> 00:13:49,720
.إنّه في المدرسة

193
00:13:49,720 --> 00:13:51,620
.ماذا؟ لكن لا دروس لنا اليوم

194
00:13:51,970 --> 00:13:54,060
.إنّه يقوم بالمراسم اليوم

195
00:13:54,720 --> 00:14:01,090
كان موطنًا للأشخاص المجنّحين الّذين
.عاشوا حياتهم بتشابك مع المانا

196
00:14:01,090 --> 00:14:08,640
غذّى سوما، عمود ضخم رقدت فيه
.الإلهة، كلّ الكائنات الحيّة هناك

197
00:14:09,560 --> 00:14:13,190
.كان شكلُ الإلهة الحقيقيّ أفعى ضخمة

198
00:14:13,750 --> 00:14:19,210
ومن وقت لآخر، كانت الأفعى المتقلّبة
.تترك سوما ليذبل لتعذيب النّاس

199
00:14:19,590 --> 00:14:23,090
أيّها المستيقظ الّذي يجلب
،الخلاص لأولئك الّذين بلا أجنحة

200
00:14:23,090 --> 00:14:23,910
.تقدّم

201
00:14:31,020 --> 00:14:32,870
.هذه أجنحتك

202
00:14:35,690 --> 00:14:40,490
عندما دخل الرّجل الكهف
،في طريقها للقضاء على الأفعى

203
00:14:41,020 --> 00:14:46,570
أُعجبت الإلهة بشجاعة الرّجل
.وظهرت له بشكل امرأة

204
00:14:47,240 --> 00:14:51,950
.مارس الاثنان الحبّ وأنجبت الإلهة فتاة

205
00:14:53,340 --> 00:14:54,450
توشي؟

206
00:14:54,740 --> 00:14:58,140
!انتزع جناحيك المدنّسين وطّهر المانا خاصّتك

207
00:15:33,820 --> 00:15:35,870
سنعقد الآن المراسم

208
00:15:35,870 --> 00:15:39,280
لانتزاع الأجنحة المدنّسة لابنة
.راهب القمر سيدونا

209
00:15:40,000 --> 00:15:43,310
.إنّنا ندعو أن تكون هذه آخر تضحية

210
00:15:44,400 --> 00:15:46,180
...ستُنتزع أجنحتها

211
00:15:46,500 --> 00:15:47,520
.هذا مخيف

212
00:15:52,210 --> 00:15:53,600
!سيدونا

213
00:15:54,190 --> 00:15:56,190
.جيّد. باشروا

214
00:16:20,840 --> 00:16:26,400
!أختي! أختي

215
00:16:41,230 --> 00:16:42,410
...توشي

216
00:16:50,820 --> 00:16:53,790
ما كان ذلك؟

217
00:17:00,890 --> 00:17:02,990
ما كان ذلك الشّيء؟

218
00:17:03,280 --> 00:17:06,920
.لقد... انتُزعت أجنحتي

219
00:17:07,400 --> 00:17:10,080
.وأنا وقفت هناك فحسب. أشاهد

220
00:17:23,470 --> 00:17:25,950
مهلاً. كاميساما؟

221
00:17:33,880 --> 00:17:36,110
تشكّل صدع فوق المحيط
!على بعد كيلومترين من أوداوارا

222
00:17:36,540 --> 00:17:39,130
!استدعوا العناصر في الحال

223
00:17:39,840 --> 00:17:40,700
ماذا؟

224
00:17:43,490 --> 00:17:44,450
.إنّه وحش خرافيّ

225
00:17:44,450 --> 00:17:46,450
في أوداوارا؟

226
00:17:53,820 --> 00:17:56,350
.يؤلمني ظهري كثيرًا

227
00:17:56,350 --> 00:17:57,300
...توشي

228
00:17:59,650 --> 00:18:03,540
.سأكون بخير. عليك الذّهاب يا ريميا-كُن

229
00:18:20,120 --> 00:18:22,700
!ظهر وحش خرافيّ

230
00:18:27,100 --> 00:18:29,480
.آلات المتّجهات، استعداد للانطلاق

231
00:18:29,850 --> 00:18:32,240
.إلى كلّ الوحدات، ابدؤوا تسلسل الإطلاق

232
00:18:32,660 --> 00:18:35,630
.جسر المجنقة، تفعيل تسلسل الإطلاق

233
00:18:36,040 --> 00:18:37,330
.تحرير الجسر

234
00:18:37,780 --> 00:18:39,880
.إطلاق المتّجهة سيغل

235
00:18:41,730 --> 00:18:45,990
.كهف إيوايا، البدء بتسلسل الإطلاق
.الدّفع بأقصى طاقة

236
00:18:45,990 --> 00:18:47,930
.إطلاق المتّجهة تير

237
00:18:52,360 --> 00:18:55,060
.ميناء اليخوت، بدء تسلسل الإطلاق

238
00:18:55,440 --> 00:18:57,780
.الاستعداد للإطلاق. الدّفع بأقصى طاقة

239
00:18:58,200 --> 00:19:00,030
.إطلاق المتّجهة فيو

240
00:19:09,540 --> 00:19:12,470
!ساكّو، أختي موموهيمي، اركبا

241
00:19:18,690 --> 00:19:21,550
ما الّذي كنتما تفعلانه هنا في أوداوارا؟

242
00:19:21,550 --> 00:19:22,710
...كنّا

243
00:19:22,710 --> 00:19:25,300
!هذا ليس مهمًّا
!علينا إيقاف الوحش الخرافيّ

244
00:19:25,300 --> 00:19:28,220
.هذان الاثنان في حالة ممتازة

245
00:19:28,220 --> 00:19:32,850
نعم. وصلت قيم المانا خاصّته
.لمستوى المعركة. بإمكانهم الاندماج

246
00:19:33,210 --> 00:19:34,990
!اسمعوا، حان وقت الاندماج

247
00:19:35,280 --> 00:19:38,460
!اندماج النّجوم الخرافيّ
!انطلق يا أكويريون

248
00:19:41,870 --> 00:19:44,690
!يقترب الوحش الخرافيّ لوضع وتد آخر

249
00:19:44,690 --> 00:19:46,570
!لا تدعوه يقترب من المدينة

250
00:19:47,410 --> 00:19:49,220
!لنقم بهذا يا رفاق

251
00:20:11,680 --> 00:20:12,650
!كلاّ

252
00:20:20,330 --> 00:20:21,280
!علينا إيقافه

253
00:20:21,280 --> 00:20:23,740
!لا! يوجد أشخاص أسفلنا

254
00:20:27,970 --> 00:20:29,870
!انتبها! تفادياه

255
00:20:39,370 --> 00:20:41,920
.سأقتلكم جميعًا

256
00:20:42,140 --> 00:20:43,470
!لقد تكلّم

257
00:20:47,270 --> 00:20:48,980
!موموهيمي-سينباي

258
00:20:56,770 --> 00:20:59,690
تسمّي نفسك محاربًا حقيقيًّا؟

259
00:20:59,930 --> 00:21:01,050
ما الّذي يفعله؟

260
00:21:18,620 --> 00:21:20,380
!علينا التّركيز على قوّتنا

261
00:21:21,640 --> 00:21:23,220
!سأهزمه بالتّأكيد

262
00:21:50,850 --> 00:21:53,210
!استطاع تشكيل مثلّث

263
00:21:53,210 --> 00:21:56,370
!هذا سيّئ! لا تسمحوا بأن يفرّ الوحش الخرافيّ

264
00:22:00,870 --> 00:22:01,920
!مهلاً

265
00:22:03,220 --> 00:22:06,670
!كلاّ! من الخطير جدًّا الاقتراب أكثر