1
00:00:05,900 --> 00:00:09,430
لا ينفكّ يثرثر المُعلّمون حول الدّراسة

2
00:00:09,430 --> 00:00:11,280
!التحقنا للتو للمدرسة الإعداديّة

3
00:00:11,640 --> 00:00:16,350
لطالما كانت صوتك سكينتي الوحيدة بينما
أستلقي على السّرير في وقت متأخّر ليلاً

4
00:00:17,100 --> 00:00:20,280
ما المدرسة الثّانويّة الّتي تريدين
الالتحاق بها يا أبّولو؟

5
00:00:21,660 --> 00:00:25,170
أُفضّل مدرسة إناث. وحبّذا أن تكون
مُطلّة على المُحيط

6
00:00:52,610 --> 00:00:54,240
—أحم. كميو جميعاً

7
00:00:54,240 --> 00:01:00,860
كما تدركون جميعاً، مدرسة فورين للإناث اندمجت
مع فورين للذّكور اعتباراً من هذا العام الأكاديميّ

8
00:01:00,860 --> 00:01:02,120
وأصبحتا مدرسة مُشتركة

9
00:01:02,600 --> 00:01:05,520
أعلم بأنّ وجود بعض الفتيان حولكن
،سيتطلّب وقتاً للاعتياد عليه

10
00:01:05,520 --> 00:01:06,720
لكن آمل أن تنسجموا

11
00:01:06,720 --> 00:01:07,510
!سينسي

12
00:01:08,540 --> 00:01:10,970
ماذا كانت كلمة "ميو" تلك بالضّبط؟

13
00:01:10,970 --> 00:01:12,830
هل تلعثمت في كلامك؟

14
00:01:14,180 --> 00:01:18,780
.هذا يجعل خطابك ناقصاً
يتطلّب إعادة

15
00:01:19,120 --> 00:01:20,980
...وأنت

16
00:01:20,980 --> 00:01:23,440
هل أفهم منك أنّني أستطيع
التّعريف عن نفسي؟

17
00:01:23,440 --> 00:01:25,110
بـ-بالتأكيد، حسناً

18
00:01:26,010 --> 00:01:27,690
!اسمي يامابوكي أريسو

19
00:01:27,690 --> 00:01:31,550
وريث مجموعة يامابوكي، ورجل
يقود اليابان نحو المُستقبل

20
00:01:31,550 --> 00:01:34,370
بالتّالي، مُقدَّر لي أن أكون مثاليّاً

21
00:01:34,370 --> 00:01:35,950
طعامي المُفضّل هو الخوخ

22
00:01:36,400 --> 00:01:40,910
أطلب منكم جميعاً أن تتجنّبوا السّحق
بواسطة هالتي الصّرفة ووقاري

23
00:01:43,090 --> 00:01:44,130
وثمّة أمر أخير

24
00:01:44,460 --> 00:01:49,480
مع الأسف، أبلغكم بأنّني لم بلغتُ
نسبة 99% من الكمال

25
00:01:49,480 --> 00:01:51,920
لإيجاد تلك الـ 1% المفقودة
،الّتي تُكملني

26
00:01:51,920 --> 00:01:54,360
أحتاج بعض المُساعدة من الفتيات

27
00:01:54,360 --> 00:01:58,220
...أريدكن أن تتناوبن جميعاً

28
00:02:00,680 --> 00:02:02,980
"وتقُلن لي "أُحبّك

29
00:02:05,940 --> 00:02:07,730
!تبّاً يا يامابوكي

30
00:02:07,730 --> 00:02:11,390
جعلتَ الفتيات ينظرنَ إلينا
!نظرة استغراب

31
00:02:11,390 --> 00:02:13,310
!كفّ عن فعل ذلك لكلّ فتاة تراها

32
00:02:13,310 --> 00:02:15,360
!بعد أن خرجنا أخيراً من جحيم مدرسة الذّكور

33
00:02:15,360 --> 00:02:18,240
الشّدّة تصنع الرّجال كما يقولون

34
00:02:18,240 --> 00:02:19,370
على الرّحب

35
00:02:21,090 --> 00:02:25,340
مجموعة يامابوكي ثريّة، صحيح؟

36
00:02:25,340 --> 00:02:28,130
ما سرّ كلمة "أُحبّك" تلك؟

37
00:02:28,130 --> 00:02:33,740
هل تبحث عن حبيبة؟ أودّ
التقدُّم للعب هذا الدّور

38
00:02:33,740 --> 00:02:35,960
!ماذا؟ بهذه السّرعة؟

39
00:02:36,480 --> 00:02:39,260
!حـ-حسناً، أنا جاهزة

40
00:02:40,920 --> 00:02:43,410
يبدو لي أنّكِ تفتقرين لقوّة التحمُّل

41
00:02:44,640 --> 00:02:46,770
أعتذر. حان وقت دورة المياه

42
00:02:46,770 --> 00:02:50,130
بما أنّ البكتيريا المعويّة خاصّتي
،مثاليّة مثلما هو أنا

43
00:02:50,130 --> 00:02:53,760
فأنا في موضع أُحسَد عليه لأنّ الطّبيعة
تُناديني في نفس الوقت يوميّاً

44
00:02:53,760 --> 00:02:55,610
أشكّ في مسألة الحسد

45
00:02:55,610 --> 00:02:57,070
ما مُشكلة هذا الفتى؟

46
00:02:57,070 --> 00:02:58,120
...في الواقع

47
00:02:58,390 --> 00:03:01,900
كان يبحث عن شخص منذ السّنة
الثّانية من الإعداديّة

48
00:03:01,900 --> 00:03:04,700
لكن لا يعرف شكلها

49
00:03:04,700 --> 00:03:06,440
لحظة، معقول؟

50
00:03:07,290 --> 00:03:08,650
...واسمعوا هذا

51
00:03:08,650 --> 00:03:10,540
لا يتمتّع بنفس الحدّة

52
00:03:11,360 --> 00:03:13,300
...كلّ ما يضع نصب عينيه عليه

53
00:03:13,580 --> 00:03:15,040
هو صوتها

54
00:03:18,020 --> 00:03:20,860
إنّها مُجرّد رسالة من أمّي

55
00:03:28,390 --> 00:03:29,520
!ها هي ذي

56
00:03:29,930 --> 00:03:32,420
بهجتي الوحيدة في الإعداديّة

57
00:03:32,420 --> 00:03:35,240
كانت برنامج راديو تستضيفه فتاة
"تُسمّي نفسها "أبّولو

58
00:03:35,540 --> 00:03:38,990
أهلاً بكم في ميدنايت هارت تون

59
00:03:38,990 --> 00:03:41,740
خمّنوا ما حدث في المدرسة اليوم

60
00:03:41,740 --> 00:03:43,660
بالكاد كان لديها مُستمعين

61
00:03:43,950 --> 00:03:46,240
أحياناً، نحن الوحيدان اللّذان نتحادث

62
00:03:46,650 --> 00:03:50,380
كنّا نُدردش قليلاً في كلّ مُنتصف ليلة

63
00:03:50,770 --> 00:03:53,590
انظروا إلى السّاعة. يكفي لهذه اللّيلة

64
00:03:54,420 --> 00:03:57,750
دائماً ما تُنهي برنامجها بنفس العبارة

65
00:03:58,430 --> 00:04:02,220
هذا البرنامج يُبقيني مُستمرّة كلّ يوم

66
00:04:02,220 --> 00:04:04,350
تعال وتنزّه معي ثانية غداً

67
00:04:04,650 --> 00:04:06,180
شكراً كالعادة

68
00:04:06,180 --> 00:04:08,270
...أعزّائي المُستمعون

69
00:04:08,270 --> 00:04:09,310
أحبّكم

70
00:04:13,780 --> 00:04:15,610
أليس هذا ما أردت سماعه؟

71
00:04:16,410 --> 00:04:17,240
وأنتِ...؟

72
00:04:17,240 --> 00:04:19,910
شارف وقت الاستراحة على الانتهاء

73
00:04:20,800 --> 00:04:23,660
ألم تُرِد الذّهاب إلى دورة المياه؟

74
00:04:24,680 --> 00:04:26,220
!نسيت

75
00:04:29,870 --> 00:04:33,230
...كان صوتها يشبه صوت أبّولو كثيراً

76
00:04:33,230 --> 00:04:34,630
!على ما أعتقد

77
00:04:34,630 --> 00:04:39,050
لكن لا أستطيع الجزم. أخذتني على حين غرّة
وقُبيل نداء الطّبيعة

78
00:04:39,050 --> 00:04:41,620
!تبّاً! عليّ سماع ذلك ثانية

79
00:04:46,600 --> 00:04:50,310
هنا نادي البثّ مع إعلانات وقت الغداء

80
00:04:51,100 --> 00:04:53,480
!صوت فتاة يُسمع عبر المُكبّرات-

81
00:04:51,100 --> 00:04:53,710
أتمنّى لكم عاماً رائعاً آخر معاً-

82
00:04:53,480 --> 00:04:55,220
لكن جودة الصّوت سيّئة بعض الشّيء-

83
00:04:53,710 --> 00:04:58,680
يا طلّاب السّنة الأولى، وتلاميذنا الذّكور-
الجدُد، سررتُ بلقائكم

84
00:04:55,220 --> 00:04:56,640
لا بُدّ أنّ العتاد قديم-

85
00:04:56,640 --> 00:04:58,680
لا بُدّ أنّك تحبّ المدرسة المُختلطة-
يا يامابوكي، صحيح؟

86
00:04:59,270 --> 00:05:02,330
سيأتي نادي البثّ إليكم
،على الغداء وبعد دوام المدرسة

87
00:04:59,950 --> 00:05:02,330
!استجدّ أمر ما! أنا مُضطرّ للاستئذان للمُغادرة-

88
00:05:02,330 --> 00:05:03,820
!ماذا عن الغداء؟-

89
00:05:02,330 --> 00:05:04,970
أوّلاً، إعلان من مجلس الطّلبة-

90
00:05:04,970 --> 00:05:07,500
أنشطة النّادي، وإعلانات اللّجنة-

91
00:05:08,030 --> 00:05:11,670
أوّلاً، إعلان من مجلس الطّلبة-

92
00:05:09,930 --> 00:05:13,290
توقّفتْ ابّولو فجأة عن البثّ مع نهاية-
العام الأوّل من الإعداديّة

93
00:05:11,670 --> 00:05:13,290
...بمدرستنا المُدمجة الآن-

94
00:05:13,620 --> 00:05:16,000
حذفتْ كلّ أرشيفها أيضاً

95
00:05:16,000 --> 00:05:21,510
لكن عرفتُ من مُحادثاتنا بأنّنا في نفس
السّنّ ونعيش في نفس المُحافظة

96
00:05:21,510 --> 00:05:23,550
...قالت أيضاً

97
00:05:23,550 --> 00:05:27,220
أنّها تريد الالتحاق بثانويّة للإناث
!ذات إطلالة على المُحيط

98
00:05:30,350 --> 00:05:34,600
ولدى مزيد من التّحرّيات، فورين
للإناث فقط هي ما يستوفي المعايير

99
00:05:34,600 --> 00:05:37,220
حصلتُ على لمحة أيضاً بأنّها
ستتحوّل إلى مدرسة مُدمجة قريباً

100
00:05:37,220 --> 00:05:41,610
لهذا اخترتُ الالتحاق بفورين للذّكور
بدلاً من مدرسة تحضيريّة

101
00:05:41,900 --> 00:05:45,660
!أحياناً بريقي يُرعبني

102
00:05:52,880 --> 00:05:54,630
أريد التكلّم معك مرّة أُخرى

103
00:05:55,690 --> 00:05:56,960
هناك ما أريد أن أقوله لكِ

104
00:05:58,340 --> 00:06:00,250
أحتاج فقط آخر نسبة مئويّة لتُكملني

105
00:06:01,200 --> 00:06:03,180
...وهي أنتِ

106
00:06:11,270 --> 00:06:15,020
ا-المعذرة. أودّ أن أسألك سؤالاً

107
00:06:15,940 --> 00:06:20,030
!أنت! لا تدخل عنوة هذا المكان أثناء بثّنا

108
00:06:20,030 --> 00:06:21,490
اكتمي المذياع

109
00:06:21,490 --> 00:06:23,240
ماذا؟ هل علينا الإعادة من جديد؟

110
00:06:24,040 --> 00:06:26,340
إنّه الشّخص الّذي كاد يلوّث
نفسه في الرّواق

111
00:06:26,340 --> 00:06:28,170
أتعرفينه يا ريكّا-تشان؟

112
00:06:28,170 --> 00:06:30,300
هل أنت بخير؟ ارتطم رأسك

113
00:06:30,300 --> 00:06:33,910
لهذا لم أحبّ فكرة المدرسة المُدمَجة

114
00:06:33,910 --> 00:06:35,750
أنا... أنا آسف

115
00:06:37,080 --> 00:06:39,420
أجل، تبدو مثل أبّولو فعلاً

116
00:06:39,420 --> 00:06:43,480
!في الواقع... جميعهن يُشبهنها

117
00:06:44,170 --> 00:06:47,230
ذات الضّفيرة لديها نفس نوعيّة الصّوت

118
00:06:47,670 --> 00:06:51,260
وذات الشّعر الأسود لديها نبرة ولفظ مُشابهان

119
00:06:51,750 --> 00:06:54,600
وطريقة ذات الشّعر الأبيض
...في الكلام بالهمس

120
00:06:54,600 --> 00:06:58,400
هذا يشبه عندما كانت تبثّ بصوت
م!ُنخفض كي لا يشعر والداها

121
00:06:58,400 --> 00:07:01,940
وذات ذيلي التّوأم لديها نفس
!النّبرة الغاضبة تقريباً

122
00:07:01,940 --> 00:07:06,670
اللّعنة. كيف لمُجرّد فجوة ثلاث يسنوات
أن تجعلني غير مُتيقّن هكذا؟

123
00:07:06,670 --> 00:07:07,950
،إذاً

124
00:07:07,950 --> 00:07:10,180
...بما أنّك هنا

125
00:07:10,180 --> 00:07:12,040
هل هذا يعني أنّك تريد الاحتراف أيضاً؟

126
00:07:12,930 --> 00:07:14,110
ماذا تقصدان؟

127
00:07:14,110 --> 00:07:15,370
ماذا؟

128
00:07:15,370 --> 00:07:17,320
لماذا أنت هنا إن كنت لا تعلم؟

129
00:07:17,850 --> 00:07:22,000
جميعنا نريد خوض مسيرة مهنيّة بأصواتنا

130
00:07:22,000 --> 00:07:26,020
نادي البثّ مُخصّص لأشخاص أمثالنا الآن

131
00:07:26,020 --> 00:07:27,050
تماماً

132
00:07:27,390 --> 00:07:30,470
أطمح لأكون مُقدّمة أخبار

133
00:07:30,910 --> 00:07:33,550
حلمي هو أن أكون فيوتيوبر

134
00:07:34,130 --> 00:07:36,430
أسعى لأصبح مُمثّلة صوت

135
00:07:37,060 --> 00:07:39,950
أريد أن أكون مُغنّية في الواقع

136
00:07:41,670 --> 00:07:45,070
مسيرة مهنيّة بأصواتهن؟

137
00:07:45,790 --> 00:07:47,240
سمعتُ عنك

138
00:07:48,110 --> 00:07:50,760
تُفيد الإشاعة بأنّك عرّفت
عن نفسك بطريقة عجيبة

139
00:07:50,760 --> 00:07:52,190
ماذا كان ذلك؟

140
00:07:52,630 --> 00:07:56,370
كوني حبيبتي واحملي طفلي"، صحيح؟"

141
00:07:56,370 --> 00:07:58,120
—هـ-هذا ليس ما

142
00:07:58,120 --> 00:07:59,830
!ما الأمر؟ أنت مُخيف

143
00:07:59,830 --> 00:08:02,630
تبدو حتّى كشخص فاسد

144
00:08:02,630 --> 00:08:05,880
أنا واثقة بأنّك ملأت مخزنك السّحابيّ
بصور قضيب

145
00:08:05,880 --> 00:08:08,460
!مُخطئة! أنا هنا لرؤية شخص

146
00:08:08,460 --> 00:08:11,090
وهل هو أنا؟

147
00:08:12,650 --> 00:08:15,570
مضى وقت منذ تكلّمتُ مع فتى شخصيّاً

148
00:08:15,570 --> 00:08:18,450
الخجل هو جزء من شخصيّتي

149
00:08:18,450 --> 00:08:21,350
...لا، آسف

150
00:08:21,350 --> 00:08:23,000
فهمت

151
00:08:23,000 --> 00:08:25,650
أنت هنا لرؤيتي، صحيح؟

152
00:08:25,650 --> 00:08:26,940
!مُحال

153
00:08:28,610 --> 00:08:31,780
تماماً. أتيتُ لرؤيتك

154
00:08:33,000 --> 00:08:36,420
أقسم باسم يامابوكي بأنّني
لا أملك دافعاً خفيّاً

155
00:08:36,420 --> 00:08:38,990
أردتُ ببساطة رؤيتك ثانية وسماع صوتكِ

156
00:08:38,990 --> 00:08:40,510
حـ-حسناً...؟

157
00:08:45,830 --> 00:08:46,740
من؟

158
00:08:46,740 --> 00:08:47,820
الشّوكولاتة؟

159
00:08:47,820 --> 00:08:49,590
!إنّها إحدى مُفضّلاتي

160
00:08:49,590 --> 00:08:51,340
عمّاذا يتكلّم؟

161
00:08:51,340 --> 00:08:53,700
ماذا؟ أبّولو ليست هنا؟

162
00:08:54,210 --> 00:08:58,640
لا، بحسب أصواتهن، لا بُدّ أنّها واحدة منهن

163
00:08:58,640 --> 00:09:00,010
...ما يعني

164
00:09:02,330 --> 00:09:04,690
!أبّولو لا تريد الكشف عن نفسها؟

165
00:09:04,960 --> 00:09:07,150
قد يكون للأمر علاقة بسبب
توقّفها عن البثّ

166
00:09:07,580 --> 00:09:10,940
تبّاً، لا ينبغي أن أسألهن
!بشكل مباشر

167
00:09:10,940 --> 00:09:12,550
آسفة

168
00:09:12,550 --> 00:09:15,300
علينا العودة إلى بثّنا

169
00:09:15,300 --> 00:09:16,780
حـ-حسناً

170
00:09:17,500 --> 00:09:20,810
لا يهمّ. لديّ فُرص كثيرة للتحرّي

171
00:09:20,810 --> 00:09:22,570
ولا تعُد

172
00:09:23,250 --> 00:09:25,430
لا يُسمَح بدخول الغُرباء إلى هنا

173
00:09:25,430 --> 00:09:28,800
لا تقترب منّا ثانية، مفهوم؟

174
00:09:31,170 --> 00:09:32,340
،في الواقع

175
00:09:32,670 --> 00:09:34,820
أريد الحصول على عمل مُرتبط بالصّوت

176
00:09:34,820 --> 00:09:37,680
!أنا خبير حقيقيّ في أعمال الصّوت

177
00:09:37,680 --> 00:09:39,510
!هذا يجعلني مُحترفاً بحدّ ذاتي

178
00:09:39,870 --> 00:09:42,890
بالتّالي، لديّ الحقّ للانضمام لهذا النّادي

179
00:09:43,150 --> 00:09:44,310
،لإثبات ذلك

180
00:09:44,310 --> 00:09:47,360
اسمحنَ لي بإطلاعكن على العيب
الجوهريّ في هذا النّادي

181
00:09:48,380 --> 00:09:49,910
إنّه العتاد

182
00:09:49,910 --> 00:09:54,280
كان هناك الكثير من الضّجيج في بثّكن
لدرجة لا تُحتمَل

183
00:09:54,280 --> 00:09:56,630
وتُرِدنَ أن تُصبحن مُحترفات؟ مُضحك

184
00:09:56,630 --> 00:09:58,780
أقصد، هذا ليس خاطئاً

185
00:09:58,780 --> 00:10:00,860
هذه المدرسة قديمة فعليّاً

186
00:10:00,860 --> 00:10:02,560
إليكن مُقترحي لإصلاح المُشكلة

187
00:10:02,560 --> 00:10:05,870
،إذا سمحتنَ لي أنا، يامابوكي أريسو
بالانضمام لهذا النّادي

188
00:10:05,870 --> 00:10:08,710
فسأُساهم بعتاد جديد كلّياً

189
00:10:08,710 --> 00:10:12,950
في الواقع، جمع مُحدّثكم هنا مليون ين
في سوق الأسهم في الشّهر الماضي

190
00:10:15,100 --> 00:10:16,710
يبدو هذا رائعاً

191
00:10:16,710 --> 00:10:18,390
بهذه السّهولة؟

192
00:10:18,390 --> 00:10:20,720
لا ضير من وجود قوّة ذكوريّة عاملة معنا

193
00:10:20,720 --> 00:10:22,730
هل أنتِ مُوافقة على هذا يا ريكّا؟

194
00:10:22,730 --> 00:10:25,730
أجل، يُعجبني صوته

195
00:10:27,800 --> 00:10:29,050
شكراً لكِ

196
00:10:29,050 --> 00:10:31,360
سأقود هذا النّادي إلى مُستويات
أعلى بصفتي رئيسكن

197
00:10:31,360 --> 00:10:34,250
!من طلب منك أن تكون رئيسنا؟

198
00:10:34,250 --> 00:10:35,740
!ريكّا هي رئيستنا

199
00:10:35,740 --> 00:10:37,940
كيف نردّ له الجميل؟

200
00:10:37,940 --> 00:10:41,450
لكنّه ثريّ. ما الّذي يريده يا ترى؟

201
00:10:41,450 --> 00:10:43,250
أعرف شيئاً واحداً

202
00:10:43,670 --> 00:10:44,980
ما هو؟

203
00:10:49,020 --> 00:10:50,250
!ماذا؟

204
00:10:50,250 --> 00:10:51,970
هذا لا يُكلّفنا شيئاً

205
00:10:51,970 --> 00:10:53,660
هل سيُعدّ هذا ردّ جميل له؟

206
00:10:53,660 --> 00:10:55,200
لا أُمانع حقّاً

207
00:10:55,200 --> 00:10:57,980
يامابوكي-كن، هلّا استدرت قليلاً؟

208
00:11:05,540 --> 00:11:06,850
أُحبّك

209
00:11:06,850 --> 00:11:08,560
يا يامابوكي-كن

210
00:11:09,340 --> 00:11:11,360
!مـ-ما هذا فجأة؟

211
00:11:11,360 --> 00:11:13,640
ألم تُردنا أن نقول لك هذا؟

212
00:11:13,640 --> 00:11:15,050
!يا لك من مُريب

213
00:11:15,050 --> 00:11:17,200
...جعلت نبضات قلبي تتسارع قليلاً

214
00:11:17,200 --> 00:11:21,280
بالمُناسبة! أنا مضطرّ للانصراف
!كوني لم أُكمل غدائي بعد

215
00:11:27,570 --> 00:11:30,420
لم أتوقّع أن ألتقي بأبّولة ثانية هكذا

216
00:11:30,770 --> 00:11:33,210
أعتقد لا يوجد سوايّ أنا وأنت يا أريسو

217
00:11:33,210 --> 00:11:35,090
شكراً على مُتابعتي

218
00:11:35,090 --> 00:11:38,860
يا أعزّائي المُستمعون، أحبّكم

219
00:11:38,860 --> 00:11:41,310
كانت عبارتها الاختتاميّة المعتادة فحسب

220
00:11:41,800 --> 00:11:43,520
شكراً لكِ أيضاً يا أبّولو

221
00:11:43,850 --> 00:11:46,220
...ومهلاً

222
00:11:48,180 --> 00:11:50,940
أحبّكِ أيضاً. تصبحين على خير

223
00:11:55,280 --> 00:11:58,360
!أعلنتُ عن حُبّي لفتاة لا أعرف عنها شيئاً

224
00:11:58,360 --> 00:12:02,370
خطأ لا يُحتمَل بتاتاً من يامابوكي
!يُفترض أن يُجسّد الكمال

225
00:12:02,370 --> 00:12:04,870
،إذا كان لديها نسخة محلّية من أرشيفها

226
00:12:05,260 --> 00:12:08,000
!فأريدها أن تحذف ذلك مهما كلّف الأمر

227
00:12:08,680 --> 00:12:12,250
لا أريد استخدامه كمادّة ابتزاز
بعد أن بلغتُ هذه الأهمّية

228
00:12:12,560 --> 00:12:14,880
يجب أن أتعرّف على أبّولو
...في أسرع وقت مُمكن

229
00:12:15,370 --> 00:12:19,970
!وأسحب تلك الكلمات الّتي قلتُها آنذاك

230
00:12:24,100 --> 00:12:27,600
هذا بمُناسبة انضمام يامابوكي أريسو-كن
!إلى نادي البثّ

231
00:12:27,600 --> 00:12:29,810
!فلنبدأ حفلة التّرحيب هذه

232
00:12:31,580 --> 00:12:34,250
تفضّل يا ضيف الشّرف

233
00:12:36,010 --> 00:12:38,820
أخبرنا ما هو شعورك الآن

234
00:12:38,820 --> 00:12:43,120
هذا التّرحيب السّخيّ يدفئ
!قلبي من الأعماق

235
00:12:44,120 --> 00:12:45,720
حقّاً؟

236
00:12:45,720 --> 00:12:48,080
،حسناً، من الأفضل أن تكون نافعاً

237
00:12:48,340 --> 00:12:50,130
يا غُلام المهام

238
00:12:50,130 --> 00:12:52,280
غُلام المهام؟ مَن، مُحدّثكن؟

239
00:12:52,280 --> 00:12:55,260
كانت مُستشارة نادينا مُعارضة
لانضمام فتى إلينا

240
00:12:55,260 --> 00:12:58,510
وافقتْ على ذلك فقط شريطة
أن تكون غُلام المهام

241
00:12:58,510 --> 00:13:00,840
هل تكره القيام بأعمال رتيبة أيّها الذّكر؟

242
00:13:00,840 --> 00:13:02,620
ذكر"؟ ما هذا؟"

243
00:13:05,350 --> 00:13:07,740
لا تنحرف عن هدفك يا يامابوكي

244
00:13:07,740 --> 00:13:10,150
أولويّتنا الأولى هي إيجاد أبّولو

245
00:13:10,150 --> 00:13:13,520
حسناً. لا مانع أن أكون غُلام مهام

246
00:13:14,640 --> 00:13:16,910
أيّاً كنت، سأبذل قصارى جهدي

247
00:13:31,460 --> 00:13:32,790
...والآن

248
00:13:33,050 --> 00:13:35,930
سأبدأ بمُراقبة الفتيات الأربع

249
00:13:39,790 --> 00:13:41,330
لا يوجد غيرك اليوم؟

250
00:13:42,470 --> 00:13:44,600
جميعهن لديهن حُرّية مُستقلّة

251
00:13:45,560 --> 00:13:46,560
ما هذا؟

252
00:13:47,220 --> 00:13:48,930
نصّي لليوم

253
00:13:48,930 --> 00:13:51,560
عادة ما أتلعثم، لذا وضعتُ علامة
حول المشاكل المُحتملة

254
00:13:54,440 --> 00:13:57,150
أخبريني يا أوزوكي. هلّا سألتُكِ شيئاً؟

255
00:13:57,150 --> 00:13:58,480
صه

256
00:13:58,760 --> 00:14:00,040
أخفض صوتك

257
00:14:04,740 --> 00:14:08,080
مُقدّمة الأخبار المُلهِمة، أوزوكي شينوبو

258
00:14:08,080 --> 00:14:12,000
،إنّها أيضاً نائبة رئيسة مجلس الطّلبة
وتلميذة شرف نمطيّة

259
00:14:12,000 --> 00:14:16,060
شخصيّتها البرّاقة والمُبتهجة جعلتها
أميرة المدرسة

260
00:14:18,210 --> 00:14:20,760
إليكم بثّ ما بعد دوام المدرسة

261
00:14:20,760 --> 00:14:25,160
غرفة الموسيقى غير مُتاحة حاليّاً
بسبب أعمال صيانة

262
00:14:25,160 --> 00:14:27,110
احرصوا على الابتعاد عنها

263
00:14:27,110 --> 00:14:30,440
صوتها يصدح بوضوح كجرس فضّي-

264
00:14:27,600 --> 00:14:34,520
بوصول فريق البيسبول التّابع لمدرستنا المُدمجة-
...إلى أوّل موشاركة في بطولته الإقليميّة

265
00:14:34,520 --> 00:14:38,820
...را ئيسة الفرقة الموسيقيّة و

266
00:14:38,820 --> 00:14:41,560
...فرقة التش-جيع... تش

267
00:14:41,560 --> 00:14:44,150
افهموا فحوى المعنى. افعلوا ما يلزم

268
00:14:44,150 --> 00:14:46,790
!تلعثمتِ في كلّ كلمة أشّرتِ عليها

269
00:14:46,790 --> 00:14:48,650
!يامابوكي-كن! اسكت

270
00:14:51,610 --> 00:14:53,250
هل أنت أحمق يا يامابوكي؟

271
00:14:53,250 --> 00:14:55,590
!هذا ما يجعل أوزوكي-سان لطيفة جدّاً

272
00:14:55,590 --> 00:14:57,530
أليست ظريفة جدّاً فحسب؟

273
00:14:57,530 --> 00:14:59,350
!أعشق هذا التّباين

274
00:15:04,340 --> 00:15:06,800
يمكن تأجيل أوزوكي حاليّاً

275
00:15:06,800 --> 00:15:07,760
نيني-تشان

276
00:15:07,760 --> 00:15:09,990
لديك مُجلّد ليليكوس الجديد، صحيح؟

277
00:15:09,990 --> 00:15:12,060
!بالطّبع! فأنا مُعجبة أصيلة

278
00:15:12,060 --> 00:15:15,560
ليليكوس؟ كانت أبّولة تحبّ تلك المانغا

279
00:15:16,630 --> 00:15:19,380
مُمثّلة الصّوت المُلهِمة، هيميكاوا نيني

280
00:15:19,380 --> 00:15:22,140
سمعتُ بأنّها مُؤدّية كوزبلاي مُتحمّسة أيضاً

281
00:15:22,140 --> 00:15:24,650
مُفعمة بالنّشاط. إنّها نبض الصّفّ

282
00:15:24,650 --> 00:15:26,910
!أدّي صوت ليلي في هذا المشهد لأجلنا

283
00:15:26,910 --> 00:15:29,490
مهلاً. قليلاً فقط، اتّفقنا؟

284
00:15:29,890 --> 00:15:30,950
أحم

285
00:15:34,110 --> 00:15:36,710
أستطيع سماع صوتك أخيراً ثانية

286
00:15:36,710 --> 00:15:39,790
كنتُ أنتظر لفترة طويلة، طويلة جدّاً

287
00:15:39,790 --> 00:15:41,010
!ظريفة

288
00:15:41,010 --> 00:15:42,260
!وكأنّها هي حرفيّاً

289
00:15:42,260 --> 00:15:46,950
إ-إنّ أبي... مُـ... مُنفرج؟

290
00:15:47,590 --> 00:15:49,320
"تقصدين "مُتفرّج

291
00:15:49,320 --> 00:15:52,560
المُتفرّج هو شخص بين الجمهور

292
00:15:52,720 --> 00:15:55,770
...حتّى لو أثرتُ غضب الرّبّ المُكدّس

293
00:15:55,770 --> 00:15:56,740
الغضب المُقدّس

294
00:15:56,740 --> 00:15:58,310
بأخذي على حين... هرّة؟

295
00:15:58,310 --> 00:15:59,310
غرّة

296
00:15:59,310 --> 00:16:01,650
حدسي يخبرني بأنّها حمقاء

297
00:16:03,320 --> 00:16:05,320
!لا! أنا خائفة جدّاً

298
00:16:05,320 --> 00:16:09,590
!ذلك الفتى هناك ينظر إليّ بشهوانيّة

299
00:16:09,590 --> 00:16:10,390
!ماذا؟

300
00:16:10,390 --> 00:16:11,950
...لا، أنا لم

301
00:16:11,950 --> 00:16:14,130
!أنت، تحكّم بشهوتك

302
00:16:14,130 --> 00:16:15,130
!أيّها الخنزير

303
00:16:15,130 --> 00:16:18,830
!أتريد صعقة بين فخذيك أيّها الوقح؟

304
00:16:26,690 --> 00:16:31,270
،لا أستطيع اكتشاف ذلك من أصواتهن
غالباً لأنّني كنتُ أستمع إلى بثّ

305
00:16:31,860 --> 00:16:33,990
أي طريقة التّشفير الهجينيّة

306
00:16:33,990 --> 00:16:37,860
بما أنّ إرسال صوتك الحقيقيّ
،يتطلّب كثيراً من مُعدّل نقل بيانات

307
00:16:37,860 --> 00:16:42,400
فإنّه يترقمن ويُرسَل أقرب
نمط صوتيّ من الأصليّ

308
00:16:42,400 --> 00:16:46,930
بصيغة أُخرى، الصّوت من خارج هاتف هو الصّوت
الّذي يُشبه ببساطة الصّوت الأصليّ

309
00:16:47,300 --> 00:16:50,640
بالتّالي، يجب عليّ أن أتبيّن من خلال
ما يقلنَه ويفعلنَه بدلاً من ذلك

310
00:16:50,640 --> 00:16:53,660
ما يعني بأنّ عليّ مُراقبتهن أكثر عن كثب

311
00:16:53,660 --> 00:16:55,700
أتريد مُراقبتي؟

312
00:16:58,550 --> 00:17:01,920
آسف، عدساتي اللّاصقة المُلوّنة
عبارة عن مُستحضرات تجميليّة

313
00:17:01,920 --> 00:17:03,980
لا أستطيع الرّؤية ما لم أقترب جيّداً

314
00:17:05,000 --> 00:17:07,880
الفيوتيوبر المُلهِمة، كيرينو إيكو

315
00:17:07,880 --> 00:17:11,820
،الدّعم التّقنيّ المُقيم للنّادي
وذات شعبيّة كبيرة بين الأوتاكو

316
00:17:11,820 --> 00:17:13,310
،وفقاً للفتيان

317
00:17:13,310 --> 00:17:17,720
إنّها حاليّاً رائدة في لعب دور
نموذجيّ كفتاة خجولة حازمة

318
00:17:17,720 --> 00:17:18,790
لا أستطيع حتّى

319
00:17:20,640 --> 00:17:21,900
ما الّذي جاء بكِ إلى هنا؟

320
00:17:21,900 --> 00:17:25,230
هذا المكان محجوز للبثّ الخاص بي

321
00:17:34,890 --> 00:17:36,350
!مرحباً-إيكو! أنا أيكونيّة

322
00:17:36,790 --> 00:17:40,580
!سوميراغي إيكون تتكلّم! آسفة لتأخُّري

323
00:17:41,060 --> 00:17:42,130
مرحباً-إيكو

324
00:17:42,130 --> 00:17:43,190
!مرحباً-إيكو

325
00:17:43,190 --> 00:17:44,360
...مرحباً-إيكو

326
00:17:44,360 --> 00:17:45,590
!وداعاً-إيكو

327
00:17:47,500 --> 00:17:48,590
!انتهى؟

328
00:17:48,590 --> 00:17:51,120
أقصد بأنّه بثّ وقت الاستراحة

329
00:17:51,120 --> 00:17:52,880
وتعتقدين بأنّ هذا مُناسب؟

330
00:17:52,880 --> 00:17:57,060
،أعني بأنّه يُسعد كلّ من يُتابعني
لذا هذا يكفيني

331
00:17:59,410 --> 00:18:00,560
أستأذن بالانصراف

332
00:18:07,320 --> 00:18:11,820
هل إيكو... هل فعلتُ شيئاً أزعجه؟

333
00:18:14,160 --> 00:18:16,320
!يا له من نادٍ هزليّ

334
00:18:16,320 --> 00:18:19,040
!لم أرَ المُغنّية المُلهِمة حتّى

335
00:18:20,870 --> 00:18:22,250
،في الواقع

336
00:18:22,250 --> 00:18:24,120
أريد الحصول على عمل مُرتبط بالصّوت

337
00:18:24,680 --> 00:18:28,280
كمُمثّلة صوت أو مُقدّمة أخبار تلفزيونيّة

338
00:18:28,280 --> 00:18:32,130
تبدو مُغنّية مُناسبة لي أيضاً. وأعتقد
بأنّ اليوتيوبر تُحقّق نجاحاً

339
00:18:33,240 --> 00:18:35,110
أعلم بأنّكِ تستطيعين فعلها يا أبّولو

340
00:18:36,390 --> 00:18:37,610
شكراً

341
00:18:39,060 --> 00:18:40,390
،في هذه الحالة

342
00:18:40,390 --> 00:18:45,560
سأتعلّم كلَّ شيء عن أعمال الصّوت وذلك
!كي أساعدكِ في أيّ مهنة تختارينها

343
00:18:45,560 --> 00:18:47,150
إنّه وعد إذاً

344
00:18:47,520 --> 00:18:49,570
،سأعمل وكأنّ حياتي على المحكّ أيضاً

345
00:18:49,940 --> 00:18:52,400
!لذا لنذهب ونرَ عالم الاحتراف معاً

346
00:18:54,050 --> 00:18:57,760
هل أنا الوحيد الّذي اتّخذ ذلك
الوعد على محمل الجدّ؟

347
00:19:03,160 --> 00:19:05,600
إليكم بثّ ما بعد دوام المدرسة

348
00:19:05,600 --> 00:19:09,050
سؤال من البريطانيّ كاراو... فتى الكاراتيه

349
00:19:09,050 --> 00:19:11,140
"هل لديكن أنتن الأربعة حبيب؟"

350
00:19:11,140 --> 00:19:12,590
!ليس لدينا

351
00:19:12,590 --> 00:19:14,020
...التّالي

352
00:19:14,020 --> 00:19:17,040
أنتِ فتاة سيّئة يا ريكّا. أراكِ تتكاسلين

353
00:19:18,030 --> 00:19:19,970
لا أشعر بحافز الآن فحسب

354
00:19:21,320 --> 00:19:24,340
أتساءل ما الّذي يفكّر فيه يامابوكي-كن

355
00:19:24,340 --> 00:19:25,220
ماذا؟

356
00:19:26,120 --> 00:19:27,820
أقصد بشأننا

357
00:19:28,900 --> 00:19:30,980
!ماذا؟ ماذا تفعل؟

358
00:19:31,350 --> 00:19:32,750
!زملائي التّلاميذ

359
00:19:32,750 --> 00:19:35,780
هل تُوافقون بأنّ نادي البثّ
غير مُؤهَّل حاليّاً؟

360
00:19:38,490 --> 00:19:41,020
!يامابوكي-كن، نحن على الهواء

361
00:19:41,020 --> 00:19:42,770
!ماذا تفعل أيّها الأحمق؟

362
00:19:42,770 --> 00:19:44,910
،هنا في هذه المدرسة العامّة الرّيفيّة

363
00:19:44,910 --> 00:19:47,790
إذا استمرّتْ هؤلاء الفتيات في إهمال
بذل أي مجهود حقيقيّ

364
00:19:47,790 --> 00:19:50,690
،وسمحتُ لكم بالتّعامل معهن كأميرات

365
00:19:50,690 --> 00:19:53,800
فلن تتحقّق أحلامهن أبداً

366
00:19:54,410 --> 00:19:56,420
لكن لا تقلقوا

367
00:19:58,420 --> 00:20:01,220
،إذا نسيت أبّولو وعدنا

368
00:20:01,570 --> 00:20:03,890
فسوف أدعها تتذكّر فحسب

369
00:20:04,190 --> 00:20:06,560
،وإذا كنتُ لا أعرف أيّاً منهن هي أبّولو

370
00:20:06,560 --> 00:20:09,370
!فسأضطرّ إذاً لتحقيق كافّة أحلامهن

371
00:20:10,540 --> 00:20:17,150
أيّ نادٍ أنا، مُجسّد الكمال، جزء
منه يجب أن يكون كاملاً مثلي

372
00:20:17,590 --> 00:20:21,530
أعلن هنا والآن بأنّني سأقود كافّة
أعضاء نادي البثّ

373
00:20:21,840 --> 00:20:24,290
!وأحوّلهم إلى محترفين حقيقيّين

374
00:20:24,640 --> 00:20:26,930
سواء كانت مُقدّمة أخبار
،في محطّة تلفزيونيّة بارزة

375
00:20:26,930 --> 00:20:28,360
،ومُغنّية مُحقّقة لأرقام قياسيّة

376
00:20:28,360 --> 00:20:29,930
،ومُمثّلة صوت مُميّزة

377
00:20:29,930 --> 00:20:32,320
أو فيتيوبر تحصد أكبر عدد مُتزامن من المشاهدين

378
00:20:35,580 --> 00:20:37,600
أتيتُ لتحقيق وعدنا

379
00:20:37,600 --> 00:20:39,720
والآن يعزو الأمر لكم لمنحي إجابة

380
00:20:39,720 --> 00:20:40,970
!هذا كلّ شيء منّي

381
00:20:42,270 --> 00:20:43,950
!اخرج من هنا أيُّها الأحمق

382
00:20:50,820 --> 00:20:53,680
سنستأنف بثّ ما بعد الدّوام المدرسيّ

383
00:20:53,680 --> 00:20:56,730
بما أنّنا هنا، سنستمع منّا نحن الأربعة

384
00:20:56,730 --> 00:20:59,330
لدينا كثير من الرّسائل

385
00:21:01,110 --> 00:21:02,750
أمّي ثانية؟

386
00:21:09,780 --> 00:21:11,650
دعوا الجمل صعبة النّطق على عاتقي

387
00:21:11,650 --> 00:21:13,830
!شكراً! أنقذتني

388
00:21:18,870 --> 00:21:21,990
كدتُ أُصاب بنوبة قلبيّة

389
00:21:21,990 --> 00:21:26,160
لم أتوقّع أن تأتي لرؤيتي

390
00:21:26,160 --> 00:21:28,570
لكنّني آسفة

391
00:21:29,090 --> 00:21:33,000
لا أستطيع إخبارك بأنّني أبّولو. ليس الآن

392
00:21:34,770 --> 00:21:37,900
لطالما تحسّرتُ على عدد المُستمعين
،الّذين كانوا يتابعونني

393
00:21:37,900 --> 00:21:42,370
إلّا أنّ الحقيقة هي أنّ وجودك
وحده كان يكفيني

394
00:21:42,730 --> 00:21:46,040
كنتُ سعيدة بمُجرّد التحدُّث معك

395
00:21:47,810 --> 00:21:49,370
..."عندما قلتُ "أُحبّك

396
00:21:52,310 --> 00:21:54,680
لكنّها تحتوي على الكثير من الكلمات الطّويلة

397
00:21:54,680 --> 00:21:56,000
!بئساً

398
00:21:57,010 --> 00:22:00,170
قصدتُ توجيهها لك ولك وحدك

399
00:22:02,180 --> 00:22:05,260
حسناً، لنتناوب ونتابع

400
00:22:05,600 --> 00:22:06,930
!حسناً