1
00:00:04,230 --> 00:00:06,800
حسناً إذاً

2
00:00:06,800 --> 00:00:11,570
لنبدأ بحفلة اليوم الرّياضيّ الرّائعة
(جدّاً (كما سُمّيت بواسطة إيكو

3
00:00:11,570 --> 00:00:13,880
سنفعل هذا في منزلك يا ليمون-تشان؟

4
00:00:13,880 --> 00:00:16,180
من الأرخص الشّرب في المنزل

5
00:00:16,180 --> 00:00:18,260
بئساً. إنّها تشرب بالفعل، لذا لا نخب

6
00:00:19,940 --> 00:00:22,290
لماذا جعلتنا نبدّل إلى هذه الملابس؟

7
00:00:22,670 --> 00:00:25,880
ستكون قواعد المدرسة مُزعجة
إن كنتُن بالمُلابس الرّسميّة

8
00:00:25,880 --> 00:00:30,180
لنقُل أنّكن في زيارة صديقة
أكبر سنّاً فحسب اليوم

9
00:00:30,180 --> 00:00:33,300
لا بُدّ أنّ امتحان المُعلّمين كان
قد عُبِث به حتّى نجحَتْ فيه

10
00:00:33,590 --> 00:00:35,930
لديك مكان جميل يا ليمون-تشان

11
00:00:35,930 --> 00:00:38,430
من سيبدأ بشرب النّخب؟

12
00:00:38,430 --> 00:00:40,030
من غير مُحدّثكم؟

13
00:00:40,030 --> 00:00:42,620
تولّي الأمر يا حضرة الرّئيس

14
00:00:44,930 --> 00:00:48,900
أحسنتم صنعاً جميعاً. لا سيّما أنت يا شينوبو

15
00:00:49,800 --> 00:00:50,780
شكراً

16
00:00:53,040 --> 00:00:55,980
نخب بصحّة ليمون-تشان، والّتي
تُسدّد ثمن كلّ شيء

17
00:00:55,980 --> 00:00:56,830
ماذا؟

18
00:00:56,830 --> 00:00:58,480
!بصحّتكم

19
00:00:58,480 --> 00:01:01,500
سأدفع أنا؟ لكنّني مُفلسة وأنتظر راتبي

20
00:01:01,500 --> 00:01:04,450
هذه عقوبة على التّكاسل في أعمال الاستشارة

21
00:01:04,450 --> 00:01:06,340
شكراً على دعوتنا

22
00:01:06,340 --> 00:01:08,240
حسناً، أيّاً يكن

23
00:01:09,100 --> 00:01:10,400
...على أيّ حال

24
00:01:10,400 --> 00:01:13,710
قلتُ أن تُبدّلن ملابسكن إلى مُلابس مُريحة

25
00:01:13,710 --> 00:01:16,250
لكنّكن تماديتُن في هذه الملابس

26
00:01:16,250 --> 00:01:18,650
لِمَ هذا اللّباس المُثير جميعاً؟

27
00:01:19,790 --> 00:01:22,340
فهمت

28
00:01:22,340 --> 00:01:24,750
أنا مسرورة لأجلك يا يامابوكي

29
00:01:25,250 --> 00:01:27,820
يمكنك إنجاب وريث لعائلتك

30
00:01:27,820 --> 00:01:29,950
!ماذا؟ ما الّذي تحاولين قوله؟

31
00:01:29,950 --> 00:01:35,650
لا بُدّ أنّكن مُرتعدات لأنّ فتاة
اعترفتْ له بالوكالة

32
00:01:35,650 --> 00:01:36,870
!يا للشّباب

33
00:01:36,870 --> 00:01:40,740
لـ-لا علاقة له بالأمر. هكذا
ألبس في العادة

34
00:01:40,740 --> 00:01:43,880
ا-التقطتُ أيّ لباس كان قريباً أيضاً

35
00:01:43,880 --> 00:01:47,150
أردتُ فقط ارتداء بعض الملابس الجديدة

36
00:01:47,150 --> 00:01:50,940
ها أنتُن تختلقنَ الأعذار. على الأقلّ
ابحثنَ عن أعذار أفضل

37
00:01:50,940 --> 00:01:52,390
وما هو عذرك يا ريكّا؟

38
00:01:52,390 --> 00:01:58,350
اخترتُ هذا على أمل أن يناديني
يامابوكي-كن بالظّريفة

39
00:01:59,870 --> 00:02:02,770
كما سمعت يا يامابوكي. ما قولك؟

40
00:02:02,770 --> 00:02:04,520
!إنّه نائم

41
00:02:04,870 --> 00:02:07,690
أعتقد بأنّه تجوّل كثيراً

42
00:02:07,690 --> 00:02:10,220
لا أصدّق بأنّه نام في شقّة امرأة

43
00:02:10,910 --> 00:02:12,690
لسوء حظّك يا ريكّا

44
00:02:14,520 --> 00:02:19,120
.فوّتَّ فُرصة جيّدة يا بامابوكي-كن
لن تراني أبداً بهذا اللّباس ثانية

45
00:02:19,120 --> 00:02:22,190
حسناً. خرجَ الشّاذّ بيننا من المُعادلة

46
00:02:22,190 --> 00:02:24,440
لنُقِم حفلة فتيات فقط

47
00:02:24,440 --> 00:02:27,120
لِمَ لا نذهب ونشتري بعض الطّعام أوّلاً؟

48
00:02:27,120 --> 00:02:29,570
ما رأيكن أن تحضر كلُّ واحدة
شيئاً ونتشاركه بيننا؟

49
00:02:29,570 --> 00:02:30,890
فكرة سديدة بالنّسبة لي

50
00:02:30,890 --> 00:02:32,490
ماذا نفعل بشأن باكي؟

51
00:02:32,490 --> 00:02:34,380
لنضعه على السّرير فحسب

52
00:02:37,220 --> 00:02:39,880
مكانكِ فاخر أكثر ممّا توقّعتُ يا ليمون-تشان

53
00:02:39,880 --> 00:02:43,420
لكن لم أسمع بزراعة كرنبات فاصولياء
في دورة المياه من قبل

54
00:02:43,420 --> 00:02:47,560
أين المُشكلة في ذلك؟
الوصول سهل للماء

55
00:03:08,210 --> 00:03:11,930
أردتُ سؤالك شيئاً

56
00:03:11,930 --> 00:03:13,810
لكنّك فعلتَها ونمت

57
00:03:21,730 --> 00:03:28,130
أخبرني، لماذا عانقتْك شينوبو أثناء الحدث؟

58
00:03:28,820 --> 00:03:34,490
أنتما تتغازلان دوماً. هل تتواعدان أو ما شابه؟

59
00:03:38,890 --> 00:03:41,080
عادت إيكو

60
00:05:31,600 --> 00:05:36,480
هل قبّلتما بعضكما أو ما شابه؟

61
00:05:40,050 --> 00:05:43,490
!يا إلهي، نسيتُ محفظتي

62
00:05:43,490 --> 00:05:47,650
أظنّني سجّلتُ رقماً قياسيّاً عالميّاً
!جديداً في النّسيان

63
00:05:48,050 --> 00:05:50,090
أ-أهلاً بعودتكِ يا نيني

64
00:05:50,920 --> 00:05:52,120
ماذا؟

65
00:05:52,120 --> 00:05:56,090
كنتِ هنا يا إيكو؟ عدتُ فقط
كي ألتقط مِحفظتي

66
00:05:56,090 --> 00:05:57,730
هل تأخذين استراحة؟

67
00:05:57,730 --> 00:05:59,530
أ-أجل

68
00:05:59,530 --> 00:06:01,440
ماذا اشتريتِ؟

69
00:06:02,320 --> 00:06:03,260
هذا سرّ

70
00:06:03,260 --> 00:06:05,960
هيّا، أخبريني

71
00:06:05,960 --> 00:06:08,260
لحظة، هل حاولتُ للتو اعتراض طريقي إيكو؟

72
00:06:08,260 --> 00:06:13,060
لماذا؟ لأنّها كانت سوف تُقبّله؟
لكن لا علاقة للأمر بي

73
00:06:13,060 --> 00:06:14,070
...المعذرة

74
00:06:14,480 --> 00:06:16,020
كم مضى على وجودكِ هنا؟

75
00:06:16,020 --> 00:06:16,900
!ماذا؟

76
00:06:16,900 --> 00:06:19,200
!فـ-في الواقع، عدتُ للتو

77
00:06:19,200 --> 00:06:21,610
!لم أرَ أو أسمع شيئاً

78
00:06:21,610 --> 00:06:24,770
!سقطتْ عدساتي، وعينايّ مليئتان بالزّغب

79
00:06:24,770 --> 00:06:27,230
إذاً هل سبق وقبّلتِ أحداً؟

80
00:06:27,880 --> 00:06:31,250
!وأنا الّتي كنتُ أحاول جاهدة لتغيير الموضوع

81
00:06:31,250 --> 00:06:32,870
لِمَ هذا السّؤال فجأة؟

82
00:06:33,310 --> 00:06:36,230
لا أدري. شعرتُ برغبة في السّؤال فقط

83
00:06:37,080 --> 00:06:39,400
في الواقع... أجل

84
00:06:39,400 --> 00:06:41,940
حقّاً؟ من؟ ومتى؟

85
00:06:41,940 --> 00:06:44,010
كان ذلك مؤخّراً نسبيّاً

86
00:06:44,010 --> 00:06:46,510
إن كان هذا محسوباً

87
00:06:46,510 --> 00:06:49,270
أنتِ ناضجة جدّاً

88
00:06:49,270 --> 00:06:51,970
هكذا إذاً. مُذهل

89
00:06:51,970 --> 00:06:53,380
...بالمناسبة يا إيكو

90
00:06:54,250 --> 00:06:56,940
هل تحبّين غلام المهام هنا؟

91
00:06:58,760 --> 00:06:59,730
لماذا تسألين؟

92
00:07:00,180 --> 00:07:03,030
أقصد بأنّكِ كنتِ على وشك
تقبيله قبل قليل

93
00:07:03,030 --> 00:07:06,060
!رأيتِ ذلك؟ أ-أيّتها الكذّابة

94
00:07:06,060 --> 00:07:07,840
!قلتِ بأنّكِ لم تري شيئاً

95
00:07:07,840 --> 00:07:10,330
!أنا آسفة لأنّ نظري 10 على 10

96
00:07:10,330 --> 00:07:12,450
هذه غلطتكِ لأنّكِ مُستهترة جدّاً

97
00:07:15,260 --> 00:07:16,980
!مهلاً، إيكو؟

98
00:07:20,120 --> 00:07:24,880
لا أعتقد بأنّ الأمر هكذا، لكن لا أدري

99
00:07:24,880 --> 00:07:29,130
لطالما كنتُ مُنعزلة، لذا إنّها المرّة
الأولى الّتي يراودني فيها هذا الشّعور

100
00:07:30,260 --> 00:07:33,380
هل تكنّين مشاعر تجاه باكي؟

101
00:07:35,610 --> 00:07:39,650
ليس تماماً. أكره كلّ الفتيان حقّاً

102
00:07:40,080 --> 00:07:42,980
،لكن... في الواقع

103
00:07:43,280 --> 00:07:46,450
إنّه أفضل من الفتيان الآخرين الّذين
أعرفهم على الأقلّ

104
00:07:47,680 --> 00:07:49,290
...هل تقصدين

105
00:07:49,290 --> 00:07:50,200
!لقد عُدت

106
00:07:51,800 --> 00:07:53,740
نيني-تشان؟ إيكو-تشان؟

107
00:07:54,580 --> 00:07:55,370
ماذا؟

108
00:07:55,960 --> 00:07:57,540
هذا غريب

109
00:07:57,870 --> 00:08:00,460
أحذيتهما هنا. هل خرجتا بالخُفّ؟

110
00:08:01,400 --> 00:08:03,430
أظنّني أوّل العائدات إذاً

111
00:08:04,000 --> 00:08:05,590
لماذا نختبئ؟

112
00:08:05,590 --> 00:08:06,670
!لا أدري

113
00:08:07,160 --> 00:08:10,260
ما زال يامابوكي-كن نائماً؟

114
00:08:11,360 --> 00:08:15,220
هذا مُؤسف جدّاً. وحتّى أنّني
اشتريتُ شيئاً لطيفاً لك

115
00:08:16,380 --> 00:08:17,560
،في الواقع

116
00:08:17,560 --> 00:08:20,030
أنا مَدينة لك باعتذارين

117
00:08:20,460 --> 00:08:23,780
الأوّل، أنا آسفة لأنّني عانقتُك

118
00:08:23,780 --> 00:08:26,030
،ظننتُ بأنّه قُضي علينا

119
00:08:26,350 --> 00:08:29,150
لذا كنتُ مُنقذي جوهريّاً

120
00:08:30,130 --> 00:08:31,620
آمل أنّك لم تُمانع ذلك

121
00:08:34,690 --> 00:08:37,450
أنا لم أُمانع بالطّبع

122
00:08:39,500 --> 00:08:41,750
...الشّيء الآخر الّذي يجب أن أعتذر بشأنه

123
00:08:42,250 --> 00:08:43,880
هو الكذب عليك

124
00:08:44,520 --> 00:08:48,380
نحن شريكان في الجريمة، لكن
ثمّة أمر لم أخبرك به

125
00:08:48,810 --> 00:08:50,620
ربّما سأعترف الآن

126
00:08:52,140 --> 00:08:53,550
،في الواقع

127
00:08:53,550 --> 00:08:55,330
...آنذاك أثناء حدث الاعتراف

128
00:08:55,330 --> 00:08:56,520
!عُدت

129
00:08:56,520 --> 00:08:58,900
ماذا؟ لا أحد في المنزل؟

130
00:09:00,980 --> 00:09:02,530
هذا غريب

131
00:09:02,530 --> 00:09:04,400
هل خرجنَ بالخُفّ؟

132
00:09:04,400 --> 00:09:05,990
لماذا تختبئان؟

133
00:09:05,990 --> 00:09:07,010
!لا أدري

134
00:09:07,010 --> 00:09:09,290
!لماذا تختبئين يا شينوبو؟

135
00:09:09,290 --> 00:09:10,320
!لا أدري

136
00:09:10,320 --> 00:09:12,820
أظنّني أوّل العائدات

137
00:09:13,950 --> 00:09:16,030
ما زال نائماً؟

138
00:09:16,030 --> 00:09:19,830
حقّاً؟ أحضرتُ لك شيئاً لطيفاً أيضاً

139
00:09:31,500 --> 00:09:32,340
!مهلاً

140
00:09:36,200 --> 00:09:38,060
!يا للخسارة

141
00:09:38,480 --> 00:09:40,570
فعلتُها وبدّلتُ ملابسي

142
00:09:41,320 --> 00:09:44,430
أنا عابسة لأنّك لم تمدحني

143
00:09:45,300 --> 00:09:47,770
لحظة. لا يمكنك سماعي

144
00:09:52,750 --> 00:09:57,330
مُذهل. لا تزال تعزف على الغيتار؟

145
00:09:58,560 --> 00:10:03,050
أنا أؤلّف أُغنية حاليّاً في الواقع

146
00:10:03,050 --> 00:10:05,670
لكن أعتقد بأنّني وصلتُ إلى طريق مسدود

147
00:10:04,870 --> 00:10:05,670
!آتشو

148
00:10:11,140 --> 00:10:12,840
ماذا تفعلنَ بالضّبط؟

149
00:10:23,630 --> 00:10:25,740
تبّاً، غلبني النّعاس

150
00:10:31,320 --> 00:10:33,910
ما-ما هذه الأجواء الغريبة؟

151
00:10:33,910 --> 00:10:36,990
!ما الأمر؟ لا تقُلنَ لي بأنّكن تشاجرتُن

152
00:10:36,990 --> 00:10:37,980
تشاجرنا

153
00:10:37,980 --> 00:10:38,820
!حقّاً؟

154
00:10:38,820 --> 00:10:40,230
لكن ليس هذا السّبب

155
00:10:40,230 --> 00:10:41,080
!ليس كذلك؟

156
00:10:42,580 --> 00:10:47,830
،اتّفقنا أن تشتري كلّ واحدة منّا شيئاً نُحبّه
لكن جميعنا اشترينا الشّيء ذاته

157
00:10:47,830 --> 00:10:51,600
حسناً، لكن كيف انتهى المطاف
بشرائكن كعكة كاملة؟

158
00:10:51,600 --> 00:10:53,640
هل أردتُن أكل الكعك إلى هذه الدّرجة؟

159
00:10:53,640 --> 00:10:57,640
حسناً، عملتَ بجدّ حقّاً، لذا أردتُ أن أشكرك

160
00:10:57,640 --> 00:11:01,060
أردتُ الاحتفال بنجاحنا، أجل

161
00:11:01,060 --> 00:11:04,690
كنتَ مُرهَقاً، لذا ارتأيتُ بأنّ شيئاً
حُلواً قد يُساعد

162
00:11:04,690 --> 00:11:08,440
اشتريتُها فقط لأنّني أردتُ تناولها

163
00:11:11,490 --> 00:11:14,320
لكن أربع كعكات كاملة عدد كبير

164
00:11:14,320 --> 00:11:15,350
!بدأ بالأكل بسرعة

165
00:11:15,350 --> 00:11:19,200
مُحدّثكم هو ملِك اشتهاء السّكّر

166
00:11:19,840 --> 00:11:22,680
أربع كعكات كاملة قد لا تكون
حتّى كافية لإرضائي

167
00:11:26,470 --> 00:11:27,900
...يامابوكي-كن

168
00:11:27,900 --> 00:11:29,460
لا تضغط على نفسك

169
00:11:30,780 --> 00:11:32,060
—لا تُضحكيني

170
00:11:32,860 --> 00:11:35,960
...هذا ما يمكن أن أطلق عليه

171
00:11:35,960 --> 00:11:37,560
!افرحوا

172
00:11:38,460 --> 00:11:40,030
!اشتريتُ كعكة

173
00:11:51,340 --> 00:11:53,150
شكراً على الوليمة

174
00:11:53,150 --> 00:11:54,570
مُذهل

175
00:11:54,570 --> 00:11:56,440
تأثّرتُ بجهودك

176
00:11:56,440 --> 00:11:58,460
كم سعرة حراريّة كانت؟

177
00:11:58,460 --> 00:11:59,700
هل أنت بخير؟

178
00:12:00,310 --> 00:12:03,780
لا مُشكلة إطلاقاً. كان ذلك شهيّاً

179
00:12:03,780 --> 00:12:07,100
كُل كعكتي تالياً إذاً

180
00:12:07,100 --> 00:12:10,500
يبحث قلبي عن التّرفيه. هذا احتفال

181
00:12:10,500 --> 00:12:13,060
سيكون الأكل والشّرب إسرافاً ببساطة

182
00:12:13,060 --> 00:12:14,060
تجنّبَ ذلك

183
00:12:14,060 --> 00:12:17,830
...شيء ما يُقرّب الأعضاء من بعضهم الآخر

184
00:12:17,830 --> 00:12:20,260
ما رأيكن أن نلعب لعبة ما؟

185
00:12:20,260 --> 00:12:22,450
فكرة سديدة. لنفعلها

186
00:12:22,450 --> 00:12:23,970
أريد لعِب قطط وتنانين

187
00:12:23,970 --> 00:12:25,680
هل لديكِ أي ألعاب يا ليمون-تشان؟

188
00:12:25,680 --> 00:12:29,640
في الواقع، لديّ بعض الأشياء
لألعاب الشّرب

189
00:12:31,400 --> 00:12:34,070
على الخاسر أن يأكل هذه دُفعة واحدة

190
00:12:34,070 --> 00:12:35,170
!الشّيطان بيننا

191
00:12:35,170 --> 00:12:37,660
!لا تُقرّري العقوبة أوّلاً فحسب

192
00:12:37,660 --> 00:12:39,650
ستنضمّين لنا يا ليمون-تشان، أليس كذلك؟

193
00:12:39,650 --> 00:12:44,170
أرفض. أتجنّب الكربوهيدرات بعد 8 مساء

194
00:12:44,950 --> 00:12:48,030
والبيرة غير محسوبة؟ كيف أصبحتْ أستاذة؟

195
00:12:48,030 --> 00:12:49,310
أيُّها سنلعب؟

196
00:12:49,310 --> 00:12:52,390
هذه بكلّ تأكيد. أريد استخدام عقلي

197
00:12:52,390 --> 00:12:53,800
وأحدهم ماهر في ذلك غالباً

198
00:12:53,800 --> 00:12:59,580
أنتِ ذكيّة. مُحدّثكم لم يخسر أي لعبة
تركيز في السّبعة عشر سنة من حياتي

199
00:13:04,320 --> 00:13:06,850
إنّه دوركِ الأوّل. لا تُبالغي في التّفكير

200
00:13:07,260 --> 00:13:09,020
ابذلي جهدكِ يا نيني-تشان

201
00:13:09,020 --> 00:13:13,900
...برقّة

202
00:13:20,800 --> 00:13:22,950
!مرحى

203
00:13:25,910 --> 00:13:27,230
انتهيت

204
00:13:27,230 --> 00:13:27,960
!كان ذلك سريعاً

205
00:13:27,960 --> 00:13:29,370
أنا التّالية

206
00:13:29,660 --> 00:13:32,330
نادراً ما ألعب ألعاب تناظريّة كهذه

207
00:13:32,330 --> 00:13:33,460
ماذا؟

208
00:13:33,460 --> 00:13:36,110
إنّها مُشوِّقة، صحيح؟

209
00:13:36,700 --> 00:13:37,920
ماذا؟

210
00:13:41,410 --> 00:13:44,400
بئساً، وصلتِ إلى هناك بهذه السّرعة؟

211
00:13:47,760 --> 00:13:49,400
لا تقبلين بمُساومات إذاً

212
00:13:54,620 --> 00:13:57,300
ما هي نقلتك يا يامابوكي-كن؟

213
00:13:58,920 --> 00:14:02,150
،هل يُسمَح لي بلمس قدر ما أشاء من مُكعّبات
وبالعدد الّذي أريده من مرّات؟

214
00:14:02,430 --> 00:14:03,730
ما رأيكِ يا حكم؟

215
00:14:03,730 --> 00:14:04,830
ليمون-تشان هي الحكم؟

216
00:14:04,830 --> 00:14:05,870
لِمَ لا؟

217
00:14:05,870 --> 00:14:09,120
حصلتُ على إذن الحكم. ها أنا ذا

218
00:14:09,120 --> 00:14:11,830
لا تنقر كثيراً. ستدعه ينهار

219
00:14:12,200 --> 00:14:13,390
ماذا؟

220
00:14:13,390 --> 00:14:15,650
أنت خبير في هذه يا يامابوكي

221
00:14:15,650 --> 00:14:19,750
مهلكِ. نحن عائلة يامابوكي نلعبها
بين الحين والآخر فقط

222
00:14:20,880 --> 00:14:25,570
ثلاثة مُكعّبات في كلّ طابق. أربعة
وخمسون مُكعّباً بالمُجمل

223
00:14:25,570 --> 00:14:30,520
،في لعبة التّوازن القديمة هذه
...يبدو كلّ مُكعّب هو نفسه

224
00:14:30,790 --> 00:14:33,800
!لكنّها مختلفة قليلاً من حيث الحجم والثّخانة

225
00:14:33,800 --> 00:14:36,810
!لذا نستهدف الأرقّ قليلاً

226
00:14:43,880 --> 00:14:45,660
من التّالي؟

227
00:14:46,010 --> 00:14:47,570
تفضّلي

228
00:14:47,570 --> 00:14:50,990
!لا تغترّ أمامي! أنت تستفزّني

229
00:14:50,990 --> 00:14:53,830
يعتقد بأنّه قد ضمن النّصر

230
00:14:53,830 --> 00:14:56,600
يامابوكي-كن عسير الفهم

231
00:14:56,600 --> 00:14:59,270
أجل، لم يلحظ بأنّني بدّلتُ ملابسي

232
00:15:01,340 --> 00:15:03,420
حان وقت الجدّ على ما أعتقد

233
00:15:09,060 --> 00:15:13,980
تبّاً. كلّ هذا الكعك يُشعرني بالنّعاس

234
00:15:15,130 --> 00:15:16,810
هلّا أسرعتِ؟

235
00:15:15,450 --> 00:15:17,610
إحدى هؤلاء الأربعة هي أبّولو

236
00:15:17,610 --> 00:15:18,480
سيفلح هذا

237
00:15:18,480 --> 00:15:19,500
ماذا عن هنا؟

238
00:15:19,500 --> 00:15:20,460
يمكنك فعلها

239
00:15:20,460 --> 00:15:21,480
لا أعلم بخصوص تلك

240
00:15:20,460 --> 00:15:21,480
لم نتكلّم منذ فترة

241
00:15:22,920 --> 00:15:27,030
آنذاك، من المُؤكّد أنّها كانت هي
في الجانب الآخر من الباب

242
00:15:27,030 --> 00:15:30,530
ماذا كان ذلك الاعتراف بالوكالة قبل قليل؟

243
00:15:30,920 --> 00:15:34,330
شعرتُ وكأنّه ترتّب عليّ التّعبير عن مشاعري

244
00:15:34,730 --> 00:15:37,140
،هربتُ من برنامج الرّاديو الخاص بي

245
00:15:37,140 --> 00:15:39,920
وأعتقد بأنّني سئمتُ من إخفاء ذلك

246
00:15:40,450 --> 00:15:42,000
،بما أنّ الأمر كذلك

247
00:15:42,310 --> 00:15:44,520
فلِمَ لا تكشفين عن نفسكِ؟

248
00:15:45,690 --> 00:15:46,870
أجل، أتمنّى ذلك

249
00:15:46,870 --> 00:15:49,750
ماذا لو قلتُ بأنّني لا أُمانع ذلك؟

250
00:15:50,750 --> 00:15:53,720
لهذا طلبتُ منك المجيء إلى هنا على أيّ حال

251
00:15:57,810 --> 00:15:59,480
لا، لا داعي

252
00:15:59,830 --> 00:16:00,860
ماذا؟

253
00:16:01,320 --> 00:16:03,950
قرّرتُ إيجادكِ بنفسي

254
00:16:03,950 --> 00:16:07,490
إذا كشفتِ عن نفسكِ الآن، فكأنّني
أكون قد اعترفتُ بالهزيمة

255
00:16:08,060 --> 00:16:10,480
وهذا يُنافي مبادئ عائلة يامابوكي

256
00:16:12,250 --> 00:16:13,660
فضلاً عن ذلك، قطعتُ وعداً، أتتذكرين؟

257
00:16:14,190 --> 00:16:16,180
سأحوّل الجميع في النّادي إلى مُحترفات

258
00:16:16,180 --> 00:16:18,670
سأعرف من تكونين حينئذ، شئت أم أبيت

259
00:16:19,450 --> 00:16:22,370
أنت جادٌّ بشأن ذلك حقّاً، أليس كذلك؟

260
00:16:22,370 --> 00:16:25,590
لا أظنّ بأنّ ذلك الحلم سوف يتحقّق

261
00:16:26,170 --> 00:16:28,600
ما هو هدفك على أيّ حال؟

262
00:16:28,600 --> 00:16:31,760
هل أتيت إلى هنا فقط كي تجدني
وتجعلني مُحترفة؟

263
00:16:32,410 --> 00:16:36,150
أنا هنا لسبب شخصيّ. لا أريد التحدُّث عنه

264
00:16:37,180 --> 00:16:38,330
...رغم ذلك

265
00:16:38,710 --> 00:16:43,650
،بعد سماع كافّة أصواتكن شخصيّاً
وجدتُ لنفسي هدفاً جديداً

266
00:16:44,230 --> 00:16:46,620
أريد الحصول على عمل له صِلة بالصّوت أيضاً

267
00:16:46,620 --> 00:16:50,220
باستثناء أنّني لن أكون مُؤدّياً. سأكون مُنتِجاً

268
00:16:52,030 --> 00:16:53,530
أريد إصدار أغانٍ

269
00:16:56,360 --> 00:16:57,860
أريد إقامة حفلات غنائيّة

270
00:16:58,480 --> 00:17:00,230
وتنظيم برامج بثّ

271
00:17:03,080 --> 00:17:06,250
أريد العمل معكن

272
00:17:07,360 --> 00:17:10,060
شئتِ أم أبيتِ، سأحقّق ذلك الحلم

273
00:17:10,060 --> 00:17:11,910
وستأتين معي

274
00:17:12,340 --> 00:17:14,180
أنت أنانيٌّ جدّاً

275
00:17:14,520 --> 00:17:18,080
سآتي معك إذاً؟

276
00:17:19,400 --> 00:17:20,810
أغمض عينيك

277
00:17:26,920 --> 00:17:28,810
مـ-مهلاً، هل خرجتِ من الغرفة للتو؟

278
00:17:28,810 --> 00:17:30,840
أيُعقَل أنّكِ جريئة إلى هذا الحدّ؟

279
00:17:39,380 --> 00:17:40,950
...كان ذلك الصّوت

280
00:17:40,950 --> 00:17:42,670
غُلام المهام؟

281
00:17:42,670 --> 00:17:44,630
إلى متى ستبقى شارداً؟

282
00:17:44,630 --> 00:17:49,090
...آسف. كنتُ أُفكّر في شيء

283
00:17:49,670 --> 00:17:51,290
!ما هذا؟

284
00:17:52,990 --> 00:17:55,800
إن كنت تعتقد بأنّك تستطيع تحريك
مُعّب الآن، فأرني ذلك

285
00:17:55,800 --> 00:17:57,430
كيف انتهى المطاف به هكذا؟

286
00:17:57,690 --> 00:17:59,130
بذلنا قصارى جهدنا

287
00:17:59,130 --> 00:18:00,820
استفززتَنا

288
00:18:00,820 --> 00:18:02,560
قوّة الصّداقة

289
00:18:03,130 --> 00:18:07,530
لا أصدّق بأنّكن تحالفتُن أنتن الأربعة
لإسقاط مُحدّثكن

290
00:18:07,530 --> 00:18:09,390
!لكن هل هذا مسموح أصلاً؟

291
00:18:09,390 --> 00:18:11,510
لا أرى مانعاً لذلك. فهذا مُمتع

292
00:18:11,510 --> 00:18:12,470
مرحى

293
00:18:12,470 --> 00:18:15,490
تذكّر، تحبّ ليمون-تشان الإرضاء
الفوريّ أكثر من أيّ شيء آخر

294
00:18:15,490 --> 00:18:17,600
،لا أقول بأنّ ردّها مُفاجئ

295
00:18:17,600 --> 00:18:19,620
لكن سأقول بأنّ المُعلّمة لا ينبغي
!أن تتصرّف بهذا الشّكل

296
00:18:19,620 --> 00:18:22,210
حسناً، والآن، هيّا

297
00:18:22,210 --> 00:18:23,560
حان دورك

298
00:18:23,560 --> 00:18:25,830
...لكن، لمسة واحدة و

299
00:18:25,830 --> 00:18:28,400
!يـ-ن-ت-هـ-ي أمرك

300
00:18:28,400 --> 00:18:31,010
لا أعلم، قد تنهار من تلقاء نفسها

301
00:18:31,410 --> 00:18:34,510
تمّ إبطال إستراتيجيّتي

302
00:18:35,250 --> 00:18:39,600
في هذه الحالة، يجب عليّ قياسها بعينَي

303
00:19:21,630 --> 00:19:25,160
!انتصرنا

304
00:19:31,500 --> 00:19:33,490
كان ذلك تغييراً جيّداً للرّوتين

305
00:19:33,490 --> 00:19:34,940
انظروا للقمر

306
00:19:34,940 --> 00:19:36,300
!ما أجمله

307
00:19:37,470 --> 00:19:39,160
حسناً أيّتها المُستذئبة

308
00:19:40,560 --> 00:19:42,670
ألستِ أقرب إلى قطّة؟

309
00:19:42,670 --> 00:19:43,620
إنّها جميلة للغاية

310
00:19:43,620 --> 00:19:44,940
ستوقظين النّاس

311
00:19:46,010 --> 00:19:48,120
أبّولو، هلّا قلتُ كلاماً أخيراً؟

312
00:19:52,750 --> 00:19:56,100
لطالما كنتُ من مُعجبينكِ، وما زلتُ كذلك

313
00:19:56,750 --> 00:19:58,890
أنا مسرور حقّاً لأنّني تمكّنتُ
من سماع صوتكِ ثانية

314
00:19:59,450 --> 00:20:04,380
لذا سأردّ الجميل وأخبركِ نفس
الكلام الّذي قلتُه آنذاك أيضاً

315
00:20:06,030 --> 00:20:07,220
...أريسو

316
00:20:09,020 --> 00:20:10,360
أحبّك

317
00:20:11,300 --> 00:20:14,090
شكراً على مُناداتي باسمي

318
00:20:17,590 --> 00:20:20,370
تمكّنتُ من سماع صوت أبّولو
،للمرّة الأولى شخصيّاً

319
00:20:20,850 --> 00:20:25,310
لكن ما زلتُ لم أستطع تحديد
مَن بين هؤلاء الأربعة كانت هي

320
00:20:26,160 --> 00:20:27,830
هل أنت مُرهَق؟

321
00:20:27,830 --> 00:20:31,210
كان اليوم مُتعِباً حتّى بالنّسبة لك، صحيح؟

322
00:20:31,210 --> 00:20:36,610
.لم أحظَ بوقتٍ للتنفُّس طوال اليوم
أكذب إذا قلتُ بأنّني لم أكن مُتعباً

323
00:20:36,610 --> 00:20:37,510
...لذا

324
00:20:37,890 --> 00:20:39,880
لا بُدّ أنّكن مُتعبات مثلي أيضاً

325
00:20:40,170 --> 00:20:42,530
،وفّرنا التّعليق لكافّة الفعاليّات

326
00:20:42,530 --> 00:20:44,720
ومضينا للأمام قُدماً

327
00:20:45,050 --> 00:20:50,440
أدّى نادي البثّ كلّ مهمّة
تخصّ اليوم الرّياضيّ

328
00:20:50,440 --> 00:20:52,420
ينبغي أن نفتخر بذلك

329
00:20:54,240 --> 00:20:57,570
كُفّ عن الاعتداد بالنّفس يا غلام
المهام. لا تتزعّم الموقف

330
00:20:59,100 --> 00:21:00,070
...لكن أجل

331
00:21:00,070 --> 00:21:02,220
فعلناها حقّاً

332
00:21:03,490 --> 00:21:06,290
سارت الاعترافات بالوكالة بشكل جيّد أيضاً

333
00:21:06,290 --> 00:21:07,580
،لم يكن ذلك سهلاً

334
00:21:07,580 --> 00:21:09,270
لكن استمتعنا

335
00:21:09,720 --> 00:21:11,280
استمتعتم؟

336
00:21:12,250 --> 00:21:13,620
استمتعنا بالطّبع

337
00:21:13,620 --> 00:21:15,190
كان ذلك رائعاً

338
00:21:15,190 --> 00:21:17,590
أريد القيام بمزيد من هذه

339
00:21:19,690 --> 00:21:22,180
،بما أنّكم استمتعتُم جميعاً

340
00:21:22,180 --> 00:21:25,890
!فأجل، كان ذلك نجاحاً كبيراً

341
00:21:29,290 --> 00:21:31,390
يسرّني أنّني خضتُ هذه التّجربة

342
00:21:32,220 --> 00:21:35,660
،نيني-تشان، إيكو-تشان، ريكّا-تشان

343
00:21:36,310 --> 00:21:37,780
...ويامابوكي-كن

344
00:21:38,380 --> 00:21:40,190
!شكراً لكم جميعاً

345
00:21:50,010 --> 00:21:53,300
سآتي معك إذاً؟

346
00:21:54,690 --> 00:21:56,450
أغمض عينيك