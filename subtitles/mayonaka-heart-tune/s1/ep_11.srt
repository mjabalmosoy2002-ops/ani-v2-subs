1
00:00:03,870 --> 00:00:07,500
كلّ هذه النّباتات المنزليّة تبدو
مُتشابهة بالنّسبة لي

2
00:00:07,500 --> 00:00:09,940
ماذا؟ كلّا بالتّأكيد

3
00:00:09,940 --> 00:00:12,380
!صبّار... أريد صبّاراً

4
00:00:12,380 --> 00:00:15,060
لماذا تشتكين؟

5
00:00:15,060 --> 00:00:19,150
أنتِ من أراد بعض النّباتات في غرفة
الصّفّ لأجل الصّيف يا نيني

6
00:00:21,310 --> 00:00:22,640
أخبرني يا يامابوكي-كن

7
00:00:22,640 --> 00:00:24,810
ماذا تُدعى هذه؟

8
00:00:24,810 --> 00:00:27,270
هذا تين بنغالي

9
00:00:27,270 --> 00:00:29,960
،موطنه الأصليّ البنغال في الهند
ويُعرَف أيضاً بـ الأثأب

10
00:00:29,960 --> 00:00:31,780
وتُعرَف أيضاً بأنّها مُعمِّرة

11
00:00:31,780 --> 00:00:35,240
إنّها مرنة وسهلة الزّراعة، لذا
هي مثاليّة للمبتدئين

12
00:00:35,240 --> 00:00:36,960
لكن حذارِ من النّسغ

13
00:00:35,240 --> 00:00:36,960
!مُقرف! إنّه أوتاكو نباتات

14
00:00:36,960 --> 00:00:37,910
...صبّار

15
00:00:36,960 --> 00:00:42,620
،يُعرَف بأنّه يُسبّب ردود فعل للحساسيّة
لذا ارتدينَ قفّازات أثناء التّعامل معها

16
00:00:38,260 --> 00:00:41,850
...صبّار... صبّار... صبّار

17
00:00:42,620 --> 00:00:44,370
هذه ظريفة جدّاً، صحيح؟

18
00:00:45,460 --> 00:00:46,770
...صبّار

19
00:00:45,460 --> 00:00:47,500
هذه باتشيرا

20
00:00:47,500 --> 00:00:52,450
تُعرَف بسويقاتها خُماسيّة الأرواق ونموّها السّريع

21
00:00:48,200 --> 00:00:51,610
...صبّار... صبّار

22
00:00:52,450 --> 00:00:53,400
...صبّار

23
00:00:52,450 --> 00:00:57,220
،أثناء الرّبيع والصّيف بشكل خاص
ستنمو كثيراً في غفلة منك

24
00:00:53,910 --> 00:00:57,220
!صبّار! صبّار

25
00:00:57,700 --> 00:00:59,020
...صبّار

26
00:01:00,310 --> 00:01:04,620
أتينا إلى هذا المتجر البعيد، فقط
لشراء هذه النّبتة؟

27
00:01:04,620 --> 00:01:08,980
!اخترناها لأنّ الأوراق الخمسة تُمثّلنا

28
00:01:08,980 --> 00:01:11,030
بل لأنّها كانت رخيصة، صحيح؟

29
00:01:11,030 --> 00:01:13,130
...أردتُ صبّاراً

30
00:01:13,130 --> 00:01:14,850
لكن الحرّ شديد حقّاً

31
00:01:14,850 --> 00:01:17,110
اقترب الصّيف حقّاً في نهاية المطاف

32
00:01:17,110 --> 00:01:19,910
بئساً، لا أريد أن أتعرّض لحروق شمسيّة

33
00:01:24,860 --> 00:01:27,800
استمتعتُ بهذا الحفل المُصغّر قبل أيّام

34
00:01:27,800 --> 00:01:31,000
أحبّ غناء أغانيّي الخاصّة حقّاً

35
00:01:31,000 --> 00:01:35,170
،أريد القيام بأداء شوارع بنفس الطّريقة

36
00:01:35,170 --> 00:01:37,320
لكن أنا خائفة جدّاً من المُحاولة

37
00:01:37,320 --> 00:01:38,380
...أجل

38
00:01:38,380 --> 00:01:40,990
مع ذلك تمكّنتُ من تأليف أغنية

39
00:01:40,990 --> 00:01:44,360
ماذا أفعل؟ اقتربت استراحة الصّيف

40
00:01:45,680 --> 00:01:49,130
لم تحضر ريكّا لي أغنية جديدة إلى الآن

41
00:01:49,130 --> 00:01:51,610
يبدو أنّ صدمتها أعمق ممّا ظننت

42
00:01:52,130 --> 00:01:56,880
.ينبغي أن أبحث عن خيارات أُخرى
ما الّذي يمكن مُحدّثكم فعله؟

43
00:01:58,840 --> 00:02:01,700
!كلّ شيء تقريباً، هذا ما في الأمر

44
00:02:01,700 --> 00:02:03,150
ما مُشكلتك؟

45
00:02:05,610 --> 00:02:06,870
ما هذا الصّوت؟

46
00:02:06,870 --> 00:02:09,500
أحدهم يؤدّي استعراضاً في الشّارع

47
00:02:09,500 --> 00:02:11,870
لم أسمع هذه الأغنية من قبل

48
00:02:12,580 --> 00:02:15,010
!آسفة، اذهبوا من دوني

49
00:02:15,010 --> 00:02:15,800
ماذا؟

50
00:02:16,350 --> 00:02:18,340
ما الّذي يجري يا ريكّا-تشان؟

51
00:02:18,340 --> 00:02:19,560
استراحة دورة مياه؟

52
00:02:19,560 --> 00:02:21,760
!سـ-سأكون أمّ هذه الشّجرة؟

53
00:02:22,170 --> 00:02:25,850
سمعتُ بأنّ التّنويم المغناطيسيّ يمكن
أن يساهم في التغلُّب على الصّدمة

54
00:02:25,850 --> 00:02:27,520
سأطلب من أختي الكبرى أن تُدرّبني

55
00:02:34,160 --> 00:02:38,130
إنّها آيكو بالفعل. هذا واضح من خلال
الطّريقة الّتي عزفتْ بها

56
00:02:38,530 --> 00:02:41,770
إذاً ما زالت تفعل هذا؟

57
00:02:42,390 --> 00:02:44,670
،لا أريدها أن تراني لأنّ ذلك سيكون مُحرجاً

58
00:02:44,670 --> 00:02:46,650
لكن أريد البقاء والاستماع أكثر

59
00:02:49,580 --> 00:02:51,500
شكراً جزيلاً

60
00:02:51,900 --> 00:02:53,740
ستكون الأغنية التّالية هي الأخيرة لي

61
00:02:53,740 --> 00:02:55,250
يا آنسة

62
00:02:55,250 --> 00:02:57,740
لا يسمعكِ أحدٌ أصلاً

63
00:02:57,740 --> 00:03:00,310
ما الفائدة من الاستمرار؟

64
00:03:00,310 --> 00:03:01,380
...بئساً

65
00:03:03,260 --> 00:03:05,640
!أغلق فمك أيّها الأحمق

66
00:03:05,640 --> 00:03:08,050
!أنا أفعل هذا لأنّني أريد

67
00:03:08,050 --> 00:03:11,500
ماذا تقولين؟ أنتِ سيّئة في هذا، لذا
!توقّفي عن ذلك

68
00:03:11,500 --> 00:03:13,890
!هذا لأنّ لديك أُذنان سيّئتان أيّها الوغد

69
00:03:13,890 --> 00:03:16,710
!لن أتحمّل أيّ شخص يُهين موسيقايّ

70
00:03:16,710 --> 00:03:19,070
!لن تصلي إلى أي نتيجة تُذكَر

71
00:03:19,070 --> 00:03:20,240
!أحمق

72
00:03:20,240 --> 00:03:22,520
!لا تُرِني وجهك ثانية أيّها العجوز

73
00:03:23,490 --> 00:03:26,660
على أيّ حال، هذه أغنيتي الأخيرة

74
00:03:26,660 --> 00:03:29,880
لم أؤلّف هذه الأغنية بمفردي

75
00:03:29,880 --> 00:03:32,630
ألّفتُها مع صديقتي منذ زمن بعيد

76
00:03:32,630 --> 00:03:36,580
لحنّا الموسيقى معاً في الإعداديّة

77
00:03:36,580 --> 00:03:38,930
،كنّا مُتحمّستين جدّاً عندما أكملنا الأغنية

78
00:03:42,260 --> 00:03:44,120
وحصلنا على ردّ في الواقع

79
00:03:45,630 --> 00:03:47,740
مَن منكما غنّى الجوقة؟

80
00:03:47,740 --> 00:03:49,800
نحتاج فقط الفتاة الّتي لديها ذلك الصّوت

81
00:03:50,310 --> 00:03:52,840
،لكن كنتُ مع ذلك سعيدة

82
00:03:52,840 --> 00:03:56,280
لأنّه تمّ الاعتراف بموسيقانا

83
00:03:56,280 --> 00:03:59,770
لهذا السّبب ائتمنتُ صديقتي على كلّ شيء

84
00:03:59,770 --> 00:04:02,040
!أخبرتُها بأنّه حريّ بها أن تفعلها

85
00:04:02,040 --> 00:04:05,290
من الأفضل أن تصبح الفنّانة رقم واحد
!في اليابان بموسيقانا

86
00:04:06,520 --> 00:04:09,240
لكن ماذا فعلتْ تلك الحمقاء؟

87
00:04:12,910 --> 00:04:17,150
كفّي عن الخوف والهرب وغناء
!أغاني نجمات شهيرات يا حمقاء

88
00:04:17,150 --> 00:04:21,190
أيّ تلميذة شقيّة في الإعداديّة
!تستسلم بعد فشل واحد؟

89
00:04:23,680 --> 00:04:27,760
لذا عليّ الاستمرار في غناء هذه الأغنية

90
00:04:28,140 --> 00:04:30,510
فأساساً، موهبتها حقيقيّة

91
00:04:31,520 --> 00:04:34,000
،حتّى لو لم تكن الفنّانة الأولى في اليابان

92
00:04:34,000 --> 00:04:37,230
تستطيع أن تبقى الأولى في قلب أحدهم

93
00:04:37,530 --> 00:04:41,260
لذا لا مُشكلة ما دام أحدٌ يفهم

94
00:04:41,260 --> 00:04:44,990
إذا أحببتُم هذه الأغنية، فتذكّروها رجاء

95
00:04:45,510 --> 00:04:46,450
"إنّها "هدوء اللّيل

96
00:05:02,620 --> 00:05:06,680
مع غوص الشّمس في البحر

97
00:05:06,680 --> 00:05:10,060
أطلقنا تنهيدة عميقة

98
00:05:10,060 --> 00:05:12,900
وردّت المُحيطات علينا

99
00:05:12,900 --> 00:05:15,680
بموجة بيضاء كبيرة

100
00:05:16,650 --> 00:05:20,350
وسحبت الرّياح معها

101
00:05:23,780 --> 00:05:27,340
استمرّي في النّظر إلى قطعة الـ 5 ين
...هذه. وبعدها

102
00:05:27,340 --> 00:05:30,780
ستكتشفين أنّه حتّى اللّيمونة يمكن
أن يكون مذاقها حلواً كالسكّر

103
00:05:30,780 --> 00:05:33,490
!بدأتُ أُصدِّق

104
00:05:33,490 --> 00:05:35,620
حسناً، يمكنكش أكل شريحة اللّيمونة هذه

105
00:05:37,960 --> 00:05:39,710
!حامضة

106
00:05:39,710 --> 00:05:42,870
شهيق... زفير

107
00:05:43,560 --> 00:05:45,090
...لساني

108
00:05:45,090 --> 00:05:46,970
لم يفلح ذلك إطلاقاً

109
00:05:46,970 --> 00:05:50,410
كنتُ آمل أن أتخلّص من صدمة
!ريكّا بهذه الطّريقة

110
00:05:52,270 --> 00:05:54,170
بدأت ريكّا بحفلها الموسيقيّ المُصغَّر

111
00:05:55,160 --> 00:05:57,310
!مضى وقت منذ آخر حفل لها

112
00:05:57,310 --> 00:05:58,810
مرحباً بالجميع

113
00:05:58,810 --> 00:06:01,130
شكراً على الحضور رغم أنّ الحرّ
شديد في الخارج

114
00:06:02,840 --> 00:06:05,640
لنتطرّق إلى صلب الموضوع. إليكم الأغنية الأولى

115
00:06:05,640 --> 00:06:07,280
لحظة، ما العنوان؟

116
00:06:08,320 --> 00:06:10,250
أتساءل ما الّذي ستؤدّيه؟

117
00:06:25,370 --> 00:06:28,740
مع غوص الشّمس في البحر

118
00:06:26,340 --> 00:06:28,740
ما تلك الأغنية؟

119
00:06:28,740 --> 00:06:31,500
لحظة، أهي أصليّة؟

120
00:06:28,740 --> 00:06:32,340
أطلقنا تنهيدة عميقة

121
00:06:32,340 --> 00:06:34,990
وردّت المُحيطات علينا

122
00:06:33,980 --> 00:06:35,570
ما هذه الأغنية؟

123
00:06:34,990 --> 00:06:38,650
بموجة بيضاء كبيرة

124
00:06:35,970 --> 00:06:38,650
أردتُ الأغاني المعتادة

125
00:06:38,650 --> 00:06:45,080
وسحبت الرّياح معها

126
00:06:39,090 --> 00:06:41,320
هذا لا يبدو طبعها إطلاقاً

127
00:06:42,930 --> 00:06:46,340
لا أعلم، أرى بأنّ هذه أفضل

128
00:06:45,080 --> 00:06:48,480
بعد أن ودّعناها

129
00:06:48,480 --> 00:06:52,590
قطعنا وعداً بلا سبب

130
00:06:52,590 --> 00:06:53,750
...أجل

131
00:06:55,090 --> 00:06:58,530
يسيطر الهدوء على اللّيل

132
00:06:58,530 --> 00:07:02,220
عندما يسيطر الهدوء على اللّيل

133
00:07:02,220 --> 00:07:08,480
نشعر وكأنّه لا يوجد أحد
آخر في العالم سوانا

134
00:07:08,480 --> 00:07:11,720
يختلط البحر مع السّماء

135
00:07:11,720 --> 00:07:15,540
عندما يختلط البحر بهدوء مع السّماء

136
00:07:15,540 --> 00:07:20,380
أعلم بأنّه لا يبقى سوانا

137
00:07:20,380 --> 00:07:24,670
لكن مع ذلك أهمس في أذنك

138
00:07:24,670 --> 00:07:28,250
متى ألّفتْ أغنية كهذه؟

139
00:07:25,180 --> 00:07:33,160
في هدوء اللّيل

140
00:07:28,250 --> 00:07:31,320
،فضلاً عن ذلك، فعلتْ كلّ هذا بمفردها
دون مُساعدة مُحدّثكن؟

141
00:07:34,880 --> 00:07:36,660
!ريكّا

142
00:07:36,660 --> 00:07:39,660
متى ألّفتِ هذه الأغنية الأصليّة؟

143
00:07:39,660 --> 00:07:41,250
!إنّها جميلة حقّاً

144
00:07:41,250 --> 00:07:43,330
!يبدو أنّني استهنتُ بكِ

145
00:07:43,330 --> 00:07:47,020
!نموتِ كثيراً في غفلة منّي

146
00:07:47,020 --> 00:07:48,860
!عجباً لأمرك

147
00:07:48,860 --> 00:07:51,340
لم تمنحني انتباهاً كافياً مؤخّراً

148
00:07:52,460 --> 00:07:54,330
...المعذرة

149
00:07:54,330 --> 00:07:57,300
لأجل هذه الأغنية، توقّفتُ عن الاهتمام
بإرضاء الجميع

150
00:07:57,300 --> 00:07:59,560
—ألّفتُها لشخص مُميّز جدّاً بالنّسبة لي

151
00:07:59,560 --> 00:08:01,680
،أعزّ صديق لي

152
00:08:02,940 --> 00:08:04,760
ورمية جانبيّة أُخرى

153
00:08:09,050 --> 00:08:10,940
أنا رمية جانبيّة؟

154
00:09:44,740 --> 00:09:47,090
!حجزنا تاريخاً وساعة لأداء الشّارع

155
00:09:50,140 --> 00:09:54,510
!والآن هزّي أذني الدّاخليّة بقوّة أغانيك الجديدة

156
00:09:54,510 --> 00:09:56,030
!اصمت

157
00:09:56,350 --> 00:09:58,840
ريكّا تعمل على أغنية الآن

158
00:09:58,840 --> 00:09:59,590
آسف

159
00:09:59,590 --> 00:10:02,410
ويا بوكي، صوتك العاديّ عالٍ بما يكفي

160
00:10:02,410 --> 00:10:04,560
ألم تقولي بأنّكِ انتهيتِ من الأغاني؟

161
00:10:04,560 --> 00:10:06,780
ما زالت هناك واحدة مُتبقّية

162
00:10:06,780 --> 00:10:10,570
أخطّط لوضع خمسة أغانٍ في الأسطوانة الّتي
سأبيعها في أداء الشّوارع

163
00:10:10,850 --> 00:10:13,820
لكن لا أستطيع إكمال الأغنية الأخيرة فحسب

164
00:10:13,820 --> 00:10:18,200
لكن نظراً إلى أن أنّكِ لم تكوني تستطيعين
التأليف من قبل، هذا تقدُّم جيّد

165
00:10:18,200 --> 00:10:19,970
أنتِ تبلين حسناً

166
00:10:21,450 --> 00:10:24,840
!!مهلاً! لا ترمي مديحي من النّافذة

167
00:10:24,840 --> 00:10:27,380
ريكّا ليست فتاة سهلة

168
00:10:27,380 --> 00:10:30,600
أكملتُ المسودّة لغلاف أسطوانتي

169
00:10:30,600 --> 00:10:32,010
!أرينا! أرينا

170
00:10:33,030 --> 00:10:34,130
ما رأيكم؟

171
00:10:34,480 --> 00:10:35,970
هل تكرهين الأرانب؟

172
00:10:35,970 --> 00:10:38,670
!هذه إشارة سلام، لا أرنب

173
00:10:38,670 --> 00:10:40,240
إذاً، ما معنى هذه؟

174
00:10:40,240 --> 00:10:41,460
...في الواقع

175
00:10:42,700 --> 00:10:45,160
هذا رمزٌ للعصيان

176
00:10:45,160 --> 00:10:48,530
سأحرص على أن ينتشر في كلّ زوايا اليابان

177
00:10:49,480 --> 00:10:52,740
والآن حتّى أنا بدأتُ أتوتّر

178
00:10:52,740 --> 00:10:54,860
أتينا جميعاً لمُشاهدة عرضك، مفهوم؟

179
00:10:54,860 --> 00:10:57,030
...بخصوص ذلك

180
00:10:57,330 --> 00:10:58,740
،بالنّسبة لهذا العرض

181
00:10:58,740 --> 00:11:01,310
أودّ أداءه دون مُساعدتكن

182
00:11:01,310 --> 00:11:02,120
ماذا؟

183
00:11:03,160 --> 00:11:07,370
وجودكم معي سوف يُسعدني
،ويساعدني على الاسترخاء

184
00:11:07,370 --> 00:11:10,920
،لكن إذا اعتدتُ على مُساعدتكم كثيراً
فلن يكون هناك جدوى من هذا العرض

185
00:11:10,920 --> 00:11:12,440
هكذا إذاً

186
00:11:12,440 --> 00:11:15,340
خسارة، لكن أعتقد هذا يصبّ في صالحكِ

187
00:11:15,340 --> 00:11:17,020
حسناً، فهمت

188
00:11:17,020 --> 00:11:19,140
لكن سنكون موجودين للعرض الّذي
يعقب هذا، اتّفقنا؟

189
00:11:20,250 --> 00:11:21,390
...بالمناسبة

190
00:11:21,390 --> 00:11:24,570
كيف بدأتِ فجأة بإحراز تقدُّم بعد
علقتِ لفترة طويلة؟

191
00:11:24,570 --> 00:11:27,120
هل وجدتِ خدعة ما في تأليف
الأغاني أو ما شابه؟

192
00:11:27,120 --> 00:11:29,400
خدعة؟

193
00:11:29,400 --> 00:11:33,270
طوال هذا الوقت، كنتُ أحاول تأليف الأغاني
الّتي تُرضي كثيراً من النّاس

194
00:11:33,270 --> 00:11:36,910
أغانٍ ما كنتُ لأخجل منها، أغانٍ
تُحقّق مبيعات جيّدة

195
00:11:36,910 --> 00:11:40,370
هذا ما كنتُ أحاول فعله، لكن
لم يسرّ الأمر على ما يُرام

196
00:11:40,370 --> 00:11:45,290
عندما حاولتُ تأليفها أثناء تصوُّر الشّخص
،الّذي أكرّسها له

197
00:11:45,290 --> 00:11:48,120
فكلمات الأغنية واللّحن قد تمّت
صياغتهما بصورة تلقائيّة لديّ

198
00:11:48,470 --> 00:11:52,880
على ذكر الأمر، لم أكن أؤلّف الموسيقى
لإرسال رسالة من نوع ما

199
00:11:52,880 --> 00:11:57,740
كنتُ أؤلّف الموسيقى لأنّني أردتُ
هذا الشّخص أن يستمع إلى أغانيّي

200
00:11:57,740 --> 00:12:02,380
لكن توقّف قلمي أثناء تأليف
هذه الأغنية الأخيرة

201
00:12:02,380 --> 00:12:03,560
لماذا؟

202
00:12:05,290 --> 00:12:07,140
،لأنّني إذا أردتُ حقّاً إخباره بشيء

203
00:12:07,140 --> 00:12:11,020
فرُبّما ينبغي أن أخبره بشكل مُباشر
بدلاً من استخدام موسيقايّ

204
00:12:12,850 --> 00:12:15,650
فهمت. وصلتْ إلى طريق مسدود

205
00:12:15,650 --> 00:12:21,540
كمُنتج، ينبغي أن أعالج هذه المُشكلة
وأدعها تؤلّف  أفضل أغنية على الإطلاق

206
00:12:22,000 --> 00:12:23,000
ريكّا

207
00:12:23,490 --> 00:12:25,770
هل من شيء أستطيع فعله لأجلكِ؟

208
00:12:25,770 --> 00:12:29,490
يمكنني توفير أيّ شيء ترغبينه، سواء
كان مكاناً أو ظرفاً أو أُناساً

209
00:12:29,490 --> 00:12:31,750
تتكلّم كشخص أصبح ثريّاً مؤخّراً فحسب

210
00:12:31,750 --> 00:12:33,210
أيّ شيء؟ حقّاً؟

211
00:12:33,210 --> 00:12:35,880
!بالطّبع! بالنّسبة لمُحدّثكِ، المستحيل ليس مستحيلاً

212
00:12:36,200 --> 00:12:37,260
...في هذه الحالة

213
00:12:44,990 --> 00:12:47,060
يامابوكي-كن، هنا

214
00:12:47,370 --> 00:12:49,980
...قلتُ بأنّني أستطيع توفير أيّ شيء لكِ

215
00:12:49,980 --> 00:12:53,650
لكن لماذا تطلبين الدّردشة معي
على الشّاطئ ليلاً؟

216
00:12:53,650 --> 00:12:58,110
كنتُ أؤلّف الأغاني في مُنتصف
اللّيل بهذا الشّكل فحسب

217
00:12:58,110 --> 00:13:00,280
ظننتُ بأنّ التّواجد هنا قد يُساهم

218
00:13:01,030 --> 00:13:02,780
دردش معي قليلاً

219
00:13:04,120 --> 00:13:05,490
تعال واجلس بجانبي

220
00:13:17,420 --> 00:13:19,460
...بخصوص ما قلتِه قبل مدّة اليوم

221
00:13:19,460 --> 00:13:24,260
"تأليف موسيقى لأجل شخص واحد فقط"
هذه طريقة جيّدة للتطرُّق للأمر

222
00:13:24,260 --> 00:13:29,340
"على سبيل المثال، كرّس بيتهوفن "من أجل إليزه
،لفتاة قد أحبّها

223
00:13:29,340 --> 00:13:31,390
وما زالت الأغنية محبوبة بعد 200 عام

224
00:13:31,930 --> 00:13:35,310
من المُذهل أن تكتشفي هذه
الطّريقة من تلقاء نفسكِ

225
00:13:35,310 --> 00:13:37,350
أحسنتِ صنعاً يا ريكّا

226
00:13:37,980 --> 00:13:38,940
...لذا

227
00:13:38,940 --> 00:13:40,880
لِمَن تُكرّسين تلك الأغاني؟

228
00:13:40,880 --> 00:13:43,950
ماذا؟ أنا مُحرَجة جدّاً من قول ذلك

229
00:13:44,800 --> 00:13:48,570
لنقُل فحسب أنّه شخص أبعدتُ نفسي
،عنه بدافع الإحراج

230
00:13:49,000 --> 00:13:52,750
والآن أحتاج لاستجماع الشّجاعة
لأُخبره عن مشاعري رُبّما؟

231
00:13:52,750 --> 00:13:54,120
هكذا إذاً

232
00:13:54,120 --> 00:13:56,750
،لا بُدّ أنّها تتحدّث عن صديقتها
تلك الفتاة آيكو

233
00:13:56,750 --> 00:13:59,750
لقد تخاصمتا بسبب أسلوبهما الموسيقيّ

234
00:14:00,060 --> 00:14:00,710
وبعد؟

235
00:14:00,710 --> 00:14:05,050
ماذا تحاولين أن تخبري هذا الشّخص
من خلال موسيقاكِ؟

236
00:14:05,870 --> 00:14:07,290
ترديني أن أخبرك هنا؟

237
00:14:07,290 --> 00:14:08,970
لن أعرف ما لم تُخبريني

238
00:14:11,910 --> 00:14:13,140
"أُحبّك"

239
00:14:16,020 --> 00:14:21,290
هذا صريح جدّاً، لكن تريد أن تنقل
حُبّها إلى صديقتها؟

240
00:14:22,400 --> 00:14:24,290
ما الخطب؟ لستِ بخير؟

241
00:14:24,290 --> 00:14:25,550
ليس تماماً

242
00:14:25,550 --> 00:14:28,460
ريكّا. هل يمكنني إلقاء نظرة
إلى كلمات أغانيكِ

243
00:14:28,460 --> 00:14:29,320
!ماذا؟

244
00:14:29,320 --> 00:14:30,480
لن أعرف ماهيّتها ما لم أقرأها

245
00:14:30,480 --> 00:14:31,720
...أجل، لكن

246
00:14:31,720 --> 00:14:33,980
وهل سيُفيدكِ الشّعور بالإحراج من ذلك؟

247
00:14:37,770 --> 00:14:38,630
خُذ

248
00:14:38,630 --> 00:14:39,550
حسناً

249
00:14:41,140 --> 00:14:42,130
هكذا إذاً

250
00:14:42,130 --> 00:14:44,840
هل أنتِ شخصيّة مُراوغة؟

251
00:14:45,530 --> 00:14:49,750
هذه الكلمات تجريديّة للغاية وتتحاشى
التّعبير عن أيّ شيء مُباشَر

252
00:14:49,750 --> 00:14:53,930
.لن تصل الرّسالة إليه هكذا
ما الّذي يُعجبكِ فيه بالضّبط؟

253
00:14:53,930 --> 00:14:54,850
!ماذا؟

254
00:14:54,850 --> 00:14:57,270
...في الواقع

255
00:14:57,270 --> 00:15:01,900
بصراحة... إنّه مُستمع جيّد لي
...حتّى وقت متأخّر من اللّيل

256
00:15:01,900 --> 00:15:05,060
ويشجّعني على السّعي خلف حلمي

257
00:15:05,060 --> 00:15:09,370
،استمتعتُ حقّاً بالحديث معه
وقد مدّني بالأمل

258
00:15:09,650 --> 00:15:12,060
ماذا أيضاً؟ إليّ بالمزيد

259
00:15:12,060 --> 00:15:13,500
...في الواقع

260
00:15:13,500 --> 00:15:15,420
...إ-إنّه لطيف

261
00:15:15,420 --> 00:15:16,420
وبعد؟

262
00:15:16,420 --> 00:15:18,200
لديه صوت عذب

263
00:15:18,200 --> 00:15:19,670
!استمرّي

264
00:15:20,930 --> 00:15:22,460
...لكن أهمّ شيء

265
00:15:22,460 --> 00:15:26,510
هو أنّه انتظرني طوال هذا الوقت
بعد أن هربتُ منه

266
00:15:26,510 --> 00:15:28,750
!يا له من شخص لطيف

267
00:15:28,750 --> 00:15:30,850
رأيتِ؟ لديكِ كلّ هذه الأشياء لقولها

268
00:15:30,850 --> 00:15:32,850
لِمَ لا تستخدمين كلمات أغنيتكِ لفعلها؟

269
00:15:32,850 --> 00:15:38,560
أشعر وكأنّ استخدام الموسيقى للتّعبير
عمّا لم أستطع قوله مُباشرة هو غشّ

270
00:15:38,560 --> 00:15:43,270
،إذا عبّرتُ عن مشاعري له بتلك الطّريقة
فقد يُخيّب ذلك أمله بي

271
00:15:44,320 --> 00:15:49,820
أشعر وكأنّه يريد سماع ما يريد سماعه
منّي بشكل مُباشر

272
00:15:49,820 --> 00:15:50,660
ريكّا

273
00:15:50,660 --> 00:15:51,450
ماذا؟

274
00:15:51,450 --> 00:15:52,660
...أنت

275
00:15:52,660 --> 00:15:54,090
!الفتاة الّتي تريد كلّ شيء

276
00:15:54,090 --> 00:15:54,700
ماذا؟

277
00:15:54,700 --> 00:15:56,530
!أنتِ مُبارَكة بموهبة

278
00:15:56,530 --> 00:15:59,540
يمكنكِ التّعبير عن نفسكِ بطريقة
!مُعظم النّاس لا يستطيعونها

279
00:15:59,540 --> 00:16:00,790
!ما الّذي يدفعكِ للتردُّد؟

280
00:16:00,790 --> 00:16:02,720
لا توجد تراتبيّة في الطّرُق المُتعلِّقة
!بالتّعبير عن النّفس

281
00:16:02,720 --> 00:16:06,840
ليست الطّريقة، إنّما قوّة الشّعور هي
ما يُحرّك القلوب

282
00:16:06,840 --> 00:16:10,920
عدم استخدام موهبة تمتلكينها هو أمر
!يُخالف نهج يامابوكي في الحياة

283
00:16:10,920 --> 00:16:14,640
...مع أنّني إينوهانا؟ لنفترض

284
00:16:14,640 --> 00:16:17,930
لنفترض أنّ شخصاً استخدم أغنية
للتّعبير عن مشاعره لك

285
00:16:17,930 --> 00:16:19,320
فهل ستكون سعيداً؟

286
00:16:20,990 --> 00:16:22,020
أجل

287
00:16:22,690 --> 00:16:23,750
سعيد جدّاً

288
00:16:27,200 --> 00:16:28,350
هكذا إذاً

289
00:16:31,280 --> 00:16:34,270
إذاً أظنّني سأمسح هذه الأغنية من الأسطوانة

290
00:16:34,270 --> 00:16:38,160
!ماذا؟ ظننتُ بأنّني تخلّصتُ للتو من همومكِ

291
00:16:40,380 --> 00:16:44,540
هذا لأنّ هذه الأغنية الأخيرة كانت الغاية منها
هي التّعبير عن شيء عزيز جدّاً عليّ

292
00:16:44,860 --> 00:16:47,880
—حالما أستطيع تسمية نفسي بفنّانة

293
00:16:47,880 --> 00:16:52,210
حالما أشعر بأنّني أملك الحقّ في استخدام
—الموسيقى كوسيلة للتّعبير

294
00:16:52,210 --> 00:16:54,680
حينئذ فقط أستطيع إصدارها عالميّاً

295
00:16:55,000 --> 00:16:57,870
هل ستؤجّلينها إلى حفل بودوكان؟

296
00:16:57,870 --> 00:16:59,770
ليس شيئاً بهذه العظَمة

297
00:17:00,210 --> 00:17:03,560
إذا سارت الأمور على ما يُرام
في أداء الشّوارع هذه

298
00:17:03,560 --> 00:17:06,650
،وتمكّنتُ من بيع 50 نسخة من أسطوانتي

299
00:17:08,440 --> 00:17:09,780
...حينها

300
00:17:13,930 --> 00:17:15,950
سأغنّيها أمام الشّخص العزيز على قلبي

301
00:17:20,320 --> 00:17:22,150
سأؤدّي هنا؟

302
00:17:22,150 --> 00:17:25,810
أجل. تُعرَف هذه الحديقة بالمكان
المُقدّس لاستعراضات الشّوارع

303
00:17:25,810 --> 00:17:29,520
،سيليستيال، الفرقة الأحدث والأشهر اليوم

304
00:17:29,520 --> 00:17:32,650
كانت تؤدّي هنا حتّى العام الماضي
أيضاً حسبما سمعت

305
00:17:32,650 --> 00:17:36,020
لذا سيكون سقف توقُّعات الجمهور مُرتفعاً

306
00:17:36,020 --> 00:17:40,160
،لكن إذا استطعتِ جمع مُعجبين هنا
فسوف تصنعين اسماً لنفسكِ حتماً

307
00:17:43,000 --> 00:17:45,170
صنعتُ منشورات ووزّعتُها مُقدَّماً

308
00:17:45,170 --> 00:17:48,630
يجب أن تُولّدي انطباعاً أوّل جيّداً للظّفر بالجمهور

309
00:17:53,460 --> 00:17:55,860
أشعر بألم مُبرح في صدري

310
00:17:55,860 --> 00:18:01,130
هذا يُعيدني للذّكريات. كنتُ مُتوتّرة
في المرّة الأولى أيضاً

311
00:18:01,130 --> 00:18:02,060
...لكن

312
00:18:02,060 --> 00:18:04,330
إنّه ألمٌ من نوع مُختلف الآن

313
00:18:04,330 --> 00:18:08,120
آنذاك، لم أكن أعرف شيئاً وكنتُ
،مُفعمة بالآمال السّاذجة

314
00:18:08,120 --> 00:18:10,190
لكنّني خائفة فحسب الآن

315
00:18:10,940 --> 00:18:13,570
خائفة من أن يحدّقوا بي بتلك النّظرات ثانية

316
00:18:13,570 --> 00:18:14,650
ماذا الآن؟

317
00:18:14,650 --> 00:18:16,390
غالباً لا أستطيع القيام بهذا

318
00:18:16,390 --> 00:18:19,430
...ربّما ينبغي أن ألغيها فحسب، أو

319
00:18:19,430 --> 00:18:20,450
ريكّا

320
00:18:20,870 --> 00:18:21,950
ما-ماذا؟

321
00:18:21,950 --> 00:18:24,180
هل عينايّ مُخيفتان؟

322
00:18:24,180 --> 00:18:25,680
لـ-ليس تماماً

323
00:18:25,680 --> 00:18:27,040
حقّاً؟ أليستا جميلتين؟

324
00:18:27,040 --> 00:18:28,790
لا تتكلّم عنّي

325
00:18:30,280 --> 00:18:31,510
اسمعي يا ريكّا

326
00:18:35,800 --> 00:18:37,530
فانظري في عينَي، لا في أحد آخر

327
00:18:37,530 --> 00:18:39,150
حـ-حسناً

328
00:18:39,150 --> 00:18:40,230
عظيم

329
00:18:40,230 --> 00:18:42,460
يسرّني أنّني أتيتُ مُحضِّراً نفسي

330
00:18:43,390 --> 00:18:46,560
،حتّى لو فقدتِ أثري وسط المُتفرّجين

331
00:18:46,560 --> 00:18:48,580
!ستتمكّنين من رؤيتي إذا لوحّتُ بهاتين

332
00:18:48,580 --> 00:18:51,000
سأموت من الإحراج، لذا إيّاك ذلك

333
00:18:51,000 --> 00:18:54,560
"ماذا؟ أتستخدمين كلمة "إحراج
!في وجه مُحدّثكِ؟

334
00:18:57,170 --> 00:19:00,320
تُساعدني على الاسترخاء، صحيح؟ شكراً

335
00:19:00,320 --> 00:19:02,480
سأجرّب ذلك

336
00:19:04,340 --> 00:19:06,340
أجل، ابذلي جهدكِ

337
00:19:06,960 --> 00:19:08,950
سوف نُراقبكِ طوال الوقت

338
00:19:23,580 --> 00:19:26,680
سأبدأ بأغنيتي الأولى، أيّام مُتقلّبة

339
00:19:41,940 --> 00:19:46,330
بينما ننظر إلى السّماء الزّرقاء الواسعة

340
00:19:43,570 --> 00:19:46,330
ماذا تريدين... أن تفعلي الآن؟

341
00:19:46,330 --> 00:19:49,670
برسائل بيضاء برّاقة

342
00:19:49,670 --> 00:19:54,090
كتبنا عن هدفنا، كتبنا عن مُستقبلنا

343
00:19:54,090 --> 00:19:57,670
وطليناها بأحلامنا

344
00:19:57,970 --> 00:20:03,290
وأقول "أراك غداً" لكلّ عابر

345
00:19:59,090 --> 00:20:02,720
يفتقر صوتها لنشاطه المعتاد، وهي
لا تنخرط في الإيقاع الصّحيح

346
00:20:02,720 --> 00:20:05,590
أعتقد لن يكون من السّهل التخلُّص من توتّرها

347
00:20:03,290 --> 00:20:05,890
تقاربت قلوبنا

348
00:20:05,890 --> 00:20:10,280
بينما نحظى بأوقات جيّدة وأُخرى سيّئة

349
00:20:07,360 --> 00:20:11,320
من دون جمهور، حالتها النّفسية ستتفاقم سوءاً

350
00:20:10,280 --> 00:20:15,110
نمشي بخُطى مُرتبكة

351
00:20:12,600 --> 00:20:15,110
عليكِ أن تبقي هادئة يا ريكّا

352
00:20:16,380 --> 00:20:18,390
عرفتُ بأنّ ذلك لن ينجح

353
00:20:16,380 --> 00:20:20,530
،نُمسك بأيدي بعضنا بإحكام
وتبلغ كلماتنا بعضنا الآخر

354
00:20:18,820 --> 00:20:20,530
لا أحد يتوقّف

355
00:20:20,530 --> 00:20:23,460
وتدفعنا برفق للأمام

356
00:20:21,200 --> 00:20:24,410
لا أحد يستمع إلى أغانيّي

357
00:20:23,460 --> 00:20:26,400
صندوق البريد الدّائريّ، ممرّ المشاة المعتاد

358
00:20:25,700 --> 00:20:28,290
ظننتُ بأنّكِ ستكونين مُستعدّة لذلك

359
00:20:26,400 --> 00:20:28,290
ذلك الوجه المليء بالدّموع، الابتسامة المُشرقة

360
00:20:28,290 --> 00:20:30,460
—جميعها

361
00:20:28,290 --> 00:20:30,460
ربّما تأمّلتُ منكِ الكثير

362
00:20:35,650 --> 00:20:39,020
...آسفة يا آيكو. لا أستطيع فحسب

363
00:20:39,020 --> 00:20:40,080
ريكّا

364
00:20:46,560 --> 00:20:50,530
...ماذا؟ تهنا فانتهى المطاف بنا هنا

365
00:20:50,530 --> 00:20:52,340
!تتصرّفين بصورة مُحرِجة للغاية

366
00:20:52,340 --> 00:20:54,770
!مـ-مهلاً! لا نريد تفويت قطارنا

367
00:20:56,150 --> 00:21:00,610
تخيّلي بأنّنا دوماً في الصّفّ الأماميّ

368
00:21:02,780 --> 00:21:04,240
صحيح، كنتُ قد نسيت

369
00:21:04,240 --> 00:21:06,800
تبّاً لمُحاولة الغناء لكثير من النّاس

370
00:21:06,800 --> 00:21:09,540
سأغنّي فقط لأجل الأشخاص الّذين
أريدهم أن يسمعوا أُغنيتي

371
00:21:13,960 --> 00:21:16,710
"إليكم أغنيتي الثّانية "اطلب القمر

372
00:21:26,970 --> 00:21:31,170
ألّفتُ هذه الأغنية لزميلاتي الثّلاث
في نادي البثّ

373
00:21:31,650 --> 00:21:35,450
لذا إنّهن الوحيدات اللّواتي أحتاج
للغناء لأجلهن

374
00:21:36,630 --> 00:21:40,540
أؤمن بأنّ هاتين اليدين، وصوتي

375
00:21:41,150 --> 00:21:47,100
سيصلون إلى حيث أريدهم أن يصلوا

376
00:21:53,710 --> 00:21:57,160
‏380.000 كم

377
00:21:57,160 --> 00:22:02,170
من مسافة مستحيلة

378
00:21:59,150 --> 00:22:02,170
اتّخذتُ القرار الصّحيح بطلب مُساعدتهن
من باب الحيطة فقط

379
00:22:02,890 --> 00:22:06,680
خطفت قلبي

380
00:22:04,500 --> 00:22:06,680
ماذا؟ إنّها تكذب؟

381
00:22:06,680 --> 00:22:11,040
وسلّطت ضوءاً على عزلتي

382
00:22:06,680 --> 00:22:12,030
أجل. قالت ألّا تأتينَ لأنّها لا تريد
الاعتماد عليكن كثيراً

383
00:22:11,040 --> 00:22:15,760
سواء كانت صدفة أو تعويذة سحريّة

384
00:22:12,040 --> 00:22:13,350
لكن هذا غير صحيح غالباً

385
00:22:13,350 --> 00:22:16,400
بل هي لا تريد أن ترونها تفشل

386
00:22:15,760 --> 00:22:21,330
تبعث الغيوم شُعاعاً من الأمل

387
00:22:16,400 --> 00:22:20,180
إنّها خائفة من أن تنظرنَ إليها نظرة خيبة

388
00:22:20,180 --> 00:22:23,040
!مُحال أن ننظر إليها بهذه الطريقة يا أحمق

389
00:22:21,330 --> 00:22:24,020
هل هذا مُمكن أو مستحيل

390
00:22:23,040 --> 00:22:24,030
!أجل، أبداً

391
00:22:24,020 --> 00:22:26,160
هل سيتحقّق ذلك أم لا

392
00:22:24,030 --> 00:22:25,230
لِمَ تغضبنَ منّي؟

393
00:22:25,230 --> 00:22:27,570
إذاً ما الّذي يمكننا فعله؟

394
00:22:26,160 --> 00:22:29,420
لا أحد يعلم

395
00:22:28,970 --> 00:22:31,450
ليس عليكن مُشاهدة عرضها عن كثب

396
00:22:29,420 --> 00:22:34,330
لهذا السّبب آمل، لهذا السّبب أرحل

397
00:22:31,810 --> 00:22:33,670
كُنّ موجودات لأجل ريكّا فحسب

398
00:22:34,330 --> 00:22:39,230
باستخدامي أحلامي كموطئ قدم

399
00:22:37,460 --> 00:22:39,450
إنّها تتحسّن شيئاً فشيئاً

400
00:22:39,450 --> 00:22:41,230
!استمرّي في جذبهم

401
00:22:41,870 --> 00:22:44,980
!أعلم بأنّ صوتكِ يستطيع بلوغهم يا ريكّا

402
00:22:44,980 --> 00:22:49,740
أرغب في لمس القمر المُتزايد والقمر المُتناقص

403
00:22:49,740 --> 00:22:52,070
مددتُ يدي

404
00:22:52,070 --> 00:22:56,900
حتّى لو كانت خطوة تافهة وصغيرة

405
00:22:56,900 --> 00:22:59,570
سافرتُ عبر كوني

406
00:22:59,570 --> 00:23:05,940
مؤمنة بأنّني سأصل إلى هناك يوماً ما

407
00:23:06,430 --> 00:23:08,780
لدى تلك الفتاة صوت جميل

408
00:23:08,780 --> 00:23:10,210
أتريدين البقاء والاستماع؟

409
00:23:08,780 --> 00:23:13,310
حتّى ولو اضطررتُ لسلوك طريق
لم تدسه قدمي من قبل

410
00:23:13,310 --> 00:23:17,830
،حتّى ولو وسّعتُ حلمي كثيراً
طمعاً بما هو كثير

411
00:23:17,830 --> 00:23:22,640
يدايّ تعبران كوناً طوله 60 سنتيمتراً

412
00:23:22,640 --> 00:23:30,350
وأقترب أكثر من الجانب المُشرق من القمر

413
00:23:31,520 --> 00:23:33,240
راقبني

414
00:23:36,010 --> 00:23:37,020
هل ترى؟