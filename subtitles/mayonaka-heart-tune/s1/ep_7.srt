1
00:00:06,820 --> 00:00:10,910
يشتدّ الحرّ هنا. سأؤدّي أغنية
إضافيّة وأكتفي بهذا القدر

2
00:00:10,910 --> 00:00:13,050
ماذا؟

3
00:00:13,050 --> 00:00:15,200
!أريد أ.ك.ب48

4
00:00:21,110 --> 00:00:24,050
ازداد عدد الجمهور بوضوح
بعد اليوم الرّياضيّ

5
00:00:24,050 --> 00:00:27,930
هناك احتمال حقيقيّ بأن تهزم أغنيتكم
من حيث الشّعبيّة

6
00:00:27,930 --> 00:00:28,760
،رغم ذلك

7
00:00:28,760 --> 00:00:31,720
منذ التقيتُك

8
00:00:29,380 --> 00:00:31,720
لم تعُد تؤدّي أداء في الشّارع

9
00:00:31,720 --> 00:00:34,180
هل تؤلّف أي أغنية فعلاً؟

10
00:00:31,720 --> 00:00:35,080
كان قلبي ينبض

11
00:00:35,080 --> 00:00:37,830
ولا يتوقّف أبداً

12
00:00:36,840 --> 00:00:38,180
من تلك الفتاة؟

13
00:00:37,830 --> 00:00:41,390
هذا يُزعجني بعض الشّيء

14
00:00:41,390 --> 00:00:44,400
...صباح الخير، وداعاً

15
00:00:46,670 --> 00:00:47,690
ما الأمر؟

16
00:00:47,690 --> 00:00:48,770
هل نسيتْ كلمات أُغنيتها؟

17
00:00:48,770 --> 00:00:50,510
ربّما انقطع وتر من أوتار الغيتار

18
00:00:53,150 --> 00:00:56,290
آسفة، يكفي لليوم. أراكم
في المرّة المُقبلة

19
00:00:56,290 --> 00:00:58,790
...بئساً

20
00:01:01,010 --> 00:01:02,260
المعذرة

21
00:01:04,890 --> 00:01:07,580
هل يمكنني التكلُّم معكِ قليلاً؟

22
00:01:11,930 --> 00:01:15,280
مرحباً؟ ألا يمكنك سماعي؟

23
00:01:19,610 --> 00:01:21,050
!أنتِ

24
00:01:25,620 --> 00:01:27,320
اسمي يامابوكي، وأنتِ؟

25
00:01:32,030 --> 00:01:36,060
!حسناً، حسناً. أنا آسفة لتجاهلك
!لذا لا تفعلها

26
00:01:36,060 --> 00:01:37,790
يسرّني أنّكِ تستطيعين رؤيتي

27
00:01:37,790 --> 00:01:41,170
كنتُ خائفاً أن أكون قد مُتُّ
وأصبحتُ شبحاً

28
00:01:41,170 --> 00:01:42,160
لماذا تجاهلتِني؟

29
00:01:42,160 --> 00:01:44,170
لأنّك بدوت مُزعجاً

30
00:01:44,170 --> 00:01:48,460
،اطمئنّي، فأنا عكس ذلك. في الواقع
اسمحي لي أن أدرج عشرة أسباب

31
00:01:48,460 --> 00:01:50,130
!إ-إذاً أنت مُزعج

32
00:01:50,410 --> 00:01:54,490
أردتُ فقط أن أسألكِ عن سبب
شعوركِ بالإحباط آنذاك

33
00:01:54,490 --> 00:01:56,810
هل هناك ما لم يُعجبكِ في عرض إينوهانا؟

34
00:01:56,810 --> 00:01:58,430
سناً، ما رأيك؟

35
00:01:58,740 --> 00:01:59,880
أقصد بعرضها

36
00:01:59,880 --> 00:02:01,850
أظنّها تبلي بلاء حسناً

37
00:02:02,140 --> 00:02:05,560
،إنّها تألف الأغاني الشّهيرة

38
00:02:05,560 --> 00:02:08,470
وهي ماهرة في تقليد أسلوب
الغناء الأصليّ

39
00:02:08,470 --> 00:02:10,590
لكن... تبدو أنّها خجولة

40
00:02:10,590 --> 00:02:11,570
أتعرف ما يعنيه هذا؟

41
00:02:11,570 --> 00:02:15,360
.الأغاني هي الشّهيرة، وليس هي
أيّ شيء آخر يمكن أن يغطّي على ذلك

42
00:02:16,550 --> 00:02:19,240
...لم تكن هكذا من قبل

43
00:02:20,280 --> 00:02:22,180
هل أنتِ صديقتها؟

44
00:02:23,170 --> 00:02:24,610
هل أنت راضٍ الآن؟

45
00:02:25,030 --> 00:02:26,430
ليس تماماً

46
00:02:27,090 --> 00:02:29,510
اسمحي لي أن أطرح بضعة أسئلة

47
00:02:29,510 --> 00:02:31,670
!من أين لك هذه السّرعة؟ هذا جنون

48
00:02:36,540 --> 00:02:39,480
عليّ العمل على أغانيّي الأصليّة

49
00:02:51,600 --> 00:02:56,070
ربّما كان ينبغي أن أخبر يامابوكي-كن
بأنّ هذا قد يكون صعباً جدّاً عليّ

50
00:02:57,100 --> 00:02:59,070
أحضرتُ لكِ مياه غازيّة بالبطّيخ

51
00:02:59,070 --> 00:03:02,490
ماذا؟ لكن لم أطلب هذه؟

52
00:03:02,490 --> 00:03:04,460
ألا تريدينها؟

53
00:03:04,460 --> 00:03:06,280
في هذه الحالة، سأشرب من ناحيتي

54
00:03:08,080 --> 00:03:10,540
كيف عرفت بأنّني سأكون هنا؟

55
00:03:10,950 --> 00:03:15,420
.أخبرتني صديقتُك القديمة
في الواقع أعرفها أيضاً

56
00:03:15,420 --> 00:03:16,840
!تعرف آيكو؟

57
00:03:17,650 --> 00:03:19,610
اسمها آيكو إذاً؟

58
00:03:19,610 --> 00:03:22,520
كانت عسيرة حقّاً. لم تكن
تعطيني اسمها حتّى

59
00:03:22,520 --> 00:03:24,100
...وقعتُ في فخّه

60
00:03:24,460 --> 00:03:27,340
،بدتْ ضجرانة وهي تشاهد عرضك

61
00:03:27,340 --> 00:03:28,880
لذا تحادثتُ معها قليلاً

62
00:03:29,620 --> 00:03:30,980
ماذا قالت؟

63
00:03:31,450 --> 00:03:35,880
تعابير وجهك تخبرني بالفعل
بأنّ لديك فكرة جيّدة

64
00:03:35,880 --> 00:03:37,360
...أجل

65
00:03:37,670 --> 00:03:41,530
آيكو تكرهني لأنّني لا أغطّي
سوى الأغاني الشّهيرة

66
00:03:41,850 --> 00:03:45,250
لأنّها أحبّت الأغاني الّتي ألّفتُها

67
00:03:45,250 --> 00:03:47,830
إذاً أدّي الأغاني الأصليّة في عرضكِ فقط

68
00:03:47,830 --> 00:03:48,740
لا أريد

69
00:03:48,740 --> 00:03:49,920
...لِمَ لا

70
00:03:50,410 --> 00:03:54,090
لن أخبرك. إنّه شيء يدعو للإحراج

71
00:03:54,090 --> 00:03:58,610
لكن هذه مُشكلة. من واجبي
تحويلك إلى محترفة

72
00:03:58,610 --> 00:04:00,720
ما الّذي يجب أن أفعله لإقناعكِ بإخباري؟

73
00:04:02,370 --> 00:04:04,010
هذه غرفة كاراوكي

74
00:04:04,350 --> 00:04:05,860
عليك أن تغنّي

75
00:04:06,430 --> 00:04:07,940
معركة كاراوكي

76
00:04:08,240 --> 00:04:10,650
سأخبرك إذا أدّيت أداء أفضل منّي

77
00:04:10,650 --> 00:04:15,100
معركة غناء ضدّ مُغنٍّ مُلهم؟
!أنتِ لا تنوين إخباري حقّاً

78
00:04:15,100 --> 00:04:17,080
لكن أقبل تحدّيكِ

79
00:04:17,080 --> 00:04:18,780
سأبدأ أوّلاً إذاً

80
00:04:18,780 --> 00:04:19,910
لحظة، لحظة

81
00:04:19,910 --> 00:04:21,870
أُطالب بأفضليّة

82
00:04:21,870 --> 00:04:24,030
ستغنّين أغنية أختارها أنا

83
00:04:24,480 --> 00:04:28,280
.إنّها الأُغنية الّتي غنّيتِها في عرضكِ البارحة
لا اعتراض ذلك، صحيح؟

84
00:04:28,280 --> 00:04:29,950
أجل، لا مانع لديّ

85
00:04:29,950 --> 00:04:32,220
لكن عليك أن تؤدّي الرّقص أيضاً

86
00:04:32,220 --> 00:04:33,100
ماذا؟

87
00:04:37,000 --> 00:04:38,550
ماذا؟ لماذا؟

88
00:04:38,550 --> 00:04:40,510
كما قلتُ، إنّها أفضليّة

89
00:04:40,510 --> 00:04:42,010
هيّأ. إنّها على وشك البدء

90
00:04:42,010 --> 00:04:44,860
ماذا؟ لحظة، ماذا؟

91
00:04:50,070 --> 00:04:52,300
منذ التقيتُك

92
00:04:52,300 --> 00:04:55,350
كان قلبي ينبض بسرعة

93
00:04:55,350 --> 00:04:57,840
ولا يتوقّف أبداً

94
00:04:57,000 --> 00:04:58,320
النّصر لي

95
00:05:00,000 --> 00:05:01,910
توقّعتُ هذا أثناء عرضك أيضاً

96
00:05:01,910 --> 00:05:06,790
تصبحين خجولة وتعطين انطباعاً بأنّكِ
"أفعل هذا لأنّني مضطرّة فقط"

97
00:05:06,790 --> 00:05:09,290
مُتمنّية أن نقرأ شيئاً بين سطوركِ

98
00:05:11,290 --> 00:05:14,810
لا بُدّ أنّ هذا السّلوك الدّفاعيّ
هو ما أغضب صديقتكِ

99
00:05:31,650 --> 00:05:34,030
منذ التقيتُك

100
00:05:34,030 --> 00:05:37,090
كان قلبي ينبض بسرعة

101
00:05:37,090 --> 00:05:39,360
ولا يتوقّف أبداً

102
00:05:39,360 --> 00:05:42,610
هذا يُزعجني بعض الشّيء

103
00:05:42,610 --> 00:05:45,390
صباح الخير، وداعاً

104
00:05:45,390 --> 00:05:48,130
ثمّ اللّيالي العاديّة

105
00:05:48,450 --> 00:05:53,140
تجعلني أُفكّر فيك

106
00:05:53,750 --> 00:05:56,460
"أريد القول "أصبحت أطول

107
00:05:56,460 --> 00:05:59,460
"نستخدم نفس المفكّرة"

108
00:05:59,460 --> 00:06:03,980
شكراً لك على ذلك اليوم" والمزيد"

109
00:06:04,740 --> 00:06:10,930
لكن ما زلتُ لا أستطيع إلزام نفسي

110
00:06:13,690 --> 00:06:19,170
متى سمعتُ صوتك، تبرق عيناي

111
00:06:19,170 --> 00:06:24,090
لا يبدو أنّني أستطيع إخراجك من عقلي

112
00:06:24,090 --> 00:06:25,780
!هـ-هذه الفتاة

113
00:06:24,090 --> 00:06:29,740
ثمّة شيء أريد أن أخبرك به وجهاً لوجه

114
00:06:27,370 --> 00:06:29,240
!إنّها أكثر شراسة ممّا توقّعت

115
00:06:29,740 --> 00:06:33,880
هذا ما أشعر به

116
00:06:33,880 --> 00:06:35,750
أنا واقعة في حبّك

117
00:06:35,750 --> 00:06:37,550
...أ-أنتِ

118
00:06:39,180 --> 00:06:42,460
إ-إذاً كيف تقول أنّني خجولة؟

119
00:08:30,060 --> 00:08:32,030
أجل، ينبغي لهذا أن يفي بالغرض

120
00:08:32,030 --> 00:08:33,340
ما-ماذا؟

121
00:08:33,340 --> 00:08:34,620
هذه مُشكلة

122
00:08:35,140 --> 00:08:36,450
إمّا المُجازفة أو الموت

123
00:08:36,780 --> 00:08:38,590
!سأراهن بكلّ شيء على هذه الأُغنية

124
00:08:39,660 --> 00:08:41,530
آمل أن تجهّزي دواءكِ

125
00:08:42,000 --> 00:08:44,170
فمُحدّثكِ لديه صوت جميل

126
00:08:44,170 --> 00:08:46,210
قد يُشعركِ بالنّشوة، لذا احذري

127
00:09:01,860 --> 00:09:07,120
لستُ شخصاً مُميّزاً

128
00:09:07,120 --> 00:09:10,380
أعي ذلك تماماً

129
00:09:08,150 --> 00:09:11,410
توقّعتُ ذلك عندما أدّينا ذلك
العرض معاً في الرّبيع

130
00:09:10,380 --> 00:09:16,070
لهذا السّبب، كلّما تكلّمنا

131
00:09:11,790 --> 00:09:13,780
والأمر هو نفسه الآن

132
00:09:14,240 --> 00:09:17,160
إنّه ليس جيّداً جدّاً في الغناء

133
00:09:16,070 --> 00:09:20,960
أتجاهلك

134
00:09:17,690 --> 00:09:20,330
...لكن... هذه الأغنية

135
00:09:24,000 --> 00:09:26,240
!لا بُدّ أنّ الآلة مُعطّلة

136
00:09:26,240 --> 00:09:28,780
!هذه العلامة غير مقبولة بالنّسبة ليامابوكي

137
00:09:28,780 --> 00:09:30,260
الفارق 20 نقطة؟

138
00:09:30,260 --> 00:09:33,500
لـ-لحظة! 20 نقطة هي جوهريّاً
!هامش الخلل

139
00:09:33,500 --> 00:09:35,720
لماذا غنّيت تلك الأُغنية؟

140
00:09:38,540 --> 00:09:41,200
هل يمكنني أن أسألك سؤالاً أخيراً؟

141
00:09:41,200 --> 00:09:42,230
ماذا؟

142
00:09:42,230 --> 00:09:44,550
شعار الفرقة على قميصك

143
00:09:44,550 --> 00:09:45,560
هل تحبّين تلك الفرقة؟

144
00:09:45,560 --> 00:09:48,860
هذه؟ أجل، أحبّها

145
00:09:49,140 --> 00:09:51,240
إنّها الفرقة الّتي أحبّتها ريكّا

146
00:09:52,730 --> 00:09:54,540
!اسمع يا أريسو

147
00:09:54,540 --> 00:09:56,610
!وجدتُ هذه الفرقة المُذهلة

148
00:09:56,610 --> 00:09:59,910
...إنّها ليست معروفة، لكن تُدعى

149
00:09:59,910 --> 00:10:03,370
هاغ نوتس؟ أحبّها

150
00:10:03,690 --> 00:10:05,730
نصحني شخصٌ ما بها

151
00:10:08,980 --> 00:10:10,010
حسناً

152
00:10:10,400 --> 00:10:13,920
سأخبرك بسبب عدم غنائي أغانٍ أصليّة

153
00:10:13,920 --> 00:10:15,510
!هل أنتِ متأكّدة؟ لقد خسرتُ

154
00:10:15,510 --> 00:10:18,960
قلتُ من يبلي بشكل أفضل يربح

155
00:10:18,960 --> 00:10:23,090
العلامات غير مُملّة. كانت أُغنيتك أفضل

156
00:10:25,980 --> 00:10:27,610
!أجل

157
00:10:27,610 --> 00:10:29,780
أنت تكره الخسارة حقّاً

158
00:10:30,440 --> 00:10:33,450
،حدثتْ أمور في ماضيّي

159
00:10:33,450 --> 00:10:36,700
والآن لا أستطيع غناء أغانيّي
الأصليّة أمام النّاس

160
00:10:36,700 --> 00:10:38,000
اشرحي أكثر

161
00:10:38,000 --> 00:10:39,740
أنا خائفة

162
00:10:40,160 --> 00:10:44,750
من نظرات النّاس عندما يحكمون
عليّ أو أعتقد بأنّني مُحبِطة

163
00:10:45,200 --> 00:10:49,380
لكن أغاني المشاهير أسهل بكثير، لأنّني
أستطيع الاختباء خلف موسيقى الآخرين

164
00:10:50,530 --> 00:10:51,840
جبانة، أليس كذلك؟

165
00:10:52,650 --> 00:10:56,370
فهمت. إنّها خائفة من عينَي
الجمهور الانتقاديّة

166
00:10:56,370 --> 00:11:00,450
صدمة مُباشرة، وحرجة أيضاً

167
00:11:00,450 --> 00:11:02,890
إن لم تُعالج نفسها من ذلك، فلا مُستقبل لها

168
00:11:03,150 --> 00:11:05,820
،كنتُ أُحاول تأليف أغنية جديدة

169
00:11:05,820 --> 00:11:09,010
لن تذكّر تلك العيون يوقفني عند حدّي

170
00:11:09,010 --> 00:11:11,470
هذا يؤثّر على تأليف الأغاني أيضاً

171
00:11:11,470 --> 00:11:13,550
ماذا يجدر بي أن أفعل؟

172
00:11:13,550 --> 00:11:17,410
صحيح. يجب علينا فعل هذا
على طريقة يامابوكي

173
00:11:17,410 --> 00:11:19,410
أنتِ خائفة من نظرات النّاس إليكِ؟

174
00:11:19,870 --> 00:11:22,130
كنتُ كذلك أيضاً

175
00:11:22,760 --> 00:11:24,740
تعلم بأنّ هذا شايّي، صحيح؟

176
00:11:24,740 --> 00:11:27,840
ترتّب عليّ المُشاركة في العديد
من الأنشطة خارج المنهاج

177
00:11:29,120 --> 00:11:31,640
التّقديم والخطاب كانت جزءاً من ذلك

178
00:11:31,640 --> 00:11:35,460
النّظرة الثّاقبة للجمهور هي
شيء أعرفه خير معرفة

179
00:11:36,320 --> 00:11:39,120
كيف تغلّبت على خوفك؟

180
00:11:40,100 --> 00:11:41,760
حتّى لو كنتِ لا تستطيعين
،تأليف أُغنية جديدة

181
00:11:41,760 --> 00:11:43,810
ما زال لديكِ أغانٍ قديمة، صحيح؟

182
00:11:43,810 --> 00:11:46,350
ماذا؟ حقّاً؟

183
00:11:47,210 --> 00:11:48,900
إذاً ما يجب علينا فعله واضح

184
00:11:48,900 --> 00:11:52,350
سنقيم "حفل مدرسيّ لأغاني
"إينوهانا ريكّا الأصليّة

185
00:11:52,350 --> 00:11:53,110
ماذا؟

186
00:11:53,110 --> 00:11:57,320
.عليك الاعتياد على ذلك فحسب
فالخبرة هي كلّ شيء

187
00:11:59,330 --> 00:12:00,850
!لا تُقرّر عنّي

188
00:12:00,850 --> 00:12:05,190
،لا داعي لتكون أُغنية جديدة
لكن يمكنك أداء أغانيكِ الخاصّة

189
00:12:05,590 --> 00:12:08,210
ألا تُلاحظ بأنّك عديم الإحساس بعض الشّيء؟

190
00:12:08,210 --> 00:12:12,120
.هذا طبيعيّ بالنّسبة لعائلة يامابوكي
حتّى أنت ينبغي أن تستطيعي فعلها

191
00:12:14,370 --> 00:12:15,540
حسناً، فهمت

192
00:12:15,540 --> 00:12:18,680
...ممتاز. والآن بالنّسبة للتّوقيت

193
00:12:18,680 --> 00:12:20,820
!سنقيم حفلاً غنائيّاً بعد أسبوع من الآن

194
00:12:30,340 --> 00:12:35,340
ظننتُكِ ستفهمين شعوري، لكن
أعتقد بأنّني كنتُ مخطئاً

195
00:12:37,150 --> 00:12:41,630
في النّهاية، لست عاديّاً مثلي

196
00:12:41,630 --> 00:12:44,950
هل أنت نفس ذلك الشّخص؟

197
00:12:44,950 --> 00:12:47,700
ظننتُكِ ستكونين مُستعدّة لذلك

198
00:12:47,700 --> 00:12:49,800
ربّما تأمّلتُ منكِ الكثير

199
00:13:03,920 --> 00:13:07,520
آسفة يا يامابوكي-كن. لا أظنّني
...أستطيع فعلاً

200
00:13:07,520 --> 00:13:09,580
أتيتِ أخيراً

201
00:13:09,580 --> 00:13:11,080
!السّطح مُخيف

202
00:13:11,080 --> 00:13:13,690
سنتمكّن من سماع أغنيتكِ الأصليّة
!بعد فترة طويلة يا ريكّا-تشان

203
00:13:14,040 --> 00:13:15,730
!مرحى

204
00:13:15,730 --> 00:13:19,360
ماذا؟ لماذا جميعكم هنا؟
أين المُتفرّجون الآخرون؟

205
00:13:19,360 --> 00:13:21,110
لا يوجد غيرنا نحن الأربعة

206
00:13:21,110 --> 00:13:23,700
هل حسبتِ بأنّني سأرميكِ للذّئاب؟

207
00:13:23,700 --> 00:13:25,450
،من أجل الاعتياد على نظرة الجمهور

208
00:13:25,450 --> 00:13:27,620
نبدأ مع الأصدقاء والعائلة

209
00:13:28,940 --> 00:13:32,880
كان ينبغي أن تخبرينا إذا كنّا نستطيع
مساعدتكِ في التغلُّب على ذلك

210
00:13:32,880 --> 00:13:35,630
سنُراقبكِ بعين صادقة

211
00:13:35,630 --> 00:13:38,130
!سنحظى بمقاعد ذهبيّة! هذا رائع للغاية

212
00:13:41,680 --> 00:13:44,180
لا تقلقي. أقفلتُ الباب

213
00:13:44,180 --> 00:13:48,390
.ليس لديكِ إلّا حلفاء هنا
تخلّصي من خوفكِ وغنّي لأجلنا

214
00:13:53,040 --> 00:13:54,650
...المعذرة

215
00:13:54,960 --> 00:13:58,260
مضى وقت طويل منذ شغّلتُ
أغانيّي آخر مرّة، صحيح؟

216
00:13:58,630 --> 00:14:00,570
...حسناً، تبّاً

217
00:14:00,570 --> 00:14:02,400
لا أعرف ما يجب عليّ قوله

218
00:14:02,700 --> 00:14:06,790
هل افترضتُ بالخطأ بأنّها ستتمكّن
من فعلها أمام الأصدقاء؟

219
00:14:06,790 --> 00:14:10,790
يبدو أنّ صدمتها عميقة جدّاً. ماذا أفعل الآن؟

220
00:14:11,110 --> 00:14:12,280
...آسفة

221
00:14:12,280 --> 00:14:13,340
!ريكّا

222
00:14:12,280 --> 00:14:13,340
!ريكّا-تشان

223
00:14:16,970 --> 00:14:20,370
دائماً ما تتظاهرين بالهدوء
ولا تخبريننا بشيء

224
00:14:20,370 --> 00:14:22,670
ينبغي لكِ أن تُنفّسي عمّا بداخلكِ أحياناً

225
00:14:22,930 --> 00:14:27,550
،صنعنا هذه في اللّحظات الأخيرة
لكنّنا سنُحسن صنعها فعلاً في المرّات القادمة

226
00:14:27,550 --> 00:14:31,810
تخيّلي بأنّنا في الصّفّ الأوّل دوماً

227
00:14:32,100 --> 00:14:35,600
انظري إلينا فقط عندما يتأزّم الأمر، حسناً؟

228
00:14:39,670 --> 00:14:42,070
أجل، حسناً

229
00:14:52,480 --> 00:14:54,620
ستصبحين مُغنّية يا ريكّا-تشان؟

230
00:14:54,620 --> 00:14:57,810
هل ستعتلين المسرح في قبّة طوكيو ذات يوم؟

231
00:14:57,810 --> 00:15:01,010
أريد رؤيتكِ تغنّين في مسرح ضخم

232
00:14:58,820 --> 00:15:03,290
بينما ننظر للسّماء الزّرقاء الواسعة

233
00:15:01,290 --> 00:15:04,520
استخدمي علاقاتكِ وضعينا في الصّفّ الأوّل

234
00:15:03,290 --> 00:15:06,560
في رسائل بيضاء برّاقة

235
00:15:04,520 --> 00:15:07,950
سيكون هذا رائعاً! قريب
!بما يكفي لرؤية وجهكِ

236
00:15:06,560 --> 00:15:11,040
كتبنا عن أهدافنا، كتبنا عن مُستقبلنا

237
00:15:08,460 --> 00:15:12,590
أجل... لقد قطعتُ وعداً

238
00:15:11,040 --> 00:15:14,410
وطليته بأحلامك

239
00:15:13,480 --> 00:15:17,030
بأن أضعهم في الصّفّ الأوّل في حفلتي

240
00:15:14,770 --> 00:15:20,040
وأقول "أراك غداً" لكلّ عابر

241
00:15:20,040 --> 00:15:22,980
تقاربت قلوبنا

242
00:15:25,560 --> 00:15:30,410
لا أصدّق بأنّك خدعتني. أحسنت
في تدمير ثِقتي بك

243
00:15:30,410 --> 00:15:34,960
آ-آسف. ارتأيتُ بأنّكِ لن تتوتّري
إذا أخبرتُكِ سلفاً

244
00:15:34,960 --> 00:15:36,410
الاعتذار مرفوض

245
00:15:36,410 --> 00:15:38,200
كيف أعوّض ما فعلتُه؟

246
00:15:40,130 --> 00:15:43,180
ادعني إلى الكاراوكي وساعدني في التّمرين

247
00:15:43,180 --> 00:15:45,690
إذا كان هذا سيستعيد ثِقتك، حسناً

248
00:15:45,690 --> 00:15:48,040
لكن مرّة واحدة غير كافية غالباً

249
00:15:48,040 --> 00:15:50,300
!هل انخفضت نقاطي إلى هذا الحدّ؟

250
00:15:50,300 --> 00:15:53,840
ما-ماذا أصبحت نقاطي الآن؟

251
00:15:55,420 --> 00:15:58,870
كانت 100 في السّابق. إنّها
الآن حوالي 80

252
00:15:58,870 --> 00:16:00,610
!انخفضتْ 20 نقطة

253
00:16:04,940 --> 00:16:07,310
في وسط فضائنا الخارجيّ

254
00:16:07,310 --> 00:16:12,580
نُحكم السّيطرة على عقلنا
الّذي لا نجده إلّا هنا

255
00:16:12,580 --> 00:16:14,590
يبدأ بالجري والجري

256
00:16:12,580 --> 00:16:15,940
تلك الأغنية، والّتي ألّفَتْها غالباً
،منذ مدّة طويلة

257
00:16:14,590 --> 00:16:19,380
تغدو دفئاً مجهولاً في قلوبنا

258
00:16:16,610 --> 00:16:20,370
كانت غير مُكتملة لكن تمثّل إينوهانا حرفيّاً

259
00:16:20,370 --> 00:16:24,590
وعالمنا

260
00:16:21,200 --> 00:16:26,560
،وقد لامسَتِ القلوبَ حقّاً
حتّى لو كان البُكاء مُبالغاً به

261
00:16:27,570 --> 00:16:32,410
أجهل سبب ختمها على تلك الموهبة

262
00:16:33,560 --> 00:16:37,630
لكنّها تقدّمتْ خطوة بفضل زميلاتها في النّادي

263
00:16:40,760 --> 00:16:46,900
ارتأيتُ أن أرشدهن بنفسي، لكن
كان ذلك غروراً من جانب مُحدّثكم

264
00:16:48,010 --> 00:16:51,120
،عندما يتنافسن ذات يوم

265
00:16:51,600 --> 00:16:54,420
فغالباً لن أكون أنا من يُساعدهن
،على تجاوز ذلك

266
00:16:55,560 --> 00:16:57,950
إنّما الرّوابط بينهن

267
00:17:02,470 --> 00:17:04,000
،بوضع ذلك في الحسبان

268
00:17:04,360 --> 00:17:09,090
لِمَ لا تتنزّهن أنتن الأربعة وتستمتعن
معاً لدعم توحّدكن؟

269
00:17:09,360 --> 00:17:10,660
لماذا مركز التسوُّق؟

270
00:17:10,660 --> 00:17:12,280
تحبّ أختي الصّغرى هذا المكان

271
00:17:12,280 --> 00:17:13,510
هل تريد شراء شيء هنا؟

272
00:17:13,510 --> 00:17:15,410
أريد شراء حذاء رياضيّ لأختي الصّغرى

273
00:17:15,410 --> 00:17:18,390
لماذا اخترتَ مكاناً بعيداً جدّاً؟

274
00:17:18,390 --> 00:17:21,420
،لدى هذا المكان بوظة بارفيه لذيذة
أو هذا ما قالته أختي الصّغرى

275
00:17:21,420 --> 00:17:22,900
!أختي، أختي! اذهب معها إذاً

276
00:17:22,900 --> 00:17:26,050
لم نتنزّه معاً كثيراً مؤخّراً، صحيح؟

277
00:17:26,050 --> 00:17:28,700
التّحضير لليوم الرّياضيّ أشغلنا جميعاً

278
00:17:28,700 --> 00:17:30,740
!أريد شراء بعض الملابس الجديدة

279
00:17:30,740 --> 00:17:33,940
.يمكنكن الاستمتاع كيفما تشأن
لا تلقينَ بالاً لغلام المهام

280
00:17:33,940 --> 00:17:35,930
لا ألقي بالاً بك أصلاً

281
00:17:35,930 --> 00:17:37,010
!انتظري

282
00:17:37,460 --> 00:17:39,770
أخبرتُكن أن تستمتعن معاً

283
00:17:40,500 --> 00:17:42,160
سيّد غلام المهام

284
00:17:42,160 --> 00:17:44,380
إن كنتَ مُتفرّغاً، فهلّا ساعدتني
في اختيار ملابس؟

285
00:17:44,380 --> 00:17:47,910
لا أُمانع، لكن ألن يكون من الأفضل
الطّلب من الفتيات بدلاً من ذلك؟

286
00:17:47,910 --> 00:17:49,170
،في الحقيقة

287
00:17:49,590 --> 00:17:51,390
زدتُ وزناً مؤخّراً

288
00:17:51,390 --> 00:17:54,040
لا أريدهن أن يعرفن

289
00:17:54,040 --> 00:17:56,260
لكن هل من المُناسب أن أعرف أنا؟

290
00:17:57,020 --> 00:17:58,350
يامابوكي-كن

291
00:17:58,350 --> 00:17:59,700
لنذهب

292
00:18:03,260 --> 00:18:04,850
ما رأيك بهذا؟

293
00:18:05,740 --> 00:18:06,890
وهذا؟

294
00:18:08,090 --> 00:18:09,780
أليس هذا مُلفتاً زيادة عن اللّزوم؟

295
00:18:10,110 --> 00:18:14,630
.مُتّزن، لكن أقلّ لا يعني أكثر دوماً
ثمانية وسبعون نقطة

296
00:18:14,630 --> 00:18:17,200
لم أتوقّع أن تحاول جاهداً لمُساعدتي

297
00:18:17,200 --> 00:18:18,330
،على أيّ حال

298
00:18:18,330 --> 00:18:20,220
جرّبتِ الملابس البيضاء فقط

299
00:18:20,220 --> 00:18:21,960
لأنّني أحبّ الأبيض

300
00:18:22,940 --> 00:18:25,700
أرتدي زيّاً أبيض الآن

301
00:18:25,700 --> 00:18:27,040
أحبّ الأبيض كما تعلم

302
00:18:27,040 --> 00:18:31,010
على ذكر الأمر، قالت أبّولو كلاماً مُشابهاً

303
00:18:31,010 --> 00:18:35,200
لا أنفكّ أرى آثاراً من أبّولو
،في هؤلاء الفتيات بين الحين والآخر

304
00:18:35,200 --> 00:18:36,930
لكن ما زلتُ أفتقر للدّليل القاطع

305
00:18:37,200 --> 00:18:39,500
...كثير من النّاس يحبّون اللّون الأبيض

306
00:18:39,500 --> 00:18:40,600
إذاً، أخبرني

307
00:18:40,980 --> 00:18:45,520
هل صمتك يعني أنّك تُحبّ
هذا الزيّ المُلفت؟

308
00:18:46,070 --> 00:18:47,000
!مُحال

309
00:18:47,000 --> 00:18:49,360
أجل، إنّه الأفضل حتّى الآن

310
00:18:49,870 --> 00:18:51,160
تبدين ظريفة جدّاً

311
00:18:51,160 --> 00:18:51,940
...ظـ

312
00:18:53,330 --> 00:18:56,320
لـ-لم أطلب منك أن تتطرّق
...إلى كلّ هذه التّفاصيل

313
00:18:59,540 --> 00:19:02,620
لحظة، إلى أين ذهبت الأُخريات الثّلاثة؟

314
00:19:02,620 --> 00:19:05,990
!باكي! ساعدني

315
00:19:06,830 --> 00:19:09,630
!إنّها حالة طارئة! تعال معي حالاً

316
00:19:11,130 --> 00:19:14,720
إنّها عالقة في القفص! بعد
!أن أنفقتُ 1000 ين أيضاً

317
00:19:14,720 --> 00:19:16,630
وتريدين منّي إخراجها؟

318
00:19:16,630 --> 00:19:18,930
أرجوك. أريدها بشدّة

319
00:19:18,930 --> 00:19:22,680
مُحدّثكِ بارع في ألعاب الرّافعة

320
00:19:22,680 --> 00:19:23,770
راقبي فحسب

321
00:19:25,800 --> 00:19:29,250
لدى المخلب قوّة قبضة ضعيفة

322
00:19:29,250 --> 00:19:33,070
،لذا بدلاً من استعمالها للإمساك
نستعملها للدّفع

323
00:19:35,710 --> 00:19:38,430
!توقّف! الحشوة على وشك أن تخرج

324
00:19:38,430 --> 00:19:40,730
مُحدّثكِ ماهر أيضاً في الحياكة

325
00:19:40,730 --> 00:19:42,580
!أريدها سليمة

326
00:19:43,650 --> 00:19:45,120
!ذا هو مُحدّثكِ

327
00:19:45,600 --> 00:19:46,420
تفضّلي

328
00:19:49,200 --> 00:19:50,340
ماذا تفعلين؟

329
00:19:50,340 --> 00:19:52,380
أجعلها عبِقة برائحتي

330
00:19:52,380 --> 00:19:54,940
لا أريد أن تكون رائحتها غير مألوفة

331
00:19:57,240 --> 00:19:58,460
،عندما كنتُ صغيرة

332
00:19:58,460 --> 00:20:02,240
لم أستطع النّوم دون دُمية محشوّة
تفوح منها رائحتي

333
00:20:02,240 --> 00:20:04,830
إنّها تبدو مثلها أيضاً الآن

334
00:20:04,830 --> 00:20:05,980
—هل هذه العادة

335
00:20:05,980 --> 00:20:09,190
.يمكنك الذّهاب الآن يا باكي
شكراً على المُساعدة

336
00:20:10,210 --> 00:20:11,440
!بئساً

337
00:20:11,440 --> 00:20:13,440
!جميعهن يفعلنَ ما يشأن فحسب

338
00:20:13,440 --> 00:20:15,780
!لا جدوى إن لم يتنزّهن معاً

339
00:20:15,780 --> 00:20:18,400
!يا غلام المهام

340
00:20:18,400 --> 00:20:22,280
أتريد بعضاً من التّاكوياكي؟ طلبتُ كمّية كبيرة

341
00:20:22,770 --> 00:20:26,270
قلتُ لكِ ألّا تُناديني بغلام المهام
بصوتٍ عالٍ علناً

342
00:20:26,270 --> 00:20:28,630
...ما المُشكلة؟ إن لم أنادِك بذلك، فإذاً

343
00:20:28,630 --> 00:20:29,620
فإذاً ماذا؟

344
00:20:30,490 --> 00:20:33,280
إذاً لا شيء. تعال وكُل

345
00:20:33,280 --> 00:20:36,300
مينتاي مايو هي أفضل وسيلة لأكل التّاكوياكي

346
00:20:36,300 --> 00:20:37,670
دائماً ما أطلب تلك النّكهة

347
00:20:37,670 --> 00:20:40,740
.دعيني أسألكِ سؤالاً
ما النّكهة الّتي طلبتِها؟

348
00:20:40,740 --> 00:20:42,780
ماذا؟ ملح وبصل أخضر، لماذا؟

349
00:20:42,780 --> 00:20:44,310
حسناً

350
00:20:44,310 --> 00:20:45,600
طلبتُ مينتاي مايو كذلك

351
00:20:45,600 --> 00:20:46,900
!حقّاً؟

352
00:20:46,900 --> 00:20:50,490
ماذا أصابك؟ هل تحبّ مينتاي مايو
إلى هذه الدّرجة؟

353
00:20:51,130 --> 00:20:52,750
لنأكل

354
00:20:53,790 --> 00:20:55,820
آسف، هل لي بعود أسنان؟

355
00:20:55,820 --> 00:20:56,890
هيّا

356
00:20:57,770 --> 00:20:59,200
افتح فمك

357
00:20:59,200 --> 00:21:01,240
لماذا تُطعمينني؟

358
00:21:01,240 --> 00:21:05,150
ماذا يُفترض بي أن أفعل غير ذلك؟
لدينا عود الأسنان هذا فقط

359
00:21:12,290 --> 00:21:13,920
ما رأيك؟ هل تبدو جيّدة؟

360
00:21:15,380 --> 00:21:16,910
تبدو جيّدة"؟"

361
00:21:16,910 --> 00:21:18,130
"تقصدين "مذاقها جيّد

362
00:21:18,130 --> 00:21:21,050
لا بُدّ أنّه لشعور رائع أن تُطعَم
بواسطة فتاة صغيرة مثلي

363
00:21:22,430 --> 00:21:26,140
عـ-على أيّ حال، هل تعرفين أين إينوهانا؟

364
00:21:28,380 --> 00:21:30,170
تقول بأنّها تُشاهد البطّ عند النّهر

365
00:21:30,170 --> 00:21:32,150
!لماذا غادرت مركز التسوُّق؟

366
00:21:32,150 --> 00:21:34,980
!سأذهب لإحضارها بالقوّة
!شكراً على التّاكوياكي

367
00:21:36,680 --> 00:21:39,250
كان بمقدورك أن تتصرّف بارتباك أكبر

368
00:21:39,850 --> 00:21:42,200
ماذا كانت الفائدة من استفزازك إذاً؟

369
00:21:43,420 --> 00:21:48,160
قلتُ أن تستمتعن معاً، لكن
،بما أنّكن ترفضن فعل ما أُمليه

370
00:21:48,160 --> 00:21:50,710
فأحتاج إلى تغيير الخطّة

371
00:21:50,960 --> 00:21:52,670
!سنؤدّي الكاراوكي بدلاً من ذلك

372
00:21:52,670 --> 00:21:53,930
!عالٍ جدّاً

373
00:21:53,930 --> 00:21:55,410
الإضاءة توحي بالبذاءة

374
00:21:55,410 --> 00:21:57,790
لدى هذا المكان شاي عسل رائع

375
00:21:57,790 --> 00:22:00,380
والآن لا تملكون خياراً سوى تمكين روابطكن

376
00:22:00,380 --> 00:22:02,520
لطالما كانت روابطنا متينة

377
00:22:02,520 --> 00:22:03,680
...على أيّ حال

378
00:22:03,680 --> 00:22:05,810
سنعود إلى الكاراوكي ثانية؟

379
00:22:05,810 --> 00:22:08,770
هل استمتعت بمُواعدة الكاراوكي
خاصّتنا إلى هذه الدّرجة؟

380
00:22:10,310 --> 00:22:11,580
لعوب

381
00:22:11,580 --> 00:22:12,810
فتى مومس

382
00:22:12,810 --> 00:22:14,260
عاهر

383
00:22:14,260 --> 00:22:16,110
لم أفعل شيئاً لأستحقّ هذا الافتراء

384
00:22:16,110 --> 00:22:18,570
سأبدأ أوّلاً إذاً

385
00:22:18,570 --> 00:22:20,150
ماذا ستغنّين؟

386
00:22:20,150 --> 00:22:24,040
أحببتُ غناءك لهذه الأُغنية قبل
أيّام، لذا هذا هو ردّ الاعتبار

387
00:22:31,590 --> 00:22:32,990
لحظة، هذه الأُغنية؟

388
00:22:32,990 --> 00:22:36,650
اسمع يا أريسو! وجدتُ
!هذه الفرقة المُذهلة

389
00:22:39,480 --> 00:22:44,140
لستُ شخصاً مُميّزاً

390
00:22:40,820 --> 00:22:44,140
،محبّة نفس اللّون والنكهة أمر مقبول

391
00:22:44,140 --> 00:22:48,210
لكن هل يمكن أن تتحقّق صدفة حُبّ
نفس الفرقة الّتي تفكّكت قبل أعوام؟

392
00:22:44,700 --> 00:22:47,390
أعي ذلك جيّداً

393
00:22:48,210 --> 00:22:52,930
لهذا السّبب، كلّما تكلّمنا

394
00:22:49,270 --> 00:22:52,200
هل هذه رسالة من نوع ما؟

395
00:22:52,930 --> 00:22:56,000
...إينوهانا، هل أنتِ فعلاً

396
00:22:53,600 --> 00:22:57,950
أتجاهلك

397
00:22:58,830 --> 00:23:03,150
والآن لا أعلم ما إن كان هذا مُناسباً

398
00:23:00,200 --> 00:23:01,080
ماذا؟

399
00:23:01,620 --> 00:23:03,150
إن كان هذا مُناسباً

400
00:23:02,180 --> 00:23:03,150
...ما

401
00:23:03,150 --> 00:23:05,850
والآن أنا قلقة

402
00:23:05,850 --> 00:23:07,910
!مهلاً، مهلاً! توقّفن

403
00:23:09,410 --> 00:23:11,590
جميعكن تعرفن هذه الفرقة؟

404
00:23:11,590 --> 00:23:13,310
ماذا؟ أجل

405
00:23:13,310 --> 00:23:15,160
جميعنا نُحبّها

406
00:23:15,160 --> 00:23:17,620
وحتّى أنّنا كنّا نُشغّل أغانيها
أثناء بثّ وقت الغداء

407
00:23:17,620 --> 00:23:18,880
!لكنّها فرقة ثانويّة

408
00:23:18,880 --> 00:23:21,420
أحضر أحدهم ألبوماً للمدرسة، صحيح؟

409
00:23:21,420 --> 00:23:23,090
مـ-من كان هذا الشّخص؟

410
00:23:23,090 --> 00:23:24,440
!من أحضر تلك الأسطوانة؟

411
00:23:26,490 --> 00:23:27,680
لا ندري

412
00:23:29,110 --> 00:23:32,060
...تذكّرت! قد تكون أبّولو

413
00:23:32,060 --> 00:23:35,460
ماذا؟ كيف علمتُ بهذه الفرقة؟

414
00:23:35,460 --> 00:23:37,020
...آسفة، أنا بعض الشّيء