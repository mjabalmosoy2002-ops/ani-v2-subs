1
00:00:02,760 --> 00:00:03,770
.لا بأس

2
00:00:04,430 --> 00:00:07,010
.إنّك لست مثلنا يا كاتسوهيرا-كن

3
00:00:08,680 --> 00:00:10,480
.ستتمكن من استرجاعه

4
00:00:11,380 --> 00:00:12,440
ستتمكن

5
00:00:12,440 --> 00:00:14,010
.من استرجاع ألمك

6
00:00:15,540 --> 00:00:16,410
!لا

7
00:00:17,660 --> 00:00:19,590
!لا أريد أن أفعل ذلك بمفردي

8
00:00:20,100 --> 00:00:22,200
!لا بدّ أن يكون مع الجميع

9
00:00:23,320 --> 00:00:24,330
مع الجميع؟

10
00:00:24,760 --> 00:00:25,740
.نعم

11
00:00:28,410 --> 00:00:30,370
.الجميع" كلمة غريبة"

12
00:00:30,370 --> 00:00:31,130
ماذا؟

13
00:00:31,670 --> 00:00:34,080
أين يبدأ وينتهي "الجميع"؟

14
00:00:35,320 --> 00:00:38,260
،واحدًا واحدًا، جميعنا مختلفون

15
00:00:38,600 --> 00:00:40,930
...ومع ذلك يفعلون كل هذا، و

16
00:00:41,660 --> 00:00:43,020
.أعلم ماذا يعني الجميع

17
00:00:43,570 --> 00:00:46,270
.الجميع هو كل من أحب

18
00:00:47,030 --> 00:00:49,620
!لا بدّ أن يكون مع الجميع

19
00:00:50,850 --> 00:00:51,710
...فهمت

20
00:00:54,560 --> 00:00:56,290
...أنت

21
00:01:01,830 --> 00:01:04,950
سونوزاكي-سان؟

22
00:01:04,950 --> 00:01:06,260
ما هذا؟

23
00:01:08,790 --> 00:01:10,950
.هذا مؤلمٌ نوعًا ما

24
00:01:10,950 --> 00:01:12,710
!ما الذي تفعلانه أنتما؟

25
00:01:13,220 --> 00:01:14,970
ليس لديك إلّا لفائف البام؟

26
00:01:15,480 --> 00:01:17,220
.ولكنّي أفضل اللاموند

27
00:01:17,450 --> 00:01:18,980
.لا تدقّقوا كثيرًا

28
00:01:18,980 --> 00:01:20,900
.ولكن لا يوجد فرقٌ كبير بالسعر

29
00:01:20,900 --> 00:01:22,730
!توقّف عن التذمّر عن ما قُدّم لك بكرَم

30
00:01:22,730 --> 00:01:24,930
.اصمت وكل أيها الغريب

31
00:02:58,770 --> 00:03:00,020
!مُنحرف؟

32
00:03:00,020 --> 00:03:02,130
.قد يكون ذلك قاسٍ قليلًا

33
00:03:02,130 --> 00:03:06,280
.كل ما أريده ببراءة هو الألم

34
00:03:07,120 --> 00:03:09,940
.آسفة، أريد التأكّد من تعريفك لمنحرف

35
00:03:10,330 --> 00:03:13,590
إنّه مجرّد ألم، ولا شيء نفسي؟

36
00:03:13,590 --> 00:03:14,340
.نعم

37
00:03:15,000 --> 00:03:17,470
.أنا لست مهتمًا بذلك النوع من الأشياء

38
00:03:18,010 --> 00:03:21,590
.ولكن لا يعجبني أيّ نوعٍ من الألم

39
00:03:22,090 --> 00:03:25,000
...كالألم المفاجئ الذي لا يمكنني حتى تخيّله

40
00:03:25,000 --> 00:03:28,100
...هذا هو النوع الأفضل، لذا

41
00:03:28,550 --> 00:03:31,010
،أحب المشي خلال الأماكن الخطرة قليلًا

42
00:03:31,010 --> 00:03:35,370
أو الاصطدام بأناس خطيرين والسيّارات
...الخطيرة قليلًا

43
00:03:36,140 --> 00:03:37,520
.كما تعلمون، مثل هذه الأشياء

44
00:03:37,520 --> 00:03:39,820
!هذه ليست أشياء ينبغي عليك قولها بهذه السهولة

45
00:03:39,820 --> 00:03:42,830
...حقيقة أنّ هناك شخصٌ مهووس بالألم بين الكيزنايفار

46
00:03:42,830 --> 00:03:44,510
أليس هذا كجوكر ورق اللعب؟

47
00:03:44,510 --> 00:03:46,700
.حسنًا، لا بأس بذلك أيضًا

48
00:03:47,050 --> 00:03:51,190
...الألم المفاجئ الذي يقع بي عندما لا أكون أتوقعه أبدًا

49
00:03:51,190 --> 00:03:55,500
.لا يمكنني الرجوع إلى ما كنت عليه بما أنّي عرفت هذا الآن

50
00:03:55,990 --> 00:03:59,780
.كلّما فسّر أكثر كلّما أصبحت أكثر قلقًا

51
00:04:00,520 --> 00:04:03,180
لماذا كنت تهرب إلى هذا الحد إذًا؟

52
00:04:04,640 --> 00:04:08,150
ألن تكون الفجائيّة أكبر إن لم نكن نعرف بعضنا؟

53
00:04:08,150 --> 00:04:10,200
.لا تجعل الأمر يبدو بهذا الوضوح

54
00:04:10,200 --> 00:04:12,800
حسنًا، أعتقد أنّ هناك ألمٌ أستطيع تجربته بما أنّنا

55
00:04:12,800 --> 00:04:15,020
.تعرّفنا على بعضنا الآن أيضًا

56
00:04:15,740 --> 00:04:17,110
.لذا، نعم. مسرورٌ للقائكم

57
00:04:17,550 --> 00:04:18,690
...بالأخص

58
00:04:19,030 --> 00:04:19,730
ماذا؟

59
00:04:20,100 --> 00:04:21,200
.مسرورٌ للقائك

60
00:04:22,170 --> 00:04:23,240
...ن-نعم

61
00:04:23,560 --> 00:04:24,860
.هذا يبدو خطيرًا

62
00:04:25,190 --> 00:04:28,290
هل يحب الشباب علاوةً على كونه منحرف؟

63
00:04:28,640 --> 00:04:31,940
.أخبرتك بأنّه ليس أمرًا نفسيًا

64
00:04:31,940 --> 00:04:35,620
.لن يكون الأمر مختلفًا لو كنّا متصلين لشيء ببشري

65
00:04:36,850 --> 00:04:42,130
أتساءل ما نوع المتعة الذي سأشعر
.بها لو كنت متّصلًا بتونا رابيةٌ في مزرعة

66
00:04:43,510 --> 00:04:45,440
...إ-إنّه غريبٌ حقًا

67
00:04:45,440 --> 00:04:47,950
...نيكو غاضبة

68
00:04:47,950 --> 00:04:49,410
...نيكو

69
00:04:49,410 --> 00:04:51,650
!نيكو غريبة أيضًا

70
00:04:51,650 --> 00:04:53,100
.لا حاجة لأن تتعاركي على ذلك اللقب

71
00:04:54,620 --> 00:04:56,850
.أتساءل كيف هي طريقة اختيارهم

72
00:04:57,900 --> 00:04:59,270
.كيزنايفار

73
00:05:00,640 --> 00:05:03,420
ألم يقولوا بأنّهم كانوا يحاولون الحصول

74
00:05:03,420 --> 00:05:06,340
على الكثير من الأشخاص المختلفين معًا ويرون إن كانوا

75
00:05:06,340 --> 00:05:08,120
يستطيعون أن يصبحوا أصدقاءً أم لا؟

76
00:05:08,120 --> 00:05:09,620
هل تصدّق ذلك حقًا؟

77
00:05:11,280 --> 00:05:15,500
.على أي حال، سينتهي أمرنا إن كان معنا شخصٌ مثله

78
00:05:15,860 --> 00:05:19,810
نعم، لا أتوقّع أنّ انتظار نهاية الصيف
.ببساطة سيكون ممكنًا

79
00:05:20,250 --> 00:05:22,980
.سيتوّجب علينا أن نقوم بالحديث مع سونوزاكي-سان جيّدًا

80
00:05:23,430 --> 00:05:24,860
!مرحى

81
00:05:25,440 --> 00:05:27,770
!ستحظى نيكو بالمزيد من الأصدقاء إذًا

82
00:05:29,290 --> 00:05:30,300
أصدقاء؟

83
00:05:30,830 --> 00:05:31,990
من تدعين بالأصدقاء؟

84
00:05:31,990 --> 00:05:34,930
ماذا؟ ج-جميعنا؟

85
00:05:35,450 --> 00:05:37,710
.نحن متّصلون رغمًا عنّا

86
00:05:37,710 --> 00:05:38,770
هذا كل ما في الأمر، أليس كذلك؟

87
00:05:39,400 --> 00:05:40,780
.هذا مختلفٌ عن كوننا أصدقاء

88
00:05:40,780 --> 00:05:42,250
...ل-لكن كما تعلمين

89
00:05:42,250 --> 00:05:43,700
،لقد تبادلنا الحديث في المنزل

90
00:05:43,700 --> 00:05:45,990
.وحتى أنّنا ذهبنا إلى المخزن معًا

91
00:05:45,990 --> 00:05:48,720
.خط تحديدك للأصدقاء يبدو منخفضًا

92
00:05:49,080 --> 00:05:53,150
ألن يكون أنسب إن أطلقتِ علينا معارف عامّة؟

93
00:06:02,250 --> 00:06:03,880
.أنتِ لديكِ شخصيةٌ سيّئةٌ حقًا

94
00:06:04,640 --> 00:06:05,950
.لا بأس

95
00:06:05,950 --> 00:06:08,760
.لا ضرر من مناداتها لكِ صديقة، ذلك لا يكلّف شيئًا

96
00:06:08,760 --> 00:06:10,930
.لا يوجد شيءٌ أغلى من شيءٍ مجاني

97
00:06:10,930 --> 00:06:13,890
،حسنًا، لقد تمكنّا من معرفة بعضنا

98
00:06:13,890 --> 00:06:16,270
...وهيسومو يوشيهارو ذاك

99
00:06:17,060 --> 00:06:18,140
ما رأيك به؟

100
00:06:18,550 --> 00:06:21,080
إنّه وسيم. هل يلائم ذوقك؟

101
00:06:21,080 --> 00:06:24,010
أولئك الذين لديهم عقدة بشأن المظاهر

102
00:06:24,010 --> 00:06:26,770
يسيئون الفهم ويعتقدون أنّ قيمة كل شخص

103
00:06:26,770 --> 00:06:28,900
.تكمن طبقًا لشكله فقط

104
00:06:29,130 --> 00:06:30,730
.نعم، إنّك محقّة

105
00:06:31,260 --> 00:06:33,600
،لا أهتم أبدًا بشخصيّة الآخرين

106
00:06:34,010 --> 00:06:37,310
.وهذا هو سبب لفتكِ لنظري أيضًا يا هونوكا-تشان

107
00:06:37,310 --> 00:06:38,100
ماذا؟

108
00:06:39,220 --> 00:06:42,750
.وفقًا لمظهركِ، فإنّك مرتبتكِ عاليةٌ كثيرًا يا هونوكا-تشان

109
00:06:43,380 --> 00:06:45,320
.الأهم من كل شيء، أثداؤك كبيرة

110
00:06:46,610 --> 00:06:49,610
...أعتقد أنّها كانت أكبر من التي لدي عندما كنت في الابتدائيّة

111
00:06:49,900 --> 00:06:50,760
.ثدياك

112
00:06:55,480 --> 00:06:56,310
.نعم

113
00:06:56,600 --> 00:06:58,810
.شخصيّتك سيّئة حقًا

114
00:06:59,270 --> 00:07:01,580
ألن تساعد يا تينغا-كن؟

115
00:07:01,580 --> 00:07:03,440
.بعد قليل، بعد أن أنتهي من مشاهدة هذا

116
00:07:03,440 --> 00:07:04,360
...يا إلهي

117
00:07:05,500 --> 00:07:07,700
.أتساءل لمَ كنت أنت فقط المختلف

118
00:07:09,350 --> 00:07:11,370
...حسنًا

119
00:07:11,370 --> 00:07:14,280
.جميعنا تم إحضارنا معًا دفعةً واحدة

120
00:07:15,340 --> 00:07:18,110
.ذلك اليوم، لقد كنت في ذلك المشفى أيضًا

121
00:07:19,680 --> 00:07:20,410
ماذا؟

122
00:07:20,410 --> 00:07:23,140
.ربما خضعنا للعمليّة في نفس الوقت

123
00:07:23,950 --> 00:07:26,230
...ولكن سبب كوني مختلفًا قليلًا هو

124
00:07:27,560 --> 00:07:28,810
هيسومو-سان؟

125
00:07:28,810 --> 00:07:30,170
هيسومو يوشيهارو-سان؟

126
00:07:30,880 --> 00:07:33,290
ما الذي تتمنّاه؟

127
00:07:33,290 --> 00:07:36,850
...كمّادة، ومرهم

128
00:07:37,580 --> 00:07:41,870
ليس شيئًا مؤقّتًا، بل شيء تريده بشكلٍ غريزي؟

129
00:07:46,040 --> 00:07:46,980
.التحفيز

130
00:07:46,980 --> 00:07:51,360
إن غيّرت تشكيل الحروف قليلًا إلى الشعور بأنّك
على قيد الحياة، هل سيظل ذلك صحيحًا؟

131
00:07:53,900 --> 00:07:58,260
.بكلتا الحالتين، سأتمكن من إعطاءك هذا

132
00:07:59,430 --> 00:08:00,460
جروح...؟

133
00:08:00,870 --> 00:08:02,120
.اعتنِ بنفسك من فضلك

134
00:08:03,790 --> 00:08:06,380
الشعور بأنّك على قيد الحياة؟

135
00:08:07,450 --> 00:08:09,610
.أنت مهتمٌ بشأن سونوزاكي-سان إلى ذلك الحد إذًا

136
00:08:10,050 --> 00:08:11,880
ألست كذلك يا تشيدوري؟

137
00:08:12,500 --> 00:08:14,090
...باعتبار الوضع الحالي

138
00:08:15,520 --> 00:08:20,490
.وكنت أتساءل لمَ لا تقوم سونوزاكي-سان بالعمل معنا

139
00:08:20,890 --> 00:08:23,640
!لأنّها تريد التحقق من تحرّكاتنا

140
00:08:23,640 --> 00:08:24,660
...ولكن

141
00:08:25,670 --> 00:08:28,000
الجميع يريد أن يتّصل

142
00:08:28,520 --> 00:08:29,400
.مع أحدٍ آخر

143
00:08:29,650 --> 00:08:32,370
...مع ذلك... سونوزاكي-سان

144
00:08:32,370 --> 00:08:34,080
!ماذا؟ لا يمكنني سماعك

145
00:08:34,930 --> 00:08:36,830
.لا... لا شيء

146
00:08:40,400 --> 00:08:41,410
ماذا؟

147
00:08:41,410 --> 00:08:42,650
!لا يهم

148
00:08:43,980 --> 00:08:44,970
ماذا؟

149
00:08:44,970 --> 00:08:47,890
كنت أتساءل كم سيكون خطرًا

150
00:08:47,890 --> 00:08:51,470
إن حصل أنّك ضربتِ وجه كاتسوهيرا-كن بالصحن لأنّكِ

151
00:08:51,470 --> 00:08:54,380
.كنتِ غاضبةً بسبب الغيرة

152
00:08:54,380 --> 00:08:57,640
!وكأنني سأفعل ذلك! وأنا لست غيرانةً أبدًا

153
00:09:00,210 --> 00:09:02,850
.انظروا إلى وجوهكم اللامعة المليئة بالحماس

154
00:09:03,610 --> 00:09:06,270
.حسنًا، أعتقد أنّها الإجازة الصيفيّة التي كنتم جميعًا بانتظارها

155
00:09:06,640 --> 00:09:11,320
،مع علاقات الحب المحرّمة، علاقات الحب المحرّمة

156
00:09:11,320 --> 00:09:14,860
!وعلاقات الحب المحرّمة هو شيء لا يجب عليكم أن تفعلوه

157
00:09:15,140 --> 00:09:18,260
.ولكن إن كان لديكم واحدة فصوّروها وقدّموها

158
00:09:18,260 --> 00:09:19,240
.منحرف

159
00:09:19,240 --> 00:09:21,260
.يامادا سيفعل شيئًا فظيعًا بها حتمًا

160
00:09:21,660 --> 00:09:24,390
ما الذي تريد فعله في الإجازة الصيفيّة يا يوتا؟

161
00:09:25,840 --> 00:09:27,670
.قد أكون مشغولًا جدًّا

162
00:09:28,300 --> 00:09:30,800
.التسكع معك سيءٌ حقًا مؤخرًا

163
00:09:30,800 --> 00:09:33,630
هل أنتَ متأكدٌ أنّ لا علاقة لتينغا بهذا؟

164
00:09:33,980 --> 00:09:35,570
.نحن قلقتان عليك

165
00:09:35,570 --> 00:09:38,800
...أعني، أنا أفكّر بك طوال الوقت يا يوتا

166
00:09:42,370 --> 00:09:44,180
.آه، هيسامو يوشيهارو

167
00:09:49,870 --> 00:09:51,720
!مستحيل! لا يمكنني تصديق ذلك

168
00:09:51,720 --> 00:09:55,110
!إنّه رائع! لنلتقط صورة. هيّا

169
00:10:05,580 --> 00:10:07,670
لماذا أتيتَ فجأة؟

170
00:10:08,000 --> 00:10:10,880
لماذا؟ أهو ممنوعٌ أن آتي إلى المدرسة؟

171
00:10:10,880 --> 00:10:11,870
...أنت

172
00:10:12,910 --> 00:10:14,700
،لأنّ ذلك مفاجئٌ جدًّا

173
00:10:14,700 --> 00:10:16,000
...عندما تفعل ذلك فجأةً

174
00:10:16,000 --> 00:10:18,270
لذا عليك إخبارنا قبلها

175
00:10:18,270 --> 00:10:21,850
.عندما ستفعل شيئًا مفاجئًا كهذا

176
00:10:21,850 --> 00:10:22,560
صحيح؟

177
00:10:22,850 --> 00:10:23,710
...حسنًا

178
00:10:23,710 --> 00:10:25,020
...وهنا

179
00:10:25,020 --> 00:10:27,310
!فكرة

180
00:10:29,460 --> 00:10:31,500
تبادل البريد الإلكتروني، هاه؟

181
00:10:31,850 --> 00:10:35,270
.صحيح، لم نكن نعرف معلومات اتصال بعضنا

182
00:10:36,840 --> 00:10:40,340
الآن، لن تبادل بريدك الإلكتروني

183
00:10:40,340 --> 00:10:42,010
مع معارف عامّة، أليس كذلك؟

184
00:10:46,490 --> 00:10:48,120
!صحيح، هؤلاء

185
00:10:50,500 --> 00:10:51,630
!سحقًا

186
00:10:51,070 --> 00:10:52,880
!انتظر

187
00:10:53,040 --> 00:10:54,710
.لا يهم بعد الآن

188
00:10:54,710 --> 00:10:56,980
ما الذي تتحدث عنه؟

189
00:10:56,980 --> 00:10:59,670
!لن أرضى إلى أن يعيدوا أموالك

190
00:11:00,020 --> 00:11:01,980
!وأحصل على 50% بعد ذلك

191
00:11:02,400 --> 00:11:04,100
ألم يزِد ذلك من المرّة السابقة؟

192
00:11:04,660 --> 00:11:08,510
!أنا رجلٌ يكمل ما بدأه دائمًا

193
00:11:08,970 --> 00:11:12,450
—لست مثل سونوزاكي التي تتحدّث فقط أو تدّعي

194
00:11:12,450 --> 00:11:14,940
.توقّف عن الحديث بفظاظة عنّي

195
00:11:24,880 --> 00:11:26,700
.هذه هي مهمّتكم الحاليّة

196
00:11:26,700 --> 00:11:27,650
!ماذا؟

197
00:11:27,650 --> 00:11:28,810
لماذا رزٌ مقلي؟

198
00:11:28,810 --> 00:11:31,110
الأهم من ذلك، لمَ مكتوبٌ عليها "مخيّم التدريب الصيفي"؟

199
00:11:31,900 --> 00:11:36,080
.انتهى الفصل الدراسي الأول، والكيزنايفار السبعة اجتمعوا

200
00:11:36,610 --> 00:11:39,840
يقال "أولئك الذين يعيشون تحت نفس السقف" أو
..."بهذه الحالة، "أولئك الذي يأكلون الرز من الوعاء نفسه

201
00:11:39,840 --> 00:11:42,760
.لذا ظننت أنّ هذه هي الفرصة المثاليّة لتقوية علاقاتنا

202
00:11:43,490 --> 00:11:45,550
.سيكون الأرز المقلي بروفةً لذلك

203
00:11:45,950 --> 00:11:48,060
من يحتاج بروفة كهذه؟

204
00:11:48,580 --> 00:11:49,650
!إنّه لذيذ

205
00:11:49,650 --> 00:11:52,120
.نيكو لا تريد الفاصوليا الخضراء

206
00:11:52,820 --> 00:11:54,850
!توقّفوا عن الأكل بارتياح

207
00:11:56,090 --> 00:11:57,400
.لن أقوم بمجاراة الأمر

208
00:11:58,110 --> 00:12:01,140
.لن ألعب ألعابكِ بعد الآن يا سونوزاكي-سان

209
00:12:01,850 --> 00:12:03,850
ماذا إن قلت لك

210
00:12:03,850 --> 00:12:08,180
إن شاركتِ في المخيّم التدريبي، فسأخبرك سرًّا عن الكيزنايفار؟

211
00:12:10,630 --> 00:12:12,600
.سنغادر في الثامنة صباحًا

212
00:12:13,030 --> 00:12:15,440
.مكان التجمّع هو أمام بوّابات المدرسة الأماميّة

213
00:12:15,950 --> 00:12:17,710
.كونوا هناك في الوقت من فضلكم

214
00:12:18,190 --> 00:12:19,840
!لم ننتهي من الحديث

215
00:12:19,840 --> 00:12:21,670
الأهم من ذلك، كم سعر هذا الأرز المقلي؟

216
00:12:23,510 --> 00:12:24,800
.المهلة هي 30 دقيقة

217
00:12:25,350 --> 00:12:31,560
.استخدموا قوّة علاقاتكم وحاولوا إنهاء أكله

218
00:12:31,890 --> 00:12:32,690
.وداعًا

219
00:12:33,940 --> 00:12:36,180
!كلوا! كلوا حتى وإن كان ذلك سيقتلكم

220
00:12:36,180 --> 00:12:37,780
لقد كنت سمينًا، أليس كذلك؟

221
00:12:37,780 --> 00:12:39,640
!أرِنا إمكانيّاتك كسمين وكُل

222
00:12:39,640 --> 00:12:40,570
!لا يمكن أن تكون جادًا

223
00:12:41,160 --> 00:12:44,150
!أو بالأحرى، إن كان لديك وقتٌ لشرب الحساء، فكل الأرز المقلي

224
00:12:45,290 --> 00:12:46,250
.آه، لقد هرب

225
00:12:46,640 --> 00:12:47,450
.كاتشّون

226
00:12:52,940 --> 00:12:56,130
لماذا لا تأتين معنا إلى مخيّم التدريب
الصيفي معنا يا سونوزاكي-سان؟

227
00:12:56,450 --> 00:12:57,460
كاتشّون؟

228
00:12:57,780 --> 00:12:59,780
أنا؟ لماذا؟

229
00:13:00,170 --> 00:13:02,270
لقد قلتِها من قبل، أليس كذلك؟

230
00:13:02,650 --> 00:13:04,510
.أنّ الجميع يريد الاتصال بشخصٍ آخر

231
00:13:05,520 --> 00:13:08,370
إذًا الجميع يعني البشريّة أجمع، أليس كذلك؟

232
00:13:08,370 --> 00:13:12,350
فهذا يتضمّنك أيضًا إذًا، أليس كذلك يا سونوزاكي-سان؟

233
00:13:12,780 --> 00:13:17,580
هذا يعني أنّكِ أنتِ أيضًا تريدين الاتصال
بشخصٍ ما، أليس كذلك؟

234
00:13:21,290 --> 00:13:23,780
.لنتبادل البريد الإلكتروني الخاص ببعضنا

235
00:13:23,780 --> 00:13:25,770
!كاتشّون

236
00:13:36,650 --> 00:13:38,670
...هذا مفاجئٌ أكثر ممّا توقّعت

237
00:13:43,960 --> 00:13:45,880
.حقًا؟ أعطني المزيد من المال

238
00:13:45,880 --> 00:13:49,010
.لم يعد لدي مال. استسلم

239
00:13:49,540 --> 00:13:50,940
!سحقًا

240
00:13:50,940 --> 00:13:54,090
لماذا يتسكّع كاتسوهيرا مع تينغا على أيّ حال؟

241
00:13:54,090 --> 00:13:57,220
حقًا، ما الذي سنفعله حيال مخصّصاتك للعطلة الصيفيّة؟

242
00:13:57,770 --> 00:13:59,810
.ربما يمكننا قتل تينغا

243
00:14:00,050 --> 00:14:02,070
.يا له من حديثٍ جازم

244
00:14:02,860 --> 00:14:04,230
!أوروشيبارا

245
00:14:04,660 --> 00:14:08,810
ولكن هل تعتقدان أنّكما أنتما الاثنان قادران
على قتل تينغا-كن؟

246
00:14:08,810 --> 00:14:10,110
ماذا؟

247
00:14:10,110 --> 00:14:14,160
هل يفترض لمرشدة المدرسة أن تحذّرنا خارج المدرسة؟

248
00:14:14,160 --> 00:14:17,710
.آه، أنا لا أنوي تحذيركم إطلاقًا

249
00:14:17,710 --> 00:14:20,460
.ولكن، لا أمانع من إعطائكم نصيحة

250
00:14:21,700 --> 00:14:24,210
نصيحة بشأن ماذا؟

251
00:14:24,640 --> 00:14:27,090
...حسنًا، على سبيل المثال

252
00:14:37,770 --> 00:14:39,940
.البشر مذهلون حقًا

253
00:14:40,410 --> 00:14:44,700
.أنا جائعٌ الآن بعد أكل كل ذلك الأرز المقلي

254
00:14:46,870 --> 00:14:49,450
ما الذي تبتسم بشأنه؟

255
00:14:50,260 --> 00:14:51,360
أبتسم؟

256
00:14:53,750 --> 00:14:55,330
.علمت أنّك ستكون اليوم هنا أيضًا

257
00:14:55,760 --> 00:15:00,190
!بالطبع! اليوم، غدًا، واليوم الذي يليه

258
00:15:00,190 --> 00:15:02,510
!طالما أنّنا متّصلون ببعضنا

259
00:15:02,840 --> 00:15:04,000
.نعم، لا يهم

260
00:15:04,370 --> 00:15:06,110
...آه، كاتشّون

261
00:15:06,110 --> 00:15:09,470
أنت لطيفٌ للغاية، أو بالأحرى، تنقصك قدرة
.التعامل مع الحالات الخطرة

262
00:15:11,530 --> 00:15:13,000
.والاعتناء بنفسك

263
00:15:13,620 --> 00:15:14,640
.شكرًا لك

264
00:15:15,210 --> 00:15:17,780
.أنا متأكدةٌ أن عائلتك قلقةٌ عليك

265
00:15:18,160 --> 00:15:19,390
.اصمتي

266
00:15:21,770 --> 00:15:26,140
.يا إلهي، إنّها تتحدث كثيرًا، كأنّها أم

267
00:15:26,680 --> 00:15:27,460
.تفضّل

268
00:15:27,460 --> 00:15:28,650
هاه؟ ماذا؟

269
00:15:30,730 --> 00:15:32,330
!هذا يبدو لذيذًا جدًّا

270
00:15:32,670 --> 00:15:35,700
ألا بأس أن آكلها؟

271
00:15:35,700 --> 00:15:37,410
.نعم. تفضّل

272
00:15:37,410 --> 00:15:39,500
.لم تتردد حتى

273
00:15:40,160 --> 00:15:43,220
لقد قامت بتحضير هذه لك، أليس كذلك؟

274
00:15:43,220 --> 00:15:45,660
...ولكن ربّما

275
00:15:48,300 --> 00:15:50,540
.كان هناك واحدٌ لي منذ البداية

276
00:15:50,540 --> 00:15:54,470
.لطالما كانت تشيدوري هكذا

277
00:15:57,410 --> 00:15:58,640
!مرحى

278
00:15:58,640 --> 00:16:02,020
!نيكو مُتحمّسةٌ حقًا بشأن الخروج مع الجميع

279
00:16:02,550 --> 00:16:05,560
أيّ جزءٍ من هذه الحافلة مُحمّس مرةً أخرى؟

280
00:16:05,560 --> 00:16:07,830
!إنّه غومورين مرة أخرى

281
00:16:09,940 --> 00:16:11,240
.صباح الخير

282
00:16:11,570 --> 00:16:13,000
سونوزاكي-سان؟

283
00:16:13,000 --> 00:16:15,240
!ما الذي تفعلينه هنا؟

284
00:16:15,700 --> 00:16:18,950
.دعاني كاتسوهيرا-كن، لذا فكّرت أن آتي

285
00:16:19,340 --> 00:16:20,120
ماذا؟

286
00:16:28,040 --> 00:16:30,010
.جاغانيكو، جاغانيكو

287
00:16:44,190 --> 00:16:47,340
!بما أنّ الأمور آلت إلى ما هي عليه. لنحظى ببعض المتعة

288
00:16:47,920 --> 00:16:49,630
.لنلعب شيريتوري

289
00:16:49,630 --> 00:16:51,790
ماذا؟ شيريتوري؟

290
00:16:51,790 --> 00:16:53,150
!نيكو ستلعب

291
00:16:53,150 --> 00:16:55,280
!حسنًا! أنا سأبدأ

292
00:16:55,760 --> 00:16:56,870
!شيريتوري

293
00:16:57,370 --> 00:16:58,990
!عدّاء سباق التتابع

294
00:16:58,990 --> 00:17:00,340
.أزهار البحر

295
00:17:00,340 --> 00:17:01,620
.البقرة الباكية

296
00:17:02,210 --> 00:17:03,870
.قصر شينبورون

297
00:17:04,100 --> 00:17:06,450
!بالله عليك يا سونوزاكي

298
00:17:06,450 --> 00:17:09,640
!هذا انتهى بـ"ن"! أنتِ الخاسرة

299
00:17:09,930 --> 00:17:11,380
.نعم، خسرت

300
00:17:14,250 --> 00:17:16,480
.ل-لنلعب مرةً أخرى

301
00:17:16,480 --> 00:17:18,140
.صحيح. هيّا بنا

302
00:17:18,980 --> 00:17:20,460
!شيريتوري

303
00:17:20,460 --> 00:17:22,180
!خبيرة طبخ

304
00:17:22,520 --> 00:17:23,660
.شبكة سلكيّة

305
00:17:23,660 --> 00:17:24,600
.التعذيب عبر الماء

306
00:17:24,930 --> 00:17:25,600
.بطيخ

307
00:17:28,730 --> 00:17:30,110
.حسنًا، خبز البطيخ إذًا

308
00:17:30,770 --> 00:17:31,530
.سحقًا

309
00:17:31,750 --> 00:17:34,600
.بالأحرى، توقّف عن ربط التعذيب بشكلٍ عشوائي

310
00:17:34,600 --> 00:17:36,270
هل هناك قاعدةٌ مثل هذه؟

311
00:17:36,270 --> 00:17:37,130
...حقًا، أنت

312
00:17:36,530 --> 00:17:38,560
قلتِ إن شاركنا في هذا المخيّم الصيفي

313
00:17:38,560 --> 00:17:41,780
فإنّك ستخبريننا عن الكيزنايفار، أليس كذلك؟

314
00:17:47,790 --> 00:17:50,760
الذين قاموا بإجراء تجربة الكيزنا عليكم جميعًا

315
00:17:50,760 --> 00:17:54,130
.هي لجنة الكيزونا، والتي أنتمي إليها أيضًا

316
00:17:54,390 --> 00:17:56,690
لقد قلتِ أنّ مدينة سوغوموري كانت مدينةً تجريبيّة، أليس كذلك؟

317
00:17:57,160 --> 00:18:01,950
نعم، في الأصل، ثلث السكان تقريبًا ينتمون إلى لجنة الكيزونا

318
00:18:02,620 --> 00:18:04,890
وتكوّنت من فريق التطوير و

319
00:18:04,890 --> 00:18:06,890
.الشركات الداعمة لنظام الكيزونا

320
00:18:07,360 --> 00:18:09,050
.هذا ليس كل شيء

321
00:18:09,050 --> 00:18:14,900
.في سوغومري، أعضاء لجنة الكيزونا يعملون خلف أبوابٍ مغلقة

322
00:18:15,640 --> 00:18:16,650
...على سبيل المثال

323
00:18:21,510 --> 00:18:23,360
!هذا ليس خلف أبوابٍ مغلقةٍ إطلاقًا

324
00:18:23,360 --> 00:18:26,160
!آه، الجانب المظلم! الجانب المظلم من المجتمع

325
00:18:26,160 --> 00:18:28,110
...لطالما تساءلت عن ذلك

326
00:18:28,110 --> 00:18:30,820
.الغومورين الذي يتجوّلون بريبة في كل مكان

327
00:18:30,820 --> 00:18:32,890
...أبي كان غاضبًا بشأن ذلك

328
00:18:33,290 --> 00:18:37,270
.يستخدمون الضرائب على تلك الأشياء

329
00:18:37,620 --> 00:18:42,070
.ولكن كان هناك الكثير من غادر سوغوموري مؤخّرًا

330
00:18:43,150 --> 00:18:45,600
هل لهذا علاقة للجنة كيزونا أيضًا؟

331
00:18:45,820 --> 00:18:47,480
،لأسباب مختلفة

332
00:18:47,480 --> 00:18:50,000
.نقص عدد أعضائنا مؤخّرًا

333
00:18:50,490 --> 00:18:53,610
.ولكن، لم تستسلم لجنة الكيزونا بعد

334
00:18:53,850 --> 00:18:55,940
و؟ ما هو هدفكم؟

335
00:18:55,940 --> 00:18:58,610
—كما قالت، لمشاركة الألم لإيجاد

336
00:18:58,610 --> 00:18:59,860
!أنت اصمت

337
00:18:59,860 --> 00:19:03,390
لا يمكن أن تكون جادين بشأن بناء مشروع مدينة

338
00:19:03,390 --> 00:19:06,370
.بشعارٍ واسع مثل السلام الحقيقي للعالم

339
00:19:06,660 --> 00:19:08,800
،لا يمكنني الكشف عن أسماء الرعاة

340
00:19:08,800 --> 00:19:12,300
،ولكننا تلقينا دعمًا ليس من مثقفي اليابان فقط

341
00:19:12,300 --> 00:19:13,540
.ولكن من دول من أنحاء العالم أيضًا

342
00:19:13,540 --> 00:19:14,470
...و

343
00:19:14,470 --> 00:19:16,510
...لماذا يساعدون

344
00:19:21,310 --> 00:19:22,390
.لقد وصلنا

345
00:19:24,390 --> 00:19:26,860
!واحد، اثنان! واحد، اثنان

346
00:19:28,350 --> 00:19:29,180
...تبًّا

347
00:19:29,670 --> 00:19:32,440
لماذا لا يسمح للمركبات الدخول إلى هنا؟

348
00:19:33,380 --> 00:19:35,650
هل تريدين منّي حمل أمتعتك؟

349
00:19:36,940 --> 00:19:38,180
.من فضلك

350
00:19:40,060 --> 00:19:42,770
.توقّعت أنّك سترفضين

351
00:19:43,400 --> 00:19:47,450
.لقد قيل لي بأن أقبل لطف الآخرين

352
00:19:47,850 --> 00:19:48,950
...فهمت

353
00:19:51,790 --> 00:19:54,180
.أنت مهتمٌ بشأن هيسومو حقًا

354
00:19:55,880 --> 00:19:59,230
هل الوسيمين المصطنعين يحملون ضغينةً على الوسيمين طبيعيًا؟

355
00:19:59,640 --> 00:20:02,260
.أنا اتبعت حميةً فقط. لستُ مصطنعًا

356
00:20:02,910 --> 00:20:06,990
!هيسومو-كن! نيكو اصطادت خنفساء! خنفساء

357
00:20:04,010 --> 00:20:08,390
.فور ما انضّم لنا، انضمّت سونوزاكي معنا

358
00:20:08,730 --> 00:20:11,140
أليس لأنّ أغاتا دعاها؟

359
00:20:11,520 --> 00:20:13,570
هل تعتقدين أنّ هذا هو السبب الوحيد حقًا؟

360
00:20:14,020 --> 00:20:15,990
...الكيزنايفار الذي يسعى للألم

361
00:20:17,330 --> 00:20:18,650
...علينا أن نكون حذرين حول هيسو

362
00:20:20,040 --> 00:20:22,330
!بالأحرى، ما الذي تفعله؟

363
00:20:28,570 --> 00:20:31,750
.تبدين وكأنّك مستعدة لقتل شخص ما

364
00:20:32,050 --> 00:20:34,000
...ما-ما الذي

365
00:20:34,380 --> 00:20:37,360
...هل أنتِ متأكدة أنّكِ لا زلت واقعة في حب كاتسوهيرا

366
00:20:38,920 --> 00:20:40,880
ما كان هذا فجأةً؟

367
00:20:40,880 --> 00:20:42,220
...آه، آ-آسفة

368
00:20:42,220 --> 00:20:44,510
.أنتِ يسهل فهمك

369
00:20:44,510 --> 00:20:45,380
.حقًا

370
00:20:50,410 --> 00:20:53,180
.لا أمانع مساعدتك بهذا

371
00:20:58,960 --> 00:21:00,940
!ت-توقف عن العبث معي

372
00:21:23,500 --> 00:21:24,380
...في الواقع

373
00:21:24,820 --> 00:21:27,170
...افعل ذلك من فضلك

374
00:21:29,400 --> 00:21:30,140
...أنتِ

375
00:21:30,140 --> 00:21:32,110
.لديك جانبٌ ظريفٌ في الواقع

376
00:21:35,630 --> 00:21:38,270
.هذا لا يجعلني سعيدة

377
00:21:38,270 --> 00:21:39,470
!هذا لا يجعلني سعيدة

378
00:21:39,470 --> 00:21:40,700
ما الذي تفعلانه؟

379
00:21:40,700 --> 00:21:43,240
!هذا كان مؤلمًا حقًا

380
00:21:43,240 --> 00:21:44,970
!آ-آسفة

381
00:21:45,530 --> 00:21:47,180
أنتِ غبية، أليس كذلك؟

382
00:21:53,650 --> 00:21:56,710
لمَ لا نلعب شيريتوري؟

383
00:21:57,090 --> 00:21:59,130
.شيريتوري

384
00:21:59,830 --> 00:22:01,090
!لا تقولي "ري" لي

385
00:22:01,090 --> 00:22:02,980
!دعينا نذهب أيتها العجوزة

386
00:22:03,910 --> 00:22:06,510
.آمين

387
00:22:06,810 --> 00:22:08,590
".كانت تلك "ن

388
00:22:11,350 --> 00:22:13,350
.نهاية مسدودة

389
00:23:45,680 --> 00:23:47,010
!مرحى! إنّه مخيّم التدريب الصيفي

390
00:23:47,010 --> 00:23:49,260
!لنذهب، نذهب، وندوس على براز الغزال ونلعب لعبة قتال الوسادات

391
