ولكنَّها كانت ملكة مزيفة، ولم يكُن هُناك أيّ من
العلامات التى تُشير إلى تنصيب ملك جديد

166
00:12:54,170 --> 00:12:56,840
لم يبكي الـ"هاكوتشي"، ولم يُرى زوين في السماء

167
00:12:54,370 --> 00:12:57,810
(جواي (الملكة المزيفة، أخت جيوكاكو الصغرى

168
00:13:03,180 --> 00:13:05,080
شوكو

169
00:13:03,420 --> 00:13:05,040
... "والـ"شوكو

170
00:13:06,120 --> 00:13:10,220
إنَّهم قادة المقاطعات الـ9 للمملكة

171
00:13:10,320 --> 00:13:17,060
لقد كان لديهم أسباب لدعم جواي، وملك كو كان يساعدها سراً

172
00:13:18,130 --> 00:13:21,690
صاحب الجلالة، فقد ثلاث أشخاص حياتهم

173
00:13:21,800 --> 00:13:23,330
إلغي ذلكَ أرجوك

174
00:13:23,470 --> 00:13:27,910
قد يموت الناس ومع ذلك يتوجبُ عليَّ حماية هذا العالم

175
00:13:28,410 --> 00:13:32,040
لِمَ تكره الـ"كايكيوكو" أو الـ"تايكا"؟

176
00:13:32,650 --> 00:13:36,340
في العالم الآخر، يخرجُ الطفل من بطن أُمه

177
00:13:36,620 --> 00:13:39,880
وما علاقتهُ بذلك؟

178
00:13:40,090 --> 00:13:44,280
أتُريدين أن يكون ذلك النوع من الوحوش طليقاً في هذا العالم؟

179
00:13:44,420 --> 00:13:45,360
... يا صاحب الجلالة

180
00:13:46,260 --> 00:13:48,190
لقد أكتشفتُ مكيدته في وقتٍ لاحق

181
00:13:48,560 --> 00:13:57,790
،عرف ملك كو بأنَّ مملكته لن تزدهر كـ إين والتى كان يحكمها تايكا
لذا حاول جلب الخراب لـ كي، حتى لا يفقد ماء وجهه كحاكم

182
00:13:57,900 --> 00:14:00,960
لهذا السبب ساعد جواي، مُدركاً أنَّها ملكة مزيفة

183
00:14:01,470 --> 00:14:05,040
جواي وملك كو حاولا القبض على تايهو كي

184
00:14:05,710 --> 00:14:12,810
ولكنَّه توجه إلى هوراي مسبقاً، آملاً أن يعثر
على سيده هُناك، تماماً كما فعل تايهو إين

185
00:14:19,630 --> 00:14:24,200
وفي نفس الوقت تقريباً، كُنت أعاني من كوابيس عن وحوش

186
00:14:39,710 --> 00:14:45,580
الآن وبعدما فكرتُ بالأمر، من المحتمل
أنَّ سيف سويغيو كان يحاول تحذيري

187
00:14:45,890 --> 00:14:52,320
عثر تايهو كي عليكِ أخيراً، وتعهد بولائه
لكِ، ولكن يوما ملك كو أُرسلت إلى عالمكِ

188
00:15:06,110 --> 00:15:08,300
مـ...ما هو ذلك الطير؟

189
00:15:08,540 --> 00:15:09,600
إنَّهُ كوتشو

190
00:15:15,380 --> 00:15:16,310
هيوكي

191
00:15:32,070 --> 00:15:35,470
"إذن فمن المؤكد أنَّ كورين كانت تأمر الـ"يوما

192
00:15:36,240 --> 00:15:40,830
"الـ"كيرين" عادةً يكون عندهم يوما ليحمونهم، إنَّهم يدعون بـ"شيري

193
00:15:40,940 --> 00:15:44,430
"يمكن للـ"يوما" إستدعاء نفس النوع من الـ"سوما

194
00:15:44,680 --> 00:15:48,910
لهذا السبب كُنت تُهاجمين من قبل أعداد كبيرة

195
00:15:53,890 --> 00:15:55,790
شوكو

196
00:15:57,920 --> 00:16:01,620
كيكي أنشأ شوكو وجلبني لهذا العالم

197
00:16:01,760 --> 00:16:05,420
"الـ"شوكو" مثل الزوبعة، وهي تربط هذا العالم بـ"هوراي

198
00:16:05,570 --> 00:16:09,870
بعض الحكام، سين-نين، وكيرين يمكنهم إحداث شوكو بأنفسهم

199
00:16:10,170 --> 00:16:15,030
"بين الحين والآخر، تجلب الـ"شوكو
أشخاصاً من هوراي إلى هذا العالم

200
00:16:15,180 --> 00:16:17,110
"يُدعى هؤلاء الأشخاص بـ"كايكيوكو

201
00:16:17,480 --> 00:16:19,380
كايكيوكو

202
00:16:21,150 --> 00:16:28,180
إن لم أكُن أنانية لما سُحب أسانو وسوغيموتو
إلى الـ"شوكو" وإنتهى الأمر بهما في هذا العالم

203
00:16:28,290 --> 00:16:32,990
من المؤكد أن الـ"شيري" الخاص بـ كيكي وكورين كانوا يحمونهم

204
00:16:33,190 --> 00:16:35,720
إيكويا أسانو

205
00:16:33,260 --> 00:16:38,530
من النادر عبور شخصين من خلال الـ"شوكو" بأمان كما فعلا

206
00:16:37,060 --> 00:16:39,620
يوكا سوغيموتو

207
00:16:40,330 --> 00:16:45,640
وعندما وصلت إلى هُنا، تغيّر مظهري الخارجي

208
00:16:45,940 --> 00:16:48,770
هذا لأنَّكِ تايكا

209
00:16:48,880 --> 00:16:50,740
تايكا

210
00:16:51,880 --> 00:16:54,900
حاكم كي يولد دائماً في كي

211
00:16:55,320 --> 00:17:01,320
،نمت الـ"رانكا" الخاصة بكِ في مكانٍ ما من كي
ولكن ربّما تكون قد إنتقلت إلى هوراي عبر شوكو

212
00:17:01,860 --> 00:17:03,690
"هذا ما يُطلق عليه "تايكا

213
00:17:06,730 --> 00:17:11,960
عندما يعود الـ"تايكا" إلى هذا الجانب، فإنَّهم يستعيدون هيئتهم الأصلية

214
00:17:13,430 --> 00:17:17,960
قبض ملك كو على الـ"تايهو" الخاص بـ كي، وسلّمه لـ جواي

215
00:17:20,510 --> 00:17:25,880
طالما كان كيكي بجانبها، سيعتقد الناس بأنَّها ملكة حقيقية

216
00:17:26,550 --> 00:17:28,510
لم أكُن أعرف شيئاً حينها

217
00:17:28,650 --> 00:17:31,880
ظننتُ بأنَّ الـ"يوما" تلاحقني بسبب كيكي

218
00:17:32,050 --> 00:17:37,720
وأتّضح أنَّ ملك كو وراء ذلك، والذي كان
يحاول التخلص من ملكة كي الحقيقية

219
00:17:38,120 --> 00:17:45,290
،لا أعتقد أنَّ ملك كو كان يريد السيطر على مملكة كو
إنَّه لم يحتمل رؤية مملكة أُخرى يحكمها تايكا فحسب

220
00:17:45,430 --> 00:17:52,300
خدع ملك كو سوغيموتو، وأسانو المسكين سقط من المنحدر إلى النهر

221
00:17:56,610 --> 00:17:57,230
أسانو

222
00:18:03,080 --> 00:18:04,070
ما الخطب؟

223
00:18:04,920 --> 00:18:11,990
إن لم ألتقي بكَ حينها، لما كُنت قد نجوت

224
00:18:12,160 --> 00:18:13,590
!توقفي عن ذلك

225
00:18:28,440 --> 00:18:33,850
راكوشون، لقد ساعدتني على فهم هذا العالم

226
00:18:35,580 --> 00:18:39,850
لقد علمت بأمر مملكة إين، وقد ألتقيت بملك إين

227
00:18:40,390 --> 00:18:43,480
وقد أكتشفتُ بأنني ملكة كي

228
00:18:44,520 --> 00:18:46,990
أجل، لأنني أعتقد أنَّكِ تستطيعين فعل ذلك يا يوكو

229
00:18:47,190 --> 00:18:50,090
... لقد تعلمت الكثير في هذا العالم

230
00:18:50,560 --> 00:18:56,830
لقد كُنت ناقصة، لهذا السبب كانت علاقتي سطحية مع الآخرين

231
00:18:57,870 --> 00:19:00,200
... يؤسفني السماح لنفسي بأن أكون غبية

232
00:19:00,610 --> 00:19:02,970
لذا أريد أن أبدأ من جديد هُناك

233
00:19:03,380 --> 00:19:07,900
ولكن إن أصبحتُ ملكة، فلن أتمكن من العودة إلى الديار

234
00:19:08,350 --> 00:19:09,650
... يوكو

235
00:19:12,050 --> 00:19:14,380
هذا المكان ليس سيئاً كما أعتقدتُه ذات مرة

236
00:19:14,490 --> 00:19:17,750
... وأعلم أنني سوف أندم إن عُدت

237
00:19:18,630 --> 00:19:21,990
ولكن إن بقيتُ هُنا، فسوف أندم أيضاً ...

238
00:19:23,330 --> 00:19:26,920
بغض النظر عن العالم الذي سأكون فيه، سوف أفتقد الآخر

239
00:19:29,670 --> 00:19:31,160
لا تستديري

240
00:19:31,370 --> 00:19:33,860
ليس الآن

241
00:19:35,810 --> 00:19:37,500
ليس أمامي خيار

242
00:19:37,710 --> 00:19:40,680
لا أستطيع الوصول إلى كتفيكِ كفأر

243
00:19:42,180 --> 00:19:49,320
يمكنكِ أن تفعلي ما تريدينه، ولكن عندما لا
تعلمين ما عليكِ فعله، أفعلي ما تُقررينه

244
00:19:49,590 --> 00:19:52,520
إن كُنتِ ستندمين في كلتا الحالتين، فسوف يكون العبء أقل وزناً

245
00:19:53,260 --> 00:19:57,030
أود رؤية المملكة التى ستقومين بإنشائها

246
00:19:59,100 --> 00:20:01,500
شكراً لك، راكوشون

247
00:20:04,100 --> 00:20:07,630
ملكة كي

248
00:20:04,100 --> 00:20:07,640
وأصبحت ملكة

249
00:20:08,310 --> 00:20:10,240
"أصمتي أيَّتها الـ"تايكا

250
00:20:12,410 --> 00:20:13,110
يوكو

251
00:20:26,130 --> 00:20:29,250
... كورين

252
00:20:32,130 --> 00:20:38,800
أختارت الـ"كورين" الموت لتُجنب سيدها من إرتكاب ذنب عظيم، كقتل ملكة

253
00:20:38,970 --> 00:20:43,670
من دون دعم ملك كو، كان من السهل
هزيمة جيش جواي الغير نظامي

254
00:20:43,810 --> 00:20:47,640
لن أنسى وجوه أولئك الذي ألتقيتُ بهم هُناك

255
00:21:00,030 --> 00:21:03,430
إنني أمنحك التاج وفقاً لإرادة السماء

256
00:21:03,730 --> 00:21:08,330
أقسم بأنني لن أتخلى عن منصبي قبل عرشك

257
00:21:08,470 --> 00:21:10,440
إقبلي حمايتي وعهد السماء

258
00:21:12,210 --> 00:21:13,230
أقبل

259
00:21:19,380 --> 00:21:22,640
... سمعتُ أن ملك كو لديه ابن وابنه

260
00:21:22,980 --> 00:21:25,540
أود مقابلتهما

261
00:21:26,090 --> 00:21:30,550
أريد رؤية جميع الأشخاص الذين قابلتهم
في كو مرةً أخرى لأتحدث إليهم

262
00:21:30,690 --> 00:21:34,420
هل ستبحثين عن صديقكِ أسانو؟

263
00:21:35,300 --> 00:21:38,260
من المؤكد أنَّكِ تشعرين بالوحدة منذُ أن عادت سوغيموتو

264
00:21:46,870 --> 00:21:49,870
هل تفتقدينهما؟

265
00:21:53,050 --> 00:21:54,010
يوكو؟

266
00:21:56,150 --> 00:21:59,280
هل ستحتفظ بهذا من أجلي لبعض الوقت؟ إنَّه يتناول حبيبات الفضة

267
00:21:59,420 --> 00:22:00,480
ماذا؟

268
00:22:00,920 --> 00:22:04,520
لا أستطيع الإعتناء به، أنا طالب مجتهد كما تعلمين

269
00:22:06,490 --> 00:22:08,220
إنَّها هدية من ملك إين

270
00:22:08,490 --> 00:22:09,650
... ولكن

271
00:22:09,830 --> 00:22:12,350
هذا الطائر يستطيع نقل الأصوات

272
00:22:12,530 --> 00:22:16,200
وأيضاً لديه القدرة على العثور عليّ أينما ذهبت

273
00:22:16,700 --> 00:22:20,260
دعني أسمع صوتك بين حين وآخر

274
00:22:21,240 --> 00:22:22,870
... يجب أن أذهب الآن

275
00:22:23,140 --> 00:22:24,970
لا أريد أن أجعل كيكي يغضب عليّ

276
00:22:25,810 --> 00:22:27,440
... يوكو

277
00:22:47,100 --> 00:22:48,120
راكوشون

278
00:22:49,670 --> 00:22:54,230
لقد أخبرتني ذات مرة بأنَّك تريد رؤية المملكة التى سأقوم ببنائها

279
00:22:55,240 --> 00:22:58,700
لن أعود حتى أنهي عملي

280
00:23:00,550 --> 00:23:01,910
شكراً لك يا راكوشون