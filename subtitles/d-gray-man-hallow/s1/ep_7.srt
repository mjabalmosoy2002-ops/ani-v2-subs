1
00:00:01,050 --> 00:00:03,520
أتعلم ماهِيَّة هذه الزهرة؟

2
00:00:04,350 --> 00:00:06,810
...الطريقُ نحو الجنة

3
00:00:08,560 --> 00:00:09,820
.إنّها زهرة اللوتس

4
00:00:10,650 --> 00:00:13,810
،بالرغم من أنّهُ خُلِق من طين ولكنّهُ يتجه نحو الجنة

5
00:00:13,810 --> 00:00:16,240
.ويملأُ العالمَ بعطره الأخَّاذ

6
00:00:17,080 --> 00:00:21,200
،نحنُ مِثل هذه الزهرة

7
00:00:21,200 --> 00:00:24,650
.نحنُ والمعوذون

8
00:00:25,230 --> 00:00:28,220
...أنا أحبُّكِ على الدوام

9
00:00:29,530 --> 00:00:31,880
يا للعجب أمازِلت على قيد الحياة؟

10
00:00:31,880 --> 00:00:34,220
!سأنهيكَّ بهذه الضربة أيُّها المعوذ

11
00:00:37,900 --> 00:00:38,810
...يوو

12
00:00:39,220 --> 00:00:41,270
.مِن الآن، سأُلقي تعويذةً عليكَ

13
00:00:41,760 --> 00:00:44,230
.بالرغم من أنّهُ سيجعلك تعاني قليلاً، ولكن سينتهي بسرعة

14
00:00:44,230 --> 00:00:47,190
.ستنام نومًا لن تستيقظ بعده

15
00:00:49,460 --> 00:00:50,900
!لقد كُنتِ تخدعيني؟

16
00:00:50,900 --> 00:00:55,360
خطة الجيل الثاني من المعوذين؟ الحواريون الإصطناعيونَ؟

17
00:00:55,710 --> 00:00:57,820
...كّلا

18
00:00:57,820 --> 00:00:59,830
!"كُل شيءٍ كان عِبارةً عن"هُراءٍ مُلفق

19
00:01:00,380 --> 00:01:02,160
!لقد كُنت معوذًا بالأصل

20
00:01:02,160 --> 00:01:05,040
!!وقد قُتلت على يد آكوما منذُ زمنٍ طويل

21
00:01:05,500 --> 00:01:06,620
أيُّ عامٍ هذا؟

22
00:01:06,980 --> 00:01:10,250
كم سنة مضت مُنذ ذاك الحين؟

23
00:01:10,820 --> 00:01:12,210
ما الّذي فعلتيه؟

24
00:01:12,690 --> 00:01:14,670
ما الّذي فعلتيه بِنا؟

25
00:01:15,590 --> 00:01:17,050
...إذن أهذا يعني

26
00:01:17,860 --> 00:01:19,510
...أن الأينوسينسُ تلكَ

27
00:01:20,520 --> 00:01:23,020
...كانت تنتّمي إلي

28
00:01:23,810 --> 00:01:25,980
.سنبدأ يا تشانغ

29
00:01:29,240 --> 00:01:34,360
!أوّلستُّم... بحلفاءٍ ليّ

30
00:01:34,710 --> 00:01:38,820
الأينوسينسُ هي الشيء الوحيد
!التي ستجلب النصر لنا بهذهِ الحرب

31
00:01:40,280 --> 00:01:42,870
.سأُنقذ يوو

32
00:01:50,330 --> 00:01:52,130
...ياللّطفل المسكين

33
00:01:52,760 --> 00:01:55,260
...لابُد أنهُ رأهم

34
00:01:55,260 --> 00:01:56,450
رأى؟

35
00:01:56,450 --> 00:01:59,810
...أجل، أجسادهم الحقيقة

36
00:02:00,320 --> 00:02:02,140
.الأجسام الأصلية للحوارين الإصطناعيين

37
00:02:02,770 --> 00:02:08,650
"بعد تجاربهم على الـ"غير المتوافقين
،الّذين فشلوا ولم يتمكنوا من التزامن مع الأينوسينسُ

38
00:02:09,240 --> 00:02:12,360
بَعْدئذٍ بدأ المقر بخلّق المتوافقين الإصطناعيين لأجلِ الحرب المُقدسة

39
00:02:12,360 --> 00:02:14,900
.وهذا لكي يُخزنوا عدّدًا مُعيّنًا مِن المتوافقين

40
00:02:15,500 --> 00:02:20,700
،زرعوا أدمغةَ المتوافقين الغير القادرين على القتال في أوعيةٍ جديدة

41
00:02:20,700 --> 00:02:24,910
وأجروا تجارب ليعلموا إن كان بإمكانهم التزامن مع الأينوسينسُ الخاص بالمتوافقين الآخرين

42
00:02:25,960 --> 00:02:30,100
.هذا هو مخطَّط الجيل الثاني من المعوذين

43
00:02:34,730 --> 00:02:38,260
.تعرض لجروحٍ خطيرة في الرأس بعد اشتباكه مع الآكوما

44
00:02:38,260 --> 00:02:40,430
.مرَّت ساعة وهو للآن في هذه الحالة الخطرة

45
00:02:41,150 --> 00:02:42,840
.ولا توجد إشاراتٌ تبينُ تعرضه للفيروس

46
00:02:43,600 --> 00:02:45,600
.عندي رسالةٌ مِن المدير ليفيلي لكَ

47
00:02:45,600 --> 00:02:51,130
.إعتبارًا مِن الآن هو موضوع إختبار لخطة الجيل الثاني من المعوذين

48
00:02:51,130 --> 00:02:53,000
.خُذه إلى مختبر الأبحاث السادس

49
00:02:53,420 --> 00:02:54,190
.عُلِم

50
00:02:54,860 --> 00:02:57,400
."إن اسم موضع الإختبار "نويسُ ماري

51
00:02:57,400 --> 00:02:59,690
.اعطنا تصريحًا لدخول المقر، من فضلك

52
00:03:13,170 --> 00:03:16,180
.قالت بأنَّنا نُشبه زهرة اللوتس

53
00:03:17,440 --> 00:03:21,220
...بالرغم مِن أنّهُ خُلِق من طين ولكنَّه سيملأُ العالم بعطره الأخَّاد

54
00:03:22,110 --> 00:03:23,970
.طريقة عيشه مشابه لطريقة عيشنا

55
00:03:25,740 --> 00:03:28,430
.ولكِنَّها ذبلت في النهاية

56
00:03:29,370 --> 00:03:33,360
.نهايتها كانت الذبول بالوحل

57
00:03:38,120 --> 00:03:39,690
...إنَّهُ أسودٌ قاتم

58
00:03:40,180 --> 00:03:42,730
.ياله مِن ظلامٍ رَغِيد

59
00:03:46,080 --> 00:03:48,080
...أودُّ رؤيته

60
00:03:49,680 --> 00:03:52,490
.إنهُ مكانٌ مزهرٌ بأكمله

61
00:03:55,050 --> 00:03:59,090
...إن حدث ورأيناه معًا في يومٍ من الأيام

62
00:04:02,980 --> 00:04:04,760
جديًا؟

63
00:04:04,760 --> 00:04:07,600
حتى ولو صِرنا عجوزين، أحسَّن؟

64
00:04:09,660 --> 00:04:10,920
...سأنتظرك

65
00:04:12,200 --> 00:04:13,600
.إلى الأبد

66
00:04:15,020 --> 00:04:16,020
...سأنتظركَ

67
00:04:25,240 --> 00:04:26,740
...لماذا

68
00:04:29,880 --> 00:04:31,740
لماذا أُحاول أن أنهض؟

69
00:04:32,690 --> 00:04:34,420
،لا يُمكننيّ أن أتذكر شَكْلها

70
00:04:34,420 --> 00:04:36,250
.ولا عِلم ليَّ باسمِها

71
00:04:36,740 --> 00:04:38,170
.لا يمكنني أن أتذكرها

72
00:04:38,690 --> 00:04:40,630
.إن ذاكرتي متفككة بالفعل

73
00:04:44,420 --> 00:04:46,760
...بالرغم مِن هذا، لماذا

74
00:04:46,760 --> 00:04:50,770
!لماذا لا أتخلّى عن رغبتي الملِّحة في رؤيتها؟

75
00:04:58,600 --> 00:04:59,730
!أينوسينسُ

76
00:05:00,200 --> 00:05:01,820
!أيُّها اللّعين

77
00:05:01,820 --> 00:05:03,990
!لماذا تظهر ليَّ في مكانٍ كهذا؟

78
00:05:03,990 --> 00:05:08,210
...بسببِ أنني كُنت مضيفًا حدث هذا

79
00:05:08,210 --> 00:05:09,740
!لا يمكنني تحمُّل المزيد

80
00:05:13,810 --> 00:05:16,720
.سأقدرُ على النجاة إذا كان بحوزتي

81
00:05:19,170 --> 00:05:22,340
...أودُّ رؤيتها

82
00:07:04,340 --> 00:07:05,980
.ياليّ من غبي

83
00:07:07,600 --> 00:07:09,170
.غبيٌ للغاية

84
00:07:10,740 --> 00:07:13,060
ما الّذي عليَّ فعله من الآن وصاعدًا؟

85
00:07:14,920 --> 00:07:18,740
أعليَّ أن أقتُّل جميع المتواجدين هُنا؟

86
00:07:25,220 --> 00:07:26,250
!ماذا؟

87
00:07:26,250 --> 00:07:29,380
!باب غرفة المعالجة مُحطم؟

88
00:07:29,950 --> 00:07:32,080
!أيُّعقل؟ بأن يوو

89
00:07:41,350 --> 00:07:44,110
...أن يتوقف اتصالنا بالجولم كليًا وفي آنٍ واحد

90
00:07:44,110 --> 00:07:47,110
ما الّذي جرى في ذاكَ الجانب؟

91
00:07:48,300 --> 00:07:50,110
...الطفل الّذي رأيته في ذاك اليوم

92
00:07:52,120 --> 00:07:54,620
!لماذا لم تخبرني بأيَّ شيء؟

93
00:07:55,380 --> 00:07:58,830
!ماذا يفعلون بهؤلاء الأطفال في مكانٍ كهذا؟

94
00:08:01,030 --> 00:08:02,290
!ماذا؟

95
00:08:03,310 --> 00:08:05,030
...رئيس القسم باك

96
00:08:05,030 --> 00:08:07,340
!لماذا الممرُ مسدود؟

97
00:08:07,340 --> 00:08:08,050
!سُحقًا

98
00:08:09,280 --> 00:08:10,460
!نهج الإستدعاء

99
00:08:11,510 --> 00:08:14,460
!فوو افتحِ الباب رجاءً، فوو

100
00:08:15,690 --> 00:08:16,510
فوو؟

101
00:08:17,800 --> 00:08:20,700
!فوو، لماذا لا تفتحينه؟

102
00:08:22,240 --> 00:08:23,340
...أبتاه

103
00:08:24,120 --> 00:08:25,520
...أماه

104
00:08:26,750 --> 00:08:28,980
!افتحِ الباب أرجوكِ

105
00:08:28,980 --> 00:08:31,030
!فوو

106
00:08:34,550 --> 00:08:35,660
...آنذاكَ

107
00:08:36,320 --> 00:08:37,860
أستكون على ما يُرامٍ هكذا؟

108
00:08:40,700 --> 00:08:42,600
...هذه ملابس المقر الرسمية

109
00:08:43,200 --> 00:08:45,290
.إذن كان معوذًا

110
00:08:45,730 --> 00:08:48,770
هذا الجرح... أهو على وشك الموت يا تُرى؟

111
00:08:50,000 --> 00:08:54,220
أيعقل بأنّه موضع إختبار آخر؟

112
00:09:01,860 --> 00:09:02,980
...اوه؟ هذا الصوت

113
00:09:02,980 --> 00:09:06,310
...أأنتَ ذاك الفتى؟ الّذي ظهر البارحة

114
00:09:12,120 --> 00:09:15,780
آلما، إلى أين ذهبت؟

115
00:09:16,180 --> 00:09:18,950
...رغبته الجامحة لإيقاف تجميد يو

116
00:09:18,950 --> 00:09:23,450
...جعلت الأينوسينسُ تتزامن معه بنجاح

117
00:09:23,450 --> 00:09:26,540
.ولكنَّهُ لم يقدر على أن يتحكم به وقتل اثنين من الغربان

118
00:09:26,540 --> 00:09:29,790
لابُد أنهُ رأى محاور التجارب الآخرى بغرفةِ تخزين الأينوسينسُ

119
00:09:30,770 --> 00:09:33,120
.علي بالإسراع إليه

120
00:09:33,120 --> 00:09:35,940
.عليَّ القيام بالشيء الّذي أقدر عليه لهؤلاء الأطفال

121
00:09:42,170 --> 00:09:43,140
!آلما

122
00:09:47,390 --> 00:09:49,150
.أنا آسفٌ بشأن هذا أيُّها الفتى

123
00:09:49,640 --> 00:09:53,480
،إصاباتٌ كهذه لن تمنعني من الحراك

124
00:09:53,480 --> 00:09:56,070
.لو أن معي الأينوسينسُ خاصتي

125
00:09:57,810 --> 00:10:01,400
.وعلى أيَّ حالٍ يا فتى أنتَ ذو قوةٍ هائلة

126
00:10:01,400 --> 00:10:03,200
.أجل، هذه قصةٌ قديمة

127
00:10:03,200 --> 00:10:07,040
!"وأيضًا توَّقف عن مناداتي بـ"أيُّها الفتى
...وإلا سأقتلك

128
00:10:07,380 --> 00:10:11,080
.إذن بِماذا ينبغي عليَّ أن اناديكَ، أنا ماري

129
00:10:13,620 --> 00:10:16,170
.أنت هادئ للغاية

130
00:10:16,580 --> 00:10:20,010
أتتحدث بشأن تجارب خلْق المعوذين الإصطناعين؟

131
00:10:20,010 --> 00:10:24,140
.أنا لستُ هادئ البتَّة، لدرجة أني سأفقد عقلي في أيَّ لحظة

132
00:10:24,600 --> 00:10:27,660
.رغم ذلك، تمكنتُ من إبقاء سلامة عقلي

133
00:10:27,660 --> 00:10:30,240
.أعتقد بأنّ الفضل يعود إليكَ

134
00:10:31,720 --> 00:10:34,360
.هذا لأنّكَ كُنتَ برفقتي

135
00:10:35,130 --> 00:10:38,860
.إن كنتُ وحيدًا لم أكُن لأدري بالذي سيحدُّث ليَّ

136
00:10:39,700 --> 00:10:41,410
...أيّمكنني أن انضم

137
00:10:43,800 --> 00:10:45,870
..أيمكنُ أن تكونَّ شبحًا

138
00:10:47,250 --> 00:10:50,000
!هذا لأننا نزفنا الكثير من الدم

139
00:10:50,330 --> 00:10:53,130
...هل أنت بخير؟ رأيت ذاك الكابوس مجددًا

140
00:10:54,990 --> 00:10:56,090
...آلما

141
00:10:57,540 --> 00:10:58,470
!أهرب بجلدك

142
00:11:00,660 --> 00:11:02,500
...سأخذه معي

143
00:11:03,570 --> 00:11:05,470
.ومِن ثمّ سنهرب مِن هذا المكان

144
00:11:07,420 --> 00:11:10,480
.لا أهتمُّ بأمر المقر والحرب

145
00:11:11,240 --> 00:11:13,020
...الغضب والكراهية

146
00:11:13,020 --> 00:11:14,980
.سأبتلعها كُلّها

147
00:11:15,700 --> 00:11:17,690
— إن كُنت برفقته

148
00:11:19,700 --> 00:11:22,030
!يوو، أنتَ بخير

149
00:11:22,980 --> 00:11:24,000
!آلما

150
00:11:26,980 --> 00:11:31,120
...أحمر

151
00:11:37,700 --> 00:11:40,630
اوه؟ من ذاكَ الرجل الكبير الّذي تحمله على ظهرك؟

152
00:11:46,120 --> 00:11:48,770
.يوو، أنا سعيد بلقائك مجدّدًا

153
00:11:49,400 --> 00:11:52,020
.ولكن يتحتَّم عليّ قتلك

154
00:12:02,950 --> 00:12:04,200
!اللعنة

155
00:12:10,000 --> 00:12:10,790
!آلما

156
00:12:19,960 --> 00:12:21,360
...عجبًا

157
00:12:21,360 --> 00:12:24,540
.يوو أتزامنت مع الأينوسينسُ أيضًا

158
00:12:26,460 --> 00:12:27,550
!أيّها الفتى

159
00:12:28,710 --> 00:12:30,470
لماذا؟

160
00:12:31,240 --> 00:12:36,410
،بينما كُنت انتظر اِستيقاظ رفاقي لوحدي يوميًا

161
00:12:36,410 --> 00:12:41,740
كنتُ أتسائل بشأن هذا طوال الوقت، لماذا لم يستيقظوا حتى الآن؟

162
00:12:44,300 --> 00:12:46,240
ليس من الممكن أن يستيقظوا

163
00:12:46,890 --> 00:12:49,240
.لا يريدون أن يستيقظوا أساسًا

164
00:12:49,720 --> 00:12:51,080
...آه

165
00:12:51,080 --> 00:12:53,870
.بالرغم من ذلك، كُنت أكلمهم يوميًا

166
00:12:53,870 --> 00:12:56,290
.أُراهن بأنّي كُنت أزعجهم وبجدارة

167
00:12:56,290 --> 00:12:58,670
.هيّا، أنتَ تعلم بأن صوتي مرتفع

168
00:12:58,670 --> 00:13:03,010
.ولقد كُنت اقرأ الكُتب لكي لا تنفذ المواضيع منيّ حتى

169
00:13:03,010 --> 00:13:04,680
...بحقّ

170
00:13:04,680 --> 00:13:08,010
أنتَ... أيُّعقل بأنَّك استعدت ذكريات الماضي؟

171
00:13:08,680 --> 00:13:11,720
...ألهذا قمت بقتلهم؟ إيدُجار و

172
00:13:12,850 --> 00:13:16,100
...أيعقل بأنك قد قتلت كُلّ شخصٍ يوجد في المختبر

173
00:13:16,490 --> 00:13:18,690
...ياليّ من أضحوكة

174
00:13:18,690 --> 00:13:20,610
.يبدو الأمر وكأني آكوما الآن

175
00:13:24,450 --> 00:13:25,530
!آلما

176
00:13:26,820 --> 00:13:28,490
...لم أتمكن من إيقافه

177
00:13:29,240 --> 00:13:33,370
.لا يهم كم من مرةٍ أُدمر فيها جسدي، ولكنّهُ يتجدّد في نهاية المطاف

178
00:13:33,890 --> 00:13:38,170
!لا يمكنني أن أمنع عن نفسي الكراهية والغضب، يوو

179
00:13:43,010 --> 00:13:45,470
.أعتقد بأنّ الفضل يعود إليكَ

180
00:13:45,470 --> 00:13:48,970
.إن كنتُ وحيدًا لم أكُن لأدري بالذي سيحدُّث ليَّ

181
00:13:52,970 --> 00:13:54,480
...يوو

182
00:13:58,640 --> 00:14:00,190
...ليس ذنبكَ

183
00:14:00,670 --> 00:14:04,690
أنتَ ستفهم الأمر، صحيح؟

184
00:14:05,730 --> 00:14:09,950
.لست مذنبًا يا آلما

185
00:14:14,440 --> 00:14:16,710
لماذا اِنتهى الأمر هكذا؟

186
00:14:16,710 --> 00:14:18,460
.لنمُت معًا

187
00:14:19,080 --> 00:14:23,920
.طالما نحنُ على قيد الحياة البشر لن يرحبوا بِنا

188
00:14:23,920 --> 00:14:25,960
،لأجلِ الفوز بهذه الحرب

189
00:14:25,960 --> 00:14:29,470
.هؤلاء سيستعملونّنا كآلاتٍ للأبد

190
00:14:30,000 --> 00:14:33,260
.الكل يودُّ أن ينقذ العالم وحسب

191
00:14:34,050 --> 00:14:36,980
...يودون حماية الأشخاص المحببين عندهم

192
00:14:37,370 --> 00:14:41,940
.فقدنا الشيء الّذي علينا أن نحميه

193
00:14:45,300 --> 00:14:46,630
...الزهرة

194
00:14:56,630 --> 00:14:58,110
...لـ

195
00:15:01,740 --> 00:15:02,920
يوو؟

196
00:15:03,270 --> 00:15:04,400
...آلما

197
00:15:04,830 --> 00:15:06,880
...حتى وإن كُنت لوحدي

198
00:15:07,920 --> 00:15:10,630
.آسفٌ... لكنني أريدُ العيش

199
00:15:10,840 --> 00:15:13,120
!حتى ولو تطلب الأمر تدميركَ

200
00:15:22,010 --> 00:15:23,730
استغرق الأمرُّ وقتًا طويلاً، صحيح؟

201
00:15:24,380 --> 00:15:25,940
.كان مؤلمًا، أيضًا

202
00:15:26,460 --> 00:15:28,100
.ولكنَّه انتهى أخيرًا

203
00:15:29,540 --> 00:15:35,370
مخطّط الجيل الثاني من المعوذين سيتمُّ إيقافه مِن الآن وصاعدًا، أوليس كذلك؟

204
00:15:40,250 --> 00:15:43,380
.أنا آسفه لإقحامك يا فوو

205
00:15:43,810 --> 00:15:48,570
.عدِيني بأنّكِ لن تقومي بحمايتنا مهما حدث

206
00:15:49,770 --> 00:15:51,130
...رجاءً

207
00:15:53,640 --> 00:15:55,000
!أذهبي يا ريني

208
00:15:55,000 --> 00:15:57,510
إذا أتخذتِ هذا الطريق ستصلين إلى مكان تواجد باك والآخرين

209
00:15:57,510 --> 00:16:01,090
...ولكن، بالرغم من أن الجميع متأهبون

210
00:16:01,090 --> 00:16:02,310
...لا يمكنني وحدي

211
00:16:02,660 --> 00:16:06,060
!أنتِ من ستخبر الأجيال القادمة بهذا الخطأ الفادح

212
00:16:07,940 --> 00:16:09,270
!اِستجماع

213
00:16:09,270 --> 00:16:10,780
!تمهلِ

214
00:16:16,550 --> 00:16:19,130
.أعتمدُ عليكِ يا فوو

215
00:16:21,410 --> 00:16:22,550
...بحقّ

216
00:16:22,940 --> 00:16:25,280
.يخبرون الإله الحامي أن لا يحميهم

217
00:16:25,280 --> 00:16:27,290
.يالَّلسخافتهم

218
00:16:27,730 --> 00:16:29,890
.كانوا أغبياءً بالكامل

219
00:16:43,050 --> 00:16:44,050
.توقف

220
00:16:45,450 --> 00:16:46,670
.ينبغي عليكَ أن تتوقف

221
00:16:50,100 --> 00:16:52,990
.توقف... رجاءً

222
00:16:57,580 --> 00:16:59,820
!أوّلم أقول لكَ بأن تتوقف؟

223
00:16:59,820 --> 00:17:04,080
!هذه ذكريات كاندا، الّذي لم يود أن يعلم بشأنها أحد

224
00:17:06,640 --> 00:17:09,590
!ليست بشيءٍ يُختلس النظر إليها بسهولة

225
00:17:09,590 --> 00:17:13,840
!كاندا إلى متى ستسمح بشيءٍ كهذا؟

226
00:17:16,580 --> 00:17:17,090
آيه؟

227
00:17:17,090 --> 00:17:19,050
!...أيّها الـ

228
00:17:27,990 --> 00:17:30,080
تلكُّم جبينهُ مستخدمًا الأينوسينسُ؟

229
00:17:30,080 --> 00:17:32,280
.أنت لا تملك ذرة رحمةٍ يا آلين

230
00:17:32,280 --> 00:17:35,320
...في الأساس كُنا نفعل هذا طوال الوقت

231
00:17:37,410 --> 00:17:38,280
!هذا مؤلم

232
00:17:38,280 --> 00:17:39,910
!رأسي يؤلمني

233
00:17:41,200 --> 00:17:42,580
...بئسًا

234
00:17:42,580 --> 00:17:45,660
يبدو أن مشكلة وايزلي عادت من جديد

235
00:17:45,660 --> 00:17:47,830
!رأسي يؤلمني

236
00:17:48,200 --> 00:17:50,670
.ولكنّكَ تأخرت قليلاً

237
00:17:50,670 --> 00:17:51,550
ماذا؟

238
00:17:53,970 --> 00:17:55,050
!ووكر

239
00:17:55,620 --> 00:17:56,170
!توكسا

240
00:17:57,880 --> 00:17:59,240
...الجسد الأصلي

241
00:17:59,240 --> 00:18:01,430
!أوقف آلما كارما

242
00:18:08,650 --> 00:18:10,980
...إنـ-إنهُ يخنُّق

243
00:18:11,790 --> 00:18:13,320
!جوني!جميعكم

244
00:18:17,900 --> 00:18:18,820
!سيّد الألفية

245
00:18:21,480 --> 00:18:25,250
.أتَمتّعت بقصة المقر الّتي تحتوي على الحب والمأساة

246
00:18:25,250 --> 00:18:32,590
.هذه القصة الّتي تمت صناعتها مِن قبل المقر، يا آلين ووكر

247
00:18:32,910 --> 00:18:35,900
كّلا، أيُّها الرّابع عشر؟

248
00:18:35,900 --> 00:18:36,590
!ماذا؟

249
00:18:37,010 --> 00:18:39,340
...الجيل الثاني من المعوذين

250
00:18:39,340 --> 00:18:43,100
المقر قام بأمورٍ فظيعة صحيح؟

251
00:18:43,100 --> 00:18:46,850
يقومون بكلّ هذا فقط لكي يفوزوا بهذه الحرب، أوّلست محّقًا؟

252
00:18:46,850 --> 00:18:47,850
!اِخرس

253
00:18:48,190 --> 00:18:51,860
أنسيت بأنَّنا نقوم بحلفةٍ لكَ، بمناسبة آخر يومٍ لك في المقر

254
00:18:52,250 --> 00:18:54,380
بما أن الجميع تجمع

255
00:18:54,380 --> 00:18:57,860
إذن، لما لا نبدأ بالأعمال الترفيهية؟

256
00:18:57,860 --> 00:19:00,020
،كما قال وايزلي

257
00:19:00,020 --> 00:19:05,620
.أنتُم يا رفاق سيتم قتلكم مِن قبل ذاك الآكوما الّذي صنعتموه بأيديكم

258
00:19:05,620 --> 00:19:11,880
!الآن يبدو أن فجر حُكم آلما كارما قد حلَّ

259
00:19:12,280 --> 00:19:15,330
!لِذا إستعد

260
00:19:16,280 --> 00:19:17,770
ما هذا الشيء؟

261
00:19:21,370 --> 00:19:22,590
!آلما

262
00:19:22,980 --> 00:19:24,960
اِستيقاظ آلما، إن كراهيتهُ تُحوّلُ

263
00:19:24,960 --> 00:19:28,600
!تُحوّلُ إلى المادة الظلمة في داخل جسمه

264
00:19:29,360 --> 00:19:30,770
...بمعنى

265
00:19:30,770 --> 00:19:32,100
!هذا لا يُبشر بالخير يا آلين

266
00:19:32,530 --> 00:19:35,360
!سيتحول آلما كارما إلى آكوما

267
00:19:35,720 --> 00:19:37,200
...كّلا

268
00:19:47,810 --> 00:19:48,870
.أقتُلهم

269
00:19:48,870 --> 00:19:50,370
!آلين

270
00:19:50,770 --> 00:19:51,620
!جوني

271
00:20:01,270 --> 00:20:02,130
!إنّهُ ساخن

272
00:20:02,610 --> 00:20:04,170
!هذا سيء

273
00:20:04,170 --> 00:20:05,140
...هذا

274
00:20:08,010 --> 00:20:09,330
...هذا الضوء

275
00:20:09,330 --> 00:20:10,640
!إنّهُ فايروس الآكوما

276
00:20:12,030 --> 00:20:13,370
!توقف يا آلما

277
00:20:13,370 --> 00:20:15,400
!هنالك العديد من الأشخاص هُنا

278
00:20:24,850 --> 00:20:26,180
!ما هذا؟

279
00:20:28,470 --> 00:20:31,620
هُنا المقر، ما الذي حدث؟ ماذا كانت هذه الضوضاء؟

280
00:20:31,990 --> 00:20:33,620
.لسنا الفاعلين

281
00:20:33,620 --> 00:20:35,530
.فقد رأينا بريقُ ضوءٍ قوي من بعيد

282
00:20:35,530 --> 00:20:38,380
.ذاك بإتجاه الفرع الأمريكي الشِمالي

283
00:20:40,880 --> 00:20:43,940
ألّا يوجد أيُّ بوابةٍ آخرى قريبةٍ من الفرع؟

284
00:20:44,720 --> 00:20:48,140
هنالك بوابةٌ أقرب بداخل جدار الهيكيجي

285
00:20:48,140 --> 00:20:50,600
ما الذي حدث للتّو؟

286
00:20:50,600 --> 00:20:51,950
ما الخطب، تيواكو؟

287
00:20:52,860 --> 00:20:57,360
.لا شيء يُذكر، كُل ما في الأمر أنّي تشوشتُ قليلاً

288
00:20:57,360 --> 00:20:59,610
أرأيتِ رؤيًا أخرى؟

289
00:21:01,370 --> 00:21:04,860
نحنُ الجيل الثالث لن نُطيعَّ نوا

290
00:21:06,160 --> 00:21:09,580
...إذًا، كما توقعت لا يمكننا استخدام أقرب بوابة مِن هُنا

291
00:21:10,070 --> 00:21:11,320
.أجل

292
00:21:11,320 --> 00:21:12,940
.لنسرع

293
00:21:17,510 --> 00:21:19,720
...ذاكَ الإنفجار الّذي حصل منذ قليل

294
00:21:19,720 --> 00:21:21,250
ما الّذي جرى؟

295
00:21:21,250 --> 00:21:24,010
أووكر موجودٌ هُناكَ؟

296
00:21:44,020 --> 00:21:45,610
...الآن

297
00:21:46,030 --> 00:21:49,490
.لنستمتع بالعرض مِن هذا المكان

298
00:21:49,490 --> 00:21:54,750
.تلوى في المعاناة يا آلين ووكر

299
00:21:54,750 --> 00:21:58,750
!حسنًا، العرض على وشك أن يبدأ

300
00:22:04,260 --> 00:22:05,450
بشر؟

301
00:22:19,540 --> 00:22:20,770
يوو؟

302
00:23:35,580 --> 00:23:38,060
.آلما كارما اِستيقظ وأصبح آكوما

303
00:23:38,480 --> 00:23:42,440
!خلايا آلما في أجساد الجيل الثالث من المعوذين تخرج عن السيطرة

304
00:23:42,440 --> 00:23:44,610
ماهو هدف سيّد الألفية الحقيقي؟