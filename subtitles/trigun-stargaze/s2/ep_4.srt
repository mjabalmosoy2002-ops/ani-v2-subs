1
00:01:47,330 --> 00:01:49,470
.ها أنت هنا

2
00:01:52,530 --> 00:01:56,700
.ولفوود، شكرًا على المساعدة

3
00:01:56,700 --> 00:02:00,950
كفّ عن ذلك. كم مرّة ستشكرني فيها؟

4
00:02:00,950 --> 00:02:02,440
...إضافة لذلك

5
00:02:02,440 --> 00:02:06,100
.تقصد شكرًا ثانية على مساعدتي كالعادة

6
00:02:06,100 --> 00:02:09,480
معك حقّ. ماذا كنت ستفعل بدوني؟

7
00:02:10,770 --> 00:02:12,100
كيف هو إميليو؟

8
00:02:12,100 --> 00:02:15,710
ما زال فاقدًا للوعي، لكنّه ليس
.في خطر مميت كما قيل لي

9
00:02:15,710 --> 00:02:16,710
.فهمت

10
00:02:18,830 --> 00:02:22,620
لقد حاول قتلك، ومع ذلك
.ارتحتَ لسماع أنّه بخير

11
00:02:22,620 --> 00:02:26,840
أنا مسرور لرؤية أنّك لم تتغيّر
.في السّنتين ونصف الماضية

12
00:02:26,840 --> 00:02:29,140
.أنا مسرور أيضًا لرؤيتك

13
00:02:29,140 --> 00:02:30,280
.كنتُ أسخر منك

14
00:02:30,280 --> 00:02:32,000
.أعلم

15
00:02:34,580 --> 00:02:36,580
...يا ولفوود

16
00:02:36,580 --> 00:02:37,490
ماذا؟

17
00:02:37,490 --> 00:02:39,410
كنت تبحث عنّي، صحيح؟

18
00:02:39,410 --> 00:02:41,230
.نعم، هذا صحيح

19
00:02:41,230 --> 00:02:43,020
.لديّ ما أعطيك إيّاه

20
00:02:44,870 --> 00:02:46,010
.لقد أوقعتَ هذا

21
00:02:49,510 --> 00:02:53,100
احتفظتَ به طوال هذا الوقت؟
.شكرًا لك

22
00:02:53,100 --> 00:02:55,070
.كفانا من كلمات الشّكر. اسمع

23
00:02:55,070 --> 00:02:59,030
في المرّة القادمة، استعمل ذلك
.المسدّس للقتل بدون تردّد

24
00:02:59,670 --> 00:03:01,120
.أقصد ذلك الوحش

25
00:03:03,320 --> 00:03:04,900
تدرك ذلك بالفعل، صحيح؟

26
00:03:05,280 --> 00:03:08,680
.تسبّبتَ بتلك الكارثة لأنّك تصرّفت بلين

27
00:03:11,320 --> 00:03:15,600
.إن كان ناي حيًّا، سأوقفه بالتّأكيد هذه المرّة

28
00:03:15,600 --> 00:03:17,840
.لكنّي لن أقتل أيّ أحد

29
00:03:17,840 --> 00:03:20,040
."هذا ما أقصده بـ"لين

30
00:03:20,040 --> 00:03:23,610
.على أحد ما أن يكشّر عن أنيابه
.وإلاّ، سيدفع شخص آخر الثّمن بدموعه

31
00:03:23,610 --> 00:03:25,090
!نستأذن منكما

32
00:03:25,090 --> 00:03:26,890
.نعتذر على التّطفّل

33
00:03:26,890 --> 00:03:29,140
.هذا غير مقبول
.إنّنا نتناقش في موضوع مهمّ

34
00:03:29,140 --> 00:03:31,400
.لا تتدّخلا أيّتها الفتاتان

35
00:03:31,400 --> 00:03:33,020
.لا، لا! لا داعي للقلق

36
00:03:33,020 --> 00:03:34,060
.لا تعرنا أيّ اهتمام

37
00:03:34,060 --> 00:03:35,910
!من أنت حتّى تأ— مهلاً

38
00:03:35,910 --> 00:03:37,530
.حسنًا، إليك سؤالي الأوّل

39
00:03:37,530 --> 00:03:38,260
!أجل

40
00:03:38,260 --> 00:03:39,360
ا-الأوّل؟

41
00:03:39,360 --> 00:03:43,150
أخبرنا بالضّبط ما الّذي كنت تفعله
.في السّنتين ونصف الماضية

42
00:03:43,150 --> 00:03:43,810
!مهلاً

43
00:03:43,810 --> 00:03:44,970
...عفوًا

44
00:03:44,970 --> 00:03:46,750
.سأطرح سؤالاً آخر إذًا

45
00:03:46,750 --> 00:03:47,450
!أجل، أجل

46
00:03:47,450 --> 00:03:48,790
ما طعامك المفضّل؟

47
00:03:48,790 --> 00:03:49,590
ماذا؟

48
00:03:49,590 --> 00:03:50,640
أيّ نوع من الأسئلة هذا؟

49
00:03:50,640 --> 00:03:51,950
.أوّل سؤال قد يسأله أيّ صحافيّ

50
00:03:51,950 --> 00:03:54,000
—أيّها الفتاتان، يكفي

51
00:03:52,990 --> 00:03:55,220
!أرنا ردّة فعلك لهذا اللّقاء الدّراميّ

52
00:03:55,220 --> 00:03:56,030
!أجل، أجل، أجل

53
00:03:56,030 --> 00:03:59,060
حسنًا، ذلك... أنا شخصيًّا لم أشكّ
—أبدًا ولو للحظة أنّ

54
00:03:59,060 --> 00:04:00,720
!لماذا تجعليني أتكلّم هكذا؟

55
00:04:00,720 --> 00:04:04,970
!حسنًا يا فاش ومتعهّد الجنائز
!انظرا للكاميرا وابتسما

56
00:04:08,970 --> 00:04:11,920
.لا يهمّ. افعلوا ما يحلو لكم

57
00:04:13,400 --> 00:04:16,860
.حسنًا، لنعد إلى السّؤال الأوّل

58
00:04:30,740 --> 00:04:33,670
حتّى الآن، ما زال الفارق عن نتائج المحاكاة

59
00:04:33,670 --> 00:04:36,760
.ضمن الهامش يُقارب اثنين بالمائة تقريبًا

60
00:04:36,760 --> 00:04:39,340
.أفترض أنّ كلّ شيء يسير على ما يرام

61
00:04:40,340 --> 00:04:44,050
نقوم بتطعيم نايفز بالبلانت
...لإعادته إلى الحياة

62
00:04:44,510 --> 00:04:46,500
،عندما ينجح كلّ شيء كالمخطّط

63
00:04:46,500 --> 00:04:52,850
قد يقتلنا بدافع الغضب
.لأنّنا ضحّينا بالبلانت بهذه الطّريقة

64
00:04:52,850 --> 00:04:56,200
إن استطعتُ رؤية العالم الّذي
،سيبنيه السّيّد نايفز بعينيّ

65
00:04:56,200 --> 00:04:58,820
.فلن أرغب في أيّ شيء آخر بعدها

66
00:04:58,820 --> 00:05:00,780
.أيّها الدّكتور، لنبدأ

67
00:05:00,780 --> 00:05:01,830
.حسنًا

68
00:05:09,460 --> 00:05:10,620
.آسف على هذا

69
00:05:11,910 --> 00:05:13,750
.بدء التّطعيم

70
00:05:32,730 --> 00:05:36,680
.أتساءل ما الّذي يحلم به السّيّد نايفز

71
00:05:36,680 --> 00:05:38,530
من يدري؟

72
00:05:38,530 --> 00:05:41,740
إنّه كائن من بُعد أسمى، صحيح؟

73
00:05:42,220 --> 00:05:44,700
.من المستحيل أن نفهم

74
00:06:06,570 --> 00:06:10,180
!اليوم هو عيد ميلاد التّوأم الأوّل

75
00:06:10,860 --> 00:06:14,910
!اليوم هو عيد ميلاد تِسلا

76
00:06:15,490 --> 00:06:19,690
مرّت سنة بالفعل؟
.مرّت في غمضة عين كما يقال

77
00:06:25,570 --> 00:06:27,620
أتشاهدين ذلك ثانية؟

78
00:06:27,620 --> 00:06:30,090
إنّ ذلك يجعلك "أمًّا مُحِبّة"، صحيح؟

79
00:06:30,090 --> 00:06:32,040
بالفعل. ألم يكن ذلك واضحًا؟

80
00:06:32,040 --> 00:06:34,910
،أنا أحبّك يا أظرف فتاة في الكون

81
00:06:34,910 --> 00:06:37,650
!وهذا يجعلني أكثر أمٍّ مُحِبّة في الكون

82
00:06:39,590 --> 00:06:42,300
هل نقيم حفلة عيد ميلاد
أخرى العام القادم أيضًا؟

83
00:06:42,300 --> 00:06:45,260
.بالطّبع! بكلّ تأكيد

84
00:07:09,450 --> 00:07:10,830
!النّجدة

85
00:07:21,930 --> 00:07:25,210
.تمّ التّطعيم السّابع بنجاح

86
00:07:26,970 --> 00:07:28,600
ما الّذي ننتظره؟

87
00:07:28,600 --> 00:07:33,160
!نحتاج للعديد من البلانت لإعادة السّيّد نايفز

88
00:07:33,660 --> 00:07:35,960
.ليس عليك تذكيري بذلك

89
00:07:35,960 --> 00:07:37,470
.لنذهب يا ميدفالي

90
00:07:41,930 --> 00:07:45,780
أيمكنني أن أخمّن ما الّذي
يدور في ذهنك الآن؟

91
00:07:46,300 --> 00:07:47,840
.حاولي

92
00:07:47,840 --> 00:07:52,100
".ربّما عليّ قتله الآن بينما الفرصة سانحة لي"

93
00:07:52,590 --> 00:07:54,580
أخبرني، كيف أبليت؟

94
00:07:55,950 --> 00:07:59,910
لا بدّ أنّك شعرت بالأمر أيضًا
.بعد جولاي المفقودة

95
00:08:00,350 --> 00:08:03,730
.قواه هائلة إلى حدّ يفوق الوصف

96
00:08:03,730 --> 00:08:04,980
.نعم، نعم

97
00:08:04,980 --> 00:08:09,550
ربّما ستكون الكارثة أعظم بكثير
.في المرّة القادمة

98
00:08:09,550 --> 00:08:14,980
بتعبير آخر، أنت تعارض بناءَ
السّيّد نايفز لعالمٍ من أجل إخوته؟

99
00:08:15,730 --> 00:08:16,770
.لا أدري

100
00:08:16,770 --> 00:08:20,220
في تلك الحالة، لماذا لا تحاول؟

101
00:08:21,480 --> 00:08:23,910
.السّيّد نايفز بلا حول ولا قوّة الآن

102
00:08:23,910 --> 00:08:26,900
.قد تكون هذه فرصتك الأخيرة

103
00:08:49,490 --> 00:08:55,260
لا يمكنك مقاومة السّيّد نايفز
!حتّى وهو في هذه الحالة

104
00:08:55,950 --> 00:08:57,190
.ميدفالي

105
00:08:59,890 --> 00:09:01,530
.بسرعة

106
00:09:20,250 --> 00:09:23,500
!ر-رجاءً! دعونا نذهب

107
00:09:23,500 --> 00:09:26,410
!أطفال! سأحظى بأطفال قريبًا

108
00:09:26,410 --> 00:09:30,360
لا داعي للقلق. سأحرص أن تلتقي
.بأطفالك في الحياة الآخرة

109
00:09:30,360 --> 00:09:34,590
!أوقف هذا! عملتُ بجدّ! رجاءً

110
00:09:34,590 --> 00:09:38,930
لم نكن سنضع حياتنا على المحكّ
!لحماية البلانت على أيّ حال

111
00:09:38,930 --> 00:09:42,730
المساعدة قادمة، أليس كذلك؟
أسطول المستوطنات ذاك؟

112
00:09:44,020 --> 00:09:45,030
—لذلك

113
00:09:55,040 --> 00:09:57,710
البشر مذهلون، ألا تظنّ ذلك؟

114
00:09:58,150 --> 00:10:01,090
،عندما يستعملون كلّ عضلاتهم
،حتّى الّتي لا يستعملونها عادة

115
00:10:01,090 --> 00:10:03,370
!يصير كلّ شيء ممكنًا

116
00:10:03,370 --> 00:10:07,010
.وبالطّبع، سيظلّون قادرين على الشّعور بالألم

117
00:10:07,010 --> 00:10:09,880
،حتّى وإن سُحقت أيديهم وشُوّهت

118
00:10:09,880 --> 00:10:11,920
!فلا يمكنهم كبح أنفسهم

119
00:10:25,180 --> 00:10:27,110
.مهووسٌ بالقتل

120
00:10:27,440 --> 00:10:32,820
أمّا الجحيم الّذي أريدك أن تختبره
.سيكون أكثر جمالاً بالطّبع

121
00:10:33,220 --> 00:10:36,780
أليس ذلك حماسيًّا يا فاش المُذعِر؟

122
00:10:37,800 --> 00:10:40,540
.والآن، لنستعد البلانت

123
00:11:04,170 --> 00:11:08,490
.جميعنا على نفس الشّاكلة في النّهاية

124
00:11:10,940 --> 00:11:13,940
من النّظام إلى الفوضى

125
00:11:19,320 --> 00:11:23,020
.وقعت عمليّة سرقة بلانت أخرى

126
00:11:23,020 --> 00:11:28,310
تمّ تأكيد مقتل أو اختفاء أزيد من
.أربعين شخصًا. إنّها كارثة حقيقيّة

127
00:11:28,820 --> 00:11:32,780
يُعتبر فاش المُذعِر المشتبه به الأساسيّ

128
00:11:32,780 --> 00:11:34,260
.ولم يتمّ تحديد مكانه بعد

129
00:11:34,260 --> 00:11:36,850
.السّلطات في حالة تأهّب قصوى

130
00:11:36,850 --> 00:11:38,370
...أكرّر

131
00:11:38,370 --> 00:11:41,520
.وقعت عمليّة سرقة بلانت أخرى

132
00:11:41,520 --> 00:11:46,740
تمّ تأكيد مقتل أو اختفاء أزيد من
.أربعين شخصًا. إنّها كارثة حقيقيّة

133
00:11:47,400 --> 00:11:51,040
يُعتبر فاش المُذعِر المشتبه به الأساسيّ

134
00:11:48,520 --> 00:11:51,040
ما هراء "المشتبه به الأساسيّ" هذا؟

135
00:11:51,040 --> 00:11:52,880
.ولم يتمّ تحديد مكانه بعد

136
00:11:51,040 --> 00:11:54,270
.فاش موجود هنا
!لا يُعقل أن يكون الجاني

137
00:11:52,880 --> 00:11:55,240
.السّلطات في حالة تأهّب قصوى

138
00:11:54,270 --> 00:11:56,220
.براد، أحضر لي الأطباق رجاءً

139
00:11:56,220 --> 00:11:56,990
.حسنًا

140
00:11:57,880 --> 00:11:59,070
!انتهيت

141
00:12:00,650 --> 00:12:02,760
!انتظر! دعني أنا أقوم بذلك

142
00:12:06,290 --> 00:12:09,310
.إنّها تنمو بثبات حتّى الآن

143
00:12:12,250 --> 00:12:17,070
!نباتات؟ إنّ هذا يبعث على الهدوء

144
00:12:17,070 --> 00:12:22,180
.لا يمكنني القول أنّي أحبّ الرّائحة
.وكأنّها... لزجة أو خام أو مشابه

145
00:12:22,180 --> 00:12:24,010
أليس ذلك هو ما الجميل فيها؟

146
00:12:24,010 --> 00:12:25,040
فعلاً؟

147
00:12:25,040 --> 00:12:28,900
!انظروا! ثمّة مياه تخرج من طرف هذه

148
00:12:28,900 --> 00:12:32,130
.تستطيع النّباتات تخزين الماء بداخلها

149
00:12:32,130 --> 00:12:35,040
،وذلك ليس كلّ شيء
.بل ويمكن أكل بعضها أيضًا

150
00:12:35,040 --> 00:12:37,990
!فعلاً؟ كم هذا مذهل

151
00:12:37,990 --> 00:12:40,070
.بصراحة، عرفتُ بذلك للتّوّ أيضًا

152
00:12:46,680 --> 00:12:49,420
!فاش! آسفة على التّأخير

153
00:12:53,880 --> 00:12:56,670
!مستحيل! أهذا أرزّ بالبيض؟

154
00:12:56,670 --> 00:12:58,440
!يبدو لذيذًا

155
00:12:58,440 --> 00:13:01,270
—هذا طبق مميّز! تفضّل يا فاش

156
00:13:01,270 --> 00:13:03,080
.شكرًا على الطّعام يا صغيرة

157
00:13:03,080 --> 00:13:03,970
—مهلاً، ذلك

158
00:13:07,110 --> 00:13:08,930
.نعم، لذيذ جدًّا

159
00:13:11,170 --> 00:13:12,580
جيسيكا؟

160
00:13:13,440 --> 00:13:15,010
.لا تهتمّ

161
00:13:15,360 --> 00:13:16,820
!لنأكل

162
00:13:16,820 --> 00:13:18,070
.لنأكل

163
00:13:21,370 --> 00:13:23,620
!لذيذ

164
00:13:24,180 --> 00:13:26,650
.لم أتناول أرزًّا بالبيض منذ سنوات

165
00:13:26,650 --> 00:13:29,970
!انظري لكلّ هذا البيض
.كم هذا باذخ

166
00:13:29,970 --> 00:13:32,190
!شكرًا لك يا سيّد براد

167
00:13:32,190 --> 00:13:34,180
.جيسيكا هي من طبخته

168
00:13:34,180 --> 00:13:36,100
!شكرًا لك يا جيسيكا

169
00:13:36,100 --> 00:13:37,550
!على الرّحب والسّعة

170
00:13:37,550 --> 00:13:39,920
.إنّه لذيذ بالفعل يا جيسيكا

171
00:13:40,560 --> 00:13:42,560
أراهن أنّك تفاجأت بذلك، صحيح؟

172
00:13:42,560 --> 00:13:44,930
.نعم، لقد كبرتِ بالفعل

173
00:13:45,490 --> 00:13:49,960
!ثمّة أشياء كثيرة لا تعرفها أيضًا

174
00:13:49,960 --> 00:13:54,150
.هكذا إذًا، هناك أمور أجهلها بالفعل

175
00:13:54,150 --> 00:13:56,130
.ذلك واضح

176
00:13:57,650 --> 00:14:00,860
.العالم مليء بالهراء الّذي تجهله

177
00:14:01,560 --> 00:14:04,450
.ومحاولة معرفته كلّه أمر مستحيل

178
00:14:11,480 --> 00:14:12,960
.هذا صحيح

179
00:14:12,960 --> 00:14:15,280
.متعهّد الجنائز محقّ

180
00:14:15,280 --> 00:14:18,670
.لكنّ الرّغبة في التّعلّم هي المهمّة

181
00:14:18,670 --> 00:14:20,040
.نعم

182
00:14:22,390 --> 00:14:23,380
.شكرًا على الطّعام

183
00:14:23,870 --> 00:14:25,500
.على الرّحب والسّعة

184
00:14:25,500 --> 00:14:28,990
!سأعلّمك أشياء أكثر عنّي

185
00:14:28,990 --> 00:14:31,090
.أكيد، مع الوقت

186
00:14:33,310 --> 00:14:37,780
أرى أنّ امتلاك كلّ هذه البلانت

187
00:14:37,780 --> 00:14:41,990
يعني توفّر طعام لذيذ مثل
.أرزّ بالبيض طوال الوقت

188
00:14:41,990 --> 00:14:43,740
.ليس تمامًا

189
00:14:44,080 --> 00:14:49,050
.هذا ترحيب خاصّ لكم فحسب

190
00:14:49,050 --> 00:14:53,730
.فعلاً؟ أنا آسف إن بدا كلامي فظًّا

191
00:14:53,730 --> 00:14:54,710
.لا عليك

192
00:14:56,080 --> 00:14:59,040
.لم أعتذر لكم بعد

193
00:15:01,060 --> 00:15:06,140
.عرفنا أنّ فاش كان حيًّا بعد جولاي المفقودة

194
00:15:06,600 --> 00:15:12,340
،لكن عندما سألتموني
.كذبتُ وقلتُ أنّي لا أعرف

195
00:15:12,340 --> 00:15:13,680
.أنا آسفة

196
00:15:14,080 --> 00:15:17,320
—لا بأس يا سيّدة لويدا. كنتِ فقط

197
00:15:17,320 --> 00:15:19,290
.كان همّك أن يعيش فاش بسلام فحسب

198
00:15:19,290 --> 00:15:21,490
خفتِ عليه بدافع أبويّ، صحيح؟

199
00:15:21,490 --> 00:15:22,940
.أنا أفهم تمامًا

200
00:15:22,940 --> 00:15:24,820
.ليس لديك ما تقلقين حياله

201
00:15:24,820 --> 00:15:28,650
يمكنك اعتبارنا متعادلين بعدما
.أكلنا ذلك الأرزّ بالبيض اللّذيذ

202
00:15:33,220 --> 00:15:35,000
...ذلك الأرزّ بالبيض

203
00:15:35,850 --> 00:15:38,860
.كم أودّ لو يتذوّقونه يومًا

204
00:15:38,860 --> 00:15:39,880
تقصد من؟

205
00:15:40,710 --> 00:15:44,640
الأطفال الّذين في الميتم
حيث قلتَ أنّك تربّيت؟

206
00:15:45,810 --> 00:15:50,690
أتساءل إن كانت ستتسنّى لهم الفرصة عند
.وصول المساعدة من أسطول المستوطنات

207
00:15:51,700 --> 00:15:53,850
...بشأن ذلك يا فاش

208
00:15:54,390 --> 00:15:59,230
هل أنت واثق أنّ نايفز كان يتلاعب بإميليو؟

209
00:15:59,610 --> 00:16:01,310
.أعتقد ذلك

210
00:16:01,310 --> 00:16:04,490
إن افترضنا أنّ أسطول المستوطنات
،سيصل بعد ستّة أشهر

211
00:16:04,490 --> 00:16:08,270
.أشكّ أنّ نايفز سيجلس مكتوف الأيدي فحسب

212
00:16:08,270 --> 00:16:09,590
.أوافقك الرّأي

213
00:16:10,680 --> 00:16:14,270
لا بدّ أنّ هنالك بلانت على متن
.أسطول المستوطنات أيضًا

214
00:16:14,270 --> 00:16:18,300
.ومن المنطقيّ أن يحاول استغلال ذلك

215
00:16:19,280 --> 00:16:22,010
.يا لها من معضلة

216
00:16:22,550 --> 00:16:23,960
!شكرًا على الطّعام

217
00:16:25,710 --> 00:16:27,110
.شكرًا على الطّعام بالفعل

218
00:16:27,110 --> 00:16:28,880
.شكرًا على الطّعام يا جيسيكا

219
00:16:30,030 --> 00:16:30,760
!العفو

220
00:16:30,760 --> 00:16:34,460
.بالمناسبة! علينا التّنظيف
صحيح يا متعهّد الجنائز؟

221
00:16:34,460 --> 00:16:35,400
ماذا؟

222
00:16:35,400 --> 00:16:39,100
أعتقد أنّنا ندين لهم بذلك
.مقابل الوجبة اللّذيذة

223
00:16:39,100 --> 00:16:40,730
.أنا بارع في غسل الصّحون

224
00:16:40,730 --> 00:16:42,910
!كان ذلك لذيذًا

225
00:16:42,910 --> 00:16:43,960
!سرّني أنّه أعجبك

226
00:16:43,960 --> 00:16:45,560
هل استعملتِ مكوّنًا سرّيًّا؟

227
00:16:45,560 --> 00:16:47,740
.ثمّة شيء واحد أكيد

228
00:16:48,320 --> 00:16:53,620
.علينا إيقاف نايفز مهما كلّف الأمر

229
00:16:54,550 --> 00:16:55,540
...نعم

230
00:16:55,540 --> 00:16:56,900
.معك حقّ

231
00:16:56,900 --> 00:17:00,530
،كما قلت، وحتّى إن كان الأمر صعبًا

232
00:17:00,530 --> 00:17:03,630
علينا السّعي جاهدين للسّير
.على الطّريق الصّحيح

233
00:17:03,630 --> 00:17:04,630
.نعم

234
00:17:04,630 --> 00:17:08,790
بتعبير آخر، علينا العمل
.على ما يمكننا فعله الآن

235
00:17:08,790 --> 00:17:10,970
.لذلك تعال معي يا فاش

236
00:17:10,970 --> 00:17:14,530
.سأفعل ما بوسعي من أجلك

237
00:17:18,500 --> 00:17:23,440
كم نحتاج لإعادة السّيّد نايفز بالكامل؟

238
00:17:23,440 --> 00:17:28,740
وفق حساباتي، ولبلوغ عودة
...كاملة، علينا أن

239
00:17:26,980 --> 00:17:28,080
.مهلاً

240
00:17:28,740 --> 00:17:31,550
هناك الكثير من البلانت
على السّفينة ثلاثة، صحيح؟

241
00:17:31,550 --> 00:17:32,550
.نعم

242
00:17:33,780 --> 00:17:38,160
لماذا لا نأخذها إذًا؟

243
00:17:38,160 --> 00:17:40,290
.سيوفّر ذلك علينا الكثير من الوقت

244
00:17:40,290 --> 00:17:41,920
.نعم، هذا مثير للاهتمام

245
00:17:41,920 --> 00:17:43,140
!مهلاً، مهلاً

246
00:17:43,140 --> 00:17:47,840
.الموطن... للسّفينة ثلاثة دفاعات عدّة

247
00:17:47,840 --> 00:17:49,980
!هنالك فرصة أن يهزمونا بدل ذلك

248
00:17:49,980 --> 00:17:51,940
.ما حدث قد حدث

249
00:17:51,940 --> 00:17:56,140
لكن... لا، لا يمكنني دعم فكرة
.السّعي خلف الموطن

250
00:17:56,590 --> 00:17:57,890
.ميدفالي

251
00:17:58,630 --> 00:18:02,440
.فاش المُذعِر على متن السّفينة ثلاثة الآن

252
00:18:02,860 --> 00:18:05,370
.كانت تلك معلومة من محرّك الدّمى الأنانيّ

253
00:18:05,830 --> 00:18:09,860
،قبل أن نُطلق هجومنا
.اذهب وأمسك به

254
00:18:09,860 --> 00:18:12,700
أمسكه؟ وليس أن أقتله؟

255
00:18:13,120 --> 00:18:15,920
.تغيّرت قوانين اللّعبة

256
00:18:15,920 --> 00:18:20,080
.نحن بحاجة لفاش إن أردنا إيقاظ نايفز

257
00:18:20,430 --> 00:18:21,580
.نعم

258
00:18:21,580 --> 00:18:25,240
.إضافة لذلك، لن يكون قتله فحسب ممتعًا

259
00:18:26,510 --> 00:18:32,500
أريد أن أحرص أن يتكبّد فاش المُذعِر
.أعلى درجات المعاناة على أيدٍ بشريّة

260
00:18:32,500 --> 00:18:35,990
،سيتعرّف على حقيقة البشر

261
00:18:35,990 --> 00:18:38,930
!مهما حاول بيأس إنقاذهم

262
00:18:39,930 --> 00:18:44,940
.عليك إحضار فاش المُذعِر إلى السّيّد نايفز

263
00:18:45,280 --> 00:18:49,040
سنستولي على جميع البلانت
.في السّفينة ثلاثة

264
00:18:49,040 --> 00:18:50,260
مفهوم؟

265
00:18:53,190 --> 00:18:56,510
.وإن أردتَ الهرب، يمكنك الهرب

266
00:19:01,760 --> 00:19:03,120
الهرب؟

267
00:19:04,250 --> 00:19:08,080
وهل هنالك مكان في العالم للهرب إليه؟

268
00:19:25,630 --> 00:19:28,110
.آسف لتسبّبي بكلّ هذه المشاكل يا براد

269
00:19:28,110 --> 00:19:31,730
كم مرّة ستكسر فيها تُحفتي الفنّيّة؟

270
00:19:32,420 --> 00:19:34,920
.قطع الغيار على هذه السّفينة محدودة

271
00:19:34,920 --> 00:19:36,940
لا أدري كم مرّة أخرى
.سأتمكّن من القيام بهذا

272
00:19:36,940 --> 00:19:38,560
!سـ-سأكون أكثر حذرًا من الآن فصاعدًا

273
00:19:38,560 --> 00:19:40,120
.آمل ذلك بالفعل

274
00:19:41,970 --> 00:19:43,870
.سبق وأصلحتُ مسدّسك

275
00:19:44,270 --> 00:19:47,830
.كما أحضرتُ لك معطفًا جديدًا ونظّارات شمسيّة

276
00:19:47,830 --> 00:19:49,250
!براد

277
00:19:49,250 --> 00:19:52,840
.لا يمكن أن تبقى مرتديًا تلك الخِرق

278
00:19:52,840 --> 00:19:55,840
!ساعدتُ في خياطة المعطف أيضًا

279
00:19:55,840 --> 00:19:58,960
.شكرًا يا جيسيكا. سأكون حذرًا أثناء ارتدائه

280
00:19:58,960 --> 00:20:01,270
!آملُ ذلك بالفعل

281
00:20:02,370 --> 00:20:06,400
!كلّ ما بقي الآن هو تثبيت هذا عليه

282
00:20:03,260 --> 00:20:04,720
"أحبّ جيسيكا"

283
00:20:06,400 --> 00:20:08,940
...ماذا؟ مـ-مهلاً

284
00:20:07,140 --> 00:20:11,510
أين أضعها؟ لا بدّ أن تكون
في المنتصف، صحيح؟

285
00:20:10,280 --> 00:20:11,510
!جـ-جـ-جيسيكا

286
00:20:11,510 --> 00:20:12,390
.لا تتحرّك

287
00:20:12,390 --> 00:20:13,100
!آ-آسف

288
00:20:13,100 --> 00:20:16,800
،مهلاً يا جيسيكا! قبل فعل ذلك
!أحتاج لمساعدتك في أمر ما

289
00:20:16,800 --> 00:20:17,900
ماذا؟

290
00:20:19,600 --> 00:20:21,470
أتريد قصّة بالفعل؟

291
00:20:21,470 --> 00:20:23,520
.نعم، وليكن قصيرًا جدًّا

292
00:20:23,520 --> 00:20:25,780
.لكنّك تبدو رائعًا بشعرك الطّويل

293
00:20:25,780 --> 00:20:29,180
ما رأيك بتسريحة موهوك من باب التّغيير؟

294
00:20:29,180 --> 00:20:31,190
.لا، لا أريد ذلك القدر من التّغيير

295
00:20:31,190 --> 00:20:33,210
ألن يكون مرحًا أن تجرّب تسريحة ذيل البطّة؟

296
00:20:33,210 --> 00:20:34,310
!مرحًا؟

297
00:20:34,310 --> 00:20:35,130
.لا تتحرّك

298
00:20:35,130 --> 00:20:35,920
.آ-آسف

299
00:20:35,920 --> 00:20:37,840
لِمَ لا تحلقه بالكامل؟

300
00:20:37,840 --> 00:20:38,970
!يبدو ذلك جيّدًا

301
00:20:38,970 --> 00:20:39,700
!فعلاً؟

302
00:20:39,700 --> 00:20:42,220
...حسنًا، ربّما ليس حلاقة كاملة، لكن

303
00:20:42,220 --> 00:20:44,330
تريده كما كان في السّابق فحسب؟

304
00:20:44,910 --> 00:20:49,640
.لا. سبق وقرّرتُ ما التّسريحة الّتي أريد

305
00:20:54,150 --> 00:20:54,770
!انتهيت

306
00:20:58,160 --> 00:21:00,130
حسنًا، ما رأيك؟

307
00:21:01,120 --> 00:21:02,970
.أحسنت عملاً يا جيسيكا

308
00:21:03,890 --> 00:21:05,340
.إنّها تناسبك كثيرًا

309
00:21:05,340 --> 00:21:06,020
!أعجبَتني

310
00:21:06,020 --> 00:21:07,800
.كنتَ ستبدو أفضل لو حلقته بالكامل

311
00:21:07,800 --> 00:21:10,020
لكن لماذا قصّة الشّعر هذه؟

312
00:21:10,020 --> 00:21:11,540
...إنّ ذلك

313
00:21:14,110 --> 00:21:16,550
.لأظهر عزيمتي على ما أظنّ

314
00:21:21,840 --> 00:21:24,960
!حسنًا، حان وقت إنهاء المعطف

315
00:21:24,960 --> 00:21:26,580
هل ستضعين تلك عليه بالفعل؟

316
00:21:26,580 --> 00:21:27,890
!بالطّبع

317
00:21:37,040 --> 00:21:38,450
!رأسي

318
00:21:45,410 --> 00:21:47,870
!هذا... مهووس البوق

319
00:21:47,870 --> 00:21:49,820
مهووس البوق؟

320
00:21:50,490 --> 00:21:53,330
.مهووس البوق ميدفالي

321
00:21:53,800 --> 00:21:55,510
.أحد أتباع نايفز

322
00:21:56,730 --> 00:21:58,040
!مهلاً! ليس الآن

323
00:21:58,040 --> 00:21:59,250
—ولكن يا براد

324
00:21:59,250 --> 00:22:01,320
هل ستقاتل بذراع واحدة؟

325
00:22:01,320 --> 00:22:03,070
!أخبرتك أن تظلّ ثابتًا

326
00:22:03,070 --> 00:22:04,050
...لكن

327
00:22:04,050 --> 00:22:05,760
!أكاد أنتهي

328
00:22:06,020 --> 00:22:07,330
متعهّد الجنائز؟

329
00:22:07,330 --> 00:22:08,720
!ولفوود

330
00:22:08,720 --> 00:22:09,940
!سأذهب أنا

331
00:22:10,420 --> 00:22:13,520
.أنت تدين لي بواحدة يا ذا الشّعر الشّائك

332
00:23:51,930 --> 00:23:54,460
.وقت الاستيقاظ وشيك

333
00:23:52,950 --> 00:23:54,870
يا له من عالم مدهش