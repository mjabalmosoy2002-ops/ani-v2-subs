1
00:00:00,800 --> 00:00:03,830
.يا رفاقي الأعزّاء، أجيبوا رجاءً

2
00:00:05,010 --> 00:00:06,960
.لقد تلقّينا نداء استغاثتكم

3
00:00:07,300 --> 00:00:11,070
يمكننا اصطحاب كلّ من يرغب
.في الانضمام إلينا على متن سفينتنا

4
00:00:12,280 --> 00:00:16,110
.وسندخل قريبًا مدارًا ثابتًا حول كوكبكم

5
00:00:17,240 --> 00:00:21,000
التّاريخ والوقت المحدّدات وفق
—التّوقيت العامليّ القياسيّ

6
00:01:55,350 --> 00:01:59,290
...سأستدعي المطر على هذا الكوكب الجافّ

7
00:01:59,670 --> 00:02:02,470
.مطرٌ من ألف سفينةِ مهاجرين

8
00:02:03,060 --> 00:02:06,760
."سقوط كبير على شاكلة "فيضانِ بداية

9
00:02:16,520 --> 00:02:19,950
.ناي، سأوقفك

10
00:02:19,950 --> 00:02:21,910
وكيف ستقوم بذلك؟

11
00:02:22,390 --> 00:02:24,550
أيمكنك الوقوف على قدميك سلفًا؟

12
00:02:24,550 --> 00:02:26,550
.أنا جاهز دائمًا وأفضل من ذي قبل

13
00:02:26,550 --> 00:02:31,550
إضافة لذلك، إن بقيت طريح الفراش
.طوال الوقت، فسيُقلق ذلك الأطفال

14
00:02:32,210 --> 00:02:33,260
ماذا الآن؟

15
00:02:34,280 --> 00:02:39,200
حسب كلام ميلاني، استطاعت
.أكتوفرن تجنّب هجوم الفُلك

16
00:02:39,200 --> 00:02:42,880
.إنّهم يستقبلون لاجئين من مدن وبلدات أخرى

17
00:02:42,880 --> 00:02:46,790
.انتشرت أخبار عن أنّ المدينة ستحمي النّاس

18
00:02:48,090 --> 00:02:51,930
.لذلك سيأتي ناي إلى أكتوفرن

19
00:02:52,470 --> 00:02:54,960
ذلك ما يبدو لي. وبعد؟

20
00:02:57,490 --> 00:03:01,290
.لديّ بعض الأفكار... عن كيف نوقف ناي

21
00:03:01,650 --> 00:03:03,680
.أسمعني إيّاها

22
00:03:04,200 --> 00:03:05,510
...حسنًا

23
00:03:05,510 --> 00:03:06,850
.لا فائدة

24
00:03:07,170 --> 00:03:09,360
.البلدة في الأسفل فارغة بالكامل

25
00:03:09,360 --> 00:03:12,940
.لا طعام ولا ماء ولا شيء فيها
.كما توقّعنا تمامًا

26
00:03:12,940 --> 00:03:14,670
.إنّها كمدينة أشباح بالفعل

27
00:03:14,930 --> 00:03:17,880
،حتّى لو قلّلنا استهلاكنا للحدّ الأدنى

28
00:03:17,880 --> 00:03:21,340
.فلن يكفينا الطّعام والماء إلاّ لأسبوع تقريبًا

29
00:03:21,340 --> 00:03:22,920
...أسبوع واحد

30
00:03:23,400 --> 00:03:26,820
،وحتّى إن أردنا اللّجوء إلى أكتوفرن
.فإنّ كلّ السّيّارات قد رحلت

31
00:03:26,820 --> 00:03:29,210
فكرة السّير إلى هناك مستبعدة
...بالكامل، لذلك

32
00:03:29,210 --> 00:03:32,910
في كلّ الأحوال، لا نريد للأطفال
.أن يذهبوا إلى أكتوفرن

33
00:03:33,260 --> 00:03:37,170
.لا يمكننا استعمال الرّاديو أيضًا
ما العمل...؟

34
00:03:39,660 --> 00:03:40,910
.الموطن

35
00:03:40,910 --> 00:03:41,990
الموطن؟

36
00:03:41,990 --> 00:03:43,670
هل تقصد منزلك؟

37
00:03:44,020 --> 00:03:48,960
.ستستضيف لويدا الأطفال
.سأذهب لأسألها بنفسي

38
00:03:48,960 --> 00:03:53,210
ومن هنا، لن يأخذ الطّريق إلاّ ثلاثة
.وأربعة أيّام بالدّرّاجة النّاريّة

39
00:03:53,210 --> 00:03:55,550
.تبدو هذه فكرة جيّدة

40
00:03:55,900 --> 00:03:59,590
لكن هل سيترك ذلك وقتًا
كافيًا للتّعامل مع نايفز؟

41
00:03:59,590 --> 00:04:04,720
لا يستطيع ناي القيام بما يريد
.حتّى يصل أسطول المهاجرين

42
00:04:04,720 --> 00:04:07,600
لدينا ما يكفي من الوقت لزيارة
،الموطن والعودة إلى هنا

43
00:04:07,600 --> 00:04:10,940
.ثمّ الذّهاب إلى أكتوفرن... كما أظنّ

44
00:04:11,760 --> 00:04:13,800
.يبدو هذا خيارنا الوحيد

45
00:04:14,280 --> 00:04:18,110
.سأعود في أسرع وقت ممكن
.لا داعي للقلق

46
00:04:18,110 --> 00:04:20,070
.اعتن بنفسك

47
00:04:20,070 --> 00:04:21,310
.سأغادر الآن

48
00:04:25,900 --> 00:04:27,290
!حظًّا سعيدًا

49
00:04:33,500 --> 00:04:35,260
!ألا يمكنك القيادة أيّها الغبيّ؟

50
00:04:36,960 --> 00:04:38,540
!هل أنت بخير؟

51
00:04:46,950 --> 00:04:48,980
أواثق حيال هذا؟

52
00:04:48,980 --> 00:04:50,660
...ربّما عليّ أنا أن

53
00:04:50,660 --> 00:04:54,310
لا. ما زلت لم تستعد كامل
.عافيتك يا أخي نيكو

54
00:04:54,310 --> 00:04:55,820
.أنا سأذهب

55
00:04:55,820 --> 00:04:59,460
.لا بأس. أعرف تمامًا أين أجد الموطن الآن

56
00:04:59,460 --> 00:05:00,590
.هكذا إذًا

57
00:05:00,590 --> 00:05:02,500
.شكرًا يا ليفيو

58
00:05:02,500 --> 00:05:03,950
.لا داعي لشكري

59
00:05:03,950 --> 00:05:08,530
.سأفعل ما أستطيع من أجل الأطفال أيضًا

60
00:05:09,580 --> 00:05:10,660
.نحن نعتمد عليك

61
00:05:10,660 --> 00:05:14,590
.حاضر يا عمّة... يا عمّتي ميلاني

62
00:05:15,740 --> 00:05:17,300
.حسنًا، سأغادر الآن

63
00:05:29,230 --> 00:05:30,810
...هذا مؤلم

64
00:05:30,810 --> 00:05:32,310
!كلاّ! عظامي

65
00:05:33,650 --> 00:05:36,840
!لا بأس، لا بأس
.سأصلح نفسي في وقت سريع

66
00:05:40,830 --> 00:05:42,360
.أرأيتم؟ عدت لطبيعتي

67
00:05:43,020 --> 00:05:45,280
.حسنًا، سأغادر ثانية

68
00:06:03,110 --> 00:06:04,050
ما الوضع؟

69
00:06:06,060 --> 00:06:10,720
.مرّت خمسة أيّام
.يفترض به أن يكون قد عاد

70
00:06:10,720 --> 00:06:16,830
آمل ألاّ يكون قد ضاع في الصّحراء
.أو أنّ سرب ديدان يطارده

71
00:06:17,230 --> 00:06:18,980
.علينا أن نثق به وننتظر

72
00:06:19,980 --> 00:06:22,730
ميلاني، ما وضع الطّعام والماء؟

73
00:06:22,730 --> 00:06:25,080
.ربّما ما زال لدينا يوم أو يومان

74
00:06:25,720 --> 00:06:27,290
.فهمت

75
00:06:27,290 --> 00:06:30,700
.هذا صحيح. سنذهب جميعًا إلى الفضاء

76
00:06:30,700 --> 00:06:33,010
!رحلة كبيرة عبر بحر النّجوم

77
00:06:34,320 --> 00:06:37,590
.سنغادر هذا النّجم ونجد واحدًا جديدًا

78
00:06:37,590 --> 00:06:39,330
.واثق أنّ بإمكاننا العثور على موطن جديد

79
00:06:39,330 --> 00:06:41,690
هل ستأتي معنا يا أخي نيكو؟

80
00:06:41,690 --> 00:06:43,170
.بالطّبع سآتي

81
00:06:43,170 --> 00:06:44,840
وعمّتي ميلاني أيضًا؟

82
00:06:44,840 --> 00:06:46,470
!جميعنا معًا

83
00:06:46,470 --> 00:06:49,440
!لنسافر ونأكل أطنانًا من الطّعام الجيّد

84
00:06:49,440 --> 00:06:50,460
!أجل

85
00:06:50,460 --> 00:06:52,070
.أخبرني يا أخي نيكو

86
00:06:52,810 --> 00:06:55,040
من أيّ اتّجاه ستأتي السّفينة الفضائيّة؟

87
00:06:55,450 --> 00:06:57,220
...ذلك

88
00:06:58,570 --> 00:07:00,120
.لا أدري

89
00:07:00,120 --> 00:07:02,900
من هناك؟ أو ربّما من هنا؟

90
00:07:03,240 --> 00:07:04,780
.ستأتي من هذا الاتّجاه

91
00:07:05,770 --> 00:07:07,310
كيف تعرف؟

92
00:07:07,820 --> 00:07:12,720
تقع في هذا الاتّجاه النّجمة الّتي هي موطن
.جميع من يعيشون في نومانز لاند الأصليّ

93
00:07:12,720 --> 00:07:14,080
تقصد الأرض، صحيح؟

94
00:07:14,360 --> 00:07:17,010
.فهمت. سيأتون من هناك إذًا

95
00:07:17,010 --> 00:07:18,750
أيمكن أن نراهم يا ترى؟

96
00:07:18,750 --> 00:07:20,530
!من المستحيل أن نراهم

97
00:07:20,530 --> 00:07:22,010
!أنا أراهم

98
00:07:22,010 --> 00:07:23,510
!أنت تكذب

99
00:07:23,510 --> 00:07:27,760
...لستُ أكذب. هناك سفينة، سفينتان
.بلا ثلاثون سفينة

100
00:07:27,760 --> 00:07:31,420
معك حقّ. هناك شخص يلوّح
.بيده من النّافذة

101
00:07:31,420 --> 00:07:33,590
!ماذا؟ أين؟ أين؟

102
00:07:35,310 --> 00:07:37,580
!لقد خدعتنا

103
00:07:38,400 --> 00:07:41,280
مهلاً، مهلاً... هل جئت من الأرض
أيضًا يا أخي فاش؟

104
00:07:41,280 --> 00:07:43,530
.لم أزر الأرض أيضًا

105
00:07:43,970 --> 00:07:46,860
.لقد وُلدنا على متن سفينة تسافر في الفضاء

106
00:07:47,380 --> 00:07:48,620
وُلدنا"؟"

107
00:07:48,950 --> 00:07:50,940
.لديّ أخ توأم

108
00:07:50,940 --> 00:07:53,790
حقًّا؟! وهل لديك أفراد عائلة آخرين؟

109
00:07:56,140 --> 00:07:57,500
...ريم

110
00:07:57,890 --> 00:08:02,440
كانت هناك امرأة تُدعى
.ريم سِيْفريم ربّتنا أنا وأخي

111
00:08:02,440 --> 00:08:04,840
هل تقصد أنّها والدتك؟

112
00:08:04,840 --> 00:08:07,420
.نعم، يمكن القول أنّها بمثابة أمّ لنا

113
00:08:08,590 --> 00:08:12,280
.كانت ريم لطيفة جدًّا وعلّمتنا أشياء كثيرة

114
00:08:13,140 --> 00:08:16,380
وبالمناسبة، سأتشارك معكم
.كلمات اعتادت أن تقولها

115
00:08:17,170 --> 00:08:19,060
.حسنًا، أنصتوا جيّدًا

116
00:08:20,680 --> 00:08:25,400
.لدينا جميعًا تذكرة فارغة لا وجهة محدّدة فيها

117
00:08:25,400 --> 00:08:28,210
.وما نضعه فيها يعتمد علينا

118
00:08:28,690 --> 00:08:31,030
،مهما كانت الظُّلمة الّتي قد نجد أنفسنا فيها

119
00:08:31,030 --> 00:08:36,460
ستكون تلك التّذكرة بانتظارنا دائمًا
.لنكتب عليها وجهتنا الّتي نريد

120
00:08:38,250 --> 00:08:39,760
...تذكرة

121
00:08:39,760 --> 00:08:41,000
فارغة؟

122
00:08:41,000 --> 00:08:42,950
.هيّا جميعًا، مدّوا أيديكم

123
00:08:46,070 --> 00:08:50,090
.إليك واحدة، وإليك، وإليك

124
00:08:50,460 --> 00:08:52,810
.يحمل كلّ منكم تذكرة فارغة

125
00:08:54,350 --> 00:08:56,090
،ما دامت تلك التّذكرة معكم

126
00:08:56,090 --> 00:08:59,610
يمكنكم الذّهاب إلى أيّ مكان
.وتكونوا ما تريدون

127
00:09:00,190 --> 00:09:04,580
،وبفضل هذه التّذكرة
.بإمكانكم تحمّل أيّة صعاب

128
00:09:05,600 --> 00:09:07,860
.مثلما فعلتُ أنا

129
00:09:08,720 --> 00:09:12,170
.تذكّروا جيّدا، اعتنوا بتلك التّذكرة

130
00:09:12,170 --> 00:09:13,170
!حاضر

131
00:09:19,220 --> 00:09:21,520
!يا شريكتي! أسرعي، أسرعي

132
00:09:23,620 --> 00:09:24,580
!جيسيكا

133
00:09:24,580 --> 00:09:26,910
!ميريل، ميلي! إنّها درّاجة ناريّة

134
00:09:26,910 --> 00:09:28,590
!رأيناها أيضًا

135
00:09:30,340 --> 00:09:31,340
!فاش؟

136
00:09:30,340 --> 00:09:31,340
!متعهّد الجنائز؟

137
00:09:34,000 --> 00:09:34,850
.مرحبًا

138
00:09:37,370 --> 00:09:38,530
من أنت؟

139
00:09:39,070 --> 00:09:41,550
.اهدأن أنتنّ الثّلاثة

140
00:09:41,550 --> 00:09:43,850
.أ-أكيد. المعذرة

141
00:09:43,850 --> 00:09:45,740
...ظننتُ حقًّا أنّه

142
00:09:45,740 --> 00:09:49,120
.ربّما كان فاش أو متعهّد الجنائز من عاد

143
00:09:49,120 --> 00:09:52,650
.لم يأت أيّ منهما، لكنّهما بخير

144
00:09:53,740 --> 00:09:55,950
.إنّهما الآن في مكان آخر

145
00:09:55,950 --> 00:09:59,490
أوشكت مؤونتهم من الطّعام والماء
.أن تنفد وهم ينتظرون النّجدة

146
00:09:59,490 --> 00:10:01,180
.أتيتُ إلى هنا لإخباركم بذلك

147
00:10:01,180 --> 00:10:05,400
تطلّب منه المجيء إلى هنا خمسة
.أيّام بلا راحة أو نوم

148
00:10:05,400 --> 00:10:07,110
!خمسة أيّام بلا نوم...؟

149
00:10:07,110 --> 00:10:10,590
كان يجب أن يأخذ الأمر منّي
...ثلاثة أيّام فقط، لكن

150
00:10:11,000 --> 00:10:12,930
!مرحى

151
00:10:12,930 --> 00:10:15,150
!يا لها من درّاجة رائعة

152
00:10:15,430 --> 00:10:17,050
!اسلبوه إيّاها

153
00:10:16,020 --> 00:10:17,050
...كم هذا مملّ

154
00:10:19,430 --> 00:10:23,140
!كلاّ

155
00:10:39,370 --> 00:10:40,550
!في الاتّجاه المعاكس؟

156
00:10:42,710 --> 00:10:45,650
وظهرت عدّة متاعب أخرى
.غير متوقّعة في الطّريق

157
00:10:45,650 --> 00:10:49,130
.أنا واثق من هذا
.إنّه صوت النّاب المزدوج ليفيو

158
00:10:49,130 --> 00:10:54,050
هل جاء إلى هنا لقتلنا؟
.لا يبدو الأمر كذلك

159
00:10:54,580 --> 00:11:00,500
تريدون إجلاء أطفال ميتم هوبلاند
إلى هذه السّفينة، أليس كذلك؟

160
00:11:00,500 --> 00:11:01,350
.نعم

161
00:11:01,350 --> 00:11:03,260
.أفهم الوضع جيّدًا

162
00:11:03,260 --> 00:11:04,260
...إذًا

163
00:11:04,260 --> 00:11:05,310
...لكن

164
00:11:05,930 --> 00:11:09,190
لا يمكننا استقبال الأطفال هنا
.على متن الموطن

165
00:11:22,620 --> 00:11:23,700
!لقد وصلوا

166
00:11:28,710 --> 00:11:32,420
!مرحى! نحن هنا

167
00:11:32,910 --> 00:11:34,420
!فاش

168
00:11:35,370 --> 00:11:38,180
!أيّها الغبيّ! قلقتُ كثيرًا عليك

169
00:11:38,180 --> 00:11:40,120
.أنا آسف يا جيسيكا

170
00:11:40,120 --> 00:11:42,080
!كم أنا مسرورة لأنّكم بخير

171
00:11:42,610 --> 00:11:45,510
.ميريل، ميلي... آسف لأنّي أقلقتكما

172
00:11:45,510 --> 00:11:46,850
.قلقنا بالفعل

173
00:11:46,850 --> 00:11:49,240
!أنت تدين لنا بمقابلة حصريّة الآن

174
00:11:51,700 --> 00:11:53,660
...ولكن مع ذلك

175
00:11:53,660 --> 00:11:54,700
.نعم

176
00:11:56,310 --> 00:11:58,570
ما الّذي حدث لشعرك؟

177
00:11:58,570 --> 00:12:00,810
غيّرتُ مظهري. أليس هذا مناسبًا لي؟

178
00:12:00,810 --> 00:12:03,060
!يا له من تصرّف جامح منك

179
00:12:03,530 --> 00:12:08,560
ربّما لأنّني... تسبّبتُ له بالكثير
...من الإرهاق والمتاعب... لذلك

180
00:12:08,560 --> 00:12:12,170
.هذا ليس خطأك. لا تقلق حيال ذلك

181
00:12:12,750 --> 00:12:15,010
هل أنت متأكّد أنّك بخير؟

182
00:12:15,340 --> 00:12:18,130
.نعم. كنتُ على شفير الموت فحسب

183
00:12:18,130 --> 00:12:19,490
!ماذا؟

184
00:12:20,240 --> 00:12:22,360
.الأمور بخير الآن نوعًا ما

185
00:12:22,360 --> 00:12:26,850
.قولك لـ"نوعًا ما" لا يطمئن بتاتًا
.لديك سوابق

186
00:12:27,330 --> 00:12:29,580
.أنا حقًّا بخير

187
00:12:29,580 --> 00:12:30,880
!حقًّا؟

188
00:12:30,880 --> 00:12:33,370
.حقًّا حقًّا بخير

189
00:12:33,370 --> 00:12:35,010
أيمكننا أن نثق بك؟

190
00:12:39,480 --> 00:12:41,140
.يمكنكما الوثوق بي

191
00:12:42,420 --> 00:12:47,040
.لن أموت. عليّ حماية هؤلاء الأطفال

192
00:12:47,780 --> 00:12:50,640
.حسنًا، هذا يكفي. يا لكما من مزعجتين

193
00:12:52,250 --> 00:12:53,290
...إذًا

194
00:12:54,380 --> 00:12:56,430
ما كلّ هذا؟

195
00:12:57,970 --> 00:13:01,180
.كنتُ أتمنّى لو تستقبلوا أطفال الميتم

196
00:13:01,960 --> 00:13:05,270
لماذا أتيتم جميعًا إلى هنا بدل ذلك؟

197
00:13:05,710 --> 00:13:07,890
...تحدّثنا مع السّيّدة لويدا و

198
00:13:08,800 --> 00:13:13,180
لكن... لا يمكننا استقبال الأطفال
.هنا على متن الموطن

199
00:13:13,180 --> 00:13:14,590
...لـ-لكن

200
00:13:14,590 --> 00:13:15,810
!سيّدة لويدا

201
00:13:16,190 --> 00:13:18,010
.ذلك خطير جدًّا

202
00:13:18,770 --> 00:13:25,010
.نكاد ننتهي من إصلاح المحرّكات
.ستطير هذه السّفينة ثانية قريبًا

203
00:13:25,010 --> 00:13:28,410
.علينا الذّهاب لتسوية حساباتنا مع نايفز

204
00:13:29,370 --> 00:13:30,580
...لذلك يا ليفيو

205
00:13:31,050 --> 00:13:33,920
.نحن من لدينا طلب منكم

206
00:13:34,660 --> 00:13:40,400
أرسلوا أطفال هذه السّفينة وغير
.المقاتلين إلى هوبلاند كلاجئين رجاءً

207
00:13:41,100 --> 00:13:43,070
.هذا ما قالته

208
00:13:43,070 --> 00:13:44,470
.قرار جيّد

209
00:13:44,470 --> 00:13:46,250
.هذا هو المتوقّع من لويدا

210
00:13:46,250 --> 00:13:50,250
،جلبنا معنا الكثير من الطّعام والماء
.لذلك سنكون بخير لبعض الوقت

211
00:13:50,670 --> 00:13:52,440
...ومع ذلك

212
00:13:52,440 --> 00:13:54,710
!لماذا أنتما هنا أيضًا؟

213
00:13:54,710 --> 00:14:00,220
هل من مشكلة؟
.نحن أيضًا من غير المقاتلين

214
00:14:00,220 --> 00:14:04,480
.يحتاج الأطفال لدروس الموسيقى كلّ يوم

215
00:14:04,480 --> 00:14:05,480
!ماذا؟

216
00:14:05,480 --> 00:14:07,690
.حسنًا يا أطفال، جاء وقت الدّرس

217
00:14:07,690 --> 00:14:09,020
!حاضر

218
00:14:09,350 --> 00:14:10,480
،يا صاحب الجلالة

219
00:14:10,480 --> 00:14:13,860
قدّم لنا عرض دمى جديد
.بعد درس الموسيقى

220
00:14:13,860 --> 00:14:14,940
.لا

221
00:14:14,940 --> 00:14:16,540
!مرحى

222
00:14:14,950 --> 00:14:16,540
!أجل

223
00:14:16,540 --> 00:14:17,490
!لن أفعل ذلك

224
00:14:17,490 --> 00:14:18,600
!لا أطيق الانتظار

225
00:14:18,600 --> 00:14:19,870
.قلتُ لا

226
00:14:21,830 --> 00:14:26,190
.علينا أيضًا مرافقة فاش إلى أكتوفرن

227
00:14:26,190 --> 00:14:29,410
.نعم

228
00:14:26,840 --> 00:14:30,780
،لنشهد النّهاية حتّى آخر لحظة
.ونسجّل كلّ شيء

229
00:14:31,450 --> 00:14:35,640
من واجبنا الالتزام بمبادئنا كصحفيّتين
.ونعرضها للأجيال القادمة

230
00:14:38,870 --> 00:14:39,830
!نعم

231
00:14:38,870 --> 00:14:43,780
.حسنًا، كلّ شيء جاهز
.البطّاريّة مشحونة بالكامل

232
00:14:43,780 --> 00:14:46,210
.يمكننا الذّهاب إلى أيّ مكان الآن

233
00:14:48,020 --> 00:14:49,170
ميلي؟

234
00:14:50,640 --> 00:14:51,910
نعم؟

235
00:14:55,170 --> 00:14:58,280
!مـ-ميلي، هناك دودة
!هنا— كلاّ— دودة

236
00:14:58,280 --> 00:15:00,130
!أنا مسرورة جدًّا

237
00:15:00,130 --> 00:15:00,940
!بشأن ماذا؟

238
00:15:00,940 --> 00:15:02,670
.إنّها من أختي الكبرى

239
00:15:02,670 --> 00:15:09,330
إنّ كُلاًّ من أبي وأمّي وإخوتي وأخواتي
...وأبناء وبنات إخوتي وأبناء عمومتي

240
00:15:09,330 --> 00:15:12,220
!جميعهم بخير

241
00:15:12,220 --> 00:15:13,220
ماذا؟

242
00:15:13,510 --> 00:15:19,550
،لكن يبدو أنّهم قريبون من أكتوفرن
.وهذا يقلقني بعض الشّيء

243
00:15:19,550 --> 00:15:21,710
عمّ تتحدّثين؟

244
00:15:21,710 --> 00:15:26,220
سبق وأخبرتك أنّ عائلتنا
تروّض الدّيدان، أليس كذلك؟

245
00:15:26,220 --> 00:15:27,530
!هذه المعلومة جديدة عليّ

246
00:15:27,870 --> 00:15:30,780
بإمكانك فهم لغة الدّيدان؟

247
00:15:31,320 --> 00:15:33,400
.لا أفهمها بشكل حرفيّ

248
00:15:33,400 --> 00:15:38,960
لكن هناك شيء ما... لنقل
.أنّه يصلني شعور ما منها

249
00:15:42,720 --> 00:15:45,490
!شكرًا جزيلاً لك

250
00:15:47,010 --> 00:15:50,200
كيف عرفت أنّك ستكونين هنا؟

251
00:15:50,200 --> 00:15:54,920
،حتّى لو كانت الدّيدان بعيدة
.يمكنها التّواصل بمشاعرها فورًا

252
00:15:54,920 --> 00:15:58,330
.تردّد كلّ منها صدى قلب الأخرى
.هذا ما قاله لي أخي

253
00:15:58,330 --> 00:16:01,190
أو ربّما كانت أختي؟

254
00:16:01,190 --> 00:16:04,900
.صدى قلوبها؟ تذكّرتُ أمرًا

255
00:16:06,080 --> 00:16:08,980
المنفردون متّصلون ببعض، صحيح؟

256
00:16:10,530 --> 00:16:13,490
.على أيّ حال، أنا مسرورة لأنّ عائلتك آمنة

257
00:16:13,490 --> 00:16:14,660
!نعم

258
00:16:53,500 --> 00:16:58,410
لم تخبرني حتّى الآن ماذا تنوي
.أن تفعل مع نايفز

259
00:17:01,390 --> 00:17:02,790
.سأقنعه

260
00:17:02,790 --> 00:17:04,170
أنت تمزج، صحيح؟

261
00:17:04,170 --> 00:17:05,510
.أنا جادّ

262
00:17:05,510 --> 00:17:08,200
...ولكن إذا لم أستطع إقناعه

263
00:17:08,200 --> 00:17:10,040
فماذا ستفعل؟

264
00:17:10,040 --> 00:17:12,860
.يمكنني الوصول إلى نواة البلانت

265
00:17:13,380 --> 00:17:17,280
ناي بلانت أيضًا، لذلك سأكون قادرًا
.على الوصول إلى نواته... كما أظنّ

266
00:17:17,800 --> 00:17:18,950
وبعد؟

267
00:17:19,350 --> 00:17:23,590
.قوّتي كبلانت هي سلب الأشياء

268
00:17:23,980 --> 00:17:28,440
بإمكاني الحصول على البلانت
.الّتي أخذها ناي... وسلبها منه

269
00:17:29,160 --> 00:17:31,450
،وبدون قوّة تلك البلانت

270
00:17:31,450 --> 00:17:35,090
.حتّى نايفز لن يستطيع إسقاط أسطول المهاجرين

271
00:17:35,090 --> 00:17:38,910
فهمت. ولكن هل سينجح ذلك؟

272
00:17:38,910 --> 00:17:40,780
...إن فشلت

273
00:17:40,780 --> 00:17:43,400
فسيكون من السّيئ تكرار
.مأساة جولاي المفقودة

274
00:17:44,000 --> 00:17:48,280
جميع ساكنة الكوكب تقريبًا
.موجودين في أكتوفرن الآن

275
00:17:48,700 --> 00:17:52,470
،إذا قضيتَ عليهم بالكامل
.فستكون أسوأ نهاية ممكنة

276
00:17:56,140 --> 00:17:57,010
.أنا آسف

277
00:17:57,010 --> 00:18:01,000
،أنا أعلم، ولذلك ومن باب الحيطة
...أريد إبعاد الفُلك

278
00:18:01,000 --> 00:18:07,560
أريد إبعاد نايفز قدر الإمكان
...عن أكتوفرن

279
00:18:13,060 --> 00:18:16,610
!صدى القلب... هذه هي! صدى القلب

280
00:18:16,610 --> 00:18:17,620
ميريل؟

281
00:18:27,320 --> 00:18:29,150
.مثلما تتّصل الدّيدان ببعضها

282
00:18:29,150 --> 00:18:31,540
...عمّ تتحدّثين؟ كيف لذلك أن

283
00:18:32,990 --> 00:18:34,500
هل ذلك ممكن؟

284
00:18:34,500 --> 00:18:36,150
.قد أستطيع ذلك

285
00:18:36,150 --> 00:18:37,250
حقًّا؟

286
00:18:37,250 --> 00:18:39,750
...نعم! إذا كان ذلك ممكنًا

287
00:18:39,750 --> 00:18:44,270
قد نتمكّن من حسم هذا الأمر
،دون انتظار وصول أسطول المهاجرين

288
00:18:44,790 --> 00:18:46,520
!أو ظهور ناي في أكتوفرن

289
00:18:47,010 --> 00:18:48,770
.شكرًا لك يا ميريل

290
00:18:50,290 --> 00:18:55,480
...لكن حتّى لو علم ناي بمكاني

291
00:18:55,480 --> 00:18:56,760
فهل سيأتي؟

292
00:18:56,760 --> 00:18:58,060
.بالطّبع سيأتي

293
00:18:58,510 --> 00:18:59,780
ولفوود؟

294
00:19:00,080 --> 00:19:02,300
،لا يهمّ كم تقاتلتما وتشاجرتما معًا

295
00:19:02,300 --> 00:19:07,000
فالأخ الأكبر يريد دائمًا أن يُبقي
.أخاه الصّغير تحت نظره

296
00:19:08,190 --> 00:19:09,880
...أخي نيكو

297
00:19:09,880 --> 00:19:13,040
!لا أقصدك بذلك
!أتحدّث بشكل عامّ فحسب

298
00:19:13,040 --> 00:19:14,090
.فهمت

299
00:19:14,090 --> 00:19:15,260
!لم تفهم شيئًا

300
00:19:15,920 --> 00:19:18,780
!إذًا أين هو؟! إلى أين نستدرجه؟

301
00:19:19,420 --> 00:19:20,640
.هناك مكان مناسب

302
00:19:21,860 --> 00:19:23,570
...مكان لتسوية هذا

303
00:19:31,960 --> 00:19:32,730
!أجل

304
00:19:34,960 --> 00:19:38,110
جيسيكا، اعتني بالأطفال الصّغار، موافقة؟

305
00:19:38,110 --> 00:19:42,540
،أكيد! عندما تعود يا فاش
!سأثبّت هذه على معطفك

306
00:19:43,440 --> 00:19:45,940
.أيّها الأطفال، أحسنوا التّصرّف مع البقيّة

307
00:19:45,940 --> 00:19:47,060
!أخي نيكو

308
00:19:47,060 --> 00:19:48,170
!اعتن بنفسك

309
00:19:48,170 --> 00:19:49,540
!عد إلينا سريعًا

310
00:19:49,540 --> 00:19:51,290
!وأنت أيضًا يا ليفيو

311
00:19:49,540 --> 00:19:51,290
!أخي نيكو

312
00:19:58,290 --> 00:20:01,320
.هذا هو كلّ ما لدينا

313
00:20:02,070 --> 00:20:07,370
.هذا أفضل من لا شيء
.كن ممتنًّا لنا

314
00:20:07,370 --> 00:20:08,640
...مـ-مهلاً

315
00:20:08,640 --> 00:20:11,400
.إنّنا نعهد لك بالمستقبل أيّها المُعاقب نيكولاس

316
00:20:12,150 --> 00:20:15,410
.لا، بل يا نيكولاس دي ولفوود

317
00:20:16,450 --> 00:20:19,320
.لم أتوقّع هذا منكما

318
00:20:19,320 --> 00:20:25,040
.وبالمناسبة... شكرًا لأنّكم أبقيتم على حياتنا

319
00:20:25,040 --> 00:20:28,620
.ارجعوا إلينا بأمان ولا تموتوا

320
00:20:28,620 --> 00:20:31,820
.ما زال لديك وعد لتفي به

321
00:20:32,320 --> 00:20:33,580
...نعم

322
00:20:34,140 --> 00:20:35,230
.لا تبك

323
00:20:35,230 --> 00:20:36,650
!أنا لا أبكي

324
00:20:36,650 --> 00:20:40,600
.يمكنكم تجاهل نصف ما يقوله هذا الشّخص

325
00:20:40,600 --> 00:20:41,970
.هذا فظيع

326
00:20:41,970 --> 00:20:43,040
.لا داعي لهذا إطلاقًا

327
00:20:43,040 --> 00:20:44,990
.صحيح يا ولفوود

328
00:20:44,990 --> 00:20:46,980
.أنت طيّب القلب حقًّا

329
00:20:50,800 --> 00:20:52,720
.لم أتوقّع هذا بتاتًا

330
00:20:53,400 --> 00:20:57,770
.كنت أظنّ أنّك ستمنعنا أنا وزميلتي من المجيء

331
00:20:57,770 --> 00:21:00,460
وهل كنتما لتستمعا لي لو حاولتُ إيقافكما؟

332
00:21:00,460 --> 00:21:02,160
.هذا صحيح

333
00:21:02,160 --> 00:21:04,190
.ومع ذلك تفاجأت

334
00:21:04,190 --> 00:21:05,740
.وأنا أيضًا تفاجأت

335
00:21:06,430 --> 00:21:10,520
،نعم. هذا الأمر خطير
.لذلك كنتُ لأفضّل لو لم تأتيا

336
00:21:10,520 --> 00:21:11,750
...لكن

337
00:21:12,330 --> 00:21:14,590
.نريد مساعدتك على حمله

338
00:21:14,590 --> 00:21:17,370
.لستَ وحدك في هذه المعركة

339
00:21:19,920 --> 00:21:21,380
ما تلك النّظرة على وجهك؟

340
00:21:21,650 --> 00:21:23,660
ما تلك النّظرة على وجهك بالفعل؟

341
00:21:23,990 --> 00:21:25,510
.لا شيء على الإطلاق

342
00:21:26,670 --> 00:21:31,060
،ولكن يا ميريل وميلي
.أريد منكما أن تعدانني بشيء

343
00:21:31,060 --> 00:21:32,020
نعدك؟

344
00:21:32,680 --> 00:21:35,460
.لا تفعلا أيّ شيء خطير أبدًا

345
00:21:35,900 --> 00:21:40,350
.بالطّبع لن نفعل. علينا توثيق كلّ ما يحدث

346
00:21:40,350 --> 00:21:43,600
.يجب الحفاظ على كلّ الأحداث

347
00:21:43,600 --> 00:21:45,440
...يا زميلتي

348
00:21:45,440 --> 00:21:46,650
ماذا هنالك؟

349
00:21:50,410 --> 00:21:52,920
!رافقتكم السّلامة

350
00:21:52,920 --> 00:21:57,060
!مع السّلامة

351
00:21:57,920 --> 00:22:00,770
!عودوا إلينا سالمين

352
00:22:00,770 --> 00:22:03,930
!كونوا حذرين جميعًا

353
00:22:08,790 --> 00:22:10,240
!سنغادر الآن

354
00:23:51,180 --> 00:23:54,910
!والآن، اقتلني! اقتل بشريًّا