1
00:00:01,550 --> 00:00:02,770
...عيناك

2
00:00:03,510 --> 00:00:06,440
مثل عينيّ أيّها الشاب

3
00:00:18,400 --> 00:00:19,830
...أتذكّر

4
00:00:22,040 --> 00:00:23,830
أتذكّرها

5
00:00:34,270 --> 00:00:35,210
تعال

6
00:00:37,160 --> 00:00:39,500
لطالما كنتُ بانتظارك

7
00:02:11,930 --> 00:02:13,630
من أنتِ؟

8
00:02:14,280 --> 00:02:15,990
ما قصدك أنّكِ كنتِ تنتظريني؟

9
00:02:16,250 --> 00:02:17,610
اهدأ

10
00:02:17,610 --> 00:02:19,740
تحوم قوّةٌ سحريّة في عينيّ الساحرة

11
00:02:20,040 --> 00:02:22,990
إذا لم تتوخَّ الحذر، فستُسحر

12
00:02:26,850 --> 00:02:28,040
أنتِ عقبة

13
00:02:35,500 --> 00:02:36,530
!لوس-سينسي

14
00:02:38,610 --> 00:02:41,340
!لوس-سينسي

15
00:02:42,200 --> 00:02:47,590
مُتظاهرةٌ لا تستطيع استعمال السحر تدعو
نفسها بالساحرة، وتقف بجانبك

16
00:02:48,120 --> 00:02:50,440
أشعر بامتعاضٍ شديد

17
00:02:51,290 --> 00:02:54,400
أيّها الشاب، أنت مميّز

18
00:02:55,030 --> 00:02:57,490
أفضل من المُتظاهرة التي تمسك بها

19
00:02:57,490 --> 00:03:02,340
وأفضل من الحشرات التي احتشدت
حولك لأجل سحرك

20
00:03:04,160 --> 00:03:05,240
...هذه

21
00:03:06,770 --> 00:03:08,250
ما الذي فعلتِه لـ هورت؟

22
00:03:08,940 --> 00:03:11,340
أعطيتها للمُرتزق

23
00:03:12,860 --> 00:03:15,790
لاسترجاعك من آلبس

24
00:03:16,090 --> 00:03:18,260
اتخذتُ تدابير مُطوّلة

25
00:03:18,750 --> 00:03:21,340
بما فيها جلبك لهذه القرية، كلّ ذلك لأجلك

26
00:03:21,960 --> 00:03:23,250
...لأجلي

27
00:03:24,470 --> 00:03:26,360
...إنّها غلطتي

28
00:03:37,760 --> 00:03:40,100
سأحبّك

29
00:03:40,750 --> 00:03:43,450
سأرشدك

30
00:03:43,950 --> 00:03:48,940
إذا كنت معي، لن يتمكّن أحدٌ من أذيّتك

31
00:03:48,940 --> 00:03:50,910
هيّا، تعال

32
00:03:51,910 --> 00:03:55,060
سأصطحبك إلى عالمٍ يليق بك

33
00:03:57,390 --> 00:03:59,920
كيف لا يليقون بي؟

34
00:04:04,350 --> 00:04:05,300
...هورت

35
00:04:06,000 --> 00:04:09,680
كانت تعاملني بلطفٍ حتّى عندما لم
يكن هناك شيءٌ مميّز بي

36
00:04:09,680 --> 00:04:13,060
قالت أنّ فكرة موتي أخافتها

37
00:04:13,390 --> 00:04:14,600
وكودو

38
00:04:14,600 --> 00:04:17,440
كان صريحاً، وعامل الجميع بالمثل

39
00:04:18,090 --> 00:04:21,030
كان يتحلّى بشجاعة عدم تغيير موقفه
الحاد مع أيّ أحد

40
00:04:22,400 --> 00:04:24,040
وكذلك لوس-سينسي

41
00:04:25,650 --> 00:04:28,700
ألقت عصاها الثمينة لأجلنا

42
00:04:29,840 --> 00:04:33,870
علّمتنا بسرور أيّ شيءٍ كنّا نجهله

43
00:04:34,340 --> 00:04:37,500
كنتِ ذاكرتي الوحيدة

44
00:04:38,630 --> 00:04:40,160
،لكن من بين كلّ ذكرياتي

45
00:04:40,160 --> 00:04:43,420
...أكثر من لا أحتاجها

46
00:04:43,420 --> 00:04:44,570
!هي التي عنك

47
00:04:48,170 --> 00:04:53,220
تصدّني؟ ساحرة بعظمتي؟

48
00:04:53,800 --> 00:04:57,980
أنا سأقرّر من هو جدير

49
00:04:58,250 --> 00:04:59,220
وأنتِ

50
00:05:00,330 --> 00:05:02,090
لستِ كذلك

51
00:05:06,270 --> 00:05:09,760
،إذا صببتُ كلّ سحري في تعويذة

52
00:05:09,760 --> 00:05:12,450
قد أتمكّن من إنقاذ لوس-سينسي على الأقلّ

53
00:05:18,200 --> 00:05:19,420
...باغ دو غلا

54
00:05:31,220 --> 00:05:32,790
ما-ماذا؟

55
00:05:49,750 --> 00:05:52,760
لم أشعر بهذا الشعور منذ وقتٍ طويل

56
00:05:52,760 --> 00:05:57,040
!جسدي بأسره يفيض بالطاقة السحريّة

57
00:05:58,120 --> 00:06:00,040
...لوس-سينسي

58
00:06:00,360 --> 00:06:02,360
إلقاء خارج السيطرة؟

59
00:06:02,360 --> 00:06:04,300
التدمير الذاتيّ أمرٌ أهوج

60
00:06:04,300 --> 00:06:06,780
ألم أعلّمك ذلك؟

61
00:06:06,780 --> 00:06:09,800
سرقتِ القوّة السحريّة منه إذاً

62
00:06:10,140 --> 00:06:13,400
لكن، قبل أن تستطيعي
،إتمام أيّ شعوذة

63
00:06:13,400 --> 00:06:15,930
يمكنني إلقاء السحر

64
00:06:16,290 --> 00:06:18,570
تظنّين ذلك

65
00:06:19,920 --> 00:06:21,540
!باغ دو غلات

66
00:06:22,020 --> 00:06:23,350
!فلتظهري يا نار الجحيم

67
00:06:23,350 --> 00:06:24,810
!توهّجي واعصفي

68
00:06:26,220 --> 00:06:28,150
لوس-سينسي؟ يمكنكِ إلقاء السحر؟

69
00:06:28,150 --> 00:06:31,980
يمكنني إلقاء هذا المستوى من السحر
عبر محاكاة ما رأيته

70
00:06:32,530 --> 00:06:34,910
فأنا عبقريّة

71
00:06:35,590 --> 00:06:37,480
!فصل الصيد، المقطع الأخير

72
00:06:37,480 --> 00:06:38,610
!فلاغيس

73
00:06:38,610 --> 00:06:40,000
!امنحيني القوّة

74
00:06:40,000 --> 00:06:42,750
!اسمي لو كريستاس

75
00:06:49,430 --> 00:06:50,930
مُسلٍّ

76
00:06:52,430 --> 00:06:53,930
أرفض سحرك

77
00:06:54,530 --> 00:06:56,150
فلتمنحني القوّة

78
00:06:56,150 --> 00:06:57,930
أنا زيرو

79
00:07:03,730 --> 00:07:05,430
لا تستخفّي بي يا ساحرة الفجر

80
00:07:05,430 --> 00:07:07,370
فتلك تعويذتي

81
00:07:07,370 --> 00:07:09,280
سحري

82
00:07:09,280 --> 00:07:12,320
إنّها حكمتي وقوّتي

83
00:07:13,080 --> 00:07:16,580
من المدعاة للضحك استعمالها ضدّي

84
00:07:16,950 --> 00:07:20,330
الفنّ الذي تدعونه بالسحر
،الذي يحلّ محلّ الشعوذة

85
00:07:21,120 --> 00:07:23,960
بدأ كلّ شيءٍ بكتاب تعاويذ زيرو

86
00:07:24,600 --> 00:07:26,520
أنا زيرو تلك

87
00:07:27,500 --> 00:07:29,990
أنا كتبتُ كتاب تعاويذ زيرو

88
00:07:31,730 --> 00:07:33,530
هذا ما قصدته

89
00:07:34,590 --> 00:07:37,970
يمكنني أن أدعكِ تلتقين مؤلّفة
كتاب التعاويذ

90
00:07:38,600 --> 00:07:41,130
لم نملك أيّ فرصةٍ
بالفوز من البداية

91
00:07:45,140 --> 00:07:48,820
أنا من تستخرج معنى من اللا معنى

92
00:07:49,280 --> 00:07:52,870
،من تصنع شيئاً من العدم
!ساحرة الوحل السوداء

93
00:08:09,950 --> 00:08:11,670
ما-ماذا هناك؟

94
00:08:11,670 --> 00:08:13,280
...ومن اليوم فصاعداً

95
00:08:14,470 --> 00:08:18,930
أنا الساحرة التي ستشرف عليك
في البرنامج الميدانيّ أيضاً

96
00:08:19,530 --> 00:08:22,810
بالمناسبة، الكتاب الذي تستعملونه
،في الأكاديميّة

97
00:08:23,440 --> 00:08:26,650
"كتاب تعاويذ البداية من زيرو"
هو من تأليفي أيضاً

98
00:08:28,440 --> 00:08:29,730
...عذراً

99
00:08:29,730 --> 00:08:30,690
أحسنت الصنيع

100
00:08:31,140 --> 00:08:35,700
أرحّب بك أيّها الساحر الشاب

101
00:08:36,140 --> 00:08:37,880
...عـ-عذراً

102
00:08:43,870 --> 00:08:45,320
هل رأيت ذلك يا سيب-كن؟

103
00:08:45,320 --> 00:08:48,220
!رفض سحر حيّ واقعيّ

104
00:08:49,840 --> 00:08:51,200
!تأثّرتُ كثيراً

105
00:08:51,200 --> 00:08:54,380
!لم أعش 300 عام من فراغ

106
00:08:55,340 --> 00:08:59,070
!لمَ أنت شاردٌ هكذا؟

107
00:09:00,110 --> 00:09:01,640
!كان امتحاناً، امتحاناً

108
00:09:01,640 --> 00:09:03,560
!نجحت

109
00:09:03,930 --> 00:09:05,360
نجحت؟

110
00:09:05,360 --> 00:09:06,470
!صحيح

111
00:09:06,470 --> 00:09:07,940
!سيب-كن

112
00:09:10,250 --> 00:09:13,490
!مُباركٌ يا سيب-كن

113
00:09:13,970 --> 00:09:14,980
!هورت

114
00:09:19,820 --> 00:09:22,560
هورت، أنتِ بخير

115
00:09:23,290 --> 00:09:26,550
،لو وافقتَ على الانضمام لزيرو-ساما

116
00:09:26,550 --> 00:09:28,960
لفُصلت من فورك

117
00:09:28,960 --> 00:09:29,750
ماذا؟

118
00:09:30,280 --> 00:09:32,380
كان الجميع مشاركين في الامتحان

119
00:09:32,700 --> 00:09:34,940
كانوا يختبروننا

120
00:09:35,450 --> 00:09:37,010
اختبرني الكاهن

121
00:09:37,580 --> 00:09:39,710
أخبرني بأن أتظاهر ببقائي في صفّكم

122
00:09:39,710 --> 00:09:42,500
مع مواصلة تسريب المعلومات
لحزب معارضة الساحرات

123
00:09:43,300 --> 00:09:46,360
،لكن لحظة بصقي في وجهه

124
00:09:48,920 --> 00:09:50,570
!أنجحني

125
00:09:50,570 --> 00:09:53,190
لا بدّ أنّ ذلك الكاهن منحرف

126
00:09:54,520 --> 00:09:56,400
من تنعتينه بالمنحرف؟

127
00:09:56,770 --> 00:09:58,650
سأعيد هذه لكِ

128
00:09:58,650 --> 00:10:01,410
!لودينس-تشان

129
00:10:01,410 --> 00:10:03,260
!افتقدتك

130
00:10:01,410 --> 00:10:05,410
اكتشفتِ أنّ هذا كان امتحاناً، أليس كذلك؟

131
00:10:06,510 --> 00:10:08,580
بالطبع

132
00:10:09,080 --> 00:10:12,210
منزل العائلة التي لقت ميتات مريعة قبل
،سنتين وفقما يُفترض

133
00:10:12,210 --> 00:10:17,840
كان نظيفاً ويحوي أدوات مطبخ وماءً
كما أوراق شاي

134
00:10:18,720 --> 00:10:22,190
ولم تكن هناك آثار اهتراء
على الدمى المتدليّة

135
00:10:22,190 --> 00:10:23,700
كان الأمر سخيفاً

136
00:10:23,700 --> 00:10:25,050
...بذكركِ ذلك

137
00:10:25,050 --> 00:10:28,810
أخبرتكِ أنّ أوراق الشاي كانت تمادياً

138
00:10:28,810 --> 00:10:34,540
لكنّها كانت خلطتي الخاصة لإراحة
إرهاق السفر الطويل

139
00:10:35,360 --> 00:10:37,740
انظروا من نجح أيضاً

140
00:10:39,440 --> 00:10:41,260
!يا-يا رفاق

141
00:10:43,140 --> 00:10:44,420
!كودو

142
00:10:45,330 --> 00:10:46,830
حمداً لله

143
00:10:47,160 --> 00:10:49,400
كلاكما بخير

144
00:10:50,580 --> 00:10:52,780
اُختبرت بدوري

145
00:10:52,780 --> 00:10:56,050
أخبرني أنّه أكل هولت

146
00:10:56,880 --> 00:11:00,050
!وجّه تذمّرك للكاهن الذي كتب النصّ

147
00:11:00,490 --> 00:11:07,470
كان ذلك ضروريّاً لإثارة غضب التلامذة
وخوفهم وحسّهم بالدونيّة

148
00:11:07,470 --> 00:11:10,140
ساحرة الفجر لو كريستاس

149
00:11:10,800 --> 00:11:15,360
،رغم أنّه كان جزءاً من الامتحان
أطلب سماحكِ لي على إهاناتي

150
00:11:15,770 --> 00:11:17,860
ما قصدك؟

151
00:11:18,270 --> 00:11:22,530
أنا متُظاهرة، فذاكرتي ضعيفةٌ بعض الشيء

152
00:11:34,290 --> 00:11:36,630
هل دخلتِ المخاض؟

153
00:11:36,630 --> 00:11:39,540
لم تخفي حملاً عنّي، صحيح؟

154
00:11:39,540 --> 00:11:40,380
!مؤلم

155
00:11:40,640 --> 00:11:43,040
!لم أفعل يا خادم الدرجة الثالثة

156
00:11:43,040 --> 00:11:47,060
وصلني نبأٌ من زيرو
عبر رسالة ساحرة

157
00:11:47,470 --> 00:11:52,560
نجح التلامذة الثلاثة المتبقّين
!الذين أرسلتهم لها

158
00:11:52,850 --> 00:11:54,270
كلّهم؟

159
00:11:54,270 --> 00:11:57,120
لكن لم ينجح أيّ تلميذٍ العام الفائت

160
00:11:57,120 --> 00:11:58,440
!إنّه إنجاز

161
00:11:58,780 --> 00:12:01,950
عندما سمعت أنّهم هُوجموا
،من قبل الحكم في طريقهم

162
00:12:01,950 --> 00:12:04,690
،احترتُ فيما أفعل

163
00:12:04,690 --> 00:12:06,950
لكنّي مسرورةٌ لأنّي وثقتُ بهم

164
00:12:07,240 --> 00:12:12,460
حسناً، لعلّ التعرّض لخطرٍ مميت سويّاً
كوّن تضامناً بينهم

165
00:12:12,460 --> 00:12:14,900
أجل، لعلّك مُحقّ

166
00:12:16,960 --> 00:12:18,540
،هذا غريب

167
00:12:18,540 --> 00:12:21,100
لكن قد أدين للحكم في تلك الحالة

168
00:12:22,220 --> 00:12:24,970
حسنٌ، سأقدّم له خدمة

169
00:12:26,120 --> 00:12:29,610
وإذا أبقيناه حيّاً، قد نجد له فائدة

170
00:12:31,110 --> 00:12:36,860
وزّع هذه لكلّ السحرة وجيش الكنيسة
والسحرة وصيّادي الجوائز أيضاً

171
00:12:38,360 --> 00:12:40,710
آذى تلامذتي

172
00:12:41,750 --> 00:12:44,140
لن أدعه يفلت بلا عقابٍ أبداً

173
00:12:45,600 --> 00:12:49,990
!حسناً، نخب أوّل أعضاء للبرنامج الميدانيّ

174
00:12:50,370 --> 00:12:52,500
!في صحّتكم

175
00:12:54,940 --> 00:12:57,630
من أين ظهر كلّ هؤلاء؟

176
00:12:57,630 --> 00:12:59,920
،لتفادي أيّ تسرب عرضي

177
00:12:59,920 --> 00:13:03,100
لازموا منازلهم حتّى نهاية الامتحان

178
00:13:03,670 --> 00:13:06,540
كانت القرية مليئةً بالتسرّبات مع ذلك

179
00:13:07,180 --> 00:13:10,440
لا تكوني بتلك القسوة يا ساحرة الفجر

180
00:13:11,520 --> 00:13:14,460
دعوني أهنّئكم على نجاحكم مُجدّداً

181
00:13:14,980 --> 00:13:18,740
،سعينا لفصلكم بتفانٍ

182
00:13:18,740 --> 00:13:20,720
لكنّكم انتصرتم

183
00:13:20,720 --> 00:13:22,680
المعذرة، لديّ سؤال

184
00:13:22,680 --> 00:13:25,990
لمَ سعيتم لفصلنا؟

185
00:13:26,550 --> 00:13:28,240
لأنّ موهبتكم عاليةٌ جدّاً

186
00:13:29,720 --> 00:13:32,970
،إذا انحرف الساحر المميّز لدرب الشرّ

187
00:13:32,970 --> 00:13:35,080
فقد يعني ذلك هلاك العالم

188
00:13:35,750 --> 00:13:38,630
ارتأينا اختبار التلامذة
ذوي القدرة العظيمة

189
00:13:38,630 --> 00:13:42,280
،لرؤية ما إن كانوا أخياراً

190
00:13:42,280 --> 00:13:45,740
وفصلهم إن رسبوا

191
00:13:47,110 --> 00:13:52,830
اُختير الطالبان الآخران للحصول
على دليلٍ لخيانتهم

192
00:13:52,830 --> 00:13:54,430
لكنّكم مختلفون

193
00:13:55,280 --> 00:13:58,140
،إذا سعى أيٌّ منكم لتدمير العالم

194
00:13:58,140 --> 00:14:01,190
فقد يكون الدمار أعظم
مما رأيناه في الشمال

195
00:14:01,680 --> 00:14:04,690
أ-أنتِ تبالغين

196
00:14:05,240 --> 00:14:06,760
يا ذات القرنين الشابة

197
00:14:07,940 --> 00:14:11,010
تُعادل موهبتكِ موهبة الساحرة
مُستدعية القمر

198
00:14:11,010 --> 00:14:14,080
أي مديرة الأكاديميّة

199
00:14:14,560 --> 00:14:20,100
في غضون 10 أعوام، يُفترض أن تمتلكي قوّة
القضاء على آلاف القوّات في ثوانٍ

200
00:14:21,080 --> 00:14:22,840
أ-أنا؟

201
00:14:23,280 --> 00:14:26,590
أيّها السحليّة الشاب، سعة حيلتك ستكون مخيفة

202
00:14:27,450 --> 00:14:29,440
،موهبتك لفصل الحماية

203
00:14:29,440 --> 00:14:31,800
،إذا وصلت بتطويرها

204
00:14:31,800 --> 00:14:34,850
ستحفر اسمك كالساحر الخالد

205
00:14:35,240 --> 00:14:36,850
أنا؟

206
00:14:37,900 --> 00:14:40,810
...والسحر اللا محدود

207
00:14:41,290 --> 00:14:44,060
حتّى أنا لا أستطيع رؤية ذروتك

208
00:14:44,060 --> 00:14:45,820
،لمئات الأعوام المقبلة

209
00:14:45,820 --> 00:14:48,980
قد تكون الساحر الأطول عيشاً

210
00:14:49,510 --> 00:14:52,320
والعيش لفترةٍ طويلة يعني

211
00:14:52,870 --> 00:14:55,740
وقتاً مفتوحاً لصقل تقنياتك

212
00:14:56,600 --> 00:14:58,880
أنت هذه الكرة حاليّاً

213
00:14:58,880 --> 00:15:00,570
،لكن بمرور الوقت

214
00:15:00,570 --> 00:15:02,940
قد تخترق قوّتك كلّ شيء

215
00:15:03,960 --> 00:15:05,200
أليس ذلك مُخيفاً؟

216
00:15:05,800 --> 00:15:07,760
أنا أشعر بالخوف أيضاً

217
00:15:07,760 --> 00:15:09,560
من قوّة هذه الإمكانيّة

218
00:15:10,160 --> 00:15:11,370
...الإمكانيّة

219
00:15:12,680 --> 00:15:16,310
أي... ذلك ليس حتمياً، صحيح؟

220
00:15:16,310 --> 00:15:17,760
بالفعل

221
00:15:17,760 --> 00:15:21,060
،إذا أهملتم تمرينكم وأمضيتم أيّامكم بالكسل

222
00:15:21,290 --> 00:15:25,320
فلا أستطيع تصوّر أيّ سحرةٍ
واهنين ستصبحون عليهم

223
00:15:25,740 --> 00:15:27,630
ذلك مخيفٌ بحدّ ذاته

224
00:15:29,070 --> 00:15:32,320
لنتكلّم الآن عن البرنامج الميدانيّ

225
00:15:32,720 --> 00:15:35,660
ستمتلكون متاجر جميعاً

226
00:15:35,660 --> 00:15:36,600
متاجر؟

227
00:15:36,600 --> 00:15:37,330
أجل

228
00:15:37,850 --> 00:15:40,990
كي يسهل على أهل القرية طلب مساعدتكم

229
00:15:41,710 --> 00:15:46,630
بالمناسبة، أدير متجر سحرٍ عديم القيمة
على أطراف القرية

230
00:15:50,090 --> 00:15:52,370
سأمنحكم ثلاثة أيّام

231
00:15:52,370 --> 00:15:55,890
استغلّوا ذاك الوقت للتفكير بأيّ
...متجرٍ تريدون

232
00:15:55,890 --> 00:15:56,970
!هاكم

233
00:15:57,760 --> 00:16:00,980
!فكّروا بالأمور المعقّدة بعد الأكل

234
00:16:01,740 --> 00:16:02,740
!كلوا

235
00:16:02,740 --> 00:16:05,730
لا تتحفّظوا، سآتي بالمزيد منها

236
00:16:06,000 --> 00:16:09,360
هذا... ليس لحماً بشريّاً، صحيح؟

237
00:16:09,730 --> 00:16:11,770
لا تكن سخيفاً

238
00:16:11,770 --> 00:16:17,960
انظر للجرح النفسيّ الذي أصبت به الصبية
أيّها الكاهن القاتل

239
00:16:17,960 --> 00:16:19,830
الكاهن القاتل؟

240
00:16:20,240 --> 00:16:24,080
كنتُ حكماً في ديا إغنيس

241
00:16:25,600 --> 00:16:28,840
ولعلمكم، بإمكانه الرؤية

242
00:16:30,120 --> 00:16:33,160
لمَ ترتدي هذه على عينيك إذاً؟

243
00:16:33,160 --> 00:16:34,040
للتأنّق؟

244
00:16:34,040 --> 00:16:35,840
أهي للتأنّق؟

245
00:16:36,140 --> 00:16:38,620
يؤذي الضوء عيني

246
00:16:39,340 --> 00:16:42,100
أستطيع خلع هذه ليلاً فحسب

247
00:16:42,390 --> 00:16:44,760
لم تكن تأنّقاً إذاً

248
00:16:45,400 --> 00:16:48,110
هل الفتاة الصغيرة من الكنيسة هنا؟

249
00:16:48,600 --> 00:16:51,020
لم تكن هناك فتاةٌ صغيرة في الكنيسة

250
00:16:51,020 --> 00:16:51,860
...لكن

251
00:16:52,120 --> 00:16:56,240
إن كنتِ تقصدين ليلي، فهي تفوق العشرين عاماً

252
00:16:56,240 --> 00:17:00,240
!لا يمكن! لكنّها أصغر بكثيرٍ منّي

253
00:17:00,240 --> 00:17:04,750
شخصيّتها سريعة الخوف ولا تحبّ
تجمّعات الناس

254
00:17:05,040 --> 00:17:07,750
سأعرّفكم عليها في يومٍ ما

255
00:17:08,700 --> 00:17:10,730
...المعذرة، زيرو-سينسي

256
00:17:12,220 --> 00:17:16,550
هل أخذتِني للأكاديميّة؟

257
00:17:17,340 --> 00:17:19,010
لا تتذكّر؟

258
00:17:20,560 --> 00:17:23,410
لا بأس إذا لم تفعل

259
00:17:23,960 --> 00:17:27,410
إن استدعى الأمر، ستتذكّر عند الحاجة

260
00:17:28,700 --> 00:17:31,330
...متجر إذاً

261
00:17:31,330 --> 00:17:34,030
متجر سحر ما أيضاً

262
00:17:35,260 --> 00:17:37,030
بالمناسبة، أين لوس-سينسي؟

263
00:17:37,290 --> 00:17:40,780
قالت شيئاً عن زيارة متجر زيرو-سينسي

264
00:17:41,070 --> 00:17:44,340
تريد قراءة الكتب التي ألّفتها زيرو-سينسي

265
00:17:45,400 --> 00:17:48,500
!مـ-مهلكما! انظرا هناك

266
00:17:50,720 --> 00:17:51,990
...أذاك

267
00:17:54,940 --> 00:17:55,820
كودو؟

268
00:18:10,100 --> 00:18:11,030
...إنّه

269
00:18:15,450 --> 00:18:16,880
!الملك قاهر التنانين

270
00:18:17,840 --> 00:18:21,910
سيبيل، هورت، كودو، أهم هنا؟

271
00:18:22,440 --> 00:18:24,160
!أجل! هنا

272
00:18:25,370 --> 00:18:27,540
الرسائل من الأكاديميّة

273
00:18:28,830 --> 00:18:31,170
شـ-شكراً جزيلاً

274
00:18:31,170 --> 00:18:34,050
الملك قاهر التنانين، مضى وقتٌ طويل

275
00:18:34,400 --> 00:18:37,610
مرحباً يا هيث، أصبحت كبيراً

276
00:18:37,610 --> 00:18:39,800
أخبرتكِ ألّا تناديني بالملك قاهر التنانين

277
00:18:39,800 --> 00:18:44,930
لا تكن مُتصلّباً، تتردد أصداء
اسمك في العالم

278
00:18:44,930 --> 00:18:46,650
هذه مبالغة

279
00:18:46,650 --> 00:18:50,940
في الواقع، أنا أنفّذ مهاماً صغيرة هنا

280
00:18:51,200 --> 00:18:53,870
ذلك يُظهر أهميّة تلك الرسائل

281
00:18:58,320 --> 00:19:00,360
،بصفتكم تلامذة البرنامج الميدانيّ"

282
00:19:00,700 --> 00:19:03,740
،سيتمّ تعيينكم لقرية الساحرة

283
00:19:03,740 --> 00:19:08,120
"رُفعت كلّ التقييدات على السحر

284
00:19:08,430 --> 00:19:13,380
تلامذةٌ لم يتخرّجوا بعد يُسمح لهم
باستعمال السحر بأسره؟

285
00:19:13,920 --> 00:19:17,760
هذا بمثابة تصريح كامل
بالاشتباك في معارك

286
00:19:18,090 --> 00:19:20,930
سيكون هناك ردٌّ من الحزب المعارض
للساحرات بطبيعة الحال

287
00:19:21,540 --> 00:19:22,470
يمكنك أن تدعوها

288
00:19:22,470 --> 00:19:24,190
برسائل ذات سرّية قصوى

289
00:19:24,690 --> 00:19:27,390
تليق أن يتمّ توصيلها من قِبل تنّين

290
00:19:28,810 --> 00:19:30,100
!المعذرة

291
00:19:30,910 --> 00:19:32,900
...أ-أنا

292
00:19:33,310 --> 00:19:37,230
!أُنقذت على يديك قبل وقتٍ طويل

293
00:19:37,830 --> 00:19:40,240
أنت الوحش الساقط الذي كان
في عرض الغرائب

294
00:19:40,240 --> 00:19:42,660
أ-أتذكرني؟

295
00:19:43,240 --> 00:19:47,240
لم يمت قلبي بحيث أنسى تلك الشناعة

296
00:19:48,020 --> 00:19:51,160
أعتقد أنّك قلت أنّك تريد الالتحاق
بجيش الكنيسة والسحرة

297
00:19:51,780 --> 00:19:57,170
إذا أصبحتُ ساحراً، أتعتقد أنّ
بإمكاني الانضمام؟

298
00:19:58,430 --> 00:19:59,400
من يدري؟

299
00:20:01,920 --> 00:20:04,350
لستُ مسؤولاً عن التوظيف

300
00:20:04,970 --> 00:20:05,690
...لكن

301
00:20:06,180 --> 00:20:08,560
يبدو أنّك ستكون ذا قيمةٍ في فرقتي

302
00:20:15,840 --> 00:20:17,360
أتطلّع للكثير منك

303
00:20:17,360 --> 00:20:18,820
!أ-أجل

304
00:20:19,080 --> 00:20:20,460
لمَ؟

305
00:20:20,460 --> 00:20:23,660
!لمَ لم تستدعوني؟

306
00:20:23,660 --> 00:20:27,840
!أريد رؤية تنّينٍ عن قرب! أريد لمسه

307
00:20:27,840 --> 00:20:30,780
!أريد ركوبه إن سمح لي

308
00:20:30,780 --> 00:20:34,170
حسناً، أنا متأكّدٌ أنّه ستسنح فرصةٌ أخرى

309
00:20:30,780 --> 00:20:34,170
!أريد ركوب التنّين! أريد

310
00:20:34,660 --> 00:20:38,180
!لكن قد لا أكون في القرية حينذاك

311
00:20:40,820 --> 00:20:41,790
ما الأمر؟

312
00:20:42,400 --> 00:20:43,510
ماذا هناك؟

313
00:20:44,020 --> 00:20:46,900
أي أنّكِ سترحلين بالفعل

314
00:20:46,900 --> 00:20:50,700
أخبرتكما، كانت مرافقتنا فحسب

315
00:20:51,910 --> 00:20:55,520
بالطبع، أنوي الارتحال مجدداً
سعياً وراء التسلية

316
00:20:55,900 --> 00:20:57,820
ذاك أسلوب حياتي

317
00:21:03,230 --> 00:21:05,530
،لكن حتّى قراءتي لكلّ الكتب هنا

318
00:21:05,530 --> 00:21:08,120
أنوي البقاء في هذه القرية

319
00:21:09,080 --> 00:21:10,360
...في الواقع

320
00:21:10,360 --> 00:21:12,750
قد يستغرق الأمر ثلاثة أعوام

321
00:21:12,750 --> 00:21:15,850
لكن إذا شعرتُ بمللٍ، سأرحل فوراً

322
00:21:15,850 --> 00:21:16,750
!ادرسوا

323
00:21:17,000 --> 00:21:18,790
!أنا أحبّ النموّ

324
00:21:18,790 --> 00:21:20,310
!أحبّ التغيير

325
00:21:20,310 --> 00:21:24,640
طالما تطمحون للأعلى، سأمدّ لكم يد العون

326
00:21:24,640 --> 00:21:27,260
!فتلك هي تسليتي

327
00:21:27,840 --> 00:21:29,300
...لوس-سينسي

328
00:21:32,070 --> 00:21:35,520
!هذا خانقٌ جدّاً

329
00:21:36,010 --> 00:21:39,900
!يكفي أيّها الأطفال المُدللون

330
00:21:41,040 --> 00:21:43,150
ستبقين يا ساحرة الفجر؟

331
00:21:43,720 --> 00:21:51,330
لا أنوي سماع أنّ ساحرةً قد غرست
أنيابها بفراخي الغالية

332
00:21:52,210 --> 00:21:53,310
أنياب؟

333
00:21:53,930 --> 00:21:57,910
أنتِ تعانين استنزافاً في الطاقة السحريّة

334
00:21:57,910 --> 00:22:00,420
واستنزافاً حاداً

335
00:22:01,440 --> 00:22:02,920
لاحظتِ إذاً

336
00:22:03,420 --> 00:22:08,680
سيب-كن سيكون خلاصاً بحقّ
لساحرةٍ في حالتك

337
00:22:09,500 --> 00:22:11,680
شكوك في محلّها

338
00:22:12,080 --> 00:22:15,680
إذا كنتِ ستبقين، فعليّ الشرح

339
00:22:16,660 --> 00:22:19,140
وُلِد الشاب بتلك الخاصيّة الغريبة

340
00:22:19,690 --> 00:22:22,190
،وكما تخشين حصوله الآن

341
00:22:22,720 --> 00:22:25,820
فقد هُوجِم من قِبل ساحرةٍ تسعى للقوّة

342
00:22:27,360 --> 00:22:30,240
قُتلت أمّه أمام ناظريه

343
00:22:30,240 --> 00:22:33,280
وهلكت الساحرة التي سعت للقوّة

344
00:22:33,280 --> 00:22:35,580
بسبب الضغط السحريّ المُفرط

345
00:22:35,910 --> 00:22:39,830
نتيجةً لذلك، قام بختم ذكرياته

346
00:22:40,530 --> 00:22:44,530
بلا ذكريات، مرّ بأنواع القمع

347
00:22:44,530 --> 00:22:46,870
أشبه بعبد

348
00:22:48,800 --> 00:22:51,600
،بوضع نفسه في بيئةٍ بائسة

349
00:22:51,600 --> 00:22:53,500
كان يعاقب نفسه

350
00:22:55,720 --> 00:22:58,910
الجرح العاطفيّ الذي تلقّاه
كان عميقاً جدّاً

351
00:22:59,840 --> 00:23:05,360
لذا رأيتُ أنّ من الأفضل منحه خيط حياة
جديد كتلميذ في الأكاديميّة

352
00:23:05,360 --> 00:23:07,990
بلا ذكريات لما حصل

353
00:23:09,510 --> 00:23:12,870
لكنّ شكّلت خاصيّته الفريدة خطراً

354
00:23:12,870 --> 00:23:16,680
بثوران سحره وخروجه عن السيطرة أحياناً

355
00:23:17,440 --> 00:23:19,580
لذا سعيتِ لفصله

356
00:23:19,580 --> 00:23:23,420
تأخذين، تعطين، ثمّ تأخذين مجدّداً، يا للتعالي

357
00:23:24,630 --> 00:23:28,460
لمَ تنوين التحكّم بحياته لهذا الحدّ؟

358
00:23:29,750 --> 00:23:31,380
إنّه ابن أخي

359
00:23:31,750 --> 00:23:35,490
...ابن أخيك؟ أي أنّ أب سيب-كن هو

360
00:23:37,380 --> 00:23:38,890
ثلاثة عشر

361
00:23:39,760 --> 00:23:43,390
صحيح، من سرق كتاب تعاويذ زيرو منّي

362
00:23:43,390 --> 00:23:46,010
لصنع عالمٍ تحكمه الساحرات

363
00:23:46,010 --> 00:23:49,900
من أشعل حرباً في مملكة
وينياس عبر نشر السحر

364
00:23:51,000 --> 00:23:53,070
ذاك المشعوذ الشرّير الاستثنائيّ

365
00:23:55,740 --> 00:23:58,580
بدأ البرنامج الميدانيّ أخيراً

366
00:23:58,850 --> 00:24:01,120
،يندب التلامذة قلّة خبرتهم

367
00:24:01,120 --> 00:24:03,960
ويصارعون لتجاوز الحوائط
التي ارتطموا بها

368
00:24:03,960 --> 00:24:04,920
:الحلقة القادمة

369
00:24:04,920 --> 00:24:06,260
"معرفة الجهل"

370
00:24:06,260 --> 00:24:09,300
أصبح العرض التقديميّ جاداً فجأةً