1
00:00:02,000 --> 00:00:05,500
لو كان هناك عقلٌ مدبّر
واحد وراء كلّ هذا

2
00:00:05,500 --> 00:00:07,940
وقتله سيحلّ كلّ شيء

3
00:00:08,510 --> 00:00:10,570
فكنتُ لأذهب لقتله فوراً

4
00:00:14,180 --> 00:00:15,950
كنّا عاجزين

5
00:00:16,620 --> 00:00:20,450
،كنّا ساحرين، ومعنا حكمٌ حتّى

6
00:00:21,090 --> 00:00:22,820
لكنّنا لم نستطع إنقاذه

7
00:00:23,710 --> 00:00:25,760
كان عليّ مرافقتكم

8
00:00:26,580 --> 00:00:29,960
لن يتسنّى لنا العمل معاً للأبد

9
00:00:30,800 --> 00:00:36,240
إذا ضمنتُ وهورت توفيرك الدائ\م
للسحر لنا، فسنكون عديمي الجدوى

10
00:00:37,720 --> 00:00:39,510
ألستُ محقّاً يا هورت؟

11
00:00:43,450 --> 00:00:46,100
عليك ألّا تشعر بالسوء
حيال ذلك يا سيب-كن

12
00:00:55,490 --> 00:00:57,130
تنّين

13
00:00:57,130 --> 00:00:58,470
!إنّه الملك قاهر التنانين

14
00:01:09,130 --> 00:01:10,090
الملك قاهر التنانين

15
00:01:11,020 --> 00:01:12,510
أنتم الثلاثة

16
00:01:13,500 --> 00:01:15,590
لديكم أوامرٌ بالعودة لوينياس

17
00:01:16,200 --> 00:01:17,510
ستكون هذه القرية قريباً

18
00:01:17,930 --> 00:01:19,390
ساحة معركة

19
00:02:51,770 --> 00:02:54,190
ما قصدكم بأوامر للعودة؟

20
00:02:54,190 --> 00:02:55,940
ماذا عن رغبتنا نحن؟

21
00:02:55,940 --> 00:02:58,440
وما موضوع التحوّل لساحة معركة؟

22
00:02:58,440 --> 00:03:00,120
كما سمعتم

23
00:03:00,120 --> 00:03:03,820
لا يمكننا ترك التلامذة يخاطرون
بحياتهم على ساحة المعركة

24
00:03:03,820 --> 00:03:07,480
لا تختاري البدء بالتصرّف
!كمعلّمة عاديّة الآن

25
00:03:07,480 --> 00:03:10,630
إن كانت ستقع هناك معركة، فتحتاجون
!لكلّ مساعدة ممكنة

26
00:03:10,630 --> 00:03:11,750
!إنّه محقّ

27
00:03:12,060 --> 00:03:13,630
تلقّيتم تعليماتاً

28
00:03:13,630 --> 00:03:15,500
التزموا بها وإلّا ستُفصلون

29
00:03:16,410 --> 00:03:18,160
سأنسحب إذاً

30
00:03:18,160 --> 00:03:19,300
!سيب-كن؟

31
00:03:19,660 --> 00:03:22,720
،لكن إن أثبتُّ فائدتي في المعركة

32
00:03:22,720 --> 00:03:25,720
فلتعاودوا ضمّي مقابل إنجازاتي رجاءً

33
00:03:25,720 --> 00:03:27,670
لا تكن سخيفاً

34
00:03:27,670 --> 00:03:29,180
هذه مسرحيّة

35
00:03:29,560 --> 00:03:32,690
هذه الحربّ بحدّ ذاتها مسرحيّة

36
00:03:33,140 --> 00:03:38,400
قالت لوس-سينسي أنّه عند تلقّي
السحرة لللكمات، فلا يمكنهم ردّها

37
00:03:39,940 --> 00:03:43,490
في تلك الحالة، هذه الحرب معركة دفاعيّة بحتة

38
00:03:43,490 --> 00:03:44,450
و؟

39
00:03:45,020 --> 00:03:48,740
قالت لوس-سينسي أنّ الساحرات
ينصبن الأفخاخ عند قتالهنّ

40
00:03:48,740 --> 00:03:51,780
مما يعني أنّ علينا نصب
أفخاخاً لن تقتل الناس

41
00:03:52,240 --> 00:03:55,460
إذا نصبنا مئة فخّ يعطّل
،كلّ منها 10 أشخاص

42
00:03:55,460 --> 00:03:57,590
فيمكننا تحويل قوّةٍ من ألف فرد إلى صفر

43
00:03:57,590 --> 00:04:00,040
وكيف ستصنع تلك الأفخاخ؟

44
00:04:00,040 --> 00:04:03,300
تعطيل المرء أصعب بكثير من قتله

45
00:04:03,880 --> 00:04:05,510
بجرعات سحريّة

46
00:04:06,250 --> 00:04:07,790
صنعتها؟

47
00:04:07,790 --> 00:04:10,020
جرعة توفّر السحر؟

48
00:04:10,400 --> 00:04:12,400
،لم تكتمل بعد

49
00:04:12,400 --> 00:04:15,940
لكن يمكنني إتمامها مع هورت وكودو

50
00:04:16,700 --> 00:04:19,610
،وإذا قمنا باستشارة الطاغية

51
00:04:19,610 --> 00:04:23,010
فيمكننا تقليص عدد الضحايا جرّاء السحر

52
00:04:24,720 --> 00:04:28,770
إذا تمكّنت من ذلك، فسأهديك
التخرّج بدل فصلك

53
00:04:32,080 --> 00:04:34,690
لا بأس بفكرة امتحان التخرّج

54
00:04:34,690 --> 00:04:38,590
!أنا أهوى دوماً المساعي الابتكاريّة

55
00:04:39,070 --> 00:04:42,340
يا ساحرة الفجر، هذه مسألةٌ تخصّ الأكاديميّة

56
00:04:42,340 --> 00:04:46,040
!إذا أعدتم التلامذة، فسأغادر أيضاً

57
00:04:46,040 --> 00:04:51,330
بالنسبة لي، اختفاء هذه القرية لن يأذيني
أكثر من عضّة كلب ضالّ

58
00:04:51,330 --> 00:04:53,190
يبدو ذلك مؤلماً

59
00:04:54,310 --> 00:04:55,890
!صحيح

60
00:04:55,890 --> 00:04:58,770
!أصبحتُ أحبّ هذه القرية

61
00:04:58,770 --> 00:05:01,920
!دعيني أحميها! دعيني أقاتل

62
00:05:01,920 --> 00:05:06,130
!أرجوك

63
00:05:03,890 --> 00:05:06,610
حسناً، لا تثيري جلبةً يا ساحرة الفجر

64
00:05:06,950 --> 00:05:10,050
سأجرّب الكلام مع الساحرة مُستدعية القمر

65
00:05:11,330 --> 00:05:12,950
!مرحى

66
00:05:12,950 --> 00:05:14,960
!قلبي يرقص

67
00:05:15,260 --> 00:05:19,080
سأرمي المُقاتلين المتعطّشين
للدماء أولئك في مسرحيّة

68
00:05:19,610 --> 00:05:26,100
وأجعلهم محطّ سخريةٍ تُتداول
!على مدار القرن أمام الجميع

69
00:05:32,430 --> 00:05:35,180
!جميل، يبدو ذلك رائعاً

70
00:05:36,520 --> 00:05:39,060
!هيّا، لدينا عرضٌ كبير لتقديمه يا هولدم

71
00:05:39,060 --> 00:05:42,110
لا يغيّر ذلك شيئاً بالتحديد

72
00:05:42,110 --> 00:05:46,820
كنتِ تنوين خوض الحرب بحيث
لا يموت أحدٌ منذ البداية

73
00:05:46,820 --> 00:05:49,330
إذاً؟ أيّ نكهةٍ تحمل؟

74
00:05:49,870 --> 00:05:52,460
فكّر من منظور الجمهور

75
00:05:52,460 --> 00:05:54,450
،بدل تجاهله بصمت

76
00:05:54,450 --> 00:05:58,760
من المسلّي أكثر مضايقة
الجيش الزاحف وطرده

77
00:05:58,760 --> 00:06:01,090
ستكون نهكةً مُبهرجة إذاً

78
00:06:01,090 --> 00:06:02,720
أترك توزيع الأدوار لك

79
00:06:03,300 --> 00:06:05,500
عليّ تجهيز جمهورٍ للعرض

80
00:06:10,840 --> 00:06:12,960
أليس شعوراً غريباً؟

81
00:06:14,350 --> 00:06:18,940
من كان ليتصوّر مواجهة حاكمين سابقين
لمؤمني الكنيسة في معركة

82
00:06:19,780 --> 00:06:23,400
لم أكن أحد مؤمني الكنيسة بالأصل

83
00:06:23,400 --> 00:06:25,530
بل محض محكومٍ عليه بالإعدام

84
00:06:26,490 --> 00:06:28,900
سمعتُ أنّك حميتَ الأطفال

85
00:06:29,150 --> 00:06:29,910
أجل

86
00:06:30,370 --> 00:06:33,740
أعطتني لو كريستاس تقريراً

87
00:06:34,580 --> 00:06:37,240
قالت أنّك أكثر تعاطفاً مما ظنّتْ

88
00:06:39,480 --> 00:06:42,500
حميتُ مالكي كأداة لا أكثر

89
00:06:42,860 --> 00:06:46,460
فهمت، تدّعي عدم اتّباعك لإرادتك الخاصّة

90
00:06:47,100 --> 00:06:51,000
وماذا لو أراد المالك
السابق استرجاع الإداة؟

91
00:06:52,290 --> 00:06:55,430
سيحطّمها المالك الحاليّ غالباً

92
00:06:56,140 --> 00:06:58,590
أنا أشعر بالقلق

93
00:06:58,590 --> 00:07:03,560
من تحطّم الأداة مباشرةً وإصابتها للمالك

94
00:07:03,560 --> 00:07:08,320
حسناً، يقرّر المالك بنفسه مقدار
الثقة التي يضعها في أداته

95
00:07:09,010 --> 00:07:11,200
وكيف يفعل المالك ذلك؟

96
00:07:11,200 --> 00:07:13,960
الطريقة الوحيدة هي تجربة
استعمال الأداة، أليس كذلك؟

97
00:07:13,960 --> 00:07:15,640
في بيئة آمنة؟

98
00:07:16,200 --> 00:07:18,200
كنتُ لأفعل ذلك

99
00:07:18,850 --> 00:07:19,940
أين تذهب؟

100
00:07:19,940 --> 00:07:21,810
استدعتني المعلّمة

101
00:07:21,810 --> 00:07:25,350
فهمت، يبدو أنّك أصبحت مقرّباً منها

102
00:07:25,350 --> 00:07:28,300
لن يضرّك إعطائي إطراءً

103
00:07:28,300 --> 00:07:32,140
بالفعل، إنّه أمرٌ بهيج

104
00:07:32,140 --> 00:07:33,620
فليحفظك الربّ

105
00:07:38,580 --> 00:07:39,600
!مُذهل

106
00:07:39,600 --> 00:07:41,640
!تسترجع هذه السحر حقّاً

107
00:07:41,640 --> 00:07:43,120
!مُذهل يا سيب-كن

108
00:07:43,120 --> 00:07:44,770
!هذا ما كنت تصنعه إذاً

109
00:07:46,700 --> 00:07:49,280
لم تكن مبتعداً عنّا فحسب

110
00:07:51,530 --> 00:07:53,280
كيف صنعتها؟

111
00:07:53,280 --> 00:07:58,560
كان هناك كتابٌ ألّفه والدي
في مكتبة زيرو-سينسي

112
00:07:58,560 --> 00:07:59,660
استعملتُه

113
00:07:59,660 --> 00:08:00,780
ماذا؟

114
00:08:00,780 --> 00:08:03,670
!كـ-كان أبوك مـ-مشعوذاً؟

115
00:08:04,420 --> 00:08:06,960
سأخبركما لأنّي أريدكما أن تعرفا

116
00:08:07,600 --> 00:08:09,090
أبي

117
00:08:09,810 --> 00:08:11,170
هو ثلاثة عشر

118
00:08:12,330 --> 00:08:17,800
ثلاثة عشر؟ إنّه... الشخص السيّئ
الذي تسبّب بالحرب، أليس كذلك؟

119
00:08:17,800 --> 00:08:18,870
أجل

120
00:08:20,210 --> 00:08:24,310
!ما هذا؟! كأنّك مُختارٌ أو ما شابه

121
00:08:24,310 --> 00:08:26,810
!لا عجب أن تتلقّى معاملةً خاصّة

122
00:08:26,810 --> 00:08:29,440
!يا وغد الموهبة عديم الجهد

123
00:08:30,090 --> 00:08:31,210
كلا

124
00:08:31,210 --> 00:08:33,740
أنا أجتهد الآن

125
00:08:33,740 --> 00:08:35,210
بشدّة

126
00:08:36,600 --> 00:08:38,850
ربما أقرب لاجتهادك أخيراً؟

127
00:08:40,480 --> 00:08:43,080
أجل، أجتهد أخيراً

128
00:08:45,920 --> 00:08:50,500
!سيّد طاغية، شكراً لك على إنقاذنا

129
00:08:52,820 --> 00:08:54,740
!فلتأكل

130
00:08:55,130 --> 00:08:57,330
لا تبدو مسروراً

131
00:08:57,330 --> 00:09:00,600
يا إلهي، ربما كان الوقت
باكراً على شيءٍ كهذا

132
00:09:00,600 --> 00:09:04,440
يبدو أنّ السعادة غلبت
السيّد طاغية بحيث يشعر بصدمة

133
00:09:04,960 --> 00:09:08,080
حسناً يا أطفال، يمكنكم أكل الحلويّات الآن

134
00:09:08,080 --> 00:09:09,480
!حسناً

135
00:09:12,500 --> 00:09:16,990
تناقشتُ مع الأطفال عن كيفيّة شكرك

136
00:09:16,990 --> 00:09:18,620
فهمت

137
00:09:19,170 --> 00:09:24,620
أخبرتهم أنّ كادي-كن يتلقّى علاجاً
في بلدةٍ أكبر

138
00:09:24,620 --> 00:09:26,290
فهمت

139
00:09:26,580 --> 00:09:30,540
هل ستتذوّق الحلويات
التي أعدّها الأطفال؟

140
00:09:30,800 --> 00:09:32,220
...لا آكل

141
00:09:41,830 --> 00:09:43,750
تبدو شارد الذهن

142
00:09:44,610 --> 00:09:46,860
هل تودّ الكلام معي في الأمر؟

143
00:09:46,860 --> 00:09:48,470
لا يمكنكِ المساعدة

144
00:09:48,470 --> 00:09:50,540
لا تقل ذلك

145
00:09:50,540 --> 00:09:52,230
ستندمين

146
00:09:52,880 --> 00:09:58,860
أفضّل الإقدام على أمرٍ والندم
بدل عدم الإقدام على شيء ثمّ الندم

147
00:09:59,970 --> 00:10:05,290
ما الذي سيجعلكِ والأطفال
تعانون وتبكون وتصرخون؟

148
00:10:05,290 --> 00:10:07,530
يشغلني الأمر باستمرار

149
00:10:08,990 --> 00:10:11,460
هلّا أخبرتِني يا معلّمة؟

150
00:10:12,120 --> 00:10:13,420
...أتقول

151
00:10:14,000 --> 00:10:16,470
أنّك مُعجبٌ بي؟

152
00:10:18,320 --> 00:10:19,130
...ما

153
00:10:19,130 --> 00:10:20,090
!ماذا؟

154
00:10:20,410 --> 00:10:23,210
لا بأس، لا تخف

155
00:10:23,210 --> 00:10:25,960
الأمر ينطبق على الجميع في القرية

156
00:10:25,960 --> 00:10:31,010
،عندما يحصلون على شيءٍ ثمين
،يتخيّلون لحظة تدمّره

157
00:10:31,490 --> 00:10:33,690
كي يجدون طريقةً لحمايته

158
00:10:34,410 --> 00:10:36,170
لحمايته؟

159
00:10:36,170 --> 00:10:37,150
شكراً لك

160
00:10:37,620 --> 00:10:41,030
أنت تحاول حمايتنا، صحيح؟

161
00:10:56,900 --> 00:10:58,310
...أنت

162
00:10:59,770 --> 00:11:03,800
محض أداةٍ بلا إرادة تخصّك، صحيح؟

163
00:11:04,340 --> 00:11:09,100
أتعرف، أنا لا أطيق
هارثفول-سينسي نوعاً ما

164
00:11:09,540 --> 00:11:12,760
،لا أدري ما الذي أخبركم به القناع

165
00:11:12,760 --> 00:11:14,620
لكنّي سأدخل في صلب الموضوع

166
00:11:20,050 --> 00:11:22,160
يمكنني فعلها

167
00:11:23,000 --> 00:11:27,330
ماذا؟ أتقصد أنّ بإمكانك قتل
حتّى الشخص الذي وقعت في حُبّه

168
00:11:27,330 --> 00:11:29,160
إن أُمرت بذلك؟

169
00:11:29,160 --> 00:11:31,130
هذا ما طُرق بي في تمريني

170
00:11:31,130 --> 00:11:33,860
تعابيرك المنزعجة تخالفك

171
00:11:33,860 --> 00:11:36,630
اختبريني إذاً، إن كانت تساوركِ شكوك

172
00:11:37,620 --> 00:11:40,340
خطر لي أن أضايقك قليلاً فحسب

173
00:11:43,830 --> 00:11:47,270
سيب-كن يعتمد على أفخاخك

174
00:11:47,270 --> 00:11:49,830
لاستعمالها بالدمج مع جرعاته

175
00:11:49,830 --> 00:11:51,570
لكنّ ذلك يعني

176
00:11:51,570 --> 00:11:55,000
أنّ أفخاخك حجر أساس للخطّة، أليس كذلك؟

177
00:11:55,000 --> 00:11:57,260
لا يروقني الأمر البتّة في الواقع

178
00:11:57,770 --> 00:12:00,610
لكنّي لم أستطع المعارضة

179
00:12:01,260 --> 00:12:06,700
حتّى حثالةٌ مثلك يمكنه أن يحمي
الناس عندما تتعرّض حياتهم لخطرٍ مُفاجئ

180
00:12:07,450 --> 00:12:11,080
ذلك عقّد فهم الكثير من الأشياء لي

181
00:12:11,650 --> 00:12:14,250
،إن كنت تملك مشاعراً إنسانيّة

182
00:12:14,250 --> 00:12:17,090
فسيتزايد عدد الأشخاص
المهمّين لك أكثر فأكثر

183
00:12:17,370 --> 00:12:22,800
في تلك الحالة، فستعاني طيلة حياتك
تحت عبء كلّ ما سلبتَه

184
00:12:24,060 --> 00:12:26,490
سيكون ذلك مثيراً للشفقة

185
00:12:29,280 --> 00:12:33,470
،إن كان العيش سيجعلك تعاني
فهنالك قيمةٌ لتركك على قيد الحياة

186
00:12:33,470 --> 00:12:35,840
لذا لن أقتلك

187
00:12:35,840 --> 00:12:38,080
سأحرس ظهرك حتّى

188
00:12:39,970 --> 00:12:40,780
إلى اللقاء

189
00:13:00,810 --> 00:13:04,280
إذاً؟ هل أعطيتِها تلك الفكرة؟

190
00:13:04,280 --> 00:13:07,850
كنتُ متأكّداً أنّكِ
من أعطتها الفكرة

191
00:13:07,850 --> 00:13:12,640
قم بالحفظ اللازم، شكّك بموضوعيّة، ثمّ ثق

192
00:13:13,170 --> 00:13:16,650
لا عجب أنّ بإمكان سيب-كن
وكودو-كن أن يكونا مُرتخيا البال الآن

193
00:13:16,650 --> 00:13:19,690
أجل، إنّهم شديدي المُلاحظة

194
00:13:19,690 --> 00:13:21,980
مثلك، صحيح؟

195
00:13:21,980 --> 00:13:24,530
سيتضايقون إن أخبرتِهم بذلك

196
00:13:25,080 --> 00:13:27,120
كنتُ لأعتبره إطراءً

197
00:13:32,010 --> 00:13:35,070
يبدو أنّه الرجل الملائم
للعمل حقّاً

198
00:13:35,070 --> 00:13:37,670
يجعلكِ ترغبين بمناداته
"يا رئيس"

199
00:13:37,670 --> 00:13:40,730
يا رئيس، لديّ سؤالٌ حيال
هذا الجزء من المخطّط

200
00:13:40,730 --> 00:13:43,010
قمُ بذلك غرباً

201
00:13:43,010 --> 00:13:44,660
ينادونه بذلك سلفاً

202
00:13:45,250 --> 00:13:46,380
،لذا

203
00:13:46,380 --> 00:13:50,080
لمَ لا نوجّه تعويذة فلاغيس
نحو معدّاتهم فحسب؟

204
00:13:50,080 --> 00:13:51,890
ليس تهديداً كافياً

205
00:13:51,890 --> 00:13:55,390
أكثر طريقة فعّالة هي إلحاق
إصابات كبيرة بهم ثمّ علاجهم

206
00:13:55,390 --> 00:13:58,690
لكن ألن يتحوّل ذلك لمجزرة إن فشلنا؟

207
00:14:00,030 --> 00:14:01,270
...ماذا عن

208
00:14:01,270 --> 00:14:03,300
تمهّلوا أيّها التلامذة

209
00:14:03,300 --> 00:14:07,110
...إذا أضفنا طريقةً أخرى للسحر المُدمج

210
00:14:07,110 --> 00:14:09,510
إنّهم مُنغمسون في الأمر حقّاً

211
00:14:09,510 --> 00:14:11,970
ماذا؟ لستَ كذلك؟

212
00:14:11,970 --> 00:14:15,140
لا يسعنا سوى أن نأمل
أنّ خصومنا ضعفاء

213
00:14:15,140 --> 00:14:19,580
،إذا انقلبت الأفضليّة ضدّنا
فلن نمتلك أريحيّة عدم القتل

214
00:14:19,580 --> 00:14:22,160
إنّهم شديدو الضعف

215
00:14:22,540 --> 00:14:26,760
فلّاحون، فقراء، تعداد العاجزون
قرابة 10 آلاف

216
00:14:26,760 --> 00:14:27,940
!عشر آلاف؟

217
00:14:27,940 --> 00:14:29,920
هذا عددٌ كبير

218
00:14:29,920 --> 00:14:33,130
قتل أشخاص كهؤلاء سيجعلنا الأشرار

219
00:14:33,130 --> 00:14:35,330
لا شكّ أنّ ذلك هدفهم

220
00:14:35,330 --> 00:14:36,780
!ها أنت

221
00:14:37,680 --> 00:14:40,690
!أوني-تشان، علينا التحضير للطعام

222
00:14:40,690 --> 00:14:43,460
أجل، بالطبع. أنا قادم

223
00:14:43,460 --> 00:14:47,020
ليلي، سيأخذ الملك قاهر التنانين
أهل القرية الليلة

224
00:14:47,020 --> 00:14:49,690
ويطير بهم إلى كاتدرائية لوترا

225
00:14:49,690 --> 00:14:52,090
ستغادرين القرية معهم

226
00:14:53,350 --> 00:14:54,150
!لا

227
00:14:54,150 --> 00:14:54,870
ماذا؟

228
00:14:54,870 --> 00:14:57,490
أنا قويّة

229
00:14:57,490 --> 00:15:00,500
!سأقاتل معكم وأحميك

230
00:15:00,500 --> 00:15:02,140
ألستُ كذلك؟

231
00:15:02,140 --> 00:15:05,770
صحيح،  أنتِ أقوى منّي

232
00:15:05,770 --> 00:15:07,330
ما هذا؟

233
00:15:07,330 --> 00:15:12,440
هل هذه الفأرة الصغيرة
الظريفة بتلك القوّة؟

234
00:15:12,440 --> 00:15:14,350
!أنتِ مثلي

235
00:15:16,080 --> 00:15:18,910
!أنعم مما تصوّرتُ حتّى

236
00:15:18,910 --> 00:15:20,040
أيّها الكاهن الوغد

237
00:15:20,040 --> 00:15:24,490
أتقدّر كليّاً مخلوقة
رائعة مثلها كلّ يوم؟

238
00:15:24,490 --> 00:15:25,500
يا لك من رجلٍ آثم

239
00:15:25,500 --> 00:15:26,860
لستُ كذلك

240
00:15:26,860 --> 00:15:28,360
أنتِ تضايقينها

241
00:15:28,360 --> 00:15:29,770
ابتعدي عنها

242
00:15:30,360 --> 00:15:34,320
...لستَ كذلك؟ لطالما افترضتُ أنّكما

243
00:15:36,540 --> 00:15:38,080
!أوني-تشان، أيّها الأحمق

244
00:15:38,080 --> 00:15:39,230
!أكرهك

245
00:15:40,080 --> 00:15:41,880
!انتظري

246
00:15:42,460 --> 00:15:43,800
!ارجعي يا ليلي

247
00:15:43,800 --> 00:15:44,890
لا جدوى

248
00:15:44,890 --> 00:15:46,960
ستُخلّد هذه المسرحيّة في التاريخ

249
00:15:47,790 --> 00:15:51,640
سيكون من المُحزن استبعاد
شخصٍ يريد المشاركة

250
00:15:51,640 --> 00:15:55,100
لا تملك رغبةً كتلك

251
00:15:55,100 --> 00:15:56,850
ما الذي تملكه إذاً؟

252
00:15:57,530 --> 00:15:59,730
ألن يكون حبّاً لي؟

253
00:16:00,900 --> 00:16:02,130
ما الخطب؟

254
00:16:02,130 --> 00:16:04,730
!صُدمت بثقتك المُفرطة

255
00:16:04,730 --> 00:16:07,360
لكن هنالك موضوعٌ أكثر أهميّة

256
00:16:08,210 --> 00:16:12,490
جزء بقايا الكارثة الذي شقّ طريقه
أكلاً من معدة كادي-كن

257
00:16:12,490 --> 00:16:14,520
هذا مجرّد نموذج

258
00:16:14,990 --> 00:16:17,120
،لو لم أقضي عليه

259
00:16:17,120 --> 00:16:22,330
لانتشر بحدٍّ لا مُتناهي من القرية
والتهم الناس

260
00:16:22,330 --> 00:16:25,650
مما يؤدي لسؤال

261
00:16:25,650 --> 00:16:27,070
سؤال؟

262
00:16:27,070 --> 00:16:32,530
هل نوى مُتطرّفو الكنيسة إهلاك
أنفسهم مع الساحرات؟

263
00:16:32,970 --> 00:16:38,350
لا أحد ساذجٌ بحيث ينشر وباءً
دون تحضير علاجٍ أوّلاً

264
00:16:38,630 --> 00:16:41,090
وبافتراض أنّ الطبقة العليا من الكنيسة

265
00:16:41,090 --> 00:16:45,600
لا يعرفون كيف يتعاملون مع هذا، حتّى الأساقفة؟

266
00:16:45,600 --> 00:16:50,230
من يعرف كيفيّة إيقافه
هو الشخص الذي نشره إذاً

267
00:16:52,370 --> 00:16:55,670
يطير التنّين إلى كاتدرائية لوترا الليلة، أليس كذلك؟

268
00:16:55,670 --> 00:16:58,590
ربما هنالك مقعدٌ محجوز لي؟

269
00:16:59,820 --> 00:17:01,960
لا ننشر القوّات؟

270
00:17:01,960 --> 00:17:06,500
أتخبر فرسان الكنيسة والسحرة
بتجاهل اضطهاد الساحرات هذا؟

271
00:17:06,500 --> 00:17:08,060
هدّئ من روعك

272
00:17:08,060 --> 00:17:11,470
لن يقاتلوا، لكنّنا سنرسل قوّاتاً

273
00:17:11,470 --> 00:17:13,170
ما قصدك؟

274
00:17:13,170 --> 00:17:18,940
سنهتمّ بأمر من يهربون من قرية الساحرة

275
00:17:20,390 --> 00:17:26,230
سنعالج إصاباتهم ونُطعمهم
وندعهم يستمعون للفرقة الموسيقيّة حتّى

276
00:17:26,620 --> 00:17:32,480
إنّهم حمقى تحفّزهم خطبٌ بسيطة
"تدّعي "الساحرات كلّهن سيّئات

277
00:17:32,840 --> 00:17:35,730
إذا عاملناهم بلطف، فسينضمّون لصفّنا

278
00:17:35,730 --> 00:17:37,280
...لكن عندها

279
00:17:37,280 --> 00:17:41,170
سيتطلّب ذلك عدد جنود أكبر
مقارنةً بمجرّد قضائنا عليهم

280
00:17:41,170 --> 00:17:45,280
أجل، لذا أطلب منك يا قائد الفرسان

281
00:17:46,120 --> 00:17:48,170
كم تستطيع جمعهم؟

282
00:17:48,460 --> 00:17:54,050
ريا، أتى طلبٌ من فرسان الكنيسة والسحرة
بنشر وحدة السحر الطبيّة

283
00:17:54,050 --> 00:17:58,050
يزحف مُتطرّفو الكنيسة نحو
قرية زيرو-سان والمُرتزق

284
00:17:58,050 --> 00:18:00,930
بقوّة تعدادها 10 آلاف

285
00:18:00,930 --> 00:18:02,520
هذه مصيبة

286
00:18:02,520 --> 00:18:04,900
سيموت أولئك العشرة آلاف

287
00:18:05,430 --> 00:18:07,890
أجل، فهم لا يعرفون
كيف يكبحون أنفسهم

288
00:18:08,280 --> 00:18:12,920
هل ستكون الأمور بخير لو تركت
مُسعفاً واحداً هنا ينوبني في غيابي؟

289
00:18:12,920 --> 00:18:15,400
لدينا الكثير من المُسعفين السحريّين الآن

290
00:18:15,780 --> 00:18:18,910
يمكنكِ التنازل عن منصبكِ
كقدّيسة إن أردتِ حتّى

291
00:18:20,780 --> 00:18:22,280
!لا تضايقني هكذا

292
00:18:23,530 --> 00:18:26,410
من فيريا، حاكمة المدينة المقدّسة آكديوس

293
00:18:26,410 --> 00:18:31,060
،رسالة طارئة إلى توريس-ساما
رئيس جمهوريّة كريون

294
00:18:33,130 --> 00:18:34,420
!رائع

295
00:18:34,420 --> 00:18:36,260
!مُغامرةٌ رائعة

296
00:18:36,730 --> 00:18:39,230
لطالما رأيتُ أنّه يجب
أن تُخاض الحروب

297
00:18:39,230 --> 00:18:41,190
عبر لعبةٍ على لوح

298
00:18:41,190 --> 00:18:45,740
...لكن إجراء تلك اللعبة على ساحة المعركة

299
00:18:45,740 --> 00:18:48,480
!مؤلم، أنت تؤلمني يا توريس-سان

300
00:18:48,480 --> 00:18:54,190
بالمناسبة، بخصوص جزء بقايا الكارثة
من تقريركم ذاك اليوم

301
00:18:54,190 --> 00:18:56,610
اكتشفنا من أين أتى

302
00:18:56,610 --> 00:18:57,710
حقّاً؟

303
00:18:57,710 --> 00:18:58,860
أجل

304
00:19:00,110 --> 00:19:03,910
بدأ الأمر بنبيلٍ كان
يهوى قصص المغامرة

305
00:19:03,910 --> 00:19:10,300
عيّن جنوداً، وزحف للشمال ثمّ
فقد نصف قوّاته في مضيّ يوم

306
00:19:10,300 --> 00:19:15,670
عُثر على بذور بقايا كارثة
في الجثث التي تمكّنوا من إعادتها

307
00:19:16,010 --> 00:19:18,850
،أي ذهب النبيل باكياً إلى الكنيسة

308
00:19:18,850 --> 00:19:21,300
التي أخذتها ونقلتها سرّاً إلى المُتطرّفين

309
00:19:21,920 --> 00:19:23,430
...مما يعني

310
00:19:23,430 --> 00:19:27,480
لا يزال هناك احتمالٌ بظهور
عدد كبير من بقايا الكارثة

311
00:19:28,660 --> 00:19:29,720
خذي هذه

312
00:19:31,940 --> 00:19:36,940
جلب النبيل قرابة 500
جثّة من الشمال

313
00:19:36,940 --> 00:19:41,510
،وبافتراض أنّها احتوت جميعاً بقايا كارثة

314
00:19:42,110 --> 00:19:46,120
متى وأين قد يستعملونها؟

315
00:19:46,120 --> 00:19:48,760
ربما استهنّا بهم

316
00:19:48,760 --> 00:19:50,870
!آلبس! لم أعلم أنّكِ هنا

317
00:19:52,170 --> 00:19:55,000
توريس، جلبتُ رسالةً طارئة من ريا

318
00:19:55,410 --> 00:19:56,500
ها هي

319
00:19:58,900 --> 00:20:02,630
هلّا طرت شمالاً الآن
واستدعيت قائد السحرة؟

320
00:20:02,630 --> 00:20:04,010
!شمالاً؟

321
00:20:04,010 --> 00:20:07,430
!اطلبي من الملك قاهر التنانين
!لا أزال أريد العيش

322
00:20:07,430 --> 00:20:09,370
لا تقلق، ستكون بخير

323
00:20:09,370 --> 00:20:13,000
سيحرص القائد على حمايتك

324
00:20:13,640 --> 00:20:15,810
!فلتذهب بأسرع ما يمكنك! الآن

325
00:20:15,810 --> 00:20:17,940
...يا للقسوة

326
00:20:17,940 --> 00:20:21,690
إذاً يا توريس، اجمع الحضور

327
00:20:21,690 --> 00:20:25,240
عليّ العودة للأكاديميّة وإخبار زيرو

328
00:20:26,500 --> 00:20:27,900
!سيب-نيتشان

329
00:20:30,000 --> 00:20:32,210
أولس-سان، لايوس

330
00:20:32,710 --> 00:20:37,960
سأغادر القرية غداً، رغم أنّي
أريد البقاء والقتال في الواقع

331
00:20:37,960 --> 00:20:40,310
...لكن بما أنّي لا أزال طفلاً

332
00:20:40,860 --> 00:20:42,090
صحيح

333
00:20:42,600 --> 00:20:46,180
!لكنّي سأكبر وأرجع بأسرع ما يمكن

334
00:20:47,320 --> 00:20:51,490
سأنتظرك، متى رجعت بالغاً

335
00:20:51,490 --> 00:20:55,220
أجل، فلتصمدوا حتّى عودتي

336
00:20:56,260 --> 00:21:00,180
نتيجة الحرب تحدّدها
التحضيرات على الأغلب

337
00:21:00,180 --> 00:21:05,150
كم جمعت من القوّات، ومدى صلابة
الحصون التي بنيتها

338
00:21:05,500 --> 00:21:08,870
قام الطرف الآخر بتحضيرات لقتلنا

339
00:21:07,350 --> 00:21:08,870
!جاهز

340
00:21:09,530 --> 00:21:14,040
لكنّنا كنّا نحضّر لعدم قتلهم

341
00:21:14,460 --> 00:21:17,920
إن فشلنا، فسنقتل ناساً

342
00:21:20,690 --> 00:21:23,420
زيرو-سينسي، هل لي؟

343
00:21:27,430 --> 00:21:29,530
أيّها الشاب، ما الذي تفعله؟

344
00:21:30,090 --> 00:21:32,090
هذه أكثر خطوة منطقيّة

345
00:21:32,090 --> 00:21:33,680
لديكِ التزامٌ

346
00:21:33,680 --> 00:21:38,230
بفعل كلّ ما يسعكِ لحماية
مستقبلنا ومستقبل السحرة

347
00:21:38,930 --> 00:21:42,780
...ولذلك، حتّى لو انهار مستقبلي الفرديّ

348
00:21:42,780 --> 00:21:44,050
!سيب-كن

349
00:21:50,960 --> 00:21:55,990
كم من الطاقة السحريّة تعطيني
أمرٌ بيدك أيّها الشاب

350
00:21:56,410 --> 00:21:58,580
سأقبل ما تقرّره

351
00:21:59,690 --> 00:22:01,190
سأقدّم كلّ شيء

352
00:22:14,890 --> 00:22:16,850
...مستحيل! إلى أيّ حدٍّ يمكنك

353
00:22:25,850 --> 00:22:27,110
زيرو-سينسي؟

354
00:22:27,970 --> 00:22:30,110
أتشعر... بخير؟

355
00:22:30,460 --> 00:22:32,650
أشعر بخفّةٍ أكثر الآن

356
00:22:33,360 --> 00:22:36,620
هذا شعور امتلاك سحرٍ أقلّ إذاً؟

357
00:22:37,500 --> 00:22:39,060
...استهنتُ بك

358
00:22:41,180 --> 00:22:44,880
ستحفر اسمك كمشعوذٍ يوماً ما

359
00:22:45,340 --> 00:22:47,680
،كما أُعرف بأنّي ساحرة الوحل السوداء

360
00:22:47,680 --> 00:22:49,880
...وكما تُعرف آلبس بمُستدعية القمر

361
00:22:50,690 --> 00:22:52,370
مشعوذ الهاوية

362
00:22:52,840 --> 00:22:57,640
،عندما يسأل أحدهم يوماً ما عن اسمك بنهاية المطاف

363
00:22:57,640 --> 00:22:59,740
سأخبره بذاك اللقب

364
00:23:00,400 --> 00:23:02,570
...عذراً... أنا

365
00:23:06,130 --> 00:23:08,150
!لا حاجة للتوتّر

366
00:23:08,150 --> 00:23:12,000
ذلك بعدما حقّقت إنجازاً
عظيماً بحيث يسأل الناس عنك

367
00:23:12,000 --> 00:23:13,010
صحيح

368
00:23:13,010 --> 00:23:15,700
،وإذا أخفقتم في هذه الحرب

369
00:23:15,700 --> 00:23:17,940
ستُفصلون الثلاثة معاً

370
00:23:17,940 --> 00:23:19,710
!ماذا؟

371
00:23:27,840 --> 00:23:29,770
شيطانٌ مُتلبّس؟

372
00:23:30,460 --> 00:23:33,470
يبدو أنّهم ليسوا محض رعاعٍ كما ظننّا

373
00:23:37,740 --> 00:23:40,550
فلتشهدي يا صديقتي

374
00:23:41,990 --> 00:23:45,840
ستقدّرين هذه المسرحيّة أيضاً بالتأكيد

375
00:23:48,980 --> 00:23:50,420
،لودينس-تشان

376
00:23:52,750 --> 00:23:54,400
!ألقِ التحيّة

377
00:23:55,520 --> 00:24:00,000
ما المطلوب لهزيمة عدوّ
دون قتله برأيكم؟

378
00:24:00,000 --> 00:24:02,540
إنّها الأفضليّة المُهيمنة

379
00:24:03,040 --> 00:24:05,790
الحلقة القادمة: بداية المغامرة

380
00:24:05,790 --> 00:24:06,880
!حسنٌ

381
00:24:06,880 --> 00:24:09,650
ستمكّونني من نطق تلك الكلمة، صحيح؟