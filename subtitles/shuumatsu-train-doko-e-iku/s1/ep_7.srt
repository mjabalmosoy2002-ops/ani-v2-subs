1
00:00:01,940 --> 00:00:04,200
!مـ-مهلاً لحظة

2
00:00:04,820 --> 00:00:06,830
إلى أين تأخذونني؟

3
00:00:06,830 --> 00:00:07,950
.هناك

4
00:00:08,830 --> 00:00:13,400
كلّ هؤلاء الزّومبي، كم جثّة... بل
قطعة... بل شخصًا يوجد منهم؟

5
00:00:13,400 --> 00:00:15,830
.لا أدري. لم أعدّهم أبدًا

6
00:00:15,830 --> 00:00:17,430
كانوا بشرًا من قبل، صحيح؟

7
00:00:17,430 --> 00:00:20,200
وتحوّلوا إلى زومبي بعد 7 جي؟

8
00:00:20,200 --> 00:00:20,950
.لا أدري

9
00:00:20,950 --> 00:00:22,660
!لا تدرين"؟"

10
00:00:22,660 --> 00:00:23,950
ما الّذي سيفعلونه بي؟

11
00:00:23,950 --> 00:00:25,010
...سيأكلونك

12
00:00:25,010 --> 00:00:25,750
!ماذا؟

13
00:00:25,750 --> 00:00:27,780
.على ما أظنّ؟ إنّهم زومبي في النّهاية

14
00:00:27,780 --> 00:00:28,900
!ما هذا؟

15
00:00:28,900 --> 00:00:30,550
!رأيتك تأكلين طعامًا معلّبًا

16
00:00:30,550 --> 00:00:31,750
!لا يبدو ذلك صائبًا لي

17
00:00:31,750 --> 00:00:34,600
.لا أستطيع توفير الطّعام لكلّ زومبي هنا

18
00:00:34,600 --> 00:00:36,310
!أنت الملكة، صحيح؟

19
00:00:36,310 --> 00:00:38,240
!أبق رعيّتك تحت السّيطرة على الأقلّ

20
00:00:38,240 --> 00:00:41,650
!كما أنّ ملابسي الدّاخليّة ستُكشف للجميع هنا

21
00:00:40,310 --> 00:00:41,140
...ملابس داخليّة

22
00:00:43,060 --> 00:00:46,560
.سأفكّ وثاقك إن وعدتني ألاّ تهربي

23
00:00:46,830 --> 00:00:47,840
.لن أهرب

24
00:00:47,840 --> 00:00:48,990
أتقسمين؟

25
00:00:48,990 --> 00:00:50,050
!أقسم

26
00:00:50,780 --> 00:00:52,210
.فكّوا وثاقها

27
00:00:52,210 --> 00:00:53,690
.سنجعلها تسير

28
00:02:27,390 --> 00:02:28,370
.يبدو جيّدًا

29
00:02:28,370 --> 00:02:30,920
.سنتمكّن من رؤيته من مكان بعيد

30
00:02:31,210 --> 00:02:33,470
!احرصا أن تبقيا قريبتين

31
00:02:33,470 --> 00:02:35,410
!وإلاّ انتهى بكما الأمر بالموت

32
00:02:35,410 --> 00:02:38,350
هذا صحيح، فأكيرا تخرج
.عن الطّريق بسهولة عادة

33
00:02:38,350 --> 00:02:39,540
!كنتُ أتحدّث عنك

34
00:02:39,540 --> 00:02:42,440
.نعم، نعم. هيّا بنا لننطلق

35
00:02:45,170 --> 00:02:47,650
مهلاً، كيف نعثر على شيزورو-تشان؟

36
00:02:47,650 --> 00:02:50,070
وماذا إن كان الزّومبي قد نالوا منها سالفًا؟

37
00:02:50,070 --> 00:02:51,750
.يخرج الزّومبي ليلاً

38
00:02:51,750 --> 00:02:52,800
.هكذا إذًا

39
00:02:52,800 --> 00:02:54,440
.إنّ نظرهم ضعيف

40
00:02:54,440 --> 00:02:56,040
.أظنّ أنّ ذلك منطقيّ

41
00:02:56,040 --> 00:02:57,650
.يحبّ الزّومبي الأدمغة

42
00:02:57,650 --> 00:02:58,560
ماذا؟

43
00:02:58,560 --> 00:02:59,700
...لهذا السّبب

44
00:03:00,030 --> 00:03:02,360
...خذا هذا، وقوما بهذا

45
00:03:02,740 --> 00:03:04,200
.فيصير لديكما دماغ مزيّف

46
00:03:04,200 --> 00:03:05,610
ماذا؟

47
00:03:05,610 --> 00:03:07,740
.لا يستطيع الزّومبي مقاومة الأدمغة

48
00:03:07,740 --> 00:03:09,510
.إن رأوا دماغًا، فسيقتربون منه

49
00:03:09,510 --> 00:03:12,900
،لذلك إن حدث أيّ شيء
.ارميا الدّماغ لتوفير الوقت

50
00:03:22,790 --> 00:03:25,960
!لم يوفّر لنا ذلك أيّ وقت
!بل جذبهم إلينا

51
00:03:25,960 --> 00:03:27,390
!لا تقوما بأيّ حركات مفاجئة

52
00:03:27,390 --> 00:03:27,750
!ماذا؟

53
00:03:27,750 --> 00:03:30,650
لن يستطيع الزّومبي تمييزنا
.إن تظاهرنا أنّنا منهم

54
00:03:30,650 --> 00:03:31,970
.يتحرّك الزّومبي ببطء

55
00:03:32,360 --> 00:03:34,930
.والزّومبي... لا يصرخون

56
00:03:47,580 --> 00:03:50,250
.إنّهم يشكّون بنا
!إنّهم يشكّون بنا بالتّأكيد

57
00:03:50,250 --> 00:03:51,870
.سأشتّت انتباههم

58
00:03:54,790 --> 00:03:55,680
!ذلك قريب جدًّا

59
00:03:55,680 --> 00:03:56,950
!اخرسي

60
00:03:59,760 --> 00:04:02,540
.أكيرا-تشان، ريمي-تشان. هذه فرصتنا

61
00:04:13,250 --> 00:04:14,650
.الصّبر. الصّبر فحسب

62
00:04:14,650 --> 00:04:17,260
أعلم، ولكن هل سينفع هذا؟

63
00:04:17,260 --> 00:04:18,820
.لا يهاجم الزّومبي بعضهم

64
00:04:18,820 --> 00:04:21,740
...ولكن هل سيخدعهم الطّلاء فحسب

65
00:04:25,110 --> 00:04:25,960
!نجح الأمر

66
00:04:28,260 --> 00:04:29,710
.لنبتعد ببطء

67
00:04:29,710 --> 00:04:30,700
.ذلك يناسبني

68
00:04:37,600 --> 00:04:39,130
أتلك حقيبة شيزورو-تشان؟

69
00:04:43,420 --> 00:04:45,590
.صارت شيزورو-تشان زومبي بالكامل الآن

70
00:04:45,590 --> 00:04:47,970
.لسنا واثقات من ذلك بالكامل

71
00:04:47,970 --> 00:04:52,270
ماذا إن عجزت شيزورو-تشان عن
التّفكير بأيّ شيء سوى أكل الأدمغة؟

72
00:04:52,270 --> 00:04:53,950
وتنسى كلّ شيء عن يوكا-تشان؟

73
00:04:53,950 --> 00:04:56,800
.لا. ذلك لن يحدث
.سيكون الأمر على ما يرام

74
00:05:06,870 --> 00:05:08,490
مِحفَّة؟

75
00:05:08,490 --> 00:05:09,600
.مهلاً، أنا أراها

76
00:05:09,600 --> 00:05:11,370
.شيزورو-تشان هناك. وبوتشي-سان أيضًا

77
00:05:11,370 --> 00:05:12,540
أترين أيّ لون أزرق؟

78
00:05:12,840 --> 00:05:13,800
.بنّيّ

79
00:05:13,800 --> 00:05:14,630
بنّيّ؟

80
00:05:14,630 --> 00:05:16,070
إذًا فقد بدأ التّعفّن؟

81
00:05:16,070 --> 00:05:17,440
.لا، بل إنّه ناعم كالعادة

82
00:05:17,440 --> 00:05:17,960
ماذا؟

83
00:05:17,960 --> 00:05:19,120
بوتشي-سان؟

84
00:05:19,120 --> 00:05:21,610
!لا، بل البشريّة! شيزورو-تشان

85
00:05:21,610 --> 00:05:24,310
.يبدو وجهها عاديًّا بالنّسبة لي

86
00:05:24,310 --> 00:05:25,290
.ذلك ما يبدو لي

87
00:05:25,290 --> 00:05:27,930
إذًا فلم تصر زومبي بعد؟

88
00:05:27,930 --> 00:05:30,670
لماذا تبدو مطيعة لذلك الحدّ؟

89
00:05:30,670 --> 00:05:32,920
.كنتُ أتوقّع أنّها قد تبدأ في إحداث المشاكل

90
00:05:32,920 --> 00:05:34,280
.كانت لتفعل ذلك بالفعل

91
00:05:34,530 --> 00:05:36,670
.تبدو متفاجئة

92
00:05:36,670 --> 00:05:38,340
.لقد وقعت على مؤخّرتها

93
00:05:38,340 --> 00:05:39,950
.يمكنني رؤية ذلك من هنا

94
00:05:39,950 --> 00:05:41,120
هل تقول شيئًا ما؟

95
00:05:41,120 --> 00:05:41,970
—يا شيز

96
00:05:42,970 --> 00:05:44,980
!نتظاهر أنّنا زومبي! زومبي

97
00:05:45,660 --> 00:05:47,300
ماذا؟ هل تعاني من حكّة؟

98
00:05:47,300 --> 00:05:48,580
هل بدأت تتحوّل؟

99
00:05:48,580 --> 00:05:49,360
.لا

100
00:05:49,360 --> 00:05:52,120
.أعتقد أنّها تسأل إن كنّا زومبي أو ما زلنا بشرًا

101
00:05:52,120 --> 00:05:53,950
.ذلك بسبب الطّلاء على وجوهنا

102
00:05:53,950 --> 00:05:56,840
ناديكو-تشان، تبدين الأسوأ بيننا
.بذلك اللّون اللاّزورديّ

103
00:05:56,840 --> 00:05:57,890
...لازورديّ

104
00:05:57,890 --> 00:05:59,880
.يبدو ذلك مثل زومبي أيضًا

105
00:05:59,880 --> 00:06:01,120
أتفضّلين "الأزرق السّماويّ"؟

106
00:06:01,120 --> 00:06:01,880
ماذا؟

107
00:06:01,880 --> 00:06:03,160
ألا يمكنكنّ تحريك عيونكنّ؟

108
00:06:03,160 --> 00:06:04,300
هل ستسقط أذرعكنّ؟

109
00:06:04,300 --> 00:06:05,340
أتحتجن لأدمغة؟

110
00:06:05,340 --> 00:06:07,520
!لا! لا

111
00:06:07,520 --> 00:06:08,190
ما الخطب؟

112
00:06:10,560 --> 00:06:12,460
ما قصّة أولئك الثّلاثة؟

113
00:06:15,000 --> 00:06:15,800
!أنتم

114
00:06:16,280 --> 00:06:19,580
أهنّ صديقاتك السّابقات البشريّات السّابقات؟

115
00:06:19,580 --> 00:06:20,340
!سابقات"؟"

116
00:06:20,340 --> 00:06:21,320
!صديقات"؟"

117
00:06:20,340 --> 00:06:21,320
!بشريّات"؟"

118
00:06:21,320 --> 00:06:23,470
أم هنّ صديقاتك السّابقات البشريّات؟

119
00:06:26,210 --> 00:06:27,440
...ربّما

120
00:06:27,440 --> 00:06:29,780
صديقات بشريّات سابقات؟

121
00:06:29,780 --> 00:06:31,270
صديقات بشريّات؟

122
00:06:31,270 --> 00:06:33,070
هل تحتاجين لهذه التّفاصيل بالفعل؟

123
00:06:33,070 --> 00:06:34,980
!كلّ هذه الأمور عن كونهنّ سابقات أم لا

124
00:06:34,980 --> 00:06:35,920
!نعم، أحتاجها

125
00:06:35,920 --> 00:06:37,900
.لن أتسامح مع أيّ تمرّد

126
00:06:37,900 --> 00:06:41,930
ما زال بإمكانكنّ الكلام، ما يعني
،أنّكنّ بدأتنّ بالتّحوّل حديثًا فقط

127
00:06:41,930 --> 00:06:43,900
.أو أنّكنّ تتظاهرن فحسب

128
00:06:44,730 --> 00:06:46,120
لا جواب؟

129
00:06:47,160 --> 00:06:48,170
.لا بأس

130
00:06:48,170 --> 00:06:51,460
.سنعرف من أجسادكنّ إن كنتنّ زومبي أم لا

131
00:06:51,460 --> 00:06:52,570
!أجسادنا؟

132
00:06:52,570 --> 00:06:53,020
.أنتم

133
00:06:53,260 --> 00:06:54,730
.أحضروا ذلك الشّيء

134
00:06:54,730 --> 00:06:56,300
العذراء الحديدّية؟

135
00:06:56,300 --> 00:06:57,380
الثّور البرونزيّ؟

136
00:06:57,730 --> 00:06:59,300
مهد يهوذا؟

137
00:07:02,080 --> 00:07:03,300
!أودون؟

138
00:07:03,300 --> 00:07:04,810
.هذا ليس أودون عاديّ

139
00:07:05,080 --> 00:07:06,500
.إنّه اختصاص موساشينو

140
00:07:06,500 --> 00:07:10,630
معكرونة سميكة مطهوّة في الميسو
.مع الخضر الموسميّة ولحم الخنزير

141
00:07:10,630 --> 00:07:12,680
.أودون شهيّ على الأسلوب الرّيفيّ

142
00:07:13,210 --> 00:07:15,320
...مع رشّة فلفل شيتشيمي

143
00:07:20,520 --> 00:07:24,590
،ثمّ سأمضغ المعكرونة اللّيّنة وأشرب المرق

144
00:07:25,210 --> 00:07:26,840
...مع أخذ قضمات من لحم الخنزير

145
00:07:26,840 --> 00:07:28,500
تأكلين وحدك ثانية؟

146
00:07:28,870 --> 00:07:31,370
.أنا مميّزة لأنّي الملكة

147
00:07:31,370 --> 00:07:34,240
.لا يملك الزّومبي أيّ شهيّة في العادة

148
00:07:35,620 --> 00:07:38,500
.لم تظهرن أيّ ردّة فعل للأودون المطبوخ

149
00:07:38,500 --> 00:07:40,130
.يبدو أنّكنّ زومبي بالفعل

150
00:07:40,130 --> 00:07:42,280
.نعم، نعم. نحن زومبي، زومبي

151
00:07:42,280 --> 00:07:44,390
.أتينا بسلام الزّومبي

152
00:07:44,390 --> 00:07:46,850
.ما زلت لا أستطيع الجزم بالكامل

153
00:08:03,530 --> 00:08:05,310
!متّ ثانية

154
00:08:05,310 --> 00:08:06,830
.أنت فظيعة

155
00:08:08,340 --> 00:08:12,760
ومع ذلك، أنا الملكة، لذا لا أحتاج السّماح
.لأيّ شخص آخر بالحصول على دور

156
00:08:12,760 --> 00:08:13,710
.لا

157
00:08:13,710 --> 00:08:15,490
...يمكن أعادة تلقيم السّلاح في لمح البصر

158
00:08:15,490 --> 00:08:16,440
ماذا قلت؟

159
00:08:17,120 --> 00:08:18,470
...كم هذا محبط

160
00:08:18,470 --> 00:08:19,650
محبط؟

161
00:08:19,650 --> 00:08:21,410
.لا يشعر الزّومبي بالغضب

162
00:08:21,410 --> 00:08:22,890
.وبالتّالي، لا يشعرون بالإحباط

163
00:08:22,890 --> 00:08:24,430
.وأنا لستُ محبطة

164
00:08:24,430 --> 00:08:25,550
فعلاً؟

165
00:08:25,550 --> 00:08:26,780
أتريدين أن تجرّبي؟

166
00:08:26,780 --> 00:08:28,810
!لا أريد

167
00:08:28,810 --> 00:08:30,140
.لا يمارس الزّومبي ألعاب الفيديو

168
00:08:30,490 --> 00:08:33,050
ماذا إن كان أمرًا من الملكة؟

169
00:08:33,630 --> 00:08:34,720
!...أيّها الـ

170
00:08:34,720 --> 00:08:36,320
!سُحقًا لهذا

171
00:08:36,330 --> 00:08:37,920
!خذا هذا

172
00:08:37,920 --> 00:08:39,090
!إصابة في الرّأس

173
00:08:39,090 --> 00:08:42,160
تصير ناديكو-تشان شخصًا مختلفًا
.تمامًا عندما تلعب ألعاب الفيديو

174
00:08:42,160 --> 00:08:44,270
.وعندما تحمل قوسًا أيضًا

175
00:08:44,270 --> 00:08:46,470
لن يكون لها أيّ رادع
.إن كان لديها قوس في اللّعبة

176
00:08:46,470 --> 00:08:49,090
!متُ، اللّعنة عليك

177
00:08:49,090 --> 00:08:50,010
!أجل

178
00:08:50,010 --> 00:08:51,290
!زومبي أغبياء

179
00:08:51,290 --> 00:08:53,130
.أنت بارعة في هذا

180
00:08:55,840 --> 00:08:57,750
.كلّ ذلك بفضلك

181
00:08:57,750 --> 00:09:00,550
.ردّات فعلك سريعة بالنّسبة لزومبي

182
00:09:02,020 --> 00:09:03,420
...ذلك لأنّها

183
00:09:03,420 --> 00:09:06,910
،ما زالت تملك ردّات فعلها
.بما أنّها تحوّلت إلى زومبي حديثًا

184
00:09:06,910 --> 00:09:07,430
صحيح؟

185
00:09:07,430 --> 00:09:08,400
!نعم، نعم

186
00:09:12,310 --> 00:09:13,650
.الزّومبي لا يضحكون

187
00:09:14,990 --> 00:09:18,000
.الزّومبي الّذي يضحك ليس زومبي من الأساس

188
00:09:18,000 --> 00:09:19,500
...ما يعني

189
00:09:19,500 --> 00:09:20,590
ما يعني؟

190
00:09:21,330 --> 00:09:22,580
.أنت بشريّة

191
00:09:24,130 --> 00:09:25,510
!اربطوهنّ

192
00:09:25,880 --> 00:09:27,050
!توقّفوا

193
00:09:27,360 --> 00:09:30,170
،إن كنت إلى جانبهنّ
!فذلك يجعلك عدوّة أيضًا

194
00:09:30,170 --> 00:09:31,900
!سآكل أدمغتكم جميعًا

195
00:09:31,900 --> 00:09:32,760
!حاولي ذلك

196
00:09:40,480 --> 00:09:42,460
!خذ هذا

197
00:09:46,230 --> 00:09:47,260
!شيزورو-تشان

198
00:09:47,260 --> 00:09:48,340
.هذا مذهل

199
00:09:49,530 --> 00:09:50,770
.خُلع رأسه

200
00:09:50,770 --> 00:09:52,250
هل هم ضعفاء لهذا الحدّ؟

201
00:09:52,250 --> 00:09:53,350
.ربّما بإمكاننا الفوز

202
00:09:55,440 --> 00:09:57,160
!هذا مذهل يا أكيرا-تشان

203
00:09:57,160 --> 00:10:00,190
،إنّها تخاف من الأشباح
.لكنّها لا تمانع الزّومبي بتاتًا

204
00:10:00,650 --> 00:10:02,190
!خذ هذه

205
00:10:08,930 --> 00:10:09,860
!يمكننا أن ننجح

206
00:10:17,020 --> 00:10:18,270
!كيف؟

207
00:10:21,690 --> 00:10:22,670
!لقد عادوا كما كانوا

208
00:10:23,090 --> 00:10:24,340
ما الّذي يحدث؟

209
00:10:24,340 --> 00:10:25,480
!لا نهاية لهؤلاء الزّومبي

210
00:10:25,480 --> 00:10:27,030
.لا يموت الزّومبي

211
00:10:27,030 --> 00:10:27,830
!ليس عدلاً

212
00:10:27,830 --> 00:10:29,520
.هكذا تعمل أنظمتهم الجسديّة

213
00:10:29,520 --> 00:10:30,820
.لا شيء غير عادل في ذلك

214
00:10:30,820 --> 00:10:33,680
...أنظمة؟ تنشيط

215
00:10:33,680 --> 00:10:37,280
.تلقّينا بلاغات من شهود عيان عن هجرة زومبي

216
00:10:37,280 --> 00:10:39,090
هجرة زومبي؟

217
00:10:39,090 --> 00:10:41,310
.قد يكونون مزعجين للغاية

218
00:10:41,310 --> 00:10:43,500
،لا يهمّ كم قد تهزمن منهم
.فسيعودون في كلّ مرّة

219
00:10:43,500 --> 00:10:44,720
.إنّهم ضعفاء ولكن لا يموتون

220
00:10:44,720 --> 00:10:46,540
كيف يفترض بنا التّعامل معهم؟

221
00:10:48,310 --> 00:10:51,830
لم أتأكّد من الأمر بعد، لكن يبدو
.أنّ الزّومبي ضعفاء أمام أيّ تنشيط

222
00:10:51,830 --> 00:10:52,510
تنشيط؟

223
00:10:52,510 --> 00:10:55,240
من الكائنات الحيّة؟

224
00:10:55,240 --> 00:10:56,620
.لكنّهم يهاجمون البشر

225
00:10:56,620 --> 00:10:59,570
.حسنًا، لا يجب عليكنّ أخذ الأمر بجدّيّة كبيرة

226
00:10:59,570 --> 00:11:00,120
.نعم

227
00:11:00,120 --> 00:11:03,330
هل تتحدّث عن تنشيط جنسيّ أو شهوانيّ؟

228
00:11:03,330 --> 00:11:04,370
!أكيرا-تشان

229
00:11:04,370 --> 00:11:06,550
هذا مقرف، هل تقصدين أنّ الزّومبي منحرفين؟

230
00:11:06,550 --> 00:11:09,550
.لا، لا يمكنهم تحمّل ذلك
.إنّها أشبه بنقطة ضعفهم

231
00:11:09,550 --> 00:11:12,750
.الزّومبي هم تجسيد للموت

232
00:11:12,750 --> 00:11:14,020
.مثل ثاناتوس

233
00:11:14,020 --> 00:11:15,900
.يين. دمار. إبادة

234
00:11:15,900 --> 00:11:17,260
...وفي المقابل له

235
00:11:17,260 --> 00:11:17,900
.يوجد إيروس

236
00:11:18,720 --> 00:11:20,830
.عقليّة تقدّر الشّهوانيّة

237
00:11:18,720 --> 00:11:21,740
.تثرثر أكيرا-تشان بشأن أمور غريبة ثانية

238
00:11:20,830 --> 00:11:25,950
.شوق للجمال والطّيبة وكلّ الأشياء الحيّة

239
00:11:21,740 --> 00:11:22,940
!صه

240
00:11:24,470 --> 00:11:27,080
.ما عدت أدري ما الّذي تتحدّث عنه

241
00:11:27,080 --> 00:11:28,530
هل ما زلنا نتحدّث عن الزّومبي؟

242
00:11:28,530 --> 00:11:29,850
.كنّ حذرات

243
00:11:29,850 --> 00:11:32,110
،من الأفضل أن تتفادين الزّومبي من الأساس

244
00:11:32,110 --> 00:11:34,670
،ولكن إن اقتربوا منكنّ
.فالقاعدة الأساسيّة هي عدم التّحرّك

245
00:11:34,980 --> 00:11:39,130
.ما ذكرته كان مجرّد نظريّة زومبي واحدة ممكنة

246
00:11:39,660 --> 00:11:44,170
!الشّهوة

247
00:11:42,540 --> 00:11:43,630
—ناد

248
00:11:44,170 --> 00:11:45,640
!كلاّ! أسأت فهم الأمر

249
00:11:45,640 --> 00:11:47,630
!بل تقصد إيروس إله الشّهوة

250
00:11:47,630 --> 00:11:48,770
!الشّهوة؟

251
00:11:48,770 --> 00:11:49,390
!كلاّ

252
00:11:49,390 --> 00:11:51,510
!لنوضّح الأمر يا شيزورو-تشان

253
00:11:51,510 --> 00:11:53,190
أتقصدين ما ذكره نيكو-ني-سان؟

254
00:11:53,190 --> 00:11:54,400
!نعم، ذلك

255
00:11:54,400 --> 00:11:55,570
!رجاءً يا أكيرا-تشان

256
00:11:55,570 --> 00:11:56,770
!قولي شيئًا شهوانيًّا

257
00:11:57,030 --> 00:11:57,990
!ماذا؟

258
00:11:57,990 --> 00:12:00,080
!أيّ شيء كان! بسرعة

259
00:12:00,080 --> 00:12:02,340
...شيء شهوانيّ، شيء شهوانيّ

260
00:12:02,340 --> 00:12:04,570
!أجل، تلك الرّواية الإنجليزيّة

261
00:12:05,990 --> 00:12:14,150
وضع ميلورز يده برغبة خالصة يتحسّس"
".انحدارات ظهرها النّاعم حتّى خصرها

262
00:12:14,570 --> 00:12:20,290
ارتحلت أصابعه للأسفل مقتربة"
".أكثر فأكثر من أشهى أجزائها

263
00:12:20,290 --> 00:12:24,470
،كانت مقاومة كوني قد اختفت"
".تركتها بدون أيّ خزي

264
00:12:24,470 --> 00:12:29,270
وفتحت فخدها الجميلتين"
".وصارت مستعدّة لاستقباله

265
00:12:29,770 --> 00:12:35,220
".شعرت برجولته ترتقي أمامها بإصرار شديد"

266
00:12:35,510 --> 00:12:36,460
...يا للانحراف

267
00:12:36,460 --> 00:12:37,880
...مهلاً يا أكيرا

268
00:12:39,610 --> 00:12:41,840
!لا تتصرّفي بقرف يا ناديكو-تشان

269
00:12:46,390 --> 00:12:48,160
هل يضحك؟

270
00:12:48,160 --> 00:12:50,370
.ظننتُ أنّ الزّومبي لا يضحكون

271
00:12:51,410 --> 00:12:52,540
!لقد انفجر

272
00:12:55,010 --> 00:12:57,140
!أنت مذهلة يا أكيرا

273
00:12:57,140 --> 00:13:00,580
!كيف يعرفن نقطة ضعف الزّومبي؟

274
00:13:11,210 --> 00:13:12,840
!المزيد من الأشياء المنحرفة

275
00:13:12,840 --> 00:13:14,040
ماذا عن الأشياء المنفّرة؟

276
00:13:14,040 --> 00:13:14,730
!كلاّ

277
00:13:14,730 --> 00:13:15,850
!لم يظلّ عندي أيّ شيء

278
00:13:15,850 --> 00:13:17,300
!فكّري في شيء ما

279
00:13:17,300 --> 00:13:17,890
!مستحيل

280
00:13:17,890 --> 00:13:19,280
!فكّري أنت في شيء ما

281
00:13:19,280 --> 00:13:21,300
...شيء منحرف، شيء منحرف

282
00:13:21,300 --> 00:13:24,150
...لـ... لـ... لهـ

283
00:13:24,150 --> 00:13:25,930
!لهاث

284
00:13:25,930 --> 00:13:27,680
!ذلك منحرف نوعًا ما

285
00:13:27,680 --> 00:13:28,800
...مـ

286
00:13:28,800 --> 00:13:30,730
!مداعبات

287
00:13:31,250 --> 00:13:33,030
ماذا؟ مداعبات؟

288
00:13:33,030 --> 00:13:34,910
...ز... ز

289
00:13:34,910 --> 00:13:35,590
!زحف

290
00:13:37,990 --> 00:13:40,890
!ناديكو-تشان، الزّحف لا يبدو منحرفًا

291
00:13:52,500 --> 00:13:54,820
!أحسّ بألم في كامل جسدي

292
00:13:54,820 --> 00:13:57,000
!"سيبدو ذلك منحرفًا إن قلتِ "أتحسّس

293
00:13:57,000 --> 00:13:59,220
.أعتقد أنّ ذلك قد يبدو منحرفًا للبعض

294
00:13:59,220 --> 00:14:00,800
...تـ... تـ

295
00:14:00,800 --> 00:14:02,510
تلوّي. هل يبدو ذلك منحرفًا؟

296
00:14:02,510 --> 00:14:03,880
.لستُ واثقة

297
00:14:03,880 --> 00:14:05,500
.على حسب الوضع

298
00:14:05,500 --> 00:14:06,180
...جـ

299
00:14:07,260 --> 00:14:09,020
.جدال، جدال. صراخ، صراخ

300
00:14:09,370 --> 00:14:10,230
ماذا؟

301
00:14:10,960 --> 00:14:12,490
.كآبة، كآبة

302
00:14:12,490 --> 00:14:13,620
.تماطل، تماطل

303
00:14:13,620 --> 00:14:14,880
.سيّئ، سيّئ

304
00:14:14,880 --> 00:14:16,010
.قلق، قلق

305
00:14:16,890 --> 00:14:19,740
.تـ-توسّل، توسّل

306
00:14:21,910 --> 00:14:25,480
.احتفظي بذلك ليوكا-تشان يا شيزورو-تشان

307
00:14:35,830 --> 00:14:37,680
.قطارنا هنا

308
00:14:37,680 --> 00:14:38,930
.أغانو هناك

309
00:14:38,930 --> 00:14:40,170
.إيكبوكورو في هذه الجهة

310
00:14:40,170 --> 00:14:41,900
.والزّومبي موجودون في هذه المنطقة

311
00:14:41,900 --> 00:14:42,850
ماذا؟

312
00:14:42,850 --> 00:14:44,520
هل نسير وسط الزّومبي؟

313
00:14:44,520 --> 00:14:45,540
بالقطار؟

314
00:14:45,540 --> 00:14:47,540
ونقوم بسحقهم وتقطيعهم؟

315
00:14:47,540 --> 00:14:49,430
.أنا حقًّا... لا أودّ ذلك

316
00:14:49,430 --> 00:14:51,040
.صحيح. السّاعة الخامسة وشيكة

317
00:14:51,040 --> 00:14:52,490
.حان الوقت للحديث مع زنجيرو-سان

318
00:14:52,760 --> 00:14:55,190
!قد يستطيع زنجيرو-سان تعليمنا شيئًا منحرفًا

319
00:14:55,190 --> 00:14:57,040
ماذا؟ يمكنك تعليمنا أغنية؟

320
00:14:57,040 --> 00:14:58,050
!أجل

321
00:14:58,050 --> 00:14:58,830
!ناديكو-تشان

322
00:14:58,830 --> 00:15:00,210
.سأملي عليك ما يقول، فاكتبيه

323
00:15:00,210 --> 00:15:00,990
.مفهوم

324
00:15:02,170 --> 00:15:03,970
!اسمحن لي أن أغنّي لكنّ أغنية

325
00:15:19,300 --> 00:15:20,730
.لن تفلتن منّي

326
00:15:21,250 --> 00:15:22,870
!نالوا منهنّ أيّها الزّومبي

327
00:15:22,870 --> 00:15:24,100
!أمسكوا بالبشريّات

328
00:15:29,000 --> 00:15:30,830
!كلاّ، انظرن لهذا

329
00:15:30,830 --> 00:15:32,490
ماذا إن لم ينفع الأمر؟

330
00:15:32,490 --> 00:15:34,120
.لن نعلم ما لم نجرّب

331
00:15:40,490 --> 00:15:43,510
!اللّيلة مهرجان مضاجعة متعرّق

332
00:15:43,510 --> 00:15:48,500
،وتلك المرأة الّتي تنتظر في المنزل
!حمّسها وجرّدها وابسطها وجهّزها

333
00:15:48,500 --> 00:15:51,080
!هيّا! ابدأ بالدّلك والدّفع ثمّ واصل وواصل

334
00:15:51,080 --> 00:15:56,470
!هكذا وكذا، واصل وواصل، هكذا وكذا

335
00:15:53,620 --> 00:15:54,090
!ثانية

336
00:16:03,790 --> 00:16:04,730
!أمعقول؟

337
00:16:05,090 --> 00:16:06,480
!نجح الأمر، نجح الأمر

338
00:16:06,480 --> 00:16:08,100
!زنجيرو-سان مذهل

339
00:16:08,100 --> 00:16:10,600
أعتقد أنّ هذه أوّل مرّة يكون
!فيها مفيدًا بالفعل

340
00:16:14,880 --> 00:16:16,210
.إنّهم لا يقتربون

341
00:16:16,210 --> 00:16:17,840
!ما الّذي يحدث؟

342
00:16:17,840 --> 00:16:21,860
إنّ التّحرّك كقطيع ليس
.من صفات الزّومبي من الأساس

343
00:16:21,860 --> 00:16:23,120
ماذا؟ فعلاً؟

344
00:16:23,120 --> 00:16:27,850
،هذا يعني أنّ هنالك تسلسلاً هرميًّا
.يضمّ قائدًا وأتباعًا

345
00:16:27,850 --> 00:16:30,770
.لم أكن أعلم حتّى أنّ للزّومبي تسلسلاً هرميًّا

346
00:16:30,770 --> 00:16:31,970
.هذا صحيح

347
00:16:31,970 --> 00:16:34,170
.إنّهم يأخذون الأوامر من ملكة الزّومبي

348
00:16:34,940 --> 00:16:36,230
!مهلاً يا شيزورو-تشان

349
00:16:36,230 --> 00:16:37,150
إلى أين تذهبين؟

350
00:16:37,150 --> 00:16:38,540
.للحديث مع الملكة

351
00:16:38,540 --> 00:16:39,280
!ماذا؟

352
00:16:40,880 --> 00:16:41,910
للحديث معها؟

353
00:16:41,910 --> 00:16:43,300
!لا يمكنك ذلك

354
00:16:43,300 --> 00:16:46,000
تظنّين أنّ بإمكانك حلّ الأمر بالحديث مع زومبي؟

355
00:16:46,000 --> 00:16:48,980
.على الأرجح أنّ الملكة ليست زومبي

356
00:16:48,980 --> 00:16:49,600
ماذا؟

357
00:16:49,880 --> 00:16:52,430
كانت الوحيدة الّتي تأكل طعامًا حقيقيًّا، صحيح؟

358
00:16:52,430 --> 00:16:53,460
.مثل الأودون

359
00:16:53,460 --> 00:16:55,120
.مع أنّها لم تقدّم لنا أيّ شيء منه

360
00:16:55,900 --> 00:16:58,240
لكن أليس ذلك لأنّها الملكة؟

361
00:16:58,240 --> 00:17:00,250
.ذلك هو عُذرها. على ما أظنّ

362
00:17:00,830 --> 00:17:03,780
.ستكون في ورطة إن عرفوا أنّها بشريّة

363
00:17:03,780 --> 00:17:05,130
.أظنّ ذلك

364
00:17:05,130 --> 00:17:07,240
.بعد أن تظاهرت أنّها ملكتهم

365
00:17:07,240 --> 00:17:09,000
ستستعملين ذلك لتهديدها؟

366
00:17:09,000 --> 00:17:11,740
ولكن ماذا إن كانت زومبي حقيقيّة؟

367
00:17:12,410 --> 00:17:15,420
.إن كانت زومبي حقيقيّة، فسأقاتلها

368
00:17:15,420 --> 00:17:18,310
.حتّى الملكة ما كانت لتنجو إن سُحقت لأشلاء

369
00:17:18,310 --> 00:17:19,420
سُحقت لأشلاء؟

370
00:17:19,420 --> 00:17:21,440
!لا يجب العبث مع جوجتسو أغانو

371
00:17:21,440 --> 00:17:22,640
.سأذهب أيضًا

372
00:17:22,640 --> 00:17:24,920
،لديك جوجتسو أغانو

373
00:17:24,920 --> 00:17:28,600
وأنا لديّ رماية أغانو والسّاعات
!"الّتي قضيتها ألعب "منزل الأموات

374
00:17:33,760 --> 00:17:35,990
!مهلاً! أريد الحديث معك

375
00:17:35,990 --> 00:17:36,660
ماذا؟

376
00:17:40,410 --> 00:17:41,020
!توقّفوا

377
00:17:47,650 --> 00:17:48,690
لماذا؟

378
00:17:49,330 --> 00:17:50,430
لماذا ماذا؟

379
00:17:50,780 --> 00:17:52,410
لأنّهم سيأكلونك إن اكتشفوا الأمر؟

380
00:17:58,850 --> 00:17:59,980
ماذا؟

381
00:17:59,980 --> 00:18:01,140
ماذا حدث؟

382
00:18:01,670 --> 00:18:03,580
أين ذهب الجميع؟

383
00:18:17,020 --> 00:18:17,980
ماذا؟

384
00:18:17,980 --> 00:18:19,150
ما الّذي يحدث؟

385
00:18:20,730 --> 00:18:23,080
!كلاّ! بإمكانهم رؤية ملابسي الدّاخليّة

386
00:18:24,790 --> 00:18:27,540
أهذا بسبب الملابس الدّاخليّة؟

387
00:18:28,400 --> 00:18:30,540
صرت ملكتهم منذ ذلك الوقت؟

388
00:18:32,050 --> 00:18:33,760
تتظاهرين أنّك زومبي؟

389
00:18:33,760 --> 00:18:35,250
!ريمي-تشان

390
00:18:35,250 --> 00:18:37,810
.لم أرد أن أتظاهر، لكن لم يكن لديّ خيار آخر

391
00:18:38,130 --> 00:18:40,350
ما المحطّة الأقرب إلى منزلك؟

392
00:18:40,350 --> 00:18:41,400
.هويا

393
00:18:41,400 --> 00:18:43,410
ألم تفكّري في العودة؟

394
00:18:43,410 --> 00:18:45,770
...فكّرت، ولكن

395
00:18:45,770 --> 00:18:48,160
لم تريدي أن تخاطري أن يعرف الزّومبي بذلك؟

396
00:18:48,160 --> 00:18:51,350
...ذلك صحيح، لكن

397
00:18:55,910 --> 00:18:57,240
!لا تتحرّكوا

398
00:19:04,020 --> 00:19:05,290
!عليّ العودة

399
00:19:39,100 --> 00:19:40,810
كنتم بانتظاري؟

400
00:19:49,580 --> 00:19:51,780
!أحسنتم بنجاتكم من العفن يا أتباعي

401
00:19:51,780 --> 00:19:54,000
!الملكة تأمركم

402
00:20:00,710 --> 00:20:02,200
...فهمت

403
00:20:02,200 --> 00:20:04,120
!السّيّدة وخدمها. كم هذا لطيف

404
00:20:04,120 --> 00:20:07,350
.إذًا فقد أخذت الزّومبي معك للتّجوال معًا

405
00:20:07,350 --> 00:20:11,490
.لو لم أفعل، لكبر عليهم العفن وتلاشوا

406
00:20:11,490 --> 00:20:12,390
.هكذا إذًا

407
00:20:12,390 --> 00:20:14,520
.أعتقد أنّك ملكة لطيفة جدًّا

408
00:20:14,520 --> 00:20:16,180
.لم يكن لديّ خيار آخر

409
00:20:16,180 --> 00:20:17,410
.كلاّ

410
00:20:17,410 --> 00:20:18,690
.كنتِ ملكة جيّدة لهم

411
00:20:19,910 --> 00:20:21,030
.شكرًا لك

412
00:20:21,030 --> 00:20:23,310
.نحن في طريقنا إلى إيكبوكورو

413
00:20:23,310 --> 00:20:24,710
ماذا عنك يا كوروكين؟

414
00:20:24,710 --> 00:20:26,260
متى صرت ودودة معها هكذا؟

415
00:20:26,260 --> 00:20:27,750
!لا بأس! نحن صديقات

416
00:20:28,040 --> 00:20:29,290
...صديقات

417
00:20:29,290 --> 00:20:32,220
أتريدين المجيء معنا إلى إيكبوكورو
يا كوروكين-تشان؟

418
00:20:32,220 --> 00:20:35,670
...الذّهاب إلى إيكبوكورو... مع صديقات

419
00:20:37,520 --> 00:20:38,760
..معًا

420
00:20:41,900 --> 00:20:44,620
.لا يمكنني ذلك. أنا الملكة

421
00:20:44,620 --> 00:20:45,660
...ولكن

422
00:20:45,660 --> 00:20:47,250
.آسفة على تأخير رحلتكنّ

423
00:20:48,410 --> 00:20:52,480
لم أرَ أيّ بشر منذ وقت طويل
.لدرجة أنّي أردت الحديث فحسب

424
00:20:52,480 --> 00:20:57,260
،لكن إن كنتنّ تردن الذّهاب لمكان ما
.فلن أوقفكنّ

425
00:20:58,240 --> 00:21:01,280
.سأخبر الزّومبي ألاّ يهاجموا البشر

426
00:21:01,280 --> 00:21:06,040
،سيخافك النّاس ويكرهونك
.وقد تتعرّضين للهجوم أيضًا

427
00:21:06,040 --> 00:21:07,250
.أنا معتادة على ذلك

428
00:21:07,250 --> 00:21:07,980
ماذا؟

429
00:21:07,980 --> 00:21:11,490
،لكنّي مختلفة عمّا كنت عليه

430
00:21:11,490 --> 00:21:13,370
.ولديّ الآن هؤلاء الزّومبي معي

431
00:21:13,370 --> 00:21:15,690
.لا داعي لتقلقن عليّ

432
00:21:15,690 --> 00:21:16,840
.مفهوم

433
00:21:19,830 --> 00:21:21,330
.كنّ حذرات في رحلتكنّ

434
00:21:21,330 --> 00:21:24,180
.سمعت أنّ إيكبوكورو لديها ملكة خاصّة بها

435
00:21:24,180 --> 00:21:25,250
!إلى اللّقاء

436
00:21:25,250 --> 00:21:26,650
!سنمرّ عليك في طريق عودتنا

437
00:21:26,650 --> 00:21:27,910
!انتبهي لملابسك الدّاخليّة

438
00:21:27,910 --> 00:21:31,140
!يمكنك إعادة تلقيم السّلاح بحركة بسيطة بيدك

439
00:21:31,140 --> 00:21:33,250
!حظًّا سعيدًا في هزيمة الفصل الأوّل

440
00:21:31,990 --> 00:21:33,970
!احذرن من الملكة بالتّحديد

441
00:21:38,060 --> 00:21:41,230
هل تعتقدن أنّ كوروكين تعرّضت للتّنمّر كطفلة؟

442
00:21:41,230 --> 00:21:42,940
!ماذا؟ ذلك لا يهمّ

443
00:21:42,940 --> 00:21:44,140
.بل يهمّ

444
00:21:44,140 --> 00:21:44,830
ماذا؟

445
00:21:44,830 --> 00:21:47,450
،إنّ الماضي مرتبط بما نحن عليه الآن

446
00:21:47,450 --> 00:21:49,240
.إضافة إلى من سنكون في المستقبل

447
00:21:49,240 --> 00:21:51,290
.سواء كان جيّدًا أم سيّئًا

448
00:21:51,290 --> 00:21:53,480
.في الغنى أو الفقر

449
00:21:53,480 --> 00:21:54,200
.لا تخلطي الأمور

450
00:21:54,200 --> 00:21:55,610
لِمَ لا؟

451
00:21:55,610 --> 00:21:56,830
.كلّ من هبّ ودبّ إذًا

452
00:21:56,100 --> 00:21:57,480
.شيزورو-تشان

453
00:21:56,830 --> 00:21:57,600
.ابتعدتِ كثيرًا

454
00:21:57,600 --> 00:21:58,160
!ماذا؟

455
00:21:58,160 --> 00:21:59,840
لا حلق لمن لا أذن له؟

456
00:21:59,840 --> 00:22:00,970
!ابتعدت كلّ البعد

457
00:22:00,970 --> 00:22:02,230
الباطن خير من الظّاهر؟

458
00:22:02,230 --> 00:22:03,470
!لستِ قريبة حتّى

459
00:22:04,380 --> 00:22:05,830
صار الصّيّاد الفريسة؟

460
00:22:05,830 --> 00:22:06,540
!كلاّ