1
00:00:12,310 --> 00:00:13,450
!يوكا-تشان

2
00:00:13,450 --> 00:00:14,130
ماذا؟

3
00:00:14,130 --> 00:00:14,870
!هناك

4
00:00:14,870 --> 00:00:17,130
!يوكا-تشان على ذلك القطار

5
00:00:17,770 --> 00:00:18,870
!شيزورو-تشان

6
00:00:18,870 --> 00:00:20,630
!إنّه يأخذ يوكا-تشان بعيدًا

7
00:00:36,970 --> 00:00:41,300
يبدو أنّ بونتارو يريد إبقاء
.يوكا-تشان قريبة منه بأي وسيلة

8
00:00:41,300 --> 00:00:43,260
هل هي المفتاح لـ7 جي؟

9
00:00:43,260 --> 00:00:44,920
...هكذا إذًا! لذلك السّبب

10
00:00:44,920 --> 00:00:46,280
!علينا استعادة يوكا

11
00:00:48,730 --> 00:00:51,570
،لا بأس إن كانت قد ذهبت معه طواعية

12
00:00:51,570 --> 00:00:53,890
،لكن إن أخذها رغمًا عنها
!فذلك ليس مقبولاً أبدًا

13
00:00:54,330 --> 00:00:55,120
.نعم

14
00:01:00,210 --> 00:01:01,570
!لا تدعوهم يهربون

15
00:01:01,570 --> 00:01:03,910
!سنتحوّل جميعًا لكاسترد بيض إن هربوا

16
00:01:04,950 --> 00:01:06,810
.إنّها ماكوتو-سينسي

17
00:01:06,810 --> 00:01:07,460
!مرحبًا

18
00:01:07,460 --> 00:01:09,210
هرب بونتارو؟

19
00:01:10,400 --> 00:01:11,370
!ماذا عن الزّرّ؟

20
00:01:11,370 --> 00:01:15,180
،كان مخبّئًا في مكان مشبوه
.لكن لم يحدث شيء بعد ضغطه

21
00:01:15,180 --> 00:01:17,180
!كلاّ! خذنه معكنّ إن كنتنّ ستذهبن خلفه

22
00:01:17,180 --> 00:01:19,780
!يوكا-تشان أكثر أهمّيّة الآن

23
00:01:19,780 --> 00:01:21,610
.سيكون من المزعج أن نعود من أجله

24
00:01:20,780 --> 00:01:22,790
ما هو هدفكنّ هنا؟

25
00:01:22,790 --> 00:01:24,470
استعادة يوكا-تشان؟

26
00:01:24,470 --> 00:01:24,990
!نعم

27
00:01:24,990 --> 00:01:27,160
وتحويل العالم إلى ما كان عليه؟

28
00:01:27,160 --> 00:01:28,810
.أظنّ أنّ ذلك جزء من الهدف أيضًا

29
00:01:28,810 --> 00:01:31,750
.إنّ بونتارو ليس بالذّكاء الّذي يعتقده

30
00:01:31,750 --> 00:01:33,240
.أفعاله بسيطة

31
00:01:33,240 --> 00:01:34,830
.لقد أخفى الزّرّ لأنّه مهمّ

32
00:01:34,830 --> 00:01:35,420
.نقطة إلى السّطر

33
00:01:35,420 --> 00:01:40,050
إضافة لذلك، اُجبر على الهرب
.بدون ذلك الزّرّ المهمّ للغاية

34
00:01:41,720 --> 00:01:43,910
...كلاّ، لماذا

35
00:01:43,910 --> 00:01:44,700
!أيّتها الأميرة

36
00:01:44,700 --> 00:01:45,740
!أيّتها الأميرة، أيّتها الأميرة

37
00:01:45,740 --> 00:01:47,410
!لا داعي للقلق

38
00:01:47,410 --> 00:01:48,990
.أنت في أمان معي

39
00:01:49,360 --> 00:01:51,570
أقلق؟ ممّاذا؟

40
00:01:53,220 --> 00:01:55,090
!من أولئك الشّقيّات

41
00:01:55,090 --> 00:01:56,070
...شقيّات

42
00:01:56,070 --> 00:01:56,940
!نعم، نعم

43
00:01:56,940 --> 00:01:59,490
!إنّهنّ يشكّلن تهديدًا لأمانك

44
00:01:59,490 --> 00:02:01,100
.ولكن اطمئنّي

45
00:02:01,100 --> 00:02:04,600
!سيبذل بونتارو هذا قصارى جهده بكلّ إخلاص

46
00:02:04,600 --> 00:02:07,340
!والآن، سأذهب لتقييم الوضع

47
00:02:07,340 --> 00:02:10,370
لذلك يمكنك أن تستمرّي بشكل
!عاديّ أيّتها الأميرة

48
00:02:10,860 --> 00:02:12,720
...بشكل عاديّ

49
00:02:12,720 --> 00:02:14,560
ما هو العاديّ؟

50
00:02:14,990 --> 00:02:18,680
...النّوم والاستيقاظ والأكل والدّراسة

51
00:02:18,680 --> 00:02:21,610
...ثمّ... كان هنالك أحد

52
00:02:23,600 --> 00:02:25,030
!ما كان ذلك؟

53
00:02:25,480 --> 00:02:26,480
!بوتشي

54
00:02:26,480 --> 00:02:27,990
تعال! أين أنت؟

55
00:02:28,390 --> 00:02:31,100
إذًا فذلك الزّرّ كان مهمًّا أيضًا؟

56
00:02:31,100 --> 00:02:32,020
...مهمًّا

57
00:02:32,020 --> 00:02:34,380
هل هو زرّ من نوع خاصّ؟

58
00:02:34,380 --> 00:02:37,350
...إلى جانب تفعيل 7 جي

59
00:02:37,880 --> 00:02:40,930
ربّما نحن بحاجة للزّرّ ويوكا معًا؟

60
00:02:41,610 --> 00:02:43,150
!فهمت، إنّهما ثنائيّ

61
00:02:43,150 --> 00:02:43,960
ما معنى ذلك؟

62
00:02:43,960 --> 00:02:48,060
ربّما الأمر متعلّق بالسّبب الّذي
.يجعلهم يصفونها بساحرة إيكبوكورو

63
00:02:48,060 --> 00:02:50,680
،بتعبير آخر، ضغطت يوكا-تشان الزّرّ

64
00:02:50,680 --> 00:02:53,110
،ومنح الزّرّ قوى ليوكا-تشان

65
00:02:53,110 --> 00:02:54,640
ثمّ غيّر العالم؟

66
00:02:54,640 --> 00:02:56,010
!كم أنت ذكيّة

67
00:02:56,010 --> 00:02:57,170
.لا بدّ أنّ الأمر كذلك

68
00:02:57,170 --> 00:02:58,080
!هذا صحيح

69
00:02:58,080 --> 00:03:00,380
يجب أن يكون نفس الشّخص
—الّذي ضغط الزّرّ في

70
00:03:02,240 --> 00:03:04,320
،ضغطت ناكاتومي يوكا على الزّرّ

71
00:03:04,320 --> 00:03:06,360
.لذلك عليكنّ جعلها تضغط عليه ثانية

72
00:03:06,360 --> 00:03:10,900
أتوقّع أنّها الطّريقة الوحيدة لإعادة العالم
.وناكاتومي يوكا أيضًا إلى طبيعتهما

73
00:03:18,650 --> 00:03:20,050
.هذا مذهل

74
00:03:34,360 --> 00:03:35,570
!هنالك طريقان

75
00:03:35,570 --> 00:03:37,660
أيّهما علينا أن نسلك؟

76
00:03:37,660 --> 00:03:39,300
...لنرَ، لنرَ

77
00:03:39,300 --> 00:03:40,080
ماذا؟

78
00:03:40,790 --> 00:03:42,530
أتعرف أيّ الطّريقين نسلك يا بوتشي-سان؟

79
00:03:42,530 --> 00:03:43,650
!أحسنت يا بوتشي-سان

80
00:03:50,900 --> 00:03:53,740
.بدأتْ تسيء التّصرّف كثيرًا مؤخّرًا

81
00:03:53,740 --> 00:03:57,460
أحتاج منها أن تكون فتاة
...صغيرة مطيعة وإلاّ

82
00:04:08,910 --> 00:04:09,550
!سُحقًا

83
00:04:09,550 --> 00:04:11,230
!يا لعنادهنّ

84
00:04:11,230 --> 00:04:12,580
!هذا أنا! أين أنتم الآن؟

85
00:04:12,580 --> 00:04:13,530
!تعالوا إلى هنا حالاً

86
00:04:14,240 --> 00:04:15,220
...يوكا

87
00:04:15,220 --> 00:04:16,520
!هذا سيّئ يا شيزورو-تشان

88
00:04:59,620 --> 00:05:05,910
!يوكا

89
00:05:01,120 --> 00:05:03,250
!يوكا-تشان

90
00:05:04,630 --> 00:05:07,430
!لا فائدة! لا يمكنها سماعنا

91
00:05:09,690 --> 00:05:11,350
!يا لهنّ من شقيّات مزعجات

92
00:05:11,350 --> 00:05:14,070
!لن أسمح لكنّ بأخذ الأميرة

93
00:05:20,000 --> 00:05:21,030
مهلاً، ما هذا؟

94
00:05:56,300 --> 00:05:57,320
!اتّخذت قراري

95
00:05:57,320 --> 00:05:57,830
ماذا؟

96
00:05:57,830 --> 00:05:59,170
!سأصعد على متن ذلك القطار

97
00:05:59,170 --> 00:05:59,630
!مستحيل

98
00:05:59,630 --> 00:06:01,450
!لـ-لكن كيف بالضّبط؟

99
00:06:01,450 --> 00:06:02,300
!سآتي معك

100
00:06:02,300 --> 00:06:02,880
ماذا؟

101
00:06:02,880 --> 00:06:03,770
.وأنا أيضًا

102
00:06:03,770 --> 00:06:04,240
!ماذا؟

103
00:06:05,130 --> 00:06:06,140
...عفوًا

104
00:06:10,560 --> 00:06:11,750
!سُحقًا

105
00:06:11,750 --> 00:06:15,500
،إن حدث وعاد كلّ شيء لطبيعته
!فسأكون من يتحمّل مسؤوليّة 7 جي

106
00:06:15,500 --> 00:06:18,150
!من المستحيل أن أسمح بحدوث ذلك

107
00:06:18,150 --> 00:06:19,470
!لقد تأخّرتم كثيرًا

108
00:06:19,470 --> 00:06:21,620
!لقد دمّرتنّ مملكتي

109
00:06:21,620 --> 00:06:23,760
!ستدفعن الثّمن

110
00:06:27,060 --> 00:06:28,110
!ابتعد عن طريقي

111
00:06:30,450 --> 00:06:32,840
!سأحوّلكنّ لهياكل عظميّة

112
00:06:33,160 --> 00:06:34,310
!اغرب عن وجهي

113
00:06:37,700 --> 00:06:39,420
!لا فائدة منكم

114
00:07:02,480 --> 00:07:03,260
!هذا خطير

115
00:07:03,260 --> 00:07:04,630
!قد تقتل أحدًا ما بذلك

116
00:07:04,630 --> 00:07:05,400
!غبيّة

117
00:07:05,400 --> 00:07:06,750
!أريد قتلكنّ جميعًا بالفعل

118
00:07:06,750 --> 00:07:07,390
ماذا؟

119
00:07:07,390 --> 00:07:08,780
ستقتلنا؟

120
00:07:08,780 --> 00:07:09,530
.صحيح

121
00:07:09,530 --> 00:07:13,130
.إنّكنّ تشكّلن خطرًا على الأميرة
!إيكبوكورو والأميرة بحاجة لبعضهما

122
00:07:13,130 --> 00:07:16,650
!لا وجود لإيكبوكورو بدون الأميرة
!ولا وجود للأميرة بدون إيكبوكورو

123
00:07:17,350 --> 00:07:18,590
!سُحقًا

124
00:07:26,590 --> 00:07:27,650
...أنت

125
00:07:27,650 --> 00:07:28,470
!حسنًا

126
00:07:28,470 --> 00:07:30,810
!أوسعهنّ ضربًا

127
00:07:32,430 --> 00:07:34,090
.لديّ سؤال واحد

128
00:07:34,090 --> 00:07:37,730
ما الّذي قصدته بـ"لا وجود
للأميرة بدون إيكبوكورو"؟

129
00:07:38,710 --> 00:07:39,900
.اشرح ما قصدت

130
00:07:39,900 --> 00:07:42,720
،إيكبوكورو في مركز طاقة 7 جي

131
00:07:42,720 --> 00:07:45,110
.والأميرة هي المركز الّذي يولّدها

132
00:07:45,110 --> 00:07:47,070
.يعتمد كلاهما على بعضهما

133
00:07:47,070 --> 00:07:50,410
،تُبقي الأميرة إيكبوكورو حيّة
.وتُبقي إيكبوكورو الأميرة حيّة

134
00:07:50,410 --> 00:07:51,400
ماذا؟

135
00:07:50,410 --> 00:07:52,030
ماذا؟ ماذا؟ ماذا؟

136
00:07:51,400 --> 00:07:52,030
!صه

137
00:07:52,030 --> 00:07:54,450
بينما يستنزف ذلك حياة يوكا-ساما؟

138
00:07:54,450 --> 00:07:55,200
يستنزف حياتها؟

139
00:07:55,200 --> 00:07:56,070
ما الّذي تقصده؟

140
00:07:56,070 --> 00:07:57,860
.يموت الجميع في النّهاية

141
00:07:57,860 --> 00:08:01,050
ما العيب في المهمّة النّبيلة المتمثّلة
!في الحفاظ على إيكبوكورو؟

142
00:08:01,050 --> 00:08:03,930
وهل ذلك هو ما تريده يوكا-ساما؟

143
00:08:03,930 --> 00:08:05,830
.أعتقد أنّك أسأت الفهم

144
00:08:05,830 --> 00:08:07,620
.ما أنت إلاّ حارس شخصيّ

145
00:08:07,620 --> 00:08:10,260
.أنا أخدم يوكا-ساما دون سواها

146
00:08:10,260 --> 00:08:12,160
.أنا لستُ حارسك الشّخصيّ

147
00:08:12,160 --> 00:08:13,010
!ماذا قلت؟

148
00:08:13,010 --> 00:08:16,460
أليست 7 جي هي سبب معاناة يوكا-ساما؟

149
00:08:16,460 --> 00:08:17,790
!وماذا في ذلك؟

150
00:08:17,790 --> 00:08:20,680
،إن أوقفنا 7 جي
فهل ستتوقّف معاناتها أيضًا؟

151
00:08:20,680 --> 00:08:21,650
.فهمت الآن

152
00:08:21,650 --> 00:08:23,990
إنّ 7 جي هي من أنشأت الملكة
،السّاحرة يوكا-تشان

153
00:08:23,990 --> 00:08:26,220
.ويوكا-تشان أنشأت عالم 7 جي

154
00:08:26,220 --> 00:08:26,720
!الزّرّ

155
00:08:26,720 --> 00:08:27,430
.فهمت

156
00:08:27,430 --> 00:08:28,310
...إن ضغطت عليه

157
00:08:34,630 --> 00:08:35,880
!أيّها الغراب الغبيّ

158
00:08:37,540 --> 00:08:38,690
...ما الّذي

159
00:08:38,690 --> 00:08:40,460
.يوكا-ساما بين أيديكنّ الآن

160
00:08:42,190 --> 00:08:44,020
ليس عدوّنا؟

161
00:08:45,220 --> 00:08:47,890
.عندما يتعلّق الأمر بيوكا، فأنت إلى جانبنا

162
00:08:47,890 --> 00:08:49,460
أهذا صحيح؟

163
00:08:49,460 --> 00:08:50,130
.نعم

164
00:09:02,650 --> 00:09:04,140
.يوكا-ساما

165
00:09:04,140 --> 00:09:04,940
.بوتشي

166
00:09:04,940 --> 00:09:06,260
.تفضّلي بعض الشّاي

167
00:09:06,260 --> 00:09:07,510
.شكرًا لك

168
00:09:19,340 --> 00:09:21,070
هل ستكونان بخير؟

169
00:09:21,070 --> 00:09:21,920
.أظنّ ذلك

170
00:09:22,230 --> 00:09:24,670
.واثقة أنّ يوكا-تشان ستتفهّم

171
00:09:24,670 --> 00:09:28,700
وإن لم يحدث ذلك، فأنا واثقة أنّها
...بمجرّد رؤية كتاب "نيري-ألي" هذا

172
00:09:28,700 --> 00:09:31,470
..."ربّما إن قرأت بعضًا من "شيبوتاتسو

173
00:09:31,800 --> 00:09:33,200
...ناديكو-تشان، ذلك

174
00:09:33,200 --> 00:09:34,710
.نعم، إنّها نبتة أزهار الآس

175
00:09:34,710 --> 00:09:36,650
لا علاقة لها بيوكا-تشان، صحيح؟

176
00:09:36,650 --> 00:09:37,500
.معك حقّ

177
00:09:37,500 --> 00:09:38,430
لماذا أحضرتُها؟

178
00:09:40,590 --> 00:09:41,680
.صحيح

179
00:09:41,680 --> 00:09:44,190
.قالت يوكا-تشان أنّ الأزهار تذكّرها النّجوم

180
00:09:44,190 --> 00:09:45,300
ماذا؟

181
00:09:45,300 --> 00:09:46,060
متى؟

182
00:09:46,060 --> 00:09:48,450
.قبل سنوات في حديقة المدرسة

183
00:09:48,450 --> 00:09:49,440
فعلاً...؟

184
00:09:49,440 --> 00:09:53,180
كانت يوكا-تشان تفكّر في النّجوم
منذ ذلك الوقت؟

185
00:09:53,720 --> 00:09:55,460
أتتعرّفين عليّ يا يوكا؟

186
00:09:55,460 --> 00:09:57,030
.هذه أنا شيزورو

187
00:09:57,440 --> 00:09:59,150
...شيزورو

188
00:09:59,150 --> 00:10:00,330
هل نسيت؟

189
00:10:00,330 --> 00:10:01,680
ألا تذكريني؟

190
00:10:02,250 --> 00:10:03,300
...إنّني

191
00:10:03,300 --> 00:10:06,370
.لستُ هنا لأطلب أن تسامحيني

192
00:10:06,370 --> 00:10:07,660
...في أسوأ الأحوال

193
00:10:07,660 --> 00:10:09,140
.ربّما ذلك تعبير غير مناسب

194
00:10:09,140 --> 00:10:10,690
.لكن ليس عليك أن تسامحيني

195
00:10:10,690 --> 00:10:14,400
!أردتُ فقط أن أعتذر لأنّي آذيتك

196
00:10:14,400 --> 00:10:15,000
!أنا آسفة

197
00:10:15,910 --> 00:10:18,830
لم تكن شيزورو-تشان جيّدة أبدًا
.في استخدام الكلمات

198
00:10:18,830 --> 00:10:20,560
!أشعر بالحرج من مجرّد الاستماع لها

199
00:10:20,560 --> 00:10:22,370
.لم يكن ذلك ما شعرت به حقًّا

200
00:10:22,840 --> 00:10:24,640
.مهلاً، لا. لقد شعرت كذلك قليلاً

201
00:10:24,640 --> 00:10:26,880
تعرفين كم أنّي غبيّة، أليس كذلك؟

202
00:10:26,880 --> 00:10:29,490
.لذلك شعرت أنّك أفضل منّي بكثير

203
00:10:29,490 --> 00:10:33,300
.وكلما كنتِ أفضل، شعرتُ أكثر أنّي بلا فائدة

204
00:10:33,300 --> 00:10:35,800
.لذلك السّبب تصرّفتُ معك بلؤم

205
00:10:35,800 --> 00:10:37,330
...ولكن بقيامي بذلك

206
00:10:37,820 --> 00:10:40,720
.كنتُ أقلّل من مستواي أكثر لا غير

207
00:10:40,720 --> 00:10:42,280
!أفهم ذلك الآن

208
00:10:54,750 --> 00:10:55,640
!شيزورو-تشان

209
00:10:55,640 --> 00:10:56,970
.أنا بخير

210
00:10:56,970 --> 00:10:58,800
.يوكا محقّة بغضبها منّي

211
00:10:58,800 --> 00:11:00,030
!يوكا-تشان

212
00:11:04,440 --> 00:11:05,840
!توقّفي يا يوكا-تشان

213
00:11:05,840 --> 00:11:08,730
لماذا ضربت شيزورو-تشان؟

214
00:11:08,730 --> 00:11:10,640
!لا أفهم يا يوكا-تشان

215
00:11:14,370 --> 00:11:15,990
لا... ماذا يحدث؟

216
00:11:16,280 --> 00:11:17,300
يوكا؟

217
00:11:17,760 --> 00:11:20,390
هل... هل تتذكّرين الآن؟

218
00:11:22,350 --> 00:11:24,710
"عليك أن تدركي أنّك لا تملكين أيّ فرصة، صحيح؟"

219
00:11:25,090 --> 00:11:27,700
إنّك تحرجين نفسك فقط"
".بعقدك لهذه الآمال الكبيرة

220
00:11:28,060 --> 00:11:31,370
"!ما عدت أهتمّ بأمرك يا يوكا"

221
00:11:32,280 --> 00:11:34,720
!مهلاً، كفّي عن ذلك يا يوكا-تشان

222
00:11:34,720 --> 00:11:35,530
!هذا مخيف

223
00:11:35,530 --> 00:11:36,510
لماذا؟

224
00:11:37,480 --> 00:11:38,850
.إنّها كلماتك

225
00:11:38,850 --> 00:11:40,000
.صحيح

226
00:11:40,000 --> 00:11:44,060
!قلتُ ذلك لأنّي لم أرد أن ترحلي

227
00:11:45,210 --> 00:11:47,470
!والآن... والآن فهمت

228
00:11:47,470 --> 00:11:48,780
!لقد فهمت! فهمت بالفعل

229
00:11:48,780 --> 00:11:51,880
كان التّقليل من شأنك وإحباطك
!هكذا تصرّفًا فظيعًا

230
00:11:51,880 --> 00:11:56,000
وقتها، لم أكن أريدك أن تغادري حتّى
!إن عنى ذلك إيذاءك والسّخرية منك

231
00:11:56,390 --> 00:12:00,180
ألهذا السّبب أتيت إلى هنا لأخذي إلى أغانو؟

232
00:12:00,180 --> 00:12:01,150
!لا

233
00:12:01,150 --> 00:12:03,500
.أردتُ أن أعتذر عمّا قلتُه

234
00:12:03,500 --> 00:12:06,030
.وأردتُ أن أخبرك أنّي أؤمن بأحلامك

235
00:12:06,030 --> 00:12:09,370
!وأنّي أدعمك وسأشجّعك على تحقيقها

236
00:12:09,940 --> 00:12:12,490
.يا لغرورك، جعلتِ كلّ هذا متعلّقًا بك

237
00:12:12,490 --> 00:12:13,110
!مهلاً

238
00:12:13,110 --> 00:12:13,900
!يوكا-تشان

239
00:12:13,900 --> 00:12:14,810
!لم يكن هنالك داع لذلك

240
00:12:14,810 --> 00:12:16,590
.أنت مخطئة حيال ذلك يا يوكا-تشان

241
00:12:16,590 --> 00:12:19,210
.أوافقك أنّ شيزورو-تشان قالت أشياء لئيمة لك

242
00:12:19,210 --> 00:12:23,110
لكنّها ما كانت لتقضي سنتين في البحث
!عنك كلّ يوم بدافع الغرور

243
00:12:23,110 --> 00:12:24,870
!أو حتّى المجيء إلى إيكبوكورو

244
00:12:24,870 --> 00:12:26,840
!هذا صحيح، لم يكن المجيء إلى هنا سهلاً

245
00:12:26,840 --> 00:12:28,660
.لم أطلب ذلك أبدًا، ولستُ المسؤولة

246
00:12:28,660 --> 00:12:30,380
!هذا صحيح، لم تطلبي ذلك منّا

247
00:12:30,380 --> 00:12:33,610
،لكن إن واصلت إبعادنا عنك
!فلن يتغيّر أيّ شيء

248
00:12:33,610 --> 00:12:34,840
...لن يتغيّر أيّ شيء

249
00:12:34,840 --> 00:12:38,630
.كنتُ أعتقد أنّه لا بأس إن لم يتغيّر أيّ شيء

250
00:12:38,630 --> 00:12:42,440
.وإن بقيت في أغانو للأبد معك ومع البقيّة

251
00:12:42,440 --> 00:12:45,100
.لذلك السّبب أردتُ فقط أن تعودي في البداية

252
00:12:45,100 --> 00:12:48,020
.لكنّي الآن أدرك أنّ ذلك لن يكون ممتعًا

253
00:12:48,020 --> 00:12:51,010
.من المملّ معرفة المستقبل وما الّذي يُخفيه

254
00:12:51,010 --> 00:12:54,880
!كلّما زادت الغموض والمجهول، زاد المرح

255
00:12:54,880 --> 00:12:59,460
أتعلمين؟ لقد واجهنا الكثير من المشاكل
!في طريقنا من أغانو إلى إيكبوكورو

256
00:12:59,460 --> 00:13:01,260
!لكنّ ذلك كان ممتعًا جدًّا

257
00:13:01,260 --> 00:13:03,750
.ما كنتُ لأدرك ذلك لو أنّي بقيت في أغانو

258
00:13:03,750 --> 00:13:06,700
.ولكن، توقّف العالم عن التّغيّر الآن

259
00:13:06,700 --> 00:13:08,250
.وصار كلّ شيء راكدًا

260
00:13:08,250 --> 00:13:09,410
!بل أسوأ من ذلك

261
00:13:09,410 --> 00:13:10,860
.يُقال أنّ العالم سينكمش

262
00:13:10,860 --> 00:13:13,550
!أريد أن أتغيّر وأُحدث تغييرًا

263
00:13:13,550 --> 00:13:15,190
—وعميقًا في داخلك، ألا تريدين

264
00:13:16,630 --> 00:13:17,640
!يوكا-تشان

265
00:13:16,970 --> 00:13:18,140
!توقّفي

266
00:13:18,480 --> 00:13:20,870
!لا تقرّري ما الّذي أشعر به بدلاً عنّي

267
00:13:27,440 --> 00:13:28,690
!شيزورو-تشان

268
00:13:31,980 --> 00:13:33,040
.يوكا-تشان

269
00:13:33,040 --> 00:13:34,290
هل حياتك الآن ممتعة؟

270
00:13:41,370 --> 00:13:44,170
...لا، ليست ممتعة

271
00:13:49,040 --> 00:13:50,510
.ليست ممتعة

272
00:14:17,940 --> 00:14:20,330
.حدث الكثير في أغانو

273
00:14:20,730 --> 00:14:23,870
.بما في ذلك أمورًا حزينة وأخرى مؤلمة أو فظيعة

274
00:14:23,870 --> 00:14:27,060
.لكن كانت تلك التّقلّبات هي ما جعلها ممتعة

275
00:14:27,060 --> 00:14:29,460
لديك حلم، صحيح يا يوكا-تشان؟

276
00:14:29,460 --> 00:14:31,800
،حسب الوضع الحاليّ، لن يتغيّر أيّ شيء

277
00:14:31,800 --> 00:14:34,830
،لكن إن عاد العالم لطبيعته
.قد يتحقّق حلمك

278
00:14:34,830 --> 00:14:36,610
.بإمكانك العمل لتحقيقه

279
00:14:36,610 --> 00:14:38,150
.هنالك إمكانيّة لذلك

280
00:14:38,150 --> 00:14:39,860
...إمكانيّة

281
00:14:39,860 --> 00:14:40,890
.يوكا

282
00:14:40,890 --> 00:14:42,930
.لنُخرج العالم من حالة الرّكود هذه

283
00:14:45,730 --> 00:14:46,810
...لكن

284
00:14:47,190 --> 00:14:49,370
.ستكون الحياة صعبة إن لم أنجح

285
00:14:51,430 --> 00:14:53,100
.ستتألّمين إن فشلتِ

286
00:14:53,440 --> 00:14:56,200
!لكنّي سأشجّعك يا يوكا

287
00:14:56,540 --> 00:14:57,110
.نعم

288
00:14:57,110 --> 00:14:59,570
!سأشجّعك بكلّ ما لديّ
!سأخبرك أن تبذلي جهدك

289
00:15:00,040 --> 00:15:04,010
من الأفضل بكثير أن تجرّبي وتندمي
.على ألاّ تفعلي أيّ شيء على الإطلاق

290
00:15:04,010 --> 00:15:05,550
!لذلك سأشجّعك

291
00:15:11,510 --> 00:15:12,950
!إنّه نجم الشِّعرى

292
00:15:12,950 --> 00:15:13,980
الشِّعرى؟

293
00:15:13,980 --> 00:15:16,030
...نجم الوعود

294
00:15:19,440 --> 00:15:23,030
لنُشهِد نجم الوعود الكبير اللاّمع
.ذاك على وعدنا

295
00:15:23,030 --> 00:15:24,470
نجم الوعود؟

296
00:15:24,470 --> 00:15:26,070
.فكّرتُ في ذلك الاسم للتّوّ

297
00:15:26,070 --> 00:15:28,610
.أعتقد أنّه يسمّى الشِّعرى

298
00:15:29,010 --> 00:15:31,720
.ليكن ذلك اسمنا إذًا

299
00:15:31,720 --> 00:15:32,610
.حسنًا

300
00:15:40,920 --> 00:15:43,540
.لا أستحقّ أن أُشجَّع

301
00:15:43,540 --> 00:15:44,430
لِمَ لا؟

302
00:15:44,430 --> 00:15:46,820
.لقد سخرتُ منك

303
00:15:46,820 --> 00:15:49,350
سخرت منك لأنّك تباهيت بالكثير
.ولكن لم تحقّقي أيّ شيء

304
00:15:50,050 --> 00:15:51,510
.وأنّك لن تحقّقي أيّ شيء أبدًا

305
00:15:51,860 --> 00:15:56,080
.وأنّك حتّى إن ذبلتِ وتعفّنتِ، فلن أهتمّ لك

306
00:15:56,080 --> 00:15:57,050
.لقد ضحكت عليك

307
00:15:57,050 --> 00:15:58,220
.لقد لعنتك

308
00:15:59,430 --> 00:16:01,030
.تلك ليست لعنة

309
00:16:03,260 --> 00:16:04,520
.بل ما أريده

310
00:16:04,520 --> 00:16:05,480
ماذا؟

311
00:16:05,480 --> 00:16:09,820
أعني أنّه سواء بقيتُ في أغانو للأبد
،أو غادرت إلى مكان آخر

312
00:16:09,820 --> 00:16:13,410
فسأكون سعيدة لأنّك تفكّرين بي
.مهما كانت الظّروف

313
00:16:13,980 --> 00:16:18,000
...غبيّة، إنّك غبيّة بالفعل

314
00:16:18,310 --> 00:16:20,300
.اسمعي يا يوكا-تشان

315
00:16:20,300 --> 00:16:23,240
ألا تفضّلين أن تكوني مع بقيّتنا
بدل التّواجد هنا وحدك؟

316
00:16:23,240 --> 00:16:24,280
.هذا صحيح

317
00:16:24,280 --> 00:16:25,890
!سيكون ذلك ممتعًا أكثر

318
00:16:25,890 --> 00:16:29,140
يمكنك التّفكير في المستقبل
.عندما يحين الوقت لذلك

319
00:16:31,420 --> 00:16:32,500
.يوكا

320
00:16:51,220 --> 00:16:52,440
...أنا

321
00:16:53,220 --> 00:16:54,320
.سيكون كلّ شيء بخير

322
00:17:02,590 --> 00:17:04,530
!كلاّ، لن أسمح بذلك

323
00:17:07,870 --> 00:17:08,590
!يوكا-تشان

324
00:17:08,590 --> 00:17:09,220
!يوكا

325
00:17:14,800 --> 00:17:15,990
!لقد أمسكتك

326
00:17:17,460 --> 00:17:19,510
!أخافني ذلك كثيرًا

327
00:17:20,000 --> 00:17:21,130
!يا إلهي

328
00:17:21,130 --> 00:17:22,420
!يا لها من مفاجأة

329
00:17:22,420 --> 00:17:23,880
!إنّها الملكة السّاحرة

330
00:17:23,880 --> 00:17:25,800
.اسمها يوكا. ناكاتومي يوكا

331
00:17:28,390 --> 00:17:29,760
!مفهوم

332
00:17:32,140 --> 00:17:34,310
...إن عاد العالم لسابق عهده

333
00:17:34,660 --> 00:17:36,580
...وحتّى إن لم يعد

334
00:17:36,580 --> 00:17:37,940
!فسنفكّر في ذلك حينها

335
00:17:37,940 --> 00:17:39,340
!التّفاؤل

336
00:17:39,340 --> 00:17:40,710
أليس ذلك كافيًا؟

337
00:17:59,790 --> 00:18:00,720
...يوكا-ساما

338
00:18:22,670 --> 00:18:24,170
...رفاق

339
00:18:26,120 --> 00:18:28,500
...إنّ هذا

340
00:18:28,500 --> 00:18:29,030
!مهلاً

341
00:18:29,030 --> 00:18:30,960
أكانت إيكبوكورو هكذا من قبل؟

342
00:18:30,130 --> 00:18:30,960
!معها حقّ

343
00:18:30,960 --> 00:18:33,420
،أشعر أنّها كانت كذلك
...ولكن ليس كذلك أيضًا

344
00:18:33,420 --> 00:18:34,790
.هذه هي يوكا القديمة على الأقلّ

345
00:18:34,790 --> 00:18:35,400
ماذا؟

346
00:18:35,400 --> 00:18:36,510
.نعم، نعم

347
00:18:36,510 --> 00:18:37,600
فعلاً؟

348
00:18:37,600 --> 00:18:40,520
.نعم، عدتِ إلى سابق عهدك 100 بالمائة

349
00:18:40,520 --> 00:18:41,330
.نعم

350
00:18:41,920 --> 00:18:44,400
.إنّها تبدو مختلفة قليلاً عن قبل

351
00:18:44,970 --> 00:18:46,400
.هذا صحيح

352
00:18:46,400 --> 00:18:48,840
،حتّى إن بدا أنّ النّهر يسري في نفس المجرى

353
00:18:48,840 --> 00:18:50,380
.إلاّ أنّ المياه في تغيّر مستمرّ

354
00:18:50,380 --> 00:18:52,870
ونفس الشّيء ينطبق على المدن
.والنّاس والعالم

355
00:18:52,870 --> 00:18:54,720
.يبدون على حالهم، لكنّهم ليسوا كذلك

356
00:18:54,720 --> 00:18:55,990
.إنّهم يتغيّرون مع الوقت

357
00:18:55,990 --> 00:18:59,190
.شكرًا على التّلخيص المرتّب

358
00:18:59,480 --> 00:19:01,400
.لا يمكن للعالم أن يعود كما كان بالضّبط

359
00:19:01,400 --> 00:19:02,890
.سيواصل في التّغيّر

360
00:19:02,890 --> 00:19:03,450
!حسنًا

361
00:19:05,820 --> 00:19:08,490
!حان الوقت لرؤية كيف صار العالم

362
00:19:08,490 --> 00:19:10,660
!إلى اللّقاء

363
00:19:16,900 --> 00:19:18,300
مهلاً، ماذا؟

364
00:19:18,560 --> 00:19:20,320
...أهو امتنان أم إعجاب

365
00:19:20,320 --> 00:19:22,010
.إنّه أحدهما أو ربّما كلاهما

366
00:19:22,010 --> 00:19:24,310
...لكنّهم عادوا بشرًا جميعًا

367
00:19:24,310 --> 00:19:25,630
.لا تنظري للأمر على أنّه عودة للسّابق

368
00:19:25,630 --> 00:19:29,270
البشر الزّومبي السّابقون
!تحوّلوا إلى بشر جدد بالكامل

369
00:19:29,270 --> 00:19:30,170
.هذا منطقيّ

370
00:19:30,170 --> 00:19:32,430
هل ما زلت ملكتكم؟

371
00:19:35,350 --> 00:19:37,570
.نعم، ذلك هو مكانك

372
00:19:37,570 --> 00:19:38,820
!كوروكين

373
00:19:38,820 --> 00:19:40,370
ماذا عنكنّ؟

374
00:19:43,410 --> 00:19:44,330
!أغانو

375
00:19:49,950 --> 00:19:51,010
!حُدّدت وجهتنا

376
00:19:51,010 --> 00:19:53,440
!ليصعد الجميع على متن قطار أبوجي

377
00:20:00,590 --> 00:20:02,440
قطار أبوجي؟

378
00:20:02,440 --> 00:20:04,420
.سمّته شيزورو-تشان بذلك

379
00:20:04,420 --> 00:20:05,620
...لماذا

380
00:20:07,150 --> 00:20:09,320
.أتساءل كيف حال أغانو

381
00:20:09,320 --> 00:20:11,500
بل عليك أن تسألي كيف صارت؟

382
00:20:18,600 --> 00:20:19,680
مهلاً، ماذا؟

383
00:20:19,680 --> 00:20:20,400
ما هذا الصّوت؟

384
00:20:20,400 --> 00:20:21,350
ماذا كان؟

385
00:20:21,350 --> 00:20:22,980
!صحيح

386
00:20:23,650 --> 00:20:25,010
!نجح الأمر

387
00:20:25,010 --> 00:20:27,670
.لا بدّ أنّ الأمر كذلك بما أنّكنّ أوقفتنّ 7 جي

388
00:20:27,670 --> 00:20:28,170
كيف الوضع عندكنّ؟

389
00:20:28,450 --> 00:20:29,140
.نعم

390
00:20:29,140 --> 00:20:31,410
إنّه مزيج من الأشياء الجيّدة
وغير الجيّدة جدًّا

391
00:20:31,410 --> 00:20:34,090
.والأشياء الّتي يصعب الجزم فيها بالكامل

392
00:20:34,500 --> 00:20:36,740
.لا يمكنني القول أنّ كلّ شيء اختفى

393
00:20:36,740 --> 00:20:39,840
ما زال هنالك بعض... أو بالأحرى
.الكثير من التّأثيرات المتبقّية

394
00:20:39,840 --> 00:20:40,720
.زنجيرو

395
00:20:40,720 --> 00:20:42,370
.وثّق تغيّرات الجميع

396
00:20:41,730 --> 00:20:42,970
.يا إلهي

397
00:20:42,970 --> 00:20:45,330
—إنّ ماكوتو-سينسي العظيمة متطلّبة

398
00:20:47,800 --> 00:20:48,680
.حسنًا

399
00:20:48,680 --> 00:20:52,530
إنّ الوضع المضاد لتشو-تشو
.زاد عن البارحة 39 ثانية

400
00:20:52,530 --> 00:20:53,920
.هكذا هو الوضع هنا

401
00:20:53,920 --> 00:20:55,440
.كنّ حذرات في طريق عودتكنّ

402
00:20:55,440 --> 00:20:58,910
.ربّما قد تواجهن وقتًا أصعب في رحلة العودة

403
00:21:02,310 --> 00:21:03,090
!انظرن

404
00:21:03,090 --> 00:21:03,740
ما هذا؟

405
00:21:03,740 --> 00:21:04,810
!أرى شيئًا ما

406
00:21:04,810 --> 00:21:06,560
قطار آخر؟

407
00:21:06,560 --> 00:21:07,010
ماذا؟

408
00:21:07,010 --> 00:21:08,690
هل يُعقل أنّه خطّ شيبو شينجوكو؟

409
00:21:08,690 --> 00:21:10,350
إذًا فقد عاد؟

410
00:21:10,350 --> 00:21:12,620
.نحن أيضًا عدنا

411
00:21:12,880 --> 00:21:15,000
هل "العودة" هو التّعبير الصّحيح؟

412
00:21:15,000 --> 00:21:17,490
ماذا إن كان خطّ شينجوكو جديد
تمامًا ولا نعرف عنه شيئًا؟

413
00:21:17,790 --> 00:21:21,270
.ربّما نكون قد انتقلنا لواقع موازٍ أيضًا

414
00:21:21,270 --> 00:21:23,270
هل يمكننا فعلاً العودة إلى أغانو؟

415
00:21:23,270 --> 00:21:23,960
فعلاً؟

416
00:21:23,960 --> 00:21:25,330
.يا شيزورو-تشان

417
00:21:25,330 --> 00:21:28,020
لماذا سمّيت القطارَ أبوجي؟

418
00:21:31,300 --> 00:21:32,450
.سؤال وجيه

419
00:21:32,450 --> 00:21:35,090
.لم أتوقّع ذلك من شيزورو-تشان

420
00:21:35,090 --> 00:21:36,370
.كما أنّه مصطلح تقنيّ أيضًا

421
00:21:36,370 --> 00:21:37,050
لماذا ذلك؟

422
00:21:37,050 --> 00:21:38,260
لماذا، لماذا؟

423
00:21:44,150 --> 00:21:48,710
يكون القمر في أبعد مسافة ممكنة له
.عن الأرض عند نقطة أبوجي في مداره

424
00:21:48,710 --> 00:21:50,820
.لذلك فلا يمكنه إلاّ أن يقترب من هناك