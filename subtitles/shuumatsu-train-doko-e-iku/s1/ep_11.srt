1
00:00:03,200 --> 00:00:06,100
.إنّ كلّ هذا المطر مؤخّرًا مزعج للغاية

2
00:00:06,100 --> 00:00:08,080
.على الأقلّ إنّه مطر عاديّ

3
00:00:08,080 --> 00:00:11,240
كانت تُمطر أسماك إسقمريّ
.فقط في منزلي مؤخّرًا

4
00:00:11,600 --> 00:00:14,790
.سئمت منه كلّه، سواء مشويّ أو مطبوخ

5
00:00:14,790 --> 00:00:18,740
...إمّا أن تحبّ السّمك الدّسم أم لا

6
00:00:25,180 --> 00:00:26,350
قطار؟

7
00:00:26,890 --> 00:00:28,770
.لا تكوني سخيفة

8
00:00:28,770 --> 00:00:32,360
.الشّيء الوحيد الّذي ما زال يعمل هو حافلة إيكي

9
00:00:43,400 --> 00:00:44,800
!هذا سريع، هذا سريع، هذا سريع

10
00:00:44,800 --> 00:00:46,280
!اهدئي يا شيزورو-تشان

11
00:00:46,280 --> 00:00:49,750
!هيّا، هيّا، هيّا

12
00:00:51,280 --> 00:00:52,510
!تمسّكن

13
00:00:52,510 --> 00:00:55,030
!محطّة إيكبوكورو عبارة عن رصيف نهائيّ

14
00:00:55,030 --> 00:00:57,560
!ماذا؟ ما هو الرّصيف النّهائيّ؟

15
00:01:04,860 --> 00:01:06,650
!أهذه إيكبوكورو؟

16
00:01:06,920 --> 00:01:08,780
.ظننتُ أنّنا هالكات

17
00:01:08,780 --> 00:01:09,670
هل أنت بخير؟

18
00:01:09,670 --> 00:01:10,990
لم يتأذّ أيّ أحد؟

19
00:01:10,990 --> 00:01:12,130
!لكنّنا وصلنا

20
00:01:12,130 --> 00:01:14,490
!وصلنا أخيرًا إلى إيكبوكورو

21
00:01:14,490 --> 00:01:19,280
الرّصيف النّهائيّ هو سكّة بنهاية
...مسدودة مثل هذه

22
00:01:20,430 --> 00:01:21,880
ما الأمر يا بوتشي-سان؟

23
00:01:23,560 --> 00:01:24,900
!هناك دخلاء

24
00:01:24,900 --> 00:01:25,790
!اقضوا عليهم

25
00:01:25,790 --> 00:01:27,370
ما الّذي يحدث؟

26
00:01:27,370 --> 00:01:28,900
!تقدّمي أيّتها القوّات الهجوميّة

27
00:01:28,900 --> 00:01:30,810
!دون أيّ أسئلة أوّلاً؟

28
00:01:35,150 --> 00:01:36,930
رائحة يوكا-تشان؟

29
00:01:36,930 --> 00:01:37,780
!هيّا بنا

30
00:01:37,780 --> 00:01:38,730
!أجل

31
00:01:38,730 --> 00:01:40,130
!انتظرنني

32
00:03:12,750 --> 00:03:14,550
هل استيقظت؟

33
00:03:14,550 --> 00:03:16,950
.الفطور جاهز

34
00:03:20,550 --> 00:03:22,690
.نعم، حسنًا

35
00:03:24,340 --> 00:03:26,640
ما الفطور اليوم؟

36
00:03:26,910 --> 00:03:31,590
إسقمريّ الصّورل المجفّف وعجّة بيض
.بالفطر وحساء ميسو بالقرع المرّ

37
00:03:31,900 --> 00:03:33,360
.يبدو ذلك شهيًّا

38
00:03:33,890 --> 00:03:36,680
قدّمت لي القرع المرّ من قبل
...على ما أظنّ

39
00:03:36,680 --> 00:03:38,470
هل تحبّه؟

40
00:03:38,470 --> 00:03:41,270
.لا، ما كنتُ لأقول ذلك

41
00:03:41,270 --> 00:03:43,020
ألا تحبّينه أنت يا يوكا-ساما؟

42
00:03:43,440 --> 00:03:45,240
...إن كان الوضع كذلك، فسوف

43
00:03:44,500 --> 00:03:46,390
.لا، لا أمانعه

44
00:03:46,390 --> 00:03:48,880
.إنّه يمنحني شعورًا غريبًا فحسب

45
00:03:49,590 --> 00:03:51,120
غريبًا كيف؟

46
00:03:51,410 --> 00:03:53,630
.لستُ واثقة من ذلك

47
00:03:53,630 --> 00:03:57,580
،لا أظنّني كنتُ آكله كثيرًا من قبل
.لكنّه يشعرني بالحنين

48
00:03:57,580 --> 00:03:59,130
.لذلك السّبب وصفته بالغريب

49
00:03:59,130 --> 00:04:00,040
.فهمت

50
00:04:00,800 --> 00:04:03,820
من أين مصدره؟

51
00:04:04,360 --> 00:04:05,220
...إنّه

52
00:04:08,060 --> 00:04:09,020
ماذا؟

53
00:04:13,950 --> 00:04:14,840
.وجدتُ أحدًا ما

54
00:04:14,840 --> 00:04:16,690
!لنسأله

55
00:04:17,050 --> 00:04:18,200
.المعذرة

56
00:04:18,200 --> 00:04:19,690
هلاّ منحتنا دقيقة من وقتك؟

57
00:04:20,950 --> 00:04:23,530
.إنّنا نبحث عن فتاة تُدعى ناكاتومي يوكا

58
00:04:26,020 --> 00:04:27,880
.إنّه رجل ضخم

59
00:04:27,880 --> 00:04:28,830
مئزر مطبخ؟

60
00:04:28,830 --> 00:04:30,100
.أحسني التّصرّف

61
00:04:33,210 --> 00:04:34,660
ماذا؟ ماذا هنالك؟

62
00:04:36,050 --> 00:04:37,160
ما الخطب؟

63
00:04:37,160 --> 00:04:39,600
أهو كونتارو ثانية؟

64
00:04:45,250 --> 00:04:45,850
...يو

65
00:05:07,700 --> 00:05:09,110
.كم هو ظريف

66
00:05:09,650 --> 00:05:11,480
أهذا كلبك؟

67
00:05:11,480 --> 00:05:13,460
.كان لديّ كلب أيضًا منذ مدّة

68
00:05:13,460 --> 00:05:14,920
.كان اسمه بوتشي-سان

69
00:05:14,920 --> 00:05:17,200
ما اسمك أنت؟

70
00:05:18,800 --> 00:05:20,860
!هذا هو بوتشي-سان بالفعل

71
00:05:20,860 --> 00:05:22,400
!كيف لا تتعرّفين إليه؟

72
00:05:22,400 --> 00:05:25,930
.أتينا من أغانو للبحث عنك يا يوكا-تشان

73
00:05:25,930 --> 00:05:27,550
أنت هي يوكا-تشان، صحيح؟

74
00:05:39,040 --> 00:05:41,320
من أنتنّ؟

75
00:05:42,100 --> 00:05:44,440
هل يُعقل أنّك ما زلت غاضبة؟

76
00:05:47,220 --> 00:05:48,450
بشأن ماذا؟

77
00:05:48,720 --> 00:05:51,210
لماذا قد أغضب؟

78
00:05:51,210 --> 00:05:52,290
...ذلك

79
00:06:08,090 --> 00:06:11,770
...يراودني فجأة... شعور فظيع

80
00:06:12,310 --> 00:06:15,160
...كأنّ شيئًا ما يطعن صدري

81
00:06:15,160 --> 00:06:16,400
.مهلاً يا يوكا-تشان

82
00:06:16,400 --> 00:06:18,400
ألا تتعرّفين علينا؟

83
00:06:18,400 --> 00:06:20,220
مستحيل! أتعاني فقدان ذاكرة؟

84
00:06:20,220 --> 00:06:23,540
هل خضعت لجراحة عبثيّة مثل زنجيرو-سان؟

85
00:06:23,540 --> 00:06:24,570
!كلاّ

86
00:06:28,610 --> 00:06:30,620
.اسمي ناكاتومي يوكا

87
00:06:31,120 --> 00:06:33,330
.أنا تلميذة ثانويّة وأحبّ علم الفلك

88
00:06:33,750 --> 00:06:36,620
.أدرس بجدّ كلّ يوم هنا في إيكبوكورو

89
00:06:36,950 --> 00:06:38,440
.الدّراسة ممتعة

90
00:06:38,440 --> 00:06:40,790
.أحبّ تعلّم أشياء جديدة

91
00:06:40,790 --> 00:06:42,570
.إنّها توسّع من وجهة نظري

92
00:06:42,570 --> 00:06:44,620
...وحلمي عندما أكبر

93
00:06:46,250 --> 00:06:49,090
...وحلمي... عندما أكبر

94
00:06:49,720 --> 00:06:50,340
—يو

95
00:06:53,210 --> 00:06:54,350
!شيزورو-تشان

96
00:06:55,510 --> 00:06:56,940
يوكا-تشان؟

97
00:07:00,490 --> 00:07:01,720
.يوكا-ساما

98
00:07:01,720 --> 00:07:03,100
.تحكّمي في نفسك رجاءً

99
00:07:03,100 --> 00:07:05,150
...اسمي ناكاتومي يوكا

100
00:07:05,150 --> 00:07:06,300
!استمعي لي يا يوكا

101
00:07:06,300 --> 00:07:07,140
—إنّك

102
00:07:08,750 --> 00:07:09,480
.وجدناهنّ

103
00:07:11,170 --> 00:07:13,550
.لم أعتقد أنّكنّ ستجدنها بهذه السّرعة

104
00:07:13,550 --> 00:07:16,410
!حشرات مزعجة أتت لأذيّة الأميرة

105
00:07:16,410 --> 00:07:18,570
!ما كلّ هذه الوقاحة أمام يوكا-هيمي

106
00:07:18,570 --> 00:07:20,790
!يا لكنّ من مجموعة أوغاد

107
00:07:20,790 --> 00:07:22,130
!وعدوّ لنا أيضًا

108
00:07:22,130 --> 00:07:23,050
!أطيحوا بهنّ

109
00:07:23,050 --> 00:07:25,440
!بعبارة أخرى، اسحقوهنّ

110
00:07:25,440 --> 00:07:28,080
!إنّهم جادّون! سنموت

111
00:07:28,080 --> 00:07:28,930
!يوكا

112
00:07:28,930 --> 00:07:30,460
!انتظري يا يوكا

113
00:07:30,460 --> 00:07:31,980
!ليس الآن يا شيزورو-تشان

114
00:07:31,980 --> 00:07:32,910
!من هنا جميعًا

115
00:07:32,910 --> 00:07:34,990
!لن نستفيد شيئًا من الموت هنا

116
00:07:37,090 --> 00:07:39,100
هل أصبت يا أميرة؟

117
00:07:39,100 --> 00:07:39,800
.على الإطلاق

118
00:07:44,750 --> 00:07:47,540
!لماذا تحتفظ بشيء بهذه الأهمّيّة هنا؟

119
00:07:47,540 --> 00:07:48,390
!يا لك من مغفّل

120
00:07:48,390 --> 00:07:50,060
ما معنى هذا؟

121
00:07:50,060 --> 00:07:51,200
...إنّه هنّ

122
00:07:51,200 --> 00:07:52,070
!لا بدّ من ذلك

123
00:07:52,070 --> 00:07:53,890
...هنّ السّبب في أنّ الأميرة قد

124
00:07:53,890 --> 00:07:55,690
!أمسكوا بأولئك الفتيات

125
00:07:55,690 --> 00:07:57,790
!لا تسمحوا لهنّ بالهرب

126
00:07:59,010 --> 00:07:59,910
!حسنًا، هيّا بنا

127
00:08:00,210 --> 00:08:01,360
!تحرّك

128
00:08:01,360 --> 00:08:03,740
!بسرعة، بسرعة، بسرعة

129
00:08:07,800 --> 00:08:09,540
!لماذا سمحتم لهنّ بالهرب؟

130
00:08:09,540 --> 00:08:13,420
!سأخبر الأميرة أن تحوّلكم جميعًا إلى توكوروتن

131
00:08:13,740 --> 00:08:15,600
.هذا سيّئ، سيّئ جدًّا

132
00:08:15,600 --> 00:08:19,510
،بالنّظر للزّرّ وردّة فعلها
.فمن الأفضل الفصل بينهما

133
00:08:19,510 --> 00:08:21,220
.مع أنّي ظننتُ أنّي كنت حذرًا

134
00:08:21,220 --> 00:08:23,010
!تصرّفتُ بحماقة

135
00:08:26,950 --> 00:08:28,360
هل ناديتني؟

136
00:08:28,610 --> 00:08:30,690
ما هذا السّؤال؟

137
00:08:30,690 --> 00:08:31,980
.أيّها المغفّل الضّخم

138
00:08:34,290 --> 00:08:34,830
لماذا؟

139
00:08:34,830 --> 00:08:36,930
،لأنّ أولئك الفتيات اللاّتي أفلتن منّا بسببك

140
00:08:36,930 --> 00:08:38,860
!قد يعدن ثانية لسرقتها

141
00:08:38,860 --> 00:08:40,590
!أليس ذلك واضحًا

142
00:08:40,900 --> 00:08:43,880
.قد لا توافق على ذلك

143
00:08:43,880 --> 00:08:46,470
.إنّها تحبّ تلك الشّقّة كثيرًا

144
00:08:46,470 --> 00:08:48,670
!من يهتمّ كم تحبّها أو مدى تعلّقها بها؟

145
00:08:49,090 --> 00:08:51,810
!أتعتقد أنّ بإمكانك حماية الأميرة؟

146
00:08:51,810 --> 00:08:52,810
.بالطّبع

147
00:08:52,810 --> 00:08:56,710
،إن لمسن شعرة واحدة منها
!فستدفع الثّمن باهظًا

148
00:08:56,710 --> 00:08:57,460
!أنت

149
00:08:57,460 --> 00:08:58,630
!أحضر لي عربة يدويّة

150
00:08:58,630 --> 00:09:00,010
!وبعض حرّاس الأمن

151
00:09:02,140 --> 00:09:05,600
أتعتقدن أنّها ربّما لم تكن يوكا-تشان؟

152
00:09:05,600 --> 00:09:06,450
ماذا؟

153
00:09:06,450 --> 00:09:07,680
.هناك خطب ما بالفعل

154
00:09:07,990 --> 00:09:09,860
.كانت يوكا-تشان تلك غريبة

155
00:09:09,860 --> 00:09:12,680
.إنّها لم تعرف من نكون حتّى

156
00:09:12,680 --> 00:09:15,200
...كان هنالك شيء غريب حيالها بالفعل

157
00:09:15,200 --> 00:09:17,450
.واثقة تمامًا أنّها كانت يوكا الحقيقيّة

158
00:09:18,620 --> 00:09:19,950
.وأنا كذلك

159
00:09:19,950 --> 00:09:22,750
.ظنّ بوتشي-سان أنّها يوكا-تشان أيضًا

160
00:09:22,750 --> 00:09:24,500
.لا بدّ أنّها يوكا-تشان

161
00:09:24,500 --> 00:09:27,700
إذًا هل كانت غاضبة جدًّا فحسب؟

162
00:09:27,700 --> 00:09:28,950
هل تتجاهلنا؟

163
00:09:28,950 --> 00:09:30,160
تتجاهلنا؟

164
00:09:30,420 --> 00:09:31,810
.ربّما

165
00:09:31,810 --> 00:09:34,810
.كنتُ لأفعل ذلك أيضًا لو كنت مكانها

166
00:09:36,160 --> 00:09:37,850
مهلاً، ماذا؟

167
00:09:38,360 --> 00:09:41,380
!هذه مورس. إنّها شيفرة مورس

168
00:09:41,380 --> 00:09:43,140
!إنّها من زنجيرو-سان وماكوتو-سينسي

169
00:09:43,490 --> 00:09:45,850
لماذا يستعملان القرع المرّ؟

170
00:09:45,850 --> 00:09:49,010
لا بدّ أنّ الجذور والتّعرّشات
.قد نمت وارتبطت حتّى بأغانو

171
00:09:49,400 --> 00:09:50,320
ماذا؟

172
00:09:50,320 --> 00:09:52,550
مِن هنا حتّى أغانو؟

173
00:09:54,100 --> 00:09:55,200
!لا رادع للقرع المرّ

174
00:09:55,560 --> 00:09:57,890
ما الّذي تقوله ماكوتو-سينسي إذًا؟

175
00:09:57,890 --> 00:09:59,890
".قطّعن قرعة مرّة"

176
00:09:59,890 --> 00:10:00,430
ماذا؟

177
00:10:00,430 --> 00:10:01,940
.أحضري سكّينا يا شيزورو-تشان

178
00:10:04,860 --> 00:10:06,120
.اختبار، اختبار

179
00:10:07,240 --> 00:10:08,130
ماذا؟

180
00:10:08,130 --> 00:10:10,640
يصدر صوت ماكوتو-سينسي
!من هذه القرعة المرّة

181
00:10:10,640 --> 00:10:12,700
هل ما زلنا نتحدّث نفس اللّغة؟

182
00:10:14,900 --> 00:10:17,050
!هذا صاخب! بإمكاني سماعكنّ

183
00:10:17,050 --> 00:10:18,660
!إنّها ماكوتو-سينسي

184
00:10:19,960 --> 00:10:21,870
مرحبًا! أيمكنك رؤيتنا؟

185
00:10:21,870 --> 00:10:24,070
.لا. إنّه خطّ للصّوت فحسب

186
00:10:24,070 --> 00:10:25,010
.للأسف

187
00:10:25,010 --> 00:10:27,670
.اكتشفنا كيف نعيد العالم إلى طبيعته

188
00:10:27,670 --> 00:10:28,900
ماذا؟ من هذا؟

189
00:10:28,900 --> 00:10:30,380
!إنّه زنجيرو-سان

190
00:10:30,380 --> 00:10:31,660
اكتشفتما الأمر؟

191
00:10:31,660 --> 00:10:35,660
،لم نعثر على دليل بعد
.لكنّها فرضيّة ذات مصداقيّة إلى حدّ ما

192
00:10:35,930 --> 00:10:39,950
لا بدّ أنّ إطلاق 7 جي قد بدأ بواسطة
.مفتاح ما— زرّ إن صحّ التّعبير

193
00:10:39,950 --> 00:10:42,840
.وذلك الزّرّ ظلّ مضغوطًا طوال هذا الوقت

194
00:10:42,840 --> 00:10:45,660
...ما يعني أنّه إن ضغطناه مرّة أخرى لإطفائها

195
00:10:45,660 --> 00:10:46,370
إن ضغطناه؟

196
00:10:46,720 --> 00:10:48,650
.فسيفصل ذلك شبكة 7 جي

197
00:10:48,650 --> 00:10:51,340
.وستختفي التّأثيرات النّاجمة عن إشارتها

198
00:10:51,340 --> 00:10:53,930
.بعبارة أخرى، قد تعود الأمور لما كانت عليه

199
00:10:54,640 --> 00:10:55,880
هذا كلّ شيء؟

200
00:10:55,880 --> 00:10:58,160
!لا، لا، لا! يبدو هذا سهلاً جدًّا

201
00:10:58,160 --> 00:10:59,870
.ولذلك السّبب بالتّحديد لم ننتبه له

202
00:11:00,200 --> 00:11:03,090
،انشغلنا بالتّعامل مع كلّ ظاهرة على حدة

203
00:11:03,090 --> 00:11:06,160
وذلك ما لم يترك لنا وقتًا لتحديد
.السّبب الأساسيّ وراء كلّ ذلك

204
00:11:06,160 --> 00:11:07,790
.أفترض أنّ ذلك صحيح

205
00:11:07,790 --> 00:11:09,810
أين يوجد ذلك الزّرّ إذًا؟

206
00:11:09,810 --> 00:11:11,110
.لا ندري

207
00:11:11,110 --> 00:11:13,900
،ولكن إن كنتُ مكان بونتارو

208
00:11:13,900 --> 00:11:16,610
.فسأخفيه وأضع حوله حراسة شديدة

209
00:11:16,610 --> 00:11:19,090
في معركة بين أولئك الّذين يحافظون
على الوضع الرّاهن الجديد

210
00:11:19,090 --> 00:11:21,840
وأولئك الّذين يحاولون العودة
،إلى الوضع القديم

211
00:11:21,840 --> 00:11:24,500
.يتمّ تحديد الفائز من قبل من لديه هذا الزّرّ

212
00:11:24,830 --> 00:11:27,840
سنتّصل بكنّ ثانية بمجرّد حصولنا
.على معلومات أكثر

213
00:11:27,840 --> 00:11:30,880
احرصن على أكل القرعة المرّة
.الّتي استعملتنّها لهذا الاتّصال

214
00:11:30,880 --> 00:11:31,990
.حسنًا

215
00:11:31,990 --> 00:11:34,500
—لا تضيّعوا ذلك الطّعا
...تشو تشو-تشو تشو

216
00:11:35,070 --> 00:11:37,380
.ماذا؟ عاد زنجيرو-سان لما عهدناه

217
00:11:37,380 --> 00:11:42,850
استطعتُ تمديد وقته في الوضع المضاد
.لتشو-تشو إلى 5 دقائق و38 ثانية

218
00:11:42,850 --> 00:11:44,120
!هذا مذهل

219
00:11:44,120 --> 00:11:47,150
.لا، ما زلتُ بعيدة جدًّا عن إتمام مضادّ تشو-تشو

220
00:11:47,150 --> 00:11:49,710
إن واصلتِ تمديده، فهل سيعود لطبيعته؟

221
00:11:49,710 --> 00:11:52,280
.سيأخذ الأمر 94 سنة وفق حساباتي

222
00:11:53,880 --> 00:11:55,020
.هكذا إذًا

223
00:11:55,020 --> 00:11:56,980
.علينا التّفكير حيال هذا

224
00:11:56,980 --> 00:12:00,540
مهما نظرنا للأمر، فلن يعيش
زنجيرو-سان لـ94 سنة، صحيح؟

225
00:12:00,540 --> 00:12:01,760
.لم أقصد ذلك

226
00:12:01,760 --> 00:12:03,190
تقصدين الزّرّ؟

227
00:12:03,190 --> 00:12:07,470
في العادة، كان ليوجد شيء ما يشبه
.كرة القدم النّوويّة

228
00:12:07,470 --> 00:12:08,740
ماذا؟ وما هذا؟

229
00:12:08,740 --> 00:12:11,870
.إنّه جهاز يسمح للرّئيس بإطلاق أسلحة نوويّة

230
00:12:11,870 --> 00:12:13,820
.يحمله حرّاسه معهم طوال الوقت

231
00:12:13,820 --> 00:12:15,190
أليس ذلك خطيرًا؟

232
00:12:15,190 --> 00:12:17,020
ماذا سيحدث إن سرقه أحد ما؟

233
00:12:17,020 --> 00:12:19,930
،هناك الكثير من الكتب والأفلام عن تلك الحالة

234
00:12:19,930 --> 00:12:21,700
.لكنّ ذلك لم يحدث أبدًا في الواقع

235
00:12:21,700 --> 00:12:22,310
...عفوًا

236
00:12:22,310 --> 00:12:26,320
هل تعتقدان أنّ ذلك الزّرّ
هو سبب تصرّف يوكا-تشان بغرابة؟

237
00:12:26,320 --> 00:12:27,310
ماذا تقصدين؟

238
00:12:27,310 --> 00:12:29,900
،إن تغيّر العالم بضغطة زرّ

239
00:12:29,900 --> 00:12:31,810
،فربّما إن ضغطناه ثانية وأطفأنا الشّبكة

240
00:12:31,810 --> 00:12:33,980
فسيعود كلّ من يوكا-تشان
.والعالم لسابق عهدهما

241
00:12:33,980 --> 00:12:35,370
!فهمت الآن

242
00:12:35,370 --> 00:12:37,690
!لذلك السّبب كانت تتصرّف بفظاعة

243
00:12:37,690 --> 00:12:39,840
مهلاً لحظة! هل الأمر كذلك بالفعل؟

244
00:12:39,840 --> 00:12:42,060
!ذلك هو التّفسير الوحيد

245
00:12:42,060 --> 00:12:44,350
.يا لبساطتك. إنّ النّاس يتغيّرون

246
00:12:44,350 --> 00:12:45,520
.لكنّ ذلك يستحقّ المحاولة

247
00:12:45,520 --> 00:12:46,890
.أريد إيجاد ذلك الزّرّ

248
00:12:48,220 --> 00:12:50,700
،إن كان الأمر يستحقّ المحاولة
.فسأقبل بتلك المجازفة

249
00:12:50,970 --> 00:12:52,690
!لا أمانع! أتّفق معك تمامًا

250
00:12:52,690 --> 00:12:53,440
...ولكن

251
00:12:53,440 --> 00:12:55,630
!ها هي ذي أكيرا واحتمالاتها وافتراضاتها

252
00:12:55,630 --> 00:12:56,510
!اسمعنني

253
00:12:56,510 --> 00:12:59,920
،من الجيّد أن نحاول العثور على الزّرّ
ولكن من أين نبدأ البحث؟

254
00:13:08,640 --> 00:13:09,730
ماذا؟

255
00:13:09,730 --> 00:13:11,220
الزّومبي؟

256
00:13:13,560 --> 00:13:14,980
!إنّها كوروكين

257
00:13:15,350 --> 00:13:16,650
ولكن لماذا؟

258
00:13:17,180 --> 00:13:18,660
.لم نلتق منذ مدّة

259
00:13:19,770 --> 00:13:23,480
بعد مغادرتكنّ، تغيّر الجوّ بشكل
.جذريّ في محطّة هويا

260
00:13:23,480 --> 00:13:26,960
لو بقينا هناك، لتعفّن الزّومبي ونما عليهم عفن

261
00:13:26,960 --> 00:13:29,060
.أو ربّما كانوا ليجفّوا ويتفتّتوا

262
00:13:29,060 --> 00:13:31,750
الزّومبي حسّاسون جدًّا إذًا؟
!لم أتوقّع ذلك

263
00:13:31,750 --> 00:13:34,000
لذلك تريدين أن تعملي معنا؟

264
00:13:34,480 --> 00:13:36,780
.تتجلّى قوّتنا في أعدادنا

265
00:13:36,780 --> 00:13:39,510
وأنتنّ لديكنّ العقل؟ كما أظنّ؟

266
00:13:39,510 --> 00:13:40,620
لماذا تبدين غير واثقة؟

267
00:13:40,620 --> 00:13:43,600
،سمعنا للتّوّ من ماكوتو-سينسي
،وهي العقل في فريقنا هذا

268
00:13:43,600 --> 00:13:47,770
أنّ الجواب لمشاكلنا قد يكمن
.في العثور على زرّ 7 جي

269
00:13:47,770 --> 00:13:49,570
ماذا تقصدين بالعقل في فريقنا؟

270
00:13:49,570 --> 00:13:51,440
.إنّ ذلك يجعلك ذات العضلات الغبيّة

271
00:13:51,440 --> 00:13:53,280
أين نجد ذلك الزّرّ؟

272
00:13:53,280 --> 00:13:54,360
.لا ندري

273
00:13:54,360 --> 00:13:57,810
لكنّه قويّ بما يكفي لتحويل العالم
.بأكمله إلى ما هو عليه الآن

274
00:13:57,810 --> 00:13:59,520
.لذلك يجدر أن يكون كبيرًا في الحجم

275
00:13:59,520 --> 00:14:01,740
مثل برميل السّاكي؟

276
00:14:01,740 --> 00:14:03,090
برميل السّاكي؟

277
00:14:03,090 --> 00:14:03,940
ماذا هنالك؟

278
00:14:03,940 --> 00:14:04,680
....لحظة

279
00:14:04,680 --> 00:14:07,220
...عندما كنّا نمرّ قرب مركز التّسوّق

280
00:14:09,970 --> 00:14:11,980
ماذا؟ ما الخطب؟

281
00:14:18,980 --> 00:14:22,620
أظهر الزّومبي اهتمامًا بشيء
.آخر غير الأدمغة والقرنبيط

282
00:14:22,940 --> 00:14:25,500
.يريد الزّومبي أن يعودوا بشرًا ثانية

283
00:14:25,500 --> 00:14:31,460
ربّما كانت تلك ردّة فعل للزّرّ
.الّذي يملك القدرة على تحقيق ذلك

284
00:14:31,890 --> 00:14:34,650
.هناك احتمال كبير أنّ ما رأيته هو ذلك الزّرّ

285
00:14:34,650 --> 00:14:36,880
.صحيح... لكن هناك احتمال ألاّ يكون أيضًا

286
00:14:36,880 --> 00:14:39,830
.مركز التّسوّق؟ لم أزره من قبل

287
00:14:39,830 --> 00:14:40,490
ماذا؟

288
00:14:40,490 --> 00:14:42,210
ما كانت المقولة؟
يجب أن تكون الحياة عصرّية"؟"

289
00:14:42,210 --> 00:14:43,880
و"أحبّ نفسك"؟

290
00:14:43,880 --> 00:14:46,730
أردت الذّهاب منذ أن رأيت تلك
.الشّعارات الإعلانيّة منذ وقت طويل

291
00:14:46,730 --> 00:14:47,880
ماذا؟ أنت توّاقة للذّهاب؟

292
00:14:47,880 --> 00:14:51,350
!سبق وأتينا كلّ هذه المسافة لإيكبوكورو
ما الضّرر من إلقاء نظرة؟

293
00:14:51,350 --> 00:14:54,630
تريدين الذّهاب لمركز التّسوّق
!لشراء أغراض فحسب

294
00:14:54,630 --> 00:14:57,820
!هذا مجرّد هدف ثانويّ
!الهدف الأساسيّ هو البحث عن الزّرّ

295
00:14:57,820 --> 00:14:58,490
!يا لك من كاذبة

296
00:14:58,490 --> 00:15:01,150
.أتوقّع من بونتارو ذاك أن يخفيه بالفعل

297
00:15:01,150 --> 00:15:02,820
.كان يتصرّف بتعالٍ وتعجرف

298
00:15:03,080 --> 00:15:04,890
بويزون بونتارو؟

299
00:15:04,890 --> 00:15:06,980
.لم أسمع إلاّ الإشاعات المشبوهة عنه

300
00:15:06,980 --> 00:15:09,940
.وصفه زنجيرو-سان بالحقير القذر أيضًا

301
00:15:09,940 --> 00:15:12,060
.قال أنّه لا يفكّر بأيّ شيء غير نفسه

302
00:15:12,640 --> 00:15:15,560
إنّه متورّط بحادثة 7 جي، صحيح؟

303
00:15:15,560 --> 00:15:18,450
.لكنّه لا يحاول إصلاح الأمر
.بل يحاول السّيطرة على الجميع

304
00:15:18,450 --> 00:15:22,350
من كان ليرغب في تحمّل
مسؤوليّة فوضى كبيرة كهذه؟

305
00:15:22,350 --> 00:15:25,150
ما مدى الفظاعة الّتي يجب أن يكون
!عليها حتّى لا يتحمّل المسؤوليّة؟

306
00:15:26,120 --> 00:15:28,820
.مفهوم، مثل الزّومبي. بشكل سيّئ

307
00:15:28,820 --> 00:15:29,400
ماذا؟

308
00:15:29,400 --> 00:15:32,960
لا بصيرة له ويقلق حيال نفسه
.في الحاضر فحسب

309
00:15:32,960 --> 00:15:34,490
.لا يندم على شيء ولا يفكّر في المستقبل

310
00:15:34,940 --> 00:15:36,220
ما الخطب؟

311
00:15:36,220 --> 00:15:39,120
.ما كنتُ لأقول... لا شيء

312
00:15:39,120 --> 00:15:40,860
هل نذهب إلى مركز التّسوّق؟

313
00:15:40,860 --> 00:15:41,740
!لنذهب، لنذهب

314
00:15:41,740 --> 00:15:43,590
ماذا عن يوكا-تشان؟

315
00:15:43,590 --> 00:15:44,920
...ربّما هي قضيّة خاسرة

316
00:15:44,920 --> 00:15:45,690
!ماذا؟

317
00:15:45,690 --> 00:15:47,010
!قضيّة خاسرة كيف؟

318
00:15:47,010 --> 00:15:48,440
...لقد تجاهلتنا بالفعل

319
00:15:48,440 --> 00:15:50,070
!ها قد بدأتِ ثانية

320
00:15:50,070 --> 00:15:51,560
.اسمعي يا شيزورو-تشان

321
00:15:51,560 --> 00:15:53,950
.هذا فعلاً ليس الوقت المناسب لذلك

322
00:15:53,950 --> 00:15:55,430
.إنّك تخيفينني يا ناديكو-تشان

323
00:15:55,430 --> 00:15:57,380
.أريد الذّهاب لرؤية يوكا-تشان

324
00:15:57,380 --> 00:15:59,190
!سأذهب حتّى إن لم تذهبي أنت

325
00:15:59,190 --> 00:16:00,790
!أريد رؤيتها أيضًا

326
00:16:00,790 --> 00:16:02,140
ألم تكوني ذاهبة للتّسوّق؟

327
00:16:02,140 --> 00:16:02,980
!كلاّ

328
00:16:02,980 --> 00:16:04,230
هل تستمعين لنا يا شيزورو-تشان؟

329
00:16:04,230 --> 00:16:05,980
وهل يهمّ ذلك؟

330
00:16:05,980 --> 00:16:08,200
.ستتكلّمين معها، سواء أردتِ ذلك أم لا

331
00:16:08,200 --> 00:16:10,560
!ماذا؟

332
00:16:19,460 --> 00:16:21,880
سيكون علينا البحث في كلّ زاوية
!وركن من هذا المكان

333
00:16:21,880 --> 00:16:23,080
لماذا هذه النّبرة المتعجرفة؟

334
00:16:23,080 --> 00:16:26,440
لم أعتقد أبدًا أنّه سيتسنّى لي
.قول "في كلّ زاوية وركن" في الواقع

335
00:16:26,440 --> 00:16:27,130
.هكذا إذًا

336
00:16:27,130 --> 00:16:28,360
!"مثل عبارة "يا خرابة البيوت

337
00:16:28,360 --> 00:16:30,500
."أو "اعتبرها هديّة وداع

338
00:16:30,500 --> 00:16:33,350
"أردتُ دائمًا أن أقول "هل أنت أعمى؟

339
00:16:33,350 --> 00:16:35,370
!أحسنت في المشاركة معنا يا كوروكين

340
00:16:35,370 --> 00:16:38,320
هناك الكثير من الجُمل الّتي
.لا تسمح لنا الفرص لقولها

341
00:16:38,320 --> 00:16:40,440
...لا تسمح لنا الفرص لقولها

342
00:16:41,510 --> 00:16:43,730
.عليك إخبارها يا شيزورو-تشان

343
00:16:44,810 --> 00:16:45,650
.نعم

344
00:16:53,110 --> 00:16:53,880
ماذا؟

345
00:16:53,880 --> 00:16:55,370
!ربّما وجدوه

346
00:17:00,110 --> 00:17:01,950
!أخفين هذه! بسرعة

347
00:17:02,210 --> 00:17:04,200
هل يمكنني المساعدة؟

348
00:17:04,200 --> 00:17:06,020
.هذه من أفضل مبيعاتنا

349
00:17:06,020 --> 00:17:07,130
.ستبدو رائعة عليك

350
00:17:07,130 --> 00:17:08,930
!كلاّ، لا أطيق هذا

351
00:17:08,930 --> 00:17:10,570
!ضغط الابتسام

352
00:17:10,940 --> 00:17:11,790
!هنالك الكثير منها

353
00:17:11,790 --> 00:17:14,800
ستطاردكما إن هربتما. هناك
!مخرج واحد فقط من هذا

354
00:17:15,380 --> 00:17:16,970
!أنا أتفرّج فحسب

355
00:17:21,220 --> 00:17:23,680
!فنّانون مشهورون عالميًّا

356
00:17:22,770 --> 00:17:24,430
!ادفعوا على أقساط سهلة

357
00:17:23,680 --> 00:17:25,910
...رُسمت بواسطة كنز حيّ

358
00:17:24,860 --> 00:17:26,930
!فرصة العمر

359
00:17:26,930 --> 00:17:27,650
!ابتعدي عن طريقي

360
00:17:27,650 --> 00:17:29,700
يمكنك دفع ثمن الأضرار، صحيح؟

361
00:17:29,700 --> 00:17:32,560
!من المستحيل أن ندفع أيّ شيء

362
00:17:32,930 --> 00:17:35,600
!لا تحاولي خداعنا لأخذ أموالنا

363
00:17:37,450 --> 00:17:39,350
!إنّ الزّومبي يتجاوبون مع شيء ما

364
00:17:39,350 --> 00:17:40,290
!أهو الزّرّ؟

365
00:17:40,290 --> 00:17:41,380
!ماذا قلت؟

366
00:17:41,380 --> 00:17:43,660
مجموعة مريبة في مركز التّسوّق؟

367
00:17:43,660 --> 00:17:46,290
.إنّ لجنة اليقظة في طريقها إلى هناك الآن

368
00:17:46,290 --> 00:17:48,420
.إنّهنّ يسعين خلف الزّرّ بالفعل

369
00:17:48,420 --> 00:17:50,690
مهلاً، كيف عرفن أين مكانه؟

370
00:17:51,500 --> 00:17:53,750
هل بيننا خائن ما؟

371
00:17:53,750 --> 00:17:55,890
.وأنا أقصد بذلك تسرّبًا في المعلومات

372
00:17:55,890 --> 00:17:57,250
!ذلك غير معقول

373
00:17:57,690 --> 00:17:59,300
.أتساءل بشأن ذلك

374
00:18:01,720 --> 00:18:03,180
تفهمون، صحيح؟

375
00:18:03,490 --> 00:18:05,120
ما عملك؟

376
00:18:05,120 --> 00:18:07,640
.حماية يوكا-ساما

377
00:18:09,300 --> 00:18:11,680
في تلك الحالة، تخلّص من أولئك الشّقيّات

378
00:18:11,680 --> 00:18:13,940
!وارم جثثهنّ بعيدًا حتّى زوشيغايا

379
00:18:13,940 --> 00:18:15,650
!واحم الزّرّ

380
00:18:15,650 --> 00:18:18,360
،إن وضعن أيديهنّ على الزّرّ
!لن يظلّ هذا العالم على حاله

381
00:18:18,360 --> 00:18:21,590
.سيبدأ النّاس أعمال شغب عنيفة وسنفقد السّيطرة

382
00:18:21,590 --> 00:18:25,580
إن حدث ذلك، لن تكون يوكا-ساما
.الغالية عليك في أمان

383
00:18:26,170 --> 00:18:29,520
!حماية الأميرة والزّرّ هما نفس الشّيء

384
00:18:29,520 --> 00:18:30,620
!إنّهما سيّان

385
00:18:30,620 --> 00:18:32,970
!لا تسمح أن يضعن أيديهنّ عليه

386
00:18:43,800 --> 00:18:45,360
!هناك شيء ما في البركة

387
00:18:45,360 --> 00:18:46,240
!الزّرّ

388
00:18:46,240 --> 00:18:48,180
لماذا يتجاوبون مع الزّرّ؟

389
00:18:48,180 --> 00:18:50,720
.إنّهم نِتاج التّغيّرات الّتي تسبّبت بها 7 جي

390
00:18:50,720 --> 00:18:54,450
ربّما يستجيبون لطاقتها أو يتوقون
.إلى العالم الّذي كنّا نعيش فيه سابقًا

391
00:18:54,450 --> 00:18:55,770
.في كلّ الأحوال، بإمكانهم الشّعور به

392
00:18:56,100 --> 00:18:58,210
علينا الضّغط على الزّرّ فحسب، صحيح؟

393
00:18:58,210 --> 00:18:59,240
.نعم

394
00:18:59,540 --> 00:19:00,270
!إنّهنّ هناك

395
00:19:00,270 --> 00:19:01,160
!ليس ثانية

396
00:19:01,160 --> 00:19:02,860
،سأتولّى أمر هؤلاء

397
00:19:02,860 --> 00:19:04,430
!تولّين أنتنّ أمر الزّرّ

398
00:19:03,760 --> 00:19:04,740
!سأساعدك

399
00:19:04,740 --> 00:19:06,010
!عملنا هو الحصول على الزّرّ

400
00:19:14,120 --> 00:19:16,950
!لا يستطيع الزّومبي دخول الماء
!سيتشبّعون بالماء

401
00:19:25,140 --> 00:19:26,010
من أنت؟

402
00:19:26,010 --> 00:19:27,340
.اسمي بوتشي

403
00:19:27,630 --> 00:19:28,630
بوتشي؟

404
00:19:29,120 --> 00:19:29,990
...أنت لست بوتشي

405
00:19:34,750 --> 00:19:35,450
!كيف؟

406
00:19:35,450 --> 00:19:37,110
.ينتابني نفس الشّعور

407
00:19:37,110 --> 00:19:38,050
!ماذا؟

408
00:19:38,050 --> 00:19:39,400
.سأحمي يوكا-ساما

409
00:19:52,010 --> 00:19:53,330
...هل يوكا

410
00:19:53,330 --> 00:19:56,080
!هل تحبّ يوكا الوضع الحاليّ؟

411
00:19:56,080 --> 00:19:58,350
.إنّها تكرّس نفسها للدّراسة كلّ يوم

412
00:19:58,350 --> 00:19:59,350
...ولكن

413
00:19:59,670 --> 00:20:01,670
!يصفها النّاس بالسّاحرة وما إلى ذلك

414
00:20:01,670 --> 00:20:04,750
ذلك ليس أمرًا على يوكا-ساما
.أن تشغل بالها به

415
00:20:10,980 --> 00:20:13,480
.لا يهمّ ما يقوله أيّ أحد آخر عنها

416
00:20:13,480 --> 00:20:16,320
.يوكا-ساما مثاليّة تمامًا كما هي الآن

417
00:20:24,290 --> 00:20:26,250
!ريمي-تشان! شيزورو-تشان

418
00:20:29,880 --> 00:20:31,970
!حصلنا على الزّرّ

419
00:20:31,970 --> 00:20:32,990
!اضغطاه

420
00:20:32,990 --> 00:20:34,600
!بسرعة

421
00:20:48,020 --> 00:20:50,510
هل توقّفت 7 جي؟

422
00:20:57,770 --> 00:20:58,840
!لا فائدة

423
00:20:58,840 --> 00:20:59,570
!ولكن لماذا؟

424
00:21:00,140 --> 00:21:01,520
!مستحيل

425
00:21:04,000 --> 00:21:06,090
!زومبي 35! 72

426
00:21:06,090 --> 00:21:06,970
!ابتعدا

427
00:21:06,970 --> 00:21:08,650
!أنتما في خطر

428
00:21:11,400 --> 00:21:12,710
!شيزورو-تشان

429
00:21:13,720 --> 00:21:14,830
!كلاّ يا بوتشي-سان

430
00:21:16,170 --> 00:21:17,360
...بوتشي-سان

431
00:21:17,900 --> 00:21:20,080
.لا يمكنني قتالك

432
00:21:45,330 --> 00:21:46,080
ماذا؟

433
00:21:50,560 --> 00:21:51,850
!يوكا-تشان

434
00:21:52,790 --> 00:21:54,210
!إنّها يوكا-تشان

435
00:21:55,060 --> 00:21:56,560
.أغبياء

436
00:21:56,560 --> 00:21:58,160
.إيكبوكورو سالمة

437
00:21:59,020 --> 00:22:00,670
.ذلك ما دامت تملك أميرتها بالطّبع