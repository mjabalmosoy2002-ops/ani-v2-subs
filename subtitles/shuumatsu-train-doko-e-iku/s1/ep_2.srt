1
00:00:00,550 --> 00:00:03,360
حسنًا، لماذا لا تعرّفينا على نفسك؟

2
00:02:11,780 --> 00:02:13,650
!كم هذا رائع

3
00:02:14,230 --> 00:02:16,000
!انظرن لكلّ هذه المياه

4
00:02:16,000 --> 00:02:17,480
أهذا هو نهر كوما؟

5
00:02:17,480 --> 00:02:20,550
!إذًا فهكذا يبدو العالم خارج أغانو الآن

6
00:02:20,550 --> 00:02:22,180
لا تبالين بالمرّة، صحيح؟

7
00:02:22,180 --> 00:02:24,740
!على مهلك
.كم تحبّين إفساد متعة الآخرين يا أكيرا

8
00:02:25,060 --> 00:02:26,960
.أعلم أنّك متحمّسة في أعماقك

9
00:02:26,960 --> 00:02:29,090
!عليك إظهار مشاعرك أكثر من هذا

10
00:02:29,090 --> 00:02:32,340
كيف يُعقل أن أكون متحمّسة؟
.لقد غادرنا بدون إذن

11
00:02:32,340 --> 00:02:34,260
وما الغاية من حركات يديك؟

12
00:02:34,540 --> 00:02:35,730
.إيّاك

13
00:02:35,730 --> 00:02:37,030
!لا تقتربي

14
00:02:37,030 --> 00:02:39,170
!دغدغة، دغدغة، دغدغة

15
00:02:39,430 --> 00:02:41,830
.يا إلهي منكما

16
00:02:45,580 --> 00:02:48,270
متى سنصل إلى إيكبوكورو؟
في الغد مثلاً؟

17
00:02:48,270 --> 00:02:50,620
إنّها في مكان حتّى قافلة النّمر
.الأسود لا يمكنها الذّهاب إليه

18
00:02:50,620 --> 00:02:52,220
.مستحيل أن نصل غدًا

19
00:02:52,220 --> 00:02:52,920
ماذا؟

20
00:02:52,920 --> 00:02:55,460
.لكنّ الأمر تطلّب ساعة تقريبًا في السّابق

21
00:02:55,460 --> 00:02:57,750
،أعلم أنّ كلّ المسافات قد تمدّدت الآن

22
00:02:57,750 --> 00:02:59,430
لكن لا يُعقل أنّها امتدّدت لذلك الحدّ، صحيح؟

23
00:02:59,430 --> 00:03:00,680
.إنّك متفائلة جدًّا

24
00:03:00,680 --> 00:03:03,180
من الممكن تمامًا أنّه إذا لم نأخذ
،هذا الأمر على محمل الجدّ

25
00:03:03,180 --> 00:03:05,900
فقد نقع ضحيّة للعوامل الجوّيّة
.قبل الوصول إلى إيكبوكورو

26
00:03:05,900 --> 00:03:06,910
.على مهلك

27
00:03:06,910 --> 00:03:09,380
،في بعض الأحيان
،يجد المرء أنّه بمجرّد البدء بالفعل

28
00:03:09,380 --> 00:03:11,400
.فإنّ الأمر لا يستغرق سوى القليل من الوقت

29
00:03:11,400 --> 00:03:13,120
قد لا نصل غدًا، ولكن ربّما بعد ثلاثة أيّام؟

30
00:03:13,120 --> 00:03:14,610
.لن يحدث ذلك

31
00:03:14,610 --> 00:03:17,810
.سيأخذ الأمر شهرًا على الأقلّ
!وربّما أكثر

32
00:03:17,810 --> 00:03:18,700
!أسبوعان

33
00:03:18,700 --> 00:03:19,500
!ثلاثة أشهر

34
00:03:19,500 --> 00:03:20,320
.صحيح

35
00:03:20,320 --> 00:03:22,540
.واثقة أنّ شيزورو-تشان فكّرت في كلّ هذا

36
00:03:22,540 --> 00:03:23,600
.لنسألها

37
00:03:23,600 --> 00:03:26,150
أخبرينا، كم ستدوم الرّحلة؟ –
!لا تشتّتا انتباهي! هذا خطير –

38
00:03:26,440 --> 00:03:30,140
.لا بأس، تعلّمت شيزورو-تشان القيادة حديثًا

39
00:03:30,140 --> 00:03:30,650
أليس كذلك؟

40
00:03:35,310 --> 00:03:37,850
شيزورو-تشان، ألا نسير بسرعة كبيرة؟

41
00:03:41,340 --> 00:03:43,080
.أعتقد بالفعل أنّنا نسير بسرعة كبيرة جدًّا

42
00:03:43,080 --> 00:03:45,190
هلاّ قلّلت السّرعة رجاءً؟

43
00:03:45,190 --> 00:03:46,370
.أنا أحاول

44
00:03:46,370 --> 00:03:46,790
ماذا؟

45
00:03:47,100 --> 00:03:49,650
.أنا أحاول، لكنّه لا يُبطئ

46
00:03:49,650 --> 00:03:51,410
!ماذا؟

47
00:03:52,790 --> 00:03:53,590
!منعطف

48
00:03:53,590 --> 00:03:55,170
!منعطف، منعطف

49
00:03:55,740 --> 00:03:57,600
!منعطف آخر

50
00:03:58,620 --> 00:04:00,670
!منعطف، منعطف، منعطف

51
00:04:02,720 --> 00:04:03,680
!منعطف حادّ

52
00:04:04,010 --> 00:04:07,740
!منعطف

53
00:04:16,680 --> 00:04:18,510
.ظننتُ أنّني سأموت

54
00:04:18,510 --> 00:04:20,320
صرت أعرف الآن ما المقصود
."بمفهوم "تذكرة الموت

55
00:04:20,320 --> 00:04:22,900
هل سنكون بخير يا شيزورو-تشان؟

56
00:04:22,900 --> 00:04:23,780
.أعتقد ذلك

57
00:04:24,180 --> 00:04:28,660
بدا هذا أسهل بكثير عندما كان
.يعلّمني زنجيرو-سان القيادة

58
00:04:29,000 --> 00:04:30,480
زنجيرو-سان؟

59
00:04:30,480 --> 00:04:33,750
.بإمكانه العودة لطبيعته
.لكن فقط لخمس دقائق في اليوم

60
00:04:33,750 --> 00:04:34,530
.لذلك طلبتُ منه تعليمي

61
00:04:34,530 --> 00:04:35,380
ماذا؟

62
00:04:35,380 --> 00:04:36,140
.ذلك مستحيل

63
00:04:36,140 --> 00:04:38,320
.أقسم أنّها الحقيقة
.كما أنّه صار رجلاً جذّابًا أيضًا

64
00:04:38,320 --> 00:04:39,170
!جذّابًا؟

65
00:04:39,170 --> 00:04:41,110
.الكذب خُلق سيّئ يا شيزورو-تشان

66
00:04:41,110 --> 00:04:45,010
!أقسم أنّها الحقيقة! أنا جادّة
كيف تفسّرن تعلّمي لقيادة القطار؟

67
00:04:45,010 --> 00:04:48,170
تعرفن أنّ زنجيرو-سان كان من نخبة
عمّال السّكّة الحديديّة، صحيح؟

68
00:04:48,170 --> 00:04:50,230
.ظننتُ أنّ ذلك كان مجرّد إشاعة

69
00:04:50,230 --> 00:04:51,220
كانت حقيقة إذًا؟

70
00:04:51,220 --> 00:04:53,570
ماذا قصدت بقولك "لخمس دقائق فقط"؟

71
00:04:53,570 --> 00:04:55,600
تعرفين أنّ عمّال القطارات يرتدون قبّعات، صحيح؟

72
00:04:55,600 --> 00:04:57,110
.عاد لطبيعته عندما ألبسته إيّاها

73
00:04:57,110 --> 00:04:58,940
.استمعي لي يا شيزورو-تشان

74
00:04:58,940 --> 00:05:00,880
.الكذب خُلق سيّئ بالفعل

75
00:05:00,880 --> 00:05:03,070
!أقسم، أقسم! أقسم بحياتي

76
00:05:03,070 --> 00:05:05,060
!وهكذا تعلّمت قيادة هذا الشّيء

77
00:05:05,060 --> 00:05:06,250
!ثقي بي

78
00:05:06,250 --> 00:05:09,540
في الحقيقة، أهذا بالفعل
الطّريق الصّحيح لإيكبوكورو؟

79
00:05:09,540 --> 00:05:11,180
نحن لا نسير في الطّريق الخطأ، صحيح؟

80
00:05:11,180 --> 00:05:11,690
ماذا؟

81
00:05:12,460 --> 00:05:14,570
تشيتشيبو من هناك، صحيح؟

82
00:05:14,570 --> 00:05:16,600
.هذا يعني أنّ إيكبوكورو من هنا

83
00:05:16,600 --> 00:05:18,170
.هذا منطقيّ

84
00:05:18,170 --> 00:05:19,070
.منطقيّ

85
00:05:19,070 --> 00:05:23,070
أتعلمن أنّ هنالك مكتشفي عارضات
وكبار خدم في إيكبوكورو؟

86
00:05:23,070 --> 00:05:25,670
.إضافة إلى المحقّقين والقتلة

87
00:05:25,670 --> 00:05:29,000
إن لم تنتبهن، فستُطعَنّ
!أو تُدسنَ أو يُحتال عليكنّ

88
00:05:29,000 --> 00:05:31,390
!إنّها مثيرة، ولكنّها أنيقة

89
00:05:31,390 --> 00:05:33,390
.يا لها من نظرة مشوّهة

90
00:05:33,390 --> 00:05:35,090
.يجب الحرص ألاّ يُنصب علينا أيضًا

91
00:05:35,090 --> 00:05:35,580
ماذا؟

92
00:05:35,580 --> 00:05:36,590
ألديك مال يا ريمي؟

93
00:05:36,590 --> 00:05:37,860
!بالتّأكيد

94
00:05:37,860 --> 00:05:39,160
.لقد كنتُ أدّخره

95
00:05:39,160 --> 00:05:39,860
!كلاّ

96
00:05:39,860 --> 00:05:41,530
ممتاز! كم لديك؟

97
00:05:41,530 --> 00:05:42,940
!حصّالتي

98
00:05:42,940 --> 00:05:43,720
حوالي 20 ألف ينّ؟

99
00:05:43,720 --> 00:05:45,960
!كلاّ، حصّالتي

100
00:05:45,960 --> 00:05:47,400
ما الخطب يا ريمي-تشان؟ –
...إنّ حصّالتي في المنزل –

101
00:05:47,410 --> 00:05:49,060
.لقد نسيتها في المنزل –
...إنّ حصّالتي في المنزل –

102
00:05:49,060 --> 00:05:50,830
.كلّ ما لديّ هو 250 ينّ

103
00:05:50,830 --> 00:05:51,530
!هذا سيّئ

104
00:05:51,530 --> 00:05:54,220
ماذا عنك؟ كم لديك يا أكيرا؟

105
00:05:54,220 --> 00:05:56,580
.لن تحصلي على أيّ معلومات خاصّة منّي

106
00:05:56,580 --> 00:05:58,030
!أعيريني بعض المال

107
00:05:58,030 --> 00:05:59,880
.أنا لا أعير المال

108
00:05:59,880 --> 00:06:00,870
!بخيلة

109
00:06:00,870 --> 00:06:03,500
،لديّ الكثير من المال
.لذلك سأعيرك بعضه

110
00:06:03,500 --> 00:06:05,290
!فعلاً؟ أنت منقذتي يا شيزورو-تشان

111
00:06:05,290 --> 00:06:06,220
كم المبلغ الّذي نتحدّث عنه؟

112
00:06:06,220 --> 00:06:09,190
،لديّ حوالي 3000 ينّ أو أكثر
.لذلك سأعيرك 1000 ينّ تقريبًا

113
00:06:09,190 --> 00:06:09,950
!هذا لا شيء

114
00:06:09,950 --> 00:06:11,090
!كلاّ! هذا مبلغ كبير

115
00:06:11,090 --> 00:06:12,660
ما الّذي يقال في أوقات كهذه؟

116
00:06:12,660 --> 00:06:14,690
،إن لم يكن لديكم خبز"
"فدعهم يأكلون الكعك؟

117
00:06:14,690 --> 00:06:16,500
.أظنّك مخطئة قليلاً

118
00:06:16,500 --> 00:06:18,300
".لكلّ شيء ثمن"

119
00:06:18,300 --> 00:06:19,810
.هذا صحيح. شيء من هذا القبيل

120
00:06:19,810 --> 00:06:20,940
.بل لا شيء من ذلك القبيل

121
00:06:20,940 --> 00:06:22,700
‫1250 ينّ؟

122
00:06:22,700 --> 00:06:25,330
ماذا قد أشتري بذلك؟ –
.أعتقد أنّ الأولويّة للطّعام –

123
00:06:25,330 --> 00:06:27,450
أريد شرب شيء يُدعى تابيوكا مثلاً؟

124
00:06:27,450 --> 00:06:30,580
،إضافة لشيء يُدعى شرشورولي
...وخبز محمّص

125
00:06:30,580 --> 00:06:32,380
.قصدت أطعمة عاديّة أكثر

126
00:06:32,380 --> 00:06:34,030
.مثل المعلّبات أو البسكويت الصّلب

127
00:06:34,030 --> 00:06:35,540
.ماذا؟ ذلك مملّ

128
00:06:35,540 --> 00:06:37,080
.احلمي أحلامًا أكبر يا ناديكو-تشان

129
00:06:37,080 --> 00:06:39,490
.أقصد أنّنا لم نحضر معنا شيئًا أيضًا

130
00:06:39,490 --> 00:06:40,150
ماذا؟

131
00:06:40,150 --> 00:06:42,050
.أتينا مباشرة بعد المدرسة

132
00:06:42,800 --> 00:06:44,340
.معك حقّ

133
00:06:44,340 --> 00:06:46,060
.ليس لدينا أيّ شيء لنأكله

134
00:06:46,060 --> 00:06:47,700
.أحضرتُ بعض الطّعام معي

135
00:06:47,700 --> 00:06:48,810
!فعلاً؟ ممتاز

136
00:06:48,810 --> 00:06:49,690
لماذا؟

137
00:06:49,690 --> 00:06:51,660
.حتّى أنا أعرف التّجهيز لرحلة ولو قليلاً

138
00:06:51,660 --> 00:06:52,590
أيمكننا أن نرى؟

139
00:06:52,590 --> 00:06:53,440
.نعم، تفضّلن

140
00:06:53,440 --> 00:06:57,460
حزم ضروريّات النّجاة يعني الأشياء
...المهمّة فحسب، إضافة إلى

141
00:06:57,460 --> 00:06:59,480
ما هذه؟ أداة تأمّل؟

142
00:06:59,480 --> 00:07:00,700
ألا تعرفين ما هي؟

143
00:07:00,700 --> 00:07:02,330
.إنّها لقياس حصص الباستا

144
00:07:02,330 --> 00:07:03,990
وأين هي الباستا؟

145
00:07:03,990 --> 00:07:05,850
!"هذه سو-تشان من "نيري ألي

146
00:07:05,850 --> 00:07:06,600
!معك حقّ

147
00:07:06,600 --> 00:07:08,430
لماذا لديك هذا يا شيزورو-تشان؟

148
00:07:08,430 --> 00:07:10,390
.وجدته في منزلي –
.دعيني أرى يا ناديكو-تشان –

149
00:07:10,390 --> 00:07:11,620
أيمكنني أخذه؟

150
00:07:11,620 --> 00:07:12,260
—أكيد، لا أمانـ

151
00:07:12,260 --> 00:07:12,850
.أنا أمانع

152
00:07:12,850 --> 00:07:15,560
.لقد أعطته لي –
!كفّا عن القتال! تصرّفا بلطف –

153
00:07:15,830 --> 00:07:19,060
شيزورو-تشان، كان هذا
.كلّ الطّعام الّذي أحضرتِه

154
00:07:19,060 --> 00:07:19,840
ماذا؟

155
00:07:20,180 --> 00:07:22,620
.واثقة أنّني أحضرت أكثر من ذلك

156
00:07:22,620 --> 00:07:23,580
.إضافة إلى هذه

157
00:07:23,580 --> 00:07:25,050
القرع المرّ؟

158
00:07:25,050 --> 00:07:26,850
،أعلم أنّه من اختصاص أغانو

159
00:07:26,850 --> 00:07:29,420
.لكنّي لا أحبّه كثيرًا

160
00:07:30,230 --> 00:07:32,240
!ما خطبي؟

161
00:07:32,240 --> 00:07:34,710
!تحمّست كثيرًا! أو ربّما ارتبكتُ قليلاً

162
00:07:34,710 --> 00:07:36,450
.صحيح، يحدث لك هذا أحيانًا

163
00:07:36,450 --> 00:07:38,140
.أعتقد أنّه يمكن وصف هذا بالرّؤية النّفقيّة

164
00:07:38,140 --> 00:07:40,000
.وحدث ذلك في أسوأ وقت ممكن

165
00:07:40,000 --> 00:07:42,020
.ربّما كان عليك تحضير قائمة

166
00:07:42,870 --> 00:07:43,990
...عفوًا

167
00:07:44,320 --> 00:07:47,440
.هذا كلّ شيء معنا

168
00:07:48,970 --> 00:07:50,520
أتدرين ما المشكلة الحقيقيّة؟

169
00:07:50,520 --> 00:07:51,580
المشكلة الحقيقيّة؟

170
00:07:51,980 --> 00:07:53,370
.الملابس التّحتيّة

171
00:07:53,370 --> 00:07:54,290
فعلاً؟

172
00:07:54,290 --> 00:07:55,120
...الملابس التّحتيّة

173
00:07:55,120 --> 00:07:57,780
!لا يجدر على الفتيات قول... ذلك

174
00:07:57,780 --> 00:07:58,610
.الملابس الدّاخليّة إذًا

175
00:07:58,610 --> 00:07:59,440
!هذا ليس أفضل

176
00:07:59,440 --> 00:08:03,090
إنّنا لا نعرف بالفعل كم لدينا من
.الوقت حتّى نصل إلى إيكبوكورو

177
00:08:03,090 --> 00:08:04,570
إذًا فنحن عالقات بهذه الملابس؟

178
00:08:04,570 --> 00:08:07,910
،قيل أنّ إيزابيلاّ ملكة قشتالة
،أقسمت على الصّلاة من أجل النّصر

179
00:08:07,910 --> 00:08:10,580
.ولم تغيّر ملابسها الدّاخليّة لتسعة أشهر

180
00:08:10,580 --> 00:08:13,160
هل تعتقدن أنّنا سنجد يوكا
إن لم أغيّر ملابسي الدّاخليّة؟

181
00:08:13,160 --> 00:08:14,800
!تمالكي نفسك يا شيزورو-تشان

182
00:08:14,800 --> 00:08:16,040
.ماذا؟ حسنًا

183
00:08:16,040 --> 00:08:18,540
بإمكاننا شراء بعضها عندما
.نصل إلى هيغاشي-أغانو

184
00:08:18,540 --> 00:08:20,840
.سيكون علينا تخزين الطّعام أيضًا

185
00:08:20,840 --> 00:08:22,040
.طعام يدوم طويلاً

186
00:08:22,040 --> 00:08:23,440
.أنا جائعة

187
00:08:23,440 --> 00:08:23,720
!آلمتني

188
00:08:23,720 --> 00:08:24,950
أتريدين الموت؟

189
00:08:24,950 --> 00:08:28,000
إنّ البدينين الجائعين يموتون
.أوّلاً دائمًا في أفلام البقاء والرّعب

190
00:08:28,000 --> 00:08:28,820
!لستُ بدينة

191
00:08:28,820 --> 00:08:31,480
.لننتظر بعض الشّيء. حاليًّا على الأقلّ

192
00:08:31,480 --> 00:08:33,870
...ننتظر؟ أنا لا أجيد ذلك

193
00:08:34,720 --> 00:08:37,700
أراهن أنّك كنت ستقولين
."لا تجيد ريمي ذلك"

194
00:08:37,700 --> 00:08:40,970
.لكنّك سبقتني لذلك
.ما عدتُ أريد قول ذلك الآن

195
00:08:40,970 --> 00:08:41,710
أأنت جادّة؟

196
00:08:41,710 --> 00:08:42,910
.اهدآ رجاءً

197
00:08:50,040 --> 00:08:52,340
هل وصلنا إلى إيكبوكورو؟

198
00:08:52,340 --> 00:08:54,150
هل ستواصلين طرح ذلك السّؤال؟

199
00:08:54,150 --> 00:08:56,370
هل من مشكلة؟
.يراودني الفضول فحسب

200
00:08:56,370 --> 00:08:57,900
هل أنت غبيّة أم ماذا؟

201
00:08:59,090 --> 00:09:02,510
.إنّ تصرّفك بالتّفوّق ذاك مشكلة حقيقيّة

202
00:09:02,510 --> 00:09:04,490
!أكيرا البكّاءة

203
00:09:04,490 --> 00:09:07,670
ربّما كنتُ بكّاءة، لكنّ ذلك
!تغيّر قبل عشر سنوات

204
00:09:07,670 --> 00:09:08,270
!لا يهمّ

205
00:09:08,270 --> 00:09:09,810
!ريمي الفاشلة في الدّراسة

206
00:09:09,810 --> 00:09:12,640
حصلتُ على صفر مرّة واحدة
!وكان امتحانًا تجريبيًّا

207
00:09:12,640 --> 00:09:14,520
!يكفي، توقّفا كلاكما

208
00:09:14,520 --> 00:09:16,990
،إن كنت تكرهينني بشدّة هكذا
!كان عليك البقاء في أغانو

209
00:09:16,990 --> 00:09:18,260
!لم أقل أنّني أكرهك

210
00:09:18,260 --> 00:09:19,700
!فلا تُقوّليني كلامًا لم أقله –
.أكيرا-تشان. ريمي-تشان –

211
00:09:19,700 --> 00:09:21,770
!اخترتِ ركوب هذا القطار أيضًا –
.أكيرا-تشان. ريمي-تشان –

212
00:09:21,770 --> 00:09:24,620
ما كنتُ لأصعد لو لم تصعدا
!أنت وناديكو-تشان

213
00:09:24,620 --> 00:09:27,420
.جرفتنا اللّحظة حينها فحسب

214
00:09:27,420 --> 00:09:28,610
.حدث ذلك معنا جميعًا

215
00:09:28,610 --> 00:09:30,510
.تعلمن أنّكنّ لم تكنّ مضطرّات للقدوم

216
00:09:33,640 --> 00:09:36,300
.كنتُ أنوي الذّهاب وحدي من البداية

217
00:09:38,250 --> 00:09:40,370
...شيزورو-تشان، أنت دائمًا ما

218
00:09:44,550 --> 00:09:46,070
...القرع المرّ

219
00:09:46,070 --> 00:09:48,660
هل أتخيّل أم أنّه ينمو أسرع من المعتاد؟

220
00:09:48,990 --> 00:09:51,060
.كما أنّ هنالك ضبابًا أيضًا

221
00:09:51,060 --> 00:09:52,510
أين نحن؟

222
00:09:52,510 --> 00:09:55,040
لم نتجاوز هيغاشي-أغانو بعد، صحيح؟

223
00:10:05,750 --> 00:10:07,750
ريمي، لديك نظر حادّ، صحيح؟

224
00:10:07,750 --> 00:10:09,350
هل ترين أيّ شيء في الخارج؟

225
00:10:09,350 --> 00:10:10,930
ماذا؟ هل تحاولين إخافتي؟

226
00:10:10,930 --> 00:10:12,120
في الخارج؟

227
00:10:12,620 --> 00:10:15,110
...لا أرى أيّ شيء بالفعل

228
00:10:15,110 --> 00:10:15,590
ماذا؟

229
00:10:16,040 --> 00:10:17,000
ما ذلك؟

230
00:10:17,000 --> 00:10:17,810
!ماذا؟

231
00:10:18,120 --> 00:10:19,250
.هناك شيء قادم نحونا

232
00:10:19,250 --> 00:10:20,580
ماذا تقصدين بـ"شيء"؟

233
00:10:20,580 --> 00:10:21,590
...ذلك

234
00:10:21,590 --> 00:10:22,610
!إنّه كوماسّي

235
00:10:22,610 --> 00:10:23,560
كوماسّي؟

236
00:10:23,560 --> 00:10:27,150
البليزوصور الّذي قيل أنّه يعيش
!في نهر كوما حتّى يومنا هذا

237
00:10:31,340 --> 00:10:32,100
.مهلاً

238
00:10:32,610 --> 00:10:33,980
.إنّه كوماسّي

239
00:10:36,250 --> 00:10:37,940
...إنّه كوماسّي

240
00:10:48,980 --> 00:10:51,370
أهذا قطار؟

241
00:10:53,230 --> 00:10:55,710
من تكنّ يا فتيات؟

242
00:10:55,710 --> 00:10:56,710
!انتبهي

243
00:10:56,710 --> 00:10:58,580
!لا بدّ أنّه قاتل أتى إلى هنا ليقتلنا

244
00:10:58,580 --> 00:10:59,470
!بالفعل

245
00:10:59,470 --> 00:11:03,100
يلقّبونني بأشرس قاتل متسلسل
...في نهر كوما بأكمله

246
00:11:03,100 --> 00:11:04,690
!كان ذلك فظًّا للغاية

247
00:11:08,510 --> 00:11:10,900
عفوًا، من تكون؟

248
00:11:10,900 --> 00:11:12,880
!اسمي ليس مهمًّا الآن

249
00:11:15,270 --> 00:11:18,530
...في الحقيقة... أنا

250
00:11:18,530 --> 00:11:22,860
،كنتُ أسافر عبر نهر كوما
.وأدوّن ملاحظات وأجري أبحاثًا

251
00:11:22,860 --> 00:11:26,060
،لم أرَ أيّ شخص منذ مدّة
.لذلك فقد فاجأتنّني كثيرًا

252
00:11:26,060 --> 00:11:28,270
على أيّ حال، ماذا تفعلن هنا؟

253
00:11:28,270 --> 00:11:31,350
.عفوًا، إنّنا في طريقنا إلى إيكبوكورو

254
00:11:31,350 --> 00:11:33,470
.ماذا؟ إلى إيكبوكورو؟ هذا ممتاز

255
00:11:33,470 --> 00:11:36,540
.أنا من إيكبوكورو بنفسي
—لذلك أقدّر شجاعـ

256
00:11:36,540 --> 00:11:37,280
!أتقول الحقيقة؟

257
00:11:37,500 --> 00:11:39,610
!إيكبوكورو؟ هذا مذهل

258
00:11:39,610 --> 00:11:41,710
.لا، هذا ليس الأمر المهمّ

259
00:11:41,710 --> 00:11:44,390
!لم أقابل أيّ أحد من إيكبوكورو من قبل

260
00:11:44,390 --> 00:11:45,640
فعلاً؟

261
00:11:45,640 --> 00:11:48,200
هل تعرف سيبو؟ وبوتو؟
وحديقة ناكا-إيكبوكورو؟

262
00:11:48,200 --> 00:11:49,710
إيكباس؟ أنيميت؟

263
00:11:49,710 --> 00:11:51,560
جونكودو؟ سانسيدو؟

264
00:11:51,560 --> 00:11:52,570
!وشراب التّابيوكا

265
00:11:52,570 --> 00:11:54,150
ما هي المقاهي الأكثر شعبيّة الآن؟

266
00:11:54,350 --> 00:11:55,470
.لا أدري

267
00:11:55,470 --> 00:11:56,360
!لا تدري؟

268
00:11:56,360 --> 00:11:57,110
.لا يعرف شيئًا إذًا

269
00:11:58,210 --> 00:11:59,430
!مهلاً

270
00:11:59,430 --> 00:12:02,760
.ربّما هناك أمر واحد يمكنني قوله بالتّأكيد

271
00:12:02,760 --> 00:12:04,060
فعلاً؟ وما هو؟

272
00:12:04,320 --> 00:12:06,490
،بعد حادثة 7 جي

273
00:12:06,490 --> 00:12:10,350
اختفى العالم بأسره، فيما عدا كلّ
!شيء على خطّ سيبو إيكبوكورو

274
00:12:10,350 --> 00:12:11,010
!ماذا؟

275
00:12:11,010 --> 00:12:14,370
.أو هذا ما أفترضه، ربّما على سبيل الاحتمال

276
00:12:14,370 --> 00:12:16,840
افتراض، ربّما، احتمال؟

277
00:12:16,840 --> 00:12:17,820
!أيّها أصحّ؟

278
00:12:17,820 --> 00:12:20,630
،الفطريّات في الأعلى عند البرج الشّرقيّ

279
00:12:20,630 --> 00:12:22,690
.تتآمر بوقاحة لفرض سيطرتها

280
00:12:22,690 --> 00:12:24,170
،وأبعد من الشّرق

281
00:12:24,170 --> 00:12:28,630
فإنّ من يعيشون في تناغم مع الماعز غير أوفياء
!لأسمائهم، يندفعون بتهوّر مثل الخنازير البرّيّة

282
00:12:28,630 --> 00:12:30,590
ما معنى ذلك؟ ما الّذي يقوله؟

283
00:12:30,590 --> 00:12:31,420
.أعرف ما هو هذا

284
00:12:31,420 --> 00:12:33,320
.تقليد رديء لمونولوغ من المسرح العبثيّ

285
00:12:33,320 --> 00:12:34,240
.فهمت

286
00:12:34,240 --> 00:12:36,500
ألهذا السّبب يبدو مبالغًا فيه بشدّة؟

287
00:12:36,500 --> 00:12:37,740
.علينا مواصلة الطّريق

288
00:12:37,740 --> 00:12:38,330
ماذا؟

289
00:12:38,330 --> 00:12:40,250
!مهلاً، انتظرن! مهلاً، رجاءً

290
00:12:40,250 --> 00:12:44,400
ما أقصده هو أنّي ما كنت لأحاول الذّهاب
!صوب إيكبوكورو لو كنت مكانكنّ

291
00:12:44,400 --> 00:12:45,390
لِمَ لا؟

292
00:12:45,390 --> 00:12:49,870
سمعتُ أنّ الوضعَ من المفترضِ أنّه سيّئ
!بشكل فظيع ورهيب ولا يصدّق هناك

293
00:12:49,870 --> 00:12:51,320
.على سبيل الاحتمال

294
00:12:51,320 --> 00:12:52,340
.نعم

295
00:12:52,790 --> 00:12:53,660
.حسنًا، لنذهب

296
00:12:53,660 --> 00:12:54,630
!مهلاً

297
00:12:55,220 --> 00:12:57,740
،بما أنّكنّ أتيتنّ كلّ هذه المسافة
!فقدّمن شيئًا ما لي

298
00:12:57,740 --> 00:12:59,840
!رجاءً

299
00:13:00,810 --> 00:13:02,800
!سأقدّم لكنّ شيئًا جيّدًا! جيّدًا جدًّا

300
00:13:02,800 --> 00:13:03,670
!لنتبادل

301
00:13:03,670 --> 00:13:04,670
شيئًا جيّدًا؟

302
00:13:04,670 --> 00:13:06,640
.رسمتُ هذه الخريطة بنفسي

303
00:13:06,640 --> 00:13:08,850
.ستساعدكنّ كثيرًا. أنصح بها جدًّا

304
00:13:08,850 --> 00:13:10,350
.حسنًا، شكرًا لك

305
00:13:10,350 --> 00:13:11,560
.لديّ نصيحة أيضًا

306
00:13:11,560 --> 00:13:13,080
.لا تصدّقي أيّ شيء تسمعينه

307
00:13:13,080 --> 00:13:13,800
ماذا؟

308
00:13:13,800 --> 00:13:16,810
صدّقي الأشياء الّتي يمكنك
.التّأكّد منها بنفسك فقط

309
00:13:16,810 --> 00:13:18,310
.لكنّ ذلك لا ينطبق على ما أقوله

310
00:13:18,800 --> 00:13:19,880
...بنفسي

311
00:13:21,820 --> 00:13:24,650
.إنّ هذا الرّجل لا يتفوّه إلاّ بالهراء

312
00:13:24,650 --> 00:13:27,180
!آلمني ذلك كثيرًا

313
00:13:27,180 --> 00:13:28,170
.شيزورو-تشان

314
00:13:28,170 --> 00:13:30,690
.لماذا لا تعطينه هذه؟ أعتقد أنّها لوالدك

315
00:13:30,980 --> 00:13:32,380
.كما أنّنا لن نحتاجها

316
00:13:32,380 --> 00:13:33,200
!يا إلهي

317
00:13:33,200 --> 00:13:36,150
،وسيلة الرّاحة العصريّة الرّائعة
!جهاز تسخين التّبع

318
00:13:36,150 --> 00:13:37,660
!أسطوانة التّبغ

319
00:13:37,660 --> 00:13:39,460
.إنّها لك إن كان ذلك يسرّك هكذا

320
00:13:39,460 --> 00:13:42,460
!شكرًا! ميرسي! غراتزي! كوب كون كا

321
00:13:42,460 --> 00:13:45,440
.على الرّحب والسّعة
.اعتن بنفسك أيّها الجدّ

322
00:13:45,440 --> 00:13:46,590
!دعي الأمر لي

323
00:13:46,590 --> 00:13:50,530
سأصعد نهر كوما وأدرس
،وأستكشف خطّ سيبو إيكبوكورو

324
00:13:50,530 --> 00:13:52,480
...وسأحلّ كلّ الألغاز

325
00:13:52,480 --> 00:13:53,590
.مهلاً

326
00:13:53,590 --> 00:13:56,990
!لا تناديني بـ"الجدّ"! لا أزال يافعًا

327
00:13:57,830 --> 00:13:59,550
.يا له من غريب أطوار

328
00:13:59,550 --> 00:14:02,700
لكنّها أوّل مرّة بعد مدّة طويلة
.نقابل فيها بشريًّا راشدًا

329
00:14:02,700 --> 00:14:04,020
.فيما عدا نيكو-سان وطاقمه

330
00:14:04,020 --> 00:14:05,480
.صحيح، معك حقّ

331
00:14:05,790 --> 00:14:08,950
.لقد بدا وكأنّه يجدر به أن يبيع تمائم

332
00:14:08,950 --> 00:14:11,710
.أعرف ما تقصدين
.ومن النّوع المشبوه والزّائف

333
00:14:11,710 --> 00:14:14,950
هذه أوّل مرّة أقابل فيها شخصًا
.أغرب من زنجيرو-سان

334
00:14:14,950 --> 00:14:16,310
...بالمناسبة

335
00:14:16,310 --> 00:14:18,440
لماذا لم يأتِ زنجيرو-سان معنا؟

336
00:14:18,440 --> 00:14:21,060
.كلاّ. لا أريده أن يكون معنا
أين كان لينام؟

337
00:14:21,060 --> 00:14:23,740
.إنّك تتصرّفين بشكل سطحيّ الآن

338
00:14:23,740 --> 00:14:26,600
كان بإمكاننا أن نسأله
.عن أشياء كثيرة إن كان هنا

339
00:14:26,600 --> 00:14:28,940
.قال زنجيرو-سان أنّه لم يرد مغادرة أغانو

340
00:14:28,940 --> 00:14:29,970
.لم يستطع المغادرة

341
00:14:29,970 --> 00:14:31,200
لِمَ لا؟

342
00:14:31,200 --> 00:14:35,770
كلّما حاول المغادرة، يصاب
.بصداع رأس ودوار شديدين

343
00:14:35,770 --> 00:14:38,360
.قال أنّ ذلك بسبب الجراحة العابثة

344
00:14:38,360 --> 00:14:39,920
ماذا إن كان إيحاءً نفسيًّا؟

345
00:14:39,920 --> 00:14:41,020
إيحاء؟

346
00:14:41,020 --> 00:14:43,020
مثل غسل الدّماغ أو التّنويم المغناطيسيّ؟

347
00:14:43,020 --> 00:14:43,750
.نعم

348
00:14:43,750 --> 00:14:47,320
ماذا إن كان ذلك الوضع العبثيّ
،الّذي يعانيه مجرّد إيحاء ما

349
00:14:47,320 --> 00:14:49,320
وأنّه لا يوجد أيّ أساس فعليّ لأيّ من ذلك؟

350
00:14:49,600 --> 00:14:52,580
.لكنّه يملك ندبة على جبهته من الجراحة بالفعل

351
00:14:52,580 --> 00:14:54,190
.هذا صحيح

352
00:14:54,190 --> 00:14:57,770
حسنًا، أنا مسرورة لأنّه ليس معنا
.هنا في كلّ الأحوال

353
00:14:57,770 --> 00:14:59,340
.آهٍ منك يا ريمي-تشان

354
00:14:59,340 --> 00:15:02,000
كما أنّ وجود شخص إضافيّ
.يعني طعامًا أقلّ لنا أيضًا

355
00:15:02,650 --> 00:15:07,160
،على ذكر هذا الموضوع يا شيزورو-تشان
لماذا قرّرت الذّهاب إلى إيكبوكورو؟

356
00:15:07,160 --> 00:15:10,610
...عند طرح هذا السّؤال هكذا مباشرة

357
00:15:10,610 --> 00:15:12,290
هل هذا من أجل يوكا-تشان؟

358
00:15:13,140 --> 00:15:15,220
هل لأنّك لم تستطيعي العثور
عليها في أيّ مكان قرب أغانو؟

359
00:15:15,500 --> 00:15:17,820
ريمي، هل كان عليك قول ذلك هكذا؟

360
00:15:17,820 --> 00:15:19,280
.ماذا؟ إنّها الحقيقة

361
00:15:19,280 --> 00:15:20,470
أليس كذلك يا شيزورو-تشان؟

362
00:15:20,840 --> 00:15:22,760
.نعم، صحيح

363
00:15:22,760 --> 00:15:24,720
لأنّك رأيت تلك الصّورة في الصّحيفة؟

364
00:15:24,720 --> 00:15:26,980
.نعم، نوعًا ما

365
00:15:27,280 --> 00:15:30,280
.كيف ستجدينها؟ لا يبدو ذلك ممكنًا

366
00:15:30,280 --> 00:15:31,340
.لا يمكن الجزم بأيّ شيء

367
00:15:31,340 --> 00:15:33,100
،ربّما بمجرّد وصولنا إلى إيكبوكورو

368
00:15:33,100 --> 00:15:36,290
ستأتي يوكا-تشان إلينا وتقول
"!لم أركنّ منذ مدّة"

369
00:15:36,290 --> 00:15:39,050
.بكلّ تأكيد. سيكون ذلك رائعًا جدًّا

370
00:15:39,940 --> 00:15:41,880
...اسمعي يا شيزورو-تشان

371
00:15:41,880 --> 00:15:45,550
إن كنتِ قد غادرتِ أغانو دون
،إخبارنا بأيّ شيء

372
00:15:45,550 --> 00:15:51,780
لكان قد أحزننا ذلك تمامًا مثلما
.حدث لك بعد اختفاء يوكا-تشان

373
00:15:51,780 --> 00:15:55,750
.أظنّ ذلك. آسفة لأنّي لم أفكّر في الأمر هكذا

374
00:15:57,020 --> 00:15:59,210
.أظنّ أنّ عليك الاعتذار عن شيء آخر أيضًا

375
00:15:59,210 --> 00:15:59,590
ماذا؟

376
00:16:00,250 --> 00:16:03,690
أقصد اقتراحك أنّه لم نكن
.مضطرّات على مرافقتك

377
00:16:06,960 --> 00:16:08,060
.آسفة

378
00:16:08,970 --> 00:16:12,820
.يوكا-تشان صديقتنا أيضًا كما تعلمين

379
00:16:13,120 --> 00:16:14,070
.نعم

380
00:16:15,070 --> 00:16:17,100
لا بأس، أليس هذا كافيًا؟

381
00:16:17,100 --> 00:16:20,300
.لا، أنا فعلاً آسفة
.لم أكن أفكّر في مشاعركنّ

382
00:16:20,630 --> 00:16:22,320
.لا بأس ما دمت تدركين الآمر الآن

383
00:16:22,320 --> 00:16:23,090
!نعم، نعم

384
00:16:23,090 --> 00:16:25,000
،بما أنّنا اتّفقنا على ذلك الآن
.فلنعد إلى أغانو

385
00:16:25,000 --> 00:16:25,640
!ماذا؟

386
00:16:26,120 --> 00:16:27,310
أأنت غبيّة؟

387
00:16:27,310 --> 00:16:29,130
ما الّذي تقولينه يا ريمي-تشان؟

388
00:16:29,130 --> 00:16:31,050
.ماذا؟ علينا أن نتجهّز كما يجب

389
00:16:31,050 --> 00:16:34,430
.نحتاج ملابس وطعامًا وبطّانيّات وعدّة تخييم

390
00:16:34,430 --> 00:16:37,330
أولن يكون من اللّطيف أيضًا
وجود شموع منسّمة؟

391
00:16:37,330 --> 00:16:38,170
.فعلاً

392
00:16:38,170 --> 00:16:39,120
.معك حقّ

393
00:16:39,120 --> 00:16:40,880
.إنّ التّوتّر ينجم عن قلّة النّوم

394
00:16:40,880 --> 00:16:42,420
.مهلاً لحظة

395
00:16:42,420 --> 00:16:43,610
نعود بعد أن قطعنا كلّ هذه المسافة؟

396
00:16:43,610 --> 00:16:44,490
ألن تكون مضيعة كبيرة؟

397
00:16:44,490 --> 00:16:48,120
لكن لا يسعني سوى القلق
.على قلّة المؤن لدينا

398
00:16:48,120 --> 00:16:52,120
.مهلاً، لم أوافق على هذه الرّحلة أساسًا

399
00:16:52,120 --> 00:16:55,770
،حسنًا، عندما نعود إلى أغانو
.يمكنك البقاء هناك وحدك

400
00:16:55,770 --> 00:16:57,620
!لا أريد أن أظلّ وحدي

401
00:17:07,420 --> 00:17:10,250
كويوكي-سان، آسف لأنّي جعلتك
.تقومين بكلّ هذا

402
00:17:10,250 --> 00:17:14,150
في تلك الحالة، أريد إحضار
."أسفار الأمير تاكاوكا"

403
00:17:14,150 --> 00:17:14,850
وما ذلك؟

404
00:17:14,850 --> 00:17:16,640
.إنّها رواية. ما كنتِ لتسمعي بها

405
00:17:16,640 --> 00:17:17,480
فعلاً؟

406
00:17:17,480 --> 00:17:21,390
في تلك الحالة، سأحضر معي رقائق
.بطاطس بالهالابينيو الّتي لا يمكنك أكلها

407
00:17:21,390 --> 00:17:22,760
.إنّها لذيذة جدًّا

408
00:17:22,760 --> 00:17:25,050
.سيكون علينا تقديم رسائل غياب أيضًا

409
00:17:25,050 --> 00:17:28,500
أم يجب أن تكون فترة غياب طويلة؟

410
00:17:28,500 --> 00:17:30,660
!حسنًا! سأشغّل محرّك القطار

411
00:17:43,360 --> 00:17:44,410
ماذا يحدث؟

412
00:17:44,980 --> 00:17:47,120
.لم يكن الوضع هكذا من قبل

413
00:17:47,380 --> 00:17:49,980
ارتفع مستوى الماء. لكن لماذا؟

414
00:17:49,980 --> 00:17:52,600
الخريطة! تلك الّتي أخذناها
!من النّاسك المشبوه

415
00:17:59,620 --> 00:18:00,590
ما ذلك الصّوت؟

416
00:18:04,400 --> 00:18:05,530
.إنّها مورس

417
00:18:05,530 --> 00:18:07,120
.إنّها شيفرة مورس

418
00:18:07,120 --> 00:18:07,870
!أجل

419
00:18:07,870 --> 00:18:09,810
!نسيت أنّي طلبتُ ذلك من الجدّة كويوكي

420
00:18:09,810 --> 00:18:10,910
أن ترسل لنا شيفرة مورس؟

421
00:18:10,910 --> 00:18:12,070
.لا، لا

422
00:18:12,070 --> 00:18:13,230
.زنجيرو-سان

423
00:18:13,230 --> 00:18:14,800
!إنّها لا تجيب

424
00:18:14,800 --> 00:18:17,480
وعدنا أننّا سنتواصل معًا
!في الخامسة مساءً من كلّ يوم

425
00:18:17,890 --> 00:18:20,350
!هذه أغانو! أجبن رجاءً

426
00:18:22,820 --> 00:18:24,250
ماذا؟ ماذا يقول؟

427
00:18:24,250 --> 00:18:25,790
نقطة شرطة شرطة؟

428
00:18:25,790 --> 00:18:27,070
...أبطئ قليلاً

429
00:18:27,070 --> 00:18:28,700
ما كانت "أ" ثانية؟

430
00:18:33,920 --> 00:18:34,770
!سريعة

431
00:18:34,770 --> 00:18:36,790
أذلك صحيح؟ لا تختلقين الأمر
فحسب، أليس كذلك؟

432
00:18:36,790 --> 00:18:37,640
.اخرسي

433
00:18:40,300 --> 00:18:41,990
ارتفع مستوى المياه"؟"

434
00:18:41,990 --> 00:18:43,320
هل يقصدن نهر كوما؟

435
00:18:43,900 --> 00:18:47,260
.من الخطر أن يغرق المحرّك"
".اهربن لمكان مرتفع

436
00:18:47,260 --> 00:18:47,940
.هذا ما قاله

437
00:18:47,940 --> 00:18:49,080
!ماذا؟

438
00:18:49,080 --> 00:18:52,210
مهلاً، كلاّ، إلى أين نذهب؟
!نحن في ورطة

439
00:18:52,210 --> 00:18:54,810
.مهلاً. الكلام المنطوق لا ينفع هنا

440
00:18:54,810 --> 00:18:56,810
.التّقدّم أو التّراجع؟ انصحنا رجاءً

441
00:18:58,660 --> 00:19:03,540
تذكر هيئة المعلومات الجغرافيّة المكانيّة
...أنّ أغانو وهيغاشي-أغانو تشو-تشو-تشو

442
00:19:03,540 --> 00:19:04,490
تشو"؟"

443
00:19:05,000 --> 00:19:06,440
!انتهت الدّقائق الخمسة

444
00:19:06,440 --> 00:19:07,690
ماذا نفعل يا شيزورو-تشان؟

445
00:19:26,220 --> 00:19:29,080
!لنتقدّم

446
00:19:32,660 --> 00:19:34,510
!إنّها قادمة! إنّها خلفنا مباشرة

447
00:19:34,510 --> 00:19:36,270
!هدوء، هدوء

448
00:19:44,530 --> 00:19:46,470
!بسرعة! بسرعة أكبر

449
00:19:46,470 --> 00:19:47,790
!أنا أحاول

450
00:19:56,170 --> 00:19:58,090
!هيّا بنا إلى الأمام

451
00:19:58,090 --> 00:20:01,300
!تحرّك

452
00:20:20,520 --> 00:20:22,190
.لا يمكننا العودة

453
00:20:23,420 --> 00:20:25,040
.لكنّ هذا للأفضل

454
00:20:25,370 --> 00:20:26,420
كيف ذلك؟

455
00:20:26,420 --> 00:20:27,780
.علينا التّقدّم للأمام الآن

456
00:20:28,550 --> 00:20:29,460
.نعم

457
00:20:29,920 --> 00:20:32,060
ماذا عن الشّموع المنسّمة؟

458
00:20:32,060 --> 00:20:34,190
.بإمكانها الانتظار حتّى نصل إلى إيكبوكورو

459
00:20:34,190 --> 00:20:35,340
.ظننتُ أنّ لديك 1000 ينّ فحسب

460
00:20:35,340 --> 00:20:36,950
.أعيريني بعض المال

461
00:20:36,950 --> 00:20:38,440
.لا. لن أعيرك أيّ مال

462
00:20:38,440 --> 00:20:39,140
!بخيلة

463
00:20:39,140 --> 00:20:39,890
!لحظة

464
00:20:41,310 --> 00:20:43,640
هل سنذهب إلى إيكبوكورو بالفعل؟

465
00:20:44,560 --> 00:20:45,560
.ذلك ما يبدو

466
00:20:45,560 --> 00:20:47,820
.إنّه خيارنا الوحيد الآن

467
00:20:47,820 --> 00:20:48,850
ماذا عنك؟

468
00:20:50,530 --> 00:20:51,570
.أنا ذاهبة

469
00:20:51,570 --> 00:20:53,410
!سأذهب للعثور على يوكا

470
00:21:45,430 --> 00:21:47,850
!إنّها هيغاشي-أغانو

471
00:21:54,210 --> 00:21:55,470
.أهلاً

472
00:21:55,470 --> 00:21:57,050
.مرحبًا بكنّ في هيغاشي-أغانو

473
00:21:57,050 --> 00:21:59,120
.لا يزورنا الكثير من النّاس هنا

474
00:21:59,120 --> 00:22:00,900
.معك حقّ

475
00:22:02,140 --> 00:22:05,000
.يمكنكنّ أن ترتحن هنا قدر الإمكان