1
00:00:08,640 --> 00:00:10,880
.صباح الخير يا كيكوتشي-سان

2
00:00:10,880 --> 00:00:13,610
.صباح الخير يا توموزاكي-كُن

3
00:00:13,900 --> 00:00:15,490
."قرأت كتاب "البوبل

4
00:00:16,790 --> 00:00:18,450
!فعلاً؟

5
00:00:24,090 --> 00:00:27,750
.لم أكن أدري أنّه متوفّر ككتاب إلكترونيّ

6
00:00:27,750 --> 00:00:31,260
،قلتِ أنّ الكتاب نادر في متاجر الكتب

7
00:00:31,500 --> 00:00:33,260
...لذلك قلتُ ربّما أجده هكذا

8
00:00:34,000 --> 00:00:34,600
.خذي

9
00:00:35,110 --> 00:00:36,050
أرأيت؟

10
00:00:37,550 --> 00:00:41,560
"البوبل وجزيرة الجوارح"

11
00:00:39,250 --> 00:00:40,340
...هذا مذهل

12
00:00:46,850 --> 00:00:49,070
"الفهرس"

13
00:00:49,280 --> 00:00:52,820
عفوًا... ما رأيك بالكتاب بعد قراءته؟

14
00:00:53,160 --> 00:00:55,840
،أظنّ أنّ أفضل جزء فيه هو النّهاية

15
00:00:55,840 --> 00:00:59,390
فقد استعمل الجميع قوّة الكلمات
لإيصال جمال المحيط

16
00:00:59,390 --> 00:01:01,830
.للبوبل الأعمى

17
00:01:02,140 --> 00:01:03,700
!عرفتُ هذا

18
00:01:03,960 --> 00:01:08,010
.علق بذهني شيء آخر أيضًا

19
00:01:08,010 --> 00:01:09,460
شيء آخر؟

20
00:01:10,990 --> 00:01:12,590
.النّاريّون

21
00:01:17,590 --> 00:01:21,970
"الفصل 7: النّاريّون"

22
00:02:55,480 --> 00:02:58,980
استعمل البوبل قوّة الكلمات
ليُصادق الآخرين

23
00:02:58,980 --> 00:03:01,030
.فيما عدا النّاريّين

24
00:03:01,290 --> 00:03:07,040
.هذا صحيح. لا يمكننا مصادقة الجميع

25
00:03:07,760 --> 00:03:11,790
.إنّ كتاب البوبل... قصّة للنّاضجين نوعًا ما

26
00:03:12,800 --> 00:03:15,290
...عندما قرأت ذلك الجزء في كتاب البوبل

27
00:03:20,510 --> 00:03:27,150
بدا لي منفّرًا تمامًا مثل الوقت الّذي
."تحدّثت فيه كيكوتشي-سان عن "المُثُل

28
00:03:28,410 --> 00:03:32,900
قلتِ أنّك ترين الأمور
من وجهة نظر الكاتب، صحيح؟

29
00:03:33,650 --> 00:03:34,770
.نعم

30
00:03:34,770 --> 00:03:41,030
لكن إن كان ذلك صحيحًا... فسيكون
.بإمكانك القبول بوجود هؤلاء النّاريّين

31
00:03:42,740 --> 00:03:48,330
"البوبل وجزيرة الجوارح"

32
00:03:43,440 --> 00:03:49,000
كان البوبل مسخًا، ومع ذلك عقد
.صداقات مع كلّ الأنواع الأخرى

33
00:03:49,000 --> 00:03:51,750
.ونعم، ذلك مُثُليّ

34
00:03:52,410 --> 00:03:55,710
ومع ذلك، بينما يبني الكاتب
،مايكل أندي هذا العالم

35
00:03:55,710 --> 00:03:57,330
،جعل النّاريّين جزءًا منه

36
00:03:58,570 --> 00:04:02,500
.مع أنّهم لم يستطيعوا مصادقة الآخرين

37
00:04:04,340 --> 00:04:09,170
،قلتِ أنّك احتجتِ لتكوني مثل البوبل

38
00:04:09,170 --> 00:04:12,440
لذلك ألا يعني هذا أنّك ترفضين النّاريّين؟

39
00:04:13,470 --> 00:04:15,490
،إن كنتِ فعلاً تملكين وجهة نظر الكاتب

40
00:04:15,490 --> 00:04:18,980
كان بإمكانك قول أنّ في العالم
.متّسع للبوبل والنّاريّين معًا

41
00:04:19,490 --> 00:04:22,810
إنّ قول أنّ عليك أن تكوني مثل البوبل

42
00:04:22,810 --> 00:04:26,570
يُظهر أنّك تفكّرين كيف يجب
.أن تكوني لأجل نفسك

43
00:04:27,360 --> 00:04:30,120
...قد يكون ذلك ممكنًا

44
00:04:30,440 --> 00:04:33,410
.أعلم أنّي ألعب بالنّار هنا

45
00:04:33,940 --> 00:04:37,750
إنّني أنفي الكلمات الّتي كانت
تستعملها للتّعريف عن نفسها

46
00:04:37,750 --> 00:04:40,380
.وأحاول اقتراح كلمات مختلفة كبديل

47
00:04:40,960 --> 00:04:46,990
لكنّي أرى كيكوتشي-سان الّتي
،أرشدت كريس إلى نهاية حزينة

48
00:04:46,990 --> 00:04:52,100
كيكوتشي-سان الّتي كانت تبذل
،كلّ ما باستطاعتها للانسجام

49
00:04:52,530 --> 00:04:53,910
.وأقول لنفسي: أريد مساعدتها

50
00:04:53,910 --> 00:04:56,120
...ولا أعني أنّ عليّ مساعدتها

51
00:04:56,890 --> 00:04:58,460
.بل أريد مساعدتها

52
00:04:59,860 --> 00:05:02,590
.لا أعتقد أنّك بحاجة لوجهة نظر لاعب أو كاتب

53
00:05:03,090 --> 00:05:07,820
،يمكنك رؤية الحياة بعينيك
.من وجهة نظر الشّخصيّة

54
00:05:08,350 --> 00:05:11,570
لقد أضعتِ ذلك فحسب
.لأنّك تبالغين في التّفكير

55
00:05:13,400 --> 00:05:15,870
.أنا لا أدري فحسب

56
00:05:16,380 --> 00:05:20,020
،لا أدري ما الّذي أنظر إليه
...وما هي أهدافي

57
00:05:22,630 --> 00:05:27,130
.أعني... كلّ ما أراه رماديّ

58
00:05:31,140 --> 00:05:32,650
.هذا سهل

59
00:05:34,250 --> 00:05:35,520
.كُتب أندي

60
00:05:36,160 --> 00:05:39,400
.إنّك تحبّين كتبه

61
00:05:39,680 --> 00:05:42,650
.هذه حقيقة لن تتغيّر أبدًا

62
00:05:43,870 --> 00:05:45,400
أهذا كافٍ؟

63
00:05:45,650 --> 00:05:51,200
نعم. فقبل كلّ شيء، إنّ كتبه
.هي الّتي أرتك عالمًا من الألوان

64
00:05:51,920 --> 00:05:56,160
.تعتقدين الآن أنّ عليك التّغيّر للانسجام

65
00:05:56,670 --> 00:05:59,250
،لكنّك إن كنت واحدة من النّاريّين

66
00:05:59,250 --> 00:06:02,750
...وكان الجميع نوعًا مختلفًا عنك

67
00:06:03,030 --> 00:06:06,260
فبإمكانك العثور على أصدقاء
.في بحيرة النّاريّين

68
00:06:09,120 --> 00:06:10,140
...هذا

69
00:06:11,720 --> 00:06:14,690
ستجدين الكثير من الأصدقاء الّذين
.يحبّون نفس الأشياء الّتي تحبّينها

70
00:06:15,120 --> 00:06:19,140
.وقد ترغبين في لقاء بعضهم شخصيًّا

71
00:06:21,030 --> 00:06:24,480
.أعني أنّ ذلك المكان مليء بالنّاريّين فقط

72
00:06:26,510 --> 00:06:29,990
.أنت مذهل بالفعل يا توموزاكي-كُن

73
00:06:30,310 --> 00:06:32,990
.على الإطلاق. أنا ماكر فحسب

74
00:06:33,240 --> 00:06:35,740
ومع ذلك... هل أنت واثق؟

75
00:06:36,000 --> 00:06:42,200
أنت وهانابي-تشان تغيّرتما بشكل
رائع وتنسجمان في الفصل جيّدًا

76
00:06:42,200 --> 00:06:44,250
بينما عليّ أنا فقط البقاء كما أنا؟

77
00:06:44,480 --> 00:06:45,920
.صحيح

78
00:06:47,670 --> 00:06:49,370
.سأكون صريحًا معك

79
00:06:49,370 --> 00:06:53,140
الصّداقات الّتي نحصل عليها
.في المدرسة ليست مميّزة لتلك الدّرجة

80
00:06:54,640 --> 00:06:57,890
،لقد غيّرتُ نفسي في هذه الأشهر السّتّة الأخيرة

81
00:06:58,340 --> 00:07:00,520
،وتورّطتُ مع أنواع مختلفة من النّاس

82
00:07:00,520 --> 00:07:04,300
وأعتقد أنّي حصلت على الكثير
.ممّن يمكنني اعتبارهم أصدقاء

83
00:07:05,920 --> 00:07:09,780
لكن كان كلّ ذلك متعلّقًا بانسجامي مع هؤلاء

84
00:07:10,110 --> 00:07:13,410
.وكانت المدرسة هي ما جمع بيننا فحسب

85
00:07:13,910 --> 00:07:16,990
،وفي هذه الأشهر السّتّة الأخيرة

86
00:07:17,370 --> 00:07:20,000
فإنّ اللّقاء الّذي أنا سعيد كثيرًا به

87
00:07:22,880 --> 00:07:29,920
كان اليوم الّذي أنكرت فيه هذه
،المدرسة وأسلوب الحياة العاديّ

88
00:07:29,920 --> 00:07:32,060
.وأنكرت هينامي ذلك بدورها في وجهي

89
00:07:33,300 --> 00:07:36,810
،قمتُ بما أخبرتني به
.وبدأت ألعب لعبة الحياة

90
00:07:37,410 --> 00:07:42,440
كانت طريقة تفكيري السّطحيّة
،"مجرّد "عنب حامض

91
00:07:42,990 --> 00:07:44,910
.مجرّد خاسر لا يرضى بالهزيمة

92
00:07:45,840 --> 00:07:48,730
.لكنّ ذلك ليس صحيحًا بالكامل

93
00:07:49,520 --> 00:07:53,360
.لا يمكنني القول أنّ كلّ العنب كان حامضًا

94
00:07:54,740 --> 00:07:59,580
الأمر ببساطة هو أنّ بعض العنب كان
.أحلى أو أكثر حموضة من الباقي

95
00:08:01,330 --> 00:08:04,730
.وتلك هي الحقيقة الّتي وصلتُ إليها

96
00:08:06,290 --> 00:08:10,970
لذلك لستِ بحاجة لتكوني صديقة مع الجميع

97
00:08:10,970 --> 00:08:13,550
فقط لأنّك تعتقدين أنّ ذلك
.ما يريده العالم منك

98
00:08:14,830 --> 00:08:16,300
...فهمت

99
00:08:16,570 --> 00:08:19,440
.إذًا فلا بأس بي كما أنا الآن

100
00:08:20,120 --> 00:08:26,520
.لستُ مسخًا لا ينتمي إلى هذا العالم

101
00:08:27,400 --> 00:08:30,190
.صحيح. بالطّبع لستِ كذلك

102
00:08:30,510 --> 00:08:31,330
...نعم

103
00:08:33,700 --> 00:08:35,700
...والآن، لنعد للخلف قليلاً

104
00:08:36,090 --> 00:08:37,320
إلى أين؟

105
00:08:38,530 --> 00:08:41,700
هذا هنا. هل تعرفين استعمال هذا التّطبيق؟

106
00:08:43,710 --> 00:08:47,210
...لحظة... عليك إنشاء حساب أوّلاً

107
00:08:48,840 --> 00:08:51,460
.الأمر بسيط للغاية

108
00:08:53,750 --> 00:08:56,380
،إن كان العنب الحلو بعيدًا عن المتناول

109
00:08:56,380 --> 00:08:58,970
علينا أن نسعى خلف الفراولة
.الحلوة الّتي على الأرض

110
00:08:59,400 --> 00:09:03,980
،إن كنت لا تهتمّين للأشياء الحلوة
.فابحثي عن المكسّرات اللّذيذة إذًا

111
00:09:04,610 --> 00:09:08,980
،وإن لم تكوني جائعة من الأساس
.استمتعي بوقتك كيفما تشائين

112
00:09:10,410 --> 00:09:12,970
.هذا كلّ ما في الأمر

113
00:09:18,000 --> 00:09:19,240
!توموزاكي-كُن

114
00:09:19,600 --> 00:09:22,880
.صباح الخير يا كيكوتشي-سان
.تبدين سعيدة اليوم

115
00:09:22,880 --> 00:09:24,870
.لقد اتّخذت قراري

116
00:09:25,160 --> 00:09:28,250
أنهيتُ المسودّة الأخيرة برحيل كريس

117
00:09:28,250 --> 00:09:32,010
.وبذل جهدها للانسجام في العالم الخارجيّ

118
00:09:32,750 --> 00:09:37,150
ولكن الآن، ستتدرّب كريس
،في ورشة لتصير حِرفيّة

119
00:09:37,150 --> 00:09:39,140
.وستقوم بصنع زينة الأزهار الّتي تحبّ

120
00:09:39,390 --> 00:09:41,540
!نعم، هذا جيّد

121
00:09:49,020 --> 00:09:52,340
،واثقة أنّ كريس كانت وحيدة في حديقتها

122
00:09:52,340 --> 00:09:54,940
...ولم تكن تعلم أيّ شيء عن العالم الخارجيّ

123
00:09:55,840 --> 00:10:00,030
.لكنّي فكّرتُ أنّها ستحبّ العمل بالزّهور

124
00:10:00,490 --> 00:10:05,910
لذلك أعتقد أنّها ستكون سعيدة
.باختيارها لذلك الطّريق

125
00:10:07,160 --> 00:10:08,040
.هكذا إذًا

126
00:10:38,800 --> 00:10:40,520
...عفوًا يا كيكوتشي-سان

127
00:10:40,520 --> 00:10:41,370
ماذا؟

128
00:10:42,780 --> 00:10:46,370
.أودّ الحديث عن شيء ما معك بعد المهرجان

129
00:10:53,660 --> 00:10:55,380
!صباح الخير يا برين

130
00:10:55,650 --> 00:10:57,630
.صباح الخير يا ميميمي

131
00:10:57,630 --> 00:11:03,390
نكاد ننتهي من المسرحيّة، صحيح؟
أقصد النّصّ وكلّ شيء؟

132
00:11:03,390 --> 00:11:05,270
.نعم، تقريبًا

133
00:11:05,270 --> 00:11:11,390
إذًا يمكنني أن أطلب منك أن نبدأ
بالتّركيز أكثر على عرضنا الآن؟

134
00:11:11,390 --> 00:11:15,490
.نعم، أكيد. أستطيع التّدرّب بجدّيّة الآن

135
00:11:15,490 --> 00:11:19,640
.ممتاز! إنّنا ثنائيّ متزوّج قبل كلّ شيء

136
00:11:19,640 --> 00:11:22,910
.إنّنا نقوم بعرضِ ثنائيٍّ متزوّجٍ فحسب، مجرّد عرض

137
00:11:24,240 --> 00:11:27,740
!ردّ ممتاز! واصل على هذا الحال

138
00:11:27,740 --> 00:11:28,700
.أكيد

139
00:11:31,730 --> 00:11:36,490
كانت الأيّام الّتي سبقت المهرجان
.مليئة بالتّداريب والاستعدادات

140
00:11:58,070 --> 00:12:03,070
"مسرحيّة ثانويّة سكيموتو للمهرجان الثّقافيّ"
"طريقتي غير المألوفة للطّيران"

141
00:12:22,220 --> 00:12:26,050
"!!مقهى المانغا بانشو"

142
00:12:24,950 --> 00:12:26,050
...وأخيرًا

143
00:12:26,870 --> 00:12:29,150
!سيبدأ المهرجان غدًا

144
00:12:33,060 --> 00:12:37,060
"مهرجان سكيموتو"

145
00:12:37,060 --> 00:12:41,070
"غرفة الخياطة 2"

146
00:12:41,070 --> 00:12:44,450
هدف متوسّط: الحصول على"
"حبيبة قبل السّنة الثّلاثة

147
00:12:41,380 --> 00:12:44,450
حسنًا، هل اتّخذت قرارك؟

148
00:12:44,450 --> 00:12:49,950
حسب مشاعرك، هل تعرف من
ستختار، فوكا-تشان أم ميميمي؟

149
00:12:50,290 --> 00:12:51,830
.نعم. لقد قرّرت

150
00:12:52,210 --> 00:12:53,620
.هذا جيّد

151
00:12:55,560 --> 00:12:57,660
...بالنّسبة لنصّ المسرحيّة

152
00:12:58,160 --> 00:13:01,340
ما مدى التّأثير الّذي كان لديك على القصّة؟

153
00:13:01,610 --> 00:13:05,630
كنت أستمع لأفكار كيكوتشي-سان
.كلّما شعرت أنّها عالقة لا غير

154
00:13:05,630 --> 00:13:08,470
.القصّة من تأليفها بالكامل تقريبًا

155
00:13:08,770 --> 00:13:09,480
.فهمت

156
00:13:09,950 --> 00:13:11,350
لماذا سألت؟

157
00:13:12,030 --> 00:13:13,360
.لا سبب معيّن

158
00:13:13,360 --> 00:13:17,620
راودني الفضول قليلاً عن مدى
.مشاركتك فيها لا غير

159
00:13:18,060 --> 00:13:20,360
.كنت حاضرًا في مقابلتنا قبل كلّ شيء

160
00:13:21,060 --> 00:13:23,360
!اليوم يوم مهمّ على كلّ حال

161
00:13:23,840 --> 00:13:25,240
هل أنت جاهز؟

162
00:13:25,490 --> 00:13:27,220
.نعم، بالطّبع

163
00:13:28,740 --> 00:13:32,740
"مهرجان سكيموتو"

164
00:13:31,630 --> 00:13:36,250
إنّه اليوم الّذي سأبوح فيه بمشاعري
.لأستطيع فعل ما أريد فعله

165
00:13:36,590 --> 00:13:39,060
.إنّ الفشل ليس خيارًا على الإطلاق

166
00:13:39,750 --> 00:13:43,760
"!!مقهى المانغا بانشو"

167
00:13:42,440 --> 00:13:43,760
!برين

168
00:13:44,540 --> 00:13:46,880
...صباح الخير يا ميمي... مي

169
00:13:46,880 --> 00:13:50,640
!مهلاً! أرى أنّ مظهري قد أسرك

170
00:13:53,820 --> 00:13:57,140
ما رأيك؟ أليس ظريفًا؟ هذا ظريف، صحيح؟

171
00:13:57,680 --> 00:13:59,270
.نعم، ظريف جدًّا

172
00:13:59,580 --> 00:14:00,770
.أقصد السّلطعون بالطّبع

173
00:14:00,770 --> 00:14:02,650
!تقصد السّلطعون؟

174
00:14:04,580 --> 00:14:08,430
!حسنًا، تعالوا جميعًا لالتقاط صورة للفصل

175
00:14:08,430 --> 00:14:10,320
!أجل، أخيرًا

176
00:14:11,220 --> 00:14:12,310
...توموزاكي

177
00:14:12,950 --> 00:14:14,200
أين قميصك؟

178
00:14:14,560 --> 00:14:17,210
.لا داعي للقلق، أنا أرتديه

179
00:14:17,740 --> 00:14:18,620
أرأيت؟

180
00:14:19,530 --> 00:14:20,630
.هذا جيّد إذًا

181
00:14:22,540 --> 00:14:26,960
يبدو أنّ هذا سيكون مهرجانًا
.ممتعًا. بالنّسبة لكلينا

182
00:14:26,960 --> 00:14:27,760
أتظنّين؟

183
00:14:28,630 --> 00:14:33,140
"مهرجان سكيموتو"

184
00:14:45,650 --> 00:14:48,040
!ميزوساوا-سان! توموزاكي-سان

185
00:14:49,340 --> 00:14:54,030
مرحبًا يا غومي... ومعك ماكو-تشان
!وساياكا-تشان أيضًا

186
00:14:55,520 --> 00:14:58,790
!لم نكن نعلم أنّكما صديقان لغومي

187
00:14:58,790 --> 00:15:00,390
!لم نركما منذ مدّة

188
00:15:00,390 --> 00:15:02,040
.صـ-صحيح

189
00:15:02,040 --> 00:15:04,290
ماذا؟ ما الّذي حدث لنظّارات الأنف؟

190
00:15:05,410 --> 00:15:07,300
!كانت تلك تجربة لن أكرّرها

191
00:15:07,560 --> 00:15:10,300
صحيح، هل رأيتما بينستا هذا الفتى؟

192
00:15:10,300 --> 00:15:11,670
.ها هو، انظرا

193
00:15:12,570 --> 00:15:14,140
!لقد نشرها بالفعل

194
00:15:14,420 --> 00:15:16,790
.تبدو جيّدة عليك يا ميزوساوا-سان

195
00:15:16,790 --> 00:15:18,890
!ها هي ذي المجاملات الّتي ليست مجاملات

196
00:15:19,820 --> 00:15:24,680
...مذهل يا ميزوساوا
!لا، لا يجب أن أفقد أعصابي

197
00:15:25,150 --> 00:15:29,520
.صحيح، كما أنّها حصلت على إعجابات كثيرة

198
00:15:29,520 --> 00:15:31,080
!ها أنت يا برين

199
00:15:31,770 --> 00:15:33,400
...إنّ الوقت يوشك أن

200
00:15:39,230 --> 00:15:40,500
!مواعدة غير شرعيّة؟

201
00:15:40,880 --> 00:15:42,000
!قطعًا لا

202
00:15:42,850 --> 00:15:46,660
ألا يجب أن نقوم بتدريب واحد أخير؟

203
00:15:46,660 --> 00:15:48,510
.نعم، معك حقّ

204
00:15:48,510 --> 00:15:51,260
هل ستقوم بعرض ما يا توموزاكي-سان؟

205
00:15:51,260 --> 00:15:54,890
.عفوًا، نعم. إنّه عرض كوميديّ في الحقيقة

206
00:15:55,230 --> 00:15:56,380
كوميديّ؟

207
00:15:57,090 --> 00:16:00,100
ما خفي منك كان أعظم بالفعل
.يا توموزاكي-سان

208
00:16:00,100 --> 00:16:02,890
كما أنّك تقوم بالعرض الكوميديّ مع هذه الظّريفة؟

209
00:16:03,160 --> 00:16:03,900
!ماذا؟

210
00:16:04,400 --> 00:16:07,360
مع أنّك كنت تغازل الفتيات
...في ثانويّة الفتيات خاصّتنا

211
00:16:07,640 --> 00:16:11,860
!ذهبتَ لثانويّة الفتيات للمغازلة يا برين؟

212
00:16:12,110 --> 00:16:14,280
...لم أكن أغازل بالمعنى الصّحيح

213
00:16:14,530 --> 00:16:22,160
!بـ-برين! منذ متى صرت شخصًا سطحيًّا هكذا؟

214
00:16:22,160 --> 00:16:24,540
—كـ-كلاّ! إنّ ميزوساوا

215
00:16:24,540 --> 00:16:26,420
!كنتَ مع تاكاهيرو؟

216
00:16:26,970 --> 00:16:29,920
!صرتُ واثقة أنّ الأمر حدث الآن

217
00:16:29,920 --> 00:16:33,240
!حسنًا! لنذهب للتّدريب

218
00:16:33,240 --> 00:16:34,680
!لا تغيّر الموضوع

219
00:16:35,980 --> 00:16:38,180
!حظًّا سعيدًا لكما

220
00:16:45,390 --> 00:16:46,590
تبحثين عن توموزاكي-كُن؟

221
00:16:47,740 --> 00:16:50,340
يجدر أن يكون في القاعة متعدّدة
،الاستعمالات مع ميميمي الآن

222
00:16:50,340 --> 00:16:51,940
.للتّدرّب على عرضهما الكوميديّ

223
00:16:52,360 --> 00:16:55,910
.صحيح... معك حقّ

224
00:16:56,570 --> 00:16:57,560
فوكا-تشان؟

225
00:16:58,020 --> 00:17:01,080
.سأبذل جهدي لإنجاح هذا العرض

226
00:17:01,890 --> 00:17:05,080
.نعم. أشكرك كثيرًا

227
00:17:05,080 --> 00:17:07,080
"قاعة متعدّدة الاستعمالات"
"المدخل من هنا"

228
00:17:07,080 --> 00:17:09,090
"مهرجان سكيموتو"

229
00:17:11,390 --> 00:17:13,590
...حسنًا، حان الوقت

230
00:17:13,890 --> 00:17:15,840
لماذا أنت متوتّر جدًّا؟

231
00:17:15,840 --> 00:17:18,990
أ-أليس عاديًّا أن أتوتّر؟

232
00:17:20,010 --> 00:17:24,770
لا تقلق، لا تقلق! لا يتوقّع
.أيّ أحد الكثير من الأساس

233
00:17:24,770 --> 00:17:27,730
.فلا أظنّنا سنبلي بلاء حسنًا

234
00:17:28,020 --> 00:17:30,480
!ألا يفترض بنا أن نطمح لذلك؟

235
00:17:30,480 --> 00:17:34,490
!صحيح، صحيح! هذا هو المطلوب

236
00:17:34,990 --> 00:17:36,510
.أرأيت؟ سنكون بخير

237
00:17:38,910 --> 00:17:44,540
"كوميديا" "هانيوانيا"

238
00:17:39,670 --> 00:17:43,180
!العرض التّالي سيكون كوميديًّا من هانيوانيا

239
00:17:43,180 --> 00:17:46,160
!والآن، صفّقوا للثّنائيّ

240
00:17:46,160 --> 00:17:48,040
!ذاك هو اسمنا؟

241
00:17:48,290 --> 00:17:53,050
ألم تحبّه؟ كنت حائرة بين ذلك
."وبين "هانيوانيوا

242
00:17:53,050 --> 00:17:55,550
!كلاهما سخيف بنفس الدّرجة

243
00:17:58,370 --> 00:18:00,240
!حسنًا، هيّا بنا يا برين

244
00:18:00,240 --> 00:18:00,980
!نعم

245
00:18:01,550 --> 00:18:03,060
"مهرجان سكيموتو"
"كوميديا" "هانيوانيا"

246
00:18:01,910 --> 00:18:03,060
!مرحبًا

247
00:18:03,060 --> 00:18:06,170
.حسنًا، لنبدأ

248
00:18:06,170 --> 00:18:08,530
!اسمع يا توموزاكي-سان

249
00:18:08,530 --> 00:18:10,310
ماذا يا نانامي-سان؟

250
00:18:10,310 --> 00:18:15,360
.إنّنا نقوم بهذا منذ سنوات طويلة

251
00:18:15,360 --> 00:18:18,320
.بدأنا هذا الثّنائيّ قبل شهرين فقط

252
00:18:19,690 --> 00:18:22,880
بل ولم نبدأ الحديث مع بعضنا
.إلاّ قبل ذلك بفترة قصيرة

253
00:18:22,880 --> 00:18:25,330
!لا تقل هذا

254
00:18:29,600 --> 00:18:30,710
...على أيّ حال

255
00:18:33,060 --> 00:18:33,940
ماذا؟

256
00:18:42,400 --> 00:18:45,640
ماذا كان يجب أن أقول؟

257
00:18:47,840 --> 00:18:48,650
...لحظة

258
00:18:50,080 --> 00:18:52,310
...عـ-عليّ أن

259
00:18:54,390 --> 00:18:57,230
...عليّ أن أقول شيئًا... أيّ شيء

260
00:18:58,920 --> 00:19:00,140
!توموزاكي-سان

261
00:19:00,860 --> 00:19:03,810
هل تعرف كيف حصلنا على اسمنا؟

262
00:19:03,810 --> 00:19:05,430
...عفوًا

263
00:19:05,430 --> 00:19:10,080
!هذا لأنّ كلانا يحبّ هانيوا

264
00:19:10,080 --> 00:19:12,190
!هانيوانيا

265
00:19:12,830 --> 00:19:16,340
"مهرجان سكيموتو"

266
00:19:17,610 --> 00:19:22,840
إنّها مستعدّة للقيام بذلك لتغطّي
...عن إخفاقي ونسياني لجُملي

267
00:19:23,370 --> 00:19:24,850
!...عليّ القيام بأمر ما

268
00:19:26,330 --> 00:19:29,450
.على أيّ حال، ها نحن نقوم بعرض كوميديّ

269
00:19:29,450 --> 00:19:30,730
!هل تتجاهلني؟

270
00:19:38,740 --> 00:19:46,740
"مهرجان سكيموتو"

271
00:19:39,040 --> 00:19:43,100
،لكن اسمعي يا نانامي-سان
.استطعتُ الحصول على وقت فراغ

272
00:19:43,100 --> 00:19:44,180
.نعم، نعم

273
00:19:47,020 --> 00:19:49,390
.مرّ ذلك على خير

274
00:19:49,390 --> 00:19:50,490
.نعم

275
00:19:51,860 --> 00:19:56,130
لكنّي آسف. نسيت جُملتي قبل
.قليل، وأنت أنقذتني

276
00:19:56,130 --> 00:19:59,010
.لا مشكلة! تلك هي مهمّة الزّوجة

277
00:19:59,270 --> 00:20:01,380
!اسمعي، لسنا متزوّجان

278
00:20:03,010 --> 00:20:04,720
.في المرّة القادمة، الرّامن على حسابي

279
00:20:04,720 --> 00:20:06,390
.حسنًا، مفهوم

280
00:20:07,100 --> 00:20:08,880
.شكرًا لك بالفعل

281
00:20:09,560 --> 00:20:13,200
انتهى كلّ شيء على خير، صحيح؟

282
00:20:13,200 --> 00:20:16,310
لقد أبلينا حسنًا بالنّسبة لمبتدئين، صحيح؟

283
00:20:16,580 --> 00:20:19,360
!هذا صحيح على الأرجح
!أبلينا حسنًا بالتّأكيد

284
00:20:19,810 --> 00:20:22,320
.نعم. هذا صحيح على الأرجح

285
00:20:25,550 --> 00:20:27,600
.من الأفضل أن أذهب

286
00:20:27,600 --> 00:20:29,820
ستذهب للمسرحيّة؟

287
00:20:30,500 --> 00:20:33,250
المسرحيّة مع كيكوتشي-سان؟

288
00:20:33,700 --> 00:20:34,440
.نعم

289
00:20:35,150 --> 00:20:36,000
.سأعود

290
00:20:37,530 --> 00:20:38,560
.بالطّبع

291
00:20:41,260 --> 00:20:43,590
...اسمعي يا ميميمي... أنا

292
00:20:43,590 --> 00:20:44,540
توموزاكي؟

293
00:20:47,180 --> 00:20:49,520
كان العرض الكوميديّ ممتعًا، صحيح؟

294
00:20:52,410 --> 00:20:53,200
.نعم

295
00:20:54,240 --> 00:20:57,580
.لقد استمتعتُ كثيرًا بوقتي بالفعل

296
00:21:02,520 --> 00:21:04,950
.هيّا، عليك الذّهاب

297
00:21:06,300 --> 00:21:06,970
.نعم

298
00:21:21,420 --> 00:21:22,910
...يا إلهي

299
00:21:25,450 --> 00:21:27,840
!انتهى الأمر

300
00:21:31,890 --> 00:21:33,710
...انتهى بالفعل

301
00:21:41,020 --> 00:21:42,020
!كيكوتشي-سان

302
00:21:42,840 --> 00:21:44,110
...توموزاكي-كُن

303
00:21:44,110 --> 00:21:45,740
.سنبدأ قريبًا

304
00:21:48,560 --> 00:21:49,740
.نعم

305
00:21:57,500 --> 00:22:01,500
والآن، سنقدّم عرضًا أصليًّا للفصل 2-2

306
00:22:01,500 --> 00:22:04,410
."بعنوان "طريقتي غير المألوفة للطّيران