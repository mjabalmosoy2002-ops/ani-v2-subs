1
00:00:00,980 --> 00:00:03,480
"بطاقة دعوة خاصّة"
"مهرجان ثانويّة توكوجو الـ73 الثّقافيّ"
"المضيفة: ناريتا تسوغومي"
"الضّيف: توموزاكي فوميا"

2
00:00:05,480 --> 00:00:08,690
"مهرجان توكوجو"

3
00:00:09,260 --> 00:00:12,450
!ما بالك؟ أرخ كتفيك وابتسم! ابتسم

4
00:00:12,450 --> 00:00:13,820
...حاضر

5
00:00:15,330 --> 00:00:19,490
...استطعتُ الخروج مع ميزوساوا. ولكن

6
00:00:19,760 --> 00:00:21,230
.حان وقت تنفيذ مهمّة هينامي

7
00:01:58,460 --> 00:02:00,850
.حسنًا، لنقم ببعض المغازلة أوّلاً

8
00:02:00,850 --> 00:02:03,770
ماذا؟! ماذا عن استطلاع مهرجانهنّ؟

9
00:02:03,770 --> 00:02:05,730
.ذلك ما سنقول أنّنا نفعله هنا

10
00:02:05,730 --> 00:02:08,390
لكن إن أتى صبيّان إلى ثانويّة
،للفتيات فقط

11
00:02:08,870 --> 00:02:10,400
.فهناك سبب واحد لذلك

12
00:02:10,690 --> 00:02:12,230
هل أنت جادّ؟

13
00:02:12,960 --> 00:02:15,630
...ولكن لستُ واثقًا أنّ بإمكاني

14
00:02:16,650 --> 00:02:18,360
!ماذا؟! ميزوساوا؟

15
00:02:18,360 --> 00:02:19,500
!مرحبًا

16
00:02:20,280 --> 00:02:21,960
.ما هذا؟ يبدو لذيذًا

17
00:02:21,960 --> 00:02:23,410
هل أحضرتماه معكما من المنزل؟

18
00:02:23,410 --> 00:02:27,160
!كان ذلك سريعًا
...المنفتحون مميّزون بالفعل

19
00:02:27,420 --> 00:02:30,330
.كلاّ! اشتريناه من هنا

20
00:02:30,330 --> 00:02:34,440
فعلاً؟ ظننتُ أنّكما تحبّان
.غزل البنات كثيرًا فحسب

21
00:02:35,080 --> 00:02:35,920
ماذا تقول؟

22
00:02:35,920 --> 00:02:38,380
قلتُ أنّكما أحضرتماه معكما
.لأنّكما تحبّانه كثيرًا

23
00:02:38,380 --> 00:02:40,500
!وكأنّ ذلك ممكن

24
00:02:41,150 --> 00:02:43,410
عفوًا، هلّي بتذوّقه؟

25
00:02:43,410 --> 00:02:45,070
.لا، لا يمكنك

26
00:02:45,070 --> 00:02:49,100
.عفوًا، لم أكن أسألك أنت
.كان ذلك السّؤال لهذه الفتاة

27
00:02:49,100 --> 00:02:50,910
!أنت لئيم

28
00:02:50,910 --> 00:02:52,630
ستسمحين لي بتذوّقه، صحيح؟

29
00:02:52,630 --> 00:02:54,770
...حسنًا، لا أمانع

30
00:02:56,280 --> 00:02:59,280
!مذهل! مذاقه يشبه غزل البنات

31
00:02:59,280 --> 00:03:01,280
.ذلك لأنّه غزل بنات بالفعل

32
00:03:01,280 --> 00:03:03,910
بالمناسبة، ما الّذي تفعله هنا؟

33
00:03:03,910 --> 00:03:05,710
هل أتيت وحدك؟

34
00:03:05,710 --> 00:03:08,890
.لقد انفصلت عن صديقي هنا في الحقيقة

35
00:03:08,890 --> 00:03:11,370
أبلغاني إن عثرتما عليه، موافقتان؟

36
00:03:11,370 --> 00:03:13,240
.لا نعرف كيف يبدو

37
00:03:13,240 --> 00:03:15,680
.صحيح! سأرسل إليكما صورة له إذًا

38
00:03:15,680 --> 00:03:17,260
.وأخبراني إن رأيتماه

39
00:03:17,260 --> 00:03:19,850
كيف يجب أن نتواصل؟ نتراسل بالبريد؟

40
00:03:19,850 --> 00:03:21,090
!ذلك ليس منطقيًّا

41
00:03:21,090 --> 00:03:23,840
.صحيح. سنستعمل هذا

42
00:03:24,110 --> 00:03:25,080
...عفوًا

43
00:03:25,080 --> 00:03:26,100
ما رأيك؟

44
00:03:26,100 --> 00:03:27,850
إذًا تفضّلان التّراسل بالبريد؟

45
00:03:27,850 --> 00:03:30,960
.لا، سيكون ذلك صعبًا جدًّا

46
00:03:30,960 --> 00:03:34,580
.صحيح. كما لا أريد مشاركة عنوان سكني

47
00:03:34,580 --> 00:03:36,020
ماذا نفعل إذًا؟

48
00:03:36,280 --> 00:03:38,320
.أعتقد أنّ لا بأس من استعمال لايتر

49
00:03:38,320 --> 00:03:39,560
!إنّه أفضل من التّراسل بالبريد

50
00:03:39,560 --> 00:03:40,650
!حسنًا

51
00:03:41,000 --> 00:03:43,290
.أنت بارع جدًّا أيّها الفتى

52
00:03:43,290 --> 00:03:47,200
.كلاّ! أنا قلق على صديقي الضّائع فحسب

53
00:03:47,200 --> 00:03:48,710
.بالطّبع أنت قلق

54
00:03:49,800 --> 00:03:50,780
!إلى اللّقاء

55
00:03:50,780 --> 00:03:52,950
!آمل أن تجد صديقك

56
00:03:55,930 --> 00:03:56,670
ما رأيك؟

57
00:03:57,520 --> 00:03:58,590
ما تقييمي؟

58
00:03:59,870 --> 00:04:02,090
.تستحقّ تقييمًا مثاليًّا

59
00:04:03,520 --> 00:04:06,720
.حسنًا، يبدأ كلّ شيء بالبدء بتلك المحادثة

60
00:04:07,120 --> 00:04:12,480
لا تقتصر جملة المحادثة الأولى
.على ما تقول، بل كيف تقولها

61
00:04:12,480 --> 00:04:14,100
...كيف أقولها

62
00:04:14,480 --> 00:04:17,190
.حسب كلام ميزوساوا، سار الأمر هكذا

63
00:04:17,190 --> 00:04:20,650
عندما يبدأ غريب بالحديث
فجأة لشخص ما

64
00:04:20,650 --> 00:04:22,900
،ليس مستعدًّا ذهنيًّا لتلك المحادثة

65
00:04:22,900 --> 00:04:25,600
.فلن يكون ذلك الشّخص مستعدًّا للاستماع

66
00:04:25,600 --> 00:04:29,450
لكن بعد أن يعترف بك
،ويصير بإمكانك جذب انتباهه

67
00:04:29,450 --> 00:04:31,840
.تجري بينكما أوّل محادثة

68
00:04:31,840 --> 00:04:36,000
.وبمجرّد حدوث ذلك، تحدّثا حيال أيّ شيء

69
00:04:36,000 --> 00:04:38,090
.ويمكن طرح أيّ نوع من الأسئلة

70
00:04:38,090 --> 00:04:39,810
،ومثل مثال غزل البنات قبل قليل

71
00:04:39,810 --> 00:04:43,520
من السّهل الحصول على جواب
...إن تحدّثت عن شيء بحوزة الآخر

72
00:04:43,520 --> 00:04:44,720
.إن كنت سريعًا بما يكفي

73
00:04:45,370 --> 00:04:48,080
بالمناسبة، قمتُ بأشياء ممثالة نوعًا ما

74
00:04:48,080 --> 00:04:50,720
...كجزء من مهمّات هينامي

75
00:04:50,720 --> 00:04:52,470
"رامن"

76
00:04:54,360 --> 00:04:55,520
...عفوًا

77
00:04:55,520 --> 00:04:58,270
هل تحبّ هينامي؟

78
00:04:58,630 --> 00:05:01,400
.أوي؟ نعم، أحبّها

79
00:05:01,900 --> 00:05:03,120
لماذا تسأل؟

80
00:05:03,120 --> 00:05:07,480
كنتَ فقط... تدردش مع
...فتيات أخريات

81
00:05:07,480 --> 00:05:12,420
نعم. الأمر ليس وكأنّنا نتواعد
.في الوقت الحاليّ

82
00:05:12,420 --> 00:05:15,040
...أعلم ذلك، ولكن

83
00:05:15,440 --> 00:05:18,220
.أشعر وكأنّ الأمر ليس صادقًا

84
00:05:18,220 --> 00:05:19,900
صادقًا؟

85
00:05:20,510 --> 00:05:21,550
،أخبرني يا فوميا

86
00:05:22,260 --> 00:05:25,010
ما الّذي يجعل الرّجل جذّابًا؟

87
00:05:25,010 --> 00:05:26,550
...دعني أفكّر

88
00:05:26,940 --> 00:05:31,580
حفاظه على أناقته وهدوئه... وماذا أيضًا؟

89
00:05:31,580 --> 00:05:34,930
وبراعته في تجاذب أطراف
الحديث... وما شابه؟

90
00:05:35,300 --> 00:05:38,050
.ثلاثة أجوبة صحيحة! أحسنت

91
00:05:38,560 --> 00:05:39,440
...ولكن

92
00:05:39,820 --> 00:05:42,700
الجانب الأكثر أهمّيّة من
...أيّ شيء آخر

93
00:05:44,170 --> 00:05:46,320
.الرّجال الجذّابون يجذبون الآخرين

94
00:05:47,150 --> 00:05:47,850
ماذا؟

95
00:05:49,070 --> 00:05:52,580
"نادي الخياطة"

96
00:05:49,710 --> 00:05:53,340
إن كان الرّجل حسن المظهر
،وجذّابًا بشكل معقول

97
00:05:52,580 --> 00:05:55,580
"الحظّ في الحبّ"

98
00:05:53,340 --> 00:05:55,580
.فلن يواجه مشاكل في أن يبدو رائعًا

99
00:05:55,580 --> 00:05:56,620
،إن كان جذّابًا

100
00:05:55,580 --> 00:06:00,830
"رمي الحلقات"

101
00:05:56,620 --> 00:06:00,830
ستشعر الفتيات أنّ عليهنّ التّصرّف
.بسرعة قبل أن تأخذه فتاة أخرى

102
00:06:01,120 --> 00:06:04,840
وهكذا يؤدّي كونك جذّابًا
.إلى جعلك أكثر جاذبيّة

103
00:06:04,840 --> 00:06:07,220
.إنّها دوّامة الجاذبيّة

104
00:06:13,000 --> 00:06:16,350
إلى أن حصلتُ في النّهاية
.على اهتمام أوي بي

105
00:06:16,350 --> 00:06:17,480
!فهمت

106
00:06:17,480 --> 00:06:21,710
باختصار، أنت تغازل كلّ هذه
الفتيات لتعزيز جاذبيّتك

107
00:06:21,710 --> 00:06:24,560
.لتُقرّر هينامي ملاحظتك

108
00:06:24,560 --> 00:06:25,920
.ليس تمامًا

109
00:06:27,010 --> 00:06:30,240
أنا أيضًا أحب الاستمتاع بذلك لأنّي
.أريد ذلك. هذا جزء مهمّ من الأمر

110
00:06:30,240 --> 00:06:30,990
!عيب

111
00:06:32,320 --> 00:06:34,280
.مهلاً، سأصحّح أمرًا واحدًا

112
00:06:35,040 --> 00:06:37,200
.لن تقرّر أوي ملاحظتي

113
00:06:37,200 --> 00:06:39,000
بل سأجعلها تلاحظني، مفهوم؟

114
00:06:39,220 --> 00:06:41,040
...نعم

115
00:06:42,000 --> 00:06:44,000
"في غاية الرّعب"

116
00:06:44,000 --> 00:06:46,000
"منزل مسكون بالأشباح"

117
00:06:46,280 --> 00:06:50,400
!أرى أنّكما قد أتيتما

118
00:06:50,400 --> 00:06:51,250
.مرحبًا

119
00:06:51,250 --> 00:06:52,770
.مـ-مرحبًا

120
00:06:52,770 --> 00:06:55,370
!كبرت لك قرون استشعار

121
00:06:55,370 --> 00:06:58,020
!ليست قرون استشعار، بل آذان

122
00:06:59,010 --> 00:07:02,020
.أنا أرنبة صغيرة ظريفة

123
00:07:02,020 --> 00:07:05,260
.لا تبالين حتّى بمهرجان مدرستك الثّقافيّ إذًا

124
00:07:05,260 --> 00:07:07,370
.اعتبر أذناي تاج لا مبالاة إذًا

125
00:07:08,000 --> 00:07:09,130
تاج ماذا؟

126
00:07:09,130 --> 00:07:12,030
.تفضّلا برؤية أشباحنا

127
00:07:12,400 --> 00:07:14,160
إنّها ليست أشباحًا مخفية
.على وجه الخصوص

128
00:07:14,160 --> 00:07:16,790
...ما كنتُ لأخبر النّاس بذلك

129
00:07:16,790 --> 00:07:18,500
فعلاً؟

130
00:07:18,930 --> 00:07:21,710
كيف الوضع؟
أرأيتما أيّ فتيات ظريفات؟

131
00:07:22,030 --> 00:07:22,800
!ماذا؟

132
00:07:22,800 --> 00:07:26,090
مهلاً، لماذا تفترضين أنّنا هنا
لمغازلة الفتيات؟

133
00:07:26,090 --> 00:07:28,910
...أنتما ولدان في مهرجان مدرسة للفتيات

134
00:07:28,910 --> 00:07:30,960
هل من سبب آخر لوجودكما هنا؟

135
00:07:30,960 --> 00:07:32,830
.حسنًا، الوضع لا بأس به

136
00:07:32,830 --> 00:07:34,270
!كنتُ محقّة إذًا

137
00:07:34,270 --> 00:07:35,580
ماذا عنك يا توموزاكي-سان؟

138
00:07:35,580 --> 00:07:38,810
.أنا؟ لستُ هنا لأغازل أيّ أحد

139
00:07:38,810 --> 00:07:42,310
ليس لديك حبيبة، صحيح؟

140
00:07:42,610 --> 00:07:45,790
.ألق نظرة على فصلي إذًا
.هذه فرصتك الكبيرة

141
00:07:49,340 --> 00:07:50,720
...فرصتي

142
00:07:50,720 --> 00:07:53,670
سمعتَها يا فوميا. هل نذهب؟

143
00:07:53,670 --> 00:07:55,030
.حـ-حسنًا

144
00:07:55,030 --> 00:07:58,040
"المدخل"

145
00:07:55,030 --> 00:07:58,040
.حسنًا. تفضّلا من هنا

146
00:07:58,290 --> 00:08:02,750
"المخرج"

147
00:07:58,630 --> 00:08:01,630
...شكرًا جزيلاً

148
00:08:01,630 --> 00:08:03,730
.لم يكن ذلك مخيفًا أبدًا

149
00:08:03,730 --> 00:08:04,480
.لا

150
00:08:04,480 --> 00:08:06,420
!مرحبًا

151
00:08:06,730 --> 00:08:09,050
.أرى أنّك وجدت صديقك

152
00:08:09,050 --> 00:08:12,050
!مرحبًا يا ماكو-تشان وساياكا-تشان

153
00:08:12,320 --> 00:08:15,000
!متى عرف اسميهما؟

154
00:08:15,000 --> 00:08:16,550
هل جرّبتما المنزل المسكون بالأشباح؟

155
00:08:16,550 --> 00:08:18,970
من فصل تسوغومي؟

156
00:08:18,970 --> 00:08:20,670
.ليس بعد

157
00:08:20,670 --> 00:08:24,310
.لا تفوّتاه أبدًا
.إنّه غير مخيف بشكل فظيع

158
00:08:24,310 --> 00:08:27,120
لكن يجب أن تكون المنازل
!المسكونة بالأشباح مخيفة

159
00:08:27,120 --> 00:08:29,570
.يمكن رؤية كلّ الأشباح أيضًا

160
00:08:29,570 --> 00:08:32,460
...حسنًا، سأحذو حذو ميزوساوا الآن

161
00:08:33,170 --> 00:08:35,810
.إنّه ليس مخيفًا أبدًا

162
00:08:35,810 --> 00:08:37,760
أهذا معقول؟

163
00:08:37,760 --> 00:08:40,720
.نعم! إنّه مفاجئ في الحقيقة

164
00:08:40,720 --> 00:08:42,450
مفاجئ؟

165
00:08:46,360 --> 00:08:48,960
.أعتقد أنّي لستُ مستعدًّا لهذا بعد

166
00:08:48,960 --> 00:08:49,710
!مهلاً

167
00:08:49,710 --> 00:08:52,220
.أراهن أنّك تبدين رائعة بتلك النّظّارات

168
00:08:52,220 --> 00:08:53,170
هلاّ ارتديتِها للحظة؟

169
00:08:53,170 --> 00:08:54,220
ماذا؟

170
00:08:56,090 --> 00:08:57,680
!أنيقة بالفعل

171
00:08:57,680 --> 00:08:59,100
...يا للمجاملة

172
00:08:59,380 --> 00:09:01,000
هل هي جائزة من نوع ما؟

173
00:09:01,000 --> 00:09:02,640
.نعم، من كشك رمي الحلقات

174
00:09:02,640 --> 00:09:03,980
.وهذه أيضًا

175
00:09:07,310 --> 00:09:10,940
ستبدو تلك النّظّارات رائعة عليك
.أيضًا يا ميزوساوا

176
00:09:15,790 --> 00:09:16,470
ما رأيكم؟

177
00:09:17,070 --> 00:09:19,080
!تناسبك تمامًا

178
00:09:19,080 --> 00:09:21,260
...ليت نبرتك تماشت مع مجاملتك

179
00:09:21,260 --> 00:09:23,580
!تبدو رائعًا بحقّ يا ميزوساوا

180
00:09:24,020 --> 00:09:25,840
لماذا لا ألتقط لك صورة؟

181
00:09:25,840 --> 00:09:28,490
!فكرة ممتازة! تفضّل بذلك

182
00:09:28,490 --> 00:09:30,780
.تعاليا أنتما أيضًا

183
00:09:32,080 --> 00:09:33,340
!يا لك من لعوب

184
00:09:33,340 --> 00:09:35,400
أيمكننا نشرها على بينستا؟

185
00:09:35,400 --> 00:09:38,140
.لقد شرع بذلك مؤخّرًا فحسب

186
00:09:38,140 --> 00:09:39,600
...حسنًا

187
00:09:39,600 --> 00:09:41,230
.لا أمانع

188
00:09:41,230 --> 00:09:43,310
!حسنًا، سألتقط الصّورة

189
00:09:43,310 --> 00:09:44,640
!ابتسما

190
00:09:44,640 --> 00:09:45,680
!أكيد

191
00:09:49,420 --> 00:09:51,800
تُعتبر هذه نظّارات، صحيح؟

192
00:09:53,190 --> 00:09:55,690
"مهرجان توكوجو"

193
00:09:55,920 --> 00:09:59,200
.أردتُ أن أرى كيف ستُبلي هناك يا فوميا

194
00:09:59,500 --> 00:10:01,950
.ليس في مستواي الحاليّ

195
00:10:02,240 --> 00:10:04,110
مستواك الحاليّ؟

196
00:10:04,580 --> 00:10:07,220
.لا تقلّل من قدر نفسك

197
00:10:07,220 --> 00:10:10,290
هل تقرأ كتب تحسين الذّات أو ما شابه؟

198
00:10:10,290 --> 00:10:12,340
.ذلك واضح عليك

199
00:10:13,460 --> 00:10:15,340
ألم تدرك الأمر؟

200
00:10:15,760 --> 00:10:21,850
،إنّك تطرح أسئلة أكثر مؤخّرًا
.بل وأسئلة محدّدة

201
00:10:22,080 --> 00:10:26,220
كما عثرتَ أيضًا على إيقاع جيّد
.يجعل من السّهل الحديث معك

202
00:10:26,220 --> 00:10:27,310
فعلاً؟

203
00:10:27,310 --> 00:10:28,340
.فعلاً، فعلاً

204
00:10:28,860 --> 00:10:29,980
.هكذا إذًا

205
00:10:30,680 --> 00:10:35,760
إنّ تقدّمًا سريعًا كهذا بالنّسبة
...لشخص غريب جدًّا مثلك

206
00:10:35,760 --> 00:10:39,070
يعني أنّك بذلت الكثير من الجهد
.خطوة خطوة

207
00:10:43,250 --> 00:10:46,080
،يمكنك محاولة إخفاء الأمر
.لكنّك كالكتاب المفتوح لي

208
00:10:47,030 --> 00:10:51,040
.والعمل بهذا الجدّ أمر يستحقّ الإعجاب

209
00:10:51,390 --> 00:10:52,180
...أنا

210
00:10:52,180 --> 00:10:53,900
.أشكرك

211
00:10:54,380 --> 00:10:56,550
...هذا الشّعور بالتّحديد

212
00:10:56,960 --> 00:10:58,980
.عندما يقول شخص ما أمورًا كهذه لك

213
00:10:59,510 --> 00:11:02,390
.هكذا عليك الحديث مع الفتيات

214
00:11:02,660 --> 00:11:04,590
...أيّها الـ

215
00:11:05,630 --> 00:11:06,890
.إلى اللّقاء يا فوميا

216
00:11:07,650 --> 00:11:11,270
حتّى خطاب ميزوساوا الأخير
،كان مخفيًّا تحت غطاء المزاح

217
00:11:11,560 --> 00:11:15,740
كنتُ مسرورًا لأنّ أحدًا ما
.تعرّف على مجهوداتي

218
00:11:26,280 --> 00:11:28,290
"صورة مع كيكوتشي فوكا"

219
00:11:28,530 --> 00:11:29,760
توموزاكي-كُن؟

220
00:11:30,660 --> 00:11:32,200
.أعتذر على التّأخير

221
00:11:38,400 --> 00:11:40,420
عفوًا... ما رأيك؟

222
00:11:41,030 --> 00:11:45,890
.تقديم كلّ شخصيّة وصفاتها منظّم للغاية

223
00:11:45,890 --> 00:11:47,380
!تبدو رائعة

224
00:11:47,380 --> 00:11:50,130
بإمكاننا الآن الانتقال لاختيار
.الأزياء وما شابه

225
00:11:50,130 --> 00:11:51,910
.كم سرّني هذا

226
00:11:51,910 --> 00:11:54,560
...لكن عليّ أن أسأل

227
00:11:54,560 --> 00:11:58,600
كم من الوقت لدينا للأداء؟

228
00:11:58,600 --> 00:12:01,820
.سؤال وجيه. سأتحقّق من ذلك

229
00:12:01,820 --> 00:12:07,770
حسنًا، افعل رجاءً. سأحتاج لتعديل
.الأمور مع أخذ ذلك الوقت في الاعتبار

230
00:12:08,500 --> 00:12:12,230
،إن كان عليّ جعلها أقصر
...فسأحتاج لحذف بعض الأمور

231
00:12:14,600 --> 00:12:16,920
.أتطلّع قدمًا لهذا المهرجان الثّقافيّ

232
00:12:17,400 --> 00:12:22,540
وكذلك أنا. كنتُ غير مبالية
.به حتّى هذه السّنة

233
00:12:21,800 --> 00:12:27,050
"طريقتي غير المألوفة للطّيران"

234
00:12:23,030 --> 00:12:25,530
لا أصدّق أنّ التّطرّق لها بهذا القدر

235
00:12:25,530 --> 00:12:28,370
.كفيل بتغيير وجهة نظري لهذه الدّرجة

236
00:12:32,320 --> 00:12:35,690
،أخبريني يا كيكوتشي-سان
ما رأيك أن نأخذ صورة معًا؟

237
00:12:35,970 --> 00:12:37,440
صورة؟

238
00:12:37,800 --> 00:12:40,860
نعم، للاحتفال باستعدادنا للعمل
!بجدّ على المسرحيّة

239
00:12:40,860 --> 00:12:43,760
.وسنُظهر النّصّ في الصّورة أيضًا

240
00:12:45,070 --> 00:12:48,280
...حسنًا. سيسرّني ذلك

241
00:12:48,600 --> 00:12:50,960
...حسنًا إذًا. لنقم بذلك

242
00:12:50,960 --> 00:12:52,550
هل يمكنني الجلوس قربك؟

243
00:12:52,550 --> 00:12:54,400
.نـ-نعم

244
00:12:54,400 --> 00:12:55,540
...حـ-حسنًا

245
00:12:58,770 --> 00:13:00,160
!أنا آسف

246
00:13:00,160 --> 00:13:02,460
.لا، لا عليك

247
00:13:05,290 --> 00:13:06,910
أنلتقط الصّورة؟

248
00:13:06,910 --> 00:13:08,500
!حـ-حسنًا! لنلتقطها

249
00:13:09,280 --> 00:13:11,140
...حسنًا، استعدّي

250
00:13:11,140 --> 00:13:12,740
...حاضرة

251
00:13:15,690 --> 00:13:17,520
.سأرسلها لك لاحقًا

252
00:13:18,350 --> 00:13:19,160
.حسنًا

253
00:13:20,900 --> 00:13:22,780
"غرفة الخياطة"

254
00:13:23,450 --> 00:13:24,900
!أنت تبلي حسنًا

255
00:13:24,900 --> 00:13:27,290
.حصلت على إعجابات بما يكفي

256
00:13:27,290 --> 00:13:28,530
.أعتقد ذلك

257
00:13:28,880 --> 00:13:32,440
.ومع ذلك، لم أتوقّع أن ينتهي الأمر هكذا

258
00:13:33,300 --> 00:13:35,540
لا يهمّ أيّ نوع من النّظّارات، صحيح؟

259
00:13:35,790 --> 00:13:37,480
.معك حقّ

260
00:13:37,480 --> 00:13:41,200
إضافة للصّورة مع فوكا-تشان
،الّتي أريتني إيّاها البارحة

261
00:13:41,200 --> 00:13:44,300
.تكون قد أنهيت كلّ مهمّاتك
!تهانيّ لك

262
00:13:41,550 --> 00:13:44,300
"!مهمّة ثانويّة: اكتملت"
"إنشاء حساب على بينستاغرام والتّرويج لنفسك"

263
00:13:44,560 --> 00:13:45,500
!شكرًا لك

264
00:13:45,500 --> 00:13:48,080
ألن تنشر صورتك مع فوكا-تشان؟

265
00:13:48,080 --> 00:13:50,600
.قالت أنّها خجولة جدًّا

266
00:13:50,600 --> 00:13:52,730
.أعتقد ذلك

267
00:13:52,730 --> 00:13:58,600
ومع ذلك، لم أعتقد أنّكم ستؤدّون
.مسرحيّة من تأليف فوكا-تشان

268
00:13:58,900 --> 00:14:03,570
أعلم أنّي أخبرتك أن تشارك
...في المهرجان بحماسة، لكن

269
00:14:03,570 --> 00:14:07,650
كنتُ لأرغب في القيام بذلك
.حتّى لو لم يكن مرتبطًا بمهمّة ما

270
00:14:07,990 --> 00:14:12,740
جيّد، كلّ شيء مسموح به
.إنّ كان سيوصلك إلى أهدافك

271
00:14:14,020 --> 00:14:15,370
أخبريني يا هينامي؟

272
00:14:15,660 --> 00:14:19,370
أنت مهتمّة جدًّا بمساعدتي
.على عيش حياة طبيعيّة

273
00:14:19,370 --> 00:14:20,660
لماذا ذلك؟

274
00:14:22,980 --> 00:14:27,260
."ألا تذكر أوّل لقاء بين ناناشي و"لا اسم

275
00:14:27,970 --> 00:14:32,790
كنتَ لا تؤمن أبدًا بتغيّر الشّخصيّات
،في الحياة الحقيقيّة

276
00:14:32,790 --> 00:14:34,470
.وأنّها كانت مسألة فئات

277
00:14:34,960 --> 00:14:37,850
.نعم، هذا صحيح

278
00:14:38,140 --> 00:14:42,860
استمعتُ جيّدًا لك وأردتُ
.إثبات أنّي كنتُ محقّة

279
00:14:43,130 --> 00:14:44,500
.هذا كلّ شيء

280
00:14:46,350 --> 00:14:47,180
ماذا؟

281
00:14:47,870 --> 00:14:49,860
.يبدو أنّك لا تصدّقني

282
00:14:50,110 --> 00:14:51,240
—كـ-كلاّ

283
00:14:51,490 --> 00:14:53,870
.أنا لا أتقبّل الخسارة

284
00:14:54,800 --> 00:14:56,630
.حسنًا، أنا أصدّقك

285
00:14:56,630 --> 00:14:58,250
.لكن لا تهتمّ لذلك

286
00:14:58,810 --> 00:15:01,250
هل قرّرت مع من تريد الخروج في موعد؟

287
00:15:01,250 --> 00:15:02,780
...بشأن ذلك

288
00:15:02,780 --> 00:15:06,470
،قلتَ أنّك أردتَ الانتظار
.لذلك منحتك مدّة معتبرة

289
00:15:06,470 --> 00:15:08,850
أنت تفكّر بالأمر بالفعل، صحيح؟

290
00:15:08,850 --> 00:15:11,130
...نعم... أظنّ ذلك

291
00:15:14,140 --> 00:15:21,520
"هدف صغير: لِمن تريد التّقرّب أكثر؟"

292
00:15:14,610 --> 00:15:17,120
.سأحتاج ردّك قريبًا

293
00:15:17,120 --> 00:15:20,260
اختر على الأقلّ فتاتان تريد
.الخروج معهما في موعد

294
00:15:20,260 --> 00:15:21,520
مفهوم؟

295
00:15:22,930 --> 00:15:24,270
.نعم

296
00:15:25,480 --> 00:15:26,650
!برين

297
00:15:26,650 --> 00:15:30,150
!اقبل ولا تسأل عن السّبب رجاءً

298
00:15:30,150 --> 00:15:34,200
.فجأة هكذا؟ مستحيل! أحتاج للسّبب

299
00:15:34,450 --> 00:15:38,620
يبدو أنّ نادي المضمار والميدان يتحدّثون

300
00:15:38,620 --> 00:15:41,210
.عن تأدية عرض كوميديّ في المهرجان الثّقافيّ

301
00:15:41,450 --> 00:15:44,080
.لكنّي لستُ من النّادي

302
00:15:44,080 --> 00:15:48,340
لا بأس! حصلتُ على إذن ليُشارك
.تلاميذ من خارج النّادي

303
00:15:48,340 --> 00:15:51,220
!أنت الوحيد الّذي يمكنه الرّدّ عليّ بشكل مباشر

304
00:15:52,100 --> 00:15:54,970
لذلك... هلاّ قمت بهذا معي؟

305
00:15:56,180 --> 00:15:57,470
أرجوك؟

306
00:15:59,600 --> 00:16:04,690
"أظهر أقصى قدر من الحماسة على كلّ الجبهات"

307
00:15:59,930 --> 00:16:04,690
إظهار أقصى قدر من الحماسة"
".على كلّ الجبهات

308
00:16:05,140 --> 00:16:06,690
.حسنًا، لا بأس

309
00:16:06,690 --> 00:16:09,100
—بربّك، هل من طريقة قد

310
00:16:09,100 --> 00:16:09,570
...مهلاً

311
00:16:09,970 --> 00:16:10,820
!ماذا؟

312
00:16:10,820 --> 00:16:14,300
أنت من سألني. لماذا تفاجأتِ؟

313
00:16:14,300 --> 00:16:17,440
!كان ذلك سريعًا وسهلاً

314
00:16:17,440 --> 00:16:18,490
...مهلاً لحظة

315
00:16:18,810 --> 00:16:23,500
أرى أنّك لا تستطيع نسيان ثنائيّ الزّوجين
الكوميديّ خاصّتنا، صحيح يا توموزاكي؟

316
00:16:23,500 --> 00:16:25,250
.بل يمكن نسيانه بسهولة

317
00:16:26,840 --> 00:16:30,400
...هذا هو المتوقّع من شريكي

318
00:16:30,400 --> 00:16:32,220
...يا له من ردّ مباشر سريع

319
00:16:32,530 --> 00:16:37,500
لكن لن يكون لدينا الكثير من الوقت
.للتّدرّب بسبب المسرحيّة وما إلى ذلك

320
00:16:37,500 --> 00:16:38,600
!لا تقلق

321
00:16:39,020 --> 00:16:42,100
!دع الأمر لي فحسب

322
00:16:43,550 --> 00:16:45,600
.مرحبًا يا ميميمي

323
00:16:45,920 --> 00:16:47,850
!صباح الخير يا تاكاهيرو

324
00:16:47,850 --> 00:16:49,200
.وكذلك أنت يا فوميا

325
00:16:49,200 --> 00:16:50,780
!ألا أستحقّ ترحيبًا محترمًا؟

326
00:16:52,600 --> 00:16:54,720
.لديّ أخبار من غومي

327
00:16:54,720 --> 00:16:56,320
.سوف تحضر مهرجاننا

328
00:16:56,320 --> 00:16:58,030
فعلاً، غومي-تشان ستحضر؟

329
00:16:59,530 --> 00:17:00,950
غومي-تشان؟

330
00:17:03,920 --> 00:17:07,810
تحتاجين لإعادة كتابة قصّتك
،القصيرة في نصّ المسرحيّة

331
00:17:08,320 --> 00:17:10,670
لكن ما زلتِ تواجهين مشاكل
في ذروة الأحداث؟

332
00:17:11,000 --> 00:17:12,670
.نـ-نعم

333
00:17:14,160 --> 00:17:18,680
عفوًا... ما المشاكل الّتي تواجهينها بالضّبط؟

334
00:17:18,960 --> 00:17:25,270
لا أستطيع أن أقرّر إن كان على البطل ليبرا
...أن ينتهي به المطاف مع كريس أو ألوسيا

335
00:17:25,270 --> 00:17:29,190
.وما الّذي يجب أن يحدث لمن لن يختارها

336
00:17:29,490 --> 00:17:35,150
أعتقد أنّني قد أكون خائفة
.من أخذ ذلك القرار

337
00:17:36,150 --> 00:17:40,910
خائفة من فرض أنّ العلاقة بين الثّلاثة
.يجب أن تسير في اتّجاه واحد معيّن

338
00:17:42,910 --> 00:17:44,500
،في تلك الحالة

339
00:17:45,030 --> 00:17:48,110
،وقد لا يكون هذا تفكيري

340
00:17:49,520 --> 00:17:53,420
مَن مِن الاثنتين قد تختارين
إن كان القرار راجعًا لك؟

341
00:17:54,980 --> 00:17:57,430
.لا أعتقد أنّ بإمكاني أن أختار

342
00:17:58,290 --> 00:17:59,550
لا يمكنك؟

343
00:17:59,550 --> 00:18:05,200
.ربّما لديّ فكرة عما قد أفعله شخصيًّا

344
00:18:05,200 --> 00:18:07,810
لكن ماذا عليّ فعله فيما يتعلّق بالقصّة؟

345
00:18:07,810 --> 00:18:17,570
"طريقتي غير المألوفة للطّيران"

346
00:18:08,530 --> 00:18:14,240
ما المكان الّذي عليّ إيصال الشّخصيّات
إليه بحيث يكون الأفضل لعالمهم؟

347
00:18:14,240 --> 00:18:17,570
.عليّ أخذ مثل هذه الأمور في عين الاعتبار

348
00:18:17,570 --> 00:18:21,070
الأفضل لعالمهم؟

349
00:18:21,070 --> 00:18:26,080
أشعر أنّي غير صادقة إذا ما حاولت
.السّماح لمشاعري بالتّدخّل

350
00:18:32,320 --> 00:18:34,710
عفوًا يا توموزاكي-كُن؟

351
00:18:35,880 --> 00:18:41,010
هل هنالك من أنت معجب بها؟

352
00:18:41,610 --> 00:18:42,850
أ-أنا؟

353
00:18:43,200 --> 00:18:45,810
.نعم، أنت

354
00:18:45,810 --> 00:18:49,940
.أ-أنا... هذا سؤال وجيه

355
00:18:51,440 --> 00:18:56,690
إن كان لديك أكثر من شخص
،مميّز في حياتك

356
00:18:56,690 --> 00:19:00,120
...وبإمكانك اختيار واحد فقط

357
00:19:01,460 --> 00:19:05,580
كيف بإمكانك الاختيار؟

358
00:19:09,280 --> 00:19:12,580
ربّما تريدين جوابًا صريحًا...؟

359
00:19:12,870 --> 00:19:13,670
.نعم

360
00:19:14,870 --> 00:19:16,320
...أعتقد أنّي

361
00:19:16,830 --> 00:19:20,590
لستُ في وضع يسمح لي
.بأخذ ذلك القرار من الأساس

362
00:19:23,180 --> 00:19:26,920
.صحيح. هذا هو ما أشعر به بالفعل

363
00:19:27,970 --> 00:19:31,190
تُواصل هينامي الضّغط عليّ
،بشأن من أختار

364
00:19:31,520 --> 00:19:35,190
حتّى أنّها فكّرت في فرضيّة
.اعتراف الفتيات لي بحبّهن

365
00:19:35,190 --> 00:19:39,260
.لكنّي استمررتُ في تأجيل جوابي

366
00:19:39,260 --> 00:19:42,770
.لأنّ هذا هو ما أشعر به في أعماقي

367
00:19:43,450 --> 00:19:48,240
طوال 17 سنة، نُقشت طبيعة الفئة
.السّفلى هذه في أعماق روحي

368
00:19:48,820 --> 00:19:53,960
،أنا لستُ من يتمّ اختياره
.لذلك لن أكون من قد يختار

369
00:19:55,040 --> 00:19:57,870
عندما قدّمت لي هينامي فرضيّة
،الاعتراف بالحبّ تلك

370
00:19:57,870 --> 00:20:00,220
فإنّ ما طغى على ذهني حينها

371
00:20:00,220 --> 00:20:03,720
...كان ندمًا لا يوصف، شعور بالذّنب

372
00:20:04,440 --> 00:20:08,160
شخصيّة من الفئة السّفلى مثلك"
".يُتاح لها الاختيار؟ لا تغترّ بنفسك

373
00:20:09,000 --> 00:20:12,480
بمعنى آخر، شعور كامن بعدم الكفاءة

374
00:20:12,480 --> 00:20:15,720
.يتحكّم في أفكاري في لعبة الحياة هذه

375
00:20:16,270 --> 00:20:20,360
.وقد عشّش ذلك عميقًا بداخلي

376
00:20:21,420 --> 00:20:23,490
.هكذا إذًا

377
00:20:23,760 --> 00:20:24,430
.نعم

378
00:20:25,060 --> 00:20:30,340
لذلك أجد الحديث في مثل
.هذه الأمور صعبًا جدًّا

379
00:20:30,860 --> 00:20:33,500
.أنا آسف جدًّا لأنّي لم أستطع المساعدة

380
00:20:59,610 --> 00:21:00,360
!برين

381
00:21:02,160 --> 00:21:04,960
!ميميمي؟ لا تخيفيني هكذا

382
00:21:04,960 --> 00:21:06,860
.إنّه خطؤك لأنّ دفاعاتك مرخيّة

383
00:21:07,180 --> 00:21:08,480
ماذا تقولين؟

384
00:21:08,480 --> 00:21:10,990
.أرى أنّك غادرت متأخّرًا كثيرًا

385
00:21:10,990 --> 00:21:14,250
هل كان الحديث مع
كيكوتشي-سان مثيرًا لهذا الحدّ؟

386
00:21:14,510 --> 00:21:18,250
.نعم... أظنّ ذلك

387
00:21:28,560 --> 00:21:29,890
.حسنًا، إلى اللّقاء

388
00:21:30,130 --> 00:21:31,760
...بالمناسبة أيّها المنافس توموزاكي

389
00:21:31,760 --> 00:21:32,890
ما-ماذا؟

390
00:21:33,250 --> 00:21:36,390
من تكون هذه المدعوّة غومي-تشان؟

391
00:21:37,050 --> 00:21:40,770
.إنّها زميلة عمل لنا أنا وميزوساوا

392
00:21:40,770 --> 00:21:43,280
فعلاً؟ ولا يوجد أيّ شيء آخر بينكما؟

393
00:21:43,280 --> 00:21:45,510
!يبدو لي هذا مريبًا

394
00:21:45,510 --> 00:21:49,740
أخبرتني مصادري أنّك ذهبت
.إلى مهرجان مدرستها الثّقافيّ

395
00:21:50,060 --> 00:21:52,480
.نعم، لأنّها دعتنا

396
00:21:52,480 --> 00:21:56,360
!هذا مريب بالفعل
!إنّها ترتاد مدرسة للفتيات فقط

397
00:21:56,360 --> 00:21:58,610
وما علاقة هذا بالأمر؟

398
00:21:59,750 --> 00:22:01,250
...إنّ الأمر فقط

399
00:22:01,940 --> 00:22:05,510
أنّك لا تبدو من النّوع الّذي يذهب
.لمهرجانات مدارس الفتيات فقط

400
00:22:06,290 --> 00:22:09,260
وكأنّهم سيعتقلونني إن ذهبت
.لمدرسة للفتيات فقط

401
00:22:09,780 --> 00:22:12,250
...يا إلهي، ها أنت تفعل هذا ثانية

402
00:22:12,250 --> 00:22:13,760
أفعل ماذا بالضّبط؟

403
00:22:14,500 --> 00:22:15,770
!لا تهتمّ

404
00:22:17,320 --> 00:22:23,730
يا إلهي، عندما تكون رائعًا، فأنت
...رائع، ولكن عندما لا تكون

405
00:22:23,730 --> 00:22:25,080
فعلاً؟

406
00:22:25,080 --> 00:22:27,150
مهلاً، هل تقولين أنّي رائع أحيانًا؟

407
00:22:27,150 --> 00:22:28,860
!بالطّبع

408
00:22:28,860 --> 00:22:32,990
،إنّك تحبّ مساعدة الآخرين بشتّى الطّرق
!مثل ما فعلته مع تاما وما إلى ذلك

409
00:22:33,310 --> 00:22:35,200
.هكذا إذًا

410
00:22:36,900 --> 00:22:39,710
.أنا أحترمك كثيرًا يا برين

411
00:22:39,950 --> 00:22:40,710
...ما

412
00:22:40,970 --> 00:22:43,710
سبق وأخبرتك أنّك تشبه تاما، صحيح؟

413
00:22:43,710 --> 00:22:46,460
إنّك جاهز لبذل كلّ جهدك
،رغم أنّ من السّهل إخافتك

414
00:22:46,460 --> 00:22:49,720
.وتتطرّق لما تريد القيام به مباشرة

415
00:22:51,470 --> 00:22:52,470
...وكأنّك

416
00:22:52,860 --> 00:22:58,350
تنطلق وتقوم بكلّ تلك الأمور الّتي أريد
.أنا القيام بها، ولكن لا أستطيع

417
00:22:58,600 --> 00:23:00,620
.أجد ذلك أمرًا مذهلاً بالفعل

418
00:23:01,950 --> 00:23:04,360
...وهذا بالضّبط

419
00:23:05,620 --> 00:23:07,360
.هو ما أحبّه فيه

420
00:23:12,770 --> 00:23:16,280
ظننتَ للتّوّ أنّي أخبرتك أنّي أحبّك
بتلك" الطّريقة، صحيح؟"

421
00:23:16,280 --> 00:23:18,840
.كلاّ... يا إلهي منك

422
00:23:19,750 --> 00:23:23,330
.لكنّي بالفعل... أحبّك بتلك الطّريقة

423
00:23:28,180 --> 00:23:28,970
!إلى اللّقاء

424
00:23:38,230 --> 00:23:38,940
!ماذا؟