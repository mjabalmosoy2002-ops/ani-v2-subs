1
00:00:02,260 --> 00:00:03,980
...أخبرني مصدر موثوق

2
00:00:04,330 --> 00:00:06,610
.أنّ ميميمي أخبرتك أنّها تحبّك

3
00:00:06,960 --> 00:00:10,230
.نعم. آسف لأنّي أخفيت الأمر عنك

4
00:00:10,480 --> 00:00:12,900
...لا بأس. أمّا الآن

5
00:00:13,410 --> 00:00:16,410
،بينما تتقدّم في خريطة الأحداث خاصّتك

6
00:00:16,410 --> 00:00:18,910
،فستركّز على فوكا-تشان الآن

7
00:00:18,910 --> 00:00:21,910
الحدث 1
الحدث 2
الحدث 3
الحدث 4
الهدف

8
00:00:18,910 --> 00:00:21,910
نانامي ميميمي

9
00:00:19,210 --> 00:00:21,910
.بما أنّك حقّقت هدفك سلفًا مع ميميمي

10
00:00:21,910 --> 00:00:24,920
...ها أنت تستعملين عبارة "هدف" ثانية

11
00:00:24,920 --> 00:00:27,290
،ومع ذلك، إن أردتَ طبعًا

12
00:00:27,290 --> 00:00:32,260
نانامي ميميمي

13
00:00:27,660 --> 00:00:30,800
يمكنك اعتبار كلّ الخطوات
.مع ميميمي قد تمّت

14
00:00:29,840 --> 00:00:32,260
الهدف
الحدث 5
الحدث 6
الحدث 7
الحدث 8

15
00:00:32,530 --> 00:00:34,220
ماذا؟ فعلاً؟

16
00:00:35,220 --> 00:00:38,220
يبدو أنّك تفضّل بالفعل
التّحدّيات الّتي تتزامن

17
00:00:38,220 --> 00:00:40,830
.مع ما تريد فعله

18
00:02:12,880 --> 00:02:13,980
،في البداية وقبل كلّ شيء

19
00:02:14,480 --> 00:02:16,490
.سنقرّر من سيؤدّي الأدوار

20
00:02:16,490 --> 00:02:18,740
:الأدوار
ليبرا
كريس

21
00:02:16,960 --> 00:02:18,740
.سنبدأ بدور البطل، ليبرا

22
00:02:19,280 --> 00:02:20,490
كيف هو البطل؟

23
00:02:20,760 --> 00:02:21,720
...إنّ ليبرا

24
00:02:21,720 --> 00:02:24,260
.بارع في تقليل المسافة بينه وبين الآخرين

25
00:02:24,260 --> 00:02:27,750
.إنّه يراعي الآخرين وذكيّ ويملؤه الفضول

26
00:02:28,200 --> 00:02:30,620
هذا أنا! ومن قد يكون غيري؟

27
00:02:30,620 --> 00:02:33,630
تاكي: 1
تاتشيبانا: 10
ميزوساوا: 23

28
00:02:33,630 --> 00:02:35,630
!الدّور لتاكاهيرو إذًا

29
00:02:35,630 --> 00:02:37,760
ماذا؟! لماذا؟

30
00:02:39,260 --> 00:02:45,270
،لستُ واثقًا تمامًا أنّ الدّور مناسب لي
...لكن بما أنّه صار لي الآن

31
00:02:45,270 --> 00:02:46,770
.فسأقوم به بكلّ فخر

32
00:02:46,770 --> 00:02:48,890
ليبرا: ميزوساوا
كريس
ألوسيا

33
00:02:47,200 --> 00:02:48,890
.الدّور التّالي هو كريس

34
00:02:49,200 --> 00:02:54,650
،كريس خوّافة ولكنّها بريئة
.وتتمتّع بصفات الأطفال قليلاً

35
00:02:54,650 --> 00:02:57,650
سينو: 5
كاشيوازاكي: 9
ناتسوباياشي: 20

36
00:02:57,650 --> 00:02:59,780
!الدّور لتاما-تشان إذًا

37
00:03:00,040 --> 00:03:02,280
.حسنًا. سأبذل جهدي

38
00:03:02,530 --> 00:03:04,910
.آخر شخصيّة رئيسيّة متبقّية هي ألوسيا

39
00:03:05,160 --> 00:03:08,070
،إنّها بارعة وسريعة البديهة

40
00:03:08,070 --> 00:03:10,920
.الفتاة المثاليّة الّتي يمكن للجميع الاعتماد عليها

41
00:03:13,680 --> 00:03:14,920
...هذا يعني

42
00:03:15,470 --> 00:03:16,320
.الأمر واضح

43
00:03:20,670 --> 00:03:22,930
ليبرا: ميزوساوا
كريس: ناتسوباياشي
ألوسيا: هينامي

44
00:03:21,010 --> 00:03:22,930
!حسنًا، الدّور لأوي إذًا

45
00:03:23,270 --> 00:03:26,430
!لنصفّق لشخصيّاتنا الرّئيسيّة الثّلاثة

46
00:03:27,930 --> 00:03:29,430
!حضًّا سعيدًا

47
00:03:28,400 --> 00:03:29,430
!بالتّوفيق

48
00:03:28,770 --> 00:03:30,160
!لا أطيق الانتظار

49
00:03:30,940 --> 00:03:37,940
"مسرحيّة | مقهى المانغا"

50
00:03:31,220 --> 00:03:35,610
حسنًا، هذه هي الطّريقة الّتي سنقسّم بها
.الأمور بين المسرحيّة ومقهى المانغا

51
00:03:38,750 --> 00:03:41,700
.شكرًا يا توموزاكي-كُن

52
00:03:42,930 --> 00:03:47,580
.هذا ممتع نوعًا ما
،بما أنّنا حدّدنا الممثّلين

53
00:03:47,580 --> 00:03:50,080
...تراودني الكثير من الأفكار الآن

54
00:03:50,320 --> 00:03:51,500
هكذا إذًا؟

55
00:03:51,500 --> 00:03:52,970
!بـ-برين

56
00:03:53,680 --> 00:03:56,090
!علينا عقد اجتماع خاصّ بنا

57
00:03:56,090 --> 00:03:58,340
!لكنّي لستُ واثقة من أنّ الوقت يكفينا

58
00:03:58,340 --> 00:04:01,090
.صحيح! العرض الكوميديّ

59
00:04:01,090 --> 00:04:05,470
!هذا صحيح يا برين
!هل نسيت أيّها السّيّد المشغول؟

60
00:04:05,470 --> 00:04:07,350
.آسف... أنا بالفعل مشغول

61
00:04:07,700 --> 00:04:10,870
حسنًا، إنّك تُخرج مسرحيّة
.الفصل قبل كلّ شيء

62
00:04:10,870 --> 00:04:16,060
سأسهّل عليك الأمر، ما رأيك
أن نتقابل بعد المدرسة اليوم؟

63
00:04:16,060 --> 00:04:18,320
كيف سيسهّل ذلك الأمور عليّ؟

64
00:04:18,700 --> 00:04:20,780
لا تمانعين هذا، صحيح يا كيكوتشي-سان؟

65
00:04:21,680 --> 00:04:23,040
.إطلاقًا

66
00:04:26,630 --> 00:04:29,440
حسنًا، ماذا علينا أن نفعل؟

67
00:04:29,440 --> 00:04:32,120
صـ-صحيح يا توموزاكي... ماذا؟

68
00:04:32,400 --> 00:04:34,750
هل لديك أيّ اقتراحات؟

69
00:04:35,020 --> 00:04:40,960
عفوًا... كنتُ أفكّر في روتين
...الثّنائيّ المتزوّج

70
00:04:40,960 --> 00:04:42,720
...ثنائيّ متزوّج

71
00:04:43,010 --> 00:04:46,470
.لكنّي غيّرت رأيي بعد ذلك

72
00:04:47,190 --> 00:04:48,880
...حسنًا

73
00:04:50,950 --> 00:04:51,970
...اسمع

74
00:04:53,380 --> 00:04:56,310
لقد أخبرتك، صحيح؟

75
00:04:56,560 --> 00:04:58,980
...عفوًا... تقصدين

76
00:04:59,720 --> 00:05:01,480
.أنّني أحبّك

77
00:05:01,710 --> 00:05:03,360
...صحيح

78
00:05:03,610 --> 00:05:09,370
ما الّذي دار في ذهنك؟
.أقصد... عندما أخبرتك

79
00:05:09,890 --> 00:05:14,120
.عفوًا... كنتُ سعيدًا. بشدّة

80
00:05:14,640 --> 00:05:15,400
.نعم

81
00:05:16,450 --> 00:05:18,380
...ولكن بصراحة

82
00:05:18,380 --> 00:05:23,630
.ما زلت غير واثق ما العمل بالضّبط الآن

83
00:05:24,400 --> 00:05:25,720
...هكذا إذًا

84
00:05:25,720 --> 00:05:28,390
—ومع ذلك، على الأرجح أنّك

85
00:05:30,330 --> 00:05:33,760
!مهلاً، ألا بأس بهذا؟
أنا لا أزعجك أو ما شابه، صحيح؟

86
00:05:33,760 --> 00:05:36,770
...لا، لا بأس بهذا

87
00:05:44,010 --> 00:05:46,400
.حسنًا، هذا جيّد

88
00:05:46,700 --> 00:05:48,090
.نعم

89
00:05:50,730 --> 00:05:51,760
...أخبريني

90
00:05:53,650 --> 00:05:58,420
ماذا يعني في رأيك أن يتواعد فتى وفتاة؟

91
00:05:58,720 --> 00:06:01,420
ما الغاية من ذلك السّؤال؟
فتى وفتاة—؟

92
00:06:01,420 --> 00:06:04,670
نعم. مثل ما السّبب الّذي يدفع
.ثنائيًّا للمواعدة

93
00:06:06,190 --> 00:06:08,680
هل يمكنني أن أكلّمك بجدّيّة للحظة؟

94
00:06:09,650 --> 00:06:10,680
.أكيد

95
00:06:10,990 --> 00:06:17,680
أخبرتك من قبل كيف
،أنّي لا أستطيع أخذ المركز الأوّل

96
00:06:18,040 --> 00:06:19,940
.وأنّي لا أستطيع أن أكون شخصًا مميّزًا

97
00:06:20,230 --> 00:06:23,170
،أقنع نفسي بألاّ أفكّر بهذه الطّريقة

98
00:06:23,170 --> 00:06:25,170
لكنّ ذلك منقوش عميقًا فيّ الآن

99
00:06:25,170 --> 00:06:26,940
.لدرجة أنّي لا أستطيع التّغيّر

100
00:06:27,400 --> 00:06:31,820
.لكنّك... منحتني الفرصة لأحاول

101
00:06:32,560 --> 00:06:34,310
تقصدين الانتخابات؟

102
00:06:34,310 --> 00:06:35,200
.نعم

103
00:06:35,200 --> 00:06:39,210
...وفي مسألة تاما وإريكا
.إضافة لأوقات أخرى عدّة

104
00:06:40,300 --> 00:06:42,840
،رغم أنّي لم أستطع فعل أيّ شيء على الإطلاق

105
00:06:42,840 --> 00:06:45,580
يبدو الأمر كما لو أنّك غيّرت
.العالم لحلّ تلك الأمور

106
00:06:46,110 --> 00:06:49,590
،لذلك أريد أن أصير شخصًا مثلك

107
00:06:49,590 --> 00:06:52,970
.لكنّ ذلك ليس شيئًا بإمكاني فعله

108
00:06:53,920 --> 00:06:55,220
!صحيح

109
00:06:55,670 --> 00:06:58,720
،كان الأمر وليد اللّحظة في البداية
.عندما قلتُ أنّي أحبّك، كما أحبّ تاما

110
00:06:58,720 --> 00:07:01,120
...لكن كلّما فكّرت في الأمر

111
00:07:01,680 --> 00:07:04,230
.بدأت أدرك أنّي أشعر بنفس الشّيء

112
00:07:04,540 --> 00:07:05,520
نفس الشّيء؟

113
00:07:06,250 --> 00:07:08,110
.حيالك أنت

114
00:07:08,660 --> 00:07:10,750
.أنا بالفعل أحبّك

115
00:07:13,450 --> 00:07:15,230
.لذلك ربّما الأمر هكذا

116
00:07:15,630 --> 00:07:19,050
.ربّما هذا... هو سبب اختياري لك

117
00:07:20,100 --> 00:07:23,250
!ويحي، هل أتصرّف بشكل مزعج ثانية؟

118
00:07:23,250 --> 00:07:26,000
.لا، على الإطلاق

119
00:07:26,440 --> 00:07:29,200
.يا إلهي، أشعر بإحراج شديد

120
00:07:29,200 --> 00:07:31,510
!انس ما قلتُه اليوم هنا

121
00:07:31,760 --> 00:07:33,760
.ماذا؟! مفهوم

122
00:07:34,010 --> 00:07:38,520
لكنّي سأكون وحيدة جدًّا إن نسيتَ
.كلّ شيء، لذلك لا تهتمّ لما قلت

123
00:07:38,760 --> 00:07:40,390
ماذا يحدث؟

124
00:07:40,640 --> 00:07:42,770
اسمع، عقل الفتيات معقّد، مفهوم؟

125
00:07:42,770 --> 00:07:45,740
...صحيح. إنّه معقّد

126
00:07:46,400 --> 00:07:48,280
!إلى اللّقاء يا برين

127
00:07:48,550 --> 00:07:50,570
!تدفّأ أثناء نومك

128
00:07:51,560 --> 00:07:55,280
مهلاً... ماذا عن عرضنا الكوميديّ؟

129
00:07:55,280 --> 00:07:57,280
"توموزاكي"

130
00:08:00,720 --> 00:08:02,860
.لذلك ربّما الأمر هكذا

131
00:08:02,860 --> 00:08:06,380
.ربّما هذا... هو سبب اختياري لك

132
00:08:07,140 --> 00:08:09,880
ماذا عنّي إذًا؟

133
00:08:10,590 --> 00:08:12,140
ما أسبابي الخاصّة؟

134
00:08:14,610 --> 00:08:16,140
.تفضّل يا توموزاكي-كُن

135
00:08:16,140 --> 00:08:19,890
"طريقتي غير المألوفة للطّيران"
"المسودّة الثّانية"

136
00:08:16,430 --> 00:08:19,890
،بما أنّ الأدوار قد حُدّدت الآن
.عدّلت على الحوار قليلاً

137
00:08:20,500 --> 00:08:21,710
في ليلة واحدة؟

138
00:08:21,710 --> 00:08:24,940
.نعم. لكنّي ما زلت لم أُنهي المشهد الأخير

139
00:08:29,530 --> 00:08:33,990
.مذهل... أرى أنّها لم تغيّر الحوار فحسب

140
00:08:35,080 --> 00:08:38,220
بما أنّ كريس كانت تعتني
،بالتّنّين طوال هذا الوقت

141
00:08:38,220 --> 00:08:40,690
.لم تغادر الحديقة أبدًا

142
00:08:40,690 --> 00:08:42,610
.كانت فتاة حزينة هكذا

143
00:08:43,930 --> 00:08:47,210
.لكن كانت الحديقة تضمّ كلّ شيء

144
00:08:47,660 --> 00:08:49,080
.سرير مريح

145
00:08:49,930 --> 00:08:51,560
.مياه عذبة ونقيّة

146
00:08:52,510 --> 00:08:54,030
.حمّام دافئ

147
00:08:55,110 --> 00:08:57,720
.قرأت قصصًا خرافيّة وكتبًا عن الأساطير

148
00:08:58,160 --> 00:09:01,100
كانت تأكل نفس الطّعام
.الّذي تأكل منه العائلة الملكيّة

149
00:09:02,530 --> 00:09:07,220
.لكنّ ما افتقرت له الحديقة هو كلّ شيء آخر

150
00:09:09,550 --> 00:09:12,250
.أوّل تغيير طرأ، كان في مشهد لقائهم

151
00:09:13,040 --> 00:09:16,960
عندما التقت كريس الّتي عاشت
،وحيدة تجهل ما الفرح وما الحزن

152
00:09:16,960 --> 00:09:19,200
،بليبرا وألوسيا لأوّل مرّة

153
00:09:19,200 --> 00:09:22,860
...كانت ردّة فعلها في المسودّة الأولى هكذا

154
00:09:24,690 --> 00:09:29,080
!بشر آخرون؟ أنا كريس

155
00:09:29,370 --> 00:09:31,040
ما اسمكما؟

156
00:09:31,890 --> 00:09:36,590
أظهرت فضولها بخصوص العالم
.الخارجيّ، إضافة لصراحتها المباشرة

157
00:09:37,200 --> 00:09:39,850
...لكن بعد إعادة الكتابة، هذا ما حدث

158
00:09:40,440 --> 00:09:43,180
بشر آخرون؟

159
00:09:43,460 --> 00:09:46,940
من أنتما؟ ما الّذي تفعلانه هنا؟

160
00:09:47,230 --> 00:09:50,680
.برز حذرها وخوفها إلى الواجهة

161
00:09:50,680 --> 00:09:53,490
،رغم أنّها كانت تأمل أن تتحرّر من وحدتها

162
00:09:53,490 --> 00:09:56,950
إلاّ أنّ خوفها من التّغيير والعالم
.المجهول ما زال موجودًا

163
00:09:57,940 --> 00:10:03,700
وليبرا أيضًا لم يعد البطل البسيط
.الّذي كان عليه في المسودّة الأولى

164
00:10:04,000 --> 00:10:06,170
كان غريبًا في تصرّفاته
،واقترف الكثير من الأخطاء

165
00:10:06,170 --> 00:10:09,280
لكنّه حصل على صداقات من خلال
.تصميمه للمواصلة حتّى النّهاية

166
00:10:09,280 --> 00:10:11,610
.صار الآن فتى أكثر واقعيّة

167
00:10:12,340 --> 00:10:16,060
بتعبير آخر، سُلّط الضّوء أكثر
.على نقاط ضعفهما

168
00:10:17,040 --> 00:10:20,340
.على عكس ألوسيا

169
00:10:20,740 --> 00:10:23,770
فعدما قابلت كريس والتّنّين
...على سبيل المثال

170
00:10:24,350 --> 00:10:29,600
شعرت ألوسيا بالخطر في الأصل
،وحاولت الهرب

171
00:10:30,420 --> 00:10:32,230
...ولكن في المسوّدة الثّانية

172
00:10:32,800 --> 00:10:33,990
.تحرّك يا ليبرا

173
00:10:34,460 --> 00:10:39,090
.بادرت ألوسيا في الحال لكسر جناح التّنيّن بنفسها

174
00:10:39,090 --> 00:10:42,650
.وهذا جعل عجز التّنّين عن الطّيران خطأها هي

175
00:10:43,100 --> 00:10:46,830
.لم يعد من المهمّ الآن إن كان ليبرا غير نقيّ

176
00:10:47,370 --> 00:10:50,160
.لكنّ ليبرا لاحظ ذلك وأوقفها

177
00:10:50,160 --> 00:10:51,670
ما الّذي تفعلينه؟

178
00:10:51,670 --> 00:10:55,820
سيتطلّب الأمر الكثير لإعدام
.فرد من العائلة الملكيّة مثلي

179
00:10:56,310 --> 00:10:58,840
.لذلك... دعني أقوم بهذا رجاءً

180
00:10:59,120 --> 00:11:01,050
...ولكن إن فعلت هذا يا ألوسيا

181
00:11:01,050 --> 00:11:03,470
!فإنّ قلبك أنت ما سيموت

182
00:11:07,840 --> 00:11:12,650
.وبسبب خدعة ألوسيا، نجا ليبرا

183
00:11:12,920 --> 00:11:16,080
وهنا تنتقل القصّة للعلاقات بين الثّلاثة

184
00:11:16,080 --> 00:11:18,150
.خلال وقتهم في الحديقة

185
00:11:18,990 --> 00:11:22,570
،بفضل دوريهما الجديدين كحارس ومعلّمة

186
00:11:22,570 --> 00:11:28,410
.نشأت بين الثّلاثة علاقةُ صداقة وعائلة غريبة

187
00:11:28,980 --> 00:11:33,670
.استمتعت كريس بالتّزيين بالزّهور وقراءة الكتب

188
00:11:34,200 --> 00:11:37,020
،ولكن لإبقائها بعيدة عن دناسة العالم

189
00:11:37,020 --> 00:11:39,670
سُمح لها بقراءة القصص
.الخرافيّة والأساطير فحسب

190
00:11:40,200 --> 00:11:42,680
،بعد أن قرأت كلّ كتب القلعة

191
00:11:42,680 --> 00:11:47,680
صارت متعلّقة بقصص ليبرا
.عن العالم الخارجيّ

192
00:11:47,960 --> 00:11:52,040
التّنّين العملاق هو الأسرع بين
.كلّ التّنانين في الحقيقة

193
00:11:52,040 --> 00:11:55,810
!إنّه يتحرّك بسرعة هائلة

194
00:11:55,810 --> 00:11:58,440
!مذهل! أخبرني بالمزيد

195
00:11:58,900 --> 00:12:04,010
هناك منشآت تولّد السّحر من
.تحرّكاتها في الوقت الحاضر

196
00:12:04,010 --> 00:12:08,020
يبدو أنّ القدرة على تحويل القوّة الجسديّة
!إلى سحر كان اكتشافًا ضخمًا

197
00:12:08,020 --> 00:12:10,330
!فعلاً؟ هذا مذهل

198
00:12:10,330 --> 00:12:16,330
.أعرف القليل من السّحر أنا أيضًا
.تعويذة واحدة فقط: الفتح

199
00:12:17,480 --> 00:12:20,280
هذه قوّة جسديّة، صحيح؟

200
00:12:20,280 --> 00:12:23,090
ما السّحريّ بشأن فتح قفل ما؟

201
00:12:23,870 --> 00:12:25,160
.كشفتِ أمري

202
00:12:25,160 --> 00:12:28,690
.أخبرها ليبرا كلّ شيء عن العالم الحقيقيّ

203
00:12:28,690 --> 00:12:31,360
عالم عاش فيه النّاس وتجادلوا أحيانًا

204
00:12:31,360 --> 00:12:34,080
.وأحبّوا بعضهم وماتوا من وقت لآخر

205
00:12:34,730 --> 00:12:35,950
...ولكن

206
00:12:35,950 --> 00:12:40,230
ما دمتُ أملك هذا، أستطيع الذّهاب
.لمختلف الأماكن ورؤية أشياء عديدة

207
00:12:40,480 --> 00:12:43,990
لذلك حتّى إن كان هذا
.كلّ ما أملك، فلا أمانع ذلك

208
00:12:44,240 --> 00:12:47,490
...فهمت. إنّ تعويذة الفتح خاصّتك

209
00:12:49,250 --> 00:12:52,000
!تعويذة مذهلة بالفعل

210
00:12:52,400 --> 00:12:54,940
في تلك الأثناء، كانت ألوسيا موهوبة

211
00:12:54,940 --> 00:12:58,110
.ومجدّة بما يكفي للفوز بمنافسات سحريّة

212
00:12:58,110 --> 00:13:01,250
.كانت قاسية على كريس أثناء دروسهما

213
00:13:01,580 --> 00:13:05,460
لذلك فإنّ اعتقاد أنّ الأشخاص غير الملكيّين
.ملوّثون هو مجرّد اعتقاد شعبيّ

214
00:13:05,460 --> 00:13:06,960
.لا أساس له

215
00:13:06,960 --> 00:13:10,760
يحبّ المجتمع النّبيل تقاليده
.الّتي عفا عنها الزّمن

216
00:13:11,030 --> 00:13:13,220
...ذلك مخيف قليلاً

217
00:13:13,220 --> 00:13:16,530
هلا درسنا شيئًا مرحًا أكثر؟

218
00:13:16,530 --> 00:13:19,150
ربّما بعض القصص المبهجة
عن العالم الخارجيّ...؟

219
00:13:20,690 --> 00:13:23,400
حسنًا، هل تعرفين ما هي الفراشات؟

220
00:13:23,920 --> 00:13:26,910
إ-إنّها حشرات، صحيح؟

221
00:13:27,250 --> 00:13:28,910
مثل هذه؟

222
00:13:29,180 --> 00:13:30,980
.هذه حمار قبّان

223
00:13:30,980 --> 00:13:33,530
.كلاهما حشرات، لكنّ الفراشات مختلفة

224
00:13:33,530 --> 00:13:36,410
.لكنّها الحشرات الوحيدة الّتي لدينا هنا

225
00:13:36,720 --> 00:13:39,030
.لهذا السّبب عليك أن تدرسي

226
00:13:39,030 --> 00:13:42,920
تحتاجين للمعرفة الأساسيّة
.لفهم القصص عن العالم الخارجيّ

227
00:13:43,200 --> 00:13:46,010
...أشعر أنّك تظنّين أنّني حمارة

228
00:13:46,010 --> 00:13:48,180
مثل حمار قبّان... فهمتِ المزحة؟

229
00:13:48,430 --> 00:13:51,430
.نعم. لنكمل من حيث توقّفنا

230
00:13:51,430 --> 00:13:54,810
تحشرينني للدّراسة... مثل حشرة، فهمتِ؟

231
00:13:54,810 --> 00:13:57,810
...نعم، نعم. لقد توقّفنا عند

232
00:14:00,110 --> 00:14:01,270
!تاما-مًا

233
00:14:01,730 --> 00:14:03,730
مثل حشرة، فهمتِ؟

234
00:14:04,010 --> 00:14:06,620
.إنّ كريس تشبه تاما-تشان بالفعل

235
00:14:07,690 --> 00:14:09,700
...وألوسيا

236
00:14:10,730 --> 00:14:13,560
.إنّها تشبه الوجه الّذي خلف قناعها

237
00:14:14,540 --> 00:14:18,040
تتوقّف نقطة التّحوّل
.في القصّة على التّنّين الطّائر

238
00:14:18,780 --> 00:14:22,200
تصير التّنانين الطّائرة قادرة على
.الطّيران عندما تبلغ 13 سنة

239
00:14:22,200 --> 00:14:28,680
ويُعتقد أنّ الّتي تعجز عن الطّيران في ذلك
.الوقت قد فقدت قوّتها بسبب الدّناسة

240
00:14:29,270 --> 00:14:32,950
بلغ التّنّين الطّائر الّذي كانت تربّيه
...كريس ربيعه الثّالث عشر هذا العالم

241
00:14:32,950 --> 00:14:34,440
.وما زال عاجزًا عن الطّيران

242
00:14:35,050 --> 00:14:39,000
لكن ما الدّناسة الّتي سلبته
القدرة على الطّيران؟

243
00:14:40,290 --> 00:14:41,780
أتعلمين يا كريس؟

244
00:14:42,480 --> 00:14:45,990
.بإمكان التّنانين الطّائرة سماع أفكار النّاس

245
00:14:45,990 --> 00:14:47,190
سماع أفكارهم؟

246
00:14:47,460 --> 00:14:49,690
.إنّها طيّبة أيضًا

247
00:14:49,690 --> 00:14:53,200
،إنّها لا تنسى أبدًا جميل البشر الّذين ربّوها

248
00:14:53,600 --> 00:14:57,200
وتفعل كلّ ما باستطاعتها لتحقيق
.رغبات أولئك الأشخاص

249
00:14:58,000 --> 00:14:59,450
...تقصد

250
00:15:00,550 --> 00:15:02,930
...اسمعي يا كريس

251
00:15:04,500 --> 00:15:07,960
لا تريدين الطّيران، صحيح؟

252
00:15:08,290 --> 00:15:11,970
.وهكذا، كُشفت نقطة ضعف كريس

253
00:15:12,950 --> 00:15:16,620
.كان للحديقة كلّ شيء. كلّ شيء ولا شيء

254
00:15:17,600 --> 00:15:22,100
لذلك، كانت وحيدة وتمنّت لو
...بإمكانها المغادرة. ومع ذلك

255
00:15:22,380 --> 00:15:28,600
رغبتها في الطّيران من هذه الحديقة
والحصول على كلّ ما تفتقر له

256
00:15:28,600 --> 00:15:31,730
.غطّاها خوفها من العالم المجهول

257
00:15:32,550 --> 00:15:36,990
هذا صحيح، ما منع التّنّين من الطّيران

258
00:15:37,700 --> 00:15:40,270
.كان هو عقل كريس بحدّ ذاته

259
00:15:43,650 --> 00:15:45,250
.كان ذلك جيّدًا جدًّا

260
00:15:45,570 --> 00:15:49,080
.أعتقد أنّها مثيرة للاهتمام أكثر من الرّواية

261
00:15:49,080 --> 00:15:50,640
أتعتقد ذلك بالفعل؟

262
00:15:50,640 --> 00:15:51,630
.نعم

263
00:15:52,160 --> 00:15:57,390
إنّ الجزء الّذي عرفوا فيه سبب
.عجز التّنّين عن الطّيران أثّر فيّ كثيرًا

264
00:15:57,690 --> 00:16:02,640
.بدا لي خوف كريس واقعيًّا... كان شعورًا بشريًّا

265
00:16:03,070 --> 00:16:05,650
.توقّعتُ ذلك

266
00:16:06,200 --> 00:16:07,520
توقّعتِه؟

267
00:16:07,910 --> 00:16:11,150
لا تهتمّ... هل من ملاحظات أخرى؟

268
00:16:11,470 --> 00:16:16,180
أحببتُ ما حدث بعد اكتشافهم
.أنّ التّنين عاجز عن الطّيران

269
00:16:16,180 --> 00:16:19,160
!نعم! أحببتُ ذلك الجزء أيضًا

270
00:16:19,760 --> 00:16:22,390
اقترح ليبرا أنّ عليهما هو وكريس

271
00:16:22,390 --> 00:16:26,750
.ركوب التّنّين لرؤية العالم الخارجيّ

272
00:16:37,540 --> 00:16:41,680
كانت كريس خائفة فحسب
.من رؤية العالم وحدها

273
00:16:42,140 --> 00:16:42,930
.نعم

274
00:16:43,270 --> 00:16:46,690
.ولكن عندما تكون مع ليبرا... تستطيع الطّيران

275
00:16:47,040 --> 00:16:51,520
أرادت كريس الطّيران لرؤية العالم
.الخارجيّ البرّاق، لكنّها كانت خائفة

276
00:16:51,520 --> 00:16:56,950
كان ليبرا من أخرجها من حديقتها
.الوحيدة والمُطوّقة

277
00:16:57,240 --> 00:17:01,830
لا بدّ أنّ المنظر الّذي رأته كريس
من هناك قد غيّر

278
00:17:01,830 --> 00:17:05,210
.العالم الرّماديّ الّذي كانت تراه طوال حياتها

279
00:17:07,180 --> 00:17:12,670
مذ كنتُ صغيرة، شعرتُ أنّ كلّ
.شيء رأيته كان رماديًّا

280
00:17:15,960 --> 00:17:17,550
ما الخطب؟

281
00:17:17,890 --> 00:17:22,310
أخبريني، ما الّذي كان يبرع فيه
ليبرا أكثر من غيره؟

282
00:17:22,740 --> 00:17:29,060
حسنًا... إنّ براعته تكمن في قول
.أيّ شيء يخطر بباله

283
00:17:29,540 --> 00:17:33,070
.النّصّ ليس خيالاً خالصًا

284
00:17:33,600 --> 00:17:36,120
.إنّها قصّة كيكوتشي-سان

285
00:17:40,070 --> 00:17:43,060
تريدين معرفة المزيد عن هينامي؟

286
00:17:43,060 --> 00:17:44,080
.نعم

287
00:17:44,080 --> 00:17:49,330
لأستطيع رسم صورة أوضح
.عن شخصيّة ألوسيا

288
00:17:49,600 --> 00:17:51,960
شخصيّة ألوسيا؟

289
00:17:52,250 --> 00:17:55,690
...ليبرا غريب التّصرّفات وكريس خوّافة

290
00:17:55,690 --> 00:17:59,460
.ألوسيا قويّة، لكنّها تحتاج نقاط ضعف

291
00:17:59,460 --> 00:18:03,100
.بدأت الشّكوك تراودني بينما كنتُ أكتب

292
00:18:03,470 --> 00:18:04,600
شكوك؟

293
00:18:05,240 --> 00:18:09,580
مثل كيف يمكن لألوسيا أن تكون قويّة هكذا؟

294
00:18:14,550 --> 00:18:17,240
.مقابلة؟ أنا متوتّرة جدًّا الآن

295
00:18:17,500 --> 00:18:19,260
.تفضّلي يا كيكوتشي-سان

296
00:18:19,260 --> 00:18:20,410
.حسنًا

297
00:18:20,410 --> 00:18:26,340
عفوًا... ما الّذي يدفعك للعمل
بجدّ في مجالات كثيرة؟

298
00:18:27,180 --> 00:18:29,870
،لكنّ تلك المقابلة كانت جوفاء

299
00:18:29,870 --> 00:18:34,630
مجرّد كلمات لطيفة على المسامع مع
.بعض السّمّ بدت وكأنّها قد تكون حقيقيّة

300
00:18:35,290 --> 00:18:40,510
أشكّ أنّه كانت هنالك أيّ إجابات
.قد تودّ كيكوتشي-سان إضافتها للقصّة

301
00:18:41,880 --> 00:18:46,020
.أعتقد أنّ هينامي-سان كانت تكذب علينا

302
00:18:47,140 --> 00:18:52,690
،لا يهمّ ما مدى سلاسة حديثها
.لكنّ الدّافع في منتصفه ظلّ مخفيًّا

303
00:18:52,690 --> 00:18:55,670
لكنّها تصرّفت وكأنّها تقول ما
.تشعر به فحسب

304
00:18:56,510 --> 00:18:58,590
...ما يعني

305
00:18:58,590 --> 00:19:01,840
أنّ ألوسيا لا تُجاري محيطها فحسب

306
00:19:01,840 --> 00:19:04,780
...وتعمل بجدّ بسبب إحساس للواجب

307
00:19:05,530 --> 00:19:09,790
.يوجد شيء... غير عاديّ هناك

308
00:19:10,330 --> 00:19:12,040
.أظنّ ذلك أيضًا

309
00:19:12,040 --> 00:19:14,040
...لكنّي لم أعرف ما هو

310
00:19:14,610 --> 00:19:18,690
.رغم أنّي أعرف الوجه الّذي تحت قناعها

311
00:19:20,180 --> 00:19:23,580
أتودّين البحث بشكل أعمق يا كيكوتشي-سان؟

312
00:19:24,170 --> 00:19:25,350
في أمر هينامي؟

313
00:19:31,200 --> 00:19:34,400
.أنا مايباشي. سررت بلقائكما

314
00:19:34,690 --> 00:19:37,440
.أنا توموزاكي. سررت بلقائك أيضًا

315
00:19:38,010 --> 00:19:41,490
.أنا كيكوتشي. سرّتني مقابلتك

316
00:19:42,280 --> 00:19:45,240
.حسنًا، لنبدأ بالأمر

317
00:19:45,240 --> 00:19:48,300
.عفوًا، لديّ إذن من هينامي بالفعل

318
00:19:48,300 --> 00:19:49,410
...لنرَ

319
00:19:49,830 --> 00:19:52,600
ذهبتَ لنفس المدرسة الإعداديّة
.مثل هينامي يا تاتشيبانا

320
00:19:52,600 --> 00:19:53,550
.نعم

321
00:19:53,550 --> 00:19:57,870
،وأنت زميلة فصل لها منذ الابتدائيّة
صحيح يا مايباشي-سان؟

322
00:19:57,870 --> 00:19:59,050
.هذا صحيح

323
00:19:59,510 --> 00:20:02,090
.حسنًا، سنبدأ بالإعداديّة

324
00:20:02,090 --> 00:20:05,050
هل علق أيّ شيء بذهنك يا تاتشيبانا؟

325
00:20:05,280 --> 00:20:11,310
ما أذكر هو... مواعدتها لنائب
.رئيس نادي كرة السّلّة للفتيان

326
00:20:11,310 --> 00:20:12,980
ماذا؟! فعلاً؟

327
00:20:13,320 --> 00:20:16,250
.كان زميلَ دراسة أكبر رائع
.أحبّته كلّ الفتيات

328
00:20:16,250 --> 00:20:19,480
!وقد قامت بهجره في الحال

329
00:20:19,840 --> 00:20:22,570
...إذًا كانت متميّزة عن غيرها دائمًا

330
00:20:23,360 --> 00:20:25,370
.ما كنتُ لأقول ذلك

331
00:20:25,370 --> 00:20:26,870
ماذا تقصدين؟

332
00:20:27,380 --> 00:20:32,500
لا أعتقد أنّ هينامي-سان كانت
.متميّزة كثيرًا في الابتدائيّة

333
00:20:32,770 --> 00:20:34,500
فعلاً؟

334
00:20:34,500 --> 00:20:37,500
.كانت صادقة وودودة، كانت طفلة جيّدة

335
00:20:37,800 --> 00:20:42,380
.وأذكر أنّها كانت تقدّر العائلة كثيرًا

336
00:20:42,380 --> 00:20:44,260
.صحيح! وكذلك أنا

337
00:20:44,640 --> 00:20:49,010
كان انطباعي عنها هو أنّها
.تحبّ أخواتها الصّغيرات كثيرًا

338
00:20:49,440 --> 00:20:50,250
أخوات؟

339
00:20:51,040 --> 00:20:53,730
تملك هينامي أخوات صغيرات؟

340
00:20:54,070 --> 00:20:56,730
!أبلغوا سلامي لهينامي-سان

341
00:20:57,760 --> 00:20:59,690
!شكرًا على قدومك

342
00:21:02,970 --> 00:21:04,450
ما الأمر يا تاتشيبانا؟

343
00:21:05,010 --> 00:21:08,960
تذكر عندما ذكرت مايباشي "الأخوات"؟

344
00:21:08,960 --> 00:21:10,700
.نعم، ذكرت ذلك بالفعل

345
00:21:10,700 --> 00:21:12,750
.هذا هو الأمر الغريب

346
00:21:13,720 --> 00:21:17,710
.أعني أنّ أوي لديها أخت واحدة أصغر فحسب

347
00:21:18,780 --> 00:21:20,590
هل أنت واثق من ذلك؟

348
00:21:21,070 --> 00:21:23,840
.نعم، واثق تمامًا

349
00:21:27,420 --> 00:21:30,280
.إنّه ليس أمرًا يمكننا التّطفّل عليه

350
00:21:30,760 --> 00:21:33,600
.لم تذكر أيّ شيء عن هذا من قبل

351
00:21:33,920 --> 00:21:35,100
...صحيح

352
00:21:35,430 --> 00:21:36,980
...دعونا

353
00:21:37,710 --> 00:21:39,200
.نتوقّف هنا

354
00:21:42,980 --> 00:21:46,490
"طريقتي غير المألوفة للطّيران"
"المسودّة الثّالثة"

355
00:21:43,310 --> 00:21:46,490
...قمتُ بمراجعات بخصوص ألوسيا

356
00:21:46,960 --> 00:21:51,240
لكنّي لم أكتب أيّ شيء بعدَ
.مشهد طيران كريس مع ليبرا

357
00:21:51,620 --> 00:21:52,980
.لا بأس

358
00:21:52,980 --> 00:21:55,500
.بإمكاننا التّدرّب كثيرًا بالنّصف الأوّل فحسب

359
00:22:00,250 --> 00:22:02,250
"الفصل أ الاحتياطيّ"
"يُستعمل"

360
00:22:04,370 --> 00:22:05,790
!حسنًا

361
00:22:07,230 --> 00:22:10,360
!لنقم بقراءة نصّ مسرحيّتنا