1
00:00:00,980 --> 00:00:03,350
"توموزاكي"

2
00:00:04,400 --> 00:00:07,230
ظننتَ أنّي أخبرتك أنّي أحبّك"
"بتلك' الطّريقة، صحيح؟'

3
00:00:07,570 --> 00:00:09,820
".لكنّي بالفعل أحبّك بتلك الطّريقة"

4
00:00:11,110 --> 00:00:14,450
شخصيّة من الفئة السّفلى مثلي؟

5
00:00:14,890 --> 00:00:17,390
.يستدعي هذا الأمر مساعدة من الفئة العليا

6
00:00:18,370 --> 00:00:23,250
"هينامي أوي"

7
00:00:19,760 --> 00:00:22,370
...أعتقد أنّي سأطلب النّصيحة من هينامي

8
00:00:24,250 --> 00:00:28,000
،ميزوساوا تاكاهيرو: آسف يا فوميا أيمكنك"
".المجيء للعمل؟ هناك من تغيّب بسبب المرض

9
00:00:25,530 --> 00:00:26,780
ميزوساوا؟

10
00:02:02,090 --> 00:02:04,070
.آسف لأنّ الأمر كان عاجلاً

11
00:02:04,070 --> 00:02:05,620
.سيساعدنا هذا كثيرًا

12
00:02:05,620 --> 00:02:06,530
.لا بأس

13
00:02:07,330 --> 00:02:08,600
ما الخطب يا فوميا؟

14
00:02:09,330 --> 00:02:12,980
.لا أستطيع إخباره عن ميميمي

15
00:02:14,820 --> 00:02:16,990
مشاكل تتعلّق بالفتيات؟

16
00:02:18,340 --> 00:02:20,080
.أظنّني أصبت الهدف

17
00:02:20,080 --> 00:02:24,660
هل هُجرت؟ أم تسرّعتَ واعترفتَ بحبّك؟

18
00:02:25,010 --> 00:02:27,660
...هُجرت؟ لا، لم أُهجر

19
00:02:28,950 --> 00:02:31,160
إذًا هل أفضح لك شخص ما بشيء ما؟

20
00:02:31,160 --> 00:02:34,710
إنّك تقضي الكثير من الوقت
.مع كيكوتشي-سان وحدكما مؤخّرًا

21
00:02:34,990 --> 00:02:36,840
ماذا؟ كيكوتشي-سان؟

22
00:02:37,950 --> 00:02:39,220
هل أخطأت؟

23
00:02:39,460 --> 00:02:41,600
...ما...؟ لا

24
00:02:43,390 --> 00:02:44,910
...هذا يعني

25
00:02:45,510 --> 00:02:47,520
...الاحتمال الآخر الممكن هنا

26
00:02:49,030 --> 00:02:50,190
هو ميميمي؟

27
00:02:51,730 --> 00:02:55,070
مهلاً، مهلاً. هل هي ميميمي بالفعل؟

28
00:02:57,760 --> 00:02:59,290
.فهمت الآن

29
00:03:00,010 --> 00:03:02,450
ما الّذي جعلك ترتبك؟

30
00:03:02,770 --> 00:03:07,470
كبداية، لا أدري حتّى إن كان
.ذلك يُعتبر كاعتراف

31
00:03:07,940 --> 00:03:09,830
.من الصّعب التّمييز

32
00:03:10,160 --> 00:03:13,830
.قد يكون اعترافًا، أو قد يكون مجرّد لهو

33
00:03:14,640 --> 00:03:16,340
...لهو

34
00:03:16,610 --> 00:03:19,280
إن كنتَ لا تزال تريد الاستمرار في العلاقة
،الّتي كانت تجمعكما حتّى الآن

35
00:03:19,280 --> 00:03:23,350
.يمكنك المواصلة وكأنّ شيئًا لم يحدث

36
00:03:23,350 --> 00:03:25,580
أيمكنني ذلك فعلاً؟

37
00:03:25,580 --> 00:03:27,930
...مع أنّه يمكنني القول

38
00:03:27,930 --> 00:03:33,310
أنّك إن كنت تريد مواعدتها
.في هذه الحالة، يمكنك ذلك أيضًا

39
00:03:33,310 --> 00:03:34,020
!ماذا؟

40
00:03:36,710 --> 00:03:38,150
...آسف

41
00:03:38,480 --> 00:03:42,980
مع أنّي يمكنني أن أرى لماذا
.قد تجد الوضع غير مريح لها

42
00:03:42,980 --> 00:03:44,400
ماذا تعني؟

43
00:03:44,400 --> 00:03:47,660
.أتذكر؟ يجذب الجذّابون الآخرين لهم

44
00:03:48,000 --> 00:03:55,180
من المحتمل أنّ ميميمي تشعر بالقلق
من أن تأخذك منها كيكوتشي-سان

45
00:03:55,180 --> 00:03:57,420
.أو أيّ فتاة أخرى من ثانويّة الفتيات

46
00:03:57,810 --> 00:04:00,620
،ولكن حتّى إن حدث ذلك

47
00:04:00,620 --> 00:04:02,300
...هناك الكثير من الخيارات الأخرى

48
00:04:02,570 --> 00:04:03,550
.اسمع

49
00:04:04,690 --> 00:04:07,390
متى ستتوقّف عن التّقليل
من نفسك والإنقاص منها؟

50
00:04:07,830 --> 00:04:10,980
إنّك تحمل نقاط ضعفك كعُذر

51
00:04:10,980 --> 00:04:14,140
لكي لا تُضطرّ للاعتراف بتطلّعات
،أو حسن نيّة أيّ أحد

52
00:04:14,450 --> 00:04:15,950
.وهذه عادة فظيعة

53
00:04:16,710 --> 00:04:18,210
ألم تلاحظ الأمر؟

54
00:04:18,210 --> 00:04:23,030
تبدو مرتاحًا بعض الشّيء
.في كلّ مرّة تقلّل فيها من نفسك

55
00:04:24,410 --> 00:04:26,260
.لا تفعل ذلك

56
00:04:27,040 --> 00:04:30,630
لا يشعر الرّجل الرّائع الحقيقيّ بالرّاحة

57
00:04:35,320 --> 00:04:37,320
.ليستطيع الوصول إليها

58
00:04:38,100 --> 00:04:42,220
لكنّك طبعًا تملك كامل الحرّيّة
.للاستمرار في التّقليل من نفسك

59
00:04:42,220 --> 00:04:43,420
.لا أهتمّ في كلتا الحالتين

60
00:04:43,680 --> 00:04:46,930
،ولكن عندما تقلّل من نفسك

61
00:04:47,200 --> 00:04:51,040
.فإنّ ذلك يزعج الأشخاص من حولك

62
00:04:59,360 --> 00:05:04,360
أعتقد أنّني شخصيّة من الفئة السّفلى
.بلا منازع في لعبة الحياة هذه

63
00:05:04,900 --> 00:05:09,840
أستمرّ في الحديث عن الحقيقة
،والصّدق بينما أستخدم ضعفي كعذر

64
00:05:09,840 --> 00:05:13,590
وأحطّ من أفكاري بقول
".لن يختار أحدٌ شخصًا مثلي أبدًا"

65
00:05:13,590 --> 00:05:18,130
.لكن ربّما عرفتُ ذلك، عميقًا في داخلي

66
00:05:18,600 --> 00:05:21,320
.ربّما كنتُ أتظاهر فقط بعدم ملاحظة شيء

67
00:05:21,910 --> 00:05:26,720
ولذلك السّبب بالضّبط سأقول هذه الحقيقة

68
00:05:26,720 --> 00:05:28,970
:بكلّ ما في الكلمة من معنى

69
00:05:29,680 --> 00:05:33,520
...نعم، إنّ نانامي مينامي

70
00:05:34,970 --> 00:05:37,660
.تحبّني

71
00:05:39,310 --> 00:05:41,230
"غرفة الخياطة"

72
00:05:40,490 --> 00:05:41,230
،والآن

73
00:05:41,230 --> 00:05:44,690
"مهمّة اليوم: قرّر لمن تريد التّقرّب أكثر"

74
00:05:41,620 --> 00:05:47,240
اخترت فتاتين أو أكثر للسّعي خلفهنّ، صحيح؟

75
00:05:44,690 --> 00:05:47,240
"هدف صغير: لِمن تريد التّقرّب أكثر؟"

76
00:05:47,470 --> 00:05:50,240
أيمكنني أن أسألك عن شيء يا هينامي؟

77
00:05:50,240 --> 00:05:51,240
ما هو؟

78
00:05:51,480 --> 00:05:55,700
ما معنى أن يقع المرء في حبّ الآخر؟

79
00:05:56,340 --> 00:05:59,080
كيف لك أن تسأل عن شيء محرج
كهذا بتلك التّعابير الجادّة؟

80
00:05:59,690 --> 00:06:03,960
لم أكن أشعر بالإحراج إلاّ بعدما
.أشرت لذلك، فتوقّفي

81
00:06:04,860 --> 00:06:07,440
...حسنًا، إن نظرنا للأمر من ناحية تحليليّة

82
00:06:07,440 --> 00:06:13,350
فإنّ ذلك يحدث عندما يتزامن الاعتماد
.والشّهوة والتّملك والاهتمام معًا

83
00:06:13,350 --> 00:06:16,850
وللحديث بشكل أدقّ، فسيكون عاطفة

84
00:06:17,500 --> 00:06:19,360
.تتكوّن من مجموعة من هذه العوامل

85
00:06:19,360 --> 00:06:23,900
.لا، أقصد بطريقة فرديّة أكثر

86
00:06:23,900 --> 00:06:27,490
شيء مثل... من أحبّ؟

87
00:06:27,490 --> 00:06:31,740
كيف يمكنني أن أعرف؟

88
00:06:33,200 --> 00:06:34,990
أما زلت لم تقرّر بعد؟

89
00:06:35,280 --> 00:06:38,120
،أريد اتّخاذ القرار بالفعل

90
00:06:38,120 --> 00:06:41,380
.لكنّي لا أستطيع بعد، أو ما شابه

91
00:06:41,600 --> 00:06:46,160
حسنًا، لهذا السّبب عليك
.أن تختار فتاتين أو أكثر

92
00:06:46,160 --> 00:06:51,390
تعجز عن الاختيار بالفعل، ومع ذلك تبدو
.مُجبرًا على تضييق النّطاق لواحدة فقط

93
00:06:51,930 --> 00:06:55,010
ألا ترى أنّ هذا مخادع نوعًا ما؟

94
00:06:56,900 --> 00:07:02,400
أو ربّما لا توجد ولو فتاة واحدة
أنت مهتمّ بها ولو قليلاً؟

95
00:07:02,680 --> 00:07:05,650
...لا... الأمر ليس كذلك

96
00:07:05,950 --> 00:07:09,630
.لا أخبرك أن تنطلق وتعلن عن حبّك

97
00:07:09,630 --> 00:07:11,550
.ليس عليك حتّى أن تكون واثقًا من ذلك

98
00:07:12,030 --> 00:07:17,160
قرّر فقط لِمن تريد أن تتقرّب أكثر
.من الآن فصاعدًا. هذا كلّ شيء

99
00:07:12,780 --> 00:07:17,160
"هدف صغير: لِمن تريد التّقرّب أكثر؟"

100
00:07:19,160 --> 00:07:20,140
.مفهوم

101
00:07:21,260 --> 00:07:22,970
الفتاتان اللّتان أنا مهتمّ بهما

102
00:07:24,950 --> 00:07:26,670
.هما ميميمي وكيكوتشي-سان

103
00:07:29,760 --> 00:07:35,850
إجابة مناسبة بشكل كبير رغم كلّ
.ما أبديتَ من تردّد. لقد خذلتني

104
00:07:32,340 --> 00:07:35,850
"!هدف صغير: اكتمل"
"لِمن تريد التّقرّب أكثر؟"
"كيكوتشي | ميميمي"

105
00:07:36,410 --> 00:07:37,850
.اخرسي

106
00:07:38,360 --> 00:07:40,850
،حسنًا، ابتداءً من اليوم

107
00:07:40,850 --> 00:07:43,830
ستتقرّب منهما على أساس بناء

108
00:07:43,830 --> 00:07:45,860
.علاقة بين حبيب وحبيبة

109
00:07:46,160 --> 00:07:48,360
...حبيب... وحبيبة

110
00:07:48,610 --> 00:07:50,530
.تصوّر هذا

111
00:07:50,530 --> 00:07:52,610
،ستأتي ميميمي إلى غرفتك

112
00:07:53,100 --> 00:07:55,700
.وستجلسان كلاكما على سريرك وحدكما

113
00:07:55,700 --> 00:07:57,950
،سيتمّ تبادل الكثير من الكلمات

114
00:07:57,950 --> 00:08:00,200
...ثمّ ستتشابك يداكما

115
00:08:01,000 --> 00:08:03,040
،أو أنّك برفقة فوكا-تشان

116
00:08:03,040 --> 00:08:05,290
،ستتبادلان الكثير من الكلمات

117
00:08:05,580 --> 00:08:07,790
...ثمّ ستتشابك يداكما

118
00:08:09,320 --> 00:08:10,420
!حسنًا

119
00:08:11,050 --> 00:08:13,300
.يبدو أنّك تصوّرت الأمر

120
00:08:13,620 --> 00:08:14,990
...يا لها من

121
00:08:15,790 --> 00:08:18,810
.حسنًا، إليك هدفك الجديد الآن

122
00:08:18,810 --> 00:08:21,810
"هدف جديد: قرّر أيّهما تحبّ"

123
00:08:19,340 --> 00:08:21,810
.قرّر أيّهما تحبّ

124
00:08:22,440 --> 00:08:24,060
،بمجرّد أن تحصل على جواب

125
00:08:24,060 --> 00:08:27,000
.اعمل على طريقة لإيصال مشاعرك لها

126
00:08:27,640 --> 00:08:29,920
...سيكون هدفك الصّغير

127
00:08:27,650 --> 00:08:34,990
"(هدف صغير: إتمام خريطة الأحداث (قبل المهرجان الثّقافيّ"

128
00:08:29,920 --> 00:08:34,990
هو إتمام خريطة أحداث رومانسيّة
.عاديّة قبل المهرجان الثّقافيّ

129
00:08:35,290 --> 00:08:37,370
خريطة أحداث؟

130
00:08:37,370 --> 00:08:42,450
"طريق نانامي مينامي"
‫– الحدث 1
‫– الحدث 2
‫– الحدث 3

131
00:08:37,370 --> 00:08:42,450
"طريق كيكوتشي فوكا"
‫– الحدث 1
‫– الحدث 2
‫– الحدث 3

132
00:08:38,040 --> 00:08:42,450
تقصدين مثل خريطة أحداث
للعبة محاكاة المواعدة؟

133
00:08:43,010 --> 00:08:44,190
!أوني-محقّ

134
00:08:45,120 --> 00:08:48,710
وإن اعترفت بمشاعرك للفتاة
،في النّهاية وبدأتما بالمواعدة

135
00:08:48,710 --> 00:08:51,840
هدف متوسّط: احصل على حبيبة"
"قبل بداية السّنة الثّالثة

136
00:08:49,290 --> 00:08:51,320
.فستحقّق هدفك المتوسّط

137
00:08:52,240 --> 00:08:53,590
...مهلاً لحظة

138
00:08:53,590 --> 00:08:55,140
ماذا هنالك؟

139
00:08:55,140 --> 00:08:58,460
.لا أريد أن أجعل الاعتراف بالحبّ هدفًا

140
00:08:58,460 --> 00:09:00,600
،إن كنتُ سأبوح لفتاة بمشاعري

141
00:09:00,600 --> 00:09:04,140
فلا يجب أن يكون ذلك لأجل
...هدف أو مهمّة ما

142
00:09:05,670 --> 00:09:10,360
يجب أن يكون ذلك بسبب
.رغبتي أنا في إخبارها

143
00:09:10,650 --> 00:09:14,310
،ماذا؟ هل تقول أنّ النّهج المستعمل هو المهمّ

144
00:09:14,310 --> 00:09:17,110
بغضّ النّظر عن النّتيجة؟

145
00:09:17,440 --> 00:09:19,120
أهذا رأي "ناناشي"؟

146
00:09:19,400 --> 00:09:23,250
.أعتقد أنّ النّتيجة مهمّة أيضًا

147
00:09:23,250 --> 00:09:25,750
أرأيت؟ من يهتمّ إذًا؟

148
00:09:26,010 --> 00:09:30,760
"يقتصر أسلوب لعب "ناناشي
.على تقدير النّهج والنّتيجة معًا

149
00:09:30,760 --> 00:09:33,760
هكذا استطعتُ أن أصير لاعب
.اليابان الأعلى ترتيبًا

150
00:09:33,760 --> 00:09:34,760
ما أعنيه هو

151
00:09:35,340 --> 00:09:39,810
يجب أن يكون القتال بهذه الطّريقة
.أكثر كفاءة في الحياة الحقيقيّة أيضًا

152
00:09:40,890 --> 00:09:44,810
.حسنًا، لا بأس بذلك إن كنتَ مصرًّا

153
00:09:45,660 --> 00:09:49,440
سنتعمّق أكثر في تفاصيل
.خريطة الأحداث في المرّة القادمة

154
00:09:46,810 --> 00:09:50,310
"(هدف صغير: إتمام خريطة الأحداث (قبل المهرجان الثّقافيّ"

155
00:09:49,440 --> 00:09:50,310
.حسنًا

156
00:09:50,310 --> 00:09:54,320
.أرسلتُ لك ثلاثة أحداث عليك إتمامهما

157
00:09:56,400 --> 00:09:58,320
:أوّلاً

158
00:09:58,830 --> 00:10:01,830
.ناقش ما تبحث عنه في شريك المواعدة

159
00:10:02,160 --> 00:10:04,330
...هـ-هذا مباشر للغاية

160
00:10:04,610 --> 00:10:05,580
:ثانيًا

161
00:10:05,580 --> 00:10:09,580
المسا أيدي بعضكما قصدًا
.لمدّة 5 ثوان متواصلة على الأقلّ

162
00:10:09,830 --> 00:10:11,080
!ما-ماذا؟

163
00:10:11,490 --> 00:10:12,340
:ثالثًا

164
00:10:12,860 --> 00:10:15,840
ارتديا أكسسوارات تتماشى
.مع بعضهما أنتما الاثنان فقط

165
00:10:15,840 --> 00:10:21,850
مهلاً، مهلاً، مهلاً! أليست هذه
!مهمّات صعبة للغاية؟

166
00:10:22,140 --> 00:10:25,490
.صحيح. لكن باستطاعتك إنجازها

167
00:10:25,490 --> 00:10:26,380
ماذا؟

168
00:10:26,380 --> 00:10:30,860
فقبل كلّ شيء، تمكّنت من إنجاز
.كلّ مهمّة تقريبًا حتّى الآن

169
00:10:31,440 --> 00:10:32,510
أليس كذلك؟

170
00:10:46,100 --> 00:10:47,000
.حسنًا

171
00:10:50,130 --> 00:10:53,910
الكاري بالجبن الجديد في قائمة
...طعام المدرسة

172
00:10:53,910 --> 00:10:56,720
أرى أنّك تحسنين استعمال
!سلطتك كرئيسة مجلس التّلاميذ

173
00:10:56,720 --> 00:10:58,590
!أنا؟ مستحيل

174
00:10:58,590 --> 00:11:00,330
أأنت واثقة؟

175
00:11:09,560 --> 00:11:11,910
ما الّذي يحدث؟

176
00:11:11,910 --> 00:11:13,620
ما الخطب يا ميميمي؟

177
00:11:14,400 --> 00:11:19,740
تبًّا. ستلاحظ هينامي الآن
.أنّ ميميمي تتصرّف بغرابة أيضًا

178
00:11:27,210 --> 00:11:31,540
قال ميزوساوا أنّ بإمكاننا دائمًا
،المواصلة كما كنّا

179
00:11:32,390 --> 00:11:33,970
.لكن لا أرى ذلك ممكنًا

180
00:11:34,790 --> 00:11:37,800
"هينامي أوي: هل حدث شيء ما مع ميميمي؟"
"لا شيء على وجه التّحديد"

181
00:11:39,800 --> 00:11:43,300
"حسنًا، لا بأس ما دمت ستقوم بتلك المهمّات"

182
00:11:50,770 --> 00:11:55,440
...أوّلاً، ما الّذي نبحث عنه في شريك

183
00:11:52,190 --> 00:11:55,440
"ناقش ما تبحث عنه في شريك المواعدة"

184
00:11:56,480 --> 00:11:57,770
.آسفة على التّأخير

185
00:11:57,770 --> 00:11:59,050
!ماذا؟

186
00:11:59,780 --> 00:12:01,400
.أنا آسفة

187
00:12:01,400 --> 00:12:03,660
هل أخفتك؟

188
00:12:03,900 --> 00:12:06,760
.لا... لا بأس بذلك

189
00:12:07,410 --> 00:12:10,410
"طريقتي غير المألوفة للطّيران"
"المسودّة الأولى"

190
00:12:08,940 --> 00:12:10,410
!هذا مذهل

191
00:12:10,820 --> 00:12:12,550
!إنّه يشبه سيناريو حقيقيّ

192
00:12:13,710 --> 00:12:15,190
فعلاً؟

193
00:12:15,190 --> 00:12:18,300
لكن كان هذا سريعًا. هل أنهيته؟

194
00:12:18,570 --> 00:12:23,620
.عفوًا، ما زلت لم أكتشف النّصف الثّاني

195
00:12:23,620 --> 00:12:25,600
فعلاً؟

196
00:12:25,600 --> 00:12:28,180
.لكنّ هذا ممتع نوعًا ما

197
00:12:29,100 --> 00:12:34,290
أتحمّس كثيرًا بتخيّل هذه الشّخصيّات
.والحياة تدبّ فيها على المسرح

198
00:12:34,980 --> 00:12:37,520
.كما أنّي متوتّرة قليلاً أيضًا

199
00:12:37,520 --> 00:12:39,090
.أفهم ما تشعرين به

200
00:12:39,680 --> 00:12:43,340
...سيشاهد الكثير من النّاس مسرح المهرجان

201
00:12:44,660 --> 00:12:47,570
حسنًا، سأقرأ هذا بشكل معمّق

202
00:12:48,010 --> 00:12:50,080
.وسنتقابل ثانية بعد المدرسة

203
00:12:50,410 --> 00:12:52,110
.أقدّر لك هذا

204
00:12:52,700 --> 00:12:54,620
...في الحقيقة

205
00:12:55,010 --> 00:12:56,950
نعم؟ ماذا هنالك؟

206
00:12:56,950 --> 00:12:59,220
...أنا... كنت

207
00:13:00,000 --> 00:13:01,340
هل من خطب؟

208
00:13:03,260 --> 00:13:04,840
"ناقش ما تبحث عنه في شريك المواعدة"

209
00:13:04,840 --> 00:13:07,100
ماذا أفعل الآن؟

210
00:13:09,660 --> 00:13:12,220
...وجدتُها! إن كانت كيكوتشي-سان هي خياري

211
00:13:13,120 --> 00:13:17,050
قلتِ من قبل أنّك حاولت اكتشاف

212
00:13:17,050 --> 00:13:21,610
ما الشّخصيّة الّتي سينتهي
بها المطاف مع البطل ليبرا، صحيح؟

213
00:13:21,940 --> 00:13:25,610
.نعم. كريس أو ألوسيا

214
00:13:25,900 --> 00:13:29,120
إنّ النّاس الّذين يرون الرّومانسيّة من
ناحية من سينتهي به المطاف مع من

215
00:13:29,570 --> 00:13:32,070
.سيُبدون اهتمامًا أكثر بهذه القصّة

216
00:13:32,070 --> 00:13:32,920
.نعم

217
00:13:33,450 --> 00:13:40,400
،لذلك... إن كان هناك فتى وفتاة يتواعدان

218
00:13:40,400 --> 00:13:42,880
ماذا يجب أن تكون معاييرهما في رأيك؟

219
00:13:43,160 --> 00:13:46,720
معاييرهما في اختيار من يواعدان؟

220
00:13:46,720 --> 00:13:49,140
.نعم. صحيح

221
00:13:50,670 --> 00:13:55,140
...ما زال هناك الكثير ممّا أجهله

222
00:13:55,820 --> 00:13:59,400
لكن أعتقد أنّ الأمر يعتمد

223
00:13:59,850 --> 00:14:03,900
.على ما تعنيه "المواعدة" لأيّ شخص

224
00:14:05,070 --> 00:14:07,320
ما تعنيه المواعدة؟

225
00:14:07,860 --> 00:14:12,950
إن كان المرء مهتمًّا فقط
،في تجربة موضوع "المواعدة" هذا

226
00:14:12,950 --> 00:14:17,580
أو إن كان الثّنائي يرغب في
...تسمية العلاقة الّتي تجمعهما

227
00:14:18,890 --> 00:14:20,210
.فهمت

228
00:14:20,880 --> 00:14:24,550
...على الأرجح أنّ ذلك يكفي لمهمّتي

229
00:14:21,590 --> 00:14:24,550
"ناقش ما تبحث عنه في شريك المواعدة"

230
00:14:24,850 --> 00:14:28,000
.لكنّي أريد التّطرّق لهذا أكثر

231
00:14:29,280 --> 00:14:36,560
"حسنًا، ما الّذي تعنيه "المواعدة
بالنّسبة لك شخصيًّا؟

232
00:14:37,180 --> 00:14:40,060
بالنّسبة لي شخصيًّا؟

233
00:14:40,350 --> 00:14:41,820
.نعم

234
00:14:42,310 --> 00:14:43,520
...حسنًا

235
00:14:43,930 --> 00:14:49,160
هناك قصّة من تأليف أندي
."تُدعى "كذبة رجل المقصّ

236
00:14:49,160 --> 00:14:53,910
أعرفها. إنّها قصّة حبّ قصيرة
.عن رجل المقصّ والأميرة

237
00:14:53,910 --> 00:14:54,830
.نعم

238
00:14:54,830 --> 00:15:04,340
"كذبة رجل المقصّ"

239
00:14:55,680 --> 00:15:00,630
إنّها عن رجل لديه مقصّات بدل
يديه ويؤذي النّاس من دون قصد

240
00:15:00,630 --> 00:15:04,340
ويُسحب إلى عالم الكتب القصصيّة
.ويقع في حبّ أميرة

241
00:15:05,030 --> 00:15:08,910
.تتشكّل رابطة بين الثّنائيّ الوحيد مع الوقت

242
00:15:09,830 --> 00:15:13,440
،رجل المقصّ هو الوحيد المناسب للأميرة

243
00:15:13,440 --> 00:15:17,300
.والأميرة هي الوحيدة المناسبة له

244
00:15:18,660 --> 00:15:24,150
أعتقد أنّ المواعدة هي القدرة
.على إنشاء علاقة مثل هذه

245
00:15:24,990 --> 00:15:28,700
علاقة لا يستطيع أيّ أحد آخر
.أخذ مكان شريكك

246
00:15:29,120 --> 00:15:30,350
.صحيح

247
00:15:30,350 --> 00:15:37,790
علاقة خاصّة، حيث لا أحد آخر سيكون
.مناسبًا، وتتّخذ شكلاً مثاليًّا واحدًا

248
00:15:38,090 --> 00:15:43,290
أعتقد أنّ ذلك قد يكون
.معنى "المواعدة" في نظري

249
00:15:44,170 --> 00:15:46,980
شكل مثاليّ واحد؟

250
00:15:46,980 --> 00:15:49,550
.عليّ التّفكير في ذلك أنا أيضًا

251
00:15:49,890 --> 00:15:52,800
ألديك رأي خاصّ بك حيال هذا؟

252
00:15:53,400 --> 00:15:56,490
.حسنًا... لم أفكّر في الأمر بجدّيّة أبدًا

253
00:15:56,490 --> 00:15:58,150
.هكذا إذًا

254
00:15:58,150 --> 00:16:05,560
لكنّه سبب إضافيّ يدفعني للبحث
.عن تعريف خاصّ بي للمواعدة

255
00:16:05,840 --> 00:16:11,070
حسنًا، أرجو أن تتشاركه معي
.بمجرّد أن تعرفه

256
00:16:12,700 --> 00:16:18,330
عفوًا! للمساعدة... أقصد للمساعدة
...في كتابة النّص لا غير

257
00:16:18,590 --> 00:16:20,950
كمرجع، صحيح؟

258
00:16:20,950 --> 00:16:23,460
.نعم. كمرجع

259
00:16:28,840 --> 00:16:30,720
.مرحبًا يا فوميا

260
00:16:30,720 --> 00:16:32,470
ماذا هنالك يا ميزوساوا؟

261
00:16:34,520 --> 00:16:36,470
.الوضح غريب بينك وبين ميميمي بكلّ تأكيد

262
00:16:36,470 --> 00:16:38,190
...ما الّذي

263
00:16:38,780 --> 00:16:40,080
...أنت

264
00:16:40,080 --> 00:16:42,510
.يتطلّب هذا الأمر إجراءات قصوى

265
00:16:43,670 --> 00:16:44,980
.لنتناول الغداء معًا

266
00:16:44,980 --> 00:16:45,770
ماذا؟

267
00:16:53,820 --> 00:16:56,320
ستتناول طبق مابو يا برين؟

268
00:16:56,630 --> 00:16:58,830
وأنت ستتناولين الرّامن يا ميميمي؟

269
00:17:01,810 --> 00:17:03,280
...اسمع يا توموزاكي

270
00:17:03,280 --> 00:17:04,830
ما-ماذا؟

271
00:17:05,340 --> 00:17:08,590
...بشأن... البارحة

272
00:17:10,720 --> 00:17:14,000
.لا داعي للقلق حيال الأمر كثيرًا

273
00:17:14,000 --> 00:17:15,550
!في الحقيقة، انسه

274
00:17:16,250 --> 00:17:19,000
.ليس تمامًا

275
00:17:19,000 --> 00:17:22,810
.لنواصل كما كنّا دائمًا... أو ما شابه

276
00:17:23,080 --> 00:17:24,810
.أكيد

277
00:17:24,810 --> 00:17:26,050
.مفهوم

278
00:17:28,480 --> 00:17:30,860
!ماذا؟ من كان يدري؟

279
00:17:30,860 --> 00:17:32,610
أحدث معك نفس الأمر يا أوي؟

280
00:17:32,610 --> 00:17:34,030
!صحيح

281
00:17:34,030 --> 00:17:38,110
!سألني البعض إن كنّا نتواعد يا تاكاهيرو

282
00:17:39,250 --> 00:17:44,400
.أجل، سيكون هذان الاثنان ثنائيًّا ممتازًا

283
00:17:44,400 --> 00:17:46,330
.بالطّبع سيكون هذا رأيك

284
00:17:46,840 --> 00:17:49,460
ماذا عنك أنت يا توموزاكي-كُن؟

285
00:17:51,720 --> 00:17:53,710
...أنا

286
00:17:53,950 --> 00:17:58,070
أستطيع الشّعور بضغطها عليّ
لأستفيد من هذا الوضع

287
00:17:58,070 --> 00:17:59,720
.لإتمام مهمّاتي

288
00:17:59,970 --> 00:18:01,600
أ-أنا؟

289
00:18:01,600 --> 00:18:06,370
نعم! يبدو وكأن هنالك شيئًا ما يجري
...معك، ولكنّ ذلك ليس صحيحًا

290
00:18:06,370 --> 00:18:08,610
أو يبدو وكأنّه ليس هنالك أيّ
.شيء، ولكنّه موجود فعلاً

291
00:18:08,610 --> 00:18:09,980
أيّهما تقصدين؟

292
00:18:09,980 --> 00:18:15,240
ربّما يوجد. لقد ذهب إلى مهرجان
.ثانويّة الفتيات قبل كلّ شيء

293
00:18:15,700 --> 00:18:18,240
.وتحدّث مع فتيات وما شابه

294
00:18:20,120 --> 00:18:23,620
.ما كنتُ لأتفاجأ إن حدث شيء ما بعد ذلك

295
00:18:24,020 --> 00:18:26,120
أهذا صحيح يا برين؟

296
00:18:26,120 --> 00:18:28,960
!لا، لا يوجد أيّ شيء

297
00:18:29,690 --> 00:18:31,020
...هكذا إذًا

298
00:18:31,020 --> 00:18:32,820
ما الأمر يا مينمي؟

299
00:18:32,820 --> 00:18:34,400
ماذا؟

300
00:18:34,400 --> 00:18:35,800
.تتصرّفين بغرابة اليوم

301
00:18:35,800 --> 00:18:39,120
.نعم. لاحظتُ ذلك أنا أيضًا

302
00:18:39,120 --> 00:18:42,300
!أراهن أنّها تخفي عنّا شيئًا ما

303
00:18:42,640 --> 00:18:46,140
...ما كنتُ لأقول... ذلك

304
00:18:46,140 --> 00:18:50,400
مهلاً، هذا ليس الوقت المناسب
!لتنظري إليّ يا ميميمي

305
00:18:50,720 --> 00:18:54,320
...انسوا، انسوا. لندع ذلك جانبًا

306
00:18:54,320 --> 00:18:57,400
!ويحي... سيبرد الرّامن خاصّتي

307
00:18:57,400 --> 00:19:00,610
!كلوا طعامكم جميعًا قبل أن يبرد

308
00:19:04,910 --> 00:19:06,910
"طريقتي غير المألوفة للطّيران"

309
00:19:07,850 --> 00:19:12,580
هذا ما يجري في قصّة "طريقتي
:"غير المألوفة للطّيران

310
00:19:13,720 --> 00:19:16,490
،في عالم يعيش فيه البشر والتّنانين بتناغم

311
00:19:16,490 --> 00:19:21,000
.يوجد نوع واحد مميّز من التّنانين الطّائرة

312
00:19:21,000 --> 00:19:24,300
،سريعة التّأثّر بتوتّر وقلق البشر

313
00:19:24,300 --> 00:19:27,450
العامل الأكثر الأهمّيّة في تربيتها

314
00:19:27,450 --> 00:19:30,520
هو عدم تعريضها لأيّ شيء
.من دناسة ونجس العالم

315
00:19:31,580 --> 00:19:37,540
كان ليبرا ابن صانع الأقفال وألوسيا الملكة
.المستقبليّة، طفلان في ربيعهما الخامس عشر

316
00:19:37,540 --> 00:19:39,770
.كبرا معًا رغم اختلاف مكانتهما

317
00:19:40,320 --> 00:19:44,580
عندما كان ليبرا صغيرًا، زار القلعة
،بينما يقوم بمهمّات لوالده

318
00:19:44,580 --> 00:19:47,170
،وهكذا التقى بألوسيا العازمة والذّكيّة

319
00:19:47,170 --> 00:19:48,610
.وصار الاثنان صديقان

320
00:19:49,790 --> 00:19:53,040
،وفي أحد الأيّام، بينما كان والده يعمل

321
00:19:53,040 --> 00:19:57,330
.دعت ألوسيا ليبرا لاكتشاف القلعة

322
00:19:58,540 --> 00:20:03,100
كان يوجد بداخلها حديقة
.كان يُمنع عليهما دخولها

323
00:20:03,100 --> 00:20:06,750
.لكنّهما دخلاها بدافع الفضول

324
00:20:07,500 --> 00:20:12,930
وكان هناك أمامهما تنّين ناصع
البياض بجناحين ضخمين

325
00:20:12,930 --> 00:20:16,670
إلى رفقة فتاة صغيرة تُدعى كريس
.تجهل كلّ شيء عن العالم الخارجيّ

326
00:20:17,580 --> 00:20:22,230
تمّ التّخلّي عن كريس
،خارج القلعة وهي رضيعة

327
00:20:22,230 --> 00:20:24,720
.وكانت في ربيعها الخامس عشر أيضًا

328
00:20:24,720 --> 00:20:29,150
عاشت كريس هنا في عزلة عن
.العالم لخدمة التّنانين كحارسة

329
00:20:30,000 --> 00:20:32,700
لم يكن يُسمح لها أو للتّنانين بالتّواصل

330
00:20:32,700 --> 00:20:34,980
.مع أيّ بشر ليسوا من العائلة الملكيّة

331
00:20:37,370 --> 00:20:42,950
حكم الملك على ليبرا بالموت
.لدخوله الحديقة المحرّمة

332
00:20:43,850 --> 00:20:48,940
لكنّ ألوسيا واجهت والدها
.الملك بحقيقة صعبة

333
00:20:49,830 --> 00:20:54,600
إنّ للملك أطفالاً غير شرّعيّين
.في أنحاء المملكة

334
00:20:55,110 --> 00:20:58,960
خدعت ليبرا الملك بقول
،أنّ ليبرا هو أحد أولئك الأطفال

335
00:20:58,960 --> 00:21:03,610
.ما يجعله من العائلة الملكيّة وأخًا لها

336
00:21:04,720 --> 00:21:09,320
،وإن كان ليبرا من العائلة الملكيّة
.فلن يستطيع بذلك تلويث التّنانين

337
00:21:10,350 --> 00:21:14,210
لم يكن يريد الملك أن يُنشر
،سرّه المخجل للعلن

338
00:21:14,210 --> 00:21:16,550
،لذلك تراجع عن حكمه بالموت على ليبرا

339
00:21:17,570 --> 00:21:22,670
.وتمّ تكليفه بالعناية بكريس

340
00:21:25,650 --> 00:21:26,780
...عفوًا

341
00:21:27,700 --> 00:21:29,010
.لقد استمتعتُ بها

342
00:21:29,010 --> 00:21:31,140
!أ-أتقول الحقيقة؟

343
00:21:31,450 --> 00:21:36,640
نعم. راودتني نفس المشاعر
.عندما قرأت القصّة في البداية

344
00:21:36,940 --> 00:21:38,650
...سرّني سماع هذا

345
00:21:39,000 --> 00:21:43,900
هل لديك أيّ تعقيب عليها حتّى الآن؟

346
00:21:44,470 --> 00:21:45,820
...لنرَ

347
00:21:46,290 --> 00:21:47,780
ربّما الشّخصيّات؟

348
00:21:48,480 --> 00:21:49,900
الشّخصيّات؟

349
00:21:50,880 --> 00:21:53,820
.يبدون عاديّين كثيرًا الآن أو ما شابه

350
00:21:53,820 --> 00:21:56,910
،واثق أنّه من السّهل فهم القصّة هكذا

351
00:21:56,910 --> 00:21:59,920
.لكن يبدو وكأنّه ينقصهم شيء ما

352
00:22:00,170 --> 00:22:02,170
...ربّما معك حقّ

353
00:22:02,770 --> 00:22:06,070
.لقد غيّرت المفهوم قليلاً في الحقيقة

354
00:22:06,070 --> 00:22:11,550
بسّطتُ الشّخصيّات ليكون من السّهل
.على الجميع لعب أدوار مختلفة

355
00:22:11,840 --> 00:22:16,850
ربّما صارت للشّخصيّات الآن عيوب
.أو نواقص بعدما صار فهمها أسهل

356
00:22:17,760 --> 00:22:18,850
.فهمت

357
00:22:19,450 --> 00:22:24,190
تبرع قصصها القصيرة في إظهار
،أبسط تفاصيل الشّخصيّات

358
00:22:24,190 --> 00:22:26,940
،وطريقتها الخاصّة في التّفكير
.وحتّى مشاعرها المتضاربة

359
00:22:27,200 --> 00:22:30,200
.كان ذلك جزءًا كبيرًا من سحرها

360
00:22:30,540 --> 00:22:32,550
فكّرتُ في الاستغناء عن المشاعر المعقّدة

361
00:22:32,550 --> 00:22:35,580
.وإظهار الأفكار المباشرة في الواجهة

362
00:22:37,300 --> 00:22:40,280
لكن أشعر أنّ ذلك أضعفَ من الشّعور

363
00:22:40,280 --> 00:22:43,070
.الّذي جعل الشّخصيّات تبدو حيّة

364
00:22:43,680 --> 00:22:47,590
هل أواصل كتابتها كما هي؟

365
00:22:48,360 --> 00:22:53,220
.أعتقد... أنّ عليك العودة للشّخصيّات الأصليّة

366
00:22:55,610 --> 00:22:58,100
،قد يجعل ذلك تأديتها أمرًا صعبًا

367
00:22:58,600 --> 00:23:03,230
وقد يكون من الصّعب عليك
.توصيل ذلك بالحوار فقط

368
00:23:04,070 --> 00:23:04,720
...لكن

369
00:23:05,560 --> 00:23:08,240
.أعتقد أنّها مثيرة للاهتمام أكثر هكذا

370
00:23:10,360 --> 00:23:13,740
.حسنًا، مفهوم. سأجرّب ذلك

371
00:23:16,910 --> 00:23:19,500
.حدثت أمور كثيرة اليوم

372
00:23:19,800 --> 00:23:21,630
.أشعر وكأنّ رأسي سينفجر

373
00:23:22,500 --> 00:23:25,000
ما الّذي عليّ أن أفكّر به؟

374
00:23:25,000 --> 00:23:26,870
ماذا أفعل؟

375
00:23:27,790 --> 00:23:29,510
ماذا تعني "المواعدة"؟

376
00:23:29,990 --> 00:23:32,510
...وإن عرفتُ ذلك

377
00:23:32,910 --> 00:23:35,100
،مع من أريد أن أكون أكثر

378
00:23:35,600 --> 00:23:38,780
ميميمي أم كيكوتشي-سان؟