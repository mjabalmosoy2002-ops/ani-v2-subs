1
00:00:08,080 --> 00:00:09,430
توموزاكي؟

2
00:00:13,720 --> 00:00:15,870
أردتَ نصيحة؟

3
00:00:16,140 --> 00:00:19,420
،إنّك تعبثين مع تاما-تشان دائمًا

4
00:00:19,420 --> 00:00:22,010
لذلك فكّرتُ في أنّك قد تستطيعين
.منحي بعض النّصائح

5
00:00:22,010 --> 00:00:25,490
!مهلاً يا توموزاكي! هذا لا يغتفر ببساطة

6
00:00:25,880 --> 00:00:28,130
...أنا لا أعبث مع تاما

7
00:00:28,860 --> 00:00:31,790
!بل أنا أعبّر عن حبّي لا غير

8
00:00:32,880 --> 00:00:34,650
...حـ-حسنًا

9
00:00:34,650 --> 00:00:36,310
!يا له من ردّ ضعيف

10
00:00:36,310 --> 00:00:38,880
!ما بالك؟ أظهر بعض الحماسة

11
00:00:38,880 --> 00:00:40,710
...عفوًا

12
00:00:40,710 --> 00:00:44,980
إ-إنّ لك طريقة ممتعة حقًّا
!في التّعبير عن حبّك يا ميميمي

13
00:00:45,800 --> 00:00:48,780
وتقوم بحركة تاما الخاصّة؟
!هذا متوقّع منك يا برين

14
00:00:48,780 --> 00:00:50,120
فـ-فعلاً؟

15
00:00:50,120 --> 00:00:51,150
!بالطّبع

16
00:00:51,680 --> 00:00:54,320
!أنت شريك الكوميديا الوحيد لي يا برين

17
00:00:54,320 --> 00:00:57,260
تستدرجيني للقيام بعرض كوميديّ معك الآن؟

18
00:00:59,080 --> 00:01:02,930
على أيّ حال، ماذا حيال تاما-تشان
—تأخذينه كهدف لمضايقـ

19
00:01:03,630 --> 00:01:07,120
أقصد للتّعبير عن حبّك؟

20
00:01:09,380 --> 00:01:12,130
ربّما ظرافتها وصغر حجمها؟

21
00:01:12,700 --> 00:01:14,490
...توقّعت ذلك

22
00:01:15,060 --> 00:01:19,890
حسنًا، هل رأيت أيّ عروض
كوميديا جيّدة مؤخّرًا؟

23
00:01:19,890 --> 00:01:22,100
ماذا؟ لماذا تسأل عن هذا بالضّبط؟

24
00:01:22,350 --> 00:01:23,450
...كنت أفكّر فحسب

25
00:01:23,450 --> 00:01:27,570
إذا كانت لدى تاما-تشان نقطة
،ضعف واضحة مثل تاكي

26
00:01:27,570 --> 00:01:31,440
فيمكن للفصل أن يعتاد عليها
.كجزء من شخصيّتها

27
00:01:31,960 --> 00:01:33,280
.هذا لأجل البحث

28
00:01:38,280 --> 00:01:42,170
...أعني... لديّ الكثير من الأفكار، لكن

29
00:01:42,670 --> 00:01:43,990
...يا توموزاكي

30
00:01:44,300 --> 00:01:45,500
.أنت ماكر

31
00:01:46,840 --> 00:01:52,230
إنّك تشعر بالحرج بسرعة، ولكن عندما
.تشتدّ الأوضاع... فأنّت تشتدّ معها أيضًا

32
00:01:52,230 --> 00:01:52,590
!أجل

33
00:01:53,750 --> 00:01:54,460
—ما الّذي

34
00:01:54,730 --> 00:01:57,440
أكسبَتك عقدة البطل خاصّتك
.عقابَ أنفِ خنزير

35
00:01:57,440 --> 00:01:59,460
!لا أعرف ما معنى أيّ من هذا

36
00:02:00,360 --> 00:02:02,190
!ليس عليك أن تعرف

37
00:02:03,290 --> 00:02:05,980
!كلاّ! تبدو قبيحًا جدًّا

38
00:02:06,960 --> 00:02:11,550
يـ-يمكن للمرء أن يكون قبيحًا من الخارج
!ويملك قلبًا جميلاً... على الأرجح

39
00:02:11,550 --> 00:02:13,790
.نعم، أعلم ذلك

40
00:02:19,220 --> 00:02:21,920
سألتَ عن عروض كوميديّة؟

41
00:02:21,920 --> 00:02:23,270
...دعني أرى

42
00:02:24,220 --> 00:02:27,470
!مهلاً... ما كان كلّ ذلك؟

43
00:04:02,240 --> 00:04:04,010
.يا ويحي. آسفة

44
00:04:04,530 --> 00:04:09,010
.استمرّت مضايقات مجموعة فتيات كونّو

45
00:04:09,390 --> 00:04:11,550
،لكنّ تاما-تشان استمرّت في التّحمّل

46
00:04:11,550 --> 00:04:17,280
.ما جعل الفصل يصير متعاطفًا معها أكثر فأكثر

47
00:04:18,710 --> 00:04:23,260
واستمرّت هينامي أيضًا في خلق
.جوّ يهدف لحماية تاما-تشان

48
00:04:24,070 --> 00:04:24,860
...إضافة لذلك

49
00:04:25,640 --> 00:04:26,780
هينامي؟

50
00:04:27,190 --> 00:04:32,550
لقد طلبت منّي ألاّ أقضي الوقت
.مع شوجي في الوقت الحاليّ

51
00:04:33,070 --> 00:04:36,920
.ولا حتّى خارج المدرسة
.قالت أنّ إريكا قد ترانا

52
00:04:36,920 --> 00:04:41,800
.أعتقد أنّ الوضع قد يسوء إن رأتكما إريكا

53
00:04:42,060 --> 00:04:45,860
،فعلاً؟ عندما أخبرت شوجي
نفخ صدره غضبًا

54
00:04:45,860 --> 00:04:49,120
."وقال "لا أمانع

55
00:04:49,600 --> 00:04:51,310
ولذلك السّبب

56
00:04:51,870 --> 00:04:56,310
كنتُ أفكّر في حياكة أو خياطة شيء ما له

57
00:04:56,310 --> 00:04:57,820
.بهدف التّصالح معه

58
00:04:59,400 --> 00:05:02,450
هل سينفع ذلك مع ناكامورا أساسًا؟

59
00:05:03,250 --> 00:05:05,220
.ربّما أتصرّف بأنانيّة فحسب

60
00:05:05,800 --> 00:05:10,320
لطالما حلمت بمنح هدايا
،محاكة باليد لحبيبي

61
00:05:10,320 --> 00:05:11,620
...لكن

62
00:05:11,900 --> 00:05:15,870
هلاّ توقّفت رجاءً عن الشّعور بالحرج؟
.أنت من فتح هذا الموضوع أساسًا

63
00:05:19,110 --> 00:05:20,380
!ا-اخرس

64
00:05:22,760 --> 00:05:28,690
ومع ذلك، لا يبدو لي مثل هذا الطّلب
.الكبير لإيزومي من صفات هينامي

65
00:05:29,300 --> 00:05:33,600
.لا بدّ أنّها محتارة كثيرًا

66
00:05:33,600 --> 00:05:35,600
"غرفة سمعيّات وبصريّات قديمة"

67
00:05:36,110 --> 00:05:38,100
.ثمّ جاء موعد الغداء

68
00:05:39,890 --> 00:05:42,320
.أنا آسف على التّأخير

69
00:05:42,320 --> 00:05:45,100
تطلّب الأمر منّي وقتًا حتّى
.أتخلّص من شوجي

70
00:05:45,100 --> 00:05:46,700
.آسفة بشأن ذلك

71
00:05:46,700 --> 00:05:49,830
لا داعي لذلك. كيف يسير التّدريب؟

72
00:05:49,830 --> 00:05:52,840
حسنًا... كيف يسير يا سينسي؟

73
00:05:53,450 --> 00:05:55,450
سينسي"؟ أتقصدينني أنا؟"

74
00:05:55,740 --> 00:05:59,710
.هذا صحيح. إنّك تدرّبني في كلّ استراحة

75
00:06:00,380 --> 00:06:01,980
.هـ-هكذا إذًا

76
00:06:02,660 --> 00:06:06,720
.عفوًا... أرى أنّ التّدريب يسير على خير

77
00:06:07,060 --> 00:06:07,860
!فعلاً؟

78
00:06:07,860 --> 00:06:11,080
.جيّد. لنَركِ إذًا في وضع تاكي

79
00:06:11,080 --> 00:06:12,220
.مفهوم

80
00:06:14,800 --> 00:06:16,100
!أروني ما لديكم

81
00:06:16,410 --> 00:06:18,080
!هذا جيّد

82
00:06:18,080 --> 00:06:20,230
!فعلاً؟ قضيت وقتًا طويلاً في التّدريب

83
00:06:20,480 --> 00:06:22,480
صحيح؟ وماذا فعلت في التّدريب؟

84
00:06:22,480 --> 00:06:27,760
،سجّلت نفسي وأنا أتكلّم
،وقارنت ذلك بطريقة كلام تاكي ومينمي

85
00:06:27,760 --> 00:06:29,110
!ثمّ صحّحت طريقة كلامي

86
00:06:29,360 --> 00:06:33,120
أخذتِ تاكي وميميمي كنموذج؟
.خيار جيّد

87
00:06:33,120 --> 00:06:37,270
!كما أنّها لم تكن فكرة توموزاكي، بل فكرتي

88
00:06:37,270 --> 00:06:38,230
هذا مذهل، صحيح؟

89
00:06:39,130 --> 00:06:40,910
.نعم، مذهل

90
00:06:40,910 --> 00:06:43,130
!أنت! قل ذلك بصدق أكثر

91
00:06:43,130 --> 00:06:45,100
.حسنًا. أنا آسف

92
00:06:45,100 --> 00:06:47,020
!وهذا كذلك

93
00:06:50,160 --> 00:06:51,940
ما رأيك؟

94
00:06:52,640 --> 00:06:55,890
.كنتُ أحاول الحديث ببهجة أكثر من السّابق

95
00:06:56,130 --> 00:06:58,820
،صحيح، صار الحديث معك أسهل بكثير الآن

96
00:06:58,820 --> 00:07:00,620
.وأعتقد أنّ ظرافتك بدأت تظهر

97
00:07:00,620 --> 00:07:01,650
!فعلاً؟

98
00:07:01,870 --> 00:07:05,400
،حسنًا يا تاما-تشان
.جرّبي ذلك الشّيء الآخر الآن

99
00:07:05,630 --> 00:07:08,070
هناك المزيد؟

100
00:07:08,070 --> 00:07:12,620
استعملتُ عروض الكوميديا هذه
.الّتي أخبرتني عنها مينمي كمرجع

101
00:07:12,620 --> 00:07:14,450
هلاّ بدأتَ يا توموزاكي؟

102
00:07:14,450 --> 00:07:15,370
!حسنًا

103
00:07:16,890 --> 00:07:20,000
ماذا؟ لماذا أنت بعيدة جدًّا
هكذا يا تاما-تشان؟

104
00:07:20,000 --> 00:07:25,380
أنا أبدو بعيدة فحسب، لكنّي قصيرة
!لا غير! إنّها مسألة منظور فقط

105
00:07:25,380 --> 00:07:26,500
فعلاً؟

106
00:07:26,500 --> 00:07:28,240
!نعم! إنّه وهم بصريّ

107
00:07:28,240 --> 00:07:31,790
ولكن اسمعي، هذه الغرفة
.أكبر ممّا توقّعتُ أيضًا

108
00:07:31,790 --> 00:07:33,760
!أخبرتك، هذا لأنّي قصيرة

109
00:07:33,760 --> 00:07:36,510
!إنّها تبدو كبيرة مقارنة بي فحسب

110
00:07:42,800 --> 00:07:43,770
ما هذا؟

111
00:07:44,190 --> 00:07:45,880
ظننّا أنّ هذه طريقة أسهل

112
00:07:45,880 --> 00:07:50,010
.ليعتاد الفصل على نقطة ضعف تاما-تشان

113
00:07:50,010 --> 00:07:54,410
.هذا ليس سيّئًا. حتّى أنّي أردت الانضمام

114
00:07:56,010 --> 00:07:57,410
.هذا ما أتوقّعه من فوميا

115
00:07:57,810 --> 00:08:01,010
.الأستاذ وتلميذته النّيّرة

116
00:08:01,010 --> 00:08:02,450
.نـ-نعم

117
00:08:02,450 --> 00:08:04,830
!أجل! "نيّرة" وصف صحيح

118
00:08:05,100 --> 00:08:07,140
...ولكنّ المُحزن هنا

119
00:08:07,140 --> 00:08:11,010
هو رؤية الأستاذ في مؤخّرة المضمار
.وقد سبقته التّلميذة بأميال

120
00:08:11,010 --> 00:08:12,540
...أ-أعتقد ذلك

121
00:08:12,960 --> 00:08:14,220
توموزاكي؟

122
00:08:14,790 --> 00:08:16,180
!هذا مؤسف

123
00:08:18,110 --> 00:08:21,350
أرى أنّ بإمكان تاما أن تبدأ
،في الاختلاط ببقيّة الفصل الآن

124
00:08:21,730 --> 00:08:24,480
.ولكن مع بعض الحذر في البداية

125
00:08:24,480 --> 00:08:30,320
نعم... إذًا نحتاج لتدريب أكثر
.في محيط لا بأس بالفشل فيه

126
00:08:30,320 --> 00:08:30,980
.أصبت

127
00:08:31,260 --> 00:08:35,260
كم أودّ إحضار شخص ما
،من الفصل للقيام بتجربة

128
00:08:35,260 --> 00:08:38,620
.لكنّ الجميع يتفادون تاما الآن

129
00:08:38,880 --> 00:08:41,620
.صحيح... سيكون هذا صعبًا

130
00:08:41,870 --> 00:08:46,770
أوي وميميمي في صفّنا، لكنّهما ودودتان
.سلفًا مع تاما ولا يُعتبر ذلك تدريبًا

131
00:08:46,770 --> 00:08:47,630
...لم يبق سوى

132
00:08:47,880 --> 00:08:49,080
إيزومي؟

133
00:08:50,230 --> 00:08:53,630
،إن اكتشفت إريكا الأمر
.فسيُعاني موقف يوزو

134
00:08:53,890 --> 00:08:55,520
...صحيح

135
00:08:57,250 --> 00:08:59,110
هل خطر ببالك شخص ما؟

136
00:08:59,110 --> 00:09:00,890
ماذا؟ من يكون؟

137
00:09:01,170 --> 00:09:04,780
.دعوني أتحقّق من الشّخص أوّلاً

138
00:09:07,650 --> 00:09:09,570
"المكتبة"

139
00:09:10,550 --> 00:09:12,070
...أنا متوتّرة

140
00:09:12,330 --> 00:09:14,310
.أ-أتفهّم ذلك

141
00:09:14,310 --> 00:09:18,000
عليّ الحديث مع هانابي-تشان
بطريقة عاديّة فحسب، صحيح؟

142
00:09:18,000 --> 00:09:22,080
،صحيح. لم تتحدّثي معها كثيرًا
أليس كذلك؟

143
00:09:22,350 --> 00:09:27,350
...نعم. أنا أجدها فتاة قويّة جدًّا

144
00:09:27,350 --> 00:09:29,330
.لكنّي لم أتحدّث إليها من قبل

145
00:09:31,780 --> 00:09:38,390
ما رأيك في مضايقة كونّو لتاما-تشان
وتجنّب الجميع لها؟

146
00:09:39,050 --> 00:09:40,100
...رأيي

147
00:09:40,540 --> 00:09:45,410
.أشعر بالسّوء حيال هانابي-تشان
.أجد الأمر ظالمًا

148
00:09:45,410 --> 00:09:51,030
.لكنّي لا أستطيع لوم كونّو-سان أو بقيّة الفصل

149
00:09:51,760 --> 00:09:52,860
ماذا تقصدين؟

150
00:09:53,080 --> 00:09:56,270
عفوًا... أنا لا أتّفق مع المضايقات

151
00:09:56,270 --> 00:10:01,620
.أو الانسجام مع الحشود لتجنّب أيّ أحد

152
00:10:02,160 --> 00:10:09,130
لكن أعتقد أنّ كونّو-سان وبقيّة الفصل
.مجبرون على فعل هذا لأنّهم ضعفاء

153
00:10:09,600 --> 00:10:10,880
ضعفاء؟

154
00:10:12,940 --> 00:10:18,600
لا بدّ أنّ هناك نوعًا من عدم الارتياح
.بداخلهم لا يمكنهم حلّه بمفردهم

155
00:10:18,600 --> 00:10:21,600
،إن لم ينفّسوا عنه بطريقة أو بأخرى
.فسيصير أكثر ممّا يمكنهم تحمّله

156
00:10:21,600 --> 00:10:24,260
،ويقلقون بشأن رؤية الآخرين لهم
.لذا ينضمّون إلى الحشود

157
00:10:25,120 --> 00:10:27,340
.قد يكون أمرًا كهذا

158
00:10:28,080 --> 00:10:33,300
أعتقد أنّ كونّو-سان والبقيّة يتصرّفون هكذا

159
00:10:33,300 --> 00:10:35,870
.بهدف الهرب من شيء ما لا يمكنهم إصلاحه

160
00:10:35,870 --> 00:10:37,280
.وإن كانت الطّريقة خاطئة

161
00:10:37,830 --> 00:10:39,590
...بهدف الهرب

162
00:10:40,480 --> 00:10:41,530
.نعم

163
00:10:42,000 --> 00:10:46,030
ومن بين كونّو-سان وبقيّة الفصل
وهانابي-تشان، فأنا أشعر

164
00:10:46,030 --> 00:10:50,260
.أنّ هانابي-تشان هي الأقوى بين الجميع

165
00:10:50,260 --> 00:10:51,540
.قد تكونين محقّة

166
00:10:51,990 --> 00:10:58,690
وأتساءل إن كانت كونّو-سان وبقيّة
.الفصل لا يعتمدون على تلك القوّة

167
00:10:58,690 --> 00:11:02,550
،لأنّه بالإمكان الاتّكاء عليها باستمرار
.لكنّ هانابي-تشان لن تسقط أبدًا

168
00:11:03,930 --> 00:11:04,810
...ومع ذلك

169
00:11:04,810 --> 00:11:08,150
.هذه المشكلة بحاجة لتُحلّ بطريقة ما

170
00:11:08,870 --> 00:11:14,560
لهذا السّبب أنا سعيدة لأنّ بإمكاني
.أن أكون جزءًا من الحلّ بفضلك

171
00:11:14,890 --> 00:11:17,520
.صحيح. لنجد الحلّ معًا

172
00:11:17,520 --> 00:11:19,450
.نعم. لنبذل جهدنا

173
00:11:26,650 --> 00:11:30,580
رسالة من تاما-تشان. قالت
.أنّ تدريبات الكرة الطّائرة انتهت

174
00:11:43,930 --> 00:11:45,930
"غرفة سمعيّات وبصريّات قديمة"

175
00:11:49,590 --> 00:11:51,300
أأنت متوتّرة؟

176
00:11:51,300 --> 00:11:52,180
.نعم

177
00:11:52,180 --> 00:11:54,380
ألا تثقين بفوميا؟

178
00:11:54,380 --> 00:11:55,270
.بلى

179
00:11:56,400 --> 00:11:57,940
.الأمر متعلّق بي

180
00:12:07,640 --> 00:12:08,890
كيكوتشي-سان؟

181
00:12:15,190 --> 00:12:16,920
.مرحبًا يا فوكا-تشان

182
00:12:17,170 --> 00:12:19,520
.نـ-نعم، مرحبًا

183
00:12:19,520 --> 00:12:22,810
هل كيكوتشي-سان هي من كنت تفكّر بها؟

184
00:12:22,810 --> 00:12:24,550
.نعم، هذا صحيح

185
00:12:29,350 --> 00:12:32,810
إنّها بالفعل طرف محايد
،لا علاقة لها بكونّو

186
00:12:32,810 --> 00:12:35,210
...وليست مقرّبة جدًّا من تاما

187
00:12:35,210 --> 00:12:36,530
.إنّها مثاليّة

188
00:12:36,530 --> 00:12:37,810
أ-أتظنّ؟

189
00:12:38,110 --> 00:12:40,590
هل شرح لك فوميا الأمر يا كيكوتشي-سان؟

190
00:12:40,590 --> 00:12:43,090
بشأن خطّتنا لمساعدة تاما؟

191
00:12:43,090 --> 00:12:45,200
.نعم، لقد فعل

192
00:12:45,510 --> 00:12:48,700
حسنًا. لماذا تتكلّمين برسميّة؟

193
00:12:49,690 --> 00:12:51,660
.إنّنا لسنا مقرّبين من بعض بعد

194
00:12:53,200 --> 00:12:55,420
حسنًا، لا يهمّ. هل نبدأ؟

195
00:12:56,330 --> 00:12:57,900
.حـ-حسنًا

196
00:13:03,970 --> 00:13:06,450
.أنت بالفعل شخص مليء بالمفاجآت

197
00:13:06,450 --> 00:13:07,930
ما المقصود بذلك؟

198
00:13:08,570 --> 00:13:10,260
...لا، لا، أنت تعلم

199
00:13:10,850 --> 00:13:14,270
،ربّما لا تجلب الانتباه لها كثيرًا
.لكنّ كيكوتشي-سان ظريفة جدًّا

200
00:13:15,710 --> 00:13:16,420
ماذا؟

201
00:13:16,850 --> 00:13:18,160
.لا شيء

202
00:13:20,100 --> 00:13:21,680
.أتطلّع للعمل معك

203
00:13:21,680 --> 00:13:23,190
.وأنا كذلك

204
00:13:23,530 --> 00:13:25,770
.وكأنّها منافسة من نوع ما

205
00:13:25,770 --> 00:13:30,580
صحيح. كما أنّها منافسة حقيقيّة
.بالنّسبة لتاما-تشان بالفعل

206
00:13:30,580 --> 00:13:34,200
عفوًا... من أين يجب أن أبدأ؟

207
00:13:36,330 --> 00:13:39,210
.لم أكن أعرف أنّك صديقة لتوموزاكي

208
00:13:41,660 --> 00:13:45,130
.صحيح، لقد صرنا أصدقاء مؤخّرًا فحسب

209
00:13:45,130 --> 00:13:48,140
ألا تعتقدين أنّه صار مبتهجًا أكثر مؤخّرًا؟

210
00:13:48,140 --> 00:13:52,160
بالفعل. وأظنّ أنّه من الرّائع
أن يعمل النّاس على تغيير أنفسهم

211
00:13:52,160 --> 00:13:54,140
.ليكونوا من يريدون أن يكونوا

212
00:13:54,770 --> 00:13:55,850
...من الرّائع

213
00:13:56,410 --> 00:13:57,520
.سمعتَ ما قالت

214
00:13:57,520 --> 00:13:58,350
...نـ-نعم

215
00:13:59,110 --> 00:14:01,750
من الرّائع أن يغيّر النّاس أنفسهم؟

216
00:14:01,750 --> 00:14:03,360
أتعتقدين ذلك بالفعل؟

217
00:14:03,850 --> 00:14:06,240
،نعم، وإن كان ذلك ما يريد الشّخص فعله

218
00:14:06,700 --> 00:14:08,990
.فأنا أجده أمرًا رائعًا

219
00:14:10,330 --> 00:14:13,180
.فهذا من أجل ميميمي في النّهاية

220
00:14:14,710 --> 00:14:15,440
!نعم

221
00:14:17,440 --> 00:14:20,750
.كان الوضع صعبًا عليك مؤخّرًا يا هانابي-تشان

222
00:14:21,130 --> 00:14:24,750
.كنتُ أنزعج كثيرًا منه سابقًا، لكنّي بخير الآن

223
00:14:24,750 --> 00:14:27,260
،لديّ أوي ومينمي إلى جانبي

224
00:14:27,520 --> 00:14:30,640
.كما أنّ توموزاكي وميزوساوا يساعدنني أيضًا

225
00:14:31,520 --> 00:14:33,310
.سرّني سماع هذا

226
00:14:33,310 --> 00:14:35,390
!لكنّي أقدّر لك قلقك عليّ

227
00:14:35,750 --> 00:14:40,400
نعم. لديك الكثير من الأصدقاء الّذين
.يمكنك الاعتماد عليهم. كم أحسدك

228
00:14:40,660 --> 00:14:44,160
.نعم، يمكن الاعتماد على الجميع عدا توموزاكي

229
00:14:44,160 --> 00:14:44,820
!على رسلك

230
00:14:46,070 --> 00:14:51,000
إن كان كلّ هؤلاء الأشخاص سيجتمعون
،حولك حتّى في مثل هذا الوضع الرّهيب

231
00:14:51,000 --> 00:14:54,280
.فهذا يعني أنّهم يهتمّون بك حقًّا

232
00:14:54,280 --> 00:14:56,540
!إ-إنّك تخجلينني فحسب الآن

233
00:14:57,800 --> 00:15:00,480
أنت شخص رائع يا هانابي-تشان
.وظريفة أيضًا

234
00:15:00,480 --> 00:15:03,540
!كلاّ! أنا قصيرة فحسب

235
00:15:03,540 --> 00:15:04,570
قصيرة؟

236
00:15:05,550 --> 00:15:07,920
!لا، مهلاً! انسي أنّي قلتُ ذلك

237
00:15:09,200 --> 00:15:11,090
.من الجيّد أنّنا قمنا بهذه التّجربة

238
00:15:11,090 --> 00:15:12,080
.نعم

239
00:15:12,080 --> 00:15:13,430
!يا تاما

240
00:15:13,650 --> 00:15:16,590
.لا تهربي بعيدًا فقط لأنّك تشعرين بالإحراج

241
00:15:16,590 --> 00:15:21,250
!أنا قصيرة فحسب
!أبدو كأنّي بعيدة لأنّني قصيرة لا غير

242
00:15:21,250 --> 00:15:22,310
فعلاً؟

243
00:15:22,310 --> 00:15:24,100
!نعم! إنّه وهم بصريّ

244
00:15:25,130 --> 00:15:27,070
.أنت ظريفة بالفعل

245
00:15:27,070 --> 00:15:29,020
...سبق وأخبرتك

246
00:15:32,070 --> 00:15:34,070
"غرفة سمعيّات وبصريّات قديمة"

247
00:15:34,640 --> 00:15:36,580
.أعتقد أنّ هذا يكفي كتدريب اليوم

248
00:15:37,120 --> 00:15:38,450
ما رأيك يا كيكوتشي-سان؟

249
00:15:38,650 --> 00:15:41,460
.كان من السّهل جدًّا الحديث مع هانابي-تشان

250
00:15:41,730 --> 00:15:43,520
!سأعتبر الأمر قد نجح إذًا

251
00:15:43,520 --> 00:15:49,730
علينا الآن أن نرى إن كان بإمكان
.تاما أن تبدأ في الاهتمام بزملائها

252
00:15:49,730 --> 00:15:50,920
.نعم

253
00:15:54,210 --> 00:15:57,430
إن كنت قريبة ولو قليلاً ممّا كنتُ
،عليه في الدّورة الأولى

254
00:15:57,710 --> 00:16:00,770
:فأنا واثق أنّ هذا ما تفكّرين به

255
00:16:00,770 --> 00:16:04,690
،مهما حدث في الفصل"
".فهو عالم لا علاقة لي به أبدًا

256
00:16:05,320 --> 00:16:07,820
.لا يمكنني أن أكون جزءًا من أيّ من ذلك

257
00:16:08,080 --> 00:16:09,300
...هذا

258
00:16:11,200 --> 00:16:12,200
.نعم، ربّما

259
00:16:12,480 --> 00:16:14,950
،عندما كنتُ أشعر هكذا

260
00:16:15,560 --> 00:16:17,030
،حتّى لو كان المرح يحيط بي

261
00:16:17,700 --> 00:16:21,410
.إلاّ أنّ الواقع بدا لي أقلّ أهمّيّة من الخيال

262
00:16:21,410 --> 00:16:24,310
.كان كلّ شيء... رماديًّا

263
00:16:24,860 --> 00:16:28,170
،لكن بمجرّد أن قمت بقفزة الإيمان تلك

264
00:16:28,170 --> 00:16:32,270
تلوّن العالم الرّماديّ بالألوان
.ببطء، ولكن بثبات

265
00:16:32,270 --> 00:16:35,430
بدأت أصير قادرًا على الاهتمام
.أكثر بالنّاس الّذين حولي

266
00:16:35,840 --> 00:16:40,430
على الأرجح أنّك تعتقدين أنّ النّاس
.لا يحبّونك كثيرًا يا تاما-تشان

267
00:16:41,310 --> 00:16:44,190
.لكنّ الأشخاص السّيّئين الحقيقيّين نادرون

268
00:16:45,310 --> 00:16:48,060
...حسب رأيي، إن سمحتم لي

269
00:16:48,330 --> 00:16:54,070
أرى أنّ كونّو-سان لا ترضى بالخسارة
.وتكره أن ينظر لها النّاس باحتقار

270
00:16:54,290 --> 00:16:59,580
ولكن بالنّسبة للأشخاص الّذين تقرّر أنّهم
.أصدقاؤها، يمكنها أن تكون رحيمة أيضًا

271
00:16:59,870 --> 00:17:04,300
لا بدّ أنّ كاميماي-سان وأكياما-سان
،لديهما ثقة قليلة في نفسيهما

272
00:17:04,300 --> 00:17:09,460
لذلك تصادقان أشخاصًا واثقين
.من أنفسهم لملء ذلك الفراغ

273
00:17:09,750 --> 00:17:13,870
ومع ذلك، هذه أيضًا طريقة جيّدة
لأخذ زمام المبادرة

274
00:17:13,870 --> 00:17:15,790
.وتغيير الوضع من حولهم

275
00:17:16,380 --> 00:17:21,980
تضع إيزومي-سان الآخرين قبل نفسها وتميل
.إلى أن تكون في الجانب الخاسر بسبب ذلك

276
00:17:22,460 --> 00:17:28,270
ولكنّ هذا اللّطف أيضًا هو الّذي جعلها
.تشعر بألم الآخرين كما لو كان ألمها

277
00:17:29,000 --> 00:17:34,080
كلّ شخصيّة في القصّة الّتي هي فصلنا

278
00:17:34,080 --> 00:17:38,410
.لديها مخاوفها ونموّها وأخطاؤها الخاصّة بها

279
00:17:39,000 --> 00:17:42,910
لا يوجد شخص على قيد الحياة
.لا يفكر حقًّا في لا شيء على الإطلاق

280
00:17:43,440 --> 00:17:48,670
.أتساءل إن كان ذلك الإدراك قد يثير اهتمام قليلاً

281
00:17:50,720 --> 00:17:51,670
.نعم

282
00:17:52,710 --> 00:17:53,890
.فكّرت في هذا مطوّلاً

283
00:17:55,030 --> 00:17:58,460
كما هو متوقّع، إنّ فوميا
،وكيكوتشي-سان أيضًا

284
00:17:59,020 --> 00:18:02,810
ربّما يتقدّمان ببطء، ولكن أعتقد
.أنّ ذلك لأنّهما حذرين ودقيقين

285
00:18:04,270 --> 00:18:06,090
.عكسي أنا تمامًا

286
00:18:08,000 --> 00:18:08,940
!تاما

287
00:18:09,200 --> 00:18:11,170
!ها أنا ذي

288
00:18:11,170 --> 00:18:11,690
...مهلاً

289
00:18:12,060 --> 00:18:14,690
كيكوتشي-سان برفقتك الآن؟

290
00:18:15,700 --> 00:18:17,450
...مـ-مرحبًا

291
00:18:18,180 --> 00:18:20,370
ما هذه المجموعة؟

292
00:18:20,610 --> 00:18:24,960
.إنّها مساعِدة مؤقّتة لفريق توموزاكي اليوم

293
00:18:25,420 --> 00:18:28,000
.إنّها صديقة لفوميا وقرّرت مساعدتنا

294
00:18:28,310 --> 00:18:30,290
.حسنًا، هكذا إذًا

295
00:18:30,290 --> 00:18:32,050
.لم أتوقّع ذلك أبدًا

296
00:18:39,940 --> 00:18:41,090
.أنت ظريفة

297
00:18:42,970 --> 00:18:46,980
كيف لم أدرك وجود فتاة
ظريفة كهذه من قبل؟

298
00:18:46,980 --> 00:18:49,480
!مرحبًا بك في عالم نانامي

299
00:18:49,480 --> 00:18:52,480
!عا-عالم نانامي؟

300
00:18:52,480 --> 00:18:55,230
.مهلاً يا ميميمي، تريثي قليلاً معها رجاءً

301
00:18:55,670 --> 00:18:57,740
.إنّها ليست معتادة على حماستك بعد

302
00:18:58,500 --> 00:19:02,880
أنت الأسوأ! كيف تقف إلى جانب
كيكوتشي-سان وليس إلى جانبي؟

303
00:19:02,880 --> 00:19:05,420
!هذه ليست المشكلة هنا

304
00:19:05,830 --> 00:19:09,830
!كلاّ! نسيت تسليم مذكّرتي

305
00:19:10,210 --> 00:19:12,130
هلاّ جئتِ معي يا ميميمي؟

306
00:19:12,380 --> 00:19:14,090
ماذا؟ أنا؟

307
00:19:19,760 --> 00:19:21,760
!حسنًا، سأرافقك

308
00:19:21,760 --> 00:19:22,890
!أنت أيضًا يا تاما

309
00:19:22,890 --> 00:19:25,470
ماذا؟ لماذا أنا أيضًا؟

310
00:19:25,470 --> 00:19:27,470
!تعالي فحسب

311
00:19:27,750 --> 00:19:30,580
.نسيت شيئًا ما أيضًا في الفصل
.سأعود بعد قليل

312
00:19:32,260 --> 00:19:33,340
...أكيد

313
00:19:39,740 --> 00:19:42,740
"اليوم"
"!تاكاهيرو: سنذهب للمنزل! حظًّا سعيدًا"
"مهلاً!" "قُرأت"

314
00:19:40,960 --> 00:19:42,740
.خُدعت بالكامل

315
00:19:43,420 --> 00:19:46,220
.هذه أوّل مرّة نذهب فيه للمنزل معًا

316
00:19:47,010 --> 00:19:48,950
.أ-أعتقد هذا

317
00:19:49,340 --> 00:19:53,090
عفوًا... كيف سار اليوم بالنّسبة لك؟

318
00:19:53,090 --> 00:19:53,750
...اليوم

319
00:19:54,530 --> 00:19:59,410
كنتُ متوتّرة قليلاً لتواجدي بين الكثير
.من الأشخاص الّذين لم أكلّمهم من قبل

320
00:19:59,410 --> 00:20:04,950
لكن كان من الجيّد رؤيتك تتحدّثين
.مع الجميع من باب التّغيير

321
00:20:04,950 --> 00:20:06,400
فعلاً؟

322
00:20:06,940 --> 00:20:09,600
ظننتُ أنّ من اللّطيف أن أكون قريبة

323
00:20:09,600 --> 00:20:12,510
لرؤيتك تستمتع بوقتم مع
.الجميع من باب التّغيير

324
00:20:13,140 --> 00:20:15,410
.لطيفًا... وممتعًا جدًّا

325
00:20:15,410 --> 00:20:16,650
فـ-فعلاً؟

326
00:20:17,260 --> 00:20:23,400
.إنّك تريني دائمًا أشياء لم أرها من قبل

327
00:20:29,760 --> 00:20:31,000
،وأخيرًا في اليوم التّالي

328
00:20:31,000 --> 00:20:35,420
وضعت تاما-تشان دروسها
.قيد العمل في الفصل

329
00:20:35,420 --> 00:20:39,300
!لا تقفي بعيدًا جدًّا يا تاما، اقتربي

330
00:20:39,300 --> 00:20:42,670
لستُ بعيدة! أبدو كذلك فقط
!لأنّني صغيرة الحجم

331
00:20:42,670 --> 00:20:43,620
!هذا ما يسمّى المنظور

332
00:20:43,620 --> 00:20:47,050
مهلاً، هل كانت هذه الطّاولة
كبيرة جدًّا هكذا دائمًا؟

333
00:20:47,050 --> 00:20:49,850
!إنّها تبدو كذلك فقط لأنّني صغيرة الحجم

334
00:20:49,850 --> 00:20:52,060
.ساعدتنا مينامي هنا أيضًا

335
00:20:52,060 --> 00:20:53,600
!أنت مضخمة يا تاما

336
00:20:52,060 --> 00:20:58,060
جمعت الفتيات من صديقاتها
.وصديقات ميميمي حول تاما-تشان

337
00:20:58,300 --> 00:21:00,470
!علينا قضاء بعض الوقت معًا لاحقًا

338
00:21:00,470 --> 00:21:03,530
تامامًا"... ماذا عن الغد؟"

339
00:21:03,530 --> 00:21:04,930
!أجل

340
00:21:04,080 --> 00:21:06,780
!لا داعي لإقحامي بالقوّة في ذلك

341
00:21:10,900 --> 00:21:12,520
!بصحّتكم

342
00:21:14,030 --> 00:21:15,790
!شكرًا لكم جميعًا

343
00:21:16,040 --> 00:21:18,580
!أبليت حسنًا يا تاما

344
00:21:19,310 --> 00:21:24,090
.واصلي هذا، وستتوقّف مضايقات كونّو قريبًا

345
00:21:24,380 --> 00:21:25,900
أتعتقد ذلك؟

346
00:21:25,900 --> 00:21:30,080
،بمجرّد أن يصبح الفصل في صفّك
سيبدأ النّاس في الغضب من إريكا

347
00:21:30,080 --> 00:21:32,310
.إذا ساء الجوّ العامّ في الفصل

348
00:21:32,850 --> 00:21:35,100
،كما أنّها حسّاسة جدًّا لتلك الأمور

349
00:21:35,100 --> 00:21:37,100
.لذلك فستكفّ عن ذلك

350
00:21:37,900 --> 00:21:39,110
.هكذا إذًا

351
00:21:39,440 --> 00:21:42,660
قالت ميميمي أنّها ستنضمّ إلينا
.بمجرّد انتهاء اجتماع ناديها

352
00:21:42,660 --> 00:21:46,490
ما زالت أوي تملك عملاً في مجلس
.التّلاميذ، لذلك فلن تحضر

353
00:21:46,800 --> 00:21:48,120
ماذا عن فوكا-تشان؟

354
00:21:48,120 --> 00:21:51,020
.يبدو أنّ لديها عملاً اليوم

355
00:21:51,020 --> 00:21:54,000
ماذا؟ لماذا ذكرتم كيكوتشي-سان؟

356
00:21:54,000 --> 00:21:56,870
.سل فوميا. إنّهما صديقان

357
00:21:57,500 --> 00:22:00,670
ماذا؟ هل فتى السّاعد بدأ يكبر أخيرًا؟

358
00:22:00,670 --> 00:22:02,660
!الأمر ليس كذلك

359
00:22:02,660 --> 00:22:04,570
.أنت تحمرّ خجلاً يا توموزاكي

360
00:22:07,680 --> 00:22:09,460
.مرحبًا يا إريكا