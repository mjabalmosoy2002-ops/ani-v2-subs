1
00:01:31,570 --> 00:01:33,230
ما رأيك بهذا؟

2
00:01:33,570 --> 00:01:36,360
أفترض أنّ بإمكاني المساعدة
.في ذلك على الأقل

3
00:01:36,640 --> 00:01:38,190
!ممتاز! أعتمد عليك

4
00:01:41,930 --> 00:01:45,490
لكن أتظنّ أنّ ذلك كافٍ لتحفيز إريكا؟

5
00:01:45,490 --> 00:01:46,380
.لا داعي للقلق

6
00:01:47,380 --> 00:01:49,370
.لديّ أوراق رابحة أخرى

7
00:01:51,520 --> 00:01:52,880
...مفهوم

8
00:01:53,310 --> 00:01:55,430
ما الّذي يجول في بالك؟

9
00:01:55,430 --> 00:01:57,210
.ظننتُ بالفعل أن هنالك ما يجري

10
00:01:57,860 --> 00:02:02,130
.أحيانًا، أتفاجأ من مدى قذارتك يا فوميا

11
00:02:02,130 --> 00:02:03,510
...اخرس

12
00:02:03,750 --> 00:02:04,810
.لكنّي أفهم

13
00:02:05,470 --> 00:02:07,660
عليّ فقط أن أبلغ إريكا بشكل عابر، صحيح؟

14
00:02:07,980 --> 00:02:09,340
.صحيح. شكرًا لك

15
00:02:13,980 --> 00:02:16,530
.ذلك هو كلّ ما وجب القيام به

16
00:02:17,100 --> 00:02:19,700
كلّ ما بقي هو أن تصيب السّهام
الثّلاثة الّتي أطلقت

17
00:02:20,440 --> 00:02:22,870
.أهدافها حسب الخطّة

18
00:02:34,040 --> 00:02:35,550
!هذا هو المتوقّع من إريكا

19
00:02:35,550 --> 00:02:37,550
!مذهل، دورة كاملة

20
00:02:39,320 --> 00:02:40,790
"الكرة اللّيّنة للفتيات"

21
00:02:41,190 --> 00:02:42,800
.نجحت خطّتي

22
00:02:43,990 --> 00:02:46,830
.وأصابت كلّ السّهام أهدافها مباشرة

23
00:02:49,350 --> 00:02:51,430
.تمّت هزيمة الزّعيم الأخير

24
00:02:53,790 --> 00:02:56,310
إيزومي يوزو | المحادثة: أ | الدّراسة: ج"
"الرّياضة: ب | الصّداقة: أ | الجهد: ب

25
00:02:53,800 --> 00:02:55,370
.كان السّهم الأوّل هو إيزومو

26
00:02:56,340 --> 00:03:11,320
"الفصل | مقياس تحفيز كونّو | اليوم/الشّهر"

27
00:02:56,610 --> 00:02:57,930
...مرحبًا يا إريكا

28
00:02:57,930 --> 00:03:01,310
بما أنّي القائدة الآن، فهلاّ ساعدتني؟

29
00:03:01,310 --> 00:03:03,830
لماذا لا نجعل هذا ممتعًا للجميع؟

30
00:03:04,340 --> 00:03:08,400
يبدو أنّ كونّو لا تستطيع رفض
،طلب من أصدقائها

31
00:03:08,400 --> 00:03:11,330
.وها هي ذي صديقتها إيزومي تطلب مساعدتها

32
00:03:11,340 --> 00:03:14,340
هينامي أوي | المحادثة: س | الدّراسة: س"
"الرّياضة: س | الصّداقة: أ | الجهد: س

33
00:03:12,250 --> 00:03:14,340
.والسّهم الثّاني كان هينامي

34
00:03:14,340 --> 00:03:36,360
"اليوم/الشّهر | مقياس تحفيز كونّو | صالة الرّياضة"

35
00:03:15,010 --> 00:03:16,550
ألديك وقت يا ميكا؟

36
00:03:16,550 --> 00:03:17,670
ماذا هنالك؟

37
00:03:18,270 --> 00:03:20,470
ستشارك إريكا في المباراة، صحيح؟

38
00:03:20,470 --> 00:03:22,800
.يُشارك النّاس في العادة

39
00:03:22,800 --> 00:03:24,350
.سؤال وجيه. لا أدري

40
00:03:24,780 --> 00:03:28,410
.لا تبدو لي إريكا ممّن يلعبون الكرة اللّيّنة

41
00:03:28,700 --> 00:03:32,360
إن لم تقرّر المشاركة، أخبريها أنّها
.تستطيع فقط القيام برمية واحدة

42
00:03:32,360 --> 00:03:34,670
!ثمّ اتركي كلّ شيء آخر لي

43
00:03:36,610 --> 00:03:41,870
"اليوم/الشّعر | مقياس تحفيز كونّو | صالة الرّياضة"

44
00:03:37,800 --> 00:03:38,840
!إريكا

45
00:03:38,840 --> 00:03:40,100
...كلام، كلام، ثرثرة، ثرثرة

46
00:03:41,870 --> 00:03:44,870
ميزوساوا تاكاهيرو | المحادثة: س | الدّراسة: أ"
"الرّياضة: أ | الصّداقة: أ | الجهد: د

47
00:03:42,290 --> 00:03:44,870
.والسّهم الثّالث هو ميزوساوا

48
00:03:44,870 --> 00:04:00,760
"اليوم/الشّهر | مقياس تحفيز كونّو | الفصل"

49
00:03:45,450 --> 00:03:46,280
.مرحبًا يا إريكا

50
00:03:46,860 --> 00:03:49,820
.قال شوجي أنّه يتطلّع قدمًا للمنافسات الرّياضيّة

51
00:03:50,530 --> 00:03:52,930
.إنّه شخص رياضيّ كما تعلمين

52
00:03:52,930 --> 00:03:55,630
والفتيات البارعات في الرّياضة؟
.إنّه نوعه المفضّل

53
00:03:56,110 --> 00:03:59,510
.أعتقد أنّ هذا سيكون الأكثر تأثيرًا

54
00:04:00,400 --> 00:04:01,280
...ولكن

55
00:04:01,010 --> 00:04:06,270
"اليوم/الشّهر | مقياس تحفيز كونّو | طريق المنزل"

56
00:04:01,280 --> 00:04:05,220
لا تعرف كونّو أنّ ناكامورا
.وإيزومي يتواعدان بعد

57
00:04:06,610 --> 00:04:09,020
...لكن قد يشتّت هذا الأفكار قليلاً

58
00:04:09,020 --> 00:04:11,020
"الكرة اللّيّنة للفتيات"

59
00:04:17,410 --> 00:04:18,900
!هدفي هو دورة كاملة

60
00:04:24,120 --> 00:04:26,120
"الكرة اللّيّنة للفتيات"

61
00:04:31,190 --> 00:04:33,670
".أريد إسعاد صديقتي إيزومي"

62
00:04:34,570 --> 00:04:36,880
".لا أريد من هينامي أوي أن تنظر لي باحتقار"

63
00:04:37,730 --> 00:04:39,880
".أريد أن يجدني ناكامورا جذّابة"

64
00:04:40,540 --> 00:04:43,220
هذه الرّغبات الثّلاثة يُمكن
تحقيقها جميعًا ببساطة

65
00:04:43,220 --> 00:04:44,960
.بالقيام بأفضل ما لديها في المنافسة الرّياضيّة

66
00:04:45,540 --> 00:04:46,300
...بتعبير آخر

67
00:04:49,500 --> 00:04:53,780
.حصدت كونّو إريكا نتائج كبيرة بجهد قليل

68
00:04:55,630 --> 00:04:56,770
،في تلك الأثناء

69
00:04:56,770 --> 00:04:58,390
،في مباراة كرة السّلّة للفتيان

70
00:04:58,860 --> 00:05:00,900
استطاع كلّ من ناكامورا وميزوساوا

71
00:05:00,900 --> 00:05:03,540
إلى جانب تاتشيبانا من نادي كرة
.السّلّة تحقيق النّصر

72
00:05:05,330 --> 00:05:08,990
في الحقيقة، منحتني هينامي مهمّة
.لأجل مباراة كرة السّلّة أيضًا

73
00:05:09,080 --> 00:05:10,710
"التّسديد القريب من السّلة"

74
00:05:11,090 --> 00:05:12,830
.تسديد رميات قريبة من السّلة

75
00:05:13,460 --> 00:05:15,710
،ابق في مكان يسمح لك بالتّصويب للسّلّة

76
00:05:15,710 --> 00:05:17,710
.ثمّ قم برميتك متى حصلت على الكرة

77
00:05:18,220 --> 00:05:20,340
،إن كان بإمكانك المساهمة في الفوز بذلك

78
00:05:21,030 --> 00:05:23,840
،فستصير من الفتيان الرّياضيّين أيضًا

79
00:05:23,840 --> 00:05:25,490
.مثل تاتشيبانا

80
00:05:26,310 --> 00:05:27,340
...فهمت

81
00:05:28,360 --> 00:05:32,860
وهكذا قضيت أيّامي قبل المنافسة
.بالتّدرّب على الرّميات القريبة

82
00:05:41,790 --> 00:05:44,260
...وكانت هينامي لطيفة كفاية لمساعدتي

83
00:05:46,190 --> 00:05:49,320
.لكنّي الآن أشاهد المباراة من مقاعد الاحتياط

84
00:05:49,970 --> 00:05:54,830
.انتهى بي المطاف أقوم بعدّة أخطاء من البداية

85
00:05:56,640 --> 00:05:57,710
!أنت خارج المباراة

86
00:06:00,340 --> 00:06:02,140
!هذا متوقّع من برين

87
00:06:06,940 --> 00:06:08,510
!انتهت المباراة

88
00:06:08,850 --> 00:06:10,850
"النّصر"

89
00:06:11,500 --> 00:06:12,650
.لا تبالي يا فيوميا

90
00:06:13,150 --> 00:06:14,060
.اخرس

91
00:06:14,060 --> 00:06:17,930
يا فتى السّاعد! من يُطرد في أوّل
ثلاثين ثانية من المباراة؟

92
00:06:17,930 --> 00:06:19,810
.فشلت فشلاً ذريعًا يا فومين

93
00:06:20,070 --> 00:06:22,440
!كان ذلك رائعًا

94
00:06:22,440 --> 00:06:24,780
...تريّث عليّ يا تاتشيبانا

95
00:06:25,870 --> 00:06:27,660
،وفي النّهاية

96
00:06:27,650 --> 00:06:31,180
،احتلّ كِلا الفريقين المركز الأوّل

97
00:06:27,660 --> 00:06:33,910
"تهانينا للفائزين هذه السّنة! 2-2"
"كرة سلّة الفتيان: المركز الأوّل | الكرة اللّيّنة للفتيات: المركز الأوّل"

98
00:06:31,180 --> 00:06:33,580
.وحقّقنا الانتصار لفصلنا هذه السّنة

99
00:06:34,180 --> 00:06:37,880
!نحن الأوائل

100
00:06:39,980 --> 00:06:41,540
!مذهل

101
00:06:41,540 --> 00:06:43,160
!عناق انتصار

102
00:06:42,500 --> 00:06:44,430
.يستمتع الجميع بوقتهم

103
00:06:44,930 --> 00:06:47,680
.وكأنّ الفصل بأكمله صار متّحدًا

104
00:06:48,260 --> 00:06:51,090
.يا لها من نهاية سعيدة

105
00:06:54,540 --> 00:06:58,930
ولكنّي علمتُ بعدها بوقت قريب

106
00:07:01,200 --> 00:07:04,690
.أنّ لعبة الحياة هذه ليست بسيطة هكذا

107
00:07:09,830 --> 00:07:13,250
.بدأ الأمر في اليوم التّالي للمنافسات الرّياضيّة

108
00:07:17,480 --> 00:07:18,280
.يا ويحي

109
00:07:18,280 --> 00:07:19,410
.آسفة

110
00:07:20,000 --> 00:07:20,910
.لا بأس

111
00:07:22,440 --> 00:07:26,420
.استمرّت هذه "الحوادث" الصّغيرة

112
00:07:27,360 --> 00:07:31,930
كانت تصيبُ طائراتٌ ورقيّة هيراباياشي-سان
،عن طريق الخطأ" خلال الاستراحات"

113
00:07:37,390 --> 00:07:42,090
أو قد تصطدم كونّو بطاولتها
."عن طريقة الخطأ"

114
00:07:43,820 --> 00:07:45,530
،ثمّ بعد بضعة أيّام

115
00:07:46,390 --> 00:07:49,260
،أدركت مع بقيّة زملاء الفصل

116
00:07:50,190 --> 00:07:54,230
.أنّه كانت هنالك نيّة غير صافية في ذلك

117
00:07:57,540 --> 00:08:00,000
.أنا من تسبّبت في كلّ ذلك

118
00:08:00,250 --> 00:08:03,850
لأنّ أمر مواعدتك لناكامورا صار معروفًا؟

119
00:08:04,270 --> 00:08:05,370
.على الأرجح

120
00:08:05,370 --> 00:08:09,760
.معاملتي أنا أو شوجي بحدّة سيكون مبرَّرًا

121
00:08:10,300 --> 00:08:12,530
.لكنّها سعت خلف هيراباياشي-سان بدلاً منّا

122
00:08:14,170 --> 00:08:17,180
.على الأرجح أنّه ليس عليّ قول أيّ شيء لإريكا

123
00:08:18,240 --> 00:08:19,900
.ربّما أنت محقّة

124
00:08:23,140 --> 00:08:24,490
.وهذا رأيي أيضًا

125
00:08:25,380 --> 00:08:28,020
.لا يجدر بيوزو قول أيّ شيء لكونّو

126
00:08:28,300 --> 00:08:29,590
أتظنّين ذلك؟

127
00:08:30,160 --> 00:08:32,570
.هذه المضايقات أمر ثانويّ

128
00:08:32,910 --> 00:08:35,300
.بإمكانها القول أنّها مجرّد حوادث لا غير

129
00:08:36,060 --> 00:08:38,330
،إن كنّا لا نريد أن نزيد الطّين بلّة

130
00:08:38,330 --> 00:08:41,400
.فإنّ الخيار الأذكى الآن هو المشاهدة بصمت

131
00:08:41,840 --> 00:08:42,540
...أخبريني

132
00:08:43,330 --> 00:08:45,640
هل الحياة فعلاً لعبة من مستوى إلهيّ؟

133
00:08:46,530 --> 00:08:47,690
ماذا تقصد؟

134
00:08:48,340 --> 00:08:53,670
أعني أنّنا حصلنا على حدث سلبيّ
.غير منطقيّ بدون أيّ سبب وراءه

135
00:08:54,480 --> 00:08:56,050
.هناك أسباب بالطّبع

136
00:08:56,820 --> 00:08:59,640
.تحبّ كونّو إريكا ناكامورا

137
00:09:00,110 --> 00:09:04,740
وبفضل مساعدتنا، بدأت يوزو
.بمواعدة ناكامورا

138
00:09:05,560 --> 00:09:09,270
.شاركت كونّو إريكا، وفاز فصلنا

139
00:09:10,020 --> 00:09:13,040
.أصبحت علاقة يوزو بناكامورا علنيّة

140
00:09:13,830 --> 00:09:16,970
.هيراباياشي-سان فتاة خجولة

141
00:09:17,790 --> 00:09:21,060
.سقطت كلّ هذه الأحداث كأنّها قطع دومينو

142
00:09:21,610 --> 00:09:25,290
،ما يحدث الآن ليس غير منطقيّ
.بل كان أمرًا لا مفرّ منه

143
00:09:25,480 --> 00:09:27,170
ماذا تقصدين بذلك؟

144
00:09:27,480 --> 00:09:31,050
هل تقولين أنّ هيراباياشي-سان
عليها تحمّل ذلك فحسب؟

145
00:09:31,530 --> 00:09:32,800
.نوعًا ما

146
00:09:33,080 --> 00:09:34,140
.هينامي

147
00:09:35,020 --> 00:09:39,430
إضافة لذلك، لا أرى حاجة للمساعدة
.في هذه المرحلة

148
00:09:40,920 --> 00:09:45,790
ما أعنيه هو أنّ مثل هذه المضايقات
.يُمكن للمرء حلّها بنفسه

149
00:09:46,140 --> 00:09:49,440
...ولأنّ هيراباياشي-سان لا تنوي ذلك

150
00:09:49,870 --> 00:09:51,820
!مهلاً، تماديت كثيرًا

151
00:09:52,090 --> 00:09:57,460
لم نرَ أيّ شيء يفيد بأنّ هيراباياشي-سان
.تريد حلّ هذه المشكلة وحدها

152
00:09:58,190 --> 00:10:02,830
ألا يجعل ذلك بحدّ ذاته هيراباياشي-سان
!سببًا آخر لتصرّفات كونّو هذه؟

153
00:10:03,130 --> 00:10:05,830
تُحمّلين المسؤوليّة لهيراباياشي-سان؟

154
00:10:06,040 --> 00:10:09,450
.وسائل كونّو إريكا جبانة وفظيعة بلا أدنى شكّ

155
00:10:09,450 --> 00:10:10,840
.كونّو هي المخطئة هنا

156
00:10:10,840 --> 00:10:12,420
.لا شكّ في ذلك

157
00:10:13,150 --> 00:10:17,400
،لكنّ اللاّعب هو من يمسك جهاز التّحكّم

158
00:10:17,400 --> 00:10:19,690
.ويُخلي الطّريق في هذا الوضع

159
00:10:19,690 --> 00:10:21,350
،ينطبق نفس الشّيء في الحياة
أليس كذلك؟

160
00:10:21,350 --> 00:10:23,940
!ربّما هذا صحيح بالنّسبة لك ولي

161
00:10:23,940 --> 00:10:26,170
...لكن أن نطلب من الجميع أن يكونوا لاعبين

162
00:10:26,170 --> 00:10:28,780
إن حاول شخص ما تغيير شيء ما بنفسه

163
00:10:28,780 --> 00:10:31,100
وانتهى به المطاف غير قادر
،على حلّ المشكلة

164
00:10:31,100 --> 00:10:33,560
.فسأساعد أنا بكلّ سرور

165
00:10:34,190 --> 00:10:38,530
ولكن إن لم يحاول من الأساس
...إصلاح الأمور بنفسه

166
00:10:39,230 --> 00:10:40,780
.فلستُ مطالَبة بالمساعدة

167
00:10:41,290 --> 00:10:42,910
.لا أفكّر بنفس الطّريقة

168
00:10:43,350 --> 00:10:45,910
.أعتقد أنّ الحقّ مع اللاّعب

169
00:10:46,500 --> 00:10:50,250
وفي الوقت الحاليّ، لا تحاول
.هيراباياشي-سان أن تكون لاعبة

170
00:10:50,700 --> 00:10:53,540
أعني أنّي أنوي بالفعل القيام بشيء ما

171
00:10:53,880 --> 00:10:55,650
.إن ساءت الأمور أكثر

172
00:10:56,570 --> 00:10:57,490
...هكذا إذًا

173
00:10:58,590 --> 00:11:04,050
أخبرني، لا تفكّر في القيام بشيء
ما حيال هذا، صحيح؟

174
00:11:04,520 --> 00:11:07,060
.إن كان هناك أمر أستطيع القيام به، فسأفعله

175
00:11:07,500 --> 00:11:08,280
.هكذا إذًا

176
00:11:08,700 --> 00:11:13,020
.سنواصل بحذر، كي لا تسوء الأمور

177
00:11:14,480 --> 00:11:16,620
.يمكنك الاستمرار بدون مهمّة لبعض الوقت

178
00:11:16,910 --> 00:11:17,960
.مفهوم

179
00:11:23,890 --> 00:11:25,020
وأنا قلت ما هذا؟

180
00:11:25,020 --> 00:11:25,930
.معك حقّ

181
00:11:25,930 --> 00:11:26,740
فعلاً؟

182
00:11:26,740 --> 00:11:28,700
!ذلك ما قاله

183
00:11:28,910 --> 00:11:30,210
!كم هذا مضحك

184
00:11:30,970 --> 00:11:32,240
!كنت سعيدة جدًّا

185
00:11:32,980 --> 00:11:33,760
!كونّو

186
00:11:35,680 --> 00:11:37,100
إلى متى ستواصلين هذا؟

187
00:11:37,100 --> 00:11:39,990
!يكفي من هذا الهراء! توقّفي فحسب

188
00:11:43,660 --> 00:11:44,970
إلى متى ستواصلين هذا؟

189
00:11:46,010 --> 00:11:48,850
!يكفي من هذا الهراء! توقّفي فحسب

190
00:11:49,180 --> 00:11:51,230
ماذا؟ عمّ تتحدّثين؟

191
00:11:51,490 --> 00:11:53,110
!لا تتظاهري أنّك لا تعرفين

192
00:11:53,110 --> 00:11:56,470
،فقط لأنّ ناكامورا يواعد أخرى
!لا يسمح ذلك لك بمضايقة الآخرين

193
00:11:57,950 --> 00:11:58,990
...فعلاً

194
00:12:10,690 --> 00:12:11,810
!هانابي

195
00:12:11,810 --> 00:12:14,120
.أنت بخير؟ إنّك ترتعشين

196
00:12:15,130 --> 00:12:16,000
!اخرسي

197
00:12:16,690 --> 00:12:18,790
...هذا مؤلم

198
00:12:20,060 --> 00:12:21,970
—لم أقصد ضربك بشدّة

199
00:12:22,740 --> 00:12:24,800
.أنت من بدأت

200
00:12:28,810 --> 00:12:30,240
...كلاّ

201
00:12:42,220 --> 00:12:44,200
.أنا آسفة

202
00:12:48,740 --> 00:12:52,100
.وها قد صار الأمر علنًا وواضحًا للجميع

203
00:12:52,100 --> 00:12:53,890
،نوايا كونّو إريكا السّيّئة

204
00:12:54,810 --> 00:12:57,570
.صارت موجّهة صوب تاما-تشان

205
00:12:59,130 --> 00:13:01,590
!كونّو! فعلت ذلك عن قصد

206
00:13:01,820 --> 00:13:04,590
.ماذا؟ كفاك من الافتراضات رجاءً

207
00:13:04,590 --> 00:13:06,050
!ليست مجرّد افتراضات

208
00:13:06,310 --> 00:13:08,050
ألم أعتذر لك؟

209
00:13:08,050 --> 00:13:10,680
!تعلمين أنّ تلك ليست المشكلة

210
00:13:10,910 --> 00:13:13,020
ماذا؟ هل ستضربيني ثانية؟

211
00:13:14,440 --> 00:13:16,650
.أنا لا أحبّ العنف

212
00:13:17,350 --> 00:13:19,940
!أنا لا أستعمل العنف

213
00:13:25,700 --> 00:13:27,340
.أنت على صواب يا تاما

214
00:13:28,150 --> 00:13:29,950
أأنت بخير يا تاما-تشان؟

215
00:13:30,170 --> 00:13:31,310
.أنا بخير

216
00:13:31,310 --> 00:13:32,150
...هانابي

217
00:13:33,160 --> 00:13:34,240
.لا بأس

218
00:13:35,310 --> 00:13:36,980
.سأقوم بشيء ما حيال هذا

219
00:13:38,530 --> 00:13:39,510
أوي؟

220
00:13:41,430 --> 00:13:44,500
.استمرّت هجمات كونّو

221
00:13:45,000 --> 00:13:48,220
كانت تصطدم بطاولة تاما-تشان
،"عن طريق الخطأ"

222
00:13:48,580 --> 00:13:52,980
أو قد تُسقط إحدى فتيات مجموعتها
،"كرسيّ تاما-تشان "عن طرق الخطأ

223
00:13:53,980 --> 00:13:57,890
وكانت كلّ أقلام رصاص تاما-تشان
،"تُكسر "عن طريق الخطأ

224
00:13:58,940 --> 00:14:03,280
أو قد تتحدّث مجموعة كونّو بالسّوء
"عنها بصوت عالٍ "عن طريق الخطأ

225
00:14:03,280 --> 00:14:05,110
.بما يكفي لتسمعهنّ تاما-تشان

226
00:14:06,090 --> 00:14:08,710
لكنّ الأمر لا يشبه ما حدث
...مع هيراباياشي-سان

227
00:14:09,280 --> 00:14:11,520
!كونّو! أعلم أنّك ركلت طاولتي عن قصد

228
00:14:12,090 --> 00:14:16,350
،في كلّ مرّة تضايق فيها كونّو تاما-تشان
.لا تظلّ هذه الأخيرة صامتة

229
00:14:16,850 --> 00:14:19,710
ماذا؟ هلاّ توقّفت عن هذه الاتّهامات الباطلة؟

230
00:14:19,710 --> 00:14:21,090
!فعلت ذلك البارحة أيضًا

231
00:14:21,340 --> 00:14:25,840
هل نسيت تلك المرّة
الّتي استعملت العنف ضدّي؟

232
00:14:26,780 --> 00:14:28,340
!كان ذلك عن طريق الخطأ

233
00:14:28,340 --> 00:14:31,600
.ماذا؟ ما فعلتُه أنا كان عن طريق الخطأ

234
00:14:31,600 --> 00:14:34,010
أمّا ما فعلت أنت؟

235
00:14:34,450 --> 00:14:36,600
.فكان مقصودًا

236
00:14:38,780 --> 00:14:41,040
!توقّفي يا تاما! تريّثي

237
00:14:41,040 --> 00:14:43,670
.يكفي يا هانابي، اهدئي

238
00:14:45,670 --> 00:14:50,070
هينامي وميميمي كانتا يهدّئانها
.كي لا تغضب أكثر من ذلك

239
00:14:50,550 --> 00:14:53,830
.استمرّ هذا لعدّة أيّام

240
00:14:54,110 --> 00:14:56,540
...تعاني هانابي-تشان وقتًا عصيبًا

241
00:14:56,890 --> 00:14:58,390
.بالفعل

242
00:14:58,390 --> 00:15:00,720
...في البداية هيراباياشي-سان، والآن هانابي-تشان

243
00:15:00,720 --> 00:15:03,000
.وكأنّها لا تهتمّ من الّذي تضايقه

244
00:15:03,000 --> 00:15:04,160
.صحيح

245
00:15:04,160 --> 00:15:06,340
...فاجأتني ناتسوباياشي تلك

246
00:15:06,620 --> 00:15:10,340
لم أتوقّع أبدًا أن تواصل
.مقاومتها لكونّو هكذا

247
00:15:10,780 --> 00:15:13,040
.إنّها جريئة أكثر ممّا يبدو عليها بكلّ تأكيد

248
00:15:13,690 --> 00:15:14,740
...ومع ذلك

249
00:15:14,740 --> 00:15:18,290
،قد تكون كونّو-سان فظيعة
.لكنّ ناتسوباياشي-سان تغضب كثيرًا

250
00:15:19,040 --> 00:15:22,050
!لا أقصد أنّ ناتسوباياشي-سان مخطئة

251
00:15:22,500 --> 00:15:25,480
.لكن... أتمنّى لم تتعاملا مع الأمر بشكل أفضل

252
00:15:25,950 --> 00:15:28,940
.لا يريد أحد رؤية ذلك كلّ يوم

253
00:15:29,630 --> 00:15:31,470
منذ متى وهذا يحصل حتّى الآن؟

254
00:15:31,470 --> 00:15:34,870
لماذا ما زالت ناتسوباياشي تغضب؟

255
00:15:35,160 --> 00:15:37,250
أفهم أنّ كونّو فظيعة، ولكن ألا تفهم

256
00:15:37,250 --> 00:15:41,170
أنّ كلّ شجارات الفصل هذه
تفسد مزاج الفصل بأكمله؟

257
00:15:41,500 --> 00:15:45,500
لا تعرف ناتسوباياشي كيف تقرأ
.الجوّ العام من الأساس

258
00:15:46,590 --> 00:15:50,010
.في نهاية المطاف، صار مزاج الفصل سيّئًا تمامًا

259
00:15:50,410 --> 00:15:52,760
.كانت هينامي من وضعت حدًّا للأمر

260
00:15:53,390 --> 00:15:58,170
أثارت تعاطف الفصل تجاه تاما-تشان
.باستهداف فتيات المستوى المتوسّط

261
00:15:58,680 --> 00:16:01,520
حاولت ميميمي التّواجد مع تاما-تشان

262
00:16:01,520 --> 00:16:03,320
.قد الإمكان في كلّ استراحة

263
00:16:04,180 --> 00:16:07,500
دفعت تاما-تشان للخروج من الفصل
.وتفادي مواجهات مع كونّو

264
00:16:08,380 --> 00:16:10,310
ومجهودات هاتين الفتاتين

265
00:16:10,650 --> 00:16:14,730
.منعت شيئًا ضخمًا جدًّا من الحدوث

266
00:16:15,910 --> 00:16:17,910
"غرفة الخياطة 2"

267
00:16:17,040 --> 00:16:17,910
...مسألة تاما-تشان

268
00:16:18,280 --> 00:16:20,050
صار طعمها سيّئًا، صحيح؟

269
00:16:20,650 --> 00:16:21,540
...نعم

270
00:16:22,140 --> 00:16:24,630
،أنت وميميمي تساعدانها حاليًّا

271
00:16:25,060 --> 00:16:28,050
،ولكن على هذا المعدّل
.ستصير منعزلة أكثر فأكثر

272
00:16:28,780 --> 00:16:31,090
.صحيح. لا يجب أن يستمرّ هذا

273
00:16:31,440 --> 00:16:32,630
.علينا فعل شيء ما

274
00:16:33,360 --> 00:16:37,680
في الآونة الأخيرة، شعرت أنّ هينامي
.لم تكن تفعل الأشياء بطريقتها المعتادة

275
00:16:38,120 --> 00:16:39,870
،إنّ أساليبها ليست خاطئة

276
00:16:40,350 --> 00:16:43,600
.لكنّها لم تكن على طبيعتها فحسب

277
00:16:44,390 --> 00:16:45,810
...أخبريني يا هينامي

278
00:16:46,210 --> 00:16:46,890
ماذا؟

279
00:16:47,540 --> 00:16:52,030
.أعتقد أنّ مساعدة تاما-تشان هو الأهمّ الآن

280
00:16:52,030 --> 00:16:53,570
.أهمّ من أيّ شيء آخر

281
00:16:54,290 --> 00:16:55,780
وبعد؟

282
00:16:56,360 --> 00:17:03,960
ربّما يمكننا أن نطلب منها أن تكفّ
...عن تصعيد الأمور مع كونّو أو

283
00:17:03,960 --> 00:17:05,330
.قطعًا لا

284
00:17:06,380 --> 00:17:07,920
.الحقّ مع هانابي

285
00:17:08,300 --> 00:17:09,950
.الوضع هو الخاطئ

286
00:17:10,610 --> 00:17:12,760
.لا تحتاج هانابي لتتغيّر

287
00:17:14,720 --> 00:17:17,970
"اقتراح جيّد | معيار سيّئ"

288
00:17:15,260 --> 00:17:19,600
وكان هذا عكس ما أصرّت
.عليه هينامي حتّى الآن

289
00:17:20,570 --> 00:17:25,230
،إن كان الوضع خاطئًا
.فعلينا القتال بطريقة تناسبه

290
00:17:25,870 --> 00:17:28,730
.حتّى إن عنى ذلك تشويه أنفسنا ظاهريًّا

291
00:17:30,830 --> 00:17:35,450
تلك هي سياستها، الطّريقة الّتي حصلت بها
.على كلّ تلك الانتصارات... أو ذلك ما كانت

292
00:17:38,990 --> 00:17:43,870
بعد الفصل، طلبت منّي ميميمي الانضمام
.لها وتاما-تشان في طريق العودة إلى المنزل

293
00:17:44,230 --> 00:17:47,370
.تأخّرت هينامي بسبب عمل في مجلس التّلاميذ

294
00:17:47,720 --> 00:17:49,880
!هناك قشدة على وجهك يا تاما

295
00:17:49,880 --> 00:17:51,350
ماذا؟ فعلاً؟

296
00:17:53,020 --> 00:17:54,330
!وقت الأكل

297
00:17:54,800 --> 00:17:56,520
!ماذا؟ لماذا أكلتها؟

298
00:17:56,520 --> 00:17:58,550
!لذيذة

299
00:17:58,550 --> 00:18:00,640
.إنّ هذا لا يروق لها يا ميميمي

300
00:18:00,640 --> 00:18:03,090
ماذا؟ أهذا صحيح؟

301
00:18:03,090 --> 00:18:05,640
بالطّبع! أليس الأمر واضحًا؟

302
00:18:05,640 --> 00:18:07,870
!يا لها من صدمة

303
00:18:16,900 --> 00:18:19,970
كيف وصلت الأمور إلى هذا الحدّ؟

304
00:18:23,770 --> 00:18:26,550
.لم ترتكب تاما أيّ خطأ

305
00:18:26,550 --> 00:18:28,790
...ويراها الجميع على أنّها على خطأ

306
00:18:29,210 --> 00:18:31,580
!كم أكره مشاهدة ذلك

307
00:18:35,430 --> 00:18:37,050
.أخبرني يا توموزاكي

308
00:18:38,040 --> 00:18:40,290
هل أبلي حسنًا؟

309
00:18:41,060 --> 00:18:43,060
بشأن محاولة إبهاجها؟

310
00:18:43,950 --> 00:18:44,840
.نعم

311
00:18:45,760 --> 00:18:47,750
.أظنّك تبلين حسنًا بالفعل

312
00:18:49,190 --> 00:18:51,190
"توموزاكي"

313
00:18:51,470 --> 00:18:55,190
في هذه المرحلة، لا بدّ أنّ هدف ميميمي

314
00:18:57,200 --> 00:19:00,650
.هو أن تستسلم كونّو إريكا لمقاومة تاما-تشان

315
00:18:57,820 --> 00:18:58,450
"!ناتسوباياشي هانابي تقاوم"

316
00:18:58,450 --> 00:18:58,830
"تكبّدت كونّو إريكا 0 ضرر"

317
00:18:58,830 --> 00:18:59,410
"!كونّو إريكا: أنا ضدّ العنف"

318
00:18:59,410 --> 00:19:00,410
"!!تكبّدت ناتسوباياشي هانابي 170 ضررًا"

319
00:19:01,950 --> 00:19:02,950
"!!~~نانامي مينامي: تاما"

320
00:19:02,950 --> 00:19:03,830
"♪ نانامي مينامي: ميميمي هنا"

321
00:19:03,470 --> 00:19:06,600
إن توقّفت مضايقات كونّو

322
00:19:03,830 --> 00:19:05,210
"!نانامي مينامي: هل أنت بخير يا تاما؟"

323
00:19:05,210 --> 00:19:06,960
"♪نانامي مينامي: كلّ شيء على ما يرام"

324
00:19:06,600 --> 00:19:08,600
،بينما تعتني ميميمي بتاما-تشان

325
00:19:07,960 --> 00:19:08,960
"(كونّو إريكا: (ليس مضحكًا"

326
00:19:08,960 --> 00:19:09,960
"(كونّو إريكا: (انسوا الأمر"

327
00:19:09,960 --> 00:19:13,210
"...غادرت كونّو إريكا"

328
00:19:11,250 --> 00:19:13,210
.فسنحصل على نهاية جيّدة

329
00:19:15,010 --> 00:19:18,750
كانت هينامي تتحكّم
،بالجوّ العامّ للفصل بأكمله

330
00:19:15,470 --> 00:19:15,970
"تتلاعب كونّو إريكا بالجوّ العامّ"

331
00:19:15,970 --> 00:19:16,470
"!معيار جيّد/سيّئ"

332
00:19:16,470 --> 00:19:16,970
"!!تكبّدت ناتسوباياشي هانابي 170 ضررًا"

333
00:19:16,970 --> 00:19:17,470
"...هينامي أوي: هانابي"

334
00:19:17,470 --> 00:19:18,970
"...هينامي أوي: سأجد حلاًّ"

335
00:19:18,750 --> 00:19:20,170
.وتوفّر وقتًا أكثر

336
00:19:18,970 --> 00:19:20,970
"تتلاعب هينامي أوي بالجوّ العامّ"

337
00:19:20,920 --> 00:19:22,670
،إن سار كلّ شيء على خير

338
00:19:20,970 --> 00:19:21,970
"انعكس معيار جيّد/سيّئ"

339
00:19:21,970 --> 00:19:23,220
"!!تكبّد زملاء فصل×6 300 ضرر"

340
00:19:23,140 --> 00:19:27,190
،فإنّ الجوّ العامّ، معيار الجيّد أو السّيّئ
،سينقلب رأسًا على عقب

341
00:19:23,220 --> 00:19:24,230
"!!تكبّدت كونّو إريكا 100 ضرر"

342
00:19:25,100 --> 00:19:27,980
"!!انضمّ زملاء فصل×6 للمجموعة"

343
00:19:27,190 --> 00:19:30,550
.وستبدأ باعتبار كونّو كواحدة من السّيّئات

344
00:19:28,980 --> 00:19:30,230
"(كونّو إريكا: (ليس مضحكًا"

345
00:19:30,230 --> 00:19:31,400
"(كونّو إريكا: (انسوا الأمر"

346
00:19:31,400 --> 00:19:33,230
"...غادرت كونّو إريكا"

347
00:19:32,370 --> 00:19:35,130
.لكن لديّ استراتيجيّة مختلفة

348
00:19:33,990 --> 00:19:35,480
"كونّو إريكا | ناتسوباياشي هانابي | توموزاكي فوميا"

349
00:19:35,490 --> 00:19:40,990
"تحدّق كونّو إريكا بثبات"

350
00:19:35,870 --> 00:19:37,540
ما نحتاج لاستهدافه الآن

351
00:19:37,540 --> 00:19:41,160
.هو تجاوز هذا دون أن تتأذّى تاما-تشان

352
00:19:41,650 --> 00:19:45,160
وللقيام بذلك، بإمكاننا استعمال
.خطّة يعرفها كلّ لاعب

353
00:19:41,740 --> 00:19:46,750
"(...توموزاكي فوميا: (يفكّر"

354
00:19:45,810 --> 00:19:47,710
.الهروب

355
00:19:46,750 --> 00:19:47,750
"!توموزاكي فوميا: تاما-تشان! لنهرب"

356
00:19:47,750 --> 00:19:49,630
"!! :تاما"

357
00:19:48,190 --> 00:19:51,250
خيار أخذ استراحة من المدرسة
.حتّى يهدأ كلّ شيء

358
00:19:49,630 --> 00:19:51,250
"هروب ناجح"

359
00:19:52,040 --> 00:19:53,890
،صحيح أنّه سيكون له أثر عكسيّ

360
00:19:54,450 --> 00:19:58,760
،لكنّه سيوصلنا إلى الهدف
.مهما بدا "خاطئًا" أو قذرًا

361
00:19:59,330 --> 00:20:02,470
.قد لا تستطيع "لا اسم" ذلك، لكنّي أستطيع

362
00:20:02,780 --> 00:20:04,570
.هذه هي طريقة ناناشي

363
00:20:07,890 --> 00:20:10,020
"غرفة سمعيّات وبصريّات قديمة"

364
00:20:10,140 --> 00:20:12,180
ماذا أردت؟

365
00:20:12,550 --> 00:20:13,770
...عفوًا

366
00:20:14,020 --> 00:20:17,520
...مسألة كونّو إريكا والجميع هذه

367
00:20:19,300 --> 00:20:22,050
...لقد أخبرتني أوي مرّة

368
00:20:22,050 --> 00:20:24,990
.أنّك تشبهني قليلاً

369
00:20:25,500 --> 00:20:28,130
.إنّك تقول ما الّذي تفكّر به مباشرة

370
00:20:28,130 --> 00:20:30,000
.نعم... ربّما ذلك صحيح

371
00:20:30,320 --> 00:20:33,190
ما مسألة كونّو والجميع هذه؟

372
00:20:33,430 --> 00:20:34,250
.صحيح

373
00:20:34,910 --> 00:20:40,560
لا بدّ أنّك تواجهين صعوبة بسبب
.مضايقات كونّو لك وتجنّب الجميع لك

374
00:20:41,020 --> 00:20:45,140
وإن كان الأمر كذلك، أتساءل إن كان
.من الأفضل أن تبتعدي عن الوضع

375
00:20:48,890 --> 00:20:50,140
.إنّه صعب بالفعل

376
00:20:51,580 --> 00:20:52,530
...ولكن

377
00:20:53,650 --> 00:20:55,320
.أنا بخير

378
00:20:56,350 --> 00:21:00,400
.عندما أذكّر نفسي أنّي على صواب، أكون بخير

379
00:21:01,410 --> 00:21:05,700
.إنّ كسر هانابي الّتي تؤمن بالأمور سيكون أسوأ

380
00:21:07,020 --> 00:21:09,780
.مفهوم. أظنّك ستكونين بخير إذًا

381
00:21:10,400 --> 00:21:14,080
.كنتُ ألعب ألعابًا وحدي طوال هذا الوقت

382
00:21:14,240 --> 00:21:16,460
.وكنت أفكّر طوال ذلك الوقت

383
00:21:16,940 --> 00:21:20,770
الصّواب الّذي بداخلي أهمّ
.من كيف يراني النّاس

384
00:21:21,990 --> 00:21:25,340
،نعم. ما دمت أستطيع أن أكون أنا

385
00:21:25,340 --> 00:21:27,030
.فبإمكاني تحمّل أيّ شيء

386
00:21:28,310 --> 00:21:29,810
أتعلم يا توموزاكي...؟

387
00:21:30,760 --> 00:21:32,830
.مينمي حزينة جدًّا

388
00:21:34,160 --> 00:21:36,880
.ولذلك السّبب أريد أن أتغيّر

389
00:21:38,350 --> 00:21:41,380
.أعتقد أنّي أشبهك بالفعل

390
00:21:41,810 --> 00:21:45,650
،أقول ما يدور في بالي فحسب
.ولا أعرف كيف أتنازل للانسجام

391
00:21:46,000 --> 00:21:48,940
.في الحقيقة، أعتقد أنّك تغيّرت كثيرًا مؤخّرًا

392
00:21:48,940 --> 00:21:52,150
إنّك تجيد قراءة الجوّ العامّ
.أفضل، وتنسجم أفضل

393
00:21:52,150 --> 00:21:56,340
أنت تشبهني، لكنّك تتحدّى نفسك
.بنقاط ضعفك

394
00:21:56,340 --> 00:21:58,960
.لم أعتقد أنّ ذلك ممكنًا

395
00:22:01,190 --> 00:22:03,420
.لذلك أرني كيف تقوم بذلك

396
00:22:06,420 --> 00:22:09,510
.علّمني كيف أقاتل مثلك