1
00:00:08,600 --> 00:00:11,200
اسمي ساتاكي هيروفومي

2
00:00:11,660 --> 00:00:13,930
...أنا رجل عاديّ جدّاً

3
00:00:15,040 --> 00:00:16,830
...عاديّ جدّاً

4
00:00:17,420 --> 00:00:20,920
التقى مع شخص كان من المُفترَض أنّني قتلتُه

5
00:00:22,840 --> 00:00:25,100
هيروفومي؟

6
00:00:25,100 --> 00:00:28,100
...تـ-تشي

7
00:00:30,980 --> 00:00:32,380
!نيغيشي-سانا

8
00:00:32,380 --> 00:00:33,950
!تـ-تشي

9
00:02:08,080 --> 00:02:09,850
هذه تشي، صحيح؟

10
00:02:10,900 --> 00:02:12,000
لكن لماذا؟

11
00:02:12,550 --> 00:02:14,240
ظننتُ نفسي قد قتلتُها

12
00:02:15,580 --> 00:02:17,590
لهذا تمّ إعدامي

13
00:02:19,500 --> 00:02:21,240
لستُ أفهم

14
00:02:21,240 --> 00:02:24,030
رأسي سينفجر

15
00:02:25,520 --> 00:02:27,760
لكن لا أبالي

16
00:02:28,730 --> 00:02:30,060
تشي على قيد الحياة

17
00:02:30,590 --> 00:02:31,690
يسرّني هذا

18
00:02:32,090 --> 00:02:33,270
...يسرّني هذا

19
00:02:33,570 --> 00:02:38,070
التقيتُ بنيغيشي-سان في أريزونا، أمريكا

20
00:02:38,070 --> 00:02:39,260
أريزونا؟

21
00:02:39,260 --> 00:02:44,490
في مُنحنى حدوة الفرَس، بالقرب
من الحديقة الوطنيّة للوادي العظيم

22
00:02:51,700 --> 00:02:58,670
حيث يتعرّج النّهر وينشئ شكلَ حدوة
فرَس، ومن هنا جاء الاسم

23
00:03:00,040 --> 00:03:01,690
!مذهل

24
00:03:01,690 --> 00:03:04,770
تبدو كحدوة فرَس بالفعل

25
00:03:04,770 --> 00:03:08,360
!من سمّى هذا المكان شديد المُلاحظة

26
00:03:08,360 --> 00:03:09,570
،على أيّ حال

27
00:03:09,840 --> 00:03:12,720
أتفهّم أنّ هذا لحفظ المنظر
،والحفاظ على البيئة الطبيعيّة

28
00:03:12,720 --> 00:03:14,890
لكن هذا مُخيف بلا سور

29
00:03:15,200 --> 00:03:19,040
...كّراتي الذهبيّة تشدّ على بعضها كلّما نظرتُ للأسفل

30
00:03:28,610 --> 00:03:29,850
!ماذا تفعلين بالضبط؟

31
00:03:30,430 --> 00:03:32,860
!دعني! دعني وشأني

32
00:03:32,860 --> 00:03:33,860
!أيّتها الحمقاء

33
00:03:33,860 --> 00:03:36,550
كيف تجرئين على تلويث هذه الأرض المُبهرة

34
00:03:36,550 --> 00:03:39,160
!بسبب عاطفة سخيفة لكائن بشريّ أنانيّ؟

35
00:03:39,160 --> 00:03:41,310
هل قلت "سخيفة"؟

36
00:03:42,310 --> 00:03:43,910
!تراجع

37
00:03:45,680 --> 00:03:47,970
!أ-أنا آسفة جدّاً

38
00:03:47,970 --> 00:03:49,600
ما الّذي فعلتُه؟

39
00:03:51,700 --> 00:03:55,840
!سوف أسقط

40
00:03:56,800 --> 00:04:00,930
أخبرَتْني بأنّها فقدت شخصاً مهمّاً

41
00:04:03,160 --> 00:04:04,700
...شخص مهمّ

42
00:04:08,850 --> 00:04:09,630
كيتو-سان؟

43
00:04:10,500 --> 00:04:12,390
تذكّرتُ للتو أنّ هناك أمور عليّ فعلها

44
00:04:12,390 --> 00:04:13,860
أستأذن

45
00:04:17,420 --> 00:04:21,200
حاليّاً، سأدعهما بمفردهما

46
00:04:21,770 --> 00:04:23,000
،والأهمّ

47
00:04:23,000 --> 00:04:28,990
!مهمّتي هي أكل كفايتي من الطعام الغريب لهذا البلد

48
00:04:30,550 --> 00:04:34,200
!شكراً على فنزويلا

49
00:04:36,950 --> 00:04:38,560
من هنا رجاء

50
00:04:39,200 --> 00:04:41,170
شكراً لك

51
00:04:43,620 --> 00:04:46,880
سمعتُ بأنّك أنزلت العقوبة

52
00:04:47,600 --> 00:04:50,500
على الشّياطين الّذين فرّوا من قبضة العدالة

53
00:04:50,630 --> 00:04:51,570
هذا صحيح

54
00:04:51,570 --> 00:04:58,340
لكن أودّ سماع روايتكِ قبل أن أقرّر
ما إن كان عليّ أن أستلم قضيّتكِ

55
00:04:59,130 --> 00:05:03,080
هذا هو الرّجل الّذي قتلَ ابني

56
00:05:04,100 --> 00:05:05,850
...ساتاكي هيروفومي

57
00:05:06,880 --> 00:05:11,840
هذا الرّجل المسؤول عن حادثة ساتاكي؟

58
00:05:13,460 --> 00:05:15,270
حادثة ساتاكي

59
00:05:15,710 --> 00:05:19,370
ساتاكي هيروفومي، رجل عَمِلَ
،لشركة تجاريّة في طوكيو

60
00:05:19,890 --> 00:05:22,050
،طعنَ خطيبتَه، نيغيشي تشي

61
00:05:22,050 --> 00:05:26,120
وصديقها، كامباياشي أوسامو، في منزله

62
00:05:27,000 --> 00:05:28,830
!فلتموتا

63
00:05:31,240 --> 00:05:34,120
كان دافعه هو الغيرة، مُفترضاً بأنّ

64
00:05:34,120 --> 00:05:37,480
خطيبته كانت تقيم علاقة مع كامباياشي

65
00:05:37,980 --> 00:05:41,360
،طعنهما ساتاكي مراراً

66
00:05:41,360 --> 00:05:45,790
صبَّ وقوداً على جثّتيهما ثمّ أشعلهما وهرب

67
00:05:46,460 --> 00:05:48,960
،لكن سرعان ما قبضت عليه الشّرطة

68
00:05:50,240 --> 00:05:52,200
وحُكِمَ عليه بالإعدام

69
00:05:55,080 --> 00:05:59,040
كما تعلمين، كان ساتاكي نزيل حكم بالإعدام

70
00:05:59,040 --> 00:06:04,000
وتمّ تنفيذ حكمه بالفعل

71
00:06:04,370 --> 00:06:07,710
...أتفهّم ألمكِ، لكن

72
00:06:08,340 --> 00:06:10,380
ساتاكي على قيد الحياة

73
00:06:12,190 --> 00:06:14,910
ما زال ذلك الرّجل على قيد الحياة

74
00:06:23,200 --> 00:06:26,080
أوسامو، تمّ الأمر

75
00:06:26,720 --> 00:06:28,700
هل سنستمرّ في التكتّم على هذا الأمر؟

76
00:06:29,140 --> 00:06:30,990
ليس هذا بيت القصيد

77
00:06:30,990 --> 00:06:34,470
لكن كأنّنا نكذب على العامّة

78
00:06:34,960 --> 00:06:36,920
ما زال ساتاكي على قيد الحياة

79
00:06:36,920 --> 00:06:40,160
!شيمودا! انتبه ألّا يسمعك أحد

80
00:06:40,160 --> 00:06:41,440
...أ-أنا آسف

81
00:06:44,750 --> 00:06:48,640
بصراحة، لم أكن أدري ما إن كان
ينبغي أن أصدّق ذلك

82
00:06:48,640 --> 00:06:51,590
ظننتُ بأنّني أخطأتُ السّمع أو
ربّما كانت مزحة سيّئة

83
00:06:51,920 --> 00:06:52,990
...لكن

84
00:06:53,720 --> 00:06:55,160
...هذه المقالة

85
00:06:55,560 --> 00:06:57,700
شيمودا تاداشي

86
00:06:57,700 --> 00:07:00,720
،إنّه حارس سجن سابق كان مسؤولاً عن ساتاكي

87
00:07:00,720 --> 00:07:03,970
وهو الرّجل الّذي قال بأنّ ساتاكي لم يكن ميّتاً

88
00:07:04,440 --> 00:07:10,740
عندما قرأتُ هذه المقالة، عرفتُ أنّ
ما قاله شيمودا كان صحيحاً

89
00:07:11,590 --> 00:07:16,110
أعي بأنّ هذا قد لا يكون مُقنِعاً بحدّ ذاته

90
00:07:16,640 --> 00:07:21,780
!لكن قُتِلَ ابني بشكل شنيع

91
00:07:22,790 --> 00:07:29,500
إذا كان قاتله لا يزال حيّاً، فلا بدّ
أن يتجرّع من نفس الكأس

92
00:07:29,500 --> 00:07:33,940
!لا، بل حتّى من كأس أكثر مرارة ممّا تجرّعه ابني

93
00:07:33,940 --> 00:07:37,400
!لا أقبل بأقلّ من ذلك

94
00:07:37,400 --> 00:07:38,960
!أرجوك

95
00:07:38,960 --> 00:07:43,840
إذا هربَ الشّخص الّذي أزهق روح
،ابني من قانون الدّولة

96
00:07:43,840 --> 00:07:48,000
!فاضربه أرجوك بمِطرقة العدالة

97
00:07:54,840 --> 00:07:57,130
كامباياشي-سان قد غادرت

98
00:07:59,260 --> 00:08:01,810
روكاوا-كن. ما رأيك؟

99
00:08:01,810 --> 00:08:07,080
من الصّعب تصديق أنّ شخصاً قد نجا
من حكم الإعدام

100
00:08:07,420 --> 00:08:08,920
يراودني نفس الشّعور

101
00:08:08,920 --> 00:08:15,760
،لكن بعد الاطّلاع على سجلّات ساتاكي
بدأتُ أعتقد أنّ هذا قد يكون مُمكناً

102
00:08:16,910 --> 00:08:22,040
لا أدري ما إن كان من المنطقيّ أن
"نختصر كلّ هذا بـ"إنّه محظوظ جدّاً

103
00:08:22,040 --> 00:08:28,290
على ذكر الأمر، كان هناك ومليئاً بالكدمات
عندما عذّبنا ذلك المُتحرِّي الشّنيع

104
00:08:28,600 --> 00:08:33,120
لم يبدُ لي شخصاً سيّئاً حينها

105
00:08:34,920 --> 00:08:37,360
لا أعتقد بأنّنا سنلتقي ثانية أبداً

106
00:08:37,360 --> 00:08:44,060
إلّا إن ضللت طريقك وأصبحت بغيضاً

107
00:08:47,730 --> 00:08:50,560
هل هذا يعني أنّه ضلَّ عن طريقه؟

108
00:08:51,080 --> 00:08:53,800
ماذا ترغب أن تفعل بشأن هذه القضيّة؟

109
00:08:53,800 --> 00:08:58,780
لا أعرف الحقيقة، لكن ألم تلك السيّدة حقيقيّ

110
00:08:58,780 --> 00:09:04,480
في هذه الحالة، كلّ ما يمكنني فعله هو
التصرّف بموجب مبادئي كساقي التّعذيب

111
00:09:05,360 --> 00:09:07,460
لنتحرَّ حول هذه القضيّة أاكثر

112
00:09:08,420 --> 00:09:11,360
سنقرّر ماذا سنفعل عقب ذلك

113
00:09:11,840 --> 00:09:14,450
عُلِم، سينسي

114
00:09:15,350 --> 00:09:17,520
...خِداع الموت والدّوس على قلب أمّ

115
00:09:17,520 --> 00:09:19,840
هذا ما يفعله أيّ شخص بغيض

116
00:09:20,370 --> 00:09:23,350
...مهما حاول أن يهرب من حكم القانون

117
00:09:23,350 --> 00:09:27,150
لن يهرب من عينَي ساقي التّعذيب

118
00:09:29,200 --> 00:09:32,250
طبق تختصُّ به كاراكاس، شريحة لحم خنزير الماء

119
00:09:32,640 --> 00:09:33,860
!مذهل

120
00:09:33,860 --> 00:09:39,280
هذا خنزير ماء مطهو إذاً، أكبر القوارض في العالم

121
00:09:39,280 --> 00:09:43,560
يأكلون هذه الحيوانات الوديعة حقّاً

122
00:09:44,100 --> 00:09:45,000
...لكن

123
00:09:45,000 --> 00:09:51,770
أفضل لباقة يمكنني أن أبديها هي
أن أكون مُمتنّاً للحياة التي تغذّيني

124
00:09:51,770 --> 00:09:54,920
!شكراً على خنزير الماء

125
00:09:57,770 --> 00:09:58,970
!لذيذ للغاية

126
00:09:58,970 --> 00:10:01,940
رائحته كريهة، لكن مذاقه كمذاق خنزير

127
00:10:01,940 --> 00:10:06,120
!وانظر إلى حجم القطعة! إنّها مُشبعة

128
00:10:06,120 --> 00:10:11,580
!لذيذ، لذيذ، لذيذ

129
00:10:28,500 --> 00:10:29,560
!تشي

130
00:10:31,930 --> 00:10:33,630
هيروفومي؟

131
00:10:34,280 --> 00:10:37,640
أجل، هذا أنا يا تشي

132
00:10:37,640 --> 00:10:38,610
هل تتذكّرينني؟

133
00:10:40,440 --> 00:10:44,250
هذا أنت حقّاً يا هيروفومي

134
00:10:44,250 --> 00:10:45,760
أشعر وكأنّني أحلم

135
00:10:45,760 --> 00:10:47,690
لكن هذا ليس حلماً

136
00:10:48,160 --> 00:10:51,120
أنا سعيد جدّاً لأنّكِ على قيد الحياة

137
00:10:51,530 --> 00:10:53,940
...أنا سعيد جدّاً

138
00:10:53,940 --> 00:10:55,150
أجل

139
00:10:55,920 --> 00:11:00,150
ما زال لديك هذا الطوق

140
00:11:00,900 --> 00:11:02,360
بالتأكيد

141
00:11:02,360 --> 00:11:06,400
مُحال أن أهدره. إنّه حِلية الحظّ الثّمينة خاصّتي

142
00:11:08,600 --> 00:11:10,950
ما-ما الّذي يجري؟

143
00:11:14,820 --> 00:11:15,540
هيّا بنا

144
00:11:15,540 --> 00:11:16,890
!الدّواء من هنا

145
00:11:19,070 --> 00:11:20,200
!رائع

146
00:11:20,200 --> 00:11:23,880
الإشاعة بامتلاك هذا المشفى الكثير
!من البضائع كانت صحيحة

147
00:11:24,530 --> 00:11:28,150
!إذا بعنا هذه المُنتجات، سنصبح أغنياء جدّاً

148
00:11:29,520 --> 00:11:34,800
تُعاني فنزويلّا من نقص حادّ في المؤونات الطبّية

149
00:11:35,390 --> 00:11:39,900
،بينما تمتلك أكبر احتياطي وقود خامّ في العالم

150
00:11:39,900 --> 00:11:43,440
،اعتمدت على الدّخل من تصدير الوقود

151
00:11:43,440 --> 00:11:46,460
وأهملت الصّناعات الأخرى

152
00:11:46,460 --> 00:11:51,760
أفضى هذا إلى فوضى سياسيّة وأزمة
اقتصاديّة منذ سنة 2010 وما بعد

153
00:11:52,520 --> 00:11:55,240
والمُشكلة الكبرى هي المجال الطبّي

154
00:11:55,240 --> 00:12:03,830
الحكومة مَدينة لشركات دوائيّة
،أجنبيّة بأكثر من 500 مليار ين

155
00:12:03,830 --> 00:12:08,550
لذا فنزويلا غير قادرة على شراء مزيد من الدّواء

156
00:12:08,750 --> 00:12:12,510
لهذا يوجد نقص في الأدوية في هذا البلد

157
00:12:12,510 --> 00:12:18,760
فقدَ الكثير من المرضى حياتهم كان
من الممكن إنقاذهم لو توفّر الدّواء

158
00:12:22,680 --> 00:12:24,850
!أنتم! ماذا تفعلون؟

159
00:12:24,850 --> 00:12:26,810
!هذه لمرضانا

160
00:12:26,810 --> 00:12:27,790
!أعيدوها

161
00:12:27,790 --> 00:12:30,030
!اصمت أيّها الدجّال

162
00:12:38,470 --> 00:12:40,140
!ما-ما الّذي يجري؟

163
00:12:44,450 --> 00:12:46,500
!يـ-يا إلهي

164
00:12:47,740 --> 00:12:50,290
!نيغيشي-سان! ساتاكي-سان

165
00:12:52,180 --> 00:12:53,920
جامعة البشر المجنونة

166
00:12:55,600 --> 00:12:57,960
جامعة البشر المجنونة

167
00:13:00,990 --> 00:13:02,270
!لا ترتعدوا

168
00:13:02,270 --> 00:13:04,500
!أخلوا بهدوء

169
00:13:04,820 --> 00:13:06,090
ما الّذي يجري؟

170
00:13:06,430 --> 00:13:08,840
عصابة سرقة أدوية

171
00:13:09,200 --> 00:13:12,370
فجّروا شيئاً في الطابق الأرضي

172
00:13:12,760 --> 00:13:14,070
!فجّروا؟

173
00:13:14,070 --> 00:13:16,020
سينتشر الحريق إلى هنا قريباً

174
00:13:16,020 --> 00:13:17,570
!أخلوا المكان بسرعة رجاء

175
00:13:18,000 --> 00:13:19,440
!لنهرب يا تشي

176
00:13:19,440 --> 00:13:21,220
حـ-حسناً

177
00:13:28,540 --> 00:13:29,810
ما الخطب؟

178
00:13:31,080 --> 00:13:33,560
...ا-النّجدة

179
00:13:35,830 --> 00:13:38,380
أنا آسف، لكن اذهبي من دوني رجاء

180
00:13:38,380 --> 00:13:40,000
!هيروفومي

181
00:13:42,130 --> 00:13:43,500
...النّجدة

182
00:13:43,760 --> 00:13:45,520
هل أنت بخير؟

183
00:13:45,520 --> 00:13:46,530
هل تأذّيت؟

184
00:13:49,140 --> 00:13:51,930
أنت أحد اللّصوص

185
00:13:55,860 --> 00:13:57,480
ها نحن ذا

186
00:13:57,960 --> 00:13:59,240
لنخرج من هنا

187
00:14:00,510 --> 00:14:02,060
...ثقيل جدّاً

188
00:14:03,760 --> 00:14:06,320
تشي! لماذا لم تهربي؟

189
00:14:06,320 --> 00:14:08,160
أنا من ينبغي أن أقول لك ذلك

190
00:14:08,160 --> 00:14:09,630
لنسرع

191
00:14:10,550 --> 00:14:11,450
حسناً

192
00:14:18,890 --> 00:14:20,510
!هذا غير معقول

193
00:14:21,800 --> 00:14:24,040
!لا تستنشق الدّخان

194
00:14:24,040 --> 00:14:25,680
...حـ-حسناً

195
00:14:26,050 --> 00:14:29,520
لكن ماذا نفعل الآن؟

196
00:14:30,480 --> 00:14:34,130
،سبب الموت من الحريق ليس النّار

197
00:14:34,130 --> 00:14:36,390
إنّما التسمّم بأوّل أكسيد الكربون

198
00:14:37,340 --> 00:14:40,880
،حالما يدخل أوّل أكسيد الكربون جسدك

199
00:14:40,880 --> 00:14:44,840
فإنّه يُنقص مخزونك من الأكسجين

200
00:14:44,840 --> 00:14:48,440
ويسبّب تلفاً شديداً بدماغك والأعضاء الحيويّة الأخرى

201
00:14:49,100 --> 00:14:55,750
والأعراض الأوّليّة هي صُداع وغثيان ورؤية غير واضحة

202
00:14:55,740 --> 00:14:56,790
،عندما يتفاقم الأمر

203
00:14:56,790 --> 00:15:00,580
،يمكن أن يسبّب تشنّجات وفقدان وعي

204
00:15:00,580 --> 00:15:02,640
وقد يؤدّي في نهاية المطاف إلى الموت

205
00:15:03,160 --> 00:15:07,700
،بما أنّ أوّل أكسيد الكربون بلا رائحة ولا لون

206
00:15:07,700 --> 00:15:10,640
فيمكن أن تتسمّم منه دون أن تعي ذلك

207
00:15:10,640 --> 00:15:14,160
لهذا من المهمّ إخفاض رأسك

208
00:15:14,160 --> 00:15:19,170
ومغادرة المنطقة وذلك كي لا تستنشق الدُّخان

209
00:15:20,870 --> 00:15:22,050
!نيغيشي-سان

210
00:15:22,050 --> 00:15:23,520
!ساتاكي-سان

211
00:15:23,520 --> 00:15:25,610
ألم يخليا المكان بعد؟

212
00:15:25,610 --> 00:15:26,720
أين هما؟

213
00:15:27,180 --> 00:15:28,490
!اللّعنة

214
00:15:30,760 --> 00:15:32,010
!نيغيشي-سانا

215
00:15:32,570 --> 00:15:33,790
هل أنتِ بخير؟

216
00:15:33,790 --> 00:15:35,130
أين أنتِ الآن؟

217
00:15:35,430 --> 00:15:37,100
داخل المشفى

218
00:15:37,100 --> 00:15:39,280
المخرج مسدود

219
00:15:39,650 --> 00:15:41,390
...يا للهول

220
00:15:41,640 --> 00:15:42,440
!تشي

221
00:15:44,040 --> 00:15:45,010
!كيتو-سان

222
00:15:45,010 --> 00:15:47,250
نحن متوجّهون إلى السّطح

223
00:15:47,250 --> 00:15:49,960
أخبر قسم الإطفاء أن يمدّدوا السلّم

224
00:15:49,960 --> 00:15:50,950
!إلى السّطح

225
00:15:51,320 --> 00:15:54,090
السّطح؟ عُلِم

226
00:15:54,090 --> 00:15:55,340
توخّيا الحذر رجاء

227
00:15:58,380 --> 00:16:00,160
سنصعد إلى السّطح؟

228
00:16:00,160 --> 00:16:03,820
كلّ الطوابق مليئة بالنّار والدُّخان

229
00:16:04,440 --> 00:16:06,640
علينا صعود السّلالم

230
00:16:06,960 --> 00:16:07,740
هيّا بنا

231
00:16:07,740 --> 00:16:08,810
حـ-حسناً

232
00:16:09,290 --> 00:16:10,680
اتركاني

233
00:16:10,930 --> 00:16:12,290
ماذا قلت؟

234
00:16:12,540 --> 00:16:15,900
لن أكون إلّا عائق في وجهكما

235
00:16:15,900 --> 00:16:19,230
اتركا الوزن الزّائد واذهبا

236
00:16:19,840 --> 00:16:21,030
!لا تقل هذا

237
00:16:21,590 --> 00:16:24,260
كلّ هذا بسببكم أساساً

238
00:16:24,260 --> 00:16:27,690
لن أدعك تموت موتاً أنانيّاً

239
00:16:28,680 --> 00:16:32,870
!سئمتُ من رؤية النّاس يموتون

240
00:16:34,010 --> 00:16:35,690
هيّا، انهض

241
00:16:37,720 --> 00:16:39,730
سلّم إلى السّطح؟

242
00:16:40,080 --> 00:16:42,840
أجل. ينبغي أن يكونا هناك قريباً

243
00:16:44,070 --> 00:16:45,740
وسط هذا الحريق؟

244
00:16:45,740 --> 00:16:47,550
لستُ أدري ما إن كانا سينجوان

245
00:16:47,550 --> 00:16:49,410
!أرجوك، أتوسّل إليك

246
00:16:49,740 --> 00:16:51,710
!أوصل سلّماً لهما

247
00:16:57,180 --> 00:16:59,920
أشعر بدُوار شديد

248
00:17:00,290 --> 00:17:01,680
...اللّعنة

249
00:17:02,280 --> 00:17:04,420
هيروفومي، تماسك

250
00:17:05,930 --> 00:17:07,160
...تشي

251
00:17:07,160 --> 00:17:10,270
هذا صحيح. لن أموت هنا

252
00:17:12,010 --> 00:17:15,480
،ما لم أكتشف ماذا حدث بيني وبين تشي

253
00:17:15,740 --> 00:17:18,520
!لن أموت مهما حدث

254
00:17:22,990 --> 00:17:25,580
هل هناك... هل هناك سلّم؟

255
00:17:26,100 --> 00:17:28,420
!هيروفومي، هناك

256
00:17:28,420 --> 00:17:29,560
!هنا

257
00:17:29,560 --> 00:17:30,720
!أبليتم حسناً

258
00:17:30,720 --> 00:17:31,960
!بسرعة

259
00:17:32,520 --> 00:17:34,200
!من فضلك خذه أوّلاً

260
00:17:34,760 --> 00:17:36,370
إنّه جريح

261
00:17:39,400 --> 00:17:41,400
!انضمّا إلينا بسرعة

262
00:17:41,400 --> 00:17:42,150
أجل

263
00:17:42,150 --> 00:17:43,110
—تشي، أنتِ أوّلاً

264
00:17:47,590 --> 00:17:49,410
!ماذا حدث؟

265
00:17:49,410 --> 00:17:50,250
!هذا سيّئ

266
00:17:50,250 --> 00:17:51,340
!لا يمكننا الاقتراب أكثر

267
00:17:54,440 --> 00:17:56,960
...مـ... مستحيل

268
00:17:59,270 --> 00:18:01,290
أهذه هي النّهاية؟

269
00:18:01,850 --> 00:18:03,120
...هيروفومي

270
00:18:03,860 --> 00:18:05,000
أنا آسف

271
00:18:05,000 --> 00:18:07,120
أنا السّبب لإهداري الوقت

272
00:18:08,210 --> 00:18:09,200
لا أمانع

273
00:18:10,050 --> 00:18:12,320
كنتُ سعيدة

274
00:18:12,950 --> 00:18:15,110
لم تتغيّر البتّة

275
00:18:15,700 --> 00:18:20,000
لا يمكنك ترك شخص خلفك إذا
تأذّى حتّى لو كان لصّاً

276
00:18:20,440 --> 00:18:23,640
...ولأنّ طبعك هكذا أنا

277
00:18:24,240 --> 00:18:25,810
...تشي

278
00:18:28,340 --> 00:18:29,950
هل هذه...؟

279
00:18:29,950 --> 00:18:32,360
قنبلة اللصّ اليدويّة

280
00:18:35,500 --> 00:18:38,030
!مهلاً، هذا خطير

281
00:18:38,750 --> 00:18:42,770
هيروفومي، هل تثق بي؟

282
00:18:43,750 --> 00:18:45,070
—ما الّذي تحاولين

283
00:18:48,150 --> 00:18:49,110
أجل

284
00:18:49,110 --> 00:18:52,000
لديّ إيمان مُطلَق بكِ دوماً

285
00:18:56,090 --> 00:18:57,560
!تـ-تشي؟

286
00:18:59,940 --> 00:19:01,080
!انخفض

287
00:19:06,560 --> 00:19:08,180
!اختفت النّار

288
00:19:08,180 --> 00:19:09,820
ستعود النّار عمّا قريب

289
00:19:09,820 --> 00:19:10,970
!اركض

290
00:19:12,630 --> 00:19:19,070
هناك وسيلة لمكافحة النّار وهي الانفجارات

291
00:19:19,960 --> 00:19:25,380
بما أنّ الانفجار سيخمد النّار بشكل
،فوريّ على مساحة واسعة

292
00:19:25,380 --> 00:19:32,200
تُستخدَم المُتفجّرات للتعامل مع حرائق
المناطق الواسعة، مثل الغابات أو حقول النفط

293
00:19:33,860 --> 00:19:36,060
لكن إلى أين سنركض؟

294
00:19:36,060 --> 00:19:38,130
!لنقفز يا هيروفومي

295
00:19:38,130 --> 00:19:39,420
!نـ-نقفز؟

296
00:19:39,420 --> 00:19:42,260
--لكن هذا سطح بناء من خمسة طوابق

297
00:19:45,790 --> 00:19:48,770
...حدثَ هذا في السّابق

298
00:19:53,780 --> 00:19:55,240
...الآن تذكّرت

299
00:19:56,120 --> 00:19:59,000
!أتذكّر كلّ شيء

300
00:20:04,700 --> 00:20:06,440
أنتِ مجنونة

301
00:20:08,080 --> 00:20:12,060
مَن تعتقد بأنّني خُطِبتُ له؟

302
00:20:19,440 --> 00:20:21,870
!هيروفومي، افتقدتُك كثيراً

303
00:20:22,280 --> 00:20:23,360
!أحبّك

304
00:20:24,610 --> 00:20:26,020
أنا أيضاً يا تشي

305
00:20:26,530 --> 00:20:28,000
أحبّك

306
00:20:36,480 --> 00:20:37,740
ستذهب إذاً؟

307
00:20:37,740 --> 00:20:38,480
أجل

308
00:20:38,750 --> 00:20:41,740
الآن لديّ كلّ المعلومات التي أحتاجها

309
00:20:42,280 --> 00:20:47,080
قد لا يحقّ لي قول هذا الكلام، لكن
من فضلك اعتنِ بساتاكي

310
00:20:47,440 --> 00:20:49,830
أجل، يمكنك الاعتماد عليّ

311
00:20:59,160 --> 00:21:01,080
لا تتحرّك رجاء

312
00:21:02,210 --> 00:21:06,480
اعذرني على سلوكي، لكن لديّ بعض الأسئلة لك

313
00:21:06,880 --> 00:21:09,010
لم يُصدِر أيّ صوت على الإطلاق

314
00:21:09,720 --> 00:21:11,650
كـ-كيف يمكنني خدمتك؟

315
00:21:12,390 --> 00:21:16,510
زرتَ شيمودا تاداشي والّذي

316
00:21:16,510 --> 00:21:20,230
حُبِسَ لاختطافه الطائرة، صحيح؟

317
00:21:20,760 --> 00:21:21,740
أجل

318
00:21:22,400 --> 00:21:29,410
تلقّيتُ معلومات مفادها أنّ ساتاكي
هيروفومي قد يكون على قيد الحياة

319
00:21:29,870 --> 00:21:31,790
...هل تعرف شيئاً عن

320
00:21:37,880 --> 00:21:39,300
ما الأمر؟

321
00:21:39,300 --> 00:21:41,440
أنا سعيد

322
00:21:41,440 --> 00:21:47,240
لم أتوقّعك أن تزورني يا إيجوين-سان

323
00:21:47,660 --> 00:21:49,860
ما أدراك باسمي؟

324
00:21:50,460 --> 00:21:55,700
أنا في طريقي لرؤية ساتاكي-سان

325
00:21:56,130 --> 00:21:59,720
هل تريد الانضمام لي؟

326
00:23:32,550 --> 00:23:33,690
...هيروفومي

327
00:23:33,690 --> 00:23:34,610
!تشي

328
00:23:35,070 --> 00:23:38,750
!هيروفومي

329
00:23:36,190 --> 00:23:37,240
!تشي

330
00:23:38,750 --> 00:23:39,790
!تشي