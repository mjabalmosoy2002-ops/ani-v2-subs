1
00:00:03,980 --> 00:00:05,890
،في وقت متأخّر من ليلة رأس كلّ سنة

2
00:00:05,890 --> 00:00:10,610
.كان رجلٌ يزور مطعم إيكوماتسو

3
00:00:11,190 --> 00:00:14,290
،كان دائمًا يطلب طبق رامن

4
00:00:14,900 --> 00:00:17,700
،"ويقول، "لا يمكنني أكل كلّ هذا

5
00:00:18,110 --> 00:00:24,420
ويقسّمه إلى ثلاث حصص، ويتشاركها
.مع إيكوماتسو-دونو وزوجها

6
00:00:25,350 --> 00:00:29,180
،لكن مع مرور الوقت، توفّي زوجها

7
00:00:29,180 --> 00:00:31,050
.وتوقّف الرّجل عن المجيء

8
00:00:32,060 --> 00:00:34,930
من كان بالضّبط؟

9
00:00:37,310 --> 00:00:42,690
حقّقنا في أمره باستعمال الوشاح
،الّذي نسيه في المطعم كدليل

10
00:00:42,690 --> 00:00:48,060
وظهرت الحقيقة عبر كلمات نطقها
.مصدر غير متوقّع

11
00:00:48,900 --> 00:00:54,160
،كان ذلك الرّجل والد إيكوماتسو-دونو
.نيشيكي ماتسوغورو

12
00:00:56,180 --> 00:01:01,910
.ظنّت إيكوماتسو-دونو أنّه مات قبل 20 سنة

13
00:01:02,270 --> 00:01:07,590
لكنّه في الواقع ما يزال حيًّا ويعيش
.في مكانٍ ما هنا

14
00:01:08,620 --> 00:01:11,340
من هو والد إيكوماتسو-دونو؟

15
00:01:11,690 --> 00:01:14,430
ولِمَ لم يخبر ابنته عن هويّته؟

16
00:01:14,950 --> 00:01:19,770
ولِمَ اختفى؟

17
00:01:20,350 --> 00:01:22,760
!أنا جادّ، أين تظنّ نفسك تنغمس؟

18
00:01:22,760 --> 00:01:24,570
.لقد أسأت الفهم يا هاسيغاوا-سان

19
00:01:23,700 --> 00:01:26,990
!التّيّار يسحب المولى

20
00:01:24,570 --> 00:01:27,510
—هذا الرّجل الجادّ يريد أن ينغمس في مـ

21
00:01:27,510 --> 00:01:29,610
!توقّف يا هذا

22
00:01:29,610 --> 00:01:31,900
!لا يمكنني التّعامل مع هؤلاء الحمقى الثّلاثة

23
00:03:18,820 --> 00:03:21,030
ما خطبكم يا هؤلاء؟

24
00:03:22,380 --> 00:03:24,870
،لا أدري من الّذي أتيتم تبحثون عنه

25
00:03:24,870 --> 00:03:27,510
.لكن انسوا كلّ هذا بعد أن تخرجوا إلى السّطح

26
00:03:27,860 --> 00:03:30,390
.خذ، كل بعضًا من كسر الخبز

27
00:03:32,120 --> 00:03:37,660
.كما قلت من قبل، الجميع هنا يريدون نسيان ماضيهم

28
00:03:32,120 --> 00:03:39,120
!شاهدوا فصل بوروري في غرقة مضيئة ومن مسافة آمنة من التّلفاز

29
00:03:37,660 --> 00:03:41,310
.لا شيء جيّد يأتي من البحث فيه

30
00:03:42,710 --> 00:03:46,530
في الواقع، ما زال الأمر جيّدًا
.إن كانوا يريدون النسيان

31
00:03:51,050 --> 00:03:57,130
لدى بعضهم ماضٍ لا يمكنهم
.تذكّره حتّى وإن أرادوا ذلك

32
00:03:59,390 --> 00:04:00,790
.أنا آسفة

33
00:04:01,210 --> 00:04:05,290
.لقد أخفيت شيئًا عنكما

34
00:04:06,220 --> 00:04:07,630
.وعن الآنسة الصّغيرة أيضًا

35
00:04:08,030 --> 00:04:09,570
أخفيت شيئًا عنّا؟

36
00:04:10,110 --> 00:04:14,570
،لكنّكما تبدوان صديقين موثوقين للآنسة الصّغيرة

37
00:04:14,570 --> 00:04:16,390
.لذا فكّرت في أن أخبركما

38
00:04:17,780 --> 00:04:23,400
.أتى أحد من قبل يبحث عن السّيّد مثلكما

39
00:04:24,860 --> 00:04:25,900
!لماذا؟

40
00:04:27,310 --> 00:04:32,610
لِمَ لا تريد إخبار إيكوماتسو بالحقيقة يا أمّاه؟

41
00:04:32,610 --> 00:04:35,880
—ستبقى لديها فكرة خاطئة عن أبيها لـ

42
00:04:35,880 --> 00:04:37,330
.لا بأس بذلك

43
00:04:38,220 --> 00:04:40,970
.فقد مات مرّة بالفعل

44
00:04:40,970 --> 00:04:42,890
.وتخلّى عن إيكوماتسو أثناء ذلك

45
00:04:42,890 --> 00:04:44,330
!لكنّه لم يفعل

46
00:04:44,330 --> 00:04:46,010
...كلّ ما حدث أنّه نسي

47
00:04:46,010 --> 00:04:49,020
.والسّبب هو إنقاذه لأحدهم

48
00:04:52,410 --> 00:04:54,930
ماذا تريدني أن أخبرها إذًا؟

49
00:04:56,050 --> 00:04:58,220
أنّ والدها الرّائع

50
00:04:59,270 --> 00:05:03,480
أنقذ طفلاً من الغرق في النّهر

51
00:05:04,310 --> 00:05:05,810
واختفى؟

52
00:05:10,270 --> 00:05:12,820
،وعندما وجدناه أخيرًا

53
00:05:13,850 --> 00:05:19,940
كان قد نسينا تمامًا وتزوّج امرأة أخرى؟

54
00:05:22,340 --> 00:05:26,410
.لم يعد للرّجل الّذي عرفناه وجود

55
00:05:26,410 --> 00:05:28,590
.كان الأوان قد فات

56
00:05:29,070 --> 00:05:34,940
أعتقد أنّ هذا هو الخيار الأفضل
.من أجله وإيكوماتسو

57
00:05:39,350 --> 00:05:43,630
.يبدو أنّ ذلك العجوز فقد ذاكرته

58
00:05:46,260 --> 00:05:48,420
فقدان الذّاكرة، أليس كذلك؟

59
00:05:48,860 --> 00:05:52,740
مهما حدث في يومٍ ما، ينسى كلّ شيء
.عندما يستيقظ في اليوم التّالي

60
00:05:53,830 --> 00:05:58,390
،وبعد التّنقّل من مكانٍ لآخر
.وجد طريقه إلى مكبّ النّفايات

61
00:05:59,170 --> 00:06:03,120
لم يكن لذلك العجوز أيّ فكرة عن
،ماضيه أو عائلته، لكن في يومٍ ما

62
00:06:03,120 --> 00:06:05,580
.ظهر رجلٌ أمامه

63
00:06:07,710 --> 00:06:09,500
.وجدتك أخيرًا

64
00:06:10,140 --> 00:06:11,130
.بحثت عنك في كلّ مكان

65
00:06:12,420 --> 00:06:16,060
،لن تتذكّرني على الأرجح

66
00:06:16,060 --> 00:06:19,890
.لكنّي لم أنسَ أبدًا ما فعلته من أجلي

67
00:06:20,750 --> 00:06:23,170
.إن لم تستطع التّذكّر، فلست مضطرًّا لذلك

68
00:06:23,730 --> 00:06:27,650
.وإن رفضت المجيء معي، فلن أرغمك

69
00:06:29,620 --> 00:06:34,100
لكن حتّى وإن كان طبقًا واحدًا، هلاّ
أتيت رجاءً وتناولت الرّامن خاصّتنا؟

70
00:06:35,110 --> 00:06:38,450
.أعلم أنّ هذا ليس كافيًا البتّة لردّ ديني

71
00:06:40,490 --> 00:06:45,000
أعلم أنّ ذلك لن يكفّر عن خطيتي
.بفعلي هذا لك

72
00:06:45,580 --> 00:06:51,500
!لكنّي أريدك أن تأتي لترى حال ابنتك الجيّدة

73
00:06:52,060 --> 00:06:56,670
هذه أمنيتي الوحيدة بصفتي الطّفل
!الّذي أنقذت حياته في ذلك اليوم

74
00:06:59,260 --> 00:07:00,880
.إيكوماتسو

75
00:07:00,880 --> 00:07:04,730
.هذا تقليد رأس السّنة لمطعمنا الآن

76
00:07:05,490 --> 00:07:10,730
.احرصي على أن تواصليه إن حدث لي شيء ما

77
00:07:11,860 --> 00:07:17,780
.سمعت أنّ العجوز لم يلقِ بالاً لتوسّل الرّجل الباكي

78
00:07:18,550 --> 00:07:23,160
لكن كلّما حلّ رأس السّنة، كان يذهب
.إلى مكان ما بمفرده

79
00:07:23,650 --> 00:07:25,340
.أمر غريب

80
00:07:25,340 --> 00:07:28,170
،كان قد فقد كلّ ذكرياته

81
00:07:28,170 --> 00:07:30,930
.لكنّه تذكّر شيئًا واحدًا

82
00:07:33,620 --> 00:07:34,340
،أبي

83
00:07:34,810 --> 00:07:37,050
هل سنتناول طبقًا واحدًا من سوبا
رأس السّنة مجدّدًا؟

84
00:07:37,050 --> 00:07:39,750
.لا تكوني طمّاعة يا إيكوماتسو

85
00:07:39,750 --> 00:07:43,600
.أمّك محقّة. هذا أكثر من كافٍ

86
00:07:43,600 --> 00:07:46,060
...كما أنّنا إن قسّمناه إلى ثلاث حصص هكذا

87
00:07:46,520 --> 00:07:47,310
.تفضّلي

88
00:07:48,330 --> 00:07:51,860
هل يمكنني تناول كلّ هذا بمفردي حقًّا يا أبي؟

89
00:07:51,860 --> 00:07:53,380
.أجل

90
00:07:53,380 --> 00:07:57,000
.فقد أكلت أنا وأمّك في العمل

91
00:07:57,000 --> 00:07:59,950
.لا يمكنني أكل كلّ هذا

92
00:08:10,150 --> 00:08:13,880
.كان دايغو-ساما يتحدّث عن ذلك بكلّ سعادة

93
00:08:14,490 --> 00:08:18,590
قال أنّهم تمكّنوا من تناول السّوبا
.كعائلة من ثلاثة أفراد مجدّدًا

94
00:08:19,030 --> 00:08:24,050
أمّا الآن، فقد أصبح عجوزًا خرِفًا
.بالكامل إضافة لفقدانه لذاكرته

95
00:08:24,050 --> 00:08:28,140
يبدو أنّه نسي أمر الذّهاب
.إلى مطعم الرّامن ذاك أيضًا

96
00:08:30,910 --> 00:08:33,980
.لا يمكنني أكل كلّ هذا

97
00:08:36,300 --> 00:08:37,310
أتريدونه؟

98
00:08:39,050 --> 00:08:43,380
.لكنّي سمعت أنّه لم ينس ذلك

99
00:08:46,150 --> 00:08:48,410
نسي كلّ شيء؟

100
00:08:48,740 --> 00:08:50,250
.هذا غير صحيح

101
00:08:52,740 --> 00:08:54,890
...إن كان يتذكّر كلّ ذلك

102
00:08:54,890 --> 00:08:55,750
.فهو أكثر من كافٍ

103
00:08:56,510 --> 00:08:58,860
...غين-سان... زوراتشي

104
00:08:59,490 --> 00:09:03,430
هل هذا هو والد إيكوماتسو؟

105
00:09:03,430 --> 00:09:06,520
!لِـ-لِمَ أنتم هنا

106
00:09:06,520 --> 00:09:09,390
.لا تستخفّ بشبكة معلومات المتشرّدين

107
00:09:09,990 --> 00:09:12,640
.علمت أنّك ستقدم على شيء ما يا كاتسورا

108
00:09:15,020 --> 00:09:15,900
.لا تقلق

109
00:09:16,730 --> 00:09:19,500
.أرسلت لإيكوماتسو دعوة أيضًا

110
00:09:19,500 --> 00:09:25,570
.ففي النّهاية، هي بطلة قصّة انتقامي الرّئيسيّة

111
00:09:28,690 --> 00:09:29,910
.ستكون تلك مشكلة

112
00:09:32,060 --> 00:09:34,710
فقد اتّصلنا بذلك المطعم للتّوّ

113
00:09:36,170 --> 00:09:38,540
...وقمنا بحجز

114
00:09:42,010 --> 00:09:44,250
.من أجل طبق رامن

115
00:10:01,970 --> 00:10:03,110
...أنتما

116
00:10:07,550 --> 00:10:08,630
.عجبًا

117
00:10:08,630 --> 00:10:12,790
متى أصبح هذا المطعم مشهورًا لدرجة
تجمّع النّاس حوله يا ماتسو-ني؟

118
00:10:12,790 --> 00:10:13,780
.يا للأسف

119
00:10:13,780 --> 00:10:16,970
.ظننّاه ثقبًا في الجدار نحن فقط من يعلم بأمره

120
00:10:16,970 --> 00:10:19,380
هل أدرك النّاس أخيرًا مدى لذّة الطّعام هنا؟

121
00:10:19,380 --> 00:10:21,250
!كفى هراءً أيهّا الطّفلان

122
00:10:21,250 --> 00:10:23,380
!هل تريدان الموت؟ ابتعدا عن طريقنا

123
00:10:23,380 --> 00:10:25,730
.قطع الصّف ليس أمرًا لطيفًا

124
00:10:25,730 --> 00:10:27,690
.آسفان، لكن لدينا حجز

125
00:10:27,690 --> 00:10:28,870
.إيكوماتسو-سان

126
00:10:29,470 --> 00:10:32,270
هل لنا بطبق رامن في الحال؟

127
00:10:33,950 --> 00:10:35,890
.لدينا طلبيّة نوصلها

128
00:10:36,510 --> 00:10:39,480
...إلى عنوانٍ مجهول

129
00:10:40,090 --> 00:10:42,300
.محلّ إقامة نيشيكي ماتسوغورو

130
00:10:45,180 --> 00:10:49,460
كاتسورا، هل تفكّر في عدم تسليمنا ذلك العجوز؟

131
00:10:49,460 --> 00:10:51,610
،حتّى وإن أصغيت لك

132
00:10:51,610 --> 00:10:55,870
.لا أعتقد أنّك ستترك إيكوماتسو-دونو وشأنها

133
00:10:57,070 --> 00:11:00,130
.أنت محقّ، هكذا أحبّ أن يكون الأمر

134
00:11:00,990 --> 00:11:05,400
هلاّ ائتمنتنا على نفسك لبعض الوقت أيّها الأب؟

135
00:11:05,400 --> 00:11:10,350
نقسم على أن نساعدك لتأكل
.رامن إيكوماتسو-دونو مرّة أخرى

136
00:11:10,690 --> 00:11:14,390
ماذا يمكنك لساموراي تشرّد
وتخلّى عن سيفه أن يفعل؟

137
00:11:14,780 --> 00:11:15,700
!هيّا

138
00:11:15,700 --> 00:11:17,390
!نالوا منهم جميعًا بمن فيهم العجوز

139
00:11:17,730 --> 00:11:21,650
!السّيف ليس سلاح السّاموراي الوحيد

140
00:11:22,130 --> 00:11:24,400
!انس هراء السّاموراي ذاك! هذا ليس سلاحًا

141
00:11:24,400 --> 00:11:26,400
!هيا بنا أيّها الأب

142
00:11:26,400 --> 00:11:28,860
!إلى أين؟ أهذا ما قصدته بائتمانك على نفسه؟

143
00:11:28,860 --> 00:11:32,030
ما خطبك؟ ألا تريد إنقاذ ذلك العجوز؟

144
00:11:32,460 --> 00:11:34,730
بالنّسبة للسّاموراي، يعتبر أيّ شيء
،في متناول يده سلاح

145
00:11:34,730 --> 00:11:37,360
!مطرقة لسحق الحثالة أمثالكم

146
00:11:37,360 --> 00:11:41,000
!النّاس الّذين يدعون البشر بالمطارق هم أكبر حثالة

147
00:11:41,000 --> 00:11:42,840
.الخروج من هنا له الأولويّة

148
00:11:42,840 --> 00:11:44,670
.تماسك أيّها الأب رجاءً

149
00:11:44,670 --> 00:11:47,800
!مهلاً! خرفه بدأ يسوء أكثر

150
00:11:48,460 --> 00:11:49,180
.تبًّا

151
00:11:49,180 --> 00:11:53,680
سيصبح رأس العجوز فارغًا قبل
.أن نصل به إلى محلّ إيكوماتسو

152
00:11:53,680 --> 00:11:55,540
!وتلك غلطتكما

153
00:11:55,540 --> 00:11:57,980
،وإن ضيّع الكثير من الوقت
.فستكون إيكوماتسو في خطر أيضًا

154
00:11:57,980 --> 00:11:59,160
.ما باليد حيلة

155
00:11:59,160 --> 00:12:01,940
.سأتركك تحظى بالمجد يا زورا

156
00:12:01,940 --> 00:12:05,020
.اذهب قبل أن يتشبّع الرّامن بالماء

157
00:12:05,690 --> 00:12:11,200
.هراء. لم يبقّ أيّ مجد لي لأحظى به

158
00:12:12,070 --> 00:12:17,950
قادنا إلى هنا بكلّ بساطة الرّجلان
.اللّذان أحبّا إيكوماتسو-دونو

159
00:12:19,210 --> 00:12:24,590
كلّ ما يمكننا فعله هو شرب ما بقي
.حساء الرّامن خاصّتهما

160
00:12:25,390 --> 00:12:30,590
.ربّما لم يكن لدينا أيّ دورٍ نلعبه في كلّ هذا

161
00:12:30,970 --> 00:12:36,340
.لأنّ إيكوماتسو-دونو ترى رجلاً واحدًا فقط

162
00:12:37,940 --> 00:12:39,100
،لكن رغم ذلك

163
00:12:39,610 --> 00:12:41,890
،إن طالتها مشاعر الرّجلين

164
00:12:41,890 --> 00:12:44,110
،فسواء طالتها مشاعره أم لا

165
00:12:45,230 --> 00:12:47,940
سيذهب الرّجل الثّالث، صحيح؟

166
00:12:48,850 --> 00:12:51,340
.من أجل رامن إيكوماتسو العزيز عليه

167
00:12:52,530 --> 00:12:55,360
.ليس الرّامن، بل السّوبا

168
00:12:55,360 --> 00:12:58,360
.لكنّي أكلت منه ما يكفي لأسأم منه

169
00:12:58,360 --> 00:13:00,660
.سيكون ما تبقّى من الحساء كافيًا ليشبعني

170
00:13:01,530 --> 00:13:03,040
حقًّا؟

171
00:13:03,040 --> 00:13:08,050
إذًا اذهب واشرب ممّا بقي من الحساء
!أو من الجسم أو مهما يكن

172
00:13:09,220 --> 00:13:10,560
!مهلاً يا كاتسورا

173
00:13:10,560 --> 00:13:11,440
.مهلاً

174
00:13:11,970 --> 00:13:14,190
.أنا هو خصمك

175
00:13:14,190 --> 00:13:16,680
.فلنكن لطيفين كزميلين إضافيّين وحيدين

176
00:13:16,680 --> 00:13:19,310
!هدفاي هما كاتسورا و إيكوماتسو

177
00:13:19,310 --> 00:13:21,180
—ما كنت لأهتمّ بـ

178
00:13:22,670 --> 00:13:24,150
!يا زعيم

179
00:13:24,590 --> 00:13:26,330
ألم تسمعني؟

180
00:13:26,600 --> 00:13:30,510
.قلت لك أنّه أفضل من أن يواجه قمامة مثلك

181
00:13:31,030 --> 00:13:32,880
هل كنتم تعرفون؟

182
00:13:32,880 --> 00:13:38,660
أنّ بإمكان النّاس الّذين كانوا في قعر
.العالم السّفليّ أن يصلوا للقمّة هنا

183
00:13:39,110 --> 00:13:42,590
...لا أعلم إلى أي حدّ نزلتم يا حثالة

184
00:13:42,590 --> 00:13:45,040
سيكون الأمر ممتعًا يا هاسيغاوا-سان، أليس كذلك؟

185
00:13:45,670 --> 00:13:50,510
الحفرة الّتي سقطنا فيها أنا
.وهذا الرّجل بؤرةٌ لا قاع لها

186
00:13:52,830 --> 00:13:53,930
...زورا

187
00:13:54,950 --> 00:13:58,760
.أنت لا تختلف عن ذلكما الاثنان برأيي

188
00:13:59,500 --> 00:14:03,270
.جميعكم حمقى

189
00:14:07,990 --> 00:14:08,860
!اذهبي

190
00:14:14,220 --> 00:14:17,430
لِمَ نسيت؟

191
00:14:19,010 --> 00:14:22,350
لِم َ لم أتذكّر؟

192
00:14:23,750 --> 00:14:26,500
...لقد أحببته كثيرًا

193
00:14:27,490 --> 00:14:31,740
متى حبسته في أعماق ذاكرتي؟

194
00:14:35,810 --> 00:14:40,810
أشعر أنّه كان بإمكاننا رؤية المهمّ
.بوضوح في فقرنا

195
00:14:41,230 --> 00:14:46,380
.أنا واثقة أنّ عينيه ما كانت لتضلّ عنّا لولا ذلك

196
00:14:48,310 --> 00:14:52,570
.أنا هي الّتي تخلّت عن عائلتها العزيزة

197
00:14:52,570 --> 00:14:58,570
.لقد كان يراقبني لسنوات، مع أنّه فقد ذاكرته

198
00:14:59,070 --> 00:15:04,640
.وقد جمعنا معًا ليخبرني بذلك

199
00:15:05,090 --> 00:15:06,120
...لكنّي

200
00:15:18,610 --> 00:15:25,780
أبي، أنا واثقة أنّك نسيت هذه
،الابنة الفظيعة بالفعل

201
00:15:26,270 --> 00:15:29,350
مع مذاق طبق السّوبا الّذي تشاركناه
.نحن الثّلاثة كعائلة

202
00:15:30,370 --> 00:15:31,610
.لكن لا بأس

203
00:15:31,610 --> 00:15:33,910
.لا بأس مع ذلك

204
00:15:36,300 --> 00:15:39,890
.فهذه المرّة، أعدك ألاّ أنسى

205
00:15:40,790 --> 00:15:44,450
.لن تضلّ عيناي مجددًا

206
00:15:44,450 --> 00:15:49,700
...لذا أرجوك يا أبي، مرّة واحدة أخرى فقط

207
00:15:49,700 --> 00:15:51,140
...طبق آخر فقط

208
00:15:52,340 --> 00:15:53,590
—إيكوماتـ

209
00:16:03,500 --> 00:16:04,740
.إيكوماتسو

210
00:16:06,060 --> 00:16:09,940
.لا يمكنني أكل كلّ هذا

211
00:16:10,580 --> 00:16:12,220
.لا بأس

212
00:16:13,350 --> 00:16:14,540
...إيكوماتسو

213
00:16:15,500 --> 00:16:19,700
.لقد أكلت مع الجميع سلفًا

214
00:16:20,230 --> 00:16:24,200
.لقد شبعت بالفعل

215
00:16:24,890 --> 00:16:27,200
...لذا تشاركي هذا الرّامن

216
00:16:28,160 --> 00:16:29,210
!إيكوماتسو-دونو

217
00:16:30,870 --> 00:16:37,460
.مع النّاس الأعزّاء لديك، الّذين يقفون إلى جانبك

218
00:16:31,710 --> 00:16:33,070
!إيكوماتسو-دونو

219
00:16:40,250 --> 00:16:44,600
.هذا ما نريده أنا ودايغو-كن

220
00:16:46,460 --> 00:16:49,100
...صدقًا

221
00:16:51,550 --> 00:16:53,950
.لقد شبعت بالفعل

222
00:17:11,460 --> 00:17:15,720
أكان ذاك الصّوت الّذي سمعت صوته حقًّا؟

223
00:17:15,720 --> 00:17:19,600
أكان ما يزال يتذكّرني؟

224
00:17:19,600 --> 00:17:21,490
.لا يمكن معرفة ذلك الآن

225
00:17:22,330 --> 00:17:28,480
كل ما يمكنني قوله هو أنّه لولاه
.لما التقيت زوجي

226
00:17:28,480 --> 00:17:31,980
.ما كنت لأنجو وأرى هؤلاء مجددًا

227
00:17:32,410 --> 00:17:34,470
.أنا متأكّدة من هذا على الأقلّ

228
00:17:36,110 --> 00:17:37,830
.إيكوماتسو-دونو

229
00:17:37,830 --> 00:17:41,690
.طلبت السّوبا. لا أتذكّر أنّي طلبت الرّامن

230
00:17:42,090 --> 00:17:43,230
حقًّا؟

231
00:17:43,230 --> 00:17:45,470
.لا يجدر بالرّجال تصيّد الأخطاء

232
00:17:45,470 --> 00:17:47,190
.انظر إلى شعرك الطّويل للغاية

233
00:17:47,190 --> 00:17:49,270
.عليك أن تحصل على قصّة شعر قصيرة له

234
00:17:49,270 --> 00:17:51,000
ما علاقة شعري بهذا؟

235
00:17:51,000 --> 00:17:53,040
.هذا مطعم رامن كما تعلم

236
00:17:53,040 --> 00:17:56,190
لن يؤذيك أن تتناول بعض الرّامن
ولو لمرّة، أليس كذلك؟

237
00:17:56,190 --> 00:18:00,570
أو هل تقصد أنّ أكل غبيّ واحد
لرامن رأس السّنة يكفي؟

238
00:18:04,710 --> 00:18:09,610
لِمَ توقّفت أنت وغين-سان والطّفلان
عن المجيء بعد ذلك؟

239
00:18:09,610 --> 00:18:12,390
.كنت مدينًا لهم

240
00:18:12,720 --> 00:18:15,480
.لذا جعلوني أبحث عن شيء فقدوه أو ما شابه

241
00:18:15,480 --> 00:18:18,900
.لقد عاملوني كالعبد

242
00:18:18,900 --> 00:18:20,150
.أكاذيب

243
00:18:20,540 --> 00:18:23,130
أنا واثقة أنّكم لم تأتوا بدافع
.قلق غير ضروريّ عليّ

244
00:18:23,130 --> 00:18:24,220
.يا للبعد

245
00:18:26,810 --> 00:18:27,990
...على الأقلّ دعوني أشكركم

246
00:18:28,660 --> 00:18:31,160
كان بإمكانكم على الأقلّ أن تدعوني
!أعدّ لكم رامن على حساب المحلّ

247
00:18:32,300 --> 00:18:38,450
لا أرى سببًا ليشكرنا أو يطعمنا شخص
.بذاك الوجه الحزين

248
00:18:41,750 --> 00:18:43,420
.كل رجاءً

249
00:18:44,020 --> 00:18:46,180
.أنت الوحيد الّذي بقي

250
00:18:46,700 --> 00:18:50,250
...لقد تكبّدت عناء إعداده... لقد انتظرت كلّ هذا الوقت

251
00:18:51,550 --> 00:18:55,340
لكنّ العائلة الّتي أردت إطعامها إياه

252
00:18:57,060 --> 00:18:58,990
.لم تعد موجودة الآن

253
00:19:02,540 --> 00:19:04,740
.هذا سبب آخر كي لا آكله إذًا

254
00:19:05,790 --> 00:19:09,990
.لا أملك الحقّ في ذلك. سآتي في وقت لاحق

255
00:19:14,430 --> 00:19:15,500
.إيكوماتسو-دونو

256
00:19:16,310 --> 00:19:19,000
.هناك شيء واحد عليّ قوله

257
00:19:19,830 --> 00:19:24,510
...ما كنت لأسمح لنفسي بأكل ذلك الرّامن

258
00:19:24,990 --> 00:19:28,460
لكن حتّى وإن لم نقدر على
،مشاركة الرّامن كعائلة

259
00:19:28,460 --> 00:19:33,010
.يمكننا أن نشاركك معاناتك كأصدقاء

260
00:19:33,890 --> 00:19:37,020
.أعلمينا إن أردت البحث عن شيء فقدته

261
00:19:38,250 --> 00:19:40,510
.وأيضًا دعيني أوضّح الأمر

262
00:19:41,260 --> 00:19:44,030
.ليس الأمر أنّي أكره الرّامن

263
00:19:47,830 --> 00:19:48,650
...الأمر فقط أنّه

264
00:19:50,180 --> 00:19:52,910
.لا يمكنني أكل كلّ هذا

265
00:20:08,100 --> 00:20:09,690
،في وقت متأخّر من ليلة رأس السّنة

266
00:20:11,870 --> 00:20:15,860
.طلب ذلك الرّجل طبق رامن

267
00:20:18,290 --> 00:20:20,770
".لا يمكنني أكل كلّ هذا"

268
00:20:21,700 --> 00:20:25,180
...بعد أن قال ذلك، أخذ الرّامن خاصّته

269
00:20:35,730 --> 00:20:37,770
.وقسّمه إلى ستّ حصص

270
00:22:17,530 --> 00:22:21,820
.تعثرت وتخبطت في حياتي حتّى الآن

271
00:22:22,410 --> 00:22:26,340
لذا في النّهاية على الأقلّ، سأبقى بعيدًا عن التّراب

272
00:22:26,950 --> 00:22:30,690
.وأطير عاليًا نحو السماء الزّرقاء فوق

273
00:22:37,780 --> 00:22:41,660
لا تفعل ذلك، سوف تُسحَق
.إن سقطت من هذا العلوّ

274
00:22:41,660 --> 00:22:44,390
ضع نفسك مكان الرّجل الّذي يدير
.محلّ الشّواء في الأسفل

275
00:22:44,390 --> 00:22:45,920
.لا تسئ الفهم

276
00:22:45,920 --> 00:22:49,960
أريد فقط أن أعرف ما إن كنت
.ما أزال أملك أجنحة للطّيران

277
00:22:50,370 --> 00:22:52,270
.وقد أتيت إلى هنا للتّأكّد فقط

278
00:22:53,100 --> 00:22:58,170
لا أعرف ما حدث، لكن لا بدّ أنّ لك
.عائلة وأصدقاء سيحزنون عليك

279
00:22:58,170 --> 00:23:01,460
،والأهمّ من ذلك هو أنّك إن متّ هنا
.ستسبّب المشاكل لي

280
00:23:04,250 --> 00:23:06,260
.الحياة ثمينة، لذا لا تضيّعها

281
00:23:12,390 --> 00:23:13,480
ألم تسمعني؟

282
00:23:14,200 --> 00:23:17,570
.إن أحدثت ضجّة هنا، ستفسد كلّ شيء

283
00:23:18,860 --> 00:23:21,490
.الحياة ثمينة، لا تضيّع تلك الهديّة

284
00:23:21,990 --> 00:23:24,150
!انظروا من يتكلّم

285
00:23:24,150 --> 00:23:26,260
!أنت تريد أن تزهق روحًا بالتّأكيد

286
00:23:26,260 --> 00:23:29,010
!أنت تحاول قتل أحدهم بالتّأكيد، صحيح؟
!أنت قاتل مأجور، ألست كذلك؟

287
00:23:29,010 --> 00:23:31,650
.لا تسئ الفهم، أنا هنا لصيد الخنازير فقط

288
00:23:31,650 --> 00:23:35,260
من أيّ مسافة تحاول صيد الخنازير؟

289
00:23:35,260 --> 00:23:38,180
.لا تكن غبيًّا. لا ترتكب جريمة قتل

290
00:23:38,180 --> 00:23:39,660
.لا أريد سماع ذلك من رجل انتحاريّ

291
00:23:39,660 --> 00:23:41,080
!لا أريد سماع ذلك من قاتل مأجور

292
00:23:41,080 --> 00:23:42,560
لا أريد سماع ذلك من رجل يرتدي
.نظّارات شمسيّة قذرة

293
00:23:42,560 --> 00:23:44,400
لا أريد سماع ذلك من رجل يرتدي
!نظّارات شمسيّة سخيفة

294
00:23:44,400 --> 00:23:45,980
.نظّاراتك الشّمسيّة أسخف منها

295
00:23:45,980 --> 00:23:48,020
.لا، بل نظّاراتك الشّمسيّة هي الأسخف

296
00:23:48,980 --> 00:23:50,270
.دعني أكون صريحًا

297
00:23:50,270 --> 00:23:53,900
لا أكترث لنوع النّظّارات الشّمسيّة
.الّتي ترتديها أو متى وأين ترتديها

298
00:23:53,900 --> 00:23:55,030
!هل نتحدّث الآن عن النّظّارات الشّمسيّة؟

299
00:23:55,130 --> 00:24:00,740
الحلقة القادمة

300
00:23:56,670 --> 00:24:00,740
.ستكون هكذا

301
00:24:00,740 --> 00:24:05,370
.يريد هاسيغاوا الانطلاق قبل الوقت المحدّد

302
00:24:00,740 --> 00:24:05,370
.اكتشفوا في الحلقة القادمة ما إن كان سيكتسب أجنحةً

303
00:24:05,370 --> 00:24:12,250
.ولن تكون عن النّظّارات الشّمسيّة فقط

304
00:24:05,370 --> 00:24:12,250
.ستكون هناك قصّة عن الشّرطة أيضًا