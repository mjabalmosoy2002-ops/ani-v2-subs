1
00:00:02,980 --> 00:00:04,560
.هذه كانت قريبة

2
00:00:04,560 --> 00:00:06,730
هل تأذيت؟

3
00:00:06,730 --> 00:00:08,070
مانا؟

4
00:00:09,320 --> 00:00:10,780
.أجل

5
00:00:10,780 --> 00:00:12,240
.أعتقد أنكِ متفاجئة

6
00:00:12,650 --> 00:00:16,820
.يا ألهي. تقاطعينا في موعدنا

7
00:00:16,820 --> 00:00:19,120
ألا تمتلكين أية أخلاق؟

8
00:00:19,430 --> 00:00:21,160
.سأخبرك بالتفاصيل قريبًا يا ني-ساما

9
00:00:21,160 --> 00:00:23,620
.سأضح حدًا لهذا

10
00:00:30,880 --> 00:00:31,840
!كورومي

11
00:00:38,220 --> 00:00:39,010
!توقفي

12
00:00:39,010 --> 00:00:39,930
!لا تقتليها

13
00:00:42,230 --> 00:00:45,690
.شيدو-سان، أنت رحيم جدًا

14
00:00:48,860 --> 00:00:50,020
لماذا؟

15
00:00:52,780 --> 00:00:55,030
!لما تتصرفين وكأن شيئًا لم يحدث؟

16
00:00:55,030 --> 00:00:57,240
!لقد قتلتِ شخصًا للتو

17
00:00:57,240 --> 00:00:58,910
.أنها روح يا ني-ساما

18
00:01:01,240 --> 00:01:04,040
.ولأني تعودت عل هذا

19
00:01:09,250 --> 00:01:12,960
،أنه الشيء الذي يعطي كل شيء وجوده

20
00:01:12,960 --> 00:01:14,880
.لكنه لا يُشترى

21
00:01:15,300 --> 00:01:20,180
.الناس أهدروه بدون إعتقدأو ندم يأنتهاءه

22
00:01:20,180 --> 00:01:22,180
.يصلون الى غايتهم عندما ينتهي

23
00:01:22,180 --> 00:01:25,600
وماذا يكون هذا؟

24
00:02:47,890 --> 00:02:51,350
.أعتقد أنك سمعت عن هذا من الرقيبة توبيتشي

25
00:02:51,350 --> 00:02:55,650
.أعتبر ما حدث اليوم مُجرد حِلم سيئ وأنساه

26
00:02:55,650 --> 00:02:56,900
كيف لي أن أنساه؟

27
00:02:56,900 --> 00:02:58,440
.هي لم تمت

28
00:02:59,740 --> 00:03:04,030
.الكابوس، توكيساكي كورومي، إنها حالة خاصة حتى بين الارواح

29
00:03:04,030 --> 00:03:07,040
،مهما كان عدد المرات التي أقتلها او كيف أقتلها

30
00:03:07,040 --> 00:03:09,770
،فهي تعود دائمًا في مكان أخر

31
00:03:09,770 --> 00:03:12,790
.وكأن شيئًا لم يحدث، وتبدأ بقتل الناس مجددًا

32
00:03:12,790 --> 00:03:16,250
،لهذا أستمريت في قتلها

33
00:03:16,250 --> 00:03:18,300
.مهما كان عدد المرات

34
00:03:18,300 --> 00:03:21,380
.مرارًا وتكرارًا

35
00:03:20,220 --> 00:03:21,380
!توقفي رجاءًا

36
00:03:22,970 --> 00:03:25,680
.لا تقولي أنك مُعتادة على هذا

37
00:03:25,680 --> 00:03:27,770
.أنكِ بلا احساس

38
00:03:28,810 --> 00:03:31,350
.هذا أمر عليّ فعله

39
00:03:32,140 --> 00:03:32,730
!أنتظري

40
00:03:32,730 --> 00:03:33,900
!مانا

41
00:03:36,230 --> 00:03:37,320
!اللعنة

42
00:03:40,110 --> 00:03:42,070
لماذا؟

43
00:03:43,070 --> 00:03:46,080
لماذا... تقول؟

44
00:03:47,410 --> 00:03:48,910
!العملية قد أحبطت

45
00:03:48,910 --> 00:03:50,620
!سنخرجك مع فراكينوس

46
00:03:50,920 --> 00:03:52,580
شيدو، هل تسمعني؟

47
00:04:01,340 --> 00:04:02,340
!شيدو

48
00:04:03,510 --> 00:04:05,800
شيدو، أين كُنت؟

49
00:04:05,800 --> 00:04:06,480
.أنت مصاب

50
00:04:06,480 --> 00:04:07,850
ماذا حدث؟

51
00:04:07,850 --> 00:04:09,600
ما معنى هذا؟

52
00:04:15,400 --> 00:04:17,360
أسفه، هل هذا مؤلم؟

53
00:04:17,860 --> 00:04:18,730
...لا

54
00:04:20,360 --> 00:04:21,070
!أسف

55
00:04:21,070 --> 00:04:21,990
!شيدو

56
00:04:30,040 --> 00:04:31,330
.توكا

57
00:04:31,330 --> 00:04:32,370
.شيدو

58
00:04:33,120 --> 00:04:34,420
هل أنت بخير؟

59
00:04:35,250 --> 00:04:36,250
...أجل

60
00:04:36,250 --> 00:04:38,290
!إذًا، هيا بنا

61
00:04:39,880 --> 00:04:40,710
ما الامر؟

62
00:04:40,710 --> 00:04:42,470
.موعدنا لم ينتهي بعد

63
00:04:44,470 --> 00:04:45,930
!أعطيني تلك الكعكة

64
00:04:45,930 --> 00:04:47,180
!النقانق

65
00:04:47,180 --> 00:04:48,430
!الفطائر

66
00:04:50,680 --> 00:04:51,520
.شـ-شكرًا

67
00:04:51,520 --> 00:04:52,730
!التالي هو هذا

68
00:04:54,690 --> 00:04:57,480
.توكا، لا أعتقد أن لدي المال الكافي لهذا

69
00:04:57,480 --> 00:04:59,320
!لا تقلق

70
00:04:59,320 --> 00:05:01,780
!رين أعارتني هذه البطاقة السحرية

71
00:05:01,780 --> 00:05:02,990
بطاقة سوداء؟

72
00:05:03,740 --> 00:05:08,240
.رين أخبرتني كل شيء عن كورومي ومانا

73
00:05:09,450 --> 00:05:10,990
.فهمت

74
00:05:11,490 --> 00:05:16,620
.عليّ إيقاف كورومي من قتل أي شخص أخر

75
00:05:16,620 --> 00:05:17,500
.أجل

76
00:05:18,000 --> 00:05:21,670
.لكن، لا أعرف كيف بأمكاني التقرب منها الان

77
00:05:22,710 --> 00:05:24,760
،قد تكون كورومي روحًا

78
00:05:24,760 --> 00:05:27,220
.لكنها مختلفه عنك وعن يوشينو

79
00:05:27,550 --> 00:05:29,510
.هذا ما أنت مُخطئ فيه يا شيدو

80
00:05:29,510 --> 00:05:30,220
ماذا؟

81
00:05:33,140 --> 00:05:35,060
...كورومي ليست مختلفه

82
00:05:36,980 --> 00:05:38,190
.عني

83
00:05:40,730 --> 00:05:43,030
.أنت كنت هناك لأجلي

84
00:05:43,980 --> 00:05:47,150
.أنت أنقذتني

85
00:05:47,570 --> 00:05:52,160
.كما حدث اليوم، أنت طلبت مني الخروج في موعد

86
00:05:52,160 --> 00:05:55,290
.آريتني كم أن هذا العالم جميل

87
00:05:57,790 --> 00:05:59,540
،أن لم تكن هناك لأجلي

88
00:05:59,540 --> 00:06:02,500
.سيكون من المحتمل أن أصبح مثل كورومي الان

89
00:06:03,170 --> 00:06:07,010
،أن كان عليّ تسمية الاختلاف بين كورومي وانا

90
00:06:09,300 --> 00:06:12,680
.سيكون بأنه لدي شخص مد يده لي ووقف بجانبي

91
00:06:14,770 --> 00:06:16,810
.شكرًا لكِ يا توكا

92
00:06:16,810 --> 00:06:18,940
.لقد ذكرتيني بشيء مهم

93
00:06:19,310 --> 00:06:20,020
.أجل

94
00:06:20,020 --> 00:06:21,900
ألست خائفًا بعد الان؟

95
00:06:21,900 --> 00:06:22,980
.ربما قليلًا

96
00:06:22,980 --> 00:06:24,150
.لا بأس

97
00:06:24,150 --> 00:06:25,900
!سأحميك يا شيدو

98
00:06:25,900 --> 00:06:27,820
.هذا مُطمئن

99
00:06:27,820 --> 00:06:28,700
!أليس كذلك؟

100
00:06:29,070 --> 00:06:32,990
شيدو، هل بأمكاني الاستمتاع بالمنظر لفترة أطول؟

101
00:06:32,990 --> 00:06:33,870
.طبعًا

102
00:06:37,830 --> 00:06:39,290
.شيدو-سان

103
00:06:39,290 --> 00:06:40,540
!صباح الخير

104
00:06:43,000 --> 00:06:44,040
.صباح الخير

105
00:06:45,250 --> 00:06:46,550
!أتسوكا شيدو

106
00:06:46,550 --> 00:06:48,550
.لديك الجراء لتأتي الى المدرسة بعد ما فعلت

107
00:06:48,550 --> 00:06:50,050
!مُقرف

108
00:06:50,050 --> 00:06:51,050
!أنتظرنّ

109
00:06:51,050 --> 00:06:54,560
.أتركنّ شيدو وبمفرده الان

110
00:06:53,140 --> 00:06:54,560
!مُقرف

111
00:06:54,560 --> 00:06:57,020
.لكن، أنا متفاجئة قليلًا

112
00:06:57,020 --> 00:07:01,770
.أعتقدت أنك ستأخذ أجازه هذا اليوم

113
00:07:01,770 --> 00:07:02,860
.كورومي

114
00:07:02,860 --> 00:07:03,560
نعم؟

115
00:07:03,940 --> 00:07:07,070
.قررت أن أنقذك

116
00:07:08,780 --> 00:07:10,990
.ياله من تفكير شاذ

117
00:07:11,410 --> 00:07:13,700
.لن أسمح لك بقتل أحد بعد الان

118
00:07:14,660 --> 00:07:16,990
.لن أسمح لـ مانا بقتلك مُجددًا

119
00:07:20,000 --> 00:07:22,000
حقًا؟

120
00:08:03,290 --> 00:08:08,800
.شيدو-سان، سأختبرك سواء كُنت تعني ما تقوله أو لا

121
00:08:10,340 --> 00:08:11,800
.منظمة راتاتوسكر

122
00:08:12,260 --> 00:08:16,300
.لا أصدق أنكِ وني-ساما تعملون فيها

123
00:08:16,300 --> 00:08:17,930
.يبدو أنكِ تقومين بواجبك

124
00:08:17,930 --> 00:08:18,720
ما هو هدفك؟

125
00:08:19,010 --> 00:08:20,100
.أتسوكا شيدو

126
00:08:21,100 --> 00:08:25,230
.تجبرينه بالاتصال المباشر مع الارواح وبدون سلاح حتى

127
00:08:26,020 --> 00:08:28,360
.أنتِ فاشله كـ أخت صغيرة

128
00:08:28,360 --> 00:08:30,730
.سأهتم بالامور بنفسي الان

129
00:08:30,730 --> 00:08:32,650
.هذه مزحة جميلة منكِ

130
00:08:32,650 --> 00:08:37,240
هل تتوقعين أن أئتمن شيدو بشركة شريرة مثل صناعات ديوس أكس ماتشينا؟

131
00:08:37,570 --> 00:08:38,740
كيف تعلمين عن هذا؟

132
00:08:38,740 --> 00:08:41,160
.لا تقللي من تقديري

133
00:08:41,160 --> 00:08:44,580
...ديوس أكس ماتشينا هي شركة عسكرية خاصة التي تُجهز

134
00:08:44,580 --> 00:08:47,250
.كل الجيش وقوة الشرطة، ماعدا راتاتوسكر بوحدات ريالزير

135
00:08:47,250 --> 00:08:50,750
أنتِ المرسلة مُستخدمة أي إي تي الان، اليس كذلك؟

136
00:08:58,640 --> 00:08:59,510
!صحيح

137
00:09:00,430 --> 00:09:03,680
.لم نُكد أن توكيساكي كورومي تركت المدرسة

138
00:09:03,680 --> 00:09:07,520
.المشكلة هي أن كانت ستستمع أو لا الى ما نقوله

139
00:09:07,520 --> 00:09:08,520
ماذا؟

140
00:09:08,520 --> 00:09:09,520
أين كوتوري؟

141
00:09:09,520 --> 00:09:11,280
.لديها بعض العمل المستعجل

142
00:09:11,280 --> 00:09:14,280
.سأكون ملاحتك لهذه المهمة

143
00:09:14,610 --> 00:09:15,900
.فهمت

144
00:09:15,900 --> 00:09:17,030
.سأعتمد عليكِ

145
00:09:20,910 --> 00:09:21,910
ماذا يحدث؟

146
00:09:22,790 --> 00:09:23,790
!ريني-سان

147
00:09:24,140 --> 00:09:25,790
.سنقوم بالتحليل الان

148
00:09:26,090 --> 00:09:28,790
.شركة شريرة؟ لا أعتقد أنني أسمح لكِ بهذا

149
00:09:29,250 --> 00:09:34,380
.الشركة أعطتني سببًا للعيش بعد فقداني لذكرياتي

150
00:09:34,380 --> 00:09:36,260
.أنني أدين لهم بكل شيء

151
00:09:36,260 --> 00:09:37,010
متأكدة؟

152
00:09:37,010 --> 00:09:38,390
بعد ما فعلوا لكِ؟

153
00:09:38,720 --> 00:09:40,140
عن ماذا تتحدثين؟

154
00:09:41,970 --> 00:09:46,440
.قمت بتحليل اللعاب من كوب تاكاميا مانا

155
00:09:47,060 --> 00:09:50,440
.الكميات المتطرفة للطاقة السحرية وضعت في أجزاء مختلفة من جسمها

156
00:09:50,860 --> 00:09:54,110
.لا أعتقد أن بأمكانها العيش أطول من عشرة سنوات اخرى

157
00:09:55,820 --> 00:09:58,450
لا يمكن... أن لا فكرة لديكِ؟

158
00:10:00,410 --> 00:10:01,700
أنه أنا، ما الامر؟

159
00:10:01,700 --> 00:10:05,580
.أيتها القائدة، أكتشفنا روح حادة في أرجاء مدرسة رايزين العليا

160
00:10:05,580 --> 00:10:07,040
.لابد أنها توكيساكي كورومي

161
00:10:07,040 --> 00:10:07,710
ماذا قُلت؟

162
00:10:10,710 --> 00:10:12,880
.أنه حاجر واسع النطاق

163
00:10:12,880 --> 00:10:16,050
.يبدو أن غرض الحاجز هو أضعاف البشر الذين بداخله

164
00:10:16,050 --> 00:10:17,050
من فعل كورومي؟

165
00:10:17,050 --> 00:10:17,720
لماذا؟

166
00:10:18,090 --> 00:10:20,220
...شـ- شيدو

167
00:10:20,590 --> 00:10:22,470
توكا، هل أنتِ بخير؟

168
00:10:23,560 --> 00:10:25,890
.أنا بخير، لكن أشعر بالثقل في جسدي

169
00:10:25,890 --> 00:10:27,480
لماذا أنا الوحيد الغير متأثر؟

170
00:10:27,980 --> 00:10:31,770
،لان لديك توكا وقوة روح يوشينو التي ختمت ضمنك

171
00:10:31,770 --> 00:10:34,480
.كما أنك محمي من قبل روح الحماية المقدسة

172
00:10:34,480 --> 00:10:37,990
.بهذه الامور، أنت الوحيد الذي يستطيع التحرك الان

173
00:10:39,150 --> 00:10:40,490
،شيدو-سان

174
00:10:40,490 --> 00:10:41,990
هل تسمعني؟

175
00:10:43,330 --> 00:10:46,910
.أن أردت شيئًا مني، فالتأتي الى السطح

176
00:10:46,910 --> 00:10:50,960
.أعتقد أن عليك أن تأتي الى هنا بأسرع ما لديك

177
00:10:55,210 --> 00:10:57,340
.توكا، استريحي هنا

178
00:10:58,380 --> 00:10:59,470
.لا تقلقِ

179
00:10:59,470 --> 00:11:00,510
.سأنقذها

180
00:11:02,140 --> 00:11:03,510
...شيدو

181
00:11:08,600 --> 00:11:11,730
.المعرف: أي أس تي، توبيتشي أورغامي

182
00:11:13,940 --> 00:11:15,320
.الريالزير الاساسي

183
00:11:15,320 --> 00:11:16,360
.آذن بالنشر

184
00:11:43,720 --> 00:11:44,930
.مرحبًا

185
00:11:44,930 --> 00:11:47,680
.كُنت أنتظرك يا شيدو-سان

186
00:11:48,810 --> 00:11:50,730
إستعملتي الأجهزة الطارئة، أليس كذلك؟

187
00:11:50,730 --> 00:11:51,690
.أعطيني تقرير الحالة

188
00:11:51,690 --> 00:11:53,020
.خطر للغاية

189
00:11:53,020 --> 00:11:53,690
.أطلب الدعم

190
00:11:56,190 --> 00:11:57,690
أورغامي-سان؟

191
00:11:57,690 --> 00:12:00,320
الى أين تذهبين بهذه السرعة؟

192
00:12:00,320 --> 00:12:02,200
.توكيساكي كورومي

193
00:12:02,200 --> 00:12:06,200
.أسفة، لكن لا أعتقد أنني سأسمح لكِ بالعبور من هنا

194
00:12:08,830 --> 00:12:10,250
!شيدو

195
00:12:10,250 --> 00:12:11,210
...شيدو

196
00:12:17,380 --> 00:12:19,630
...مؤلم

197
00:12:19,630 --> 00:12:20,760
...شيدو

198
00:12:21,630 --> 00:12:26,090
!تحركِ! تحركِ! تحركِ

199
00:12:33,730 --> 00:12:34,900
...هذا

200
00:12:34,900 --> 00:12:36,400
!يمكنني فعل ذلك

201
00:12:38,980 --> 00:12:39,780
من هناك؟

202
00:12:42,780 --> 00:12:43,780
...أنتِ

203
00:12:43,780 --> 00:12:46,030
.مساء الخير يا توكا-سان

204
00:12:48,830 --> 00:12:50,990
كورومي، ماذا تفعلين؟

205
00:12:51,790 --> 00:12:53,500
أليس رائعًا؟

206
00:12:53,500 --> 00:12:55,000
.قلعتي الملتهمة للوقت

207
00:12:55,000 --> 00:12:59,840
.أنه الحاجز الذي يمتص الوقت من الكل لكي يسقطوا في ظلي في النهاية

208
00:12:59,840 --> 00:13:01,000
وقت؟

209
00:13:02,090 --> 00:13:03,010
...هذا

210
00:13:03,010 --> 00:13:06,010
.هذا هو وقتي

211
00:13:06,010 --> 00:13:09,260
.يمكنك القول أنه يمثل عمري أيضًا

212
00:13:09,850 --> 00:13:14,560
.يسمح لي بأمتلاك قوة رائعة

213
00:13:14,560 --> 00:13:18,520
.للأسف، كل مرة أفتحها، تقوم بأستهلاك كميات كبيره من وقتي

214
00:13:19,150 --> 00:13:22,780
.ذلك بين الحين والاخر، أعيد ملئ وقتي خارجيًا

215
00:13:24,030 --> 00:13:25,030
ماذا قلتي؟

216
00:13:25,450 --> 00:13:28,950
.كم هي فريستي مثيرة للشفقة الأن

217
00:13:28,950 --> 00:13:34,200
.لكن... لكنك يا شيدو-سان شخص خاص

218
00:13:35,330 --> 00:13:36,790
،بعد كل شيء

219
00:13:37,870 --> 00:13:41,630
،لكي أصبح واحدًا معك

220
00:13:41,630 --> 00:13:45,550
.جئت كل هذا الطريق لألتهامك مباشرًا

221
00:13:46,590 --> 00:13:49,800
.أن كنتِ تُريديني، فلا داعي لفعل كل هذا

222
00:13:50,220 --> 00:13:54,980
.قبل أن ألتهمك، أردتك أن تسترد ما قلت لهذا هذا الصباح

223
00:13:54,980 --> 00:13:57,940
.أريدك أستعادة ما قلت لي حيال أنقاذي

224
00:13:58,940 --> 00:14:00,610
،شيدو-سان

225
00:14:00,610 --> 00:14:02,820
.لقد فعلت كل هذا بسبب ما قلته

226
00:14:02,820 --> 00:14:05,030
ألا تجدني مُخيفة؟

227
00:14:05,030 --> 00:14:06,700
ألا تكرهني؟

228
00:14:06,700 --> 00:14:10,200
أليس واضحًا لك أنني لست شخصًا يستحق شفقتك؟

229
00:14:10,620 --> 00:14:15,000
.لذلك، رجاءًا أسترد ما قلته

230
00:14:15,700 --> 00:14:19,960
.أن فعلت هذا، فلن أمانع في أزالة هذا الحاجز

231
00:14:22,840 --> 00:14:24,760
.هيا أسرع

232
00:14:24,760 --> 00:14:28,720
.أن أطلت الامر، ربما لن يكون هناك طريقة لإنقاذ أصدقائك

233
00:14:31,680 --> 00:14:33,220
،أزلي الحاجز رجاءاً

234
00:14:33,720 --> 00:14:36,220
.لكن، لم أستسلم عنكِ

235
00:14:37,020 --> 00:14:38,350
ماذا تقول؟

236
00:14:41,770 --> 00:14:43,610
.أنت يائس

237
00:14:52,570 --> 00:14:55,740
.أنا متأكده أنك تعلم ماذا يعني ذلك

238
00:14:56,120 --> 00:14:57,750
أنذار زلزال الفضائي؟

239
00:14:59,960 --> 00:15:02,130
هل توكيساكي هي السبب وراء زلازل الفضائي؟

240
00:15:02,130 --> 00:15:04,500
.من المفجع أن يكون هناك زلزال الفضائي

241
00:15:04,500 --> 00:15:06,250
هل تسببها عمدًا؟

242
00:15:08,630 --> 00:15:10,930
إذًا قل لي، ماذا ستفعل الان؟

243
00:15:10,930 --> 00:15:16,560
أتسائل، ماذا سيحدث لكل هؤلاء الطلاب الفاقدين للوعي أن حدث زلزال الفضائي الان؟

244
00:15:17,520 --> 00:15:21,230
.شين، حالة كورومي العقلية تتغير

245
00:15:21,230 --> 00:15:23,520
.يبدو وكأنها خائفة منك

246
00:15:23,520 --> 00:15:24,520
!هذا هو

247
00:15:24,860 --> 00:15:28,940
.كورومي، قُلتي أن هدفك هو ألتهامي

248
00:15:28,940 --> 00:15:32,530
...أوقفي الزلزال الفضائي وألا

249
00:15:35,760 --> 00:15:37,790
.سأقفز من هنا وأنتحر

250
00:15:38,330 --> 00:15:40,160
تستعمل نفسك كـ رهينة؟

251
00:15:41,290 --> 00:15:42,670
.تهديد سخيف

252
00:15:42,670 --> 00:15:44,540
.أفعل هذا ان تجرأت

253
00:15:45,340 --> 00:15:46,250
.طبعًا

254
00:15:53,640 --> 00:15:54,850
.لا أصدق أنك فعلت ذلك

255
00:15:55,390 --> 00:15:57,350
هل أنت غبي؟

256
00:15:58,680 --> 00:16:00,520
.هذا يوضح الامر

257
00:16:00,520 --> 00:16:02,850
.انا رهينة ثمينة

258
00:16:04,440 --> 00:16:07,230
هل ستوقفين الزلزال الفضائي؟

259
00:16:07,230 --> 00:16:09,610
وهل تمانعين أن تزيلي هذا الحاجز؟

260
00:16:10,030 --> 00:16:12,110
.أن لم تفعلي ذلك، سأعض لساني وسأموت

261
00:16:13,450 --> 00:16:14,870
مـ-ماالخطب معك؟

262
00:16:24,620 --> 00:16:25,790
.حسنًا

263
00:16:25,790 --> 00:16:26,670
.شيئًا واحد

264
00:16:26,670 --> 00:16:28,500
شيئًا واحد؟

265
00:16:28,960 --> 00:16:32,920
كورومي، هل تعطيني الفرصة للبدء؟

266
00:16:32,920 --> 00:16:34,550
أمازلت تقول هذا؟

267
00:16:34,550 --> 00:16:36,260
.هذا مزعج

268
00:16:36,260 --> 00:16:39,010
.لن تعرفي مالم تُجربي

269
00:16:39,470 --> 00:16:44,190
.أتيتِ لتستمتعي بأسلوب حياتنا اليومية الهادئة

270
00:16:44,560 --> 00:16:49,190
.أن لم يكن الامر هكذا، فلا يمكننا الاستمتاع بموعدنا

271
00:16:49,940 --> 00:16:52,030
...لكن... هذا ليس

272
00:16:52,340 --> 00:16:53,950
.هذا محتمل، لذلك أعطيني الفرصة

273
00:16:55,740 --> 00:16:59,160
،يجب أن تعيشي بقية حياتك تُكفرين عن ذنوبك

274
00:16:59,160 --> 00:17:02,910
،لكن كورومي، مهما أرتكبتي من أخطاء

275
00:17:02,910 --> 00:17:05,670
!هذا ليس السبب لعدم تمكني من أنقاذك

276
00:17:07,750 --> 00:17:09,170
..أنا

277
00:17:12,340 --> 00:17:13,920
,شيدو-سان

278
00:17:15,340 --> 00:17:18,140
...هل أنت حقًا

279
00:17:19,430 --> 00:17:21,220
.هذا غير مُجدي

280
00:17:21,220 --> 00:17:24,060
.لا يمكن أن أضُلل بكلماته

281
00:17:25,850 --> 00:17:27,020
...كورومي

282
00:17:27,020 --> 00:17:28,690
...أنا... انا

283
00:17:28,690 --> 00:17:30,900
.حسنًا. حسنًا. فهمت

284
00:17:30,900 --> 00:17:32,190
.عودي الى النوم

285
00:17:37,740 --> 00:17:38,700
.يا ألهي

286
00:17:40,080 --> 00:17:42,700
كورومي، لماذا؟

287
00:17:42,700 --> 00:17:46,830
.أعتقد انني كُنت ساذجة جدًا عندما كنت شابة

288
00:17:49,960 --> 00:17:52,960
.أنها مسألة وقت حتى نضع حدًا لهذه المهزلة

289
00:17:57,760 --> 00:17:58,220
!مانا

290
00:17:59,510 --> 00:18:00,350
.أجل

291
00:18:00,350 --> 00:18:01,970
.يبدو أنني أتيت بالوقت المناسب مُجددُا

292
00:18:04,220 --> 00:18:06,480
.رائعة كعادتكِ

293
00:18:06,480 --> 00:18:10,690
.لمجرد تفكري أنك قطعتي ذراعي بهذا الشكل

294
00:18:11,520 --> 00:18:17,490
.على أية حال، لا يمكنني الحصول على كل المرح بقتلك

295
00:18:17,990 --> 00:18:20,490
!تعال يا زافكيل

296
00:18:25,580 --> 00:18:26,870
.داليت

297
00:18:39,760 --> 00:18:41,760
.هذه قدرة إعادة مثيرة

298
00:18:42,890 --> 00:18:44,810
.هذا ليس كل شيء

299
00:18:44,810 --> 00:18:47,180
.لقد أعدت الوقت فقط

300
00:18:47,180 --> 00:18:49,440
.هلآ بدأنا

301
00:18:49,440 --> 00:18:51,100
.لا بأس بالنسبة لي

302
00:18:51,100 --> 00:18:53,190
.عليّ قتلك كالعادة

303
00:18:55,570 --> 00:18:58,190
ألا تزالين لا تفهمين؟

304
00:18:59,610 --> 00:19:04,200
.لا مجال لقتلي على الأطلاق

305
00:19:04,200 --> 00:19:06,700
!سأقطعك من الحنجرة

306
00:19:07,200 --> 00:19:08,250
!ألف

307
00:19:12,170 --> 00:19:12,710
!مانا

308
00:19:16,550 --> 00:19:17,260
.زاين

309
00:19:20,380 --> 00:19:21,640
!هذا بلا فائدة

310
00:19:21,640 --> 00:19:22,390
!مانا

311
00:19:28,430 --> 00:19:29,560
.كورومي

312
00:19:30,390 --> 00:19:31,390
!مانا

313
00:19:31,390 --> 00:19:33,310
.ني-ساما

314
00:19:33,310 --> 00:19:35,150
.أهرب رجاءًا

315
00:19:35,150 --> 00:19:36,400
!شيدو

316
00:19:36,900 --> 00:19:37,900
!أنتما

317
00:19:38,200 --> 00:19:40,400
.يا ألهي، يبدو أن الجميع هنا

318
00:19:40,400 --> 00:19:43,820
!كيف لكِ الهروب في منتصف معركتنا؟

319
00:19:43,820 --> 00:19:45,660
.لن أسمح لكِ بالهرب مُجددً

320
00:19:46,080 --> 00:19:48,580
!يا ألهي. كم هذا مُخيف

321
00:19:48,580 --> 00:19:52,670
،هناك الكثير من يحاولن مُهاجمة فتاة صغيرة مثلي

322
00:19:53,120 --> 00:19:56,920
.لكني جاده اليوم

323
00:19:58,550 --> 00:20:01,300
ألسنا جاديّن اليوم؟

324
00:20:02,220 --> 00:20:03,680
ماذا تعتقدون؟

325
00:20:03,130 --> 00:20:04,800
ما هذا بحق الجحيم؟

326
00:20:03,680 --> 00:20:04,800
!هذا ممتع

327
00:20:04,800 --> 00:20:05,930
!لنبدأ اللعب

328
00:20:04,800 --> 00:20:06,890
.هذا هو ماضيّ

329
00:20:06,890 --> 00:20:08,680
.أنظروا الى تاريخي

330
00:20:08,680 --> 00:20:12,440
.هؤلاء كلهم من اوقات مختلفة

331
00:20:13,730 --> 00:20:17,440
هل فهمتي لماذا لا يمكنك قتلي؟

332
00:20:17,980 --> 00:20:19,440
!لا فكرت لدي ماذا يحدث هنا

333
00:20:19,900 --> 00:20:21,950
.الا، دعونا نضح حدًا لهذا

334
00:20:27,830 --> 00:20:30,200
...كل العقبات أزيحت عن طريقنا

335
00:20:30,200 --> 00:20:34,040
،لحظة، أحتاج لأضع يأسًا في قلبك

336
00:20:34,040 --> 00:20:37,210
.لكي لا تحاول أقناعي مُجددًا

337
00:20:38,380 --> 00:20:39,710
!مُحال

338
00:20:41,840 --> 00:20:45,720
.من المؤكد أن العديد من الناس سيموتون الان

339
00:20:45,720 --> 00:20:48,720
!توقفي

340
00:21:14,330 --> 00:21:15,750
ما كان هذا؟

341
00:21:16,170 --> 00:21:17,710
ألا تعلمين؟

342
00:21:17,710 --> 00:21:23,260
.يمكن أن تبيد الزلزال الفضائي أن ضربته مع هزّة مقدارها مماثل قبل أن يبدأ

343
00:21:30,720 --> 00:21:33,020
...هـ -هذا

344
00:21:33,640 --> 00:21:35,520
كوتوري؟

345
00:21:37,600 --> 00:21:40,270
.أحتاج أن أرجع قوتي لفترة يا شيدو

346
00:21:43,740 --> 00:21:46,110
!أحترق يا كاميل

347
00:21:53,330 --> 00:21:57,290
.الان، هلآ بدأنا بموعدنا