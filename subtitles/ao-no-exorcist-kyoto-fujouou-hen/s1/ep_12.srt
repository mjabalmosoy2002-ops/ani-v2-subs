1
00:00:04,210 --> 00:00:06,210
!حسناً، إذهبوا-
!نحتاجكم هُنا-

2
00:01:59,160 --> 00:02:00,990
!لَقد عُدتّ

3
00:02:00,990 --> 00:02:01,830
!أبي

4
00:02:01,830 --> 00:02:02,990
!تاتسوما

5
00:02:03,750 --> 00:02:07,080
!لا تقلَقي، أنا بخير
!لَستُ بكامل وَعيي بسبب خسارة الدّم، هذا كلّ شيء

6
00:02:07,500 --> 00:02:08,880
...تاتسوما

7
00:02:09,670 --> 00:02:10,670
...أنت

8
00:02:12,250 --> 00:02:16,170
!لَم تُخبرني بأنّ هذا سيحصل
!أيّها الغبيّ

9
00:02:16,170 --> 00:02:19,930
!أوو! توراكو، هذا مُؤلِم

10
00:02:21,850 --> 00:02:24,560
!يُقال بأنّ فريق قِتال الملِك المُلوّث قد عاد

11
00:02:24,810 --> 00:02:26,810
أتسائل كيف جرَت الأُمور؟

12
00:02:44,160 --> 00:02:46,250
!ماذا تفعلين؟ إبقي في الفِراش

13
00:02:46,410 --> 00:02:47,750
...أيّها القِرد

14
00:02:53,250 --> 00:02:55,170
.سأُعطيكِ الأخبار الجيّدة أوّلاً

15
00:02:55,800 --> 00:02:57,340
.لَقد هزمنا الملِك المُلوّث

16
00:02:58,880 --> 00:03:00,760
.سيّدنا و البقيّة بخير

17
00:03:04,220 --> 00:03:07,060
.كلّ شيءٍ بخير، لذا لا تبدي بائسةً هكذا

18
00:03:33,500 --> 00:03:34,670
كورو؟

19
00:03:36,590 --> 00:03:39,880
هل هذا نُزل عائلة سوغورو؟

20
00:03:40,760 --> 00:03:42,970
.يا رجل، الجوّ حارّ

21
00:03:54,190 --> 00:03:56,110
...أوه، رين

22
00:03:57,150 --> 00:03:59,070
لَقد استيقظت، هاه؟

23
00:03:59,400 --> 00:04:01,110
.أنا سعيدة

24
00:04:01,110 --> 00:04:06,330
لماذا تـ-تنامين هُنا؟
هل تأذّيتِ؟

25
00:04:06,740 --> 00:04:08,290
.كلّا، أنا بخير

26
00:04:08,290 --> 00:04:14,540
،أتيتُ إلى هُنا فقط للحُصول على مُغذٍّ وريديّ
.لكنّني غفوتُ بينما كنتُ أنظر إلى وَجهك

27
00:04:15,250 --> 00:04:17,840
.رين، قُمتَ بعملٍ رائع

28
00:04:18,000 --> 00:04:20,630
.قال سوغورو و الآخرون بأنّكَ أنقذتنا حقّاً

29
00:04:21,050 --> 00:04:24,930
.نعم... لأكون صادقاً، أصبح الوَضع خطِراً جدّاً نوعاً ما

30
00:04:25,180 --> 00:04:27,510
.لكن بفضل الجّميع، أصبح كلّ شيءٍ بخير

31
00:04:29,390 --> 00:04:32,730
.و-و تذكّرتُ أيضاً ما أخبرتِني به

32
00:04:33,900 --> 00:04:36,690
.لَقد شجّعني حقّاً

33
00:04:37,770 --> 00:04:39,650
.شُـ-شُكراً

34
00:04:39,900 --> 00:04:40,820
حقّاً؟

35
00:04:41,240 --> 00:04:43,410
هل ساعدتّك؟

36
00:04:45,450 --> 00:04:48,280
.نعم، بالتّأكيد فعلتِ
.ساعدتّني كثيراً

37
00:04:51,410 --> 00:04:52,830
!أنا سعيدةٌ جدّاً

38
00:04:53,670 --> 00:04:54,210
!رين

39
00:04:55,460 --> 00:04:56,630
!هـ-هاي

40
00:04:57,130 --> 00:04:58,710
.هاي، إسمع

41
00:04:59,380 --> 00:05:00,340
...أنا

42
00:05:01,840 --> 00:05:05,260
،من الآن فصاعداً، مهما سيحصل

43
00:05:06,890 --> 00:05:09,180
!سأكون صديقتك

44
00:05:10,890 --> 00:05:14,690
سنكون صديقان إلى الأبد، حسناً؟

45
00:05:15,980 --> 00:05:17,020
...إلى الأبد

46
00:05:18,730 --> 00:05:21,650
!لَقد قُلتها! لَقد قُلتها في الوَاقع

47
00:05:22,280 --> 00:05:25,070
هل وَضعتني للتّوّ بمنطقة الصّديق إلى الأبد الآن؟

48
00:05:26,030 --> 00:05:28,740
...لـ-لماذا أنتِ

49
00:05:31,080 --> 00:05:32,000
شيما؟

50
00:05:34,120 --> 00:05:36,790
!أعتذر! لَم أتمكّن من كبح نفسي أكثر

51
00:05:36,790 --> 00:05:39,170
ما-ماذا تفعل هُنا؟

52
00:05:39,170 --> 00:05:42,090
.حسناً، لَم أرغب بالعودة إلى منزل وَالِداي

53
00:05:42,090 --> 00:05:44,130
،قالوا بأنّه لَم يكن يُوجد مكانٌ لنا نحن التّلاميذ

54
00:05:44,130 --> 00:05:46,510
.لذا وَضعونا هُنا في غُرفة المُدير

55
00:05:46,930 --> 00:05:47,890
منذ متى؟

56
00:05:47,890 --> 00:05:50,060
.لَقد سمعتُ كلّ كلِمة

57
00:05:50,810 --> 00:05:52,850
.أنا هُنا أيضاً كما تعلمون

58
00:05:52,850 --> 00:05:56,600
إيزومو؟ و المُتكلّم من بطنه؟
أنتُما هُنا أيضاً؟

59
00:05:56,600 --> 00:06:01,150
.لبون و كونيكو غُرفتيهما الخاصّة، لذا يرتاحان هناك

60
00:06:01,440 --> 00:06:05,030
.أُقدّم لكَ تعاطفي، أعني هذا

61
00:06:05,700 --> 00:06:07,360
.أشعر بألَمك

62
00:06:08,990 --> 00:06:12,410
!أوه، صحيح
،سنعود إلى طوكيو بعد يومين

63
00:06:12,410 --> 00:06:15,870
!و تقول كيريغاكوري سينساي بأنّه يُمكننا أخذ الغد عُطلة

64
00:06:16,120 --> 00:06:17,000
...لذا إن أردتّ

65
00:06:20,630 --> 00:06:25,170
!يا إلهي
!ياله من إنجازٍ عظيم، أيّها المُدير شيما

66
00:06:26,050 --> 00:06:29,760
،لَيس إهمالكَ فقط ما قاد إلى هذه المُشكلة

67
00:06:29,760 --> 00:06:33,890
!أمرٌ آخر أخّرني عن القُدوم، لذا أعتذر منك

68
00:06:34,720 --> 00:06:36,730
مع ذلك، يُمكنني القول دون شكٍّ

69
00:06:36,730 --> 00:06:41,480
.بأنّه حتّى فيلق ملائكة بلادين لَم يكونوا ليتعاملوا مع هذا الوَضع بشكلٍ أفضل

70
00:06:42,020 --> 00:06:47,280
.كلّا، قاتلنا فقط بينما انتظرنا وُصول الدّعم من الفاتيكان

71
00:06:47,490 --> 00:06:49,700
.النّصر كان بفضل ذلك الصّبيّ فقط

72
00:06:49,910 --> 00:06:51,830
...بشأن هذا

73
00:06:51,830 --> 00:06:54,490
،إن وَصلكَ استدعاءٌ من الفاتيكان

74
00:06:54,490 --> 00:06:58,790
.أرغب منكَ بأن تظهر أمامهم و تُقدّم شهادةً بهذا الأمر

75
00:06:59,170 --> 00:07:01,460
.نعم، بالتّأكيد

76
00:07:01,630 --> 00:07:04,630
.سأقول الحقيقة فقط

77
00:07:06,260 --> 00:07:08,510
.إن كان هذا كلّ شيء، يجب أن أُغادر

78
00:07:08,760 --> 00:07:10,470
.شُكراً على كلّ عملكَ الجادّ

79
00:07:11,470 --> 00:07:15,220
.أيّتها القائدة كيريغاكوري، يُمكنكِ العودة و الحُصول على بعض الرّاحة

80
00:07:17,680 --> 00:07:20,770
.نحن وَحدنا أخيراً

81
00:07:20,770 --> 00:07:21,940
.أوه، يا إلهي

82
00:07:23,730 --> 00:07:26,610
.كما أذكر، أنتِ نينجا يابانيّة

83
00:07:26,610 --> 00:07:29,990
من سُلالة كيريغاكوري، أُسلوب كونويتشي، صحيح؟

84
00:07:29,990 --> 00:07:32,200
هيّا الآن، هل ترغب بمُشاركتي؟

85
00:07:32,200 --> 00:07:37,040
.أخشى بأنّني بعد أن أفقد وَعيي من الثّمالة، ستقطعين رأسي

86
00:07:38,040 --> 00:07:41,120
!لَن أمرّ بكلّ هذه المتاعب أبداً

87
00:07:47,340 --> 00:07:51,430
.نايهوس، أمايمون
.و الآن الملِك المُلوّث

88
00:07:51,720 --> 00:07:54,800
جميعهم جُزءٌ من مُخطّطٍ لك؟

89
00:07:56,560 --> 00:07:58,350
.ياله من مَشهدٍ رائع

90
00:07:59,270 --> 00:08:03,020
.و اختياركَ للتّلاميذ يبدو مُتعمّداً أيضاً

91
00:08:03,020 --> 00:08:03,980
.و بالنّسبة لي

92
00:08:04,360 --> 00:08:09,360
.و أُراهن على أنّكَ أدخلتَ تاكارا مُتعمّداً إلى المدرسة لترى ماذا سيفعل

93
00:08:10,860 --> 00:08:13,070
لماذا ستستخدم رين؟

94
00:08:13,870 --> 00:08:16,370
هل تسير خُطّتكَ تلك بسلاسة؟ هل تفعل؟

95
00:08:16,790 --> 00:08:18,040
.أنا مُتفاجئ

96
00:08:18,700 --> 00:08:22,580
.ظننتكِ كنتِ امرأةً لا تتعلّق بشيء

97
00:08:23,460 --> 00:08:27,340
هل أنتِ بهذا القلَق بشأن ما سيحصل لرين أوكومورا؟

98
00:08:27,800 --> 00:08:29,960
.هذه أنا أقوم بعمَلي

99
00:08:30,670 --> 00:08:33,720
ذكّريني، كم عُمركِ؟

100
00:08:34,550 --> 00:08:37,260
.لا تكوني مُتهوّرةً جدّاً بحياتك

101
00:08:37,560 --> 00:08:40,180
سيكون من المُؤسف إن كانت آنسةٌ بجمالكِ

102
00:08:40,520 --> 00:08:42,140
.ستموت بهذا العُمر الصّغير

103
00:08:49,230 --> 00:08:50,740
.أنا أُراقبك

104
00:08:54,660 --> 00:08:56,870
.يالها من امرأةٍ ساحِرة

105
00:08:59,160 --> 00:09:01,960
ما الذي يُخطّط له ذلك المُحتال؟

106
00:09:06,130 --> 00:09:08,130
.لَن يتمّ إعدام رين على الأرجح

107
00:09:08,880 --> 00:09:13,880
.و حتّى لَو تمّ إقرار أمر الإعدام، سيحميه ميفيستو بالتّأكيد

108
00:09:15,220 --> 00:09:19,850
.لأنّه يبدو بأنّ لَديه مُخطّطاً كبيراً يشمل رين

109
00:09:20,470 --> 00:09:23,890
.لذا يُمكنكَ الإسترخاء للوَقت الحاليّ، يوكيو

110
00:09:34,780 --> 00:09:36,530
.يجب أن أكتب تقريري

111
00:09:47,920 --> 00:09:49,040
هل أيقظتُك؟

112
00:09:51,000 --> 00:09:52,590
...ملابسك

113
00:09:52,590 --> 00:09:55,800
ألَم تنم منذ البارحة؟

114
00:09:56,260 --> 00:09:57,140
.نعم

115
00:10:00,760 --> 00:10:02,680
!نَم في فِراشٍ حقيقيّ

116
00:10:03,770 --> 00:10:06,980
.يا إلهي، أنتَ قذرٌ بأغرب الطّرق

117
00:10:09,770 --> 00:10:12,780
.أنتَ مُرهقٌ لأنّكَ تقلَق طوال الوَقت

118
00:10:12,780 --> 00:10:13,860
.إرتح قليلاً

119
00:10:15,450 --> 00:10:16,610
،أخي

120
00:10:17,070 --> 00:10:18,990
،لَديّ ما أرغب بإخباركَ به

121
00:10:19,620 --> 00:10:20,830
.لذا لا تهرب

122
00:10:24,250 --> 00:10:25,750
ماذا الآن؟

123
00:10:49,650 --> 00:10:51,610
.لَقد هُزِم الملِك المُلوّث

124
00:10:52,520 --> 00:10:56,900
!بمعنىً آخر، لا يُوجد ما يُبقي الجّميع في طائفة الميودا بعد الآن

125
00:10:57,110 --> 00:11:01,320
!عليّ أن أجعل أبي يقف بقوّةٍ كرئيس الكهنة و يُوَحّد أتباع الميودا

126
00:11:02,620 --> 00:11:04,580
!بون، صباح الخير

127
00:11:04,580 --> 00:11:05,540
.صباح الخير

128
00:11:10,830 --> 00:11:13,840
ما الأمر، أيّها المُسنّ؟-
!ساعدوني، إنّه جانح-

129
00:11:14,000 --> 00:11:15,380
ماذا تفعل؟

130
00:11:15,380 --> 00:11:17,380
.هاه؟ أنا أُنظّف

131
00:11:17,380 --> 00:11:18,510
!أعني ملابسك

132
00:11:19,220 --> 00:11:23,220
،أوه! لَيس لَديّ ما يُجبرني على البقاء في المَعبد بعد الآن

133
00:11:23,220 --> 00:11:27,890
!لذا فكّرتُ بالعمل هُنا في نُزل تورايا لمُساعدة توراكو

134
00:11:29,060 --> 00:11:30,650
ماذا تقول؟

135
00:11:30,650 --> 00:11:31,810
.ريوجي

136
00:11:33,690 --> 00:11:37,360
!ها أنتَ ذا، تاتسوما ساما! بون، أنتَ أيضاً
!أرجوكما تعالا معي

137
00:11:43,910 --> 00:11:47,200
!و هكذا، قرّرتُ أن أتزوّج من ماموشي

138
00:11:49,040 --> 00:11:52,670
.كنتُ أُفكّر بالإستقرار بالفِعل، لذا فالآن هو الوَقت المِثاليّ

139
00:11:52,670 --> 00:11:57,260
!كـ-كيف تجرؤ على التّحدّث عنّي
!لَم أُوَافق على أيّ شيء

140
00:11:57,260 --> 00:12:01,010
تُوَافقين؟
.إنّها الخُطوة الطّبيعيّة التّالية بعد ما حصل البارحة

141
00:12:02,140 --> 00:12:04,760
!توَقّف عن هذا
!لا-لا تتحدّث عن مثل تلك الأُمور التّافهة

142
00:12:05,100 --> 00:12:07,270
!سأقتلك! سأقتلك

143
00:12:08,640 --> 00:12:11,810
!اللّعنة عليك، أيّها القِرد
ماذا فعلتَ بأُختنا؟

144
00:12:12,020 --> 00:12:16,020
!أخبرني بأنّ هذا لَيس صحيحاً، جوزو
!لَيس تلك الفتاة النّحيلة الأفعى

145
00:12:16,020 --> 00:12:20,150
!ظننتكَ ستتزوّج جميلةً شقراء بجسدٍ رائع

146
00:12:20,450 --> 00:12:22,450
ماذا قُلت؟
!يا قِرد شيما المُنحرف

147
00:12:22,450 --> 00:12:24,030
!لا يُسمح لأحدٍ بالتّحدّث عن أُختنا بالسّوء

148
00:12:24,030 --> 00:12:27,080
من تدعين بالقِرد المُنحرف؟-
ماذا يحصل هُنا؟-

149
00:12:28,410 --> 00:12:29,790
!هُدوء

150
00:12:32,620 --> 00:12:34,540
...جـ-جوزو

151
00:12:36,710 --> 00:12:40,220
.يبدو لي بأنّ ماموشي غير مُوَافقة

152
00:12:40,220 --> 00:12:43,390
رُبّما عليكما التّحدّث بشأن هذا أكثر قليلاً؟

153
00:12:43,390 --> 00:12:45,600
.هذا أمرٌ مُهمٌّ بعد كلّ شيء

154
00:12:45,600 --> 00:12:49,270
.أتّفق معك، لكن لا أظنّ بأنّ الحديث سيُغيّر رأيها

155
00:12:50,230 --> 00:12:52,940
!بالفِعل! لَن تتزوّج أُختنا شخصاً مثلكَ أبداً

156
00:12:54,150 --> 00:12:55,060
.ماموشي

157
00:12:56,360 --> 00:12:59,530
.أنا جادٌّ بشأن الزّواج منكِ
هل تُعارضين هذا حقّاً؟

158
00:13:00,780 --> 00:13:05,490
.سأُعاقَب
.لَن يُسمح لي بالزّواج

159
00:13:05,870 --> 00:13:07,620
!هذا أفضل إذاً

160
00:13:07,620 --> 00:13:10,500
!فكّري فقط بالزّواج بي كعِقابٍ لكِ

161
00:13:10,500 --> 00:13:12,540
.هكذا سيكون الأمر

162
00:13:13,750 --> 00:13:15,880
!لَستُ غبيّةً جدّاً مثلك

163
00:13:16,790 --> 00:13:21,590
...أنا... لَن
.أُفكّر بهذا كعِقاب

164
00:13:22,090 --> 00:13:23,880
!أُختي الكُبرى-
!أُختي الكُبرى-

165
00:13:26,430 --> 00:13:27,510
...جوزو

166
00:13:27,720 --> 00:13:28,300
سيّدي؟

167
00:13:28,970 --> 00:13:31,980
،لَن تُجرّد ماموشي من مرتبة المايستر خاصّتها فقط بسبب هذا

168
00:13:31,980 --> 00:13:33,770
.طردُها مُؤكّدٌ أيضاً

169
00:13:34,230 --> 00:13:36,730
.علاوةً على هذا، عينها اليُمنى لَن تُشفى تماماً أبداً

170
00:13:37,230 --> 00:13:40,320
هل ستقبل بها كزوجةٍ لكَ مع هذا؟

171
00:13:41,230 --> 00:13:42,070
.نعم

172
00:13:43,450 --> 00:13:45,740
...أطلُب منكَ بشكلٍ رسميّ، أوابامي

173
00:13:46,950 --> 00:13:48,660
!أعطِني يَد ماموشي للزّواج

174
00:13:52,370 --> 00:13:55,330
!أرجوكَ اعتني جيّداً بابنتي الصّغيرة-
!كان ذلك سريعاً-

175
00:13:55,960 --> 00:13:57,330
!شُكراً جزيلاً لك

176
00:13:57,330 --> 00:13:59,250
...إنتظر، لَم أقبل

177
00:14:02,510 --> 00:14:05,220
!أوه، ياله من يومٍ سعيد

178
00:14:05,220 --> 00:14:08,470
.جوزو رجلٌ حقيقيٌّ بالتّأكيد

179
00:14:08,930 --> 00:14:10,060
هل ترى؟

180
00:14:10,260 --> 00:14:14,850
.حتّى لَو حاولتَ فِعل كلّ شيءٍ بنفسك، سيقوم الآخرون بخُططهم الخاصّة

181
00:14:15,020 --> 00:14:16,230
.أُترك الأُمور كما هي فقط

182
00:14:19,560 --> 00:14:22,030
!هذا بالضّبط ما لَم تفعله لأكثر من عَقد

183
00:14:22,230 --> 00:14:23,990
لماذا لَم تترك الأُمور كما هي؟

184
00:14:26,400 --> 00:14:28,490
.لأنّكَ كنتَ مُهمّاً

185
00:14:32,700 --> 00:14:35,620
أ-ألَن تتلو السّوترا بعد الآن؟

186
00:14:37,920 --> 00:14:41,590
.لا تحتاجني لأُغنّي لكَ التّهويدات بعد الآن

187
00:14:46,050 --> 00:14:49,760
هواه! سيتزوّج جوزو ماموشي؟

188
00:14:49,760 --> 00:14:53,010
.إنّهما عائلةٌ تقريباً! هذا مُقرف

189
00:14:53,010 --> 00:14:54,060
شيما؟

190
00:14:55,230 --> 00:14:57,640
!بون! كونيكو! كنتُ أبحث عنكما

191
00:14:58,060 --> 00:14:59,400
...ها هو الأمر

192
00:15:02,270 --> 00:15:05,940
تُريدون أيّها الرّفاق المواقع الجّاذبة للسّيّاح، صحيح؟
هل نبدأ بمَعبد كينكاكوجي إذاً؟

193
00:15:05,940 --> 00:15:08,410
عن ماذا تتحدّث، شيما؟

194
00:15:08,410 --> 00:15:11,320
!يجب أن نبدأ بمَعبد توجي بما أنّه الأقرب

195
00:15:11,320 --> 00:15:14,910
!لَن نتمكّن من زيارة كلّ الأماكن إلّا إن خطّطنا طريق ذهابنا

196
00:15:14,910 --> 00:15:15,950
.حسناً

197
00:15:15,950 --> 00:15:19,170
!إن كان هناك أيّ شيءٍ آخر ترغبون برُؤيته، أعلِموني الآن

198
00:15:19,460 --> 00:15:24,170
!أ-أرغب بتجربة الحلويّات المَحلّيّة
!أشياءٌ مثل أنميتسو و كوزوكيري

199
00:15:24,170 --> 00:15:27,800
.أردتّ دائماً زيارة ضريح فوشيمي إيناري

200
00:15:27,800 --> 00:15:29,260
!عرّفني ببعض فتيات المايكو

201
00:15:29,260 --> 00:15:30,470
!أووه! أووه

202
00:15:30,680 --> 00:15:33,810
!أُريد الذّهاب إلى بُرج كيوتو

203
00:15:33,810 --> 00:15:34,810
...ها نحن ذا ثانيةً

204
00:15:35,600 --> 00:15:39,810
بُرج كيوتو؟
.لكن يُوجد في كيوتو الكثير من الأماكن الأُخرى لرُؤيتها

205
00:15:40,020 --> 00:15:41,350
.كما أخبرتُك

206
00:15:41,520 --> 00:15:45,150
!أوو، أرجوك! رغبتُ بهذا بشدّةٍ قبل وُصولنا إلى هُنا حتّى

207
00:15:45,150 --> 00:15:48,900
.إنّه الطّلَب الأكثر إخلاصاً من إبن ساتان، لذا سايره

208
00:15:49,280 --> 00:15:50,780
.سيحرقكَ تماماً

209
00:15:50,780 --> 00:15:52,870
أمازلتَ تظنّني هكذا؟

210
00:15:53,070 --> 00:15:54,490
.حسناً

211
00:15:56,040 --> 00:15:59,210
.ما يرغب به إبن ساتان، سيتحقّق

212
00:15:59,210 --> 00:16:01,040
أنتَ أيضاً، كونيكومارو؟

213
00:16:40,250 --> 00:16:42,620
!أُريد هذا بشدّة

214
00:16:42,830 --> 00:16:46,170
!لكنّه غالٍ، لذا سآخذ هذا

215
00:16:51,550 --> 00:16:52,380
.يا رِفاق

216
00:16:52,760 --> 00:16:56,390
.إ-إسمعوا، أُريد أن أطلُب معروفاً

217
00:16:57,560 --> 00:17:01,390
...أعلَم بأنّني لا أملك الحقّ لأطلُب هذا منكم جميعاً

218
00:17:02,230 --> 00:17:05,060
لكن هل تُمانعون التقاط صورةٍ معي هُنا؟

219
00:17:05,610 --> 00:17:10,570
.مُزعج. لكن لا أُريد أن يُشعلنا إبن ساتان لأنّنا رفضنا

220
00:17:10,570 --> 00:17:13,700
.إن كان أمراً من إبن ساتان، لا نملك خياراً آخر

221
00:17:13,700 --> 00:17:17,620
.حاولتَ أن تبدو مُؤدّباً بقولها، لكنّه بدا كتهديدٍ بالنّسبة لي بالتّأكيد

222
00:17:17,620 --> 00:17:20,290
.ما يرغب به إبن ساتان، سيتحقّق

223
00:17:20,290 --> 00:17:22,960
أمازلتَ تقوم بتلك المزحة؟
!أنتَ لئيم

224
00:17:23,210 --> 00:17:28,210
!مُستحيل، يجب أن يقولها
!إنّها مزحةٌ أروع من أن تُفوّت

225
00:17:29,250 --> 00:17:33,380
.لا تحتاج للتّوسّل إلينا لأخذ إذنٍ لالتقاط صورةٍ صغيرة

226
00:17:37,930 --> 00:17:39,470
هل الجّميع مُستعدّون؟

227
00:17:40,140 --> 00:17:41,680
حسناً، هل الجّميع في مَواقعهم؟

228
00:17:41,680 --> 00:17:42,480
!عُلِم

229
00:17:42,480 --> 00:17:43,520
.حسناً

230
00:17:44,770 --> 00:17:48,020
!"ها نحن ذا إذاً! قولوا "تاواوا

231
00:17:55,490 --> 00:17:58,950
هاي، إنتظروا لَحظة! هل هذه "ساتان"؟

232
00:18:09,090 --> 00:18:11,670
!هاي، يوكيو! إلى هُنا

233
00:18:12,340 --> 00:18:13,880
لماذا هُنا من بين جميع الأماكن؟

234
00:18:16,220 --> 00:18:19,850
لِمَ لا؟
.رغبتُ فقط ببعض الوَقت الخاصّ مع أخي

235
00:18:24,180 --> 00:18:25,020
.يوكيو

236
00:18:25,980 --> 00:18:28,560
.سأُصبح مُعوّذاً

237
00:18:28,900 --> 00:18:30,480
.كإبن ساتان

238
00:18:32,940 --> 00:18:34,400
.لا أُوَافق

239
00:18:35,320 --> 00:18:40,030
كم حياةً قلبتها رأساً على عقبٍ عبر الأعوام بسبب قوّتك؟

240
00:18:41,330 --> 00:18:44,500
.تشعر بالغُرور لأنّكَ هزمتَ الملِك المُلوّث

241
00:18:45,250 --> 00:18:47,000
.أندم على ما فعلت

242
00:18:47,750 --> 00:18:51,000
.بأنّني أجبرتكَ على استخدام قوّة ساتان لفِعل هذا

243
00:18:51,800 --> 00:18:54,960
.تُصبح إبن ساتان أكثر و أكثر مع مُرور كلّ يوم

244
00:18:55,510 --> 00:18:57,800
ماذا ستكون نتيجة هذا؟

245
00:18:58,090 --> 00:19:01,890
.حتّى أتأكّد من أنّ هذا لَن يُشكّل تهديداً، لَن أتمكّن من الإسترخاء

246
00:19:01,890 --> 00:19:03,220
.لا يُمكنني المُوَافقة على هذا

247
00:19:04,100 --> 00:19:07,350
!قطعتُ وَعداً لأبي بأنّني سأحميك

248
00:19:14,440 --> 00:19:17,030
.حسناً إذاً. إفعل هذا

249
00:19:17,990 --> 00:19:20,240
.لا أقول بأنّني أُريدكَ أن تُغيّر نظرتكَ للأُمور

250
00:19:20,780 --> 00:19:24,290
.أُراهن على أنّنا كِلانا مُخطئان و كِلانا مُحقّان

251
00:19:25,040 --> 00:19:27,500
.لكنّنا ندعم بعضنا دائماً

252
00:19:28,830 --> 00:19:29,750
لماذا؟

253
00:19:30,710 --> 00:19:31,960
.سُحقاً

254
00:19:32,670 --> 00:19:34,800
هيّا الآن، نحن أخوان، صحيح؟

255
00:19:36,300 --> 00:19:38,170
لماذا لا يملك أيّ شُكوك؟

256
00:19:39,300 --> 00:19:40,390
!لا يُمكنه الإنتصار

257
00:19:48,480 --> 00:19:49,640
...أخبرني، يوكيو

258
00:19:51,980 --> 00:19:56,360
قاتلتَ إلى جانب أبي، صحيح؟

259
00:19:57,240 --> 00:20:01,820
.أغار منك
.أتمنّى لَو أمكنني القتال إلى جانبه

260
00:20:02,870 --> 00:20:04,740
.أتمنّى لَو أمكنني جعله يُعلّمني بعض الأُمور

261
00:20:06,870 --> 00:20:09,330
أخبرني ببعض القصص القتاليّة عن أبي أحياناً، حسناً؟

262
00:20:11,620 --> 00:20:12,830
.بالتّأكيد، سأفعل

263
00:20:15,000 --> 00:20:17,550
.إن و عندما تُصبح مُعوّذاً

264
00:20:18,210 --> 00:20:20,680
متى ستتوَقّف عن كونكَ بهذا التّزمّت؟

265
00:20:21,760 --> 00:20:24,970
!يا رجل، أنتَ و أنا كالزّيت و الماء

266
00:20:25,390 --> 00:20:26,510
.أظنّنا كذلك

267
00:20:28,020 --> 00:20:30,980
،لكن إن أصبحتُ مُعوّذاً

268
00:20:30,980 --> 00:20:34,150
!وُجود كِلانا نُقاتل بعض الشّياطين كفريقٍ من أخوَين قد يكون رائعاً

269
00:20:34,150 --> 00:20:35,270
ألَن يكون هذا مُمتعاً؟

270
00:20:37,320 --> 00:20:39,740
.نعم... على ما أظنّ

271
00:20:39,740 --> 00:20:40,820
أعلَم هذا، صحيح؟

272
00:20:41,780 --> 00:20:44,450
.إن و عندما تُصبح مُعوّذاً

273
00:20:44,620 --> 00:20:46,830
...مـ-مرّتان بقول هذه الجّملة

274
00:20:46,990 --> 00:20:49,790
!أيّها الوَغد، تُعاملني دائماً كما لَو أنّني غبيّ

275
00:20:49,790 --> 00:20:52,080
سأتفوّق عليك، هل تسمعني؟

276
00:20:53,170 --> 00:20:55,340
أنت، تفعل؟

277
00:20:56,130 --> 00:21:00,300
.أشكّ في هذا
.لابدّ من أنّ تلك النّكات تبدو أكثر إضحاكاً و هي في عقلك

278
00:21:01,340 --> 00:21:06,260
.هاه؟ إنتظر، أشعر كما لَو أنّنا خُضنا هذه المُحادثة بالفِعل قبل فترةٍ طويلة

279
00:21:06,970 --> 00:21:10,600
!أوه، حسناً. سعيدٌ لدردشتنا الصّغيرة هذه

280
00:21:11,060 --> 00:21:13,270
!إن احتجتَ شيئاً على الإطلاق، بابي مَفتوح

281
00:21:13,900 --> 00:21:16,650
.بما أنّني أخوكَ الكبير و ما إلى ذلك

282
00:21:26,700 --> 00:21:27,780
.لَن أفعل

283
00:21:28,700 --> 00:21:29,950
حقّاً؟

284
00:21:32,250 --> 00:21:34,670
هاي، كورو! أين كنت؟

285
00:21:42,880 --> 00:21:45,140
.الشّخص الذي أكرهه هو نفسي

286
00:21:46,430 --> 00:21:49,600
.لهذا أردتّ دائماً أن أكون مثل أبي و رين

287
00:21:50,890 --> 00:21:51,730
...لهذا السّبب

288
00:21:52,600 --> 00:21:56,270
سأتفوّق عليك، هل تسمعني؟

289
00:21:56,480 --> 00:22:00,940
.لَقد أخذتَ تلك الكلمات من فمي، رين...

290
00:22:02,650 --> 00:22:03,820
!هاي، يوكيو

291
00:22:05,280 --> 00:22:06,610
!حان وَقت الرّحيل

292
00:22:18,130 --> 00:22:20,090
.هذا هو أنا الحقيقيّ