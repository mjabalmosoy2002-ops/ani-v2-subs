1
00:00:12,260 --> 00:00:15,100
.لا أذكر شيئاً من ليلة البارحة

2
00:00:15,600 --> 00:00:18,810
.كما لَو أنّني ثملتُ و فقدتّ وَعيي أو ما شابه

3
00:00:19,350 --> 00:00:23,100
هل قامت تلك المُعلّمة المجنونة بإعطائي شرابها بالخطأ؟

4
00:00:23,350 --> 00:00:25,060
.يالها من وَصيّة

5
00:00:25,230 --> 00:00:26,770
هل أنتَ بخير؟

6
00:00:26,770 --> 00:00:28,440
.نعم، أنا بخير

7
00:00:29,480 --> 00:00:32,650
هل ذهبتَ لتقديم احترامكَ لوَالِديك؟

8
00:00:33,530 --> 00:00:35,660
.نـ-نعم، ليلة البارحة

9
00:00:36,280 --> 00:00:38,240
.أوه. هذا جيّدٌ إذاً

10
00:00:38,240 --> 00:00:40,450
.حسناً، سأُقابلكَ هناك

11
00:00:40,450 --> 00:00:42,290
.بالتّأكيد. أراكَ لاحقاً

12
00:00:42,290 --> 00:00:43,120
.نعم

13
00:00:55,260 --> 00:00:57,220
!صباح الخير، أوكومورا

14
00:00:57,760 --> 00:01:00,220
!هواه، هذا شَعر نومٍ سيّء

15
00:01:01,180 --> 00:01:03,600
هل وَصلتَ إلى غُرفتكَ بخيرٍ ليلة البارحة؟

16
00:01:03,600 --> 00:01:05,060
.لا أذكر شيئاً

17
00:01:06,520 --> 00:01:10,530
!هذا لَيس مُفاجئاً
!"يا رجل، كنتُ مُحقّاً بعدم شُرب ذلك "العصير

18
00:01:11,740 --> 00:01:15,240
ماذا عنك؟ ألا بأس من حديثكَ معي كشخصٍ عاديّ؟

19
00:01:16,160 --> 00:01:17,280
.نعم

20
00:01:19,080 --> 00:01:22,330
...رين-
!ذلك الصّوت-

21
00:01:22,330 --> 00:01:24,540
!زو...

22
00:01:27,540 --> 00:01:30,130
ما كان هذا بحقّ الله، كين؟

23
00:01:30,130 --> 00:01:31,630
ماذا تعني بـ"ماذا"؟

24
00:01:32,460 --> 00:01:34,880
.كانت تلك ركلةً طائرة
هل أنتَ غبيٌّ من نوعٍ ما؟

25
00:01:35,260 --> 00:01:38,010
!أنتَ الغبيّ! غبيٌّ بالكامل

26
00:01:38,010 --> 00:01:40,760
!رينزو! من الجيّد رُؤيتكَ تبدو بخير

27
00:01:40,760 --> 00:01:42,100
!جو

28
00:01:42,470 --> 00:01:45,730
.أوه، هذا صديقي، أوكومورا

29
00:01:46,100 --> 00:01:49,480
!أوه، حقّاً؟ أنا جوزو

30
00:01:50,230 --> 00:01:51,900
.أنا أخ رينزو الكبير

31
00:01:52,820 --> 00:01:53,820
.مرحباً

32
00:01:56,030 --> 00:01:57,360
!مرحباً، كونيكو

33
00:01:58,200 --> 00:02:00,240
!تعال و انضمّ إلينا على الفطور

34
00:02:01,450 --> 00:02:04,040
.إنتهيتُ بالفِعل

35
00:02:09,170 --> 00:02:10,670
ما مُشكلته؟

36
00:02:12,090 --> 00:02:13,300
!شيما

37
00:02:15,800 --> 00:02:20,850
أمم، لماذا أنتَ وَدودٌ جدّاً مع أوكومورا؟

38
00:02:21,600 --> 00:02:24,680
!جوزو و كينزو لا يعلَمان ما هو بعد

39
00:02:24,680 --> 00:02:29,940
ماذا ستُخبرهما عندما يكتشفان بأنّه إبن ساتان؟

40
00:02:29,940 --> 00:02:34,690
ماذا سأفعل؟
.مهما سيحصل سيحصل على ما أظنّ

41
00:02:35,400 --> 00:02:38,740
لماذا لا تأخذ أيّ شيءٍ بجدّيّةٍ أبداً؟

42
00:02:39,450 --> 00:02:42,280
هل أنتَ وَاثقٌ من أنّكم لا تُفكّرون بالأُمور بشكلٍ أكثر من المُفترض؟

43
00:02:43,580 --> 00:02:46,910
.كان أكثر صُعوبةً الخُروج من طريقي لتفادي أوكومورا

44
00:02:46,910 --> 00:02:49,080
.كنتُ خائفاً قليلاً أيضاً

45
00:02:49,790 --> 00:02:53,290
.لكن الأمر مُتعبٌ جدّاً للتّفكير به فقط

46
00:02:54,170 --> 00:02:57,550
.أعني، أوكومورا شابٌّ جيّد

47
00:02:57,760 --> 00:03:00,430
.حتّى أنتَ عليكَ أن ترى هذا، كونيكو

48
00:03:02,430 --> 00:03:03,600
.أوه، صحيح

49
00:03:03,760 --> 00:03:06,560
سمعتُ بأنّه سيُعقد اجتماعٌ عامٌّ لطائفة ميودا اليوم، صحيح؟

50
00:03:07,310 --> 00:03:11,400
.يا رجل، لا أحسدكَ ككبير عائلة ميوا

51
00:03:12,190 --> 00:03:15,320
!سعيدٌ جدّاً لأنّني الإبن الخامس

52
00:03:23,120 --> 00:03:26,040
هل تعمل بالفِعل؟

53
00:03:27,870 --> 00:03:28,710
!حسناً

54
00:03:30,710 --> 00:03:32,250
!وَالِدة سوغورو

55
00:03:33,130 --> 00:03:35,170
إن كنتِ تملكين أيّ شُموعٍ إضافيّة، هل يُمكنني الحُصول عليها؟

56
00:03:35,170 --> 00:03:36,460
شُموع؟

57
00:03:36,710 --> 00:03:38,630
!بالأساس، أُريد أكبر عددٍ مُمكن

58
00:03:42,720 --> 00:03:45,060
ما سبب تأخّر أبي بحقّ الله؟

59
00:03:46,640 --> 00:03:47,470
!بون

60
00:03:48,310 --> 00:03:50,520
!سنبدأ الإجتماع العامّ

61
00:03:51,600 --> 00:03:52,980
.سأكون هناك بالحال

62
00:03:54,020 --> 00:03:57,900
ذلك الغبيّ الأصلع! لماذا لَيس هُنا؟

63
00:03:59,150 --> 00:04:01,030
ماذا يظنّ نفسه فاعلاً؟

64
00:05:39,590 --> 00:05:42,380
ألَم يصل سيّدنا إلى هُنا بعد؟

65
00:05:46,550 --> 00:05:47,510
.جميعكم

66
00:05:49,850 --> 00:05:53,850
.أشكركم لاستجابتكم لدَعوتي المُفاجئة و القُدوم إلى هُنا اليوم

67
00:05:56,230 --> 00:05:59,110
.هناك ما يجب أن أُخبركم به جميعاً

68
00:05:59,400 --> 00:06:04,990
.يبدو بأنّ سيّدنا مَشغولٌ بعملٍ مُهمٍّ و لا يُمكنه الحُضور

69
00:06:11,410 --> 00:06:16,790
.حتّى لَو كان غائباً، هذا أمرٌ مُلِحّ، لذا سأبدأ الإجتماع من دونه

70
00:06:18,290 --> 00:06:21,840
،طلَبتُ من كِبار جميع العائلات أن تحضر

71
00:06:21,840 --> 00:06:26,170
.إضافةً إلى المُتوَرّطين في الحادثة الأخيرة الخاصّة بالعين اليُمنى

72
00:06:26,930 --> 00:06:32,640
جوزو. أرجوكَ ابدأ بإخبارنا بالتّفصيل عمّا حصل ذلك اليوم في الحِفظ العميق؟

73
00:06:33,010 --> 00:06:33,850
.نعم، سيّدي

74
00:06:34,560 --> 00:06:39,810
.يومها، نار الإبتهال المُقدّسة أمام مَقعد الكاهن كانت تتصرّف بغرابة

75
00:06:40,650 --> 00:06:42,730
.لذا استدعيتُ سيّدنا

76
00:06:44,940 --> 00:06:47,780
.أعتذر بشدّةٍ على طلَبي منكَ القُدوم طوال الطّريق إلى هُنا

77
00:06:47,780 --> 00:06:51,570
.لا تُفكّر بهذا
.سعيدٌ لتقديم أيّ مُساعدةٍ بإمكاني

78
00:07:01,670 --> 00:07:03,170
.لنُلقي نَظرة

79
00:07:10,220 --> 00:07:11,180
.تاتسوما ساما

80
00:07:13,470 --> 00:07:16,850
ألا تنوي الإنضمام إلى النّظام؟

81
00:07:16,850 --> 00:07:19,190
!ماموشي! لا تُشتّتي انتباه سيّدنا

82
00:07:19,980 --> 00:07:23,900
.لا أظنّ هذا. لَن تتوَقّعي هذا أبداً، لكنّني شديد الإنشغال الآن

83
00:07:24,860 --> 00:07:27,610
.بمُهمّةٍ شديدة الأهمّيّة

84
00:07:28,610 --> 00:07:30,320
،وِفقاً لتقاليد ميودا الشّفهيّة

85
00:07:31,410 --> 00:07:35,450
،عندما قام فوكاكو، مُؤسّس طائفة ميودا، بإجبار الملِك المُلوّث على الخُضوع

86
00:07:35,740 --> 00:07:40,000
.لَم يبقى شيءٌ في هذا العالَم سوى عينه اليُمنى، التي حدّقت بحقدٍ نحو فوكاكو

87
00:07:41,250 --> 00:07:45,050
قِيل بأنّه أسّس طائفة ميودا

88
00:07:45,050 --> 00:07:47,960
!لإبقائها مَختومةً بعيداً من قِبل سُلالته

89
00:07:48,760 --> 00:07:54,260
!لذا، بالنّسبة لمن وُلِدوا في طائفة ميودا، حِماية العين اليُمنى هي قدَرُنا و وَاجبنا

90
00:07:54,260 --> 00:07:57,390
ما الذي يُمكن أن يكون بهذه الأهمّيّة لتتخلّى عن هذا الوَاجب؟

91
00:07:57,390 --> 00:07:59,390
!ماموشي! إحذري ممّا تقولين

92
00:08:00,730 --> 00:08:02,730
.كوني صبورةً معي، ماموشي

93
00:08:02,730 --> 00:08:07,070
.أخبريني فقط و سآتي بأقصى سُرعة، لذا سامحيني

94
00:08:12,700 --> 00:08:14,490
سيّدي! ماذا يحصل؟

95
00:08:16,910 --> 00:08:18,540
!جميعكم! أُهربوا

96
00:08:18,540 --> 00:08:19,370
!نعم، سيّدي

97
00:08:30,590 --> 00:08:32,260
!سأحمي أنا العين اليُمنى

98
00:08:39,930 --> 00:08:41,520
ما ذلك؟

99
00:08:42,140 --> 00:08:43,770
!عودي، ماموشي

100
00:08:49,820 --> 00:08:51,700
!جميعكم، تراجعوا

101
00:09:05,710 --> 00:09:06,540
!كلّا

102
00:09:07,500 --> 00:09:10,630
!الخِتم على العين اليُمنى يذوب

103
00:09:20,350 --> 00:09:21,220
!أبي

104
00:09:24,190 --> 00:09:34,450
...لذا الأقرب من العين اليُمنى للملِك المُلوّث كانوا بناتي الثّلاثة، و جوزو، و ياوزو، و

105
00:09:35,030 --> 00:09:40,160
.رئيس الكهنَة تاتسوما، الغائب...
.هؤلاء الستّة

106
00:09:41,290 --> 00:09:44,870
!أحضرتكم جميعاً إلى هُنا لسببٍ وَاحد

107
00:09:46,830 --> 00:09:49,380
!لإخراج الخائن من بيننا

108
00:09:54,050 --> 00:09:58,510
،على سبيل الصّدفة، هذا الرّجل، الذي يُعتقد بأنّه ساعد على سرقة العين اليُسرى

109
00:09:58,510 --> 00:10:01,010
،هو المُدير السّابق لفِرع الحِفظ العميق اليابانيّ

110
00:10:01,010 --> 00:10:03,930
.مُعوّذٌ خبيرٌ من المُستوى الثّاني، سابوروتا تودو

111
00:10:03,930 --> 00:10:05,270
،كما فهمت

112
00:10:05,560 --> 00:10:11,440
.جوزو و ماموشي، كان هذا الرّجل مُعلّمكما في مدرسة المُعوّذين

113
00:10:12,030 --> 00:10:13,900
ماذا تعني؟

114
00:10:13,900 --> 00:10:16,820
أبي! هل تشكّ بي؟

115
00:10:17,110 --> 00:10:21,490
.لا أحد آخر يملك رابطةً مُباشرةً مع تودو

116
00:10:21,490 --> 00:10:23,240
!أنتَ تمزح

117
00:10:23,240 --> 00:10:25,460
!كلّ ما فعلته هو الدّراسة تحت إشرافه

118
00:10:26,710 --> 00:10:31,710
.كما أذكر، شيما، كانت علاقتكَ جيّدةً جدّاً مع تودو

119
00:10:32,920 --> 00:10:36,220
!كانت دُروسه مُثيرةً للإهتمام، هذا كلّ شيء
!"هذا بالكاد يُدعى بـ"علاقةٍ جيّدة

120
00:10:36,470 --> 00:10:38,720
.أذكر الحقائق ببساطة

121
00:10:39,010 --> 00:10:40,890
،بتلك الحال، ماموشي

122
00:10:41,050 --> 00:10:43,890
لماذا حاولتِ الإقتراب من العين اليُمنى خِلال الهُجوم؟

123
00:10:43,890 --> 00:10:45,850
!ظننتُ أنّ العين كانت في خطَر

124
00:10:46,270 --> 00:10:49,730
لماذا قد تظنّين هذا وَقتها؟
كيف عرفتِ؟

125
00:10:50,060 --> 00:10:52,440
ما-ماذا تُحاول أن تقول؟

126
00:10:52,820 --> 00:10:54,940
!أقول بأنّ تصرّفكِ مُريب

127
00:10:56,490 --> 00:10:58,990
!أبي! عليكَ أن تُصدّقني

128
00:10:59,200 --> 00:11:01,620
!يقول شيما هذا لإبعاد الشّبهة عن نفسه

129
00:11:01,620 --> 00:11:05,410
!ماموشي! التّحقيق مازال جارياً
!إهدأي

130
00:11:08,960 --> 00:11:10,130
،عندما حصل هذا

131
00:11:10,750 --> 00:11:13,290
،عندما تأجّجت الشّعلة المُقدّسة

132
00:11:13,920 --> 00:11:15,170
...بدا تقريباً

133
00:11:16,550 --> 00:11:19,760
.بدا بأنّ تاتسوما ساما كان يُسيطر على اللّهب

134
00:11:21,720 --> 00:11:26,310
.الأكثر من هذا، كان يتلو سوترا لَم أسمعها سابقاً أبداً

135
00:11:26,520 --> 00:11:28,310
!هاي، إنّها مُحقّة

136
00:11:28,310 --> 00:11:30,480
!بدا تقريباً كما لَو كان يحثّها

137
00:11:30,730 --> 00:11:35,440
لماذا تمّ إخفاء وُجود العين اليُسرى عنّا من الأساس؟

138
00:11:35,440 --> 00:11:39,740
نعم، لابدّ من أنّ تاتسوما ساما قد عرف عنها. لماذا إذاً؟

139
00:11:39,740 --> 00:11:41,950
...بالتّأكيد لَم يكن تاتسوما ساما خلف

140
00:11:41,950 --> 00:11:43,450
!أرجوكم توَقّفوا

141
00:11:43,620 --> 00:11:46,120
!أرجوكم لا تقولوا مثل هذه السّخافات

142
00:11:46,120 --> 00:11:51,540
.كنتَ دائماً مُقرّباً من تاتسوما ساما

143
00:11:51,960 --> 00:11:56,880
إضافةً إلى هذا، ألَيس وَاقع عدم قُدومه إلى هذا التّحقيق هو الإثبات الذي نحتاجه؟

144
00:11:56,880 --> 00:11:59,380
نعم! كيف أمكنه تجاهل شيءٍ بهذه الأهمّيّة؟

145
00:12:01,130 --> 00:12:02,840
!جميعكم، إهدأوا

146
00:12:02,840 --> 00:12:04,100
من غيره يُمكن أن يكون إذاً؟

147
00:12:04,470 --> 00:12:05,310
!هذا يكفي

148
00:12:06,720 --> 00:12:08,430
.هذا لا يُوصلنا لأيّ شيء

149
00:12:08,430 --> 00:12:10,480
.سأتناقش بالأمر مع أوابامي

150
00:12:10,480 --> 00:12:14,440
لماذا لا نجتمع ثانيةً في وَقتٍ آخر بوُجود سيّدنا؟

151
00:12:15,610 --> 00:12:18,150
.لليوم، تمّ تأجيل هذا الإجتماع

152
00:12:24,200 --> 00:12:26,740
بون، هل أنتَ بخير؟

153
00:12:28,910 --> 00:12:33,960
!الجّميع مجانينٌ إن شكّوا بسيّدنا
!لا يُمكن أن يكون مُتوَرّطاً

154
00:12:33,960 --> 00:12:35,340
هل أنتَ وَاثق؟

155
00:12:36,340 --> 00:12:38,800
.إنّهم مُحقّون بالشّكّ

156
00:12:39,010 --> 00:12:41,510
ألا تُفكّر بنفس الشّيء؟

157
00:12:42,300 --> 00:12:43,720
...أ-أنا أبداً

158
00:12:43,720 --> 00:12:44,970
!كونيكومارو

159
00:12:47,430 --> 00:12:48,390
.أعتذر

160
00:12:49,520 --> 00:12:51,390
هل تُمانع بتركي وَحيداً؟

161
00:12:52,020 --> 00:12:53,060
...بون

162
00:12:54,480 --> 00:12:55,360
!آنسة مورياما

163
00:12:55,610 --> 00:12:58,860
.خُذي هذا الشاي العُشبيّ للآنسة كاميكي

164
00:12:58,860 --> 00:12:59,780
!نعم، سيّدي

165
00:13:01,110 --> 00:13:03,490
...كاميكي مُدهشةٌ جدّاً

166
00:13:03,860 --> 00:13:06,910
...عُذراً... كاميكي، هذا لأجل

167
00:13:09,870 --> 00:13:12,250
!أ-أعتذر، كـ-كاميكي

168
00:13:13,080 --> 00:13:14,580
لَم تتبلّل، صحيح؟

169
00:13:17,000 --> 00:13:18,460
،نحن نعتني بالأُمور هُنا

170
00:13:18,460 --> 00:13:21,670
لذا هل يُمكنكِ الذّهاب إلى الحديقة و التقاط بعض حشائش الهرّ لأجلي؟

171
00:13:22,010 --> 00:13:23,590
.نـ-نعم، سيّدي

172
00:13:23,970 --> 00:13:25,140
.أعتذر

173
00:13:30,600 --> 00:13:34,100
!أنا... أسوأ من كوني بِلا فائدة

174
00:13:40,610 --> 00:13:44,070
...ماذا سأفعل؟ بهذا المُعدّل، أنا

175
00:13:46,200 --> 00:13:48,120
!ني، تعال يا فتى

176
00:13:50,540 --> 00:13:51,910
...عرفتُ هذا

177
00:13:52,950 --> 00:13:55,870
!ني! إجلِب بعضاً من خليط طرد الحشرات

178
00:14:02,590 --> 00:14:05,180
.لَم يظهر ني منذ وَقتها

179
00:14:06,010 --> 00:14:08,140
...لأنّني بِلا فائدةٍ تماماً

180
00:14:09,970 --> 00:14:13,060
.كنتُ عالِقةً في عالَمي الصّغير

181
00:14:14,890 --> 00:14:17,810
ما الذي يحتجزكِ بهذه القوّة؟

182
00:14:18,230 --> 00:14:18,900
...رين، هو

183
00:14:21,320 --> 00:14:23,570
.من جرّني إلى العالَم الخارجيّ

184
00:14:27,320 --> 00:14:30,580
.و في ذلك اليوم، قصدَ إنقاذي

185
00:14:31,740 --> 00:14:34,910
...لكن على الرّغم من هذا، أنا

186
00:14:34,910 --> 00:14:35,960
.تحرّكي

187
00:14:37,170 --> 00:14:38,170
كاميكي؟

188
00:14:38,960 --> 00:14:40,750
بماذا تحلُمين أحلام اليقظة؟

189
00:14:40,750 --> 00:14:44,420
.أخذتِ الكثير من الوَقت، لذا فقد تمّ إرسالي خارجاً لالتقاط تلك الأعشاب

190
00:14:44,420 --> 00:14:45,800
.لذا ابتعدي

191
00:14:45,970 --> 00:14:47,130
!أ-أعتذر

192
00:14:51,470 --> 00:14:53,640
ما مُشكلتكِ في الآونة الأخيرة على أيّة حال؟

193
00:14:54,350 --> 00:14:57,440
!إن كان لَديكِ ما تقولينه، قوليه بصراحة

194
00:14:58,900 --> 00:14:59,980
...أنا

195
00:15:02,440 --> 00:15:04,860
.أردتّ أن أكون مُفيدةً للجّميع

196
00:15:05,900 --> 00:15:08,360
!لكن كلّ ما أفعله هو الإعاقة

197
00:15:08,360 --> 00:15:09,860
...بهذا المُعدّل

198
00:15:11,200 --> 00:15:12,950
...بهذا المُعدّل، أنا لَن

199
00:15:14,160 --> 00:15:18,750
!عندما يكون أصدقائي في مُشكلة، لَن أتمكّن من المُساعدة

200
00:15:21,670 --> 00:15:24,590
!لأنّه لا يُمكن الإعتماد عليّ

201
00:15:26,090 --> 00:15:30,140
...لهذا
...لهذا، رين و يوكي

202
00:15:30,300 --> 00:15:33,720
!لهذا لَم يُخبراني أبداً عمّا يحصل معهما

203
00:15:44,820 --> 00:15:48,610
!تبّاً-
هاي! من أخبركَ بأن تُشعل النّار في السّقف؟-

204
00:15:48,610 --> 00:15:50,740
!توَقّفي عن إزعاجي، يا ذات الصّدر الضّخم

205
00:15:52,120 --> 00:15:53,780
ماذا يفعل؟

206
00:15:56,450 --> 00:15:57,910
!هذا مُحبطٌ جدّاً

207
00:15:59,370 --> 00:16:01,420
!أُريد أن أكون قويّة

208
00:16:04,500 --> 00:16:07,460
أنتِ تُدهشيني، هل تعرفين هذا؟

209
00:16:07,920 --> 00:16:11,180
.أنتِ قويّةٌ جدّاً بالفِعل
.أو رُبّما أكثر مُرونة

210
00:16:11,970 --> 00:16:13,800
حـ-حقّاً؟

211
00:16:14,390 --> 00:16:17,850
!أنتِ مرِنةٌ و قويّة. مثل عُشبة

212
00:16:18,310 --> 00:16:19,520
عُشبة؟

213
00:16:19,520 --> 00:16:23,150
!ما-ماذا؟ إن كنتِ ستبكين ثانيةً، لا تفعلي

214
00:16:23,730 --> 00:16:26,940
!أُحبّ الأعشاب

215
00:16:29,030 --> 00:16:30,860
!شُكراً، كاميكي

216
00:16:31,450 --> 00:16:34,530
!سأُحاول بجدٍّ و أُصبح بقوّة عُشبة

217
00:16:35,280 --> 00:16:38,910
كـ-كم هذه الفتاة مرِنة؟

218
00:16:39,200 --> 00:16:41,330
.كما لَو أنّها شديدة المُرونة

219
00:16:42,960 --> 00:16:44,170
ما الخطب؟

220
00:16:45,460 --> 00:16:47,590
كاميكي، هل أنتِ بخير؟

221
00:16:48,130 --> 00:16:50,050
!لا شيء

222
00:16:59,140 --> 00:17:03,060
.يُمكنكَ أن تشتري كلّ الشّمعات في كيوتو و قد لا يكون هذا كافياً

223
00:17:03,690 --> 00:17:05,230
!إسترخي، أنا مُسيطرٌ على الأمر

224
00:17:05,230 --> 00:17:08,110
!أحتاج فقط لأن أطلُب من وَالِدة سوغورو و ستُحضر لي العدد الذي أُريده

225
00:17:08,110 --> 00:17:10,530
.أوه، من الجيّد سماع هذا

226
00:17:11,240 --> 00:17:14,360
!هاي، هذا يعني بأنّكَ تتوَقّع أنّكَ ستفشل بالتّأكيد

227
00:17:14,360 --> 00:17:16,070
!لا أفعل

228
00:17:18,540 --> 00:17:21,200
...أظنّ بأنّ هذا سيأخذ الكثير من الوَقت

229
00:17:21,580 --> 00:17:23,290
.سأشتري بعض الشّراب

230
00:17:40,060 --> 00:17:44,440
سُحقاً، ثانيةً؟-
!"أُنظر، لا تُفكّر بـ"بوووم-

231
00:17:44,440 --> 00:17:48,110
ألا أستمرّ بإخباركَ بتخيّل "بوف" للهبٍ يُشعِل الشّمع؟

232
00:17:48,110 --> 00:17:49,860
.سأذهب لأتبرّد

233
00:17:50,360 --> 00:17:53,070
تبّاً... "بوف"، هاه؟

234
00:17:54,070 --> 00:17:55,360
...بوف

235
00:17:55,780 --> 00:17:56,740
بوف؟

236
00:17:57,200 --> 00:17:59,280
.بوف. بوف. بوف

237
00:17:59,740 --> 00:18:01,370
!بوفتي بوف

238
00:18:01,790 --> 00:18:02,830
بوف؟

239
00:18:04,540 --> 00:18:08,000
.شييش، لَيس لَديّ فِكرةٌ إن كان يقترب أكثر أو يبتعد

240
00:18:18,720 --> 00:18:20,890
!يا رجل، أنعشَني هذا

241
00:18:20,890 --> 00:18:24,020
.أبي. أُمّي. أيّها الأجداد المُبجّلون

242
00:18:27,560 --> 00:18:29,730
.أنا... بِلا قوّة

243
00:18:29,980 --> 00:18:31,980
ماذا تظنّون بأنّه عليّ أن أفعل؟

244
00:18:32,730 --> 00:18:34,440
...كبير عائلة ميوا

245
00:18:34,740 --> 00:18:35,820
!كونيكومارو

246
00:18:39,160 --> 00:18:40,660
!ماذا؟ هاي

247
00:18:40,660 --> 00:18:42,370
!حسناً، غضبتُ الآن

248
00:18:44,290 --> 00:18:46,080
لماذا تهرب منّي؟

249
00:18:46,250 --> 00:18:48,670
!أُحاول التّصالح معك، سُحقاً

250
00:18:49,500 --> 00:18:54,090
!أ-أوكومورا، أُريدكَ أن تبقى بعيداً عن بون

251
00:18:54,090 --> 00:18:57,590
!إ-إنّه يُعاني من وَقتٍ عصيبٍ الآن

252
00:18:57,930 --> 00:19:00,010
!لا أتحدّث عن بون

253
00:19:00,010 --> 00:19:03,220
!كونيكومارو، أتحدّث عنكَ الآن

254
00:19:04,970 --> 00:19:06,270
...أنا

255
00:19:07,100 --> 00:19:09,650
.لَيس لَديّ شيء

256
00:19:10,980 --> 00:19:14,360
.أنا... لا أملك أيّ عائلة

257
00:19:15,650 --> 00:19:18,450
.أو موهبةً مثل بون أو شيما

258
00:19:20,740 --> 00:19:23,240
،في اللّيلة الزّرقاء قبل 16 عاماً

259
00:19:23,240 --> 00:19:26,200
.مات أتباع مَعبدي بذلك اللّهب

260
00:19:26,710 --> 00:19:29,170
!اللّهب الأزرق يقتل البَشر

261
00:19:29,170 --> 00:19:30,290
!جدّي

262
00:19:30,540 --> 00:19:35,210
!و جدّ شيما و أخوه الأكبر
!و وَالِد كونيكومارو

263
00:19:37,220 --> 00:19:38,430
،كنتُ وَحيداً

264
00:19:39,130 --> 00:19:42,800
.لكن الأشخاص من طائفة ميودا إحتضنوني و ربّوني

265
00:19:43,300 --> 00:19:47,430
.لذا أُريد أن أردّ لهم الدّين يوماً ما

266
00:19:48,140 --> 00:19:51,400
.في المُستقبل، أُريد العمل لمُساعدة طائفة ميودا

267
00:19:52,650 --> 00:19:55,940
.هُم المكان الوَحيد الذي يُمكنني العودة إليه

268
00:19:56,480 --> 00:19:58,070
!هُم منزلي

269
00:19:59,320 --> 00:20:02,280
...كلّ من يُهدّدهم

270
00:20:03,370 --> 00:20:05,120
!هو عدوّي...

271
00:20:07,370 --> 00:20:09,750
.حسناً. فهمت

272
00:20:12,080 --> 00:20:16,800
إذاً... حالَما ترى بأنّني لَستُ تهديداً، ستتصالح معي، صحيح؟

273
00:20:19,050 --> 00:20:21,050
.كما قُلتَ تماماً

274
00:20:21,340 --> 00:20:27,060
.لا يتقدّم تدريبي جيّداً
.مازلتُ لا أملك أيّ سيطرةٍ على لهبي

275
00:20:27,600 --> 00:20:30,100
.لذا لَيس من المُفاجئ أنّني أجعلكَ مُتوَتّراً

276
00:20:30,520 --> 00:20:32,560
!حسناً، فهمتُ الآن

277
00:20:32,770 --> 00:20:33,770
!حسناً

278
00:20:34,020 --> 00:20:35,980
!سأعود لتدريبي

279
00:20:39,400 --> 00:20:41,030
.أوه، صحيح

280
00:20:41,610 --> 00:20:46,120
.يبدو بالنّسبة لي بأنّ لَديكَ العديد من الأُمور التي ترغب بحمايتها

281
00:20:46,620 --> 00:20:48,870
.و تقول بأنّكَ لا تملك شيئاً؟ كما لَو أنّ هذا صحيح

282
00:20:50,500 --> 00:20:54,210
.أعني، أوكومورا شابٌّ جيّد

283
00:20:54,210 --> 00:20:56,800
.حتّى أنتَ عليكَ أن ترى هذا، كونيكو

284
00:21:02,130 --> 00:21:03,550
...أوكومورا

285
00:21:13,980 --> 00:21:16,980
.سيطر على لهبكَ بسُرعة، يا إلهي

286
00:21:16,980 --> 00:21:20,030
حتّى متى ستستمرّ بهذا التّدريب؟

287
00:21:21,030 --> 00:21:22,490
!أعلَم هذا

288
00:21:25,700 --> 00:21:27,160
تدريب؟

289
00:21:28,200 --> 00:21:29,120
...رين

290
00:21:31,910 --> 00:21:34,040
!حسناً، إذاً سأفعل أيضاً

291
00:21:37,130 --> 00:21:39,630
.سألحق بك

292
00:21:40,130 --> 00:21:41,340
!لذا انتظرني

293
00:21:42,630 --> 00:21:45,010
!لا يُمكنني أن أُصدّق بأنّهم يشكّون بأُختي

294
00:21:45,010 --> 00:21:47,680
!لابدّ من أنّ شيما هو الجّاني

295
00:21:50,270 --> 00:21:52,810
تُصدّقاني، صحيح؟

296
00:21:53,850 --> 00:21:55,900
!بالتّأكيد نفعل، أُختي-
!بالتّأكيد نفعل، أُختي-

297
00:22:05,070 --> 00:22:06,070
...أبي

298
00:22:06,870 --> 00:22:08,580
ما الذي تُخطّط له بحقّ الله؟

299
00:22:09,280 --> 00:22:10,290
...حسناً إذاً

300
00:22:14,000 --> 00:22:16,210
.لنبدأ اليوم ثانيةً

301
00:22:24,260 --> 00:22:26,550
!سأنجح هذه المرّة

302
00:24:06,530 --> 00:24:09,240
ماذا يحصل هُنا، جوزو؟

303
00:24:09,240 --> 00:24:11,660
!لا يُمكن الثّقة بمسؤولينا بعد الآن

304
00:24:11,660 --> 00:24:12,410
!بون

305
00:24:12,410 --> 00:24:14,080
!قُل شيئاً، أبي

306
00:24:14,080 --> 00:24:19,120
.لا يُمكنني إخبار أحدٍ بهذا السرّ
.ولا حتّى إبني

307
00:24:19,120 --> 00:24:22,170
ألا بأس بهذا معكم؟ حسناً، ألا بأس؟

308
00:24:22,170 --> 00:24:23,040
!رين

309
00:24:23,040 --> 00:24:26,130
!لا تشكّ بوَالِدكَ بهذه السّهولة