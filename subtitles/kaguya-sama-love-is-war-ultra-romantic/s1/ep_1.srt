1
00:00:00,470 --> 00:00:02,560
سأتناول برتقالةً الآن، حسناً؟{an}

2
00:00:12,490 --> 00:00:14,240
إلى اللقاء{an}

3
00:00:14,440 --> 00:00:16,030
تخلَّ{an}

4
00:00:23,420 --> 00:00:25,130
عن

5
00:00:26,040 --> 00:00:27,630
أنا أشاهد{an}

6
00:00:32,170 --> 00:00:35,380
!وداعاً، يا للمِيتة{an}

7
00:00:37,180 --> 00:00:39,050
مهرجان هوشين{an}

8
00:00:39,050 --> 00:00:45,730
مجلس الطلبة الثامن والستّون{an}

9
00:00:53,650 --> 00:00:57,110
!عادت أكاديميّة شوتشين{an}

10
00:00:59,870 --> 00:01:02,120
بئساً، أنتَ فقط يا إيشيغامي؟{an}

11
00:01:02,580 --> 00:01:04,120
ما قصدك ببئساً؟{an}

12
00:01:05,830 --> 00:01:07,920
أمن المُنفر رؤيتي وحدي هنا؟{an}

13
00:01:07,920 --> 00:01:10,590
إينو ميكو تريد السكينة{an}

14
00:01:10,590 --> 00:01:10,880
لم أقل ذلك تحديداً{an}

15
00:01:10,880 --> 00:01:12,090
كأنّكِ فعلتِ{an}

16
00:01:12,630 --> 00:01:15,510
ما الوضع اليوم بأيّ حال؟ أين الرئيس والبقيّة؟{an}

17
00:01:15,510 --> 00:01:17,590
لدى طلّاب السنة الثانية اجتماع{an}

18
00:01:17,930 --> 00:01:20,300
يُفترض أنّك مُلمٌّ بذلك
بما أنّك في مجلس الطلبة{an}

19
00:01:20,300 --> 00:01:24,520
،لا أستطيع حفظ جدول علاماتي حتّى
فكيف لي أن أعرف؟{an}

20
00:01:25,140 --> 00:01:27,600
مجرّد سماع صوتك يُصيبني بالصداع{an}

21
00:01:28,060 --> 00:01:29,610
كفّ عن الكلام معي{an}

22
00:01:30,110 --> 00:01:33,360
ترتدي سمّاعات لتفادي سماع صوتي؟{an}

23
00:01:33,690 --> 00:01:38,110
لا يهمّ الأمر بأيّ حال، كأنّي آبه لكِ بدوري{an}

24
00:01:42,580 --> 00:01:44,080
أهذا مطر؟{an}

25
00:01:47,160 --> 00:01:49,500
!كلا، إنّها أصوات محيطيّة{an}

26
00:01:50,880 --> 00:01:52,040
{an}

27
00:01:53,130 --> 00:01:58,050
لا تدرك إينو أنّ سماعاتها ليست
مربوطةً بالكامل إذاً{an}

28
00:01:58,510 --> 00:02:01,550
ذلك وارد، عندما يسمع الجميع تسرّب
موسيقاك وينتابك الإحراج{an}

29
00:02:02,600 --> 00:02:04,310
هل أخبرها؟{an}

30
00:02:05,180 --> 00:02:10,310
لكن إن فعلت، ستبدأ بالنباح كجروٍ أحمق{an}

31
00:02:10,730 --> 00:02:13,980
حسناً، يُصادف أنّي في مزاج
سماع أصواتٍ مُسكّنة{an}

32
00:02:13,980 --> 00:02:15,480
عليّ تركها وشأنها؟{an}

33
00:02:17,320 --> 00:02:17,570
استرخاء 1{an}

34
00:02:17,570 --> 00:02:20,320
استرخاء 2{an}

35
00:02:20,910 --> 00:02:23,830
!ما هذا؟ أصوات موقع بناء؟{an}

36
00:02:24,240 --> 00:02:26,580
...كلا، شعور الحيويّة الفائض هذا{an}

37
00:02:26,950 --> 00:02:28,580
!رغاء جمل؟{an}

38
00:02:28,910 --> 00:02:31,750
كلا، من قد يشغّل هذا
كموسيقى أثناء الدراسة؟{an}

39
00:02:31,750 --> 00:02:33,710
!إنّه إزعاجٌ بحت{an}

40
00:02:34,800 --> 00:02:37,090
!لحظة، لكنّها تبدو مرتاحةً تماماً{an}

41
00:02:37,840 --> 00:02:40,680
إينو غريبة أطوار بالفعل إذاً{an}

42
00:02:40,680 --> 00:02:42,640
إنّها ذكيّة، لكن تفتقر للفعاليّة{an}

43
00:02:42,640 --> 00:02:45,430
ولا تبديل لرأيها بعدما تستقرّ عليه{an}

44
00:02:46,680 --> 00:02:50,100
حتّى الآن، تدرس في كلّ ثانيةٍ
متوفّرةٍ لديها{an}

45
00:02:50,730 --> 00:02:53,310
ربما عليّ الاقتداء بها
من هذه الناحية{an}

46
00:02:53,310 --> 00:02:55,230
لا عجب أنّها مُرتفعة التوتّر{an}

47
00:02:55,230 --> 00:02:59,610
،إذا كان هذا ما تحتاجه للاسترخاء
فأيّ حقٍّ أملكه في انتقادها؟{an}

48
00:03:00,240 --> 00:03:02,660
أجل، أنتِ رائعة{an}

49
00:03:03,530 --> 00:03:05,280
تبذلين جهدك{an}

50
00:03:05,280 --> 00:03:07,660
أنتِ ممتازةٌ كما أنت{an}

51
00:03:07,660 --> 00:03:09,540
إنّكِ فتاةٌ صالحة{an}

52
00:03:09,540 --> 00:03:12,460
لا عليك، لا عليك{an}

53
00:03:12,920 --> 00:03:14,380
هذا شاق، صحيح؟{an}

54
00:03:14,380 --> 00:03:16,960
ابكي إن أردتِ ذلك{an}

55
00:03:16,960 --> 00:03:20,800
اطمئنّي، أنا في صفّك{an}

56
00:03:21,720 --> 00:03:24,220
!مُخيف! مُخيف! مُخيف{an}

57
00:03:24,640 --> 00:03:27,470
ما هذا؟ غسيل دماغ؟ أهذا ما تستمعين
له للاسترخاء يا إينو؟{an}

58
00:03:27,930 --> 00:03:30,350
،كأنّ ذاك الجمل لم يكن غريباً بما يكفي
!أين يبيعون هذه؟{an}

59
00:03:30,350 --> 00:03:33,520
قرص "دعم الوٌسماء المعنويّ" المُدمج، المجلّد 3{an}

60
00:03:33,520 --> 00:03:36,480
أنتِ مذهلة، تحلّي بثقةٍ أكبر في نفسك{an}

61
00:03:36,480 --> 00:03:37,270
لك مقابل 1980 ينّ، عبر التوصيل البريديّ فقط{an}

62
00:03:37,270 --> 00:03:41,150
صحيح، رغم أنّ لا أحد
تأذّى أكثر منك{an}

63
00:03:41,150 --> 00:03:41,490
كلا، لا بدّ أنّ عيّناتاً صوتيّة من موقعٍ
غريب دخلت قائمتها بشكلٍ ما{an}

64
00:03:41,490 --> 00:03:43,990
من كان يعلم أنّكِ ستفعلين
كلّ ذلك لأجل ذاك الشخص؟{an}

65
00:03:44,370 --> 00:03:46,030
أنتِ لطيفة{an}

66
00:03:46,030 --> 00:03:47,280
يا للفتاة الصادقة{an}

67
00:03:47,280 --> 00:03:49,330
تبدو أكثر سكينةً مما
!كانت عليه طوال اليوم{an}

68
00:03:49,330 --> 00:03:50,540
يا إلهي، فات الأوان{an}

69
00:03:50,540 --> 00:03:52,000
أنتِ ظريفة{an}

70
00:03:52,000 --> 00:03:53,170
لا يمكنني أن أخبرها أنّ
!الصوت يتسرّب الآن{an}

71
00:03:53,170 --> 00:03:55,080
فاتنة... أريد احتضانك الآن{an}

72
00:03:55,080 --> 00:03:55,920
!لو كنتُ مكانها، لمتّ{an}

73
00:03:55,920 --> 00:03:57,000
...أكثر ظرافة{an}

74
00:03:57,000 --> 00:03:59,460
!الأكثر ظرافة{an}

75
00:04:00,630 --> 00:04:01,670
!فوجيوارا-سينباي{an}

76
00:04:01,670 --> 00:04:02,630
!كان ذلك وشيكاً{an}

77
00:04:02,630 --> 00:04:06,470
ماذا؟ ظننتُ أنّي سمعت صوت
شخصٍ غير مألوفٍ للتوّ{an}

78
00:04:07,390 --> 00:04:09,560
حنجرتي متضرّرةٌ نوعاً ما في الواقع{an}

79
00:04:09,560 --> 00:04:11,230
!أنتِ تستمعين للموسيقى يا ميكو-تشان{an}

80
00:04:12,020 --> 00:04:13,480
ما الذي تسمعينه؟{an}

81
00:04:13,480 --> 00:04:14,730
...ماذا؟ أنا{an}

82
00:04:15,480 --> 00:04:17,980
إنّها موسيقى شفاءٍ خفيفة{an}

83
00:04:17,980 --> 00:04:18,770
{an}

84
00:04:18,770 --> 00:04:20,230
!كانت بأشدّ الثقل{an}

85
00:04:20,900 --> 00:04:23,570
أعتذر على مقاطعة دراستك{an}

86
00:04:23,570 --> 00:04:24,990
لا، لا مشكلة{an}

87
00:04:25,280 --> 00:04:26,990
!تمهّلي{an}

88
00:04:26,990 --> 00:04:28,530
ماذا هناك؟{an}

89
00:04:28,530 --> 00:04:31,040
حسناً، كيف أقولها؟{an}

90
00:04:31,040 --> 00:04:33,120
أريد استشارتكما{an}

91
00:04:33,120 --> 00:04:34,420
استشارتنا؟{an}

92
00:04:34,420 --> 00:04:35,750
...في الواقع{an}

93
00:04:35,750 --> 00:04:38,500
إنّها معضلةٌ جدّية بالنسبة لي{an}

94
00:04:38,500 --> 00:04:41,260
توجد الفتاة المدعوّة بتسوبامي-سينباي
...في فرقة التشجيع{an}

95
00:04:42,260 --> 00:04:43,760
!هلّا أنصتِّ؟{an}

96
00:04:44,430 --> 00:04:47,470
!أنصتي للمقدمة على الأقل
!اهتمامكِ بي ضعيفٌ لهذا الحدّ؟{an}

97
00:04:47,470 --> 00:04:48,100
أجل{an}

98
00:04:48,100 --> 00:04:48,930
!بالطبع{an}

99
00:04:49,430 --> 00:04:50,430
!تبّاً{an}

100
00:04:50,430 --> 00:04:52,930
من الذي أحاول حمايته
باستماتةٍ هكذا برأيك؟{an}

101
00:04:53,430 --> 00:04:57,440
لكن ربما لن يكون هناك ضررٌ
إن استمعت فوجيوارا-سينباي وحدها{an}

102
00:04:57,440 --> 00:04:58,020
!أ-أكمل{an}

103
00:04:58,020 --> 00:04:59,690
!هيّا{an}

104
00:04:59,690 --> 00:05:02,530
إذا استمعت شينوميا-سينباي أو الرئيس
...فستموت، لكن إن كانت فوجيوارا-سينباي فقط{an}

105
00:05:02,530 --> 00:05:03,440
لكن ألا تبدو قصّةً عاطفية؟{an}

106
00:05:03,440 --> 00:05:04,610
نعتذر على التأخير{an}

107
00:05:04,610 --> 00:05:05,950
!التوقيت{an}

108
00:05:06,780 --> 00:05:07,530
!مرحباً{an}

109
00:05:07,530 --> 00:05:10,410
هل كان عليهما الظهور
في هذا الوقت؟{an}

110
00:05:10,410 --> 00:05:12,450
أشعر بالإرهاق{an}

111
00:05:12,450 --> 00:05:13,950
انكشاف الأمر أمام جادّين مثلهما
سيُلحق ضرراً كبيراً{an}

112
00:05:13,950 --> 00:05:21,300
سمّاعاتك محلولة{an}

113
00:05:21,300 --> 00:05:21,550
...لكن{an}

114
00:05:21,550 --> 00:05:23,960
ماذا؟ أي أنّك استمعت لكلّ شيء؟{an}

115
00:05:24,420 --> 00:05:26,930
أهذه "الرقاقة الذهبيّة"؟{an}

116
00:05:26,930 --> 00:05:29,970
أجل، طلبتُ شحنها مباشرةً
من سيريلانكا{an}

117
00:05:30,970 --> 00:05:32,970
ميكو-تشان، لمَ لا تستريحي قليلاً؟{an}

118
00:05:32,970 --> 00:05:33,970
كلا{an}

119
00:05:33,970 --> 00:05:35,350
لم أنتهِ بعد{an}

120
00:05:37,560 --> 00:05:39,480
...الوحيد القادر على حمايتها الآن{an}

121
00:05:41,150 --> 00:05:42,230
هو أنا فحسب{an}

122
00:05:58,460 --> 00:06:00,380
!إيشيغامي-كن، إيشيغامي-كن{an}

123
00:06:00,380 --> 00:06:02,670
سمّاعاتك محلولةٌ غالباً{an}

124
00:06:02,670 --> 00:06:03,840
ذلك وارد{an}

125
00:06:03,840 --> 00:06:06,260
وما هذه الأغنية السعيدة؟{an}

126
00:06:06,260 --> 00:06:08,220
،عندما ترى الإحراج الذي وقعتُ فيه{an}

127
00:06:08,220 --> 00:06:11,180
يُفترض أن تدرك إينو الخطر
وتعيد ربط سمّاعاتها{an}

128
00:06:11,800 --> 00:06:15,140
هكذا يمكنني كتم سرّها، ولن تعي هي شيئاً{an}

129
00:06:15,140 --> 00:06:17,690
أنتَ مهملٌ حقّاً يا إيشيغامي{an}

130
00:06:18,310 --> 00:06:20,440
أحرجتني أنا حتّى{an}

131
00:06:23,820 --> 00:06:25,400
قلي ما يحلو لك{an}

132
00:06:26,110 --> 00:06:30,410
،قمتُ بهذا بمحض إرادتي
وليس لأنال شكرك{an}

133
00:06:30,820 --> 00:06:32,410
أنا راضٍ{an}

134
00:06:32,410 --> 00:06:35,160
سأرجع لدراستي إذاً{an}

135
00:06:45,180 --> 00:06:48,670
أنتِ ظريفة، بمُنتهى الظرافة{an}

136
00:06:48,670 --> 00:06:52,050
أنتِ ساحرة... يا ظريفتي الصغيرة{an}

137
00:06:52,050 --> 00:06:54,180
الجميع مُغرمون بك{an}

138
00:06:55,470 --> 00:06:57,730
!لا أحد مُغرمٌ أيّها الأحمق{an}

139
00:06:57,730 --> 00:06:59,270
...نتيجة معركة اليوم{an}

140
00:06:59,270 --> 00:07:01,940
خسارة إيشيغامي وإينو{an}

141
00:07:01,940 --> 00:07:06,940
رجع أعضاء مجلس الطلبة لمنازلهم
وكأنّ شيئاً لم يكن{an}

142
00:07:07,710 --> 00:07:11,700
لا تدرك كاغويا{an}

143
00:07:11,700 --> 00:07:12,620
مرحباً بعودتك{an}

144
00:07:12,620 --> 00:07:13,950
رجعت{an}

145
00:07:15,120 --> 00:07:17,950
هل فهمتِ كيفيّة استعمال
هاتفك الذكيّ بعد؟{an}

146
00:07:17,950 --> 00:07:20,000
كيف أردّ؟{an}

147
00:07:20,000 --> 00:07:21,460
{an}

148
00:07:21,460 --> 00:07:24,130
حقّقت الظهور الأوّل لهاتفها الذكيّ
قبل بضعة أيّام{an}

149
00:07:24,130 --> 00:07:26,710
أي أنّها حقّقت ظهورها الأوّل
!لتطبيق اللاين أيضاً{an}

150
00:07:27,250 --> 00:07:31,800
كاغويا-ساما، أنتِ تحدّقين في هاتفك
الذكيّ لساعتين الآن{an}

151
00:07:31,800 --> 00:07:34,390
عليكِ المبادرة بالردّ، ألا تتّفقين؟{an}

152
00:07:34,390 --> 00:07:37,220
لا حاجة للعجلة هكذا{an}

153
00:07:37,220 --> 00:07:40,730
فليس كأنّه يعرف متى قرأتُ رسالته{an}

154
00:07:41,730 --> 00:07:42,480
ماذا؟{an}

155
00:07:42,730 --> 00:07:47,070
حتّى لو تأخّر ردّي، كلّ ما عليّ هو الاعتذار
وقول أنّي رأيتُ رسالته لتويّ{an}

156
00:07:47,070 --> 00:07:48,230
...لا{an}

157
00:07:49,240 --> 00:07:51,860
مع عدم اعتيادها على تقنية
،الإدخال بالنقر بعد{an}

158
00:07:51,860 --> 00:07:54,240
لم ترسل كاغويا رسالةً واحدة
!للآن حتّى{an}

159
00:07:54,660 --> 00:07:57,240
!لذا خطرت لهاياساكا فرضيّة{an}

160
00:07:57,540 --> 00:08:01,540
أيمكن أنّ كاغويا-ساما لا تعرف
نظام إيصال القراء؟{an}

161
00:08:01,830 --> 00:08:03,250
!إيصال القراءة{an}

162
00:08:03,670 --> 00:08:06,250
في اللاين، عندما يفتح المُرسل إليه
...نافذة المحادثة{an}

163
00:08:06,250 --> 00:08:10,760
"تُعلّم الرسالة التي أُرسلت له بـ "تمّ القراءة
ويظهر تنبيهٌ على الشاشة{an}

164
00:08:10,760 --> 00:08:13,840
مع أنّها خاصيّةٌ مفيدة تساعدك
،في التحقّق من رسائلك{an}

165
00:08:13,840 --> 00:08:18,010
إلّا أنّها نظامٌ مخيف يلغي عذر
"لم أقرأها بعد"{an}

166
00:08:18,350 --> 00:08:20,930
مضت ساعتان مُذ ظهر إيصال
!القراءة لكاغويا{an}

167
00:08:20,930 --> 00:08:23,020
!يعتري شيروغاني الهلع{an}

168
00:08:23,310 --> 00:08:26,440
!مكتوبٌ "تمّ القراءة"، لكن لم يصلني ردٌّ بعد{an}

169
00:08:26,440 --> 00:08:29,530
،"إذا حاولت التملّص بقول "قرأتُها للتوّ{an}

170
00:08:29,530 --> 00:08:30,820
فستُكشف ككاذبٍ فوراً{an}

171
00:08:30,820 --> 00:08:34,780
قد يفضح ذلك حقيقة تحديقك
!في هاتفك طوال الوقت أيضاً{an}

172
00:08:34,780 --> 00:08:36,530
احتارت هاياساكا{an}

173
00:08:36,530 --> 00:08:38,780
هل توضّح مفهوم إيصالات
القراءة لكاغويا؟{an}

174
00:08:38,780 --> 00:08:40,290
أم تلزم الصمت؟{an}

175
00:08:40,290 --> 00:08:44,290
لكن بالتفكير في المشاكل اللاحقة إن
...اكتشفت كاغويا كتمها للأمر{an}

176
00:08:44,790 --> 00:08:47,130
...كاغويا-ساما، في اللاين{an}

177
00:08:47,540 --> 00:08:49,300
!رسالة أخرى من الرئيس{an}

178
00:08:49,590 --> 00:08:51,510
!إيصال قراءة فوريّ{an}

179
00:08:51,880 --> 00:08:54,010
يا لقلّة صبره{an}

180
00:08:54,010 --> 00:08:56,010
عندما تكون نافذة محادثة
...لمُرسِل مفتوحة{an}

181
00:08:56,010 --> 00:08:59,970
ما الخطب؟
لا تعرفين كيف تستعملينه؟{an}

182
00:08:59,970 --> 00:09:00,510
!يظهر إيصال القراءة فور وصول الرسالة{an}

183
00:09:00,510 --> 00:09:04,270
كأنّك تقول "أنا أنظر
"لنافذة محادثتك الآن{an}

184
00:09:04,730 --> 00:09:06,400
!إيصال قراءة قوريّ{an}

185
00:09:06,650 --> 00:09:08,310
!إنّها تنظر لها الآن بالفعل{an}

186
00:09:08,310 --> 00:09:11,900
إيصال القراءة الفوريّ أثناء المحادثة المتوقّفة
!هو محض علامة على مراقبتك للرسائل{an}

187
00:09:11,900 --> 00:09:14,490
!وصلت نطاق المُترصّد في هذه المرحلة{an}

188
00:09:14,490 --> 00:09:18,620
هل تركتِ نافذة محادثة الرئيس مفتوحة
عند تلقّيكِ للرسالتين الأوليّتين؟{an}

189
00:09:18,620 --> 00:09:19,530
أحل{an}

190
00:09:19,530 --> 00:09:21,660
وثلاثة إيصالات قراءة فوريّة
!توالياً فوق ذلك{an}

191
00:09:21,990 --> 00:09:23,160
!شحب وجه هاياساكا{an}

192
00:09:23,160 --> 00:09:24,660
!ارتبك شيروغاني{an}

193
00:09:24,660 --> 00:09:26,040
!تمدّد كاغويا ذراعيها{an}

194
00:09:26,040 --> 00:09:27,920
!وتمدّد كي ساقيها{an}

195
00:09:28,210 --> 00:09:32,380
الوحيدة التي لا تدرك
هذه الأزمة هي كاغويا{an}

196
00:09:32,380 --> 00:09:33,300
يبدو أنّ عليّ تركه
يهلع لفترةٍ أطول{an}

197
00:09:33,300 --> 00:09:34,340
كاغويا-ساما{an}

198
00:09:36,470 --> 00:09:39,510
عندما تراسلين أحدهم، عليكِ إخباره
أنّكِ رأيتِ الرسالة للتوّ{an}

199
00:09:39,510 --> 00:09:41,100
أعرف ذلك{an}

200
00:09:42,100 --> 00:09:44,890
إنّها رسالةٌ من فوجيوارا-سان{an}

201
00:09:44,890 --> 00:09:45,850
قرّرت هاياساكا عدم الشرح{an}

202
00:09:45,850 --> 00:09:48,850
أكل الرامن أثناء
ارتداء النظارات
يجعلها ضبابيةً
بشكلٍ كبير{an}

203
00:09:50,110 --> 00:09:51,650
...في وقتٍ كهذا{an}

204
00:09:53,230 --> 00:09:56,860
ما هذا؟{an}

205
00:09:56,860 --> 00:09:58,860
ما هذا؟{an}

206
00:09:59,110 --> 00:10:02,490
!عبارة "تمّ القراءة" هذه... أيمكن؟{an}

207
00:10:03,990 --> 00:10:06,870
إذا رددتُ على فوجيوارا-سان، ستكون المحادثة طويلة{an}

208
00:10:06,870 --> 00:10:08,460
يمكنني الردّ لاحقاً{an}

209
00:10:09,790 --> 00:10:12,380
رسالتان من إيشيغامي-كن
وإينو-سان أيضاً{an}

210
00:10:12,880 --> 00:10:15,800
أنا إيشيغامي
مرحباً بك{an}

211
00:10:16,220 --> 00:10:19,890
!مرحباً، أنا إينو
حقّقتِ ظهور الهاتف
الذكيّ الأوّل لكِ أخيراً
!يا شينوميا
راسليني متى أردتِ من فضلك
!سيُبهجني ذلك كثيراً{an}

212
00:10:19,890 --> 00:10:21,510
...حسناً، تقول إينو-سان{an}

213
00:10:21,510 --> 00:10:24,930
كاغويا-ساما، عليكِ الردّ على الرسائل
بترتيب استلامكِ لها في اللاين{an}

214
00:10:24,930 --> 00:10:27,140
ماذا؟ أذلك الوضع؟{an}

215
00:10:27,390 --> 00:10:29,020
أجل، إنّها الآداب{an}

216
00:10:29,020 --> 00:10:32,360
كذبت هاياساكا بسهولةٍ كما
لو أنّها كانت تتنفّس{an}

217
00:10:32,360 --> 00:10:32,940
حقيقة{an}

218
00:10:33,400 --> 00:10:33,820
كذب{an}

219
00:10:34,070 --> 00:10:37,070
حسناً، الرئيس أوّلاً إذاً؟{an}

220
00:10:38,110 --> 00:10:39,070
!أرسلتُها{an}

221
00:10:42,320 --> 00:10:46,830
شينوميا كاغويا
...آسفة، رأيتُ رسالتك للتوّ{an}

222
00:10:47,330 --> 00:10:49,830
لا تعرف شينوميا أمر إيصالات القراءة إذاً؟{an}

223
00:10:49,830 --> 00:10:52,380
عليّ تفادي تفعيل إيصالات القراءة
في تلك الحالة، صحيح؟{an}

224
00:10:52,380 --> 00:10:53,960
!عدم القراءة الزائف{an}

225
00:10:54,500 --> 00:10:57,970
تُعرض الأسطر الأولى للرسائل على
شاشة إشعارات الهاتف الذكيّ{an}

226
00:10:58,510 --> 00:11:01,840
إذا نظرت لها فحسب، فلن يرُسل إشعار القراءة{an}

227
00:11:01,840 --> 00:11:05,560
سيمنع ذلك ظهور إيصالات القراءة
على هاتف كاغويا الذكيّ{an}

228
00:11:06,180 --> 00:11:10,350
فهمت، كانت شينوميا تحدّق في نافذة
محادثتي طوال الوقت{an}

229
00:11:10,350 --> 00:11:12,190
لساعتين كاملتين{an}

230
00:11:13,110 --> 00:11:15,650
لن تفعل هذا إلّا لشخصٍ تحبّه، أليس كذلك؟{an}

231
00:11:15,650 --> 00:11:19,610
أجل، دليلٌ كافٍ لإجبار كاغويا
!على الاعتراف بمشاعرها{an}

232
00:11:19,610 --> 00:11:26,330
لكن إن كان عذرها أنّها عطّلت وضع النوم
،وتركت نافذة المحادثة مفتوحة{an}

233
00:11:26,330 --> 00:11:30,620
سيُعطي هذا عذر "رأيتُها للتو" بعد سلسلة
إيصالات قراءة قناعةً{an}

234
00:11:30,920 --> 00:11:33,630
أي عليّ استخراج التزامٍ ما{an}

235
00:11:33,630 --> 00:11:36,750
لكن لا يمكنه إرسال رسالةٍ دون
فتح نافذة المحادثة{an}

236
00:11:36,750 --> 00:11:40,130
لكن فتح نافذة المحادثة سيُرسل
!إيصال قراءة، تناقض{an}

237
00:11:40,130 --> 00:11:40,880
!مؤلم{an}

238
00:11:41,260 --> 00:11:45,140
،هنالك خيار إرسال إيميلٍ لها
لكن قد يبدو ذلك مُريباً{an}

239
00:11:45,720 --> 00:11:47,680
!سأرسل لها في المحادثة الجماعيّة إذاً{an}

240
00:11:47,680 --> 00:11:51,690
شبكة مجلس الطلبة

241
00:11:53,190 --> 00:11:55,690
تمّ القراء{an}

242
00:11:57,020 --> 00:11:59,440
وصلت رسالة أخرى من إينو-سان{an}

243
00:11:59,440 --> 00:12:01,450
لا تتركيني على "تمّ القراءة" رجاءً{an}

244
00:12:01,450 --> 00:12:03,450
تتركيني على تمّ القراءة؟ ما معنى ذلك؟{an}

245
00:12:03,820 --> 00:12:05,320
!لديكِ اتّصال من الرئيس{an}

246
00:12:05,320 --> 00:12:06,330
!عليكِ الردّ{an}

247
00:12:06,330 --> 00:12:08,160
لحظة، كيف عرفت أنّي قرأتها؟{an}

248
00:12:08,160 --> 00:12:09,290
!ردّي سريعاً{an}

249
00:12:09,290 --> 00:12:10,330
شيروغاني
مكالمة واردة{an}

250
00:12:11,000 --> 00:12:12,330
!يا إلهي{an}

251
00:12:15,130 --> 00:12:16,290
مرحباً يا شينوميا؟{an}

252
00:12:16,290 --> 00:12:17,590
كيف حالك؟{an}

253
00:12:17,590 --> 00:12:18,880
...الرئيس{an}

254
00:12:18,880 --> 00:12:20,340
كيف لي أن أساعدك؟{an}

255
00:12:20,840 --> 00:12:25,800
بما أنّكِ مبتدئةٌ في اللاين، خطر لي
أن أعطيكِ بضعة معلومات{an}

256
00:12:25,800 --> 00:12:29,180
شينوميا، أتعرفين ما هو إيصال القراءة؟{an}

257
00:12:29,600 --> 00:12:30,850
،شينوميا{an}

258
00:12:30,850 --> 00:12:32,600
أتعرفين ما هو إيصال القراءة؟{an}

259
00:12:33,140 --> 00:12:35,150
،عندما تظهر رسالةٌ في التطبيق{an}

260
00:12:35,150 --> 00:12:37,980
يُرسل إشعار قراءةٍ للمُرسِل عندما
تستعرضين الرسالة في التطبيق{an}

261
00:12:37,980 --> 00:12:40,990
أي أنّ بإمكان المُرسِل معرفة
متى قرأتِ رسالته{an}

262
00:12:45,030 --> 00:12:48,200
بالمناسبة، ظهر عند الثلاثة رسائل التي
أرسلتُها لكِ بفترات متفرّقة{an}

263
00:12:48,200 --> 00:12:50,240
علامة "تمّ القراءة" فور إرسالي لها{an}

264
00:12:51,160 --> 00:12:53,410
ما معنى ذلك يا ترى؟{an}

265
00:12:55,290 --> 00:13:00,000
لن يرسل النظام إشعاراً ما لم
،تكن نافذة المحادثة مفتوحة{an}

266
00:13:00,340 --> 00:13:03,800
"لكن عُلّمت جميعها بـ "تمّ القراءة{an}

267
00:13:04,260 --> 00:13:07,220
تركتِ نافذة محادثتنا مفتوحةً طوال الوقت{an}

268
00:13:07,220 --> 00:13:10,100
لا تفسير آخر لذلك{an}

269
00:13:12,640 --> 00:13:15,810
يمكنني اعتبار صمتكِ إقراراً؟{an}

270
00:13:17,770 --> 00:13:18,810
...شينوميا{an}

271
00:13:18,810 --> 00:13:20,320
...أيمكن أنّكِ تكنّين{an}

272
00:13:20,320 --> 00:13:21,730
أنتَ مخطئٌ تماماً{an}

273
00:13:21,730 --> 00:13:22,690
ماذا؟{an}

274
00:13:23,530 --> 00:13:27,820
تصرّفي{an}

275
00:13:27,820 --> 00:13:31,950
تُفحص رسائل كاغويا-ساما عبر حاسوبٍ
من قِبل طاقم المنزل دوماً{an}

276
00:13:31,950 --> 00:13:34,040
لذا يظهر أنّها قد قُرأت فوراً أحياناً{an}

277
00:13:34,040 --> 00:13:34,830
!ماذا؟{an}

278
00:13:34,830 --> 00:13:37,000
أذلك شائع؟{an}

279
00:13:37,000 --> 00:13:38,960
إنّه معتادٌ بين الطبقات العليا{an}

280
00:13:39,210 --> 00:13:41,710
معتاد؟{an}

281
00:13:42,000 --> 00:13:46,800
يستحيل أن تمضي كاغويا-ساما ساعتين
كاملتين وهي تنظر لهاتفها{an}

282
00:13:46,800 --> 00:13:48,090
بالطبع{an}

283
00:13:48,090 --> 00:13:50,720
أحسنتِ{an}

284
00:13:55,140 --> 00:13:59,480
أيعني هذا أنّ الطاقم قرؤوا كلّ
!رسالةٍ أرسلتُها للآن؟{an}

285
00:13:59,980 --> 00:14:01,150
،مُذ ذلك{an}

286
00:14:01,150 --> 00:14:04,490
عدّة رسائل
نظراً لقلّة صبره{an}

287
00:14:04,860 --> 00:14:07,700
أيمكن أنّها تكرهني؟{an}

288
00:14:09,740 --> 00:14:11,450
لا ردّ{an}

289
00:14:11,450 --> 00:14:12,990
...نتيجة معركة اليوم{an}

290
00:14:12,990 --> 00:14:17,000
خسارة إينو وفوجيوارا وإيشيغامي{an}

291
00:14:20,830 --> 00:14:25,010
:نظرة وجه شخصٍ شرح بإسهاب
"لا بأس باللاين، لكنّ ديسكورد ممتازٌ أيضاً"
ولقي نظرات فارغة في المقابل{an}

292
00:14:25,010 --> 00:14:26,510
موموكو-تشان
الحمامة متعدّدة الألوان{an}

293
00:14:26,510 --> 00:14:28,760
{an}

294
00:14:31,140 --> 00:14:33,680
!أستسلم! خارت ذراعاي{an}

295
00:14:33,680 --> 00:14:36,770
تريد فوجيوارا تشيكا القتال{an}

296
00:14:36,770 --> 00:14:37,270
وتعتبر نفسك رجلاً؟{an}

297
00:14:37,640 --> 00:14:40,400
هذا تحيّزٌ جنسيّ{an}

298
00:14:40,400 --> 00:14:42,270
تتفوّه بأمورٍ معقّدة من جديد{an}

299
00:14:42,570 --> 00:14:46,280
سأعيد صياغة كلامي إذاً، أنت
متخاذلٌ كإنسان يا إيشيغامي-كن{an}

300
00:14:46,650 --> 00:14:49,150
ذلك أشدّ مرارة{an}

301
00:14:50,660 --> 00:14:53,330
ليست بذاك الثقل{an}

302
00:14:53,620 --> 00:14:57,120
عليك أكل لحمٍ أكثر كي تبني
عضلاتاً يا إيشيغامي-كن{an}

303
00:14:57,120 --> 00:14:59,540
وإلّا لن تنجو بعدما تخرج
للعالم الواقعيّ{an}

304
00:14:59,540 --> 00:15:01,330
فتولةٌ غير متوقّعة{an}

305
00:15:02,960 --> 00:15:05,250
مهما قلتِ، أنا رجل{an}

306
00:15:05,250 --> 00:15:08,220
أملك عضلاتاً أكثر
من أنثى مثلك{an}

307
00:15:08,220 --> 00:15:09,470
،أخبريني يا ميكو-تشان{an}

308
00:15:09,720 --> 00:15:11,590
هل تريدين مصارعة أذرع؟{an}

309
00:15:11,590 --> 00:15:13,470
ماذا؟ لا أمانع{an}

310
00:15:15,390 --> 00:15:16,890
لنفعلها إذاً{an}

311
00:15:17,180 --> 00:15:18,640
...استعداد{an}

312
00:15:21,230 --> 00:15:23,110
...إيشيغامي-كن، أشعر أنّك تخالني{an}

313
00:15:23,440 --> 00:15:27,780
محض فتاةٍ ذكيّة صافية القلب، صحيح؟{an}

314
00:15:27,780 --> 00:15:30,400
كلا، البتّة{an}

315
00:15:30,400 --> 00:15:32,780
أنا أهتمّ بالاعتناء بنفسي{an}

316
00:15:32,780 --> 00:15:36,290
لا تسوّس لديّ، وأركض في حديقة
يويوغي في عطلة نهاية الأسبوع{an}

317
00:15:36,290 --> 00:15:45,210
{an}

318
00:15:45,210 --> 00:15:45,540
من المستحيل أن أكون أقلّ من نييت مُنغلقٍ
!مثلك من ناحية الكتلة العضليّة{an}

319
00:15:45,540 --> 00:15:47,460
يا للتباهي{an}

320
00:15:47,460 --> 00:15:50,420
قد لا يبدو عليّ، لكنّي كنت رياضيّاً
في المدرسة الإعداديّة{an}

321
00:15:50,420 --> 00:15:53,640
لست ضعيفاً بحيث يمكن أن تغلبني فتاة{an}

322
00:15:53,640 --> 00:15:55,180
أحقّاً ذلك؟{an}

323
00:15:55,680 --> 00:15:57,680
!أقترح إقامة منافسةٍ إذاً{an}

324
00:15:58,060 --> 00:15:59,520
...سيتواجه أعضاء مجلس الطلبة{an}

325
00:15:59,770 --> 00:16:01,560
!في مسابقة مصارعة أذرع{an}

326
00:16:01,560 --> 00:16:04,310
مسابقة مصارعة الأذرع
لمجلس الطلبة{an}

327
00:16:04,810 --> 00:16:05,810
كلّنا؟{an}

328
00:16:05,810 --> 00:16:07,360
!مصارعة الأذرع{an}

329
00:16:07,360 --> 00:16:09,440
معركة قوّةٍ لا تحتاج لتوضيح{an}

330
00:16:09,740 --> 00:16:15,320
إنّها لعبةٌ تفصل بين القويّ والضعيف بناءً
!على بنية المرء وقوّته العضلية فحسب{an}

331
00:16:15,320 --> 00:16:18,950
!ستحدّد هذه المسابقة الأفضل والأسوأ{an}

332
00:16:19,160 --> 00:16:21,160
المركز الأخيّر{an}

333
00:16:21,160 --> 00:16:22,750
ما المشكلة في تحديد الأوّل فحسب؟{an}

334
00:16:22,750 --> 00:16:25,540
!لا يكفي! يجب أن تكون النتائج واضحة{an}

335
00:16:25,540 --> 00:16:29,340
المجتمع الذي يسمح للضعيف بالمضيّ
في حياته غافلاً عن ضعفه{an}

336
00:16:29,340 --> 00:16:31,590
!يجب أن يُعاد ضبطه{an}

337
00:16:31,590 --> 00:16:32,930
مخيف{an}

338
00:16:34,510 --> 00:16:36,390
لكن، مصارعة أذرع؟{an}

339
00:16:36,390 --> 00:16:37,350
...أي أنّي{an}

340
00:16:37,350 --> 00:16:39,680
سأمسك يد شينوميا بيدي{an}

341
00:16:40,720 --> 00:16:41,810
...رئيس{an}

342
00:16:41,810 --> 00:16:43,440
كن لطيفاً معي{an}

343
00:16:43,730 --> 00:16:46,150
!حسناً، سأشارك! أنا رجلٌ أيضاً{an}

344
00:16:46,150 --> 00:16:48,150
...إذا كنتم ستشاركون جميعاً{an}

345
00:16:48,150 --> 00:16:51,150
!ستُقام مسابقة مصارعة الأذرع{an}

346
00:16:51,150 --> 00:16:54,530
!هذه هي نتائج السحب{an}

347
00:16:54,820 --> 00:16:56,240
النزال الأوّل{an}

348
00:16:56,240 --> 00:17:02,290
ميغورو كو{an}

349
00:17:02,620 --> 00:17:05,040
أنا عسراءٌ في الواقع{an}

350
00:17:05,040 --> 00:17:06,670
ماذا؟ حقّاً؟{an}

351
00:17:06,920 --> 00:17:09,630
تمسكين بقلمكِ بيدكِ اليمنى عادةً، أليس كذلك؟{an}

352
00:17:09,630 --> 00:17:12,010
لأنّي لُقّنت على ذلك{an}

353
00:17:12,010 --> 00:17:14,930
لكن من ناحية القوّة، يدي اليسرى أقوى{an}

354
00:17:15,220 --> 00:17:18,510
حسناً، ماذا نفعل في وضعٍ كهذا؟{an}

355
00:17:18,510 --> 00:17:20,600
لا أمانع استعمال يدي اليسرى{an}

356
00:17:20,600 --> 00:17:22,100
فأنا رجل{an}

357
00:17:22,100 --> 00:17:25,270
لن يُعتبر نزالاً ما لم أواجه عائقاً{an}

358
00:17:25,270 --> 00:17:26,690
شكراً لك{an}

359
00:17:28,190 --> 00:17:29,440
...حسناً{an}

360
00:17:30,320 --> 00:17:32,360
!استعداد... قتال{an}

361
00:17:34,990 --> 00:17:35,860
ماذا؟{an}

362
00:17:36,700 --> 00:17:37,660
صخرة؟{an}

363
00:17:39,950 --> 00:17:41,580
ما خطبها؟{an}

364
00:17:41,580 --> 00:17:43,450
!أدفع وأجرّ ولا تتزحزح أبداً{an}

365
00:17:43,790 --> 00:17:48,000
ماذا؟ النظرة المُزدرية في عينيّ
!شينوميا-سان... مخيفة{an}

366
00:17:48,000 --> 00:17:51,710
القوس الذي تستعمله كاغويا في نادي
الرماية يحمل وزن سحب من 15 كغ{an}

367
00:17:51,710 --> 00:17:56,010
هذا نفس وزن السحب الذي يستعمله
معظم تلامذة الثانويّة الفتيان{an}

368
00:17:56,010 --> 00:17:59,800
كما أنّ كاغويا اكتسبت كتلةً عضليّة
في يدها اليسرى على مرّ السنين{an}

369
00:17:59,800 --> 00:18:03,890
ولا يمتلك إيشيغامي صاحب العضلات دون
!المتوسّط بالنسبة لأترابه فرصةً{an}

370
00:18:03,890 --> 00:18:06,640
!واحد، اثنان، ثلاثة{an}

371
00:18:07,600 --> 00:18:09,940
!فازت شينوميا-سينباي{an}

372
00:18:09,940 --> 00:18:11,520
!خسر إيشيغامي-كن{an}

373
00:18:11,520 --> 00:18:12,150
ماذا؟{an}

374
00:18:12,150 --> 00:18:14,400
ضعيف{an}

375
00:18:16,650 --> 00:18:17,910
!ظريف{an}

376
00:18:18,240 --> 00:18:20,030
!صنعتُ ظريفاً آخراً{an}

377
00:18:20,030 --> 00:18:21,160
!هيّا، انظر لي{an}

378
00:18:21,160 --> 00:18:24,160
كاغويا
إيشيغامي
فوجيوارا
شيروغاني{an}

379
00:18:24,830 --> 00:18:27,160
عليّ الفوز بدوري إذاً{an}

380
00:18:27,710 --> 00:18:28,830
!النزال الثاني{an}

381
00:18:28,830 --> 00:18:32,170
شيبويا-كو{an}

382
00:18:33,250 --> 00:18:34,840
خصمي هي فوجيوارا{an}

383
00:18:35,170 --> 00:18:38,090
،لا أتصوّر خسارتي أمام فتاة{an}

384
00:18:39,550 --> 00:18:42,430
لكنّ إيشيغامي خسر للتوّ{an}

385
00:18:43,310 --> 00:18:44,430
...أيّها الرئيس{an}

386
00:18:44,430 --> 00:18:49,190
{an}

387
00:18:49,190 --> 00:18:50,690
{an}

388
00:18:51,360 --> 00:18:52,110
!قتال{an}

389
00:18:52,900 --> 00:18:53,980
{an}

390
00:18:54,530 --> 00:18:56,860
!ماذا؟! إنّها أقوى مما يبدو عليها{an}

391
00:18:59,110 --> 00:19:01,410
أيّتها الحكم، أهذا قانونيّ؟{an}

392
00:19:01,700 --> 00:19:02,990
ماذا؟ ما قصدك؟{an}

393
00:19:03,280 --> 00:19:05,870
أقصد موضع يد فوجيوارا-سان{an}

394
00:19:06,250 --> 00:19:10,830
مقارنةً بالرئيس، وضعيّة يد فوجيوارا-سان
مائلةٌ نحو أطراف أصابعه{an}

395
00:19:10,830 --> 00:19:12,210
يمكنها توليد قوّةٍ أكبر بالطبع{an}

396
00:19:12,210 --> 00:19:15,380
نقطة الارتكاز{an}

397
00:19:16,130 --> 00:19:18,010
{an}

398
00:19:18,010 --> 00:19:18,380
،عندما كانا يربطان أيديهما قبل قليل{an}

399
00:19:18,380 --> 00:19:21,140
رأيتها تحرّك قبضتها نحو أطراف أصابعه{an}

400
00:19:21,430 --> 00:19:25,180
يمنح ذلك فوجيوارا-سان
أفضليّةً من طرف واحد{an}

401
00:19:25,180 --> 00:19:26,140
ماذا؟{an}

402
00:19:26,770 --> 00:19:28,180
...فوجيوارا-سينباي{an}

403
00:19:28,180 --> 00:19:29,890
!كنتُ أعرف أنّك ستتحايلين{an}

404
00:19:29,890 --> 00:19:32,060
{an}

405
00:19:32,060 --> 00:19:32,650
!يا للمكر{an}

406
00:19:32,650 --> 00:19:33,060
القواعد{an}

407
00:19:33,060 --> 00:19:34,150
!الغشّ بسهولة التنفّس لك{an}

408
00:19:34,150 --> 00:19:36,570
!صوّرتُ الأمر بأسره، لذا سأرسله لكِ لاحقاً{an}

409
00:19:36,980 --> 00:19:37,990
{an}

410
00:19:38,400 --> 00:19:40,950
فاز الرئيس{an}

411
00:19:40,950 --> 00:19:42,740
أحسنتِ الصنيع يا سينباي{an}

412
00:19:43,030 --> 00:19:44,370
!هاكِ هذه{an}

413
00:19:46,740 --> 00:19:47,790
الأخلاقيّات{an}

414
00:19:47,790 --> 00:19:48,160
،بأيّ حال{an}

415
00:19:48,500 --> 00:19:51,250
تحدّد النهائيّ بين هذين الاثنين{an}

416
00:19:51,250 --> 00:19:52,630
...أيّها الرئيس{an}

417
00:19:52,630 --> 00:19:54,880
لنتقاتل بإنصافٍ، اتّفقنا؟{an}

418
00:19:55,130 --> 00:19:55,840
...أ-أ-أيّها الرئيس{an}

419
00:19:55,840 --> 00:19:57,550
!النهائيّ{an}

420
00:19:58,840 --> 00:20:02,930
!كاغويا ضدّ شيروغاني{an}

421
00:20:04,760 --> 00:20:07,520
لننتهِ سريعاً ونرجع للعمل{an}

422
00:20:09,230 --> 00:20:12,020
أجل، ذلك ما أنويه{an}

423
00:20:16,150 --> 00:20:18,030
...حسناً إذاً، استعداد{an}

424
00:20:19,740 --> 00:20:20,530
!قتال{an}

425
00:20:21,570 --> 00:20:22,740
{an}

426
00:20:23,910 --> 00:20:25,200
!إنّهما مُتقاربان{an}

427
00:20:25,200 --> 00:20:26,660
!يا للتنافس الحادّ{an}

428
00:20:26,950 --> 00:20:28,790
!لا أحد منهما يتنازل{an}

429
00:20:28,790 --> 00:20:30,660
!إنّه اصطدام فخرٍ فخرٍ{an}

430
00:20:33,250 --> 00:20:35,420
!لا أظنّ هذا آمناً{an}

431
00:20:36,210 --> 00:20:37,630
ما الذي يجري هنا؟{an}

432
00:20:40,630 --> 00:20:43,880
!انظروا لاحمرارهما الغريب{an}

433
00:20:44,180 --> 00:20:46,010
!إفراز أدرينالين مُفرط{an}

434
00:20:46,010 --> 00:20:49,390
تجاوزت عضلاتهما كلّ الحدود
!البشريّة حاليّاً{an}

435
00:20:49,390 --> 00:20:52,430
لن يستطيعا استعمال أذرعتهما
!إن استمرّ هذا{an}

436
00:20:52,430 --> 00:20:54,520
...لا يمكن! لمَ{an}

437
00:20:55,270 --> 00:20:57,770
!لمَ قد تبذلان هذا الجهد؟{an}

438
00:20:58,650 --> 00:21:02,360
!من الوهلة الأولى، يبدو نزالاً للموت{an}

439
00:21:02,650 --> 00:21:03,610
...لكن{an}

440
00:21:04,660 --> 00:21:07,870
كان متحفّظاً في الواقع{an}

441
00:21:08,950 --> 00:21:13,540
كانت لحظة إمساكهما بأيدي
بعضهما بهيجةٍ بشكلٍ مفاجئ{an}

442
00:21:13,540 --> 00:21:15,880
لم تكن تمتلك شينوميا
أيّة نيةٍ بالفوز{an}

443
00:21:15,880 --> 00:21:19,550
كانت تحافظ على هذه الوضعيّة ببذل
قوّة أعلى بقليل من خصمها{an}

444
00:21:19,550 --> 00:21:21,630
،نوى شيروغاني الفوز في نهاية المطاف{an}

445
00:21:21,630 --> 00:21:24,550
لكنّه قرّر أنّ الأفضليّة له بأيّ حال{an}

446
00:21:24,550 --> 00:21:28,300
!كان كلا المُتنافسين طامحين لإطالة النزال{an}

447
00:21:30,060 --> 00:21:32,930
دقيقة أخرى وسأقبل الهزيمة بوقار{an}

448
00:21:32,930 --> 00:21:35,310
بدأتُ أتعرّق في الواقع{an}

449
00:21:36,060 --> 00:21:37,560
أتعرّق؟{an}

450
00:21:38,480 --> 00:21:40,190
يدي مُتعرّقة؟{an}

451
00:21:43,610 --> 00:21:45,990
!لا{an}

452
00:21:46,280 --> 00:21:47,990
{an}

453
00:21:50,450 --> 00:21:53,500
الفائزة في النزال المُتقارب
!هي شينوميا-سينباي{an}

454
00:21:53,870 --> 00:21:55,160
!مرحى{an}

455
00:21:57,710 --> 00:22:01,210
!كنتما رائعين! أحسنتما البلاء{an}

456
00:22:01,210 --> 00:22:03,760
...ملكة العضلات الأولى{an}

457
00:22:03,760 --> 00:22:06,260
ملكة العضلات{an}

458
00:22:07,010 --> 00:22:08,590
!مُبارك{an}

459
00:22:08,590 --> 00:22:09,800
!ملكة العضلات"؟"{an}

460
00:22:09,800 --> 00:22:12,260
!كما يُتوقّع من كاغويا-سان-
!مُذهل-{an}

461
00:22:12,770 --> 00:22:16,310
سنشير لكِ من اليوم فصاعداً
...يا كاغويا-سان{an}

462
00:22:18,270 --> 00:22:19,900
بأميرة العضلات{an}

463
00:22:20,190 --> 00:22:21,820
أميرة العضلات"؟"{an}

464
00:22:22,890 --> 00:22:25,400
،كان يا ما كان
."كانت هناك مجموعة أشخاص يُدعون بـ" بُناة الأجسام المُسنّين"
تمّ اختيارهم من الصالات الرياضيّة ووضعهم
.للمنافسة في مختلف المسابقات{an}
.من بينهم، كان هناك باني عضلات تلمع عضلاته
وجدتُ ذلك غريباً، فاقتربتُ واكتشفتُ أنّه كان يلمع
.من داخل عضلاته
.بعد رؤيتي لذلك، بدا لي ذاك الرجل الصغير بمنتهى القوّة{an}

465
00:22:26,740 --> 00:22:44,170
!عضلات! عضلات! عضلات{an}

466
00:22:44,170 --> 00:22:47,050
!توقّفوا{an}

467
00:22:47,630 --> 00:22:53,890
!عضلات! عضلات! عضلات{an}

468
00:22:55,060 --> 00:22:56,850
...كان العزم الأخير{an}

469
00:22:57,730 --> 00:22:59,350
مُبهراً{an}

470
00:23:00,020 --> 00:23:03,980
الفوز لكِ عن استحقاق يا شينوميا{an}

471
00:23:05,360 --> 00:23:06,570
...بل{an}

472
00:23:07,820 --> 00:23:09,110
!يا ملكة العضلات{an}

473
00:23:09,570 --> 00:23:14,620
!لا{an}

474
00:23:15,490 --> 00:23:22,420
(فازت كاغويا (ملكة العضلات{an}

