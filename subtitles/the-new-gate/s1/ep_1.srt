1
00:00:02,720 --> 00:00:04,860
.البوّابة الجديدة

2
00:00:06,430 --> 00:00:12,610
لعبة "ل ت أ م ل ع إ" بواقع افتراضيّ من الجيل
.التّالي تستخدم تقنية متطوّرة غير مسبوقة تمامًا

3
00:00:13,270 --> 00:00:17,620
مغامرة بحُرّيّة تامّة في جميع
.أنحاء العالم الّذي تراه أمامك

4
00:00:18,470 --> 00:00:23,010
اختاروا من بين سبعة أنواع فريدة
.لإنشاء أفاتاركم الخاصّ

5
00:00:23,620 --> 00:00:27,130
،اهزموا الوحوش القويّة مع حلفائكم

6
00:00:27,130 --> 00:00:29,880
،واكسبوا ثروة من خلال التّجارة

7
00:00:30,260 --> 00:00:33,880
.أو صيروا حدّادين واصنعوا أسلحة أسطوريّة

8
00:00:34,410 --> 00:00:39,260
لعبة الأدوار متعدّدة اللاّعبين عبر الإنترنت بالواقع
،الافتراضيّ الّتي تسمح لكم بفعل أيّ شيء تتخيّلونه

9
00:00:40,290 --> 00:00:44,690
.البوّابة الجديدة، متوفّرة في كلّ المناطق

10
00:00:49,610 --> 00:00:53,790
.ذات يوم، أصبحت "البوّابة الجديدة" لعبة موت

11
00:01:00,030 --> 00:01:01,990
،صار من المستحيل تسجيل الخروج

12
00:01:01,990 --> 00:01:04,500
وتحوّلت الوفيات داخل اللّعبة
.إلى وفيات في الحياة الواقعيّة

13
00:01:07,340 --> 00:01:09,250
...هل أنت

14
00:01:09,250 --> 00:01:11,750
هو شين بذاته؟

15
00:01:17,620 --> 00:01:22,290
،بهدف إنهاء تلك اللّعبة الميؤوس منها
.واصلتُ القتال

16
00:01:23,420 --> 00:01:25,640
هل ستغادر بالفعل يا سيّدي؟

17
00:01:25,920 --> 00:01:29,400
أتمنّى أن يدور بيننا نزال
.جيّد إن تقابلنا ثانية

18
00:01:29,690 --> 00:01:31,310
.اعتن بنفسك

19
00:01:32,060 --> 00:01:33,810
.نعم، سأعود قريبًا

20
00:01:42,660 --> 00:01:45,410
،إنّه سريع رغم حجمه
.كما يليق بزعيم أخير حقيقيّ

21
00:01:45,950 --> 00:01:48,920
!لكنّ عنقك من نصيبي أنا

22
00:01:50,930 --> 00:01:52,530
.تبًّا. لقد تفادى هجومي

23
00:01:55,890 --> 00:01:58,780
...اهدأ. سينتهي كلّ شيء بمجرّد هزيمته

24
00:02:02,380 --> 00:02:04,570
أجزاؤه المتضرّرة تتجدّد؟

25
00:02:04,570 --> 00:02:06,180
!ليس وأنا هنا

26
00:02:07,940 --> 00:02:08,940
!الضّربة الفولاذيّة

27
00:02:22,780 --> 00:02:25,730
...إنّه يتجدّد ثانية، لكن

28
00:02:26,230 --> 00:02:27,580
!رقصة سيف ضوء القمر

29
00:02:29,830 --> 00:02:32,620
!سينتهي هذا الآن

30
00:02:43,140 --> 00:02:45,750
.هُزم حارس البوّابة أوريجين

31
00:02:46,420 --> 00:02:50,480
"الألقاب المحصّل عليها: "الحاسم
."و"النّائل" و"المحرّر

32
00:02:51,350 --> 00:02:55,770
تمّ قهر الدّيماس. بإمكان
.اللاّعبين تسجيل الخروج الآن

33
00:02:57,590 --> 00:02:59,790
.انتهى الأمر أخيرًا

34
00:02:59,790 --> 00:03:02,110
من الأفضل أن أتحقّق إن استطاع
.الجميع تسجيل الخروج

35
00:03:06,580 --> 00:03:07,620
.إنّهم يختفون

36
00:03:08,020 --> 00:03:11,240
.يغادر الجميع عالم اللّعبة بنجاح

37
00:03:21,380 --> 00:03:24,110
.أنا هو الأخير

38
00:03:26,010 --> 00:03:28,330
.الوداع أيّتها البوّابة الجديدة

39
00:03:31,010 --> 00:03:31,850
ما الّذي يحدث؟

40
00:03:32,700 --> 00:03:34,770
.لا يجدر أن تكون هنالك أيّ أحداث إضافيّة

41
00:03:36,730 --> 00:03:40,170
.ظننتُ أنّي هزمت اللّعبة

42
00:03:51,090 --> 00:03:55,130
أهذا هو عالم اللّعبة؟

43
00:03:57,500 --> 00:04:00,510
.لا، إنّه حقيقيّ جدًّا

44
00:04:00,940 --> 00:04:03,250
أعلم أنّ تكنولوجيا الواقع
،الافتراضيّ تطوّرت كثيرًا

45
00:04:03,250 --> 00:04:04,940
.لكن لا يجدر أن تكون حقيقيّة هكذا

46
00:04:05,750 --> 00:04:06,750
.صحيح

47
00:04:07,150 --> 00:04:08,800
.أستطيع إظهار نافذتي

48
00:04:08,800 --> 00:04:12,410
.مهلاً، تحسّنت إحصائيّاتي بشكل كبير

49
00:04:12,410 --> 00:04:15,020
هل هذا بسبب الألقاب الّتي حصلتُ
عليها بعد هزيمتي للزّعيم الأخير؟

50
00:04:15,300 --> 00:04:19,590
،ولكن إن كنتُ قد هزمت اللّعبة
.فسأكون قادرًا على تسجيل الخروج

51
00:04:20,140 --> 00:04:21,030
.ليس موجودًا

52
00:04:21,300 --> 00:04:23,030
ما عاد زرّ تسجيل الخروج موجودًا؟

53
00:04:23,030 --> 00:04:26,030
.هذا لا يعقل. تذكّرت

54
00:04:26,030 --> 00:04:27,370
ماذا عن البقيّة؟

55
00:04:27,830 --> 00:04:30,040
لا أستطيع الاتّصال بالشّبكة؟

56
00:04:30,420 --> 00:04:33,440
.إذًا لا يجدر باللّعبة أن تسمح لي بالتّحرّك

57
00:04:33,440 --> 00:04:35,410
هل يعني هذا أنّنا في الواقع؟

58
00:04:36,360 --> 00:04:38,010
.لا أفهم

59
00:04:38,010 --> 00:04:41,140
لعبة موت في البداية، والآن رحلة إيسِكاي؟

60
00:04:43,860 --> 00:04:45,970
.لن أصل إلى أيّ هدف بالبقاء هنا

61
00:04:47,290 --> 00:04:51,060
إن كان بإمكاني استعمال هذا الغرض
...المضبوط على قاعدة منزلي

62
00:04:55,230 --> 00:04:57,710
.حسنًا. سأعود لمنزلي

63
00:05:07,340 --> 00:05:10,090
متى بُني هذا الجدار؟

64
00:05:10,090 --> 00:05:12,580
رأيتُ قلعة أيضًا. أكلّ هذا بلدة واحدة؟

65
00:05:15,620 --> 00:05:16,580
.ها هو هناك

66
00:05:16,580 --> 00:05:18,610
.من الجيّد العودة للمنزل

67
00:05:18,610 --> 00:05:20,590
.لا تدعوني أكرّر كلامي

68
00:05:21,010 --> 00:05:23,080
.لن تعود معلّمتي إلاّ بعد مدّة

69
00:05:23,080 --> 00:05:24,930
أنت تخفينها فحسب، صحيح؟

70
00:05:24,930 --> 00:05:28,010
.سنضطرّ لاستعمال القوّة إن رفضت إخبارنا

71
00:05:28,340 --> 00:05:30,850
...توقّفوا. إن ابتعدتُ أكثر من هذا

72
00:05:53,100 --> 00:05:54,540
.فهمت

73
00:05:55,120 --> 00:05:58,170
.أستطيع تعديل قوّة مهاراتي السّحريّة

74
00:05:58,170 --> 00:06:01,580
.تتسبّب الهجمات الجسديّة ببعض الضّغط عليّ

75
00:06:01,580 --> 00:06:03,400
.يبدو هذا حقيقيًّا للغاية

76
00:06:03,400 --> 00:06:04,900
...عفوًا

77
00:06:06,100 --> 00:06:09,290
لقد عدتُ للمنزل؟

78
00:06:11,390 --> 00:06:15,640
.شكرًا لإنقاذك حياتي. أنا تييرا لوسنت

79
00:06:15,640 --> 00:06:17,210
.أنا شين

80
00:06:17,210 --> 00:06:18,420
شين؟

81
00:06:18,420 --> 00:06:21,210
هل تعرف معلّمتي يا شين؟

82
00:06:21,210 --> 00:06:23,090
.قلتَ للتّوّ أنّك عدت للمنزل

83
00:06:23,090 --> 00:06:24,140
معلّمتك؟

84
00:06:24,140 --> 00:06:25,650
عمّ تتحدّث؟

85
00:06:26,060 --> 00:06:30,530
لا يوجد شخص لا يعرف صاحبة متجر
.ضريح القمر المؤقّتة شني رايزر

86
00:06:30,530 --> 00:06:34,550
...أقلت شني رايزر؟ شني

87
00:06:34,990 --> 00:06:36,290
!شني رايزر؟

88
00:06:36,290 --> 00:06:42,790
هل هي إلف سامية جميلة بشعر فضّيّ
يصل حتّى خصرها وجسد مذهل؟

89
00:06:43,650 --> 00:06:45,800
،إن لم تكن شخصًا آخر بنفس الاسم

90
00:06:46,170 --> 00:06:48,970
.فإنّ شني هي واحدة من شخصيّاتي الدّاعمة

91
00:06:49,640 --> 00:06:52,820
...إن كان ضريح القمر موجودًا، فذلك يعني

92
00:06:56,270 --> 00:07:01,050
عفوًا، يمكنك القول أنّني وشني
.نعرف بعضنا منذ مدّة

93
00:07:01,050 --> 00:07:03,150
لذلك أين هي الآن؟

94
00:07:03,540 --> 00:07:05,660
.لا يمكنني مشاركة تلك المعلومة معك بسهولة

95
00:07:05,660 --> 00:07:10,650
التقينا للتّوّ، وكان أولئك الأشخاص
.يبحثون عنها أيضًا

96
00:07:10,650 --> 00:07:13,460
.لكن بإمكاني على الأقلّ إبلاغها بما تريد

97
00:07:13,460 --> 00:07:14,320
إبلاغها؟

98
00:07:14,660 --> 00:07:18,620
عملي هو الاعتناء بالمتجر وتبليغ
.رسائل الآخرين لمعلّمتي

99
00:07:18,620 --> 00:07:20,830
.تُكلّف كلّ رسالة ألف جول

100
00:07:21,180 --> 00:07:26,210
.ألف جول؟ لديّ جيل فحسب

101
00:07:27,900 --> 00:07:31,740
مهلاً لحظة. هل أخذت تلك
من صندوق أغراض للتّوّ؟

102
00:07:31,740 --> 00:07:33,930
نعم. ماذا في ذلك؟

103
00:07:33,930 --> 00:07:35,470
ماذا تقصد بذلك؟

104
00:07:35,770 --> 00:07:40,540
وحده عدد قليل من الملوك والشّيوخ
.من أنواع معيّنة بإمكانهم ذلك

105
00:07:40,540 --> 00:07:44,100
ليس ذلك فحسب، لكنّ عملات جيل
.الذّهبيّة هي غرض لتعزيز السّحر

106
00:07:44,380 --> 00:07:47,010
.إنّها تساوي عشر مليارات جول على الأقلّ

107
00:07:47,010 --> 00:07:48,110
عشر مليارات؟

108
00:07:48,540 --> 00:07:51,780
.كانت عملات جيل أصغر فئة نقديّة في اللّعبة

109
00:07:51,780 --> 00:07:54,110
من تكون بالفعل؟

110
00:07:54,910 --> 00:07:56,740
.أنا مجرّد مغامر عاديّ

111
00:07:56,740 --> 00:08:00,120
.إنّ نوعي هو بشريّ سامٍ

112
00:08:00,510 --> 00:08:04,630
.بشريّ سامٍ؟ لكنّ البشر السّامين انقرضوا جميعًا

113
00:08:04,940 --> 00:08:08,370
انقرضوا؟ أتقصدين أنّ البشريّة انقرضت؟

114
00:08:08,370 --> 00:08:12,300
وحدهم البشر السّامين عالي
.المستوى من انقرضوا

115
00:08:12,300 --> 00:08:14,960
.من رأيتَهم للتّوّ كانوا بشرًا

116
00:08:14,960 --> 00:08:16,260
.صحيح

117
00:08:16,630 --> 00:08:19,840
.كان هنالك في الماضي ستّة بشر سامين فقط

118
00:08:19,840 --> 00:08:24,800
.لقد اختفوا خلال غسق الرّخاء قبل 500 عام

119
00:08:24,800 --> 00:08:26,270
غسق الرّخاء؟

120
00:08:26,270 --> 00:08:28,780
لا تعرف شيئًا حتّى عن ذلك؟

121
00:08:28,780 --> 00:08:34,320
كان حدثًا تاريخيًّا كبيرًا عندما اختفى البشر
.السّامين والعديد من الأشخاص الآخرين

122
00:08:34,320 --> 00:08:37,780
اختفى العديد من الأشخاص؟ أيُعقل هذا؟

123
00:08:38,280 --> 00:08:41,740
.حوصر عشرات الآلاف من اللاّعبين في اللّعبة وقتها

124
00:08:41,740 --> 00:08:44,790
بالطّبع سيكون حدثًا كبيرًا إذا ما فُقد
.كلّ هذا العدد من الأشخاص فجأة

125
00:08:45,290 --> 00:08:47,860
...إنّ التّفسير الأبسط هو

126
00:08:48,330 --> 00:08:51,610
إنّنا في نقطة زمنيّة بعد 500
سنة من أحداث اللّعبة؟

127
00:08:51,610 --> 00:08:54,020
عفوًا، هل تستمع لي؟

128
00:08:54,800 --> 00:08:57,810
.نعم، شكرًا على إخباري

129
00:08:57,810 --> 00:08:59,780
.يمكنك الاحتفاظ بهذه

130
00:08:59,780 --> 00:09:00,430
ماذا؟

131
00:09:00,760 --> 00:09:02,880
.أتطلّع قُدمًا للتّعرّف إليك

132
00:09:02,880 --> 00:09:04,690
هل سمعتَ ما قلتُه قبل قليل؟

133
00:09:04,690 --> 00:09:08,190
أيّ نوع من الأغبياء يُعطي شيئًا
قيّمًا كهذا للآخرين؟

134
00:09:09,660 --> 00:09:10,440
.هذا النّوع

135
00:09:12,470 --> 00:09:14,530
لن تطلب منّي استعادتها؟

136
00:09:14,530 --> 00:09:16,200
.لا

137
00:09:18,200 --> 00:09:21,400
.لطالما حلمت بحمل عُملة جيل ذهبيّة

138
00:09:21,400 --> 00:09:24,200
.إنّها برّاقة جدًّا ولها تصميم جميل

139
00:09:26,630 --> 00:09:30,260
،بما أنّ الإلف بإمكانهم استعمال السّحر
.فستكون مفيدة لك

140
00:09:30,260 --> 00:09:31,270
إلف؟

141
00:09:32,110 --> 00:09:34,720
هل أبدو مثل إلف في نظرك؟

142
00:09:34,720 --> 00:09:39,020
نعم، من الواضح جدًّا أنّك فتاة إلف
.جميلةٍ سوداء الشّعر وذهبيّة العينين

143
00:09:39,020 --> 00:09:40,580
.لا أصدّق هذا

144
00:09:40,580 --> 00:09:44,140
حتّى أنّي طلبتُ من معلّمتي
.إلقاء تعويذة وهم عليّ

145
00:09:44,140 --> 00:09:45,480
لماذا قد تفعلين ذلك؟

146
00:09:46,780 --> 00:09:50,480
لأنّ الإلف ذوي الشّعر الأسود
.يعتبرون رمزًا ملعونًا لسوء الحظّ

147
00:09:50,480 --> 00:09:52,230
رمز لسوء الحظّ؟

148
00:09:53,140 --> 00:09:56,790
.نعم. يجلب هذا الشّعر الأسود سوء الحظّ

149
00:09:57,330 --> 00:10:02,270
،بدأت الوحوش بالهجوم بشكل متكرّر
.ثمّ طُردتُ من قريتي

150
00:10:02,860 --> 00:10:05,250
.أنقذتني معلّمتي حينها

151
00:10:06,230 --> 00:10:08,920
،هنالك حاجز حول هذا المتجر

152
00:10:09,250 --> 00:10:12,480
.وتستعمل معلّمتي سحر وهم لإخفاء هويّتي

153
00:10:12,480 --> 00:10:15,220
.عشت في أمان طوال مائة عام

154
00:10:15,220 --> 00:10:19,260
فهمت. تعرّضوا للهجوم قبل
.قليل بسبب تلك اللّعنة

155
00:10:19,260 --> 00:10:22,360
هل هنالك طريقة لإزالة اللّعنة؟

156
00:10:22,360 --> 00:10:26,070
،تبحث معلّمتي في ذلك
...ولكن في الوقت الحاليّ

157
00:10:26,070 --> 00:10:27,380
.لا بأس بهذا

158
00:10:27,380 --> 00:10:29,270
.حتّى إن لم أستطع مغادرة الحاجز

159
00:10:29,570 --> 00:10:32,510
فعلى الأقلّ يمكنني العيش هكذا
.دون إزعاج أيّ أحد

160
00:10:33,010 --> 00:10:34,210
...ومع ذلك

161
00:10:35,660 --> 00:10:38,460
هل كان شعرك أسود دائمًا؟

162
00:10:39,340 --> 00:10:42,220
.لا. كان فضّيًّا

163
00:10:42,220 --> 00:10:45,580
ولكن ذات يوم، تعرّضتُ للعنة
.فجأة وصار أسودًا

164
00:10:45,580 --> 00:10:46,540
فجأة؟

165
00:10:47,140 --> 00:10:49,920
.لعنة تغيّر لون الشّعر فجأة

166
00:10:49,920 --> 00:10:53,250
...هجمات وحوش. هل هذا

167
00:10:54,380 --> 00:10:55,800
.أجل. هذا ممكن

168
00:10:55,800 --> 00:10:56,860
ماذا؟

169
00:10:56,860 --> 00:10:58,770
.لا أصدّق أنّي نسيت

170
00:10:58,770 --> 00:11:01,640
...لحظة رجاءً. سأفتح شاشة المهارات

171
00:11:01,640 --> 00:11:03,500
.سيكون هنا

172
00:11:03,500 --> 00:11:05,610
عفوًا، ما الّذي تفعله؟

173
00:11:05,610 --> 00:11:07,310
.وجدته. تحليل

174
00:11:08,930 --> 00:11:10,160
عرفتُ هذا

175
00:11:10,160 --> 00:11:11,880
ماذا؟ ما الّذي تقصده؟

176
00:11:11,880 --> 00:11:14,310
.تحملين اللّقب الملعون المسمّى الهديّة الملعونة

177
00:11:14,570 --> 00:11:18,820
إنّه سبب تحوّل لون شعرك للأسود
.وملاحقة الوحوش لك لمهاجمتك

178
00:11:19,170 --> 00:11:21,340
.إنّها لعنة عشوائيّة

179
00:11:21,340 --> 00:11:24,070
.لكنّ التّعرّف على اللّعنة وحده لن يصلحها

180
00:11:24,070 --> 00:11:26,660
.هنالك طريقة لإزالة لعنتك

181
00:11:26,660 --> 00:11:27,330
ماذا؟

182
00:11:28,430 --> 00:11:29,300
.ها هي ذي

183
00:11:30,700 --> 00:11:31,660
.تطهير

184
00:11:39,630 --> 00:11:40,380
ماذا؟

185
00:11:41,810 --> 00:11:43,600
ألم تنجح؟

186
00:11:43,600 --> 00:11:46,350
.لا، لقد نجح التّطهير

187
00:11:46,700 --> 00:11:49,890
.لكن عاد جزء فقط من شعرك لطبيعته

188
00:11:54,710 --> 00:11:57,710
...تييرا. لا أعرف كيف أشرح الأمر

189
00:11:57,710 --> 00:11:58,700
.شكرًا لك

190
00:11:59,150 --> 00:12:01,330
.شكرًا لك، شكرًا لك

191
00:12:01,330 --> 00:12:01,860
...لكن

192
00:12:02,210 --> 00:12:05,640
.لا بأس. هذا ممتاز. أفضل من ممتاز

193
00:12:05,640 --> 00:12:08,620
.استعدتُ شعري الّذي لم أره منذ مائة عام

194
00:12:12,290 --> 00:12:14,900
.آسفة لأنّي فقدت رزانتي

195
00:12:15,380 --> 00:12:19,670
.لكنّي لا أشعر أنّ اللّعنة قد زالت فعلاً

196
00:12:19,670 --> 00:12:22,630
لماذا لا تحاولين مغادرة الحاجز؟

197
00:12:22,630 --> 00:12:23,690
ماذا؟

198
00:12:25,460 --> 00:12:26,890
.لا بأس

199
00:12:26,890 --> 00:12:29,170
.إن ظهر أيّ وحش، فأنا هنا لهزيمته

200
00:12:29,610 --> 00:12:31,540
...لا أدري حيال ذلك

201
00:12:31,540 --> 00:12:34,100
لقد انتظرتِ لمائة سنة، صحيح؟

202
00:12:36,230 --> 00:12:37,270
.ستكونين بخير

203
00:12:42,130 --> 00:12:44,010
.حسنًا، هيّا بنا

204
00:13:03,020 --> 00:13:04,530
.لم يحدث أيّ شيء

205
00:13:04,940 --> 00:13:06,340
.معك حقّ

206
00:13:06,970 --> 00:13:09,340
.زالت اللّعنة

207
00:13:09,850 --> 00:13:11,510
.ذلك ما يبدو

208
00:13:14,890 --> 00:13:16,150
.أخبرني يا شين

209
00:13:19,660 --> 00:13:21,980
السّماء شاسعة، صحيح؟

210
00:13:28,100 --> 00:13:29,430
.نعم

211
00:13:32,290 --> 00:13:33,950
.سرّني أنّي استطعتُ مساعدتك

212
00:13:34,330 --> 00:13:36,220
.شكرًا جزيلاً لك

213
00:13:36,220 --> 00:13:38,290
ما الّذي ستفعله الآن يا شين؟

214
00:13:38,290 --> 00:13:40,820
.لن تعود معلّمتي إلاّ بعد مدّة

215
00:13:40,820 --> 00:13:43,340
.ربّما سأذهب وألقي نظرة على البلدة

216
00:13:43,990 --> 00:13:46,630
.عليّ اكتشاف المزيد عن هذا العالم

217
00:13:47,110 --> 00:13:49,010
،إن كانت معلّمتها هي شني الحقيقيّة

218
00:13:49,010 --> 00:13:52,460
فمن المرجّح أنّ بقيّة شخصيّاتي
.الدّاعمة موجودة أيضًا

219
00:13:52,460 --> 00:13:53,370
.صحيح

220
00:13:53,720 --> 00:13:57,230
،إن كنتَ ستذهب إلى مملكة بيريليخت
.فعليك أخذ هذه معك

221
00:13:57,230 --> 00:13:58,420
بي...؟

222
00:13:58,420 --> 00:14:00,980
.إنّه المكان الّذي مررت عليه قبل قليل

223
00:14:01,330 --> 00:14:03,480
.تفضّل. إنّها رسالة توصية

224
00:14:03,480 --> 00:14:06,380
،هنالك صفّ تفتيش عندما تدخل المملكة

225
00:14:06,380 --> 00:14:08,540
.لكنّ هذه الرّسالة ستسمح لك بتجاوزه

226
00:14:08,540 --> 00:14:14,060
شكرًا، ولكن أواثقة من رغبتك في منح
هذه الرّسالة لشخص قابلته للتّوّ اليوم؟

227
00:14:14,060 --> 00:14:17,190
.لقد أزلتَ لعنتي وتبدو شخصًا كفؤًا

228
00:14:17,190 --> 00:14:20,180
.كما أنّك طيّب الطّباع لدرجة الغباء

229
00:14:20,180 --> 00:14:22,250
.ما كان عليك إضافة ذلك الجزء الأخير

230
00:14:22,830 --> 00:14:25,510
.لا توجد كلمات شكر توفيك حقّك

231
00:14:26,300 --> 00:14:27,070
ماذا قلت؟

232
00:14:28,390 --> 00:14:30,510
.لا شيء. لا شيء إطلاقًا

233
00:14:30,860 --> 00:14:32,610
.حسنًا، سأغادر الآن

234
00:14:32,610 --> 00:14:35,280
.سأبلغك بمجرّد عودة معلّمتي

235
00:14:35,280 --> 00:14:37,290
.أقدّر لك هذا

236
00:14:39,090 --> 00:14:42,020
.لا أصدّق أنّ بإمكاني تفادي الصّفّ

237
00:14:42,020 --> 00:14:44,400
.رسالة التّوصية هذه مذهلة

238
00:14:44,400 --> 00:14:45,820
،ليس ذلك فحسب

239
00:14:45,820 --> 00:14:49,720
بل إنّها أشبه بوثائق تعريف بإمكانها حتّى
.تأمين لقاء لك مع الملك في هذه المملكة

240
00:14:49,720 --> 00:14:51,120
.احرص على ألاّ تفقدها

241
00:14:51,120 --> 00:14:52,530
أأنت جادّ؟

242
00:14:58,050 --> 00:15:00,040
.هذه هي نقابة المغامرين

243
00:15:00,500 --> 00:15:02,510
.حسنًا، إلى اللّقاء

244
00:15:02,510 --> 00:15:05,010
.شكرًا على مرافقتي

245
00:15:05,010 --> 00:15:08,300
.عليّ البدء هنا إن أردت جمع المعلومات

246
00:15:09,150 --> 00:15:11,050
.مرحبًا بك في نقابة المغامرين

247
00:15:11,440 --> 00:15:13,800
كيف يمكنني مساعدتك؟

248
00:15:14,080 --> 00:15:19,560
.عفوًا... أودّ التّسجيل كمغامر

249
00:15:19,810 --> 00:15:25,290
تُقبل الطّلبات في المكتب
.في الأعلى على يسارك

250
00:15:25,290 --> 00:15:27,100
.مفهوم

251
00:15:27,890 --> 00:15:31,070
مرحبًا بك. هل تود التّسجيل كمغامر؟

252
00:15:31,070 --> 00:15:33,450
.ماذا؟ نعم، لو سمحت

253
00:15:34,130 --> 00:15:35,770
هل من خطب ما؟

254
00:15:35,770 --> 00:15:38,630
.تبدين مثل المرأة الّتي في الطّابق الأوّل

255
00:15:39,050 --> 00:15:41,460
.إنّها أختي التّوأم الكبرى سِليكا

256
00:15:41,460 --> 00:15:42,970
.أنا سيليكا

257
00:15:42,970 --> 00:15:43,830
.فهمت

258
00:15:43,830 --> 00:15:50,090
،في البداية، عليك دفع رسوم التّسجيل
.ثمّ ملء هذه الاستمارة

259
00:15:51,420 --> 00:15:55,830
لا أصدّق أنّ تجهيز بطاقة نقابة
.يتطلّب يومًا كاملاً

260
00:15:57,850 --> 00:16:00,100
.أسلحة نحاس وحديد

261
00:16:00,100 --> 00:16:03,600
.وكلّ دروعهم مصنوعة من الجلد والحديد

262
00:16:04,230 --> 00:16:06,670
.جودة معدّاتهم أقلّ ممّا كانت عليه في اللّعبة

263
00:16:07,070 --> 00:16:09,170
.شكرًا على الانتظار يا سيّد شين

264
00:16:11,580 --> 00:16:14,020
سِليكا؟ لماذا؟

265
00:16:14,020 --> 00:16:17,370
.أقوم بالمساعدة هنا عندما لا أكون مشغولة

266
00:16:17,370 --> 00:16:19,510
لكن هل عليك تغيير الملابس لذلك بالفعل؟

267
00:16:20,690 --> 00:16:22,240
عفوًا...؟

268
00:16:22,240 --> 00:16:24,580
.تفضّل رجاءً

269
00:16:24,580 --> 00:16:25,380
.حسنًا

270
00:16:29,590 --> 00:16:30,540
.إنّه لذيذ

271
00:16:31,380 --> 00:16:33,240
...تحديق

272
00:16:33,240 --> 00:16:35,390
.لكنّي لا أستطيع الأكل هكذا

273
00:16:35,390 --> 00:16:37,560
عفوًا يا سِليكا؟

274
00:16:37,560 --> 00:16:41,660
آسفة. هنالك أمر أودّ أنّ أتأكّد
.منه بخصوصك في الحقيقة

275
00:16:41,660 --> 00:16:44,740
مفهوم. وما هذا الأمر؟

276
00:16:46,210 --> 00:16:49,130
.سمعتُ أنّ لديك رسالة توصية من ضريح القمر

277
00:16:49,130 --> 00:16:50,650
.نـ-نعم

278
00:16:51,470 --> 00:16:56,280
هل يمكنني التّحقّق من صحّتها في غرفة أخرى؟

279
00:16:56,620 --> 00:16:58,940
.بالتّأكيد، بعد الانتهاء من الأكل

280
00:16:58,940 --> 00:17:04,010
لا أريد حقًّا مقابلة زعيم النّقابة
.مباشرة بعد مجيئي هنا

281
00:17:04,010 --> 00:17:05,290
...بشأن ذلك

282
00:17:05,290 --> 00:17:07,820
.إنّه هنا سلفًا

283
00:17:11,510 --> 00:17:12,300
.مرحبًا

284
00:17:12,570 --> 00:17:15,050
.الرّجل الغريب عند الاستقبالات

285
00:17:16,020 --> 00:17:20,060
.سررت بلقائك
.أنا زعيم النّقابة بارلوكس هايم

286
00:17:20,410 --> 00:17:23,150
.وأنا شين. سررت بلقائك أيضًا

287
00:17:23,150 --> 00:17:25,450
.شين، لندخل صلب الموضوع

288
00:17:25,450 --> 00:17:28,060
هل يمكنني رؤية رسالة التّوصية
خاصّتك من ضريح القمر؟

289
00:17:28,370 --> 00:17:29,100
.أكيد

290
00:17:30,510 --> 00:17:32,660
.لنتحقّق من صحّتها

291
00:17:34,570 --> 00:17:35,720
ماذا؟

292
00:17:35,720 --> 00:17:39,250
عند وضع رسالتَيْ توصية قرب
.بعضهما، ترنّان وتلمعان

293
00:17:39,250 --> 00:17:41,530
.يمكنني أن أشهد أنّ هذه رسالة حقيقيّة

294
00:17:41,530 --> 00:17:43,080
.لم أكن أعلم

295
00:17:43,500 --> 00:17:45,690
من أعطاك إيّاها؟

296
00:17:45,690 --> 00:17:48,460
أكانت شني؟ أم تييرا؟

297
00:17:48,460 --> 00:17:49,830
.كانت تييرا

298
00:17:49,830 --> 00:17:54,090
لا بدّ أنّ شيئًا كبيرًا قد حدث إذا
.نسيتْ أن تشرح لك ذلك

299
00:17:54,970 --> 00:17:57,290
.اسمح لي بالشّرح إذًا

300
00:17:57,290 --> 00:18:01,100
تسمح لك رسالة التّوصية بدخول
.معظم الدّول دون تفتيش

301
00:18:01,450 --> 00:18:03,680
،إنّها مقبولة لدى جميع النّقابات

302
00:18:03,680 --> 00:18:07,750
،وفي بعض البلدان مثل بيريليخت
.قد تؤمّن لك لقاءً حتّى مع الملك

303
00:18:07,750 --> 00:18:11,610
.إنّها أكثر وثيقة تعريف موثوق بها

304
00:18:11,610 --> 00:18:13,850
.يا لها من فوائد مذهلة

305
00:18:13,850 --> 00:18:16,840
.اشتهر اسم شني بكلّ تأكيد

306
00:18:16,840 --> 00:18:19,170
.إنّه غرض قويّ للغاية

307
00:18:19,170 --> 00:18:22,270
.هناك من قد يحاولون سرقته لأسباب شرّيرة

308
00:18:22,270 --> 00:18:23,370
.واثق من ذلك

309
00:18:24,110 --> 00:18:26,500
.لذلك اسمح لي أن أكون مباشرًا أكثر

310
00:18:26,950 --> 00:18:32,420
إن لم تكن واثقًا أنّ بإمكانك حماية
.الرّسالة، فعليك تدميرها

311
00:18:33,540 --> 00:18:34,610
.سأكون بخير

312
00:18:35,090 --> 00:18:39,880
إن كانت تييرا قد منحتني إيّاها
.لأنّها تثق بي، فلن أخذلها

313
00:18:42,230 --> 00:18:43,910
.هذا ما وددت سماعه

314
00:18:43,910 --> 00:18:47,550
مِن رجلٍ اعترف به ضريح القمر
.إلى آخر، دعنا نبذل قصارى جهدنا

315
00:18:47,550 --> 00:18:49,970
.أتطلّع قدمًا لرؤية ما قد تحقّقه

316
00:18:51,260 --> 00:18:51,900
.أجل

317
00:18:53,350 --> 00:18:57,280
.دعنا نختبر مهاراتك الآن

318
00:18:57,280 --> 00:18:58,110
ماذا؟

319
00:19:01,780 --> 00:19:03,890
.كم أنا متعب

320
00:19:05,830 --> 00:19:08,740
.كان يومًا صعبًا بالفعل

321
00:19:12,500 --> 00:19:16,870
سأحاول الرّفع من رتبتي غدًا
.بمجرّد حصولي على بطاقة النّقابة

322
00:19:17,700 --> 00:19:22,640
متى قد تعود شني؟

323
00:19:26,170 --> 00:19:30,890
يبدو أنّي لم أستيقظ
.في العالم الحقيقيّ لسوء الحظّ

324
00:19:32,210 --> 00:19:34,310
.صباح الخير يا سيّد شين

325
00:19:34,690 --> 00:19:36,310
هل نمت جيّدًا؟

326
00:19:36,310 --> 00:19:40,410
.نعم. عثرتُ على فندق جيّد بفضلك

327
00:19:40,410 --> 00:19:44,300
.أرى أنّك ترتدي ملابس جديدة

328
00:19:44,300 --> 00:19:46,420
.من السّهل التّحرّك بهذه

329
00:19:46,830 --> 00:19:51,080
لا يجب على مغامر متدنّي
.المستوى ارتداء ملابس فخمة

330
00:19:51,780 --> 00:19:54,460
.إليك بطاقة نقابتك

331
00:19:55,150 --> 00:20:00,660
هنالك تسع مراتب للمغامرين، ابتداءً
.من س س ثمّ س وبعدها أ وصولاً إلى ز

332
00:20:05,210 --> 00:20:08,660
يمكنك أخذ مهمّات أعلى منك
.برتبتين على أكبر تقدير

333
00:20:09,090 --> 00:20:11,480
.لديّ مهمّة أودّ القيام بها سلفًا

334
00:20:12,210 --> 00:20:14,240
.حصاد عشب هيلك

335
00:20:14,240 --> 00:20:18,860
،هناك دائمًا طلب عليه كمكوّن جرعات
.لذلك ليس هناك مهلة زمنيّة

336
00:20:18,860 --> 00:20:19,860
.مفهوم

337
00:20:20,570 --> 00:20:22,120
.حسنًا، سأغادر

338
00:20:22,120 --> 00:20:23,360
.كن حذرًا

339
00:20:25,580 --> 00:20:30,120
،اعترف السّيّد بارلوكس بمهاراته
.لكن لا يبدو كرجل متعالٍ إطلاقًا

340
00:20:30,460 --> 00:20:31,830
.يا له من رجل غريب

341
00:20:35,630 --> 00:20:38,660
.كنتُ أبحث طوال ثلاث ساعات

342
00:20:38,660 --> 00:20:41,680
حتّى في اللّعبة، حصاد عشب
.هيلك كانت مهمّة مبتدئين

343
00:20:41,680 --> 00:20:43,880
.ظننتُ أنّ الأمر سيكون سهلاً

344
00:20:44,330 --> 00:20:48,330
حسنًا، كلّ الوحوش ضعيفة بما
،يكفي لتُهزم بعدّةٍ متدنّيةِ الرّتبة

345
00:20:48,330 --> 00:20:49,770
.لذلك سآخذ وقتي

346
00:20:52,180 --> 00:20:55,140
وحش. ولكن لماذا يتحرّك هكذا؟

347
00:20:56,820 --> 00:20:58,810
.يجدر أن يكون قريبًا

348
00:21:05,500 --> 00:21:07,910
.إنّ هذا سكالفيس جاك

349
00:21:09,520 --> 00:21:13,060
.المستوى 359. إنّه قويّ

350
00:21:14,950 --> 00:21:15,920
عربة؟

351
00:21:16,460 --> 00:21:19,420
لا بدّ أنّه بدا غريبًا على خريطتي
.لأنّه كان هائجًا

352
00:21:19,990 --> 00:21:23,680
يبدو أنّ هنالك من قُتل بسبب
.هجوم سكالفيس جاك

353
00:21:23,680 --> 00:21:26,770
.كنت أعرفه. هذا مؤسف

354
00:21:26,770 --> 00:21:28,440
.عليّ فعل شيء حيال هذا

355
00:21:28,440 --> 00:21:30,220
.سأبدأ بالهجوم

356
00:21:37,370 --> 00:21:38,600
.إنّه سريع

357
00:21:39,290 --> 00:21:44,610
لم أسمع من قبل عن وحش ميت
.حيّ يحمل سيفًا من نوع نوريّ

358
00:21:44,610 --> 00:21:47,610
.لا بدّ أنّه وحش فريد

359
00:21:54,250 --> 00:21:56,010
.لم يكن ذلك ضررًا كافيًا

360
00:21:57,180 --> 00:21:59,750
.يستطيع القيام بهجوم واحد آخر فحسب

361
00:22:00,430 --> 00:22:02,500
.حسنًا، لنجرّب شيئًا

362
00:22:05,260 --> 00:22:06,510
.تعطيل الحدّ

363
00:22:33,660 --> 00:22:35,160
.لقد حلّق بعيدًا

364
00:22:35,810 --> 00:22:38,750
.وددتُ لو حصلتُ على ذلك السّيف

365
00:22:47,130 --> 00:22:51,180
.لكنّه ترك خلفه حجرًا كريمًا
.أظنّني سأقبل بذلك

366
00:22:51,980 --> 00:22:55,180
.أظنّني عرفتُ ما مدى قوّتي في هذا العالم

367
00:22:55,950 --> 00:22:58,500
.إذًا فاللّعبة حقيقيّة هنا

368
00:22:59,150 --> 00:23:00,870
.بدأ هذا يصير ممتعًا

369
00:23:06,730 --> 00:23:07,400
ماذا حدث؟

370
00:23:07,400 --> 00:23:08,040
!يا سموّك

371
00:23:08,040 --> 00:23:09,950
هل صاحب الجلالة بخير؟

372
00:23:11,380 --> 00:23:12,290
!سيّدتي ليون

373
00:23:22,130 --> 00:23:24,830
ما-ما الّذي حدث هنا؟