1
00:00:03,150 --> 00:00:07,520
مرحبًا يا سيّدي. لم أتوقّع أنّي سأراك
.ثانية في هذه الحياة

2
00:00:07,800 --> 00:00:11,980
.لم أعتقد أنّك ما زلت حيًّا يا جيرارت

3
00:00:13,980 --> 00:00:15,030
.معك حقّ

4
00:00:15,470 --> 00:00:18,690
.لا أدري لماذا ما زلت حيًّا أيضًا

5
00:00:20,040 --> 00:00:24,420
،لدينا الكثير لنتحدّث عنه
.لكن لنبدأ بتقديم أنفسنا

6
00:00:24,420 --> 00:00:27,660
.هذا هو ملك الوحوش الحاليّ ولفغانغ

7
00:00:28,460 --> 00:00:30,420
.وابنته كووري

8
00:00:30,770 --> 00:00:32,670
.هذا الاثنان أميناي

9
00:00:32,970 --> 00:00:35,370
،ذراعي اليمنى فان كو

10
00:00:35,680 --> 00:00:38,930
.وذراعي اليسرى راجيم دولك

11
00:00:39,200 --> 00:00:43,810
،أنا شين. ربّما سمعتم عنّي مسبقًا
.لكنّي بشريّ سامٍ

12
00:00:44,420 --> 00:00:45,790
.سررت بلقائكم

13
00:00:47,130 --> 00:00:49,940
.يمكنك أن تتكلّم على راحتك يا سيّدي

14
00:00:50,300 --> 00:00:52,640
!فقط إن تحدّثت أنت معي كالمعتاد

15
00:00:52,640 --> 00:00:55,200
.لم تنادني بـ"سيّدي" أبدًا من قبل

16
00:00:55,480 --> 00:01:00,200
.لم نرَ بعضنا منذ مدّة. دعني أستمتع بوقتي

17
00:01:00,610 --> 00:01:05,210
.إضافة لذلك، إنّها الطّريقة الوحيد لأريحهم

18
00:01:05,210 --> 00:01:06,210
تريحهم؟

19
00:01:06,210 --> 00:01:12,210
.تعرف مدى جنون البشر السّامين

20
00:01:13,260 --> 00:01:15,610
،بالنّسبة لسكّان هذا العالم

21
00:01:15,610 --> 00:01:21,210
البشر السّامون كائنات أسطوريّة
.يجب أن يخشوها ويوقّروها

22
00:02:55,020 --> 00:02:57,280
هل ما تزال حيًّا؟

23
00:02:57,620 --> 00:02:58,780
.وفي أفضل حال

24
00:02:59,090 --> 00:03:00,670
كم قتلتَ منهم؟

25
00:03:00,670 --> 00:03:04,030
.مائة؟ ألف؟ أو ربّما أكثر

26
00:03:05,300 --> 00:03:07,040
.لم تحن اللّحظة الحاسمة بعد

27
00:03:08,240 --> 00:03:09,410
.أنا في كامل حماستي

28
00:03:09,970 --> 00:03:11,170
.جيّد

29
00:03:11,170 --> 00:03:13,470
.احرس ظهري

30
00:03:18,650 --> 00:03:21,210
.ظننتُ أنّنا سنموت وقتها بكلّ تأكيد

31
00:03:21,210 --> 00:03:24,300
.معك حقّ. أنا مندهش أنّ كلانا خرج من ذلك سالمًا

32
00:03:24,580 --> 00:03:27,160
كم قتلنا منهم يا ترى؟

33
00:03:27,160 --> 00:03:28,840
.لا أذكر

34
00:03:28,840 --> 00:03:29,810
.أتوقّع ذلك

35
00:03:29,810 --> 00:03:33,900
بالحديث عن أمور وقعت في السّنوات
...الخمسمائة الأخيرة

36
00:03:34,370 --> 00:03:37,800
.أخبرتني شني كلّ شيء عن بنائك لهذه البلاد

37
00:03:37,800 --> 00:03:39,940
مهلاً، مهلاً! أخبرته بكلّ شيء؟

38
00:03:40,300 --> 00:03:43,100
.كنتُ سأتفاخر بذلك

39
00:03:43,100 --> 00:03:47,200
،حسب معرفتي بك، توقّعتُ أن تبالغ

40
00:03:47,690 --> 00:03:51,000
.لذلك قدّمتُ وصفًا موضوعيًّا لملاحظاتي

41
00:03:51,000 --> 00:03:52,210
!ماذا؟

42
00:03:53,780 --> 00:03:55,210
.أصدّق ذلك

43
00:03:56,370 --> 00:03:59,490
.سأذهب لإعداد بعض الشّاي

44
00:03:59,490 --> 00:04:00,710
.حسنًا. شكرًا لك

45
00:04:01,670 --> 00:04:05,970
.أعتقد أنّ قصص بطولتي يجب أن تنتظر

46
00:04:05,970 --> 00:04:08,930
.أخبرني عنك الآن

47
00:04:10,340 --> 00:04:15,190
.حسنًا، أخبرت شني مسبقًا
...في الحقيقة

48
00:04:16,620 --> 00:04:22,030
فهمت. لا عجب أنّي لم أستطع
.إيجادك مهما بحثت

49
00:04:22,740 --> 00:04:26,850
.يبدو أنّك ورّطت نفسك في مشكلة غريبة

50
00:04:26,850 --> 00:04:32,120
حدّث ولا حرج. بصيص الأمل الوحيد
.هو أنّ الأمر ليس سيّئًا كما يبدو

51
00:04:34,300 --> 00:04:37,310
.هكذا إذًا... معك حقّ

52
00:04:38,250 --> 00:04:40,880
.هذا أمر ممتاز بالنّسبة لي على الأقلّ

53
00:04:42,420 --> 00:04:43,450
جيرارت؟

54
00:04:44,540 --> 00:04:46,640
.لنتحدّث عن أمور أكثر جدّيّة

55
00:04:47,020 --> 00:04:51,670
.شين، هناك أمر أريد إطلاعك عليه

56
00:04:51,670 --> 00:04:52,550
ما هو؟

57
00:04:55,210 --> 00:04:57,650
.إنّ ساعتي وشيكة

58
00:04:58,610 --> 00:04:59,400
ماذا؟

59
00:04:59,400 --> 00:05:00,930
.أيّامي في هذه الحياة معدودة

60
00:05:01,490 --> 00:05:04,540
.ربّما بقي لي أقلّ من شهر واحد

61
00:05:04,540 --> 00:05:06,410
كيف تعرف ذلك؟

62
00:05:06,900 --> 00:05:10,150
،شعرتُ بوجود خطب ما لبضعة أسابيع الآن

63
00:05:10,870 --> 00:05:13,910
.وعندما أخبرتني شني عنك، تأكّدت

64
00:05:14,420 --> 00:05:18,670
،يبدو أنّ الوقت بدأ يجري بالنّسبة لي ثانية

65
00:05:18,670 --> 00:05:22,170
.وكأنّه كان ينتظر عودتك

66
00:05:23,550 --> 00:05:29,550
،إن كانت هنالك آلهة في هذا العالم
.فربّما أصغت لصلواتي

67
00:05:29,550 --> 00:05:30,730
صلواتك؟

68
00:05:36,380 --> 00:05:38,560
.بارزني يا شين

69
00:05:41,740 --> 00:05:44,070
.أريد مقاتلتك

70
00:05:50,730 --> 00:05:57,780
جيرارت، هل تنوي الموت في معركة كمحارب؟

71
00:05:59,470 --> 00:06:04,100
.لا يسعني سوى أن أرغب في ذلك يا شين

72
00:06:05,450 --> 00:06:09,970
.أريد منازلتكَ أنتَ المحارب الأقوى

73
00:06:10,670 --> 00:06:18,410
ما مدى كفاءة أنيابي ضدّ بشريّ خارق مثلك؟

74
00:06:22,310 --> 00:06:25,210
.حسنًا. مفهوم

75
00:06:28,110 --> 00:06:30,550
هل أخبرت ولفغانغ والبقيّة؟

76
00:06:31,300 --> 00:06:33,370
.أخبرتهم بشأن ما تبقّي لي لأعيشه

77
00:06:33,660 --> 00:06:37,220
،لم أخبرهم بعد بشأن النّزال
.لكنّي لن أخفي الأمر

78
00:06:37,220 --> 00:06:39,250
.أنوي إطلاعهم عليه

79
00:06:40,090 --> 00:06:44,800
.ومع ذلك، أعتقد أنّ فان وراجيم قد أدركا ما أريد

80
00:06:44,800 --> 00:06:46,040
أخواك في السّلاح؟

81
00:06:46,040 --> 00:06:46,880
.نعم

82
00:06:47,730 --> 00:06:51,640
.إنّنا نقاتل معًا منذ اختفائك

83
00:06:52,010 --> 00:06:56,510
.إنّهما اثنان من أنواع الوحوش الّتي تعيش طويلاً

84
00:06:56,890 --> 00:06:59,970
.لقد تبعاني طوال هذه المدّة

85
00:07:00,390 --> 00:07:03,260
.لكنّ الزّمن نال منّا جميعًا

86
00:07:03,260 --> 00:07:07,670
.حان الوقت لتتحرّر هذه البلاد من تأثيرنا

87
00:07:08,150 --> 00:07:11,530
.سمعت أنّ ولفغانغ حاكم استثنائيّ

88
00:07:11,530 --> 00:07:12,160
.نعم

89
00:07:12,580 --> 00:07:16,610
إنّه يصغي للشّعب ويستطيع السّير
.معهم على قدم المساواة

90
00:07:17,030 --> 00:07:20,160
.إنّه سلفًا خير بديل لي

91
00:07:20,490 --> 00:07:22,270
هل ندمت على أيّ شيء؟

92
00:07:23,380 --> 00:07:26,420
.ندمي الوحيد هو أنّي لم أنازلك

93
00:07:30,630 --> 00:07:31,810
.فهمت

94
00:07:35,870 --> 00:07:38,930
.هناك أمر أودّ إطلاعكم عليه

95
00:07:39,740 --> 00:07:41,690
.وجدت المكان الّذي سأموت فيه

96
00:07:42,040 --> 00:07:42,720
ماذا؟

97
00:07:43,650 --> 00:07:46,060
ما الّذي تعنيه بذلك؟

98
00:07:46,530 --> 00:07:49,190
.سبق وأخبرتكم كم بقي من حياتي

99
00:07:49,950 --> 00:07:54,070
.طلبتُ من شين أن ينازلني قبل أن تحين ساعتي

100
00:07:54,980 --> 00:07:57,330
.سيُقام النّزال بعد أسبوع من الآن

101
00:07:58,830 --> 00:08:00,700
.هكذا إذًا

102
00:08:00,700 --> 00:08:04,830
.أرى أنّ الوقت قد حان أخيرًا

103
00:08:05,120 --> 00:08:10,310
.نعم. إنّ أمنيتي التّي لم تتحقّق ستتحقّق أخيرًا

104
00:08:11,030 --> 00:08:12,250
.هذا مفهوم

105
00:08:14,670 --> 00:08:18,640
كيف... كيف لكم أن تكونوا هادئين هكذا؟

106
00:08:19,040 --> 00:08:20,410
...إنّك سوف

107
00:08:20,940 --> 00:08:22,600
.عشتُ حياة طويلة

108
00:08:24,670 --> 00:08:29,210
،شهدتُ موت العديد من رفاقي وأبنائهم

109
00:08:30,150 --> 00:08:33,430
.حتّى أنّي اعتنيت بأحفادهم على أفرشة موتهم

110
00:08:35,450 --> 00:08:38,990
لماذا عشتُ كلّ هذا الوقت؟

111
00:08:40,250 --> 00:08:43,370
.ستعرفين السّبب بعد أسبوع

112
00:08:44,100 --> 00:08:46,690
.أريدك أن تشهدي ذلك بأمّ عينيك

113
00:08:51,050 --> 00:08:51,940
.حاضرة

114
00:08:54,530 --> 00:08:56,390
.سنتقاتل في غابة رالوا

115
00:08:56,980 --> 00:09:01,010
.ستكون أعظم وآخر معركة في حياتي

116
00:09:01,620 --> 00:09:03,520
.أريدكم أن تشهدوا عليها جميعكم

117
00:09:04,230 --> 00:09:05,140
!حاضر

118
00:09:12,780 --> 00:09:14,530
نزال؟

119
00:09:15,860 --> 00:09:19,030
مع أنّه تسنّت لي فرصة رؤية
...ثانية للتّوّ فقط

120
00:09:19,030 --> 00:09:19,580
شين؟

121
00:09:23,010 --> 00:09:24,540
هل من خطب ما؟

122
00:09:24,840 --> 00:09:26,670
.لا، ما من خطب

123
00:09:28,050 --> 00:09:29,040
.أنا بخير

124
00:09:35,390 --> 00:09:40,490
.شين، أنا معجب بك كثيرًا

125
00:09:41,330 --> 00:09:45,260
.ندمتُ ندمًا كبيرًا بعد اختفائك

126
00:09:46,120 --> 00:09:49,670
.ندم ما بعده ندم

127
00:09:53,830 --> 00:09:58,070
.كان قد صار العالم باهتًا بدونك

128
00:09:59,010 --> 00:10:03,330
.تخلّيتُ عن أمنيتي معتقدًا أنّها لن تتحقّق أبدًا

129
00:10:04,590 --> 00:10:06,780
.أنا ممتنّ لك يا شين

130
00:10:48,740 --> 00:10:51,240
.أعدتها لحالتها المثاليّة

131
00:10:51,240 --> 00:10:53,420
.يمكنك الآن أن تقاتل بكلّ ما لديك

132
00:10:53,420 --> 00:10:54,680
!أجل

133
00:10:54,680 --> 00:10:56,760
!أشعر وكأنّ الزّمن عاد للوراء

134
00:10:57,620 --> 00:10:59,260
.أنا ممتنّ لك يا شين

135
00:10:59,950 --> 00:11:01,010
.هذا لا شيء

136
00:11:01,950 --> 00:11:03,850
.غدًا هو اليوم المنتظر

137
00:11:04,390 --> 00:11:05,270
.نعم

138
00:11:06,490 --> 00:11:10,450
شين، أعلم أنّه عليّ ألاّ أقحم
...أنفي فيما لا يعنيني

139
00:11:11,380 --> 00:11:12,300
ماذا تقصد؟

140
00:11:15,610 --> 00:11:18,450
أهذا عن شني؟

141
00:11:19,890 --> 00:11:20,750
.نعم

142
00:11:21,630 --> 00:11:28,170
إن عثرتَ على طريقة للعودة
إلى عالمك، فهل ستذهب؟

143
00:11:29,460 --> 00:11:31,410
هل ستترك شني خلفك؟

144
00:11:39,700 --> 00:11:40,660
.سأعود لدياري

145
00:11:43,020 --> 00:11:47,690
.ذلك هو السّبب الّذي دفعني لمواصلة القتال

146
00:11:51,350 --> 00:11:52,350
.فهمت

147
00:11:53,490 --> 00:11:54,310
.آسف

148
00:11:54,870 --> 00:11:57,770
.لا، أنا من عليك الاعتذار

149
00:11:58,260 --> 00:12:00,070
.ما كان عليّ أن أسألك

150
00:12:02,540 --> 00:12:04,570
.إنّه أمر صعب

151
00:12:07,030 --> 00:12:14,630
ليت كانت هنالك طريقة لحلّ كلّ شيء
.دفعة واحدة، بالنّسبة لي وبالنّسبة لشني

152
00:12:15,100 --> 00:12:18,690
كنت تصف نفسك بشيء ما
...في كلّ مرّة تُواجه فيها مشكلة

153
00:12:18,690 --> 00:12:20,840
أكان انتهازيّ؟

154
00:12:20,840 --> 00:12:25,470
نعم. أردتُ كلّ شيء أن يسير على هواي

155
00:12:25,470 --> 00:12:29,600
وأصل إلى نهاية سعيدة
.حيث أعيش فيها بسعادة وهناء

156
00:12:31,070 --> 00:12:35,690
.ذلك ليس أمرًا سيتسنّى لنا أن نعيشه

157
00:12:35,690 --> 00:12:36,570
.تمامًا

158
00:12:39,590 --> 00:12:42,610
.أنا أتطلّع قدمًا للغد

159
00:12:44,980 --> 00:12:45,750
.نعم

160
00:12:51,380 --> 00:12:53,580
.اليوم المثاليّ لنزال

161
00:12:53,580 --> 00:12:56,170
أليس كذلك؟ كيف تشعر؟

162
00:12:56,170 --> 00:12:57,580
.أنا جاهز في أيّ وقت

163
00:12:57,580 --> 00:13:01,140
!جسدي وذهني مليئان بالحماسة

164
00:13:03,650 --> 00:13:06,390
.سننتظر هنا

165
00:13:06,390 --> 00:13:09,100
إن حدث وكانت هنالك أيّ هجمات
.طائشة، فسأعتمد عليك لإيقافها

166
00:13:09,460 --> 00:13:13,490
،نعم. لا داعي للقلق حيال أيّ شيء
.وقاتلا بكلّ ما أوتيتما من قوّة

167
00:13:13,490 --> 00:13:14,450
.مفهوم

168
00:13:17,020 --> 00:13:19,780
.سأترك جيرارت بين يديك

169
00:13:19,780 --> 00:13:20,570
.نعم

170
00:13:20,570 --> 00:13:21,690
...عفوًا

171
00:13:22,390 --> 00:13:23,690
.سنراك لاحقًا

172
00:13:23,690 --> 00:13:24,860
!حظًّا سعيدًا يا شين

173
00:13:26,180 --> 00:13:27,360
.سأعود

174
00:13:28,450 --> 00:13:30,060
.سأترك الباقي لكم

175
00:13:30,060 --> 00:13:31,300
.حظًّا سعيدًا

176
00:13:32,660 --> 00:13:35,870
.لن أنسى تعاليمك أبدًا كأوّل الملوك

177
00:13:36,320 --> 00:13:38,580
.أعد أنّك ستترك المملكة وشعبها بين أيد أمينة

178
00:13:38,580 --> 00:13:39,330
.نعم

179
00:13:42,620 --> 00:13:43,870
...أنا

180
00:13:47,020 --> 00:13:48,090
...أنا أيضًا

181
00:13:50,680 --> 00:13:53,890
.سأصير محاربة جديرة بحمل دماء أوّل الملوك

182
00:13:54,490 --> 00:13:55,290
.جيّد

183
00:13:58,280 --> 00:13:59,290
هل نذهب؟

184
00:13:59,290 --> 00:14:00,050
.نعم

185
00:14:01,400 --> 00:14:05,100
.لم أرَ الملك مبتسمًا هكذا منذ مدّة

186
00:14:05,100 --> 00:14:07,400
.إنّه يبتسم وكأنّه طفل صغير

187
00:14:11,460 --> 00:14:17,020
.دعونا نشهد على تحقيق الملك الأوّل لأمنيته معًا

188
00:14:19,280 --> 00:14:20,010
.نعم

189
00:14:25,130 --> 00:14:26,300
أأنت جاهز؟

190
00:14:26,650 --> 00:14:27,740
.بكلّ تأكيد

191
00:14:38,220 --> 00:14:39,210
.بدأ النّزال

192
00:14:40,100 --> 00:14:41,690
!شين

193
00:14:41,690 --> 00:14:43,820
!جيرارت

194
00:14:47,900 --> 00:14:49,570
!إنّ هجماتك قويّة كما عهدتُها

195
00:14:50,510 --> 00:14:53,580
!لا تتصرّف وكأنّك غير قادر على التّصدّي لها

196
00:15:01,020 --> 00:15:03,840
ألا يُذكّرك هذا بالأيّام قبل خمسمائة سنة؟

197
00:15:04,220 --> 00:15:07,090
!يبدو الأمر وكأنّه حدث بالأمس فقط بالنّسبة لي

198
00:15:08,900 --> 00:15:10,580
!بالطّبع

199
00:15:12,180 --> 00:15:13,720
!وأنا كذلك

200
00:15:19,460 --> 00:15:20,610
.هذا مذهل

201
00:15:20,610 --> 00:15:23,730
.لم أكن أعلم أنّ الملك الأوّل قويّ لهذا الحدّ

202
00:15:26,330 --> 00:15:28,690
.سينتهيان من الإحماء قريبًا

203
00:15:28,690 --> 00:15:31,540
.لطالما كانت إحماءاته عرضًا يستحقّ المشاهدة

204
00:15:31,540 --> 00:15:34,180
.هذا هو ما عهدناه من ملكنا

205
00:15:34,670 --> 00:15:37,240
تقصدون أنّ هذا القتال لم يكن بكامل قوّتهما؟

206
00:15:37,240 --> 00:15:38,500
.بالطّبع لا

207
00:15:38,890 --> 00:15:41,870
معلّمتي، أنت أيضًا بنفس هذا
القدر من القوّة، صحيح؟

208
00:15:42,450 --> 00:15:46,340
.حتّى أنا كنتُ لأعاني في مواجهة جيرارت

209
00:15:46,340 --> 00:15:49,630
...لكنّ ذلك ما زال يعني أنّها أقوى

210
00:15:49,940 --> 00:15:53,510
.هذه معركة بين بشريّ سامٍ وجيرارت

211
00:15:53,930 --> 00:15:56,030
.علينا أن ننقش هذا في أذهاننا

212
00:15:59,370 --> 00:16:04,060
.حتّى التّقنيات الّتي طوّرتُها لقتالك لا فائدة منها

213
00:16:04,060 --> 00:16:06,150
.هذا هو ما أتوقّعه من سيّدي

214
00:16:06,420 --> 00:16:09,900
.لا تدّعي الغباء. أعلم أنّك أقوى من هذا

215
00:16:10,210 --> 00:16:13,150
.نعم. سأضع كلّ شيء على المحكّ الآن

216
00:16:13,630 --> 00:16:16,500
...اسمعني. شاهدني بينما أصير

217
00:16:17,140 --> 00:16:19,410
!نابًا منفردًا

218
00:16:30,060 --> 00:16:30,800
.شين

219
00:16:31,790 --> 00:16:33,980
.أعرف كيف تشعر

220
00:16:35,800 --> 00:16:37,930
.سأقاتل بكلّ ما لديّ غدًا

221
00:16:38,450 --> 00:16:42,180
لكنّي لن أستعمل الألقاب الّتي حصلتُ
.عليها بعد هزيمة الزّعيم النّهائيّ

222
00:16:42,580 --> 00:16:44,940
إنّ الاعتماد على قدرة غير عادلة
.كهذه لن يكون رائعًا

223
00:16:45,820 --> 00:16:49,820
.لو كنتُ مكان شين، لفعلتُ نفس الشّيء

224
00:16:50,170 --> 00:16:55,450
،حتّى إن انتهى هذا في رمشة عين

225
00:16:56,380 --> 00:16:58,740
.أريد أن أقاتل شين بكلّ قوّتي

226
00:17:00,580 --> 00:17:07,420
هذه هي اللّحظة الوحيدة الّتي
!بإمكان أنيابي أن تصلك فيها

227
00:17:08,170 --> 00:17:09,590
!سأهاجم

228
00:17:15,180 --> 00:17:16,340
!بطيء

229
00:17:19,780 --> 00:17:22,810
!لم تعتقد أنّ بإمكانك هزيمتي بهذا، صحيح؟

230
00:17:22,810 --> 00:17:23,850
!بالطّبع لا

231
00:17:27,710 --> 00:17:28,520
.سيهاجم

232
00:17:31,500 --> 00:17:33,240
...تقنيتي الأقوى

233
00:17:33,240 --> 00:17:36,020
!الامتياز الأسطوريّ

234
00:17:44,130 --> 00:17:46,000
!هذا هجوم قويّ بالفعل

235
00:17:48,000 --> 00:17:49,460
!يد الزّهور الثّمانية

236
00:17:50,820 --> 00:17:53,510
!الينبوع التّوأم الطّائر

237
00:17:53,510 --> 00:17:55,800
.إنّه يستعمل مهارات مختلفة معًا

238
00:17:55,800 --> 00:18:00,510
لا بدّ أنّه بذل جهدًا لا يصدّق
.في تدريباته ليطوّر هذه الاستراتيجيّة

239
00:18:03,260 --> 00:18:07,900
...هذا مثير للشّفقة. بينما هو يخاطر بحياته، أنا

240
00:18:09,330 --> 00:18:11,150
.أنا آسف يا جيرارت

241
00:18:11,830 --> 00:18:14,780
.لم أكن أقاتل بكلّ قوّتي

242
00:18:20,160 --> 00:18:22,410
!هذه هي الرّوح المطلوبة

243
00:18:23,660 --> 00:18:24,750
...الهجوم الأسطوريّ

244
00:18:25,680 --> 00:18:28,160
!الامتياز

245
00:18:28,160 --> 00:18:30,250
!التّقطيع السّماويّ

246
00:18:33,990 --> 00:18:35,670
.سينتهي هذا قريبًا

247
00:18:46,810 --> 00:18:48,810
!نلت منك

248
00:18:59,930 --> 00:19:01,010
جيرارت؟

249
00:19:05,940 --> 00:19:07,060
!جيرارت

250
00:19:07,060 --> 00:19:08,580
.سمعتك

251
00:19:10,500 --> 00:19:13,750
.يبدو أنّ هذه هي النّهاية

252
00:19:14,770 --> 00:19:18,350
.نلت منّي في النّهاية. أنا فعلاً منبهر يا جيرارت

253
00:19:19,870 --> 00:19:22,590
.لم أعش لخمسمائة سنة هباءً

254
00:19:23,020 --> 00:19:26,600
.استطاع هذا النّاب تنفيذ هجمة ناجحة ضدّك

255
00:19:27,570 --> 00:19:29,940
.تحقّقت أمنيتي بعد طول انتظار

256
00:19:30,390 --> 00:19:35,770
شين، هلاّ قمتَ بأمر ما لأجلي
كمكافأة على نجاحي في إصابتك؟

257
00:19:35,770 --> 00:19:36,480
ما هو؟

258
00:19:37,270 --> 00:19:41,200
.أنا مسرور لأنّي قاتلتك بكلّ قوّتي

259
00:19:41,200 --> 00:19:44,410
لكن هنالك المزيد، صحيح؟

260
00:20:07,890 --> 00:20:10,640
.لم تكن لديّ أدنى فكرة أنّك بهذه القوّة

261
00:20:14,110 --> 00:20:15,290
.الوداع

262
00:20:16,110 --> 00:20:17,310
...جيرارت

263
00:20:18,420 --> 00:20:19,490
.إلى اللّقاء

264
00:20:27,370 --> 00:20:32,170
.نعم... هذا هو المتوقّع من معلّمي

265
00:20:37,750 --> 00:20:39,260
.انتهى النّزال

266
00:20:45,910 --> 00:20:48,730
!جيرارت

267
00:20:55,460 --> 00:21:01,070
.نجح ملككم في تنفيذ هجمة ضدّ بشريّ سامٍ

268
00:21:01,730 --> 00:21:06,070
.هذا يعني أنّ جيرارت قد ارتقى لمستوانا

269
00:21:07,820 --> 00:21:09,090
...جيرارت

270
00:21:09,410 --> 00:21:12,820
.انظروا إلى وجه الملك

271
00:21:14,300 --> 00:21:17,780
.تعلو وجهه ملامح الرّضا

272
00:21:18,080 --> 00:21:20,920
.ليس نادمًا على أيّ شيء

273
00:21:20,920 --> 00:21:22,220
.ذلك صحيح

274
00:21:22,220 --> 00:21:25,970
.نعم. كان ليضحك علينا إن رآنا نبكي

275
00:22:11,980 --> 00:22:13,010
شني؟

276
00:22:13,810 --> 00:22:17,770
.يبدو وكأنّك ستختفي إلى مكان ما

277
00:22:18,540 --> 00:22:19,770
.سأفعل أيّ شيء

278
00:22:20,510 --> 00:22:23,940
إن كان هنالك أيّ شيء يمكنني
.فعله لأجلك، فأخبرني رجاءً

279
00:22:25,100 --> 00:22:26,590
.أعلم ذلك

280
00:22:28,190 --> 00:22:31,510
.أعلم أنّ هذا هو ما أراده جيرارت

281
00:22:32,050 --> 00:22:32,780
.نعم

282
00:22:33,630 --> 00:22:35,980
.قبلتُ بذلك وقاتلتُه

283
00:22:36,510 --> 00:22:37,290
.نعم

284
00:22:38,060 --> 00:22:39,220
...لكن

285
00:22:39,810 --> 00:22:40,420
.نعم

286
00:22:42,230 --> 00:22:44,670
.إنّ موت صديق أمر مؤلم للغاية

287
00:22:46,690 --> 00:22:49,430
.أديّت واجبك يا شين

288
00:22:50,690 --> 00:22:51,680
.يمكنك أن تبكي الآن

289
00:22:52,740 --> 00:22:54,930
.لا ضرّر من الشّعور بالحزن الآن