1
00:00:02,600 --> 00:00:04,320
ما هذا؟

2
00:00:04,320 --> 00:00:06,030
ملصقٌ لأجل نادي الدراما

3
00:00:06,030 --> 00:00:07,320
أليس جميلا؟

4
00:00:08,080 --> 00:00:10,050
ألم تتم المبالغة قليلا بالرسم؟

5
00:00:10,050 --> 00:00:11,570
ما المانع
إنها رائعة

6
00:00:12,080 --> 00:00:15,120
ما رأيكِ بالموضوع يا كاثارين؟

7
00:00:15,120 --> 00:00:20,160
سوغيموتو شيءٌ رائع بالفعل
لكن لم أتوقع منها إبداء هذا الكم من الجمال

8
00:00:20,160 --> 00:00:23,290
كانت هذه كلمةً من الممثلة الظاهرة أيضا في الملصق

9
00:00:23,640 --> 00:00:25,930
أنتِ حقا جميلة يا كاواساكي

10
00:00:25,930 --> 00:00:27,650
كفي عن هذا

11
00:00:32,870 --> 00:00:34,800
أتساءل إن كان بإمكاني أخذه حينما ينتهي العرض

12
00:00:34,800 --> 00:00:36,260
أريد تعليقه في غرفتي

13
00:00:41,140 --> 00:00:43,430
إنه منخفضٌ بعض الشيء

14
00:00:44,300 --> 00:00:45,770
أنتِ محقة

15
00:00:45,770 --> 00:00:46,730
لاصق

16
00:00:51,750 --> 00:00:54,260
ستبدأ الإعادة قريبا

17
00:00:54,260 --> 00:00:56,110
لننتهِ بسرعة

18
00:02:28,850 --> 00:02:30,880
أرأيتِ ذلك الملصق الجنوني؟

19
00:02:30,880 --> 00:02:33,180
أجل، أعتقد أنه رائع

20
00:02:33,180 --> 00:02:34,460
حقا؟

21
00:02:35,220 --> 00:02:37,420
!سوغيموتو

22
00:02:37,910 --> 00:02:39,710
ما هو رأيكِ بالملصق؟

23
00:02:39,710 --> 00:02:44,180
آسفةٌ لكونكِ بذلتِ الكثير من الجهد فيه

24
00:02:44,180 --> 00:02:46,680
...بتاتا، أود أن أفعل المزيد من أجلـ

25
00:02:51,710 --> 00:02:54,150
ابذلي جهدكِ على المسرح

26
00:02:55,320 --> 00:02:56,320
شكرا لكِ

27
00:02:59,820 --> 00:03:01,400
تحدثت إليها

28
00:03:08,040 --> 00:03:09,790
عمّ تحدثتِ؟

29
00:03:09,790 --> 00:03:11,000
إنه سر

30
00:03:11,000 --> 00:03:12,910
هذا لؤم

31
00:03:15,980 --> 00:03:17,280
...أنتِ

32
00:03:19,230 --> 00:03:23,390
أنتِ محبوبة من قبل الجميع

33
00:03:23,660 --> 00:03:25,390
ماذا؟ أتغارين؟

34
00:03:27,020 --> 00:03:28,610
أتساءل بشأن هذا

35
00:03:29,310 --> 00:03:30,100
فومي؟

36
00:03:48,650 --> 00:03:50,560
لا فائدة

37
00:03:50,560 --> 00:03:53,080
قلت لكِ أن علينا الاقتراب أكثر

38
00:03:56,540 --> 00:03:58,500
أجد نفسي أشك فيها

39
00:04:03,290 --> 00:04:07,390
أتساءل إن كانت معجبةً بشخصٍ آخر

40
00:04:08,320 --> 00:04:10,760
هذا جلّ ما أفكر فيه مذّاك الوقت

41
00:04:11,760 --> 00:04:14,980
تفكيري بهذا يعيق حديثي معها

42
00:04:16,730 --> 00:04:19,610
،لا أدري بشأن هذا

43
00:04:21,230 --> 00:04:24,110
لكن يقال أن الشخص يصيبه القلق حينما يكن مشاعرا لأحدهم

44
00:04:24,700 --> 00:04:26,500
ألا يمكن أن يكون شيئا كهذا؟

45
00:04:28,770 --> 00:04:30,240
قد تكونين على حق

46
00:04:31,180 --> 00:04:32,430
أوكودايرا

47
00:04:33,230 --> 00:04:35,060
آه، إيكومي

48
00:04:35,060 --> 00:04:37,100
أي عصيرٍ تريدين؟

49
00:04:37,100 --> 00:04:38,040
عصير؟

50
00:04:38,040 --> 00:04:39,700
أسأل الجميع

51
00:04:39,700 --> 00:04:41,790
طلبت مني رئيسة النادي أن أحضر البعض منه

52
00:04:41,790 --> 00:04:42,760
سآتي معكِ

53
00:04:43,430 --> 00:04:44,430
ها هي

54
00:04:44,820 --> 00:04:46,430
أوكودايرا

55
00:04:46,880 --> 00:04:49,310
...إن عصا هيسكليف

56
00:04:49,310 --> 00:04:51,770
يا إلهي، لقد كُسرت

57
00:04:52,110 --> 00:04:54,240
حسنٌ، أنا آتية

58
00:04:56,660 --> 00:04:58,270
آسفةٌ يا إيكومي

59
00:04:59,260 --> 00:05:00,240
لا عليكِ

60
00:05:00,240 --> 00:05:02,170
إذا ما الذي ترغبين بشربه؟

61
00:05:02,170 --> 00:05:03,920
عصير البرتقال من فضلكِ

62
00:05:03,920 --> 00:05:05,410
أراكِ لاحقا يا فومي

63
00:05:05,410 --> 00:05:07,130
حسنٌ، حظا موفقا

64
00:05:15,470 --> 00:05:17,860
مانجومي؟

65
00:05:17,860 --> 00:05:19,420
نعم؟

66
00:05:19,420 --> 00:05:21,620
أتريدين شرب شيءٍ ما؟

67
00:05:28,510 --> 00:05:31,280
آسفةٌ لطلبي منكِ مساعدتي

68
00:05:31,280 --> 00:05:32,310
لا عليكِ

69
00:05:39,530 --> 00:05:42,190
إذن أوَأنتِ معجبةٌ بسوغيموتو؟

70
00:05:49,560 --> 00:05:50,970
إذن أنتِ أيضا؟

71
00:05:52,620 --> 00:05:55,160
إنها حقا شخصٌ رائع

72
00:05:56,270 --> 00:05:58,420
هناك الكثير ممن يحبها من الفتيات

73
00:05:59,110 --> 00:06:01,480
يبدو ذلك

74
00:06:09,000 --> 00:06:11,410
عملٌ جيد جميعا

75
00:06:11,410 --> 00:06:12,530
انتهينا أخيرا

76
00:06:12,530 --> 00:06:14,820
عملٌ جيد

77
00:06:22,420 --> 00:06:27,910
عملٌ جيد

78
00:06:27,910 --> 00:06:29,250
أنتِ كذلك

79
00:06:29,250 --> 00:06:31,120
كنتِ رائعة

80
00:06:31,120 --> 00:06:33,210
شكرا لكِ
أحذري في طريقكِ للمنزل

81
00:06:34,010 --> 00:06:35,110
أسمعتي ذلك؟

82
00:06:35,110 --> 00:06:35,910
لؤم

83
00:06:36,960 --> 00:06:38,080
تفضلي

84
00:06:38,080 --> 00:06:40,460
كيوكو، أنتِ مراعيةٌ كثيرا

85
00:06:42,500 --> 00:06:43,290
...معذرةً

86
00:06:43,600 --> 00:06:44,400
فومي

87
00:06:50,150 --> 00:06:53,050
فليأتِ طلاب السنة الثالثة جميعا
لدينا اجتماع

88
00:06:53,050 --> 00:06:56,240
بإمكان طلاب السنة الثانية والأولى الذهاب للمنزل ما إن ينهوا الترتيبات

89
00:06:56,240 --> 00:06:57,520
حسنٌ

90
00:06:57,910 --> 00:07:01,060
قد يستغرق هذا وقتا
لذا ليس عليكِ انتظاري يا فومي

91
00:07:01,060 --> 00:07:02,070
حسنٌ

92
00:07:04,230 --> 00:07:06,190
سنبدأ يا سوغيموتو

93
00:07:12,800 --> 00:07:14,320
آسفةٌ على التأخير

94
00:07:14,320 --> 00:07:16,990
...حسنٌ، ابدئي من الصفحة الخامسة والسبعون

95
00:07:18,260 --> 00:07:19,710
!فومي-تشان

96
00:07:22,480 --> 00:07:23,630
آتشان

97
00:07:23,630 --> 00:07:25,840
ألن تذهبي للمنزل مع سوغيموتو اليوم؟

98
00:07:25,840 --> 00:07:28,460
بلى، قالت إنها ستتأخر اليوم

99
00:07:28,820 --> 00:07:30,640
أتريدين مشاركتنا شرب الشاي؟

100
00:07:30,640 --> 00:07:32,260
إيكومي ستأتي أيضا

101
00:07:36,590 --> 00:07:38,610
لا بأس ما دمتما أنتما الاثنتان

102
00:07:38,610 --> 00:07:41,150
إيكومي، أتمانعين مجيء فومي معنا؟

103
00:07:41,150 --> 00:07:42,650
بالطبع لا

104
00:07:59,460 --> 00:08:01,410
إنهن فتياتي

105
00:08:01,800 --> 00:08:03,610
أخذهن معي حيثما ذهبت

106
00:08:05,390 --> 00:08:06,240
فومي

107
00:08:24,310 --> 00:08:28,360
آه، أمي
أنا قريبةٌ من محطة كاماكورا

108
00:08:28,640 --> 00:08:31,070
أجل، مع آتشان وصديقةً أخرى

109
00:08:31,880 --> 00:08:34,710
إنها حريصةٌ لاتصالها بالمنزل كي يطمئنوا عليها

110
00:08:34,710 --> 00:08:37,320
إن فومي فتاةٌ جيدة بحق

111
00:08:38,330 --> 00:08:39,450
إنها كذلك

112
00:08:41,700 --> 00:08:45,120
تحبها سنباي، أليس كذلك؟

113
00:08:45,500 --> 00:08:46,050
ها؟

114
00:08:50,770 --> 00:08:51,830
...أنا

115
00:08:53,420 --> 00:08:55,550
...أخطئ الفهم على الدوام

116
00:08:55,550 --> 00:08:56,590
!إيكومي؟

117
00:08:56,870 --> 00:08:58,370
!ما الخطب؟

118
00:08:58,370 --> 00:08:59,310
!مهلا

119
00:09:48,590 --> 00:09:49,560
هل أيقظتكِ؟

120
00:09:50,120 --> 00:09:50,980
لا

121
00:09:51,390 --> 00:09:53,530
...ليس بالأمر الجلل، لكن

122
00:09:56,680 --> 00:10:00,720
لم تقولي أنكِ ستكونين بانتظاري
لذا أصابني القلق

123
00:10:00,720 --> 00:10:02,200
آسفة

124
00:10:05,520 --> 00:10:08,640
لو كان يشغل تفكيركِ شيء فأخبريني

125
00:10:12,020 --> 00:10:13,870
قولي لي يا فومي

126
00:10:13,870 --> 00:10:15,500
لن أتمكن من النوم على هذا الحال

127
00:10:18,880 --> 00:10:22,050
تكلمت مع إيكومي كيوكو

128
00:10:23,100 --> 00:10:26,320
قالت أنها تحبكِ والدموع تملأ عينيها

129
00:10:28,030 --> 00:10:28,850
فهمت

130
00:10:33,540 --> 00:10:34,670
اسمعي يا فومي

131
00:10:34,670 --> 00:10:35,560
نعم؟

132
00:10:36,570 --> 00:10:38,110
أتذكرين حبكِ الأول؟

133
00:10:38,110 --> 00:10:39,200
ها؟

134
00:10:40,230 --> 00:10:44,800
أتذكرين أول شخصٍ أحببتهِ؟

135
00:10:48,620 --> 00:10:49,960
!فومي

136
00:10:50,320 --> 00:10:52,670
صباح الخير

137
00:10:59,510 --> 00:11:00,340
ها؟

138
00:11:02,620 --> 00:11:06,640
أتصلت بي سوغيموتو البارحة

139
00:11:06,640 --> 00:11:08,390
ها؟! هذا مُسِر

140
00:11:08,710 --> 00:11:09,450
بالفعل

141
00:11:13,180 --> 00:11:14,940
أتذكرين حبكِ الأول؟

142
00:11:17,180 --> 00:11:20,270
حبي... الأول

143
00:11:27,950 --> 00:11:34,690
ينتهي اليوم بالنسبة لجميع الطلاب ما عدى من سيشاركون في المسرحية والطاقم

144
00:11:34,690 --> 00:11:35,500
أكرر

145
00:11:35,830 --> 00:11:38,170
ألا تشعرين وكأنّا نسينا شيئا؟

146
00:11:38,170 --> 00:11:40,090
ربما يجدر بنا إضافة المزيد من الزهور

147
00:11:40,360 --> 00:11:42,290
آه، ربما يكون هذا صحيحا

148
00:11:50,900 --> 00:11:51,850
انظري

149
00:11:52,520 --> 00:11:54,800
ذكريني ما الذي سيقدمونه المدرسة الابتدائية

150
00:11:54,800 --> 00:11:56,020
أليست مسرحية الأمير الصغير؟

151
00:11:56,440 --> 00:11:58,420
تلك الفتاة هي الأمر الصغير؟

152
00:11:58,420 --> 00:11:59,230
أجل

153
00:11:59,230 --> 00:12:01,200
ماذا عن الزهرة؟

154
00:12:01,200 --> 00:12:02,970
أليست تلك هي؟

155
00:12:02,970 --> 00:12:04,720
يا للطافتها

156
00:12:06,320 --> 00:12:08,340
حاذر أن تصطدم بشيء

157
00:12:08,340 --> 00:12:09,490
حاضر

158
00:12:09,490 --> 00:12:11,320
إنها ضعيفة

159
00:12:11,320 --> 00:12:12,280
عُلم

160
00:12:22,510 --> 00:12:24,900
إذن هم يتدربون للمرة الأخيرة

161
00:12:24,900 --> 00:12:27,930
أتعلمين أين سوغيموتو؟

162
00:12:27,930 --> 00:12:30,100
أجزم أنها ليست هنا بعد

163
00:12:30,100 --> 00:12:32,160
أتساءل متى سيكون بإمكاننا رؤيتها

164
00:12:32,160 --> 00:12:35,570
...يقوم طلاب الابتدائية بمسرحيتهم أولا، لذا

165
00:12:35,570 --> 00:12:37,500
على أي حال
هي ليست هنا بعد

166
00:12:37,500 --> 00:12:38,860
نراكما لاحقا

167
00:12:45,020 --> 00:12:46,870
ما من داعٍ للقلق كثيرا

168
00:12:47,580 --> 00:12:48,830
وداعا

169
00:12:53,150 --> 00:12:54,210
وداعا

170
00:12:54,490 --> 00:12:56,790
أجل، وداعا

171
00:12:57,150 --> 00:13:00,250
لا بأس حقا يا أوكودايرا

172
00:13:00,780 --> 00:13:03,260
بالنسية لحيوانٍ كبير
لا أود ايذاؤهم

173
00:13:03,260 --> 00:13:06,020
أملك مخالبا

174
00:13:06,830 --> 00:13:10,180
جزمت قرارك بالرحيل
اذهب إذن

175
00:13:10,620 --> 00:13:13,040
...لم أتخيل ذلك

176
00:13:13,970 --> 00:13:18,120
شخصان يكن بعضهما المشاعر للآخر

177
00:13:18,120 --> 00:13:19,820
بإمكانهما التسبب بالأذى لطرفٍ ثالث

178
00:13:36,420 --> 00:13:38,360
كنت أحمقا

179
00:13:39,270 --> 00:13:42,990
لا يجدر بي الرحيل

180
00:13:44,690 --> 00:13:48,200
...كان علي ملاحظة

181
00:13:49,970 --> 00:13:52,890
ذلك الحنان الكامن تحت تلك المطالب الساذجة

182
00:13:57,680 --> 00:13:59,230
ألا تريدين الذهاب؟

183
00:14:01,220 --> 00:14:02,150
أجل

184
00:14:06,300 --> 00:14:09,680
لا أريد الذهاب أيضا إذا كنتِ لن تفعلي

185
00:14:09,680 --> 00:14:12,290
...لكنكِ تلعبين دور البطولة

186
00:14:16,410 --> 00:14:18,040
أتعتقدين أن رؤيتي لكيوكو اليوم سيكون أمرا أحمقا؟

187
00:14:19,190 --> 00:14:22,340
بالفعل

188
00:14:23,630 --> 00:14:26,370
طالما كنت أراها

189
00:14:26,370 --> 00:14:29,680
ذلك لأنها كانت تود رؤيتكِ

190
00:14:29,680 --> 00:14:32,800
أريد أن أطلب منكِ الخروج معي أيضا

191
00:14:32,800 --> 00:14:34,600
لا تقوليها بهذا الشكل

192
00:14:35,970 --> 00:14:38,690
أتشعرين بالأسف تجاهها يا فومي؟

193
00:14:44,790 --> 00:14:47,860
لا يهم
سأذهب وحدي اليوم

194
00:14:54,180 --> 00:14:55,440
هذا رائع

195
00:14:56,090 --> 00:14:58,080
أصنعتهِ بنفسكِ يا كيوكو؟

196
00:14:58,080 --> 00:15:00,480
من المستحيل علي انهاؤه لوحدي

197
00:15:00,480 --> 00:15:02,330
ساعدني الأخرون

198
00:15:04,450 --> 00:15:07,170
هذا عظيم
عملتم حسنا

199
00:15:07,170 --> 00:15:08,670
ل-لا عليكِ

200
00:15:08,670 --> 00:15:10,450
نقوم بعملنا فقط

201
00:15:11,550 --> 00:15:13,490
ما خطبكِ يا حمقاء؟

202
00:15:13,490 --> 00:15:14,660
آسفة، لم أقصد فعلها

203
00:15:14,660 --> 00:15:15,970
!سنباي

204
00:15:15,970 --> 00:15:18,080
أتحبين الحلويات؟

205
00:15:18,080 --> 00:15:19,770
أحضرنا كعكا

206
00:15:20,210 --> 00:15:21,990
...لو لم تمانعي

207
00:15:21,990 --> 00:15:23,110
رائع

208
00:15:23,440 --> 00:15:24,240
شكرا

209
00:15:24,240 --> 00:15:26,580
بما أنكما أحضرتماها لنتناولها معا؟

210
00:15:26,580 --> 00:15:28,900
ل-لا، لم يكن هذا مرادنا

211
00:15:29,400 --> 00:15:31,220
يتملق لها الجميع

212
00:15:31,220 --> 00:15:33,970
متأكدةٌ أن فومي لا تود رؤية هذا

213
00:15:33,970 --> 00:15:37,420
حسنٌ، سنهم بإحضار أطباقٍ وشوكات

214
00:15:37,420 --> 00:15:38,660
حسنٌ، أعتمد عليكما

215
00:15:39,060 --> 00:15:40,390
...إيكومي

216
00:15:41,660 --> 00:15:44,900
انظري يا كيوكو
إنها منزلية الصنع

217
00:15:44,900 --> 00:15:47,760
ألكِ أن تقفي قليلا يا سنباي؟

218
00:15:57,520 --> 00:16:00,250
من فضلكِ
ابقي ساكنة

219
00:16:00,250 --> 00:16:01,070
حسنٌ

220
00:16:08,510 --> 00:16:09,490
!آتشان

221
00:16:09,920 --> 00:16:11,470
أتريدين الكعك أيضا يا آتشان؟

222
00:16:11,470 --> 00:16:12,910
!ب-بكل سرور

223
00:16:13,260 --> 00:16:15,240
سأصغِّر حافتها قليلا

224
00:16:15,600 --> 00:16:18,530
أعلميني لو كانت ضيقةً عليكِ

225
00:16:18,530 --> 00:16:20,720
سأحضر أبريق شاي

226
00:16:20,720 --> 00:16:22,180
آسفةٌ لاتعابكِ

227
00:16:22,180 --> 00:16:24,290
...كنتُ لأطلب ذلك من فومي لو كانت هنا

228
00:16:32,750 --> 00:16:33,980
تعالي معي يا إيكومي

229
00:16:33,980 --> 00:16:34,690
ها؟

230
00:16:34,690 --> 00:16:36,300
!م-مهلا

231
00:16:39,460 --> 00:16:41,730
آتشان تملؤها الحيوية

232
00:16:44,330 --> 00:16:46,230
انظري
يا للروعة

233
00:16:46,580 --> 00:16:48,940
انظري كيف تلف ذراعيها حولها

234
00:16:48,940 --> 00:16:50,880
تبدو ذراعيها بذيئةً بعض الشيء

235
00:16:50,880 --> 00:16:52,490
أليست هذه رائعة؟

236
00:16:52,490 --> 00:16:54,570
أتساءل إن كانت ستقبلها على المسرح

237
00:16:54,570 --> 00:16:55,530
معذرةً

238
00:17:00,830 --> 00:17:02,850
ما كان ذلك؟

239
00:17:02,850 --> 00:17:04,500
مهلا، أهناك شايٌّ أسود؟

240
00:17:24,200 --> 00:17:28,440
يقوم الجميع بهذا الضجة لعدم صدق حبهم لها

241
00:17:29,850 --> 00:17:31,470
لكني مختلفة

242
00:17:40,370 --> 00:17:41,450
!ها؟

243
00:17:41,450 --> 00:17:44,960
آسفة، ما زال لدي شيءٌ لأقوم به

244
00:17:45,340 --> 00:17:46,370
أيجدر بي انتظاركِ؟

245
00:17:48,190 --> 00:17:49,170
لا عليكِ

246
00:18:03,180 --> 00:18:06,020
هل أنا معجبةٌ من معجباتكِ بالنسبة لكِ؟

247
00:18:07,470 --> 00:18:10,800
مثل بقية الفتيات

248
00:18:12,290 --> 00:18:14,070
أكان حديثكِ موجها لي؟

249
00:18:14,560 --> 00:18:16,900
نحن الوحيدتان هنا

250
00:18:17,610 --> 00:18:21,330
طلبتِ مني أن أعاملكِ كما كنت أفعل دائما

251
00:18:21,330 --> 00:18:23,980
لا تأخذي كلامكي بشكلٍ حرفي

252
00:18:23,980 --> 00:18:25,080
كنت أتصنع القوة

253
00:18:30,640 --> 00:18:33,550
كلامكِ هذا هو ما يجعلني أحبكِ

254
00:18:34,400 --> 00:18:35,360
أنتِ لطيفة

255
00:18:35,360 --> 00:18:37,570
أتعنين كأختكِ؟

256
00:18:37,570 --> 00:18:40,030
لديكِ مشكلةٌ حقا في تجاوز الأمور

257
00:18:40,030 --> 00:18:43,130
لكنكِ فتاةٌ جيدة لذا لن أضخم الأمر

258
00:18:43,130 --> 00:18:44,210
لئيمة

259
00:18:50,810 --> 00:18:52,640
سأكون بخير

260
00:18:57,890 --> 00:18:59,450
فومي

261
00:18:59,740 --> 00:19:02,160
ماذا يا أمي؟

262
00:19:02,460 --> 00:19:03,280
فومي

263
00:19:05,330 --> 00:19:06,580
سينباي

264
00:19:06,580 --> 00:19:07,600
ماذا؟

265
00:19:07,600 --> 00:19:11,310
آسف، أردت فقط رؤيتكِ

266
00:19:13,260 --> 00:19:15,710
أعمالٌ مكتبية؟

267
00:19:15,710 --> 00:19:16,970
أجل

268
00:19:16,970 --> 00:19:19,060
في المسرحية

269
00:19:19,060 --> 00:19:21,150
أخبرت رئيسة النادي هذا بالفعل

270
00:19:21,150 --> 00:19:22,050
ها؟

271
00:19:22,050 --> 00:19:25,600
حسبت أنكِ لن تأتي بطريقةٍ غير هذه

272
00:19:25,600 --> 00:19:27,270
...هذا

273
00:19:30,560 --> 00:19:33,020
هذا ليس صحيحا

274
00:19:34,760 --> 00:19:35,730
حقا؟

275
00:19:36,050 --> 00:19:37,920
إذن ستأتين إذا طلبت منكِ؟

276
00:19:37,920 --> 00:19:38,910
أجل

277
00:19:40,320 --> 00:19:41,030
حسنٌ

278
00:19:44,070 --> 00:19:44,700
...معذرةً

279
00:19:45,330 --> 00:19:46,160
ماذا؟

280
00:19:48,010 --> 00:19:49,680
حظا طيبا لكِ

281
00:19:51,200 --> 00:19:52,410
لكِ أيضا

282
00:19:54,400 --> 00:19:55,490
ألا تشعرين بالبرد؟

283
00:19:56,370 --> 00:19:57,810
أنا بخير

284
00:19:57,810 --> 00:20:00,480
أليس هذا زيا جديدا؟

285
00:20:03,210 --> 00:20:04,350
إنه لطيف

286
00:20:04,350 --> 00:20:06,510
لا تعبثي معي أرجوكِ

287
00:20:08,000 --> 00:20:11,230
يجدر بكِ اخبارها

288
00:20:11,540 --> 00:20:13,150
لم أحظَ بالفرصة

289
00:20:13,150 --> 00:20:15,220
أصابتني الغيرة فقط

290
00:20:15,220 --> 00:20:17,150
لا بأس فأنتِ فتاة

291
00:20:17,480 --> 00:20:22,700
على أي حال
عليكِ أن تلزمي الصراحة مع من تحبين

292
00:20:22,700 --> 00:20:25,500
قولي لها بوضوحٍ أنكِ لا تحبذين عبث بقية الفتيات معها

293
00:20:25,500 --> 00:20:26,700
!ها؟

294
00:20:26,700 --> 00:20:28,960
أليس هذا شيئا غريبا لقوله؟

295
00:20:28,960 --> 00:20:30,290
أتعتقدين ذلك؟

296
00:20:30,290 --> 00:20:35,390
مع هذا أشعر بالفرح
لأني ظننتكِ لن تذهبي إلى المسرحية

297
00:20:35,390 --> 00:20:38,690
في الواقع
أنا أيضا سعيدة

298
00:20:38,690 --> 00:20:41,540
لنفعل ما بوسعنا غدا

299
00:20:41,540 --> 00:20:42,610
حسنٌ

300
00:20:42,610 --> 00:20:44,240
آمل أن يسير كل شيءٍ بنجاح