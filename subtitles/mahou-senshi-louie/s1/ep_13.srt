1
00:01:43,130 --> 00:01:44,560
!شكرًا على الطعام

2
00:01:47,440 --> 00:01:48,940
!لذيذٌ جدًا

3
00:01:48,940 --> 00:01:52,430
!طعامٌ ومنظر بديع، هذا الأفضل

4
00:01:53,480 --> 00:01:57,080
لا بد أنّ كون المرء مغفّل ويعيش حياةً سعيدة
شيءٌ جميل

5
00:01:57,080 --> 00:02:02,150
التمهّل بالغداء هو شيءٌ رائع

6
00:02:02,150 --> 00:02:03,310
!بالفعل

7
00:02:10,290 --> 00:02:12,890
هؤلاء هم فرسان المملكة

8
00:02:12,890 --> 00:02:15,500
أتساءل ما إن كانوا يقومون بالحراسة؟

9
00:02:15,500 --> 00:02:16,870
!مرحبًا جيني

10
00:02:16,870 --> 00:02:18,800
!ماذا؟ بارب

11
00:02:20,100 --> 00:02:21,800
أحد معارفكِ؟

12
00:02:21,800 --> 00:02:24,210
كان رفيقي عندما كنت جنديّة

13
00:02:24,210 --> 00:02:27,540
.والآن هو قائد فرسان أوفن الحُراس
اسمه بارب

14
00:02:27,540 --> 00:02:29,640
إلى أين أنتِ ذاهبة يا جيني؟

15
00:02:29,640 --> 00:02:31,110
نحن متّجهون غربًا

16
00:02:31,110 --> 00:02:32,110
ما هو هدفكم؟

17
00:02:32,110 --> 00:02:35,050
.نبحثُ عن آثار
ماذا، أحدث شيءٌ ما؟

18
00:02:35,420 --> 00:02:39,090
سمعنا بوجود تحركات مُريبة على الحدودِ الغربيّة

19
00:02:39,090 --> 00:02:41,850
نحن ذاهبون لنرى كيف يُبلي الجنود على الحدود

20
00:02:42,320 --> 00:02:45,060
لن نبتعد بذلك القدر

21
00:02:45,060 --> 00:02:46,630
فهمت

22
00:02:46,630 --> 00:02:48,100
!قائد

23
00:02:48,530 --> 00:02:49,900
!توخّوا الحذر إذن

24
00:02:49,900 --> 00:02:51,030
حسنًا

25
00:02:51,030 --> 00:02:53,770
لنشرب معًا لاحقًا عندما نعود لأوفن

26
00:02:53,770 --> 00:02:55,240
حسنًا

27
00:02:55,870 --> 00:02:58,300
أتساءل ما هي تلك التحركات المُريبة

28
00:02:59,110 --> 00:03:01,540
لا شأن لنا بها

29
00:03:01,540 --> 00:03:05,180
!هذا صحيح. هدفنا هو الكنز

30
00:03:05,180 --> 00:03:07,080
!سنحصّل على الكثير من الأموال

31
00:03:07,080 --> 00:03:08,550
!أجل

32
00:03:12,020 --> 00:03:14,720
كم يبعُد المكان من هنا؟

33
00:03:14,720 --> 00:03:16,820
سنصل بغضونِ يومين

34
00:03:16,820 --> 00:03:19,290
أما زلنا بعيدين لهذا الحد؟

35
00:03:19,760 --> 00:03:22,030
سنعبُر الجبال

36
00:03:22,800 --> 00:03:24,260
ميرل؟

37
00:03:25,230 --> 00:03:27,260
هل كنتُ نائمة؟

38
00:03:27,940 --> 00:03:29,840
علينا النوم الآن

39
00:03:29,840 --> 00:03:32,040
لنُعيّن المناوبات بدءً من الليلة

40
00:03:32,040 --> 00:03:34,780
سأتولى المُناوبة الأولى
اذهبوا للنوم

41
00:03:34,780 --> 00:03:36,110
من فضلكِ

42
00:03:36,110 --> 00:03:37,580
لنذهب

43
00:03:39,180 --> 00:03:41,580
سوف ننام مُباشرة

44
00:03:41,580 --> 00:03:42,620
حسنًا

45
00:03:42,620 --> 00:03:44,190
طابت ليلتكم

46
00:03:44,190 --> 00:03:46,190
أيُّ مناوبة علي توليها؟

47
00:03:46,190 --> 00:03:47,660
الأخيرة

48
00:03:47,660 --> 00:03:51,060
شروق الشّمس هو الشيء الوحيد الذي يُمكننا
تركه لعديمي الخبرة

49
00:03:51,860 --> 00:03:54,460
!لقد ذهبتُ بعددٍ لا بأس به من المُغامرات

50
00:03:54,460 --> 00:03:57,260
أيمكنكِ التوقف عن مُعاملتي كعديمي الخبرة رجاءً؟

51
00:03:58,030 --> 00:04:02,260
سأدعوك بالمُبتدئ إذن، ولكن ما زال عليك
فعل الأشياء ذاتها

52
00:04:03,500 --> 00:04:05,630
!دعيني أقوم بعملٍ أكثر

53
00:04:07,080 --> 00:04:08,940
!أسرع واذهب للنوم

54
00:04:08,940 --> 00:04:10,750
حسنًا، حسنًا

55
00:04:10,750 --> 00:04:12,680
طابت ليلتكِ إذن

56
00:04:18,720 --> 00:04:20,210
!ابقَ خارجًا

57
00:04:34,100 --> 00:04:36,840
!متى سنصل هناك بحقّ الجحيم؟

58
00:04:36,840 --> 00:04:38,310
يجب أن يكون المكان حولنا

59
00:04:38,310 --> 00:04:40,210
!حولنا؟

60
00:04:40,210 --> 00:04:42,710
!لا شيء هنا

61
00:04:42,710 --> 00:04:45,700
!لنرَ... آه، هناك

62
00:04:46,810 --> 00:04:48,250
تلك هي العلامة

63
00:04:48,250 --> 00:04:51,880
!ماذا؟! ما يزال هذا بعيدٌ للغاية

64
00:04:52,350 --> 00:04:54,460
سنبدأ البحث غدًا

65
00:04:54,460 --> 00:04:57,220
على أيّ حال، لنقترب أكثر

66
00:05:13,440 --> 00:05:15,010
هل يملكون الهدف ذاته؟

67
00:05:15,010 --> 00:05:16,640
إنّهم جنود

68
00:05:17,310 --> 00:05:19,250
لمَ هم هُنا؟

69
00:05:19,850 --> 00:05:21,820
ربّما لهم علاقة بحادثةِ الحدود

70
00:05:21,820 --> 00:05:24,750
ما كان يتحدّث عنه بارب بالأمس

71
00:05:24,750 --> 00:05:26,420
ماذا يجب أن نفعل؟

72
00:05:26,420 --> 00:05:29,220
لنذهب للمعقَل ونُخبر بارب بهذا

73
00:05:29,790 --> 00:05:31,460
ماذا عن الكنز؟

74
00:05:31,460 --> 00:05:34,400
أتظنّ أنه بوسعنا البحث عنه تحت هذه الظروف؟

75
00:05:34,400 --> 00:05:35,230
!لنعُد أدراجنا

76
00:05:35,230 --> 00:05:37,770
لمَ لا نُقاتلهم فحسب؟

77
00:05:37,770 --> 00:05:40,100
.إنهم ثلاثة فقط
!سيكون سهلًا كالعدّ لثلاثة

78
00:05:40,700 --> 00:05:42,370
لا تستخفّ بالجنود

79
00:05:42,370 --> 00:05:44,930
من المُتحمل أن يكون رفقاءهم في مكانٍ ما

80
00:05:59,350 --> 00:06:02,720
!مهلًا! نحن رحالة مُغامرين

81
00:06:02,720 --> 00:06:05,090
!ليست لدينا نيّة بقتالكم

82
00:06:16,140 --> 00:06:17,300
!اركضوا

83
00:06:22,840 --> 00:06:25,050
من عساهُم أن يكونوا؟

84
00:06:25,050 --> 00:06:27,050
يبدو أنهم يقومون بعملٍ مشبوه

85
00:06:27,050 --> 00:06:29,350
لا يريدون أن يعلم أحدٌ بشأنه

86
00:06:29,350 --> 00:06:30,720
سيحلّ الظلام قريبًا

87
00:06:30,720 --> 00:06:32,920
!لنختبئ بالظُّلمة ومن ثمّ نهرب

88
00:06:32,920 --> 00:06:35,220
إن استطعنا الوصول للحدود، فسيكون
هُناك فرسان

89
00:06:35,220 --> 00:06:36,850
!لنجري حتّى نصل هناك بطريقةٍ ما

90
00:06:38,160 --> 00:06:39,630
!إنّهم هنا

91
00:06:58,710 --> 00:07:00,840
!أيّها اللعين

92
00:07:04,390 --> 00:07:05,850
!لنذهب

93
00:07:17,370 --> 00:07:18,730
!جيني

94
00:07:18,730 --> 00:07:21,240
!سنتراجع! فشِلت الخطّة

95
00:07:21,240 --> 00:07:23,040
أين القائد؟

96
00:07:23,040 --> 00:07:25,340
انسحب مُنذ مدّة

97
00:07:25,340 --> 00:07:26,510
!لنذهب

98
00:07:26,510 --> 00:07:28,280
!جيني

99
00:07:28,280 --> 00:07:30,180
!من هنا! اسرعي

100
00:07:30,180 --> 00:07:31,870
!الأعداء على وشك الوصول

101
00:07:32,780 --> 00:07:34,780
!هيكتور؟

102
00:07:34,780 --> 00:07:36,720
!أما يزالُ هنا؟

103
00:07:39,820 --> 00:07:41,060
ما هذا؟

104
00:07:41,060 --> 00:07:43,960
!إنّهم يرسلون إشارات لرفاقهم
!علينا الإسراع

105
00:07:55,240 --> 00:07:57,800
!سيلحقون بنا سريعًا على هذا المُعدل

106
00:08:03,310 --> 00:08:05,040
!سأُلهيهم بجعلهم يُطاردونني

107
00:08:06,050 --> 00:08:07,540
!اهربوا بينما يكونون مُشتّتين

108
00:08:09,950 --> 00:08:13,790
.لا، هذه مُهّمة القائد
سأفعلها أنا

109
00:08:13,790 --> 00:08:16,290
!أنت؟ لم؟

110
00:08:16,290 --> 00:08:18,930
!في ظلّ هذه الأوضاع، على الأخبر فعلها

111
00:08:18,930 --> 00:08:22,020
!افعلي ما أقوله حالًا يا جيني

112
00:08:22,700 --> 00:08:24,820
!اهربي مع الجميع

113
00:08:33,170 --> 00:08:34,880
!هيكتور

114
00:08:34,880 --> 00:08:36,340
!هيكتور؟

115
00:08:37,380 --> 00:08:38,850
!هلمّوا، أنا جاهز

116
00:08:38,850 --> 00:08:41,250
!أنا من سيقاتلكم

117
00:08:41,250 --> 00:08:43,620
!توقّف يا هيكتور! أتريدُ الموت؟

118
00:09:00,230 --> 00:09:01,800
!إنهم هنا

119
00:09:01,800 --> 00:09:04,790
!هناك الكثير منهم، لن نستطيع قتالهم

120
00:09:07,040 --> 00:09:08,940
!وهناك أيضًا

121
00:09:08,940 --> 00:09:12,140
!وبالأسفلِ كذلك! سنُحاصر

122
00:09:13,980 --> 00:09:16,210
سوف أعطّلهم هنا

123
00:09:17,120 --> 00:09:20,520
في تلك الأثناء، اذهبوا لإيجاد بارب في الحدود

124
00:09:21,520 --> 00:09:23,250
ولكن ماذا عنكِ يا جيني؟

125
00:09:23,930 --> 00:09:25,830
سأكون على ما يُرام

126
00:09:25,830 --> 00:09:28,530
سأؤخرهم، لذا أرجوكم عودوا بالإمدادات

127
00:09:28,530 --> 00:09:32,730
أستطيع تأخيرهم! دعيها لي

128
00:09:32,730 --> 00:09:35,040
!مُحالٌ أن أدع الأمر لك

129
00:09:35,040 --> 00:09:38,670
!في ظلّ هذه الأوضاع، على الأخبر فعلها

130
00:09:39,240 --> 00:09:40,760
هذا ليس صحيح

131
00:09:42,280 --> 00:09:43,980
ماذا تعني؟

132
00:09:43,980 --> 00:09:48,010
.لا أعني أيّ شيء
!هذا عملي

133
00:09:50,890 --> 00:09:53,290
إنه ليس الوقت المُناسب للجدال

134
00:09:53,290 --> 00:09:54,360
!اذهبوا

135
00:09:54,360 --> 00:09:55,790
!جيني

136
00:11:02,820 --> 00:11:04,650
!لن أسمح لكُم بالتقدّم أكثر

137
00:11:52,010 --> 00:11:53,940
!انظروا للأعلى

138
00:11:54,410 --> 00:11:58,710
!أنا من سيُقاتلكم

139
00:12:00,680 --> 00:12:02,210
!ذلك الغبي

140
00:12:15,060 --> 00:12:16,530
كيف كان هذا؟

141
00:12:16,530 --> 00:12:18,000
لمَ عُدت؟

142
00:12:18,630 --> 00:12:21,370
لا يمكنكِ إلا استخدام سيفكِ، صحيح؟

143
00:12:21,370 --> 00:12:24,130
!أستطيع استعمال سيفي وكذلك سحري

144
00:12:24,810 --> 00:12:28,480
وماذا بذلك؟ إن مُت أنت، ستكون
مُشكلة بالنسبة لي

145
00:12:28,480 --> 00:12:30,680
!لا تكوني عنيدة

146
00:12:30,680 --> 00:12:32,150
عنيدة؟

147
00:12:34,350 --> 00:12:35,820
!اخرج من هُنا بسرعة

148
00:12:35,820 --> 00:12:37,280
!مهلًا، انتظري

149
00:13:15,360 --> 00:13:17,090
!إنني هُنا

150
00:13:23,530 --> 00:13:26,830
!ما الأمرُ يا رفاق؟ أنا هنا

151
00:13:31,410 --> 00:13:36,110
مهلًا مهلًا، إلى أين تنظرون؟
أنا هنا

152
00:13:36,110 --> 00:13:37,380
!إنه هناك

153
00:13:37,380 --> 00:13:40,970
إلى أين تنظرون؟
!من هنا، هنا

154
00:13:43,650 --> 00:13:47,680
!حمقى! لا تستطيعون إيجادي

155
00:13:50,690 --> 00:13:53,560
!تبًّا. أوجدتموني بالفعل؟

156
00:13:59,370 --> 00:14:00,890
هيّا

157
00:14:06,410 --> 00:14:08,770
!يا إلهي! كان هذا وشيكًا

158
00:14:09,480 --> 00:14:10,940
!سحقًا لك

159
00:14:16,920 --> 00:14:19,480
!الكثير منكُم على شخصين

160
00:14:26,860 --> 00:14:28,330
ما هذا؟

161
00:14:34,740 --> 00:14:36,030
!هيه، انظري

162
00:14:39,540 --> 00:14:43,270
.إنكم متأخرين يا رفاق
!عجّلوا بالإمساك بهم

163
00:14:49,220 --> 00:14:50,390
!لوي

164
00:14:50,500 --> 00:14:53,310
جيني! مسرورةٌ أننا فعلناها في الوقت المُناسب

165
00:14:54,360 --> 00:14:56,920
!لقد نجحنا يا جيني! أُنقِذنا

166
00:14:57,390 --> 00:14:59,420
حالفنا القليلُ من الحظ

167
00:15:00,230 --> 00:15:02,200
...وإلا سنكون

168
00:15:02,200 --> 00:15:04,220
لكلّ حادثٍ حديث

169
00:15:09,540 --> 00:15:11,660
!هكذا مات هيكتور

170
00:15:12,170 --> 00:15:14,300
لأنه تمسّك بفخره الذكوريّ الأحمق

171
00:15:15,840 --> 00:15:17,670
هيكتور؟

172
00:15:18,580 --> 00:15:21,580
!في حالاتٍ كتلك، البقاء مسؤوليّتي

173
00:15:21,580 --> 00:15:23,210
لمَ تسلبني هذا؟

174
00:15:24,220 --> 00:15:25,740
لأنني امرأة؟

175
00:15:32,290 --> 00:15:34,090
!لوي

176
00:15:34,090 --> 00:15:37,970
لا أعلم بشأنِ ماضيكِ أو عن ذلك المدعوّ هيكتور

177
00:15:37,970 --> 00:15:39,990
!ولكن توقّفي عن التشكّي في حينِ أنّكِ نجوتِ

178
00:16:06,160 --> 00:16:08,260
!مهلًا
مالذي تنوون فعله؟

179
00:16:08,260 --> 00:16:09,730
!توقّفا أرجوكما

180
00:16:13,700 --> 00:16:15,300
!أرجوكِ توقّفي يا جيني

181
00:16:15,300 --> 00:16:16,940
!لا توقفاننا

182
00:16:16,940 --> 00:16:20,130
اسمعن، لا تُقاطعاننا، حسنًا؟

183
00:16:29,450 --> 00:16:31,920
أهذا كلّ ما لديكِ؟

184
00:16:38,890 --> 00:16:40,330
!جيني

185
00:16:42,430 --> 00:16:44,530
ماذا يحدث بحقّ الجحيم؟

186
00:16:44,530 --> 00:16:49,370
إنهم يتقاتلون لأن لوي بقي ليوقف
!أولئك الفتية

187
00:16:49,370 --> 00:16:54,030
...بدت جيني مُتألمة متذكّرةً شخص يُدعى هيكتور

188
00:16:54,510 --> 00:16:55,940
!هيكتور؟

189
00:16:56,510 --> 00:16:57,640
!جيني

190
00:16:57,640 --> 00:17:01,220
بارب! لمَ قُلت أنّك ستبقى في ذاك الوقت؟

191
00:17:01,220 --> 00:17:02,480
ماذا؟

192
00:17:02,480 --> 00:17:04,820
لمَ قام هيكتور بشيءٍ بهذا الغباء؟

193
00:17:06,790 --> 00:17:08,560
...بسبب

194
00:17:08,560 --> 00:17:10,220
بسببِ ماذا؟

195
00:17:10,220 --> 00:17:15,360
!لم يرغب أحدٌ بترككِ وحيدة بينما ينجون بأنفسهم

196
00:17:15,360 --> 00:17:16,300
لهذا السبب

197
00:17:16,300 --> 00:17:17,700
!لا

198
00:17:17,700 --> 00:17:19,430
...كان ذلك

199
00:17:19,430 --> 00:17:21,200
!كان ذلك واجبي

200
00:17:21,200 --> 00:17:22,930
جميعُ الرجال هكذا

201
00:17:23,640 --> 00:17:27,210
يظنّون أنهم شُجعان وينظرون بدونيّة للنساء

202
00:17:27,210 --> 00:17:29,440
!أنا من كان عليها البقاء

203
00:17:35,180 --> 00:17:37,890
ألستِ مُقاتلة من الدرجة الأولى؟

204
00:17:37,890 --> 00:17:40,550
!ما هذا؟ إنني خائبُ الظّن

205
00:17:42,620 --> 00:17:45,180
!أنت لا تعلم أيّ شيءٍ يا عديم الخبرة

206
00:17:49,730 --> 00:17:52,130
!مثل هذه اللكمة تُؤلم

207
00:17:52,130 --> 00:17:54,470
أهذه مُحاولة للشروع في اعتزازِ الذكور أيضًا؟

208
00:17:54,470 --> 00:17:57,500
...أكان سببُ بقاؤك عندما كان عليك المُضيّ

209
00:17:57,500 --> 00:17:59,200
أكان هذا لأنّك رجلًا؟

210
00:18:05,780 --> 00:18:07,680
إن كانت حياتكِ على المحك

211
00:18:07,680 --> 00:18:09,750
أيهمّ كونكِ رجلٌ أو امرأة؟

212
00:18:09,750 --> 00:18:11,220
!يا للحماقة

213
00:18:20,060 --> 00:18:21,200
!هذا يكفي. توقّفا

214
00:18:21,200 --> 00:18:22,700
!جيني

215
00:18:22,030 --> 00:18:24,230
ما خطبكُما يا رفاق؟

216
00:18:24,230 --> 00:18:27,860
اسمعي، هذه تفاهة

217
00:18:29,270 --> 00:18:30,740
!لوي

218
00:18:34,610 --> 00:18:36,610
يجب أن تخلوا المنطقة

219
00:18:36,610 --> 00:18:37,680
ماذا؟

220
00:18:37,680 --> 00:18:41,010
سأحرّم دخول هذه المنطقة على
الأشخاص العاديّين

221
00:18:41,010 --> 00:18:43,020
ماذا عن كنزنا؟

222
00:18:43,020 --> 00:18:45,140
انتظروا حتى تستقرّ الأوضاع

223
00:18:45,750 --> 00:18:47,450
!لا يُمكن

224
00:18:48,890 --> 00:18:50,120
جيني؟

225
00:18:50,120 --> 00:18:51,750
آسفة، اسبقوني

226
00:19:02,100 --> 00:19:04,810
إنهم ليسوا جنودًا مُحترفين

227
00:19:04,810 --> 00:19:06,610
من المُحتمل أنّهم بقايا جيشٍ ما

228
00:19:06,610 --> 00:19:08,910
ألم تُمسك بأحدهم؟

229
00:19:08,910 --> 00:19:10,930
أبلوا بلاءً حسنًا بانسحابهم

230
00:19:11,410 --> 00:19:13,280
بالمُناسبة، كيف حاله؟

231
00:19:13,710 --> 00:19:15,120
حاله؟

232
00:19:15,120 --> 00:19:17,520
السّاحر الذي خاضَ شجارًا معكِ

233
00:19:17,520 --> 00:19:20,650
آه، لم أره. لا أهتم

234
00:19:20,650 --> 00:19:22,090
حقًّا؟

235
00:19:25,690 --> 00:19:27,360
جيني

236
00:19:27,360 --> 00:19:31,770
كانت لهيكتور أسبابه الخاصّة عندما
فعل ما فعله

237
00:19:31,770 --> 00:19:33,230
ما هو بعد كلّ هذا الوقت؟

238
00:19:35,140 --> 00:19:37,570
كان هيكتور واقعٌ بحبّكِ

239
00:19:38,910 --> 00:19:43,310
لم يستطع العيش بينما يدعكِ تموتين

240
00:19:43,310 --> 00:19:46,980
صحيحٌ أنه كان يحميكِ بصفته رجُل

241
00:19:46,980 --> 00:19:49,010
لكن أيمكنكِ مسامحته على ذلك الآن؟

242
00:19:53,990 --> 00:19:55,820
لا يهمّ سواءً سامحته أم لا

243
00:19:56,620 --> 00:20:00,750
نحن على قيد الحياةِ اليوم بفضل هيكتور

244
00:20:01,760 --> 00:20:04,030
هكذا إذن، أظنّ ذلك

245
00:20:07,830 --> 00:20:09,100
أراكِ لاحقًا

246
00:20:09,100 --> 00:20:10,570
أجل

247
00:20:18,950 --> 00:20:21,410
أنسيتَ شيئًا يا بارب؟

248
00:20:22,720 --> 00:20:24,180
!مرحبًا

249
00:20:25,450 --> 00:20:27,820
أيمكنكِ مُساعدتي بالتّدريب؟

250
00:20:42,140 --> 00:20:43,800
هل انتهيتَ بالفعل؟

251
00:20:43,800 --> 00:20:45,640
!سحقًا

252
00:20:50,310 --> 00:20:52,410
!ليس بعد

253
00:20:52,410 --> 00:20:54,880
!إنني أقوم بالإحماءِ فقط

254
00:20:55,850 --> 00:20:57,680
هكذا إذن؟