1
00:01:36,960 --> 00:01:40,860
أترغبون بِشراء الزهور؟

2
00:01:40,860 --> 00:01:42,760
أترغبون بِشراء الزهور؟...

3
00:01:42,760 --> 00:01:46,130
!زهورٌ جميلة بهيّة مثلي تمامًا

4
00:01:47,170 --> 00:01:52,070
!سأشتري البعضُ إن قُمتِ بالتّعري يا أختي

5
00:01:53,240 --> 00:01:55,380
!لا تعبث معي أيّها الحقير

6
00:01:55,380 --> 00:01:57,740
!آسف

7
00:02:05,450 --> 00:02:09,990
.أشكركُم كثيرًا
!عودوا مجددًا

8
00:02:09,990 --> 00:02:12,890
إنّها تُبلي جيّدًا

9
00:02:12,890 --> 00:02:16,890
ألا يوجد هنالك مصدر دخلٍ جانبيّ أفضل؟

10
00:02:18,430 --> 00:02:20,970
!وجدتُكِ أخيرًا يا جميلتي

11
00:02:20,970 --> 00:02:22,440
ماذا؟

12
00:02:29,780 --> 00:02:32,180
ما الخطبُ يا جميلتي؟

13
00:02:33,310 --> 00:02:36,720
أيُمكن أنّك تُخاطبني؟

14
00:02:36,720 --> 00:02:40,120
.لن أتخلّى عنكِ أبدًا
أرجوكِ قابلي والداي

15
00:02:40,120 --> 00:02:41,760
هاه؟

16
00:02:41,760 --> 00:02:44,390
أتقبلين عرض زواجي؟

17
00:02:44,390 --> 00:02:47,160
ع-ع-عرض

18
00:02:47,160 --> 00:02:48,830
عرض زواج؟

19
00:02:48,830 --> 00:02:50,300
أجل، بالضّبط

20
00:02:51,730 --> 00:02:53,330
!انتظر لحظة

21
00:02:53,330 --> 00:02:55,330
...أنا لا أعرفُك حتّى

22
00:02:57,000 --> 00:02:59,400
!إلى أين أنت ذاهب؟

23
00:03:01,040 --> 00:03:02,910
!كانَ لذيذًا أيّها المُسن

24
00:03:02,910 --> 00:03:07,080
!أظنّ أنني أفرطتُ في الأكل اليوم

25
00:03:07,080 --> 00:03:09,620
!أنزلني، أُخبرك أن تُنزلني

26
00:03:09,620 --> 00:03:10,750
ماذا؟

27
00:03:10,750 --> 00:03:14,120
!حتّى لو اختطفتني لن تحصُل على فدية

28
00:03:14,760 --> 00:03:16,160
أكانت تلك

29
00:03:16,160 --> 00:03:17,430
ميرل؟

30
00:03:17,430 --> 00:03:20,190
!ليُساعدني أحدكم

31
00:03:22,600 --> 00:03:25,230
!اختُطفت ميرل

32
00:03:28,770 --> 00:03:31,140
!وصل ويليام-ساما

33
00:03:33,810 --> 00:03:35,280
...هذا

34
00:03:39,250 --> 00:03:40,710
...هذا

35
00:03:41,480 --> 00:03:44,250
!أهلًا بعودتك يا ويليام-ساما

36
00:03:49,060 --> 00:03:51,960
سيعتنين بكِ هؤلاء الخادماتِ الخمس

37
00:03:52,830 --> 00:03:54,860
أعلمينا إن احتجتِ أيّ شيءٍ رجاءً

38
00:03:54,860 --> 00:03:56,330
ماذا؟

39
00:04:01,800 --> 00:04:03,170
!كانت تلك حادثة! حادثة

40
00:04:03,170 --> 00:04:04,930
!لم أتعمّد فعلها

41
00:04:05,470 --> 00:04:07,700
ألم ينل التّمثال على إعجابكِ؟

42
00:04:08,380 --> 00:04:11,610
سأستبدلهُ بواحدٍ يروقكِ إذن

43
00:04:13,010 --> 00:04:16,550
.لا أهتمّ بالتماثيل
إنها ليست ما أُفضّله على أيّ حال

44
00:04:16,550 --> 00:04:19,090
ما الذي تحبّينه إذن؟

45
00:04:19,090 --> 00:04:20,590
ما أحبّه هو

46
00:04:20,590 --> 00:04:23,220
!ال-أم-وال

47
00:04:23,220 --> 00:04:27,130
!أودُّ أخذ حمّام مليء بالعُملات الذهبية بالتأكيد

48
00:04:27,130 --> 00:04:29,030
ولكن هذا مُستحيلٌ، أليس كذلك؟

49
00:04:29,800 --> 00:04:31,260
مفهوم

50
00:04:36,600 --> 00:04:38,070
هذا حُلم

51
00:04:40,370 --> 00:04:41,840
مؤلم

52
00:04:43,540 --> 00:04:45,910
!إنه ليس حُلمًا

53
00:04:45,910 --> 00:04:50,440
!ليس حلم، ليس حلم، ليس حلم

54
00:05:23,220 --> 00:05:25,480
اختاري ما يروقكِ من ثيابٍ رجاءً

55
00:05:34,960 --> 00:05:36,450
!جميلة

56
00:05:43,300 --> 00:05:45,670
!تبدين جميلة للغاية بأيّ شيء ترتدينه

57
00:05:46,670 --> 00:05:50,080
ولكن هل أنت مُتأكد من أنه لا بأس
بفعلِ كُل هذا لي؟

58
00:05:50,440 --> 00:05:55,380
هذا مُتوقّع بعد الطيبة التي أظهرتِها لي
تلك المرة

59
00:05:55,380 --> 00:05:57,150
تلك المرة؟

60
00:05:57,150 --> 00:05:59,420
...أتعني بتلك المرة

61
00:05:59,420 --> 00:06:01,920
صحيح، كانت تلك المرة؟

62
00:06:01,920 --> 00:06:03,690
!بالطبع أعنيها

63
00:06:03,690 --> 00:06:08,630
حينما رأيتُ بكِ ملاكٌ جميلة ومُعتزّة

64
00:06:08,630 --> 00:06:10,060
...أتساءلُ متى كان هذا

65
00:06:14,400 --> 00:06:18,430
مُتأكّدٌ أن والداي سيُحبونكِ

66
00:06:18,940 --> 00:06:21,840
!بل حتّى وإن كانوا مُعارضين

67
00:06:22,480 --> 00:06:26,380
حتى لو خسرتُ كلّ ثروتي ما زلتُ سأتزوّجكِ

68
00:06:26,380 --> 00:06:28,920
!لا! لا تخسر كُل ثروتك

69
00:06:28,920 --> 00:06:30,910
هذا الشّيءُ الوحيد الذي لا يُمكنك
!خسارته يا ويليام

70
00:06:32,190 --> 00:06:33,650
ويليام

71
00:06:34,460 --> 00:06:36,860
نطقتِ اسمي للمرة الأولى

72
00:06:36,860 --> 00:06:40,730
...كونُ اسمي يُهمس من شفتكِ الفاتنة

73
00:06:41,760 --> 00:06:43,530
لا توجد لذّة أعظم من هذا

74
00:06:45,030 --> 00:06:46,300
فهمت

75
00:06:46,300 --> 00:06:49,700
إن كان هذا رأيُكِ، لن أتخلى عن ثروتي

76
00:06:51,070 --> 00:06:53,470
مهلًا، مهلًا! بجديّة؟

77
00:06:53,970 --> 00:06:56,780
!ماذا؟! زواج؟

78
00:06:56,780 --> 00:06:58,010
ميرل التي نعرفها؟

79
00:06:58,010 --> 00:07:01,820
وريث عائلة الوايلدر، أحد أغنى عوائل أوفن؟

80
00:07:01,820 --> 00:07:03,080
!تتزوّجه؟

81
00:07:03,080 --> 00:07:04,550
ما الذي يجري؟

82
00:07:06,350 --> 00:07:08,990
!لا أملكُ أيّ فكرة كذلك

83
00:07:08,990 --> 00:07:12,760
ولكني رأيتُ هذا بأمّ عيني، وسمعته بأذُناي

84
00:07:12,760 --> 00:07:15,930
لمَ ستتزوّج ميرل من رجلٍ ثريّ هكذا؟

85
00:07:15,930 --> 00:07:19,570
.هذا صحيح
ما سببُ كل هذا؟

86
00:07:19,570 --> 00:07:22,340
كما ترون، بعدما ألقيتُ تعويذة
الاعتراف السحريّة

87
00:07:22,340 --> 00:07:24,960
...على أحد خدم المُلكيّة

88
00:07:27,140 --> 00:07:30,410
أجل، إنّك تنعس أكثر فأكثر

89
00:07:30,410 --> 00:07:33,180
!إنك تنعس، تنعس

90
00:07:36,720 --> 00:07:39,220
كيف تدعو هذا سحرًا؟

91
00:07:39,220 --> 00:07:41,380
كان تنويم مغناطيسيّ بسيط

92
00:07:42,520 --> 00:07:43,990
!على أيٍّ، استمعوا فقط

93
00:07:45,160 --> 00:07:47,430
والآن حان وقتُ إخباري

94
00:07:47,430 --> 00:07:50,830
كيف التقت ميرل بِالوريث

95
00:07:50,830 --> 00:07:52,960
...أجل. لقد كان هذا

96
00:07:55,500 --> 00:07:56,970
!ويليام-ساما

97
00:08:46,050 --> 00:08:48,060
ومن ثمّ امتصّت السُم

98
00:08:48,060 --> 00:08:50,320
ورافقت ويليام خارج الوادي

99
00:08:50,320 --> 00:08:52,490
بينما كان الأميرُ عالق بين الحياةِ والموت

100
00:08:52,490 --> 00:08:56,500
رعتهُ لثلاثة أيامٍ متواصلة بلا نوم

101
00:08:56,500 --> 00:08:57,960
ميرل فعلت هذا؟

102
00:08:59,300 --> 00:09:00,670
!ويليام-ساما

103
00:09:00,670 --> 00:09:02,940
!ويليام-ساما
!سعيدةٌ أنّك بخير

104
00:09:02,940 --> 00:09:06,960
أرجوكِ، اخبريني اسمكِ على الأقل

105
00:09:15,820 --> 00:09:19,090
لن أفشل بإيجادكِ

106
00:09:19,090 --> 00:09:20,550
...بكُل تأكيد

107
00:09:21,360 --> 00:09:26,130
حالما تعافى الوريث، امتنع عن النّوم
للبحث عن ميرل

108
00:09:26,130 --> 00:09:28,390
ومن ثمّ وجدها أخيرًا

109
00:09:33,830 --> 00:09:36,240
هُناك شيءٌ يزعجني

110
00:09:36,240 --> 00:09:37,610
!هذا صحيح

111
00:09:37,610 --> 00:09:40,740
،ميرل التي نعرفها أنقذت شخصًا
وليس هذا فقط

112
00:09:40,740 --> 00:09:42,780
!فعلتها بدون أن تطلب مُقابل؟

113
00:09:42,780 --> 00:09:44,140
!هذا ليس ما عنيتُه

114
00:09:44,140 --> 00:09:48,050
ما أردتُ السؤال عنه هو متى حدث
!كُل هذا؟

115
00:09:49,720 --> 00:09:54,120
هذا صحيح! أنت، متى أنقذت ميرل الوريث؟

116
00:09:55,760 --> 00:09:58,380
حسنًا، قال أنّ الحادثة منذ شهر

117
00:09:59,930 --> 00:10:06,100
كُنّا في وسط مُغامرة الشهر الماضي

118
00:10:06,100 --> 00:10:08,870
هذا صحيح. وميرل كانت برفقتنا بالطّبع

119
00:10:08,870 --> 00:10:09,840
ماذا؟

120
00:10:09,840 --> 00:10:11,640
هكذا إذن

121
00:10:11,640 --> 00:10:15,410
هذا يعني أنه من المُستحيل أن ميرل أنقذت الوريث

122
00:10:24,890 --> 00:10:30,560
الكلماتُ لا تصف امتناني لكِ لانقاذ ابننا

123
00:10:30,560 --> 00:10:34,190
بالفعل. إنني مسرورةٌ بمُقابلتكِ شخصيًّا

124
00:10:34,190 --> 00:10:36,730
إنكِ فتاةٌ يافعة وودودة كما توقّعت

125
00:10:36,730 --> 00:10:39,960
حقًّا يا سيّدتي؟

126
00:10:40,900 --> 00:10:44,100
إنقاذ؟ هذا الفتى؟

127
00:10:41,770 --> 00:10:44,000
!كم هي فتاة مُبهجة

128
00:10:44,810 --> 00:10:46,310
أشعُر أنه ليس ويليام فقط

129
00:10:46,310 --> 00:10:49,710
بل أنا كذلك على وشكِ أن أُفتن بكِ

130
00:10:49,710 --> 00:10:53,480
ولكن هل أنتُم متأكدين أنكم تريدون
شخصًا مثلي؟

131
00:10:53,480 --> 00:10:55,120
ماذا تقولين؟

132
00:10:55,120 --> 00:10:57,890
كيف يُمكننا التشكّي من امتلاك زوجة لابننا

133
00:10:57,890 --> 00:11:02,320
أنقذت حياته؟

134
00:11:02,320 --> 00:11:03,690
أليس كذلك يا ويليام؟

135
00:11:03,690 --> 00:11:05,960
أجل، كما تقول تمامًا

136
00:11:05,960 --> 00:11:08,990
!هذا سيء، لقد أخطأوا بيني وبين شخصٍ آخر

137
00:11:10,400 --> 00:11:15,530
كما أخبرتكِ، والداي أُغرما بكِ بصدق

138
00:11:17,940 --> 00:11:20,700
سأحرص على أن أجعلكِ سعيدة

139
00:11:26,150 --> 00:11:27,880
!ويليام-ساما

140
00:11:29,550 --> 00:11:30,680
ويليام-ساما

141
00:11:30,680 --> 00:11:34,460
لغايةِ أن تعتاد ميرل-سان على طبقتنا
الاجتماعيّة سريعًا

142
00:11:34,460 --> 00:11:36,950
!أنشأتُ دروسًا خصوصيّة جاهزة لها

143
00:11:37,490 --> 00:11:39,260
تعالي من هُنا رجاءً

144
00:11:39,260 --> 00:11:40,760
ماذا؟

145
00:11:40,760 --> 00:11:42,230
حسنًا

146
00:11:44,530 --> 00:11:47,700
كونكِ ستصبحين أحد أفراد عائلة
الوايلدر النبيلة

147
00:11:47,700 --> 00:11:53,470
عليكِ أن تتصرفي بنُبل، رُقيّ، فخامة وروعة

148
00:11:57,780 --> 00:11:59,770
يا إلهي! هل أنتِ على ما يرام؟

149
00:12:08,860 --> 00:12:10,320
تبدو باهظة الثّمن

150
00:12:16,430 --> 00:12:19,470
والآن اعزفي كما فعلتُ توّي رجاءً

151
00:12:19,470 --> 00:12:21,060
!حسنًا

152
00:12:21,870 --> 00:12:23,600
!مؤلم

153
00:12:31,450 --> 00:12:32,950
إنها تقاليدٌ لأجيالٍ عدّة

154
00:12:32,950 --> 00:12:36,850
بأن تصنع عروس العائلة هذه الكعكة بيدها

155
00:12:40,890 --> 00:12:43,920
هذا فشل. أعيدي صنعها رجاءً

156
00:12:43,920 --> 00:12:45,390
!ماذا؟

157
00:12:47,560 --> 00:12:50,960
أتساءلُ ما إن كانت ميرل تُبلي حسنًا هناك

158
00:12:50,960 --> 00:12:52,600
من يعلم

159
00:12:52,600 --> 00:12:56,270
قد يكون ويليام شابًّا، ولكنّه وريثٌ جديرٌ بالثّقة

160
00:12:56,270 --> 00:12:59,410
ولكنّها لصّة كما تعلمين

161
00:12:59,410 --> 00:13:01,310
إن كانت مُحاطة بالأشياءِ القيّمة طوال اليوم

162
00:13:01,310 --> 00:13:03,580
...أتساءل ما إن كانت سوف

163
00:13:03,580 --> 00:13:05,210
لا أعتقد هذا

164
00:13:05,210 --> 00:13:09,120
إن كانت ستتزوّج فغالبًا أنّها سترث
الثروة بأكملها

165
00:13:09,120 --> 00:13:10,740
حقًّا؟

166
00:13:20,860 --> 00:13:21,960
!لا فائدة

167
00:13:21,960 --> 00:13:23,950
!لا أستطيعُ النّوم بسبب هذا السّرير المنفوش

168
00:13:29,670 --> 00:13:33,800
كم أتمنّى لو بإمكاني الحصول على شرابٍ
ولحم مقطّع

169
00:13:40,510 --> 00:13:45,420
ما رأيكُم بإقامة الزّفاف في العُطلة القادمة؟

170
00:13:45,420 --> 00:13:47,050
إنّها فكرةٌ جيّدة

171
00:13:47,050 --> 00:13:49,190
لا أملك أيّ اعتراضاتٍ كذلك

172
00:13:49,190 --> 00:13:51,210
ماذا تظنّين يا ميرل-سان؟

173
00:13:53,360 --> 00:13:54,360
ميرل-سان؟

174
00:13:54,360 --> 00:13:55,400
ماذا؟

175
00:13:55,400 --> 00:13:58,260
أجل، هذا مناسبٌ لي

176
00:13:59,170 --> 00:14:02,800
جيّد، هكذا سيكون منزل الوايلدر سليمٌ وآمن

177
00:14:02,800 --> 00:14:04,270
!أجل

178
00:14:09,240 --> 00:14:11,870
ألا بأس بهذا حقًّا؟

179
00:14:13,010 --> 00:14:17,280
لا بدّ أن من أنقذ ويليام موجود في مكانٍ
ما بالخارج

180
00:14:17,950 --> 00:14:20,580
...سرقةُ سعادة شخصٍ آخر هكذا

181
00:14:22,990 --> 00:14:24,580
ها أنتِ هنا

182
00:14:26,890 --> 00:14:28,380
حان وقتُ درسكِ

183
00:14:29,530 --> 00:14:31,430
عجّلي بالاستعداد

184
00:14:33,700 --> 00:14:36,690
ما الخطب؟ لا تبدين بخير

185
00:14:37,340 --> 00:14:39,360
...حسنًا، أنا

186
00:14:39,870 --> 00:14:44,280
إن كنتِ لا تشعرين أنكِ بخير، فهل ألغي درس اليوم؟

187
00:14:44,280 --> 00:14:46,040
...أنا

188
00:14:46,810 --> 00:14:48,680
!سيّء! لا أستطيع قولها فحسب

189
00:14:50,850 --> 00:14:52,320
!ميرل-سان؟

190
00:14:53,990 --> 00:14:55,450
لا شيء

191
00:14:57,160 --> 00:15:00,020
إنني فقط خائفة لأنني سعيدةٌ جدًّا

192
00:15:01,700 --> 00:15:03,820
لذا لا تقلق

193
00:15:04,330 --> 00:15:05,800
حسنًا؟

194
00:15:10,640 --> 00:15:12,410
!لا تُحبطي يا ميرل

195
00:15:12,410 --> 00:15:15,400
!لن تحصُلي على فرصةٍ كهاته مُطلقًا

196
00:15:30,560 --> 00:15:33,150
يوم الزّفاف بعد الغدِ إذن؟

197
00:15:33,830 --> 00:15:36,600
ولكن، ألا بأس بهذا؟

198
00:15:36,600 --> 00:15:39,860
لا بأس طالما أنّ ميرل لا تُمانع

199
00:15:42,500 --> 00:15:46,030
أتساءلُ ما إن كانت ستتوقّف عن المُغامرة

200
00:15:56,520 --> 00:15:59,140
صحيح! لمَ لا نذهب لرؤيتها؟

201
00:16:01,320 --> 00:16:05,190
!أنا بخير! إنني سعيدةٌ للغاية

202
00:16:07,230 --> 00:16:09,130
...قالت أنّها بخير ولكن

203
00:16:09,130 --> 00:16:12,030
بدت مُرهقة قليلًا

204
00:16:12,030 --> 00:16:14,260
لديها الكثيرُ لتقلق بشأنه الآن

205
00:16:14,800 --> 00:16:18,430
ذلك النّوع من الثياب لا يُلائمها فحسب

206
00:16:20,210 --> 00:16:22,610
!أختي! أختي أوديسا

207
00:16:23,480 --> 00:16:26,380
تلك الفتاة المدعوّة بميرل تشبهكِ
!يا أختي أوديسا

208
00:16:26,380 --> 00:16:27,910
!بالفعل! بالفعل

209
00:16:27,910 --> 00:16:30,780
!لا، هذه ليست أنا

210
00:16:31,820 --> 00:16:33,290
!ميرل؟

211
00:16:42,760 --> 00:16:44,670
!هيّا

212
00:16:44,670 --> 00:16:47,700
ميّزتُ ويليام-ساما من اللمحةِ الأولى

213
00:16:47,700 --> 00:16:52,240
لقد خدمتُ في ملكيّة الوايلدر من قبل

214
00:16:52,240 --> 00:16:54,610
لمَ لم تُخبريه باسمكِ إذن؟

215
00:16:55,880 --> 00:16:57,340
...بسبب

216
00:16:58,780 --> 00:17:01,770
وقعتِ في حُبه، أليس كذلك؟

217
00:17:03,320 --> 00:17:04,580
...ولكن

218
00:17:04,580 --> 00:17:09,390
ليس لديّ والدان بل أملك عشرةَ إخوة

219
00:17:09,390 --> 00:17:11,890
طبقاتنا الاجتماعيّة متفاوتة

220
00:17:11,890 --> 00:17:16,300
استقلتُ بما أني لستُ أملك خيارًا
...إلا بالاستسلام ولكن

221
00:17:16,300 --> 00:17:19,100
جمعتكما الصّدفة مُجددًّا، هاه؟

222
00:17:19,100 --> 00:17:20,100
أجل

223
00:17:20,100 --> 00:17:22,100
!ولكن لا بأس

224
00:17:22,100 --> 00:17:25,230
كان من المُقدر بأن يحصل هذا، أنا مُتأكدة

225
00:17:25,770 --> 00:17:28,000
أتقولين مُقدّر؟

226
00:17:29,680 --> 00:17:33,270
ولو كان الأمرُ مقدّرًا، عليكِ الاستسلام؟

227
00:17:34,580 --> 00:17:36,120
!الحياةُ معركة

228
00:17:36,120 --> 00:17:39,750
إن استمرّيتِ بالهرب، فلن تجدي
السّعادة الحقيقيّة

229
00:17:46,560 --> 00:17:49,050
!في تلك الحالة، اتّخذتُ قراري

230
00:18:23,000 --> 00:18:27,230
والآن، تبادلا نذوركما رجاءً

231
00:18:38,280 --> 00:18:39,840
!حسنًا، هذا هو المكان

232
00:18:41,280 --> 00:18:43,650
أُقسم أنا، ويليام وايلدر

233
00:18:43,650 --> 00:18:46,410
بأنّي سأُحبّها طيلة حياتي

234
00:18:47,450 --> 00:18:50,590
والآن العروس، أقسمي بنذركِ رجاءً

235
00:18:50,590 --> 00:18:51,960
!حسنًا

236
00:18:52,590 --> 00:18:54,130
ما الذي عليّ فعله؟

237
00:18:54,130 --> 00:18:56,120
أيجبُ عليّ القسم حقًّا؟

238
00:19:00,670 --> 00:19:04,160
...أنا، حسنًا

239
00:19:19,950 --> 00:19:22,120
!ميرل-سان! ميرل-سان

240
00:19:22,120 --> 00:19:23,990
!يا إلهي، كان هذا مُبالغًا به

241
00:19:23,990 --> 00:19:26,630
لم يكُن علينا تركها له بالنّهاية

242
00:19:26,630 --> 00:19:29,430
ميرل-سان، أين أنتِ؟

243
00:19:29,430 --> 00:19:32,160
!!أجيبيني أرجوكِ يا ميرل-سان

244
00:19:33,930 --> 00:19:36,200
...مُقرف، إنّني دبقة بالكامل

245
00:19:37,240 --> 00:19:39,240
!مرحبًا ميرل

246
00:19:39,240 --> 00:19:40,730
أنا هنا لاستعادتُكِ

247
00:19:42,410 --> 00:19:43,880
...لوي

248
00:19:46,180 --> 00:19:48,940
!ميرل-سان!! ميرل-سان

249
00:19:50,450 --> 00:19:51,920
...ميرل-سان

250
00:19:53,120 --> 00:19:54,590
أنتِ على ما يُرام، صحيح؟

251
00:19:56,290 --> 00:19:58,020
!أكمل الزفاف

252
00:19:58,020 --> 00:20:00,150
!قولا نذوركما بسرعة

253
00:20:00,660 --> 00:20:05,960
أتُقسمين بأنكِ ستحبّين ويليام طيلة
حياتكِ يا أوديسا؟

254
00:20:08,600 --> 00:20:10,070
أوديسا؟

255
00:20:16,680 --> 00:20:18,140
...أنتِ

256
00:20:19,450 --> 00:20:21,850
هل تُقسمين يا أوديسا؟

257
00:20:22,980 --> 00:20:24,970
أجل، أنا أُقسم

258
00:20:25,390 --> 00:20:26,850
!فعلتها

259
00:20:28,020 --> 00:20:29,550
!مُبارك

260
00:20:30,290 --> 00:20:32,060
!أختي أوديسا

261
00:20:32,060 --> 00:20:33,690
!أحسنتِ

262
00:20:36,230 --> 00:20:38,220
لا تُسيئي الظنّ بي يا ميرل

263
00:20:42,400 --> 00:20:44,800
إنني مُرتاحة نوعًا ما، في الحقيقة

264
00:20:44,800 --> 00:20:47,710
فقد كنت مُحاطة بجبلٍ من الكنوز
!بعد كُل شيء

265
00:20:47,710 --> 00:20:50,300
!كان من الصّعب ألا أسرق

266
00:20:52,110 --> 00:20:53,110
ميرل

267
00:20:53,110 --> 00:20:53,980
ماذا؟

268
00:20:53,980 --> 00:20:56,650
هل ازداد وزنُكِ بعد أكلكِ لكل ذلك
الطعام الجيّد؟

269
00:20:56,650 --> 00:20:58,640
!راقب ما تقوله لفتاة

270
00:21:00,920 --> 00:21:01,850
هاه؟