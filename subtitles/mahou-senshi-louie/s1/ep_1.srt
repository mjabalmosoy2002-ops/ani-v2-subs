1
00:01:36,890 --> 00:01:40,830
لا شكّ بهذا، الأسفل مُجوَّف

2
00:01:40,830 --> 00:01:42,430
كما توقعنا إذن؟

3
00:01:42,430 --> 00:01:47,470
أجل. هناك احتمالية عالية أن هذه الآثار
تحتوي على بعض الكنوز

4
00:01:47,470 --> 00:01:48,840
أبستطاعتُكِ فتحه؟

5
00:01:48,840 --> 00:01:50,330
سيصعُب عليّ فعلها

6
00:01:50,870 --> 00:01:53,580
لكان الأمر أسرع لو لدينا ساحرة

7
00:01:53,580 --> 00:01:58,840
...ساحرة؟ صحيحٌ أننا لا نملك هذا النوع من القوى

8
00:02:02,680 --> 00:02:04,150
!عفاريت

9
00:02:09,090 --> 00:02:11,790
أظن أن البقاء هنا حتى العُتمة ليس شيءٌ جيّد

10
00:02:11,790 --> 00:02:15,600
يبدو أنه من الأجدر بنا العودة إلى أوفن والاستعداد

11
00:02:15,600 --> 00:02:16,970
ونجد ساحرة

12
00:02:16,970 --> 00:02:22,670
أجل، سأُصلّي لإله المعارك مايلي لِنجد واحدة بارعة

13
00:02:22,670 --> 00:02:25,900
بما أننا قد اتّخذنا قرارنا الآن، هلّا خرجنا من هُنا؟

14
00:02:27,010 --> 00:02:28,010
أجل

15
00:02:28,010 --> 00:02:29,740
سنتوجّه للغابة في آنٍ واحد

16
00:02:29,740 --> 00:02:31,300
لا تتأخري يا ميرل

17
00:02:31,910 --> 00:02:33,550
أعلم هذا

18
00:02:33,550 --> 00:02:35,040
لنرحل من هنا إذن

19
00:02:47,400 --> 00:02:49,430
إننا نخسر مرّة أُخرى

20
00:02:49,430 --> 00:02:52,300
....لم يتبقّ الكثير من المال

21
00:02:52,300 --> 00:02:54,170
!لوي

22
00:02:58,010 --> 00:03:02,880
مهلًا، أنتِ. أرأيتِ رجل مديد القامة
بشعرٍ طويل يمُر من هنا؟

23
00:03:02,880 --> 00:03:05,570
.يبدو الوضع سيّء
من الأجدر بي ألّا أتورط

24
00:03:06,150 --> 00:03:08,050
لقد ذهب من ذاك الطريق

25
00:03:08,050 --> 00:03:09,680
!لوي

26
00:03:09,680 --> 00:03:11,190
مالذي يحدُث؟

27
00:03:11,190 --> 00:03:12,420
أرَحلوا؟

28
00:03:12,420 --> 00:03:13,390
أجل

29
00:03:17,860 --> 00:03:20,700
أنقذتِني، أنقذتِني

30
00:03:20,700 --> 00:03:24,100
.هؤلاء النّساء لن يترُكنني بحالي
!كنت في مأزِق

31
00:03:24,100 --> 00:03:25,570
وداعًا

32
00:03:26,000 --> 00:03:28,440
سأبتاعُ لكِ مشروبًا مقابل مساعدتي

33
00:03:28,440 --> 00:03:30,070
!أنت نتِن

34
00:03:30,070 --> 00:03:32,340
!لا تلمسني أيّها الثمِل

35
00:03:32,340 --> 00:03:34,240
!مهلًا، انتظري

36
00:03:39,580 --> 00:03:42,240
!أيّها الأبله الغبي

37
00:03:43,250 --> 00:03:44,890
!أيّها المنحرف

38
00:03:44,890 --> 00:03:46,350
اللعنة

39
00:03:46,920 --> 00:03:48,550
ما كان هذا؟

40
00:03:49,490 --> 00:03:52,890
إذن، لأي سبب جررتوني لهذا المكان؟

41
00:03:52,890 --> 00:03:56,800
لا يصحّ المرور بكُلّ بساطة بجانب أُناس بعد أن
اصطدمتي بهم، أليس كذلك؟

42
00:03:56,800 --> 00:03:59,930
نستطيع خوض نزال هنا إن كنتِ مقاتلة

43
00:03:59,930 --> 00:04:02,640
أم أتُفضّلين حل هذا عن طريق المال؟

44
00:04:02,640 --> 00:04:04,940
أتفتعِلون قتالًا معي؟

45
00:04:04,940 --> 00:04:06,800
ماذا ستفعلين إن كُنّا كذلك؟

46
00:04:07,940 --> 00:04:10,510
يبدو أنّكم لستم بارعين باختيار ضحاياكُم

47
00:04:10,510 --> 00:04:11,840
ماذا؟

48
00:04:12,410 --> 00:04:15,520
يجب أن تكونوا شاكرين إن اقتصر الأمر
على خسارة ذراع واحدة

49
00:04:15,520 --> 00:04:16,520
ماذا قلتِ؟

50
00:04:16,520 --> 00:04:17,480
!مهلًا لحظة

51
00:04:18,250 --> 00:04:20,420
سمعتُ كل شيء

52
00:04:20,420 --> 00:04:22,490
سأحتلّ هذا القتال

53
00:04:22,490 --> 00:04:23,830
ماذا تعمل...؟

54
00:04:23,830 --> 00:04:26,690
.مساعد
أيّة اعتراضات؟

55
00:04:26,690 --> 00:04:29,360
.هذا ليس ما قصدته
ماذا تعمل هناك؟

56
00:04:30,500 --> 00:04:33,430
حاولتُ أخذ طريق مُختصر وانتهى بي المطاف عالقًا

57
00:04:33,900 --> 00:04:35,370
لكن شاهدي فقط

58
00:04:37,840 --> 00:04:38,510
كيف كان هذا؟

59
00:04:38,510 --> 00:04:39,740
كيف لك أن تسألني؟

60
00:04:39,740 --> 00:04:42,140
!على أيّ حال، ماذا عن القتال؟

61
00:04:43,010 --> 00:04:47,350
حسنًا يا مُثيري الشّغب، أنا مستعد، هاجموا في أيّ وقت

62
00:04:47,350 --> 00:04:49,650
...تمهّل لحظة، إن هذا القتال

63
00:04:49,650 --> 00:04:51,150
من هو مُثير الشّغب هنا؟

64
00:04:51,150 --> 00:04:52,620
!أيّها اللعين

65
00:04:55,760 --> 00:04:57,620
ما المُشكلة؟

66
00:04:58,490 --> 00:05:00,220
أيّها الوغد

67
00:05:08,940 --> 00:05:10,530
ما خطب هذا الرجُل؟

68
00:05:18,710 --> 00:05:20,350
!رائع

69
00:05:20,350 --> 00:05:21,580
!هل أنت أحمق؟

70
00:05:21,580 --> 00:05:22,580
بمَ كنت تفكّر؟

71
00:05:22,120 --> 00:05:25,480
مهلًا، أنتُم! ما كلّ تلك الضجة داخل المدينة الملكية؟

72
00:05:27,160 --> 00:05:29,320
أهذا كُل شيء؟

73
00:05:29,320 --> 00:05:30,950
سيُقبض عليك أيضًا إن لم تهرب بسرعة

74
00:05:31,890 --> 00:05:33,090
!أوه، انتظري

75
00:05:36,660 --> 00:05:37,630
!تمهّل

76
00:05:38,170 --> 00:05:38,970
أهلًا بك

77
00:05:38,970 --> 00:05:40,070
!جيني

78
00:05:40,070 --> 00:05:41,570
لقد تأخرتِ

79
00:05:41,570 --> 00:05:44,670
آسفة، أعاقني شيءٌ ما

80
00:05:44,670 --> 00:05:46,170
إذن؟ كيف يسير الأمر؟

81
00:05:46,170 --> 00:05:49,940
لا يوجد فتيات ساحِرات ترغبن بالمُغامرة

82
00:05:50,510 --> 00:05:55,280
هُنا في أوفن، جميعهنّ مهووسات
بالدراسة داخل نقابة السّحرة

83
00:05:55,280 --> 00:05:59,490
إن كارويس-ساما العظيم هو من يترأس هذه النقابة

84
00:05:59,490 --> 00:06:02,720
أتصوّر أن تدريب السّحرة شديد الصّرامة هُناك

85
00:06:02,720 --> 00:06:06,430
أوامر مايلي متشددة أيضًا، أليس كذلك؟

86
00:06:06,430 --> 00:06:08,860
ألا تقول القسّيسة العُليا جيني أي شيء؟

87
00:06:08,860 --> 00:06:12,930
بالنّسبة لنا كتابعي لِمايلي، القتال أحد واجباتنا

88
00:06:12,930 --> 00:06:15,540
لن يوقفوا المغامرات

89
00:06:15,540 --> 00:06:17,000
أهذا ما عليه الأمر؟

90
00:06:17,000 --> 00:06:22,180
أتعلمن، سمعت أنّ هناك حانة في الشمال
يتسكّع بها السحرة

91
00:06:22,180 --> 00:06:23,640
تريدون الذهاب هناك بِالغد؟

92
00:06:30,620 --> 00:06:33,020
أنتِ ساحرة، أليس كذلك؟

93
00:06:34,120 --> 00:06:35,090
...أجل

94
00:06:35,090 --> 00:06:37,130
نودّ التحدُّث معكِ قليلًا

95
00:06:37,130 --> 00:06:38,490
أتُمانعين لو جلسنا؟

96
00:06:38,490 --> 00:06:39,960
تفضلوا

97
00:06:40,800 --> 00:06:43,100
...نحنُ مُغامِرات

98
00:06:43,100 --> 00:06:45,000
!مذهل، أقُلتِ مُغامِرات؟

99
00:06:45,000 --> 00:06:46,400
هل أنتِ مُهتمة؟

100
00:06:46,400 --> 00:06:50,300
!لا بُد أنّكن تجِدن الكثير من الكنوز

101
00:06:50,300 --> 00:06:51,410
...نوعًا ما

102
00:06:51,410 --> 00:06:53,310
!أشعُر بالغيرة

103
00:06:53,310 --> 00:06:56,540
حاليًّا نحن نستكشف آثار يُحتمل وجود
كنوز فيها

104
00:06:56,540 --> 00:06:59,780
!سأود شِراء كنز سحريّ لو وجدتنّ واحدًا

105
00:07:00,380 --> 00:07:02,950
لا، لم نكن على وشك سؤالكِ هذا

106
00:07:02,950 --> 00:07:06,320
إننا نبحث عن ساحرة لتنضمّ لفريقنا

107
00:07:06,320 --> 00:07:09,320
ماذا؟ أتعنينَ أنكن ترِدنني أن أُصبح مُغامِرة؟

108
00:07:09,320 --> 00:07:10,790
نعم، نعم

109
00:07:11,890 --> 00:07:15,160
...أنا لا أزال أتعلم كما ترون، لِذا

110
00:07:15,160 --> 00:07:17,030
...أن أكون مُغامِرة سيكون نوعًا ما

111
00:07:20,070 --> 00:07:21,400
!أوه، وجدتها

112
00:07:21,400 --> 00:07:24,940
!أعرف ساحِرًا سيرغب بالمُغامرة

113
00:07:24,940 --> 00:07:27,010
ومن يكون هذا الشّخص؟

114
00:07:27,010 --> 00:07:28,910
!آسف! آسف يا آيلا

115
00:07:28,910 --> 00:07:29,940
هل انتظرتِ طويلًا؟

116
00:07:32,110 --> 00:07:33,210
!المُنحرف

117
00:07:33,210 --> 00:07:34,420
مُنحرف؟

118
00:07:34,420 --> 00:07:35,380
!مُفتعل الشجارات

119
00:07:35,380 --> 00:07:36,850
مُفتعل شجارات؟

120
00:07:38,920 --> 00:07:41,890
أوه، أتعرفون بعضكم البعض يا رِفاق؟

121
00:07:41,890 --> 00:07:43,790
هذا سيسهّل الأمر إذن

122
00:07:43,790 --> 00:07:46,130
لوي، إنهنّ مُغامِرات

123
00:07:46,130 --> 00:07:48,830
وهنّ يبحثن عن ساحرٍ لينضمّ لهن

124
00:07:48,830 --> 00:07:50,200
مُغامِرات؟

125
00:07:50,200 --> 00:07:52,500
!ساحر؟ هذا؟

126
00:07:52,500 --> 00:07:54,540
...هو لا يبدو كَساحر حقًّا

127
00:07:54,540 --> 00:07:57,270
!إنّه أسوأ أنواع الرِجال

128
00:07:57,270 --> 00:07:58,470
فعلًا

129
00:07:58,470 --> 00:08:02,280
فهمت، أنتنّ تحتجن ساحرًا يا رفاق، صحيح؟

130
00:08:02,280 --> 00:08:04,310
أكُنت تستمع لما نقوله؟

131
00:08:04,310 --> 00:08:09,750
في الحقيقة، نحن نبحث عن ساحرة أنثى
...لتنضمّ إلينا

132
00:08:09,750 --> 00:08:11,650
في هذه الحالة، لن تجِدن واحدة

133
00:08:11,650 --> 00:08:12,450
ماذا؟

134
00:08:12,450 --> 00:08:13,690
هذا صحيح

135
00:08:13,690 --> 00:08:17,650
جميع الفتيات هُنا ضعيفات ليغامِرن

136
00:08:18,160 --> 00:08:20,060
...لكن أنا

137
00:08:20,060 --> 00:08:21,790
لا نريد منحرفًا

138
00:08:22,400 --> 00:08:24,300
!أنا لستُ منحرف

139
00:08:24,300 --> 00:08:28,200
.لا نستطيع اصطحاب مغفّل يعرّض نفسه لِلخطر

140
00:08:29,300 --> 00:08:32,140
ذاك القتال كان مجرّد لعبة بالنسبة لي

141
00:08:33,010 --> 00:08:34,570
!المُغامرة ليست لعبة

142
00:08:38,680 --> 00:08:40,880
،تبدين كمُقاتلة

143
00:08:40,880 --> 00:08:43,990
ولكن هناك أشياء لا تستطيعين التغلُّب
،عليها بِمُفردك

144
00:08:43,990 --> 00:08:46,320
لذا تبحثين عن ساحر، صحيح؟

145
00:08:46,320 --> 00:08:48,550
لا نحتاج ساحِرًا عديم جدوى

146
00:08:50,260 --> 00:08:55,490
هل أُثبت لكِ أنني لست بساحر
اعتيادي أيتها الشّابة؟

147
00:08:56,630 --> 00:08:58,360
هذه ليست لُعبة

148
00:09:00,300 --> 00:09:01,800
!جيني

149
00:09:01,800 --> 00:09:04,510
لا بأس. لنترك الأمر لها

150
00:09:04,510 --> 00:09:07,870
أظنّ أنكن لم تعدن بِحاجتي

151
00:09:08,710 --> 00:09:10,510
تمهّلي لحظة

152
00:09:10,510 --> 00:09:13,610
لا تقلق. سنفعل هذا بدون الإضرار بمحلّك

153
00:09:13,610 --> 00:09:16,670
ربّما ستتسخ الأرضية قليلًا مع ذلك

154
00:09:19,320 --> 00:09:21,450
قولي ما شئتِ

155
00:09:22,720 --> 00:09:25,830
هذه فرصتك الأخيرة لِلانسحاب أيّها السّاحر

156
00:09:25,830 --> 00:09:30,330
،أيًّا كان ما تنوي القيام به من سحر
فسيكون سيفي أسرع بِكثير

157
00:09:30,330 --> 00:09:33,730
...سيكون الأمر متأخرًا بالفعل إن بدأتُه الآن

158
00:09:33,730 --> 00:09:36,030
!لكنّني بدأتُ بالفعل

159
00:09:37,240 --> 00:09:39,040
!عنصرٌ سحريّ

160
00:09:39,040 --> 00:09:40,440
!لا تتحركي

161
00:09:40,440 --> 00:09:42,710
إنّه جاهز لِكشف تحركاتك

162
00:09:42,710 --> 00:09:46,080
إن اقتربتِ أكثر، جسدك بأكمله سيُشلّ

163
00:09:46,080 --> 00:09:48,340
!لوي، لوي

164
00:09:50,320 --> 00:09:51,650
!لوي

165
00:09:51,650 --> 00:09:53,420
!عناصر الشّلل زرقاء

166
00:09:53,420 --> 00:09:55,650
!هذا عنصر مُفجّر

167
00:09:58,190 --> 00:09:59,390
...أستطيع تغييرهُ الآن

168
00:09:59,390 --> 00:10:00,660
!من المستحيل فعلها الآن

169
00:10:01,160 --> 00:10:03,320
!إذن ماذا أفعل؟

170
00:10:22,120 --> 00:10:23,580
!ذاك المُنحرف اللعين

171
00:10:23,580 --> 00:10:25,450
!أيعتبر هذا سحرًا؟

172
00:10:25,890 --> 00:10:28,860
...العبثُ بالسّحر هكذا
!لقد تمادى قليلًا

173
00:10:29,290 --> 00:10:31,760
سنسوّي حسابنا معه

174
00:10:31,760 --> 00:10:33,490
نسوّي حسابنا معه؟

175
00:10:33,490 --> 00:10:35,090
أتعنين أنّنا سنراهُ مجددًا؟

176
00:10:37,200 --> 00:10:38,670
لنُغيّر الموضوع

177
00:10:38,670 --> 00:10:39,800
!هذه فكرة جيّدة

178
00:10:39,800 --> 00:10:42,570
!يجب أن نجد حلًّا لذلك الباب الموجود بِالآثار

179
00:10:42,570 --> 00:10:45,870
،أعتقد أنه لا يوجد خيار آخر
سأفتحه أنا

180
00:10:45,870 --> 00:10:48,480
،إن سخّرنا وقتنا في التّحضير للأمر
سننجح بطريقةٍ ما

181
00:10:48,480 --> 00:10:53,580
أيمكنني إذن أداء طقوس الوحي بينما تفعلن هذا؟

182
00:10:53,880 --> 00:10:55,250
طقوس وحي؟

183
00:10:55,250 --> 00:10:59,190
استطعت تلقّي إذن من القسّيسة العُليا جيني لهذا الأمر

184
00:10:59,190 --> 00:11:00,190
وما هو؟

185
00:11:00,190 --> 00:11:03,820
سأتلقّى وحيًا من إله المعارك مايلي

186
00:11:03,820 --> 00:11:08,160
سأطلب منه إعطائي اسمًا إن كان هُناك
بطلٌ عليّ خدمته

187
00:11:08,160 --> 00:11:10,060
مجدّدًا؟

188
00:11:10,060 --> 00:11:13,120
البطل هو رمز العدالة المطلقة

189
00:11:13,730 --> 00:11:17,760
!جبّار، قديسٌ نبيل ومحارب لا يُقهر

190
00:11:18,110 --> 00:11:21,340
،أفعاله أصبحت مثالًا يحتذي به كل النّاس

191
00:11:21,340 --> 00:11:25,110
!ومعاركه أصبحت أساطير يتداولها العالم

192
00:11:26,380 --> 00:11:28,510
!بطلي

193
00:11:28,950 --> 00:11:30,180
من أنتِ؟

194
00:11:30,180 --> 00:11:33,720
تلقّيت وحيًا من مايلي أنه عليّ خدمتك

195
00:11:33,720 --> 00:11:35,690
اسمي ميليسا

196
00:11:35,690 --> 00:11:38,730
أوه، إنها أنتِ. كنت بانتظاركِ

197
00:11:38,730 --> 00:11:42,000
!والآن دعينا نذهب في مغامرة سويًّا

198
00:11:42,000 --> 00:11:43,860
!بطلي

199
00:11:50,970 --> 00:11:52,840
ميليسا؟

200
00:11:53,940 --> 00:11:56,140
هي فتاة خلوقة بخلاف هذا

201
00:11:56,140 --> 00:11:57,970
يبدو أنّ الأمر سَيطول اليوم

202
00:11:58,450 --> 00:12:03,910
أحيانًا يجلب العظيم مايلي أقدارًا قاسية لنا

203
00:12:04,550 --> 00:12:10,420
من ناحية أُخرى، هذا امتحان يضعه مايلي لنا
ليهبنا الشّجاعة

204
00:12:11,060 --> 00:12:14,330
رغم أنّ المختارين فقط هم من يصبحون أبطالًا

205
00:12:14,330 --> 00:12:18,490
،هو يعلمنا كيفية السّعي لنُصبح أبطالًا
وكيف نتصرّف كأبطال

206
00:12:22,600 --> 00:12:26,800
سأتحدث في المرة المُقبلة عن ما معنى كون المرء بطل حقيقيّ

207
00:12:28,080 --> 00:12:29,370
!ميليسا-ساما

208
00:12:29,810 --> 00:12:30,780
!أيتها الفتيات

209
00:12:31,180 --> 00:12:34,320
أصحيحٌ أنكِ ستؤدين مراسم الوحي؟

210
00:12:34,320 --> 00:12:35,420
أجل

211
00:12:35,420 --> 00:12:38,920
!واثقة أنكِ ستخدمين بطل رائع يا ميليسا-ساما

212
00:12:38,920 --> 00:12:42,190
!أتساءل أي نوعٍ من الأبطال الرائعين سيكون

213
00:12:42,190 --> 00:12:45,460
ليس مؤكدًا أني سأتلقى الوحي حتى الآن

214
00:12:45,460 --> 00:12:48,030
!أنا متأكدة أنكِ ستتلقينها يا ميليسا-ساما

215
00:12:48,030 --> 00:12:51,930
كلّ هذا بيدِ إله المعارك مايلي

216
00:12:52,400 --> 00:12:53,870
أراكنّ لاحقًا

217
00:12:56,600 --> 00:12:58,710
...إن ميليسا-ساما حقًّا

218
00:12:58,710 --> 00:13:00,500
!رائعة

219
00:13:04,480 --> 00:13:08,880
!أتمنى لقياك سريعًا يا بطلي

220
00:13:10,720 --> 00:13:12,310
!أنت، اخرج

221
00:13:16,690 --> 00:13:18,330
ماذا؟ إنها أنتِ فقط يا آيلا

222
00:13:18,330 --> 00:13:20,050
ماذا تقصد بِـ "أنتِ فقط"؟

223
00:13:21,830 --> 00:13:23,060
أين المُسن؟

224
00:13:23,060 --> 00:13:27,500
قضيتَ بالسجن ليلة واحدة فقط بفضل كارويس-ساما

225
00:13:27,540 --> 00:13:29,970
،ولكنّ كارويس-ساما مشمئز منك

226
00:13:29,970 --> 00:13:31,560
لذا جئت لاصطحابك بدلًا منه

227
00:13:32,440 --> 00:13:34,340
مهلًا، استقِم

228
00:13:34,340 --> 00:13:36,610
!لديك محاضرة بعد الظهيرة لِعلمك

229
00:13:37,040 --> 00:13:38,980
لست بمزاجٍ لها في الحقيقة

230
00:13:41,380 --> 00:13:47,090
...وهكذا، لتصبحوا جميعكم سحرة باهرين

231
00:13:47,090 --> 00:13:49,360
...أودّ منكم الدراسة أكثر

232
00:13:48,060 --> 00:13:49,060
!لوي

233
00:13:51,330 --> 00:13:55,000
لوي، كما هو متوقّع من ابن المدير

234
00:13:55,000 --> 00:13:57,360
بالطّبع ستكون مسترخٍ

235
00:13:59,470 --> 00:14:00,930
عليّ الذهاب لدورة المياه

236
00:14:11,550 --> 00:14:13,010
!سحقًا

237
00:14:17,250 --> 00:14:20,080
مالذي يحدث معك مؤخّرًا؟

238
00:14:21,220 --> 00:14:24,090
أتعتقدين أنني قادر على أن أصبح ساحر؟

239
00:14:25,030 --> 00:14:27,600
حسنًا...أنت لا تبدو كواحد إطلاقًا

240
00:14:27,600 --> 00:14:29,100
ظننتُ ذلك

241
00:14:29,100 --> 00:14:33,570
لكن إن لم تكن لديك موهبة فستكون مفصول بالفعل الآن

242
00:14:33,570 --> 00:14:36,140
...مهما قالوا أنه بسبب تبنّي كارويس-ساما لك

243
00:14:36,140 --> 00:14:40,770
كوني ابنه المتبنّى لا يعني أني مؤهل لأكون ساحرًا

244
00:14:40,770 --> 00:14:44,750
،إن استخدمت هذا كعذرٍ لتثمل، تعبث مع النّساء

245
00:14:44,750 --> 00:14:50,850
،تتورط بالشّجارات ولا تطوّر مهاراتك السحرية
لن يكون لك أيّ مستقبل

246
00:14:50,850 --> 00:14:52,890
أعلم هذا

247
00:14:52,890 --> 00:14:54,390
اسمع يا لوي

248
00:14:54,390 --> 00:14:57,450
أنت تفكّر بأؤلئك الفتيات الثلاثة من
الليلة الماضية، صحيح؟

249
00:14:58,060 --> 00:14:59,790
مُغامِراتٍ، هاه؟

250
00:14:59,790 --> 00:15:03,360
...البعض سيفعل أيّ شيء لأجل المال كما يبدو

251
00:15:03,360 --> 00:15:06,330
لا يعجبني هذا حقًّا

252
00:15:06,330 --> 00:15:08,770
لا أظن أنهنّ من هذا النوع

253
00:15:08,770 --> 00:15:11,330
...مقاتلة، قسّيسة لمايلي

254
00:15:11,910 --> 00:15:13,940
لا بدّ أن الصغيرة لصّة

255
00:15:13,940 --> 00:15:18,150
!سيكون الوضع حافلًا لو انضمّ إليهن ساحر

256
00:15:18,150 --> 00:15:20,480
لكنّك رُفضت، صحيح يا لوي؟

257
00:15:20,480 --> 00:15:21,280
...هذا

258
00:15:21,280 --> 00:15:22,520
هذا؟

259
00:15:22,520 --> 00:15:23,720
...هذا بسبب

260
00:15:23,720 --> 00:15:24,950
ماذا؟

261
00:15:24,950 --> 00:15:27,660
!هذا بسبب أنهن لسن الأفضل

262
00:15:27,660 --> 00:15:28,620
ماذا؟

263
00:15:28,620 --> 00:15:30,120
لهذا السّبب

264
00:15:30,120 --> 00:15:31,460
أي سبب؟

265
00:15:31,460 --> 00:15:35,620
سأنضمّ لهن وأجعلهن الأروع

266
00:15:36,360 --> 00:15:37,830
هل أنت جاد؟

267
00:15:38,530 --> 00:15:41,270
،لا أملك أيّ فكرة عن مكان الاثنتين الأخريات

268
00:15:41,270 --> 00:15:43,840
لكن ميليسا قسّيسة مايلي

269
00:15:43,840 --> 00:15:45,100
سأذهب للتحدّث معها

270
00:15:45,740 --> 00:15:47,210
لوي

271
00:15:48,440 --> 00:15:50,210
...سأتمنّى

272
00:15:50,210 --> 00:15:51,680
ماذا؟

273
00:15:52,650 --> 00:15:54,240
...أشياء كثيرة

274
00:16:18,740 --> 00:16:21,830
!مع أنني جلبتها لتأكليها

275
00:16:22,410 --> 00:16:24,670
ميرل؟ ماذا كنتِ تفعلين اليوم؟

276
00:16:25,150 --> 00:16:28,820
كنت أساعد في بيع الفواكه في السوق كما ترين

277
00:16:28,820 --> 00:16:31,220
هذه بقايا، أتودّين أكلها معي؟

278
00:16:33,420 --> 00:16:35,590
هل تفكرين بالرّجل من الليلة الماضية؟

279
00:16:35,590 --> 00:16:37,090
الأمر ليس كذلك

280
00:16:37,090 --> 00:16:41,030
لا أستطيع التصديق بأنه خدعكِ يا جيني

281
00:16:41,030 --> 00:16:43,290
أعتقد أنه لهذا السبب يُدعون سحرة

282
00:16:45,270 --> 00:16:48,460
أتريدين رؤية مالذي تفعله ميليسا؟

283
00:16:50,140 --> 00:16:51,600
!المعذرة

284
00:16:55,440 --> 00:16:57,030
أنا من نقابة السّحرة

285
00:16:57,440 --> 00:16:59,480
أودّ رؤية القسّيسة ميليسا

286
00:16:59,480 --> 00:17:01,250
هل أنت تابع؟

287
00:17:01,250 --> 00:17:02,240
لا

288
00:17:06,990 --> 00:17:09,960
!كنت أحسن التصرّف لكونه معبد مقدّس

289
00:17:15,660 --> 00:17:17,000
!سحقًا

290
00:17:17,000 --> 00:17:19,130
!لمَ أنت هُنا؟

291
00:17:19,130 --> 00:17:22,040
!لماذا؟ جئت لأني لديّ عمل مع ميليسا

292
00:17:22,040 --> 00:17:23,400
هذا مستحيل

293
00:17:23,400 --> 00:17:26,370
إن ميليسا تؤدي مراسم مقدّسة

294
00:17:26,370 --> 00:17:27,610
!من المحال أن تتمكن من رؤيتها

295
00:17:27,610 --> 00:17:28,980
!كيف لي أن أعلم؟

296
00:17:28,980 --> 00:17:30,610
!سأراها بطريقةٍ أو بأخرى

297
00:17:30,610 --> 00:17:32,080
!أيها الأحمق

298
00:17:34,420 --> 00:17:36,420
لن يكون الأمر كالليلة الماضية

299
00:17:36,420 --> 00:17:40,220
...سيفكِ سريع بالتأكيد

300
00:17:40,220 --> 00:17:41,690
!ومع ذلِك

301
00:17:42,560 --> 00:17:44,820
!أستطيع الجري أسرع

302
00:17:45,430 --> 00:17:46,860
!انتظر

303
00:17:52,470 --> 00:17:55,470
هل انتهيتِ من التّحضير يا ميليسا؟

304
00:17:55,470 --> 00:17:58,310
أجل يا جيني-شيكو-ساما

305
00:17:58,310 --> 00:18:01,100
كل شيء بيدِ السيّد مايلي

306
00:18:04,010 --> 00:18:05,110
هل ميليسا هُنا؟

307
00:18:05,110 --> 00:18:06,580
!أيّها الوحش

308
00:18:16,120 --> 00:18:19,060
أمدنا بالشّجاعة للعيش

309
00:18:20,330 --> 00:18:24,490
أرجوك أرني علامة إن كان هناك بطل عليّ خدمته

310
00:18:26,570 --> 00:18:28,070
!اعثروا عليه بسرعة

311
00:18:28,070 --> 00:18:29,540
!من هذا الطريق

312
00:18:35,280 --> 00:18:36,740
!تمهّل

313
00:18:37,850 --> 00:18:39,540
!توقّف عندك

314
00:18:40,010 --> 00:18:42,750
إلهي مايلي، أرني علامة

315
00:18:42,750 --> 00:18:44,480
من هُنا، ذهب من هذا الطّريق

316
00:18:56,100 --> 00:18:57,530
لقد تأخّرت

317
00:18:59,600 --> 00:19:01,500
لا يوجد مكان لِلهرب

318
00:19:01,500 --> 00:19:04,160
أستقفز من هذا الارتفاع؟

319
00:19:05,710 --> 00:19:09,200
أم ستُقطع بواسطة سيفي؟

320
00:19:18,750 --> 00:19:23,920
إلهي مايلي، أهُناك بطل عليّ خدمته؟

321
00:19:28,400 --> 00:19:31,530
تابعتي المُخلصة ميليسا

322
00:19:31,530 --> 00:19:33,030
!نـ-نعم

323
00:19:33,030 --> 00:19:36,270
...البطل الذي تبحثينه عنه ويجب عليكِ خدمته هو

324
00:19:36,270 --> 00:19:37,740
!أجل؟

325
00:19:38,170 --> 00:19:39,540
!اللعنة

326
00:19:39,540 --> 00:19:42,810
واثقة أنّك تعرف هذا، ولكنني أخطأتك عمدًا

327
00:19:42,810 --> 00:19:46,080
هي تجعل الأمر واضحًا أنها أفضل منك بِمراحل

328
00:19:46,080 --> 00:19:48,120
!إن فهمت هذا، اغرب من هُنا

329
00:19:48,120 --> 00:19:49,580
!أيّها الغبيّ

330
00:19:52,050 --> 00:19:54,180
!لا تعبثي مع السّحرة

331
00:19:58,030 --> 00:19:59,490
!هذا السّحر...؟

332
00:20:00,330 --> 00:20:04,350
الشخص القادم الذي سيظهرُ أمامك سيكون بطلك

333
00:20:05,070 --> 00:20:08,340
إلهي مايلي، ماذا تعني بِهذا؟

334
00:20:08,340 --> 00:20:11,170
...لا أحد سيظهر هُنا

335
00:20:12,970 --> 00:20:14,440
!وداعًا

336
00:20:23,280 --> 00:20:25,680
أخفقت مجددًا

337
00:20:32,530 --> 00:20:33,990
بشريّ؟

338
00:20:45,440 --> 00:20:46,910
أهلًا

339
00:20:49,110 --> 00:20:50,580
!ميليسا

340
00:20:56,180 --> 00:20:57,740
هل أنتِ بخير يا ميليسا؟

341
00:20:59,720 --> 00:21:02,020
!لا