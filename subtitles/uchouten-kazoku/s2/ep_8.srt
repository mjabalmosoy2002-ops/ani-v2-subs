1
00:00:01,880 --> 00:00:05,850
اشهد نهايتي

2
00:00:11,140 --> 00:00:13,720
ماذا تفعل يا عمّي؟

3
00:00:13,720 --> 00:00:15,570
هذا مثير جدّاً للشفقة

4
00:00:16,260 --> 00:00:19,010
...إيبيسوغاوا سون

5
00:00:19,490 --> 00:00:23,390
يرحل الآن نحو عالم الموتى

6
00:00:35,990 --> 00:00:39,790
كلّ من سو-سان وإيبيسوغاوا-سان
قد رحلا إلى العالم التالي

7
00:00:40,310 --> 00:00:41,460
...أمّي

8
00:00:42,200 --> 00:00:47,380
تطوّع إيبيسوغاوا-سان للزواج
من عائلة إيبيسوغاوا بنفسه

9
00:00:49,440 --> 00:00:51,780
في الأساس، أراد جدّك

10
00:00:52,290 --> 00:00:56,230
أن يجد حلّاً للنزاع مع الإيبيسوغاوا

11
00:00:56,610 --> 00:01:00,620
...لهذا حاول أن يعقد سلاماً معهم، لكن

12
00:01:00,810 --> 00:01:06,060
لكن يبدو أنّ سون كان يتكلّم
مع عائلة إيبيسوغاوا

13
00:01:06,610 --> 00:01:10,100
انضمّ للإيبيسوغاوا لتحقيق
السّلام بين العائلتين

14
00:01:10,480 --> 00:01:13,410
لماذا حدث شيء كهذا؟

15
00:01:14,560 --> 00:01:15,750
فهمت

16
00:01:16,140 --> 00:01:18,130
أمّي لم تفهم إذاً

17
00:01:18,670 --> 00:01:20,620
كم هذا محزن

18
00:01:21,100 --> 00:01:23,910
لقد سئمتُ جدّاً من الأمر برمّته

19
00:01:23,910 --> 00:01:26,730
التانوكيّون مخلوقات حمقاء حقّاً

20
00:01:27,330 --> 00:01:28,480
!يا له من هراء

21
00:03:07,950 --> 00:03:10,540
أهذا أنت يا ياسابورو-تشان؟

22
00:03:12,290 --> 00:03:13,950
يا لك من كسول

23
00:03:13,950 --> 00:03:17,840
،في الأيّام الذي يكون الطقس فيها بهذا السوء
يجب أن يحمي المرء خلفيّته جيّداً

24
00:03:17,840 --> 00:03:21,100
أنت قلق جدّاً على خلفيّتك يا ياسابورو-تشان

25
00:03:21,100 --> 00:03:22,970
لدرجة أنّ هذا أصابك بعُصاب

26
00:03:23,840 --> 00:03:26,790
هل هي صدمة ناجمة عن الفطور؟

27
00:03:27,420 --> 00:03:31,850
شعرتُ بسوء حقّاً خاصّة حتّى كينكاكو
وغينكاكو كانا يسخران منكما

28
00:03:32,770 --> 00:03:35,190
كنتَ تجهشّ بالبكاء

29
00:03:37,020 --> 00:03:39,780
!ذيلك ظاهر

30
00:03:39,780 --> 00:03:42,110
!لم أكن أجهش بالبكاء

31
00:03:43,250 --> 00:03:44,530
أنا أمزح فحسب

32
00:03:45,040 --> 00:03:47,490
لطالما كنتَ تانوكيّاً صغيراً لا يبكي أبداً

33
00:03:48,770 --> 00:03:52,070
ما الذي أخّر يايتشيرو-سان يا ترى؟

34
00:03:55,610 --> 00:04:00,050
التانوكيّ الذي يلعب شوغي في يوم
ماطر وسيم جدّاً، ألا تعتقد ذلك؟

35
00:04:10,080 --> 00:04:12,810
...كوريتشيرو-سان من عائلة إيبيسوغاوا

36
00:04:13,000 --> 00:04:16,720
يبدو أنّه كان يرتّل السوترا أمام
أبيه الرّاحل طوال هذا الوقت

37
00:04:16,720 --> 00:04:19,600
بالطبع فهو راهب على ما أظن

38
00:04:20,090 --> 00:04:24,200
لا بدّ أنّه من الصّعب أن تدير كايسي-تشان
المصنع بمفردها

39
00:04:24,570 --> 00:04:28,390
وأنا متأكّدة أنّ أخويها الغبيّين لا يساعدانها

40
00:04:30,330 --> 00:04:34,120
هل سمعتَ للتو صوتَ دويّ؟

41
00:04:42,630 --> 00:04:43,890
!أمّي

42
00:04:45,540 --> 00:04:49,010
ارتعدتُ كثيراً! كان ذلك وشيكاً

43
00:04:53,130 --> 00:04:53,990
نظرة

44
00:04:55,050 --> 00:04:56,830
غيوكوران

45
00:04:56,830 --> 00:04:58,060
مساء الخير

46
00:04:58,490 --> 00:05:04,150
أنا آسفة، الرّعد والبرق يلغيان
تحوّلي دوماً

47
00:05:04,150 --> 00:05:06,950
بالنسبة لي، إنّه بوق بائع التوفو

48
00:05:06,950 --> 00:05:09,330
يُشعرني دوماً بالقلق

49
00:05:09,600 --> 00:05:13,660
أنتما جبانتان للغاية. أمّا أنا
فلا توجد نقطة ضعف لديّ

50
00:05:14,030 --> 00:05:15,560
حقّاً؟

51
00:05:22,440 --> 00:05:23,860
!ياجيرو-نيسان

52
00:05:37,240 --> 00:05:39,560
يبدو أنّ عائلتنا قد اكتملت

53
00:05:39,560 --> 00:05:41,720
حتّى غيوكوران هنا

54
00:05:42,090 --> 00:05:46,450
يا إلهي، لا جدوى إذا كانت رؤية
أمّي تجعلني أفقد تحوّلي

55
00:05:46,800 --> 00:05:48,860
ما زلتُ مندهشاً للغاية

56
00:05:49,230 --> 00:05:51,030
أحسنت صنعاً بعد هذا التّمرين الكبير

57
00:05:51,220 --> 00:05:55,820
أنا سعيدةٌ جدّاً بعودتك إلى المنزل يا ياجيرو

58
00:06:00,660 --> 00:06:01,630
من؟

59
00:06:06,190 --> 00:06:10,970
كنتُ أنوي إيجاد أبي وإحضاره إلى هنا

60
00:06:11,730 --> 00:06:15,430
لكن أبي قد توفّي

61
00:06:15,740 --> 00:06:17,200
كوريتشيرو؟

62
00:06:17,200 --> 00:06:19,560
لن يكون الاعتذار مليون مرّة كافياً

63
00:06:19,560 --> 00:06:22,060
للتكفير عن الأفعال الفظيعة
التي قام بها أبي

64
00:06:22,310 --> 00:06:23,710
،لكن

65
00:06:23,710 --> 00:06:28,380
آمل أن تظهروا الرّحمة لأطفال
عائلة إيبيسوغاوا الحمقى

66
00:06:28,800 --> 00:06:32,880
وأن يصبحوا الإيبيسوغاوا والشيموغاوا
أصدقاء حميمين

67
00:06:32,880 --> 00:06:37,250
أطلب منكم وكلّي تواضع أن تدعمونا

68
00:06:39,670 --> 00:06:43,720
أتوسّل إليكم أن تزيلوا الفراء
!عن مؤخّراتنا الخرقاء

69
00:06:43,720 --> 00:06:45,350
!بقدر ما تشاؤون

70
00:06:45,350 --> 00:06:46,960
!مع فائق الاحترام

71
00:06:47,180 --> 00:06:50,750
كوريتشيرو، أخفضوا مؤخّراتكم من فضلكم
وانظروا إلينا

72
00:06:50,750 --> 00:06:52,740
!أرجوكم! لا تتردّدوا

73
00:06:52,740 --> 00:06:54,050
!هيّا

74
00:06:55,960 --> 00:07:00,970
كوريتشيرو، من غير الممكن أن أسامح
عمّي على ما فعله

75
00:07:00,970 --> 00:07:05,820
لكن ما الفائدة التي أجنيها من نزع
الفِراء عن مؤخّراتكم؟

76
00:07:06,090 --> 00:07:10,600
فِراء والدنا قد عاد إلى النّعيم
وكذلك فِراء عمّنا

77
00:07:11,010 --> 00:07:15,540
المهمّ هو كيف سنقضي حياتنا من الآن فصاعداً

78
00:07:15,830 --> 00:07:17,080
كيف سنقضي حياتنا"؟"

79
00:07:17,510 --> 00:07:20,430
هل سنعيش معاً بسلام
أم يستمرّ هذا النزاع؟

80
00:07:23,320 --> 00:07:26,340
لا أريد أن يستمرّ النزاع

81
00:07:26,540 --> 00:07:29,200
إذاً لنوقف النزاع اليوم

82
00:07:29,200 --> 00:07:30,760
كلّنا تانوكيّون

83
00:07:31,270 --> 00:07:32,720
لنعش معاً بسلام

84
00:07:48,330 --> 00:07:52,420
لقد وصل شيموغامو ياسابورو

85
00:07:54,960 --> 00:07:56,500
حسناً، انتهيت

86
00:07:59,630 --> 00:08:01,340
إنّه ياسابورو

87
00:08:01,910 --> 00:08:05,630
حسناً إذاً يا معلّم، سأستأذن لهذه اللّيلة

88
00:08:05,630 --> 00:08:08,850
ماذا؟ لكن ما زلنا في أوّل اللّيل

89
00:08:08,850 --> 00:08:10,940
لا تقولي كلاماً مُوحِشاً كهذا

90
00:08:11,680 --> 00:08:14,800
لديّ موعد مع رجل نبيل في معبد
كيوميزو-ديرا اللّيلة

91
00:08:14,800 --> 00:08:15,970
!موعد؟

92
00:08:16,670 --> 00:08:19,390
لا تغر كثيراً من فضلك

93
00:08:20,950 --> 00:08:22,930
هل يُعقَل أن يكون مع النيدايمي؟

94
00:08:22,930 --> 00:08:28,840
إنّه زير نساء خسيس قذر كفضلات
أنفيّة متعفّنة

95
00:08:28,840 --> 00:08:32,740
هل يُعقَل أنّه قام بمغازلة حلوتي
البريئة بينتين؟

96
00:08:32,940 --> 00:08:34,730
أنا ذاهب إلى كيوميزو

97
00:08:34,730 --> 00:08:35,860
تعال معي

98
00:08:41,970 --> 00:08:44,640
انظر إلى كلّ هؤلاء الحمقى

99
00:08:44,640 --> 00:08:47,630
في هذه الحالة، لن أجد بينتين أبداً

100
00:08:48,040 --> 00:08:50,620
أنا متأكّد أنّ بينتين-ساما
ستبرز بشكل واضح

101
00:08:53,880 --> 00:08:56,350
سينسي، ابقَ هنا واستمتع ببعض الأمازاكي

102
00:08:57,050 --> 00:08:58,890
سأذهب وأبحث عنها

103
00:09:11,420 --> 00:09:13,030
إنّها بارزة حقّاً

104
00:09:14,240 --> 00:09:15,570
أترى؟ هناك

105
00:09:16,760 --> 00:09:18,680
هذا قبيح بحقّ

106
00:09:18,680 --> 00:09:21,510
إنّه لطيف ويشبه الشّمعة

107
00:09:22,200 --> 00:09:27,460
كلّما شعرتُ بالوحشة، أجلس
دوماً على قمّة ذلك البرج

108
00:09:27,870 --> 00:09:30,400
ثمّ أبدأ بالتحسّن تدريجيّاً

109
00:09:31,210 --> 00:09:35,840
إذاً ذلك الشّيء المريب قد أمسى نافعاً

110
00:09:36,280 --> 00:09:39,070
تقولها بطريقة ساخرة

111
00:09:39,070 --> 00:09:40,960
أنت مثل المعلّم تماماً

112
00:09:40,960 --> 00:09:43,250
تبدو هذه كإهانة شديدة

113
00:09:43,840 --> 00:09:46,310
لأنّني قصدتُ الإهانة فعلاً

114
00:09:51,170 --> 00:09:53,520
ينبغي أن تستسلمي يا آنسة

115
00:09:53,890 --> 00:09:56,170
هذه مضيعة للوقت والجهد

116
00:09:56,640 --> 00:09:58,280
أظنّنا ينبغي لنا ذلك

117
00:10:01,280 --> 00:10:02,780
ما هذا؟

118
00:10:03,350 --> 00:10:06,390
صنعتُه بوصلِ شعر المعلّم معاً

119
00:10:06,760 --> 00:10:09,540
فكّرتُ في خنقِك بواسطته حتّى الموت

120
00:10:10,830 --> 00:10:13,130
من فضلكِ، جرّبي ذلك

121
00:10:14,800 --> 00:10:17,340
أنت مملّ للغاية

122
00:10:17,550 --> 00:10:21,150
شكراً لك على قضاءِ الوقت
معي في هذه اللّيلة

123
00:10:21,150 --> 00:10:23,270
أشكرك من أعماق قلبي

124
00:10:24,100 --> 00:10:28,390
أفضّل قضاء الوقت معك هكذا عوضاً
عن محاولتكِ قتلي أثناء نومي

125
00:10:28,840 --> 00:10:29,940
لا تغترّ بنفسك

126
00:10:29,940 --> 00:10:32,360
بالطبع. فأنا مهمّ

127
00:10:33,030 --> 00:10:34,960
على الأقلّ، أنا أكثر أهمّية منكِ يا آنسة

128
00:10:35,760 --> 00:10:39,340
أنصحكِ أن تتوقّفي عن التحوّل إلى تينغو

129
00:10:39,340 --> 00:10:41,740
هذا مستقبلٌ غير واعد بالنسبة لكِ

130
00:10:42,270 --> 00:10:45,140
ماذا تقترح أن أفعل إذاً؟

131
00:10:45,560 --> 00:10:47,720
أنا متأكّد أن هناك طرق كثيرة أخرى
بمقدوركِ أن تسلكيها

132
00:10:47,720 --> 00:10:50,520
تتصرّف وكأنّك تعرفني

133
00:10:50,520 --> 00:10:53,750
أحاول أن أسدي إليكِ ببعض النصائح الصّادقة فحسب

134
00:10:54,130 --> 00:10:57,130
إن وقعتَ في حبِّي فلِمَ لا تعترف
بذلك وانتهى الأمر؟

135
00:10:57,130 --> 00:10:59,700
كفّي عن قول كلام فارغ من فضلكِ

136
00:10:59,700 --> 00:11:02,100
،لو أردتُ الاستماع لنصيحتِك

137
00:11:02,100 --> 00:11:04,600
فأفضّل الاستماع لتانوكي

138
00:11:08,010 --> 00:11:10,020
أنت متردّد للغاية

139
00:11:12,330 --> 00:11:14,540
لماذا عدت؟

140
00:11:14,540 --> 00:11:16,530
إلى هذه البلد وهذه المدينة؟

141
00:11:35,670 --> 00:11:36,970
،معلّم

142
00:11:37,560 --> 00:11:40,090
ماذا تفعل في مكانٍ كهذا؟

143
00:11:42,310 --> 00:11:43,430
بينتين؟

144
00:11:43,670 --> 00:11:45,240
ستُصاب بالرشح

145
00:11:45,240 --> 00:11:47,400
لنذهب إلى المنزل

146
00:12:03,520 --> 00:12:07,570
يبدو أنّ كوريتشيرو أعطى ياشيرو مختبراً جديداً

147
00:12:07,570 --> 00:12:09,280
لهذا سأذهب وألقي نظرة إليه

148
00:12:09,280 --> 00:12:10,730
يبدو هذا جيّداً

149
00:12:10,730 --> 00:12:12,560
أريد رؤيته أيضاً

150
00:12:14,470 --> 00:12:17,590
كنتَ تعتني بياشيرو. شكراً لك

151
00:12:17,780 --> 00:12:20,590
لا شكر على واجب. هذا من دواعي سروري

152
00:12:20,860 --> 00:12:24,710
علّمي ياشيرو-كن الكثير

153
00:12:34,430 --> 00:12:37,490
هل تنوي صنع رجل آليّ أو ما شابه؟

154
00:12:38,210 --> 00:12:40,350
أليس هذا المختبر رائعاً؟

155
00:12:40,350 --> 00:12:43,280
يدعني كوريتشيرو-سان أفعل
ما أشاء هنا

156
00:12:43,540 --> 00:12:46,750
هذه كلّ المعدّات التي كانت
مهجورة في السّقيفة

157
00:12:46,750 --> 00:12:50,270
نحرص على أن نستفيد منها

158
00:12:50,270 --> 00:12:52,370
هل تعرضت لأي صعقاتٍ كهربائيّة؟

159
00:12:52,790 --> 00:12:55,280
،أشعر بوخزةٍ أحياناً

160
00:12:55,280 --> 00:12:57,250
لكن ذلك شجّعني أكثر

161
00:13:00,900 --> 00:13:01,840
تفضّلوا

162
00:13:03,150 --> 00:13:04,200
ما هذا؟

163
00:13:04,200 --> 00:13:05,840
إنّه نموذجيّ

164
00:13:06,160 --> 00:13:08,200
لقد خمّرتُها للتو

165
00:13:17,460 --> 00:13:18,620
...هذا

166
00:13:19,010 --> 00:13:21,780
لا أدري ما إن كان ينبغي أن أقول
...أنّه عميق للغاية، أو

167
00:13:21,780 --> 00:13:24,650
يبدو وكأنّه له رائحة لاذعة فريدة

168
00:13:24,850 --> 00:13:27,540
بعبارة أخرى، مذاقه فظيع

169
00:13:31,620 --> 00:13:34,830
إذاً هناك مشكلة في جهاز التفريغ

170
00:13:38,330 --> 00:13:42,000
كوريتشيرو، استمرّ في الاعتناء بياشيرو من فضلك

171
00:13:54,600 --> 00:13:57,020
ثمّة شيء أريد أن أناقشك حوله

172
00:13:57,840 --> 00:14:01,230
تريد بعضاً من المساعدة من أخيك
المقتدر جدّاً؟

173
00:14:01,540 --> 00:14:03,310
"لا أعتبرها "مساعدة

174
00:14:03,310 --> 00:14:05,500
بل في الواقع، أظنّها كذلك

175
00:14:05,960 --> 00:14:09,000
لكنّه موضوع غاية في الحساسيّة

176
00:14:09,370 --> 00:14:12,450
لستُ جيّداً جدّاً عندما يتعلّق
الأمر بأشياء كهذه

177
00:14:12,450 --> 00:14:16,440
لهذا لا أدري كيف ينبغي لي المتابعة

178
00:14:16,440 --> 00:14:21,210
لكنّها محادثة لا بدّ أن أجريها معك
لذا سأفعل

179
00:14:21,210 --> 00:14:23,170
هلّا تطرّقتَ إلى الموضوع مباشرة؟

180
00:14:23,170 --> 00:14:26,420
!أنا على وشك أن أخبرك، لذا لا تستعجلني

181
00:14:30,930 --> 00:14:33,890
هل أنت مستعدّ لعقد خطوبتك
من كايسي مجدداً؟

182
00:14:35,840 --> 00:14:38,390
لِمَ هذا الكلام فجأة؟

183
00:14:38,390 --> 00:14:42,260
بالطبع، سنتحدّث مع كايسي
...وكوريتشيرو أولاً، لكن

184
00:14:42,260 --> 00:14:43,650
أرفض

185
00:14:43,650 --> 00:14:47,910
حتّى أنت لم تتزوّج بعد لتُحاول
أن تزوّج أخاك الصّغير

186
00:14:47,910 --> 00:14:49,240
أنت تعاني كثيراً

187
00:14:49,240 --> 00:14:54,440
وتانوكيّ مثلك عليه أن يسرع ويجد
زوجة له للاستقرار

188
00:14:54,440 --> 00:14:57,290
إنّي أرى سقوطك في قدر بخاري وبوضوح

189
00:14:57,460 --> 00:15:01,120
تحاول إذاً أن تدع كايسي تراقبني وتعتني بي؟

190
00:15:01,120 --> 00:15:05,450
أقول لك أنّك بحاجة لشيء تحميه

191
00:15:05,450 --> 00:15:11,130
أنا متأكّد أنّ تسويتنا للخلافات
مع الإيبيسوغاوا لها شأن عظيم عندك

192
00:15:11,360 --> 00:15:13,880
لكن لستُ مهتمّاً بالزواج من تلك
غريبة الأطوار سليطة اللّسان

193
00:15:13,880 --> 00:15:17,270
والتي لا تظهر لي شكلها حتّى

194
00:15:17,270 --> 00:15:19,350
وماذا عن ياجيرو-نيسان أيضاً؟

195
00:15:21,280 --> 00:15:22,460
...ياسابورو

196
00:15:22,830 --> 00:15:25,360
هذه فكرة ياجيرو

197
00:15:28,270 --> 00:15:32,860
يخطّط ياجيرو-نيسان لمغادرة كيوتو، أليس كذلك؟

198
00:15:35,400 --> 00:15:37,580
أنا أفكّر بتركه وشأنه

199
00:15:37,580 --> 00:15:40,160
!أنا معارضٌ لذلك بشدّة

200
00:15:40,160 --> 00:15:42,550
لديه طريقه الخاص الذي يسلكه

201
00:15:42,550 --> 00:15:45,790
!لم أعهدك تانوكيّاً لئيماً هكذا

202
00:15:45,970 --> 00:15:48,520
وأنت لديك طريقك الخاصّ كذلك

203
00:15:48,520 --> 00:15:51,760
أحاول أن أفكّر بمستقبلِ عائلة شيموغامو

204
00:15:52,060 --> 00:15:54,180
رحلَ أبي

205
00:15:54,180 --> 00:15:58,700
إن لم أفكّر بكم جميعاً فمن سيفعل إذاً؟

206
00:15:58,700 --> 00:16:02,520
!لم أطلب منك أن تحلّ مكان أبي

207
00:16:02,520 --> 00:16:04,200
!لن تتمكّن أبداً من الحلول مكانه

208
00:16:04,200 --> 00:16:06,490
من الغرور أن تعتقد أنّك تستطيع
!فعل ذلك حتّى

209
00:16:18,130 --> 00:16:19,240
فهمت

210
00:16:19,920 --> 00:16:21,140
معك حقّ

211
00:16:36,350 --> 00:16:38,400
ني-سان

212
00:16:38,400 --> 00:16:39,560
أنت حيّ؟

213
00:16:40,710 --> 00:16:42,330
أهذا أنت يا ياسابورو؟

214
00:16:42,330 --> 00:16:44,970
عرفتُ أنّك ستأتي في النّهاية

215
00:16:45,670 --> 00:16:50,320
كلّ الأثاثات التي يحتاج إليها ضفدع
تتّسع جيّداً بمنديل

216
00:16:50,870 --> 00:16:53,610
تنوي المغادرة فعلاً إذاً

217
00:16:55,080 --> 00:16:57,140
أعرف ما تريد قوله

218
00:16:57,930 --> 00:16:59,770
أنت معارض لهذا، صحيح؟

219
00:17:00,710 --> 00:17:03,740
ما زلتَ غير قادر حتّى
على التحوُّل جيّداً

220
00:17:04,770 --> 00:17:06,910
سأتدبّر الأمر

221
00:17:06,910 --> 00:17:08,820
لديّ دواء جدّتي أيضاً

222
00:17:09,480 --> 00:17:11,210
ستُحزِن أمّي

223
00:17:11,700 --> 00:17:14,030
هذا جارح قليلاً

224
00:17:14,670 --> 00:17:17,220
لكن سأعود حتماً

225
00:17:18,080 --> 00:17:19,180
...ياسابورو

226
00:17:20,040 --> 00:17:22,760
هل تؤمن بفِراء القدر الأحمر؟

227
00:17:22,760 --> 00:17:23,760
...في الواقع

228
00:17:24,280 --> 00:17:25,320
لستُ متأكّداً تماماً من ذلك

229
00:17:26,120 --> 00:17:29,700
،هنالك تانوكيّان أعرفهما خير معرفة

230
00:17:29,700 --> 00:17:33,730
وذلكما الاثنان ملتفّان بفِراء
القدر الأحمر بشكل كامل

231
00:17:34,300 --> 00:17:37,270
هذا غريب جدّاً بصراحة

232
00:17:37,270 --> 00:17:40,300
ظاهريّاً، هذا واضح وضوح الشّمس

233
00:17:40,300 --> 00:17:44,040
لكن ذلكما الاثنان لا يعرفان على الإطلاق

234
00:17:44,650 --> 00:17:47,330
هذا نقيّ وبريء جدّاً

235
00:17:47,330 --> 00:17:50,130
يكفي لجعلِ ضفدع أخضر يحمرّ

236
00:17:51,480 --> 00:17:54,500
لا تذهب أرجوك يا ني-سان

237
00:17:55,790 --> 00:17:59,360
لا أستطيع أن أدلّلك للأبد يا ياسابورو

238
00:17:59,820 --> 00:18:03,810
ولا يستطيع يايتشيرو تدليلنا للأبد أيضاً

239
00:18:11,560 --> 00:18:13,690
لقد مضى أسبوع

240
00:18:14,150 --> 00:18:17,700
هذه مدّة طويلة جدّاً على الذهاب
إلى الجبال للحرَد فقط

241
00:18:17,900 --> 00:18:21,200
...كنتُ أفكّر بتركه وشأنه

242
00:18:21,200 --> 00:18:25,310
لكن لا يجوز أن يثير قلق عائلته إلى هذا الحدّ

243
00:18:25,310 --> 00:18:26,940
!يا له من طفل

244
00:18:32,940 --> 00:18:35,190
لديّ فكرة سديدة

245
00:18:35,190 --> 00:18:36,590
هلّا تركتم هذا الأمر لي؟

246
00:18:43,860 --> 00:18:46,470
هل تؤمن بفِراء القدر الأحمر؟

247
00:18:47,330 --> 00:18:48,670
أظنّني فعلت

248
00:18:49,120 --> 00:18:51,640
لِمَ أظهر بحلّة مثيرة للشفقة؟

249
00:18:54,160 --> 00:18:57,530
ها أنت هنا يا ياسابورو الغبيّ

250
00:18:58,740 --> 00:19:02,030
ماذا تفعلين هنا؟

251
00:19:02,030 --> 00:19:05,320
أتيتُ لآخذك أيّها المغفّل

252
00:19:05,790 --> 00:19:10,040
لم تُقلِق عائلتك فحسب، بل أقلقتَ
غيوكوران-سينسي أيضاً

253
00:19:10,040 --> 00:19:13,000
!لا تتحلّى بذرّة حسّ بالمسؤوليّة كتانوكي

254
00:19:13,000 --> 00:19:15,300
هل أنت طفل؟

255
00:19:15,720 --> 00:19:18,120
أجل، أنا طفل

256
00:19:18,670 --> 00:19:19,920
دعيني وشأني فحسب

257
00:19:19,920 --> 00:19:21,680
أرأيت؟ أنت كئيب

258
00:19:21,680 --> 00:19:23,090
!يا للإزعاج

259
00:19:23,090 --> 00:19:25,840
لم أطلب منكِ أن تأتي وتأخذيني

260
00:19:25,840 --> 00:19:28,470
أحتاج أحياناً لأوقات أفكّر فيها بمفردي

261
00:19:28,470 --> 00:19:32,730
وما الذي يمكنك التّفكير فيه بذلك
الرأس الفارغ الذي لديك؟

262
00:19:32,730 --> 00:19:34,630
اخرسي فحسب

263
00:19:34,630 --> 00:19:36,550
!وإلّا انتزعتُ الفراء من مؤخّرتك

264
00:19:36,550 --> 00:19:39,030
!دعني أراك تحاول

265
00:19:39,860 --> 00:19:41,660
لن أتكلّم معك بعد الآن

266
00:19:41,660 --> 00:19:43,820
لا بأس، وأنا لن أتكلّم معك أيضاً

267
00:19:43,820 --> 00:19:44,570
!لا مشكلة لديّ

268
00:19:44,570 --> 00:19:46,030
!ولا أنا

269
00:19:51,690 --> 00:19:53,750
،أنا أتحدّث مع نفسي هنا فحسب

270
00:19:54,430 --> 00:19:57,760
لكن أرفض خطوبتنا من جديد

271
00:19:58,240 --> 00:20:02,630
أنا أتكلّم مع نفسي أيضاً، لكن
هذا ما أريده كذلك

272
00:20:02,800 --> 00:20:05,420
عظيم أن نتّفق على شيء أخيراً

273
00:20:05,420 --> 00:20:08,140
أصبح لديّ غبيّين أعتني بهما

274
00:20:08,530 --> 00:20:11,350
لن أكون قادرة على الاعتناء بشخصٍ إضافيّ

275
00:20:11,600 --> 00:20:14,880
أجل، وأنا أرفض بشكلٍ قاطع كذلك

276
00:20:14,880 --> 00:20:19,290
أي نوع من التانوكيّين يرغب في الزواج
منكِ أصلاً؟

277
00:20:19,290 --> 00:20:21,360
لا يقبل بكِ إلّا غريب أطوار

278
00:20:21,360 --> 00:20:22,570
هكذا إذاً

279
00:20:22,570 --> 00:20:25,200
أنتِ سليطة اللّسان وكثيرة الاعتراض

280
00:20:25,200 --> 00:20:27,420
ولا تكشفين لي عن نفسكِ بعد كلّ هذه السّنوات

281
00:20:27,420 --> 00:20:28,700
!أنتِ غير منطقيّة

282
00:20:28,700 --> 00:20:31,830
أجل، أجل، أنا متأكّدة أنّ هذا يجعل
الأمر غير منطقيّ البتّة

283
00:20:31,830 --> 00:20:36,960
لو كنتُ سأتزوّجكِ فأفضّل الزواج
!من حجر لصنع المخلّل

284
00:20:37,840 --> 00:20:42,800
إن كنتَ ستتزوّج حجراً لصنع المخلّل
فسأتزوّج أنا هيسويشي-ساما إذاً

285
00:20:43,220 --> 00:20:45,900
،هيسويشي-ساما لا يتشاجر مع أخويّ

286
00:20:45,900 --> 00:20:49,440
أو يخرج مع أشخاص يأكلون قدور التانوكيّين البخاريّة

287
00:20:49,720 --> 00:20:52,980
أو يقع في حبّ نصف تينغو مثل بينتين

288
00:20:53,520 --> 00:20:55,610
لماذا تبكين؟

289
00:20:55,610 --> 00:20:57,570
!أنا لا أبكي بالطبع

290
00:20:57,570 --> 00:20:58,980
...لكن

291
00:20:58,980 --> 00:21:02,450
إن أردتَ رؤيتي بهذا الإلحاح فسأريك إذاً

292
00:21:02,450 --> 00:21:03,550
،إن رأيتَني

293
00:21:03,550 --> 00:21:06,660
!ستعلم بالضبط لماذا لا يمكننا أن ننخطب

294
00:21:25,020 --> 00:21:26,810
!قلتُ لك ذلك

295
00:21:27,260 --> 00:21:28,960
،إن رأيتَني

296
00:21:28,960 --> 00:21:31,470
!سيُلغى تحوّلك

297
00:21:33,030 --> 00:21:38,250
توقّفت إيبيسوغاوا كايسي عن الكشفِ عن نفسها
أمامي منذ مدّة طويلة جدّاً

298
00:21:39,390 --> 00:21:42,350
الإحساس بالقدر مع تانوكيّة لا تجيد
سوى قذف الإهانات

299
00:21:42,350 --> 00:21:45,490
.كلّما فتحت فمها هو أمر مستحيل

300
00:21:46,830 --> 00:21:51,280
إضافة إلى ذلك، هل من الممكن الزواج من فتاة

301
00:21:51,280 --> 00:21:53,290
تُلغي تحوّلك كلّما رأيتها؟

302
00:21:54,140 --> 00:21:55,000
...لا

303
00:21:56,310 --> 00:21:57,430
هذا غير ممكن

304
00:23:30,940 --> 00:23:34,010
!أنانيّة أكاداما-سينسي لا تُحتمَل

305
00:23:34,010 --> 00:23:36,790
ماذا ينبغي أن أفعل؟

306
00:23:36,790 --> 00:23:40,400
وجدتُها! ياسابورو، تحمّل ذلك فحسب