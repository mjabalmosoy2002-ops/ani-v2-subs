1
00:00:01,600 --> 00:00:04,100
ما هذا؟

2
00:00:12,110 --> 00:00:12,900
!غيوكوران؟

3
00:00:13,090 --> 00:00:14,520
!مـ-مـ-مهلاً! مهلاً

4
00:00:14,520 --> 00:00:16,320
اهدأ يا يايتشيرو

5
00:00:18,670 --> 00:00:20,540
يا له من ثقب غريب

6
00:00:24,870 --> 00:00:26,690
!ما-ما-ما-ما هذا؟

7
00:00:38,260 --> 00:00:39,560
أين نحن؟

8
00:00:39,560 --> 00:00:42,830
هذه غرفة الشّوغو الخاصّة بأبي

9
00:00:48,980 --> 00:00:51,730
...لذيذ

10
00:00:51,930 --> 00:00:53,650
!كاري

11
00:00:57,190 --> 00:00:59,840
كانت داخل رقعة الشّوغي إذاً

12
00:01:00,820 --> 00:01:04,750
لم تكن متّسخة هكذا عندما كنّا صغاراً

13
00:01:06,030 --> 00:01:08,950
ما الذي يفعله قِطار إبريق الشّاي في غرفة الشّوغي؟

14
00:01:08,950 --> 00:01:13,190
ماذا يوجد وراء هذا الباب برأيكما؟

15
00:01:15,650 --> 00:01:17,800
...ينتابني فضول لأعرف

16
00:01:18,220 --> 00:01:20,940
لِمَ تفوح رائحة كاري حادّة؟

17
00:01:25,580 --> 00:01:27,640
يا كُرات الفراء الغبيّة

18
00:01:27,640 --> 00:01:29,270
ماذا تفعلون؟

19
00:03:05,460 --> 00:03:07,550
حسناً، سأذهب الآن

20
00:03:08,290 --> 00:03:10,640
شكراً يا ياسابورو-تشان

21
00:03:10,640 --> 00:03:12,120
لا شكر على واجب

22
00:03:12,370 --> 00:03:15,730
قبل أن أنسى، اقتربَتْ محرقة وداع غوزان

23
00:03:15,730 --> 00:03:18,470
ينبغي أن تأتي لسفينتنا الفارهة أيضاً

24
00:03:18,470 --> 00:03:20,710
سآتي بكلّ تأكيد

25
00:03:21,220 --> 00:03:22,440
إلى اللّقاء

26
00:03:25,180 --> 00:03:28,220
لِمَ تتطفّل دوماً؟

27
00:03:28,220 --> 00:03:29,280
ماذا؟

28
00:03:29,280 --> 00:03:32,350
أفعل خيراً معك فتعاملني بهذه الطريقة؟

29
00:03:32,970 --> 00:03:36,900
ليسَتْ لدينا سفينة لمحرقةِ وداع غوزان

30
00:03:36,900 --> 00:03:37,720
ماذا؟

31
00:03:37,720 --> 00:03:41,720
ظننتُك ستستعير سفينة مبعوث من التّانوكي في نارا

32
00:03:41,720 --> 00:03:44,140
فشلَ ذلك

33
00:03:46,400 --> 00:03:47,740
هكذا إذاً

34
00:03:47,990 --> 00:03:51,460
قال التّانوكي نارا أنّك لا تستطيع استعارة السّفينة إذاً

35
00:03:51,460 --> 00:03:52,430
أجل

36
00:03:52,430 --> 00:03:54,000
ليس هذا فحسب

37
00:03:54,280 --> 00:03:59,460
قال لي أنّه لم ينتهِ من ترميمها بعد الأضرار
،التي تلقّتها العام الفائت

38
00:03:59,460 --> 00:04:01,270
لكن سمح للإيبيسوغاوا استعارتها

39
00:04:01,270 --> 00:04:04,010
اللّعنة على كينكاكو وغينكاكو

40
00:04:04,010 --> 00:04:05,760
يستمدّان القوّة والجاه من أموالهما

41
00:04:05,760 --> 00:04:09,440
يجب على شخص ما أن يلقّن ذلكما الحمقاوين
درساً قاسياً

42
00:04:09,440 --> 00:04:14,400
لكن لا أرى أنّ كايسي تساعدهما

43
00:04:14,930 --> 00:04:18,550
لا بدَّ وأنَّ من يخطِّط وراء الكواليس هو سون

44
00:04:18,550 --> 00:04:21,310
مضتْ ستّة أشهر منذ اختفائه

45
00:04:21,310 --> 00:04:23,440
حان وقتُه ليضجر من زيارة

46
00:04:23,440 --> 00:04:26,410
الينابيع السّاخنة ويبدأ بالتطفُّل ثانية

47
00:04:26,850 --> 00:04:28,530
ماذا عن محرقة الوداع؟

48
00:04:32,520 --> 00:04:34,540
اترك الأمر لي

49
00:04:40,500 --> 00:04:41,420
،سينسي

50
00:04:41,870 --> 00:04:46,840
هل يمكنني استعارة قِطار إبريق الشّاي لبعض الوقت؟

51
00:04:46,840 --> 00:04:49,850
لماذا ستستخدمه؟

52
00:04:49,850 --> 00:04:54,140
كلّ ما يفعله هو شرب الخمر والعوم في الهواء

53
00:04:54,600 --> 00:05:00,210
تعلم أنّنا نحن التّانوكيّون نحلّق في سماء اللّيل
لنستمتع بمحرقةِ وداع غوزان، صحيح؟

54
00:05:00,210 --> 00:05:03,320
حان تلك الفترة من العام مجدّداً إذاً

55
00:05:03,320 --> 00:05:05,780
أطلب منك بتواضُع أن تسمح لنا باستعارته

56
00:05:06,050 --> 00:05:07,130
موافق

57
00:05:07,130 --> 00:05:09,940
لكن بشرطٍ واحد

58
00:05:09,940 --> 00:05:12,040
اشرط ما تشاء

59
00:05:12,040 --> 00:05:15,440
لا تدعُني لمشاهدةِ محرقة الوداع

60
00:05:15,440 --> 00:05:16,960
لن أذهب

61
00:05:17,390 --> 00:05:21,110
لكن لن تبدأ المراسيم ما لم تأتِ يا سينسي

62
00:05:21,110 --> 00:05:25,040
لا أملك وقتاً أقضيه على مراسمِ التّانوكيين

63
00:05:25,750 --> 00:05:27,590
بالمناسبة يا ياسابورو

64
00:05:27,590 --> 00:05:30,770
سمعتُ أنّك كنتَ حاضراً

65
00:05:30,770 --> 00:05:33,460
عندما استعملَ ذلك الأحمق العنف مع بينتين

66
00:05:33,460 --> 00:05:38,520
ماذا تفعله متسلّلاً إلى منزله؟

67
00:05:38,950 --> 00:05:40,520
برِّر موقفك

68
00:05:41,070 --> 00:05:43,130
،كانَتْ هديّة متواضعة جدّاً

69
00:05:43,130 --> 00:05:45,470
أعطينا النيدايمي هديّةَ بمناسبة منزله الجديد

70
00:05:45,470 --> 00:05:48,160
كم مرّة يجب أن أخبرك؟

71
00:05:48,350 --> 00:05:51,420
إنّه ليس ابني، إنّه ليس تينغو

72
00:05:51,420 --> 00:05:52,740
وليس نيدايمي أيضاً

73
00:05:53,250 --> 00:05:56,310
بنيتين سترِثُ إرثَ نيويغاتاكي ياكوشيبو

74
00:05:56,900 --> 00:05:58,190
هذا ما قرّرتُه

75
00:05:58,190 --> 00:05:59,330
!لقد اتّخذتُ قراري

76
00:05:59,900 --> 00:06:01,290
،سينسي

77
00:06:01,290 --> 00:06:05,130
لا أظنّك بحاجةٍ لأن تكون بهذه العجلة، صحيح؟

78
00:06:05,610 --> 00:06:08,170
فأنتَ لن تتقاعد اليوم أو غداً

79
00:06:08,170 --> 00:06:09,240
!اصمت

80
00:06:09,690 --> 00:06:13,470
لا تنادِه نيدايمي مجدّداً

81
00:06:13,810 --> 00:06:15,470
هذه مُشكلة حقيقيّة

82
00:06:15,470 --> 00:06:18,110
ماذا ينبغي أن أناديه إذاً؟

83
00:06:18,110 --> 00:06:20,880
يمكنك أن تناديه بالسيّد الفاحش

84
00:06:21,690 --> 00:06:23,650
!اذهب واشترِ لي بعضاً من عيدان القطن

85
00:06:23,650 --> 00:06:25,640
،إن لم أحصل على أي عيدان قطن

86
00:06:25,640 --> 00:06:28,650
فستحكّني أذنايّ وأثير بعض الدوّامات

87
00:06:28,650 --> 00:06:30,450
حسناً، في الحال

88
00:06:44,360 --> 00:06:45,250
انتهيت

89
00:06:49,210 --> 00:06:50,820
...المعذرة

90
00:06:51,440 --> 00:06:53,470
لنبدأ كصديقين

91
00:06:53,990 --> 00:06:55,940
لكنّنا صديقان من الأساس

92
00:06:56,950 --> 00:07:00,550
مـ-مـ-من فضلك اخرجي معي

93
00:07:00,550 --> 00:07:01,660
إلى أين؟

94
00:07:01,660 --> 00:07:03,380
ليس هذا ما أعنيه

95
00:07:03,380 --> 00:07:05,360
كفّ عن الالتفافِ من فضلك

96
00:07:05,360 --> 00:07:08,440
قُلْ فحسب "أحبُّك" حالاً

97
00:07:08,840 --> 00:07:10,650
،انظر في عينيّ

98
00:07:10,650 --> 00:07:12,870
وقلها بسرعة

99
00:07:13,910 --> 00:07:15,450
لماذا تتردّد؟

100
00:07:15,780 --> 00:07:19,060
!هيّا! هيّا! هيّا! هيّا

101
00:07:22,910 --> 00:07:24,210
!لا تبالغ

102
00:07:24,880 --> 00:07:26,330
لماذا فعلت هذا؟

103
00:07:26,330 --> 00:07:27,800
...بعدما عرضتُ عليك أن

104
00:07:27,800 --> 00:07:29,320
!نحن جاهزون

105
00:07:34,380 --> 00:07:36,640
تفضّلوا بالجلوس جميعاً

106
00:07:37,100 --> 00:07:39,600
ستغادر هذه السّفينة في أيّ لحظة

107
00:07:42,800 --> 00:07:44,520
!الجميع قد صعدوا

108
00:07:52,320 --> 00:07:54,450
!احرص على القيادةِ بأمان

109
00:07:54,450 --> 00:07:57,280
!التانوكيّون لا يفقهون شيئاً في الطيران

110
00:07:57,280 --> 00:07:59,670
كيف تجرؤ على القيادةِ برعونة هكذا

111
00:07:59,670 --> 00:08:02,660
عندما يكون على متنِ المركبِ شخصٌ مهمٌّ مثلي

112
00:08:07,150 --> 00:08:10,240
لقد بلغنا الآن ارتفاعَ الرّحلة الجويّة

113
00:08:10,240 --> 00:08:13,540
!قلتُ لك قُد هذا الشّيء بأمان

114
00:08:13,540 --> 00:08:17,970
في الواقع، ياجيرو-نيتشان سارَ بسرعة فائقة

115
00:08:18,130 --> 00:08:19,040
آسف

116
00:08:19,040 --> 00:08:21,020
لقد تحمّستُ زيادة عن اللّزوم

117
00:08:21,350 --> 00:08:22,500
يا إلهي

118
00:08:22,500 --> 00:08:25,280
انسكبَ الحساء في كلّ مكان

119
00:08:25,280 --> 00:08:29,460
لكن كانت التشيراشيزوشي سيّئة أساساً
لذا لا مُشكلة في ذلك

120
00:08:34,350 --> 00:08:35,450
تفضّل يا سيّدي

121
00:08:37,050 --> 00:08:40,590
يايتشيرو، ألن تتحوّل إلى هوتي؟

122
00:08:40,590 --> 00:08:42,450
سأرفض اللّيلة

123
00:08:42,910 --> 00:08:45,880
عجباً، أراك تتصرّف بتعجرُف

124
00:08:45,880 --> 00:08:50,310
غيوكوران موجودة اليوم، لذا يحاول أخي أن يثير إعجابها

125
00:08:51,600 --> 00:08:54,420
أنتما تفكِّران بالزواج إذاً يا كرتا الفِراء

126
00:08:54,670 --> 00:08:58,300
حسنٌ، لا ضير في ذلك. هيّا، حدّقا ببعضكما الآخر

127
00:08:58,300 --> 00:09:01,500
سينسي، لسنا في مباراة سومو

128
00:09:01,500 --> 00:09:04,140
يبدو يايتشيرو-سان مضطرّباً جدّاً

129
00:09:04,140 --> 00:09:07,230
ولماذا تحاول كرة فراء أن تدّعي القوّة؟

130
00:09:07,230 --> 00:09:09,450
هل ظننت أنّ بمقدورك إخفاء ودّك

131
00:09:09,450 --> 00:09:11,480
عن شخصٍ مُخضرم مثلي؟

132
00:09:12,660 --> 00:09:15,980
منذ زمن بعيد، كنتُ قد رأيتُ سويتشيرو وتوسين

133
00:09:15,980 --> 00:09:20,490
،يقفان على عتبةِ الحبّ دون أن أمرّ منها

134
00:09:20,750 --> 00:09:23,080
وهذا أغضبني كثيراً

135
00:09:23,630 --> 00:09:25,300
أجل

136
00:09:25,300 --> 00:09:30,250
وكان ذلك عندما حبستَني أنا وسويتشيرو-سان
داخل غرفة الشّوغي تلك

137
00:09:30,680 --> 00:09:33,650
وقلتَ "إمّا تقارَبا أو افترِقا

138
00:09:33,650 --> 00:09:38,680
لن أدعكما تخرجان قبل أن تحسما
"هذه المسألة بشكلٍ نهائي

139
00:09:39,090 --> 00:09:41,480
في النّهاية، قرّرا التقارُب

140
00:09:41,480 --> 00:09:45,800
وُولِدتُم يا أقزام. ينبغي أن تكونوا ممتنّين لي

141
00:09:45,800 --> 00:09:48,030
لم أكن أدري أنّ شيئاً كهذا قد حدث

142
00:09:48,980 --> 00:09:53,500
كُرات الفِراء مخلوقات مزعجة حقّاً

143
00:09:55,500 --> 00:09:57,110
إن كنتَ تحبّها فقلها فحسب

144
00:10:07,560 --> 00:10:11,580
أحبُّك

145
00:10:15,090 --> 00:10:18,870
سينسي، أنت حقّاً شخصيّة رفيعة جدّاً

146
00:10:19,760 --> 00:10:21,090
بالطبع

147
00:10:21,090 --> 00:10:22,800
فأنا رجلٌ عظيم

148
00:10:25,430 --> 00:10:27,930
انصرفا وعيشا بسعادةٍ الآن

149
00:10:37,320 --> 00:10:39,920
غدَتْ هذه ليلة رائعة

150
00:10:39,920 --> 00:10:42,380
الشّيء الممتع هو شيء جيّد

151
00:10:42,380 --> 00:10:45,420
من المؤسف أن تبقى عالقاً في شكلِك هذا

152
00:10:45,420 --> 00:10:47,410
لكن لا أشعر بالوحدة

153
00:10:47,960 --> 00:10:51,920
أشعر بدفء في بطني بسببِ احتفاء الجميع

154
00:10:52,680 --> 00:10:55,670
العيش كضفدع في قاعِ بئر

155
00:10:55,670 --> 00:10:58,920
يعني أن يبقى بطنك بارداً دوماً

156
00:10:58,920 --> 00:11:01,660
الشّيء الممتع هو شيء جيّد

157
00:11:03,390 --> 00:11:06,050
أشعر وكأنّ شيئاً وقفَ على ظهري للتو

158
00:11:24,100 --> 00:11:26,850
النسيم عليل جدّاً يا ياسابورو

159
00:11:27,510 --> 00:11:29,410
ينبغي أن تنضمّ إليّ

160
00:11:29,790 --> 00:11:33,830
ما الذي تفعله أريكة نيدايمي هنا؟

161
00:11:33,830 --> 00:11:36,580
فكّرتُ في تأمُّل المشهد اللّيلي

162
00:11:36,580 --> 00:11:38,840
متمدّدة على هذه الأريكة الجميلة

163
00:11:38,840 --> 00:11:41,540
أليس من السيّئ أخذ شيء

164
00:11:41,540 --> 00:11:43,230
من نيدايمي دون إذن؟

165
00:11:43,230 --> 00:11:45,320
يا لك من جبان

166
00:11:45,320 --> 00:11:46,930
!من الطبيعي أن أخاف

167
00:11:47,420 --> 00:11:51,220
ما المُشكلة التي بمُتناول اليد الآن يا ترى؟

168
00:11:51,840 --> 00:11:54,400
فيما إذا كنتُ مرتاحة أم لا، صحيح؟

169
00:11:56,040 --> 00:11:57,630
ياسابورو

170
00:11:57,630 --> 00:12:00,580
من تحبّ أكثر، أنا أم النيدايمي؟

171
00:12:00,580 --> 00:12:03,640
أحترمكما بصفةِ تينغو

172
00:12:03,640 --> 00:12:06,410
فالتانوكيّون عليهم احترام التينغو

173
00:12:06,410 --> 00:12:09,870
أكره إجابات مُبهمة كهذه

174
00:12:09,870 --> 00:12:13,120
إذا كرّرت هذا الكلام فسأضعك على قدرٍ بخاري

175
00:12:13,600 --> 00:12:17,110
لا بدّ وأنّكِ غاضبة جدّاً من النيدايمي يا بينتين-ساما

176
00:12:17,110 --> 00:12:17,860
ماذا؟

177
00:12:17,860 --> 00:12:20,380
لكنّني مستمتعة

178
00:12:20,620 --> 00:12:22,840
كلّ شيء ممتع بالنسبة لي

179
00:12:22,840 --> 00:12:25,220
!أراكِ هنا يا بينتين

180
00:12:25,480 --> 00:12:27,220
ابقي مكانكِ. أنا قادمٌ إليكِ

181
00:12:29,150 --> 00:12:31,020
انظر هناك يا ياسابورو

182
00:12:31,020 --> 00:12:32,930
أصدقاؤك قد وصلوا

183
00:12:49,390 --> 00:12:52,250
حسنٌ إذاً يا زملائي الأعزّاء
..في عشيرة شيموغامو

184
00:12:52,250 --> 00:12:56,260
بصفتي سيّد نبيل إنجليزي، أطلب منكم
أن تسمحوا لي بإلقاء كلمة

185
00:12:56,260 --> 00:12:59,960
أليس هذا قطاراً أكثر منه سفينة فارهة؟

186
00:12:59,960 --> 00:13:03,340
أنا واثقٌ أنّه مجرّد تحوُّل لياجيرو يا ني-سان

187
00:13:03,340 --> 00:13:07,740
في هذه الحالة، فهو ليس قطاراً حتّى

188
00:13:07,740 --> 00:13:10,970
لو كنّا مكانكم لخجِلنا حتّى
من التّحليق في هذه السّماء

189
00:13:10,970 --> 00:13:14,160
هذا طبيعي، فهو لا يعرفون الخجل

190
00:13:14,160 --> 00:13:16,460
لم يستطيعوا الحصول على سفينةٍ فارهة
لأجلِ المحرقة

191
00:13:16,460 --> 00:13:18,960
لهذا يرتشفون الشّاي داخل قطار مزيّف

192
00:13:19,560 --> 00:13:24,180
كان ليخجل التانوكيّون الأصيلون لدرجة أنّ الفراء
في ظهرهم سيتساقط

193
00:13:24,680 --> 00:13:27,780
!اشهدوا عظَمة سفينتنا بالمُقارنة

194
00:13:28,210 --> 00:13:30,900
!اشهدوا ذوقنا الإبداعيّ

195
00:13:32,990 --> 00:13:35,430
!الجاهزيّة كاملة، كلّ شيء على ما يُرام

196
00:13:35,430 --> 00:13:37,750
!التانوكي البارع يعرف ما يجري

197
00:13:37,750 --> 00:13:40,250
!الجاهزيّة كاملة، كلّ شيء على ما يُرام

198
00:13:40,500 --> 00:13:42,140
حسنٌ، ما رأيك؟

199
00:13:42,610 --> 00:13:44,710
!منزعج؟ حاول أن تردّ بشيء

200
00:13:44,710 --> 00:13:46,130
!اصمت يا كينكاكو

201
00:13:46,130 --> 00:13:49,120
تلك كانت السّفينة التي سنستعيرها

202
00:13:49,120 --> 00:13:50,890
حصلتُم عليها بأسلوب قذر

203
00:13:50,890 --> 00:13:53,710
هل تحاول أن تقول أنّنا أخذناها منكم؟

204
00:13:53,710 --> 00:13:55,250
على رسلِك يا ياسابورو

205
00:13:55,250 --> 00:13:57,860
كفّ عن أعذارك المثيرة للشفقة

206
00:13:57,860 --> 00:13:59,060
توقّف

207
00:13:59,060 --> 00:14:00,360
توقّف فحسب

208
00:14:00,360 --> 00:14:04,610
بصِفتي شخص جدير بالمسؤوليّة، صعدتُ
إلى شيوخ نانتو وقلت

209
00:14:05,510 --> 00:14:08,860
مرحباً! هذا أنا، كينكاكو"

210
00:14:08,860 --> 00:14:12,870
"!أعطوني أيّما يتوفّر مجدّداً هذا العام

211
00:14:12,870 --> 00:14:18,030
أليس إلقاء تحيّة مناسبة عليهم هو
التصرُّف الطبيعيّ الأنسب؟

212
00:14:18,030 --> 00:14:20,080
أخي أصيل جدّاً

213
00:14:20,080 --> 00:14:22,880
إنّه مختلف عن تانوكي بدائي مثلك

214
00:14:22,880 --> 00:14:23,950
أجل، بالفعل

215
00:14:23,950 --> 00:14:26,590
فأساساً أنا سيّد نبيل إنجليزي

216
00:14:26,590 --> 00:14:29,090
،ومع التحيّة

217
00:14:29,090 --> 00:14:31,600
من اللّباقة الشّائعة تقديم هديّة، أليس كذلك؟

218
00:14:31,600 --> 00:14:35,280
وهل من هديّة أجمل من دينكي بران الخداع خاصّتنا

219
00:14:35,280 --> 00:14:37,610
والمليئة بقلبنا وروحنا؟

220
00:14:37,610 --> 00:14:39,350
لا أعتقد أنّه يوجد

221
00:14:39,350 --> 00:14:42,780
ما يعني أنّ شيوخ نانتو سيرغبون بردِّ الجميل لنا

222
00:14:42,780 --> 00:14:47,110
على لطفِنا بهديّةٍ جميلة كذلك

223
00:14:47,110 --> 00:14:48,530
بالضبط يا ني-سان

224
00:14:48,530 --> 00:14:52,540
ناهيك عن أنّ سفينتنا الفارهة قد أُسقِطَتْ العام الماضي

225
00:14:52,540 --> 00:14:53,490
أجل، أجل

226
00:14:53,490 --> 00:14:57,120
ومن أسقطها؟

227
00:14:57,120 --> 00:14:59,610
!كنتَ أنت يا ياسابورو

228
00:14:59,610 --> 00:15:04,210
أسلوبك الخالي من الرقيّ يسبّب لنا متاعبَ كثيرة

229
00:15:04,400 --> 00:15:05,590
،حتّى كايسي قد قال

230
00:15:05,590 --> 00:15:09,690
ياسابورو والآخرون عنيفون جدّاً لدرجة"
"أنّني لا أريد ركوب السّفينة الفارهة

231
00:15:09,690 --> 00:15:12,820
وتقوقعَ في مصنع دينكي بران الخداع

232
00:15:12,820 --> 00:15:14,670
،وحتّى أنّها قالت كلاماً خالياً من العواطف

233
00:15:14,670 --> 00:15:17,060
"حريّ بي الذهاب للعمل"

234
00:15:17,350 --> 00:15:20,590
يا أختي غريبة الأطوار الصّغيرة المسكينة

235
00:15:20,590 --> 00:15:23,440
!كينكاكو، غينكاكو، هذا يكفي

236
00:15:24,200 --> 00:15:26,050
لماذا تركب غيوكوران معكم؟

237
00:15:26,050 --> 00:15:27,720
،سمعتُ كلّ كلمة قلتماها

238
00:15:27,720 --> 00:15:30,740
!وكانت كلّ كلمة أشدّ وقاحة من الأخرى

239
00:15:30,740 --> 00:15:32,920
!اعتذرا حالاً

240
00:15:32,920 --> 00:15:36,330
!عندما كنتُما كرتَي فراء، كنتُما ظريفين أحياناً

241
00:15:36,330 --> 00:15:40,350
ماذا أكلتُما بالضبط حتّى أصبحتُما
حمقاوين مزعجين صغيرين؟

242
00:15:40,350 --> 00:15:43,340
!ما الفائدة من حمقى يفتقرون لذرّة ظرافة على الأقلّ؟

243
00:15:43,340 --> 00:15:45,980
!يا للوقاحة

244
00:15:45,980 --> 00:15:48,300
نعتذر أشدّ الاعتذار

245
00:15:48,300 --> 00:15:49,950
هل انجرحت مشاعركما؟

246
00:15:49,950 --> 00:15:52,640
إن كانت هذه الكلمات تلدغكما فما زال
الأمل موجوداً إذاً

247
00:15:52,640 --> 00:15:54,530
!اعتذرا حالاً

248
00:15:54,530 --> 00:15:57,140
وإلّا سأخبر كايسي-تشان عنكما

249
00:15:58,820 --> 00:16:00,120
!أريد أن أردّ بشيء

250
00:16:00,120 --> 00:16:04,100
!لكن لا نستطيع

251
00:16:01,420 --> 00:16:02,870
!أرغب بشدّة أن أردّ

252
00:16:05,370 --> 00:16:07,050
!ما هذا يا مجنونة الشّوغي؟

253
00:16:07,050 --> 00:16:09,750
لِمَ لا تلعبين الشّوغي في نانزينجي للأبد فحسب؟

254
00:16:10,410 --> 00:16:12,780
!ماذا قلتما؟

255
00:16:12,780 --> 00:16:15,530
هل ستهينان غيوكوران الآن أيضاً؟

256
00:16:16,050 --> 00:16:17,950
!لن أغفر لكما

257
00:16:21,870 --> 00:16:23,380
!ني-سان! قف خلفه

258
00:16:23,380 --> 00:16:24,620
!دع الأمر لي

259
00:16:25,030 --> 00:16:27,420
اثنان على واحد سيّئ بالنسبة لنا

260
00:16:28,090 --> 00:16:29,670
!ابدأوا بإطلاق النّيران

261
00:16:41,550 --> 00:16:42,390
!ني-سان

262
00:16:49,770 --> 00:16:51,990
!أعتقد أنّ مؤخّرتي تحترق

263
00:16:55,350 --> 00:16:56,870
!ني-سان، اهبط

264
00:16:57,120 --> 00:16:59,370
أين يُفترَض أن أهبط؟

265
00:16:59,370 --> 00:17:01,490
!على سفينةِ الإيبيسوغاوا بالطبع

266
00:17:08,130 --> 00:17:08,960
!ياشيرو

267
00:17:08,960 --> 00:17:09,930
!في الحال

268
00:17:10,670 --> 00:17:11,690
!من هنا، من هنا

269
00:17:11,690 --> 00:17:12,760
!أطلقوا! أطلقوا

270
00:17:36,800 --> 00:17:39,070
على ما يبدو، التانوكيّون

271
00:17:39,750 --> 00:17:42,210
حمقى ميؤوس منهم بالفعل

272
00:17:43,990 --> 00:17:46,190
هل أنت بخير يا ني-سان؟

273
00:17:46,190 --> 00:17:48,330
أجل. يا إلهي

274
00:17:48,330 --> 00:17:50,090
الحمدلله على سلامةِ الجميع

275
00:17:56,080 --> 00:17:57,780
يا له من مشهد فظيع

276
00:17:58,760 --> 00:18:01,300
لا يتعلّم التانوكيّون أبداً

277
00:18:01,970 --> 00:18:04,330
كُرات الفِراء لا يتعلّمون أبداً بالطبع

278
00:18:11,000 --> 00:18:15,490
ظننتُ أنّه من واجب التينغو تربية التانوكيّين

279
00:18:19,230 --> 00:18:21,450
من تلك المرأة؟

280
00:18:21,880 --> 00:18:24,180
إنّها تلميذتي البارعة

281
00:18:24,180 --> 00:18:26,880
بخلافك أنت، إنّها جريئة

282
00:18:27,420 --> 00:18:30,650
امرأة لصّة؟ يا لها من تلميذة جيّدة بالفعل

283
00:18:31,100 --> 00:18:35,340
لا بدَّ أنّه من المُبهِج الحاجة للآخرين للتحليق

284
00:18:35,860 --> 00:18:38,860
،يمكنك أن تستمرّ في الازدياد كِبَراً وقباحة

285
00:18:38,860 --> 00:18:41,340
لكن ينبغي أن تربّي تلك المرأة

286
00:18:41,340 --> 00:18:44,810
وتدعها تبتعد عن طريقي على الأقلّ

287
00:18:45,400 --> 00:18:47,770
أهذا كل ما لديك لتقوله؟

288
00:18:48,510 --> 00:18:49,850
!هذا سيّئ

289
00:18:50,170 --> 00:18:51,120
!ا-اتركني

290
00:18:50,170 --> 00:18:51,120
!أ-أنت

291
00:18:51,120 --> 00:18:52,150
!سينسي

292
00:18:52,390 --> 00:18:54,960
،إذا استخدمت مروحتك هنا

293
00:18:54,960 --> 00:18:57,260
!فسنُقذَفُ بعيداً

294
00:18:57,840 --> 00:19:00,140
هذا الأمر بيننا نحن التينغو

295
00:19:00,760 --> 00:19:03,030
ينبغي ألّا يتدخّل التانوكيّون في نزاعات التينغو

296
00:19:03,030 --> 00:19:06,840
لكن التمتّع بمحرقةِ الوداع هو مهرجان
لنا نحن التانوكيّون

297
00:19:06,840 --> 00:19:09,540
!وقد كان هذا نزاعاً بين التانوكيّين من الأساس

298
00:19:09,540 --> 00:19:11,520
!لا تنسَ ذلك من فضلك

299
00:19:11,520 --> 00:19:14,630
تدخُّل التينغو في نزاعٍ بين التانوكيّين غريب أيضاً

300
00:19:14,630 --> 00:19:16,330
لا تقلق يا ياسابورو

301
00:19:20,360 --> 00:19:24,730
يا سيّد، هلّا سمحتَ لي بمعالجة هذا الأمر؟

302
00:19:25,270 --> 00:19:26,730
موافق

303
00:19:26,730 --> 00:19:28,120
تفضّلي

304
00:19:36,260 --> 00:19:41,220
عندما التقينا في لندن، كانت السّماء عاصفة

305
00:19:42,440 --> 00:19:45,030
لقد كرهتُك

306
00:19:45,730 --> 00:19:47,490
منذ ذلك اليوم

307
00:20:15,740 --> 00:20:17,760
...حسناٌ يا كرات فرائي الصّغيرة

308
00:20:17,760 --> 00:20:19,830
استميحكم عذراً، سأغادر

309
00:20:27,900 --> 00:20:32,010
هل تعرف أين سقطت بينتين يا ياسابورو؟

310
00:20:32,470 --> 00:20:33,300
أجل

311
00:20:33,770 --> 00:20:36,440
يجب أن نذهب ونحضرها

312
00:20:37,220 --> 00:20:38,490
تعال معي

313
00:20:38,490 --> 00:20:39,930
أمرك

314
00:21:15,250 --> 00:21:16,340
...سينسي

315
00:21:23,420 --> 00:21:25,080
هل أنتِ مُحبَطة؟

316
00:21:25,930 --> 00:21:27,340
أجل

317
00:21:28,460 --> 00:21:29,850
هكذا إذاً

318
00:21:29,850 --> 00:21:31,510
أظنُّكِ كذلك

319
00:21:33,770 --> 00:21:37,190
لكن حتّى التينغو يسقطون أحياناً

320
00:21:38,940 --> 00:21:42,330
إن كنتِ مُحبَطة فكوني أقوى

321
00:21:44,060 --> 00:21:48,450
،في لحظة اندفاع بينتين نحو النيدايمي

322
00:21:49,190 --> 00:21:53,410
ملأت تعابير وجهها صدري بحزنٍ لا يُوصَف

323
00:21:54,730 --> 00:21:57,620
...عرفتُ أنَّ بينتين ستنهزم أمام النيدايمي

324
00:23:30,840 --> 00:23:34,490
حمّام في الهواء الطلق وحليب بالقهوة
يشكّلان مزيجاً إعجازيّاً

325
00:23:34,490 --> 00:23:35,930
!يا للروعة

326
00:23:36,350 --> 00:23:39,390
بالمناسبة، لماذا أنا هنا؟