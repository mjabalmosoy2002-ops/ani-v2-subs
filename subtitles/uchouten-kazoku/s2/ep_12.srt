1
00:00:01,880 --> 00:00:05,480
!سماء كيوتو مِلكي أنا

2
00:00:05,780 --> 00:00:08,370
!سماء كيوتو تنتمي للتينغو

3
00:00:08,370 --> 00:00:10,480
!من تظنّ نفسك أيُّها البشريّ؟

4
00:00:19,740 --> 00:00:22,710
هذا يكفي يا ياسابورو

5
00:00:23,040 --> 00:00:25,960
مرحباً بكِ يا بينتين-ساما

6
00:00:25,960 --> 00:00:28,460
أنت لا تعرف الاستسلام، أليس كذلك؟

7
00:00:29,020 --> 00:00:32,970
دخلَ أبوك قدراً بخاريّاً من دون أن يُقاوم
مثل هذه المُقاومة

8
00:00:34,420 --> 00:00:37,090
اشهدي يا أجنحتي، أضواء مصابيح لندن الغازيّة

9
00:00:37,430 --> 00:00:41,720
بينتين-ساما، ما رأيكِ أن نهبط هناك؟

10
00:00:42,180 --> 00:00:45,900
أنا متأكّد أنّ النيدايمي سيُقذَف للخلف
إن فعلتِ

11
00:00:48,230 --> 00:00:50,480
!أنت صبيّ مُشاكِس يا ياسابورو

12
00:01:05,690 --> 00:01:06,890
!أحسنت صنعاً

13
00:01:07,960 --> 00:01:10,670
ظننتُ نفسي في عداد الموتى يا ياسابورو

14
00:01:11,010 --> 00:01:12,380
وكذلك أنا

15
00:01:30,360 --> 00:01:31,570
!سون؟

16
00:01:31,570 --> 00:01:34,530
ما زلتَ على قيدِ الحياةِ إذاً يا ياسابورو

17
00:01:34,530 --> 00:01:38,530
وأنا ظننتُك قد شققتَ طريقك
إلى الجحيمِ يا عمّي

18
00:01:38,760 --> 00:01:43,340
يبدو أنّ كلينا تربطنا أشياء كثيرة
بهذا العالم

19
00:01:43,340 --> 00:01:46,410
هكذا إذاً. كان كلّ ذلك من صنيعك

20
00:01:47,910 --> 00:01:49,080
!كايسي

21
00:01:49,380 --> 00:01:51,950
!تينمايا أطلق النّار على كايسي

22
00:01:51,950 --> 00:01:53,210
!ماذا؟

23
00:01:53,370 --> 00:01:56,840
تورّطَتْ في مؤامرتك! ينبغي أن تخجل من نفسك

24
00:01:59,200 --> 00:02:01,910
أنت متهوّرٌ دوماً

25
00:02:02,510 --> 00:02:03,360
!ياجيرو؟

26
00:02:03,360 --> 00:02:06,680
ني-سان؟ ماذا تفعل هنا؟

27
00:02:06,900 --> 00:02:11,440
أعتقد أنّنا ينبغي أن نحلّ المُشكلة
التي بمُتناول اليد أولاً

28
00:02:12,200 --> 00:02:14,820
يا له من مشهد أراه

29
00:02:14,820 --> 00:02:17,820
يمكنك إعداد ما تشاء من قدور بخاريّة
للتانوكيين

30
00:02:18,000 --> 00:02:23,770
تينمايا، علّق كلّ تانوكيّ من هؤلاء بقدرٍ بخاريّ

31
00:02:23,770 --> 00:02:26,830
حسناً، لقد حصلتُ على عملٍ يلائمني تماماً

32
00:02:27,220 --> 00:02:31,920
ياسابورو-كن، أنت شرّيرٌ حقيقيّ

33
00:02:31,920 --> 00:02:35,300
لا يجدر بك أن تطلق النّار على تانوكيّ
يا تينمايا-سان

34
00:02:35,300 --> 00:02:37,850
لا أستطيع الالتفاف حول ذلك

35
00:02:37,850 --> 00:02:42,340
أنا مُحاصَرٌ تماماً الآن

36
00:02:42,810 --> 00:02:47,660
لكن ما زلتُ أرغب في العمل معكم

37
00:02:47,960 --> 00:02:51,230
حتّى لو كنتُم فرويّين قليلاً

38
00:02:53,730 --> 00:02:55,910
!لن أدعك تلمس تانوكيّاً واحداً

39
00:02:56,570 --> 00:02:59,320
إن أردتَ أن تطلق على أي تانوكي
!فأطلِق عليّ بدلاً من ذلك

40
00:03:00,350 --> 00:03:03,650
يا إلهي. ماذا سنفعل بك؟

41
00:03:03,650 --> 00:03:07,160
تينمايا، انسَ هذا الأحمق. دعه وشأنه

42
00:03:12,580 --> 00:03:15,710
!فَسُدَ كلّ شيء بسببك

43
00:03:15,940 --> 00:03:19,200
!هذه مُشكلتكم أنتم البشر

44
00:03:21,060 --> 00:03:23,500
!تينمايا

45
00:03:25,160 --> 00:03:28,060
!لقد أتيتُ لأجلك

46
00:04:09,100 --> 00:04:11,270
اخرج أيُّها الجبان الوضيع

47
00:04:16,510 --> 00:04:18,900
لماذا تجلس عابِساً؟

48
00:04:19,370 --> 00:04:21,280
يا لك من تينغو مُثير للشفقة

49
00:04:21,650 --> 00:04:22,710
اخرسي

50
00:04:23,130 --> 00:04:25,160
لستُ تينغو

51
00:04:26,280 --> 00:04:28,900
أنت مقيتٌ حقّاً

52
00:04:29,990 --> 00:04:32,660
أنتِ مثلها تماماً

53
00:04:48,720 --> 00:04:52,390
!لستَ جاهزاً للافتتانِ بامرأة ما

54
00:04:52,750 --> 00:04:55,770
ألا تخجل من اعتراضِك طريق حبّي
!بهذه الطريقة؟

55
00:05:09,800 --> 00:05:11,630
ما الذي حدث بالضبط؟

56
00:05:11,630 --> 00:05:12,700
إلى أين ذهبت السيّدة؟

57
00:05:18,880 --> 00:05:22,020
سافرَتْ فجأة

58
00:05:23,570 --> 00:05:25,300
طلبَتْ منّي أن أعطيك هذه

59
00:05:41,750 --> 00:05:43,400
ما الأمر؟

60
00:05:46,810 --> 00:05:50,100
!مُعظمكم غير مهذّبين

61
00:05:51,210 --> 00:05:53,240
جميعكم تثيرون غضبي

62
00:05:54,170 --> 00:05:56,250
...التينغو والتانوكيّون والبشر

63
00:05:56,580 --> 00:05:59,880
لماذا كلّكم حمقى؟

64
00:06:00,030 --> 00:06:02,960
!أنا مُحاطٌ تماماً بالحمقى

65
00:06:03,710 --> 00:06:08,010
!النيدايمي نيويغاتاكي ياكوشيبو سينزل

66
00:06:08,380 --> 00:06:09,940
!لا تدعوا النيران المُتبادَلة تطالكم

67
00:06:09,940 --> 00:06:12,260
!احتموا جميعاً

68
00:07:05,850 --> 00:07:08,350
متى ستنتهي هذه المعركة؟

69
00:09:33,910 --> 00:09:35,510
،ياسابورو

70
00:09:36,300 --> 00:09:39,890
أشكرك على كلّ جهودك الاستثنائيّة الكبيرة

71
00:09:40,560 --> 00:09:43,600
كلماتك اللّطيفة هي شرَفٌ لي

72
00:09:44,030 --> 00:09:45,240
بالفعل

73
00:10:00,020 --> 00:10:01,860
!لقد رمى المروحةَ جانباً

74
00:10:01,860 --> 00:10:04,380
ياسابورو، توقّف

75
00:10:05,760 --> 00:10:08,910
أمّي، ياشيرو، متى أتيتما إلى هنا؟

76
00:10:08,910 --> 00:10:12,640
لدى سينسي أفكاره الخاصّة لمُعالجةِ هذا الأمر

77
00:10:44,950 --> 00:10:46,510
هل أنتَ مُحبَط؟

78
00:10:48,200 --> 00:10:50,800
إن كنتَ مُحبَطاً، فعزِّز قوّتك

79
00:11:35,210 --> 00:11:37,960
لقد وصل شيموغامو ياسابورو

80
00:11:57,960 --> 00:12:00,130
ألستُ مسكينة؟

81
00:12:00,750 --> 00:12:03,580
أشعر بالشفقةِ عليك

82
00:12:06,100 --> 00:12:08,810
اشفق عليّ أكثر فأكثر

83
00:12:10,350 --> 00:12:13,800
أشفقُ عليكِ أكثر فأكثر

84
00:12:15,700 --> 00:12:17,930
كنتُ أعلم منذ زمن بعيد

85
00:12:18,740 --> 00:12:21,910
أنّني لم أكن الشّخص الذي احتاجت إليه بينتين-ساما

86
00:12:22,630 --> 00:12:24,510
لم يكن مجرَّد تانوكيّ كافياً

87
00:12:30,830 --> 00:12:33,170
!عيد رأس سنة سعيد

88
00:12:33,390 --> 00:12:35,950
!هذا ليس عيد رأس سنة سعيد إطلاقاً

89
00:12:35,950 --> 00:12:39,420
كم مرّة برأيك أُجبِرنا على التفكُّر
!بأخطائنا في هذا العام الجديد؟

90
00:12:39,420 --> 00:12:43,400
لا يوجد تانوكيّ آخر أفضل في التفكُّر
بأخطائه أكثر منّا

91
00:12:43,400 --> 00:12:45,220
نحن محترفان في التفكُّرِ بأخطائنا

92
00:12:45,220 --> 00:12:46,490
الأفضل على الإطلاق

93
00:12:46,490 --> 00:12:49,620
بالإضافةِ إلى ذلك، لِمَ علينا التفكُّر بأخطائنا على أي حال؟

94
00:12:49,620 --> 00:12:52,580
!خدعنا أبونا طوال هذا الوقت أيضاً

95
00:12:52,580 --> 00:12:55,890
!نحن الضحايا الكبرى في هذه الفوضى

96
00:12:55,890 --> 00:12:58,760
حسناً، أنتما محترفان في التفكُّرِ بأخطائكما

97
00:12:58,760 --> 00:13:00,260
حان الوقتُ لتلاوة صلاتكما

98
00:13:00,260 --> 00:13:01,510
!ماذا؟

99
00:13:01,510 --> 00:13:04,590
تلونا كثيراً من الصّلوات لدرجة أنَّ الدماء
سيخرج من أفواهنا

100
00:13:04,590 --> 00:13:08,640
لا أستطيع استئناف رحلتي ما لم أصحِّح
قوامكما هذا

101
00:13:08,640 --> 00:13:13,060
قوامنا لا عِلاج له لذا يمكنك المُغادرة متى شئت

102
00:13:13,220 --> 00:13:15,250
لن أفعل ذلك

103
00:13:15,250 --> 00:13:17,750
فقد وعدتُ ياساكا-سان

104
00:13:19,880 --> 00:13:21,100
كدتُ أنسى

105
00:13:22,170 --> 00:13:24,760
يبدو أنَّ الشّيوخ قدّموا بركاتهم

106
00:13:25,170 --> 00:13:26,400
مبروك

107
00:13:26,400 --> 00:13:28,870
الأمور بخواتيمها

108
00:13:29,230 --> 00:13:32,340
هنِّئ يايتشيرو بالنيابة عنّي من فضلك

109
00:13:33,890 --> 00:13:36,310
...وبشأن والدنا

110
00:13:37,430 --> 00:13:38,900
أنا آسف

111
00:13:40,390 --> 00:13:42,050
ما مضى قد مضى

112
00:13:44,160 --> 00:13:47,420
عادَ أبي إلى كيوتو بصفةِ كوريتشيرو المزيّف

113
00:13:47,420 --> 00:13:49,880
وحاولَ الاستحواذ على القوّة من وراء الكواليس

114
00:13:50,280 --> 00:13:53,390
هل كان تزييف موته جزءاً من خطّتِه أيضاً؟

115
00:13:53,600 --> 00:13:56,780
أنا متأكّدٌ أنّه لم يخطّط إلى هذا الحدّ

116
00:13:57,250 --> 00:14:02,480
لكنّه على الأرجح لم يكن يتوقّع
أن أعود آنذاك أيضاً

117
00:14:02,480 --> 00:14:04,180
!بصراحة، لا تعليق

118
00:14:05,600 --> 00:14:08,150
!لا تظهري هكذا فجأة

119
00:14:08,310 --> 00:14:10,480
كان على قيدِ الحياة عندما ظننتُه ميّتاً

120
00:14:10,480 --> 00:14:13,910
وعندما ظننتُه حيّاً، سُحبَ نحو الجحيم

121
00:14:14,480 --> 00:14:17,280
لم أعد أفهم ما يجري بعد الآن

122
00:14:17,710 --> 00:14:19,960
سون العنيد على قيدِ الحياة

123
00:14:20,320 --> 00:14:23,800
أنا واثقٌ أنّه يغلي بعضاً من الرّامن
مع تينمايا في كشكه في الجحيم

124
00:14:24,310 --> 00:14:25,990
هل أنت راضٍ عن هذا؟

125
00:14:26,430 --> 00:14:27,390
ما باليدِ حيلة

126
00:14:27,800 --> 00:14:30,300
لم يمت تماماً في المرّة الأولى التي قتلناه فيها

127
00:14:31,230 --> 00:14:33,410
على أي حال، لعلّك على حقّ

128
00:14:34,180 --> 00:14:36,390
حسناً، أنا ذاهبٌ إلى المنزل

129
00:14:36,390 --> 00:14:38,180
لديّ الكثير لأفعله

130
00:14:38,180 --> 00:14:39,810
غادر بسُرعة

131
00:14:40,870 --> 00:14:43,840
،لكن إن زرتُنا مجدّداً

132
00:14:43,840 --> 00:14:45,700
لن أطردك

133
00:14:47,120 --> 00:14:50,820
تسعى فرقة تسوتشينوكو الاستكشافيّة حاليّاً لضمّ
رقم اثنين

134
00:14:52,000 --> 00:14:55,500
لِمَ لا تنضمّين لفرقة تسوتشينوكو الاستكشافيّة
حالما تتحسّنين؟

135
00:14:58,880 --> 00:15:00,520
لن أفعل

136
00:15:05,030 --> 00:15:09,680
كلّ ما حدث في تلك اللّيلة غير منطقيّ
لدرجة أنّي لا أعرف من أين أبدأ

137
00:15:09,680 --> 00:15:12,010
أجل، أتّفق معك

138
00:15:13,720 --> 00:15:17,230
تحدث أمور غريبة في كيوتو كلّ عام

139
00:15:17,940 --> 00:15:22,180
أجبني... هل تعلم من يترك هذه لي؟

140
00:15:26,380 --> 00:15:30,500
لا أعرف السّبب، لكن أنا متوتّرٌ للغاية
لدرجةٍ أكاد فيها أموت

141
00:15:30,850 --> 00:15:34,260
اهدأ. استرخِ وتحلّ بِثقةٍ أكبر في نفس الوقت

142
00:15:34,260 --> 00:15:36,990
كُن حذراً جدّاً بشأنِ إخفاء ذيلك

143
00:15:36,990 --> 00:15:40,850
لا تذكّرينني بذيلي يا أمّي أرجوكِ

144
00:15:40,850 --> 00:15:43,000
قد يظهر في أي لحظة

145
00:15:43,180 --> 00:15:45,370
لِمَ لا تدعه يظهر فحسب؟

146
00:15:45,370 --> 00:15:47,640
لن يُلاحِظه أحدٌ إن بدوتَ واثقاً

147
00:15:47,640 --> 00:15:51,070
أيّها الحمقى. ماذا لو سقطَ فروٌ في المذبح؟

148
00:15:51,070 --> 00:15:53,010
تبدو المحادثة التي تدور بينكم مسلّية

149
00:16:05,880 --> 00:16:09,320
كُرات الفِراء تلك متصلّبة كالتماثيل

150
00:16:16,540 --> 00:16:18,920
ماذا أفعل بكم يا كُرات الفِراء؟

151
00:16:18,920 --> 00:16:21,580
الشيء الوحيد الذي تعرفونه هو التزاوُج

152
00:16:22,290 --> 00:16:25,250
أسرعا وعيشا بسعادة

153
00:16:27,470 --> 00:16:32,890
أسألُ تحسُّباً فقط، لكن تمَّ إلغاء
قرار طردي، صحيح؟

154
00:16:32,890 --> 00:16:35,800
إن كان لديك اعتراض على ذلك فسأطردك
مجدّداً بكلّ سرور

155
00:16:36,940 --> 00:16:39,520
ا-الأمور بخواتيمها ونحن في العامِ الجديد

156
00:16:40,930 --> 00:16:44,310
إذاً عام مُملٌّ آخر على وشك أن يبدأ

157
00:16:49,350 --> 00:16:51,830
أنت حقّاً تانوكيّ مُسلٍّ

158
00:16:52,400 --> 00:16:55,190
،يبدو أنّك فكّرتَ في كلّ احتمال مُمكِن

159
00:16:55,190 --> 00:16:58,040
لكن تبدو أيضاً أنّك لا تفكّر
في أي شيء

160
00:16:58,450 --> 00:17:01,660
هل من فرقٍ بين هذا وذاك؟

161
00:17:01,660 --> 00:17:03,870
لا بدّ وأنّها حكمة تانوكيّة ما

162
00:17:04,340 --> 00:17:07,380
يعزو السّبب لدمِ الأحمق
الذي يجري بداخلي

163
00:17:08,880 --> 00:17:12,010
أنا متأكّدٌ أنّك ستصبح تانوكيّاً
عجوزاً ماكراً يوماً ما

164
00:17:12,280 --> 00:17:15,560
وأنتَ ستغدو تينغو عظيماً يا نيدايمي

165
00:17:21,020 --> 00:17:23,260
لن أصبح تينغو

166
00:17:40,410 --> 00:17:44,160
أرى أنّ العضو الثّاني في فرقة
تسوتشينوكو الاستكشافيّة قد وصلت أخيراً

167
00:17:44,330 --> 00:17:46,190
ما-ماذا؟

168
00:17:46,190 --> 00:17:48,630
!هذا ليس سبب مجيئي

169
00:17:48,900 --> 00:17:50,870
لماذا أتيتِ إذاً؟

170
00:17:52,220 --> 00:17:54,070
...في الواقع، لأنّني

171
00:17:54,070 --> 00:17:56,870
أردتُ أن أعتذر منك بشكلٍ لائق

172
00:17:56,870 --> 00:17:59,300
تعتذرين؟ لماذا؟

173
00:18:00,130 --> 00:18:04,380
أتذكرُ عندما كنتَ طفلاً وأُلغِيَ
تحوّلك فجأة؟

174
00:18:05,260 --> 00:18:08,310
ومن ثمّ نبتَ فطرٌ من مؤخّرتك

175
00:18:09,050 --> 00:18:11,440
كانَتْ تلك غلطتي أنا

176
00:18:15,080 --> 00:18:17,290
هذا ما حدث إذاً

177
00:18:18,560 --> 00:18:19,720
آسفة

178
00:18:21,130 --> 00:18:23,660
لا بدّ وأنّكِ حمقاء

179
00:18:23,850 --> 00:18:25,620
!هل نعتّني بالحمقاء؟

180
00:18:26,030 --> 00:18:29,670
تكتّمتِ على ذلك السرّ طوال هذه السّنوات

181
00:18:30,040 --> 00:18:32,710
هذا ضياعٌ كلِّي لحنانكِ

182
00:18:32,910 --> 00:18:35,600
أنا حمقاء إذاً. فليكُن

183
00:18:37,800 --> 00:18:40,930
هل تسمع ذلك الصّوت الغريب؟

184
00:18:42,470 --> 00:18:45,030
ما ذلك الصّوت المُخيف؟

185
00:18:46,400 --> 00:18:49,590
يبدو كطفلٍ صغيرٍ يبكي

186
00:18:49,590 --> 00:18:51,190
لكن في أعماق الجبال؟

187
00:18:57,720 --> 00:19:00,100
اهدئي. لا تقلقي

188
00:19:00,690 --> 00:19:03,380
إنّها جدّتي من معبدِ تانوكيدانيسان فودو-إن

189
00:19:03,810 --> 00:19:05,830
جدّتك؟

190
00:19:07,370 --> 00:19:10,250
!كنتُ خائفة للغاية

191
00:19:10,800 --> 00:19:13,300
ماذا تفعلين في مكانٍ كهذا؟

192
00:19:13,300 --> 00:19:17,940
قلتُ لنفسي سأتمشّى قليلاً ثمّ تُهت

193
00:19:18,380 --> 00:19:22,510
هذا لأنّني لا أستطيع رؤية شيء

194
00:19:24,450 --> 00:19:29,310
هل أعرفك يا عزيزي؟

195
00:19:29,550 --> 00:19:30,970
أظنّكِ كذلك

196
00:19:31,340 --> 00:19:32,890
التقينا في الصّيف

197
00:19:33,190 --> 00:19:36,040
!توقّعتُ هذا

198
00:19:36,040 --> 00:19:40,290
لكن لا أعرفكِ يا عزيزتي

199
00:19:40,290 --> 00:19:42,320
اسمي كايسي

200
00:19:42,320 --> 00:19:44,230
كايسي

201
00:19:44,970 --> 00:19:46,420
لن أنساه الآن

202
00:19:46,420 --> 00:19:48,960
قولي لي يا كايسي-تشان

203
00:19:48,960 --> 00:19:52,250
هل أنتما متزوّجان؟

204
00:19:53,430 --> 00:19:55,060
لسنا متزوّجين

205
00:19:55,380 --> 00:19:56,360
يا إلهي

206
00:19:56,360 --> 00:20:00,310
لكن يربطكما فروٌ أحمر

207
00:20:00,880 --> 00:20:03,090
إنّي أراه

208
00:20:03,950 --> 00:20:06,390
حسناً، سنتزوّج في نهايةِ المطاف

209
00:20:06,910 --> 00:20:08,130
فنحن مخطوبان

210
00:20:08,430 --> 00:20:10,270
!توقّعتُ هذا

211
00:20:14,420 --> 00:20:17,140
أتعتقدين أنّنا سنحقّق ذلك؟

212
00:20:17,140 --> 00:20:21,570
أهذا ما أنت قلِق بشأنه يا عزيزي؟

213
00:20:21,940 --> 00:20:26,350
ما دمتُما منفوشين سيسير الأمر على ما يُرام

214
00:20:26,820 --> 00:20:29,980
فنحن تانوكيّون في نهايةِ المطاف

215
00:20:30,500 --> 00:20:33,960
النّعومة والنّفش هما كلّ ما نتمتّع به

216
00:20:35,480 --> 00:20:37,000
هذا جيّد إذاً

217
00:20:37,600 --> 00:20:40,420
افعل ما بوسعك يا عزيزي

218
00:20:40,930 --> 00:20:42,430
افعل ما بوسعك

219
00:20:42,840 --> 00:20:43,990
سأفعل

220
00:20:44,220 --> 00:20:46,680
،احرص على أن تثير بعضاً من المشاكل

221
00:20:46,680 --> 00:20:48,880
واستمتع

222
00:20:48,880 --> 00:20:50,730
سأفعل

223
00:20:50,730 --> 00:20:52,060
سأثير كثيراً من المشاكل

224
00:20:54,530 --> 00:20:58,020
الأمر الممتع هو أمر جيّد

225
00:20:58,480 --> 00:21:00,900
أليس كذلك يا عزيزتي؟

226
00:21:02,060 --> 00:21:04,730
،حدثَتْ أمور كثيرة في العامِ الماضي

227
00:21:05,090 --> 00:21:09,200
لكن الجميع على قيدِ الحياة الآن
وكلّنا مستمتعون

228
00:21:10,360 --> 00:21:14,220
لا شيء آخر نفعله بعد الآن
سوى المرح في الحياة

229
00:21:15,240 --> 00:21:18,800
هذا ما عليك أن تقرّره أوّلاً

230
00:21:20,680 --> 00:21:22,780
هل أنت متأكّد؟

231
00:21:23,450 --> 00:21:24,350
أجل

232
00:21:25,180 --> 00:21:26,940
،لكن إن كنتَ معي

233
00:21:27,440 --> 00:21:29,770
فلن تتمكّن من استخدام مهاراتك
المبهرة في التحوُّل

234
00:21:30,410 --> 00:21:32,100
سأتدبّر الأمر بطريقةٍ ما

235
00:21:32,430 --> 00:21:34,110
أنت غير مُبالٍ إطلاقاً

236
00:21:34,600 --> 00:21:38,600
هذا بسببِ دمِ الأحمق
الذي يجري في داخلي أيضاً

237
00:21:44,890 --> 00:21:46,770
ينبغي أن نوصل جدّتي إلى المنزل

238
00:21:47,690 --> 00:21:48,630
هيّا بنا

239
00:21:49,600 --> 00:21:50,460
نعم