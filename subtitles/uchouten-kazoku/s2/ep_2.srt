1
00:00:03,090 --> 00:00:04,400
...حضّر نفسك

2
00:00:05,460 --> 00:00:07,730
!واتلُ صلواتك

3
00:00:21,950 --> 00:00:23,950
إنّه ياسابورو دون سِواه

4
00:00:23,950 --> 00:00:26,160
ماذا تفعل في مكانٍ كهذا؟

5
00:00:26,160 --> 00:00:28,460
صدفَ مروري من هنا

6
00:00:28,460 --> 00:00:31,290
اعذرني، لكن أهذا أنت يا ياسابورو-كن؟

7
00:00:31,290 --> 00:00:34,300
شيموغامو ياسابورو، في خدمتك

8
00:00:34,690 --> 00:00:37,050
ما الذي جاءَ بك إلى هنا؟

9
00:00:37,490 --> 00:00:41,520
يمكنُك القول أنّ دم الأحمق
الذي يجري في عروقي هو ما جلبَني إلى هنا

10
00:00:43,040 --> 00:00:46,160
إنّ التانوكيين مخلوقات حمقاء بالفعل

11
00:00:46,160 --> 00:00:48,340
،سأعترف أنّهم بهيجون

12
00:00:48,760 --> 00:00:53,030
لكن لا أنكر أنّهم حمقى كذلك

13
00:00:53,310 --> 00:00:56,800
هذا كلامٌ اعتادَ التينغو أن يقوله يا نيدايمي

14
00:00:56,800 --> 00:00:58,830
لستُ تينغو

15
00:00:59,160 --> 00:01:00,980
ماذا يعني تينغو؟

16
00:01:01,520 --> 00:01:03,500
ذاك العجوز الضعيف الذي هناك؟

17
00:01:04,020 --> 00:01:06,610
لا يستطيع التحكُّم بدوّامات التينغو كما يشاء

18
00:01:06,610 --> 00:01:08,880
ولا يستطيع الطيران كما ينبغي حتّى

19
00:01:09,150 --> 00:01:12,220
يقضي آخر أيّامه بشكلٍ مثير للضحك وبلا معنى

20
00:01:12,780 --> 00:01:15,490
لكن هذا مظهر مثيرٌ للشفقةِ على نحوٍ إيجابيّ

21
00:01:15,490 --> 00:01:19,670
إذ تختار طريقةَ عيشٍ تعتمد فيها
على شفقةِ مخلوقات كالتانوكيين

22
00:01:20,220 --> 00:01:21,940
ينبغي أن تخجلوا على أنفسكم

23
00:01:22,220 --> 00:01:23,450
!من هذا الخزيّ

24
00:01:24,850 --> 00:01:27,460
ابقَ مكانك ولا تهرب

25
00:01:27,460 --> 00:01:30,480
!سأُسقِطُك من هنا مجدّداً

26
00:01:31,160 --> 00:01:33,480
أما زلتَ على قيدِ الحياة أيُّها الأب؟

27
00:01:33,480 --> 00:01:37,670
إن أردتَني أموت فجرّب أن تقتلني فحسب

28
00:01:44,270 --> 00:01:46,150
لا تستحقُّ حتّى أن أقتلك

29
00:01:46,840 --> 00:01:48,760
يمكنك أن تموت بمفردك في مكانٍ ما

30
00:01:58,180 --> 00:01:59,330
يا إلهي

31
00:01:59,330 --> 00:02:00,940
هربَ مجدّداً

32
00:02:00,940 --> 00:02:02,800
كم هذا مُثير للشفقة

33
00:02:03,570 --> 00:02:04,210
وبعد؟

34
00:02:04,210 --> 00:02:05,850
هل هذا يعني أنّني انتصرت؟

35
00:02:05,850 --> 00:02:07,880
...فـ-في الواقع

36
00:02:07,880 --> 00:02:10,540
كيف توصّلتَ إلى هذه النتيجة؟

37
00:02:10,540 --> 00:02:13,860
إن كنتَ لا تستطيع أن تفهم فلا جدوى من الحديثِ معك

38
00:02:15,890 --> 00:02:19,360
أتساءل أين بينتين الآن وكيف حالها

39
00:02:25,270 --> 00:02:29,260
أنا متأكّد أنّها ستملئ الأجواء
مرحاً عندما تعود

40
00:02:30,150 --> 00:02:34,270
الآن هي الفترة الأنسب لتواجُد تلك الفتاة
الحسناء هنا أكثر من أي وقتٍ سبق

41
00:02:34,870 --> 00:02:37,470
أريد أن أرى بينتين

42
00:02:37,920 --> 00:02:41,160
أتوق لرؤية بينتين

43
00:04:19,610 --> 00:04:20,360
ني-تشان

44
00:04:20,840 --> 00:04:23,010
انتهيت باكراً اليوم

45
00:04:23,010 --> 00:04:26,270
قالت كايسي-نيتشان أنّ بمقدوري
الذهاب إلى المنزل اليوم

46
00:04:26,270 --> 00:04:28,560
متى ستنتهي يا ني-تشان؟

47
00:04:28,560 --> 00:04:30,370
يعتمد الأمر على تشوجيرو-سان

48
00:04:30,790 --> 00:04:33,120
غادرَ منذُ قليل ولم يعد بعد

49
00:04:33,570 --> 00:04:37,380
ني-تشان، هل يستطيع التانوكيّون
أن يصبحوا سادة إنجليزيين أيضاً؟

50
00:04:37,720 --> 00:04:38,510
ماذا؟

51
00:04:38,510 --> 00:04:40,000
بالطبع لا

52
00:04:40,000 --> 00:04:45,480
قال كينكاكو وغينكاكو أنّهما سيحذوّان حذوّ
النيدايمي ويصبحان سيّدين إنجليزيّين

53
00:04:45,480 --> 00:04:46,850
أتظنُّهما يستطيعان؟

54
00:04:46,850 --> 00:04:48,560
لا تصغِ إليهما يا ياشيرو

55
00:04:48,560 --> 00:04:50,010
ستُصابُ بعدوى الحماقة منهما

56
00:04:50,010 --> 00:04:51,890
!لا تسخر من أخوَيّ

57
00:04:55,890 --> 00:04:57,580
أهذه كايسي؟

58
00:04:57,580 --> 00:04:59,740
!لا تلمسني أيّها الأخرق

59
00:05:00,660 --> 00:05:04,250
كايسي-نيتشان، ألا تشعرين بالحرّ في الداخل؟

60
00:05:04,250 --> 00:05:08,120
لديّ كمّادة باردة هنا لذا الجوّ
بارد ولطيف هنا

61
00:05:08,380 --> 00:05:11,160
لهذا شعرتُ ببرودةٍ في ظهري

62
00:05:11,160 --> 00:05:15,180
إذاً سمعتُ أنّ كينكاكو وغينكاكو يتبعان النيدايمي

63
00:05:15,180 --> 00:05:16,310
!وما أدراني؟

64
00:05:16,310 --> 00:05:19,040
أنا متأكّدة أنّ النيدايمي يتكاسلون أيضاً

65
00:05:19,040 --> 00:05:21,590
كانت المعركة في مينامي-زا مُحبِطة للغاية

66
00:05:21,930 --> 00:05:24,690
وأنا التي حسبتُ أنّ معركةَ تينغو
عظيمة ما ستندلع

67
00:05:24,690 --> 00:05:26,350
لا أحد يعلم

68
00:05:26,350 --> 00:05:28,890
قد تعود بينتين-ساما في نهايةِ المطاف

69
00:05:28,890 --> 00:05:30,310
أنتَ مثيرٌ جدّاً للشفقة

70
00:05:30,310 --> 00:05:33,390
لا تبتسم فقط لأنّ نصف التينغو تلك ستعود

71
00:05:33,670 --> 00:05:37,040
لِمَ لا تغلقين فمكِ فحسب أيّتها الطفلة الضئيلة؟

72
00:05:36,270 --> 00:05:38,150
!توقّف! توقّف

73
00:05:37,040 --> 00:05:38,150
خذي هذه وهذه

74
00:05:38,150 --> 00:05:39,260
!سأتقيّأ

75
00:05:39,260 --> 00:05:43,180
خذي هذه وهذه وهذه وهذه وهذه

76
00:05:39,990 --> 00:05:43,650
متى ستتزوّجان يا ني-تشان؟

77
00:05:44,710 --> 00:05:46,540
لماذا تقول هذا الكلام فجأة؟

78
00:05:46,540 --> 00:05:48,250
لن نتزوّج بالطبع

79
00:05:48,250 --> 00:05:50,300
ولماذا لن تتزوّجا؟

80
00:05:50,300 --> 00:05:51,530
فأنتما منسجمان جيّداً

81
00:05:52,660 --> 00:05:54,850
،سواء أكنّا منسجمين أم لا

82
00:05:54,850 --> 00:05:58,050
خطوبتنا قد أُلغيَتْ

83
00:05:58,050 --> 00:05:59,120
أجل

84
00:05:59,120 --> 00:06:01,540
لم يعد ذاك الوعد مهمّاً

85
00:06:01,540 --> 00:06:04,170
لكن الشّخص الذي أراد إلغاء ذلك كان

86
00:06:04,170 --> 00:06:06,040
العمّ سون، صحيح؟

87
00:06:06,040 --> 00:06:08,800
والعمّ قد رحلَ إلى مكانٍ ما، صحيح؟

88
00:06:08,800 --> 00:06:12,180
وأمّي تحبُّ كايسي-نيتشان كثيراً، صحيح؟

89
00:06:12,180 --> 00:06:14,060
فمن سيرفض ذلك؟

90
00:06:14,320 --> 00:06:16,940
إن أردتُما الزواج فينبغي أن تفعلا ذلك فحسب

91
00:06:19,270 --> 00:06:23,320
ياسابورو، جاءني عملٌ مفاجئ. هل تمانع؟

92
00:06:26,500 --> 00:06:27,900
يا إلهي

93
00:06:28,220 --> 00:06:30,910
وهل يجب أن يكون ياسابورو؟

94
00:06:38,330 --> 00:06:42,540
أريد التخلُّص من ذلك، لكنّه خارج نطاق قدرتي

95
00:06:42,900 --> 00:06:44,410
ما هو؟

96
00:06:44,410 --> 00:06:48,630
باتَتْ تُسمَع همسات ظواهر غريبة مؤخّراً

97
00:06:48,630 --> 00:06:52,550
ظننتُ في بادئ الأمر أنّها من صنيع
تانوكي أو تينغو ما

98
00:06:52,780 --> 00:06:56,670
إلى أن ظهر ذلك الشيء فجأة على السّطح

99
00:06:56,670 --> 00:07:00,560
...لذا دخلتُ لأطلب منهم إزالته، لكن

100
00:07:05,180 --> 00:07:08,080
لا يجوز أن تبني هذا هنا من دون إذن

101
00:07:08,080 --> 00:07:10,850
من الواضح أنّ هذا ينتهك قوانين البناء

102
00:07:19,170 --> 00:07:21,590
هل تسمعني؟

103
00:07:29,980 --> 00:07:33,300
!ذقنه! ذقنه! ذقنه

104
00:07:34,830 --> 00:07:36,600
هذا ما حدث

105
00:07:36,840 --> 00:07:38,360
هذا سخيفٌ للغاية

106
00:07:38,890 --> 00:07:39,630
يبدو مسلّياً

107
00:07:39,630 --> 00:07:41,600
لا وقت للتسليةِ الآن

108
00:07:41,820 --> 00:07:44,900
حسناً، سأذهب وألقي نظرة

109
00:07:44,900 --> 00:07:47,090
كُن حذراً، ني-تشان

110
00:07:48,240 --> 00:07:50,810
مرحباً

111
00:07:55,390 --> 00:07:56,730
مراحِب أيُّها الصغير

112
00:07:56,730 --> 00:07:57,990
تبدو فرحاً

113
00:07:57,990 --> 00:08:00,000
وأنت تبدو فرحاً جدّاً

114
00:08:00,290 --> 00:08:01,300
أجل

115
00:08:01,300 --> 00:08:03,370
أنا مرحٌ على الدّوام

116
00:08:03,650 --> 00:08:08,250
والسّبب هو أنّ كلّ شيء في العالم
هو مسلٍّ بالنسبة إليّ

117
00:08:08,250 --> 00:08:09,440
حقّاً؟

118
00:08:09,440 --> 00:08:13,220
أنا واثقٌ تماماً أنّني أستطيع التفوُّق على ذلك

119
00:08:13,220 --> 00:08:14,320
أوهو؟

120
00:08:14,320 --> 00:08:16,800
ومن أين تستمدُّ تلك الثّقة؟

121
00:08:16,800 --> 00:08:21,100
لا مصدر لثِقتي يا سيّد

122
00:08:21,100 --> 00:08:24,000
يبدو أنّك تفهم كيف تسير الأمور

123
00:08:24,000 --> 00:08:26,480
،لا أعرف من تكون

124
00:08:26,480 --> 00:08:29,630
لكن لا يُفترَض أن تبني شيئاً كهذا هنا

125
00:08:29,630 --> 00:08:34,440
أبغض شيء في هذا العالم

126
00:08:34,440 --> 00:08:37,340
هو أن يتأمّر عليك شخصٌ ما

127
00:08:37,340 --> 00:08:41,290
إن كنتَ مصرّاً على فعلِ هذا فسأواجهك بكلّ سرور

128
00:08:41,660 --> 00:08:44,400
لنلعب قليلاً إذاً يا سيّد

129
00:08:46,550 --> 00:08:49,170
،إن أغمضتَ عينيك وعددتَ إلى ثلاثة

130
00:08:49,170 --> 00:08:52,330
سأريك شيئاً مثيراً للاهتمام

131
00:08:52,330 --> 00:08:54,520
حسناً، أتطلّع قدماً لذلك

132
00:08:55,850 --> 00:08:57,180
...واحد

133
00:08:57,590 --> 00:08:58,800
...اثنان

134
00:08:59,250 --> 00:09:00,430
...ثلاثة

135
00:09:00,850 --> 00:09:02,060
جاهز؟

136
00:09:08,880 --> 00:09:10,440
أيُّها الأحمق

137
00:09:11,020 --> 00:09:14,240
مُحال أن يظهر دبٌّ بنِّي في مكانٍ كهذا

138
00:09:14,730 --> 00:09:15,700
،لردِّ الجميل

139
00:09:15,900 --> 00:09:19,080
سأريك شيئاً مثيراً أيضاً

140
00:09:36,050 --> 00:09:39,720
!كلّ شيء في العالم مُسلٍّ

141
00:09:45,590 --> 00:09:48,440
هل أنت تينغو فعلاً يا سيّد؟

142
00:09:48,690 --> 00:09:50,740
عمّاذا تتكلّم؟

143
00:09:50,740 --> 00:09:53,440
أنا أعظم بكثير من أي تينغو

144
00:09:58,170 --> 00:09:59,820
!لحظة، لحظة، لحظة

145
00:10:01,950 --> 00:10:03,930
!مـ-مهلاً يا ياسابورو

146
00:10:03,930 --> 00:10:06,140
ني-تشان، ما الخطب؟

147
00:10:13,460 --> 00:10:15,520
!تـ-توقّف

148
00:10:15,520 --> 00:10:18,860
!إن لم تتوقّف فسأطلق عليك النّار

149
00:10:38,940 --> 00:10:39,780
ماذا؟

150
00:10:40,680 --> 00:10:42,120
ما الذي يجري؟

151
00:10:46,120 --> 00:10:47,900
!ني-تشان! ني-تشان

152
00:10:47,900 --> 00:10:48,870
!استيقظ

153
00:10:51,310 --> 00:10:53,000
أين أنا؟

154
00:10:53,000 --> 00:10:54,630
!استيقظ ني-تشان

155
00:10:56,120 --> 00:10:57,880
هل أنت بخير يا ني-تشان؟

156
00:10:58,280 --> 00:11:00,260
استيقظتَ أخيراً؟

157
00:11:00,260 --> 00:11:01,300
ماذا؟

158
00:11:01,300 --> 00:11:02,890
ما الذي يجري؟

159
00:11:02,890 --> 00:11:04,830
لا تتذكّر شيئاً؟

160
00:11:04,830 --> 00:11:06,520
!لقد خُدِعت

161
00:11:06,980 --> 00:11:08,570
لم نعرف ماذا نفعل

162
00:11:08,570 --> 00:11:11,470
لم تكن تستجيب لنا إطلاقاً

163
00:11:11,470 --> 00:11:15,220
كانَتْ فكرة كايسي أن نرميك في نهرِ كامو

164
00:11:15,840 --> 00:11:17,040
—شكراً يا كايسي

165
00:11:17,040 --> 00:11:20,230
!من المثير للشفقةِ أن ينخدع تانوكيّ بواسطةِ إنسان

166
00:11:31,540 --> 00:11:33,250
المعذرة

167
00:11:42,210 --> 00:11:44,050
مرحباً يا بروفيسور يودوغاوا

168
00:11:44,530 --> 00:11:45,750
مساء الخير

169
00:11:45,750 --> 00:11:48,260
شكراً لمجيئك

170
00:11:48,990 --> 00:11:51,330
أردتُ أن أريك هذه اللّوحة

171
00:11:51,330 --> 00:11:53,560
ألا تعتقد أنّها عظيمة؟

172
00:11:54,260 --> 00:11:57,320
يبدو كصخرة مكسوّة بالفرو

173
00:11:58,620 --> 00:12:01,570
أعترف أنّ هذا متجر فريد جدّاً من نوعه

174
00:12:01,970 --> 00:12:05,740
إنّه متجر شبيه بمتحف الرسّام المعلّم أياميكي

175
00:12:06,280 --> 00:12:09,700
لكن الشّخص الذي يدير المتجر هو زوجته

176
00:12:14,490 --> 00:12:16,590
الذي يعارض قدور التانوكي البخاريّة

177
00:12:16,940 --> 00:12:18,160
...حسناً

178
00:12:18,160 --> 00:12:21,060
ألم تعد بينتين-سان بعد؟

179
00:12:21,520 --> 00:12:24,580
في الواقع، بينتين-ساما شخصيّة مزاجيّة جدّاً

180
00:12:25,190 --> 00:12:27,680
لنفترق ونبحث عنه

181
00:12:28,850 --> 00:12:32,100
!أياميكي-سان

182
00:12:35,070 --> 00:12:36,980
من أي عشيرة تانوكي أنت؟

183
00:12:38,660 --> 00:12:42,040
أنا ياسابورو، الابن الثّالث لشيموغامو سويتشيرو

184
00:12:44,680 --> 00:12:47,950
وأنا أونجوجي غونزابورو

185
00:12:48,200 --> 00:12:50,900
أخوك الأكبر، يايتشيرو-كن، قد ساعدَني من قبل

186
00:12:50,900 --> 00:12:52,630
سمعتُ بك كذلك

187
00:12:53,070 --> 00:12:54,890
الرسّام المعلّم من هذا الاتّجاه

188
00:12:54,890 --> 00:12:56,580
سأدلّك إليه

189
00:13:12,120 --> 00:13:15,350
احرص على عدمِ إزعاجه

190
00:13:19,610 --> 00:13:22,110
كيف حالك يا أياميكي-سينسي؟

191
00:13:22,110 --> 00:13:23,870
لقد أتيتُ لمُرافقتك

192
00:13:26,830 --> 00:13:29,800
كان هذا الجوف بركة

193
00:13:30,710 --> 00:13:32,820
،حدث ذلك منذ خمسين عاماً

194
00:13:32,820 --> 00:13:35,730
لكن حفرتُه بنفسي

195
00:13:37,780 --> 00:13:40,260
،عندما أجلس هنا هكذا

196
00:13:40,260 --> 00:13:44,880
أشعر وكأنّني ضفدع في قاع بئر
وهذا يبعثُ على السُّرور

197
00:13:46,720 --> 00:13:49,120
يبدو أنّ العشاء سيصبح جاهزاً قريباً

198
00:13:49,120 --> 00:13:50,260
هيّا بنا نعود

199
00:13:50,680 --> 00:13:53,770
معنى هذا أنَّ عملي انتهى اليوم

200
00:13:54,440 --> 00:13:56,630
أجل، عمل جيّد

201
00:13:59,210 --> 00:14:01,350
سمعتُ أصوات مهرجانات

202
00:14:01,990 --> 00:14:06,880
يبدو أنّ ذلك الرجل قد وصل

203
00:14:06,880 --> 00:14:08,150
أي رجل؟

204
00:14:08,150 --> 00:14:09,830
ضيف

205
00:14:09,830 --> 00:14:15,040
تزامن المهرجانات مع وصوله هو أمر
يسير بالنسبة له

206
00:14:18,540 --> 00:14:21,970
يبدو أنّ البروفيسور لم يعد بعد

207
00:14:23,020 --> 00:14:25,800
يبدو أنّه على وشك أن يتوه

208
00:14:25,800 --> 00:14:28,680
سأذهب وأبحث عنه

209
00:14:29,280 --> 00:14:30,250
...نعم

210
00:14:30,780 --> 00:14:33,180
أستميحك عذراً

211
00:14:33,520 --> 00:14:36,150
هذا تينمايا

212
00:14:37,680 --> 00:14:38,880
ماذا؟

213
00:14:38,880 --> 00:14:40,810
أنت ضيفٌ اللّيلة أيضاً؟

214
00:14:41,490 --> 00:14:43,320
تسرُّني رؤيتك مجدّداً

215
00:14:43,570 --> 00:14:45,080
اسمي ياسابورو

216
00:14:45,080 --> 00:14:47,940
سُرِرتُ بلقائك يا ياسابورو-كن

217
00:14:48,140 --> 00:14:51,700
اللّيلة، سأدعوك لتناول بعض الطعام العجيب

218
00:14:54,840 --> 00:14:56,690
،إن تركتها لي

219
00:14:56,690 --> 00:14:59,210
أستطيع بيع لوحاتك بأي ثمن تريد

220
00:14:59,710 --> 00:15:01,880
لا أنوي فعل ذلك

221
00:15:01,880 --> 00:15:06,880
لا جدوى من ترك هذه اللّوحات في متجر
لا يأتيه أحد

222
00:15:07,140 --> 00:15:08,230
،بع لوحاتك

223
00:15:08,230 --> 00:15:11,450
وستتمكّن من ملء تلك البركة التي جفَّتْ

224
00:15:11,450 --> 00:15:13,770
فقد أنقذتَ حياتي يا سينسي

225
00:15:13,770 --> 00:15:16,510
لهذا أريدك أن تعيش حياةً رغيدة

226
00:15:16,890 --> 00:15:20,640
أنا سعيدٌ بحياتي الحاليّة

227
00:15:21,620 --> 00:15:23,910
لا أستطيع تقديم الكثير

228
00:15:23,910 --> 00:15:29,040
لناسك جبليّ أرضاه اللّعب
مع التانوكيّين والصُّخور

229
00:15:29,040 --> 00:15:32,840
لستُ عظيماً إلى هذا الحدّ

230
00:15:32,840 --> 00:15:33,670
تماماً

231
00:15:33,670 --> 00:15:35,950
!أي ناسك جبليّ هذا

232
00:15:35,950 --> 00:15:39,660
جعلَني أعاني الأمرَّين وأبكاني كثيراً

233
00:15:39,940 --> 00:15:43,560
هل هذا يعني أنّك رجل سوقيّ يا سينسي؟

234
00:15:43,560 --> 00:15:45,730
أنا رجلٌ سوقيّ بالفعل

235
00:15:45,730 --> 00:15:48,440
رائع، رائع! هكذا ينبغي أن تكون

236
00:15:48,440 --> 00:15:50,380
!تحيا السوقيّة

237
00:15:50,730 --> 00:15:54,280
حسناً، لكافّة الزملاء السّوقيين المجتمعين هنا

238
00:15:54,280 --> 00:15:55,890
لنقدّم أداء سوقيّاً

239
00:16:12,620 --> 00:16:13,780
!يا للهول

240
00:16:25,520 --> 00:16:26,740
!النّهاية

241
00:16:31,720 --> 00:16:34,380
هذا ما يُطلَق عليه بالوهم

242
00:16:38,630 --> 00:16:43,550
بروفيسور، من هو تينمايا ذاك؟

243
00:16:43,550 --> 00:16:46,220
سبقَ ورأيتُه في نادي الجمعة

244
00:16:46,760 --> 00:16:49,690
يبدو أنّه يعمل لحساب جيوروجين

245
00:16:49,690 --> 00:16:51,970
لهذا يبدو مشبوهاً جدّاً

246
00:16:51,970 --> 00:16:54,070
قد يكون جاسوساً

247
00:16:54,360 --> 00:16:56,300
لكن هذا غريب

248
00:16:56,730 --> 00:16:59,900
يبدو أنّه أثار غضب جيوروجين

249
00:16:59,900 --> 00:17:02,080
واختفى عن كيوتو

250
00:17:02,430 --> 00:17:05,230
مضَتْ بضع سنواتٍ على ذلك الآن

251
00:17:11,240 --> 00:17:13,220
يودوغاوا-سينسي

252
00:17:13,870 --> 00:17:15,590
...لذا سمعتُ

253
00:17:15,820 --> 00:17:19,140
أنّك طُرِدت من نادي الجمعة

254
00:17:19,140 --> 00:17:21,210
ماذا إن كان كذلك يا تينمايا-سان؟

255
00:17:21,210 --> 00:17:23,350
أنا متأكّدٌ تماماً أنّ ذلك لا يعنيك

256
00:17:24,030 --> 00:17:27,990
سمعتُ أنّك تحتجُّ على قدور التانوكيين البخاريّة
في المظاهرات

257
00:17:27,990 --> 00:17:29,900
هذه حركة جريئة

258
00:17:29,900 --> 00:17:31,640
مِمَّن سمعتَ ذلك؟

259
00:17:31,640 --> 00:17:33,360
،أستطيع رؤية وسماع كلّ شيء

260
00:17:33,360 --> 00:17:35,110
حتّى لو كان في أعماق الجحيم

261
00:17:35,400 --> 00:17:38,870
ألم تغادر لقضاءِ رحلة؟

262
00:17:38,870 --> 00:17:41,620
هذا صحيح. بالفعل

263
00:17:41,880 --> 00:17:47,620
تعبير فضولي البريء أثارَ غضب
جيوروجين العظيم

264
00:17:47,850 --> 00:17:52,630
والآن أعيش كشخصٍ تائه، أنساق كغيمة
بيضاء بواسطة الرّياح

265
00:17:52,990 --> 00:17:56,360
لننسجم معاً بما أنّ كلينا منبوذان

266
00:17:56,360 --> 00:17:58,160
سأكون سعيداً بسماعك

267
00:17:58,160 --> 00:17:59,730
أرفُض

268
00:17:59,730 --> 00:18:01,890
لن أتحمّل أجور استشارتك

269
00:18:03,370 --> 00:18:04,640
...قل لي يا بروفيسور

270
00:18:05,400 --> 00:18:07,380
جيوروجين مرعبٌ للغاية

271
00:18:07,380 --> 00:18:09,770
حريّ بك أن تنتبه من الغدر

272
00:18:10,390 --> 00:18:12,650
على أي حال، أستأذن الآن

273
00:18:19,790 --> 00:18:22,160
يا له من شخص مريع

274
00:18:22,520 --> 00:18:24,660
علينا أن نبقى يقظين أمامه

275
00:18:25,590 --> 00:18:28,210
اسبقني وعد إلى المنزلِ من فضلك يا بروفيسور

276
00:18:28,210 --> 00:18:30,690
أودُّ زيارة مكانٍ ما

277
00:18:35,760 --> 00:18:39,880
هل انتهيت من تنكّرك يا ياسابورو-سان؟

278
00:18:39,880 --> 00:18:42,240
لقد كشفتَني إذاً

279
00:18:42,240 --> 00:18:43,930
تسرّني رؤيتك مجدّداً

280
00:18:45,890 --> 00:18:48,690
هل نسيتَ شيئاً؟

281
00:18:49,660 --> 00:18:52,380
أريد معرفة المزيد عن تينمايا-سان

282
00:18:52,380 --> 00:18:55,750
،تمكّن تينمايا-سان من خداعي سابقاً

283
00:18:56,190 --> 00:18:58,700
لهذا أودُّ ردّ الاعتبار منه

284
00:18:58,900 --> 00:19:01,820
هل يخدع تينمايا-سان التانوكيين؟

285
00:19:02,100 --> 00:19:03,470
أجل

286
00:19:03,470 --> 00:19:04,950
عانيتُ كثيراً منه

287
00:19:04,950 --> 00:19:06,860
يا له من شخص مزعج

288
00:19:07,540 --> 00:19:11,330
سأخبرك عن المكان الذي أتى منه تينمايا-سان

289
00:19:11,330 --> 00:19:12,950
اتبعني من فضلك

290
00:19:14,810 --> 00:19:19,090
أخفي هذه هنا كلّما أتى تينمايا-سان

291
00:19:19,310 --> 00:19:22,730
لأنّه يحاول أن يحرقها

292
00:19:31,210 --> 00:19:34,980
تلقّيتُ لوحة الجحيم هذه من شخص

293
00:19:35,260 --> 00:19:38,690
طلب منّي أن أرسم بوذا فيها

294
00:19:39,170 --> 00:19:42,760
،لا أريد أن أرسم شيئاً بأمر من أحد

295
00:19:42,760 --> 00:19:45,990
لكن عندما رأيتُ هذا، أردتُ رسمه فيها

296
00:19:46,270 --> 00:19:49,450
شعرتُ بالشفقةِ على الموتى

297
00:19:49,860 --> 00:19:52,630
ستكون أنت البوذا الخاصّ به في الجحيم إذاً

298
00:19:53,270 --> 00:19:58,200
استخدم تينمايا-سان خيطَ العنكبوت هذا للتسلُّق والخروج

299
00:19:59,080 --> 00:20:02,670
.كان في لوحةِ الجحيم هذه

300
00:20:09,010 --> 00:20:12,200
الشّخص الذي طلبَ منّي إضافة
بوذا إلى هذه اللّوحة

301
00:20:12,200 --> 00:20:14,630
هو رئيس الكهنة من معبدٍ ما

302
00:20:14,630 --> 00:20:18,790
لا أعرف من يكون المالك الشرعيّ للوحة

303
00:20:19,150 --> 00:20:22,490
أثار غضبَ جيوروجين العظيم...

304
00:20:35,390 --> 00:20:37,630
أريدُ القمر

305
00:20:37,930 --> 00:20:40,780
هيّا، حاول أن تحصل عليه يا ياسابورو

306
00:20:48,660 --> 00:20:52,390
من النّادر أن يأتي زائرٌ في هذه السّاعة

307
00:20:53,080 --> 00:20:56,330
ألا تعتقد أنَّ القمر مدهش؟

308
00:20:56,330 --> 00:20:58,970
أشربُ نخبَ القمر اللّيلة

309
00:21:05,160 --> 00:21:08,240
!تينمايا

310
00:21:12,770 --> 00:21:16,120
!لقد أتيتُ لأعيدك إلى الجحيم

311
00:21:16,410 --> 00:21:19,000
!انتظر! انتظر

312
00:21:25,830 --> 00:21:29,010
!انتظر

313
00:21:35,940 --> 00:21:39,450
البشر هم الأكثر رُعباً

314
00:21:40,120 --> 00:21:42,070
لا شيء أخطر من بشريّ

315
00:21:42,070 --> 00:21:45,010
يعي جزئيّاً ما يجري في العالم
كندٍّ في الخداع

316
00:21:45,920 --> 00:21:51,580
لا تستهينوا بالبشر الذين يُتقِنون
بصمتٍ فنَّ خداع الآخرين

317
00:21:52,010 --> 00:21:57,420
عصر خِداع التانوكيين بواسطةِ البشر مقبلٌ علينا

318
00:23:30,920 --> 00:23:33,390
لقد مللتُ كثيراً

319
00:23:33,870 --> 00:23:36,510
وجدتُها. سأكتب رسالة

320
00:23:37,520 --> 00:23:39,270
!كم هذا مملّ