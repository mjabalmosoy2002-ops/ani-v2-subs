1
00:00:10,610 --> 00:00:12,660
!لا تُطلِق! لا تُطلِق

2
00:00:14,220 --> 00:00:16,240
!ليسَ من العدلِ أن تُشهر سلاحاً ناريّاً

3
00:00:16,540 --> 00:00:19,020
!كنتَ أنت يا ياسابورو-كن

4
00:00:19,020 --> 00:00:20,660
لقد فعلتَ فعلتك

5
00:00:21,340 --> 00:00:24,000
سيّدي، التقطتَه من مكانٍ ما، أليس كذلك؟

6
00:00:24,320 --> 00:00:26,330
كيف عرفتَ ذلك؟

7
00:00:26,330 --> 00:00:28,540
وقعَ من أحد معارفي

8
00:00:28,540 --> 00:00:30,200
كان يبحثُ عنه منذ مدّة

9
00:00:30,200 --> 00:00:31,210
أعدْه من فضلك

10
00:00:31,440 --> 00:00:33,010
حقّاً؟

11
00:00:33,010 --> 00:00:36,260
لكنّه أصبح من مُمتلكاتي المفضّلة الآن

12
00:00:36,480 --> 00:00:39,190
لن أتمكّن من إعادته بتلك البساطة

13
00:00:42,000 --> 00:00:44,400
ليس عدلاً أن تشهر سلاحاً ناريّاً

14
00:00:44,400 --> 00:00:45,840
،لا أتصرّف بإنصاف

15
00:00:45,840 --> 00:00:47,520
أنا غشّاش

16
00:00:52,440 --> 00:00:55,210
،كي تكون غشّاشاً بمعنى الكلمة

17
00:00:55,210 --> 00:01:00,220
يجب أن تخفي في جُعبتك كلّ خدعة غير مُنصِفة

18
00:01:08,470 --> 00:01:10,290
ينبغي أن يكون هذا كافياً

19
00:01:14,220 --> 00:01:16,120
،ما لم أحصل على إجابةٍ ترضيني

20
00:01:16,120 --> 00:01:18,340
سأحتفظ بقمرِك

21
00:01:20,100 --> 00:01:22,030
وأيضاً، كان ذلك شيطاناً بديعاً

22
00:01:22,030 --> 00:01:23,420
لقد انصدمت

23
00:01:23,420 --> 00:01:25,940
ظننتُ أنّ شيطاناً من الجحيم قد يُخيفك قليلاً

24
00:01:26,820 --> 00:01:29,400
هل رأيتَ لوحةَ الجحيم تلك؟

25
00:01:29,790 --> 00:01:30,650
أجل

26
00:01:30,650 --> 00:01:31,800
اللّعنة

27
00:01:31,800 --> 00:01:33,780
عرفتُ أنّها ما زالَتْ في ذلك المنزل

28
00:01:34,630 --> 00:01:37,400
تينمايا-سان، كنتَ في الجحيم، صحيح؟

29
00:01:37,720 --> 00:01:40,750
أوهام جيوروجين قد تفوّقَتْ عليّ

30
00:01:41,200 --> 00:01:44,030
لماذا أغضبتَ جيوروجين؟

31
00:01:44,740 --> 00:01:47,820
يبدو أنّني لا أعرف شيئاً عنك

32
00:01:47,820 --> 00:01:49,790
كيف عرفتَ جيوروجين؟

33
00:01:50,150 --> 00:01:52,460
عرّفني عليه شخص تُدعى بينتين

34
00:01:52,460 --> 00:01:54,050
!بينتين؟

35
00:01:54,300 --> 00:01:57,340
!تِلك المرأة هي سبب كلّ هذا

36
00:01:57,340 --> 00:02:00,550
أقحمَتْ في رأس جيوروجين الأكاذيب والحقائق النّاقصة

37
00:02:01,520 --> 00:02:03,860
صحيح، إنّها حسناء

38
00:02:03,860 --> 00:02:05,720
صحيح، إنّها فاتنة حقّاً

39
00:02:05,950 --> 00:02:08,850
صحيح، إنّها بعيدةٌ عن منالي تماماً

40
00:02:09,150 --> 00:02:13,360
لكن هذا لا يعني أنّني سأدعها تفلت
بإرسالها لي إلى الجحيم هكذا

41
00:02:13,360 --> 00:02:15,820
!أنا تينمايا العظيم

42
00:02:15,820 --> 00:02:18,950
لن أدفن عظامي في الجحيمِ بتلك السّهولة

43
00:02:18,950 --> 00:02:20,700
اللّعنة على تلك المرأة

44
00:02:20,700 --> 00:02:23,470
—في المرّةِ المقبلة التي أراها فيها ستندم على

45
00:02:34,500 --> 00:02:36,460
لم أرك منذُ مدّة

46
00:04:10,980 --> 00:04:14,270
لم أرك منذ مدّة يا تينمايا-سان

47
00:04:16,130 --> 00:04:18,460
يسرّني أن أراك على ما يُرام

48
00:04:19,710 --> 00:04:20,880
...بينتين-ساما

49
00:04:21,150 --> 00:04:23,530
ينبغي أن تصبح مدرّساً

50
00:04:24,670 --> 00:04:27,190
حسناً، حسناً، إنّها بينتين-ساما دون سواها

51
00:04:27,190 --> 00:04:29,540
ما الذي سمعتِه من محادثتنا؟

52
00:04:29,540 --> 00:04:33,160
سمعتُ عندما قلتَ أنّني بعيدة عن منالِك تماماً

53
00:04:33,680 --> 00:04:36,420
لقد سمعتُ رأيك الثَّمين

54
00:04:36,420 --> 00:04:39,340
انسي كلّ ما قلتُه بعد ذلك أرجوكِ

55
00:04:39,340 --> 00:04:42,800
قال أنّكِ ستندمين عندما يراكِ في المرّةِ المقبلة

56
00:04:42,800 --> 00:04:45,280
!عمّاذا تتكلّم يا ياسابورو-كن؟

57
00:04:45,280 --> 00:04:47,760
!كان ذلك مجرَّد تلاعُب بالكلمات

58
00:04:47,760 --> 00:04:51,560
يُقال هذا عن شخصٍ تهتمُّ به، أليس كذلك؟

59
00:04:52,590 --> 00:04:53,980
!يا للهول

60
00:04:54,400 --> 00:04:57,880
قد تتهشّم جمجمتك في أي وقتٍ يا تينمايا-سان

61
00:04:57,880 --> 00:04:59,980
هل تريد العودة إلى الجحيم؟

62
00:04:59,980 --> 00:05:01,340
!على الإطلاق

63
00:05:02,250 --> 00:05:07,360
ليس عندما أعيشُ النّعيم تحت قدمكِ يا بينتين-ساما

64
00:05:07,360 --> 00:05:11,370
لا أصدِّق أنّني رأيتُ وجهك في اللّحظة
التي عدتُ فيها إلى المنزل

65
00:05:11,680 --> 00:05:14,780
،لننسَ المشاكل التي عانيناها في الجحيم

66
00:05:14,780 --> 00:05:17,890
ولننسجم معاً

67
00:05:17,890 --> 00:05:19,890
ماذا سأفعل؟

68
00:05:19,890 --> 00:05:23,830
فأنا أكرهك حدّ الجنون

69
00:05:24,700 --> 00:05:25,420
يا إلهي

70
00:05:25,420 --> 00:05:27,330
هذا جميلٌ جدّاً

71
00:05:29,830 --> 00:05:31,780
...ما أجمله من قمر

72
00:05:31,780 --> 00:05:33,090
أليس كذلك يا ياسابورو؟

73
00:05:33,090 --> 00:05:35,120
أجل، بالطبع

74
00:05:35,120 --> 00:05:37,100
إنّه قمري

75
00:05:37,320 --> 00:05:38,810
حقّاً؟

76
00:05:38,810 --> 00:05:41,340
أريد أن أعرضه في منزلي

77
00:05:41,340 --> 00:05:44,240
لطالما أردتُ شيئاً كهذا

78
00:05:44,640 --> 00:05:46,510
لا تفعلي أرجوكِ

79
00:05:46,510 --> 00:05:50,200
التانوكيّ من دون قمرٍ مُضيء ليلاً
كعدم وجود كرش يطبِّل عليه

80
00:05:50,200 --> 00:05:53,680
لم يسبق أن طبّلتَ على كرشك لأجلي من قبل

81
00:06:21,340 --> 00:06:23,990
سيموت تينمايا-سان

82
00:06:24,950 --> 00:06:27,540
مُحال أن يموت جرّاء شيء كهذا

83
00:06:30,200 --> 00:06:32,660
إنّه قمر جميل بحَقّ

84
00:06:35,540 --> 00:06:38,010
احمل أمتعتي عنّي يا ياسابورو

85
00:06:38,540 --> 00:06:41,790
أنا ذاهبة لإلقاءِ التحيّة على معلّمنا

86
00:06:42,080 --> 00:06:43,590
هذه فكرةٌ سديدة

87
00:06:43,590 --> 00:06:45,860
أنا متأكّدٌ أنّ السّعادة ستغمره

88
00:06:48,920 --> 00:06:51,800
بينتين-ساما، هلّا طلبتُ طلباً؟

89
00:06:52,360 --> 00:06:53,980
ما هو يا ياسابورو؟

90
00:06:54,810 --> 00:06:58,390
هل تمانعين إعادة قمري إليّ؟

91
00:06:58,690 --> 00:06:59,590
يا إلهي

92
00:06:59,590 --> 00:07:01,940
وهل عليّ إعادته حقّاً؟

93
00:07:02,210 --> 00:07:04,810
أطلب منكِ ذلك بكلِّ تواضُع

94
00:07:04,810 --> 00:07:08,650
سيكون العيش صعباً للغاية في اللّيالي
المُظلِمة من دون ضوء قمر

95
00:07:08,960 --> 00:07:10,650
لستُ أدري

96
00:07:11,290 --> 00:07:13,780
أعني أنّني أمسكتُ بالقمرِ أخيراً

97
00:07:20,610 --> 00:07:23,170
شكراً جزيلاً لكِ يا بينتين-ساما

98
00:07:23,700 --> 00:07:26,840
هل لديك كلامٌ آخر تقوله؟

99
00:07:27,370 --> 00:07:29,300
يا لك من تانوكي جاهل

100
00:07:29,930 --> 00:07:31,060
ماذا تريدينني أن أقول؟

101
00:07:32,020 --> 00:07:34,750
قُلْ أنّك اشتقتَ إليّ يا ياسابورو

102
00:07:36,640 --> 00:07:38,400
اشتقتُ إليكِ كثيراً

103
00:07:39,430 --> 00:07:41,830
أهلاً بعودتكِ يا بينتين-ساما

104
00:07:42,640 --> 00:07:44,480
عدتُ أخيراً

105
00:07:45,540 --> 00:07:48,020
الأمور على وشك أن تصبح مثيرة
أليس كذلك يا ياسابورو؟

106
00:07:57,450 --> 00:08:00,640
أترى الشّرخ البسيط عند هذه الدّرجة؟

107
00:08:00,640 --> 00:08:02,920
أنا من سبّبَه عندما قفزتُ عنها

108
00:08:02,920 --> 00:08:04,580
أنتِ تكذبين

109
00:08:05,310 --> 00:08:07,730
أنا لا أكذب إطلاقاً

110
00:08:07,730 --> 00:08:11,640
،صعدتُ ونزلتُ هذه الأدراج آلاف المرّات
من الطبيعي أن تنشرخ

111
00:08:12,050 --> 00:08:13,590
أثناء إحدى المرّات التي كنتُ ألعب فيها بهذا الشّكل

112
00:08:14,060 --> 00:08:16,640
صعدَها سو-سان لأوّل مرّة

113
00:08:16,640 --> 00:08:19,250
قال أنّه كان جزءاً من فرقة
تاكينوكو الاستكشافيّة

114
00:08:19,250 --> 00:08:22,120
ليسَتْ تاكينوكو، بل تسوتشينوكو

115
00:08:19,250 --> 00:08:22,120
تاكينوكو = قصبات خيزران

116
00:08:22,120 --> 00:08:23,600
أجل، تسوتشينوكو تلك

117
00:08:24,680 --> 00:08:28,050
،إذاً خرجَ أبي لاصطيادِ تسوتشينوكو

118
00:08:28,050 --> 00:08:30,020
فاصطادَ قلبكِ بدلاً من ذلك

119
00:08:40,560 --> 00:08:42,000
مرحباً

120
00:08:44,110 --> 00:08:48,500
عجباً، عجباً، إنّها توسين دون سِواها

121
00:08:48,780 --> 00:08:52,010
مضَتْ فترة طويلة منذُ رأيتُك كذلك يا ياسابورو

122
00:08:52,290 --> 00:08:54,410
لم أرك منذُ وقت يا ني-سان

123
00:08:54,830 --> 00:08:57,680
أتيتُ إلى هنا لأطلب معروفاً من أمّي

124
00:08:57,680 --> 00:08:59,290
هكذا إذاً

125
00:09:00,680 --> 00:09:02,140
لنمضِ إذاً

126
00:09:12,730 --> 00:09:21,490
...نامو، نامو

127
00:09:27,350 --> 00:09:30,170
أمّاه، هذه أنا، توسين

128
00:09:31,680 --> 00:09:33,420
يا إلهي

129
00:09:34,030 --> 00:09:35,700
أهذه أنتِ يا توسين؟

130
00:09:36,230 --> 00:09:39,060
إنّها ابنتكِ، توسين

131
00:09:39,440 --> 00:09:41,440
أعتذر لو أيقظتُكِ

132
00:09:41,810 --> 00:09:45,040
لا داعي للاعتذار

133
00:09:45,040 --> 00:09:48,690
لم أكن نائمة

134
00:09:48,690 --> 00:09:49,680
هذا جيّد

135
00:09:49,680 --> 00:09:51,940
أظنّكِ لم تكوني نائمة إذاً يا أمّاه

136
00:09:52,260 --> 00:09:53,780
أجل

137
00:09:54,240 --> 00:09:57,290
كنتُ أفكِّر بأمور مضحكة

138
00:09:57,290 --> 00:09:58,880
أمور مضحكة؟

139
00:09:59,200 --> 00:10:01,870
،مثل ماء نقيّ

140
00:10:01,870 --> 00:10:06,080
أو عند رؤية أوراق شجر خضراء
،فوق الماء

141
00:10:06,360 --> 00:10:10,540
أو عند رؤية ما وراء أوراق الشّجر
بسبب أشعّة الشّمس

142
00:10:10,540 --> 00:10:13,710
كنتِ تفكّرين بأشياء رائعة يا أمّاه

143
00:10:13,710 --> 00:10:17,770
أجل، فأنا أمّ

144
00:10:18,900 --> 00:10:20,160
يا إلهي

145
00:10:20,160 --> 00:10:22,820
ظننتُكِ ذهبتِ لتتزوّجي

146
00:10:22,820 --> 00:10:24,780
ذهبتُ بالفعل لأتزوّج

147
00:10:24,780 --> 00:10:27,670
توقّعتُ هذا

148
00:10:27,670 --> 00:10:30,730
هل أنتِ سعيدةٌ في حياتكِ إذاً؟

149
00:10:31,130 --> 00:10:33,110
أنا أعيش حياةً سعيدة

150
00:10:33,540 --> 00:10:34,880
شمّ، شمّ

151
00:10:34,880 --> 00:10:37,750
تفوح منكِ رائحةٌ زكيّة

152
00:10:38,200 --> 00:10:41,820
هلّا اشتممتني؟

153
00:10:44,220 --> 00:10:46,400
هل رائحتي غريبة؟

154
00:10:46,400 --> 00:10:48,690
بالطبع لا

155
00:10:48,690 --> 00:10:50,460
رائحتكِ زكيّة للغاية

156
00:10:50,460 --> 00:10:51,830
عرفت

157
00:10:51,830 --> 00:10:54,960
عرفتُ أنّ رائحتي ليسَتْ غريبة

158
00:10:54,960 --> 00:10:58,670
لكن أقلق بشأنِ ذلك من وقتٍ لآخر

159
00:10:59,150 --> 00:11:00,720
بصراحة يا أمّاه

160
00:11:00,720 --> 00:11:03,040
ثمّة شيء أودُّ مناقشته معكِ

161
00:11:03,040 --> 00:11:04,180
ما هو؟

162
00:11:04,520 --> 00:11:07,150
هنالك تانوكيّ قضى وقتاً طويلاً كضفدع

163
00:11:07,150 --> 00:11:10,260
ولم يعُد قادراً على العودة

164
00:11:10,260 --> 00:11:13,460
هل من طريقةٍ تمكّنه من التحوُّل مجدّداً؟

165
00:11:15,350 --> 00:11:17,520
،إن كان عاجزاً عن التحوُّل

166
00:11:17,520 --> 00:11:21,470
فهذا يعني أنَّ الماء في قاعِ معدته جافّ

167
00:11:21,470 --> 00:11:24,200
لكنّه يعيش في قاعِ بئر

168
00:11:25,000 --> 00:11:27,080
يوجد كثيرٌ من الماء هناك

169
00:11:27,280 --> 00:11:31,470
ماء البئر والماء في أسفل المعدة

170
00:11:31,470 --> 00:11:32,900
مختلفان قليلاً

171
00:11:32,900 --> 00:11:34,940
ماذا ينبغي أن نفعل؟

172
00:11:35,490 --> 00:11:37,810
سأخبركِ بدواء عظيم

173
00:11:38,270 --> 00:11:41,440
يمكنُ شربه أثناء تطبيق التحوُّل

174
00:11:42,010 --> 00:11:43,590
تويتشيرو

175
00:11:46,960 --> 00:11:48,560
انتظري لحظة من فضلكِ

176
00:11:48,770 --> 00:11:50,920
سأعدُّ الدواءَ حالاً

177
00:11:51,360 --> 00:11:52,550
شكراً لك

178
00:11:53,320 --> 00:11:55,690
من الذي هناك؟

179
00:11:56,930 --> 00:11:58,750
أنا مجرّد تانوكي صدفَ مروره من هنا

180
00:11:58,750 --> 00:12:00,450
اسمي ياسابورو

181
00:12:00,690 --> 00:12:03,190
مرحباً يا عزيزي

182
00:12:03,190 --> 00:12:05,510
أهذه هي المرّة الأولى التي نلتقي فيها؟

183
00:12:05,510 --> 00:12:08,210
أنا متأكّدٌ أنّنا التقينا مرّاتٍ عديدة من قبل

184
00:12:08,210 --> 00:12:09,130
عرفتُ هذا

185
00:12:09,130 --> 00:12:10,700
هذا ما توقّعتُه

186
00:12:11,200 --> 00:12:14,010
هلّا اقتربتَ قليلاً؟

187
00:12:16,490 --> 00:12:17,850
شمّ، شمّ

188
00:12:18,290 --> 00:12:22,630
لم تعُد عينايّ قادرتين على الرّؤية

189
00:12:22,630 --> 00:12:25,520
حدثَ ذلك دون سابق إنذار

190
00:12:25,890 --> 00:12:29,940
لكن يمكنني رؤية تدفُّق الماء فحسب

191
00:12:29,940 --> 00:12:34,780
هذا العالم عبارة عن نهر عُملاق
وكلّنا نجري فيه معاً

192
00:12:34,780 --> 00:12:39,270
يبدو أنّ مجرى ذلك النّهر لا يجري
كما ينبغي الآن

193
00:12:39,530 --> 00:12:42,190
ألا يُشبه هذا بمريضِ الإمساك؟

194
00:12:42,190 --> 00:12:44,740
أجل، شيء من هذا القبيل

195
00:12:45,960 --> 00:12:47,520
هذه ليسَتْ أخباراً سارّة

196
00:12:47,520 --> 00:12:50,620
لا تجعل الأمر يبدو وكأنّه لا يعنيك

197
00:12:50,620 --> 00:12:54,500
من هُنا يُفترَض أن تعمل بجدّ لتتخطّاه

198
00:12:54,500 --> 00:12:59,390
أبقِ عينيك يقظتين وفروك مرتّباً ونظيفاً

199
00:12:59,390 --> 00:13:02,740
واحرص على إثارة مشكلة ما

200
00:13:02,740 --> 00:13:04,810
مشكلة كبيرة بحَقّ

201
00:13:06,580 --> 00:13:09,540
هذا كُل ما أردتُ قوله

202
00:13:09,540 --> 00:13:11,030
النّهاية

203
00:13:21,650 --> 00:13:25,400
من هُنا يُفترَض أن تعمل بجدّ

204
00:13:27,080 --> 00:13:30,970
كانَتْ جدّتك تقول كلاماً مبهماً

205
00:13:30,970 --> 00:13:33,160
أتساءل ما الذي يُفترَض أن أعملَّ بجدٍّ عليه

206
00:13:33,160 --> 00:13:34,790
لا أملك أدنى فكرة

207
00:13:36,120 --> 00:13:38,540
الحرُّ شديدٌ هنا اليوم

208
00:13:39,320 --> 00:13:40,910
إنّه فصل الصّيف

209
00:13:41,320 --> 00:13:44,550
على ذكرِ الصّيف، مهرجان محرقة وداع
غوزان اقترب

210
00:13:44,550 --> 00:13:47,030
آمل أن يكون هذا العام ممتعاً

211
00:13:47,630 --> 00:13:50,450
بالمناسبة، هل سيحصلُ يايتشيرو على سفينةِ رفاهيّة؟

212
00:13:50,910 --> 00:13:51,850
أجل

213
00:13:51,850 --> 00:13:54,180
قال أنّه سيستأجر سفينةَ للمبعوثين

214
00:13:54,180 --> 00:13:56,140
كان يزور نارا بلا توقُّف

215
00:13:57,210 --> 00:13:59,670
يايتشيرو كثير الانشغالات

216
00:13:59,670 --> 00:14:02,230
...فهو لديه بطولة الشوغي وسفينة الرّفاهيّة

217
00:14:02,230 --> 00:14:04,610
ينبغي أن تفعل شيئاً لتعين أخاك

218
00:14:04,920 --> 00:14:06,240
مستحيل

219
00:14:06,240 --> 00:14:07,260
...تبّاً

220
00:14:12,300 --> 00:14:14,080
—ني-سا

221
00:14:14,610 --> 00:14:16,650
ياسابورو

222
00:14:18,750 --> 00:14:21,080
ماذا تفعل يا ني-سان؟

223
00:14:21,340 --> 00:14:22,780
...في الواقع

224
00:14:22,780 --> 00:14:25,460
كنتُ أمارس تحوُّلاتي

225
00:14:25,730 --> 00:14:27,720
أتعتقد أنّك استعدت قدرتك؟

226
00:14:27,920 --> 00:14:29,500
من الصّعب أن أجزم

227
00:14:29,500 --> 00:14:32,460
،يمكنني التحوُّل إلى قطار إيزان

228
00:14:32,460 --> 00:14:35,040
لكن حظّي لم يُحالفني في بقيّةِ التحوُّلات

229
00:14:39,730 --> 00:14:40,650
ما هذا؟

230
00:14:41,310 --> 00:14:44,010
،سأشارك في بطولةِ الشوغي

231
00:14:44,010 --> 00:14:46,700
لهذا كنتُ أتمرّن على بعض التسوميشوغي

232
00:14:47,940 --> 00:14:50,080
وما الذي جاء بك إلى هنا اليوم؟

233
00:14:50,080 --> 00:14:51,530
آه صحيح

234
00:14:53,020 --> 00:14:54,470
ما هذا؟

235
00:14:54,470 --> 00:14:57,170
تلقّيتُ دواء ما من جدّتي

236
00:14:57,590 --> 00:15:00,540
لا ضير إن تمكّنتَ من استعادةِ قدرتك
على التحوُّل بشكلٍ أسرع

237
00:15:01,220 --> 00:15:03,360
جدّتي؟

238
00:15:03,360 --> 00:15:04,410
أجل

239
00:15:04,410 --> 00:15:06,540
سأتناوله وبكلِّ سرور

240
00:15:06,540 --> 00:15:09,930
عندما تعود قدرات التحوُّل خاصّتي، ينبغي
أن أذهب وأشكرها

241
00:15:09,930 --> 00:15:13,620
اشتهرَ الدّواء المُقدَّم من تانوكيداني فودو
بأنّه ناجع

242
00:15:13,620 --> 00:15:17,210
بالمناسبة يا ياسابورو، هل سمعتَ عن نيدايمي؟

243
00:15:17,210 --> 00:15:18,130
ما به؟

244
00:15:18,760 --> 00:15:20,970
يبدو أنّه غادرَ فندقه

245
00:15:20,970 --> 00:15:21,710
ماذا؟

246
00:15:22,660 --> 00:15:25,330
هذه أوّل مرّة أسمعُ فيها ذلك

247
00:15:32,290 --> 00:15:34,330
أهو هنا حقّاً؟

248
00:15:34,880 --> 00:15:37,880
يبدو أنّه انتقلَ من الفندق إلى هذا السّطح

249
00:15:43,310 --> 00:15:45,220
انتظر لحظة يا ياشيرو

250
00:16:19,790 --> 00:16:21,180
مرحباً

251
00:16:21,680 --> 00:16:23,790
آسف لو تأخّرتُ عليك

252
00:16:23,790 --> 00:16:26,710
أنا متفاجئ من أنّك تكوي تحت هذه الحرارة

253
00:16:27,200 --> 00:16:28,730
ألا تشعر بالحَرّ؟

254
00:16:28,730 --> 00:16:30,480
الحرّ شديد بالفعل

255
00:16:30,930 --> 00:16:33,550
بالمناسبة، مَن معك؟

256
00:16:35,000 --> 00:16:38,400
أظهر أمامك وبكلِّ تواضع بصفتي
،الابن الرّابع لشيموغامو سويتشيرو

257
00:16:38,400 --> 00:16:40,560
شيموغامو ياشيرو

258
00:16:40,560 --> 00:16:44,720
احتفالاً بانتقالِك إلى هنا، أقدِّم لك هذه الهديّة

259
00:16:45,750 --> 00:16:48,080
حسناً، شكراً لك

260
00:16:50,480 --> 00:16:51,590
إذاً

261
00:16:52,070 --> 00:16:55,040
هل لدى كُرات الفرو بعض من الوقت؟

262
00:16:55,040 --> 00:16:57,670
لدينا وقتُ فراغ أكثر من اللّازم

263
00:16:57,670 --> 00:16:58,900
عظيم

264
00:16:58,900 --> 00:17:00,790
،امتناناً منّي لكما على هديّةِ الانتقال

265
00:17:00,790 --> 00:17:04,090
سأدعوكما يا كرتا الفراء إلى تناول شاي مسائيّ

266
00:17:24,890 --> 00:17:26,080
!ساخن

267
00:17:30,230 --> 00:17:32,310
ألم يعجبك؟

268
00:17:32,810 --> 00:17:34,540
لا أقصد ذلك

269
00:17:34,540 --> 00:17:35,580
مذاقه شهيٌّ جدّاً

270
00:17:36,310 --> 00:17:39,660
كلّ ما في الأمر أنّني أفضِّل ألّا
أوسِّخ يديّ أثناء الأكل

271
00:17:40,620 --> 00:17:44,120
هذا مكانٌ فاخرٌ جدّاً

272
00:17:44,600 --> 00:17:48,250
يبدو أنّه قصر كان ينتمي لشخصٍ رفيع الشّأن
في عالم التانوكي

273
00:17:48,250 --> 00:17:51,240
عندما وجدتُه أوّل مرّة، فاحَتْ
منه رائحة تانوكي

274
00:17:51,240 --> 00:17:54,260
لكنّني رمّمتُه بشكلٍ كامل لذا لم أعُد
أشتمّ الرَّائحة

275
00:17:54,690 --> 00:17:58,510
هل يُعقَل أن يكون كينكاكو وغينكاكو هما
من أطلعاك على هذا المكان؟

276
00:17:59,400 --> 00:18:00,810
أصبت

277
00:18:01,430 --> 00:18:03,830
،يبدو أنّه منذُ مغادرة والدهما كيوتو

278
00:18:03,830 --> 00:18:06,020
لم يعد يسكنه أحد

279
00:18:06,440 --> 00:18:09,440
سجّلتَ على نفسِك دَيناً لثنائي مُزعج للغاية

280
00:18:09,890 --> 00:18:11,920
لا يوجد دَين

281
00:18:11,920 --> 00:18:15,110
حصلا على زبديّةٍ مليئةٍ بالذهب

282
00:18:15,110 --> 00:18:17,080
إنّهما لا يتصرّفان إلّا بدافع الجشع

283
00:18:17,080 --> 00:18:18,710
علاقة مصلحة مُتبادَلة شفّافة وصادقة

284
00:18:18,710 --> 00:18:21,660
بالنسبة لي، يمكنني القول أنّك أكثر إزعاجاً بكثير

285
00:18:22,250 --> 00:18:26,040
أنت تهدرُ قدراتك كـتينغو

286
00:18:26,800 --> 00:18:29,520
لا ضير من التحرُّر مرّة بين الفيّنة والأخرى

287
00:18:30,640 --> 00:18:33,350
تقول كلاماً مُزعِجاً بحقّ

288
00:18:34,000 --> 00:18:36,050
لكن لستُ تينغو

289
00:18:36,050 --> 00:18:38,810
ها أنت ذا تتصرَّف بعنادٍ من جديد

290
00:18:39,210 --> 00:18:41,550
أنا مشغولٌ جدّاً

291
00:18:42,030 --> 00:18:44,060
لم أنتهِ حتّى من تنظيفِ هذه الغرفة بعد

292
00:18:44,380 --> 00:18:45,860
ماذا تعني؟

293
00:18:45,860 --> 00:18:50,020
لا تُقارَن البتّة بشقّة أكاداما-سينسي
الفوضويّة للغاية

294
00:18:55,100 --> 00:18:57,530
ينبغي أن تحرق ذلك المكان فحسب

295
00:18:57,860 --> 00:18:59,250
ستكون أنظف بكثير

296
00:19:02,870 --> 00:19:05,230
ياشيرو، أنتَ وقِح

297
00:19:05,230 --> 00:19:07,040
أنا آسف

298
00:19:07,040 --> 00:19:08,350
لا أمانع

299
00:19:08,820 --> 00:19:10,230
كهرومغناطيسيّة، صحيح؟

300
00:19:10,230 --> 00:19:11,010
أجل

301
00:19:11,010 --> 00:19:14,420
كنتُ أبحثُ فيه ذات مرّة وبشكلٍ إدمانيّ

302
00:19:14,690 --> 00:19:15,560
لديّ فكرة

303
00:19:15,560 --> 00:19:19,260
سأعطي ياشيرو-كن شيئاً يحمي به عينيه

304
00:19:22,550 --> 00:19:23,930
تفضّل

305
00:19:27,860 --> 00:19:29,140
هيّا خذها

306
00:19:29,620 --> 00:19:31,300
!شكراً لك

307
00:19:41,710 --> 00:19:43,430
،يا كرتا الفِراء وصديقايّ

308
00:19:43,430 --> 00:19:45,580
هلّا طلبتُ منكما المغادرة سريعاً؟

309
00:19:45,580 --> 00:19:48,490
نعتذر عن البقاءِ لمدّةٍ طويلة

310
00:19:49,210 --> 00:19:51,040
،قبل أن أتمشّى

311
00:19:51,040 --> 00:19:53,420
أريد أخذ قيلولة على أريكتي

312
00:20:13,170 --> 00:20:15,430
إنّها بينتين-ساما

313
00:20:16,190 --> 00:20:17,560
هكذا إذاً

314
00:20:21,720 --> 00:20:22,990
بِمَ أخدمك؟

315
00:20:23,510 --> 00:20:24,650
،يا آنسة

316
00:20:24,650 --> 00:20:27,320
أعتذر عن قولي هذا الكلام في الوقت
الذي أنتِ فيه مسترخية

317
00:20:27,740 --> 00:20:29,990
لكن أودُّ استعادة أريكتي

318
00:20:30,570 --> 00:20:35,020
يجب أن آخذ قيلولةً مسائيّة قريباً

319
00:20:35,650 --> 00:20:39,000
لكنّني أجلس عليها

320
00:20:39,350 --> 00:20:43,570
هذه أريكتي المُحبَّبة يا آنسة

321
00:20:43,570 --> 00:20:44,870
هذا واضح

322
00:20:45,290 --> 00:20:47,990
فهي مريحةٌ جدّاً

323
00:20:48,630 --> 00:20:50,520
أشعر وكأنَّني سأنام في أي لحظة

324
00:21:03,430 --> 00:21:05,800
عظيم يا آنسة

325
00:21:06,320 --> 00:21:08,570
ابقي حيثُ أنتِ، ابقي حيثُ أنتِ

326
00:21:16,030 --> 00:21:19,120
أعتذر عن الضجيجِ يا آنسة

327
00:21:19,580 --> 00:21:23,300
،لكن مهما كنتِ مسترخية ومرتاحة

328
00:21:23,300 --> 00:21:26,130
المشكلة التي بمُتناول اليد الآن

329
00:21:27,070 --> 00:21:30,850
هي أنّني لستُ كذلك

330
00:21:35,100 --> 00:21:37,000
حسناً إذاً. الوداع

331
00:21:37,590 --> 00:21:38,880
تصبحين على خير

332
00:21:40,490 --> 00:21:43,520
...منذ زمن بعيد، قال تانوكيّ كبير وحكيم

333
00:21:44,390 --> 00:21:48,340
"من السيّئ أن يتورّط تانوكي بخِلافات التينغو"

334
00:21:48,980 --> 00:21:53,000
"وتورُّط التينغو بخِلافات التانوكي ليس صائباً أيضاً"

335
00:21:54,540 --> 00:21:58,960
لا أحبُّ هذه المقولة

336
00:23:30,910 --> 00:23:33,010
النّاس الذين يلعبون الشوغي رائعون

337
00:23:33,470 --> 00:23:34,010
ماذا؟

338
00:23:34,010 --> 00:23:35,100
ألا تعرفين اللّعبة؟

339
00:23:35,490 --> 00:23:36,880
!لنلعب إذاً

340
00:23:36,880 --> 00:23:38,110
!إنّها ممتعة

341
00:23:38,110 --> 00:23:39,940
!ستكون ممتعة بلا شكّ