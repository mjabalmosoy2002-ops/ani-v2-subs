1
00:00:02,970 --> 00:00:08,350
أتساءل ما إن كان ذلك الشيء سيُشعر بالحنين
عندما أعود إلى كيوتو

2
00:00:08,920 --> 00:00:10,320
!ياجيرو-نيتشان

3
00:00:11,440 --> 00:00:13,650
آسف لتأخّرنا يا ياجيرو

4
00:00:13,650 --> 00:00:16,220
لم أستطع إيجاد أمّي

5
00:00:16,220 --> 00:00:17,530
لا بأس

6
00:00:17,880 --> 00:00:21,310
ماذا لو حاولت أمّي منعي من الذهاب؟

7
00:00:21,310 --> 00:00:23,290
ما كنتُ لأستطيع المغادرة

8
00:00:23,600 --> 00:00:26,250
حسناً، قد تكون على حقّ

9
00:00:26,250 --> 00:00:30,170
لا بدّ وأنّ أمّك لا تحبّ وداع الناس

10
00:00:31,110 --> 00:00:34,450
ياجيرو-نيتشان، هل تحمل دواءك؟

11
00:00:34,450 --> 00:00:37,640
أجل، إنّه معي هنا

12
00:00:38,110 --> 00:00:40,240
لا تنسَ تناوله

13
00:00:40,240 --> 00:00:42,050
ستتحوّل إلى ضفدع مجدّداً

14
00:00:42,050 --> 00:00:44,600
حسناً، إلى أين أنت ذاهب أولاً؟

15
00:00:45,020 --> 00:00:46,500
...في الحقيقة

16
00:00:47,010 --> 00:00:52,010
أولاً، أظنّني سأذهب لزيارة التانوكي
الذي يعيش في نبع كوماتشي السّاخن في كوراشيكي

17
00:00:52,400 --> 00:00:56,860
أنوي التفكير بالباقي أثناء خوض رحلتي

18
00:00:56,860 --> 00:01:01,070
طلب أخي أن تزور عائلتنا الفرعيّة

19
00:01:01,490 --> 00:01:03,300
أشكرك وبكلّ تواضع

20
00:01:03,300 --> 00:01:05,870
،إن حدثَ وذهبتَ إلى شيكوكو

21
00:01:05,870 --> 00:01:08,330
احرص على إلقاء التحيّة على عشيرة كينتشو

22
00:01:08,580 --> 00:01:09,710
عُلِم

23
00:01:14,270 --> 00:01:15,670
والآن أصبحتَ جاهزاً

24
00:01:15,670 --> 00:01:18,600
أنا متأكّدة ستكون رحلة عظيمة يا ياجيرو-كن

25
00:01:19,150 --> 00:01:20,370
شكراً

26
00:01:20,810 --> 00:01:24,640
ربّما ستصبحين أختي الكبيرة رسميّاً
عندما أعود يا غيوكوران

27
00:01:25,120 --> 00:01:28,900
لِمَ عليك ذكر ذلك الآن؟

28
00:01:30,300 --> 00:01:33,480
شكراً لوداعي اللّائق بهذا الشكل

29
00:01:34,910 --> 00:01:38,000
أنا شيموغامو ياجيرو، أنوي
العودة كرجُل أكبر حتّى

30
00:01:38,000 --> 00:01:41,870
عندما تنتهي رحلتي هذه

31
00:01:42,430 --> 00:01:44,820
بالتوفيق

32
00:01:45,120 --> 00:01:47,600
يمكنك العودة متى شئت

33
00:01:47,600 --> 00:01:48,860
سينتظرك الجميع

34
00:01:48,860 --> 00:01:50,270
أجل، سننتظرك

35
00:01:50,270 --> 00:01:52,130
احرص على شراء هدايا لنا

36
00:01:52,630 --> 00:01:55,970
ني-سان، احرص على العودة

37
00:01:57,620 --> 00:02:00,620
أصبح لديّ وطناً أعود إليه الآن

38
00:02:00,620 --> 00:02:03,410
لذا سأعود مهما كلّف الأمر

39
00:02:23,590 --> 00:02:26,290
أتساءل ما إن ظنّ أنّني أمّ سيّئة

40
00:02:26,290 --> 00:02:28,880
لأنّني لم أودّعه

41
00:02:29,670 --> 00:02:33,720
لكن لم أكن واثقة أنّني سأتمكّن من تركه يرحل

42
00:02:34,200 --> 00:02:37,160
،فلو التقت عيوننا، وحاولتُ منعه من الذهاب

43
00:02:37,160 --> 00:02:39,560
فقد لا يتمكّن من المغادرة على الأرجح

44
00:02:41,750 --> 00:02:44,650
غادر ني-سان بآمال كبيرة

45
00:02:45,190 --> 00:02:47,160
أنا متأكّد أنّها ستكون رحلة عظيمة

46
00:02:48,760 --> 00:02:51,330
أجل، معك حقّ

47
00:02:52,070 --> 00:02:55,100
هذا شيء قرّرتموه جميعاً بأنفسكم

48
00:02:55,100 --> 00:02:57,730
أنا متأكّدة أنّ سو-سان كان ليسمح بذلك أيضاً

49
00:04:36,860 --> 00:04:40,290
أسبّب المشاكل دوماً

50
00:04:40,290 --> 00:04:43,510
الكثير من المشاكل

51
00:04:43,510 --> 00:04:46,690
سوف أزعزع السّلام دوماً

52
00:04:46,690 --> 00:04:49,990
أزعزع السّلام دوماً

53
00:04:49,990 --> 00:04:51,120
ياسابورو

54
00:04:52,060 --> 00:04:53,620
تعال إلى هنا لحظة

55
00:04:54,680 --> 00:04:56,360
يرفض أكاداما-سينسي قطعاً

56
00:04:56,360 --> 00:05:01,860
أن يكون مراقباً على انتخابات أستاذ الخداع

57
00:05:02,260 --> 00:05:05,950
...قال أنّه كان سيعيّن تينغو آخر في المنصب، لكن

58
00:05:06,150 --> 00:05:08,370
أنا متأكّد أنّها ستكون بينتين-ساما

59
00:05:08,370 --> 00:05:11,170
لكن هذا قاسٍ جدّاً

60
00:05:11,170 --> 00:05:13,570
يقترح أن يكون الشّخص الذي ينبغي أن نرحّب
به ليكون مسؤولاً

61
00:05:13,570 --> 00:05:17,490
عن اختيار رئيس المجتمع التانوكي هو البشريّ
الذي وضع أبي في قدرٍ بخاريّ وأكله؟

62
00:05:17,490 --> 00:05:20,790
ألا نستطيع فعل هذا من دون أي تينغو؟

63
00:05:21,030 --> 00:05:22,410
هذا غير وارد

64
00:05:22,410 --> 00:05:24,110
نفوذ أستاذ الخداع يعتمد

65
00:05:24,110 --> 00:05:27,890
على رأي عالم التانوكيّين العامّ
وموافقة التينغو العظيم

66
00:05:28,100 --> 00:05:30,080
،إن ألغينا هذه العمليّة في النّهاية

67
00:05:30,080 --> 00:05:33,470
فسيكون أستاذ الخداع تحت رحمة
الموافقة على كلّ شيء

68
00:05:33,790 --> 00:05:35,130
يا إلهي

69
00:05:35,130 --> 00:05:37,490
أظنّنا لا نملك خياراً

70
00:05:40,550 --> 00:05:42,930
ها هو ذا

71
00:05:42,930 --> 00:05:44,940
جاء ياسابورو

72
00:05:45,600 --> 00:05:47,590
آسف بشأن هذا يا ياسابورو

73
00:05:47,980 --> 00:05:51,340
لكن نريد أن نطلب مساعدتك بما أنّك خبير تينغو

74
00:05:51,340 --> 00:05:54,910
تحرجني مجدّداً بكلامك يا ياساكا-سان

75
00:05:55,560 --> 00:05:58,420
لقد وصل شيموغامو ياسابورو

76
00:05:58,720 --> 00:06:00,850
لماذا أتيت؟

77
00:06:00,850 --> 00:06:02,170
لم أستدعك

78
00:06:02,170 --> 00:06:06,220
أرى أنّك تضايق وتزعج التانوكيّين ثانية

79
00:06:06,570 --> 00:06:08,870
أظنّني ينبغي ألّا أتوقّع أقلّ من ذلك
،من التينغو وأيّما تينغو

80
00:06:08,870 --> 00:06:11,710
العظيم نيويغاتاكي ياكوشيبو

81
00:06:11,710 --> 00:06:15,220
أتى ياساكا هيتارو باكياً إليّ

82
00:06:15,220 --> 00:06:19,590
أنا متأكّد أن هذا مخطّط ما لإخراجي من هنا

83
00:06:19,590 --> 00:06:21,860
كشفتنا إذاً

84
00:06:22,190 --> 00:06:22,770
أحمق

85
00:06:23,620 --> 00:06:26,480
سأعيّن بينتين لتكون المُراقبة

86
00:06:27,020 --> 00:06:28,990
نهاية القصّة

87
00:06:39,710 --> 00:06:43,310
وهكذا ينتهي يوم مملّ آخر

88
00:06:44,370 --> 00:06:46,970
لِمَ لا تشعل الإنارة؟

89
00:06:46,970 --> 00:06:50,450
ولِمَ أفعل شيئاً كهذا؟

90
00:06:50,450 --> 00:06:51,920
أشعلها عنّي

91
00:06:51,920 --> 00:06:53,070
لا

92
00:06:53,680 --> 00:06:54,890
افعل هذا بنفسك رجاء

93
00:06:59,530 --> 00:07:05,020
لماذا تريد أن تجعل بينتين-ساما المُراقبة
يا أكاداما-سينسي؟

94
00:07:07,780 --> 00:07:12,080
هل تحاول أن تخلق أمراً واقعاً

95
00:07:12,080 --> 00:07:15,620
بتعيين بينتين-ساما قسريّاً خليفةً لك؟

96
00:07:21,110 --> 00:07:23,630
أعتقد أنّني مكثتُ هنا فترة أطول من اللّازم

97
00:07:24,090 --> 00:07:26,860
سأغادر الآن

98
00:07:39,160 --> 00:07:40,980
كيف سارت الأمور؟

99
00:07:40,980 --> 00:07:42,980
نفدت أفكاري

100
00:07:42,980 --> 00:07:45,900
ماذا ينبغي أن نفعل يا ياساكا-سان؟

101
00:07:45,900 --> 00:07:47,050
هذا سيّئ

102
00:07:47,050 --> 00:07:48,710
غير جيّد على الإطلاق

103
00:07:49,160 --> 00:07:51,760
ماذا يجدر بنا أن نفعل يا يايتشيرو-كن؟

104
00:07:51,760 --> 00:07:53,720
بالفعل ماذا يجدر بنا أن نفعل

105
00:07:55,390 --> 00:07:57,160
لديّ فكرة سديدة

106
00:07:57,160 --> 00:07:59,300
أنا متأكّد أنّها فكرة فظيعة

107
00:07:59,300 --> 00:08:01,670
ينبغي أن نطلب المساعدة من النيدايمي

108
00:08:01,670 --> 00:08:05,280
إذا تدخّل النيدايمي فلن تتمكّن بينتين-ساما
من فعل أي شيء

109
00:08:05,280 --> 00:08:07,880
...معك حقّ، لكن

110
00:08:08,150 --> 00:08:10,750
لا أدري ما إن كان النيدايمي سيوافق

111
00:08:10,750 --> 00:08:12,760
ليس لدينا ما نخسره هنا

112
00:08:13,160 --> 00:08:14,670
معك حقّ

113
00:08:14,670 --> 00:08:17,120
سيكون عظيماً أن ينجح هذا الأمر

114
00:08:17,120 --> 00:08:17,890
لحظة واحدة

115
00:08:18,240 --> 00:08:20,860
لا أقبل بهذا

116
00:08:20,860 --> 00:08:22,760
ولماذا؟

117
00:08:22,760 --> 00:08:27,040
النزاع على من ينبغي أن يكون الخليفة
التالية ينبغي أن يبقى ضمن إطار التينغو

118
00:08:27,040 --> 00:08:31,620
يجدر بنا تجنُّب التورّط في شجارات بين
التينغو مهما كلّف الأمر

119
00:08:33,040 --> 00:08:35,440
،إن طلبنا من النيدايمي المساعدة في ظرفٍ كهذا

120
00:08:35,440 --> 00:08:40,030
فلا نعلم كم سيغضب أكاداما-سينسي وبينتين-ساما

121
00:08:40,030 --> 00:08:43,220
يمكنكم أن تقولوا أنّها كانت فكرتي فحسب

122
00:08:43,220 --> 00:08:44,330
سأتحمّل مسؤوليّتها

123
00:08:45,150 --> 00:08:47,210
هل أنت جادّ؟

124
00:08:47,210 --> 00:08:50,630
الأمر الممتع هو شيء جيّد يا يايتشيرو

125
00:08:51,040 --> 00:08:52,340
دع هذا الأمر لي

126
00:08:54,550 --> 00:08:55,750
موافق

127
00:08:55,750 --> 00:08:58,490
لندع هذا الأمر على ياسابورو

128
00:08:58,490 --> 00:09:00,850
لديك أخٌ جيّد يا يايتشيرو-كن

129
00:09:01,840 --> 00:09:04,850
ما الأمر يا يايتشيرو؟ ابتهج

130
00:09:04,850 --> 00:09:06,650
الأمور على وشك أن تصبح ممتعة

131
00:09:07,430 --> 00:09:09,430
جيّد، جيّد

132
00:09:17,780 --> 00:09:20,620
لقد وصل شيموغامو ياسابورو

133
00:09:21,540 --> 00:09:22,580
مرحباً

134
00:09:25,130 --> 00:09:27,620
اسمي شيموغامو يايتشيرو

135
00:09:29,400 --> 00:09:32,340
حسناً، بماذا يمكنني خدمتكما اليوم؟

136
00:09:32,340 --> 00:09:35,000
لا شيء على وجه الخصوص

137
00:09:35,000 --> 00:09:36,970
بالأحرى، لديّ تقرير وضع

138
00:09:37,570 --> 00:09:38,770
تفضّلا بالجلوس

139
00:09:39,710 --> 00:09:43,250
أولاً، لديّ بعض المعلومات عن بندقيّتك

140
00:09:43,250 --> 00:09:44,810
هل وجدتها؟

141
00:09:45,020 --> 00:09:45,820
أجل

142
00:09:45,820 --> 00:09:48,750
كانت مع شخص يدعى تينمايا

143
00:09:48,750 --> 00:09:54,650
إضافة إلى ذلك، البندقيّة قد استُخدِمَتْ لزهق
روح إيبيسوغاوا سون في نبع آريما السّاخن

144
00:09:55,150 --> 00:09:58,530
لا أحبّ أن تُستخدَم قطعة فنّية لقتل تانوكيّ

145
00:09:58,910 --> 00:10:02,360
،لقد اختفى تينمايا منذ تلك اللّيلة

146
00:10:02,360 --> 00:10:05,370
ولم تسنح لي فرصة لمحاولة استعادة البندقيّة

147
00:10:05,370 --> 00:10:08,860
هذه غلطتي أنا

148
00:10:09,250 --> 00:10:12,310
يؤسفني القول أنّني لا أملك طريقة لتعويضك

149
00:10:12,310 --> 00:10:14,010
عمّاذا تتكلّم؟

150
00:10:14,410 --> 00:10:16,720
لقد فعلتَ ما يكفي لأجلي

151
00:10:17,230 --> 00:10:20,600
تمكّنتُ من استعادةِ أثاثي بفضلِك كذلك

152
00:10:21,160 --> 00:10:22,890
أنا مدينٌ لك

153
00:10:25,470 --> 00:10:28,850
هل أنت مهتمٌّ إلى هذا الحدّ
بما تدينه لتانوكيّ؟

154
00:10:29,230 --> 00:10:32,520
سأكون ممتنّاً إن قبلتَ بدُفعة
كتعبير عن شكري

155
00:10:32,830 --> 00:10:36,350
حتّى لو وضعنا حالة البندقيّة
،الألمانيّة جانباً

156
00:10:36,350 --> 00:10:38,110
هل سيبقى دَيناً حقّاً؟

157
00:10:38,650 --> 00:10:39,720
مهلاً مهلاً

158
00:10:39,720 --> 00:10:42,400
بدأتُ أشعر بنتانةِ التانوكيّين هنا

159
00:10:42,800 --> 00:10:45,060
لا أدري إلى أين ستؤدّي هذه المحادثة

160
00:10:45,520 --> 00:10:46,950
لِمَ لا تدخل صلبَ الموضوع مباشرة؟

161
00:10:47,610 --> 00:10:49,620
،أستميحك عذراً

162
00:10:49,620 --> 00:10:54,380
لكن هلّا طلبنا منك أن تكون المُراقب
في انتخابات أستاذ الخداع المقبلة؟

163
00:10:55,080 --> 00:10:57,080
لِمَ لا تطلبان من الرّجل

164
00:10:57,080 --> 00:10:59,940
الذي بالكاد يُسمَّى تينغو

165
00:10:59,940 --> 00:11:04,390
ويعيش حياة التقشّف في ديماتشياناغي
أن يلبّي طلبكما هذا؟

166
00:11:04,670 --> 00:11:07,890
في الواقع... سأكون صريحاً حول الأمر

167
00:11:07,890 --> 00:11:11,440
،لقد طلبنا من أكاداما-سينسي بالفعل

168
00:11:11,440 --> 00:11:13,880
لكنّه عيّن بينتين-ساما

169
00:11:14,280 --> 00:11:18,350
إنّها عضو في نادي يوم الجمعة
الذي يأكل قدور التانوكيّين البخاريّة

170
00:11:18,350 --> 00:11:20,300
ليسَتْ ملائمة لتكون المُراقِبة

171
00:11:20,760 --> 00:11:25,360
لهذا نودّ منك أن تكون المُراقِب بدلاً من ذلك

172
00:11:25,360 --> 00:11:28,200
هل تطلب منّي أن أصبح تينغو؟

173
00:11:28,200 --> 00:11:29,290
لا

174
00:11:29,290 --> 00:11:32,620
نطلب منك أن تصبح المُراقب

175
00:11:33,000 --> 00:11:35,540
لكن المُراقب هو دور تينغو

176
00:11:35,760 --> 00:11:41,380
،هذا ما تراه المُجتمعات التانوكيّة والتينغو

177
00:11:41,380 --> 00:11:45,130
لكن لا يوجد سبب للالتزام بمثل هذه التقاليد القديمة

178
00:11:45,130 --> 00:11:48,850
نرغب أن تكون المُراقِب بصِفتك النيدايمي

179
00:11:48,850 --> 00:11:50,350
هذا كُل ما في الأمر

180
00:11:51,850 --> 00:11:53,300
...النيدايمي إذاً

181
00:11:53,850 --> 00:11:56,330
لأصدقك القول، لطالما كان حلم
أخي الكبير هنا

182
00:11:56,330 --> 00:12:00,820
أن يحذو حذوّ أبينا الرّاحل
ويصبح أستاذ الخداع

183
00:12:00,820 --> 00:12:05,620
بصِفتي أخوه الأصغر، أودّ فعل أي شيء
لتحقيق هذا الحلم

184
00:12:05,620 --> 00:12:06,320
...مهلاً

185
00:12:06,320 --> 00:12:07,650
هكذا إذاً

186
00:12:08,190 --> 00:12:10,410
...تحذو حذوّ والدك

187
00:12:11,350 --> 00:12:13,820
تريد إذاً سلوك نفس الطريق الذي سلكه؟

188
00:12:14,350 --> 00:12:15,330
أجل

189
00:12:15,330 --> 00:12:18,060
لم أكن أبحث عن شيء سوى طريقاً
مختلفاً لنفسي

190
00:12:18,820 --> 00:12:22,320
بعبارة أخرى، لا أنوي أن أصبح
تينغو أو أحذو حذوّه

191
00:12:22,320 --> 00:12:23,300
...و

192
00:12:23,530 --> 00:12:27,270
لا أريد أن أضطرّ لتنظيف فوضى
ذلك الأحمق العجوز الخرف

193
00:12:27,270 --> 00:12:30,360
هكذا إذاً. هذه مشكلة في الواقع

194
00:12:30,360 --> 00:12:33,310
عليّ أن أبقى حذراً أمامكما

195
00:12:34,780 --> 00:12:37,440
لستُ مذهلاً إلى هذه الدرجة

196
00:12:37,440 --> 00:12:40,820
كنتَ تتجسّس عليّ قبل أيّام
في كيوميزو-ديرا، أليس كذلك؟

197
00:12:40,820 --> 00:12:41,770
!يتجسّس؟

198
00:12:41,770 --> 00:12:46,220
عرفت؟ لكن لم أقصد الإساءة

199
00:12:46,220 --> 00:12:49,200
كنتُ فضوليّاً فحسب

200
00:12:49,440 --> 00:12:51,590
هل عيّنك ذلك العجوز لفعل ذلك؟

201
00:12:51,590 --> 00:12:55,080
أفضّل ألّا أعلّق على هذا

202
00:12:55,710 --> 00:12:59,630
...أن يدع قاصراً تانوكيّاً يتعقّب حبيبته

203
00:12:59,630 --> 00:13:01,510
الأمر سخيف جدّاً لدرجة يعجز لساني عن الكلام

204
00:13:01,510 --> 00:13:03,120
هذا أكبر مثال عن التدهور النّاجم عن الشيخوخة

205
00:13:03,720 --> 00:13:07,620
من المستحيل أن يحدث الخطأ الذي يقلق
العجوز بشأنه

206
00:13:07,620 --> 00:13:11,850
وحقيقة أنّه يفترض ذلك حتّى مُهينة للغاية

207
00:13:12,390 --> 00:13:16,580
لا بدّ وأنّك تكره بينتين-ساما كثيراً

208
00:13:16,580 --> 00:13:20,200
لا أكرهها، بل أبغضها

209
00:13:21,370 --> 00:13:24,950
سبقَ والتقيتُ بها مرّة في إنجلترا

210
00:13:25,950 --> 00:13:30,660
رغم بغضك لها، إلّا أنّك لطيف
جدّاً مع بينتين-ساما

211
00:13:30,660 --> 00:13:33,040
عمّاذا تتكلّم؟

212
00:13:33,360 --> 00:13:35,250
لا ألاطفها إطلاقاً

213
00:13:35,740 --> 00:13:39,800
لكنّك كنتَ ودوداً جدّاً معها آنذاك

214
00:13:40,130 --> 00:13:43,800
هراء! أنت مخطئ تماماً يا صديقي

215
00:13:44,240 --> 00:13:45,840
أشكّ في ذلك

216
00:13:45,840 --> 00:13:49,180
كنتُ أقول لنفسي فقط أنّها غير ملائمة
لتكون تينغو

217
00:13:49,670 --> 00:13:52,440
في هذه الحالة، ستصبح بينتين-ساما

218
00:13:52,440 --> 00:13:56,090
نيويغاتاكي ياكوشيبو الثّانية

219
00:13:56,090 --> 00:13:58,230
هل شيء كهذا مسموح؟

220
00:13:58,230 --> 00:14:03,020
لا نملك خياراً آخر سوى الاعتماد
عليك في إيقافِ بينتين-ساما

221
00:14:03,520 --> 00:14:07,420
أرجوك أن تساعدنا نحن التانوكيّين

222
00:14:07,420 --> 00:14:09,740
أتوسّل إليك وبكلّ تواضع

223
00:14:10,150 --> 00:14:12,950
من فضلكما كفّا عن استخدام هذه الطرق الخرقاء

224
00:14:12,950 --> 00:14:15,750
لن نكفّ حتّى تقبل

225
00:14:18,160 --> 00:14:20,040
حسناً، موافق

226
00:14:20,560 --> 00:14:22,500
قولوا لزملائكم التانوكيّين

227
00:14:22,940 --> 00:14:25,220
أنّني سأؤدّي دور المراقب

228
00:14:31,490 --> 00:14:33,260
شكراً جزيلاً لك

229
00:14:33,260 --> 00:14:36,390
نحن متعادلان الآن يا ياسابورو-كن

230
00:15:18,040 --> 00:15:21,970
من الخطر عليكِ أن تقفي هناك يا آنسة

231
00:15:23,440 --> 00:15:24,930
،أنا بخير

232
00:15:26,520 --> 00:15:28,140
لهذا أطلب منك أن تتركني لوحدي

233
00:15:49,800 --> 00:15:52,920
أنا متفاجئ من قدرتك على إكمال
وجبتين يا يايتشيرو

234
00:15:53,310 --> 00:15:57,040
يجب أن يحصل أستاذ الخداع
على الكثير من الطاقة

235
00:15:57,040 --> 00:16:00,600
لن أتمكّن من الصمود معتمداً
على مشروب الطاقة فقط

236
00:16:00,600 --> 00:16:03,940
لا بدّ من تناول طعامٍ مغذٍّ بانتظام

237
00:16:04,270 --> 00:16:07,320
من الجيّد أكل كثير من الطعام اللّذيذ

238
00:16:07,880 --> 00:16:09,940
...لكن

239
00:16:09,940 --> 00:16:13,040
شريحة الهامبرغر هذه تبدو كتانوكيّ

240
00:16:13,040 --> 00:16:16,510
لا تقولي كلاماً فظيعاً كهذا من فضلكِ يا أمّي

241
00:16:22,840 --> 00:16:24,880
أنتما هادئان على غير العادة

242
00:16:25,310 --> 00:16:27,460
مرحباً بك يا ياسابورو-دونو

243
00:16:27,460 --> 00:16:32,220
أنا واثق أنّ هيسويشي-ساما مسرور
جدّاً بالطقس الصّحو

244
00:16:32,220 --> 00:16:34,360
إنّه رائع

245
00:16:34,360 --> 00:16:36,250
رائع بالفعل

246
00:16:36,250 --> 00:16:37,180
نامو، نامو

247
00:16:37,720 --> 00:16:41,640
هل أكلتما شيئاً غريباً؟

248
00:16:41,640 --> 00:16:43,090
ماذا تقول؟

249
00:16:43,090 --> 00:16:46,010
نسعى جاهدين كي لا نكون حمقاوين بعد الآن

250
00:16:46,010 --> 00:16:48,330
لهذا كنّا نتلقّى دروساً من أخينا كوريتشيرو

251
00:16:48,330 --> 00:16:51,650
ونتدرّب ليلاً نهاراً

252
00:16:51,650 --> 00:16:55,620
أنا وأخي الكبير أصبحنا عذبَين ككعك

253
00:16:55,620 --> 00:16:57,480
مبخَّر منفوش وطريّ وبارد

254
00:16:57,480 --> 00:17:00,460
نوصيك بسلوك طريق بوذا كذلك يا ياسابورو-دونو

255
00:17:00,460 --> 00:17:03,660
لقد ولّى عصر الحمقى

256
00:17:04,560 --> 00:17:06,500
هكذا إذاً. أتمنّى لكما حظّاً طيّباً

257
00:17:06,500 --> 00:17:07,630
أشجّعكما

258
00:17:08,320 --> 00:17:09,260
أغلقوا البوّابة

259
00:17:12,250 --> 00:17:14,320
اهدأوا من فضلكم

260
00:17:15,030 --> 00:17:17,390
سنبدأ الآن باجتماعنا

261
00:17:17,640 --> 00:17:19,250
،لكن قبل أن نتابع

262
00:17:19,250 --> 00:17:23,620
تلقّينا وبكلّ امتنان كلامَ هيسويشي-ساما

263
00:17:24,050 --> 00:17:28,510
سأقرأه الآن لذا أطلب منكم الانتباه

264
00:17:32,660 --> 00:17:37,240
عندما تصابون بالرشح، دفّئوا أقدامكم ورطّبوا رأسكم"

265
00:17:37,240 --> 00:17:39,000
حينئذ لن تحتاجوا لطبيب

266
00:17:39,000 --> 00:17:42,830
شرب ماء دافئ مع العسل
"والزنجبيل هو أمر رائع جدّاً أيضاً

267
00:17:43,440 --> 00:17:44,660
هذا كلّ شيء

268
00:17:50,280 --> 00:17:54,550
والآن، يايتشيرو-كن، مرشّحنا ليكون أستاذ الخداع

269
00:17:54,550 --> 00:17:57,890
هو تانوكيّ واعد جدّاً للجيل المقبل

270
00:17:57,890 --> 00:17:59,540
!يحيا! أملنا الجديد

271
00:17:59,540 --> 00:18:00,550
!نيدايمي

272
00:18:00,550 --> 00:18:04,520
إضافة إلى ذلك، كوريتشيرو-كن، الذي سيلقي
خطابَاً دعماً لمرشّحنا

273
00:18:04,790 --> 00:18:08,760
هو تانوكيّ واعد آخر للجيلِ الجديد، بينما
يقود عشيرة الإيبيسوغاوا

274
00:18:08,760 --> 00:18:11,590
بعد رحيل والده، إيبيسوغاوا سون-كن

275
00:18:12,090 --> 00:18:15,940
حسناً إذاً، لو سمحت يا كوريتشيرو-كن

276
00:18:18,210 --> 00:18:22,660
أنا الابن الأكبر لإيبيسوغاوا سون، إيبيسوغاوا كوريتشيرو

277
00:18:22,920 --> 00:18:28,280
بالرّغم من إيصالِ أبي لمصنع دينكي
بران الخداع إلى العصرِ الحديث

278
00:18:28,280 --> 00:18:32,670
إلّا أنّ أفعاله البائسة لاحقاً
في الحياة لا يُمكِن أن تُنسَى

279
00:18:33,040 --> 00:18:38,260
إضافة إلى تلك المسألة، عرض يايتشيرو-كن
العفو والصّفح

280
00:18:38,260 --> 00:18:40,550
وطلب أن نعيش بسلام معاً

281
00:18:41,010 --> 00:18:44,650
ستدعم عائلةُ إيبيسوغاوا أستاذَ الخِداع الجديد

282
00:18:44,650 --> 00:18:48,890
سنبذل قصارى جهدنا لرسم
مستقبل مشرق لعالم التانوكيّين

283
00:18:51,470 --> 00:18:53,220
شكراً لك يا كوريتشيرو

284
00:18:53,220 --> 00:18:54,370
شكراً لك

285
00:18:54,370 --> 00:18:56,060
!يحيا! الجيل الجديد

286
00:18:56,060 --> 00:18:58,070
!القرن 21

287
00:18:58,070 --> 00:19:01,440
سيعقد الشيوخ اجتماعهم

288
00:19:01,440 --> 00:19:05,060
في ليلة 26 ديسمبر لمتابعة النقاش حول هذا الأمر

289
00:19:05,060 --> 00:19:07,530
فيما يلي، لدينا إعلان آخر

290
00:19:08,080 --> 00:19:12,260
لقد تقرّر أن يملأ النيدايمي دورَ المُراقب

291
00:19:12,260 --> 00:19:14,110
،والذي سيختار أستاذَ الخداع

292
00:19:14,110 --> 00:19:17,810
.رئيس مُجتمع التانوكيّين

293
00:19:18,210 --> 00:19:20,300
أشكّ في وجود أي اعتراض

294
00:19:20,300 --> 00:19:21,660
أعترض

295
00:19:28,220 --> 00:19:31,350
!لـ-لقد وصلت بينتين-ساما

296
00:19:35,440 --> 00:19:40,470
لقد أُمِرتُ بواسطة المعلّم أن أكون
،مُراقِبة انتخابات التانوكيّين

297
00:19:41,010 --> 00:19:43,240
لكن يبدو أنّه غير مُرحَّب بي هنا

298
00:19:43,660 --> 00:19:46,050
حقّاً؟

299
00:19:46,050 --> 00:19:48,750
يبدو أنّه حدثَ سوء فهم ما

300
00:19:48,930 --> 00:19:53,500
لكن لا أمانع أن يحلّ مكاني ذلك
البريطانيّ الحالم إن أراد

301
00:19:53,790 --> 00:19:55,500
أشكركِ على تفهّمكِ

302
00:19:55,690 --> 00:20:01,380
لكن أودّ أن أعرف كيف لمثل
سوء فهم كهذا أن يحدث

303
00:20:01,690 --> 00:20:06,220
أتساءل ما إن كنتُم أيّها التانوكيّين لا تحبّون
فكرة أن أصبح المراقبة

304
00:20:06,410 --> 00:20:09,390
لا، لا شيء من هذا القبيل

305
00:20:09,390 --> 00:20:10,460
لا بأس

306
00:20:10,460 --> 00:20:13,920
فأساساً، أنا امرأة تأكل قدور
التانوكيّين البخاريّة

307
00:20:13,920 --> 00:20:16,770
أتفهّم شعوركم أنتم التانوكيّين

308
00:20:17,270 --> 00:20:20,240
لكن بالرّغم من فهم شعوركم، سآكلكم على أي حال

309
00:20:20,240 --> 00:20:22,620
فأنا بشريّة

310
00:20:23,070 --> 00:20:26,030
أستطيع أن أعدّ قدورَ تانوكيّين بخاريّة
منكم قدرَ ما أشاء

311
00:20:37,040 --> 00:20:38,090
يا للهول

312
00:20:38,400 --> 00:20:42,500
لم أكن أعلم أنّك كنتَ تختبئ هناك يا ياسابورو

313
00:20:43,610 --> 00:20:46,200
أنا متأكّدة أنّ هذا من صنيعك أنت

314
00:20:46,200 --> 00:20:48,470
أنا متفاجئة من قدرتك على إقناعه

315
00:20:48,710 --> 00:20:51,920
لا أملك أدنى فكرة عمّا تتحدّثين عنه

316
00:20:51,920 --> 00:20:52,900
أنت تكذب

317
00:20:52,900 --> 00:20:54,980
أنا كذلك بالفعل. أنا آسفٌ جدّاً

318
00:20:55,190 --> 00:20:56,690
يا لك من تانوكيّ أحمق

319
00:20:56,900 --> 00:21:00,940
تعرفينني خير معرفة يا بينتين-ساما

320
00:21:01,500 --> 00:21:05,680
دماء الحمقى الذي يجري في عروقي
يجعلني أفعل أشياء غريبة

321
00:21:05,680 --> 00:21:07,950
لستُ متأكّداً حتّى ممّا أفعله

322
00:21:08,160 --> 00:21:11,640
،أخونكِ وأخون أكاداما-سينسي

323
00:21:11,640 --> 00:21:13,420
...وأُرغِمُ النيدايمي

324
00:21:11,640 --> 00:21:14,040
أكره ذاك الرّجل

325
00:21:14,910 --> 00:21:19,290
النيدايمي قال أنّه يكرهكِ أيضاً يا بينتين-ساما

326
00:21:19,290 --> 00:21:21,040
وماذا عنك؟

327
00:21:21,040 --> 00:21:23,300
هل تحبّه أم تحبّني؟

328
00:21:23,620 --> 00:21:26,050
أحترمكما بشدّة بصفتكما تينغو

329
00:21:42,160 --> 00:21:46,550
احرص على افتعال بعض المشاكل"
وعلى إبقاء المتعة مستمرّة" هي كلمات جدّتي

330
00:21:47,020 --> 00:21:48,610
،متّبعاً هذه الكلمات

331
00:21:48,610 --> 00:21:51,920
"!أقول وبكلّ جرأة "دع الامر لي

332
00:21:52,490 --> 00:21:56,460
وهذه الاستراتيجيّة كانت مجازفة عظيمة

333
00:21:56,460 --> 00:21:58,950
بالنسبة لمجرّد تانوكيّ

334
00:23:30,760 --> 00:23:33,010
يبدو أنّه لا توجد أي ثعالب في شيكوكو

335
00:23:33,390 --> 00:23:36,180
يبدو أنّ كوبو دايشي طردهم جميعاً أو ما شابه

336
00:23:36,520 --> 00:23:40,430
من هذا المنطلق، أتساءل كيف يُفترَض أن أخرج
من شيكوكو