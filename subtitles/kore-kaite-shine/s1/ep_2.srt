1
00:00:05,610 --> 00:00:10,100
لا بدّ أنّه كان هنالك الكثير من
.الأشخاص ينتظرون هذا الكتاب

2
00:00:13,340 --> 00:00:14,660
.أعتذر للجميع

3
00:00:14,660 --> 00:00:17,410
.لقد جمعتُ أغراضي لهذا اليوم

4
00:00:17,970 --> 00:00:19,400
!كلاّ يا سينسي

5
00:00:19,400 --> 00:00:22,340
!لقد أفسدتُ كوميتيا عليك بالكامل

6
00:00:22,850 --> 00:00:25,330
!أنا آسفة! أنا آسفة! أنا آسفة

7
00:00:27,030 --> 00:00:28,460
.ياسومي-سان

8
00:00:28,460 --> 00:00:31,350
.إنّ لكلّ شيء في هذا العالم أولويّاته

9
00:00:31,690 --> 00:00:33,870
.وأولويّاتي هي أن أكون معلّمة

10
00:00:33,870 --> 00:00:37,450
تعليم التّلاميذ مثلك له
.الأولويّة دائمًا في رأيي

11
00:00:37,450 --> 00:00:39,900
،وغنيّ عن القول أنّ واجبك كتلميذة

12
00:00:39,900 --> 00:00:42,610
!هو الاجتهاد في الدّراسة استعدادًا للمستقبل

13
00:00:42,610 --> 00:00:47,270
الذّهاب إلى طوكيو وحدك كأنّك
...هاربة من أجل مانغا رديئة

14
00:00:47,270 --> 00:00:49,280
!هو أمر غير مقبول بتاتًا

15
00:00:48,380 --> 00:00:49,280
.يراودني الفضول

16
00:00:50,110 --> 00:00:53,480
،توبّخني تيشيما-سينسي كعادتها دائمًا

17
00:00:53,480 --> 00:00:56,790
لكنّني أعلم أنّها هوشينو-سينسي
..."مؤلّفة مانغا "روبوتا وبوكوتا

18
00:00:59,790 --> 00:01:02,980
!طلباتك أوامر

19
00:01:02,980 --> 00:01:04,120
!سمعًا وطاعة

20
00:01:04,120 --> 00:01:06,570
.أنتِ مطيعة جدًّا اليوم

21
00:01:07,870 --> 00:01:11,650
!هـ-هذه هي من ألّفتني
!حاولي أن تسأليها عن كلّ ما تريدين

22
00:01:11,650 --> 00:01:13,460
!معك حقّ، معك حقّ

23
00:01:13,910 --> 00:01:17,660
ما الّذي يدفع رسّامة مانغا مثلك
للتّدريس في مدرسة ثانويّة؟

24
00:01:17,660 --> 00:01:19,170
.لا تعليق

25
00:01:19,170 --> 00:01:21,860
لماذا لم ترسمي أيّ مانغا منذ سنوات؟

26
00:01:21,860 --> 00:01:23,180
.لا تعليق

27
00:01:23,180 --> 00:01:25,290
لماذا نشرتِ كتاب "روبوتا وبوكوتا" جديد الآن؟

28
00:01:25,290 --> 00:01:26,820
.لا تعليق

29
00:01:26,820 --> 00:01:29,360
إذًا لا بأس أن يرسم المعلّمون المانغا؟

30
00:01:29,360 --> 00:01:29,910
!بلع

31
00:01:29,910 --> 00:01:31,910
!سينسي

32
00:01:31,910 --> 00:01:33,780
!أجيبيني

33
00:01:34,130 --> 00:01:35,450
!هذا كثير

34
00:01:38,240 --> 00:01:41,630
.ياسومي-سان، لديّ اقتراح

35
00:01:43,030 --> 00:01:48,590
،يبدو أنّك نادمةٌ على تصرّفاتك
.لذا لا داعي لمزيدٍ من التّوبيخ

36
00:01:49,330 --> 00:01:54,340
،لن أتّصل بوالديك بشأن هذا
فلماذا لا ننسى ما حدث؟

37
00:01:54,340 --> 00:01:57,380
.تحديق

38
00:01:59,560 --> 00:02:01,100
!طلباتك أوامر

39
00:02:01,100 --> 00:02:02,940
!سمعًا وطاعة

40
00:04:07,390 --> 00:04:10,640
.ياسومي، تبدين في حالة فظيعة

41
00:04:10,640 --> 00:04:14,130
.كان كتاب روبوبوكو الجديد رائعًا جدًّا

42
00:04:14,130 --> 00:04:16,400
إذًا لم تنامي بما يكفي؟

43
00:04:22,430 --> 00:04:25,160
.أنا متعبة جدًّا، لكنّني سعيدة

44
00:04:25,620 --> 00:04:26,850
...لكن

45
00:04:28,900 --> 00:04:32,350
كانت هذه مخطوطة
لم تُدرج في إصدار المجلّد؟

46
00:04:32,700 --> 00:04:36,220
إذًا لم ترسم شيئًا جديدًا لهذا العمل؟

47
00:04:36,650 --> 00:04:40,680
أتمنّى لو أستطيع قراءة المزيد
.من مانغا هوشينو-سينسي

48
00:04:42,340 --> 00:04:46,010
.ياسومين. صمياوح الثّور

49
00:04:46,010 --> 00:04:48,200
—هذه أنت يا أكافوكو. صباح

50
00:04:48,200 --> 00:04:50,430
!كيف كانت طوكيو؟

51
00:04:51,300 --> 00:04:53,460
!تيسي ماذا؟

52
00:04:53,460 --> 00:04:55,310
!صه! صه

53
00:04:55,930 --> 00:04:59,220
.لا أعتقد أنّها تريد أن يعرف النّاس بذلك

54
00:04:59,220 --> 00:05:00,900
.هذا مثير للاهتمام

55
00:05:00,900 --> 00:05:04,190
.ولكن، كان كوميتيا مذهلاً حقًّا

56
00:05:04,610 --> 00:05:07,220
.أريد أن أجرّب رسم مانغا خاصّة بي الآن

57
00:05:07,570 --> 00:05:12,520
لكن عندما طلبتُ من سينسي
.أن تُعلّمني، كان ردها قاطعًا بالرّفض

58
00:05:16,450 --> 00:05:19,490
.ستزداد الأيّام حرارة من الآن فصاعدًا فحسب

59
00:05:21,040 --> 00:05:23,490
،الصّيف في هذه الجزيرة حارّ جدًّا

60
00:05:23,490 --> 00:05:27,230
لكنّ والدي، ربّما لأنّه انتقل إلى هنا
،متلهّفًا للحياة الرّيفيّة

61
00:05:27,230 --> 00:05:29,910
.يرفض تشغيل المكيّف

62
00:05:29,910 --> 00:05:32,200
.والدك رجل جامح بالفعل

63
00:05:32,200 --> 00:05:34,070
.أما أنا فأراه شخصًا حقيرًا

64
00:05:35,560 --> 00:05:37,430
.سأجد حلاًّ

65
00:05:39,690 --> 00:05:42,560
تريدان تأسيس نادي مانغا؟

66
00:05:42,560 --> 00:05:45,840
.كنّا نأمل أن تكوني مشرفتنا يا تيسي

67
00:05:45,840 --> 00:05:46,990
—لماذا قد

68
00:05:46,990 --> 00:05:49,300
.مع وجود غرفة نادي مكيّفة

69
00:05:49,300 --> 00:05:51,040
أكافوكو-سان، هل تسمعينني؟

70
00:05:51,040 --> 00:05:55,080
أريد أيضًا أن تحتوي على آلة مشروبات
.غازيّة ووسائد وكمّيّة كبيرة من المانغا

71
00:05:55,080 --> 00:05:58,040
.أرى أنّك تُكثرين من الطّلبات بنظرات توسّل

72
00:05:59,710 --> 00:06:02,040
هل تعتقدان حقًّا أنّ هذا مقبول في المدرسة؟

73
00:06:02,520 --> 00:06:03,930
—لن أوافق أبدًا على

74
00:06:03,930 --> 00:06:08,420
تيسي، هل يُسمح لموظّفي الخدمة العامّة
المحلّيّين مثلكِ بامتلاك وظائف إضافيّة؟

75
00:06:09,650 --> 00:06:11,890
عمّ تتحدّثين يا أكافوكو؟

76
00:06:11,890 --> 00:06:14,080
.لن أتخلّى عن أحلامي

77
00:06:14,080 --> 00:06:15,750
.سأفعل كلّ ما يلزم لتحقيقه

78
00:06:19,790 --> 00:06:21,520
.بشرط واحد

79
00:06:22,560 --> 00:06:28,780
لن أقتنع بطلب إنشاء نادٍ من
.شخصٍ لم يحقّق أيّ إنجاز بعد

80
00:06:28,780 --> 00:06:31,450
حسنًا، فهمت. في نفس هذا الوقت
...من الأسبوع القادم

81
00:06:32,770 --> 00:06:35,580
تعالي واسأليني مجدّدًا ومعك
.مانغا رسمتها بنفسك

82
00:06:50,250 --> 00:06:53,310
...تطلب منّي رسم مانغا من العدم

83
00:07:00,890 --> 00:07:05,320
،لو كنت أعرف كيف أفعل ذلك
.لما طلبت منها تعليمي

84
00:07:25,840 --> 00:07:27,850
نانا-تشان، هل أنت متفرّغة؟

85
00:07:27,850 --> 00:07:30,400
.عجبًا، مرّ وقت طويل يا ري-تشان

86
00:07:32,580 --> 00:07:34,560
ألن تغلقي الباب؟

87
00:07:34,560 --> 00:07:37,710
.لن يقتحم أحد المكان في هذه الجزيرة

88
00:07:42,410 --> 00:07:44,350
هذا مفاجئ، فما الأمر؟

89
00:07:46,370 --> 00:07:48,650
.أفكّر في مغادرة الجزيرة

90
00:07:49,460 --> 00:07:51,410
.هذا مفاجئ بالفعل

91
00:07:53,060 --> 00:07:54,270
.اكتشفت إحدى التّلميذات الأمر

92
00:07:54,270 --> 00:07:56,320
ماذا؟

93
00:07:57,360 --> 00:07:59,670
.أتعرّض للابتزاز لتعليمها كيف ترسم المانغا

94
00:08:02,270 --> 00:08:03,340
!لا تضحكي

95
00:08:05,520 --> 00:08:09,010
.لقد كتبتُ استقالتي
.لا أريد أن أكون قدوة سيّئة

96
00:08:09,010 --> 00:08:11,880
.ملتزمة بالقواعد كالعادة

97
00:08:23,450 --> 00:08:24,620
.شكرًا لك

98
00:08:33,020 --> 00:08:36,440
هل ستعودين إلى طوكيو
لرسم المانغا مجدّدًا؟

99
00:08:41,250 --> 00:08:42,540
.لا، لن أفعل ذلك

100
00:08:43,140 --> 00:08:45,300
.انطفأت حمم شغفي سلفًا

101
00:08:51,580 --> 00:08:55,660
.لطالما شعرتُ بغضبٍ عارمٍ في داخلي

102
00:08:57,380 --> 00:09:03,110
كنتُ أتوقُ دائمًا لانفجار هذه
.الحمم، لكنّ ذلك لم يحدث

103
00:09:04,220 --> 00:09:08,780
أشعل عمل والدي في مجال
.النّشر حبّي للمانغا

104
00:09:11,460 --> 00:09:16,290
،لم يكن لديّ الكثير من الأصدقاء
.لكنّ دورايمون كان سندي

105
00:09:18,280 --> 00:09:22,170
بدأتُ رسم المانغا
،في سنتي الجامعيّة الثّالثة

106
00:09:22,170 --> 00:09:25,630
بينما بدأ احتمال البحث عن وظيفة
.يلوح في الأفق بشكل متزايد

107
00:09:26,890 --> 00:09:30,770
،بما أنّ مانغا إلهي الشّخصيّ
،هيبتشيكا-سينسي، كانت تُنشر فيها

108
00:09:30,770 --> 00:09:33,130
فقد عزمتُ على إرسال المانغا
."خاصّتي إلى مجلّة "سبيريتس

109
00:09:34,400 --> 00:09:37,130
رسم المانغا بهذه الصّعوبة؟

110
00:09:37,130 --> 00:09:39,040
.لا تستغرق قراءتها وقتًا على الإطلاق

111
00:09:39,040 --> 00:09:40,920
!ثلاث ساعات في إطار واحد؟

112
00:09:40,920 --> 00:09:42,950
هل سأنهيها أصلاً؟

113
00:09:43,390 --> 00:09:47,270
،بعد ستّة أشهر من الكدح
...كانت ثمرة جهدي

114
00:09:48,190 --> 00:09:53,020
،مانغا مراهقين ملتوية، غارقة في الغرور
.ومصيرها أن تصبح ذكرى مُخجلة

115
00:09:53,720 --> 00:09:56,320
هل هذه مانغا جيّدة؟

116
00:09:56,320 --> 00:10:00,830
أتذكّر أنّني كنت أرسم رسومات
.مانغا في كتبي المدرسيّة وأنا صغير

117
00:10:00,830 --> 00:10:02,140
.هكذا إذًا

118
00:10:02,140 --> 00:10:04,830
.أنا أدعمك بالكامل

119
00:10:05,150 --> 00:10:07,580
.كان لطفهما لاذعًا كالسّهام

120
00:10:11,500 --> 00:10:14,510
".فهمت، فهمت. أنت من هؤلاء الفنانين"

121
00:10:14,510 --> 00:10:17,790
من النّوع الّذي يقول: أنا لا أسعى"
"!للشّهرة! لدي قصّة أريد أن أرويها

122
00:10:17,790 --> 00:10:21,430
"!أعلم أنّ هناك قرّاءً سيفهمون عملي حقًّا"

123
00:10:21,430 --> 00:10:25,760
الضّرر الّذي ألحقه الفساد التّجاريّ"
"...بالتّرفيه الحديث

124
00:10:26,000 --> 00:10:27,110
"!اصمتي فحسب"

125
00:10:27,110 --> 00:10:31,000
!نحن مجلّة سِنين عائليّة"
!"لدينا عملٌ نديرُه هنا

126
00:10:31,000 --> 00:10:32,930
هل تريدين الرّسم كهواية؟"
"!اذهبي وألّفي دوجينشي

127
00:10:32,930 --> 00:10:35,980
يا إلهي، أريد بشدّة كوبًا من"
".كراميل ستيمر من ستاربكس

128
00:10:36,280 --> 00:10:38,600
.أراهن أنّ هذا ما يدور في ذهنها

129
00:10:39,280 --> 00:10:41,810
.حسنًا. ها قد اطّلعتُ عليها الآن

130
00:10:41,810 --> 00:10:43,870
—بالنّسبة لمحاولة أولى، فهي مُتقنة الـ

131
00:10:43,870 --> 00:10:46,430
.أنت مُحقّة. عالم الأعمال قاسٍ

132
00:10:46,430 --> 00:10:47,450
.أنا آسفة جدًّا

133
00:10:47,450 --> 00:10:49,000
.لم أقل أيًّا من هذا

134
00:10:50,740 --> 00:10:55,630
بصراحة، هذا العمل ليس بالمستوى
.المطلوب للمانغا التّجاريّة

135
00:10:56,200 --> 00:10:59,930
،مع ذلك، وجدتُ شخصيًّا الكثير منها آسرًا

136
00:10:59,930 --> 00:11:01,970
.وأرى فيها إمكانات واعدة

137
00:11:02,270 --> 00:11:06,860
،أتمنّى رؤية المزيد في المستقبل
.حتّى المسودّات الأوّليّة

138
00:11:07,240 --> 00:11:08,380
هل ستذهبين إلى ستاربكس الآن؟

139
00:11:08,380 --> 00:11:09,940
!لا، لن أذهب

140
00:11:21,690 --> 00:11:24,530
!كلاّ! مبنى شوغاكوكان

141
00:11:29,580 --> 00:11:32,280
:كتب ستيفن كينغ ذات مرّة في مذكّراته

142
00:11:32,280 --> 00:11:39,130
،القصص أشياء يُعثر عليها"
".كالأحافير في باطن الأرض

143
00:11:39,360 --> 00:11:41,880
خيال هذه المرّة؟

144
00:11:41,880 --> 00:11:44,520
.هذا العمل يبدو أكثر أصالة من سابقه

145
00:11:45,980 --> 00:11:50,350
بدأتُ أبحثُ في كلّ مكان على
.أمل أن أجد ما يُميّزني

146
00:11:50,700 --> 00:11:54,500
هذه مانغا قتاليّة؟
.لقد بذلتِ جهدًا كبيرًا حقًّا

147
00:11:54,500 --> 00:11:56,030
.ورسمك قد تحسّن

148
00:11:57,390 --> 00:12:01,530
،كلّما شعرتُ بالضّياع
.كنتُ أستشير بوصِلتي

149
00:12:03,210 --> 00:12:05,910
!هذا هو الحبّ الحقيقيّ

150
00:12:08,910 --> 00:12:16,080
!سأرسم مانغا رقيقة، مثل هيبتشيكا-سينسي

151
00:12:18,240 --> 00:12:22,320
قلتُ للتّلميذة الّتي كانت تبتزّني
.أن تُجرّب رسم المانغا

152
00:12:23,500 --> 00:12:25,550
.رسم المانغا ليس بالأمر السّهل

153
00:12:27,930 --> 00:12:30,040
.بل هو أصعب إذا كنت تُحبّينها

154
00:12:33,690 --> 00:12:36,910
،كلّما ازداد تقديرك للعظماء الّذين سبقوك

155
00:12:37,520 --> 00:12:39,560
.ازداد إدراكك لنقاط ضعفك أكثر

156
00:12:52,830 --> 00:12:53,950
...ولكن

157
00:12:54,510 --> 00:12:56,950
،عندما يحدث ذلك
.تأتي المانغا أيضًا لإنقاذ الموقف

158
00:12:57,320 --> 00:13:01,040
ياسومي، ماذا سيفعل بطل
المانغا في هذا الوضع؟

159
00:13:03,590 --> 00:13:06,560
،مثل مطاردة جزرة على عصا

160
00:13:07,640 --> 00:13:09,940
.تّتبعين خطى المانغا الّتي تحبّينها

161
00:13:12,190 --> 00:13:15,750
نفدت الحمم اللاّزمة لإشعال
.شغفي لهذه المطاردة

162
00:13:17,220 --> 00:13:20,150
.لا بدّ أنّني لم أعد أحبّ المانغا

163
00:13:25,390 --> 00:13:28,150
أتظنّين أنّها سترسم تلك المانغا؟

164
00:13:29,280 --> 00:13:30,480
.مستحيل

165
00:13:30,480 --> 00:13:32,760
.قلت ذلك فقط لأجعلها تستسلم

166
00:13:33,440 --> 00:13:35,690
،إذا هدّدتني مرّة أخرى دون أن ترسم شيئًا

167
00:13:35,690 --> 00:13:38,360
.سأقدّم استقالتي وأغادر الجزيرة

168
00:13:42,670 --> 00:13:45,200
أنتِ تأملين أن ترسم المانغا، أليس كذلك؟

169
00:13:46,240 --> 00:13:47,630
!لا، لست كذلك

170
00:13:47,630 --> 00:13:49,380
.بلى، أنت كذلك

171
00:13:50,480 --> 00:13:54,890
أعتقد أنّ تلك الحمم ما زالت
.بداخلك يا ري-تشان

172
00:13:55,370 --> 00:13:59,240
.لا أفهم منطق كلامك

173
00:13:59,240 --> 00:14:02,800
.انظري، ما زلتِ متمسّكة بتلك الولاّعة

174
00:14:03,620 --> 00:14:05,440
...هـ-هذا لأنّ

175
00:14:08,520 --> 00:14:10,600
.إنّها مفيدةٌ لأشياء كثيرة

176
00:14:10,600 --> 00:14:13,810
.ري-تشان، أنت غافلةٌ حتّى عن مشاعرك

177
00:14:16,950 --> 00:14:18,710
.أجل، تُبلين حسنًا

178
00:14:19,580 --> 00:14:22,160
.استمرّي يا ياسومي

179
00:14:31,740 --> 00:14:33,390
.أتيتُ ومعي المانغا الّتي رسمتُها

180
00:14:36,530 --> 00:14:38,080
هل ملأتِ دفترًا كاملاً؟

181
00:14:38,080 --> 00:14:40,150
ماذا؟ هل كان هذا خاطئًا؟

182
00:14:41,370 --> 00:14:42,860
.لقد سرقت العنوان

183
00:14:44,820 --> 00:14:47,070
"!هيّا بنا يا نيانتا"

184
00:14:47,070 --> 00:14:49,230
"!حسنًا يا نيكوتا-سان"

185
00:14:49,230 --> 00:14:52,760
،ترسم مباشرةً بقلم الحبر
.من دون رسم تخطيطيّ أوّليّ

186
00:14:52,760 --> 00:14:54,580
.رسمها مليء بالتّصحيحات

187
00:14:55,580 --> 00:14:59,100
اهزم الملك الشّرّير"
".وأعِد السّلام إلى هذا العالم

188
00:14:59,100 --> 00:15:00,090
"!حاضر"

189
00:15:00,090 --> 00:15:01,670
!قصّة خياليّة؟

190
00:15:02,110 --> 00:15:04,340
!يا لها من معضلة

191
00:15:05,420 --> 00:15:06,840
.ضحكت تيسي

192
00:15:06,840 --> 00:15:08,260
.ضحكت بالفعل

193
00:15:10,580 --> 00:15:13,580
"...تجوّلت في الصّحراء أسبوعًا"

194
00:15:13,580 --> 00:15:16,710
خالي الوفاض؟ كيف وجد الماء؟

195
00:15:17,440 --> 00:15:19,410
".طقطقة، طقطقة"

196
00:15:19,410 --> 00:15:20,720
".مساء الخير"

197
00:15:21,300 --> 00:15:23,360
"اسمك نيانتا إذًا؟"

198
00:15:23,360 --> 00:15:25,120
".بقبق، بقبق، بقبق "

199
00:15:23,780 --> 00:15:28,180
"أنت في رحلة لهزيمة الملك الشّرّير؟"

200
00:15:28,180 --> 00:15:31,150
"!أجل! سأنضمّ إليك"

201
00:15:31,150 --> 00:15:32,520
!كان ذلك سهلاً

202
00:15:32,520 --> 00:15:34,990
"!واه"

203
00:15:34,990 --> 00:15:39,700
نبات التّنّين الأسود الشّرّير"
"!السّيّئ السّيّئ آكل القطط

204
00:15:39,700 --> 00:15:41,560
!يا له من اسم ركيك سخيف

205
00:15:41,560 --> 00:15:44,040
"!اترك ذلك الطّفل"

206
00:15:44,420 --> 00:15:47,430
.منظور ذلك الطّرف يزعجني حقًّا

207
00:15:58,850 --> 00:16:03,500
إنّها طويلة جدًّا. يقضون عشرين صفحة
.في قتال هذا الوحش الّذي ظهر فجأة

208
00:16:03,860 --> 00:16:06,280
".أنا ابن الإله"

209
00:16:06,650 --> 00:16:08,560
"!وميض"

210
00:16:07,580 --> 00:16:09,780
"...غياااا"

211
00:16:09,780 --> 00:16:13,280
بعد كلّ هذا، تستيقظ قوى خفيّة
.لدى إحدى الشّخصيّات فجأةً وتنتصر

212
00:16:15,400 --> 00:16:19,120
.لم يتبقَّ سوى صفحات قليلة

213
00:16:19,450 --> 00:16:22,350
".من الجميل الاسترخاء هكذا بين الحين والآخر"

214
00:16:22,350 --> 00:16:23,820
".صدقت"

215
00:16:23,820 --> 00:16:25,930
.هذا ليس وقتًا مناسبًا للتّراخي

216
00:16:25,930 --> 00:16:27,800
"!أنتما هناك"

217
00:16:28,580 --> 00:16:30,130
.بقيت ثلاث صفحات

218
00:16:30,130 --> 00:16:31,700
"!مفاجأة"

219
00:16:31,700 --> 00:16:37,240
،أنا اليد اليمنى للملك الشّرّير"
"!الخلد الأسود الأسطوريّ

220
00:16:37,240 --> 00:16:40,370
"!أنت الخلد الأسود الأسطوريّ"

221
00:16:40,370 --> 00:16:42,160
شخصيّة جديدة الآن؟

222
00:16:42,410 --> 00:16:45,890
".أنا قويّ جدًّا. هههه"

223
00:16:45,890 --> 00:16:47,670
.بقيت صفحتان

224
00:16:47,670 --> 00:16:48,770
"!لمعان"

225
00:16:48,770 --> 00:16:50,090
هل سينجح الأمر؟

226
00:16:50,090 --> 00:16:52,060
"...بقوّة الإله"

227
00:16:52,060 --> 00:16:54,580
"!وميض"

228
00:16:52,300 --> 00:16:55,630
"!غوااااه"

229
00:16:55,630 --> 00:16:58,460
هل هُزم في إطار واحد بقواه المستيقظة؟

230
00:16:59,020 --> 00:17:02,460
"!مستقبل باهر ينتظرنا"

231
00:17:02,460 --> 00:17:03,550
"!أجل"

232
00:17:03,550 --> 00:17:05,600
.ورسالة من العدم

233
00:17:05,600 --> 00:17:08,220
"!رحلتنا لم تنتهِ هنا"

234
00:17:08,220 --> 00:17:10,770
"!انتظرني"

235
00:17:12,240 --> 00:17:13,560
"النّهاية؟"

236
00:17:13,560 --> 00:17:16,850
.علامة الاستفهام هذه تُثير غضبي

237
00:17:18,340 --> 00:17:19,540
ما رأيك؟

238
00:17:24,690 --> 00:17:26,680
.سأقرؤها من جديد من البداية

239
00:17:28,230 --> 00:17:30,540
!نجحنا يا أكافوكو

240
00:17:31,230 --> 00:17:33,500
".هيّا نبني طوفًا"

241
00:17:33,500 --> 00:17:34,800
.الحبكة سيّئة للغاية

242
00:17:35,020 --> 00:17:36,600
.الرّسم بشع

243
00:17:36,600 --> 00:17:40,170
.نيانتا، ما زلت صغيرًا جدًّا"
"ألا تخاف؟

244
00:17:40,170 --> 00:17:44,460
قد أكون خائفًا، لكنّني ما زلت"
"!أريد أن أفعل ما أريد

245
00:17:44,460 --> 00:17:47,180
.الحوار مطوّل ويبدو وكأنّه سرد توضيحيّ

246
00:17:47,560 --> 00:17:50,140
يصعب عليّ إيجاد أيّ شيء
.إيجابيّ لأقوله عنه

247
00:17:51,010 --> 00:17:52,130
.لكنّ الأمر واضح لي

248
00:17:55,770 --> 00:17:58,060
.رُسم هذا العمل بدافع الحبّ

249
00:18:04,810 --> 00:18:06,370
...حب خالصّ

250
00:18:09,170 --> 00:18:10,440
.للمانغا

251
00:18:15,690 --> 00:18:17,570
هل كان هناك جزءٌ مُصمّمٌ لإبكائك؟

252
00:18:21,720 --> 00:18:22,950
.سينسي

253
00:18:26,460 --> 00:18:29,840
رسم المانغا صعبٌ حقًّا، أليس كذلك؟

254
00:18:30,280 --> 00:18:33,840
،أعلم أنّك لا ترينه يا سينسي

255
00:18:33,840 --> 00:18:36,340
.لكنّ بوكوتا كان دائمًا بجانبي

256
00:18:38,740 --> 00:18:41,390
.تمكّنتُ من الرّسم بفضل تشجيعه

257
00:18:44,110 --> 00:18:49,280
لذا، أنا مدينة لك بالشّكر
."لرسمك "روبوتا وبوكوتا

258
00:19:01,480 --> 00:19:04,040
.هذا نموذج طلب تأسيس نادٍ

259
00:19:04,040 --> 00:19:05,010
ماذا؟

260
00:19:05,570 --> 00:19:07,800
.سأكون مشرفة النّادي

261
00:19:08,180 --> 00:19:10,940
.أعيدا النّموذج بعد ملء الخانات المطلوبة

262
00:19:13,440 --> 00:19:16,260
!سينسي! سينسي! شكرًا لك

263
00:19:16,260 --> 00:19:18,090
!أحسنتِ يا ياسومي

264
00:19:18,090 --> 00:19:19,430
.نجحنا

265
00:19:18,560 --> 00:19:23,640
!أجل! أجل

266
00:19:22,310 --> 00:19:25,090
.أخفضا أصواتكما. هذه غرفة هيئة التّدريس

267
00:19:31,540 --> 00:19:33,940
.يمكننا الآن رسم المانغا

268
00:19:33,940 --> 00:19:37,450
.يمكننا الآن الجلوس في غرفة مكيّفة

269
00:19:37,700 --> 00:19:40,970
.ربّما ستعلّمني سينسي كيف أيضًا

270
00:19:40,970 --> 00:19:44,110
ربّما نستمتع بمشروبات
.غازيّة غير محدودة

271
00:19:51,740 --> 00:19:53,090
ما الأمر؟

272
00:19:53,320 --> 00:20:00,850
مكتوب: "يلزم ثلاثة أعضاء
."على الأقلّ لتأسيس نادٍ

273
00:20:00,850 --> 00:20:02,680
ثلاثة أشخاص؟

274
00:20:02,680 --> 00:20:04,420
...ياسومين و

275
00:20:04,420 --> 00:20:06,230
...أكافوكو و

276
00:20:07,180 --> 00:20:09,790
.نحتاج إلى شخص آخر

277
00:20:24,730 --> 00:20:26,840
.مرحبًا بعودتك يا كوكورو-تشان

278
00:20:27,950 --> 00:20:30,940
كوكورو-تشان، هل اعتدت
على المدرسة الثّانويّة؟

279
00:20:32,420 --> 00:20:33,210
!كوكورو

280
00:20:34,440 --> 00:20:37,340
ها أنت ذي تدخلين من
.مدخل الضّيوف مجدّدًا

281
00:20:37,340 --> 00:20:38,300
...لكن

282
00:20:38,300 --> 00:20:40,910
ماذا لو رآك أحد ضيوفنا؟

283
00:20:40,910 --> 00:20:42,140
!يا لها من قلّة أدب

284
00:20:42,970 --> 00:20:46,530
.سيّدتي، الباب الخلفيّ قيد الإصلاح حاليًّا

285
00:20:46,530 --> 00:20:47,980
أهذا هو السّبب؟

286
00:20:47,980 --> 00:20:49,680
.كان عليك قول ذلك مسبقًا

287
00:20:50,090 --> 00:20:53,620
.حسنًا، لدينا حجوزات كثيرة اليوم. هيّا لنسرع

288
00:21:01,260 --> 00:21:02,780
.أنا أختنق

289
00:21:02,780 --> 00:21:05,710
.يجب التّخلّص من دبّوس الشّعر الطّفوليّ هذا

290
00:21:08,080 --> 00:21:09,400
...أختنق

291
00:21:10,590 --> 00:21:13,960
أظهري كلّ ما لذلك الشّعر
.من جمال بتركه هكذا

292
00:21:15,460 --> 00:21:18,180
.لا يمكنني التّنفّس

293
00:21:21,550 --> 00:21:22,820
...لا بدّ من وجود مكان