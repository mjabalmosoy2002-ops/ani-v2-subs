1
00:00:01,320 --> 00:00:04,940
أعتقد أنّ الوقت قد حان لتبدأن
.الاستعداد لفعاليّة كوميتيا القادمة

2
00:00:04,940 --> 00:00:05,860
.بالتّأكيد

3
00:00:05,860 --> 00:00:06,740
.حسنًا

4
00:00:07,010 --> 00:00:09,570
.ستكون لي طاولتي الخاصّة مجدّدًا

5
00:00:09,840 --> 00:00:12,560
هذه المرّة، سيصادف اليوم
،التّالي للحدث يوم عمل

6
00:00:12,560 --> 00:00:16,010
لذا سنعود جوًّا إلى الجزيرة
.في نفس يوم الحدث

7
00:00:17,390 --> 00:00:18,730
!هذا كلام رائع يا تيسي

8
00:00:18,730 --> 00:00:21,230
.لطالما رغبتُ في ركوب تلك الطّائرة

9
00:00:21,230 --> 00:00:24,340
،لكن، ونظرًا لجدول الرّحلات الجوّيّة

10
00:00:24,340 --> 00:00:26,630
لن تتمكّن من البقاء في معرض
.كوميتيا حتّى النّهاية

11
00:00:28,830 --> 00:00:29,680
...ولهذا السّبب

12
00:00:29,940 --> 00:00:31,850
سنتوجّه إلى طوكيو قبل الموعد بيومين

13
00:00:31,850 --> 00:00:34,740
لمنحكنّ فرصة قضاء يوم كامل
.في توسيع آفاقكنّ

14
00:00:34,740 --> 00:00:36,720
!مرحى

15
00:00:36,720 --> 00:00:40,040
ستفيدكنّ التّجارب المتنوّعة كثيرًا
.في رسم المانغا

16
00:00:40,040 --> 00:00:43,880
أخبرنني إن كانت هناك أيّ مؤسّسات
.ثقافيّة تردن زيارتها

17
00:00:43,880 --> 00:00:45,260
!متجر كتب ضخم

18
00:00:45,260 --> 00:00:46,490
.جيّد جدًّا

19
00:00:46,490 --> 00:00:49,240
.أ-أودّ الذّهاب إلى متحف للفنون

20
00:00:49,500 --> 00:00:51,160
.يبدو هذا مفيدًا وتثقيفيًّا

21
00:00:51,160 --> 00:00:52,200
!أجل، أجل، أجل

22
00:00:52,200 --> 00:00:54,650
!فطائر بانكيك في هاراجوكو

23
00:00:54,650 --> 00:00:57,360
.حديقة ملاهي "الفأرة" المفضّلة للجميع

24
00:00:57,360 --> 00:00:58,820
.لا لهذا ولا لذاك

25
00:00:58,820 --> 00:00:59,870
.كلاّ

26
00:00:59,870 --> 00:01:01,460
.حسنًا إذًا

27
00:01:01,830 --> 00:01:06,960
.تفضّلن وأبدعن كما تشأن
.وكالعادة، كهواية فحسب

28
00:02:38,030 --> 00:02:40,470
أيّ نوع من الكتب ينبغي أن نعمل عليه؟

29
00:02:40,760 --> 00:02:44,580
علينا أن نجمع كلّ شرائط فوا المظلم
.المنشورة على وسائل التّواصل

30
00:02:44,580 --> 00:02:48,400
صحيح. لدينا ما يكفي من الموادّ لتجهيز
.كتاب دون الحاجة لرسم أيّ شيء جديد

31
00:02:52,530 --> 00:02:55,160
...إذا كنتِ مستعدّة لذلك يا فوجيموري-سان

32
00:02:55,160 --> 00:02:58,070
ما رأيك أن نحاول نحن الاثنتان
تأليف مانغا أصليّة؟

33
00:02:59,340 --> 00:03:01,330
مانغا أصليّة من إبداعي؟

34
00:03:01,410 --> 00:03:04,320
هل أنتِ محبطة
لأنّي لم أشترِ ذلك الكتاب؟

35
00:03:04,960 --> 00:03:07,830
أعتقد أنّ الشّفقة على النّاس
.لا تؤدّي إلاّ إلى خنق الإبداع

36
00:03:08,910 --> 00:03:13,850
،أريد أن أنتقم لما حدث في كوميتيا
.حيث تمّ انتقاد المانغا خاصّتي بشدّة

37
00:03:14,810 --> 00:03:18,720
بالتّأكيد، أنا مهتمّة أيضًا برؤية
.عمل أصليّ من إبداعك

38
00:03:21,430 --> 00:03:22,600
.سأحاول

39
00:03:23,160 --> 00:03:24,400
.يسعدني سماع ذلك

40
00:03:28,260 --> 00:03:31,860
مانغا أصليّة؟
.لم يخطر ذلك ببالي حتّى

41
00:03:32,240 --> 00:03:36,750
أتتذكّرين كيف أثنت تيشيما-سينسي على
استخدامك للمؤثّرات الصّوتيّة سابقًا؟

42
00:03:36,750 --> 00:03:40,620
نعم، قد يكون التّركيز على ذلك
.أمرًا مثيرًا للاهتمام

43
00:03:43,020 --> 00:03:45,870
.عليّ أن أبدأ بالتّفكير فيما أريد رسمه

44
00:03:46,200 --> 00:03:50,440
ثمّ يمكنني العمل بشكل عكسيّ
.لتحديد نقطة البداية

45
00:03:52,550 --> 00:03:55,190
،بدأت الرّسم دون تفكير
.وها أنا ذي عالقة الآن

46
00:03:55,190 --> 00:03:56,940
ما هي خطوتي التّالية؟

47
00:03:56,940 --> 00:03:59,520
من الأسهل ترتيب الأمور
.إذا حدّدت النّهاية أوّلاً

48
00:03:59,520 --> 00:04:02,300
الطّريقة الاستقصائيّة الّتي مُدحت
.ياسومي لاستخدامها

49
00:04:03,660 --> 00:04:07,610
لكنّ عدم التّخطيط المسبق للخاتمة
.يناسب أسلوبك أكثر يا ياسومي

50
00:04:07,610 --> 00:04:09,100
.هذا صحيح

51
00:04:09,100 --> 00:04:11,390
تقصد الطّريقة الاستنتاجيّة، صحيح؟

52
00:04:11,390 --> 00:04:12,060
.نعم

53
00:04:12,060 --> 00:04:13,960
.أجل، وجدتُها

54
00:04:15,600 --> 00:04:19,280
،لقد اهتديتُ إلى فكرة للنّهاية
.لذا سأضعُ الحبكة الأساسيّة في البداية

55
00:04:19,880 --> 00:04:21,190
...عفوًا

56
00:04:21,190 --> 00:04:24,030
،أريد أن تكون النّهاية هي الجزء الأكثر إثارة

57
00:04:24,030 --> 00:04:26,790
لذا ربّما يجدر بي تهدئة وتيرة النّصف الأوّل؟

58
00:04:26,790 --> 00:04:27,790
"!دويّ"

59
00:04:28,120 --> 00:04:28,900
.حسنًا

60
00:04:29,420 --> 00:04:30,620
"!ارتداد"

61
00:04:30,620 --> 00:04:32,440
.يمكنني الآن البدء بالرّسم أخيرًا

62
00:04:32,880 --> 00:04:35,050
"!هدير-دير-دير"

63
00:04:38,440 --> 00:04:40,590
!انتهيت

64
00:04:45,850 --> 00:04:50,030
كالعادة، العمل فوضويّ من
.أوّله إلى آخره، ونهايته متسرّعة

65
00:04:51,280 --> 00:04:53,860
.على أيّة حال، لهذا الأمر جاذبيّته الخاصّة

66
00:05:07,160 --> 00:05:08,040
.أكافوكو

67
00:05:08,040 --> 00:05:09,600
.لقد انتهيت، لذا ألقي نظرة

68
00:05:10,710 --> 00:05:11,840
.انتهيت

69
00:05:12,300 --> 00:05:13,360
...ولكن

70
00:05:14,230 --> 00:05:17,550
،قد يكون كلّ شيء متّسقًا

71
00:05:17,550 --> 00:05:19,170
.لكنّه يفتقر إلى الإبهار

72
00:05:20,550 --> 00:05:21,750
.سخيفة للغاية

73
00:05:21,750 --> 00:05:25,400
،الأمر كلّه يعتمد على الزّخم
.كالعادة. فوضى عارمة

74
00:05:26,730 --> 00:05:28,520
...ما ينقصني هو

75
00:05:28,830 --> 00:05:31,440
،الرّسم بأقصى سرعة أمر ممتع

76
00:05:31,440 --> 00:05:34,020
.لكنّ القصّة لا تتماسك أبدًا

77
00:05:34,020 --> 00:05:36,560
ماذا أفعل؟

78
00:05:37,940 --> 00:05:40,820
.فوجيموري-سان، أريني لوحتك القصصيّة

79
00:05:37,940 --> 00:05:40,820
.ياسومي-سان، أريني لوحتك القصصيّة

80
00:05:42,190 --> 00:05:44,230
.بدايةٌ تأسرُك

81
00:05:44,230 --> 00:05:46,360
.شخصيّاتٌ تبدو متحرّرةً من القيود

82
00:05:46,360 --> 00:05:48,620
.طاقةٌ تبعثُ على الابتسام

83
00:05:49,140 --> 00:05:51,280
.كلُّ ما كنتُ أفتقده

84
00:05:52,260 --> 00:05:54,300
.حبكةٌ مُحكمة

85
00:05:54,300 --> 00:05:56,670
.رسومٌ مُتقنة ومدروسة

86
00:05:56,670 --> 00:05:59,100
.شعورُ الرّضا الّذي يغمرك بعد القراءة

87
00:05:59,500 --> 00:06:00,450
...إنّها

88
00:06:01,830 --> 00:06:03,470
.مانغا كوكورو-تشان

89
00:06:04,000 --> 00:06:05,890
.مانغا آي-تشان

90
00:06:06,790 --> 00:06:08,320
.إنّها مذهلة

91
00:06:13,350 --> 00:06:16,580
.ليتني أستطيع ابتكار حبكة متقنة ومرتّبة كهذه

92
00:06:16,580 --> 00:06:19,240
.ليت كان بوسعي خلق هذا النّوع من الزّخم

93
00:06:19,240 --> 00:06:21,780
ما رأيكما في هذه الفكرة إذًا؟

94
00:06:22,360 --> 00:06:23,120
ماذا؟

95
00:06:25,380 --> 00:06:26,660
.حسنًا جدًّا

96
00:06:26,660 --> 00:06:29,880
دعاني ألقي نظرة على لوحتكما
.القصصيّة لمعرض كوميتيا

97
00:06:39,140 --> 00:06:42,170
،بداية مفعمة بالحيويّة
.كما هو متوقّع من ياسومي-سان

98
00:06:47,270 --> 00:06:50,170
عادت عادة ياسومي-سان
.السّيّئة للظّهور مجدّدًا

99
00:06:50,170 --> 00:06:52,800
.تضخّم نطاق القصّة بشكل مفرط

100
00:06:54,650 --> 00:06:56,960
.يتغيّر الأسلوب الفنّيّ بدءًا من هذه النّقطة

101
00:06:59,730 --> 00:07:04,990
،كانت الفوضى السّابقة بمثابة تمهيد
.والآن بدأت الحبكة تتركّز وتتّضح معالمها

102
00:07:11,860 --> 00:07:13,790
.انتهت الأمور بشكل متقن ومرتّب

103
00:07:16,060 --> 00:07:19,330
كانت بنية تلك القصّة هي الأكثر تعقيدًا
.لك حتّى الآن، وقد استمتعتُ بها

104
00:07:20,420 --> 00:07:22,800
!لقد نجحنا

105
00:07:22,800 --> 00:07:24,550
كيف قمت بابتكارها؟

106
00:07:25,360 --> 00:07:26,780
.إنّها مانغا مشتركة

107
00:07:27,420 --> 00:07:31,260
اجمعا بين النّصف الأوّل المثير والنّصف
.الثّاني الّذي ينتهي بشكل متقن

108
00:07:31,260 --> 00:07:34,560
سيكون الأمر وكأنّنا نجمع بين أفضل
.ما لدى آي-تشان وكوكورو-تشان

109
00:07:34,940 --> 00:07:37,340
.كان ذلك اقتراح هيكارو-تشان

110
00:07:37,340 --> 00:07:38,650
.فهمت

111
00:07:39,020 --> 00:07:41,320
.أعتقد أنّها تحقّق توازنًا ممتازًا

112
00:07:43,000 --> 00:07:45,660
!مرحى

113
00:07:46,230 --> 00:07:48,740
.أفكارٌ جامحة ذاتُ أثرٍ قويّ

114
00:07:48,740 --> 00:07:51,390
.وبناءٌ قصصيّ مُتقَن ومنظّم

115
00:07:51,780 --> 00:07:56,770
يمتلك كبار المؤلّفين هاتين
.السّمتين المتناقضتين معًا

116
00:07:57,140 --> 00:08:02,090
عادةً، قد يستغرق اكتساب الجانب
.الّذي تفتقر إليه وقتًا طويلاً

117
00:08:03,430 --> 00:08:05,940
...ولكن، إن كان لديك شريك يكمّلك

118
00:08:24,040 --> 00:08:27,420
هل أنت راضية عن عدم تقديم كتاب
مبتكرٍ بالكامل في معرض كوميتيا؟

119
00:08:27,420 --> 00:08:28,110
.نعم

120
00:08:28,110 --> 00:08:30,900
.تبدو المانغا المشتركة أكثر إثارة للاهتمام

121
00:08:30,900 --> 00:08:32,240
...لكن

122
00:08:32,240 --> 00:08:35,040
كوكورو-تشان، لقد ساعدتِ
،في إعداد اللّوحات القصصيّة

123
00:08:35,040 --> 00:08:37,150
.وهذا يعني مزيدًا من العمل لك

124
00:08:37,150 --> 00:08:40,680
.نصف التّأليف. والرّسم بالكامل

125
00:08:43,780 --> 00:08:46,500
.آي-تشان، ينبغي عليك تولّي جزء من الرّسم

126
00:08:49,840 --> 00:08:55,220
صحيح. عندها سيكون عملاً مشتركًا
.حقيقيًّا بيني وبين كوكورو-تشان

127
00:08:55,220 --> 00:08:57,170
...لكن مع ذلك

128
00:08:57,550 --> 00:08:58,340
ماذا؟

129
00:08:59,390 --> 00:09:05,360
فوجيموري-سان، متى بدأتُ
أناديكِ بكوكورو-تشان؟

130
00:09:06,320 --> 00:09:07,650
.وأنا مثلك

131
00:09:11,310 --> 00:09:14,360
يبدو أنّنا صرنا نستعمل ألقابَ
.هيكارو-تشان لنا مثلها

132
00:09:28,220 --> 00:09:29,550
.كوكورو-تشان

133
00:09:29,950 --> 00:09:30,970
.آي-تشان

134
00:09:31,840 --> 00:09:33,680
.لنقدّم أفضل ما لدينا معًا

135
00:09:33,680 --> 00:09:35,990
.أشركاني في المرح

136
00:09:35,990 --> 00:09:37,430
.وأنا أيضًا

137
00:09:38,810 --> 00:09:41,130
!أخفتماني

138
00:09:39,370 --> 00:09:42,440
هل نذهب للحصول على مثلّجات من متجرنا؟

139
00:09:44,560 --> 00:09:45,950
.على حسابي

140
00:09:45,950 --> 00:09:47,440
.سيغضب والدك منك بشدّة

141
00:09:48,910 --> 00:09:50,610
...ربّما

142
00:09:51,830 --> 00:09:53,260
.حان الوقت لذلك

143
00:09:59,630 --> 00:10:02,950
طوكيو ليست مخيفةً جدًّا
.عند زيارتها للمرّة الثّانية

144
00:10:02,950 --> 00:10:04,830
.ما زلنا على متن العبّارة

145
00:10:05,260 --> 00:10:08,250
.لقد رأيتُ هذا من قبل

146
00:10:14,060 --> 00:10:15,510
هل هم أغبياء؟

147
00:10:15,510 --> 00:10:18,580
هل سكّان طوكيو أغبياء؟

148
00:10:18,580 --> 00:10:21,060
يبدو المشهد هكذا في أنحاء
.المدينة خلال فصل الشّتاء

149
00:10:21,060 --> 00:10:23,050
.لا بدّ أنّ فاتورة الكهرباء باهظة للغاية

150
00:10:26,340 --> 00:10:30,840
!طـ-طوكيو مذهلة

151
00:10:31,360 --> 00:10:35,780
بما أنّكنّ ستوسّعن آفاقكنّ بزيارة
،متاجر الكتب وما إلى ذلك غدًا

152
00:10:35,780 --> 00:10:38,660
.فقد حجزتُ لنا غرفًا هنا لهذه اللّيلة

153
00:10:35,790 --> 00:10:38,660
.مذهل. لا يوجد هنا سوى متاجر الكتب

154
00:10:38,660 --> 00:10:40,200
!ماذا؟

155
00:10:40,200 --> 00:10:43,140
!حتّى الفندق مليء بالكتب

156
00:10:44,120 --> 00:10:47,000
.طوكيو مذهلة

157
00:10:48,680 --> 00:10:50,130
.بئسًا، لقد ماتت

158
00:10:50,130 --> 00:10:51,980
.طابت ليلتك يا طوكيو

159
00:10:51,980 --> 00:10:52,790
.تصبحين على خير

160
00:10:52,790 --> 00:10:53,510
.تصوير

161
00:11:36,020 --> 00:11:38,050
.يا لكثرة متاجر الكتب هنا

162
00:11:38,630 --> 00:11:41,940
.لكنّني لا أجد كتاب سينسي فيّ أي مكان

163
00:11:41,940 --> 00:11:43,380
!آي-تشان

164
00:11:43,380 --> 00:11:46,060
لقد عثرتُ على متجر ضخم
!لمستلزمات الرّسم، إنّه مذهل

165
00:11:48,310 --> 00:11:50,980
كانوا يبيعون ألوانًا متنوّعة
.لم أرَ مثلها من قبل

166
00:11:54,440 --> 00:11:57,310
ووجدتُ أيضًا مانغا
.تيشيما-سينسي معروضة للبيع

167
00:11:57,310 --> 00:11:58,950
!ماذا؟

168
00:12:01,610 --> 00:12:03,890
.متأكّدة تمامًا أنّ الطّريق كان من هنا

169
00:12:07,910 --> 00:12:08,790
...هذا المكان

170
00:12:11,510 --> 00:12:14,300
.إنّها الشّركة الّتي نشرت كتاب سينسي

171
00:12:16,260 --> 00:12:20,860
.تُصنع هنا الكثير من الكتب

172
00:12:20,860 --> 00:12:21,690
.نعم

173
00:12:24,620 --> 00:12:26,670
.أنا متأكّدة أنّ كتاب سينسي كان هناك

174
00:12:32,470 --> 00:12:33,590
.تمامًا

175
00:12:33,590 --> 00:12:34,310
.نعم

176
00:12:34,310 --> 00:12:35,740
هل قرأت ذلك الكتاب؟

177
00:12:35,740 --> 00:12:37,770
.نعم. سمعتُ أنّه سيُعاد طباعته

178
00:12:37,770 --> 00:12:39,280
.هذا أمر رائع حقًّا

179
00:12:49,940 --> 00:12:53,330
.بـ-بريق وفخامة

180
00:12:54,130 --> 00:12:55,510
.ها أنت هناك

181
00:12:55,510 --> 00:12:58,550
هل يعمل الجميع هنا في مجال المانغا؟

182
00:12:58,550 --> 00:12:59,850
صحيح؟

183
00:13:01,550 --> 00:13:06,740
.نفدت حممي بعد فصلين فقط من السّلسلة

184
00:13:07,550 --> 00:13:11,870
لكنّ جميع رسّامي المانغا هنا ينجحون
.في الاستمرار بوتيرة أسبوعيّة أو شهريّة

185
00:13:15,600 --> 00:13:16,840
!تيشيما-سان

186
00:13:23,270 --> 00:13:25,500
.سلسلتك الجديدة رائعة للغاية

187
00:13:27,580 --> 00:13:29,660
!كان الفصل الثّاني مذهلاً أيضًا

188
00:13:30,110 --> 00:13:33,040
لطالما أحببت أعمالك
.منذ أن فزتِ بتلك الجائزة

189
00:13:35,800 --> 00:13:37,230
!هيبيتشيكا-سينسي

190
00:13:38,680 --> 00:13:41,490
من أنتِ يا ترى؟

191
00:13:42,880 --> 00:13:45,480
!أنت ري-تشان

192
00:13:45,480 --> 00:13:47,470
.قرأتُ سلسلتك الجديدة

193
00:13:49,030 --> 00:13:50,750
.لا يزال أمامك طريق طويل لتقطعيه

194
00:13:52,190 --> 00:13:54,420
.هذا هو توندن مينورو-سينسي

195
00:13:56,070 --> 00:13:58,540
.عذرًا على تفويت ذلك الموعد النّهائيّ

196
00:13:58,540 --> 00:14:00,650
إذًا هذا هو؟

197
00:14:50,790 --> 00:14:54,120
.أنا سعيدة لأنّني أصبحتُ رسّامة مانغا

198
00:15:02,390 --> 00:15:05,070
.هذا يعيد إليّ الكثير من الذّكريات

199
00:15:09,290 --> 00:15:11,310
.كان كلّ شيء رائعًا للغاية

200
00:15:11,310 --> 00:15:12,430
.نعم

201
00:15:13,820 --> 00:15:16,650
.الكثير من الكتب

202
00:15:16,650 --> 00:15:18,960
.وعثرنا على كتاب سينسي

203
00:15:20,660 --> 00:15:22,420
!ماذا؟ إنّه باهظ الثّمن

204
00:15:22,420 --> 00:15:24,360
.ليس وكأنّني أستطيع تحمّل تكلفته

205
00:15:24,870 --> 00:15:27,770
.أُعيدت طباعة هذا الكتاب مرّات عديدة

206
00:15:28,200 --> 00:15:31,700
إن بيع كتاب تجاريًّا إنجاز مذهل، أليس كذلك؟

207
00:15:31,700 --> 00:15:35,150
يجب عليهم طبع كتاب سينسي
.بنفس ذلك العدد من المرّات أيضًا

208
00:15:36,080 --> 00:15:39,430
يبدأ معرض كوميتيا غدًا، لذا
.عليكنّ الخلود للنّوم مبكّرًا

209
00:15:39,430 --> 00:15:41,090
!أكيد

210
00:15:45,700 --> 00:15:48,180
.ربّما سيكون ذلك كتابنا يومًا ما

211
00:15:48,740 --> 00:15:50,110
.مستحيل

212
00:15:52,730 --> 00:15:54,990
...تذهب جائزة مانغا تايشو لهذا العام إلى

213
00:15:55,340 --> 00:15:58,600
.مانغا نيكوتا ونيانيا من أكافوكو سو-سينسي

214
00:15:59,100 --> 00:16:02,180
احتفالاً بذلك، ستُطبع دفعة إضافيّة
.قوامها 50 كوينتيليون نسخة

215
00:16:02,180 --> 00:16:05,610
بالإضافة إلى جائزة إضافيّة عبارة عن
.قسائم شراء كتب بقيمة 50 مليار ينّ

216
00:16:06,610 --> 00:16:12,870
!شكرًا جزيلاً لكم على قراءة المانغا خاصّتنا

217
00:17:02,560 --> 00:17:05,500
يا ياسومين، هل حدث شيء ما؟

218
00:17:05,500 --> 00:17:08,260
.عفوًا، إنّه مجرّد حلم رأيته

219
00:17:08,670 --> 00:17:09,920
.اسمعن

220
00:17:09,920 --> 00:17:12,330
علينا المغادرة مبكّرًا اليوم، أليس كذلك؟

221
00:17:12,330 --> 00:17:15,510
سأكون مشغولة، لذا تعالي لمساعدتي
.في البيع عند طاولتي يا آي-تشان

222
00:17:15,510 --> 00:17:17,430
ماذا؟ هل انتظرت حتّى هذه
اللّحظة لتطلبي ذلك؟

223
00:17:20,850 --> 00:17:23,230
!حسنًا

224
00:17:25,520 --> 00:17:27,360
.لقد أتقنّا الأمر الآن

225
00:17:27,360 --> 00:17:30,330
.والملصق الّذي اقترحتُه يبدو رائعًا

226
00:17:30,330 --> 00:17:31,240
.نعم، نعم

227
00:17:31,240 --> 00:17:33,920
.حسنًا، سأذهب لمساعدة هيكارو-تشان

228
00:17:33,920 --> 00:17:34,380
.حسنًا

229
00:17:34,380 --> 00:17:35,990
.سنتولّى نحن الأمور هنا

230
00:17:39,160 --> 00:17:42,790
حان وقت الاسترخاء والاستمتاع
!بالأمر على أكمل وجه

231
00:17:42,790 --> 00:17:45,030
.طابور طويل

232
00:17:45,030 --> 00:17:47,470
،لم يُفتح المعرض بعد
.ومع ذلك فالطّابور طويل للغاية

233
00:17:47,470 --> 00:17:50,450
.أظنّ أنّهم جميعًا من المجموعات المشاركة

234
00:17:52,010 --> 00:17:54,340
.السّاعة الآن الحادية عشرة

235
00:17:54,340 --> 00:17:58,520
.لقد فُتح معرض كوميتيا رسميًّا الآن

236
00:18:03,520 --> 00:18:04,460
.نسخة واحدة، من فضلك

237
00:18:04,460 --> 00:18:05,990
.شـ-شكرًا جزيلاً لكم

238
00:18:05,990 --> 00:18:07,210
هل هناك حدّ أقصى؟

239
00:18:07,210 --> 00:18:08,020
.نسختان كحدّ أقصى

240
00:18:08,020 --> 00:18:09,110
.تفضّل، هذه بطاقتي التّعريفيّة

241
00:18:09,110 --> 00:18:14,070
.شكرًا جزيلاً لكم

242
00:18:10,150 --> 00:18:11,340
.أرجو منك قراءة رسالتي

243
00:18:12,540 --> 00:18:13,280
.نسخة واحدة، من فضلك

244
00:18:14,070 --> 00:18:14,750
.هذه وجبات خفيفة لكما

245
00:18:14,750 --> 00:18:17,530
.شكرًا جزيلاً لكم

246
00:18:15,590 --> 00:18:16,340
.سآخذ نسختين

247
00:18:17,530 --> 00:18:19,950
!هيكارو-تشان
أين أضع كلّ هذه الأوراق الماليّة؟

248
00:18:19,950 --> 00:18:21,770
.اِحشريها ببساطة في كيس القمامة

249
00:18:28,130 --> 00:18:30,380
.لم يستغرق الأمر سوى ساعة واحدة

250
00:18:30,870 --> 00:18:32,570
.أبليتِ حسنًا

251
00:18:33,380 --> 00:18:36,690
.هذه من مجموعة من النّاشرين

252
00:18:40,280 --> 00:18:42,600
.لستُ مهتمّة بهذا في الوقت الرّاهن

253
00:18:42,600 --> 00:18:44,150
ماذا؟

254
00:18:44,150 --> 00:18:46,980
.آي-تشان، سأشكرك على هذا لاحقًا

255
00:18:48,540 --> 00:18:50,860
.هيكارو-تشان مذهلة حقًّا

256
00:18:50,860 --> 00:18:54,510
.لو كنتُ مكانها، لقفزتُ فرحًا

257
00:18:56,480 --> 00:18:58,270
.ياسومي، انظري

258
00:19:04,240 --> 00:19:06,880
مهلاً، إنّها تلك المحرّرة
.الّتي التقينا بها في المرّة السّابقة

259
00:19:06,880 --> 00:19:09,340
هل ستجرّبين حظّك معها مجدّدًا؟

260
00:19:09,340 --> 00:19:11,370
.ذلك مخيف للغاية

261
00:19:11,370 --> 00:19:14,880
علاوة على ذلك، عليّ العودة
.إلى طاولتنا للمساعدة في بيع الكتب

262
00:19:15,270 --> 00:19:17,660
ماذا؟! بعنا كلّ شيء؟

263
00:19:17,660 --> 00:19:21,650
يبدو أنّ هيكارو-تشان قد روّجت لنا عبر
.حسابها على وسائل التّواصل الاجتماعيّ

264
00:19:21,650 --> 00:19:24,450
ذهبت أكافوكو-سان بالفعل
.لاستكشاف أرجاء المكان

265
00:19:24,830 --> 00:19:27,400
هل هذا ما قصدته بـ"شُكري"؟

266
00:19:27,400 --> 00:19:31,680
لكن بعض النّاس عرفونا
.من خلال منشوراتنا أيضًا

267
00:19:31,680 --> 00:19:32,990
حقًّا؟

268
00:19:32,990 --> 00:19:35,770
.رغم أنّ أيًّا منهم لم يشترِ نسخة

269
00:19:38,780 --> 00:19:41,240
.أظنّ أنّه من الجيّد أنّنا بعنا كلّ شيء

270
00:19:43,540 --> 00:19:47,260
لكنّني أردت أن أعرف مدى نجاحنا
.لو اعتمدنا على أنفسنا

271
00:19:47,750 --> 00:19:49,690
!بـ-بعنا كلّ شيء؟

272
00:19:50,170 --> 00:19:52,030
.مرحبًا يا لو غارو-سان

273
00:19:52,720 --> 00:19:55,140
...نـ-نفدت كلّها. نـ-نـ-نفدت

274
00:19:58,820 --> 00:20:00,730
!لا تظنّي أنّك فزت بعد

275
00:20:11,140 --> 00:20:15,170
يا سومي، ماذا سيفعل بطل
المانغا في موقف كهذا؟

276
00:20:18,880 --> 00:20:22,240
يا ياسومي، هل تسمعينني؟

277
00:20:25,660 --> 00:20:26,920
.كوكورو-تشان

278
00:20:28,460 --> 00:20:31,830
ماذا سيفعل بطل المانغا
في موقف كهذا؟

279
00:20:31,830 --> 00:20:32,850
ماذا؟

280
00:20:39,550 --> 00:20:42,240
.لديك حسٌّ رائع في هذا المجال

281
00:20:42,240 --> 00:20:43,600
هل تعني ذلك حقًّا؟

282
00:20:45,230 --> 00:20:46,010
.المعذرة

283
00:20:46,010 --> 00:20:50,170
.وجدتها مبتكرة واستمتعت بقراءتها

284
00:20:56,510 --> 00:21:00,050
هل يمكنك قراءة المانغا خاصّتنا من فضلك؟

285
00:21:01,660 --> 00:21:03,770
...لحظة، أنا المسؤول عن استلام الأعمال لـ

286
00:21:04,080 --> 00:21:05,070
.تانبا-كُن

287
00:21:05,070 --> 00:21:05,640
ماذا؟

288
00:21:05,640 --> 00:21:06,330
.لا بأس

289
00:21:20,440 --> 00:21:21,900
.سيسعدني إلقاء نظرة عليها