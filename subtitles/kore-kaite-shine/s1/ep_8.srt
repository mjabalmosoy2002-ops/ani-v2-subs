1
00:00:06,850 --> 00:00:10,480
.ري-تشان، عيد ميلاد سعيد

2
00:00:12,870 --> 00:00:15,230
.تفضّلي، خذي هذا

3
00:00:17,880 --> 00:00:20,240
.دفتر مولسكين

4
00:00:23,070 --> 00:00:26,250
لطالما كنتِ تدوّنين أفكارك فيه، أليس كذلك؟

5
00:00:31,550 --> 00:00:34,930
.أعطني بعضًا من غوجينكا مع الماء أيّها الطّاهي

6
00:00:34,930 --> 00:00:35,800
.حاضر

7
00:00:35,800 --> 00:00:38,390
.لدينا بعض التّونة الجيّدة
هل تريدينها؟

8
00:00:39,120 --> 00:00:41,680
.حسنًا، عليّ أن أجرّبها بالتّأكيد

9
00:00:53,510 --> 00:00:55,950
،قد يبدو هذا أنانيًّا بعض الشّيء منّي

10
00:00:56,170 --> 00:00:58,950
لكنّني أريدك أن تستمرّي
.في رسم المانغا يا ري-تشان

11
00:01:05,960 --> 00:01:06,960
...أنا

12
00:01:09,800 --> 00:01:12,960
.أفكّر في التّقدم لامتحان التّوظيف للمعلّمين

13
00:01:21,210 --> 00:01:22,530
.فهمت

14
00:01:30,970 --> 00:01:31,960
.فهمت

15
00:02:06,830 --> 00:02:11,870
.ظلّت الحمم تغلي في جوفي لوقت طويل

16
00:02:13,080 --> 00:02:18,250
،حمم كانت تتأجّج باستمرار بداخلي
.حتّى حين بدا أنّني قد استنفدتها تمامًا

17
00:02:24,350 --> 00:02:25,550
.على الأقلّ في الماضي

18
00:04:23,770 --> 00:04:27,490
ياسومي-سان، هل قرّرتِ
ماذا سترسمين بعد ذلك؟

19
00:04:27,490 --> 00:04:29,910
.في الحقيقة، لا

20
00:04:30,670 --> 00:04:35,420
ربّما نفدت طاقتي الآن بعد أن تحقّق
.هدفنا بالذّهاب إلى كوميتيا

21
00:04:40,140 --> 00:04:43,420
إذا نفدت أفكارك، فأنت بحاجة
.إلى المزيد من التّلقّي

22
00:04:43,420 --> 00:04:44,930
!التّلقّي

23
00:04:45,320 --> 00:04:49,370
كنت أفكّر أن يكون كوميتيا
.الشّتاء هو مشروعك القادم

24
00:04:49,370 --> 00:04:53,430
هذا وقت كافٍ، فما رأيك بالبحث عن أماكن
في الجزيرة لاقتناص فرصة قد تلهمك؟

25
00:04:53,430 --> 00:04:54,850
في الجزيرة؟

26
00:04:54,850 --> 00:04:55,940
!فرصة للقنص

27
00:04:58,780 --> 00:05:01,160
".لا تقفوا خلفي"

28
00:05:01,160 --> 00:05:02,330
هكذا؟

29
00:05:02,640 --> 00:05:04,070
."قلتُ "اقتناص

30
00:05:04,070 --> 00:05:05,780
.لا ترى النّاس ما تحت أنفوها عادة

31
00:05:05,780 --> 00:05:09,140
ياسومي-سان، أليس الأمر قريبًا
منك إلى حدّ أنّك لم تنتبهي إليه؟

32
00:05:09,840 --> 00:05:12,750
ماذا عن الطّريق العظيم
المؤدّي إلى موتوماتشي؟

33
00:05:12,750 --> 00:05:15,040
.رأيتُ لمحات خاطفة له عندما مررنا بالسّيّارة

34
00:05:15,040 --> 00:05:17,190
هل تعرفين سينزو نو كيريتوشي؟

35
00:05:17,190 --> 00:05:18,130
.رأيتُ صورًا له

36
00:05:18,130 --> 00:05:19,300
صحراء أورا ساباكو؟

37
00:05:19,300 --> 00:05:20,460
.لم أزرها قطّ

38
00:05:22,200 --> 00:05:24,650
.أريد تسلّق جبل ميهارا

39
00:05:24,650 --> 00:05:27,090
!يا غبيّة! ستموتين إن تسلّقتِه في الصّيف

40
00:05:27,360 --> 00:05:29,380
.إنّه ليس جبلاً شاهقًا

41
00:05:29,380 --> 00:05:32,060
ستكنّ بخير طالما أنّكنّ حذرات
.من ضربات الشّمس

42
00:05:33,530 --> 00:05:36,790
صعدنا ذلك الجبل بنجاح تامّ
.في رحلتنا المدرسيّة في الابتدائيّة

43
00:05:36,790 --> 00:05:39,630
أظنّ أنّ الاسترخاء في الينابيع
.السّاخنة بعد ذلك سيكون رائعًا

44
00:05:39,630 --> 00:05:41,510
.أنا جاهزة لذلك في أيّ وقت

45
00:05:41,510 --> 00:05:43,650
هل سنقوم بهذا فعلاً؟

46
00:05:45,620 --> 00:05:50,030
بموافقة من أهاليكنّ، يمكنني توصيلكنّ
.بالسّيّارة، لأنّها رحلة للنّادي

47
00:05:50,030 --> 00:05:52,040
!رائع

48
00:05:52,040 --> 00:05:57,040
!مرحى! مرحى! مرحى

49
00:05:52,750 --> 00:05:57,040
لنستغلّ هذه الفرصة لزيارة
.جميع المواقع الأخرى أيضًا

50
00:05:58,830 --> 00:06:01,920
!أشعر وكأنّنا الآن في عطلة صيفيّة
!يا لها من أوقات ممتعة

51
00:06:01,920 --> 00:06:02,800
!مرحى

52
00:06:03,130 --> 00:06:04,810
.سأحضّر وجبات الغداء للجميع

53
00:06:04,810 --> 00:06:06,310
!أجل

54
00:06:06,310 --> 00:06:08,590
.أريد دجاجًا مقليًّا إضافيًّا في وجبتي

55
00:06:08,590 --> 00:06:09,800
.اتركي الأمر لي

56
00:06:09,800 --> 00:06:10,130
!أجل

57
00:06:10,130 --> 00:06:12,770
.سأذهب بدرّاجتي عندما يحلو لي ذلك

58
00:06:12,770 --> 00:06:15,200
سيكيريو-سان، ألستِ أنت من اقترحتِ هذا؟

59
00:06:15,200 --> 00:06:16,610
.إنّها غريبة بالفعل

60
00:06:16,610 --> 00:06:17,600
.نعم

61
00:06:18,160 --> 00:06:21,090
.هذا كلّ شيء لليوم

62
00:06:21,090 --> 00:06:23,750
.استأذنّ أهاليكنّ عند عودتكنّ إلى المنزل

63
00:06:23,750 --> 00:06:25,150
.حسنًا

64
00:06:31,780 --> 00:06:34,400
.ياسومين، سنغادر بدونك

65
00:06:34,400 --> 00:06:35,960
.سأوافيكنّ في الحال

66
00:06:39,920 --> 00:06:40,920
.ياسومي-سان

67
00:06:42,150 --> 00:06:43,770
.خذي هذا

68
00:06:47,460 --> 00:06:49,260
!يا له من دفتر أنيق

69
00:06:49,530 --> 00:06:52,370
.اعتدتُ أن أدوّن فيه أفكارًا للمانغا باستمرار

70
00:06:52,370 --> 00:06:53,510
فعلاً يا سينسي؟

71
00:06:53,790 --> 00:06:55,920
.إنّه تميمة حظّ لجلب الأفكار الجيّدة

72
00:06:55,920 --> 00:06:58,930
!شكرًا جزيلاً! سأعتني به جيّدًا

73
00:07:07,240 --> 00:07:11,330
.وجدتُ أخيرًا طريقةً للاستفادة من ذلك الدّفتر

74
00:07:12,540 --> 00:07:15,110
احتفظتِ به طوال هذا الوقت، أليس كذلك؟

75
00:07:19,590 --> 00:07:21,420
.دفتر سينسي

76
00:07:27,450 --> 00:07:30,220
.مهلاً، يبدو أنّ شيئًا ما قد مُسح منه هنا

77
00:07:30,700 --> 00:07:31,970
.معك حقّ

78
00:07:36,760 --> 00:07:38,220
...إذا فعلتُ هذا

79
00:07:38,880 --> 00:07:41,180
"...مائة فكرة"

80
00:07:43,810 --> 00:07:46,530
".مائة فكرة للمانغا أريد رسمها"

81
00:07:46,900 --> 00:07:50,400
قالت سينسي أنّها اعتادت
.على تدوين أفكارها هنا

82
00:07:51,240 --> 00:07:53,450
.أتساءل لماذا مسحتها

83
00:07:53,740 --> 00:07:56,330
...لا أعرف لماذا فعلت ذلك، لكن

84
00:07:56,330 --> 00:07:59,620
ياسومي، ماذا كان ليفعله بطل مانغا هنا؟

85
00:07:59,620 --> 00:08:00,470
!أجل

86
00:08:00,930 --> 00:08:02,120
!حسنًا

87
00:08:16,560 --> 00:08:20,580
ماذا لو كان هناك عالم آخر داخل تلك السّحابة؟

88
00:08:22,270 --> 00:08:25,470
.مدينة في السّماء من حضارة مندثرة

89
00:08:26,850 --> 00:08:27,940
.سأدوّن ملاحظة بهذا

90
00:08:27,940 --> 00:08:30,380
...قد يكون نفس المنظر الّذي نراه دائمًا

91
00:08:30,380 --> 00:08:32,030
.لكنّه مليء بالإلهام

92
00:08:32,030 --> 00:08:35,610
،مدينة في السّماء فكرة رائعة
لكن ماذا عن تحت الماء؟

93
00:08:34,780 --> 00:08:37,910
.تيسي، قميصك مميّز نوعًا ما بالفعل

94
00:08:37,910 --> 00:08:41,070
الملابس الفضفاضة ضروريّة
.عند البحث عن أفكار

95
00:08:43,530 --> 00:08:46,190
.عفوًا، تقول هيكارو-تشان أنّها ستتأخّر

96
00:08:46,190 --> 00:08:47,960
.غريبة بالفعل

97
00:08:55,300 --> 00:08:57,350
.مقطع الطّبقات الصّخريّة الكبير

98
00:08:57,350 --> 00:09:01,470
يبلغ ارتفاعه حوالي 24 مترًا
.وعرضه 630 مترًا

99
00:09:01,990 --> 00:09:04,270
،اكتُشف أثناء أعمال تشييد الطّريق

100
00:09:04,270 --> 00:09:09,930
وتشكّلت هذه البنية الضّخمة ذات الطّبقات
.نتيجة أكثر من 100 ثوران بركانيّ

101
00:09:16,740 --> 00:09:19,830
.أتمنّى لو أستطيع تناول كعكة باومكوخن الآن

102
00:09:19,830 --> 00:09:24,200
كم يجب أن يكون حجمك
لتأكلي شيئًا بهذا الحجم الهائل؟

103
00:09:24,200 --> 00:09:26,040
هل تعتقدين أنّ طعمها لذيذ؟

104
00:09:26,430 --> 00:09:28,570
...مهلاً، في هذه الحالة

105
00:09:31,690 --> 00:09:34,050
ربّما يكون شيئًا بهذا الحجم؟

106
00:09:41,540 --> 00:09:44,520
.وسيتساقط الفتات كالمطر بصوت مدوٍّ

107
00:09:44,520 --> 00:09:47,480
.أراهن أنّه عملاقٌ ذوّاقٌ حقيقيّ

108
00:09:47,480 --> 00:09:50,100
.لا شيء يضاهي العصر الكامبريّ

109
00:09:50,100 --> 00:09:54,820
.الطّعم الغنيّ واللّذيذ للحياة المركّزة

110
00:09:54,820 --> 00:09:58,080
وربّما يكون طعم العصر الطّباشيريّ مالحًا؟

111
00:09:58,080 --> 00:10:00,340
.تمهّلي. دعيني أدوّن كلّ هذا

112
00:10:01,800 --> 00:10:06,740
.لا يتجاوز عمر الصّخور الظّاهرة هنا 15000 عام

113
00:10:06,740 --> 00:10:08,880
.ربّما من الأفضل ألاّ أذكر ذلك

114
00:10:08,880 --> 00:10:12,960
.كعكة باومكوخن لذيذة جدًّا مع حليب أوشيما

115
00:10:13,290 --> 00:10:15,960
!كم أريد بعضًا منها

116
00:10:28,640 --> 00:10:31,410
!مهلاً. مرحبًا

117
00:10:32,070 --> 00:10:34,320
.سينزو نو كيريتوشي

118
00:10:34,320 --> 00:10:36,560
.درج حجريّ تحيط به شجرتان عملاقتان

119
00:10:36,560 --> 00:10:41,160
.مكان ساحر يكاد يكون مدخلاً لعالم آخر

120
00:10:45,310 --> 00:10:47,160
!هيكارو-تشان

121
00:10:47,660 --> 00:10:49,360
.أنتنّ بطيئات جدًّا

122
00:10:49,360 --> 00:10:51,670
من منّا الّتي استيقظت متأخّرة؟

123
00:10:52,230 --> 00:10:54,340
.أحبّ هذا المكان

124
00:10:56,420 --> 00:11:00,270
يبدو هذا المسار وكأنّه تشكّل بعد
.أن انقسمت شجرة إلى نصفين

125
00:11:00,270 --> 00:11:01,640
!بكلّ تأكيد

126
00:11:04,890 --> 00:11:08,380
لننطلق في رحلة عبر الممرّ داخل
،الشّجرة الّذي ينفتح مرّة كلّ مائة عام

127
00:11:08,380 --> 00:11:11,040
.وسنجد مملكة يسكنها قوم الشّجر

128
00:11:11,530 --> 00:11:13,520
ومن يكون "قوم الشّجر"؟

129
00:11:13,520 --> 00:11:18,880
كائنات نباتيّة ذكيّة سلكت مسارًا
.تطوّريًّا مختلفًا تمامًا عن مسارنا

130
00:11:18,880 --> 00:11:23,530
تنتظر فرصتها لإزاحة البشر عن عرشهم
.بصفتها أسمى أشكال الحياة على الأرض

131
00:11:23,750 --> 00:11:26,890
انظرن جيّدًا وسترين أنّ جميع
.الأشجار هي في الواقع كائنات حيّة

132
00:11:26,890 --> 00:11:30,430
.لا تتحرّك إلاّ في الخفاء تحت ضوء القمر

133
00:11:31,130 --> 00:11:33,930
أشجار الأرْز، الّتي نضجت مع
.مرور الزّمن، هي شيوخ القوم

134
00:11:33,930 --> 00:11:36,750
.وتحتها، نجد السّاسة، وهي أشجار الصّنوبرّ

135
00:11:36,750 --> 00:11:39,410
أمّا أشجار الكاكي والخوخ
،والكستناء، فهي عامّة النّاس

136
00:11:39,410 --> 00:11:42,800
في حين تمثّل النّباتات الأقصر
.عمرًا الطّبقة الدّنيا

137
00:11:43,310 --> 00:11:49,100
،في يومٍ من الأيّام، تنبت زهرة الصّباح
.الّتي زرعها الإنسان بعناية، لتساعد البشريّة

138
00:11:50,650 --> 00:11:52,850
هل خطرت لك هذه الفكرة للتّوّ؟

139
00:11:53,250 --> 00:11:55,140
!هذا مذهل

140
00:11:54,100 --> 00:11:57,110
.صديقات نشاركهنّ خيالنا الجامح

141
00:11:57,640 --> 00:11:58,600
!يا له من أمرٍ ثمين

142
00:12:00,130 --> 00:12:02,530
!تيسي تبكي على قوم الشّجر

143
00:12:02,530 --> 00:12:06,100
ياسومي، استمرّي في الكتابة
.قدر استطاعتك

144
00:12:06,100 --> 00:12:06,890
.حسنًا

145
00:12:08,490 --> 00:12:10,440
.ضريح هاجيكاما

146
00:12:10,440 --> 00:12:12,950
يُضفي ضوء الشّمس المتخلّل على الطّريق
،المؤدّي إلى الضّريح جمالاً خلاّبًا

147
00:12:12,950 --> 00:12:18,880
ومنقوشٌ بالقرب منه حكايةُ شباب
.أنقذوا قريتهم من قاضٍ شرّير

148
00:12:23,900 --> 00:12:25,130
.صحراء أورا ساباكو

149
00:12:25,490 --> 00:12:29,100
المكان الوحيد في اليابان المصّنف
.رسميًّا كصحراء

150
00:12:29,390 --> 00:12:33,770
عندما ترون النّباتات تزدهر في هذه
،البيئة الّتي تبدو وكأنّها من كوكب آخر

151
00:12:33,770 --> 00:12:37,610
.ستدركون مدى قدرة الحياة على الصّمود

152
00:12:40,640 --> 00:12:42,090
.جبل ميهارا

153
00:12:42,470 --> 00:12:45,420
.بركان يقع في قلب أوشيما

154
00:12:45,420 --> 00:12:50,540
كان يُبجّل في العصور القديمة باسم
.غوجينكا-ساما، وهو رمز الجزيرة

155
00:12:51,210 --> 00:12:55,180
.حسنًا يا فتيات. آخر ما نصعده هو هذا الجبل

156
00:12:55,180 --> 00:12:56,390
!مرحى

157
00:12:57,250 --> 00:12:59,240
هل ستصعدينه بهذه الملابس؟

158
00:12:59,240 --> 00:13:00,550
نعم. وماذا في ذلك؟

159
00:13:00,950 --> 00:13:01,690
.حسنًا

160
00:13:02,050 --> 00:13:03,700
.هيّا بنا

161
00:13:03,700 --> 00:13:05,050
!أجل

162
00:13:07,850 --> 00:13:10,040
.أنا مُرهَقة

163
00:13:10,040 --> 00:13:11,560
.كان ذلك سريعًا

164
00:13:11,560 --> 00:13:16,560
هيكارون، ما زلت بخير رغم
كونك من سكّان طوكيو المدلّلين؟

165
00:13:16,560 --> 00:13:20,520
،عندما تشتدّ الصّعاب
.أُصفّي ذهني من كلّ الأفكار

166
00:13:20,960 --> 00:13:21,920
تصفّين ذهنك؟

167
00:13:21,920 --> 00:13:22,900
.أصفّيه

168
00:13:22,900 --> 00:13:24,090
هكذا؟

169
00:13:26,460 --> 00:13:27,370
.هكذا

170
00:13:32,750 --> 00:13:35,010
.هذا ممتع للغاية

171
00:13:35,010 --> 00:13:38,110
الأمر مختلف تمامًا عن المجيء
.إلى هنا في رحلة مدرسيّة

172
00:13:38,110 --> 00:13:39,330
.أجل

173
00:13:42,230 --> 00:13:46,340
عند البحث عن أفكار، يبدو كلّ
.شيء وكأنّه مادّة للمانغا

174
00:14:03,830 --> 00:14:07,200
!الجزيرة الّتي أعيش فيها رائعة للغاية

175
00:14:18,540 --> 00:14:22,330
لا أصدّق أنّنا كنّا نصعد هذا
.منذ وقت ليس ببعيد

176
00:14:22,840 --> 00:14:25,710
.إنّه هذا يُجسّد "الصّيف" بكلّ معنى الكلمة

177
00:14:29,680 --> 00:14:33,170
بالحديث عن الصّيف، هل ترغبن
في مشاهدة الألعاب النّاريّة غدًا؟

178
00:14:33,170 --> 00:14:34,730
.بالتّأكيد

179
00:14:34,730 --> 00:14:35,600
.وأنا أيضًا

180
00:14:35,600 --> 00:14:37,030
.وأنا كذلك

181
00:14:37,030 --> 00:14:39,300
.تيسي، أوصلينا

182
00:14:39,300 --> 00:14:41,520
.لستُ سائقتكنّ

183
00:14:47,380 --> 00:14:51,030
!بدأتُ أشعر بالحماسة الآن

184
00:14:51,480 --> 00:14:54,130
ما هذه الملابس الطّويلة الفضفاضة؟

185
00:14:54,130 --> 00:14:56,030
زيّ تقليديّ للجزيرة؟

186
00:14:56,030 --> 00:14:58,330
ألم تسمعي من قبل عن اليوكاتا؟

187
00:14:59,250 --> 00:15:04,130
في الحقيقة، ساعدتنا والدة
.فوجيموري-سان على ارتدائها

188
00:15:04,130 --> 00:15:07,430
قالت أنّه يجب عليكنّ جميعًا
.المجيء مرّة أخرى يومًا ما

189
00:15:07,430 --> 00:15:09,870
.لنُقِم ليلة مبيت لنادي المانغا

190
00:15:09,870 --> 00:15:11,340
.في جناح فاخر

191
00:15:11,340 --> 00:15:13,090
.لا تتحمّسي كثيرًا

192
00:15:13,330 --> 00:15:14,480
.اسمعن

193
00:15:14,480 --> 00:15:17,970
أوصلتكنّ إلى هنا لتستوحين
.المزيد من الأفكار

194
00:15:17,970 --> 00:15:22,060
—حاولن ألاّ تكتفين بالاستمتاع بالمهرجان، بل

195
00:15:20,700 --> 00:15:22,060
ماذا نأكل؟

196
00:15:22,060 --> 00:15:23,770
.ثمّة خيارات كثيرة جدًّا

197
00:15:24,010 --> 00:15:26,370
.لم يسبق لي حضور مهرجان من قبل

198
00:15:26,370 --> 00:15:28,140
.أشعر بالحماسة الآن

199
00:15:28,140 --> 00:15:29,390
—انتظرن لـ

200
00:15:33,520 --> 00:15:34,530
.شكرًا

201
00:15:34,530 --> 00:15:36,790
.إنّها حلوة ولذيذة

202
00:15:36,790 --> 00:15:37,870
.تفضّلي

203
00:15:37,870 --> 00:15:41,860
هل تفضّلن لعق أو قضم
التّفاح المسكَّر عند تناوله؟

204
00:15:38,110 --> 00:15:42,210
!اقتربوا! تفّاح مسكَّر حلو ولذيذ

205
00:15:42,210 --> 00:15:43,720
.أنا أقضمه

206
00:15:51,320 --> 00:15:53,890
.فوجيمون، إنّك بارعة جدًّا

207
00:15:53,890 --> 00:15:55,560
.لا تُكلّميني الآن

208
00:16:00,390 --> 00:16:02,610
.تبدو هيكارو-تشان كمحترفة

209
00:16:03,800 --> 00:16:05,400
.لكنّها سيّئة

210
00:16:05,400 --> 00:16:07,650
.تفضّلي جائزة شفقة لك

211
00:16:07,960 --> 00:16:11,150
.اختاري شيئًا. خذي ما يُعجبك

212
00:16:11,150 --> 00:16:12,790
.اختاري ما تريدين

213
00:16:12,790 --> 00:16:14,660
.هيّا، اختاري ولا تخافي

214
00:16:15,400 --> 00:16:16,620
.هذا ظريف

215
00:16:16,620 --> 00:16:18,350
زهرة كاميليا؟

216
00:16:18,350 --> 00:16:20,350
.كان عليك اختيار شيء صالح للأكل

217
00:16:31,380 --> 00:16:35,050
.يمكن تأليف مانغا عن لحظات ممتعة كهذه

218
00:16:35,690 --> 00:16:37,050
.إذًا فقد لاحظت ذلك

219
00:16:37,050 --> 00:16:40,810
ماذا لو كان هناك مهرجان للعمالقة؟

220
00:16:41,230 --> 00:16:45,690
يا رفاق، هل تحبّون لعق
أحجاركم المُغطّاة بالسّكّر؟

221
00:16:45,690 --> 00:16:47,780
.لا، بل نفضّل عضّها

222
00:16:48,820 --> 00:16:50,930
.ربّما هذا ما سيتحدّثون عنه

223
00:16:50,930 --> 00:16:53,450
.أراهن أنّ تنّينًا سيضعها في فمه فحسب

224
00:16:53,450 --> 00:16:57,950
يمكن أيضًا توسيع نطاق لعبة
.صيد السّمك الذّهبيّ

225
00:17:00,330 --> 00:17:02,500
.مثل صيد الأسماك القديمة

226
00:17:02,500 --> 00:17:04,010
!صحيح، صحيح

227
00:17:04,010 --> 00:17:07,210
وماذا لو دخل إنسانٌ إلى مهرجانهم؟

228
00:17:07,210 --> 00:17:10,400
.صيّادٌ فاشلٌ في الرّماية

229
00:17:10,400 --> 00:17:13,760
...وثمّ... لنرَ

230
00:17:16,680 --> 00:17:19,800
.سيلتقي بأميرة شجرة الكاميليا ويقع في حبّها

231
00:17:21,030 --> 00:17:25,060
ولا بدّ أن تكون زهرة الصّباح الّتي
.يعتني بها الصّياد الّتي تجمع بينهما

232
00:17:25,060 --> 00:17:28,980
.ثمّ يقترب التّنّين الّذي يُدمّر كلّ شيء

233
00:17:30,710 --> 00:17:31,680
.كلاّ

234
00:17:31,680 --> 00:17:32,970
ماذا سيحدث بعد ذلك؟

235
00:17:33,730 --> 00:17:34,810
!يا له من أمرٍ ثمين

236
00:17:36,130 --> 00:17:38,700
!تيسي تبكي على طبق الياكيسوبا

237
00:17:39,140 --> 00:17:42,200
.شكرًا جزيلاً على انتظاركم

238
00:17:42,460 --> 00:17:48,210
سيبدأ عرض الألعاب النّاريّة الّذي
.سيختتم مهرجان الصّيف قريبًا

239
00:17:52,720 --> 00:17:55,010
.لنشاهده من هناك

240
00:18:00,580 --> 00:18:01,590
.سينسي

241
00:18:05,590 --> 00:18:07,040
.شكرًا لك

242
00:18:12,730 --> 00:18:14,440
.عليّ تدوين كلّ ما سبق

243
00:18:15,370 --> 00:18:18,450
.أرى أنّك تستفيدين من الدّفتر بشكل جيّد

244
00:18:19,990 --> 00:18:22,100
هل تودّين إلقاء نظرة؟

245
00:18:22,780 --> 00:18:23,580
.بالتّأكيد

246
00:18:40,760 --> 00:18:42,010
...هذه

247
00:18:43,350 --> 00:18:44,060
.نعم

248
00:18:50,980 --> 00:18:54,110
.أشعل هذا العنوان الرّائع حماستي حقًّا

249
00:18:54,800 --> 00:18:58,760
لكنّني لم أستطع منع
.نفسي أثناء استكشافنا للجزيرة

250
00:18:58,760 --> 00:19:01,450
ظللتُ أجد المزيد من الأشياء
.الّتي أرغب في رسمها

251
00:19:06,410 --> 00:19:07,700
.فهمت

252
00:19:08,060 --> 00:19:10,640
.لم تكن تنقصها الأفكار للرّسم

253
00:19:16,730 --> 00:19:17,880
.بل كان لديها الكثير

254
00:19:28,400 --> 00:19:30,340
.ها أنتنّ هنا

255
00:19:31,450 --> 00:19:33,020
.نانا-تشان

256
00:19:33,240 --> 00:19:35,040
.لقد اخترتنّ مكانًا رائعًا

257
00:19:35,460 --> 00:19:37,280
.يمكنكِ الجلوس هنا

258
00:19:37,650 --> 00:19:40,580
ما هذه الأشياء اللاّمعة في السّماء؟

259
00:19:40,580 --> 00:19:42,780
ألا تعرفين شيئًا عن الألعاب النّاريّة أيضًا؟

260
00:19:47,560 --> 00:19:50,210
!تامايا

261
00:19:52,440 --> 00:19:56,330
.ارسمي الكثير من المانغا رجاءً

262
00:19:57,690 --> 00:19:59,080
.كهواية، بالطّبع

263
00:19:59,520 --> 00:20:00,220
.أكيد

264
00:20:08,060 --> 00:20:11,400
.ري-تشان، عيد ميلاد سعيد

265
00:20:15,390 --> 00:20:17,320
دفتر آخر من تلك الدّفاتر؟

266
00:20:17,540 --> 00:20:20,020
.وعيد ميلادي ليس اليوم

267
00:20:23,400 --> 00:20:27,200
،يبدو أنّك تستمتعين هذه الأيّام
...لذا قلتُ لنفسي ربّما

268
00:20:31,160 --> 00:20:36,220
ما زلتُ أريدك أن تستمرّي
.في رسم المانغا يا ري-تشان

269
00:20:41,330 --> 00:20:44,000
.أعطني بعضًا من غوجينكا مع الماء أيّها الطّاهي

270
00:20:44,000 --> 00:20:44,860
.في الحال

271
00:21:00,010 --> 00:21:02,780
ظللتُ أفكّر في المزيد من
.الأشياء الّتي أردتُ رسمها