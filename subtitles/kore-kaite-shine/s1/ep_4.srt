1
00:00:03,100 --> 00:00:06,220
.بناء رفوف الكتب أمر مُرهق للغاية

2
00:00:06,220 --> 00:00:07,480
.بالتّوفيق

3
00:00:07,770 --> 00:00:10,990
ما-ما هي المانغا الّتي تُفضّلانها؟

4
00:00:11,550 --> 00:00:13,990
.أحبّ المانغا الحماسيّة

5
00:00:13,990 --> 00:00:15,990
!فوجيتا كازوهيرو للأبد

6
00:00:15,990 --> 00:00:17,750
.سأقرأ أيّ شيء

7
00:00:17,750 --> 00:00:20,470
لكنّني أحبّ مانغا تيشيما-سينسي
.أكثر من غيرها

8
00:00:20,470 --> 00:00:21,500
ماذا عنك أنت؟

9
00:00:21,850 --> 00:00:26,410
...أنا... أنا لا أقرأ الكثير من المانغا

10
00:00:27,180 --> 00:00:29,750
.لكنّي أحبّ موروهوشي دايجيرو-سينسي

11
00:00:29,970 --> 00:00:30,740
!آه

12
00:00:30,740 --> 00:00:32,180
!يكاد يكون هذا مؤلمًا

13
00:00:32,180 --> 00:00:33,910
.أعماله رائعة

14
00:02:06,630 --> 00:02:08,310
.حسنًا

15
00:02:08,310 --> 00:02:10,370
!لقد فعلناها

16
00:02:11,520 --> 00:02:12,770
.أحسنتنّ

17
00:02:13,190 --> 00:02:15,650
هناك بعض التّاياكي البارد
.من فونتين للاحتفال

18
00:02:16,640 --> 00:02:18,150
.بوركتِ

19
00:02:18,870 --> 00:02:20,870
.يبدو المكان أكثر ترتيبًا الآن

20
00:02:20,870 --> 00:02:22,510
.تيشيما-سينسي

21
00:02:22,510 --> 00:02:25,890
إذا كنتنّ سترسمن المانغا هنا، فسيكون
.من المفيد وجود كراسٍ وطاولة

22
00:02:25,890 --> 00:02:28,230
،في المرّة القادمة
.سأحضر ما لديّ من المنزل

23
00:02:28,230 --> 00:02:29,890
.سيكون ذلك رائعًا

24
00:02:29,890 --> 00:02:32,630
.المكان صغير جدًّا. يا إلهي، كم هو ضيّق

25
00:02:32,630 --> 00:02:34,420
.آسفة على ذلك

26
00:02:34,420 --> 00:02:37,670
نانا-تشان. أنت لست عضوة
.في النّادي، لذا ارحلي

27
00:02:37,670 --> 00:02:39,180
.بئسًا

28
00:02:39,480 --> 00:02:41,930
هل ستستخدمن الأدوات الرّقميّة
أم التّناظريّة في الرّسم؟

29
00:02:41,930 --> 00:02:43,650
.حسنًا

30
00:02:42,270 --> 00:02:46,400
.تكلفة الأدوات الرّقميّة 100 ألف ينّ
—أمّا التّقليديّة، فحواليّ 1000 ينّ

31
00:02:46,400 --> 00:02:47,520
!التّقليديّة رجاءً

32
00:02:47,520 --> 00:02:50,170
لا مانع لديّ من إعارتكنّ بعض
.المعدّات من منزلي

33
00:02:50,730 --> 00:02:52,270
ولكن ماذا عنك؟

34
00:02:52,270 --> 00:02:53,740
—لن أرسم ثانية

35
00:02:53,740 --> 00:02:54,980
!التّقليديّة إذًا

36
00:02:54,980 --> 00:02:57,190
يمكننا الانتقال إلى الرّسم
.الرّقميّ حالما ندّخر المال اللاّزم

37
00:02:57,500 --> 00:03:01,730
،كما ذكرتُ سابقًا، على مستوى الهواية فقط

38
00:03:01,730 --> 00:03:04,160
.أودّ أن أعرف أهدافكنّ

39
00:03:04,160 --> 00:03:09,760
رسم مانغا شيّقة تُرضيني، على ما أعتقد؟

40
00:03:09,760 --> 00:03:13,630
أنا سعيدة طالما أستطيع رسم
.مانغا ياسومي-سان

41
00:03:13,950 --> 00:03:16,830
.الاسترخاء هنا وقراءة الكثير من المانغا

42
00:03:16,830 --> 00:03:18,190
!اعتدلي يا أكافوكو

43
00:03:18,190 --> 00:03:20,490
.لا بأس إن كانت هذه أهداف هوايتك

44
00:03:20,490 --> 00:03:21,540
!مرحى

45
00:03:21,540 --> 00:03:22,640
لا تمانع هذا؟

46
00:03:23,130 --> 00:03:26,220
لا ينبع الإبداع من تلقّي
.الأوامر بشأن ما نبتكر

47
00:03:26,770 --> 00:03:29,520
.أطلقن العنان لإبداعكنّ الفنّيّ في الرّسم

48
00:03:30,140 --> 00:03:30,770
.مع السّلامة

49
00:03:30,770 --> 00:03:31,290
ماذا؟

50
00:03:31,290 --> 00:03:34,660
أليس لديك أيّ نصيحة لنا؟

51
00:03:36,980 --> 00:03:40,690
ياسومي-سان، المانغا الّتي أريتني
.إيّاها تفتقر إلى التّماسك

52
00:03:40,690 --> 00:03:45,670
تدرّبي على كتابة خاتمات مناسبة، واحرصي
.أن تكون بين أربع إلى ثماني صفحات

53
00:03:45,670 --> 00:03:46,740
.هذا منطقيّ

54
00:03:46,740 --> 00:03:51,070
أكافوكو-سان، اقرئي من فضلك
.كلّ أعمالها وشاركينا أفكارك عنها

55
00:03:51,070 --> 00:03:52,350
!أوكي واتش

56
00:03:52,350 --> 00:03:55,920
.سأطمئنّ عليكنّ يوميًّا
.سأجيب على أسئلتكنّ حينها

57
00:03:56,290 --> 00:03:58,670
أرجو أن تبذلن قصارى جهدكنّ
.في حدود الهواية

58
00:03:58,670 --> 00:03:59,510
.سلام

59
00:04:01,200 --> 00:04:04,660
أشعر وكأنّ مونتاجَ تدريبٍ كما
.في المانغا وشيك الحدوث

60
00:04:04,660 --> 00:04:06,850
!بدأتُ أتحمّس الآن

61
00:04:07,080 --> 00:04:08,100
!لنعمل بجدّ

62
00:04:08,370 --> 00:04:09,350
!أكيد

63
00:04:10,410 --> 00:04:13,670
!سوبوتي كواسوبيشي" ممتعة جدًّا"

64
00:04:13,670 --> 00:04:15,850
.ذلك يتضمّنك أيضًا يا أكافوكو

65
00:04:22,370 --> 00:04:26,340
رسمتُ مانغا قصيرة من بطولة
.نيانتا، لكنّها لم تكن مكتملة تمامًا

66
00:04:26,340 --> 00:04:29,240
.لا، إنّها رائعة. دعيني أحاول رسمها

67
00:04:37,500 --> 00:04:38,840
مهلاً، هل انتهيتما منها؟

68
00:04:40,340 --> 00:04:44,240
.رسومات فوجيمون جيّدة، لكنّها تنتهي فجأة

69
00:04:44,240 --> 00:04:45,760
هل نسيتِ النّهاية؟

70
00:04:46,060 --> 00:04:48,510
...بالمقارنة برسومات فوجيمون

71
00:04:50,730 --> 00:04:52,930
.هذا ما أتوقّعه من المبتدئين

72
00:04:53,450 --> 00:04:55,860
.رسمك رائع يا فوجيموري-سان

73
00:04:56,480 --> 00:04:59,880
حاولي الرّسم على هذه الورقة المخصّصة
.للمخطوطات من الآن فصاعدًا

74
00:04:59,880 --> 00:05:01,700
ما نوع القلم الّذي تستخدمينه؟

75
00:05:01,700 --> 00:05:04,530
يمكنكِ الحصول على خطوط أنظف
...باستخدام قلم التّخطيط

76
00:05:08,530 --> 00:05:12,160
،من الصّعب إنهاء القصص الطّموحة
.لذا حاولتُ تبسيطها

77
00:05:12,160 --> 00:05:14,420
تدور هذه القصّة حول نيانتا
.وهو يستمتع بوجبته

78
00:05:14,420 --> 00:05:16,710
.إنّها ظريفة! دعيني أحاول رسمها

79
00:05:21,590 --> 00:05:24,610
.فوجيمون، رسمك بالقلم رائع

80
00:05:24,610 --> 00:05:27,840
.أين الحبكة؟ إنّها قصّة عن نيانتا يأكل فحسب

81
00:05:28,080 --> 00:05:30,880
.جرّبي استخدام قلم تحديد رفيع لحدود اللّوحات

82
00:05:30,880 --> 00:05:33,830
اجعلي الفواصل الأفقيّة أكثر
.سُمكًا من الفواصل الرّأسيّة

83
00:05:33,830 --> 00:05:36,520
!يا له من تظليل متقاطع جميل

84
00:05:34,140 --> 00:05:36,520
.قولي شيئًا عن الكتابة

85
00:05:36,860 --> 00:05:41,830
سأبهرهنّ هذه المرّة. شيء بسيط
.ذو تأثير ولمسة مثيرة للاهتمام

86
00:05:41,830 --> 00:05:44,820
.هذا الرّسم من فوجيموري-سان رائع

87
00:05:42,960 --> 00:05:44,820
...بالمقارنة برسومات فوجيمون

88
00:05:45,150 --> 00:05:46,620
...الكتابة

89
00:05:46,620 --> 00:05:48,120
...ياسومي-سان، قصصك

90
00:05:48,120 --> 00:05:49,280
نـ-نعم؟

91
00:05:49,280 --> 00:05:53,290
،غالبًا ما تقع في أشكال نمطيّة
.لذا خصّصي وقتًا أطول للتّخطيط

92
00:05:53,660 --> 00:05:57,290
في المرّة القادمة، أودّ إلقاء نظرة قبل
.أن تعيد فوجيموري-سان رسمها

93
00:06:07,750 --> 00:06:08,720
.ياسومي-سان

94
00:06:09,310 --> 00:06:12,080
تصعدين التّلّة إلى المدرسة
كلّ يوم، أليس كذلك؟

95
00:06:12,080 --> 00:06:14,850
هل تمانعين انضمامي إليك غدًا؟

96
00:06:18,420 --> 00:06:19,870
.ربّما في وقت آخر

97
00:06:27,100 --> 00:06:29,790
ما بك؟ هل استسلمت؟

98
00:06:30,100 --> 00:06:32,990
ما الّذي يجعل المانغا مثيرة للاهتمام؟

99
00:06:33,580 --> 00:06:35,290
.صوتك مبحوح

100
00:06:35,290 --> 00:06:38,500
بوكوتا، أليس من واجبك أن تُبهجني؟

101
00:06:38,500 --> 00:06:42,340
.هذا طلب كبير، فأنا كلّ ما يدور في رأسك

102
00:06:42,340 --> 00:06:45,800
.عندما تكونين حزينة، أشعر بنفس الفتور

103
00:06:47,340 --> 00:06:51,010
لكنّني أستطيع أن أعرف
.ما تريدينه في أعماقك

104
00:06:51,740 --> 00:06:53,140
.اطلبي المساعدة

105
00:06:53,140 --> 00:06:54,220
المساعدة ممّن؟

106
00:06:54,220 --> 00:06:57,220
صديقتك. ألم تجدي شريكة؟

107
00:06:58,980 --> 00:07:02,950
،أنا موجود لأنّه لم يكن لديك أصدقاء

108
00:07:03,360 --> 00:07:06,730
.لكن ربّما لن أبقى طويلاً في هذا العالم

109
00:07:07,770 --> 00:07:09,650
!بوكوتا

110
00:07:10,470 --> 00:07:12,820
.مع أنّي لن أختفي فجأة

111
00:07:13,900 --> 00:07:15,900
.كوني صادقة مع نفسك

112
00:07:22,670 --> 00:07:23,780
.ياسومي-سان

113
00:07:26,740 --> 00:07:30,190
هل تريدين صعود التّلّة معًا؟

114
00:07:38,150 --> 00:07:41,000
هـ-هل يمكنك التّمهّل قليلاً؟

115
00:07:42,040 --> 00:07:43,470
!أ-أنا آسفة

116
00:07:46,590 --> 00:07:48,800
.أنا آسفة يا فوجيموري-سان

117
00:07:50,000 --> 00:07:54,660
أعلم أنّك بذلت جهدًا أكبر منّي
.لتنالي إطراء الجميع

118
00:07:55,390 --> 00:07:57,160
.أنا آسفة، سمحتُ للأمر بالتّأثير عليّ

119
00:07:58,360 --> 00:08:00,950
.أ-أ-أرجوك لا تعتذري

120
00:08:05,980 --> 00:08:07,940
...أنا

121
00:08:08,800 --> 00:08:10,560
.أنا أكبر معجبة بك

122
00:08:17,500 --> 00:08:21,400
!فوجيموري-سان

123
00:08:25,590 --> 00:08:27,690
،لمعرفة المزيد عن المانغا القصيرة

124
00:08:28,020 --> 00:08:31,090
كنتُ أقرأ الكثير من المانغا المنشورة
.على مواقع التّواصل الاجتماعيّ

125
00:08:31,510 --> 00:08:34,940
،بينما كنتُ غارقةً في حزني
...كانت فوجيموري-سان

126
00:08:35,260 --> 00:08:37,160
.هذا هو الفرق بيننا

127
00:08:37,450 --> 00:08:39,050
هل وجدتِ شيئًا جيّدًا؟

128
00:08:39,050 --> 00:08:41,620
.أعمال ستون دراغون-سان هي المفضلة لديّ

129
00:08:41,620 --> 00:08:46,420
ستون دراغون"؟"
لماذا يبدو هذا الاسم مألوفًا جدًّا؟

130
00:08:46,420 --> 00:08:47,630
هل أنت غبيّة؟

131
00:08:48,710 --> 00:08:50,140
.قابلتها في كوميتيا

132
00:08:50,140 --> 00:08:53,990
هذا مذهل! إنّها مشهورة جدًّا الآن
.على مواقع التّواصل الاجتماعيّ

133
00:08:54,760 --> 00:08:56,300
.لديها أكثر من 50 ألف متابع

134
00:08:57,010 --> 00:09:01,120
تنتهي مانغا خاصّتها دائمًا بصفحة من
.لوحة واحدة كاملة، وهذا رائع برأيي

135
00:09:01,960 --> 00:09:03,640
.يا لها من روعة

136
00:09:03,640 --> 00:09:09,230
حاولتُ تقليدها برسم صفحة بلوحة
.واحدة من المانغا خاصّتك

137
00:09:09,470 --> 00:09:10,760
!أريني، أريني

138
00:09:11,810 --> 00:09:13,900
.شيء كهذا

139
00:09:15,630 --> 00:09:16,740
!رائع

140
00:09:17,420 --> 00:09:21,290
سيكون الأمر مثيرًا للغاية لو استطعتُ
.إنهاء المانغا خاصّتي برسمة كهذه

141
00:09:21,770 --> 00:09:24,640
.دائمًا ما أحتاج لصفحات أكثر للنّصف الثّاني

142
00:09:27,380 --> 00:09:29,780
!مهلاً! وجدتُها

143
00:09:30,910 --> 00:09:32,140
.انتهيتُ من رسمها

144
00:09:34,890 --> 00:09:36,510
.إنّها متماسكة جيّدًا

145
00:09:36,510 --> 00:09:38,300
ما رأيك بهذه يا أكافوكو؟

146
00:09:38,300 --> 00:09:40,290
.متماسكة لدرجة الملل

147
00:09:40,290 --> 00:09:41,560
...يا لك من

148
00:09:43,060 --> 00:09:44,180
ما رأيك؟

149
00:09:44,180 --> 00:09:45,910
.متوقّعة

150
00:09:47,370 --> 00:09:48,250
ما رأيك؟

151
00:09:48,250 --> 00:09:49,710
.لا أطيق كلّ هذه التّحوّلات في الأحداث

152
00:09:50,420 --> 00:09:51,770
ما رأيك؟

153
00:09:55,700 --> 00:09:57,670
.أعتقد أنّها متقنة جيّدًا

154
00:09:57,670 --> 00:09:59,350
!مرحى

155
00:09:59,350 --> 00:10:01,780
كيف خطرت لك هذه القصّة؟

156
00:10:01,780 --> 00:10:05,380
حسنًا، أوّلاً، رسمت فوجيموري-سان
،رسمةً لافتةً للنّظر

157
00:10:05,380 --> 00:10:10,800
ثمّ عملتُ عكسيًّا لأضع حبكةً
.انتهي بلوحتها الرّائعة

158
00:10:10,800 --> 00:10:15,170
ثمّ انتقدت أكافوكو القصّة، فأعدتُ
.كتابتها لتصحيح جميع المشاكل

159
00:10:15,170 --> 00:10:20,840
،لكن كان لأكافوكو انتقادات كثيرة
...فظللنا نتبادل الآراء مرارًا وتكرارًا

160
00:10:21,200 --> 00:10:22,810
.كانت قصصك تفتقر للتّماسك

161
00:10:22,810 --> 00:10:26,400
لأنّك لم تضعي نهايةً محدّدة وكنت
.تُؤلّفين الأحداث بشكل مرتجل

162
00:10:26,400 --> 00:10:28,760
في كتاب تيزوكا أوسامو-سينسي
،عن كيفية رسم المانغا

163
00:10:28,760 --> 00:10:31,500
يشير إلى هذه الطّريقة في الكتابة
."باسم "الطّريقة الاستنتاجيّة

164
00:10:32,790 --> 00:10:36,110
الطّريقة التّي اكتشفتنّها بالصّدفة هي
."عكس ذلك تمامًا: "الطّريقة الاستقرائيّة

165
00:10:36,110 --> 00:10:39,130
في هذه الطّريقة، تتوصّلن إلى نهاية
.ثمّ تعملن بشكل عكسيّ

166
00:10:39,670 --> 00:10:41,950
.وهذا يُنتج سردًا متماسكًا

167
00:10:42,580 --> 00:10:44,120
.أحسنتنّ في اكتشاف ذلك

168
00:10:46,030 --> 00:10:49,990
هذا منطقيّ. كان يجب أن تخبرينا
.بذلك منذ البداية

169
00:10:49,990 --> 00:10:53,240
تعلّم النّظريّة دون تطبيق
.لن يفيدك بشيء

170
00:10:53,240 --> 00:10:55,900
.يجدر أن نكون جاهزات بهذا الآن

171
00:10:55,900 --> 00:10:58,260
!اكتشفنا سرّ رسم المانغا

172
00:10:58,260 --> 00:10:59,550
!رائع

173
00:10:59,550 --> 00:11:02,840
هل تعتقدن حقًّا أنّ الأمر بهذه السّهولة؟

174
00:11:02,840 --> 00:11:05,570
!خذن المانغا على محمل الجدّ

175
00:11:06,270 --> 00:11:08,970
.لا أستطيع قول ذلك لهنّ
.إنّهنّ يفعلن هذا كهواية

176
00:11:10,070 --> 00:11:14,090
.إنّها خطوة للأمام. واصلن العمل الجيّد

177
00:11:14,090 --> 00:11:15,380
!نعم

178
00:11:15,380 --> 00:11:18,550
حسنًا! سأستمرّ في انتقاد
.المانغا خاصّتكما بشدّة

179
00:11:18,550 --> 00:11:20,660
.أنت لئيمة جدًّا يا أكافوكو

180
00:11:20,660 --> 00:11:22,440
.تـ-ترأّفي بنا

181
00:11:22,440 --> 00:11:23,820
.لكما ذلك

182
00:11:24,350 --> 00:11:27,010
.لا، أكافوكو-سان رائعة كما هي

183
00:11:27,390 --> 00:11:30,000
.القرّاء مخلوقات متغطرسة

184
00:11:30,750 --> 00:11:32,580
.خيال ياسومي-سان الجامح

185
00:11:33,170 --> 00:11:34,630
.مهارات فوجيموري-سان في الرّسم

186
00:11:35,180 --> 00:11:37,500
.آراء أكافوكو-سان الموضوعيّة

187
00:11:38,110 --> 00:11:40,990
جميع الأدوات الأساسيّة اللاّزمة
.لرسم المانغا موجودة هنا

188
00:11:41,650 --> 00:11:45,010
...ولكن لتحفيزهنّ أكثر

189
00:11:46,490 --> 00:11:49,600
.لا يحتجن إلى مزيد من التّحفيز
.إنّها مجرّد هواية

190
00:11:49,880 --> 00:11:53,770
فعلتها! أوّل مرّة أتلقّى فيها
!إطراءً من تيشيما-سينسي

191
00:11:53,770 --> 00:11:54,650
.أنا سعيدة لأجلك

192
00:11:54,650 --> 00:11:55,610
.أحسنت

193
00:12:00,690 --> 00:12:03,860
.من هذه؟ لا أعرف زيّها المدرسيّ

194
00:12:14,590 --> 00:12:16,090
.أنا آسفة

195
00:12:18,060 --> 00:12:19,440
.المعذرة

196
00:12:24,330 --> 00:12:26,620
هل ترسمن المانغا أيضًا؟

197
00:12:26,620 --> 00:12:27,600
أيضًا"؟"

198
00:12:27,600 --> 00:12:31,060
.نعم. لقد بدأنا نادي مانغا مؤخّرًا

199
00:12:31,060 --> 00:12:33,600
.لكنّنا ما زلنا مبتدئات

200
00:12:33,820 --> 00:12:37,010
.سيكيريو-سان، عليك ملء أوراق الانتقال

201
00:12:37,010 --> 00:12:38,110
.أكيد

202
00:12:47,320 --> 00:12:48,650
.أظنّ أنّنا سنكون زميلات

203
00:12:49,120 --> 00:12:50,500
.سيكيريو-سان

204
00:12:50,500 --> 00:12:51,910
.حاضرة

205
00:12:52,530 --> 00:12:56,370
سيكيريو؟ سيكيريو؟ سيكيريو؟

206
00:12:57,460 --> 00:12:59,520
!ستون دراغون

207
00:12:59,520 --> 00:13:01,080
!ماذا؟

208
00:13:04,110 --> 00:13:06,470
.الكراسي والمكتب الّتي وعدتكنّ بها

209
00:13:06,470 --> 00:13:08,970
!رائع، مناسبة تمامًا

210
00:13:08,970 --> 00:13:10,350
!اندماج

211
00:13:10,350 --> 00:13:14,090
الآن وقد أصبح لديكنّ مكتب، اسمحن لي
.أن أقدّم بعض النّصائح حول الرّسم

212
00:13:14,840 --> 00:13:16,850
.عادت إلى عشّها

213
00:13:16,850 --> 00:13:21,480
،إذا كنتِ لن تستخدمي جهاز حاسوب
.فعليك كتابة النّصّ يدويًّا

214
00:13:21,840 --> 00:13:24,070
،ياسومي-سان، خطّك واضح وسهل القراءة

215
00:13:24,070 --> 00:13:26,830
لذا ارسمي حدود اللّوحات، واكتبي
.النّصّ، وأضيفي المؤثّرات الصّوتيّة

216
00:13:26,830 --> 00:13:30,090
!حسنًا! أُعجبت تيشيما-سينسي بعملي

217
00:13:30,090 --> 00:13:31,540
.خطّ يدك فقط

218
00:13:34,070 --> 00:13:38,470
لنحاول تحسين لوحات القصّة المكوّنة
.من أربع صفحات الّتي قدّمتِها قبل أيام

219
00:13:39,010 --> 00:13:40,910
.سترسم فوجيموري-سان الرّسومات الأوّليّة

220
00:13:41,330 --> 00:13:44,590
ياسومي-سان، اكتبي النّصّ
.في الأعلى بقلم حبر دقيق

221
00:13:45,580 --> 00:13:47,130
سـ-سينسي؟

222
00:13:47,660 --> 00:13:51,140
هل سيكون تزيين مربّعات
التّعليقات معقّدًا للغاية؟

223
00:13:51,140 --> 00:13:53,060
.يبدو ذلك رائعًا

224
00:13:53,060 --> 00:13:54,550
.وهنا يأتي دور هذا

225
00:13:54,920 --> 00:13:57,200
!تا-دا! صندوق إضاءة

226
00:13:57,200 --> 00:13:58,940
.قالت "تا-دا" بصوت مرتفع

227
00:13:59,280 --> 00:14:03,530
يُضيء صندوق الإضاءة الصّور من
.الأسفل، ممّا يسمح بتتبّعها

228
00:14:05,250 --> 00:14:08,190
بجعل فوجيموري-سان ترسم
،الحدود بأحجام أساسيّة قليلة

229
00:14:08,190 --> 00:14:10,280
.تستطيع ياسومي-سان إعادة رسمها

230
00:14:10,620 --> 00:14:14,310
ياسومي-سان، ارسمي الفقاعات
.واللّوحات بقلم رفيع

231
00:14:14,310 --> 00:14:16,680
.وهكذا انتهينا من الحدود

232
00:14:18,180 --> 00:14:19,570
!تبدو كأنّها مانغا حقيقيّة

233
00:14:21,320 --> 00:14:26,300
ياسومي-سان، فوجيموري-سان، أكملا أكبر
.عدد ممكن من الحدود والرّسومات المتبقّية

234
00:14:26,300 --> 00:14:28,820
—سينسي، شكرًا جزيـ

235
00:14:27,400 --> 00:14:28,050
.سلام

236
00:14:32,010 --> 00:14:34,770
هناك العديد من رؤوس الأقلام المختلفة
،الّتي يمكنك استخدامها للتّحبير

237
00:14:34,770 --> 00:14:37,510
ولكن بما أنّ فوجيموري-سان تُفضّل
.رأس التّخطيط، فسنستخدمه

238
00:14:38,190 --> 00:14:40,890
بمجرّد أن يجفّ الحبر، ستمسح
.ياسومي-سان آثار قلم الرّصاص

239
00:14:41,470 --> 00:14:45,460
ياسومي-سان، لوّني الأماكن الّتي
.× حدّدتها فوجيموري-سان بعلامة

240
00:14:45,460 --> 00:14:49,030
،إذا تسرّب أيّ حبر أسود
.يمكن تصحيحه بالحبر الأبيض

241
00:14:49,950 --> 00:14:52,410
!إنّها جميلة. لقد اكتملت الآن

242
00:14:52,410 --> 00:14:54,050
.لا، ليس تمامًا بعد

243
00:14:54,050 --> 00:14:57,070
!تا-دا! سنضع التّضليل المتدرّج غدًا

244
00:14:57,070 --> 00:14:58,910
.قالت "تا-دا!" بصوت عالٍ مرّة أخرى

245
00:14:59,180 --> 00:15:02,920
تيشيما-سينسي، تتحمّسين جدًّا
.عندما تتحدّثين عن المانغا

246
00:15:03,450 --> 00:15:04,310
.هذا ليس صحيحًا

247
00:15:04,310 --> 00:15:05,130
لِمَ لا؟

248
00:15:07,440 --> 00:15:10,690
سنقصّ ونضع التّضليل المتدرّج
،لتغطية مساحة أكبر من اللاّزم

249
00:15:10,690 --> 00:15:13,250
ثمّ سنستخدم سكّينًا حِرفيًّا
.لعمل شقوق أكثر دقّة

250
00:15:13,580 --> 00:15:15,800
،سننتزع التّضليل المتدرّج الزّائد
،وسنضع ورقة فوقه

251
00:15:15,800 --> 00:15:18,140
ثمّ سنكشطه بملعقة مسطّحة
.لتثبيته في مكانه

252
00:15:18,140 --> 00:15:19,650
!والآن، هذه هي المانغا

253
00:15:20,370 --> 00:15:23,650
وأخيرًا، سنستخدم الحبر الأبيض لإجراء
.التّصحيحات وإضافة التّفاصيل

254
00:15:24,660 --> 00:15:26,060
!لقد انتهينا

255
00:15:27,820 --> 00:15:29,680
.بذلتما الكثير من الجهد

256
00:15:29,680 --> 00:15:32,610
يمكننا التّفكير في مكان عرض
.هذه المانغا لاحقًا

257
00:15:32,610 --> 00:15:34,320
!تيشيما-سينسي

258
00:15:33,760 --> 00:15:34,320
.سلام

259
00:15:35,160 --> 00:15:36,090
.ليس مجدّدًا

260
00:15:39,550 --> 00:15:43,580
من كان يظنّ أنّ رسم أربع صفحات
سيستغرق كلّ هذا الوقت؟

261
00:15:43,580 --> 00:15:45,220
.أنا مرهقة

262
00:15:45,220 --> 00:15:47,090
.لم تُساعدي أبدًا يا أكافوكو

263
00:15:48,880 --> 00:15:50,370
!انتظرا لحظة

264
00:15:51,300 --> 00:15:54,440
!أحضرتُ هذه من متجر عائلتي، فلنحتفل

265
00:15:54,440 --> 00:15:55,930
ألن نقع في مشكلة؟

266
00:16:01,400 --> 00:16:03,440
.هذا شعور رائع

267
00:16:03,440 --> 00:16:08,440
،لم أبذل جهدًا كبيرًا في أيّ شيء من قبل
.فكلّ ما كنت أفعله هو قراءة المانغا

268
00:16:08,440 --> 00:16:10,790
.وأنا كذلك

269
00:16:12,720 --> 00:16:14,570
.وأ-أنا أيضًا

270
00:16:15,470 --> 00:16:17,580
.لطالما رسمتُ وحدي حتّى الآن

271
00:16:22,120 --> 00:16:24,940
.لنستمرّ في رسم المزيد من المانغا

272
00:16:24,940 --> 00:16:26,380
.أنت اصمتي يا أكافوكو

273
00:16:29,500 --> 00:16:34,130
سيكون من الرّائع لو انضمّت
.ستون دراغون-سان إلى نادي المانغا

274
00:16:36,120 --> 00:16:37,690
هل أنتِ غبيّة؟

275
00:16:37,690 --> 00:16:39,360
.ابتعدي إن لم تكوني تنوين الشّراء

276
00:16:39,360 --> 00:16:43,080
.بدت لي غير ودودة على الإطلاق

277
00:16:45,060 --> 00:16:46,650
!والد أكافوكو

278
00:16:50,690 --> 00:16:52,460
.إلى اللّقاء

279
00:16:58,650 --> 00:16:59,410
.اسمعي

280
00:17:06,960 --> 00:17:08,820
!ستون دراغون-سان

281
00:17:09,840 --> 00:17:16,160
أ-أنا أحبّ المانغا خا-خاصّتك
!كثيرًا يا ستون دراغون-سان

282
00:17:20,040 --> 00:17:22,300
هل يمكنك أن تدلّيني
على الطّريق إلى الشّاطئ؟

283
00:17:32,600 --> 00:17:35,450
عفوًا، لماذا أنا؟

284
00:17:34,700 --> 00:17:35,430
.أخبريني

285
00:17:36,040 --> 00:17:37,950
ما قصّة هذا الصّليب؟

286
00:17:38,750 --> 00:17:39,370
ماذا؟

287
00:17:44,070 --> 00:17:45,710
...أوتا... جوليا

288
00:17:52,820 --> 00:17:57,280
كنت أفكّر في رسم مانغا جديدة عن
.هذه الجزيرة لكوميتيا هذا الصّيف

289
00:17:57,280 --> 00:18:01,580
لقد اشتريت المانغا خاصّتك من
.كوميتيا يا سيكيريو-سان

290
00:18:01,580 --> 00:18:02,670
!كانت رائعة

291
00:18:04,130 --> 00:18:06,100
هل هناك قصّة وراء تلك الصّخرة؟

292
00:18:06,450 --> 00:18:07,080
ماذا؟

293
00:18:11,160 --> 00:18:14,360
لماذا انتقلتِ إلى مدرستنا الآن بالذّات؟

294
00:18:15,800 --> 00:18:17,980
.كان لأمّي يد في الأمر

295
00:18:17,980 --> 00:18:18,800
يد في الأمر؟

296
00:18:18,800 --> 00:18:21,360
.مهلاً، أحبّ تلك الغيمة

297
00:18:21,750 --> 00:18:23,120
ألا تبدو مثل تنّين؟

298
00:18:23,120 --> 00:18:27,120
إنّها تتّجه نحونا، مُسبّبةً
.صواعق البرق والأمطار

299
00:18:27,400 --> 00:18:28,370
!وميض

300
00:18:28,370 --> 00:18:30,080
!دويّ، دويّ، دويّ، انفجار

301
00:18:30,080 --> 00:18:31,870
!طقطقة، طقطقة، صعق

302
00:18:31,870 --> 00:18:34,750
!هبوب! رطمة، رطمة، رطمة

303
00:18:34,750 --> 00:18:37,180
!دويّ، دويّ، صعق

304
00:18:35,370 --> 00:18:37,520
!أنتما لا تتحدّثان اللّغة نفسها

305
00:18:37,520 --> 00:18:39,560
.هيّا، فكّري في موضوعٍ للحديث

306
00:18:39,560 --> 00:18:40,930
!مـ-مهلاً يا بوكوتا

307
00:18:41,150 --> 00:18:42,450
مع من تتحدّثين؟

308
00:18:44,040 --> 00:18:48,980
.أنا آسفة. لديّ صديق خياليّ منذ صغري

309
00:18:50,770 --> 00:18:51,650
.أتفهّمكِ

310
00:18:53,270 --> 00:18:55,950
.أنا أيضًا أتخيّل أشياءً كثيرة دائمًا

311
00:19:10,690 --> 00:19:11,790
ما اسمك؟

312
00:19:13,660 --> 00:19:15,380
.ياسومي آي

313
00:19:15,380 --> 00:19:17,240
.سأناديك آي-تشان

314
00:19:17,240 --> 00:19:20,880
.أنا سيكيريو هيكارو. ناديني هيكارو-تشان

315
00:19:21,410 --> 00:19:23,620
كيف هو صديقك يا آي-تشان؟

316
00:19:23,620 --> 00:19:25,770
.أنت قريبة جدًّا يا سيكيريو-سان

317
00:19:25,770 --> 00:19:28,080
.نادني هيكارو-تشان. لا داعي لهذه الرّسميّة

318
00:19:28,080 --> 00:19:31,410
..."حسنًا، هناك مانغا اسمها "روبوتا وبوكوتا

319
00:19:31,410 --> 00:19:32,960
.أحبّ هذه المانغا

320
00:19:34,570 --> 00:19:36,950
!لم أقابل أحدًا آخر قرأها

321
00:19:36,950 --> 00:19:40,720
أحببتُ مشهد محاولة روبوتا
.البكاء في الفصل الثّالث

322
00:19:40,720 --> 00:19:44,700
!هذا اختيارك؟ أنت حقًّا تفهمين المقصود منها

323
00:19:47,180 --> 00:19:49,850
...هناك ذلك المشهد في الفصل الأخير

324
00:19:49,850 --> 00:19:50,870
.أفهمك تمامًا

325
00:19:51,970 --> 00:19:54,140
.سيكي... هيكارو-تشان

326
00:19:54,140 --> 00:19:56,540
هل يمكنك إلقاء نظرة على المانغا خاصّتنا؟

327
00:19:57,140 --> 00:19:58,070
.أعطني إيّاها

328
00:20:00,790 --> 00:20:02,850
".حظوة الأميرة"

329
00:20:04,400 --> 00:20:09,240
يُقال أنّ أفراد الأسرة الملكيّة من"
،آل الخفيّ، إذا بادلوا أحدًا مشاعره

330
00:20:09,240 --> 00:20:12,610
أصبحوا غير مرئيّين تمامًا
".وأشعّ منهم نورٌ ساطع

331
00:20:13,050 --> 00:20:17,810
وتُعدّ هذه السّمة النّادرة والآسرة"
".جزءًا من إرثهم المتوارث في دمائهم

332
00:20:18,440 --> 00:20:19,650
"...ولكن"

333
00:20:20,000 --> 00:20:25,240
لديّ هنا تاجٌ مصنوعٌ من قطرات"
".القمر لكِ يا أميرتي الجميلة

334
00:20:25,240 --> 00:20:26,350
".تثاؤب"

335
00:20:26,750 --> 00:20:31,050
الأرضيّة الّتي تركع عليها مصنوعةٌ"
".من قطرات القمر الخالصة

336
00:20:31,400 --> 00:20:35,710
ما رأيك بوليمة فاخرة تُعدّ من الأسماك"
"ذوات الزّعنفتين، درّة الأسماك؟

337
00:20:35,710 --> 00:20:38,880
ماذا؟ نحن نقدّمها لحيواناتنا"
".الأليفة كوجبة خفيفة لا غير

338
00:20:39,150 --> 00:20:43,900
أقدّم لك فستانًا منسوجًا من خيوط"
".ذهبيّة ومُزيّن بأزرار من الألماس

339
00:20:43,900 --> 00:20:47,900
".هذا رائع. سينفع هذا كمنشفة أطباق جديدة"

340
00:20:47,900 --> 00:20:50,910
أقدّم لك خاتم الياقوت النّاري"
".هذا ذي الخمسين قراطًا

341
00:20:51,170 --> 00:20:55,130
.يا له من حجم فاتن"
".أحضروا لي عدستي المكبّرة لأراه

342
00:20:55,760 --> 00:20:56,530
".تنهّد"

343
00:20:57,110 --> 00:21:00,710
"ألا يوجد من يستطيع أن يقدّم لي هدايا أثمن؟"

344
00:21:01,730 --> 00:21:05,110
،إن سمحت لي يا صاحبة السّموّ"
".فسأقدّم لك بعض النّصائح

345
00:21:05,470 --> 00:21:09,020
إنّه لَخَسيسٌ من يحاول أن يأسر"
".قلب أحدهم بهدايا باهظة الثّمن

346
00:21:09,530 --> 00:21:15,040
،أمّا من يكنّ لسموّك مشاعر صادقة"
".فسيقدّم قلبه بدلاً من الهدايا

347
00:21:15,330 --> 00:21:20,140
،اختاري من يخاطب قلبك بصدق"
".ويراكِ لذاتك لا لمكانتك الملكيّة

348
00:21:26,260 --> 00:21:27,110
".حسنًا"

349
00:21:30,780 --> 00:21:34,890
!صارت غير مرئيّة"
"!أين الشّخص الّذي سرق قلب سموّها؟

350
00:21:34,890 --> 00:21:35,550
"!آه"

351
00:21:36,080 --> 00:21:38,040
".وعاشوا بسعادة وهناء"

352
00:21:43,930 --> 00:21:45,230
.الرّسم جيّد

353
00:21:49,250 --> 00:21:51,660
آي-تشان، هل ستكون لك طاولة
في كوميتيا هذا الصّيف؟

354
00:21:53,830 --> 00:21:56,510
.بدأت بتأليف المانغا للتّوّ

355
00:21:56,510 --> 00:21:58,440
وهل هذا يشكّل مانعًا ما؟

356
00:21:58,440 --> 00:22:00,030
ماذا؟ هذا ليس مانعًا؟

357
00:22:00,030 --> 00:22:01,170
.أظنّ أنّه ليس كذلك

358
00:22:03,210 --> 00:22:05,300
.اطلبي منها الانضمام لنادي المانغا

359
00:22:09,050 --> 00:22:11,590
هيكارو-تشان، أتريدين الانضمام لنادي المانغا؟

360
00:22:13,190 --> 00:22:15,480
!بإمكاننا الذّهاب إلى كوميتيا معًا هكذا

361
00:22:17,410 --> 00:22:19,650
.أعتقد أنّي سأرفض عرضك

362
00:22:19,650 --> 00:22:21,330
.مع أنّك شخص مرح للغاية

363
00:22:22,230 --> 00:22:24,250
.لنتحدّث عن المانغا أكثر في يوم آخر

364
00:22:26,820 --> 00:22:28,030
!انتظري

365
00:22:28,270 --> 00:22:30,090
...مستشارة نادينا هي

366
00:22:34,730 --> 00:22:36,790
...حسنًا، سنناقش اليوم

367
00:22:37,180 --> 00:22:39,210
مهلاً، من تكون هذه؟

368
00:22:39,210 --> 00:22:40,380
.هوشينو ري

369
00:22:40,380 --> 00:22:41,040
"!بلع"

370
00:22:41,780 --> 00:22:44,720
.أحبّ المانغا خاصّتك

371
00:22:47,970 --> 00:22:50,220
!مهلاً

372
00:22:50,220 --> 00:22:52,970
!أبعدي يديك عن ري-تشان

373
00:22:51,050 --> 00:22:52,970
!واصلي

374
00:22:53,710 --> 00:22:55,970
!ابتعدي عنها

375
00:22:53,960 --> 00:22:55,970
.لنذهب إلى كوميتيا معًا

376
00:22:56,270 --> 00:22:57,890
ماذا؟

377
00:22:57,890 --> 00:22:58,890
!ماذا؟