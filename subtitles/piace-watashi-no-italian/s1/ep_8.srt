1
00:00:05,260 --> 00:00:08,030
.مورينا-تشان، افتحي فمك

2
00:00:14,140 --> 00:00:15,810
!جيّد! إنّه لذيذ

3
00:00:15,810 --> 00:00:16,780
.هذا ممتاز

4
00:00:18,280 --> 00:00:19,120
.إنّه هنا ثانية

5
00:00:19,120 --> 00:00:20,630
!كان هنا قبل أيّام

6
00:00:20,630 --> 00:00:22,290
هل تقلّص الفارق بين زياراته؟

7
00:00:25,690 --> 00:00:26,590
!مرحبًا

8
00:00:26,590 --> 00:00:27,680
.هنالك شخص مجهول معهما

9
00:00:27,680 --> 00:00:28,530
من يكون؟

10
00:00:28,530 --> 00:00:29,190
.لا أدري

11
00:00:29,190 --> 00:00:30,920
.اسمحوا لي بتقديم نفسي

12
00:00:30,920 --> 00:00:32,670
!(ريغا توني (اسم مستعار

13
00:00:32,670 --> 00:00:35,930
أكلت في المتوسّط في أزيد من 500 مكان
،في السّنة، لديّ ملايين الزّيارات لمدوّنتي

14
00:00:35,930 --> 00:00:37,630
!وسلسلة غير مسبوقة من الكتب الأكثر مبيعًا

15
00:00:37,630 --> 00:00:40,040
!ذوّاق بين الذّوّاقة
!رجل بحاسّة تذوّق لا تقول إلاّ الحقيقة

16
00:00:40,040 --> 00:00:41,650
هل يروّج النّاس لأنفسهم بهذه الطّريقة؟

17
00:00:41,650 --> 00:00:44,270
!أنا معجب كبير بسايري

18
00:00:44,270 --> 00:00:46,810
!واليوم، رافقتُ نيزا-ساما لهذا المطعم

19
00:00:46,810 --> 00:00:48,420
.مرحبًا ثانية

20
00:00:46,810 --> 00:00:48,730
.قد يكون هذا ترويجًا جيّدًا

21
00:00:49,170 --> 00:00:49,960
.يا له من محبّ للاهتمام

22
00:00:49,960 --> 00:00:50,980
.اطبخي شيئًا ما يا مورينا

23
00:00:50,980 --> 00:00:52,120
!ماذا؟! ثانية؟

24
00:00:52,120 --> 00:00:52,640
!ماذا؟

25
00:00:52,640 --> 00:00:54,510
.لِمَ لا؟ جرّبي يا مورينا-تشان

26
00:00:54,510 --> 00:00:55,820
.لن يكون ذلك ترويجًا

27
00:00:55,820 --> 00:00:57,450
.سأساعدك

28
00:00:57,450 --> 00:00:59,260
.كيريهيدي، لا يمكن لمورينا فعلها

29
00:00:59,260 --> 00:01:00,560
.أنا واثق أنّها ستكون بخير

30
00:01:00,560 --> 00:01:01,420
.لندعها تحاول

31
00:01:01,420 --> 00:01:02,080
ماذا؟

32
00:01:02,080 --> 00:01:05,020
!أيمكنني فعل هذا؟ أيمكنني فعلاً؟ لا يمكنني

33
00:01:05,020 --> 00:01:07,430
.لكن ربّما يمكنني ذلك بمساعدة سارا

34
00:01:07,430 --> 00:01:09,080
أم أنّني سأكون عقبة في طريقها؟

35
00:01:09,590 --> 00:01:10,710
!مرحبًا

36
00:01:10,710 --> 00:01:13,780
!موريرين، لقد أتت ري كما وعدت

37
00:01:13,780 --> 00:01:16,720
!أطعميني شيئًا لذيذًا كزبونة

38
00:01:16,720 --> 00:01:18,280
.ري-تشان، شكرًا على قدومك

39
00:01:18,280 --> 00:01:19,470
أهي صديقتك؟

40
00:01:19,470 --> 00:01:22,200
إنّها صديقة مقرّبة لي من المدرسة
.واسمها ري-تشان

41
00:01:22,200 --> 00:01:22,710
.حسنًا

42
00:01:22,710 --> 00:01:25,510
.أنا صديقة مورينا المفضّلة كاغيتسو ري
!سررتُ بلقائك

43
00:01:25,980 --> 00:01:27,510
.حسنًا، انضمّي إلينا

44
00:01:27,510 --> 00:01:28,620
!عن إذنكما

45
00:01:28,620 --> 00:01:31,190
.يبدو أنّ تلك الآنسة هناك ستطبخ شيئًا لنا

46
00:01:31,190 --> 00:01:31,980
...تلك الآنسة

47
00:01:31,980 --> 00:01:33,130
!موريرين ستطبخ؟

48
00:01:33,130 --> 00:01:35,760
...هذا صحيح! كنتُ سأطبخ شيئًا

49
00:01:35,760 --> 00:01:37,320
مورينا، ما رأيك بإعداد دولتشي؟

50
00:01:37,320 --> 00:01:39,490
دولتشي؟ تقصدين طبق التّحلية؟

51
00:01:40,810 --> 00:01:43,240
!التّحلية رائعة، أجل

52
00:01:43,240 --> 00:01:48,540
خذي تلك المشاعر واخبزي ما تعدّينه
،من أعماق قلبك

53
00:01:48,540 --> 00:01:52,430
.وهكذا سيشعر زبائنك بشغفك مع كلّ قضمة

54
00:01:52,430 --> 00:01:54,200
...من أعماق قلبي

55
00:01:54,520 --> 00:01:56,530
!شكرًا جزيلاً لك يا سارا-تشان

56
00:01:57,550 --> 00:02:00,860
،إن وضعتُ كلّ ما لديّ في الطّبق بالفعل
.فسيشعرون بذلك بكلّ تأكيد

57
00:02:02,380 --> 00:02:06,050
يا رفاق، ألن تتسنّى لي فرصة القيام
بأيّ شيء رائع الآن؟

58
00:02:06,050 --> 00:02:07,600
.من المهمّ الاهتمام بها

59
00:02:07,600 --> 00:02:08,980
.يبدو أنّها ستنجح بطريقة ما

60
00:02:08,980 --> 00:02:11,650
نعم، كلّ شيء سيكون بخير
.إن كانت سارا ستساعدها

61
00:02:12,040 --> 00:02:13,570
!نعتذر على التّأخير

62
00:02:13,570 --> 00:02:18,260
استمتعوا رجاءً بالدّولتشي الخاصّ
!"بتراتّوريا فيستا، "زوبّا إنغليزي

63
00:02:20,160 --> 00:02:21,070
!إنّه رائع

64
00:02:21,070 --> 00:02:22,660
!يا إلهي، يبدو رائعًا

65
00:02:22,660 --> 00:02:26,090
.اسم "زوبّا إنغليزي" يعني "حساء إنجليزيّ" بالإيطاليّة

66
00:02:26,090 --> 00:02:30,240
إنّه عبارة عن قشدة الكاسترد مفروشة
بين طبقات من الكعك الإسفنجيّ

67
00:02:30,240 --> 00:02:32,670
.مع عصير الكرز وشراب الرّمّان الحلو

68
00:02:32,670 --> 00:02:37,100
الكعك الإسفنجيّ مع الشّراب الحلو
!هو خاصّيّة مميّزة للحلويّات الإيطاليّة

69
00:02:37,100 --> 00:02:38,670
.ربّما نكون قد أضفنا الكثير من النّعناع

70
00:02:37,510 --> 00:02:39,680
!إنّه حلو! إنّه ممتاز! إنّه لذيذ

71
00:02:39,680 --> 00:02:42,720
.أنا سعيدة لأنّ الطّبق كان ناجحًا
.شكرًا لك يا سارا-تشان

72
00:02:42,720 --> 00:02:44,050
!أحسنت يا مورينا

73
00:02:44,050 --> 00:02:45,560
.شكرًا جزيلاً لك يا مارو-سان

74
00:02:50,850 --> 00:02:53,800
...ربّما لم يحبّ جدّي الطّبق

75
00:02:53,800 --> 00:02:57,820
أرغب بدعوة الآنسة الّتي أعدّت
.هذا الدّولتشي لتنضمّ لفريق سايري

76
00:03:00,200 --> 00:03:02,200
ما الّذي يقوله هذا العجوز؟

77
00:03:04,110 --> 00:03:06,700
!سارا-تشان مدفونة في موتشي الفاصولياء الحمراء

78
00:03:06,700 --> 00:03:08,480
.لفترة مؤقّتة فحسب

79
00:03:08,480 --> 00:03:11,460
!كلاّ! لن أسمح لك بأخذ مورينا منّا

80
00:03:11,460 --> 00:03:12,970
!سأغلق المطعم

81
00:03:12,970 --> 00:03:16,030
سأتصرّف ببلاهة أمام مطعمك كلّ
.يوم أحد كما يفعل تلاميذ الإعداديّة

82
00:03:16,030 --> 00:03:18,600
ألم تسمعني؟
.قلتُ لفترة مؤقّتة فحسب

83
00:03:18,600 --> 00:03:21,200
.إلاّ أنّي لم أقرّر إلى متى ستدوم بعد

84
00:03:21,200 --> 00:03:23,470
!تيري! قولي شيئًا ما لجدّك

85
00:03:23,470 --> 00:03:24,870
!حركة جيّدة يا جدّي

86
00:03:24,870 --> 00:03:26,970
!توافقين على العاملين بتلك الطّريقة؟