1
00:01:32,920 --> 00:01:34,860
يبدو أنهم قضوا على توراي

2
00:01:35,120 --> 00:01:36,240
اسكت

3
00:01:36,590 --> 00:01:39,950
لكنّه كان الأضعف بيننا نحن السبعة

4
00:01:40,550 --> 00:01:41,700
...ميو-تشان

5
00:01:42,100 --> 00:01:45,790
القِيَم المُقاسة لتوراي-سان كانت
الأعلى بيننا جميعاً

6
00:01:46,790 --> 00:01:50,290
ما معنى هذا؟ قضوا على الأقوى بيننا أولاً؟

7
00:01:50,530 --> 00:01:54,670
لكن جميعكم كنتم ضمن 8% من قِيَم
بعضكم الآخر

8
00:01:54,670 --> 00:01:55,630
توقّفوا جميعاً

9
00:01:56,160 --> 00:01:57,690
توراي-كن موجودٌ هنا

10
00:01:58,450 --> 00:01:59,870
لا تقلقوا بشأني

11
00:01:59,870 --> 00:02:01,680
أنا بلا فائدة الآن

12
00:02:02,430 --> 00:02:04,950
أنهيتُ تقريري، لذا سأذهب

13
00:02:04,950 --> 00:02:06,030
...انتظر، انتظر

14
00:02:06,030 --> 00:02:07,640
لا تخل أنّك طُرِدت

15
00:02:08,260 --> 00:02:11,380
أريدك أن تتولّى الريادةِ في التحرّي
حول العدوّ المذكور في تقريرك

16
00:02:11,830 --> 00:02:14,130
لعلّه يتربّص في تلك البلدة

17
00:02:14,950 --> 00:02:15,820
حاضر

18
00:02:18,300 --> 00:02:23,730
ا-المعذرة يا توراي-سان، ماذا كان شكل العدوّ؟

19
00:02:24,050 --> 00:02:27,710
أشعر بضبابيّة في ذاكرتي، ولا أستطيع
التذكّر بصراحة

20
00:02:29,350 --> 00:02:32,170
كان هناك فتى صغيراً... على ما أعتقد

21
00:02:33,930 --> 00:02:35,340
وفتاة

22
00:02:35,730 --> 00:02:36,960
...وهناك آخر

23
00:02:37,570 --> 00:02:38,670
لكن لا أعرف

24
00:02:38,980 --> 00:02:42,300
أشعر وكأنّ الجميع كانوا يملكون وجه قطّ

25
00:02:42,540 --> 00:02:44,140
ما معنى هذا؟

26
00:02:44,140 --> 00:02:46,360
تقنيّة من نوع ما عطّلَتْ قدرتك
على تمييزهم

27
00:02:46,360 --> 00:02:49,170
نصبوا كميناً لك بُعيد معركتنا
مع السّلاح الهائل

28
00:02:49,170 --> 00:02:50,730
العدوّ حذِرٌ جداً

29
00:02:51,000 --> 00:02:53,320
حالياً، علينا مُناقشة الاسم الذي سنُطلقه
على هؤلاء الغزاة

30
00:02:53,570 --> 00:02:57,410
لقد قرّرنا بأن نسمّي الأسلحة الهائلة
"التي ظهرَتْ في البحر "أسلحة نيبولا

31
00:02:57,410 --> 00:03:00,530
"استدلالاً بعدوّنا، القوّة الغازية "نيبولا

32
00:03:00,900 --> 00:03:02,200
،والعدوّ الذي هاجم توراي-كن

33
00:03:02,670 --> 00:03:04,410
"سنطلق عليه بـ"جنود نيبولا

34
00:03:05,010 --> 00:03:08,180
نحن، حمَلة درع فوتون الإله الهائل
،للتحريك العقلي

35
00:03:08,560 --> 00:03:10,660
الوحيدون القادرون على حمايةِ
الأرض من غزو نيبولا

36
00:03:11,370 --> 00:03:16,270
قسم الدفاع الخاصّ بمركز سلامة
"المواطنين: "غراند بالادين

37
00:03:17,110 --> 00:03:20,380
لن نقبل بخسارة هذه القوّة

38
00:03:20,840 --> 00:03:23,450
،إذاً، كوسيلةٍ لمنعِ هذا من الحدوث مستقبلاً

39
00:03:23,450 --> 00:03:26,600
لمَ لا ندع الجميع يعملون كثنائي؟

40
00:03:27,210 --> 00:03:31,030
سيسهّل العمل كثنائي التعامُل
مع جنود نيبولا على ما أعتقد

41
00:03:31,030 --> 00:03:31,600
أجل

42
00:03:31,840 --> 00:03:34,260
!أختار هارو-تشان إذاً

43
00:03:34,650 --> 00:03:36,730
!نعم، أتطلع للعمل معك يا ميو-تشان

44
00:03:37,050 --> 00:03:38,690
بينيكا، لنشكّل ثنائياً

45
00:03:38,690 --> 00:03:40,650
لا تعرقل عملي يا يوسكي

46
00:03:40,960 --> 00:03:43,290
أظنّني سأختار نيزويا-كن إذاً

47
00:03:43,290 --> 00:03:44,810
يسرّني العمل معك

48
00:03:44,810 --> 00:03:45,890
نعم

49
00:03:45,890 --> 00:03:47,580
أنا أيضاً

50
00:03:47,850 --> 00:03:49,540
انصراف إذاً

51
00:03:51,670 --> 00:03:53,970
بينيكا، ما رأيكِ أن نتناول الغداء؟

52
00:03:53,970 --> 00:03:56,070
بالتأكيد، إذا كان على حسابك

53
00:03:56,070 --> 00:03:57,560
،هارو-تشان، نيزويا-كن

54
00:03:57,560 --> 00:03:58,800
أتريدان الذهاب إلى صالة الأركيد؟

55
00:03:59,160 --> 00:04:01,120
لديّ حفل غنائي

56
00:04:01,590 --> 00:04:02,830
هل أنت في فرقة؟

57
00:04:02,830 --> 00:04:04,500
لا، ذاهب لرؤية فرقة

58
00:04:04,500 --> 00:04:07,350
ميو-تشان، احضري دروس بعد
العصر على الأقلّ

59
00:04:13,740 --> 00:04:15,730
تاكاشي، أقرضني بعض المال

60
00:04:16,020 --> 00:04:18,540
أين ذهبت الـ30000 ين التي أعطيتك
إيّاها البارحة يا أبي؟

61
00:04:18,540 --> 00:04:19,970
أنفقتُها

62
00:04:21,500 --> 00:04:23,540
أنفقتَ 30000 ين في مطعم لحوم؟

63
00:04:23,540 --> 00:04:24,570
!ستموت أيّها العجوز

64
00:04:24,880 --> 00:04:29,890
لـ-لكن اللّحم هو الشيء الوحيد الذي
بقي لي لأستمتع به في الحياة

65
00:04:29,890 --> 00:04:33,580
!لا تنتزع من عجوز الشيء الوحيد المتبقّي له

66
00:04:33,870 --> 00:04:35,620
اخرس. اذهب

67
00:04:35,620 --> 00:04:37,070
شيرايشي-كن، تولّي هذا الأمر

68
00:04:37,070 --> 00:04:37,760
حاضرة

69
00:04:42,920 --> 00:04:44,370
...تاكيزو-سان

70
00:04:45,430 --> 00:04:47,040
...شيرايشي-تشان

71
00:04:47,040 --> 00:04:50,680
تاكيزو-سان، حان وقت الذهاب إلى المنزل

72
00:04:50,860 --> 00:04:53,450
أتريدين مشاركتي شراباً يا شيرايشي-تشان؟

73
00:04:53,450 --> 00:04:57,020
يؤسفني أنني لا أشرب

74
00:04:59,550 --> 00:05:00,400
...نيبولا

75
00:05:01,290 --> 00:05:05,360
أقسم أننا سنوقف غزوكم

76
00:05:07,120 --> 00:05:10,450
سأكون قائد البشريّة

77
00:05:10,450 --> 00:05:11,960
!بربِّك

78
00:05:11,960 --> 00:05:14,780
قلتُ لا يا تاكيزو-سان

79
00:05:14,780 --> 00:05:15,910
—هلّا توقّفتما عن

80
00:05:25,380 --> 00:05:26,260
ما هذا؟

81
00:05:26,260 --> 00:05:27,310
تونكاتسو

82
00:05:27,310 --> 00:05:28,720
ليس لحماً

83
00:05:28,870 --> 00:05:33,000
إنه تونكاتسو نباتي خاصّ مُكوّن من
فول الصّويا ونخالة القمح

84
00:05:33,000 --> 00:05:34,520
!أريد تونكاتسو حقيقياً

85
00:05:34,950 --> 00:05:36,410
إن كنت لا تريده فسآخذه أنا

86
00:05:36,410 --> 00:05:37,920
لا بأس، سآكله

87
00:05:37,920 --> 00:05:39,650
لماذا تونكاتسو نباتي؟

88
00:05:40,530 --> 00:05:43,420
هذا هو الجسم العائم الضخم
الذي رأيناه البارحة

89
00:05:43,420 --> 00:05:47,360
الحجم والتّصميم يجعلانني أتساءل عن سلامة
عقل الرجل الذي صنعه

90
00:05:47,720 --> 00:05:50,600
يعتقد البعض أنّه قد يكون
سلاحاً ينتمي لبلدٍ ما

91
00:05:50,600 --> 00:05:52,740
"قلتُ "الرجل الذي صنعه

92
00:05:53,000 --> 00:05:56,040
لكن لا أتخيّل أنّ من صنعَ شيئاً كهذا بشريّ

93
00:05:56,040 --> 00:05:59,160
تُفيد الإشاعات بأنّه سلاح خارق ينتمي
،لحضارة قديمة

94
00:05:59,160 --> 00:06:01,630
...أو مخلوقات فضائيّة أو مجتمعات تحت الأرض

95
00:05:59,170 --> 00:06:00,830
هل أنتم من فعل هذا؟

96
00:06:00,830 --> 00:06:01,630
كلّا

97
00:06:01,860 --> 00:06:06,010
يُعتقَد بأنّ هؤلاء الأشخاص الغامضون السبعة
قد دمّروا الجسم الضخم

98
00:06:06,320 --> 00:06:08,200
من هم؟

99
00:06:08,200 --> 00:06:10,470
يعجّ الإنترنت بالنظريّات

100
00:06:10,860 --> 00:06:14,530
بالمناسبة يا سويا، ألن تذهب"
"إلى المدرسة اليوم؟

101
00:06:14,530 --> 00:06:16,880
هذا ما يقوله سينسي

102
00:06:16,880 --> 00:06:18,960
لا تهمّني المدرسة

103
00:06:18,960 --> 00:06:21,510
غير مهمّ. هذا ليس عالمي

104
00:06:22,410 --> 00:06:25,940
"يقول سينسي "بل هذا مهمّ

105
00:06:26,690 --> 00:06:28,530
هل يحقُّ لك أن توعظ الناس؟

106
00:06:28,530 --> 00:06:30,490
!أنتما من أحضراني إلى هنا

107
00:06:30,760 --> 00:06:32,280
!كي تجعلاني جنديّاً

108
00:06:32,540 --> 00:06:33,930
توقّف

109
00:06:33,930 --> 00:06:36,640
...لولا سينسي لكنتَ

110
00:06:41,720 --> 00:06:43,920
كما تشاء يا سينسي

111
00:06:46,730 --> 00:06:48,080
ألن تخبريني ماذا قال؟

112
00:06:48,880 --> 00:06:51,860
روايتنا التالية هي حول عجوز يظهر
في مطاعم اللّحوم

113
00:06:51,860 --> 00:06:53,650
!في البلدة ويأكل حتّى تُفلس

114
00:06:53,650 --> 00:06:56,100
إنّه يُهين الأكَلة السريعين المحترفين

115
00:06:56,340 --> 00:07:00,440
على أي حال، أحتاج إلى قوّتك
كي أتمكّن من الانتقام

116
00:07:00,440 --> 00:07:02,810
لذا سأتواجد هنا لبعض الوقت يا سينسي

117
00:07:03,230 --> 00:07:06,980
!لكن أكره هذا الشيء وأكرهكما أيضاً

118
00:07:06,980 --> 00:07:08,340
!لن أسامحكما أبداً

119
00:07:12,390 --> 00:07:14,010
ماذا؟

120
00:07:14,510 --> 00:07:16,150
غرفتي هناك

121
00:07:20,530 --> 00:07:22,830
سويا-كن، ألن تشكرني على الطعام؟

122
00:07:24,280 --> 00:07:25,590
ألن تشكرني؟

123
00:07:26,370 --> 00:07:27,340
شكراً على الطعام

124
00:07:43,380 --> 00:07:44,940
أنا ذاهب للجري

125
00:07:51,460 --> 00:07:52,360
!ما هذا؟

126
00:07:52,360 --> 00:07:53,410
!قبقاب حديدي؟

127
00:07:59,080 --> 00:08:01,290
هل كوروي-كن مصاب بزكام؟

128
00:08:07,680 --> 00:08:08,610
...ثقيل للغاية

129
00:08:09,280 --> 00:08:10,690
...من الصّعب الجري فيه

130
00:08:17,810 --> 00:08:19,560
أحتاج لمزيد من اللّياقة

131
00:08:20,670 --> 00:08:22,950
ما زال هناك ستّة أعداء متبقّين

132
00:08:23,300 --> 00:08:26,440
ومجرّد هزيمتهم لن يضع حدّاً لهذا

133
00:08:29,810 --> 00:08:31,220
...اللّعنة

134
00:08:31,220 --> 00:08:32,670
...جميعكم

135
00:08:32,670 --> 00:08:36,390
!سأثأر لكم... أعدكم

136
00:09:02,690 --> 00:09:05,230
!إنّه عدوّي

137
00:09:05,700 --> 00:09:07,560
لكن سرقتُ قنينته

138
00:09:08,010 --> 00:09:09,110
...وتلك

139
00:09:11,810 --> 00:09:13,070
!فطيرة لحم

140
00:09:22,290 --> 00:09:23,710
هلّا سألتك سؤالاً؟

141
00:09:23,980 --> 00:09:25,120
ما-ماذا؟

142
00:09:25,360 --> 00:09:26,930
هل أنت في المدرسة الإعداديّة؟

143
00:09:26,930 --> 00:09:27,750
أين مدرستك؟

144
00:09:30,870 --> 00:09:32,850
أنا في الثانويّة

145
00:09:32,850 --> 00:09:34,300
لكن لن أحضر

146
00:09:36,210 --> 00:09:37,550
تتغيّب عن الدرس؟

147
00:09:46,320 --> 00:09:47,190
أتريد واحدة؟

148
00:09:48,710 --> 00:09:49,670
!أجل

149
00:09:52,380 --> 00:09:53,530
!شكراً لك

150
00:10:00,870 --> 00:10:07,250
هل رأيتَ فتى بمثل حجمك في اللّيلة
الماضية يرتدي قناعاً؟

151
00:10:10,820 --> 00:10:12,650
...لـ-لا

152
00:10:13,380 --> 00:10:15,130
حسناً، لا يمكن أن تراه على ما أعتقد

153
00:10:15,550 --> 00:10:17,840
من يخرج ويجري بقناع على أي حال؟

154
00:10:19,160 --> 00:10:20,900
هل يبحث عنّي؟

155
00:10:25,200 --> 00:10:25,960
أنت

156
00:10:26,270 --> 00:10:28,030
أليست المدرسة ممتعة؟

157
00:10:29,700 --> 00:10:30,760
آسف

158
00:10:30,760 --> 00:10:33,860
رأيتُك في الواقع تبكي من بعيد

159
00:10:34,190 --> 00:10:36,570
هذا ليس من شأنك

160
00:10:36,970 --> 00:10:37,950
صحيح

161
00:10:39,240 --> 00:10:40,490
آسف

162
00:10:40,840 --> 00:10:43,200
وداعاً. قبقاب رائع بالمناسبة

163
00:10:43,670 --> 00:10:44,590
حظّاً سعيداً

164
00:10:53,050 --> 00:10:56,280
حسناً، هذه المرّة سآكل فطيرتي

165
00:10:56,860 --> 00:10:58,470
—سأبدأ بالأكل

166
00:10:58,920 --> 00:10:59,700
!أنت

167
00:11:00,450 --> 00:11:01,460
!اخرج من هنا حالاً

168
00:11:01,460 --> 00:11:02,810
!توجّه نحو منطقة الإخلاء

169
00:11:03,430 --> 00:11:05,020
أظنّك لن تستطيع بهذا القبقاب الحديدي

170
00:11:05,560 --> 00:11:06,810
!يمكنك استعارة هذا

171
00:11:07,090 --> 00:11:09,230
!وداعاً! اهرب من هنا بسرعة

172
00:11:09,230 --> 00:11:10,350
!مؤلم

173
00:11:16,500 --> 00:11:19,280
رسالة من مركز سلامة المواطنين

174
00:11:20,290 --> 00:11:24,920
ظهر جسم طائر ضخم غير معروف للتو

175
00:11:25,400 --> 00:11:28,800
الرجاء من المواطنين الإخلاء

176
00:11:29,210 --> 00:11:29,910
...أكرّر

177
00:11:30,430 --> 00:11:34,130
الرجاء من المواطنين الإخلاء

178
00:11:34,740 --> 00:11:39,010
ظهرت المزيد من الأجسام الطائرة الضخمة
في كلّ أنحاء العالم

179
00:11:39,150 --> 00:11:41,880
هل سيظهر أولئك السّبعة الغامضون مجدداً؟

180
00:11:42,680 --> 00:11:44,630
—هؤلاء هم! الغامضون

181
00:11:44,630 --> 00:11:46,850
ماذا؟ هذه المرّة هناك ستّة فقط

182
00:11:46,850 --> 00:11:48,020
أحدهم مفقود

183
00:11:48,450 --> 00:11:49,980
جاهزون؟

184
00:11:50,230 --> 00:11:51,640
!هيّا بنا جميعاً

185
00:11:52,650 --> 00:11:53,680
!ها أنت ذا

186
00:11:53,680 --> 00:11:56,360
!حسناً، حان وقتُ القيام بهذا

187
00:12:08,300 --> 00:12:11,560
!مربّى فاصولياء؟

188
00:12:20,380 --> 00:12:22,880
جميعكم، انفصلوا وابحثوا عن نقطةِ ضعفه

189
00:12:23,260 --> 00:12:24,910
لماذا تتولّين القيادة؟

190
00:12:24,910 --> 00:12:27,550
لأنّ الجميع باستثنائي منحرفون بالسرّ

191
00:12:27,790 --> 00:12:29,770
هل هذا يشملني أيضاً؟

192
00:12:29,770 --> 00:12:30,310
أجل

193
00:12:30,740 --> 00:12:33,940
بمقدورنا أن ندع شيرايشي-تشان تقودنا، صحيح؟

194
00:12:34,590 --> 00:12:37,150
لكن نحتاج لشخص هنا معنا
يستطيع أن يعطي الأوامر

195
00:12:38,020 --> 00:12:40,230
سأتبع ميو-تشان

196
00:12:40,990 --> 00:12:42,640
حسناً جميعاً

197
00:12:42,640 --> 00:12:46,590
كما في المرّة السابقة، عندما تجدون
طريقاً للداخل

198
00:12:46,590 --> 00:12:48,490
فادخلوا ودمّروا النواة

199
00:12:48,490 --> 00:12:49,560
!حاضر

200
00:12:53,570 --> 00:12:54,650
!مُوجّهة؟

201
00:12:55,090 --> 00:12:57,090
،كما ورد في تقرير توراي-سان

202
00:12:57,090 --> 00:13:00,630
حذارِ من الأوهام التي يُريكم إيّاها
العدو حالما تصبحون داخل النواة

203
00:13:05,950 --> 00:13:10,310
،إن لم يكن ذلك المخيف المقرف لكما
لِمَن يكون إذاً؟

204
00:13:10,310 --> 00:13:12,540
هل نعتَّه بالمقرف للتو؟

205
00:13:12,540 --> 00:13:13,060
أجل

206
00:13:13,420 --> 00:13:15,010
لكنّه ظريف جداً

207
00:13:16,920 --> 00:13:19,200
ذلك ينتمي لفرقة الختم

208
00:13:19,200 --> 00:13:21,360
نحن فرقة السلميّين

209
00:13:22,710 --> 00:13:26,530
كلانا جزءان من نيبولا، فرقتان مختلفتان فحسب

210
00:13:26,530 --> 00:13:28,990
هذا ما يقوله سينسي

211
00:13:28,990 --> 00:13:31,670
نيبولا هي منظّمتكم؟

212
00:13:33,000 --> 00:13:36,330
نيبولا معنيّة بالتطوّر البشري

213
00:13:37,890 --> 00:13:38,880
!وجدتها

214
00:13:38,880 --> 00:13:41,340
!ميو إينابا تتكلّم! سوف أدخل

215
00:13:41,630 --> 00:13:43,170
!ميو-تشان، كوني حذرة

216
00:13:43,470 --> 00:13:45,710
!لا تقلقي! دعي الأمر لي

217
00:13:49,260 --> 00:13:52,300
أنا قويّة. أنا قويّة. أنا قويّة

218
00:13:52,300 --> 00:13:54,520
!أنا قويّة

219
00:13:55,340 --> 00:14:00,310
الآن بعد أن بدأت البشريّة في تطوير
،القوّة للقتال

220
00:14:00,310 --> 00:14:02,170
هدف فرقة الختم هو ختم البشريّة في الأرض

221
00:14:02,170 --> 00:14:04,280
لمنعهم من التطوُّر أكثر

222
00:14:04,670 --> 00:14:08,610
لكن نحن السلميّون نأمل أن نحدّ
،من تدخّلاتنا إلى أدنى حدّ

223
00:14:08,610 --> 00:14:12,870
ونصادر تلك القوّة ونستمرّ في مراقبة البشريّة

224
00:14:13,800 --> 00:14:15,190
اهدئي يا ميو

225
00:14:17,150 --> 00:14:18,540
!أنا قويّة

226
00:14:18,880 --> 00:14:20,750
!أمتلك قوّة

227
00:14:21,190 --> 00:14:22,870
أملُنا هو أن تختار البشريّة

228
00:14:22,870 --> 00:14:26,630
تطوُّر الحبّ مفضّلةً إيّاه على تطوُّر القوّة

229
00:14:27,280 --> 00:14:29,330
،لا أفهم شيئاً

230
00:14:29,330 --> 00:14:32,470
لكن ذلك الضخم ليس في صفّنا إذاً؟

231
00:14:37,720 --> 00:14:39,710
هذه هي النواة إذاً؟

232
00:14:39,710 --> 00:14:42,580
ظننتُ أنه كان من المُفترض أن أرى
شكلاً ما من الأوهام

233
00:14:46,650 --> 00:14:47,320
!انحناء

234
00:14:49,530 --> 00:14:50,850
هارو-تشان؟

235
00:15:01,060 --> 00:15:01,670
!ابدآ

236
00:15:22,060 --> 00:15:22,960
!رابحة

237
00:15:38,610 --> 00:15:43,330
لطالما أردتُ أن أكون ضخمة وقويّة
مثلكِ يا هارو-تشان

238
00:15:43,780 --> 00:15:45,380
أردتُ القوّة

239
00:15:46,580 --> 00:15:49,060
والآن أنتِ أقوى منّي يا ميو-تشان

240
00:15:49,830 --> 00:15:51,340
مبروك نصركِ

241
00:16:01,790 --> 00:16:02,520
...لكن

242
00:16:06,880 --> 00:16:08,410
هذا وهم

243
00:16:09,760 --> 00:16:12,570
!أمتلك قوّةً في العالمِ الحقيقيّ

244
00:16:13,070 --> 00:16:15,300
!درع فوتون الإله الهائل للتحريك العقليّ

245
00:16:23,390 --> 00:16:27,800
إيّاكم والاعتقاد أنّكم تستطيعون التحكُّم بقلوب
الناس بكذبةٍ كهذه يا نيبولا

246
00:16:51,530 --> 00:16:54,110
ميو-تشان! ميو-تشان، هل أنتِ بخير؟

247
00:17:03,120 --> 00:17:05,170
!بالطبع أنا كذلك

248
00:17:12,110 --> 00:17:14,380
إينابا-سان، أحسنتِ صنعاً

249
00:17:14,640 --> 00:17:16,750
أنا مُتعبٌ للغاية

250
00:17:16,750 --> 00:17:17,620
وأنا أيضاً

251
00:17:17,620 --> 00:17:22,350
والآن توجّهوا إلى الديار جميعاً على شكل
ثنائيّات كما ناقشنا

252
00:17:24,120 --> 00:17:25,850
هيّا بنا يا ميو-تشان

253
00:17:26,120 --> 00:17:29,480
كانت طريقة هزيمتكِ لشيء ضخم جداً مذهلة

254
00:17:32,740 --> 00:17:34,400
!شكراً لك يا هارو-تشان

255
00:17:38,330 --> 00:17:40,970
!لقد اختفى الجسم الطائر الضخم

256
00:17:40,970 --> 00:17:43,370
أهو عدوٌ للبشريّة؟

257
00:17:43,530 --> 00:17:47,120
هل الأبطال الستّة الغامضون يحمون البشريّة؟

258
00:17:49,930 --> 00:17:51,060
هل أنتِ بخير؟

259
00:17:51,670 --> 00:17:53,690
متعبة قليلاً فقط

260
00:17:53,690 --> 00:17:55,260
أتريدين الاستناد عليّ؟

261
00:17:55,260 --> 00:17:56,050
أنا بخير

262
00:17:57,160 --> 00:17:58,510
دعينا نمشي جنباً إلى جنب

263
00:17:59,490 --> 00:18:01,350
أنا سعيدةٌ الآن

264
00:18:02,850 --> 00:18:04,810
أريد الافتخار أمام الجميع

265
00:18:05,060 --> 00:18:08,810
"!أنقذتُ الأرض مع هارو-تشان"

266
00:18:09,550 --> 00:18:12,020
أنا قلقة

267
00:18:12,360 --> 00:18:14,990
لا أريدكِ أن تكوني في خطر

268
00:18:19,860 --> 00:18:22,370
أعطيني مصدر قوّتك

269
00:18:24,760 --> 00:18:27,520
فتى بقناع؟

270
00:18:28,030 --> 00:18:29,710
أذلك هو من هاجم توراي-سان؟

271
00:18:30,060 --> 00:18:31,540
!هارو-تشان، لنقاتل

272
00:18:32,040 --> 00:18:33,300
!نحن لا نُقهَر سوية

273
00:18:35,250 --> 00:18:36,760
!نعم يا ميو-تشان

274
00:18:36,990 --> 00:18:38,550
هذا يسهّل الأمر

275
00:18:38,550 --> 00:18:40,480
!حتّى لو كنتما اثنتين، سأهزمكما

276
00:18:40,480 --> 00:18:41,440
!سينسي

277
00:18:51,940 --> 00:18:53,150
!هيّا بنا أيُّها الغازي

278
00:18:54,610 --> 00:18:58,400
...التّحطيم... الحلزوني

279
00:18:59,960 --> 00:19:00,740
!النفسيّ

280
00:19:09,420 --> 00:19:10,170
!أصبتُه

281
00:19:10,170 --> 00:19:11,220
!تبّاً

282
00:19:16,110 --> 00:19:17,260
ما الذي يجري؟

283
00:19:21,070 --> 00:19:24,910
يقول سينسي أنّ تلك رمية جودو
"!تُدعى "أوتشي ماتا

284
00:19:24,910 --> 00:19:26,940
لكن هل أنت بخير يا سينسي؟

285
00:19:27,310 --> 00:19:28,020
!أنت بمتناول يدي

286
00:19:28,960 --> 00:19:30,690
!التّحطيم الحلزوني

287
00:19:45,340 --> 00:19:46,200
هل رأيت ذلك؟

288
00:19:46,200 --> 00:19:47,970
،نحن الثنائي الأقوى في العالم

289
00:19:47,970 --> 00:19:50,120
ولن نخسر أمامكم أيُّها الغزاة

290
00:19:50,940 --> 00:19:52,460
...مؤلم

291
00:19:52,640 --> 00:19:54,180
غُزاة؟

292
00:19:54,180 --> 00:19:58,170
يبدو أنّهم يعتقدون أنّ كلّ نيبولا غُزاة

293
00:19:59,220 --> 00:20:00,360
!هذه هي النهاية

294
00:20:00,360 --> 00:20:02,250
!حان وقتُ الثأر لتوراي-سان

295
00:20:02,250 --> 00:20:04,470
لكن ما زال على قيدِ الحياة

296
00:20:04,470 --> 00:20:06,110
هل يمكننا فعل هذا يا سينسي؟

297
00:20:07,060 --> 00:20:07,950
...حسناً

298
00:20:09,330 --> 00:20:10,380
!هيّا

299
00:20:10,380 --> 00:20:11,640
...ضربة

300
00:20:11,640 --> 00:20:12,750
!ها أنا ذي

301
00:20:12,750 --> 00:20:14,650
!هذه هجمتي الأخيرة

302
00:20:15,120 --> 00:20:18,780
!التّحطيم الحلزوني النفسيّ

303
00:20:18,780 --> 00:20:22,450
!قطّ غيغا العلويّة المضادّة

304
00:20:24,780 --> 00:20:26,870
!في الوقت المثالي

305
00:20:39,100 --> 00:20:39,900
...مستحيل

306
00:20:40,620 --> 00:20:41,340
!ميو-تشان

307
00:21:12,600 --> 00:21:13,780
هزمناها

308
00:21:13,780 --> 00:21:15,190
!أصبحا اثنين

309
00:21:16,860 --> 00:21:18,690
يكفي لليوم

310
00:21:18,690 --> 00:21:20,250
من المخاطرة كثيراً متابعة القتال

311
00:21:20,670 --> 00:21:22,720
هذا ما يقوله سينسي

312
00:21:22,720 --> 00:21:24,010
!لا، لم أنتهِ بعد

313
00:21:24,430 --> 00:21:25,720
...هناك فتاة أخرى

314
00:21:26,030 --> 00:21:28,330
!ميو-تشان! ميو-تشان

315
00:21:28,330 --> 00:21:29,050
هل أنتِ بخير؟

316
00:21:29,320 --> 00:21:30,610
!استجيبي

317
00:21:30,610 --> 00:21:31,770
!ميو-تشان

318
00:21:32,210 --> 00:21:33,510
...لا

319
00:21:33,510 --> 00:21:36,850
!قـ... قوّتي

320
00:21:37,230 --> 00:21:38,710
!إنّها واقفة هناك فحسب

321
00:21:38,710 --> 00:21:39,420
...إن هاجمناها الآن

322
00:21:39,420 --> 00:21:40,190
!سويا-كن

323
00:21:54,950 --> 00:21:56,280
!أنا مُحاصر

324
00:21:58,630 --> 00:22:00,280
مات الشّاه

325
00:22:05,120 --> 00:22:06,980
لا تعبثوا مع البشريّة

326
00:23:42,970 --> 00:23:45,070
"الثائر 1"