1
00:00:18,530 --> 00:00:24,920
،هذه مدرسةٌ عامّة مرموقة
تحميها التّقاليد والانضباط

2
00:00:25,880 --> 00:00:30,290
،الآن بعد أن صرتَ تلميذاً هنا
يجب أن تطيع القواعد

3
00:00:31,270 --> 00:00:33,210
...شييل فانتومهايف

4
00:00:34,110 --> 00:00:40,230
هل تقسم بالالتزام بكافّة تقاليد
وقواعد كلّية ويستون؟

5
00:00:40,230 --> 00:00:41,060
أجل

6
00:02:40,220 --> 00:02:42,290
!بئس الأمر! سوف أتأخّر

7
00:02:47,020 --> 00:02:48,730
!ا-انتظر من فضلك

8
00:02:53,230 --> 00:02:54,280
وصلتُ في الوقت

9
00:03:02,070 --> 00:03:06,200
،كلّية ويستون، الكائنة على ضفافِ تيميس

10
00:03:06,200 --> 00:03:09,130
هي المدرسة العامّة الأكثر تميُّزاً في إنكلترا

11
00:03:09,910 --> 00:03:14,000
باحاتها الواسعة هي متاهة
من الأبنية المدرسيّة العملاقة

12
00:03:14,000 --> 00:03:16,390
ومُصلّيات بطراز قوطيّ

13
00:03:16,390 --> 00:03:19,090
،هناك أربعة أبنية للمبيت ذات تاريخ حافل

14
00:03:19,460 --> 00:03:24,050
ويتّبع تلاميذها نظاماً انضباطيّاً
يقدّر التّقاليد أكثر من أي شيء آخر

15
00:03:24,050 --> 00:03:26,270
،منازل المبيت الخاصّة بالذّكور

16
00:03:26,270 --> 00:03:29,160
بالإضافة إلى منهاجها الدّراسيّ الفريد
،ومدرّسيها من النّخبة

17
00:03:29,520 --> 00:03:32,300
يصنعون من تلاميذها "رجالاً إنكليزيّين
حقيقيّين" حسبما سمعت

18
00:03:32,630 --> 00:03:37,840
كلّ العائلات النّبيلة تدفع رسوماً باهظة طوعاً

19
00:03:37,840 --> 00:03:40,440
من أجل الحصول على المكانة
الّتي تمنحها لأبنائهم

20
00:03:43,020 --> 00:03:45,150
الانطباعات الأوّليّة مهمّة

21
00:03:45,740 --> 00:03:47,080
يجب أن أركّز

22
00:03:50,580 --> 00:03:51,910
انظروا إلى هذا

23
00:03:51,910 --> 00:03:53,080
هذا غير معقول

24
00:03:53,080 --> 00:03:54,630
داسَ على العشب

25
00:03:55,000 --> 00:03:57,580
!يا للجرأة! إنّه ليس حتّى من م-4

26
00:03:57,580 --> 00:03:59,080
هذه واي مؤكّدة

27
00:03:59,080 --> 00:04:00,700
يا إلهي

28
00:04:00,700 --> 00:04:01,870
—ما الّذي

29
00:04:01,870 --> 00:04:02,590
!انظروا

30
00:04:02,590 --> 00:04:04,370
لقد أتوا

31
00:04:05,630 --> 00:04:07,510
!إنّهم المثاليّون الأربعة

32
00:04:12,390 --> 00:04:13,640
!سيقع في ورطة

33
00:04:13,640 --> 00:04:14,270
!يا للهول

34
00:04:14,270 --> 00:04:15,440
يستحقّ ذلك

35
00:04:16,590 --> 00:04:17,660
سوف يضربني؟

36
00:04:20,950 --> 00:04:22,580
ربطة عنقك عوجاء

37
00:04:26,310 --> 00:04:28,200
ما اسمك؟

38
00:04:28,200 --> 00:04:29,740
فانتومهايف

39
00:04:29,740 --> 00:04:31,370
ليس اسماً مألوفاً

40
00:04:31,370 --> 00:04:36,540
ذكرَ مديرُ المدرسة بأنّ تلميذاً جديداً
سيلتحق بالبيت الأزرق اليوم

41
00:04:36,540 --> 00:04:37,370
هل هو أنت؟

42
00:04:37,370 --> 00:04:38,090
أجل

43
00:04:38,090 --> 00:04:41,640
:القاعدة رقم 48 في كلّية ويستون

44
00:04:41,640 --> 00:04:46,560
وحدهم المثاليّين أو أولئك الحاصلين على إذن
"مثاليّ من يحقّ لهم تجاوز العشب

45
00:04:46,560 --> 00:04:48,930
يجدر بك أن تحفظ القواعد قبل أن تأتي

46
00:04:49,540 --> 00:04:50,550
—أنا آسف جد

47
00:04:50,550 --> 00:04:52,140
لنسرع إلى الدّاخل

48
00:04:53,030 --> 00:04:54,980
فالشّمس ساطعة جدّاً هنا

49
00:04:57,550 --> 00:05:00,890
كُن حذراً يا فانتومهايف

50
00:05:04,740 --> 00:05:08,950
أنت محظوظ! دستَ على العشب
!ونجوت بجلدك دون عِقاب

51
00:05:08,950 --> 00:05:09,910
تفضّل

52
00:05:10,280 --> 00:05:14,370
اسمي ماكميلان. طالب سنة
أولى في البيت الأزرق، مثلك

53
00:05:14,370 --> 00:05:16,970
حـ-حسناً. شكراً لك

54
00:05:17,300 --> 00:05:22,530
"بالمناسبة، أسمع باستمرار "م-4
و "واي"... ماذا تعنيان؟

55
00:05:22,530 --> 00:05:28,120
،واي" هي وحدة عقوبة. مقابل كلّ واي"
عليك أن تنسخ 100 سُداسيّة تفاعيل لاتينيّة

56
00:05:28,120 --> 00:05:29,090
و "م-4"؟

57
00:05:29,090 --> 00:05:33,470
.والأشخاص الأربعة الّذين التقيتَهم للتو
أتتذكّر صدريّاتهم المُلوّنة؟

58
00:05:33,850 --> 00:05:38,530
وحدهم المثاليّين من يُسمَح لهم
باختيار أقمشة صدريّاتهم

59
00:05:38,530 --> 00:05:39,590
مثاليّون؟

60
00:05:39,590 --> 00:05:42,200
اعتبرهم رؤساء منازل المبيت

61
00:05:43,310 --> 00:05:47,490
،ذو الصّدريّة الحمراء كان إدغار ريدموند
،المثاليّ من بيت الثّعلب القرمزيّ

62
00:05:47,490 --> 00:05:51,490
حيث يجتمع التّلاميذ ذوو المكانة المرموقة

63
00:05:52,580 --> 00:05:56,150
،وذو الصّدريّة الزّرقاء كان لورينس بلوار
،المثاليّ من بيت بومة الياقوت

64
00:05:56,150 --> 00:06:00,060
حيث يجتمع التّلاميذ البارعون أكاديميّاً

65
00:06:01,380 --> 00:06:05,540
،وذو الصّدريّة الخضراء كان هيرمان غرينهيل
،المثاليّ من بيت الأسد الأخضر

66
00:06:05,540 --> 00:06:09,190
حيث يجتمع التّلاميذ الماهرون
في الفنون القتاليّة والرّياضة

67
00:06:10,900 --> 00:06:14,630
،وذو الصّدريّة الأرجوانيّة كان غريغوري فيوليت
،المثاليّ من بيت الذّئب البنفسجيّ

68
00:06:14,630 --> 00:06:18,600
حيث يجتمع التّلاميذ المبدعون في الفنون

69
00:06:19,530 --> 00:06:23,390
إنّهم المثاليّون الأربعة في منازل المبيت
،التّاريخيّة التّابعة لكلّية ويستون

70
00:06:23,390 --> 00:06:25,580
!أو "م-4" كاختصار

71
00:06:25,580 --> 00:06:26,490
...حسناً

72
00:06:26,760 --> 00:06:31,480
كم أطمح أن أكون مثلهم! ليتني
أصبح مثاليّاً يوماً ما

73
00:06:31,480 --> 00:06:32,950
!ليتني

74
00:06:33,630 --> 00:06:38,180
رغم ذلك، عدم القدرة على عبور العشب
تبدو قاعدة غير مُفيدة

75
00:06:38,910 --> 00:06:40,290
قد تبدو التّقاليد كذلك

76
00:06:41,750 --> 00:06:43,890
!يا للهول! سوف نتأخّر على الدّروس

77
00:06:43,890 --> 00:06:45,960
!"لنسرع! لا أريد أي "واي

78
00:06:48,270 --> 00:06:52,730
رغم ذلك، أنا متفاجئ من مُغادرة كوليت فجأة

79
00:06:52,730 --> 00:06:56,330
ولا بدّ أنّك عانيتَ بانتقالك في منتصف الفصل

80
00:06:56,330 --> 00:07:00,640
.كنتُ أنتظر الفُرصة لفترة طويلة
لا مانع لديّ أن أعوّض

81
00:07:00,640 --> 00:07:02,250
!استعداد يا فتيان

82
00:07:03,190 --> 00:07:07,660
آخر فتى يستجيب لهذا الأمر يجب
!عليه أداء المهام للفتيان الأكبر سنّاً

83
00:07:07,660 --> 00:07:08,440
!ماذا؟

84
00:07:11,050 --> 00:07:13,350
هل أنت جديدٌ هنا أيّها المتخلِّف عن الرّكب؟

85
00:07:13,350 --> 00:07:14,500
أجل

86
00:07:14,780 --> 00:07:19,390
عُد إلى المنزل عندما تنتهي من تلميع
أحذية المثاليّين إذاً

87
00:07:19,390 --> 00:07:21,500
سوف نقيم لك حفلة ترحيب

88
00:07:27,870 --> 00:07:30,840
أهلاً بك في مبيتنا يا فانتومهايف

89
00:07:34,710 --> 00:07:37,070
آمل أن تستمتع

90
00:07:37,350 --> 00:07:38,770
!رمية

91
00:07:42,060 --> 00:07:43,940
!رمية

92
00:07:42,060 --> 00:07:45,700
حسناً؟ ما رأيك بحفلة ترحيبنا المنزليّة التّقليديّة؟

93
00:07:45,700 --> 00:07:47,800
!رمية

94
00:07:45,700 --> 00:07:51,070
احرص على الدّراسة باجتهاد أكبر الآن
بعد أن صرتَ عضواً في بيت بومة الياقوت

95
00:07:49,490 --> 00:07:51,070
!رمية

96
00:07:51,360 --> 00:07:53,450
!ارموه لارتفاع أعلى هذه المرّة

97
00:07:52,360 --> 00:07:53,450
—لا، توقّفوا

98
00:07:53,450 --> 00:07:56,240
ما كلّ هذه الفوضى؟ سأوزّع "واي" عليكم جميعاً

99
00:07:56,240 --> 00:07:57,420
!تبّاً! مسؤول المبيت

100
00:07:57,950 --> 00:08:02,540
كلايتون، أنا متفاجئ من رؤية فتى
أكبر سنّاً يشارك. ما القصّة؟

101
00:08:02,540 --> 00:08:05,670
...في الواقع يا سيّدي، هذا من تقاليد المبيت

102
00:08:07,630 --> 00:08:11,340
يا إلهي. لا مانع من التّقاليد، لكن
يجب أن تفعلوا ذلك باعتدال

103
00:08:12,040 --> 00:08:14,990
أعتقد أنّك أنت هو الفتى الجديد، فانتومهايف؟

104
00:08:16,090 --> 00:08:19,100
أهلاً بك في بيت بومة الياقوت

105
00:08:21,720 --> 00:08:24,070
اسمي ميكايليس، مسؤول المبيت

106
00:08:31,490 --> 00:08:34,580
سررتُ بلقائك يا معلّم ميكايليس

107
00:08:34,580 --> 00:08:38,130
أعتذر عن وقوعك في كلّ هذه المتاعب
في يومك الأوّل يا فانتومهايف

108
00:08:38,450 --> 00:08:39,900
هل تأذّيت؟

109
00:08:40,420 --> 00:08:42,750
،أشكرك على اهتمامك

110
00:08:42,750 --> 00:08:47,210
لكن سأكون أسعد لو أوقفتهم قبلاً

111
00:08:47,590 --> 00:08:53,100
سيكون من الفظاظة منّي أن أتعامل
بقسوة تجاه نقطة تحوُّل هامّة

112
00:08:53,930 --> 00:08:57,510
فكما ترى، أنا مجرّد مسؤول مبيت

113
00:08:59,740 --> 00:09:05,330
حسناً يا فانتومهايف، أنت مطلوب
في مكتب مدير المدرسة

114
00:09:21,270 --> 00:09:26,160
كيف كان يومك الأوّل هنا يا فانتومهايف؟

115
00:09:26,650 --> 00:09:30,510
إذا لم يلائمك البيت الأزرق، فيمكنك
أن تأتي إلى البيت الأحمر

116
00:09:30,850 --> 00:09:34,130
شخص بمكانتك مُرحَّب به دوماً

117
00:09:34,420 --> 00:09:40,350
وحده مدير المدرسة من لديه الصّلاحيّة بتوزيع
التّلاميذ في المبيت. بلا استثناءات

118
00:09:41,240 --> 00:09:43,670
سيكون الأمر نفسه غالباً في أيّ بيت

119
00:09:43,930 --> 00:09:49,830
،هذه مدرسةٌ عامّة مرموقة
تحميها التّقاليد والانضباط

120
00:09:49,830 --> 00:09:54,280
،الآن بعد أن صرتَ تلميذاً هنا
يجب أن تطيع القواعد

121
00:09:56,250 --> 00:10:00,090
في العادة، مدير المدرسة هو من يلقي
،عليك بعض كلمات التّرحيب

122
00:10:00,090 --> 00:10:02,540
لكنّه مشغول جدّاً، لذا سأحلّ مكانه

123
00:10:03,970 --> 00:10:07,460
اسمي يوهان آغاريس، مدير أدنى للكلّية

124
00:10:08,100 --> 00:10:11,520
المُدير الرّئيسيّ هو من يقرّر كلّ شيء هنا

125
00:10:11,520 --> 00:10:15,300
ضمن هذه المؤسّسة، قراراته هي القانون الأعلى

126
00:10:15,300 --> 00:10:19,550
ونحن المثاليّون مُكلَّفون بحكم الهيئة الطلّابيّة

127
00:10:20,260 --> 00:10:23,560
.يُثقِلوننا بواجبات مُزعجة
إنّه دور بغيض

128
00:10:24,620 --> 00:10:27,870
كان هذا تقليد المدرسة منذ تأسيسها

129
00:10:28,540 --> 00:10:29,650
...و

130
00:10:30,400 --> 00:10:32,110
التّقاليد مُطلَقة

131
00:10:34,630 --> 00:10:36,390
...شييل فانتومهايف

132
00:10:36,920 --> 00:10:42,500
هل تقسم بالالتزام بكافّة تقاليد
وقواعد كلّية ويستون؟

133
00:10:43,570 --> 00:10:44,340
أجل

134
00:10:45,690 --> 00:10:47,790
إذاً وقّع هنا من فضلك

135
00:10:50,370 --> 00:10:51,790
!المُعلّم آغاريس

136
00:10:51,790 --> 00:10:55,250
.المعذرة، المعذرة، المعذرة
المعذرة، المعذرة، المعذرة

137
00:10:57,530 --> 00:10:58,970
وقّع هنا من فضلك

138
00:11:00,730 --> 00:11:03,890
أهلاً بك في كلّية ويستون يا فانتومهايف

139
00:11:04,600 --> 00:11:06,850
سررنا بانضمامك

140
00:11:15,350 --> 00:11:18,140
آمل أن تعيش حياة سعيدة هنا

141
00:11:19,370 --> 00:11:24,200
المعذرة، لكن متى تعتقدون بأنّني سأتمكّن
من إلقاء التّحيّة على مدير المدرسة؟

142
00:11:24,920 --> 00:11:29,030
مدير المدرسة مشغول جدّاً عن اللّقاء
بتلاميذ عاديّين

143
00:11:29,430 --> 00:11:34,980
نحن المثاليّون الوحيدون الّذين يُسمَح
لنا بترتيب موعد لقاء معه

144
00:11:41,140 --> 00:11:43,980
التّلاميذ العاديّون لا يستطيعون اللّقاء
بمدير المدرسة؟

145
00:11:45,000 --> 00:11:50,020
إذاً مدير المدرسة هو جوهريّاً ملَكيّ
مُطلَق في هذا المكان؟

146
00:11:53,710 --> 00:11:58,370
في المدارس العامّة، الفتيان الّذين تتراوح
أعمارهم بين 13 إلى 18

147
00:11:58,370 --> 00:12:02,400
يعيشون معاً في منازل المبيت ويكرّسون
أنفسهم لدراستهم

148
00:12:03,170 --> 00:12:07,280
كلّ جزء من حياتهم يحدّده قرع الأجراس

149
00:12:28,390 --> 00:12:29,900
كادحون"؟"

150
00:12:30,180 --> 00:12:34,520
.أجل. الكادحون هم أشبه بالمهنيّين المُبتدئين
أو ربّما بمثابة أخوة صغار؟

151
00:12:34,870 --> 00:12:38,120
بعد الفطور، يحين وقتنا للعمل

152
00:12:38,120 --> 00:12:43,930
إنّه تقليد فريد في ويستون حيث
كلّ فتى جديد يخدم فتى قديماً

153
00:12:43,930 --> 00:12:44,990
وكيف يخدمه؟

154
00:12:44,990 --> 00:12:48,660
يرتّب غرفته ويكوي زيّه المدرسيّ

155
00:12:48,660 --> 00:12:51,120
ويحضر له ماء ساخناً في اللّيل، ومثل هذه الأمور

156
00:12:51,540 --> 00:12:54,210
أي يلعب دور الخادم جوهريّاً

157
00:12:54,210 --> 00:12:56,580
تقليد مزعج آخر

158
00:12:58,380 --> 00:13:00,700
هل لدى المثاليّين كادحون؟

159
00:13:00,700 --> 00:13:06,550
بالطّبع! كلايتون يخدم بلوار، مثاليّ البيت الأزرق

160
00:13:06,550 --> 00:13:07,900
كلايتون؟

161
00:13:08,570 --> 00:13:09,970
هو

162
00:13:10,630 --> 00:13:15,390
الكادحون مختلفون عن الخدَم، بما أنّ أسياد
،الكادحين يعتنون بهم بالمقابل

163
00:13:15,390 --> 00:13:19,480
ربّما أفضل طريقة لوصفهم هي أنّهم
بمثابة الأخوة، باستثناء أنّنا في المدرسة

164
00:13:19,930 --> 00:13:21,420
أخوة؟

165
00:13:21,420 --> 00:13:25,470
!ويحصل كادحو المثاليّين على امتيازات خاصّة

166
00:13:25,470 --> 00:13:27,990
تُثبَّت في معاطفهم الخُطّافية
،نفس زهرة المنزل

167
00:13:27,990 --> 00:13:30,450
ويمكنهم عبور العشب إذا حصلوا على إذن

168
00:13:30,450 --> 00:13:36,010
وسمعتُ حتّى بأنّهم يحقّ لهم الانضمام لـ"م-4" في حفلات
شاي منتصف اللّيل المُقامة بواسطة مدير المدرسة

169
00:13:36,620 --> 00:13:38,660
،إذا استطعتُ حضور حفلة شاي منتصف اللّيل

170
00:13:38,660 --> 00:13:41,710
فسأحظى بفرصة للاحتكاك مع مدير المدرسة

171
00:13:41,710 --> 00:13:47,430
"لكن قائمة الضّيوف الّتي تنحصر ضمن "م-4
وكادحيهم فقط تعقّد الأمور قليلاً

172
00:13:47,770 --> 00:13:51,560
!أرغب في حضور حفلة يوماً ما! ليتني

173
00:13:52,810 --> 00:13:59,140
لا أصل إلى نتيجة. يجب أن أدخل
صلبَ الموضوع مباشرة

174
00:13:59,560 --> 00:14:02,020
...بعيداً عن هذا الموضوع، لو سمحت

175
00:14:02,550 --> 00:14:05,880
هل تعرف ديريك آردين، ابن دوق كليمينس؟

176
00:14:05,880 --> 00:14:09,740
—أعتقد بأنّه في بيت الثّعلب القرمزيّ

177
00:14:13,990 --> 00:14:15,200
ما هذا؟

178
00:14:15,200 --> 00:14:16,580
!فانتومهايف

179
00:14:16,580 --> 00:14:20,290
الفتى الّذي يكون ودوداً مع أشخاص
!في البيوت الأخرى يكرهه الجميع

180
00:14:20,290 --> 00:14:23,950
عفواً؟ هل نحن شلّة فتيات صغيرات الآن؟

181
00:14:23,950 --> 00:14:27,550
هناك الكثير من المنافسات بين البيوت

182
00:14:28,110 --> 00:14:34,760
لكن أنا متأكّدٌ بأنّني أذكر أنّ آردين
انتقل إلى البيت الأرجوانيّ

183
00:14:35,110 --> 00:14:35,970
انتقل؟

184
00:14:36,290 --> 00:14:40,570
لا أعرف التّفاصيل، لكن يُقال بأنّ ذلك
كان بأمر من مدير المدرسة

185
00:14:40,570 --> 00:14:41,810
أمر من مدير المدرسة؟

186
00:14:41,810 --> 00:14:46,280
عـ-على أيّ حال، من الأفضل عدم
!التورّط مع البيوت الأخرى

187
00:14:46,280 --> 00:14:48,740
لا سيّما بيت الذّئب البنفسجيّ

188
00:14:49,620 --> 00:14:50,840
—ماذا تعني

189
00:14:50,840 --> 00:14:52,490
!ماكميلان! حان وقت العمل

190
00:14:52,490 --> 00:14:53,330
!قادم

191
00:14:53,330 --> 00:14:57,620
!إنّه سينباي. إلى اللّقاء يا فانتومهايف

192
00:15:00,310 --> 00:15:02,360
ما هذه الوضعيّة؟

193
00:15:04,010 --> 00:15:08,040
إذاً تغيّر مكان ديريك آردين؟

194
00:15:08,390 --> 00:15:10,520
لا بدّ من وجود سبب وراء ذلك

195
00:15:10,520 --> 00:15:11,970
!فانتومهايف

196
00:15:12,290 --> 00:15:13,690
نعم يا كلايتون؟

197
00:15:14,020 --> 00:15:17,430
ستنظّف غرفة الطّعام حتّى يتمّ
تخصيصك لتلميذ أكبر

198
00:15:18,810 --> 00:15:20,520
غرفة الطّعام؟

199
00:15:21,340 --> 00:15:24,050
تقصد... هذه الغرفة بأكملها؟

200
00:15:24,050 --> 00:15:25,150
أجل

201
00:15:25,150 --> 00:15:26,610
!والكسل غير مقبول

202
00:15:32,820 --> 00:15:34,050
سيباستيان

203
00:15:39,950 --> 00:15:41,160
حاضر

204
00:15:44,130 --> 00:15:46,600
يبدو أنّ ديريك آردين انتقل إلى بيت آخر

205
00:15:46,600 --> 00:15:51,450
اسمه ظاهر بجانب بيت الذّئب
البنفسجيّ في السجلّات

206
00:15:51,450 --> 00:15:53,240
ينبغي أن يكون هناك في هذه السّاعة

207
00:15:53,240 --> 00:15:56,370
سأذهب لزيارته. بينما نظّف المكان هنا

208
00:15:56,370 --> 00:15:57,880
حاضر يا مولايّ

209
00:15:59,130 --> 00:16:00,390
...حسناً إذاً

210
00:16:01,800 --> 00:16:03,240
!إلى العمل

211
00:16:12,610 --> 00:16:14,820
!يا للجماليّة

212
00:16:15,640 --> 00:16:18,490
هذا يلائم البيت المليء بالغرائب

213
00:16:25,830 --> 00:16:27,510
إنّه غريب

214
00:16:27,510 --> 00:16:28,840
غريب

215
00:16:28,840 --> 00:16:30,210
هذا شِعار البيت الأزرق

216
00:16:30,210 --> 00:16:32,050
!مـ-متى وصلوا إلى هنا؟

217
00:16:32,050 --> 00:16:37,100
مهلاً، مهلاً، ماذا تريد من البيت الأرجوانيّ؟

218
00:16:37,100 --> 00:16:41,580
تحتاج أكثر من علامات جيّدة قبل
!أن يُسمَح لك بالدّخول إلى هنا

219
00:16:41,580 --> 00:16:42,500
اخرج

220
00:16:42,500 --> 00:16:44,400
أجل، اخرج

221
00:16:44,400 --> 00:16:46,520
غادر أيّها الغريب

222
00:16:46,520 --> 00:16:47,290
!اخرج

223
00:16:47,290 --> 00:16:48,190
!مؤلم

224
00:16:48,190 --> 00:16:50,670
!اخرج من البيت الأرجوانيّ

225
00:16:51,230 --> 00:16:56,200
أحضِر قاموساً ثخيناً لحماية رأسك في المرّة
!المقبلة يا مهووس الدّراسة الأحمق

226
00:16:56,500 --> 00:16:58,830
!ما-ماذا كان ذلك؟

227
00:16:59,090 --> 00:17:00,710
ما كلّ هذه الفوضى؟

228
00:17:02,190 --> 00:17:04,080
مرحباً يا فيوليت

229
00:17:04,080 --> 00:17:06,510
أتى أحد مهووسي الدّراسة

230
00:17:10,420 --> 00:17:11,610
الفتى الجديد؟

231
00:17:17,390 --> 00:17:19,400
كان ذلك فظيعاً

232
00:17:20,290 --> 00:17:25,140
أرى أنّ العداوة بين البيوت أسوأ ممّا توقّعت

233
00:17:25,690 --> 00:17:29,850
اِنسَ مدير المدرسة. لا أستطيع
حتّى زيارة آردين؟

234
00:17:30,740 --> 00:17:33,820
الألقاب والثّروة لا تعنيان شيئاً هنا

235
00:17:34,240 --> 00:17:38,490
ما دمتُ تلميذاً عاديّاً، سأواجه
مشكلة حتّى في جمع المعلومات

236
00:17:39,030 --> 00:17:43,450
لتبقى طريقة واحدة فقط للوصول
إلى وسط كل هذا

237
00:17:44,370 --> 00:17:47,540
يترتّب عليّ التزلُّف للمثاليّين الأربعة

238
00:17:48,790 --> 00:17:50,920
...السّؤال هو كيف

239
00:17:54,910 --> 00:17:56,000
لا أصدِّق ذلك

240
00:17:55,460 --> 00:17:56,670
كيف فعلها؟

241
00:18:00,300 --> 00:18:01,520
!فانتومهايف

242
00:18:01,520 --> 00:18:02,220
!نعم؟

243
00:18:02,520 --> 00:18:04,630
!يا للهول! هل اكتشفَ بأنّني لم أنظّف؟

244
00:18:04,630 --> 00:18:08,770
...لستُ من النّوع الّذي يمدح. لكن

245
00:18:08,770 --> 00:18:11,710
!اليوم، أرغب في الثّناء عليك

246
00:18:11,710 --> 00:18:12,690
عفواً؟

247
00:18:16,610 --> 00:18:21,530
،غرفة طعامنا القديمة، أقصد التّاريخيّة
!لم تكن بهذه النّظافة يوماً

248
00:18:21,530 --> 00:18:23,530
!عمل متألِّق يا فانتومهايف

249
00:18:23,530 --> 00:18:25,450
أنت تحرجني

250
00:18:25,450 --> 00:18:27,940
!ذلك البغيض قد بالغ كثيراً

251
00:18:28,540 --> 00:18:30,050
!المعلّم ميكايليس

252
00:18:30,460 --> 00:18:31,630
ما الأمر؟

253
00:18:31,940 --> 00:18:36,120
انظر إلى غرفة الطّعام هذه! فانتومهايف نظّفَها اليوم

254
00:18:36,120 --> 00:18:37,840
مُبهر بحقّ

255
00:18:38,130 --> 00:18:41,010
أحسنت صنعاً يا فانتومهايف

256
00:18:41,300 --> 00:18:43,540
لم يكن هناك ضرورة لذلك

257
00:18:44,050 --> 00:18:45,770
شكراً لك يا معلّم

258
00:18:45,770 --> 00:18:47,020
مهلاً

259
00:18:48,110 --> 00:18:50,850
...كلايتون هو كادح لبلوار

260
00:18:48,120 --> 00:18:50,110
،طلبتُ منه القيام بذلك لأرى مؤهّلاته

261
00:18:50,110 --> 00:18:51,720
بما أنّه لم يُخصَّص ككادح لسيّد بعد

262
00:18:51,270 --> 00:18:53,260
يمكنني استغلال هذا

263
00:18:52,020 --> 00:18:54,230
لم أتصوّر أبداً أن يبدع هكذا
خلال فترة قصيرة

264
00:18:54,230 --> 00:18:59,460
مخطّطي لنَيل حظوتي عند المثاليّين
سوف يبدأ معه

265
00:19:00,200 --> 00:19:02,560
أنا مسرور جدّاً لأنّني أرضيتُكم

266
00:19:02,560 --> 00:19:06,160
!للأمانة، الأعمال المنزليّة هي اختصاصي

267
00:19:07,550 --> 00:19:12,820
من فضلك، اطلب منّي ما تحتاجه يا كلايتون سينباي

268
00:19:22,430 --> 00:19:24,360
—يا بُنيّ العزيز"

269
00:19:24,700 --> 00:19:28,100
"مُفزِع جدّاً ما حدث في كومبانيا

270
00:19:28,680 --> 00:19:32,900
آمل أن تكون قد تعافيت تماماً"
"وتستمتع بعيد الفصح

271
00:19:34,500 --> 00:19:38,590
بالنّسبة لي، أخشى من القلق كثيراً"

272
00:19:38,590 --> 00:19:42,710
"لدرجة أعجز فيها عن الاستمتاع بالعطلة بحقّ

273
00:19:43,670 --> 00:19:51,140
"ما يقلقني هو ابن ابن عمّي كليمينس، ديريك"

274
00:19:51,770 --> 00:19:55,240
،ديريك في عامه الخامس في ويستون"

275
00:19:55,240 --> 00:19:59,450
ولسبب ما، لم يعُد للدّيار لرؤية
"والديه منذ الصّيف الماضي

276
00:19:59,900 --> 00:20:04,180
كان يراسلهما يوميّاً، لكن"
"لم تعُد رسائله تصل كذلك

277
00:20:07,940 --> 00:20:10,690
،حاولت أمُّه الدّوقيّة زيارة مبيته"

278
00:20:10,690 --> 00:20:12,770
"لكن قيل لي بأنّه رفضَ الخروج

279
00:20:13,410 --> 00:20:17,590
في العادة، أفترض بأنّه في مرحلة"
،تمرُّد ببساطة

280
00:20:17,590 --> 00:20:22,780
لكن يبدو أنّ عدداً من التّلاميذ الآخرين
"توقّفوا عن العودة إلى الدّيار أيضاً

281
00:20:23,740 --> 00:20:26,870
"ما الّذي يمكن أن يكون قد حدث لهم؟"

282
00:20:29,990 --> 00:20:35,710
كليمينس المسكين مريض لأنّه فقد"
"الاتّصال مع ابنه بهذه الطّريقة

283
00:20:36,310 --> 00:20:38,240
"أنا قلقة للغاية"

284
00:20:39,850 --> 00:20:48,510
أدعو أن يتمكّن كلّ أحبّائي قريباً"
من الاستمتاع بعطلة فصح هادئة

285
00:20:49,470 --> 00:20:50,890
"فيكتوريا—

286
00:20:52,850 --> 00:21:00,150
بصيغة أخرى، تقول، "تحرَّ حول سبب
"اختفاء تلاميذ ويستون

287
00:21:00,590 --> 00:21:04,240
وتشير إلى أنّها تواجه مشكلة في التصرُّف
بشكل مباشر لأنّ المدارس العامّة

288
00:21:04,240 --> 00:21:07,120
هي مؤسّسات مستقلّة محميّة
من تدخُّل الحكومة

289
00:21:07,830 --> 00:21:09,240
لكن أعتقد بأنّ الحقيقة هي

290
00:21:09,240 --> 00:21:13,080
أنّها لا تريد إحداث جلبة والمُخاطرة
بفضح أسرار العائلة علناً

291
00:21:13,080 --> 00:21:15,830
...القلق بشأن المظاهر حتّى في وقت كهذا

292
00:21:16,270 --> 00:21:19,210
هذه هي مشكلة البشر

293
00:21:19,210 --> 00:21:21,980
كنتُ لأفضّل أن أدع شخصاً
،يخترق المدرسة خلسة

294
00:21:21,980 --> 00:21:25,930
لكن ويستون مليئة بأبناء النُّبلاء

295
00:21:25,930 --> 00:21:30,560
،عدد الزُّملاء الّذين يمكن الاختيار منهم قليل
وأيّ شخص منهم قد تُكشَف هويّته بسهولة

296
00:21:30,560 --> 00:21:33,180
إنَّ محاولة التنكُّر بهويّة شخص
ستكون محفوفة بالمخاطر

297
00:21:34,050 --> 00:21:35,620
ستذهب بنفسك إذاً؟

298
00:21:38,020 --> 00:21:39,510
وهل لديّ خيار آخر؟

299
00:21:39,510 --> 00:21:42,400
حسناً، لن أمانع أن تكون الملِكة
مَدينة لي بمعروف

300
00:21:42,730 --> 00:21:46,490
المشكلة هي فيما إذا كانت هناك
ثغرة في ويستون لالتحاق تلميذ جديد

301
00:21:46,770 --> 00:21:50,740
،الحلّ سهل. إن لم تكن هناك ثغرة
فيمكنك أن تصنع واحدة

302
00:21:54,130 --> 00:21:57,070
من الأفضل أن أبحث في أرض الكلّية

303
00:21:57,430 --> 00:22:00,960
ستساعدني دون أن يُكشَف أمرنا

304
00:22:01,500 --> 00:22:03,210
أترك التّفاصيل عليك

305
00:22:19,660 --> 00:22:21,820
حاضر، مولايّ