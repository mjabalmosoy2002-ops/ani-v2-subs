1
00:00:06,640 --> 00:00:09,980
المدرسة العامّة: مؤسّسة تقدّر
العادات والانضباط

2
00:00:11,520 --> 00:00:15,250
نِظام الكادحين: علاقة "أخويّة" غير
موجودة سوى في هذا المكان

3
00:00:16,820 --> 00:00:20,730
مدير المدرسة: سلطة مُطلَقة لا يكشف عن نفسه أبداً

4
00:00:21,690 --> 00:00:26,910
المثاليّون: أربعة فتيان يحكمون أبنية
المبيت المُتنازِعة الأربعة

5
00:00:28,720 --> 00:00:34,460
بسبب قواعد ويستون الفريدة، لم تحرز
تحقيقاتي أي تقدُّم يُذكَر

6
00:00:34,790 --> 00:00:42,300
،لكسب الحرّية في هذه الحديقة المُسوَّرة
اتّخذتُ قراراً قاسياً

7
00:02:17,670 --> 00:02:24,120
مسؤول المبيت هو مُدرّس يقطن
في مبيت ليُرشِد تلاميذه

8
00:02:24,370 --> 00:02:26,810
طاب يومك يا مُعلّم ميكايليس

9
00:02:26,810 --> 00:02:28,800
طاب يومكما

10
00:02:29,260 --> 00:02:34,750
كلّ بناء مبيت من الأبنية الأربعة التّابعين
لكلّية ويستون لديه طاقم صغير

11
00:02:34,980 --> 00:02:36,840
سيّدة للاهتمام بالشّؤون المحلّية

12
00:02:37,160 --> 00:02:38,920
طبّاخ لإعداد الطّعام

13
00:02:38,920 --> 00:02:41,390
وصيف يخدم الموائد

14
00:02:41,730 --> 00:02:45,930
لكن مسؤول المبيت هو الوحيد
بينهم الّذي يكون مُدرِّساً أيضاً

15
00:02:46,600 --> 00:02:49,600
في كلّ صباح، يتوجّه إلى بناء
،المدرسة رفقة تلاميذه

16
00:02:49,600 --> 00:02:51,880
ويعلّم الدّروس ضمن اختصاصه

17
00:02:52,340 --> 00:02:54,610
،في كلّ مساء، يعود إلى المبيت رفقة تلاميذه

18
00:02:54,610 --> 00:02:57,390
وفي ساعات السّكون، يساعدهم
في دراستهم عند الطّلب

19
00:02:57,820 --> 00:03:02,560
بعبارة أخرى، مسؤول المبيت يكرّس
غالبيّة يومه من أجل التّلاميذ

20
00:03:02,560 --> 00:03:04,520
إنّه عملٌ مُلحّ

21
00:03:05,580 --> 00:03:06,990
...ومع ذلك

22
00:03:07,230 --> 00:03:09,000
انظروا إلى مولايّ الصّغير...

23
00:03:09,460 --> 00:03:11,690
!نظِّم رفوف كتُب كلايتون

24
00:03:11,690 --> 00:03:14,190
!هناك زرّ مفقود من مِعطف كلايتون، أصلحه

25
00:03:14,190 --> 00:03:17,630
أحضر بودينغ مع القَطر الذّهبيّ
!من أجل شاي كلايتون اليوم

26
00:03:17,630 --> 00:03:19,340
ولي أيضاً

27
00:03:21,740 --> 00:03:26,200
يقبل كافّة أشكال المهام بسهولة لأنّه
يعلم بأنّني سأكون أنا من أؤدّيها

28
00:03:29,600 --> 00:03:30,850
...لديّ ما يكفي من عمل

29
00:03:30,850 --> 00:03:32,600
...لأؤدّيه بالفعل

30
00:03:32,920 --> 00:03:34,260
سأدعك تعلم ذلك

31
00:03:38,200 --> 00:03:39,970
ينبغي لهذا أن يفي بالغرض

32
00:03:41,080 --> 00:03:45,070
لنرَ... التّالي هو مدرستي
مع طلّاب السّنة الأولى

33
00:03:45,740 --> 00:03:49,230
!كم أنا مشغول

34
00:03:52,020 --> 00:03:55,880
لا بدّ أنّه من الكريه أداء الكثير
من المهام يا فانتومهايف

35
00:04:01,620 --> 00:04:05,110
يستغلّ كلايتون حقيقة أنّك
كادح بلا سيّد إلى الآن

36
00:04:05,110 --> 00:04:07,760
ليجعلك تؤدّي الكثير من المهام

37
00:04:07,760 --> 00:04:12,480
هذا لا يزعجني بصراحة. لديّ خدعة
لإنجاز الأمور بسرعة

38
00:04:12,480 --> 00:04:15,770
!حقّاً؟! آمل أن تعلّمني إيّاها يوماً ما

39
00:04:16,110 --> 00:04:18,620
أنت رهيب حقّاً

40
00:04:18,620 --> 00:04:21,650
حقّقتَ علامات مرتفعة في ذلك
الاختبار أيضاً، أليس كذلك؟

41
00:04:21,650 --> 00:04:24,070
شاءت الصّدفة أنّ مواد الاختبار كانت
أشياء سبقَ ودرستُها

42
00:04:24,070 --> 00:04:29,160
يبدو أنّ كلّ السّينباي يتحدّثون حول
مَن سوف تصبح كادحاً له

43
00:04:29,380 --> 00:04:32,390
!قد يعرض عليك أحدُهم عرضاً قريباً

44
00:04:34,730 --> 00:04:37,960
شخصيّاً، أعتقد سيكون كلايتون

45
00:04:38,970 --> 00:04:41,420
سيكون هذا شرفاً لي

46
00:04:41,420 --> 00:04:44,380
جميعكم، حان وقت البدء

47
00:04:45,720 --> 00:04:51,620
حبّذا أن يكون هو. سوف أصبح
كادح كلايتون مهما كلّف الأمر

48
00:05:03,070 --> 00:05:06,280
هل تريد فُنجاناً آخر يا ريدموند سينباي؟

49
00:05:06,900 --> 00:05:09,100
لا مانع

50
00:05:11,260 --> 00:05:14,290
شايك هو الألذّ دوماً يا موريس

51
00:05:15,360 --> 00:05:16,930
شكراً لك

52
00:05:17,370 --> 00:05:22,590
سمعتُ أنّ التّلميذ الجديد مُبهر جدّاً أيضاً

53
00:05:22,840 --> 00:05:26,680
فطيرة لورينس الظّريفة؟

54
00:05:26,680 --> 00:05:28,610
يراودني فضول تجاهه

55
00:05:28,940 --> 00:05:31,190
كُفّ عن مناداتي باسمي الأوّل

56
00:05:31,810 --> 00:05:33,310
هذا مُنافٍ للقواعد

57
00:05:34,890 --> 00:05:36,940
يا لك من رجعيّ يا بلوار

58
00:05:36,940 --> 00:05:40,400
وحدهم المثاليّون من يُسمَح لهم
بالتّواجد في مقصورة حديقة البجعة

59
00:05:40,400 --> 00:05:42,650
لن يسمعنا أو يعاتبنا أحد

60
00:05:42,920 --> 00:05:46,500
كلايتون، ما رأيك بالفتى الجديد؟

61
00:05:48,120 --> 00:05:49,940
إنّه موهوبٌ جدّاً

62
00:05:49,940 --> 00:05:52,490
دائماً ما يؤدّي مهامه بسرعة وبدقّة

63
00:05:52,790 --> 00:05:59,790
الأهمّ، الشّاي الّذي يقدّمه أشبه
بشاي يحضّره طبّاخ فرنسيّ نخبة

64
00:06:00,020 --> 00:06:04,750
أليس هو بمرتبة إيرل؟
كيف يستطيع فعل ذلك؟

65
00:06:04,750 --> 00:06:07,390
يدّعي بأنّها هواية له

66
00:06:08,080 --> 00:06:10,670
يبدو أقرب إلى خادم منه إلى إيرل

67
00:06:10,980 --> 00:06:13,770
غريب أطوار

68
00:06:15,110 --> 00:06:19,350
ربّما لهذا أتى إلى مبيتي

69
00:06:19,880 --> 00:06:20,650
هو ماذا؟

70
00:06:21,120 --> 00:06:25,180
زار منزلي أثناء دوام الكادحين قبل أيّام

71
00:06:25,180 --> 00:06:26,270
لوحده

72
00:06:27,190 --> 00:06:31,690
،هل أنت متأكّد بأنّه كان هو؟ بأعماله الغزيرة
أشكُّ في أنّه سيحظى بوقت للتجوُّل

73
00:06:32,400 --> 00:06:36,040
كان يضع رقعة عين، لذا أفترض أنّه كان هو

74
00:06:36,040 --> 00:06:39,900
ولماذا يذهب إلى بيت الذّئب البنفسجيّ؟

75
00:06:41,470 --> 00:06:45,000
إذا كان بتلك الموهبة، فأتمنّى أن يُخصَّص لبيتي

76
00:06:45,380 --> 00:06:47,610
!لديه مكانة اجتماعيّة

77
00:06:48,010 --> 00:06:51,550
فأساساً، قلّ من الفتيان في سنّه
مَن يتبوءون منصبَ الإيرل المهيب

78
00:06:51,550 --> 00:06:52,550
ماذا؟

79
00:06:52,860 --> 00:06:53,580
ما الأمر؟

80
00:06:53,910 --> 00:06:57,270
هل يمكنني التكلّم بصراحة يا غرينهيل سينباي؟

81
00:06:57,270 --> 00:06:59,730
!لا أستطيع سماعك! عاود المُحاولة

82
00:06:59,730 --> 00:07:02,790
!حاضر! هلّا حصلتُ على إذن بالتكلّم؟

83
00:07:02,790 --> 00:07:06,070
!حسناً. إدوارد ميدفورد! أمنحك الإذن

84
00:07:06,310 --> 00:07:07,850
!شكراً جزيلاً لك

85
00:07:08,730 --> 00:07:15,960
،ذلك الفتى الّذي كنتم تتحدّثون عنه
هل يُدعى شييل فانتومهايف؟

86
00:07:16,360 --> 00:07:18,250
أتعرفه؟

87
00:07:18,250 --> 00:07:24,580
...أجل. إنّه ابن عمّي، وخطيب ليزي
أقصد خطيب أختي

88
00:07:25,200 --> 00:07:29,060
...لم أتخيّل أبداً أن يكون هنا في ويستون

89
00:07:29,590 --> 00:07:35,420
كلّ الفتيان الأثرياء الصّغار في إنجلترا ينتهي
المطاف بهم هنا. ما المفاجئ في الأمر؟

90
00:07:36,250 --> 00:07:40,170
في الواقع، كان على متن كامبانيا
معي عندما غرقتْ

91
00:07:40,170 --> 00:07:43,900
أجل. السّفينة الفاخرة الّتي غرقتْ، صحيح؟

92
00:07:43,900 --> 00:07:47,530
!أتمنّى أن أستدعيه إلى هنا ليروي الحكاية

93
00:07:47,530 --> 00:07:48,110
ماذا؟

94
00:07:48,110 --> 00:07:52,820
احترم العدد الكبير من الأشخاص
الّذين ماتوا يا ريدموند

95
00:07:53,040 --> 00:07:57,660
أريد فقط سماع ظريف يتحدّث
عن رحلته، هذا كلّ ما في الأمر

96
00:07:57,660 --> 00:08:01,370
لقد سئمتُ من الإحاطةِ بوجوه
بوجوه قبيحة طوال الوقت

97
00:08:01,780 --> 00:08:06,340
ألا يقتلكم الفضول لتجربة شايه الشّهير وكعكه؟

98
00:08:06,340 --> 00:08:10,590
لا أعرفه، لكن يبدو مذهلاً

99
00:08:10,590 --> 00:08:18,310
لكن دعوة فتى جديد لزيارة مجموعة
من تلاميذ أكبر قد يُوتِّره

100
00:08:18,720 --> 00:08:20,450
أظنّها فكرة سديدة

101
00:08:20,450 --> 00:08:25,690
حرصتُ على استعمال القسوة معه
...باعتباره من العائلة. رغم ذلك

102
00:08:26,640 --> 00:08:32,000
أبلى بلاء حسناً في خِلافة أبيه وهو
بهذا السنّ الصّغير. أحترمه كرجل

103
00:08:32,950 --> 00:08:36,730
توصية من مصدر موثوق. سأوافق عليها

104
00:08:36,730 --> 00:08:38,280
شكراً لك يا غرينهيل سينباي

105
00:08:39,090 --> 00:08:40,720
ما رأيك يا فيوليت؟

106
00:08:40,720 --> 00:08:43,310
لا مانع لديّ. يبدو هذا مثيراً

107
00:08:44,250 --> 00:08:47,710
،حُسِمَ الأمر إذاً! لا مشكلة لديك
أليس كذلك يا لورينس؟

108
00:08:48,050 --> 00:08:51,960
"سأوافق شريطة أن تناديني "بلوار

109
00:08:52,200 --> 00:08:54,250
حسناً، متى سنستدعيه إلى هنا؟

110
00:08:54,250 --> 00:08:56,110
ما رأيكم بالغد؟

111
00:08:56,110 --> 00:08:58,460
غداً على السّاعة الثّانية إذاً

112
00:08:58,460 --> 00:09:03,860
!في هذه الحالة، سأذهب لإبلاغه حالاً
لننتهز الفرصة فحسب

113
00:09:04,640 --> 00:09:06,650
غداً على السّاعة الثّانية

114
00:09:07,600 --> 00:09:09,900
!فـ-فـ-فانتومهايف

115
00:09:10,220 --> 00:09:12,480
!طلبك كول سينباي

116
00:09:13,440 --> 00:09:15,490
!كانت أوّل مرّة أتحدّث فيها معه

117
00:09:15,490 --> 00:09:17,700
مَن يكون كول؟

118
00:09:18,260 --> 00:09:23,540
موريس كول، الكادح الخاصّ بمثاليّ
!بيت الثّعلب القرمزيّ

119
00:09:23,540 --> 00:09:24,760
!لم تكن تعلم؟

120
00:09:24,760 --> 00:09:27,110
!إنّه الفتى الأجمل في ويستون

121
00:09:27,110 --> 00:09:29,880
...لم ألتقِ به من قبل

122
00:09:36,480 --> 00:09:38,590
أنت فانتومهايف؟

123
00:09:39,050 --> 00:09:43,860
،سررتُ بلقائك، اسمي موريس كول
الكادح الخاصّ بالمثاليّ ريدموند

124
00:09:44,520 --> 00:09:46,490
شييل فانتومهايف

125
00:09:50,190 --> 00:09:53,440
المعذرة، هل أردت شيئاً؟

126
00:09:53,440 --> 00:09:55,530
!تذكّرت

127
00:09:55,870 --> 00:10:01,720
المثاليّون وكادحوهم يجتمعون كثيراً
بشكلٍ سرّي في مقصورة حديقة البجعة

128
00:10:01,720 --> 00:10:05,330
اليوم، كان الجميع يتحدّثون
عن التّلميذ المتألّق الجديد

129
00:10:05,330 --> 00:10:06,320
هكذا إذاً

130
00:10:06,670 --> 00:10:10,680
قرّر الطلّاب الكبار أنّهم يرغبون في التّحادث معك

131
00:10:11,450 --> 00:10:15,960
لذا هل توافق على المجيء إلى مقصورة
حديقة البجعة غداً يا فانتومهايف؟

132
00:10:17,220 --> 00:10:20,790
!هذه فُرصة للتقرُّب من "م-4" فوراً

133
00:10:21,140 --> 00:10:23,230
!بالطّبع! سيكون هذا من دواعي سروري

134
00:10:23,930 --> 00:10:26,500
!حقّاً؟ هذا جيّد

135
00:10:27,520 --> 00:10:29,700
إذاً سننتظرك على السّاعة الرّابعة

136
00:10:29,700 --> 00:10:31,300
في مقصورة حديقة البجعة

137
00:10:32,170 --> 00:10:33,480
!إلى اللّقاء إذاً

138
00:10:41,290 --> 00:10:43,370
!هذا مذهل يا فانتومهايف

139
00:10:43,370 --> 00:10:46,500
وحدهم الـ"م-4" من يُسمَح لهم
!بدخول مقصورة حديقة البجعة

140
00:10:43,710 --> 00:10:46,850
!ليتني أستطيع مرافقتك

141
00:10:44,060 --> 00:10:46,240
!أنا مُندهش

142
00:10:46,500 --> 00:10:48,410
!أخبرنا بكلّ شيء جرى لاحقاً

143
00:10:46,850 --> 00:10:48,410
!لنكن صديقين

144
00:10:50,060 --> 00:10:55,140
"ينبغي أن تُترجَم هذه إلى "منذ البَدء
"وليس "من البِدء

145
00:10:56,090 --> 00:10:59,130
إنّه خطأ شائع، لذا انتبه

146
00:10:59,450 --> 00:11:01,590
هل يمكنك إكمال الباقي لوحدك؟

147
00:11:01,810 --> 00:11:06,470
أجل! شرحك للأمور واضح
يا مُعلّم ميكايليس

148
00:11:07,100 --> 00:11:08,660
شكراً جزيلاً لك

149
00:11:09,020 --> 00:11:11,060
تصبح على خير يا مُعلّم

150
00:11:11,480 --> 00:11:13,630
تصبح على خير

151
00:11:17,640 --> 00:11:22,870
.مُعلّم ميكايليس، هناك درسٌ لا أفهمه
هلّا ساعدتني فيه؟

152
00:11:23,800 --> 00:11:24,770
تفضّل

153
00:11:28,890 --> 00:11:34,000
تبدو شعبيّتك واسعة يا مُعلّم ميكايليس

154
00:11:34,210 --> 00:11:40,160
أجل. الجميع يمدحونني كمعلّم لطيف
ذي شرح واضح ومفهوم

155
00:11:42,050 --> 00:11:47,000
ليتني أخبرهم عن طبيعة نهجك التّدريسيّ الحقيقيّ

156
00:11:48,330 --> 00:11:51,860
دُعيتُ إلى اجتماع "م-4" غداً
على السّاعة الرّابعة

157
00:11:52,540 --> 00:11:54,090
أعني ذلك

158
00:11:56,210 --> 00:11:58,020
هذه الفُرصة لن تسنح ثانية

159
00:11:58,640 --> 00:12:02,820
علينا أن نحرص على أن يُعجَب بي
الـ"م-4" وحاشيّتهم

160
00:12:04,410 --> 00:12:07,330
أعتقد بأنّ أوّل خطوة من العمل هي
تحضير تحلية مع الشّاي

161
00:12:07,550 --> 00:12:09,180
بالفعل يا مولايّ

162
00:12:09,500 --> 00:12:12,810
لِمَ ينبغي لي أن أقدّم الشّاي لأطفال؟

163
00:12:13,210 --> 00:12:15,330
ثمن بسيط يُدفَع، ألا تعتقد ذلك؟

164
00:12:15,680 --> 00:12:18,460
ليس عليك حتّى أن تقدّم لهم
رشوة على شكل حلويّات

165
00:12:18,460 --> 00:12:21,770
يمكنك أن تكسب ودّهم بحلويّات حقيقيّة

166
00:12:23,530 --> 00:12:29,600
لكن يؤسفني أنّني سأكون مشرفاً
على لاعبي الكريكيت على الرّابعة غداً

167
00:12:33,180 --> 00:12:37,560
.هذه ليست دعوة لنِزال بالأيدي
يمكنني تولّي الأمر بنفسي

168
00:12:37,560 --> 00:12:39,070
...لكن بالمقابل

169
00:12:40,100 --> 00:12:42,460
:هذا أمرٌ يا سيباستيان

170
00:12:42,460 --> 00:12:45,740
حضّر لي تحلية مع الشّاي تُدهش المثاليّين

171
00:12:47,300 --> 00:12:49,690
أمرك، مولايّ

172
00:12:51,620 --> 00:12:55,350
مُعلّم ميكايليس، هلّا طلبتُ
مساعدتك في درس؟

173
00:12:56,150 --> 00:12:57,110
تفضّل

174
00:12:58,170 --> 00:13:01,500
شكراً على تدريسي

175
00:13:01,500 --> 00:13:02,600
العفو

176
00:13:03,660 --> 00:13:06,590
...حسناً إذاً يا مُعلّم ميكايليس

177
00:13:07,050 --> 00:13:09,180
...فانتومهايف

178
00:13:09,890 --> 00:13:11,390
تصبح على خير

179
00:13:17,770 --> 00:13:21,450
!تأخّرت ساعتين! ما معنى هذا يا فانتومهايف؟

180
00:13:21,450 --> 00:13:25,030
...ماذا؟! قيل لي على السّاعة الرّابعة

181
00:13:25,030 --> 00:13:30,990
ماذا؟ لكن أنا متأكّدٌ بأنّني قلتُ
السّاعة الثّانية

182
00:13:31,720 --> 00:13:34,450
هذه حيلة منه إذاً

183
00:13:35,150 --> 00:13:38,740
من غير اللّائق أن تختلق الأعذار
!في وقتٍ كهذا يا شييل

184
00:13:38,740 --> 00:13:39,990
إدوارد؟

185
00:13:40,330 --> 00:13:44,890
عرفتُ بأنّه التحقَ بويستون، لكن
لم أعلم بأنّه كادح لمثاليّ

186
00:13:45,470 --> 00:13:49,540
كنتُ أحمق لأنّني آمنتُ بك

187
00:13:50,460 --> 00:13:55,990
لم تخن توقّعاتي فحسب، بل توقّعات سينباي أيضاً

188
00:13:56,390 --> 00:13:57,690
!اخرج من هنا

189
00:14:00,730 --> 00:14:02,930
!اللّعنة! لقد خدعني

190
00:14:02,930 --> 00:14:05,530
!لهذا أكره تصديق النّاس

191
00:14:08,280 --> 00:14:10,180
مهلاً يا مولايّ الصّغير

192
00:14:10,180 --> 00:14:13,880
يبدو أنّك استهنتَ بخصمك لأنّه تلميذ

193
00:14:14,860 --> 00:14:17,640
النّاس يحسدون البارعين دوماً

194
00:14:18,330 --> 00:14:21,540
ليس وكأنّك لم تواجه موقفاً مشابهاً من قبل

195
00:14:23,770 --> 00:14:26,460
هل ستشرح الأمور لابن عمّك إدوارد؟

196
00:14:26,460 --> 00:14:29,760
لا جدوى من بذل جهد مع أشكاله

197
00:14:30,690 --> 00:14:33,390
عن قصد أو عن غير قصد، تخلّفتُ عن الموعد

198
00:14:33,610 --> 00:14:37,100
إذاً ستدع الأمر يمرّ هكذا؟

199
00:14:37,100 --> 00:14:38,250
بالطّبع لا

200
00:14:39,560 --> 00:14:43,520
سأكسب ودّ المثاليّين

201
00:14:43,520 --> 00:14:46,480
وسأردّ اعتباري من كول أيضاً

202
00:14:48,240 --> 00:14:55,610
سأدعك تندم على هدر جهودي
يا موريس كول

203
00:14:58,170 --> 00:15:04,650
أنا واثق بأنّ الكذب هو عادة
دائمة بالنّسبة لموريس كول

204
00:15:04,650 --> 00:15:07,180
لماذا تعتقد ذلك؟

205
00:15:07,180 --> 00:15:08,920
هل رأيت يديه؟

206
00:15:09,150 --> 00:15:09,930
يداه؟

207
00:15:10,450 --> 00:15:16,320
أيدي الكادحين تكون خشنة دوماً
بسبب ما يفعلونه لأجل السّينباي

208
00:15:16,320 --> 00:15:19,940
لكن يديه ناعمتان كالزُجاج

209
00:15:19,940 --> 00:15:20,980
...ما يعني

210
00:15:20,980 --> 00:15:24,270
بأنّه يستخدم طرُقاً ملتوية مثلك؟

211
00:15:24,810 --> 00:15:27,190
"لم يكن هناك داعٍ لقول "مثلك

212
00:15:27,510 --> 00:15:32,910
رغم ذلك، انطلاقاً من عدم تردّده
،وقابليّة تصديق الكذبة

213
00:15:34,070 --> 00:15:35,830
هذا صحيح تماماً

214
00:15:36,180 --> 00:15:40,660
الطّيور المتشابهة تميّز بعضها
الآخر بشكل فطريّ حسبما أرى

215
00:15:42,120 --> 00:15:46,500
،بوسعنا بسهولة إثبات الخطأ في رسالته

216
00:15:46,500 --> 00:15:48,360
لكن لن أدعه يفلت بعقاب خفيف

217
00:15:49,190 --> 00:15:53,840
سيباستيان، اذهب وابحث عن آخرين
قد خدعهم بهذه الطّريقة

218
00:15:53,840 --> 00:15:58,580
وتحرَّ حول طبيعة نشاطاته

219
00:15:59,520 --> 00:16:00,890
عُلِم

220
00:16:04,670 --> 00:16:08,660
!"هل سمعتم؟ تخلّف عن موعد مع "م-4

221
00:16:07,590 --> 00:16:08,660
!هذا مُحال

222
00:16:08,660 --> 00:16:10,820
أنا مندهش من عدم حدوث عواقب

223
00:16:11,300 --> 00:16:16,410
من الواضح أنّ المثاليّين لديهم
نفوذ أكبر ممّا توقّعت

224
00:16:16,890 --> 00:16:21,010
سيكون من الصّعب الحصول على شاهد
كي يشهد لصالحي

225
00:16:26,090 --> 00:16:27,520
!كول سينباي

226
00:16:27,920 --> 00:16:30,880
جهّزنا ذلك

227
00:16:30,880 --> 00:16:34,340
شكراً! هذا نافع جدّاً

228
00:16:34,790 --> 00:16:39,040
كادِحو المثاليّين لديهم أعمال كثيرة يؤدّونها

229
00:16:39,040 --> 00:16:41,030
لكن أبقيا هذا سرّاً بيننا

230
00:16:41,030 --> 00:16:42,320
!نعلم

231
00:16:42,320 --> 00:16:45,310
!يسرّنا تقديم المساعدة

232
00:16:45,560 --> 00:16:48,580
يجب أن أختار كادحاً لي قريباً

233
00:16:48,580 --> 00:16:51,010
فتى ماهراً مثلكما

234
00:16:52,010 --> 00:16:53,490
!إلى اللِّقاء

235
00:16:56,190 --> 00:16:57,120
!سأكون أنا

236
00:16:57,120 --> 00:16:58,170
!لا، أنا

237
00:16:58,170 --> 00:16:59,690
!شعرك مريع

238
00:16:59,690 --> 00:17:00,830
!شعرك ناعم زيادة عن اللّزوم

239
00:17:03,950 --> 00:17:04,870
المعذرة

240
00:17:05,610 --> 00:17:09,900
ريدموند سينباي، جمعتُ البيانات الّتي طلبتها

241
00:17:10,740 --> 00:17:12,210
كان ذلك سريعاً

242
00:17:13,190 --> 00:17:16,480
عملك مُنظّم كالعادة. أشكرك

243
00:17:16,480 --> 00:17:17,760
لا شكر على واجب

244
00:17:17,760 --> 00:17:22,680
بالمناسبة! هل لديك أي طلبات
بخصوص شاي اليوم؟

245
00:17:22,990 --> 00:17:24,640
...دعني أرى

246
00:17:24,950 --> 00:17:28,730
مضى وقت طويل منذ تناولتُ مارتل سوفليه
بالفاكهة المُحلّاة مع اللّيمون خاصّتك

247
00:17:28,730 --> 00:17:30,290
أريد منها

248
00:17:30,690 --> 00:17:32,170
!عُلِم

249
00:17:48,830 --> 00:17:50,670
شكراً لك كالعادة

250
00:17:51,360 --> 00:17:54,550
تلميذ في مبيت يستأجر حرّاساً؟

251
00:17:54,550 --> 00:17:56,940
هل نحن في قصر باكنغهام؟

252
00:17:57,950 --> 00:18:02,550
مارتل سوفليه بالفاكهة المُحلّاة مع ليمون
كما طلبت يا ريدموند سينباي

253
00:18:03,430 --> 00:18:06,160
وحضّرتُ معها شاي أوفا

254
00:18:06,650 --> 00:18:08,390
إنّه لذيذ مع الحليب

255
00:18:08,390 --> 00:18:12,970
لا أصدِّق بأنّك تعدّ أطعمة معقّدة
كهذه في كلّ يوم

256
00:18:13,610 --> 00:18:17,960
ريدموند سينباي يستحقّ أشهى المأكولات

257
00:18:18,820 --> 00:18:21,300
هل تريد بعضاً يا غريغوري سينباي؟

258
00:18:27,390 --> 00:18:29,960
!إصابة ممتازة يا سينباي

259
00:18:46,330 --> 00:18:49,720
أرى بأنّك تقرأ كتُباً معقّدة دوماً

260
00:18:49,720 --> 00:18:51,180
في أيّ سنة أنت؟

261
00:18:54,390 --> 00:18:57,320
سـ-سنة ثانية. اسمي هاركورت

262
00:18:57,320 --> 00:18:59,820
في السّنة الثانية فقط؟ أنا مندهش

263
00:19:00,090 --> 00:19:04,090
من النّادر أن يقرأ شخصٌ في سنّك
لهيغيل بالألمانيّة الأصليّة

264
00:19:04,450 --> 00:19:06,750
لا بدّ أنّ لديك شعبيّة

265
00:19:07,680 --> 00:19:10,500
...لـ-ليس تماماً

266
00:19:10,710 --> 00:19:14,930
...لا أفعل شيئاً سوى المُطالعة

267
00:19:14,930 --> 00:19:18,780
تبدو مضطرباً أيّها الفتى العزيز

268
00:19:20,980 --> 00:19:23,990
إذا أردت التكلّم حول الأمر، فكلّي آذان صاغية

269
00:19:26,290 --> 00:19:34,540
قال كول سينباي بأنّه قدّم لي دعوة إلى مقصورة
حديقة البجعة، لكن لم أتلقّ شيئاً

270
00:19:34,940 --> 00:19:39,690
لكن بعدها فجأة، وبشكلٍ ما، وجدتُ
...دعوةً على مقعدي

271
00:19:40,020 --> 00:19:43,410
!أقسم بأنّني لم أكذب

272
00:19:43,980 --> 00:19:47,120
لكن الجميع ينعتونني بالكاذب الآن

273
00:19:48,550 --> 00:19:54,600
لا بدّ أنّه كان من المؤلم جدّاً بالنّسبة
لك ألّا يصدّقك أحد

274
00:19:55,690 --> 00:20:00,470
لكن لا أعتقد بأنّك كاذب

275
00:20:00,470 --> 00:20:01,710
!مُعلّم

276
00:20:03,000 --> 00:20:04,240
صلِّ يا بُنيّ

277
00:20:04,930 --> 00:20:08,420
سيُوضَّح هذا الالتِباس يوماً ما

278
00:20:10,190 --> 00:20:16,060
وجدتُ أربعة تلاميذ آخرين وقعوا
ضحيّةً لموريس كول

279
00:20:16,060 --> 00:20:17,620
كنتُ على حقّ

280
00:20:17,620 --> 00:20:24,910
ليس ذلك فحسب، غالباً لديه آخرون
ينفّذون مُعظم واجباته ككادح

281
00:20:24,910 --> 00:20:30,250
على سبيل المثال، سوفليه بالفاكهة المُحلّاة
تتطلّب ساعات لتبريدها

282
00:20:31,020 --> 00:20:34,460
سيكون من المستحيل تحضيرها
ضمن يوم من دوام الكادح

283
00:20:34,910 --> 00:20:37,890
،أرغب في معرفة تحرّكاته داخل البيت الأحمر

284
00:20:38,330 --> 00:20:41,980
لكن أنت منشغل سلفاً بأعمالي
...أثناء دوام الكادحين

285
00:20:42,610 --> 00:20:46,970
أريد بيدقاً آخر أضعه في منزله

286
00:20:46,970 --> 00:20:49,390
...كان بيت ديريك الأصليّ في نهاية المطاف

287
00:20:49,390 --> 00:20:54,680
رغم ذلك، لا أدري ما إن كان من الحكمة
تدبير شاغر آخر لتلميذ جديد

288
00:20:55,030 --> 00:20:57,360
فهذا سرعان ما سيلفت الأنظار

289
00:20:57,360 --> 00:21:02,850
،وحتّى لو نسّقنا الأمور لقبول تلميذ
لن يستطيع اختيار مبيته

290
00:21:03,370 --> 00:21:07,930
المكانة الاجتماعيّة والشّخصية كلاهما
يؤثّران على التّوزيع في أبنية المبيت

291
00:21:09,930 --> 00:21:11,080
أعلم

292
00:21:11,440 --> 00:21:14,660
الثّعلب القرمزيّ هو للأشخاص ذوي
المكانة الاجتماعيّة الرّفيعة

293
00:21:14,660 --> 00:21:18,040
نحتاج شخصاً بمكانة وثروة كافيتين
لنضمن تواجده هناك

294
00:21:18,310 --> 00:21:23,320
مَن يمتلك ذلك ويتلقّى قبولاً خاصّاً
من دون وجود شاغر؟

295
00:21:25,260 --> 00:21:30,410
خطر على ذهني شخص للتو، لكنّه
حرفيّاً آخر شخص أتمنّاه

296
00:21:30,850 --> 00:21:37,400
.لكنّه يستوفي كلّ المعايير
وهو شخص مُميّز جدّاً

297
00:21:43,610 --> 00:21:46,700
اللّعنة! الظّروف ترغمني عليه

298
00:21:54,920 --> 00:21:59,640
!هذه هي "المدرسة" إذاً
!يا لها من ضخمة

299
00:22:00,340 --> 00:22:02,640
!تقريباً بحجم منزلي في الدّيار