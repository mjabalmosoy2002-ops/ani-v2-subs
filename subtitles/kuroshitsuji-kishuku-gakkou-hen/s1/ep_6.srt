1
00:00:04,170 --> 00:00:05,940
استيقظ يا وجه الخلد

2
00:00:05,940 --> 00:00:10,740
لا يُسمَح لتواجد المثاليّين في السّاحة
!بهدف أخذ قيلولة

3
00:00:10,740 --> 00:00:13,360
لا تكُن نكِداً هكذا يا ديديريهي

4
00:00:14,340 --> 00:00:16,860
واسمي ليس "وجه الخلد" أيضاً

5
00:00:17,810 --> 00:00:20,240
اسمي فينسينت فانتومهايف

6
00:00:20,240 --> 00:00:24,080
لا تنادِني باسمي الأوّل. هذا مُنافٍ للقواعد

7
00:00:24,300 --> 00:00:29,320
أنتم الألمانيّون جافّون مثل لحيتكم

8
00:00:29,320 --> 00:00:31,090
!أيّها الوغد

9
00:00:31,450 --> 00:00:33,410
!لن أتحمّل قلّة الاحترام هذه

10
00:00:33,410 --> 00:00:34,470
—انتظر

11
00:00:38,860 --> 00:00:41,560
يا لها من مُؤشِّرة كِتاب لديك هنا

12
00:00:43,520 --> 00:00:46,140
لماذا تهرّبتَ من أعمال التّحضير؟

13
00:00:43,520 --> 00:00:46,140
إنّهم م-4

14
00:00:46,140 --> 00:00:47,530
ذلكما الاثنان يفعلانها من جديد؟

15
00:00:46,140 --> 00:00:48,210
هل كانت اليوم؟

16
00:00:49,230 --> 00:00:50,440
!لا تدّعِ الجهل

17
00:00:50,440 --> 00:00:51,650
آسف، آسف

18
00:00:51,650 --> 00:00:55,070
!ترتّب عليّ فعل كلّ شيء بنفسي بسببك

19
00:00:55,070 --> 00:01:00,240
أدّيتَ عملي؟ يا لك من شخص رائع

20
00:01:00,240 --> 00:01:04,440
أقسم بأنّني لن أفهم أبداً كيف
جُعِل عُيّنَ شخص مثلك مثاليّاً

21
00:01:04,440 --> 00:01:06,210
أتساءل حول ذلك بنفسي

22
00:01:06,210 --> 00:01:10,170
ألوم بقيّة البيت الأزرق لأنّهم
قبِلوا بك كمثاليّ

23
00:01:15,990 --> 00:01:18,600
،يمكنك أن تقول ما تشاء عنّي

24
00:01:19,080 --> 00:01:22,850
لكن حبّذا ألّا توجّه إهانة لبقيّة البيت الأزرق

25
00:01:23,430 --> 00:01:26,020
القائد يمثّل سربَه العسكريّ

26
00:01:26,450 --> 00:01:30,440
أي شخص يتلقّى الأوامر منك
ليس أفضل منك

27
00:01:34,310 --> 00:01:37,110
ما رأيك بوضع رِهان صغير على ذلك؟

28
00:01:37,110 --> 00:01:38,320
ماذا؟

29
00:01:38,540 --> 00:01:42,790
لنرَ أي بيت سيربح في بطولة
الكريكيت في الرّابع من يونيو

30
00:01:43,010 --> 00:01:48,040
يحظى الرّابح بحقّ توجيه أمر واحد
يجب على الخاسر ألّا يرفضه

31
00:01:48,910 --> 00:01:50,110
فما رأيك؟

32
00:03:22,940 --> 00:03:24,220
موافق

33
00:03:24,450 --> 00:03:25,660
—سينباي

34
00:03:25,660 --> 00:03:29,430
مُحال أن يخسر البيت الأخضر أمام
متذيّلين دائمين للتّرتيب

35
00:03:29,720 --> 00:03:33,400
عندما أربح، عليك أن تتنحّى عن كونك مثاليّاً

36
00:03:33,400 --> 00:03:37,110
أهذا كلّ ما تريده؟ كم أنت سريع الرِّضا

37
00:03:37,110 --> 00:03:40,150
حسناً، سأفكّر في شيء لأجلك كي تفعله

38
00:03:43,460 --> 00:03:45,370
حريّ بك أن تلتزم بكلمتك

39
00:03:45,700 --> 00:03:47,010
وأنت كذلك

40
00:03:52,900 --> 00:03:53,900
...مستحيل

41
00:03:54,430 --> 00:03:55,750
...كيف لي أن

42
00:03:56,230 --> 00:03:57,850
...كيف للبيت الأخضر

43
00:03:58,460 --> 00:04:01,420
!أن يخسر أمام البيت الأزرق؟

44
00:04:01,420 --> 00:04:06,300
!فعلناها! النّصر الأوّل للبيت الأزرق

45
00:04:09,960 --> 00:04:11,680
فانتومهايف

46
00:04:14,650 --> 00:04:19,110
عرفت اسمي أخيراً إذاً يا ديديريهي؟

47
00:04:19,380 --> 00:04:24,030
خسرت. سأتلقّى أمراً واحداً منك كما وعدت

48
00:04:24,270 --> 00:04:26,250
أجل. أتذكّر مناقشة ذلك

49
00:04:26,580 --> 00:04:28,140
أمر واحد فقط إذاً

50
00:04:29,860 --> 00:04:31,820
كُن كادحي

51
00:04:35,230 --> 00:04:35,990
عفواً؟

52
00:04:36,390 --> 00:04:38,480
ما-ما الّذي تنوي له؟

53
00:04:38,480 --> 00:04:42,170
!أنا في البيت الأخضر. وأنا مثاليّ

54
00:04:42,170 --> 00:04:46,040
التّقاليد مهمّة، لكن كذلك الوعود

55
00:04:46,040 --> 00:04:47,640
ربحت، أليس كذلك؟

56
00:04:48,390 --> 00:04:53,520
،من الآن فصاعداً، سوف تأتي عندما أناديك
أينما كنّا. دون رفض

57
00:04:53,520 --> 00:04:56,710
هـ-هل تعلم كم شهراً بقي حتّى التخرُّج؟

58
00:04:56,710 --> 00:05:00,780
ينبغي أن تسمعني جيّداً. من قال
بأنّ الأمر سيتوقّف عند التخرُّج؟

59
00:05:02,070 --> 00:05:03,420
ماذا تقصد؟

60
00:05:03,940 --> 00:05:07,450
!عُد إلى هنا! لم تنتهِ هذه المحادثة

61
00:05:07,450 --> 00:05:09,910
!انتهتْ من ناحيتي

62
00:05:09,910 --> 00:05:13,120
!فانتومهايف، أيّها الماكر

63
00:05:14,740 --> 00:05:16,700
انتهى بحثي

64
00:05:17,340 --> 00:05:23,030
لطالما أردتُ كلباً ألمانياً وفيّاً

65
00:05:24,300 --> 00:05:26,460
!عد إلى هنا

66
00:05:26,460 --> 00:05:28,740
!العلاقة الجليديّة بينهما تذوب أخيراً

67
00:05:26,950 --> 00:05:28,720
لماذا تضحك؟

68
00:05:28,030 --> 00:05:29,970
!أنت تفسد صورتك

69
00:05:28,720 --> 00:05:30,710
!عُد إلى هنا أيّها النّمس

70
00:05:33,020 --> 00:05:35,980
كـ-كان أبي في البيت الأزرق؟

71
00:05:35,980 --> 00:05:39,360
كان أبوك وراء المُعجزة الياقوتيّة؟
كم هذا مُدهش

72
00:05:39,360 --> 00:05:43,570
هكذا إذاً، لم يخبرك أحدٌ بذلك بعد؟

73
00:05:43,570 --> 00:05:46,440
كنتَ كادحاً يا أبي؟

74
00:05:47,060 --> 00:05:50,160
كنتَ أصغر من العمّ فينسينت؟

75
00:05:50,160 --> 00:05:53,410
كانت مُباراة رائعة حقّاً

76
00:05:53,410 --> 00:05:55,870
يؤسفني أنّ فريقنا هُزِم هزيمة نكراء

77
00:05:57,830 --> 00:06:04,050
.ورثتَ دماء عبقريّ في الكريكيت
ابذل قصارى جهدك

78
00:06:04,050 --> 00:06:07,160
سيّداتي سادتي، لقد حانت اللّحظة

79
00:06:07,510 --> 00:06:10,720
سأعلن الآن عن المواجهات

80
00:06:11,430 --> 00:06:13,220
المُعجزة الياقوتيّة"؟"

81
00:06:13,490 --> 00:06:14,830
كلام فارغ

82
00:06:15,770 --> 00:06:17,860
لا أؤمن بالمُعجزات

83
00:06:20,900 --> 00:06:23,960
لهذا سوف أحقّق هذا النّصر بالقوّة

84
00:06:25,860 --> 00:06:30,530
المُباراة الأولى من بطولة الكريكيت
الدّاخليّة على وشك أن تبدأ

85
00:06:30,550 --> 00:06:35,620
!بيت بومة الياقوت ضدّ الثّعلب القرمزيّ

86
00:06:35,620 --> 00:06:40,460
كم حظّك سيّئ حتّى تواجه البيت
الأحمر منذ البداية يا لورينس

87
00:06:42,130 --> 00:06:45,130
قد أخسر في الشّطرنج، لكن ليس في الكريكيت

88
00:06:45,130 --> 00:06:46,900
سوف نرى

89
00:06:48,720 --> 00:06:51,680
!البيت الأحمر في الرّمي. العب

90
00:06:51,680 --> 00:06:52,860
!ها أنا ذا

91
00:06:55,180 --> 00:06:56,100
!سريعة للغاية

92
00:06:57,890 --> 00:06:58,560
!خروج

93
00:06:58,560 --> 00:07:00,740
!فوّتَ الرّمية الأولى؟

94
00:07:00,740 --> 00:07:03,020
أعتقد أنّ الرياضة ليست موطِن قوّتنا فعلاً

95
00:07:04,980 --> 00:07:09,950
من الواضح أنّ كلّ ذلك الكلام حول
مهارته في الكريكيت كان دقيقاً

96
00:07:09,950 --> 00:07:11,910
!إليّ بها يا كادار

97
00:07:13,570 --> 00:07:14,530
!عالية ضعيفة

98
00:07:15,370 --> 00:07:16,580
نال منّي

99
00:07:20,050 --> 00:07:21,230
رحلة لطيفة

100
00:07:22,460 --> 00:07:24,360
!فخامتك إدغار

101
00:07:24,360 --> 00:07:25,590
!أنت غاية في الرّوعة

102
00:07:25,590 --> 00:07:26,670
!ران آوت

103
00:07:26,670 --> 00:07:28,170
يا إلهي

104
00:07:28,170 --> 00:07:30,480
لا يملكون فُرصة

105
00:07:30,480 --> 00:07:33,640
هل هذا يعني بأنّنا خسرنا من الآن؟

106
00:07:33,640 --> 00:07:37,470
البيت الأزرق ضُعفاء، أجل

107
00:07:37,470 --> 00:07:39,100
!أنتِ قاسية يا آنسة خادمة

108
00:07:39,310 --> 00:07:42,900
!معه حقّ. يجب علينا تشجيعهم

109
00:07:42,900 --> 00:07:45,810
!يمكنك فعلها يا شييل

110
00:07:45,810 --> 00:07:48,780
!معكِ حقّ. هيّا يا مولايّ الصّغير

111
00:07:48,780 --> 00:07:50,460
!نحن هنا لأجلك، أجل

112
00:07:50,460 --> 00:07:52,860
لم يخرج إلى هناك بعد حتّى

113
00:07:55,870 --> 00:08:00,200
!عجباً لهم. يا لها من مجموعة رخيّة البال

114
00:08:00,200 --> 00:08:01,680
البُويّب العاشر

115
00:08:01,680 --> 00:08:04,370
ماذا؟ دورنا في الرّمي من الآن؟

116
00:08:05,880 --> 00:08:07,460
!أمسكها يا كلايتون

117
00:08:07,460 --> 00:08:08,770
—دع الأمر لـ

118
00:08:09,090 --> 00:08:10,670
!كلايتون

119
00:08:12,880 --> 00:08:13,950
!ثلاث نقاط

120
00:08:13,950 --> 00:08:15,100
تبّاً

121
00:08:15,100 --> 00:08:16,350
أعتقد أنّه دوري الآن

122
00:08:17,230 --> 00:08:18,660
جاهز في أي وقت

123
00:08:19,770 --> 00:08:22,480
إنّه أنت إذاً يا ريدموند

124
00:08:22,720 --> 00:08:24,740
!ابقَ مُركِّزاً يا كووارد

125
00:08:24,740 --> 00:08:25,480
!حاضر

126
00:08:31,780 --> 00:08:33,740
كُرة بطيئة؟

127
00:08:33,740 --> 00:08:35,950
لحظة— هذه كُرة تكتيكيّة

128
00:08:36,670 --> 00:08:40,050
تعمّدَ رمي كُرة بطيئة وذلك كي لا تبتعد
عن مِضرَبي مسافة طويلة

129
00:08:40,410 --> 00:08:44,000
لكن سرعة الكُرة لا يعنيني شيئاً

130
00:08:44,310 --> 00:08:47,890
!ارقصي يا ورودي الحمراء وكوني زوبعة

131
00:08:48,300 --> 00:08:49,920
!الزّوبعة القرمزيّة

132
00:08:56,170 --> 00:08:58,050
!ستّ نقاط

133
00:08:58,050 --> 00:09:01,010
!عمّك العزيز يفتخر بك

134
00:09:01,370 --> 00:09:04,830
إذاً استخدم القوّة المركزيّة الطّاردة
من دورانه لتعزيز قوّة الضّربة

135
00:09:05,640 --> 00:09:06,980
مُبهر

136
00:09:07,770 --> 00:09:10,870
والآن أرِني أفضل رمية لك

137
00:09:10,870 --> 00:09:13,260
هذه المُباراة بالكاد قد بدأت

138
00:09:15,350 --> 00:09:19,750
يا لها من مُباراة من طرف واحد

139
00:09:20,520 --> 00:09:24,330
لكن ما زال لديك تِلك البطاقة لتلعب بها

140
00:09:25,050 --> 00:09:27,550
أليس كذلك يا مولايّ؟

141
00:09:28,170 --> 00:09:29,960
أنت، هناك

142
00:09:30,380 --> 00:09:31,730
!أعطِني بطاقة حمراء

143
00:09:31,730 --> 00:09:33,960
يا لك من مستثمر يلعب على مبدأ الأمان

144
00:09:32,890 --> 00:09:33,960
!حمراء لي أيضاً

145
00:09:33,960 --> 00:09:36,760
في الحال

146
00:09:34,370 --> 00:09:36,760
!وواحدة لي كذلك

147
00:09:34,870 --> 00:09:38,660
أرى بأنّه لم يتغيّر أبداً أيضاً

148
00:09:44,660 --> 00:09:47,060
ينبغي أن أرمي في الشّوط الثّاني

149
00:09:47,060 --> 00:09:51,090
انتظر لحظة. ظننتُ بأنّنا اتّفقنا على ادّخار
هذا التّكتيك حتّى المباراة الأخيرة

150
00:09:51,090 --> 00:09:54,500
لن نصل إلى المباراة النّهائيّة
إذا خسرنا في هذه المُباراة

151
00:09:54,500 --> 00:09:56,150
توافقني، أليس كذلك يا مُدرّب؟

152
00:09:56,890 --> 00:09:57,990
مُدرّب؟

153
00:09:58,660 --> 00:10:00,830
إلى أين ذهب المُعلّم ميكايليس؟

154
00:10:00,830 --> 00:10:02,910
غالباً في دورة المياه

155
00:10:02,910 --> 00:10:04,370
!في وقت كهذا؟

156
00:10:04,370 --> 00:10:08,480
على أيّ حال، لا ينبغي أن نغيّر استراتيجيّتنا
من دون موافقة المُدرّب

157
00:10:08,480 --> 00:10:09,660
...لكن

158
00:10:10,310 --> 00:10:14,840
سأكون الضّارب التّالي. هل يمكنني
أن أطلب منك ترك الأمر لي؟

159
00:10:15,620 --> 00:10:17,470
لديك خطّة؟

160
00:10:17,470 --> 00:10:21,380
أجل. أعِدُك بتمهيد الطّريق نحو العودة

161
00:10:22,440 --> 00:10:24,890
سيكون هذا فوزاً سهلاً لنا

162
00:10:24,890 --> 00:10:27,050
توقّعتُ هذا منذ البداية

163
00:10:27,050 --> 00:10:29,880
—كفى ثرثرة وجهّزا هذه كي

164
00:10:29,880 --> 00:10:32,620
ماذا؟ أين اختفت فطيرة اللّحم تلك؟

165
00:10:32,990 --> 00:10:34,570
ربّما أخذها شخص ما؟

166
00:10:34,570 --> 00:10:36,590
لا، لا أعتقد ذلك

167
00:10:36,590 --> 00:10:38,280
أليست هي هذه؟

168
00:10:38,280 --> 00:10:41,060
!من السّافل الّذي نقلها إلى هناك؟

169
00:10:41,060 --> 00:10:42,990
لا يهمّ. لنبدأ بالخدمة فحسب

170
00:10:43,200 --> 00:10:47,160
لا يُقاومون البتّة، تبدو هذه
المُباراة وكأنّها نزهة

171
00:10:47,160 --> 00:10:48,420
أتّفق معك تماماً

172
00:10:49,100 --> 00:10:51,790
!رِفاق، ها نحن

173
00:10:51,790 --> 00:10:54,200
!يبدو هذا لذيذاً

174
00:10:54,200 --> 00:10:57,810
لكن هل يوجد لحم عجل في الدّاخل؟
لا آكل لحم العجل

175
00:10:57,810 --> 00:11:00,010
لا، يبدو كدجاج

176
00:11:00,010 --> 00:11:04,210
رجل لطيف! في هذه الحالة، أعطِني
!الشّريحة الكبرى

177
00:11:04,540 --> 00:11:06,790
...ماذا؟ لا أتذكّر بأنّه لحم دجاج

178
00:11:08,070 --> 00:11:10,640
حضرة المُدرِّب! أين كنت؟

179
00:11:10,640 --> 00:11:13,310
أعتذر. إنّه نداء الطّبيعة

180
00:11:13,530 --> 00:11:17,450
تأخّرتَ كثيراً! شارفت الاستراحة على الانتهاء

181
00:11:19,490 --> 00:11:22,700
لنبذل قصارى جهدنا في هذا يا فانتومهايف

182
00:11:23,450 --> 00:11:26,450
بالتّأكيد يا هاركورت سينباي

183
00:11:26,450 --> 00:11:30,390
!يا لها من مواجهة ظريفة

184
00:11:30,390 --> 00:11:35,070
مع أنّ ذاك الفتى ذا رقعة العين
...يبدو مألوفاً لسببٍ ما

185
00:11:39,240 --> 00:11:40,340
رمية دورانيّة؟

186
00:11:41,870 --> 00:11:43,660
كانت رمية جيّدة

187
00:11:43,660 --> 00:11:45,600
هذا لأنّه كادحي

188
00:11:49,430 --> 00:11:51,430
!إنّه يتمكّن من الدّفاع فقط

189
00:11:51,850 --> 00:11:55,730
لا، لحظة. عيناه تقولان بأنّه لم يستسلم بعد

190
00:11:57,190 --> 00:11:58,900
أنت تتحسّن

191
00:11:58,900 --> 00:12:00,830
احسم الأمر برميتك التّالية يا هاركورت

192
00:12:02,420 --> 00:12:04,820
أنا آسف يا فانتومهايف

193
00:12:05,630 --> 00:12:09,200
!هذه هي النّهاية

194
00:12:17,240 --> 00:12:18,910
!ما المشكلة يا هاركورت؟

195
00:12:20,500 --> 00:12:22,840
ماذا؟ ما الّذي يحدث؟

196
00:12:25,980 --> 00:12:28,010
...مـ-معدتي

197
00:12:35,940 --> 00:12:38,130
...في ذلك الوقت

198
00:12:46,590 --> 00:12:49,330
سيكون هذا فوزاً سهلاً لنا

199
00:12:49,330 --> 00:12:51,700
توقّعتُ هذا منذ البداية

200
00:12:51,700 --> 00:12:54,410
—كفى ثرثرة وجهّزا هذه كي

201
00:12:54,770 --> 00:12:57,390
ماذا؟ أين اختفت فطيرة اللّحم تلك؟

202
00:12:58,590 --> 00:13:01,820
إنّ ضرب الكُرات بالمِضرب ليس الطّريقة
الوحيدة لقلب الموازين

203
00:13:03,100 --> 00:13:07,890
أخبراني، هل استمتعتُما بلحمنا وفطيرتنا المُليّنة؟

204
00:13:07,890 --> 00:13:11,470
يجب ألّا أخزي نفسي في الميدان

205
00:13:11,470 --> 00:13:13,310
!انسحبوا! انسحبوا جميعاً

206
00:13:13,310 --> 00:13:15,850
!لحظة! بقي شخص في الميدان

207
00:13:16,680 --> 00:13:19,310
...لا... إذا تحرّكتُ الآن، فأنا سوف

208
00:13:19,310 --> 00:13:21,400
—هاركورت! اصمد، أنا قادم

209
00:13:21,400 --> 00:13:24,280
!لا تستعجل! أنت مثاليّ

210
00:13:30,070 --> 00:13:33,650
!هاركورت

211
00:13:33,650 --> 00:13:37,520
...يا لها من مأساة! وأيضاً

212
00:13:37,520 --> 00:13:39,920
!ذاك الفتى هو نوعي المُفضّل

213
00:13:41,250 --> 00:13:48,410
أحم. بما أنّ بيت الثّعلب القرمزيّ عاجز
عن المتابعة، سنعتبره قد انسحب

214
00:13:48,410 --> 00:13:52,150
وبالتّالي المُباراة الأولى من نصيب
بيت بومة الياقوت

215
00:13:52,670 --> 00:13:53,630
ماذا؟

216
00:13:54,390 --> 00:13:59,290
!ماذا؟

217
00:14:05,400 --> 00:14:06,690
تاناكا؟

218
00:14:08,590 --> 00:14:11,580
المُعلّم ميكايليس دون سِواه

219
00:14:11,580 --> 00:14:14,480
في الوقت المثاليّ. تناول هذا
على الغداء لو سمحت

220
00:14:14,480 --> 00:14:18,830
شكراً لك. فطيرة لحم عجل مفروم؟

221
00:14:20,140 --> 00:14:23,400
لكن ثمّة أمر مهمّ

222
00:14:24,730 --> 00:14:28,980
هل تعِدني بأنّ هذا لن يسبّب
مُشكلة في الهضم بعد أكله؟

223
00:14:30,760 --> 00:14:32,010
بالطّبع

224
00:14:32,360 --> 00:14:36,790
!أتوقّع رؤية مُعجزة ياقوتيّة أخرى اليوم

225
00:14:39,320 --> 00:14:40,950
ممتاز يا سيّدي

226
00:14:45,940 --> 00:14:48,380
رمياتي ليست سهلة

227
00:14:48,900 --> 00:14:51,110
اشتعلي يا أصابعي اشتعلي

228
00:14:51,110 --> 00:14:54,580
!تسارع الدُّخان البنفسجيّ: الاحتراق الأرجوانيّ

229
00:14:55,990 --> 00:14:57,000
رمية ناجحة

230
00:14:58,460 --> 00:15:01,790
—حسناً يا فيوليت؟ ما رأيك بـ

231
00:15:01,790 --> 00:15:03,790
!إنّه لا يشاهدني حتّى

232
00:15:03,790 --> 00:15:06,630
رمى الكُرة مع دوران أماميّ شديد

233
00:15:06,630 --> 00:15:11,200
هذه نفس الأصابع السّحريّة الّتي تستطيع
العزف على أي آلة حالما يمسكها

234
00:15:11,200 --> 00:15:12,820
قادرة على تحقيق رمية فريدة

235
00:15:13,850 --> 00:15:18,070
رمية ناجحة من جديد! إذاً حتّى البيت الأخضر
عاجز عن فعل شيء بشأن تشيسلوك؟

236
00:15:22,190 --> 00:15:23,400
!ستّ نقاط

237
00:15:24,350 --> 00:15:25,890
!هذا هو بطلنا غرينهيل

238
00:15:25,890 --> 00:15:29,900
لهذا يسمّونه لاعب الكريكيت الأعظم
!في تاريخ ويستون

239
00:15:31,670 --> 00:15:33,660
!لا توجد كُرة لا يمكنني إصابتها

240
00:15:35,030 --> 00:15:38,910
غرينهيل لا يتوقّف! كم واحدة ينوي أن يقذف؟

241
00:15:39,620 --> 00:15:42,420
بيت الأسد الأخضر هو الفائز

242
00:15:42,420 --> 00:15:44,020
ربحنا بفارق كبير

243
00:15:44,020 --> 00:15:45,170
بالطّبع

244
00:15:46,250 --> 00:15:48,890
فيوليت! ماذا تفعل؟

245
00:15:48,890 --> 00:15:49,970
انتهيت

246
00:15:51,170 --> 00:15:52,430
لا تدُس عليها

247
00:15:53,300 --> 00:15:55,650
!هلّا كنتَ جادّاً ولو لمرّة في حياتك؟

248
00:15:53,300 --> 00:15:56,850
إذاً ستكون المُباراة الأخيرة بين
البيت الأخضر والبيت الأزرق

249
00:15:56,850 --> 00:16:01,040
.هذا يشبه عام المُعجزة الياقوتيّة
أليس هذا حماسيّاً يا عزيزتي؟

250
00:16:01,040 --> 00:16:03,310
أجل، بالفعل

251
00:16:03,650 --> 00:16:05,610
سوف نبدأ بالمُباراة الأخيرة الآن

252
00:16:05,610 --> 00:16:11,490
!بيت بومة الياقوت ضدّ بيت الأسد الأخضر

253
00:16:11,730 --> 00:16:13,910
سأبذل قصارى جهدي

254
00:16:14,200 --> 00:16:15,320
هذا شرفٌ لي

255
00:16:15,780 --> 00:16:18,620
!شييل! يمكنك فعلها

256
00:16:19,570 --> 00:16:20,870
!ليزي؟

257
00:16:20,870 --> 00:16:23,120
أنت تُحرج نفسك يا ميدفورد

258
00:16:24,350 --> 00:16:26,580
سوف أسحقك، انتظر فحسب

259
00:16:26,580 --> 00:16:28,420
لا تقسُ عليّ كثيراً

260
00:16:32,260 --> 00:16:37,720
بصِفتي المُدرّب، سأدعم الفريق
بأقصى ما عندي كذلك

261
00:16:37,960 --> 00:16:40,180
فلنبدأ جميعاً

262
00:16:40,180 --> 00:16:44,980
يستخدم الموسيقى لتشجيعهم؟
ما الّذي يفكِّر فيه المُعلّم ميكايليس؟

263
00:16:45,610 --> 00:16:50,230
لا أعتقد بأنّ البيت الأخضر متفرّغ للتمتّع
بقليل من الموسيقى

264
00:16:50,500 --> 00:16:53,950
سنبدأ مع لحن السّير الخاصّ براديتزكي

265
00:17:01,580 --> 00:17:03,540
!أ-أصابها

266
00:17:03,540 --> 00:17:05,040
!أربع نقاط من الكُرة الأولى

267
00:17:09,040 --> 00:17:10,130
!ماذا؟

268
00:17:10,130 --> 00:17:11,320
!ثلاث نقاط

269
00:17:12,070 --> 00:17:17,800
وضعيّته سيّئة، لكنّه يتمكّن من إصابة
ضربات هاينز سينباي القويّة. كيف؟

270
00:17:21,730 --> 00:17:24,560
!عيناه مغمضتان؟

271
00:17:25,220 --> 00:17:28,770
ما هذا؟ كيف يستطيع الضّرب
بعينين مغمضتين؟

272
00:17:33,490 --> 00:17:35,230
سأعبّر بوضوح

273
00:17:35,230 --> 00:17:41,120
لدينا أضعف وأسوأ اللّاعبين الرّياضيّين
،من بين كافّة الفِرق

274
00:17:41,120 --> 00:17:44,700
لذا أشكّ في أنّ أي واحد منّا يستطيع
مُجاراة ضِخام البيت الأخضر

275
00:17:44,920 --> 00:17:46,530
!انتبه لكلامك

276
00:17:47,170 --> 00:17:49,250
لهذا رسمتُ هذه الخطّة

277
00:17:50,210 --> 00:17:52,670
لن ننظر إلى الكُرة ببساطة

278
00:17:52,930 --> 00:17:57,610
لأنّ الرّامي يصوّب نحو البُويّب، لن يتغيّر
مسار الكُرة كثيراً

279
00:18:01,800 --> 00:18:04,890
لكن إذا لم ننظر للكُرة، لن نعرف
متى يمكننا التّلويح

280
00:18:05,850 --> 00:18:09,310
بلى، سنفعل. ليس علينا سوى الإصغاء

281
00:18:09,310 --> 00:18:12,570
سوف نهيّئ إشارةً عندما يحين
وقت التّلويح بالمِضرب

282
00:18:12,570 --> 00:18:15,420
حينها كلّ ما على الضّارب فعله
هو التّلويح عند الإشارة

283
00:18:16,570 --> 00:18:18,500
هل شيء كهذا مُمكن؟

284
00:18:18,500 --> 00:18:20,000
—أجل. في الواقع، قمتُ بالفعل

285
00:18:20,000 --> 00:18:20,820
لا

286
00:18:21,380 --> 00:18:23,450
هذه ليست كريكيت

287
00:18:25,790 --> 00:18:28,100
تقصد بأنّ هذا غير لائق؟

288
00:18:28,710 --> 00:18:30,300
أهكذا الأمر حقّاً؟

289
00:18:30,630 --> 00:18:34,060
نحن نضع فخر البيت الأزرق على المحكّ
في مواجهة البيوت الأخرى

290
00:18:34,710 --> 00:18:38,680
تقتضي السّلوكيّات على أن نبذل
كلّ ما بوسعنا في المعركة

291
00:18:38,680 --> 00:18:40,640
نتمتّع بالذّكاء

292
00:18:40,640 --> 00:18:45,610
ألن يكون استخدام القوّة لمواجهة البيت
الأخضر غير لائق بالمرّة

293
00:18:45,610 --> 00:18:48,500
في حين أنّ الذّكاء هو صِفتنا الحقيقيّة؟

294
00:18:48,850 --> 00:18:50,820
!البيت الأزرق ضعيف

295
00:18:50,820 --> 00:18:57,570
لذا للفوز، يجب أن نخطّط بفعاليّة ونبذل
قصارى جهدنا دون انتهاك أي قاعدة

296
00:19:00,690 --> 00:19:02,030
موافق

297
00:19:02,460 --> 00:19:04,460
ما هي "الإشارة"؟

298
00:19:23,950 --> 00:19:26,200
ما الخدعة وراء هذا؟

299
00:19:29,390 --> 00:19:30,830
فهمتُ الأمر

300
00:19:31,290 --> 00:19:32,770
لاحظت أيضاً؟

301
00:19:33,820 --> 00:19:35,110
...لقد تمرّنوا

302
00:19:36,200 --> 00:19:37,480
!بجدّ حقّاً

303
00:19:37,480 --> 00:19:40,510
!أجل. يستخدمون الموسيقى كي... ماذا؟

304
00:19:41,070 --> 00:19:44,600
إ-إنّه عديم التّشكيك بأحد

305
00:19:44,600 --> 00:19:47,580
لكن هذا يجعلني لا أحبّذ إخباره
عن حيلتهم في اللّعب

306
00:19:47,940 --> 00:19:49,410
غرينهيل سينباي

307
00:19:51,370 --> 00:19:53,830
هذا أنت إذاً يا إدوارد

308
00:19:53,830 --> 00:19:56,630
،خدعك الرّخيصة لا تليق برجل نبيل

309
00:19:56,630 --> 00:19:58,800
!وأنا لن أتحمّلها

310
00:19:58,800 --> 00:20:01,010
!اشتعلي يا أصابع، اشتعلي

311
00:20:01,010 --> 00:20:04,470
!تسارع الدُّخان البنفسجيّ: الاحتراق الأرجوانيّ

312
00:20:06,180 --> 00:20:08,180
!رمية ناجحة. خروج

313
00:20:09,240 --> 00:20:11,190
متى تعلّم ذلك؟

314
00:20:19,170 --> 00:20:21,770
أنا عاديّ

315
00:20:22,610 --> 00:20:26,480
عندما كنتُ في العاشرة، أختي الصّغرى الّتي
،بالكاد قد بدأت تتعلّم دروس المبارزة

316
00:20:26,480 --> 00:20:28,060
سحقَتْني بشكل كامل

317
00:20:28,530 --> 00:20:31,160
أكذب إذا قلتُ بأنّ هذا لم يزعجني

318
00:20:31,160 --> 00:20:33,750
رغم ذلك، لم أستسلم

319
00:20:34,080 --> 00:20:37,250
كانت عبقريّة حقيقيّة تقف أمامي

320
00:20:37,570 --> 00:20:42,050
أصبحَتْ خير مِثال تعليميّ لأخيها العاديّ

321
00:20:42,050 --> 00:20:47,410
ويستون كذلك الأمر. تستقطب هذه المدرسة
المواهب من مجالات عدّة، ويعملون جميعهم بجدّ

322
00:20:47,730 --> 00:20:49,260
هذا ما يدعني أكافح لأحسّن نفسي

323
00:20:50,470 --> 00:20:54,490
كي أقترب قدر المستطاع من
!العباقرة الّذين أحترمهم

324
00:20:55,400 --> 00:21:00,530
أنا متأكّد بأنّه يُطلِق على نفسه
عاديّ" في هذه اللّحظة"

325
00:21:00,740 --> 00:21:04,030
إنّه يحترم مواهبَ الآخرين فعليّاً
دون إظهار ذرّة غيرة

326
00:21:04,030 --> 00:21:05,390
،يحتذي بهم

327
00:21:05,390 --> 00:21:09,490
ولا يدّخر جهداً ليقرّب مواهبه
الخاصّة إلى مستوى العبقريّة

328
00:21:09,810 --> 00:21:13,710
الاحترام الكامل هو موهبتك يا ميدفورد

329
00:21:14,620 --> 00:21:17,140
أنت عبقريّ

330
00:21:18,420 --> 00:21:19,460
!خروج

331
00:21:19,930 --> 00:21:23,210
سرعة الكُرة وارتفاعها يتغيّران
بشكل جذريّ بعد الارتداد

332
00:21:23,880 --> 00:21:27,640
لن تتمكّن من إصابة رمياتي استناداً
إلى إشارة تمّ إطلاقها قبل الارتداد

333
00:21:28,260 --> 00:21:30,890
!انهزمَتْ طريقة ضربكم الأوركستراليّة

334
00:21:30,890 --> 00:21:34,600
!كشفّنا بطريقة مُدهشة بسرعة

335
00:21:34,600 --> 00:21:37,560
لننتقل إلى التّكتيك التّالي إذاً

336
00:21:37,780 --> 00:21:39,270
!انظروا هناك

337
00:21:39,940 --> 00:21:41,190
!إنّه مدير المدرسة

338
00:21:43,170 --> 00:21:45,470
ذاك هو مدير المدرسة؟

339
00:21:49,030 --> 00:21:50,740
ماكميلان

340
00:21:50,740 --> 00:21:52,250
أدع الباقي لك

341
00:21:53,200 --> 00:21:54,910
!ماذا؟

342
00:21:54,910 --> 00:21:57,870
إذاً كشفَ مدير المدرسة عن نفسه أخيراً

343
00:21:58,440 --> 00:22:00,910
إذا قبضنا عليه، سنحلّ المسألة برمّتها

344
00:22:01,950 --> 00:22:04,010
!انطلق يا سيباستيان