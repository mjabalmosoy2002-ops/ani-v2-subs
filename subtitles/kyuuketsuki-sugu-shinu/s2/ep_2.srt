1
00:00:01,230 --> 00:00:06,400
أجل، هزمتُ كلّ مصّاصي الدّماء في هذه الأرجاء

2
00:00:06,400 --> 00:00:11,190
إنّها بلدة صغيرة، لكن سمعتُ
أنّ لديهم كثير من مصّاصي الدّماء

3
00:00:11,190 --> 00:00:15,490
لا مشكلة. سأبيدهم أجمعين

4
00:01:49,630 --> 00:01:54,130
"من طوكيو إلى طرف الخليج الجديد"

5
00:01:55,840 --> 00:01:58,590
...هذه شين-يوكوهاما إذاً

6
00:01:58,590 --> 00:02:00,970
ساحة معركتي الجديدة

7
00:02:08,020 --> 00:02:09,400
من هذا؟

8
00:02:09,400 --> 00:02:11,480
إنّه الشابّ من طوكيو الّذي قالوا
...بأنّه سوف يأتي اليوم

9
00:02:11,480 --> 00:02:13,940
!الدامبير

10
00:02:13,400 --> 00:02:16,900
صائد مصّاصي دِماء"
"ميكازوكي كاغوميهارا

11
00:02:13,940 --> 00:02:16,990
اسمي ميكازوكي كاغوميهارا. سررتُ بلقائكم

12
00:02:16,990 --> 00:02:19,610
أجل، سررتُ بلقائك

13
00:02:19,610 --> 00:02:21,660
!أهلاً بك في نقابة شين-يوكوهاما

14
00:02:21,660 --> 00:02:22,830
أهلاً بك

15
00:02:22,830 --> 00:02:24,280
!قطعت مسافة طويلة من طوكيو

16
00:02:24,280 --> 00:02:26,370
!نحن مُمتنّون حقّاً

17
00:02:26,370 --> 00:02:28,960
يبدو وكأنّهم يتملّقون لي جميعهم

18
00:02:28,960 --> 00:02:30,960
هذا يستفزّني

19
00:02:30,960 --> 00:02:32,750
!لنبذل قصارى جهدنا معاً

20
00:02:32,750 --> 00:02:35,670
لم آتِ إلى هنا لتشكيل أصدقاء

21
00:02:35,670 --> 00:02:38,720
أتيتُ إلى هنا لإبادة مصّاصي دماء هذه البلدة

22
00:02:38,720 --> 00:02:41,140
وأعوّض عن عدم أدائكم لأعمالكم

23
00:02:41,140 --> 00:02:43,680
!هذه طوكيو الّتي عهِدناها! تعرف جيّداً ما تقول

24
00:02:43,680 --> 00:02:45,100
!إنّه شغوف للغاية

25
00:02:45,100 --> 00:02:46,470
!مُؤتمَن تماماً

26
00:02:46,470 --> 00:02:48,850
ألا يمتلك هؤلاء كرامة؟

27
00:02:48,850 --> 00:02:51,400
ما خطب هذا الطفل الشقيّ الوقح؟

28
00:02:51,400 --> 00:02:53,360
!أنت الوقح

29
00:02:53,360 --> 00:02:55,440
!رمل

30
00:02:55,440 --> 00:02:59,110
تتكلّم مع نقابة صيّادي شين-يوكوهاما

31
00:02:59,110 --> 00:03:02,240
جميعكم، لدينا عمل

32
00:03:04,780 --> 00:03:08,290
!أشعر بوجود مصّاص دماء. من هنا

33
00:03:07,700 --> 00:03:09,960
"مصّاص دماء أدنى - العلَقة ذات العيون الثّمانية"

34
00:03:11,460 --> 00:03:13,710
هذه الفريسة ليست سيّئة

35
00:03:13,710 --> 00:03:15,290
!تراجعوا

36
00:03:17,840 --> 00:03:21,340
!أسلوب كاغوميهارا البديل، الانتشار المُسلَّح

37
00:03:22,590 --> 00:03:26,680
!تقنيّة سحب السّيف 1، تسوكويومي

38
00:03:30,270 --> 00:03:35,020
شوكا! حاول ميكازوكي للتو أداء
!الحركة النّهائيّة، أليس كذلك؟

39
00:03:35,020 --> 00:03:36,980
لا أرى ضرورة لتنفيذها على ضعيف

40
00:03:36,980 --> 00:03:38,730
ماذا يعني "انتشار مُسلَّح"؟

41
00:03:38,730 --> 00:03:40,740
!أحمق، أغلِق فمك

42
00:03:40,740 --> 00:03:42,530
هل الصُّراخ يجعلك أقوى أو ما شابه؟

43
00:03:42,530 --> 00:03:44,780
!قلتُ لك توقّف

44
00:03:44,450 --> 00:03:46,660
مصّاص دماء أدنى"
"عصفور غالاباغوس شين-يوكو

45
00:03:47,200 --> 00:03:48,990
!قوّات حديثة؟

46
00:03:48,990 --> 00:03:50,790
!الانتشار المُسلَّح

47
00:03:52,710 --> 00:03:54,710
!ما-ما هم؟

48
00:03:54,710 --> 00:03:57,500
صيّاد مصّاصي دِماء جديد؟

49
00:03:55,460 --> 00:03:57,460
"مصّاص دِماء - نيودينيوم"

50
00:03:57,500 --> 00:03:59,550
!ما مُشكلة هذا المُنحرف؟

51
00:03:59,550 --> 00:04:02,840
إنّه رجل طيّب، لذا ليس عليك إبادته

52
00:04:02,840 --> 00:04:04,050
!رجل طيّب؟

53
00:04:04,050 --> 00:04:06,600
أليست هذه ليلة رائعة يا صيّادين؟

54
00:04:06,600 --> 00:04:08,720
ماذا تفعل أيّها العمّ نيود؟

55
00:04:08,720 --> 00:04:13,270
أتيتُ لتوزيع نيودينيوم رُضَّع كجزء
من حملة التشجِّير

56
00:04:13,270 --> 00:04:15,850
حتّى لو كان رجلاً طيّباً، إذا ارتكبَ فِعلاً
سيّئاً، فيجب تولّي أمره

57
00:04:15,850 --> 00:04:17,560
!هكذا

58
00:04:17,560 --> 00:04:23,320
!مصّاص دِماء أعلى يتحكّم بالنّباتات؟
لماذا شخص بهذه الخطورة...؟

59
00:04:23,320 --> 00:04:26,530
!ميكازوكي

60
00:04:24,990 --> 00:04:25,360
"لا تتسلّق"

61
00:04:25,360 --> 00:04:28,990
"لا تتسلّق"
"مصّاص دماء - مُنتهِك آداب السّلوك"

62
00:04:26,530 --> 00:04:29,580
!سأُحرِجكم أنتم الصيّادين

63
00:04:29,580 --> 00:04:31,870
!أيّها الوغد! سأبيدك

64
00:04:31,870 --> 00:04:33,790
--الانتشار المُسلّـ

65
00:04:35,870 --> 00:04:39,170
!سخيف للغاية

66
00:04:39,170 --> 00:04:41,960
ألم أخبرك أن تكفّ عن فعل الأمور هكذا؟

67
00:04:41,960 --> 00:04:44,260
لا بدّ أنّك متفاجئ من عدد مصّاصي الدِماء الموجود

68
00:04:44,260 --> 00:04:46,890
من الصّعب المجيء إلى شين-يوكو
بعد أن كنت في طوكيو

69
00:04:46,890 --> 00:04:50,010
وكلّ ما لدينا هو مصّاصو الدّماءِ
الأعلى الغُرباء العجيبون أولئك

70
00:04:50,010 --> 00:04:53,520
مصّاص الدّماء المختوم داخل مزار
توكويا هو ما يجذبهم إلى هنا

71
00:04:53,520 --> 00:04:55,020
!لا تَلقِ عليه إشاعاتك

72
00:04:55,020 --> 00:04:57,650
لا أنكر بأنّنا جميعنا بحاجة مساعدة
لأنّنا لا نحصل على أيّ شخص جديد

73
00:04:57,650 --> 00:05:02,360
لذا نحن سعداء حقّاً لأنّك هنا

74
00:05:02,360 --> 00:05:05,070
هذا صحيح! لذا تشجّع، اتّفقنا؟

75
00:05:05,070 --> 00:05:06,860
...هؤلاء

76
00:05:06,860 --> 00:05:09,370
...يعتقدونني مشهداً جميلاً

77
00:05:09,370 --> 00:05:13,410
ينظرون إليّ بدفء، تماماً مثلما ينظر
النّاس الّذين يعملون في شركات استغلاليّة

78
00:05:13,410 --> 00:05:16,080
!...عندما يأتيهم موظّفٌ جديد

79
00:05:17,420 --> 00:05:19,290
!ميكازوكي

80
00:05:19,290 --> 00:05:22,960
!لا تستهينوا بي! أنا صيّاد درجة أولى

81
00:05:24,590 --> 00:05:27,300
!...أشعر بوجود مصّاص دماء قويّ

82
00:05:29,090 --> 00:05:31,930
!مصّاصو الدّماء! سوف أبيدكم

83
00:05:31,890 --> 00:05:35,310
"مصّاص دماء - الجسد السّفلي الشّفاف"
"مصّاص دماء - مايكرو بيكيني"
"مصّاص الدّماء - عاشق الياكيوكين"

84
00:05:31,930 --> 00:05:34,520
أنت صيّاد؟

85
00:05:34,520 --> 00:05:36,140
يا لك من جريء

86
00:05:36,140 --> 00:05:37,730
!مرحى

87
00:05:37,730 --> 00:05:38,810
--الانتشار المُسلّـ

88
00:05:38,810 --> 00:05:42,730
!سررتُ بلقائك! يويوينويوي

89
00:05:42,730 --> 00:05:44,900
!بدأ جسدي يلعب حجر ورق مقصّ مع تعرّي فجأة

90
00:05:44,900 --> 00:05:47,950
!وسأعطيك زيّاً جديداً

91
00:05:47,950 --> 00:05:50,450
!مُنحرف

92
00:05:51,990 --> 00:05:54,750
،أنا مصّاص دماء جيّد

93
00:05:54,750 --> 00:05:57,370
لذا سألتقط صوراً فحسب وأنشرها
على وسائل التواصل الاجتماعي

94
00:05:57,370 --> 00:05:58,460
!توقّف

95
00:05:58,460 --> 00:06:00,130
!ميكازوكي

96
00:06:00,130 --> 00:06:04,250
!يا مصّاصي الدّماء الأغبياء
!لا تتنمّروا على صيّادنا الجديد

97
00:06:04,250 --> 00:06:06,090
!سأقذفكم بعيداً جميعاً، لذا اصطفّوا أماكنكم هناك

98
00:06:06,090 --> 00:06:09,430
يبدو هذا مثيراً. سأهزمكم بأسلوبكم

99
00:06:09,430 --> 00:06:15,680
أيّها البشر، اليوم هو اليوم الّذي
ستستسلمون فيه للبيكيني خاصّتي

100
00:06:15,680 --> 00:06:18,440
!هل أنت بخير يا ميكازوكي؟

101
00:06:19,350 --> 00:06:24,400
...أنا مثير للشفقة... لم أكن أعرف شيئاً

102
00:06:24,400 --> 00:06:26,900
استهنتُ بكم جميعاً

103
00:06:26,900 --> 00:06:31,160
...وعلاوة على ذلك، فُضِحتُ بشكل مُخزٍ هكذا

104
00:06:31,160 --> 00:06:33,240
...يا لي من بغيض

105
00:06:33,240 --> 00:06:37,000
!هـ-هذا غير صحيح! أبليتَ حسناً يا ميكازوكي

106
00:06:37,000 --> 00:06:39,250
انتهى المطاف بنا بالبيكيني سابقاً أيضاً

107
00:06:39,250 --> 00:06:41,920
!أنت أفضل بكثير من شوت عندما أتى إلى هنا أوّل مرّة

108
00:06:41,920 --> 00:06:45,170
يبدو وكأنّك تبحث عن شِجار يا رونالدو

109
00:06:46,210 --> 00:06:50,470
لنبذل قصارى جهدنا من الآن فصاعداً، اتّفقنا؟

110
00:06:55,470 --> 00:06:59,390
اليوم، تعلّمتُ من خلال تجربتي

111
00:06:59,390 --> 00:07:02,060
--لا مشكلة، سوف أصبح أقوى

112
00:07:02,060 --> 00:07:05,020
هل أنت صيّاد؟

113
00:07:05,020 --> 00:07:10,070
في الوقت المثاليّ. ليس من طبيعتي
أن أنتهي خاسراً

114
00:07:10,070 --> 00:07:13,910
!إذا أردت القتال، فلن أتحفّظ... يا مصّاصة الدّماء

115
00:07:13,910 --> 00:07:15,080
--الانتشار المُسلّـ

116
00:07:15,080 --> 00:07:17,540
!أنت نوعي المُفضّل

117
00:07:23,460 --> 00:07:26,380
قال ميكازوكي بأنّه سيعود إلى اليابان

118
00:07:26,380 --> 00:07:29,510
!ميكازوكي

119
00:07:29,510 --> 00:07:32,510
!لم أعد أحتمل هذه البلدة

120
00:07:33,550 --> 00:07:37,970
"مُفكّرة مُراقبة درالوك المُثيرة"

121
00:07:33,550 --> 00:07:38,350
أنا هينايتشي من شرطة محافظة
كاناغاوا فرع مُكافحة مصّاصي الدّماء

122
00:07:38,100 --> 00:07:40,600
شرطة مُحافظة كاناغاوا"
نائبة قائد فرع مُكافحة مصّاصي الدّماء
"هينايتشي

123
00:07:38,350 --> 00:07:43,270
اللّيلة، سوف أستمرّ في مهمّة مُراقبة
مصّاص الدّماء درالوك

124
00:07:43,270 --> 00:07:47,190
!لماذا خرجتِ من الأرض؟! ادخلي من الباب يا غبيّة

125
00:07:47,190 --> 00:07:49,150
،لأنّكِ كنتِ تصنعين أماكنَ اختباء في الأرض

126
00:07:49,150 --> 00:07:52,530
!أصبحت أرضيّة المكتب مُتقلقلة

127
00:07:52,530 --> 00:07:54,660
،بما أنّه تمّت مُقاطعتي من جديد

128
00:07:54,660 --> 00:07:56,990
أنا هينايتشي من شرطة مُحافظة
كاناغاوا فرع مُكافحة مصّاصي الدّماء

129
00:07:56,990 --> 00:07:58,040
!اسمعيني

130
00:07:58,040 --> 00:08:03,000
والآن سأبدأ مهمّتي بمراقبة مصّاص الدّماء درالوك

131
00:08:03,000 --> 00:08:08,090
ينام مصّاصو الدّماء في التّوابيت أثناء
النّهار ويستيقظون في اللّيل

132
00:08:08,090 --> 00:08:10,760
درالوك ليس استثناء

133
00:08:14,550 --> 00:08:18,470
إنّها أمسية رائعة، أليس كذلك يا آنسة؟

134
00:08:18,470 --> 00:08:21,060
هل كنتِ تنتظرينني كي أستيقظ؟

135
00:08:21,060 --> 00:08:23,980
إن كشفتِ عن مؤخّرة عنقكِ
--لكسر صيامـ

136
00:08:23,980 --> 00:08:27,480
!الغرفة باردة جدّاً! رمل

137
00:08:27,480 --> 00:08:30,530
!جهاز التحكّم! جهاز التحكّم
!جهاز التحكّم! جهاز التحكّم

138
00:08:34,030 --> 00:08:37,570
هذا هو هدف مُراقبتي، مصّاص الدّماء درالوك

139
00:08:37,570 --> 00:08:41,700
يموت من أيّ تفصيل صغير ويتحوّل إلى غُبار

140
00:08:41,700 --> 00:08:44,250
إنّه مصّاص الدّماء الأضعف في العالم

141
00:08:44,250 --> 00:08:46,830
يا إلهي

142
00:08:46,830 --> 00:08:50,630
لماذا أراقب شخصاً كهذا؟ من فضلك لا تسأل

143
00:08:50,630 --> 00:08:53,340
!ساعدني يا رونالدو

144
00:08:53,340 --> 00:08:55,380
تحوّلت حيواناتي الأليفة إلى مصّاصي دماء

145
00:08:55,380 --> 00:08:56,970
افعل شيئاً بشأن ذلك

146
00:08:56,970 --> 00:09:02,850
عظيم! أنا، مصّاص الدّماء درالوك، سوف
!أستخدم رونالدو لتولّي هذا العمل

147
00:09:02,850 --> 00:09:03,520
!حقّاً؟

148
00:09:03,520 --> 00:09:05,100
!شكراً

149
00:09:05,100 --> 00:09:10,520
،إذا رأى درالوك أنّ شيئاً ما مُثيرٌ للاهتمام
سيتطفّل حتّى لو كان عمل صائد

150
00:09:10,520 --> 00:09:13,490
هذه يرقات خنفساء هرقل

151
00:09:13,490 --> 00:09:15,700
!هل تحوّلوا جميعهم إلى مصّاصي دماء؟

152
00:09:15,700 --> 00:09:17,160
يبدو أنّ بعضهم لم يتحوّل

153
00:09:17,160 --> 00:09:18,240
لا أدري

154
00:09:18,240 --> 00:09:19,330
افرزهم لأجلنا

155
00:09:19,330 --> 00:09:21,540
!هذا لا يشبه فرز الألمنيوم والعلب الفولاذيّة

156
00:09:21,540 --> 00:09:24,460
--لديّ لعبة يجب أن ألعبها، لذا أستأذن بالانصراف

157
00:09:24,460 --> 00:09:25,620
!اللّعنة عليك يا حثالة

158
00:09:25,620 --> 00:09:27,120
!حسناً، سأعود وآخذهم غداً

159
00:09:27,120 --> 00:09:28,460
!إلى اللّقاء -
!إلى اللّقاء -

160
00:09:28,460 --> 00:09:31,670
!انتظروا لحظة أيّها الأطفال الأوغاد

161
00:09:31,670 --> 00:09:36,680
حسناً، ماذا سأفعل بينما يكدح
رونالدو في العمل؟

162
00:09:36,680 --> 00:09:40,890
يبدو درالوك تلذُّذيّاً أحياناً

163
00:09:40,890 --> 00:09:45,730
يجب أن أطلب منه الإحجام عن
التصرُّفات الّتي قد تجلب المتاعب

164
00:09:45,730 --> 00:09:49,980
لديّ تفّاحة. هل أخبز كعكة؟

165
00:09:49,980 --> 00:09:52,480
!فكرة سديدة. أريد بعضاً

166
00:09:55,360 --> 00:09:56,610
!إنّها لذيذة جدّاً

167
00:09:56,610 --> 00:09:59,570
!ماذا أتيتِ إلى هنا لتفعلي بالضبط؟

168
00:09:59,570 --> 00:10:03,790
اللّعنة! سيكون هذا أسهل بكثير
...بوجود هاندا هنا

169
00:10:05,450 --> 00:10:09,210
!جون! هذا لطف منك

170
00:10:11,210 --> 00:10:14,130
!مرحباً، وشكراً على مشاهدة فيديوهات شابو-شابو

171
00:10:14,130 --> 00:10:18,010
اليوم، سألعب لعبة اشتريتُها قبل أيّام

172
00:10:18,010 --> 00:10:20,390
،رغم أنّه مصّاص دماء عاش حياةً مديدة

173
00:10:20,390 --> 00:10:23,890
تأقلم درالوك جيّداً مع الحياة العصريّة

174
00:10:24,520 --> 00:10:27,020
"'أريد قناة 'نو
"الأرماديلّو ظريف"

175
00:10:27,350 --> 00:10:30,310
أتعمّد عدم استخدام التّصويب على
!الهدف وأقترب من العدوّ

176
00:10:30,310 --> 00:10:33,610
أفضل فُرصة لي للهجوم هي
!بعد دحرجة التّفادي

177
00:10:33,610 --> 00:10:35,360
عمّاذا يتكلّم بالضبط؟

178
00:10:35,360 --> 00:10:38,780
أحياناً أشعر وكأنّه مُتكيِّف جيّداً

179
00:10:38,780 --> 00:10:41,820
هينايتشي، جرّبي أيضاً

180
00:10:41,820 --> 00:10:44,740
!لا أعرف حقّاً ما الّذي أفعله

181
00:10:43,910 --> 00:10:44,410
"...عزيزي درا-درا"
"لن أسمح بذلك"
"هل أنت متزوّج؟" "عزيزي درا-درا" "متّ بعد ذلك"

182
00:10:44,410 --> 00:10:45,200
"لنُشعِل هذا حماساً"
"يتعذّر تبرير هذا تماماً"
"الآثم درا-درا" "لنُشعِل هذا" "لن أشاهد بثّك بعد الآن

183
00:10:45,200 --> 00:10:46,000
"وداعاً يا درا-درا الصّغير"
"احصِ أخطاءك""
"لن أسامحك حتّى لو بكيت" "لا تُبكِه" "بثّ جون في الأسبوع المقبل

184
00:10:45,740 --> 00:10:48,040
!يا للهول! إنّهم غاضبون الآن

185
00:10:48,040 --> 00:10:49,250
...رمل

186
00:10:49,250 --> 00:10:51,670
!جون، أخمد النّار

187
00:10:52,540 --> 00:10:55,550
"نو"
"نو"
"نو" "نو"

188
00:10:55,750 --> 00:10:59,590
!والآن يا مُشاهدي-شابو، وداعاً

189
00:11:02,050 --> 00:11:04,050
...درالوك، أنت

190
00:11:04,050 --> 00:11:07,640
مختلف عن مصّاص دماء تماماً، صحيح؟

191
00:11:07,640 --> 00:11:09,940
...رمل

192
00:11:10,940 --> 00:11:14,400
!يا للعجب. حماقة البشر أعيت من يُداويها

193
00:11:14,400 --> 00:11:20,280
حسناً! سأريكِ كم أنا مصّاص دماء
!وأحفر الصّورة في ذهنكِ

194
00:11:20,280 --> 00:11:23,570
إنّه بمزاج غريب الآن

195
00:11:23,570 --> 00:11:26,160
!أوّلاً، يمكنني أن أنبعث بعد موتي فوراً

196
00:11:26,160 --> 00:11:28,160
لكن حينها ستموت ثانية فوراً

197
00:11:28,160 --> 00:11:30,710
!وانظري إلى هذه الأنياب الحادّة

198
00:11:30,710 --> 00:11:32,710
لم أرك تستخدمها أبداً

199
00:11:32,710 --> 00:11:37,210
وهاتان الأُذنان المُدبّبتان! إذا حاولتُ
جاهداً، يمكنني تحريكهما قليلاً

200
00:11:38,210 --> 00:11:40,880
"مصّاص دماء"

201
00:11:38,840 --> 00:11:45,260
"صِفات مصّاص الدّماء"

202
00:11:46,600 --> 00:11:50,100
!إليكِ الدّليل
!هذا هو شكل مصّاص الدّماء

203
00:11:49,770 --> 00:11:53,270
"يتحوّل"
"يطير"
"يمتصُّ دماء" "تسوجيغيري" "كلام بذيء" "أخرى

204
00:11:50,100 --> 00:11:53,480
!يتحوّلون! يطيرون! يمتصّ دماء

205
00:11:53,480 --> 00:11:57,360
!أوّلاً، سأتحوّل إلى خفّاش! انظري

206
00:11:57,360 --> 00:11:59,230
!مرّة أخرى

207
00:11:59,230 --> 00:12:00,740
!لا أستسلم أبداً

208
00:12:00,740 --> 00:12:01,990
أهذا هو؟

209
00:12:01,990 --> 00:12:03,240
!ثمّ أطير

210
00:12:03,240 --> 00:12:05,200
!لا تستسلم ليأسك

211
00:12:05,030 --> 00:12:06,160
"نعام سيقان العجوز"

212
00:12:11,040 --> 00:12:14,500
نجوتُ بطريقة ما بجرح قاتل

213
00:12:14,500 --> 00:12:17,040
أنا آسفة، اتّفقنا؟

214
00:12:17,040 --> 00:12:22,760
...وأخيراً، امتصاص الدّماء المُنتظَر طويلاً

215
00:12:22,760 --> 00:12:26,760
هذه قنينة شريان حياة مُتعارَف عليها
من الدّرجة الأولى أرسلَها أبي

216
00:12:26,760 --> 00:12:28,970
سأفتحها

217
00:12:30,060 --> 00:12:32,270
الدّماء هو مُتبرّعة عذراء في العشرينيّات من عمرها

218
00:12:30,600 --> 00:12:36,060
"ترف"

219
00:12:32,270 --> 00:12:36,150
بزمرة دم ب خضعت لفحص دقيق

220
00:12:36,150 --> 00:12:37,650
،باستخدام طريقة التبرّع بالدم بعد صيام يوم

221
00:12:37,650 --> 00:12:40,650
إنّها قنينة غير مخلوطة نادراً
!ما نراها في هذه الأيّام

222
00:12:40,650 --> 00:12:42,070
،ناهيك عن السّعر

223
00:12:42,070 --> 00:12:44,450
!إنّه مُنتَج خاص نادراً ما يُرى في الأسواق

224
00:12:44,450 --> 00:12:48,410
!وسأفتحها! رغم أنّه ليس عيد ميلادي حتّى

225
00:12:48,410 --> 00:12:50,490
ليس عليك فتحها إذا كنت لا تريد ذلك

226
00:12:50,490 --> 00:12:52,160
!اتّخذتُ القرار سلفاً

227
00:12:52,160 --> 00:12:55,000
!سأريكِ كيف أستطيع امتصاص دماء كمصّاص دماء

228
00:12:55,000 --> 00:12:58,710
لكنّك لا تُهاجم البشر كمصّاص دماء، صحيح؟

229
00:12:58,710 --> 00:13:01,340
!هيّا! ا-افتحي

230
00:13:01,340 --> 00:13:04,720
!ا-ا-افتحي، افتحي

231
00:13:04,720 --> 00:13:07,510
سأفتحها لك

232
00:13:07,510 --> 00:13:09,430
تفضّل

233
00:13:11,060 --> 00:13:14,060
انتهيتُ أخيراً من فرزهم، تبّاً

234
00:13:16,600 --> 00:13:18,940
...رمل

235
00:13:18,940 --> 00:13:21,030
!آسفة يا درالوك

236
00:13:21,030 --> 00:13:22,610
!مُؤلم، لكن لذيذ

237
00:13:22,610 --> 00:13:25,740
--أنت-- ستفوح رائحة الدّماء في الغرفة

238
00:13:27,990 --> 00:13:31,740
!--ابتعدوا يا مصّاصي الدّماء الوضيعين! هذه لي

239
00:13:31,740 --> 00:13:32,830
!...رمل

240
00:13:32,830 --> 00:13:34,790
!درالوك

241
00:13:42,340 --> 00:13:46,630
!اسمي مملكة هيراكورو

242
00:13:44,720 --> 00:13:46,470
ملِك مُستعمرة خنفساء المصّاصيّة"
"مملكة هيراكورو

243
00:13:46,630 --> 00:13:49,760
!...بشر

244
00:13:51,640 --> 00:13:54,890
مصّاصو الدّماء كائنات خارقة

245
00:13:54,890 --> 00:13:58,150
يمكن أن يتمّ تهديدهم حتّى بأتفه الأشياء

246
00:13:58,150 --> 00:14:01,440
أقاتل للدفاع ضدّ تلك التّهديدات

247
00:14:01,440 --> 00:14:03,280
!ساعديني في التّنظيف

248
00:14:03,280 --> 00:14:07,950
كان ذلك شديداً

249
00:14:07,950 --> 00:14:10,910
هل أخبز بعض البسكويت كنوع من الإلهاء؟

250
00:14:10,910 --> 00:14:13,660
هل ترغبين في البعض يا هينيتشي؟

251
00:14:13,660 --> 00:14:15,700
!أجل من فضلك

252
00:14:15,410 --> 00:14:17,040
"محطّة شرطة شين-يوكوهاما"

253
00:14:15,700 --> 00:14:20,040
!وهكذا... كان البسكويت شهيّاً

254
00:14:20,040 --> 00:14:23,920
لا تدعي البسكويت يمسح كلّ ذكرياتكِ

255
00:14:23,550 --> 00:14:27,010
"مصّاصيّ"

256
00:14:23,920 --> 00:14:25,760
وهذه هديّة تذكاريّة

257
00:14:25,760 --> 00:14:27,760
!لا أريد

258
00:14:27,760 --> 00:14:30,050
!أحبُّ الدّونات أيضاً

259
00:14:30,090 --> 00:14:31,140
"مُغلَق اليوم"
"وكالة صيّاد مصّاصي الدّماء رونالدو"

260
00:14:31,140 --> 00:14:34,260
"مسعى بوّابة الرُّوح: مُتحرّيو الرُّوح"
"مُغلَق اليوم"
"وكالة صيّاد مصّاصي الدّماء رونالدو"

261
00:14:31,300 --> 00:14:35,100
!خرجَ رونالدو للتسوُّق اليوم، لذا هو ليس هنا

262
00:14:36,350 --> 00:14:38,850
الآن، هذه قلعتي

263
00:14:38,850 --> 00:14:41,520
على ذكر الأمر، اليوم هو يوم بدر يا جون

264
00:14:41,520 --> 00:14:45,190
تأمُّل القمر أثناء لعِب ألعاب الفيديو مُمتع أيضاً

265
00:14:45,190 --> 00:14:48,150
...سيّد فوكوما؟! رمل

266
00:14:48,150 --> 00:14:51,410
أعتذر عن مجيئي في وقت متأخّر من اللّيل

267
00:14:51,410 --> 00:14:54,410
رونالدو ليس في المنزل! ينبغي أن
!تُسرِع إذا أردت اللّحاق به

268
00:14:54,410 --> 00:14:57,580
!لا، أنا هنا لأجلك اليوم يا درالوك

269
00:14:57,580 --> 00:14:58,910
أنا؟

270
00:14:58,910 --> 00:15:03,750
درالوك، هلّا جرّبت كتابة مُراجعة عن لعبة فيديو؟

271
00:15:03,750 --> 00:15:07,550
سمعتُ أنّك تعرف الكثير عن الألعاب

272
00:15:07,550 --> 00:15:11,340
أريد أن أطلب منك كتابة مُراجعة لمشروع
جديد لمجلّة ألعاب الفيديو خاصّتنا

273
00:15:11,340 --> 00:15:13,680
!كما هو مُتوقَّع من السيّد فوكوما! لديك عين ثاقبة

274
00:15:13,680 --> 00:15:16,310
سأكتب أفضل مُراجهة رأيتها في حياتك

275
00:15:16,310 --> 00:15:17,980
شكراً جزيلاً لك

276
00:15:17,980 --> 00:15:22,730
اللّعبة الّتي نريدك أن تكتب عنها
--"تُدعى "مسعى بوّابة الرُّوح

277
00:15:22,730 --> 00:15:24,690
ماذا؟ أتعرفها؟

278
00:15:24,690 --> 00:15:26,650
...فـ-في الواقع

279
00:15:26,650 --> 00:15:28,360
!أعرفها بالطبع

280
00:15:28,360 --> 00:15:33,450
إنّها لعبة لعينة ذائعة الصّيت قيل
!بأنّها تُفسد دماغك في خمس دقائق

281
00:15:33,450 --> 00:15:36,410
هـ-هل أنت من اختار هذه اللّعبة يا سيّد فوكوما؟

282
00:15:36,410 --> 00:15:39,750
لا. تمّ التّوصية بها بواسطة رئيس التّحرير

283
00:15:39,750 --> 00:15:41,290
!...رمل

284
00:15:41,290 --> 00:15:44,630
--عـ-عظيم. سأتّصل بك حالما أنجزه

285
00:15:44,630 --> 00:15:49,050
رئيس التّحرير، أعمل على مشروع
اللّعبة، لن أعود إلى المكتب اليوم

286
00:15:49,050 --> 00:15:51,050
!ماذا؟

287
00:15:51,050 --> 00:15:55,300
أنا مُحرَج من الاعتراف بهذا، لكن
نادراً ما ألعب ألعاب فيديو

288
00:15:55,300 --> 00:15:58,350
من فضلك دعني أتفرّج للمرجعيّة المستقبليّة

289
00:15:58,350 --> 00:16:03,100
هذا سيّئ. إذا انتقدتُ هذه اللّعبة انتقاداً
لاذعاً، فكأنّني أنتقد خيار رئيس التّحرير

290
00:16:03,100 --> 00:16:08,280
بمعنى آخر، كأنّني أعدي مجموعة
!من حاملي الفؤوس القتاليّة

291
00:16:08,280 --> 00:16:12,280
مهما كانت هذه اللّعبة رديئة، خياري
!الوحيد هو أن أمتدحها

292
00:16:12,280 --> 00:16:15,990
...أتطلّع قدماً لرؤية طبيعة هذه اللّعبة

293
00:16:25,750 --> 00:16:29,880
العنصر اللّعين الأوّل: وقت التّحميل طويل
بما يكفي للذّهاب إلى دورة المياه

294
00:16:29,880 --> 00:16:31,470
ماذا ننتظر؟

295
00:16:31,470 --> 00:16:33,970
!نقضي هذا الوقت لتدريب روحنا

296
00:16:33,970 --> 00:16:38,180
هذا نظام رائع يتيح لك التحلّي بالصّبر
!قبل أن تبدأ باللّعب

297
00:16:38,180 --> 00:16:41,980
يذكّرني هذا ببرنامجنا التّدريبيّ للموظّفين الجدُد

298
00:16:41,980 --> 00:16:44,980
نُحبَس في غرفة صامتة ومُظلمة لثلاثة أيّام

299
00:16:44,980 --> 00:16:50,030
وحدهم من يستطيعون البقاء هادئين خلال
تلك الفترة يستحقّون أن يُصبِحوا مُحرّرين

300
00:16:50,030 --> 00:16:52,950
أيّ لعبة عميقة هذه حتّى تحتوي على تدريب أيضاً

301
00:16:52,950 --> 00:16:54,450
...أ-أجل

302
00:16:54,450 --> 00:16:58,830
!عُد إلى المنزل بسرعة يا رونالدو
!تعال وتصرّف على أنّك وسيط

303
00:16:58,830 --> 00:17:02,200
التّحميـ-- أقصد، وقت التّدريب قد انتهى

304
00:17:02,200 --> 00:17:05,500
!مسعى بوّابة الرُّوح تُفتَح الآن! مذهل

305
00:17:05,500 --> 00:17:09,210
!العنصر اللّعين الثّاني: التحكّم بمستوى الصّوت صعب

306
00:17:09,210 --> 00:17:11,840
...هذا صاخب جدّاً! رمل

307
00:17:11,840 --> 00:17:14,090
المعذرة، ماذا قلت؟

308
00:17:14,090 --> 00:17:16,300
!انفجار صوتيّ يخلق إحساساً بالواقعيّة

309
00:17:16,300 --> 00:17:18,890
!هذا المقطع الصّوتي هو القصاصة المثاليّة

310
00:17:18,890 --> 00:17:22,730
على سبيل المُصادفة، ما طبيعة قصّة هذه اللّعبة؟

311
00:17:22,730 --> 00:17:27,810
أعتقد المُلخَّص كان في الكُتيّب

312
00:17:27,810 --> 00:17:33,150
العنصر اللّعين الثّالث: قصّة تبدو كما
لو أنّه كتبَها تلميذ صفّ ثالث

313
00:17:33,150 --> 00:17:36,410
يبدو أنّها قصّة الشخصيّة الرئيسيّة الّتي
تستكشف منزلاً غربيّ الطّراز

314
00:17:36,410 --> 00:17:38,240
هذا بسيط للغاية

315
00:17:38,240 --> 00:17:43,750
دخلنا القصّة الرّئيسيّة أخيراً. يبدو
أنّ هذه هي الشخصيّة الرئيسيّة

316
00:17:43,750 --> 00:17:49,210
العنصر اللّعين الرّابع: تبدو الشخصيّة الرئيسيّة
مختلفة تماماً عن الغلاف

317
00:17:49,210 --> 00:17:53,840
تـ-تصميم الشخصيّة الفلسفيّة الّذي
يطبع في الذّهن فنّاً عصريّاً رائع

318
00:17:53,840 --> 00:17:56,590
هكذا إذاً. هذا طليعيّ حقّاً

319
00:17:56,590 --> 00:17:59,010
!هذه الحركات الغبيّة

320
00:17:59,010 --> 00:18:00,680
هذه طريقة فريدة في المشي

321
00:18:00,680 --> 00:18:06,810
ا-التّسيير المُميّز يُثبِت كم أنّها لعبة
!أصليّة وصولاً للنظام بحدّ ذاته

322
00:18:09,980 --> 00:18:12,980
!تموت بسهولة وبشكل غير منطقيّ

323
00:18:12,980 --> 00:18:17,740
هذا صحيح! لا أحد يعلم متى
!تُخمَد نار الحياة

324
00:18:17,740 --> 00:18:19,660
!إنّها واقعيّة للغاية

325
00:18:19,660 --> 00:18:21,830
يبدو وكأنّك تموت أيضاً

326
00:18:21,830 --> 00:18:25,910
.المعذرة. أنا أتعاطف زيادة عن اللّزوم
--سوف أتمالك نفسي و

327
00:18:25,910 --> 00:18:28,830
!مسعى بوّابة الرُّوح تُفتَح الآن! مذهل

328
00:18:28,830 --> 00:18:33,250
!لماذا تعود هذه اللّعبة اللّعينة من البداية؟

329
00:18:33,250 --> 00:18:36,420
إنّها تترك انطباعاً أقوى بتكرار نفس المقطع

330
00:18:36,420 --> 00:18:38,680
!في الموسيقى، يُدعى هذا امتناعاً

331
00:18:38,680 --> 00:18:41,720
!حالما تظهر رسالة "انتهى اللّعب"، ستفهم قيمتها

332
00:18:43,140 --> 00:18:46,560
...بناء الخبرة من التّجربة السّابقة والمتابعة

333
00:18:51,060 --> 00:18:53,940
!مسعى بوّابة الرُّوح تُفتَح الآن! مذهل

334
00:18:53,940 --> 00:18:57,150
!اللّعنة

335
00:18:57,150 --> 00:19:00,280
اعذرني من فضلك. يبدو أنّني فقدتُ التّركيز

336
00:19:00,280 --> 00:19:01,320
درالوك

337
00:19:01,320 --> 00:19:02,280
نعم؟

338
00:19:02,280 --> 00:19:05,490
هل تعتقد في الواقع أنّ هذه اللّعبة مُملّة؟

339
00:19:05,490 --> 00:19:08,210
!ماذا؟! بالطبع لا، مُحال

340
00:19:08,210 --> 00:19:10,250
،بما أنّك ترتكب الأخطاء

341
00:19:10,250 --> 00:19:12,960
ارتأيتُ فحسب أنّ السّبب قد يكون هو
لأنّك غير منغمس في اللّعبة

342
00:19:12,960 --> 00:19:17,880
...لـ-لا... أ-أنا فقط

343
00:19:20,340 --> 00:19:24,600
أنا فقط مُشتَّت الانتباه لأنّني أحاول مُراجعتها

344
00:19:24,600 --> 00:19:27,890
فخّ مُميت بشكل فوريّ لا يمكن
!تمييزه عن الخلفيّة

345
00:19:27,890 --> 00:19:30,730
!خدعة مُفاجئة لإبقاء اللّاعبين متأهّبين

346
00:19:30,730 --> 00:19:33,360
!موت غير مُنصِف في أوّل محاولة

347
00:19:33,360 --> 00:19:39,450
نِداء صحوة لكلّ الألعاب المُملّة في السّنوات
!الأخيرة! لعبة رائدة في عصر جديد

348
00:19:39,450 --> 00:19:40,740
!...هذا

349
00:19:40,400 --> 00:19:45,330
"أحبّك يا سورد" "هذا هو القدر"

350
00:19:40,740 --> 00:19:42,910
نفس الرّسم استُخدِمَ لكلّ الشخصيّات

351
00:19:42,910 --> 00:19:46,450
!وإذا لم تتكلّم معهم بالترتيب الصّحيح، سوف تُشوَّش

352
00:19:45,330 --> 00:19:45,910
"المكان خطير هناك" "اقتل العدوّ" "أنت
"أحبّك يا سورد" "هذا هو القدر"

353
00:19:46,450 --> 00:19:50,660
!توازُن دقيق لا يسمح لك باللّعب بطَيش

354
00:19:50,710 --> 00:19:54,210
"المكان خطير هناك" "اقتل العدوّ" "أنت
"أحبّك يا سورد" "هذا هو القدر"

355
00:19:52,210 --> 00:19:54,670
!توقُّف مُتكرِّر

356
00:19:54,670 --> 00:19:57,250
لا مشكلة. أنت مُرهَق قليلاً فحسب، صحيح؟

357
00:19:57,250 --> 00:20:00,920
!ينبغي أنّك ما زلت تمتلك الرُّوح للنّهوض ثانية

358
00:20:03,840 --> 00:20:05,140
!أخيراً

359
00:20:05,140 --> 00:20:07,810
وصلتُ للزعيم

360
00:20:07,810 --> 00:20:11,480
تلعب بإتقان يا درالوك

361
00:20:11,480 --> 00:20:15,270
--حالما يُفتَح هذا الباب، الحدث الأخير

362
00:20:15,060 --> 00:20:17,070
"أدخِل النصّ هنا من فضلك"

363
00:20:17,320 --> 00:20:22,860
العنصر اللّعين الهائل: حدث أخير ناقص

364
00:20:25,450 --> 00:20:27,030
درالوك؟

365
00:20:27,030 --> 00:20:29,080
سيّد فوكوما

366
00:20:29,080 --> 00:20:33,250
أخيراً فهمتُ الرّسالة من هذه اللّعبة

367
00:20:33,250 --> 00:20:38,050
لا يوجد شيء كامل في هذا العالم

368
00:20:38,050 --> 00:20:42,420
الأهداف الرّخيصة الّتي تعرضها للآخرين
ليست إلّا مجرّد أوهام

369
00:20:42,420 --> 00:20:45,180
سيأتي يوم تواجه فيه الظّلم وتعتنق الحزن

370
00:20:45,180 --> 00:20:49,260
وتركع على ركبتيك أمام جدار
لا يمكنك فعل شيء حياله

371
00:20:49,260 --> 00:20:52,730
!لكن رغم ذلك، يستمرُّ دربنا

372
00:20:52,730 --> 00:20:57,230
!قد تكون مُغالَطة أو أكاذيب
!--جِد معنى في الانتكاسات واليأس

373
00:20:57,230 --> 00:21:00,730
!--اصمت يا درا

374
00:21:00,730 --> 00:21:02,570
سـ-سيّد فوكوما، لماذا أنت هنا؟

375
00:21:02,570 --> 00:21:05,320
سلّمتُ نصّي سلفاً، أليس كذلك؟

376
00:21:05,320 --> 00:21:08,240
أنا هنا اليوم بمهمّة عمل لأجل مجلّة الألعاب خاصّتنا

377
00:21:08,240 --> 00:21:10,620
إنّه لأجل مشروع جديد مُقترَح بواسطة رئيس التّحرير

378
00:21:10,620 --> 00:21:12,660
"مُراجعات لألعاب سيّئة للغاية"

379
00:21:12,660 --> 00:21:14,120
أتيتُ لأجل درالوك

380
00:21:14,120 --> 00:21:18,590
...مُراجعات لألعاب سيّئة للغاية
...مُراجعات لألعاب سيّئة للغاية

381
00:21:18,590 --> 00:21:22,260
...مُراجعات لألعاب سيّئة للغاية

382
00:21:22,260 --> 00:21:24,970
...يـ-يبدو هذا كمشروع جنوني آخر

383
00:21:24,970 --> 00:21:26,760
!رمل

384
00:21:31,140 --> 00:21:35,480
ليس سيّئاً بالنسبة لهاوٍ على ما أعتقد

385
00:21:35,480 --> 00:21:38,900
نعم، نعم، شكراً على محيدك

386
00:21:39,860 --> 00:21:41,150
نعم، مرحباً؟

387
00:21:41,150 --> 00:21:42,900
فوكوما يتكلّم

388
00:21:42,900 --> 00:21:45,240
نالت مُراجعتك استحساناً

389
00:21:45,240 --> 00:21:48,530
يسرّني سماع ذلك

390
00:21:48,530 --> 00:21:53,330
والآن بخصوص الموعد النّهائي
...للّعبة التّافهة التّالية

391
00:21:53,330 --> 00:21:55,830
--مسعى البوّابة تُفتَح

392
00:23:25,340 --> 00:23:27,260
"تحدّيات كثيرة"

393
00:23:28,510 --> 00:23:30,010
"طموح نهم"

394
00:23:31,840 --> 00:23:36,270
هل أمدُّ لك يد العون يا آنسة؟

395
00:23:36,270 --> 00:23:39,940
سرعان ما يموت مصّاص الدّماء