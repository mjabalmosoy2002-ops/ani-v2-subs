...وأيضاً أنا لا أراك عابثاً

203
00:10:48,930 --> 00:10:50,990
!ولكنك كئيب بعض الشيء

204
00:10:52,240 --> 00:10:54,080
!أرجوك لا تصب بالإحباط

205
00:10:56,370 --> 00:10:59,130
...ولكنك طيب

206
00:10:59,130 --> 00:11:03,450
.كونك كئيب بعض الشيء، هذا يشعرني بالراحة

207
00:11:03,450 --> 00:11:04,760
.هذا ما أحبه فيك

208
00:11:09,330 --> 00:11:11,010
...أنا آسفة

209
00:11:11,010 --> 00:11:12,850
!لقد زلّ لساني بقول غريب

210
00:11:12,850 --> 00:11:15,320
هاسيبي-سان أنت طيب مع الجميع صح؟

211
00:11:15,320 --> 00:11:17,290
أنت هكذا مع الجميع؟

212
00:11:17,290 --> 00:11:19,850
...-هذا ليس صحيحاً، أنت مختلفة يا لوسي

213
00:11:20,590 --> 00:11:23,470
!لا، يجب عليك أن تكون طيباً مع الجميع

214
00:11:23,470 --> 00:11:24,940
!المساواة للجميع

215
00:11:24,940 --> 00:11:27,150
!آسفة، سوف أعود

216
00:11:34,820 --> 00:11:39,420
.أظن بأنني أدفع ثمن الحياة المبهجة التي عشتها حتى الآن

217
00:11:42,530 --> 00:11:43,710
لماذا؟

218
00:11:43,710 --> 00:11:48,180
لماذا انتهى بي الأمر موافقة على الخروج لتناول الطعام مع تاناكا-سان؟

219
00:11:50,090 --> 00:11:50,910
!لا

220
00:11:50,910 --> 00:11:53,050
.إذا بقيت أندم، فلن يتغير شيء

221
00:11:53,050 --> 00:11:54,270
!يجب أن أتقدم للأمام

222
00:11:54,630 --> 00:11:56,570
!يجب أن أتحسن ولو قليلاً

223
00:11:57,550 --> 00:12:00,690
!سأغير ملابسي وأتوجه للمدينة، يس

224
00:12:03,780 --> 00:12:07,410
من الجيد خروجي للمدينة، ولكن ماذا يجب أن أفعل؟

225
00:12:07,410 --> 00:12:09,240
.لا يوجد لدي أي هدف

226
00:12:17,970 --> 00:12:19,400
...هذه

227
00:12:21,970 --> 00:12:23,840
ياماجامي-سان أكيد؟

228
00:12:23,840 --> 00:12:25,920
أتبحث عن شيء ما؟

229
00:12:28,820 --> 00:12:31,540
!لقد وجدت الكتاب الذي تبحث عنه

230
00:12:32,610 --> 00:12:34,640
هل سعره مرتفع كثيراً؟

231
00:12:34,900 --> 00:12:37,400
...أشعر بأنني أتجسس

232
00:12:40,990 --> 00:12:42,900
!ميوشي-سان

233
00:12:43,480 --> 00:12:46,240
!من غير المألوف أن نرى بعضنا في أيام العطل

234
00:12:46,240 --> 00:12:49,210
صحيح، هل تتسوقين؟

235
00:12:49,210 --> 00:12:50,200
.أجل

236
00:12:50,200 --> 00:12:52,700
...هناك كتاب أردت شراءه وبدأت البحث عنه

237
00:12:52,700 --> 00:12:56,950
...وبعد أن وجدته أخيراً، كان سعره مرتفعاً أكثر مما توقعت

238
00:12:56,950 --> 00:12:59,400
.لهذا شعرت بالحيرة بشأنه

239
00:12:59,400 --> 00:13:01,540
!لقد كنت محقة

240
00:13:01,910 --> 00:13:05,600
.أنا ذاهبة للبحث عن المزيد من الكتب، عن إذنك

241
00:13:05,600 --> 00:13:08,800
.حسناً، إذنك معك

242
00:13:13,590 --> 00:13:15,530
!ذاك هو هاسيبي-سان

243
00:13:15,920 --> 00:13:17,100
.مئة ضربة

244
00:13:18,300 --> 00:13:22,950
.إنه يلعب بهدوء وتركيز عالٍ بأعين ميتة

245
00:13:26,410 --> 00:13:29,190
ميوشي-تشان، ماذا تفعلين؟

246
00:13:27,340 --> 00:13:29,190
!لقد حصلت على النتيجة الكاملة

247
00:13:29,640 --> 00:13:31,910
!سرعة مذهله في تغيير المزاج

248
00:13:32,580 --> 00:13:34,860
.أنا أقوم بالتجوال فقط

249
00:13:34,860 --> 00:13:37,240
!هاسيبي-سان عيونك تبدو مثل الميت

250
00:13:37,240 --> 00:13:38,630
ماذا، حقاً؟

251
00:13:38,630 --> 00:13:40,750
هل حصل شيء سيء؟

252
00:13:42,400 --> 00:13:44,830
.إن كان من الصعب الحديث عنه، فلا تجبر نفسك

253
00:13:44,830 --> 00:13:48,330
...لقد حصلت على نتيجة كاملة في جالجي

254
00:13:48,330 --> 00:13:51,300
!ولكن المكافئة كانت عديمة القيمة

255
00:13:51,540 --> 00:13:55,340
.لم أفهم الأمر حقاً، ولكني متأكدة من أنه شيء عديم الفائدة

256
00:13:55,740 --> 00:13:59,740
ألعاب الجالجي هي التي تغرم بالفتاة وتخرج معها في موعد، صح؟

257
00:13:59,740 --> 00:14:00,890
.شيء من هذا القبيل

258
00:14:01,250 --> 00:14:03,240
...إن كان لديك الوقت للقيام بهذا

259
00:14:03,240 --> 00:14:05,150
لِم لا تدعو ياماجامي-سان للخروج معك؟

260
00:14:08,520 --> 00:14:10,310
...أنتِ محقة

261
00:14:10,310 --> 00:14:13,120
.سوف أذهب الآن عن إذنك

262
00:14:13,120 --> 00:14:15,140
...مع السلامة

263
00:14:17,720 --> 00:14:20,200
...أنا حقاً شخص فاشل

264
00:14:23,460 --> 00:14:25,040
!ذلك الشاب مذهل

265
00:14:27,380 --> 00:14:28,750
!تشيهايا-سان؟

266
00:14:29,500 --> 00:14:30,950
!ميوشي-سان

267
00:14:30,950 --> 00:14:33,170
.تشترين الكعك؟ هذا جميل

268
00:14:33,480 --> 00:14:36,610
.أجل، سوف أذهب لمكان ما بعد ذلك

269
00:14:36,610 --> 00:14:38,130
هل هذا مناسب؟

270
00:14:38,130 --> 00:14:39,550
.نعم

271
00:14:39,550 --> 00:14:41,420
.يبدو أنك تشترين كمية كبيرة

272
00:14:41,420 --> 00:14:42,200
.أجل

273
00:14:42,200 --> 00:14:45,230
...هذه من أجل تحديد المزاج، وهذه من أجل الهدوء

274
00:14:45,230 --> 00:14:48,560
...وهذه من أجل الانفعال، وهذه لتغير الموضوع

275
00:14:48,560 --> 00:14:50,320
.وهذه في حال فشلت جميعها

276
00:14:51,750 --> 00:14:54,530
.أنا لا أفهم الأمر، ولكن حظاً موفقاً

277
00:14:54,530 --> 00:14:55,490
.يب

278
00:14:56,420 --> 00:14:59,830
.تشيهايا-سان على الأغلب ذاهبة لمكان اتشيميا-سان

279
00:15:01,370 --> 00:15:03,120
!مستحيل هذا اتشيميا-سان

280
00:15:03,760 --> 00:15:07,730
...إنه يبدو مثل الأب الذي تم فصله، ولكنه لا يملك الجرأة لقول هذا لعائلته

281
00:15:07,730 --> 00:15:09,860
.لهذا يقوم بإضاعة الوقت في الحديقة

282
00:15:14,370 --> 00:15:16,200
...اتشيميا-سان

283
00:15:16,200 --> 00:15:18,860
.ميوشي-سان، مرحباً

284
00:15:18,860 --> 00:15:20,740
مالذي تفعله؟

285
00:15:20,740 --> 00:15:22,100
.في الحقيقة لا شيء

286
00:15:22,880 --> 00:15:25,450
...توكو تدرس في المنزل على الأرجح

287
00:15:25,450 --> 00:15:28,230
.لهذا آتي هنا للتنزه لكي لا أُعيقها

288
00:15:28,730 --> 00:15:32,110
!مع أنه يوم عطلة، ولكن لا أملك شيء لأفعله

289
00:15:35,000 --> 00:15:37,700
لماذا لا تدعو صديقتك للخروج في موعد؟

290
00:15:39,480 --> 00:15:41,640
هل يبدو لكِ أن لدي صديقة؟

291
00:15:41,640 --> 00:15:46,660
!افترضت من عندي أن لديك

292
00:15:47,180 --> 00:15:49,710
...في الحقيقة لدي واحدة

293
00:15:50,210 --> 00:15:52,420
.ولكن لا أعرف إن كان ينبغي علي أن أدعوها

294
00:15:52,690 --> 00:15:55,420
...أظن بأن من الصعب عليها القيام بالدعوة

295
00:15:56,700 --> 00:16:00,100
.إنها دائماً في منزلي تقضي الوقت مع أختي

296
00:16:00,100 --> 00:16:03,770
!أظن بأنها لا تأتي لرؤية توكو-سان فقط ولكنها تأتي لرؤيتك أيضاً

297
00:16:05,480 --> 00:16:07,400
.ولكن يبدو أنهم يقضون وقتاً ممتعاً

298
00:16:07,750 --> 00:16:10,360
كيف تعلم هذا وأنت لست بقربهم؟

299
00:16:12,960 --> 00:16:16,900
.سوف أذهب الآن عن إذنك

300
00:16:16,900 --> 00:16:18,570
.أعتني بصديقتك

301
00:16:18,570 --> 00:16:21,450
.أجل، شكراً

302
00:16:23,570 --> 00:16:25,750
...أنا حقاً شخص فاشل

303
00:16:26,000 --> 00:16:30,000
!لقد قابلتُ العديد من زملاء العمل بمجرد خروجي لمرة واحدة

304
00:16:30,000 --> 00:16:32,410
هل سأقابل المدير هذه المرة؟

305
00:16:33,010 --> 00:16:37,170
.على الأغلب أنه لا يتجول بشكل الدمية في أيام العطل

306
00:16:37,170 --> 00:16:39,070
!اشتري هذا، اشتري هذا

307
00:16:39,590 --> 00:16:42,050
!لا، لقد اشتريت لك مقرمشات قبل قليل

308
00:16:42,310 --> 00:16:44,250
!لا بأس بواحدة فقط

309
00:16:44,250 --> 00:16:46,730
!لكن ستغضب ماما عليّ

310
00:16:46,730 --> 00:16:47,990
!لنذهب الآن يا بابا

311
00:16:49,890 --> 00:16:54,280
.على هذا المنوال سوف أقابل جميع من يعمل في مكتب الرعاية

312
00:16:54,710 --> 00:16:56,070
...الوحيد المتبقي هو

313
00:16:56,430 --> 00:16:57,680
.تاناكا-سان

314
00:17:00,720 --> 00:17:04,700
...لا، لقد خرجت للمدينة لذلك يجب أن افكر بطريقة إيجابية

315
00:17:04,920 --> 00:17:06,450
!لا يمكنني التراجع الآن

316
00:17:06,450 --> 00:17:08,270
!ألستِ سايا-تشان

317
00:17:08,980 --> 00:17:10,620
...إنه تاناكا-سان مختلف

318
00:17:10,620 --> 00:17:15,100
...جئت في وقتكِ سايا-تشان، إسمعي قليلاً

319
00:17:15,100 --> 00:17:16,780
...زوجة إبني

320
00:17:16,780 --> 00:17:19,300
.لن أخرج مجدداً في يوم عطلتي

321
00:17:21,650 --> 00:17:24,960
.ياماجامي-سان إعتني بهذه النماذج من فضلكِ

322
00:17:24,960 --> 00:17:26,280
!حسناً

323
00:17:27,170 --> 00:17:31,290
.مع أن البارحة كان يوم عطلة ولكنكِ تبدين مرهقة

324
00:17:32,340 --> 00:17:34,330
هل حدث معكِ شيء بعد افتراقنا؟

325
00:17:34,330 --> 00:17:36,120
...أجل، بعض الأشياء

326
00:17:38,700 --> 00:17:42,400
إذاً أنتِ ذاهبة لتناول العشاء مع تاناكا-سان اليوم؟

327
00:17:42,400 --> 00:17:45,160
.أجل، وصل الأمر لهذا بطريقة ما

328
00:17:45,580 --> 00:17:47,880
!لم أكن أعلم بانكم مقربون

329
00:17:47,880 --> 00:17:49,190
!أنا متفاجئة

330
00:17:49,190 --> 00:17:50,570
...بما أنها كبيرة في السن

331
00:17:50,570 --> 00:17:52,230
.أظن بأن مطعم تقليدي سيكون جيداً

332
00:17:52,230 --> 00:17:53,200
.إنه الحفيد

333
00:17:54,050 --> 00:17:55,510
.إنه مع الحفيد

334
00:17:55,510 --> 00:17:57,980
مع الحفيد؟

335
00:17:57,980 --> 00:17:59,630
.إنه الحفيد

336
00:17:59,630 --> 00:18:01,730
...تقصدين بالحفيد

337
00:18:01,730 --> 00:18:03,220
!ذلك الشخص صحيح؟

338
00:18:03,220 --> 00:18:04,300
.صح

339
00:18:04,300 --> 00:18:07,390
...لقد حدث شيء

340
00:18:07,710 --> 00:18:09,250
...حدث شيء إذاً

341
00:18:09,250 --> 00:18:11,300
كيف حدث هذا الشيء؟

342
00:18:11,690 --> 00:18:12,850
...ياماجامي-سان

343
00:18:12,850 --> 00:18:15,440
هل هنالك سر للحديث مع تاناكا-سان؟

344
00:18:15,440 --> 00:18:17,110
سر؟

345
00:18:17,580 --> 00:18:20,100
...من ذلك اليوم الذي خرجتي معه فيه

346
00:18:23,260 --> 00:18:25,250
.على ما يبدو هذا فوق قدرتها

347
00:18:25,810 --> 00:18:29,540
.آسفة، يبدو بأني طرحتُ سؤلاً صعباً

348
00:18:33,050 --> 00:18:34,310
...أوي

349
00:18:34,310 --> 00:18:35,180
هاسيبي؟

350
00:18:35,180 --> 00:18:38,720
...لا علاقة لي بالأمر، لهذا لا أريد قول الكثير

351
00:18:38,720 --> 00:18:40,910
.ولكن، لا تفعل أي شيء غريب مع ميوشي-تشان

352
00:18:41,590 --> 00:18:42,800
ماذا تعني بغريب؟

353
00:18:42,990 --> 00:18:44,670
.أعني غريب

354
00:18:44,990 --> 00:18:46,050
وماذا يعني؟

355
00:18:46,300 --> 00:18:47,890
!فقط لا تفعل

356
00:18:50,690 --> 00:18:52,910
مالذي تقصده بهذا يا هاسيبي؟

357
00:18:54,160 --> 00:18:57,060
هل سيكون كلاهما بخير؟

358
00:18:57,060 --> 00:18:58,340
.على الأغلب لا

359
00:18:58,340 --> 00:19:01,030
.أكيد لا، لأسباب عديدة

360
00:19:01,370 --> 00:19:02,820
.تفضلي بالمشي

361
00:19:02,820 --> 00:19:04,940
.شكراً

362
00:19:04,940 --> 00:19:07,900
.قد يبدو مظهراً فقط، ولكنهما يناسبان بعضهما

363
00:19:07,900 --> 00:19:10,160
.بالفعل بالمظهر فقط

364
00:19:10,160 --> 00:19:12,080
.فقط بالمظهر

365
00:19:13,730 --> 00:19:14,550
.تفضلي

366
00:19:14,550 --> 00:19:15,790
...شكراً لك

367
00:19:16,140 --> 00:19:19,380
.لا يمكنني الشرب، ولكن سوف أدعه يصب لي

368
00:19:25,700 --> 00:19:28,250
...هاسيبي قبل قليل

369
00:19:28,250 --> 00:19:30,460
نعم؟

370
00:19:31,710 --> 00:19:34,270
...ومن ثم هاسيبي.. وبسبب هاسيبي

371
00:19:35,200 --> 00:19:36,190
...كان هاسيبي

372
00:19:38,280 --> 00:19:40,730
!اناكا-سان تشبه جدتك كثيراً

373
00:19:40,730 --> 00:19:42,820
.يقال لي هذا كثيراً

374
00:19:43,180 --> 00:19:47,490
.بالتفكير في الأمر لا أعرف عنه سوى ما قاله هاسيبي-سان

375
00:19:49,480 --> 00:19:53,780
هل يمكنك محاولة الحديث عن شيء آخر غير هاسيبي-سان؟

376
00:20:00,450 --> 00:20:01,290
...خد

377
00:20:02,120 --> 00:20:03,000
خد؟

378
00:20:03,910 --> 00:20:06,760
...حول خدمات إدارة المحافظ

379
00:20:07,490 --> 00:20:09,820
!ليس من المفترض بكِ الضحك

380
00:20:10,200 --> 00:20:13,680
...كان موضوع المحادثة الخاص بك ممل جداً

381
00:20:13,680 --> 00:20:15,100
.لهذا لم أقدر على منع نفسي من الضحك

382
00:20:16,190 --> 00:20:19,110
.آسف لأني ممل

383
00:20:20,830 --> 00:20:22,860
.أنا مرتاحة نوعاً ما

384
00:20:22,860 --> 00:20:26,600
...لقد ظننت بأنه شخص مخيف، ولكنه مجرد شاب

385
00:20:26,600 --> 00:20:29,410
.جدي جداً يتحدث حول أشياء مملة

386
00:20:29,720 --> 00:20:33,460
...في الوقاع أردت التحدث حول الندم مثل المرة الماضية

387
00:20:35,210 --> 00:20:35,950
!ميوشي-سان؟

388
00:20:36,450 --> 00:20:38,570
!ميوشي-سان، تمالكِ نفسك

389
00:20:47,760 --> 00:20:49,110
...أنا آسف

390
00:20:49,890 --> 00:20:51,850
.لصبي لكِ كأس وأنتِ لا تشربين

391
00:20:51,850 --> 00:20:56,390
...لا عليك من هذا، الوضع الحلي لنا الآن

392
00:20:56,660 --> 00:20:58,510
ها، أي وضع؟

393
00:20:58,510 --> 00:21:01,850
.لاشيء، فقط اسمحلي بالنزول

394
00:21:05,440 --> 00:21:08,190
.أنا آسفة لفقداني للوعي

395
00:21:08,880 --> 00:21:12,160
.لقد كان الأمر ممتعاً، لنفعلها مرة أخرى

396
00:21:14,600 --> 00:21:15,480
...حسناً

397
00:21:16,120 --> 00:21:19,410
.على الرغم من أننا لم نتحدث بشأن الندم ولو قليلاً

398
00:21:19,850 --> 00:21:21,570
.أنت محق

399
00:21:27,270 --> 00:21:28,720
...رأسي يؤلمني

400
00:21:31,160 --> 00:21:34,410
!ميوشي-سان صباح الخير

401
00:21:34,410 --> 00:21:36,350
هل سار كل شيء على ما يرام البارحة؟

402
00:21:36,350 --> 00:21:39,390
.أجل، سار بخير

403
00:21:39,390 --> 00:21:41,090
ألم يقم بشيء غريب؟

404
00:21:41,090 --> 00:21:43,560
.لم يفعل، أنا بخير

405
00:21:43,910 --> 00:21:46,270
...ولكن في النهاية

406
00:21:46,570 --> 00:21:48,140
في النهاية؟

407
00:21:48,600 --> 00:21:51,320
.سيكون تاناكا-سان بخير لو أن هاسيبي-سان غير موجود

408
00:21:52,310 --> 00:21:54,330
!ماذا، لقد تم رفض وجودي للتو

409
00:23:26,040 --> 00:23:41,140
للأسبوع سؤال الموظف

410
00:23:26,530 --> 00:23:28,380
.سؤال الموظف للأسبوع

411
00:23:28,380 --> 00:23:32,680
.هنالك شيء مختلف بشأن ما ترتديه ياماجامي-سان اليوم

412
00:23:33,120 --> 00:23:34,500
ما هو يا ترى؟

413
00:23:36,010 --> 00:23:38,340
.سوف يظهر الجواب الآن

414
00:23:38,340 --> 00:23:41,580
!لا يمكننا بث هذا