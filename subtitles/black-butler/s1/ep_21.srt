1
00:00:15,080 --> 00:00:17,350
.لا حاجة لِأن تَعرفي اسم الهَدف

2
00:00:19,530 --> 00:00:22,040
.عَلَيكِ أن تَعرِفي شَيء واحد فقط

3
00:00:24,230 --> 00:00:24,920
.تُعيقَني

4
00:00:33,190 --> 00:00:34,850
،عيناكِ

5
00:00:34,850 --> 00:00:38,780
التي تَجلب الموت لِأيِ ضَحيّة تَكون أمامَهُما، بِغض النَظر عن المسافة؛

6
00:00:39,310 --> 00:00:40,710
.لا خيار لَدَيك سوى أن تَعيشي مَعَهُم

7
00:00:41,630 --> 00:00:42,930
أَليس هذا صَحيحًا؟

8
00:00:56,110 --> 00:00:58,620
.هُناك شيء واحد لِأفعَلُه

9
00:01:02,070 --> 00:01:03,620
،أُريد أن أعرِضَ عَليك عَمل

10
00:01:04,070 --> 00:01:06,370
.أن تَستَخدمي هاتَين العَينَين

11
00:01:07,800 --> 00:01:10,250
.سَنوفر لَكِ الطعام، الملبس، والمسكن

12
00:01:16,100 --> 00:01:17,760
.مرحبًا، أيَّتُها المُستَجِدّة

13
00:01:19,570 --> 00:01:22,010
.سَأُعَلِمُكِ كُل شيء عن العَمل

14
00:01:27,910 --> 00:01:29,680
أي نوعٍ مِن العَمَل هو؟

15
00:01:34,650 --> 00:01:36,480
.أحضرتُ خادِمة مستأجرة

16
00:01:37,670 --> 00:01:38,570
.مِن هُنا مِن فضلك

17
00:01:58,200 --> 00:02:00,440
.هذه أول مرّة لي أرتَدي فيها تَنورة

18
00:02:07,170 --> 00:02:09,020
.سَيّدي الصَغير أرسَلَ هذه

19
00:02:10,560 --> 00:02:11,610
السيّد الصَغير؟

20
00:04:11,530 --> 00:04:14,080
!صَباح الخَير، سَيّدي الصَغير

21
00:04:14,700 --> 00:04:15,800
.صباح الخَير

22
00:04:17,690 --> 00:04:18,770
سيّدي الصَغير؟

23
00:04:18,770 --> 00:04:20,760
.يـ-يَبدو أنَّهُ منهار المَعنَويات

24
00:04:20,760 --> 00:04:21,490
.هو كذلك

25
00:04:21,490 --> 00:04:24,820
يُمكِنَكُم أن تَعرفوا ذلك؟

26
00:04:25,170 --> 00:04:28,160
،نعم، قد يَبدو كَعادته مِن أولِ نَظرة

27
00:04:28,160 --> 00:04:30,690
.لكن يُمكننا رؤيّة ذلك بِوضوح

28
00:04:33,000 --> 00:04:37,010
!يَجِب أن نُبهِجه في الحال

29
00:04:37,010 --> 00:04:38,800
.هـ-هذا ما يَجب أن نَفعَلُه

30
00:04:38,800 --> 00:04:40,610
!حَفلة عَفَويّة

31
00:04:40,610 --> 00:04:41,300
!حفل

32
00:04:41,890 --> 00:04:43,030
.هدوء

33
00:04:49,130 --> 00:04:50,370
هدوء؟

34
00:04:50,370 --> 00:04:52,750
تَعني، أن نَتَصرّف كَالمُعتاد؟

35
00:04:52,750 --> 00:04:55,890
يَجب أن نَدَعه يَحصل على يوم استرخاء آخر، صَحيح؟

36
00:04:56,460 --> 00:04:57,960
!فَهِمت

37
00:04:57,960 --> 00:05:01,060
!سَأُحَوّل القصر لِشَيء مُبهج برّاق

38
00:05:01,060 --> 00:05:04,410
.يَبدو أن الوقت قَد حان لِأُظهر قائِمَتي الخاصّة

39
00:05:04,410 --> 00:05:06,990
!وسَأجعَل كُل الأشجار في الحَديقة تَبدو بِمظهر رائع أيضًا

40
00:05:07,500 --> 00:05:08,610
!لِنَنطَلِق

41
00:05:08,610 --> 00:05:09,760
!نعم

42
00:05:17,230 --> 00:05:19,670
!توّقف، بلو-بلو

43
00:05:22,570 --> 00:05:24,380
.بلو بلو، أنتَ نَشيط اليوم

44
00:05:30,810 --> 00:05:31,930
،لا! لا يُمكنك أكلَهُم

45
00:05:31,930 --> 00:05:34,180
!بلو بلو

46
00:05:38,210 --> 00:05:39,650
.أنا آسف أيَّتُها الطُيور الصَغيرة

47
00:05:40,790 --> 00:05:42,280
.آسف، بلو بلو

48
00:05:44,020 --> 00:05:48,530
.قبل أن آتي إلى هُنا، كانت الطيور أصدقائي الوحيدين

49
00:05:49,260 --> 00:05:53,580
.لكن عندما اتيت لِهذا القصر، يُمكنني الخروج هكذا كُل يوم

50
00:05:53,580 --> 00:05:55,000
!الأمر مُمتع جدًّا

51
00:05:56,750 --> 00:05:57,600
...سيّدي الصَغير

52
00:05:59,450 --> 00:06:03,460
أتساءل كَيف كان هذا القصر قبل أن آتي؟

53
00:06:10,370 --> 00:06:11,140
بلو بلو؟

54
00:06:16,360 --> 00:06:19,060
.هذا العام هو الذِكرى السَنَويّة لِلثورة الفَرنسيّة

55
00:06:19,060 --> 00:06:21,600
.يَبدو أن معرض العالم سَيَكون كَبيرًا اليوم

56
00:06:22,030 --> 00:06:26,590
.سَيَبنون بُرج لِلاحتفال بِالمُناسَبة، سَيَكون عاليًا بِعلو السماء

57
00:06:27,280 --> 00:06:29,480
.يُدعى بُرج إيفل كما أعتَقِد

58
00:06:30,120 --> 00:06:31,030
.نَعم

59
00:06:31,520 --> 00:06:38,070
ألا يُشبه الأمر بُرج بابل الذي ارتفع في السماء عاليًا ونال غَضب الرب؟

60
00:06:39,130 --> 00:06:39,710
.نَعم

61
00:06:40,500 --> 00:06:45,420
.أخبرَني آش سان أن جلالة المَلِكة سَتَأتي لِمُشاهَدة
المعالم السياحيّة في باريس، مُتَخَفيّة

62
00:06:46,550 --> 00:06:47,050
.نَعم

63
00:06:48,100 --> 00:06:50,460
هل تَرغب بِبعض شاي إيرل غراي؟

64
00:06:51,460 --> 00:06:52,010
.نعم

65
00:06:53,940 --> 00:06:58,670
.ذات مرّة، في بِلادٍ بَعيدة، كان هُناك زَوجَين مُسِنَين

66
00:06:58,670 --> 00:07:00,390
ما الذي تَتَحدث عنه؟

67
00:07:02,080 --> 00:07:03,610
.لقد كُنتَ تَستَمِع إذن

68
00:07:04,170 --> 00:07:05,430
.بِالطبع

69
00:07:09,060 --> 00:07:13,430
هل وصلت  تَعلِيمات من جلالَتُها عن حادثة ذلك اليوم؟

70
00:07:14,070 --> 00:07:15,450
.لا. لا شيء

71
00:07:15,970 --> 00:07:17,020
.فَهِمت

72
00:07:17,520 --> 00:07:18,780
.هذا جيّد أيضًا

73
00:07:23,870 --> 00:07:25,500
!سَنَجعله نَظيف

74
00:07:25,500 --> 00:07:28,790
!سَنَجعَله يُشرق

75
00:07:28,790 --> 00:07:29,610
.ميرين

76
00:07:30,930 --> 00:07:32,160
.سباستيان

77
00:07:33,420 --> 00:07:34,800
ما الذي تَفعَلينه؟

78
00:07:35,360 --> 00:07:36,690
ما الذي تَعنيه؟

79
00:07:36,690 --> 00:07:38,470
.أُلَمِعُ الدرابزين

80
00:07:41,340 --> 00:07:45,480
!خَلِطتِ بَين مُلَمِع الأحذيّة والشَمع

81
00:07:48,210 --> 00:07:52,190
هذه النظارات لَم تَعُد تُناسبك، أليس كذلك؟

82
00:07:52,190 --> 00:07:54,450
.حان وقت تَغييرَهُم

83
00:07:54,450 --> 00:07:56,190
!لا يُمكنني ذلك

84
00:07:56,190 --> 00:07:58,660
!إنَّهُم هَديّة ثَمينة مِن السيّد الصَغير

85
00:08:01,630 --> 00:08:02,670
،لا يهم

86
00:08:03,420 --> 00:08:06,130
.أَزيلي هذه البُقع بِسُرعة

87
00:08:06,500 --> 00:08:08,640
!سَأفعل

88
00:08:12,230 --> 00:08:15,040
-يَجِب أن أُعِد الغداء قبل فوات الآو

89
00:08:21,930 --> 00:08:22,890
!بارد

90
00:08:23,970 --> 00:08:28,360
كم مرّة عَلي أن أقول لك ألا تَستَخدم الديناميت في الطبخ؟

91
00:08:28,960 --> 00:08:31,570
.ظَنَنتُ أن الأمر سَيَكون سَريعًا هكذا

92
00:08:32,280 --> 00:08:34,460
.هُناك الكَثير مِن الوقت

93
00:08:34,460 --> 00:08:36,270
لِمَ أنت مُستَعجِل؟

94
00:08:36,860 --> 00:08:39,340
...أعلَمُ هذا، لكن بِطَريقة ما

95
00:08:40,600 --> 00:08:45,000
،لَم أَكُنْ استَطيع الطهو كما أُريد حتى أَتيت إلى هُنا

96
00:08:45,790 --> 00:08:48,460
لِذا دائمًا ما أُسرع دون وعي، ويَنتَهي بي الأمر بِاقتراف الحماقات

97
00:08:49,550 --> 00:08:52,350
يَجب أن أكون قد أعتَدتُ على الأمر الآن؛

98
00:08:52,350 --> 00:08:55,430
.شعور السلام هذا

99
00:08:58,220 --> 00:09:00,150
.دَع تَحضير الطعام لي

100
00:09:01,380 --> 00:09:04,490
.يَجب أن تُرَتِب هذه الغرُفة

101
00:09:04,490 --> 00:09:06,590
.نعم

102
00:09:12,460 --> 00:09:13,930
.حَديثنا يَنتَهي هُنا

103
00:09:14,490 --> 00:09:15,260
...حسنٌ إذن

104
00:09:15,800 --> 00:09:17,410
لِمَ أنت مُصر على القتال وحدك؟

105
00:09:17,790 --> 00:09:19,240
لِمَ لا تَطلب مِن أحد المُساعدة؟

106
00:09:19,660 --> 00:09:21,450
.لا أحتاج الحُلفاء

107
00:09:21,970 --> 00:09:23,950
.أنا مَن يَلعب هذه اللُعبة

108
00:09:23,950 --> 00:09:25,710
.كُل ما أحتاج إليه هو قطع لِأستخدمها

109
00:09:26,490 --> 00:09:27,420
!سَأكون حَليفَك

110
00:09:29,850 --> 00:09:31,210
ما مُشكِلَتي؟

111
00:09:33,780 --> 00:09:36,180
شكل القصر قبل أن نَأتي؟

112
00:09:36,660 --> 00:09:37,300
.نعم

113
00:09:38,000 --> 00:09:41,260
.حسنٌ، الوحيد الذي قد يَعلم هذا هو تاناكا سان

114
00:09:45,110 --> 00:09:47,960
.لا فائدة، لا فائِدة مِن السُؤال

115
00:09:47,960 --> 00:09:50,750
.هُناك شخص آخر يَعرف

116
00:09:55,630 --> 00:09:57,740
سَكَن فانتومهايف القَديم؟

117
00:09:58,250 --> 00:10:02,080
نعم. كَيف كان يَبدو القصر قبل أن نَأتي؟

118
00:10:04,010 --> 00:10:05,440
...لِنرى

119
00:10:06,890 --> 00:10:14,570
.والِدا سيل، خالته وحتى سيل كانوا يَضحَكون دائمًا

120
00:10:15,020 --> 00:10:18,260
.سَكن فانتومهايف كَان مُفعم بِالضَحِكات

121
00:10:18,990 --> 00:10:20,760
!هكذا

122
00:10:24,550 --> 00:10:26,990
.سَنَملأ القصر بِالوجوه المُبتَسِمة

123
00:10:26,990 --> 00:10:30,770
.إذا فعلنا ذلك، سَيَبتَهِج السيّد الصَغير

124
00:10:30,770 --> 00:10:33,940
!سَيَكون هذا رائع

125
00:10:36,530 --> 00:10:39,140
...مَن يُمكنه الضحك على شَيء لَيس مُضحك

126
00:10:41,520 --> 00:10:43,040
!هذا مِن أجلِ السيّد الصَغير

127
00:10:43,040 --> 00:10:44,800
.ابتَسِم، بارد سان

128
00:10:44,800 --> 00:10:45,620
!هذا يؤذي

129
00:10:46,090 --> 00:10:47,500
!حسنٌ! حسنٌ

130
00:10:49,040 --> 00:10:50,960
.سَأُساعد أيضًا

131
00:11:08,940 --> 00:11:10,480
ما الذي تَفعَلُه؟

132
00:11:19,820 --> 00:11:21,690
ما معنى هذا؟

133
00:11:23,190 --> 00:11:25,730
.ما زال هُناك بعض الوقت لِلعشاء

134
00:11:25,730 --> 00:11:28,410
.آنسة إلزابيث، يَجب أن تَستَرخي في غُرفَتُك

135
00:11:28,410 --> 00:11:30,450
ما الأمر، سباستيان؟

136
00:11:30,450 --> 00:11:31,620
.إلزابيث ساما

137
00:11:36,950 --> 00:11:39,200
.أعلَم. يَجِب أن ابتسم

138
00:11:42,110 --> 00:11:44,010
.مِن هُنا من فضلك

139
00:11:47,270 --> 00:11:49,390
.حسنٌ، جَميعًا. اعتمد عليكم

140
00:11:57,540 --> 00:11:58,900
...حسنٌ، الآن

141
00:12:24,800 --> 00:12:25,810
!سيل

142
00:12:25,810 --> 00:12:27,330
كَيف حالك؟

143
00:12:29,820 --> 00:12:32,450
إلزابيث؟ متى وصَلتي؟

144
00:12:32,450 --> 00:12:34,150
.إن كُنتِ سَتَقومين بِزيارة، يَجب أن تُرسِلي رسالة أولاً

145
00:12:34,400 --> 00:12:37,460
أرسُل رسالة في كُل مرّة أرغَبُ فيها برؤية خطيبي؟

146
00:12:37,460 --> 00:12:39,440
.عَلِمني الشِطرَنج

147
00:12:40,010 --> 00:12:40,690
شِطرنج؟

148
00:12:41,170 --> 00:12:41,970
.هذا صَحيح

149
00:12:41,970 --> 00:12:47,070
.مِن الطَبيعي لِسيّدة أن تَعرف الشطرنج" هذا ما تَقوله أمي"

150
00:12:47,570 --> 00:12:49,760
.لكن لا يُمكنني تَذَكُر شيء

151
00:12:50,170 --> 00:12:52,710
.ولا يُمكن الإفادة مِن باولا

152
00:12:53,180 --> 00:12:56,000
.أنت الوحيد الذي يُمكنه مُساعَدَتي

153
00:12:56,530 --> 00:12:58,300
أرجوك؟

154
00:13:00,500 --> 00:13:01,190
.عُذرًا

155
00:13:02,740 --> 00:13:03,470
.سباستيان

156
00:13:04,270 --> 00:13:04,840
نعم؟

157
00:13:05,480 --> 00:13:06,800
.جَهِز لوح الشطرنج

158
00:13:07,600 --> 00:13:09,260
.حاضر، سيّدي

159
00:13:24,490 --> 00:13:27,280
هدف اللُعبة أن تَقومي بِكش ملك على الخصم

160
00:13:27,280 --> 00:13:32,580
.بِتَحريك القطع التي لَدَيكِ، واحدة بعد الأُخرى، على لوح مِن 64 مُربع

161
00:13:39,520 --> 00:13:40,130
...أنت

162
00:13:40,650 --> 00:13:41,800
لِمَ تَفعل هذا؟

163
00:13:42,290 --> 00:13:44,010
أليس رائعًا؟

164
00:13:52,320 --> 00:13:52,850
ما هو؟

165
00:13:53,390 --> 00:13:56,640
.مضى وقت طَويل مُنذ أن أمضَينا وقت مع بعضنا فقط

166
00:14:00,010 --> 00:14:01,150
.ها أنا

167
00:14:01,150 --> 00:14:02,060
.حسنٌ

168
00:14:22,550 --> 00:14:23,630
هل هُناك خطب؟

169
00:14:24,860 --> 00:14:26,650
.لا. لا شيء

170
00:14:40,970 --> 00:14:42,770
ماذا أخبرتَكُم؟

171
00:14:44,150 --> 00:14:45,780
.دِفاعَهُم ضَعيف في هذا المكان

172
00:14:46,380 --> 00:14:48,570
.مِن هُنا سَنَختَرِقَهُم ونَتَقَدم لِأراضيهم

173
00:14:49,200 --> 00:14:50,820
!انتظر! هذا فخ

174
00:14:51,660 --> 00:14:53,360
ما الخطب، أيُّها العَريف؟

175
00:14:53,360 --> 00:14:54,790
هل فقدت أعصابُك؟

176
00:14:55,330 --> 00:14:56,660
!ليس الأمر هكذا

177
00:14:56,660 --> 00:14:58,250
!أعني، لا بُد أن يَكون هُناك طَريقٌ آخر

178
00:14:58,730 --> 00:15:00,830
!اخرَس! تَم تَقرير الأمر

179
00:15:18,760 --> 00:15:20,890
أَلم أقُل لَكُم؟

180
00:15:21,820 --> 00:15:24,100
.أصبح الأمر فوضى عارِمة

181
00:15:25,110 --> 00:15:27,610
.هذا العَمل يَتَجاوز قُدرات الشينيجامي حتى

182
00:15:28,770 --> 00:15:30,540
.قُدرات قتال تُثنى عَليها

183
00:15:31,080 --> 00:15:34,420
.حِسَّك الفطري، الذي يَجعلك تَتَجاوز أيِ فخ، مهما كان قاتلًا

184
00:15:34,420 --> 00:15:36,740
.لَدَيكَ قُدرات واعِدة

185
00:15:37,350 --> 00:15:40,260
هل أنتَ عَدو، أم حَليف؟

186
00:15:42,180 --> 00:15:43,670
.لا هذا ولا ذاك

187
00:15:44,190 --> 00:15:47,090
.أنا مُجرد اكوما

188
00:15:52,080 --> 00:15:55,300
.عُد إلى المَنزِل بِسُرعة وعالج جُرحك، أو سَتَموت حقًّا

189
00:16:07,590 --> 00:16:11,320
.سَأتَأكد مِن أن يَدفع ذلك الفتى الكلب الثمن

190
00:16:11,890 --> 00:16:16,780
.كذلك، سَيَكون مِن السهل إدارة العمل في هذه البلاد دون وجوده

191
00:16:17,330 --> 00:16:21,750
.لا حاجة لِلنُبلاء الأشرار بعد الآن

192
00:16:42,740 --> 00:16:45,910
.سَنَحمي هذا القصر

193
00:16:48,450 --> 00:16:49,830
!يَجب أن ابتسم

194
00:16:49,830 --> 00:16:52,360
!الابتسامات هي أساس بَهجة وفرح السيّد الصَغير

195
00:16:58,910 --> 00:17:00,700
!سـ-ساعِدونا

196
00:17:01,140 --> 00:17:08,500
...لِنرى... فارس، قلعة، بيدق، فيل

197
00:17:08,500 --> 00:17:09,170
صَحيح؟

198
00:17:09,750 --> 00:17:10,550
.نعم

199
00:17:10,550 --> 00:17:12,620
!أَتَذَكَرُهُم

200
00:17:58,930 --> 00:18:00,330
!توقفوا

201
00:18:01,060 --> 00:18:02,360
!دَعوني

202
00:18:01,540 --> 00:18:04,350
!سَيُعطيه هذا قُدرة تَتَجاوز حدود البشر

203
00:18:31,190 --> 00:18:33,340
!ما زِلتَ بِخَير، حتى بعد اصطدامي بِك

204
00:18:34,140 --> 00:18:37,800
.أُريد أن أعرِضَ عَليك عَمل، لِتَستَخدِم قوَّتُك فيه

205
00:18:38,230 --> 00:18:42,260
.راتبٌ اعتيادي، وكذلك المُكافئات الإضافيّة مرّتَين في العام

206
00:18:42,260 --> 00:18:44,160
.لا احتاج كُل هذا

207
00:18:45,160 --> 00:18:45,770
...أنا فقط

208
00:18:52,150 --> 00:18:53,520
!أُريد الخروج

209
00:18:59,110 --> 00:19:02,370
...كم هذا جَميل

210
00:19:15,960 --> 00:19:16,590
!خُذوا هذا

211
00:19:23,950 --> 00:19:26,680
.لِنرى... هذا المَلِك

212
00:19:27,500 --> 00:19:28,580
.نعم

213
00:19:28,580 --> 00:19:29,800
.وهذه المَلِكة

214
00:19:30,210 --> 00:19:32,880
!الشِطرنج لَطيف

215
00:19:34,940 --> 00:19:38,370
...مَلِكَتُك الغاليّة تُخطط لِغَزو اوربا

216
00:19:38,370 --> 00:19:42,180
لا، العالم سَتَجتاحه الحرب

217
00:19:42,730 --> 00:19:48,820
."بدءًا بِغزو فرنسا بِاستخدام الأفيون... أو "السيّدة البيضاء

218
00:19:48,820 --> 00:19:54,210
.نعم، بِنَفس الطَريقة التي قامت فيها بِلادُك بِغَزو بِلادي

219
00:19:56,050 --> 00:19:59,670
هل سَتَبقى كَلب حراسة الملكة ؟

220
00:20:01,300 --> 00:20:05,680
.نعم. سَأكون حَليفُك، سيل كن

221
00:20:06,690 --> 00:20:13,480
.ما زِلت تَملك فُرصة استعادة مُستَقبَلُك

222
00:20:15,190 --> 00:20:19,150
.لا تنسَ هذا

223
00:20:25,450 --> 00:20:28,730
ما خطب موظَفي القصر؟

224
00:20:30,440 --> 00:20:33,030
مِن الطَبيعي لِموظَفي عائلة فانتومهايف

225
00:20:33,030 --> 00:20:35,330
.أن يَكونوا قادرين على فِعل هذا

226
00:20:43,000 --> 00:20:45,380
.سيّدي الصَغير. آنسة إلزابيث

227
00:20:45,810 --> 00:20:49,430
.عُذرًا مِنكُما، يَجب أن أَهتم بِتَجهيزات العشاء

228
00:20:49,940 --> 00:20:50,810
.حسنٌ

229
00:20:50,810 --> 00:20:52,700
.شُكرًا لكن، سباستيان

230
00:20:53,980 --> 00:20:55,400
.لِنَتَوّقف هُنا اليوم

231
00:20:56,410 --> 00:20:57,360
.نعم

232
00:21:00,430 --> 00:21:02,780
.شُكرًا على عَملكم الشاق جَميعًا

233
00:21:14,520 --> 00:21:16,130
.باريس إذن

234
00:21:24,340 --> 00:21:26,840
.يَوم الحساب الحَقيقي سَيَأتي قَريبًا

235
00:21:41,260 --> 00:21:44,180
.حَظيت بيوم استرخاء لأول مرّة منذ أيام

236
00:21:44,180 --> 00:21:46,610
هل غلّفت قلبك بالاكتئاب؟

237
00:21:46,610 --> 00:21:48,570
!لست مُكتَئِب

238
00:22:00,620 --> 00:22:02,210
بِأيِ حالٍ أنتم؟

239
00:22:02,210 --> 00:22:03,420
!اذهَبوا وغَيروا ملابِسَكُم بِسُرعة

240
00:22:03,770 --> 00:22:05,880
!حاضر، سَيّدي

241
00:22:17,770 --> 00:22:19,610
طبق اليوم الرَئيسي

242
00:22:20,280 --> 00:22:22,660
.فيليه دي بويف لا باريسيني

243
00:22:23,260 --> 00:22:26,770
.لحم مشوي على الطَريقية الباريسيّة