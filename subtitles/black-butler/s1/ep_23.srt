1
00:00:06,000 --> 00:00:11,810
.سَكُن فانتومهايف، الذي أَعملُ فيه، يَحتَرِق لِلمرّةِ الثانيّة

2
00:00:11,810 --> 00:00:16,780
.لا أستَطيع سوى تَسجيل هذه الفاجعة التي حَدَثت لِلقصر

3
00:00:17,180 --> 00:00:20,750
...هذا واجبي، لكن

4
00:00:21,700 --> 00:00:24,460
.واجبي قارب على الانتهاء

5
00:00:41,440 --> 00:00:43,730
.الريح قويّة اليوم

6
00:00:43,730 --> 00:00:47,690
.نعم، ودافِئَة بِشكلٍ مُقلق. يَبدو أن هُناك عاصِفة اللَيلَة

7
00:00:47,690 --> 00:00:50,650
.آمل أن نَصِل إلى لندن قَريبًا

8
00:01:00,370 --> 00:01:02,750
.عَثرت عَليك، إيرل

9
00:01:02,750 --> 00:01:04,830
!الـ-الدفّان

10
00:01:15,720 --> 00:01:20,680
.حسنٌ، امسك بي ذلك المتطلب المدعو ويل

11
00:01:21,220 --> 00:01:24,790
،يَبدو أنَّهُ سَيَحتاج الكَثير مِن الأيدي العامِلة في لندن

12
00:01:24,790 --> 00:01:28,640
.لِذا شَدَني بِوعدَه لي بِأن يَتَنازل عن غرامات المَكتَبة التي عَليَّ

13
00:01:28,640 --> 00:01:30,150
منطقة لندن؟

14
00:01:30,150 --> 00:01:36,110
.نعم. يَبدو أن هُناك العَديد مِن الأرواح التي يَجِب حصدها في لَندن الليلة

15
00:01:37,060 --> 00:01:39,320
!انظُر لهِذا! ما الأمر

16
00:01:39,320 --> 00:01:42,000
.يَبدو أن الأمر قد بِدَأ بِالفعل

17
00:01:46,000 --> 00:01:47,180
ما هذا بِحق الجَحيم؟

18
00:01:54,170 --> 00:01:57,800
.يا له مِن عرض

19
00:01:58,210 --> 00:02:00,610
.حان وقت رَحيلي

20
00:02:02,230 --> 00:02:03,140
!انتَظِر

21
00:02:03,590 --> 00:02:06,120
لِمَ أَتَيت إلى هُنا؟

22
00:02:06,120 --> 00:02:09,100
.أنا وأنت ماضينا طَويل مع بعض

23
00:02:09,100 --> 00:02:14,570
:لِذا فكرت بِأن أُعطيك تَحذيرًا

24
00:02:15,050 --> 00:02:18,280
...قريبًا، إيُّها الإيرل

25
00:02:19,960 --> 00:02:21,160
.سَتَموت...

26
00:04:00,190 --> 00:04:02,240
ما الذي تَعنيه...؟

27
00:04:02,240 --> 00:04:05,220
!لا

28
00:04:10,380 --> 00:04:11,310
.سَتَموت

29
00:04:13,550 --> 00:04:17,080
.لَم يَعُد سباستيان بِجواري بعد الآن

30
00:04:17,080 --> 00:04:20,280
إذا كان الأمر هكذا، فَالموت الذي يَنتَظِرني قد أتى

31
00:04:21,530 --> 00:04:23,740
.دون معنى

32
00:04:27,350 --> 00:04:28,660
.إنَّها تَحتَرِق

33
00:04:29,440 --> 00:04:34,210
.آلامي وكراهيَّتي يَحتَرِقان في هذه النيران

34
00:04:36,780 --> 00:04:38,150
.إنَّها تَحتَرِق

35
00:04:48,380 --> 00:04:51,060
إنَّهُ مؤلم، أَليس كذلك؟ أنت تُعاني، صَحيح؟

36
00:04:51,490 --> 00:04:56,070
.عُذرًا، لكن لا يُمكنني تَسهيل موتِك

37
00:05:03,240 --> 00:05:05,270
.كَم سَأكون مَشغولاً

38
00:05:08,050 --> 00:05:09,320
.كَم هذا مُقزِز

39
00:05:12,540 --> 00:05:17,130
.جلالَتُك، خلاص الأرض بِالنِيران المُقَدَسة قد بدأ

40
00:05:17,130 --> 00:05:19,420
.فَهِمت

41
00:05:20,460 --> 00:05:21,960
،أَليس مِن الرائع التَرحيب بِإنجلترا العصر الجَديد

42
00:05:22,600 --> 00:05:27,130
البلاد الفخورة والطاهِرة التي هدفنا لها؟

43
00:05:28,000 --> 00:05:29,300
ألا تَشعُرين بِأنَّكِ بِخَير؟

44
00:05:29,870 --> 00:05:33,870
.لا يَبدو جَسَدُكِ أنَّهُ بِخَير مُنذ عُدنا مِن باريس

45
00:05:33,870 --> 00:05:36,770
هل يُمكنك النَظر إلى هذا مِن فضلك؟

46
00:05:37,260 --> 00:05:38,410
.يؤلم

47
00:05:46,490 --> 00:05:48,070
.يؤلم

48
00:05:48,630 --> 00:05:49,950
.أرجوكِ أُعذُري تَصرُّفي الغَير لائِق

49
00:05:54,810 --> 00:05:56,750
.بِدأ بِالتَقيًّح والتَعَفُن

50
00:06:00,720 --> 00:06:02,950
.أرجوكِ اسمحي لي بِتَطهيرك

51
00:06:02,950 --> 00:06:03,590
!لا

52
00:06:04,660 --> 00:06:08,420
.دع هذا الجَسَد يَبقى مكانه

53
00:06:08,420 --> 00:06:10,720
.دَعه كما كان ذلك اليوم

54
00:06:10,720 --> 00:06:11,780
...لكن

55
00:06:11,780 --> 00:06:14,330
.لا يَحتاج التَطهير

56
00:06:14,330 --> 00:06:16,100
.إنَّهُ رائع كما هو

57
00:06:16,740 --> 00:06:19,530
-أرجوك آش، قُم بِشَيء ما. أَنقـ

58
00:06:19,530 --> 00:06:21,060
.نَتِنة

59
00:06:24,880 --> 00:06:27,190
.أنتِ... غَير طاهِرة

60
00:06:36,130 --> 00:06:38,840
.حتى لو كانت مَلِكة، فَهي بَشر على كُلِ حال

61
00:06:38,840 --> 00:06:41,040
،كم هذا غَبي

62
00:06:41,040 --> 00:06:43,250
.وكم هو مُحزن

63
00:06:43,560 --> 00:06:51,740
كُل دموع هذا البلد المُدمّر بَدأت عندما قسِّم البشر إلى رجال ونساء

64
00:06:52,350 --> 00:06:55,680
،مهما أظهرنا مِن رحمة

65
00:06:55,680 --> 00:06:57,920
.لا يُمكن لِلبشر أن يَكونوا جَيدين كفايّة

66
00:07:00,050 --> 00:07:01,400
...لا يُمكن لِلبشر

67
00:07:02,560 --> 00:07:06,480
،أَلبِرت يَتَداعى

68
00:07:07,010 --> 00:07:10,720
.يَتَداعى، يَتَداعى

69
00:07:11,650 --> 00:07:15,450
،أَلبِرت يَتَداعى

70
00:07:16,300 --> 00:07:19,810
.يا حَبيبي العَزيز

71
00:07:24,230 --> 00:07:25,280
...سَـ

72
00:07:26,220 --> 00:07:27,050
.أموت

73
00:07:27,580 --> 00:07:30,740
...هل سَيَحدث الأمر على مَتن هذه السَفينة، أم

74
00:07:37,960 --> 00:07:39,360
ما الذي تَفعَلُه؟

75
00:07:39,360 --> 00:07:42,580
.لا يُمكننا العودة إلى لَندن في ظِلِ هذه الظروف

76
00:07:42,580 --> 00:07:44,570
-سَنَنتَظِر فَترة ونرى ما سَيَحدُث

77
00:07:44,570 --> 00:07:47,680
!ما الذي تَتَحدث عنه؟ لَندن هُناك

78
00:07:49,610 --> 00:07:50,240
.انسَ الأمر

79
00:07:50,590 --> 00:07:52,490
!سَأُغادر. جَهِزوا قارب

80
00:07:53,290 --> 00:07:55,880
تُريد مِنّا أن نَفعل كُل هذا مِن أجلِ طِفل؟

81
00:07:55,880 --> 00:07:57,700
...سَيَكون الأمر مُختلف لو كُنتَ تَملُك المال

82
00:07:57,940 --> 00:08:01,840
...كُنْ جديًّا يا رَجُل! يَجب أن أَعود إلى لَندن مهما كَلف الأمر

83
00:08:01,840 --> 00:08:03,920
ماذا لو لَم أَعُد؟

84
00:08:07,690 --> 00:08:11,430
.لم أُنهي أمر جلالتها

85
00:08:11,430 --> 00:08:13,840
.لا. لم أَتَمَكَن مِن فِعلها

86
00:08:14,300 --> 00:08:16,500
،لو كان عَليَّ التَخَلُّص مِن كراهيَّتي

87
00:08:16,500 --> 00:08:19,930
.وجودي كان لَانتهى في ذلك اليوم

88
00:08:20,390 --> 00:08:22,190
!لَنْ أكون أنا بعد الآن

89
00:08:22,600 --> 00:08:23,640
سيل؟

90
00:08:24,080 --> 00:08:25,480
.لَنْ أَتَخلّى عن هذه الكراهيّة

91
00:08:26,810 --> 00:08:29,620
!لَنْ أَتَخلّى عن هذه الكراهيّة

92
00:08:31,380 --> 00:08:35,100
.لو فَعلت ذلك، سَيَختَفي وجودي

93
00:08:35,100 --> 00:08:36,070
...إذا كان

94
00:08:36,890 --> 00:08:37,880
...إذا كان الأمر هكذا

95
00:08:39,050 --> 00:08:41,080
من الذي يَقِف هُنا والآن؟

96
00:08:41,500 --> 00:08:45,740
...أيُّها الطفل. أنا مَشغول، لِذا اذهب مِن هُنا

97
00:08:50,320 --> 00:08:52,150
مـ-ما الأمر؟

98
00:08:54,860 --> 00:08:56,150
.خُذ هذا

99
00:08:57,380 --> 00:09:00,350
...ر-رائع! الطَريقة التي يَلمع بِها

100
00:09:00,350 --> 00:09:01,220
.ماسة زرقاء

101
00:09:01,660 --> 00:09:03,840
.شخصٌ مِثلك مِن الصعبِ عَليه أن يراها حتى

102
00:09:03,840 --> 00:09:06,940
لِمَ طفل مِثلك لَديه شيء كهذا؟

103
00:09:07,300 --> 00:09:09,400
!لا يَهُم الأمر. أعطِنيِ قارب تَجذيف فقط

104
00:09:19,030 --> 00:09:20,580
.ها هو

105
00:09:21,110 --> 00:09:22,730
هل أنتَ فَرنسي؟

106
00:09:23,400 --> 00:09:24,350
.اخلع ملابِسُك

107
00:09:24,350 --> 00:09:25,670
دَعني! ما الذي تَفعَلَه؟

108
00:09:26,320 --> 00:09:29,880
!هذه النيران مِن صُنع الفرَنسيين

109
00:09:30,490 --> 00:09:33,840
!يُريدون بِدأ الحرب مع إنجلترا

110
00:09:33,840 --> 00:09:37,620
...مَلِكَتك المحبوبة تَنوي غزو أوروبا

111
00:09:37,620 --> 00:09:40,910
.لا، العالم سَتَجتاحه الحرب

112
00:09:42,060 --> 00:09:44,190
-مهلاً! هذا

113
00:09:45,680 --> 00:09:47,230
!هذا هو، الوغد

114
00:09:47,710 --> 00:09:50,190
!توقفوا! أرجوكم! أرجوكم

115
00:09:55,520 --> 00:09:57,860
ما الذي يَجري هُنا بِحق الجَحيم؟

116
00:10:05,030 --> 00:10:06,040
...هذا

117
00:10:11,000 --> 00:10:11,660
!دَعني

118
00:10:11,660 --> 00:10:13,500
!أعطِني إياها

119
00:10:27,340 --> 00:10:30,040
هل هذا هو الجحيم؟

120
00:10:45,280 --> 00:10:47,280
.ها هو

121
00:10:48,570 --> 00:10:52,230
!عاد ذلك الطفل إلى لندن إذن

122
00:10:52,230 --> 00:10:53,500
.كم هذا  رائع

123
00:10:54,300 --> 00:10:56,780
كَيف هو الأمر؟ هل تُحب المَشهَد؟

124
00:11:08,270 --> 00:11:09,160
!حاذر

125
00:11:15,770 --> 00:11:17,860
ما الذي تَفعَلُه؟

126
00:11:19,720 --> 00:11:21,690
سيّدي الصَغير؟

127
00:11:21,690 --> 00:11:23,570
لِمَ أنت هُنا؟

128
00:11:25,220 --> 00:11:27,360
.أنا آسفة حقًّا

129
00:11:27,360 --> 00:11:29,750
...على الرُغم مِن أن واجبي هو حمايّة القصر

130
00:11:30,100 --> 00:11:31,860
...لكن... لكن... كَيف يُمكنني أن

131
00:11:31,860 --> 00:11:32,790
!تَماسَكي

132
00:11:32,790 --> 00:11:35,210
.لَم أَكُن أوبِخُك، قولي لي ما جرى

133
00:11:37,240 --> 00:11:38,510
...إنَّهُ بلو بلو

134
00:11:39,110 --> 00:11:40,470
بلوتو؟

135
00:11:40,470 --> 00:11:42,120
أيِ تَعليق؟

136
00:11:44,450 --> 00:11:50,890
.مُقارنة بِحَريق لَندن الكَبير في 1666، النيران تَتَحرك بِبُطؤ

137
00:11:51,340 --> 00:11:56,880
،ما أن تَلتَصق الأوساخ والقاذورات في شيء

138
00:11:56,880 --> 00:11:59,860
.سَيَتَطَلب الأمر جُهدًا كَبير مِن أجلِ التَخَلُص مِنهم

139
00:12:00,300 --> 00:12:06,580
،لكن، عندما تَلتَهِم النيران كُل شَيء

140
00:12:06,580 --> 00:12:10,750
.البوابة المُنتَظرة سَتَظهر وتُنظّف البِلاد

141
00:12:11,630 --> 00:12:15,120
.سَأُفتَحُ البوابة لِلعصر الجَديد

142
00:12:16,460 --> 00:12:19,670
.الكِش مَلِك يَقتَرب

143
00:12:20,930 --> 00:12:22,630
،ماذا سَتَكون حَرَكَتُك القادِمة

144
00:12:23,550 --> 00:12:24,590
سيّدي الصَغير؟

145
00:12:52,200 --> 00:12:54,370
.سُحقًا! مُسدس التَهدِئة لا يَعمل

146
00:12:54,790 --> 00:12:55,940
...بلو بلو

147
00:12:55,940 --> 00:13:00,340
هل كانت مُلاحقة بلوتو الشيء الصائِب لِنَقوم بِه؟

148
00:13:00,340 --> 00:13:04,050
.تَم تَعيينُنا لِحمايّة القصر على كُلِ حال

149
00:13:05,320 --> 00:13:07,470
...إن لَم نَتَمكن مِن فِعل أيِ شيء

150
00:13:07,470 --> 00:13:10,480
.ما أُريد حمايَّتُه ليس القصر فقط

151
00:13:11,690 --> 00:13:14,480
،أُريد حمايّة الوجوه المُبتَسِمة

152
00:13:15,200 --> 00:13:17,720
.والأيام السَعيدة التي قَضَيناها في القصر

153
00:13:18,860 --> 00:13:23,410
.لِهذا لا يُمكن أن نَخسر واحد مِنّا

154
00:13:23,410 --> 00:13:24,710
!ولا حتى بلو بلو

155
00:13:29,370 --> 00:13:30,520
!سيّدي الصَغير

156
00:13:32,400 --> 00:13:34,750
ميرين! لِمَ أحضَرتي السيّد الصَغير إلى هُنا؟

157
00:13:35,380 --> 00:13:37,760
.لقد أصر على ذلك

158
00:13:39,050 --> 00:13:40,500
!بلوتو

159
00:13:46,590 --> 00:13:49,970
،قاتَلتَني مِن أجلِ سيّدُك

160
00:13:50,610 --> 00:13:55,940
,مَن كان سَيَتوقع أنَّكَ سَتَكون واقِفًّا بِجانبي الآن مُشاهدًا المشهد المأساوي

161
00:13:56,410 --> 00:14:00,530
.لا أَتَحَرّك دون أوامر سيّدي

162
00:14:00,530 --> 00:14:01,400
،كذلك

163
00:14:02,070 --> 00:14:05,610
،حاليًا، لَيس لَديَّ سيّد لِأُطيع أوامِرُه

164
00:14:08,670 --> 00:14:10,530
:كُنت أٌفَكِر

165
00:14:11,260 --> 00:14:16,460
لا أُمانِع أنضمامُك لي

166
00:14:17,110 --> 00:14:19,790
.في حُكم هذا العالم الجَديد في هذا البلد الطاهر

167
00:14:21,360 --> 00:14:26,010
على الرُغمِ مِن أنّي أصل عدم الطهارة الذي تَحتَقِرُه؟

168
00:14:26,650 --> 00:14:31,550
.إذا كُنت تَنظُر عن كَثَب، كُل شيء يَشِع مِنهُ ضوء ساطع

169
00:14:31,550 --> 00:14:35,480
.الفجر والغسق. الرجل والمرأة. الضوء والظلام

170
00:14:36,150 --> 00:14:39,850
،إذا صُقِلَت هذه الأمور ووحِدَت مع بعضها

171
00:14:40,710 --> 00:14:44,070
.سَتَعود لِلكائن الأولي، والدي العَزيز

172
00:14:44,380 --> 00:14:49,460
تُريد أن تَجعَلَني واحدة مِن دُماك الفاحِشة؟

173
00:14:49,460 --> 00:14:50,320
.لا

174
00:14:53,390 --> 00:14:55,080
،إذا كُنت تُريد

175
00:14:58,390 --> 00:15:02,500
.يُمكنَني أَخذِكَ كَإمرأة

176
00:15:09,520 --> 00:15:11,090
ما الذي تَفعَلونه؟

177
00:15:11,690 --> 00:15:15,520
...نُريد مِن بلو بلو أن يَعود طَبيعيًا

178
00:15:15,520 --> 00:15:16,400
.أنا آسف

179
00:15:16,400 --> 00:15:18,620
...نَفِذَت مِنّا سِهام التَهدِئة

180
00:15:18,620 --> 00:15:20,560
ما الذي تَتَحدث عنه؟

181
00:15:20,850 --> 00:15:22,400
!يَجب أن يَكون لَديك ذَخيرة حيّة

182
00:15:25,840 --> 00:15:28,320
هل تَطلُب مِنّا أن نَقتُل بلو بلو، سيّدي الصَغير؟

183
00:15:28,320 --> 00:15:30,200
.انظروا لِعَينَيه

184
00:15:30,650 --> 00:15:33,070
.لقد خَسِرَ عقله بِالفعل

185
00:15:34,210 --> 00:15:38,620
.ما تروه هُناك لَيس بلوتو الذي تَعرفون، بل مُجرد وحش

186
00:15:38,620 --> 00:15:40,150
...وحش

187
00:15:40,150 --> 00:15:46,580
.أنتم الثلاثة يَجب أن تَعرفوا كم هو بائس

188
00:15:47,070 --> 00:15:48,800
!أن يُسرق مِنكُم فخرَكُم، العَيش دون هَدف واضح

189
00:15:51,830 --> 00:15:54,970
،هذا أمر: بارد، ميرين، فيني

190
00:15:55,350 --> 00:15:57,930
!اقتلوا الكَلب الشيطاني بِأَيديكم

191
00:16:05,570 --> 00:16:06,770
!حاضر سيّدي

192
00:16:24,030 --> 00:16:28,620
لا يَجب أن نَتَوقع أقل من هذا مِن شخصٍ كان يَخدُمه شَيطان؛

193
00:16:28,620 --> 00:16:32,300
.روح باردة، قاسيّة لا يُمكن إنقاذها

194
00:16:32,940 --> 00:16:35,380
...أنا وأنت يَجب حقًّا أن نَنضم لِبعض

195
00:16:39,560 --> 00:16:42,810
إذن، هذه إجابتك؟

196
00:16:43,170 --> 00:16:47,690
.يَبدو أن مَصير الملائِكة والشَياطين أن يَتَواجهوا لِلأبد

197
00:17:01,720 --> 00:17:02,500
!إلى الأمام

198
00:17:05,290 --> 00:17:07,540
.نعم. كُل ما أستَطيع القيام بِه الآن هو المواصَلة

199
00:17:07,930 --> 00:17:09,460
...إن كُنت سَأموت

200
00:17:10,370 --> 00:17:13,520
،إذن سَأموت كَروح يَرغَب بِها

201
00:17:13,520 --> 00:17:17,830
...هذا ما يُمكنني فِعلُه مِن أجلِ فخري

202
00:17:25,890 --> 00:17:29,780
.أنا الإيرل فانتومهايف، سيل فانتومهايف

203
00:17:29,780 --> 00:17:31,690
...أرغب بِرؤيّة المَلِكة

204
00:17:49,540 --> 00:17:51,390
.الوقت تَوقف

205
00:17:52,250 --> 00:17:53,310
فخ؟

206
00:17:54,080 --> 00:17:55,170
!لا وقت لِهذا

207
00:18:10,720 --> 00:18:11,690
!جلالَتُكِ

208
00:18:23,960 --> 00:18:24,800
ما الأمر؟

209
00:18:24,800 --> 00:18:25,450
!دَخيل

210
00:18:26,540 --> 00:18:27,570
...أنت

211
00:18:28,280 --> 00:18:30,420
!جلالَتُها

212
00:18:31,350 --> 00:18:32,990
!تَم قَتل المَلِكة

213
00:18:32,990 --> 00:18:35,380
الفاعل... مَن الفاعل؟

214
00:18:35,760 --> 00:18:37,570
ما اسم الفاعل؟

215
00:18:42,580 --> 00:18:47,270
.أنا فانتومهايف، سيل فانتومهايف

216
00:18:47,600 --> 00:18:51,730
فانتومهايف؟ هل وضع كَلب حراسة المَلِكة أنيابُه على سيّده؟

217
00:18:52,040 --> 00:18:53,860
.لقد خَسِرت هذا الاسم بِالفعل

218
00:18:53,860 --> 00:18:56,360
.بِالإضافة، لَم يَكُنْ أنا مَن قَتَل المَلِكة

219
00:18:56,870 --> 00:18:58,820
هل تَظُنْ أنَّكَ تَستَطيع إخراج نفسك من هذا بِالكلام فقط؟

220
00:18:59,790 --> 00:19:03,380
،في الواقع، لا أستَطيع غالبًا، لكن

221
00:19:03,380 --> 00:19:06,750
!لا يُمكنني التَوقف هُنا

222
00:19:12,340 --> 00:19:14,290
...دَمي

223
00:19:14,290 --> 00:19:18,420
.لَنْ تَتَمكن مِن العبور خِلال أبواب السماء

224
00:19:18,830 --> 00:19:22,100
هل تَرغب بِعقدٍ مَعي؟

225
00:19:22,100 --> 00:19:23,970
...موتي

226
00:19:25,140 --> 00:19:27,670
...روحي

227
00:19:34,700 --> 00:19:37,110
.لا تَجعَلني أضحك

228
00:19:45,500 --> 00:19:47,200
لَن يَنتَهي

229
00:19:47,920 --> 00:19:48,800
!الأمر هُنا

230
00:19:50,390 --> 00:19:52,880
.إذن، لقد استَيقَظت، سيّدي الصَغير

231
00:19:57,660 --> 00:19:58,710
!أطلِقوا

232
00:20:13,400 --> 00:20:15,110
...سباستيان

233
00:20:16,050 --> 00:20:18,070
.الأمر كما قُلت تمامًا

234
00:20:19,730 --> 00:20:22,410
.لَنْ يَنتَهي الأمر هُنا

235
00:20:32,340 --> 00:20:37,120
.سيّدي الصَغير، أرجوك سَامحني على تَركي لَك دون إذن

236
00:20:37,410 --> 00:20:39,130
ما الذي كُنتَ تَفعَلُه؟

237
00:20:40,500 --> 00:20:42,840
.أُجَهِز لِلعشاء الأخير

238
00:20:44,430 --> 00:20:48,040
.في بعض الأحيان، هو حلو، ساخن، وحامض

239
00:20:48,040 --> 00:20:51,390
.باستِخدام توابل مُنوَّعة لِتَحسين النكهة

240
00:20:55,200 --> 00:21:00,570
.بِفضلك ، يَبدو أنّي سَأستَمتِعُ بِأندر روح، وأندر عشاء

241
00:21:02,880 --> 00:21:04,070
:هذا أمر

242
00:21:04,070 --> 00:21:06,530
!خُذني لِلملاك البربري

243
00:21:07,250 --> 00:21:07,990
.كما تَأمُر

244
00:21:17,130 --> 00:21:18,340
...إنَّهُ لَيس بِبَشَري

245
00:21:22,060 --> 00:21:24,010
،بِالطبع

246
00:21:24,580 --> 00:21:27,890
.فَأنا اكوما

247
00:23:02,180 --> 00:23:02,880
...هؤلاء

248
00:23:03,440 --> 00:23:05,680
،إذا قاتل الخَدَم بِجديّة

249
00:23:05,680 --> 00:23:09,820
.سَتَكون فُرَصَهُم ضِد بلوتو مُتساويّة

250
00:23:09,820 --> 00:23:11,820
.في كِلا الحالَتَين

251
00:23:12,950 --> 00:23:18,480
،سَأُقابل الطرف الخاسر في الجَحيم

252
00:23:19,020 --> 00:23:20,370
.قَريبًا الآن

253
00:23:41,990 --> 00:23:43,630
...إنَّهُ يَتَجمّع فيَّ

254
00:23:43,630 --> 00:23:48,590
.اليَأس الغير طاهر الذي يَتَحوّل لِأملٍ مُقدّس

255
00:23:51,240 --> 00:23:54,030
.يُعطي الأمر شعور رائع