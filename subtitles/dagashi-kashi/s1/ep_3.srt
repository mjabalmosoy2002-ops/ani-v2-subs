1
00:01:36,130 --> 00:01:39,330
هذا سيّء، يبدو وكأنّه على وشك أن يتعطّل

2
00:01:40,490 --> 00:01:42,660
ياله من حظ

3
00:01:42,660 --> 00:01:44,120
و في هذا اليوم تحديدًا

4
00:01:44,120 --> 00:01:46,120
أحدُ أحرّ أيّام الصيف

5
00:01:49,540 --> 00:01:52,510
اوه، هوتارو-سان، أهلًا بك

6
00:01:52,510 --> 00:01:54,470
إنّ اليوم حارٌّ أيضًا، صحيح؟

7
00:02:01,260 --> 00:02:03,850
آه...هوتارو-سان؟

8
00:02:11,980 --> 00:02:13,280
!لماذا قمتِ بإطفائه؟

9
00:02:18,530 --> 00:02:20,410
...هل هذا

10
00:02:20,410 --> 00:02:25,410
الوجبة الخفيفة المثاليّة لإسترجاعِ جهدك ولقهرِ حرارة الصيف

11
00:02:25,410 --> 00:02:29,250
اليوم، لقد جلبتُ لك شيئًا أحبّهُ الأطفال لملء بطونهم به

12
00:02:30,710 --> 00:02:32,250
!بوتامن

13
00:02:32,960 --> 00:02:34,630
...عذرًا، هل تقصدين

14
00:02:34,630 --> 00:02:37,260
!وعلى هذا، تعال

15
00:02:43,100 --> 00:02:44,930
!"مرحبًا، يا "جوز الهند

16
00:02:44,930 --> 00:02:46,430
تو-كن؟

17
00:02:46,430 --> 00:02:47,690
!إذن

18
00:02:56,690 --> 00:02:57,650
إنّ الجوّ حار

19
00:02:57,650 --> 00:02:59,360
لأنّه الصيف

20
00:03:00,780 --> 00:03:04,870
بالمناسبة، تو-كن، هل تعرفُ هوتارو-سان أيضًا؟

21
00:03:05,370 --> 00:03:06,740
لقد حدثت العديد من الأشياء

22
00:03:13,630 --> 00:03:15,760
!لقد كانت عاريّة

23
00:03:15,760 --> 00:03:16,550
عارية؟

24
00:03:16,550 --> 00:03:18,220
!...اوه، لا

25
00:03:18,220 --> 00:03:21,510
!لقد كنتُ سعيدًا لرؤيةِ هوتارو-سان مع أمتعتها مجدّدًا

26
00:03:21,510 --> 00:03:24,060
...و عندما سمعتُ أنّها تأتي إلى هنا لفعل هذه الأمور

27
00:03:24,060 --> 00:03:25,860
أتيتُ أيضًا

28
00:03:25,860 --> 00:03:27,920
!تـ-تو-كن، أنفك

29
00:03:27,920 --> 00:03:30,020
!هوتارو-سان، فلنشغّل المكيّف مجدّدًا

30
00:03:30,020 --> 00:03:30,940
!ما ــ؟

31
00:03:30,940 --> 00:03:33,310
!أليس من الواضح أنّه لا يمكننا فعل هذا

32
00:03:33,310 --> 00:03:36,900
!يجبُ علينا أكل بوتامن بينما نتحملُ حرارة الصيف

33
00:03:37,150 --> 00:03:38,460
و لكن تو-كن ــ

34
00:03:38,460 --> 00:03:40,660
"لا بأس، يا "جوز الهند

35
00:03:40,660 --> 00:03:45,410
!إنّ أملنا قريب

36
00:03:45,740 --> 00:03:46,950
ما الذّي تتحدّثُ بشأنه؟

37
00:03:46,950 --> 00:03:48,410
!على أيّ حال، لا تقلق بشأني

38
00:03:50,580 --> 00:03:52,580
و أخيرًا الماء يغلي

39
00:03:52,580 --> 00:03:53,590
!جيّد

40
00:03:53,590 --> 00:03:56,170
بوتامن أيضًا يأتي بعدّة نكهاتٍ مختلفة

41
00:03:56,170 --> 00:04:00,180
تونكوتسو، صويا، تانشيو، الكاري، وحتّى الياكسوبا

42
00:04:00,880 --> 00:04:03,800
!ولكن بالنسبة لي، أنا أفضّلُ الـ تونكوتسو بعد كلّ شيء

43
00:04:03,800 --> 00:04:08,520
إنّ الـ بوتامن أبهض قليلًا مقارنةً مع بقيّةِ الحلويّاتِ الأخرى

44
00:04:08,520 --> 00:04:12,400
،وبما أنّ مصروف الأطفالِ محدود

45
00:04:12,400 --> 00:04:18,820
فإنّهم يتردّدون حول النكهات المختلفة للـ بوتامن ولكن بدون المخاطرة
في هدرِ أموالهِم على النكهات غير المعروفة والتّي قد لا تعجبهم

46
00:04:18,820 --> 00:04:23,660
،"و لهذا فإنّهم يختارون جميعًا الـ" تونكوتسو
النكهة المجرّبة والشهيّة في نهاية المطاف

47
00:04:25,300 --> 00:04:26,660
...هاي، تو-كن

48
00:04:27,240 --> 00:04:31,000
ألا تعتقدُ أنّ الحرارة قد تجاورت مستوى تحمّل الإنسان؟

49
00:04:31,370 --> 00:04:32,660
...قد تكون صحيحًا

50
00:04:33,660 --> 00:04:35,540
!ولكن لقد إقترب الوقت

51
00:04:35,540 --> 00:04:36,590
هاه؟

52
00:04:37,800 --> 00:04:45,010
عندما أفكّر في أنّه يوجد العديد من الأشخاص الآخرين من كلّ أنحاء اليابان
و الذّين يتشاركون نفس تجربة إختيار نكهةِ الـ "تونكوتسو" ، أشعرُ بالتحمّس

53
00:04:45,010 --> 00:04:47,890
!وكأنّنا نتشاركُ جميعًا برابطة الـ بوتامن تونكوتسو

54
00:04:47,890 --> 00:04:49,470
!هذا صحيح

55
00:04:49,470 --> 00:04:50,850
أليس كذلك؟

56
00:04:54,190 --> 00:04:55,650
إنّ الجوّ حار

57
00:05:00,650 --> 00:05:02,070
!لقد جهز

58
00:05:02,070 --> 00:05:04,030
!ويبدو شهيًّا

59
00:05:11,370 --> 00:05:13,330
!"أنظر، يا "جوز الهند

60
00:05:13,330 --> 00:05:14,710
ماذا؟

61
00:05:16,290 --> 00:05:19,920
!هذا هو أملنا

62
00:05:29,560 --> 00:05:33,180
!لتجاوز هذا اليوم الحارّ، عليك بالـ بوتامن الحارّ

63
00:05:34,350 --> 00:05:36,810
يا "جوز الهند" ، أليس هذا هو الأفضل؟

64
00:05:36,810 --> 00:05:37,520
أجل

65
00:05:37,520 --> 00:05:42,900
على الأرجح أنّ تناول بوتامن في هذه الشروط هي أفضلُ طريقةٍ لذلك

66
00:05:42,900 --> 00:05:44,030
إنّك محقٌّ تمامًا

67
00:05:45,360 --> 00:05:46,830
شكرًا على الطعام

68
00:05:47,880 --> 00:05:49,600
إيندو-كن، إنّ أنفك ينزف

69
00:05:52,350 --> 00:05:53,360
تفضّلا

70
00:05:53,360 --> 00:05:56,070
هذه حصّتكما، كوكونوتسو-كن وإيندو-كن

71
00:05:56,070 --> 00:05:58,250
سنتناولها نحنُ أيضًا إذن

72
00:05:58,250 --> 00:05:59,780
!بالتأكيد

73
00:06:00,520 --> 00:06:03,260
!هيّا، إنّها شهيّة

74
00:06:20,430 --> 00:06:22,150
... "يا "جوز الهند

75
00:06:22,940 --> 00:06:26,440
أنا آسف، ولكن سأذهبُ قبلك

76
00:06:28,150 --> 00:06:29,110
!تو-كن؟

77
00:06:29,110 --> 00:06:31,820
ألا تعتقدين أنّه يجبُ علينا تشغيل المكيّف، هوتارو-سان؟

78
00:06:31,820 --> 00:06:32,450
!ما ــ؟

79
00:06:33,080 --> 00:06:34,070
!مستحيل

80
00:06:34,070 --> 00:06:36,930
كما قلتُ سابقًا، يجب علينا إحتمال حرارة الصيف وأكل ــــــ

81
00:06:36,140 --> 00:06:39,130
!ولكن على هذا الحال، ستتلفُ جميعُ الحلويّات الموجدةِ هنا -

82
00:06:44,510 --> 00:06:46,340
كما هو متوقّعٌ منك، كوكونوتسو-كن

83
00:06:46,340 --> 00:06:49,010
و لكن كنتُ أعلمُ أنّ ذلك منذ البداية

84
00:06:49,340 --> 00:06:51,760
لقد نسيتْ ذلك كليًّا

85
00:07:00,020 --> 00:07:01,150
لقد تعطّل المكيّف

86
00:07:01,150 --> 00:07:02,070
!ماذا؟

87
00:07:02,070 --> 00:07:04,030
!ما الذّي ستفعله بشأنِ الحلويّات؟

88
00:07:06,400 --> 00:07:07,490
!حسنًا

89
00:07:08,030 --> 00:07:10,370
!نحنُ لا ملكُ خيارًا آخر، فلنذهب جميعًا للمسبح

90
00:07:10,370 --> 00:07:11,570
!هاه؟

91
00:07:11,830 --> 00:07:14,580
!سأتّصل بـ سايا، وسنذهبُ جميعًا للمسبح

92
00:07:15,450 --> 00:07:16,620
المسبح؟

93
00:07:20,160 --> 00:07:21,080
!إذن

94
00:07:24,040 --> 00:07:25,590
... "يا "جوز الهند

95
00:07:25,590 --> 00:07:28,370
!وأخيرًا ستتسنّى لنا فرصةُ رؤية الفتيات في زيّ السباحةِ

96
00:07:28,370 --> 00:07:30,990
!اوه، تو-كن، هذا ما كنت تقوله منذ أن وصلنا إلى هنا

97
00:07:30,990 --> 00:07:34,070
!"من الواضحِ أنّك متحمّسٌ للأمرِ أنت أيضًا، يا "جوز الهند

98
00:07:34,070 --> 00:07:36,100
أحقًّا؟

99
00:07:36,930 --> 00:07:38,770
!حسنًا

100
00:07:44,520 --> 00:07:47,040
لا يوجدُ أيّ أحدٍ هنا، تو-كن

101
00:07:47,040 --> 00:07:49,310
كلاّ، فلنعد للبيت فحسب

102
00:07:49,310 --> 00:07:51,280
!اوه، لا داعي لأن تشعر بالإحباطِ لهذه الدرجة

103
00:07:51,280 --> 00:07:54,060
!ولكن لا يوجد مغزى من البقاء في المسبحِ الآن

104
00:07:54,060 --> 00:07:56,010
!أنا عائدٌ للبيت

105
00:07:55,150 --> 00:07:56,390
!إنتظر، تو-كن -

106
00:07:56,390 --> 00:07:58,430
!لقد قطعنا كلّ تلك الطريقِ إلى هنا

107
00:07:59,880 --> 00:08:01,300
!هاي، أنتم

108
00:08:01,300 --> 00:08:03,500
!توقّفوا عن العبثِ في أرجاء المسبح

109
00:08:03,500 --> 00:08:04,790
...هذا صوت

110
00:08:04,790 --> 00:08:07,300
!سيكون الأمرُ خطيرًا، إن وقعتم

111
00:08:07,860 --> 00:08:08,590
أبي؟

112
00:08:10,090 --> 00:08:12,010
!لماذا أنتما هنا؟

113
00:08:12,010 --> 00:08:13,800
!هذا ما أريدُ سؤاله

114
00:08:15,760 --> 00:08:17,180
...أنا، كما تعلم

115
00:08:17,180 --> 00:08:21,440
...إمتلاكُ متجر للحلويّاتِ فحسب لا يجلبُ الكثير من المال، لذا

116
00:08:23,020 --> 00:08:24,560
لقد فهمت، صحيح؟

117
00:08:24,560 --> 00:08:28,190
و مع ذلك، ترك ولدي المتجر لوحده وأتى إلى هنا لللعب

118
00:08:28,190 --> 00:08:29,860
...لا، ذلك لأنّ المكيّف

119
00:08:30,610 --> 00:08:32,610
هذا أسوء وضع

120
00:08:32,990 --> 00:08:36,030
أنا....أنا آسف

121
00:08:36,030 --> 00:08:38,370
إذن، هل بإمكانك الإعتناء بالمتجر غدًا أيضًا؟

122
00:08:38,370 --> 00:08:40,160
...حسنٌ، ذلك

123
00:08:40,160 --> 00:08:42,080
ماذا؟ العمّ؟

124
00:08:42,080 --> 00:08:44,210
!مرحبًا سايا-تشان! لقد مضى وقتٌ طويل

125
00:08:44,210 --> 00:08:45,380
!أهلًا بك

126
00:08:45,380 --> 00:08:46,840
ما الذّي يجري؟

127
00:08:46,840 --> 00:08:48,470
إنّكَ متحمّسٌ للغاية

128
00:08:48,470 --> 00:08:52,870
!حسنًا، لقد قال كوكونوتسو بأنّه سيعتني بالمتجر غدًا أيضًا

129
00:08:52,870 --> 00:08:55,510
!إنّ العمّ سعيد، سعيدٌ للغاية

130
00:08:56,090 --> 00:08:58,710
سايا-تشان، يمكنكِ تجاهله فحسب

131
00:08:58,710 --> 00:09:00,330
اوه، حسنٌ

132
00:09:00,330 --> 00:09:02,650
اوه، بالمناسبة، أين هي هوتارو-سان؟

133
00:09:03,780 --> 00:09:05,650
أم تكن معكِ يا سايا-تشان؟

134
00:09:05,650 --> 00:09:06,360
كلاّ

135
00:09:08,080 --> 00:09:11,440
!"سنرى هوتارو-سان في زيّ سباحتها، يا "جوز الهند

136
00:09:13,650 --> 00:09:17,990
أخي الغبيّ، إن قمت بفعلِ أيّ شيءٍ غريبٍ لـ هوتارو-سان
أنت تدري ما سيحدثُ، صحيح؟

137
00:09:17,990 --> 00:09:19,080
أجل

138
00:09:20,540 --> 00:09:24,330
لقد حان الوقت تطهير المسبح

139
00:09:24,330 --> 00:09:25,830
أعتمدُ عليكِ في ذلك

140
00:09:25,830 --> 00:09:26,710
!حاضر

141
00:09:31,770 --> 00:09:33,380
!اوه، هوتارو-تشان

142
00:09:39,210 --> 00:09:40,760
!سايا-شي

143
00:09:40,760 --> 00:09:43,120
تلك السترة تعيقُ النظر

144
00:09:43,120 --> 00:09:44,940
لقد أتيتِ إذن

145
00:09:44,940 --> 00:09:45,520
أجل

146
00:09:48,940 --> 00:09:51,190
إنّ الخطّة تسيرُ بشكلٍ جيّد، هوتارو-تشان

147
00:09:52,690 --> 00:09:54,030
أجل، يو-سان

148
00:09:54,570 --> 00:09:55,740
!ماذا؟

149
00:09:55,740 --> 00:09:57,740
!كوكونوتسو والآخرين متوجّهون للمسبح الآن؟

150
00:09:59,490 --> 00:10:00,740
...هكذا إذن

151
00:10:01,290 --> 00:10:05,210
و عندما يرى كوكونوتسو أبيه، سيتفهّم سوء حالتهم الماديّة

152
00:10:05,210 --> 00:10:06,750
....و التّي ستؤدي به لـ

153
00:10:07,540 --> 00:10:09,590
أنا....أنا آسف

154
00:10:10,090 --> 00:10:12,960
و بعدها سيصبح راغبًا في المساعدة بالمتجر

155
00:10:15,510 --> 00:10:16,890
!إنّها خطّةٌ مثاليّة

156
00:10:16,890 --> 00:10:19,140
كما هو متوقّعٌ من إبنةِ عائلة شيداري

157
00:10:19,930 --> 00:10:21,560
و لكن هذا ليس كلّ شيء

158
00:10:24,270 --> 00:10:25,810
!إذن، يمكنكم الدخول

159
00:10:25,810 --> 00:10:28,190
!"حقًّا؟ لذهب، يا "جوز الهند

160
00:10:28,190 --> 00:10:29,400
!أجل

161
00:10:32,650 --> 00:10:34,320
!سايا-تشان، أسرعِ أنتِ أيضًا

162
00:10:34,320 --> 00:10:36,240
!أجل، أنا قادمة في الحال

163
00:10:36,240 --> 00:10:37,860
إذن، هوتارو-تشان، سأذهبُ قبلك

164
00:10:37,860 --> 00:10:38,740
أجل

165
00:10:38,740 --> 00:10:40,330
!إذهبِ وإستمتعِ

166
00:10:41,280 --> 00:10:43,040
هل تعتقديّن أنّ ذلك سينجح؟

167
00:10:43,040 --> 00:10:44,250
و بدون أيّ فشل

168
00:10:45,080 --> 00:10:47,750
سيعثر عليهم كوكونتسو في لمح البصر

169
00:10:55,920 --> 00:10:57,260
!عذرًا، أبي

170
00:10:57,260 --> 00:11:00,800
!لقد عثرتُ على هلام كوروكوروبو في قاعِ المسبح

171
00:11:00,800 --> 00:11:02,100
ما هذه؟

172
00:11:02,100 --> 00:11:03,310
هل أوقعها شخصٌ ما؟

173
00:11:03,770 --> 00:11:05,600
...اوه، تلك

174
00:11:05,600 --> 00:11:09,900
لقد وضعتها هناك على أملِ أن يستمتع بها الزبناء

175
00:11:10,770 --> 00:11:12,520
إنّها مجرّد هدّيةٍ صغيرةٍ منّي

176
00:11:15,280 --> 00:11:17,320
!يا "جوز الهند" ، لقد عثرتُ على البعضِ منها أنا أيضًا

177
00:11:17,320 --> 00:11:19,670
!أنظر، أنظر، كوكونوتسو

178
00:11:19,670 --> 00:11:21,730
!إنّها جميلةٌ للغاية

179
00:11:21,730 --> 00:11:23,320
!لقد حصلتُ على واحدةٍ زرقاء وأخرى بنفسجيّة

180
00:11:23,320 --> 00:11:25,740
و شكلها لطيفٌ نوعًا ما أيضًا

181
00:11:25,740 --> 00:11:29,460
اوه، تلك بنكهة عصير التفاح والأخرى بنكهة العنب

182
00:11:29,460 --> 00:11:30,870
اوه؟

183
00:11:30,870 --> 00:11:33,330
و توجدُ نكهة مشروب الفانيلا أيضًا

184
00:11:33,790 --> 00:11:36,160
إنتظرِ، سأجدُ واحدةً لكِ

185
00:11:36,160 --> 00:11:38,490
!سأبحث عنها أنا أيضًا

186
00:11:40,570 --> 00:11:46,350
تقتضي خطّتنا في إعطاء كوكونوتسو بعض الحلويّات وتركه يدركُ لوحده
...مدى جمالها وروعتها

187
00:11:46,850 --> 00:11:50,080
!أجدُ أنّه من الصعبِ أن لا أُعجب بكِ، إبنة عائلة شيداري

188
00:11:51,090 --> 00:11:52,350
هذا مثاليّ

189
00:11:54,940 --> 00:11:57,990
مكتوبٌ هناك أنّه يُمنع الأكل والشرب هنا

190
00:11:57,990 --> 00:11:59,490
!هاه؟

191
00:11:59,900 --> 00:12:01,280
ماذا؟

192
00:12:01,280 --> 00:12:03,490
ألا يمكننا تناول هذه الأشياء؟

193
00:12:03,490 --> 00:12:04,870
هذا مؤسف

194
00:12:04,870 --> 00:12:06,740
!لقد أردتُ تناولها

195
00:12:08,960 --> 00:12:11,170
!لقد فشلت الخطّة

196
00:12:17,460 --> 00:12:19,380
!كوكونوتسو-كن، صباح الخير

197
00:12:22,340 --> 00:12:23,680
أهلًا بك، هوتارو-سان

198
00:12:26,970 --> 00:12:28,810
هذا متجر شيكادا للحلويّات، صحيح؟

199
00:12:29,230 --> 00:12:33,730
أجل، إن كنتِ تبحثين عن "جوز الهند" فقد ذهب خارجًا لبعض الوقت

200
00:12:33,730 --> 00:12:35,570
اوه، هكذا إذن

201
00:12:44,320 --> 00:12:46,330
تبدو لي كميّة الحلويّات قليلة

202
00:12:46,330 --> 00:12:52,080
أجل، بعد أن تعطّل مكيّف الهواء، قام بنقلِ بعض الحلويّات التّي كانت
تبدو بأنّها ستتلُف

203
00:12:53,080 --> 00:12:55,710
!هكذا إذن، كما هو متوقّعٌ من كوكونوتسو-كن

204
00:12:55,710 --> 00:12:58,710
إذن، متى سيعود؟

205
00:12:58,710 --> 00:13:00,760
على الأرجحِ قريبًا

206
00:13:00,760 --> 00:13:01,840
هكذا إذن؟

207
00:13:01,840 --> 00:13:03,890
إذن، سأنتظره هنا

208
00:13:03,890 --> 00:13:05,220
حسنٌ، تفضّلِ

209
00:13:12,060 --> 00:13:13,390
بالمناسبة، إيندو-كن

210
00:13:13,940 --> 00:13:14,900
ما الأمر؟

211
00:13:14,900 --> 00:13:17,690
ما هي أكثر حلوى تحبّها؟

212
00:13:19,150 --> 00:13:19,980
حلوى؟

213
00:13:20,280 --> 00:13:21,950
هذا صحيح، حلوى

214
00:13:25,820 --> 00:13:27,950
...حسنًا

215
00:13:28,740 --> 00:13:29,870
لا أدري

216
00:13:31,200 --> 00:13:32,870
لا أدري؟

217
00:13:36,960 --> 00:13:38,420
معرفة عين غزال "؟"

218
00:13:38,420 --> 00:13:40,380
أنا لم أسمع بهذه الحلوى من قبل

219
00:13:40,960 --> 00:13:42,470
ما المشكلة؟

220
00:13:44,300 --> 00:13:45,590
هذا غريب

221
00:13:45,590 --> 00:13:52,100
لقد كان ذلك السؤال تقنيّتي السريّة في الحوار، وعادةً ما أتحصّل على
فكرةً عميقة حول طابع شخصيّة المرء

222
00:13:52,100 --> 00:13:54,810
...اوه، بالمناسبة

223
00:13:55,850 --> 00:13:58,110
هوتارو-سان، ها هي أكثر حلوى تحبّينها؟

224
00:13:58,860 --> 00:14:00,020
أنا؟

225
00:14:00,020 --> 00:14:00,980
هذا صحيح

226
00:14:03,950 --> 00:14:07,410
أنا أحبُّ الحلويّات بحدّ ذاتها

227
00:14:07,410 --> 00:14:10,580
،مع أنّني قد أفضّلُ بعض الأنواعِ على أخرى

228
00:14:10,580 --> 00:14:12,750
و لكن لن أستطيع إختيار واحدةٍ على أخرى

229
00:14:15,460 --> 00:14:17,630
!لقد كان هذا هو الجواب المثاليّ

230
00:14:18,000 --> 00:14:19,290
هكذا إذن

231
00:14:19,290 --> 00:14:21,550
إذن أنتِ تحبّين كلّ الحلويّاتِ قليلًا قليلًا

232
00:14:22,920 --> 00:14:25,090
!أحبّ كلّ الحلويّات قليلًا قليلًا؟

233
00:14:28,340 --> 00:14:31,930
ماذا؟ هل يقوم بإختباري؟

234
00:14:32,560 --> 00:14:35,850
ما الذّي سأفعله؟ ما الذّي سأجيبُ به؟

235
00:14:35,850 --> 00:14:37,190
!اوه، هذا صحيح

236
00:14:37,600 --> 00:14:43,610
لقد ترك لي "جوز الهند" هذه وقال أنّه بإمكاني أكلها

237
00:14:44,070 --> 00:14:45,820
...و لكنّني

238
00:14:47,240 --> 00:14:50,950
لم أتمكّن من نزع الغلاف، هذه مشكلة، صحيح؟

239
00:14:55,750 --> 00:14:56,960
أرأيتِ؟

240
00:14:57,420 --> 00:15:00,960
!ولكنّ الجميع يعلمُ بأنّ هذه حلوى الأرزّ بوتان

241
00:15:01,710 --> 00:15:06,300
و الغلاف مصنوعٌ من ورقِ الأرز، لذا يمكنك أكلهم كما هم

242
00:15:06,300 --> 00:15:09,550
إذن لماذا؟ ما الذّي يحاول فعله بالضبط؟

243
00:15:11,510 --> 00:15:12,310
...هل

244
00:15:12,310 --> 00:15:17,440
يريدُ منّي أن أريهُ الطريقة الصحيحة لأكلِ حلوى الأرز بوتان؟

245
00:15:20,150 --> 00:15:21,480
هكذا إذن

246
00:15:22,520 --> 00:15:28,320
تريدُ أن ترى بنفسك إن كنتُ منافسةً جديرةً لـ كوكونوتسو-كن أم لا، صحيح؟

247
00:15:29,660 --> 00:15:33,330
!أقبل تحدّيك، إيندو-كن

248
00:15:33,330 --> 00:15:34,710
هاه؟ ماذا؟ ماذا؟

249
00:15:34,710 --> 00:15:36,390
تو-كن، آسف على تأخّري

250
00:15:37,480 --> 00:15:40,080
...غلافُ الأرز الخاصّ بقلبك

251
00:15:41,100 --> 00:15:43,090
!سأقوم بنزعه منك...

252
00:15:44,090 --> 00:15:46,050
،أنا لا أفهم ما يحدث

253
00:15:46,710 --> 00:15:48,510
!ولكن، أرني ما لديكِ

254
00:15:52,470 --> 00:15:54,010
!كوكونوتسو-كن

255
00:15:54,010 --> 00:15:56,470
إنتظر هناك قليلًا

256
00:15:57,850 --> 00:15:59,520
!سأنهي الأمر في لحظة

257
00:16:00,150 --> 00:16:03,520
أنا لا أحتاجُ لشرحِ هذا لكَ بالكلمات

258
00:16:03,520 --> 00:16:06,030
...هذا صحيح، سأقدّمُ لكَ ردًّا بسيطًا فحسب

259
00:16:14,200 --> 00:16:16,410
!وأريك الطريقة

260
00:16:18,660 --> 00:16:19,580
!تو-كن؟

261
00:16:24,130 --> 00:16:27,630
في تلك اللحظة، كانت حلوى أرز بوتان التّي بداخلِ فم "تو" تدرو بسرعةٍ هائلة

262
00:16:27,630 --> 00:16:33,680
سرعة الدوران الهائلة والمقترنة بكميّة اللعاب الذّي في فمه
أدّت إلى ذوبانِ الغلاف في لحظة

263
00:16:34,390 --> 00:16:37,470
اوه، تو-كن، هل أنت بخير؟

264
00:16:38,020 --> 00:16:41,690
...أجل، رائحة ونكهة حلوى الأرز بوتان الخافتة

265
00:16:43,060 --> 00:16:45,190
!شهيّة! عملٌ جيّد...

266
00:16:45,480 --> 00:16:49,940
إيندو-كن، هل جرّدتُ قلبكَ من غلافه؟

267
00:16:50,610 --> 00:16:52,700
أجل، وعلى نحوٍ كامل

268
00:16:57,160 --> 00:17:00,210
ما خطبُ هؤلاء الأشخاص؟

269
00:17:00,210 --> 00:17:02,210
!مرحبًا، نحن الكهربائيّون

270
00:17:02,210 --> 00:17:03,710
!اوه، لقد أتوا

271
00:17:04,040 --> 00:17:06,130
اوه، المكيّف إذن

272
00:17:06,130 --> 00:17:07,420
أتريدُ أن أساعدك؟

273
00:17:07,420 --> 00:17:08,710
!أجل، شكرًا

274
00:17:08,710 --> 00:17:10,220
...كوكونوتسو-كن

275
00:17:12,720 --> 00:17:14,550
...من أجل إرجاعِ الحلويّاتِ إلى مكانها بأمان

276
00:17:17,810 --> 00:17:19,720
!سأقرضك قوّتي أنا أيضًا...

277
00:17:20,100 --> 00:17:24,440
اوه، أعتقدُ أنّ الأمر سيصبح أكثر صعوبةٍ مع كثرة الأشخاص

278
00:17:24,440 --> 00:17:25,980
!اوه، هذا صحيح

279
00:17:28,610 --> 00:17:29,980
!أهلًا بكم

280
00:17:29,980 --> 00:17:32,070
!اوه، هوتارو-تشان

281
00:17:32,070 --> 00:17:33,740
مرحبًا، سايا-شي

282
00:17:33,740 --> 00:17:37,660
من النادر قدومكِ في هذا الوقتِ المبكر

283
00:17:37,660 --> 00:17:42,000
أجل، لقد كنتُ في محلّ شيكادا، ولكنّهم مشغولون بالمكيّف

284
00:17:42,830 --> 00:17:44,710
مشغولون بالمكيّف؟

285
00:17:44,710 --> 00:17:45,880
هذا صحيح

286
00:17:45,880 --> 00:17:49,880
لذا، طلب منّي كوكونوتسو-كن القدوم إلى هنا والإنتظار

287
00:17:51,520 --> 00:17:54,910
أنا لا أفهم الأمر جيدًا، ولكن أيًّا يكن

288
00:17:54,910 --> 00:17:55,880
ما هو طلبك؟

289
00:17:55,880 --> 00:17:57,850
!كوبان من القهوةِ المثلّجة

290
00:17:58,970 --> 00:18:00,140
كوبان؟

291
00:18:00,140 --> 00:18:03,770
أجل، تعاليّ إلى هنا ولنشرب معًا، سايا-شي

292
00:18:05,150 --> 00:18:06,230
!أجل

293
00:18:09,400 --> 00:18:13,610
لطالما رغبتُ بالجلوس والتحدّث معكِ يا سايا-شي

294
00:18:13,610 --> 00:18:15,280
أنا أيضًا

295
00:18:15,860 --> 00:18:16,700
هذا جيّد

296
00:18:16,700 --> 00:18:19,950
هنالك أشياء لا يمكنك مشاركتها إلاّ مع الفتيات، صحيح؟

297
00:18:20,240 --> 00:18:22,950
!اوه، حديث فتيات، هذا جيّد، جيّد

298
00:18:24,410 --> 00:18:28,670
سايا-شي، أنتِ تعرفين كوكونوتسو-كن منذ فترةٍ طويلةٍ، صحيح؟

299
00:18:29,170 --> 00:18:30,710
...اوه، أجل

300
00:18:31,460 --> 00:18:33,130
لقد كان ذلك مفاجئًا

301
00:18:33,130 --> 00:18:34,630
ما الذّي تريدُ قوله؟

302
00:18:36,590 --> 00:18:40,050
...هل هذا يعني أنّ هوتارو-سان أيضًا

303
00:18:41,100 --> 00:18:42,770
...و مع ذلك لماذا

304
00:18:44,560 --> 00:18:49,690
!لم أرك تتناولين الحلوى ولا مرّة واحدة سايا-شي؟...

305
00:18:50,520 --> 00:18:52,860
ماذا؟ أهذا ما كنتِ تقصدينه؟

306
00:18:52,860 --> 00:18:54,030
!لماذا؟

307
00:18:54,030 --> 00:18:56,280
...قد تسألينني لماذا، ولكن

308
00:18:57,950 --> 00:19:02,580
!حسنٌ، لقد جلبتُ الحلوى المثاليّةِ لكِ

309
00:19:03,080 --> 00:19:04,080
!هذه

310
00:19:05,460 --> 00:19:06,830
ما هذه؟

311
00:19:08,040 --> 00:19:09,670
جرّبي تناولِ حبّةً واحدةً وحسب

312
00:19:09,670 --> 00:19:12,090
و ستفهمين كلّ شيءٍ عن الحلوى

313
00:19:14,050 --> 00:19:16,050
نيّون سبعة؟

314
00:19:21,430 --> 00:19:23,930
كيف من المفترضِ لي أكلُ هذه؟

315
00:19:26,390 --> 00:19:28,770
!اوه، إنّها متحمّسةٌ للغاية

316
00:19:28,770 --> 00:19:30,900
!إنّها تنظر لي وتتوقّعُ شيئًا منّي

317
00:19:32,070 --> 00:19:35,400
يـ....يجب عليّ أن لا أحبطها

318
00:19:36,610 --> 00:19:39,910
!حسنٌ، أولا يجبٌ عليّ التخلّص من هذا الغلاف

319
00:19:42,330 --> 00:19:45,830
،على الأرجح أنّه يجب أكل ما بداخلها فحسب

320
00:19:46,700 --> 00:19:49,420
!لذا من المحتمل أن تكون هذه هي الطريقة الصحيحة

321
00:19:51,190 --> 00:19:53,330
!لا أعتقدُ ذلك

322
00:19:53,740 --> 00:19:55,200
...سايا-شي

323
00:19:55,200 --> 00:19:56,720
!اوه، إنتظرِ للحظةٍ فقط

324
00:19:57,470 --> 00:19:59,540
هذه طريقةٌ خاطئة

325
00:19:59,540 --> 00:20:00,470
...إذن

326
00:20:04,890 --> 00:20:06,890
!سأمزّقها بفمي

327
00:20:07,390 --> 00:20:09,890
!سايا-شي! لقد كان ذلك مثاليًّا

328
00:20:09,890 --> 00:20:12,270
!لا توجد طريقةٌ أفضل من هذه، إنّها مثاليّة

329
00:20:12,270 --> 00:20:14,020
حقًّا؟

330
00:20:14,020 --> 00:20:15,940
!لقد مزّقتها بطريقةٍ رائعة

331
00:20:17,190 --> 00:20:22,030
و لكن، أتعلمين، إن كانت هذه الطريقةُ الصحيحةُ لأكلها، أعتقدُ أنها طريقةٌ صعبةٌ للغاية

332
00:20:22,030 --> 00:20:24,660
من الجيّد أنّكِ لاحظتِ ذلك

333
00:20:24,660 --> 00:20:30,120
في الأصل، جاذبيّة الحلويّات تكمنُ في أنّها زهيدة وسهلة الأكل

334
00:20:30,120 --> 00:20:33,920
لكن، وكنتيجةٍ لذلك، يتمّ إستهلاكها بسرعة

335
00:20:33,920 --> 00:20:38,420
،من المحبطِ لطفلٍ شراءُ بعض الحلوى بمصروفه المحدود

336
00:20:38,420 --> 00:20:40,430
لتنتهي في لحظةٍ واحدة

337
00:20:41,720 --> 00:20:46,220
ما أقصده هو أنّ القدرة على الإستمتاع بكمّيةٍ قليلة لفترةٍ طويلة

338
00:20:46,220 --> 00:20:50,140
شرطٌ وجزءٌ مهمّ في الحلويّات

339
00:20:51,310 --> 00:20:53,860
!مـ-مذهل

340
00:20:53,860 --> 00:20:55,440
!هذا مذهل، هوتارو-تشان

341
00:20:55,730 --> 00:20:59,110
!إنّكِ تبدين مثل أولئك الذّين يظهرون في برامج الإشهارات بالتلفاز

342
00:20:59,110 --> 00:21:00,700
!إنّكِ رائعة

343
00:21:00,700 --> 00:21:01,950
أ-أحقًّا؟

344
00:21:02,410 --> 00:21:04,570
هل تعلمين أيّ شيءٍ آخر؟

345
00:21:05,450 --> 00:21:07,450
!إذن، سأخبركِ بشيءٍ مميّز

346
00:21:08,580 --> 00:21:12,620
إسمها نيون سبعة ولكن توجد حروف أبجديّة على الغلاف، صحيح؟

347
00:21:12,620 --> 00:21:13,670
!أجل

348
00:21:14,920 --> 00:21:18,670
بمجموع ثماني حروف "H"إلى"A" تبدأ من

349
00:21:19,010 --> 00:21:20,670
ما الذّي يعنيه ذلك؟

350
00:21:21,170 --> 00:21:22,630
...ذلك

351
00:21:22,630 --> 00:21:24,550
!لا تعني أيّ شيءٍ على ما يبدو

352
00:21:24,550 --> 00:21:26,510
هاه؟ لا تعني أيّ شيء؟

353
00:21:26,510 --> 00:21:28,970
،توجد في الأصل ثماني حروفٍ مكتوبةٌ عليها

354
00:21:28,970 --> 00:21:32,100
"و مع ذلك إسمها نيون" سبعة

355
00:21:32,100 --> 00:21:35,060
اوه، هذا غير منطقيّ

356
00:21:35,060 --> 00:21:36,770
على ما يبدو أنّها هكذا وحسب

357
00:21:36,770 --> 00:21:39,320
!أحقًّا؟ غير ممكن

358
00:21:41,150 --> 00:21:43,140
!"أراك لاحقًا، يا "جوز الهند

359
00:21:43,140 --> 00:21:43,990
!أجل

360
00:21:47,050 --> 00:21:47,720
هاه؟

361
00:21:47,720 --> 00:21:51,750
هذا صحيح، هوتارو-سان لم تأتي منذ ذلك الوقت

362
00:21:52,110 --> 00:21:53,930
و ذلك كلّ ما في الأمر

363
00:21:53,930 --> 00:21:55,340
!مذهل

364
00:21:55,340 --> 00:21:57,590
!هوتارو-تشان، أنتِ تعرفين كلّ شيء

365
00:21:57,880 --> 00:22:01,050
!أجل، أنا أعلم كلّ شيء

366
00:22:01,050 --> 00:22:02,090
...إذن، ماذا عن

367
00:22:08,030 --> 00:22:09,460
حسنًا، أيًّا يكن

368
00:23:40,440 --> 00:23:44,610
سايا-شي، دعيني أخبركِ عن السرّ الذي وراء لذّةِ بوتامن

369
00:23:44,610 --> 00:23:45,110
!حسنٌ

370
00:23:45,110 --> 00:23:48,980
،أوّلًا، السرّ يختلف من نكهةٍ لأخرى

371
00:23:48,980 --> 00:23:51,720
و لكن يوجد سرّ واحدٌ مشتركٌ بين جميع النكهات

372
00:23:51,720 --> 00:23:55,880
و يكمنُ ذلك السرّ في الحساء الذّي يحتوي على
اللحم والسمك والمعكرونة

373
00:23:55,880 --> 00:24:00,960
!ممزوجةٌ مع التوابل التّي تمّ طحنها وغليها من أجل أن تكون شهيّة

374
00:24:00,960 --> 00:24:03,760
بالرغم من أنّ الطريقة التّي تمّ مزجها مع بعضها هي سرٌّ في الحدّ ذاته

375
00:24:03,760 --> 00:24:06,010
!هاه؟ إنّها مليئة بالأسرار

376
00:24:06,010 --> 00:24:06,630
بالفعل

377
00:24:06,630 --> 00:24:09,840
!وقد يكون هذا هو السرّ الذّي وراء لذّتها