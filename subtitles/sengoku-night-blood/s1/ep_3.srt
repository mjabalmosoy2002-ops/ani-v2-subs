...أنتما

211
00:12:15,290 --> 00:12:16,960
!أيّتها الغبيّة، تلك خليّة نحل

212
00:12:18,220 --> 00:12:20,480
!احذري أين تمشين

213
00:12:26,000 --> 00:12:27,320
.أنتما في حالة بالية

214
00:12:27,320 --> 00:12:29,890
.أحسنت العمل يا ماساكاغي

215
00:12:29,890 --> 00:12:34,110
ستترك أثرًا على رسغ يوزوكي-سان
.إن أمسكته بشدّة

216
00:12:36,030 --> 00:12:38,670
ما هو شعور لمس بشرة
امرأة للمرّة الأولى؟

217
00:12:44,070 --> 00:12:45,570
!سأذهب لتصفية ذهني

218
00:12:44,890 --> 00:12:47,570
.سيعود حتمًا عندما يجوع

219
00:12:51,070 --> 00:12:53,480
كيف هذا يا ماسانوبو-سان؟

220
00:12:54,060 --> 00:12:54,860
...آه

221
00:12:55,180 --> 00:12:58,250
.لنرَ... أنا سأكمل الباقي

222
00:12:59,170 --> 00:13:01,310
.شكرًا لك على مساعدتي

223
00:13:01,820 --> 00:13:02,990
.ماسانوبو-سان

224
00:13:04,040 --> 00:13:07,350
أنا آسفة، ولكن هل يمكنك
أن تُريني مرّة أخرى؟

225
00:13:08,690 --> 00:13:10,620
.أريد المساعدة جيّدًا

226
00:13:13,690 --> 00:13:14,900
.تعجبني عينيك

227
00:13:15,200 --> 00:13:18,230
.أحبّ رؤية عينيك مليئتين بالإصرار

228
00:13:19,230 --> 00:13:20,030
.حسنًا

229
00:13:20,350 --> 00:13:23,070
.ولكن قد لا أكون لطيفًا للغاية

230
00:13:23,390 --> 00:13:24,320
ألا بأس بذلك؟

231
00:13:25,370 --> 00:13:26,240
.نعم

232
00:13:31,230 --> 00:13:33,440
.شكرًا لك. أبليتِ حسنًا

233
00:13:33,970 --> 00:13:35,880
.هذا بفضلك

234
00:13:36,420 --> 00:13:37,770
.شكرًا لك على ذلك

235
00:13:37,770 --> 00:13:39,160
.ارتاحي هنا قليلًا

236
00:13:39,160 --> 00:13:40,050
.حسنًا

237
00:13:40,050 --> 00:13:41,440
.شكرًا جزيلًا لك

238
00:13:42,820 --> 00:13:45,650
.آمل أن يأتي الدواء بمنفعة

239
00:13:46,380 --> 00:13:47,180
.يوزوكي

240
00:13:55,350 --> 00:13:57,520
إنّها كعكة رز مع دقيق
.فول الصويا والعسل

241
00:14:00,410 --> 00:14:01,920
.إنّها لذيذة للغاية

242
00:14:01,920 --> 00:14:02,720
أليس كذلك؟

243
00:14:04,810 --> 00:14:07,730
لماذا تركتَ مكمّلاتك في ذلك المكان؟

244
00:14:09,460 --> 00:14:13,840
تلك الحبوب تعمل بشكلٍ
.رائع، ولكنّها مُرّة جدًّا

245
00:14:14,760 --> 00:14:16,770
ألا تحبّ الأشياء المُرّة؟

246
00:14:16,770 --> 00:14:20,070
.سأكذب إن قلتُ أنّي أحبّها

247
00:14:20,520 --> 00:14:22,230
،مع ذلك أخبرني ماساتويو والبقيّة

248
00:14:22,230 --> 00:14:25,770
،"مذاق الدواء الجيّد مُر"
.ويجعلونه مُرًّا أكثر

249
00:14:26,180 --> 00:14:27,200
.يا إلهي

250
00:14:31,180 --> 00:14:33,780
لماذا قمتِ بتقديم المساعدة لصنع الدواء؟

251
00:14:34,350 --> 00:14:36,840
.لأنّه كان خطئي

252
00:14:36,840 --> 00:14:38,440
.نحن أعداء

253
00:14:39,700 --> 00:14:42,420
.ذلك شيءٌ مختلف

254
00:14:42,830 --> 00:14:45,310
".شارك الملح حتّى مع أعدائك"

255
00:14:45,310 --> 00:14:46,680
.مثله تمامًا

256
00:14:47,000 --> 00:14:48,070
مثله؟

257
00:14:48,430 --> 00:14:49,950
.كينشين أويسوغي

258
00:14:50,360 --> 00:14:53,700
يمكنك القول أنّه أكثر شخص
.جديرٌ لأن يكون منافسي

259
00:14:53,700 --> 00:14:55,760
كينشين أويسوغي-سان؟

260
00:14:55,760 --> 00:14:58,960
.يطلقون عليه إله الحرب
.إنّه عبقريٌّ في الحرب

261
00:14:59,730 --> 00:15:02,160
.إنّه مذهلٌ للغاية

262
00:15:02,610 --> 00:15:05,430
يجعلني أمرّ بتجارب خطيرة
.في جميع قتالاتنا

263
00:15:06,260 --> 00:15:08,700
،ظللنا نتعادل حتّى الآن

264
00:15:10,950 --> 00:15:13,380
.ولكنّي أريد أن أفوقه يومًا ما

265
00:15:14,490 --> 00:15:19,070
حماية جميع حلفائي المحليين وأتباعي
،هو جزءٌ مهم من سبب قتالي بالطبع

266
00:15:19,980 --> 00:15:21,330
.ولكنّي أريد الفوز حقًّا

267
00:15:22,350 --> 00:15:25,050
.كرجل يكرّس نفسه للقتال

268
00:15:25,700 --> 00:15:28,240
،لا أعرف الكثير عن الحرب

269
00:15:28,980 --> 00:15:30,410
.ولكن آمل أن تفوز

270
00:15:33,670 --> 00:15:34,740
.بالفعل

271
00:15:35,460 --> 00:15:36,260
.يوزوكي

272
00:15:36,860 --> 00:15:38,380
.ماسانوبو يناديك

273
00:15:38,380 --> 00:15:39,230
.حسنًا

274
00:15:39,540 --> 00:15:40,760
.شكرًا لك على الطعام

275
00:15:45,130 --> 00:15:46,710
هل بدأت بالتعلّق بها؟

276
00:15:46,970 --> 00:15:48,090
.نوبوهارو-سان

277
00:15:48,740 --> 00:15:50,470
.ليس كذلك

278
00:15:50,810 --> 00:15:51,710
حقًّا؟

279
00:15:52,050 --> 00:15:54,470
.يبدو أنّها ستكون سيّدة ملائمة لك

280
00:15:56,260 --> 00:15:57,200
...لقد قرّرت

281
00:15:58,620 --> 00:16:00,600
.لن أتزوّج

282
00:16:07,340 --> 00:16:08,980
،والآن يا شينغين-ساما

283
00:16:09,400 --> 00:16:12,770
.صنعت فتاة هذا لك بكامل مشاعرها فيه

284
00:16:12,770 --> 00:16:14,640
.تناوله رجاءً

285
00:16:14,640 --> 00:16:17,080
لا... الحبوب؟

286
00:16:17,580 --> 00:16:22,710
هل سترفض حقًّا ما صنعته فتاةٌ لك؟

287
00:16:22,710 --> 00:16:25,040
.لا تقلق يا نوبوهارو-سان

288
00:16:25,390 --> 00:16:28,880
.إنّ شينغين-ساما رجلٌ محترم

289
00:16:28,880 --> 00:16:30,160
.بالفعل

290
00:16:30,160 --> 00:16:33,960
.سيتناوله شينغين-ساما بلا تردّد

291
00:16:35,760 --> 00:16:39,510
أنتم تستمتعون بهذا حقًّا، أليس كذلك؟

292
00:16:39,970 --> 00:16:41,770
.يا إلهي، حسنًا

293
00:16:42,060 --> 00:16:44,090
.ها نحن ذا إذًا

294
00:16:49,580 --> 00:16:50,660
ما هذا؟

295
00:16:50,660 --> 00:16:51,720
.ليس مُرًّا

296
00:16:52,560 --> 00:16:55,700
.مزجت العسل في الواقع

297
00:16:55,700 --> 00:16:58,540
.ظننت أنّ ذلك سيسهّل على شينغين-سان تناوله

298
00:16:58,540 --> 00:17:01,020
ماذا، هل أنتِ مُلمّة بأمور الدواء؟

299
00:17:01,020 --> 00:17:04,270
.لا، حاولت تعديل الوصفة قليلًا فحسب

300
00:17:04,270 --> 00:17:06,250
تعديل؟

301
00:17:07,570 --> 00:17:09,140
.هذا مفاجئ

302
00:17:09,140 --> 00:17:10,350
.شكرًا لك

303
00:17:10,350 --> 00:17:13,300
.لم أتوقّع أن تصنعي لي حبّة جيّدة كهذه

304
00:17:15,450 --> 00:17:17,970
.هذا يزيد من أهميّتك أكثر

305
00:17:18,410 --> 00:17:19,540
.صحيح

306
00:17:20,100 --> 00:17:22,980
،بالمناسبة، إن كنتِ مهتمّة

307
00:17:22,980 --> 00:17:25,490
أتودين أن تصبحي مُعالِجة جيش تاكيدا؟

308
00:17:25,490 --> 00:17:26,570
مُعالِجة؟

309
00:17:26,570 --> 00:17:27,440
.أنت

310
00:17:27,440 --> 00:17:29,580
ألدينا تيمبورا؟

311
00:17:29,580 --> 00:17:30,910
.يبدو لذيذًا

312
00:17:30,910 --> 00:17:31,970
!الشراب

313
00:17:31,970 --> 00:17:34,760
.يكفيكم

314
00:17:34,760 --> 00:17:36,730
هلّا تناولنا العشاء إذًا؟

315
00:17:38,900 --> 00:17:39,700
!من هناك؟

316
00:17:39,700 --> 00:17:41,450
!لا يهم من، سأطيح بهم

317
00:17:41,870 --> 00:17:42,990
.شينغين-ساما

318
00:17:42,990 --> 00:17:44,080
!لنخرج من هنا

319
00:18:00,350 --> 00:18:01,470
!شينغين-ساما

320
00:18:02,730 --> 00:18:04,490
أين العدو يا ماساتويو؟

321
00:18:04,490 --> 00:18:06,380
.نوبوهارا-سان والبقيّة يلاحقونهم

322
00:18:06,380 --> 00:18:08,720
.إنّه ليس جيش أويسوغي

323
00:18:08,720 --> 00:18:09,820
.نعم

324
00:18:09,820 --> 00:18:12,840
.كينشين لن يقوم بهجوم غادر أبدًا

325
00:18:18,060 --> 00:18:19,150
!شينغين-ساما

326
00:18:19,150 --> 00:18:20,780
!هل أنت بخير؟ شينغين-ساما

327
00:18:23,200 --> 00:18:26,790
هل كنتَ مريضًا في الحقيقة؟

328
00:18:27,280 --> 00:18:29,380
...ذلك

329
00:18:29,680 --> 00:18:32,130
.سأخبرها يا ماساتويو

330
00:18:32,130 --> 00:18:34,050
.لم يعد ذلك سرًّا

331
00:18:35,790 --> 00:18:38,930
.كما لاحظتِ، أعاني من مرضٍ مزمن

332
00:18:39,200 --> 00:18:41,740
.يبدو أنّه مرض عضال

333
00:18:42,380 --> 00:18:43,180
عضال؟

334
00:18:43,460 --> 00:18:46,010
،لقد هدأ في الفترة الأخيرة

335
00:18:46,010 --> 00:18:48,440
،ولكن ها نحن ذا

336
00:18:48,440 --> 00:18:50,190
...إذًا ذلك الدواء

337
00:18:50,510 --> 00:18:51,310
.نعم

338
00:18:52,860 --> 00:18:54,900
.هذا بسبب أنّ دوائي لم يأتِ بمفعول

339
00:18:55,960 --> 00:18:58,010
.يستغرق وقتًا ليبدأ مفعوله

340
00:18:58,400 --> 00:18:59,520
.انتظري قليلًا

341
00:19:00,370 --> 00:19:03,580
.سحقًا، ظننت أنّي سأصمد أكثر

342
00:19:05,100 --> 00:19:06,330
!شينغين-سان

343
00:19:06,570 --> 00:19:09,580
شينغين-سان، إنّك تحتاج دم يوزوكي-سان
.الآن أكثر من أيّ وقتٍ مضى

344
00:19:10,410 --> 00:19:11,410
...ماساتويو

345
00:19:11,830 --> 00:19:12,690
.يوزوكي-سان

346
00:19:13,020 --> 00:19:17,800
نحن المستذئبون نشفى أسرع
.حين نستهلك دماء البشر

347
00:19:18,490 --> 00:19:20,760
،لا يشفي الأمراض

348
00:19:20,760 --> 00:19:23,730
.ولكنّه يمنعها من التطوّر أو يسكّنها

349
00:19:24,780 --> 00:19:27,870
أعلم أنّ طلب هذا منك
،أمرٌ صعب للغاية

350
00:19:28,800 --> 00:19:31,860
.ولكن أرجوك، نحتاج دمك

351
00:19:31,860 --> 00:19:32,660
.لا

352
00:19:33,050 --> 00:19:34,440
...شينغين-ساما

353
00:19:34,700 --> 00:19:37,510
لا أريد أن يضحّي شخصٌ آخر

354
00:19:37,510 --> 00:19:40,450
.من أجلي بعد الآن

355
00:19:44,340 --> 00:19:45,210
العدو؟

356
00:19:45,210 --> 00:19:46,740
.سأبطئهم قليلًا

357
00:19:46,740 --> 00:19:47,960
...لذا في تلك الأثناء

358
00:19:54,250 --> 00:19:55,550
...شينغين-سان

359
00:19:56,670 --> 00:19:58,260
.لا تنظري إليّ هكذا

360
00:20:03,400 --> 00:20:04,250
!ياكوما

361
00:20:05,370 --> 00:20:07,100
.تراجعي يا يوزوكي

362
00:20:13,950 --> 00:20:15,190
!شينغين-سان

363
00:20:15,190 --> 00:20:15,990
!لا تأتي

364
00:20:16,960 --> 00:20:17,880
.أنا بخير

365
00:20:18,530 --> 00:20:20,720
.لن أموت هنا

366
00:20:21,200 --> 00:20:23,100
.لن أدعك تموتين أيضًا

367
00:20:29,950 --> 00:20:30,870
أرأيتِ؟

368
00:20:31,630 --> 00:20:34,000
...أنا

369
00:20:36,690 --> 00:20:38,100
.إنّه متهوّر

370
00:20:38,100 --> 00:20:39,240
.شينغين-ساما

371
00:20:39,240 --> 00:20:40,560
!شينغين-ساما

372
00:20:40,560 --> 00:20:41,590
هل أنت بخير؟

373
00:20:44,330 --> 00:20:46,100
.لنأخذه إلى مكانٍ آمن

374
00:20:46,920 --> 00:20:48,830
من كان ذلك باعتقادك؟

375
00:20:48,830 --> 00:20:52,070
.هربوا في حين صرف انتباهنا الياكوما

376
00:21:05,810 --> 00:21:07,310
.أعتذر

377
00:21:08,170 --> 00:21:10,080
.تاكيدا وتويوتومي

378
00:21:12,850 --> 00:21:16,050
.عليك الذهاب إلى قلعة أويسوغي يا ميتسوهيدي

379
00:21:16,700 --> 00:21:17,500
.حاضر

380
00:21:24,030 --> 00:21:25,880
هل أنت بخير الآن؟

381
00:21:25,880 --> 00:21:28,040
.نعم، بفضلك

382
00:21:28,460 --> 00:21:30,260
.أنقذتني أيضًا يا هيديوشي

383
00:21:30,890 --> 00:21:33,270
.كن حذرًا أثناء سفرك

384
00:21:33,510 --> 00:21:34,430
.نعم

385
00:21:34,430 --> 00:21:35,270
.إلى اللقاء

386
00:21:37,810 --> 00:21:38,730
.يوزوكي

387
00:21:39,700 --> 00:21:42,040
.اطلبيني إن احتجتِ شيئًا

388
00:21:42,390 --> 00:21:43,930
.سأساعدك في أيّ وقت

389
00:21:45,680 --> 00:21:48,040
.لقد انجذب إليكِ تمامًا

390
00:21:48,040 --> 00:21:49,840
ا-انجذب إليّ؟

391
00:21:51,550 --> 00:21:52,720
.لا أمانع

392
00:21:58,700 --> 00:21:59,580
.هذا سيّئ

393
00:21:59,580 --> 00:22:02,170
.عليّ إعلام يوزوكي-سان بسرعة

394
00:22:06,380 --> 00:22:08,400
.لقد بدأت أخيرًا