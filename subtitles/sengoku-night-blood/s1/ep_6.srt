1
00:00:01,020 --> 00:00:03,320
!استيقظي من فضلك

2
00:00:05,170 --> 00:00:06,790
.أرجوك تماسكي

3
00:00:10,510 --> 00:00:12,510
إيماري-كن؟

4
00:00:12,510 --> 00:00:15,870
.أنا مسرور! كنت قلقًا للغاية

5
00:00:16,460 --> 00:00:17,440
أين نحن؟

6
00:00:17,440 --> 00:00:18,870
.في الغابة

7
00:00:18,870 --> 00:00:22,410
وجدتك مغميًا عليك هنا
.حين كنت أبحث عنك

8
00:00:22,410 --> 00:00:23,430
!مؤلم

9
00:00:26,500 --> 00:00:27,750
.صحيح

10
00:00:28,190 --> 00:00:31,910
كنت في طريق العودة إلى
القلعة رفقة هانبي-كن

11
00:00:31,910 --> 00:00:33,510
...عندما هاجمَنا الياكوما

12
00:00:41,740 --> 00:00:43,570
لم أتمكّن من الركض أكثر

13
00:00:45,440 --> 00:00:47,100
.لأنّني أرغمت نفسي على الركض كثيرًا

14
00:00:47,770 --> 00:00:50,780
.أنا مسرورٌ حقًّا لأنّك بخير

15
00:00:51,210 --> 00:00:53,470
.على أيّ حال، علينا معالجة رجلك بسرعة

16
00:01:21,540 --> 00:01:22,390
أنت...؟

17
00:01:35,880 --> 00:01:37,820
.أ-أنزلني من فضلك

18
00:01:37,820 --> 00:01:39,570
.لا يمكنك الحراك بهذا الجرح

19
00:01:39,890 --> 00:01:43,340
.يمكنك البقاء في قلعتي لفترة

20
00:01:44,610 --> 00:01:47,700
.لا تقلقي، لن نؤذيك

21
00:03:21,190 --> 00:03:24,680
،وسعنا منطقة البحث لإيجاد يوزوكي

22
00:03:25,340 --> 00:03:26,770
.ولكن لا أثر لها

23
00:03:27,930 --> 00:03:31,430
.يحتمل أنّها أُخذت من قِبل جيش آخر

24
00:03:32,190 --> 00:03:33,190
حقًّا؟

25
00:03:35,830 --> 00:03:36,780
،هيديوشي-ساما

26
00:03:38,340 --> 00:03:40,690
.انتهت معالجة توشيي وهانبي

27
00:03:41,380 --> 00:03:43,950
.يحتاج كلاهما إلى الراحة التامّة

28
00:03:46,300 --> 00:03:48,120
.يا للفوضى التي سببتها

29
00:03:48,120 --> 00:03:49,950
،لم أستطع هزيمة نوبوناغا المبغوض

30
00:03:50,720 --> 00:03:53,590
،حُرقت المدينة، وأُصيب أتباعي

31
00:03:54,240 --> 00:03:56,000
...وخسرتها أيضًا

32
00:03:57,550 --> 00:04:00,020
...لماذا يا ترى؟ أنا

33
00:04:01,560 --> 00:04:03,500
ما الذي أخطأت به؟

34
00:04:09,860 --> 00:04:11,480
.ها قد انتهينا

35
00:04:12,330 --> 00:04:14,730
.ارتاحي قليلًا وستشفى حتمًا

36
00:04:15,430 --> 00:04:17,340
،كما قال كينشين-ساما

37
00:04:18,430 --> 00:04:21,030
.عليك التحسن هنا برويّة

38
00:04:21,430 --> 00:04:22,530
...ولكن

39
00:04:24,270 --> 00:04:25,750
.أحضرت لك ملابسَ جديدة

40
00:04:27,180 --> 00:04:28,530
.شكرًا جزيلًا لك

41
00:04:28,790 --> 00:04:31,290
.عليك شكر كينشين-ساما

42
00:04:31,830 --> 00:04:33,110
...اطمئني

43
00:04:33,580 --> 00:04:38,960
كينشين-ساما رجل نبيل، على عكس
.قادة الحروب العنيفين من الجيوش الأخرى

44
00:04:39,500 --> 00:04:40,900
رجل نبيل؟

45
00:04:41,720 --> 00:04:42,330
.نعم

46
00:04:42,990 --> 00:04:46,800
بالمناسبة يا كاغيي، أين ملابسها الجديدة؟

47
00:04:47,210 --> 00:04:48,760
—ماذا؟ إنّها هنا

48
00:04:49,280 --> 00:04:50,320
!ماذا؟

49
00:04:50,320 --> 00:04:52,310
...أنا متأكّد أنّها كانت بيدي قبل قليل

50
00:04:52,650 --> 00:04:55,330
لا مبالاة كاغيي دائمًا
.ما تسبب لنا المشاكل

51
00:04:55,830 --> 00:04:58,310
بهذه يكون في هذه الشهر
...مرّة، اثنان، ثلاثة

52
00:04:58,310 --> 00:05:00,150
—أربعة، خمسة، ستة

53
00:05:00,150 --> 00:05:01,320
!اصمت

54
00:05:04,010 --> 00:05:05,450
!أنا آسفة

55
00:05:05,840 --> 00:05:07,320
.ضحكتِ أخيرًا

56
00:05:08,150 --> 00:05:10,040
.الابتسامة أجمل

57
00:05:11,380 --> 00:05:14,880
على أيّ حال، ركزي حاليًّا على ترك
.هذا الجرح يشفى للوقت الراهن

58
00:05:15,780 --> 00:05:16,580
.حسنًا

59
00:05:29,750 --> 00:05:31,100
...يا له من صوت جميل

60
00:05:43,610 --> 00:05:46,200
.جمعتكم هنا جميعًا لمناقشة أمرها

61
00:05:47,610 --> 00:05:50,220
،تضج القلعة بالشائعات عنها

62
00:05:50,540 --> 00:05:53,120
.لأنّها كانت محميّة من طرف تويوتومي

63
00:05:53,320 --> 00:05:56,120
.وأيضًا فوق كلّ هذا، تملك دماء هيميميكو

64
00:05:57,970 --> 00:06:00,410
،دماؤها مشابهة لهيميميكو

65
00:06:00,410 --> 00:06:03,630
وفيها قوّة هائلة للتأثير
.بنتيجة أيّ معركة

66
00:06:04,060 --> 00:06:09,390
تواجدها يمكن أن يكون أمرًا
.ذا أهميّة قصوى لجيش أويسوغي

67
00:06:10,890 --> 00:06:12,840
،لهذا بغض النظر عن الحالة

68
00:06:13,800 --> 00:06:17,890
.يحظر استعمال دماؤها

69
00:06:19,230 --> 00:06:20,030
ماذا؟

70
00:06:20,280 --> 00:06:24,480
يتضمن هذا طبعًا ذكر تلك
.القوّة خارج القلعة أيضًا

71
00:06:25,100 --> 00:06:29,460
ولكن لن يشكّل جيش تاكيدا تهديدًا
.لنا إن استخدمنا قوتها

72
00:06:30,160 --> 00:06:32,620
.انتهى الحديث. انصرفوا

73
00:06:32,620 --> 00:06:33,730
.مفهوم

74
00:06:35,620 --> 00:06:36,720
.مفهوم

75
00:06:38,890 --> 00:06:40,190
.مفهوم

76
00:06:44,140 --> 00:06:45,070
.كاغيكاتسو

77
00:06:45,570 --> 00:06:46,380
.نعم

78
00:06:46,560 --> 00:06:49,010
.أريدك أن تعتني بها

79
00:06:49,580 --> 00:06:50,630
أنا؟

80
00:06:50,810 --> 00:06:51,760
.أعتمد عليك

81
00:06:52,350 --> 00:06:53,780
.مفهوم

82
00:06:53,780 --> 00:06:54,810
!كينشين-ساما

83
00:06:55,410 --> 00:06:56,960
.حصانك جاهز

84
00:07:06,990 --> 00:07:09,330
.أنا آسفة لاعتنائك بي

85
00:07:09,930 --> 00:07:11,030
.لا تقلقي

86
00:07:11,750 --> 00:07:13,980
.أوامر أبي مُطلقة

87
00:07:13,980 --> 00:07:15,040
أبيك؟

88
00:07:15,700 --> 00:07:18,290
.اسمي هو كاغيكاتسو أويسوغي

89
00:07:19,350 --> 00:07:23,290
.أنا ابن كينشين أويسوغي المُتبنى ووريثه

90
00:07:23,530 --> 00:07:24,930
هكذا إذًا؟

91
00:07:25,540 --> 00:07:28,800
نحن متقاربان بالعمر، لذا لا داعي
.لأن تكوني رسميّة معي

92
00:07:28,800 --> 00:07:29,660
...حسنًا

93
00:07:29,660 --> 00:07:31,800
.أعتمد عليك

94
00:07:32,120 --> 00:07:32,940
.نعم

95
00:07:32,940 --> 00:07:34,800
بماذا تعتمدين عليه؟

96
00:07:35,020 --> 00:07:36,620
.احذر يا كاغيكاتسو

97
00:07:36,620 --> 00:07:39,230
ماذا ستفعل لو كانت جاسوسة لتويوتومي؟

98
00:07:39,630 --> 00:07:42,310
لا بدّ وأنّ لا بأس بهذا، لا تبدو
.سيّئة بالنسبة لي

99
00:07:42,890 --> 00:07:45,060
.هل أنتِ جائعة؟ لنذهب لتناول الطعام

100
00:07:45,060 --> 00:07:45,860
.حسنًا

101
00:07:45,860 --> 00:07:47,520
!انتظرا

102
00:07:48,090 --> 00:07:52,320
ولكن لماذا يُحظر علينا استعمال دمائها؟

103
00:07:52,990 --> 00:07:57,160
أعتقد أنّ ذلك لكي لا تتخذ المعارك
منعطفات نحن في غنى عنها؟

104
00:07:57,930 --> 00:08:01,290
لا يهتم كينشين-ساما للمعارك
.التي لا طائل منها في نهاية المطاف

105
00:08:02,990 --> 00:08:04,470
ماذا تعني بذلك؟

106
00:08:04,990 --> 00:08:07,630
.يقاتل كينشين-ساما من أجل العدالة دائمًا

107
00:08:08,270 --> 00:08:10,530
.إنّه ذاهب إلى المعبد في هذا الوقت

108
00:08:10,970 --> 00:08:11,970
المعبد؟

109
00:08:11,970 --> 00:08:15,940
دائمًا ما يذهب إلى المعبد لتطهير ذهنه
.وجسده بعد كل معركة

110
00:08:15,940 --> 00:08:19,990
هل كان القتال الخيار الصحيح؟
لم تكن الدماء قد هُدرت عبثًا؟

111
00:08:20,750 --> 00:08:22,860
هل حافظت علي حس عدالتي؟

112
00:08:23,340 --> 00:08:25,630
.إنّه يسأل نفسه هذه الأشياء على الأرجح

113
00:08:26,390 --> 00:08:27,180
...بيوا

114
00:08:28,080 --> 00:08:30,250
.سمعته يعزف البيوا الليلة الماضية

115
00:08:30,250 --> 00:08:34,610
إنّه يعزفها لجعل أرواح
.الموتى ترقد في سلام

116
00:08:35,160 --> 00:08:37,030
.إنّه شخص لطيف

117
00:08:37,030 --> 00:08:40,610
،نعم، إنّه لطيف وجدير بالاحترام
.وأقوى من أيّ شخص آخر

118
00:08:41,100 --> 00:08:43,170
.شخصٌ مثلي لا يمكنه مجاراته

119
00:08:44,160 --> 00:08:46,870
.كما أخبرتك، لا تكن بهذا الخضوع

120
00:08:47,280 --> 00:08:49,360
!لست خاضعًا

121
00:08:49,360 --> 00:08:53,630
لديك أنا لمساعدتك بالاقتراب
.لتصبح مثل كينشين-ساما أكثر

122
00:08:54,470 --> 00:08:58,220
!والآن إذًا، لنتدرّب بما أنّنا انتهينا من الأكل

123
00:09:11,950 --> 00:09:13,190
!انتهت المبارزة

124
00:09:17,020 --> 00:09:18,220
!مرّة أخرى

125
00:09:19,270 --> 00:09:20,720
.كنت آمل ذلك

126
00:09:24,920 --> 00:09:26,930
.يا له من شعور رائع

127
00:09:27,370 --> 00:09:28,830
.القمر جميل اليوم

128
00:09:29,040 --> 00:09:30,190
.بالفعل

129
00:09:31,740 --> 00:09:35,140
بالمناسبة، لمَ جعلت كاغيكاتسو-ساما
مسؤولًا عن الفتاة؟

130
00:09:35,740 --> 00:09:41,430
،إنّه يدرس السياسة بجد مؤخرًا بالفعل

131
00:09:41,670 --> 00:09:45,470
وتحسنت مهاراته بالسيف
.بفضل كانيتسوغو أيضًا

132
00:09:48,830 --> 00:09:51,630
إذًا بإعطائه عمل حيث
،عليه أن يتحمل مسؤوليّة شيء

133
00:09:51,630 --> 00:09:54,750
فإنّك تريد منه أن يتحلى
بالمزيد من الثقة، صحيح؟

134
00:09:55,090 --> 00:09:57,700
...لا تسأل إن كنت تعرف الإجابة، علاوة على هذا

135
00:09:59,260 --> 00:10:01,970
.إنّه لا يملك أصدقاء بنفس عمره

136
00:10:02,700 --> 00:10:06,570
لن يُظهر لنا مشاعره الحقيقيّة
،بما أنّنا نعلوه مرتبة

137
00:10:07,350 --> 00:10:10,820
.ولكنّه قد ينفتح لشخصٍ قريب من عمره

138
00:10:11,900 --> 00:10:16,170
أسهل طريقة هي السؤال بشكلٍ مباشر
.إن كنت تريد معرفة ما يفكّر فيه

139
00:10:17,400 --> 00:10:21,050
.لن يستفيد شيئًا إن فعل ذلك يا كاغيي

140
00:10:32,820 --> 00:10:33,980
.انتهت المبارزة

141
00:10:35,080 --> 00:10:36,620
هلّا ارتحنا قليلًا؟

142
00:10:37,160 --> 00:10:38,370
...ليس بعد

143
00:10:39,100 --> 00:10:40,000
...المعذرة

144
00:10:40,420 --> 00:10:41,680
.أحضرت وجبة خفيفة

145
00:10:43,480 --> 00:10:44,900
.يفترض أن ترتاحي

146
00:10:45,370 --> 00:10:46,540
...أنا آسفة

147
00:10:49,980 --> 00:10:52,880
أعددت كرات الرز، أتودان تناولها؟

148
00:10:55,360 --> 00:10:56,380
...لذيذة

149
00:10:56,620 --> 00:10:59,270
إنّه لذيذ! ما هذا الطعم؟

150
00:10:59,730 --> 00:11:01,090
.أوكاكا ومايونيز

151
00:11:01,500 --> 00:11:02,510
مايونيز؟

152
00:11:02,510 --> 00:11:04,400
،لا أعلم ما هذا

153
00:11:04,400 --> 00:11:06,660
!ولكنّي لم أتناول أوكاكا بهذه اللذة من قبل

154
00:11:08,020 --> 00:11:09,270
.أنا مسرورة

155
00:11:09,270 --> 00:11:12,650
!لـ-لكن هذا لا يعني أنّي أثق فيك

156
00:11:17,090 --> 00:11:17,840
.انتهينا

157
00:11:19,150 --> 00:11:20,380
.هذا سيّئ للغاية

158
00:11:20,380 --> 00:11:22,280
.يا إلهي، أنا سأفعلها

159
00:11:22,720 --> 00:11:25,530
.أنا من جعلني أبي مسؤولًا عن الاعتناء بها

160
00:11:25,530 --> 00:11:26,530
.أنا سأفعلها

161
00:11:26,530 --> 00:11:27,540
.قلت أنّي سأفعلها

162
00:11:30,380 --> 00:11:31,520
!كرات الرز

163
00:11:32,510 --> 00:11:33,530
ماذا لدينا اليوم؟

164
00:11:33,530 --> 00:11:34,930
.كرات الرز المشويّة

165
00:11:37,950 --> 00:11:39,110
.انتهت المبارزة

166
00:11:41,420 --> 00:11:42,490
!لقد فعلتها

167
00:11:43,210 --> 00:11:44,010
!نعم

168
00:11:47,740 --> 00:11:48,540
ماذا؟

169
00:11:52,470 --> 00:11:53,440
!يوزوكي-سان

170
00:11:53,930 --> 00:11:55,910
!إ-إيماري-كن

171
00:11:56,240 --> 00:11:57,700
!وجدتك أخيرًا

172
00:11:58,240 --> 00:12:01,870
.أنا آسفة لعدم تمكني من المجيء لك يا إيماري-كن

173
00:12:02,550 --> 00:12:03,810
!لا بأس

174
00:12:04,260 --> 00:12:07,320
.يبدو أنّهم يعاملونك بشكلٍ حسن هنا

175
00:12:07,320 --> 00:12:08,080
.نعم

176
00:12:08,080 --> 00:12:10,350
ولكن ما الذي ستفعلينه الآن؟

177
00:12:10,350 --> 00:12:13,210
.كنت أفكّر بالرحيل فورما أُشفى تمامًا

178
00:12:13,940 --> 00:12:16,460
.لا بدّ وأنّ هيديوشي-سان قلق

179
00:12:16,690 --> 00:12:17,880
.حسنًا

180
00:12:17,880 --> 00:12:20,440
.سأجمع المعلومات إلى ذلك الحين إذًا

181
00:12:20,440 --> 00:12:22,970
قد تكون هنالك معلومات عن
.هيميميكو-ساما هنا

182
00:12:23,550 --> 00:12:26,470
لهذا أريدك أن تفعل هذا
...عند مهاجمتك للعدو

183
00:12:26,470 --> 00:12:27,550
.فهمت

184
00:12:27,550 --> 00:12:31,880
عليّ إذًا وضع الجنود هنا
.حين أحمي موضعي من العدو

185
00:12:33,590 --> 00:12:35,280
...أكثر قليلًا

186
00:12:42,030 --> 00:12:43,490
ما الذي تفعلينه؟

187
00:12:43,740 --> 00:12:45,120
.أنا آسفة

188
00:12:47,720 --> 00:12:48,520
.دعيني أرى

189
00:12:48,890 --> 00:12:49,990
...أنا بخير

190
00:12:50,390 --> 00:12:51,190
.دعيني أرى فحسب

191
00:12:52,130 --> 00:12:53,580
.المعذرة

192
00:12:54,520 --> 00:12:56,040
.أتحمل كامل المسؤوليّة

193
00:12:56,460 --> 00:12:59,500
عهدت الاعتناء بها إليّ
...يا أبي، مع ذلك أنا

194
00:12:59,750 --> 00:13:01,760
!إنّه ليس خطؤك يا كاغيكاتسو-كن

195
00:13:02,530 --> 00:13:03,650
.يكفي

196
00:13:04,510 --> 00:13:06,090
.انصرف يا كاغيكاتسو

197
00:13:06,680 --> 00:13:07,920
.المعذرة

198
00:13:08,590 --> 00:13:11,200
.إنّه خطأي يا كينشين-سان

199
00:13:11,200 --> 00:13:13,720
.لم أكن أرتاح، لذا انفتح جرحي

200
00:13:13,720 --> 00:13:15,310
.سبّبنا لك المتاعب

201
00:13:15,310 --> 00:13:17,770
.سأعتني أنا بك هذه المرة

202
00:13:17,980 --> 00:13:19,160
...هذا غير صحيح

203
00:13:19,160 --> 00:13:23,780
كان كاغيكاتسو-كن يعمل بجد
.لكي تقدّره

204
00:13:24,260 --> 00:13:27,050
هل يمكنك فهم هذا الشيء
فقط على الأقل؟

205
00:13:35,130 --> 00:13:36,990
لمَ آل الأمر إلى هذا؟

206
00:13:38,090 --> 00:13:40,400
.سأهزم ذلك الرجل بيديّ هاتين

207
00:13:41,210 --> 00:13:43,300
!هذه الفرصة الوحيدة لمهاجمة نوبوناغا

208
00:13:44,910 --> 00:13:45,920
!انتظر من فضلك

209
00:13:47,090 --> 00:13:49,050
ألا تثق بي؟

210
00:13:49,320 --> 00:13:51,130
!هذا ليس ما في الأمر

211
00:13:51,560 --> 00:13:53,190
.إنّك تتصرف بغرابة نوعًا ما

212
00:13:53,600 --> 00:13:56,040
!أخبرك أن تهدأ

213
00:13:56,040 --> 00:13:58,070
.أنا هادئٌ للغاية

214
00:13:59,020 --> 00:14:00,820
.هذا ما كان يسعى له إذًا

215
00:14:01,580 --> 00:14:05,120
.ولكن القلعة لم تسقط بعد

216
00:14:06,460 --> 00:14:09,010
كنت مركزًا للغاية على
،كون نوبوناغا أمامي

217
00:14:09,010 --> 00:14:10,560
.لدرجة أنّي فقدت بصيرتي لما حولي

218
00:14:11,810 --> 00:14:14,400
.يا إلهي، يا لي من قائد أعلى فاشل

219
00:14:14,780 --> 00:14:16,330
.يجب عليك الارتياح

220
00:14:19,790 --> 00:14:21,130
!أنا بخير

221
00:14:21,130 --> 00:14:22,100
.توشيي

222
00:14:23,220 --> 00:14:25,460
.إن كنت لن تفعلها فأنا سأفعلها

223
00:14:25,460 --> 00:14:27,250
ماذا تفعل هنا ساكنًا؟

224
00:14:27,250 --> 00:14:29,890
!المدينة والجيش في حالة يرثى لها

225
00:14:30,410 --> 00:14:32,420
.يا إلهي، يا لك من مزعج

226
00:14:35,970 --> 00:14:38,220
أتعتقد أنّي لم أفكر بشيء؟

227
00:14:38,840 --> 00:14:39,950
!فليجتمع الجميع

228
00:14:41,700 --> 00:14:44,820
سنقوم أوّلًا باستعادة قرية القلعة
!ونعيد تشكيل صفوفنا

229
00:14:45,100 --> 00:14:46,350
،سيتولى ميتسوناري القرية

230
00:14:46,350 --> 00:14:47,830
.وسأترك الجيش لك يا توشيي

231
00:14:48,330 --> 00:14:49,020
.حاضر

232
00:14:49,020 --> 00:14:49,820
.حسنًا

233
00:14:50,330 --> 00:14:53,550
كانبي وهانبي، جدا مكان
!يوزوكي مهما كلّف الأمر

234
00:14:53,930 --> 00:14:54,960
.بأيّ وسيلة ضروريّة

235
00:14:55,530 --> 00:14:56,090
.نعم

236
00:14:56,090 --> 00:14:57,290
!هذا كلّ شيء! انصرفوا

237
00:15:02,170 --> 00:15:05,340
تلك الفتاة مفقودة؟

238
00:15:06,010 --> 00:15:06,990
.فهمت

239
00:15:16,820 --> 00:15:18,420
!كينشين-ساما

240
00:15:20,280 --> 00:15:22,480
!كينشين-ساما! هنالك مصيبة

241
00:15:23,860 --> 00:15:25,030
أتساءل ما الخطب؟

242
00:15:26,350 --> 00:15:28,360
.هذا ما يحدث إذًا

243
00:15:28,360 --> 00:15:32,140
في وسط فوضى المعركة، تقوم الدول
،المجاورة بتحركات مُشوِشة

244
00:15:32,140 --> 00:15:34,610
لكي لا نعلم متى قد
.تقع حالة طارئة

245
00:15:35,180 --> 00:15:36,900
.كما تقول

246
00:15:36,900 --> 00:15:37,890
.مفهوم

247
00:15:37,890 --> 00:15:41,540
في حال وجود حالة طوارئ، لنضع
.تعزيزات وضابط قيادي في المكان

248
00:15:41,540 --> 00:15:42,370
.حاضر

249
00:15:42,950 --> 00:15:45,610
ولكن لمن ستأتمن هذا الدور الكبير؟

250
00:15:48,110 --> 00:15:51,370
.كنت أنوي ائتمان كاغيكاتسو لهذا الدور

251
00:15:52,660 --> 00:15:55,810
إنّها فرصة جيّدة لك لتعلّم
.طرق حماية المنطقة

252
00:15:58,510 --> 00:16:00,320
.أ-أرفض

253
00:16:08,490 --> 00:16:10,890
هل ستتولى هذه المهمة إذًا يا كاغيي؟

254
00:16:15,740 --> 00:16:16,910
.مفهوم

255
00:16:17,360 --> 00:16:18,540
.المعذرة

256
00:16:19,170 --> 00:16:20,480
!أنت

257
00:16:20,990 --> 00:16:22,100
.المعذرة

258
00:16:24,730 --> 00:16:26,160
!ما معنى هذا؟

259
00:16:26,700 --> 00:16:27,640
...لا شيء

260
00:16:27,640 --> 00:16:30,130
ليس لا شيء! أليست فرصة جيّدة؟

261
00:16:30,640 --> 00:16:33,170
—يمكنك أخيرًا اكتساب خبرة فعليّة

262
00:16:33,170 --> 00:16:34,350
.لن أذهب

263
00:16:34,350 --> 00:16:35,680
!لمَ لا؟

264
00:16:38,660 --> 00:16:41,310
!ما هذا؟ افعل ما يحلو لك

265
00:16:54,220 --> 00:16:57,450
...يا إلهي، كينشين-ساما وكاغيكاتسو-ساما

266
00:16:59,370 --> 00:17:01,370
.كلاهما يملكان سمات غريبة

267
00:17:01,740 --> 00:17:06,890
على الأرجح أنّ كاغيكاتسو-ساما فقد
ثقته منذ أن ساء جرحها

268
00:17:06,890 --> 00:17:08,750
حين كان من المفترض
.أن يكون مسؤولًا عن الاعتناء بها

269
00:17:09,300 --> 00:17:11,920
ولكن من الأفضل أن يقول
.بما يشعر به فحسب

270
00:17:11,920 --> 00:17:14,290
لماذا لا يستطيع كلٌّ منهما
أن يعبر عن نفسه جيّدًا؟

271
00:17:14,290 --> 00:17:16,550
.علاقات الآباء والأبناء مزعجة نوعًا ما

272
00:17:20,970 --> 00:17:22,090
...كاغيكاتسو-كن

273
00:17:23,500 --> 00:17:24,980
هل أنت متأكّد حيال هذا؟

274
00:17:26,110 --> 00:17:27,170
،كاغيكاتسو-كن

275
00:17:28,120 --> 00:17:30,310
تريد أن تذهب رفقة الجيش
في الحقيقة، صحيح؟

276
00:17:31,340 --> 00:17:32,170
لماذا تعتقدين ذلك؟

277
00:17:32,170 --> 00:17:33,190
—لأنّ

278
00:17:33,350 --> 00:17:34,480
.انتهت المبارزة

279
00:17:34,480 --> 00:17:35,370
.فهمت

280
00:17:35,370 --> 00:17:39,550
عليّ إذًا وضع الجنود هنا
.حين أحمي موضعي من العدو

281
00:17:40,450 --> 00:17:43,450
.إنّك دائمًا ما تبذل جهدًا أكثر من أيّ شخص

282
00:17:44,720 --> 00:17:47,580
ما رأيك أن تحاول التحدث
مع كينشين-ساما بشكلٍ لائق عن هذا؟

283
00:17:47,980 --> 00:17:49,600
.لا يوجد شيءٌ للحديث بشأنه

284
00:17:49,910 --> 00:17:53,530
،في أوّل مرة قابلتك فيها

285
00:17:53,530 --> 00:17:56,780
اعتقدت أنّك شخص لا يمكنني
.معرفة ما يفكر به

286
00:17:57,580 --> 00:18:00,620
،ولكن كلّما تحدثت معك أكثر

287
00:18:00,620 --> 00:18:03,500
عرفت أنّك شخص جيّد أكثر مع درجة من الغرابة

288
00:18:04,750 --> 00:18:08,870
أعتقد أنّه من المهم الحديث مع
.أحدهم لمعرفة المزيد عنه

289
00:18:09,270 --> 00:18:12,150
لهذا أعتقد أنّ عليك مواجهة كينشين-سان

290
00:18:12,150 --> 00:18:15,370
.وتخبره بشعورك

291
00:18:17,590 --> 00:18:19,010
ما الذي أردت التحدث عنه؟

292
00:18:20,210 --> 00:18:22,740
.إنّه عن التعزيزات يا أبي

293
00:18:23,110 --> 00:18:25,910
.تم أخذ القرار بذلك، كاغيي سيذهب

294
00:18:27,540 --> 00:18:31,710
كينشين-سان، أرجوك استمع
.لما يشعر به كاغيكاتسو-كن

295
00:18:33,340 --> 00:18:34,500
.أرجوك

296
00:18:35,910 --> 00:18:38,080
.حسنًا، سأستمع

297
00:18:38,970 --> 00:18:39,770
...أنا

298
00:18:40,490 --> 00:18:42,820
.لا أملك أيّ ثقة بنفسي

299
00:18:43,480 --> 00:18:49,020
لا أعتقد حقًّا أنّ بإمكاني
.أن أصبح قائد حربٍ محترم مثلك

300
00:18:50,030 --> 00:18:51,020
لمَ ذلك؟

301
00:18:52,230 --> 00:18:55,250
،لست قويًّا مثلك

302
00:18:55,720 --> 00:18:58,850
وفشلت بالاعتناء بها
.حين ائتمنتني على ذلك

303
00:19:00,140 --> 00:19:04,600
.لا أستطيع مجاراة توقعاتك

304
00:19:05,210 --> 00:19:09,250
.لهذا لا يمكنك القيادة حاملًا شعار أويسوغي

305
00:19:09,930 --> 00:19:11,210
أهذا ما تقصده؟

306
00:19:11,450 --> 00:19:12,000
.نعم

307
00:19:13,020 --> 00:19:17,360
قائد الحرب هو شخص مهم
.يحمي المنطقة ومواطنيها

308
00:19:17,960 --> 00:19:20,260
بغض النظر عن كميّة
،قوة قبائل غيغّا التي تمتلكها

309
00:19:20,260 --> 00:19:22,750
.فإنّها ليست مناسبة لشخصٍ غير جاد

310
00:19:23,320 --> 00:19:24,220
.نعم

311
00:19:24,220 --> 00:19:27,310
لهذا لا يمكن أن أأتمن القتال أو التعزيزات

312
00:19:27,310 --> 00:19:29,890
.لشخص لا أعتقد أنّه سينهي العمل

313
00:19:30,430 --> 00:19:31,230
ماذا؟

314
00:19:31,450 --> 00:19:34,870
.هذه مسؤوليّتي كحامٍ لهذه الأرض

315
00:19:35,230 --> 00:19:39,370
إذًا... لماذا قبلت بسرعة

316
00:19:39,370 --> 00:19:42,040
عندما قلت أنّي لن أذهب مع التعزيزات؟

317
00:19:42,560 --> 00:19:45,990
،ستصبح القائد الأعلى لأويسوغي يومًا ما

318
00:19:46,650 --> 00:19:50,380
.عليك دائمًا تحمل مسؤوليّة قراراتك

319
00:19:51,480 --> 00:19:54,430
حتّى وإن كان ذلك القرار
،لا يتوافق مع إرادتي

320
00:19:54,770 --> 00:19:57,750
.لا أستطيع إيقافك إن قررت

321
00:19:58,730 --> 00:20:01,120
.سأسألك مرّة أخرى استنادًا على كلّ ذلك

322
00:20:01,120 --> 00:20:04,640
كاغيكاتسو، هنالك دورٌ مهم
.أود أن أأتمنك عليه

323
00:20:06,370 --> 00:20:07,580
هل ستذهب؟

324
00:20:08,170 --> 00:20:08,970
.نعم

325
00:20:18,120 --> 00:20:20,050
.ستذهب إذًا في نهاية المطاف

326
00:20:20,940 --> 00:20:22,640
.حان وقت المغادرة

327
00:20:22,640 --> 00:20:23,950
.كن حذرًا

328
00:20:24,440 --> 00:20:26,450
.حسنًا، سنذهب الآن

329
00:20:29,870 --> 00:20:30,950
.أعتمد عليك

330
00:20:32,260 --> 00:20:33,080
.أبي

331
00:20:36,580 --> 00:20:38,840
.يبدو أنّ جرحك شفي تمامًا

332
00:20:38,840 --> 00:20:40,470
.أنا مسرورة

333
00:20:40,470 --> 00:20:42,470
.يا لك من شابّة مذهلة

334
00:20:42,920 --> 00:20:43,720
ماذا؟

335
00:20:43,900 --> 00:20:47,300
استطعت فعل ما لم أستطع
.أنا ولا كاغيي فعله

336
00:20:48,960 --> 00:20:51,470
.أقصد أمر كينشين-ساما وكاغيكاتسو-ساما

337
00:20:54,230 --> 00:20:55,900
.كينشين-ساما استدعاك

338
00:20:56,160 --> 00:20:56,980
.حسنًا

339
00:20:57,620 --> 00:20:58,890
أتريد شكري؟

340
00:20:59,300 --> 00:21:00,730
أهنالك ما تبغينه؟

341
00:21:00,950 --> 00:21:02,490
.لا، لا يوجد شيء

342
00:21:02,490 --> 00:21:05,490
.أنا ممتنٌ لمساعدتك من كلّ أعماق قلبي

343
00:21:06,880 --> 00:21:10,990
لم أكن لأعرف شعور كاغيكاتسو
.أبدًا لولا وجودك هنا

344
00:21:11,850 --> 00:21:13,500
.أخبريني بأمنيتك

345
00:21:15,330 --> 00:21:16,110
...البيوا

346
00:21:17,230 --> 00:21:18,880
.أود سماع عزفك للبيوا

347
00:21:20,260 --> 00:21:21,170
.حسنًا

348
00:21:22,750 --> 00:21:24,940
.سأعزفها لكِ أنت فقط هذه الليلة

349
00:21:56,100 --> 00:21:58,290
.وردتنا أخبار من جيش سانادا

350
00:21:58,790 --> 00:22:02,050
.يبدو أنّ يوزوكي مع كينشين أويسوغي