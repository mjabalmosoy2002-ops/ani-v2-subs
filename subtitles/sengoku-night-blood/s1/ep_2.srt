1
00:00:00,760 --> 00:00:02,990
.هذا العالم يُعرف بشينغا

2
00:00:03,310 --> 00:00:06,350
اختفت هيميميكو التي كانت تمتلك
،دمًا بقوى خاصّة

3
00:00:06,350 --> 00:00:09,950
وأصبح العالم الذي كان بسلام
.سابقًا في حالة فوضى

4
00:00:09,950 --> 00:00:11,790
قادة حروب قبائل غيغّا الغير بشريّة

5
00:00:11,790 --> 00:00:15,050
.يستمرّون في مقاتلة بعضهم بهدف التوحيد

6
00:00:15,650 --> 00:00:19,040
أنتِ الدليل الوحيد الذي
!أملكه لإيجاد هيميميكو-ساما

7
00:00:19,040 --> 00:00:21,640
!أرجوك أعيريني قوتك

8
00:01:53,620 --> 00:01:56,000
.مرّ وقتٌ طويل، أيّها القرد

9
00:01:57,100 --> 00:01:59,670
.نوبوناغا... ساما

10
00:02:06,340 --> 00:02:10,310
.ياه، لم أتوقّع أن تأتي بنفسك باغيًا رأسي

11
00:02:10,600 --> 00:02:11,680
،أو بالأحرى

12
00:02:11,680 --> 00:02:16,130
أيجدر بي القول أنّك أحضرت رأسك إليّ بكلّ لطف؟

13
00:02:16,130 --> 00:02:17,310
!ماذا قلت؟

14
00:02:16,430 --> 00:02:18,240
.لا بأس، اهدأ

15
00:02:19,270 --> 00:02:21,890
.رأسي في مكانه أيّها القرد

16
00:02:22,200 --> 00:02:24,490
.إنّه لك إن استطعت قطعه

17
00:02:24,820 --> 00:02:28,520
ولكن، مهما رسمت من مخطّطات

18
00:02:28,520 --> 00:02:31,340
،أو حشدت من جنود

19
00:02:31,340 --> 00:02:34,630
،فلن تبلغ رأسي أبدًا

20
00:02:35,150 --> 00:02:36,880
.لم تتغيّر أبدًا

21
00:02:39,590 --> 00:02:42,940
سأثني عليك أوّلًا بوصولك إلى هنا

22
00:02:42,940 --> 00:02:44,390
.مع سحبك لمثل هذا العائق

23
00:02:44,650 --> 00:02:48,070
.تلقّي المديح منك لشرفٌ عظيم

24
00:02:48,070 --> 00:02:49,350
...تلك الفتاة

25
00:02:49,350 --> 00:02:52,900
لا بدّ وأنّ لها قدرًا كبيرًا
.لإبقائها معك

26
00:02:53,310 --> 00:02:55,000
.لا تقلق

27
00:02:55,000 --> 00:02:58,440
.سآخذها معي حين تموت

28
00:03:00,190 --> 00:03:00,990
.اقتلوه

29
00:03:00,990 --> 00:03:01,790
!حاضر

30
00:03:03,370 --> 00:03:04,170
.اسمعي

31
00:03:04,490 --> 00:03:06,660
لا تبتعدي عنّي أبدًا، مفهوم؟

32
00:03:07,260 --> 00:03:08,120
...نعم

33
00:03:08,360 --> 00:03:10,320
!الهدف هو رأس هيديوشي

34
00:03:10,320 --> 00:03:11,250
!نالوا منه

35
00:03:12,180 --> 00:03:13,480
!لن أدع ذلك يحدث

36
00:03:13,480 --> 00:03:14,500
!لن نسمح بذلك

37
00:03:14,740 --> 00:03:16,480
!ميتسوناري! توشيي

38
00:03:17,120 --> 00:03:20,880
!لن ندعكم تلمسون هيديوشي-ساما ومن معه

39
00:03:21,290 --> 00:03:22,510
!توشيي مايدا؟

40
00:03:22,710 --> 00:03:24,420
!أنت يا رانمارو

41
00:03:24,420 --> 00:03:26,810
عدم ذكر التشريفات لأمرٌ فظيع، أليس كذلك؟

42
00:03:26,810 --> 00:03:29,600
!اعتدت أن تناديني بتوشيي-سان

43
00:03:29,600 --> 00:03:31,140
!ها أنا قادم

44
00:03:31,140 --> 00:03:32,260
!نوبوناغا-ساما

45
00:03:32,260 --> 00:03:34,860
إنّهما ليسا ميتسوناري إيشيدا
،وتوشيي مايدا فقط

46
00:03:35,170 --> 00:03:39,840
كلا الكتيبتين مع نابي تاكيناكا
.وكانبي كورودا تتبعهما

47
00:03:41,070 --> 00:03:42,910
.هيديوشي-ساما، الآن فرصتك

48
00:03:43,280 --> 00:03:44,100
،نعم

49
00:03:44,100 --> 00:03:45,220
!سأترك الباقي عليكما

50
00:03:55,880 --> 00:03:58,160
!لم نثُر بما يكفي، سحقًا

51
00:03:58,160 --> 00:03:59,470
.لم يكن هناك باليد حيلة

52
00:03:59,470 --> 00:04:03,000
الانسحاب كان أفضل ما يمكن فعله
.في تلك الظروف

53
00:04:03,970 --> 00:04:05,010
..ولكن

54
00:04:05,340 --> 00:04:08,890
كان جيش نوبوناغا قويًّا للغاية، أليس كذلك؟

55
00:04:09,100 --> 00:04:09,940
.نعم

56
00:04:09,940 --> 00:04:13,390
علينا ابتكار المزيد من
.الاستراتيجيّات من الآن

57
00:04:13,390 --> 00:04:14,910
،حسنًا، على أيّ حال

58
00:04:14,910 --> 00:04:17,650
...بوضع التفكير بهذه الأشياء جانبًا حاليًّا

59
00:04:17,650 --> 00:04:21,100
في الحقيقة، هنالك ما أوّد
.إخباره إيّاكم جميعًا

60
00:04:21,500 --> 00:04:23,530
ما هو؟

61
00:04:23,950 --> 00:04:25,530
.إنّه عنها

62
00:04:27,070 --> 00:04:29,220
.عن سرّ دمها

63
00:04:32,660 --> 00:04:34,660
أهذا صحيح؟

64
00:04:34,660 --> 00:04:36,270
تفعّلت؟

65
00:04:37,040 --> 00:04:38,850
...لا يعقل

66
00:04:38,850 --> 00:04:40,460
...-ا-المعذرة

67
00:04:40,460 --> 00:04:44,050
ما الذي يعنيه "التفعيل"؟

68
00:04:44,310 --> 00:04:47,680
،حسنًا، بالشرح ببساطة

69
00:04:47,680 --> 00:04:51,680
إنّه يعني إيقاظ القوّة الحقيقيّة
.لنا نحن الذين من قبائل غيغّا

70
00:04:52,210 --> 00:04:56,130
رأيت تغيّر هيئة هيديوشي-ساما، صحيح؟

71
00:04:56,640 --> 00:04:58,160
ولكن لماذا؟

72
00:04:58,160 --> 00:05:00,110
،لا أعرف السبب

73
00:05:00,110 --> 00:05:03,400
ولكن يبدو أنّ دمها لديه القوّة

74
00:05:03,400 --> 00:05:07,710
لتفعيل أعضاء قبائل غيغّا
.مثل هيميميكو

75
00:05:08,770 --> 00:05:12,010
.شعرتُ بتلك القوّة حين شربت دمها

76
00:05:12,010 --> 00:05:13,850
.إنّها مميّزة

77
00:05:14,590 --> 00:05:16,990
.أريدكم أن تفهموا ذلك جميعًا أيضًا

78
00:05:18,710 --> 00:05:21,280
إن كنت تقول ذلك يا
هيديوشي-ساما فبالطبع إذًا

79
00:05:21,280 --> 00:05:23,590
.سنحميها بكلّ ما أوتينا من قوّة

80
00:05:23,870 --> 00:05:25,180
.شكرًا لك يا هانبي

81
00:05:25,180 --> 00:05:27,300
.ولكن علينا أن نكون حذرين

82
00:05:27,300 --> 00:05:29,340
إن علِم أودا نوبوناغا
،بشأن سرّ دمها

83
00:05:29,600 --> 00:05:32,010
.فلن يبقى صامتًا

84
00:05:32,920 --> 00:05:35,180
.عرف عنه نوبوناغا بالفعل

85
00:05:35,180 --> 00:05:36,630
!...هذا يعني

86
00:05:36,630 --> 00:05:37,740
.صحيح

87
00:05:37,740 --> 00:05:41,070
ستُستهدف من قِبل
.نوبوناغا الآن على الأرجح

88
00:05:42,370 --> 00:05:47,240
من المرجّح إنّ معرفة باقي
.الجيوش لهذا مسألة وقت إذًا

89
00:05:47,240 --> 00:05:51,960
إذًا... ألن تستهدفها كلّ باقي الجيوش؟

90
00:05:52,410 --> 00:05:54,570
.علينا أن نكون يقظين أكثر من الآن

91
00:05:54,570 --> 00:05:56,210
...لـ-لا يمكن

92
00:05:56,490 --> 00:05:58,210
هل أخفتك؟

93
00:05:58,210 --> 00:06:01,340
ولكن لا بأس، فكّرت
.بشيءٍ جيّد للتو

94
00:06:05,390 --> 00:06:08,220
.سأجعلك ملكي

95
00:06:11,210 --> 00:06:14,430
لمَ لا تتزوجينني؟

96
00:06:15,560 --> 00:06:16,500
!ماذا؟

97
00:06:16,860 --> 00:06:18,700
.لا، لا

98
00:06:18,700 --> 00:06:21,050
مهما كانت الظروف، فإنّ
!هذا مبالغٌ فيه أكثر من اللازم

99
00:06:21,050 --> 00:06:24,650
إلّم يكن هيديوشي يمانع فما الضير؟

100
00:06:24,650 --> 00:06:25,850
!مبارك

101
00:06:25,850 --> 00:06:28,650
،إن كانت مع هيديوشي-ساما

102
00:06:29,000 --> 00:06:31,530
فإنّ العدو لن يتمكّن
.من الاقتراب منها بسهولة

103
00:06:31,910 --> 00:06:33,890
!كما هو متوقّع من هيديوشي-ساما

104
00:06:33,890 --> 00:06:36,330
!يبدو ذلك ممتعًا، لذا أنا موافقٌ تمامًا

105
00:06:36,620 --> 00:06:39,420
...ممّا يعني أنّ بدءًا من اليوم، أنا وأنتِ

106
00:06:39,420 --> 00:06:42,370
لا، "أنتِ" لا يليق بالزوجة، أليس كذلك؟

107
00:06:42,370 --> 00:06:44,090
ما اسمك؟

108
00:06:44,430 --> 00:06:48,340
...أنا... يوزوكي

109
00:06:48,340 --> 00:06:49,760
يوزوكي؟

110
00:06:49,760 --> 00:06:51,140
.يا له من اسم جميل

111
00:06:51,620 --> 00:06:53,060
.يلائمك تمامًا

112
00:06:53,420 --> 00:06:56,000
.لنعتنِ ببعضنا من الآن فصاعدًا يا يوزوكي

113
00:07:00,570 --> 00:07:02,080
.صباح الخير

114
00:07:02,950 --> 00:07:04,650
!صباح الخير

115
00:07:04,650 --> 00:07:05,910
هل نمتِ جيّدًا؟

116
00:07:06,760 --> 00:07:08,270
.لا، ليس كثيرًا

117
00:07:08,680 --> 00:07:10,950
...حدث الكثير البارحة

118
00:07:11,170 --> 00:07:12,050
،نعم

119
00:07:12,050 --> 00:07:16,490
تصرّفات هيديوشي-ساما
.المبالغ فيها فاجأتنا نحن حتّى

120
00:07:16,810 --> 00:07:19,680
...ولكن التقدّم للزواج فجأة

121
00:07:20,140 --> 00:07:22,000
.لم نتقابل إلّا توًّا

122
00:07:24,330 --> 00:07:26,330
!حسنًا، حان وقت الطعام

123
00:07:26,330 --> 00:07:27,510
!سآكل الكثير

124
00:07:28,170 --> 00:07:29,980
!ياه، إنّي أتضوّر جوعًا

125
00:07:29,980 --> 00:07:31,260
!لنبدأ الأكل

126
00:07:31,540 --> 00:07:33,550
.لقد تأخّرتما

127
00:07:33,550 --> 00:07:37,100
إذًا، هل اتّخذتِ قرارك
بشأن الزواج بي؟

128
00:07:38,810 --> 00:07:40,910
لمَ تريد الزواج منّي؟

129
00:07:41,330 --> 00:07:45,270
...هنالك طرق أخرى لحمايتي بالتأكيد

130
00:07:45,550 --> 00:07:46,770
.الحبّ من أوّل نظرة

131
00:07:48,180 --> 00:07:50,450
.أنا مهتمٌ بك

132
00:07:50,450 --> 00:07:51,860
.يمكنك اعتبارها غريزة

133
00:07:52,100 --> 00:07:55,120
!إنّك جريء جدًّا يا هيديوشي-ساما

134
00:07:57,360 --> 00:07:59,360
،إن تزوجتِني

135
00:07:59,360 --> 00:08:02,500
.فسأحميك بلا شروط

136
00:08:02,500 --> 00:08:04,860
،ولكن إن رفضتِ

137
00:08:04,860 --> 00:08:07,530
.سيتوجّب عليك أن تفيديني بطرق أخرى

138
00:08:07,530 --> 00:08:08,330
ماذا؟

139
00:08:08,620 --> 00:08:12,470
لا يمكنك القتال أو التفكير
،باستراتيجيّات للمعركة

140
00:08:12,880 --> 00:08:14,010
أليس كذلك؟

141
00:08:14,010 --> 00:08:16,200
...هـ-هذا

142
00:08:16,890 --> 00:08:18,210
.آسفة

143
00:08:18,210 --> 00:08:21,270
.ولكن لا يمكنني الزواج بك بهذه البساطة أيضًا

144
00:08:22,520 --> 00:08:23,790
.إنّك عنيدة

145
00:08:23,790 --> 00:08:26,700
.لأنّنا لا نعرف بعضنا جيّدًا

146
00:08:26,700 --> 00:08:27,760
.هيديوشي-ساما

147
00:08:28,750 --> 00:08:31,890
لمَ لا تعطيها المزيد من الوقت للتفكير؟

148
00:08:32,230 --> 00:08:34,880
.يُقال أنّ في العجلة الندامة في نهاية المطاف

149
00:08:35,540 --> 00:08:37,080
.صحيح

150
00:08:37,470 --> 00:08:41,250
أعتقد أنّني سأجعلك تساهمين
.في مهام الجنود للوقت الراهن

151
00:08:41,660 --> 00:08:46,250
ولكنّني من النوع الذي سيستخدم
.أيّ وسيلة لكسب ما يريد

152
00:08:46,670 --> 00:08:48,330
.تذكّري ذلك

153
00:09:00,030 --> 00:09:01,520
.تفضّل يا سيّدي

154
00:09:02,060 --> 00:09:04,750
وهذا يتضمّن التي استعرتها
.في المرة السابقة

155
00:09:05,520 --> 00:09:07,810
.شكرًا لك من القلب

156
00:09:07,810 --> 00:09:08,730
...أوه

157
00:09:09,090 --> 00:09:10,960
.يا لها من سيّدة جميلة

158
00:09:10,960 --> 00:09:12,800
ميتسوناري-ساما، أيعقل أنّها...؟

159
00:09:14,020 --> 00:09:16,350
.لا تأتي بهذه الافتراضات الغريبة من فضلك

160
00:09:16,350 --> 00:09:19,200
.إنّها تساعدني فحسب

161
00:09:19,410 --> 00:09:22,330
.فهمت، فهمت، هكذا إذًا

162
00:09:22,800 --> 00:09:26,040
.المعذرة، إنّكما تلائمان بعضكما فحسب

163
00:09:27,550 --> 00:09:28,780
أليست ثقيلة؟

164
00:09:28,780 --> 00:09:30,720
.لا، أنا على ما يرام

165
00:09:30,720 --> 00:09:32,590
هل نذهب لاحتساء بعض الشاي قليلًا؟

166
00:09:32,960 --> 00:09:33,850
.نعم

167
00:09:35,840 --> 00:09:39,470
،مدينة القلعة هذه تزدهر حاليًّا، ولكن

168
00:09:40,080 --> 00:09:43,800
،كان هنالك القليل من الأشخاص في البداية
.وكان الحفاظ على السلام صعبًا

169
00:09:44,870 --> 00:09:47,140
.لا يبدو لي ذلك

170
00:09:47,140 --> 00:09:50,710
.رفض هيديوشي-ساما التخلّي عن هذه المدينة

171
00:09:51,400 --> 00:09:55,690
طوّر هذه المدينة شيئًا فشيئًا
.إلى أن ازدهرت بهذا الشكل

172
00:09:55,690 --> 00:09:57,070
هيديوشي-سان قام بذلك؟

173
00:09:57,390 --> 00:09:59,940
حتّى العمل الذي تساعدينا فيه

174
00:10:00,300 --> 00:10:03,780
هو شيءٌ وفّره هيديوشي-ساما
.من أجل الناس الذين يعيشون هنا

175
00:10:04,640 --> 00:10:06,620
مؤخّرًا، مجموعة من الجنود الهاربين اليائسين

176
00:10:07,060 --> 00:10:10,940
.يسلبون خيرات هذه المنطقة باستمرار

177
00:10:12,530 --> 00:10:15,760
لذا أخبرنا هيديوشي-ساما
...أنّه رسمَ خطّة

178
00:10:16,330 --> 00:10:19,080
.تم أخذ القرار! سنجعلهم يطوفون هذه المرّة

179
00:10:19,080 --> 00:10:22,260
.سنُغرق مقرّ العدو بتيار موحل

180
00:10:22,570 --> 00:10:25,100
!سيكون طوفانًا لا مثيل له

181
00:10:26,300 --> 00:10:28,220
إذًا سنختار الطوفان؟

182
00:10:28,220 --> 00:10:30,100
.أحبّ عندما نسوّي الأمور بشكلٍ صارخ

183
00:10:30,900 --> 00:10:32,250
.يبدو ذلك ممتعًا

184
00:10:32,250 --> 00:10:33,610
.فهمت

185
00:10:33,610 --> 00:10:37,430
.يمكن استخدامه كخزان بعد إغراق العدو

186
00:10:37,430 --> 00:10:38,990
هل فكّرت بخطة؟

187
00:10:39,260 --> 00:10:42,310
ستتطلّب الخطّة إعدادًا دقيقًا

188
00:10:42,310 --> 00:10:44,740
!لكي تنجح

189
00:10:45,810 --> 00:10:49,750
ألا يعني هذا أنّه ترك
كلّ التخطيط عليك؟

190
00:10:50,220 --> 00:10:52,200
.هذا ما يفعله دائمًا

191
00:10:53,710 --> 00:10:55,890
...ولكن مع ذلك، طوفان

192
00:10:55,890 --> 00:10:58,880
.يأتي هيديوشي-سان بأفكار مذهلة فعلًا

193
00:10:59,320 --> 00:11:02,420
تبدو تصرفات هيديوشي-ساما
،غير معقولة أحيانًا

194
00:11:02,850 --> 00:11:04,450
.ولكن لديه سبب دائمًا

195
00:11:04,880 --> 00:11:07,350
.وهو أن يجعل الناس سعداء

196
00:11:09,100 --> 00:11:11,650
إنّك تحترم هيديوشي-سان حقًّا، أليس كذلك؟

197
00:11:11,850 --> 00:11:12,930
.نعم

198
00:11:12,930 --> 00:11:16,170
.ستفهمين شعوري أنتِ أيضًا يومًا ما

199
00:11:23,940 --> 00:11:25,140
،ميتسوناري-ساما

200
00:11:25,140 --> 00:11:26,990
!أرجوك ساعدني

201
00:11:26,990 --> 00:11:28,160
ما الأمر؟

202
00:11:28,460 --> 00:11:31,580
ا-اختُطفت أختي الصغيرة
!من قِبل اللصوص

203
00:11:32,040 --> 00:11:33,120
!ماذا؟

204
00:11:35,070 --> 00:11:37,610
ميتسوناري-سان، إلى أين نذهب؟

205
00:11:37,610 --> 00:11:38,870
.يمكنك رؤيتها الآن

206
00:11:38,870 --> 00:11:39,820
.انظري هناك

207
00:11:43,050 --> 00:11:43,890
،توشيي

208
00:11:44,880 --> 00:11:45,970
أهنالك أيّ حركة؟

209
00:11:45,970 --> 00:11:46,840
.لا

210
00:11:46,840 --> 00:11:47,920
هل حدث شيء؟

211
00:11:47,920 --> 00:11:50,640
.أتى لي شخصٌ طالبًا منّي المساعدة في المدينة

212
00:11:50,640 --> 00:11:53,600
يبدو أنّ أولئك اللصوص
.قد اختطفوا فتاةً يافعة

213
00:11:53,600 --> 00:11:54,570
!ماذا؟

214
00:11:54,570 --> 00:11:55,960
.اعتقدت أنّه قد يكون خطأً

215
00:11:55,960 --> 00:11:57,020
!توشيي، كن حذرًا

216
00:11:58,020 --> 00:11:59,530
!اترك الأمر لي

217
00:12:04,320 --> 00:12:05,910
...ها قد ذهب

218
00:12:05,910 --> 00:12:07,550
هل هو على ما يرام؟

219
00:12:07,550 --> 00:12:09,540
...الذهاب إلى هناك بمفرده هكذا

220
00:12:10,290 --> 00:12:12,810
.يفترض ألا تكون هنالك مشكلة بما أنّه توشيي

221
00:12:14,460 --> 00:12:16,290
ما الذي تفعله؟

222
00:12:16,730 --> 00:12:19,780
عليّ الانتهاء من إعداد خطّة
.بأسرع ما يمكن

223
00:12:20,350 --> 00:12:23,180
.لا أودّ زيادة عدد الضحايا

224
00:12:24,430 --> 00:12:26,030
.سأساعدك

225
00:12:29,600 --> 00:12:30,710
...مؤلم

226
00:12:30,710 --> 00:12:32,680
ألا يمكنك أن تكوني أكثر لطفًا؟

227
00:12:32,860 --> 00:12:36,490
لقد كنت متهوّرًا بالفعل، لم يكن
.ينبغي أن تذهب لوحدك

228
00:12:36,490 --> 00:12:38,940
.ولكنّي مسرورٌ أنّها على ما يرام

229
00:12:42,420 --> 00:12:46,720
.سأعيدها إلى المدينة قبل أن يحلّ الظلام

230
00:12:46,720 --> 00:12:47,950
.حسنًا، أعتمد عليك

231
00:12:52,870 --> 00:12:54,460
.لقد جُرحت بجروح بليغة

232
00:12:54,460 --> 00:12:56,320
.ما باليد حيلة

233
00:12:56,320 --> 00:12:58,300
عندما فكّرت كيف عليّ
،أن أنقذ أحد سكّان المدينة

234
00:12:58,300 --> 00:13:00,260
.تحرّك جسدي لوحده

235
00:13:00,660 --> 00:13:04,470
.ولكن هرب أغلبهم فحسب في نهاية المطاف

236
00:13:04,470 --> 00:13:05,780
هكذا إذًا؟

237
00:13:05,780 --> 00:13:08,720
.نعم، ومقرّهم معقّدٌ للغاية

238
00:13:09,510 --> 00:13:12,960
لا بدّ وأنّ لهذا السبب أخبرنا
.هيديوشي بأن نأتي لهم بطوفان

239
00:13:13,510 --> 00:13:15,270
.بالفعل

240
00:13:15,270 --> 00:13:17,530
.يحتسب هيديوشي-سان لكلّ شيء

241
00:13:17,850 --> 00:13:19,730
،إنّه جادّ دائمًا

242
00:13:20,030 --> 00:13:21,610
.بما فيه أمرك

243
00:13:23,920 --> 00:13:26,110
ألا تحبين هيديوشي؟

244
00:13:26,110 --> 00:13:28,640
...لـ-ليس كذلك

245
00:13:29,240 --> 00:13:30,450
!تراجعي

246
00:13:30,840 --> 00:13:32,050
هل هؤلاء اللصوص؟

247
00:13:32,050 --> 00:13:33,250
أيمكن أنّهم سيأخذون بثأرهم؟

248
00:13:33,540 --> 00:13:36,000
!لـ-لا، إنّهم الياكوما

249
00:13:41,330 --> 00:13:42,290
ياكوما؟

250
00:13:42,290 --> 00:13:44,240
إنّهم وحوش لا يعرف مصدرهم

251
00:13:44,240 --> 00:13:46,130
.يظهرون فجأة في جميع الأرجاء مؤخّرًا

252
00:13:46,430 --> 00:13:48,040
،مهما هزمنا منهم عندما يظهرون

253
00:13:48,040 --> 00:13:50,140
.فإنّ لا نهاية لهم

254
00:14:00,590 --> 00:14:01,610
!لا تقلقي

255
00:14:01,940 --> 00:14:04,510
!سأعيدك آمنة مهما حدث

256
00:14:04,510 --> 00:14:06,860
توشيي-سان، لماذا؟

257
00:14:06,860 --> 00:14:08,260
أليس ذلك واضحًا؟

258
00:14:08,260 --> 00:14:11,950
.سأحميك حتّى لو كلّفني ذلك حياتي

259
00:14:12,700 --> 00:14:13,760
...حسنًا

260
00:14:16,240 --> 00:14:17,720
!أيّها الياكوما

261
00:14:17,720 --> 00:14:19,960
!سأواجهكم! تعالوا بكلّ ما لديكم

262
00:14:21,210 --> 00:14:22,380
هل أنتِ بخير؟

263
00:14:22,820 --> 00:14:23,710
.نعم

264
00:14:25,760 --> 00:14:27,470
ما الخطب؟

265
00:14:27,470 --> 00:14:29,720
.أ-أنا آسفة

266
00:14:29,720 --> 00:14:31,940
.يبدو أنّ طاقتي قد خدرت لسببٍ ما

267
00:14:31,940 --> 00:14:33,620
.ما باليد حيلة إذًا

268
00:14:34,590 --> 00:14:35,870
!أ-أنا بخير

269
00:14:35,870 --> 00:14:37,100
.أنزلني أرجوك

270
00:14:37,390 --> 00:14:38,640
لا يمكنك الحراك، أليس كذلك؟

271
00:14:39,310 --> 00:14:41,090
.هكذا أسرع بكثير

272
00:14:41,090 --> 00:14:43,640
.سيكون من السيّئ إن ظهر ياكوما آخر

273
00:14:44,420 --> 00:14:46,110
.شكرًا جزيلًا لك

274
00:14:46,590 --> 00:14:49,320
.ولكنّي قلقة على حالتك يا توشيي-سان

275
00:14:49,320 --> 00:14:50,870
أنا؟

276
00:14:52,010 --> 00:14:54,240
.هذه أوّل مرّة يقول لي أحدٌ شيئًا كهذا

277
00:14:54,240 --> 00:14:55,040
ماذا؟

278
00:14:55,040 --> 00:14:58,050
.لم يقلق أحدٌ عليّ إلى هذا الحد من قبل

279
00:14:58,300 --> 00:15:01,700
لأنّ الإصابة بالجروح في المعركة
.أمر طبيعي

280
00:15:02,310 --> 00:15:03,680
!لا يمكن

281
00:15:03,680 --> 00:15:06,200
على الرغم من أنّك مجروحٌ إلى هذا الحد؟

282
00:15:07,640 --> 00:15:09,140
.لا، أنا بخير حقًّا

283
00:15:09,850 --> 00:15:12,510
.إنّك حقًّا لطيفة

284
00:15:12,880 --> 00:15:14,510
.لا، ليس كذلك

285
00:15:14,930 --> 00:15:16,090
!حسنًا

286
00:15:16,090 --> 00:15:19,550
!عليّ أن أُرجعك بسرعة لكي تطمئنّي

287
00:15:19,550 --> 00:15:21,270
!تمسكي بي جيّدًا

288
00:15:21,540 --> 00:15:22,360
!حسنًا

289
00:15:25,030 --> 00:15:26,160
،آه، آسف

290
00:15:26,160 --> 00:15:28,320
.آ-آسف، لا بدّ وأنّ ذلك كان مخيفًا

291
00:15:28,320 --> 00:15:30,120
.أنا بخير

292
00:15:30,590 --> 00:15:34,670
الأهم من ذلك، ألم تؤذِ
رجليك يا توشيي-سان؟

293
00:15:34,670 --> 00:15:36,910
!لا، أنا بخير تمامًا

294
00:15:37,220 --> 00:15:40,250
اعتن بنفسك أكثر من فضلك، حسنًا؟

295
00:15:40,560 --> 00:15:42,230
...نـ-نعم

296
00:15:42,230 --> 00:15:44,500
.سأكون بخير

297
00:15:44,500 --> 00:15:46,500
!سأصبح أقوى

298
00:15:48,370 --> 00:15:50,640
.ما دمتِ بجانبي

299
00:15:52,120 --> 00:15:53,330
!مرحبًا بعودتك

300
00:15:53,330 --> 00:15:55,420
.سمعت ما حدث من ميتسوناري

301
00:15:55,420 --> 00:15:57,510
.يبدو أنّك مررت ببعض المتاعب

302
00:15:57,510 --> 00:15:59,230
!أنا مسرور أنّك على ما يرام

303
00:15:59,230 --> 00:16:01,520
.نعم، أنا آسفة

304
00:16:01,990 --> 00:16:04,930
.لم أقدّم أيّ مساعدة لكم

305
00:16:06,810 --> 00:16:10,380
وأشعر بالأسى عندما أفكّر
.أنّ كل ما سأكونه هو مجرّد عائق

306
00:16:11,360 --> 00:16:13,280
،في هذه الحالة

307
00:16:13,280 --> 00:16:16,620
لمَ لا تساعدين ميتسوناري في عمله؟

308
00:16:18,020 --> 00:16:21,690
.إنّه دائمًا ما ينهمك بالتخطيط حتّى الصباح

309
00:16:22,090 --> 00:16:23,380
حتّى الصباح؟

310
00:16:33,550 --> 00:16:34,840
.المعذرة

311
00:16:35,110 --> 00:16:36,150
ما الأمر؟

312
00:16:36,150 --> 00:16:38,850
هلّا سمحت لي بمساعدتك
بإعدادك للخطّة

313
00:16:38,850 --> 00:16:40,910
حتّى النهاية؟

314
00:16:41,310 --> 00:16:42,680
،بصراحة

315
00:16:42,680 --> 00:16:45,600
سيكون من الأسهل لي أن أقوم
.بهذا لوحدي لأتمكّن من التركيز

316
00:16:46,830 --> 00:16:48,860
!أرجوك يا ميتسوناري-سان

317
00:16:49,240 --> 00:16:53,150
!أريد أن أكون عونًا لكم جميعًا فحسب

318
00:16:54,720 --> 00:16:56,110
...إن كنت مصرّة

319
00:16:57,470 --> 00:17:00,220
أعيدي هذه الخرائط إلى
.غرفة التخزين أوّلًا من فضلك

320
00:17:01,080 --> 00:17:02,000
...وأيضًا

321
00:17:02,410 --> 00:17:05,860
هل يمكنك البحث عن الكتب
التي كتبتها هنا أيضًا؟

322
00:17:06,200 --> 00:17:07,000
!نعم

323
00:17:50,290 --> 00:17:53,120
أهذه الفتاة التي أعادها هيديوشي معه؟

324
00:17:53,800 --> 00:17:57,350
لا أتوقّع أن يبقى نوبوناغا أودا
.صامتًا عن هذا

325
00:17:57,830 --> 00:18:00,110
على أقلّ تقدير، إن أصبحت بين يدي نوبوناغا

326
00:18:00,110 --> 00:18:02,260
.فستسوء الأمور أكثر

327
00:18:02,820 --> 00:18:05,790
علينا التحرّك

328
00:18:05,790 --> 00:18:08,010
.قبل أن يبدأ جيش أويسوغي بذلك

329
00:18:08,010 --> 00:18:09,270
!شينغين-ساما

330
00:18:10,320 --> 00:18:11,520
...المعركة

331
00:18:12,680 --> 00:18:14,280
!تقترب

332
00:18:27,810 --> 00:18:29,240
.صباح الخير

333
00:18:29,640 --> 00:18:32,420
آه، هل نمت؟

334
00:18:32,650 --> 00:18:33,550
.نعم

335
00:18:33,550 --> 00:18:35,920
.بدوتِ نائمة بعمق

336
00:18:36,700 --> 00:18:38,070
...أ-أنا آسفة

337
00:18:38,490 --> 00:18:41,430
.شكرًا لك على هذا

338
00:18:41,680 --> 00:18:43,150
.لا بأس

339
00:18:43,520 --> 00:18:46,440
.تمكّنت من إنهاء تخطيطي

340
00:18:46,820 --> 00:18:48,110
!أنا مسرورة

341
00:18:48,560 --> 00:18:53,010
.كنت قلقة أنّي كنت أعيقك بكوني هنا

342
00:18:53,010 --> 00:18:53,780
،نعم

343
00:18:53,780 --> 00:18:55,600
حسنًا، لأكون صريحًا

344
00:18:55,600 --> 00:18:57,310
.كان ذلك مزعجًا للغاية

345
00:18:59,420 --> 00:19:01,260
—لا! أعني

346
00:19:01,700 --> 00:19:04,450
لم أعنِ أن أشير أنّي
.لا أحب وجودك حولي

347
00:19:04,970 --> 00:19:06,450
ميتسوناري-سان؟

348
00:19:07,640 --> 00:19:10,750
كـ-كنتِ هنا معي لوحدنا لوقتٍ طويل

349
00:19:10,750 --> 00:19:12,580
.إلى أن انتهى بي المطاف بمشاهدتك نائمة

350
00:19:13,090 --> 00:19:15,460
هل اعتقدت أنّي سأتركك تبقين
دون أن أفعل شيئًا؟

351
00:19:15,700 --> 00:19:16,590
ماذا؟

352
00:19:17,590 --> 00:19:19,300
...آه، لا، المعذرة

353
00:19:19,670 --> 00:19:22,080
،لا أنام كثيرًا

354
00:19:22,440 --> 00:19:24,370
.لذا لم أعرف ما أفعل

355
00:19:25,320 --> 00:19:27,090
.هذا خطؤك

356
00:19:27,090 --> 00:19:29,730
.أرجوك لا تشعريني بالاضطراب ثانيةً

357
00:19:30,510 --> 00:19:32,030
...أنا آسفة

358
00:19:34,560 --> 00:19:37,410
.والآن، لنقدّم هذه الخطط

359
00:19:37,790 --> 00:19:39,520
.هيديوشي-ساما ينتظر

360
00:19:40,280 --> 00:19:41,240
.نعم

361
00:19:43,430 --> 00:19:44,380
،بعدها

362
00:19:44,380 --> 00:19:48,290
من أجل التعامل مع اللصوص الذين
،كانوا يتسببون بمعاناة سكّان المدينة بضربة واحدة

363
00:19:48,290 --> 00:19:51,790
.نفّذ هيديوشي الطوفان وفقًا للخطّة

364
00:19:53,950 --> 00:19:57,190
فقد اللصوص مكان هربهم
بسبب الطوفان الهائل

365
00:19:57,190 --> 00:20:01,400
من سدّ ماء النهر، وتمّ القبض
.عليهم بعدها واحدًا تلو الآخر

366
00:20:01,870 --> 00:20:06,010
شعر سكان المدينة بالامتنان
.الشديد لأعضاء عشيرة تويوتومي

367
00:20:06,430 --> 00:20:10,060
كانت خطّة اليوم مذهلة للغاية، أليس كذلك؟

368
00:20:11,120 --> 00:20:13,770
.سار كلّ شيء حسب خطّة هيديوشي-ساما

369
00:20:13,770 --> 00:20:15,910
.ويمكن القول أنّها أتت بأفضل النتائج

370
00:20:16,380 --> 00:20:19,170
!سنقيم حفلة ضخمة لهذا

371
00:20:19,710 --> 00:20:22,650
.بالطبع، أنتِ مرحّبٌ بك للانضمام أيضًا

372
00:20:22,970 --> 00:20:23,970
،هيديوشي-سان

373
00:20:23,970 --> 00:20:26,640
.هنالك شيءٌ مهم أريد الحديث معك به

374
00:20:27,850 --> 00:20:31,830
بدأت أفهمك أكثر قليلًا

375
00:20:32,060 --> 00:20:35,690
من الحديث مع الجميع
.ومن الحديث معك أيضًا

376
00:20:36,350 --> 00:20:39,710
لقد قرّرت الزواج منّي أخيرًا إذًا؟

377
00:20:39,960 --> 00:20:41,450
...قبل ذلك

378
00:20:41,450 --> 00:20:45,550
أعتقد أنّ هناك شيءٌ عنّي
.يستوجب عليّ إخبارك إيّاه

379
00:20:45,550 --> 00:20:47,600
.أخبريني، سأستمع لكلّ شيء

380
00:20:48,640 --> 00:20:52,010
.أنا... لست من هذا العالم

381
00:20:52,280 --> 00:20:54,640
.لهذا لا يمكنني الزواج منك

382
00:20:54,640 --> 00:20:55,690
.أنا آسفة

383
00:20:56,200 --> 00:20:57,400
ماذا تعنين؟

384
00:20:57,720 --> 00:21:01,160
وجدت نفسي مستلقيةً
،في هذا العالم فجأة

385
00:21:01,530 --> 00:21:04,000
وإن وجدت هيميميكو-ساما فلربما

386
00:21:04,000 --> 00:21:06,410
سأجد دليلًا عن كيفيّة
.العودة إلى عالمي

387
00:21:09,940 --> 00:21:13,120
أتعتقدينني سأصدّق كلّ هذا؟

388
00:21:14,070 --> 00:21:16,000
.أعتذر على إخفاء هذا عنك

389
00:21:16,550 --> 00:21:18,880
.ولكنّها الحقيقة

390
00:21:19,110 --> 00:21:23,810
حسنًا، شعرت أنّك مليئة بالغموض
،عندما قابلتك بالفعل

391
00:21:24,340 --> 00:21:26,660
ولكن... هل يمكنني سؤالك شيئًا؟

392
00:21:26,660 --> 00:21:27,460
.نعم

393
00:21:27,460 --> 00:21:29,250
هل تهتمين بشأن عالمك السابق؟

394
00:21:30,300 --> 00:21:31,250
.نعم

395
00:21:37,000 --> 00:21:38,430
.حسنًا إذًا

396
00:21:38,430 --> 00:21:41,200
،نحن نبحث عن هيميميكو أيضًا

397
00:21:41,200 --> 00:21:42,610
.لذا سنساعدك

398
00:21:42,610 --> 00:21:46,030
ولكن هذا لا يعني أنّي
.استسلمت بشأن الزواج بك

399
00:21:46,300 --> 00:21:47,100
ماذا؟

400
00:21:47,100 --> 00:21:52,040
أنوي أن أجعلك تقولين
.أنّك لا تريدين العودة

401
00:21:52,390 --> 00:21:54,530
.سأجعلك تشعرين هكذا حتمًا