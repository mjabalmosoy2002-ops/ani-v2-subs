1
00:00:03,680 --> 00:00:07,820
،الظهور كالندى والاختفاء كالندى
.هذه هي حياتي

2
00:00:08,640 --> 00:00:12,100
.حتّى عظمة شينرا هي حلم بداخل حلم

3
00:00:22,910 --> 00:00:25,650
قادة حرب استثنائيون
.يسعون لتوحيد بلاد

4
00:00:26,840 --> 00:00:32,350
.قدرهم على وشك الحراك

5
00:00:55,570 --> 00:00:57,190
إذًا لا بأس بالأحد القادم؟

6
00:00:57,830 --> 00:00:59,440
!نعم، أنا متحمّسة

7
00:00:59,550 --> 00:01:00,330
في أيّ وقت نلتقي؟

8
00:01:00,920 --> 00:01:01,950
.لا بأس بأيّ وقت

9
00:01:16,950 --> 00:01:18,000
مـ-ماذا؟

10
00:01:20,100 --> 00:01:20,510
ماذا؟

11
00:01:21,490 --> 00:01:22,080
!ما الذي يحدث؟

12
00:01:52,120 --> 00:01:53,720
أين... أنا؟

13
00:01:56,400 --> 00:01:58,880
لمَ أنا في مكانٍ كهذا؟

14
00:02:10,530 --> 00:02:11,260
ما الخطب؟

15
00:02:11,760 --> 00:02:13,980
!قواك ليست بهذا المستوى

16
00:02:14,300 --> 00:02:15,060
!اصمت

17
00:02:15,740 --> 00:02:18,900
ليس عليّ أن أخرج كلّ
!ما لدي ضد شخص مثلك

18
00:02:21,140 --> 00:02:22,710
مـ-ما هذا؟

19
00:02:23,610 --> 00:02:25,040
من هؤلاء؟

20
00:02:32,220 --> 00:02:34,880
ما الذي تفعله يا توشيي؟

21
00:02:48,080 --> 00:02:49,180
!أيّها الوغد

22
00:02:52,310 --> 00:02:54,060
.انظر خلفك

23
00:02:55,190 --> 00:02:56,470
دخان إشارة الانسحاب؟

24
00:02:58,990 --> 00:02:59,900
.ما باليد حيلة

25
00:03:03,080 --> 00:03:04,750
.سأقتلك في المرّة القادمة

26
00:03:05,800 --> 00:03:06,870
!كن جاهزًا

27
00:03:07,990 --> 00:03:09,820
!جميعكم تراجعوا

28
00:03:14,240 --> 00:03:17,360
.ياه، كانت هذه المعركة خطيرة

29
00:03:17,870 --> 00:03:20,080
كنت في وضعٍ حرج يا توشيي، أليس كذلك؟

30
00:03:20,730 --> 00:03:22,560
.لا يجب عليك أن تتصرّف بتهوّر

31
00:03:23,260 --> 00:03:26,390
.تدهورت خطتنا هذه المرّة بسبب توشيي

32
00:03:27,190 --> 00:03:28,320
!هذا غير صحيح

33
00:03:28,320 --> 00:03:29,550
.هوّن عليك

34
00:03:30,170 --> 00:03:33,680
ليس من الممتع أن يسير كلّ شيء
حسب الخطّة دائمًا، صحيح؟

35
00:03:34,280 --> 00:03:36,800
هيديوشي تويوتومي

36
00:03:36,880 --> 00:03:37,050
هاه؟

37
00:03:43,560 --> 00:03:44,040
.توشيي

38
00:03:44,400 --> 00:03:44,770
.نعم

39
00:03:46,140 --> 00:03:46,990
!رأوني؟

40
00:03:47,830 --> 00:03:48,990
!اخرج

41
00:03:52,360 --> 00:03:53,180
!بسرعة

42
00:04:00,910 --> 00:04:02,550
!ماذا؟ فتاة؟

43
00:04:03,910 --> 00:04:06,240
!هذا تطوّر غير متوقع للأحداث

44
00:04:06,470 --> 00:04:08,240
!وإنّك ترتدين ثيابًا غريبة أيضًا

45
00:04:08,580 --> 00:04:09,720
!دعيني أرى

46
00:04:10,080 --> 00:04:10,520
!لا

47
00:04:10,840 --> 00:04:13,770
أيّتها الوقحة! أتعرفين من يكون هذا؟

48
00:04:14,060 --> 00:04:15,520
.اهدأ يا توشيي

49
00:04:17,420 --> 00:04:18,150
هل أنتِ بخير؟

50
00:04:18,660 --> 00:04:20,990
ربّما إنّك خائفة فقط لأنّك أمامي؟

51
00:04:22,910 --> 00:04:24,350
أيمكن أنّك لا تعرفينه؟

52
00:04:25,080 --> 00:04:27,140
!إنّه هيديوشي تويوتومي-ساما

53
00:04:28,850 --> 00:04:32,620
قوّة جيشنا جيش تويوتومي يشكّل
.خطرًا على جيش أودا حاليًّا

54
00:04:33,310 --> 00:04:36,870
يُقال أنّ هيديوشي-ساما هو
.الأقرب لتوحيد البلاد

55
00:04:39,120 --> 00:04:40,880
تقصد هيديوشي تويوتومي ذاك؟

56
00:04:41,360 --> 00:04:42,250
.أجل

57
00:04:43,230 --> 00:04:46,720
.لا بدّ وأنّك متفاجئة لرؤية هيديوشي تويوتومي-ساما

58
00:04:48,390 --> 00:04:51,370
.لا يمكن... مستحيل

59
00:04:52,120 --> 00:04:54,880
إذًا لمَ لا تأخذين كلّ الوقت

60
00:04:59,090 --> 00:05:00,420
!حسنًا، قررت

61
00:05:00,940 --> 00:05:02,060
.ستأتين معي

62
00:05:03,440 --> 00:05:04,640
!ما الذي تقوله؟

63
00:05:04,740 --> 00:05:06,060
ما البأس يا ميتسوناري؟

64
00:05:06,730 --> 00:05:10,290
لا يمكننا ترك فتاة لوحدها في
مكانٍ كهذا، أليس كذلك؟

65
00:05:11,120 --> 00:05:11,620
...لـ-لكن يا سيّدي

66
00:05:12,030 --> 00:05:13,000
.اتّخذت قراري

67
00:05:14,250 --> 00:05:15,680
.هيّا، تعالي

68
00:05:28,420 --> 00:05:30,320
أين أكون؟

69
00:05:36,440 --> 00:05:38,000
...في الشهر الثالث

70
00:05:40,800 --> 00:05:41,210
،كما تعلم

71
00:05:42,070 --> 00:05:44,540
.أشعر بالفضول حقًّا حيال ماهيّة الكلمات المفقودة

72
00:05:44,090 --> 00:05:46,550
كانت مغطاة

73
00:05:47,030 --> 00:05:50,030
مغطاة بأزهار مُتفتّحة

74
00:05:52,240 --> 00:05:55,370
كينشين-ساما، أذهب كاغيكاتسو-ساما
وكانيتسوغو-ساما إلى مكان؟

75
00:05:57,100 --> 00:05:58,690
كينشين أويسوغي

76
00:05:59,250 --> 00:05:59,600
.نعم

77
00:06:00,260 --> 00:06:02,960
توجها نحو الجبال لجمع
.بعض الفاكهة

78
00:06:03,620 --> 00:06:05,580
.إنّهما مقرّبان من بعضهما حقًّا

79
00:06:06,320 --> 00:06:07,970
،على الرغم من أنّهما يستمتعان معًا

80
00:06:08,410 --> 00:06:10,900
.أصبحا بالغين الآن

81
00:06:13,040 --> 00:06:14,870
.لم يعُد كانيتسوغو نيّقًا حيال الطعام

82
00:06:14,990 --> 00:06:17,110
!ياه، هذا يعني أنّه كبر حقًّا

83
00:06:17,350 --> 00:06:21,390
اعتاد أن يضع طعامه غير المرغوب فيه
في أطباقي قائلاً أنه لن يأكلها أبدًا

84
00:06:24,410 --> 00:06:28,310
كاغيكاتسو-ساما أيضًا لديه
تعابير جليلة في المعركة

85
00:06:28,540 --> 00:06:29,890
.بالكاد يمكنني التعرف عليه أحيانًا

86
00:06:30,310 --> 00:06:34,150
.أصبح مشابهًا أكثر لكينشين-ساما مؤخّرًا

87
00:06:35,370 --> 00:06:37,580
.أتطلّع لمستقبل جيشنا

88
00:06:38,480 --> 00:06:39,890
،لهذا السبب

89
00:06:40,600 --> 00:06:42,290
.علينا هزيمة جيش تاكيدا حتمًا

90
00:06:42,660 --> 00:06:43,730
.كما تقول

91
00:06:44,690 --> 00:06:46,790
.إنّهم عدوّنا المحتّم في نهاية المطاف

92
00:06:47,410 --> 00:06:47,710
.نعم

93
00:06:48,420 --> 00:06:49,560
.لقد عدنا

94
00:06:50,540 --> 00:06:51,780
.تناولوا هذا جميعًا

95
00:06:51,890 --> 00:06:53,260
.كونوا ممتنين لنا

96
00:06:53,830 --> 00:06:55,820
.عانينا الكثير للحصول على هذه

97
00:06:56,670 --> 00:06:57,630
أليس كذلك يا كاغيكاتسو؟

98
00:06:58,880 --> 00:07:00,620
.نأمل أن تنال إعجاب الجميع

99
00:07:00,850 --> 00:07:02,750
.شكرًا لك يا كاغيكاتسو-ساما

100
00:07:05,970 --> 00:07:06,750
!لذيذة للغاية

101
00:07:06,910 --> 00:07:09,190
!أعطني لقمة أيضًا يا كانيتسوغو

102
00:07:09,520 --> 00:07:10,380
.لا أريد

103
00:07:21,240 --> 00:07:22,520
.كانت تلك ضربة جيّدة

104
00:07:22,910 --> 00:07:25,290
ولكن لا ترخِ هجومك فقط
!لأنّ هذا قتال مزيّف

105
00:07:26,060 --> 00:07:27,210
!تعال نحوي بنية القتل

106
00:07:27,210 --> 00:07:29,630
!أنا آتي نحوك هكذا دائمًا

107
00:07:33,540 --> 00:07:34,150
!هذا يكفي

108
00:07:37,190 --> 00:07:38,250
...نلتَ مني

109
00:07:39,140 --> 00:07:41,380
.يفوز نوبوهارو-سان اليوم أيضًا

110
00:07:41,880 --> 00:07:45,650
.لا يمكنني مجاراة نوبوهارو-سان أبدًا

111
00:07:46,130 --> 00:07:47,840
!سأواجهك ثانيةً في أيّ وقت

112
00:07:48,240 --> 00:07:49,190
.مرحبًا يا رفاق

113
00:07:50,270 --> 00:07:52,400
.إنّكم مفعمون بالطاقة منذ الصباح الباكر

114
00:07:53,000 --> 00:07:54,900
شينغين تاكيدا

115
00:07:55,280 --> 00:07:56,240
!شينغين-ساما

116
00:07:56,960 --> 00:07:58,070
!صباح الخير

117
00:07:59,040 --> 00:08:00,890
أين ماساتويو ذاك؟

118
00:08:01,160 --> 00:08:02,960
...لم يأتِ إلى التدريب

119
00:08:02,960 --> 00:08:04,270
.ا-المعذرة

120
00:08:04,930 --> 00:08:06,550
...أنا موجودٌ هنا

121
00:08:07,900 --> 00:08:10,000
!كـ-كنت موجودًا يا ماساتويو

122
00:08:10,480 --> 00:08:11,950
.أنا آسف، لم أرك

123
00:08:12,560 --> 00:08:14,480
.لا يهمني ذلك

124
00:08:14,830 --> 00:08:16,060
.هذا دائمًا ما يحدث

125
00:08:18,400 --> 00:08:19,010
!صحيح

126
00:08:21,750 --> 00:08:22,780
كيف شعوركم إذًا؟

127
00:08:23,330 --> 00:08:25,800
تبدون وكأنّكم لا تطيقون
.الانتظار حتّى المعركة

128
00:08:26,460 --> 00:08:28,500
.بالطبع يا شينغين-ساما

129
00:08:28,930 --> 00:08:32,680
سنطيح بهم بضربة واحدة
!في المعركة التالية

130
00:08:32,770 --> 00:08:36,800
.لننهِ القتال هذه المرّة مع جيش أويسوغي

131
00:08:37,440 --> 00:08:38,810
.نعم، صحيح

132
00:08:39,280 --> 00:08:41,120
!ابذلوا قصارى جهدكم يا رفاق

133
00:08:41,480 --> 00:08:42,240
!نعم

134
00:08:48,000 --> 00:08:49,340
.ها نحن ذا

135
00:08:49,800 --> 00:08:50,990
!أسلوب فنون النينجا الخاص

136
00:08:51,760 --> 00:08:53,250
!تقنية الزوبعة

137
00:08:55,900 --> 00:08:56,360
!آه

138
00:08:56,660 --> 00:08:58,810
سترسل مواد الخردة المتناثرة بعيدًا فحسب إذًا؟

139
00:08:59,580 --> 00:09:02,530
إنّها فكرة جيّدة اعتبارًا
...أنّها قادمة من ساسكي

140
00:09:04,320 --> 00:09:06,400
!لمَ هي آتية إلى هنا؟

141
00:09:19,490 --> 00:09:21,090
...أبلينا حسنًا

142
00:09:23,740 --> 00:09:24,720
!أنتما

143
00:09:24,950 --> 00:09:28,080
لماذا المكان مبعثر أكثر ممّا كان
!عندما بدأنا بإصلاح القلعة؟

144
00:09:29,870 --> 00:09:33,550
.ازداد عدد الياكوما كثيرًا هنا مؤخرًا

145
00:09:33,820 --> 00:09:34,160
.نعم

146
00:09:34,620 --> 00:09:37,390
.لم نرَ مجموعة ياكوما كهذه من قبل

147
00:09:37,620 --> 00:09:39,510
لا نعرف هويتهم

148
00:09:40,000 --> 00:09:42,550
.وبدؤوا بالازدياد مؤخرًا

149
00:09:44,930 --> 00:09:45,870
.أتساءل لماذا

150
00:09:45,870 --> 00:09:48,590
لا تتثاءب في منتصف
!اجتماع يا كامانوسكي

151
00:09:50,160 --> 00:09:51,670
الياكوما التي تستمر بالازدياد

152
00:09:52,340 --> 00:09:54,030
...والمسبّب ذلك

153
00:09:54,050 --> 00:09:56,520
يوكيمورا سانادا

154
00:10:00,980 --> 00:10:05,070
أمر نوبوناغا-ساما بإعطاء
.الساكي للرجال أيضًا

155
00:10:05,960 --> 00:10:08,240
.مفهوم. سأقوم بالترتيبات

156
00:10:09,840 --> 00:10:11,060
!سنقاتل ثانيةً غدًا

157
00:10:11,290 --> 00:10:12,930
!سأشرب اليوم حتمًا

158
00:10:13,020 --> 00:10:14,830
...يا إلهي، كاتسيي-سان

159
00:10:15,510 --> 00:10:16,860
،هذا يذكرني

160
00:10:17,200 --> 00:10:19,920
.وجد جيش تويوتومي شيئًا غريبًا اليوم

161
00:10:20,450 --> 00:10:21,430
شيءٌ غريب؟

162
00:10:21,870 --> 00:10:25,340
.التقط هيديوشي امرأة بلباس غير مألوفة

163
00:10:25,910 --> 00:10:28,400
.بدا لي وكأنّها فتاة من عالمٍ آخر

164
00:10:28,640 --> 00:10:29,940
وماذا بذلك؟

165
00:10:36,590 --> 00:10:38,120
.يبدو أنّه سيكون هنالك قتال غدًا

166
00:10:38,710 --> 00:10:40,720
،عندما يخلون القلعة للقتال

167
00:10:40,820 --> 00:10:42,920
.ستكون الفرصة المثالية لهجوم مباغِت

168
00:10:43,190 --> 00:10:44,980
ماذا نفعل يا ماساموني؟

169
00:10:45,920 --> 00:10:47,240
.ليست فكرة سيّئة

170
00:10:47,740 --> 00:10:48,290
...ولكن

171
00:10:49,280 --> 00:10:50,740
.أريد المزيد من المعلومات أوّلًا

172
00:10:51,310 --> 00:10:53,030
.هذا غير حاسم على الإطلاق

173
00:10:53,210 --> 00:10:54,340
.لا، لنفعل ذلك

174
00:10:54,960 --> 00:10:56,190
.من الأفضل أن ننتهز الفرصة

175
00:10:56,870 --> 00:10:57,560
.اترك الأمر لي

176
00:10:58,630 --> 00:11:00,190
.حسنًا، أعتمد عليك

177
00:11:02,470 --> 00:11:03,210
ماساموني داتي

178
00:11:04,370 --> 00:11:05,060
،في تلك الليلة

179
00:11:05,290 --> 00:11:08,080
عقد جيش تويوتومي اجتماع مجلس حرب

180
00:11:08,080 --> 00:11:09,790
.للاستعداد للقتال مع جيش أودا

181
00:11:10,410 --> 00:11:11,790
،سنأخذ مواقعنا

182
00:11:12,000 --> 00:11:14,190
نوزّع قوّة جيشنا وكلّ واحدٍ
.منّا سيهاجم أحد قادة حرب العدو

183
00:11:14,390 --> 00:11:16,150
.حسنًا، سنفعل هذا غدًا

184
00:11:16,520 --> 00:11:16,930
.حاضر

185
00:11:20,340 --> 00:11:21,050
.تعالي إلى هنا

186
00:11:22,560 --> 00:11:23,200
.حسنًا

187
00:11:24,400 --> 00:11:25,750
.سأعرفك على الجميع

188
00:11:26,560 --> 00:11:28,820
.ذلك الصارم هو ميتسوناري إيشيدا

189
00:11:30,030 --> 00:11:31,310
.مسرور لمقابلتك

190
00:11:31,720 --> 00:11:35,060
وذلك الشخص الرجولي المليء
.بالندبات هو توشيي مايدا

191
00:11:36,060 --> 00:11:36,880
.مسرور لمقابلتك

192
00:11:37,180 --> 00:11:39,290
!أعلميني إن كان هنالك ما يزعجك

193
00:11:39,760 --> 00:11:42,760
وأيضًا، النحيف شاحب الوجه
.هناك هو هانبي تاكيناكا

194
00:11:42,760 --> 00:11:43,600
ماذا؟

195
00:11:43,600 --> 00:11:46,140
!هذا تعريفٌ لئيم يا هيديوشي-ساما

196
00:11:46,810 --> 00:11:47,900
.مسرور لمقابلتك

197
00:11:48,350 --> 00:11:50,640
!أنا مسرور لقدوم فتاة ظريفة

198
00:11:51,020 --> 00:11:54,480
.وأيضًا، الصامت والداكن هو كانبي كورودا

199
00:11:56,940 --> 00:11:58,910
.سررت لمقابلتكم

200
00:11:59,340 --> 00:11:59,870
.نعم

201
00:12:02,680 --> 00:12:04,870
.والآن، حان الوقت للارتياح

202
00:12:05,700 --> 00:12:07,410
.لدينا معركة في الغد

203
00:12:07,910 --> 00:12:08,490
معركة؟

204
00:12:09,380 --> 00:12:09,870
،نعم

205
00:12:10,230 --> 00:12:13,250
القتال مع جيش أودا
!لم ينتهِ بعد

206
00:12:13,840 --> 00:12:15,150
.أنتِ تعالي معي

207
00:12:16,180 --> 00:12:17,910
!ا-انتظر من فضلك

208
00:12:18,420 --> 00:12:19,510
لمَ أنا أيضًا؟

209
00:12:19,920 --> 00:12:21,060
،حسنًا

210
00:12:21,310 --> 00:12:24,770
،لأنّ ساحات المعارك قذرة
.مليئة بالرجال وفظيعة

211
00:12:25,490 --> 00:12:29,400
!قدوم فتاة سيبهج الأمور قليلًا

212
00:12:29,840 --> 00:12:31,370
إنّها فكرة جيّدة، أليس كذلك؟

213
00:12:32,000 --> 00:12:33,350
!مـ-مستحيل

214
00:12:34,360 --> 00:12:36,450
،عندما يجد هيديوشي شيئًا يهتم به

215
00:12:36,540 --> 00:12:38,720
.فإنّه يبدأ بالحراك فورًا

216
00:12:39,650 --> 00:12:40,780
.هذا هو هيديوشي-ساما

217
00:12:41,280 --> 00:12:43,460
.عندما يقرّر شيئًا فإنّه يتم حتمًا

218
00:12:43,840 --> 00:12:44,440
...لكن

219
00:12:45,350 --> 00:12:46,820
،هذا مربك في البداية

220
00:12:47,550 --> 00:12:49,720
ستعتادين على طريقة تفكير
.هيديوشي-ساما مع الوقت

221
00:12:50,960 --> 00:12:52,400
بينما أنتِ في جيش تويوتومي

222
00:12:52,780 --> 00:12:55,300
.من الأفضل لك أن تنسي الحصول على حياة آمنة

223
00:12:55,960 --> 00:12:56,710
!لا بأس

224
00:12:57,440 --> 00:12:59,710
!نحن معك مهما حدث

225
00:13:02,950 --> 00:13:04,760
سأذهب أيضًا حقًّا؟

226
00:13:09,490 --> 00:13:10,290
ماذا أفعل؟

227
00:13:10,810 --> 00:13:14,360
.قد أُقتل إن جُررت إلى معركة الغد

228
00:13:15,120 --> 00:13:17,120
ربّما عليّ الهرب إلى مكانٍ آخر؟

229
00:13:18,400 --> 00:13:21,000
ولكن إلى أين؟

230
00:13:24,110 --> 00:13:25,200
!مرحبًا

231
00:13:26,720 --> 00:13:28,870
!تـ-تحدّث التانوكي

232
00:13:30,130 --> 00:13:31,180
!لستُ تانوكيًّا

233
00:13:31,750 --> 00:13:32,670
!اسمي إيماري

234
00:13:34,340 --> 00:13:37,010
.أرجوك استمعي لما سأقوله

235
00:13:37,550 --> 00:13:40,500
!أرجوك أعيريني قواك

236
00:13:41,050 --> 00:13:41,910
!أتوسّل إليك

237
00:13:46,170 --> 00:13:46,940
شينغا؟

238
00:13:47,420 --> 00:13:49,300
.نعم، هذه شينغا

239
00:13:49,800 --> 00:13:53,870
في شينغا، هنالك قبائل من مخلوقات
،غير بشريّة تملك قوى خاصّة

240
00:13:54,240 --> 00:13:57,120
.وعاشوا بسلام بسبب قوى هيميميكو-ساما

241
00:13:58,160 --> 00:13:58,850
...ولكن

242
00:13:59,220 --> 00:14:00,920
...من كان

243
00:14:01,060 --> 00:14:02,080
.كانت هيميميكو-ساما

244
00:14:02,340 --> 00:14:05,740
وكانت هيميميكو-ساما تلك
من اختفى بشكل غامض فجأة؟

245
00:14:06,430 --> 00:14:06,950
.نعم

246
00:14:07,690 --> 00:14:09,350
.أصبح العالم في فوضى حينها

247
00:14:09,760 --> 00:14:12,400
وقادة الحرب من قبائل عديدة
أقاموا جيوشهم

248
00:14:12,880 --> 00:14:15,410
.وبدؤوا بالقتال محاولين توحيد الدولة

249
00:14:16,030 --> 00:14:17,540
العديد من القبائل؟

250
00:14:18,340 --> 00:14:20,000
تعني من أمثالك؟

251
00:14:20,120 --> 00:14:21,770
.لا، أنا مختلف

252
00:14:22,180 --> 00:14:24,240
أتحدّث عن الذين يبدون كالبشر أكثر

253
00:14:24,630 --> 00:14:27,520
مثل المستذئبين ومصاصي الدماء
.الذين يتواجدون في هذا العالم

254
00:14:28,410 --> 00:14:28,660
ماذا؟

255
00:14:28,950 --> 00:14:31,610
قبل أن تختفي هيميميكو-ساما

256
00:14:31,930 --> 00:14:34,640
.أخبرتني أن أبحث عن فتاة من عالم آخر

257
00:14:35,360 --> 00:14:37,640
!والآن وجدتك أخيرًا

258
00:14:40,060 --> 00:14:43,190
أنتِ الدليل الوحيد الذي
!أملكه لإيجاد هيميميكو-ساما

259
00:14:43,520 --> 00:14:45,900
!أرجوك أعيريني قوتك

260
00:14:46,720 --> 00:14:47,450
،حسنًا

261
00:14:48,250 --> 00:14:53,420
يبدو بالفعل أنّي الفتاة من عالم آخر

262
00:14:53,810 --> 00:14:55,620
...الذي تحدثتَ عنها في قصتك، ولكن

263
00:14:56,380 --> 00:14:58,990
لحظة، أيعني هذا أنّ هيميميكو-ساما هذه

264
00:14:59,280 --> 00:15:01,740
قد تعرف لمَ أتيت إلى هنا؟

265
00:15:02,150 --> 00:15:06,020
إذًا يمكن أن تعرف أيضًا
كيف أعود إلى عالمي؟

266
00:15:06,770 --> 00:15:08,300
،لا أعرف بصراحة

267
00:15:08,580 --> 00:15:10,590
!ولكن لا بدّ وأنّ هيميميكو-ساما تعرف

268
00:15:11,160 --> 00:15:12,850
.حسنًا، فهمت

269
00:15:13,220 --> 00:15:15,600
.سأساعدك بالبحث عن هيميميكو-ساما

270
00:15:16,010 --> 00:15:19,680
قد أتمكن من معرفة طريقة للعودة
!إلى عالمي إن فعلت هذا

271
00:15:20,080 --> 00:15:21,170
!شكرًا لك

272
00:15:21,470 --> 00:15:22,150
...إذًا أوّلًا

273
00:15:23,910 --> 00:15:24,240
ماذا؟

274
00:15:25,080 --> 00:15:25,950
.كنتِ هنا إذًا

275
00:15:26,820 --> 00:15:29,240
.لـ-لم أتمكن من النوم

276
00:15:30,060 --> 00:15:30,730
.كوني حذرة

277
00:15:31,320 --> 00:15:34,340
لا تعرفين من قد يهاجمك
.عندما تكونين وحيدة

278
00:15:35,440 --> 00:15:35,940
.حسنًا

279
00:15:44,580 --> 00:15:46,590
.سأترك الأمور هكذا للآن

280
00:15:47,210 --> 00:15:48,990
.إلى أن نجد هيميميكو-ساما

281
00:15:54,900 --> 00:15:57,310
!أنا سآخذ المقدّمة

282
00:15:57,640 --> 00:15:59,310
!هيّا يا رجال

283
00:16:05,780 --> 00:16:07,790
.اخترقت وحدة توشيي خطوط العدو

284
00:16:08,540 --> 00:16:10,170
هانابي، هل أنت جاهز؟

285
00:16:10,760 --> 00:16:12,360
!حسنًا أيّها الجميع

286
00:16:12,840 --> 00:16:15,070
!سنهاجم رفقة وحدة كانبي

287
00:16:15,600 --> 00:16:17,600
!الوحدة الثانية، شكّلوا صفًّا على الفور

288
00:16:18,230 --> 00:16:21,370
استمروا بإرسال القوات لكي لا
.يرتاح العدو من المعركة السابقة

289
00:16:30,640 --> 00:16:31,360
ما الخطب؟

290
00:16:32,300 --> 00:16:32,780
هل أنتِ خائفة؟

291
00:16:36,100 --> 00:16:37,990
.نعم، أنا آسفة

292
00:16:38,700 --> 00:16:41,010
.هذه أوّل مرة لي لكلّ هذا

293
00:16:42,240 --> 00:16:45,600
من بين الجيوش العديدة، جيش
أودا الذي نقاتله الآن

294
00:16:46,380 --> 00:16:48,800
.لا نظير له بالضراوة والقوّة

295
00:16:50,430 --> 00:16:52,530
لو كانوا هم من وجدوك

296
00:16:52,850 --> 00:16:55,140
فإنّهم على الأرجح قد يقتلونك
.لداعي الاشتباه

297
00:16:56,000 --> 00:16:57,830
من الجيّد أنّنا وجدناك، هاه؟

298
00:16:58,410 --> 00:16:58,950
...نعم

299
00:16:59,640 --> 00:17:01,140
.لا داعي لأن تكوني خائفة إلى هذه الدرجة

300
00:17:01,680 --> 00:17:03,540
...حتّى وإن حدثت أسوأ الأمور

301
00:17:14,680 --> 00:17:16,050
!وجدنا هيديوشي

302
00:17:16,230 --> 00:17:17,220
!حاوطوه

303
00:17:17,610 --> 00:17:18,500
!هيديوشي-ساما

304
00:17:18,500 --> 00:17:20,070
!احموا هيديوشي-ساما

305
00:17:21,630 --> 00:17:22,450
!تعالي إلى هنا بسرعة

306
00:17:25,330 --> 00:17:26,900
!نلت منك

307
00:17:31,600 --> 00:17:32,720
.أرأيت؟ أنتِ بخير

308
00:17:33,290 --> 00:17:35,910
.أنا سأحميك، لذا لا تقلقي

309
00:17:36,460 --> 00:17:37,910
هذا ما أقوله للتظاهر بالروعة

310
00:17:38,540 --> 00:17:40,330
.ولكنّي أخفقت قليلًا

311
00:17:41,220 --> 00:17:42,310
لأنّك حميتني؟

312
00:17:42,890 --> 00:17:44,000
،ليس بالأمر الجلل

313
00:17:44,400 --> 00:17:44,830
.لنذهب

314
00:17:46,630 --> 00:17:47,890
!يفترض أنّه ما يزال قريبًا

315
00:17:48,330 --> 00:17:49,350
!تفرقوا وابحثوا

316
00:17:54,150 --> 00:17:56,350
.لا بأس. لن يجدونا

317
00:17:57,200 --> 00:17:57,970
.اقتربي أكثر

318
00:17:59,210 --> 00:18:00,030
ماذا أفعل؟

319
00:18:01,200 --> 00:18:04,350
.سيقتلوننا إن وجدونا على الأرجح

320
00:18:06,660 --> 00:18:07,570
هل أنت بخير؟

321
00:18:07,800 --> 00:18:09,630
.نعم، ليست بتلك السوء

322
00:18:10,470 --> 00:18:11,530
...ا-المعذرة

323
00:18:12,990 --> 00:18:15,240
هل هنالك ما يمكنني فعله؟

324
00:18:15,570 --> 00:18:15,820
ماذا؟

325
00:18:17,450 --> 00:18:18,080
...حسنًا

326
00:18:18,930 --> 00:18:21,510
.لقد جُرحت بسببي

327
00:18:24,050 --> 00:18:25,080
.هنالك شيء

328
00:18:25,700 --> 00:18:26,620
ما هو؟

329
00:18:27,550 --> 00:18:30,500
.خذي هذا السيف وقاتلي برفقتي

330
00:18:34,150 --> 00:18:35,780
...أمزح فحسب

331
00:18:35,780 --> 00:18:36,560
.فهمت

332
00:18:36,940 --> 00:18:37,280
ماذا؟

333
00:18:38,180 --> 00:18:39,870
،لم أقاتل من قبل

334
00:18:40,620 --> 00:18:42,340
!ولكنّي سأفعل كلّ ما بإمكاني

335
00:18:47,680 --> 00:18:50,770
عزيمتك قويّة على الرغم
من مظهرك، هاه؟

336
00:18:51,440 --> 00:18:53,060
!أصبحت مهتمًّا بك أكثر الآن

337
00:18:54,090 --> 00:18:58,240
عليّ أن أحسّن من نفسي مع
.امرأة مثلك بهذه الشجاعة

338
00:18:59,390 --> 00:18:59,920
!ها هم

339
00:19:01,380 --> 00:19:01,920
ولكن

340
00:19:02,950 --> 00:19:04,550
لا أريدك أن تعتقدي

341
00:19:05,080 --> 00:19:08,260
.أنّ الإمساك بي سيكون بهذه السهولة

342
00:19:13,610 --> 00:19:15,690
.لا تخافي، أصبحنا بخير الآن

343
00:19:17,810 --> 00:19:19,710
.أنا بخير

344
00:19:20,440 --> 00:19:22,220
،علينا العودة إلى الجميع

345
00:19:22,730 --> 00:19:24,530
.لا بدّ وأنّ ميتسوناري قلق للغاية

346
00:19:25,650 --> 00:19:26,500
!جرحك

347
00:19:27,360 --> 00:19:30,830
كنت متحمسًا قبل قليل لدرجة
.أنّي قد نسيت أمره

348
00:19:32,180 --> 00:19:33,570
!هذا ليس بشيءٍ يدفع للضحك

349
00:19:34,530 --> 00:19:35,520
!أنا بخير

350
00:19:35,810 --> 00:19:39,290
أنا لست بشرًا على أيّ حال، لذا
.جرحٌ كهذا سيشفى بسرعة

351
00:19:41,050 --> 00:19:42,700
.ولكن لا يمكننا تركه هكذا

352
00:19:48,590 --> 00:19:48,960
ماذا؟

353
00:19:49,660 --> 00:19:50,690
من أين أتى ذلك الجرح؟

354
00:19:51,630 --> 00:19:51,950
ماذا؟

355
00:19:54,480 --> 00:19:56,210
متى حدث ذلك؟

356
00:19:56,950 --> 00:19:58,800
لا بدّ وأنّ غصنًا قد جرحني
.عندما كنّا مختبئين

357
00:20:00,360 --> 00:20:03,100
.دمك يبدو لذيذًا

358
00:20:03,970 --> 00:20:04,150
ماذا؟

359
00:20:05,570 --> 00:20:07,150
لم أخبرك بعد، أليس كذلك؟

360
00:20:08,150 --> 00:20:11,680
.أعضاء تويوتومي مصاصو دماء

361
00:20:12,480 --> 00:20:13,500
!مصاصو دماء؟

362
00:20:13,950 --> 00:20:16,400
...ولكن، هذا غريب

363
00:20:17,400 --> 00:20:19,430
عادة، عندما أرى الدم

364
00:20:20,080 --> 00:20:23,230
فإنّي لا أشعر بهذه الرغبة
.الشديدة لشربه

365
00:20:24,080 --> 00:20:28,350
...آه، دماؤك رائحتها لطيفة للغاية

366
00:20:30,980 --> 00:20:35,270
إنّها تجعلني أشعر أنّي لا أستطيع
.الاستمرار دون شربها

367
00:20:36,390 --> 00:20:37,330
...القليل فقط

368
00:20:37,720 --> 00:20:38,540
...لحظة، توقّف

369
00:20:47,640 --> 00:20:48,350
.أنا آسفة

370
00:20:48,940 --> 00:20:50,310
.لعقت القليل فقط

371
00:20:51,200 --> 00:20:52,960
...لا تخافي إلى هذه الدرجة

372
00:20:54,150 --> 00:20:54,610
هاه؟

373
00:20:58,910 --> 00:20:59,480
ماذا؟

374
00:21:19,620 --> 00:21:20,650
هل أنت بخير؟

375
00:21:26,910 --> 00:21:27,730
أيمكن...؟

376
00:21:27,940 --> 00:21:31,390
هل جراح مصاصي الدماء تشفى بهذه السرعة؟

377
00:21:32,560 --> 00:21:35,480
لا، ما كنّا لنعاني كثيرًا
.لو كانت تشفى بهذه السرعة

378
00:21:37,060 --> 00:21:37,700
.فهمت

379
00:21:38,200 --> 00:21:40,510
.هذا يعني أنّي لم أشرب ما يكفي

380
00:21:41,380 --> 00:21:43,110
هذا منطقي

381
00:21:44,210 --> 00:21:45,330
.أنا متفاجئ

382
00:21:45,680 --> 00:21:48,510
.من كان يعتقد أنّ دمك مميّز للغاية

383
00:21:48,940 --> 00:21:50,130
استيقظت إذًا؟

384
00:21:54,040 --> 00:21:55,340
،لم أرك منذ مدّة

385
00:21:59,250 --> 00:21:59,820
.أيّها القرد

386
00:22:02,220 --> 00:22:03,350
...نوبوناغا

387
00:22:04,900 --> 00:22:05,550
.ساما