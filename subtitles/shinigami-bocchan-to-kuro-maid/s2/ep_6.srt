1
00:00:01,290 --> 00:00:08,320
أيمكنك تصوّر حياة حيث لا تستطيع
لمس الشخص الذي تحبّه؟

2
00:00:09,130 --> 00:00:14,130
تسبّبت اللعنة التي أُلقيت عليه من قِبل
الساحرة بسلبه لحيوات أيّ من يمسّهم

3
00:00:14,820 --> 00:00:19,150
نأت أمه بنفسها عنه، ونعته أصدقاؤه بالوحش

4
00:00:19,150 --> 00:00:20,440
حتّى الأشخاص الذين لم يقابلهم قطّ

5
00:00:20,440 --> 00:00:23,270
"تكلّموا عنه بصفته "تجسّد الموت الذي يقطن الغابة

6
00:00:24,370 --> 00:00:29,250
لكنّه... لا يشعر بأية وحدة

7
00:00:31,900 --> 00:00:33,330
...أنا

8
00:00:36,350 --> 00:00:38,680
بغاية الوحدة

9
00:00:44,410 --> 00:00:47,100
أنا أحسدكما

10
00:00:48,090 --> 00:00:49,820
لديكما عائلة

11
00:00:53,040 --> 00:00:55,030
مضت أربعة أيّام؟

12
00:00:55,380 --> 00:00:59,570
لم أتصوّر أن نمضي ذاك الوقت في السيرك

13
00:00:59,570 --> 00:01:01,990
لا بدّ أنّ روب-سان قلق

14
00:01:02,500 --> 00:01:06,260
آمل أنّ روب لم يقرّر تنظيف غرفتي

15
00:01:07,070 --> 00:01:09,960
فهو يزيل الأشياء التي أحتاجها

16
00:01:09,960 --> 00:01:14,450
قمتُ بتنظيفها قبل مغادرتنا، فيمكنك الاطمئنان

17
00:01:14,910 --> 00:01:18,220
حرّكتُ الأشياء التي كنت
تخفيها تحت السرير أيضاً

18
00:01:19,040 --> 00:01:20,810
لا أخفي شيئاً هناك

19
00:01:22,310 --> 00:01:24,150
لا أفعل، صحيح؟

20
00:01:24,490 --> 00:01:25,530
أليس؟

21
00:01:25,530 --> 00:01:28,420
!لمَ تبتسمين يا أليس؟

22
00:03:00,480 --> 00:03:01,740
!رجعنا

23
00:03:02,180 --> 00:03:03,950
!سـ-سيّدي الشاب

24
00:03:04,350 --> 00:03:06,910
!يسرّني... يسرّني أنّك بخير

25
00:03:07,930 --> 00:03:10,280
!لا تحاول عناقي! ذلك خطر

26
00:03:10,280 --> 00:03:12,630
أعتذر على غيابنا لوقتٍ طويل

27
00:03:12,940 --> 00:03:18,330
لا، عمل كبير الخدم هو حراسة
المنزل في غياب سيّده

28
00:03:18,330 --> 00:03:20,150
...دعاني أقولها من جديد

29
00:03:20,150 --> 00:03:23,450
مرحباً بعودتكما يا سيّدي الشاب وأليس-دونو

30
00:03:24,400 --> 00:03:26,080
!رجعنا يا روب

31
00:03:27,230 --> 00:03:30,520
أنهيتُ دراستي لهذا اليوم

32
00:03:30,940 --> 00:03:34,480
التعليم العام والسياسة والاقتصاد

33
00:03:34,480 --> 00:03:37,880
واللغات ودروس الموسيقى ودروس الغولف

34
00:03:37,880 --> 00:03:40,380
لا أواجه مشاكلاً مع أّيّ منها

35
00:03:41,210 --> 00:03:41,910
فهمت

36
00:03:51,210 --> 00:03:56,050
بحلول الربيع، سيفقد الأكبر حقّه ليكون الوريث

37
00:03:56,050 --> 00:03:58,300
ثمّ سأصبح من يرث هذا المنزل

38
00:03:59,600 --> 00:04:01,050
لكن لا يكفي ذلك

39
00:04:01,980 --> 00:04:05,250
!عليّ إظهار تفوّق عليه

40
00:04:05,700 --> 00:04:10,430
يجب أن أجعل أمّي تدرك
أنّي الجدير بأن يكون الوريث

41
00:04:11,070 --> 00:04:13,800
لكن لا وقت يكفي قبل الربيع

42
00:04:14,150 --> 00:04:15,440
ما عليّ أن أفعل؟

43
00:04:16,260 --> 00:04:20,970
ربما يمكنني تحسين مكياجي وتجربة
عمليّة الإغواء 2؟

44
00:04:21,290 --> 00:04:24,660
!لا! أكره الرقم 2

45
00:04:26,330 --> 00:04:28,580
مرحباً يا أخي والتر

46
00:04:29,250 --> 00:04:31,290
فيولا؟

47
00:04:32,290 --> 00:04:34,750
قلت أنّي أصبحتُ أبدن؟

48
00:04:34,750 --> 00:04:38,250
لا، أنت تحاول أكل لقمة
من حلوى المكرون خاصّتي وحسب

49
00:04:38,480 --> 00:04:41,010
!لن أعطيك ولا واحدة

50
00:04:41,010 --> 00:04:43,260
!انظري لجوربيك الطويلين المسكينين

51
00:04:44,070 --> 00:04:45,540
!الدهون تطفح منهما

52
00:04:48,100 --> 00:04:51,330
من يكترث إن ارتفع وزني قليلاً؟

53
00:04:51,330 --> 00:04:53,480
!فأنا لا أزال في طور النموّ

54
00:04:53,480 --> 00:04:56,800
!أنا قلقٌ من إفسادكِ لصحّتك بارتفاع وزنك

55
00:04:56,800 --> 00:05:01,530
إذا لم تستطيعي التحكّم بنفسك، فلن يكون
!أمامكِ خيار سوى أن تصبحي خادمة أمّك

56
00:05:02,810 --> 00:05:03,690
...كما

57
00:05:04,040 --> 00:05:07,400
أفترض أنّ روب-سان يميل للفتيات النحيفات

58
00:05:07,400 --> 00:05:08,070
غالباً

59
00:05:10,490 --> 00:05:11,910
!وقت بدء حمية

60
00:05:12,350 --> 00:05:16,620
...سأقطع الوجبات الخفيفة وأحسب السعرات الحراريّة

61
00:05:16,620 --> 00:05:19,960
لكن ماذا أفعل للتمرين؟

62
00:05:19,960 --> 00:05:23,840
لستُ خبيراً، لكن يمكنني
إخبارك بما سمعته وحسب

63
00:05:23,840 --> 00:05:26,320
قومي بتمارين التمدد الشاملة بانتظام

64
00:05:28,650 --> 00:05:31,840
نضيف المشي والتمارين الهوائيّة الأخرى

65
00:05:31,840 --> 00:05:34,060
...قلّلي من السعرات الحراريّة لحدّ معقول

66
00:05:34,300 --> 00:05:36,320
!أريد ميلي فوي

67
00:05:36,320 --> 00:05:38,230
!أريد كوغلوف

68
00:05:38,230 --> 00:05:40,270
!بدأتِ حمية لتوّك

69
00:05:40,270 --> 00:05:44,720
لكن هنالك بعض المزايا لاكتساب
بضعة أرطال، أليس كذلك؟

70
00:05:44,720 --> 00:05:47,240
!انظر! لديّ أثداء

71
00:05:47,240 --> 00:05:51,490
المسيها بينما يمكنكِ، فستختفي بعدما تنحفين

72
00:05:51,490 --> 00:05:53,310
!جيّد يا فيولا

73
00:05:53,310 --> 00:05:55,830
!في كلّ مرّة تركليني، تحرقين سعرات حراريّة

74
00:05:55,830 --> 00:05:58,070
!أكثر! اركليني

75
00:05:58,070 --> 00:06:00,440
!اضربيني الآن! أقوى

76
00:06:00,440 --> 00:06:04,250
!جيّد! جيّد

77
00:06:05,120 --> 00:06:09,760
...خمسة عشر، ستّة عشر، سبعة عشر

78
00:06:09,760 --> 00:06:10,830
لم أعد أستطيع التحمّل

79
00:06:12,970 --> 00:06:14,350
!في البداية فحسب

80
00:06:14,350 --> 00:06:15,670
يصبح الأمر مسليّاً عندما تعتادين عليه

81
00:06:15,670 --> 00:06:17,430
لا تجلس أمامي

82
00:06:18,920 --> 00:06:20,400
لا تنظر لي

83
00:06:22,340 --> 00:06:25,270
!يكفي! تعبت! لا أستطيع المواصلة

84
00:06:29,800 --> 00:06:31,880
...لكنّي لا أستطيع

85
00:06:34,620 --> 00:06:38,640
لن يصغي أحدٌ لنصائحكِ العاطفيّة
!ما لم تقوّمي نفسك

86
00:06:38,640 --> 00:06:40,550
!اعملي أكثر

87
00:06:41,290 --> 00:06:42,790
!اصمت

88
00:06:43,160 --> 00:06:45,390
!انسَ الحمية

89
00:06:45,390 --> 00:06:50,010
سيتفهّم روب حتّى لو كنت
!بدينة بعض الشيء

90
00:06:51,590 --> 00:06:53,140
لا أريدكِ أن تستسلمي

91
00:06:55,290 --> 00:06:58,280
من السهل اتّباع التيّار، يعطي شعوراً رائعاً

92
00:06:58,600 --> 00:07:02,890
لكن هناك أوقاتٌ حيث عليك الصمود
إن أردتِ تغيير شيء

93
00:07:04,980 --> 00:07:09,660
أعرف أنّكِ تعملين جاهدة أكثر
من أيّ أحدٍ يا فيولا

94
00:07:11,240 --> 00:07:12,780
ما الخطب يا فيولا؟

95
00:07:13,610 --> 00:07:19,620
غضبت أمّي وقالت أنّ عليّ اللعب
!ببراعة أخي الأكبر

96
00:07:19,620 --> 00:07:21,520
هو من جديد؟

97
00:07:21,520 --> 00:07:26,890
أخي والتر، سأبذل جهدي حتّى أستطيع
!اللعب ببراعة، لذا تمرّن معي

98
00:07:27,940 --> 00:07:30,470
أنتِ شخص قادر على الاجتهاد
عندما لا يراه أحد

99
00:07:30,750 --> 00:07:32,660
لذا لا تستسلمي

100
00:07:33,100 --> 00:07:34,930
!لا تخسري أمام كسلكِ

101
00:07:35,240 --> 00:07:37,390
!أنتِ لها! أعرف أنّكِ تستطيعين

102
00:07:37,390 --> 00:07:43,430
!أنتِ لها يا فيولا

103
00:07:43,430 --> 00:07:44,650
!حسناً

104
00:07:45,120 --> 00:07:47,570
سأبذل جهدي لروب

105
00:07:47,840 --> 00:07:49,530
لذا دعني وشأني لفترة

106
00:07:49,530 --> 00:07:51,710
!حسناً، سأهتف لكِ

107
00:07:57,030 --> 00:07:58,810
لن أخسر بدوري

108
00:07:59,250 --> 00:08:05,000
عليّ إثبات أنّي أفضل من
!أخي الأكبر الساذج

109
00:08:07,690 --> 00:08:09,460
فلأذهب للبلدة

110
00:08:11,160 --> 00:08:13,930
انظرا لكلّ هذه القمامة

111
00:08:14,520 --> 00:08:16,440
أليس عددها أكبر من ذي قبل؟

112
00:08:16,920 --> 00:08:19,140
لا أستطيع رمي هديّة

113
00:08:19,590 --> 00:08:23,100
...صحيح، أعطيتكُ بعض هذه

114
00:08:24,170 --> 00:08:27,200
يوجد الكثير هنا حقّاً

115
00:08:32,340 --> 00:08:34,820
!انظري لهذا يا أليس-دونو

116
00:08:35,240 --> 00:08:36,410
!مفاجأة

117
00:08:36,410 --> 00:08:40,540
مجموعة رسومات رسمها السيّد
!الشاب في صغره

118
00:08:40,900 --> 00:08:42,820
لمَ تملك هذه؟

119
00:08:42,820 --> 00:08:44,250
أودّ الاطّلاع عليها

120
00:08:44,650 --> 00:08:48,090
سأمنحكِ إيّاها إذاً

121
00:08:48,390 --> 00:08:50,710
!لا تعطها إيّاها! إنّها تخصّني

122
00:08:51,760 --> 00:08:54,420
هل عليّ أن أعيدها لك؟

123
00:08:54,810 --> 00:08:57,140
!يـ-يمكنكِ أخذها يا أليس

124
00:08:57,140 --> 00:08:58,840
!شكراً لك

125
00:08:58,840 --> 00:09:00,840
إنّه سهل الإقناع دوماً

126
00:09:00,840 --> 00:09:02,100
!لا يحقّ لك الكلام

127
00:09:04,490 --> 00:09:08,560
!لديّ هدايا لك من جماعة سيرك الجوزاء

128
00:09:08,560 --> 00:09:10,890
من جماعة السيرك؟

129
00:09:10,890 --> 00:09:13,780
!لم ألتقهم حتّى، ذلك لطفٌ منهم

130
00:09:14,310 --> 00:09:17,280
بدايةً، تذاكر للسيرك من الرئيس

131
00:09:17,990 --> 00:09:20,740
ومن هوغو، سدّادة قنّينة موقّعة

132
00:09:20,740 --> 00:09:24,160
كان يخبرني بأنّه سيصبح أعظم فنّان
ترفيهيّ في العالم يوماً ما

133
00:09:24,160 --> 00:09:25,390
وستمتلك قيمة عندها

134
00:09:26,130 --> 00:09:27,940
!أتطلّع لذلك

135
00:09:27,940 --> 00:09:30,460
أعطتك كاف هذه الحصاة التي تشبه قطّاً

136
00:09:30,940 --> 00:09:33,280
قالت أنّها نالت إعجابها
وكانت تحملها لفترة

137
00:09:33,280 --> 00:09:34,670
لكنّها ستجعل منها هديّة مميّزة لك

138
00:09:35,000 --> 00:09:37,970
يا للطف كاف-دونو

139
00:09:37,970 --> 00:09:41,890
أعطاني بقيّة أعضاء السيرك مجموعة متنوّعة
!من الأشياء أيضاً، فجلبتها كلّها

140
00:09:41,890 --> 00:09:45,100
!تبدو كلّها رائعة، أحبّها

141
00:09:45,410 --> 00:09:49,220
ومن زاين، منظار صغير

142
00:09:49,220 --> 00:09:52,070
إنّه خفيف ومناسب لمراقبة الطيور

143
00:09:53,700 --> 00:09:54,780
ما هذا؟

144
00:09:55,280 --> 00:09:56,640
أيمكنك أن أترى؟

145
00:09:56,640 --> 00:09:58,490
أنتِ كلّ ما أرى

146
00:09:59,280 --> 00:10:01,950
لديّ هديةٌ لك أيضاً يا روب-سان

147
00:10:02,570 --> 00:10:03,880
ما هي؟

148
00:10:03,880 --> 00:10:07,400
حبوب قهوة، أعتذر على أنّها ليست
مثيرة للاهتمام مثل هدايا الآخرين

149
00:10:07,400 --> 00:10:11,960
،لمَ تعتذرين؟ أنتِ ظريفة
!لذا كلّ ما تفعلينه مقبول

150
00:10:12,570 --> 00:10:15,170
!وأنا جلبتُ لك لوح شطرنج جديد

151
00:10:15,170 --> 00:10:17,210
ما رأيك؟ هل أعجبتك؟

152
00:10:18,900 --> 00:10:24,230
!أنا ممتنٌّ جدّاً لكما ولطاقم السيرك

153
00:10:24,230 --> 00:10:27,050
يا لسعادتي

154
00:10:27,050 --> 00:10:28,560
!ذلك رائع

155
00:10:28,930 --> 00:10:31,330
اسمع، لمَ لا نلعب جولة شطرنج؟

156
00:10:31,330 --> 00:10:33,740
بالطبع، لا أمانع

157
00:10:33,740 --> 00:10:35,970
سأحضر مأكولات حلوة

158
00:10:35,970 --> 00:10:38,530
شكراً لكِ

159
00:10:45,400 --> 00:10:47,410
...يبدو أنّي

160
00:10:48,380 --> 00:10:51,350
لست بالوحدة التي خلتها

161
00:10:52,750 --> 00:10:56,090
يا لي من سعيد الحظّ

162
00:11:20,680 --> 00:11:22,120
!قبّلا بعضهما

163
00:11:22,450 --> 00:11:24,260
أرأيت ذلك يا هوغو؟

164
00:11:24,260 --> 00:11:26,610
!أجل! إنّهما ظريفان

165
00:11:26,610 --> 00:11:29,120
يا إلهي، ها قد تخبّر وقتنا الانفراديّ

166
00:11:30,570 --> 00:11:32,520
،كان يُفترض أنّه موعد شاعريّ اليوم

167
00:11:32,520 --> 00:11:36,010
لكن أراد منّي الرئيس إيجاد
فكرة لفقرة جديدة للسيرك

168
00:11:36,810 --> 00:11:38,890
وقرّر طرف ثالث مزعج مرافقتنا

169
00:11:40,050 --> 00:11:42,050
،كان يُفترض أنّه موعدنا الرسميّ الأوّل

170
00:11:42,050 --> 00:11:43,830
لكنّه ليس شاعريّاً أبداً

171
00:11:43,830 --> 00:11:45,510
هذا موعدٌ حقّاً، صحيح؟

172
00:11:46,240 --> 00:11:48,640
لا شيء مثير في النظر للحيوانات

173
00:11:48,640 --> 00:11:48,970
!هذا

174
00:11:52,860 --> 00:11:55,450
حسناً، ربما الأمر ليس بذاك السوء

175
00:11:55,860 --> 00:12:00,400
لكنّي لا أعرف ما الذي
ستقوم به داليث تالياً

176
00:12:00,890 --> 00:12:04,410
استمعتُ سحري الزمنيّ كما أرادت

177
00:12:05,840 --> 00:12:08,260
لكن ما هو هدفها بالضبط؟

178
00:12:08,860 --> 00:12:12,670
ما الذي تجنيه من استعمالي لسحري؟

179
00:12:13,530 --> 00:12:17,980
ذكرت شيئاً عن إيقاظ أمّ أليس-تشان من نومها

180
00:12:17,980 --> 00:12:19,920
لكنّي لا أستطيع الوثوق بذلك

181
00:12:22,320 --> 00:12:24,550
لمَ أنت عبوسٌ هكذا؟

182
00:12:25,050 --> 00:12:27,510
!لننظر للحيوانات معاً يا زاين

183
00:12:27,510 --> 00:12:28,660
!بالطبع

184
00:12:28,660 --> 00:12:30,300
أيمكنني معانقتكِ؟

185
00:12:30,300 --> 00:12:32,160
!توقّف عندك أيّها الوحش الشهوانيّ

186
00:12:32,570 --> 00:12:34,700
!هيّا، لنذهب للمنطقة التالية

187
00:12:50,970 --> 00:12:52,410
!انظر يا زاين

188
00:12:52,410 --> 00:12:54,660
!إنّها تحبّني

189
00:12:57,500 --> 00:13:00,230
!كفّ عن رمق كاف بنظرات بذيئة

190
00:13:00,230 --> 00:13:03,410
!توقّف عن ضربي طوال الوقت

191
00:13:03,410 --> 00:13:04,970
أنا حبيبها

192
00:13:04,970 --> 00:13:08,570
تمكّنت من طلب مواعدتها لأنّي
أعطيتك دفعةً وحسب

193
00:13:08,570 --> 00:13:10,260
أنا ممتنٌّ لذلك

194
00:13:10,260 --> 00:13:11,670
شكراً لك

195
00:13:11,670 --> 00:13:13,290
!يا لظرافتك

196
00:13:13,290 --> 00:13:15,640
لا أنوي اعتراض طريقك

197
00:13:16,260 --> 00:13:18,110
لكنّي أحبّ كاف أيضاً

198
00:13:18,460 --> 00:13:21,060
ولا أملك شخصاً آخراً ألهو معه

199
00:13:21,400 --> 00:13:23,370
ماذا عن رفاقك النشّالين؟

200
00:13:23,880 --> 00:13:25,910
قطعتُ رابطتي بهم منذ وقتٍ طويل

201
00:13:25,910 --> 00:13:29,830
بغضهم غاضبون منّي للرحيل

202
00:13:30,270 --> 00:13:31,830
!لكنّي لم أعد أهتمّ

203
00:13:32,950 --> 00:13:35,990
لذا دعني أرافقكما من حينٍ لآخر، اتّفقنا؟

204
00:13:35,990 --> 00:13:37,720
واعتنِ بكاف

205
00:13:37,720 --> 00:13:40,590
أجل، دع الأمر لي

206
00:13:46,410 --> 00:13:47,960
!قفص الأسد

207
00:13:47,960 --> 00:13:48,740
ماذا؟

208
00:13:49,610 --> 00:13:54,300
زاين، أكنت تعرف أنّهم يدعون
الأسد بملك الوحوش؟

209
00:13:54,300 --> 00:13:56,580
أنتِ واسعة الاطّلاع حقّاً يا كاف

210
00:13:57,850 --> 00:13:59,850
لكنّ هذا محبوبٌ حقّاً

211
00:13:59,850 --> 00:14:02,570
بالكاد يمكننا رؤية أيّ شيء

212
00:14:03,740 --> 00:14:04,520
تعال

213
00:14:04,980 --> 00:14:06,310
يمكنك الرؤية الآن، صحيح؟

214
00:14:06,310 --> 00:14:08,370
!أجل، شكراً لك يا زاين

215
00:14:08,370 --> 00:14:09,130
ماذا؟

216
00:14:09,130 --> 00:14:09,990
ما الخطب؟

217
00:14:10,300 --> 00:14:13,730
لا... كلّ ما بالأمر أنّي
لم أرَ أسداً قبلاً

218
00:14:13,730 --> 00:14:15,700
أذلك أسدٌ حقّاً؟

219
00:14:22,730 --> 00:14:26,340
"الباندا الأحمر الأسد، صديق الجميع"

220
00:14:27,370 --> 00:14:29,050
!لا تسمّوا الحيوانات بأسماء مُربكة

221
00:14:32,650 --> 00:14:35,130
هل ستذهبان لرؤية أليس والدوق الآن؟

222
00:14:35,130 --> 00:14:38,980
أجل، فالسيرك مغلق غداً

223
00:14:39,260 --> 00:14:41,400
علينا الذهاب للقائهما
عندما تسنح الفرصة

224
00:14:41,400 --> 00:14:43,950
!أريد الكلام مع أليس كثيراً

225
00:14:44,380 --> 00:14:49,150
!حسناً، لن أضايقكما أكثر من هذا إذاً

226
00:14:49,150 --> 00:14:51,200
!أراكِ غداً يا كاف

227
00:14:51,200 --> 00:14:53,370
!فلتنتبه لحدودك يا زاين

228
00:14:53,370 --> 00:14:54,730
!إلى اللقاء

229
00:14:55,860 --> 00:14:58,580
ما قصده بحدودي؟

230
00:14:59,320 --> 00:15:01,790
كان موعدنا مُسلياً، صحيح يا زاين؟

231
00:15:02,390 --> 00:15:03,630
أيمكنني تقبليكِ؟

232
00:15:03,630 --> 00:15:04,250
كلّا

233
00:15:04,830 --> 00:15:06,340
دعيني ألمس أثداءكِ إذاً

234
00:15:09,910 --> 00:15:12,050
أفسدت الأمر على نفسك

235
00:15:12,400 --> 00:15:14,680
لا أمل منك

236
00:15:40,890 --> 00:15:42,060
!رأيتم

237
00:15:43,640 --> 00:15:45,990
...رأى أحدٌ وجهي

238
00:15:46,890 --> 00:15:49,090
!بعدما كدحتُ لإخفائه طوال الوقت

239
00:15:49,800 --> 00:15:53,120
...هذا الوجه القبيح

240
00:15:53,600 --> 00:15:56,270
هذه الجراح التي لا يستطيع
...حتّى السحر علاجها

241
00:15:57,270 --> 00:16:01,240
...أتفهمين مدى وحدتي

242
00:16:03,020 --> 00:16:03,880
يا أختي؟

243
00:16:09,060 --> 00:16:11,780
يا إلهي، الحظّ ليس في صفّنا

244
00:16:12,160 --> 00:16:13,920
كانت السماء صافية

245
00:16:13,920 --> 00:16:15,990
لم أتصوّر أن تهبّ عاصفة ثلجيّة فجأةً

246
00:16:16,700 --> 00:16:19,410
لعلّ الطقس سريع التقلّب عند الجبال

247
00:16:19,410 --> 00:16:22,410
وكنتُ متطلّعاً للقاء أليس-تشان

248
00:16:23,330 --> 00:16:24,320
أجل

249
00:16:24,320 --> 00:16:26,730
لن نستطيع الذهاب هكذا

250
00:16:27,820 --> 00:16:30,200
،أودّ العودة للبلدة عندما تتوقّف

251
00:16:30,200 --> 00:16:32,920
لكن ربما سيتعيّن علينا البقاء هنا لفترة

252
00:16:35,910 --> 00:16:37,810
خذي معطفي

253
00:16:37,810 --> 00:16:39,660
لا، لستُ أشعر بالبرد

254
00:16:40,000 --> 00:16:43,110
!لا، يمكنني الرؤية عبر ثيابكِ

255
00:16:43,840 --> 00:16:46,360
أم أيمكنني التحديق؟

256
00:16:46,360 --> 00:16:47,950
بالطبع لا

257
00:16:48,400 --> 00:16:50,780
سأستعمل سحري لتجفيفها، لستُ بحاجة معطفك

258
00:16:56,690 --> 00:16:59,800
مضى وقتٌ مُذ بقينا بمفردنا

259
00:16:59,800 --> 00:17:01,120
معكِ حقّ

260
00:17:01,120 --> 00:17:04,250
دائماً ما يكون هوغو أو
أحد من السيرك بجوارنا

261
00:17:05,250 --> 00:17:06,390
...ليلتنا الأولى

262
00:17:06,390 --> 00:17:08,330
كحبيبين

263
00:17:08,630 --> 00:17:10,320
شاعريّ

264
00:17:10,320 --> 00:17:11,460
شهوانيّ

265
00:17:12,010 --> 00:17:15,890
زاين، لمَ لا نقوم بشيء
لا يمكن لسوانا فعله؟

266
00:17:16,510 --> 00:17:17,600
شيء منحرف؟

267
00:17:17,600 --> 00:17:19,180
!كلّا! سأضربك إن واصلت هذا

268
00:17:19,480 --> 00:17:21,160
!كوني لطيفةً على الأقل

269
00:17:21,160 --> 00:17:22,270
فلتشاهد وحسب

270
00:17:23,930 --> 00:17:25,730
خمّن ما هذا الحيوان

271
00:17:26,230 --> 00:17:27,320
ثعلب؟

272
00:17:27,650 --> 00:17:28,960
أتذكّر هذا

273
00:17:28,960 --> 00:17:31,210
كنّا نلعب هذه اللعبة طوال الوقت في صغرنا

274
00:17:31,210 --> 00:17:32,000
أجل

275
00:17:32,000 --> 00:17:32,940
لنلعب أكثر

276
00:18:03,900 --> 00:18:05,740
...جمل، فرس نهر

277
00:18:05,740 --> 00:18:07,600
وهذا قردٌ وطير؟

278
00:18:08,610 --> 00:18:10,530
كلّها حيوانات رأيناها اليوم

279
00:18:11,330 --> 00:18:13,700
خطر لي أن أرسمها بينما لا أزال أتذكّرها

280
00:18:14,040 --> 00:18:15,570
ما هذا إذاً؟

281
00:18:18,760 --> 00:18:19,780
!إنّها أليس-تشان

282
00:18:19,780 --> 00:18:22,410
!مؤلم

283
00:18:21,120 --> 00:18:23,000
لمَ تلمسها؟

284
00:18:23,000 --> 00:18:24,080
لم أستطع منع نفسي

285
00:18:24,790 --> 00:18:30,290
زاين، كنت تفكّر بداليث عندما
كنّا في الحديقة، أليس كذلك؟

286
00:18:31,450 --> 00:18:33,570
أجل، قليلاً

287
00:18:34,140 --> 00:18:37,010
كنتُ أتساءل عن الحركة
التي ستقدم عليها تالياً

288
00:18:38,080 --> 00:18:39,310
اطمئنّ

289
00:18:39,650 --> 00:18:42,630
سأحميك بسحري إن حصل شيءٌ ما

290
00:18:42,630 --> 00:18:45,950
بل العكس، أنا سأحميكِ

291
00:18:45,950 --> 00:18:46,850
حسناً

292
00:18:46,850 --> 00:18:48,940
سأحمي أنا الجميع إذاً

293
00:18:50,970 --> 00:18:55,150
أتندم على استعمال سحرك تلاعبك بالزمن؟

294
00:18:55,420 --> 00:18:56,230
كلّا

295
00:18:56,230 --> 00:18:58,310
فقد استعملتُه لحمايتكِ

296
00:18:59,300 --> 00:19:01,870
زال شعوري الغريب حياله

297
00:19:02,700 --> 00:19:03,590
فهمت

298
00:19:04,380 --> 00:19:06,610
لا أعرف ما إن كنت أستطيع
،فعلها إلى أن أحاول

299
00:19:06,610 --> 00:19:12,300
لكنّي أفكّر بالعودة في الزمن لإيقاف
إلقاء اللعنة عليه

300
00:19:12,300 --> 00:19:14,290
أيمكنك فعل ذلك؟

301
00:19:14,850 --> 00:19:16,970
كما قلت، لن أعرف إلى أن أحاول

302
00:19:17,460 --> 00:19:20,470
فلم أستطع إرجاع والدينا للحياة

303
00:19:21,110 --> 00:19:23,010
لا يمكن تغيير القدر

304
00:19:25,400 --> 00:19:26,400
...لكن

305
00:19:26,400 --> 00:19:29,130
،إذا لم تكن لعنته قدراً

306
00:19:29,580 --> 00:19:31,690
فهنالك احتمال

307
00:19:32,270 --> 00:19:34,630
،لستُ أفهم تماماً

308
00:19:34,630 --> 00:19:35,400
لكن لا بأس

309
00:19:35,400 --> 00:19:40,970
تكمن المشكلة الأكبر في ضرورة قتالنا
للشخص الذي ألقى اللعنة عليه

310
00:19:40,970 --> 00:19:43,830
أخت داليث، شادي

311
00:19:45,260 --> 00:19:50,550
...إمكانيّة هزيمتنا لمن دعوها بالساحرة الأقوى والأسوأ

312
00:19:50,550 --> 00:19:54,660
لا تقلق، سأصبح أقوى

313
00:19:54,660 --> 00:19:56,790
لذا لا تقلق حيال أيّ ساحرة سنواجهها

314
00:19:57,500 --> 00:19:59,760
أنا فخورٌ لحدّ البكاء

315
00:20:00,270 --> 00:20:02,020
أيمكنني تقبيلكِ؟

316
00:20:02,020 --> 00:20:03,210
كلّا

317
00:20:04,760 --> 00:20:07,230
إنّهما صديقان عزيزان

318
00:20:07,230 --> 00:20:09,200
أودّ إبطال اللعنة بأسرع ما يمكن

319
00:20:11,310 --> 00:20:12,260
أجل

320
00:20:12,260 --> 00:20:16,360
وعلينا ردّ الجميل للرئيس
والبقيّة تدريجيّاً

321
00:20:17,370 --> 00:20:18,660
أخبرني يا زاين

322
00:20:18,990 --> 00:20:20,070
ماذا؟

323
00:20:24,070 --> 00:20:27,250
،إذا لم تتوقّف العاصفة الثلجيّة أبداً

324
00:20:27,250 --> 00:20:29,590
...وبقينا هكذا سويّاً للأبد

325
00:20:29,590 --> 00:20:30,600
ما الذي ستفعله؟

326
00:20:39,230 --> 00:20:41,280
!لا-لا تكوني حمقاء

327
00:20:41,280 --> 00:20:44,830
،سيكون الجوّ صحواً بحلول الصباح
!ثمّ سنستطيع العودة للبلدة

328
00:20:44,830 --> 00:20:46,640
أجل، معك حقّ

329
00:20:47,700 --> 00:20:52,100
...لو... لو لم تتوقّف العاصفة أبداً حقّاً

330
00:20:53,020 --> 00:20:56,440
...فعندها... سأستجمع الشجاعة و

331
00:21:00,510 --> 00:21:02,110
!انظر يا زاين

332
00:21:02,110 --> 00:21:04,010
!زالت العاصفة

333
00:21:04,010 --> 00:21:05,570
أجل

334
00:21:06,360 --> 00:21:08,530
بالطبع ذلك

335
00:21:09,090 --> 00:21:12,200
أشعر بالجوع، لنرجع ونأكل شيئاً

336
00:21:12,200 --> 00:21:13,250
أجل، أجل

337
00:21:18,690 --> 00:21:20,140
لمَ فعلتَ ذلك؟

338
00:21:20,850 --> 00:21:24,590
لا نعلم متى سنكون بمفردنا من جديد

339
00:21:25,260 --> 00:21:28,080
!لكنّكِ تغضبين عندما أحاول لمسكِ

340
00:21:28,080 --> 00:21:29,760
ماذا؟ هل ضايقك الأمر؟

341
00:21:29,760 --> 00:21:32,060
!لا، بل أسعدني كثيراً

342
00:21:32,650 --> 00:21:35,020
...افعليه من جديد في وقتٍ ما

343
00:23:07,280 --> 00:23:09,980
!أكملت حميتي

344
00:23:10,490 --> 00:23:14,930
!وقت أكل حلوى مكرون كمكافأة لفقداني للوزن

345
00:23:14,930 --> 00:23:16,950
سترجعين كما كنتِ قبلاً

346
00:23:16,950 --> 00:23:19,330
!لا بأس بواحدة فحسب

347
00:23:20,090 --> 00:23:25,160
بالمناسبة، شكراً لك على إلهامي يا أخي العزيز

348
00:23:26,400 --> 00:23:29,170
هاك، سأعطيك واحدة

349
00:23:29,630 --> 00:23:30,610
لا داعي

350
00:23:30,610 --> 00:23:32,010
أنا أحاول تجنّب الحلويّات

351
00:23:32,010 --> 00:23:33,450
!بغيض

352
00:23:35,510 --> 00:23:39,610
"الدوق وأليس واللقاء في عالم الساحرات"