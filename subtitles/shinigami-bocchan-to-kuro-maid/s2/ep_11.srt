1
00:00:01,300 --> 00:00:08,290
أيمكنك تصوّر حياة حيث لا تستطيع
لمس الشخص الذي تحبّه؟

2
00:00:09,120 --> 00:00:14,160
تسبّبت اللعنة التي أُلقيت عليه من قِبل
الساحرة بسلبه لحيوات أيّ من يمسّهم

3
00:00:14,820 --> 00:00:19,070
نأت أمه بنفسها عنه، ونعته أصدقاؤه بالوحش

4
00:00:19,070 --> 00:00:20,400
حتّى الأشخاص الذين لم يقابلهم قطّ

5
00:00:20,400 --> 00:00:23,490
"تكلّموا عنه بصفته "تجسّد الموت الذي يقطن الغابة

6
00:00:24,170 --> 00:00:29,160
لكنّه... لا يشعر بأية وحدة

7
00:02:01,840 --> 00:02:03,720
...مدرسة الشعوذة

8
00:02:04,350 --> 00:02:06,930
لم أعلم بوجود شيءٍ كهذا

9
00:02:07,170 --> 00:02:09,910
قالت كاف وزاين أنّهما سيذهبان

10
00:02:09,910 --> 00:02:11,830
ماذا عنك؟

11
00:02:11,830 --> 00:02:13,220
سأذهب بالطبع

12
00:02:13,220 --> 00:02:16,420
سأذهب لأيّ مكان لإبطال اللعنة

13
00:02:16,420 --> 00:02:21,310
أتّفق مع خطّة نيكو بالعودة
في الزمن بسحر زاين أيضاً

14
00:02:21,310 --> 00:02:22,160
...لكن

15
00:02:23,080 --> 00:02:25,670
وقتل شادي من جديد

16
00:02:27,360 --> 00:02:29,750
لا أريد قتل شادي

17
00:02:30,410 --> 00:02:32,800
أودّ الكلام معه حيال ذلك

18
00:02:32,800 --> 00:02:34,580
سأرافقك

19
00:02:34,580 --> 00:02:35,970
تسرّني مرافقتك لي

20
00:02:35,970 --> 00:02:38,760
لكنّي أشعر بالأسى على روب
لاضطراره البقاء في المنزل

21
00:02:40,570 --> 00:02:44,220
سنتعلّم عن السحر والساحرات في المدرسة أيضاً

22
00:02:45,140 --> 00:02:49,330
إن كنتُ سأصادق شادي، فأودّ اكتساب
معرفة في تلك الجوانب أيضاً

23
00:02:49,330 --> 00:02:50,100
أجل

24
00:02:50,100 --> 00:02:55,570
وأكثر من أيّ شيء، أشعر بالسعادة
للذهاب للمدرسة معك

25
00:02:55,570 --> 00:02:57,450
!ظريفةٌ جدّاً

26
00:03:01,870 --> 00:03:03,030
ما الخطب؟

27
00:03:03,710 --> 00:03:05,740
إنّه يتعلّق بـ شادي

28
00:03:06,840 --> 00:03:08,250
هذا خطّ أمّي

29
00:03:08,250 --> 00:03:09,450
شارون-سان كتبت هذا؟

30
00:03:09,450 --> 00:03:10,460
"!مرحباً"

31
00:03:10,460 --> 00:03:12,710
إنّها أنا المسؤولة عن واجب المدوّنة اليوميّة"
"لهذا اليوم، شارون

32
00:03:13,150 --> 00:03:17,640
!أتت شادي للقصر اليوم، فتكلّمنا بعض الشيء

33
00:03:17,640 --> 00:03:22,680
!إنّها راهبة، لكنّها ملمّة بالعرافة و"فينغ شوي" أيضاً

34
00:03:22,680 --> 00:03:26,580
تمكّنت شادي من معرفة كلّ شيء متعلّق"
،بماضيّ وما كنت أفكّر به

35
00:03:26,580 --> 00:03:30,320
"وفكّرت "مذهل، أأنتِ وسيطة روحيّة أو ما شابه؟

36
00:03:30,320 --> 00:03:30,950
النهاية

37
00:03:30,950 --> 00:03:34,650
تبدو أقرب لمذكّرتها المصوّرة من
مدوّنة خادم يوميّة

38
00:03:35,020 --> 00:03:36,570
هذه طبيعة أمّي

39
00:03:36,570 --> 00:03:40,530
لكن يبدو أنّها كانت على وفاق
مع شادي-سان مما كُتِب

40
00:03:40,530 --> 00:03:41,420
أجل

41
00:03:41,420 --> 00:03:45,100
...لكن شارون-سان لُعِنت، ونُوّمت

42
00:03:46,710 --> 00:03:48,540
لا يوجد الكثير بخلاف ذلك

43
00:03:48,970 --> 00:03:52,850
ما الذي أرادت داليث إخفاءه هنا؟

44
00:03:53,790 --> 00:03:55,840
!أنتِ قريبة! قريبة دوماً

45
00:03:55,840 --> 00:03:58,590
بدوت بغاية الوسامة وأنت غارقٌ في التفكير

46
00:03:58,590 --> 00:04:01,320
!لا تعرفين كم يخيفني ذلك

47
00:04:01,320 --> 00:04:04,020
لا أزال لا أستطيع معرفة
ما قد تقومين به أحياناً

48
00:04:05,510 --> 00:04:10,980
تمكّنت شادي من معرفة كلّ شيء متعلّق
بماضيّ وما كنت أفكّر به

49
00:04:12,170 --> 00:04:14,940
...قال نيكو الأمر نفسه

50
00:04:15,330 --> 00:04:19,190
أنّ شادي كانت تعرف كلّ ما سيفعلونه

51
00:04:20,000 --> 00:04:23,650
أتستطيع شادي قراءة الأفكار؟

52
00:04:24,680 --> 00:04:26,210
ذلك ممكن

53
00:04:26,210 --> 00:04:27,960
فهي عبقرية في السحر

54
00:04:28,390 --> 00:04:34,620
ربما تقرأ الأفكار كما يستطيع
زاين التحكّم بالزمن

55
00:04:35,150 --> 00:04:37,550
سأسأل داليث

56
00:04:37,920 --> 00:04:41,590
إن كانت بتلك القوّة في السحر
...وتستطيع قراءة الأفكار

57
00:04:42,080 --> 00:04:43,590
فستكون منيعةً بحقّ

58
00:04:45,070 --> 00:04:47,300
حقّاً... لا أستطيع معرفة
!ما ستفعله أبداً

59
00:04:50,510 --> 00:04:53,480
!أيّها الابن الأكبر، هذا ما سيحلّ بك تالياً

60
00:04:53,920 --> 00:04:55,620
!فلترتجف في نومك الليلة

61
00:04:57,390 --> 00:04:58,890
!إنّه رائعٌ حقّاً

62
00:04:58,890 --> 00:05:00,270
كيف؟

63
00:05:00,270 --> 00:05:01,800
!إنّه فتى نبيل

64
00:05:01,800 --> 00:05:03,360
كما قلت، كيف؟

65
00:05:04,080 --> 00:05:06,900
!داليث، أنتِ زعيمة الساحرات

66
00:05:06,900 --> 00:05:11,300
!إن كنتِ معجبةً به، فعليكِ الذهاب والكلام معه

67
00:05:11,300 --> 00:05:13,370
لن يودّ الكلام مع فتاة قبيحة مثلي

68
00:05:13,650 --> 00:05:14,830
لستِ قبيحة

69
00:05:15,410 --> 00:05:16,430
لا بأس

70
00:05:16,430 --> 00:05:19,670
أنا سعيدةٌ بمجرّد مشاهدته من بعد، كما قلت

71
00:05:19,670 --> 00:05:22,050
أما أنتِ، فاشربي ماءً موحلاً وامرضي
في معدتكِ وموتي

72
00:05:22,050 --> 00:05:24,990
كفّي عن معاملة أصدقائكِ فحسب بلآمة

73
00:05:24,990 --> 00:05:27,010
ما الذي تفعلانه هنا؟

74
00:05:27,380 --> 00:05:28,470
!أخته

75
00:05:28,470 --> 00:05:30,290
أخته؟

76
00:05:33,430 --> 00:05:35,080
لا تقفا في الثلج

77
00:05:35,080 --> 00:05:37,290
إن أردتما الكلام معه، فادخلا

78
00:05:37,290 --> 00:05:38,650
!الجوّ بارد

79
00:05:38,650 --> 00:05:41,820
أنا أقف هنا لأنّه ليس لديّ ما أفعله وحسب

80
00:05:42,200 --> 00:05:44,530
إذا كان لا لديكِ ما تفعلينه، فالعبي معي

81
00:05:49,770 --> 00:05:52,920
كنتِ تراقبين أخي الكبير
والتر بالفعل إذاً

82
00:05:52,920 --> 00:05:54,410
لديكِ ذوقٌ مريع

83
00:05:55,030 --> 00:05:56,470
ما اسمكِ؟

84
00:05:56,470 --> 00:05:57,370
داليث

85
00:05:57,370 --> 00:05:59,540
يا لكِ من غريبة يا داليث

86
00:05:59,540 --> 00:06:02,540
لا أفهم ما الذي قد يعجبكِ فيه أبداً

87
00:06:02,540 --> 00:06:05,010
حسناً، لديه وجهٌ ظريف نوعاً ما

88
00:06:05,910 --> 00:06:07,510
لمَ أدافع عنه؟

89
00:06:07,510 --> 00:06:09,110
سخافة

90
00:06:09,110 --> 00:06:12,470
يحتاج لنصف قرن على الأقل لينضج

91
00:06:12,470 --> 00:06:14,520
أنتِ أكثر غرابة منها

92
00:06:14,920 --> 00:06:18,010
،كان عليّ أن أسأل قبلاً
لكن ما الذي تفعلينه لي؟

93
00:06:18,010 --> 00:06:20,020
ساعديني في التمرّن على المكياج

94
00:06:20,260 --> 00:06:22,140
كما دعيني أقصّ شعركِ

95
00:06:22,140 --> 00:06:24,400
ستصبحين أكثر ظرافة بالتأكيد

96
00:06:25,020 --> 00:06:28,080
أتيتِ إلى هنا للقاء أخي، أليس كذلك؟

97
00:06:28,080 --> 00:06:29,860
تودّين التحلّي بالثقة عند مقابلته

98
00:06:37,150 --> 00:06:39,460
داليث، لا يروقكِ وجهكِ؟

99
00:06:40,270 --> 00:06:41,590
لا تختفي أبداً

100
00:06:41,590 --> 00:06:44,170
الندبات على وجهي... أكرهها

101
00:06:44,170 --> 00:06:47,880
فهمت، سنخفيها بمستحضر أساس إذاً

102
00:06:48,330 --> 00:06:51,640
!توقّفي يا شادي! هذا مؤلم

103
00:06:51,640 --> 00:06:53,350
!مؤلم

104
00:06:54,990 --> 00:06:57,430
لا تتوتّري هكذا يا داليث

105
00:06:57,430 --> 00:06:59,770
لا يمكنني وضع المكياج ما لم تكوني هادئة

106
00:07:13,950 --> 00:07:15,700
!أخي العزيز والتر

107
00:07:15,700 --> 00:07:18,220
تودّ هذه الفتاة الكلام معك

108
00:07:18,220 --> 00:07:20,410
!لا-لا داعي لتفعلي هذا

109
00:07:21,120 --> 00:07:22,580
مرحباً يا داليث

110
00:07:22,580 --> 00:07:25,070
!كنتُ أفكّر بأسماء بغيضة للأكبر لتويّ

111
00:07:25,070 --> 00:07:26,250
أتودّين سماعها؟

112
00:07:27,160 --> 00:07:28,630
سـ-سأرجع للبيت

113
00:07:28,630 --> 00:07:29,470
!أيّها الحثالة

114
00:07:29,470 --> 00:07:30,380
لمَ؟

115
00:07:33,930 --> 00:07:36,050
أتمنّى لك يوماً طيّباً يا والتر

116
00:07:37,930 --> 00:07:39,770
!حثالة! وضيع! أحمق

117
00:07:40,140 --> 00:07:42,370
!أمّك مسطّحة

118
00:07:42,370 --> 00:07:43,730
...كانت تبتسم

119
00:07:46,190 --> 00:07:47,230
!لذيذ

120
00:07:47,230 --> 00:07:49,710
!كعككِ الأفضل دوماً يا أليس

121
00:07:49,710 --> 00:07:51,370
شكراً لكِ

122
00:07:51,370 --> 00:07:53,720
أخبريني، متى سنقيم نحن
الفتيات حفلتنا التالية؟

123
00:07:53,720 --> 00:07:55,730
تعرفين متى سيُغلق السيرك؟

124
00:07:55,730 --> 00:07:57,870
سأسأل كاف-سان

125
00:07:57,870 --> 00:08:00,940
هنالك فتاة أخرى طلبت المشاركة أيضاً

126
00:08:00,940 --> 00:08:02,460
!بالتأكيد، يسرّني انضمامها

127
00:08:02,820 --> 00:08:06,050
قال نيكو أنّ بإمكاني دعوة من أريد

128
00:08:06,050 --> 00:08:08,960
لكن لا أستطيع دعوة فيولا للقدوم حقّاً

129
00:08:10,600 --> 00:08:12,970
!يداكِ ناعمتان حقّاً

130
00:08:12,970 --> 00:08:15,640
!أستطيع فركها للأبد

131
00:08:15,640 --> 00:08:18,410
مجرّد تواجدها بالقرب يطمئنني

132
00:08:18,410 --> 00:08:20,390
لكنّي لا أريد تعريضها للخطر

133
00:08:21,530 --> 00:08:25,130
!ربما سألمس أثداءها بالمقابل

134
00:08:24,160 --> 00:08:27,360
...وستحتاج لإذن أمّي لمغادرة القصر

135
00:08:27,360 --> 00:08:32,800
أخي! إذا لم توقفني كما تفعل
!عادةً، فسألمسها حقّاً

136
00:08:32,800 --> 00:08:34,490
ماذا؟

137
00:08:34,490 --> 00:08:36,010
افعلي يا فيولا-ساما

138
00:08:36,010 --> 00:08:37,910
!إنّها ناعمة حقّاً! شكراً لكِ

139
00:08:38,490 --> 00:08:40,080
أنت تتصرّف بشكلٍ مريب

140
00:08:40,080 --> 00:08:42,410
إنّك تخفي شيئاً يا أخي، صحيح؟

141
00:08:42,630 --> 00:08:44,620
...لا، لا شيء

142
00:08:44,620 --> 00:08:45,620
هناك؟

143
00:08:47,290 --> 00:08:48,840
!يبدو هذا مثيراً للريبة

144
00:08:48,840 --> 00:08:50,590
!كيف تمتلك هذا الإحساس الحادّ؟

145
00:08:50,590 --> 00:08:52,180
فيولا-ساما مُبهرة

146
00:08:52,180 --> 00:08:55,300
!لنرَ ما الذي تخفيه

147
00:08:56,940 --> 00:08:58,510
تنّورة؟ لمَ؟

148
00:08:59,010 --> 00:09:01,970
هذا ظريفٌ حقّاً! ما هو؟

149
00:09:01,970 --> 00:09:04,630
!إنّها... هوايتي السرّية

150
00:09:04,630 --> 00:09:06,850
!كنتُ سأرتديها بنفسي

151
00:09:07,240 --> 00:09:08,940
!آمل أن ينجح ذلك

152
00:09:11,070 --> 00:09:14,520
لا تقلق، أنا أتفهّم تلك الأشياء

153
00:09:14,520 --> 00:09:15,700
ليس عليك ارتداؤها سرّاً

154
00:09:15,700 --> 00:09:17,240
!لم أتوقّع ذلك

155
00:09:17,240 --> 00:09:18,480
مرحباً

156
00:09:18,480 --> 00:09:22,790
أردت الاستفسار عن عدد الوجبات الخفيفة
التي يمكننا أخذها لمدرسة... الشعوذة؟

157
00:09:22,790 --> 00:09:24,610
مدرسة الشعوذة؟

158
00:09:24,610 --> 00:09:25,620
...حسناً، في الواقع

159
00:09:29,600 --> 00:09:32,050
!أريد الذهاب أيضاً

160
00:09:32,050 --> 00:09:36,050
أريد الذهاب لمدرسة الشعوذة
!وارتداء هذا الزيّ

161
00:09:36,050 --> 00:09:38,080
!لـ-لن نذهب للتسلية

162
00:09:38,080 --> 00:09:40,140
!بل للمساعدة في إبطال لعنتي

163
00:09:40,140 --> 00:09:41,960
!لا أبالي بالسبب

164
00:09:41,960 --> 00:09:45,230
سأفعل أيّ شيء لفرصة
!مغادرة المنزل لفترة

165
00:09:45,230 --> 00:09:46,410
أذلك السبب؟

166
00:09:46,410 --> 00:09:49,560
!سأذهب لسؤال روب ما إن كان يلائمني هذا الزيّ

167
00:09:51,020 --> 00:09:52,000
آسفة

168
00:09:52,000 --> 00:09:54,220
لم أعلم أنّ فيولا هنا

169
00:09:54,220 --> 00:09:55,610
لا تقلقي

170
00:09:55,610 --> 00:09:57,690
ربما كان ذلك أفضل من المغادرة
دون قول شيء

171
00:09:57,690 --> 00:09:58,910
...إن كنت تقول ذلك

172
00:09:59,520 --> 00:10:04,620
سيتعيّن علينا إخبارها عمَّ قريب
أنّي وزاين ساحران أيضاً

173
00:10:26,930 --> 00:10:29,670
لا أصدّق أنّ لنا عربة كاملة تخصّنا

174
00:10:29,670 --> 00:10:31,620
نحن نستغلّ نفوذنا كنبلاء

175
00:10:31,620 --> 00:10:35,050
لا يمكن أن يتواجد أخي العزيز في
نفس العربة مع بقيّة الركاب، صحيح؟

176
00:10:35,050 --> 00:10:38,060
،إن كانت العربة لنا وحدنا
فيمكننا الرقص، صحيح؟

177
00:10:38,060 --> 00:10:39,610
افعلاها حيث لا أراكما وحسب

178
00:10:40,350 --> 00:10:43,190
شكراً لكِ على تجهيز كلّ هذا يا فيولا

179
00:10:43,190 --> 00:10:45,580
لكنّي لم أعتقد أنّ والتر
قد يرغب بالقدوم أيضاً

180
00:10:45,990 --> 00:10:47,280
!أخبرتك

181
00:10:47,280 --> 00:10:50,170
!سأكتشف حقيقة اللعنة قبلك

182
00:10:50,170 --> 00:10:53,320
!وأريد معلومات عن الساحرات أيضاً! ذلك كلّ شيء

183
00:10:54,030 --> 00:10:58,850
قالت أمّي أنّ عليّ اصطحابه
إن أردت الذهاب

184
00:10:58,850 --> 00:11:03,010
إنّها أشبه برحلة كبيرة، فهي تدفع مقابلها

185
00:11:03,010 --> 00:11:05,240
ما الرحلة الكبيرة؟

186
00:11:05,240 --> 00:11:09,590
إنّه تقليد حيث يذهب أطفال النبلاء
في رحلة لاكتساب معرفة عن العالم

187
00:11:09,590 --> 00:11:12,790
يسرّني أنّ أمي كانت مُتفهمة

188
00:11:17,580 --> 00:11:19,360
أين يذهبون يا ترى؟

189
00:11:19,700 --> 00:11:21,830
أعتقد أنّها مجرّد رحلة

190
00:11:21,830 --> 00:11:26,080
لم يكن عليكِ استعمال عطر لإخفاء
سحركِ كي تستطيعي اللحاق بهم

191
00:11:26,080 --> 00:11:27,060
بلى

192
00:11:27,060 --> 00:11:28,920
أنا قلقةٌ على والتر

193
00:11:28,920 --> 00:11:31,290
أنتِ تتحوّلين لمترصّدة حقيقيّة

194
00:11:32,000 --> 00:11:34,130
يمكنكِ الرجوع بمفردكِ إن أردتِ

195
00:11:34,130 --> 00:11:37,170
!كلّا، فأنا إحدى فتيات داليث

196
00:11:38,380 --> 00:11:39,720
ذلك اسمٌ سخيف

197
00:11:41,260 --> 00:11:43,430
أنتما ساحران إذاً؟

198
00:11:43,430 --> 00:11:45,860
نعتذر على عدم إخباركِ

199
00:11:45,860 --> 00:11:49,370
لم نخبركِ لأنّنا لم نرد توريطكِ

200
00:11:50,230 --> 00:11:51,850
لكنّها ليست مفاجأة

201
00:11:51,850 --> 00:11:54,440
أتت كاف عبر نافذة الطابق
ألثاني في إحدى المرّات

202
00:11:54,670 --> 00:11:56,690
إذاً، أيّ سحر تستطيعان استعماله؟

203
00:11:56,690 --> 00:11:59,060
هذا السحر الذي أجيده أكثر شيء

204
00:12:00,630 --> 00:12:02,360
!رائعٌ جدّاً

205
00:12:08,370 --> 00:12:10,500
أسبق وأن صعدتِ قطاراً يا أليس؟

206
00:12:10,500 --> 00:12:14,280
ليس منذ أن اصطحبني روب-سان للقصر

207
00:12:14,280 --> 00:12:18,010
لكن هذه الرحلة أكثر تميّزاً
من السابقة بكثير

208
00:12:18,340 --> 00:12:21,150
فمرافقتي لك في رحلة أشبه بالحلم

209
00:12:21,560 --> 00:12:22,970
و-وأنا أيضاً

210
00:13:18,750 --> 00:13:20,550
هذه هي إذاً؟

211
00:13:21,380 --> 00:13:24,990
!مرحباً! كنّا بانتظاركم

212
00:13:25,580 --> 00:13:28,460
...هذه مدرسة الشعوذة إذاً

213
00:13:33,780 --> 00:13:35,660
سأعرّف عنّا من جديد

214
00:13:36,620 --> 00:13:38,520
أنا النظار، نيكو

215
00:13:38,860 --> 00:13:41,870
وهذه السيّدة الحسناء هي مساعدة الناظر، إيتشي

216
00:13:41,870 --> 00:13:44,630
سنعلّمكم كلّ ما تحتاجون لمعرفته
عن السحر والشعوذة والساحرات

217
00:13:44,630 --> 00:13:46,930
وذلك يتضمّن التمرين العمليّ كما النظريّ

218
00:13:47,190 --> 00:13:49,640
حسناء؟ إيتشي؟

219
00:13:49,870 --> 00:13:53,720
!ابدِ احتراماً وإلّا سأقتلع منقارك

220
00:13:54,600 --> 00:13:57,480
!ستخاطبنا يا زاين بالمعلّمين

221
00:13:58,090 --> 00:14:01,060
!وإذا لم تفعل، سألقّنك درساً

222
00:14:01,060 --> 00:14:02,990
فهمت؟

223
00:14:02,990 --> 00:14:05,690
،خلوده يجعله يبدو كطفل

224
00:14:05,690 --> 00:14:07,720
لكنّه عجوز خرف في الواقع

225
00:14:07,720 --> 00:14:10,050
غيّروا ثيابكم وارتدوا أزياءكم

226
00:14:10,050 --> 00:14:12,290
سآخذكم في جولة حول المدرسة

227
00:14:12,290 --> 00:14:13,590
!مرحى! أزياء

228
00:14:13,590 --> 00:14:14,540
!مرحى! تغيير ثياب

229
00:14:16,610 --> 00:14:18,500
!إنّه ظريفٌ جدّاً

230
00:14:18,980 --> 00:14:21,610
!أتيتُ هنا لارتدائه وحسب

231
00:14:23,170 --> 00:14:25,340
ارتداء اللون الأسود يشعرني بارتباك

232
00:14:29,300 --> 00:14:31,850
!من الرائع امتلاكنا لأزياء متماثلة

233
00:14:31,850 --> 00:14:33,520
!ظريفات جدّاً

234
00:14:33,520 --> 00:14:36,590
ينتابني القلق حيال وجودهم كتلامذة هنا

235
00:14:36,590 --> 00:14:38,310
هوّني عليك، سيكون الأمر بخير

236
00:14:40,320 --> 00:14:42,910
سأعرّفكم بتلامذة الصفوف العليا أوّلاً

237
00:14:42,910 --> 00:14:43,730
اظهروا

238
00:14:47,610 --> 00:14:50,600
هذه سارة سانرود، بارعةٌ في العلاج

239
00:14:50,970 --> 00:14:52,870
وميلي التي تستطيع قطع أيّ شيء

240
00:14:52,870 --> 00:14:53,950
!مراحب

241
00:14:53,950 --> 00:14:55,810
فايفير التي تتحكّم بالرعد

242
00:14:57,380 --> 00:14:59,280
وإيفيلين التي تستطيع الاختباء في أيّ مكان

243
00:14:59,280 --> 00:15:00,420
!مرحباً

244
00:15:00,730 --> 00:15:01,540
هؤلاء جميعهم

245
00:15:01,540 --> 00:15:02,520
صدقاً؟

246
00:15:02,520 --> 00:15:04,050
!هناك فتيات حقّاً

247
00:15:04,050 --> 00:15:05,880
أخبرتك أنّي لم أكن أكذب

248
00:15:06,110 --> 00:15:07,370
لحظة، هؤلاء هم جميعاً؟

249
00:15:07,370 --> 00:15:10,760
!قلت أنّك تجمع رفاقك، لكنّهم أربعة فحسب؟

250
00:15:10,760 --> 00:15:11,880
!اصمت

251
00:15:11,880 --> 00:15:14,720
!من الصعب العثور على أشخاص بقوى سحريّة

252
00:15:15,350 --> 00:15:17,680
كما أنّنا بنيننا هذه المدرسة العملاقة

253
00:15:17,680 --> 00:15:19,620
كان الأمر شاقاً علينا أيضاً

254
00:15:19,620 --> 00:15:22,100
سأعرّفكم على المعلّم الآخر

255
00:15:22,420 --> 00:15:24,530
سيكون من يدرّسكم أيضاً

256
00:15:27,190 --> 00:15:28,450
...أنت

257
00:15:28,450 --> 00:15:30,230
،عندما نظرتُ للمرآة صباح اليوم

258
00:15:30,230 --> 00:15:33,240
اقتربت خطوة أخرى لأشبه
أخي نيكو أكثر

259
00:15:33,980 --> 00:15:37,090
!أنا رجلٌ يقدّر أخي نيكو ويريد أن يصبح مثله

260
00:15:37,090 --> 00:15:39,200
!مرحباً، أنا معلّمكم فلي

261
00:15:40,510 --> 00:15:41,920
هذا معلّمنا؟

262
00:15:41,920 --> 00:15:44,190
!أنت رائعٌ جدّاً يا معلّم فلي

263
00:15:44,190 --> 00:15:46,000
!أعطني توقيعك

264
00:15:46,490 --> 00:15:48,130
!لمَ الفتيات مُعجبات به؟

265
00:15:48,380 --> 00:15:51,500
!ومن الجلّي لي من قوّتك السحريّة أنّك ساحر

266
00:15:51,500 --> 00:15:53,340
لمَ تخدم البشر؟

267
00:15:53,950 --> 00:15:57,870
!أقدّر طريقة عيش أخي وإيتشي

268
00:15:57,870 --> 00:16:01,690
من يهتمّون بالأنساب متخلّفون عن العصر

269
00:16:01,690 --> 00:16:03,700
!إنّه الأروع

270
00:16:03,700 --> 00:16:05,150
!لا أستطيع قبول هذا

271
00:16:06,270 --> 00:16:10,570
أريناكم معظم أرجاء المدرسة إذاً

272
00:16:10,930 --> 00:16:12,750
ألديكم أيّة أسئلة؟

273
00:16:12,750 --> 00:16:13,530
أجل

274
00:16:14,860 --> 00:16:17,260
كم ستستغرق الدروس؟

275
00:16:17,260 --> 00:16:20,250
أخبرتُ عائلتي أنّ الأمر سيستغرق أسبوعاً

276
00:16:20,530 --> 00:16:23,750
سيكفي ذلك لتغطية الأساسيّات

277
00:16:23,750 --> 00:16:25,590
وبعدها، لكم حرّية ما تفعلون جميعاً

278
00:16:25,920 --> 00:16:28,960
،إن أردتم الدراسة لسبب معيّن
فيمكنكم البقاء هنا لفترة

279
00:16:38,390 --> 00:16:42,560
وهكذا، ستنالون القوّة المطلوبة لقتالها

280
00:16:42,560 --> 00:16:44,350
أودّ منكم الدراسة باجتهاد

281
00:16:44,630 --> 00:16:47,940
وتحديداً أنت يا زاين، إنّك محور أساسيّ في هذه الخطّة

282
00:16:47,940 --> 00:16:51,740
أود منك التحكّم الدقيق بسحر التلاعب بالزمن

283
00:16:51,740 --> 00:16:53,480
أدرك ذلك

284
00:16:53,480 --> 00:16:57,400
بصراحة، لا أزال غير مقتنع تماماً حيال مساعدتكم

285
00:16:57,400 --> 00:17:00,140
لكنّي أريد مساعدة صديقة

286
00:17:00,140 --> 00:17:01,290
...زاين

287
00:17:02,080 --> 00:17:03,840
تبدأ الدروس غداً

288
00:17:03,840 --> 00:17:05,870
حضّرتُ الطعام والحمّام لكم

289
00:17:07,370 --> 00:17:09,320
فلتستريحوا الليلة

290
00:17:11,370 --> 00:17:12,170
!طعام

291
00:17:12,170 --> 00:17:12,840
!حمّام

292
00:17:13,930 --> 00:17:15,800
تأخّرنا كثيراً

293
00:17:16,400 --> 00:17:17,850
مررنا بتأخيرٍ فظيع

294
00:17:17,850 --> 00:17:20,010
أنتِ ذات شعبيّة كبيرة يا داليث

295
00:17:20,010 --> 00:17:21,750
فلندخل بسرعة

296
00:17:22,090 --> 00:17:26,140
لكنّ هذا المبنى يمتلك
حاجزاً قويّاً حوله

297
00:17:26,140 --> 00:17:27,470
!مؤلم

298
00:17:27,780 --> 00:17:29,310
أخبرتكِ

299
00:17:29,970 --> 00:17:32,780
ما الذي يريده والتر هنا؟

300
00:17:33,400 --> 00:17:35,460
ماذا لو أتى للقاء امرأة أخرى؟

301
00:17:35,460 --> 00:17:37,180
لا أظنّ ذلك

302
00:17:37,180 --> 00:17:39,230
!لا، أنا متأكدة

303
00:17:39,230 --> 00:17:42,310
!لو كان بإمكاني هدم هذه القلعة فوراً، لفعلت

304
00:17:46,680 --> 00:17:48,780
كان العشاء شهيّاً، أليس كذلك؟

305
00:17:49,170 --> 00:17:50,950
كان لذيذاً

306
00:17:50,950 --> 00:17:52,880
أنا مسرورة لقدومنا

307
00:17:52,880 --> 00:17:56,610
لا أزال لا أفهم أمور السحر تلك، لكن هذا مسلٍّ

308
00:17:56,610 --> 00:18:00,270
فيولا، من المخالف للآداب أن تدخلي الحمّام بالمنشفة

309
00:18:00,270 --> 00:18:00,600
!اخلعيها

310
00:18:02,450 --> 00:18:04,810
!مـ-مستحيل

311
00:18:05,390 --> 00:18:07,990
سمعتُ صوت فيولا عن بعد

312
00:18:07,990 --> 00:18:09,770
أوقع أمرٌ ما؟

313
00:18:11,150 --> 00:18:13,230
هذا مُربك

314
00:18:13,230 --> 00:18:15,400
أين ذهب زاين؟

315
00:18:16,240 --> 00:18:17,950
ما الذي تفعلينه هنا؟

316
00:18:18,230 --> 00:18:20,850
ألا يُسمح لي بدخول حمّام النساء؟

317
00:18:20,850 --> 00:18:22,660
إذا كان هناك من ليس في محلّه، فهو أنت

318
00:18:22,660 --> 00:18:25,580
حسناً، ظننتُه حمّام الرجال

319
00:18:25,580 --> 00:18:27,870
إنّه في الجانب الآخر للمبنى
!أيّها الطير مسترق النظر

320
00:18:29,020 --> 00:18:30,380
أودّ سؤالك عن شيء

321
00:18:30,630 --> 00:18:31,900
ما-ماذا؟

322
00:18:31,900 --> 00:18:35,790
...ذاك الرجل بمظهر الطفل، المعلّم ثلاثة

323
00:18:35,790 --> 00:18:36,970
أليس المعلّم اثنان مناسب أكثر؟

324
00:18:36,970 --> 00:18:38,470
!لا تقل ذلك أبداً

325
00:18:38,930 --> 00:18:42,590
ذكر الرجل الأقلّ من ثلاثة شيئاً
عن هزيمة شادي

326
00:18:43,020 --> 00:18:45,410
لكنّي لم أسمع القصّة كاملة

327
00:18:45,410 --> 00:18:46,630
وضّح لي

328
00:18:46,630 --> 00:18:47,590
حسناً

329
00:18:47,590 --> 00:18:50,340
قطعت كلّ الطريق إلى هنا، لذا سأشرح كلّ شيء

330
00:18:54,580 --> 00:18:56,200
أليس هذا مُسليّاً يا أليس؟

331
00:18:56,200 --> 00:18:57,420
أنا مسرورةٌ لقدومي

332
00:18:57,420 --> 00:18:58,650
وأنا كذلك

333
00:19:00,350 --> 00:19:03,120
...لا مجال لي للدخول

334
00:19:03,120 --> 00:19:04,170
فهمت

335
00:19:04,170 --> 00:19:06,740
أي أنّكم ستستعملون سحر زاين للعودة بالزمن

336
00:19:06,740 --> 00:19:10,050
وهزيمة شادي قبل إلقائها للعنة عليك

337
00:19:11,320 --> 00:19:13,330
لكنّي لا أريد قتلها

338
00:19:14,070 --> 00:19:15,620
أودّ الكلام معها

339
00:19:15,620 --> 00:19:18,160
أودّ معرفة سبب لعنها لي

340
00:19:18,160 --> 00:19:22,020
لا أريد استعمال القوّة، بل مصادقتها

341
00:19:22,020 --> 00:19:22,760
فهمت

342
00:19:24,560 --> 00:19:28,830
كنتُ أتساءل... هل قالت أمّي شيئاً
عن قدومنا هنا؟

343
00:19:29,690 --> 00:19:31,630
لم أخبرها أنّها كانت مدرسة شعوذة

344
00:19:31,630 --> 00:19:33,300
لكنّها لم تتذمّر أبداً

345
00:19:33,940 --> 00:19:36,730
قالت أنّها أرادت منّي الذهاب
وتعلّم المزيد عن العالم

346
00:19:36,730 --> 00:19:40,450
كيف وضع أمّي مؤخراً؟

347
00:19:41,210 --> 00:19:43,160
إنّه بخير

348
00:19:46,070 --> 00:19:48,370
يتصرّف والتر بلطفٍ اليوم

349
00:19:48,710 --> 00:19:52,330
يبثّ الينبوع الساخن السلام في القلب حقّاً

350
00:19:53,270 --> 00:19:54,810
أعتذر على جعلك تمرّ بكلّ هذا

351
00:19:54,810 --> 00:19:56,070
!اصمت يا فاشل

352
00:20:00,860 --> 00:20:02,850
لا أعرف ما قد يثير استفزازه

353
00:20:04,600 --> 00:20:07,690
هذا المنظر ثقيلٌ جدّاً على فتاة
!بلا خبرة مع الفتيان

354
00:20:07,690 --> 00:20:09,890
لا تنظري إذاً وحسب

355
00:20:09,890 --> 00:20:11,640
حسناً، ماذا نفعل الآن؟

356
00:20:12,330 --> 00:20:14,050
سنراقب لفترة أطول

357
00:20:14,050 --> 00:20:17,940
بعد إشراق الشمس، سأرى من تكون تلك المرأة بالضبط

358
00:20:17,940 --> 00:20:20,360
لكنّي متأكدة أنّها ليست امرأة أخرى

359
00:20:20,590 --> 00:20:22,820
هذه هي القصّة إذاً؟

360
00:20:23,230 --> 00:20:27,020
فهمتُ سبب رغبة كاف بالقدوم هنا بعد الكلام معكِ

361
00:20:27,020 --> 00:20:30,630
إنّها تريد أن تصبح أكثر قوّة وحسب

362
00:20:30,630 --> 00:20:34,890
رغم أنّك تودّ أن تكون
من يحميها باستمرار بالطبع

363
00:20:37,350 --> 00:20:38,760
آمن بها

364
00:20:38,760 --> 00:20:42,250
مهما بلغت قوّتها، لن تذهب لأيّ مكان

365
00:20:42,250 --> 00:20:43,480
أعرف ذلك

366
00:20:44,020 --> 00:20:45,690
كان حمّاماً رائعاً

367
00:20:45,690 --> 00:20:46,180
ماذا؟

368
00:20:46,400 --> 00:20:48,220
زاين-سان؟ معلّمة إيتشي؟

369
00:20:48,220 --> 00:20:49,220
!مرحباً يا كاف

370
00:20:49,220 --> 00:20:51,780
هذه المُسنّة رائعة في الواقع
!إن تعرّفتِ عليها

371
00:20:51,780 --> 00:20:54,140
ربما قلت أكثر مما يجب

372
00:20:54,850 --> 00:20:55,940
كاف، هيّا بنا

373
00:20:56,370 --> 00:20:58,610
سأمرّنكِ كلّ ليلة بدءاً من الآن

374
00:20:58,920 --> 00:21:01,070
سأجعلكِ قويّة

375
00:21:12,220 --> 00:21:13,500
...سموّك

376
00:21:13,500 --> 00:21:16,970
أتيتُ لأنّي أردت رؤية كيف حالك قبل خلودي للنوم

377
00:21:16,970 --> 00:21:17,930
وأنا أيضاً

378
00:21:17,930 --> 00:21:18,960
يسرّني لقائي بكِ

379
00:21:19,690 --> 00:21:21,420
ستبدأ الدروس غداً

380
00:21:21,420 --> 00:21:22,400
أجل

381
00:21:22,400 --> 00:21:26,130
أشعر بالسعادة لأنّي سأكون زميلتك

382
00:21:30,720 --> 00:21:33,760
حسناً، فيولا-ساما بانتظاري

383
00:21:33,760 --> 00:21:35,350
عمتَ مساءً سموّك

384
00:21:35,720 --> 00:21:37,220
عمتِ مساءً يا أليس

385
00:21:39,300 --> 00:21:40,060
...أ-أيضاً

386
00:21:41,770 --> 00:21:45,990
بدوتِ بغاية الظرافة في زيّكِ

387
00:21:47,090 --> 00:21:51,010
شكراً لك، بدوت رائعاً في زيّك أيضاً

388
00:22:00,200 --> 00:22:01,840
!أنا مسرورٌ لقدومي

389
00:23:35,520 --> 00:23:39,650
"الدوق وأليس وساحرة اللعنة"