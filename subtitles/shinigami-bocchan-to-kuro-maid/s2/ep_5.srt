1
00:00:01,290 --> 00:00:08,280
أيمكنك تصوّر حياة حيث لا تستطيع
لمس الشخص الذي تحبّه؟

2
00:00:09,120 --> 00:00:14,160
تسبّبت اللعنة التي أُلقيت عليه من قِبل
الساحرة بسلبه لحيوات أيّ من يمسّهم

3
00:00:14,810 --> 00:00:18,990
نأت أمه بنفسها عنه، ونعته أصدقاؤه بالوحش

4
00:00:18,990 --> 00:00:20,460
حتّى الأشخاص الذين لم يقابلهم قطّ

5
00:00:20,460 --> 00:00:23,480
"تكلّموا عنه بصفته "تجسّد الموت الذي يقطن الغابة

6
00:00:24,160 --> 00:00:29,200
لكنّه... لا يشعر بأية وحدة

7
00:02:06,280 --> 00:02:07,480
!مُذهل

8
00:02:07,840 --> 00:02:10,180
!نحن نعرض في منتصف البلدة حقّاً

9
00:02:11,380 --> 00:02:13,410
حصلتُ على الإذن

10
00:02:13,780 --> 00:02:14,740
...سموّك

11
00:02:20,810 --> 00:02:22,650
ما رأيك بزيّي؟

12
00:02:22,650 --> 00:02:24,650
!تبدين رائعة

13
00:02:24,960 --> 00:02:30,580
لكن فكرة رؤية الكثير من الأشخاص
...لكِ بهذه الثياب

14
00:02:31,130 --> 00:02:33,080
لا أدري ما إن كان الأمر
!يروقني أم لا

15
00:02:34,280 --> 00:02:35,440
سموّك

16
00:02:35,440 --> 00:02:36,460
مُذهل

17
00:02:36,810 --> 00:02:38,370
أين زاين؟

18
00:02:38,370 --> 00:02:41,490
كاف، تعالي معي قليلاً

19
00:02:41,490 --> 00:02:43,610
يريد زاين الكلام معك

20
00:02:53,600 --> 00:02:54,470
...لكن

21
00:02:54,470 --> 00:02:57,020
لا يمكنك ترك كاف

22
00:02:59,120 --> 00:03:02,090
غليّ الكلام معها قبل رحيلي على الأقلّ

23
00:03:07,570 --> 00:03:10,410
مرحباًـ أعتذر على مقاطعتك أثناء انشغالك

24
00:03:13,680 --> 00:03:16,410
ستخبرها أنّك ستحبّها أخيراً؟

25
00:03:17,210 --> 00:03:19,870
،أعرف أنّي أحبّها أكثر منك

26
00:03:19,870 --> 00:03:22,140
لكنّك عرفتها لفترة أطول منّي

27
00:03:22,470 --> 00:03:24,780
أكره قولها، لكن فلتعترف لها أوّلاً

28
00:03:25,690 --> 00:03:27,560
معك حقّ، لكنّك مخطئ

29
00:03:27,560 --> 00:03:30,100
فلتسعدها

30
00:03:30,100 --> 00:03:32,360
!سأبرحك ضرباً إن خنتها

31
00:03:32,360 --> 00:03:34,020
!أ-أنت فتى صالح

32
00:03:34,020 --> 00:03:37,350
حسناً، سأترككما يا يافعيّ السن الكلام

33
00:03:37,350 --> 00:03:38,330
إلى اللقاء

34
00:03:38,330 --> 00:03:40,240
أنت أكثرنا يفاعة

35
00:03:46,270 --> 00:03:50,250
الوداع... يا حبّي الأوّل

36
00:03:55,490 --> 00:03:56,920
ما الذي أردت الكلام بشأنه؟

37
00:03:56,920 --> 00:03:58,140
العرض على وشك البدء

38
00:03:58,140 --> 00:03:59,540
...حسناً، أنا

39
00:03:59,540 --> 00:04:02,880
أدركت أنّي لم أشكرك قبلاً
على كلّ شيء

40
00:04:04,010 --> 00:04:05,180
شكراً لكِ

41
00:04:05,650 --> 00:04:07,120
لمَ هذا فجأةً؟

42
00:04:09,370 --> 00:04:12,640
سترحل لمكانٍ ما وتتركني، أليس كذلك؟

43
00:04:12,640 --> 00:04:14,670
!لا-لا أدري ما الذي تتكلّمين عنه

44
00:04:14,670 --> 00:04:16,150
!ذلك جليّ لي

45
00:04:23,560 --> 00:04:24,540
...زاين

46
00:04:24,980 --> 00:04:26,630
أنت ذكيّ

47
00:04:26,630 --> 00:04:29,370
اتّباع دربك لم يضلّني أبداً

48
00:04:29,880 --> 00:04:31,680
لكن الأمر مختلفُ هذه المرّة

49
00:04:32,490 --> 00:04:34,330
لمَ لم تأتِ للكلام معي؟

50
00:04:41,890 --> 00:04:42,960
!انسَ الأمر

51
00:04:42,960 --> 00:04:44,300
!افعل ما يحلو لك

52
00:04:44,300 --> 00:04:46,450
!لستُ صديقتك بعد الآن

53
00:04:47,050 --> 00:04:48,130
!انتظري يا كاف

54
00:04:48,130 --> 00:04:48,990
!كلّا

55
00:04:49,490 --> 00:04:50,930
!اسمعيني رجاءً

56
00:04:52,930 --> 00:04:53,640
!كاف

57
00:04:56,020 --> 00:04:57,100
أنا أحبّكِ

58
00:05:01,450 --> 00:05:03,000
لمَ تقول هذا الآن؟

59
00:05:05,050 --> 00:05:06,390
...معكِ حقّ

60
00:05:07,570 --> 00:05:09,390
لكنّي لن أسحب كلامي

61
00:05:09,390 --> 00:05:12,260
أنا أحبّكِ، أنتِ ثمينةٌ لي

62
00:05:12,260 --> 00:05:14,580
لذا قرّرت الرحيل

63
00:05:16,070 --> 00:05:17,540
هربت

64
00:05:20,770 --> 00:05:22,070
!سيبدأ

65
00:05:22,070 --> 00:05:23,510
!لنسرع

66
00:05:23,850 --> 00:05:25,900
حان وقت البداية أخيراً

67
00:05:25,900 --> 00:05:28,300
أأنت مستعد لخلع قناعك؟

68
00:05:28,300 --> 00:05:29,650
أجل

69
00:05:29,960 --> 00:05:33,920
ا-المعذرة، سيبدأ السيرك
في أيّ لحظة الآن

70
00:05:33,920 --> 00:05:35,230
!ابقي وشاهديه رجاءً

71
00:05:35,860 --> 00:05:39,190
بالطبع، سأفعل ذلك

72
00:05:39,740 --> 00:05:42,660
سيكون عرضاً مسلياً مليئاً بالفوضى

73
00:05:42,660 --> 00:05:44,400
شـ-شكراً لك

74
00:05:46,430 --> 00:05:47,480
كاف-سان؟

75
00:05:48,070 --> 00:05:49,620
...رجعت

76
00:05:53,250 --> 00:05:54,440
أأنتِ بخير؟

77
00:05:54,440 --> 00:05:55,580
لمَ قد لا أكون؟

78
00:05:58,810 --> 00:06:02,360
زاين أخبرها أخيراً؟

79
00:06:02,360 --> 00:06:04,300
لنبدأ

80
00:06:05,000 --> 00:06:07,300
...سيّداتي سادتي

81
00:06:07,300 --> 00:06:13,010
!واليوم، الحضور الأصغر سنّاً معنا أيضاً! مرحباً بكم

82
00:06:15,300 --> 00:06:20,090
!سيبدأ سيرك الجوزاء العظيم

83
00:06:39,930 --> 00:06:41,410
!مُذهل

84
00:06:42,500 --> 00:06:43,680
...أغبطهم

85
00:06:43,680 --> 00:06:45,170
إنّهم يلقون محبّة كبيرة

86
00:06:45,490 --> 00:06:49,130
وبينما كره الحضور أدائي بالأمس

87
00:06:49,130 --> 00:06:50,800
آمل أن أكون بخير

88
00:06:51,240 --> 00:06:55,530
سموّك، سأعلّمك تعويذة سحريّة لتهدئة أعصابك

89
00:06:55,530 --> 00:06:56,890
تعويذة سحريّة؟

90
00:06:57,780 --> 00:07:01,980
ارسم نجمةً على راحة يدك
ثم عانق أحدهم

91
00:07:01,980 --> 00:07:02,600
هيّا

92
00:07:02,600 --> 00:07:04,400
!لا تعلّميني كذبات

93
00:07:04,890 --> 00:07:07,810
لكنّي أشعر بهدوء أكبر الآن

94
00:07:07,810 --> 00:07:09,510
يسرّني ذلك

95
00:07:09,510 --> 00:07:11,430
أوقع أمرٌ ما يا كاف؟

96
00:07:14,450 --> 00:07:18,140
هل اكتشفت رحيل زاين؟

97
00:07:18,510 --> 00:07:19,870
رجعت

98
00:07:20,720 --> 00:07:23,630
يبدو أنّ العرض بدأ بالفعل

99
00:07:34,210 --> 00:07:35,670
لا بدّ أنّ شيئاً ما حصل

100
00:07:35,670 --> 00:07:37,810
...حسناً

101
00:07:43,700 --> 00:07:44,980
!مُذهل

102
00:07:45,850 --> 00:07:47,190
ما الذي يجري؟

103
00:07:50,790 --> 00:07:53,950
السحر مذهل أكثر من أيّ سيرك

104
00:07:53,950 --> 00:07:55,160
صحيح يا تيتو؟

105
00:07:55,880 --> 00:07:59,370
أ،ردتِ من إفساد عرض السيرك
صحيح يا داليث؟

106
00:08:00,370 --> 00:08:01,830
!ذلك يسير

107
00:08:02,390 --> 00:08:03,790
داليث ورفيقاتها هنا

108
00:08:09,140 --> 00:08:13,420
يردن إفساد العرض كيلا
أستطيع البقاء هنا

109
00:08:18,140 --> 00:08:19,260
!هيوغو

110
00:08:19,260 --> 00:08:23,350
حاولوا إنقاذ الصبيّ قبل هضمه

111
00:08:24,100 --> 00:08:27,060
لكن إن فعلتم، سألدغكم بأنيابي السامّة

112
00:08:28,810 --> 00:08:30,360
!هذا العرض مُذهل

113
00:08:33,990 --> 00:08:37,090
ألن يكون من الأذكى القدوم
لعالم الساحرات وحسب؟

114
00:08:37,920 --> 00:08:42,160
لا يمكنني استعمال سحري
مع كلّ هؤلاء الأشخاص هنا

115
00:08:42,830 --> 00:08:44,670
عليّ استعمال سحري إذاً

116
00:08:46,300 --> 00:08:47,920
...سحر تلاعبي بالزمن

117
00:08:57,630 --> 00:08:58,810
!عجباً

118
00:09:02,040 --> 00:09:03,270
!مُذهل

119
00:09:03,270 --> 00:09:05,480
!كان كالسحر

120
00:09:06,960 --> 00:09:09,110
!جرّبي عضّي بأنيابك السامة

121
00:09:09,110 --> 00:09:11,410
!ستفقدين حياتك

122
00:09:14,890 --> 00:09:16,510
!أحبّوه

123
00:09:16,510 --> 00:09:18,240
أنت رائعٌ سموّك

124
00:09:18,760 --> 00:09:21,950
!لا يمكن لنبتة هزيمتي

125
00:09:22,460 --> 00:09:24,730
!أفسد كلّ شيء من جديد

126
00:09:24,730 --> 00:09:26,920
!لا ينفكّ عن فعل ذلك

127
00:09:28,410 --> 00:09:31,210
أيّها الرئيس، من كان أولئك الغرباء؟

128
00:09:31,210 --> 00:09:34,260
!لا أدري، لكنّ الحضور يستمتعون كثيراً بوقتهم

129
00:09:34,260 --> 00:09:36,130
ربما لا بأس إذاً

130
00:09:38,290 --> 00:09:40,390
أنتم مخبولون أيضاً

131
00:09:41,350 --> 00:09:45,100
عليّ فعل شيء قبل إقدام
داليث على حركتها التالية

132
00:09:45,650 --> 00:09:49,170
زاين، لن نسمح لهم بإفساد السيرك

133
00:09:49,690 --> 00:09:51,340
سنتولّى الأمر بمفردنا

134
00:09:51,340 --> 00:09:52,070
...كاف

135
00:09:52,370 --> 00:09:56,330
كيلا يتعيّن عليك استعمال
!السحر الذي تكرهه

136
00:09:58,250 --> 00:10:01,610
سأخبرك بإجابتي على اعترافك
!بعد نهاية كلّ شيء

137
00:10:01,610 --> 00:10:02,490
اعتراف؟

138
00:10:02,490 --> 00:10:04,490
!فكّري بارتفاع صوتك

139
00:10:06,000 --> 00:10:08,980
أين تختبئين يا داليث؟

140
00:10:40,770 --> 00:10:42,780
ما الذي تراه؟

141
00:10:43,930 --> 00:10:44,970
...كاف

142
00:10:49,740 --> 00:10:52,320
لا أستطيع رؤية شيء

143
00:10:55,350 --> 00:10:57,460
...كاف... كاف

144
00:11:00,810 --> 00:11:02,430
لا تبكي رجاءً

145
00:11:14,810 --> 00:11:16,360
!لا يهم مهما حاولتِ من مرّات

146
00:11:18,940 --> 00:11:20,740
يمكنني الاستمرار بالنباتات التي
!لا يمكنك لمسها مباشرةً

147
00:11:20,990 --> 00:11:22,700
!لن أدعك تتدخّل بعد الآن

148
00:11:24,170 --> 00:11:26,710
!لا بأس، ابقَ مكانك وحسب

149
00:11:26,710 --> 00:11:27,660
!حسناً

150
00:11:33,210 --> 00:11:35,230
من ينظّف هذا؟

151
00:11:35,230 --> 00:11:37,090
نحن كما أظنّ

152
00:11:44,650 --> 00:11:46,130
أين أنتِ يا داليث؟

153
00:11:47,950 --> 00:11:51,560
لا يستطيع سحري تغيير القدر

154
00:11:52,970 --> 00:11:56,900
لا يستطيع سحري حماية كاف

155
00:11:57,420 --> 00:12:00,320
!كلّها غلطتي

156
00:12:00,710 --> 00:12:04,570
...انطلى عليه وهم بسيط كهذا

157
00:12:05,310 --> 00:12:09,290
يصبح زاين ضعيفاً جدّاً
عندما تدخل كاف في الأمر

158
00:12:09,640 --> 00:12:12,050
هذه طريقة ممتازة لتوفير الوقت

159
00:12:12,570 --> 00:12:14,290
!اخرجي يا داليث

160
00:12:15,970 --> 00:12:19,250
لمَ لا أجعل هذا أكثر تسلية؟

161
00:12:29,340 --> 00:12:30,400
!كاف

162
00:12:33,590 --> 00:12:35,770
سحر داليث؟

163
00:12:38,360 --> 00:12:38,940
كاف؟

164
00:12:40,080 --> 00:12:41,260
!كاف

165
00:12:41,260 --> 00:12:42,150
!زاين

166
00:12:42,450 --> 00:12:44,580
!لا تستعمل سحرك

167
00:12:44,580 --> 00:12:47,370
!يمكنني التعامل مع هذا بمفردي

168
00:12:47,890 --> 00:12:51,610
استعمل سحرك

169
00:12:52,720 --> 00:12:53,790
...أنقذني

170
00:12:54,490 --> 00:12:56,240
أنقذني

171
00:12:59,240 --> 00:13:00,380
صحيح

172
00:13:01,420 --> 00:13:05,880
أنا الوحيد القادر على حماية ابتسامتها

173
00:13:06,550 --> 00:13:09,600
عليّ مواجهة نفسي

174
00:13:10,600 --> 00:13:12,060
!وسحري

175
00:13:13,830 --> 00:13:14,940
...أيّها الزمن

176
00:13:15,690 --> 00:13:16,680
!توقّف

177
00:13:44,560 --> 00:13:45,690
زاين؟

178
00:13:46,640 --> 00:13:49,220
استعملت سحرك لإيقاف الزمن؟

179
00:13:49,220 --> 00:13:53,710
،مهما يحصل من الآن فصاعداً
سأستعمل سحري لحمايتك

180
00:13:54,120 --> 00:13:55,410
حقّاً؟

181
00:13:58,810 --> 00:14:00,260
أ-أنزلني

182
00:14:00,260 --> 00:14:01,250
لمَ؟

183
00:14:01,250 --> 00:14:02,610
لا أحد ينظر

184
00:14:02,610 --> 00:14:03,920
...القليل فحسب

185
00:14:03,920 --> 00:14:06,070
!أنزلني! لا يروقني هذا

186
00:14:08,130 --> 00:14:11,230
حسناً، لا يمكنهما الحركة الآن

187
00:14:11,230 --> 00:14:12,990
...التالية هي داليث

188
00:14:14,230 --> 00:14:16,340
لن يصمد سحري لتلك المدّة

189
00:14:16,690 --> 00:14:19,240
لا أعتقد أنّنا نملك وقتاً لإيجاد داليث

190
00:14:19,740 --> 00:14:22,710
سأبطل التعويذة وأعيد جريان الزمان، حسناً؟

191
00:14:23,300 --> 00:14:24,340
انتظر

192
00:14:26,500 --> 00:14:28,280
أيمكنني قول شيءٍ قبلها؟

193
00:14:42,850 --> 00:14:44,690
!هذه إجابتي على اعترافك

194
00:14:46,940 --> 00:14:52,570
!أجل! مرحى! أجل! مرحى

195
00:14:48,260 --> 00:14:51,190
!أجل

196
00:14:52,570 --> 00:14:54,700
حسناً، أبطل التعويذة

197
00:14:54,700 --> 00:14:56,540
!لا، مرّة أخرى

198
00:14:56,540 --> 00:14:58,570
...ليس مرّة واحدة، بل اثنتين أو ثلاثة أخرى

199
00:15:05,310 --> 00:15:09,240
!يا جماعة، نجح الوهم

200
00:15:09,240 --> 00:15:10,440
!مُذهل

201
00:15:10,970 --> 00:15:12,010
متى انتقلا هناك؟

202
00:15:12,840 --> 00:15:15,400
هل أوقف زاين الزمن؟

203
00:15:15,830 --> 00:15:17,370
...إنّه يعاني إصابات بليغة

204
00:15:17,680 --> 00:15:19,940
لا بدّ أنّ معركة مُحتدمة قد وقعت

205
00:15:19,940 --> 00:15:23,840
!انتهى عرض اليوم

206
00:15:23,840 --> 00:15:26,360
ماذا؟ لا يزال بإمكاننا الاستمرار، أليس كذلك؟

207
00:15:26,360 --> 00:15:28,150
!لا، سنقوم بالتوضيب

208
00:15:38,400 --> 00:15:39,790
!أطلق سراحي

209
00:15:40,020 --> 00:15:42,090
لا، أنتما رهينتاي

210
00:15:42,090 --> 00:15:44,440
يمكنك لمسني أينما تشاء

211
00:15:44,440 --> 00:15:45,540
سأطلق سراحكما

212
00:15:45,670 --> 00:15:48,320
!ألا تتعلّم أبداً؟

213
00:15:48,880 --> 00:15:51,690
سموّك، هل تأذّيت؟

214
00:15:51,690 --> 00:15:53,130
أنا بخير

215
00:15:53,130 --> 00:15:54,690
ماذا عنكِ؟

216
00:15:54,690 --> 00:15:56,860
أنا بخيرٍ كما ترى

217
00:15:56,860 --> 00:16:00,890
أيمكننا الكلام قليلاً؟

218
00:16:02,170 --> 00:16:04,310
أيمكن أنّكِ داليث؟

219
00:16:05,920 --> 00:16:10,220
!حاولتِ إفساد السيرك! أساليبكِ دنيئة

220
00:16:10,690 --> 00:16:13,530
...أعرف أنّك بحاجة سحر زاين، لكن

221
00:16:13,770 --> 00:16:17,860
إرغام زاين على استعمال سحره
يصبّ في صالحكما أيضاً

222
00:16:18,210 --> 00:16:21,150
تحديداً أنتِ يا أليس

223
00:16:21,990 --> 00:16:24,290
سأوقظ شارون من نومها

224
00:16:27,650 --> 00:16:30,320
ماتت أمّي في حادث
منذ وقتٍ طويل

225
00:16:30,320 --> 00:16:31,460
لم تمت

226
00:16:32,000 --> 00:16:35,820
لم تري جثتها قطّ، أليس كذلك؟

227
00:16:36,200 --> 00:16:38,680
أُخبرتِ أنّها ماتت في حادث وحسب

228
00:16:39,390 --> 00:16:42,180
أجل، ما كان اسمه؟

229
00:16:42,830 --> 00:16:45,640
...الرجل في القصر

230
00:16:52,480 --> 00:16:55,200
أتصدّقيني؟

231
00:16:56,610 --> 00:16:58,160
لا أدري

232
00:16:58,160 --> 00:17:01,140
لكن سيغمرني السرور
لو كان الأمر صحيحاً

233
00:17:04,970 --> 00:17:06,290
!كـ-كاف

234
00:17:07,770 --> 00:17:09,750
تعادلنا الآن

235
00:17:14,020 --> 00:17:15,260
رأيتم، أليس كذلك؟

236
00:17:18,600 --> 00:17:20,560
!أخافني ذلك

237
00:17:21,410 --> 00:17:24,410
...فهمت، زاين وكاف إذاً

238
00:17:27,830 --> 00:17:30,110
!بلاءٌ موفق اليوم

239
00:17:34,150 --> 00:17:37,320
!كان عرض اليوم الكبير مسليّاً جدّاً

240
00:17:37,320 --> 00:17:40,540
،هذه أوّل مرّة أرى فيها حانة حقيقيّة
وليس في صورة وحسب

241
00:17:40,540 --> 00:17:43,080
أخبرتك أنّك ستستقطب شعبيّة كبيرة

242
00:17:43,080 --> 00:17:46,040
كان اليوم أوّل مرّة أراد أحدٌ فيها
توقيعي في حياتي

243
00:17:46,630 --> 00:17:49,020
لكنّي شعرت بالخوف وهربت

244
00:17:49,020 --> 00:17:50,500
هذه سجيّتك سموّك

245
00:17:55,060 --> 00:17:56,470
...بالمناسبة

246
00:17:57,490 --> 00:17:59,680
أأنتما ساحرتان يا زاين وكاف؟

247
00:18:06,880 --> 00:18:08,340
ما-ماذا؟

248
00:18:08,340 --> 00:18:09,650
كما ظننت

249
00:18:12,620 --> 00:18:16,610
يوضّح ذلك الكثير عن اليوم وما سبق

250
00:18:17,150 --> 00:18:19,070
!أنتما بغاية الروعة

251
00:18:19,880 --> 00:18:22,330
!كان عليكما قول شيء قبلاً

252
00:18:23,240 --> 00:18:24,530
ذلك كلّ شيء؟

253
00:18:25,360 --> 00:18:28,980
أشعر بأنّي أحمق لإخفاء الأمر سرّاً

254
00:18:30,230 --> 00:18:33,150
وأليس عليك محاولة التخلّص منا؟

255
00:18:33,150 --> 00:18:36,460
قد نتسبّب بمشاكل لكم
!كما حصل اليوم

256
00:18:36,460 --> 00:18:38,260
إن أردتم التسبّب بمشاكل لنا، فلا بأس

257
00:18:38,630 --> 00:18:40,760
نحن نسبّب مشاكل لكما أيضاً

258
00:18:42,290 --> 00:18:43,390
صحيح

259
00:18:43,880 --> 00:18:45,680
لديكما أصدقاء رائعون

260
00:18:45,680 --> 00:18:47,040
أجل

261
00:18:47,040 --> 00:18:48,490
لسنا أصدقاءً

262
00:18:49,470 --> 00:18:51,730
بل عائلة

263
00:18:59,340 --> 00:19:00,930
عائلة؟

264
00:19:02,370 --> 00:19:06,500
بالكلام عن العائلة، زوجتي ساحرة

265
00:19:07,000 --> 00:19:08,580
وأخطبوطة في الواقع

266
00:19:08,580 --> 00:19:09,540
أخطبوطة؟

267
00:19:09,880 --> 00:19:12,750
أتقصد أميليا؟

268
00:19:12,750 --> 00:19:14,700
أتعرف زوجتي؟

269
00:19:14,700 --> 00:19:17,640
أجل، ساعدتني مع لعنتي

270
00:19:17,640 --> 00:19:19,090
أهي بخير؟

271
00:19:19,090 --> 00:19:19,720
!أجل

272
00:19:21,190 --> 00:19:22,570
...فهمت

273
00:19:22,570 --> 00:19:24,370
يسرّني سماع ذلك

274
00:19:25,070 --> 00:19:29,840
تتوضّح الصورة كثيراً إن كنت زوجها

275
00:19:29,840 --> 00:19:30,690
حقّاً؟

276
00:19:31,030 --> 00:19:33,570
حسناً، يكفي كلاماً عنّي

277
00:19:33,570 --> 00:19:35,760
لدى زاين وكاف ما يقولانه، صحيح؟

278
00:19:35,760 --> 00:19:37,190
....بـ-بلى

279
00:19:39,640 --> 00:19:40,780
...في الواقع

280
00:19:42,800 --> 00:19:44,920
!مُبارك

281
00:19:45,380 --> 00:19:49,930
!نخب آخر للعشيقين الجديدين

282
00:19:54,090 --> 00:19:55,210
نخبهما

283
00:19:55,210 --> 00:19:57,670
!نخبهما

284
00:20:03,170 --> 00:20:04,590
!قبّليني الآن

285
00:20:19,050 --> 00:20:21,030
...صحيح

286
00:20:21,610 --> 00:20:23,880
بشأن لعنتك

287
00:20:23,880 --> 00:20:28,010
اعتبرها اختباراً من الربّ فُرض عليك وبإمكانك تجاوزه

288
00:20:28,010 --> 00:20:29,500
لا تدعها تثر توتّرك

289
00:20:29,500 --> 00:20:31,660
بإمكاني تجاوزه؟

290
00:20:31,660 --> 00:20:35,290
بعد إبطال اللعنة، ستعطيني تلك المصافحة

291
00:20:35,290 --> 00:20:36,750
!أعدك بذلك

292
00:20:46,600 --> 00:20:48,930
شكراً على قدومك

293
00:20:57,570 --> 00:20:59,530
شكراً بحقّ

294
00:21:01,700 --> 00:21:03,520
هل نتعانق نحن أيضاً؟

295
00:21:03,520 --> 00:21:05,150
كلّا، سأمتنع

296
00:21:05,820 --> 00:21:08,060
إلى اللقاء

297
00:21:08,060 --> 00:21:09,880
!إلى اللقاء

298
00:21:10,350 --> 00:21:12,890
لا بدّ أنّ روب بانتظارنا

299
00:21:12,890 --> 00:21:13,640
أجل

300
00:21:46,940 --> 00:21:51,090
لا تحاول تركي من جديد، مفهوم؟

301
00:23:35,720 --> 00:23:39,300
الدوق وحياة الجميع اليوميّة