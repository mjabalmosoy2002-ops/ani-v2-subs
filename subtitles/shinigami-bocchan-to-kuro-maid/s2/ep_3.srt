1
00:00:01,290 --> 00:00:08,290
أيمكنك تصوّر حياة حيث لا تستطيع
لمس الشخص الذي تحبّه؟

2
00:00:09,150 --> 00:00:14,140
تسبّبت اللعنة التي أُلقيت عليه من قِبل
الساحرة بسلبه لحيوات أيّ من يمسّهم

3
00:00:14,760 --> 00:00:19,080
نأت أمه بنفسها عنه، ونعته أصدقاؤه بالوحش

4
00:00:19,080 --> 00:00:20,460
حتّى الأشخاص الذين لم يقابلهم قطّ

5
00:00:20,460 --> 00:00:23,510
تكلّموا عنه بصفته
"تجسّد الموت الذي يقطن الغابة"

6
00:00:24,150 --> 00:00:29,180
لكنّه... لا يشعر بأية وحدة

7
00:00:35,430 --> 00:00:37,870
صباح الخير، الإفطار جاهز

8
00:00:47,670 --> 00:00:50,010
أليس، لمَ لا تستريحي قليلاً؟

9
00:00:50,010 --> 00:00:51,960
سأتكفّل بالتنظيف هذه المرّة

10
00:00:51,960 --> 00:00:52,900
...لكن

11
00:00:53,380 --> 00:00:55,300
دعي الأمر لي وحسب

12
00:00:59,540 --> 00:01:01,310
من أين أخرجتِ تلك؟

13
00:01:01,310 --> 00:01:03,790
!لا، دعيكِ من ذلك، استريحي

14
00:01:03,790 --> 00:01:05,540
لا شيء آخر لديّ لأفعله

15
00:01:05,540 --> 00:01:07,860
يمكنكِ الاسترخاء

16
00:01:07,860 --> 00:01:09,790
وجدتُها، أليس لديكِ أيّة هوايات؟

17
00:01:10,440 --> 00:01:11,500
أنت هوايتي

18
00:01:11,500 --> 00:01:13,960
شيء تحبّينه إذاً؟

19
00:01:14,280 --> 00:01:15,720
أنت ما أحبّه

20
00:01:16,120 --> 00:01:17,860
...هـ-هكذا إذاً

21
00:02:52,240 --> 00:02:55,840
اسمعي يا أليس، اسمعي

22
00:02:55,840 --> 00:03:00,320
الشخص الذي تحبّينه على وشك
الخروج من الغرفة التالية

23
00:03:00,320 --> 00:03:01,660
حاذري الارتطام به

24
00:03:02,250 --> 00:03:03,030
!أليس

25
00:03:03,410 --> 00:03:05,530
حمداً لله على أنّي لم أصطدم بك

26
00:03:05,530 --> 00:03:08,090
كنت في المكتبة في هذا الوقت المُتأخّر؟

27
00:03:08,090 --> 00:03:09,000
أجل

28
00:03:09,340 --> 00:03:11,460
أثارت بطاقة العمل هذه فضولي

29
00:03:11,760 --> 00:03:15,290
...فكنتُ أتحرّى عن علاقة الأخطبوط بالساحرات

30
00:03:15,290 --> 00:03:16,920
لكنّي لم أصل لشيء

31
00:03:17,200 --> 00:03:19,080
بُوركت جهودك

32
00:03:19,080 --> 00:03:21,040
هل ستأخذ حمّاماً؟

33
00:03:21,040 --> 00:03:23,580
لم أستحمّ بعد، لذا سيكون الوقت مثاليّاً

34
00:03:23,580 --> 00:03:25,810
!لمَ قد تظنّين أنّنا سنستحمّ معاً؟

35
00:03:25,810 --> 00:03:28,600
تقضيان وقتاً مرحاً سويّاً، يا للروعة

36
00:03:32,060 --> 00:03:35,630
...أتعرفين يا أليس، كنتُ أتساءل

37
00:03:36,020 --> 00:03:38,240
أترينها؟

38
00:03:38,240 --> 00:03:39,490
أرى ماذا؟

39
00:03:39,490 --> 00:03:40,740
!الأشباح

40
00:03:41,240 --> 00:03:44,740
شعرتُ أنّك قد ترينها بالنظر
للحادثة آنذاك مع مكفارلين

41
00:03:45,270 --> 00:03:46,810
لا أراها

42
00:03:46,810 --> 00:03:48,070
!أنتِ تكذبين

43
00:03:48,070 --> 00:03:51,710
تتظاهرين بعدم رؤيتكِ لها
!كيلا أشعر بالخوف وحسب

44
00:03:52,040 --> 00:03:54,510
أنت كلّ ما أراه

45
00:03:54,510 --> 00:03:57,120
!حقّاً؟

46
00:03:57,120 --> 00:03:59,550
!يسعدني ذلك، لكنّه لم يكن ما أقصده

47
00:04:00,540 --> 00:04:05,910
...رأيتُ تتكلّمين مع نفسك البارحة

48
00:04:07,370 --> 00:04:10,770
أتعرف أحداً يبدو مثلي إذاً؟

49
00:04:11,480 --> 00:04:13,270
اسمها شارون

50
00:04:13,270 --> 00:04:17,770
صباح الخير! الشمس بغاية السطوع"
"!اليوم! وتشعر الأمّ بخير حال

51
00:04:18,660 --> 00:04:20,730
هكذا تتكلّم

52
00:04:21,840 --> 00:04:23,260
...ظريفةٌ جدّاً

53
00:04:24,890 --> 00:04:27,730
سأكون بخير، لذا أريد منكِ إخباري بالحقيقة

54
00:04:27,730 --> 00:04:31,440
أليس، أنتِ ترين الأشباح، أليس كذلك؟

55
00:04:32,880 --> 00:04:34,260
كلّا

56
00:04:34,260 --> 00:04:35,750
!يا لعنادكِ

57
00:04:35,750 --> 00:04:37,520
لا أراها

58
00:04:38,600 --> 00:04:40,770
لكن من الممكن أنّه كان يوجد
شبح في القصر

59
00:04:40,770 --> 00:04:43,370
بفستان عروس طيفيّة منذ الأمس

60
00:04:43,370 --> 00:04:44,800
!أي ترينها

61
00:04:44,800 --> 00:04:47,060
هـ-هل تقول شيئاً؟

62
00:04:47,060 --> 00:04:50,010
مثل رغبتها بالانتقام أو
امتلاكها لشؤون عالقة؟

63
00:04:50,260 --> 00:04:54,080
،تزوّجتُ بالرجل الذي أحببته

64
00:04:54,080 --> 00:04:58,360
لكن يوم الزواج، كان هذا
الخاتم الذي تلقّيته

65
00:04:58,890 --> 00:05:00,930
استشطت غضباً وفقدت السيطرة على نفسي

66
00:05:00,930 --> 00:05:02,740
!ثمّ سقطت من على الأدراج ومت

67
00:05:03,090 --> 00:05:06,080
تلك نهاية حزينة

68
00:05:06,080 --> 00:05:07,700
أنتِ تتكلّمين معها الآن، أليس كذلك؟

69
00:05:08,320 --> 00:05:10,910
لا أراها، لكنّها تكون هكذا في العادة

70
00:05:10,910 --> 00:05:13,330
أنتِ تتصرّفين بسخافة مفرطة
!اليوم، وذلك ظريف

71
00:05:14,930 --> 00:05:16,540
ماذا عن أحد هذه؟

72
00:05:17,240 --> 00:05:21,750
لا أدري لمن ترجع، لكنّها كانت
في القصر منذ وقت طويل

73
00:05:22,400 --> 00:05:24,150
توجد مقاسات كثيرة متنوّعة

74
00:05:24,150 --> 00:05:26,100
يمكنها أخذ ما يعجبها

75
00:05:26,510 --> 00:05:29,970
،ربما إن وجدت الخاتم المثاليّ
ستتمكّن من الصعود للجنّة

76
00:05:30,620 --> 00:05:32,490
أيمكنني أخذ واحد حقّاً؟

77
00:05:32,490 --> 00:05:33,930
أجل، إن نال إعجابك

78
00:05:34,320 --> 00:05:36,420
أنتِ تتكلّمين معها الآن بالتأكيد

79
00:05:36,420 --> 00:05:37,690
لكنّي لا أراها

80
00:05:38,870 --> 00:05:43,130
كان عليه أخذ مقاس بنصرها

81
00:05:44,000 --> 00:05:46,230
ربما كان مفاجأة؟

82
00:05:46,230 --> 00:05:51,020
مع ذلك، كان بإمكانه لفّ خيط حول
إصبعها أثناء نومها أو ما شابه

83
00:05:55,590 --> 00:05:57,410
ما خطبهما؟

84
00:06:00,710 --> 00:06:02,930
بدأت أشعر بالغيرة

85
00:06:02,930 --> 00:06:04,670
أعيريني جسدكِ قليلاً

86
00:06:08,890 --> 00:06:10,510
أليس؟

87
00:06:11,690 --> 00:06:17,210
سموّك، لم أعد أستطيع التحكّم بنفسي

88
00:06:18,100 --> 00:06:20,880
ربما يوجد مكان آمن
يمكنك لمسي فيه

89
00:06:21,530 --> 00:06:24,190
لمَ لا نكتشف معاً؟

90
00:06:26,690 --> 00:06:28,250
!لـ-لا

91
00:06:28,250 --> 00:06:32,030
!لا أعتقد أنّ بإمكاني التحكّم بنفسي

92
00:06:32,030 --> 00:06:33,530
!آسفٌ يا أليس

93
00:06:34,540 --> 00:06:36,500
لمَ هرب؟

94
00:06:36,930 --> 00:06:39,800
لا يلائمني سوى عزيزي

95
00:06:40,450 --> 00:06:43,290
سأنتظر لحين موته

96
00:06:43,290 --> 00:06:45,460
ستنتظرين طوال ذاك الوقت؟

97
00:06:45,900 --> 00:06:48,520
أجل، فأنا أحبّه بحقّ

98
00:06:48,520 --> 00:06:51,430
وبالتفكير الآن، أعتقد أنّ بإمكاني
مسامحته على وضع الخاتم

99
00:06:52,620 --> 00:06:57,440
كما عليّ الاعتذار على الموت
فجأة وتركه بمفرده

100
00:06:57,440 --> 00:07:00,180
أعتقد أنّي ضخمّت الموضوع

101
00:07:00,880 --> 00:07:04,120
اشعر بالرضى الآن، سأمضي للعالم التالي وحسب

102
00:07:04,120 --> 00:07:06,020
يمكنك أخذ هذه

103
00:07:09,200 --> 00:07:11,450
آمل أن تجدي السعادة

104
00:07:12,140 --> 00:07:13,810
وأنتما أيضاً

105
00:07:21,460 --> 00:07:23,390
هل ستأتي اليوم برأيك؟

106
00:07:24,340 --> 00:07:29,090
كان يُفترض أن يأتي مالك بطاقة
العمل هذه خلال بضعة أيّام

107
00:07:29,350 --> 00:07:31,840
ذلك ما قالته داليث

108
00:07:31,840 --> 00:07:34,310
!لكن عليّ طرده فورما يأتي

109
00:07:34,310 --> 00:07:35,850
أأنت مُتأكّد؟

110
00:07:37,310 --> 00:07:39,810
،أتمنّى إبطال اللعنة بالطبع

111
00:07:40,200 --> 00:07:44,770
،لكن إذا أصبحت أدين لداليث بمعروف
سيتعيّن عليّ فعل ما تريده

112
00:07:45,240 --> 00:07:51,530
أودّ منك أن تطلب منه
استعمال سحر الزمن من جديد

113
00:07:52,570 --> 00:07:56,880
وعدتُ زاين، فلا أستطيع إخباركِ بالتفاصيل

114
00:07:57,210 --> 00:07:59,680
لكنّي لا أريد
التسبّب بمتاعب له

115
00:07:59,680 --> 00:08:00,500
اطمئنّي

116
00:08:00,840 --> 00:08:04,410
مهما كانت الساحرة التي ستأتي، سأقوم بحمايتكِ

117
00:08:04,410 --> 00:08:05,880
يا للشجاعة

118
00:08:06,270 --> 00:08:07,250
...دعني أشكرك عبر

119
00:08:07,250 --> 00:08:08,820
!لا تخلعي ثيابك

120
00:08:08,820 --> 00:08:10,380
أأنت وسيط روحيّ؟

121
00:08:13,600 --> 00:08:15,390
يبدو أنّ أحداً أتى

122
00:08:20,230 --> 00:08:21,810
...حـ-حان الوقت

123
00:08:22,780 --> 00:08:24,550
أخبرتني داليث بالقدوم هنا

124
00:08:24,550 --> 00:08:26,520
أهذا المكان المقصود؟

125
00:08:26,520 --> 00:08:28,490
...حـ-حسناً، نحن

126
00:08:28,490 --> 00:08:30,400
أهذه بطاقة عملك؟

127
00:08:30,400 --> 00:08:34,270
...رائع! وصلتُ أخيراً

128
00:08:39,720 --> 00:08:41,290
...ما-ماء

129
00:08:41,900 --> 00:08:44,750
!ضعوني في ماء مالح سريعاً

130
00:08:45,930 --> 00:08:48,460
!شكراً جزيلاً لكم

131
00:08:49,110 --> 00:08:53,520
،مضى وقت طويل مذ أتيت للبرّ
ونسيت كيف يكون الأمر

132
00:08:53,520 --> 00:08:55,930
!كدتُ أجفّ

133
00:08:56,490 --> 00:08:58,450
...لم أكن أفكّر عندما أنقذتك، لكن

134
00:08:58,450 --> 00:09:01,410
أنتِ الساحرة التي تجيد
إبطال اللعنات، أليس كذلك؟

135
00:09:01,410 --> 00:09:03,990
صحيح، اسمي أميليا

136
00:09:03,990 --> 00:09:08,890
لستُ ساحرةً تماماً... بل أقرب
لأخطبوط وُلِد بسحر

137
00:09:11,130 --> 00:09:13,490
أخبرتني داليث عنك

138
00:09:13,790 --> 00:09:17,950
لعنة تقتل المرء بمجرد لمسه، صحيح؟

139
00:09:18,510 --> 00:09:21,290
أبطلت لعنة مُماثلة في الماضي

140
00:09:21,290 --> 00:09:23,160
...لن أعرف حتّى أجرّب، لكن

141
00:09:25,130 --> 00:09:27,620
!قد أستطيع إبطال لعنتك

142
00:09:31,590 --> 00:09:35,050
أنا... أكره قول هذا بعدما
،قطعتِ كلّ ذاك الطريق

143
00:09:35,930 --> 00:09:37,510
لكنّي أفكّر بالرفض

144
00:09:38,830 --> 00:09:41,020
لا أريد أن أدين لداليث بشيء

145
00:09:41,020 --> 00:09:42,970
سيسبّب ذلك متاعب لصديقٍ لي

146
00:09:42,970 --> 00:09:46,440
البشر مُخلصون دوماً

147
00:09:46,440 --> 00:09:48,190
!يا لكم من مخلوقات مسليّة

148
00:09:48,650 --> 00:09:51,450
أسبق وأن تعاملتِ مع البشر؟

149
00:09:51,450 --> 00:09:56,120
أجل، تزوّجت رجلاً فريداً قبل عقد من الزمان

150
00:09:56,120 --> 00:09:56,900
!تزوّجتِ؟

151
00:09:57,260 --> 00:10:00,100
...مع أنّه كان شكليّاً فحسب

152
00:10:00,940 --> 00:10:03,400
،كنتُ أشعر بالضجر آنذاك

153
00:10:03,400 --> 00:10:05,170
وأتقمّص هيئة أخطبوط عملاق

154
00:10:05,170 --> 00:10:07,330
وأهاجم الحمولة التي تنقلها السفن

155
00:10:07,700 --> 00:10:11,540
لكن في أجد الأيّام، هاجمت
سفينة قراصنة مسلّحة

156
00:10:13,450 --> 00:10:16,050
..يبدو أنّ هذه نهايتي

157
00:10:18,770 --> 00:10:20,570
ما هذا؟

158
00:10:20,570 --> 00:10:22,110
!أخرجوني

159
00:10:24,170 --> 00:10:25,730
ابقي ساكنة

160
00:10:25,730 --> 00:10:27,730
لن أقوم بأذيّتك

161
00:10:28,960 --> 00:10:31,840
،صادف أن كان على متن السفينة ذاك اليوم

162
00:10:31,840 --> 00:10:35,570
وقام بإخفائي بين الحمولة
كي أستطيع الهروب

163
00:10:35,570 --> 00:10:38,200
شـ-شكراً لك على مساعدتي

164
00:10:38,500 --> 00:10:40,030
لا تهتمّي

165
00:10:40,030 --> 00:10:43,700
ما أكثر تسلية من الكلام
مع ساحرة أخطبوطيّة؟

166
00:10:43,700 --> 00:10:45,160
أهكذا الأمر؟

167
00:10:50,250 --> 00:10:51,480
ألديكِ حبيب؟

168
00:10:52,880 --> 00:10:55,880
...حدث الأمر سريعاً بعدها

169
00:10:56,140 --> 00:10:58,800
...تبادلنا الخواتم، رغم أنّها كانت رخيصة الثمن

170
00:10:58,800 --> 00:11:02,040
ورجع للمدينة، بينما ذهبتُ للبحر

171
00:11:02,410 --> 00:11:06,350
أشكّ بأنّه يتذكّر، لكنّها ذكرى جميلة لي

172
00:11:06,900 --> 00:11:10,560
لم أره بعدها قطّ، لكنّي لا أزال أحبّه

173
00:11:10,560 --> 00:11:12,560
!ذلك شاعريٌّ جدّاً

174
00:11:12,810 --> 00:11:13,680
صحيح؟

175
00:11:13,680 --> 00:11:17,290
أنا لستُ مثل الحوريّات الجميلات
!في القصص الخياليّة

176
00:11:17,290 --> 00:11:19,290
!من يعلم ما الذي أعجبه فيّ؟

177
00:11:19,290 --> 00:11:20,990
!ا-اختفت؟

178
00:11:20,990 --> 00:11:22,970
لا، إنّه تمويه

179
00:11:22,970 --> 00:11:26,430
غيّرت لون جسدها لملاءمة محيطها

180
00:11:26,430 --> 00:11:28,120
حتّى لا نرى مدى إحراجها؟

181
00:11:31,770 --> 00:11:35,760
أعرف أنّك مُتضايق حيال
...ما قالته داليث، لكن

182
00:11:35,760 --> 00:11:38,300
لا أستطيع ودعك بتمكّني
من إبطال اللعنة

183
00:11:38,300 --> 00:11:42,820
لمَ لا تدعني أجرّب قبل
أن تقرّر ما ستفعله؟

184
00:11:42,820 --> 00:11:43,550
...لكن

185
00:11:44,030 --> 00:11:46,270
أتخاف من داليث لذاك الحدّ؟

186
00:11:46,270 --> 00:11:47,760
!أجل

187
00:11:47,760 --> 00:11:52,270
لديها قناعٌ مخيف، ولا أستطيع معرفة
!ما تفكّر به أبداً

188
00:11:52,880 --> 00:11:55,550
يمكن أن تكون معقّدةً حقّاً

189
00:11:55,550 --> 00:11:57,150
لا تعرف كيف تعبّر عن نفسها

190
00:11:57,150 --> 00:11:58,400
وتعسّر حياتها

191
00:11:58,980 --> 00:12:04,450
لكنّها ليست فتاةً سيّئة، لا تبغضها كثيراً

192
00:12:04,450 --> 00:12:06,630
!لكنّها تحكم عالم الساحرات

193
00:12:06,630 --> 00:12:11,620
،ذلك أمرٌ يخصّ الساحرات
أنا أخطبوط، فلا أبالي

194
00:12:11,620 --> 00:12:15,900
أصبحت تحكمه لأنّ الجميع أرادوا
منها ذلك وحسب، ولم تستطع الرفض

195
00:12:17,030 --> 00:12:20,700
لنرَ ما إن كان بإمكاننا
إبطال لعنتك أوّلاً

196
00:12:20,700 --> 00:12:24,670
وإلّا لمَ خاطرتُ بحياتي للقدوم إلى هنا؟

197
00:12:24,670 --> 00:12:25,890
...معكِ حقّ

198
00:12:26,360 --> 00:12:29,260
ما احتمال تمكّنكِ من إبطالها؟

199
00:12:29,260 --> 00:12:32,290
يعتمد ذلك على قوّة الساحرة
التي ألقت اللعنة

200
00:12:32,290 --> 00:12:35,920
لكن من خبرتي، أرجّح وجود
%فرصة 80

201
00:12:37,940 --> 00:12:39,320
...ثمانون بالمئة

202
00:12:43,010 --> 00:12:49,200
إن أبطلت اللعنة، هل سأتمكّن من
وضع خاتم على إصبع أليس؟

203
00:12:51,150 --> 00:12:52,660
بالطبع

204
00:12:53,960 --> 00:12:55,370
ساعديني رجاءً إذاً

205
00:12:55,370 --> 00:12:58,630
إن نجحتِ، سأعوّض على داليث بطريقة أخرى

206
00:12:59,340 --> 00:13:01,380
!رائع

207
00:13:03,090 --> 00:13:08,140
لنحوّلك لإنسان طبيعيّ من فورنا إذاً

208
00:13:15,390 --> 00:13:17,350
ها أنا ذي أيّها الفتى الملعون المسكين

209
00:13:20,170 --> 00:13:21,860
!لا تتفاداني

210
00:13:21,860 --> 00:13:23,530
!آسف، هذا تراكم عادة من سنين

211
00:13:23,830 --> 00:13:26,800
!لكن من الخطر لمسي

212
00:13:26,800 --> 00:13:29,030
الساحرات والأخطبوط مخلوقات حيّة

213
00:13:29,030 --> 00:13:31,100
أنا مُحترفة

214
00:13:31,100 --> 00:13:36,000
تلتصق اللعنة بجسد صاحبها مثل الغطاء

215
00:13:37,830 --> 00:13:41,370
إن أردت إبطال اللعنة، فيجب نزعه وحسب

216
00:13:41,370 --> 00:13:43,420
لا حاجة بي لألمسك

217
00:13:43,740 --> 00:13:46,390
أتريد أن ترى قوّتي بأمّ عينك؟

218
00:13:51,400 --> 00:13:54,050
ماذا؟ سمك؟

219
00:13:54,050 --> 00:13:56,820
البحر مصدر كافّة الأحياء

220
00:13:57,260 --> 00:14:01,190
يمكنني استدعاء القوّة العظيمة
التي تقطن البحار

221
00:14:02,340 --> 00:14:04,340
يمكنني التنفّس والكلام

222
00:14:04,340 --> 00:14:06,700
مُذهل! أهذا سحرك؟

223
00:14:06,700 --> 00:14:08,690
!أنتِ عبقرّية بحقّ

224
00:14:10,040 --> 00:14:11,330
!لكن لا تختفي رجاءً

225
00:14:11,330 --> 00:14:12,620
!يُصعّب ذلك إطراءكِ

226
00:14:15,920 --> 00:14:18,110
أهي حيّة؟

227
00:14:19,280 --> 00:14:22,750
الأسماك ظريفةٌ جدّاً

228
00:14:24,060 --> 00:14:26,800
!إنّها ظريفة! وكذلك أنتِ

229
00:14:26,800 --> 00:14:29,220
من المُدهش أنّ بإمكانك
البكاء تحت الماء

230
00:14:30,730 --> 00:14:32,270
انظر سموّك

231
00:14:32,270 --> 00:14:33,180
الرواق أيضاً

232
00:14:33,770 --> 00:14:35,690
!ويوجد حوتٌ في الخارج

233
00:14:36,390 --> 00:14:39,710
يغطّي سحري هذا القصر بأسره

234
00:14:39,710 --> 00:14:41,750
لمَ لا تتمشيان قليلاً؟

235
00:14:41,750 --> 00:14:42,900
!مرحى

236
00:14:44,850 --> 00:14:46,700
يبدو فتىً صالحاً

237
00:14:46,700 --> 00:14:49,400
لمَ لُعِن يا ترى؟

238
00:14:52,700 --> 00:14:56,120
،أنا أنظر للقصر من الأعلى
ذلك غريبٌ حقّاً

239
00:14:56,480 --> 00:14:58,820
!انظري يا أليس! يوجد دلفين بجواري

240
00:14:58,820 --> 00:15:00,830
يا لظرافته

241
00:15:01,700 --> 00:15:03,070
هذا مُسلٍّ

242
00:15:03,070 --> 00:15:06,700
لم يسبق وأن رأيت سمكاً
يبحر بهذا القرب منّي

243
00:15:06,700 --> 00:15:07,800
ولا أنا

244
00:15:12,220 --> 00:15:16,260
كما لو أنّي في موعد
أسفل الماء معك

245
00:15:16,260 --> 00:15:19,050
مـ-موعد؟ حقّاً؟

246
00:16:05,730 --> 00:16:07,310
لنرَ ما بالأسفل أيضاً

247
00:16:07,310 --> 00:16:08,440
حسناً

248
00:16:10,940 --> 00:16:12,570
!قرش ببري

249
00:16:12,570 --> 00:16:14,110
!تخطيطه ظريفٌ جدّاً

250
00:16:14,110 --> 00:16:16,550
!وذلك قرش فيليّ بجوارك

251
00:16:16,550 --> 00:16:18,010
أترين كيف يشبه أنفه خرطوم الفيل؟

252
00:16:18,010 --> 00:16:18,620
أجل

253
00:16:19,380 --> 00:16:23,920
رؤية هذه الأسماء من مختلف أنحاء
العالم في مكان واحد أمر غريب بحقّ

254
00:16:23,920 --> 00:16:25,830
أنت تعرف الكثير عن الأسماك سموّك

255
00:16:25,830 --> 00:16:30,050
مُذ أتيت هنا، كنت بمفردي وقت اللهو دوماً

256
00:16:30,750 --> 00:16:34,760
لم تكن لديّ أشياء كثيرة أفعلها عدا
رسم صور من الموسوعة

257
00:16:38,420 --> 00:16:40,650
أسماء أعماق البحر فريدة أيضاً

258
00:16:40,650 --> 00:16:42,480
أجل، إنّها ظريفةٌ نوعاً ما

259
00:16:42,820 --> 00:16:44,090
هل استمتعتما؟

260
00:16:44,090 --> 00:16:45,370
!أجل، كثيراً

261
00:16:45,370 --> 00:16:47,160
كان وقتاً رائعاً

262
00:16:47,160 --> 00:16:48,630
يسرّني ذلك

263
00:16:48,630 --> 00:16:51,190
هل أبدأ العمل الآن إذاً؟

264
00:16:51,190 --> 00:16:53,420
أجل، أعتذر على التحمّس

265
00:16:53,420 --> 00:16:55,620
لا تتحرّك، مدّ يدك

266
00:16:55,620 --> 00:16:56,430
حسناً

267
00:17:04,400 --> 00:17:05,830
أميليا-سان؟

268
00:17:05,830 --> 00:17:07,360
أنا بخير

269
00:17:07,360 --> 00:17:10,700
لكن ما الذي حدث في ماضيك؟

270
00:17:11,730 --> 00:17:16,140
أفهم الآن لمَ أتت داليث لي

271
00:17:16,140 --> 00:17:22,380
أعرف ساحرة واحد فحسب على مرّ التاريخ
!بإمكانها إلقاء لعنة شرّيرة كهذه

272
00:17:27,360 --> 00:17:30,170
هل ستتمكّن أميليا من إبطال تلك اللعنة؟

273
00:17:30,860 --> 00:17:33,850
حسناً، لا أتوقّع الكثير

274
00:17:34,860 --> 00:17:38,250
زاين، لا تترك طفلاً يحمل
!أغراض ثقيلة كهذه

275
00:17:38,250 --> 00:17:40,280
!أنا أحمل أكثر منك

276
00:17:40,280 --> 00:17:44,220
لا تتصرّف كصبيّ عندما يكون
الأمر بصالحك وحسب

277
00:17:44,690 --> 00:17:45,960
...الجوزاء

278
00:17:46,990 --> 00:17:48,430
كوكبة التوأمين

279
00:17:49,710 --> 00:17:51,490
ما-ما قصدك؟

280
00:17:51,490 --> 00:17:53,890
تعرفين الساحرة التي لعنتني؟

281
00:17:53,890 --> 00:17:55,170
شاهد وحسب

282
00:17:56,690 --> 00:17:58,020
...هذا

283
00:17:58,020 --> 00:18:00,060
اللعنة الموضوعة عليك

284
00:18:00,060 --> 00:18:01,640
،حتّى لو حاولتُ إزالتها

285
00:18:03,050 --> 00:18:05,560
تلتصق بك بشدّة

286
00:18:05,930 --> 00:18:07,890
أميليا-سان، لا تبدين بخير

287
00:18:08,370 --> 00:18:11,210
تؤثر عليّ القوّة الشرّيرة

288
00:18:11,210 --> 00:18:13,910
لا تضايقني يا أخطبوط المظلّة الصغير

289
00:18:15,270 --> 00:18:19,150
سمعت أنّها ماتت، لكن يبدو أنّي
لا أستطيع إبطال اللعنة مع ذلك

290
00:18:19,150 --> 00:18:21,320
من تلك الساحرة؟

291
00:18:21,950 --> 00:18:26,580
شادي، أخت داليث التوأم

292
00:18:27,530 --> 00:18:28,790
أختها؟

293
00:18:29,160 --> 00:18:31,030
لا يمكنك التفكير بدافع لفعلها هذا؟

294
00:18:31,030 --> 00:18:31,930
كلّا

295
00:18:31,930 --> 00:18:34,750
هذه أوّل مرّة عرفت فيها
امتلاك داليث لأخت توأم

296
00:18:36,310 --> 00:18:42,100
أكانت المرأتان في رداء الراهبات
اللتين ذكرهما السجّل داليث-سان وشادي-سان؟

297
00:18:42,970 --> 00:18:45,720
لكن ما الذي كانتا تفعلانه
هناك في ذاك اليوم؟

298
00:18:45,980 --> 00:18:51,100
سبب رغبة داليث بسحر التحكّم بالزمن
له علاقة بشادي إذاً؟

299
00:18:51,600 --> 00:18:53,930
أيمكن أنّها تودّ إعادتها للحياة؟

300
00:18:54,590 --> 00:18:56,000
لا أدري

301
00:18:56,000 --> 00:18:58,090
هل قلتُ الكثير؟

302
00:18:58,090 --> 00:18:59,900
ستغضب منّي داليث

303
00:19:01,300 --> 00:19:04,120
تلك اللعنة أكثر قوّة منّي بمراحل

304
00:19:04,120 --> 00:19:07,210
أنا آسفة، لا أعتقد أنّي سأستطيع إبطالها

305
00:19:07,700 --> 00:19:10,540
كيف ماتت ساحرة بتلك القوّة؟

306
00:19:10,820 --> 00:19:13,500
...حتّى أنا لا أدري

307
00:19:14,890 --> 00:19:16,030
...السمك

308
00:19:16,030 --> 00:19:16,970
ما الذي يجري؟

309
00:19:18,160 --> 00:19:19,100
أميليا؟

310
00:19:19,100 --> 00:19:21,070
آسفة، لم أعد أستطيع الصمود

311
00:19:21,070 --> 00:19:23,430
!انقلوني للبحر

312
00:19:23,430 --> 00:19:24,650
!أرجوكم

313
00:19:24,650 --> 00:19:26,220
...كـ-كيف نفعل

314
00:19:29,700 --> 00:19:32,340
أعتذر على عدم استطاعتي المساعدة

315
00:19:32,340 --> 00:19:36,360
لا بأس، أعتذر على عدم تضييفنا لك كما يجب

316
00:19:36,710 --> 00:19:39,530
آمل أن تستطيعي لقاء زوجكِ
من جديد يوماً ما

317
00:19:39,750 --> 00:19:42,490
شكراً لك

318
00:19:43,940 --> 00:19:45,750
كونا بسلام

319
00:19:45,750 --> 00:19:48,050
أتطلّع لرؤيتكما من جديد

320
00:19:48,050 --> 00:19:49,180
أ-أجل

321
00:19:49,490 --> 00:19:52,460
مع أنّي لا أدري أين أنظر وأنا أتكلّم

322
00:19:56,170 --> 00:19:57,490
اسمعي يا أليس

323
00:19:57,820 --> 00:20:00,780
لنذهب لرؤية كاف وزاين عمَّ قريب

324
00:20:01,190 --> 00:20:03,760
أودّ الكلام معهما حيال داليث وشادي

325
00:20:03,760 --> 00:20:07,890
من النادر أن تريد الذهاب للبلدة

326
00:20:08,520 --> 00:20:10,480
،إن أردت تذاكر للسيرك

327
00:20:10,910 --> 00:20:12,970
فأعطاني كاف-سان بعضها

328
00:20:12,970 --> 00:20:15,100
تضعين أشياء هناك من جديد؟

329
00:20:16,190 --> 00:20:17,860
...عندما تُبطل اللعنة

330
00:20:18,380 --> 00:20:20,570
أودّ الذهاب لمختلف الأماكن معكِ

331
00:20:21,120 --> 00:20:26,030
أعرف ما يكمن وراء ذاك
الأفق من الكتب وحسب

332
00:20:26,790 --> 00:20:30,000
أريد رؤية الأشياء بأمّ عيني

333
00:20:30,670 --> 00:20:32,460
أين تودّين الذهاب يا أليس؟

334
00:20:32,830 --> 00:20:37,420
،حسناً... مكان مولدي
حيث عشت مع أمّي

335
00:20:38,390 --> 00:20:41,290
،تبقّت لي ذكريات ضبابيّة عنه

336
00:20:41,290 --> 00:20:43,380
لكن كانت توجد حديقة كبيرة

337
00:20:43,380 --> 00:20:47,430
وعلّمتني أمّي عن الأزهار هناك

338
00:20:48,030 --> 00:20:52,890
أتمنّى أن تراها يوماً ما سموّك

339
00:20:53,240 --> 00:20:54,440
!لنذهب إذاً

340
00:20:54,440 --> 00:20:55,400
!لنتعاهد

341
00:20:55,720 --> 00:20:58,360
يمكننا اصطحاب روب وفيولا
وكاف وزاين معنا

342
00:20:59,020 --> 00:21:02,820
أتمنّى أن تأتي أمّي وأبي ووالتر أيضاً

343
00:21:03,090 --> 00:21:03,930
صحيح؟

344
00:21:03,930 --> 00:21:07,390
عندما تُبطل اللعنة، سنذهب
لحيث ترعرعتِ معاً

345
00:21:07,390 --> 00:21:08,280
!ذلك وعد

346
00:21:09,930 --> 00:21:11,140
...معاً

347
00:21:12,380 --> 00:21:18,460
ما مدى سعادتي إذا بقيت معك
عندما تُبطل اللعنة؟

348
00:21:20,920 --> 00:21:21,810
أجل

349
00:21:22,660 --> 00:21:24,520
لنتعاهد

350
00:21:24,520 --> 00:21:25,280
أجل

351
00:21:28,530 --> 00:21:30,790
البحر باردٌ ليلاً

352
00:21:30,790 --> 00:21:32,770
أتودّ أن نتعرّى وندفئ بعضنا؟

353
00:21:33,160 --> 00:21:34,960
...لا أحبّذ ذلك

354
00:23:07,120 --> 00:23:10,260
أخبرني، أنت متزوّج أيّها الرئيس، صحيح؟

355
00:23:10,260 --> 00:23:11,700
كيف زوجتك؟

356
00:23:12,360 --> 00:23:13,690
إنّها جميلة

357
00:23:14,120 --> 00:23:16,340
سريعة الإحراج وتحبّ إخفاء نفسها

358
00:23:16,340 --> 00:23:19,210
ويداها بهذا الحجم، ولديها ثمانية سيقان

359
00:23:19,210 --> 00:23:21,700
!اختلقت الجزء الأخير

360
00:23:21,700 --> 00:23:24,710
لكنّنا عشنا منفصلين لعشرة أعوام

361
00:23:25,510 --> 00:23:27,350
...أنا أفتقدها

362
00:23:27,350 --> 00:23:29,540
سأذهب لتنظيف دورة المياه

363
00:23:29,540 --> 00:23:31,490
!لا تفزع الصبيّ هكذا

364
00:23:31,490 --> 00:23:31,970
ماذا؟

365
00:23:35,660 --> 00:23:39,360
الدوق وأليس والسيرك 101