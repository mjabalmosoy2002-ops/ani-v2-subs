1
00:00:01,290 --> 00:00:08,260
أيمكنك تصوّر حياة حيث لا تستطيع
لمس الشخص الذي تحبّه؟

2
00:00:09,130 --> 00:00:14,170
تسبّبت اللعنة التي أُلقيت عليه من قِبل
الساحرة بسلبه لحيوات أيّ من يمسّهم

3
00:00:14,750 --> 00:00:19,090
نأت أمه بنفسها عنه، ونعته أصدقاؤه بالوحش

4
00:00:19,090 --> 00:00:23,440
حتّى الأشخاص الذين لم يقابلهم قطّ تكلّموا عنه
"بصفته "تجسّد الموت الذي يقطن الغابة

5
00:00:24,150 --> 00:00:29,210
لكنّه... لا يشعر بأية وحدة

6
00:00:39,790 --> 00:00:44,680
تقول فيولا أنّها دائماً ما تقع في حبّ
...الأشخاص الأكبر سنّاً، فسألتها

7
00:00:45,220 --> 00:00:49,470
ألن يكون من المُحزن رحيل الشخص
الذي تحبّينه قبلك؟

8
00:00:50,560 --> 00:00:52,150
...ما تقوله

9
00:00:52,760 --> 00:00:58,270
أنّها تفضّل تحمّل الحزن على
تحميله للشخص الذي تحبّه

10
00:01:01,790 --> 00:01:03,270
ما رأيك يا زاين؟

11
00:01:03,880 --> 00:01:04,830
...أنا

12
00:01:05,180 --> 00:01:08,110
الأمر معقّدٌ عليّ ولا أفهمه

13
00:01:08,110 --> 00:01:09,040
حمقاء

14
00:01:12,460 --> 00:01:13,510
...أنا

15
00:01:14,820 --> 00:01:16,910
لا أريد أن أكون وحيدة

16
00:01:18,930 --> 00:01:22,760
لن تتركني أبداً، صحيح يا زاين؟

17
00:01:30,290 --> 00:01:32,150
لأجلكِ

18
00:01:33,260 --> 00:01:34,880
سأفعل

19
00:03:14,420 --> 00:03:17,830
ما شعورك في هذا القناع سموّك؟

20
00:03:17,830 --> 00:03:20,880
يروقني، إنّه أخفّ من الأخير

21
00:03:21,250 --> 00:03:24,150
كان ثقيلاً جدّاً في المهرجان بحيث سقطت

22
00:03:25,760 --> 00:03:30,010
حتّى بهذا المقاس، لا مشكلة بلمسك للناس

23
00:03:30,010 --> 00:03:32,830
!أجل، لكنّكِ ظريفةٌ جدّاً

24
00:03:39,070 --> 00:03:41,580
علينا إيجاد سيرك الجوزاء سريعاً

25
00:03:43,490 --> 00:03:45,570
!لنسأل ذاك الفتى

26
00:03:45,850 --> 00:03:47,030
سيرك الجوزاء؟

27
00:03:47,410 --> 00:03:49,080
إنّه في عطلة اليوم

28
00:03:49,080 --> 00:03:51,030
لا بأس بذلك

29
00:03:51,030 --> 00:03:52,810
أتينا للقاء كاف وزاين

30
00:03:52,810 --> 00:03:53,930
ماذا؟

31
00:03:53,930 --> 00:03:58,990
!أتسعى لكاف أيضاً؟

32
00:03:58,990 --> 00:04:01,800
!عليك ألّا تقترب منّي

33
00:04:02,320 --> 00:04:05,510
!لا يمكنك تهديدي

34
00:04:05,510 --> 00:04:07,720
!كلّا! أنا ملعون

35
00:04:07,930 --> 00:04:11,820
ملعون؟ أتعاني خطباً ما؟

36
00:04:11,820 --> 00:04:13,050
أجل

37
00:04:13,050 --> 00:04:14,940
أتعرف كاف-سان؟

38
00:04:15,160 --> 00:04:18,430
!أجل، فأنا في سيرك الجوزاء بدوري

39
00:04:18,430 --> 00:04:19,900
!اسمي هيوغو

40
00:04:25,850 --> 00:04:30,530
قناعك ذاك... لست أخ زاين
أو ما شابه، صحيح؟

41
00:04:30,530 --> 00:04:32,350
لستُ كذلك

42
00:04:33,690 --> 00:04:35,750
كاف هناك الآن غالباً

43
00:04:52,210 --> 00:04:53,120
يا لجمالها

44
00:04:53,120 --> 00:04:53,730
صحيح؟

45
00:04:54,600 --> 00:04:57,410
أتيتما إذاً؟

46
00:04:57,410 --> 00:05:00,640
!مرحباً بكما لسيرك الجوزاء

47
00:05:00,640 --> 00:05:02,610
!بئساً! أفلتها

48
00:05:02,880 --> 00:05:05,240
!كدتُ أموت

49
00:05:07,890 --> 00:05:10,780
زاين-سان ليس موجوداً إذاً

50
00:05:10,780 --> 00:05:13,540
أجل، غادر للشراب البارحة ولم يرجع

51
00:05:13,540 --> 00:05:15,510
عندما يرجع، سيلقى توبيخاً شديد اللهجة

52
00:05:15,930 --> 00:05:18,570
كنت تتكلّم عن لعنة

53
00:05:18,570 --> 00:05:19,710
ما قصدت بالضبط؟

54
00:05:20,110 --> 00:05:21,130
...حسناً

55
00:05:22,420 --> 00:05:23,670
راقب بإمعان

56
00:05:26,460 --> 00:05:28,890
إنّها لعنة حقّاً وليست
حيلة سحريّة، صحيح؟

57
00:05:29,430 --> 00:05:31,500
أجل، أليس الأمر مخيفاً؟

58
00:05:31,500 --> 00:05:34,470
لمَ؟ لا أشعر بالخوف

59
00:05:34,810 --> 00:05:37,060
!حقّاً؟ ذلك رائع

60
00:05:37,060 --> 00:05:38,810
أنت مُبهر

61
00:05:40,330 --> 00:05:43,070
امتلاكك لشيء يميّزك عن الآخرين يجعلك فريداً

62
00:05:43,340 --> 00:05:45,730
عليك الانضمام لسيرك الجوزاء

63
00:05:47,550 --> 00:05:49,820
أيمكنك قتل الناس حقّاً؟

64
00:05:50,530 --> 00:05:52,680
أيمكنك مصافحتي؟

65
00:05:54,530 --> 00:05:56,840
!كاف، من هذا الرجل؟

66
00:05:56,840 --> 00:05:57,930
إنّه الرئيس

67
00:06:02,330 --> 00:06:06,520
،إذا لم تستطيعا المكوث هنا للأبد
فابقيا لثلاثة أيّام على الأقلّ

68
00:06:06,520 --> 00:06:07,630
...لا، لكن

69
00:06:08,040 --> 00:06:12,890
سنقدّم عرضاً خاصّاً في الساحة العامّة
الكبيرة بعد يومين

70
00:06:12,890 --> 00:06:16,100
وفي النهار كي يستطيع الأطفال الاستمتاع به

71
00:06:16,100 --> 00:06:19,070
الساحة العامّة؟ من المذهل أنّهم
أعطوكم الإذن لذلك

72
00:06:19,070 --> 00:06:20,720
أنا في طريقي لأخذ الإذن الآن

73
00:06:20,720 --> 00:06:21,810
!لم تأخذه بعد؟

74
00:06:22,290 --> 00:06:24,530
هكذا يكون الأمر دوماً، هذا هو الرئيس

75
00:06:25,330 --> 00:06:27,420
...سأنصرف الآن، لكن

76
00:06:28,600 --> 00:06:32,200
أنا متأكّد أنّك ستكتسب شعبيّة كبيرة

77
00:06:33,120 --> 00:06:35,410
شعبيّة بسبب لعنتي؟

78
00:06:36,130 --> 00:06:38,270
هل الرئيس مُتوهم؟

79
00:06:38,270 --> 00:06:40,620
التحمية ضروريّةٌ في السيرك

80
00:06:42,030 --> 00:06:44,570
أليس؟ هل ستفعلينها؟

81
00:06:45,370 --> 00:06:49,300
أجل، تفضّلوا بدعوتي، فأودّ التجربة

82
00:06:55,230 --> 00:06:58,170
هل ستنضمّ للسيرك سموّك؟

83
00:06:59,620 --> 00:07:01,900
!لا أعتقد أنّ بإمكاني فعلها

84
00:07:02,620 --> 00:07:05,860
إنّها فرصتك لتعلّم التواجد
حول الآخرين سموّك

85
00:07:07,240 --> 00:07:08,720
لمَ لا تجرّب؟

86
00:07:08,720 --> 00:07:11,240
ليس من المُنصف أن تستعملي
!ذاك الصوت المثير

87
00:07:12,820 --> 00:07:15,030
كفّ عن التذمّر وجرّب

88
00:07:15,030 --> 00:07:16,930
هاك، قم بالتلاعب

89
00:07:16,930 --> 00:07:20,290
سأجرّب، لكن لا أظنّني سأبرع أبداً

90
00:07:26,690 --> 00:07:28,080
هذا فنّي

91
00:07:29,620 --> 00:07:32,430
!سأعلّمك كلّ ما تحتاج لمعرفته، انتظر وحسب

92
00:07:32,430 --> 00:07:35,390
...لا أعتقد أنّ باستطاعتي فعلها

93
00:07:37,780 --> 00:07:41,400
تبدئين بالتلويح من هذا الارتفاع

94
00:07:41,400 --> 00:07:43,310
،لسنا مرتفعات كثيراً عن الأرض
لكن توخّي الحذر مع ذلك

95
00:07:44,010 --> 00:07:45,770
شكراً لك

96
00:07:46,010 --> 00:07:48,730
...تحديق

97
00:07:49,900 --> 00:07:51,300
لا بدّ أنّ الرائحة زكيّة

98
00:07:56,440 --> 00:07:58,830
!لا تشرد بذهنك

99
00:07:59,810 --> 00:08:02,830
متى بدأت بالعمل هنا يا هيوغو؟

100
00:08:05,790 --> 00:08:07,430
في الشهر الفائت

101
00:08:07,430 --> 00:08:08,890
الشهر الفائت؟

102
00:08:08,890 --> 00:08:13,590
ضمّتني كاف والرئيس عندما
كنت مجرّد نشّال

103
00:08:13,960 --> 00:08:15,760
بقيّة الأفراد في الفرقة مثلي

104
00:08:16,430 --> 00:08:18,730
أشخاص يملكون قوّة مُفرطة

105
00:08:18,730 --> 00:08:20,650
ومحتالون سابقون ولصوص

106
00:08:20,650 --> 00:08:22,200
أشخاص بشخصيّات متنوّعة

107
00:08:22,200 --> 00:08:24,980
الجميع هنا رُفضوا من المجتمع

108
00:08:24,980 --> 00:08:31,050
لكن يقول الرئيس أنّ من الرائع
امتلاكك لشيء يجعلك فريداً

109
00:08:32,460 --> 00:08:36,540
تغيّرنا بالقدوم هنا للسيرك

110
00:08:37,450 --> 00:08:39,510
!وجدنا شيئاً يعطي حياتنا معنى

111
00:08:39,820 --> 00:08:43,120
نودّ تعويض الناس بالمرح
عن كلّ ما تسبّبنا به سابقاً

112
00:08:43,420 --> 00:08:45,200
!ونرسم عليهم الابتسامات

113
00:08:50,010 --> 00:08:52,550
لنقم بها من جديد

114
00:08:52,550 --> 00:08:55,030
سأساعدك حتّى تتقن الأمر

115
00:08:55,030 --> 00:08:56,510
...شـ-شكراً لك

116
00:08:58,090 --> 00:09:01,220
أتيتُ هنا للكلام عن داليث

117
00:09:01,710 --> 00:09:05,300
لكنّ زاين ليس هنا، ربما
يمكنني فعل هذا لفترة

118
00:09:09,690 --> 00:09:11,620
!لا تشرد بذهنك

119
00:09:26,520 --> 00:09:30,420
...ليس أنّي أودّ تركها، لكن

120
00:09:45,920 --> 00:09:47,570
!حسناً، مرّة أخرى

121
00:09:47,570 --> 00:09:49,810
لا تزال تتمرّن؟

122
00:09:50,220 --> 00:09:51,170
أجل

123
00:09:51,170 --> 00:09:54,480
أنا جزءٌ من السيرك الآن، ولو مؤقتاً

124
00:09:55,260 --> 00:09:57,690
،إنّهم يحملون شغفاً كبيراً بالأمر

125
00:09:57,690 --> 00:09:59,700
فلن يصحّ ألّا أشارك بجدّية

126
00:10:00,260 --> 00:10:04,130
فأنا مثلهم، لا أستطيع عيش حياة طبيعيّة

127
00:10:06,090 --> 00:10:07,620
أم أنا ساذج؟

128
00:10:08,080 --> 00:10:10,080
هذه إحدى محاسنك

129
00:10:10,490 --> 00:10:11,450
حقّاً؟

130
00:10:11,450 --> 00:10:12,180
أجل

131
00:10:13,660 --> 00:10:16,300
!اسمعي، تحسّنت قليلاً في التلاعب

132
00:10:16,300 --> 00:10:17,260
!شاهدي

133
00:10:17,840 --> 00:10:20,390
سأجلس وأشاهدك

134
00:10:20,390 --> 00:10:23,970
يمكنني أن أكون أوّل حضورك

135
00:10:24,600 --> 00:10:26,930
لا تضحكي إن فشلت، حسناً؟

136
00:10:28,060 --> 00:10:32,860
!سيّداتي سادتي، مرحباً بكم لسيرك الجوزاء

137
00:10:58,620 --> 00:10:59,760
هكذا

138
00:11:03,850 --> 00:11:05,850
مرّة أخرى من فضلك

139
00:11:06,840 --> 00:11:08,350
أعيد ذلك؟

140
00:11:09,770 --> 00:11:12,600
!لا أمانع إن شربت، لكنّ هذا كثيرٌ جدّاً

141
00:11:12,600 --> 00:11:15,900
!يشعر المرء برغبة بالشرب أحياناً

142
00:11:16,310 --> 00:11:17,340
ماذا؟

143
00:11:17,340 --> 00:11:19,460
ربما أفرطتُ في الشرب

144
00:11:19,930 --> 00:11:23,650
...أتوهّم رؤية أليس-تشان

145
00:11:27,660 --> 00:11:30,620
أيمكنني لمسكِ والتأكد
ما إن كنتِ حقيقيّة؟

146
00:11:31,760 --> 00:11:36,040
ستوقظك لكمة... أو ربما لكمتان ستفتح عينيك

147
00:11:38,510 --> 00:11:40,790
!ضربتِني ثلاث مرّات

148
00:11:40,790 --> 00:11:42,510
!هذه أليس الحقيقيّة

149
00:11:44,650 --> 00:11:46,470
سموّ الأفخاذ موجودٌ أيضاً

150
00:11:46,470 --> 00:11:49,920
!لا-لا تنادني بذلك

151
00:12:11,610 --> 00:12:12,830
!داليث

152
00:12:13,180 --> 00:12:15,070
!أتيتُ للهو

153
00:12:15,510 --> 00:12:19,500
كيتو، هل رأيتِ وجهي؟

154
00:12:19,500 --> 00:12:20,970
!لم أره

155
00:12:20,970 --> 00:12:22,310
جيّد

156
00:12:22,310 --> 00:12:26,980
لكنّي لمحت ما بداخل ذلك

157
00:12:27,690 --> 00:12:29,610
حسناً إذاً

158
00:12:29,610 --> 00:12:30,770
أيمكنكِ إبقاء الأمر سرّاً؟

159
00:12:31,070 --> 00:12:32,120
!أجل

160
00:12:39,200 --> 00:12:42,700
امرأة بشريّة؟ أهي حيّة؟

161
00:12:42,700 --> 00:12:45,710
لا تتنفّس، لكنّ قلبها ينبض

162
00:12:45,710 --> 00:12:47,450
ظلّت نائمة لوقت طويل جدّاً

163
00:12:48,120 --> 00:12:52,910
أنا أحببتها كثيراً، وأريد مساعدتها

164
00:12:53,580 --> 00:12:56,880
في أحسن حال، أودّ إعادتها لحياتها السابقة

165
00:12:56,880 --> 00:12:58,380
كما لو لم يقع شيء

166
00:12:58,620 --> 00:13:01,480
تبدو مثل الفتاة التي أتت إلى السبت

167
00:13:01,480 --> 00:13:03,230
إنّها أمّها

168
00:13:03,780 --> 00:13:08,570
عندما رأيتُ أليس قبلاً، ظننتها قد تكون شارون في الواقع

169
00:13:09,610 --> 00:13:14,170
القدر والمصير... موجودان حقّاً

170
00:13:17,370 --> 00:13:20,740
بالمناسبة يا كيتو، ألديكِ مخطّطات للمستقبل القريب؟

171
00:13:20,740 --> 00:13:22,220
لا شيء

172
00:13:22,220 --> 00:13:26,610
ربما موعد مع حبيبتي تيتو؟

173
00:13:27,490 --> 00:13:32,330
،الجميع محظوظون بامتلاكهم لأحباب
لا أستطيع إيقاف طقطقة لساني

174
00:13:34,850 --> 00:13:40,420
،سأذهب لعالم البشر عمَّ قريب
أتودّين جلب تيتو ومرافقتي؟

175
00:13:40,420 --> 00:13:41,290
لا بأس

176
00:13:42,550 --> 00:13:44,580
تمتلك الفتيات العصريّات
الكثير من الطاقة

177
00:13:44,580 --> 00:13:46,670
ستشاهدين ذلك المهرجان من جديد؟

178
00:13:46,670 --> 00:13:49,790
كلّا، سأذهب لدافعٍ هذه المرّة

179
00:13:51,020 --> 00:13:53,140
سأعيد زاين معي

180
00:13:54,270 --> 00:13:57,890
إنّه الخائن الذي جلب بشريّاً
إلى السبت، أليس كذلك؟

181
00:13:57,890 --> 00:14:00,220
لا يهمّ ذلك

182
00:14:00,220 --> 00:14:01,900
كوني أكثر احتراماً

183
00:14:02,810 --> 00:14:05,800
سيكون ساحراً قويّاً يوماً ما

184
00:14:06,920 --> 00:14:10,950
وبسحر زاين، الأمر ممكن

185
00:14:14,480 --> 00:14:20,100
إنّه يحبّ النساء، إن جلبتكِ وتيتو
فسيسهل الكلام معه

186
00:14:20,100 --> 00:14:24,530
!لستُ جذّابة أبداً، لكن... فهمت

187
00:14:24,530 --> 00:14:27,050
!بصفتي تابعتك، سأرافقك

188
00:14:27,450 --> 00:14:28,160
تابعتي؟

189
00:14:28,160 --> 00:14:30,720
ربما إحدى "فتيات داليث"؟

190
00:14:30,720 --> 00:14:31,760
ذلك مسمّى سخيف

191
00:14:32,070 --> 00:14:34,310
!سأذهب لمناداة تيتو

192
00:14:34,310 --> 00:14:36,770
!علينا التجهّز سريعاً

193
00:14:38,650 --> 00:14:40,530
إنّها مثيرة للضوضاء دوماً

194
00:14:46,890 --> 00:14:53,040
،داليث، وجهكٍ يشبه وجهي تماماً
فمن الصعب التفريق بيننا

195
00:14:53,370 --> 00:14:55,990
أيمكنني تغيير ذلك؟

196
00:15:11,120 --> 00:15:12,430
!مُذهل

197
00:15:13,170 --> 00:15:16,390
!أتقنت التلاعب تماماً

198
00:15:17,460 --> 00:15:19,070
!كما بأربعة قطع

199
00:15:19,850 --> 00:15:21,860
اجتهدتَ حقّاً

200
00:15:21,860 --> 00:15:25,610
!خلتك مجرّد ضعيف، لكنّك لست كذلك

201
00:15:27,490 --> 00:15:29,030
ذلك مذهلٌ حقّاً

202
00:15:29,520 --> 00:15:32,530
لكن لمَ لم تقم بشيء يستعمل لعنتك؟

203
00:15:37,410 --> 00:15:40,540
لا أحد يأتي لأخذ طلبنا

204
00:15:42,550 --> 00:15:43,730
!لا أستطيع الانتظار أكثر

205
00:15:43,730 --> 00:15:44,330
سأذهب لهم

206
00:15:48,710 --> 00:15:50,550
إذاً، ما الذي أردت الكلام معي بشأنه؟

207
00:15:50,920 --> 00:15:55,280
حسناً، إنّه... بخصوص سحرك

208
00:15:55,710 --> 00:15:58,720
لا بأس، يمكنك إخبار أليس-تشان

209
00:15:59,590 --> 00:16:04,010
تسعى داليث وراء سحر التحكّم بالزمن خاصّتك

210
00:16:04,860 --> 00:16:08,550
فهمت، اكتشفت داليث الأمر إذاً؟

211
00:16:13,050 --> 00:16:14,090
...يا إلهي

212
00:16:14,090 --> 00:16:16,370
هذه القوّة مُزعجة حقّاً

213
00:16:18,950 --> 00:16:20,840
ربما حان وقت الذهاب

214
00:16:21,760 --> 00:16:22,600
زاين؟

215
00:16:23,240 --> 00:16:25,060
سأغادر هذه المدينة

216
00:16:26,320 --> 00:16:30,010
إن بقيتُ هنا، قد تستهدف كاف أو سيرك الجوزاء

217
00:16:30,350 --> 00:16:31,490
...لكن

218
00:16:31,980 --> 00:16:33,970
أأنت راضٍ بذلك حقّاً؟

219
00:16:35,930 --> 00:16:37,930
إنّه شيء كنت أفكّر به

220
00:16:38,850 --> 00:16:43,100
كاف ليست مثلي، يمكنها التصرّف
هنا كبشريّة بسهولة

221
00:16:43,660 --> 00:16:44,600
...لكن

222
00:16:45,160 --> 00:16:48,710
لا يمكنك ترك كاف

223
00:16:51,120 --> 00:16:53,040
رجعت

224
00:16:53,040 --> 00:16:55,140
لمَ هذه الملامح الجادّة؟

225
00:16:55,140 --> 00:16:55,990
!كنّا نتكلّم في أمور بذيئة

226
00:16:56,840 --> 00:16:59,890
!أنت محظوظ لانشغال يديّ

227
00:16:59,890 --> 00:17:03,510
لمَ تجلبين فطائر اللحم؟
هل حصلتِ على عملٍ هنا؟

228
00:17:03,510 --> 00:17:04,860
أنا أساعد وحسب

229
00:17:04,860 --> 00:17:06,230
ألستُ عظيمة؟

230
00:17:06,230 --> 00:17:07,210
بـ-بلى

231
00:17:08,840 --> 00:17:10,920
!وقت الأكل

232
00:17:14,760 --> 00:17:18,640
لن تتركني أبداً، صحيح يا زاين؟

233
00:17:24,570 --> 00:17:25,560
كاف

234
00:17:27,370 --> 00:17:28,840
...لأجلكِ

235
00:17:31,210 --> 00:17:32,600
سأفعل

236
00:17:35,990 --> 00:17:40,660
!والآن، نجم سيركنا الجديد

237
00:18:38,090 --> 00:18:44,060
يا إلهي... أعطيتك مكاني، فقف على المسرح
كما لو كنت تنتمي هناك على الأقلّ

238
00:18:44,890 --> 00:18:48,020
!دور أليس-تشان تالياً! يا لظرافتها

239
00:18:48,370 --> 00:18:49,930
يا سيّد

240
00:18:49,930 --> 00:18:51,730
أنت مع سيرك الجوزاء، صحيح؟

241
00:18:52,720 --> 00:18:53,690
!إنّهما يتقرّبان منّي

242
00:18:55,320 --> 00:18:57,400
!أحبّ فتيات الحفلات

243
00:18:58,000 --> 00:18:59,430
اسمي زاين

244
00:19:00,360 --> 00:19:02,600
!يمكنكما مناداتي بزاين-كن

245
00:19:02,600 --> 00:19:04,140
مضى وقتٌ طويل

246
00:19:04,690 --> 00:19:06,580
هل التقينا قبلاً؟

247
00:19:06,580 --> 00:19:07,890
...تيتو

248
00:19:07,890 --> 00:19:09,620
وكيتو

249
00:19:09,620 --> 00:19:12,040
!وداليث أيضاً

250
00:19:13,660 --> 00:19:15,750
آسف، لكن هلّا رحلتنّ؟

251
00:19:16,270 --> 00:19:18,090
أو دعيني ألمس أثداءك

252
00:19:18,090 --> 00:19:18,970
مُت

253
00:19:19,710 --> 00:19:22,430
لم أتوقّع منكِ القدوم إلى سيرك الجوزاء

254
00:19:24,850 --> 00:19:30,060
ارتجاف، ارتجاف، ارتجاف

255
00:19:26,090 --> 00:19:30,060
زاين، ارجع لعالم الساحرات معنا

256
00:19:30,370 --> 00:19:33,550
أحتاج لسحر الزمن خاصّتك

257
00:19:34,890 --> 00:19:36,110
...تبّاً

258
00:19:37,480 --> 00:19:39,960
!أنا أسقط في الجانب المُظلم

259
00:19:40,320 --> 00:19:44,010
داليث، أهو ساحرٌ مذهل حقّاً؟

260
00:19:44,010 --> 00:19:44,930
أجل

261
00:19:44,930 --> 00:19:48,410
لذا جلبتُ قوّة قتاليّة كافية لإسقاطه

262
00:19:49,290 --> 00:19:51,470
قوّة النباتات خاصّتي

263
00:19:52,620 --> 00:19:54,630
وسمّي

264
00:19:55,470 --> 00:19:58,550
ماذا إذاً؟ هل ستقمن بأذيّتي؟

265
00:20:00,280 --> 00:20:03,520
لن نفعل إن رافقتنا

266
00:20:03,520 --> 00:20:06,550
لن يتعيّن عليّ تهديد
كاف أيضاً بالطبع

267
00:20:08,440 --> 00:20:11,980
ستصبح ساحراً قويّاً يوماً ما

268
00:20:16,810 --> 00:20:22,350
إن أردت إيقاف الرعب، أجب بنعم أو لا

269
00:20:27,920 --> 00:20:29,330
لمَ انهارت؟

270
00:20:31,790 --> 00:20:33,970
يمكنني استعمال سحر الوهم بدوريّ

271
00:20:34,560 --> 00:20:38,540
كنت تعرف سحري واستعملت الأمر نفسه؟

272
00:20:39,130 --> 00:20:40,930
أنت عبقريٌّ بحقّ

273
00:20:42,000 --> 00:20:43,530
عبقريّ؟

274
00:20:46,020 --> 00:20:49,600
إجابتي على سؤالكِ هي نعم

275
00:20:51,410 --> 00:20:53,670
فقد كنتُ أفكّر بالأمر بالأصل

276
00:20:54,320 --> 00:20:56,380
سأترك كاف والفرقة بعد يومين

277
00:20:56,380 --> 00:20:57,230
يومين؟

278
00:20:57,600 --> 00:21:01,250
أجل، أعطني يوماً لتوديعهم

279
00:21:02,300 --> 00:21:03,180
فهمت

280
00:21:03,180 --> 00:21:04,920
يُسعدني ذلك يا زاين

281
00:21:04,920 --> 00:21:07,170
سنرجع بعد مضيّ يومين لأخذك إذاً

282
00:21:07,170 --> 00:21:08,750
!مع السلامة

283
00:21:23,850 --> 00:21:24,740
...كاف

284
00:21:26,590 --> 00:21:28,590
!فاتتني رؤية أليس-تشان

285
00:23:03,370 --> 00:23:04,830
أشعر بالخيبة

286
00:23:05,630 --> 00:23:08,880
كذب عليّ ولا نيّة له بالقدوم

287
00:23:11,850 --> 00:23:14,810
،إذا لم ترد استعمال سحرك لذاك الحدّ

288
00:23:14,810 --> 00:23:17,510
فعليّ إرغامك على ذلك وحسب

289
00:23:20,110 --> 00:23:21,920
أتحرّق شوقاً للغد

290
00:23:35,710 --> 00:23:39,460
كاف وزاين والاعتراف