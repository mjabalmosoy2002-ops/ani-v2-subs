1
00:00:01,290 --> 00:00:08,310
أيمكنك تصوّر حياة حيث لا تستطيع
لمس الشخص الذي تحبّه؟

2
00:00:09,100 --> 00:00:14,150
تسبّبت اللعنة التي أُلقيت عليه من قِبل
الساحرة بسلبه لحيوات أيّ من يمسّهم

3
00:00:14,840 --> 00:00:19,080
نأت أمه بنفسها عنه، ونعته أصدقاؤه بالوحش

4
00:00:19,080 --> 00:00:20,460
حتّى الأشخاص الذين لم يقابلهم قطّ

5
00:00:20,460 --> 00:00:23,490
"تكلّموا عنه بصفته "تجسّد الموت الذي يقطن الغابة

6
00:00:24,370 --> 00:00:29,180
لكنّه... لا يشعر بأية وحدة

7
00:00:32,180 --> 00:00:36,970
أنا أحبّ الأثداء، من كلّ الأصناف

8
00:00:36,970 --> 00:00:39,140
لكن ما الذي يستهويك في الأفخاذ؟

9
00:00:41,220 --> 00:00:42,900
ما يهمّك؟

10
00:00:42,900 --> 00:00:45,600
ومن الفظاظة للنساء أن نناقش أشياءً كهذه

11
00:00:45,930 --> 00:00:48,060
...لـ-لكن إن أصررت

12
00:00:48,060 --> 00:00:53,130
إذا لقي العالم نهايته، فأودّ أن تحين
منيتي ورأسي على فخذ أليس

13
00:00:54,000 --> 00:00:56,060
ذلك بافتراض إبطال اللعنة بالطبع

14
00:00:56,060 --> 00:00:58,290
ما أكثر ما يستهويك في الفتيات يا روب-سان؟

15
00:00:58,290 --> 00:01:00,320
...حسناً

16
00:01:00,320 --> 00:01:02,950
أحبّ ابتساماتهنّ

17
00:01:03,610 --> 00:01:05,020
هذا ليس مُنصفاً

18
00:01:05,020 --> 00:01:06,440
ليس منُصفاً يا روب

19
00:02:42,620 --> 00:02:45,430
من السهل رؤية الصور عندما
يكون الكتاب بهذا الحجم

20
00:02:50,110 --> 00:02:52,970
لا يوجد أحد في الجوار، فلا بأس، صحيح؟

21
00:02:55,510 --> 00:02:56,330
ساحرة؟

22
00:02:56,330 --> 00:02:57,690
!كلّا، أليس

23
00:02:58,210 --> 00:02:59,600
لمَ تدخلين من النافذة؟

24
00:02:59,600 --> 00:03:00,910
!هذا الطابق الثالث

25
00:03:00,910 --> 00:03:04,220
سموّك، كنت تنظر لشيء بذيء، أليس كذلك؟

26
00:03:04,220 --> 00:03:05,690
لا-لا أعلم ما الذي تتكلّمين عنه

27
00:03:05,690 --> 00:03:08,120
من الجلّي لي ما كنت تفعله سموّك

28
00:03:08,910 --> 00:03:11,400
أعتذر على إفزاعك

29
00:03:11,400 --> 00:03:15,090
كلّ ما تفعلينه يسبّب
بتسارع نبضات قلبي

30
00:03:15,470 --> 00:03:18,870
أردتُ رؤية وجهك الظريف

31
00:03:19,290 --> 00:03:21,550
إذاً، كيف صعدتِ إلى نافذة الطابق الثالث؟

32
00:03:22,030 --> 00:03:23,500
!مفاجأة

33
00:03:23,500 --> 00:03:25,260
استعملتُ مكنسة طائرة

34
00:03:25,560 --> 00:03:28,220
لا تبدو سوى مكنسةً عاديّة لي

35
00:03:29,240 --> 00:03:31,530
أعطتني إيّاها كيتو

36
00:03:32,410 --> 00:03:33,810
انظر

37
00:03:35,700 --> 00:03:36,570
!إنّها تطفو

38
00:03:36,800 --> 00:03:40,580
يتطلّب الأمر فهماً، لكن بعدما تعتاد عليها، تصبح مسليّة

39
00:03:41,610 --> 00:03:42,570
ذلك رائع

40
00:03:42,570 --> 00:03:44,160
أريد أن أجرّب أيضاً

41
00:03:44,160 --> 00:03:45,240
تفضّل

42
00:03:45,240 --> 00:03:46,610
تريدين أن أصعد معكِ؟

43
00:03:51,820 --> 00:03:52,720
!إنّها تطير

44
00:03:52,720 --> 00:03:54,530
لنخرج للرواق

45
00:04:03,830 --> 00:04:06,370
رائحة شعر أليس زكيّة جدّاً

46
00:04:08,720 --> 00:04:10,030
مرحباً يا روب

47
00:04:10,810 --> 00:04:12,810
!مكنسة لشخصين! يا للشاعريّة

48
00:04:12,810 --> 00:04:13,440
ذلك ما شدّ انتباهك؟

49
00:04:13,910 --> 00:04:15,150
أنتما تطيران؟

50
00:04:15,530 --> 00:04:17,210
!تأخّرت في الملاحظة

51
00:04:17,870 --> 00:04:19,470
!رافقتكما السلامة

52
00:04:20,230 --> 00:04:21,720
!مكنسة لشخصين

53
00:04:21,720 --> 00:04:23,550
لذلك وقعٌ جميل

54
00:04:23,550 --> 00:04:25,070
سأنعطف يميناً

55
00:04:26,310 --> 00:04:27,690
سأتسارع

56
00:04:29,380 --> 00:04:31,500
!السحر مُذهل

57
00:04:31,500 --> 00:04:32,160
أجل

58
00:04:32,160 --> 00:04:33,750
إنّه مسلٍّ إن أتقنت استعماله

59
00:04:34,460 --> 00:04:36,460
كانت أختي عبقريّة في السحر

60
00:04:39,460 --> 00:04:41,530
لكن ماتت شادي

61
00:04:41,900 --> 00:04:43,920
وحتّى داليث تجهل السبب

62
00:04:44,770 --> 00:04:48,040
لو كانت حيّة، لربما أبطلت لعنتي

63
00:04:48,040 --> 00:04:49,560
ربما استطعنا التفاهم بالكلام

64
00:04:49,560 --> 00:04:52,680
لكن لمَ لعنتني وشارون-شان؟

65
00:04:53,270 --> 00:04:56,300
أهنالك خطبٌ ما سموّك؟

66
00:04:56,300 --> 00:05:01,920
ا-استرجعت رؤيتكِ لي وأنا أنظر
لصور بذيئة، وشعرت بالإحراج

67
00:05:01,920 --> 00:05:03,110
ذلك كلّ شيء؟

68
00:05:03,470 --> 00:05:06,820
إن كنت تريد، سأريك أشياء بذيئة متى أردت

69
00:05:08,600 --> 00:05:09,910
يا إلهي

70
00:05:11,340 --> 00:05:14,220
من غير المألوف أن تأتيا هنا سويّاً

71
00:05:14,220 --> 00:05:16,650
وجلبتما معكما أمتعة كثيرة أيضاً

72
00:05:16,650 --> 00:05:18,960
أفُصلتما من السيرك؟

73
00:05:18,960 --> 00:05:20,840
كلّا، أوامر الرئيس

74
00:05:21,430 --> 00:05:23,490
دعنا نعش هنا لفترة

75
00:05:24,420 --> 00:05:29,040
أتى غرباء يبحثون عنّي في السيرك

76
00:05:29,530 --> 00:05:32,780
طفل وامرأة مُسنّة وفقما يبدو

77
00:05:32,780 --> 00:05:37,800
يقول هوغو أنّهما أوسعا مجموعة
من مشاغبي البلدة ضرباً في لحظات

78
00:05:37,800 --> 00:05:39,250
من يكونان بالضبط؟

79
00:05:39,250 --> 00:05:40,370
لا أدري

80
00:05:40,370 --> 00:05:43,650
ربما أشخاص يريدون منّي استعمال
سحر التلاعب بالزمن

81
00:05:44,160 --> 00:05:47,610
،بالنظر لما كانت تفعله داليث
فليسا ساحرات على الأرجح

82
00:05:48,200 --> 00:05:51,580
بأيّ حال، حصلتُ على إجازة لفترة

83
00:05:51,580 --> 00:05:53,430
لذا دعوني أستمتع بها رجاءً

84
00:05:53,430 --> 00:05:55,150
أنحن نضايقكم؟

85
00:05:55,150 --> 00:05:56,050
البتّة

86
00:05:56,050 --> 00:05:57,390
!تسرّنا استضافتكما

87
00:05:57,390 --> 00:05:58,640
!مرحى

88
00:05:58,640 --> 00:06:00,320
!سيتسنّى لي المبيت مع أليس-تشان

89
00:06:00,320 --> 00:06:02,130
!يا للحماس

90
00:06:03,210 --> 00:06:05,090
!يمكننا الشجار بالوسادات الليلة

91
00:06:05,090 --> 00:06:08,050
بدا أنّكِ فعلتِ للتوّ

92
00:06:08,050 --> 00:06:10,060
!الفائز أكثر من يستمتع

93
00:06:10,060 --> 00:06:12,100
!فزتِ سلفاً إذاً

94
00:06:12,100 --> 00:06:14,390
!لنقم بلعبة حجر-ورقة-مقص بالتعرّي أو لعبة الملك

95
00:06:14,390 --> 00:06:16,100
!أدماغك من الفولاذ؟

96
00:06:16,100 --> 00:06:18,710
تروقني فكرة شجار الوسادات

97
00:06:18,710 --> 00:06:20,600
!فكّر بظهرك يا روب

98
00:06:21,290 --> 00:06:23,220
من المسلّي تواجدهما

99
00:06:23,220 --> 00:06:24,570
أليس كذلك يا أليس؟

100
00:06:24,570 --> 00:06:26,230
!كنتُ أفكّر بالأمر نفسه

101
00:06:26,230 --> 00:06:27,490
نبيل منحرف

102
00:06:27,960 --> 00:06:32,000
بما أنّكما ضيفان، يمكنكما الاسترخاء

103
00:06:32,000 --> 00:06:32,990
!كلّا

104
00:06:33,800 --> 00:06:36,440
!ستدعنا نقيم هنا، لذا سنعمل

105
00:06:36,440 --> 00:06:38,460
!يا للفتاة الصالحة

106
00:06:39,050 --> 00:06:40,070
!هيّا بنا يا أليس

107
00:06:40,070 --> 00:06:42,390
يمكنني فعل أيّ شيء عدا
!التنظيف والطهو والغسيل

108
00:06:42,760 --> 00:06:43,960
حسناً

109
00:06:44,390 --> 00:06:47,190
لديّ زيّ خادمة سيلائمكِ

110
00:06:47,190 --> 00:06:48,650
هل ستجرّبين ارتدائه؟

111
00:06:48,650 --> 00:06:49,720
!من فضلك

112
00:06:49,720 --> 00:06:51,110
!أنا أيضاً إذاً

113
00:06:51,110 --> 00:06:53,300
!لا تحاول الدخول بينهما

114
00:06:54,260 --> 00:06:56,080
لديهما أمور كثيرة لمناقشتها

115
00:06:56,080 --> 00:06:58,770
مثل حادثة السبت وأمر داليث

116
00:06:59,310 --> 00:07:01,170
لأيّ حدّ وصلت مع أليس-تشان؟

117
00:07:01,170 --> 00:07:02,520
!قلتُ كلاماً عن السبت

118
00:07:04,270 --> 00:07:05,550
ما رأيكِ؟

119
00:07:05,550 --> 00:07:08,110
!هذا قويّ! أنا منيعة الآن

120
00:07:09,080 --> 00:07:10,950
!يا لظرافتكِ

121
00:07:12,660 --> 00:07:14,940
!حسناً، وقت العمل

122
00:07:14,940 --> 00:07:17,620
!سأبدأ بتدفئة القصر بأسره

123
00:07:17,960 --> 00:07:20,080
!ها أنا ذي

124
00:07:22,160 --> 00:07:24,100
يبدو أنّ هذا هو المكان

125
00:07:24,100 --> 00:07:24,910
أجل

126
00:07:24,910 --> 00:07:25,790
توجد ساحرة هنا

127
00:07:26,470 --> 00:07:28,760
حسناً، سأرجع هذا لك

128
00:07:29,290 --> 00:07:30,760
السجّل من منزل العائلة

129
00:07:30,760 --> 00:07:31,550
شكراً لك

130
00:07:31,550 --> 00:07:33,020
استطعت استعادته حقّاً

131
00:07:33,020 --> 00:07:34,410
سحرك مُذهل

132
00:07:34,410 --> 00:07:35,970
وفيتُ بوعدي، أليس كذلك؟

133
00:07:36,460 --> 00:07:38,900
رغم أنّي نسيت أمره حتّى ذكّرتني داليث

134
00:07:39,320 --> 00:07:43,250
يوجد شيءٌ أرادت داليث إخفاءه في ثناياه

135
00:07:43,250 --> 00:07:46,140
أجل، إنّه يخصّ شادي

136
00:07:46,740 --> 00:07:50,440
آمل أن يكون تلميحاً لإبطال لعنتي ولعنة شارون-سان

137
00:07:50,720 --> 00:07:55,340
بالمناسبة، هل أمّ أليس-تشان النائمة جميلة؟

138
00:07:55,960 --> 00:07:56,800
لن أخبرك

139
00:07:56,800 --> 00:07:57,970
لمَ؟

140
00:07:57,970 --> 00:08:00,050
تروقني النساء الأكبر سنّاً أيضاً

141
00:08:00,050 --> 00:08:01,760
!لذا لن أخبرك

142
00:08:02,410 --> 00:08:03,540
ها هو

143
00:08:03,540 --> 00:08:04,500
ماذا وجدت؟

144
00:08:04,950 --> 00:08:07,780
تلقّى السيّد زيارة اليوم من
الراهبتين، شادي وداليث

145
00:08:07,780 --> 00:08:10,370
لم يحصل هذا منذ فترة

146
00:08:10,370 --> 00:08:11,800
هذا كلّ شيء؟

147
00:08:11,800 --> 00:08:14,970
لا تستطيع كاف القراءة، لكنّك تجيدها، صحيح؟

148
00:08:14,970 --> 00:08:16,180
ربما ذلك

149
00:08:16,180 --> 00:08:18,190
أنت ذكيّ بالنسبة لساحرة

150
00:08:18,800 --> 00:08:20,300
!لا، لم أكن أنا من قال ذلك

151
00:08:20,300 --> 00:08:21,280
هنا

152
00:08:22,330 --> 00:08:25,190
مرحباً، أنت تجسّد الموت، صحيح؟

153
00:08:28,320 --> 00:08:30,810
أعتذر على مقاطعة تنظيفكما

154
00:08:32,400 --> 00:08:35,800
لكن يكون المسح أسهل عليكما
إن كان المكان مبلّلاً، صحيح؟

155
00:08:35,800 --> 00:08:37,370
من أنت؟

156
00:08:40,660 --> 00:08:43,480
ساحر الزمن معك أيضاً إذاً؟

157
00:08:43,480 --> 00:08:46,070
أصبنا بتجربة السيرك

158
00:08:46,070 --> 00:08:47,600
نجح الأمر كما تصوّرته

159
00:08:47,600 --> 00:08:48,450
ماذا؟

160
00:08:48,450 --> 00:08:50,300
..سأبدأ بالاختبار

161
00:08:50,970 --> 00:08:53,300
!كلّا! ستموت إن لمستني

162
00:08:55,770 --> 00:08:57,760
حتّى تجسّد الموت لا يمكنه فعلها

163
00:08:57,760 --> 00:09:00,990
لـ-لمَ؟ أنا على يقين أنّك لمستني

164
00:09:00,990 --> 00:09:04,100
أستشعر سحراً منه

165
00:09:05,080 --> 00:09:06,560
!لكنّكِ لستِ ساحرة

166
00:09:09,620 --> 00:09:12,480
حاذري من الانزلاق يا عمّة

167
00:09:12,780 --> 00:09:14,950
إنّها لطيفة حتّى في أوقات كهذه

168
00:09:15,860 --> 00:09:17,260
من أنتِ؟

169
00:09:17,260 --> 00:09:18,330
لمَ أتيتِ هنا؟

170
00:09:18,330 --> 00:09:20,660
لا تغلقين فمكِ أبداً

171
00:09:25,740 --> 00:09:28,340
لا أستطيع... الحركة

172
00:09:29,130 --> 00:09:31,770
لا بدّ أنّك مشعوذ إذاً

173
00:09:31,770 --> 00:09:32,840
مشعوذ؟

174
00:09:33,130 --> 00:09:37,300
أجل، بشر مولودون بالسحر

175
00:09:37,300 --> 00:09:39,090
...هذا الفتى غالباً

176
00:09:39,090 --> 00:09:43,020
فتى؟ أنا أكبر سنّاً منك

177
00:09:47,270 --> 00:09:49,730
!أأنت بخير يا نبيل الأفخاذ؟

178
00:09:49,730 --> 00:09:52,190
!لا تنادني بذلك

179
00:09:55,830 --> 00:09:59,170
تفوح منكِ رائحتهنّ حقّاً، رائحة الساحرات

180
00:10:00,370 --> 00:10:01,730
أنصتي لي

181
00:10:01,730 --> 00:10:03,330
اسمي إيتشي

182
00:10:03,630 --> 00:10:06,040
!افعل شيئاً يا زاين

183
00:10:06,270 --> 00:10:08,500
!لا أستطيع القيام بشيء

184
00:10:12,880 --> 00:10:14,670
أعتذر على الخشونة

185
00:10:14,910 --> 00:10:16,690
اسمي نيكو

186
00:10:16,690 --> 00:10:20,390
أنا مشعوذ، بشريّ مولود بالسحر كما قلت

187
00:10:20,760 --> 00:10:22,640
وما الذي تريده؟

188
00:10:22,640 --> 00:10:24,540
لا تستأ هكذا

189
00:10:24,540 --> 00:10:28,100
أريد مساعدتكم في شأن لي

190
00:10:28,360 --> 00:10:31,150
!مساعدتنا؟ مستحيل

191
00:10:31,150 --> 00:10:33,820
!كيف أثق بشخص يظهر فجأة ويهاجمنا هكذا؟

192
00:10:33,820 --> 00:10:34,820
!انتظر

193
00:10:35,480 --> 00:10:36,860
لنستمع إليه

194
00:10:36,860 --> 00:10:40,780
فقد بقى سليماً بعد لسمه لي

195
00:10:42,030 --> 00:10:44,030
يسرّني أنّك تفهم

196
00:10:49,390 --> 00:10:52,520
تقول أنّك تعاني لعنة الخلود؟

197
00:10:52,520 --> 00:10:54,500
أجل، أثبتّ ذلك لك، صحيح؟

198
00:10:55,020 --> 00:10:58,720
سمعت أنّك تقتل أيّ ما تلمسه، فجرّبت الأمر

199
00:10:59,220 --> 00:11:01,770
لكن يبدو أنّ لعنتي أقوى

200
00:11:02,520 --> 00:11:04,430
هل لعنتك شادي أيضاً؟

201
00:11:04,790 --> 00:11:05,620
أجل

202
00:11:05,620 --> 00:11:07,290
...لكنّي لا أستطيع إبطالها

203
00:11:07,290 --> 00:11:09,140
مع أنّي قتلتها

204
00:11:09,450 --> 00:11:10,850
قتلت شادي؟

205
00:11:10,850 --> 00:11:12,980
!يا لهذا المُتبجّح الفاشل

206
00:11:12,980 --> 00:11:16,140
"!لعنتي أقوى!"، "قتلتُ شادي"

207
00:11:16,140 --> 00:11:17,610
!أنا أقول الحقيقة

208
00:11:17,610 --> 00:11:20,070
احترم من يكبرونك سنّاً

209
00:11:20,960 --> 00:11:22,440
وجهكِ قريبٌ جدّاً

210
00:11:22,440 --> 00:11:24,640
لا آبه ما إن كنتِ مشعوذة أم لا

211
00:11:24,640 --> 00:11:26,450
سأحمي أليس

212
00:11:26,450 --> 00:11:27,450
!تعالي إليّ

213
00:11:29,020 --> 00:11:30,210
في الماضي البعيد

214
00:11:30,870 --> 00:11:35,670
عشنا نحن قرابة الخمسين مشعوذاً
بهدوء في قرية صغيرة

215
00:11:37,350 --> 00:11:41,130
حافظنا على مسافة بيننا وبين
الساحرات والبشر العاديّين

216
00:11:41,830 --> 00:11:45,850
،لكن عندما أصبحتُ مسنّاً
ظهرت شادي أمامي فجأة

217
00:11:46,660 --> 00:11:51,260
قالت أنّ لا حقّ للبشر باستعمال السحر

218
00:11:51,260 --> 00:11:55,620
وحوّلتني إلى طفل، وألقت عليّ لعنة الخلود هذه

219
00:11:56,140 --> 00:11:59,850
قرّرنا مراقبتها

220
00:12:00,550 --> 00:12:03,320
وكلّما فعلنا، كلّما بدت أكثر خطورة

221
00:12:04,820 --> 00:12:08,790
أخبرني رفاقي كيف لُعِنت في صغرك

222
00:12:09,380 --> 00:12:12,750
كان لا بدّ من فعل شيء حيال شادي

223
00:12:15,280 --> 00:12:17,880
فتحضّرنا بأقصى ما يمكننا

224
00:12:18,550 --> 00:12:20,870
وذهبنا للقضاء عليها

225
00:12:21,770 --> 00:12:23,720
كانت شادي قويّة

226
00:12:24,480 --> 00:12:26,640
لم يفدنا أيّ من تحضيراتنا

227
00:12:26,640 --> 00:12:28,940
ومهما فعلنا، بدت حركاتنا مكشوفة لها سلفاً

228
00:12:28,940 --> 00:12:31,190
استعملت تعويذات قويّة
الواحدة تلو الأخرى

229
00:12:35,080 --> 00:12:37,130
...وفي النهاية

230
00:12:39,130 --> 00:12:41,050
ربحنا بمحض الأفضليّة العدديّة

231
00:12:41,870 --> 00:12:44,900
،فقد العشرات من رفاقي أرواحهم

232
00:12:44,900 --> 00:12:46,820
لكنّنا هزمناها

233
00:12:49,510 --> 00:12:53,490
للسخرية، ما أبقاني على قيد الحياة كان لعنتها

234
00:12:55,250 --> 00:12:56,510
حقّاً؟

235
00:12:56,510 --> 00:12:57,270
أجل

236
00:12:57,270 --> 00:13:00,020
كان السبيل الوحيد لإيقافها

237
00:13:00,680 --> 00:13:01,540
لا بأس

238
00:13:01,540 --> 00:13:04,970
إذاً، بمَ تريد مساعدتنا؟

239
00:13:04,970 --> 00:13:10,760
أريد استعمال سحر تلاعبك بالزمن
...للعودة قبل إصابتي باللعنة

240
00:13:11,670 --> 00:13:14,190
وقتل شادي من جديد

241
00:13:16,170 --> 00:13:25,600
قتلها؟

242
00:13:29,430 --> 00:13:34,080
السبيل الوحيد للتيقّن من إبطال اللعنة
هو قتلها قبل إلقائها لها

243
00:13:34,720 --> 00:13:37,740
جمعتُ رفاقي، ونحن جاهزون

244
00:13:37,740 --> 00:13:38,570
ما قولك؟

245
00:13:38,570 --> 00:13:40,460
إنّها خطّة أنانيّة حقّاً

246
00:13:40,460 --> 00:13:42,300
فلا يمكنكم فعلها دون سحري، أليس كذلك؟

247
00:13:43,100 --> 00:13:45,590
لذا أتينا لإيجادك

248
00:13:45,590 --> 00:13:48,170
يمكننا إبطال لعنته كما لعنتي

249
00:13:48,170 --> 00:13:49,760
كضرب عصفورين بحجر واحد، أليس كذلك؟

250
00:13:49,760 --> 00:13:51,450
لا تمازحني

251
00:13:51,450 --> 00:13:54,020
لا يهمّني سوى إبطال لعنة صديقي

252
00:13:54,420 --> 00:13:56,620
لا سبب يدفعني لمساعدتك

253
00:13:59,090 --> 00:14:00,890
شادي قويّة

254
00:14:00,890 --> 00:14:04,570
من ناحية موضوعيّة، فيستحيل عليكم قتلها بمفردكم

255
00:14:07,570 --> 00:14:10,290
أجريتُ بحثي

256
00:14:10,290 --> 00:14:14,110
زاين، أنت تتحلّى بالموهبة لكنّك
لا تجيد كيفيّة استعمالها

257
00:14:14,110 --> 00:14:15,740
لا يمكنك إخراج كافّة قدراتك

258
00:14:15,740 --> 00:14:16,870
ماذا؟

259
00:14:16,870 --> 00:14:18,550
تعرف ذلك أيضاً، صحيح؟

260
00:14:18,550 --> 00:14:20,580
هنالك إهدارٌ كبير في سحرك

261
00:14:21,090 --> 00:14:23,440
أنت تعوّض عنه بقوّتك الهائلة وحسب

262
00:14:24,000 --> 00:14:28,670
وتحتاج لتركيز كبير لاستعمال سحر
تلاعبك بالزمن أيضاً

263
00:14:29,930 --> 00:14:35,020
لكن إن درست في مدرسة شعوذتنا، فستتحسّن

264
00:14:35,370 --> 00:14:36,750
مدرسة شعوذة؟

265
00:14:36,750 --> 00:14:37,490
أجل

266
00:14:37,490 --> 00:14:38,730
مرحّب بك أيضاً بالطبع

267
00:14:39,130 --> 00:14:41,850
يمكنك تعلّم كيفيّة استعمال
سلاح سحريّ على الأقلّ

268
00:14:42,440 --> 00:14:43,910
!لا تمازحني

269
00:14:43,910 --> 00:14:46,650
!لا يستطيع ساحر تعلّم السحر من بشر

270
00:14:46,650 --> 00:14:49,200
!لن أتعاون معك أبداً

271
00:14:49,440 --> 00:14:51,910
إنّها مدرسة مُختلطة

272
00:14:52,320 --> 00:14:53,760
جلبتُ فتاة معي أيضاً

273
00:14:53,760 --> 00:14:54,800
أتودّ أن أعرّفك بها؟

274
00:14:54,800 --> 00:14:55,660
!حقّاً؟

275
00:14:56,850 --> 00:14:58,280
لمَ؟

276
00:14:58,280 --> 00:15:00,870
لمَ أنا ضعيفة أمام سحركِ؟

277
00:15:00,870 --> 00:15:02,790
يا لغبائكِ

278
00:15:02,790 --> 00:15:05,850
ذلك لأنّك الماء يغلب النار

279
00:15:05,850 --> 00:15:06,740
!أرفض قبول هذا

280
00:15:06,740 --> 00:15:07,590
!من جديد

281
00:15:07,590 --> 00:15:10,450
كاف-سان، عليكِ ألّا تجبري نفسكِ على القتال

282
00:15:10,450 --> 00:15:11,610
أنا آسفة يا أليس

283
00:15:11,610 --> 00:15:13,440
هذا بسبب ضعفي

284
00:15:13,440 --> 00:15:16,350
لا أستطيع حماية أحد هكذا

285
00:15:17,370 --> 00:15:21,210
تماديت باستعمال قوّتي، أردتُ اختبار قوّتكِ وحسب

286
00:15:21,210 --> 00:15:23,440
أعتذر على افتعال شجار

287
00:15:25,620 --> 00:15:28,360
أتريدين أن تصبحي أقوى؟

288
00:15:28,760 --> 00:15:29,570
أجل

289
00:15:32,730 --> 00:15:34,300
تعالي إلى مدرستنا

290
00:15:34,300 --> 00:15:35,650
وسأحرص على أن تصبحي كذلك

291
00:15:35,650 --> 00:15:36,730
مدرسة؟

292
00:15:36,730 --> 00:15:37,490
!إيتشي

293
00:15:38,330 --> 00:15:40,370
ماذا؟ أين الفتاة؟

294
00:15:40,970 --> 00:15:43,930
!يا للمنظر البذيء

295
00:15:46,060 --> 00:15:48,130
آسف، كنت أمزح

296
00:15:50,030 --> 00:15:51,090
سأعرّفك عليها

297
00:15:51,660 --> 00:15:54,430
هذه إيتشي، حبيبتي

298
00:15:58,350 --> 00:16:00,150
!خدعتني

299
00:16:00,150 --> 00:16:02,620
!هذه ليست فتاة

300
00:16:02,620 --> 00:16:04,310
!إنّها جميلة

301
00:16:04,560 --> 00:16:05,830
!لا تتحامق معي

302
00:16:05,830 --> 00:16:08,110
!أردتُ رؤية فتاة

303
00:16:08,110 --> 00:16:09,030
!بنت

304
00:16:09,030 --> 00:16:10,030
!آنسة

305
00:16:10,030 --> 00:16:13,240
!كلّ امرأة هي فتاة في قلبها أيّها الأحمق

306
00:16:13,720 --> 00:16:15,640
أأنتما بخير؟

307
00:16:15,640 --> 00:16:17,450
تبلّلنا بالماء لا أكثر

308
00:16:17,450 --> 00:16:19,410
سيجفّ سريعاً

309
00:16:20,410 --> 00:16:22,250
!سحقاً

310
00:16:22,250 --> 00:16:25,280
!كذبت عليّ عن وجود فتاة

311
00:16:25,280 --> 00:16:28,500
!كما عاملتِ عزيزتي كاف بقسوة

312
00:16:28,500 --> 00:16:30,880
لم أعاملها بقسوة

313
00:16:30,880 --> 00:16:32,250
زاين، لا بأس

314
00:16:32,250 --> 00:16:33,860
استمع إليّ

315
00:16:33,860 --> 00:16:35,420
لستُ أكذب

316
00:16:35,420 --> 00:16:38,100
توجد تلميذات في مدرستنا

317
00:16:38,100 --> 00:16:40,140
وكلّهنّ مسنّات، أليس كذلك؟

318
00:16:40,140 --> 00:16:42,310
!زاين، استمع إليّ وحسب

319
00:16:43,090 --> 00:16:44,600
!لا شجار

320
00:16:45,600 --> 00:16:47,770
سنرحل الآن

321
00:16:49,790 --> 00:16:52,800
أنا على يقين بأنّكم ستأتون لمدرسة الشعوذة

322
00:16:53,960 --> 00:16:57,550
،لم أقل أنّي سآتي هنا
أتساءل إن كان فلي غاضب

323
00:17:03,370 --> 00:17:06,500
!يسرّني اختيارك الاعتماد عليّ، أنا فري

324
00:17:06,500 --> 00:17:08,460
!أخي نيكو، أختي إيتشي

325
00:17:08,460 --> 00:17:10,490
!غريب أطوار آخر

326
00:17:10,490 --> 00:17:12,670
يبدو أنّه كان في عجلة أيضاً

327
00:17:13,650 --> 00:17:15,840
!أخي نيكو، حضّرت عربة

328
00:17:16,500 --> 00:17:17,530
!اصعدا رجاءً

329
00:17:22,010 --> 00:17:23,680
!تحوّل

330
00:17:24,490 --> 00:17:26,710
أعرف معاناة أن تكون
تحت وطأة لعنة

331
00:17:26,710 --> 00:17:29,660
لنهزم شادي ونحصل على حرّيتنا

332
00:17:31,100 --> 00:17:32,630
سأراك في المدرسة

333
00:17:32,630 --> 00:17:34,070
ادعِ فتاة تحبّها

334
00:17:35,080 --> 00:17:36,280
!انتظر

335
00:17:36,570 --> 00:17:38,180
!أريد الكلام معك

336
00:17:38,780 --> 00:17:39,870
!سموّك

337
00:17:50,200 --> 00:17:51,960
ماذا؟ لا تزال تريد الكلام؟

338
00:17:51,960 --> 00:17:55,920
!أريد سؤالك عن ضرورة قتلنا لشادي

339
00:17:55,920 --> 00:17:57,160
بالطبع

340
00:17:57,160 --> 00:17:58,640
فهي خطرة جدّاً

341
00:17:58,890 --> 00:18:01,000
تكبّدت العناء لهذا السؤال فحسب؟

342
00:18:01,000 --> 00:18:02,600
أغلق الباب، أشعر بالبرد

343
00:18:03,050 --> 00:18:06,930
إن كان بوسعنا العودة للماضي بسحر
!زاين، فيمكننا تغيير الأوضاع

344
00:18:07,360 --> 00:18:12,360
يمكننا الكلام معها أوّلاً ومعرفة
!لمَ قامت بلعننا

345
00:18:12,670 --> 00:18:14,590
...كنتُ أفكّر

346
00:18:14,590 --> 00:18:19,610
آخر ما سيلزمنا لقتل شادي هو لمسك لها

347
00:18:22,950 --> 00:18:27,110
مع أنّي أجهل ما إن كانت
لعنتها ستؤثر عليها

348
00:18:27,480 --> 00:18:30,820
لكن بأيّ حال، لم يقتلني سحرها

349
00:18:31,180 --> 00:18:32,540
فالأمر جديرٌ بالتجربة

350
00:18:32,540 --> 00:18:33,000
!كلّا

351
00:18:33,250 --> 00:18:34,670
!لا أريد فعل ذلك

352
00:18:34,670 --> 00:18:35,890
!كلّا! كلّا

353
00:18:35,890 --> 00:18:37,970
!لا أريد قتل أحد

354
00:18:39,290 --> 00:18:42,430
!من الصحيح أنّ لعنتها سبّبت لي الكثير من المعاناة

355
00:18:43,720 --> 00:18:45,930
قلبت حياة روب

356
00:18:46,760 --> 00:18:48,580
ولا يمكنني لمس أليس

357
00:18:49,420 --> 00:18:51,540
...لا أستطيع الرقص أو الخروج في مواعيد

358
00:18:51,540 --> 00:18:52,900
...فهمتك، فهمتك

359
00:18:52,900 --> 00:18:57,750
لكن سلب حياة أحدهم يجب
!ألّا يكون أمراً بتلك البساطة

360
00:18:57,750 --> 00:19:00,350
!لا أريد قتلها لأنّها ساحرة شرّيرة وحسب

361
00:19:00,350 --> 00:19:02,810
!لا أريد أن أكون خائفاً، بل أن أقبلها

362
00:19:02,810 --> 00:19:04,080
...سأكون

363
00:19:06,060 --> 00:19:07,790
!صديقاً مع شادي

364
00:19:10,010 --> 00:19:12,120
نسيتُ إعطاءك هذه الأشياء

365
00:19:12,120 --> 00:19:15,570
دليل المدرسة وأزياؤكم

366
00:19:25,380 --> 00:19:27,160
يصادقها إذاً؟

367
00:19:27,470 --> 00:19:30,860
ما خطّته؟ يبدأ بالتعريف عن نفسه؟

368
00:19:30,860 --> 00:19:32,190
ربما صديقان بالمراسة؟

369
00:19:32,190 --> 00:19:33,360
لا أعلم

370
00:19:33,360 --> 00:19:36,760
بأيّ حال، ارجع لهيئتك العاديّة

371
00:19:36,760 --> 00:19:38,660
كأنّي عشيقة صبيّ صغير

372
00:19:38,660 --> 00:19:39,740
وذلك لا يروقني

373
00:19:39,740 --> 00:19:41,110
انتظري قليلاً فحسب

374
00:19:47,780 --> 00:19:49,620
ماذا؟ ستغادران؟

375
00:19:49,930 --> 00:19:52,330
لم تعد هناك حاجة للاختباء

376
00:19:52,330 --> 00:19:56,090
وتقول كاف أنّها تريد الذهاب لمدرستهم

377
00:19:56,090 --> 00:19:57,870
فعلينا التحضير لذلك

378
00:19:57,870 --> 00:19:59,550
ستذهب أيضاً إذاً

379
00:19:59,550 --> 00:20:02,230
أجل، يُقال أنّها مختلطة

380
00:20:03,760 --> 00:20:05,300
تبدين محبطةً يا كاف-تشان

381
00:20:05,300 --> 00:20:07,560
أيمكنني لمس أثدائكِ لإبهاجك؟

382
00:20:10,850 --> 00:20:12,120
!إلى اللقاء

383
00:20:12,120 --> 00:20:13,040
سنزوركم لاحقاً

384
00:20:16,150 --> 00:20:17,400
أريد أن أصبح أقوى

385
00:20:21,450 --> 00:20:23,540
قويّة بما يكفي لحماية الجميع

386
00:21:55,010 --> 00:21:57,950
زارنا الكثير من الأشخاص هنا مؤخراً

387
00:21:57,950 --> 00:22:00,190
لكن فاجأني أولئك الاثنين اليوم

388
00:22:00,190 --> 00:22:00,860
أجل

389
00:22:00,860 --> 00:22:02,720
أصبح لديك أصدقاء أكثر

390
00:22:02,720 --> 00:22:04,010
أصدقاء؟

391
00:22:04,010 --> 00:22:07,730
حسناً، ليسا شخصين سيّئين

392
00:22:07,730 --> 00:22:10,480
عليّ الامتنان لعدم كوننا وحيدين على الدوام

393
00:22:10,480 --> 00:22:14,020
تلطّفت كاف وزاين بزيارة شخص مثلي

394
00:22:14,020 --> 00:22:18,110
جانبك هذا هو ما يحترمه الجميع

395
00:22:18,110 --> 00:22:19,330
صـ-صحيح؟

396
00:22:19,330 --> 00:22:22,590
أجل، أنا أحترمك كثيراً أيضاً بالطبع

397
00:22:22,590 --> 00:22:25,990
ذلك لطيفٌ جدّاً وظريف

398
00:22:25,080 --> 00:22:28,850
لكنّي الآن، أمتلكك لي بمفردي

399
00:22:30,700 --> 00:22:32,880
!القمر كبيرٌ جدّاً يا أليس

400
00:22:32,880 --> 00:22:33,910
!لنذهب لرؤيته

401
00:22:40,240 --> 00:22:40,930
أليس

402
00:22:41,430 --> 00:22:44,020
!إنّها مثيرةٌ جدّاً عندما تخرّج من النافذة وحسب

403
00:22:44,020 --> 00:22:45,900
أخرجتُ ساقي عمداً

404
00:22:45,900 --> 00:22:46,590
!بالطبع

405
00:22:49,450 --> 00:22:51,720
الجوّ يبرد ليلاً

406
00:22:51,720 --> 00:22:53,090
...هل نتعرّى وندفئ بعضنا

407
00:22:53,090 --> 00:22:54,570
!لا! لا تخلعي ثيابك

408
00:22:57,110 --> 00:23:00,350
أليس، لا تقلقي

409
00:23:00,350 --> 00:23:02,020
كلّ ما لديّ يخصّك

410
00:23:04,540 --> 00:23:07,390
لم قلت أنّه لي بمفردي؟

411
00:23:07,960 --> 00:23:10,910
...أنا مسرورة لامتلاكه المزيد من الأصدقاء

412
00:23:12,100 --> 00:23:16,600
لكنّي أريده أكثر من أيّ وقت قطّ

413
00:23:19,320 --> 00:23:22,260
أحان وقت شجار الوسادات؟

414
00:23:22,260 --> 00:23:26,050
!جلبتُ وسادتين من وساداتي

415
00:23:31,260 --> 00:23:33,950
...تأخّرت

416
00:23:35,690 --> 00:23:39,480
"الدوق وأليس ومدرسة الشعوذة"