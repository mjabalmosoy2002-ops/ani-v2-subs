1
00:00:01,330 --> 00:00:08,290
أيمكنك تصوّر حياة حيث لا تستطيع
لمس الشخص الذي تحبّه؟

2
00:00:09,160 --> 00:00:14,130
تسبّبت اللعنة التي أُلقيت عليه من قِبل
الساحرة بسلبه لحيوات أيّ من يمسّهم

3
00:00:14,780 --> 00:00:19,110
نأت أمه بنفسها عنه، ونعته أصدقاؤه بالوحش

4
00:00:19,110 --> 00:00:20,500
حتّى الأشخاص الذين لم يقابلهم قطّ

5
00:00:20,500 --> 00:00:23,490
"تكلّموا عنه بصفته "تجسّد الموت الذي يقطن الغابة

6
00:00:24,140 --> 00:00:29,210
لكنّه... لا يشعر بأية وحدة

7
00:00:30,390 --> 00:00:32,280
!عجباً، تليفون حبليّ

8
00:00:32,280 --> 00:00:33,720
!أتذكّر

9
00:00:34,590 --> 00:00:37,130
!كنّا نلعب بهذا طوال الوقت في صغرنا

10
00:00:37,130 --> 00:00:42,000
باستعماله، يمكنني الكلام معك حتّى
عندما أكون في الغرفة المجاورة

11
00:00:44,800 --> 00:00:46,730
سأجرّب الأمر

12
00:00:49,440 --> 00:00:52,250
...لمرّتي الأولى معك سموّك، سوف

13
00:01:01,070 --> 00:01:03,280
أسمعت ما قلتُه؟

14
00:01:03,280 --> 00:01:05,980
لا يمكنني قوله بشفتيّ

15
00:01:06,300 --> 00:01:07,560
نجح الأمر إذاً

16
00:02:42,400 --> 00:02:43,970
ماذا؟ ما هذا المكان؟

17
00:02:44,650 --> 00:02:46,930
...ترتدين زيّاً ظريفاً

18
00:02:46,930 --> 00:02:48,440
وكذلك أنا؟

19
00:02:48,810 --> 00:02:53,650
يبدو أنّنا سُحبنا إلى كتابٍ آخر كنت أقرؤه

20
00:02:53,650 --> 00:02:56,610
حصل هذا قبلاً

21
00:02:57,260 --> 00:03:00,270
...المرّة الفائتة كانت أرض العجائب، لذا

22
00:03:01,610 --> 00:03:04,580
أهذه ذات الرداء الأحمر؟

23
00:03:05,160 --> 00:03:06,290
!بالفعل

24
00:03:06,740 --> 00:03:09,540
!أنا ذات الرداء الأحمر

25
00:03:09,840 --> 00:03:10,780
!إنّها هي حقّاً

26
00:03:10,780 --> 00:03:11,860
أريد توقيعك

27
00:03:11,860 --> 00:03:12,750
صمتاً

28
00:03:12,970 --> 00:03:16,260
يوجد ذئبٌ سيّئ في المنزل هناك

29
00:03:16,260 --> 00:03:17,710
أودّ منك هزيمته

30
00:03:18,260 --> 00:03:19,680
ذئب؟

31
00:03:19,680 --> 00:03:21,130
،إن استطعت هزيمته

32
00:03:21,130 --> 00:03:23,220
!فسأحقّق لك أيّة أمنية

33
00:03:23,490 --> 00:03:24,540
حقّاً؟

34
00:03:24,540 --> 00:03:26,100
أيمكنكِ إبطال لعنتي؟

35
00:03:26,100 --> 00:03:28,310
!بالطبع، دع الأمر لي

36
00:03:29,830 --> 00:03:33,770
بالمناسبة، لمَ أنا أرتدي رداء ذئب؟

37
00:03:34,070 --> 00:03:37,340
كي يظنّ أنّك رفيق ويتراخى

38
00:03:37,340 --> 00:03:38,950
!فلتذهب الآن

39
00:03:38,950 --> 00:03:39,740
!بسرعة

40
00:03:40,390 --> 00:03:44,170
!إنّها مخيفة! تتمتّع بميول بساديّة

41
00:03:44,170 --> 00:03:45,200
هوّن عليك

42
00:03:48,380 --> 00:03:52,320
أليس، متى ستتركين ذيلي؟

43
00:03:53,330 --> 00:03:54,560
آسفة

44
00:03:54,560 --> 00:03:58,750
كنتُ أرى ما إن كان بإمكاني لمسك
في هذا الحلم أيضاً

45
00:03:58,750 --> 00:04:01,800
إن أردت لمسي أيضاً، فيمكنك

46
00:04:01,800 --> 00:04:03,290
مثل ذئبٍ حقيقيّ

47
00:04:03,620 --> 00:04:05,090
!سأمتنع

48
00:04:07,700 --> 00:04:10,040
أهذا منزل الذئب؟

49
00:04:10,040 --> 00:04:10,820
أجل

50
00:04:11,160 --> 00:04:12,310
لندخله

51
00:04:18,890 --> 00:04:20,990
!إ-إنّه هو حقّاً

52
00:04:21,360 --> 00:04:22,490
هذا هو

53
00:04:22,490 --> 00:04:26,450
لـ-لكن كيف نهزمه؟ لا نملك أيّة أسلحة

54
00:04:27,060 --> 00:04:29,160
أهذا أنتِ يا ذات الرداء الأحمر؟

55
00:04:31,220 --> 00:04:34,600
أذناك كبيرتان حقّاً يا جدّتي

56
00:04:34,600 --> 00:04:35,620
!أليس

57
00:04:36,080 --> 00:04:40,220
كي أسمعكِ بوضوح

58
00:04:41,690 --> 00:04:45,190
عيناك كبيرتان حقّاً يا جدّتي

59
00:04:45,190 --> 00:04:46,800
لمَ تنظرين لي؟

60
00:04:47,110 --> 00:04:50,480
كي أراكِ بوضوح

61
00:04:52,810 --> 00:04:56,010
براثنك مثيرةٌ سموّك

62
00:04:56,010 --> 00:04:57,690
!"قلتِ "سموّك

63
00:04:57,690 --> 00:05:01,380
كي أمسككِ بإحكام يا عزيزتي

64
00:05:01,380 --> 00:05:03,270
!وليس يصغي حتّى

65
00:05:03,270 --> 00:05:07,490
فمكِ كبيرٌ ومخيف يا جدّتي

66
00:05:07,490 --> 00:05:09,460
...كي آكلك

67
00:05:09,460 --> 00:05:12,950
!كي آكلك سموّك

68
00:05:11,500 --> 00:05:12,950
!لا تسرقي جملته

69
00:05:13,180 --> 00:05:16,910
!أنتما تفسدان القصّة باستمرار

70
00:05:16,910 --> 00:05:18,420
!سألتهمكما

71
00:05:23,480 --> 00:05:26,800
!تاكاشي، وقت العشاء

72
00:05:26,800 --> 00:05:30,050
!وقت العشاء! وقت العشاء

73
00:05:32,430 --> 00:05:34,560
!أمّي! أمّي

74
00:05:34,560 --> 00:05:36,420
!تحوّل لرضيع

75
00:05:36,420 --> 00:05:39,440
لمَ نفيتِني من القطيع؟

76
00:05:39,650 --> 00:05:42,120
!شعرتُ بوحدة

77
00:05:42,120 --> 00:05:43,650
!بوحدة شديدة

78
00:05:44,970 --> 00:05:47,360
هذا ما حصل إذاً؟

79
00:05:47,580 --> 00:05:49,530
أحسنتما البلاء

80
00:05:49,530 --> 00:05:52,580
!سآخذه وأقوم بتربيته

81
00:05:52,950 --> 00:05:56,600
...بخصوص تلك الأمنية إذاً

82
00:05:56,600 --> 00:05:58,480
!لم تهزمه

83
00:05:58,480 --> 00:06:01,480
أيمكنك إيذاء رضيع لا يستطيع
الدفاع عن نفسه كهذا؟

84
00:06:01,480 --> 00:06:03,000
"غو غوو"

85
00:06:03,910 --> 00:06:06,360
!أفق أيّها الفاشل

86
00:06:19,750 --> 00:06:22,150
تبدو ظريفة في نومها

87
00:06:39,990 --> 00:06:41,210
والتر؟

88
00:06:41,730 --> 00:06:43,710
أتعثرت؟ أأنت بخير؟

89
00:06:43,710 --> 00:06:46,260
أجل، أنا بخير

90
00:06:46,590 --> 00:06:48,420
اعتنِ بنفسك

91
00:06:49,250 --> 00:06:54,140
إن حصل أمرٌ ما له، فستكون الوريث مكانه

92
00:06:59,800 --> 00:07:01,300
،مُذ طفولتي

93
00:07:01,990 --> 00:07:05,690
لطالما عرفتُ أنّ الجميع
يحبّون أخي أكثر منّي

94
00:07:07,320 --> 00:07:11,640
لا ينطقان بالأمر، لكنّ أمّي وفيولا تحبّانه

95
00:07:12,870 --> 00:07:15,850
يريدانه أن يصبح الوريث

96
00:07:16,830 --> 00:07:19,460
...تنظر أمّي من النافذة دوماً

97
00:07:21,160 --> 00:07:26,350
لأنّها تنتظر إبطاله للعنته وعودته للبيت

98
00:07:36,920 --> 00:07:41,450
قال التاجر المشبوه في البلدة أنّ
بارتدائك لهذا الرداء السحريّ

99
00:07:41,860 --> 00:07:45,320
،ولمس مرآة في ليلة بدر

100
00:07:45,320 --> 00:07:47,900
يمكنك الذهاب للسبت حيث تجتمع الساحرات

101
00:07:49,570 --> 00:07:53,300
،عليّ اكتشاف الحقيقة حيال اللعنة قبل أخي الأكبر

102
00:07:53,850 --> 00:07:57,120
!وجعله يدركون أنّي أفضل منه

103
00:07:59,080 --> 00:08:02,080
سأغلبه، سأغلبه مهما حصل

104
00:08:02,080 --> 00:08:06,960
!سأغلبه حتماً! أقسم! سأغلبه

105
00:08:08,880 --> 00:08:10,800
!لستُ بديله وحسب

106
00:08:13,140 --> 00:08:17,570
!سأثبت قيمتي

107
00:08:21,930 --> 00:08:23,940
تريدين العودة للسبت؟

108
00:08:24,730 --> 00:08:26,950
لكن لمَ... ترتدين هذه الثياب؟

109
00:08:27,290 --> 00:08:32,400
تعرف الساحرات وجهي، فخطر لي ارتداء تنكّر

110
00:08:32,970 --> 00:08:34,000
ما رأيك؟

111
00:08:34,000 --> 00:08:38,120
كلّ الأشياء الظريفة في العالم مجتمعة
!لا تصل ظرافتك

112
00:08:38,450 --> 00:08:41,330
لكنّ كاف وزاين ليسا هنا

113
00:08:41,900 --> 00:08:46,670
أريد التحقّق بنفسي من صحّة كلام داليث

114
00:08:47,670 --> 00:08:50,070
سأوقظ شارون من نومها

115
00:08:52,120 --> 00:08:57,430
لم نستطع إنهاء محادثتنا، فأريد الكلام معها شخصيّاً

116
00:08:58,310 --> 00:08:59,950
أعي خطورة الأمر

117
00:08:59,950 --> 00:09:02,710
لـ-لكن كيف تنوين الذهاب لعالم الساحرات؟

118
00:09:03,030 --> 00:09:05,640
أخذنا زاين وكاف المرّة الفائتة

119
00:09:05,970 --> 00:09:08,030
لكنّ الأمر ليس بتلك السهولة الآن

120
00:09:08,880 --> 00:09:10,860
سأستعمل سحرهما

121
00:09:14,350 --> 00:09:17,970
استعرتُ الحجرة التي كانت بحوزة
كاف-سان من روب-سان

122
00:09:17,970 --> 00:09:20,280
!المكان الذي وضعتِها فيه فاتنٌ جدّاً

123
00:09:24,300 --> 00:09:27,980
كانت كاف-سان تحبّها وتحملها معها طوال الوقت

124
00:09:27,980 --> 00:09:30,250
فلا تزال تحوي بعض السحر

125
00:09:31,480 --> 00:09:33,210
ما الذي ستفعله سموّك؟

126
00:09:33,530 --> 00:09:35,720
لا أمانع الذهاب بمفردي

127
00:09:35,720 --> 00:09:37,650
!سـ-سأرافقكِ بالطبع

128
00:09:37,650 --> 00:09:40,050
لا يمكنني أن أترككِ تذهبين وحدك

129
00:09:40,900 --> 00:09:43,520
أنت شجاعٌ سموّك

130
00:09:44,480 --> 00:09:47,250
...هذه الهديّة التي أعطانا إيّاها زاين

131
00:09:48,260 --> 00:09:49,230
!أليس

132
00:09:49,230 --> 00:09:51,690
!ا-انتظريني يا أليس

133
00:10:04,440 --> 00:10:06,130
هذا عالم الساحرات إذاً؟

134
00:10:06,760 --> 00:10:08,710
يوجد أشخاصُ أكثر مما ظننت هنا

135
00:10:08,710 --> 00:10:10,190
ستكون مشكلة إن أمسكوا بي

136
00:10:10,190 --> 00:10:11,670
لا جدوى

137
00:10:12,060 --> 00:10:15,420
ترفض داليث الخروج من الكنيسة

138
00:10:17,050 --> 00:10:19,090
لا جدوى إذاً؟

139
00:10:19,310 --> 00:10:20,170
أجل

140
00:10:20,170 --> 00:10:22,440
رأى أحدٌ وجهها، وأصابها الإحباط الآن

141
00:10:22,440 --> 00:10:23,760
هذه مشكلة

142
00:10:23,760 --> 00:10:26,560
لا يمكن بدء السبت دون الزعيمة

143
00:10:26,840 --> 00:10:28,850
توجد ساحرة أقوى هنا؟

144
00:10:29,320 --> 00:10:32,520
عليّ التوجّه لتلك الكنيسة إذاً

145
00:10:32,520 --> 00:10:36,390
!ذاك الفتى الثريّ بالقبّعة الطويلة حقير

146
00:10:36,390 --> 00:10:38,490
هو؟ الأكبر؟

147
00:10:38,780 --> 00:10:42,450
يستحيل أن أكون على وفاق
!مع ضعيف مثله

148
00:10:42,680 --> 00:10:45,670
!أفهمكِ يا آنسة

149
00:10:45,670 --> 00:10:47,440
!عدو عدوّي هو صديقي

150
00:10:47,440 --> 00:10:50,480
!من يكره الشخص الذي أكرهه صديقي

151
00:10:53,530 --> 00:10:54,670
أأنت بخير؟

152
00:10:55,810 --> 00:10:57,440
...شكراً لكِ يا أليس

153
00:10:59,370 --> 00:11:00,590
!والتر

154
00:11:01,340 --> 00:11:03,050
من كان ذلك؟

155
00:11:03,050 --> 00:11:04,550
داليث؟

156
00:11:04,550 --> 00:11:06,220
!ليست داليث

157
00:11:09,890 --> 00:11:12,740
!أليس، اتبعي والتر

158
00:11:13,900 --> 00:11:15,480
!انتظر

159
00:11:19,490 --> 00:11:21,520
!انتظر! انتظر

160
00:11:20,180 --> 00:11:21,320
...سموّك

161
00:11:21,520 --> 00:11:22,990
!وداعاً

162
00:11:30,610 --> 00:11:35,640
لا أدري ما الذي حلّ به، لكن لمَ لا ترجعين؟

163
00:11:36,110 --> 00:11:39,480
أخبرني بأن أتبعك

164
00:11:40,330 --> 00:11:43,750
أتوتّر عندما أكون بمفردي مع فتاة

165
00:11:43,750 --> 00:11:46,000
سأكون سعيداً لو انصرفتِ

166
00:11:46,000 --> 00:11:47,300
لا أستطيع

167
00:11:49,870 --> 00:11:51,590
اسمكِ أليس-سان؟

168
00:11:52,010 --> 00:11:55,310
أتذكّر بضبابيّة تواجدكِ في منزلنا في صغري

169
00:11:55,980 --> 00:11:57,570
أأنتِ راضية بالوضع الراهن؟

170
00:11:58,910 --> 00:12:01,720
أأنتِ راضية بكونكِ خادمته؟

171
00:12:01,720 --> 00:12:06,410
فتاة شابة عالقة في تلك
الغابة المُظلمة... أرثي حالك

172
00:12:06,410 --> 00:12:10,370
لا، أنا سعيدةٌ لتواجدي بجانب سموّه يوميّاً

173
00:12:10,910 --> 00:12:12,170
حقّاً؟

174
00:12:12,520 --> 00:12:14,330
ليس شخصاً مميّزاً

175
00:12:14,860 --> 00:12:19,040
أنت تسيء فهمه يا والتر-ساما

176
00:12:19,040 --> 00:12:22,300
أنتما أخوان، فشخصيّتاكما متشابهتان

177
00:12:28,110 --> 00:12:31,070
...لا تشمليني معه رجاءً

178
00:12:31,070 --> 00:12:32,230
الأمر يقتلني

179
00:12:32,230 --> 00:12:35,230
أنا آسفة، لم أكن أعلم

180
00:12:35,630 --> 00:12:37,980
ولا تستعملي تلك الكلمة تحديداً

181
00:12:37,980 --> 00:12:41,190
...عندما يقول أحد أنّي أخوه الصغير أو الابن الثاني

182
00:12:43,580 --> 00:12:45,370
!أموت

183
00:12:48,670 --> 00:12:50,330
هذا المكان إذاً؟

184
00:12:50,330 --> 00:12:53,760
هذه الكنيسة التي تتواجد فيها
زعيمة عالم الساحرات؟

185
00:12:55,940 --> 00:12:58,310
هل سموّه بخير؟

186
00:12:58,730 --> 00:13:01,410
حيلة أم حلوى؟

187
00:13:01,410 --> 00:13:02,650
آسفة

188
00:13:02,650 --> 00:13:04,750
لا حلويّات معي الآن

189
00:13:11,070 --> 00:13:12,330
...مؤلم

190
00:13:12,330 --> 00:13:14,430
أعدها لها

191
00:13:14,760 --> 00:13:17,310
!سمعتُ ما قلته قبلاً

192
00:13:17,310 --> 00:13:20,090
!تعاني عقدة من مناداتك بالابن الثاني

193
00:13:20,090 --> 00:13:22,410
!حسناً، ستبقى الابن الثاني للأبد أيّها الفاشل

194
00:13:22,410 --> 00:13:23,830
ذلك ليس صحيحاً

195
00:13:23,830 --> 00:13:25,150
!إنّه مكتوبٌ على وجهك

196
00:13:25,150 --> 00:13:26,700
!الوداع أيّها الابن الثاني

197
00:13:27,250 --> 00:13:27,860
!انتظر

198
00:13:34,640 --> 00:13:36,540
يا للمكان الغريب لمنزل

199
00:13:37,140 --> 00:13:38,900
أيمكن إصلاح تلك القلادة؟

200
00:13:38,900 --> 00:13:39,740
أجل

201
00:13:39,740 --> 00:13:42,800
الصورة داخلها هي المهمّة

202
00:13:45,240 --> 00:13:46,500
لنسترجعها

203
00:13:46,500 --> 00:13:47,970
ارتدي هذا

204
00:13:48,280 --> 00:13:51,990
،أخبرني تاجر مشبوه في البلدة أنّ بارتدائه

205
00:13:51,990 --> 00:13:53,450
لن يدركوا أنّي بشريّ

206
00:13:54,030 --> 00:13:56,190
...لا أعرف مدى فائدته حقّاً، لكن

207
00:13:56,570 --> 00:13:58,440
عليك ارتداؤه يا والتر-ساما

208
00:13:58,840 --> 00:14:00,120
لا داعي

209
00:14:00,120 --> 00:14:02,250
رأت الساحرتان وجهي سلفاً

210
00:14:02,580 --> 00:14:05,450
لمَ تتصرّف بهذا اللطف؟

211
00:14:05,450 --> 00:14:07,700
أنا أحميكِ لأنّكِ فتاة

212
00:14:09,160 --> 00:14:11,550
،لستُ خبيراً حول النساء

213
00:14:12,090 --> 00:14:16,060
لكنّي تربّيت منذ نعومة أظفاري
على التعامل باحترام معهنّ

214
00:14:16,380 --> 00:14:17,620
ذلك كلّ ما بالأمر

215
00:14:18,460 --> 00:14:22,340
أنت شابٌ لطيف مثل سموّه حقّاً

216
00:14:26,310 --> 00:14:27,340
آسفة

217
00:14:27,340 --> 00:14:28,760
...لنذهب وحسب

218
00:14:31,520 --> 00:14:33,260
!أتيت أخيراً أيّها الابن الثاني

219
00:14:33,260 --> 00:14:34,180
!تبّاً لك

220
00:14:35,700 --> 00:14:37,270
!ابن ثانٍ غبيّ

221
00:14:37,270 --> 00:14:39,560
!أمسك بي إذا لم يعجبك الأمر

222
00:14:41,860 --> 00:14:43,380
!إلى اللقاء

223
00:14:44,820 --> 00:14:47,240
أعتذر على جعلك تتعامل مع هذا

224
00:14:47,240 --> 00:14:50,320
كلّا، لقد تمادى كثيراً

225
00:14:50,320 --> 00:14:52,030
!سألقّنه درساً بعد الإمساك به

226
00:14:53,720 --> 00:14:55,240
لا أراه في أيّ مكان

227
00:14:56,240 --> 00:14:58,460
يذكّرني هذا بطفولتي

228
00:14:59,270 --> 00:15:00,870
كان أخي لا يجيد لعبة الاختباء

229
00:15:00,870 --> 00:15:02,960
وكنتُ أجده فوراً في كلّ مرة

230
00:15:03,770 --> 00:15:07,020
كنتُ أختبئ في مكان ضيّق ولا أتحرّك البتّة

231
00:15:07,650 --> 00:15:11,180
!كان لا يستطيع إيجادي لساعات، ونساني أحياناً

232
00:15:11,180 --> 00:15:13,900
!كلّ هذه غلطة أخي

233
00:15:15,410 --> 00:15:18,600
!ولذا... لعبة الاختباء هي شيء أجيده

234
00:15:19,290 --> 00:15:22,350
...إنّه يختبئ داخل هذه الخزانة

235
00:15:22,600 --> 00:15:24,330
!أو يُوهمنا بذلك، وهو وراءها

236
00:15:24,330 --> 00:15:27,070
!كلّا! وجدني الابن الثاني الغبيّ

237
00:15:27,070 --> 00:15:28,430
!انتظر

238
00:15:28,430 --> 00:15:30,310
!أنا هنا

239
00:15:30,650 --> 00:15:31,770
متى وصل هناك؟

240
00:15:31,770 --> 00:15:33,420
أيوجد ممرّ سريّ؟

241
00:15:33,420 --> 00:15:35,060
!سأنال منه

242
00:15:35,060 --> 00:15:37,700
!سأنال منه فيجينتليون مرّة

243
00:15:37,700 --> 00:15:40,960
تلك كلمةٌ صعبة

244
00:15:41,080 --> 00:15:42,790
!تعال هنا

245
00:15:42,920 --> 00:15:45,130
!تعال بسرعة أيّها الابن الثاني

246
00:15:45,250 --> 00:15:47,090
!فلتمسك بي

247
00:15:47,230 --> 00:15:49,720
!لا بدّ أنّ كونك الابن الثاني أمرٌ مريع

248
00:15:49,720 --> 00:15:51,190
!من هنا

249
00:15:51,190 --> 00:15:52,800
!هنا أيّها الابن الثاني

250
00:15:52,800 --> 00:15:53,940
!الابن الثاني! الابن الثاني

251
00:15:53,940 --> 00:15:56,260
!من لا حاجة له! الابن الثاني

252
00:15:58,150 --> 00:15:59,500
...والتر-ساما

253
00:16:00,520 --> 00:16:03,690
هذا التوتّر هو غلطة الأكبر كلّياً

254
00:16:04,540 --> 00:16:06,310
...عليّ التركيز

255
00:16:06,310 --> 00:16:07,920
ما الخطب؟

256
00:16:07,920 --> 00:16:09,650
!أيّها الابن الثاني الضعيف

257
00:16:10,360 --> 00:16:12,860
تعال وأمسك بي

258
00:16:13,840 --> 00:16:15,680
اكتفيتُ من ملاحقتك

259
00:16:17,370 --> 00:16:19,030
استسلمت بهذه السرعة؟

260
00:16:19,030 --> 00:16:20,700
!فاشل

261
00:16:20,700 --> 00:16:22,820
يوجد اثنان منكما، صحيح؟

262
00:16:24,060 --> 00:16:26,500
أنتما توأم ومظهركما متماثل

263
00:16:27,200 --> 00:16:29,460
الأكبر هو من أخذ القلادة

264
00:16:30,070 --> 00:16:33,390
ويبدو أنّك ترتدي ثياباً مستعملة، فأنت الأصغر

265
00:16:33,390 --> 00:16:37,760
كما... لم تسخر منّي لكوني الابن الثاني، أليس كذلك؟

266
00:16:40,920 --> 00:16:42,680
وجدتُ الأخ الأكبر

267
00:16:42,680 --> 00:16:44,280
ما الذي تفعله؟

268
00:16:44,280 --> 00:16:46,530
!أمسكاني بسببك

269
00:16:46,530 --> 00:16:48,070
آ-آسف

270
00:16:48,070 --> 00:16:49,490
هل ستقبل ذلك حقّاً؟

271
00:16:50,440 --> 00:16:54,360
ليس عليك فعل كلّ ما يقوله أخوك
الأكبر لأنّك أصغر منه وحسب

272
00:16:54,890 --> 00:16:56,510
يمكنك الأخذ باعتبارك

273
00:16:57,170 --> 00:16:59,080
فهذا ما يعنيه أن تكونا أخوين

274
00:17:00,810 --> 00:17:03,290
فلترجع القلادة الآن

275
00:17:03,290 --> 00:17:04,750
!كلّا

276
00:17:06,090 --> 00:17:07,100
هاك

277
00:17:07,100 --> 00:17:08,710
شكراً لك

278
00:17:08,710 --> 00:17:10,540
!ما الذي تفعله؟

279
00:17:10,540 --> 00:17:12,420
!اصمت! كفّ عن تأمّري

280
00:17:13,650 --> 00:17:19,140
لعلّك أكثر لطفاً مما ظننت يا والتر-ساما

281
00:17:20,800 --> 00:17:24,060
أنت مثل سموّه حقّاً

282
00:17:28,260 --> 00:17:30,000
!أأنت بخيرٍ أيّها الابن الثاني؟

283
00:17:30,000 --> 00:17:31,780
!تماسك

284
00:17:40,260 --> 00:17:41,450
لا أستطيع

285
00:17:42,990 --> 00:17:44,950
...لا أستطيع تجاوز الأمر

286
00:17:44,950 --> 00:17:50,760
،داليث، وجهكٍ يشبه وجهي تماماً
فمن الصعب التفريق بيننا

287
00:17:51,160 --> 00:17:53,420
أيمكنني تغيير ذلك؟

288
00:18:01,690 --> 00:18:05,460
ستصعد إلى هناك حقّاً؟

289
00:18:05,460 --> 00:18:09,100
أجل، سيكون ذلك أكثر أماناً
من العبور من المدخل

290
00:18:09,890 --> 00:18:14,570
!إذا استطعتُ الدخول، سأفتح الباب لذا انتظريني

291
00:18:14,570 --> 00:18:16,320
إنّه جريءٌ جدّاً

292
00:18:19,130 --> 00:18:23,790
أختي... كيف لكِ إبداء تلك البراءة
حيال أذيّة أحدهم؟

293
00:18:24,660 --> 00:18:30,460
لمَ متِّ وتركتِني مسؤولةً عن كلّ شيء؟

294
00:18:31,800 --> 00:18:33,760
!أكرهكِ يا أختي

295
00:18:34,310 --> 00:18:39,310
!أنتِ أنانيّة ومغرورة ولا تفهميني أبداً

296
00:18:42,430 --> 00:18:44,510
!أفسدتِ حياتي

297
00:18:45,370 --> 00:18:49,650
!لن أستطيع مسامحتكِ أبداً

298
00:18:49,650 --> 00:18:55,280
!أفهم شعوركِ تماماً

299
00:18:52,020 --> 00:18:52,940
من هناك؟

300
00:18:55,280 --> 00:18:56,900
!كرّرت مقولتك

301
00:18:57,610 --> 00:19:00,280
ما الذي تفعله في كنيستي؟

302
00:19:03,700 --> 00:19:06,700
أنت أخ ذاك الصبيّ الصغير؟

303
00:19:07,130 --> 00:19:08,490
اسمي والتر

304
00:19:08,930 --> 00:19:11,420
أعتذر، سمعتُ ما قلتِه

305
00:19:11,920 --> 00:19:14,800
أعرف أنّ من الغريب التعاطف مع ساحرة

306
00:19:15,380 --> 00:19:17,570
!لكنّي أكره أخي أيضاً

307
00:19:17,570 --> 00:19:20,820
!تحدّدت حياتي بأسرها من البداية بسببه

308
00:19:20,820 --> 00:19:25,890
!إنّه أنانيّ ومغرور ولا يفهمني أبداً

309
00:19:26,950 --> 00:19:28,740
!أنتِ مثلي

310
00:19:29,170 --> 00:19:30,790
ما الذي تتكلّم عنه؟

311
00:19:30,790 --> 00:19:32,850
ولمَ أتيت هنا بالأصل؟

312
00:19:33,610 --> 00:19:35,990
لمعرفة تفاصيل عن لعنة أخي

313
00:19:35,990 --> 00:19:38,570
...نويتُ البقاء في الظلال، لكن

314
00:19:39,740 --> 00:19:42,280
لم أستطع تجاهل سيّدة تبكي

315
00:19:43,770 --> 00:19:46,740
!لستُ سيّدة! لسنا متشابهين

316
00:19:47,280 --> 00:19:50,070
!وجهي قبيحٌ ومشوّه

317
00:19:50,070 --> 00:19:52,410
!يستحيل أن يفهمني وسيمٌ مثلك

318
00:19:52,410 --> 00:19:53,960
كلّا، نحن متشابهان

319
00:19:54,490 --> 00:19:58,610
مهما بدوتُ عليه، أنا لا أعدو
عن كوني بديله الآن

320
00:19:59,060 --> 00:20:01,950
أنا أحمل ندبات أيضاً، لكنّكِ
لا تستطيعين رؤيتها وحسب

321
00:20:04,790 --> 00:20:05,890
لا داعي لتخفي وجهكِ

322
00:20:07,730 --> 00:20:08,850
انظري لي

323
00:20:09,870 --> 00:20:11,810
أنتِ جميلة

324
00:20:12,670 --> 00:20:14,520
عليكِ التحلّي بثقة بنفسك

325
00:20:17,610 --> 00:20:20,690
!داليث! أمسكنا بفأرين مُتسلّلين

326
00:20:21,190 --> 00:20:25,660
مررنا بوقت عصيب في محاولة
تقييده دون لمسه

327
00:20:27,370 --> 00:20:30,080
أنا آسفة! أعرف أنّكِ لا تحبّين
!أن يرى الآخرون وجهك

328
00:20:32,280 --> 00:20:35,790
كيف تتعامل مع ندباتك؟

329
00:20:37,300 --> 00:20:38,600
أتقبّلها

330
00:20:40,170 --> 00:20:43,390
لا يمكنني تغيير كوني بديله وحسب

331
00:20:43,390 --> 00:20:44,320
...لكن

332
00:20:44,900 --> 00:20:48,920
يمكنني العمل لإثبات أنّي أكثر قيمة منه

333
00:20:51,540 --> 00:20:54,230
لن يتغيّر شيء ما لم تنظري للأمام

334
00:20:56,110 --> 00:20:57,230
معك حقّ

335
00:20:58,400 --> 00:21:00,740
حان وقت أن أتجاوز هذا

336
00:21:37,170 --> 00:21:40,040
أعتذر على بقائي محبطة لوقتٍ طويل

337
00:21:40,730 --> 00:21:43,180
من الآن فصاعداً، سأتصرّف أكثر هكذا

338
00:21:43,600 --> 00:21:44,690
شكراً لكم جميعاً

339
00:21:48,970 --> 00:21:52,120
!أنتِ جميلةٌ يا داليث-ساما

340
00:21:52,120 --> 00:21:54,410
!إنّكِ بغاية الظرافة

341
00:23:35,470 --> 00:23:39,930
الدوق وأليس ونافذة التقبيل