1
00:00:01,340 --> 00:00:08,320
أيمكنك تصوّر حياة حيث لا تستطيع
لمس الشخص الذي تحبّه؟

2
00:00:09,110 --> 00:00:14,160
تسبّبت اللعنة التي أُلقيت عليه من قِبل
الساحرة بسلبه لحيوات أيّ من يمسّهم

3
00:00:14,820 --> 00:00:19,090
نأت أمه بنفسها عنه، ونعته أصدقاؤه بالوحش

4
00:00:19,090 --> 00:00:20,430
حتّى الأشخاص الذين لم يقابلهم قطّ

5
00:00:20,430 --> 00:00:23,510
"تكلّموا عنه بصفته "تجسّد الموت الذي يقطن الغابة

6
00:00:24,170 --> 00:00:29,220
لكنّه... لا يشعر بأية وحدة

7
00:00:30,650 --> 00:00:34,470
...بي"... "إي"... "إيه"

8
00:00:35,460 --> 00:00:37,460
المكان باردٌ هنا

9
00:00:37,460 --> 00:00:41,030
ليت غرفتكِ كانت أدفأ يا أليس

10
00:00:41,030 --> 00:00:42,810
أنا آسفة

11
00:00:42,810 --> 00:00:48,830
..."إف"... "سي"... "دي"
..."دي"... "دي"

12
00:00:48,830 --> 00:00:50,690
!توقّفي عن هذا

13
00:00:50,690 --> 00:00:52,030
ما الذي تفعلينه؟

14
00:00:52,460 --> 00:00:55,180
كنتُ أحاول قراءة كتاب

15
00:00:55,600 --> 00:00:58,280
"لكنّي أعلق مع الحروف بعد "إف

16
00:00:59,320 --> 00:01:01,480
يمكنكِ القراءة إلى "إف" إذاً؟

17
00:01:01,480 --> 00:01:03,040
علّمني روب

18
00:01:03,040 --> 00:01:06,000
!ماذا؟ يا للبذاءة! أشعر بالغيرة

19
00:01:06,230 --> 00:01:09,010
،لحظة، تلطّف روب بتدريسكِ

20
00:01:09,010 --> 00:01:11,250
ولا يمكنكِ القراءة بعد "إف"؟

21
00:01:11,510 --> 00:01:12,350
أجل

22
00:01:12,350 --> 00:01:14,040
نسيتُ معظمها

23
00:01:14,430 --> 00:01:15,940
!حمقاء

24
00:01:16,330 --> 00:01:18,730
!نسيتِ لأنّكِ لا تتمرّنين

25
00:01:18,730 --> 00:01:20,470
سأعطيكِ مسائلاً تتمرّنين على حلّها

26
00:01:21,400 --> 00:01:23,890
حسناً، ما الحرفان هنا؟

27
00:01:24,490 --> 00:01:26,510
أنتِ رسّامة بارعة يا فيولا

28
00:01:27,160 --> 00:01:29,300
ذلك جيّدٌ جدّاً

29
00:01:29,300 --> 00:01:31,360
!لا يهمّ الآن

30
00:01:33,820 --> 00:01:34,920
!كلّا

31
00:01:34,920 --> 00:01:37,960
!لا تختلقي أشياءً لأنّكِ لا تعرفين الإجابة

32
00:01:37,960 --> 00:01:40,400
لا تقلقي، سأصيب في الإجابة المرّة القادمة

33
00:01:40,400 --> 00:01:43,040
ما مصدر هذه الثقة؟

34
00:01:43,860 --> 00:01:46,000
"حسناً، تعرفين إلى "إف

35
00:01:46,570 --> 00:01:47,810
!تذكّري الحرف التالي

36
00:01:48,680 --> 00:01:50,530
بعد "إف"؟

37
00:01:51,050 --> 00:01:52,640
...ذلك صعب

38
00:01:52,640 --> 00:01:55,640
أنا متأكّدة أنّ زاين يستطيع حلّها بسهولة

39
00:01:57,220 --> 00:01:59,440
!"وجدتُها! الإجابة هي "جي

40
00:01:59,440 --> 00:02:00,660
صحيح

41
00:02:00,660 --> 00:02:01,680
كيف عرفتِ؟

42
00:02:01,970 --> 00:02:06,390
أخبرني زاين قبلاً أنّ مقاسي
!"كأس "جي"، وهو أكبر من "إف

43
00:02:06,390 --> 00:02:07,640
!لذا تذكّرت

44
00:02:08,650 --> 00:02:10,930
..."كوب "جي

45
00:02:12,490 --> 00:02:19,990
،"إيه"، "بي"، "سي"، "دي"
!"إي"، "إف"، "جي

46
00:02:19,110 --> 00:02:19,990
!توقّفي

47
00:04:11,920 --> 00:04:14,140
مرحباً، أتيتِ حقّاً

48
00:04:16,200 --> 00:04:17,860
صادف أنّي مررت بالقرب

49
00:04:18,570 --> 00:04:21,340
أأشكّل أيّ إزعاج؟

50
00:04:21,340 --> 00:04:22,570
البتّة

51
00:04:22,890 --> 00:04:24,480
تسرّني استضافتك

52
00:04:26,860 --> 00:04:30,080
لندخل ونبتعد عن المطر

53
00:04:31,000 --> 00:04:31,910
...لكن

54
00:04:32,170 --> 00:04:35,360
لا يمكنني إعادة سيّدة هكذا

55
00:04:35,360 --> 00:04:36,040
هيّا

56
00:04:41,510 --> 00:04:43,830
لم أدخل منذ وقتٍ طويل

57
00:04:44,160 --> 00:04:45,940
لم يتغيّر المكان كثيراً

58
00:04:45,940 --> 00:04:49,560
صحيح، كنتِ تأتين هنا كثيراً

59
00:04:49,970 --> 00:04:51,050
أجل

60
00:04:51,050 --> 00:04:56,060
،كان هنالك الكثير من الزوّار آنذاك
فلم نبرز كثيراً

61
00:04:56,400 --> 00:04:58,550
لكنّ المكان هادئ كثيراً الآن

62
00:04:58,940 --> 00:05:01,200
أبي في المستشفى منذ وقتٍ طويل

63
00:05:01,200 --> 00:05:03,070
وأمّي تلزم الصمت في العادة

64
00:05:03,730 --> 00:05:07,560
نختلط للحدّ الأدنى المتوقّع من النبلاء فحسب

65
00:05:07,560 --> 00:05:08,800
فهمت

66
00:05:09,770 --> 00:05:13,910
رجعت غيربرا إلى طبعها السابق إذاً

67
00:05:15,040 --> 00:05:16,260
تعرفين أمّي؟

68
00:05:16,810 --> 00:05:19,610
كنتُ أراها كثيراً

69
00:05:20,020 --> 00:05:23,260
لا أعتقد أنّها تعرفني

70
00:05:24,000 --> 00:05:26,470
كانت في الثامنة عشر وقتها

71
00:05:27,610 --> 00:05:31,430
تخرّجت من المدرسة لتوّها آنذاك
وتزوّجت في هذه العائلة

72
00:05:32,260 --> 00:05:37,070
كان والداها صارمان، وكانت هي
امرأة جادّة بحدّ ذاتها

73
00:05:38,090 --> 00:05:40,650
لكنّ ذلك تغيّر مذ أتت شارون

74
00:05:41,090 --> 00:05:44,530
ابتسمت كثيراً، وتحدّثت أكثر

75
00:05:44,530 --> 00:05:46,360
بدا أنّها مستمتعة بوقتها

76
00:05:47,070 --> 00:05:49,320
يصعب تصوّر أمّي هكذا

77
00:05:50,140 --> 00:05:53,290
كانت قاسية بعض الشيء مع أطفالها

78
00:05:53,750 --> 00:05:57,790
أعتقد أنّها أرادت أن ينمو
ليصبحوا نبلاء محترمين

79
00:05:58,370 --> 00:06:03,000
لكن ما أصاب شارون عرّضها لصدمة بالتأكيد

80
00:06:04,960 --> 00:06:07,100
أعتذر، ما كان عليّ قول ذلك

81
00:06:07,100 --> 00:06:07,970
لا بأس

82
00:06:08,810 --> 00:06:10,220
شكراً على إخباركِ لي

83
00:06:14,170 --> 00:06:15,680
برد الشاي

84
00:06:16,530 --> 00:06:19,810
انتظريني، سأذهب لطلب تحضير إبريق آخر

85
00:06:19,810 --> 00:06:21,640
لا داعي، سأرحل عمَّ قريب

86
00:06:22,690 --> 00:06:23,610
لا بأس

87
00:06:31,000 --> 00:06:33,490
...رجعت، ستأتي الخادمات

88
00:06:34,570 --> 00:06:35,380
ماذا؟

89
00:06:37,970 --> 00:06:39,710
"أراك لاحقاً"

90
00:06:44,340 --> 00:06:46,130
خطّها جميل

91
00:06:53,710 --> 00:06:56,610
كنت تعرف إذاً

92
00:06:57,070 --> 00:07:01,150
عن المرأتين في رداء الراهبات
اللتين كانتا تزوران القصر

93
00:07:03,220 --> 00:07:05,150
أخبرني أحدهم

94
00:07:05,150 --> 00:07:09,040
أنّ الرجل ذو العين الواحدة كان أنت، صحيح

95
00:07:09,040 --> 00:07:10,430
الرجل ذو العين الواحدة؟

96
00:07:10,430 --> 00:07:12,740
لديّ لقب رائع كهذا؟

97
00:07:12,740 --> 00:07:14,080
ويحي

98
00:07:14,690 --> 00:07:17,420
تكتّمت على الأمر، أنا آسف

99
00:07:17,420 --> 00:07:19,720
لأجلي، صحيح؟

100
00:07:21,610 --> 00:07:26,750
لو عرفت أنّهما قتلتا أمّي، لأُصبت بصدمة كبيرة

101
00:07:27,120 --> 00:07:29,830
فقلت أنّها ماتت في حادث

102
00:07:29,830 --> 00:07:32,710
وأنّك لم تعرف شيئاً عن
المرأتين في ثياب الراهبات

103
00:07:33,740 --> 00:07:35,660
صحيح

104
00:07:36,930 --> 00:07:40,970
أخبرني بكلّ ما تعرفه عنهما

105
00:07:40,970 --> 00:07:44,010
قد يكون للأمر علاقة بلعنة سموّه

106
00:07:47,300 --> 00:07:55,070
حصل ذلك عندما كان هذا القصر
لا يزال مقرّ عيشنا جميعاً

107
00:07:55,780 --> 00:07:58,730
كان سيّد البيت رجلاً متديّناً

108
00:07:58,730 --> 00:08:01,560
فلم أشكّ في الأمر حقّاً

109
00:08:02,460 --> 00:08:03,630
سيّد البيت؟

110
00:08:03,630 --> 00:08:05,630
جدّ سموّه

111
00:08:06,040 --> 00:08:09,880
كان من عيّنني خادماً

112
00:08:10,500 --> 00:08:14,810
كان مُقرّباً من شارون، ألا تتذكّرينه؟

113
00:08:14,810 --> 00:08:20,100
آسفة، بالكاد أتذكّر شيئاً
من صغري عدا سموه

114
00:08:20,940 --> 00:08:24,590
ما كانت طبيعة علاقتهما؟

115
00:08:24,590 --> 00:08:26,810
لا شيء مشبوه

116
00:08:26,810 --> 00:08:30,280
كانا مقرّبان وحسب

117
00:08:30,680 --> 00:08:33,830
...كانا سيّداً وخادمته، وصديقان

118
00:08:33,830 --> 00:08:37,780
كالأب وطفله، أو المعلّم وتلميذه

119
00:08:38,760 --> 00:08:42,040
أحببتُ رؤيتهما

120
00:08:42,040 --> 00:08:47,330
...لذا عندما رأيت اهتمامكِ وسموّه ببعضكما

121
00:08:48,830 --> 00:08:51,460
بدا كأنّه القدر

122
00:08:57,070 --> 00:08:59,470
ما الذي كنت أتكلّم عنه من جديد؟

123
00:08:59,870 --> 00:09:02,060
الراهبتان

124
00:09:02,060 --> 00:09:04,290
صحيح

125
00:09:04,290 --> 00:09:09,480
لم أعد أراهما بعد وفاة السيّد

126
00:09:09,480 --> 00:09:13,030
وآخر مرّة رأيتهما فيها، كانتا قد أخذتا شارون معهما

127
00:09:13,030 --> 00:09:17,360
كان الدوق قد لُعِن لتوّه، وكلّ شيء في انهيار

128
00:09:17,630 --> 00:09:21,460
لم أمتلك وقتاً للتفكير بهما

129
00:09:21,460 --> 00:09:24,720
ذلك كلّ ما أعرفه

130
00:09:24,720 --> 00:09:26,380
شكراً لك

131
00:09:27,370 --> 00:09:29,330
سأخبره سموّه أيضاً

132
00:09:30,380 --> 00:09:34,590
سماع صوت البيانو أشعرني برغبة برؤيته

133
00:09:35,670 --> 00:09:37,750
رغم أنّكما سويّاً طوال الوقت؟

134
00:09:37,750 --> 00:09:38,550
أجل

135
00:09:39,350 --> 00:09:41,510
عليك الدخول أيضاً يا روب-سان

136
00:09:41,510 --> 00:09:43,270
فقد يصيبك الزكام

137
00:09:43,970 --> 00:09:45,770
لا، لا تأبهي بي

138
00:09:47,190 --> 00:09:49,370
أودّ مشاهدة هطول المطر

139
00:10:06,370 --> 00:10:08,250
،إذا لم تمتلك مكاناً تذهب له

140
00:10:08,250 --> 00:10:10,580
فتعال للقصر في الغابة الشماليّة

141
00:10:37,300 --> 00:10:39,450
المطر يهطل بغزارة

142
00:10:39,450 --> 00:10:41,320
هل السيرك مغلقٌ اليوم؟

143
00:10:41,320 --> 00:10:41,910
أ-أجل

144
00:10:42,170 --> 00:10:43,660
...موعد عرضنا التالي

145
00:10:44,320 --> 00:10:46,350
أنتِ داليث، صحيح؟

146
00:10:46,350 --> 00:10:47,370
أجل، لمَ؟

147
00:10:47,370 --> 00:10:50,470
أثرتِ كلّ تلك الفوضى حيال
رؤية أحدهم لوجهك

148
00:10:51,010 --> 00:10:52,330
هل انتهى ذلك الأمر؟

149
00:10:52,630 --> 00:10:56,090
أجل، سأكون هكذا من الآن فصاعداً

150
00:10:56,090 --> 00:10:57,520
كم مرّة عليّ ترديد كلامي؟

151
00:10:57,520 --> 00:10:59,550
هذه أوّل مرّة أسمع فيها ذلك

152
00:10:59,550 --> 00:11:01,700
!لكنّكِ جميلة كما يُقال عنك

153
00:11:01,700 --> 00:11:03,720
!قد تكونين من صنفي المفضّل في الواقع

154
00:11:06,690 --> 00:11:09,610
!كلّا! كاف ليست هنا اليوم

155
00:11:10,040 --> 00:11:12,520
لا يبدو الأمر مناسباً دون صراخها عليّ

156
00:11:12,880 --> 00:11:15,400
إذاً؟ ما الذي تريدينه؟

157
00:11:15,400 --> 00:11:18,230
لم تأتي لإلقاء التحيّة وحسب، صحيح؟

158
00:11:18,230 --> 00:11:20,080
أدركتُ أمراً

159
00:11:20,080 --> 00:11:22,760
من الآن فصاعداً، لكن أصدقاءً، لا أعداءً

160
00:11:24,270 --> 00:11:31,150
أدركتُ أنّ مساعدتكم قد تخدمني أيضاً

161
00:11:31,150 --> 00:11:33,330
أجل، لا أعتقد أنّي أصدّق ذلك

162
00:11:33,750 --> 00:11:35,330
عليك ذلك

163
00:11:35,330 --> 00:11:37,550
فقد تفاهمتُ مع الصبيّ سلفاً

164
00:11:38,130 --> 00:11:40,070
تكلّم معه إن كنت تشكّ بي

165
00:11:40,430 --> 00:11:41,780
فهمت

166
00:11:41,780 --> 00:11:44,490
،أنت لئيمة، وتخفين الكثير من الأشياء

167
00:11:44,490 --> 00:11:46,020
لكنّكِ لا تكذبين

168
00:11:46,450 --> 00:11:48,670
إذاً، ما الذي تريدين منّي فعله؟

169
00:11:48,670 --> 00:11:50,260
سأعطيك تلميحاً لليوم وحسب

170
00:11:50,260 --> 00:11:54,010
بدايةً، فلتتعلّم عن أختي الكبرى، شادي

171
00:11:54,010 --> 00:11:55,020
ماذا؟

172
00:11:55,020 --> 00:11:58,200
إن كانت أختك، لمَ لا تخبريني أنتِ؟

173
00:11:58,200 --> 00:11:59,990
ذلك التلميح لن يساعد أبداً

174
00:12:01,280 --> 00:12:02,700
هل نسيت؟

175
00:12:10,410 --> 00:12:11,880
كنتِ تعرفين؟

176
00:12:11,880 --> 00:12:13,250
بالطبع

177
00:12:13,900 --> 00:12:15,880
أبلغ كاف بتحيّتي

178
00:12:16,550 --> 00:12:18,980
أخبرها أنّي سأسامحها على ضربها لي

179
00:12:18,980 --> 00:12:19,840
حـ-حسناً

180
00:12:20,960 --> 00:12:22,880
شادي؟

181
00:12:22,880 --> 00:12:25,550
عليّ الكلام مع كاف عندما ترجع

182
00:12:26,880 --> 00:12:28,560
لا ترين الأمر مريباً؟

183
00:12:29,080 --> 00:12:31,520
...إعداد كعكة

184
00:12:31,520 --> 00:12:34,030
لا أرى مشكلة، ستُسرّ بالتأكيد

185
00:12:34,030 --> 00:12:34,980
حـ-حقّاً؟

186
00:12:35,670 --> 00:12:38,350
!شكراً على قدومكِ يا كاف

187
00:12:38,350 --> 00:12:41,690
!لا داعي، قلتَ أنّه عيد ميلاد أليس الثاني

188
00:12:41,990 --> 00:12:43,950
!سآتي بالطبع

189
00:12:43,950 --> 00:12:46,650
آسف، ذلك ليس دقيقاً

190
00:12:46,650 --> 00:12:48,330
...ليس عيد ميلادها الثاني

191
00:12:48,330 --> 00:12:50,160
!سأرقص لها

192
00:12:51,880 --> 00:12:54,120
هل ستقوم بذلك إلى أن أوقفها؟

193
00:12:54,120 --> 00:12:57,580
!عامان! عامان! عامان

194
00:12:55,050 --> 00:12:55,960
حقّاً؟

195
00:13:02,030 --> 00:13:05,050
!في مكانٍ ما، يقول أحدهم "اثنان" مراراً وتكراراً

196
00:13:06,640 --> 00:13:10,560
أخبرتُها بالقدوم لهذه الغرفة في منتصف الليل

197
00:13:11,130 --> 00:13:14,280
لم أخبرها عن الاحتفال، أو وجودكِ هنا

198
00:13:14,870 --> 00:13:17,170
!آمل أنّها ستكون مفاجأة جميلة

199
00:13:17,170 --> 00:13:17,940
أجل

200
00:13:17,940 --> 00:13:20,850
لكنّه يوم مميّز، صحيح؟

201
00:13:20,850 --> 00:13:23,030
أليس عليّ العودة للبيت الآن؟

202
00:13:23,280 --> 00:13:25,050
لا تقلقي

203
00:13:25,050 --> 00:13:26,530
أنا من دعوتكِ

204
00:13:26,530 --> 00:13:27,730
!سأبقى إذاً

205
00:13:27,730 --> 00:13:30,200
!آمل أن تنجح مفاجأتك

206
00:13:37,850 --> 00:13:38,970
المعذرة

207
00:13:38,970 --> 00:13:39,920
!ها-ها هي

208
00:13:41,230 --> 00:13:42,630
المكان مُظلم

209
00:13:42,850 --> 00:13:45,170
سموّك... وكاف-سان؟

210
00:13:45,170 --> 00:13:46,340
أ-أليس

211
00:13:46,930 --> 00:13:50,550
مضى عامان مُذ أتيتِ للقصر، صحيح؟

212
00:13:50,810 --> 00:13:51,730
...لذا

213
00:13:51,730 --> 00:13:53,420
!يا للكعكة الجميلة

214
00:13:53,420 --> 00:13:56,270
هل قمت بصنعها؟

215
00:13:56,740 --> 00:13:57,740
أجل

216
00:13:57,740 --> 00:13:59,440
شكراً لك

217
00:13:59,440 --> 00:14:03,570
لذا بقيتَ مشغولاً في المطبخ صباح اليوم

218
00:14:03,570 --> 00:14:05,530
لا أضمن لكِ المذاق

219
00:14:06,550 --> 00:14:08,740
إنّها مميّزة جدّاً، لا أظنّ أن بإمكاني أكلها

220
00:14:10,110 --> 00:14:13,070
أليس، شكراً لكِ على كلّ ما فعلتِه
خلال العامين الماضيين

221
00:14:13,070 --> 00:14:15,200
آمل أن تواصلي البقاء معي

222
00:14:15,970 --> 00:14:17,140
...سموّك

223
00:14:20,880 --> 00:14:26,130
...سأشعر بسرورٍ عارم لو استطعت البقاء معك

224
00:14:26,670 --> 00:14:28,220
للأبد أيضاً

225
00:14:32,790 --> 00:14:37,850
جلبت هديّة أيضاً، اخترتُ مع فيولا زيّاً لكِ

226
00:14:37,850 --> 00:14:40,310
يا إلهي، شكراً لكما

227
00:14:40,310 --> 00:14:41,610
جرّبي ارتداءه الآن

228
00:14:41,610 --> 00:14:42,460
!الآن؟

229
00:14:42,460 --> 00:14:44,910
!لـ-لا! أنا موجود هنا

230
00:14:44,910 --> 00:14:45,770
!لا يمكنكِ التغيير

231
00:14:45,770 --> 00:14:47,360
أنا لا أمانع

232
00:14:47,360 --> 00:14:48,700
!أنا أمانع

233
00:14:48,700 --> 00:14:50,550
ذلك مؤسف

234
00:14:50,550 --> 00:14:52,900
هيّا يا أليس، انفخي

235
00:14:53,630 --> 00:14:54,530
!نفخ

236
00:14:54,530 --> 00:14:57,380
!ليس عليّ! بل الكعكة! الكعكة

237
00:14:57,380 --> 00:14:59,790
ويحي، أخطأت

238
00:14:59,790 --> 00:15:02,000
!لا تحاول إخفاء تعمّدها حتّى

239
00:15:05,730 --> 00:15:07,610
أأنت بخيرٍ سموّك؟

240
00:15:08,280 --> 00:15:10,640
لم أحسب لحصول هذا

241
00:15:11,620 --> 00:15:15,020
لا تتحرّكا إلى أن تعتاد أعينكما على الظلام

242
00:15:15,020 --> 00:15:16,930
حاذرا من لمسي

243
00:15:16,930 --> 00:15:17,720
حسناً

244
00:15:17,720 --> 00:15:18,890
مفهوم

245
00:15:20,780 --> 00:15:22,630
ما هذا الصوت؟

246
00:15:23,050 --> 00:15:26,610
بهذا الظلام، أشعر أنّ بإمكاني تغيير ثيابي

247
00:15:27,690 --> 00:15:28,840
أنا أخلع ثيابي الآن

248
00:15:31,700 --> 00:15:34,500
لا أرى، لكنّي أسمع

249
00:15:34,500 --> 00:15:36,050
كاف-سان، نور

250
00:15:36,050 --> 00:15:36,660
بالتأكيد

251
00:15:45,990 --> 00:15:47,130
إنّها زغبيّة جدّاً

252
00:15:47,770 --> 00:15:50,610
!ظريفة! ظريفة! ظريفة جدّاً

253
00:15:50,610 --> 00:15:52,640
!تبدين ظريفة يا أليس

254
00:15:52,640 --> 00:15:54,340
شكراً لكِ

255
00:16:17,000 --> 00:16:18,620
...أدهشني ذلك

256
00:16:19,110 --> 00:16:22,330
لم أتصوّر أن أجد ثقباً في السقف
مع اصطحابي لك لمنزلك

257
00:16:22,330 --> 00:16:24,990
لا بدّ أنّ الألواح في السقف قد تعفّنت

258
00:16:24,990 --> 00:16:27,090
يسرّني أنّ المطر توقّف

259
00:16:27,090 --> 00:16:29,650
!كان اليوم مميّزاً أيضاً

260
00:16:29,650 --> 00:16:32,050
من الآن فصاعداً، فلتنامي في القصر

261
00:16:32,400 --> 00:16:35,730
سأحرص على عدم مقاطعة نومك

262
00:16:35,730 --> 00:16:37,840
لمَ تتصرّفين كأنّنا سننام في السرير نفسه؟

263
00:16:37,840 --> 00:16:39,840
بالمناسبة، هل رأيتما داليث؟

264
00:16:39,840 --> 00:16:41,520
لا، لمَ؟

265
00:16:41,520 --> 00:16:45,230
!أ-أنتِ إحدى فتيات داليث... فتاة الصيحات

266
00:16:46,740 --> 00:16:48,940
!أنا كيتو! أتحكّم بالنباتات

267
00:16:49,290 --> 00:16:53,500
!قرّرتُ نسيان جعلك لكلّ نباتاتي تذبل

268
00:16:53,500 --> 00:16:55,940
فنحن فتيات الصيحة لا نأبه بالتفاصيل الصغيرة

269
00:16:55,940 --> 00:16:57,780
ذ-ذلك رائع

270
00:16:58,210 --> 00:17:00,470
ما الذي أصاب السقف بالمناسبة؟

271
00:17:00,470 --> 00:17:03,250
كنتُ على وشك الخلود للنوم بينما سقط

272
00:17:04,420 --> 00:17:06,330
أعتقد أنّ بإمكاني إصلاحه

273
00:17:06,330 --> 00:17:08,210
دعا الأمر لي

274
00:17:08,210 --> 00:17:09,680
شجرة؟

275
00:17:09,680 --> 00:17:11,510
سيكون هذا خشباً جيّداً

276
00:17:11,510 --> 00:17:13,940
انتظري، ما الذي تفعلينه؟

277
00:17:13,940 --> 00:17:17,050
!سأصنع لها منزلاً جديداً ذاتيّ البناء

278
00:17:17,050 --> 00:17:17,870
يا إلهي

279
00:17:17,870 --> 00:17:18,850
لمَ قد تقومين بذلك؟

280
00:17:18,850 --> 00:17:19,930
في هذا الوقت المتأخّر؟

281
00:17:19,930 --> 00:17:24,250
!كفّ عن طرح الأسئلة! اخرج من هنا

282
00:17:25,520 --> 00:17:26,900
!فتيات الصيحة مخيفات

283
00:17:26,900 --> 00:17:28,230
هوّن عليك

284
00:17:28,230 --> 00:17:30,030
سأصلحه الليلة

285
00:17:30,030 --> 00:17:33,150
اذهبا للنوم في مكانٍ آخر

286
00:17:35,370 --> 00:17:37,320
قد تكون فتاة صالحة

287
00:17:37,700 --> 00:17:39,940
أجل، إنّها صالحة

288
00:17:39,940 --> 00:17:40,780
...لكن

289
00:17:41,020 --> 00:17:43,580
سموّك، أيمكنني أخذ الجانب الأيسر؟

290
00:17:43,580 --> 00:17:45,370
!كما قلت، لن ننام في السرير نفسه

291
00:17:45,370 --> 00:17:46,270
...لكن

292
00:17:46,270 --> 00:17:48,110
فلتنامي على السرير

293
00:17:48,110 --> 00:17:49,670
أنا سأنام على الأرض

294
00:17:49,670 --> 00:17:51,290
!ولا مكان آخر

295
00:17:51,290 --> 00:17:54,010
مضى وقت طويل مذ كنت عنيداً

296
00:17:54,010 --> 00:17:55,690
ذلك ظريفٌ نوعاً ما

297
00:17:59,530 --> 00:18:01,740
الأرض قاسية

298
00:18:02,430 --> 00:18:03,850
...لا يمكنني النوم

299
00:18:09,930 --> 00:18:13,450
هذه الوردة التي أعطيتها إيّاها، صحيح؟

300
00:18:14,870 --> 00:18:16,980
جلبتها معها؟

301
00:18:17,610 --> 00:18:19,740
كأنّه شيء هام

302
00:18:27,930 --> 00:18:29,120
أنا أحبّها

303
00:18:32,450 --> 00:18:35,110
!جلبت لكِ شراباً يا كيتو

304
00:18:35,110 --> 00:18:36,620
أتودّين الاستراحة؟

305
00:18:36,620 --> 00:18:38,760
بدأت لتويّ

306
00:18:48,140 --> 00:18:49,290
أأنتِ بخير؟

307
00:18:49,290 --> 00:18:50,980
!كسرت ظرفاً

308
00:18:50,980 --> 00:18:52,160
ذ-ذلك كلّ شيء؟

309
00:18:52,160 --> 00:18:54,660
لديك أظافر أكريليكيّة طويلة؟

310
00:18:54,660 --> 00:18:56,440
!آسف، لا أعرف ما يكون ذلك

311
00:18:56,730 --> 00:18:59,400
يا إلهي، لم أعد أودّ فعل شيء الآن

312
00:19:02,710 --> 00:19:05,550
حسناً، ستجعلني تيتو أشعر
بشعور أفضل لاحقاً

313
00:19:05,550 --> 00:19:07,910
ليتني أستطيع محاكاة عقل
فتاة الصيحة هذه

314
00:19:11,300 --> 00:19:16,090
تقوم داليث بكلّ ما يسعها للحفاظ على
تماسك المكان بعد رحيل شادي

315
00:19:16,790 --> 00:19:19,110
رغم أنّها لا تمتلك شخصيّة رئيسة

316
00:19:19,470 --> 00:19:22,430
أودّ منها أن تعيش الحياة التي تختارها

317
00:19:22,640 --> 00:19:26,630
،لكنّها أصبحت معجبة بشاب بشريّ، شقيقك

318
00:19:26,630 --> 00:19:28,770
ويراودني شعور مختلط حيال ذلك

319
00:19:30,560 --> 00:19:33,860
أتكره كلّ الساحرات البشر؟

320
00:19:34,530 --> 00:19:39,230
حسناً، مات الكثير من رفاقتنا في
حملات صيد الساحرات القديمة

321
00:19:39,230 --> 00:19:39,820
...لكن

322
00:19:40,230 --> 00:19:42,050
التاريخ يتغيّر

323
00:19:42,050 --> 00:19:45,030
وربما الآن هو ذاك الوقت

324
00:19:45,560 --> 00:19:50,320
نحن لا نمانع مصادقة البشر إن
كانت تلك رغبة داليث

325
00:19:57,000 --> 00:19:58,300
كيف هو؟

326
00:19:58,300 --> 00:20:00,080
!جلبتُ أثاثاً جديداً أيضاً

327
00:20:00,080 --> 00:20:02,250
مذهل، شكراً جزيلاً لكِ

328
00:20:02,250 --> 00:20:03,470
بالكاد أتعرّف عليه

329
00:20:03,970 --> 00:20:06,640
يمكنكِ إقامة حفلات رائعة مع صديقاتكِ هنا

330
00:20:06,640 --> 00:20:10,970
وعندما تفعلين، أريد منكِ دعوة
داليث ودعوتي وصديقتي تيتو أيضاً

331
00:20:10,970 --> 00:20:11,940
أذلك ممكن؟

332
00:20:12,160 --> 00:20:13,570
أجل، بالطبع

333
00:20:13,570 --> 00:20:15,420
!مرحى

334
00:20:18,160 --> 00:20:19,570
سأبدأ من جديد

335
00:20:19,570 --> 00:20:20,990
أجل، شكراً لكِ

336
00:20:22,900 --> 00:20:24,450
أكلتُ كثيراً

337
00:20:24,450 --> 00:20:26,410
إذاً، ما الذي سنأكله تالياً؟

338
00:20:26,410 --> 00:20:28,890
لمَ لا تشارك في مسابقات الأكل تلك؟

339
00:20:30,600 --> 00:20:32,660
مرحباً، أليس هذا أنت يا هوغو؟

340
00:20:34,830 --> 00:20:36,880
من هؤلاء؟

341
00:20:36,880 --> 00:20:38,450
رفاقي القدماء

342
00:20:38,450 --> 00:20:39,530
لنذهب وحسب

343
00:20:39,530 --> 00:20:41,090
أهذا صحيحٌ إذاً؟

344
00:20:41,090 --> 00:20:45,800
انضممت لسيرك غريب وأصبحت
!تتسكّع مع غرباء أطوار

345
00:20:46,230 --> 00:20:50,180
كلّا يا كاف-سان، دعوكِ بغريبة الأطوار

346
00:20:50,180 --> 00:20:51,390
أنت كذلك يا زاين

347
00:20:51,390 --> 00:20:53,890
تفوّهت بكلّ تلك الأشياء
عند ترك لنشل الجيوب

348
00:20:53,890 --> 00:20:56,870
لكن انتهى بك المطاف في سيرك
غريب حيث تلهو طوال اليوم

349
00:20:56,870 --> 00:20:59,050
!ذلك يلائمك تماماً يا هوغو

350
00:20:59,050 --> 00:20:59,570
ماذا؟

351
00:21:00,950 --> 00:21:01,900
!انتظروا

352
00:21:03,230 --> 00:21:04,530
لمَ أوقفتني؟

353
00:21:04,530 --> 00:21:07,110
!كانوا يهينون السيرك

354
00:21:07,110 --> 00:21:09,010
هذا شجار هوغو

355
00:21:09,010 --> 00:21:11,390
دعيه ينهيه

356
00:21:12,360 --> 00:21:14,580
أين ذهبوا؟

357
00:21:23,820 --> 00:21:26,720
أخفتهم قليلاً فحسب

358
00:21:26,720 --> 00:21:29,220
فقد حاولوا سرقة حقيبتي

359
00:21:29,650 --> 00:21:31,680
لا تطلب الشرطة رجاءً

360
00:21:32,260 --> 00:21:34,140
!سحقاً، لنذهب

361
00:21:34,140 --> 00:21:35,650
!ابتعد يا هوغو! وإلّا سأقتلك

362
00:21:37,230 --> 00:21:41,570
قولوا ما تشاؤون عنّي، لكن
!إيّاكم وإهانة السيرك من جديد

363
00:21:43,120 --> 00:21:44,520
!لا نهتمّ

364
00:21:48,030 --> 00:21:50,490
من كانا؟

365
00:21:52,420 --> 00:21:54,310
...لم تكن تمطر

366
00:21:55,010 --> 00:21:57,680
ربما عليّ إخبار زاين وكاف

367
00:23:35,580 --> 00:23:39,200
"الدوق وأليس والمكنسة الطائرة"