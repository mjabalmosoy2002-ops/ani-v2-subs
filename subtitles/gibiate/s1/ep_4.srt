1
00:00:01,960 --> 00:00:04,080
!اسمي فونادا كاثلين

2
00:00:04,920 --> 00:00:07,480
منحني أبي هذا الاسم

3
00:00:08,420 --> 00:00:12,130
كان مُصوّر حروب أمريكيّة

4
00:00:12,880 --> 00:00:15,310
،كان يُسافِر إلى مناطِق الصِّراع لأجلِ العمل

5
00:00:15,310 --> 00:00:17,770
وذات يوم تعرّض لجروح أثناء ذلك

6
00:00:18,760 --> 00:00:23,750
لكن من عالجه آنذاك كانت الطبيبة
!التي أصبحَتْ أمِّي

7
00:00:24,940 --> 00:00:29,960
لكن تُوفِّي أبي عندما كنتُ لا أزال
في سنِّ الرّابعة

8
00:00:31,480 --> 00:00:36,240
كنتُ مُستميتة وشعرتُ وكأنّه كان عليّ
بذل جهد مُضاعَف لتعويضِ حصّته من العمل

9
00:00:36,870 --> 00:00:41,300
كنتُ قد بدأتُ أشعر باليأس نتيجة
كلّ خسائرنا بسببِ الجيبيا

10
00:00:42,570 --> 00:00:43,630
...لكن الآن

11
00:00:44,800 --> 00:00:48,460
،لدينا الآن سينسِي وكينروكو والآخرون

12
00:00:48,460 --> 00:00:50,230
!وهذا يبعث على الطمأنينةِ حقّاً

13
00:00:50,870 --> 00:00:55,110
،بوجودِ سينسِي والآخرين في صفِّنا
!أشعر وكأنّنا يمكننا تجاوز هذه المحنة

14
00:01:13,150 --> 00:01:15,130
!دكتور! هل أنت بخير؟

15
00:01:15,410 --> 00:01:16,300
!آدم

16
00:01:25,130 --> 00:01:29,400
!آدم

17
00:01:37,250 --> 00:01:38,600
!مستحيل؟

18
00:01:42,520 --> 00:01:52,880
أصيبَ برايان بفيروس الجيبيا عندما
تعرّض تلقّى ضربة من الميتيور

19
00:01:58,920 --> 00:02:00,300
...برايان

20
00:03:38,210 --> 00:03:39,990
!مُذهِل

21
00:03:41,970 --> 00:03:43,090
هل هذا...؟

22
00:03:43,740 --> 00:03:46,530
أجل. إنّه شاميسين

23
00:03:46,960 --> 00:03:48,990
وجدتُ واحداً معروضاً

24
00:03:50,040 --> 00:03:54,150
كانَتْ لديّ عادة العزف عليه هكذا
،بعد انتهاء معركة

25
00:03:54,150 --> 00:03:58,720
كعزاءٍ لأرواح الموتى والأسلحة المكسورة

26
00:04:03,600 --> 00:04:04,520
ماذا؟

27
00:04:06,110 --> 00:04:07,320
أمِّي؟

28
00:04:09,080 --> 00:04:10,410
!أمِّي؟

29
00:04:11,270 --> 00:04:12,420
ما الخطب؟

30
00:04:13,010 --> 00:04:14,760
!لا أجد أمِّي

31
00:04:17,270 --> 00:04:19,560
!يوريكا-دونو

32
00:04:17,270 --> 00:04:21,780
!أمِّي

33
00:04:31,440 --> 00:04:32,540
!يوريكا-سان

34
00:04:34,780 --> 00:04:35,790
...أنت

35
00:04:38,010 --> 00:04:41,300
انظر، إنه متحف خاص بالسّاموراي

36
00:04:42,700 --> 00:04:44,790
!هـ-هذا

37
00:04:45,360 --> 00:04:46,800
...لا، مستحيل

38
00:04:48,170 --> 00:04:49,560
معقول...؟

39
00:04:49,940 --> 00:04:51,810
ما الأمر يا سينسِي؟

40
00:04:52,600 --> 00:04:54,060
انظروا هنا

41
00:04:56,560 --> 00:05:00,820
أليس هذا تحوُّلاً مُثيراً للقدَر؟

42
00:05:00,820 --> 00:05:05,320
لم أتصوّر أن أراه مجدّداً في مكانٍ كهذا

43
00:05:06,320 --> 00:05:07,820
...معلِّم

44
00:05:08,460 --> 00:05:10,200
...دوزان

45
00:05:11,330 --> 00:05:14,460
التمَّ شملُنا ثانيةً أخيراً

46
00:05:15,670 --> 00:05:19,960
،عبرت عصوراً كثيرة لتعود إلى يدي

47
00:05:20,640 --> 00:05:22,260
سويغيتسومارو

48
00:05:22,710 --> 00:05:28,090
...لا أصدِّق أنّك أتيت لتجدني هنا، دوزان

49
00:05:28,590 --> 00:05:31,720
أنت صديقي بِحَقّ

50
00:05:32,520 --> 00:05:36,230
تبدوان سعيدين للغاية

51
00:05:37,500 --> 00:05:41,880
هل هذه صدفة؟

52
00:05:48,420 --> 00:05:50,200
هل أنت حامِلُ سِلاحين يا سينسِي؟

53
00:05:51,420 --> 00:05:56,330
أجل. تلقّيتُ الكاتانا الخاص بي
من معلِّمي البربريّ

54
00:05:56,670 --> 00:05:57,960
إنّه سويغيتسومارو

55
00:05:58,780 --> 00:06:04,170
وهذا هالبيرت، اسم مُستمدّ من معلِّمي

56
00:06:04,750 --> 00:06:06,240
،على ذكرِ ذلك يا سينسِي

57
00:06:06,240 --> 00:06:11,720
لطالما شعرتُ أنّك تتحرّك بشكلٍ
غريب جدّاً كساموراي

58
00:06:12,370 --> 00:06:15,470
من ربِحَ في النِّهاية؟

59
00:06:18,000 --> 00:06:19,640
في ذلك الوقت، تعادلنا

60
00:06:21,210 --> 00:06:24,230
!لو استمررنا لكنتُ قد ربِحت

61
00:06:28,760 --> 00:06:30,280
!ما-ماذا؟

62
00:06:35,780 --> 00:06:36,920
!ما الذي يجري؟

63
00:06:40,110 --> 00:06:43,540
!أتيتم أنتم الثلاثة في وقتٍ ممتاز

64
00:06:46,410 --> 00:06:47,910
!سحالٍ؟

65
00:06:48,320 --> 00:06:50,650
!إنّها في كلِّ مكان

66
00:06:51,210 --> 00:06:52,550
!أمِّي

67
00:06:54,050 --> 00:06:55,160
...معلِّم

68
00:07:04,110 --> 00:07:07,570
!لا تتوقّفا! اركضا

69
00:07:08,250 --> 00:07:09,300
!حسناً

70
00:07:23,490 --> 00:07:25,620
!سيحاصروننا بسهولةٍ هنا

71
00:07:25,620 --> 00:07:27,540
!ينبغي أن نخرج

72
00:07:32,070 --> 00:07:33,800
!بسرعة

73
00:07:44,700 --> 00:07:46,060
ما هذا؟

74
00:07:47,910 --> 00:07:50,280
،المطر جعلَتِ المكانَ أكثر ظُلمة

75
00:07:51,680 --> 00:07:54,820
!لذلك هناك كلّ هذا العدد الكبير في الخارج؟

76
00:07:56,250 --> 00:07:58,910
الدكتور والآخرون سيكونون هنا
لمُلاقاتِنا قريباً أيضاً

77
00:08:09,390 --> 00:08:12,670
!ها هو كانزاكي سينسِي

78
00:08:18,830 --> 00:08:20,960
هناك عدد كبير جداً من الطيور

79
00:08:21,910 --> 00:08:23,760
!هذا الظلام مُصيبة

80
00:08:23,760 --> 00:08:25,440
...كاثلين والآخرون قد

81
00:08:26,510 --> 00:08:28,950
هذه الطيور مُتقاربة من بعضِها الآخر
بصورةٍ غير طبيعيّة

82
00:08:29,580 --> 00:08:30,800
!هناك؟

83
00:08:57,470 --> 00:09:01,660
الأدوات التي أنا مُعتادٌ على استخدامِها
!هي الأفضل في التقطيع

84
00:09:10,000 --> 00:09:12,010
!العقوبة الإلهيّة

85
00:09:21,040 --> 00:09:25,080
!دمي يغلي، دوزان

86
00:09:25,750 --> 00:09:27,490
!أنتم مُذهلون جميعاً

87
00:10:09,210 --> 00:10:11,040
!بسرعة يا رِفاق

88
00:10:12,840 --> 00:10:14,560
!دكتور، ها هُم

89
00:10:17,960 --> 00:10:19,120
!كاث

90
00:10:27,660 --> 00:10:29,050
مُذهِل

91
00:10:29,390 --> 00:10:32,080
إذاً هذا هو سينسِي عندما يكون جادّاً

92
00:10:37,400 --> 00:10:39,830
!أمّي، لننزل بسرعة

93
00:10:48,620 --> 00:10:50,170
!كاثلين

94
00:10:58,960 --> 00:11:00,140
!آدم؟

95
00:11:00,680 --> 00:11:01,700
!نعم

96
00:11:02,300 --> 00:11:05,140
!بسرعة! سنخرج من هنا

97
00:11:08,980 --> 00:11:10,450
!اسمعوا جميعاً

98
00:11:10,880 --> 00:11:14,360
!سننطلق مباشرةً نحو المُخيّم

99
00:11:19,450 --> 00:11:21,560
!سينسِي، هل أنت بخير؟

100
00:11:22,750 --> 00:11:23,830
أجل

101
00:11:24,220 --> 00:11:27,230
أنهكتُ نفسي قليلاً فحسب

102
00:11:28,910 --> 00:11:30,120
!اركضوا

103
00:11:34,240 --> 00:11:36,710
!اللّعنة

104
00:12:11,680 --> 00:12:17,210
سينسِي، لا تُجهِد نفسك كثيراً
حتّى لا تؤذي نفسك هكذا

105
00:12:18,190 --> 00:12:20,670
"...تظهر كالنّدى"

106
00:12:21,980 --> 00:12:24,630
لحظة، ماذا بعدها؟

107
00:12:25,680 --> 00:12:28,680
وتتلاشى كالنّدى... هكذا هي حياتي"

108
00:12:29,320 --> 00:12:32,470
".حتّى فخامة نانيوا هي حلمٌ في حلم

109
00:12:32,830 --> 00:12:34,040
!أمِّي

110
00:12:34,710 --> 00:12:37,550
إنّها قصيدةٌ تصِفُ كيف أنَّ الحياة عابِرة كالنّدى

111
00:12:37,550 --> 00:12:43,600
وحالما تنتهي الحياة، تُمسي مجرّد حلم عابر

112
00:12:44,430 --> 00:12:48,200
كانَتْ تِلك قصيدة المُستشار الإمبراطوري، صحيح؟

113
00:12:48,200 --> 00:12:51,250
حلم في حلم

114
00:12:51,700 --> 00:12:54,830
بعد توحيد البلد، لا بدَّ وأنَّ تويوتومي هيديوشي

115
00:12:54,830 --> 00:12:57,800
شعر بالحياةِ العابِرة مع اقترابِ أجله

116
00:12:58,210 --> 00:13:02,210
!متى وحّدَ ذلك القِرد البلاد؟

117
00:13:05,920 --> 00:13:10,370
كان ذلك بعد وفاةِ المُستشار الإمبراطوريّ، أليس كذلك؟

118
00:13:11,520 --> 00:13:13,340
كان ذلك عندما التقيتُك

119
00:13:17,070 --> 00:13:19,310
،بعد توحيدِ البلاد

120
00:13:19,310 --> 00:13:21,720
المُستشار الإمبراطوريّ المُتقاعِد تويوتومي
هيديوشي قد مرِض

121
00:13:21,720 --> 00:13:27,360
،بعد عامٍ من لفظِه أنفاسه الأخيرة

122
00:13:28,090 --> 00:13:32,060
حفّزَت وفاته مجلِس الشُّيوخ لاستدعاء السَّاموراي

123
00:13:32,060 --> 00:13:37,780
المُرسَلين في الغزوتَين الأولى والثّانية إلى كوريا

124
00:13:38,500 --> 00:13:45,010
كانزاكي سينسِي، الذي اكتسب لقبَ
،قاتِل الآلاف" أثناء الغزو الثّاني"

125
00:13:45,010 --> 00:13:48,720
لم يكن مُستثنى وأجبِر على العودةِ إلى الدِّيار

126
00:13:48,720 --> 00:13:51,010
دون حسم الحرب بشكلٍ نهائي

127
00:13:57,560 --> 00:14:00,120
ما هذا؟

128
00:14:01,500 --> 00:14:03,910
ذكِّرني كم أصبح عمر طفلك؟

129
00:14:10,460 --> 00:14:12,060
لم تسقط

130
00:14:12,060 --> 00:14:14,040
نعم، إنَّها موجودة

131
00:14:14,040 --> 00:14:16,930
كم مرّة سوف تتفقّدين؟

132
00:14:16,930 --> 00:14:20,630
أفعل هذا لأنَّك أنت من اشتراها لي

133
00:14:20,630 --> 00:14:22,290
كدليلٍ على زواجِنا

134
00:14:22,780 --> 00:14:25,800
سأشتري لكِ واحدة أفضل حتّى يوماً ما

135
00:14:26,060 --> 00:14:28,140
ليس هنا بيت القصيد

136
00:14:28,140 --> 00:14:30,240
هذه مُميّزةٌ بالنسبةِ لي

137
00:14:30,240 --> 00:14:32,550
تبّاً، أنت لا تفهم

138
00:14:33,740 --> 00:14:35,120
مُخيفة

139
00:15:01,000 --> 00:15:05,520
حامِل سلاحين؟

140
00:15:06,930 --> 00:15:08,160
كينروكو؟

141
00:15:11,530 --> 00:15:14,680
،هكذا كُل من سينسِي وكينروكو

142
00:15:14,680 --> 00:15:20,090
السَّاموراي والنِّينجا اللّذان يحميان
،كاثلين من جيبيا في العصرِ الحديث

143
00:15:20,090 --> 00:15:23,320
التقيا ببعضِهما الآخر

144
00:15:23,840 --> 00:15:26,470
كان ذلك في عام 1600

145
00:15:26,470 --> 00:15:30,190
،المعركة التي ستُحدِّد مصيرَ البلد
،معركة سيكيغاهارا

146
00:15:30,190 --> 00:15:34,100
.كانت تقترِب من نهايتِها بسرعة
توزّعَ خدَمُ تويوتومي

147
00:15:34,100 --> 00:15:37,010
إلى الجيشِ الغربيّ المُتمركِز
،حول إيشيدا ميتسوناري

148
00:15:37,010 --> 00:15:39,500
والجيش الشرقيّ بقيادةِ توكوغاوا إياسو

149
00:15:39,500 --> 00:15:43,380
احتار العديد من خدمِه في تحديدِ
الطرف الذي سيختارونه

150
00:15:43,900 --> 00:15:49,380
،ماتسوموتو جوزين، الرّجل الذي خدمَه سينسِي
كان خادِماً من أولئك الخدَم

151
00:15:49,990 --> 00:15:52,130
!سـ-سينسِي

152
00:15:52,130 --> 00:15:58,640
لا أستطيع حمل نفسي على خيانةِ عشيرة
تويوتومي التي نحن مَدينون لها بالكثير

153
00:15:58,640 --> 00:16:03,140
لكن ألم تعدني أن تقِف في صفِّ وزير الداخليّة؟

154
00:16:03,740 --> 00:16:05,910
...أ-أعلم أنَّني فعلت، لكن

155
00:16:05,910 --> 00:16:11,650
لا أتصوّر أنَّ يخسر الجيشُ الغربيّ
هذه المعركة المُقبِلة

156
00:16:12,120 --> 00:16:14,360
،إذا اختفى توكوغاوا-دونو عن هذا العالم أيضاً

157
00:16:14,360 --> 00:16:17,550
فلن يكون ذلك الوعد قيّماً، صحيح؟

158
00:16:17,550 --> 00:16:20,160
حينئذ سوف نصطفُّ مع الجيشِ
الغربيّ، أليس كذلك؟

159
00:16:20,160 --> 00:16:22,430
...أ-أجل

160
00:16:22,430 --> 00:16:27,670
إن كان كذلك فيجب علينا إبلاغ توكوغاوا هيديتادا-دونو

161
00:16:27,670 --> 00:16:29,500
!ا-انتظر يا سينسِي

162
00:16:29,500 --> 00:16:32,620
إذا أخبرناه أنَّنا لن نتمكَّن من الانضمامِ له

163
00:16:32,620 --> 00:16:34,180
...بعد التأخُّر عنه هذه الفترة الطويلة

164
00:16:35,180 --> 00:16:37,270
لكن إذا وقفنا في صفِّ الجيش الغربيّ

165
00:16:37,270 --> 00:16:40,460
وأخبرناهم أنَّنا لن نتمكَّن من المُشاركة
،في حِصارِ قلعة أويدا

166
00:16:40,460 --> 00:16:42,930
فسنُعَدُّ خوَنة

167
00:16:42,930 --> 00:16:45,850
وأيضاً ما لم نُرسِل مبعوثاً على حصانٍ سريع

168
00:16:45,850 --> 00:16:49,950
إلى سانادا ماسايوكي في قلعةِ أويدا
!حالاً، فلن يفعلوها في الوقت

169
00:16:49,950 --> 00:16:53,220
...أ-أعلم ذلك! أعلم ذلك، لكن

170
00:16:56,950 --> 00:17:03,500
،الابن الثّالِث لتوكوغاوا إياسو، توكوغاوا هيديتادا

171
00:17:03,500 --> 00:17:06,340
قادَ جيشاً من إيدو على امتدادِ ناكاسيندو
لإخضاع شينا-نو-كوني

172
00:17:06,680 --> 00:17:09,620
،كانَتْ إحدى أهدافهم إسقاط قلعة أويدا

173
00:17:09,620 --> 00:17:12,160
قلعة عائلة سانادا التي وقفَتْ
في صفِّ الجيش الغربيّ

174
00:17:12,780 --> 00:17:18,520
في ذلك الوقت، كان جوزين قد وعدَ
بالانضمامِ لإياسو والجيش الشرقيّ

175
00:17:18,520 --> 00:17:23,050
قوّاته، بقيادةِ سينسِي، كانَتْ مُتمركِزة
بالقربِ من قلعةِ أويدا

176
00:17:23,050 --> 00:17:26,160
للانضمامِ لصفوف قوّات هيديتادا

177
00:17:28,730 --> 00:17:30,860
!ا-العدوّ هو الجيشُ الشرقيّ

178
00:17:30,860 --> 00:17:33,490
!لـ-لا، ا-الجيش الغربيّ

179
00:17:36,240 --> 00:17:40,220
مولاي! العدوُّ هو بالفعل الجيش
!الغربيّ إذاً؟

180
00:17:40,220 --> 00:17:41,990
!هل أنت متأكِّد؟

181
00:17:47,470 --> 00:17:48,610
!كما تشاء

182
00:17:54,220 --> 00:17:59,830
سنتبع الآن جيشَ توكوغاوا-دونو
!ونزحف نحو قلعة أويدا

183
00:18:00,220 --> 00:18:01,760
!عدوُّنا هو الجيشُ الغربيّ

184
00:18:01,760 --> 00:18:04,780
!تذكَّر الجيش الغربيّ

185
00:18:06,820 --> 00:18:09,770
!إلى كافّة الوحدات، انطلقوا

186
00:18:11,520 --> 00:18:16,710
في هذا العصر، أهمّ شيء بالنسبة للدايميو
،لم يكن الواجب أو الإنسانيّة

187
00:18:16,710 --> 00:18:18,380
إنَّما السّمعة

188
00:18:18,380 --> 00:18:24,770
كان السَّاموراي مُجبرين على المُخاطرة
بأرواحهم في معركة لحفظِ ماء الوجه

189
00:18:25,200 --> 00:18:31,040
والآن، أيّاً من الجيشين يربح، سنُعَدُّ خوَنة

190
00:18:47,360 --> 00:18:48,810
...هذا

191
00:18:54,820 --> 00:18:57,420
!هذا هو ذلك الرّجل

192
00:18:58,410 --> 00:19:02,100
يُقاتِل بأسلوب مُثير

193
00:19:02,100 --> 00:19:06,120
إذاً هذا هو حامِل السِّلاحين قاتِل الآلاف

194
00:19:07,450 --> 00:19:10,030
،أثناء حِصار قلعة أويدا

195
00:19:10,030 --> 00:19:12,730
جاهدَ المُهاجِمون لكسرِ دِفاعات
قلعة أويدا المتينة

196
00:19:12,730 --> 00:19:16,580
وأمِرَ هيديتادا بالزّحف

197
00:19:16,580 --> 00:19:19,600
قبل أن يتمّ التوصُّل لقرار رسميّ

198
00:19:20,270 --> 00:19:23,700
،سارع هيديتادا نحو سيكيغاهارا

199
00:19:23,700 --> 00:19:25,650
لكن لم يصِل في الوقتِ لأجلِ المعركة الرئيسيّة

200
00:19:25,650 --> 00:19:28,550
ممّا سبّب غضب إياسو منه

201
00:19:32,960 --> 00:19:35,360
،لعلَّنا لم نربح المعركة

202
00:19:35,360 --> 00:19:39,630
لكن سيتذكّرنا هيديتادا-دونو بصورةٍ إيجابيّة

203
00:19:40,950 --> 00:19:43,840
لا... لا فُرصة لذلك

204
00:19:44,470 --> 00:19:48,160
،سارع هيديتادا-دونو إلى سيكيغاهارا

205
00:19:48,570 --> 00:19:50,920
...لكنّه تركنا مُتأهّبين بمفردنا عند القلعة

206
00:19:51,570 --> 00:19:55,220
سيُلقى اللّوم على تأخِّرِنا هذه المرّة

207
00:20:01,070 --> 00:20:02,300
!ماذا؟

208
00:20:14,810 --> 00:20:17,600
!اسمي سانادا كينروكو

209
00:20:17,600 --> 00:20:21,110
،لعلَّ المعركة انتهَتْ قبل أوانها

210
00:20:21,110 --> 00:20:23,090
،لكن إذا وقفتم في صفِّ الجيش الشرقيّ

211
00:20:23,090 --> 00:20:28,630
!فأرغب إذاً في مُبارزة قاتِل الآلاف الشهير

212
00:20:39,980 --> 00:20:43,550
تبّاً، حامِل سِلاحين وقويّ

213
00:20:44,580 --> 00:20:47,130
يا له من ساموراي غير عاديّ

214
00:20:47,910 --> 00:20:53,060
سَيفي هو مزيجٌ من روحِ ساموراي ومهارات بربريّ

215
00:20:53,060 --> 00:20:57,060
سيقطِّع الكاتانا الخاص بي لحمَك
!بينما يقطِّع سيفي عِظامَك

216
00:20:57,500 --> 00:21:00,070
!اسمي كانزاكي سينسِي

217
00:21:10,270 --> 00:21:11,450
تفاداها؟

218
00:21:11,970 --> 00:21:13,000
هذا لا يُصدَّق

219
00:21:13,490 --> 00:21:15,930
لم أتوقّع تِلك الضربة العموديّة

220
00:21:15,930 --> 00:21:17,910
أنت مُذهل

221
00:21:30,860 --> 00:21:33,390
كانزاكي سينسِي، قاتِل الآلاف

222
00:21:33,390 --> 00:21:36,940
هكذا إذاً. أنت قويّ

223
00:21:36,940 --> 00:21:40,650
إذا استمررنا أكثر، فلا أحد منّا
سيرحل سليماً

224
00:21:40,650 --> 00:21:43,330
!سنعيد هذه المُبارزة في المرّة المُقبِلة

225
00:21:43,330 --> 00:21:46,710
!قد نرى بعضنا الآخر من جديد إذا نجونا

226
00:21:47,200 --> 00:21:48,150
!الوداع

227
00:21:50,030 --> 00:21:54,250
سانادا كينروكو إذاً

228
00:22:05,070 --> 00:22:06,260
!برايان

229
00:22:11,720 --> 00:22:12,730
!يا للهول

230
00:22:18,360 --> 00:22:20,220
!ماذا حدث؟

231
00:22:20,220 --> 00:22:22,110
!لقد توقّفنا

232
00:22:26,910 --> 00:22:30,110
!سمِعَ الجيبيا صوت الإطار المثقوب

233
00:22:32,300 --> 00:22:36,270
!ينهالون علينا الواحد تلو الآخر بلا نهاية

234
00:22:39,210 --> 00:22:40,730
حسناً

235
00:22:41,420 --> 00:22:44,320
الحظّ يقِف ضدّنا كلينا، صحيح؟

236
00:22:45,340 --> 00:22:46,630
معك حقّ

237
00:22:53,640 --> 00:22:57,540
لا يزال سينسِي يرتاح

238
00:22:58,100 --> 00:23:01,440
أظنّنا علينا تولّي أمر الطيور

239
00:23:05,140 --> 00:23:06,100
!ما هذا؟

240
00:23:13,700 --> 00:23:16,450
!ماذا؟ ما خطب هذه السَّحالي؟

241
00:23:21,180 --> 00:23:26,000
أعتقد قد نموت جميعاً هنا