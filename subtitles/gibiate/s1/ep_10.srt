1
00:00:01,310 --> 00:00:02,980
!حسناً، نقوم بالتسجيل الآن

2
00:00:06,650 --> 00:00:08,870
عمّاذا ينبغي أن أتحدّث؟

3
00:00:09,540 --> 00:00:12,340
عن سبب زجّك في السجن ربّما؟

4
00:00:16,520 --> 00:00:22,870
كنتُ رياضيّاً تمّ اختياره كمُرشّح في الأولمبياد

5
00:00:24,130 --> 00:00:25,760
مذهل

6
00:00:26,760 --> 00:00:29,610
كانت رياضة القفز بالزانة في ألعاب القوى

7
00:00:29,610 --> 00:00:32,180
كنتُ حقّاً أبلي حسناً

8
00:00:32,770 --> 00:00:38,700
لكن ذات يوم، خرج مُسلّح فجأة
وحاول قتل حبيبتي

9
00:00:39,470 --> 00:00:42,950
لاحقتُه وأوسعتُه ضرباً بسببِ ما فعله

10
00:00:43,330 --> 00:00:45,640
،فماتَ أثناء ذلك

11
00:00:46,270 --> 00:00:48,660
ثمّ تمَّ اعتقالي

12
00:00:49,750 --> 00:00:51,500
سلاحي؟

13
00:00:51,920 --> 00:00:54,460
صنعتُ رمحي بنفسي

14
00:00:55,530 --> 00:01:01,330
يمكنني استخدام هذا الرّمح للقفز
به والهجوم أيضاً

15
00:01:02,110 --> 00:01:03,300
!حسناً، التّالي

16
00:01:03,300 --> 00:01:04,410
!صيّاد سمك

17
00:01:07,280 --> 00:01:09,730
كنتُ صيّاد سمك

18
00:01:10,330 --> 00:01:14,360
تشاجرتُ مع زملائي في صيدِ السّمك
،وقتلتُ واحداً عن طريق الخطأ

19
00:01:14,360 --> 00:01:16,860
فتمّ الزجّ بي في السّجن

20
00:01:18,570 --> 00:01:21,600
يمكنني رمي شبكات للإمساك بالجيبيا

21
00:01:22,010 --> 00:01:24,720
أو تعليقهم على سنّارة صيدي

22
00:01:24,720 --> 00:01:26,230
يمكنني استخدام سيف أيضاً

23
00:01:26,880 --> 00:01:32,360
!أ-أنا مـ-محترف! محترف في استخدام المتفجِّرات

24
00:01:33,190 --> 00:01:38,160
يـ-يمكنني رمي القنابل بعيداً باستخدام
!سنّارة صيد هذا الرجل أيضاً

25
00:01:38,600 --> 00:01:41,850
مـ-من الصّعب صناعة قنابل بمفردي الآن

26
00:01:41,850 --> 00:01:46,300
نظراً لقلّة المكوّنات المتوفِّرة في العالم

27
00:01:47,370 --> 00:01:49,890
لـ-لماذا اعتُقِلت؟

28
00:01:50,470 --> 00:01:57,360
صـ-صنعتُ قنبلةً للردِّ على حكومتنا المروِّعة

29
00:01:57,360 --> 00:02:00,500
!فأفشى عنها شخص ما

30
00:03:39,070 --> 00:03:42,490
ما هذا؟

31
00:03:44,210 --> 00:03:47,620
هذه قلعة ضخمة

32
00:03:51,700 --> 00:03:53,450
أهذه وجهتُنا؟

33
00:03:54,860 --> 00:03:55,680
أجل

34
00:03:56,310 --> 00:03:59,760
حالما ننعطِف هنا، يصبِح مركز البحث أمامنا

35
00:04:15,640 --> 00:04:16,850
...هذا

36
00:04:21,230 --> 00:04:25,360
!اللّعنة، هناك جيبيا في كلِّ مكان

37
00:04:26,440 --> 00:04:28,380
كنّا نتوقّع هذا

38
00:04:29,070 --> 00:04:32,750
سيزداد الدّخول بعد حلول اللّيل صعوبة

39
00:04:34,030 --> 00:04:35,670
يجب علينا أن نشقَّ طريقنا بالقوّة

40
00:04:36,790 --> 00:04:40,300
هناك الكثير مِمَّن لا يتأثّرون بسيفي كذلك

41
00:04:41,330 --> 00:04:43,720
ربّما ينبغي أن ننسحِب الآن ونعود لاحقاً؟

42
00:04:44,670 --> 00:04:46,540
...دعونا ألّا ندخل الآن

43
00:04:50,790 --> 00:04:54,770
لكن لا بدَّ أن ندخل في النِّهاية بطريقة أو بأخرى

44
00:04:56,390 --> 00:04:59,820
لن يأتي أحدٌ ويساعدنا حتّى لو انتظرنا

45
00:05:00,350 --> 00:05:01,480
هيّا بنا

46
00:05:02,370 --> 00:05:08,950
رغم أنّنا قد نُباد جميعاً أثناء مُحاولتنا
مقاتلة هذا العدد الكبير من الجيبيا

47
00:05:23,820 --> 00:05:25,060
سينسِي

48
00:05:26,820 --> 00:05:30,290
،لم يعُد العجوز معنا

49
00:05:34,350 --> 00:05:37,250
لكن سأدعمك

50
00:05:38,950 --> 00:05:41,990
تعوّدنا أن نخوض معارِك غير عادِلة معاً، صحيح؟

51
00:05:45,120 --> 00:05:46,040
ماذا؟

52
00:05:50,560 --> 00:05:51,910
معك حقّ

53
00:05:52,550 --> 00:05:55,950
سأضع حياتي بين يديك

54
00:05:57,750 --> 00:06:00,300
لن أدع أحداً آخر يموت

55
00:06:01,490 --> 00:06:05,210
!ولو كلّفَني ذلك حياتي

56
00:06:21,260 --> 00:06:23,830
أولئك من جديد؟

57
00:06:23,830 --> 00:06:27,680
والدك لا يتعلّم أبداً، صحيح؟

58
00:06:29,240 --> 00:06:31,020
!في وقتٍ كهذا؟

59
00:06:31,670 --> 00:06:33,700
!هذه المرّة سأكون أنا من ينال منه

60
00:06:39,970 --> 00:06:41,550
لا خيار آخر

61
00:06:41,550 --> 00:06:43,800
سأتعامل مع الجيبيا بنفسي

62
00:06:44,810 --> 00:06:46,950
بينما أنتما تولّيا أمرهم

63
00:06:46,950 --> 00:06:50,050
!عليكم بهم جميعاً

64
00:06:56,850 --> 00:06:58,280
...مستحيل

65
00:06:59,050 --> 00:07:04,870
لمَ على الناس أن يهاجموا بعضهم
!الآخر بعد كلِّ هذا؟

66
00:07:33,470 --> 00:07:35,220
!هـ-ها أنا ذا

67
00:07:39,980 --> 00:07:41,370
!ماذا؟

68
00:07:41,370 --> 00:07:44,360
!ماذا يعتقدون أنّهم يفعلون؟

69
00:07:44,360 --> 00:07:48,640
نحن مَدينون لكم جميعاً بأرواحنا

70
00:07:50,160 --> 00:07:54,590
،من المُخالِف لمبادئنا ألّا نردّ ذلك الدَّين

71
00:07:55,750 --> 00:07:58,210
لِذا أتينا لتقديمِ المساعدة

72
00:08:23,590 --> 00:08:24,640
!هيّا بنا

73
00:08:25,210 --> 00:08:26,010
!نعم

74
00:08:27,000 --> 00:08:28,090
!سينسِي

75
00:08:28,090 --> 00:08:28,980
!نعم

76
00:09:07,220 --> 00:09:08,200
!مرحى

77
00:09:18,890 --> 00:09:22,860
!ماذا؟! إنّهم أقوياء

78
00:09:23,160 --> 00:09:25,210
!هيّا بنا يا كينروكو

79
00:09:25,210 --> 00:09:25,910
!حسناً

80
00:09:43,980 --> 00:09:46,400
!هل أنت بخير يا طبيب؟

81
00:09:46,870 --> 00:09:47,780
أجل

82
00:10:10,050 --> 00:10:11,240
!غورين

83
00:10:11,840 --> 00:10:13,170
!تعال

84
00:10:16,040 --> 00:10:18,680
!أعلم يا زعيم

85
00:10:27,510 --> 00:10:29,440
!خذوا هذه

86
00:11:08,340 --> 00:11:10,120
كيف جرحك؟

87
00:11:10,780 --> 00:11:17,170
ما زال من المبكّر جدّاً أن أورِّط الصِّغار معي

88
00:11:18,290 --> 00:11:20,060
هذا مجرّد خدش

89
00:11:20,060 --> 00:11:22,210
لا يؤلم البتّة

90
00:11:24,850 --> 00:11:28,160
مساعدتكم قد أنقذَتْنا

91
00:11:35,500 --> 00:11:38,420
،إذا احتجت شخصاً مثلي

92
00:11:38,420 --> 00:11:41,130
فسأقدِّم قدر ما تحتاج من مُساعدة

93
00:11:41,630 --> 00:11:45,220
أينما يذهب الزعيم، يتبعه رِجاله

94
00:11:45,850 --> 00:11:49,600
آمل أن ننسجم معاً جميعاً يا ساموراي-سان

95
00:11:57,460 --> 00:11:59,240
!أنا مسرورةٌ للغاية

96
00:11:59,600 --> 00:12:01,960
!هذه أنباء سارّة

97
00:12:01,960 --> 00:12:03,670
أليس كذلك يا أيامي؟

98
00:12:04,240 --> 00:12:07,240
!يبدو أنَّنا سنحظى بساكي لذيذ اللّيلة

99
00:12:19,510 --> 00:12:21,920
قطعتُ هذا الشوط أخيراً

100
00:12:54,120 --> 00:12:57,070
نُطلِق على تِلك المخلوقات اسم جيبيا

101
00:12:57,070 --> 00:12:58,950
كانوا بشراً

102
00:12:59,670 --> 00:13:02,010
،حالما تُصاب بسمِّ جيبيا

103
00:13:02,010 --> 00:13:05,080
فإنَّ الخلايا في جسدِك تبدأ بالتّناسخ
،بصورةٍ غير عاديّة

104
00:13:05,080 --> 00:13:07,830
لتعدِّل الصبغيّات البشريّة

105
00:13:07,830 --> 00:13:10,220
وتسبِّب تحوُّلاً إلى هيئةٍ وحشيّة

106
00:13:10,710 --> 00:13:14,090
،لِهذا نحن نبحث عن عِلاجٍ الآن

107
00:13:14,420 --> 00:13:17,730
عقّار لإعادةِ الجيبيا إلى بشر

108
00:13:19,330 --> 00:13:27,920
أجل، سوف أكمِل اللُّقاح لإعادة
!الجيبيا إلى بشر

109
00:13:33,810 --> 00:13:36,680
...شارفتُ على ذلك

110
00:13:39,880 --> 00:13:41,690
!...هذا

111
00:13:42,230 --> 00:13:44,790
كاتسو كاري

112
00:13:44,790 --> 00:13:46,780
ثانية؟

113
00:13:46,780 --> 00:13:47,970
ثانية

114
00:13:47,970 --> 00:13:51,210
!كـ-كاتسو كاري لذيذ حقّاً

115
00:13:51,210 --> 00:13:52,570
تبّاً

116
00:13:56,900 --> 00:14:00,340
ليت العجوز يستطيع أن يأكل منه أيضاً

117
00:14:00,900 --> 00:14:01,730
أجل

118
00:14:03,500 --> 00:14:05,020
...يوكينوجيو-سان

119
00:14:05,850 --> 00:14:08,660
...لحظة، هذا اللّحم

120
00:14:09,550 --> 00:14:11,900
!أجل! إنّه لذيذ

121
00:14:13,090 --> 00:14:14,410
ما الخطب؟

122
00:14:16,310 --> 00:14:20,380
قد يبدو سيّئاً، لكن يمنحكم بعض الطاقة

123
00:14:20,710 --> 00:14:25,760
إ-إنّه من المقصف هنا، لذا فهو آمن

124
00:14:25,760 --> 00:14:28,010
إنّه ليس لحمهم

125
00:14:28,850 --> 00:14:30,680
بالطبع ليس كذلك

126
00:14:31,790 --> 00:14:34,040
أجل، لا بأس به

127
00:14:35,040 --> 00:14:36,560
هذا لاذع

128
00:14:36,560 --> 00:14:38,710
أي نوع من التّوابل هو هذا

129
00:14:38,710 --> 00:14:41,780
ليس دايكون ولا واسابي

130
00:14:42,110 --> 00:14:44,620
إ-إنّه مسحوق الكاري

131
00:14:45,010 --> 00:14:49,380
هناك بعض التّوابل التي يُمكن ا-استخدامها
كدواء تُخلَط معه كذلك

132
00:14:49,380 --> 00:14:50,650
...دواء

133
00:14:51,720 --> 00:14:54,960
،هناك أنواع كثيرة من الأدوية في عصرِنا

134
00:14:55,290 --> 00:14:58,240
لكن كانوا قديماً يستخدمون هذا بدلاً من ذلك

135
00:14:59,000 --> 00:15:01,000
...هذا صحيح

136
00:15:01,000 --> 00:15:05,670
لكن لكاتسو كاري هذا معنى مختلف بالنسبة لي

137
00:15:06,170 --> 00:15:07,650
ماذا تقصد؟

138
00:15:10,280 --> 00:15:12,670
يُمكِن استخدامه أيضاً للتخلُّص من التردُّد

139
00:15:12,670 --> 00:15:16,670
"!بالقول "بواسطةِ هذا الكاتسو، سوف أربح

140
00:15:17,350 --> 00:15:19,640
ماذا؟ تشابه لفظي؟

141
00:15:21,960 --> 00:15:26,300
عندما كنتُ صغيراً، كان هناك مطعماً

142
00:15:26,300 --> 00:15:30,660
نائياً في واسيدا يقدّم كاتسو كاري لذيذاً

143
00:15:31,150 --> 00:15:34,820
كنتُ أذهب إلى هناك رفقة أمّكِ بين الفيِّنة والأخرى

144
00:15:38,560 --> 00:15:42,870
منذ ذلك الحين، يُصيبني الحنين كلّما أكلتُ كاتسو كاري

145
00:15:45,580 --> 00:15:51,220
ساكوما هنا، كان في البدايةِ كلّ ما يستطيع
،فعله هو صنع القنابل

146
00:15:51,220 --> 00:15:55,670
لكن تعلّمَ أن يصنع كاتسو كاري بهذه اللذّة

147
00:15:55,670 --> 00:15:59,890
أوّل كاتسو كاري حضّره كان مذاقه
،سيّئاً للغاية

148
00:15:59,890 --> 00:16:03,190
لكن باتت النّكهة ممتازة مؤخّراً

149
00:16:04,290 --> 00:16:07,340
تعلّم إعداد وجبات أخرى أيضاً

150
00:16:11,180 --> 00:16:16,640
حسناً، يمكننا أن نأكل حتّى الإشباع ونستعيد
!طاقتنا، لذا ليسَتْ لديّ أي شكوى

151
00:16:17,350 --> 00:16:20,830
!لن نخسر أمام الجيبيا الحمقى

152
00:16:21,480 --> 00:16:22,750
أليس كذلك يا طبيب؟

153
00:16:23,640 --> 00:16:25,500
ماذا؟ أين الطبيب؟

154
00:16:26,220 --> 00:16:29,120
ما زال يعمل على بحثِه

155
00:16:30,290 --> 00:16:33,590
سأذهب إليه وأعطيه وجبة كاتسو كاري خاصّته

156
00:16:37,540 --> 00:16:39,660
أجل، هذا لذيذ

157
00:16:39,660 --> 00:16:41,000
!يسرّني ذلك

158
00:16:41,000 --> 00:16:43,300
!إنّه طبق ساكوما-سان الأفضل

159
00:16:44,610 --> 00:16:48,110
يبدو أنّ الغاليانت كانوا يأكلون
،الكاتسو كاري يوميّاً

160
00:16:48,110 --> 00:16:52,240
لكن رغم أنّهم اشتكوا جميعاً، أكلوه بكلِّ سرور

161
00:16:52,770 --> 00:16:54,380
هكذا إذاً

162
00:16:54,760 --> 00:16:57,260
تناول هذا يوميّاً أمر قاسٍ

163
00:16:58,690 --> 00:17:01,640
ما أخبار اللُّقاح يا طبيب؟

164
00:17:02,440 --> 00:17:04,410
بقي القليل فقط على ما أعتقد

165
00:17:05,700 --> 00:17:10,440
ظننتُ أنَّني لن أتمكّن من صنع اللُّقاح

166
00:17:10,440 --> 00:17:15,930
حتّى رحتُ إلى البندقيّة واستخرجتُ
،المُضادّات الحيويّة من المريض صفر

167
00:17:16,570 --> 00:17:19,000
لكن بفضلِ سينسِي والآخرين

168
00:17:19,000 --> 00:17:22,100
تمكّنتُ من زرع تركيزٍ عالٍ من الفيروس

169
00:17:22,580 --> 00:17:25,090
إذاً تستخدمه لصنعِ اللُّقاح؟

170
00:17:26,620 --> 00:17:30,900
لو كنّا نمتلكه لما كانَتْ أمِّي قد ماتت

171
00:17:33,650 --> 00:17:34,800
...يا طبيب

172
00:17:36,020 --> 00:17:39,120
!اِحرص على إكمالِ اللُّقاح أرجوك

173
00:17:39,610 --> 00:17:41,500
!أنا مؤمنةٌ بك

174
00:17:42,630 --> 00:17:44,620
!يمكننا استعادة العالم كلّه

175
00:17:50,280 --> 00:17:53,300
استعادة العالم كلّه

176
00:18:00,620 --> 00:18:02,950
!اشتعلت، اشتعلت

177
00:18:02,950 --> 00:18:05,350
!أحسنت

178
00:18:05,850 --> 00:18:08,940
!مـ-ما رأيكم بذلك

179
00:18:09,390 --> 00:18:14,820
!كـ-كانَتْ هناك مولِّدة، لذا عـ-عملتُ على تشغيلِها

180
00:18:15,430 --> 00:18:20,110
!بوجودِ هذه الإضاءة، لن يقترب الجيبيا منّا أيضاً

181
00:18:27,640 --> 00:18:28,700
!وجدتُها

182
00:18:29,580 --> 00:18:34,190
!بما أنَّ الفُرصة مُتاحة، لنجرِ مُقابلات

183
00:18:36,020 --> 00:18:40,630
لم أتوقّع أبداً أن أشارك ساكي
مع شخصٍ في هذا العصر

184
00:18:41,760 --> 00:18:43,890
هذا أوكي، ساكي فاخر

185
00:18:44,310 --> 00:18:47,490
،من الصّعب جدّاً الحصول عليه في هذه الأيّام

186
00:18:48,150 --> 00:18:51,850
هذا حقّاً أفضل من السّاكي قديماً

187
00:18:53,430 --> 00:18:55,690
أنا متحمِّس إذاً

188
00:18:58,190 --> 00:19:02,520
بصراحة، أنا مسرورٌ لأنّني لم أضطرّ لمُقاتلتك

189
00:19:04,820 --> 00:19:06,450
أنا أيضاً

190
00:19:06,450 --> 00:19:07,840
أجل

191
00:19:07,840 --> 00:19:10,170
!أردتُ مُحاولة مُقاتلته

192
00:19:11,140 --> 00:19:14,710
أنت بارع في الآلات، أليس كذلك؟

193
00:19:14,710 --> 00:19:19,050
هـ-هذا ليس بالأمر الجلل. إنّها هواية فحسب

194
00:19:19,360 --> 00:19:24,420
بالمناسبة، هل ذلك الدّيناميت مُدهش إلى هذا الحدّ؟

195
00:19:24,420 --> 00:19:25,450
!أجل

196
00:19:25,450 --> 00:19:29,480
مـ-مـ-من بين كلّ المتفجِّرات، كـ-كان
!اختراع القرن

197
00:19:36,550 --> 00:19:38,990
حقّاً؟

198
00:19:39,850 --> 00:19:43,070
لـ-لـ-لكن مات كثير من النّاس

199
00:19:43,360 --> 00:19:48,240
،ما بين القنابل والطبخ

200
00:19:48,240 --> 00:19:50,500
أنت مدهش حقّاً

201
00:19:52,540 --> 00:20:00,530
فـ-في الواقع، حالما أدركتُ أنّ مسحوق
،الكاري كان شبيهاً بالبارود

202
00:20:00,530 --> 00:20:03,250
تشجّعتُ على تجربتِه

203
00:20:03,250 --> 00:20:07,020
البارود ومسحوق الكاري مُتشابِهان؟

204
00:20:07,460 --> 00:20:10,310
!أنت مُدهش حقّاً

205
00:20:10,640 --> 00:20:15,480
بالمناسبة، هل يمكنك أن تحدّثني
أكثر عن القنابل؟

206
00:20:16,650 --> 00:20:17,820
!بالتأكيد

207
00:20:17,820 --> 00:20:22,480
،لـ-لديّ الكثير منها في سيّارتِنا

208
00:20:22,480 --> 00:20:24,360
لـ-لذا سأريك لاحقاً

209
00:20:24,360 --> 00:20:25,330
!أجل

210
00:20:26,910 --> 00:20:28,990
أنا آسف

211
00:20:29,370 --> 00:20:34,670
ظننتُ أنَّ أمّكِ أخذَتْكِ معها
وعدتما إلى الصّين

212
00:20:35,710 --> 00:20:39,750
بقيَتْ في اليابان على أمل أن تراك
تعود للطريقِ المُستقيم

213
00:20:40,190 --> 00:20:42,700
لكن ماتَتْ قبل أن تحظى بتِلك الفُرصة

214
00:20:56,330 --> 00:20:59,030
،بعد بقائي في الياكوزا لفترةٍ طويلة

215
00:20:59,030 --> 00:21:05,250
كانت السّرِقة من البشر أسهل
من السّرقة من الوحوش

216
00:21:06,990 --> 00:21:11,140
ما قلتِه لي قبل أيّام جعلَني أصحو

217
00:21:12,350 --> 00:21:14,300
،إن كنتِ راغِبة في مُسامحتي

218
00:21:14,300 --> 00:21:17,400
أريد إمضاء الوقت المُتبقِّي لي لأجلكِ

219
00:21:20,050 --> 00:21:22,630
لن أتمكّن من مُسامحتك فوراً

220
00:21:25,400 --> 00:21:28,440
حسناً، ما دمنا معاً

221
00:21:28,440 --> 00:21:30,720
أنا متأكّدٌ أنّنا سنتفاهم في النّهاية

222
00:21:31,260 --> 00:21:35,150
فأساساً، نحن أبٌ وابنته

223
00:21:48,100 --> 00:21:50,490
أعتقِد هذه هي نهايةُ رحلتنا

224
00:21:57,960 --> 00:22:02,240
جمعتُ ما يكفي من عيِّنات

225
00:22:46,720 --> 00:22:47,820
!كينروكو

226
00:22:50,350 --> 00:22:51,730
أوكوني