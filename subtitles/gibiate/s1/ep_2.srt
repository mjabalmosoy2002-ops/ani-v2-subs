1
00:00:02,220 --> 00:00:03,690
ينبغي لهذا أن يفي بالغرض

2
00:00:04,700 --> 00:00:06,190
حسناً، تكلّم الآن

3
00:00:06,750 --> 00:00:08,120
!اِبدأ باسمِك

4
00:00:08,120 --> 00:00:10,480
!أريد أن أسمع عن مهاراتِك بالسّيفِ أيضاً

5
00:00:11,340 --> 00:00:14,200
هل أتكلّم أمام هذا الشيء فحسب؟

6
00:00:14,920 --> 00:00:16,590
اسمي كانزاكي سينسِي

7
00:00:16,590 --> 00:00:17,910
...بالنسبةِ للسيف

8
00:00:20,400 --> 00:00:23,680
تبنّاني سيّافٌ أجنبيّ عندما كنتُ رضيعاً

9
00:00:25,030 --> 00:00:28,400
علّمَني ذلك الرّجل كلّ ما يعرفه
عن مهاراتِ السّيف الغربيّة

10
00:00:29,960 --> 00:00:33,570
عندما بلغتُ الخامسة عشر، تبنّاني مولايّ الحالي

11
00:00:34,160 --> 00:00:38,320
،جعلَني مولايّ أتمرّن في دوجو نين-ريو

12
00:00:38,320 --> 00:00:41,570
،لذا أستطيع القتال بحرّيةٍ بسيفٍ أو سيفين

13
00:00:42,040 --> 00:00:44,230
حتّى لو كانا سيفين بربريّين

14
00:00:45,270 --> 00:00:47,440
كم مرّة ألوِّح بسيفي عند التمرُّن؟

15
00:00:48,000 --> 00:00:49,610
لا أحصي من البِداية

16
00:00:50,650 --> 00:00:53,640
أبدأ بالإحصاء حالما يغدو الأمر صعباً

17
00:00:55,850 --> 00:01:00,590
فأساساً الـ"نين" من نين-ريو مُستمدّ
:من المبدأ الرئيسي للمدرسة

18
00:01:00,590 --> 00:01:03,250
النّصر من خلال الهدف المرسوم

19
00:01:07,450 --> 00:01:11,190
!سينسِي، تبدو مُتشنِّجاً! استرخِ أكثر

20
00:01:42,650 --> 00:01:44,390
هذه هي المنطِقةُ السكنيّة

21
00:01:45,370 --> 00:01:48,240
لدينا حوالي 50 شخص طبيعيّ يعيشون هنا

22
00:01:49,870 --> 00:01:52,780
فقط 50 في مساحةٍ بهذا الحجم الكبير؟

23
00:01:52,780 --> 00:01:55,460
هذا عددٌ قليلٌ جدّاً من الناس

24
00:01:56,240 --> 00:01:58,640
هذا لأنَّ الآخرين قد أصبحوا جيبيا

25
00:02:00,460 --> 00:02:01,960
تفضَّل يا عزيزي

26
00:02:01,960 --> 00:02:02,840
شكراً

27
00:02:27,240 --> 00:02:29,900
سينسِي، أودُّ أن أطلب معروفاً

28
00:02:30,560 --> 00:02:32,110
قاتِلْني

29
00:02:35,560 --> 00:02:38,430
مهلاً، مهلاً، كنتُ لأتوقّف مكانكِ

30
00:02:38,630 --> 00:02:42,340
يُعرَف هذا الرّجل بقاتِل الألف

31
00:02:42,340 --> 00:02:45,600
إنّه ليس من النّوع الذي تستطيعين هزيمته يا آنسة

32
00:02:46,990 --> 00:02:50,100
أيُّكما أقوى، أنت أم سينسِي؟

33
00:02:52,300 --> 00:02:55,540
...في الواقع، في آخر مرّة تقاتلنا

34
00:02:55,540 --> 00:02:56,510
تعادلنا تقريباً

35
00:02:56,510 --> 00:02:59,600
،لم أستطع هزيمته بسيفٍ يوماً

36
00:02:59,600 --> 00:03:02,060
لكن المعارِك ليسَتْ مجرّد اصطدام سيوف

37
00:03:02,530 --> 00:03:05,870
إذاً كلاكما بنفس القوّة

38
00:03:06,580 --> 00:03:09,680
،بالكاد لدينا مؤونات كافية في هذا المُخيّم

39
00:03:10,640 --> 00:03:13,200
...لِذا أريد أن أرى بنفسي إن كنتُما قويّين حقّاً

40
00:03:13,740 --> 00:03:17,740
قويّان بما يكفي لحمايتنا

41
00:03:19,340 --> 00:03:21,700
،إن كنت ساموراي فعلاً

42
00:03:21,700 --> 00:03:24,990
أريدك أن تثبِت أنَّك تستطيع مُقاتلة جيبيا أيضاً

43
00:03:25,390 --> 00:03:26,540
حسناً

44
00:03:26,540 --> 00:03:28,540
لستَ جادّاً، صحيح؟

45
00:03:29,570 --> 00:03:30,930
أنا مضطرٌّ لفعلِ ذلك

46
00:03:31,470 --> 00:03:34,780
،أنقذَتْ كاثلين-دونو حياتي مرّة بالفعل

47
00:03:35,380 --> 00:03:38,010
لِذا لا يمكنني تجاهل طلباتها

48
00:03:39,110 --> 00:03:40,570
هاجمني بجدّية، حسناً؟

49
00:03:41,020 --> 00:03:43,480
أحمل حزاماً أسود في الكيندو صدّقني

50
00:03:45,360 --> 00:03:47,020
هل لديك أي درع واقٍ؟

51
00:03:47,020 --> 00:03:49,030
،لم يسبقْ أن ارتديتُ شيئاً كهذا

52
00:03:49,560 --> 00:03:50,840
لِذا سأبقى كما أنا

53
00:03:51,600 --> 00:03:53,680
لن أرتدي منه أيضاً إذاً

54
00:03:55,480 --> 00:03:56,570
!ها نحن ذا

55
00:03:59,370 --> 00:04:01,100
...ترفض أن يتصادم سيفُك مع سيفي

56
00:04:01,810 --> 00:04:03,090
!أنت تستهين بي

57
00:04:08,010 --> 00:04:09,430
آسف

58
00:04:10,130 --> 00:04:12,860
لا أدع سيفي يتصادم عندما أقاتِل

59
00:04:13,680 --> 00:04:15,520
هذا يجعل السّيف كليلاً

60
00:04:20,440 --> 00:04:26,240
لكن لن تكون تلك مُشكلة لو حصلتُ
على سيفي الثّمين

61
00:04:26,800 --> 00:04:28,240
!مُذهِل

62
00:04:28,740 --> 00:04:30,080
!أنا مُطمئنّة

63
00:04:30,080 --> 00:04:33,330
!أنتَ قويٌ حقّاً يا سينسِي

64
00:04:34,790 --> 00:04:36,360
كاثلين-دونو

65
00:04:37,510 --> 00:04:39,100
!لديّ طلبٌ آخر

66
00:04:39,100 --> 00:04:40,630
كفَّ عن استخدام "دونو" معي

67
00:04:40,630 --> 00:04:42,080
يكفي أن تقول كاثلين

68
00:04:44,500 --> 00:04:46,070
...يا إلهي

69
00:04:46,850 --> 00:04:47,880
!حسناً

70
00:04:48,350 --> 00:04:49,480
!هذا يليق بك

71
00:04:51,540 --> 00:04:54,690
ما الجدوى من هذا يا كاثلين؟

72
00:04:54,990 --> 00:04:57,730
!لا يوجد جدوى. إنّه على الموضة

73
00:04:57,730 --> 00:04:58,540
موضة...؟

74
00:04:59,190 --> 00:05:02,970
هذا الزمن يهتمّ بالتأنُّق وتحسين المزاج

75
00:05:06,050 --> 00:05:07,950
!ما هذا؟

76
00:05:09,660 --> 00:05:11,030
!ما الأمر يا كينروكو؟

77
00:05:12,570 --> 00:05:13,720
...أنت

78
00:05:16,280 --> 00:05:19,890
!أصبح رأسي أزرق

79
00:05:21,920 --> 00:05:22,880
!يبدو رائعاً

80
00:05:22,880 --> 00:05:25,380
!يبدو رائعاً حقّاً كما توقّعتُ أن يكون

81
00:05:26,760 --> 00:05:29,720
هل هذا ما ينجذِب إليه النّاس اليوم؟

82
00:05:30,290 --> 00:05:34,960
هذا... نابِضٌ بالحيويّة

83
00:05:37,680 --> 00:05:39,120
!أنت متحمّس جداً

84
00:05:39,730 --> 00:05:42,720
!النينجا بالشّعر الأزرق غاية في الرّوعة

85
00:05:42,720 --> 00:05:44,100
ألا تعتقد ذلك؟

86
00:05:45,440 --> 00:05:47,240
في الواقع... أجل

87
00:05:48,350 --> 00:05:52,240
الآن وأنا أنظر عن كثب، إنّه ناعم جدّاً

88
00:05:52,680 --> 00:05:53,950
حقّاً؟

89
00:05:54,620 --> 00:05:56,450
...إنّه نابض بالحيويّة، لكن

90
00:05:56,450 --> 00:05:59,930
إنّه صارخٌ ويلائم كينروكو كثيراً، تميّزه من بعيد

91
00:06:00,520 --> 00:06:04,000
لكن يُقضى على الشّينوبي إذا كان مُلفِتاً للأنظار

92
00:06:13,470 --> 00:06:15,350
!أمِّي، آسفة لو تأخّرتُ عليكِ

93
00:06:15,870 --> 00:06:18,020
أهلاً بعودتكِ

94
00:06:18,460 --> 00:06:21,770
هل ستروين لي حِكايات عن فترةِ إيدو؟

95
00:06:27,440 --> 00:06:29,060
هذا سيهتمُّ بالأمر

96
00:06:29,060 --> 00:06:33,080
أنتَ محظوظٌ لأنّك لم تُصَب بعد
مُهاجمتك بواسطةِ جيبيا

97
00:06:34,520 --> 00:06:38,310
،يوريكا-دونو، إذا كان هذا المُستقبل

98
00:06:38,760 --> 00:06:42,170
فهل تعرفين ماذا حدثَ في عصرِنا وما بعده؟

99
00:06:42,860 --> 00:06:46,260
مثل ما حدث مع ماتسوموتو جوزين؟

100
00:06:46,580 --> 00:06:48,220
"كفَّ عن استخدام "دونو

101
00:06:48,220 --> 00:06:51,060
في هذا العصر، نستخدِم "سان" لمُخاطبةِ النّاس

102
00:06:52,430 --> 00:06:55,840
قلّما أعرف عمّا حدث في فترةِ إيدو

103
00:06:56,660 --> 00:06:58,930
كنتُ من مُعجباتِ الدراما التاريخيّة

104
00:06:59,970 --> 00:07:01,940
يوريكا... سان

105
00:07:05,610 --> 00:07:07,440
،حسبما أذكر

106
00:07:07,440 --> 00:07:10,950
ظلَّ ذلك الرّجل يخون الآخرين حتّى
قُطِعَ رأسه في نهايةِ المطاف

107
00:07:10,950 --> 00:07:12,650
!سينسِي

108
00:07:12,650 --> 00:07:14,030
!أتوسّل إليك

109
00:07:14,030 --> 00:07:17,460
!لن يُثقِل علينا توكوغاوا-دونو

110
00:07:24,760 --> 00:07:27,990
لا أصدِّق ذلك... مولايّ

111
00:07:34,470 --> 00:07:37,810
!تأخّر الوقت. عليّ أن أسرِع

112
00:08:05,490 --> 00:08:06,620
!مايدا

113
00:08:06,620 --> 00:08:09,000
!تحرّك بهدوء ولا ترتعِد

114
00:08:24,390 --> 00:08:26,520
!صوِّبوا نحو الأضواء الكاشِفة

115
00:08:34,530 --> 00:08:37,030
!بسرعة يا مايدا

116
00:08:37,690 --> 00:08:40,040
!أعلم، أعلم

117
00:08:55,840 --> 00:08:59,960
عادَ بسيف، لكن ما المنفعة التي سيحقّقها ذلك؟

118
00:09:00,570 --> 00:09:01,920
لا أحد يدري

119
00:09:02,750 --> 00:09:06,160
إذا بدأ الجيبيا بالهجوم فوراً، فسلِّط
الأضواء عليهم مُباشرة

120
00:09:06,160 --> 00:09:07,020
حاضر

121
00:09:16,790 --> 00:09:20,530
لا نستطيع تلبية نزواتك المجنونة

122
00:09:20,530 --> 00:09:23,210
آدم. آسف

123
00:09:23,210 --> 00:09:25,540
سأعطيك مزيداً من شوتشو

124
00:09:26,040 --> 00:09:28,540
لا أقبل سوى بنوع البطاطا الحُلوة ذاك

125
00:09:29,200 --> 00:09:30,720
نوعيّة الحنطة السّوداء لذيذة أيضاً

126
00:09:37,950 --> 00:09:40,320
سينسِي، هل أنت بخير؟

127
00:09:44,700 --> 00:09:49,790
كان ماتسوموتو جوزين السيّد الذي خدمَه سينسِي

128
00:09:50,590 --> 00:09:54,740
يبدو أنّه شعرَ بالتزامٍ تجاهه لتبنّيه كطفل

129
00:09:56,140 --> 00:09:57,380
هكذا إذاً

130
00:10:00,180 --> 00:10:01,440
سينسِي-كن

131
00:10:06,080 --> 00:10:07,840
يوشيناغا-دونو

132
00:10:07,840 --> 00:10:11,250
كفَّ عن استخدام "دونو"، يكفي
أن تقول يوشيناغا

133
00:10:12,150 --> 00:10:14,710
هل انتهيتَ من علاجِ جرحك؟

134
00:10:15,120 --> 00:10:17,760
أجل، انتهيت

135
00:10:18,600 --> 00:10:20,130
ما الأمر؟

136
00:10:20,930 --> 00:10:22,260
أمر بسيط فحسب

137
00:10:35,280 --> 00:10:38,750
مولايّ، يا لها من نهاية مُؤسِفة

138
00:10:39,540 --> 00:10:44,020
أي نوع من الخدَم هو أنا إذا لم أستطع
!أن أكون بجانبِك في لحظاتِك الأخيرة؟

139
00:10:45,240 --> 00:10:49,250
هل كانَتْ هناك أي جدوى من قِتالي كلّه؟

140
00:10:51,010 --> 00:10:54,260
لمَ أُرسِلتُ حتّى إلى مكانٍ كهذا؟

141
00:10:55,670 --> 00:10:58,570
!ها أنت ذا يا ساموراي-سان

142
00:11:00,090 --> 00:11:01,770
!آسف لو تأخّرت

143
00:11:02,110 --> 00:11:04,710
!أحضرتُ سيفي

144
00:11:05,310 --> 00:11:06,730
مايدا-دونو

145
00:11:09,280 --> 00:11:10,110
!هذا سيّئ

146
00:11:10,110 --> 00:11:10,980
ما الذي يجري؟

147
00:11:10,980 --> 00:11:11,780
!الأضواء

148
00:11:11,780 --> 00:11:12,750
!الأضواء! شغِّلوها بسرعة

149
00:11:12,750 --> 00:11:13,970
!ماذا؟ ما الذي يجري؟

150
00:11:13,970 --> 00:11:16,000
!الجيبيا يُهاجِمون

151
00:11:20,440 --> 00:11:21,870
!يا للهول

152
00:11:21,870 --> 00:11:23,490
!الجيبيا قادِمون

153
00:11:23,900 --> 00:11:26,650
!لماذا؟! ماذا يحدث؟

154
00:11:27,640 --> 00:11:29,630
!انطفأت الأنوار

155
00:11:29,630 --> 00:11:32,510
!على هذا المنوال، سينهالُ علينا الجيبيا

156
00:11:33,100 --> 00:11:36,750
!كاثلين، عليكِ أن تذهبي إلى يوريكا-سان

157
00:11:37,290 --> 00:11:40,410
!كينروكو-كن، تعال معي

158
00:11:40,750 --> 00:11:43,750
!سنعترِض الجيبيا بفريقِ الدِّفاع

159
00:11:45,260 --> 00:11:47,810
!دكتور! لكن ماذا عن سينسِي؟

160
00:11:47,810 --> 00:11:49,220
!تحرّكي

161
00:11:50,520 --> 00:11:51,390
!حـ-حاضِرة

162
00:11:52,830 --> 00:11:53,810
!مايدا-دونو؟

163
00:12:07,690 --> 00:12:09,920
!خُذِ السّيف

164
00:12:15,590 --> 00:12:17,040
!مايدا-دونو

165
00:12:22,470 --> 00:12:24,090
!مايدا-دونو

166
00:12:36,530 --> 00:12:37,710
!مايدا-دونو

167
00:13:07,760 --> 00:13:09,490
...ساموراي-سان

168
00:13:12,290 --> 00:13:13,580
!مايدا-دونو

169
00:13:19,950 --> 00:13:22,010
مايدا-دونو، هل أنت بخير؟

170
00:13:23,200 --> 00:13:24,890
اصبِر قليلاً فقط

171
00:13:24,890 --> 00:13:29,460
حالما أبعِد هؤلاء الأعداء، سآخذك
!إلى أمِّ كاثلين

172
00:13:29,800 --> 00:13:32,490
لا عليك، لا عليك

173
00:13:32,830 --> 00:13:36,300
ساموراي-سان، أنت قويٌ حقّاً

174
00:13:38,480 --> 00:13:39,730
!اصمد

175
00:13:45,690 --> 00:13:47,760
أنت غاية في الرّوعة

176
00:13:50,380 --> 00:13:52,090
،دعْ سيفي يصبِح برقاً

177
00:13:53,070 --> 00:13:56,730
!لحمايةِ النّاس العاديّين

178
00:13:58,310 --> 00:14:00,040
!تعال إليّ يا جيبيا

179
00:14:05,970 --> 00:14:10,460
هذا سيّئ جدّاً، أليس كذلك؟

180
00:14:10,460 --> 00:14:13,610
أجل، هذا سيّئ للغاية

181
00:14:14,570 --> 00:14:16,670
،بانطفاءِ الأنوار

182
00:14:16,670 --> 00:14:20,500
يُمسي هذا المكان مسرح صيدٍ أساسيّ
للجيبيا الذين يكرهون الضّوء

183
00:14:21,840 --> 00:14:24,500
ألا يمكنك إصلاحها يا يوشيناغا؟

184
00:14:25,310 --> 00:14:29,430
عمّا قريب، مزيد من الجيبيا حتّى
سيبدأون بالتجمُّعِ حولنا

185
00:14:29,820 --> 00:14:32,770
علينا أن نرسمَ خطّةً قبل أن يحدث ذلك

186
00:14:33,780 --> 00:14:36,570
،لا أعلم كيف ستكون فعاليّتها

187
00:14:36,570 --> 00:14:39,350
لكن إذا أشعلنا بعض الخِيَم بالنّيران

188
00:14:39,350 --> 00:14:41,900
فقد نتمكّن من توفير بعض الضّوء

189
00:14:42,860 --> 00:14:44,910
كينروكو-كن، ساعدني

190
00:14:46,550 --> 00:14:49,640
قد تكون هذه هي الحياة الآخرة فعلاً

191
00:15:07,410 --> 00:15:08,300
ماذا؟

192
00:15:09,320 --> 00:15:11,920
هل تريدين سماع المزيد عن فترةِ إيدو؟

193
00:15:16,560 --> 00:15:20,560
لا حاجة للعجلةِ هكذا

194
00:15:27,660 --> 00:15:29,490
!اهربي يا أمِّي

195
00:15:37,930 --> 00:15:39,990
!لماذا انطفأت الأنوار؟

196
00:15:39,990 --> 00:15:42,120
!وجدنا بعضَ الأملِ أخيراً أيضاً

197
00:15:48,010 --> 00:15:49,260
!تبّاً! تبّاً

198
00:16:01,800 --> 00:16:04,090
!لن نصمد بهذا الشّكل

199
00:16:04,450 --> 00:16:08,040
!هذه النّيران ليسَتْ قويّة بما يكفي لإخافةِ الجيبيا

200
00:16:11,950 --> 00:16:14,120
!سُحقاً، سُحقاً

201
00:16:32,150 --> 00:16:35,230
!اللّعنة، إنَّه ثقيل

202
00:16:46,960 --> 00:16:48,290
!خُذ هذا

203
00:16:51,610 --> 00:16:53,840
!تراجع! تراجع

204
00:16:56,760 --> 00:17:00,870
!اللّعنة! كفُّوا عن مُهاجمةِ النّاس أيُّها الأوغاد

205
00:17:01,190 --> 00:17:03,870
!آدم! اخترقوا من المدخل

206
00:17:03,870 --> 00:17:06,420
!لنتراجع إلى خطِّ الدِّفاع الأخير

207
00:17:06,930 --> 00:17:11,170
لا توجد أي خطوط لعينة عندما يأتون
!من كافّةِ الجهات هكذا

208
00:17:15,680 --> 00:17:16,680
!آدم

209
00:17:33,530 --> 00:17:35,510
!سأتولّى الأمور هنا

210
00:17:35,870 --> 00:17:37,160
!اهتمّوا بكاثلين

211
00:17:37,850 --> 00:17:40,290
...تبّاً، لن أدعك

212
00:17:40,290 --> 00:17:41,390
!توقّفْ يا آدم

213
00:17:42,560 --> 00:17:43,550
!سينسِي

214
00:17:44,190 --> 00:17:46,540
!إيّاك أن تموت أيضاً

215
00:18:14,530 --> 00:18:15,940
!مُذهِل

216
00:18:23,030 --> 00:18:25,470
هذا هو قاتِل الألف الذي أعرفه

217
00:18:25,470 --> 00:18:28,040
هؤلاء الجيبيا لا يعنون شيئاً أمامه

218
00:18:43,870 --> 00:18:45,600
!كاثلين، هل أنتِ بخير؟

219
00:18:45,600 --> 00:18:46,890
!آدم

220
00:18:47,890 --> 00:18:50,120
!أتى سينسِي-كن لإنقاذِنا

221
00:18:50,120 --> 00:18:51,420
تعالي معنا

222
00:18:52,980 --> 00:18:54,730
!أمِّي، هيّا بنا

223
00:18:58,920 --> 00:19:00,170
شكراً لكما

224
00:19:00,170 --> 00:19:01,310
!تحرّكا بسرعة

225
00:19:01,310 --> 00:19:02,220
حسناً

226
00:19:03,050 --> 00:19:04,390
!ها هم يا آدم

227
00:19:20,760 --> 00:19:21,900
!سينسِي

228
00:19:26,960 --> 00:19:27,990
!كينروكو؟

229
00:19:30,220 --> 00:19:31,900
!لنستمرّ في التحرُّك

230
00:19:51,980 --> 00:19:54,700
!علينا العبور من هنا مهما كلّفَ الأمر

231
00:19:55,150 --> 00:19:57,840
!يجب علينا حِماية اللُّقاح الذي سيُنقِذ هذا العالم

232
00:19:59,900 --> 00:20:00,950
دكتور

233
00:20:03,560 --> 00:20:04,760
!انظري هناك

234
00:20:14,010 --> 00:20:15,320
...إنّهما

235
00:20:16,610 --> 00:20:18,040
بهذه القوّة

236
00:20:37,360 --> 00:20:41,610
تبّاً، كان لا يزال بشريّاً. لم يكن عليك قتله

237
00:20:41,990 --> 00:20:45,030
ولأنّه كذلك تمكنَّا من قتلِه

238
00:20:45,370 --> 00:20:47,870
حالما يتحوّل إلى جيبيا، لن يكون الأمر بهذه البساطة

239
00:20:49,240 --> 00:20:52,110
لكنّك سريع التعلُّم يا كينروكو-كن

240
00:20:52,440 --> 00:20:55,310
تعاملتَ مع تِلك القنابل اليدويّة بإبداع

241
00:20:56,250 --> 00:20:59,620
،لطالما كنتُ ميّالاً للأمور الغربيّة

242
00:21:00,090 --> 00:21:03,320
لِذا أنا مُعتادٌ كثيراً على الأشياء الجديدة

243
00:21:12,910 --> 00:21:14,330
مايدا-دونو

244
00:21:14,890 --> 00:21:18,830
ساموراي-سان، ربِحت

245
00:21:19,570 --> 00:21:20,590
...أنت

246
00:21:25,060 --> 00:21:28,590
مايدا-سان، هل تسمع صوت ماء؟

247
00:21:29,820 --> 00:21:32,880
أجل، أسمعه

248
00:21:33,210 --> 00:21:35,230
بِتُّ أسمعه منذ مدّة

249
00:21:36,440 --> 00:21:39,660
أُصِبتَ بفيروس جيبيا إذاً

250
00:21:39,660 --> 00:21:40,860
!مُستحيل

251
00:21:42,560 --> 00:21:46,180
ساموراي-سان، كنتَ رائعاً للغاية

252
00:21:46,760 --> 00:21:49,370
يسرُّني أنّني رأيتُ شيئاً عظيماً قبل النِّهاية

253
00:21:53,370 --> 00:21:58,490
تقلّصَ الوقتُ بين كلّ قطرةٍ وأخرى الآن

254
00:22:00,160 --> 00:22:02,890
أرجوك يا ساموراي-سان

255
00:22:07,510 --> 00:22:08,760
!مايدا-دونو

256
00:22:12,220 --> 00:22:14,530
!قبل أن أصبِح جيبيا

257
00:22:25,200 --> 00:22:31,220
الوداع يا مايدا-سان

258
00:22:45,800 --> 00:22:48,860
!كاثلين-تشان، كاثلين-تشان

259
00:22:48,860 --> 00:22:50,770
ماذا؟ مايدا-سان؟

260
00:22:50,770 --> 00:22:52,990
!صه! اسكتي

261
00:22:52,990 --> 00:22:55,430
طلبَتْ منّي يوريكا-سان المجيء إلى هنا

262
00:22:55,430 --> 00:22:57,070
!تعالي معي

263
00:22:57,070 --> 00:22:58,060
إلى أين؟

264
00:22:58,060 --> 00:22:59,440
!الباب الخلفيّ

265
00:23:00,170 --> 00:23:05,360
دخلَ جيبيا المشفى، لذا من بقي
منّا حيّاً يهرب

266
00:23:06,970 --> 00:23:08,440
!مايدا-سان

267
00:23:09,440 --> 00:23:11,470
سأحميكِ

268
00:23:11,470 --> 00:23:13,670
ليس عليكِ القلق

269
00:23:15,930 --> 00:23:17,200
،مايدا-دونو

270
00:23:19,810 --> 00:23:21,260
شكراً لك

271
00:23:29,310 --> 00:23:33,840
أعتقد قد حان الوقتُ لمُغادرةِ هذه المنطِقة

272
00:23:34,740 --> 00:23:37,590
،لم يبقَ كثير من الطعامِ هنا

273
00:23:37,590 --> 00:23:40,640
لِذا لنذهب إلى مكانٍ آخر

274
00:23:41,630 --> 00:23:45,630
لنتوجّه إلى منطقةٍ ريفيّةٍ تالياً

275
00:23:47,020 --> 00:23:51,230
لن نواجه مُشكلة في إيجادِ طعام في الرِّيف

276
00:24:15,820 --> 00:24:16,720
!زوجي

277
00:24:17,070 --> 00:24:18,450
!أبي