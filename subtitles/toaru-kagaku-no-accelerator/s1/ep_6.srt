1
00:00:00,850 --> 00:00:04,520
"كيف يقتل أن تكون جذور "م ت
هي نفس جذور "مضادّي المهارات"؟

2
00:00:05,020 --> 00:00:08,190
.إنّها نفس الجذور، إلاّ أنّه جذورهم فاسدة

3
00:00:08,190 --> 00:00:11,400
إ-إنّهنّ... فريق ناكيموتو للتّنظيف؟

4
00:00:11,400 --> 00:00:13,570
إلى أين أنت ذاهب؟
.لم يحن أوانك بعد يا بابا نويل

5
00:00:17,580 --> 00:00:23,870
إنّها الحقيبة الكبيرة الّتي تحتوي الفتاة
.الّتي كانوا يتحدّثون عنها على اللاّسلكيّ

6
00:00:24,870 --> 00:00:27,590
.سُحقًا، تنهال عليّ المشاكل من كلّ جانب

7
00:00:27,590 --> 00:00:30,710
.ولكن، ذلك ما أحتاجه من أجل إعادة تأهيلي

8
00:02:08,230 --> 00:02:12,020
تطلّب الأمر أربعة منهنّ للقضاء
.على السّلاح متعدّد الأرجل

9
00:02:12,610 --> 00:02:15,570
لا يوجد سجلّ لهؤلاء الأربعة
.في قاعدة بيانات فائقي الإدراك

10
00:02:15,990 --> 00:02:17,650
لماذا هنّ غير مدرجات؟

11
00:02:19,660 --> 00:02:21,370
.ربّما هنّ من منظّمة من الجانب المظلم

12
00:02:29,370 --> 00:02:34,090
هذه نقاط إضافيّة. إن حصلنا
،على الفتاة الّتي في الحقيبة

13
00:02:34,090 --> 00:02:35,880
.يمكنني ضمان مكافأة إضافيّة

14
00:02:36,710 --> 00:02:38,340
.لنركنّ وأنتنّ تقمن بمهمّتكنّ

15
00:02:40,260 --> 00:02:42,430
!حسنًا، لنبدأ

16
00:02:45,510 --> 00:02:47,560
...لنرَ كيف سيسير

17
00:02:48,310 --> 00:02:50,270
!هذا الأمر اليوم

18
00:03:01,490 --> 00:03:03,200
!شعور رائع

19
00:03:03,200 --> 00:03:04,330
!يا نارو

20
00:03:04,910 --> 00:03:07,450
!انتبهي! تهاوني قليلاً

21
00:03:07,790 --> 00:03:11,620
!آسفة، آسفة! تحمّست كثيرًا بعض الشّيء

22
00:03:11,620 --> 00:03:14,040
يحدث هذا في كلّ مرّة أعتقد
!أنّه تسنّى لي قتل مُعلّمة

23
00:03:20,970 --> 00:03:24,010
والآن، كيف أقتلها؟

24
00:03:24,010 --> 00:03:27,260
هل أعبث معها عن طريق خلع ذراعيها
من كتفيها واحدة على حدى؟

25
00:03:27,260 --> 00:03:30,140
.لستُ لعبتك

26
00:03:30,140 --> 00:03:34,520
!أو ربّما سأكسر عنقها، وأدعها ترتعش

27
00:03:34,520 --> 00:03:38,280
.سبق وأخبرتك، أنا لست لعبتك

28
00:03:37,360 --> 00:03:38,280
!خذي هذا

29
00:03:38,940 --> 00:03:40,320
أيّهما قد تحبّين؟

30
00:03:40,740 --> 00:03:43,530
لماذا لديك ضغينة كهذه ضدّ الأساتذة؟

31
00:03:44,160 --> 00:03:47,160
الأساتذة؟ تقصدين المُعلّمين؟

32
00:03:47,660 --> 00:03:48,160
.نعم

33
00:03:49,450 --> 00:03:52,790
إنّكم أسّ كلّ الشّرّ، أليس كذلك؟

34
00:03:52,790 --> 00:03:54,500
.نعم. يعلم الجميع هذا

35
00:03:55,210 --> 00:03:58,670
.إنّ المدينة الأكاديميّة أشبه بمدرسة واحدة كبيرة

36
00:03:58,670 --> 00:04:03,760
لذلك من الواضح أنّها غلطة المُعلّمين
إن كانت المدينة لا تُدار كما يجب، صحيح؟

37
00:04:04,050 --> 00:04:07,970
لهذا السّبب إن قضينا عليهم الواحد تلو الآخر

38
00:04:07,970 --> 00:04:10,810
من المُعلّمين الّذي أهملوا واجباتهم
،وتركوا المدينة تفسد هكذا

39
00:04:10,810 --> 00:04:13,100
فيومًا ما، سنصل إلى المدير أو النّاظر

40
00:04:13,100 --> 00:04:15,350
،أو إلى مصدر الشّرّ أيًّا كان

41
00:04:15,350 --> 00:04:21,490
،وبعد القضاء عليه
.نعتقد أنّ العالم سيصبح مكانًا أفضل

42
00:04:21,490 --> 00:04:23,200
ألا تظنّين ذلك؟

43
00:04:23,200 --> 00:04:24,700
تظنّين ذلك أيضًا، صحيح؟

44
00:04:25,160 --> 00:04:26,660
.نعم، نعم

45
00:04:27,240 --> 00:04:27,870
!أنت مخطئة

46
00:04:28,620 --> 00:04:32,790
."أكيد أنّ هنالك أشخاصًا مثل "م ت
"لكن نحن في وحدة "مضادو المهارات

47
00:04:33,250 --> 00:04:35,750
نملك العزيمة والإصرار

48
00:04:35,750 --> 00:04:38,880
للمخاطرة بأرواحنا للحفاظ على
!أمن تلاميذ المدينة الأكاديميّة

49
00:04:43,220 --> 00:04:44,760
أهنالك مُعلّمون هكذا؟

50
00:04:44,760 --> 00:04:46,390
!بالطّبع لا

51
00:04:46,390 --> 00:04:47,300
.نعم، مستحيل

52
00:04:50,560 --> 00:04:52,770
!يا لكنّ من حثالة متعفّنة

53
00:04:53,310 --> 00:04:56,940
عليكنّ أيّتها الفتيات الاستماع
!والانصياع لأوامر من هم أكبر منكنّ

54
00:04:56,940 --> 00:04:58,560
!فلتموتي أيّتها الشّقيّة

55
00:05:01,400 --> 00:05:03,280
ناجٍ من "م ت"؟

56
00:05:03,280 --> 00:05:05,240
.إذًا فهو مُعلّم سابق

57
00:05:05,240 --> 00:05:10,200
من الانحطاط إطلاق النّار على
.تلاميذ دون طرح أسئلة أوّلاً

58
00:05:10,200 --> 00:05:14,040
.نعم. لا فائدة من محاولة مساعدة المعلّمين

59
00:05:12,160 --> 00:05:14,040
...سُحقًا... سُحقًا

60
00:05:22,710 --> 00:05:25,090
ياكو، هلاّ أنهيتِ أمره؟

61
00:05:26,180 --> 00:05:27,130
.حسنًا، حسنًا

62
00:05:27,130 --> 00:05:27,760
!ابتعد

63
00:05:33,640 --> 00:05:35,020
ما-ما هو هذا؟

64
00:05:35,520 --> 00:05:37,770
.ناقص 269 درجة

65
00:05:38,400 --> 00:05:41,440
.مُجمّدي الّذي أعدّ لي خصّيصًا

66
00:05:42,780 --> 00:05:46,200
.ما زلتُ قادرًا... على تنفيذ العدالة

67
00:05:46,700 --> 00:05:49,450
.التّحكّم في الجاذبيّة هنا بحدّ ذاته هو الأساس

68
00:05:49,740 --> 00:05:53,410
...الـ-العدالة... لهذه المدينة

69
00:05:53,910 --> 00:05:55,950
!مع السّلامة

70
00:06:02,630 --> 00:06:03,800
لماذا...؟

71
00:06:03,800 --> 00:06:05,340
.آسفة على التّأخّر

72
00:06:06,470 --> 00:06:08,680
.حان دورك يا مُعلّمة

73
00:06:09,760 --> 00:06:11,890
.اهربي. خذيها معك

74
00:06:15,350 --> 00:06:16,270
!أعتمد عليك

75
00:06:19,140 --> 00:06:22,310
!لا جدوى لذلك الشّيء ضدّي

76
00:06:29,570 --> 00:06:31,990
!كاتو! لا تسمحي لها بأن تُقتل

77
00:06:31,990 --> 00:06:32,530
.عُلم

78
00:06:32,830 --> 00:06:34,240
!مع السّلامة يا مُعلّمة

79
00:06:46,340 --> 00:06:50,340
!كلّ ما فعلته هو التّدخّل بيننا
من تكونين على أيّ حال؟

80
00:06:50,930 --> 00:06:54,600
هل لدينا هنا تلميذة شرفيّة
تساعد المُعلّمة؟

81
00:06:55,100 --> 00:06:57,680
.تبدو مختلفة عن أيّ صاحب قدرات خارقة عادي

82
00:06:57,680 --> 00:07:02,310
على التّلاميذ الشّرفيّين أن يعلموا
!أنّ عليهم انتظار دورهم

83
00:07:02,310 --> 00:07:05,070
.نارو، اقتلي التّلميذة الشّرفيّة

84
00:07:05,070 --> 00:07:06,230
.المُعلّمة أوّلاً

85
00:07:06,230 --> 00:07:09,320
!لا تتدخّلان في هذا
!أنا من تقوم بالقتل هنا

86
00:07:09,320 --> 00:07:11,070
.التّلميذة الشّرفيّة أوّلاً

87
00:07:11,950 --> 00:07:15,410
سيضمن لنا ذلك أنّ المُعلّمة
يمكنها الموت يأسًا، صحيح؟

88
00:07:16,620 --> 00:07:18,120
!عُلم

89
00:07:18,540 --> 00:07:19,500
!كاتو

90
00:07:19,500 --> 00:07:20,790
.أدوناي، عُلم

91
00:07:21,500 --> 00:07:25,170
أقوم بمراجعة شديدة لمعدّل
.القوّة القتاليّة بشكل تقريبيّ

92
00:07:25,170 --> 00:07:28,010
يتمّ تحرير قوّة عضليّة
.لتنفيذ أمر القضاء

93
00:07:28,630 --> 00:07:31,880
معدّل تمزّق الأنسجة العضليّة
.المسموح به 10 بالمائة

94
00:07:31,880 --> 00:07:34,390
.ستكون 10 دقائق من القتال كافية تقريبًا

95
00:07:37,140 --> 00:07:37,890
.لنبدأ

96
00:07:45,860 --> 00:07:47,820
!...أيّتها الخبيثة

97
00:07:52,860 --> 00:07:55,910
!دعي عملي الفنّيّ وشأنه

98
00:08:02,210 --> 00:08:05,460
زيّ الدّب الرّائع جدًّا هذا

99
00:08:05,460 --> 00:08:08,090
!قادر على تغيير شكله بين الدّفاع والهجوم

100
00:08:08,460 --> 00:08:10,550
هل هذه تعاويذ ورقيّة؟
.كلاّ، بل شيء آخر

101
00:08:11,010 --> 00:08:15,180
تملك أوراقها المعزّزة بالتّحريك الذّهنيّ
صلابة معدن التّنغستن

102
00:08:15,180 --> 00:08:17,760
.إضافة لمرونة القماش

103
00:08:17,760 --> 00:08:22,230
وإذا جمعنا ذلك بأسلوب
،ملابسها الغريب وحسّها القتاليّ

104
00:08:22,230 --> 00:08:24,310
.تصبح مهاراتها القتاليّة لا نظير لها

105
00:08:25,310 --> 00:08:27,270
!سوف أقوم بتمزيقك

106
00:08:34,320 --> 00:08:34,820
!كاتو

107
00:08:35,160 --> 00:08:36,820
!خذي هذا

108
00:08:40,490 --> 00:08:41,620
!لقد متِّ

109
00:08:41,620 --> 00:08:42,370
!كاتو

110
00:08:44,540 --> 00:08:47,750
.أدوناي، لا مشكلة

111
00:08:48,090 --> 00:08:48,960
...كاتو

112
00:08:49,590 --> 00:08:52,710
،لا فائدة. حسب مجرى الأمور
.فستُهزم كاتو

113
00:08:53,170 --> 00:08:55,260
،بإمكاني تعزيز قوّتها بالسّحر

114
00:08:55,470 --> 00:08:56,800
...لكن في وضعها الحاليّ

115
00:08:57,300 --> 00:09:01,930
.الإصابات الجسديّة من المستوى 4
.مراجعة زمن القدرة على القتال بشكل تنازليّ

116
00:09:03,060 --> 00:09:05,600
.التّلميذة الشّرفيّة قويّة جدًّا

117
00:09:06,400 --> 00:09:11,400
!عليّ إنقاذ كاتو. فكّري
...لا بدّ من... لا بدّ من

118
00:09:13,490 --> 00:09:15,900
!حسنًا، ها أنا ذي

119
00:09:21,830 --> 00:09:22,740
!سيفي هذا بالغرض

120
00:09:22,740 --> 00:09:26,370
!وها هي دعسة العملاق للقضاء عليك

121
00:09:31,210 --> 00:09:32,300
!استوت مع الأرض

122
00:09:32,670 --> 00:09:34,260
.إنّها ميتة بكلّ تأكيد الآن

123
00:09:34,840 --> 00:09:35,510
نارو؟

124
00:09:38,550 --> 00:09:40,550
!...هذا يلسع

125
00:09:47,350 --> 00:09:49,900
!ما-ما هذا؟

126
00:09:50,440 --> 00:09:51,690
.درع الموتى

127
00:09:53,820 --> 00:09:57,820
إنّها محرّكة ذهنيّة مثل نارو
وتستطيع استعمال التّراب كوسيط لها؟

128
00:09:58,070 --> 00:10:00,700
سُحقًا! هل تعتقدين أنّ شيئًا كهذا

129
00:10:00,700 --> 00:10:04,200
بإمكانه إيقاف هجوم زيّ دبّ
!مصنوع خصّيصًا لي؟

130
00:10:05,120 --> 00:10:06,960
!اللّكمة القاتلة

131
00:10:09,540 --> 00:10:12,130
!ذلك يلسع ثانية

132
00:10:12,500 --> 00:10:15,840
،لا فائدة. لا أعرف من تكنّ

133
00:10:15,840 --> 00:10:17,880
.لكنّني أوشك على الوصول لحدود صبري

134
00:10:18,340 --> 00:10:19,300
!ابتعدن عن طريقي

135
00:10:19,590 --> 00:10:20,470
!مستحيل

136
00:10:21,350 --> 00:10:22,470
.يا إلهي

137
00:10:22,470 --> 00:10:25,520
.نارو، أنهكيها. إنّه مجرّد تراب

138
00:10:25,520 --> 00:10:29,100
لقد حفر النّاس حفرًا في كلّ أنواع
.التّربة، مهما كانت صلبة

139
00:10:29,100 --> 00:10:30,980
!ذلك منطقيّ

140
00:10:31,520 --> 00:10:33,320
...إبداعي الجديد

141
00:10:39,860 --> 00:10:42,280
!هو نسخة الحفّار

142
00:10:54,880 --> 00:10:56,880
!مهلاً، لا تهربي

143
00:10:57,920 --> 00:10:59,420
!...أيّتها الـ... أيّتها الـ

144
00:10:59,930 --> 00:11:01,840
!كفّي عن الهرب

145
00:11:03,050 --> 00:11:04,810
!نلت منك هذه المرّة

146
00:11:07,060 --> 00:11:09,600
!...أشعر بالدّوار

147
00:11:15,980 --> 00:11:20,110
يبدو أنّه من الصّعب عليها التّحكّم
.بمكوّن معقّد كهذا

148
00:11:20,650 --> 00:11:25,660
إنّه قادر على القتل بضربة واحدة، لكن
.وإن صعب تخيّل الأمر، فإنّه يمكن تجنّبه

149
00:11:25,660 --> 00:11:27,620
.لذلك نحتاج لطُعم ما لنمسكها به

150
00:11:27,990 --> 00:11:29,960
!نارو، اسعي خلف الشّقراء

151
00:11:29,960 --> 00:11:30,830
ماذا؟

152
00:11:30,830 --> 00:11:31,870
!قومي بذلك فحسب

153
00:11:33,710 --> 00:11:35,840
.لا فائدة. لا أستطيع التّحرّك الآن

154
00:11:36,290 --> 00:11:38,670
!حانت نهايتك

155
00:11:50,140 --> 00:11:51,020
!كاتو؟

156
00:11:51,310 --> 00:11:52,980
.التهمت الطّعم

157
00:11:53,270 --> 00:11:56,730
!أولى ضرباتي! واصل الدّوران الآن

158
00:11:56,730 --> 00:11:58,690
!زيادة السّرعة

159
00:12:01,030 --> 00:12:02,610
!كاتو، توقّفي

160
00:12:02,610 --> 00:12:05,370
.هذه ليست مشكلة. اهربي رجاءً يا أدوناي

161
00:12:07,200 --> 00:12:09,240
.كاتو، توقّفي

162
00:12:09,240 --> 00:12:11,540
.سلامتك يا أدوناي هي أولويّتي

163
00:12:11,830 --> 00:12:15,130
.كم أكره المتملّقين للمُعلّمين

164
00:12:15,420 --> 00:12:17,090
!زيادة الدّوران

165
00:12:27,470 --> 00:12:29,890
...يكفي... توقّفي رجاءً

166
00:12:32,020 --> 00:12:34,940
!أتوسّل إليك أن تتوقّفي

167
00:12:34,940 --> 00:12:35,650
...لن

168
00:12:35,650 --> 00:12:36,150
...يحدث

169
00:12:36,150 --> 00:12:37,310
!ذلك

170
00:12:38,020 --> 00:12:41,740
كيف؟ كيف يمكنك فعل شيء كهذا؟

171
00:12:42,490 --> 00:12:44,490
ربّما من أجل العدالة؟

172
00:12:45,740 --> 00:12:48,620
.هذه ليست عدالة

173
00:12:48,620 --> 00:12:53,160
.فهمت. عدالتك وعدالتنا مختلفتان

174
00:12:53,160 --> 00:12:56,250
.ذلك لا يهمّ من الأساس. سأكمل عملي

175
00:12:56,540 --> 00:13:02,210
،حسنًا، سأقتل التّلميذة الشّرفيّة أوّلاً
!ومن بعدها يحين دور المُعلّمة

176
00:13:02,710 --> 00:13:07,970
ثمّ سيحين دورك أخيرًا. افقدي كلّ أمل
.لك في هذا العالم قبل أن تلقي حتفك

177
00:13:09,640 --> 00:13:10,430
لماذا...؟

178
00:13:15,940 --> 00:13:20,270
لماذا العالم ممتلئ باليأس؟

179
00:13:20,520 --> 00:13:23,530
.هذا كلّه بسبب المُعلّمين

180
00:13:24,240 --> 00:13:25,530
...ولذلك السّبب

181
00:13:29,620 --> 00:13:33,330
!سأحرص على قتلكم جميعًا

182
00:13:36,160 --> 00:13:41,420
!انتهى أمركما الآن

183
00:13:59,150 --> 00:14:00,980
!مـ-من هذا؟

184
00:14:00,980 --> 00:14:01,650
!نارو

185
00:14:04,030 --> 00:14:04,650
!ماذا؟

186
00:14:05,490 --> 00:14:07,450
...يا إلهي

187
00:14:08,150 --> 00:14:11,410
.اذهبي والعبي بفنونك المدرسيّة وحدك

188
00:14:13,700 --> 00:14:15,870
...وإلاّ

189
00:14:17,910 --> 00:14:20,580
.ستقابلين أشخاصًا مثلي في طريقك

190
00:14:24,170 --> 00:14:26,550
.لا بأس. يا له من وجه جميل

191
00:14:27,010 --> 00:14:29,430
تعلو عيناه نظرة قاتلة يشوبها الجنون

192
00:14:29,430 --> 00:14:32,850
.وفم منحرف يكاد ييأس من العالم

193
00:14:33,930 --> 00:14:36,020
.أشتمّ نفس الرّائحة القوية منه

194
00:14:36,890 --> 00:14:42,270
أحسنت! ما رأيك أن ترافقنا
في رحلة صيد المعلّمة؟

195
00:14:42,610 --> 00:14:46,900
يا إلهي، ذوق القائدة المروع
.بدأ يؤثّر عليها مجدّدًا

196
00:14:46,900 --> 00:14:48,860
نارو، هل أنت بخير؟

197
00:14:48,860 --> 00:14:52,870
،فور أن يجذب أحد اهتمامها
.لا تستطيع منع نفسها من دعوته

198
00:14:52,870 --> 00:14:55,200
.نارو، لم تتأذيّ بتلك الشدّة

199
00:14:57,000 --> 00:15:00,920
!ما رأيك إذًا؟ واثقة أنّ الأمر سيكون ممتعًا

200
00:15:01,500 --> 00:15:04,460
.شكرًا على إنقاذنا جميعًا

201
00:15:04,460 --> 00:15:05,550
.أنتنّ تعترضن طريقي

202
00:15:06,460 --> 00:15:09,380
.خذيهما وارحلي الآن

203
00:15:10,090 --> 00:15:10,590
.حسنًا

204
00:15:12,010 --> 00:15:17,140
،أنت هناك! سنكون خمسة تمامًا إن انضممت إلينا

205
00:15:17,140 --> 00:15:20,850
!وسأمنحك الدرجة السوداء في عرض سينتاي

206
00:15:21,350 --> 00:15:24,690
هذا مغرٍ، صحيح؟ ما رأيك؟

207
00:15:26,980 --> 00:15:29,070
!أنت، كفّ عن تجاهلي

208
00:15:29,820 --> 00:15:31,450
!قل شيئًا

209
00:15:31,780 --> 00:15:33,700
شيئًا؟

210
00:15:46,920 --> 00:15:50,340
".شـ-يـ-ء"

211
00:15:54,470 --> 00:15:55,390
ماذا؟

212
00:15:56,010 --> 00:15:59,470
!أخبرتني أن أقول شيئًا للتّوّ، أليس كذلك؟

213
00:16:05,650 --> 00:16:08,230
حشرة على وشك أن تُسحق
!من قبل حشرة مثلها

214
00:16:10,940 --> 00:16:12,530
!القائدة

215
00:16:21,000 --> 00:16:22,620
مـ-من هذا الشّخص؟

216
00:16:22,620 --> 00:16:23,920
.إنه خطير

217
00:16:23,920 --> 00:16:26,000
حان وقت انسحاب تكتيكيّ؟

218
00:16:26,000 --> 00:16:29,130
!ستُخفّض درجتنا إن فعلنا ذلك

219
00:16:29,130 --> 00:16:30,380
ما العمل إذًا؟

220
00:16:30,380 --> 00:16:34,090
!أجل! مهاراتي لا تفلح عليه

221
00:16:34,090 --> 00:16:37,140
!لا أستطيع احتمال تذمّر كلتيكما معًا

222
00:16:37,760 --> 00:16:39,310
.سنستخدم هجومًا مركّبًا

223
00:16:40,430 --> 00:16:44,770
لم يسبق لأحد أن نجى من هجوم
نابشات مركّب، أليس كذلك؟

224
00:16:47,230 --> 00:16:48,570
...نحن النّابشات

225
00:16:48,980 --> 00:16:50,360
!الحصينات...

226
00:16:53,280 --> 00:16:54,820
!أنت! لم ننته بعد

227
00:17:03,290 --> 00:17:06,790
جيد. لا يمكنه التحرك من هناك
.إن لم يكن هنالك عامل احتكاك

228
00:17:06,790 --> 00:17:07,460
!نارو

229
00:17:07,710 --> 00:17:11,550
!انفجار الفنون

230
00:17:17,430 --> 00:17:19,970
!حسنٌ، جاهز

231
00:17:22,390 --> 00:17:23,140
!ياكو

232
00:17:34,990 --> 00:17:37,740
.تلميذتا الشّرف قد عادتا

233
00:17:38,110 --> 00:17:41,580
.لقد تأخّرتما كثيرًا. إنّه في الدّاخل بالفعل

234
00:17:42,160 --> 00:17:44,200
.تفاعل ثرميت سائل

235
00:17:44,870 --> 00:17:47,580
الحرارة النّاجمة عن هكذا تفاعل
.تبلغ 4000 درجة

236
00:17:47,580 --> 00:17:50,920
.أفترض أنّه لن تُخلّف أيّ شظايا عظميّة حتّى

237
00:17:51,420 --> 00:17:53,340
...مـ... مستحيل

238
00:17:54,050 --> 00:17:58,300
.العذراء الحديديّة... نهاية مناسبة لمجرمة وحشيّة

239
00:17:58,720 --> 00:18:00,930
.والآن، المعلّمة هي التّالية

240
00:18:00,930 --> 00:18:03,470
.علينا سحق آفات المعلّمة

241
00:18:03,470 --> 00:18:06,060
.التّوسّل لأجل حياتك لن ينفع

242
00:18:06,430 --> 00:18:09,650
.معلّمة، معلّمة... إليكنّ عنّي

243
00:18:13,860 --> 00:18:16,070
.بدءًا من الآن، "أنا" هو المعلّم

244
00:18:16,780 --> 00:18:20,530
.سأعلمكنّ الطّريقة الصّحيحة لتكنّ شرّيرات

245
00:18:20,910 --> 00:18:22,620
!صـ-صدقًا؟

246
00:18:22,620 --> 00:18:24,830
.كان هجومنا المركّب مثاليًّا

247
00:18:24,830 --> 00:18:25,750
.هذا غير ممكن

248
00:18:26,290 --> 00:18:27,710
من هذا الشّخص بالضّبط؟

249
00:18:28,080 --> 00:18:29,460
!"المسرّع"

250
00:18:30,170 --> 00:18:31,420
مسرّع"؟"

251
00:18:32,210 --> 00:18:33,420
.سمعت عنه من قبل

252
00:18:34,340 --> 00:18:35,760
...بشرة بيضاء

253
00:18:36,340 --> 00:18:37,720
...شعر أبيض

254
00:18:38,470 --> 00:18:39,380
...عينان حمراوان

255
00:18:39,930 --> 00:18:45,350
أ-أتقصدين أنّه... المصنّف الأوّل؟

256
00:18:46,600 --> 00:18:48,810
أهذه قدرة المستوى 5؟

257
00:18:51,150 --> 00:18:55,730
عجبًا، هل نفدت خدعكنّ الرّخيصة بالفعل؟

258
00:18:56,230 --> 00:19:01,160
.لِمَ تنظرن إليّ؟ بدأتنّ تحبطنني

259
00:19:07,870 --> 00:19:11,040
!فلتحتفلي! وجدت سريرًا جميلاً لأجلك

260
00:19:15,590 --> 00:19:20,930
هل تعلمين أنّ جسم الإنسان يملك
شيئًا يُدعى بالكهرباء البيولوجيّة؟

261
00:19:20,930 --> 00:19:25,050
!سوف أعدّل خاصّتك قليلاً. استمتعي

262
00:19:28,350 --> 00:19:33,350
.تظاهري أنّك مستمتعة على الأقلّ
لكن أظنّ أنّك لا تستطيعين، صحيح؟

263
00:19:33,980 --> 00:19:37,320
.لا يبدو أنّ هذا السّرير مريح

264
00:19:37,730 --> 00:19:39,400
!كيف تجرّأ على فعل ذلك بسيكي؟

265
00:19:39,400 --> 00:19:40,780
!ننتظر تعليماتك أيّتها القائدة

266
00:19:40,780 --> 00:19:42,240
!يجب أن نهزمه

267
00:19:42,240 --> 00:19:44,280
!أيّها الوغد

268
00:19:45,370 --> 00:19:46,410
!نارو، انتظري

269
00:19:46,410 --> 00:19:48,790
ما العمل؟ ما الذي "نستطيع" فعله؟

270
00:19:48,790 --> 00:19:52,080
!!فلتمت

271
00:19:57,210 --> 00:19:59,880
!أيفترض بنا أن نهزم المصنّف الأوّل؟

272
00:20:02,430 --> 00:20:03,930
.لم يكن ذلك ممتعًا

273
00:20:05,010 --> 00:20:06,640
.لا، ليس ممتعًا

274
00:20:09,020 --> 00:20:11,480
...ما كانت خدعةٌ رخيصةٌ كتلك أن

275
00:20:15,860 --> 00:20:17,440
.تفلح معي

276
00:20:17,690 --> 00:20:18,690
!نارو

277
00:20:19,480 --> 00:20:21,320
...أيّتها القائدة، إنّ سيكي ونارو

278
00:20:21,820 --> 00:20:26,660
المسرّع"... صاحب القدرات الخارقة"
...الأعظم في المدينة الأكاديمية

279
00:20:26,660 --> 00:20:28,790
...قدرته هي التّلاعب بالمتّجهات

280
00:20:28,950 --> 00:20:34,170
يمكنه أن يتحكّم بحرّيّة باتّجاه
...أيّ قوّة في العالم

281
00:20:30,450 --> 00:20:34,170
!عودي إلى رشدك! على كلتينا أن نفعل شيئًا بشأنه

282
00:20:34,460 --> 00:20:36,170
!أيّتها القائدة

283
00:20:36,540 --> 00:20:39,630
هل أفقدتها عقلها؟

284
00:20:42,590 --> 00:20:43,380
.بطيئة للغاية

285
00:20:54,480 --> 00:20:57,310
.بقيت وحدك

286
00:20:58,150 --> 00:21:03,280
بقدر شرّي، ليس من أسلوبي
.أن أهاجم طفلة عزلاء

287
00:21:04,490 --> 00:21:07,490
إذًا، ما العمل...؟

288
00:21:07,780 --> 00:21:12,950
!ماذا؟ قولي شيئًا

289
00:21:20,210 --> 00:21:24,670
.تخيّلي، طفلة صغيرة تحوم في الجوار مبلّلة سروالها

290
00:21:26,720 --> 00:21:31,680
،من بين الـ2.3 مليون شخص في المدينة الأكاديميّة
.فقط سبعة منهم في المستوى الخامس

291
00:21:31,680 --> 00:21:34,980
.مصادفة أحدهم أشبه بالفوز بأسوأ حظّ في اليانصيب

292
00:21:35,350 --> 00:21:40,110
.لا مكافأة، وعمولتنا من زبائننا ستنخفض حتمًا

293
00:21:46,450 --> 00:21:47,660
!"أيها "المسرّع

294
00:21:47,660 --> 00:21:48,200
ماذا؟

295
00:21:55,160 --> 00:21:57,040
هل انتهى الأمر؟

296
00:21:58,540 --> 00:22:02,840
سحقًا، لم يكن ذلك إعادة
تأهيل كافية، أليس كذلك؟

297
00:23:34,970 --> 00:23:36,970
في الحلقة القادمة

298
00:23:36,970 --> 00:23:39,980
تحميل