1
00:00:02,420 --> 00:00:04,700
،"منزل "أياكاشي

2
00:00:04,700 --> 00:00:07,110
."المعروفة أيضا بقاعة "أياكاشي

3
00:00:07,880 --> 00:00:10,950
.شقة فاخرة مع نظام الخدمة السرية الخاص بها

4
00:00:11,780 --> 00:00:13,450
،في الحقيقة

5
00:00:13,910 --> 00:00:17,910
إنه مبنى حيث يقيم فيه
.الـ "أتافست"، أحفاد الـ "يوكاي" سراً

6
00:00:18,720 --> 00:00:21,500
،محاطة من قبل غريبي الأطوار المقيمين هناك

7
00:00:21,940 --> 00:00:23,750
،لقد قابلته

8
00:00:25,040 --> 00:00:29,590
.عميلي في الخدمة السرية، ميكتسوكامي - كن

9
00:00:30,670 --> 00:00:34,860
اكتشفت أن الشخص الذي كنت أراسله في الماضي

10
00:00:34,860 --> 00:00:37,940
.كان هو، يتظاهر بأنه كاغيرو

11
00:00:37,940 --> 00:00:42,190
.بعد ذلك، برّر نفسه واعتذر

12
00:00:42,520 --> 00:00:46,810
.كانت لديه جميع الرسائل مخزنة بعناية جانباً

13
00:00:46,810 --> 00:00:50,990
،قال أنه لم يكن من المفترض أن يحتفظ بهم

14
00:00:50,990 --> 00:00:53,110
.لذا هو سيعيدهم إذا أردت

15
00:00:53,870 --> 00:00:56,670
.أخبرته أنه يمكنه الإحتفاظ بهم

16
00:00:56,670 --> 00:00:58,830
.لقد أرسلوا له، بعد كل شيء

17
00:00:59,170 --> 00:01:03,180
.عندما سمع ذلك، قابلني بابتسامة باكية أخرى

18
00:01:15,720 --> 00:01:20,010
.عندها اتخذت قراري

19
00:01:16,140 --> 00:01:18,720
عندها

20
00:01:17,430 --> 00:01:19,930
اتخذت

21
00:01:18,260 --> 00:01:20,760
.قراري

22
00:01:29,230 --> 00:01:31,020
ماذا تفعل؟

23
00:01:31,020 --> 00:01:32,940
.سورينوزوكا - سان

24
00:01:32,940 --> 00:01:35,310
أكان من المفترض أن تساعد اليوم؟

25
00:01:35,310 --> 00:01:36,950
هل تحتاج والدك لشيء ما؟

26
00:01:36,950 --> 00:01:37,880
.تفضل بالدخول

27
00:01:37,880 --> 00:01:39,850
.لـ-لا، أنا بخير

28
00:01:39,850 --> 00:01:40,700
هل أنت متأكد؟

29
00:01:40,700 --> 00:01:43,120
.لقد كنت ماراً فقط

30
00:01:46,080 --> 00:01:47,960
!سـ-سورينوزوكا - سان

31
00:01:48,260 --> 00:01:50,960
هل أنت متأكد من فعل هذا؟

32
00:01:50,970 --> 00:01:53,230
.سيلاحظ الناس أمرنا

33
00:01:53,230 --> 00:01:54,400
.لا تقلق

34
00:01:54,400 --> 00:01:56,820
،عندما يرى الناس شيئاً غير عادي

35
00:01:56,820 --> 00:01:59,220
.فهم يفقدون الوعي

36
00:01:59,220 --> 00:02:01,150
،حتى لو تم تصويرنا على الكاميرا

37
00:02:01,150 --> 00:02:03,600
.سينتهي بنا الأمر على شاشة التلفاز الخاصة عن الأساطير الحضرية

38
00:02:05,380 --> 00:02:06,730
.لا أعتقد أن الأمر بهذه البساطة

39
00:02:07,910 --> 00:02:09,350
.وها نحن ذا

40
00:02:10,810 --> 00:02:13,390
.لا يمكننا العودة من نفس الطريق الذي أتينا منه

41
00:02:13,390 --> 00:02:16,510
.ليس من الصواب أن تبحث عن مشاكل غير ضرورية

42
00:02:16,510 --> 00:02:18,530
.صحيح... آسف

43
00:02:19,220 --> 00:02:20,940
.لقد وبخني طفل

44
00:02:21,490 --> 00:02:23,130
،لا أعلم

45
00:02:23,130 --> 00:02:27,450
.لكنك بدوت وكأنك لا تريد أن تقابل والدك

46
00:02:27,450 --> 00:02:31,940
.إذا كنت قد إستخدمت الباب الأمامي، قد تراه في الصالة

47
00:02:31,940 --> 00:02:33,420
.سورينوزوكا - سان

48
00:02:33,420 --> 00:02:34,320
نعم؟

49
00:02:34,320 --> 00:02:39,640
أنت من الـ "أتافست"، تماماً مثل والدي، أليس كذلك؟

50
00:02:39,640 --> 00:02:41,550
.أجل. بالتأكيد

51
00:02:41,550 --> 00:02:45,720
،"الـ "أتافست" يتشاركون الصّفات مع أسلافهم الـ "يوكاي

52
00:02:45,720 --> 00:02:48,100
.وفي حالات نادرة، يمكنهم حتى أن يرثوا ذكرياتهم

53
00:02:48,100 --> 00:02:51,060
كيف يكون هذا مختلفاً عن التجسيد؟

54
00:02:51,060 --> 00:02:54,440
إذا مات أبي، هل سيتجسد من جديد؟

55
00:02:55,060 --> 00:02:58,830
في تجسيده التالي، هل سيتزوج شخص آخر غير أُمي

56
00:02:58,830 --> 00:03:01,640
ويصبح والد طفل آخر؟

57
00:03:01,640 --> 00:03:03,590
...مهلاً

58
00:03:03,590 --> 00:03:06,800
.كنت أتوقع نزاع بسيط بين الأب وابنه

59
00:03:06,800 --> 00:03:09,410
.هذا الطفل قلق بشأن بعض الأمور الغامضة

60
00:03:10,870 --> 00:03:12,830
منذ متى وأنت تفكر في ذلك؟

61
00:03:13,490 --> 00:03:15,740
.لقد اكتشفت ذلك للتو

62
00:03:15,740 --> 00:03:20,310
.كان البالغون يتحدثون و قالوا أن الـ "آتافيست" كانوا هكذا

63
00:03:22,950 --> 00:03:24,760
ماذا أستطيع أن أقول؟

64
00:03:24,760 --> 00:03:27,810
.أنت تفكر في المستقبل كثيراً

65
00:03:27,810 --> 00:03:30,860
.أنا لا أقلق حتى بشأن ما سأتناوله على العشاء

66
00:03:32,520 --> 00:03:34,900
!إذاً لندفن كبسولة الزمن

67
00:03:35,490 --> 00:03:37,730
.أنت وإفادتك ظهرتما من العدم

68
00:03:37,730 --> 00:03:42,520
!إذا كان الأمر يزعجك حقاً، فقط اكتب رسالة لوالدك

69
00:03:42,520 --> 00:03:44,990
لـ-لكن لماذا كبسولة الزمن؟

70
00:03:44,990 --> 00:03:46,590
أوه، هذا بالطبع

71
00:03:46,590 --> 00:03:49,750
.حتى يتمكن تجسيد كاواسومي - سان القادم من قرأتها

72
00:03:50,430 --> 00:03:53,120
تجسيد أبي... التالي؟

73
00:03:53,120 --> 00:03:54,090
.أجل

74
00:03:54,090 --> 00:03:57,510
"!فقط اكتب له "لا تتزوج شخصاً آخر غير أُمي

75
00:03:57,510 --> 00:04:01,760
"!أو، " أنا إبنك، ولا أحد يمكنه أن يأخذ مكاني

76
00:04:02,500 --> 00:04:05,930
...لكن... لكن

77
00:04:05,930 --> 00:04:06,930
...هوي

78
00:04:06,930 --> 00:04:10,100
.لا تقلق! سأتولى هذا

79
00:04:11,850 --> 00:04:14,300
!قبل أن نبدأ، دعونا نجتمع مع الآخرين

80
00:04:14,300 --> 00:04:17,940
.كل شيء أكثر متعة عندما نقوم بالأمر معاً

81
00:04:18,340 --> 00:04:19,780
كبسولة زمنية؟

82
00:04:19,780 --> 00:04:22,970
...أنا جانح، كما تعلمون. أشياء الأطفال مثل تلك

83
00:04:22,970 --> 00:04:26,830
.إذاً سأكتب واحدة لـ واتانوكي

84
00:04:27,630 --> 00:04:30,490
.سأكتب رسالة إلى تجسيد (واتانوكي) التالي

85
00:04:30,490 --> 00:04:31,750
...أوه، لكن

86
00:04:31,750 --> 00:04:37,240
ماذا لو لم نحبّ بعضنا البعض في حياتنا القادمة؟

87
00:04:37,240 --> 00:04:39,380
.ربما لن يقرأ رسالتي

88
00:04:41,630 --> 00:04:44,300
!أيتها الغبية! بالطبع سنحبّ بعضنا البعض

89
00:04:44,300 --> 00:04:46,470
!سأذهب لشراء مجموعة من الرسائل

90
00:04:46,470 --> 00:04:48,580
!استمتع بوقتك

91
00:04:48,580 --> 00:04:51,220
لكن كيف ستكون حياتي القادمة؟

92
00:04:51,220 --> 00:04:53,230
كيف تريدينها أن تكون؟

93
00:04:53,850 --> 00:04:56,480
.أريد أن أتجسد من جديد ككعكة محشوة

94
00:04:57,030 --> 00:05:03,040
،عجينة الفاصوليا، اللحم، البيتزا
...الشوكولاته البلجيكية، الكاسترد، الحساء

95
00:05:01,130 --> 00:05:03,040
الكاسترد هي حلوى تحضّر بتذويب الحليب والسكر ومكونات آخرى

96
00:05:03,040 --> 00:05:08,800
.الكعك المحشو دائماً لديه حشوة مليئة بالطعم الرائع

97
00:05:08,800 --> 00:05:13,760
.أتمنى لو كانت بطني مليئة بالطعام الرائع أيضاً

98
00:05:13,760 --> 00:05:16,640
.لكنكِ ستتناولين الطعام في النهاية

99
00:05:16,640 --> 00:05:20,750
.أريد أن أكل الطعام حتى في اللحظة التي أُؤكل فيها

100
00:05:23,530 --> 00:05:25,050
..هذه الأرض قاسية

101
00:05:26,720 --> 00:05:29,640
.أسرع. أحاول أن أكون صبورة

102
00:05:29,640 --> 00:05:30,720
.حسناً

103
00:05:30,720 --> 00:05:32,180
.سأساعد، أيضاً

104
00:05:32,180 --> 00:05:34,320
.أوه، شكراً

105
00:05:34,320 --> 00:05:38,290
.كما تعلمون، نحن الثلاثة نبدو تقريباً مثل العائلة

106
00:05:38,290 --> 00:05:39,980
.حتى لون أعيننا يبدو متشابها

107
00:05:40,900 --> 00:05:43,150
رين - رين، هل انتهيت من حفر الحفرة؟

108
00:05:43,280 --> 00:05:45,450
.لقد ملأناها للتو

109
00:05:46,370 --> 00:05:49,660
أعتقد أن الأوان قد فات الآن، لكن هل يسمح لنا بحفر حفرة هنا؟

110
00:05:50,270 --> 00:05:51,600
إنها أرض عامة، أليس كذلك؟

111
00:05:51,600 --> 00:05:53,640
.ليس كذلك، لا - لا

112
00:05:53,640 --> 00:05:56,830
هل هذه الشّقة محاطة بكل هذه المساحة؟

113
00:05:59,910 --> 00:06:01,340
!نحن في عداد الموتى

114
00:06:08,130 --> 00:06:10,550
.يـ-يا له من نقي القلب

115
00:06:11,010 --> 00:06:13,060
.إذاً هذا ما يحدث

116
00:06:13,060 --> 00:06:16,270
هل تريدين المشاركة، يا ريريشيو؟

117
00:06:16,950 --> 00:06:18,350
كبسولة زمنية؟

118
00:06:18,350 --> 00:06:20,360
هل أنت طفل؟

119
00:06:20,360 --> 00:06:23,250
هل تتوقع مني أن أشارك في الأمر في مثل عمرنا؟

120
00:06:23,250 --> 00:06:25,830
.حسناً، أنا لن أجبركِ

121
00:06:25,830 --> 00:06:26,550
.وداعاً

122
00:06:29,510 --> 00:06:33,680
.لقد صادف أن وضعت رسالة على طاولتي

123
00:06:33,680 --> 00:06:36,490
.من الأفضل أن أنضم إليكم

124
00:06:36,490 --> 00:06:38,120
بالصدفة، هاه؟

125
00:06:38,120 --> 00:06:40,340
!لا تأخذ الأمور بشكل خاطئ

126
00:06:40,340 --> 00:06:42,200
!إنها حقاً مصادفة

127
00:06:42,200 --> 00:06:45,020
!كنت أكتب رسالة لأوصلها مع علبة حلويات

128
00:06:45,020 --> 00:06:46,130
.حسناً، حسناً

129
00:06:46,840 --> 00:06:48,780
.لقد تغيرت حقاً، على ما أعتقد

130
00:06:48,780 --> 00:06:51,710
.في ذلك الوقت، لقد قد قلتِ "لا مانع لدي" أو شيء من هذا القبيل

131
00:06:53,460 --> 00:06:54,380
...أنا

132
00:06:54,380 --> 00:06:55,140
نعم؟

133
00:06:55,500 --> 00:07:03,060
...لقد كنت أفكر في أن التواصل أكثر ليس سيئاً

134
00:07:03,060 --> 00:07:04,690
.بـ-بل إنها فكرة جيدة

135
00:07:04,690 --> 00:07:08,880
،لا أستطيع علاج لساني الحادّ بين عشية وضحاها

136
00:07:08,880 --> 00:07:12,320
.لذا قد أتسبب في تعاستكم جميعاً

137
00:07:12,570 --> 00:07:14,200
.لا مانع لدي

138
00:07:14,200 --> 00:07:16,540
.أنا لا أهتم بذلك

139
00:07:18,710 --> 00:07:21,470
.إنه خطأك إذا ندمت على ذلك

140
00:07:21,470 --> 00:07:23,830
.طبعاً. هاتِ ما عندكِ

141
00:07:24,770 --> 00:07:27,510
أوني - ساما، يصنع كبسولة زمنية؟

142
00:07:27,510 --> 00:07:28,790
.أجل

143
00:07:28,790 --> 00:07:32,260
.قال أنه يمكنك الإنضمام، إذا أردت

144
00:07:32,600 --> 00:07:34,950
.أيضاً، هذا لك

145
00:07:35,960 --> 00:07:39,250
.بما أن البطيخة التي اشتريتها سقطت على الأرض

146
00:07:39,250 --> 00:07:41,730
.في كلتا الحالتين، لا شيء يذكر

147
00:07:41,730 --> 00:07:43,040
.على الإطلاق

148
00:07:43,040 --> 00:07:44,400
.أنا متأثر جداً

149
00:07:44,400 --> 00:07:48,780
.أما بالنسبة للبطيخة، فقد حافظت عليها بعناية لمنعها من التعفن

150
00:07:48,780 --> 00:07:50,530
.كلا، تناولها

151
00:07:50,530 --> 00:07:53,380
...على الرغم من ذلك، متى وجدت الوقت لـ

152
00:07:53,380 --> 00:07:56,290
.إشتريتها أثناء استراحة الغداء

153
00:07:56,290 --> 00:07:57,170
ماذا في ذلك؟

154
00:07:57,910 --> 00:08:00,160
هل خاطرت بذلك من أجلي؟

155
00:08:00,660 --> 00:08:02,760
.شكراً جزيلاً لكِ

156
00:08:02,760 --> 00:08:04,590
.سأحتفظ بها للأبد

157
00:08:04,590 --> 00:08:05,670
.تناولها. من فضلك

158
00:08:06,140 --> 00:08:08,760
.على أي حال، سأكون في الفناء

159
00:08:08,760 --> 00:08:09,980
الفناء؟

160
00:08:09,980 --> 00:08:13,180
هل ستساهمين أيضاً في صنع كبسولة الزمن؟

161
00:08:13,180 --> 00:08:15,070
نـ-نعم، هل هناك مشكلة في ذلك؟

162
00:08:15,070 --> 00:08:17,840
هل تم إجباركِ رغماً عنكِ؟

163
00:08:17,840 --> 00:08:22,800
.لـ-لا، ليس هذه المرة على الأقل

164
00:08:24,030 --> 00:08:25,980
.آسفة على التصرف بغير العادة

165
00:08:25,980 --> 00:08:31,110
إذاً هل يمكنني أن أطلب منكِ أن تنتظري للحظة عندما تصلين إلى الفناء؟

166
00:08:32,320 --> 00:08:34,340
.سأنضم إليكم بعد قليل

167
00:08:37,840 --> 00:08:41,530
.يجب أن تتفاعلي أكثر مع الآخرين

168
00:08:41,530 --> 00:08:46,970
،لكنكِ تتعلمين ذلك بالعيش بين الآخرين
.وبالألم والتألم على طول الطريق

169
00:08:46,970 --> 00:08:49,360
.لقد تغيرت حقاً، على ما أعتقد

170
00:08:49,360 --> 00:08:53,340
.أتيت إلى هنا لأكون، لكن انظروا إلي الآن

171
00:08:56,130 --> 00:08:58,680
.لقد بدأت البحث عن التفاعل

172
00:08:58,680 --> 00:09:00,720
...الآن بعد أن قابلت أناساً هنا

173
00:09:04,190 --> 00:09:05,850
...الآن بعد أن قابلته

174
00:09:06,750 --> 00:09:08,310
.أريد أن أتغير

175
00:09:08,310 --> 00:09:10,780
،ربما سوف أؤذيهم

176
00:09:10,780 --> 00:09:13,440
.وربما سيؤذونني

177
00:09:13,440 --> 00:09:17,870
.مع ذلك، لن أعزل نفسي كشخص جبان

178
00:09:18,370 --> 00:09:21,160
،أريد أن أعمل على أن أصبح شخصاً أفضل

179
00:09:21,160 --> 00:09:23,710
.جنباً إلى جنب مع ميكتسوكامي - كن

180
00:09:27,040 --> 00:09:28,960
إذا عن ماذا كتبتِ؟

181
00:09:29,800 --> 00:09:33,390
.لـ-لا أعرف كيف سأكون في حياتي التالية

182
00:09:33,390 --> 00:09:35,990
.في الوقت الراهن، لقد كتبت عن أهدافي الحالية فحسب

183
00:09:35,990 --> 00:09:37,320
.هكذا إذاً

184
00:09:37,320 --> 00:09:40,580
.أنتِ على حق. لا أحد يعرف

185
00:09:43,780 --> 00:09:45,180
كوتارو؟

186
00:09:45,180 --> 00:09:47,230
كنت هنا، أيضاً؟

187
00:09:47,230 --> 00:09:48,820
.أجل

188
00:09:48,820 --> 00:09:50,650
ماذا بشأن تلك الوضعية؟

189
00:09:50,650 --> 00:09:55,010
.طائر صغير أخبرني أنك سترسل رسالة باستخدام الكبسولة الزمنية

190
00:09:55,010 --> 00:09:56,860
.عاطفيّ جداً

191
00:09:58,080 --> 00:10:00,870
،أنا أكتب رسالة إلى تجسيدك التالي

192
00:10:01,250 --> 00:10:04,780
.لكني لست متأكداً عما يجب أن أكتب

193
00:10:04,780 --> 00:10:07,440
هل تجسيدي التّالي سيكون أنا حقاً؟

194
00:10:08,360 --> 00:10:12,170
.بالكاد يمكنك كتابة رسالة لقطة عجوزة لم تقابلها من قبل

195
00:10:15,250 --> 00:10:20,660
الناس تتشكل بتصرفاتهم وتفاعلهم مع بعضهم
.البعض، والعواطف التي يصادفونها في الحياة

196
00:10:20,660 --> 00:10:23,440
،لو لم أقابل أمك أو أنت

197
00:10:23,440 --> 00:10:25,060
.لن أكون على سجيتي بعد الآن

198
00:10:26,070 --> 00:10:28,440
أكان ذلك عاطفياً للغاية؟

199
00:10:29,780 --> 00:10:31,440
.هكذا إذاً

200
00:10:31,980 --> 00:10:35,410
.أبي سيكون دائماً على سجيتك، يا أبي

201
00:10:37,730 --> 00:10:40,470
!و نهاية سعيدة للجميع، على ما أعتقد

202
00:10:40,470 --> 00:10:42,490
لماذا تبدو راضياً عن نفسك؟

203
00:10:42,490 --> 00:10:44,480
كنت تعرف شيئاً، أليس كذلك؟

204
00:10:45,360 --> 00:10:47,080
إذا أنت رجل صالح حقاً؟

205
00:10:47,080 --> 00:10:47,860
هاه؟

206
00:10:47,860 --> 00:10:51,090
.لقد جعلتني أقلق بشأن ما كنت تخطط له في البداية

207
00:10:51,960 --> 00:10:54,750
هل أنت متأكد أنه ليس متطفلاً فحسب؟

208
00:10:56,280 --> 00:10:58,740
...أتسائل إذا

209
00:10:58,740 --> 00:10:59,380
.عذراً

210
00:10:59,990 --> 00:11:02,140
ماذا تظنون أنكم فاعلون؟

211
00:11:02,940 --> 00:11:04,360
من المسؤول عن هذا؟

212
00:11:04,360 --> 00:11:05,390
!من

213
00:11:05,820 --> 00:11:07,340
.هو من أطلعني على ذلك

214
00:11:07,340 --> 00:11:07,930
.هو من اقترح ذلك

215
00:11:09,170 --> 00:11:09,810
!أنا؟

216
00:11:09,810 --> 00:11:11,230
!يبدو هذا ممتعاً

217
00:11:14,670 --> 00:11:16,730
!أريد أن أقوم بمبيعات زمنيّة، أيضاً

218
00:11:16,730 --> 00:11:18,920
."تقصدين "كبسولة الزمن

219
00:11:18,920 --> 00:11:24,300
.إنه صندوق متين تخزن فيه رسائل للناس في المستقبل

220
00:11:25,140 --> 00:11:27,450
!المتحول جنسياً يعرف كل شيء

221
00:11:28,460 --> 00:11:30,410
...أنتِ حقاً

222
00:11:30,800 --> 00:11:33,790
.حسناً، أعتقد أنه قد فات الأوان إذا كنتم قد حفرتم بالفعل

223
00:11:34,320 --> 00:11:36,470
.فقط تأكدوا من ملئها بعد ذلك

224
00:11:36,470 --> 00:11:38,460
!أراكم لاحقاً

225
00:11:38,460 --> 00:11:41,380
حسناً، هل هذا كل شيء؟

226
00:11:41,380 --> 00:11:42,540
.مهلاً

227
00:11:42,540 --> 00:11:44,130
.نحن ننتظر ميكتسوكامي - كن

228
00:11:45,460 --> 00:11:47,270
.ريريشيو

229
00:11:47,270 --> 00:11:49,600
هل وضعتِ هذه الرسالة بالخطأ؟

230
00:11:50,500 --> 00:11:53,000
.إعتقدت بأنكِ كنتِ ستعطينها لـ ميكتسوكامي - سان

231
00:11:53,000 --> 00:11:55,360
كانت من أجل صندوق الحلوى، أليس كذلك؟

232
00:11:55,910 --> 00:11:59,940
.لابد أنكِ وضعتِ رسالة كبسولة الزمن في الصندوق بدلاً من ذلك

233
00:12:00,730 --> 00:12:01,900
.هذا محرج

234
00:12:02,270 --> 00:12:03,820
ماذا كتبتي فيه؟

235
00:12:03,820 --> 00:12:07,540
.مع ذلك، لن أعزل نفسي كشخص جبان

236
00:12:07,540 --> 00:12:10,140
،أريد أن أعمل على أن أصبح شخصاً أفضل

237
00:12:10,140 --> 00:12:12,960
.جنباً إلى جنب مع ميكتسوكامي - كن

238
00:12:15,670 --> 00:12:17,630
ما سبب هذا فجأةً؟

239
00:12:17,630 --> 00:12:19,570
ما الأمر، يا ريريشيو - تشان؟

240
00:12:19,570 --> 00:12:22,230
.لم أركِ هكذا منذ فترة

241
00:12:22,230 --> 00:12:25,080
.ربما لم يقرأ الرّسالة بعد

242
00:12:25,080 --> 00:12:26,430
...على أي حال، يمكنكِ أن تحاولي الاتصال

243
00:12:27,520 --> 00:12:29,820
.إستخدام سريع للأصابع، بالنسبة لمبتدئ

244
00:12:30,950 --> 00:12:31,500
مرحباً؟

245
00:12:31,500 --> 00:12:32,980
!لا تقرأ الرسالة

246
00:12:36,800 --> 00:12:37,940
.لقد قرأتها بالفعل

247
00:13:13,240 --> 00:13:14,180
...كيف

248
00:13:14,910 --> 00:13:16,850
كيف وصل الأمر إلى هذا الحد؟

249
00:13:18,180 --> 00:13:21,390
،أستطيع تقريباً تخمين ما كتبتهِ

250
00:13:21,390 --> 00:13:23,160
.لكن لا تقلقي

251
00:13:23,160 --> 00:13:24,960
.على الأرجح أنه يبادلكِ نفس الشعور

252
00:13:24,960 --> 00:13:26,260
.لا تفزعي الآن

253
00:13:26,260 --> 00:13:28,560
.يا إلهي، إنهم يكبرون بسرعة

254
00:13:28,560 --> 00:13:30,100
أأنتِ متأكدة من ذلك؟

255
00:13:30,100 --> 00:13:33,310
ربما كل ما يشعر به (سو - تان) هو إخلاص محترم؟

256
00:13:33,310 --> 00:13:35,760
.لا تنسي، إنه أكبر منكِ بسبع سنوات

257
00:13:35,760 --> 00:13:39,390
.لكنني أشك أنه من الرجال الذين لديهم هواجس حول ذلك

258
00:13:39,390 --> 00:13:41,100
...كم هذا مثير للقلق

259
00:13:41,100 --> 00:13:41,800
أتريد قليلاً؟

260
00:13:41,800 --> 00:13:43,050
!المتحرش بالأطفال

261
00:13:43,050 --> 00:13:45,210
!عنوان مناسب لذلك الثعلب اللقيط

262
00:13:45,680 --> 00:13:48,210
.لا بأس، هوني عليكِ

263
00:13:48,210 --> 00:13:50,700
،على أي حال، إذا كنتِ ما زلتِ تنتظرين هنا

264
00:13:50,700 --> 00:13:52,950
ألن يظهر سو - تان؟

265
00:13:54,070 --> 00:13:55,720
!أنا لست مستعدة لمواجهته

266
00:13:55,720 --> 00:13:56,840
!أنا ذاهبة في رحلة

267
00:13:58,020 --> 00:13:59,270
!استمتعي برحلتكِ

268
00:14:00,060 --> 00:14:02,160
كيف وصل الأمر إلى هذا الحد؟

269
00:14:02,160 --> 00:14:04,610
!وكأنني اعترفت بأنني أكن مشاعرا له

270
00:14:04,610 --> 00:14:06,770
...لم تكن هذه غايتي على الإطلاق

271
00:14:07,130 --> 00:14:11,340
.إلى جانب ذلك، أنا آخر شخص كنت أتوقع أن تعترف بمشاعرها

272
00:14:11,910 --> 00:14:13,260
ماذا قلت؟

273
00:14:13,260 --> 00:14:14,460
.لا تتحمس كثيراً

274
00:14:14,460 --> 00:14:17,830
!يوماً بعد يوم، أفعل عكس ما أريد تماماً

275
00:14:18,250 --> 00:14:24,340
.ليس الأمر كما لو كنت أتخيل علاقة عاطفية

276
00:14:24,340 --> 00:14:26,210
.أنا شاكرة له

277
00:14:27,770 --> 00:14:30,330
.لقد جعلني أرغب في التغيير

278
00:14:30,330 --> 00:14:32,380
.أعطاني الشجاعة لذلك

279
00:14:32,380 --> 00:14:36,550
،لهذا أريد أن أصبح شخصاً أفضل

280
00:14:36,550 --> 00:14:40,020
.لأرد له الجميل، على الأقل قليلاً

281
00:14:41,840 --> 00:14:44,480
.نسيت أنني تركت هاتفي مطفأ

282
00:14:44,830 --> 00:14:48,570
.يجب أن أمنحه طريقة لتواصل معي، ليتأكد من سلامتي

283
00:14:48,570 --> 00:14:51,030
.وإلا كنت سأمنعه من القيام بواجبه

284
00:14:54,680 --> 00:14:56,910
!لـ-لقد اتصل في اللحظة التي شغلت فيها هاتفي

285
00:14:57,220 --> 00:15:00,160
...لـ-ليست لدي خطة بعد

286
00:15:00,640 --> 00:15:03,120
!أنا بأمان! لا تأتي للبحث عني

287
00:15:03,120 --> 00:15:04,590
.هذا يبدو مريباً جداً

288
00:15:04,590 --> 00:15:06,600
.يجب أن أحل جذور المشكلة

289
00:15:06,600 --> 00:15:08,700
.لم يكن هناك أي مقصد من تلك الرسالة

290
00:15:08,700 --> 00:15:11,770
.لم تكن قادراً على الاتصال بي لأن هاتفي لم يكن لديه أي إشارة

291
00:15:11,770 --> 00:15:13,790
!أنا أختلق الأعذار هذا واضح

292
00:15:13,790 --> 00:15:15,360
ماذا؟ الرسالة؟

293
00:15:15,360 --> 00:15:16,710
.لم تكن تعني أي شيء مميز

294
00:15:16,710 --> 00:15:18,420
...لنغير الموضوع إذاً

295
00:15:18,420 --> 00:15:19,550
من تكون هذه؟

296
00:15:19,990 --> 00:15:23,180
.على أي حال، يجب أن أجيب قبل أن يغلق الخط

297
00:15:23,180 --> 00:15:25,730
.سأشرح بنفسي و بكل هدوء

298
00:15:26,180 --> 00:15:28,020
!لم يكن هناك أي مقصد من تلك الرسالة

299
00:15:28,640 --> 00:15:29,050
...ريريشـ

300
00:15:29,050 --> 00:15:30,090
أنا ببساطة قصدت

301
00:15:30,090 --> 00:15:34,620
!كنت آمل أن نحظى بعلاقة مهنية طويلة ورائعة

302
00:15:34,620 --> 00:15:36,240
أين أنتِ الآن؟

303
00:15:36,240 --> 00:15:38,510
متنزه سيجو! ماذا في ذلك؟

304
00:15:38,510 --> 00:15:42,780
على أي حال، لا أكن لك أي مشاعر خاصة على الإطلاق، حسناً؟

305
00:15:42,780 --> 00:15:44,450
.أجل. أنا مدرك لذلك

306
00:15:45,280 --> 00:15:46,920
أ-أنت مدرك؟

307
00:15:46,920 --> 00:15:47,790
.أجل

308
00:15:47,790 --> 00:15:52,070
.مـ-مستحيل. حتى أنا كنت أعرف أن هذا عذر سخيف

309
00:15:52,070 --> 00:15:53,380
حـ-حقاً؟

310
00:15:54,020 --> 00:15:55,300
.أجل

311
00:15:55,300 --> 00:15:57,960
.بعد كل شيء، لقد قلتِ ذلك بنفسكِ

312
00:15:57,960 --> 00:16:01,430
.بالإضافة إلى أنني لست وقحاً لهذه الدرجة

313
00:16:01,900 --> 00:16:04,370
.أنا أعرف موقفي

314
00:16:04,370 --> 00:16:08,520
.طبيعتي، مكانتي والأفعال التي إرتكبتها للوصول إلى هنا

315
00:16:08,930 --> 00:16:14,560
.لقد فعلت أشياء لا أجرؤ على إخباركِ عنها

316
00:16:15,760 --> 00:16:21,870
.بعد كل ذلك، أنا سعيد لكوني بجانبكِ فحسب

317
00:16:22,210 --> 00:16:27,040
.أنتِ ترسلين رسائل موجهة إليّ و ليس لأحد آخر

318
00:16:27,040 --> 00:16:29,170
.أنتِ لا تعرفين كم يعني لي هذا

319
00:16:29,170 --> 00:16:31,460
.لا يمكنني طلب سعادة أكثر من هذا

320
00:16:31,460 --> 00:16:32,880
...هـ-هذا ليس

321
00:16:32,880 --> 00:16:34,250
...وحتى الآن

322
00:16:34,250 --> 00:16:37,450
،على الرغم من أنني أتحدث كما لو كنتِ شيئاً مقدساً

323
00:16:37,450 --> 00:16:41,180
.ما زلت أعاني من أوهام في سعادة العظمى

324
00:16:42,110 --> 00:16:44,320
.أنا لا أرغب في ذلك

325
00:16:44,320 --> 00:16:46,220
لكن الخيال حر، أليس كذلك؟

326
00:16:47,000 --> 00:16:48,590
هل تفهمين؟

327
00:16:48,590 --> 00:16:50,020
.هذا هو نوع الأشخاص الذي أنا عليه

328
00:16:51,100 --> 00:16:52,610
.هكذا إذاً

329
00:16:52,610 --> 00:16:54,190
،ميكتسوكامي - كن

330
00:16:54,850 --> 00:16:57,860
أنت تكره نفسك، أليس كذلك؟

331
00:16:58,610 --> 00:17:01,300
.في مكان ما بداخلي، كنت أعلم

332
00:17:01,300 --> 00:17:05,120
.كنت دائماً بطريقة أو بأخرى تتصرف بازدراء من نفسك

333
00:17:05,120 --> 00:17:07,850
.كانت لديك تلك النظرة الهامدة في عينيك

334
00:17:07,850 --> 00:17:09,950
.بدوت وحيداً

335
00:17:09,950 --> 00:17:11,250
.أعرف ذلك

336
00:17:11,250 --> 00:17:13,040
.بالطبع أعرف ذلك

337
00:17:13,040 --> 00:17:16,520
.أنا أكره نفسي، أيضاً

338
00:17:17,400 --> 00:17:19,820
.لكنني أريد أن أتغير الآن

339
00:17:19,820 --> 00:17:24,430
.بعد أن وقعت في حبك، اكتسبت الشجاعة

340
00:17:24,430 --> 00:17:26,290
.أنت من منحها لي

341
00:17:37,190 --> 00:17:38,710
.ريريشيو - ساما

342
00:17:42,660 --> 00:17:44,060
!أنا خائفة

343
00:17:44,060 --> 00:17:49,860
.لكنني بالفعل آذيت الكثير من الناس من أجل حماية نفسي

344
00:17:49,860 --> 00:17:53,670
،لهذا، إذا لم أتمكن من منحك حتى القليل من الشجاعة

345
00:17:53,670 --> 00:17:56,890
.لا يهمني إن تأذيت هذه المرة

346
00:17:57,810 --> 00:17:58,630
.أحبك

347
00:18:00,130 --> 00:18:05,800
...حتى لو... لم تكن... تحب نفسك

348
00:18:06,790 --> 00:18:10,040
.أنا... أحبك

349
00:18:08,530 --> 00:18:09,310
...ريـ

350
00:18:10,040 --> 00:18:11,090
.أحبك

351
00:18:14,980 --> 00:18:16,310
!أحبك

352
00:18:18,100 --> 00:18:19,060
...أنا

353
00:18:25,430 --> 00:18:27,160
!ريريشيو - ساما

354
00:18:27,160 --> 00:18:29,050
.أنا أحبكِ، أيضاً

355
00:18:29,050 --> 00:18:30,330
!أنا أحبكِ

356
00:18:30,330 --> 00:18:33,350
!ريريشيو - ساما، أنا أحبكِ

357
00:18:33,350 --> 00:18:34,450
...أنا أحبكِ

358
00:18:38,090 --> 00:18:39,550
...أنا أحبكِ

359
00:18:42,380 --> 00:18:49,300
.إذا إستطاعت كلماتي أن تمنحك الشجاعة، فسأكون سعيدة

360
00:18:50,600 --> 00:18:52,950
.لا شيء يمكنه أن يجعلني أكثر سعادة من هذا

361
00:18:57,840 --> 00:18:59,750
!الكبار يفعلون أشياء قذرة

362
00:18:59,750 --> 00:19:01,440
!رائع

363
00:19:01,440 --> 00:19:03,060
...إ-إنهم يراقبون

364
00:19:03,060 --> 00:19:04,160
...مـ-مكيـ

365
00:19:04,160 --> 00:19:05,110
.نعم

366
00:19:06,180 --> 00:19:07,990
!لا تستنشق نفسي

367
00:19:07,990 --> 00:19:10,360
!هذا ليس جيداً لتعليم الأطفال أشياء عاطفية

368
00:19:10,360 --> 00:19:11,680
.أ-أنزلني

369
00:19:11,680 --> 00:19:14,930
.ريريشيو - ساما، هذا مثل حلم تحقق

370
00:19:14,930 --> 00:19:16,460
...هل تستمع حتى؟! أنزلني

371
00:19:16,460 --> 00:19:23,340
عندما قرأت رسالتكِ، أخبرت نفسي بأنني
.لا أستطيع الوصول إلى استنتاجات واضحة

372
00:19:23,340 --> 00:19:26,720
.وإلا لفقدت السيطرة على نفسي

373
00:19:28,200 --> 00:19:29,550
،في الحقيقة

374
00:19:30,720 --> 00:19:34,070
.كنت سعيداً جداً، كان يمكن أن أموت بسبب ذلك

375
00:19:48,700 --> 00:19:50,490
.سأذهب لشراء بعض المثلجات

376
00:19:50,950 --> 00:19:53,150
إذا ما الذي تأكلينه الآن؟

377
00:19:53,150 --> 00:19:55,410
.هذه مثلجات ناعمة

378
00:19:53,150 --> 00:19:55,410
مثلجات ناعمة هي حلوى الألبان المجمدة، تشبه المثلجات ولكن أنعم وأقل كثافة

379
00:19:55,450 --> 00:19:58,620
!لقد عدت، يا أيتها الآواني البشرية

380
00:19:58,620 --> 00:20:00,910
.أولئك الفتية يخيمون على الشاطئ

381
00:20:00,910 --> 00:20:02,250
.مسرحية الهجر، سادي

382
00:20:03,970 --> 00:20:06,130
!لقد وجدتكم، يا ماشيتي

383
00:20:06,130 --> 00:20:08,810
هل ظننتم أن بإمكانكم الهرب مني؟

384
00:20:08,810 --> 00:20:10,340
.إنه كاغ - ساما

385
00:20:10,340 --> 00:20:13,600
!ماذا تفعل... هنا بحق السماء؟

386
00:20:13,600 --> 00:20:16,930
انزل إلى هنا، إذا كنت تريد المشاركة في المتعة، أليس كذلك؟

387
00:20:17,770 --> 00:20:19,730
.قطع ذلك الحبار من أجلي

388
00:20:19,730 --> 00:20:21,400
!ريريشيو - تشان

389
00:20:22,040 --> 00:20:24,570
.اسمحي لي بوضع واقي للشمس عليكِ

390
00:20:24,570 --> 00:20:26,400
!يرتدي ملابس إمرأة

391
00:20:26,400 --> 00:20:29,120
!إنه الفخ المفضل للجميع

392
00:20:28,670 --> 00:20:31,450
!رائع! رائع! رائع

393
00:20:29,120 --> 00:20:31,450
.أنت تبدو أكثر من رائع، يا واتانوكي - سان

394
00:20:32,950 --> 00:20:35,680
كيف كان اختباركما؟

395
00:20:36,620 --> 00:20:40,530
.ليس سيئاً. أعتقد أن جلسة دراستنا كانت تستحق العناء

396
00:20:40,530 --> 00:20:43,880
...لقد صادروا وجباتي الخفيفة

397
00:20:43,880 --> 00:20:46,360
إلى أين سنذهب اليوم؟

398
00:20:46,360 --> 00:20:47,550
...حـ-حسناً

399
00:20:48,000 --> 00:20:50,790
.ريريشيو - ساما تبدين رائعة في زيكِ

400
00:20:52,050 --> 00:20:52,970
.تفضلي شرابك

401
00:20:53,400 --> 00:20:54,390
.ميكتسوكامي - كن

402
00:20:54,390 --> 00:20:57,580
.سـ-سأستخدم حمامك

403
00:20:57,580 --> 00:20:58,560
.تفضلي

404
00:21:05,810 --> 00:21:07,200
.لقد عثرتي عليها

405
00:21:08,210 --> 00:21:11,590
قلت أنكِ تحبينني كما أنا عليه، أليس كذلك؟

406
00:21:11,590 --> 00:21:13,490
!لم أكن أعلم أنك هكذا

407
00:21:46,750 --> 00:21:48,300
.ريريشيو - ساما

408
00:21:49,890 --> 00:21:52,740
.هناك شيء واحد لطالما حلمت به

409
00:21:52,740 --> 00:21:54,160
حلم؟

410
00:21:54,160 --> 00:21:55,310
ما هو؟

411
00:21:56,550 --> 00:21:58,330
.لا أكترث إن كذبتِ علي

412
00:21:59,340 --> 00:22:03,280
.لا أكترث إن كانت كذبة بيضاء صغيرة ستختفي غداً

413
00:22:04,150 --> 00:22:06,030
،ريريشيو - ساما

414
00:22:06,030 --> 00:22:07,580
.أريد أطفالاً

415
00:22:08,590 --> 00:22:10,920
.أريد عائلة

416
00:22:11,660 --> 00:22:12,820
...يوما ما

417
00:22:15,840 --> 00:22:17,710
،على الرغم من أنني لم أرها من قبل

418
00:22:17,710 --> 00:22:22,180
.صورة لطفولتك البعيدة طفت في ذهني

419
00:22:22,180 --> 00:22:23,440
.مجرد صورة

420
00:22:24,810 --> 00:22:26,050
.هكذا إذاً

421
00:22:27,580 --> 00:22:30,810
.كنت وحيداً جداً ومتألماً جداً

422
00:22:32,050 --> 00:22:33,330
.هكذا إذاً

423
00:22:36,350 --> 00:22:39,990
.لكنني لا أريد أن أجيبك بشكل طائش

424
00:22:39,990 --> 00:22:41,800
.هذه مسألة مهمة، بعد كل شيء

425
00:22:42,800 --> 00:22:44,500
.ريريشيو - ساما

426
00:22:45,660 --> 00:22:49,000
.أجل. هذا يجعلني أكثر سعادة

427
00:22:49,430 --> 00:22:53,720
.دعنا نقضي أياماً عديدة لنفكر في الأمر معاً

428
00:22:57,150 --> 00:22:59,820
.الوقت يعني كل شيء

429
00:22:59,820 --> 00:23:01,350
.هذا ما أؤمن به

430
00:23:03,090 --> 00:23:06,290
.الوقت الذي أحضر فيه (ريريشيو - ساما) إلى هنا

431
00:23:07,650 --> 00:23:11,810
.الوقت الذي أحضر فيه (ميكتسوكامي - كن) إلى هنا

432
00:23:14,140 --> 00:23:18,270
.سوف نتذكرهم في كثير من الأحيان في الأيام القادمة

433
00:23:19,050 --> 00:23:22,080
...هذه القصة ستمتد لوقت أبعد

434
00:23:23,730 --> 00:23:30,550
.لوقت أبعد جداً سنواجه الأمور معاً