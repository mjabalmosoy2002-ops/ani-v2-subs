1
00:00:03,660 --> 00:00:06,690
تتواجد في هذه القلعة ثلاث
،بوّابات، ثمّ حصن القلعة

2
00:00:06,690 --> 00:00:10,800
،وبرج القلعة في النّهاية
.حيث أوجد حاليًّا

3
00:00:11,570 --> 00:00:17,320
سيُحدّد المنتصر في مسابقة
.بلو" هذه في برج القلعة"

4
00:00:17,320 --> 00:00:19,950
!سنفتح البوّابة الثّانية

5
00:00:26,670 --> 00:00:32,010
.سأغيّر قواعد المشاركة في هذه البوّابة

6
00:00:32,010 --> 00:00:33,970
،أنتم يا أعضاء نوار الثّلاثة

7
00:00:33,970 --> 00:00:38,100
.أروني إمكانياتكم الحقيقيّة الآن وهنا

8
00:00:50,480 --> 00:00:52,170
ما معنى هذا؟

9
00:00:52,170 --> 00:00:53,790
لماذا "نوار"؟

10
00:00:53,790 --> 00:00:55,820
.ظننتُ أنّ المشاركة في "بلو" للطّهاة العاديّين

11
00:00:55,820 --> 00:01:00,920
هدف مسابقة "بلو" هو التّنافس
،بين أفضل الطّهاة اليافعين

12
00:01:00,920 --> 00:01:07,500
لكن لديّ أسبابي الخاصّة لإقامة
.هذه المنافسة بالتّحديد

13
00:01:07,500 --> 00:01:09,170
أسباب خاصّة؟

14
00:01:09,530 --> 00:01:15,590
العثور على شخص بإمكانه إعداد طبق لم
.يصل إليه هذا العالم بعد

15
00:01:15,590 --> 00:01:18,670
.تذوّقت كلّ ما يُمكن تذوّقه في هذا العالم

16
00:01:18,670 --> 00:01:20,870
.ولم يعد أمامي سوى نهاية مسدودة

17
00:01:20,870 --> 00:01:24,880
لم يعد هنالك أحد في الخارج
.بإمكانه تحقيق أمنيتي

18
00:01:24,880 --> 00:01:26,230
هذا سبب "نوار"؟

19
00:01:26,640 --> 00:01:30,690
تطلّعاتي عالية فقط بالنّسبة لطهاة
.عالم الجريمة في هذا الحدث

20
00:01:31,730 --> 00:01:34,650
.أنا أقاتل في الجبهات الأماميّة في المطبخ

21
00:01:34,650 --> 00:01:36,320
ما الّذي لدى عالم الجريمة أفضل منّي؟

22
00:01:36,750 --> 00:01:40,160
.وأنا أتقزّز لرؤيتي طهاة من الخارج

23
00:01:41,390 --> 00:01:43,760
.هذا هو لحم متن البقر الّذي طلبتموه

24
00:01:43,760 --> 00:01:44,330
.جيّد

25
00:01:44,330 --> 00:01:47,210
إذًا تريدونني أن أعدّ طبق
ذوّاقة من ذلك اللّحم؟

26
00:01:47,710 --> 00:01:48,730
!حسنٌ

27
00:01:52,500 --> 00:01:55,500
.ما قصّتها؟ إنّها تعدّه بطريقة عاديّة

28
00:01:55,500 --> 00:01:57,130
وتقول أنّها أفضل منّا؟

29
00:01:58,460 --> 00:02:00,890
.لكنّها دقيقة للغاية بشأن الحرارة

30
00:02:01,450 --> 00:02:04,410
.تستعمل أومامي عصارة اللّحم عن آخرها

31
00:02:05,560 --> 00:02:06,970
!نيكومي؟

32
00:02:06,970 --> 00:02:08,020
!صه

33
00:02:08,020 --> 00:02:09,090
ميتو-سان؟

34
00:02:09,090 --> 00:02:10,550
ما الّذي تفعلينه هنا؟

35
00:02:10,550 --> 00:02:13,520
.تلقّت مجموعة ميتو طلبًا لتوفير بعض اللّحم

36
00:02:13,910 --> 00:02:16,280
إنّهم لا يسمحون بوجود مشاهدين في
،مسابقة "بلو" حتّى الحدث الرّئيسيّ

37
00:02:16,830 --> 00:02:19,660
لكن فكّرت في أنّني أستطيع التّحقّق منها
.بصفتي فردًا من عالم صناعة الطّعام

38
00:02:19,660 --> 00:02:21,400
.فهمت

39
00:02:21,400 --> 00:02:24,850
..."ولديّ بعض المعلومات عن "نوار

40
00:02:25,310 --> 00:02:26,660
.مِن إيزان-سينباي

41
00:02:26,660 --> 00:02:28,250
مِن إيزان-سينباي؟

42
00:02:28,250 --> 00:02:32,080
نعم. يبدو أنّه حصل عليها اعتمادًا
.على شبكته الخاصّة

43
00:02:32,080 --> 00:02:34,060
!فعلاً؟ هذا مدهش

44
00:02:34,060 --> 00:02:35,250
!الأمر أشبه بأحد أفلام الجاسوسيّة

45
00:02:35,250 --> 00:02:36,050
!صه

46
00:02:36,050 --> 00:02:37,260
.ستقوم بحركتها

47
00:02:37,260 --> 00:02:39,470
.حسنًا، فليبدأ المرح

48
00:02:42,710 --> 00:02:44,580
تستعمل ذلك للطّبخ؟

49
00:02:44,580 --> 00:02:45,910
.إنّها تمزح

50
00:02:45,910 --> 00:02:48,020
.مستحيل أن تستطيع استعمال منشار كهربائيّ

51
00:02:48,020 --> 00:02:50,510
.إيّاكم أن تصفوا هذا بالمنشار الكهربائيّ

52
00:02:50,510 --> 00:02:53,770
.هذا سكّين القطع خاصّتي

53
00:02:53,770 --> 00:02:57,560
.يبدو لي كسلاح أكثر ممّا يبدو أنّه سكّين

54
00:02:57,560 --> 00:02:59,360
ما الّذي تنوي فعله بذلك الشّيء؟

55
00:03:02,790 --> 00:03:06,870
لماذا تفسد اللّحم الّذي طهته بشكل مثاليّ؟

56
00:03:06,870 --> 00:03:08,540
.إنّها تفقده جودته

57
00:03:09,870 --> 00:03:13,530
...كلاّ... إنّها لا تفسده، بل إنّها

58
00:04:48,510 --> 00:04:49,970
.والآن، تذوّقوه

59
00:04:50,640 --> 00:04:52,810
.هذا طبق أعدّه فرد من عالم الجريمة

60
00:04:53,910 --> 00:04:54,770
.حسنًا

61
00:05:01,110 --> 00:05:02,070
!ماذا؟

62
00:05:02,500 --> 00:05:04,790
!إنّه مليء بالعصارة بشكل لا يصدّق

63
00:05:04,790 --> 00:05:09,280
إنّه يذوب في فمي، ولذّته
!تنفجر في جسدي بالكامل

64
00:05:10,240 --> 00:05:15,190
كلّما مضغته، تذوّقت النّكهة
!والمذاق الحلو والمالح أكثر

65
00:05:15,190 --> 00:05:17,190
!لم يعد هذا لحمًا حتّى

66
00:05:17,190 --> 00:05:19,960
لا أصدّق أنّها استطاعت جعل
!مذاقه بهذه اللّذّة

67
00:05:19,960 --> 00:05:24,030
عرفتُ ذلك. لا بدّ من سرّ ما في
.سكّين المنشار الكهربائيّ ذلك

68
00:05:24,030 --> 00:05:27,130
.صحيح. إنّه يتبّل اللّحم في الحقيقة

69
00:05:27,650 --> 00:05:32,100
وضعت توابل على كلّ مخلب
.من مخالب سكّينها

70
00:05:32,580 --> 00:05:35,320
،وبينما كان السّكّين يقطّع اللّحم

71
00:05:35,320 --> 00:05:38,560
دخلت تلك التّوابل إلى كلّ ليف
.من ألياف اللّحم

72
00:05:38,560 --> 00:05:41,740
تمكّنت من إعداد شيء لذيذ
على عدّة مستويات

73
00:05:41,740 --> 00:05:45,820
.ما كان ليُعدّ بالطّرق العاديّة

74
00:05:45,820 --> 00:05:50,460
مستحيل أن تستطيع إعداد شيء لذيذ
!هكذا بقيامها بشيء بتلك السّخافة

75
00:05:52,510 --> 00:05:53,580
!مستحيل

76
00:05:53,580 --> 00:05:57,040
!لذّته في مستوى خاصّ

77
00:05:59,300 --> 00:06:01,380
.هذا المذاق حقيقيّ

78
00:06:01,650 --> 00:06:03,320
،لو أنّها أخطأت ولو ببضعة ميلمترات

79
00:06:03,320 --> 00:06:05,720
،لتمزّقت ألياف اللّحم لأشلاء

80
00:06:05,720 --> 00:06:08,630
.ولدمّرت عصارة اللّحم وملمسه

81
00:06:08,630 --> 00:06:14,350
التّقنية الّتي استعملتها في هذا الطّبق
.كانت عنيفة، لكنّها أدّت هدفها بدقّة

82
00:06:14,350 --> 00:06:18,730
لا أستطيع إدراك كيف استطاعت
.القيام بالتّقطيع بعناية هكذا

83
00:06:18,730 --> 00:06:22,900
هذا طبق مدهش بالفعل
.لا يستطيع سواها تقديمه

84
00:06:23,450 --> 00:06:24,720
!أجبني

85
00:06:24,720 --> 00:06:29,200
هل يستطيع حثالة مثلكم إعداد ما هو أفضل؟

86
00:06:29,670 --> 00:06:33,660
طريقة الطّبخ هذه تتعدّى
...تاريخ الذّوّاقة

87
00:06:33,660 --> 00:06:35,870
!فرصنا معدومة

88
00:06:36,190 --> 00:06:38,250
!لا فائدة... إنّه لذيذ جدًّا

89
00:06:38,670 --> 00:06:41,580
!إنّها تمزّق كلّ شيء بينما تطيح بنا

90
00:06:41,580 --> 00:06:45,250
!كرامتنا وتقنياتنا وعقولنا

91
00:06:48,660 --> 00:06:50,470
.اسمها سارج

92
00:06:50,470 --> 00:06:53,260
إنّها خبيرة في استعمال سكّين
.التّقطيع المنشاريّ خاصّتها

93
00:06:53,260 --> 00:06:56,720
إنّها تدهش عقول كلّ
.من يأكل أطباقها وتدمّرهم

94
00:06:57,460 --> 00:07:00,750
!"يدعونها بخبيرة "الطّبق المسلّح

95
00:07:03,650 --> 00:07:09,160
حسنًا، ما قولكم؟ هل بإمكانكم
إعداد طبق يعادل طبقها؟

96
00:07:09,160 --> 00:07:11,110
.إن كنتم واثقين كفاية، فتحدّثوا الآن

97
00:07:11,580 --> 00:07:16,330
وإلاّ، فلا يحقّ لكم أن تخطوا
.خطوة واحدة في حصن القلعة

98
00:07:20,580 --> 00:07:21,710
...أساهي-ساما

99
00:07:21,710 --> 00:07:25,040
!تبدون محبطين جميعًا

100
00:07:25,040 --> 00:07:28,130
فلنقلب تلك النّظرات العابسة
!رأسًا على عقب بطبقي

101
00:07:29,090 --> 00:07:32,470
!أوّلاً، سأشذّب اللّحم! تقطيع، تقطيع، تقطيع

102
00:07:32,470 --> 00:07:35,800
!وسأرشّ وأرشّ الملح على اللّحم رشًّا رشًّا

103
00:07:41,840 --> 00:07:44,610
إنّها أوانٍ خاصّة تصبح كرات
.عند إضافتها لبعضها

104
00:07:44,610 --> 00:07:46,960
،يخلق كلّ ذلك الدّوران قوّةً نابذة

105
00:07:46,960 --> 00:07:49,820
وهنالك عنصر تسخين بالدّاخل
.يقوم بشيّ اللّحم

106
00:07:49,820 --> 00:07:53,840
ومعًا، تحافظ تلكما القوّتان
،على اللّحم تحت ضغط محدّد

107
00:07:53,840 --> 00:07:55,870
.وتسخّنه بشكل متساوٍ بالكامل

108
00:07:55,870 --> 00:07:57,540
،وبسبب ذلك

109
00:07:57,540 --> 00:08:02,040
يُمسي اللّحم ليّنًا أكثر من أيّ لحم
.قد يُطبخ في طنجرة ضغط عاديّة

110
00:08:03,620 --> 00:08:07,710
.احرصوا على أن تكونوا مهذّبين وأنتم تأكلون

111
00:08:07,710 --> 00:08:08,850
...مذهل

112
00:08:08,850 --> 00:08:11,280
.أنا واثق أنّ مذاقه لذيذ

113
00:08:11,280 --> 00:08:13,180
.مهرّج المطبخ ماركانتا

114
00:08:13,180 --> 00:08:15,690
!"خبير "طبق السّيرك

115
00:08:23,270 --> 00:08:25,770
ما هي تلك الآلة؟

116
00:08:26,250 --> 00:08:28,060
إنّ عضو "نوار" ذاك

117
00:08:28,060 --> 00:08:33,230
قادر على جعل أيّ دماء لحم
.تصبح أفضل مرق وأعظم تتبيل

118
00:08:33,950 --> 00:08:36,570
.إنّه يمصّ الدّم بسرعة كبيرة

119
00:08:37,110 --> 00:08:40,220
.الجلاّد القرمزيّ، كلود فيل

120
00:08:40,220 --> 00:08:41,750
."خبير "طبق الدّماء

121
00:08:42,660 --> 00:08:44,540
،حتّى في المطبخ الفرنسيّ

122
00:08:44,540 --> 00:08:47,750
.ثمّة العديد من الأطباق تبرز لذّة الدّماء

123
00:08:48,250 --> 00:08:51,000
لكن لا أصدّق أنّه أعدّ شيئًا رفيع
.المستوى بهذه السّرعة

124
00:08:51,510 --> 00:08:55,080
أحضرت عضوة "نوار" الأخرى
.شيئًا غريبًا أيضًا

125
00:08:55,080 --> 00:08:56,340
مِقصلة؟

126
00:08:58,750 --> 00:09:00,180
،لمعلوماتكم

127
00:09:00,180 --> 00:09:05,060
.كلّما عذّبت المكوّنات، زادت لذّتها

128
00:09:08,980 --> 00:09:15,360
!فلتصبحي الآن أكثر لذّة
!سأعذّبك أكثر وأكثر وأكثر

129
00:09:15,740 --> 00:09:18,250
،إنّها تقطّع اللّحم بشكل رفيع
!يكاد يكون شفّافًا

130
00:09:18,250 --> 00:09:19,700
!وتستعمل مِقصلة

131
00:09:19,700 --> 00:09:23,760
.انظروا لتلك العضلات
.كم أودّ رؤيتها تواجه دوجيما-سينباي

132
00:09:23,760 --> 00:09:26,080
.كلاّ، أنت تركّز على الجانب الخطأ هنا

133
00:09:26,080 --> 00:09:30,660
مستعملة المِقصلة تلك تُدعى
.المهووسة الوثّابة، باني هير

134
00:09:28,450 --> 00:09:32,800
!أكثر وأكثر! أكثر وأكثر! أكثر وأكثر

135
00:09:31,170 --> 00:09:32,800
!"خبيرة "الطّبق السّاديّ

136
00:09:37,720 --> 00:09:39,510
.هذا مذهل

137
00:09:39,510 --> 00:09:40,680
.لا اعتراضات لديّ

138
00:09:40,990 --> 00:09:43,020
.اكتملت المشاورات

139
00:09:43,380 --> 00:09:48,110
...ماركانتا وكلود فيل وباني هير

140
00:09:48,110 --> 00:09:50,110
!نجحتم أنتم الثّلاثة

141
00:09:53,530 --> 00:09:55,500
!ساخن جدًّا

142
00:09:55,500 --> 00:09:57,450
!رفيع جدًّا

143
00:10:01,340 --> 00:10:03,330
...هذه هي قوّة طهاة عالم الجريمة

144
00:10:03,330 --> 00:10:05,580
."قوّة "نوار

145
00:10:05,970 --> 00:10:09,120
،أينما كانوا، ومهما كان الوضع

146
00:10:09,120 --> 00:10:11,000
،ومهما كانت المكوّنات

147
00:10:11,000 --> 00:10:13,960
بإمكانهم تحويل أطباقهم
.إلى طبق متخصّص عالي الجودة

148
00:10:14,270 --> 00:10:17,970
أتعتقدون أنّ بإمكانكم يا طهاة
الخارج بلوغ ذلك المستوى؟

149
00:10:18,330 --> 00:10:22,180
بعبارة أخرى، علينا إعداد طبق
اختصاصيّ فحسب، صحيح؟

150
00:10:24,250 --> 00:10:25,390
...في تلك الحالة

151
00:10:25,390 --> 00:10:28,170
.سأواجه طبقي بكلّ ما لديّ

152
00:10:29,150 --> 00:10:33,090
...جودة ذلك اللّحم
،بالنّظر إلى كمّيّة الدّهون

153
00:10:33,090 --> 00:10:35,440
...فإنّ أفضل طريقة لتحضيره

154
00:10:35,440 --> 00:10:36,560
.حسنًا

155
00:10:38,030 --> 00:10:39,070
.الميتزالونا

156
00:10:40,670 --> 00:10:41,490
.حسنًا

157
00:10:41,490 --> 00:10:44,410
.تعالي، لا تخافي

158
00:10:44,930 --> 00:10:47,370
.والآن، لنقم بتقطيعك

159
00:10:54,710 --> 00:10:56,930
.هذه مفاجأة

160
00:10:56,930 --> 00:11:00,320
لا أصدّق أنّه قادر على بَشْرِ لحمٍ
...نيء طريّ بدقّة هكذا

161
00:11:00,320 --> 00:11:02,430
.سيكون ذلك مستحيلًا دون مهارة كبيرة

162
00:11:03,050 --> 00:11:05,140
!"فارس الطّاولة الأبيض"

163
00:11:05,570 --> 00:11:07,540
!هذا هو صاحب الرّتبة الأولى السّابق

164
00:11:07,540 --> 00:11:09,600
!يعرف تمامًا كيف يتعامل مع لحمه

165
00:11:10,740 --> 00:11:13,060
أعتقد أنّ هنالك بعض الخصوم
.الجديرين من الخارج أيضًا

166
00:11:13,430 --> 00:11:15,770
لكن ماذا عن بقيّتكم؟

167
00:11:16,170 --> 00:11:17,230
!يا لكم من ضعفاء

168
00:11:17,570 --> 00:11:19,950
إن كنتم تفتقرون للعزيمة
...للوقوف في المطبخ

169
00:11:19,950 --> 00:11:21,700
!فاغربوا عن وجهي

170
00:11:22,230 --> 00:11:24,160
أنت بخير، صحيح يا يوكيهيرا؟

171
00:11:24,160 --> 00:11:26,540
.نعم، لا أدري

172
00:11:27,180 --> 00:11:28,500
...لكن أعتقد

173
00:11:29,570 --> 00:11:31,960
.أنّ عليّ طبخ شيء أظنّ أنّه لذيذ

174
00:11:32,330 --> 00:11:35,490
...ميغومي، ألديني، يوكيهيرا

175
00:11:36,220 --> 00:11:39,670
!عليكم الفوز بهذا كممثّلين لتوتسكي

176
00:11:49,840 --> 00:11:52,890
سنسمح لك بالمرور عبر البوّابة الثّالثة

177
00:11:53,220 --> 00:11:54,900
!يا تسوكاسا إيشي

178
00:11:54,900 --> 00:11:57,360
.تاكومي ألديني، يمكنك التّقدّم

179
00:11:58,180 --> 00:11:58,820
"!شكرًا"

180
00:11:59,270 --> 00:12:01,240
.تادوكورو ميغومي، يمكنك التّقدّم

181
00:12:02,700 --> 00:12:06,670
.ويمكنك التّقدّم أيضًا يا يوكيهيرا سوما

182
00:12:06,670 --> 00:12:07,620
!سرّني أنّ الطّبق أعجبكم

183
00:12:14,830 --> 00:12:19,880
نجحنا بطريقة ما في الوصول للحدث
.الرّئيسيّ، لكن أتساءل ماذا سيكون

184
00:12:20,830 --> 00:12:23,270
،أعلم أنّ المسابقة أشبه بمنافسة بدءًا من هنا

185
00:12:23,270 --> 00:12:24,510
.لكنّ هذا غير واضح

186
00:12:25,190 --> 00:12:29,470
لن نعرف ضدّ من سنتواجه
.إلى أن يعلن المسؤولون عن ذلك

187
00:12:29,470 --> 00:12:31,930
!بدأت أشعر بالتّوتّر ثانية

188
00:12:31,930 --> 00:12:37,580
كان كلاكما خصمين صعبين
.في شوكوغيكي الفِرق

189
00:12:37,580 --> 00:12:39,570
.لا بأس بالتّحلّي بثقة أكبر

190
00:12:39,570 --> 00:12:41,180
!حا-حاضرة

191
00:12:41,180 --> 00:12:42,280
.شكرًا لك

192
00:12:42,280 --> 00:12:44,150
—وأنت أيضًا يا يوكيهيرا

193
00:12:45,120 --> 00:12:47,200
!ذهب سوما-كُن للحمّام

194
00:12:49,370 --> 00:12:52,220
أين ذهبت ناكيري يا ترى؟

195
00:12:52,220 --> 00:12:55,790
.نعم. توشك مباراة الانتقام الثّالثة أن تبدأ

196
00:12:55,790 --> 00:12:58,500
!يوكيهيرا، لماذا تتلكّأ هنا؟

197
00:12:59,400 --> 00:13:01,170
ما الّذي قصده بـ"مباراة الانتقام"؟

198
00:13:01,170 --> 00:13:05,760
صحيح. سمعتُ أنّهم يمنحون
.من خسروا حتّى الآن فرصة ثانية

199
00:13:07,130 --> 00:13:11,640
لكن هنالك طاهٍ قويّ جدًّا يواجه
.جميع الخاسرين وحده

200
00:13:11,640 --> 00:13:12,600
!وحده؟

201
00:13:13,080 --> 00:13:15,500
من يكون هذا الطّاهي؟ أهو بتلك القوّة؟

202
00:13:15,500 --> 00:13:17,440
...أنا لا أعرف الكثير

203
00:13:21,140 --> 00:13:24,490
تنبيه بمباراتي الأولى في الحدث الرّئيسيّ؟

204
00:13:25,940 --> 00:13:29,660
.سنبدأ الآن مباراة الانتقام الثّالثة

205
00:13:30,790 --> 00:13:34,540
.عليّ الفوز مهما كلّف الأمر

206
00:13:35,160 --> 00:13:37,790
!حتّى إن لم يكن ذلك ما ترغب به

207
00:13:45,450 --> 00:13:48,190
.مرحبًا بكم في ساحة حدث "بلو" الرّئيسيّ

208
00:13:48,190 --> 00:13:54,070
الطّهاة الموجودين هنا جميعًا هم متنافسون
...نجحوا في عبور البوّابات الثّلاث الأولى

209
00:13:54,070 --> 00:13:57,730
بمعنى آخر، من حصلوا على تصنيف
.للمشاركة في المسابقة

210
00:13:57,730 --> 00:14:00,020
كلّ شيء حتّى هذه المرحلة
.كان جولة تمهيديّة

211
00:14:00,020 --> 00:14:01,820
.سنبدأ الآن الحدث الرّئيسيّ

212
00:14:02,550 --> 00:14:06,780
اسمحوا لي أن أقدّم لكم الطّهاة
.الّذين سيشاركون في الجولة الأولى

213
00:14:08,630 --> 00:14:13,200
في الزّاوية الحمراء، المرأة الرّقيب
!من "نوار"، سارج

214
00:14:13,730 --> 00:14:19,210
وفي الزّاوية الزّرقاء، صاحب الرّتبة الأولى
...في نخبة توتسكي العشرة حاليًّا

215
00:14:19,210 --> 00:14:20,790
!يوكيهيرا سوما

216
00:14:22,130 --> 00:14:23,920
.أظنّ أنّ خصمي مجرّد تلميذ

217
00:14:23,920 --> 00:14:29,430
نعم، أنا تلميذ، لكنّني أيضًا
.طاهٍ في مطعم يوكيهيرا الشّعبيّ

218
00:14:29,760 --> 00:14:33,890
لا سبب يدفعني لأخشى شخصًا
.خسر أمام أساهي-ساما

219
00:14:33,890 --> 00:14:37,020
ماذا؟ كيف تعرفين سايبا أساهي؟

220
00:14:37,490 --> 00:14:39,600
.ذلك ليس من شأنك

221
00:14:41,220 --> 00:14:44,110
.والآن... حان وقت الوفاء بوعدك

222
00:14:45,040 --> 00:14:46,660
قلتِ أنّ بإمكاني

223
00:14:46,660 --> 00:14:49,110
فعل ما أشاء بك إن هزمتك
في معركة طبخ، صحيح؟

224
00:14:50,540 --> 00:14:51,620
.لن أتراجع عن كلمتي

225
00:14:51,620 --> 00:14:53,580
.في تلك الحالة، لن أتهاون أيضًا

226
00:14:56,450 --> 00:14:59,370
ليس لديك مكان تلجئين إليه، صحيح؟

227
00:15:00,100 --> 00:15:02,380
.سأسمح لك بالانضمام لي

228
00:15:02,860 --> 00:15:06,380
لذلك هلاّ ساعدتني في تحقيق طموحي؟

229
00:15:07,110 --> 00:15:10,380
.بالنّسبة لي، إنّه قائد أعلى عليّ إطاعته

230
00:15:10,930 --> 00:15:14,160
وبهدف الحرص على ألاّ تتسبّبّ
،بالمتاعب لأساهي-ساما

231
00:15:14,160 --> 00:15:16,500
...سأجعلك تختفي هنا والآن

232
00:15:16,500 --> 00:15:17,890
.يا يوكيهيرا سوما

233
00:15:19,100 --> 00:15:23,990
،"سأقوم أنا رانتابي، إحدى مراقبي "م ع ذ
.بالتّعليق على هذه المباراة

234
00:15:23,990 --> 00:15:26,940
وستتكوّن لجنة الحكم من المراقب ترانشان

235
00:15:26,940 --> 00:15:31,360
.والمراقبة ماتيوريت والمراقبة إسور

236
00:15:31,720 --> 00:15:33,820
...وموضوع هذه المباراة

237
00:15:33,820 --> 00:15:35,750
سنطلب منكما إعداد

238
00:15:35,750 --> 00:15:39,290
أفضل كعكة عيد ميلاد مجيد
!والّتي ستكون نجمة الحفلة

239
00:15:39,290 --> 00:15:40,930
كعكة عيد ميلاد مجيد؟

240
00:15:40,930 --> 00:15:42,420
.لكنّنا في شهر أغسطس الآن

241
00:15:42,420 --> 00:15:43,750
ما الّذي يحدث؟

242
00:15:44,060 --> 00:15:48,460
،كعكة؟ تعلّمت الأساسيّات في الفصل
.لكنّ ذلك كلّ ما أعرفه

243
00:15:49,670 --> 00:15:51,880
.لديكم ثلاث ساعات

244
00:15:51,880 --> 00:15:53,840
!والآن... ابدآ الطّبخ

245
00:15:57,260 --> 00:15:58,480
...إنّهم ينتظرون

246
00:15:58,480 --> 00:16:00,180
ما الّذي يحدث هناك؟

247
00:16:00,180 --> 00:16:03,350
.متّع ناظريك يا يوكيهيرا سوما

248
00:16:03,930 --> 00:16:06,400
سأريك الآن المعنى الحقيقيّ
!للطّبق المسلّح

249
00:16:07,110 --> 00:16:08,300
...مستحيل

250
00:16:08,300 --> 00:16:10,440
وضعت بياض بيض وسكّر ناعم
...في قِدر ثمّ

251
00:16:10,440 --> 00:16:12,450
!خفقته بذلك

252
00:16:12,470 --> 00:16:17,580
مذهل... إنّها قادرة بطريقة ما على إعداد
.ميرانغ رقيق بذلك الشّيء

253
00:16:17,580 --> 00:16:22,460
ذلك السّكّين مختلف قليلاً عمّا
.استعملته لإعداد الطّبق السّابق

254
00:16:22,840 --> 00:16:27,210
يبدو أنّه يملك ملحقات معقّدة
.تغيّرها حسب الطّبق

255
00:16:27,650 --> 00:16:30,220
وهكذا استطاعت الحصول

256
00:16:30,220 --> 00:16:32,720
.على رغوة مدهشة وميرانغ جميل كهذا

257
00:16:32,720 --> 00:16:37,150
قد تجعل حركة خاطئة واحدة
،القِدر يحلّق في السّماء

258
00:16:37,150 --> 00:16:39,680
.لكنّ سيطرتها كاملة وهي تعدّ طبقها

259
00:16:39,680 --> 00:16:43,890
لا أصدّق أنّ بإمكانها استعمال سكّين
...تقطيع منشاريّ لخبز كعكة أيضًا

260
00:16:46,410 --> 00:16:48,020
!مزربّة؟

261
00:16:52,210 --> 00:16:55,160
لقد سحقت لوح الشّكولاطة ذاك
!بالكامل في رمشة عين

262
00:16:55,600 --> 00:16:57,570
!يا له من طبق خطير

263
00:16:57,570 --> 00:16:59,420
!كم هذا حماسيّ

264
00:16:59,420 --> 00:17:01,790
!أرنا المزيد أيّتها الرّقيب سارج

265
00:17:02,110 --> 00:17:04,290
.اخرسوا وشاهدوا أيّها الحضور

266
00:17:04,660 --> 00:17:07,130
.إليكم اللّمسات الأخيرة

267
00:17:07,130 --> 00:17:10,930
.تلك أداة تفجير قنابل بكلّ تأكيد
هل ستفجّر شيئًا ما؟

268
00:17:10,930 --> 00:17:11,840
!انظر هناك

269
00:17:12,430 --> 00:17:15,300
.ثمّة صفائح رقيقة تشبه المعجّنات في الفرن

270
00:17:15,300 --> 00:17:20,010
أهذا فرن من نوع خاصّ تمّ تعديله
خصّيصًا لخبز هذه الكعكة؟

271
00:17:20,380 --> 00:17:23,100
إن كنتم تريدون الحفاظ
!على سمعكم، فغطّوا آذانكم

272
00:17:31,070 --> 00:17:32,540
!ما هذا؟

273
00:17:32,540 --> 00:17:34,280
.لكنّ الرّائحة شهيّة جدًّا

274
00:17:34,280 --> 00:17:38,740
نعم. رائحة المعجّنات المخبوزة
.الحلوة قد ملأت الحلبة

275
00:17:39,330 --> 00:17:41,450
.مهلاً، اختفى سوما-كُن

276
00:17:41,450 --> 00:17:43,700
!هل يعقل أنّ الانفجار قد رمى به بعيدًا؟

277
00:17:43,700 --> 00:17:46,210
.غادر يوكيهيرا الحلبة قبل لحظات

278
00:17:46,210 --> 00:17:47,170
!ماذا؟

279
00:17:47,170 --> 00:17:48,880
.ها قد عاد

280
00:17:48,880 --> 00:17:50,040
.مهلاً

281
00:17:50,040 --> 00:17:52,200
هل ذهب للتّسوّق من المتجر؟

282
00:17:52,200 --> 00:17:55,590
،بينما كان يضيّع الوقت في ذلك
...كانت خصمه قد

283
00:17:56,570 --> 00:17:57,590
.انتهيت

284
00:17:59,060 --> 00:18:02,110
من المستحيل التّفكير أنّ شيئًا بهذا الجمال
.كانت نتيجة شيء بتلك الفوضويّة

285
00:18:02,110 --> 00:18:04,720
.يا لها من كعكة ممتازة

286
00:18:05,070 --> 00:18:08,690
.العذراء اليافعة بداخلي متحمّسة للغاية

287
00:18:09,100 --> 00:18:10,440
!بإمكانكم الأكل الآن

288
00:18:12,400 --> 00:18:17,400
.يا لألوانها المتعدّدة
.أنا واثق أنّها ستشعل الحفل

289
00:18:19,110 --> 00:18:20,610
.سيتذوّق الحكّام الطّبق الآن

290
00:18:22,840 --> 00:18:25,370
.ملمسها داخل الفم ناعم كالثّلج

291
00:18:25,370 --> 00:18:29,250
صفائح المعجّنات المقرمشة المخبوزة
في الفرن الانفجاريّ الخاصّ

292
00:18:29,250 --> 00:18:32,890
.قد رُصّت وكأنّها حلوى الألف ورقة

293
00:18:32,890 --> 00:18:37,630
بمجرّد أخذ قضمة منها، تذوب
الصّفائح في الفم

294
00:18:37,630 --> 00:18:40,840
إلى جانب الميرانغ الحُلو الرّقيق
.المعدّ بالمنشار الكهربائيّ

295
00:18:41,450 --> 00:18:45,810
ما الّذي يحدث؟ هنالك حلاوة غنيّة
.تتفجّر داخل فمي فجأة

296
00:18:45,810 --> 00:18:48,840
.أسمّيها رقائق الشّكولاطة العنقوديّة

297
00:18:48,840 --> 00:18:50,930
مزجت الشّكولاطة ومسحوق اللّوز

298
00:18:50,930 --> 00:18:54,540
مع النّعناع وجمّدت الخليط
.لمنحه قرمشة إضافيّة

299
00:18:54,540 --> 00:18:56,780
،ثمّ بعد سحقي له بالمزربّة

300
00:18:56,780 --> 00:19:00,190
مزجته مع صفائح المعجّنات
.وفجّرتها في درجة الحرارة المثاليّة

301
00:19:01,050 --> 00:19:05,150
وبفضل ذلك، حمت صفائحُ المعجّناتِ
،الشّكولاطةَ من الانفجار

302
00:19:05,150 --> 00:19:08,200
محوّلة التّناسق والملمس إلى
.شكولاطة مخبوزة بدل إذابتها

303
00:19:08,660 --> 00:19:12,270
،بمجرّد أكلها، تسبّب انفجارات متواصلة في الفم

304
00:19:12,270 --> 00:19:14,670
.إنّها أشبه بقنبلة عنقوديّة

305
00:19:15,350 --> 00:19:17,890
هذه كعكة القنبلة العنقوديّة خاصّتي

306
00:19:17,890 --> 00:19:19,630
!بكامل مجدها

307
00:19:19,630 --> 00:19:22,900
...الميرانغ الممتاز المعدّ بالمنشار الكهربائيّ

308
00:19:22,900 --> 00:19:25,530
...وصفائح المعجّنات اللّذيذة بشكل انفجاريّ

309
00:19:25,530 --> 00:19:29,110
إضافة لرقائق الشّكولاطة العنقوديّة
...المعدّة باستعمال المزربّة

310
00:19:29,110 --> 00:19:32,020
.هذا طبق مسلّح بالفعل

311
00:19:32,720 --> 00:19:35,690
!أعطني هديّة يا سانتا-سان

312
00:19:36,900 --> 00:19:38,860
.سعادة مجيدة جديدة

313
00:19:40,030 --> 00:19:44,760
هذه الحفلة مثاليّة وكأنّها السّنة
الجديدة وعيد الميلاد المجيد

314
00:19:44,760 --> 00:19:47,540
!وأعياد مولدنا دفعة واحدة

315
00:19:47,860 --> 00:19:50,510
.حان دورك يا يوكيهيرا سوما

316
00:19:51,160 --> 00:19:54,830
.حاول إعداد شيء شهيّ كهذا لو تقدر

317
00:19:55,580 --> 00:19:58,960
.منشارك الكهربائيّ ذاك رائع بالفعل

318
00:19:58,960 --> 00:20:03,430
.لكن لديّ منشار كهربائيّ أنا أيضًا

319
00:20:03,790 --> 00:20:04,930
منشار كهربائيّ؟

320
00:20:04,930 --> 00:20:06,200
لدى سوما-كُن واحد أيضًا؟

321
00:20:06,200 --> 00:20:06,800
...مستحيل

322
00:20:07,160 --> 00:20:08,010
.ها هو ذا

323
00:20:08,010 --> 00:20:10,210
!ما... ماذا؟

324
00:20:11,640 --> 00:20:13,690
ذلك منشار كهربائيّ؟

325
00:20:13,690 --> 00:20:16,770
.أنا واثق أنّها ملعقة مثلّجات خشبيّة

326
00:20:17,170 --> 00:20:19,480
!كيف تجرؤ على السّخرية منّي؟

327
00:20:20,210 --> 00:20:24,070
!أتجرؤ على مواجهة طبقي المسلّح بهذا؟

328
00:20:24,070 --> 00:20:27,240
.لا، لستُ أسخر منك على الإطلاق

329
00:20:27,240 --> 00:20:31,100
.هذه الملعقة الخشبيّة ليست الوحيدة
كلّ هذه المقتنيات من المتجر

330
00:20:31,100 --> 00:20:33,710
.ستكون العامل الحاسم في طبقي

331
00:20:34,050 --> 00:20:37,130
أتمنّى ألاّ يمانع ضيوف الحفلة
.الانتظار قليلاً بعد

332
00:20:37,490 --> 00:20:41,510
سأعدّ لكم كعكة عيد ميلاد
.مجيد خارقة مناسبة تمامًا للصّيف

333
00:20:41,850 --> 00:20:45,510
.واضح تمامًا أنه يعبث فحسب
ما الّذي يفكّر فيه؟

334
00:20:45,940 --> 00:20:48,850
أوّلاً، أحتاج لبعض القشدة الّتي
.بإمكانها مجاراة ذلك الميرانغ

335
00:20:49,420 --> 00:20:51,060
!وسأعدّها بهذه

336
00:20:51,390 --> 00:20:52,520
...توفو وحليب الصّويا

337
00:20:52,970 --> 00:20:55,310
إنّه يخلطهما معًا مع الموز
.ومسحوق الكاكاو

338
00:20:57,310 --> 00:20:59,860
سيكون قادرًا بالتّأكيد على إعداد
.قشدة مميّزة بذلك

339
00:20:59,860 --> 00:21:02,570
!وبالنّسبة لخليط الكعكة، سأستعمل هذه

340
00:21:02,890 --> 00:21:04,030
!البطاطس الجبليّة؟

341
00:21:05,990 --> 00:21:10,160
يمزج البطاطس المبشورة مع خليط الكعكة؟

342
00:21:12,370 --> 00:21:15,600
.تصلني رائحة قويّة وشراريّة

343
00:21:15,600 --> 00:21:19,090
!إنّه الفحم! إنّه يخبز خليط الكعكة على الفحم

344
00:21:19,090 --> 00:21:22,400
يجب على الأشعة تحت الحمراء
البعيدة الصّادرة من الفحم

345
00:21:22,400 --> 00:21:25,480
.أن تخبز كعكة جميلة ومنفوخة

346
00:21:25,480 --> 00:21:29,180
لستُ واثقة كيف لطرق الطّبخ
...اليابانيّة أن تنفع في خبز الكعك

347
00:21:29,180 --> 00:21:31,140
.لست سيّئًا يا يوكيهيرا

348
00:21:31,140 --> 00:21:34,060
.إنّه يحسّن طبقه خطوة خطوة

349
00:21:34,400 --> 00:21:36,750
...رأيته يطبخ مرّات عدّة

350
00:21:36,750 --> 00:21:39,900
إنّها مهمّة صعبة، ومع ذلك
.يبدو سعيدًا جدًّا ومفعمًا بالحيويّة

351
00:21:39,900 --> 00:21:42,550
!هذا هو يوكيهيرا

352
00:21:44,270 --> 00:21:45,780
.انتهيت

353
00:21:54,560 --> 00:21:56,000
!كرات ألعاب ناريّة؟

354
00:21:57,400 --> 00:22:01,760
هذه كعكة عيد ميلاد مجيد
!صيفيّ على أسلوب يوكيهيرا

355
00:23:35,870 --> 00:23:37,520
!متقاطعة! متقاطعة! متقاطعة

356
00:23:37,520 --> 00:23:38,380
خلّ أسود (كوروزو)؟

357
00:23:38,380 --> 00:23:39,930
!كلاّ