1
00:00:05,940 --> 00:00:08,150
.هذه كعكة القنبلة العنقوديّة خاصّتي

2
00:00:08,470 --> 00:00:12,530
هذه كعكة عيد ميلاد مجيد
!صيفيّ على أسلوب يوكيهيرا

3
00:00:12,870 --> 00:00:14,490
!كرات ألعاب ناريّة؟

4
00:00:16,450 --> 00:00:18,980
هذه كعكة "بوش دو نويل"، صحيح؟

5
00:00:18,980 --> 00:00:23,910
نعم. إنّها كعكة تُؤكل في أعياد الميلاد
.المجيدة، تُعدّ على شكل جذع شجرة

6
00:00:24,270 --> 00:00:28,430
لكن لماذا أضاف كرات الألعاب النّاريّة
الّتي لا تتماشى مع المنظر العامّ؟

7
00:00:28,990 --> 00:00:30,710
.إنّها معدّة ببراعة

8
00:00:30,710 --> 00:00:33,500
.يكاد يكون تصميم اللّحاء حقيقيًّا

9
00:00:33,500 --> 00:00:36,720
إذًا فقد لاحظت ذلك؟
...عملت كثيرًا عليه

10
00:00:37,240 --> 00:00:39,930
.بهذه الملعقة المنشاريّة

11
00:00:40,720 --> 00:00:43,680
إنّها مثاليّة لصنع تلك الخطوط
.الّتي تشبه لحاء الشّجر

12
00:00:44,960 --> 00:00:48,900
لا أصدّق أنّ شيئًا بتلك البساطة
.قد يصنع خطوطًا جميلة كهذه

13
00:00:50,540 --> 00:00:53,110
.المنظر ليس الشّيء الوحيد المبهر هنا

14
00:00:53,110 --> 00:00:54,570
...حسنًا يا رفاق

15
00:00:55,400 --> 00:00:57,030
!تفضّلوا بتذوّقها

16
00:02:28,870 --> 00:02:31,550
.أرى أنّك أتيت يا جويتشيرو

17
00:02:31,550 --> 00:02:32,460
.نعم

18
00:02:32,710 --> 00:02:35,920
.هذه فرصة ابني الكبيرة، نوعًا ما

19
00:02:35,920 --> 00:02:40,590
يقاتل يوكيهيرا سوما في الجولة
،الأولى من هذه المنافسة

20
00:02:40,830 --> 00:02:44,930
."لكنّه يواجه إحدى نخبة "نوار

21
00:02:45,670 --> 00:02:47,690
هل تظنّ أنّ لديه فرصة؟

22
00:02:47,690 --> 00:02:49,770
.بالطّبع لا

23
00:02:50,220 --> 00:02:53,480
.سوما مجرّد ابن رجل يدير مطعمًا تافهًا

24
00:02:54,560 --> 00:02:58,610
."مستحيل أن تكون له فرصة أمام "نوار

25
00:02:59,340 --> 00:03:00,100
...على الأقلّ

26
00:03:01,170 --> 00:03:03,150
.تحت ظروف عاديّة

27
00:03:03,660 --> 00:03:05,990
!والآن، ليبدأ التّذوّق

28
00:03:06,370 --> 00:03:08,500
.نعم. لنبدأ الأكل

29
00:03:10,210 --> 00:03:13,900
!انشراح

30
00:03:15,450 --> 00:03:18,570
.يا لها من لذّة. ممتازة وناعمة

31
00:03:18,570 --> 00:03:22,300
.تتفتّح داخل فمي حلاوة متناغمة

32
00:03:22,570 --> 00:03:26,180
إنّها تذكّرني بشرارات وامضة
.ثمّ تختفي

33
00:03:26,180 --> 00:03:29,770
.يا لها من حلاوة سلسة وعابرة في نفس الوقت

34
00:03:30,080 --> 00:03:32,070
.جوهر الطّبق هنا هو بطاطس الجبل

35
00:03:32,070 --> 00:03:34,350
إنّ إضافته لخليط الكعكة

36
00:03:34,350 --> 00:03:36,980
.يجعلها أكثر سماكة وحلاوة بعض الشّيء

37
00:03:37,510 --> 00:03:39,110
.وثمّة نوعان من القشدة

38
00:03:39,540 --> 00:03:42,860
أعددت كلاهما بالموز والأفوكادو
،والتّوفو وحليب الصّويا

39
00:03:42,860 --> 00:03:45,550
ثمّ أضفت الأرزّ المنتفخ للقشدة البيضاء

40
00:03:45,550 --> 00:03:48,490
.ومسحوق الكاكاو للقشدة البنّيّة

41
00:03:48,490 --> 00:03:50,450
.وأضفت شراب الأرزّ من أجل الحلاوة

42
00:03:50,450 --> 00:03:55,310
شراب الأرزّ؟ أيقصد ما نحصل عليه عند
استخلاص النّشا من الأرزّ وتحويله لسكّر؟

43
00:03:55,310 --> 00:03:59,340
.نعم! إنّه مُحلٍّ صحّيّ استُعمل لعدّة عصور

44
00:03:55,910 --> 00:03:59,340
...غزل، غزل

45
00:03:59,340 --> 00:04:04,210
هذا يعني أنّ هذه الكعكة لا تحتوي
.على أيّ سكّر أو منتجات ألبان

46
00:04:04,210 --> 00:04:07,520
تمكّن من إبراز الحلاوة الطّبيعيّة
لكلّ هذه المكوّنات

47
00:04:07,520 --> 00:04:09,080
.وجمع بينها لإعداد هذه الكعكة

48
00:04:09,080 --> 00:04:11,020
بدون استعمال السّكّر؟

49
00:04:11,020 --> 00:04:12,640
لماذا تكبّد كلّ ذلك العناء؟

50
00:04:12,640 --> 00:04:19,330
حسنًا، إنّ المتطلّعين لطبقي الآن هم
.أنتم الجالسون على هذه المائدة

51
00:04:19,890 --> 00:04:25,110
فكّرت في أنّكم قد تستمتعون بكعكة
.في الصّيف بشكل أكثر إن لم تكن ثقيلة

52
00:04:25,370 --> 00:04:28,580
.كنت لأفضّل شيئًا كهذا في الصّيف شخصيًّا

53
00:04:30,960 --> 00:04:34,080
.سيكون هذا قرارًا صعبًا

54
00:04:34,080 --> 00:04:36,330
.إنّ كلاهما على قدم المساواة

55
00:04:36,700 --> 00:04:37,990
!لا تعبثوا معي

56
00:04:37,990 --> 00:04:39,840
أتقولون أنّ هذا الطّبق مساوٍ لطبقي؟

57
00:04:40,360 --> 00:04:43,630
كان الموضوع هو إعداد كعكة عيد
.ميلاد مجيد تكون نجمة الحفلة

58
00:04:43,840 --> 00:04:46,720
!لا تحتوي كعكته إلّا على جانب مميّز واحد

59
00:04:47,250 --> 00:04:51,890
بينما كعكة القنبلة العنقوديّة
!خاصّتي أضافت الحماس لكلّ قضمة

60
00:04:51,890 --> 00:04:54,820
تضمّ كعكتي قوّة ناريّة كافية
!لتفجير كعكته تفجيرًا

61
00:04:54,820 --> 00:04:55,770
...المعذرة

62
00:04:56,710 --> 00:04:59,150
.قد يكون الوقت باكرًا على قول هذا

63
00:04:59,150 --> 00:05:02,490
.فلم نصل بعد حتّى للألعاب النّاريّة

64
00:05:02,490 --> 00:05:06,860
الألعاب النّاريّة المثاليّة لبثّ
.الحياة في حفلة صيفيّة

65
00:05:07,200 --> 00:05:10,780
.ألعاب ناريّة؟ أنا واثقة أنّها للزّينة فحسب

66
00:05:10,780 --> 00:05:13,300
.أخشى أنّك مخطئة تمامًا

67
00:05:13,300 --> 00:05:15,750
.إنّها مناسبة تمامًا ليوم صيفيّ

68
00:05:15,750 --> 00:05:17,210
!إنّها مفرقعات شراريّة

69
00:05:21,470 --> 00:05:22,630
!ما هذا؟

70
00:05:24,590 --> 00:05:26,550
.تبدو كمفرقعات شراريّة بالفعل

71
00:05:26,800 --> 00:05:31,310
تنتشر العديد من المفرقعات الشّراريّة
.حول كعكة عيد الميلاد المجيد الصّيفيّة

72
00:05:31,720 --> 00:05:38,310
ذلك ليس كلّ شيء. تتسرّب القشدة
.منها وتنساب على خطوط اللّحاء

73
00:05:38,770 --> 00:05:41,070
...وهذه الرّائحة المنعشة

74
00:05:41,350 --> 00:05:43,540
يبدو أنّ القشرة الخارجيّة للألعاب النّاريّة

75
00:05:43,540 --> 00:05:46,900
.تحتوي على بشور قشرة اليوسفيّ

76
00:05:47,490 --> 00:05:48,610
!بالهناء والشّفاء

77
00:05:54,510 --> 00:05:56,260
!فُتات قهوة

78
00:05:56,260 --> 00:05:59,370
طُحنت فواكهٌ ولوزٌ وحبوب قهوة

79
00:05:59,370 --> 00:06:02,670
.ومُزجت ثمّ خُبزت معًا لإعداد السّكاكر المفتّتة

80
00:06:03,080 --> 00:06:07,930
إنّها تتناسب بشكل مثاليّ
.مع حلاوة الكعكة الخفيفة

81
00:06:07,930 --> 00:06:13,350
والعامل الأساسيّ الدّاعم فيها هي
.هذه القشدة المغموسة في اللّحاء

82
00:06:13,750 --> 00:06:18,320
تلك هي القشدة البنّيّة الّتي استعملتُها
.في "بوش دو نويل" أيضًا

83
00:06:18,320 --> 00:06:21,310
إلاّ أنّني أعددتُ هذه لتذوب أسهل
.اعتمادًا على درجة الحرارة

84
00:06:21,310 --> 00:06:26,930
فهمت. استعمل القشدة المذابة للحرص
على أنّ فتات القهوة لن يجفّ كثيرًا

85
00:06:26,930 --> 00:06:29,810
بينما يمزجه في الكعكة بحدّ ذاتها

86
00:06:29,810 --> 00:06:34,240
.ويحافظ على ملمسه المقرمش الأصليّ

87
00:06:34,240 --> 00:06:39,080
ثمّة سبب آخر لعدم استعماله للسّكّر
.أو منتجان الألبان في الكعكة

88
00:06:39,440 --> 00:06:45,340
إنّه ليحرص على أن يتذوّقوا المذاقين
.اللّاذع والمرّ الخفيفين للقهوة

89
00:06:45,340 --> 00:06:47,270
...الرّائحة المنعشة

90
00:06:47,270 --> 00:06:48,790
...والغنى المحيط بنا

91
00:06:48,790 --> 00:06:51,340
...وأخيرًا المذاق المرّ

92
00:06:51,340 --> 00:06:52,920
!تختفي كلّها في لحظة

93
00:06:52,920 --> 00:06:56,390
طبق يُعتبر مصدر بهجة
!لأيّ أحد مهما كان عمره

94
00:06:56,900 --> 00:06:59,790
بوش دو نويل"؟ قشدة بنّيّة؟"

95
00:06:59,790 --> 00:07:01,050
فُتات؟

96
00:07:01,050 --> 00:07:03,130
.جميعها عناصر عاديّة

97
00:07:03,130 --> 00:07:06,890
ومع ذلك يصفونها بمصدر بهجة لكلّ الأعمار؟

98
00:07:06,890 --> 00:07:09,860
!ما الّذي يحدث؟
!من أين تحصل على قوّتك هذه؟

99
00:07:10,180 --> 00:07:13,320
...ماذا؟ حسنًا، لنرَ

100
00:07:13,320 --> 00:07:15,040
،إن كان عليّ القول

101
00:07:15,040 --> 00:07:17,160
فستكون من أشياء تعلّمتها
.في المطعم الشّعبيّ

102
00:07:17,860 --> 00:07:18,790
!سوما

103
00:07:19,270 --> 00:07:21,220
سأدعك تبتكر واحدًا

104
00:07:21,220 --> 00:07:23,470
من أطباق القائمة الجديدة
!الّتي سنعتمدها هذا الشّهر

105
00:07:23,470 --> 00:07:24,390
!ماذا؟

106
00:07:24,390 --> 00:07:25,920
!لكنّني لا أزال في الصّفّ السّادس فقط

107
00:07:25,920 --> 00:07:28,380
ماذا؟ أتقول أنّك لا تستطيع ذلك؟

108
00:07:30,240 --> 00:07:31,470
.بالطّبع أستطيع

109
00:07:32,710 --> 00:07:36,990
سُحقًا! لا فائدة من إعداد شيء
.كالأشياء الّتي نملكها سلفًا

110
00:07:36,990 --> 00:07:40,350
!لكن لا يجب أن يكون وقت الإعداد طويلاً
—لكن علينا طبخه جيّدًا

111
00:07:39,270 --> 00:07:40,350
!سوما

112
00:07:40,350 --> 00:07:43,600
.علينا إعداد 20 طلبًا للتّسليم
.خلال 5 دقائق

113
00:07:43,600 --> 00:07:44,810
!ماذا؟

114
00:07:45,530 --> 00:07:50,100
سوما، تمّ إخبار هذا الزّبون الدّائم
،أن يبتعد عن السّكّر لبعض الوقت

115
00:07:50,100 --> 00:07:53,430
لذلك أعدّ له شيئًا حلوًا بدون
.استعمال السّكّر أو منتجان الألبان

116
00:07:53,430 --> 00:07:54,270
—ما

117
00:07:54,270 --> 00:07:56,200
!سوما

118
00:07:56,850 --> 00:08:01,620
،طوال 365 يومًا في السّنة
،وحتّى التحاق سوما بتوتسكي

119
00:08:01,620 --> 00:08:04,040
.واصلت طلب المستحيل منه

120
00:08:04,630 --> 00:08:05,540
!سوما

121
00:08:05,910 --> 00:08:07,750
سأترك الباقي لك، أيمكنك تولّي الأمر؟

122
00:08:08,470 --> 00:08:09,590
.بالطّبع يمكنني

123
00:08:10,470 --> 00:08:16,090
لأنّ المطاعم الشّعبيّة لا تتحمّل
.أن يسأم زبائنها الدّائمون منها

124
00:08:16,600 --> 00:08:19,970
على عكس الوجهات الاستثنائيّة
،أو مطاعمكم أو منتجعاتكم الفاخرة

125
00:08:20,380 --> 00:08:22,700
تتواجد المطاعم الشّعبيّة
.في نطاق الحياة العاديّة

126
00:08:23,100 --> 00:08:26,480
،علينا الحرص أنّ الزّبائن لن يملّوا منّا
.حتّى إن أتوا إلينا يوميًّا

127
00:08:27,160 --> 00:08:30,530
ومن أجل ذلك، على المرء أن يكون
،قادرًا على إعداد شيء يرضي الجميع

128
00:08:30,530 --> 00:08:34,150
.إضافة إلى أطباق مفاجئة ومبهجة

129
00:08:34,810 --> 00:08:38,040
.أقحمتُ كلّ تلك المعرفة في عقل سوما

130
00:08:38,770 --> 00:08:42,680
لسوء الحظّ، صادف أنّنا
.المطعم الشّعبيّ الأفضل

131
00:08:43,000 --> 00:08:46,540
لماذا لا تتذوّقيها بنفسك
!إن لم تصدّقي ذلك؟

132
00:08:49,940 --> 00:08:53,170
،أحاول ألاّ أعترف بالأمر
.لكنّ جسدي يتفاعل من تلقاء نفسه

133
00:08:53,510 --> 00:08:55,740
!لساني! جسدي

134
00:08:55,740 --> 00:08:57,470
!وقلبي أيضًا

135
00:09:00,470 --> 00:09:01,720
.أخبريني يا سارج

136
00:09:02,970 --> 00:09:03,980
أساهي-سان؟

137
00:09:04,310 --> 00:09:07,470
.تبدين منزعجة دائمًا

138
00:09:08,150 --> 00:09:10,560
لماذا لا تبتسمي من حين لآخر؟

139
00:09:11,140 --> 00:09:13,490
.إنّك تفسدين ذلك الوجه الجميل

140
00:09:14,280 --> 00:09:15,900
.لا تضايقني هكذا أرجوك

141
00:09:16,340 --> 00:09:18,320
.لكنّني لستُ أضايقك

142
00:09:18,320 --> 00:09:20,490
.إنّك تخفين مشاعرك الحقيقيّة دائمًا

143
00:09:21,320 --> 00:09:23,460
.لا مانع من أن تكون صريحة أكثر مع نفسك

144
00:09:23,460 --> 00:09:24,960
...خذي كلّ مشاعرك الحقيقيّة

145
00:09:24,960 --> 00:09:26,620
!ودعيها تنطلق منفجرة

146
00:09:27,880 --> 00:09:28,580
—مَن

147
00:09:33,230 --> 00:09:33,880
!كلاّ

148
00:09:34,810 --> 00:09:39,340
!أريد المفرقعات الشّراريّة
!وليست تلك الّتي تُطلق في السّماء

149
00:09:39,570 --> 00:09:41,050
!سُحقًا

150
00:09:41,590 --> 00:09:43,270
...لا أصدّق أنّني

151
00:09:43,520 --> 00:09:47,520
كان يجب أن تفوز سارج بهذه
.الجولة بدون مشاكل

152
00:09:47,520 --> 00:09:48,310
...لكن

153
00:09:48,310 --> 00:09:52,540
كان يوكيهيرا قادرًا على جعل
طبقه يتغلّب على طبقها

154
00:09:52,540 --> 00:09:56,700
.لأنّه تمهّل للتّفكير في الزّبائن والوضع

155
00:09:57,000 --> 00:09:58,030
...الفائز

156
00:09:58,550 --> 00:10:00,240
!يوكيهيرا سوما

157
00:10:01,340 --> 00:10:02,690
!سعيد لأنّ الطّبق أعجبكم

158
00:10:05,370 --> 00:10:07,280
!نجح سوما-كُن

159
00:10:07,280 --> 00:10:08,980
!أحسنت يا يوكيهيرا

160
00:10:08,980 --> 00:10:10,830
.كان يتصرّف على طبيعته كالعادة

161
00:10:15,630 --> 00:10:17,980
.يبدو أنّ دوري قد حان

162
00:10:17,980 --> 00:10:20,840
.أخبروا يوكيهيرا أنّني أهنّئه على انتصاره

163
00:10:20,840 --> 00:10:21,770
!نعم

164
00:10:22,200 --> 00:10:25,530
!سنلحق بك بمجرّد لقائنا بيوكيهيرا

165
00:10:25,530 --> 00:10:28,060
.لنبذل وسعنا جميعًا يا تسوكاسا-سينباي

166
00:10:29,060 --> 00:10:30,330
ماذا؟

167
00:10:31,720 --> 00:10:36,190
عفوًا، أنا آسف، لكن لا يمكنني
.تحمّل الخسارة أيضًا

168
00:10:36,510 --> 00:10:39,530
ليس قبل أن أظفر بانتقامي
.من سايبا أساهي شخصيًّا

169
00:10:40,670 --> 00:10:42,690
.أنت قويّ بالفعل

170
00:10:42,690 --> 00:10:46,210
لكنّ سبب عجزك عن هزيمة أساهي-ساما

171
00:10:46,210 --> 00:10:49,290
!يكمن في سكّينك

172
00:10:49,690 --> 00:10:51,040
ماذا؟

173
00:10:51,810 --> 00:10:52,750
.أخبرني، أخبرني

174
00:10:53,000 --> 00:10:56,750
لماذا استدعيتنا إلى هنا؟

175
00:10:56,750 --> 00:10:59,550
.لدينا أمور لنقوم بها

176
00:10:59,810 --> 00:11:05,010
حسنًا... يبدو أنّني سأواجه خصمًا
.صعبًا من البداية مباشرة

177
00:11:05,550 --> 00:11:07,850
.كنت آمل أن تساعدوني

178
00:11:07,850 --> 00:11:10,480
عمّ تتحدّث؟

179
00:11:10,480 --> 00:11:14,480
.لا نملك أيّ ولاء لك على عكس سارج

180
00:11:17,860 --> 00:11:20,870
.كنّا نجاريك فحسب لأنّ استغلالك كان لمصلحتنا

181
00:11:20,870 --> 00:11:22,490
.لن نساعدك

182
00:11:22,490 --> 00:11:26,200
!نريد التّقدّم أيضًا

183
00:11:26,200 --> 00:11:28,250
...فهمت. في تلك الحالة

184
00:11:29,250 --> 00:11:31,100
.أعتقد أنّ لا خيار لديّ

185
00:11:32,970 --> 00:11:36,960
.نوشك الآن على بدء الجولة التّالية في هذه القاعة

186
00:11:37,490 --> 00:11:38,970
.اسمحوا لي بتقديم المتنافسَيْن

187
00:11:38,970 --> 00:11:42,160
صاحب الرّتبة الأولى سابقًا
...بين نخبة توتسكي العشرة

188
00:11:42,160 --> 00:11:43,680
.تسوكاسا إيشي-ساما

189
00:11:44,270 --> 00:11:48,640
سيكون خصمه الرّجل الّذي يقال
،"أنّه الأكثر موهبة في "نوار

190
00:11:48,640 --> 00:11:50,850
.سايبا أساهي-ساما

191
00:11:51,310 --> 00:11:53,560
.تشرّفت بلقائك يا تسوكاسا-كُن

192
00:11:54,040 --> 00:11:57,060
.أنت الرّجل الّذي بلغ قمّة توتسكي

193
00:11:57,060 --> 00:12:00,440
.أنت عكسي تمامًا
.تمثّل التّعريف المضبوط للنّخبة

194
00:12:00,840 --> 00:12:03,910
.أنا متفاجئ لأنّك لم تهرب خائفًا

195
00:12:04,230 --> 00:12:08,170
.واضح تمامًا أنّك سيّئ في الحكم على النّاس

196
00:12:09,440 --> 00:12:12,620
.سأفعل كلّ ما يتطلّبه الأمر لصالح الطّبخ

197
00:12:12,920 --> 00:12:16,000
،أنا هنا اليوم فقط لأستمتع بهذا

198
00:12:16,460 --> 00:12:19,430
.لذلك سيكون عليك مجاراتي فحسب

199
00:12:19,430 --> 00:12:22,090
.قد نتوافق جيّدًا أنا وأنت بالفعل

200
00:12:22,780 --> 00:12:26,300
ما رأيك أن نجعل الأمور أكثر اهتمامًا؟

201
00:12:26,610 --> 00:12:30,780
.ستعطيني مبشرتك تلك إن فزتُ أنا

202
00:12:31,990 --> 00:12:34,480
لن ترفض، صحيح؟

203
00:12:34,480 --> 00:12:36,720
،وبالطّبع إن فزتَ أنت

204
00:12:36,720 --> 00:12:39,610
.يمكنك أخذ ما تريده منّي

205
00:12:39,610 --> 00:12:44,330
،لا يمكنني القول أنّني مهتمّ ذلك
.لكن لا أمانع الأمر

206
00:12:46,010 --> 00:12:47,870
.الموضوع هو... فراخ الدّجاج

207
00:12:48,600 --> 00:12:51,080
!ابدآ الطّبخ الآن من فضلكما

208
00:12:52,220 --> 00:12:55,420
ما الّذي يخطّط له؟
لماذا قد يريد مبشرتي؟

209
00:12:55,880 --> 00:12:59,290
.لا يهمّ. سأبذل كلّ ما لديّ في طبقي فحسب

210
00:12:59,290 --> 00:13:01,760
!نعتمد عليك يا تسوكاسا إيشي

211
00:13:03,470 --> 00:13:08,060
،أريد لتسوكاسا إيشي-سينباي أن يفوز
!لكن لن أواجه ذلك الشّخص حينها

212
00:13:08,060 --> 00:13:09,900
...هذا صعب

213
00:13:09,900 --> 00:13:12,720
أنا واثق أنّ تسوكاسا-سينباي
...سيكون بخير، لكن

214
00:13:13,070 --> 00:13:15,570
ثمّة الكثير من الأمور المجهولة
.بشأن ذلك الشّخص

215
00:13:15,570 --> 00:13:16,730
.لا يجب أن يرخي دفاعاته

216
00:13:18,200 --> 00:13:20,580
.لكن انظر إلى تسوكاسا-سينباي

217
00:13:20,580 --> 00:13:21,560
.نعم

218
00:13:21,560 --> 00:13:23,650
.إنّه أكثر دقّة ممّا سبق

219
00:13:23,650 --> 00:13:26,330
.بالتّأكيد. لقد تقدّم كثيرًا

220
00:13:26,330 --> 00:13:29,620
.بالفعل. إنّه مجنون بالكامل لدرجة مزعجة

221
00:13:30,330 --> 00:13:32,730
!إيشيكي-سينباي! كوغا-سينباي

222
00:13:32,730 --> 00:13:35,210
!مرحبًا، مرحبًا، مرحبًا! نحن هنا

223
00:13:36,420 --> 00:13:39,890
.لكن أظنّ أنّ فوزك قد فاتنا يا سوما-كُن

224
00:13:39,890 --> 00:13:43,010
.لم أكن قلقًا على يوكيهيرا-تشين إطلاقًا

225
00:13:43,010 --> 00:13:43,630
!أجل

226
00:13:50,520 --> 00:13:52,760
".فارس الطّاولة الأبيض"

227
00:13:52,760 --> 00:13:54,600
...لكنّ تسوكاسا-سان

228
00:13:54,600 --> 00:13:58,560
نعم. إنّه لا يهتمّ لكلّ المكوّنات فحسب

229
00:13:58,560 --> 00:14:00,610
.دون ترك لمسته الخاصّة على الطّبق

230
00:14:01,440 --> 00:14:02,460
...الآن

231
00:14:05,890 --> 00:14:08,860
.لنتبارز أنا وأنت

232
00:14:10,240 --> 00:14:12,740
إنّه يقف على قدم المساواة
.مع مكوّناته ويواجهها

233
00:14:13,040 --> 00:14:16,440
وعن طريق فعل ذلك، أمسى مدركًا أكثر للمكوّنات

234
00:14:16,440 --> 00:14:19,330
.ويترك جزءًا من نفسه في الطّبق

235
00:14:19,330 --> 00:14:23,340
.لهذا الحدّ تطوّرت مهاراته في المحادثة

236
00:14:23,340 --> 00:14:25,850
هذا مذهل! لا أصدّق أنّه استطاع

237
00:14:25,850 --> 00:14:28,360
تطوير أسلوبه بذلك القدر
.في مهلة وجيزة

238
00:14:28,360 --> 00:14:31,720
يبدو أنّه سيجعل خصمه
.يمرّ بوقتٍ عصيب

239
00:14:31,720 --> 00:14:34,060
!نوار" ليسوا ندًّا له"

240
00:14:34,560 --> 00:14:35,890
!ماذا؟

241
00:14:35,890 --> 00:14:37,750
ما الّذي يحمله سايبا أساهي على خصره؟

242
00:14:41,180 --> 00:14:43,150
لديه العديد من السّكاكين في جِرابه؟

243
00:14:43,400 --> 00:14:46,560
ويبدو أنّه يملك أيضًا بعض السّكاكين
.الّتي تستعمل في السّيرك والمخاطرات

244
00:14:46,560 --> 00:14:48,740
!إضافة لشيء يبدو كأداة تعذيب

245
00:14:49,040 --> 00:14:51,070
!مهلاً، لماذا يملك ذلك الشّيء؟

246
00:14:51,070 --> 00:14:53,450
!إنّها حقنة كلود فيل

247
00:14:54,040 --> 00:14:57,410
سايبا أساهي هو الوحيد
.الّذي لا معلومات لديّ عنه

248
00:14:58,430 --> 00:15:00,790
.من هنا أيّها المراقب ترانشان

249
00:15:03,650 --> 00:15:05,710
...لا بدّ أنّه كان شجارًا غير قانونيّ

250
00:15:10,670 --> 00:15:12,590
.يا لها من مفاجأة

251
00:15:13,690 --> 00:15:17,130
لم أتوقّع أبدًا أن تسمحي
.ليوكيهيرا سوما بهزيمتك هكذا

252
00:15:17,130 --> 00:15:18,350
.أنا جدّ آسفة

253
00:15:18,680 --> 00:15:22,060
.لكنّ الأمور تسير جيّدًا لأجلي

254
00:15:22,540 --> 00:15:26,020
،عالم الجريمة أو العالم الخارجيّ
.ذلك لا يهمّ، فالطّهاة يحبّون التنافس

255
00:15:26,020 --> 00:15:28,030
.إنّهم لا يتردّدون في قبول تحدّياتي

256
00:15:28,430 --> 00:15:30,990
،بما أنّك خسرت الآن
فلن تستعملي ذلك، صحيح؟

257
00:15:31,870 --> 00:15:33,090
.هذا أمر

258
00:15:33,090 --> 00:15:36,460
.أعطني سكّين التّقطيع المنشاريّ خاصّتك

259
00:15:36,460 --> 00:15:37,540
.سيكون ذلك شرفًا لي

260
00:15:37,930 --> 00:15:42,670
فلتسطع سكاكينك المتقاطعة
.أكثر فأكثر يا أساهي-ساما

261
00:15:43,570 --> 00:15:47,880
.لا يوجد طاه بحواسّ حادّة مثل أساهي-ساما

262
00:15:48,310 --> 00:15:52,460
بعد حصوله على أدوات
،الطّهاة الآخرين وحملها

263
00:15:52,460 --> 00:15:54,130
تسمح له حاسّة لمسه

264
00:15:54,130 --> 00:15:59,310
بالحصول في الحال على أساليبهم في
.الطّبخ وإعادة إنشائها بشكل مثاليّ

265
00:15:59,750 --> 00:16:01,380
!حسنًا، لنبدأ

266
00:16:01,380 --> 00:16:04,100
!تقاطع... طبق الدّماء

267
00:16:04,680 --> 00:16:06,150
!لقد أتقنه

268
00:16:06,150 --> 00:16:10,690
!وبإمكانه استعمال مهارات مختلفة في كلّ يد

269
00:16:10,690 --> 00:16:13,780
!تقاطع... الطّبق المسلّح

270
00:16:13,780 --> 00:16:15,990
!يستعمل الآن سكّين التّقطيع المنشاريّ؟

271
00:16:16,240 --> 00:16:21,490
وفوق ذلك، بإمكانه الجمع بين
.المهارات والارتقاء بها لمستوى آخر

272
00:16:21,490 --> 00:16:22,460
...هذه هي حقيقة

273
00:16:23,760 --> 00:16:25,420
!السّكاكين المتقاطعة

274
00:16:25,420 --> 00:16:30,260
هل جمع بين سكّين أبي
وشيء آخر عندما واجهني؟

275
00:16:30,620 --> 00:16:35,140
هذا صحيح. كانت النّكهة الّتي قدّمها
.حينها في مستوى مختلف تمامًا

276
00:16:35,410 --> 00:16:36,850
...السّكاكين المتقاطعة

277
00:16:37,100 --> 00:16:39,430
!وكأنّ هنالك اثنان من ميماساكا

278
00:16:39,430 --> 00:16:42,140
.كلاّ، بل ليس حتّى اثنان أو ثلاثة منه هنا

279
00:16:42,140 --> 00:16:45,480
،في كلّ مرّة يُقاطع بين المهارات
.تزداد قدراته بشكل متضاعف

280
00:16:45,960 --> 00:16:47,690
.ويمكن خلق توليفات لا حصر لها

281
00:16:48,090 --> 00:16:50,190
!بإمكانه بلوغ السّماء ببساطة

282
00:16:50,510 --> 00:16:52,070
.قد يكون ذلك بعيد المنال قليلاً

283
00:16:52,800 --> 00:16:55,530
.طبق فراخ دجاج مشويّة

284
00:16:56,000 --> 00:16:57,740
.استمتعوا بالطّبق

285
00:16:57,980 --> 00:16:59,490
.انتهيت أنا أيضًا

286
00:17:01,120 --> 00:17:02,410
.طبق فراخ دجاج محمّرة

287
00:17:02,800 --> 00:17:04,690
.استمتعوا بالطّبق

288
00:17:06,360 --> 00:17:09,770
أنهى كلا المتنافسين طبقيهما
.في نفس الوقت تقريبًا

289
00:17:09,770 --> 00:17:11,460
.سيبدأ الحكّام التّذوّق الآن

290
00:17:11,460 --> 00:17:15,290
.لنبدأ بطبق سايبا أساهي

291
00:17:15,290 --> 00:17:18,010
.قائد "نوار"، سايبا أساهي

292
00:17:18,360 --> 00:17:20,220
ما مدى براعته يا ترى؟

293
00:17:23,800 --> 00:17:26,680
،تُبّلت فراخ الدّجاج بالخردل

294
00:17:26,680 --> 00:17:30,320
ثمّ شواها إلى درجة مثاليّة
.بزيت الزّبدة

295
00:17:30,900 --> 00:17:33,810
شُوِيَ البانكو المرشوش فوقها
،إلى أن أصبح بنّيًّا ذهبيًّا

296
00:17:33,810 --> 00:17:37,280
!ممّا عزّز ملمس فراخ الدّجاج مع كلّ قضمة

297
00:17:37,280 --> 00:17:39,820
لماذا هذا الطّبق موحّد بالكامل؟

298
00:17:39,820 --> 00:17:42,740
.لم يهدر أيّ شيء في اللّحم أو الصّلصة

299
00:17:42,740 --> 00:17:46,460
يكمن السّرّ في التقطيعات الصّغيرة
.الّتي قمتُ بها فوقها

300
00:17:46,460 --> 00:17:49,420
التّقطيعات الصّغيرة؟
...لكنّ هذا أكثر من مجرّد

301
00:17:49,420 --> 00:17:52,450
.صحيح. إنّها من مستوى مختلف

302
00:17:52,450 --> 00:17:56,770
استعملت سكّين التّقطيع المنشاريّ
،للقيام بالتّقطيعات الصّغيرة

303
00:17:56,770 --> 00:17:59,860
وذلك لكي لا يضيع ملمس
!فراخ الدّجاج الطّبيعيّ

304
00:18:00,800 --> 00:18:02,300
!هـ-هذا مذهل

305
00:18:02,300 --> 00:18:05,810
.كلاّ. سيستطيع تسوكاسا التّغلّب على ذلك

306
00:18:07,540 --> 00:18:10,950
.والآن، لنجرّب الطّبق الّتالي

307
00:18:10,950 --> 00:18:11,730
.حاضرة

308
00:18:12,410 --> 00:18:14,430
استطاع تسوكاسا إيشي إعداد

309
00:18:14,430 --> 00:18:17,350
طبق ذوّاقة فاخر من مكوّنات
.متجر بقالة بسيطة

310
00:18:17,350 --> 00:18:19,200
أيّ نوع من اللّذّة تنتظرني هذه المرّة؟

311
00:18:22,620 --> 00:18:25,580
!إنّها تذوب في الفم مباشرة

312
00:18:25,580 --> 00:18:28,540
!هذا ليس لحمًا! بل حلوى غزل البنات

313
00:18:28,820 --> 00:18:33,550
!انشراح

314
00:18:36,340 --> 00:18:38,190
،بعد أن فركت اللّحم بالأعشاب

315
00:18:38,190 --> 00:18:40,800
.شويته بعناية على حرارة متدنّية

316
00:18:40,800 --> 00:18:44,220
.فلتجرّبن رجاءً رغوة فاكهة فيجوا

317
00:18:44,530 --> 00:18:47,480
!الفيجوا فاكهة من أمريكا الوسطى والجنوبيّة

318
00:18:47,740 --> 00:18:49,560
صحيح. أعتقد أنّ تسوكاسا-سينباي

319
00:18:49,560 --> 00:18:52,900
ذكر أنّه وريندو-سينباي قد ذهبا
.للأمازون لبعض الوقت

320
00:18:53,390 --> 00:18:57,860
هذا مذهل! الحلاوة المنعشة
والطّعم الحامض للفيجوا

321
00:18:57,860 --> 00:19:00,110
!يأخذان النّكهة لمستويات أسمى

322
00:19:00,110 --> 00:19:05,120
تمكّنّا من رؤية هذا الجانب المجهول
.للمكوّنات بسبب هذه المحادثة

323
00:19:05,120 --> 00:19:07,100
!هذا هو تسوكاسا إيشي

324
00:19:07,100 --> 00:19:10,150
!قد يكون هذا كافيًا للتّغلّب على سايبا أساهي

325
00:19:10,860 --> 00:19:12,940
لـ-لكن لماذا؟

326
00:19:14,450 --> 00:19:18,590
لا أستطيع نسيان طبق أساهي سايبا بعد
!أن حاول الاستحواذ على قلبي

327
00:19:18,900 --> 00:19:20,070
...ولا أنا

328
00:19:20,070 --> 00:19:21,570
...وأنا أيضًا

329
00:19:22,270 --> 00:19:23,960
.هكذا هو الأمر

330
00:19:23,960 --> 00:19:26,260
ما جعل طبقي أفضل

331
00:19:26,770 --> 00:19:29,950
هي الأجزاء الصّغيرة من نقانق
...الذّماء المحشوّة في الدّجاج

332
00:19:29,950 --> 00:19:31,900
.نقانق الدّماء السّوداء

333
00:19:33,210 --> 00:19:34,560
!تقاطع

334
00:19:34,560 --> 00:19:36,110
إنّها توليفة بين الدّماء

335
00:19:36,110 --> 00:19:39,670
الّتي سحبتُها توًّا من فراخ
.الدّجاج وبين دماء الخنزير

336
00:19:39,670 --> 00:19:42,240
.وهذا ما أضاف ذلك التأثير الإضافيّ

337
00:19:42,240 --> 00:19:44,840
،إن استعملت دماء الخنزير اللاّذعة وحدها

338
00:19:44,840 --> 00:19:47,200
.لكانت قد طغت على رائحة فراخ الدّجاج

339
00:19:47,510 --> 00:19:48,970
.الدّهن هو الأساس هنا

340
00:19:48,970 --> 00:19:52,670
لم أحقن الدّماء من فراخ الدّجاج
.فحسب، بل الدّهن أيضًا

341
00:19:53,120 --> 00:19:56,320
.دهن الحيوانات مجرّد مكوّن فاخر وغنيّ

342
00:19:56,320 --> 00:20:00,510
إنّه يضيف عمقًا في نكهة اللّحم
.دون أن يشكّل عائقًا لها

343
00:20:01,580 --> 00:20:02,510
!تقاطع

344
00:20:02,970 --> 00:20:05,970
طريقة دقيقة ولكن حركيّة في طبخ
.اللّحم لإبراز أفضل ما فيه

345
00:20:06,950 --> 00:20:07,970
!تقاطع

346
00:20:07,970 --> 00:20:10,260
...لحم فراخ الدّجاج النّقيّ

347
00:20:10,260 --> 00:20:13,390
...ومتعة النّقانق المعدّة من الدّماء والدّهن

348
00:20:13,390 --> 00:20:14,440
...مجتمعة معًا

349
00:20:14,440 --> 00:20:16,650
!هذا طبقٌ محرّم ببساطة

350
00:20:18,010 --> 00:20:21,080
...الأمر وكأنّه ملائكة هاوين يخدمون شياطينًا

351
00:20:21,080 --> 00:20:23,500
...سنتبعه وأعيننا مغمضة

352
00:20:23,500 --> 00:20:25,370
!يا للنّشوة

353
00:20:26,010 --> 00:20:28,050
كان طبق تسوكاسا إيشي

354
00:20:28,050 --> 00:20:32,710
%طبقًا مثاليًّا أيضًا أبرز 120
.من خصائص كلّ المكوّنات

355
00:20:32,710 --> 00:20:36,080
لكنّ طبق سايبا أساهي تجاوز
!المثاليّة بحدّ ذاتها

356
00:20:36,080 --> 00:20:39,920
هذا صحيح. بإمكان مهارة السّكاكين
!"المتقاطعة تجاوز حتّى "لسان الإله

357
00:20:39,920 --> 00:20:43,840
هل من طاهٍ قادر على هزيمة
!السّكاكين المتقاطعة يا ترى؟

358
00:20:44,110 --> 00:20:46,840
!الفائز هو سايبا أساهي-ساما

359
00:20:50,060 --> 00:20:51,650
...تسوكاسا إيشي

360
00:20:51,650 --> 00:20:52,430
هُزم؟

361
00:20:52,900 --> 00:20:55,490
صاحب الرّتبة الأولى سابقًا
...في نخبة توتسكي العشرة

362
00:20:55,490 --> 00:20:57,150
يُجري محادثة مع المكوّنات؟

363
00:20:57,760 --> 00:20:59,900
.أعتقد أنّ تلك المهارة أمست لي الآن

364
00:21:00,670 --> 00:21:02,060
...ذلك الوغد

365
00:21:08,350 --> 00:21:09,370
.بلاءٌ حسن

366
00:21:25,220 --> 00:21:28,660
.يوكيهيرا... لا يمكنك أن تخسر

367
00:21:31,040 --> 00:21:31,830
.أكيد

368
00:22:54,850 --> 00:22:57,310
والآن، المشاركان في هذه الجولة

369
00:22:57,800 --> 00:23:01,940
هما صاحب الرّتبة السّابعة من نخبة
،توتسكي، تاكومي ألديني

370
00:23:02,340 --> 00:23:05,020
!"ودون كاما من "نوار

371
00:23:06,030 --> 00:23:09,110
.مساء الخير أيّها الفتى الوسيم

372
00:23:09,110 --> 00:23:11,780
.ستكون هذه معركة فِرق

373
00:23:11,780 --> 00:23:14,870
سيسجّل الطّاهيان الأعضاء
،الّذين سيدعمونهما شخصيًّا

374
00:23:14,870 --> 00:23:18,220
.وعليهم التّعاون معًا للفوز
هذه هي الشّروط

375
00:23:18,220 --> 00:23:20,580
.الّتي أرسلتها لنا سيّدة الكتاب

376
00:23:21,110 --> 00:23:26,460
.لديّ داعم واحد فقط
.أخي الأصغر إيسامي ألديني

377
00:23:35,540 --> 00:23:36,830
أصدقاء؟

378
00:23:36,830 --> 00:23:37,780
زملاء؟

379
00:23:37,780 --> 00:23:39,030
!ليس عدلاً