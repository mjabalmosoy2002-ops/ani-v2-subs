1
00:00:03,270 --> 00:00:06,060
.وهذا ما كسر ناكيري مانا

2
00:00:06,990 --> 00:00:09,780
.ما تحتاج إليه هو قوّة مختلفة

3
00:00:10,100 --> 00:00:13,150
وإلاّ، فلن تستطيعي إعداد
!الطّبق الّذي تريده

4
00:00:14,020 --> 00:00:15,960
ألم تسمعي الجمهور قبل قليل؟

5
00:00:15,960 --> 00:00:18,370
!يثق الجميع بأنّني سأفوز

6
00:00:18,370 --> 00:00:22,150
إن كنتِ تعتقدين أنّ هنالك
.من يعارض ذلك، فأودّ لقاءه

7
00:00:22,150 --> 00:00:25,880
.لن تكوني الطّاهي الّذي سيصبح منقذها

8
00:00:26,130 --> 00:00:27,130
.بل أنا

9
00:00:28,690 --> 00:00:30,340
...مهلاً لحظة

10
00:00:30,900 --> 00:00:32,340
.أنا لديّ اعتراض

11
00:00:32,720 --> 00:00:35,470
يثق الجميع بأنّك ستفوز؟

12
00:00:35,760 --> 00:00:39,600
،لديّ كلّ نيّة في اعتلاء القمّة
.لذلك أطعن في كلامك

13
00:00:39,900 --> 00:00:43,100
.هكذا إذًا؟ يبدو أنّ الأميرة إرينا تخالفك الرّأي

14
00:00:44,370 --> 00:00:46,520
أليس كذلك أيّتها الأميرة إرينا؟

15
00:00:47,090 --> 00:00:48,860
...ناكيري-سان، هل

16
00:00:49,310 --> 00:00:50,820
هل ذلك صحيح؟

17
00:00:50,820 --> 00:00:52,780
!هل ستتزوّجين أساهي-سان بالفعل؟

18
00:00:54,860 --> 00:00:56,540
...مهلاً يا تادوكورو

19
00:00:56,540 --> 00:01:00,020
ظننتُ أنّك ستكونين مكتئبة
.لأنّك خسرتِ، لكن يبدو أنّك بخير

20
00:02:39,120 --> 00:02:42,790
...بعد المباراة السّابقة، قال أساهي-سان

21
00:02:42,790 --> 00:02:47,420
نعم، بشأن توقّفك عن مصادقة
...الأميرة إرينا إن خسرتِ

22
00:02:47,420 --> 00:02:48,480
.فأنا أتراجع عن ذلك

23
00:02:49,480 --> 00:02:51,940
وبدل ذلك، هلاّ أخبرتِ الأميرة
إرينا بشيء من أجلي؟

24
00:02:52,410 --> 00:02:56,900
أخبريها انّك ستمنحين بركتك لزواجي
.من الأميرة إرينا كصديقة لها

25
00:02:56,900 --> 00:02:59,450
!ماذا؟! ز-ز-ز-زواج؟

26
00:02:59,960 --> 00:03:03,620
إنّه يهدّدني فقط بأن أصبح زوجته
.إن خسرت في نزال طبخ ضدّه

27
00:03:04,990 --> 00:03:08,950
ألهذا السّبب بدوتِ غاضبة خلال
نزالك مع تاكومي أيضًا؟

28
00:03:08,950 --> 00:03:11,040
...كان ذلك أمرًا مختلفًا

29
00:03:11,040 --> 00:03:15,040
.ولكن، أرجّح أنّك تقلقين بلا داعٍ

30
00:03:15,560 --> 00:03:18,030
رأيتِ تشكيلة المنافسة، صحيح؟

31
00:03:18,030 --> 00:03:23,010
،إن واصلتُ الفوز كما هو الحال
.فسأواجه سايبا أساهي أوّلاً

32
00:03:23,010 --> 00:03:26,030
!وحينها سأهزم أساهي شرّ هزيمة

33
00:03:26,030 --> 00:03:29,390
.لذلك لن تضطرّا أنتما الاثنان للمواجهة أساسًا

34
00:03:29,690 --> 00:03:32,370
هل تعتقد فعلاً أنّ الأمر سيسير بسلاسة هكذا؟

35
00:03:32,820 --> 00:03:36,110
.رأيت مدى قوّة مهارات السّكاكين المتقاطعة خاصّته

36
00:03:38,230 --> 00:03:42,510
ماذا؟ لماذا تقفين إلى جانب
أساهي على أيّ حال؟

37
00:03:42,510 --> 00:03:44,070
.إنّك تتصرّفين بغرابة

38
00:03:44,310 --> 00:03:47,490
.ما تحتاج إليه هو قوّة مختلفة

39
00:03:47,860 --> 00:03:50,690
.إنّه محقّ. أعلم ذلك

40
00:03:50,690 --> 00:03:53,710
.أعلم أنّني من تراودها أفكار غريبة

41
00:03:54,580 --> 00:03:59,800
ربّما يوجد جانب منّي يريدك
.أن تخسر يا يوكيهيرا-كُن

42
00:04:02,510 --> 00:04:04,850
.أساهي-ساما، أبليت حسنًا

43
00:04:04,850 --> 00:04:08,800
.نعم. سار كلّ شيء حسب الخطّة بفضلكم

44
00:04:08,800 --> 00:04:12,450
عثرتم على طريقة ماكرة للدّخول إلى توتسكي

45
00:04:12,450 --> 00:04:15,480
حتّى أنكم بحثتم بشأن كلّ
.شيء عن عائلة ناكيري

46
00:04:15,740 --> 00:04:18,480
.ما زالت هنالك مسألة واحدة نبحث فيها

47
00:04:18,480 --> 00:04:20,570
.أنا واثق أنّ هذا يكفي

48
00:04:20,800 --> 00:04:26,780
خطّتي للزّواج بالمرأة الأقوى، مالكة
.لسان الإله"، تسير على أحسن وجه"

49
00:04:27,000 --> 00:04:30,750
.لكنّ "لسان الإله" أعجوبة بالفعل

50
00:04:30,750 --> 00:04:32,200
إنّها صفة مميّزة

51
00:04:32,200 --> 00:04:35,070
تظهر عند أفراد عائلة ناكيري
من وقت لآخر، صحيح؟

52
00:04:35,070 --> 00:04:37,530
المرّة الوحيدة الّتي تمّ توارثها
لجيلين على التّوالي

53
00:04:37,530 --> 00:04:41,550
كانت مع ناكيري مانا وابنتها
.ناكيري إرينا كما يبدو

54
00:04:41,940 --> 00:04:46,570
إنّ حضور "لسان الإله" احتفاليّة
.مباركة في عالم الطّبخ

55
00:04:46,570 --> 00:04:49,680
لكن لا يمكن قول نفس الشّيء
.بالنّسبة لعائلة ناكيري بحدّ ذاتها

56
00:04:50,020 --> 00:04:54,080
إنّ كلّ صاحب "لسان إله" في التّاريخ يئس
من الطّعام في مرحلة أو أخرى

57
00:04:54,080 --> 00:04:56,690
.وقضى حياته في المعاناة

58
00:04:57,460 --> 00:05:02,970
،إنّ هذا من أوّل الأمور الّتي أتذكّرها
.لكنّني أتذكّره بكلّ وضوح

59
00:05:02,970 --> 00:05:06,990
،كانت أمّي شاحبة بالكامل
.وقد غار خدّاها في وجهها

60
00:05:07,700 --> 00:05:09,930
كانت تتقيّأ كلّ شيء تأكله

61
00:05:09,930 --> 00:05:12,290
.ولا تتحمّل حتّى رائحة الدّاشي

62
00:05:12,680 --> 00:05:15,910
.وفي يوم ما، تركت أمّي قصر ناكيري

63
00:05:16,540 --> 00:05:20,140
،إرينا، تمتلك مانا موهبة حقيقيّة

64
00:05:20,140 --> 00:05:23,330
.ولذلك السّبب عليها ترك الطّعام لوهلة

65
00:05:23,330 --> 00:05:26,300
.تحتاج لبعض الوقت لتُشفى

66
00:05:26,510 --> 00:05:28,960
كم ستحتاج من وقت؟

67
00:05:28,960 --> 00:05:32,790
متى ستعود أمّي للمنزل؟

68
00:05:34,090 --> 00:05:37,850
.لكنّ أمّي لم تعد أبدًا

69
00:05:40,750 --> 00:05:42,510
.إنّها سخرية القدر بالفعل

70
00:05:42,510 --> 00:05:45,300
،إنّ "لسان الإله" هو فخر تلك العائلة

71
00:05:45,300 --> 00:05:47,650
.وفي نفس الوقت، حضوره غير مرغوب فيه

72
00:05:47,940 --> 00:05:52,990
نعم. لكنّ السّكاكين المتقاطعة
.تستطيع تحريرهم من ذلك المصير

73
00:05:53,560 --> 00:05:55,510
،ستؤتي خطّتي ثمارها

74
00:05:55,510 --> 00:06:01,090
وستتمكّن ناكيري مانا، والأميرة إرينا
.أيضًا من عيش حياة سعيدة للأبد

75
00:06:01,870 --> 00:06:04,110
أنا واثقة أنّ أمل أمّي سيخيب

76
00:06:04,110 --> 00:06:08,550
إن فزتُ أنا بالمناسبة
.وأنا أمتلك "لسان الإله" مثلها

77
00:06:08,940 --> 00:06:13,590
لأنّني لا أملك الأمل الّذي بإمكانه
.إنقاذ أمّي من يأسها

78
00:06:14,520 --> 00:06:20,600
إن كان الوضع كذلك... إن تركت سايبا
.أساهي يفوز، فقد نصبح سعداء أخيرًا

79
00:06:22,240 --> 00:06:25,820
.آسف، لكن أنا من سيهزم أساهي

80
00:06:26,110 --> 00:06:28,900
،واضح أنّك تواجهين وقتًا عصيبًا

81
00:06:29,170 --> 00:06:30,870
.لكن لا شيء من ذلك يهمّني

82
00:06:30,870 --> 00:06:32,410
.لا علاقة لي بذلك

83
00:06:32,410 --> 00:06:34,370
.لا تقل هذا يا سوما-كُن

84
00:06:34,830 --> 00:06:37,410
!سأذهب للنّوم. تصبحان على خير

85
00:06:38,590 --> 00:06:43,080
حسنًا، أعتمد عليكم للاهتمام
.ببقيّة طهاة الخارج

86
00:06:43,080 --> 00:06:46,420
،وبالطّبع، إن واجهتم الأميرة إرينا قبلي

87
00:06:46,750 --> 00:06:48,380
.بإمكانكم هزيمتها إن أردتم

88
00:06:49,220 --> 00:06:52,290
نفس الأمر ينطبق على المزعج
.يوكيهيرا سوما أيضًا

89
00:06:53,360 --> 00:06:56,320
سوما-كُن! لماذا قلت أمورًا كتلك؟

90
00:06:57,840 --> 00:07:00,560
أخبرني، ما العمل؟

91
00:07:01,060 --> 00:07:05,490
من يدري؟ كلّ ما عرفته هو
.أنّ امتلاك "لسان الإله" أمر مزعج

92
00:07:05,490 --> 00:07:08,650
وبصراحة، لطالما كانت صادقة بشكل مزعج

93
00:07:08,650 --> 00:07:11,030
،عندما تقيّم أطباق الآخرين

94
00:07:11,030 --> 00:07:15,530
ومع ذلك لا تستطيع قول ما تريده
.للشّخص الوحيد الّذي تريد الحديث معه

95
00:07:31,570 --> 00:07:32,800
!بالهناء والشّفاء

96
00:07:35,300 --> 00:07:36,520
!سعيد لأنّ الطّبق أعجبكم

97
00:07:57,650 --> 00:07:58,720
!بالهناء والشّفاء

98
00:08:00,840 --> 00:08:02,030
!سعيد لأنّ الطّبق أعجبكم

99
00:08:03,030 --> 00:08:04,120
!تقاطع

100
00:08:09,350 --> 00:08:10,600
.سعيد لأنّ الطّبق أعجبكم

101
00:08:14,520 --> 00:08:17,720
تمكّن كلّ من إرينا-ساما ويوكيهيرا
.من الوصول لنصف النّهائيّ

102
00:08:17,720 --> 00:08:20,470
...نعم. وخصم يوكيهيرا التّالي هو

103
00:08:21,500 --> 00:08:22,680
.سايبا أساهي

104
00:08:22,940 --> 00:08:25,540
ما الّذي يفعله يوكيهيرا-كُن الآن؟

105
00:08:25,540 --> 00:08:28,190
.أعتقد أنّه يتجهّز للنّزال التّالي

106
00:08:28,520 --> 00:08:31,570
،حسنًا، كم أودّ أن أتجهّز الآن

107
00:08:31,570 --> 00:08:34,590
لكن لا نعرف حتّى ما موضوع
.النّزال إلى أن يبدأ

108
00:08:34,590 --> 00:08:36,160
ما الّذي يفترض بي فعله من الأساس؟

109
00:08:36,160 --> 00:08:37,490
...صحيح، ولكن

110
00:08:37,700 --> 00:08:38,770
!يا تادوكورو

111
00:08:38,770 --> 00:08:40,490
!يبدو أنّك تشعرين بالممل
!لنخض نزال طبخ

112
00:08:40,790 --> 00:08:45,500
!ماذا؟! أنا لست بمستوى أساهي-سان
!لن أكون ذات فائدة على الإطلاق

113
00:08:45,730 --> 00:08:49,600
.صحيح... ليت أبي كان هنا الآن

114
00:08:49,600 --> 00:08:52,170
.كنتُ لأتمكن من منافسته قدر ما أشاء

115
00:08:52,170 --> 00:08:54,420
.آسف على التّأخير يا جويتشيرو

116
00:08:54,740 --> 00:08:56,930
.مرحبًا يا غين. وصلت أخيرًا

117
00:08:56,930 --> 00:09:00,890
،أردت رؤية النّزال التّالي بأمّ عينيّ
.مهما تطلّب الأمر

118
00:09:01,200 --> 00:09:05,110
.لكّنّ القدر غريب بالفعل
.سيواجه ابنك تلميذك السّابق

119
00:09:05,610 --> 00:09:09,270
.ومن يتحكّم بمصير هذا النّزال هي أمّ ناكيري

120
00:09:09,480 --> 00:09:14,870
نعم. من كان يعلم أنّ ابنة سينزايمون-دونو
بنفسها من تترأس "م ذ ع"؟

121
00:09:14,870 --> 00:09:16,490
.صدمني ذلك كثيرًا بالفعل

122
00:09:16,490 --> 00:09:19,140
!فعلتَ الكثير لتصدم النّاس في الماضي

123
00:09:19,140 --> 00:09:23,120
هل تدرك كم أضعتُ من الوقت محاولاً
!الحصول على معلومات عن سايبا أساهي؟

124
00:09:23,120 --> 00:09:24,450
.أنا آسف

125
00:09:24,450 --> 00:09:26,310
!قلها وأنت تعنيها

126
00:09:26,310 --> 00:09:29,230
كيف هو حال يوكيهيرا سوما؟

127
00:09:29,230 --> 00:09:30,650
من يدري؟

128
00:09:30,650 --> 00:09:33,510
.لأصدقك القول، لم أره مذ وصلتُ إلى هنا

129
00:09:33,510 --> 00:09:35,250
ما... لماذا؟

130
00:09:35,250 --> 00:09:38,900
.خضت أزيد من 500 نزال طبخ مع سوما

131
00:09:38,900 --> 00:09:41,470
.ظننتُ أنّ ذلك يكفي

132
00:09:41,470 --> 00:09:44,430
.خضتما 500 نزال؟ هذا مذهل

133
00:09:44,430 --> 00:09:48,650
رغم أنّ أمّي هي من علّمني
.الطّبخ أوّل مرّة

134
00:09:49,070 --> 00:09:54,280
يعيد لي هذا الذّكريات... وقوف أمّي
...وأبي في المطبخ في مطعم يوكيهيرا

135
00:09:54,640 --> 00:09:57,570
.وكنتُ أقف هناك لساعات وأنا أراقبهما

136
00:09:57,790 --> 00:09:59,950
!تاماكو-تشان، أعدّي لي شيئًا مميّزًا

137
00:10:00,670 --> 00:10:01,910
.حسنًا، لنفتح رهانًا

138
00:10:02,140 --> 00:10:03,870
هل سيكون لذيذًا أم مقرفًا؟

139
00:10:04,950 --> 00:10:06,750
طبق طاهٍ خاصّ؟

140
00:10:07,090 --> 00:10:08,330
.انتظر فحسب

141
00:10:12,340 --> 00:10:13,960
.حسنًا! بالهناء والشّفاء

142
00:10:14,660 --> 00:10:16,170
!إنّه حلو

143
00:10:20,880 --> 00:10:22,360
.تدين لنا بثلاث جعات

144
00:10:22,360 --> 00:10:26,520
.هذا غريب. ربّما أخفقت في خلط التّوابل

145
00:10:26,790 --> 00:10:30,710
يملك والدك مطعمًا شعبيًّا
.وأنت سيّئة في الطّبخ

146
00:10:30,710 --> 00:10:32,950
.لكنّها تقدّم أطباقًا ممتازة من حين لآخر

147
00:10:32,950 --> 00:10:34,980
.إنّ الأرزّ المقليّ خاصّتها دقيق عادةً

148
00:10:35,280 --> 00:10:38,740
بالطّبع. هذا لأنّني فشلت
.في إعداده مرّات كثيرة

149
00:10:38,740 --> 00:10:41,380
.إنّ الأخطاء هي أمّ النّجاح قبل كلّ شيء

150
00:10:41,380 --> 00:10:43,330
.تبًّا، أحتاج للتّخلّص من هذا المذاق في فمي

151
00:10:43,330 --> 00:10:45,200
.جويتشيرو-تشان، أعدّ لي بعض السّمك المشوي

152
00:10:45,410 --> 00:10:46,330
.في الحال

153
00:10:46,710 --> 00:10:50,080
.يا عزيزي، أعدّ لي بعض السّمك أيضًا
.ومعه بعض الجعة

154
00:10:50,360 --> 00:10:52,040
.عودي إلى العمل

155
00:10:53,170 --> 00:10:55,830
.لم يهمّ إن نجحت أو فشلت

156
00:10:55,830 --> 00:10:59,010
.أحببت مشاهدة أمّي وهي تستمتع بوقتها

157
00:10:59,300 --> 00:11:02,590
.اسمع يا سوما. يدك اليسرى هي المفتاح

158
00:11:02,590 --> 00:11:03,440
.جرّب

159
00:11:03,440 --> 00:11:04,220
!حاضر

160
00:11:05,270 --> 00:11:06,600
!أمّي، سيحترق الطّعام

161
00:11:06,600 --> 00:11:09,350
!لا بأس، لا بأس. واصل العمل يا بنيّ

162
00:11:10,300 --> 00:11:11,810
يوم الآباء؟

163
00:11:19,790 --> 00:11:21,700
!مهلاً! إنّها تتحرّك كثيرًا

164
00:11:25,830 --> 00:11:28,490
ماذا حدث يا سوما؟ ما هذه الضجّة؟

165
00:11:28,490 --> 00:11:32,560
.كان ذلك وشيكًا. لا تقلقا
.لم أسقط مكوّناتنا الغالية

166
00:11:35,290 --> 00:11:37,710
،أنت محظوظ لأنّك لم تتأذّ بشدّة

167
00:11:37,960 --> 00:11:40,840
.لكن قد ينتهي بك المطاف بندبة

168
00:11:40,840 --> 00:11:43,800
!ندبة؟ سيدو ذلك رائعًا

169
00:11:44,270 --> 00:11:46,510
لماذا الأولاد أغبياء هكذا؟

170
00:11:46,810 --> 00:11:50,370
ما رأيك يا تاماكو؟
.فكّرت في هذا البارحة فحسب

171
00:11:50,370 --> 00:11:53,690
!إنّه لذيذ! أحسنت عملاً يا عزيزي

172
00:11:54,230 --> 00:11:57,070
.حسنًا يا أمّي. أعددتُ شيئًا ما أيضًا

173
00:11:57,070 --> 00:11:59,030
!إنّه أفضل من طبق أبي

174
00:12:00,250 --> 00:12:02,780
يبدو أنّ الطّريق أمامك طويل
.إن أردت هزيمة والدك

175
00:12:02,780 --> 00:12:04,240
!ماذا؟

176
00:12:06,900 --> 00:12:10,710
ليتنا استطعنا نحن الثّلاثة
...قضاء وقتنا معًا للأبد

177
00:12:16,060 --> 00:12:17,010
...أبي

178
00:12:17,520 --> 00:12:18,880
.لنتنافس في الطّبخ

179
00:12:23,680 --> 00:12:25,370
.حسنًا. لك ذلك

180
00:12:26,080 --> 00:12:29,680
.كان سوما فتى قويًّا مذّاك الحين

181
00:12:30,150 --> 00:12:33,640
.إنّه ابن تاماكو قبل كلّ شيء

182
00:12:34,850 --> 00:12:35,960
،أساهي-ساما

183
00:12:35,960 --> 00:12:38,690
.تلقّينا جديدًا بشأن المكوّنات غير القانونيّة

184
00:12:38,690 --> 00:12:41,440
صحيح، صحيح. يبدو
أنّ الوقت لإبرام الصّفقة

185
00:12:41,440 --> 00:12:44,820
.هو في نفس الوقت مع نزالك يا أساهي-ساما

186
00:12:45,230 --> 00:12:48,680
.حسنًا، يهتمّ بقيّة أعضاء "نوار" بالأمر

187
00:12:48,680 --> 00:12:49,910
.دعوهم فحسب

188
00:12:50,360 --> 00:12:51,120
.مرحبًا

189
00:12:51,690 --> 00:12:55,080
أعتقد أنّ هذا هو لقاؤنا الأوّل
.في اليابان يا أساهي

190
00:12:55,080 --> 00:12:56,410
...جويتشيرو

191
00:12:58,700 --> 00:13:01,130
.توفّيت زوجتي للتّوّ

192
00:13:01,810 --> 00:13:05,720
.عليّ البقاء مع سوما... مع ابني

193
00:13:06,230 --> 00:13:07,590
لذلك ما رأيك؟

194
00:13:08,130 --> 00:13:11,570
.بإمكانك المجيء معي إن أردت

195
00:13:13,700 --> 00:13:14,850
.لن أذهب

196
00:13:15,780 --> 00:13:16,780
.هكذا إذًا

197
00:13:19,220 --> 00:13:20,770
...سرقتَه منّي

198
00:13:21,410 --> 00:13:22,680
!يا سوما

199
00:13:23,830 --> 00:13:24,950
،جويتشيرو

200
00:13:25,170 --> 00:13:28,700
.سأهزم ابنك الفاشل شرّ هزيمة

201
00:13:29,290 --> 00:13:32,540
.وهذه المرّة للأبد

202
00:13:42,680 --> 00:13:43,630
!أجل

203
00:13:43,630 --> 00:13:46,510
!أحسنت يا مديرة أكاديميّة توتسكي

204
00:13:47,880 --> 00:13:50,020
...ناكيري-سان مذهلة

205
00:13:50,020 --> 00:13:53,440
لكن ما تلك النّظرة؟

206
00:13:55,360 --> 00:13:57,390
.حان الوقت أخيرًا يا أساهي-ساما

207
00:13:57,670 --> 00:14:01,980
لا داعي للعجلة. لديّ عمل أخير
.عليّ إنجازه قبل أحقّق طموحاتي

208
00:14:01,980 --> 00:14:04,940
.ويبدو أنّ الإزعاج قد وصل

209
00:14:05,240 --> 00:14:09,070
يوكيهيرا، تريد الانتقام منّي، صحيح؟

210
00:14:09,520 --> 00:14:12,160
.من المؤسف أنّك لن تحصل على أمنيتك

211
00:14:12,160 --> 00:14:15,540
.أنا من سيتحقّق حلمه ويحصل على كلّ شيء

212
00:14:15,810 --> 00:14:19,860
.اسمع، بإمكانك فعل ما يحلو لك إن هزمتني

213
00:14:19,860 --> 00:14:21,630
...ولمعلوماتك فحسب

214
00:14:22,280 --> 00:14:24,880
.لن تستطيع إسعاد ناكيري

215
00:14:25,850 --> 00:14:27,760
هذا تصريح جريء

216
00:14:27,760 --> 00:14:30,350
.من طفل صغير مثلك يا يوكيهيرا

217
00:14:36,470 --> 00:14:38,460
.ها هو ذا. إنّه سايبا أساهي

218
00:14:38,460 --> 00:14:40,690
!إن فاز بهذا النّزال، فسيتأهّل للنّهائيّ

219
00:14:41,040 --> 00:14:43,650
!أرهم ما لديك يا ذا السّكاكين المتقاطعة

220
00:14:43,920 --> 00:14:46,040
!ستصعد للقمّة في بلو

221
00:14:44,450 --> 00:14:46,860
.يشجّع الجميع أساهي-سان

222
00:14:47,130 --> 00:14:49,660
.إنّه المنافس المفضّل بكلّ تأكيد

223
00:14:49,660 --> 00:14:54,080
لا بدّ أنّ ذلك يعني أنّ السّكاكين
.المتقاطعة تركت تأثيرًا كبيرًا

224
00:15:00,140 --> 00:15:03,290
.آسف. يبدو أنّني حزت على إعجاب الجمهور

225
00:15:03,560 --> 00:15:04,500
أأنت غاضب؟

226
00:15:04,500 --> 00:15:06,250
.لا، على الإطلاق

227
00:15:06,510 --> 00:15:08,740
!أجل

228
00:15:08,740 --> 00:15:11,830
!يوكيهيرا! نحن هنا

229
00:15:11,830 --> 00:15:13,870
!سنقلب الموازين لصالحنا

230
00:15:13,870 --> 00:15:15,510
!انطلق يا يوكيهيرا

231
00:15:15,510 --> 00:15:16,660
!حظًّا سعيدًا

232
00:15:16,660 --> 00:15:17,930
!إيّاك أن تخسر

233
00:15:17,930 --> 00:15:19,890
أردنا تشجيع ميغومي

234
00:15:19,890 --> 00:15:23,900
وتاكوميتشي وإريناتشي أيضًا لكن
!لم نستطع الحصول على التّذاكر

235
00:15:23,900 --> 00:15:25,040
!رفاق

236
00:15:25,040 --> 00:15:25,900
.هذا مطمئن

237
00:15:28,040 --> 00:15:31,030
.لا بدّ أنّك فخور بزملائك الأصغر يا إيشّيكي

238
00:15:31,730 --> 00:15:35,280
كما كنتَ تساعد يوكيهيرا-تشين
البارحة، صحيح يا تسوكاسا-سان؟

239
00:15:35,490 --> 00:15:39,120
.نعم. أردت مساعدته بقدر المستطاع

240
00:15:39,730 --> 00:15:43,790
ما كنت لأتخيّل أبدًا أنّهما قد يقوما
.بمنافسات طبخ طوال اللّيل

241
00:15:44,720 --> 00:15:46,100
!كيف تجرؤون على عدم دعوتي؟

242
00:15:46,100 --> 00:15:48,130
!شكرًا يا رفاق

243
00:15:50,330 --> 00:15:51,330
...مانا

244
00:15:53,580 --> 00:15:54,640
...والآن

245
00:15:54,640 --> 00:15:58,320
،أكره القيام بهذا بينما كلّ رفاقه هنا

246
00:15:58,320 --> 00:16:01,420
لكن سيكون عليّ سحب البساط
.من تحت يوكيهيرا

247
00:16:02,070 --> 00:16:04,850
أنت قلق بشأن الأميرة إرينا أيضًا، صحيح؟

248
00:16:05,070 --> 00:16:06,860
هل لديك وقت للإلهاءات بالفعل؟

249
00:16:06,860 --> 00:16:08,340
الإلهاءات؟

250
00:16:08,340 --> 00:16:09,800
.لا بدّ أنّك تمزح

251
00:16:09,800 --> 00:16:12,350
.أنا أنظر إليك مباشرة

252
00:16:13,660 --> 00:16:15,530
تعرف ما هذا، صحيح؟

253
00:16:15,900 --> 00:16:17,240
.سكّين أبي

254
00:16:17,540 --> 00:16:22,960
سأنهي أمرك بنسخة أفضل
!من سكّينك... سكّين والدك

255
00:16:23,310 --> 00:16:27,870
ما كنت لأطلب أفضل
.من استعمالك لسكّين والدي

256
00:16:27,870 --> 00:16:31,970
...هذا القتال هو طريقة لتجاوز أبي أخيرًا

257
00:16:31,970 --> 00:16:35,890
!باستعمال سكّيني الخاصّ

258
00:16:36,500 --> 00:16:39,850
مهلاً، مهلاً. أرى أنّ الشّابين متحمّسين جدًّا؟

259
00:16:40,240 --> 00:16:42,550
.ممتاز، ممتاز

260
00:16:42,550 --> 00:16:48,520
.هذا يعني أنّنا سنحتاج لموضوع جدير بشغفكما

261
00:16:48,880 --> 00:16:52,990
هنالك مطابخ تُعرف بـ"المطابخ
."الخمسة الكبرى في العالم

262
00:16:53,270 --> 00:16:57,280
،ثمّة العديد من النّظريّات حيالها
لكنّها المطابخ الفرنسيّة والصّينيّة

263
00:16:57,280 --> 00:17:01,490
...والتّركيّة والهنديّة والإيطاليّة

264
00:17:02,030 --> 00:17:05,710
هذه المطابخ الخمسة
.هي على الأرجح الأكثر تأثيرًا

265
00:17:05,940 --> 00:17:08,670
...لذلك، سيكون موضوع هذا النّزال

266
00:17:08,890 --> 00:17:10,380
!جميع هذه المطابخ

267
00:17:11,440 --> 00:17:13,120
.بإمكانكما استعمال أيّ مكوّنات تريدان

268
00:17:13,120 --> 00:17:15,300
.أمامكما 180 دقيقة

269
00:17:15,680 --> 00:17:19,140
ستقومان بجمع خمس مطابخ
،كبرى في طبق واحد

270
00:17:19,430 --> 00:17:22,520
!وصنع المطبخ الأمثل

271
00:17:22,520 --> 00:17:24,600
!فليبدأ الطّبخ

272
00:17:24,600 --> 00:17:27,510
ماذا؟! عليهما الجميع بين هذه المطابخ
الخمسة في طبق واحد؟

273
00:17:27,510 --> 00:17:29,370
!كيف يكون ذلك ممكنًا؟

274
00:17:29,370 --> 00:17:31,040
!ذلك صعب للغاية

275
00:17:31,040 --> 00:17:34,650
استطعتُ الجمع بين أفضل ثلاث حسيّ
،في العالم في منافسات بلو التّمهيديّة

276
00:17:34,650 --> 00:17:37,570
!لكن من المستحيل الجمع بين خمسة مطابخ كبرى

277
00:17:37,850 --> 00:17:39,460
ما هذا؟

278
00:17:39,460 --> 00:17:43,600
يستعمل كلّ مطبخ منها مكوّنات
.وطرق طبخ مختلفة

279
00:17:43,600 --> 00:17:45,330
وتريدها كلّها في طبق واحد؟

280
00:17:45,330 --> 00:17:47,340
.هذا صعب بالفعل

281
00:17:47,340 --> 00:17:50,810
،لكن إن لم أستطع التّعامل مع شيء كهذا

282
00:17:50,810 --> 00:17:54,880
لن أتمكّن أبدًا من إعداد شيء
.سيرضي والدة ناكيري

283
00:17:55,260 --> 00:17:58,640
مهلاً، مهلاً. ليس لديك الكثير
.من الوقت للتّفكير

284
00:17:58,850 --> 00:18:01,140
.تبدو لي واثقًا من نفسك كثيرًا

285
00:18:01,420 --> 00:18:03,890
.لديّ سكاكيني المتقاطعة قبل كلّ شيء

286
00:18:06,740 --> 00:18:11,520
!هذا يتجاوز المطابخ الخمسة الكبرى
!لديه سكاكين من كلّ شكل من أشكال الطّبخ

287
00:18:12,190 --> 00:18:12,980
!تقاطع

288
00:18:12,980 --> 00:18:15,320
!ذلك يشبه كوكري

289
00:18:17,210 --> 00:18:20,230
قطّع الزّنجبيل والبصل الأخضر
!وتلك الأعشاب في لمح البصر

290
00:18:20,230 --> 00:18:23,450
!وها هو الآن يضيفها لمرق الدّجاج بسرعة فائقة

291
00:18:24,060 --> 00:18:24,910
!تقاطع

292
00:18:25,320 --> 00:18:28,610
.تلك طاحنة توابل تستعمل في المطبخ الهنديّ

293
00:18:28,610 --> 00:18:30,170
لديه شيء كهذا أيضًا؟

294
00:18:30,170 --> 00:18:33,080
،إنّ تسخين تلك التّوابل في الزّيت بدقّة

295
00:18:33,080 --> 00:18:36,630
يجعله يظهر التّأثير الفعليّ للمكوّنات
.ورائحتها المذهلة

296
00:18:36,910 --> 00:18:39,720
مهارات التّقاطع لديه تجمع
بين أمور مختلفة في كلّ خطوة في تحضيره؟

297
00:18:39,940 --> 00:18:44,180
.يبدو أنّه يستعمل تقاطعات أكثر من معركته معي

298
00:18:45,720 --> 00:18:47,920
.تلك زعنفة القرش داخل المبخرة

299
00:18:47,920 --> 00:18:50,190
.ويبدو الآن وكأنّه يعدّ طبقًا صينيًّا

300
00:18:50,190 --> 00:18:52,190
!جويتشيرو... تقاطع

301
00:18:52,430 --> 00:18:53,650
!مخالب الموت الأسود

302
00:18:53,890 --> 00:18:55,850
...إنّه يمرٍّرها بين ألياف زعنفة القرش

303
00:18:55,850 --> 00:18:57,860
.يا لها من سرعة مذهلة

304
00:18:58,220 --> 00:19:00,280
،حتّى في الطّبخ الصّينيّ الأصليّ

305
00:19:00,280 --> 00:19:05,580
يجب غلي زعنفة القرش في حساء بايتان
.أو صلصة المحار لتعزيز النّكهة

306
00:19:05,930 --> 00:19:07,620
،وباستعماله لتلك المخالب

307
00:19:07,620 --> 00:19:11,670
فهو قادر على إدخال النّكهة
.أكثر في زعنفة القرش

308
00:19:11,670 --> 00:19:12,420
—تلك

309
00:19:12,810 --> 00:19:15,670
!تقاطع جويتشيرو... وتسوكاسا إيشي

310
00:19:16,090 --> 00:19:18,010
!إنّه يستعمل مبشرة تسوكاسا-سينباي

311
00:19:22,310 --> 00:19:25,720
!إنّه يبشر الزّبدة بسرعة هائلة

312
00:19:25,990 --> 00:19:29,930
لقد عزّز أساليب طبخه أكثر
.من أيّ نزال آخر سبق وشاهدناه

313
00:19:30,170 --> 00:19:36,150
إنّه طاهٍ مذهل يستطيع إتقان استعمال
.أيّ أداة تحضير أو أسلوب في لحظات

314
00:19:36,150 --> 00:19:40,860
وعن طريق تقاطعها مع مهارات
!جويتشيرو-سان، أصبح أكثر دقّة

315
00:19:40,860 --> 00:19:43,690
.لكنّ هذا يستنزف الكثير منّي فوق ممّا تظنّون

316
00:19:43,690 --> 00:19:48,080
،إن سمحت لدفاعاتي بأن ترتخي ولو لوهلة
!فإنّ التّوازن بين النّكهات سيفسد

317
00:19:48,080 --> 00:19:50,660
.اهدأ يا أساهي

318
00:19:50,660 --> 00:19:51,460
!ذلك الصّوت

319
00:19:52,690 --> 00:19:54,870
!رئيس الطّهاة ريانش كومار

320
00:19:54,870 --> 00:19:57,730
.أعلم أنّك ستستطيع إعداد طبق مذهل

321
00:19:57,730 --> 00:19:59,960
.فقد هزمتني قبل كل شيء

322
00:20:00,850 --> 00:20:06,200
.إنّ فهم التّوابل يعني فهم كلّ الطّبيعة

323
00:20:06,200 --> 00:20:07,570
!الشّيخ شاهي

324
00:20:07,570 --> 00:20:10,140
.لا تنس ذلك أبدًا

325
00:20:10,140 --> 00:20:14,420
إنّ أهمّ شيء عند إعداد دوندورما
.هو امتلاك قلب ليّن

326
00:20:14,420 --> 00:20:16,180
!نادر دوبايزيد

327
00:20:16,180 --> 00:20:19,110
هل ما زال قلبك مرنًا؟

328
00:20:19,500 --> 00:20:22,540
.هذا صحيح. لست وحدي

329
00:20:23,100 --> 00:20:24,950
إنّ سبب تمكّني من إعداد هذا الطّبق

330
00:20:25,790 --> 00:20:27,420
.هو بفضلهم جميعًا

331
00:20:28,060 --> 00:20:29,140
!من يكونون؟

332
00:20:29,140 --> 00:20:31,850
أعجز حتّى عن التّعاطف معه لجهلي
!لمن يكون أيّ من هؤلاء

333
00:20:31,850 --> 00:20:34,430
!كفّ عن تظاهرك بأنّك بطل قصّة ما

334
00:20:34,430 --> 00:20:35,500
!إنّك تغضبني

335
00:20:35,980 --> 00:20:41,190
في الحقيقة، أجبرهم جميعًا
.لقتاله وسرق أدواتهم

336
00:20:41,190 --> 00:20:45,010
أنا واثق أنّ لا أحد منهم يشعر
.بذلك الكرم تجاهه بالفعل

337
00:20:45,010 --> 00:20:47,970
.هذا يشبه التّدريب في توتسكي

338
00:20:47,970 --> 00:20:53,430
ومع ذلك نرى ذاك الفتى قد أتقن
مهاراتهم بمجرد استعمال أدواتهم؟

339
00:20:53,750 --> 00:20:57,120
بشكل نظريّ، لنقل أنّ هنالك
،طاهيًا جاب عالم الطّبخ

340
00:20:57,120 --> 00:21:01,110
.وأضاع طريقه وسمح للعاصفة بالتهامه

341
00:21:01,620 --> 00:21:05,910
.سأكون قادرًا على بلوغ أهداف أبعد منه

342
00:21:06,410 --> 00:21:09,120
.سأترك العاصفة خلفي في وقت وجيز

343
00:21:09,380 --> 00:21:14,250
أستطيع التّفكير في طبق جديد
!أو أيّ شيء أريده

344
00:21:14,820 --> 00:21:16,210
هل أنا مخطئ؟

345
00:21:16,610 --> 00:21:20,300
،إن خسر يوكيهيرا، فستبتلع الظّلمة ناكيري

346
00:21:20,300 --> 00:21:23,170
.وكلّ طهاة الخارج سيفقدون مصداقيّتهم

347
00:21:24,050 --> 00:21:24,880
...هذا صحيح إذًا

348
00:21:25,170 --> 00:21:30,600
إنّ الأمل الوحيد لتحقيق أمنية
.أمّي هو بفوز سايبا أساهي

349
00:21:30,600 --> 00:21:34,350
.هذا جيّد. أشعر بتحسّن الآن

350
00:21:34,560 --> 00:21:37,980
.فمن الوهلة الأولى، لديك فرصة معقولة

351
00:21:37,980 --> 00:21:42,260
لكنّها ببساطة وسيلة غشّ عن كلّ
التّدريبات الّتي خضناها، صحيح؟

352
00:21:42,260 --> 00:21:46,560
هذا يعني أنّنا ما زلنا في نفس
.المستوى بطريقة ما

353
00:21:46,560 --> 00:21:50,780
.لذلك أعتقد أنّه من الأفضل أن أسرع باللّحاق بك

354
00:21:55,380 --> 00:21:58,170
.هذا بالضّبط ما يجعلك ساذجًا

355
00:21:58,170 --> 00:22:00,860
لماذا لا تجرّب إن كنت قادرًا على ذلك؟

356
00:22:07,380 --> 00:22:09,590
...انتظر فحسب

357
00:22:09,950 --> 00:22:11,800
!يا سايبا أساهي

358
00:23:35,540 --> 00:23:37,960
!البطل أساهي ومجموعة من الأشخاص العشوائيّين

359
00:23:37,960 --> 00:23:39,930
!حصلتُ للتّوّ على 11 نقطة خبرة؟