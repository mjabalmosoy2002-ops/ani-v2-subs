1
00:00:03,970 --> 00:00:05,940
يبدو أنّ طبق سايبا أساهي

2
00:00:06,690 --> 00:00:08,450
.هو باستي

3
00:00:21,010 --> 00:00:22,890
.هبة مانا

4
00:00:22,890 --> 00:00:24,580
وأنا من سيحتلّ الصّدارة

5
00:00:24,580 --> 00:00:27,420
وأكون صاحب المقعد الأوّل في الجيل
!التّالي لعالم الطّبخ

6
00:00:33,710 --> 00:00:35,340
ما هذا الطّبق؟

7
00:00:35,340 --> 00:00:37,390
.أسمّيه الأرزّ المقليّ معدوم الرّائحة

8
00:00:37,850 --> 00:00:42,410
لا أنفكّ عن الانجذاب أكثر
...مع كلّ قضمة

9
00:00:42,680 --> 00:00:46,420
إلى العاصفة الّتي يحاول
.هذا الفتى عبورها

10
00:00:46,180 --> 00:00:50,050
...بالهناء... والشّفاء

11
00:00:46,420 --> 00:00:50,350
...في الحقيقة، مصدر هذه العاصفة

12
00:00:51,640 --> 00:00:54,070
!هو سحر هذا الفتى

13
00:00:55,780 --> 00:00:57,740
!كلّا

14
00:00:57,740 --> 00:00:59,830
!وصلت كلّ هذه المسافة إلينا

15
00:01:00,160 --> 00:01:02,460
...كانت لها نفس ردّة الفعل... إذًا

16
00:01:02,460 --> 00:01:04,080
من هو الفائز؟

17
00:01:04,080 --> 00:01:06,210
...أهو سايبا أساهي أم

18
00:01:10,850 --> 00:01:12,840
!مستحيل

19
00:01:16,050 --> 00:01:17,510
...نبضات الهبة

20
00:01:17,510 --> 00:01:18,760
!إنّها تتوسّع

21
00:01:19,300 --> 00:01:20,720
.كلاّ

22
00:01:20,720 --> 00:01:23,560
.هذه الظّاهرة ليست هبة عاديّة

23
00:03:02,520 --> 00:03:06,580
ما الّذي تعنيه بأنّها ليست هبة
عاديّة يا عمّي أزامي؟

24
00:03:07,000 --> 00:03:12,720
ترسل نبضات الهبة موجات لذّة
.للآخرين، وتفقدهم ملابسهم

25
00:03:13,410 --> 00:03:15,470
.لكن ما يحدث الآن ليس مجرّد خلع للملابس

26
00:03:15,470 --> 00:03:18,050
.إنّه التفجّر، بحيث تتمزّق الملابس

27
00:03:18,050 --> 00:03:22,370
إنّ هذا يتجاوز بطريقة ما
.الهبة الّتي تنقل التّعرّي

28
00:03:22,370 --> 00:03:26,140
هل هذا مستوى متطوّر عن الهبة
!والّذي ينقل التّفجّر؟

29
00:03:26,420 --> 00:03:30,250
هذا بالفعل أمر وحده مالك
...لسان الإله" يمكن تحقيقه"

30
00:03:30,930 --> 00:03:32,690
!الهبة المقدّسة

31
00:03:38,160 --> 00:03:39,820
!ماذا؟

32
00:03:44,200 --> 00:03:46,820
إذًا فهما هبتا التفجّر والتّعرّي
في نفس الوقت؟

33
00:03:46,820 --> 00:03:48,970
لا بدّ أنّ ذلك يعني أنّ طبقه
!أفضل من طبق سايبا أساهي

34
00:03:48,970 --> 00:03:53,530
نعم! لا بدّ أنّ عمّتي مانا
!قد وجدت طبقه لذيذًا

35
00:03:53,530 --> 00:03:55,630
...طبق يوكيهيرا-كُن

36
00:03:55,630 --> 00:03:59,520
!كيف؟ هذا مستحيل

37
00:03:59,520 --> 00:04:03,160
!لا يوجد طبّاخ يضاهي سكاكيني المتقاطعة

38
00:04:03,160 --> 00:04:04,590
!لا يمكن أن يوجد

39
00:04:05,140 --> 00:04:08,350
من المستحيل أن تتمكّن من إعداد
!طبق ألذّ من طبق باستي خاصّتي

40
00:04:08,350 --> 00:04:12,230
أنا واثقة أنّه إن لم يكن طبق
،يوكيهيرا سوما لذيذًا كما هو الآن

41
00:04:12,230 --> 00:04:14,750
.لكنتَ قد فزت بدون أيّ مشكلة

42
00:04:16,000 --> 00:04:19,980
صحيح أنّ طبق باستي الّذي
.أعدّه سايبا أساهي كان ممتازًا

43
00:04:20,700 --> 00:04:25,180
أمكنني تذوّق تقنيات العديد من
.الطّهاة مجتمعة في طبق واحد

44
00:04:25,180 --> 00:04:28,700
...لكن بمجرّد إزالة تلك القشرة

45
00:04:28,700 --> 00:04:30,380
.كان فارغًا

46
00:04:30,380 --> 00:04:32,660
.لم أتمكّن من إيجاد مذاقك الخاصّ

47
00:04:33,350 --> 00:04:37,040
.أنا واثقة أنّك أدركت ذلك في صميم قلبك

48
00:04:37,620 --> 00:04:42,010
ولتجنّب حقيقة أنّك لا تملك أيّ جزء
،من نفسك لتضعه في أطباقك

49
00:04:42,010 --> 00:04:45,970
.واصلت سرقة سكاكين الآخرين

50
00:04:46,590 --> 00:04:50,450
من جهة أخرى، كان يوكيهيرا سوما
...حريصًا على إظهار أنّ مذاقه الخاصّ

51
00:04:51,470 --> 00:04:55,490
.هو نتيجة لِما تعلّمه مِن كلّ مَن قابلهم

52
00:04:56,890 --> 00:04:58,940
.والآن، حان وقت اتّخاذ القرار

53
00:04:59,520 --> 00:05:02,150
.يا رجال الكتاب، أعلنوا نتائجكم

54
00:05:02,680 --> 00:05:07,350
،واصلت التّباهي بشأن تجاوز جويتشيرو

55
00:05:07,350 --> 00:05:11,200
لكنّ صورة أبي الّتي كنتُ ألاحقها
مذ كنتُ طفلاً

56
00:05:11,200 --> 00:05:14,370
.كانت أقوى بكثير ممّا قد تصل إليه أنت

57
00:05:23,540 --> 00:05:25,930
!الفائز هو يوكيهيرا سوما

58
00:05:26,510 --> 00:05:27,630
!سرّني أنّه أعجبكم

59
00:05:27,630 --> 00:05:29,600
!مرحى

60
00:05:29,870 --> 00:05:31,060
!سوما-كُن

61
00:05:31,060 --> 00:05:33,520
.أنت رجل مذهل بالفعل

62
00:05:33,520 --> 00:05:34,830
!يوكيهيرا

63
00:05:35,880 --> 00:05:37,230
.لستَ سيّئًا على الإطلاق

64
00:05:46,440 --> 00:05:47,990
.أظنّ أنّ القرار قد اتُّخذ

65
00:05:48,930 --> 00:05:50,700
.أنت الفائز يا يوكيهيرا

66
00:05:51,280 --> 00:05:53,290
.أعد هذا لجويتشيرو بدلاً منّي

67
00:05:54,260 --> 00:05:59,780
بما أنّني لم أستطع الوصول إلى قمّة
.بلو"، فلستُ جديرًا بهذا السّكّين"

68
00:06:00,190 --> 00:06:01,410
.لا أريده

69
00:06:02,740 --> 00:06:05,380
فزت به من أبي بعدل وإنصاف، صحيح؟

70
00:06:05,880 --> 00:06:08,920
.لذلك تملك كلّ الحقّ بالاحتفاظ به

71
00:06:09,440 --> 00:06:14,310
والأهمّ من ذلك، لماذا أردت بشدّة
أن تجعل ناكيري زوجة لك؟

72
00:06:16,020 --> 00:06:19,690
.أخبرني يا جويتشيرو
كيف أصبح طاهيًا جيّدًا؟

73
00:06:20,210 --> 00:06:23,190
...ماذا؟ حسنًا

74
00:06:23,550 --> 00:06:29,530
كنت أتجوّل في أرجاء العالم
.منذ أن تركت مدرسة تُدعى توتسكي

75
00:06:29,960 --> 00:06:33,490
.وقد قلّ شغفي في الطّبخ قليلاً

76
00:06:33,760 --> 00:06:36,370
.وبعدها قابلت زوجتي

77
00:06:36,620 --> 00:06:38,510
.إنّها امرأة غريبة الأطوار

78
00:06:38,510 --> 00:06:41,920
طبخها فظيع، لكنّها تصرّ
.على الوقوف في المطبخ

79
00:06:41,920 --> 00:06:42,840
فعلاً؟

80
00:06:43,130 --> 00:06:44,610
إنّ مشاهدتها جعلتني

81
00:06:44,610 --> 00:06:47,550
.أشعر كالغبيّ بشغل تفكيري بأمر كهذا

82
00:06:47,900 --> 00:06:51,010
إذًا فقد أصبحت تحبّ الطّبخ ثانية بسببها؟

83
00:06:51,010 --> 00:06:53,970
...صحيح. لذلك يا أساهي

84
00:06:54,360 --> 00:06:56,660
إنّ مفتاح أن تصبح طبّاخًا جيّدًا

85
00:06:56,660 --> 00:07:03,360
هو إيجاد شخص ما تشعر وكأنّك
.قادر على تقديم كلّ طبخك له

86
00:07:04,360 --> 00:07:07,960
لماذا الأميرة إرينا؟ أليس واضحًا؟

87
00:07:07,960 --> 00:07:10,260
،أريد أن أصبح أقوى
—"وهي تملك "لسان الإله

88
00:07:10,260 --> 00:07:11,410
فعلاً؟

89
00:07:11,670 --> 00:07:16,870
.بالنّسبة لي، بدوت وكأنّك تبحث عن شيء آخر

90
00:07:20,160 --> 00:07:21,600
عمّ تتحدّث؟

91
00:07:23,750 --> 00:07:26,500
...هذا غريب... سايبا أساهي

92
00:07:26,910 --> 00:07:29,470
.أشعر بشيء ما بداخله لا أشعر به عند غيره

93
00:07:31,490 --> 00:07:33,770
...السّبب الّذي جعلني أرغب بأن أصبح أقوى

94
00:07:47,010 --> 00:07:50,400
.أنا واثق أنّك ستجد ما تبحث عنه يومًا ما

95
00:07:52,170 --> 00:07:53,860
...وأيضًا يا أساهي

96
00:07:54,570 --> 00:08:00,000
مهما قاله الآخرون، فسأظلّ والدك
.عندما يتعلّق الأمر بالطّبخ

97
00:08:01,880 --> 00:08:03,000
عمّ تتحدّث؟

98
00:08:04,810 --> 00:08:05,710
...مذاقي الخاصّ

99
00:08:06,290 --> 00:08:08,670
طبخي... الخاصّ بي؟

100
00:08:08,670 --> 00:08:10,000
!أساهي-ساما

101
00:08:11,480 --> 00:08:13,760
."سأترك "نوار

102
00:08:14,830 --> 00:08:17,220
كنت أحاول التّظاهر بدور الزّعيم
.الكبير الشّرّير، وانظروا أين أوصلني

103
00:08:17,810 --> 00:08:19,470
.بإمكانكم فعل ما يحلو لكم

104
00:08:19,790 --> 00:08:22,850
!سنذهب معك إذًا
!سنتبعك لأيّ مكان

105
00:08:23,540 --> 00:08:27,270
أنتم غريبون. لا شيء جيّد
.ستجنونه من ملاحقتي

106
00:08:27,520 --> 00:08:28,660
!أساهي-ساما

107
00:08:30,730 --> 00:08:36,460
من المؤسف جدًّا أنّ أولئك السّخفاء قد وضعوا
.علامة سوداء على سجلّك المثاليّ يا تسوكاسا-سان

108
00:08:36,460 --> 00:08:38,700
.بل أنا ممتنٌ لذلك في الحقيقة

109
00:08:39,000 --> 00:08:41,580
.لقد علّموني ما أفتقر له

110
00:08:42,200 --> 00:08:44,420
،إن كانوا طهاة حقيقيّين

111
00:08:44,420 --> 00:08:49,290
فسيستعملون تلك الهزيمة كحافز
.للتّطلّع نحو مستويات أسمى

112
00:08:50,230 --> 00:08:53,260
.عليّ العمل بجدّ أيضًا

113
00:08:55,740 --> 00:08:58,430
.لست ندًّا لك بالفعل يا تسوكاسا-سان

114
00:08:58,850 --> 00:09:00,250
!يوكيهيرا

115
00:09:00,250 --> 00:09:01,550
.أحسنت عملاً

116
00:09:02,260 --> 00:09:03,140
.شكرًا لكم

117
00:09:03,430 --> 00:09:08,760
أنا واثق أنّ يوكيهيرا كان ليواجه المشاكل
.لو أنّ الميتزالونا خاصّتي قد سُرقت

118
00:09:08,760 --> 00:09:11,940
كنت رائعًا! أذقت أتباع السّكاكين
!المتقاطعة مرارة الهزيمة

119
00:09:11,940 --> 00:09:15,480
.واعترفت سيّدة الكتاب بطبقك أيضًا

120
00:09:16,220 --> 00:09:17,320
!بالفعل

121
00:09:17,320 --> 00:09:20,470
.لا تسئ الفهم يا يوكيهيرا سوما

122
00:09:20,890 --> 00:09:25,830
صحيح أنّ طبقك كان
.في مستوى عالٍ من اللّذّة

123
00:09:26,290 --> 00:09:30,290
.لكنّه ما زال لا يرتقي للمستوى الّذي أتوق إليه

124
00:09:30,290 --> 00:09:35,290
فعلاً...؟ رغم أنّه استحقّ توليفة
بين هبتَيْ التّفجّر والتّعرّي؟

125
00:09:35,290 --> 00:09:36,510
.أنت طمّاعة بالفعل

126
00:09:36,510 --> 00:09:38,010
.لا تغترّ بنفسك

127
00:09:38,390 --> 00:09:45,080
مستحيل أنّ هذا الطّبق كان ليستطيع
.تجاوز ما تحمّلته طوال هذه السّنين

128
00:09:45,990 --> 00:09:50,560
أرني طبقًا أكثر لذّة من هذا
.بكثير في النّهائيّ

129
00:09:51,650 --> 00:09:53,140
!هذا صحيح! النّهائيّ

130
00:09:53,140 --> 00:09:56,030
!نعم! إريناتشي ويوكيهيرا سيتواجهان لآن

131
00:09:56,030 --> 00:09:59,010
هذا مذهل! ستكون معركة
!بين اثنين من تلاميذ توتسكي

132
00:09:59,010 --> 00:10:01,120
!لا أعرف حتّى من سأشجّع

133
00:10:01,330 --> 00:10:04,560
!تهانينا يا يوكيهيرا-كُن

134
00:10:04,560 --> 00:10:06,080
.أحسنت يا يوكيهيرا

135
00:10:07,000 --> 00:10:08,580
.شكرًا، شكرًا

136
00:10:08,580 --> 00:10:11,260
.يا ناكيري، حظًّا سعيدًا في الغد

137
00:10:11,260 --> 00:10:12,250
—لنخض قتالاً جيّـ

138
00:10:17,130 --> 00:10:18,370
إرينا-ساما؟

139
00:10:18,370 --> 00:10:19,750
ناكيري-سان؟

140
00:10:32,140 --> 00:10:33,520
.المعذرة

141
00:10:34,030 --> 00:10:36,490
.مرّ وقت طويل يا أزامي

142
00:10:37,020 --> 00:10:37,940
...مانا

143
00:10:38,850 --> 00:10:41,110
لماذا هذه الملامح الحزينة؟

144
00:10:41,580 --> 00:10:47,410
قبل ستّة أشهر، كنت تتباهى
.بكونك مدير توتسكي

145
00:10:48,390 --> 00:10:53,660
أنا واثقة أنّك كنت تعذّب كلّ
.من كان يقف في طريقك

146
00:10:53,660 --> 00:10:55,390
.الأمر جليّ لي الآن

147
00:10:55,390 --> 00:11:00,990
رحلتِ دون قول أيّ شيء وصرتِ
."فجأة سيّدة الكتاب في "م ذ ع

148
00:11:00,990 --> 00:11:04,890
أصبحتِ في مقام عالٍ وشامخ
.لكن ما زلت تجهلين متى تخرسين

149
00:11:05,390 --> 00:11:07,480
!اخرس أيّها المكتئب

150
00:11:07,480 --> 00:11:09,350
!يكفي يا ذات الحاجبين الغريبين

151
00:11:11,420 --> 00:11:14,270
.ذكّرني هذا بلقائنا الأوّل

152
00:11:15,500 --> 00:11:16,400
.بالفعل

153
00:11:16,800 --> 00:11:21,360
.لم تكن إلّا قوقعة فارغة حينها

154
00:11:21,990 --> 00:11:25,260
.كنت فارغًا تمامًا بعد مغادرة سايبا-سينباي

155
00:11:26,150 --> 00:11:29,830
قمتُ بأعمال كثيرة داخل وخارج
،البلاد كجزء من النّخبة العشرة

156
00:11:30,210 --> 00:11:33,290
.لكن لم تكن هنالك حياة في طبخي

157
00:11:33,290 --> 00:11:34,520
...وبعدها

158
00:11:34,520 --> 00:11:37,120
من أعدّ هذا؟

159
00:11:37,120 --> 00:11:37,880
.إنّه أنا

160
00:11:38,360 --> 00:11:42,600
إنّ مذاقه أشبه بمجموعة
غوريلات جبليّة نسيت

161
00:11:42,600 --> 00:11:46,200
كيف تطبّل جرّاء اليأس الّذي تشعر به
.بسبب برودة ينبوعها السّاخن

162
00:11:46,640 --> 00:11:47,590
ماذا؟

163
00:11:47,590 --> 00:11:49,670
.يا له من طبق فظيع

164
00:11:49,670 --> 00:11:51,100
.لا شغف فيه على الإطلاق

165
00:11:52,840 --> 00:11:55,160
هل تصفين طبقي بالفظيع؟

166
00:11:55,160 --> 00:11:59,280
.لا بدّ أنّك تشعر ببعض الغضب والكره

167
00:11:59,740 --> 00:12:03,280
إذًا اكتشف كيف تحوّل
.تلك المشاعر إلى شيء لذيذ

168
00:12:03,280 --> 00:12:06,700
.هكذا يجب أن يكون طهاة توتسكي

169
00:12:06,700 --> 00:12:10,160
.سأجعلك تسحبين كلماتك تلك

170
00:12:10,430 --> 00:12:13,790
بصراحة، ما كلّ تلك الكآبة؟

171
00:12:13,790 --> 00:12:15,890
.لا تعرف تلك المرأة متى تخرس

172
00:12:15,890 --> 00:12:17,130
.وحاجباها غريبان

173
00:12:18,430 --> 00:12:20,600
.أردت هزيمتها بمذاقي

174
00:12:20,600 --> 00:12:22,300
.كان ذلك كلّ ما يشغل بالي حينها

175
00:12:35,890 --> 00:12:36,810
.ليس سيّئًا

176
00:12:37,390 --> 00:12:39,190
.أصبحت أفضل بكلّ تأكيد

177
00:12:39,790 --> 00:12:44,400
.ساعدتني على استعادة شغفي للطّبخ

178
00:12:45,410 --> 00:12:50,050
ومعك، كان بإمكاني الذّهاب
.إلى أيّ مكان في أفق الذّوّاقة

179
00:12:50,750 --> 00:12:52,040
.أو ذلك ما ظننته على الأقلّ

180
00:12:56,030 --> 00:12:56,460
...لكن

181
00:12:57,700 --> 00:12:59,170
.لا عمق كافٍ في المذاق

182
00:12:59,630 --> 00:13:02,130
يا إلهي... ربّما لست جيّدة كفاية

183
00:13:02,390 --> 00:13:05,010
!"يبدو أنّ إرينا قد ورثت "لسان الإله

184
00:13:05,010 --> 00:13:07,340
جيلان على التّوالي؟

185
00:13:08,330 --> 00:13:11,810
على إرينا تحمّل هذه المعاناة أيضًا؟

186
00:13:12,450 --> 00:13:16,020
إنّ حاملي "لسان الإله" مقدّر
.لهم أن يعانوا ويتفتتوا

187
00:13:16,860 --> 00:13:22,190
لكنّ تطوّرك كان سريعًا جدًّا بالنّسبة لي
.ولم أستطع مواصلة دعمك

188
00:13:22,680 --> 00:13:24,730
.أظنّ أنّك مررت بالكثير بدورك

189
00:13:25,970 --> 00:13:27,400
...سايبا-سينباي

190
00:13:27,400 --> 00:13:29,860
سينزايمون-دونو... كنت هنا
طوال الوقت أيضًا؟

191
00:13:29,860 --> 00:13:34,920
بدأتما بتذكّر الماضي، لذلك كانت
.مقاطعتكما ستكون غير ملائمة

192
00:13:35,950 --> 00:13:38,230
.ثمّة أمر أردت اكتشافه

193
00:13:38,230 --> 00:13:42,130
لذلك طلبتُ مساعدة أبي
.لمناقشة الأمور أكثر من قبل

194
00:13:42,490 --> 00:13:45,340
.يتعلّق الأمر بك أنت أيضًا بطريقة ما

195
00:13:46,500 --> 00:13:50,680
.لطالما راودني شعور بأنّه يشبهك

196
00:13:51,360 --> 00:13:55,520
ربّما كان ذلك سبب شعوري
.بأنّ عليّ الاهتمام به

197
00:13:55,980 --> 00:13:57,520
عمّ تتحدّث؟

198
00:13:57,520 --> 00:14:00,220
"إنّ حامل "لسان الإله
قادر على معرفة

199
00:14:00,220 --> 00:14:02,730
.ما يشعر به الطّاهي الّذي يتذوّق طبقه

200
00:14:02,980 --> 00:14:07,070
وهنالك أوقات أستطيع فيها
.أن أتصوّر حتّى حالتهم النّفسيّة

201
00:14:07,330 --> 00:14:13,030
إنّ أوّل طبق تذوّقته لك
.كان فارغًا ويفتقر للشّغف

202
00:14:13,030 --> 00:14:18,250
والطّبق الّذي تذوّقته قبل قليل
.كان يشبهه تمامًا

203
00:14:18,940 --> 00:14:21,380
.ما كنتُ حتّى لأتخيّل أنّ غريبًا أعدّه

204
00:14:22,730 --> 00:14:25,050
.أنا أتحدّث عن طبق سايبا أساهي

205
00:14:26,180 --> 00:14:27,470
...أعتقد

206
00:14:27,470 --> 00:14:31,040
أنّ إرينا-ساما ويوكيهيرا
.سيتواجهان غدًا بالفعل

207
00:14:31,040 --> 00:14:32,070
.نعم

208
00:14:32,070 --> 00:14:36,930
في العادة، يكونان متحمّسين أكثر لأنّهما
...سيتواجهان ضدّ بعضيهما، لكن

209
00:14:39,490 --> 00:14:41,940
.أتساءل إن كانت ناكيري-سان بخير

210
00:14:44,950 --> 00:14:46,920
طبق لا يمكن العثور عليه
.في أيّ مكان في العالم

211
00:14:47,280 --> 00:14:52,870
،حتّى بـ"لسان الإله" الخاصّ بأمّي
.ما زال عالم النّكهات هذا مجهولاً

212
00:14:54,120 --> 00:14:56,830
وبغرض القفز فوق هذه
...العقبة المستحيلة

213
00:14:57,190 --> 00:15:00,870
لو أمكنني فقط ترك كلّ شيء لسكاكين
...سايبا أساهي المتقاطعة

214
00:15:01,170 --> 00:15:02,330
.فكّرت في ذلك بالفعل

215
00:15:02,970 --> 00:15:03,460
...لكن

216
00:15:03,880 --> 00:15:06,840
تمكّن يوكيهيرا-كُن من التّفوق
.على السّكاكين المتقاطعة

217
00:15:07,490 --> 00:15:10,370
إذًا فهل عليّ ترك كلّ شيء بين يديه الآن؟

218
00:15:11,240 --> 00:15:14,330
!كلاّ! يجب أن أكون أنا الفائزة

219
00:15:15,010 --> 00:15:18,770
عليّ إعداد طبق سيرضي
.أمّي بيديّ هاتين

220
00:15:20,440 --> 00:15:22,270
...يا أمّي

221
00:15:22,920 --> 00:15:25,730
.وجد جدّي هذا الطّبق لذيذًا

222
00:15:26,090 --> 00:15:27,880
هل تودّين تذوّقه أيضًا؟

223
00:15:33,520 --> 00:15:35,940
.إنّه طبق جميل يا إرينا

224
00:15:35,940 --> 00:15:36,830
.أحسنت عملاً

225
00:15:37,250 --> 00:15:40,920
،كانت أمّي تجاملني كثيرًا

226
00:15:40,920 --> 00:15:44,080
لكنّها لم تقل يومًا
.أنّ أطباقي كانت لذيذة

227
00:15:45,360 --> 00:15:49,550
.لا أستطيع إسعاد أمّي

228
00:15:50,450 --> 00:15:53,030
.كلّ ما أستطيع فعله هو جعلها حزينة

229
00:16:04,270 --> 00:16:06,190
!إنّه مقرف

230
00:16:08,140 --> 00:16:09,460
!انتظري فحسب

231
00:16:09,460 --> 00:16:13,450
!"سأجعلك تصفينه بـ"اللّذيذ

232
00:16:17,960 --> 00:16:19,430
.اسمعي يا ناكيري

233
00:16:19,430 --> 00:16:21,540
.لقد تمكّنتُ من الوصول لهذه المرحلة

234
00:16:21,540 --> 00:16:25,540
خطوة واحدة أخرى وأصل حيث أستطيع مواجهتك

235
00:16:25,540 --> 00:16:27,170
.على مقعد الأفضل في السّنة الأولى

236
00:16:28,220 --> 00:16:32,550
"!اليوم هو اليوم الّذي سأجعلك فيه تقولين "لذيذ

237
00:16:32,980 --> 00:16:34,550
!بالهناء والشّفاء

238
00:16:34,550 --> 00:16:36,300
،لكي نهزم سينباي

239
00:16:36,300 --> 00:16:39,890
علينا مواجهته باختصاصين
.نعدّهما بكلّ ما لدينا

240
00:16:40,310 --> 00:16:43,730
.على وجبتنا أن تكون بذلك المستوى

241
00:16:43,960 --> 00:16:45,690
...هاجميني

242
00:16:45,690 --> 00:16:48,400
وضعي كلّ ما لديك

243
00:16:48,400 --> 00:16:50,450
!في اختصاصك

244
00:16:51,160 --> 00:16:56,280
سأريك أنا إرينا، القوّة الحقيقيّة
!لـ"لسان الإله" خاصّتي

245
00:16:58,150 --> 00:17:00,450
أنا واثقة أنّ أمل أمّي سيخيب

246
00:17:00,450 --> 00:17:04,960
إن فزتُ أنا بالمسابقة
.وأنا أمتلك "لسان الإله" مثلها

247
00:17:05,410 --> 00:17:09,930
لأنّني لا أملك الأمل الّذي بإمكانه
.إنقاذ أمّي من يأسها

248
00:17:49,610 --> 00:17:52,020
.حان الوقت أخيرًا

249
00:17:52,020 --> 00:17:55,830
نعم. سيصبح الأمر واضحًا
...أخيرًا بعد هذا النّزال

250
00:17:55,830 --> 00:17:58,840
.نتيجة الخطّة الّتي تصوّرتها لمدّة طويلة

251
00:17:58,840 --> 00:18:01,300
خطّة جيل العباقرة؟

252
00:18:01,630 --> 00:18:02,760
.بالفعل

253
00:18:04,370 --> 00:18:07,080
.سأكون الحكم في هذا النّهائيّ

254
00:18:07,870 --> 00:18:11,540
.الموضوع... طبق لم يشهد العالم مثيلاً له

255
00:18:12,730 --> 00:18:14,320
.قدّما أفضل ما لديكما

256
00:18:14,700 --> 00:18:16,280
!فلتبدآ الطّبخ

257
00:18:17,960 --> 00:18:20,340
يا إلهي. في البداية طبق باستعمال
،المطابخ الخمسة الكبرى

258
00:18:20,340 --> 00:18:22,120
.والآن طبق لم يشهد العالم مثيلاً له

259
00:18:22,470 --> 00:18:25,580
حسنًا... ما الّذي عليّ خلطه معًا؟

260
00:18:25,580 --> 00:18:27,480
...وجه يوكيهيرا

261
00:18:27,480 --> 00:18:29,510
لن يحاول إعداد شيء مقرف، صحيح؟

262
00:18:29,510 --> 00:18:30,960
.ما كنت لأستبعد تلك الاحتماليّة

263
00:18:32,680 --> 00:18:34,830
.إنّها سريعة

264
00:18:34,830 --> 00:18:36,790
هل تعرف سلفًا الّذي ستطبخه؟

265
00:18:36,790 --> 00:18:38,470
!هذا ما نتوقّعه من المديرة

266
00:18:38,870 --> 00:18:40,040
إرينا-ساما؟

267
00:18:41,540 --> 00:18:43,660
ألا يبدو أنّ هنالك خطبًا ما بها؟

268
00:18:43,660 --> 00:18:44,140
.بلى

269
00:18:45,080 --> 00:18:49,940
،وكأنّها تجهل تمامًا إلى أين تتّجه
.لكنّ هنالك ما يدفعها للطّبخ

270
00:18:50,180 --> 00:18:53,900
،بعد أن تركت مانا القصر
.أدركتُ أمرًا

271
00:18:54,400 --> 00:18:58,900
أنّ المأساة الّتي حلت على حاملي
لسان الإله" السّابقين ومانا"

272
00:18:59,220 --> 00:19:01,850
.ستحلّ على إرينا أيضًا في النّهاية

273
00:19:02,980 --> 00:19:05,530
.لا بدّ من طريقة ما

274
00:19:05,530 --> 00:19:07,810
لا أستطيع الرّحيل عن هذا العالم

275
00:19:07,810 --> 00:19:09,910
.بدون أن أنقذ ابنتي وحفيدتي

276
00:19:10,450 --> 00:19:12,150
!لا يمكنني

277
00:19:12,720 --> 00:19:15,500
.لن أسمح لإرينا بالخروج من توتسكي

278
00:19:16,480 --> 00:19:20,680
.سأدرجها في توتسكي من المرحلة الإعداديّة

279
00:19:20,680 --> 00:19:21,380
ماذا؟

280
00:19:22,130 --> 00:19:25,610
إن استطعنا تدريب مهارات
،إرينا في الطهو إلى أقصى إمكانيّاتها

281
00:19:25,610 --> 00:19:28,930
قد نتمكّن من إنقاذها
.من العاصفة الّتي قد تبتلعها

282
00:19:28,930 --> 00:19:34,150
لكن يا أبي، لطالما كانت العادة
...أن نربّي أطفال ناكيري خارج

283
00:19:35,050 --> 00:19:37,360
!لا آبه أبدًا للعادات

284
00:19:37,980 --> 00:19:42,820
أريدك أن تجمع الحجارة
!الّتي ستصقل مهارات إرينا

285
00:19:43,510 --> 00:19:45,530
!جيل العباقرة

286
00:19:47,390 --> 00:19:48,750
...أيّها الأستاذ هاياما

287
00:19:49,120 --> 00:19:53,710
سمعتُ أنّ شيومي-كُن قد عثرت
.على صبيّ مثير للاهتمام في الخارج

288
00:19:54,080 --> 00:19:58,670
لماذا لا نربّي هذا الصّبيّ
في اليابان، في مدرستنا؟

289
00:19:59,250 --> 00:20:01,130
!أرجوك يا أبي

290
00:20:01,130 --> 00:20:04,340
أريد أخذ ريو-كُن معنا أيضًا
!عندما نعود لليابان

291
00:20:04,590 --> 00:20:07,010
تقصدين الفتى الّذي يعمل
في الحانة قرب ميناء الصّيد؟

292
00:20:08,160 --> 00:20:12,770
سأساعد أبي في خطّته لمساعدة
.أختي الصّغيرة مانا

293
00:20:13,020 --> 00:20:13,980
ماذا؟

294
00:20:15,990 --> 00:20:17,100
ماذا؟

295
00:20:17,100 --> 00:20:20,400
تريد من تاكومي وإيسامي أن يرتادا
أكاديميّة توتسكي في اليابان؟

296
00:20:20,700 --> 00:20:25,110
أنا أرى أنّهما طاهيان مذهلان
.حقًّا بصفتي عمّهما

297
00:20:25,830 --> 00:20:28,330
أرسل ميغومي إلى أكاديميّة توتسكي؟

298
00:20:29,070 --> 00:20:31,250
...ابنة رئيس مجموعة ميتو

299
00:20:31,670 --> 00:20:32,960
.مذهل

300
00:20:39,340 --> 00:20:41,040
أنت لا تستسلم، صحيح؟

301
00:20:41,040 --> 00:20:43,050
.حسنًا، لا بأس. أستسلم

302
00:20:43,050 --> 00:20:45,280
لكن لا تلمني إن انتهى المطاف بسوما

303
00:20:45,280 --> 00:20:47,680
.وهو يقلب الموازين على حفيدتك العزيزة

304
00:20:48,430 --> 00:20:53,320
كنتُ مدركًا تمامًا أنّ هذه كانت خطّة
.متعجرفة، والأفضليّة فيها لذوي دمّي

305
00:20:53,320 --> 00:20:55,200
.لكنّني لم أهتمّ لما عليّ أن أضحّي به

306
00:20:55,200 --> 00:20:57,690
.سأزرع الأمل في إرينا

307
00:20:58,650 --> 00:21:02,730
ما رأيك في ذلك يا ابنتي؟
!ثمّة أمل في الطّبخ

308
00:21:02,730 --> 00:21:05,700
!قمتُ بكلّ هذا لجعلك ترينه

309
00:21:06,510 --> 00:21:08,830
أستطيع فعلاً الشّعور بحبّك
.لابنتك وحفيدتك

310
00:21:09,250 --> 00:21:11,410
.ما أنا إلّا أب وجدّ شغوف

311
00:21:11,410 --> 00:21:15,750
.وفي النّهاية، كلّ ما فعلته هو تهيئة الظّروف

312
00:21:16,900 --> 00:21:18,180
...عليّ فعل هذا

313
00:21:18,180 --> 00:21:20,380
!لا بدّ أن أكون أنا... أنا

314
00:21:20,900 --> 00:21:23,110
...طبق لم ير العالم مثيلاً له من قبل

315
00:21:23,110 --> 00:21:28,080
أنا مديرة أكاديميّة توتسكي
."وحاملة لـ"لسان الإله

316
00:21:28,080 --> 00:21:30,280
!عليّ أن أكون من سينجح في ذلك

317
00:21:31,160 --> 00:21:33,580
لكن ماذا بإمكاني فعله؟

318
00:21:33,580 --> 00:21:36,000
أخبرتني أمّي بنفسها

319
00:21:36,000 --> 00:21:37,900
.أنّها لا تتوقّع منّي أيّ شيء

320
00:21:38,590 --> 00:21:40,630
.حتّى مستقبلي منقوش على الحجر سلفًا

321
00:21:40,630 --> 00:21:44,500
.سيصيبني اليأس من الطّبخ مثل أمّي

322
00:21:45,440 --> 00:21:47,360
.لن أكون سعيدة بالفعل على الإطلاق

323
00:21:47,750 --> 00:21:49,990
ما الّذي يفترض بي فعله؟

324
00:21:59,770 --> 00:22:02,050
.هذا مملّ للغاية

325
00:22:03,300 --> 00:22:06,010
كيف يفترض بي أن أسعد بفوزي

326
00:22:06,010 --> 00:22:08,760
إن بدوتِ هكذا وأنت تطبخين؟

327
00:22:09,230 --> 00:22:11,510
.حسنًا. أعرف ما عليّ إعداده

328
00:22:12,370 --> 00:22:14,810
!انتظري فحسب يا ناكيري إرينا

329
00:23:35,580 --> 00:23:37,890
."في الحلقة القادمة من "سوما والشّوكوغيكي

330
00:23:37,890 --> 00:23:38,960
!الحلقة الأخيرة للسّلسلة

331
00:23:38,960 --> 00:23:40,250
!مهلاً، لا تقولي ذلك قبلي