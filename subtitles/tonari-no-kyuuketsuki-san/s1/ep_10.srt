1
00:00:01,020 --> 00:00:01,930
!انظري

2
00:00:03,440 --> 00:00:07,190
!أنا مصاصة دماء أيضًا

3
00:00:07,190 --> 00:00:10,810
،عندما استيقظتُ ذلك المساء
.وجدتُ أنّ أكاري أصبحت مصّاصة دماء

4
00:00:10,810 --> 00:00:12,290
ما رأيك؟

5
00:00:13,690 --> 00:00:15,030
!ماذا تقصدين؟

6
00:00:15,030 --> 00:00:16,220
هل إيلي من فعلت هذا بك؟

7
00:00:16,220 --> 00:00:18,570
!سيُغيّر هذا كلّ شيء

8
00:00:18,910 --> 00:00:22,060
!مدرستك و... ماذا سنقول لوالديك؟

9
00:00:22,060 --> 00:00:24,380
.هذا مجرّد زيّ هالووين

10
00:00:24,380 --> 00:00:26,030
.لم أصبح مصّاصة دماء فعلًا

11
00:00:26,490 --> 00:00:28,550
المكياج والأنياب تبدو واقعية للغاية، صحيح؟

12
00:00:29,900 --> 00:00:31,200
.أفزعتني

13
00:00:31,200 --> 00:00:34,280
،بمناسبة الحديث، إن سألتُكِ أو إيلي-تشان

14
00:00:34,280 --> 00:00:37,520
هل ستجعلانني مصاصة دماء حقيقية؟

15
00:00:37,520 --> 00:00:40,580
،لن يكون ذلك ممكنًا أبدًا
!لذا انسي بشأن ذلك

16
00:02:12,060 --> 00:02:16,490
الحلقة العاشرة

17
00:02:18,470 --> 00:02:21,840
،الهالووين على الأبواب
.لذا فكّرتُ أنّ نفعل شيئًا

18
00:02:21,840 --> 00:02:24,440
ما رأيك أن نقيم حفل هالووين؟

19
00:02:24,760 --> 00:02:26,960
.أكيد، يبدو ذلك جيّدًا

20
00:02:26,960 --> 00:02:28,240
!مرحى

21
00:02:28,240 --> 00:02:30,450
.إذًا، سأُبادر وأعزم المجموعة

22
00:02:30,450 --> 00:02:34,220
...وسوف أعدّ بعض الحلوى والوجبات

23
00:02:35,320 --> 00:02:37,530
.أتساءل إن كنّ حضّرنَ زيًّا جميعًا

24
00:02:37,530 --> 00:02:39,930
.وإن كنّ لا يملكن، بوسعي أن أصنع شيئًا

25
00:02:40,580 --> 00:02:45,480
.أظنّك ستبدين في غاية الظرافة في زيّ يقطين

26
00:02:45,480 --> 00:02:49,430
.بوسعي أن أضع عليه الكثير من الزخرفة
!سيبدو منفوشًا وظريفًا جدًّا

27
00:02:53,190 --> 00:02:54,890
.لقد طلبتُ شيئًا عبر الإنترنت للتّو

28
00:02:55,360 --> 00:02:58,510
!أنت! كيف فعلتِ ذلك؟

29
00:02:59,300 --> 00:03:02,940
.لم أرد أن أُثقل كاهلك بالمزيد من العمل

30
00:03:05,770 --> 00:03:07,650
!شكرًا على دعوتنا

31
00:03:07,650 --> 00:03:09,220
!تفضّلن بالدخول

32
00:03:09,220 --> 00:03:11,350
.تملكن الكثير من الأشياء جميعًا

33
00:03:11,350 --> 00:03:12,120
.أجل

34
00:03:12,120 --> 00:03:13,790
إذًا، أين يُمكننا أن نُبدّل؟

35
00:03:14,440 --> 00:03:16,120
.استخدمن غرفتي

36
00:03:16,120 --> 00:03:17,500
!مفهوم

37
00:03:18,140 --> 00:03:19,350
...صباح الخير

38
00:03:19,350 --> 00:03:21,210
هل أتين الجميع؟

39
00:03:21,510 --> 00:03:22,700
!صباح الخير

40
00:03:22,700 --> 00:03:25,150
.هيناتا-تشان والأخريات يُبدّلن الآن

41
00:03:25,150 --> 00:03:28,460
!مذهل! أنت ساحرة

42
00:03:28,460 --> 00:03:30,220
!ظريفة جدًّا

43
00:03:31,970 --> 00:03:39,210
لكن كان ليناسبك أكثر بكثير
.إن كان الزيّ من صنعي

44
00:03:39,210 --> 00:03:40,520
أما زلتِ ملحّة على ذلك؟

45
00:03:41,910 --> 00:03:43,930
!استمعي لهذا يا صوفي-تشان

46
00:03:43,930 --> 00:03:47,370
،اتّضح أنّ الجميع اشترين زيّهنّ

47
00:03:47,370 --> 00:03:51,280
!وفقط هيناتا من دعتني أصنع لها واحدًا

48
00:03:51,280 --> 00:03:54,100
!لكن كان ليصعب عليك أن تصنعي الأزياء للجميع

49
00:03:55,510 --> 00:03:57,340
!صوفي-تشان، أنت مستيقظة

50
00:03:57,340 --> 00:03:58,670
!وأنت ساحرة صغيرة

51
00:03:58,670 --> 00:04:00,250
.صباح الخير يا صوفي-تشان

52
00:04:00,250 --> 00:04:02,580
...مهلًا، أنتما

53
00:04:02,580 --> 00:04:04,150
!مفاجأة

54
00:04:04,150 --> 00:04:06,480
!نحن زومبي قوطيّات

55
00:04:06,480 --> 00:04:08,060
!ترتديان أزياء مشابهة

56
00:04:08,060 --> 00:04:11,510
!لم أفكّر في ذلك
.سأتذكّر المرّة المقبلة

57
00:04:11,510 --> 00:04:14,020
،بعد كلّ البكاء
.يبدو أنّك تستمتعين

58
00:04:14,420 --> 00:04:16,740
ألن يكون أسهل أن تُبدّلن في بيتكن؟

59
00:04:16,740 --> 00:04:18,870
.لما كان عليكن إحضار الكثير من الأشياء

60
00:04:18,870 --> 00:04:20,760
...هذا صحيح

61
00:04:20,760 --> 00:04:23,860
لكن سيكون من المحرج نوعًا ما
.أن نسير مرتديات هكذا شيء

62
00:04:25,130 --> 00:04:28,250
.أجل، أمكنكما أن تلتقيا جيرانكما

63
00:04:28,910 --> 00:04:32,170
.لكنّه الهالووين، لذا لا يوجد داعٍ للشعور بوعي الذات

64
00:04:32,530 --> 00:04:34,930
."كما أنّه ليس كوسبلاي لـ"كون

65
00:04:34,930 --> 00:04:36,120
!معها حق

66
00:04:36,410 --> 00:04:37,570
...مع ذلك

67
00:04:37,570 --> 00:04:38,700
.صحيح

68
00:04:44,840 --> 00:04:46,770
هل أتيتِ إلى هنا مرتديةً ذلك؟

69
00:04:47,250 --> 00:04:47,970
!فعلًا

70
00:04:48,290 --> 00:04:50,660
.أنت من عليها أن تكون واعيةً لذاتها أكثر

71
00:04:50,660 --> 00:04:51,420
بشأن ماذا؟

72
00:04:51,420 --> 00:04:53,130
!انتهيت

73
00:04:54,260 --> 00:04:56,570
!ها قد أتى رجل الذئب

74
00:04:56,570 --> 00:04:58,360
أم يجب أن أقول امرأة الذئب؟

75
00:04:58,360 --> 00:05:00,090
!تبدين رائعة

76
00:05:00,090 --> 00:05:02,370
!إنه منفوش وظريف

77
00:05:02,370 --> 00:05:05,080
.لكن رجل الذئب يوحي أنّه نتن

78
00:05:05,080 --> 00:05:07,070
!لا تقولي ذلك

79
00:05:07,070 --> 00:05:09,280
.لكنّه حيوان مغطّى بالشعر بالكامل

80
00:05:09,280 --> 00:05:12,240
،كلبتي ميكان حيوان أيضًا
!لكن تفوح منها رائحة طيّبة

81
00:05:12,240 --> 00:05:14,110
.كما أنّه يبدو غير صحيّ

82
00:05:14,110 --> 00:05:15,490
!كيف تجرؤين؟

83
00:05:16,600 --> 00:05:20,590
!إذًا، صحيحٌ أنّ مصّاصي الدّماء والمستذئبين أعداء

84
00:05:20,590 --> 00:05:22,170
!تمامًا كما في الأفلام

85
00:05:22,940 --> 00:05:24,510
!يجب أن نوقفهما

86
00:05:25,390 --> 00:05:28,110
.إيلي-سان، اسمي يو

87
00:05:28,110 --> 00:05:31,630
،التقينا لبرهةٍ في المهرجان الثقافي
.لكن أشكّ أنّك تذكُرينني

88
00:05:31,630 --> 00:05:34,940
.أذكرك

89
00:05:34,940 --> 00:05:37,900
.لا أنسى فتاةً ظريفةً أبدًا

90
00:05:37,900 --> 00:05:40,690
أنا، فتاة ظـ-ظريفة؟

91
00:05:40,690 --> 00:05:42,680
...لكنّي لستُ

92
00:05:42,680 --> 00:05:44,490
.أنت تخجلين

93
00:05:44,490 --> 00:05:45,930
.أترين؟ أنت ظريفة

94
00:05:47,140 --> 00:05:50,420
!أنتِ لي! ممنوع إغواءها

95
00:05:50,420 --> 00:05:52,030
!عجبًا

96
00:05:53,740 --> 00:05:55,660
!صنعتُ بعض الحلويات

97
00:05:55,660 --> 00:05:58,050
!إنها رائعة يا أكاري-سان

98
00:05:58,050 --> 00:06:00,190
.أحضرتُ بعض الحلوى والشوكولاتة

99
00:06:00,190 --> 00:06:02,860
!حلوى أم خدعة

100
00:06:02,860 --> 00:06:04,140
.تفضلن

101
00:06:04,140 --> 00:06:07,680
،لا أريد أيّ حلوى
لذا يمكنني أن أقوم بخدعة، صحيح؟

102
00:06:11,310 --> 00:06:15,630
،إلّم تعطينني حلوى
!سأقوم بخدعة عليك

103
00:06:16,300 --> 00:06:17,540
.سأذهب لشراء بعض الحلوى

104
00:06:18,270 --> 00:06:21,620
لكن لستِ بحاجةٍ لتكليف نفسك
!وشراء الحلوى! انتظري

105
00:06:21,620 --> 00:06:26,570
.بئسًا! لا أملك حلوى، لذا ستقوم بخدعةٍ عليّ الآن

106
00:06:27,110 --> 00:06:29,070
.هذا يدغدغ نوعًا ما

107
00:06:29,760 --> 00:06:31,310
!انتهيت

108
00:06:31,310 --> 00:06:34,400
!لا، لقد وقعتُ في مقلب

109
00:06:34,400 --> 00:06:35,670
.عُدت

110
00:06:35,670 --> 00:06:37,160
.أحضرتُ بعض الحلوى

111
00:06:37,160 --> 00:06:38,480
!رائع

112
00:06:38,480 --> 00:06:40,630
!حلوى أو خدعة

113
00:06:42,080 --> 00:06:45,130
!مرحى! حلوى من صوفي-تشان

114
00:06:45,130 --> 00:06:48,170
!لكن ما زلتُ سأقوم بخدعة

115
00:06:48,170 --> 00:06:50,630
!مهلًا، ليس هكذا يسري الأمر

116
00:07:13,010 --> 00:07:15,250
.كلّ ذلك التسكّع أشعرني بالجوع

117
00:07:15,250 --> 00:07:18,120
.الحلوى لا تُشبع وحدها

118
00:07:18,120 --> 00:07:19,970
.أجل، هذا صحيح

119
00:07:19,970 --> 00:07:22,330
.أظنّه وقت العشاء إذًا

120
00:07:22,330 --> 00:07:24,620
.أعددتُ طعامًا على أسلوب الهالووين

121
00:07:24,620 --> 00:07:27,930
.انظرن، أعددتُ أصابعًا من النقانق

122
00:07:27,930 --> 00:07:29,490
تبدو واقعية للغاية، صحيح؟

123
00:07:29,490 --> 00:07:31,130
.يمكنكنّ أن تأكلنها بالكاتشب

124
00:07:31,130 --> 00:07:33,360
،كما أعددتُ بعض الخبز على شكل رجال

125
00:07:33,360 --> 00:07:37,390
ولأجل التحلية، أعددتُ زلابيات مقلات
.العين من طحين الأرزّ بصلصة الفراولة

126
00:07:37,390 --> 00:07:40,720
!مذهل! كلّ هذا مثاليّ للزومبي

127
00:07:40,720 --> 00:07:42,020
!كلن جميعًا

128
00:07:42,020 --> 00:07:43,740
!فلنأكل

129
00:07:43,740 --> 00:07:45,280
...فلنأكل

130
00:07:47,960 --> 00:07:49,590
!هذه الذراع لذيذة حقًّا

131
00:07:49,590 --> 00:07:50,940
.والرأس أيضًا

132
00:07:51,750 --> 00:07:53,090
...يا إلهي

133
00:07:53,090 --> 00:07:55,200
.وكأنّنا صديقات وحوش جميعًا

134
00:07:55,200 --> 00:07:56,650
!هذا ممتع

135
00:07:57,370 --> 00:07:58,710
...مخيف

136
00:08:00,410 --> 00:08:02,180
.تسلّينا كثيرًا اليوم

137
00:08:02,180 --> 00:08:03,660
.شكرًا على استضافتنا

138
00:08:03,660 --> 00:08:07,030
من المؤسف حقًّا أنّ على طالبات
.الثانوية أن يعدن إلى البيت باكرًا جدًّا

139
00:08:07,030 --> 00:08:08,620
.أردتُ أن أتسكّع معكنّ أكثر

140
00:08:08,620 --> 00:08:11,250
.إذًا، فلنتسكّع جميعًا قريبًا مجدّدًا

141
00:08:11,250 --> 00:08:12,590
.موافقة

142
00:08:12,590 --> 00:08:14,420
!شكرًا على استضافتنا

143
00:08:14,420 --> 00:08:15,630
!إلى اللقاء

144
00:08:15,630 --> 00:08:16,550
!أجل

145
00:08:19,230 --> 00:08:21,330
.صوفي-تشان، فلندخل

146
00:08:21,800 --> 00:08:23,250
!أنت باردة جدًّا

147
00:08:23,250 --> 00:08:24,440
حقًّا؟

148
00:08:24,440 --> 00:08:27,680
.يداك حقًّا— دافئة

149
00:08:29,340 --> 00:08:30,490
ما الخطب؟

150
00:08:30,490 --> 00:08:32,250
!لا شيء

151
00:08:32,250 --> 00:08:34,200
إلى أين ذهبت إيلي-تشان؟

152
00:08:34,940 --> 00:08:36,800
!اعتني بنفسك

153
00:08:36,800 --> 00:08:37,830
!أنتما أيضًا

154
00:08:41,360 --> 00:08:43,270
.قلقتُ من كونك لوحدك

155
00:08:43,270 --> 00:08:45,510
.سأصطحبك إلى البيت

156
00:08:45,510 --> 00:08:47,340
!ماذا؟ بهذا الزيّ؟

157
00:08:47,340 --> 00:08:50,110
ماذا ستفعلين لو اصطدمتِ بشخصٍ غريب الأطوار؟

158
00:08:50,110 --> 00:08:52,810
أليس ذلك الشخص أنت؟

159
00:08:53,250 --> 00:08:54,550
.شكرًا مع ذلك

160
00:08:55,750 --> 00:08:59,020
.أسرعي وإلّا تركتكِ هنا

161
00:08:59,020 --> 00:09:02,020
.فكّرتُ أنّك ستصطحبينني إلى البيت

162
00:09:02,020 --> 00:09:04,540
.مصّاصو الدّماء غريبو الأطوار

163
00:09:06,450 --> 00:09:07,770
.راقبوا الآن

164
00:09:14,250 --> 00:09:16,670
!يا لجمالها

165
00:09:14,830 --> 00:09:18,440
،كما تسمعون
!الجميع هنا متحمّسون

166
00:09:18,790 --> 00:09:21,530
.كما يسرّنا أن ندعو كلّ متابعينا للحضور أيضًا

167
00:09:22,370 --> 00:09:24,160
حان ذلك الوقت من العام إذًا؟

168
00:09:24,490 --> 00:09:27,390
!علينا أن نحتفل بعيد الميلاد المجيد سويًّا أيضًا

169
00:09:27,390 --> 00:09:29,170
!سأدعو هيناتا-تشان

170
00:09:29,170 --> 00:09:31,860
هل سنقيم حفلًا آخر؟

171
00:09:31,860 --> 00:09:33,410
!هذا رائع. فلنفعل ذلك

172
00:09:33,710 --> 00:09:37,030
هنالك الكثير من الأشياء المسلّية
.نتطلّع إليها في نهاية السنة

173
00:09:37,030 --> 00:09:38,510
ما رأيك يا صوفي-تشان؟

174
00:09:38,510 --> 00:09:40,260
.يبدو الأمر جيدًا

175
00:09:40,260 --> 00:09:43,070
إذًا، ماذا يفعل المرء في عيد الميلاد المجيد؟

176
00:09:43,880 --> 00:09:46,440
،أقصد، كنتُ نائمةً لوقتٍ طويل

177
00:09:46,440 --> 00:09:50,820
لذا لا أعلم ما يفعله النّاس في
.عيد الميلاد المجيد هذه الأيّام

178
00:09:50,820 --> 00:09:54,380
،أجتمع مع عائلتي وأصدقائي

179
00:09:54,380 --> 00:09:56,870
.ونأكل الكعك وشتّى الأشياء اللّذيذة

180
00:09:56,870 --> 00:09:59,720
.يحتفل به الجميع بشكلٍ مختلف قليلًا

181
00:09:59,720 --> 00:10:01,850
.بعض النّاس يخرجون إلى المطاعم

182
00:10:01,850 --> 00:10:03,640
.وبعض النّاس يذهبون في رحلة

183
00:10:03,640 --> 00:10:04,830
ماذا تفعلين يا صوفي-تشان؟

184
00:10:05,220 --> 00:10:07,820
أذكرُ قضائي لعيد الميلاد المجيد العام الماضي

185
00:10:08,490 --> 00:10:12,980
.أتصفّح الرسومات التوضيحية لعيد الميلاد المجيد في بيكسيف

186
00:10:12,980 --> 00:10:16,040
.هذه طريقة... متواضعة جدًّا لقضائه

187
00:10:16,040 --> 00:10:17,080
!أملك فكرة

188
00:10:17,490 --> 00:10:20,690
!يجب أن نتبادل الهدايا جميعًا ذلك اليوم

189
00:10:20,690 --> 00:10:23,810
،سيكون المحتوى سرًّا
!وسنضع قرعةً لنرى من تأخذ ماذا

190
00:10:23,810 --> 00:10:26,420
هدايا؟

191
00:10:26,420 --> 00:10:28,390
.يبدو أنّه سيكون من الصّعب اختيار الهدايا

192
00:10:28,390 --> 00:10:29,820
!هذا غير صحيح

193
00:10:30,450 --> 00:10:33,900
.بالنّسبة لي، أريد أن أحظى بك كهديّتي

194
00:10:34,370 --> 00:10:35,810
.أمزح فحسب

195
00:10:36,210 --> 00:10:40,200
إذًا، هذا يعني أنّي أملك
.فرصةَ 1/3 للحصول عليها لنفسي

196
00:10:40,200 --> 00:10:42,530
!لا تشغلي بالك، لن نفعل ذلك

197
00:10:46,700 --> 00:10:48,780
هدايا عيد الميلاد المجيد؟

198
00:10:48,780 --> 00:10:53,540
أجل. كنتُ أتساءل إن كنت تستطيعين
.أن تُلمّحي لي ماذا أستطيع أن أشتري

199
00:10:54,670 --> 00:10:57,670
.الفكرة هي أن تشتري شيئًا يُسعِد المُتلقّي

200
00:10:57,670 --> 00:11:00,330
...شيء يجعل البشر سعداء

201
00:11:00,330 --> 00:11:02,320
المال؟ أم الأرز؟

202
00:11:02,320 --> 00:11:03,900
أو ربما الملح؟

203
00:11:04,220 --> 00:11:07,360
.لا شيء من ذلك يصلح ليكون هدايا عيد الميلاد

204
00:11:07,360 --> 00:11:09,670
،ناهيك إن انتهى بي المطاف بهديتك

205
00:11:09,670 --> 00:11:11,620
.فطعام البشر آخر ما أحتاج

206
00:11:11,620 --> 00:11:13,560
.حتّى أنّ الملح سامّ لنا

207
00:11:14,700 --> 00:11:16,480
...على ذكر ذلك

208
00:11:16,480 --> 00:11:17,790
...شخصيًّا

209
00:11:18,100 --> 00:11:21,530
.أحبّ الهدايا المصنوعة يدويًّا
.لأنها تملك دفئًا خاصًّا بها

210
00:11:21,530 --> 00:11:24,570
...كوشاح معدّ من قِبل أكاري

211
00:11:24,570 --> 00:11:25,910
!تفضّلي يا هيناتا-تشان

212
00:11:27,800 --> 00:11:29,500
هدايا مصنوعة يدويًا؟

213
00:11:29,500 --> 00:11:32,100
إذًا، لمَ لا نصنع بعض المال؟

214
00:11:32,100 --> 00:11:33,710
!هذه جناية

215
00:11:34,710 --> 00:11:36,930
.هذا صعب حقًّا

216
00:11:37,320 --> 00:11:39,870
أتريدين تصفّح بعض القوائم معي؟

217
00:11:40,230 --> 00:11:42,840
.قد نجد الشيء الأنسب

218
00:11:42,840 --> 00:11:45,370
.يملكون كلّ شيء حقًّا

219
00:11:45,930 --> 00:11:47,060
.يبدو هذا جيّدًا

220
00:11:48,520 --> 00:11:51,040
!لا تزال أكاري صغيرة جدًّا على ارتداء شيء كهذا

221
00:11:51,040 --> 00:11:51,900
!أعترض

222
00:11:51,900 --> 00:11:55,220
لكنّها بلغت ذلك السن حيث
.تريد أن تبدو في مظهرٍ أكبر

223
00:11:55,220 --> 00:11:57,690
.صباح الخير

224
00:11:57,960 --> 00:12:00,160
.أتطلّع لعيد الميلاد المجيد

225
00:12:00,160 --> 00:12:03,110
.فلندعُ ساكويا-تشان ويو-تشان أيضًا

226
00:12:05,170 --> 00:12:06,580
خططي لعيد الميلاد المجيد؟

227
00:12:06,580 --> 00:12:08,920
.لم أخطّط لأيّ شيء بعد

228
00:12:08,920 --> 00:12:11,330
ما رأيك بالاحتفال في بيتي مجدّدًا؟

229
00:12:11,330 --> 00:12:12,540
!يبدو هذا رائعًا

230
00:12:12,540 --> 00:12:14,050
!مع أساهي-تشان أيضًا؟

231
00:12:15,270 --> 00:12:19,280
أظنّها ستقيم حفلًا مع صديقاتها
.من المدرسة هذا العام

232
00:12:19,280 --> 00:12:23,420
،كما أنّ والدَي سيخرجان أيضًا
.لذا سأكون وحيدة نوعًا ما

233
00:12:24,710 --> 00:12:26,830
حقًّا؟

234
00:12:26,830 --> 00:12:30,880
أتقصدين أنّنا سنكون وحيدتين في عيد الميلاد المجيد هذا؟

235
00:12:31,240 --> 00:12:32,760
—هلّا

236
00:12:32,760 --> 00:12:34,350
.لا، فلندعهما لوحدهما

237
00:12:34,350 --> 00:12:37,970
،صباح الخير أنتما
هل كنت على وشك قول شيء؟

238
00:12:37,970 --> 00:12:40,270
.لا شيء! لا شيء إطلاقًا

239
00:12:48,540 --> 00:12:52,030
...هديّة تُسعد أكاري

240
00:12:52,030 --> 00:12:55,870
مهلًا، هل مسموحٌ لمصّاصي الدّماء
بالاحتفال بعيد الميلاد المجيد أساسًا؟

241
00:12:57,000 --> 00:12:58,570
.أظنّ أنّه لا بأس

242
00:13:00,830 --> 00:13:03,910
لمَ لا أختار شيئًا يُعجبني فحسب؟

243
00:13:05,920 --> 00:13:08,340
أيّ كعك ستخبزين؟

244
00:13:08,740 --> 00:13:11,700
.أظنّني أريد أن أضع عليه بعض الفراولة

245
00:13:11,700 --> 00:13:13,930
!انظري، لديهم بابا نويل الشوكولاتة

246
00:13:13,930 --> 00:13:15,400
!فلنشترِ بعضها أيضًا

247
00:13:15,400 --> 00:13:16,820
.سيكون هذا مسليًا كثيرًا

248
00:13:16,820 --> 00:13:19,520
.الكعك هو الأهم في عيد الميلاد المجيد

249
00:13:20,190 --> 00:13:21,880
...أجل

250
00:13:22,620 --> 00:13:26,240
.يا ليت صوفي-تشان وإيلي-تشان تستطيعان أكله أيضًا

251
00:13:26,240 --> 00:13:30,690
.لا يمكننا أن نفعل أيّ شيء بشأن ذلك
.مصّاصو الدماء يتناولون الدم فقط

252
00:13:30,690 --> 00:13:35,170
!وجدتها! ماذا إن صنعت كعكة إسفنجية مغمورة بالدم؟

253
00:13:35,170 --> 00:13:37,550
.أكاري، لا تفعلي رجاءً

254
00:13:38,000 --> 00:13:39,080
كيف الوضع هناك؟

255
00:13:39,080 --> 00:13:40,490
.أكاد أنتهي

256
00:13:41,660 --> 00:13:44,960
.آمل أن تُعجب صوفي-تشان وإيلي-تشان

257
00:13:46,340 --> 00:13:47,430
!انتهت

258
00:13:50,070 --> 00:13:53,000
ربما يجب أن نطفئ الحرارة على الوعاء؟

259
00:13:54,110 --> 00:13:55,550
.تبديان مشغولتين

260
00:13:55,550 --> 00:13:56,820
.دعاني أساعدكما

261
00:13:57,690 --> 00:13:59,250
!صباح الخير يا صوفي-تشان

262
00:13:59,250 --> 00:14:01,270
.حسنًا، سأُكلّفك بالوعاء

263
00:14:03,230 --> 00:14:05,690
.يبدو الحساء ساخنًا جدًّا

264
00:14:06,130 --> 00:14:09,810
،فوق 44 درجة مئوية
.البشر يخاطرون بأن يحترقوا

265
00:14:10,280 --> 00:14:11,660
.فلنضف بعض الجليد

266
00:14:11,660 --> 00:14:15,260
صـ-صوفي-تشان، ما رأيك أن تجلسي وتستريحي؟

267
00:14:15,260 --> 00:14:17,290
أجل، وربّما تشاهدي بعض الأنمي؟

268
00:14:17,290 --> 00:14:19,290
.لقد طردتُماني بلُطف

269
00:14:19,290 --> 00:14:21,510
!عيد ميلادٍ مجيد

270
00:14:21,510 --> 00:14:24,940
!هذا الكعك ظريف جدًّا

271
00:14:24,940 --> 00:14:26,700
.كما أنّ الطعام الآخر يبدو فاخرًا

272
00:14:27,050 --> 00:14:29,000
.حتّى إن كنّا لا نستطيع أكله

273
00:14:29,440 --> 00:14:31,680
.انتظرا دقيقة

274
00:14:31,680 --> 00:14:32,940
!مفاجأة

275
00:14:33,300 --> 00:14:36,250
!حاولتُ أن أصنع كعكًا لكما أيضًا

276
00:14:36,250 --> 00:14:38,770
في الواقع، شكّلتُ بعض الدم من الثلاجة

277
00:14:38,770 --> 00:14:41,280
.وقمتُ بتجميده

278
00:14:41,280 --> 00:14:43,230
!يبدو هذا رائعًا

279
00:14:43,230 --> 00:14:45,930
.يبدو كالكعك حقًّا

280
00:14:46,700 --> 00:14:48,260
!أنت حاذقة حقًّا يا أكاري

281
00:14:48,260 --> 00:14:51,330
!أنا مسرورة لأنّه أعجبكما

282
00:14:52,400 --> 00:14:55,360
لكن كيف يُفترض بنا أكل هذا؟

283
00:14:55,360 --> 00:14:57,820
.أظنّنا يجب أن ننتظر حتّى يذوب فحسب

284
00:14:58,520 --> 00:15:02,120
.آسفة. لم أفكّر بذلك القدر

285
00:15:03,170 --> 00:15:06,310
.حسنًا جميعًا، اسحبن تذكرة واحدة

286
00:15:07,890 --> 00:15:10,460
.آمل أن أحصل على هديّة أكاري حقًّا

287
00:15:10,760 --> 00:15:12,790
!حصلتُ على هديّة صوفي-تشان

288
00:15:12,790 --> 00:15:14,270
.وحصلتُ على خاصتك

289
00:15:15,530 --> 00:15:17,710
.حصلت على هدية إيلي

290
00:15:18,080 --> 00:15:19,950
.آمل أنّه ليس شيئًا غريبًا

291
00:15:19,950 --> 00:15:22,190
!هذا فظ حقًّا

292
00:15:24,150 --> 00:15:27,600
،أحمر الشفاه! هذا لطيف حقًّا

293
00:15:27,600 --> 00:15:30,150
.لكن لا أظنّه سيُناسبني

294
00:15:30,150 --> 00:15:32,080
ألا بأس أن أحتفظ به حقًّا؟

295
00:15:32,080 --> 00:15:34,260
.لا داعي للتصرّف هكذا

296
00:15:34,260 --> 00:15:35,900
.ناوليني إيّاه، سأضعه عليك

297
00:15:38,240 --> 00:15:40,810
.يبدو رائعًا. يجعلني أريد أن ألتهمك

298
00:15:42,240 --> 00:15:44,030
ألا يبدو غريبًا؟

299
00:15:44,030 --> 00:15:46,350
!تبدين كبيرة ناضجة

300
00:15:46,350 --> 00:15:47,260
!جميلة للغاية

301
00:15:47,740 --> 00:15:51,450
.هذه أوّل مرّة تدعوني أكاري بجميلة

302
00:15:52,160 --> 00:15:54,520
!شكرًا لك! سوف أُثمّنه

303
00:15:54,520 --> 00:15:56,050
هل تبكين حقًّا؟

304
00:15:56,050 --> 00:15:59,530
.هدية صوفي-تشان عبارة عن مانغا

305
00:15:59,530 --> 00:16:02,400
.إنّه منصوح بها لكلّ الفئات

306
00:16:02,400 --> 00:16:03,890
.آمل أن تحبيها

307
00:16:03,890 --> 00:16:08,100
.واثق أنّها ستكون رائعة إن كانت من ترشيحك

308
00:16:08,100 --> 00:16:08,970
.فهمت

309
00:16:09,840 --> 00:16:11,430
...وهديتك

310
00:16:11,970 --> 00:16:13,390
قفاز؟

311
00:16:13,390 --> 00:16:14,100
.أجل

312
00:16:14,100 --> 00:16:17,450
.بدت يداك باردتين جدًّا في ذلك اليوم

313
00:16:18,870 --> 00:16:20,960
!تبدو دافئة جدًّا

314
00:16:20,960 --> 00:16:23,540
!وجدتها! سأشتري هذه

315
00:16:23,540 --> 00:16:26,700
.أنا مسرورة حقًّا لأنّك من حصل عليها

316
00:16:28,720 --> 00:16:30,760
.أنا ممتنّة لأجل هذه الهدية

317
00:16:31,120 --> 00:16:33,710
.كما حصلتُ على هذه الدمية المحشوة من هيناتا

318
00:16:33,710 --> 00:16:34,720
.إنها ظريفة جدًّا

319
00:16:35,210 --> 00:16:36,280
هل أحببتها؟

320
00:16:36,280 --> 00:16:38,320
.هذا يُسعدني حقًّا

321
00:16:38,320 --> 00:16:40,990
.لا عجب أن تختاري شيئًا لأجل طفل

322
00:16:40,990 --> 00:16:42,180
...لكن

323
00:16:42,920 --> 00:16:45,650
.يبدو مناسبًا لأجلها بكلّ تأكيد

324
00:16:45,650 --> 00:16:48,630
إذًا، حصل الجميع على هدية؟

325
00:16:48,630 --> 00:16:50,330
.أجل

326
00:16:50,330 --> 00:16:52,770
!انظرن، بدأت تُثلج

327
00:16:52,770 --> 00:16:55,580
!مذهل، إنه عيد ميلاد مجيد أبيض

328
00:16:58,530 --> 00:17:03,250
،عيد الميلاد المجيد المثلج رومانسي
.لكنه بارد أيضًا

329
00:17:03,250 --> 00:17:05,060
.أجل، إنه بارد

330
00:17:05,060 --> 00:17:06,350
.فعلًا

331
00:17:06,350 --> 00:17:07,500
.التقطتُ بعضه

332
00:17:07,500 --> 00:17:09,420
.أصبتِ، إنه بارد

333
00:17:09,420 --> 00:17:11,960
هل تشعران به حقًّا؟
!بالكاد ترتديان أيّ شيء

334
00:17:12,440 --> 00:17:16,940
.لا نتأثر نحن مصاصو الدماء سلبًا من البرد

335
00:17:16,940 --> 00:17:19,220
.لا نملك أيّ حرارة جسدية من الأساس

336
00:17:19,220 --> 00:17:21,680
.كما لا يمكننا أن نموت من العوامل الجوية

337
00:17:22,720 --> 00:17:24,110
حقًّا؟

338
00:17:24,940 --> 00:17:26,090
.فهمت

339
00:17:26,090 --> 00:17:29,720
،إن كانت لا تواجه مشكلة مع البرد
.لم تكن بحاجة إلى هذا القفاز أساسًا

340
00:17:29,720 --> 00:17:32,910
.قد لا تكون الهدية الأفضل

341
00:17:38,070 --> 00:17:41,780
صوفي-تشان ترتدي قفازات داخل البيت؟

342
00:17:43,230 --> 00:17:45,880
.اختيرت هذه القفازات من قبل طالبة ثانوية

343
00:17:45,880 --> 00:17:49,030
.إنها أنيقة جدًّا! لدى المراهقين حسّ بالموضة حقًّا

344
00:17:49,030 --> 00:17:50,620
!أنا مسرورة جدًّا

345
00:17:50,620 --> 00:17:53,130
.يبدو أنّها أحبّتها في النهاية

346
00:17:55,220 --> 00:17:57,050
...ها نحن

347
00:18:01,850 --> 00:18:02,970
!وصلت

348
00:18:04,320 --> 00:18:07,600
.سنرنّ أجراس العام الجديد اليوم مع أكاري والمجموعة

349
00:18:07,990 --> 00:18:10,350
.يمكننا أن نتكاسل سويًّا

350
00:18:11,480 --> 00:18:13,180
!ادخلي يا هيناتا-تشان

351
00:18:13,180 --> 00:18:14,570
.آسفة على تأخرنا

352
00:18:14,570 --> 00:18:17,850
.استغرق التنظيف الكبير في بيتي الكثير من الوقت

353
00:18:17,850 --> 00:18:19,230
.لا بأس

354
00:18:19,230 --> 00:18:21,190
.أتت إيلي-تشان أيضًا

355
00:18:21,190 --> 00:18:22,270
حقًّا؟

356
00:18:22,270 --> 00:18:27,350
.أجل، لكنّنا لم ننتهِ حقًّا بعد

357
00:18:28,300 --> 00:18:30,010
كيف الحال؟

358
00:18:30,010 --> 00:18:32,970
...ربّما لا يجوز أن نتكاسل في النهاية

359
00:18:35,400 --> 00:18:37,240
.هذا الأخير

360
00:18:37,240 --> 00:18:38,110
.حسنًا

361
00:18:39,750 --> 00:18:42,220
.يُفترض أن يكون الجوّ باردًا اللّيلة، لذا استخدما هذا

362
00:18:42,220 --> 00:18:44,020
!أجل! كوتاتسو

363
00:18:44,020 --> 00:18:45,410
!عجبًا

364
00:18:45,410 --> 00:18:47,110
مـ-ما هذا؟

365
00:18:47,690 --> 00:18:50,310
—حسنًا، دعونا ندخل

366
00:18:50,310 --> 00:18:51,020
!مهلًا

367
00:18:51,020 --> 00:18:53,190
،إن دخلته الآن
.لن تخرجي مجدّدًا

368
00:18:53,190 --> 00:18:54,410
!ما زال علينا أن نخرج للتسوق

369
00:18:54,850 --> 00:18:57,800
سأمضي عشية رأس السنة هذه
.مع صوفي-تشان وإيلي-تشان

370
00:18:57,800 --> 00:18:59,060
!أنا متحمّسة جدًّا

371
00:18:59,060 --> 00:19:00,650
ماذا عنّي؟

372
00:19:00,650 --> 00:19:03,280
!انظرن إلى كلّ تلك القطط

373
00:19:06,260 --> 00:19:08,700
!إنها ودودة حقًّا

374
00:19:08,700 --> 00:19:11,010
.نملك حضنًا دافئًا على ما أظن

375
00:19:14,120 --> 00:19:16,930
.أملك حضنًا شاغرًا أيضًا. تعالي

376
00:19:18,090 --> 00:19:19,320
!لماذا؟

377
00:19:19,320 --> 00:19:22,920
.ربّما لأنّ دراجة حرارة جسمك منخفضة

378
00:19:22,920 --> 00:19:25,930
!تملك هذه القطط فراءً جميلًا

379
00:19:25,930 --> 00:19:28,170
.سيصنع عباءة جميلة من فرو القطط

380
00:19:29,010 --> 00:19:30,800
!كانت مزحة

381
00:19:30,800 --> 00:19:33,790
.شاهدتُ فيلمًا كهذا قبل مدّة، عدا أنّه للكلاب

382
00:19:36,360 --> 00:19:37,710
!شكرًا على الانتظار

383
00:19:37,710 --> 00:19:41,370
لدينا البطاطا المقلية لرأس السنة
.وبوتشي الشوكولاتة والفراولة والدجاج

384
00:19:41,650 --> 00:19:43,040
!مرحى

385
00:19:43,040 --> 00:19:44,690
.هذا عشوائي جدًّا

386
00:19:44,690 --> 00:19:48,120
ألا يأكل الناس السوبا عادةً في رأس السنة؟

387
00:19:48,480 --> 00:19:50,000
.شاهدتُ ذلك في أنمي

388
00:19:50,000 --> 00:19:52,990
فلنتناول سوبا رأس السنة ونبذل
!قصارى جهدنا العام القادم أيضًا

389
00:19:52,990 --> 00:19:54,120
!أجل

390
00:19:54,120 --> 00:19:57,080
.أكاري حسّاسة تجاه السوبا

391
00:19:57,080 --> 00:20:00,100
إذًا، أيّ شيء طويل ونحيف يُفلح؟

392
00:20:00,710 --> 00:20:03,670
.أعددتُ "أسلوب الساكي السّاخن" لأجلكما

393
00:20:04,030 --> 00:20:07,170
والآن، كلّ ما بقي لنا هو أن ننتظر
.حلول السنة الجديدة بكسل

394
00:20:07,170 --> 00:20:08,940
.أتطلّع لعيد رأس السنة

395
00:20:08,940 --> 00:20:10,940
ماذا تفعلين في عيد رأس السنة؟

396
00:20:11,260 --> 00:20:14,390
.أحبّ أن أتكاسل في البيت فحسب

397
00:20:14,390 --> 00:20:18,620
.أحتفل به عبر مشاهدة الأنمي أو اللحاق بقراءتي

398
00:20:18,620 --> 00:20:22,080
،أقوم بأوّل زيارة للضّريح مع أسرتي

399
00:20:22,080 --> 00:20:24,960
وأزور بيت جدّتي وأزور عمّي

400
00:20:24,960 --> 00:20:26,750
ثمّ نفتح أكياس الحظ

401
00:20:26,750 --> 00:20:29,070
...ثمّ نحضر مهرجان موتي لجمعية الحيّ و

402
00:20:30,060 --> 00:20:32,220
.يملك الأشخاص اليافعون الكثير من الطاقة

403
00:20:32,220 --> 00:20:33,630
.فعلًا

404
00:20:33,630 --> 00:20:35,080
!أكاري، أنت شخص يافع أيضًا

405
00:20:37,800 --> 00:20:39,990
!يكاد العام الجديد يحلّ

406
00:20:39,990 --> 00:20:41,470
!معك حق

407
00:20:42,870 --> 00:20:44,980
!عام جديد سعيد

408
00:20:44,980 --> 00:20:46,890
!عام جديد سعيد جميعًا

409
00:20:48,170 --> 00:20:50,760
.إنها مجرد سنة تقويمية جديدة

410
00:20:50,760 --> 00:20:52,390
.إنهما متحمستان فعلًا

411
00:20:53,830 --> 00:20:57,430
.أظنّ أنّ هذا حدث معهما فقط بضع مرّات

412
00:21:00,890 --> 00:21:05,160
.هذا الكوتاتسو يشعرني بالنّعاس حقًّا

413
00:21:05,160 --> 00:21:08,060
.لم نحظ بالكثير من النوم سابقًا بما أنّنا كنّا ننظّف

414
00:21:08,060 --> 00:21:09,150
...أشعر بالنعاس حقًّا

415
00:21:09,150 --> 00:21:12,280
!لن أنام حتّى أحضر أوّل شروقٍ من العام

416
00:21:12,280 --> 00:21:15,370
.لقد تبادل البشر ومصّاصو الدماء البرامج

417
00:21:21,080 --> 00:21:22,970
!بئسًا! لقد غفوت

418
00:21:22,970 --> 00:21:24,800
!لقد تأخر الوقت فعلًا

419
00:21:24,800 --> 00:21:27,920
!هيناتا-تشان، سوف تُشرق الشمس قريبًا

420
00:21:28,660 --> 00:21:29,760
حقًّا؟

421
00:21:32,790 --> 00:21:33,910
!البرد قارس

422
00:21:41,870 --> 00:21:43,930
!هذا منعش حقًّا

423
00:21:43,930 --> 00:21:45,810
!سيكون هذا عامًا جيّدًا آخر

424
00:21:46,180 --> 00:21:47,660
.يا لجماله

425
00:21:47,660 --> 00:21:49,520
.معك حق

426
00:21:51,360 --> 00:21:54,110
.أنا مسرورة لأنّنا حضرناه في الأخير

427
00:21:54,110 --> 00:21:56,240
.أشعر كما لو أنّه يُطهرني

428
00:21:57,660 --> 00:22:00,300
!لا يمكنكما أن تنظرا إليه
!متى خرجتما أساسًا؟

429
00:22:02,540 --> 00:22:05,080
.لاحقًا، شاهدنا فيديو له

430
00:22:05,080 --> 00:22:06,480
!عجبًا