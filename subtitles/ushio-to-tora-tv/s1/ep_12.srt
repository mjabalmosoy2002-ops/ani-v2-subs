1
00:00:03,750 --> 00:00:06,730
أتى ابن تلك المرأة

2
00:00:08,370 --> 00:00:12,360
ابن تلك المرأة البغيضة التي تقوم بحمايته

3
00:00:13,590 --> 00:00:19,870
كما أنّه يحمل رمح الحيوان البري الذي صُنع لقتلنا وحسب

4
00:00:19,870 --> 00:00:23,520
قتل أعداداً لا تُحصى من الوحوش بالفعل

5
00:00:23,520 --> 00:00:25,050
من يظنّ نفسه؟

6
00:00:25,050 --> 00:00:27,390
إنّه ابن المرأة التي برفقته فحسب

7
00:00:27,390 --> 00:00:30,250
لن يخرج من تونو حيّاً

8
00:00:30,250 --> 00:00:34,170
لن ندع بشرياً يحمل ذاك الرمح يرحل سليماً

9
00:00:34,170 --> 00:00:40,720
اللعنة على ذلك الرمح... البغض لتلك المرأة وابنها

10
00:00:40,720 --> 00:00:42,220
اقتلاهما

11
00:00:42,220 --> 00:00:47,860
اقتلاهما، اقتلاهما، اقتلاهما

12
00:00:48,790 --> 00:00:52,030
!قوموا بقتلهما

13
00:02:25,140 --> 00:02:27,930
أشعر كما لو أنّ جسدي يتمزّق

14
00:02:27,930 --> 00:02:30,460
!أوشيو، أسرع

15
00:02:30,460 --> 00:02:31,920
...ظننتُكَ

16
00:02:31,920 --> 00:02:32,590
ماذا؟

17
00:02:32,970 --> 00:02:35,840
ستكون أكثر وحشية

18
00:02:37,440 --> 00:02:38,720
أوشيو-ساما

19
00:02:39,970 --> 00:02:41,470
أذاك مشط؟

20
00:02:42,580 --> 00:02:44,910
أله قيمةٌ ما؟

21
00:02:44,910 --> 00:02:47,780
أجل، يبدو أنّه يخصّ أمي

22
00:02:47,780 --> 00:02:49,850
أعطاني إيّاه والدي قبل مغادرتي

23
00:02:50,560 --> 00:02:52,100
والدتك؟

24
00:02:52,680 --> 00:02:57,790
أنا متّجه إلى مكان في هوكّايدو يُدعى أساهيكاوا

25
00:02:57,790 --> 00:03:00,820
لأعرف لمَ كانت أمّي مختفيةً منذ صغري

26
00:03:01,780 --> 00:03:05,830
قال أبي أنّ عليّ الذهاب إلى هناك إن أردت معرفة الأمر

27
00:03:06,560 --> 00:03:09,160
وهكذا، أفكّر بالرحيل قريباً

28
00:03:09,680 --> 00:03:10,830
لقد ساعدتماني بالكثير

29
00:03:11,890 --> 00:03:15,140
نتمنّى لك رحلةً آمنة

30
00:03:15,140 --> 00:03:17,700
شكراً لكما، أرجو أن نلتقيَ مجدداً

31
00:03:20,000 --> 00:03:22,470
عذراً... ناغاتوبيمارو-ساما

32
00:03:24,520 --> 00:03:28,730
لم أكن أدرك أنّك يوكاي عظيم كان حيّاً

33
00:03:28,730 --> 00:03:30,570
لأكثر من ألفي سنة

34
00:03:30,570 --> 00:03:32,440
أرجو أن تسامحني

35
00:03:34,460 --> 00:03:35,940
أين سمعتِ ذلك؟

36
00:03:36,630 --> 00:03:38,190
من كبير الأونغايكيو

37
00:03:38,580 --> 00:03:42,700
...أخبرني بمقدار قوّتك، وكيف قاتلتَ ذاك الرجل بشجاعة

38
00:03:43,480 --> 00:03:44,950
كفى من هذا

39
00:03:45,340 --> 00:03:46,450
مهما بلغت قوّتي

40
00:03:47,030 --> 00:03:52,780
فقد حجزني هذا الرمح الكريه لخمس مئة سنة

41
00:03:58,610 --> 00:03:59,340
ماذا؟

42
00:04:00,160 --> 00:04:01,990
لديكِ شيء آخر لتقوليه؟

43
00:04:04,160 --> 00:04:04,980
كلا

44
00:04:06,130 --> 00:04:08,410
إلى اللقاء إذاً يا رايشين وكاغاري

45
00:04:08,410 --> 00:04:09,680
كان الطعام لذيذاً

46
00:04:14,710 --> 00:04:16,340
...ذهبا

47
00:04:17,120 --> 00:04:17,930
أجل

48
00:04:20,210 --> 00:04:21,440
أخبرني يا أوشيو

49
00:04:22,280 --> 00:04:24,710
كنتُ أرغب بسؤالك منذ فترة

50
00:04:25,160 --> 00:04:26,620
ما هذا الشيء؟

51
00:04:26,620 --> 00:04:28,260
موقف الحافلة؟

52
00:04:28,260 --> 00:04:30,620
ستتوقف الحافلة لأجلك إن انتظرت هنا

53
00:04:30,620 --> 00:04:32,180
حافلة؟

54
00:04:32,960 --> 00:04:35,400
تقصد ذاك الصندوق الكبير الذي تستقلّه؟

55
00:04:35,400 --> 00:04:37,160
هل سنركبه؟

56
00:04:37,160 --> 00:04:37,850
أجل

57
00:04:37,850 --> 00:04:40,920
هكذا، هكذا إذاً، سأركبه أنا أيضاً، صحيح؟

58
00:04:40,920 --> 00:04:41,760
كلا

59
00:04:41,760 --> 00:04:43,580
ماذا؟ لماذا؟

60
00:04:43,580 --> 00:04:48,260
لماذا؟ لأنّه بإمكانك الوصول إلى محطّة تونو بقفزة واحدة

61
00:04:48,740 --> 00:04:53,400
كلا، كنتُ مهتمّاً بذاك المدعوّ بالحافلة منذ مدّة

62
00:04:53,400 --> 00:04:54,690
أريد استقلاله

63
00:04:54,690 --> 00:04:57,150
!أريد استقلاله

64
00:05:04,040 --> 00:05:06,430
هذه حافلة إذاً؟

65
00:05:06,430 --> 00:05:08,660
تتوالى المناظر تباعاً

66
00:05:10,320 --> 00:05:13,100
لكن أليست بطيئةً بعض الشيء؟

67
00:05:13,100 --> 00:05:16,030
أخبرني، لكم تتّسع من البشر؟

68
00:05:16,030 --> 00:05:19,290
اخرس، لهذا كنتُ أعارض الأمر

69
00:05:20,580 --> 00:05:22,050
!أنت

70
00:05:23,060 --> 00:05:26,890
أوشيو، سئمتُ من هذا، لنترجّل

71
00:05:26,890 --> 00:05:28,970
...أيّها اليوكاي الأحمق

72
00:05:27,640 --> 00:05:30,680
رائحتها نتنة، وضيّقة، هذا ليس جيّدًا

73
00:05:28,970 --> 00:05:30,680
أتريدني أن أضربك بشدّة؟

74
00:05:30,680 --> 00:05:34,060
هيّا، هيّا، هيّا

75
00:05:38,250 --> 00:05:39,800
ما الخطب؟

76
00:05:39,800 --> 00:05:42,000
أصبحتَ هادئاً فجأةً

77
00:05:42,000 --> 00:05:43,440
هل تؤلمك معدتك؟

78
00:05:44,870 --> 00:05:47,450
أنتَ ضعيف الإدراك

79
00:05:47,800 --> 00:05:50,200
أدرك ماذا؟

80
00:05:51,280 --> 00:05:51,910
يوكاي؟

81
00:05:52,450 --> 00:05:56,410
أجل... ويكنّون بغضاً شديداً تجاهك لسبب ما

82
00:05:57,190 --> 00:05:58,860
كما أنّ عددهم كبير جدًّا

83
00:06:06,200 --> 00:06:07,160
أين هم؟

84
00:06:07,160 --> 00:06:11,600
لا أدري، لكنّ بغضهم لا ينفكّ يتضاعف

85
00:06:12,560 --> 00:06:15,470
أين هم؟ ولمَ يبغضونني؟

86
00:06:19,850 --> 00:06:20,690
!تمهّل

87
00:06:27,560 --> 00:06:29,280
هيّا بنا، من ذاك الطريق

88
00:06:30,200 --> 00:06:32,030
!ماذا تظنّ نفسك فاعلاً

89
00:06:38,680 --> 00:06:40,250
!أوشيو، لم ننتهِ بعد

90
00:06:40,250 --> 00:06:41,080
ماذا؟

91
00:06:59,280 --> 00:07:01,150
تورا، سنتراجع الآن

92
00:07:01,150 --> 00:07:02,720
لنتوجّه إلى الغابة

93
00:07:02,720 --> 00:07:05,360
إن قاتلناهم هنا، سيتورّط أناس آخرون

94
00:07:05,360 --> 00:07:09,480
ماذا؟ مضى وقت طويل مذ قاتلنا هذا العدد

95
00:07:09,480 --> 00:07:11,100
دعني أقاتل بكامل جموحي

96
00:07:11,100 --> 00:07:13,640
أيّها الأحمق! اذهب وحسب

97
00:07:19,120 --> 00:07:24,210
لماذا؟ لمَ يسعى ذاك العدد من اليوكاي ورائي؟

98
00:07:24,210 --> 00:07:29,560
لا أدري، لكنّك قتلتَ العديد من الوحوش

99
00:07:29,560 --> 00:07:32,550
ربما يسعون لما يدعوه البشر بالانتقام

100
00:07:37,610 --> 00:07:40,560
...ابن تلك المرأة البغيضة

101
00:07:41,480 --> 00:07:45,440
!سأمزّقك أنتَ ورمح الحيوان البري

102
00:07:45,440 --> 00:07:47,640
...المرأة؟ أيقصد

103
00:07:47,640 --> 00:07:49,440
ذاك ما نقصده تمامًا

104
00:07:58,580 --> 00:08:01,350
!لن أدع غيري يلتهمك

105
00:08:09,400 --> 00:08:13,930
...من كان يظن أن ناغاتوبيمارو مهووس بمجرّد بشري

106
00:08:14,310 --> 00:08:15,780
مثير للشفقة

107
00:08:18,050 --> 00:08:19,560
...سأموت

108
00:08:23,820 --> 00:08:25,560
!لن ندعك تهرب

109
00:08:30,980 --> 00:08:32,810
هذا أمرٌ نادر الحدوث

110
00:08:33,410 --> 00:08:35,660
ناغاتوبيمارو إذاً؟

111
00:08:41,860 --> 00:08:44,970
أنتَ هيتوتسكي؟

112
00:08:45,720 --> 00:08:47,970
...مضى خمس مئة عام

113
00:08:47,970 --> 00:08:49,500
كيف كان حالك؟

114
00:08:50,400 --> 00:08:53,880
لكنّ هذا مثير للدهشة يا ناغاتوبيمارو

115
00:08:54,440 --> 00:08:58,910
في الماضي، صنعتَ سمعتك في أرض الغرب

116
00:08:58,910 --> 00:09:01,890
...ثمّ تظهر الآن فجأةً بعد خمس مئة سنة

117
00:09:02,880 --> 00:09:08,430
وفوق كل ذلك، إلى جانب بشريّ وذلك الرمح

118
00:09:08,430 --> 00:09:12,400
وسمعتُ أنّك تقتل رفاقاً وحوشاً آخرين

119
00:09:14,640 --> 00:09:19,680
قد يكون حسّ العلاقات قويّاً لديكم في الشرق هنا

120
00:09:19,680 --> 00:09:23,910
لكن بالنسبة لي، كلّ من يفتعل قتالاً معي أعتبره عدوًّا ببساطة

121
00:09:24,480 --> 00:09:28,600
وأيضاً، توقّف عن مناداتي بـ ناغاتوبيمارو

122
00:09:28,980 --> 00:09:31,170
أكره أن أُدعى بذلك

123
00:09:31,580 --> 00:09:35,580
هل أناديك إذًا بـ آزافوسي

124
00:09:35,580 --> 00:09:39,180
كما أطلقوا عليك عندما أتيتَ من الصين، يا ناغاتوبيمارو؟

125
00:09:45,190 --> 00:09:48,190
كفّ عن التحالف مع الصبي

126
00:09:48,490 --> 00:09:53,120
اسمع! أنا لستُ متحالفاً معه

127
00:09:53,120 --> 00:09:55,990
أنا أتلبّسه كي ألتهمه

128
00:09:55,990 --> 00:09:58,950
!جميعكم تسيئون الفهم باستمرار

129
00:10:00,450 --> 00:10:04,620
إذاً؟ لمَ تسعى الوحوش وراءه؟

130
00:10:04,620 --> 00:10:06,710
ماذا حصل في غيابي؟

131
00:10:08,280 --> 00:10:10,490
لم تعلم إذاً؟

132
00:10:10,490 --> 00:10:12,960
سأخبرك إذًا

133
00:10:16,900 --> 00:10:20,140
رمح الحيوان البري... هذا يكفي، توقّف

134
00:10:20,660 --> 00:10:22,140
!توقّف

135
00:10:36,600 --> 00:10:38,700
...الرمح لن يهدأ

136
00:10:39,600 --> 00:10:41,680
سحقاً، هنالك المزيد؟

137
00:10:41,680 --> 00:10:44,450
!تهاجمونني بلا أيّ سبب، اخرجوا

138
00:10:50,690 --> 00:10:53,210
لن تأذيني إن خرجت؟

139
00:10:53,210 --> 00:10:55,040
!هذا يعتمد عليك

140
00:10:55,040 --> 00:10:56,750
أنا في غاية الانفعال

141
00:10:56,750 --> 00:10:58,220
...إن لم تخرج، سأستعمل هذا الرمح و

142
00:10:58,490 --> 00:11:01,660
حسناً... فهمتُ الأمر، سأخرج الآن

143
00:11:08,690 --> 00:11:10,480
كابّا؟

144
00:11:10,480 --> 00:11:17,900
من المستحيل أن أفكّر بفعل شيء لذاك الرمح المخيف

145
00:11:20,370 --> 00:11:25,240
صدقاً... لمَ تهاجمني جميع تلك الوحوش؟

146
00:11:25,800 --> 00:11:31,250
حسناً... ربما هزمتُ العديد... من أصدقائهم

147
00:11:33,750 --> 00:11:37,460
لكن صدقاً؟ لهذا السبب ظهر كلّ ذاك العدد؟

148
00:11:37,460 --> 00:11:43,210
توقّف رجاءً! قبض عليّ البشر في الماضي عندما تماديتُ بألاعيبي

149
00:11:43,210 --> 00:11:46,890
وأقسمتُ على ألّا أقوم بشيء مجدداً فسامحوني

150
00:11:46,890 --> 00:11:48,640
لن أفعل شيئاً للبشر

151
00:11:50,820 --> 00:11:53,220
...أنا آسف، لكن

152
00:11:53,760 --> 00:11:56,420
استهدفوا حافلة حتّى

153
00:11:57,080 --> 00:11:58,400
...الناس الذين كانوا بالداخل

154
00:12:00,040 --> 00:12:05,910
لا تملك فكرةً عن سبب مهاجمتهم لك حقّاً؟

155
00:12:05,910 --> 00:12:08,810
أتعلم؟ أخبرني إن كنتَ تعلم

156
00:12:08,810 --> 00:12:09,940
!أرجوك

157
00:12:10,630 --> 00:12:14,090
أنتَ أوتسكي أوشيو، أليس كذلك؟

158
00:12:14,810 --> 00:12:16,040
كيف تعرف ذلك؟

159
00:12:16,760 --> 00:12:18,510
هذا أمر معروف

160
00:12:18,510 --> 00:12:22,550
لا يسعون وراءك لأنّك قتلت وحوشاً آخرين

161
00:12:23,600 --> 00:12:24,870
...السبب

162
00:12:26,290 --> 00:12:28,460
هو أمّك

163
00:12:32,630 --> 00:12:36,400
السبب... هو أمّي؟

164
00:12:37,000 --> 00:12:40,310
إنّه أمر يحيط به جميع يوكاي اليابان

165
00:12:40,820 --> 00:12:43,820
تملكون أيّها البشر ما يُدعى بالأغاني، أليس كذلك؟

166
00:12:44,280 --> 00:12:46,360
لدينا مثلها أيضاً

167
00:12:48,050 --> 00:12:54,000
عبر مئة جبل، عبر ألف محيط

168
00:12:54,000 --> 00:13:01,640
أتى وجه الشرّير هاكومين البغيض

169
00:13:01,640 --> 00:13:11,990
كم نودّ التهامه، كم نودّه أن يحترق

170
00:13:12,720 --> 00:13:23,280
لكنّ امرأةً بشريّة تقوم بحمايته، امرأة بشرية

171
00:13:23,280 --> 00:13:28,170
كم نمقت المرأة، كم نبغضها

172
00:13:28,170 --> 00:13:39,750
كم نمقتها، لن نسامحها مطلقًا، نسامحها مطلقًا

173
00:13:43,440 --> 00:13:46,760
قبل قرابة ما تعتبرونها بالألف سنة أيّها البشر

174
00:13:48,710 --> 00:13:55,780
أتت صغيرة جميلة إلى هنا على سفينةٍ من أرض تُدعى بالصين

175
00:13:57,320 --> 00:14:02,350
لكن هيئتها الحقيقية كانت يوكاي بالغ القوّة من أرض أجنبية

176
00:14:02,350 --> 00:14:04,530
أخفى نفسه

177
00:14:05,880 --> 00:14:08,960
عندما أُنشِئت تلك الأرض الأجنبية في هذا العالم

178
00:14:08,960 --> 00:14:12,640
انقسم الكون إلى ين ويانغ

179
00:14:12,640 --> 00:14:15,150
ذهبت قوّة الخير الين إلى البشر

180
00:14:15,150 --> 00:14:19,530
وقوّة اليانغ الشرّيرة وُلِدت بداخل ذاك اليوكاي

181
00:14:21,780 --> 00:14:26,170
استمرّ ذاك اليوكاي بتغيير الأراضي التي عاش عليها

182
00:14:26,580 --> 00:14:31,660
وألحق الدمار بالبشر وكلّ ما كان يعيش هناك

183
00:14:33,280 --> 00:14:35,180
وحتّى الوحوش أيضاً

184
00:14:36,520 --> 00:14:40,070
جميع اليوكاي سواي

185
00:14:40,580 --> 00:14:41,800
سيموتون

186
00:14:42,840 --> 00:14:44,620
سأترك البشر

187
00:14:45,300 --> 00:14:48,260
دماء البشر وبؤسهم يجلبان لي السعادة

188
00:14:49,660 --> 00:14:55,370
لكن لا حاجة لأيّ وحش غيري في هذا العالم

189
00:14:56,560 --> 00:14:59,700
اسم ذاك المخلوق هو هاكومين نو مونو

190
00:15:00,600 --> 00:15:02,190
هاكومين نو مونو؟

191
00:15:03,470 --> 00:15:08,370
...أتى ذاك اليوكاي أخيراً إلى اليابان

192
00:15:08,370 --> 00:15:10,630
للقضاء علينا

193
00:15:12,720 --> 00:15:17,030
حتّى لحظتها، لم يعتبر أيّ أحدٍ منّا يوكاي آخر رفيقاً له

194
00:15:17,440 --> 00:15:20,700
لكنّنا تكاتفنا جميعاً وقمنا بمواجهته

195
00:15:22,000 --> 00:15:24,800
تحكّمت قوّته بالسماء والأرض

196
00:15:24,800 --> 00:15:27,200
وكانت أقوى من جميعنا

197
00:15:27,200 --> 00:15:29,640
ولا تُقهر بكل ما تحمله الكلمة من معنى

198
00:15:30,880 --> 00:15:39,580
لكن بعد أن أصبحت هويّته جليّةً للبشر، لاذ بالفرار

199
00:15:39,970 --> 00:15:43,670
لكن لم يكن ذلك سوى تراجعٍ مؤقّت

200
00:15:44,690 --> 00:15:46,990
...سأعود

201
00:15:47,760 --> 00:15:52,430
سأجمع قواي... ثمّ أقتلكم جميعاً

202
00:15:53,280 --> 00:15:56,680
صدّق يوكاي اليابان كلماته

203
00:15:57,560 --> 00:16:04,260
لذا أرسلوا بعضهم لقتله قبل أن يستعيد قوّته

204
00:16:05,160 --> 00:16:09,240
أتينا الآن للجزء المتعلّق بوالدتك

205
00:16:14,470 --> 00:16:16,490
أيظهر اليوكاي في هذا الوقت؟

206
00:16:16,490 --> 00:16:20,940
اسمع، توجد قرية هناك على مسافة جبلين

207
00:16:20,940 --> 00:16:23,840
لن يلاحقوك إلى ذاك الحدّ على الأرجح، اذهب سريعاً

208
00:16:23,840 --> 00:16:24,370
أجل

209
00:16:26,520 --> 00:16:27,910
هذا دواء رائع

210
00:16:29,030 --> 00:16:31,690
ذاك الدواء هو مصدر فخري الوحيد

211
00:16:31,690 --> 00:16:35,460
أطراني البشر بشأنه من قبل

212
00:16:36,000 --> 00:16:38,100
أنتَ شخص صالح

213
00:16:39,060 --> 00:16:40,060
شكراً لك أيّها الكابّا

214
00:16:41,560 --> 00:16:43,020
شكراً لك"؟"

215
00:16:47,430 --> 00:16:50,570
سحقاً، ماذا عن أمّي؟

216
00:16:51,680 --> 00:16:53,240
...أمّي

217
00:16:56,190 --> 00:16:58,380
يا للفظاعة

218
00:16:58,380 --> 00:17:02,670
يقولون أنّ نجاة الجميع باستثناء السائق كانت معجزة

219
00:17:02,670 --> 00:17:05,100
يا إلهي، هل وقع حادث؟

220
00:17:05,100 --> 00:17:06,540
ما الخطب؟

221
00:17:06,540 --> 00:17:08,840
قد يستغرق الأمر وقتاً

222
00:17:09,970 --> 00:17:13,610
لا يزال هناك الكثير من الوقت لرؤية والدي في ساعات الزيارة

223
00:17:14,130 --> 00:17:15,220
سأنتظر

224
00:17:15,780 --> 00:17:17,090
سايا

225
00:17:17,720 --> 00:17:18,950
أوماموري-ساما؟

226
00:17:19,540 --> 00:17:20,470
هنالك أمر غريب

227
00:17:22,820 --> 00:17:26,790
يوكاي هذه المنطقة يثيرون جلبة

228
00:17:29,810 --> 00:17:31,340
هذا غريب

229
00:17:31,340 --> 00:17:34,070
...أجل، مَن في الجبال

230
00:17:34,770 --> 00:17:37,110
رايشين، كاغاري

231
00:17:37,470 --> 00:17:39,120
لمَ لم تلاحقاه؟

232
00:17:39,640 --> 00:17:42,700
!لاحقوا ابن تلك المرأة البغيضة واقتلوه

233
00:17:42,700 --> 00:17:44,120
!المدعو أوتسكي أوشيو

234
00:17:45,210 --> 00:17:47,210
هيّا بنا

235
00:17:51,490 --> 00:17:52,280
انتظروا

236
00:17:53,250 --> 00:17:56,550
...لا ندرك نحن الشقيقان دوافعكم

237
00:17:56,900 --> 00:18:00,180
...لكن من يشيرون بالسوء إلى أوشيو-دونو

238
00:18:01,490 --> 00:18:03,930
!لن نصفح عنهم

239
00:18:06,640 --> 00:18:10,670
كنتَ مذهلاً وقتها يا ناغاتوبيمارو

240
00:18:10,670 --> 00:18:12,940
أخبرتك بأن تكفّ عن مناداتي بذلك

241
00:18:13,470 --> 00:18:17,210
...عندما أتى هاكومين نو مونو من الصين

242
00:18:17,210 --> 00:18:22,700
أنتَ وأنا، ويوكاي اليابان خاطرنا بحياتنا في قتاله

243
00:18:25,690 --> 00:18:29,920
أجل، منذ هزيمة هاكومين نو مونو أمامنا وفراره

244
00:18:29,920 --> 00:18:32,210
واصلتم البحث عنه

245
00:18:32,710 --> 00:18:36,560
لكن بعد أن انتهى القتال

246
00:18:36,560 --> 00:18:39,470
فقدت اهتمامك ورحلت إلى مكانٍ ما

247
00:18:40,530 --> 00:18:44,970
انتهى الأمر بي موتوداً إلى ذاك الحائط البغيض

248
00:18:46,240 --> 00:18:51,000
بحثنا عن هاكومين نو مونو، وعثرنا عليه أخيراً

249
00:18:51,680 --> 00:18:53,370
في غيابك

250
00:18:53,370 --> 00:18:56,460
هاجمناه مرّات عديدة في أرض نومه

251
00:18:56,990 --> 00:18:58,990
لكن بلا جدوى

252
00:19:00,910 --> 00:19:05,240
كان هنالك حاجز قويّ يحيط به

253
00:19:05,600 --> 00:19:09,500
فاصل مطلق لا نقدر نحن اليوكاي على تجاوزه

254
00:19:10,960 --> 00:19:17,080
ومن صنع ذاك الحاجز كانت امرأة واحدة

255
00:19:18,720 --> 00:19:20,970
...بسبب تلك المرأة

256
00:19:24,440 --> 00:19:27,190
...فهمتُ مجمل القصة

257
00:19:27,880 --> 00:19:30,610
لكن ما علاقة تلك المرأة بـ أوشيو؟

258
00:19:30,610 --> 00:19:33,410
لا تشير إلى أنّه ابنها، أليس كذلك؟

259
00:19:33,410 --> 00:19:36,200
لا يعيش البشر لألف سنة

260
00:19:36,200 --> 00:19:39,780
كانت المرأة المُوكلة الأولى

261
00:19:40,560 --> 00:19:42,920
أصغِ يا ناغاتوبيمارو

262
00:19:42,920 --> 00:19:47,160
لن يشفى غليل يوكاي اليابان حتّى نقتل أوشيو

263
00:19:47,160 --> 00:19:49,550
...أخبرتك بأنّي من سيلتـ

264
00:19:49,550 --> 00:19:54,040
هذا ما تقوله، لكنّك لم تحاول التهامه حتّى

265
00:19:56,700 --> 00:20:01,120
أخبرني، ما الذي جرى لك يا ناغاتوبيمارو؟

266
00:20:01,120 --> 00:20:07,110
...يا إلهي، كنتَ في غاية القوّة والوحشية مع البشر

267
00:20:10,540 --> 00:20:12,730
نحن نكره البشر أيضاً

268
00:20:13,030 --> 00:20:15,230
!لكنّ أوشيو-دونو مختلف

269
00:20:20,280 --> 00:20:22,480
!ستندمان على هذا

270
00:20:22,480 --> 00:20:25,820
!لن تفلتا بفعلتكما هذه

271
00:20:26,330 --> 00:20:28,650
قام أوشيو-دونو بإنقاذنا

272
00:20:29,170 --> 00:20:30,890
لن نندم على شيء

273
00:20:31,400 --> 00:20:33,000
...أوشيو-ساما

274
00:20:33,000 --> 00:20:33,850
لنذهب خلفه

275
00:20:33,850 --> 00:20:34,420
أجل

276
00:20:37,080 --> 00:20:39,920
اذهبوا واقتلوه إذًا

277
00:20:42,920 --> 00:20:47,240
أحسنتَ قولاً! هذا هو ناغاتوبيمارو

278
00:20:47,240 --> 00:20:49,180
هذا ما سنفعله

279
00:20:50,080 --> 00:20:54,250
كما اعتدنا في الماضي، لن أتوسّل مساعدتك

280
00:20:54,250 --> 00:20:56,440
ابقَ مكانك

281
00:20:59,120 --> 00:21:00,870
أنت، هيتوتسكي

282
00:21:02,340 --> 00:21:04,400
كم مرّةً عليّ إخبارك؟

283
00:21:04,400 --> 00:21:07,080
لا تدعني بـ ناغاتوبيمارو

284
00:21:07,080 --> 00:21:08,500
أكره ذاك الاسم

285
00:21:08,960 --> 00:21:09,580
...وأيضاً

286
00:21:11,110 --> 00:21:13,500
رمح الحيوان البري قويّ

287
00:21:14,260 --> 00:21:17,330
سأتذكر ذلك يا ناغاتوبيمارو

288
00:21:22,280 --> 00:21:23,880
!سحقاً

289
00:21:28,010 --> 00:21:29,850
يا إلهي، كفّوا عن ذلك

290
00:21:30,760 --> 00:21:33,040
هذا القتال مريب

291
00:21:33,040 --> 00:21:35,850
أقاتل لأجل حياتي ولا أعرف الأسباب

292
00:21:36,190 --> 00:21:38,700
...بأيّة حال، إن توجّهتُ إلى القرية سوف

293
00:21:40,440 --> 00:21:43,650
أيّها الحمقى! إن كنتم ستهاجمون أحداً ليكن أنا فحسب

294
00:21:45,920 --> 00:21:47,540
من أنت؟

295
00:21:47,540 --> 00:21:48,610
ما تلك الأشياء؟

296
00:21:48,920 --> 00:21:51,340
إنّها يوكاي، سنكون بخير إن تمكّنا من الهرب

297
00:21:51,340 --> 00:21:52,120
من أيّ طريق القرية؟

298
00:21:53,640 --> 00:21:54,370
من هناك

299
00:21:54,370 --> 00:21:55,940
حسنٌ