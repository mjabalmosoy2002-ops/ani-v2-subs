.وبمجرد أن يستيقظوا لن يعرفوا مكاني

193
00:13:11,220 --> 00:13:13,350
.لكن سيتم استدعائهم إلى هناك

194
00:13:14,230 --> 00:13:18,860
.الأزافوسي سينتبهون لذلك النداء ويتّجهون لمصدره

195
00:13:20,160 --> 00:13:25,220
...الشيء الذي يسعى خلفي دومًا، وقريب منّي دومًا

196
00:13:26,930 --> 00:13:28,550
.هو رمح الوحش

197
00:13:30,020 --> 00:13:34,660
.الشيء الوحيد الذي يزعجني هو رمح الوحش

198
00:13:35,570 --> 00:13:40,100
.لكن عليّ أن أعتني بأمر الأزافوسي أيضًا

199
00:13:41,540 --> 00:13:42,870
ما رأيك؟

200
00:13:43,600 --> 00:13:47,100
هل ستتكفّل بهذا الدور من أجلي؟

201
00:13:49,110 --> 00:13:52,470
.في مقدورك قتل وحوش أقوى من الذين قتلتهم فيما خلف

202
00:13:53,990 --> 00:13:59,980
.وسأمنحك القوّة التي تحتاجها لقتالهم

203
00:14:02,150 --> 00:14:04,410
.إن الاستماع لهذا مضيعة للوقت

204
00:14:04,410 --> 00:14:07,610
.لقد أصبحت أحد خدم هاكومين وحسب

205
00:14:08,100 --> 00:14:09,580
!لستُ خادم

206
00:14:09,580 --> 00:14:13,910
!إنني أقوم بما أبتغي وحسب

207
00:14:18,580 --> 00:14:19,480
!تورا

208
00:14:23,220 --> 00:14:24,970
!هذا ممتع

209
00:14:24,970 --> 00:14:28,550
.يمكنني قطع البشر والوحوش على حد سواء

210
00:14:33,970 --> 00:14:36,090
هل تبتسم؟

211
00:14:38,530 --> 00:14:39,940
...أجل

212
00:14:40,710 --> 00:14:43,250
لأنّه قد تم لم شملي أخيرًا

213
00:14:43,250 --> 00:14:46,940
مع شخص أردتُ مقابلته بشدّة

214
00:14:47,380 --> 00:14:50,950
!لم أستطع تحمّل هذه الرغبة

215
00:15:14,760 --> 00:15:15,720
!هاي فونغ

216
00:15:24,740 --> 00:15:28,710
قصدت ألّا تقتلني آنذاك، صحيح؟

217
00:15:29,280 --> 00:15:32,570
.أنا أيضًا أمتلك جانبًا لعوبًا

218
00:15:33,160 --> 00:15:35,880
أردتُ رؤية قدر المعاناة التي ستقتل

219
00:15:35,880 --> 00:15:39,260
.بشريّ فقد زوجته وابنته

220
00:15:39,260 --> 00:15:41,560
!سحقًا! أريد نزالاً آخر

221
00:15:42,260 --> 00:15:43,580
!لا تعترض طريقي

222
00:15:43,580 --> 00:15:44,300
!لا

223
00:15:44,300 --> 00:15:45,680
!لماذا؟

224
00:15:45,680 --> 00:15:47,960
هل سبق وأن رأيت يد هيو-سان

225
00:15:48,930 --> 00:15:50,720
إن يده تغطّيها الندوب

226
00:15:50,720 --> 00:15:55,100
.من البحث عنه والمخاطرة بحياته

227
00:15:56,550 --> 00:15:58,120
إذ لم يتواجد ذلك الشيء

228
00:15:58,870 --> 00:16:00,340
كان ليصبح والدًا صالحًا

229
00:16:00,820 --> 00:16:04,980
.وما كان ليعاني الألم والشقاء

230
00:16:06,470 --> 00:16:08,470
!ليس من حقّك هزيمة غورين

231
00:16:09,220 --> 00:16:10,860
!بل من حق هيو-سان

232
00:16:11,330 --> 00:16:16,170
.صحيح، يجب أن أذكر هذا أيضًا

233
00:16:16,170 --> 00:16:18,940
زوجتك وابنتك

234
00:16:18,940 --> 00:16:23,620
.كانتا طيّبتا المذاق

235
00:16:23,620 --> 00:16:26,250
!طرق الصاعقة الخمس عشرة: الإبادات السبع

236
00:16:28,280 --> 00:16:29,550
.انقلع

237
00:16:32,390 --> 00:16:35,140
.مثير للشفقة! أعتقد بأن هذا كل ما يمكن توقّعه من بشر

238
00:16:36,440 --> 00:16:38,850
!طرق الصاعقة الخمس عشرة: المخالب التسعة

239
00:16:38,850 --> 00:16:39,960
!- كين - ختم

240
00:16:46,820 --> 00:16:50,820
.يبدو بأنك ستجعلني أتصرّف بجدّية

241
00:16:50,820 --> 00:16:52,740
...أنت

242
00:16:52,740 --> 00:16:54,500
!قد انتهيت

243
00:17:02,100 --> 00:17:06,120
.الآن ستدفع ثمن كل ما فعلته طوال هذه السنين

244
00:17:07,300 --> 00:17:08,170
!كين

245
00:17:12,770 --> 00:17:14,170
كين" إذًا؟"

246
00:17:15,170 --> 00:17:20,120
.يبدو بأن عملك كان ختم الوحوش

247
00:17:21,350 --> 00:17:26,440
...لكن... سيكون عليك بذل مجهودٍ أكبر

248
00:17:27,620 --> 00:17:29,370
!لكي تختمني

249
00:17:32,310 --> 00:17:33,450
!هيو-سان

250
00:17:36,440 --> 00:17:40,380
...عينك اليمنى التي أذيتُها

251
00:17:40,380 --> 00:17:42,820
.سمعتُ بأنها تسمح لك برؤية الوحوش

252
00:17:43,720 --> 00:17:48,290
.سوف أتذوّقها

253
00:17:48,950 --> 00:17:50,590
!هيو-سان

254
00:17:52,620 --> 00:17:54,410
ماذا؟

255
00:17:54,880 --> 00:18:00,150
.لا يمكنني أن أسمح لك بسلبي هذه العين، ليس بعد

256
00:18:01,460 --> 00:18:07,510
.إنّها مهمة جدًا... حيث أحتاجها لأشاهدك وأنت تموت

257
00:18:08,320 --> 00:18:10,360
!فلتمت وحسب

258
00:18:12,550 --> 00:18:13,370
ماذا؟

259
00:18:14,000 --> 00:18:15,900
...يبدو بأنهم هنا

260
00:18:15,900 --> 00:18:21,030
.هذا يعني بأن هاكومين نو مونو جاهز

261
00:18:22,470 --> 00:18:25,950
.سأدعك تفلت هذه المرة

262
00:18:28,020 --> 00:18:30,860
سأترك هذا هنا

263
00:18:30,860 --> 00:18:33,750
.لكيّ لا أنسَ أمرك

264
00:18:34,200 --> 00:18:38,530
.لكن المرة القادمة، سألتهم عينك

265
00:18:38,530 --> 00:18:41,930
.أجل، أنا أرتجف من الحماس

266
00:18:47,320 --> 00:18:50,620
.أخبرتكم، لقد اكتملت التجهيزات

267
00:18:50,620 --> 00:18:55,120
أتعتقدون حقًا بأنه في وسعكم هزيمة هاكومين نو مونو؟

268
00:18:59,920 --> 00:19:00,760
!هيو-سان

269
00:19:06,930 --> 00:19:08,260
...إنّ الأزافوسي

270
00:19:08,660 --> 00:19:12,220
.سنتقابل مجددًا في المستقبل القريب

271
00:19:12,220 --> 00:19:14,460
!مهلاً! لا تزال هنالك أمور عالقة

272
00:19:14,460 --> 00:19:16,360
لماذا تتحولون إلى حجارة مجددًا؟

273
00:19:16,820 --> 00:19:18,920
...سبب تحوّلنا إلى حجارة

274
00:19:19,860 --> 00:19:26,060
.من أجل أن نعرفه، علينا التحوّل إلى حجارة

275
00:19:26,960 --> 00:19:32,550
هذا لأن مصدر قوّة هاكومين نو مونو

276
00:19:33,240 --> 00:19:37,770
.هو الخوف من المجهول

277
00:19:43,750 --> 00:19:45,740
.سايا-سان ذكرت هذا أيضًا

278
00:19:46,680 --> 00:19:50,230
.قالت بأن هاكومين يحوّل الخوف إلى قوة

279
00:19:55,040 --> 00:19:56,210
أهذا كافٍ؟

280
00:19:57,120 --> 00:19:58,790
.ربّما يجب أن نتّصل بطبيب

281
00:19:58,790 --> 00:20:01,840
.أنا بخير، هذا ما اعتدتُ فعله

282
00:20:04,080 --> 00:20:05,180
ألديك ساكي؟

283
00:20:07,760 --> 00:20:11,740
لا يفترض أن تشرب الساكي أثناء الإصابة، صحيح؟

284
00:20:12,370 --> 00:20:15,510
...معلّمي في فنون الختم كان يقول ليّ دومًا

285
00:20:16,230 --> 00:20:17,690
بعد معركة

286
00:20:17,690 --> 00:20:21,440
.استخدم الساكي لإخراج أي كراهية موحلة من فمك

287
00:20:21,440 --> 00:20:22,880
...هاه

288
00:20:22,880 --> 00:20:24,060
أتريد القليل؟

289
00:20:24,060 --> 00:20:26,700
.هاه؟ لا، أنا بخير

290
00:20:26,700 --> 00:20:29,200
.تعلم بأنك تريد احتساء القليل

291
00:20:29,200 --> 00:20:30,290
!أصمت

292
00:20:30,760 --> 00:20:33,790
!ليس عليك ضربي كلّ مرة، أيّها القزم القذر

293
00:20:33,790 --> 00:20:37,040
!أصمت، أيّها اليوكاي ذو الوجه الغبيّ

294
00:20:37,380 --> 00:20:39,380
هاه؟ ما الذي تنظر إليه؟

295
00:20:39,800 --> 00:20:44,270
.أفترض بأنكما ستذهبان إلى المعركة ضد هاكومين بهذا الشكل

296
00:20:44,270 --> 00:20:45,510
وماذا في ذلك؟

297
00:20:46,100 --> 00:20:48,200
إن فكرة عدم تغيّركما أبدًا

298
00:20:48,200 --> 00:20:50,230
بغض النظر عن ظروفكما

299
00:20:50,870 --> 00:20:52,390
.تسلّيني

300
00:20:53,320 --> 00:20:55,810
.لا أهتم لأمر هذا الطفل الغبيّ

301
00:20:56,440 --> 00:21:00,200
.ماذا عنك؟ إن غورين قويّ

302
00:21:00,200 --> 00:21:02,270
.لا أختلف عنكما

303
00:21:03,200 --> 00:21:04,610
...سأقضِ عليه المرة القادمة

304
00:21:05,440 --> 00:21:08,250
.مهما حدث ليّ

305
00:21:10,610 --> 00:21:11,540
...لكن

306
00:21:11,910 --> 00:21:13,390
بعد ذلك

307
00:21:13,390 --> 00:21:16,200
.أريد مشاهدة معركتكما أيضًا

308
00:21:17,160 --> 00:21:20,780
.لقد تغيّرت، بالنسبة لرجل لا يشغل باله إلّا الانتقام

309
00:21:22,420 --> 00:21:24,840
.هلال القمر جميل هذه الليلة

310
00:21:26,000 --> 00:21:28,810
.يصنع القمر الغرائب بقلب الإنسان

311
00:21:29,400 --> 00:21:30,840
.هذا كل ما في الأمر

312
00:21:32,160 --> 00:21:33,240
ستغادر؟

313
00:21:33,240 --> 00:21:34,060
.أجل

314
00:21:34,770 --> 00:21:38,040
.الختم الذي وضعته على غورين سيرشدني إلى مكانه

315
00:21:38,040 --> 00:21:39,610
...هاه

316
00:21:39,610 --> 00:21:41,440
.حسنًا، لا تخفق

317
00:21:42,200 --> 00:21:45,150
.يبدو بأنني لستُ الوحيد الذي تغيّر

318
00:21:45,150 --> 00:21:46,700
.لا أعرف ما الذي تتفوّه به

319
00:21:47,720 --> 00:21:50,240
.أشكركما

320
00:21:50,240 --> 00:21:50,970
.أجل

321
00:21:50,970 --> 00:21:54,450
.لقد ألم ّ بك خطب ما حقًا

322
00:21:56,550 --> 00:21:58,580
يمكنك إلقاء اللوم

323
00:22:00,000 --> 00:22:01,240
.على هلال القمر

324
00:22:17,000 --> 00:22:21,780
ثمّة أمور لم أستطع فهمها

325
00:22:22,340 --> 00:22:26,780
ثمّة أناس أذيتهم أثناء ذلك

326
00:22:27,510 --> 00:22:31,710
لكن إن كان كل ما بمقدوري هو التحلّي بالندم

327
00:22:32,000 --> 00:22:36,590
ما كنتُ لأقدر على حماية أي شيء أساسًا

328
00:22:38,220 --> 00:22:43,450
!رجاءً أخبرني يا رمح الوحش

329
00:22:43,470 --> 00:22:46,920
هل استطعت الحفاظ على ناظري ثابتًا نحو الأمام؟

330
00:22:50,380 --> 00:22:55,430
لعالمٍ تقطن فيه من أحب

331
00:22:55,650 --> 00:23:00,660
"من أجل حماية "الحاضر" و "المستقبل

332
00:23:00,660 --> 00:23:05,580
سأضع حدًا لكل ما يبكيها

333
00:23:05,720 --> 00:23:10,260
لهذا السبب أرغب في أن أغدو أقوى

334
00:23:11,220 --> 00:23:15,980
لأجل مستقبل تستطيع فيه من أحب أن تبتسم

335
00:23:16,210 --> 00:23:21,340
من أجل حماية صوتها وأحلامها

336
00:23:21,510 --> 00:23:26,340
سأضع حدًا لكل ما يبكيها

337
00:23:26,470 --> 00:23:31,360
!لستُ بحاجة لسبب آخر يدفعني لذلك