1
00:00:08,140 --> 00:00:10,530
.صباح الخير يا تينا وإيلي

2
00:00:10,530 --> 00:00:12,330
.صباح الخير يا ليني

3
00:00:12,330 --> 00:00:14,530
.صباح الخير يا آنسة ليني

4
00:00:15,380 --> 00:00:17,370
!أرجوك انتظر أيّها الأمير جيرارد

5
00:00:21,720 --> 00:00:23,710
.هذه أنت

6
00:00:26,900 --> 00:00:28,380
مـ-ماذا تريد؟

7
00:00:28,980 --> 00:00:30,160
.افرحي

8
00:00:30,160 --> 00:00:32,370
.سأجعلك ملكي

9
00:00:48,900 --> 00:00:50,360
.يا للحماسة

10
00:00:50,360 --> 00:00:53,770
أتعدّ الملاحظات لهن جميعًا كل أسبوع؟

11
00:00:53,770 --> 00:00:57,220
.آسف على استغلال مكتبك

12
00:00:57,220 --> 00:00:58,490
.لا أمانع

13
00:01:03,150 --> 00:01:04,840
هل عرفت شيئًا؟

14
00:01:04,840 --> 00:01:07,950
.لا، التقدم بطيء

15
00:01:12,400 --> 00:01:17,480
الكركي الجليدي تعويذة عظمى، ولا أحد
.على قيد الحياة قادر على إطلاقها

16
00:01:17,480 --> 00:01:20,880
.لا يمكنني ببساطة أن أبحث عنها في كتاب

17
00:01:23,080 --> 00:01:25,300
.ردّ من فضلك يا آلين

18
00:01:26,130 --> 00:01:28,390
...مرحبًا، هذا قسم الجامعة الملكية

19
00:01:28,390 --> 00:01:29,590
!أهذا صوت آلين؟

20
00:01:29,960 --> 00:01:31,760
!إنّه أنا، ريتشارد

21
00:01:31,760 --> 00:01:34,410
!الحمد لله! كنت أبحث عنك

22
00:01:34,410 --> 00:01:35,890
ماذا فعلت ليديا هذه المرة؟

23
00:01:35,890 --> 00:01:37,490
!ليست هي

24
00:01:41,460 --> 00:01:44,400
!كوني لي يا ليني لينستر

25
00:01:44,680 --> 00:01:48,030
!أخبرتك من قبل أنّي أرفض قطعًا

26
00:01:48,500 --> 00:01:51,640
.كيف تجرؤين على ردّي؟! هذا محال

27
00:01:55,500 --> 00:01:59,280
.أثّرت طفلة آل هاوارد الملعونة بالسوء

28
00:01:59,280 --> 00:02:00,670
.كم هذا مؤسف

29
00:02:03,520 --> 00:02:06,050
!لا تهن صديقتي

30
00:02:07,050 --> 00:02:09,560
.الأخت مثل أختها

31
00:02:09,560 --> 00:02:12,550
.لكن لا، يبدو أن تلك الحثالة الوضيعة هي السبب

32
00:02:12,550 --> 00:02:14,390
.تفوح منك رائحة نتنة

33
00:02:14,840 --> 00:02:16,240
.رائحة حيوان

34
00:02:16,240 --> 00:02:19,440
هل أصبحنّ جميعكن نساءه؟

35
00:02:20,280 --> 00:02:22,690
!ألا يكفيك تشويه سمعتي وحدي؟

36
00:02:27,530 --> 00:02:30,320
!أتحداك في نزال

37
00:02:34,220 --> 00:02:35,450
ماذا؟

38
00:02:40,020 --> 00:02:45,540
ليحضر جلالته والدوقات الأربعة
.ليشهدوا حسم الأمر لاحقًا

39
00:02:45,540 --> 00:02:47,420
ما جوابك؟

40
00:02:54,690 --> 00:02:56,360
كيف آل الأمر إلى هذا؟

41
00:02:56,360 --> 00:02:57,400
.لا تقلقي

42
00:02:57,400 --> 00:02:59,100
.لننتظر قدوم أخي والبقية

43
00:03:05,740 --> 00:03:08,310
لعل سموّك قد تجاوزت الحد قليلًا؟

44
00:03:08,310 --> 00:03:10,880
صحيح، فقد عدت للتو إلى مهامك

45
00:03:10,880 --> 00:03:12,820
.فكّر في مكانتك إن استمر هذا الحال

46
00:03:12,820 --> 00:03:14,200
!لا تشككا بي

47
00:03:19,160 --> 00:03:21,220
!لا أحد منكم يعرف معنى الاحترام

48
00:03:23,440 --> 00:03:25,500
!وأنتِ أيضًا يا ليني

49
00:03:32,010 --> 00:03:34,160
!أسرعوا بمعالجة الجرحى قبل فوات الأوان

50
00:03:34,160 --> 00:03:35,090
!حـ-حسنًا

51
00:03:36,760 --> 00:03:38,140
!لا تعبثوا معي

52
00:03:40,740 --> 00:03:44,810
سألقّنكنّ أيتها الفتيات الساذجات
!درسًا في معرفة حدودكن

53
00:03:46,210 --> 00:03:48,440
!أيّها الأمير جيرارد، هل جننت؟

54
00:03:48,760 --> 00:03:52,070
!انتبهي لألفاظك أيّتها الفاشلة

55
00:03:52,800 --> 00:03:58,320
سمعت عنك كل شيء، وأنك لن
!تتقني أبدًا التعويذات العليا

56
00:04:02,830 --> 00:04:04,740
!حسنًا، هذا يكفي

57
00:04:06,120 --> 00:04:07,940
ماذا يجري؟

58
00:04:08,910 --> 00:04:11,090
.تحمل شيئًا فظيعًا بيدك

59
00:04:11,090 --> 00:04:12,800
!أنت ثانيةً؟

60
00:04:12,800 --> 00:04:14,520
!لا تعرقلني

61
00:04:14,520 --> 00:04:16,890
!أيّها الجميع، أرجوكن احتمين

62
00:04:16,890 --> 00:04:19,660
!سنقاتل أيضًا يا أستاذ

63
00:04:19,660 --> 00:04:21,310
!نريد تقديم المساعدة

64
00:04:22,480 --> 00:04:23,890
!مت

65
00:04:33,820 --> 00:04:34,650
...بهذه الحالة

66
00:04:37,460 --> 00:04:39,240
!هيّا، غادرن بينما الفرصة سانحة

67
00:04:43,750 --> 00:04:45,140
.يا إلهي

68
00:04:51,850 --> 00:04:53,300
...ذلك الخنجر

69
00:04:53,720 --> 00:04:54,950
.مت

70
00:04:55,730 --> 00:04:57,080
!مت بسرعة

71
00:04:57,080 --> 00:04:59,010
!مت مثل الكلب

72
00:05:02,850 --> 00:05:04,640
!لا تستخفي بي

73
00:05:08,690 --> 00:05:10,020
!أنت مكشوف

74
00:05:17,430 --> 00:05:19,490
...تنسيق رائع، لكن للأسف

75
00:05:31,170 --> 00:05:32,050
!الآن

76
00:05:36,470 --> 00:05:38,630
تستطيع استخدام التعويذات العليا أيضًا؟

77
00:05:45,400 --> 00:05:47,890
.طلبت منكن بلطف أن تحتمين

78
00:05:48,360 --> 00:05:49,960
.أنتن شقيّات

79
00:05:49,960 --> 00:05:52,770
.لكننا كنا قلقات عليك يا سيدي

80
00:05:54,440 --> 00:05:57,110
!لينستر! هاوارد

81
00:05:58,100 --> 00:05:58,790
!ماذا؟

82
00:05:58,790 --> 00:06:00,030
!أستاذ

83
00:06:01,620 --> 00:06:03,410
!تراجعن

84
00:06:04,500 --> 00:06:07,960
!سأقتلكم جميعًا

85
00:06:10,040 --> 00:06:11,420
!ليني

86
00:06:13,750 --> 00:06:15,170
!أخي

87
00:06:16,550 --> 00:06:17,720
!أيّها الأحمق

88
00:06:17,720 --> 00:06:20,130
!مت

89
00:06:32,310 --> 00:06:33,490
.ليديا

90
00:06:33,490 --> 00:06:35,570
!قاتل بجديّة

91
00:06:35,570 --> 00:06:37,280
.ما بيدي حيلة

92
00:06:37,280 --> 00:06:40,450
.أحتاج شهادته قبل أن يموت

93
00:06:40,450 --> 00:06:43,030
.ثم إنني أعلم أنكِ قادمة

94
00:06:43,030 --> 00:06:44,200
.لا بأس إذًا

95
00:06:44,680 --> 00:06:48,930
.أنا إلى جانبك، وأنت إلى جانبي

96
00:06:48,930 --> 00:06:51,000
وما الطبيعي أكثر من ذلك؟

97
00:06:52,200 --> 00:06:53,920
.آسف. وشكرًا

98
00:06:53,920 --> 00:06:55,790
.لننهي هذا بسرعة

99
00:06:55,790 --> 00:06:56,340
.أجل

100
00:07:01,650 --> 00:07:04,760
!ليديا لينستر

101
00:07:07,380 --> 00:07:09,020
إذًا، ما هذا؟

102
00:07:09,020 --> 00:07:12,850
.أظن أن الخنجر بيده اليمنى أفسد عقله

103
00:07:12,850 --> 00:07:15,200
.أشعر بطاقة مانا هائلة

104
00:07:17,080 --> 00:07:19,410
لِمَ لا أقطّعه وأنهي الأمر؟

105
00:07:19,410 --> 00:07:20,970
.أخبرتك من قبل، لا

106
00:07:20,970 --> 00:07:21,700
.مُفسد للمتعة

107
00:07:22,600 --> 00:07:24,120
.سأحرقه إذًا

108
00:07:28,880 --> 00:07:30,410
.تفعل هذا فجأة

109
00:07:30,410 --> 00:07:31,950
هل انتهى الأمر؟

110
00:07:31,950 --> 00:07:34,980
.ليته بذل قليلًا من الجهد
.أريد أن أطلق المزيد من التعويذات

111
00:07:40,150 --> 00:07:46,490
الموت قليل على من يحاول
،إيذاء أختي وصديقاتها في المدرسة

112
00:07:46,490 --> 00:07:48,350
.وخادمي الشخصي

113
00:07:48,970 --> 00:07:50,520
...ليديا

114
00:07:50,520 --> 00:07:52,540
.هكذا ينبغي أن يكون الأمر

115
00:07:52,540 --> 00:07:54,200
.سنسير على المعتاد

116
00:07:54,200 --> 00:07:56,940
.أمرك… ركّزي أنتِ على القطع

117
00:07:56,940 --> 00:07:58,150
!لا داعي لأن تخبرني بذلك

118
00:07:58,150 --> 00:08:00,270
!ليديا

119
00:08:00,860 --> 00:08:01,780
!سأدعمك

120
00:08:03,560 --> 00:08:04,070
!ليديا

121
00:08:20,770 --> 00:08:21,770
ما رأيك؟

122
00:08:22,710 --> 00:08:24,510
.مزعج قليلًا

123
00:08:24,510 --> 00:08:27,200
،إبقاؤه حيًّا سيكون صعبًا

124
00:08:27,200 --> 00:08:29,640
.وأشعر أنه خالد ما دامت طاقته السحرية متدفقة

125
00:08:29,640 --> 00:08:32,050
.التفكير عملك

126
00:08:32,050 --> 00:08:33,560
.أنا أقطع فحسب

127
00:08:34,020 --> 00:08:35,980
ما ذلك الخنجر؟

128
00:08:36,280 --> 00:08:37,950
!اسمح لي بأن أشرح

129
00:08:38,700 --> 00:08:39,800
!المدير

130
00:08:39,800 --> 00:08:41,220
!الإلف اللعين

131
00:08:42,190 --> 00:08:45,510
.لعلّي يجب أن أراجع تصميم هذه الساحة

132
00:08:45,510 --> 00:08:46,890
.آسفون

133
00:08:46,890 --> 00:08:48,240
.إنها هشة جدًا

134
00:08:48,920 --> 00:08:51,080
.لا تخبروا شيئًا عن هذا لأحد

135
00:08:51,080 --> 00:08:56,170
ذلك الخنجر مشبع بآثار تعويذة
.عظمى مفقودة: الدرع المضيء

136
00:08:57,000 --> 00:08:58,930
،إن كان حامله قليل المهارة

137
00:08:58,930 --> 00:09:02,590
.فالطاقة السحرية تلتهمه وتحوله إلى وحش مترنح

138
00:09:03,590 --> 00:09:07,310
،كانت العائلة الملكية تحتفظ به كنزًا لها

139
00:09:07,310 --> 00:09:11,270
.لكنني كنت ألاحقه منذ سُرق الليلة الماضية

140
00:09:11,270 --> 00:09:12,560
وكيف نهزمه؟

141
00:09:13,210 --> 00:09:15,940
.إنه خالد ما دامت طاقته السحرية موجودة

142
00:09:15,940 --> 00:09:17,830
.ورغم أنها مجرد بقايا، فهي ما تزال تعويذة عظمى

143
00:09:18,450 --> 00:09:21,090
،يمكنكم اعتباره يملك طاقة سحرية لا تنفد

144
00:09:21,090 --> 00:09:23,820
.ويستطيع استهلاكها ليُعيد ترميم نفسه

145
00:09:24,140 --> 00:09:25,210
مما يعني؟

146
00:09:25,210 --> 00:09:28,420
.في هذه الظروف… لا سبيل

147
00:09:35,220 --> 00:09:36,960
!تغير مجددًا؟

148
00:09:36,960 --> 00:09:38,370
.كم هذا مقرف

149
00:09:38,770 --> 00:09:40,310
.صار أكبر

150
00:09:40,310 --> 00:09:41,980
...حسنًا، في الوقت الراهن

151
00:09:41,980 --> 00:09:42,880
!لنضربه بسرعة

152
00:09:54,200 --> 00:09:56,480
.صار أقوى كما ترين

153
00:09:56,480 --> 00:09:57,810
.كم هذا مزعج

154
00:09:58,340 --> 00:10:02,370
.إن قاتلت ليديا بجديّة، فسيهلك جيرارد

155
00:10:02,370 --> 00:10:04,720
.لكن لا يمكننا التراخي أيضًا

156
00:10:04,720 --> 00:10:07,740
.الهجمات الضعيفة ستزيده قوة

157
00:10:08,060 --> 00:10:09,300
...بهذه الحالة

158
00:10:09,730 --> 00:10:12,680
!أنت هناك! توقف عن الاسترخاء في الأعلى

159
00:10:12,680 --> 00:10:14,240
!انزل وقاتل

160
00:10:16,410 --> 00:10:17,460
!أيّها الإلف اللعين

161
00:10:17,460 --> 00:10:21,130
!سندبّر أمرًا ما، لذا أشغله

162
00:10:21,570 --> 00:10:25,550
.أنا شخص مهم للغاية لعلمك

163
00:10:38,200 --> 00:10:40,270
!تعالين إلى هنا أيّتها الصغيرة

164
00:10:40,600 --> 00:10:42,980
ماذا؟ صـ-صغيرة...؟

165
00:10:43,330 --> 00:10:45,710
...لديّ اسم، وهو تيـ

166
00:10:44,650 --> 00:10:47,280
!اسكتي وتعالي

167
00:10:47,280 --> 00:10:48,490
!فورًا

168
00:10:48,490 --> 00:10:50,400
...حـ-حسنًا

169
00:10:53,100 --> 00:10:55,730
.أود ألّا تشارك تينا إن أمكن

170
00:10:55,730 --> 00:10:57,620
.لا يمكن. لا توجد طريقة أخرى

171
00:10:58,600 --> 00:11:01,840
ربطت قواك السحريّة بها، أليس كذلك؟

172
00:11:02,310 --> 00:11:03,590
!أستاذ؟

173
00:11:03,590 --> 00:11:05,770
.لم يقل شيئًا

174
00:11:05,770 --> 00:11:07,540
.الأمر واضح

175
00:11:07,540 --> 00:11:09,450
،لا بدّ أنّه أخبرك

176
00:11:09,450 --> 00:11:11,270
.أنا مربوطة به أيضًا

177
00:11:11,270 --> 00:11:14,300
.لهذا أصبحت في إطلاق التعويذات

178
00:11:14,800 --> 00:11:16,580
.مثلك

179
00:11:16,580 --> 00:11:18,420
.ولهذا أريد أن أطلب منك شيئًا

180
00:11:18,420 --> 00:11:19,900
أنا؟

181
00:11:19,900 --> 00:11:23,880
اربطي طاقتك السحريّة به
.وأطلقي أقوى تعويذة جليديّة لديك

182
00:11:23,880 --> 00:11:25,350
...ماذا؟ لكن

183
00:11:26,420 --> 00:11:29,110
.اتركي الباقي لنا بعدها

184
00:11:29,110 --> 00:11:30,490
أفهمتِ؟

185
00:11:31,150 --> 00:11:32,680
أستاذ؟

186
00:11:32,680 --> 00:11:34,700
...قد لا يكون هذا سارًّا

187
00:11:34,700 --> 00:11:36,580
!لا، تفضل

188
00:11:37,070 --> 00:11:38,170
.شكرًا

189
00:11:48,330 --> 00:11:49,920
أأنت بخير؟

190
00:11:50,290 --> 00:11:53,190
.أشعر بقربك منّي

191
00:11:53,190 --> 00:11:55,300
.أنت دافئ للغاية

192
00:11:55,990 --> 00:11:57,970
!سأبذل جهدي

193
00:11:58,260 --> 00:12:00,000
.سأدعمك بكل ما أملك

194
00:12:00,000 --> 00:12:01,020
!نعم

195
00:12:10,970 --> 00:12:13,400
!إن كنتما ارتبطتما، فاستعدا بسرعة

196
00:12:13,400 --> 00:12:14,970
!حـ-حاضر

197
00:12:16,880 --> 00:12:18,780
.هيّا، بسرعة

198
00:12:19,150 --> 00:12:20,590
أأنت جادة؟

199
00:12:20,590 --> 00:12:22,130
.بالطبع

200
00:12:22,610 --> 00:12:24,580
...لا أشعر أنني مستعد

201
00:12:30,040 --> 00:12:33,570
!مهلًا! لم تفعل شيئًا كهذا معي

202
00:12:33,570 --> 00:12:34,630
!هذا غير عادل

203
00:12:34,980 --> 00:12:37,210
!أطالب بإعادة المحاولة

204
00:12:38,070 --> 00:12:40,970
.إن كان يزعجك، حاولي أن تتفوقي عليّ

205
00:12:41,740 --> 00:12:43,670
.ولكنّي لن أسمح بذلك

206
00:12:43,670 --> 00:12:45,140
،حسنًا، أنتما الاثنتان

207
00:12:45,500 --> 00:12:47,120
.ركّزا على المشكلة

208
00:12:47,120 --> 00:12:47,870
.تينا

209
00:12:47,870 --> 00:12:48,700
نعم؟

210
00:12:49,830 --> 00:12:51,320
أأنت مستعدة؟

211
00:12:51,610 --> 00:12:54,490
!نعم! أشعر أنّي أستطيع فعل أيّ شيء

212
00:12:55,380 --> 00:12:56,280
...ليديا

213
00:12:56,980 --> 00:12:59,020
إلى من تظن أنّك تتحدث؟

214
00:12:59,020 --> 00:13:00,660
.أسرع

215
00:13:09,000 --> 00:13:10,880
.مدير المدرسة! الآن

216
00:13:14,850 --> 00:13:16,680
!ليديا

217
00:13:16,680 --> 00:13:17,200
!تينا

218
00:13:17,200 --> 00:13:18,260
!حاضر

219
00:13:19,030 --> 00:13:21,300
.أفنِ المزيَّف

220
00:13:23,690 --> 00:13:25,320
!هذا الصوت

221
00:13:25,320 --> 00:13:26,790
أيّ صوت؟

222
00:13:27,520 --> 00:13:28,790
أستاذ؟

223
00:13:28,790 --> 00:13:31,200
.لا، لا شيء

224
00:13:31,200 --> 00:13:32,650
!هيّا، استعدا

225
00:13:34,720 --> 00:13:35,740
!عجبًا

226
00:13:36,720 --> 00:13:37,910
.مذهل

227
00:14:01,780 --> 00:14:03,760
!هاوارد

228
00:14:04,230 --> 00:14:05,720
!تينا! الآن

229
00:14:06,140 --> 00:14:06,810
!حاضر

230
00:14:07,360 --> 00:14:09,440
!آلين

231
00:14:22,200 --> 00:14:23,290
.ليديا

232
00:14:23,290 --> 00:14:24,510
الهدف؟

233
00:14:24,510 --> 00:14:25,660
.الخنجر نفسه

234
00:14:25,970 --> 00:14:27,010
.مفهوم

235
00:14:27,010 --> 00:14:29,370
.سأريك ما تستطيع سيدة السيف فعله

236
00:14:31,510 --> 00:14:36,670
!بوجودك بجانبي، لا شيء في هذا العالم أعجز عن قطعه

237
00:15:10,800 --> 00:15:12,140
!ما هذا؟

238
00:15:12,140 --> 00:15:14,630
.فن آل لينستر السري: السيف القرمزي

239
00:15:18,910 --> 00:15:20,820
نسخة مزيفة؟

240
00:15:21,340 --> 00:15:24,140
!ليديا لينستر

241
00:15:24,140 --> 00:15:26,810
!لا تذكر اسمي بخفة

242
00:15:26,810 --> 00:15:29,520
!أنا له وحده، لا لغيره

243
00:15:40,530 --> 00:15:42,820
!هذه... النهاية

244
00:16:03,480 --> 00:16:07,640
!لن تتقني أبدًا التعويذات العليا

245
00:16:07,640 --> 00:16:09,640
.عمل رائع

246
00:16:10,290 --> 00:16:11,560
.هذا بفضلك يا أستاذ

247
00:16:14,250 --> 00:16:15,270
!ستيلا؟

248
00:16:16,520 --> 00:16:19,100
إلى متى ستمسكان بيدي بعضكما؟

249
00:16:19,100 --> 00:16:20,650
...لـ-لا

250
00:16:21,090 --> 00:16:23,490
.آ-آسفة

251
00:16:25,490 --> 00:16:26,730
!أستاذ؟

252
00:16:26,730 --> 00:16:27,490
آلين؟

253
00:16:28,040 --> 00:16:29,120
!آلين

254
00:16:40,680 --> 00:16:43,130
.هذا ثمن ارتباطي بهما معًا

255
00:16:45,770 --> 00:16:47,390
.صباح الخير

256
00:16:47,800 --> 00:16:49,770
هل كنت تعرف أنك ستنتهي هكذا؟

257
00:16:50,610 --> 00:16:51,810
...حسنًا

258
00:16:52,320 --> 00:16:53,710
.أجبني

259
00:16:53,710 --> 00:16:55,810
.نعم، عرفت

260
00:16:57,670 --> 00:17:00,430
،لو علمت أنه سيعرضك للخطر

261
00:17:00,430 --> 00:17:02,540
...لأنهيت أمر ذلك الأمير الأحمق

262
00:17:07,720 --> 00:17:10,330
.لا تفكري بهذه الطريقة

263
00:17:11,640 --> 00:17:13,390
.إنه ينبض

264
00:17:13,880 --> 00:17:15,460
.أسمع صوته

265
00:17:15,910 --> 00:17:17,050
.صحيح

266
00:17:17,550 --> 00:17:18,790
.أنا حي

267
00:17:19,200 --> 00:17:20,920
أتظن أنك ستفلت من هذا؟

268
00:17:20,920 --> 00:17:24,380
.لا أنوي هذا. كان هذا أفضل خيار لدينا

269
00:17:25,150 --> 00:17:26,350
.كاذب

270
00:17:27,050 --> 00:17:30,340
:قلت من قبل وأعيدها

271
00:17:31,000 --> 00:17:32,960
.راضية بأن أكون سيفك أنت يا آلين

272
00:17:33,390 --> 00:17:36,600
وأنا أفضل أن تكوني الفتاة
اللطيفة التي تساير دعابتي

273
00:17:36,600 --> 00:17:40,110
.وتُطيل شعرها من أجلي

274
00:17:40,450 --> 00:17:44,090
!أ-أنت! قرأت أفكاري آنفًا، أليس كذلك؟

275
00:17:44,090 --> 00:17:45,490
!لا يصدّق

276
00:17:45,490 --> 00:17:48,790
.ما باليد حيلة، فقد ربطنا قوتنا السحريّة

277
00:17:48,790 --> 00:17:50,450
.تدفقت إليّ وحدها

278
00:17:50,450 --> 00:17:51,970
!لا تختلق الأعذار

279
00:17:51,970 --> 00:17:53,200
!أحمق! أحمق كبير

280
00:17:53,790 --> 00:17:58,870
...ومن أنت لتتكلم وأنت
وأنت قد قـ-قبّلت الصغيرة؟

281
00:17:58,870 --> 00:18:00,250
...ذ-ذلك

282
00:18:00,250 --> 00:18:02,630
.باغتتني فقط

283
00:18:02,630 --> 00:18:05,200
ولماذا لم تحاول حتى أن تتفاداها؟

284
00:18:05,200 --> 00:18:06,050
...حسنًا

285
00:18:06,650 --> 00:18:09,080
أخبريني، ماذا يقولان؟

286
00:18:09,080 --> 00:18:11,060
.لا أسمع شيئًا

287
00:18:11,060 --> 00:18:13,680
.أخفضا صوتكما

288
00:18:14,230 --> 00:18:16,100
ماذا تفعلن؟

289
00:18:19,800 --> 00:18:21,270
...أنتم

290
00:18:21,740 --> 00:18:25,100
.آسف، لم أقصد أن أفزعكما

291
00:18:25,100 --> 00:18:27,690
.أهلًا يا آلين. يبدو أنّك استيقظت

292
00:18:27,970 --> 00:18:31,620
بفضلكم. ماذا حدث بعدها؟

293
00:18:32,380 --> 00:18:34,230
.اعتُقل جيرارد

294
00:18:35,240 --> 00:18:37,800
.أما عقوبته فلم تُحدّد بعد

295
00:18:37,800 --> 00:18:39,140
وماذا عن كارين وصديقتها؟

296
00:18:39,140 --> 00:18:42,360
.قالت كارين إن عليك زيارتها عندما تتعافى

297
00:18:43,700 --> 00:18:45,120
.حسنًا

298
00:18:46,150 --> 00:18:51,640
الأمير الغبي واحد منكم، فماذا
تقولون عن الفوضى التي أحدثها؟

299
00:18:51,640 --> 00:18:55,720
!صـ-صحيح أننا لم نراقبه كما يجب

300
00:18:55,720 --> 00:18:59,940
لكن ما كان في ذلك الخنجر
...هو ما حوّل جيرارد إلى

301
00:19:03,100 --> 00:19:05,450
.عجبًا... المكان صاخب جدًا هنا

302
00:19:05,450 --> 00:19:06,940
!أمي

303
00:19:07,860 --> 00:19:09,700
.بوركت جهودك يا آلين

304
00:19:09,700 --> 00:19:11,270
أجسدك على ما يرام؟

305
00:19:11,270 --> 00:19:13,070
.نعم، بفضلكم

306
00:19:13,750 --> 00:19:18,020
أدركت الآن أنني كان عليّ أن أنتظر وصول
.المزيد من المساعدة من البروفيسور والبقية

307
00:19:18,660 --> 00:19:19,500
.سيدة ليسا

308
00:19:20,000 --> 00:19:21,670
ماذا يا آلين؟

309
00:19:22,440 --> 00:19:26,590
،أنا أتحمل مسؤولية في هذه القضية
.فقد استجلبت عداوة جيرارد

310
00:19:27,230 --> 00:19:30,200
.لست أهلًا للاستمرار كمعلم لليني

311
00:19:30,200 --> 00:19:34,630
ليني، هل ترغبين أن يواصل آلن تعليمك؟

312
00:19:34,630 --> 00:19:35,400
ماذا؟

313
00:19:36,650 --> 00:19:37,850
.أجيبي بسرعة

314
00:19:39,130 --> 00:19:40,770
!أوده أن يواصل

315
00:19:41,410 --> 00:19:43,160
.سمعتها يا آلين

316
00:19:43,160 --> 00:19:44,990
،سأخبرك ثانيةً

317
00:19:44,990 --> 00:19:47,070
.آل لينستر يقفون إلى جانبك

318
00:19:47,670 --> 00:19:51,990
.ووالداك يثقان بنا لنرعاك

319
00:19:53,510 --> 00:19:55,160
.شكرًا جزيلًا لك

320
00:20:16,840 --> 00:20:18,340
...أستاذ

321
00:20:18,340 --> 00:20:20,640
ماذا تفعلين في هذا الوقت؟

322
00:20:21,110 --> 00:20:22,930
.أتمشى فقط

323
00:20:23,490 --> 00:20:26,120
.حدائق آل لينستر جميلة جدًا

324
00:20:26,120 --> 00:20:28,320
.النباتات هنا تبدو سعيدة

325
00:20:28,720 --> 00:20:30,840
،إنّها جميلة في النهار أيضًا

326
00:20:30,840 --> 00:20:33,050
.لكن الليل يضفي جوًا خاصًا

327
00:20:33,610 --> 00:20:34,740
...أستاذ

328
00:20:35,830 --> 00:20:41,410
اليوم رأيت بوضوح أنني ما زلت
.بعيدة عن المستوى المطلوب

329
00:20:41,910 --> 00:20:43,580
.هذا غير صحيح

330
00:20:43,580 --> 00:20:46,340
.سحرك يتحسن باستمرار

331
00:20:46,340 --> 00:20:47,200
...يجدر بك أن تفخري

332
00:20:47,200 --> 00:20:49,380
!ليس هذا ما أعنيه

333
00:20:49,860 --> 00:20:52,550
...لأنّ... لأنّ... لأنّ

334
00:20:52,550 --> 00:20:56,380
!أنا لست مؤهلة لأقف إلى جانبك كما أنا الآن

335
00:20:56,380 --> 00:20:59,050
...الشخص الوحيد القادر على ذلك

336
00:21:02,490 --> 00:21:04,450
.هي ليديا

337
00:21:04,450 --> 00:21:08,770
.أما نحن... فنحن فقط نتبعك حيث تقودنا

338
00:21:09,640 --> 00:21:13,530
وعندما تسوء الأمور، من يقف إلى جانبك

339
00:21:14,170 --> 00:21:16,430
هي ليديا فحسب، صحيح؟

340
00:21:16,970 --> 00:21:17,940
...تينا

341
00:21:19,450 --> 00:21:22,660
.لا تقللي من شأن نفسك

342
00:21:22,660 --> 00:21:25,610
.ليديا هي سيدة السيف، فخر المملكة.

343
00:21:25,610 --> 00:21:29,400
.ولم تكن دائمًا كما هي اليوم

344
00:21:29,400 --> 00:21:32,130
.عليك متابعة نموك وتقدمك، خطوة بخطوة

345
00:21:33,060 --> 00:21:37,930
،قد أبدو طفلة في عينيك يا أستاذ

346
00:21:37,930 --> 00:21:41,790
.لكنني لن أبقى صغيرة إلى الأبد

347
00:21:43,170 --> 00:21:44,320
!أستاذ

348
00:21:45,100 --> 00:21:47,770
!سأكسب مكاني بجانبك

349
00:21:47,770 --> 00:21:53,690
،أقسم بذلك على والدتي الراحلة، روزا هاوارد
!وعلى العصا والشريط اللذين تركتهما لي

350
00:21:55,000 --> 00:21:59,720
.لذا... أرجوك، راقبني وأنا أحقق ذلك

351
00:21:59,720 --> 00:22:03,040
!واستمر في دعمي

352
00:22:03,490 --> 00:22:06,910
.سأفعل. وأنتظر اليوم الذي تفين فيه بهذا الوعد

353
00:22:09,080 --> 00:22:11,750
.حسنًا، علينا أن نرجع

354
00:22:12,400 --> 00:22:14,300
.ستصابين بالبرد

355
00:22:14,990 --> 00:22:16,810
.لنبذل جهدنا غدًا وكل يوم

356
00:22:17,660 --> 00:22:19,760
!أجل يا أستاذ