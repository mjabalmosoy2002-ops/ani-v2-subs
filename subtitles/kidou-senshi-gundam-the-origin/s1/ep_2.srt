1
00:00:10,730 --> 00:00:15,690
.كان الوقت الذي سَعت فيه البشريِّة للفضاء بحثًا عن أراضٍ جديدة

2
00:00:16,070 --> 00:00:19,410
."سُمّيَ ذلك الوقت بـ"القرن العالمي

3
00:00:20,830 --> 00:00:23,910
عَهدت البشريِّة بِمُستقبلها

4
00:00:24,040 --> 00:00:27,500
.لِمُستعمرات الفضاء الضخمة حول الأرض

5
00:00:27,920 --> 00:00:28,920
،لكن

6
00:00:29,040 --> 00:00:33,750
.هذا الوطن الثاني لم يَكُنْ نَعيمَهُم الموعود

7
00:00:34,220 --> 00:00:37,760
القرن العالمي 0057

8
00:00:38,760 --> 00:00:41,760
،في الجانب الثالث، المجموعة الأبعد إلى الأرض

9
00:00:41,850 --> 00:00:44,850
ظهر قائد دعى لاستقلال مُستعمري الفضاء

10
00:00:44,930 --> 00:00:48,060
.ولإعادة تَشكيل الجِنس البشري

11
00:00:48,640 --> 00:00:51,860
.اسم ذلك الرجُل كان زيون زوم دايكون

12
00:00:52,150 --> 00:00:55,110
بدا وكأن تاريخ الأرض

13
00:00:55,150 --> 00:00:57,950
.سَيَتقدّم أكثر تحت قيادَته

14
00:01:01,490 --> 00:01:04,870
لكنّهُ كان مُجرّد بداية دَرب مليئ بالشوك

15
00:01:04,950 --> 00:01:07,120
سَيَقود لِحربٍ مأساويِّة

16
00:01:07,160 --> 00:01:10,790
.بِنطاقٍ لم يُرى في تاريخ البشرية كاملاً

17
00:01:13,040 --> 00:01:17,970
عِند الجانب الثالث، والمعروف أيضًا بِمونزو، أسس
دايكون حكومة مُستقلّة

18
00:01:18,090 --> 00:01:22,470
.ونال حُكمًا مُستقلّا عن حكومة الإتحاد الأرضي

19
00:01:23,850 --> 00:01:27,060
.لكن دايكون صارع لِيُوسّع مِن ذلك الإستقلال

20
00:01:27,140 --> 00:01:29,810
.لِتَحقيق الإستقلال الكامل

21
00:01:29,890 --> 00:01:35,110
.قابل بِذلك حالة رفض مِن قوّات إتحاد الأرض

22
00:01:37,150 --> 00:01:40,150
.القرن العالمي 0068

23
00:01:41,030 --> 00:01:45,780
في ذلك اليوم، وقف دايكون أمام المجلس
.التشريعي لِمونزو لِيُقدّم خطابًا تاريخيًّا

24
00:01:46,450 --> 00:01:50,830
كان سَيَطلُب انسحاب حامية قوّات الاتّحاد الأرضيِّة مِن مونزو

25
00:01:50,960 --> 00:01:54,590
.ويُصدر إعلانًا للاستقلال الفِعلي

26
00:01:56,840 --> 00:01:58,170
...لكن

27
00:02:02,590 --> 00:02:06,010
.ما إن بدأ دايكون بِخطابه، انهار

28
00:02:06,810 --> 00:02:10,020
.أدّى موت دايكون المُفاجئ إلى الهياج

29
00:02:10,180 --> 00:02:12,140
.الاستقلال

30
00:02:12,190 --> 00:02:15,520
،يَعتقد العامّة أن الاتحاد قد اغتالوه

31
00:02:15,650 --> 00:02:17,150
.وثاروا

32
00:02:19,740 --> 00:02:22,530
،وحتّى بَين مَن كانوا يَعملون معه

33
00:02:22,610 --> 00:02:25,870
.بدأوا الاقتتال فيما بَينَهُم

34
00:02:27,120 --> 00:02:32,040
،ديغوين زابي، أحد مُناصروا دايكون القُدماء، والمعروف كَيده اليُمنى

35
00:02:32,210 --> 00:02:34,670
.لم يَدع هذه الفُرصة  تفوته

36
00:02:38,380 --> 00:02:40,130
من فعل هذا؟

37
00:02:41,920 --> 00:02:43,800
،عندما أخذت عائلة هال والتي هيَ مُنافسة لهم

38
00:02:43,880 --> 00:02:46,890
.عائلة دايكون التي تَركها

39
00:02:47,010 --> 00:02:49,720
،قامت زابي وزُمَرَهُم بِتَدميرهم

40
00:02:49,930 --> 00:02:54,350
.سَيطروا على القوّة في مونزو لِنَيل مقاصدهم

41
00:02:56,980 --> 00:03:00,570
.تَم وضع زوجة دايكون تَحت الحَجز القسري

42
00:03:05,860 --> 00:03:09,580
،لكن طفلاها، كاسفال وآرتسيا

43
00:03:10,080 --> 00:03:15,040
هربا تقريبًا إلى الأرض بِمُساعدة كابتن رامبا رال

44
00:03:15,080 --> 00:03:17,670
مِن قوّة الدفاع وكراولي هامون

45
00:03:17,750 --> 00:03:20,920
.مع رئيس عائلة رال، جيما رال

46
00:03:26,180 --> 00:03:29,930
.عدوّي، عدوّك، عدو أُمّنا، عدو الجَميع

47
00:03:30,850 --> 00:03:32,350
.سَأقضي علَيهم جميعًا

48
00:03:38,860 --> 00:03:41,940
واجه الطفلان الصَغيران

49
00:03:42,110 --> 00:03:45,610
.عالمًا واسعًا لم يَعهداه وكذلك قسوة القدر

50
00:03:48,200 --> 00:03:50,870
،وأن القدر سَيُغيّر كِلاهُما

51
00:03:50,950 --> 00:03:56,750
.وخصوصًا كاسفال الذي عَرِف بِصراع البالغين المُظلم

52
00:04:04,800 --> 00:04:07,220
.وقد يُحوّله لِلمُذنّب الأحمر

53
00:04:07,300 --> 00:04:10,100
.تشار آزنابيل

54
00:04:22,570 --> 00:04:26,870
القرن العالمي 0071

55
00:04:27,910 --> 00:04:37,790
.إسبانيا، الأندُلس

56
00:04:31,510 --> 00:04:33,840
هل أنتِ من هذا المكان، أيتها الشابة؟

57
00:04:34,560 --> 00:04:38,670
.أنت في العاشرة مِن عُمُرك؟ ما كُنت لِأحزر ذلك

58
00:04:40,130 --> 00:04:42,090
.أنتِ بالغة بالنسبةِ لِفتاة في العاشرة

59
00:04:42,170 --> 00:04:43,920
.لقد ساعدتِنا كثيرًا

60
00:04:44,000 --> 00:04:46,800
.أُراهن على أنَّكَ سَتَنضُجين لِتَكوني طبيبة عظيمة

61
00:04:46,840 --> 00:04:48,840
أتَعيشين هُنا؟

62
00:04:48,880 --> 00:04:50,930
!مُفاجئ

63
00:04:51,640 --> 00:04:54,010
.هذا يَجعل مِنكِ أميرة

64
00:05:10,740 --> 00:05:13,830
هل تَعتقدين أن عَدد اللاجئين سَيزداد؟

65
00:05:14,080 --> 00:05:17,330
.تَدفّقهم لا يُظهر أي دلالة على توقّف الأمر في الوقت القريب

66
00:05:17,910 --> 00:05:21,040
.ابتلعت الرمال الجزائر ومراكش

67
00:05:21,710 --> 00:05:25,130
.وشمال أفريقيا لم تَعُد صالحة لِعَيش البشر

68
00:05:25,960 --> 00:05:30,720
.نَحتاج لِسياسات جذريِّة لِمُعالجة التَغيّرات المُناخيِّة

69
00:05:35,390 --> 00:05:38,810
.أبي. لقد عُدت

70
00:05:38,930 --> 00:05:40,730
.عُذرًا منكِ، سيلا-ساما

71
00:05:40,810 --> 00:05:43,810
.يَجب أن تُطهّري نفسك من العدوى بعد عودتك مِن المُخيَّم فورًا

72
00:05:44,150 --> 00:05:46,230
هل تِلك هيَ الفتاة التي سَمَعتُ بِها؟

73
00:05:46,320 --> 00:05:47,400
.أجل

74
00:05:47,690 --> 00:05:50,070
-مِمّا تَمكّنت من رؤيَته

75
00:05:50,400 --> 00:05:52,740
يُمكننا أن نَكون أبًا وابنة؟

76
00:05:52,870 --> 00:05:56,240
.لِأكون صريحًا، لم أكُنْ مُتحمّسًا للفكرة أولاً

77
00:05:56,370 --> 00:05:58,750
،حتّى لو كان الأمر مِن أجل صديقٍ قديمٍ لي

78
00:05:58,830 --> 00:06:01,040
كان سَيَكون في الأمر مُخاطرة لِجرّي

79
00:06:01,080 --> 00:06:04,250
.في صراعٍ سياسي في المُستعمرات الفضائيِّة

80
00:06:04,880 --> 00:06:07,340
.لكنَّني فهمت لِأوّل مرّة

81
00:06:07,420 --> 00:06:09,840
.عَرفت لِمَ العوائل تَجعل الناس سُعداء

82
00:06:10,300 --> 00:06:12,550
ألَن تَأخُذي حمّامًا؟

83
00:06:12,760 --> 00:06:15,100
.لا أُريد. سَأسبح في البركة

84
00:06:15,760 --> 00:06:16,930
!سيلا-ساما

85
00:06:23,150 --> 00:06:26,770
.كاسفال-ساما. رَكِّز

86
00:06:27,900 --> 00:06:30,110
.هذا هو الجُزء الأهم

87
00:06:30,150 --> 00:06:33,570
عندها أدرك الواجب التاريخي لِمُستعمري الفضاء

88
00:06:33,780 --> 00:06:36,240
،ودوّن إصلاح البشريِّة كَآيدلوجيِّة

89
00:06:36,990 --> 00:06:40,790
"عندما وصل لِمفهوم الـ"نيوتايب

90
00:06:40,910 --> 00:06:44,080
.في كُل عَهد، كان الرُسل شخصيّات مُنعزلة

91
00:06:44,790 --> 00:06:49,050
...حتّى آيدلوجيِّة دايكون لم تَكُنْ مقبولة مِن قِبَلِ الجموع أولاً، وكذلك

92
00:06:50,800 --> 00:06:53,800
هل تَستمع لي، كاسفال-ساما؟

93
00:06:54,470 --> 00:06:55,890
.أجل

94
00:06:56,510 --> 00:06:58,310
.إن كُنت تقول ذلك

95
00:07:02,770 --> 00:07:04,810
عندها قصدت البشريِّة الفضاء

96
00:07:04,940 --> 00:07:08,320
وكان بِمقدورها أن تَنظُر للأرض كَكائنٍ حي

97
00:07:08,400 --> 00:07:11,280
وقت التطوّر قد حَل علَينا

98
00:07:11,820 --> 00:07:16,320
النيوتايبز الذين لَن يَتجاوزوا التواصل الناقص

99
00:07:16,450 --> 00:07:20,990
ويُحققوا التفاهم المُشترك الحقيقي فقط، بل وكذلك

100
00:07:21,040 --> 00:07:24,160
...الاحتمالات الجسديِّة الجديدة، والتي سَتَكون في هذا العالم لـ

101
00:07:27,330 --> 00:07:29,590
ما خطبي؟

102
00:07:29,960 --> 00:07:33,630
.أنا شاكرةٌ لك تَبرُّعك بالأرض أيُّها الدون تيابولو

103
00:07:33,880 --> 00:07:38,350
.لا تَشكُريني. إنَّهُ لشرف لي أن أكون في الخدمة، أيَّتُها المفوّضة العُليا

104
00:07:38,970 --> 00:07:43,430
.أطلُب مِنكِ أن تُراقبي بِحذر أمن الناس وسلامَتَهُم

105
00:07:51,360 --> 00:07:52,990
.والذي يَحضِرُنا لِهذا الوقت

106
00:07:53,190 --> 00:07:57,360
."تُحاول مونزو أن تَكون "زيون

107
00:07:58,030 --> 00:08:02,870
.مِن قِبَلِ أولئك الزابي الخنازير، وكذلك الذين قتلوا زيون دايكون

108
00:08:03,250 --> 00:08:06,870
.كان واضحًا أن ما قتل والدك هو السُمْ

109
00:08:07,420 --> 00:08:10,880
أعطوه على مر الزمن نوع ما مِن السموم

110
00:08:11,000 --> 00:08:12,880
-لِيُضعفوا قلبه، وكذلك

111
00:08:20,260 --> 00:08:22,140
كلام السُم هذا مُجددًا؟

112
00:08:24,140 --> 00:08:26,350
...أخي، أشعرُ بـ

113
00:08:28,060 --> 00:08:29,230
أتشعُرين بالمرض؟

114
00:08:33,070 --> 00:08:36,070
.أنتِ مُصابة بالمُحمّى. رُبما أُصبتِ بنزلة برد

115
00:08:36,190 --> 00:08:38,910
.يَجدُر بِكِ أن تَأخُذي دواءًا وتستريحي في فراشك

116
00:08:39,450 --> 00:08:42,240
.كاسفال-ساما. هُناك المَزيد

117
00:08:42,410 --> 00:08:46,540
.اسم أخي إيدوارد الآن. واسمي سيلا ماس

118
00:08:48,420 --> 00:08:52,920
،رؤيَّة الأطفال يَكبرون نِعمة

119
00:08:52,960 --> 00:08:55,420
لكن في نفس الوقت... ما الأمر؟

120
00:08:56,090 --> 00:08:58,430
.وصل زائِرُك

121
00:08:59,260 --> 00:09:00,550
وصل؟

122
00:09:16,530 --> 00:09:19,070
.لن أغفر لك تصرّفك الفردي هذا

123
00:09:19,110 --> 00:09:22,410
.أتقول مسؤول مِن الرعاية الاجتماعيِّة؟ لا تَكذب

124
00:09:22,490 --> 00:09:25,410
!كان ذلك تشيلسي، نائب الرئيس التنفيذي لِآناهايم

125
00:09:25,450 --> 00:09:28,080
.كان مُنافسي في العمل

126
00:09:28,500 --> 00:09:30,960
.كُنت لِأعرف ذلك الوجه في أيِ مكان

127
00:09:31,580 --> 00:09:33,380
على كُل حال، لِنحظى

128
00:09:33,460 --> 00:09:35,630
.بِمُحادثة، طويلة لطيفة في مكتبي

129
00:09:40,470 --> 00:09:44,300
إبدأ بالكلام. ما الذي كُنتَ تُناقشه معه؟

130
00:09:45,140 --> 00:09:46,470
.سامحني

131
00:09:46,930 --> 00:09:50,480
دَعني أحزر، كُنت تُخطط لِهجوم مُسلّح على الجانب الثالث؟

132
00:09:50,520 --> 00:09:53,150
كَيف تجرؤ على القيام بشَيء كهذا دون أن تُعلمني أولاً؟

133
00:09:53,190 --> 00:09:56,480
.لن أغفر ذلك.  لا أمل في نجاح الأمر أبدًا

134
00:09:57,070 --> 00:10:01,070
.لن نَعلم ما لم نُحاول

135
00:10:01,530 --> 00:10:05,240
.قال آناهايم بأنَّهُم سوف يَعطوني العتاد الكامل

136
00:10:05,330 --> 00:10:07,120
.أسلحة، تمويل

137
00:10:07,160 --> 00:10:11,790
.وكذلك قالوا سَنَضغط على مسؤولي الاتحاد

138
00:10:12,330 --> 00:10:15,130
بعد كُل ذلك، أمازِلتَ تقول بأنَّنا لن نَنجح؟

139
00:10:15,210 --> 00:10:17,000
...بالإضافة لِذلك، إلى جانبنا

140
00:10:17,670 --> 00:10:20,340
إلى جانبك؟

141
00:10:20,420 --> 00:10:23,760
...إلى جانبنا

142
00:10:24,550 --> 00:10:27,350
.الطفلان الذان تركهما دايكون خلفه

143
00:10:27,470 --> 00:10:31,020
.أليس مثاليًا؟ سَنَتمكّن مِن الإطاحة بِزابي

144
00:10:31,640 --> 00:10:34,810
.أساس قوّة عائلة زابي هش

145
00:10:35,020 --> 00:10:38,690
.وعلى العكس تمامًا، تَأثير عائلة دايكون كَبير

146
00:10:39,320 --> 00:10:43,320
،عندما يَرَون كَيف نَضج كاسفال وآرتسيا

147
00:10:43,360 --> 00:10:46,120
.سَيَأتي الناس إلى جانبنا

148
00:10:46,580 --> 00:10:49,700
.إيدوارد وسيلا هُما طفلَيَّ

149
00:10:50,370 --> 00:10:52,830
.قُلت بأنَّهما لن يَنجوا مِن كونَهُما طِفلَي دايكون

150
00:10:53,040 --> 00:10:55,500
.لِهذا سَجّلتَهُما كَفردان مِن عائلة ماس

151
00:10:55,710 --> 00:10:59,550
.أنت تَدرُك طبعًا أن ذلك كان مُجرّد إجراء مؤقت

152
00:11:00,210 --> 00:11:04,130
.لن أسمح بِذلك. لن أدَعك تَحظى بِهُما لِنفسك

153
00:11:04,220 --> 00:11:09,140
.أهكذا تَشعُر حيال الأمر، غادر وقُم بالتَخطيط في مكانٍ آخر

154
00:11:10,270 --> 00:11:15,730
،إن كُنتَ عازمًا بِهذا الشكل، وكانا موافقَين على الأمر

155
00:11:16,020 --> 00:11:19,070
سَأتخلّى عن حقوق الأبويِّة

156
00:11:19,150 --> 00:11:22,240
.وأدَّعي أن الأعوام الثلاثة الماضية لم تَحدُث

157
00:11:22,650 --> 00:11:24,570
.لا شَيء يُذكر حيال الأمر

158
00:11:24,700 --> 00:11:31,080
.لَيس بالمقارنة مع قرارهما بالمخاطرة بِحياتَهُما في قتال كهذه

159
00:11:33,460 --> 00:11:35,580
...لا تَقُل ذلك

160
00:11:35,620 --> 00:11:38,210
.لا تَقُل مِثل هذا الكلام

161
00:11:38,250 --> 00:11:42,090
.أنت الوحيد الذي يُمكننا الاعتماد علَيه

162
00:11:42,170 --> 00:11:43,670
.لا أعرف ما الذي دهاني

163
00:11:43,760 --> 00:11:47,340
،مع وجود شركة كَبيرة مِثل آناهايم

164
00:11:47,430 --> 00:11:49,600
.ظَننت بأنَّ لدَينا فُرصة

165
00:11:54,430 --> 00:11:58,610
