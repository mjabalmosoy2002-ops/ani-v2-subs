1
00:00:07,980 --> 00:00:11,490
0079 الثالث والعشرون مِن يناير، القرن العالمي

2
00:00:11,520 --> 00:00:14,520
".رسالة مِن أسطول تيانيم. "أسطول زيون لَيس نِدًّا لنا

3
00:00:14,560 --> 00:00:17,360
.يَخرُج العدو عن التَشكيلة -
.أسطول الطليعة قد تَدمّر -

4
00:00:15,990 --> 00:00:18,780
قطاع لوم، أسطول تيانيم

5
00:00:17,360 --> 00:00:20,600
.لا تَهلعوا. تَفرّقوا وغَيّروا وجهتكم بَينا تُطلقون النار

6
00:00:20,700 --> 00:00:22,700
.تَضرّرت كيل أَيضًا -
.جميع مدافع الأطلاق قد انتهى أمرها -

7
00:00:22,800 --> 00:00:23,870
.قسم المُحرّك الأَيمن قد تَضرر

8
00:00:23,970 --> 00:00:26,500
.ضعنا أمام الفالكيري -
.لقد تَضررت ريدفيزان بِشدّة -

9
00:00:26,600 --> 00:00:30,170
.أدميرال دوزل. خسرت سَفينَتي. حظٌ موفق لك

10
00:00:30,340 --> 00:00:32,880
.أوّو جيما قد تَدمّرت -
.تَعطّلت مُحرّكات زايتوبك -

11
00:00:32,910 --> 00:00:36,080
.أدميرال دوزل. صَيدٌ موفّق سيّدي

12
00:00:36,880 --> 00:00:38,310
.تَحيا زيون

13
00:00:38,410 --> 00:00:42,090
.لن أدَع موتَكُم يَكون هباءً

14
00:00:44,120 --> 00:00:47,120
.لا تَدعوا النضال الباسل لِسُفن الحماية الخلفيِّة يَذهب هباءً

15
00:00:47,160 --> 00:00:51,090
.انتشروا ثُم التفّوا بِسُرعة

16
00:00:51,560 --> 00:00:53,500
.هذا نصرٌ مُدوّي لأسطول تيانيم

17
00:00:53,560 --> 00:00:56,200
.على هذا المُعدّل، لن يَكون لنا شَيء لِنفعله

18
00:00:56,430 --> 00:00:58,130
...إنَّهُم مُجرّد زيون

19
00:01:01,400 --> 00:01:03,610
.أُصيب قِسم المُحرّك -
ضررٌ جَسيم في مُفاعل الطاقة -

20
00:01:05,740 --> 00:01:08,310
.تَم رَصد أضواء بإتجاه الساعة الـ3 على بُعد 8كم

21
00:01:08,380 --> 00:01:09,710
.لا أثر لِمركبات العدو

22
00:01:09,910 --> 00:01:11,750
.إنَّها مركبة مُتنقّلة التي تُهاجم

23
00:01:11,980 --> 00:01:13,420
.إلى الجانب الأَيمن، أطلقوا وابلاً مِن النار

24
00:01:13,820 --> 00:01:16,550
.دينيم، استَخدم هذه النيران مِن خَلف العدو

25
00:01:16,650 --> 00:01:18,520
.سليندر، احمِ دينيم

26
00:01:18,550 --> 00:01:19,220
.حاضر

27
00:01:19,360 --> 00:01:21,520
...لكن أيُّها المُلازم، إن أصبحت وحيدًا

28
00:01:21,590 --> 00:01:23,460
.واحدٌ فقط يَكفي كَتمويه

29
00:01:29,570 --> 00:01:32,370
.سَريعةٌ للغاية. لا يُمكنني التَهديف علَيها

30
00:01:32,470 --> 00:01:34,200
.إلى جَميع العاملين، اتركوا المركبة

31
00:01:37,140 --> 00:01:39,580
هل يُمكنني النَيل مِن اثنَين آخرَيين؟

32
00:01:43,180 --> 00:01:46,850
.خمسة سُفن مِن صنف ماجلان قَد دُمِّرت. العدو مُقاتلة حمّراء واحدة

33
00:01:47,280 --> 00:01:50,620
مصادر حرارة مُتعدّدة تَقترب مِن الأسفل. مُقاتلات؟

34
00:01:56,790 --> 00:01:59,500
.نَشتبك مع العدو. إلى جَميع العاملين، ضعوا البِذل العاديِّة

35
00:01:59,600 --> 00:02:01,060
.أطلقوا المُهاجمين

36
00:02:03,700 --> 00:02:04,700
كان ذلك سريعًا. من ذاك؟

37
00:02:04,770 --> 00:02:07,300
.لم أتَمكّن من رؤيَتَها -
.مُقاتلة حمراء تَعني أنَّهُ المُلازم تشار -

38
00:02:15,910 --> 00:02:17,610
أنانكي إذن؟

39
00:02:17,910 --> 00:02:19,480
هذه مركبة ريفل، ألَست كذلك؟

40
00:02:24,690 --> 00:02:27,020
.سَأُنهي أمرها

41
00:02:28,220 --> 00:02:30,530
.جَميع مِنصّات إطلاق النار قد دُمِّرت -
.إلى جَميع العاملين، اتركوا المركبة في الحال -

42
00:02:31,930 --> 00:02:34,660
...ذلك الوغد سَريع -
أتَعني تشار؟ -

43
00:02:34,860 --> 00:02:39,070
.تِلك ثلاثة أضعاف السُرعة الطَبيعيِّة... إنَّهُ مُذنّبٌ أحمرٌ حقيقي

44
00:02:48,340 --> 00:02:49,850
.بَقيَّتْ قذيفة واحدة فقط

45
00:03:23,750 --> 00:03:25,550
.انتهى الأمر على الأقل

46
00:03:25,780 --> 00:03:28,580
.مسودّة خطابي لِيوم الغد قد انتهت

47
00:03:28,680 --> 00:03:31,120
.ألقي نظرة علَيها وأخبرني بِرأيكِ، أسترايا. هيّا

48
00:03:31,250 --> 00:03:33,460
.أنت تَصرخ يا عزيزي

49
00:03:33,660 --> 00:03:35,890
.سَتوقظ الأطفال

50
00:03:37,090 --> 00:03:39,500
.خطأ

51
00:03:41,760 --> 00:03:43,370
...كُل هذا خطأ

52
00:03:43,800 --> 00:03:48,870
.إنَّهُ مُجرّد طلب لِمَزيدٍ مِن الاستقلال لا أكثر. لَيس هذا ما أُريد قوله

53
00:03:48,870 --> 00:03:53,210
.هذا الخطاب سَيَكون إعلانًا للحرب على كُل من يَعيش على الأرض

54
00:03:53,340 --> 00:03:56,080
...لكن لا يُمكنني العثور على الكلمات المُناسبة

55
00:03:56,810 --> 00:04:00,880
أنت مُرهق. استرح لِبعض الوقت. حسنٌ؟

56
00:04:00,880 --> 00:04:03,320
-استلقِ قليلاً فقط، و

57
00:04:03,820 --> 00:04:06,120
أتُخبريني بِأن أنام؟

58
00:04:09,030 --> 00:04:13,730
إن نِمتُ كَيف سَيَكون بِمقدوري أن أثير تلامِذَتي؟

59
00:04:14,700 --> 00:04:20,740
.أستاريا، غدًا سَأُجر لِغولوغوثا لِيَتِم إعدامي

60
00:04:22,910 --> 00:04:26,380
.وسَأخاطب العالم مِن أعلى صليبي

61
00:04:26,940 --> 00:04:29,980
سَأُحذرهم بِإن أولئك الخطاة الذين يَحملون غضب غايا

62
00:04:30,150 --> 00:04:33,450
.سَيَشتعلون بِنيران الجحيم ويُبادون

63
00:04:33,620 --> 00:04:36,590
.أرح نفسك أرجوك. لِوقتٍ قصيرٍ فقط

64
00:04:38,920 --> 00:04:40,320
الأطفال؟

65
00:04:40,360 --> 00:04:43,660
.ناموا بِسُرعة، إنَّهُ منتصف الليل

66
00:04:44,460 --> 00:04:47,430
.لا. لا يَجدُر بِك هذا. لا تُزعج الأطفال

67
00:04:56,970 --> 00:04:59,640
من...؟ أبي؟

68
00:05:01,880 --> 00:05:05,210
.أنا نعسة جدًّا... لحيتك تُشعرني بالحكّة

69
00:05:05,820 --> 00:05:09,420
...عُمتَ مساءًا يا أبي

70
00:05:09,950 --> 00:05:12,890
...عُمتِ مساءًا، آرتسيا

71
00:05:13,420 --> 00:05:18,390
...أنتِ ابنتي اللطيفة. عُمتِ مساءًا. عُمتِ مساءًا

72
00:05:23,900 --> 00:05:27,870
كاسفال أزرق العَينان

73
00:05:33,930 --> 00:05:38,940
الجانب الثالث
الجمهوريِّة المُستقلّة لِمونزو

74
00:05:40,050 --> 00:05:43,850
.خطاب رئيس المجلس التَشريعي زيون زوم دايكون على وشك أن يبدأ

75
00:05:44,690 --> 00:05:48,860
هل سَيُعلن الاستقلال مِن الإتحاد؟

76
00:05:49,030 --> 00:05:50,690
.عيون العالم علَيه

77
00:05:50,690 --> 00:05:51,890
.توقّفوا مِن فضلكم

78
00:06:16,420 --> 00:06:18,420
هل أبي مريض؟

79
00:06:18,450 --> 00:06:22,560
.لا تَقلقي، آرتسيا. أنا مُتأكّد مِن أنَّهُ لا شَيء

80
00:06:24,730 --> 00:06:30,770
.دايكون. دايكون. دايكون

81
00:07:06,970 --> 00:07:10,710
.لا

82
00:07:10,870 --> 00:07:14,540
.دايكون. دايكون. دايكون

83
00:07:15,010 --> 00:07:18,010
.دعوا الرئيس يَخُرج -
ما الذي حَدث لِدايكون؟ -

84
00:07:18,180 --> 00:07:20,020
.لا تَقبلوا بِطُغيان الاتحاد

85
00:07:20,420 --> 00:07:23,120
هل تَعرفون كَم نُعاني؟

86
00:07:23,350 --> 00:07:25,120
.دعونا نَسمع خطاب الرئيس

87
00:07:25,220 --> 00:07:27,020
.الاستقلال

88
00:07:27,160 --> 00:07:31,330
.أُصيب الرئيس بِنوبة قلبيّة فجأة

89
00:07:31,360 --> 00:07:34,300
.لم يُفلح الإسعاف الأولي

90
00:07:35,000 --> 00:07:37,330
،قبل أن يَتوفّى، قال لي

91
00:07:37,400 --> 00:07:41,300
".أرجوك اعتني بأسترايا والأطفال"

92
00:07:41,740 --> 00:07:44,310
.تعالي إلَيَّ لو احتجتِ لِأيِ شيء

93
00:07:44,610 --> 00:07:48,780
،كرفيق دايكون الأقدم، أنا، ديغوين زابي

94
00:07:48,910 --> 00:07:51,550
.أَضع عائلتي كاملةً تحت تَصرُّفك

95
00:07:53,120 --> 00:07:58,020
.من المُريح سماع مِثل هذه الكلمات مِن زابي

96
00:07:59,060 --> 00:08:01,590
.تم اغتيال دايكون

97
00:08:03,190 --> 00:08:05,060
.تم قتله مِن قِبَلِ الإتحاد

98
00:08:05,430 --> 00:08:08,260
.الإتحاد هو عدو دايكون

99
00:08:29,850 --> 00:08:32,190
.قوّات الأمن التابعة لِلإتحاد قد تموضعت

100
00:08:32,260 --> 00:08:34,560
،الشوارع حول مبنى العاصمة مُكتظ بالمتظاهرين

101
00:08:34,620 --> 00:08:36,460
.ولا مجال لنا لِنُغادر

102
00:08:37,860 --> 00:08:41,430
أسترايّا-ساما، هل لي بِكلمةٍ معك؟

103
00:08:41,830 --> 00:08:44,300
.لا يَجدُر بكِ أن تثقي بِديغوين

104
00:08:44,370 --> 00:08:48,500
.قد يَكون أتباع زابي هُم وراء اغتيال دايكون

105
00:08:48,670 --> 00:08:50,270
.مُستَحيل

106
00:08:50,310 --> 00:08:53,380
.لا. أنا مُتأكّد من الأمر

107
00:08:53,380 --> 00:08:55,450
.المُتظاهرون يَقومون بالشغب في الخارج

108
00:08:55,480 --> 00:08:59,480
.لماذا؟ يُفترض بِموت دايكون أن يَكون سرًّا

109
00:09:00,080 --> 00:09:02,520
.سرّب شخصًا ما الأخبار

110
00:09:02,590 --> 00:09:06,120
.ابنهم الثاني، ساسرو، لابُد أن يَكون له يَد في الأمر، أُراهن على هذا

111
00:09:06,420 --> 00:09:10,090
.كان ديغوين يُحاول أن يُزيل دايكون من الطريق مُنذ زمن طويل

112
00:09:10,260 --> 00:09:12,230
.ولِهذا قام بِتَسميمه

113
00:09:12,530 --> 00:09:15,930
.رال-ساما، مِن فضلك، لَيس أمام الأطفال

114
00:09:16,100 --> 00:09:19,940
.لا. يَجب على الأطفال أن يَعلموا مِن بَين الجميع

115
00:09:20,700 --> 00:09:24,510
.اُغتيل والِدُكما مِن قبل شياطين زابي

116
00:09:26,710 --> 00:09:31,750
.يَجب أن نَتصرّف بقدر ما يُمكن من الحذر. أولاً، يَجدُر بنا أن نوصلك لِمنزلي

117
00:09:36,090 --> 00:09:37,820
.هذا هو ابني، رامبا رال

118
00:09:38,290 --> 00:09:42,430
.سَيَقود الطريق. اعتبريه كَحارسك الشخصي مِن فضلك

119
00:09:42,830 --> 00:09:44,690
سيّدتي، سَيَكون شرفًا لي

120
00:09:44,760 --> 00:09:47,560
.أن أكون في خدمة عائلة دايكون

121
00:10:08,080 --> 00:10:09,290
قِف

122
00:10:09,520 --> 00:10:12,260
.إخلاءٌ طارئ لِعائلة الرئيس

123
00:10:12,260 --> 00:10:13,860
.سَأعبر

124
00:10:20,330 --> 00:10:23,670
.انعطف لليسار تاليًا

125
00:10:29,270 --> 00:10:31,610
...كُل الطريق إلى هُنا أيضًا

126
00:10:33,910 --> 00:10:35,480
.لسنا خائفين -
تَظنّون أنفسكم مُهمّين؟ -

127
00:10:35,580 --> 00:10:36,710
.حاولوا فقط

128
00:10:39,620 --> 00:10:41,480
.أخلوا الطريق

129
00:10:41,520 --> 00:10:43,790
.ابتعدوا عن الطريق، سُحقًا

130
00:10:44,750 --> 00:10:46,720
.تَفقّدوا السيارة -
من فيها؟ -

131
00:10:47,360 --> 00:10:48,620
من هو؟ من هو؟

132
00:10:48,620 --> 00:10:50,890
!إنَّها عائلة دايكون

133
00:10:50,960 --> 00:10:51,960
.إنَّها أسترايّا

134
00:10:52,100 --> 00:10:54,200
.كاسفال وآرتيسيا كذلك

135
00:10:55,030 --> 00:10:58,370
.استمعوا لي، أعني ما أقول، سَأفتح النار علَيكم

136
00:11:03,340 --> 00:11:06,840
.تبدو في ورطة أيُّها الكابتن رامبا رال

137
00:11:07,840 --> 00:11:09,550
...كيسيليا زابي

138
00:11:09,850 --> 00:11:13,020
.هل لي أن أُقدّم المساعدة لك؟ لن تُدين لي بِشَيء

139
00:11:45,350 --> 00:11:47,050
أنتِ كيسيليا-سان، أليس كذلك؟

140
00:11:48,580 --> 00:11:50,790
أجل. هل الجميع بِخَير؟

141
00:11:50,950 --> 00:11:54,620
.أجل، شُكرًا لكِ. يا له مِن مظهر هذا التي تُظهريه

142
00:11:55,090 --> 00:11:58,560
بالنسبةِ  لِأمرأة"، هل هذا ما قصدتِ أن تقوليه؟"

143
00:11:58,590 --> 00:12:02,370
.إنها طريقة عائلة زابي. أضحكي إن كُنتِ تُريدين

144
00:12:05,270 --> 00:12:08,300
وعندها جعلتيهم يُفلتون مِن بَين أصابعك؟

145
00:12:08,600 --> 00:12:10,810
أجل. ظَننت أن الأمر سَيَكون طفولي

146
00:12:10,870 --> 00:12:13,510
.لو تشاجرت معه على أولئك الثلاثة

147
00:12:14,210 --> 00:12:18,080
.سَمحتِ له بِأخذ أيتام دايكون

148
00:12:19,420 --> 00:12:20,850
.حمقاء

149
00:12:25,320 --> 00:12:26,920
.ساسرو

150
00:12:27,090 --> 00:12:30,260
.لم يَكُنْ علَيك أن تَضربها -
.لا تَتفوّه بِكلمة -

151
00:12:30,830 --> 00:12:34,530
فقط عندما كان تلاعبي بالرأي العام قد بدأ بِجعل الجَميع يَعتقد

152
00:12:34,530 --> 00:12:37,330
.أن موت دايكون كان اغتيال مِن الإتحاد

153
00:12:37,830 --> 00:12:40,500
.وقعتِ في شباك ذلك الأحمق العجوز

154
00:12:41,340 --> 00:12:43,210
.إزالتهم هيَ خيارنا الوحيد

155
00:12:45,210 --> 00:12:48,240
.أنا أُشير للعجوز الخرف

156
00:12:48,610 --> 00:12:49,880
والمعنى؟

157
00:12:50,610 --> 00:12:54,280
.نُسدد الضربة القاضية لِعائلة رال. للأبد

158
00:13:26,650 --> 00:13:31,650
.زيون زوم دايكون، هو تَجسيد لِمبادئنا

159
00:13:31,650 --> 00:13:33,920
.وقائد لِمونزو المَجيدة

160
00:13:34,760 --> 00:13:36,960
،كَرئيسٍ للمجلس التشريعي لمونزو

161
00:13:37,290 --> 00:13:41,060
،كان رائدًا في تَحرير مُستعمري الفضاء

162
00:13:41,100 --> 00:13:43,500
،والآن، هو يَصعد للفُلك

163
00:13:43,670 --> 00:13:46,600
.ويُصبح الحجر الأساس لِتلك الفكرة

164
00:13:46,740 --> 00:13:53,680
.لِتَسترح روحه الآن ولِتَكُنْ ألهامًا لِلعدل

165
00:13:54,340 --> 00:13:57,680
.ولِتَعش مبادئه خالدة للأبد

166
00:13:58,080 --> 00:14:01,220
،رُغم أن جسده قد اختفى

167
00:14:01,350 --> 00:14:03,320
لِيُسلّط ضوئه

168
00:14:03,620 --> 00:14:06,960
على مسارنا لِيُرينا الطريق

169
00:14:07,160 --> 00:14:08,890
.تحيا زيون

170
00:14:32,580 --> 00:14:35,820
.لقد بالغت كثيرًا يا ساسرو

171
00:14:36,050 --> 00:14:38,250
ماذا؟ أتَعني كيسيليا؟

172
00:14:38,390 --> 00:14:41,420
.أجل. لم يَكُنْ يَجدُر بِكَ أن تَصفعها

173
00:14:41,760 --> 00:14:45,930
.كان يَجدُر بي أن أفعل أكثر مِن ذلك. كانت مُغترّة بِنفسها مؤخرًا

174
00:14:46,630 --> 00:14:51,800
-صحيح. لكنّنا عائلة، لِذا يَجب أن نحاول

175
00:14:51,870 --> 00:14:53,240
.دوزل

176
00:14:53,270 --> 00:14:56,140
.قلبك الرقيق هذا عائق

177
00:14:56,210 --> 00:14:59,810
.الوضع السياسي هُنا على وشك أن يَتحوّل لِحمامِ دم

178
00:14:59,940 --> 00:15:01,810
-لن تَنجو ما لَم

179
00:15:08,050 --> 00:15:11,750
-كيسيليا. السيارة التي فيها دوزل وساسرو قد

180
00:15:11,820 --> 00:15:13,190
.غارما

181
00:15:13,660 --> 00:15:16,490
.لا تَدع أمور صغيرة كهذه تُجلجلك

182
00:15:17,030 --> 00:15:18,660
أنت رجلٌ من عائلة زابي، ألستَ كذلك؟

183
00:15:19,460 --> 00:15:21,400
.أطفئوا النيران. أطفئوها

184
00:15:24,170 --> 00:15:25,840
.سَتَنفجر

185
00:15:34,380 --> 00:15:38,820
.سُحقًا. لقد قُتِلَ ساسرو

186
00:15:40,780 --> 00:15:43,520
من فعلها؟

187
00:15:44,120 --> 00:15:45,490
من الوغد الذي كان خلف هذا؟

188
00:15:45,490 --> 00:15:47,490
.مهلاً، لا تُطلقوا -
من الوغد الذي كان خلف هذا؟ -

189
00:15:47,490 --> 00:15:49,490
من الوغد الذي كان خلف هذا؟

190
00:15:55,130 --> 00:15:59,540
.سيارة في موكب جنازة زيون زوم دايكون قد انفجرت دون تَحذير

191
00:15:59,670 --> 00:16:01,900
،مِن بَين رُكّابها، ساسرو زابي قد قُتِل

192
00:16:02,110 --> 00:16:06,440
.وقد نجى دوزل زابي بِإعجوبة مِن جروح مُهددة للحياة

193
00:16:07,140 --> 00:16:08,610
.أكاذيبٌ وافتراءات

194
00:16:08,750 --> 00:16:12,450
.هذا الإعلام القذر، دائمًا ما يَنصاعون لِعائلة زابي

195
00:16:13,150 --> 00:16:15,620
.هذا جُزء مِن مُخطط زابي

196
00:16:15,820 --> 00:16:18,450
يُحاول أن يُشتت انتباه الناس عن اغتيال دايكون

197
00:16:18,450 --> 00:16:22,730
.بِقتل ابنه جاعلاً مِن الأمر يبدو وكأنَّها من قام بالأمر

198
00:16:22,760 --> 00:16:24,290
هل هذا صَحيح، يا أبي؟

199
00:16:24,430 --> 00:16:28,660
رامبا. ما هذا؟! هل تَشتبه بي أيضًا؟

200
00:16:28,830 --> 00:16:30,570
.لا، لم أعني ذلك

201
00:16:30,670 --> 00:16:33,170
لكن هل يُمكن أن يَقتُله ابنه لِهذا السبب فقط؟

202
00:16:33,670 --> 00:16:36,570
،لم يَكُنْ ساسرو ابنه حقًّا، لكنّهُ كان جيّدًا في عمله

203
00:16:36,670 --> 00:16:39,180
.وبقيّة أعضاء عائلة زابي كانوا يَثنون علَيه

204
00:16:39,310 --> 00:16:40,740
.رامبا-ساما

205
00:16:41,240 --> 00:16:43,180
.أستُريّا-ساما تَطلُبك

206
00:16:44,050 --> 00:16:45,480
.سَأكون هُناك في الحال

207
00:16:48,580 --> 00:16:51,050
.سُحقًا -
.اخرج مِن هُنا، أيُّها العجوز القاتل -

208
00:16:51,090 --> 00:16:52,290
.قاتل ساسرو

209
00:16:52,690 --> 00:16:55,530
.لقد اختطفت عائلة دايكون

210
00:16:55,560 --> 00:16:58,130
.أنت تَلعب بِقذارة أيُّها العجوز الخسيس

211
00:16:58,190 --> 00:17:00,200
،أنت عار على ذكرى دايكون

212
00:17:00,260 --> 00:17:02,070
.أيُّها الخائن

213
00:17:02,500 --> 00:17:04,130
.إنَّهُ الكابتن رال

214
00:17:07,300 --> 00:17:08,770
.سَأدخُل

215
00:17:21,120 --> 00:17:23,920
أتَفهّم الأمر جيّدًا. تُريدين العودة للمنزل؟

216
00:17:24,090 --> 00:17:25,760
.بالطبع أنت كذلك. بالطبع

217
00:17:25,920 --> 00:17:27,990
...لكنّي أطلُب منكِ أن تنتظري لِوقتٍ أطول بِقليلٍ فقط

218
00:17:28,120 --> 00:17:31,390
...لا أيُّها الكابتن. إنَّها تَبكي لِأنَّها

219
00:17:31,430 --> 00:17:33,800
...لوسفر لِوحده

220
00:17:35,130 --> 00:17:36,770
.أنا قَلِقة علَيه

221
00:17:36,770 --> 00:17:38,200
لوسفر؟

222
00:17:44,770 --> 00:17:46,110
قِط؟

223
00:17:46,540 --> 00:17:48,180
قط؟

224
00:17:49,410 --> 00:17:52,220
.يَشعُر لوسفر بالوحدة بِسهولة

225
00:17:53,220 --> 00:17:56,050
،لا يُمكنه أن ينام دون أن أُمسكه

226
00:17:56,250 --> 00:17:59,920
.ولا يُمكنه أن يَتغوّط ما لَم أُساعده أنا

227
00:18:00,820 --> 00:18:05,460
.فهمت. سَيُحضر عَمُّك لوسفر لكِ

228
00:18:06,000 --> 00:18:07,400
حقًّا؟

229
00:18:08,730 --> 00:18:11,770
.أجل، أَعِدُكِ بِهذا

230
00:18:12,240 --> 00:18:16,210
.لا يوجد شيء مُستَحيل على العم رامبا رال

231
00:18:16,610 --> 00:18:18,270
.أنت الأروع، أيُّها العم رامبا

232
00:18:23,010 --> 00:18:25,480
.ابدأوا بِعمليّة إنقاذ لوسفر

233
00:18:26,450 --> 00:18:27,820
لوسفر؟ -
من هو؟ -

234
00:18:27,950 --> 00:18:28,950
...لا أعلم

235
00:18:29,020 --> 00:18:32,620
أيُّها الملازم، ما هو اسمك؟ -
.سيّدي. اسمي دونوفان ماتغلوس، سيّدي -

236
00:18:33,790 --> 00:18:36,260
.قُم بِتَشكيل فصيلة واتبعني

237
00:18:45,870 --> 00:18:47,270
.لا

238
00:18:47,300 --> 00:18:52,010
.نَسيت أن أقول له بِأن لوسفر يُخربش الذين لا يَعرفهم

239
00:18:54,440 --> 00:18:57,450
.زابي. زابي. زابي

240
00:18:57,510 --> 00:18:59,450
.لا تَدعوا الخونة يَفلتون بِفعلتهم

241
00:18:59,450 --> 00:19:01,780
.اسحقوا عائلة رال

242
00:19:01,920 --> 00:19:04,220
.تحيا عائلة ديغوين زابي

243
00:19:04,290 --> 00:19:06,690
.اقتلوا عائلة رال

244
00:19:08,620 --> 00:19:10,190
.رائع -
هذا من أجل ساسرو -

245
00:19:10,290 --> 00:19:12,260
.زابي. زابي

246
00:19:12,700 --> 00:19:16,300
.زابي. زابي. زابي

247
00:19:16,870 --> 00:19:19,340
.لقد هزمنا عائلة رال

248
00:19:19,840 --> 00:19:22,070
.أصبحت المَدينة في حالة فوضى

249
00:19:22,140 --> 00:19:24,510
.لَن يَكون كافيًا تهوية النار فقط

250
00:19:24,670 --> 00:19:27,410
.حان الوقت الذي نَستَعيد فيه النظام

251
00:19:28,210 --> 00:19:31,410
.هذا اسمك الذي يُنادي فيه الجموع

252
00:19:31,680 --> 00:19:33,420
.ليَكُنْ الأمر، لا يُمكنني دفعهم

253
00:19:33,420 --> 00:19:37,150
.سَيُعطي ذلك الاتحاد الحُجّة التي يَنتظروها

254
00:19:37,150 --> 00:19:40,290
.غيهرين، أبي. ها أنتما إذن

255
00:19:40,520 --> 00:19:45,290
.مُشاهدة عائلة رال تَسقط هوأمر مُمتع جدًّا

256
00:19:45,530 --> 00:19:48,160
دوزل، أيَجدُر بِكَ التحرُّك هكذا؟

257
00:19:48,460 --> 00:19:51,830
.لا يُمكنني البقاء في السرير، لَيس وأنا مُحمّس هكذا

258
00:19:51,970 --> 00:19:55,940
.سَأصفّي الحساب مِن أجل ساسرو بِيَدَيَّ هاتَين

259
00:19:59,910 --> 00:20:03,680
.هل يَجب أن أُذكّرك أن الفأر المُحاصر قد يَعض القِط

260
00:20:03,850 --> 00:20:06,750
،صَحيحٌ أن جيمبا رال في عداد الأموات بالفعل

261
00:20:06,880 --> 00:20:08,920
.لكن ابنه مازال موجودًا

262
00:20:08,950 --> 00:20:11,120
يبدو أنَّهُ شعبي بَين الأعضاء اليافعين

263
00:20:11,290 --> 00:20:13,320
.مِن قوّات الدفاع في مونزو

264
00:20:14,460 --> 00:20:19,400
.غهرين يا فتاي، يَجب أن تُتقن النفاق

265
00:20:21,600 --> 00:20:24,130
.أنت مُحق، رامبا رال رجلٌ جيّد

266
00:20:24,300 --> 00:20:27,500
.لو لَم يَكُنْ من عائلة رال لَكُنت جَعلته يَخدم تَحت إمرَتي

267
00:20:27,700 --> 00:20:30,210
.أَرِهم طريقًا للخروج

268
00:20:30,310 --> 00:20:33,510
.مِن حق المُنتصر أن يَكُون رحب الصدر

269
00:20:36,080 --> 00:20:40,220
.كِلا دايكون وجيمبا رال مِن الماضي الآن

270
00:20:40,350 --> 00:20:45,560
.سَتحمل عائلة زابي على كتفها أمر التاريخ القادم

271
00:20:58,700 --> 00:21:00,200
.مهلك لحظة

272
00:21:00,200 --> 00:21:04,170
.إلى أَيِ جانبٍ أنت؟ من الأفضل لك ألّا تَكون نصيرًا لِرال

273
00:21:07,740 --> 00:21:09,910
.سُحقًا

274
00:21:10,710 --> 00:21:12,780
ما الذي كان يَشرَبُه هذا الرجل؟

275
00:21:13,350 --> 00:21:15,350
أنت ثَمِلٌ للغاية، وتُريد أن تَستمر بالسُكر؟

276
00:21:15,450 --> 00:21:18,420
هل تَعرف ما هو اليوم؟

277
00:21:18,960 --> 00:21:22,430
...عُذرًا، لكن البار قد أُغلِقَ بالفعل لِهذه اللَيلة، لِذا

278
00:21:25,630 --> 00:21:27,630
هل هذا أنت أيُّها الكابتن؟

279
00:21:28,130 --> 00:21:32,140
اخفض صوتك، أنت المُلازم تاتشي، صَحيح؟

280
00:21:32,600 --> 00:21:35,940
أتَعمل عملاً آخر كَراقصة نادٍ ليلي؟

281
00:21:36,010 --> 00:21:40,180
.لا، بدت الأمور سيئة الليلة، لِذا تطوّعت أنا

282
00:21:40,280 --> 00:21:41,410
.بِصراحة

283
00:21:41,410 --> 00:21:44,280
.مع خالص احترامي يا سيدي

284
00:21:44,850 --> 00:21:47,420
.لا تَجُرّها لِأيِ أمرٍ خطير

285
00:21:47,820 --> 00:21:53,090
.توقّف عن  استغلالها أرجوك ودعها تَحيا حياة طبيعيّة هادئة

286
00:21:53,560 --> 00:21:56,190
.أيُّها الملازم تاتشي، هذا أمر

287
00:21:57,030 --> 00:22:00,060
.لا تُدخل أنفك في الذي على وشك أن أقوم به

288
00:22:04,300 --> 00:22:06,070
.مرحبًا أيُّها الكابتن

289
00:22:06,840 --> 00:22:10,610
.كلامب. كُل مرّة أراك فيها وتبدو وكأنَّكَ في منزلك خلف هذا البار

290
00:22:11,770 --> 00:22:14,510
ما رأيك أن تعود للجَيش؟

291
00:22:15,080 --> 00:22:19,380
.الجيش؟ لا أشعُر بإنَّني أُريد أن أكون تابعًا للإتحاد

292
00:22:19,880 --> 00:22:24,520
.لكن إن احتجتَني، فَسأعود مُسرعًا

293
00:22:25,190 --> 00:22:28,060
.هامون-سان، لقد طُلِبتِ

294
00:22:32,930 --> 00:22:34,200
.تعال إلى الداخل

295
00:22:34,200 --> 00:22:36,470
.أيُّها الساقي، لا تَدع أحدًا يَدخُل

296
00:22:38,600 --> 00:22:42,310
.تَنكُّرك اليوم مُتقن أكثر مِن المُعتاد

297
00:22:45,440 --> 00:22:47,110
.لقد فاتك القليل

298
00:22:47,680 --> 00:22:52,120
.لَيس بِمسحوق تجميل. ذلك اللوسفر الصغير تركهم عليَّ

299
00:22:53,420 --> 00:22:57,420
تَتَسكّع في هذا الوقت؟ ماذا كانت المُهمّة الأخيرة إذن؟

300
00:22:58,620 --> 00:22:59,920
...شَيطانٌ

301
00:23:06,930 --> 00:23:08,630
...رشيقٌ أسود الشعر

302
00:23:11,370 --> 00:23:14,540
.عُذرًا يا هامون، لكن أُريد منكِ أن تُسديني معروفًا آخر

303
00:23:16,440 --> 00:23:19,580
.أُريد تَهريب شيئًا للأرض

304
00:23:20,240 --> 00:23:22,580
والدك، جيمبا رال؟

305
00:23:22,910 --> 00:23:25,450
.فهمتِ الأمر بِسُرعة، كالعادة

306
00:23:25,550 --> 00:23:29,590
.بعد ما حدث لِساسرو، العجوز لن يَنجو من الأمر حيًا

307
00:23:29,650 --> 00:23:33,890
.لن أتَحمّل أن يَقع بَين أَيدي عائلة زابي

308
00:23:34,290 --> 00:23:35,690
ماذا عنك؟

309
00:23:35,890 --> 00:23:38,060
.سَأُفكّر بِشَيء

310
00:23:38,090 --> 00:23:41,200
.أنا مُتأكّد مِن أنَّني سَأعثر على شيء علَيهم

311
00:23:42,400 --> 00:23:45,540
والدك سَيَكون الوحيد الذي سَيَذهب للأرض؟

312
00:23:45,570 --> 00:23:46,970
...بِشأن ذلك

313
00:23:47,140 --> 00:23:50,340
.قد يُسافر مع مُسافرَين مُثيرَين للمتاعب

314
00:23:51,010 --> 00:23:51,870
من؟

315
00:23:51,870 --> 00:23:55,340
.لا تَجعليني أشرح الأمر. فأنتِ حزرتِ الأمر بالفعل

316
00:23:57,480 --> 00:24:00,950
،سَأستَخدم معارفي عند سلطة الميناء

317
00:24:01,020 --> 00:24:02,890
.يُمكنني أن أجعل الأمر يَنجح

318
00:24:02,920 --> 00:24:04,520
.عَلِمت أن بإمكاني الاعتماد علَيكِ

319
00:24:05,590 --> 00:24:08,520
.المُلازم هُنا مُجددًا -
.أجل -

320
00:24:08,520 --> 00:24:11,360
.لا يَجب أن تَجعلي ساذجًا مثله يَرتَبطُ بك

321
00:24:11,360 --> 00:24:12,600
.حسنٌ، حسنٌ -
.لا يَجب أن تَجعلي ساذجًا مثله يَرتَبطُ بك -

322
00:24:12,700 --> 00:24:16,600
.بِما إنَّكَ ذكرت الأمر، فمركزه الآن عِند ميناء رسو المركبات

323
00:24:16,600 --> 00:24:18,300
.قد يَتَمكّن من أن يُثبت قُدرته

324
00:24:18,840 --> 00:24:20,300
من، هو؟

325
00:24:30,380 --> 00:24:32,180
لِمَ على هذَين الطفلَين

326
00:24:32,550 --> 00:24:36,250
أن يُولدا في هذا العالم كَذُريّة دايكون؟

327
00:24:41,260 --> 00:24:42,530
.توقّفوا

328
00:24:48,000 --> 00:24:49,570
.لا تَقتربوا أكثر

329
00:24:50,230 --> 00:24:51,570
.تَقدّموا أكثر، وسَنفتح النار

330
00:24:51,970 --> 00:24:54,370
.حاولوا فقط، أتحدّاكم

331
00:24:54,940 --> 00:24:57,770
.شُرطة أمن البلاد، القائدة كيسيليا زابي

332
00:24:58,010 --> 00:25:00,210
.أنا هُنا بِمُهمّة خاصّة

333
00:25:00,540 --> 00:25:04,180
.جيمبا رال-ساما لن يُقابل أحدًا مِن عائلة زابي

334
00:25:04,550 --> 00:25:09,550
!لا بأس. حاجة لِأن أرى جيمبا رال

335
00:25:09,820 --> 00:25:12,690
أرغب بالتَحدُّث مع كاسفال ريم دايكون

336
00:25:12,860 --> 00:25:15,860
.نيابة عن ديغوين زابي، الرئيس الجَديد

337
