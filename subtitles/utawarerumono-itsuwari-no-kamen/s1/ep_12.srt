1
00:00:05,990 --> 00:00:10,790
.تسبّبتُ لكم بالكثير من المشاكل البارحة

2
00:00:11,330 --> 00:00:12,650
.أنا أعتذر

3
00:00:13,930 --> 00:00:17,350
.يمكنكم أن تروا أنّ الأميرة جدُّ آسفة على أفعالها

4
00:00:17,770 --> 00:00:20,620
هلا سامحتموها رجاءً؟

5
00:00:24,130 --> 00:00:25,200
...أكيد

6
00:00:26,390 --> 00:00:27,500
.خذوا هذه رجاءً

7
00:00:34,650 --> 00:00:36,130
!دعوني أتذوّقها

8
00:00:36,430 --> 00:00:40,130
!كلاّ، أريد أن أتذوّقها أوّلاً

9
00:00:38,880 --> 00:00:44,390
آمُل أنّ هذه الحادثة لن تمنعكم
.من استقبال الأميرة هنا

10
00:00:47,480 --> 00:00:49,610
...لا، أنا لا أدري

11
00:00:49,610 --> 00:00:50,800
مهلاً، ماذا؟

12
00:00:50,770 --> 00:00:52,400
!نحن نتوسّلكِ

13
00:00:52,750 --> 00:00:53,900
لا بأس بذلك، صحيح؟

14
00:00:54,210 --> 00:00:55,570
حا-حاضرة؟

15
00:00:55,570 --> 00:00:56,460
!هذه

16
00:00:56,460 --> 00:00:58,090
!تتمّة هذه القصّة

17
00:00:58,600 --> 00:01:00,190
أيمكنكِ القيام بذلك؟

18
00:01:00,190 --> 00:01:01,180
أيمكنك رسمها؟

19
00:01:02,010 --> 00:01:03,140
!على رسلكنّ

20
00:01:03,140 --> 00:01:04,910
!ليس أنتما أيضًا

21
00:02:36,960 --> 00:02:38,470
.أخبرني يا أوشُتورو

22
00:02:39,130 --> 00:02:40,220
ماذا هنالك؟

23
00:02:41,090 --> 00:02:43,970
لماذا عليّ ارتداء هذه الملابس؟

24
00:02:44,390 --> 00:02:45,720
.هذا طبيعيّ

25
00:02:46,810 --> 00:02:48,680
،نحن في البلاط الإمبراطوريّ

26
00:02:49,440 --> 00:02:51,980
.وأنت على وشك مقابلة الإمبراطور

27
00:02:52,310 --> 00:02:53,520
.هذا هو الموضوع إذًا

28
00:02:54,150 --> 00:02:57,190
لماذا يريد الإمبراطور مقابلتي؟

29
00:02:57,190 --> 00:03:00,030
.لم يتمّ إطلاعي بذلك أنا أيضًا

30
00:03:00,030 --> 00:03:02,870
.يا إلهي، على رسلكم عليّ

31
00:03:03,990 --> 00:03:05,950
،خلف قاعة الاستماع هذه

32
00:03:05,950 --> 00:03:07,620
.سيكون الإمبراطور في انتظارك

33
00:03:08,290 --> 00:03:09,500
،ابتداءً من هذه النّقطة

34
00:03:09,500 --> 00:03:11,870
.عليك أن تكون حذرًا ممّا ستقوله

35
00:03:12,580 --> 00:03:14,250
.اتبعني

36
00:03:14,790 --> 00:03:16,500
.حـ... حسنًا

37
00:03:18,460 --> 00:03:23,890
.آمُل أنّك في أحسن حال أيّها الإمبراطور

38
00:03:24,430 --> 00:03:30,560
أنا أوشُتورو، قد أحضرتُ لك الرّجل المسمّى
.هاكو-دونو الّذي أردتَ رؤيته

39
00:03:31,350 --> 00:03:32,190
.ليس الآن

40
00:03:33,690 --> 00:03:36,070
أنت هو هاكو إذًا؟

41
00:03:44,240 --> 00:03:46,160
هذا هو الإمبراطور إذًا؟

42
00:03:46,490 --> 00:03:53,170
،قيل لي أنّك أنقذت ابنتي أنجو
.عندما اختطفها قطّاع الطّرق

43
00:03:53,370 --> 00:03:54,000
.نعم

44
00:03:54,630 --> 00:03:56,670
.فهمت، هكذا إذًا

45
00:03:57,880 --> 00:04:00,670
.وجدت مونيتشيكا طريقة مناسبة لتفسير الأمر إذًا

46
00:04:00,670 --> 00:04:03,680
.قيل لي أنّك قمت بأداء ممتاز

47
00:04:04,010 --> 00:04:04,930
ماذا؟

48
00:04:05,140 --> 00:04:12,890
.أمسكتَ بكلّ قطّاع الطّرق في لحظة واحدة بدهائك الكبير

49
00:04:13,310 --> 00:04:15,940
.كان أداؤك مثيرًا للإعجاب كما قيل لي

50
00:04:16,150 --> 00:04:17,940
!لقد بالغت كثيرًا في الأمر

51
00:04:18,820 --> 00:04:20,440
.مثير للاهتمام بالفعل

52
00:04:20,820 --> 00:04:22,530
.سوف أعطيك مكافأة

53
00:04:22,530 --> 00:04:23,990
.شـ-شكرًا

54
00:04:23,990 --> 00:04:27,530
يا إلهي... لستُ مهمًّا كفاية لأحصل
...على مكافأة من أيّ نوع

55
00:04:27,530 --> 00:04:29,790
.أحضريهما يا هونوكا

56
00:04:29,370 --> 00:04:30,200
هونوكا؟

57
00:04:30,200 --> 00:04:30,870
.في الحال

58
00:04:32,120 --> 00:04:32,960
هونوكا-سان؟

59
00:04:33,830 --> 00:04:38,590
...إ-إذًا فالإمبراطور هو

60
00:04:45,800 --> 00:04:46,680
.هاكو-دونو

61
00:04:47,720 --> 00:04:49,390
.آسف، لم أستطع كبح نفسي

62
00:04:50,390 --> 00:04:51,140
.لا بأس

63
00:04:51,890 --> 00:04:55,060
.يا له من شيء مثير للاهتمام لتقوله

64
00:04:55,060 --> 00:04:58,150
.ربّما رأيت رسمة لي من قبل

65
00:05:00,820 --> 00:05:04,740
.نـ...نعم، ربّما ذلك ما حدث

66
00:05:06,530 --> 00:05:09,160
ما قصّة ذلك العجوز؟

67
00:05:09,450 --> 00:05:11,290
.الآن يا هونوكا

68
00:05:11,290 --> 00:05:12,870
.سمعًا وطاعة

69
00:05:36,020 --> 00:05:38,810
من هاتان الفتاتان؟

70
00:06:09,340 --> 00:06:12,100
.هاتان الفتاتان هما مكافأتك

71
00:06:14,220 --> 00:06:14,970
ماذا؟

72
00:06:15,600 --> 00:06:16,680
.أرورو

73
00:06:17,940 --> 00:06:20,480
.وأنا اسمي سارانا

74
00:06:20,730 --> 00:06:23,980
،هذه علامة عهدنا
...بأنّ كلّ ما نحن عليه

75
00:06:24,190 --> 00:06:26,610
.أصبح ملكك الآن

76
00:06:27,360 --> 00:06:29,700
.نحن هما كوموناغي السّلاسل

77
00:06:29,700 --> 00:06:33,120
.نقسم بالولاء الأبديّ لك

78
00:06:36,250 --> 00:06:40,120
.إنّهما ملك لك منذ هذه اللّحظة

79
00:06:40,540 --> 00:06:43,250
.جسداهما وروحاهما وكلّ ما تملكانه

80
00:06:43,670 --> 00:06:44,500
!ماذا؟

81
00:06:44,800 --> 00:06:48,130
.سوف يقبلان أيّ أمر تُمليه عليهما

82
00:06:48,130 --> 00:06:50,090
،يمكنك أن تعاملهما كأغراض تستحقّ الإعجاب

83
00:06:50,090 --> 00:06:52,680
.أو يمكنك أن تعاملهما كألعاب لتلهو بهما

84
00:06:52,680 --> 00:06:54,510
.كلّ شيء مسموح

85
00:06:54,720 --> 00:06:56,770
!لا، مهلاً لحظة

86
00:06:57,100 --> 00:06:59,520
.هذا كلّ شيء

87
00:07:03,270 --> 00:07:05,020
.وداعًا يا هاكو

88
00:07:05,270 --> 00:07:09,320
.أتطلّع شوقًا لرؤيتك ثانية

89
00:07:10,070 --> 00:07:13,530
.اهتمّ جيّدًا بابنتَيّ لو سمحت

90
00:07:24,040 --> 00:07:26,630
ما-ما معنى هذا؟

91
00:07:26,630 --> 00:07:31,550
كيف يُمكن لشخص وضيع الأصل
أن يُمنح كاموناغي السّلاسل؟

92
00:07:32,760 --> 00:07:35,220
!لا بدّ أنّ في الأمر خطأ ما

93
00:07:35,220 --> 00:07:37,350
!تحقّقوا من الأمر ثانية

94
00:07:37,350 --> 00:07:40,100
!هيّا! هيّا

95
00:07:38,810 --> 00:07:40,100
!اخرس

96
00:07:43,940 --> 00:07:48,190
أنت تعرف معنى هذه الكلمات، صحيح؟

97
00:07:49,690 --> 00:07:54,160
...إنّك تعارض كلمات إمبراطورنا

98
00:07:54,160 --> 00:07:56,450
هل فقدت عقلك؟

99
00:07:57,950 --> 00:08:03,960
لا بدّ أنّ أفعال الإمبراطور تتضمّن
.معنى أسمى ويفوق مدى إدراكنا

100
00:08:06,920 --> 00:08:09,420
.هاكو-دونو، سنغادر الآن

101
00:08:09,920 --> 00:08:11,170
.علينا أن نسرع

102
00:08:11,170 --> 00:08:12,380
.حـ-حسنًا

103
00:08:18,930 --> 00:08:21,600
كان اسمه هاكو؟

104
00:08:21,600 --> 00:08:22,980
من يكون يا ترى؟

105
00:08:23,520 --> 00:08:26,860
...حسب التّقارير، فإنّه ذراع أوشُتورو اليمنى

106
00:08:26,860 --> 00:08:29,900
إنّه ليس ذلك السّيف الكليل الّذي
.قد نظنّه عنه في بادئ الأمر

107
00:08:29,900 --> 00:08:31,030
.مثير للاهتمام

108
00:08:33,360 --> 00:08:34,860
.لقد عدت

109
00:08:34,860 --> 00:08:37,530
.سررتُ بعودتك يا هاكو-ساما

110
00:08:37,530 --> 00:08:38,870
.أهلا بعودتك

111
00:08:38,870 --> 00:08:41,120
ما الّذي أراده أوشُتورو؟

112
00:08:42,790 --> 00:08:44,330
.تبدو متعَبًا

113
00:08:44,330 --> 00:08:46,080
أقمت بتنظيف المزيد من المجاري؟

114
00:08:46,080 --> 00:08:49,130
.صحيح، لقد تمّ استدعائي للقصر

115
00:08:50,130 --> 00:08:51,550
القصر؟

116
00:08:51,550 --> 00:08:52,590
لماذا؟

117
00:08:52,590 --> 00:08:54,880
هل قابلتَ الإمبراطور أو ما شابه؟

118
00:08:55,220 --> 00:08:56,680
!وكأنّ ذلك ممكن

119
00:08:57,550 --> 00:08:59,640
.نعم، لقد قابلتُه

120
00:08:59,850 --> 00:09:01,930
.عرفتُ ذلك

121
00:09:01,930 --> 00:09:04,060
—ليس من السّهل مقابلةُ الإ

122
00:09:04,890 --> 00:09:06,650
!ماذا؟

123
00:09:06,900 --> 00:09:09,360
ما الّذي تعنيه؟

124
00:09:10,940 --> 00:09:13,240
...إنّها قصّة طويلة، لكن

125
00:09:14,240 --> 00:09:17,200
...عـ-عفوًا يا هاكو-ساما

126
00:09:17,990 --> 00:09:20,870
...كنتُ أتساءل

127
00:09:21,450 --> 00:09:23,160
من تكون هاتان؟

128
00:09:26,750 --> 00:09:27,710
من هما؟

129
00:09:27,710 --> 00:09:29,170
ضيفتان؟

130
00:09:32,050 --> 00:09:33,380
هاتان الفتاتان؟

131
00:09:34,420 --> 00:09:36,380
.نحن مِلك لسيّدنا

132
00:09:36,380 --> 00:09:40,100
.لقد أصبحنا ألعاب سيّدنا الحيّة

133
00:09:40,100 --> 00:09:41,220
...نحن أورورو

134
00:09:41,220 --> 00:09:42,470
.وسارانا

135
00:09:42,890 --> 00:09:44,430
.سررنا بلقائكم

136
00:09:48,190 --> 00:09:50,310
...في الصّباح وفي المساء

137
00:09:51,270 --> 00:09:53,690
...في السّرير وأثناء الاستحمام وحتّى في الحمّام

138
00:09:53,980 --> 00:09:56,780
.سوف تهتمّ بكلّ شيء

139
00:09:56,780 --> 00:09:58,200
!مـ-مهلاً، مهلاً

140
00:09:59,950 --> 00:10:01,700
...هنالك المزيد الآن

141
00:10:02,030 --> 00:10:03,700
.كم هذا قذر

142
00:10:03,700 --> 00:10:08,210
متى تركتني في الخلف وصعدت أدراج الرّشد؟

143
00:10:08,580 --> 00:10:09,920
!لا، مهلاً

144
00:10:09,920 --> 00:10:11,710
!لم أكن أرغب بإحضارهما

145
00:10:12,290 --> 00:10:14,880
!لقد أعطانيهما الإمبراطور

146
00:10:14,880 --> 00:10:16,670
!لا أستطيع رفض ذلك

147
00:10:19,640 --> 00:10:22,470
لكن هل أنتما موافقتان على هذا؟

148
00:10:22,930 --> 00:10:25,350
،أعلم أنّه لم يكن لديكما خيار

149
00:10:25,350 --> 00:10:26,730
،لكن إن لم تكونا سعيدتين

150
00:10:26,730 --> 00:10:28,980
.أظنّ أنّ بإمكانكما إخبارنا بذلك لنساعدكما

151
00:10:29,900 --> 00:10:31,520
...سبب تواجدنا

152
00:10:32,400 --> 00:10:35,230
.هو قبول كلّ ما يطلبه سيّدنا

153
00:10:35,480 --> 00:10:38,860
.نحن موجودتان لذلك السّبب فقط

154
00:10:38,860 --> 00:10:41,240
كلّ شيء؟

155
00:10:41,570 --> 00:10:44,740
...هذا... أو ذاك

156
00:10:45,830 --> 00:10:50,500
.سوف نرتبط بسيّدنا بكلّ الطّرق الممكنة

157
00:11:02,340 --> 00:11:03,930
!روروتي

158
00:11:04,510 --> 00:11:08,930
!استيقظي يا روروتي! روروتي

159
00:11:05,260 --> 00:11:06,600
...لماذا

160
00:11:06,600 --> 00:11:08,930
لماذا يحدث لي هذا؟

161
00:11:09,640 --> 00:11:10,940
أخبريني يا كووُن؟

162
00:11:11,270 --> 00:11:13,610
هل أضعه على هذا الرّفّ فحسب؟

163
00:11:13,610 --> 00:11:15,190
.نعم، شكرًا

164
00:11:15,900 --> 00:11:17,900
،نيكو-يان، نيكو-يان

165
00:11:17,900 --> 00:11:21,320
هل رأيت مشبك شعري في مكان ما؟

166
00:11:21,320 --> 00:11:25,580
.لقد رأيتُه في مكان قريب من هنا

167
00:11:28,200 --> 00:11:29,410
.فهمت

168
00:11:29,960 --> 00:11:33,130
،عندما يوضع النّاس في مواقف تفوق إدراكهم

169
00:11:33,130 --> 00:11:36,050
.يقرّرون أن يتظاهروا أنّهم لم يروا شيئًا

170
00:11:36,670 --> 00:11:37,670
!لا! لا

171
00:11:37,670 --> 00:11:40,050
.لن أسمح أن ترى نيكوني-سان هذا

172
00:11:41,590 --> 00:11:43,300
إنّها تضع يدها هناك؟

173
00:11:43,590 --> 00:11:47,140
.يا إلهي كم أنت محبوب يا هاكو-سان

174
00:11:48,890 --> 00:11:50,310
.أنا أحسدك نوعًا ما

175
00:11:51,890 --> 00:11:54,060
.أشعر بالعطش

176
00:11:54,900 --> 00:11:55,810
.تفضّل

177
00:11:55,810 --> 00:11:58,070
.أعددنا بعض الشّاي

178
00:11:58,730 --> 00:11:59,990
أتريدني أن أسقيه لك عبر فمي؟

179
00:11:59,990 --> 00:12:01,150
.لقد سكبت بعضه

180
00:12:01,150 --> 00:12:02,320
.اعذرنا

181
00:12:08,450 --> 00:12:10,950
!دعاني أشرب الشّاي بشكل عاديّ

182
00:12:15,330 --> 00:12:16,000
.إنّه لذيذ

183
00:12:16,630 --> 00:12:17,710
.أنا متفاجئ

184
00:12:18,090 --> 00:12:20,960
بإمكانكما القيام بالأعمال المنزليّة وما شابه، صحيح؟

185
00:12:20,960 --> 00:12:22,930
...مهارات الخادمات

186
00:12:22,930 --> 00:12:27,260
.لقد درسنا كلّ الأشياء الّتي قد نخدم بها سيّدنا

187
00:12:27,680 --> 00:12:30,470
.كخادمات، فمن الطّبيعي أن نستطيع القيام بأشياء كهذه

188
00:12:31,680 --> 00:12:32,730
هكذا إذًا؟

189
00:12:33,020 --> 00:12:34,440
.بإمكاننا الطّبخ أيضًا

190
00:12:34,440 --> 00:12:38,520
،من الآن فصاعدًا، سنطبخ طعامك

191
00:12:38,520 --> 00:12:40,730
.وسنقوم بكلّ مهامك أيضًا

192
00:12:41,070 --> 00:12:43,240
.نحن جاهزتان لهذه الأمسية أيضًا

193
00:12:43,860 --> 00:12:46,870
.لقد أتقنّا مائة وثمانية تقنيات

194
00:12:48,330 --> 00:12:49,370
!كـ-كلاّ

195
00:12:49,790 --> 00:12:51,620
!تلك مهمّتي أنا

196
00:12:52,080 --> 00:12:53,160
الخلود إلى الفراش معه؟

197
00:12:53,160 --> 00:12:55,620
كانت هذه هي مهمّتك حتّى الآن؟

198
00:12:56,670 --> 00:12:58,630
!قصدتُ الطّبخ

199
00:12:58,630 --> 00:13:00,500
!تمهّلي يا روروتي

200
00:13:00,500 --> 00:13:01,460
!هدّئي من روعك

201
00:13:01,460 --> 00:13:02,630
،هاكو-ساما

202
00:13:02,630 --> 00:13:05,340
ألا يعجبك طبخي؟

203
00:13:05,340 --> 00:13:07,640
...لا، أنا لم أقصد لك

204
00:13:11,140 --> 00:13:15,100
.أيّتها الفتاتان، لا تحاولا إزعاجها كثيرًا

205
00:13:15,100 --> 00:13:17,520
!أجبني يا هاكو-ساما

206
00:13:19,020 --> 00:13:20,150
!هذا ساخن

207
00:13:21,400 --> 00:13:23,030
!كـ-كلاّ

208
00:13:24,190 --> 00:13:25,150
.لا تتحرّك

209
00:13:25,700 --> 00:13:27,160
.سوف ننظّفك

210
00:13:27,450 --> 00:13:29,410
!مـ-مهلاً لحظة

211
00:13:29,410 --> 00:13:31,370
—ليس عليكما القيام بذلك

212
00:13:31,370 --> 00:13:32,370
.إنّه يقطّر

213
00:13:32,370 --> 00:13:34,460
.لقد تسرّب الشّاي للدّاخل أيضًا

214
00:13:34,460 --> 00:13:37,170
!قلتُ أنّه ليس عليكما فعل هذا

215
00:13:40,170 --> 00:13:41,090
.لنخلع ملابسه

216
00:13:41,090 --> 00:13:43,090
.سوف نزيل عنه ملابسه

217
00:13:43,090 --> 00:13:43,760
!توقّفا

218
00:13:43,760 --> 00:13:45,050
!كفى

219
00:13:45,300 --> 00:13:46,840
!الأمر ليس كما يبدو يا رفاق

220
00:13:46,840 --> 00:13:47,680
!ليس كما يبدو

221
00:13:47,680 --> 00:13:49,930
!لذلك لا تنظروا إليّ بتلك الطّريقة

222
00:13:51,060 --> 00:13:52,430
.يا للقذارة

223
00:13:53,680 --> 00:14:00,980
.أمانوياهيغومو، فوكيهاناتسو كوتو نو غوتوكو

224
00:14:03,690 --> 00:14:04,820
...هذا

225
00:14:07,400 --> 00:14:13,700
يتطلّب الأمر مهارة كبيرة لاستعمال السّحر
.بذلك القدر من السّيطرة

226
00:14:16,210 --> 00:14:19,830
أخبراني، هل أنتما راهبتان؟

227
00:14:20,210 --> 00:14:23,380
أيمكنكما استعمال قدرات الاستبصار
خاصّتكما لتريا من سأتزوّج؟

228
00:14:23,380 --> 00:14:26,840
!أخبرانا كيف هو الإمبراطور

229
00:14:27,090 --> 00:14:31,680
أيمكنكما إخباري كيف أستطيع مقابلته؟

230
00:14:34,520 --> 00:14:35,850
.اعذروني على تطفّلي

231
00:14:36,850 --> 00:14:38,390
بائع الحلوى؟

232
00:14:39,190 --> 00:14:41,360
ما الّذي تفعله هنا؟

233
00:14:42,520 --> 00:14:43,730
.تستحقّ ذلك

234
00:14:44,070 --> 00:14:45,230
!دعني وشأني

235
00:14:45,650 --> 00:14:48,240
عذرًا، هل تحتاج لشيء ما؟

236
00:14:48,240 --> 00:14:49,950
.هذا صحيح

237
00:14:49,950 --> 00:14:51,740
هل أوكون هنا؟

238
00:14:51,740 --> 00:14:54,740
.من المفترض أن أحتسي الشّراب معه اللّيلة

239
00:14:55,190 --> 00:14:59,750
.قال أنّه لديه عمل ما ومن ثمّ رحل

240
00:15:00,850 --> 00:15:03,000
.سأبدأ من دونه إذًا

241
00:15:05,000 --> 00:15:08,510
لماذا لا ترافقنني يا فتيات؟

242
00:15:20,210 --> 00:15:21,640
.هذا رائع

243
00:15:21,970 --> 00:15:24,150
.لا تحرموا أنفسكم يا جماعة

244
00:15:24,510 --> 00:15:26,520
.الدّعوة على حسابي اللّيلة

245
00:15:26,520 --> 00:15:28,530
.كلوا واشربوا بقدر ما تشاؤون

246
00:15:28,940 --> 00:15:30,490
فعلاً؟

247
00:15:30,490 --> 00:15:33,780
.المرأة الجيّدة لا ترفض أبدًا دعوة للشّرب

248
00:15:34,070 --> 00:15:35,440
.هذه هي أختي

249
00:15:35,440 --> 00:15:38,040
.لا بدّ أنّه غنيّ

250
00:15:35,900 --> 00:15:38,040
.اشربي هذا كبداية

251
00:15:41,370 --> 00:15:44,590
إنّه الرّجل الّذي يملك عربة الحلويّات، صحيح؟

252
00:15:44,590 --> 00:15:46,220
.هذا ما يبدو

253
00:15:46,220 --> 00:15:48,050
.أعتقد أنّ بيع الحلويّات يدرّ الكثير من المال

254
00:15:50,100 --> 00:15:52,550
!انظروا إلى كلّ هؤلاء الفتيات الجميلات

255
00:15:52,880 --> 00:15:55,940
.إنّه مجرّد عجوز منحرف

256
00:15:55,930 --> 00:16:00,060
!تعالي إلى هنا يا نيكوني-تشان! لا تخجلي

257
00:16:01,810 --> 00:16:03,350
!كلاّ

258
00:16:03,600 --> 00:16:06,060
.ماذا؟ أنت لا تعرفين كيف تستمتعين

259
00:16:06,340 --> 00:16:10,760
.لا أعتقد أنّي سبق ورأيتك خائفة من أحد ما

260
00:16:11,630 --> 00:16:15,530
على أيّ حال يا سيّدي، ما الّذي أردته من أوكون؟

261
00:16:18,030 --> 00:16:20,940
.إنّنا نعرف بعضنا منذ وقت طويل

262
00:16:20,940 --> 00:16:23,500
،قال أنّه تعرّف على صديق مثير للاهتمام

263
00:16:23,500 --> 00:16:26,210
.وأراد منّي أن أقابله

264
00:16:26,650 --> 00:16:28,090
صديق مثير للاهتمام؟

265
00:16:31,050 --> 00:16:32,590
.إنّه أنت

266
00:16:35,830 --> 00:16:39,470
أخبرني عن الأشياء الّتي فعلتَها قبل
.أن تحضر إلى العاصمة أيضًا

267
00:16:39,470 --> 00:16:41,520
،لقد اصطدتَ البورو-غيغيري

268
00:16:41,520 --> 00:16:43,560
...وهزمت قطّاع طرق

269
00:16:43,990 --> 00:16:45,740
.أعتقد أنّ ذلك حدث بطريقة أو بأخرى

270
00:16:45,740 --> 00:16:49,480
.وكانت تلك أوّل مرّة تلتقي فيها أوشُتورو

271
00:16:49,810 --> 00:16:50,630
.نعم

272
00:16:51,110 --> 00:16:54,990
في ذلك الوقت، لم أشكّ أبدًا أنّ هويّة
...أوكون الحقيقيّة هي أوشُتورو

273
00:16:54,990 --> 00:16:56,200
!هاكو

274
00:16:58,400 --> 00:16:59,230
...سُحقًا

275
00:16:59,230 --> 00:17:03,190
...ما كان يقصده هو

276
00:17:03,790 --> 00:17:05,500
...هويّة أوكون الحقيقيّة

277
00:17:09,990 --> 00:17:11,870
أ-أيّها السّيّد؟

278
00:17:14,650 --> 00:17:16,470
.أنا أعرف ذلك منذ زمن

279
00:17:16,470 --> 00:17:19,130
.سبق وأخبرتكم، نحن نعرف بعضنا من مدّة طويلة

280
00:17:19,690 --> 00:17:21,260
أليس كذلك يا نيكوني؟

281
00:17:23,640 --> 00:17:27,870
حسنًا، ليس عدلاً أن تكوني الوحيدة
.الّتي تعرفين ذلك السّرّ

282
00:17:34,030 --> 00:17:35,150
هل تفاجأتم؟

283
00:17:36,260 --> 00:17:37,530
!مستحيل

284
00:17:41,620 --> 00:17:42,830
ماذا؟

285
00:17:45,580 --> 00:17:48,080
!انظري

286
00:17:46,360 --> 00:17:49,030
!كلاّ

287
00:17:49,030 --> 00:17:49,730
!وهكذا

288
00:17:49,730 --> 00:17:52,420
!كلاّ! كلاّ! كلاّ

289
00:17:52,710 --> 00:17:53,710
ماذا؟

290
00:17:53,710 --> 00:17:55,170
.تبدو نيكو-يان سخيفة للغاية

291
00:17:55,470 --> 00:17:57,410
.هكذا الأمر إذًا

292
00:17:57,410 --> 00:17:58,430
.لا عجب بذلك

293
00:17:59,710 --> 00:18:02,970
أظنّ أنّ الأمر منطقيّ إن كانت
.هذه هي هويّتك الحقيقيّة

294
00:18:02,970 --> 00:18:04,390
!يا رفاق

295
00:18:04,920 --> 00:18:06,390
!لقد وصلت

296
00:18:06,860 --> 00:18:09,190
أتستمتع بوقتك يا ساتشان؟

297
00:18:09,430 --> 00:18:11,940
!بكلّ تأكيد يا أوتشان

298
00:18:16,320 --> 00:18:22,450
على فكرة يا أوكون، إنّنا لم نكمل المعركة
.الّتي دارت بيننا في المنافسة

299
00:18:22,910 --> 00:18:27,330
.لقد انهار المكان قبل أن نكمل قتالنا

300
00:18:27,700 --> 00:18:30,700
أتريد الخروج إلى السّاحة والقتال؟

301
00:18:31,420 --> 00:18:32,950
.هذا مثير للاهتمام

302
00:18:32,950 --> 00:18:36,460
.لنقرّر من منّا الأقوى مرّة وإلى الأبد هذا اليوم

303
00:18:36,670 --> 00:18:38,770
.أنتما، كفّا عن هذا

304
00:18:38,770 --> 00:18:41,220
أتريدان تدمير منزلنا؟

305
00:18:42,900 --> 00:18:44,570
.هذا صحيح

306
00:18:46,190 --> 00:18:50,950
إذًا بإمكانك أن تنضمّ إلينا يا صاحِبي
!وسنقيم منافسة شرب

307
00:18:49,190 --> 00:18:53,730
إذًا أوكون وساكون هما أوشُتورو وميكازوتشي؟

308
00:18:54,650 --> 00:18:57,490
...لكن أظنّ أنّ ذلك رائع نوعًا ما

309
00:18:59,230 --> 00:19:00,610
.هذا صحيح

310
00:19:01,390 --> 00:19:04,270
.إنّهما يتنافسان هكذا دائمًا مع بعضهما

311
00:19:04,270 --> 00:19:07,740
.وذلك لأنّهما يعترفان بقوّة الآخر

312
00:19:10,040 --> 00:19:11,760
!كـ-كلاّ

313
00:19:11,760 --> 00:19:15,040
!أوكون-ساما لديه هاكو-ساما سلفًا

314
00:19:18,300 --> 00:19:21,260
!لكنّ هذا الثّنائيّ جيّد أيضًا

315
00:19:24,300 --> 00:19:26,020
.لقد أخلدناهما للنّوم

316
00:19:26,020 --> 00:19:30,020
اصطحبنا نيكوني-ساما
.وكيورو-ساما إلى سريريهما

317
00:19:30,400 --> 00:19:32,090
.حسنًا. شكرًا لكما

318
00:19:34,490 --> 00:19:36,520
كاموناغي السّلاسل إذًا؟

319
00:19:37,050 --> 00:19:39,790
.بالتّفكير بالأمر، هذا ما تطلقانه على نفسيهما

320
00:19:39,790 --> 00:19:41,900
من تكونان؟

321
00:19:42,650 --> 00:19:44,590
.يمكنك أن تقول أنّهما راهبتان

322
00:19:45,040 --> 00:19:47,410
.لكنّهما أكثر من ذلك

323
00:19:48,140 --> 00:19:50,530
،إنّهما ابنتا الرّاهبة العليا هونوكا-ساما

324
00:19:50,540 --> 00:19:52,080
.ووريثتاها

325
00:19:53,290 --> 00:19:54,790
الرّاهبة العليا؟

326
00:19:55,380 --> 00:19:57,550
أهي مهمّة لتلك الدّرجة؟

327
00:19:57,880 --> 00:20:03,680
من يدري لماذا أعطاهما الإمبراطور
لشخص مثلك؟

328
00:20:03,670 --> 00:20:04,700
صحيح، لماذا؟

329
00:20:04,700 --> 00:20:05,910
.لا فكرة لديّ

330
00:20:06,520 --> 00:20:11,550
.أفكار الإمبراطور تتخطّى إدراكنا

331
00:20:13,680 --> 00:20:17,660
.لكنّ الإمبراطور قد اعترف بمواهبك

332
00:20:18,140 --> 00:20:20,070
.وهذا شيء نحن واثقون منه

333
00:20:21,450 --> 00:20:23,090
،أنا لا أفهم الأمر بالفعل

334
00:20:23,650 --> 00:20:26,230
.لكنّي آمُل ألاّ يتسبّب هذا في المزيد من المشاكل

335
00:20:27,340 --> 00:20:31,150
.على أيّ حال، لقد أصبح هذا المكان مزدحمًا

336
00:20:32,570 --> 00:20:34,000
.معك حقّ

337
00:20:34,000 --> 00:20:37,960
.لكنّ كلّ هذه العلاقات قد نشأت بسببك

338
00:20:38,390 --> 00:20:39,310
علاقات؟

339
00:20:39,310 --> 00:20:40,270
.نعم

340
00:20:40,710 --> 00:20:45,140
.لقد اجتمعوا جميعًا حولك أنت

341
00:20:46,150 --> 00:20:47,690
هكذا إذًا؟

342
00:20:48,160 --> 00:20:49,660
.أكيد

343
00:20:51,600 --> 00:20:57,190
لا أطيق الانتظار لأرى ما الّذي
.ستفعله من الآن فصاعدًا

344
00:20:57,830 --> 00:21:00,730
...لا أنصحك بعقد آمال كبيرة

345
00:21:01,100 --> 00:21:02,380
.لا تقلق

346
00:21:03,130 --> 00:21:06,740
.استمرّ في التّصرّف على سجيّتك

347
00:21:07,230 --> 00:21:09,990
على سجيّتي؟

348
00:21:10,950 --> 00:21:12,120
.هذا صحيح

349
00:21:12,650 --> 00:21:15,150
.سوف نستمرّ بالقيام بما نريده

350
00:21:15,730 --> 00:21:17,370
أليس كذلك يا ساتشان؟

351
00:21:17,580 --> 00:21:19,380
.أكيد يا أوتشان

352
00:22:55,890 --> 00:22:57,130
.فهمت

353
00:22:57,130 --> 00:22:59,020
لقد سقطت ماروروها إذًا؟

354
00:22:59,520 --> 00:23:00,390
.نعم

355
00:23:00,880 --> 00:23:04,350
،تمّ إبلاغي أنّ قوّات أوزوروشّا قد تجاوزت الحدود

356
00:23:04,350 --> 00:23:07,280
.وغزت ياماتو

357
00:23:07,540 --> 00:23:09,210
...برابرة

358
00:23:09,210 --> 00:23:12,030
يريدون مهاجمة ياماتو إذًا؟

359
00:23:12,910 --> 00:23:16,240
!أيّها الإمبراطور! ننتظر أوامرك

360
00:23:19,160 --> 00:23:20,920
...اسمعوا جميعًا

361
00:23:21,300 --> 00:23:26,170
.أنا أمنح الإذن باستخدام قدراتكم، الأكوروكا

362
00:23:26,170 --> 00:23:29,170
.اقضوا على البرابرة ولا تتركوا رجلاً واحدًا منهم

363
00:23:29,740 --> 00:23:35,180
!عاقبوهم على خطيئة عدم إدراكهم لمكانتهم