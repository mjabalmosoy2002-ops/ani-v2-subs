1
00:00:10,330 --> 00:00:13,000
.طلبتُ منكِ شيئًا لا يؤلم

2
00:00:13,000 --> 00:00:15,920
أتريد دواءً يؤلم أكثر من هذا؟

3
00:00:15,920 --> 00:00:18,040
هذا أفضل من غيره إذًا؟

4
00:00:18,660 --> 00:00:20,060
...المزيد، المزيد

5
00:00:23,210 --> 00:00:25,290
.حسنًا، أظنّ أنّي انتهيت

6
00:00:25,290 --> 00:00:26,660
...يا سيّدي

7
00:00:26,660 --> 00:00:28,290
.أتينا لأخذك

8
00:00:30,630 --> 00:00:32,170
.مفهوم

9
00:00:32,170 --> 00:00:33,480
.سأعود قريبًا

10
00:00:36,260 --> 00:00:37,630
...لحظة يا هاكو

11
00:00:38,870 --> 00:00:39,630
ماذا هنالك؟

12
00:00:40,810 --> 00:00:44,810
هل... هل تستطيع العودة في وقت العشاء؟

13
00:00:47,450 --> 00:00:48,180
.أكيد

14
00:00:57,390 --> 00:01:00,080
...أظنّ أنّ هذا ليس ممتعًا أبدًا

15
00:02:31,860 --> 00:02:37,500
سمعتُ أنّك صنعت شهرة كبيرة لاسمك
.في الحرب ضدّ أوزوروشّا

16
00:02:37,500 --> 00:02:40,290
.تلقّيتُ تقريرًا من أوشُتورو

17
00:02:40,610 --> 00:02:41,490
ماذا؟

18
00:02:41,490 --> 00:02:44,500
.نعم، قام الآخرون جميعهم بكلّ العمل

19
00:02:44,500 --> 00:02:46,060
.لم أفعل شيئًا

20
00:02:46,850 --> 00:02:50,560
.أمجاد الجنود هي أمجاد القادة

21
00:02:50,950 --> 00:02:53,310
.إنّهم ليسوا جنودي

22
00:02:53,310 --> 00:02:54,410
...إنّهم

23
00:02:57,700 --> 00:03:00,260
.أقرب إلى عائلتي

24
00:03:02,860 --> 00:03:04,620
أقلتَ عائلة؟

25
00:03:14,010 --> 00:03:16,330
أكان من الضّروريّ التّمادي لتلك الدّرجة؟

26
00:03:17,050 --> 00:03:18,630
التّمادي لتلك الدّرجة؟

27
00:03:19,360 --> 00:03:21,630
.في الحرب الّتي دارت مع أوزوروشّا

28
00:03:25,210 --> 00:03:27,210
...قوّة تلك الأقنعة

29
00:03:27,210 --> 00:03:29,230
.لا بدّ وأنّك كنتَ مرتعبًا

30
00:03:30,930 --> 00:03:33,810
.لكنّ ذلك الرّعب كان ضروريًّا

31
00:03:34,470 --> 00:03:37,370
.لا أحد منيع ضدّ رعب الدّمار

32
00:03:38,170 --> 00:03:42,300
.لذلك يحاولون الهروب لإبعاد أنفسهم عنه

33
00:03:43,330 --> 00:03:45,820
.هكذا تعيش كلّ الكائنات

34
00:03:46,230 --> 00:03:48,710
لهذا السّبب قمتَ بكلّ ذلك؟

35
00:03:48,710 --> 00:03:51,830
لتريهم ماذا ينتظرهم إن وقفوا في وجه ياماتو؟

36
00:03:52,470 --> 00:03:55,830
.هذه هي مهمّة الإمبراطور، حماية شعبه

37
00:03:56,630 --> 00:03:57,670
.فهمت

38
00:04:00,470 --> 00:04:03,810
.لكنّ الرّعب يتلاشى مع الوقت

39
00:04:04,690 --> 00:04:08,480
.لم يكن هذا أوّل غزو لأوزوروشّا

40
00:04:08,950 --> 00:04:11,290
...حدث آخر واحد

41
00:04:12,470 --> 00:04:14,590
قبل مائتَيْ عام؟

42
00:04:14,590 --> 00:04:16,440
!مائتا عام؟

43
00:04:16,440 --> 00:04:18,110
كم عمرك؟

44
00:04:21,350 --> 00:04:23,360
.ربّما حان الوقت

45
00:04:23,850 --> 00:04:24,430
.حاضرة

46
00:04:24,970 --> 00:04:26,370
.اتبعني

47
00:04:35,730 --> 00:04:40,380
،كان هذا العالم تحت حكم الآباء العظام الأونفيتايكايان

48
00:04:40,920 --> 00:04:43,380
.الّذين امتلكوا حضارة متقدّمة للغاية

49
00:04:44,740 --> 00:04:46,760
الأونفيتايكايان؟

50
00:04:47,430 --> 00:04:50,460
،لقد خلقوا النّاس باستعمال قوّتهم

51
00:04:50,460 --> 00:04:53,700
.ثمّ اختفوا دون أن يتركوا أثرًا خلفهم

52
00:04:53,700 --> 00:04:58,310
وأنشأ النّاس الّذين تركوهم خلفهم بلدانًا
.على هذه الأرض وتطوّروا

53
00:04:58,310 --> 00:05:00,770
.هكذا بدأ هذا العالم

54
00:05:01,340 --> 00:05:06,580
يمتلك جلّ من في هذا العالم
.آذانًا وذيولاً تشبه الحيوانات

55
00:05:06,580 --> 00:05:09,280
،لكن هنالك من لا يملكها

56
00:05:10,010 --> 00:05:11,790
.مثلي ومثلك

57
00:05:14,520 --> 00:05:16,800
...لا بدّ أنّك وجدتَ هذا غريبًا

58
00:05:17,320 --> 00:05:20,630
.أقصد لماذا كنتَ مختلفًا عنهم

59
00:05:22,390 --> 00:05:24,850
.تكمن الإجابة أمامنا

60
00:05:26,040 --> 00:05:28,070
أتريد أن تعرفها؟

61
00:05:28,070 --> 00:05:30,730
لماذا تخبرني بهذا؟

62
00:05:32,930 --> 00:05:34,060
!افتحي

63
00:05:41,320 --> 00:05:42,610
.تعال معي

64
00:05:45,290 --> 00:05:47,230
أأنت واثق بشأن هذا؟

65
00:05:47,540 --> 00:05:48,160
ماذا؟

66
00:05:48,740 --> 00:05:51,200
.ما زال هنالك وقت لتتراجع

67
00:05:51,670 --> 00:05:52,790
...هونوكا-سان

68
00:06:16,890 --> 00:06:18,210
.جيّد جدًّا

69
00:06:18,870 --> 00:06:20,600
.أنت لم تتغيّر أبدًا

70
00:06:55,170 --> 00:06:58,730
.%عادت البيئة المحيطة بنسبة 85

71
00:06:59,510 --> 00:07:02,100
،إنّ أماتيراسو يعمل بجهد كبير

72
00:07:02,550 --> 00:07:06,910
.لكنّنا لم نتمكّن من التّكيّف بعد
ما خطب ذلك؟

73
00:07:07,550 --> 00:07:10,380
إذا كان هذا ما تعتقده، فلماذا لا تقدّم يد العون؟

74
00:07:10,380 --> 00:07:14,500
.يتحدّث مدير مصنع التّشجير بكلّ خير عنك

75
00:07:14,490 --> 00:07:16,410
.المشكلة هي مواضيع أبحاثهم

76
00:07:16,420 --> 00:07:18,210
لماذا يصنعون فجل دايكون يجري؟

77
00:07:18,210 --> 00:07:20,530
ما الّذي ينوون فعله؟ إقامة سباق؟

78
00:07:20,530 --> 00:07:21,460
.ربّما

79
00:07:22,050 --> 00:07:24,580
.تعال إذًا وساعدني في بحثي

80
00:07:24,580 --> 00:07:26,210
.تعرف أنّ ذلك مستحيل

81
00:07:28,230 --> 00:07:32,190
.إنّك تميل للتّقليل من شأنك

82
00:07:32,770 --> 00:07:36,220
.حسنًا. أخبرني عندما تغيّر رأيك

83
00:07:36,220 --> 00:07:37,140
.أكيد

84
00:07:37,140 --> 00:07:39,880
.بالمناسبة، حاول تعديل الكاميرا

85
00:07:39,880 --> 00:07:41,260
.لا أستطيع رؤية وجهك

86
00:07:41,260 --> 00:07:41,980
.حسنًا

87
00:07:50,030 --> 00:07:50,990
.أختي

88
00:07:53,240 --> 00:07:54,990
.لا زلت تأكل حصص الطّعام الجاهزة

89
00:07:56,250 --> 00:07:58,460
.عليك أن تأكل طعامًا حقيقيًّا

90
00:07:58,460 --> 00:08:00,150
.الوضع أسهل هكذا

91
00:08:00,690 --> 00:08:04,440
يا للرّجال... هذا ما يحدث عندما
.نشيح أنظارنا عنهم لوهلة

92
00:08:05,270 --> 00:08:07,210
.أنت تشبه زوجي تمامًا

93
00:08:09,000 --> 00:08:10,700
.ليس عليك فعل ذلك

94
00:08:10,700 --> 00:08:12,280
.لا بأس

95
00:08:17,910 --> 00:08:19,010
ما الّذي تفعله؟

96
00:08:23,130 --> 00:08:24,250
.لا شيء

97
00:08:26,060 --> 00:08:27,240
!صحيح

98
00:08:27,240 --> 00:08:32,090
هذا يوم سعدك يا عمّي! أنا أحضّر طبقك
!المفضّل اليوم؛ الكاري

99
00:08:32,090 --> 00:08:35,620
جيّد! حضّريه بأكثر قدر من البهارات، موافقة؟

100
00:08:35,620 --> 00:08:36,310
!أكيد

101
00:08:38,890 --> 00:08:41,150
.لا أصدّق أنّك بلغتَ هذه المرحلة

102
00:08:41,150 --> 00:08:43,690
.أنت من أخبرني بالقيام بهذا يا أخي

103
00:08:43,690 --> 00:08:46,540
.إنّهم ينوون على أشياء خطيرة للغاية

104
00:08:47,380 --> 00:08:52,050
إنّهم يستعملون مورّثات البشريّ القديم
الّذي عثروا عليه في حالة غيبوبة

105
00:08:52,070 --> 00:08:55,180
.لجعل النّاس قادرين على النّجاة في السّطح

106
00:08:55,590 --> 00:08:57,630
.مشروع رجل الجليد

107
00:08:59,300 --> 00:09:02,120
إلى أيّ مدى سيصل تعجرفهم؟

108
00:09:02,960 --> 00:09:05,560
.إنّهم يخشون الدّمار ويسعون للهروب منه

109
00:09:06,200 --> 00:09:08,940
.لا يستطيع أحد معارضة انقراض جنسه

110
00:09:13,640 --> 00:09:15,200
!أخبرني يا عمّي

111
00:09:17,830 --> 00:09:21,950
.لستُ كبيرًا كفاية لأكون عمّك

112
00:09:23,310 --> 00:09:25,290
.نادني أخي الكبير

113
00:09:25,290 --> 00:09:29,510
،لكنّك أخو أبي الأصغر، بالتّالي أنت عمّي

114
00:09:29,510 --> 00:09:30,750
!يا عمّي

115
00:09:34,250 --> 00:09:37,720
!أمّي، يعاملني عمّي بقسوة

116
00:09:38,430 --> 00:09:39,720
.يا إلهي

117
00:09:40,130 --> 00:09:45,790
اسمعي، ليس بوسع الفتيان إلاّ مضايقة
.الفتيات اللاّتي يحبّونهنّ

118
00:09:45,790 --> 00:09:49,140
.لذلك من واجب المرأة الجيّدة أن تسامحهم

119
00:09:49,140 --> 00:09:50,120
!حسنًا

120
00:09:50,120 --> 00:09:53,170
.أنا امرأة جيّدة، لذلك سأسامحه

121
00:09:53,170 --> 00:09:56,050
.لا تعلّميها أشياء غريبة

122
00:09:58,570 --> 00:10:02,200
.لا أطيق الانتظار حتّى أذهب للخارج

123
00:10:02,700 --> 00:10:03,930
.نعم

124
00:10:04,470 --> 00:10:06,940
.سمعتُ أنّ والدكِ يعمل بجدّ

125
00:10:06,940 --> 00:10:08,010
!جيّد

126
00:10:09,680 --> 00:10:11,380
عمّي، أتعرف شيئًا؟

127
00:10:19,150 --> 00:10:23,010
!عندما تأكل الكاري في الخارج، يسمّى ذلك تخييمًا

128
00:10:23,010 --> 00:10:24,290
.هذا صحيح

129
00:10:24,270 --> 00:10:26,270
...حسنًا، لكن ليس صحيحًا بالكامل

130
00:10:26,270 --> 00:10:27,440
،إن نجح الأمر

131
00:10:27,440 --> 00:10:31,520
!لنذهب جميعًا للتّخييم
!أمّي وأبي وأنت وأنا

132
00:10:31,520 --> 00:10:32,400
.نعم

133
00:10:32,400 --> 00:10:33,610
.لا أطيق الانتظار

134
00:10:40,910 --> 00:10:43,490
.من غير عادتك أن تأتي إلى هنا

135
00:10:44,870 --> 00:10:47,000
.ليس لديّ شيء آخر لأقوم به

136
00:10:47,000 --> 00:10:49,960
.لذلك اعتقدتُ أنّي أستطيع إلقاء نظرة على بحثك

137
00:10:51,960 --> 00:10:57,010
إنّك تقوم بتقوية وتحسين القدرات الأساسيّة للجسم؟

138
00:10:57,470 --> 00:11:00,890
،إن نجح هذا، فلن نتكيّف مع البيئة المحيطة فحسب

139
00:11:00,910 --> 00:11:03,150
.بل سنتخطّى الأمراض الوراثيّة أيضًا

140
00:11:03,150 --> 00:11:05,720
.كما أنّ عمر الفرد سيمتدّ بشكل كبير

141
00:11:06,140 --> 00:11:09,850
وهذا هو مشروع الإنسان الحقيقيّ؟

142
00:11:11,010 --> 00:11:12,630
كلّ ما بقي هو الاختبار الأخير؟

143
00:11:13,710 --> 00:11:17,480
من الصّعب العثور على موضوع
.اختبار في بيئة كهذه

144
00:11:18,790 --> 00:11:20,670
.حسنًا، أنا رجل صبور

145
00:11:26,420 --> 00:11:29,350
أخبرني، أيمكنني القيام بذلك؟

146
00:11:32,020 --> 00:11:34,130
أأنت واثق من هذا؟

147
00:11:34,730 --> 00:11:37,380
حسنًا، عليّ القيام بهذا، صحيح؟

148
00:11:38,130 --> 00:11:40,010
.شكرًا. سوف تساعدني كثيرًا

149
00:11:40,470 --> 00:11:42,470
.أنا أحبّك يا أخي الكبير

150
00:11:43,030 --> 00:11:44,850
.أحبّك أنا أيضًا يا أخي الصّغير

151
00:11:48,590 --> 00:11:51,410
!كفّ عن العبث وأسرع

152
00:11:51,410 --> 00:11:53,460
!أنت من دفعني للقيام بذلك

153
00:11:56,880 --> 00:11:57,750
.سأبدأ

154
00:11:58,720 --> 00:11:59,460
...حسنًا

155
00:12:24,700 --> 00:12:26,170
كيف تشعر؟

156
00:12:27,360 --> 00:12:29,720
ما كان ذلك؟

157
00:12:31,180 --> 00:12:36,770
الأونفيتايكايان... أولئك الّذين
...ندعوهم بالآباء العظام

158
00:12:37,880 --> 00:12:41,250
.كانوا يُدعون باسم آخر من قبل

159
00:12:42,500 --> 00:12:43,990
."البشر"

160
00:12:46,750 --> 00:12:47,640
.نعم

161
00:12:48,640 --> 00:12:51,170
.هذه هي حقيقتنا

162
00:12:52,550 --> 00:12:56,280
ما الّذي حدث للبشر بعد أن اختفوا؟

163
00:12:56,740 --> 00:12:58,640
،إنّهم لم يختفوا

164
00:12:58,640 --> 00:13:00,770
.ولم ينقرضوا

165
00:13:01,570 --> 00:13:05,840
.ربّما كان الأمر ليكون أفضل لو حدث ذلك

166
00:13:05,840 --> 00:13:07,260
ما الّذي تعنيه؟

167
00:13:07,610 --> 00:13:11,260
.هكذا يبدو البشريّ العاديّ الآن

168
00:13:13,920 --> 00:13:14,770
!التاتاري

169
00:13:14,770 --> 00:13:20,110
،نعم. يتمّ تبجيل البشر بصفتهم الأونفيتايكايان

170
00:13:20,110 --> 00:13:23,280
.وهم مصدر كره وخوف أيضًا بصفتهم تاتاري

171
00:13:24,200 --> 00:13:25,790
.يا له من أمر ساخر

172
00:13:27,660 --> 00:13:28,780
لماذا؟

173
00:13:29,490 --> 00:13:32,300
.الكارثة

174
00:13:36,750 --> 00:13:40,200
.في ذلك اليوم، بدأ البشر يذوبون فجأة

175
00:13:41,060 --> 00:13:43,940
.لم يعرفوا ما السّبب، أو كيف يوقفون ذلك

176
00:13:43,940 --> 00:13:47,500
.كلّ ما كان بوسعنا فعله هو الارتجاف خوفًا في ملاجئنا

177
00:13:49,740 --> 00:13:53,510
.لكنّها لم تكن إلاّ البداية

178
00:13:54,980 --> 00:13:58,980
.كانوا يهاجمون الآخرين بمجرّد أن يذوبوا

179
00:14:01,130 --> 00:14:03,480
متى ستبدأ بالذّوبان؟

180
00:14:03,990 --> 00:14:09,450
متى سيهاجك أفراد عائلتك أو أصدقاءك أو جيرانك؟

181
00:14:10,240 --> 00:14:13,180
،طغى عدم الأمان والخوف على العالم

182
00:14:13,180 --> 00:14:15,410
.وأمسى الجميع عدوًّا للجميع

183
00:14:21,270 --> 00:14:23,750
.جلبت علينا الحرب المزيد من الحرب

184
00:14:24,300 --> 00:14:27,040
،فقد البشر ثقتهم ببعضهم

185
00:14:27,050 --> 00:14:29,760
.بدأوا يخافون ويقتلون بعضهم بعضًا

186
00:14:34,020 --> 00:14:37,350
.وبعد ذلك، اتّخذنا أكثر الأخطاء سخافة

187
00:15:21,000 --> 00:15:23,510
،بعد أن دُمّر كلّ شيء

188
00:15:23,970 --> 00:15:29,820
كلّ ما بقي هم المزيّفون الّذين
.أنشأناهم لنستعملهم في تجاربنا

189
00:15:31,010 --> 00:15:33,700
.كان ذلك هو مصير الجنس البشريّ

190
00:15:35,410 --> 00:15:39,650
...ولحسن الحظّ، أو ربّما لسوء الحظّ

191
00:15:40,190 --> 00:15:43,330
.لم أتضرّر من الكارثة

192
00:15:45,460 --> 00:15:49,530
.كانت هذه بداية رحلة طويلةٍ طويلة

193
00:16:03,770 --> 00:16:06,800
،لقد حلمتُ بالسّطح لوقت طويل

194
00:16:06,800 --> 00:16:08,660
.ومع ذلك كان الصّعود إلى هناك سهلاً للغاية

195
00:16:09,410 --> 00:16:13,810
،ربّما الدّمار العظيم غيّر بيئة الأرض

196
00:16:14,240 --> 00:16:19,200
.أو ربّما كان جسدي هو الّذي تكيّف معها
.لا أستطيع الجزم أيّهما أصحّ

197
00:16:21,540 --> 00:16:25,560
.لكن لم يكن هنالك شيء

198
00:16:26,770 --> 00:16:28,880
...لا زوجتي ولا ابنتي ولا أخي الصّغير

199
00:16:29,560 --> 00:16:33,330
.لم يكن لديّ أحد أتشاركه فرحتي

200
00:16:34,770 --> 00:16:40,020
.تُركتُ في هذا العمال وحيدًا

201
00:16:41,750 --> 00:16:47,020
.ولم أكن قادرًا على تحمّل تلك الوحدة

202
00:16:49,280 --> 00:16:51,790
.لذلك أنشأتُ المزيّفين

203
00:16:52,780 --> 00:16:56,600
...أعطيتُهم حروفًا وأرقامًا

204
00:16:56,570 --> 00:16:59,240
.أعطيتُهم أشياء كثيرة

205
00:17:00,620 --> 00:17:02,080
كان من الممتع

206
00:17:02,620 --> 00:17:07,000
أن أشاهدهم يبدؤون حياتهم وكلّهم
.براءة ويصبحون أكثر حكمة مع الوقت

207
00:17:08,460 --> 00:17:10,460
.لقد تكاثروا وازدهروا

208
00:17:10,450 --> 00:17:13,540
.نموا كما فعل الجنس البشريّ من قبل

209
00:17:14,610 --> 00:17:18,450
،لكن كلّما اقتربوا من البشريّة

210
00:17:18,450 --> 00:17:20,060
...أدركتُ

211
00:17:21,540 --> 00:17:25,190
.أنّهم لم يكونوا بشرًا

212
00:17:27,300 --> 00:17:30,170
،لا يهمّ إلى أيّ مدى بجّلني المزيّفون

213
00:17:30,170 --> 00:17:32,750
.فما كان ذلك كافيًا ليملأ قلبي المشتاق

214
00:17:34,440 --> 00:17:37,570
...وبعدها عثروا على أطلالٍ ما

215
00:17:38,080 --> 00:17:40,980
.منشأة أبحاث قديمة

216
00:17:42,410 --> 00:17:46,050
،إذا استطعتُ إعادة كلّ التيكنولوجيا والمعرفة المفقودة

217
00:17:46,050 --> 00:17:49,250
.ربّما أستطيع إعادة التاتاري إلى بشر ثانية

218
00:17:49,250 --> 00:17:52,390
،بحثت في كلّ الأطلال في البلاد

219
00:17:52,390 --> 00:17:54,950
.وكرّستُ نفسي لأشكال كثير وعديدة من الأبحاث

220
00:17:56,110 --> 00:17:59,330
.أمضيتُ وقتًا طويلاً جدًّا في مهمّتي

221
00:18:00,280 --> 00:18:02,450
...كانت كلّ ما أملك

222
00:18:02,960 --> 00:18:05,070
.حتّى وإن علمتُ أنّها مستحيلة

223
00:18:06,520 --> 00:18:07,260
...لكن

224
00:18:11,550 --> 00:18:14,220
.عثرتُ على عائلتي أخيرًا

225
00:18:15,430 --> 00:18:18,280
...عائلة؟ لماذا

226
00:18:19,830 --> 00:18:21,900
،أنت ذكيّ للغاية

227
00:18:21,900 --> 00:18:25,890
.لكنّك تتجنّب النّظر للأشياء الّتي لا تريد رؤيتها

228
00:18:27,040 --> 00:18:28,920
.كانت هذه من العادات السّيّئة عندك

229
00:18:32,000 --> 00:18:33,710
فهمت، صحيح؟

230
00:18:38,730 --> 00:18:41,030
أخي... أهذا أنت؟

231
00:18:42,290 --> 00:18:43,910
.مرّ زمن طويل

232
00:18:48,730 --> 00:18:53,230
.تحوّلت زوجتي وابنتي إلى تاتاري أمام عينيّ

233
00:18:53,830 --> 00:18:57,030
...إذًا هونوكا-سان وأنجو

234
00:18:58,900 --> 00:19:01,530
.إنّهما مزيّفتان صنعتُهما لتبدوا مثلهما

235
00:19:02,100 --> 00:19:05,100
أخي، أتماديتَ لذلك الحدّ؟

236
00:19:06,500 --> 00:19:11,550
كنتُ عازمًا على فعل أيّ شيء
.لأهرب من ذلك الجحيم

237
00:19:14,630 --> 00:19:15,990
...والآن، أخيرًا

238
00:19:17,110 --> 00:19:20,930
.يستطيع أحد آخر حمل آمالي

239
00:19:21,930 --> 00:19:26,170
.لنعوّض عن الوقت الّتي ضاع منّا كعائلة

240
00:19:29,310 --> 00:19:30,710
.أهلاً بعودتك يا هاكو

241
00:19:36,810 --> 00:19:38,600
لا بدّ أنّك جائع، صحيح؟

242
00:19:38,600 --> 00:19:40,280
.تفضّل

243
00:19:40,850 --> 00:19:41,490
.أكيد

244
00:19:47,170 --> 00:19:50,040
ماذا؟ لستَ جائعًا؟

245
00:19:50,250 --> 00:19:51,780
...لا، هذا ليس

246
00:19:57,540 --> 00:19:59,050
...أخبريني يا كووُن

247
00:20:01,290 --> 00:20:05,300
ما هي العائلة برأيك؟

248
00:20:06,050 --> 00:20:06,900
ماذا؟

249
00:20:07,810 --> 00:20:09,310
...دعني أفكّر

250
00:20:12,600 --> 00:20:16,110
،إنّهم لطيفون لكن صارمون
،ومزعجون أحيانًا

251
00:20:16,110 --> 00:20:19,240
.وأتمنّى لو يتوقّفون عن الالتصاق بي

252
00:20:19,230 --> 00:20:22,020
،إنّهم يعاملونني كطفلة دائمًا

253
00:20:22,020 --> 00:20:24,810
.ومع ذلك يصرّون على أن أتصرّف كشخص راشد

254
00:20:25,420 --> 00:20:27,740
.أظنّ أنّهم مصدر الكثير من المشاكل

255
00:20:28,410 --> 00:20:29,960
...على رسلك

256
00:20:29,960 --> 00:20:31,100
...ومع ذلك

257
00:20:32,120 --> 00:20:36,550
كلّ تلك المشاكل تجعلني أشعر بالسّعادة
.والدّفء بشكل لا يوصف

258
00:20:41,990 --> 00:20:44,240
!كان هذا محرجًا نوعًا ما

259
00:20:44,240 --> 00:20:45,990
!انسه! انسه

260
00:20:47,770 --> 00:20:52,020
الشّعور بالسّعادة والدّفء بشكل لا يوصف؟

261
00:20:52,390 --> 00:20:54,760
!أخبرتك أن تنساه

262
00:20:54,760 --> 00:20:55,960
!يا إلهي

263
00:20:57,290 --> 00:21:01,130
ألم تُعدّي هذه من أجلي؟

264
00:21:01,130 --> 00:21:02,530
!أظنّ أنّي لا أهتمّ لذلك

265
00:21:02,530 --> 00:21:05,560
!أنا آسف! آسف يا كووُن

266
00:21:17,670 --> 00:21:18,840
لن تخلد للنّوم؟

267
00:21:19,550 --> 00:21:20,510
.لا

268
00:21:20,960 --> 00:21:23,840
،إن بقيت مستيقظًا طوال اللّيل
.فلن تكبر ويشتدّ عودك

269
00:21:23,830 --> 00:21:25,680
.أنا لستُ طفلاً

270
00:21:26,310 --> 00:21:28,680
.لكن أظنّ أنّي حارستك

271
00:21:29,770 --> 00:21:31,430
.هذا صحيح

272
00:21:43,490 --> 00:21:56,210
...إنّها تتدفّق إلى ما وراء الأفق وتختفي

273
00:21:54,870 --> 00:21:55,940
ما هذه الأغنية؟

274
00:21:58,260 --> 00:22:02,570
أظنّ أنّ أمّي قد اعتادت أن تغنّيها
.لي عندما لا أستطيع النّوم

275
00:22:04,420 --> 00:22:05,410
.هكذا إذًا

276
00:22:07,270 --> 00:22:19,880
،يأتي عالم بلا ألوان بشكل ساكن

277
00:22:20,330 --> 00:22:34,130
...ويتوقّف الزّمن بينما أخلد للنّوم

278
00:22:38,720 --> 00:22:44,010
إذًا لا زلتم ترفضون إخباري عن مكان
قبر الأورو السّابق؟

279
00:22:49,570 --> 00:22:56,610
لقد تمكّن أخيرًا من الرّقود بسلام
.بعد رحلة طويلة وعنيفة

280
00:22:57,970 --> 00:23:03,570
كلّ من يعيش في توسكورو
.يدعون له ليرقد بسلام

281
00:23:04,900 --> 00:23:11,780
.اطلب من إمبراطور ياماتو أن يسامحنا لو سمحت

282
00:23:13,230 --> 00:23:15,110
.فهمت

283
00:23:15,110 --> 00:23:18,370
.سأبلّغه بكلّ كلمة

284
00:23:18,370 --> 00:23:19,210
.مع السّلامة