1
00:00:14,240 --> 00:00:18,580
!قوّة الأكوروكا أصبحت لي أخيرًا

2
00:00:18,870 --> 00:00:23,710
!أصبحتَ الآن الحاكم الفعليّ لياماتو

3
00:00:24,790 --> 00:00:27,330
!حان الوقت لتجربته

4
00:00:34,340 --> 00:00:36,470
!كفّ عن المشاهدة وساعدني

5
00:00:36,470 --> 00:00:38,350
.حسنًا، في الحال

6
00:00:39,100 --> 00:00:40,600
.المعذرة

7
00:00:44,060 --> 00:00:45,940
.هنالك فجوة في الجبهة

8
00:00:45,940 --> 00:00:48,360
!قليلاً فحسب... يا ويحي

9
00:01:00,120 --> 00:01:02,660
!سقط القناع

10
00:02:42,340 --> 00:02:46,810
لماذا لا تعترف بالأمر فحسب يا أوشُتورو-دونو؟

11
00:02:50,310 --> 00:02:52,230
.ليس أمامنا خيار آخر إذًا

12
00:02:52,730 --> 00:02:56,070
،إن استمررت على التزام الصّمت

13
00:02:56,820 --> 00:02:59,860
.فلا يمكننا الكفّ عن جلدك

14
00:03:01,450 --> 00:03:02,280
.جهّز نفسك

15
00:03:09,540 --> 00:03:10,830
!فوراي-ساما

16
00:03:29,180 --> 00:03:31,230
...فوراي-دونو

17
00:03:32,100 --> 00:03:36,020
.هذه هي نهاية الرّجل الّذي اعتبرتُه صِنْوي

18
00:03:37,270 --> 00:03:39,650
كيف حال الأميرة؟

19
00:03:40,530 --> 00:03:44,660
أنت قلق على حال الأميرة حتّى في وضعك هذا؟

20
00:03:45,740 --> 00:03:47,280
لا زلت لا تُدرك الأمر؟

21
00:03:48,950 --> 00:03:50,500
،مات الإمبراطور

22
00:03:51,710 --> 00:03:54,540
وقادة الأعمدة الثّمانية قد بدأوا

23
00:03:54,540 --> 00:03:57,590
.يشكّون في بعضهم ويتآمرون لاستلام السّلطة

24
00:03:57,590 --> 00:03:59,960
.تقرّبتَ كثيرًا للأميرة

25
00:04:00,260 --> 00:04:05,510
.هنالك أشخاص شكّكوا في ولائك ودبّروا مكيدة لك

26
00:04:07,100 --> 00:04:10,020
.قوّاتك موجودة في الخارج تستعجل القصر

27
00:04:10,980 --> 00:04:13,640
وسكّان المدينة الّذين يؤمنون ببراءتك

28
00:04:13,640 --> 00:04:15,770
.يُشرفون على الهيجان

29
00:04:16,650 --> 00:04:22,820
من الممكن أنّ هذا كان مصير ياماتو
.في اللّحظة الّتي خسرتْ فيها إمبراطورها

30
00:04:23,740 --> 00:04:24,860
...لكن

31
00:04:24,860 --> 00:04:27,530
.لا أستطيع السّماح باستمرار هذا

32
00:04:28,280 --> 00:04:30,950
إنّ كلّ من يجلب الفوضى إلى ياماتو
.هو عدوّ للإمبراطور

33
00:04:31,750 --> 00:04:35,290
.يجب أن يُقتّلوا هم وعائلاتهم

34
00:04:37,880 --> 00:04:39,040
...ولكن

35
00:04:39,040 --> 00:04:43,010
...إن اعترفتَ بجرائمك وقدّمتَ نفسك للجلاّد

36
00:04:44,680 --> 00:04:46,800
...يا قائد اليمين أوشُتورو

37
00:04:48,140 --> 00:04:51,140
.مُت من أجل صالحِ ياماتو

38
00:04:53,730 --> 00:04:56,400
اختار أوشُتورو الموت؟

39
00:05:01,320 --> 00:05:03,650
والأميرة؟

40
00:05:03,650 --> 00:05:06,700
.يبدو أنّها قد نجت

41
00:05:06,700 --> 00:05:08,160
.لا أستطيع قبول هذا

42
00:05:08,160 --> 00:05:10,830
لماذا عرض أوشُتورو أن يضحّي بحياته؟

43
00:05:10,830 --> 00:05:12,240
.هذا صحيح

44
00:05:12,240 --> 00:05:14,200
!إنّه لم يقترف أيّ ذنب

45
00:05:14,910 --> 00:05:17,620
.إنّه يضحّي بنفسه من أجل صالحِ الشّعب

46
00:05:19,080 --> 00:05:20,840
.هذا من شِيمه ببساطة

47
00:05:21,170 --> 00:05:22,170
...نيكوني

48
00:05:23,420 --> 00:05:24,670
ماذا علينا أن نفعل يا هاكو؟

49
00:05:25,470 --> 00:05:27,590
.علينا أن نسرع إذا كنّا سننقذه

50
00:05:27,590 --> 00:05:29,970
.سيتمّ تنفيذ الحُكم اليوم عند غروب الشّمس

51
00:05:29,970 --> 00:05:31,100
.أظنّ أنّ الوقت يداهمنا

52
00:05:31,100 --> 00:05:32,890
...صحيح

53
00:05:32,890 --> 00:05:35,600
.لكنّ المشكلة تكمن فيما سيحدث بعد إنقاذه

54
00:05:36,270 --> 00:05:38,850
.سوف يسعون خلفنا بكلّ تأكيد

55
00:05:39,270 --> 00:05:41,610
لن يدعونا نفلت بسهولة، صحيح؟

56
00:05:45,440 --> 00:05:47,030
.لنذهب إلى إنّاكاموي

57
00:05:48,450 --> 00:05:49,620
إنّاكاموي؟

58
00:05:49,620 --> 00:05:50,820
.نعم

59
00:05:50,820 --> 00:05:53,620
.إنّاكاموي هي موطننا

60
00:05:53,620 --> 00:05:55,120
.سنكون في مأمن هناك

61
00:05:55,450 --> 00:05:57,000
أهذا خيار جيّد؟

62
00:05:57,500 --> 00:05:59,120
،حتّى وإن كانت موطنكم

63
00:05:59,120 --> 00:06:04,880
فسيظلّ مشتبهًا به هاربًا ومطلوبًا
.لمحاولته اغتيال الأميرة

64
00:06:04,880 --> 00:06:06,550
.دعوا الأمر لي

65
00:06:06,550 --> 00:06:09,130
.سأذهب إلى هناك أوّلاً وأقنعهم

66
00:06:09,760 --> 00:06:12,510
.من النّادر سماعك تقول شيئًا رائعًا

67
00:06:12,760 --> 00:06:16,520
!غير صحيح! لم يكن هنالك ضرورة لذلك التّعليق

68
00:06:21,150 --> 00:06:23,070
.خذ شينونون معك

69
00:06:25,070 --> 00:06:29,530
لا أستطيع جعلك تواجه الخطر بمفردك، صحيح؟

70
00:06:29,910 --> 00:06:31,280
ياكوتواروتو؟

71
00:06:31,280 --> 00:06:34,540
!كلاّ! أريد الذّهاب مع أبي

72
00:06:34,540 --> 00:06:36,540
!لا أريد الذّهاب مع كيورو

73
00:06:36,750 --> 00:06:39,040
...لا... أنا... سوف

74
00:06:39,040 --> 00:06:40,540
...شينونون

75
00:06:43,000 --> 00:06:45,840
.لا بأس، سنغادر الآن

76
00:06:47,050 --> 00:06:47,800
.لنذهب

77
00:06:54,760 --> 00:06:58,140
!كيورو! سأتركك وأذهب إن لم تسرع يا كيورو

78
00:06:58,890 --> 00:06:59,600
.مع السّلامة

79
00:07:00,140 --> 00:07:01,190
.أنا أعتمد عليك

80
00:07:03,020 --> 00:07:05,570
.عليكما أن تعودا إلى القصر يا أتويْ وروروتي

81
00:07:06,610 --> 00:07:07,570
القصر؟

82
00:07:07,820 --> 00:07:10,570
.ما أنا على وشك القيام به يعتبر جريمة

83
00:07:11,910 --> 00:07:13,820
.أنتما أميرتين لبلاديكما

84
00:07:13,820 --> 00:07:15,830
.لا أستطيع توريطكما في الأمر

85
00:07:15,830 --> 00:07:18,910
.يا سيّدي، لا تقل هذا

86
00:07:18,910 --> 00:07:21,670
.دعنا نساعد

87
00:07:21,670 --> 00:07:22,620
.كلاّ

88
00:07:22,620 --> 00:07:24,080
...لكن

89
00:07:24,080 --> 00:07:25,420
.لا بأس

90
00:07:25,420 --> 00:07:27,250
.دعا الأمر لنا

91
00:07:27,880 --> 00:07:31,090
سنُعلمكما بمجرّد أن نصل
.إلى إنّاكاموي على ما أظنّ

92
00:07:31,090 --> 00:07:32,590
...كووُن-هان

93
00:07:35,930 --> 00:07:38,100
.أتويْ-ساما، لنذهب

94
00:07:40,430 --> 00:07:42,100
.أظنّ أنّ لا خيار أمامنا

95
00:07:44,610 --> 00:07:46,610
.حسنًا، لنبدأ

96
00:07:46,900 --> 00:07:47,650
.نعم

97
00:07:48,730 --> 00:07:51,820
.أفهم أنّكِ تريدين احترام مشاعر أوشُتورو

98
00:07:51,820 --> 00:07:54,660
.لكن لهذا السّبب بالتّحديد عليه أن يعيش

99
00:07:56,950 --> 00:08:01,620
أنتِ تعرفين أكثر من أيّ أحد آخر
.كم يهتمّ من أجل الشّعب

100
00:08:02,080 --> 00:08:07,040
،أعتقد أنّه في أوقات كهذه
.فإنّ ياماتو بأشدّ الحاجة لأوشُتورو

101
00:08:07,040 --> 00:08:09,760
أؤمن أنّ هنالك أشياءً تحتاج أن يكون
.على قيد الحياة للقيام بها

102
00:08:11,130 --> 00:08:12,420
...هاكو-سان

103
00:08:13,880 --> 00:08:14,640
.أجل

104
00:08:17,010 --> 00:08:19,640
.خذ هذه لرجال أوشُتورو

105
00:08:19,970 --> 00:08:23,350
.أخبرهم ألاّ يقوموا بأيّ شيء متهوّر

106
00:08:23,980 --> 00:08:25,020
.دع الأمر لي

107
00:08:26,980 --> 00:08:28,110
.حسنًا، لنذهب

108
00:08:28,110 --> 00:08:30,400
.سوف ننقذ أوشُتورو والأميرة

109
00:08:31,030 --> 00:08:32,150
الأميرة أيضًا؟

110
00:08:33,320 --> 00:08:37,830
لا بدّ أنّ ما حاول تسميمها في البداية
.لن يستسلم الآن كائنًا من كان

111
00:08:38,870 --> 00:08:41,700
.سننقذ أنا ونيكوني أوشُتورو

112
00:08:42,160 --> 00:08:44,290
.ستهتمّان يا كووُن وياكوتواروتو بأمر أنجو

113
00:08:44,670 --> 00:08:46,330
.لن أخذلك أبدًا

114
00:08:46,330 --> 00:08:48,210
.ناسوري، أمّني لنا سفينة

115
00:08:48,210 --> 00:08:50,300
.سنتقابل في منطقة المخازن شرقًا

116
00:08:50,300 --> 00:08:51,420
.مفهوم

117
00:08:52,630 --> 00:08:56,550
أورورو، سارانا، أتستطيعان إدخالنا للقصر؟

118
00:08:56,760 --> 00:08:57,510
.لا

119
00:08:58,220 --> 00:09:01,060
.هنالك من وضع حاجزًا قويًّا حوله

120
00:09:01,970 --> 00:09:03,430
.لا نستطيع القيام بأيّ شيء

121
00:09:03,430 --> 00:09:05,810
.سوف يكتشفون أمرنا إن حاولنا ذلك

122
00:09:06,100 --> 00:09:07,440
ما العمل إذًا؟

123
00:09:07,940 --> 00:09:09,650
أسنهاجم من الباب الأماميّ؟

124
00:09:13,650 --> 00:09:14,530
هاكو؟

125
00:09:15,570 --> 00:09:16,570
.سأذهب لقضاء حاجتي

126
00:09:16,910 --> 00:09:18,820
.نـ-نعم، حسنًا

127
00:09:23,870 --> 00:09:25,580
.يبدو أنّك تواجه بعض المشاكل

128
00:09:27,880 --> 00:09:28,750
...كارورا

129
00:09:29,540 --> 00:09:31,880
.أستطيع  توفير المساعدة إن احتجتَها

130
00:09:38,800 --> 00:09:40,970
!وجدتُ طريقة لدخول القصر

131
00:09:43,850 --> 00:09:45,480
.سوف نذهب عبر المجاري

132
00:09:45,890 --> 00:09:49,020
.لم تكن لي أدنى فكرة عن وجود طريق كهذه

133
00:09:49,440 --> 00:09:51,570
من أين حصلتَ على هذا؟

134
00:09:58,990 --> 00:10:01,660
.سيصبح المكان أكثر هدوءًا بعد اليوم

135
00:10:06,750 --> 00:10:07,370
—أمّـ

136
00:10:09,880 --> 00:10:11,750
...أ-أختي

137
00:10:24,350 --> 00:10:25,520
.اذهبي

138
00:10:26,890 --> 00:10:28,640
.لا تأكلي كثيرًا

139
00:10:41,780 --> 00:10:43,530
...لحظة

140
00:10:44,990 --> 00:10:46,120
هنا؟

141
00:10:52,750 --> 00:10:54,500
باب خفيّ؟

142
00:11:05,100 --> 00:11:07,390
.لا يختلف هذا عن تنظيف المجاري

143
00:11:10,310 --> 00:11:14,400
إذًا فقد استطعتَ إقناعه بالاعتراف
مقابل أرواح الشّعب؟

144
00:11:16,360 --> 00:11:18,280
.تلك كانت الخطّة منذ البداية

145
00:11:18,990 --> 00:11:23,780
على هذه الحالة، سيسيطر فوراي
!على ياماتو يا ديكوبونبو-ساما

146
00:11:23,780 --> 00:11:25,780
.لا تقلق

147
00:11:25,780 --> 00:11:29,040
.يمكننا أن نبدأ تحرّكنا بعد موت أوشُتورو

148
00:11:31,920 --> 00:11:37,920
أولئك الّذين يفتقرون للقوّة لا يحقّ لهم
.التّحدّث عن العدالة والمُثُل

149
00:11:38,800 --> 00:11:41,300
.الحقّ دائمًا مع الأقوى

150
00:11:42,260 --> 00:11:45,220
،بعد موت الإمبراطور العظيم

151
00:11:45,220 --> 00:11:50,560
!يجب أن يحكم ياماتو شخص ذو قوّة حقيقيّة

152
00:12:03,700 --> 00:12:06,280
.ستكون هذه آخر طريق يسلكها

153
00:12:06,280 --> 00:12:08,620
.لنزيّنها بشكل لائق

154
00:12:08,620 --> 00:12:09,200
!حاضر

155
00:12:09,200 --> 00:12:14,500
لا أطيق الانتظار حتّى أرى النّظرة الّتي
!ستعلو وجه أوشُتورو وهو يُعدم

156
00:12:25,890 --> 00:12:28,850
.أتويْ-ساما، اهدئي

157
00:12:28,850 --> 00:12:30,850
...لكنّ الوقت

158
00:12:31,100 --> 00:12:33,890
...هذا صحيح، لكن

159
00:12:40,690 --> 00:12:43,240
،بعد كلّ ذلك الحديث عن الولاء
حاول أن يسمّمها؟

160
00:12:43,820 --> 00:12:46,950
.أظهر أوشُتورو حقيقته أخيرًا

161
00:12:47,490 --> 00:12:50,450
.لطالما وجدتُه مثيرًا للشّبهات

162
00:12:50,660 --> 00:12:55,420
.صحيح. سبق وأخبرتهم أنّه لا يمكننا أن نثق بدخيل

163
00:12:58,790 --> 00:12:59,710
.لنذهب

164
00:13:14,230 --> 00:13:15,690
!نطلب منك القليل من الدّعم

165
00:13:15,690 --> 00:13:18,480
...لا أدري يا آنسة

166
00:13:22,480 --> 00:13:25,070
.غرفة نوم أنجو بعد هذا الدّرج

167
00:13:25,070 --> 00:13:27,990
.أظنّ أنّنا لن نصل إلى هناك بسهولة

168
00:13:27,990 --> 00:13:28,990
.دعي الأمر لي

169
00:13:38,710 --> 00:13:40,040
.أحسنت

170
00:13:41,210 --> 00:13:42,340
!دخلاء

171
00:13:51,010 --> 00:13:52,720
.أحسنتِ بدورك أيضًا

172
00:13:53,270 --> 00:13:54,220
.أظنّ أنّ علينا أن نسرع

173
00:14:03,690 --> 00:14:07,030
أتينا لإنقاذ الأميرة الإمبراطوريّة بأوامر

174
00:14:07,030 --> 00:14:09,240
.من أميرتَيْ كوجوري وشاهّورو

175
00:14:10,200 --> 00:14:11,490
.تفضّلا

176
00:14:12,370 --> 00:14:13,580
.المعذرة

177
00:14:20,290 --> 00:14:21,000
!أنجو

178
00:14:21,250 --> 00:14:23,420
.لا أعرف ما السّمّ الّذي تناولته

179
00:14:24,300 --> 00:14:26,090
...إنّها على هذه الحال مذّاك الحين

180
00:14:26,670 --> 00:14:28,090
هلّي أن ألقي نظرة عليها؟

181
00:14:38,520 --> 00:14:40,940
...لا أدري إن كان هذا سيجدي نفعًا، لكن

182
00:14:46,240 --> 00:14:47,030
.اشربي

183
00:14:53,370 --> 00:14:55,330
هاكو-ساما ليس برفقتكما؟

184
00:14:57,790 --> 00:15:00,670
.لقد ذهب لإنقاذ أوشُتورو

185
00:15:01,380 --> 00:15:02,670
.فهمت

186
00:15:06,880 --> 00:15:09,550
.اهتمّي بأنجو من أجلي

187
00:15:12,090 --> 00:15:14,100
.حاضرة. أعدك

188
00:15:14,100 --> 00:15:15,100
.المعذرة

189
00:15:42,370 --> 00:15:44,340
.أحبّ هذا اللّمعان

190
00:15:48,380 --> 00:15:50,840
.نحن نعتمد عليك يا سيّدي

191
00:15:57,890 --> 00:15:58,600
من هناك؟

192
00:16:00,680 --> 00:16:01,730
!توقّف

193
00:16:01,730 --> 00:16:02,980
!دخيل

194
00:16:09,740 --> 00:16:10,320
!نيكوني

195
00:16:11,030 --> 00:16:11,570
!المفاتيح

196
00:16:11,570 --> 00:16:12,820
!أعلم

197
00:16:17,870 --> 00:16:19,040
!أوشُتورو-ساما

198
00:16:19,830 --> 00:16:21,960
!أتينا لإنقاذك يا أوشُتورو-ساما

199
00:16:22,410 --> 00:16:23,790
...هاكو-دونو

200
00:16:25,540 --> 00:16:28,090
...أوشُتورو-ساما، ظهرك قد

201
00:16:28,340 --> 00:16:30,010
.هذا لا شيء

202
00:16:30,010 --> 00:16:31,880
كيف حال المدينة؟

203
00:16:32,840 --> 00:16:35,260
.أخشى أنّها ليست جيّدة

204
00:16:35,760 --> 00:16:38,600
.قد تندلع حرب في أيّة لحظة

205
00:16:39,680 --> 00:16:40,600
.هكذا إذًا

206
00:16:40,600 --> 00:16:42,430
.الأهمّ الآن هو ألاّ وقت لدينا

207
00:16:42,430 --> 00:16:44,600
.علينا إخراجك من هنا

208
00:16:45,400 --> 00:16:46,360
إخراجي من هنا؟

209
00:16:46,560 --> 00:16:48,860
.سوف نختبئ في إنّاكاموي في الوقت الحاليّ

210
00:16:49,780 --> 00:16:52,240
.سننتظر حتّى تهدأ الأوضاع

211
00:16:52,240 --> 00:16:56,370
أرسلتُ كيورو إليهم ليقنعهم
.بالسّماح لنا بالبقاء هناك

212
00:16:58,580 --> 00:17:02,160
،أطلعنا حرسك الإمبراطوريّ على الخطّة

213
00:17:02,160 --> 00:17:04,870
.وذهبت أختي لإنقاذ الأميرة

214
00:17:04,870 --> 00:17:07,000
.لا تمت هباءً في مكان كهذا

215
00:17:07,000 --> 00:17:08,130
!سوف نغادر

216
00:17:09,550 --> 00:17:10,800
.لا أستطيع

217
00:17:12,300 --> 00:17:14,130
لا تستطيع؟ لماذا؟

218
00:17:14,590 --> 00:17:16,890
.لأنّ هذا من أجل صالحِ ياماتو

219
00:17:18,140 --> 00:17:20,350
صالحُ ياماتو؟

220
00:17:20,350 --> 00:17:23,390
.يمتلئ القصر بالمؤامرات والدّسائس

221
00:17:24,390 --> 00:17:28,190
،حتّى إن حُلّت مسألة تسميم الأميرة

222
00:17:28,190 --> 00:17:29,980
.فسيستمرّ الصّراع على القوّة

223
00:17:31,110 --> 00:17:35,400
.سيبدأ قادة الأعمدة الثّمانية بالتآمر ضدّ بعضهم

224
00:17:36,820 --> 00:17:40,080
.وإن فعلوا، فإنّ الشّعب هو من سيعاني في النّهاية

225
00:17:41,620 --> 00:17:45,660
.لقد عهدت بمستقبل العاصمة الإمبراطوريّة إلى فوراي

226
00:17:47,670 --> 00:17:51,670
.ولاؤه للإمبراطور لا نظير له

227
00:17:52,090 --> 00:17:57,180
.سيحافظ على مجد الإمبراطور وسيقود شعب ياماتو

228
00:17:58,510 --> 00:18:02,260
.لا قيمة لحياتي مقابل ذلك

229
00:18:05,930 --> 00:18:07,560
.هذا ليس صحيحًا

230
00:18:09,310 --> 00:18:13,570
.صحيح أنّ فوراي قد يكون مخلصًا للإمبراطور

231
00:18:14,190 --> 00:18:17,570
...لكنّ ما فعله في أوزوروشّا

232
00:18:22,120 --> 00:18:23,950
،أعتقد أنّك يا أوشُتورو

233
00:18:23,950 --> 00:18:30,540
.الوحيد القادر على جلب السّعادة الحقيقيّة للشّعب

234
00:18:30,920 --> 00:18:34,510
أنت الوحيد القادر على التّحاور مع الشّعب وبناء بلاد

235
00:18:34,510 --> 00:18:35,840
.هدفها هو منفعتهم

236
00:18:37,090 --> 00:18:38,430
...أخي

237
00:18:41,640 --> 00:18:43,310
.أخذتُ قراري وانتهينا

238
00:18:43,310 --> 00:18:44,430
!أوشُتورو

239
00:18:48,940 --> 00:18:49,940
!لقد تأخّروا

240
00:18:49,940 --> 00:18:50,900
!نوسوري

241
00:18:51,360 --> 00:18:51,940
هل وصلوا؟

242
00:18:52,730 --> 00:18:54,020
!تأخّرتم

243
00:18:54,020 --> 00:18:55,150
.آسفة على ما أظنّ

244
00:18:57,030 --> 00:18:57,860
أين هاكو؟

245
00:18:57,860 --> 00:18:58,820
.لم يأتِ بعد

246
00:18:58,820 --> 00:19:00,490
ماذا؟ لم يأتِ بعد؟

247
00:19:13,090 --> 00:19:14,210
...الشّمس

248
00:19:14,210 --> 00:19:16,050
.قد غربت

249
00:19:17,210 --> 00:19:19,510
.أحضرا أوشُتورو

250
00:19:19,510 --> 00:19:20,220
!حاضر

251
00:19:22,850 --> 00:19:24,260
هل فشل؟

252
00:19:25,260 --> 00:19:26,100
...هاكو

253
00:19:32,600 --> 00:19:33,610
!أوشُتورو

254
00:19:33,860 --> 00:19:35,400
.انسوا أمري

255
00:19:35,940 --> 00:19:38,110
.اهرب يا هاكو-دونو

256
00:19:49,710 --> 00:19:51,330
.أنا باقٍ هنا أيضًا

257
00:19:51,330 --> 00:19:52,000
!هاكو-دونو

258
00:19:53,630 --> 00:19:54,380
!نيكوني

259
00:19:59,970 --> 00:20:01,340
!رورو-يان

260
00:20:01,340 --> 00:20:02,630
...هاكو-ساما

261
00:20:24,490 --> 00:20:25,530
...أهذا

262
00:20:31,540 --> 00:20:34,170
.انتهى أمره أخيرًا

263
00:20:34,170 --> 00:20:35,960
!هرب أوشُتورو

264
00:20:49,180 --> 00:20:50,430
.لقد توقّف

265
00:20:50,430 --> 00:20:52,060
.آسفون على التّأخير

266
00:20:54,900 --> 00:20:56,060
!هاكو

267
00:20:56,060 --> 00:20:58,730
!سُحقًا لك يا أوشُتورو

268
00:20:59,320 --> 00:21:01,070
!أمسكوا به

269
00:21:08,580 --> 00:21:09,740
!تأخّرت

270
00:21:09,740 --> 00:21:10,950
.لم يكن بوسعنا شيء

271
00:21:10,950 --> 00:21:12,450
.إنّه عنيد

272
00:21:12,790 --> 00:21:15,710
.كدتُ أتسبّب بمقتلي

273
00:21:15,710 --> 00:21:19,960
لم تكن تنوي مشاركتي مصيري؟

274
00:21:20,300 --> 00:21:22,130
.بالطّبع لا

275
00:21:22,130 --> 00:21:24,380
.قلتُ ذلك فحسب لأنّه لم يكن لديّ خيار آخر

276
00:21:24,380 --> 00:21:25,970
.لقد كان ذلك مخيفًا

277
00:21:25,970 --> 00:21:29,600
...فعلاً؟ كنتُ واثقة أنّك

278
00:21:30,310 --> 00:21:31,220
كيف حال الأميرة؟

279
00:21:31,220 --> 00:21:32,850
.انخفضت حرارتها

280
00:21:32,850 --> 00:21:34,350
.أظنّ أنّه لا يوجد ما يدعو للقلق

281
00:21:34,350 --> 00:21:36,980
.يمكنكما أن تسعدا بلقائكما لاحقًا

282
00:21:37,270 --> 00:21:38,560
.السّفينة هناك

283
00:21:41,730 --> 00:21:43,240
!ها قد أتوا

284
00:21:48,530 --> 00:21:51,120
.دعوا الأمر لي

285
00:21:55,830 --> 00:21:56,620
!أبي