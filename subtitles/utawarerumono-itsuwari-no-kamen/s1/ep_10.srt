1
00:00:05,690 --> 00:00:07,020
واقعة في حبّه؟

2
00:00:08,070 --> 00:00:09,320
!تمامًا

3
00:00:10,280 --> 00:00:13,650
لحظة، هل بإمكانك قول ذلك مجدّدًا على ما أظنّ؟

4
00:00:13,650 --> 00:00:15,700
من هذا الّذي تحبّينه؟

5
00:00:15,700 --> 00:00:17,990
!سبق وأخبرتُكنّ. إنّه أوشُتورو

6
00:00:23,170 --> 00:00:25,900
.أظنّ أنّ هذه ستكون مشكلة

7
00:00:26,680 --> 00:00:30,210
...حسنًا، لقد تأخّر الوقت

8
00:00:30,210 --> 00:00:31,440
.هذا صحيح

9
00:00:31,440 --> 00:00:34,150
.حان موعد نوم الأطفال الصّغار

10
00:00:35,320 --> 00:00:37,190
.مهلاً لحظة

11
00:00:38,770 --> 00:00:42,220
.الحبّ أمر رائع

12
00:00:43,160 --> 00:00:46,450
.أريد مساعدتَها

13
00:00:46,450 --> 00:00:49,840
...لكن يا أتويْ، الحبّ

14
00:00:51,420 --> 00:00:53,200
.سأكرّر كلامي

15
00:00:53,200 --> 00:00:55,990
!حان موعد نوم الأطفال الصّغار

16
00:02:28,770 --> 00:02:31,210
.تساءلتُ لماذا تمّ استدعائي في منتصف اللّيل

17
00:02:32,210 --> 00:02:33,590
...أظنّ أنّ هذا هو السّبب

18
00:02:36,120 --> 00:02:37,840
...ولكن

19
00:02:38,340 --> 00:02:42,100
.هذا عمل من الأخ الكبير الّذي تحترمه كثيرًا

20
00:02:42,860 --> 00:02:45,230
!سأقوم بهذا من دواعي سروري

21
00:02:49,660 --> 00:02:50,620
ما ذلك؟

22
00:02:55,650 --> 00:02:57,610
.دعنَ الأمر لي

23
00:02:58,320 --> 00:03:00,740
.أظنّ أنّه من السّيّئ أن نتدخّل في الأمر

24
00:03:00,740 --> 00:03:02,720
.سيتسبّب هذا في مشاكل أكثر

25
00:03:02,720 --> 00:03:07,370
.لكن أنجو-ساما كانت لطيفة كفاية لتأتيَ إلينا

26
00:03:07,370 --> 00:03:08,620
!هذا صحيح

27
00:03:09,020 --> 00:03:10,290
!كنتُ لطيف كفاية لآتيَ إليكنّ

28
00:03:12,810 --> 00:03:14,650
...لكن اسمعي يا أنجو

29
00:03:14,650 --> 00:03:16,430
.تأخّر الوقت

30
00:03:16,430 --> 00:03:20,480
،إذا كنتِ في الخارج في هذه السّاعة
.أظنّ أنّه ستكون هنالك فوضى في القصر

31
00:03:20,480 --> 00:03:22,300
!لا داعيَ للقلق

32
00:03:22,300 --> 00:03:25,390
!لقد جهّزتُ بديلة لي

33
00:03:25,390 --> 00:03:29,640
ما كنتُ لأريد أن يُصرخ في وجهي فقط
.لمجرّد مغادرتي لبعض الوقت

34
00:03:30,490 --> 00:03:32,780
.سأذهب لأنادي مونيتشيكا-ساما

35
00:03:33,200 --> 00:03:34,520
.لن تجديها هناك

36
00:03:35,730 --> 00:03:39,110
،"!قالت سابقًا، "إلى المعركة! حان وقت التّدريب

37
00:03:39,130 --> 00:03:42,440
،وعقدت حاجبيها هكذا، بل وأقرب من المعتاد

38
00:03:42,440 --> 00:03:43,910
!وغادرت

39
00:03:43,910 --> 00:03:46,410
.من أجل معركة تدريبيّة ليليّة

40
00:03:46,820 --> 00:03:48,510
!كلاّ

41
00:03:49,680 --> 00:03:51,020
.بالمناسبة يا هاكو-سان

42
00:03:51,480 --> 00:03:54,310
هل سبق وسمعتَ بأمر اللّصوص النّبلاء؟

43
00:03:54,310 --> 00:03:55,610
اللّصوص النّبلاء؟

44
00:03:55,610 --> 00:03:56,420
.نعم

45
00:03:56,840 --> 00:03:59,030
،إنّهم يسرقون المال من الأشرار الأغنياء

46
00:03:59,030 --> 00:04:02,170
.ويمنحونه إلى عامّة النّاس في العاصمة على ما أظنّ

47
00:04:04,750 --> 00:04:07,720
.هذا لطف منهم

48
00:04:07,720 --> 00:04:10,430
لكن إن كانوا يسرقون من الأشرار
فحسب، فأين المشكلة؟

49
00:04:10,430 --> 00:04:12,460
...حسنًا، إنّ الأمر

50
00:04:13,250 --> 00:04:15,440
...حسبما سمعت

51
00:04:18,000 --> 00:04:19,910
...فإنّ هؤلاء اللّصوص النّبلاء كما يدّعون

52
00:04:21,920 --> 00:04:22,940
!إنّهم اللّصوص النّبلاء

53
00:04:22,940 --> 00:04:24,810
!لقد عادوا

54
00:04:24,810 --> 00:04:26,100
!خبّئوا أطفالكم

55
00:04:26,100 --> 00:04:27,700
!انتبهوا لأغراضكم النّفسية

56
00:04:27,910 --> 00:04:30,620
!أمسكوا بهم! أمسكوا بهم

57
00:04:37,230 --> 00:04:39,000
،من أجل صالح الجميع

58
00:04:39,000 --> 00:04:41,160
،أعاقب الفاسدين الّذين يملأون جيوبهم

59
00:04:41,160 --> 00:04:43,470
!باسم السّماء

60
00:04:44,670 --> 00:04:46,430
!خذوها الآن

61
00:04:46,430 --> 00:04:48,120
!إنّها تُمطر نِعَمًا

62
00:05:00,230 --> 00:05:01,240
!مهلاً

63
00:05:01,240 --> 00:05:04,100
!لقد نام للتّوّ، وها قد أيقظته ثانية

64
00:05:04,100 --> 00:05:06,990
،بإمكانكم رمي هذا الشّيء عليّ
!لكن أتعتقدون أنّي سأستعمله؟

65
00:05:06,990 --> 00:05:09,130
انسوا هذا الأمر وادفعوا لي مقابل
!أضرار الّتي لحقت بسقفي

66
00:05:14,150 --> 00:05:15,250
.أختي

67
00:05:17,220 --> 00:05:21,370
.لا زال هنالك آخرون بانتظار وصولك

68
00:05:21,370 --> 00:05:22,190
.لنذهب

69
00:05:22,190 --> 00:05:23,290
.هكذا إذًا

70
00:05:24,110 --> 00:05:28,110
.المرأة الجيّدة هي الّتي ينتظرها الكثيرون

71
00:05:28,110 --> 00:05:30,060
.ربّما هذا صحيح يا أختي

72
00:05:31,350 --> 00:05:32,990
!رائحة قذرة

73
00:05:33,400 --> 00:05:35,140
.هذه قصّتهم

74
00:05:37,370 --> 00:05:39,670
.حسنًا، يبدو أنّهم مزعجون

75
00:05:39,670 --> 00:05:40,900
.معك حقّ

76
00:05:42,230 --> 00:05:46,240
.علينا أن نجاريها حتّى تخلد للنّوم على ما أظنّ

77
00:05:46,240 --> 00:05:49,820
ما رأيكما بهذا؟

78
00:05:52,590 --> 00:05:53,880
كتاب؟

79
00:05:55,930 --> 00:05:57,160
ماذا؟

80
00:05:57,160 --> 00:05:59,430
.لا أشعر بالنّوم الآن

81
00:05:59,430 --> 00:06:00,790
.يا أنجو

82
00:06:03,240 --> 00:06:05,270
.سنقصّ عليك قصّة

83
00:06:06,220 --> 00:06:07,840
أقلتِ قصّة؟

84
00:06:07,840 --> 00:06:13,100
.هذا هو الاستعداد المناسب لقصّ قصّة

85
00:06:13,110 --> 00:06:14,100
.هكذا إذًا

86
00:06:16,730 --> 00:06:19,650
!حسنًا، سأقرأ القصّة

87
00:06:20,910 --> 00:06:24,390
،كان يا ما كان، في قديم الزّمان

88
00:06:24,390 --> 00:06:27,170
...إله يافع لم يكن لديه حتّى اسم

89
00:06:27,170 --> 00:06:28,110
،على أيّ حال

90
00:06:28,530 --> 00:06:32,620
لن أسمح لهم بالتّسبّب في المزيد من
!الفوضى في المدينة دون علم أخي

91
00:06:33,030 --> 00:06:34,870
لن تسمح لهم؟

92
00:06:34,870 --> 00:06:38,290
لماذا لا نذهب ونحاول الإمساك بهم؟

93
00:06:38,290 --> 00:06:39,420
،وللقيام بذلك

94
00:06:39,420 --> 00:06:41,710
!علينا أن نكمل عملنا بسرعة

95
00:06:43,920 --> 00:06:45,500
.اسمع يا كيورو

96
00:06:46,510 --> 00:06:48,670
.لا وجود لشيء يدعى عمل ليس مهمًّا

97
00:06:48,670 --> 00:06:51,640
...بمجرّد أن تقوم بهذا لفترة، ستدرك ذلك

98
00:06:53,260 --> 00:06:54,680
لا تريد الذّهاب فحسب، صحيح؟

99
00:06:55,970 --> 00:07:00,640
،وأخيرًا، بعد أن فاز بقوّة حبّ الفتاة

100
00:07:00,890 --> 00:07:03,560
...حضنها بشدّة

101
00:07:04,610 --> 00:07:06,150
ماذا حدث بعد ذلك؟

102
00:07:06,480 --> 00:07:09,650
!مهلاً، هذه قصّة حبّ

103
00:07:09,650 --> 00:07:13,280
إن سمعت هذا، ستواجه وقتًا
!أصعب بكثير في النّوم

104
00:07:13,870 --> 00:07:19,160
ومن ثمّ، بحثًا عن الأمان الّذي
...يمنحانه لبعضهما، قاما

105
00:07:21,210 --> 00:07:22,580
أتويْ-ساما؟

106
00:07:40,730 --> 00:07:42,770
...قـ

107
00:07:43,230 --> 00:07:44,150
...قبـ

108
00:07:44,150 --> 00:07:46,110
...قـ-قبـ

109
00:07:46,110 --> 00:07:47,320
ماذا هنالك؟

110
00:07:47,900 --> 00:07:50,030
.ماذا؟ أظنّ أنّها قبلة

111
00:07:50,610 --> 00:07:52,280
ما هي القبلة؟

112
00:07:52,610 --> 00:07:53,530
...إنّها

113
00:07:55,570 --> 00:07:57,910
...حسنًا، إنّها

114
00:07:59,790 --> 00:08:02,290
ما هي القبلة؟

115
00:08:02,830 --> 00:08:05,790
...لـ-لحظة، إنّها

116
00:08:05,790 --> 00:08:09,670
...القبلة ببساطة هي

117
00:08:09,670 --> 00:08:14,260
.عندما تلامس شفاهكِ شفاهَ شخص آخر

118
00:08:14,260 --> 00:08:15,970
.هـ-هذا صحيح

119
00:08:15,970 --> 00:08:18,310
.إنّها طريقة لإظهار حبّك

120
00:08:18,310 --> 00:08:20,810
لماذا قد نقوم بشيء كهذا؟

121
00:08:22,600 --> 00:08:25,310
لـ-لماذا؟

122
00:08:25,560 --> 00:08:28,320
لماذا قد نلمس شفاه شخص آخر بشفاهنا؟

123
00:08:29,980 --> 00:08:31,940
...حسنًا، ذلك

124
00:08:41,200 --> 00:08:42,450
.لقد نامت

125
00:08:42,450 --> 00:08:45,210
!نيكوني-ساما في غاية الظّرافة

126
00:08:45,210 --> 00:08:47,170
.أنا أحسدها

127
00:08:47,170 --> 00:08:50,960
.انظرن ما مدى لمعان خدّيها

128
00:08:52,590 --> 00:08:54,170
.إنّها طفلة بالفعل

129
00:08:54,170 --> 00:08:57,220
.حسنًا، هكذا هم الأطفال

130
00:09:11,320 --> 00:09:15,240
.حسنًا إذًا، سوف أتابع القراءة

131
00:09:17,070 --> 00:09:22,490
.كان يا مكان في قديم الزّمان، رجل كسول للغاية

132
00:09:22,490 --> 00:09:24,750
،لم يكن هذا الرّجل كسولاً فحسب

133
00:09:24,750 --> 00:09:27,670
...لكنّه كان يتصرّف بشكل سيّئ للغاية

134
00:09:27,670 --> 00:09:29,170
ماذا عن القصّة الّتي كنّا بصددها قبل قليل؟

135
00:09:29,170 --> 00:09:31,630
...أنجو-ساما، انسَيْ، انسَيْ

136
00:09:33,510 --> 00:09:34,720
...أنا متعب

137
00:09:35,260 --> 00:09:36,300
...وأشعر بالنّعاس

138
00:09:36,300 --> 00:09:37,510
.والبرد

139
00:09:38,140 --> 00:09:39,510
.أريد الذّهاب للمنزل

140
00:09:40,050 --> 00:09:42,510
...ربّما كانت عاقبة أفعاله أو عقاب إلهيّ

141
00:09:47,600 --> 00:09:50,520
.لكنّه وقع في هاوية عميقة

142
00:09:53,570 --> 00:09:58,610
مدّ يده وهو مذعور، آمِلاً أن يمسك
.بأيّ شيء يستطيع إمساكه

143
00:09:58,610 --> 00:10:01,450
...وبعدها، بمجرّد أن اعتقد أنّ أمر قد انتهى

144
00:10:08,750 --> 00:10:11,040
.تمسّك بشيء ما أخيرًا

145
00:10:11,710 --> 00:10:13,550
...نجوت

146
00:10:15,210 --> 00:10:17,380
—ما-ما-ما

147
00:10:18,180 --> 00:10:19,050
...ما الّذي

148
00:10:20,220 --> 00:10:21,850
ما الّذي تفعله؟

149
00:10:22,930 --> 00:10:24,350
...ما الّذي

150
00:10:24,350 --> 00:10:26,850
!فعلتُه؟

151
00:10:30,190 --> 00:10:35,360
.لكنّه سقط في قاع الهاوية في كلّ الأحوال

152
00:10:37,400 --> 00:10:38,400
.النّهاية

153
00:10:44,160 --> 00:10:46,500
أهذا هو الحبّ؟

154
00:10:47,250 --> 00:10:50,920
...هذا ما ذُكر في الكتاب، لذلك أظنّ ذلك

155
00:10:51,460 --> 00:10:52,250
...إذًا

156
00:10:52,880 --> 00:10:55,960
!كيف أستطيع جعل أوشُتورو يقع في حبّي؟

157
00:10:59,970 --> 00:11:02,930
.أنا أَشبَه بطائر في قفص

158
00:11:02,930 --> 00:11:05,010
.لا أستطيع حتّى الخروج

159
00:11:05,600 --> 00:11:08,560
...أظنّك استطعتِ المجيء إلى هنا

160
00:11:08,560 --> 00:11:12,560
.لقد أخذت كتابي في آخر مرّة أتت فيها إلى هنا

161
00:11:12,560 --> 00:11:16,150
.وذهبنا للتّسوّق معًا من فترة ليست بعيدة

162
00:11:16,440 --> 00:11:22,110
كان أوشُتورو فقط من أراني كمّ أنّ العالم الخارجيّ

163
00:11:22,820 --> 00:11:24,620
!كبير وممتع

164
00:11:27,660 --> 00:11:31,170
...حسنًا، إنّ رجلاً كهذا

165
00:11:31,170 --> 00:11:34,460
.يجعلني أدرك لماذا قد تقع أميرة في حبّه

166
00:11:35,090 --> 00:11:38,210
ألا يوجد ما نستطيع فعله من أجلها؟

167
00:11:43,090 --> 00:11:45,510
.حسنًا، ما باليد حيلة

168
00:11:48,930 --> 00:11:52,190
!لنعقد جميعًا اجتماعًا للتّخطيط لذلك

169
00:11:57,150 --> 00:11:59,570
،بهدف الفوز بقلب رجل

170
00:11:59,570 --> 00:12:02,360
!فما يجب عليك أن تركّزي عليه أكثر هو أنوثتك

171
00:12:06,950 --> 00:12:08,370
هكذا؟

172
00:12:09,910 --> 00:12:12,210
أو هكذا؟

173
00:12:14,080 --> 00:12:16,250
أو ماذا بشأن هذا؟

174
00:12:16,250 --> 00:12:17,750
أهذا مثير؟

175
00:12:22,680 --> 00:12:25,760
أستطيع استعمال هذا لأجعل أوشُتورو
يقع في حبّي، صحيح؟

176
00:12:26,760 --> 00:12:29,310
هـ-هكذا؟

177
00:12:30,100 --> 00:12:32,310
أو ربّما هكذا؟

178
00:12:32,810 --> 00:12:34,850
أو هكذا؟

179
00:12:40,860 --> 00:12:42,440
...صحيح

180
00:12:42,440 --> 00:12:46,160
أظنّ أنّنا نساعد أنجو؟

181
00:12:46,160 --> 00:12:47,410
!أختاه

182
00:12:48,490 --> 00:12:50,580
ما-ما هذا؟

183
00:12:50,580 --> 00:12:52,080
!انضمّي لنا أيضًا

184
00:12:52,960 --> 00:12:54,080
!هذا ممتع

185
00:12:57,080 --> 00:12:58,420
!هكذا

186
00:12:58,420 --> 00:12:59,590
!جرّبي الأمر

187
00:13:02,460 --> 00:13:03,840
،نيكو-يان

188
00:13:04,340 --> 00:13:09,050
.على المرأة أن تردّ دائمًا عندما يتمّ تحدّيها

189
00:13:09,050 --> 00:13:12,680
.أنتِ ظريفة، لذلك أظنّ أنّ بمقدورك أن تنجحي

190
00:13:12,680 --> 00:13:14,230
فـ-فعلاً؟

191
00:13:14,230 --> 00:13:17,600
!لا-لا تضغطي على نفسك كثيرًا يا نيكوني-ساما

192
00:13:22,650 --> 00:13:24,530
هكذا؟

193
00:13:28,870 --> 00:13:30,410
!عرفتُ هذا

194
00:13:30,410 --> 00:13:32,040
!ممتاز

195
00:13:34,790 --> 00:13:36,210
!هذا ظريف

196
00:13:36,210 --> 00:13:39,000
.أنا أحسدك على شبابك

197
00:13:39,340 --> 00:13:41,130
لكن ماذا عن هذا؟

198
00:13:41,130 --> 00:13:42,550
!لن أخسر

199
00:13:45,670 --> 00:13:48,260
.أختي، انتظرتُ كثيرًا

200
00:13:48,890 --> 00:13:50,100
.تفضّلي

201
00:13:50,800 --> 00:13:52,680
.أنا آسفة يا أوغي

202
00:14:09,490 --> 00:14:11,580
.لا أستطيع العودة هكذا

203
00:14:13,080 --> 00:14:14,370
.ما باليد حيلة

204
00:14:22,960 --> 00:14:25,550
.هذا لا يجدي نفعًا فحسب

205
00:14:29,800 --> 00:14:32,300
لا بدّ أنّك تملكين أفكارًا جيّدة، صحيح؟

206
00:14:32,300 --> 00:14:34,350
.دعينا نستمع لها

207
00:14:34,350 --> 00:14:36,520
أ-أنا؟

208
00:14:38,940 --> 00:14:41,110
،إذا أردتِ أن تخبري أحدًا أنّكِ تحبّينه

209
00:14:41,110 --> 00:14:43,940
ربّما عليك أن تكتبي رسالة حبّ؟

210
00:14:47,150 --> 00:14:50,530
إذًا كيف أكتب رسالة حبّ؟

211
00:14:51,280 --> 00:14:53,910
،أ-أنا لم أكتب واحدة من قبل

212
00:14:54,700 --> 00:14:55,580
...لكن

213
00:14:55,870 --> 00:14:57,330
...إن كانت رسمةٌ ما ستفي بالغرض

214
00:15:00,750 --> 00:15:02,250
.أنت موهوبة

215
00:15:02,250 --> 00:15:04,340
.لم أكن أعرف أنّك فنّانة هكذا

216
00:15:04,340 --> 00:15:07,630
.أنا... شكرًا لكنّ

217
00:15:08,970 --> 00:15:11,840
يقولون أنّ السّماء لا تُعطي هداياها
.لنفس الشّخص مرّتين

218
00:15:11,840 --> 00:15:13,100
.أظنّ أنّ ذلك ليس صحيحًا

219
00:15:13,100 --> 00:15:15,140
!أ-أنت تحرجينني

220
00:15:19,810 --> 00:15:21,350
!رجلان

221
00:15:21,350 --> 00:15:22,350
!مذهل

222
00:15:26,530 --> 00:15:30,200
بالمناسبة، لماذا لا يرتدي هذان الرّجلان الملابس؟

223
00:15:30,860 --> 00:15:33,570
!إ-إنّهما يرتديان ملابس خفيّة

224
00:15:34,370 --> 00:15:36,490
!ملابس خفيّة؟ يا للإبداع

225
00:15:36,490 --> 00:15:37,870
!ارسمي المزيد

226
00:15:37,870 --> 00:15:38,660
!حسنًا

227
00:15:38,660 --> 00:15:39,960
!سأبدأ

228
00:15:42,620 --> 00:15:44,590
!هذه رسمة جميلة أيضًا

229
00:15:45,180 --> 00:15:46,820
!وهذه جيّدة أيضًا

230
00:15:46,820 --> 00:15:48,310
من الخلف؟

231
00:15:49,400 --> 00:15:51,350
ربّما نضيف بعض الأصفاد؟

232
00:15:52,750 --> 00:15:55,320
أو نغمض العينين بقطعة قماش؟

233
00:15:56,430 --> 00:15:58,550
!يا للشّغف

234
00:15:58,560 --> 00:16:00,980
...ثمّ... ثمّ

235
00:16:02,380 --> 00:16:03,970
!رورو-يان

236
00:16:11,620 --> 00:16:13,780
.هذا لا يُحتمل

237
00:16:16,850 --> 00:16:19,540
.تأبى الرّائحة أن تزول

238
00:16:20,010 --> 00:16:22,710
لماذا حدث لي هذا؟

239
00:16:34,640 --> 00:16:35,640
!سوف أصادر هذه

240
00:16:36,680 --> 00:16:38,890
!أظنّ أنّ الأمر قد تجاوز حدّه

241
00:16:39,510 --> 00:16:40,780
.لم يعد لي خيار آخر الآن

242
00:16:41,190 --> 00:16:43,180
...سيتوجّب عليّ أن

243
00:16:43,180 --> 00:16:44,310
.مهلاً

244
00:16:46,020 --> 00:16:46,960
ماذا؟

245
00:16:48,780 --> 00:16:54,780
.قيل لي أنّك تعرفين بعض خبايا القلب

246
00:16:55,290 --> 00:16:57,140
أ-أنا؟

247
00:16:57,770 --> 00:17:00,450
.هذا ما قاله

248
00:17:01,240 --> 00:17:04,340
ماذا كان اسمه؟

249
00:17:05,480 --> 00:17:06,830
...هاكو

250
00:17:07,280 --> 00:17:09,370
!صحيح! هاكو

251
00:17:09,380 --> 00:17:12,340
!هذا ما قاله الرّجل المدعوّ هاكو

252
00:17:12,340 --> 00:17:16,220
!قاله! قاله! هاكو! هاكو

253
00:17:18,640 --> 00:17:22,470
.على أيّ حال، لا أصدّق أنّه سقط من دون سابق إنذار

254
00:17:22,480 --> 00:17:25,980
يا إلهي. ما كانت مشكلتها؟

255
00:17:25,980 --> 00:17:27,610
...لا بدّ أنّ ذلك كان

256
00:17:27,600 --> 00:17:29,980
.أجل، نوغيسوموكامي

257
00:17:29,970 --> 00:17:31,520
!لا بدّ من ذلك

258
00:17:31,520 --> 00:17:34,610
.كان اليوم يومًا فظيعًا فحسب

259
00:17:41,830 --> 00:17:43,550
.أنا أعتذر

260
00:17:43,550 --> 00:17:45,690
.بل، أنا من تعتذر

261
00:18:09,730 --> 00:18:11,320
...نوغيسوموكامي

262
00:18:12,710 --> 00:18:17,100
.كان ذلك نوغيسوموكامي بكلّ تأكيد

263
00:18:31,960 --> 00:18:33,270
...هاكو

264
00:18:40,430 --> 00:18:46,730
إذًا فأنا امرأة قويّة بشكل وحشيّ تأكل
الكثير وليس لديها أصدقاء، صحيح؟

265
00:18:48,060 --> 00:18:48,940
ماذا؟

266
00:18:48,940 --> 00:18:51,230
ما الّذي تتحدّثين عنه؟

267
00:18:51,230 --> 00:18:53,110
.لا فكرة لديّ عن هذا

268
00:18:53,570 --> 00:18:55,990
.أخبرتني أنجو بذلك

269
00:18:55,990 --> 00:18:57,240
صحيح؟

270
00:18:58,650 --> 00:19:01,740
مهلاً! لم أقل أنّكِ قويّة بشكل
!وحشي أو تأكلين كثيرًا

271
00:19:03,740 --> 00:19:07,500
...إذًا فقد قلتَ شيئًا آخر بالفعل

272
00:19:22,430 --> 00:19:24,640
الإغراء ورسالة حبّ؟

273
00:19:25,890 --> 00:19:27,980
...لكن حسب معرفتي بأوشُتورو

274
00:19:28,520 --> 00:19:31,400
.فلا أعلم إن كان ذلك سينجح معه

275
00:19:32,270 --> 00:19:35,110
ماذا عليّ أن أفعل إذًا؟

276
00:19:50,370 --> 00:19:52,170
هل نقوم بتمثيليّة ما؟

277
00:19:53,670 --> 00:19:55,210
.هذا صحيح

278
00:19:55,210 --> 00:19:58,670
.بإمكاننا أن نقول أنّك قد اختُطفتِ

279
00:19:59,510 --> 00:20:00,630
!أنا أمزح فحسب

280
00:20:01,840 --> 00:20:04,050
!إنّك تتصرّف بغباء ثانية

281
00:20:04,050 --> 00:20:06,060
!كانت مزحة فقط

282
00:20:06,470 --> 00:20:07,770
!هذه هي

283
00:20:09,220 --> 00:20:11,890
سيأتي الرّجل الّذي يحبّني لينقذني؟

284
00:20:12,980 --> 00:20:14,610
!هذا رائع

285
00:20:15,110 --> 00:20:16,360
!بالفعل

286
00:20:17,190 --> 00:20:21,570
أهنالك من سيحقّق أمنيتي؟

287
00:20:21,860 --> 00:20:24,950
ما قولكِ؟

288
00:20:29,620 --> 00:20:32,330
.الحبّ شيء غريب، شيء لا يمكن إيقافه

289
00:20:32,870 --> 00:20:34,790
.سمعتُ قصّتكِ

290
00:20:35,250 --> 00:20:37,210
،أيّتها الفتاة الّتي لم يحالفها الحظّ في الحبّ

291
00:20:37,210 --> 00:20:40,340
،أنا اللّصّة النّبيلة نوسوري

292
00:20:40,630 --> 00:20:42,840
!من ستحقّق أمنيتكِ

293
00:20:44,390 --> 00:20:45,550
حقًّا؟

294
00:20:50,600 --> 00:20:51,600
...المرأة الجيّدة

295
00:20:52,730 --> 00:20:54,480
!لا تتراجع عن كلمة قالتها أبدًا

296
00:20:54,770 --> 00:20:56,360
!ممتاز

297
00:20:56,360 --> 00:20:58,610
!دعي كلّ شيء لي فحسب

298
00:20:57,520 --> 00:20:59,270
!مهلاً، انتظري

299
00:21:06,280 --> 00:21:08,200
،أنا لا أعرف من تكونين

300
00:21:08,200 --> 00:21:10,080
!لكنّي أعتمد عليكِ

301
00:21:10,080 --> 00:21:10,790
!بالفعل

302
00:21:10,790 --> 00:21:12,250
!دعي الأمر لي

303
00:21:15,620 --> 00:21:17,710
.لم أعتقد أنّها ستأخذ الأمر على محمل الجدّ

304
00:21:18,340 --> 00:21:20,750
الحمّامات هنا رائعة، أليس كذلك؟

305
00:21:23,720 --> 00:21:25,630
.أتمنّى لو كنتُ أعيش هنا

306
00:21:31,640 --> 00:21:33,560
.وداعًا

307
00:21:33,560 --> 00:21:34,640
!مهلاً

308
00:21:35,810 --> 00:21:37,770
هاكو، هل تعرفهما؟

309
00:21:37,770 --> 00:21:39,610
...حسنًا، أنا

310
00:21:43,440 --> 00:21:47,530
.أنا واثقة أنّ صديقيك قد أخذا الأمر على محمل الجدّ

311
00:21:49,660 --> 00:21:52,410
هل... أفسدتُ الأمور؟