1
00:00:03,280 --> 00:00:04,710
‫شمس مشرقة

2
00:00:05,710 --> 00:00:08,620
‫أشجار نخيل وارفة
‫حوض مائي لامع

3
00:00:08,840 --> 00:00:11,880
‫إضافة إلى الصيف، يعني محبوبي
‫الجماهير في ملابس السباحة

4
00:00:11,970 --> 00:00:13,830
‫لكننا في الخريف

5
00:00:14,310 --> 00:00:17,010
‫"معاً تحت السماء الدرامية"

6
00:00:17,100 --> 00:00:19,220
‫"معك"

7
00:00:19,310 --> 00:00:21,310
‫"(هيا جميعكم، لنستمتع)"

8
00:00:23,480 --> 00:00:24,660
‫"حسن"

9
00:00:25,920 --> 00:00:27,790
‫"لنبدأ، الآن"

10
00:00:29,910 --> 00:00:30,780
‫"حسن"

11
00:00:30,870 --> 00:00:32,300
‫"معكم، حسن"

12
00:00:32,380 --> 00:00:34,030
‫"(ها نحن أولاء، نعم)"

13
00:00:34,080 --> 00:00:35,250
‫"(زينغ) من أجل ابتسامة"

14
00:00:35,340 --> 00:00:39,470
‫"هل نسيت كيف هو شعور النبض؟"

15
00:00:39,560 --> 00:00:43,470
‫"الصوت الذي تسمعينه
‫عندما يتسارع قلبك"

16
00:00:43,550 --> 00:00:46,680
‫"لنضعه في طبقات معاً بأغنيتنا"

17
00:00:46,770 --> 00:00:48,940
‫"ثم نطلق سيقاننا للريح"

18
00:00:49,030 --> 00:00:51,930
‫_ "حماس، لا حدود"
‫_ "الاندفاع يتصاعد"

19
00:00:52,030 --> 00:00:53,680
‫"مليء بالروح، لكن من دونك؟"

20
00:00:53,770 --> 00:00:55,670
‫"سيكون هذا مملاً"

21
00:00:55,720 --> 00:00:59,060
‫"أملنا أن نصبح ثنائياً
‫جاهزاً للانطلاق، نعم"

22
00:00:59,110 --> 00:01:02,180
‫"لنرقص معاً إلى الأبد"

23
00:01:02,240 --> 00:01:04,800
‫"إن حدث وتعثّرت"

24
00:01:04,980 --> 00:01:08,490
‫"وابتعدت أيدينا بعيداً جداً عن بعضها"

25
00:01:08,580 --> 00:01:11,620
‫"سنضع ثقتنا بك"

26
00:01:11,840 --> 00:01:15,380
‫"لنقطع عهداً سرياً"

27
00:01:15,450 --> 00:01:16,820
‫"(لنغنّ أغنية الآن)"

28
00:01:16,880 --> 00:01:19,360
‫"معاً تحت الشمس الدرامية"

29
00:01:19,520 --> 00:01:20,700
‫"معك"

30
00:01:20,790 --> 00:01:23,170
‫"في الصباح والظهر وحتى الليل"

31
00:01:23,350 --> 00:01:26,040
‫"سنجعلك تقول إنك تحب هذا"

32
00:01:26,140 --> 00:01:28,560
‫"أكثر ودوماً"

33
00:01:28,650 --> 00:01:30,050
‫"ليغنّ الجميع، صفّقوا بأيديكم"

34
00:01:30,130 --> 00:01:32,910
‫"شعاع النور الآتي من النجمين"

35
00:01:33,080 --> 00:01:36,390
‫"إنها أنوار النجوم التي ستقودكم
‫إلى مستقبل أكثر إشراقاً"

36
00:01:36,560 --> 00:01:38,350
‫_ "دافع فيّاض"
‫_ "أغنية عجائبية"

37
00:01:38,430 --> 00:01:39,860
‫"آمل أن تجعلك تبتسم دوماً"

38
00:01:39,950 --> 00:01:41,940
‫"(زينغ) من أجل ابتسامة"

39
00:01:44,070 --> 00:01:45,770
‫"المرحلة الثامنة"

40
00:01:45,990 --> 00:01:47,290
‫(يو)!

41
00:01:48,030 --> 00:01:49,070
‫مرحباً

42
00:01:50,460 --> 00:01:51,940
‫أريد الذهاب إلى المنزل

43
00:01:52,290 --> 00:01:54,250
‫(يو)، هل تكره أحواض السباحة؟

44
00:01:54,460 --> 00:01:56,110
‫النزول في الماء ينهكني

45
00:01:56,460 --> 00:01:59,590
‫هيا يا (نيودو)، توقف عن التصرف بضعف

46
00:02:00,540 --> 00:02:02,710
‫إنها جلسة التصوير الأولى لتقويم (زينغ)

47
00:02:02,800 --> 00:02:06,710
‫لكي نكون على قدر الحماس
‫يجب أن نكرّس أجسادنا وأرواحنا

48
00:02:07,060 --> 00:02:09,790
‫رغم أن جسدي الآن شبح

49
00:02:10,010 --> 00:02:12,440
‫تكريس الجسم والروح لا يعني هذا

50
00:02:12,880 --> 00:02:14,230
‫(نيودو)!

51
00:02:14,310 --> 00:02:16,970
‫ضع واقياً شمسياً مرة كل ساعة

52
00:02:17,130 --> 00:02:18,270
‫لا تعتمد على الشباب

53
00:02:18,350 --> 00:02:19,780
‫لا ترشّيه على وجهي

54
00:02:20,100 --> 00:02:22,310
‫أنا شبح، لن أصاب بحرق شمس

55
00:02:22,530 --> 00:02:26,700
‫هل هناك أي فائدة عملية
‫من تقويمات محبوبي الجماهير؟

56
00:02:27,700 --> 00:02:28,700
‫توجد فائدة

57
00:02:28,780 --> 00:02:32,690
‫بناء على الاستطلاع
‫يتشوّق المعجبون إليها

58
00:02:32,770 --> 00:02:35,640
‫ورغم أننا في الخريف عليك استخدام
‫حماية الأشعة فوق البنفسجية

59
00:02:35,740 --> 00:02:37,000
‫بالتأكيد؟

60
00:02:37,080 --> 00:02:38,080
‫بالتأكيد

61
00:02:38,170 --> 00:02:41,340
‫صور التقويم مبنية على طلبات المعجبين

62
00:02:41,420 --> 00:02:43,420
‫لنرضهم

63
00:02:45,460 --> 00:02:48,810
‫أنا واثقة أنهم استمتعوا بالتفكير
‫في الملابس التي سترتديانها

64
00:02:48,980 --> 00:02:51,020
‫سنلقي نظرة إلى الوراء

65
00:02:51,120 --> 00:02:53,550
‫منذ شهر... في (بوتاكيزوكو)

66
00:02:57,200 --> 00:03:00,410
‫_ "استطلاع تقويم (زينغ)"
‫_ "نطلب من محبوبينا ارتداء ملابس معيّنة"

67
00:03:04,190 --> 00:03:05,710
‫هذا يتجاوز الصفاقة جداً

68
00:03:06,320 --> 00:03:09,450
‫الطلب من عضوي (زينغ)
‫ارتداء ملابس معيّنة

69
00:03:09,710 --> 00:03:13,100
‫لا أريد إجبار محبوب جماهيري المفضل
‫على أفكار معيّنة

70
00:03:13,230 --> 00:03:13,880
‫غبية...

71
00:03:14,000 --> 00:03:17,970
‫يفاجئني أنهما مستعدان لارتداء
‫ملابس مختلفة أساساً

72
00:03:18,050 --> 00:03:20,740
‫هل سيرتديانها إلى الأبد
‫منذ الآن فصاعداً؟

73
00:03:20,830 --> 00:03:23,130
‫موضوع متطرّف كالعادة

74
00:03:23,520 --> 00:03:26,470
‫علينا أن نقدم طلبات من أجل ملابسهما

75
00:03:26,570 --> 00:03:29,560
‫هناك خيارات واضحة
‫من أجل "الملابس الموسمية"

76
00:03:29,640 --> 00:03:32,340
‫عادية، ملابس سباحة، هالوين
‫عيد الميلاد

77
00:03:32,510 --> 00:03:34,730
‫سيكون هذا طمعاً شديداً أيتها الغبية

78
00:03:34,820 --> 00:03:39,730
‫شيء خارج عن الرائج بشدة:
‫ملابس زيارة القبور

79
00:03:39,810 --> 00:03:42,120
‫لا يفترض بمحبوبي الجماهير ارتداؤها

80
00:03:43,160 --> 00:03:46,120
‫حالياً، اكتبي نوع الملابس
‫التي تريدين رؤيتها

81
00:03:46,330 --> 00:03:48,200
‫ما يهم هو عدد الطلبات

82
00:03:48,330 --> 00:03:49,670
‫فهمت

83
00:03:49,770 --> 00:03:52,680
‫يبدو أنهما لن يتحمّسا
‫بطلبات قليلة

84
00:03:52,800 --> 00:03:56,360
‫حسن، لنبذل ما في وسعنا
‫ونطلب بما أننا من معجبيهما

85
00:03:56,410 --> 00:03:57,450
‫حسن

86
00:03:59,670 --> 00:04:01,500
‫إذاً، أنا...

87
00:04:01,930 --> 00:04:04,320
‫أريد رؤيتهما بملابس السباحة

88
00:04:04,670 --> 00:04:06,710
‫ليس النوع المبهج والحيوي

89
00:04:06,800 --> 00:04:10,910
‫أريد فقط رؤية رجل جميل
‫عليه قطرات ماء

90
00:04:10,970 --> 00:04:11,830
‫نوافقك الرأي

91
00:04:11,930 --> 00:04:14,010
‫لقد نزلت في الماء...

92
00:04:14,090 --> 00:04:16,220
‫أريد رؤيتهما بملابس السباحة

93
00:04:19,130 --> 00:04:21,520
‫افعل هذا بشكل لائق يا (نيودو)

94
00:04:21,610 --> 00:04:22,660
‫يا للإزعاج!

95
00:04:23,480 --> 00:04:25,510
‫توقف عن التصرف كأحمق

96
00:04:25,560 --> 00:04:30,390
‫بالنسبة إلي، أن أكون مفعماً بالطاقة
‫أمر غير وارد أصلاً

97
00:04:30,520 --> 00:04:34,290
‫عملك يقتضي أن تفعل هذا

98
00:04:34,390 --> 00:04:36,600
‫ما رأيك أن نأخذ استراحة قصيرة؟

99
00:04:37,030 --> 00:04:39,780
‫نحن آسفون لإزعاجك

100
00:04:40,290 --> 00:04:42,210
‫تمالك نفسك أيها الغبي

101
00:04:42,290 --> 00:04:44,160
‫آسف أيتها الرئيسة

102
00:04:44,250 --> 00:04:46,340
‫لست معتاداً على هذا أيضاً

103
00:04:46,420 --> 00:04:47,460
‫لا بأس يا (يوشينو)

104
00:04:47,550 --> 00:04:50,070
‫أستطيع أن أرى أنك تعمل بجد

105
00:04:50,200 --> 00:04:51,330
‫تفرقة عنصرية

106
00:04:52,460 --> 00:04:53,940
‫هيا يا (نيودو)

107
00:04:54,020 --> 00:04:55,930
‫لم يكن هذا جيداً مطلقاً

108
00:04:56,020 --> 00:05:01,500
‫لست ماهراً بأي من هذه الأمور
‫عدا عن العوم على المياه

109
00:05:01,670 --> 00:05:04,270
‫هل رأيت يوماً
‫صور محبوبي جماهير كهذه؟

110
00:05:04,750 --> 00:05:07,790
‫ما الشائق في ملابس السباحة
‫على أي حال؟

111
00:05:08,230 --> 00:05:12,830
‫المسبح يلمع بشكل مشعّ
‫محبوب الجماهير يلمع بشكل مشع

112
00:05:12,920 --> 00:05:16,400
‫لذا فإن وجود الاثنين معاً
‫هي التركيبة الأكثر لمعاناً

113
00:05:16,480 --> 00:05:18,740
‫محبوبو الجماهير
‫في ملابس السباحة يشبهون

114
00:05:18,830 --> 00:05:21,690
‫شريحة الهامبرغر المفضل لدى الجميع
‫مع الجبن والكاري

115
00:05:21,790 --> 00:05:24,440
‫لا أحب الكاري كثيراً
‫وشرائح الهامبرغر

116
00:05:24,610 --> 00:05:26,300
‫هل يوجد أشخاص كهؤلاء؟

117
00:05:26,390 --> 00:05:27,430
‫هنا تماماً

118
00:05:27,690 --> 00:05:28,780
‫فهمت

119
00:05:28,870 --> 00:05:32,820
‫أنا (أساهي موغامي) سأريك
‫كيف يمكن أن يلمع محبوب الجماهير

120
00:05:33,080 --> 00:05:34,120
‫ها نحن أولاء

121
00:05:34,860 --> 00:05:37,330
‫سنتابع جلسة التصوير قريباً

122
00:05:37,510 --> 00:05:38,680
‫المعذرة

123
00:05:39,290 --> 00:05:40,860
‫آسف لأنني تأخرت

124
00:05:40,940 --> 00:05:43,850
‫فجأة أصبح مزاجه منتعشاً

125
00:05:43,950 --> 00:05:45,590
‫سنكون تحت رعايتك

126
00:05:45,680 --> 00:05:46,940
‫أجل

127
00:05:47,240 --> 00:05:49,420
‫هل يسمح لنا بالنزول
‫في حوض السباحة؟

128
00:05:49,500 --> 00:05:50,890
‫لا مشكلة

129
00:05:50,980 --> 00:05:52,030
‫مرحى!

130
00:05:52,110 --> 00:05:53,810
‫(يوشينو)، أتريد أن تسبح؟

131
00:05:54,580 --> 00:05:55,680
‫انتظر

132
00:05:59,410 --> 00:06:00,490
‫لقد فاجأتني

133
00:06:00,580 --> 00:06:02,020
‫آسف يا (يوشينو)

134
00:06:03,320 --> 00:06:05,560
‫كمحبوبة جماهير أنثى، لم يكن
‫يسمح لي بالنزول في حوض السباحة

135
00:06:05,620 --> 00:06:07,710
‫لأن هذا سيفسد تسريحة شعري

136
00:06:07,830 --> 00:06:08,660
‫أنا سعيدة جداً

137
00:06:08,750 --> 00:06:09,620
‫هنيئاً لك

138
00:06:09,880 --> 00:06:11,880
‫اركب العوامة يا (يوشينو)

139
00:06:12,050 --> 00:06:13,530
‫أنا سأسحبك

140
00:06:13,610 --> 00:06:14,490
‫حسن

141
00:06:18,300 --> 00:06:21,200
‫ما الخطب؟
‫أصبح مفعماً بالحيوية فجأة في المياه

142
00:06:21,260 --> 00:06:22,690
‫هل هو (كابا)؟

143
00:06:22,950 --> 00:06:24,390
‫مذاق الخيار شهي

144
00:06:27,340 --> 00:06:28,260
‫لا!

145
00:06:28,560 --> 00:06:30,690
‫لا أستطيع تخيل (نيودو) بملابس السباحة

146
00:06:30,770 --> 00:06:33,470
‫عادة يكون مغطى
‫أكثر من اللازم بالملابس

147
00:06:33,600 --> 00:06:35,900
‫لا يظهر أي شيء سوى وجهه ويديه

148
00:06:35,990 --> 00:06:38,250
‫أريد رؤيته في ملابس السباحة

149
00:06:39,160 --> 00:06:41,940
‫حسن، لقد التقطت تعبيراتك الرائعة

150
00:06:42,020 --> 00:06:44,110
‫هذا كله من أجل جلستنا
‫في حوض السباحة

151
00:06:44,940 --> 00:06:45,930
‫عمل جميل

152
00:06:46,030 --> 00:06:47,150
‫أجل

153
00:06:47,500 --> 00:06:51,150
‫فوجئت عندما قفزت فجأة في الحوض

154
00:06:51,370 --> 00:06:53,020
‫حتى أنا فوجئت

155
00:06:53,850 --> 00:06:56,710
‫تمكنا من الابتسام بشكل طبيعي
‫بسبب هذا

156
00:06:56,760 --> 00:06:57,800
‫لذا، شكراً

157
00:06:59,060 --> 00:07:00,890
‫عمل رائع، أنتما الاثنان

158
00:07:01,110 --> 00:07:02,050
‫شكراً لك

159
00:07:03,010 --> 00:07:06,400
‫سنتابع جلسة التصوير
‫لذا اعتنيا ببشرتيكما

160
00:07:06,620 --> 00:07:08,190
‫خاصة أنت يا (نيودو)

161
00:07:08,270 --> 00:07:09,310
‫حسن

162
00:07:09,400 --> 00:07:12,440
‫الحفاظ على بشرة جيدة هو عملك
‫كمحبوب جماهير

163
00:07:12,520 --> 00:07:13,480
‫أفهمت؟

164
00:07:14,440 --> 00:07:17,010
‫العناية بالبشرة مزعجة جداً

165
00:07:18,260 --> 00:07:21,040
‫عليك الاهتمام بنفسك قليلاً يا (نيودو)

166
00:07:21,130 --> 00:07:24,130
‫هذا ما يقوله شخص يأكل الحلوى
‫بجسد شخص آخر

167
00:07:24,210 --> 00:07:27,380
‫بالمناسبة، يتمتع (يوشينو) دوماً
‫ببشرة جميلة

168
00:07:27,480 --> 00:07:28,820
‫ماذا يفعل للحفاظ عليها؟

169
00:07:28,900 --> 00:07:31,600
‫أليست الفتيات أكثر مهارة في هذا؟

170
00:07:31,950 --> 00:07:34,250
‫في حالتي، ليس تماماً

171
00:07:34,340 --> 00:07:38,290
‫استخدمت توصيات عضو سابقة
‫وكانت ماهرة جداً بهذا

172
00:07:39,210 --> 00:07:40,510
‫هذه هي فرصتنا

173
00:07:40,590 --> 00:07:42,600
‫لنسأله

174
00:07:43,340 --> 00:07:45,940
‫بما أن للرجال والنساء أنواعاً
‫مختلفة من منتجات العناية بالبشرة

175
00:07:46,030 --> 00:07:47,590
‫هيا، هيا

176
00:07:48,890 --> 00:07:49,940
‫(يوشينو)

177
00:07:50,280 --> 00:07:52,240
‫أي منتجات عناية بالبشرة
‫تستخدم عادة؟

178
00:07:53,190 --> 00:07:55,110
‫ما الذي أصابك فجأة؟

179
00:07:56,150 --> 00:07:58,760
‫لديك بشرة جميلة دوماً، لذا...

180
00:08:01,710 --> 00:08:06,060
‫أستخدم فقط المنتجات العادية
‫كمقوّي البشرة والغسول

181
00:08:06,180 --> 00:08:09,270
‫وأيضاً، أذهب للتدليك
‫وعيادات التجميل قبل الحفلات

182
00:08:09,870 --> 00:08:10,610
‫عيادات التجميل؟

183
00:08:10,750 --> 00:08:12,050
‫هذا يكلف الكثير من النقود

184
00:08:12,140 --> 00:08:14,860
‫لكنني لا أذهب إلى العيادات
‫باهظة الكلفة

185
00:08:14,920 --> 00:08:18,650
‫أيضاً، أحد كبار السن في عائلتنا
‫يستخدم أدوات تجميل

186
00:08:18,740 --> 00:08:19,910
‫نحو 200 ألف ين في الشهر

187
00:08:20,000 --> 00:08:20,820
‫200 ألف؟

188
00:08:21,560 --> 00:08:22,960
‫هذا كثير، صحيح؟

189
00:08:23,080 --> 00:08:24,560
‫مئتا ألف

190
00:08:24,780 --> 00:08:27,820
‫بمئتي ألف ين تستطيع شراء الكثير
‫من البارفيه الفاخرة القصوى

191
00:08:27,910 --> 00:08:31,690
‫واحدة، أو اثنتان أو مئة حصة

192
00:08:32,650 --> 00:08:33,770
‫قطعاً لا

193
00:08:34,730 --> 00:08:35,640
‫بارفيه

194
00:08:35,730 --> 00:08:36,510
‫لا

195
00:08:36,900 --> 00:08:38,030
‫شبح محبوب الجماهير

196
00:08:42,290 --> 00:08:43,720
‫شبح محبوب الجماهير

197
00:08:44,110 --> 00:08:47,370
‫إذاً ماذا عن ملابس الخريف والشتاء؟

198
00:08:47,590 --> 00:08:48,630
‫بأكمام طويلة

199
00:08:48,710 --> 00:08:49,670
‫الخريف؟

200
00:08:49,760 --> 00:08:52,390
‫يجب أن تكون هذه أزياء الهالوين

201
00:08:52,460 --> 00:08:54,670
‫انظرن إلى محبوبي الجماهير الوسيمين

202
00:08:54,890 --> 00:08:57,530
‫أنت تتباهين بنعم متابعة
‫فرقة تتمتع بالشعبية

203
00:08:57,670 --> 00:08:59,920
‫القيام بارتداء أزياء الشخصيات أمر عادي

204
00:09:00,060 --> 00:09:01,780
‫أظن أنه في وسع (زينغز) القيام بهذا

205
00:09:01,840 --> 00:09:02,880
‫أقصد ارتداء ملابس الشخصيات

206
00:09:02,970 --> 00:09:05,750
‫ارتداء ملابس الشخصيات؟

207
00:09:05,830 --> 00:09:07,960
‫(نيودو) يرتدي ملابس الشخصيات؟

208
00:09:11,090 --> 00:09:12,090
‫هذا مشين!

209
00:09:13,440 --> 00:09:15,220
‫ارتداء ملابس الشخصيات مشين

210
00:09:15,400 --> 00:09:16,350
‫لماذا؟

211
00:09:16,700 --> 00:09:19,390
‫لا يزال هذا باكراً بالنسبة إلينا

212
00:09:19,570 --> 00:09:23,220
‫لكن بحقك، سيبدو (يوشينو) ظريفاً
‫بأذني كلب وذيله

213
00:09:23,640 --> 00:09:25,040
‫كمستذئب مثلاً

214
00:09:26,250 --> 00:09:27,610
‫سيكون ظريفاً جداً

215
00:09:27,690 --> 00:09:28,600
‫صحيح؟

216
00:09:28,950 --> 00:09:31,460
‫يستطيع (نيودو) أن يكون
‫مصّاص دماء أيضاً

217
00:09:33,470 --> 00:09:36,330
‫سيكون وسيماً جداً من دون شك

218
00:09:36,640 --> 00:09:38,720
‫ماذا عن مخلوق زومبي؟

219
00:09:38,820 --> 00:09:40,420
‫إنه يناسب صورة (نيودو)

220
00:09:40,550 --> 00:09:42,510
‫سنختار مصّاص الدماء من فضلك

221
00:09:43,290 --> 00:09:45,240
‫انظرا إلى الكاميرا من فضلكما

222
00:09:46,760 --> 00:09:48,590
‫تمت لقطات الهالوين

223
00:09:48,670 --> 00:09:49,890
‫حرّ شديد

224
00:09:50,810 --> 00:09:53,150
‫إنها الأزياء والأضواء

225
00:09:53,240 --> 00:09:54,930
‫خدعة أم حلوى

226
00:09:55,020 --> 00:09:57,530
‫أعطني حلوى وإلا خدعتك

227
00:09:57,630 --> 00:09:59,790
‫سماع هذا منك ليس مضحكاً

228
00:09:59,880 --> 00:10:03,010
‫(يو)، سنتابع الجلسة
‫لذا اذهب وبدّل ملابسك

229
00:10:03,100 --> 00:10:04,490
‫أما زلنا مستمرين؟

230
00:10:04,570 --> 00:10:06,090
‫سكاكر، وجبات خفيفة

231
00:10:07,880 --> 00:10:10,570
‫ليس هناك حسّ بالواقع في الهالوين

232
00:10:10,660 --> 00:10:12,870
‫نحتاج إلى أزياء مألوفة أكثر
‫بالنسبة إلينا

233
00:10:12,960 --> 00:10:14,830
‫ماذا؟ هذا عادي

234
00:10:14,910 --> 00:10:16,130
‫لا، إنها على حق

235
00:10:16,220 --> 00:10:18,130
‫هل سنتمكن من منع أنفسنا؟

236
00:10:19,830 --> 00:10:22,040
‫إذاً ماذا عن عيد الميلاد؟

237
00:10:22,130 --> 00:10:23,260
‫عيد الميلاد؟

238
00:10:24,000 --> 00:10:25,200
‫ابتلعن الطعم

239
00:10:25,260 --> 00:10:28,550
‫(سانتا كلوز)، الرنّة
‫هذا كله مألوف بالنسبة إلينا

240
00:10:28,650 --> 00:10:29,550
‫فكرتك منطقية

241
00:10:30,080 --> 00:10:32,640
‫حتى محلات البيتزا تستخدم هذا الموضوع

242
00:10:32,720 --> 00:10:34,640
‫هذه أزياء شائعة

243
00:10:34,730 --> 00:10:36,810
‫(سانتا نيودو)؟

244
00:10:36,890 --> 00:10:39,550
‫مظهر أقرب إلى محبوبي جماهير
‫سيكون أفضل

245
00:10:39,640 --> 00:10:40,530
‫"مثل محبوبي جماهير"؟

246
00:10:40,600 --> 00:10:42,110
‫إنهما محبوبا الجماهير

247
00:10:42,290 --> 00:10:45,850
‫إذاً ماذا عن أزياء الأمراء؟

248
00:10:45,930 --> 00:10:47,200
‫أمراء؟

249
00:10:47,460 --> 00:10:49,230
‫كنت أفكر دوماً

250
00:10:49,280 --> 00:10:52,370
‫أريد رؤية عضوي فرقة (زينغز)
‫بأزياء مثل فرقة (سيغراس)

251
00:10:52,540 --> 00:10:53,890
‫أفهمك

252
00:10:54,230 --> 00:10:56,580
‫(سيغراس) هم أفضل أمراء العالم

253
00:10:56,840 --> 00:10:58,890
‫يمكن لعضوي فرقة (زينغز)
‫تجربة هذا أيضاً

254
00:11:00,570 --> 00:11:01,620
‫موضوع عيد الميلاد

255
00:11:01,750 --> 00:11:02,750
‫زيّ الأمير

256
00:11:02,960 --> 00:11:03,960
‫(نيودو)

257
00:11:04,440 --> 00:11:05,530
‫أريد رؤيته

258
00:11:05,880 --> 00:11:07,790
‫أي نوع من الأزياء هذه؟

259
00:11:07,870 --> 00:11:09,920
‫قالوا من أجل عيد الميلاد

260
00:11:10,000 --> 00:11:11,660
‫هل هذه أزياء عيد الميلاد؟

261
00:11:11,780 --> 00:11:12,520
‫قالت الرئيسة

262
00:11:12,610 --> 00:11:14,690
‫"ما دامت الألوان تشبهه
‫فلا بأس بهذا"

263
00:11:14,790 --> 00:11:16,290
‫هل هذا مقبول حقاً؟

264
00:11:16,350 --> 00:11:18,780
‫هل هناك أي شخص سيعجبه هذا؟

265
00:11:18,860 --> 00:11:20,870
‫عيد الميلاد رائع، صحيح؟

266
00:11:20,950 --> 00:11:22,600
‫هذا هو زيّي من أجل عيد الميلاد

267
00:11:22,650 --> 00:11:23,870
‫أظن أنه يوجد

268
00:11:24,170 --> 00:11:25,900
‫سنتابع الجلسة

269
00:11:26,210 --> 00:11:27,560
‫هيا بنا يا (يو)

270
00:11:28,770 --> 00:11:30,690
‫لا!

271
00:11:30,770 --> 00:11:32,160
‫المعذرة يا سيدتي

272
00:11:32,250 --> 00:11:34,600
‫توقفي عن هذا، أنت تزعجين النادلة

273
00:11:34,720 --> 00:11:37,200
‫نحن بخير
‫إنها تصاب بنوب كهذه عادة

274
00:11:37,810 --> 00:11:41,310
‫أريد فعلاً رؤية (نيودو) بزيّ الأمير
‫مثل (سيغراس)

275
00:11:41,380 --> 00:11:42,420
‫أريده أن يكون...

276
00:11:42,680 --> 00:11:43,720
‫هدية من أجلك

277
00:11:43,890 --> 00:11:45,370
‫(سانتا)؟

278
00:11:45,450 --> 00:11:49,460
‫لكنه سيكون ظريفاً للغاية
‫لن يتمكن قلبي من تحمّل هذا

279
00:11:49,540 --> 00:11:50,620
‫أنت على حق

280
00:11:50,720 --> 00:11:54,050
‫لن تمتنع أجسادنا عن الموت
‫كلما رأينا التقويم

281
00:11:54,150 --> 00:11:56,800
‫أنتن معجبات فرقة (زينغز)
‫لديكن أجساد سيئة

282
00:11:56,880 --> 00:11:59,400
‫أجساد طبيعية أكثر
‫تستطيع التماهي مع الحياة العادية

283
00:11:59,620 --> 00:12:01,710
‫الملابس العادية ستكون رائعة

284
00:12:02,190 --> 00:12:04,440
‫محبوبو جماهير في ملابس عادية؟

285
00:12:04,740 --> 00:12:06,050
‫ماذا عن البذلات؟

286
00:12:06,220 --> 00:12:07,920
‫نوع من البداية الجديدة للبلوغ

287
00:12:09,430 --> 00:12:11,610
‫ربما تكون جديدة

288
00:12:11,700 --> 00:12:13,350
‫بذلات... جميل

289
00:12:13,440 --> 00:12:16,050
‫لا يبدو الناس ظرفاء
‫في أماكن العمل العادية

290
00:12:16,610 --> 00:12:19,000
‫لكن محبوبي جماهيرنا
‫سيكونان رائعين بها حتماً

291
00:12:19,260 --> 00:12:23,560
‫رجل وسيم يعمل بجد
‫يجب أن يبدو رائعاً

292
00:12:24,030 --> 00:12:28,900
‫المشكلة هي أنني لا أستطيع
‫تخيل (نيودو) يعمل بجد

293
00:12:29,940 --> 00:12:32,370
‫إنها مجرد صورة

294
00:12:32,470 --> 00:12:37,120
‫وأنا واثقة أن أي ملابس
‫ستليق به من دون شك

295
00:12:37,240 --> 00:12:39,460
‫لكن تخيلي أن (نيودو)
‫لا يستطيع ربط ربطة عنقه الخاصة

296
00:12:40,510 --> 00:12:44,020
‫إذاً سيربطها (يوشينو) من أجله

297
00:12:44,420 --> 00:12:45,200
‫(يوشينو)

298
00:12:45,280 --> 00:12:46,070
‫يجرب ربطة عنقه

299
00:12:46,150 --> 00:12:47,190
‫من أجله؟

300
00:12:47,970 --> 00:12:49,540
‫وها قد انتهينا

301
00:12:49,800 --> 00:12:50,580
‫شكراً

302
00:12:50,670 --> 00:12:53,620
‫من الصعب جداً
‫إتقان ربط ربطة العنق

303
00:12:54,060 --> 00:12:56,490
‫لماذا يجب أن تكون مزعجة هكذا؟

304
00:12:57,750 --> 00:13:00,750
‫انتظر، أذكر أن ملابسك
‫تشمل ربطة عنق

305
00:13:01,140 --> 00:13:03,350
‫تلك كانت تثبّت بزرّ

306
00:13:03,450 --> 00:13:05,620
‫ماذا؟ حقاً؟

307
00:13:07,400 --> 00:13:09,480
‫أنت، الآن حتى المديرة قد أتت

308
00:13:09,610 --> 00:13:12,000
‫سنطلب المزيد من الجعة

309
00:13:12,570 --> 00:13:14,520
‫محبوبا الجماهير المفضّلان لدي
‫يرتديان بذلتين

310
00:13:15,000 --> 00:13:18,430
‫معدتي المهوّسة ستجن
‫بعد هضم مأدبة كهذه

311
00:13:18,510 --> 00:13:20,390
‫تمالك نفسك يا (يو)

312
00:13:21,380 --> 00:13:24,210
‫أي نوع من الأزياء مقبول؟

313
00:13:24,340 --> 00:13:26,030
‫كنت أفكر بالأمر

314
00:13:26,390 --> 00:13:29,750
‫مفهومنا يتعلق بالعملانية

315
00:13:29,820 --> 00:13:33,210
‫ارتداء أزياء الشخصيات سيكون
‫احتفالياً بشدة لذا لن يكون مريحاً

316
00:13:33,330 --> 00:13:34,150
‫أنت على حق

317
00:13:34,290 --> 00:13:35,370
‫بالضبط

318
00:13:35,510 --> 00:13:36,680
‫كم هذا محزن!

319
00:13:36,810 --> 00:13:39,290
‫لم يحصلن من قبل
‫على مؤن من الطاقم الرسمي قط

320
00:13:39,500 --> 00:13:42,150
‫وهن يتصرفن كأنهن المنتجات

321
00:13:42,240 --> 00:13:43,410
‫ماذا عن النظارات؟

322
00:13:43,500 --> 00:13:45,980
‫يستدعي الخريف القراءة وهو ليس
‫قريباً جداً من ارتداء أزياء الشخصيات

323
00:13:46,100 --> 00:13:47,410
‫إنها ضرورية

324
00:13:48,020 --> 00:13:48,810
‫يعجبني هذا

325
00:13:48,890 --> 00:13:50,490
‫(سيتوتشي) يضعها

326
00:13:51,710 --> 00:13:53,620
‫النظارات رائعة

327
00:13:53,710 --> 00:13:56,360
‫كنت أرغب بشدة برؤية
‫(نيودو) يرتدي نظّارة

328
00:13:56,490 --> 00:13:59,230
‫لذا طبعت نظارة على الصورة

329
00:13:59,320 --> 00:14:00,320
‫ماذا تفعلين؟

330
00:14:00,400 --> 00:14:03,010
‫هذه هي فرصتنا لرؤية (نيودو)
‫بالنظارة قانونياً

331
00:14:03,090 --> 00:14:05,310
‫أرغب كثيراً برؤيته

332
00:14:08,780 --> 00:14:10,960
‫حسن، أنتما الاثنان جيدان

333
00:14:11,390 --> 00:14:13,210
‫هذا رائع

334
00:14:13,310 --> 00:14:15,600
‫أنتما تظهران الذبذبات الهادئة للخريف

335
00:14:15,700 --> 00:14:16,960
‫هذه الكنزة المحاكة تسبّب الحر

336
00:14:17,040 --> 00:14:18,870
‫عمل جيد

337
00:14:18,950 --> 00:14:20,820
‫سأبحث عن بعض الشاي البارد

338
00:14:20,910 --> 00:14:21,820
‫حسن

339
00:14:23,120 --> 00:14:24,900
‫عمل رائع يا (يوشينو)

340
00:14:25,690 --> 00:14:26,770
‫شكراً جزيلاً

341
00:14:26,860 --> 00:14:28,990
‫أظهرتما أنتما الاثنان تعابير رائعة

342
00:14:29,070 --> 00:14:34,400
‫لا، أبدو طفولياً
‫لذا فإن (نيودو) هو من يبدو وسيماً

343
00:14:34,470 --> 00:14:38,380
‫في حوض السباحة
‫اعتقدت أنه شخص نشط بالتأكيد

344
00:14:38,460 --> 00:14:40,980
‫تبيّن أنه يستطيع أن يعطي هالة هادئة

345
00:14:41,240 --> 00:14:42,970
‫صحيح تماماً

346
00:14:43,500 --> 00:14:44,890
‫(يو)؟ نشط؟

347
00:14:48,150 --> 00:14:49,320
‫(نيودو)

348
00:14:50,320 --> 00:14:52,320
‫ما رأيك بهذا؟ كيف أبدو؟

349
00:14:52,840 --> 00:14:57,310
‫هل هذه النظارة والملابس
‫جزء من جسمك كشبح؟

350
00:14:57,670 --> 00:14:59,490
‫تبدو جميلة

351
00:15:01,360 --> 00:15:02,180
‫شكراً جزيلاً

352
00:15:02,260 --> 00:15:04,530
‫بل هذا خطير، خطير، خطير

353
00:15:04,610 --> 00:15:06,490
‫خطير، خطير، خطير...

354
00:15:06,570 --> 00:15:09,520
‫أنت الشخص الخطير
‫توقف وإلا سيتم اعتقالك

355
00:15:09,620 --> 00:15:11,610
‫هل كل شيء على ما يرام
‫يا سيدتي؟

356
00:15:11,700 --> 00:15:13,310
‫نحن آسفات جداً

357
00:15:13,390 --> 00:15:14,830
‫أصبحوا معتادين على هذا الآن

358
00:15:15,130 --> 00:15:18,340
‫شعرن بالأسف على الجلبة التي سبّبنها
‫لذا طلبن الكثير من الوجبات

359
00:15:18,520 --> 00:15:21,810
‫على أي حال، كنت نزقة
‫بشأن أفكار الناس

360
00:15:22,170 --> 00:15:24,080
‫ماذا تريدين أن تطلبي فعلاً؟

361
00:15:24,340 --> 00:15:26,770
‫في الواقع، لا أفكر بأي شيء

362
00:15:27,640 --> 00:15:31,720
‫تعجبني ملابسهما العادية
‫وسأسرّ برؤيتهما في أي ملابس

363
00:15:31,810 --> 00:15:33,380
‫لا أستطيع التفكير بأي شيء لأطلبه

364
00:15:33,760 --> 00:15:34,680
‫نحن أيضاً

365
00:15:34,850 --> 00:15:38,330
‫لقد رأينا ملابسهما في سوق البضاعة
‫مراراً وتكراراً في النهاية

366
00:15:38,410 --> 00:15:40,160
‫لسنا معتادين على طلب أي شيء

367
00:15:40,240 --> 00:15:43,220
‫كل يوم أرى صوره الرأسية
‫وكل يوم يبدو وسيماً

368
00:15:43,280 --> 00:15:45,230
‫مهلاً، يبدو اليوم أكثر وسامة

369
00:15:45,330 --> 00:15:47,280
‫وجهه متين حقاً

370
00:15:47,360 --> 00:15:49,190
‫وصديق للبيئة بشدة

371
00:15:49,280 --> 00:15:50,580
‫أنت!

372
00:15:50,840 --> 00:15:54,400
‫كنت أفكر لبعض الوقت
‫أن طمعك المهوّس قد مات وانتهى

373
00:15:54,490 --> 00:15:57,440
‫معجبات (زينغز) المهوّسات
‫أعترض على موقفكن

374
00:15:57,530 --> 00:15:58,920
‫محاكمة للمهوّسات؟

375
00:15:59,270 --> 00:16:00,390
‫انظرن إلى هذا

376
00:16:01,830 --> 00:16:03,780
‫هذا تقويم (سيغراس) بـ12 صفحة

377
00:16:03,880 --> 00:16:06,310
‫بصور منفردة وصور جماعية

378
00:16:06,440 --> 00:16:07,650
‫أنت تتباهين ثانية؟

379
00:16:07,750 --> 00:16:11,000
‫ما أريد قوله هو أن عليكن
‫ألا ترضين بالحالة الراهنة

380
00:16:11,220 --> 00:16:15,090
‫أفهم أن عليكن المثابرة
‫في أوقات الجوع

381
00:16:15,250 --> 00:16:17,680
‫لكن استمررن بالتفكير
‫أن الأمور جيدة كما هي

382
00:16:17,740 --> 00:16:20,210
‫ولن يتمكن محبوبكن
‫من الوصول إلى مستويات أعلى

383
00:16:20,520 --> 00:16:22,470
‫توسّلن محبوب جماهيركن المفضل

384
00:16:24,380 --> 00:16:25,420
‫أنت على حق

385
00:16:25,510 --> 00:16:27,510
‫إنهما يتطوران لكننا...

386
00:16:27,600 --> 00:16:31,550
‫قلوبنا لم تستطع ملاحقة
‫نشاطات (زينغز)

387
00:16:31,630 --> 00:16:35,900
‫إنهم يطلبون منا أن نقدم طلبات
‫مع أننا نجلس مكتوفات الأيدي

388
00:16:38,250 --> 00:16:39,810
‫سأكتب طلبي

389
00:16:39,890 --> 00:16:41,020
‫مع رغباتي كلها

390
00:16:41,110 --> 00:16:41,940
‫وأنا أيضاً

391
00:16:42,020 --> 00:16:43,150
‫وأنا الثالثة

392
00:16:43,580 --> 00:16:46,930
‫إذاً سأطلب ملابس سباحة
‫وطبيب ومصّاص دماء

393
00:16:47,010 --> 00:16:48,320
‫لا تكوني طماعة جداً

394
00:16:48,410 --> 00:16:51,660
‫أريد رؤية (نيودو) بعصابة عين
‫وعصابات وأجنحة

395
00:16:51,800 --> 00:16:52,620
‫لا تكوني سخيفة

396
00:16:52,750 --> 00:16:54,310
‫إطار نظارات (بوسطن) و(ولينغتون)

397
00:16:54,410 --> 00:16:57,400
‫يجب أن أكتب نظارات معدنية
‫وبلاستيكية أيضاً

398
00:16:57,480 --> 00:16:58,660
‫حماس زائد

399
00:16:59,180 --> 00:17:04,000
‫وهكذا كتبت معجبات (زينغز) المهوّسات
‫طلباتهن برغبات قوية

400
00:17:05,400 --> 00:17:08,480
‫لكن يا (نيودو) كنت مثالياً

401
00:17:08,570 --> 00:17:09,470
‫ماذا؟

402
00:17:09,650 --> 00:17:12,920
‫امتثلت تماماً لطلبات المصوّر

403
00:17:13,180 --> 00:17:16,350
‫لست ماهرة في رسم مظهر
‫من دون ابتسامة

404
00:17:16,430 --> 00:17:18,250
‫(أساهي)، أنت تبتسمين

405
00:17:18,910 --> 00:17:20,380
‫كنت سأنفجر ضاحكة

406
00:17:21,160 --> 00:17:22,250
‫ليست هناك مفاجآت في هذا

407
00:17:22,600 --> 00:17:25,730
‫لكنني خبيرة في كوني مفعمة بالطاقة

408
00:17:25,810 --> 00:17:28,600
‫أمر رائع أننا نحن الاثنين
‫لدينا نقاط قوة مختلفة

409
00:17:29,640 --> 00:17:32,470
‫كنت أغفو طوال جلسة التصوير

410
00:17:32,770 --> 00:17:37,160
‫أظن أنني ماهر في عمل
‫لا يقوم فيه المرء بأي شيء

411
00:17:37,420 --> 00:17:39,290
‫لا يوجد عمل كهذا

412
00:17:39,500 --> 00:17:41,410
‫يمكنك الاسترخاء أثناء العمل

413
00:17:41,500 --> 00:17:45,540
‫لكن هذا يأتي بعد الاعتياد
‫على كونك منتبهاً باستمرار

414
00:17:45,630 --> 00:17:47,270
‫"منتبهاً باستمرار"؟

415
00:17:47,370 --> 00:17:49,440
‫هو الشيء الأكثر استحالة في العالم

416
00:17:49,490 --> 00:17:50,800
‫الفجوة من "المعتاد"

417
00:17:50,880 --> 00:17:54,140
‫عنصر المفاجأة هذا يجذب المعجبين

418
00:17:55,350 --> 00:17:56,880
‫عنصر المفاجأة؟

419
00:17:57,700 --> 00:17:58,880
‫عمل رائع

420
00:17:58,960 --> 00:18:01,310
‫جلسة تصوير اليوم كانت مميزة

421
00:18:01,530 --> 00:18:02,230
‫أجل

422
00:18:02,310 --> 00:18:05,480
‫كل ما تبقى هو لقطات الصور
‫بمفهومنا نحن

423
00:18:05,700 --> 00:18:07,820
‫هل لديكما أي أفكار؟

424
00:18:09,520 --> 00:18:11,520
‫لدي بعض الأفكار حيال هذا

425
00:18:13,300 --> 00:18:16,820
‫يبدو أنك نسيت أمرها، يا للعجب!

426
00:18:16,910 --> 00:18:21,160
‫كل منا عليه أن يعطي فكرة لصورة

427
00:18:21,680 --> 00:18:23,080
‫حقاً؟

428
00:18:23,160 --> 00:18:24,290
‫بالطبع

429
00:18:24,600 --> 00:18:28,860
‫طلبت منكما إحضار أفكار
‫تفاجئ معجبينا

430
00:18:28,940 --> 00:18:31,290
‫رغم ذلك...

431
00:18:33,590 --> 00:18:36,280
‫تمكنا اليوم من ارتداء أزياء مختلفة

432
00:18:36,370 --> 00:18:38,760
‫شيء مختلف عن هذا سيكون رائعاً

433
00:18:39,060 --> 00:18:40,280
‫صحيح

434
00:18:40,540 --> 00:18:42,330
‫أريد عنصر مفاجأة ما

435
00:18:42,590 --> 00:18:43,890
‫عنصر المفاجأة

436
00:18:44,150 --> 00:18:45,360
‫الفجوة من "المعتاد"

437
00:18:45,460 --> 00:18:48,710
‫عنصر المفاجأة يجذب المعجبين

438
00:18:48,840 --> 00:18:50,910
‫ما رأيكما أن ترتديا أزياء مدرسية؟

439
00:18:50,970 --> 00:18:51,920
‫أيتها الرئيسة؟

440
00:18:52,010 --> 00:18:52,920
‫ثم...

441
00:18:53,280 --> 00:18:55,360
‫هناك شيء أرغب بتجربته

442
00:18:56,050 --> 00:18:58,050
‫_ "بعد شهر من جلسة التصوير"
‫_ وأخيراً

443
00:18:58,180 --> 00:19:00,840
‫سيصدر تقويم (زينغز)

444
00:19:01,180 --> 00:19:02,740
‫شكراً لكم على الانتظار

445
00:19:02,830 --> 00:19:06,350
‫نبيع بضاعة جديدة وتقويم صور

446
00:19:06,440 --> 00:19:07,780
‫ثلاثة من فضلك

447
00:19:09,910 --> 00:19:11,130
‫إنه هنا

448
00:19:11,520 --> 00:19:12,910
‫الغلاف عليه صورة جديدة

449
00:19:13,130 --> 00:19:14,890
‫لا أستطيع تحمّل ها...

450
00:19:14,950 --> 00:19:17,470
‫ليس الآن! يمكنك الانهيار
‫بعد رؤية ما في الداخل

451
00:19:18,080 --> 00:19:19,990
‫_ افتحيه بسرعة
‫_ لا تسرعي

452
00:19:20,170 --> 00:19:23,640
‫إن رأينا في النهاية صورة حادة
‫ستكون حياتنا في خطر

453
00:19:23,720 --> 00:19:25,640
‫أقلّ الصور خطراً إذاً

454
00:19:25,730 --> 00:19:27,690
‫ماذا عن كانون الثاني؟

455
00:19:27,810 --> 00:19:28,630
‫هذا لن يفي بالغرض

456
00:19:28,730 --> 00:19:31,070
‫لا بد أنهم وضعوا الصور الجيدة
‫في القسم الأول

457
00:19:31,200 --> 00:19:32,680
‫إذاً، نحو أيار

458
00:19:32,810 --> 00:19:35,550
‫صحيح، ليست هناك أي مناسبات
‫موسمية في أيار

459
00:19:37,890 --> 00:19:39,280
‫هذا خطير في النهاية

460
00:19:39,460 --> 00:19:41,890
‫هناك الكثير مما لا نستطيع توقعه

461
00:19:41,970 --> 00:19:44,150
‫أين يجب أن نفتحها؟

462
00:19:44,890 --> 00:19:47,140
‫_ هذه
‫_ إنهما يرتديان ملابسهما العادية

463
00:19:47,240 --> 00:19:49,060
‫حسن، والآن

464
00:19:54,960 --> 00:19:57,180
‫يتبادلان الملابس؟

465
00:19:58,970 --> 00:20:00,790
‫لقد توفّين

466
00:20:03,090 --> 00:20:04,700
‫عمل جيد يا (يو)

467
00:20:04,790 --> 00:20:05,530
‫وأنت أيضاً

468
00:20:05,650 --> 00:20:09,440
‫بالمناسبة، بالنسبة إلى التقويم الجديد
‫يبدو أنه يباع بكثرة

469
00:20:10,480 --> 00:20:11,950
‫حمداً للسماء

470
00:20:12,040 --> 00:20:16,340
‫في مواقع التواصل الاجتماعي يتحمس
‫الناس من أجل قسم تجارة الملابس

471
00:20:16,600 --> 00:20:18,340
‫حقاً؟

472
00:20:18,560 --> 00:20:21,510
‫أجل، شكراً على فكرتك

473
00:20:21,690 --> 00:20:24,080
‫كيف توصلت إلى هذه الفكرة؟

474
00:20:24,250 --> 00:20:26,200
‫ماذا؟ أجل

475
00:20:27,850 --> 00:20:32,640
‫فهمت أخيراً قوة الفجوة، صحيح؟

476
00:20:32,760 --> 00:20:34,110
‫لا، ليس تماماً

477
00:20:34,940 --> 00:20:37,490
‫اعتقدت فقط أنه يسهل ارتداء
‫ملابسك أنت فحسب

478
00:20:37,590 --> 00:20:40,390
‫وهي مريحة أكثر من ملابسي

479
00:20:40,460 --> 00:20:42,190
‫حقاً؟

480
00:20:42,280 --> 00:20:43,850
‫سراويل محاكة جميلة

481
00:20:43,930 --> 00:20:45,450
‫لا ربطات عنق أيضاً

482
00:20:45,530 --> 00:20:48,100
‫(يوشينو)، لنتبادل ملابسنا إلى الأبد

483
00:20:48,230 --> 00:20:51,100
‫كيف أقول إن مقاساتنا مختلفة؟

484
00:20:51,230 --> 00:20:52,270
‫حقاً؟

485
00:20:52,450 --> 00:20:53,710
‫يا لها من سترة جميلة!

486
00:20:53,790 --> 00:20:55,880
‫هل أستطيع الاستمرار
‫بارتداء سروال محاك؟

487
00:20:55,960 --> 00:20:56,880
‫(نيودو)

488
00:20:57,100 --> 00:20:58,090
‫(يو)

489
00:21:00,430 --> 00:21:03,180
‫لكنني أظن أن كل شيء كان جيداً

490
00:21:03,400 --> 00:21:07,610
‫سيسرّ معجبونا بفضلك

491
00:21:08,170 --> 00:21:09,350
‫معجبون؟

492
00:21:09,650 --> 00:21:11,960
‫هل يمكن أن يرضوا بهذا؟

493
00:21:12,380 --> 00:21:14,080
‫لنذهب إلى المنزل حالاً

494
00:21:14,470 --> 00:21:18,040
‫ستكون هناك حلقة خاصة من
‫"(فريش) محبوبو جماهير في تجمع الموسم"

495
00:21:18,120 --> 00:21:19,340
‫حسن، حسن

496
00:21:19,420 --> 00:21:23,030
‫في حلقة اليوم سيكون هناك
‫محبوب جماهير يرتدي زيّ خضراوات

497
00:21:23,110 --> 00:21:24,990
‫ماذا؟ إذاً الموسم الذي كنت تتحدثين عنه...

498
00:21:25,070 --> 00:21:26,120
‫ثم...

499
00:21:26,200 --> 00:21:28,420
‫سيكون هناك...

500
00:21:29,330 --> 00:21:31,980
‫"يوم جديد تماماً"

501
00:21:32,150 --> 00:21:34,420
‫"لنذهب ونبحث عن منظر جديد"

502
00:21:34,500 --> 00:21:37,020
‫"عالم جديد تماماً"

503
00:21:37,240 --> 00:21:39,890
‫"لنفتح الباب الآن"

504
00:21:41,540 --> 00:21:42,660
‫"(أشعة الشمس)"

505
00:21:44,100 --> 00:21:45,270
‫"(حارّة جداً)"

506
00:21:46,840 --> 00:21:47,840
‫"(تحمى)"

507
00:21:50,140 --> 00:21:53,870
‫"لا تتظاهر أنك لا تلاحظ يا عزيزي"

508
00:21:55,400 --> 00:21:59,260
‫"الرعد يومض بعمق في قلبك"

509
00:22:00,650 --> 00:22:04,180
‫"حتى المطر المنهمر بشدة"

510
00:22:04,300 --> 00:22:08,040
‫"سينجرف بعيداً مع الرياح"

511
00:22:08,210 --> 00:22:10,250
‫"تلك النبضات المتسارعة في قلبي"

512
00:22:11,080 --> 00:22:12,740
‫"لا أستطيع إيقافها، لا يمكن إيقافها"

513
00:22:12,900 --> 00:22:13,600
‫"(اعصر)"

514
00:22:13,680 --> 00:22:18,070
‫"لا تعرف أمنيتي حدوداً"
‫"لا تعرف أمنيتي حدوداً"

515
00:22:18,170 --> 00:22:18,820
‫"المع"

516
00:22:18,900 --> 00:22:21,460
‫"لنذهب معاً الآن"

517
00:22:21,560 --> 00:22:23,900
‫"ودّع الطفل الباكي"

518
00:22:23,990 --> 00:22:28,280
‫"الحب والحلم والأمل والطاقة"

519
00:22:28,380 --> 00:22:29,280
‫"غنّها كلها"

520
00:22:29,380 --> 00:22:31,810
‫"السماء الزرقاء تبتسم"

521
00:22:31,890 --> 00:22:34,200
‫"أفرد ذراعيّ باتساع"

522
00:22:34,280 --> 00:22:37,180
‫"أشعر أنني أصل إليه"

523
00:22:37,240 --> 00:22:44,180
‫"مشمس"

524
00:22:39,280 --> 00:22:39,750
‫"(نعم)"

525
00:22:41,750 --> 00:22:42,390
‫"(مرة أخرى)"

526
00:22:44,280 --> 00:22:45,060
‫"(مستعدة)"

527
00:22:45,190 --> 00:22:47,010
‫"مشمس"

528
00:22:47,100 --> 00:22:48,150
‫"(نعم)"

529
00:22:49,400 --> 00:22:50,530
‫"(أشعة الشمس)"

530
00:22:51,920 --> 00:22:53,100
‫"(حارّة جداً)"

531
00:22:54,610 --> 00:22:55,870
‫"(تحمى)"

532
00:23:10,250 --> 00:23:11,210
‫(نيودو)

533
00:23:13,040 --> 00:23:14,000
‫أنت...

534
00:23:14,860 --> 00:23:15,990
‫أنت!

535
00:23:17,990 --> 00:23:20,250
‫تبدو وسيماً بالنظّارة

536
00:23:20,810 --> 00:23:24,680
‫لاحقاً، نشر تقليداً طويلاً على مدوّنته

537
00:23:27,590 --> 00:23:28,500
‫هيا بنا

538
00:23:28,630 --> 00:23:29,850
‫إلى المرحلة التالية

539
00:23:30,420 --> 00:23:32,240
‫حفل الذكرى السنوية الثانية

540
00:23:32,330 --> 00:23:35,670
‫إذاً كنت محبوب جماهير لكل هذه المدة؟

541
00:23:35,760 --> 00:23:41,060
‫(نيودو)، شكراً لأنك لم تتخلّ
‫عن كونك محبوب الجماهير