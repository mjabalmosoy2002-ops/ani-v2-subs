1
00:00:15,310 --> 00:00:16,350
‫ليس بعد

2
00:00:17,450 --> 00:00:20,360
‫ليس قبل أن ألتقي (نيودو)

3
00:00:21,050 --> 00:00:23,270
‫لن أستسلم

4
00:00:23,790 --> 00:00:25,350
‫انتظرني

5
00:00:25,870 --> 00:00:30,520
‫لقاء المعجبين!

6
00:00:32,390 --> 00:00:35,040
‫"معاً تحت السماء الدرامية"

7
00:00:35,120 --> 00:00:37,210
‫"معك"

8
00:00:37,300 --> 00:00:39,290
‫"(هيا جميعكم، لنستمتع)"

9
00:00:41,470 --> 00:00:42,640
‫"حسن"

10
00:00:43,990 --> 00:00:45,770
‫"لنبدأ، الآن"

11
00:00:47,990 --> 00:00:48,770
‫"حسن"

12
00:00:48,850 --> 00:00:50,420
‫"معكم، حسن"

13
00:00:50,510 --> 00:00:52,070
‫"(ها نحن أولاء، نعم)"

14
00:00:52,160 --> 00:00:53,330
‫"(زينغ) من أجل ابتسامة"

15
00:00:53,460 --> 00:00:57,540
‫"هل نسيت كيف هو شعور النبض؟"

16
00:00:57,680 --> 00:01:01,540
‫"الصوت الذي تسمعينه
‫عندما يتسارع قلبك"

17
00:01:01,630 --> 00:01:04,760
‫"لنضعه في طبقات معاً بأغنيتنا"

18
00:01:04,840 --> 00:01:07,060
‫"ثم نطلق سيقاننا للريح"

19
00:01:07,140 --> 00:01:10,010
‫_ "حماس، لا حدود"
‫_ "الاندفاع يتصاعد"

20
00:01:10,150 --> 00:01:11,670
‫"مليء بالروح، لكن من دونك؟"

21
00:01:11,750 --> 00:01:13,700
‫"سيكون هذا مملاً"

22
00:01:13,700 --> 00:01:17,050
‫"أملنا أن نصبح ثنائياً
‫جاهزاً للانطلاق، نعم"

23
00:01:17,140 --> 00:01:20,180
‫"لنرقص معاً إلى الأبد"

24
00:01:20,270 --> 00:01:22,920
‫"إن حدث وتعثرت"

25
00:01:23,000 --> 00:01:26,530
‫"وابتعدت أيدينا بعيداً جداً عن بعضها"

26
00:01:26,650 --> 00:01:29,700
‫"سنضع ثقتنا بك"

27
00:01:29,960 --> 00:01:33,430
‫"لنقطع عهداً سرياً"

28
00:01:33,470 --> 00:01:34,910
‫"(لنغنّ أغنية الآن)"

29
00:01:34,950 --> 00:01:37,480
‫"معاً تحت الشمس الدرامية"

30
00:01:37,560 --> 00:01:38,730
‫"معك"

31
00:01:38,780 --> 00:01:41,250
‫"في الصباح والظهر وحتى الليل"

32
00:01:41,470 --> 00:01:44,040
‫"سنجعلك تقول إنك تحب هذا"

33
00:01:44,120 --> 00:01:46,680
‫"أكثر ودوماً"

34
00:01:46,770 --> 00:01:48,070
‫"ليغنّ الجميع، صفّقوا بأيديكم"

35
00:01:48,110 --> 00:01:51,030
‫"شعاع النور الآتي من النجمين"

36
00:01:51,120 --> 00:01:54,370
‫"إنها أنوار النجوم التي ستقودكم
‫إلى مستقبل أكثر إشراقاً"

37
00:01:54,550 --> 00:01:56,370
‫_ "دافع فيّاض"
‫_ "أغنية عجائبية"

38
00:01:56,450 --> 00:01:57,930
‫"آمل أن تجعلك تبتسم دوماً"

39
00:01:58,020 --> 00:02:00,020
‫"(زينغ) من أجل ابتسامة"

40
00:02:02,240 --> 00:02:06,020
‫"المرحلة الرابعة"

41
00:02:07,240 --> 00:02:09,190
‫حلّ اليوم أخيراً

42
00:02:09,800 --> 00:02:13,050
‫لقاء معجبي (زينغز):
‫"غنّوا في أواخر الخريف"

43
00:02:13,360 --> 00:02:16,660
‫إحدى الفرص النادرة للدردشة
‫مع محبوبنا المفضل

44
00:02:16,880 --> 00:02:19,610
‫كم كنت أتشوّق إلى هذا اليوم

45
00:02:19,870 --> 00:02:23,260
‫ساعدني هذا على الاستمرار
‫في كل ساعات عملي الإضافية

46
00:02:23,520 --> 00:02:27,210
‫أنهيت كل مهامي فقط
‫من أجل هذا الحدث

47
00:02:27,390 --> 00:02:29,480
‫أحسنت أيتها الرفيقة

48
00:02:29,780 --> 00:02:33,990
‫لكن أين يمكن أن تكون (كاسينجيكي)؟
‫هذا حدث هامّ

49
00:02:34,690 --> 00:02:36,690
‫تركت الدردشات على نموذج القراءة

50
00:02:37,120 --> 00:02:39,300
‫سيفتح كشك التسجيل قريباً

51
00:02:39,730 --> 00:02:41,470
‫آسفة على انتظاركما لي

52
00:02:42,120 --> 00:02:43,210
‫أين...

53
00:02:44,600 --> 00:02:45,680
‫(كاسينجيكي)؟

54
00:02:45,940 --> 00:02:47,550
‫ما سبب هذا المظهر؟

55
00:02:48,030 --> 00:02:49,630
‫ذهبت إلى التدريب

56
00:02:49,850 --> 00:02:50,990
‫"التدريب"؟

57
00:02:51,630 --> 00:02:54,240
‫بالطبع، حجر، ورقة، مقص

58
00:02:56,980 --> 00:03:01,150
‫حدث معجبي (زينغز) الخاص:
‫دورة حجر، ورقة، مقص

59
00:03:02,060 --> 00:03:06,150
‫سيلعب المعجبون حجر، ورقة، مقص
‫ضد عضوَي فرقة (زينغز)

60
00:03:06,230 --> 00:03:08,230
‫سيستبعد الخاسرون

61
00:03:08,320 --> 00:03:09,660
‫أم يجب أن نقول "يموتون"

62
00:03:09,960 --> 00:03:14,660
‫إنها لعبة موت قاسية حيث لا يمكنك
‫الوثوق سوى بنفسك

63
00:03:15,090 --> 00:03:20,310
‫من يربح يفز بنسخة خاصة
‫لصورة محبوب الجماهير المفضل

64
00:03:20,790 --> 00:03:25,820
‫لكن لا يمكن سوى لشخص واحد
‫أن يحظى بهذا الشرف

65
00:03:26,180 --> 00:03:29,430
‫بمكيدة كهذه لا يمكن
‫أن يأتي الرابح بسهولة

66
00:03:29,520 --> 00:03:35,260
‫معركة التحمل التي لا تنتهي هذه
‫تستنزف القوة في كل حركة

67
00:03:35,600 --> 00:03:39,680
‫كثير من المعجبين الذين شاركوا
‫في هذه اللعبة العام الماضي

68
00:03:39,990 --> 00:03:42,640
‫كانوا ينهارون وهم يبكون

69
00:03:44,470 --> 00:03:46,420
‫لقد فزت العام الماضي

70
00:03:46,810 --> 00:03:51,410
‫لكنني حينها أدركت أن الحظ
‫لم يعد كافياً

71
00:03:51,850 --> 00:03:54,900
‫ما أحتاج إليه هو قوة جديدة

72
00:03:55,200 --> 00:03:57,240
‫لهذا تدرّبت؟

73
00:03:57,630 --> 00:03:58,410
‫أجل

74
00:03:58,450 --> 00:04:01,890
‫تعلمت من معلم قراءة الذهن
‫في الجنوب

75
00:04:02,100 --> 00:04:06,150
‫ذهبت أيضاً إلى شلال في الشمال
‫يتدفّق بقوى خارقة

76
00:04:06,360 --> 00:04:08,750
‫كان تدريباً عنيفاً

77
00:04:08,840 --> 00:04:11,140
‫مع ذلك، فقد نجوت

78
00:04:11,660 --> 00:04:13,920
‫لا يستطيع أحد إيقافي الآن

79
00:04:14,050 --> 00:04:17,050
‫كل هذا من أجل لعبة
‫حجر، ورقة، مقص؟

80
00:04:17,180 --> 00:04:19,180
‫يا لها من كمية كبيرة
‫من الشجاعة والحب!

81
00:04:19,300 --> 00:04:20,660
‫لا، إنها مجرد حمقاء

82
00:04:20,740 --> 00:04:22,390
‫قولي ما تشائين

83
00:04:22,490 --> 00:04:28,560
‫ما دمت أستطيع الحصول على صورة (نيودو)
‫فإن الرّهان على حياتي يستحق الأمر

84
00:04:28,690 --> 00:04:30,950
‫أتساءل ما إذا كان الأمر
‫سيكون بهذه السهولة

85
00:04:31,470 --> 00:04:34,520
‫هذه الحقيبة المزيّنة
‫أنت من معجبي (يوشينو)، صحيح؟

86
00:04:34,600 --> 00:04:35,820
‫تذكّري كلامي

87
00:04:35,900 --> 00:04:38,290
‫سأفوز بدورة هذا العام

88
00:04:38,510 --> 00:04:41,720
‫تدريب من أجل لعبة حجر، ورقة، مقص؟
‫كم هذا سخيف!

89
00:04:41,900 --> 00:04:43,120
‫ماذا؟

90
00:04:43,250 --> 00:04:45,120
‫الآن هي الحقبة النفسية

91
00:04:45,890 --> 00:04:49,540
‫لقد سحقت في دورة العام الماضي

92
00:04:49,900 --> 00:04:54,760
‫لذا كرّست نفسي
‫لصقل حواسي طوال عام كامل...

93
00:04:55,240 --> 00:04:57,580
‫بحضور دروس نفسية على الإنترنت

94
00:04:57,840 --> 00:04:59,110
‫دروس على الإنترنت؟

95
00:04:59,240 --> 00:05:03,020
‫ووصلت إلى عملية الترسيم

96
00:05:03,060 --> 00:05:04,100
‫أيّ "ترسيم"؟

97
00:05:04,240 --> 00:05:09,410
‫سأستخدم حاستي الخارقة لأحصل على نسخة
‫الصورة الجديدة الخاصة لـ(يوشينو)

98
00:05:09,790 --> 00:05:12,480
‫تباً! الآن يبدو هذا ممكناً

99
00:05:13,000 --> 00:05:16,750
‫صورة رأس (نيودو) العادية تكفيك
‫أليس كذلك؟

100
00:05:17,010 --> 00:05:18,400
‫لا أستطيع إنكار هذا

101
00:05:18,530 --> 00:05:20,180
‫إذاً دعيني أحصل على الجائزة

102
00:05:20,400 --> 00:05:21,440
‫ماذا قلت؟

103
00:05:21,570 --> 00:05:22,480
‫وكأن هذا ممكن

104
00:05:22,740 --> 00:05:25,740
‫ستكون هذه فرصتي
‫لأحب (نيودو) الجديد بشدة

105
00:05:25,910 --> 00:05:28,380
‫لا تهزئي بجوع معجبي (نيودو)

106
00:05:31,170 --> 00:05:35,600
‫أن ينسحبوا أو لا ينسحبوا
‫هل تعرفان القوانين حتى؟

107
00:05:35,740 --> 00:05:36,680
‫لا أعلم

108
00:05:36,860 --> 00:05:39,210
‫يمكن للنفسية أن تهزم القوة الوحشية

109
00:05:39,340 --> 00:05:40,510
‫غيتار (إي إس بي) ليس طرفة!

110
00:05:40,590 --> 00:05:44,640
‫لا تعبثي بالتقنيات
‫التي تعلمتها من المعلم

111
00:05:44,770 --> 00:05:47,510
‫لم أنفق الكثير على دروس الإنترنت
‫من دون جدوى

112
00:05:49,500 --> 00:05:50,070
‫"وافدة جديدة"

113
00:05:50,160 --> 00:05:52,160
‫هذه المشاركة الأولى لي
‫في مسابقة معجبي (زينغز)

114
00:05:52,280 --> 00:05:53,370
‫"تدريب"؟

115
00:05:53,460 --> 00:05:55,030
‫"قوة نفسية"؟

116
00:05:55,110 --> 00:05:57,760
‫نظرتهما إلى العالم مخيفة جداً

117
00:05:58,060 --> 00:05:59,320
‫بعد 15 دقيقة

118
00:06:01,370 --> 00:06:06,020
‫أهلاً بكنّ إلى لقاء معجبي (زينغز):
‫"الغناء في أواخر الخريف"

119
00:06:06,280 --> 00:06:07,750
‫(نيودو)

120
00:06:08,060 --> 00:06:11,090
‫انتهيت مع هؤلاء المهوّسات

121
00:06:11,490 --> 00:06:14,700
‫لنستمتع اليوم، جميعكن

122
00:06:17,090 --> 00:06:19,220
‫مناسبات المعجبين رائعة

123
00:06:19,440 --> 00:06:22,440
‫إحساس الوحدة يختلف كثيراً
‫عما هو في الأداءات الحية

124
00:06:22,660 --> 00:06:25,310
‫لا بد أن (نيودو) متحمّس لأن...

125
00:06:25,690 --> 00:06:26,830
‫(نيودو)؟

126
00:06:27,000 --> 00:06:28,300
‫إنه مختلف الآن

127
00:06:28,390 --> 00:06:30,080
‫أستطيع الشعور بروحه القتالية

128
00:06:30,160 --> 00:06:34,170
‫(نيودو) كائن مملوء بالقناعة لسبب محدّد

129
00:06:34,610 --> 00:06:35,560
‫_ "هذا الصباح"
‫_ واحد!

130
00:06:35,650 --> 00:06:36,940
‫_ اثنان!
‫_ ثلاثة!

131
00:06:40,550 --> 00:06:41,850
‫لقد ربحت

132
00:06:42,160 --> 00:06:46,680
‫بعد الشعور أنني غير محظوظة أقول
‫"على الخاسر حضور نشاطات محبوبي الجماهير"

133
00:06:46,810 --> 00:06:48,460
‫(أساهي)، هل تريدين...

134
00:06:48,630 --> 00:06:51,590
‫لا!
‫علي احترام القوانين!

135
00:06:51,900 --> 00:06:55,670
‫هذا يناسبني، أنا راضية عن النتيجة

136
00:06:55,710 --> 00:06:57,070
‫أنت مستاء بشدة

137
00:06:57,280 --> 00:06:58,320
‫بالطبع أنا مستاءة

138
00:06:58,500 --> 00:07:00,620
‫اليوم هو لقاء المعجبين

139
00:07:00,840 --> 00:07:01,760
‫إذاً؟

140
00:07:01,880 --> 00:07:05,100
‫أردت حضورها حقاً

141
00:07:05,930 --> 00:07:09,970
‫إنها فرصة قيّمة للتفاعل مع المعجبين

142
00:07:10,530 --> 00:07:13,750
‫ابذل ما في وسعك من أجلي يا (نيودو)

143
00:07:14,440 --> 00:07:15,520
‫أشعر كأنني...

144
00:07:16,180 --> 00:07:19,090
‫عالق في نشاطات محبوبي الجماهير
‫بسبب هذه اللعبة

145
00:07:19,310 --> 00:07:20,740
‫إن ربحت أو خسرت

146
00:07:20,830 --> 00:07:23,080
‫أنا من سيذهب إلى الدروس
‫وجلسات التصوير

147
00:07:23,180 --> 00:07:26,470
‫إن استمر هذا، لا أستطيع
‫ترك (أساهي) تقوم بعملي كله

148
00:07:26,650 --> 00:07:27,790
‫ماذا علي أن...

149
00:07:29,870 --> 00:07:32,520
‫ربما ما ينقصني هو مهارة لعبها؟

150
00:07:32,860 --> 00:07:37,250
‫إن استطعت الحصول على هذه المهارة
‫أستطيع جعلها تقوم بعملي كله

151
00:07:38,340 --> 00:07:40,120
‫أدرك (نيودو) هذا

152
00:07:40,550 --> 00:07:41,590
‫حسن

153
00:07:43,250 --> 00:07:44,590
‫والآن...

154
00:07:45,070 --> 00:07:47,280
‫كلمة من (يو)

155
00:07:47,420 --> 00:07:48,590
‫سأفوز بهذا

156
00:07:48,680 --> 00:07:50,110
‫من أجل المجد والمستقبل

157
00:07:50,290 --> 00:07:51,890
‫ماذا؟ "أفوز"؟

158
00:07:52,020 --> 00:07:53,060
‫لأي شيء؟

159
00:07:54,100 --> 00:07:57,020
‫هذه أول مرة أراه متحمساً هكذا

160
00:07:57,230 --> 00:08:00,450
‫لقاءات المعجبين مميّزة في النهاية

161
00:08:01,660 --> 00:08:03,450
‫أساءت (أساهي) الفهم

162
00:08:04,790 --> 00:08:07,010
‫حسن إذاً

163
00:08:07,100 --> 00:08:09,800
‫إلى الفقرة الأولى

164
00:08:10,620 --> 00:08:14,310
‫"كشف أهم سر لـ(زينغز)"

165
00:08:17,040 --> 00:08:18,260
‫في هذه الفقرة

166
00:08:18,350 --> 00:08:22,690
‫سنجيب عن أسئلة تم جمعها مسبقاً

167
00:08:23,170 --> 00:08:25,220
‫السؤال الأول هو...

168
00:08:25,560 --> 00:08:27,300
‫لنرَ...

169
00:08:27,520 --> 00:08:28,910
‫ها هو ذا

170
00:08:29,560 --> 00:08:33,600
‫"هل تتبادلان الهدايا؟"

171
00:08:33,990 --> 00:08:35,210
‫هدايا؟

172
00:08:36,810 --> 00:08:38,160
‫صحيح

173
00:08:38,420 --> 00:08:43,160
‫عندما نسي (يو) حذاءه في درسنا
‫أعرته حذائي الاحتياطي

174
00:08:43,770 --> 00:08:46,500
‫لكن قدميه أكبر من قدميّ
‫لذا تمدّد حذائي

175
00:08:46,720 --> 00:08:49,240
‫وفي النهاية تركته له

176
00:08:50,020 --> 00:08:52,150
‫هل هذه هدية حتى؟

177
00:08:52,330 --> 00:08:54,580
‫هذا لطف بالغ يا (يوشينو)

178
00:08:54,630 --> 00:08:57,320
‫شكراً على القصة المؤثّرة يا (نيودو)

179
00:08:58,800 --> 00:09:00,270
‫ألا يعود بك هذا إلى الوراء؟

180
00:09:00,670 --> 00:09:02,140
‫بلى، قطعة منه

181
00:09:02,360 --> 00:09:04,020
‫ماذا؟ قطـ... ماذا؟

182
00:09:04,140 --> 00:09:06,670
‫هل قلت "قطعة"؟

183
00:09:06,880 --> 00:09:10,400
‫هل كانت إنذاراً من أجل الدورة؟

184
00:09:10,660 --> 00:09:13,350
‫لا بد أنه كان يعطي
‫تلميحات أثناء كلامه

185
00:09:13,400 --> 00:09:15,830
‫لنستخدم دفتر هذا الحدث
‫بشكل جيد

186
00:09:16,310 --> 00:09:19,000
‫دورة حجر، ورقة، مقص لـ(زينغز)

187
00:09:19,610 --> 00:09:22,170
‫في البداية، قد تبدو لعبة حظ بسيطة

188
00:09:22,520 --> 00:09:27,340
‫وراء هذا تتكشّف حرب معلومات
‫وقدرة نفسية

189
00:09:27,950 --> 00:09:29,780
‫وضعية ساق (نيودو)

190
00:09:29,870 --> 00:09:31,550
‫لا بد أنها "مقص"

191
00:09:31,730 --> 00:09:34,520
‫حينها تعثّر (يويا) بحجر

192
00:09:34,820 --> 00:09:35,860
‫حجر؟ ذلك الحجر؟

193
00:09:35,940 --> 00:09:37,250
‫هل هذا كلام مجازي؟

194
00:09:37,330 --> 00:09:39,170
‫لا، انظري إلى هذا

195
00:09:39,420 --> 00:09:40,980
‫أليست هذه "ورقة"؟

196
00:09:41,120 --> 00:09:43,380
‫هل سيعطي تلميحات بهذا الوضوح؟

197
00:09:43,550 --> 00:09:45,250
‫هذا يحيّرني

198
00:09:45,460 --> 00:09:47,850
‫يا لها من مناورة معقّدة!

199
00:09:48,200 --> 00:09:52,630
‫يبدو لي أنهما يتحدثان عن ذكرياتهما

200
00:09:53,590 --> 00:09:56,060
‫خلال عدة فقرات بعد ذلك

201
00:09:56,240 --> 00:10:00,930
‫استمرت المعجبات بتخمين
‫كل سلوك بسيط

202
00:10:01,150 --> 00:10:03,190
‫الآن وصلنا إلى الفقرة المنتظرة

203
00:10:03,360 --> 00:10:05,480
‫دورة حجر، ورقة، مقص

204
00:10:06,530 --> 00:10:07,830
‫جائزة اليوم هي...

205
00:10:08,010 --> 00:10:10,400
‫أولاً، سنريكنّ هذه الصورة

206
00:10:10,610 --> 00:10:11,740
‫انتهى الوقت، آسف

207
00:10:12,050 --> 00:10:13,220
‫هل رأيت هذا؟

208
00:10:13,300 --> 00:10:15,310
‫بناء على الألوان ربما ملابس عادية

209
00:10:15,700 --> 00:10:17,090
‫من تلك اللحظة الخاطفة؟

210
00:10:17,210 --> 00:10:18,000
‫مخيف!

211
00:10:18,310 --> 00:10:19,040
‫والأكثر من ذلك

212
00:10:19,040 --> 00:10:24,730
‫تستطيع الفائزة اليوم
‫الحصول على صورة مع واحد منا هنا

213
00:10:24,950 --> 00:10:27,380
‫صورة مع محبوب الجماهير المفضل؟

214
00:10:31,550 --> 00:10:33,030
‫من المستحيل أن أخسر

215
00:10:33,290 --> 00:10:35,720
‫يا رئيسة محبوبي الجماهير، أنقذيني أرجوك

216
00:10:36,120 --> 00:10:38,770
‫سأفوز ببيع روحي للشيطان

217
00:10:39,510 --> 00:10:40,940
‫لا أستطيع الخسارة ثانية هنا

218
00:10:41,070 --> 00:10:43,330
‫_ وصلت إلى هذه المرحلة
‫_ لن أخسر

219
00:10:43,540 --> 00:10:44,860
‫لنبدأ اللعبة

220
00:10:45,110 --> 00:10:47,240
‫سنجعل (يو) يلعب أولاً

221
00:10:47,590 --> 00:10:49,190
‫(يو)، إن قمت...

222
00:10:50,280 --> 00:10:53,320
‫ما الخطب؟
‫أصبحت أغرب من المعتاد

223
00:10:54,490 --> 00:10:55,890
‫تدريب الصورة، انتهى

224
00:10:56,190 --> 00:10:58,660
‫لا بأس بأي شخص، ليأت معي

225
00:10:58,660 --> 00:11:00,540
‫هل تتذكّرن القوانين؟

226
00:11:00,580 --> 00:11:02,620
‫(نيودو) جاد

227
00:11:02,710 --> 00:11:04,190
‫هل ستحلّ علينا كارثة طبيعية؟

228
00:11:04,570 --> 00:11:05,580
‫ما الذي يحدث هنا؟

229
00:11:05,840 --> 00:11:08,050
‫تعليقات قاسية جداً بخصوص
‫محبوب الجماهير المفضل الخاص بك

230
00:11:08,050 --> 00:11:08,960
‫(يوشينو)

231
00:11:09,090 --> 00:11:10,490
‫أعط الإيعاز، بسرعة

232
00:11:10,570 --> 00:11:12,130
‫ماذا؟ أجل

233
00:11:12,220 --> 00:11:14,660
‫حسن، ها نحن أولاء

234
00:11:15,220 --> 00:11:16,390
‫واحد، اثنان....

235
00:11:16,570 --> 00:11:17,430
‫ثلاثة

236
00:11:19,090 --> 00:11:20,820
‫ماذا؟ ورقة؟

237
00:11:20,960 --> 00:11:24,040
‫ألم يقل شيئاً بخصوص المقص
‫في البداية؟

238
00:11:24,170 --> 00:11:25,560
‫كم هذا ساذج!

239
00:11:25,770 --> 00:11:26,950
‫هذا (نيودو)

240
00:11:27,080 --> 00:11:30,600
‫لا يتذكر ما قاله سابقاً

241
00:11:30,820 --> 00:11:31,780
‫توقعت هذا

242
00:11:31,860 --> 00:11:34,110
‫لقد ربحت

243
00:11:34,110 --> 00:11:37,160
‫لا يزال هناك الكثير من الناس

244
00:11:37,240 --> 00:11:39,810
‫التالي، حتى التعادلات ستعدّ خارج المسابقة

245
00:11:39,940 --> 00:11:41,370
‫إنه دوري

246
00:11:41,410 --> 00:11:42,250
‫(يوشينو)!

247
00:11:43,160 --> 00:11:44,540
‫دعني أفعل هذا

248
00:11:44,720 --> 00:11:46,890
‫_ ماذا؟ هذا...
‫_ سأكون بخير

249
00:11:47,370 --> 00:11:49,230
‫هذه المرة سأربح بالتأكيد

250
00:11:49,510 --> 00:11:50,800
‫هذا مخالف للقوانين

251
00:11:50,930 --> 00:11:52,880
‫(نيودو)، رائع جداً

252
00:11:52,980 --> 00:11:54,890
‫إنه لا يفهم القانون

253
00:11:54,970 --> 00:11:56,370
‫لكنه رائع جداً

254
00:11:56,450 --> 00:11:58,750
‫ذعر (يوشينو) رائع جداً

255
00:11:59,880 --> 00:12:02,920
‫من النادر جداً
‫أن تكون بهذا الحماس

256
00:12:03,010 --> 00:12:04,870
‫هل تستطيع فعل هذا ثانية؟

257
00:12:05,010 --> 00:12:05,750
‫أجل

258
00:12:06,360 --> 00:12:08,100
‫خذ بمزاج المعجبين

259
00:12:08,320 --> 00:12:10,050
‫اقتنص اللحظة القصيرة

260
00:12:10,400 --> 00:12:12,010
‫يكمن الجواب هناك

261
00:12:12,690 --> 00:12:13,610
‫واحد!

262
00:12:13,830 --> 00:12:14,700
‫اثنان!

263
00:12:15,090 --> 00:12:16,820
‫ثلاثة!

264
00:12:19,390 --> 00:12:21,040
‫تم القضاء عليكن

265
00:12:23,120 --> 00:12:25,910
‫هل هناك فائزة؟

266
00:12:27,290 --> 00:12:28,770
‫(يو)، ما هذا؟

267
00:12:28,860 --> 00:12:31,380
‫هذا... هذا الإحساس

268
00:12:31,460 --> 00:12:32,600
‫لا بد أنه السبب

269
00:12:32,680 --> 00:12:34,380
‫أنا أتحكم باللعبة

270
00:12:34,770 --> 00:12:36,680
‫ما الذي يرضيك؟

271
00:12:36,680 --> 00:12:37,720
‫افعل هذا من جديد

272
00:12:38,900 --> 00:12:39,810
‫بعد ذلك

273
00:12:39,900 --> 00:12:42,680
‫تستمر المعركة القاتلة لدورة
‫حجر، ورقة، مقص

274
00:12:43,070 --> 00:12:46,240
‫كانت معركة هائلة
‫من أجل محبوب الجماهير المفضل

275
00:12:46,370 --> 00:12:49,330
‫تعادل والتكرار لعدة مرات

276
00:12:49,630 --> 00:12:54,360
‫كثير من المعجبات انهرن
‫مع إيعازاتهما التي حطمت قلوبهن

277
00:12:55,450 --> 00:12:56,490
‫وأخيراً...

278
00:12:57,410 --> 00:13:00,620
‫بقيت ثلاث منهن فقط

279
00:13:00,800 --> 00:13:04,750
‫سنجري الجولة الأخيرة
‫مع هؤلاء المعجبات الثلاث

280
00:13:05,180 --> 00:13:07,180
‫لا أريد الخسارة أمام هاتين

281
00:13:07,350 --> 00:13:09,000
‫ها نحن أولاء

282
00:13:09,000 --> 00:13:10,660
‫واحد، اثنان، ثلاثة

283
00:13:10,960 --> 00:13:13,790
‫ثلاثة! ثلاثة! ثلاثة! ثلاثة!

284
00:13:14,870 --> 00:13:17,480
‫لا تجعلني أكرّر كلامي
‫تراجعي يا معجبة (نيودو)

285
00:13:17,600 --> 00:13:21,510
‫كفاك، (يوشينو) يحدّث مواقع
‫تواصله الاجتماعي باستمرار

286
00:13:21,510 --> 00:13:23,300
‫هذه أصلاً رفاهية! تراجعي أنت

287
00:13:25,560 --> 00:13:26,730
‫لمن كرّست نفسك؟

288
00:13:26,780 --> 00:13:29,130
‫إنه...

289
00:13:29,210 --> 00:13:31,380
‫أنا وافدة جديدة هنا

290
00:13:31,510 --> 00:13:33,680
‫حقاً؟ أهلاً إلى مملكة (زينغز)

291
00:13:33,820 --> 00:13:36,290
‫أرحّب بك ترحيباً حاراً لكن آسفة
‫هل يمكنك الانسحاب هذه المرة؟

292
00:13:36,420 --> 00:13:39,110
‫لم لا تنسحبان أنتما
‫من أجل الوافدة الجديدة؟

293
00:13:39,200 --> 00:13:41,200
‫وكأننا سنفعل هذا

294
00:13:42,330 --> 00:13:44,550
‫هذه الوافدة الجديدة شجاعة حقاً

295
00:13:45,330 --> 00:13:47,540
‫لديها خصلة الهوس بـ(زينغز)

296
00:13:47,580 --> 00:13:51,150
‫مرة أخرى! مرة أخرى!
‫مرة أخرى! مرة أخرى!

297
00:13:51,410 --> 00:13:54,670
‫يجب أن يوقفهن شخص ما

298
00:13:54,880 --> 00:13:55,920
‫(نيودو)؟

299
00:13:56,060 --> 00:13:57,840
‫إنه لا ينتبه

300
00:13:58,010 --> 00:13:59,970
‫(يوشينو) خائف أيضاً

301
00:14:01,050 --> 00:14:02,530
‫علي القيام بشيء ما

302
00:14:02,920 --> 00:14:05,100
‫يجب أن يكون هذا عمل (أساهي)

303
00:14:05,700 --> 00:14:06,790
‫(نيودو)

304
00:14:07,390 --> 00:14:09,480
‫_ اعذرني!
‫_ ماذا؟

305
00:14:11,740 --> 00:14:12,700
‫أيتها الرفيقات

306
00:14:13,650 --> 00:14:15,390
‫هذا لن يحرز أي تقدم

307
00:14:15,730 --> 00:14:18,740
‫تعالين وتحدّينني كلكن حالاً

308
00:14:18,860 --> 00:14:20,780
‫_ ما هذا؟
‫_ كما تشاء

309
00:14:20,910 --> 00:14:21,990
‫لن أخسر

310
00:14:21,990 --> 00:14:23,510
‫ها نحن أولاء

311
00:14:23,770 --> 00:14:25,040
‫واحد، اثنان...

312
00:14:25,170 --> 00:14:26,300
‫ثلاثة!

313
00:14:27,600 --> 00:14:29,290
‫لنكرّر هذا

314
00:14:30,330 --> 00:14:33,460
‫(يوشينو)، يدك...
‫أليست هذه ورقة؟

315
00:14:33,550 --> 00:14:34,500
‫ماذا؟

316
00:14:34,820 --> 00:14:38,550
‫ماذا؟ لا، هذا فقط
‫منذ أن أوعزت في المرة السابقة

317
00:14:38,630 --> 00:14:39,510
‫(يوشينو)...

318
00:14:39,770 --> 00:14:42,850
‫هل ترغب حقاً بالتقاط صورة معي؟

319
00:14:44,330 --> 00:14:45,930
‫لماذا تقول هذا؟

320
00:14:46,150 --> 00:14:49,500
‫إن كان هذا هو الأمر
‫كان عليك إخباري من قبل

321
00:14:49,620 --> 00:14:51,320
‫ماذا تقول؟

322
00:14:51,450 --> 00:14:52,890
‫ماذا؟ هل أخذ الأمر هذا المنحى؟

323
00:14:52,970 --> 00:14:56,010
‫يا له من عرض لطيف للصداقة

324
00:14:58,100 --> 00:14:58,880
‫جميعكن!

325
00:14:59,010 --> 00:15:03,180
‫مقابل حماس (يوشينو)
‫لم لا ندعه يربح؟

326
00:15:03,830 --> 00:15:05,740
‫إنه يحاول إنهاء هذه الفقرة

327
00:15:10,830 --> 00:15:14,610
‫لذا سنطلب من النهائيات الثلاث
‫أن يرتّبن وضعيتنا للتصوير

328
00:15:14,740 --> 00:15:15,690
‫ما رأيكن؟

329
00:15:16,090 --> 00:15:17,610
‫نحن موافقات تماماً

330
00:15:17,730 --> 00:15:19,260
‫يجب أن نكون ممتنّات

331
00:15:19,340 --> 00:15:23,770
‫وجودي في صوركما
‫لن يكون سوى عائق

332
00:15:27,560 --> 00:15:30,380
‫نحن آسفون لتغيير القوانين فجأة

333
00:15:31,290 --> 00:15:33,590
‫لكنكن أتيتن إلى هنا لرؤيتنا...

334
00:15:33,810 --> 00:15:37,240
‫لذا نريد أن نجعلكن جميعكن تبتسمن
‫إلى أن تصلن إلى المنزل

335
00:15:38,070 --> 00:15:40,890
‫صالحان للغاية...

336
00:15:41,670 --> 00:15:43,240
‫ووسيمان جداً

337
00:15:44,240 --> 00:15:48,850
‫في ذلك اليوم، جن جنون المهوّسات بـ(زينغز)
‫على وسائل التواصل الاجتماعي

338
00:15:50,760 --> 00:15:51,760
‫هل أنت بخير؟

339
00:15:51,840 --> 00:15:53,710
‫شبح محبوب الجماهير!

340
00:15:57,230 --> 00:15:58,580
‫شبح محبوب الجماهير

341
00:15:59,400 --> 00:16:01,050
‫بصحتك!

342
00:16:05,620 --> 00:16:09,090
‫تناول الجعة بعد الاستمتاع مع
‫محبوبك المفضل هو الأفضل

343
00:16:10,130 --> 00:16:12,870
‫يسرّني كثيراً أنني وصلت
‫إلى هذا اليوم حية

344
00:16:13,130 --> 00:16:14,220
‫"حية"؟

345
00:16:14,560 --> 00:16:16,690
‫أين كنت حقاً؟

346
00:16:16,690 --> 00:16:19,040
‫لنشرب كثيراً

347
00:16:19,250 --> 00:16:22,220
‫إقامة حفلة لاحقة
‫أشبه بحدث جديد تماماً، صحيح؟

348
00:16:22,300 --> 00:16:23,990
‫لكن لا تفقدي الوعي وأنت ثملة

349
00:16:24,040 --> 00:16:28,120
‫لكنني أفهمك
‫كان (نيودو) رائعاً جداً اليوم

350
00:16:28,160 --> 00:16:29,200
‫حسن، أجل...

351
00:16:31,460 --> 00:16:34,420
‫أندر مشهد لمحبوبنا المفضل على الإطلاق

352
00:16:34,850 --> 00:16:37,720
‫ماذا لو تمت قرصنة هذه الصورة؟

353
00:16:37,900 --> 00:16:40,240
‫غبية! على أي حال
‫لنلق نظرة أقرب

354
00:16:40,370 --> 00:16:43,190
‫أجل، الشبان الوسيمون ملكية عامة

355
00:16:43,370 --> 00:16:45,840
‫أرينا، أرينا، أرينا

356
00:16:45,880 --> 00:16:49,010
‫قراصنة! لدينا قراصنة هنا!

357
00:16:50,800 --> 00:16:52,980
‫ماذا؟ (ماريركا) تتصل

358
00:16:53,140 --> 00:16:55,620
‫ربما يكون أمراً طارئاً، آسفة

359
00:16:56,670 --> 00:16:57,670
‫ما الأمر؟

360
00:16:58,450 --> 00:17:01,220
‫هل (ماريريكا) واحدة
‫من صديقاتها المهوّسات؟

361
00:17:01,320 --> 00:17:03,790
‫يبدو الأمر كذلك، معجبة بـ(سيغراس)

362
00:17:05,610 --> 00:17:09,620
‫تابعت حسابها
‫على وسائل التواصل الاجتماعي

363
00:17:09,870 --> 00:17:11,950
‫إنها تتحدث عن (سيغراس) بشكل رئيسي

364
00:17:11,950 --> 00:17:16,380
‫لكنها تقدم أيضاً تقارير شائقة
‫عن مناسبات فرق أخرى حية

365
00:17:17,690 --> 00:17:20,350
‫آسفة، أنا قادمة حالاً

366
00:17:20,990 --> 00:17:22,250
‫يا للهول!

367
00:17:22,340 --> 00:17:24,420
‫_ ماذا؟
‫_ هل هناك مشكلة؟

368
00:17:24,560 --> 00:17:29,680
‫خططنا للذهاب إلى مناسبة معاً
‫ومعي بطاقاتها لكن...

369
00:17:29,730 --> 00:17:30,680
‫"لكن"؟

370
00:17:30,720 --> 00:17:32,810
‫نسيت أن أعطيها إياها قبل التدريب

371
00:17:32,860 --> 00:17:34,940
‫_ أنت!
‫_ (كانجيسيكي)

372
00:17:35,330 --> 00:17:39,020
‫يبدو أنها قريبة، سأذهب وأعطيها إياها

373
00:17:39,060 --> 00:17:40,500
‫ادعيها إلى هنا

374
00:17:40,590 --> 00:17:41,540
‫هل أستطيع ذلك؟

375
00:17:42,070 --> 00:17:43,290
‫بعد 15 دقيقة

376
00:17:43,630 --> 00:17:45,670
‫_ مرحباً، أنا (ماريكا)
‫_ "(ماريكا)،معجبة (سيغراس)"

377
00:17:45,840 --> 00:17:47,880
‫_ سررت برؤيتك
‫_ سررت بلقائك

378
00:17:48,060 --> 00:17:50,630
‫آسفة لمقاطعة لقائكنّ بـ(زينغز)

379
00:17:50,890 --> 00:17:51,840
‫لا مشكلة

380
00:17:52,190 --> 00:17:53,920
‫على أي حال يا (كاسينجيكي)...

381
00:17:54,180 --> 00:17:57,830
‫ألم أطلب منك باستمرار
‫إرسال البطاقات؟

382
00:17:59,490 --> 00:18:03,100
‫آسفة، لم تكن هناك تغطية
‫حيث كنت

383
00:18:03,400 --> 00:18:04,880
‫ماذا؟ كم مرة حتى الآن؟

384
00:18:05,010 --> 00:18:06,170
‫سامحيني

385
00:18:06,310 --> 00:18:07,870
‫قالت "كم مرة"

386
00:18:07,960 --> 00:18:09,260
‫إنها معتادة على هذا بالفعل

387
00:18:09,560 --> 00:18:12,300
‫أنت معجبة بـ(سيغراس)
‫أليس كذلك يا (ماريريكا)؟

388
00:18:12,430 --> 00:18:13,730
‫من هو المفضل لديك؟

389
00:18:13,950 --> 00:18:15,430
‫(سيتوتشي)، المغني الرئيسي

390
00:18:15,520 --> 00:18:17,520
‫طريقة استجابته لنا من مستوى مرتفع

391
00:18:17,640 --> 00:18:21,170
‫بالتأكيد إنه رجل لطيف يضع نظارة

392
00:18:21,390 --> 00:18:25,730
‫بحقك، ضعي نظارة لـ(نيودو)
‫وسيصبح أظرف رجل

393
00:18:25,900 --> 00:18:27,160
‫لا تسير الأمور هكذا

394
00:18:27,510 --> 00:18:29,630
‫(سيغراس) فرقة رائجة للغاية

395
00:18:29,910 --> 00:18:32,550
‫هل من الصعب ملاحقة مناسباتهم؟

396
00:18:32,860 --> 00:18:35,770
‫الحصول على البطاقات
‫يشبه الانضمام إلى حرب

397
00:18:36,110 --> 00:18:37,450
‫لكنني أتدبّر أمري بطريقة ما

398
00:18:37,630 --> 00:18:41,800
‫لن تحدث حروب البطاقات لـ(زينغز)
‫حمداً للسماء

399
00:18:42,060 --> 00:18:44,150
‫هل هذا أمر يجب
‫أن تكوني ممتنة من أجله؟

400
00:18:44,330 --> 00:18:45,070
‫بالطبع

401
00:18:46,540 --> 00:18:50,280
‫إضافة إلى حروب البطاقات القاسية
‫لديهم الكثير من البضاعة

402
00:18:50,580 --> 00:18:53,050
‫أولئك الذين يؤلّهون الفرق
‫في حالة سيئة

403
00:18:54,230 --> 00:18:56,100
‫لحسن حظك أنك تعاني هذه المشكلة

404
00:18:56,280 --> 00:19:00,230
‫ليس لدى (زينغز) بضاعة حديثة على الإطلاق

405
00:19:00,310 --> 00:19:02,480
‫لديهم بضاعة عادية جداً

406
00:19:02,620 --> 00:19:03,700
‫عادية؟

407
00:19:04,220 --> 00:19:06,650
‫دعنني أساهم أكثر
‫من أجل محبوبي المفضل

408
00:19:06,650 --> 00:19:09,740
‫لم أعد أعرف غايتي في العمل

409
00:19:09,780 --> 00:19:11,300
‫يا لها من صرخة تفطر القلب!

410
00:19:11,740 --> 00:19:15,250
‫معجبات الفرق الشعبية مثلك
‫لن يفهمن ألمنا

411
00:19:15,470 --> 00:19:17,600
‫لكن معك حق

412
00:19:18,260 --> 00:19:21,210
‫أن تكون قادراً على السعادة والحزن
‫من أجل محبوبك المفضل

413
00:19:21,250 --> 00:19:23,470
‫أليس هذا مرضياً للنفس؟

414
00:19:23,590 --> 00:19:24,510
‫بالضبط

415
00:19:24,770 --> 00:19:27,900
‫أدخل (نيودو) الفرح
‫إلى حياتي عدة مرات

416
00:19:28,120 --> 00:19:30,330
‫حتى عندما كنت منهكة بسبب العمل

417
00:19:30,420 --> 00:19:33,760
‫لا يزال في وسعي قول "كل شيء بخير"
‫بعد أن أشعر بالإعجاب به

418
00:19:33,850 --> 00:19:36,200
‫أظن أن محبوبي الجماهير
‫يحافظون على تعقّلنا

419
00:19:36,330 --> 00:19:37,930
‫أصبح هذا متطرّفاً

420
00:19:38,030 --> 00:19:40,150
‫امتناني لـ(زينغز)

421
00:19:40,330 --> 00:19:44,320
‫مجرد التفكير بعالم
‫من دون (نيودو) يجعلني...

422
00:19:46,710 --> 00:19:50,020
‫(كاسينجيكي)، ألا تشعرين أنك تثملين؟

423
00:19:54,050 --> 00:19:55,090
‫ماذا؟

424
00:19:55,360 --> 00:19:56,700
‫أنت سريعة جداً في الصحو

425
00:19:57,180 --> 00:20:00,700
‫ستؤدي فرقة (سيغراس) عرضاً
‫في (فامرز هاندسوم) لهذا العام

426
00:20:00,790 --> 00:20:02,830
‫_ تم الإعلان عن هذا تواً
‫_ (فارمرز هاندسوم)؟

427
00:20:02,920 --> 00:20:05,880
‫مهرجان محبوبي الجماهير الشعبيين؟

428
00:20:06,090 --> 00:20:06,920
‫أجل، هذا هو

429
00:20:07,090 --> 00:20:08,480
‫قاموا بالأداء العام الماضي أيضاً

430
00:20:09,690 --> 00:20:11,960
‫هذا امتياز لكونهم فرقة شعبية

431
00:20:13,000 --> 00:20:13,640
‫ماذا؟

432
00:20:15,080 --> 00:20:16,560
‫ستكون فرقة (زينغز) هناك أيضاً

433
00:20:16,870 --> 00:20:17,610
‫ماذا؟

434
00:20:17,730 --> 00:20:18,860
‫انظرن

435
00:20:19,900 --> 00:20:21,480
‫هذا حقيقي

436
00:20:23,080 --> 00:20:24,850
‫أخيراً، (نيودو)!

437
00:20:24,850 --> 00:20:26,940
‫سيعتلي إعجابنا خشبة مسرح أكبر

438
00:20:26,940 --> 00:20:28,600
‫لماذا؟ جدياً؟

439
00:20:28,680 --> 00:20:30,070
‫هل هذا مقبول؟

440
00:20:30,460 --> 00:20:31,590
‫توقفي عن الذعر

441
00:20:31,900 --> 00:20:36,320
‫لماذا نسمع هذا الخبر
‫من تحديثات فرقة أخرى؟

442
00:20:36,420 --> 00:20:38,020
‫بما أنك ذكرت الأمر

443
00:20:38,110 --> 00:20:40,970
‫على الأقل كان عليهما
‫إخبارنا في لقاء المعجبين

444
00:20:41,110 --> 00:20:44,100
‫تحديث رسمي من (زينغز)
‫لم يصدر بعد

445
00:20:44,240 --> 00:20:46,890
‫ربما لا يعلمان بالأمر أيضاً

446
00:20:47,060 --> 00:20:47,930
‫مستحيل

447
00:20:48,050 --> 00:20:48,970
‫صحيح

448
00:20:49,100 --> 00:20:50,970
‫الأمر كما خمّنت بالضبط

449
00:20:51,320 --> 00:20:54,530
‫أن تفكر أن (زيغز)
‫سيكونان في (فارمرز هاندسوم)

450
00:20:54,660 --> 00:20:56,830
‫أجل، سيظهران على ذلك المسرح الكبير

451
00:20:56,930 --> 00:20:59,960
‫من الواضح أن هذا
‫أعلى من مستواهما، صحيح؟

452
00:21:03,230 --> 00:21:04,480
‫هل سيكون هذا مقبولاً؟

453
00:21:04,870 --> 00:21:06,660
‫تكون هناك عادة الكثير
‫من المقاعد الفارغة

454
00:21:06,740 --> 00:21:10,090
‫كنا نرغب بتعلم كيف نصنع
‫نسخاً احتياطية لملئها

455
00:21:10,310 --> 00:21:13,860
‫هل يمكننا الحصول على بطاقات
‫لمناسبة فيها فرقة (سيغراس)؟

456
00:21:13,950 --> 00:21:16,910
‫علينا وضع استراتيجيات
‫من أجل حرب البطاقات

457
00:21:17,340 --> 00:21:19,910
‫توقفن عن هدر الطاقة على تحديثات خاصة
‫بمناسبات عدا عن لقاءات المعجبين

458
00:21:19,990 --> 00:21:21,340
‫إذاً لنشرب

459
00:21:21,470 --> 00:21:22,600
‫أتفق معك!

460
00:21:22,820 --> 00:21:24,340
‫بصحتك

461
00:21:28,210 --> 00:21:30,420
‫سنشرب كثيراً الليلة

462
00:21:30,500 --> 00:21:31,680
‫(كاسينجيكي)...

463
00:21:32,680 --> 00:21:34,720
‫لا تزال لديك مناسبة الغد

464
00:21:35,110 --> 00:21:36,150
‫بئساً!

465
00:21:37,320 --> 00:21:41,280
‫"أنت تشرق بلمعان شديد"

466
00:21:41,370 --> 00:21:45,540
‫"لكل منا لمعانه الخاص"

467
00:21:49,630 --> 00:21:53,880
‫"لن أطلع سواك
‫على الأشياء التي أحبها"

468
00:21:53,960 --> 00:21:58,310
‫"ماذا إذاً؟ ماذا يعنيك الأمر؟
‫إنها فرادتي"

469
00:21:58,400 --> 00:22:02,790
‫"ربما أكون مخطئاً، لكن إن التزمت به"

470
00:22:02,870 --> 00:22:07,520
‫"أستطيع خلق نقطة قوتي الخاصة"

471
00:22:07,780 --> 00:22:11,730
‫"قلت إننا نحب الأشياء ذاتها"

472
00:22:11,870 --> 00:22:14,210
‫"ألست مخطئاً؟"

473
00:22:14,300 --> 00:22:18,340
‫"الآن أريد رؤية فرادتك"

474
00:22:18,510 --> 00:22:21,030
‫"هيا، لا تكذب، كن صريحاً فحسب"

475
00:22:21,120 --> 00:22:23,160
‫"وتصرّف على طبيعتك"

476
00:22:23,510 --> 00:22:27,210
‫"حتى إن كنت عنيداً جداً
‫أنا أعرف كل شيء"

477
00:22:27,290 --> 00:22:29,850
‫ما هو معدن قلبك؟"

478
00:22:30,030 --> 00:22:32,120
‫"أريد معرفة طبيعتك الحقيقية"

479
00:22:32,420 --> 00:22:36,760
‫"سأرسم ابتسامة على وجهك"

480
00:22:37,280 --> 00:22:39,360
‫"لا تكذب، كن صريحاً فحسب"

481
00:22:39,620 --> 00:22:41,710
‫"وتصرف على طبيعتك"

482
00:22:41,930 --> 00:22:45,670
‫"حتى إن كنت عنيداً جداً
‫أنا أعرف كل شيء"

483
00:22:45,760 --> 00:22:48,450
‫"ما هو معدن قلبك؟"

484
00:22:48,710 --> 00:22:50,790
‫"أريد معرفة طبيعتك الحقيقية"

485
00:22:50,830 --> 00:22:55,100
‫"سأرسم ابتسامة على وجهك"

486
00:22:55,360 --> 00:23:00,220
‫"أنت تشرق بلمعان شديد"

487
00:23:00,270 --> 00:23:04,520
‫"إنه لمعانك الخاص"

488
00:23:08,520 --> 00:23:09,600
‫جديّاً

489
00:23:09,600 --> 00:23:12,430
‫كان (نيودو) صالحاً بشدة اليوم

490
00:23:12,560 --> 00:23:15,770
‫"أردنا أن نجعلكن جميعكن تبتسمن
‫إلى أن تصلن إلى المنزل"

491
00:23:15,860 --> 00:23:18,900
‫جعلنا نبتسم بشدة وأفسد تبرّجنا

492
00:23:23,420 --> 00:23:25,340
‫(يويا نيودو)

493
00:23:27,330 --> 00:23:29,470
‫لنصل إلى المرحلة التالية

494
00:23:29,550 --> 00:23:30,850
‫أنا (هيكارو سيتوتشي)

495
00:23:30,940 --> 00:23:35,110
‫رغبت دوماً بلقائكما
‫يا (يوشيني) و(نيودو)

496
00:23:35,240 --> 00:23:38,150
‫هل أستطيع الظهور على المسرح الليلة؟

497
00:23:38,230 --> 00:23:38,800
‫أنت!

498
00:23:39,320 --> 00:23:41,500
‫ماذا تكون بالنسبة
‫إلى (أساهي موغامي)؟